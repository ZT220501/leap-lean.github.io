        have : Real.exp (M_top - U₀) ^ 2 = Real.exp (2 * M_top - 2 * U₀) := by
          rw [← Real.exp_nat_mul]; ring_nf
        rw [← this]
        exact sq_le_sq' (by linarith [norm_nonneg (F w₀), Real.exp_pos (M_top - U₀)]) hF_wit
      have h_top_le : Real.exp (2 * M_top) + η ^ 2 ≤
          Real.exp (2 * U₀) * (‖F w₀‖ ^ 2 + η ^ 2) := by
        have h_prod : Real.exp (2 * U₀) * Real.exp (2 * M_top - 2 * U₀) =
            Real.exp (2 * M_top) := by rw [← Real.exp_add]; ring_nf
        nlinarith [Real.exp_pos (2 * U₀)]
      have h_log : Real.log (Real.exp (2 * M_top) + η ^ 2) ≤
          2 * U₀ + Real.log (‖F w₀‖ ^ 2 + η ^ 2) := by
        calc Real.log (Real.exp (2 * M_top) + η ^ 2) ≤
            Real.log (Real.exp (2 * U₀) * (‖F w₀‖ ^ 2 + η ^ 2)) :=
          Real.log_le_log (by positivity) h_top_le
        _ = Real.log (Real.exp (2 * U₀)) + Real.log (‖F w₀‖ ^ 2 + η ^ 2) :=
          Real.log_mul (Real.exp_pos _).ne' (by positivity)
        _ = 2 * U₀ + Real.log (‖F w₀‖ ^ 2 + η ^ 2) := by rw [Real.log_exp]
      dsimp [U_reg, ψ]; linarith
    
    have h_submean : ∀ z_s ∈ Ω', ∃ δ_s : ℝ, 0 < δ_s ∧
        ∀ r : ℝ, 0 < r → r < δ_s →
          Metric.closedBall z_s r ⊆ Ω' ∧ W z_s ≤ Real.circleAverage W z_s r := by
      intro z_s hz_s
      obtain ⟨r₁, hr₁_pos, hr₁_sub⟩ := Metric.isOpen_iff.mp hΩ'_open z_s hz_s
      let s_s : ℝ := Real.sqrt (‖F z_s‖ ^ 2 + η ^ 2)
      have hs_pos : 0 < s_s := Real.sqrt_pos.mpr (by positivity)
      have hs_sq : s_s ^ 2 = ‖F z_s‖ ^ 2 + η ^ 2 := Real.sq_sqrt (by positivity)
      let α₀ : ℂ := starRingEnd ℂ (F z_s) / (s_s : ℂ)
      let β₀ : ℝ := η / s_s
      let g : ℂ → ℂ := fun z => α₀ * F z + ((β₀ * η : ℝ) : ℂ)
      have hg_diff : DifferentiableOn ℂ g U_open :=
        (hF.const_mul α₀).add (differentiableOn_const _)
      have hg_center : g z_s = (s_s : ℂ) := by
        have h_conj_mul : starRingEnd ℂ (F z_s) * F z_s = ((‖F z_s‖ ^ 2 : ℝ) : ℂ) := by
          rw [← Complex.normSq_eq_norm_sq, Complex.normSq_apply]
          apply Complex.ext <;> (simp; try ring)
        have hs_c_ne : (s_s : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hs_pos.ne'
        dsimp [g, α₀, β₀]
        rw [div_mul_eq_mul_div, h_conj_mul]
        have : ((η / s_s * η : ℝ) : ℂ) = ((η ^ 2 : ℝ) : ℂ) / (s_s : ℂ) := by
          push_cast; ring
        rw [this, ← add_div]
        have h_num : ((‖F z_s‖ ^ 2 : ℝ) : ℂ) + ((η ^ 2 : ℝ) : ℂ) = ((s_s ^ 2 : ℝ) : ℂ) := by
          rw [← Complex.ofReal_add, ← hs_sq]
        rw [h_num]
        push_cast
        field_simp [hs_c_ne]
      have hz_s_U : z_s ∈ U_open := h_sub (subset_closure hz_s)
      have hg_contAt : ContinuousAt g z_s :=
        (hg_diff.differentiableAt (hU_open.mem_nhds hz_s_U)).continuousAt
      have hg_ne_center : g z_s ≠ 0 := by
        rw [hg_center]; exact Complex.ofReal_ne_zero.mpr hs_pos.ne'
      obtain ⟨r₂, hr₂_pos, hr₂_ne⟩ :=
        Metric.mem_nhds_iff.mp (hg_contAt.eventually_ne hg_ne_center)
      let δ_s : ℝ := min r₁ r₂
      refine ⟨δ_s, lt_min hr₁_pos hr₂_pos, ?_⟩
      intro r hr_pos hr_lt
      have hr_lt_r₁ : r < r₁ := lt_of_lt_of_le hr_lt (min_le_left _ _)
      have hr_lt_r₂ : r < r₂ := lt_of_lt_of_le hr_lt (min_le_right _ _)
      have h_cb_Ω : Metric.closedBall z_s r ⊆ Ω' :=
        (Metric.closedBall_subset_ball hr_lt_r₁).trans hr₁_sub
      have h_cb_r₂ : Metric.closedBall z_s r ⊆ Metric.ball z_s r₂ :=
        Metric.closedBall_subset_ball hr_lt_r₂
      refine ⟨h_cb_Ω, ?_⟩
      have hr_abs : |r| = r := abs_of_pos hr_pos
      have h_cb_U : Metric.closedBall z_s |r| ⊆ U_open := by
        rw [hr_abs]; exact (h_cb_Ω.trans subset_closure).trans h_sub
      have hg_ana : AnalyticOnNhd ℂ g U_open :=
        hg_diff.analyticOnNhd hU_open
      have hg_ne_cb : ∀ u ∈ Metric.closedBall z_s |r|, g u ≠ 0 := by
        intro u hu; rw [hr_abs] at hu; exact hr₂_ne (h_cb_r₂ hu)
      have h_jensen : Real.circleAverage (fun z => Real.log ‖g z‖) z_s r = ψ z_s := by
        rw [(hg_ana.mono h_cb_U).circleAverage_log_norm_of_ne_zero hg_ne_cb, hg_center,
          Complex.norm_of_nonneg (le_of_lt hs_pos)]
        dsimp [s_s, ψ]
        rw [Real.log_sqrt (by positivity)]; ring
      have hα_norm : ‖α₀‖ = ‖F z_s‖ / s_s := by
        dsimp [α₀]
        rw [norm_div, Complex.norm_conj, Complex.norm_of_nonneg (le_of_lt hs_pos)]
      have h_unit : ‖α₀‖ ^ 2 + β₀ ^ 2 = 1 := by
        rw [hα_norm]; dsimp [β₀]
        field_simp [hs_pos.ne']; linarith [hs_sq]
      have h_cs : ∀ z ∈ Metric.sphere z_s |r|, Real.log ‖g z‖ ≤ ψ z := by
        intro z hz
        have hg_pos : 0 < ‖g z‖ :=
          norm_pos_iff.mpr (hg_ne_cb z (Metric.sphere_subset_closedBall hz))
        have hg_tri : ‖g z‖ ≤ ‖α₀‖ * ‖F z‖ + β₀ * η := by
          calc ‖g z‖ ≤ ‖α₀ * F z‖ + ‖((β₀ * η : ℝ) : ℂ)‖ := norm_add_le _ _
          _ = ‖α₀‖ * ‖F z‖ + β₀ * η := by
              rw [norm_mul, Complex.norm_of_nonneg (by dsimp [β₀]; positivity)]
        have hg_sq : ‖g z‖ ^ 2 ≤ ‖F z‖ ^ 2 + η ^ 2 := by
          have h_tri_sq : ‖g z‖ ^ 2 ≤ (‖α₀‖ * ‖F z‖ + β₀ * η) ^ 2 :=
            sq_le_sq' (by linarith [norm_nonneg (g z)]) hg_tri
          have h_id : (‖α₀‖ * ‖F z‖ + β₀ * η) ^ 2 =
              (‖α₀‖ ^ 2 + β₀ ^ 2) * (‖F z‖ ^ 2 + η ^ 2) -
                (‖α₀‖ * η - β₀ * ‖F z‖) ^ 2 := by ring
          rw [h_id, h_unit, one_mul] at h_tri_sq
          nlinarith [sq_nonneg (‖α₀‖ * η - β₀ * ‖F z‖)]
        have h_log := Real.log_le_log (sq_pos_of_pos hg_pos) hg_sq
        rw [Real.log_pow] at h_log
        push_cast at h_log
        dsimp [ψ]; linarith
      have h_sph_U : Metric.sphere z_s |r| ⊆ U_open :=
        Metric.sphere_subset_closedBall.trans h_cb_U
      have h_sph_clos : Metric.sphere z_s |r| ⊆ closure Ω' := by
        rw [hr_abs]; exact Metric.sphere_subset_closedBall.trans (h_cb_Ω.trans subset_closure)
      have h_log_g_cont : ContinuousOn (fun z => Real.log ‖g z‖) (Metric.sphere z_s |r|) := by
        intro z hz
        have hg_z_cont : ContinuousWithinAt g (Metric.sphere z_s |r|) z :=
          (hg_diff.continuousOn.mono h_sph_U) z hz
        exact ContinuousAt.comp_continuousWithinAt
          (f := fun w => ‖g w‖)
          (Real.continuousAt_log
            (norm_ne_zero_iff.mpr (hg_ne_cb z (Metric.sphere_subset_closedBall hz))))
          hg_z_cont.norm
      have h_ci_log_g : CircleIntegrable (fun z => Real.log ‖g z‖) z_s r :=
        h_log_g_cont.circleIntegrable'
      have h_ci_ψ : CircleIntegrable ψ z_s r :=
        (hψ_cont.mono h_sph_U).circleIntegrable'
      have h_ψ_submean : ψ z_s ≤ Real.circleAverage ψ z_s r := by
        rw [← h_jensen]
        exact Real.circleAverage_mono h_ci_log_g h_ci_ψ h_cs
      let c_const : ℝ := (C_disk / H_reg) * ((1 / 2 : ℝ) * Real.log (Real.exp (2 * M_top) + η ^ 2))
      let c_slope : ℝ := C_disk / H_reg
      have hW_decomp : ∀ z : ℂ, W z = (V z - c_const) + c_slope • ψ z := by
        intro z; dsimp [W, U_reg, c_const, c_slope]; ring
      have h_ci_V : CircleIntegrable V z_s r := (hV_cont.mono h_sph_clos).circleIntegrable'
      have h_ci_const : CircleIntegrable (fun _ => c_const) z_s r :=
        continuousOn_const.circleIntegrable'
      have h_ci_Vsub : CircleIntegrable (fun z => V z - c_const) z_s r :=
        ((hV_cont.mono h_sph_clos).sub continuousOn_const).circleIntegrable'
      have h_ci_smul : CircleIntegrable (fun z => c_slope • ψ z) z_s r :=
        ((hψ_cont.mono h_sph_U).const_smul c_slope).circleIntegrable'
      have h_ca_W : Real.circleAverage W z_s r =
          (V z_s - c_const) + c_slope * Real.circleAverage ψ z_s r := by
        have h_eq : Set.EqOn W (fun z => (V z - c_const) + c_slope • ψ z)
            (Metric.sphere z_s |r|) := fun z _ => hW_decomp z
        rw [Real.circleAverage_congr_sphere h_eq,
          Real.circleAverage_fun_add h_ci_Vsub h_ci_smul,
          Real.circleAverage_fun_sub h_ci_V h_ci_const,
          Real.circleAverage_const,
          Real.circleAverage_fun_smul, smul_eq_mul,
          hV_mean z_s hz_s r hr_pos h_cb_Ω]
      rw [hW_decomp z_s, h_ca_W, smul_eq_mul]
      have hc_slope_pos : 0 ≤ c_slope := div_nonneg (le_of_lt hC) (le_of_lt hH_reg_pos)
      have := mul_le_mul_of_nonneg_left h_ψ_submean hc_slope_pos
      linarith
    
    have h_clos_compact : IsCompact (closure Ω') :=
      Metric.isCompact_of_isClosed_isBounded isClosed_closure hΩ'_bdd.closure
    obtain ⟨z_max, hz_max_mem, hz_max⟩ :=
      h_clos_compact.exists_isMaxOn ⟨w₀, subset_closure hw₀_mem⟩ hW_cont
    let M_max : ℝ := W z_max
    have hM_nonpos : M_max ≤ 0 := by
      by_contra hM_pos_neg
      have hM_pos : 0 < M_max := lt_of_not_ge hM_pos_neg
      let S_max : Set ℂ := closure Ω' ∩ W ⁻¹' {M_max}
      have hS_closed : IsClosed S_max :=
        hW_cont.preimage_isClosed_of_isClosed isClosed_closure isClosed_singleton
      have hS_bdd : Bornology.IsBounded S_max :=
        hΩ'_bdd.closure.subset Set.inter_subset_left
      have hS_compact : IsCompact S_max :=
        Metric.isCompact_of_isClosed_isBounded hS_closed hS_bdd
      have hS_nonempty : S_max.Nonempty := ⟨z_max, hz_max_mem, rfl⟩
      obtain ⟨z_s, hz_s_S, hz_s_re⟩ :=
        hS_compact.exists_isMaxOn hS_nonempty Complex.continuous_re.continuousOn
      obtain ⟨hz_s_clos, hz_s_val⟩ := hz_s_S
      have hz_s_Ω : z_s ∈ Ω' := by
        by_contra hz_not_Ω
        have hz_fr : z_s ∈ frontier Ω' := ⟨hz_s_clos, by rwa [hΩ'_open.interior_eq]⟩
        have hz_W : W z_s = M_max := hz_s_val
        linarith [hW_front z_s hz_fr]
      obtain ⟨δ_s, hδ_s_pos, h_loc⟩ := h_submean z_s hz_s_Ω
      let r : ℝ := δ_s / 2
      have hr_pos : 0 < r := half_pos hδ_s_pos
      have hr_lt : r < δ_s := half_lt_self hδ_s_pos
      obtain ⟨h_cb_Ω, hW_le_ca⟩ := h_loc r hr_pos hr_lt
      let f : ℝ → ℝ := fun θ => W (circleMap z_s r θ)
      have hf_mem : ∀ θ : ℝ, circleMap z_s r θ ∈ closure Ω' := fun θ =>
        subset_closure
          (h_cb_Ω (Metric.sphere_subset_closedBall (circleMap_mem_sphere z_s (le_of_lt hr_pos) θ)))
      have hf_cont : Continuous f :=
        hW_cont.comp_continuous (continuous_circleMap z_s r) hf_mem
      have hf_le : ∀ θ : ℝ, f θ ≤ M_max := fun θ => isMaxOn_iff.mp hz_max _ (hf_mem θ)
      have hf_zero_lt : f 0 < M_max := by
        refine lt_of_le_of_ne (hf_le 0) (fun h_eq => ?_)
        have h_pt_S : circleMap z_s r 0 ∈ S_max := ⟨hf_mem 0, h_eq⟩
        have h_re_le : (circleMap z_s r 0).re ≤ z_s.re :=
          isMaxOn_iff.mp hz_s_re _ h_pt_S
        have h_cm_zero : (circleMap z_s r 0).re = z_s.re + r := by
          simp [circleMap]
        linarith
      let ε₀ : ℝ := (M_max - f 0) / 2
      have hε₀_pos : 0 < ε₀ := half_pos (sub_pos.mpr hf_zero_lt)
      obtain ⟨δ₁, hδ₁_pos, hδ₁_ball⟩ :=
        Metric.mem_nhds_iff.mp
          (hf_cont.continuousAt.eventually (gt_mem_nhds (by dsimp [ε₀]; linarith : f 0 < M_max - ε₀)))
      let δ_θ : ℝ := min (δ₁ / 2) Real.pi
      have hδ_θ_pos : 0 < δ_θ := lt_min (half_pos hδ₁_pos) Real.pi_pos
      have hδ_θ_le_2pi : δ_θ ≤ 2 * Real.pi :=
        le_trans (min_le_right _ _) (by linarith [Real.pi_pos])
      have hf_on_1 : ∀ θ ∈ Set.Icc 0 δ_θ, f θ ≤ M_max - ε₀ := by
        intro θ ⟨h0, h1⟩
        have h_dist : dist θ 0 < δ₁ := by
          rw [Real.dist_eq, sub_zero, abs_of_nonneg h0]
          exact lt_of_le_of_lt (le_trans h1 (min_le_left _ _)) (half_lt_self hδ₁_pos)
        exact le_of_lt (hδ₁_ball h_dist)
      have hf_on_2 : ∀ θ ∈ Set.Icc δ_θ (2 * Real.pi), f θ ≤ M_max :=
        fun θ _ => hf_le θ
      have h_int_1 : ∫ θ in (0 : ℝ)..δ_θ, f θ ≤ δ_θ * (M_max - ε₀) := by
        have h_mono := intervalIntegral.integral_mono_on (μ := MeasureTheory.volume)
          (le_of_lt hδ_θ_pos) (hf_cont.intervalIntegrable 0 δ_θ) intervalIntegrable_const hf_on_1
        rw [intervalIntegral.integral_const, sub_zero, smul_eq_mul] at h_mono
        exact h_mono
      have h_int_2 : ∫ θ in δ_θ..(2 * Real.pi), f θ ≤ (2 * Real.pi - δ_θ) * M_max := by
        have h_mono := intervalIntegral.integral_mono_on (μ := MeasureTheory.volume)
          hδ_θ_le_2pi (hf_cont.intervalIntegrable δ_θ (2 * Real.pi)) intervalIntegrable_const hf_on_2
        rw [intervalIntegral.integral_const, smul_eq_mul] at h_mono
        exact h_mono
      have h_int_sum : ∫ θ in (0 : ℝ)..(2 * Real.pi), f θ ≤
          2 * Real.pi * M_max - δ_θ * ε₀ := by
        rw [← intervalIntegral.integral_add_adjacent_intervals
          (hf_cont.intervalIntegrable 0 δ_θ) (hf_cont.intervalIntegrable δ_θ (2 * Real.pi))]
        linarith
      have h_ca_lt : Real.circleAverage W z_s r < M_max := by
        rw [Real.circleAverage_def, smul_eq_mul]
        have h_2pi_pos : 0 < 2 * Real.pi := by positivity
        have h_prod_pos : 0 < δ_θ * ε₀ := mul_pos hδ_θ_pos hε₀_pos
        calc (2 * Real.pi)⁻¹ * ∫ θ in (0 : ℝ)..(2 * Real.pi), f θ ≤
            (2 * Real.pi)⁻¹ * (2 * Real.pi * M_max - δ_θ * ε₀) :=
          mul_le_mul_of_nonneg_left h_int_sum (by positivity)
        _ < (2 * Real.pi)⁻¹ * (2 * Real.pi * M_max) :=
          mul_lt_mul_of_pos_left (by linarith) (by positivity)
        _ = M_max := inv_mul_cancel_left₀ h_2pi_pos.ne' M_max
      have hz_W : W z_s = M_max := hz_s_val
      linarith
    have hW_w₀ : W w₀ ≤ 0 :=
      le_trans (isMaxOn_iff.mp hz_max w₀ (subset_closure hw₀_mem)) hM_nonpos
    have hV_le_reg : V w₀ ≤ (C_disk / H_reg) * U_reg w₀ := by dsimp [W] at hW_w₀; linarith
    calc
      V w₀ ≤ (C_disk / H_reg) * U_reg w₀ := hV_le_reg
      _ ≤ (C_disk / H_reg) * U₀ :=
          mul_le_mul_of_nonneg_left hU_reg_wit (by positivity)
      _ ≤ (C_disk / (H_def / 2)) * U₀ := by
          refine mul_le_mul_of_nonneg_right ?_ hU₀
          exact div_le_div_of_nonneg_left (le_of_lt hC) (half_pos hH) hH_reg_lb
      _ = 2 * C_disk * (U₀ / H_def) := by field_simp [hH.ne']

  
  
  
  intro a b K ha hab hK
  obtain ⟨M_lat, c_wit, C_disk, hM_lat, hc_wit, hC_disk, hBarrier⟩ := h_s2 a b K ha hab hK
  refine ⟨M_lat, 6 * C_disk / c_wit, hM_lat, by positivity, ?_⟩
  intro p d τ M_top U₀ H_def F U_open N x_T d_T ρ_T
    hd hτ hτ_d hU₀ hH hTiles hU_open hR_sub hF hF_top hF_wit hF_bad
  obtain ⟨S, hS_disj, hS_meas, hS_offdiag⟩ := h_s1 N x_T ρ_T (fun i => (hTiles i).1)
  let τ' : ℝ := τ / d
  let x' : Fin N → ℝ := fun i => (x_T i - p) / d
  let d' : Fin N → ℝ := fun i => d_T i / d
  let ρ' : Fin N → ℝ := fun i => ρ_T i / d
  have hτ'_pos : 0 < τ' := div_pos hτ hd
  have hτ'_lt : τ' < 1 / 4 := by
    dsimp [τ']; rw [div_lt_iff₀ hd]; linarith
  have hS_tiles' : ∀ j ∈ S, 0 < ρ' j ∧ a * ρ' j ≤ d' j ∧ d' j ≤ b * ρ' j ∧
      d' j ≤ 1 / 2 ∧ |x' j| ≤ K ∧ τ' < d' j / 4 := by
    intro j _
    obtain ⟨h1, h2, h3, h4, h5, h6⟩ := hTiles j
    refine ⟨div_pos h1 hd, ?_, ?_, ?_, ?_, ?_⟩
    · dsimp [ρ', d']; rw [← mul_div_assoc]; exact div_le_div_of_nonneg_right h2 (le_of_lt hd)
    · dsimp [ρ', d']; rw [← mul_div_assoc]; exact div_le_div_of_nonneg_right h3 (le_of_lt hd)
    · dsimp [d']; rw [div_le_iff₀ hd]; linarith
    · dsimp [x']; rw [abs_div, abs_of_pos hd, div_le_iff₀ hd]; exact h5
    · dsimp [τ', d']
      have : d_T j / d / 4 = (d_T j / 4) / d := by ring
      rw [this]
      exact div_lt_div_of_pos_right h6 hd
  have hS_disj' : ∀ j ∈ S, ∀ l ∈ S, j ≠ l → (ρ' j + ρ' l) / 2 ≤ |x' j - x' l| := by
    intro j hj l hl hjl
    have h_sep := hS_disj j hj l hl hjl
    have h_diff : x' j - x' l = (x_T j - x_T l) / d := by dsimp [x']; ring
    rw [h_diff, abs_div, abs_of_pos hd]
    dsimp [ρ']
    have : (ρ_T j / d + ρ_T l / d) / 2 = ((ρ_T j + ρ_T l) / 2) / d := by ring
    rw [this]
    exact div_le_div_of_nonneg_right h_sep (le_of_lt hd)
  have hS_offdiag' : ∀ m ∈ S, ∀ x : ℝ, |x - x' m| ≤ ρ' m / 8 →
      ∑ j ∈ S.erase m, ρ' j / (x - x' j) ^ 2 ≤ 6 / ρ' m := by
    intro m hm x hx
    let X : ℝ := p + d * x
    have hX_diff : ∀ j : Fin N, X - x_T j = d * (x - x' j) := by
      intro j; dsimp [X, x']; field_simp [hd.ne']; ring
    have hX_close : |X - x_T m| ≤ ρ_T m / 8 := by
      rw [hX_diff m, abs_mul, abs_of_pos hd]
      have := mul_le_mul_of_nonneg_left hx (le_of_lt hd)
      have h_rhs : d * (ρ' m / 8) = ρ_T m / 8 := by dsimp [ρ']; field_simp [hd.ne']
      linarith
    have h_sum_eq : ∑ j ∈ S.erase m, ρ' j / (x - x' j) ^ 2 =
        d * ∑ j ∈ S.erase m, ρ_T j / (X - x_T j) ^ 2 := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [hX_diff j]
      dsimp [ρ']
      field_simp [hd.ne']
    rw [h_sum_eq]
    calc d * ∑ j ∈ S.erase m, ρ_T j / (X - x_T j) ^ 2 ≤ d * (6 / ρ_T m) :=
      mul_le_mul_of_nonneg_left (hS_offdiag m hm X hX_close) (le_of_lt hd)
    _ = 6 / ρ' m := by dsimp [ρ']; field_simp [hd.ne']
  obtain ⟨V, hV_cont_raw, hV_tb, hV_lat, hV_sph, hV_wit, hV_mean⟩ :=
    hBarrier τ' N x' d' ρ' S hτ'_pos hτ'_lt hS_tiles' hS_disj' hS_offdiag'
  let R_open : Set ℂ := { z : ℂ | |z.re| < M_lat ∧ τ' < -z.im ∧ -z.im < 2 }
  let R_closed : Set ℂ := { z : ℂ | |z.re| ≤ M_lat ∧ τ' ≤ -z.im ∧ -z.im ≤ 2 }
  let c' : Fin N → ℂ := fun j => (x' j : ℂ) - (d' j : ℂ) * Complex.I
  let B_open : Set ℂ := ⋃ j ∈ S, Metric.ball (c' j) (ρ' j / 8)
  let B_closed : Set ℂ := ⋃ j ∈ S, Metric.closedBall (c' j) (ρ' j / 8)
  let Ω' : Set ℂ := R_open \ B_closed
  let aff : ℂ → ℂ := fun z => (p : ℂ) + (d : ℂ) * z
  let F' : ℂ → ℂ := fun z => F (aff z)
  let U_open' : Set ℂ := aff ⁻¹' U_open
  have hR_open : IsOpen R_open :=
    (isOpen_lt (continuous_abs.comp Complex.continuous_re) continuous_const).inter
      ((isOpen_lt continuous_const (continuous_neg.comp Complex.continuous_im)).inter
        (isOpen_lt (continuous_neg.comp Complex.continuous_im) continuous_const))
  have hR_closed : IsClosed R_closed :=
    (isClosed_le (continuous_abs.comp Complex.continuous_re) continuous_const).inter
      ((isClosed_le continuous_const (continuous_neg.comp Complex.continuous_im)).inter
        (isClosed_le (continuous_neg.comp Complex.continuous_im) continuous_const))
  have hΩ'_open : IsOpen Ω' :=
    hR_open.sdiff (isClosed_biUnion_finset (fun _ _ => Metric.isClosed_closedBall))
  have hΩ'_bdd : Bornology.IsBounded Ω' := by
    refine (Metric.isBounded_closedBall (x := (0 : ℂ)) (r := M_lat + 2)).subset ?_
    intro z ⟨hz_R, _⟩
    rw [Metric.mem_closedBall, dist_zero_right]
    have h_im_abs : |z.im| ≤ 2 := by
      rw [abs_le]; constructor <;> linarith [hz_R.2.1, hz_R.2.2]
    calc ‖z‖ ≤ |z.re| + |z.im| := Complex.norm_le_abs_re_add_abs_im z
    _ ≤ M_lat + 2 := by linarith [hz_R.1]
  have h_clos_sub : closure Ω' ⊆ R_closed \ B_open := by
    refine closure_minimal ?_ (hR_closed.sdiff (isOpen_biUnion (fun _ _ => Metric.isOpen_ball)))
    intro z ⟨hz_R, hz_not_cb⟩
    refine ⟨⟨le_of_lt hz_R.1, le_of_lt hz_R.2.1, le_of_lt hz_R.2.2⟩, fun hz_b => hz_not_cb ?_⟩
    obtain ⟨j, hjS, hzj⟩ := Set.mem_iUnion₂.mp hz_b
    exact Set.mem_biUnion hjS (Metric.ball_subset_closedBall hzj)
  have h_aff_re : ∀ z : ℂ, (aff z).re - p = d * z.re := by
    intro z; simp [aff]
  have h_aff_im : ∀ z : ℂ, -(aff z).im = d * (-z.im) := by
    intro z; simp [aff]
  have hR_sub_U' : R_closed ⊆ U_open' := by
    intro z ⟨hz1, hz2, hz3⟩
    apply hR_sub
    refine ⟨?_, ?_, ?_⟩
    · rw [h_aff_re, abs_mul, abs_of_pos hd, mul_comm]; exact mul_le_mul_of_nonneg_right hz1 (le_of_lt hd)
    · rw [h_aff_im]
      calc τ = d * τ' := by dsimp [τ']; field_simp [hd.ne']
      _ ≤ d * (-z.im) := mul_le_mul_of_nonneg_left hz2 (le_of_lt hd)
    · rw [h_aff_im]; linarith [mul_le_mul_of_nonneg_left hz3 (le_of_lt hd)]
  have h_clos_U' : closure Ω' ⊆ U_open' :=
    (h_clos_sub.trans Set.sdiff_subset).trans hR_sub_U'
  have h_aff_diff : Differentiable ℂ aff :=
    (differentiable_const _).add (differentiable_id.const_mul _)
  have hU_open' : IsOpen U_open' := hU_open.preimage h_aff_diff.continuous
  have hF'_diff : DifferentiableOn ℂ F' U_open' :=
    hF.comp h_aff_diff.differentiableOn (fun _ hz => hz)
  have hV_cont_clos : ContinuousOn V (closure Ω') := hV_cont_raw.mono h_clos_sub
  have hF'_top : ∀ z ∈ closure Ω', ‖F' z‖ ≤ Real.exp M_top := by
    intro z hz
    obtain ⟨⟨hz1, hz2, hz3⟩, _⟩ := h_clos_sub hz
    refine hF_top (aff z) ?_ ?_ ?_
    · rw [h_aff_re, abs_mul, abs_of_pos hd, mul_comm]
      exact mul_le_mul_of_nonneg_right hz1 (le_of_lt hd)
    · rw [h_aff_im]
      calc τ = d * τ' := by dsimp [τ']; field_simp [hd.ne']
      _ ≤ d * (-z.im) := mul_le_mul_of_nonneg_left hz2 (le_of_lt hd)
    · rw [h_aff_im]; linarith [mul_le_mul_of_nonneg_left hz3 (le_of_lt hd)]
  have h_front' : ∀ z ∈ frontier Ω',
      V z ≤ 0 ∨ (V z ≤ C_disk ∧ ‖F' z‖ ≤ Real.exp (M_top - H_def)) := by
    intro z hz_fr
    rw [frontier, hΩ'_open.interior_eq] at hz_fr
    obtain ⟨hz_clos, hz_not_Ω⟩ := hz_fr
    obtain ⟨hz_Rc, hz_not_Bo⟩ := h_clos_sub hz_clos
    by_cases hz_Ro : z ∈ R_open
    · right
      have hz_Bc : z ∈ B_closed := by
        by_contra h_not
        exact hz_not_Ω ⟨hz_Ro, h_not⟩
      obtain ⟨m, hmS, hzm_cb⟩ := Set.mem_iUnion₂.mp hz_Bc
      have hzm_not_b : z ∉ Metric.ball (c' m) (ρ' m / 8) :=
        fun hb => hz_not_Bo (Set.mem_biUnion hmS hb)
      rw [Metric.mem_closedBall] at hzm_cb
      rw [Metric.mem_ball, not_lt] at hzm_not_b
      have hzm_sph : z ∈ Metric.sphere (c' m) (ρ' m / 8) :=
        Metric.mem_sphere.mpr (le_antisymm hzm_cb hzm_not_b)
      refine ⟨hV_sph m hmS z hzm_sph, ?_⟩
      have h_aff_cm : aff (c' m) = (x_T m : ℂ) - (d_T m : ℂ) * Complex.I := by
        dsimp [aff, c', x', d']
        have hd_c : (d : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hd.ne'
        push_cast
        field_simp [hd_c]
        ring
      have h_aff_ball : aff z ∈
          Metric.closedBall ((x_T m : ℂ) - (d_T m : ℂ) * Complex.I) (ρ_T m / 8) := by
        rw [Metric.mem_closedBall, dist_eq_norm, ← h_aff_cm]
        have h_diff : aff z - aff (c' m) = (d : ℂ) * (z - c' m) := by dsimp [aff]; ring
        rw [h_diff, norm_mul, Complex.norm_of_nonneg (le_of_lt hd), ← dist_eq_norm]
        calc d * dist z (c' m) ≤ d * (ρ' m / 8) :=
          mul_le_mul_of_nonneg_left hzm_cb (le_of_lt hd)
        _ = ρ_T m / 8 := by dsimp [ρ']; field_simp [hd.ne']
      exact hF_bad m (aff z) h_aff_ball
    · left
      obtain ⟨hz1, hz2, hz3⟩ := hz_Rc
      rcases lt_or_eq_of_le hz1 with h1_lt | h1_eq
      · rcases lt_or_eq_of_le hz2 with h2_lt | h2_eq
        · rcases lt_or_eq_of_le hz3 with h3_lt | h3_eq
          · exact False.elim (hz_Ro ⟨h1_lt, h2_lt, h3_lt⟩)
          · exact hV_tb z hz1 (Or.inr h3_eq)
        · exact hV_tb z hz1 (Or.inl h2_eq.symm)
      · exact hV_lat z h1_eq hz2 hz3
  have hw₀_mem' : (-Complex.I : ℂ) ∈ Ω' := by
    refine ⟨⟨?_, ?_, ?_⟩, fun h_cb => ?_⟩
    · simp only [Complex.neg_re, Complex.I_re, neg_zero, abs_zero]; linarith
    · simp only [Complex.neg_im, Complex.I_im, neg_neg]; linarith
    · simp only [Complex.neg_im, Complex.I_im, neg_neg]; norm_num
    · obtain ⟨j, hjS, hzj⟩ := Set.mem_iUnion₂.mp h_cb
      obtain ⟨hρj_pos, haj, _, hdj_half, _, _⟩ := hS_tiles' j hjS
      have hρj_le : ρ' j ≤ 1 / 2 := by nlinarith
      rw [Metric.mem_closedBall, dist_eq_norm] at hzj
      have h_im_le : |((-Complex.I : ℂ) - c' j).im| ≤ ‖(-Complex.I : ℂ) - c' j‖ :=
        Complex.abs_im_le_norm _
      have h_im_val : ((-Complex.I : ℂ) - c' j).im = -(1 - d' j) := by
        simp [c']; ring
      rw [h_im_val, abs_neg, abs_of_nonneg (by linarith)] at h_im_le
      linarith
  have hF'_wit : Real.exp (M_top - U₀) ≤ ‖F' (-Complex.I)‖ := by
    have : aff (-Complex.I) = (p : ℂ) - (d : ℂ) * Complex.I := by dsimp [aff]; ring
    dsimp [F']; rw [this]; exact hF_wit
  have hV_ub : V (-Complex.I) ≤ 2 * C_disk * (U₀ / H_def) :=
    h_s3 Ω' U_open' F' V M_top U₀ H_def C_disk (-Complex.I)
      hΩ'_open hΩ'_bdd hU_open' h_clos_U' hF'_diff hV_cont_clos
      (fun z₀ _ r hr hcb => hV_mean z₀ r hr hcb)
      hU₀ hH hC_disk hF'_top h_front' hw₀_mem' hF'_wit
  have h_sum_ρ : ∑ j ∈ S, ρ' j = (∑ j ∈ S, ρ_T j) / d := by
    dsimp [ρ']; exact (Finset.sum_div S ρ_T d).symm
  rw [h_sum_ρ] at hV_wit
  have h_sum_bound : ∑ j ∈ S, ρ_T j ≤ (2 * C_disk / c_wit) * d * (U₀ / H_def) := by
    have h1 : c_wit * ((∑ j ∈ S, ρ_T j) / d) ≤ 2 * C_disk * (U₀ / H_def) :=
      le_trans hV_wit hV_ub
    calc
      ∑ j ∈ S, ρ_T j = (d / c_wit) * (c_wit * ((∑ j ∈ S, ρ_T j) / d)) := by
        field_simp [hc_wit.ne', hd.ne']
      _ ≤ (d / c_wit) * (2 * C_disk * (U₀ / H_def)) :=
        mul_le_mul_of_nonneg_left h1 (by positivity)
      _ = (2 * C_disk / c_wit) * d * (U₀ / H_def) := by ring
  calc
    MeasureTheory.volume.real
        (⋃ i : Fin N, Set.Icc (x_T i - ρ_T i / 2) (x_T i + ρ_T i / 2)) ≤
        3 * (∑ j ∈ S, ρ_T j) := hS_meas
    _ ≤ 3 * ((2 * C_disk / c_wit) * d * (U₀ / H_def)) :=
        mul_le_mul_of_nonneg_left h_sum_bound (by norm_num)
    _ = (6 * C_disk / c_wit) * d * (U₀ / H_def) := by ring

theorem good_chain_polygonal_routing : GoodChainRoutingProp :=
by
  have zero_free_ball_modulus_lower_bound
      (G : ℂ → ℂ) (q : ℂ) (R₁ M T : ℝ)
      (hR₁ : 0 < R₁) (hT : 0 < T)
      (hG_holo : DifferentiableOn ℂ G (Metric.ball q R₁))
      (hG_nz : ∀ z ∈ Metric.ball q R₁, G z ≠ 0)
      (hG_up : ∀ z ∈ Metric.ball q R₁, ‖G z‖ ≤ Real.exp M)
      (hG_q : Real.exp (M - 2 * T) ≤ ‖G q‖) :
      ∀ z ∈ Metric.closedBall q (R₁ / 2), Real.exp (M - 6 * T) ≤ ‖G z‖ := by
    set B : Set ℂ := Metric.ball q R₁
    have hB_open : IsOpen B := Metric.isOpen_ball
    have hq_mem : q ∈ B := Metric.mem_ball_self hR₁
    have hf_holo : DifferentiableOn ℂ (fun z => -deriv G z / G z) B :=
      ((hG_holo.deriv hB_open).neg).div hG_holo hG_nz
    obtain ⟨L₀, hL₀⟩ := Convex.exists_forall_hasDerivWithinAt (convex_ball q R₁) hf_holo
    let L : ℂ → ℂ := fun z => L₀ z - L₀ q
    have hL_q : L q = 0 := sub_self (L₀ q)
    have hL_deriv : ∀ z ∈ B, HasDerivAt L (-deriv G z / G z) z := by
      intro z hz
      exact ((hL₀ z hz).hasDerivAt (hB_open.mem_nhds hz)).sub_const (L₀ q)
    have hL_holo : DifferentiableOn ℂ L B :=
      fun z hz => (hL_deriv z hz).differentiableAt.differentiableWithinAt
    let H : ℂ → ℂ := fun z => G z * Complex.exp (L z)
    have hH_deriv : ∀ z ∈ B, HasDerivAt H 0 z := by
      intro z hz
      have hG_at : HasDerivAt G (deriv G z) z :=
        (hG_holo.differentiableAt (hB_open.mem_nhds hz)).hasDerivAt
      have hE_at : HasDerivAt (fun w => Complex.exp (L w))
          (Complex.exp (L z) * (-deriv G z / G z)) z :=
        (hL_deriv z hz).cexp
      have hmul := hG_at.mul hE_at
      have hzero : deriv G z * Complex.exp (L z) +
          G z * (Complex.exp (L z) * (-deriv G z / G z)) = 0 := by
        have hnz := hG_nz z hz
        field_simp [hnz]
        ring
      rwa [hzero] at hmul
    have hH_diff : DifferentiableOn ℂ H B :=
      fun z hz => (hH_deriv z hz).differentiableAt.differentiableWithinAt
    have hH_d0 : Set.EqOn (deriv H) 0 B := fun z hz => (hH_deriv z hz).deriv
    have hH_const : ∀ z ∈ B, G z * Complex.exp (L z) = G q := by
      intro z hz
      have heq := hB_open.is_const_of_deriv_eq_zero (convex_ball q R₁).isPreconnected
        hH_diff hH_d0 hz hq_mem
      simpa [H, hL_q] using heq
    have hRe_low : ∀ z ∈ B, -2 * T ≤ (L z).re := by
      intro z hz
      have hnorm_eq : ‖G q‖ = ‖G z‖ * Real.exp ((L z).re) := by
        rw [← hH_const z hz, norm_mul, Complex.norm_exp]
      have hle : Real.exp (M - 2 * T) ≤ Real.exp (M + (L z).re) := by
        calc Real.exp (M - 2 * T) ≤ ‖G q‖ := hG_q
          _ = ‖G z‖ * Real.exp ((L z).re) := hnorm_eq
          _ ≤ Real.exp M * Real.exp ((L z).re) :=
              mul_le_mul_of_nonneg_right (hG_up z hz) (Real.exp_nonneg _)
          _ = Real.exp (M + (L z).re) := (Real.exp_add M ((L z).re)).symm
      have := Real.exp_le_exp.mp hle
      linarith
    let c4T : ℂ := ((4 * T : ℝ) : ℂ)
    let Ψ : ℂ → ℂ := fun z => L z / (L z + c4T)
    have h_denom_nz : ∀ z ∈ B, L z + c4T ≠ 0 := by
      intro z hz h0
      have hre : (L z + c4T).re = 0 := by rw [h0]; simp
      have hre2 : (L z + c4T).re = (L z).re + 4 * T := by simp [c4T]
      have := hRe_low z hz
      linarith
    have hΨ_holo : DifferentiableOn ℂ Ψ B :=
      hL_holo.div (hL_holo.add (differentiableOn_const c4T)) h_denom_nz
    have hΨ_q : Ψ q = 0 := by simp [Ψ, hL_q]
    have hΨ_maps : Set.MapsTo Ψ B (Metric.closedBall (Ψ q) 1) := by
      intro z hz
      rw [Metric.mem_closedBall, hΨ_q, dist_zero_right]
      have hsq1 : ‖L z‖ ^ 2 = (L z).re * (L z).re + (L z).im * (L z).im := by
        rw [← Complex.normSq_eq_norm_sq, Complex.normSq_apply]
      have hsq2 : ‖L z + c4T‖ ^ 2 =
          ((L z).re + 4 * T) * ((L z).re + 4 * T) + (L z).im * (L z).im := by
        rw [← Complex.normSq_eq_norm_sq, Complex.normSq_apply]
        simp [c4T]
      have hre_z := hRe_low z hz
      have hle_sq : ‖L z‖ ^ 2 ≤ ‖L z + c4T‖ ^ 2 := by nlinarith
      have hn1 : 0 ≤ ‖L z‖ := norm_nonneg _
      have hn2 : 0 < ‖L z + c4T‖ := norm_pos_iff.mpr (h_denom_nz z hz)
      have hle_norm : ‖L z‖ ≤ ‖L z + c4T‖ := by nlinarith
      simpa [Ψ, norm_div] using div_le_one_of_le₀ hle_norm (le_of_lt hn2)
    intro z hz_cb
    have hz_dist : dist z q ≤ R₁ / 2 := Metric.mem_closedBall.mp hz_cb
    have hz_B : z ∈ B := Metric.mem_ball.mpr (by linarith)
    have h_schwarz := Complex.dist_le_div_mul_dist_of_mapsTo_ball hΨ_holo hΨ_maps hz_B
    have hΨ_half : ‖Ψ z‖ ≤ 1 / 2 := by
      have hd : dist (Ψ z) (Ψ q) = ‖Ψ z‖ := by rw [hΨ_q, dist_zero_right]
      have hbound : 1 / R₁ * dist z q ≤ 1 / 2 := by
        calc 1 / R₁ * dist z q ≤ 1 / R₁ * (R₁ / 2) :=
              mul_le_mul_of_nonneg_left hz_dist (by positivity)
          _ = 1 / 2 := by field_simp [hR₁.ne']
      linarith
    have hL_eq : L z = Ψ z * (L z + c4T) := by
      simp only [Ψ]
      exact (div_mul_cancel₀ (L z) (h_denom_nz z hz_B)).symm
    have hc4T_norm : ‖c4T‖ = 4 * T := by
      simp only [c4T, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (by positivity : 0 < 4 * T)]
    have hL_norm : ‖L z‖ ≤ 4 * T := by
      have h1 : ‖L z‖ = ‖Ψ z‖ * ‖L z + c4T‖ := by
        calc ‖L z‖ = ‖Ψ z * (L z + c4T)‖ := congrArg norm hL_eq
          _ = ‖Ψ z‖ * ‖L z + c4T‖ := norm_mul _ _
      have h2 : ‖L z + c4T‖ ≤ ‖L z‖ + 4 * T := by
        calc ‖L z + c4T‖ ≤ ‖L z‖ + ‖c4T‖ := norm_add_le _ _
          _ = ‖L z‖ + 4 * T := by rw [hc4T_norm]
      have h3 : ‖Ψ z‖ * ‖L z + c4T‖ ≤ (1 / 2) * (‖L z‖ + 4 * T) :=
        mul_le_mul hΨ_half h2 (norm_nonneg _) (by positivity)
      linarith
    have hRe_up : (L z).re ≤ 4 * T :=
      (le_abs_self _).trans ((Complex.abs_re_le_norm (L z)).trans hL_norm)
    have hnorm_eq : ‖G q‖ = ‖G z‖ * Real.exp ((L z).re) := by
      rw [← hH_const z hz_B, norm_mul, Complex.norm_exp]
    have hGz_eq : ‖G z‖ = ‖G q‖ * Real.exp (-(L z).re) := by
      rw [hnorm_eq, mul_assoc, ← Real.exp_add, add_neg_cancel, Real.exp_zero, mul_one]
    rw [hGz_eq]
    calc Real.exp (M - 6 * T)
        = Real.exp (M - 2 * T) * Real.exp (-4 * T) := by
            rw [← Real.exp_add]; ring_nf
      _ ≤ ‖G q‖ * Real.exp (-(L z).re) := by
            apply mul_le_mul hG_q
            · exact Real.exp_le_exp.mpr (by linarith)
            · positivity
            · exact norm_nonneg _
  have single_tile_blaschke_zero_factorization
      (F : ℂ → ℂ) (c : ℂ) (ρ M T : ℝ)
      (hρ : 0 < ρ)
      (hF_holo : DifferentiableOn ℂ F (Metric.ball c (100 * ρ)))
      (hF_up : ∀ z ∈ Metric.ball c (100 * ρ), ‖F z‖ ≤ Real.exp M)
      (hq_ex : ∃ q ∈ meshClosedSquare c ρ, Real.exp (M - 2 * T) ≤ ‖F q‖) :
      ∃ (q : ℂ) (N : ℕ) (a : Fin N → ℂ) (G : ℂ → ℂ),
        (N : ℝ) ≤ (2 / Real.log 2) * T ∧
        meshClosedSquare c (9 * ρ) ⊆ Metric.closedBall q (15 * ρ) ∧
        DifferentiableOn ℂ G (Metric.ball q (30 * ρ)) ∧
        (∀ z ∈ Metric.ball q (30 * ρ), G z ≠ 0) ∧
        (∀ z ∈ Metric.ball q (30 * ρ), ‖G z‖ ≤ Real.exp M) ∧
        Real.exp (M - 2 * T) ≤ ‖G q‖ ∧
        (∀ z ∈ Metric.closedBall q (15 * ρ),
          ‖G z‖ * (2 / (135 * ρ)) ^ N * (∏ i : Fin N, ‖z - a i‖) ≤ ‖F z‖) := by
    obtain ⟨q, hq_sq, hFq⟩ := hq_ex
    have h_l1 : ∀ w : ℂ, ‖w‖ ≤ |w.re| + |w.im| := by
      intro w
      calc ‖w‖ = ‖(w.re : ℂ) + (w.im : ℂ) * Complex.I‖ := by rw [Complex.re_add_im]
        _ ≤ ‖(w.re : ℂ)‖ + ‖(w.im : ℂ) * Complex.I‖ := norm_add_le _ _
        _ = |w.re| + |w.im| := by simp [Complex.norm_real, Real.norm_eq_abs]
    have hqc : ‖q - c‖ ≤ ρ := by
      have h1 := h_l1 (q - c)
      have h2 := hq_sq.1
      have h3 := hq_sq.2
      linarith
    have h_sq_sub : meshClosedSquare c (9 * ρ) ⊆ Metric.closedBall q (15 * ρ) := by
      intro z hz
      rw [Metric.mem_closedBall, dist_eq_norm]
      have hzc : ‖z - c‖ ≤ 9 * ρ := by
        have h1 := h_l1 (z - c)
        have h2 := hz.1
        have h3 := hz.2
        linarith
      have hzq : ‖z - q‖ ≤ ‖z - c‖ + ‖q - c‖ := by
        calc ‖z - q‖ = ‖(z - c) - (q - c)‖ := by ring_nf
          _ ≤ ‖z - c‖ + ‖q - c‖ := norm_sub_le _ _
      linarith
    set U₀ : Set ℂ := Metric.ball q (90 * ρ)
    set R₀ : ℝ := 60 * ρ
    have hR₀_pos : 0 < R₀ := by positivity
    have hU₀_sub : U₀ ⊆ Metric.ball c (100 * ρ) := by
      intro z hz
      rw [Metric.mem_ball, dist_eq_norm] at hz ⊢
      have hzq : ‖z - c‖ ≤ ‖z - q‖ + ‖q - c‖ := by
        calc ‖z - c‖ = ‖(z - q) + (q - c)‖ := by ring_nf
          _ ≤ ‖z - q‖ + ‖q - c‖ := norm_add_le _ _
      linarith
    have h_cb_R₀_U₀ : Metric.closedBall q R₀ ⊆ U₀ := by
      intro z hz
      rw [Metric.mem_closedBall] at hz
      rw [Metric.mem_ball]
      linarith
    let D_fn : ℂ → ℂ → ℂ := fun a z => ((R₀ : ℝ) : ℂ) ^ 2 - starRingEnd ℂ (a - q) * (z - q)
    let B_fn : ℂ → ℂ → ℂ := fun a z => ((R₀ : ℝ) : ℂ) * (z - a) / D_fn a z
    have hR₀_C_norm : ‖((R₀ : ℝ) : ℂ)‖ = R₀ := by
      simp [Complex.norm_real, Real.norm_eq_abs, abs_of_pos hR₀_pos]
    have hD_nz : ∀ a ∈ Metric.ball q (30 * ρ), ∀ z ∈ U₀, D_fn a z ≠ 0 := by
      intro a ha z hz h0
      rw [Metric.mem_ball, dist_eq_norm] at ha hz
      have hprod : ‖starRingEnd ℂ (a - q) * (z - q)‖ < 2700 * ρ ^ 2 := by
        rw [norm_mul, Complex.norm_conj]
        nlinarith [norm_nonneg (a - q), norm_nonneg (z - q)]
