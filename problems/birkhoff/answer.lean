            have h_mulVec : (H_mat.mulVec x_vec) r =
                D_val * MvPowerSeries.coeff d (η ⟨r.1 + 1, by have := r.2; omega⟩) +
                U_val * MvPowerSeries.coeff d (η ⟨r.1 + 2, by have := r.2; omega⟩) +
                L_val * MvPowerSeries.coeff d (η ⟨r.1, by have := r.2; omega⟩) := by
              simp only [Matrix.mulVec, dotProduct, h_entry_split, Finset.sum_add_distrib,
                h_sum_D, h_sum_U, h_sum_L]
            rw [h_mulVec]
            have h_grad_diff :
                MvPowerSeries.coeff d (lcJetGrad2D h_tr S_ser C_ser α_ser r) -
                MvPowerSeries.coeff d (lcJetGrad2D h_tr S_ser C_ser α_ref r) =
                  MvPowerSeries.coeff d
                    (lcJetEdgePlus2D (h_tr i_L) (S_ser i_L) (C_ser i_L)
