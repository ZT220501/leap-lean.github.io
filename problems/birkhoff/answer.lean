        fun k hk y t hyt => (hAdm_m.2.2.2.2 k hk y t hyt).trans hη_m_le⟩
    exact ⟨s_stage m, d_m, M_m, U_m, hs_m_pos, hs_m_le, hd_pos, hd_le, hd_lt,
