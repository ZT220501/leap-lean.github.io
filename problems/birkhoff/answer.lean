    rw [hAbs1, mul_one] at hIntBnd
    dsimp only [gG] at hIntBnd
    linarith [hMker_nn]

  obtain ⟨M_ker, hMker_nn, hKer⟩ := hKer_cont

  
  let p : ℕ := m + 2
