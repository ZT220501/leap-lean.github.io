      convert hd_tanh.sub hd_quot using 1
      have h_id : Complex.cosh z * Complex.cosh z - Complex.sinh z * Complex.sinh z = 1 := by
        rw [← sq, ← sq]; exact Complex.cosh_sq_sub_sinh_sq z
