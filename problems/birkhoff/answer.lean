    have h_C2_half : (MvPowerSeries.C (2 : ℂ) : MvPowerSeries (Fin 2) ℂ) *
        MvPowerSeries.C (1 / 2 : ℂ) = 1 := by
      rw [← map_mul]; norm_num
    have h_edge_taylor : ∀ i : Fin k,
