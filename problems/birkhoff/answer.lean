        intro ⟨c, i⟩ q' hq'
        fin_cases c <;> fin_cases i
        · exact hr₀₀_eq q' (Metric.ball_subset_ball
            (le_trans (min_le_left _ _) (min_le_left _ _)) hq')
        · exact hr₀₁_eq q' (Metric.ball_subset_ball
            (le_trans (min_le_left _ _) (min_le_right _ _)) hq')
        · exact hr₁₀_eq q' (Metric.ball_subset_ball
            (le_trans (min_le_right _ _) (min_le_left _ _)) hq')
        · exact hr₁₁_eq q' (Metric.ball_subset_ball
            (le_trans (min_le_right _ _) (min_le_right _ _)) hq')
