  have hν_img : ν '' Set.uIcc k₀ K ⊆ Set.Icc H₀ H_K := by
    rw [Set.uIcc_of_le hK]
    rintro _ ⟨u, hu, rfl⟩
    refine ⟨?_, ?_⟩
    · dsimp [ν, H₀]; linarith [Real.exp_le_exp.mpr (neg_le_neg hu.1)]
    · dsimp [ν, H_K]; linarith [Real.exp_le_exp.mpr (neg_le_neg hu.2)]
  have h_sub_eq :
      (∫ v in H₀..H_K, (S.H - v) * (8 * F₂ v + 8)) =
        ∫ u in k₀..K, (8 * (rowMomentF S u) ^ 2 + 8 * Real.exp (-2 * u)) := by
    have h_g_cont : ContinuousOn (fun v => (S.H - v) * (8 * F₂ v + 8)) (ν '' Set.uIcc k₀ K) :=
      ((continuousOn_const.sub continuousOn_id).mul
        ((hF₂_cont.const_mul 8).add continuousOn_const)).mono hν_img
    have h_comp := intervalIntegral.integral_comp_mul_deriv' hν_deriv
      (by fun_prop) h_g_cont
    have hν_bot : ν k₀ = H₀ := rfl
    have hν_top : ν K = H_K := rfl
    rw [← hν_bot, ← hν_top, ← h_comp]
    refine intervalIntegral.integral_congr fun u _ => ?_
    have hF₂_nn : 0 ≤ F₂ (ν u) :=
      mul_nonneg (inv_nonneg.mpr h2pi_pos.le)
        (intervalIntegral.integral_nonneg h2pi_pos.le fun x _ => sq_nonneg _)
    have hexp_sq : Real.exp (-u) ^ 2 = Real.exp (-2 * u) := by
      rw [sq, ← Real.exp_add]; ring_nf
    have h_rm : (rowMomentF S u) ^ 2 = Real.exp (-2 * u) * F₂ (ν u) := by
