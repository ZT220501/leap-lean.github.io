    let α_full : ℂ → Fin (k + 1) → ℂ := fun ε s =>
      M.α₀ δ s + ∑ m : Fin (J + 1), ε ^ (m : ℕ) * M.β m δ s
    have hα_full_zero : α_full 0 = M.α₀ δ := by
      ext s
      dsimp [α_full]
      have hsum0 : (∑ m : Fin (J + 1), (0 : ℂ) ^ (m : ℕ) * M.β m δ s) = 0 := by
        refine Finset.sum_eq_zero fun m _ => ?_
        by_cases hm0 : (m : ℕ) = 0
        · have hm_eq : m = 0 := Fin.ext hm0
          rw [hm_eq, M.β_zero, mul_zero]
        · rw [zero_pow hm0, zero_mul]
      rw [hsum0, add_zero]
    have hα_full_cont : ∀ s : Fin (k + 1), Continuous (fun ε => α_full ε s) := by
      intro s
      exact continuous_const.add (continuous_finset_sum _ fun m _ =>
        (continuous_pow (m : ℕ)).mul continuous_const)
    refine ⟨?_, ?_⟩
    · intro l hl1 hlJ r
      let α_lt : ℂ → Fin (k + 1) → ℂ := fun ε s =>
        M.α₀ δ s + ∑ m ∈ Finset.univ.filter (fun m : Fin (J + 1) => (m : ℕ) < l),
          ε ^ (m : ℕ) * M.β m δ s
      have hα_lt_zero : α_lt 0 = M.α₀ δ := by
        ext s
        dsimp [α_lt]
        have hsum0 : (∑ m ∈ Finset.univ.filter (fun m : Fin (J + 1) => (m : ℕ) < l),
            (0 : ℂ) ^ (m : ℕ) * M.β m δ s) = 0 := by
          refine Finset.sum_eq_zero fun m _ => ?_
          by_cases hm0 : (m : ℕ) = 0
          · have hm_eq : m = 0 := Fin.ext hm0
            rw [hm_eq, M.β_zero, mul_zero]
          · rw [zero_pow hm0, zero_mul]
        rw [hsum0, add_zero]
      have hα_lt_cont : ∀ s : Fin (k + 1), Continuous (fun ε => α_lt ε s) := by
        intro s
        exact continuous_const.add (continuous_finset_sum _ fun m _ =>
          (continuous_pow (m : ℕ)).mul continuous_const)
      have h_mid_nhds : ∀ᶠ ε : ℂ in nhds 0, ∀ i : Fin k,
          lineChainMid (α_full ε) i ∈ M.W_n ∧ lineChainMid (α_lt ε) i ∈ M.W_n := by
        rw [Filter.eventually_all]
        intro i
        have hc1 : Continuous (fun ε => lineChainMid (α_full ε) i) :=
          ((hα_full_cont i.castSucc).add (hα_full_cont i.succ)).div_const 2
        have hc2 : Continuous (fun ε => lineChainMid (α_lt ε) i) :=
          ((hα_lt_cont i.castSucc).add (hα_lt_cont i.succ)).div_const 2
        have h0_1 : lineChainMid (α_full 0) i ∈ M.W_n := by
          rw [hα_full_zero]; exact M.α₀_maps_W_n δ hδ i
        have h0_2 : lineChainMid (α_lt 0) i ∈ M.W_n := by
          rw [hα_lt_zero]; exact M.α₀_maps_W_n δ hδ i
