        simpa only [zero_add] using (hGext_per y).intervalIntegral_add_eq v 0
      simp_rw [h_inner_per, ← MeasureTheory.integral_const_mul]
      change (∫ p in Set.Icc (-L) L ×ˢ Set.Icc y₁ y₂, h_row p.2
        ∂MeasureTheory.volume.prod MeasureTheory.volume) = _
      have hInt_prod : MeasureTheory.IntegrableOn (fun p : ℝ × ℝ => h_row p.2) K_vy
          (MeasureTheory.volume.prod MeasureTheory.volume) := by
        change MeasureTheory.IntegrableOn (fun p : ℝ × ℝ => h_row p.2) K_vy MeasureTheory.volume
        exact (hCont_row.comp continuous_snd).continuousOn.integrableOn_compact hKvy_compact
      rw [MeasureTheory.setIntegral_prod (fun p : ℝ × ℝ => h_row p.2) hInt_prod]
      simp only [MeasureTheory.setIntegral_const, smul_eq_mul,
        Real.volume_real_Icc_of_le (by linarith : -L ≤ L), sub_neg_eq_add, ← two_mul]
      rw [MeasureTheory.integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le hy12]
      congr 1
      have hderiv : ∀ j ∈ Set.uIcc j₁ j₂, HasDerivAt φ (Real.exp (-j)) j := by
        intro j _
        have h1 : HasDerivAt (fun x : ℝ => Real.exp (-x)) (Real.exp (-j) * (-1)) j :=
          HasDerivAt.exp (hasDerivAt_neg j)
        simpa [φ] using h1.const_sub S.H
