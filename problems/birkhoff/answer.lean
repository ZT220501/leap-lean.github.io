      linarith
    have h_N_t := h_b_term 1 t₁ t₂ abs_one ht₁_0 ht₁_9 ht₁_2 ht₂_0 ht₂_9 ht₂_2 ht_diff_le
    simp only [one_mul] at h_N_t
    have h_N_s := h_b_term (-1) s₁ s₂ (by norm_num) hs₁_0 hs₁_9 hs₁_2 hs₂_0 hs₂_9 hs₂_2 hs_diff_le
