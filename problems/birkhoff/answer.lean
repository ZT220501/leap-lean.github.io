        let u : ℂ → ℂ := fun z => e_X z + y z
        have he_1 : IsStripBounded p σ' 1 e_X :=
          hCalc.bounded_mono h4q_inv_le ⟨he.1, he.2.2.2.2⟩
        have hu_2 : IsStripBounded p σ' 2 u := by
          have h := hCalc.bounded_add he_1 hy_s.1
          norm_num at h
          exact h
        have hdu_bnd : IsStripBounded (m + 1) σ' 2 (deriv u) := by
          refine ⟨hu_2.1.deriv (hStrip_open σ'), ?_⟩
          intro r hr z hz
          rw [← iteratedDeriv_succ']
          exact hu_2.2 (r + 1) (by omega) z hz
        have hdξ_eq : ∀ z ∈ horizStrip σ', deriv ξ z = 1 + deriv u z := by
          intro z hz
          have hnhds := (hStrip_open σ').mem_nhds hz
          have hd_u := hu_2.1.differentiableAt hnhds
          have hEqFn : ξ = ((fun w => w + (ρ : ℂ)) + u) := by
            ext w; dsimp [ξ, u]; ring
          rw [hEqFn]
          have hd := (((hasDerivAt_id z).add_const (ρ : ℂ)).add hd_u.hasDerivAt).deriv
          simpa using hd
        have hdξ_bnd : IsStripBounded (m + 1) σ' 3 (deriv ξ) := by
          have h1 := hCalc.bounded_const (m + 1) σ' (1 : ℂ)
          rw [norm_one] at h1
          have hsum := hCalc.bounded_add h1 hdu_bnd
          norm_num at hsum
          exact hBnd_congr hsum hdξ_eq
        refine ⟨((differentiableOn_id.add (differentiableOn_const (ρ : ℂ))).add he.1).add hy_s.1.1,
          ?_, ?_, ?_⟩
        · intro z hz
          dsimp [ξ]
          rw [he.2.1 z hz, hy_s.2.1 z hz]
          ring
        · intro z hz
          dsimp [ξ]
          rw [he.2.2.1 z hz, hy_s.2.2 z hz]
          simp [Complex.conj_ofReal]
        · intro j hj1 hjp z hz
          have hj_eq : (j - 1) + 1 = j := by omega
          rw [← hj_eq, iteratedDeriv_succ']
          exact hdξ_bnd.2 (j - 1) (by omega) z hz
      obtain ⟨hξ₁_holo, hξ₁_per, hξ₁_conj, hξ₁_jbnd⟩ := hShiftedDeriv e_X₁ y₁ he₁ hy₁
      obtain ⟨hξ₂_holo, hξ₂_per, hξ₂_conj, hξ₂_jbnd⟩ := hShiftedDeriv e_X₂ y₂ he₂ hy₂
      have hComp1 :=
        hCalc.comp_bound p σ' M₁ 3 (horizStrip σ) (iteratedDeriv d W₁)
          (fun z => X₁ z + y₁ z)
          (hStrip_open σ) (le_of_lt hM₁) (by norm_num) hG₁_holo
          (fun j hj w hw => hG₁_bnd j (by omega) w hw)
          hξ₁_holo (fun z hz => (hMapsY z hz).1) hξ₁_jbnd
      have hComp2 :=
        hCalc.comp_bound p σ' M₁ 3 (horizStrip σ) (iteratedDeriv d W₂)
          (fun z => X₂ z + y₂ z)
          (hStrip_open σ) (le_of_lt hM₁) (by norm_num) hG₂_holo
          (fun j hj w hw => hG₂_bnd j (by omega) w hw)
          hξ₂_holo (fun z hz => (hMapsY z hz).2) hξ₂_jbnd
      have he_diff_bnd : IsStripBounded p σ' Δ (fun z => e_X₁ z - e_X₂ z) :=
        hCalc.bounded_mono (by linarith [hΔW_nn]) ⟨he₁.1.sub he₂.1, hde⟩
      have hξ_diff : IsStripBounded p σ' ((1 + L_y) * Δ)
          (fun z => (X₁ z + y₁ z) - (X₂ z + y₂ z)) := by
        have hsum := hCalc.bounded_add he_diff_bnd hy_diff
        have hEq : Δ + L_y * Δ = (1 + L_y) * Δ := by ring
        rw [hEq] at hsum
        exact hBnd_congr hsum (fun _ _ => by dsimp [X₁, X₂]; ring)
      have hCompDiff :=
        hCalc.comp_diff_bound p σ' M₁ (stripDiffSup (m + 15) σ W₁ W₂)
          3 ((1 + L_y) * Δ) (horizStrip σ)
          (iteratedDeriv d W₁) (iteratedDeriv d W₂)
          (fun z => X₁ z + y₁ z) (fun z => X₂ z + y₂ z)
          (hStrip_open σ) (hStrip_convex σ)
          (le_of_lt hM₁) hΔW_nn (by norm_num) (mul_nonneg (by linarith) hΔ_nn)
          hG₁_holo hG₂_holo
          (fun j hj w hw => hΔW_bnd j d (by omega) w hw)
          (fun j hj w hw => hG₂_bnd j (by omega) w hw)
          hξ₁_holo hξ₂_holo
          (fun z hz => (hMapsY z hz).1) (fun z hz => (hMapsY z hz).2)
          hξ₁_jbnd hξ₂_jbnd hξ_diff
      have hDiffLe :
          shjCompConst p 3 *
              (stripDiffSup (m + 15) σ W₁ W₂ + (2 : ℝ) ^ p * M₁ * ((1 + L_y) * Δ)) ≤
            (shjCompConst p 3 * (1 + (2 : ℝ) ^ p * M₁ * (1 + L_y))) * Δ := by
        have hW_le_Δ : stripDiffSup (m + 15) σ W₁ W₂ ≤ Δ := by linarith [hΔe]
        have hc_nn := hCompConst_pos p 3
        nlinarith
      refine ⟨mul_nonneg (le_of_lt hM₁) (hCompConst_pos p 3),
        mul_nonneg (hCompConst_pos p 3) (by positivity), hΔ_nn,
        ⟨hComp1, ?_, ?_⟩, ⟨hComp2, ?_, ?_⟩,
        hCalc.bounded_mono hDiffLe hCompDiff⟩
      · intro z hz
        dsimp only
        have hper : X₁ (z + 2 * Real.pi) + y₁ (z + 2 * Real.pi) = (X₁ z + y₁ z) + 2 * Real.pi :=
          hξ₁_per z hz
        rw [hper]
        exact hG₁_per (X₁ z + y₁ z) (hMapsY z hz).1
      · intro z hz
        dsimp only
        have hconj : X₁ (starRingEnd ℂ z) + y₁ (starRingEnd ℂ z) = starRingEnd ℂ (X₁ z + y₁ z) :=
          hξ₁_conj z hz
        rw [hconj]
        exact hG₁_conj (X₁ z + y₁ z) (hMapsY z hz).1
      · intro z hz
        dsimp only
        have hper : X₂ (z + 2 * Real.pi) + y₂ (z + 2 * Real.pi) = (X₂ z + y₂ z) + 2 * Real.pi :=
          hξ₂_per z hz
        rw [hper]
        exact hG₂_per (X₂ z + y₂ z) (hMapsY z hz).2
      · intro z hz
        dsimp only
        have hconj : X₂ (starRingEnd ℂ z) + y₂ (starRingEnd ℂ z) = starRingEnd ℂ (X₂ z + y₂ z) :=
          hξ₂_conj z hz
        rw [hconj]
        exact hG₂_conj (X₂ z + y₂ z) (hMapsY z hz).2

    
    have hZero_a : sjcHoloLipPair p σ' 1 0 Δ_a (fun _ => (0 : ℂ)) (fun _ => (0 : ℂ)) :=
      hPair_mono (by norm_num) le_rfl (hPair_const_real p σ' 0 Δ_a hΔa_nn)
    have hSeg0 : ∀ z ∈ horizStrip σ',
        X₁ z + (0 : ℂ) ∈ horizStrip σ ∧ X₂ z + (0 : ℂ) ∈ horizStrip σ := by
      intro z hz
      exact ⟨by simpa using (hSeg₁ 0 ⟨le_rfl, zero_le_one⟩ z hz).1,
        by simpa using (hSeg₂ 0 ⟨le_rfl, zero_le_one⟩ z hz).1⟩
    have hw0_a : sjcHoloLipPair p σ' _ _ Δ_a
        (fun z => W₁ (X₁ z)) (fun z => W₂ (X₂ z)) :=
      hPair_congr (hEvalGen Δ_a le_rfl 0 _ _ hZero_a hSeg0 0 (by omega))
        (fun _ _ => by simp) (fun _ _ => by simp)
    have hw1_a : sjcHoloLipPair p σ' _ _ Δ_a
        (fun z => iteratedDeriv 1 W₁ (X₁ z)) (fun z => iteratedDeriv 1 W₂ (X₂ z)) :=
      hPair_congr (hEvalGen Δ_a le_rfl 0 _ _ hZero_a hSeg0 1 (by omega))
        (fun _ _ => by simp only [add_zero]) (fun _ _ => by simp only [add_zero])
    have hw2_a : sjcHoloLipPair p σ' _ _ Δ_a
        (fun z => iteratedDeriv 2 W₁ (X₁ z)) (fun z => iteratedDeriv 2 W₂ (X₂ z)) :=
      hPair_congr (hEvalGen Δ_a le_rfl 0 _ _ hZero_a hSeg0 2 (by omega))
        (fun _ _ => by simp only [add_zero]) (fun _ _ => by simp only [add_zero])
    have h2W_a : sjcHoloLipPair p σ' _ _ Δ_a
        (fun z => 2 * W₁ (X₁ z)) (fun z => 2 * W₂ (X₂ z)) :=
      hPair_congr (hPair_real_mul 2 hw0_a)
        (fun _ _ => by push_cast; ring) (fun _ _ => by push_cast; ring)
    have hexp2W := hPair_exp h2W_a
    have ha_raw := hPair_real_mul (1 / 384 : ℝ)
      (hPair_sub
        (hPair_sub (hPair_real_mul 7 hw2_a) (hPair_real_mul 8 (hPair_pow 2 hw1_a)))
        hexp2W)
    have ha_pair : sjcHoloLipPair p σ' _ _ Δ_a
        (fun z => aCanon_C W₁ (X₁ z)) (fun z => aCanon_C W₂ (X₂ z)) :=
      hPair_congr ha_raw
        (fun _ _ => by dsimp [aCanon_C]; push_cast; ring)
        (fun _ _ => by dsimp [aCanon_C]; push_cast; ring)

    
    have hT_diff : IsStripBounded p σ' (1 * Δ_b) (fun z => T₁ z - T₂ z) :=
      hBnd_congr
        (hCalc.bounded_mono (by linarith) ⟨hτ₁.1.sub hτ₂.1, hdτ⟩)
        (fun _ _ => by dsimp [T₁, T₂]; ring)
    have hT_pair : sjcHoloLipPair p σ' 1 1 Δ_b T₁ T₂ :=
      ⟨zero_le_one, zero_le_one, hΔb_nn, hT₁_1, hT₂_1, hT_diff⟩
    have hz₀_diff : IsStripBounded p σ' (1 * Δ_b) (fun z => z₀₁ z - z₀₂ z) :=
      hBnd_congr
        (hCalc.bounded_mono (by linarith) hdζ)
        (fun _ _ => by dsimp [z₀₁, z₀₂]; ring)
    have hz₀_pair : sjcHoloLipPair p σ' 1 1 Δ_b z₀₁ z₀₂ :=
      ⟨zero_le_one, zero_le_one, hΔb_nn, hz₀₁_1, hz₀₂_1, hz₀_diff⟩
    have hH_diff : IsStripBounded p σ' ((2 * (2 : ℝ) ^ p) * Δ_b)
        (fun z => T₁ z * z₀₁ z - T₂ z * z₀₂ z) := by
      have hm := hCalc.bounded_mul_diff hT₁_1.1 hz₀₂_1.1 hT_diff hz₀_diff
      have hEq : (2 : ℝ) ^ p * (1 * (1 * Δ_b) + (1 * Δ_b) * 1) =
          (2 * (2 : ℝ) ^ p) * Δ_b := by ring
      rwa [hEq] at hm
    have hH_pair : sjcHoloLipPair p σ' 1 (2 * (2 : ℝ) ^ p) Δ_b
        (fun z => T₁ z * z₀₁ z) (fun z => T₂ z * z₀₂ z) :=
      ⟨zero_le_one, by positivity, hΔb_nn, hH₁_1, hH₂_1, hH_diff⟩
    have hAdm : sjcAdmissibleEval m M₁ σ σ' Δ_b w₁ w₂ W₁ W₂ X₁ T₁ z₀₁ X₂ T₂ z₀₂ :=
      ⟨hσ.1, hσ', hΔb_nn, hW₁, hW₂, hT_pair, hz₀_pair, hH_pair,
        fun c hc z hz => ⟨⟨(hSeg₁ c hc z hz).1, (hSeg₂ c hc z hz).1⟩,
          ⟨(hSeg₁ c hc z hz).2, (hSeg₂ c hc z hz).2⟩⟩,
        hEvalGen Δ_b (by linarith),
        fun z hz => ⟨hmClose₁ z hz, hmClose₂ z hz⟩⟩
    exact ⟨ha_pair, hAdm⟩

  obtain ⟨M_a, L_a, hFourthAdm⟩ := h_fourth_and_adm

  
  let C_jet_raw : ℝ := max 1 (max (max M_a L_a) (max M_b L_b))
  have hC_pos : 0 < C_jet_raw := lt_max_of_lt_left zero_lt_one
  have hMa_le : M_a ≤ C_jet_raw :=
    le_trans (le_max_left M_a L_a) (le_trans (le_max_left _ _) (le_max_right 1 _))
  have hLa_le : L_a ≤ C_jet_raw :=
    le_trans (le_max_right M_a L_a) (le_trans (le_max_left _ _) (le_max_right 1 _))
  have hMb_le : M_b ≤ C_jet_raw :=
    le_trans (le_max_left M_b L_b) (le_trans (le_max_right _ _) (le_max_right 1 _))
  have hLb_le : L_b ≤ C_jet_raw :=
    le_trans (le_max_right M_b L_b) (le_trans (le_max_right _ _) (le_max_right 1 _))

  refine ⟨{
    C_jet_raw := C_jet_raw
    K_jet := K_jet
    N_jet := N_jet
    C_jet_raw_pos := hC_pos
    K_jet_pos := hKj_pos
    N_jet_ge_four := hNj_ge
    jet_comp_props := ?_
    jet_comp_lip := ?_
  }⟩
  · 
    intro σ σ' α ρ c_T q w W e_X τ_T ζ hσ hq hα hσ' hσ'_le hc_T _ hW he hτ hζ
    have hZeroBnd : ∀ (f : ℂ → ℂ), DifferentiableOn ℂ f (horizStrip σ') →
        IsStripBounded (m + 2) σ' 0 (fun w => f w - f w) := by
      intro f _
      have h0 := hCalc.bounded_const (m + 2) σ' (0 : ℂ)
      rw [norm_zero] at h0
      exact hBnd_congr h0 (fun _ _ => sub_self _)
    obtain ⟨ha_diag, hAdm_diag⟩ :=
      hFourthAdm σ σ' α ρ c_T 0 0 0 q w w W W e_X τ_T ζ e_X τ_T ζ
        hσ hq hα hσ' hσ'_le hc_T le_rfl le_rfl le_rfl hW hW he hτ he hτ hζ hζ
        (fun k hk z hz => (hZeroBnd e_X he.1).2 k hk z hz)
        (fun k hk z hz => (hZeroBnd τ_T hτ.1).2 k hk z hz)
        (hZeroBnd ζ hζ.1.1)
    have hb_diag := hbPoint σ σ' _ w w W W _ _ _ _ _ _ hAdm_diag
    refine ⟨?_, hCalc.holo_mono hMa_le ha_diag.2.2.2.1,
      hCalc.holo_mono hMb_le hb_diag.2.2.2.1⟩
    intro z hz hEqZero
    have hmClose := (hAdm_diag.2.2.2.2.2.2.2.2.2.2 z hz).1
    dsimp only at hmClose
    rw [hEqZero] at hmClose
    norm_num at hmClose
  · 
    intro σ σ' α ρ c_T Δe Δτ Δζ q w₁ w₂ W₁ W₂ e_X₁ τ_T₁ ζ₁ e_X₂ τ_T₂ ζ₂
      hσ hq hα hσ' hσ'_le hc_T hΔe hΔτ hΔζ _ _ hW₁ hW₂ he₁ hτ₁ he₂ hτ₂ hζ₁ hζ₂ hde hdτ hdζ
    obtain ⟨ha_pair, hAdm⟩ :=
      hFourthAdm σ σ' α ρ c_T Δe Δτ Δζ q w₁ w₂ W₁ W₂ e_X₁ τ_T₁ ζ₁ e_X₂ τ_T₂ ζ₂
        hσ hq hα hσ' hσ'_le hc_T hΔe hΔτ hΔζ hW₁ hW₂ he₁ hτ₁ he₂ hτ₂ hζ₁ hζ₂ hde hdτ hdζ
    have hb_pair := hbPoint σ σ' _ w₁ w₂ W₁ W₂ _ _ _ _ _ _ hAdm
    refine ⟨?_, ?_⟩
    · intro k hk z hz
      exact le_trans (ha_pair.2.2.2.2.2.2 k hk z hz)
        (mul_le_mul_of_nonneg_right hLa_le ha_pair.2.2.1)
    · intro k hk z hz
      exact le_trans (hb_pair.2.2.2.2.2.2 k hk z hz)
        (mul_le_mul_of_nonneg_right hLb_le hb_pair.2.2.1)

theorem strip_holomorphic_jet_and_midpoint (m : ℕ) (M₁ : ℝ)
    (hm : 2 ≤ m) (hM₁ : 0 < M₁) :
    Nonempty (StripHolomorphicJetData m M₁) :=
by
  have hCalc : StripCalculusToolkit := strip_calculus_and_containment
  have hPt : PointwiseTaylorAndRealActionProp := pointwise_taylor_and_real_action_identity
  obtain ⟨M_mid⟩ := strip_rescaled_midpoint_contraction m M₁ hm hM₁ hCalc hPt
  obtain ⟨J_comp⟩ :=
    strip_jet_composition_and_lipschitz m M₁ M_mid.C_zeta hm hM₁ M_mid.C_zeta_pos hCalc
  let C_mid_C : ℝ := M_mid.C_mid_C
  let C_jet_C : ℝ := J_comp.C_jet_raw * (1 + M_mid.C_zeta)
  let K_eval : ℝ := max M_mid.K_mid J_comp.K_jet
  let N_jet_C : ℕ := max M_mid.N_mid J_comp.N_jet
  have hC_jet_pos : 0 < C_jet_C := by
    have h1 : 0 < 1 + M_mid.C_zeta := by linarith [M_mid.C_zeta_pos]
    exact mul_pos J_comp.C_jet_raw_pos h1
  have hCj_le : J_comp.C_jet_raw ≤ C_jet_C := by
    have h1 : 1 ≤ 1 + M_mid.C_zeta := by linarith [M_mid.C_zeta_pos]
    calc
      J_comp.C_jet_raw = J_comp.C_jet_raw * 1 := (mul_one _).symm
      _ ≤ J_comp.C_jet_raw * (1 + M_mid.C_zeta) :=
        mul_le_mul_of_nonneg_left h1 (le_of_lt J_comp.C_jet_raw_pos)
  refine ⟨{
    C_mid_C := C_mid_C
    C_jet_C := C_jet_C
    K_eval := K_eval
    N_jet_C := N_jet_C
    C_mid_C_pos := M_mid.C_mid_C_pos
    C_jet_C_pos := hC_jet_pos
    K_eval_pos := lt_max_of_lt_left M_mid.K_mid_pos
    N_jet_C_ge_four := le_trans M_mid.N_mid_ge_four (le_max_left _ _)
    mid_C := midCanon_C
    a_C := aCanon_C
    b_C := bCanon_C
    vert_strip_maps_to := hCalc.vert_strip_maps_to
    midpoint_props := ?_
    jet_props := ?_
    midpoint_lip := ?_
    jet_lip := ?_
  }⟩
  · intro σ σ' α ρ q w W e_X τ_T hσ hq hα hσ' hσ'_le hw hW he hτ
    have hq_mid : M_mid.N_mid ≤ q := le_trans (le_max_left _ _) hq
    have hK_le : M_mid.K_mid / (q : ℝ) ^ 2 ≤ K_eval / (q : ℝ) ^ 2 :=
      div_le_div_of_nonneg_right (le_max_left _ _) (sq_nonneg _)
    have hσ'_mid : σ' ≤ (1 - 6 * α - M_mid.K_mid / (q : ℝ) ^ 2) * σ :=
      le_trans hσ'_le (mul_le_mul_of_nonneg_right (by linarith) (le_of_lt hσ.1))
    exact M_mid.midpoint_props σ σ' α ρ q w W e_X τ_T hσ hq_mid hα hσ' hσ'_mid hw hW he hτ
  · intro σ σ' α ρ sgn q w W e_X τ_T hσ hq hα hσ' hσ'_le hsgn hw hW he hτ
    have hq_mid : M_mid.N_mid ≤ q := le_trans (le_max_left _ _) hq
    have hq_jet : J_comp.N_jet ≤ q := le_trans (le_max_right _ _) hq
    have hK_mid_le : M_mid.K_mid / (q : ℝ) ^ 2 ≤ K_eval / (q : ℝ) ^ 2 :=
      div_le_div_of_nonneg_right (le_max_left _ _) (sq_nonneg _)
    have hσ'_mid : σ' ≤ (1 - 6 * α - M_mid.K_mid / (q : ℝ) ^ 2) * σ :=
      le_trans hσ'_le (mul_le_mul_of_nonneg_right (by linarith) (le_of_lt hσ.1))
    have hK_jet_le : J_comp.K_jet / (q : ℝ) ^ 2 ≤ K_eval / (q : ℝ) ^ 2 :=
      div_le_div_of_nonneg_right (le_max_right _ _) (sq_nonneg _)
    have hσ'_jet : σ' ≤ (1 - 6 * α - J_comp.K_jet / (q : ℝ) ^ 2) * σ :=
      le_trans hσ'_le (mul_le_mul_of_nonneg_right (by linarith) (le_of_lt hσ.1))
    let c_T : ℝ := sgn * (2 * Real.pi / (q : ℝ))
    have hc_T : |c_T| ≤ 2 * Real.pi / (q : ℝ) := by
      have hpos : 0 ≤ 2 * Real.pi / (q : ℝ) :=
        div_nonneg (mul_nonneg (by norm_num) (le_of_lt Real.pi_pos)) (Nat.cast_nonneg q)
      rcases hsgn with rfl | rfl
      · simp only [c_T, one_mul, abs_of_nonneg hpos]
        exact le_rfl
      · simp only [c_T, neg_one_mul, abs_neg, abs_of_nonneg hpos]
        exact le_rfl
    obtain ⟨hZeta_holo, hZeta_fix⟩ :=
      M_mid.zeta_props σ σ' α ρ c_T q w W e_X τ_T
        hσ hq_mid hα hσ' hσ'_mid hc_T hw hW he hτ
    obtain ⟨hmFac_ne, ha_raw, hb_raw⟩ :=
      J_comp.jet_comp_props σ σ' α ρ c_T q w W e_X τ_T _
        hσ hq_jet hα hσ' hσ'_jet hc_T hw hW he hτ hZeta_holo
    have ha_holo := hCalc.holo_mono hCj_le ha_raw
    have hb_holo := hCalc.holo_mono hCj_le hb_raw
    refine ⟨⟨ha_holo.1.1, ha_holo.2.1, ha_holo.2.2, ha_holo.1.2⟩,
      ⟨hb_holo.1.1, hb_holo.2.1, hb_holo.2.2, hb_holo.1.2⟩, ?_⟩
    intro x
    let X : ℂ → ℂ := fun z => z + (ρ : ℂ) + e_X z
    let T : ℂ → ℂ := fun z => (c_T : ℂ) + τ_T z
    have hx_mem : (x : ℂ) ∈ horizStrip σ' := by
      change |(x : ℂ).im| < σ'
      simpa using hσ'
    have hRealSymImZero : ∀ (g : ℂ → ℂ),
        g (starRingEnd ℂ (x : ℂ)) = starRingEnd ℂ (g (x : ℂ)) →
        ((g (x : ℂ)).re : ℂ) = g (x : ℂ) := by
      intro g hg
      have hconj : starRingEnd ℂ (g (x : ℂ)) = g (x : ℂ) := by
        simpa [Complex.conj_ofReal] using hg.symm
      have him : (g (x : ℂ)).im = 0 := Complex.conj_eq_iff_im.mp hconj
      apply Complex.ext
      · simp
      · simp [him]
    have he_re : ((e_X (x : ℂ)).re : ℂ) = e_X (x : ℂ) :=
      hRealSymImZero e_X (he.2.2.1 (x : ℂ) hx_mem)
    have hτ_re : ((τ_T (x : ℂ)).re : ℂ) = τ_T (x : ℂ) :=
      hRealSymImZero τ_T (hτ.2.2.1 (x : ℂ) hx_mem)
    have hζ_re : ((zetaLim_C W X T (x : ℂ)).re : ℂ) = zetaLim_C W X T (x : ℂ) :=
      hRealSymImZero (zetaLim_C W X T) (hZeta_holo.2.2 (x : ℂ) hx_mem)
    have hX_re : ((X (x : ℂ)).re : ℂ) = X (x : ℂ) := by
      dsimp [X]
      rw [← he_re]
      norm_cast
    have hT_re : ((T (x : ℂ)).re : ℂ) = T (x : ℂ) := by
      dsimp [T]
      rw [← hτ_re]
      norm_cast
    let z_r : ℝ := (zMid_C W X T (x : ℂ)).re
    have hz_re : (z_r : ℂ) = zMid_C W X T (x : ℂ) := by
      dsimp [z_r, zMid_C]
      rw [← hζ_re]
      apply Complex.ext <;> norm_num
    have hw_cd3 : ContDiff ℝ (3 : WithTop ℕ∞) w :=
      hw.2.1.of_le (by norm_cast; omega)
    have hW_real_deriv :
        ∀ k : ℕ, k ≤ 3 → ∀ r : ℝ,
          iteratedDeriv k W (r : ℂ) = ((iteratedDeriv k w r : ℝ) : ℂ) :=
      fun k hk r => hCalc.real_iteratedDeriv_eq (m + 15) σ M₁ w W hσ.1 hw hW k (by omega) r
    have hFix_r :
        (z_r : ℂ) - (1 / 2 : ℂ) =
          midStepOp_C W ((X (x : ℂ)).re : ℂ) ((T (x : ℂ)).re : ℂ)
            ((z_r : ℂ) - (1 / 2 : ℂ)) := by
      rw [hz_re, hX_re, hT_re]
      have hsub : zMid_C W X T (x : ℂ) - (1 / 2 : ℂ) = zetaLim_C W X T (x : ℂ) := by
        dsimp [zMid_C]
        ring
      rw [hsub]
      exact hZeta_fix (x : ℂ) hx_mem
    have hmFac_r :
        mFactor_C W ((X (x : ℂ)).re : ℂ) ((T (x : ℂ)).re : ℂ) (z_r : ℂ) ≠ 0 := by
      rw [hX_re, hT_re, hz_re]
      exact hmFac_ne (x : ℂ) hx_mem
    have hAct :=
      (hPt.real_midpoint_and_action_eq σ w W (X (x : ℂ)).re (T (x : ℂ)).re z_r
        hσ.1 hw_cd3 hW.1 hW_real_deriv hFix_r).2 hmFac_r
    rw [hX_re, hT_re, hz_re] at hAct
    exact hAct
  · intro σ σ' α ρ Δe Δτ q w₁ w₂ W₁ W₂ e_X₁ τ_T₁ e_X₂ τ_T₂
      hσ hq hα hσ' hσ'_le hΔe hΔτ hw₁ hw₂ hW₁ hW₂ he₁ hτ₁ he₂ hτ₂ hde hdτ
    have hq_mid : M_mid.N_mid ≤ q := le_trans (le_max_left _ _) hq
    have hK_le : M_mid.K_mid / (q : ℝ) ^ 2 ≤ K_eval / (q : ℝ) ^ 2 :=
      div_le_div_of_nonneg_right (le_max_left _ _) (sq_nonneg _)
    have hσ'_mid : σ' ≤ (1 - 6 * α - M_mid.K_mid / (q : ℝ) ^ 2) * σ :=
      le_trans hσ'_le (mul_le_mul_of_nonneg_right (by linarith) (le_of_lt hσ.1))
    exact M_mid.midpoint_lip σ σ' α ρ Δe Δτ q w₁ w₂ W₁ W₂ e_X₁ τ_T₁ e_X₂ τ_T₂
      hσ hq_mid hα hσ' hσ'_mid hΔe hΔτ hw₁ hw₂ hW₁ hW₂ he₁ hτ₁ he₂ hτ₂ hde hdτ
  · intro σ σ' α ρ sgn Δe Δτ q w₁ w₂ W₁ W₂ e_X₁ τ_T₁ e_X₂ τ_T₂
      hσ hq hα hσ' hσ'_le hsgn hΔe hΔτ hw₁ hw₂ hW₁ hW₂ he₁ hτ₁ he₂ hτ₂ hde hdτ
    have hq_mid : M_mid.N_mid ≤ q := le_trans (le_max_left _ _) hq
    have hq_jet : J_comp.N_jet ≤ q := le_trans (le_max_right _ _) hq
    have hK_mid_le : M_mid.K_mid / (q : ℝ) ^ 2 ≤ K_eval / (q : ℝ) ^ 2 :=
      div_le_div_of_nonneg_right (le_max_left _ _) (sq_nonneg _)
    have hσ'_mid : σ' ≤ (1 - 6 * α - M_mid.K_mid / (q : ℝ) ^ 2) * σ :=
      le_trans hσ'_le (mul_le_mul_of_nonneg_right (by linarith) (le_of_lt hσ.1))
    have hK_jet_le : J_comp.K_jet / (q : ℝ) ^ 2 ≤ K_eval / (q : ℝ) ^ 2 :=
      div_le_div_of_nonneg_right (le_max_right _ _) (sq_nonneg _)
    have hσ'_jet : σ' ≤ (1 - 6 * α - J_comp.K_jet / (q : ℝ) ^ 2) * σ :=
      le_trans hσ'_le (mul_le_mul_of_nonneg_right (by linarith) (le_of_lt hσ.1))
    let c_T : ℝ := sgn * (2 * Real.pi / (q : ℝ))
    have hc_T : |c_T| ≤ 2 * Real.pi / (q : ℝ) := by
      have hpos : 0 ≤ 2 * Real.pi / (q : ℝ) :=
        div_nonneg (mul_nonneg (by norm_num) (le_of_lt Real.pi_pos)) (Nat.cast_nonneg q)
      rcases hsgn with rfl | rfl
      · simp only [c_T, one_mul, abs_of_nonneg hpos]
        exact le_rfl
      · simp only [c_T, neg_one_mul, abs_neg, abs_of_nonneg hpos]
        exact le_rfl
    obtain ⟨hZeta₁, _⟩ :=
      M_mid.zeta_props σ σ' α ρ c_T q w₁ W₁ e_X₁ τ_T₁
        hσ hq_mid hα hσ' hσ'_mid hc_T hw₁ hW₁ he₁ hτ₁
    obtain ⟨hZeta₂, _⟩ :=
      M_mid.zeta_props σ σ' α ρ c_T q w₂ W₂ e_X₂ τ_T₂
        hσ hq_mid hα hσ' hσ'_mid hc_T hw₂ hW₂ he₂ hτ₂
    have hZeta_diff :=
      M_mid.zeta_lip σ σ' α ρ c_T Δe Δτ q w₁ w₂ W₁ W₂ e_X₁ τ_T₁ e_X₂ τ_T₂
        hσ hq_mid hα hσ' hσ'_mid hc_T hΔe hΔτ hw₁ hw₂ hW₁ hW₂ he₁ hτ₁ he₂ hτ₂ hde hdτ
    have hSup_nonneg : 0 ≤ stripDiffSup (m + 15) σ W₁ W₂ :=
      (hCalc.stripDiffSup_nonneg_and_le (m + 15) σ M₁ w₁ w₂ W₁ W₂ hσ.1 hW₁ hW₂).1
    let Δζ : ℝ := M_mid.C_zeta * (Δe + Δτ + stripDiffSup (m + 15) σ W₁ W₂)
    have hΔζ_nonneg : 0 ≤ Δζ :=
      mul_nonneg (le_of_lt M_mid.C_zeta_pos) (by linarith)
    obtain ⟨ha_lip, hb_lip⟩ :=
      J_comp.jet_comp_lip σ σ' α ρ c_T Δe Δτ Δζ q w₁ w₂ W₁ W₂
        e_X₁ τ_T₁ _ e_X₂ τ_T₂ _
        hσ hq_jet hα hσ' hσ'_jet hc_T hΔe hΔτ hΔζ_nonneg
        hw₁ hw₂ hW₁ hW₂ he₁ hτ₁ he₂ hτ₂ hZeta₁ hZeta₂ hde hdτ hZeta_diff
    refine ⟨?_, ?_⟩
    · intro k hk z hz
      exact le_trans (ha_lip k hk z hz)
        (mul_le_mul_of_nonneg_right hCj_le (by linarith))
    · intro k hk z hz
      have hEq :
          J_comp.C_jet_raw * (Δe + Δτ + Δζ + stripDiffSup (m + 15) σ W₁ W₂) =
            C_jet_C * (Δe + Δτ + stripDiffSup (m + 15) σ W₁ W₂) := by
        dsimp [C_jet_C, Δζ]
        ring
      rw [← hEq]
      exact hb_lip k hk z hz

theorem real_dirichlet_mesh_contraction (m : ℕ) (M₁ : ℝ)
    (hm : 2 ≤ m) (hM₁ : 0 < M₁)
    (J_R : RealJetAndUniquenessData m M₁) :
    Nonempty (RealMeshSystemPart m M₁) :=
by
  let _ := hm
  let _ := hM₁
  let p : ℕ := m + 2
  let C_mul : ℝ := (2 : ℝ) ^ p
  let C_pow5 : ℝ := 5 * C_mul ^ 4
  let C_inv : ℝ := 2 * C_mul ^ p
  let C_inv_lip : ℝ := C_mul ^ 2 * C_inv ^ 2
  have hC_mul_ge_one : 1 ≤ C_mul := one_le_pow₀ (by norm_num : (1 : ℝ) ≤ 2)
  have hC_mul_pos : 0 < C_mul := lt_of_lt_of_le zero_lt_one hC_mul_ge_one
  have hC_pow5_pos : 0 < C_pow5 := by positivity
  have hC_inv_pos : 0 < C_inv := by positivity
  have hC_inv_lip_pos : 0 < C_inv_lip := by positivity

  
  have hJet_nonneg : ∀ {B : ℝ} {u : ℝ → ℝ}, IsRealJetPerturb p B u → 0 ≤ B := by
    intro B u hu
    exact le_trans (abs_nonneg _) (hu.2.2 0 (Nat.zero_le p) 0)

  have hJet_eval : ∀ {B : ℝ} {u : ℝ → ℝ}, IsRealJetPerturb p B u → ∀ x : ℝ, |u x| ≤ B := by
    intro B u hu x
    have h0 := hu.2.2 0 (Nat.zero_le p) x
    rwa [iteratedDeriv_zero] at h0

  have hJet_mono : ∀ {B₁ B₂ : ℝ} {u : ℝ → ℝ},
      B₁ ≤ B₂ → IsRealJetPerturb p B₁ u → IsRealJetPerturb p B₂ u := by
    intro B₁ B₂ u hle hu
    exact ⟨hu.1, hu.2.1, fun k hk x => le_trans (hu.2.2 k hk x) hle⟩

  have hJet_congr : ∀ {B : ℝ} {u v : ℝ → ℝ},
      (∀ x : ℝ, u x = v x) → IsRealJetPerturb p B u → IsRealJetPerturb p B v := by
    intro B u v heq hu
    have hfun : u = v := funext heq
    rwa [← hfun]

  have hJet_congr' : ∀ {B : ℝ} {u v : ℝ → ℝ},
      IsRealJetPerturb p B u → (∀ x : ℝ, u x = v x) → IsRealJetPerturb p B v :=
    fun hu heq => hJet_congr heq hu

  have hJet_const : ∀ c : ℝ, IsRealJetPerturb p |c| (fun _ => c) := by
    intro c
    refine ⟨fun _ => rfl, contDiff_const, ?_⟩
    intro k _ x
    rw [iteratedDeriv_const]
    split_ifs
    · exact le_refl _
    · simp only [abs_zero, abs_nonneg]

  have hJet_zero : ∀ {B : ℝ}, 0 ≤ B → IsRealJetPerturb p B (fun _ => 0) := by
    intro B hB
    apply hJet_mono (B₁ := |(0 : ℝ)|)
    · simpa using hB
    · exact hJet_const 0

  have hJet_neg : ∀ {B : ℝ} {u : ℝ → ℝ},
      IsRealJetPerturb p B u → IsRealJetPerturb p B (fun x => -u x) := by
    intro B u hu
    refine ⟨fun x => by simp [hu.1 x], hu.2.1.neg, ?_⟩
    intro k hk x
    rw [iteratedDeriv_fun_neg, abs_neg]
    exact hu.2.2 k hk x

  have hJet_add : ∀ {B₁ B₂ : ℝ} {u v : ℝ → ℝ},
      IsRealJetPerturb p B₁ u → IsRealJetPerturb p B₂ v →
      IsRealJetPerturb p (B₁ + B₂) (fun x => u x + v x) := by
    intro B₁ B₂ u v hu hv
    refine ⟨fun x => by simp [hu.1 x, hv.1 x], hu.2.1.add hv.2.1, ?_⟩
    intro k hk x
    have hcu : ContDiffAt ℝ (k : WithTop ℕ∞) u x :=
      (hu.2.1.of_le (Nat.cast_le.mpr hk)).contDiffAt
    have hcv : ContDiffAt ℝ (k : WithTop ℕ∞) v x :=
      (hv.2.1.of_le (Nat.cast_le.mpr hk)).contDiffAt
    rw [iteratedDeriv_fun_add hcu hcv]
    exact le_trans (abs_add_le _ _) (add_le_add (hu.2.2 k hk x) (hv.2.2 k hk x))

  have hJet_sub : ∀ {B₁ B₂ : ℝ} {u v : ℝ → ℝ},
      IsRealJetPerturb p B₁ u → IsRealJetPerturb p B₂ v →
      IsRealJetPerturb p (B₁ + B₂) (fun x => u x - v x) := by
    intro B₁ B₂ u v hu hv
    exact hJet_congr (fun x => (sub_eq_add_neg (u x) (v x)).symm) (hJet_add hu (hJet_neg hv))

  have hJet_const_mul : ∀ (c : ℝ) {B : ℝ} {u : ℝ → ℝ},
      IsRealJetPerturb p B u → IsRealJetPerturb p (|c| * B) (fun x => c * u x) := by
    intro c B u hu
    refine ⟨fun x => by simp [hu.1 x], contDiff_const.mul hu.2.1, ?_⟩
    intro k hk x
    have hcu : ContDiffAt ℝ (k : WithTop ℕ∞) u x :=
      (hu.2.1.of_le (Nat.cast_le.mpr hk)).contDiffAt
    rw [iteratedDeriv_const_mul c hcu, abs_mul]
    exact mul_le_mul_of_nonneg_left (hu.2.2 k hk x) (abs_nonneg c)

  have hJet_sum : ∀ (n : ℕ) {B : ℝ} (g : ℕ → ℝ → ℝ),
      0 ≤ B → (∀ i < n, IsRealJetPerturb p B (g i)) →
      IsRealJetPerturb p ((n : ℝ) * B) (fun x => ∑ i ∈ Finset.range n, g i x) := by
    intro n
    induction n with
    | zero =>
      intro B g _ _
      simp only [Finset.range_zero, Finset.sum_empty, Nat.cast_zero, zero_mul]
      exact hJet_zero (le_refl 0)
    | succ n ih =>
      intro B g hB hg
      have hprev := ih g hB (fun i hi => hg i (Nat.lt_succ_of_lt hi))
      have hlast := hg n (Nat.lt_succ_self n)
      have hsum := hJet_add hprev hlast
      refine hJet_congr (fun x => (Finset.sum_range_succ (fun i => g i x) n).symm) ?_
      refine hJet_mono ?_ hsum
      push_cast
      linarith

  have hJet_mul : ∀ {B₁ B₂ : ℝ} {u v : ℝ → ℝ},
      IsRealJetPerturb p B₁ u → IsRealJetPerturb p B₂ v →
      IsRealJetPerturb p (C_mul * B₁ * B₂) (fun x => u x * v x) := by
    intro B₁ B₂ u v hu hv
    have hB₁ : 0 ≤ B₁ := hJet_nonneg hu
    have hB₂ : 0 ≤ B₂ := hJet_nonneg hv
    refine ⟨fun x => by simp [hu.1 x, hv.1 x], hu.2.1.mul hv.2.1, ?_⟩
    intro k hk x
    have hcu : ContDiffAt ℝ (k : WithTop ℕ∞) u x :=
      (hu.2.1.of_le (Nat.cast_le.mpr hk)).contDiffAt
    have hcv : ContDiffAt ℝ (k : WithTop ℕ∞) v x :=
      (hv.2.1.of_le (Nat.cast_le.mpr hk)).contDiffAt
    rw [iteratedDeriv_fun_mul hcu hcv]
    have h1 : |∑ i ∈ Finset.range (k + 1),
        (k.choose i : ℝ) * iteratedDeriv i u x * iteratedDeriv (k - i) v x| ≤
        ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * (B₁ * B₂) := by
      refine le_trans (Finset.abs_sum_le_sum_abs _ _) (Finset.sum_le_sum fun i hi => ?_)
      have hi_le : i ≤ p := le_trans (Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)) hk
      have hki_le : k - i ≤ p := le_trans (Nat.sub_le k i) hk
      rw [abs_mul, abs_mul, abs_of_nonneg (Nat.cast_nonneg _), mul_assoc]
      refine mul_le_mul_of_nonneg_left ?_ (Nat.cast_nonneg _)
      exact mul_le_mul (hu.2.2 i hi_le x) (hv.2.2 (k - i) hki_le x) (abs_nonneg _) hB₁
    have hsum_choose : (∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ)) = (2 : ℝ) ^ k := by
      exact_mod_cast Nat.sum_range_choose k
    rw [← Finset.sum_mul, hsum_choose] at h1
    have hpow : (2 : ℝ) ^ k ≤ C_mul := pow_le_pow_right₀ (by norm_num : (1 : ℝ) ≤ 2) hk
    exact le_trans h1 (by
      have := mul_le_mul_of_nonneg_right hpow (mul_nonneg hB₁ hB₂)
      linarith)

  have hJet_mul_sub : ∀ {B_u B_v Δu Δv : ℝ} {u₁ u₂ v₁ v₂ : ℝ → ℝ},
      IsRealJetPerturb p B_u u₂ → IsRealJetPerturb p B_v v₁ →
      IsRealJetPerturb p Δu (fun x => u₁ x - u₂ x) →
      IsRealJetPerturb p Δv (fun x => v₁ x - v₂ x) →
      IsRealJetPerturb p (C_mul * (Δu * B_v + B_u * Δv)) (fun x => u₁ x * v₁ x - u₂ x * v₂ x) := by
    intro B_u B_v Δu Δv u₁ u₂ v₁ v₂ hu₂ hv₁ hΔu hΔv
    have hcomb := hJet_add (hJet_mul hΔu hv₁) (hJet_mul hu₂ hΔv)
    exact hJet_congr' (hJet_mono (by linarith) hcomb) (fun x => by ring)

  have hJet_pow4_prod : ∀ {B : ℝ} {u₁ u₂ u₃ u₄ : ℝ → ℝ},
      IsRealJetPerturb p B u₁ → IsRealJetPerturb p B u₂ →
      IsRealJetPerturb p B u₃ → IsRealJetPerturb p B u₄ →
      IsRealJetPerturb p (C_mul ^ 3 * B ^ 4) (fun x => u₁ x * u₂ x * u₃ x * u₄ x) := by
    intro B u₁ u₂ u₃ u₄ h1 h2 h3 h4
    have h12 := hJet_mul h1 h2
    have h123 := hJet_mul h12 h3
    have h1234 := hJet_mul h123 h4
    exact hJet_mono (by linarith [show C_mul * (C_mul * (C_mul * B * B) * B) * B = C_mul ^ 3 * B ^ 4 by ring]) h1234

  have hJet_pow5 : ∀ {B : ℝ} {u : ℝ → ℝ},
      IsRealJetPerturb p B u → IsRealJetPerturb p (C_pow5 * B ^ 5) (fun x => (u x) ^ 5) := by
    intro B u hu
    have hB : 0 ≤ B := hJet_nonneg hu
    have h4 := hJet_pow4_prod hu hu hu hu
    have h5 := hJet_mul h4 hu
    have h_eq : C_mul * (C_mul ^ 3 * B ^ 4) * B = C_mul ^ 4 * B ^ 5 := by ring
    have h_nn : 0 ≤ C_mul ^ 4 * B ^ 5 := mul_nonneg (pow_nonneg (le_of_lt hC_mul_pos) 4) (pow_nonneg hB 5)
    have h_le : C_mul * (C_mul ^ 3 * B ^ 4) * B ≤ C_pow5 * B ^ 5 := by
      change C_mul * (C_mul ^ 3 * B ^ 4) * B ≤ 5 * C_mul ^ 4 * B ^ 5
      linarith
    exact hJet_congr' (hJet_mono h_le h5) (fun x => by ring)

  have hJet_pow5_sub : ∀ {B Δu : ℝ} {u₁ u₂ : ℝ → ℝ},
      IsRealJetPerturb p B u₁ → IsRealJetPerturb p B u₂ →
      IsRealJetPerturb p Δu (fun x => u₁ x - u₂ x) →
      IsRealJetPerturb p (C_pow5 * B ^ 4 * Δu) (fun x => (u₁ x) ^ 5 - (u₂ x) ^ 5) := by
    intro B Δu u₁ u₂ h1 h2 hΔ
    have t0 := hJet_pow4_prod h1 h1 h1 h1
    have t1 := hJet_pow4_prod h1 h1 h1 h2
    have t2 := hJet_pow4_prod h1 h1 h2 h2
    have t3 := hJet_pow4_prod h1 h2 h2 h2
    have t4 := hJet_pow4_prod h2 h2 h2 h2
    have hsum := hJet_add (hJet_add (hJet_add (hJet_add t0 t1) t2) t3) t4
    have hprod := hJet_mul hΔ hsum
    have h_le : C_mul * Δu *
        (C_mul ^ 3 * B ^ 4 + C_mul ^ 3 * B ^ 4 + C_mul ^ 3 * B ^ 4 +
          C_mul ^ 3 * B ^ 4 + C_mul ^ 3 * B ^ 4) ≤ C_pow5 * B ^ 4 * Δu := by
      change C_mul * Δu *
        (C_mul ^ 3 * B ^ 4 + C_mul ^ 3 * B ^ 4 + C_mul ^ 3 * B ^ 4 +
          C_mul ^ 3 * B ^ 4 + C_mul ^ 3 * B ^ 4) ≤ 5 * C_mul ^ 4 * B ^ 4 * Δu
      linarith [show C_mul * Δu *
        (C_mul ^ 3 * B ^ 4 + C_mul ^ 3 * B ^ 4 + C_mul ^ 3 * B ^ 4 +
          C_mul ^ 3 * B ^ 4 + C_mul ^ 3 * B ^ 4) = 5 * C_mul ^ 4 * B ^ 4 * Δu by ring]
    exact hJet_congr' (hJet_mono h_le hprod) (fun x => by ring)

  have hJet_inv_one_add : ∀ {g : ℝ → ℝ},
      IsRealJetPerturb p (1 / 2) g →
      (∀ x : ℝ, 1 / 2 ≤ 1 + g x) ∧ IsRealJetPerturb p C_inv (fun x => (1 + g x)⁻¹) := by
    intro g hg
    have h_lower : ∀ x : ℝ, 1 / 2 ≤ 1 + g x := by
      intro x
      have hgx := neg_le_of_abs_le (hJet_eval hg x)
      linarith
    refine ⟨h_lower, ?_⟩
    let h : ℝ → ℝ := fun x => (1 + g x)⁻¹
    have h_nz : ∀ x : ℝ, 1 + g x ≠ 0 := fun x => ne_of_gt (by linarith [h_lower x])
    have h_smooth1 : ContDiff ℝ (p : WithTop ℕ∞) (fun x => 1 + g x) := contDiff_const.add hg.2.1
    have h_smooth : ContDiff ℝ (p : WithTop ℕ∞) h := h_smooth1.inv h_nz
    have h_ind : ∀ k : ℕ, k ≤ p → ∀ x : ℝ, |iteratedDeriv k h x| ≤ 2 * C_mul ^ k := by
      intro k
      induction k using Nat.strong_induction_on with
      | h k ih =>
        intro hk x
        cases k with
        | zero =>
          rw [iteratedDeriv_zero, pow_zero, mul_one]
          have hpos : 0 < 1 + g x := by linarith [h_lower x]
          rw [abs_of_pos (inv_pos.mpr hpos)]
          have : (1 + g x)⁻¹ ≤ ((1 / 2 : ℝ))⁻¹ := inv_anti₀ (by norm_num) (h_lower x)
          linarith
        | succ m' =>
          have hprod_eq : (fun y : ℝ => (1 + g y) * h y) = (fun _ : ℝ => (1 : ℝ)) := by
            funext y
            exact mul_inv_cancel₀ (h_nz y)
          have h0 : iteratedDeriv (m' + 1) (fun y : ℝ => (1 + g y) * h y) x = 0 := by
            rw [hprod_eq, iteratedDeriv_const]
            simp
          have hc1 : ContDiffAt ℝ ((m' + 1 : ℕ) : WithTop ℕ∞) (fun y => 1 + g y) x :=
            (h_smooth1.of_le (Nat.cast_le.mpr hk)).contDiffAt
          have hch : ContDiffAt ℝ ((m' + 1 : ℕ) : WithTop ℕ∞) h x :=
            (h_smooth.of_le (Nat.cast_le.mpr hk)).contDiffAt
          rw [iteratedDeriv_fun_mul hc1 hch, Finset.sum_range_succ'] at h0
          simp only [Nat.choose_zero_right, Nat.cast_one, one_mul, iteratedDeriv_zero,
            Nat.sub_zero] at h0
          have h_eq_neg : (1 + g x) * iteratedDeriv (m' + 1) h x =
              -∑ j ∈ Finset.range (m' + 1),
                ((m' + 1).choose (j + 1) : ℝ) *
                  iteratedDeriv (j + 1) (fun y => 1 + g y) x *
                  iteratedDeriv (m' + 1 - (j + 1)) h x := by linarith
          have h_lhs_abs : (1 + g x) * |iteratedDeriv (m' + 1) h x| =
              |∑ j ∈ Finset.range (m' + 1),
                ((m' + 1).choose (j + 1) : ℝ) *
                  iteratedDeriv (j + 1) (fun y => 1 + g y) x *
                  iteratedDeriv (m' + 1 - (j + 1)) h x| := by
            have hpos : 0 ≤ 1 + g x := by linarith [h_lower x]
            rw [← abs_of_nonneg hpos, ← abs_mul, h_eq_neg, abs_neg]
          have h_sum_bnd : |∑ j ∈ Finset.range (m' + 1),
              ((m' + 1).choose (j + 1) : ℝ) *
                iteratedDeriv (j + 1) (fun y => 1 + g y) x *
                iteratedDeriv (m' + 1 - (j + 1)) h x| ≤
              ∑ j ∈ Finset.range (m' + 1), ((m' + 1).choose (j + 1) : ℝ) * C_mul ^ m' := by
            refine le_trans (Finset.abs_sum_le_sum_abs _ _) (Finset.sum_le_sum fun j hj => ?_)
            have hj_lt : j < m' + 1 := Finset.mem_range.mp hj
            have hj1_le : j + 1 ≤ p := le_trans hj_lt hk
            have hc_const : ContDiffAt ℝ ((j + 1 : ℕ) : WithTop ℕ∞) (fun _ : ℝ => (1 : ℝ)) x :=
              contDiff_const.contDiffAt
            have hc_g : ContDiffAt ℝ ((j + 1 : ℕ) : WithTop ℕ∞) g x :=
              (hg.2.1.of_le (Nat.cast_le.mpr hj1_le)).contDiffAt
            have h_der1 : iteratedDeriv (j + 1) (fun y => 1 + g y) x = iteratedDeriv (j + 1) g x := by
              rw [iteratedDeriv_fun_add hc_const hc_g, iteratedDeriv_const]
              simp
            rw [h_der1, abs_mul, abs_mul, abs_of_nonneg (Nat.cast_nonneg _), mul_assoc]
            refine mul_le_mul_of_nonneg_left ?_ (Nat.cast_nonneg _)
            have h_rem_lt : m' + 1 - (j + 1) < m' + 1 := by omega
            have h_rem_le_m : m' + 1 - (j + 1) ≤ m' := by omega
            have h_rem_le_p : m' + 1 - (j + 1) ≤ p := le_trans (le_of_lt h_rem_lt) hk
            have h_ih := ih (m' + 1 - (j + 1)) h_rem_lt h_rem_le_p x
            have h_pow_le : C_mul ^ (m' + 1 - (j + 1)) ≤ C_mul ^ m' :=
              pow_le_pow_right₀ hC_mul_ge_one h_rem_le_m
            have h_h_bnd : |iteratedDeriv (m' + 1 - (j + 1)) h x| ≤ 2 * C_mul ^ m' := by
              linarith
            have h_g_bnd : |iteratedDeriv (j + 1) g x| ≤ 1 / 2 := hg.2.2 (j + 1) hj1_le x
            have h_prod := mul_le_mul h_g_bnd h_h_bnd (abs_nonneg _) (by norm_num)
            linarith
          have h_choose_le : (∑ j ∈ Finset.range (m' + 1), ((m' + 1).choose (j + 1) : ℝ)) ≤ C_mul := by
            have h_tot : (∑ i ∈ Finset.range (m' + 2), ((m' + 1).choose i : ℝ)) = (2 : ℝ) ^ (m' + 1) := by
              exact_mod_cast Nat.sum_range_choose (m' + 1)
            rw [Finset.sum_range_succ'] at h_tot
            simp only [Nat.choose_zero_right, Nat.cast_one] at h_tot
            have h_2le : (2 : ℝ) ^ (m' + 1) ≤ C_mul :=
              pow_le_pow_right₀ (by norm_num : (1 : ℝ) ≤ 2) hk
            linarith
          rw [← Finset.sum_mul] at h_sum_bnd
          have h_rhs : (∑ j ∈ Finset.range (m' + 1), ((m' + 1).choose (j + 1) : ℝ)) * C_mul ^ m' ≤
              C_mul ^ (m' + 1) := by
            rw [pow_succ']
            exact mul_le_mul_of_nonneg_right h_choose_le (pow_nonneg (le_of_lt hC_mul_pos) m')
          have h_half_mul : (1 / 2 : ℝ) * |iteratedDeriv (m' + 1) h x| ≤
              (1 + g x) * |iteratedDeriv (m' + 1) h x| :=
            mul_le_mul_of_nonneg_right (h_lower x) (abs_nonneg _)
          linarith
    refine ⟨fun x => by dsimp [h]; rw [hg.1 x], h_smooth, ?_⟩
    intro k hk x
    exact le_trans (h_ind k hk x) (by
      have := pow_le_pow_right₀ hC_mul_ge_one hk
      linarith)

  have hJet_inv_one_add_sub : ∀ {Δg : ℝ} {g₁ g₂ : ℝ → ℝ},
      IsRealJetPerturb p (1 / 2) g₁ → IsRealJetPerturb p (1 / 2) g₂ →
      IsRealJetPerturb p Δg (fun x => g₁ x - g₂ x) →
      IsRealJetPerturb p (C_inv_lip * Δg) (fun x => (1 + g₁ x)⁻¹ - (1 + g₂ x)⁻¹) := by
    intro Δg g₁ g₂ hg₁ hg₂ hΔ
    obtain ⟨h1_low, h1_inv⟩ := hJet_inv_one_add hg₁
    obtain ⟨h2_low, h2_inv⟩ := hJet_inv_one_add hg₂
    have hprod := hJet_neg (hJet_mul hΔ (hJet_mul h1_inv h2_inv))
    refine hJet_congr ?_ (hJet_mono ?_ hprod)
    · intro x
      have hnz1 : 1 + g₁ x ≠ 0 := ne_of_gt (by linarith [h1_low x])
      have hnz2 : 1 + g₂ x ≠ 0 := ne_of_gt (by linarith [h2_low x])
      field_simp
      ring
    · change C_mul * Δg * (C_mul * C_inv * C_inv) ≤ C_mul ^ 2 * C_inv ^ 2 * Δg
      linarith [show C_mul * Δg * (C_mul * C_inv * C_inv) = C_mul ^ 2 * C_inv ^ 2 * Δg by ring]

  
  have hDir_zero : ∀ (q : ℕ) (f : ℕ → ℝ → ℝ), rdmc_dirichletInv q f 0 = 0 := by
    intro q f
    funext x
    simp [rdmc_dirichletInv]

  have hDir_q : ∀ (q : ℕ) (f : ℕ → ℝ → ℝ), 1 ≤ q → rdmc_dirichletInv q f q = 0 := by
    intro q f hq
    funext x
    have hq_nz : (q : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
    simp only [rdmc_dirichletInv, le_refl, ↓reduceIte, rdmc_dirichletSlope0,
      Finset.sum_add_distrib, Finset.sum_const, Finset.card_range, nsmul_eq_mul, Pi.zero_apply]
    field_simp [hq_nz]
    ring

  have hDir_gt : ∀ (q j : ℕ) (f : ℕ → ℝ → ℝ), q < j → rdmc_dirichletInv q f j = 0 := by
    intro q j f hj
    funext x
    have hnot : ¬ j ≤ q := by omega
    simp [rdmc_dirichletInv, hnot]

  have hDir_first_diff : ∀ (q j : ℕ) (f : ℕ → ℝ → ℝ) (x : ℝ),
      j < q →
      rdmc_dirichletInv q f (j + 1) x - rdmc_dirichletInv q f j x =
        rdmc_dirichletSlope0 q f x + rdmc_dirichletPrefix f j x := by
    intro q j f x hj
    have hj1 : j + 1 ≤ q := by omega
    have hj0 : j ≤ q := by omega
    simp only [rdmc_dirichletInv, hj1, hj0, ↓reduceIte, Finset.sum_range_succ]
    ring

  have hDir_second_diff : ∀ (q j : ℕ) (f : ℕ → ℝ → ℝ) (x : ℝ),
      j + 1 < q →
      rdmc_dirichletInv q f (j + 2) x - 2 * rdmc_dirichletInv q f (j + 1) x +
        rdmc_dirichletInv q f j x = f (j + 1) x := by
    intro q j f x hj
    have h1 := hDir_first_diff q (j + 1) f x hj
    have h0 := hDir_first_diff q j f x (by omega)
    have h_eq : rdmc_dirichletInv q f (j + 2) x - 2 * rdmc_dirichletInv q f (j + 1) x +
        rdmc_dirichletInv q f j x =
        (rdmc_dirichletInv q f (j + 2) x - rdmc_dirichletInv q f (j + 1) x) -
          (rdmc_dirichletInv q f (j + 1) x - rdmc_dirichletInv q f j x) := by ring
    rw [h_eq, h1, h0]
    simp only [rdmc_dirichletPrefix, Finset.sum_range_succ]
    ring

  have hDir_sub : ∀ (q j : ℕ) (f₁ f₂ : ℕ → ℝ → ℝ) (x : ℝ),
      rdmc_dirichletInv q f₁ j x - rdmc_dirichletInv q f₂ j x =
        rdmc_dirichletInv q (fun i y => f₁ i y - f₂ i y) j x := by
    intro q j f₁ f₂ x
    have hpref : ∀ r : ℕ,
        rdmc_dirichletPrefix f₁ r x - rdmc_dirichletPrefix f₂ r x =
          rdmc_dirichletPrefix (fun i y => f₁ i y - f₂ i y) r x := by
      intro r
      simp only [rdmc_dirichletPrefix, ← Finset.sum_sub_distrib]
    have hslope :
        rdmc_dirichletSlope0 q f₁ x - rdmc_dirichletSlope0 q f₂ x =
          rdmc_dirichletSlope0 q (fun i y => f₁ i y - f₂ i y) x := by
      simp only [rdmc_dirichletSlope0, ← mul_sub, ← Finset.sum_sub_distrib, hpref]
    by_cases hj : j ≤ q
    · simp only [rdmc_dirichletInv, hj, ↓reduceIte, ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl fun r _ => ?_
      rw [← hslope, ← hpref r]
      ring
    · simp [rdmc_dirichletInv, hj]

  have hDir_bound : ∀ (q : ℕ) (M_f : ℝ) (f : ℕ → ℝ → ℝ),
      1 ≤ q → 0 ≤ M_f →
      (∀ j : ℕ, j + 1 < q → IsRealJetPerturb p M_f (f (j + 1))) →
      rdmc_IsBoundedDispTuple p q (2 * (q : ℝ) ^ 4 * M_f) (rdmc_dirichletInv q f) := by
    intro q M_f f hq hMf hf
    have hq_pos : 0 < (q : ℝ) := Nat.cast_pos.mpr (by omega)
    have hq_nz : (q : ℝ) ≠ 0 := ne_of_gt hq_pos
    have hpref_bnd : ∀ r < q, IsRealJetPerturb p ((q : ℝ) * M_f) (rdmc_dirichletPrefix f r) := by
      intro r hr
      have h1 := hJet_sum r (fun i => f (i + 1)) hMf (fun i hi => hf i (by omega))
      refine hJet_mono ?_ h1
      exact mul_le_mul_of_nonneg_right (Nat.cast_le.mpr (le_of_lt hr)) hMf
    have hslope_bnd : IsRealJetPerturb p ((q : ℝ) * M_f) (rdmc_dirichletSlope0 q f) := by
      have hsum := hJet_sum q (rdmc_dirichletPrefix f) (mul_nonneg (le_of_lt hq_pos) hMf) hpref_bnd
      have hmul := hJet_const_mul (-(q : ℝ)⁻¹) hsum
      refine hJet_mono ?_ hmul
      rw [abs_neg, abs_of_pos (inv_pos.mpr hq_pos)]
      field_simp [hq_nz]
      exact le_refl _
    have hstep_bnd : ∀ r < q,
        IsRealJetPerturb p (2 * (q : ℝ) * M_f)
          (fun x => rdmc_dirichletSlope0 q f x + rdmc_dirichletPrefix f r x) := by
      intro r hr
      exact hJet_mono (by linarith) (hJet_add hslope_bnd (hpref_bnd r hr))
    refine ⟨hDir_zero q f, hDir_q q f hq, fun j hj => hDir_gt q j f hj, ?_, ?_⟩
    · intro j hj
      have hsum := hJet_sum j (fun r x => rdmc_dirichletSlope0 q f x + rdmc_dirichletPrefix f r x)
        (by positivity) (fun r hr => hstep_bnd r (lt_of_lt_of_le hr hj))
      have heq : (fun x => ∑ r ∈ Finset.range j,
          (rdmc_dirichletSlope0 q f x + rdmc_dirichletPrefix f r x)) = rdmc_dirichletInv q f j := by
        funext x
        simp [rdmc_dirichletInv, hj]
      refine hJet_congr (fun x => congrFun heq x) (hJet_mono ?_ hsum)
      have hj_le : (j : ℝ) ≤ (q : ℝ) := Nat.cast_le.mpr hj
      have h1 : (j : ℝ) * (2 * (q : ℝ) * M_f) ≤ (q : ℝ) * (2 * (q : ℝ) * M_f) :=
        mul_le_mul_of_nonneg_right hj_le (by positivity)
      have h2 : (q : ℝ) * (2 * (q : ℝ) * M_f) = (2 * (q : ℝ) ^ 4 * M_f) / (q : ℝ) ^ 2 := by
        field_simp [hq_nz]
      linarith
    · intro j hj
      have h1 := hstep_bnd j hj
      refine hJet_congr (fun x => (hDir_first_diff q j f x hj).symm) (hJet_mono ?_ h1)
      have h2 : 2 * (q : ℝ) * M_f = (2 * (q : ℝ) ^ 4 * M_f) / (q : ℝ) ^ 3 := by
        field_simp [hq_nz]
      linarith

  
  have hTuple_mono : ∀ {q : ℕ} {B₁ B₂ : ℝ} {d : ℕ → ℝ → ℝ},
      B₁ ≤ B₂ → rdmc_IsBoundedDispTuple p q B₁ d → rdmc_IsBoundedDispTuple p q B₂ d := by
    intro q B₁ B₂ d hle hd
    refine ⟨hd.1, hd.2.1, hd.2.2.1, ?_, ?_⟩
    · intro j hj
      exact hJet_mono (div_le_div_of_nonneg_right hle (by positivity)) (hd.2.2.2.1 j hj)
    · intro j hj
      exact hJet_mono (div_le_div_of_nonneg_right hle (by positivity)) (hd.2.2.2.2 j hj)

  have hTuple_zero : ∀ (q : ℕ) {B : ℝ},
      0 ≤ B → rdmc_IsBoundedDispTuple p q B (fun _ _ => 0) := by
    intro q B hB
    refine ⟨rfl, rfl, fun _ _ => rfl, ?_, ?_⟩
    · intro _ _
      exact hJet_zero (div_nonneg hB (by positivity))
    · intro _ _
      simpa only [sub_zero] using hJet_zero (div_nonneg hB (by positivity))

  have hTuple_add : ∀ {q : ℕ} {B₁ B₂ : ℝ} {d₁ d₂ : ℕ → ℝ → ℝ},
      rdmc_IsBoundedDispTuple p q B₁ d₁ → rdmc_IsBoundedDispTuple p q B₂ d₂ →
      rdmc_IsBoundedDispTuple p q (B₁ + B₂) (fun j x => d₁ j x + d₂ j x) := by
    intro q B₁ B₂ d₁ d₂ hd₁ hd₂
    refine ⟨by funext x; simp [hd₁.1, hd₂.1],
      by funext x; simp [hd₁.2.1, hd₂.2.1],
      fun j hj => by funext x; simp [hd₁.2.2.1 j hj, hd₂.2.2.1 j hj], ?_, ?_⟩
    · intro j hj
      refine hJet_mono (by rw [add_div]) (hJet_add (hd₁.2.2.2.1 j hj) (hd₂.2.2.2.1 j hj))
    · intro j hj
      exact hJet_congr'
        (hJet_mono (by rw [add_div]) (hJet_add (hd₁.2.2.2.2 j hj) (hd₂.2.2.2.2 j hj)))
        (fun x => by ring)

  have hTuple_sub : ∀ {q : ℕ} {B₁ B₂ : ℝ} {d₁ d₂ : ℕ → ℝ → ℝ},
      rdmc_IsBoundedDispTuple p q B₁ d₁ → rdmc_IsBoundedDispTuple p q B₂ d₂ →
      rdmc_IsBoundedDispTuple p q (B₁ + B₂) (fun j x => d₁ j x - d₂ j x) := by
    intro q B₁ B₂ d₁ d₂ hd₁ hd₂
    refine ⟨by funext x; simp [hd₁.1, hd₂.1],
      by funext x; simp [hd₁.2.1, hd₂.2.1],
      fun j hj => by funext x; simp [hd₁.2.2.1 j hj, hd₂.2.2.1 j hj], ?_, ?_⟩
    · intro j hj
      refine hJet_mono (by rw [add_div]) (hJet_sub (hd₁.2.2.2.1 j hj) (hd₂.2.2.2.1 j hj))
    · intro j hj
      exact hJet_congr'
        (hJet_mono (by rw [add_div]) (hJet_sub (hd₁.2.2.2.2 j hj) (hd₂.2.2.2.2 j hj)))
        (fun x => by ring)

  have hUnifDerivLim : ∀ (m' : ℕ) (u : ℕ → ℝ → ℝ) (g : ℕ → ℝ → ℝ),
      (∀ n : ℕ, ContDiff ℝ (m' : WithTop ℕ∞) (u n)) →
      (∀ k : ℕ, k ≤ m' → TendstoUniformly (fun n => iteratedDeriv k (u n)) (g k) Filter.atTop) →
      ContDiff ℝ (m' : WithTop ℕ∞) (g 0) ∧ ∀ k : ℕ, k ≤ m' → iteratedDeriv k (g 0) = g k := by
    intro m'
    induction m' with
    | zero =>
      intro u g hu hconv
      have h0 : TendstoUniformly u (g 0) Filter.atTop := by
        simpa [iteratedDeriv_zero] using hconv 0 (le_refl 0)
      have hcont : Continuous (g 0) :=
        h0.continuous (Filter.Eventually.of_forall fun n => (hu n).continuous).frequently
      refine ⟨contDiff_zero.mpr hcont, ?_⟩
      intro k hk
      have hk0 : k = 0 := Nat.eq_zero_of_le_zero hk
      subst hk0
      exact iteratedDeriv_zero
    | succ m' ih =>
      intro u g hu hconv
      have hu_diff : ∀ n : ℕ, Differentiable ℝ (u n) := fun n =>
        (contDiff_succ_iff_deriv.mp (by simpa [Nat.cast_succ] using hu n)).1
      have hu'_smooth : ∀ n : ℕ, ContDiff ℝ (m' : WithTop ℕ∞) (deriv (u n)) := fun n =>
        (contDiff_succ_iff_deriv.mp (by simpa [Nat.cast_succ] using hu n)).2.2
      have hconv' : ∀ k : ℕ, k ≤ m' →
          TendstoUniformly (fun n => iteratedDeriv k (deriv (u n))) (g (k + 1)) Filter.atTop := by
        intro k hk
        have h1 := hconv (k + 1) (Nat.succ_le_succ hk)
        simpa only [iteratedDeriv_succ'] using h1
      obtain ⟨hg1_smooth, hg1_iter⟩ := ih (fun n => deriv (u n)) (fun k => g (k + 1)) hu'_smooth hconv'
      have hconv0 : TendstoUniformly u (g 0) Filter.atTop := by
        simpa [iteratedDeriv_zero] using hconv 0 (Nat.zero_le _)
      have hconv1 : TendstoUniformly (fun n => deriv (u n)) (g 1) Filter.atTop := by
        simpa [iteratedDeriv_zero] using hconv' 0 (Nat.zero_le _)
      have hderiv : ∀ x : ℝ, HasDerivAt (g 0) (g 1 x) x :=
        hasDerivAt_of_tendstoUniformly hconv1
          (Filter.Eventually.of_forall fun n x => (hu_diff n x).hasDerivAt)
          (fun x => hconv0.tendsto_at x)
      have hg0_diff : Differentiable ℝ (g 0) := fun x => (hderiv x).differentiableAt
      have hg0_deriv : deriv (g 0) = g 1 := funext fun x => (hderiv x).deriv
      have hg0_smooth : ContDiff ℝ ((m' + 1 : ℕ) : WithTop ℕ∞) (g 0) := by
        rw [Nat.cast_succ, contDiff_succ_iff_deriv]
        refine ⟨hg0_diff, by simp, ?_⟩
        rwa [hg0_deriv]
      refine ⟨hg0_smooth, ?_⟩
      intro k hk
      cases k with
      | zero => exact iteratedDeriv_zero
      | succ r =>
        rw [iteratedDeriv_succ', hg0_deriv]
        exact hg1_iter r (Nat.le_of_succ_le_succ hk)

  have hGeomTail : ∀ (C : ℝ) (a : ℕ → ℝ),
      0 ≤ C →
      (∀ n : ℕ, |a (n + 1) - a n| ≤ C * (1 / 2 : ℝ) ^ n) →
      ∃ L : ℝ, Filter.Tendsto a Filter.atTop (nhds L) ∧
        ∀ n : ℕ, |L - a n| ≤ 2 * C * (1 / 2 : ℝ) ^ n := by
    intro C a _ hstep
    have hdist : ∀ n : ℕ, dist (a n) (a (n + 1)) ≤ C * (1 / 2 : ℝ) ^ n := by
      intro n
      rw [Real.dist_eq, abs_sub_comm]
      exact hstep n
    have hcauchy : CauchySeq a := cauchySeq_of_le_geometric (1 / 2) C (by norm_num) hdist
    obtain ⟨L, hL⟩ := cauchySeq_tendsto_of_complete hcauchy
    refine ⟨L, hL, ?_⟩
    intro n
    have hpart : ∀ d : ℕ,
        |a (n + d) - a n| ≤ 2 * C * (1 / 2 : ℝ) ^ n - 2 * C * (1 / 2 : ℝ) ^ (n + d) := by
      intro d
      induction d with
      | zero => simp
      | succ d ih =>
        have htri : |a (n + (d + 1)) - a n| ≤
            |a (n + d) - a n| + |a (n + d + 1) - a (n + d)| := by
          have : a (n + (d + 1)) - a n = (a (n + d) - a n) + (a (n + d + 1) - a (n + d)) := by
            rw [← Nat.add_assoc]
            ring
          rw [this]
          exact abs_add_le _ _
        have hs := hstep (n + d)
        have hpowC : 2 * C * (1 / 2 : ℝ) ^ (n + (d + 1)) = C * (1 / 2 : ℝ) ^ (n + d) := by
          rw [← Nat.add_assoc, pow_succ]
          ring
        linarith
    have hpart_le : ∀ d : ℕ, |a (n + d) - a n| ≤ 2 * C * (1 / 2 : ℝ) ^ n := by
      intro d
      have hnn : 0 ≤ 2 * C * (1 / 2 : ℝ) ^ (n + d) := by
        have hC0 : 0 ≤ C := by
          have := hstep 0
          simp only [pow_zero, mul_one] at this
          exact le_trans (abs_nonneg _) this
        positivity
      linarith [hpart d]
    have htend : Filter.Tendsto (fun d : ℕ => |a (n + d) - a n|)
        Filter.atTop (nhds |L - a n|) := by
      have hshift : Filter.Tendsto (fun d : ℕ => a (n + d)) Filter.atTop (nhds L) := by
        have h1 : Filter.Tendsto (fun d : ℕ => a (d + n)) Filter.atTop (nhds L) :=
          hL.comp (Filter.tendsto_add_atTop_nat n)
        exact h1.congr fun d => by rw [Nat.add_comm]
      exact (hshift.sub tendsto_const_nhds).abs
    exact le_of_tendsto htend (Filter.Eventually.of_forall hpart_le)

  have hHalf_tendsto : Filter.Tendsto (fun n : ℕ => (1 / 2 : ℝ) ^ n) Filter.atTop (nhds 0) :=
    tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num) (by norm_num)

  have hPicard : ∀ (q : ℕ) (R : ℝ) (G : (ℕ → ℝ → ℝ) → (ℕ → ℝ → ℝ)),
      1 ≤ q → 0 ≤ R →
      (∀ d, rdmc_IsBoundedDispTuple p q R d → rdmc_IsBoundedDispTuple p q R (G d)) →
      (∀ d₁ d₂ Δ, 0 ≤ Δ →
        rdmc_IsBoundedDispTuple p q R d₁ →
        rdmc_IsBoundedDispTuple p q R d₂ →
        rdmc_IsBoundedDispTuple p q Δ (fun j x => d₁ j x - d₂ j x) →
        rdmc_IsBoundedDispTuple p q (Δ / 2) (fun j x => G d₁ j x - G d₂ j x)) →
      ∃ d_star : ℕ → ℝ → ℝ, rdmc_IsBoundedDispTuple p q R d_star ∧ G d_star = d_star := by
    intro q R G hq hR hG_self hG_lip
    let dSeq : ℕ → ℕ → ℝ → ℝ := fun n => Nat.recOn n (fun _ _ => 0) (fun _ prev => G prev)
    have hdSeq_mem : ∀ n : ℕ, rdmc_IsBoundedDispTuple p q R (dSeq n) := by
      intro n
      induction n with
      | zero => exact hTuple_zero q hR
      | succ n ih => exact hG_self (dSeq n) ih
    have hdSeq_diff : ∀ n : ℕ,
        rdmc_IsBoundedDispTuple p q (R * (1 / 2 : ℝ) ^ n)
          (fun j x => dSeq (n + 1) j x - dSeq n j x) := by
      intro n
      induction n with
      | zero =>
        simp only [pow_zero, mul_one]
        have h1 := hdSeq_mem 1
        refine ⟨by funext x; simp [h1.1, (hdSeq_mem 0).1],
          by funext x; simp [h1.2.1, (hdSeq_mem 0).2.1],
          fun j hj => by funext x; simp [h1.2.2.1 j hj, (hdSeq_mem 0).2.2.1 j hj],
          fun j hj => hJet_congr (fun x => (sub_zero _).symm) (h1.2.2.2.1 j hj),
          fun j hj => hJet_congr (fun x => by dsimp [dSeq]; ring) (h1.2.2.2.2 j hj)⟩
      | succ n ih =>
        have h1 := hG_lip (dSeq (n + 1)) (dSeq n) (R * (1 / 2 : ℝ) ^ n) (by positivity)
          (hdSeq_mem (n + 1)) (hdSeq_mem n) ih
        exact hTuple_mono (by rw [pow_succ]; linarith) h1
    have h_cauchy_jk : ∀ j ≤ q, ∀ k ≤ p, ∀ x : ℝ,
        ∃ L : ℝ,
          Filter.Tendsto (fun n => iteratedDeriv k (dSeq n j) x) Filter.atTop (nhds L) ∧
          ∀ n : ℕ, |L - iteratedDeriv k (dSeq n j) x| ≤
            2 * (R / (q : ℝ) ^ 2) * (1 / 2 : ℝ) ^ n := by
      intro j hj k hk x
      refine hGeomTail (R / (q : ℝ) ^ 2) (fun n => iteratedDeriv k (dSeq n j) x) (by positivity) ?_
      intro n
      have hc1 : ContDiffAt ℝ (k : WithTop ℕ∞) (dSeq (n + 1) j) x :=
        (((hdSeq_mem (n + 1)).2.2.2.1 j hj).2.1.of_le (Nat.cast_le.mpr hk)).contDiffAt
      have hc0 : ContDiffAt ℝ (k : WithTop ℕ∞) (dSeq n j) x :=
        (((hdSeq_mem n).2.2.2.1 j hj).2.1.of_le (Nat.cast_le.mpr hk)).contDiffAt
      have hsub := ((hdSeq_diff n).2.2.2.1 j hj).2.2 k hk x
      rw [iteratedDeriv_fun_sub hc1 hc0] at hsub
      exact le_trans hsub (by ring_nf; exact le_refl _)
    let g : ℕ → ℕ → ℝ → ℝ := fun j k x =>
      if h : j ≤ q ∧ k ≤ p then Classical.choose (h_cauchy_jk j h.1 k h.2 x) else 0
    have hg_spec : ∀ j (hj : j ≤ q) k (hk : k ≤ p) (x : ℝ),
        Filter.Tendsto (fun n => iteratedDeriv k (dSeq n j) x) Filter.atTop (nhds (g j k x)) ∧
        ∀ n : ℕ, |g j k x - iteratedDeriv k (dSeq n j) x| ≤
          2 * (R / (q : ℝ) ^ 2) * (1 / 2 : ℝ) ^ n := by
      intro j hj k hk x
      simpa only [g, hj, hk, and_self, ↓reduceDIte] using
        Classical.choose_spec (h_cauchy_jk j hj k hk x)
    have hg_unif : ∀ j ≤ q, ∀ k ≤ p,
        TendstoUniformly (fun n => iteratedDeriv k (dSeq n j)) (g j k) Filter.atTop := by
      intro j hj k hk
      rw [Metric.tendstoUniformly_iff]
      intro ε hε
      have hlim0 : Filter.Tendsto (fun n : ℕ => 2 * (R / (q : ℝ) ^ 2) * (1 / 2 : ℝ) ^ n)
          Filter.atTop (nhds 0) := by
        simpa using hHalf_tendsto.const_mul (2 * (R / (q : ℝ) ^ 2))
      filter_upwards [(tendsto_order.mp hlim0).2 ε hε] with n hn x
      rw [Real.dist_eq]
      exact lt_of_le_of_lt ((hg_spec j hj k hk x).2 n) hn
    let d_star : ℕ → ℝ → ℝ := fun j => if j ≤ q then g j 0 else 0
    have hd_star_smooth : ∀ j ≤ q,
        ContDiff ℝ (p : WithTop ℕ∞) (d_star j) ∧
        ∀ k ≤ p, iteratedDeriv k (d_star j) = g j k := by
      intro j hj
      simpa only [d_star, hj, ↓reduceIte] using hUnifDerivLim p (fun n => dSeq n j) (g j)
        (fun n => ((hdSeq_mem n).2.2.2.1 j hj).2.1) (fun k hk => hg_unif j hj k hk)
    have hd_star_0 : d_star 0 = 0 := by
      funext x
      have h0 : 0 ≤ q := Nat.zero_le q
      have ht1 : Filter.Tendsto (fun n => dSeq n 0 x) Filter.atTop (nhds (d_star 0 x)) := by
        simpa only [d_star, h0, ↓reduceIte, iteratedDeriv_zero] using
          (hg_spec 0 h0 0 (Nat.zero_le p) x).1
      have ht2 : Filter.Tendsto (fun n => dSeq n 0 x) Filter.atTop (nhds 0) := by
        simp [(hdSeq_mem _).1]
      exact tendsto_nhds_unique ht1 ht2
    have hd_star_q : d_star q = 0 := by
      funext x
      have ht1 : Filter.Tendsto (fun n => dSeq n q x) Filter.atTop (nhds (d_star q x)) := by
        simpa only [d_star, le_refl q, ↓reduceIte, iteratedDeriv_zero] using
          (hg_spec q (le_refl q) 0 (Nat.zero_le p) x).1
      have ht2 : Filter.Tendsto (fun n => dSeq n q x) Filter.atTop (nhds 0) := by
        simp [(hdSeq_mem _).2.1]
      exact tendsto_nhds_unique ht1 ht2
    have hd_star_gt : ∀ j : ℕ, q < j → d_star j = 0 := by
      intro j hj
      have hnot : ¬ j ≤ q := by omega
      simp [d_star, hnot]
    have hd_star_per : ∀ j ≤ q, Function.Periodic (d_star j) (2 * Real.pi) := by
      intro j hj x
      have ht1 : Filter.Tendsto (fun n => dSeq n j (x + 2 * Real.pi)) Filter.atTop
          (nhds (d_star j (x + 2 * Real.pi))) := by
        simpa only [d_star, hj, ↓reduceIte, iteratedDeriv_zero] using
          (hg_spec j hj 0 (Nat.zero_le p) (x + 2 * Real.pi)).1
      have ht2 : Filter.Tendsto (fun n => dSeq n j x) Filter.atTop (nhds (d_star j x)) := by
        simpa only [d_star, hj, ↓reduceIte, iteratedDeriv_zero] using
          (hg_spec j hj 0 (Nat.zero_le p) x).1
      have heq : (fun n => dSeq n j (x + 2 * Real.pi)) = (fun n => dSeq n j x) :=
        funext fun n => ((hdSeq_mem n).2.2.2.1 j hj).1 x
      rw [heq] at ht1
      exact tendsto_nhds_unique ht1 ht2
    have hd_star_mem : rdmc_IsBoundedDispTuple p q R d_star := by
      refine ⟨hd_star_0, hd_star_q, hd_star_gt, ?_, ?_⟩
      · intro j hj
        refine ⟨hd_star_per j hj, (hd_star_smooth j hj).1, ?_⟩
        intro k hk x
        rw [(hd_star_smooth j hj).2 k hk]
        exact le_of_tendsto (hg_spec j hj k hk x).1.abs
          (Filter.Eventually.of_forall fun n => ((hdSeq_mem n).2.2.2.1 j hj).2.2 k hk x)
      · intro j hj
        have hj0 : j ≤ q := by omega
        have hj1 : j + 1 ≤ q := by omega
        refine ⟨fun x => by simp [hd_star_per (j + 1) hj1 x, hd_star_per j hj0 x],
          ((hd_star_smooth (j + 1) hj1).1).sub ((hd_star_smooth j hj0).1), ?_⟩
        intro k hk x
        have hc1 : ContDiffAt ℝ (k : WithTop ℕ∞) (d_star (j + 1)) x :=
          (((hd_star_smooth (j + 1) hj1).1).of_le (Nat.cast_le.mpr hk)).contDiffAt
        have hc0 : ContDiffAt ℝ (k : WithTop ℕ∞) (d_star j) x :=
          (((hd_star_smooth j hj0).1).of_le (Nat.cast_le.mpr hk)).contDiffAt
        rw [iteratedDeriv_fun_sub hc1 hc0, (hd_star_smooth (j + 1) hj1).2 k hk,
          (hd_star_smooth j hj0).2 k hk]
        have htend_diff : Filter.Tendsto
            (fun n => |iteratedDeriv k (fun y => dSeq n (j + 1) y - dSeq n j y) x|)
            Filter.atTop (nhds |g (j + 1) k x - g j k x|) := by
          have heq_n : (fun n => |iteratedDeriv k (fun y => dSeq n (j + 1) y - dSeq n j y) x|) =
              (fun n => |iteratedDeriv k (dSeq n (j + 1)) x - iteratedDeriv k (dSeq n j) x|) := by
            funext n
            congr 1
            exact iteratedDeriv_fun_sub
              ((((hdSeq_mem n).2.2.2.1 (j + 1) hj1).2.1.of_le (Nat.cast_le.mpr hk)).contDiffAt)
              ((((hdSeq_mem n).2.2.2.1 j hj0).2.1.of_le (Nat.cast_le.mpr hk)).contDiffAt)
          rw [heq_n]
          exact (((hg_spec (j + 1) hj1 k hk x).1).sub ((hg_spec j hj0 k hk x).1)).abs
        exact le_of_tendsto htend_diff
          (Filter.Eventually.of_forall fun n => ((hdSeq_mem n).2.2.2.2 j hj).2.2 k hk x)
    have hd_star_tail : ∀ n : ℕ,
        rdmc_IsBoundedDispTuple p q (2 * R * (1 / 2 : ℝ) ^ n)
          (fun j x => d_star j x - dSeq n j x) := by
      intro n
      refine ⟨by funext x; simp [hd_star_0, (hdSeq_mem n).1],
        by funext x; simp [hd_star_q, (hdSeq_mem n).2.1],
        fun j hj => by funext x; simp [hd_star_gt j hj, (hdSeq_mem n).2.2.1 j hj], ?_, ?_⟩
      · intro j hj
        refine ⟨(hJet_sub (hd_star_mem.2.2.2.1 j hj) ((hdSeq_mem n).2.2.2.1 j hj)).1,
          (hJet_sub (hd_star_mem.2.2.2.1 j hj) ((hdSeq_mem n).2.2.2.1 j hj)).2.1, ?_⟩
        intro k hk x
        have hc_s : ContDiffAt ℝ (k : WithTop ℕ∞) (d_star j) x :=
          ((hd_star_mem.2.2.2.1 j hj).2.1.of_le (Nat.cast_le.mpr hk)).contDiffAt
        have hc_n : ContDiffAt ℝ (k : WithTop ℕ∞) (dSeq n j) x :=
          (((hdSeq_mem n).2.2.2.1 j hj).2.1.of_le (Nat.cast_le.mpr hk)).contDiffAt
        rw [iteratedDeriv_fun_sub hc_s hc_n, (hd_star_smooth j hj).2 k hk]
        exact le_trans ((hg_spec j hj k hk x).2 n) (by ring_nf; exact le_refl _)
      · intro j hj
        have hj0 : j ≤ q := by omega
        have hj1 : j + 1 ≤ q := by omega
        have hsub_step := hJet_sub (hd_star_mem.2.2.2.2 j hj) ((hdSeq_mem n).2.2.2.2 j hj)
        refine hJet_congr (fun x => by ring) ⟨hsub_step.1, hsub_step.2.1, ?_⟩
        intro k hk x
        let a_step : ℕ → ℝ := fun m' =>
          iteratedDeriv k (fun y => dSeq m' (j + 1) y - dSeq m' j y) x
        have ha_step_bnd : ∀ m' : ℕ, |a_step (m' + 1) - a_step m'| ≤
            (R / (q : ℝ) ^ 3) * (1 / 2 : ℝ) ^ m' := by
          intro m'
          have hc_m1 : ContDiffAt ℝ (k : WithTop ℕ∞)
              (fun y => dSeq (m' + 1) (j + 1) y - dSeq (m' + 1) j y) x :=
            ((((hdSeq_mem (m' + 1)).2.2.2.2 j hj).2.1).of_le (Nat.cast_le.mpr hk)).contDiffAt
          have hc_m0 : ContDiffAt ℝ (k : WithTop ℕ∞)
              (fun y => dSeq m' (j + 1) y - dSeq m' j y) x :=
            ((((hdSeq_mem m').2.2.2.2 j hj).2.1).of_le (Nat.cast_le.mpr hk)).contDiffAt
          have h_eq_fn : (fun y => (dSeq (m' + 1) (j + 1) y - dSeq (m' + 1) j y) -
              (dSeq m' (j + 1) y - dSeq m' j y)) =
              (fun y => (dSeq (m' + 1) (j + 1) y - dSeq m' (j + 1) y) -
              (dSeq (m' + 1) j y - dSeq m' j y)) := by
            funext y; ring
          have h1 := ((hdSeq_diff m').2.2.2.2 j hj).2.2 k hk x
          rw [← h_eq_fn, iteratedDeriv_fun_sub hc_m1 hc_m0] at h1
          exact le_trans h1 (by ring_nf; exact le_refl _)
        obtain ⟨L_s, hLs_lim, hLs_tail⟩ := hGeomTail (R / (q : ℝ) ^ 3) a_step (by positivity) ha_step_bnd
        have ha_lim2 : Filter.Tendsto a_step Filter.atTop
            (nhds (iteratedDeriv k (fun y => d_star (j + 1) y - d_star j y) x)) := by
          have hc_s1 : ContDiffAt ℝ (k : WithTop ℕ∞) (d_star (j + 1)) x :=
            ((hd_star_mem.2.2.2.1 (j + 1) hj1).2.1.of_le (Nat.cast_le.mpr hk)).contDiffAt
          have hc_s0 : ContDiffAt ℝ (k : WithTop ℕ∞) (d_star j) x :=
            ((hd_star_mem.2.2.2.1 j hj0).2.1.of_le (Nat.cast_le.mpr hk)).contDiffAt
          rw [iteratedDeriv_fun_sub hc_s1 hc_s0, (hd_star_smooth (j + 1) hj1).2 k hk,
            (hd_star_smooth j hj0).2 k hk]
          have heq_a : a_step = fun m' =>
              iteratedDeriv k (dSeq m' (j + 1)) x - iteratedDeriv k (dSeq m' j) x := by
            funext m'
            exact iteratedDeriv_fun_sub
              ((((hdSeq_mem m').2.2.2.1 (j + 1) hj1).2.1.of_le (Nat.cast_le.mpr hk)).contDiffAt)
              ((((hdSeq_mem m').2.2.2.1 j hj0).2.1.of_le (Nat.cast_le.mpr hk)).contDiffAt)
          rw [heq_a]
          exact ((hg_spec (j + 1) hj1 k hk x).1).sub ((hg_spec j hj0 k hk x).1)
        have hLs_eq : L_s = iteratedDeriv k (fun y => d_star (j + 1) y - d_star j y) x :=
          tendsto_nhds_unique hLs_lim ha_lim2
        have hc_ds : ContDiffAt ℝ (k : WithTop ℕ∞) (fun y => d_star (j + 1) y - d_star j y) x :=
          (((hd_star_mem.2.2.2.2 j hj).2.1).of_le (Nat.cast_le.mpr hk)).contDiffAt
        have hc_dn : ContDiffAt ℝ (k : WithTop ℕ∞) (fun y => dSeq n (j + 1) y - dSeq n j y) x :=
          ((((hdSeq_mem n).2.2.2.2 j hj).2.1).of_le (Nat.cast_le.mpr hk)).contDiffAt
        rw [iteratedDeriv_fun_sub hc_ds hc_dn, ← hLs_eq]
        exact le_trans (hLs_tail n) (by ring_nf; exact le_refl _)
    refine ⟨d_star, hd_star_mem, ?_⟩
    funext j x
    by_cases hj : j ≤ q
    · have h_zero_le : |G d_star j x - d_star j x| ≤ 0 := by
        have h_bnd_n : ∀ n : ℕ,
            |G d_star j x - d_star j x| ≤ (2 * R / (q : ℝ) ^ 2) * (1 / 2 : ℝ) ^ n := by
          intro n
          have h1 := hG_lip d_star (dSeq n) (2 * R * (1 / 2 : ℝ) ^ n) (by positivity)
            hd_star_mem (hdSeq_mem n) (hd_star_tail n)
          have hb1 : |G d_star j x - dSeq (n + 1) j x| ≤
              ((2 * R * (1 / 2 : ℝ) ^ n) / 2) / (q : ℝ) ^ 2 :=
            hJet_eval (h1.2.2.2.1 j hj) x
          have hb2 : |d_star j x - dSeq (n + 1) j x| ≤
              (2 * R * (1 / 2 : ℝ) ^ (n + 1)) / (q : ℝ) ^ 2 :=
            hJet_eval ((hd_star_tail (n + 1)).2.2.2.1 j hj) x
          have htri : |G d_star j x - d_star j x| ≤
              |G d_star j x - dSeq (n + 1) j x| + |d_star j x - dSeq (n + 1) j x| := by
            have : G d_star j x - d_star j x =
                (G d_star j x - dSeq (n + 1) j x) - (d_star j x - dSeq (n + 1) j x) := by ring
            rw [this]
            exact abs_sub _ _
          have h_alg : ((2 * R * (1 / 2 : ℝ) ^ n) / 2) / (q : ℝ) ^ 2 +
              (2 * R * (1 / 2 : ℝ) ^ (n + 1)) / (q : ℝ) ^ 2 =
              (2 * R / (q : ℝ) ^ 2) * (1 / 2 : ℝ) ^ n := by
            rw [pow_succ]
            ring
          linarith
        have hlim : Filter.Tendsto (fun n : ℕ => (2 * R / (q : ℝ) ^ 2) * (1 / 2 : ℝ) ^ n)
            Filter.atTop (nhds 0) := by
          simpa using hHalf_tendsto.const_mul (2 * R / (q : ℝ) ^ 2)
        exact le_of_tendsto_of_tendsto tendsto_const_nhds hlim (Filter.Eventually.of_forall h_bnd_n)
      exact sub_eq_zero.mp (abs_nonpos_iff.mp h_zero_le)
    · have hgt : q < j := by omega
      rw [(hG_self d_star hd_star_mem).2.2.1 j hgt, hd_star_gt j hgt]

  have hPicard_diff : ∀ (q : ℕ) (R B_param : ℝ) (G₁ G₂ : (ℕ → ℝ → ℝ) → (ℕ → ℝ → ℝ))
      (d₁ d₂ : ℕ → ℝ → ℝ),
      0 ≤ R → 0 ≤ B_param →
      (∀ u₁ u₂ Δ, 0 ≤ Δ →
        rdmc_IsBoundedDispTuple p q R u₁ →
        rdmc_IsBoundedDispTuple p q R u₂ →
        rdmc_IsBoundedDispTuple p q Δ (fun j x => u₁ j x - u₂ j x) →
        rdmc_IsBoundedDispTuple p q (Δ / 2) (fun j x => G₁ u₁ j x - G₁ u₂ j x)) →
      rdmc_IsBoundedDispTuple p q R d₁ → G₁ d₁ = d₁ →
      rdmc_IsBoundedDispTuple p q R d₂ → G₂ d₂ = d₂ →
      rdmc_IsBoundedDispTuple p q B_param (fun j x => G₁ d₂ j x - G₂ d₂ j x) →
      rdmc_IsBoundedDispTuple p q (2 * B_param) (fun j x => d₁ j x - d₂ j x) := by
    intro q R B_param G₁ G₂ d₁ d₂ hR hBp hG₁_lip hd₁ hfix₁ hd₂ hfix₂ hparam
    let e : ℕ → ℝ → ℝ := fun j x => d₁ j x - d₂ j x
    let ΔSeq : ℕ → ℝ := fun n => 2 * B_param + 2 * R * (1 / 2 : ℝ) ^ n
    have he_seq : ∀ n : ℕ, rdmc_IsBoundedDispTuple p q (ΔSeq n) e := by
      intro n
      induction n with
      | zero =>
        refine hTuple_mono ?_ (hTuple_sub hd₁ hd₂)
        simp only [ΔSeq, pow_zero, mul_one]
        linarith
      | succ n ih =>
        have h1 := hG₁_lip d₁ d₂ (ΔSeq n) (by positivity) hd₁ hd₂ ih
        have hsum := hTuple_add h1 hparam
        have heq_e : (fun j x => (G₁ d₁ j x - G₁ d₂ j x) + (G₁ d₂ j x - G₂ d₂ j x)) = e := by
          funext j x
          have h1x : G₁ d₁ j x = d₁ j x := by rw [hfix₁]
          have h2x : G₂ d₂ j x = d₂ j x := by rw [hfix₂]
          dsimp [e]
          linarith
        rw [heq_e] at hsum
        refine hTuple_mono ?_ hsum
        simp only [ΔSeq, pow_succ]
        linarith
    have hΔ_lim : Filter.Tendsto ΔSeq Filter.atTop (nhds (2 * B_param)) := by
      have h0 : Filter.Tendsto (fun n : ℕ => 2 * R * (1 / 2 : ℝ) ^ n) Filter.atTop (nhds 0) := by
        simpa using hHalf_tendsto.const_mul (2 * R)
      have h1 := (tendsto_const_nhds (x := 2 * B_param)).add h0
      rwa [add_zero] at h1
    have he0 := he_seq 0
    refine ⟨he0.1, he0.2.1, he0.2.2.1, ?_, ?_⟩
    · intro j hj
      refine ⟨(he0.2.2.2.1 j hj).1, (he0.2.2.2.1 j hj).2.1, ?_⟩
      intro k hk x
      exact le_of_tendsto_of_tendsto tendsto_const_nhds (hΔ_lim.div_const ((q : ℝ) ^ 2))
        (Filter.Eventually.of_forall fun n => ((he_seq n).2.2.2.1 j hj).2.2 k hk x)
    · intro j hj
      refine ⟨(he0.2.2.2.2 j hj).1, (he0.2.2.2.2 j hj).2.1, ?_⟩
      intro k hk x
      exact le_of_tendsto_of_tendsto tendsto_const_nhds (hΔ_lim.div_const ((q : ℝ) ^ 3))
        (Filter.Eventually.of_forall fun n => ((he_seq n).2.2.2.2 j hj).2.2 k hk x)

  
  have hC_jet_pos : 0 < J_R.C_jet_R := J_R.C_jet_R_pos
  let K_g2 : ℝ := 1296 * C_mul ^ 2 * J_R.C_jet_R
  let C_N : ℝ := 2 * (9 : ℝ) ^ 5 * C_mul * C_pow5 * J_R.C_jet_R
  let C_force : ℝ := C_mul ^ 2 * C_inv ^ 2 * C_N
  let C_N_lip : ℝ := 2 * C_mul * C_pow5 * J_R.C_jet_R * ((9 : ℝ) ^ 4 + 2 * (9 : ℝ) ^ 5)
  let C_g2_lip : ℝ := 1584 * C_mul ^ 2 * J_R.C_jet_R
  let C_Q_lip : ℝ := C_mul * C_inv * C_inv_lip * (1 + C_g2_lip)
  let C_force_lip : ℝ := C_mul * (C_N_lip * (C_mul * C_inv ^ 2) + C_N * C_Q_lip)
  let N_force : ℕ := max 5 (max J_R.N_jet_R (Nat.ceil (2 * K_g2) + 1))

  have hC_force_pos : 0 < C_force := by positivity
  have hC_force_lip_pos : 0 < C_force_lip := by positivity

  have hSingleJet : ∀ (q : ℕ) (R : ℝ) (w : ℝ → ℝ) (d : ℕ → ℝ → ℝ) (j : ℕ),
      N_force ≤ q → 0 ≤ R → 8 * R ≤ (q : ℝ) →
      IsPeriodicSmoothBounded (m + 15) M₁ w →
      rdmc_IsBoundedDispTuple p q R d →
      j + 1 < q →
      let ρ : ℝ := 2 * Real.pi * ((j + 1 : ℕ) : ℝ) / (q : ℝ)
      let e_X : ℝ → ℝ := d (j + 1)
      let X : ℝ → ℝ := fun x => x + ρ + e_X x
      let τ_t : ℝ → ℝ := fun x => d (j + 2) x - d (j + 1) x
      let τ_s : ℝ → ℝ := fun x => d (j + 1) x - d j x
      let t : ℝ → ℝ := fun x => 2 * Real.pi / (q : ℝ) + τ_t x
      let s : ℝ → ℝ := fun x => 2 * Real.pi / (q : ℝ) + τ_s x
      let a : ℝ → ℝ := fun x => J_R.a_R w (X x)
      let b_p : ℝ → ℝ := fun x => J_R.b_R w (X x) (t x)
      let b_m : ℝ → ℝ := fun x => J_R.b_R w (X x) (-s x)
      let g₁ : ℝ → ℝ := fun x => ((q : ℝ) / (4 * Real.pi)) * (τ_t x + τ_s x)
      let g₂ : ℝ → ℝ := fun x => 8 * ((t x) ^ 2 + (s x) ^ 2) * a x
      IsRealJetPerturb p ((4 * (q : ℝ))⁻¹) e_X ∧
      IsRealJetPerturb p ((4 * (q : ℝ))⁻¹) τ_t ∧
      IsRealJetPerturb p ((4 * (q : ℝ))⁻¹) τ_s ∧
      IsRealJetPerturb p ((4 * (q : ℝ))⁻¹) (fun x => -τ_s x) ∧
      IsRealJetPerturb p (9 / (q : ℝ)) t ∧
      IsRealJetPerturb p (9 / (q : ℝ)) s ∧
      (∀ x : ℝ, |t x| ≤ 2 ∧ |-s x| ≤ 2) ∧
      IsRealJetPerturb p J_R.C_jet_R a ∧
      IsRealJetPerturb p J_R.C_jet_R b_p ∧
      IsRealJetPerturb p J_R.C_jet_R b_m ∧
      IsRealJetPerturb p (1 / 2) g₁ ∧
      IsRealJetPerturb p (1 / 2) g₂ ∧
      (∀ x : ℝ, 1 / 2 ≤ 1 + g₁ x ∧ 1 / 2 ≤ 1 + g₂ x) ∧
      IsRealJetPerturb p (C_force / (q : ℝ) ^ 4) (rdmc_elForcing J_R q w d (j + 1)) := by
    intro q R w d j hq hR h8R hw hd hj
    dsimp only
    have hq5 : 5 ≤ q := le_trans (le_max_left 5 _) hq
    have hq_jet : J_R.N_jet_R ≤ q :=
      le_trans (le_trans (le_max_left _ _) (le_max_right 5 _)) hq
    have hq_ceil : Nat.ceil (2 * K_g2) + 1 ≤ q :=
      le_trans (le_trans (le_max_right _ _) (le_max_right 5 _)) hq
    have hq_ge5 : (5 : ℝ) ≤ (q : ℝ) := by exact_mod_cast hq5
    have hq_pos : 0 < (q : ℝ) := by linarith
    have hq_nz : (q : ℝ) ≠ 0 := ne_of_gt hq_pos
    have hq_ge1 : 1 ≤ (q : ℝ) := by linarith
    have hpi_pos : 0 < Real.pi := Real.pi_pos
    have hpi_nz : Real.pi ≠ 0 := ne_of_gt hpi_pos
    have hRq2_le : R / (q : ℝ) ^ 2 ≤ (4 * (q : ℝ))⁻¹ := by
