  have hExpWPair :
      ∃ (B_eW1 L_eW1 B_eW2 L_eW2 : ℝ),
        0 ≤ B_eW1 ∧ 0 ≤ L_eW1 ∧ 0 ≤ B_eW2 ∧ 0 ≤ L_eW2 ∧
        ∀ (σ σ' ΔH : ℝ) (w₁ w₂ : ℝ → ℝ) (W₁ W₂ : ℂ → ℂ),
          0 < σ → 0 < σ' → σ' ≤ σ → 0 ≤ ΔH →
          IsBoundedStripExt (m + 15) σ M w₁ W₁ →
          IsBoundedStripExt (m + 15) σ M w₂ W₂ →
          let Δ := ΔH + stripDiffSup (m + 15) σ W₁ W₂
          PairBnd σ' Δ B_eW1 L_eW1 (fun z => Complex.exp (W₁ z)) (fun z => Complex.exp (W₂ z)) ∧
