          ⟨hp_np_B, by simp [p_np]; linarith⟩
          h12 hU_neg
      have h1234 : IsPreconnected (((U_pos ∪ V_pos) ∪ U_neg) ∪ V_neg) :=
        IsPreconnected.union p_pn
          (Or.inl (Or.inl ⟨hp_pn_B, by simp [p_pn]; linarith⟩))
          ⟨hp_pn_B, by simp [p_pn]; linarith⟩
          h123 hV_neg
      have heq_set : (((U_pos ∪ V_pos) ∪ U_neg) ∪ V_neg) = B_punc := by
        ext w
        simp only [B_punc, U_pos, U_neg, V_pos, V_neg, Set.mem_union, Set.mem_inter_iff,
          Set.mem_preimage, ContinuousLinearMap.coe_coe, Complex.reCLM_apply, Complex.imCLM_apply,
          Set.mem_Ioi, Set.mem_Iio, Set.mem_sdiff, Set.mem_singleton_iff]
        constructor
        · rintro (((⟨hw, h⟩ | ⟨hw, h⟩) | ⟨hw, h⟩) | ⟨hw, h⟩)
          · exact ⟨hw, fun he => by subst he; linarith⟩
          · exact ⟨hw, fun he => by subst he; linarith⟩
          · exact ⟨hw, fun he => by subst he; linarith⟩
          · exact ⟨hw, fun he => by subst he; linarith⟩
        · rintro ⟨hw, hne⟩
          by_cases hre : w.re = s₀.re
          · have him : w.im ≠ s₀.im := fun him => hne (Complex.ext hre him)
            rcases lt_or_gt_of_ne him with hlt | hgt
            · exact Or.inr ⟨hw, hlt⟩
            · exact Or.inl (Or.inl (Or.inr ⟨hw, hgt⟩))
          · rcases lt_or_gt_of_ne hre with hlt | hgt
            · exact Or.inl (Or.inr ⟨hw, hlt⟩)
            · exact Or.inl (Or.inl (Or.inl ⟨hw, hgt⟩))
      rwa [heq_set] at h1234
    have hfv_holo : DifferentiableOn ℂ (fun w => -(C.c : ℂ) * ψ₁ w / (g₁ w) ^ 2) B := by
      refine (hψ₁_holo.const_mul (-(C.c : ℂ))).div ((hg₁_holo.mono hB_sub).pow 2) ?_
      intro w hw
      exact pow_ne_zero 2 (hg₁_ne w hw)
    have hfu_holo : DifferentiableOn ℂ (fun w => (C.c : ℂ) * h_u w) B :=
      hh_u_holo.const_mul (C.c : ℂ)
    obtain ⟨V_prim, hVp_within⟩ := Convex.exists_forall_hasDerivWithinAt (convex_ball s₀ ρ) hfv_holo
    obtain ⟨U_prim, hUp_within⟩ := Convex.exists_forall_hasDerivWithinAt (convex_ball s₀ ρ) hfu_holo
    have hVp : ∀ w ∈ B, HasDerivAt V_prim (-(C.c : ℂ) * ψ₁ w / (g₁ w) ^ 2) w :=
      fun w hw => (hVp_within w hw).hasDerivAt (Metric.isOpen_ball.mem_nhds hw)
    have hUp : ∀ w ∈ B, HasDerivAt U_prim ((C.c : ℂ) * h_u w) w :=
      fun w hw => (hUp_within w hw).hasDerivAt (Metric.isOpen_ball.mem_nhds hw)
    let v_norm : ℂ → ℂ := fun w => K.Γ w 0 * Complex.cos ϕ₀ + K.Γ w 1 * Complex.sin ϕ₀
    let u_tan : ℂ → ℂ := fun w => -K.Γ w 0 * Complex.sin ϕ₀ + K.Γ w 1 * Complex.cos ϕ₀
    have hv_zero_deriv : ∀ w ∈ B_punc, HasDerivAt (fun z => v_norm z - V_prim z) 0 w := by
      rintro w ⟨hwB, hw_ne⟩
      have hwD : w ∈ D_H := hB_sub hwB
      have hsub_ne : w - s₀ ≠ 0 := sub_ne_zero.mpr hw_ne
      have hgw_ne : g₁ w ≠ 0 := hg₁_ne w hwB
      have hfw_ne : K.f w ≠ 0 := by rw [hf_fac w]; exact mul_ne_zero hsub_ne hgw_ne
      have hΓ₀ : HasDerivAt (fun z => K.Γ z 0)
          (-(C.c : ℂ) * (K.f w)⁻¹ ^ 2 * Complex.sin (K.ϕ w)) w := by
        rw [← K.Γ_deriv₀ w hwD hfw_ne]
        exact (K.Γ_reg_holo w hwD hfw_ne).1.hasDerivAt
      have hΓ₁ : HasDerivAt (fun z => K.Γ z 1)
          ((C.c : ℂ) * (K.f w)⁻¹ ^ 2 * Complex.cos (K.ϕ w)) w := by
        rw [← K.Γ_deriv₁ w hwD hfw_ne]
        exact (K.Γ_reg_holo w hwD hfw_ne).2.hasDerivAt
      have hv_d : HasDerivAt v_norm (-(C.c : ℂ) * ψ₁ w / (g₁ w) ^ 2) w := by
        convert (hΓ₀.mul_const (Complex.cos ϕ₀)).add (hΓ₁.mul_const (Complex.sin ϕ₀)) using 1
        calc
          -(C.c : ℂ) * ψ₁ w / (g₁ w) ^ 2
            = -(C.c : ℂ) * ((w - s₀) * g₁ w)⁻¹ ^ 2 * ((w - s₀) ^ 2 * ψ₁ w) := by
