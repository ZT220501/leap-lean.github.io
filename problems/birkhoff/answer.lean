        rw [Metric.mem_ball, dist_zero_right] at ht'
        exact (hv_props z t' (lt_of_lt_of_le hz hr₁_le_2rZ) (lt_of_lt_of_le ht' hr₁_le_2rZ)).2.2.2.2
      have hdXZ_z : deriv (fun z' => X_Z (z', t)) z = deriv G.Z_loc (v (z, t)) * pderivA v (z, t) := by
        rw [hev_z.deriv_eq]
        simpa [pderivA, Function.comp_def] using deriv_comp z hZ_diff_at hv_z
      have hdXZ_t : deriv (fun t' => X_Z (z, t')) t = deriv G.Z_loc (v (z, t)) * pderivD v (z, t) := by
