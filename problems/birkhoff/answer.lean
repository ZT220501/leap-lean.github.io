        have hg₁_cont : ContinuousAt g₁ p₁ :=
          hg₁.continuousOn.continuousAt (hW_open.mem_nhds hp₁W)
        have hg₂_ev0 : ∀ᶠ q in nhds p₁, g₂ q = 0 := by
          filter_upwards [hW_open.mem_nhds hp₁W, hg₁_cont.eventually_ne hp₁_ne] with q hqW hq_ne
          exact (mul_eq_zero.mp (hprod q hqW)).resolve_left hq_ne
        intro p hpW
        let L_aff : ℂ → ℂ × ℂ := fun ζ => p₁ + ζ • (p - p₁)
        have hL_diff : Differentiable ℂ L_aff :=
          (differentiable_const p₁).add (differentiable_id.smul_const (p - p₁))
        let Ω₁ : Set ℂ := { ζ : ℂ | L_aff ζ ∈ W }
        have hΩ₁_open : IsOpen Ω₁ := hW_open.preimage hL_diff.continuous
        have hΩ₁_conv : Convex ℝ Ω₁ := by
          intro ζ₁ hζ₁ ζ₂ hζ₂ a b ha hb hab
          change p₁ + (a • ζ₁ + b • ζ₂) • (p - p₁) ∈ W
          have h_aff : p₁ + (a • ζ₁ + b • ζ₂) • (p - p₁) =
              a • L_aff ζ₁ + b • L_aff ζ₂ := by
            dsimp only [L_aff]
            rw [add_smul, smul_add, smul_add, smul_assoc, smul_assoc, ← add_assoc]
            have hp₁_ab : p₁ = a • p₁ + b • p₁ := by rw [← add_smul, hab, one_smul]
            nth_rw 1 [hp₁_ab]
            abel
