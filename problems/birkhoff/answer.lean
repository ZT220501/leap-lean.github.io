      have hz_s : z ∈ horizStrip s := by
        have hz' : |z.im| < s - δ := hz
        change |z.im| < s
        linarith
      have hzp_s : z + (t₀ : ℂ) ∈ horizStrip s := hstrip_add_real s z t₀ hz_s
      have hzm_s : z - (t₀ : ℂ) ∈ horizStrip s := hstrip_sub_real s z t₀ hz_s
      let δ_w : ℝ := max ‖w_m' - w_m‖ (max ‖w_0' - w_0‖ ‖w_p' - w_p‖)
      have hδw_nonneg : 0 ≤ δ_w := le_max_of_le_left (norm_nonneg _)
      have hδw_le : δ_w ≤ M_Δ := max_le hdm (max_le hd0_w hdp)
      by_cases hδw_zero : δ_w = 0
      · have hm_eq : w_m' = w_m := by
          have : ‖w_m' - w_m‖ ≤ 0 := hδw_zero ▸ le_max_left _ _
