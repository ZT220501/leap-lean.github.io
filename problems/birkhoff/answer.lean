        have hsq : ‖T_star‖ ^ 2 ≤ T₀ ^ 2 := pow_le_pow_left₀ (norm_nonneg T_star) hT_star.le 2
        have h_im1 : 1 ≤ -Z.im := by linarith [P.D_pass_ge, hZ.1]
        have hrpow_pos : 0 ≤ (-Z.im) ^ (1 - 2 * α) := Real.rpow_nonneg (by linarith) _
        have hrpow_le1 : (-Z.im) ^ (1 - 2 * α) ≤ 1 :=
