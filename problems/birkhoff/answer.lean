      refine ⟨r_h, hr_h_pos, hr_h_le, hq_holo, ?_⟩
      have h_pt_prod : ∀ t ∈ B_h,
          (h t * deriv F (s₀ t)) * q_fn t = F (s₀ t + h t) - F (s₀ t) := by
        intro t ht
        rw [hq_eq_div t ht]
        have ht_r : t ∈ Metric.ball (0 : ℂ) r := hBh_sub ht
        have h_uh_ne : u_h t ≠ 0 :=
          hρ_u (lt_of_lt_of_le (Metric.mem_ball.mp ht) (min_le_right r ρ_u))
        have hdf_ne : deriv F (s₀ t) ≠ 0 := (hF_reg (s₀ t) (hs₀_maps t ht_r)).2
        have h_ht : h t = t * u_h t := by
          have := sub_smul_dslope h 0 t
          simpa [u_h, hh0, smul_eq_mul] using this.symm
        have h_Φt : F (s₀ t + h t) - F (s₀ t) = t * Δ_F t := by
          have := sub_smul_dslope Φ_F 0 t
          have hΦ0 : Φ_F 0 = 0 := by simp [Φ_F, hh0]
          simpa [Φ_F, Δ_F, hΦ0, smul_eq_mul] using this.symm
        rw [h_Φt, h_ht]
        field_simp [h_uh_ne, hdf_ne]
      have hBh_open : IsOpen B_h := Metric.isOpen_ball
      have h0_Bh : (0 : ℂ) ∈ B_h := Metric.mem_ball_self hr_h_pos
      have h_tay_congr : ∀ {g₁ g₂ : ℂ → ℂ}, (∀ t ∈ B_h, g₁ t = g₂ t) →
          holoTaylor1D g₁ 0 = holoTaylor1D g₂ 0 := by
        intro g₁ g₂ heq
        ext m
        have h_ev : g₁ =ᶠ[nhds (0 : ℂ)] g₂ := by
          filter_upwards [hBh_open.mem_nhds h0_Bh] with t ht using heq t ht
        simp [holoTaylor1D, h_ev.iteratedDeriv_eq m]
      have h_lhs_tay : holoTaylor1D (fun t => (h t * deriv F (s₀ t)) * q_fn t) 0 =
          (H_ser * rp_substPS (holoTaylor1D (deriv F) z₀) V) * holoTaylor1D q_fn 0 := by
        have hm1 := (h_t1d_alg hBh_open h0_Bh
          (fun t => h t * deriv F (s₀ t)) q_fn
          ((hh_holo.mono hBh_sub).mul (hdF_holo.comp (hs₀_holo.mono hBh_sub)
            (fun t ht => hs₀_maps t (hBh_sub ht))))
          hq_holo).2.2
        have hm2 := (h_t1d_alg hBh_open h0_Bh h (fun t => deriv F (s₀ t))
          (hh_holo.mono hBh_sub)
          (hdF_holo.comp (hs₀_holo.mono hBh_sub) (fun t ht => hs₀_maps t (hBh_sub ht)))).2.2
        have hc_dF := h_t1d_comp hBh_open hW₀_open h0_Bh s₀ (deriv F)
          (hs₀_holo.mono hBh_sub) hdF_holo
          (fun t ht => hs₀_maps t (hBh_sub ht))
        rw [hm1, hm2, hh_tay, hc_dF, hs₀_0, hV_taylor]
      have h_rhs_tay : holoTaylor1D (fun t => F (s₀ t + h t) - F (s₀ t)) 0 =
          rp_substPS (holoTaylor1D F z₀) (V + H_ser) - rp_substPS (holoTaylor1D F z₀) V := by
        have hs1 := (h_t1d_alg hBh_open h0_Bh
          (fun t => F (s₀ t + h t)) (fun t => F (s₀ t))
          (hF_holo.comp ((hs₀_holo.mono hBh_sub).add (hh_holo.mono hBh_sub))
            (fun t ht => hh_maps t (hBh_sub ht)))
          (hF_holo.comp (hs₀_holo.mono hBh_sub) (fun t ht => hs₀_maps t (hBh_sub ht)))).2.1
        have hc1 := h_t1d_comp hBh_open hW₀_open h0_Bh
          (fun t => s₀ t + h t) F
          ((hs₀_holo.mono hBh_sub).add (hh_holo.mono hBh_sub)) hF_holo
          (fun t ht => hh_maps t (hBh_sub ht))
        have hc2 := h_t1d_comp hBh_open hW₀_open h0_Bh
          s₀ F (hs₀_holo.mono hBh_sub) hF_holo (fun t ht => hs₀_maps t (hBh_sub ht))
        have h0_sum : s₀ 0 + h 0 = z₀ := by rw [hs₀_0, hh0, add_zero]
        have h_cent_sum : holoTaylor1D (fun t => (s₀ t + h t) - (s₀ 0 + h 0)) 0 = V + H_ser := by
          rw [h0_sum]
          have h_fn : (fun t => (s₀ t + h t) - z₀) = (fun t => V₀ t + h t) := by
            ext t; simp [V₀, s₀]; ring
          rw [h_fn, (h_t1d_alg hB0_open h0_mem V₀ h
            (hs₀_holo.sub (differentiableOn_const z₀)) hh_holo).1,
            hV_taylor, hh_tay]
        rw [hs1, hc1, hc2, h_cent_sum, h0_sum, hs₀_0, hV_taylor]
      have h_S_eq : (H_ser * rp_substPS (holoTaylor1D (deriv F) z₀) V) * S_ser F H_ser =
          rp_substPS (holoTaylor1D F z₀) (V + H_ser) - rp_substPS (holoTaylor1D F z₀) V := by
        let f_F := holoTaylor1D F z₀
        let df_F := holoTaylor1D (deriv F) z₀
        have h_dqc_prod : ∀ k : ℕ,
            rp_substPS df_F V * rp_substPS (holoTaylor1D (diffQuotCoeff F k) z₀) V =
              rp_substPS
                (PowerSeries.mk fun r =>
                  (((r + k + 1).choose (k + 1) : ℂ) * PowerSeries.coeff (r + k + 1) f_F)) V := by
          intro k
          rw [← h_subst_mul _ _ V hV_c0]
          congr 1
          have h_iter_holo : DifferentiableOn ℂ (iteratedDeriv (k + 1) F) W₀ := by
            intro w hw
            rw [iteratedDeriv_eq_iterate]
            exact ((hF_reg w hw).1.iterated_deriv (k + 1)).differentiableAt.differentiableWithinAt
          have h_dqc_holo : DifferentiableOn ℂ (diffQuotCoeff F k) W₀ := by
            refine h_iter_holo.div (differentiableOn_const _ |>.mul hdF_holo) ?_
            intro w hw
            exact mul_ne_zero (Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)) (hF_reg w hw).2
          have hz₀_W₀ : z₀ ∈ W₀ := ⟨hz₀_pos, by simpa using hz₀_lt⟩
          have hm := (h_t1d_alg hW₀_open hz₀_W₀ (deriv F) (diffQuotCoeff F k) hdF_holo h_dqc_holo).2.2
          rw [← hm]
          ext r
          have h_ev : (fun w => deriv F w * diffQuotCoeff F k w) =ᶠ[nhds z₀]
              (fun w => iteratedDeriv (k + 1) F w / ((k + 1).factorial : ℂ)) := by
            filter_upwards [hW₀_open.mem_nhds hz₀_W₀] with w hw
            have hdf_w : deriv F w ≠ 0 := (hF_reg w hw).2
            have hfac_ne : (((k + 1).factorial : ℂ)) ≠ 0 :=
              Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)
            simp only [diffQuotCoeff]
            field_simp [hdf_w, hfac_ne]
          simp only [holoTaylor1D, PowerSeries.coeff_mk, h_ev.iteratedDeriv_eq r,
            iteratedDeriv_div_const, f_F]
          have h_it : iteratedDeriv r (iteratedDeriv (k + 1) F) z₀ =
              iteratedDeriv (r + k + 1) F z₀ := by
            simp only [iteratedDeriv_eq_iterate, Function.iterate_add_apply]
          rw [h_it]
          have h_fac : ((r + k + 1).choose (k + 1) : ℂ) * ((k + 1).factorial : ℂ) *
              (r.factorial : ℂ) = ((r + k + 1).factorial : ℂ) := by
            have := Nat.choose_mul_factorial_mul_factorial (show k + 1 ≤ r + k + 1 by omega)
            have hsub : r + k + 1 - (k + 1) = r := by omega
            rw [hsub] at this
            exact_mod_cast this
          have h1 : ((k + 1).factorial : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)
          have h2 : (r.factorial : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)
          have h3 : ((r + k + 1).factorial : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)
          field_simp [h1, h2, h3]
          rw [← h_fac]
          ring
        ext M
        let S_M : PowerSeries ℂ :=
          ∑ k ∈ Finset.range (M + 1),
            rp_substPS (holoTaylor1D (diffQuotCoeff F k) z₀) V * H_ser ^ k
        have h_SM_eq : ∀ b ≤ M, PowerSeries.coeff b (S_ser F H_ser) = PowerSeries.coeff b S_M := by
          intro b hb
          simp only [S_ser, S_M, PowerSeries.coeff_mk, map_sum]
          refine Finset.sum_subset (Finset.range_mono (by omega)) ?_
          intro k _ hk_not
          have hbk : b < k := by simp only [Finset.mem_range, not_lt] at hk_not; omega
          rw [PowerSeries.coeff_mul]
          apply Finset.sum_eq_zero
          intro p hp
          have hp_sum := Finset.HasAntidiagonal.mem_antidiagonal.mp hp
          rw [h_pow_vanish k p.2 hH0 (by omega), mul_zero]
        change PowerSeries.coeff M ((H_ser * rp_substPS df_F V) * S_ser F H_ser) = _
        have h_lhs_M' : PowerSeries.coeff M ((H_ser * rp_substPS df_F V) * S_ser F H_ser) =
            PowerSeries.coeff M ((H_ser * rp_substPS df_F V) * S_M) := by
          simp only [PowerSeries.coeff_mul]
          refine Finset.sum_congr rfl fun p hp => ?_
          have hp_sum := Finset.HasAntidiagonal.mem_antidiagonal.mp hp
          rw [h_SM_eq p.2 (by omega)]
        rw [h_lhs_M']
        have h_dist : (H_ser * rp_substPS df_F V) * S_M =
            ∑ k ∈ Finset.range (M + 1),
              rp_substPS
                (PowerSeries.mk fun r =>
                  (((r + k + 1).choose (k + 1) : ℂ) * PowerSeries.coeff (r + k + 1) f_F)) V *
                H_ser ^ (k + 1) := by
          simp only [S_M, Finset.mul_sum]
          refine Finset.sum_congr rfl fun k _ => ?_
          have h_assoc : (H_ser * rp_substPS df_F V) *
                (rp_substPS (holoTaylor1D (diffQuotCoeff F k) z₀) V * H_ser ^ k) =
              (rp_substPS df_F V * rp_substPS (holoTaylor1D (diffQuotCoeff F k) z₀) V) *
                (H_ser ^ k * H_ser) := by ring
          rw [h_assoc, h_dqc_prod k, ← pow_succ]
        rw [h_dist, map_sum]
        have h_lhs_fin : (∑ k ∈ Finset.range (M + 1),
              PowerSeries.coeff M
                (rp_substPS
                  (PowerSeries.mk fun r =>
                    (((r + k + 1).choose (k + 1) : ℂ) * PowerSeries.coeff (r + k + 1) f_F)) V *
                  H_ser ^ (k + 1))) =
            ∑ k ∈ Finset.range (M + 1), ∑ r ∈ Finset.range (M + 1),
              ((r + k + 1).choose (k + 1) : ℂ) * PowerSeries.coeff (r + k + 1) f_F *
                PowerSeries.coeff M (V ^ r * H_ser ^ (k + 1)) := by
          refine Finset.sum_congr rfl fun k _ => ?_
          rw [PowerSeries.coeff_mul]
          have h_inner : ∀ p ∈ Finset.HasAntidiagonal.antidiagonal M,
              PowerSeries.coeff p.1
                  (rp_substPS
                    (PowerSeries.mk fun r =>
                      (((r + k + 1).choose (k + 1) : ℂ) * PowerSeries.coeff (r + k + 1) f_F)) V) *
                PowerSeries.coeff p.2 (H_ser ^ (k + 1)) =
              ∑ r ∈ Finset.range (M + 1),
                ((r + k + 1).choose (k + 1) : ℂ) * PowerSeries.coeff (r + k + 1) f_F *
                  (PowerSeries.coeff p.1 (V ^ r) * PowerSeries.coeff p.2 (H_ser ^ (k + 1))) := by
            intro p hp
            have hp_sum := Finset.HasAntidiagonal.mem_antidiagonal.mp hp
            rw [h_subst_range_ext _ V p.1 M hV_c0 (by omega), Finset.sum_mul]
            refine Finset.sum_congr rfl fun r _ => ?_
            simp only [PowerSeries.coeff_mk]
            ring
          rw [Finset.sum_congr rfl h_inner, Finset.sum_comm]
          refine Finset.sum_congr rfl fun r _ => ?_
          rw [PowerSeries.coeff_mul, Finset.mul_sum]
        rw [h_lhs_fin]
        have h_binom_diff : ∀ m : ℕ,
            (V + H_ser) ^ m - V ^ m =
              ∑ k ∈ Finset.range m,
                PowerSeries.C (m.choose (k + 1) : ℂ) * (V ^ (m - 1 - k) * H_ser ^ (k + 1)) := by
          intro m
          have h1 : (V + H_ser) ^ m = (H_ser + V) ^ m := by rw [add_comm]
          rw [h1, add_pow, Finset.sum_range_succ' _ m]
          simp only [pow_zero, Nat.sub_zero, Nat.choose_zero_right, Nat.cast_one, one_mul, mul_one,
            add_sub_cancel_right]
          refine Finset.sum_congr rfl fun k _ => ?_
          have h_sub : m - (k + 1) = m - 1 - k := by omega
          rw [h_sub]
          ext d
          simp [PowerSeries.coeff_C_mul]
          ring
        have h_rhs_fin : PowerSeries.coeff M (rp_substPS f_F (V + H_ser) - rp_substPS f_F V) =
            ∑ m ∈ Finset.range (M + 1), ∑ k ∈ Finset.range m,
              (m.choose (k + 1) : ℂ) * PowerSeries.coeff m f_F *
                PowerSeries.coeff M (V ^ (m - 1 - k) * H_ser ^ (k + 1)) := by
          rw [map_sub]
          simp only [rp_substPS, PowerSeries.coeff_mk, ← Finset.sum_sub_distrib]
          refine Finset.sum_congr rfl fun m _ => ?_
          rw [← mul_sub, ← map_sub, h_binom_diff m, map_sum, Finset.mul_sum]
          refine Finset.sum_congr rfl fun k _ => ?_
          rw [PowerSeries.coeff_C_mul]
          ring
        rw [h_rhs_fin]
        have h_vh_vanish : ∀ r k : ℕ, M < r + k + 1 →
            PowerSeries.coeff M (V ^ r * H_ser ^ (k + 1)) = 0 := by
          intro r k hgt
          rw [PowerSeries.coeff_mul]
          apply Finset.sum_eq_zero
          intro p hp
          have hp_sum := Finset.HasAntidiagonal.mem_antidiagonal.mp hp
          by_cases hp1 : p.1 < r
          · rw [h_pow_vanish r p.1 hV_c0 hp1, zero_mul]
          · rw [h_pow_vanish (k + 1) p.2 hH0 (by omega), mul_zero]
        rw [← Finset.sum_product (Finset.range (M + 1)) (Finset.range (M + 1))
          (fun p => ((p.2 + p.1 + 1).choose (p.1 + 1) : ℂ) * PowerSeries.coeff (p.2 + p.1 + 1) f_F *
            PowerSeries.coeff M (V ^ p.2 * H_ser ^ (p.1 + 1)))]
        rw [← Finset.sum_sigma (Finset.range (M + 1)) (fun m => Finset.range m)
          (fun s => (s.1.choose (s.2 + 1) : ℂ) * PowerSeries.coeff s.1 f_F *
            PowerSeries.coeff M (V ^ (s.1 - 1 - s.2) * H_ser ^ (s.2 + 1)))]
        refine Finset.sum_bij_ne_zero (fun p _ _ => ⟨p.2 + p.1 + 1, p.1⟩) ?_ ?_ ?_ ?_
        · intro p _ h_ne
          have hle : p.2 + p.1 + 1 ≤ M := by
            by_contra hgt
            exact h_ne (by rw [h_vh_vanish p.2 p.1 (by omega), mul_zero])
          exact Finset.mem_sigma.mpr ⟨Finset.mem_range.mpr (by dsimp; omega),
            Finset.mem_range.mpr (by dsimp; omega)⟩
        · intro p₁ _ _ p₂ _ _ h_eq
          have h1 : p₁.2 + p₁.1 + 1 = p₂.2 + p₂.1 + 1 := (Sigma.mk.inj_iff.mp h_eq).1
          have h2 : p₁.1 = p₂.1 := eq_of_heq (Sigma.mk.inj_iff.mp h_eq).2
          ext <;> omega
        · intro s hs h_ne
          obtain ⟨hs1, hs2⟩ := Finset.mem_sigma.mp hs
          have hm_lt := Finset.mem_range.mp hs1
          have hk_lt := Finset.mem_range.mp hs2
          refine ⟨(s.2, s.1 - 1 - s.2), Finset.mem_product.mpr ⟨Finset.mem_range.mpr (by omega),
            Finset.mem_range.mpr (by omega)⟩, ?_, ?_⟩
          · have h_sum : s.1 - 1 - s.2 + s.2 + 1 = s.1 := by omega
            simpa [h_sum] using h_ne
          · ext
            · dsimp; omega
            · rfl
        · intro p _ _
          dsimp
          rw [Nat.add_sub_cancel]
      have h_eq_both : (H_ser * rp_substPS (holoTaylor1D (deriv F) z₀) V) * holoTaylor1D q_fn 0 =
          (H_ser * rp_substPS (holoTaylor1D (deriv F) z₀) V) * S_ser F H_ser := by
        rw [← h_lhs_tay, h_tay_congr h_pt_prod, h_rhs_tay, h_S_eq]
      have hH_ne : H_ser ≠ 0 := by
        intro h0; rw [h0, map_zero] at hH1; exact hc₁_ne hH1.symm
      have hdf_ps_ne : rp_substPS (holoTaylor1D (deriv F) z₀) V ≠ 0 := by
        intro h0
        have hc0 := congrArg (PowerSeries.coeff 0) h0
        simp only [rp_substPS, PowerSeries.coeff_mk, Finset.sum_range_succ, Finset.sum_range_zero,
          zero_add, pow_zero, PowerSeries.coeff_one, ite_true, mul_one, holoTaylor1D,
          iteratedDeriv_zero, Nat.factorial_zero, Nat.cast_one, div_one, map_zero] at hc0
        have hz₀_W₀ : z₀ ∈ W₀ := ⟨hz₀_pos, by simpa using hz₀_lt⟩
        exact (hF_reg z₀ hz₀_W₀).2 hc0
      exact mul_left_cancel₀ (mul_ne_zero hH_ne hdf_ps_ne) h_eq_both
    have hZ_reg : ∀ w ∈ W₀, AnalyticAt ℂ G.Z_loc w ∧ deriv G.Z_loc w ≠ 0 := by
      intro w hw
      have hw_lt : ‖w‖ < S.δ₁ := by simpa using Metric.mem_ball.mp hw.2
      exact ⟨(G.reg_on_punctured w hw.1 (lt_of_lt_of_le hw_lt S.δ₁_le)).1,
        S.deriv_Z_ne_zero w hw.1 hw_lt⟩
    have hW_reg : ∀ w ∈ W₀, AnalyticAt ℂ G.W_loc w ∧ deriv G.W_loc w ≠ 0 := by
      intro w hw
      have hw_lt : ‖w‖ < S.δ₁ := by simpa using Metric.mem_ball.mp hw.2
      exact ⟨(G.reg_on_punctured w hw.1 (lt_of_lt_of_le hw_lt S.δ₁_le)).2.1,
        S.deriv_W_ne_zero w hw.1 hw_lt⟩
    have hhP_holo : DifferentiableOn ℂ h_plus (Metric.ball (0 : ℂ) r) :=
      hv1_holo.sub hv0_holo
    have hhM_holo : DifferentiableOn ℂ h_minus (Metric.ball (0 : ℂ) r) := by
      have h_eq : h_minus = fun t => v (z₀, t) - v (z₀ + (-1 : ℂ) * t, t) := by
        ext t; simp [h_minus, sub_eq_add_neg]
      rw [h_eq]
      exact hv0_holo.sub (hv_t_holo (-1) (by norm_num))
    have hhM_neg_holo : DifferentiableOn ℂ (fun t => -h_minus t) (Metric.ball (0 : ℂ) r) :=
      hhM_holo.neg
    have hhM_neg_tay : holoTaylor1D (fun t => -h_minus t) 0 = -HM := by
      have h_eq : (fun t => -h_minus t) = (fun t => (0 : ℂ) - h_minus t) := by ext t; simp
      rw [h_eq]
      rw [(h_t1d_alg hB0_open h0_mem (fun _ => 0) h_minus (differentiableOn_const 0) hhM_holo).2.1,
        h_t1d_const, map_zero, zero_sub, hHM_taylor]
    have hhP_maps : ∀ t ∈ Metric.ball (0 : ℂ) r, v (z₀, t) + h_plus t ∈ W₀ := by
      intro t ht
      have ht_lt : ‖t‖ < r := by simpa using Metric.mem_ball.mp ht
      have h_eq : v (z₀, t) + h_plus t = v (z₀ + t, t) := by simp [h_plus]
      rw [h_eq]
      have hp := hv_props (z₀ + t) t (by simpa using by linarith) (by linarith)
      exact ⟨hp.1, by simpa using hp.2.1⟩
    have hhM_maps : ∀ t ∈ Metric.ball (0 : ℂ) r, v (z₀, t) + (-h_minus t) ∈ W₀ := by
      intro t ht
      have ht_lt : ‖t‖ < r := by simpa using Metric.mem_ball.mp ht
      have h_eq : v (z₀, t) + (-h_minus t) = v (z₀ - t, t) := by simp [h_minus]
      rw [h_eq]
      have hz_lt : ‖z₀ - t - z₀‖ < 2 * r := by rw [sub_sub_cancel_left, norm_neg]; linarith
      have hp := hv_props (z₀ - t) t hz_lt (by linarith)
      exact ⟨hp.1, by simpa using hp.2.1⟩
    have hnegHM_c0 : PowerSeries.coeff 0 (-HM) = 0 := by rw [map_neg, hHM_c0, neg_zero]
    have hnegHM_c1 : PowerSeries.coeff 1 (-HM) = -1 := by rw [map_neg, hHM_c1]
    obtain ⟨r₁, hr₁_pos, hr₁_le, hqZ_m_holo, hqZ_m_tay⟩ :=
      h_ndq_series G.Z_loc hZ_reg (fun t => -h_minus t) (-HM) (-1)
        hhM_neg_holo (by simp [h_minus]) (by norm_num) hhM_neg_tay
        hnegHM_c0 hnegHM_c1 hhM_maps
    obtain ⟨r₂, hr₂_pos, _, hqZ_p_holo, hqZ_p_tay⟩ :=
      h_ndq_series G.Z_loc hZ_reg h_plus HP 1
        hhP_holo (by simp [h_plus]) (by norm_num) hHP_taylor
        hHP_c0 hHP_c1 hhP_maps
    obtain ⟨r₃, hr₃_pos, _, hqW_m_holo, hqW_m_tay⟩ :=
      h_ndq_series G.W_loc hW_reg (fun t => -h_minus t) (-HM) (-1)
        hhM_neg_holo (by simp [h_minus]) (by norm_num) hhM_neg_tay
        hnegHM_c0 hnegHM_c1 hhM_maps
    obtain ⟨r₄, hr₄_pos, _, hqW_p_holo, hqW_p_tay⟩ :=
