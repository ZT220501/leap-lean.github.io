    · filter_upwards [self_mem_nhdsWithin] with u hu
      exact ((hg_t u hu).mono huIoc_sub).aestronglyMeasurable measurableSet_uIoc
    · filter_upwards [self_mem_nhdsWithin] with u hu
      exact Filter.Eventually.of_forall fun t ht => hg_bnd u hu t (huIoc_sub ht)
    · exact intervalIntegrable_const
    · exact Filter.Eventually.of_forall fun t ht => hg_u t (huIoc_sub ht) u₀ hu₀
  
  have hParamDerivCore : ∀ (σ' M : ℝ) (G : ℝ → ℂ → ℂ),
      0 ≤ M →
      (∀ z ∈ horizStrip σ',
        MeasureTheory.AEStronglyMeasurable (fun t => G t z)
          (MeasureTheory.volume.restrict (Set.uIoc (0 : ℝ) 1))) →
      (∀ t ∈ Set.Icc (0 : ℝ) 1, DifferentiableOn ℂ (G t) (horizStrip σ')) →
      (∀ t ∈ Set.Icc (0 : ℝ) 1, ∀ z ∈ horizStrip σ', ‖G t z‖ ≤ M) →
      (∀ z ∈ horizStrip σ', ‖∫ t in (0 : ℝ)..1, G t z‖ ≤ M) ∧
      (∀ z₀ ∈ horizStrip σ',
        MeasureTheory.AEStronglyMeasurable (fun t => deriv (G t) z₀)
          (MeasureTheory.volume.restrict (Set.uIoc (0 : ℝ) 1)) ∧
        HasDerivAt (fun w => ∫ t in (0 : ℝ)..1, G t w)
          (∫ t in (0 : ℝ)..1, deriv (G t) z₀) z₀) := by
    intro σ' M G _hM hMeas hHolo hBnd
    have huIoc_sub : Set.uIoc (0 : ℝ) 1 ⊆ Set.Icc (0 : ℝ) 1 := by
      rw [Set.uIoc_of_le zero_le_one]
      exact Set.Ioc_subset_Icc_self
    have hInt : ∀ z ∈ horizStrip σ',
        IntervalIntegrable (fun t => G t z) MeasureTheory.volume 0 1 := by
      intro z hz
      refine intervalIntegrable_const (c := M).mono_fun' (hMeas z hz) ?_
      filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_uIoc] with t ht
      exact hBnd t (huIoc_sub ht) z hz
    have hNorm : ∀ z ∈ horizStrip σ', ‖∫ t in (0 : ℝ)..1, G t z‖ ≤ M := by
      intro z hz
      have h1 : ‖∫ t in (0 : ℝ)..1, G t z‖ ≤ M * |(1 : ℝ) - 0| := by
        apply intervalIntegral.norm_integral_le_of_norm_le_const
        intro t ht
        exact hBnd t (huIoc_sub ht) z hz
      simpa using h1
    refine ⟨hNorm, ?_⟩
    intro z₀ hz₀
    obtain ⟨ε, hε_pos, hBall_sub⟩ := Metric.isOpen_iff.mp (hOpen σ') z₀ hz₀
    let r : ℝ := ε / 3
    have hr_pos : 0 < r := by dsimp [r]; linarith
    
    let h_seq : ℕ → ℂ := fun n => (((1 : ℝ) / ((n : ℝ) + 1) * (r / 2) : ℝ) : ℂ)
    have hh_ne : ∀ n : ℕ, h_seq n ≠ 0 := by
      intro n
      dsimp [h_seq]
      norm_cast
      exact ne_of_gt (mul_pos (div_pos one_pos (by positivity)) (by linarith))
    have hh_mem : ∀ n : ℕ, z₀ + h_seq n ∈ horizStrip σ' := by
      intro n
      apply hBall_sub
      rw [Metric.mem_ball, dist_self_add_left]
      dsimp [h_seq]
      rw [Complex.norm_real, Real.norm_eq_abs,
        abs_of_pos (mul_pos (div_pos one_pos (by positivity)) (by linarith))]
      have hn0 : (0 : ℝ) ≤ (n : ℝ) := Nat.cast_nonneg n
      have hle1 : (1 : ℝ) / ((n : ℝ) + 1) ≤ 1 :=
        div_le_one_of_le₀ (by linarith) (by positivity)
      calc
        (1 : ℝ) / ((n : ℝ) + 1) * (r / 2) ≤ 1 * (r / 2) :=
          mul_le_mul_of_nonneg_right hle1 (by linarith)
        _ < ε := by dsimp [r]; linarith
    have hh_tendsto : Filter.Tendsto h_seq Filter.atTop (nhdsWithin 0 {(0 : ℂ)}ᶜ) := by
      rw [tendsto_nhdsWithin_iff]
      refine ⟨?_, Filter.Eventually.of_forall hh_ne⟩
      have hR0 : Filter.Tendsto (fun n : ℕ => (1 : ℝ) / ((n : ℝ) + 1) * (r / 2))
          Filter.atTop (nhds 0) := by
        simpa only [ zero_mul ] using tendsto_one_div_add_atTop_nhds_zero_nat.mul_const (r / 2)
      dsimp only [h_seq]
      simpa only [Function.comp_def, Complex.ofReal_zero] using
        (Complex.continuous_ofReal.tendsto 0).comp hR0
    have hMeasDeriv : MeasureTheory.AEStronglyMeasurable (fun t => deriv (G t) z₀)
        (MeasureTheory.volume.restrict (Set.uIoc (0 : ℝ) 1)) := by
      refine aestronglyMeasurable_of_tendsto_ae Filter.atTop
        (f := fun (n : ℕ) (t : ℝ) => (h_seq n)⁻¹ • (G t (z₀ + h_seq n) - G t z₀)) ?_ ?_
      · intro n
        exact ((hMeas (z₀ + h_seq n) (hh_mem n)).sub (hMeas z₀ hz₀)).const_smul (h_seq n)⁻¹
      · filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_uIoc] with t ht
        have htI : t ∈ Set.Icc (0 : ℝ) 1 := huIoc_sub ht
        have hda : HasDerivAt (G t) (deriv (G t) z₀) z₀ :=
          ((hHolo t htI).differentiableAt ((hOpen σ').mem_nhds hz₀)).hasDerivAt
        exact (hasDerivAt_iff_tendsto_slope_zero.mp hda).comp hh_tendsto
    
    have hBallSubU : Metric.ball z₀ r ⊆ horizStrip σ' :=
      fun w hw => hBall_sub (Metric.ball_subset_ball (by dsimp [r]; linarith) hw)
    have hCauchy : ∀ t ∈ Set.Icc (0 : ℝ) 1, ∀ w ∈ Metric.ball z₀ r,
        ‖deriv (G t) w‖ ≤ M / r := by
      intro t htI w hw
      have hw_lt : dist w z₀ < r := Metric.mem_ball.mp hw
      have hcb_sub : Metric.closedBall w r ⊆ horizStrip σ' := by
        intro ζ hζ
        apply hBall_sub
        rw [Metric.mem_ball]
        have hζ_le : dist ζ w ≤ r := Metric.mem_closedBall.mp hζ
        calc
          dist ζ z₀ ≤ dist ζ w + dist w z₀ := dist_triangle ζ w z₀
          _ < r + r := add_lt_add_of_le_of_lt hζ_le hw_lt
          _ < ε := by dsimp [r]; linarith
      have hDiffCont : DiffContOnCl ℂ (G t) (Metric.ball w r) :=
        (hHolo t htI).diffContOnCl_ball hcb_sub
      exact Complex.norm_deriv_le_of_forall_mem_sphere_norm_le hr_pos hDiffCont
