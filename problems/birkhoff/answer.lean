        · intro i hi
          rw [Finset.mem_filter] at hi
          exact ⟨⟨i.1 - 1, by have := i.2; omega⟩, Finset.mem_univ _, Fin.ext (by dsimp; omega)⟩
        · intro r _; rfl
      rw [Finset.sum_add_distrib, h_sum1, h_sum2, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun r _ => ?_
      dsimp only [lcJetGrad2D, E_plus_low, E_minus_low]
      rw [add_mul]
    have h_grad_low_vb : ∀ r : Fin (k - 1),
        lineCoreVanishesBelow (M - 1) (lcJetGrad2D h_low S_ser C_ser α_trunc r) := by
      intro r
      have h_diff_vb : lineCoreVanishesBelow (M - 1)
          (lcJetGrad2D h_low S_ser C_ser α_ser r -
            lcJetGrad2D h_low S_ser C_ser α_trunc r) := by
        have h_prod_vb : ∀ (A₁ A₂ B₁ B₂ : MvPowerSeries (Fin 2) ℂ),
            lineCoreVanishesBelow (M - 1) (A₁ - A₂) →
            lineCoreVanishesBelow (M - 1) (B₁ - B₂) →
            lineCoreVanishesBelow (M - 1) (A₁ * B₁ - A₂ * B₂) := by
          intro A₁ A₂ B₁ B₂ hA hB
          have h_id : A₁ * B₁ - A₂ * B₂ = (A₁ - A₂) * B₁ + A₂ * (B₁ - B₂) := by ring
          rw [h_id]
          have h1 : lineCoreVanishesBelow (M - 1) ((A₁ - A₂) * B₁) := by
            simpa using hSub.vanishesBelow_mul hA (h_vb_zero B₁)
          have h2 : lineCoreVanishesBelow (M - 1) (A₂ * (B₁ - B₂)) := by
            simpa using hSub.vanishesBelow_mul (h_vb_zero A₂) hB
          exact h_vb_add h1 h2
        have h_mid_vb : ∀ i : Fin k,
            lineCoreVanishesBelow (M - 1) (lcJetMid2D α_ser i - lcJetMid2D α_trunc i) := by
          intro i
          have h_eq : lcJetMid2D α_ser i - lcJetMid2D α_trunc i = lcJetMid2D Δ i := by
            ext u; simp only [lcJetMid2D, Δ, MvPowerSeries.coeff_C_mul, map_add, map_sub]; ring
          rw [h_eq]
          exact h_vb_C_mul _ (h_vb_add (hΔ_vb i.castSucc) (hΔ_vb i.succ))
        have h_step_vb : ∀ i : Fin k,
            lineCoreVanishesBelow (M - 1)
              (lcJetHalfStep2D α_ser i - lcJetHalfStep2D α_trunc i) := by
          intro i
          have h_eq : lcJetHalfStep2D α_ser i - lcJetHalfStep2D α_trunc i =
              lcJetHalfStep2D Δ i := by
            ext u
            simp only [lcJetHalfStep2D, Δ, MvPowerSeries.coeff_C_mul, map_sub]
            ring
          rw [h_eq]
          exact h_vb_C_mul _ (h_vb_sub (hΔ_vb i.succ) (hΔ_vb i.castSucc))
        let i_L : Fin k := ⟨r.1, by have := r.2; omega⟩
        let i_R : Fin k := ⟨r.1 + 1, by have := r.2; omega⟩
        have h_rew :
            lcJetGrad2D h_low S_ser C_ser α_ser r -
              lcJetGrad2D h_low S_ser C_ser α_trunc r =
            ((compPowerSeries2D (PowerSeries.derivative (h_low i_L)) (lcJetMid2D α_ser i_L) *
                compPowerSeries2D (S_ser i_L) (lcJetHalfStep2D α_ser i_L) -
              compPowerSeries2D (PowerSeries.derivative (h_low i_L)) (lcJetMid2D α_trunc i_L) *
                compPowerSeries2D (S_ser i_L) (lcJetHalfStep2D α_trunc i_L)) +
             (compPowerSeries2D (h_low i_L) (lcJetMid2D α_ser i_L) *
                compPowerSeries2D (C_ser i_L) (lcJetHalfStep2D α_ser i_L) -
              compPowerSeries2D (h_low i_L) (lcJetMid2D α_trunc i_L) *
                compPowerSeries2D (C_ser i_L) (lcJetHalfStep2D α_trunc i_L))) +
            ((compPowerSeries2D (PowerSeries.derivative (h_low i_R)) (lcJetMid2D α_ser i_R) *
                compPowerSeries2D (S_ser i_R) (lcJetHalfStep2D α_ser i_R) -
              compPowerSeries2D (PowerSeries.derivative (h_low i_R)) (lcJetMid2D α_trunc i_R) *
                compPowerSeries2D (S_ser i_R) (lcJetHalfStep2D α_trunc i_R)) -
             (compPowerSeries2D (h_low i_R) (lcJetMid2D α_ser i_R) *
                compPowerSeries2D (C_ser i_R) (lcJetHalfStep2D α_ser i_R) -
              compPowerSeries2D (h_low i_R) (lcJetMid2D α_trunc i_R) *
                compPowerSeries2D (C_ser i_R) (lcJetHalfStep2D α_trunc i_R))) := by
          unfold lcJetGrad2D lcJetEdgePlus2D lcJetEdgeMinus2D
          dsimp only
          ring
        rw [h_rew]
        exact h_vb_add
          (h_vb_add
            (h_prod_vb _ _ _ _ (h_vb_comp_sub _ _ _ _ (h_mid_vb i_L))
              (h_vb_comp_sub _ _ _ _ (h_step_vb i_L)))
            (h_prod_vb _ _ _ _ (h_vb_comp_sub _ _ _ _ (h_mid_vb i_L))
              (h_vb_comp_sub _ _ _ _ (h_step_vb i_L))))
          (h_vb_sub
            (h_prod_vb _ _ _ _ (h_vb_comp_sub _ _ _ _ (h_mid_vb i_R))
              (h_vb_comp_sub _ _ _ _ (h_step_vb i_R)))
            (h_prod_vb _ _ _ _ (h_vb_comp_sub _ _ _ _ (h_mid_vb i_R))
              (h_vb_comp_sub _ _ _ _ (h_step_vb i_R))))
      have h_ser_vb : lineCoreVanishesBelow (M - 1) (lcJetGrad2D h_low S_ser C_ser α_ser r) := by
        intro u hu
        have h_prod_eq : ∀ (A₁ A₂ B_ser : MvPowerSeries (Fin 2) ℂ),
            (∀ w : Fin 2 →₀ ℕ, w 0 + w 1 < M - 1 →
              MvPowerSeries.coeff w A₁ = MvPowerSeries.coeff w A₂) →
            MvPowerSeries.coeff u (A₁ * B_ser) = MvPowerSeries.coeff u (A₂ * B_ser) := by
          intro A₁ A₂ B_ser hA
          have hvbA : lineCoreVanishesBelow (M - 1) (A₁ - A₂) := by
            intro w hw; rw [map_sub, hA w hw, sub_self]
          have hvbP : lineCoreVanishesBelow (M - 1) ((A₁ - A₂) * B_ser) := by
            simpa using hSub.vanishesBelow_mul hvbA (h_vb_zero B_ser)
          have h0 := hvbP u hu
          rw [sub_mul, map_sub] at h0
          exact sub_eq_zero.mp h0
        have h_eq : MvPowerSeries.coeff u (lcJetGrad2D h_low S_ser C_ser α_ser r) =
            MvPowerSeries.coeff u (lcJetGrad2D h_ser S_ser C_ser α_ser r) := by
          unfold lcJetGrad2D lcJetEdgePlus2D lcJetEdgeMinus2D
          simp only [map_add, map_sub]
          have hM1 : (M - 2) + 1 = M - 1 := by omega
          congr 1
          · congr 1
            · exact h_prod_eq _ _ _ (fun w hw => by
                dsimp only [h_low]
                rw [← hM1]
                exact h_comp_deriv_trunc1D (M - 2) (h_ser _) _ w (by omega))
            · exact h_prod_eq _ _ _ (fun w hw =>
                h_comp_trunc1D (M - 1) (h_ser _) _ w (by omega))
          · congr 1
            · exact h_prod_eq _ _ _ (fun w hw => by
                dsimp only [h_low]
                rw [← hM1]
                exact h_comp_deriv_trunc1D (M - 2) (h_ser _) _ w (by omega))
            · exact h_prod_eq _ _ _ (fun w hw =>
                h_comp_trunc1D (M - 1) (h_ser _) _ w (by omega))
        rw [h_eq, hGrad_tay r, map_zero]
      intro u hu
      have h1 := h_ser_vb u hu
      have h2 := h_diff_vb u hu
      rw [map_sub] at h2
      linear_combination h1 - h2
    have h_env_cancel : ∀ d : Fin 2 →₀ ℕ, d 0 + d 1 = M →
        MvPowerSeries.coeff d (lcJetAction2D h_low S_ser α_ser) =
          MvPowerSeries.coeff d (lcJetAction2D h_low S_ser α_trunc) := by
      intro d hdM
      have h_rem_sum : MvPowerSeries.coeff d
          (lcJetAction2D h_low S_ser α_ser - lcJetAction2D h_low S_ser α_trunc -
            ∑ i : Fin k, (E_plus_low i * Δ i.succ + E_minus_low i * Δ i.castSucc)) = 0 := by
        unfold lcJetAction2D
        rw [← Finset.sum_sub_distrib, ← Finset.sum_sub_distrib, map_sum]
        exact Finset.sum_eq_zero fun i _ => h_edge_taylor i d (by omega)
      have h_grad_sum : MvPowerSeries.coeff d
          (∑ r : Fin (k - 1),
            lcJetGrad2D h_low S_ser C_ser α_trunc r *
              Δ ⟨r.1 + 1, by have := r.2; omega⟩) = 0 := by
        rw [map_sum]
        refine Finset.sum_eq_zero fun r _ => ?_
        have hvb := hSub.vanishesBelow_mul (h_grad_low_vb r)
          (hΔ_vb ⟨r.1 + 1, by have := r.2; omega⟩)
        exact hvb d (by omega)
      rw [h_sbp] at h_rem_sum
      simp only [map_sub] at h_rem_sum
      linear_combination h_rem_sum + h_grad_sum
    
    let ψ_a : Fin k → ℂ := fun i => MvPowerSeries.coeff (lineCoreIdx2D 1 0) (ψ_ser i)
    let ψ_d : Fin k → ℂ := fun i => MvPowerSeries.coeff (lineCoreIdx2D 0 1) (ψ_ser i)
    let ρ : Fin k → ℂ := fun i => ψ_d i / ψ_a i
    have hψ_ad_mem : ∀ i : Fin k, ψ_a i ∈ F_val ∧ ψ_d i ∈ F_val := by
      intro i
      have h10 : lineCoreIdx2D 1 0 0 + lineCoreIdx2D 1 0 1 ≤ M - 2 := by
        rw [(h_idx2D 1 0).1, (h_idx2D 1 0).2]; omega
      have h01 : lineCoreIdx2D 0 1 0 + lineCoreIdx2D 0 1 1 ≤ M - 2 := by
        rw [(h_idx2D 0 1).1, (h_idx2D 0 1).2]; omega
      dsimp only [ψ_a, ψ_d, ψ_ser, lcJetMid2D]
      rw [MvPowerSeries.coeff_C_mul, MvPowerSeries.coeff_C_mul, map_add, map_add]
      exact ⟨F_val.mul_mem h_half_mem
          (F_val.add_mem (hAngLow i.castSucc _ h10) (hAngLow i.succ _ h10)),
        F_val.mul_mem h_half_mem
          (F_val.add_mem (hAngLow i.castSucc _ h01) (hAngLow i.succ _ h01))⟩
    have hρ_mem : ∀ i : Fin k, ρ i ∈ F_val :=
      fun i => F_val.div_mem (hψ_ad_mem i).2 (hψ_ad_mem i).1
    let V_mat : Matrix (Fin k) (Fin k) ℂ := (Matrix.vandermonde ρ)ᵀ
    let x_jet : Fin k → ℂ :=
      fun i => 2 * s_d i * (ψ_a i) ^ M * PowerSeries.coeff M (h_ser i)
    let d_idx : Fin k → (Fin 2 →₀ ℕ) := fun ν => lineCoreIdx2D (M - ν.1) ν.1
    let b_jet : Fin k → ℂ := fun ν =>
      (MvPowerSeries.coeff (d_idx ν) (lcJetAction2D h_ser S_ser α_ser) -
        MvPowerSeries.coeff (d_idx ν) (lcJetAction2D h_low S_ser α_trunc)) /
        (M.choose ν.1 : ℂ)
    have hV_mem : ∀ ν i : Fin k, V_mat ν i ∈ F_val := by
      intro ν i
      change (ρ i) ^ ν.1 ∈ F_val
      exact F_val.pow_mem (hρ_mem i) ν.1
    have hV_det : V_mat.det ≠ 0 := by
      rw [Matrix.det_transpose]
      exact Matrix.det_vandermonde_ne_zero_iff.mpr hρ_inj
    have hb_jet_mem : ∀ ν : Fin k, b_jet ν ∈ F_val := by
      intro ν
      have hd_deg : d_idx ν 0 + d_idx ν 1 = M := by
        dsimp only [d_idx]
        rw [(h_idx2D _ _).1, (h_idx2D _ _).2]
        have := ν.2; omega
      have hd_ne : d_idx ν ≠ 0 := by
        intro h0
        rw [h0] at hd_deg
        simp at hd_deg
        omega
      exact F_val.div_mem
        (F_val.sub_mem (hActF (d_idx ν) hd_ne) (h_act_tr_mem (d_idx ν)))
        (h_nat_mem (M.choose ν.1))
    have hVx_eq : V_mat.mulVec x_jet = b_jet := by
      ext ν
      have hν_le : ν.1 ≤ M := by have := ν.2; omega
      have hd_deg : d_idx ν 0 + d_idx ν 1 = M := by
        dsimp only [d_idx]
        rw [(h_idx2D _ _).1, (h_idx2D _ _).2]
        omega
      have hchoose_ne : (M.choose ν.1 : ℂ) ≠ 0 :=
        Nat.cast_ne_zero.mpr (ne_of_gt (Nat.choose_pos hν_le))
      have h_pow_eq : ∀ i : Fin k,
          MvPowerSeries.coeff (d_idx ν) ((ψ_ser i) ^ M) =
            (M.choose ν.1 : ℂ) * (ψ_a i) ^ M * (ρ i) ^ ν.1 := by
        intro i
        rw [hSub.coeff_pow_linear (by omega : 1 ≤ M) hν_le (hψ_c0 i)]
        have h_pow_split : (ψ_a i) ^ M = (ψ_a i) ^ (M - ν.1) * (ψ_a i) ^ ν.1 := by
          rw [← pow_add, Nat.sub_add_cancel hν_le]
        have hψa_pow_ne : (ψ_a i) ^ ν.1 ≠ 0 := pow_ne_zero ν.1 (hψa_ne i)
        have h_rho_pow : (ψ_a i) ^ ν.1 * (ρ i) ^ ν.1 = (ψ_d i) ^ ν.1 := by
          dsimp only [ρ]
          rw [div_pow, mul_div_cancel₀ _ hψa_pow_ne]
        rw [h_pow_split]
        dsimp only [ψ_a, ψ_d] at h_rho_pow ⊢
        calc (M.choose ν.1 : ℂ) *
              (MvPowerSeries.coeff (lineCoreIdx2D 1 0) (ψ_ser i)) ^ (M - ν.1) *
              (MvPowerSeries.coeff (lineCoreIdx2D 0 1) (ψ_ser i)) ^ ν.1
            = (M.choose ν.1 : ℂ) *
              (MvPowerSeries.coeff (lineCoreIdx2D 1 0) (ψ_ser i)) ^ (M - ν.1) *
              ((MvPowerSeries.coeff (lineCoreIdx2D 1 0) (ψ_ser i)) ^ ν.1 * (ρ i) ^ ν.1) := by
              rw [h_rho_pow]
          _ = _ := by ring
      have h_sum_eq :
          MvPowerSeries.coeff (d_idx ν) (lcJetAction2D h_ser S_ser α_ser) -
            MvPowerSeries.coeff (d_idx ν) (lcJetAction2D h_low S_ser α_trunc) =
          (M.choose ν.1 : ℂ) * (V_mat.mulVec x_jet) ν := by
        rw [h_act_split (d_idx ν) hd_deg, h_env_cancel (d_idx ν) hd_deg, add_sub_cancel_left]
        simp only [Matrix.mulVec, dotProduct, V_mat, Matrix.transpose_apply,
          Matrix.vandermonde_apply, x_jet, Finset.mul_sum, h_pow_eq]
        refine Finset.sum_congr rfl fun i _ => ?_
        ring
      dsimp only [b_jet]
      rw [h_sum_eq, mul_div_cancel_left₀ _ hchoose_ne]
    have hx_jet_mem : ∀ i : Fin k, x_jet i ∈ F_val :=
      hSub.mulVec_mem F_val hV_mem hV_det hb_jet_mem hVx_eq
    intro i
    let denom : ℂ := 2 * s_d i * (ψ_a i) ^ M
    have hdenom_mem : denom ∈ F_val :=
      F_val.mul_mem (F_val.mul_mem h2_mem (h_sd_mem i).1) (F_val.pow_mem (hψ_ad_mem i).1 M)
    have hdenom_ne : denom ≠ 0 :=
      mul_ne_zero (mul_ne_zero two_ne_zero (h_sd_ne i)) (pow_ne_zero M (hψa_ne i))
    have h_div : x_jet i / denom = PowerSeries.coeff M (h_ser i) :=
      mul_div_cancel_left₀ _ hdenom_ne
    rw [← h_div]
    exact F_val.div_mem (hx_jet_mem i) hdenom_mem
  
  have hAllCoeff : ∀ (M : ℕ) (i : Fin k), PowerSeries.coeff M (h_ser i) ∈ F_val := by
    intro M
    induction M using Nat.strong_induction_on with
    | h M ih =>
        by_cases hM : M ≤ max 2 k
        · exact fun i => hCoreJets i M hM
        · exact hVandStep M (Nat.lt_of_not_ge hM) (fun i m hm => ih m hm i)
  refine ⟨?_, ?_⟩
  · intro i m
    have hm_coeff : iteratedDeriv m C.h_ℂ (G.ψ_fn i p₁) / (m.factorial : ℂ) ∈ F_val := by
      simpa [h_ser, lineCoreHoloTaylor1D] using hAllCoeff m i
    have hmf_ne : (m.factorial : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero m)
    have h_eq : iteratedDeriv m C.h_ℂ (G.ψ_fn i p₁) / (m.factorial : ℂ) * (m.factorial : ℂ) =
        iteratedDeriv m C.h_ℂ (G.ψ_fn i p₁) := div_mul_cancel₀ _ hmf_ne
    rw [← h_eq]
    exact F_val.mul_mem hm_coeff (h_nat_mem m.factorial)
  · intro r d
    exact hStatRec (d 0 + d 1) (fun i m _ => hAllCoeff m i) r d le_rfl

theorem line_core_vandermonde_elimination (Ω : Set Plane)
    (C : AnalyticGlancingCollar Ω)
    (B : BaseCollarAndCramerData C)
    (k : ℕ) (hk : 2 ≤ k)
    (G : LineGlancingChartData C B k)
    (hAlg : AlgebraicLiftingToolkit)
    (a₁ δ₁ : ℝ)
    (ha₁ : a₁ ∈ Set.Ioo (G.a₀ - G.R / 4) (G.a₀ + G.R / 4))
    (hδ₁ : δ₁ ∈ Set.Ioo 0 G.δ_star) :
    Nonempty (LineCoreEliminationData C B k G a₁ δ₁) :=
by
  have hTay : LineCoreTaylor2DToolkit :=
    line_core_taylor2d_toolkit (@B.iterDerivYT_holo)
  have hSub : LineCoreSubfieldSeriesToolkit :=
    line_core_subfield_series_toolkit
  let p₁ : ℂ × ℂ := ((a₁ : ℂ), (δ₁ : ℂ))
  let K_end : Subfield ℂ := lineCoreEndpointField C k G.Ψ a₁ δ₁
  let coreTuple : Fin (lineCoreCard k) → ℂ := lineCoreTuple C B k G a₁ δ₁
  let F_val : Subfield ℂ := Subfield.closure ((K_end : Set ℂ) ∪ Set.range coreTuple)
  obtain ⟨hAlgOverPt, hActPos⟩ :=
    line_core_endpoint_radical_and_action_taylor Ω C B k hk G hAlg hTay hSub a₁ δ₁ ha₁ hδ₁
  obtain ⟨hJetsMem, hAngMem⟩ :=
    line_core_vandermonde_jet_and_angle_elimination Ω C B k hk G hTay hSub a₁ δ₁ ha₁ hδ₁
      K_end hActPos
  have h_rad_mem : ∀ r : Fin 6, lineCoreRadicals C k G.Ψ a₁ δ₁ r ∈ K_end :=
    fun r => Subfield.subset_closure (Or.inr ⟨r, rfl⟩)
  have hHalfMem : ∀ r : Fin (k + 1),
      Complex.cos (G.α_fn r p₁ / 2) ∈ F_val ∧
      Complex.sin (G.α_fn r p₁ / 2) ∈ F_val := by
    intro r
    let e := Fintype.equivFin (LineCoreIdx k)
    constructor
    · have h_eq : coreTuple (e (Sum.inl (r, false))) = Complex.cos (G.α_fn r p₁ / 2) := by
        change lineCoreTuple C B k G a₁ δ₁ (e (Sum.inl (r, false))) = _
        unfold lineCoreTuple
        rw [e.symm_apply_apply]
      rw [← h_eq]
      exact Subfield.subset_closure (Or.inr ⟨e (Sum.inl (r, false)), rfl⟩)
    · have h_eq : coreTuple (e (Sum.inl (r, true))) = Complex.sin (G.α_fn r p₁ / 2) := by
        change lineCoreTuple C B k G a₁ δ₁ (e (Sum.inl (r, true))) = _
        unfold lineCoreTuple
        rw [e.symm_apply_apply]
      rw [← h_eq]
      exact Subfield.subset_closure (Or.inr ⟨e (Sum.inl (r, true)), rfl⟩)
  have hCoreSub :
      Set.range coreTuple ⊆
        { z : ℂ |
          (∃ r : Fin (k + 1),
            z = Complex.cos (G.α_fn r p₁ / 2) ∨
            z = Complex.sin (G.α_fn r p₁ / 2)) ∨
          (∃ (i : Fin k) (m : ℕ),
            z = iteratedDeriv m C.h_ℂ (G.ψ_fn i p₁)) } := by
    rintro z ⟨idx, rfl⟩
    change lineCoreTuple C B k G a₁ δ₁ idx ∈ _
    unfold lineCoreTuple
    rcases h_symm : (Fintype.equivFin (LineCoreIdx k)).symm idx with ⟨r, b⟩ | ⟨i, m⟩
    · cases b
      · exact Or.inl ⟨r, Or.inl rfl⟩
      · exact Or.inl ⟨r, Or.inr rfl⟩
    · exact Or.inr ⟨i, (m : ℕ), rfl⟩
  have h2_mem : (2 : ℂ) ∈ F_val := by
    rw [← one_add_one_eq_two]
    exact F_val.add_mem F_val.one_mem F_val.one_mem
  have hFullMem : ∀ r : Fin (k + 1),
      Complex.cos (G.α_fn r p₁) ∈ F_val ∧
      Complex.sin (G.α_fn r p₁) ∈ F_val := by
    intro r
    have h_two : G.α_fn r p₁ = 2 * (G.α_fn r p₁ / 2) := by ring
    constructor
    · rw [h_two, Complex.cos_two_mul']
      exact F_val.sub_mem (F_val.pow_mem (hHalfMem r).1 2) (F_val.pow_mem (hHalfMem r).2 2)
    · rw [h_two, Complex.sin_two_mul]
      exact F_val.mul_mem (F_val.mul_mem h2_mem (hHalfMem r).2) (hHalfMem r).1
  have hStepMem : ∀ i : Fin k,
      Complex.cos (G.d_fn i p₁) ∈ F_val ∧
      Complex.sin (G.d_fn i p₁) ∈ F_val := by
    intro i
    have h_dfn : G.d_fn i p₁ = G.α_fn i.succ p₁ / 2 - G.α_fn i.castSucc p₁ / 2 := by
      change (G.α_fn i.succ p₁ - G.α_fn i.castSucc p₁) / 2 = _
      exact sub_div _ _ _
    constructor
    · rw [h_dfn, Complex.cos_sub]
      exact F_val.add_mem
        (F_val.mul_mem (hHalfMem i.succ).1 (hHalfMem i.castSucc).1)
        (F_val.mul_mem (hHalfMem i.succ).2 (hHalfMem i.castSucc).2)
    · rw [h_dfn, Complex.sin_sub]
      exact F_val.sub_mem
        (F_val.mul_mem (hHalfMem i.succ).2 (hHalfMem i.castSucc).1)
        (F_val.mul_mem (hHalfMem i.succ).1 (hHalfMem i.castSucc).2)
  have hActValMem : G.A_line p₁ ∈ F_val := by
    change (∑ i : Fin k, 2 * C.h_ℂ (G.ψ_fn i p₁) * Complex.sin (G.d_fn i p₁)) ∈ F_val
    refine F_val.sum_mem fun i _ => ?_
    have hh0 : C.h_ℂ (G.ψ_fn i p₁) ∈ F_val := by
      simpa using hJetsMem i 0
    exact F_val.mul_mem (F_val.mul_mem h2_mem hh0) (hStepMem i).2
  have hDualMem : ∀ j : ℕ, 0 < j → j < k → ∀ ι : Fin 2,
      glancingDualLine C ((G.Ψ p₁).1 + (j : ℂ) * (G.Ψ p₁).2) (G.Ψ p₁).2 ι ∈ F_val := by
    intro j _hj0 hjk ι
    let q₁ : ℂ × ℂ := G.Ψ p₁
    let i_j : Fin k := ⟨j, hjk⟩
    have hθ₁ : glancingTheta C (q₁.1 + (j : ℂ) * q₁.2) q₁.2 = G.α_fn i_j.castSucc p₁ := rfl
    have hθ₂ : glancingTheta C ((q₁.1 + (j : ℂ) * q₁.2) + q₁.2) q₁.2 = G.α_fn i_j.succ p₁ := by
      have h_arg : (q₁.1 + (j : ℂ) * q₁.2) + q₁.2 = q₁.1 + ((j + 1 : ℕ) : ℂ) * q₁.2 := by
        push_cast
        ring
      change glancingTheta C ((q₁.1 + (j : ℂ) * q₁.2) + q₁.2) q₁.2 =
        glancingTheta C (q₁.1 + ((j + 1 : ℕ) : ℂ) * q₁.2) q₁.2
      rw [h_arg]
    have hOffMem : glancingOffset C (q₁.1 + (j : ℂ) * q₁.2) q₁.2 ∈ F_val := by
      unfold glancingOffset supportAction1_ℂ
      rw [hθ₁, hθ₂]
      change -(deriv C.h_ℂ (G.ψ_fn i_j p₁) * Complex.sin (G.d_fn i_j p₁) -
        C.h_ℂ (G.ψ_fn i_j p₁) * Complex.cos (G.d_fn i_j p₁)) ∈ F_val
      have hh0 : C.h_ℂ (G.ψ_fn i_j p₁) ∈ F_val := by
        simpa using hJetsMem i_j 0
      have hh1 : deriv C.h_ℂ (G.ψ_fn i_j p₁) ∈ F_val := by
        simpa [iteratedDeriv_one] using hJetsMem i_j 1
      exact F_val.neg_mem (F_val.sub_mem
        (F_val.mul_mem hh1 (hStepMem i_j).2)
        (F_val.mul_mem hh0 (hStepMem i_j).1))
    fin_cases ι
    · change Complex.cos (glancingTheta C (q₁.1 + (j : ℂ) * q₁.2) q₁.2) /
          glancingOffset C (q₁.1 + (j : ℂ) * q₁.2) q₁.2 ∈ F_val
      rw [hθ₁]
      exact F_val.div_mem (hFullMem i_j.castSucc).1 hOffMem
    · change Complex.sin (glancingTheta C (q₁.1 + (j : ℂ) * q₁.2) q₁.2) /
          glancingOffset C (q₁.1 + (j : ℂ) * q₁.2) q₁.2 ∈ F_val
      rw [hθ₁]
      exact F_val.div_mem (hFullMem i_j.castSucc).2 hOffMem
  exact ⟨{
    K_end := K_end
    N_core := lineCoreCard k
    coreTuple := coreTuple
    K_end_alg_over_pt := hAlgOverPt
    cos_half_zero_mem := by simpa [lineCoreRadicals] using h_rad_mem 2
    sin_half_zero_mem := by simpa [lineCoreRadicals] using h_rad_mem 3
    cos_half_last_mem := by simpa [lineCoreRadicals] using h_rad_mem 4
    sin_half_last_mem := by simpa [lineCoreRadicals] using h_rad_mem 5
    action_pos_taylor_mem := hActPos
    action_val_mem := hActValMem
    half_angles_mem := hHalfMem
    support_jets_mem := hJetsMem
    angle_taylor_mem := hAngMem
    core_entries_subset := hCoreSub
    dualLine_mem_F_val := hDualMem
  }⟩

theorem line_arc_jet_and_taylor_toolkit : LineArcJetAndTaylorToolkit :=
by
  
  
  
  have hPartA :
      (∀ (p₀ : ℂ × ℂ) (c : ℂ), taylor2D (fun _ => c) p₀ = MvPowerSeries.C c) ∧
      (∀ (p₀ : ℂ × ℂ),
        centeredTaylor2D Prod.fst p₀ = MvPowerSeries.X 0 ∧
        centeredTaylor2D Prod.snd p₀ = MvPowerSeries.X 1) ∧
      (∀ {U : Set (ℂ × ℂ)}, IsOpen U → ∀ {p₀ : ℂ × ℂ}, p₀ ∈ U →
        ∀ {f₁ f₂ : ℂ × ℂ → ℂ}, (∀ p ∈ U, f₁ p = f₂ p) → taylor2D f₁ p₀ = taylor2D f₂ p₀) ∧
      (∀ {U : Set (ℂ × ℂ)}, IsOpen U → ∀ {p₀ : ℂ × ℂ}, p₀ ∈ U →
        ∀ {f g : ℂ × ℂ → ℂ}, DifferentiableOn ℂ f U → DifferentiableOn ℂ g U →
          taylor2D (fun p => f p + g p) p₀ = taylor2D f p₀ + taylor2D g p₀ ∧
          taylor2D (fun p => f p - g p) p₀ = taylor2D f p₀ - taylor2D g p₀ ∧
          taylor2D (fun p => f p * g p) p₀ = taylor2D f p₀ * taylor2D g p₀) ∧
      (∀ {U : Set (ℂ × ℂ)} {W : Set ℂ}, IsOpen U → IsOpen W →
        ∀ {p₀ : ℂ × ℂ}, p₀ ∈ U → ∀ {ψ : ℂ × ℂ → ℂ} {g : ℂ → ℂ},
          DifferentiableOn ℂ ψ U → DifferentiableOn ℂ g W → (∀ p ∈ U, ψ p ∈ W) →
          taylor2D (fun p => g (ψ p)) p₀ =
            compPowerSeries2D (lineArcHoloTaylor1D g (ψ p₀)) (centeredTaylor2D ψ p₀)) := by
    let π₁ : (ℂ × ℂ) →L[ℂ] ℂ :=
      { toLinearMap := { toFun := Prod.fst, map_add' := fun _ _ => rfl, map_smul' := fun _ _ => rfl }
        cont := continuous_fst }
    let π₂ : (ℂ × ℂ) →L[ℂ] ℂ :=
      { toLinearMap := { toFun := Prod.snd, map_add' := fun _ _ => rfl, map_smul' := fun _ _ => rfl }
        cont := continuous_snd }

    have hparam_int_holo : ∀ {S : Set (ℂ × ℂ)} {x₀ : ℂ × ℂ} {F : (ℂ × ℂ) → ℝ → ℂ}
        {F' : (ℂ × ℂ) → ℝ → (ℂ × ℂ) →L[ℂ] ℂ} {B_val : ℝ},
        IsOpen S → x₀ ∈ S →
        (∀ x ∈ S, Continuous (F x)) →
        MeasureTheory.AEStronglyMeasurable (F' x₀)
          (MeasureTheory.volume.restrict (Set.uIoc 0 (2 * Real.pi))) →
        (∀ t ∈ Set.uIoc 0 (2 * Real.pi), ∀ x ∈ S, ‖F' x t‖ ≤ B_val) →
        (∀ t ∈ Set.uIoc 0 (2 * Real.pi), ∀ x ∈ S, HasFDerivAt (fun y => F y t) (F' x t) x) →
        DifferentiableAt ℂ (fun x => ∫ t in (0 : ℝ)..(2 * Real.pi), F x t) x₀ := by
      intro S x₀ F F' B_val hS hx₀ hF_cont hF'_meas hF'_bnd hF'_deriv
      have hS_nhds : S ∈ nhds x₀ := hS.mem_nhds hx₀
      have hF_meas : ∀ᶠ x in nhds x₀,
          MeasureTheory.AEStronglyMeasurable (F x)
            (MeasureTheory.volume.restrict (Set.uIoc 0 (2 * Real.pi))) :=
        Filter.Eventually.mono hS_nhds fun x hx => (hF_cont x hx).aestronglyMeasurable
      have hF_int : IntervalIntegrable (F x₀) MeasureTheory.volume 0 (2 * Real.pi) :=
        (hF_cont x₀ hx₀).intervalIntegrable 0 (2 * Real.pi)
      have hB_int : IntervalIntegrable (fun _ : ℝ => B_val) MeasureTheory.volume 0 (2 * Real.pi) :=
        intervalIntegrable_const
      exact (intervalIntegral.hasFDerivAt_integral_of_dominated_of_fderiv_le (𝕜 := ℂ)
        hS_nhds hF_meas hF_int hF'_meas
        (Filter.Eventually.of_forall hF'_bnd) hB_int
        (Filter.Eventually.of_forall hF'_deriv)).differentiableAt

    have hpderivA_holo : ∀ {U : Set (ℂ × ℂ)}, IsOpen U → ∀ {f : ℂ × ℂ → ℂ},
        DifferentiableOn ℂ f U → DifferentiableOn ℂ (pderivA f) U := by
      intro U hU f hf p₀ hp₀
      obtain ⟨r, hr_pos, hball_sub⟩ := Metric.isOpen_iff.mp hU p₀ hp₀
      let R : ℝ := r / 2
      have hR_eq : R = r / 2 := rfl
      have hR_pos : 0 < R := half_pos hr_pos
      let B : Set (ℂ × ℂ) := Metric.ball p₀ (R / 4)
      have hB_open : IsOpen B := Metric.isOpen_ball
      have hp₀_B : p₀ ∈ B := Metric.mem_ball_self (by positivity)
      have hmem_U : ∀ z w : ℂ, dist z p₀.1 < 3 * R / 2 → dist w p₀.2 < 3 * R / 2 → (z, w) ∈ U := by
        intro z w hz hw
        apply hball_sub
        rw [Metric.mem_ball, Prod.dist_eq]
        exact max_lt (by dsimp only; linarith) (by dsimp only; linarith)
      let K : Set (ℂ × ℂ) := Metric.closedBall p₀.1 R ×ˢ Metric.closedBall p₀.2 (R / 2)
      have hK_sub : K ⊆ U := by
        rintro ⟨z, w⟩ ⟨hz, hw⟩
        rw [Metric.mem_closedBall] at hz hw
        exact hmem_U z w (by linarith) (by linarith)
      have hK_comp : IsCompact K :=
        (isCompact_closedBall p₀.1 R).prod (isCompact_closedBall p₀.2 (R / 2))
      obtain ⟨M₀, hM₀⟩ := hK_comp.exists_bound_of_continuousOn (hf.continuousOn.mono hK_sub)
      let M : ℝ := max M₀ 0
      have hM_nonneg : 0 ≤ M := le_max_right M₀ 0
      have hf_le_M : ∀ q ∈ K, ‖f q‖ ≤ M := fun q hq => (hM₀ q hq).trans (le_max_left M₀ 0)
      let γ : ℝ → ℂ := circleMap p₀.1 R
      have hγ_mem_cb : ∀ θ : ℝ, γ θ ∈ Metric.closedBall p₀.1 R := by
        intro θ
        exact Metric.sphere_subset_closedBall (circleMap_mem_sphere p₀.1 hR_pos.le θ)
      have hγ_dist : ∀ θ : ℝ, ∀ x ∈ B, R / 2 ≤ ‖γ θ - x.1‖ := by
        intro θ x hx
        have hx1 : ‖x.1 - p₀.1‖ < R / 4 := by
          have hlt : dist x p₀ < R / 4 := Metric.mem_ball.mp hx
          rw [Prod.dist_eq] at hlt
          simpa [dist_eq_norm] using lt_of_le_of_lt (le_max_left _ _) hlt
        have hγ_norm : ‖γ θ - p₀.1‖ = R := by
          simpa [γ, circleMap, abs_of_pos hR_pos] using norm_circleMap_zero R θ
        have htri : ‖γ θ - p₀.1‖ ≤ ‖γ θ - x.1‖ + ‖x.1 - p₀.1‖ := by
          simpa using norm_sub_le_norm_sub_add_norm_sub (γ θ) x.1 p₀.1
        linarith
      have hγ_ne : ∀ θ : ℝ, ∀ x ∈ B, γ θ - x.1 ≠ 0 := by
        intro θ x hx h0
        have hle := hγ_dist θ x hx
        rw [h0, norm_zero] at hle
        linarith
      let F : (ℂ × ℂ) → ℝ → ℂ := fun x θ =>
        deriv γ θ * (((γ θ - x.1) ^ 2)⁻¹ * f (γ θ, x.2))
      let F' : (ℂ × ℂ) → ℝ → (ℂ × ℂ) →L[ℂ] ℂ := fun x θ =>
        deriv γ θ • (π₁.smulRight (2 * ((γ θ - x.1) ^ 3)⁻¹ * f (γ θ, x.2)) +
          π₂.smulRight (((γ θ - x.1) ^ 2)⁻¹ * pderivD f (γ θ, x.2)))
      have hF_eq_cauchy : ∀ x ∈ B,
          (2 * (Real.pi : ℂ) * Complex.I)⁻¹ * (∫ θ in (0 : ℝ)..(2 * Real.pi), F x θ) = pderivA f x := by
        intro x hx
        have hx_d : dist x p₀ < R / 4 := Metric.mem_ball.mp hx
        rw [Prod.dist_eq] at hx_d
        have hx1 : dist x.1 p₀.1 < R := lt_of_le_of_lt (le_max_left _ _) (by linarith)
        have hx2 : dist x.2 p₀.2 < R / 4 := lt_of_le_of_lt (le_max_right _ _) hx_d
        let U₁ : Set ℂ := Metric.ball p₀.1 (3 * R / 2)
        have hcb_sub : Metric.closedBall p₀.1 R ⊆ U₁ := Metric.closedBall_subset_ball (by linarith)
        have hslice_holo : DifferentiableOn ℂ (fun z => f (z, x.2)) U₁ := by
          refine hf.comp (differentiable_id.prodMk (differentiable_const x.2)).differentiableOn ?_
          intro z hz
          exact hmem_U z x.2 (Metric.mem_ball.mp hz) (by linarith)
        have hcauchy :=
          Complex.two_pi_I_inv_smul_circleIntegral_sub_sq_inv_smul_of_differentiable
            Metric.isOpen_ball hcb_sub hslice_holo (Metric.mem_ball.mpr hx1)
        simpa [pderivA, circleIntegral, F, γ, smul_eq_mul, mul_assoc] using hcauchy
      have hF_cont : ∀ x ∈ B, Continuous (F x) := by
        intro x hx
        have hγ_cont : Continuous γ := continuous_circleMap p₀.1 R
        have hdγ_cont : Continuous (deriv γ) := by
          have hd : deriv γ = fun θ => circleMap 0 R θ * Complex.I := funext (deriv_circleMap p₀.1 R)
          rw [hd]
          exact (continuous_circleMap 0 R).mul continuous_const
        have hsub_cont : Continuous (fun θ => (γ θ - x.1) ^ 2) :=
          (hγ_cont.sub continuous_const).pow 2
        have hinv_cont : Continuous (fun θ => ((γ θ - x.1) ^ 2)⁻¹) :=
          hsub_cont.inv₀ fun θ => pow_ne_zero 2 (hγ_ne θ x hx)
        have hf_theta_cont : Continuous (fun θ => f (γ θ, x.2)) := by
          refine hf.continuousOn.comp_continuous (hγ_cont.prodMk continuous_const) fun θ => ?_
          apply hK_sub
          refine ⟨hγ_mem_cb θ, ?_⟩
          rw [Metric.mem_closedBall]
          have hx_d : dist x p₀ < R / 4 := Metric.mem_ball.mp hx
          rw [Prod.dist_eq] at hx_d
          have hx2 := lt_of_le_of_lt (le_max_right _ _) hx_d
          linarith
        exact hdγ_cont.mul (hinv_cont.mul hf_theta_cont)
      have hF'_deriv : ∀ θ : ℝ, ∀ x ∈ B, HasFDerivAt (fun y => F y θ) (F' x θ) x := by
        intro θ x hx
        have hne : γ θ - x.1 ≠ 0 := hγ_ne θ x hx
        have h1_1d : HasDerivAt (fun z : ℂ => ((γ θ - z) ^ 2)⁻¹) (2 * ((γ θ - x.1) ^ 3)⁻¹) x.1 := by
          have hsq : HasDerivAt (fun z : ℂ => (γ θ - z) ^ 2) (-2 * (γ θ - x.1)) x.1 := by
            have hraw := ((hasDerivAt_const x.1 (γ θ)).sub (hasDerivAt_id x.1)).pow 2
            have hfn : (((fun _ : ℂ => γ θ) - id) ^ 2) = (fun z : ℂ => (γ θ - z) ^ 2) := rfl
            rw [hfn] at hraw
            refine hraw.congr_deriv ?_
            simp
          have hinv := hsq.inv (pow_ne_zero 2 hne)
          convert hinv using 1
          have hne3 : (γ θ - x.1) ^ 3 ≠ 0 := pow_ne_zero 3 hne
          field_simp
        have h1 : HasFDerivAt (fun y : ℂ × ℂ => ((γ θ - y.1) ^ 2)⁻¹)
            (π₁.smulRight (2 * ((γ θ - x.1) ^ 3)⁻¹)) x := by
          have hc := h1_1d.comp_hasFDerivAt x π₁.hasFDerivAt
          refine hc.congr_fderiv (ContinuousLinearMap.ext fun v => ?_)
          change (2 * ((γ θ - x.1) ^ 3)⁻¹) * v.1 = v.1 * (2 * ((γ θ - x.1) ^ 3)⁻¹)
          ring
        have h2_1d : HasDerivAt (fun w : ℂ => f (γ θ, w)) (pderivD f (γ θ, x.2)) x.2 := by
          have hx_d : dist x p₀ < R / 4 := Metric.mem_ball.mp hx
          rw [Prod.dist_eq] at hx_d
          have hx2 := lt_of_le_of_lt (le_max_right _ _) hx_d
          have h_in_U : (γ θ, x.2) ∈ U := by
            apply hmem_U (γ θ) x.2
            · have hcb := Metric.mem_closedBall.mp (hγ_mem_cb θ)
              linarith
            · linarith
          have hf_at : DifferentiableAt ℂ f (γ θ, x.2) := hf.differentiableAt (hU.mem_nhds h_in_U)
          exact (hf_at.comp x.2 ((differentiableAt_const (γ θ)).prodMk differentiableAt_id)).hasDerivAt
        have h2 : HasFDerivAt (fun y : ℂ × ℂ => f (γ θ, y.2))
            (π₂.smulRight (pderivD f (γ θ, x.2))) x := by
          have hc := h2_1d.comp_hasFDerivAt x π₂.hasFDerivAt
          refine hc.congr_fderiv (ContinuousLinearMap.ext fun v => ?_)
          change pderivD f (γ θ, x.2) * v.2 = v.2 * pderivD f (γ θ, x.2)
          ring
        have hmul := (h1.mul h2).const_smul (deriv γ θ)
        refine hmul.congr_fderiv (ContinuousLinearMap.ext fun v => ?_)
        change deriv γ θ *
            (((γ θ - x.1) ^ 2)⁻¹ * (v.2 * pderivD f (γ θ, x.2)) +
              f (γ θ, x.2) * (v.1 * (2 * ((γ θ - x.1) ^ 3)⁻¹))) =
          deriv γ θ *
            (v.1 * (2 * ((γ θ - x.1) ^ 3)⁻¹ * f (γ θ, x.2)) +
              v.2 * (((γ θ - x.1) ^ 2)⁻¹ * pderivD f (γ θ, x.2)))
        ring
      have hpderivD_bnd : ∀ θ : ℝ, ∀ x ∈ B, ‖pderivD f (γ θ, x.2)‖ ≤ M / (R / 4) := by
        intro θ x hx
        have hx_d : dist x p₀ < R / 4 := Metric.mem_ball.mp hx
        rw [Prod.dist_eq] at hx_d
        have hx2 : dist x.2 p₀.2 < R / 4 := lt_of_le_of_lt (le_max_right _ _) hx_d
        have hslice_holo : DifferentiableOn ℂ (fun w => f (γ θ, w)) (Metric.ball x.2 (R / 3)) := by
          refine hf.comp ((differentiable_const (γ θ)).prodMk differentiable_id).differentiableOn ?_
          intro w hw
          apply hmem_U (γ θ) w
          · have hcb := Metric.mem_closedBall.mp (hγ_mem_cb θ)
            linarith
          · have hwd : dist w x.2 < R / 3 := Metric.mem_ball.mp hw
            have htri := dist_triangle w x.2 p₀.2
            linarith
        have hcb_sub : Metric.closedBall x.2 (R / 4) ⊆ Metric.ball x.2 (R / 3) :=
          Metric.closedBall_subset_ball (by linarith)
        have hdcc : DiffContOnCl ℂ (fun w => f (γ θ, w)) (Metric.ball x.2 (R / 4)) :=
          (hslice_holo.mono (closure_ball_subset_closedBall.trans hcb_sub)).diffContOnCl
        refine Complex.norm_deriv_le_of_forall_mem_sphere_norm_le (by positivity) hdcc ?_
        intro w hw
        apply hf_le_M (γ θ, w)
        refine ⟨hγ_mem_cb θ, ?_⟩
        rw [Metric.mem_closedBall]
        have hws : dist w x.2 = R / 4 := Metric.mem_sphere.mp hw
        have htri := dist_triangle w x.2 p₀.2
        linarith
      let B_val : ℝ := R * (2 * ((R / 2) ^ 3)⁻¹ * M + ((R / 2) ^ 2)⁻¹ * (M / (R / 4)))
      have hF'_bnd : ∀ θ : ℝ, ∀ x ∈ B, ‖F' x θ‖ ≤ B_val := by
        intro θ x hx
        have hdγ_norm : ‖deriv γ θ‖ = R := by
          rw [deriv_circleMap, norm_mul, Complex.norm_I, mul_one, norm_circleMap_zero,
            abs_of_pos hR_pos]
        have hdist_ge : R / 2 ≤ ‖γ θ - x.1‖ := hγ_dist θ x hx
        have h_pos : 0 < R / 2 := half_pos hR_pos
        have hinv2 : ‖((γ θ - x.1) ^ 2)⁻¹‖ ≤ ((R / 2) ^ 2)⁻¹ := by
          rw [norm_inv, norm_pow]
          exact inv_anti₀ (pow_pos h_pos 2) (pow_le_pow_left₀ h_pos.le hdist_ge 2)
        have hinv3 : ‖((γ θ - x.1) ^ 3)⁻¹‖ ≤ ((R / 2) ^ 3)⁻¹ := by
          rw [norm_inv, norm_pow]
          exact inv_anti₀ (pow_pos h_pos 3) (pow_le_pow_left₀ h_pos.le hdist_ge 3)
        have hf_le : ‖f (γ θ, x.2)‖ ≤ M := by
          apply hf_le_M (γ θ, x.2)
          refine ⟨hγ_mem_cb θ, ?_⟩
          rw [Metric.mem_closedBall]
          have hx_d : dist x p₀ < R / 4 := Metric.mem_ball.mp hx
          rw [Prod.dist_eq] at hx_d
          have hx2 := lt_of_le_of_lt (le_max_right _ _) hx_d
          linarith
        have hterm1 : ‖π₁.smulRight (2 * ((γ θ - x.1) ^ 3)⁻¹ * f (γ θ, x.2))‖ ≤
            2 * ((R / 2) ^ 3)⁻¹ * M := by
          refine ContinuousLinearMap.opNorm_le_bound _ (by positivity) fun v => ?_
          rw [ContinuousLinearMap.smulRight_apply, norm_smul, mul_comm ‖π₁ v‖]
          have hv1 : ‖π₁ v‖ ≤ ‖v‖ := le_max_left ‖v.1‖ ‖v.2‖
          have hc1 : ‖2 * ((γ θ - x.1) ^ 3)⁻¹ * f (γ θ, x.2)‖ ≤ 2 * ((R / 2) ^ 3)⁻¹ * M := by
            rw [norm_mul, norm_mul, Complex.norm_ofNat]
            exact mul_le_mul (mul_le_mul_of_nonneg_left hinv3 zero_le_two) hf_le (norm_nonneg _)
              (by positivity)
          exact mul_le_mul hc1 hv1 (norm_nonneg _) (by positivity)
        have hterm2 : ‖π₂.smulRight (((γ θ - x.1) ^ 2)⁻¹ * pderivD f (γ θ, x.2))‖ ≤
            ((R / 2) ^ 2)⁻¹ * (M / (R / 4)) := by
          refine ContinuousLinearMap.opNorm_le_bound _ (by positivity) fun v => ?_
          rw [ContinuousLinearMap.smulRight_apply, norm_smul, mul_comm ‖π₂ v‖]
          have hv2 : ‖π₂ v‖ ≤ ‖v‖ := le_max_right ‖v.1‖ ‖v.2‖
          have hc2 : ‖((γ θ - x.1) ^ 2)⁻¹ * pderivD f (γ θ, x.2)‖ ≤
              ((R / 2) ^ 2)⁻¹ * (M / (R / 4)) := by
            rw [norm_mul]
            exact mul_le_mul hinv2 (hpderivD_bnd θ x hx) (norm_nonneg _) (by positivity)
          exact mul_le_mul hc2 hv2 (norm_nonneg _) (by positivity)
        dsimp only [F', B_val]
        rw [norm_smul, hdγ_norm]
        refine mul_le_mul_of_nonneg_left ((norm_add_le _ _).trans (add_le_add hterm1 hterm2))
          hR_pos.le
      have hF'_meas : MeasureTheory.AEStronglyMeasurable (F' p₀)
          (MeasureTheory.volume.restrict (Set.uIoc 0 (2 * Real.pi))) := by
        let h_seq : ℕ → ℂ := fun n => (((R / 8) / ((n : ℝ) + 1) : ℝ) : ℂ)
        have hh_ne : ∀ n : ℕ, h_seq n ≠ 0 := by
          intro n
          dsimp only [h_seq]
          exact Complex.ofReal_ne_zero.mpr (div_ne_zero (by positivity) (by positivity))
        have hh_norm : ∀ n : ℕ, ‖h_seq n‖ ≤ R / 8 := by
          intro n
          dsimp only [h_seq]
          rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos (by positivity)]
          exact div_le_self (by positivity) (by linarith [Nat.cast_nonneg (α := ℝ) n])
        have hh_tendsto : Filter.Tendsto h_seq Filter.atTop (nhdsWithin 0 {(0 : ℂ)}ᶜ) := by
          refine tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within _ ?_
            (Filter.Eventually.of_forall fun n => Set.mem_compl_singleton_iff.mpr (hh_ne n))
          have hdiv : Filter.Tendsto (fun n : ℕ => (R / 8) / ((n : ℝ) + 1)) Filter.atTop (nhds 0) :=
            tendsto_const_nhds.div_atTop
              (Filter.tendsto_atTop_add_const_right _ 1 tendsto_natCast_atTop_atTop)
          simpa [Function.comp_def, h_seq] using (Complex.continuous_ofReal.tendsto 0).comp hdiv
        let dq : ℕ → ℝ → ℂ := fun n θ =>
          (h_seq n)⁻¹ * (f (γ θ, p₀.2 + h_seq n) - f (γ θ, p₀.2))
        have hdq_cont : ∀ n : ℕ, Continuous (dq n) := by
          intro n
          have hγ_cont : Continuous γ := continuous_circleMap p₀.1 R
          have hf1 : Continuous (fun θ => f (γ θ, p₀.2 + h_seq n)) := by
            refine hf.continuousOn.comp_continuous (hγ_cont.prodMk continuous_const) fun θ => ?_
            apply hK_sub
            refine ⟨hγ_mem_cb θ, ?_⟩
            rw [Metric.mem_closedBall, dist_eq_norm, add_sub_cancel_left]
            linarith [hh_norm n]
          have hf0 : Continuous (fun θ => f (γ θ, p₀.2)) := by
            refine hf.continuousOn.comp_continuous (hγ_cont.prodMk continuous_const) fun θ => ?_
            exact hK_sub ⟨hγ_mem_cb θ, Metric.mem_closedBall_self (by positivity)⟩
          exact continuous_const.mul (hf1.sub hf0)
        have hdq_lim : ∀ θ : ℝ, Filter.Tendsto (fun n => dq n θ) Filter.atTop
            (nhds (pderivD f (γ θ, p₀.2))) := by
          intro θ
          have h_in_U : (γ θ, p₀.2) ∈ U :=
            hK_sub ⟨hγ_mem_cb θ, Metric.mem_closedBall_self (by positivity)⟩
          have hf_at : DifferentiableAt ℂ f (γ θ, p₀.2) := hf.differentiableAt (hU.mem_nhds h_in_U)
          have h1d : HasDerivAt (fun w => f (γ θ, w)) (pderivD f (γ θ, p₀.2)) p₀.2 :=
            (hf_at.comp p₀.2 ((differentiableAt_const (γ θ)).prodMk differentiableAt_id)).hasDerivAt
          simpa [Function.comp_def, dq, slope_def_field, div_eq_inv_mul] using
            h1d.tendsto_slope_zero.comp hh_tendsto
        have hpD_meas : MeasureTheory.AEStronglyMeasurable (fun θ => pderivD f (γ θ, p₀.2))
            (MeasureTheory.volume.restrict (Set.uIoc 0 (2 * Real.pi))) :=
          aestronglyMeasurable_of_tendsto_ae Filter.atTop
            (fun n => (hdq_cont n).aestronglyMeasurable) (Filter.Eventually.of_forall hdq_lim)
        have hdγ_cont : Continuous (deriv γ) := by
          have hd : deriv γ = fun θ => circleMap 0 R θ * Complex.I := funext (deriv_circleMap p₀.1 R)
          rw [hd]
          exact (continuous_circleMap 0 R).mul continuous_const
        have hinv2_cont : Continuous (fun θ => ((γ θ - p₀.1) ^ 2)⁻¹) :=
          (((continuous_circleMap p₀.1 R).sub continuous_const).pow 2).inv₀
            fun θ => pow_ne_zero 2 (hγ_ne θ p₀ hp₀_B)
        have hinv3_cont : Continuous (fun θ => ((γ θ - p₀.1) ^ 3)⁻¹) :=
          (((continuous_circleMap p₀.1 R).sub continuous_const).pow 3).inv₀
            fun θ => pow_ne_zero 3 (hγ_ne θ p₀ hp₀_B)
        have hf0_cont : Continuous (fun θ => f (γ θ, p₀.2)) :=
          hf.continuousOn.comp_continuous ((continuous_circleMap p₀.1 R).prodMk continuous_const)
            fun θ => hK_sub ⟨hγ_mem_cb θ, Metric.mem_closedBall_self (by positivity)⟩
        let L₁ := ContinuousLinearMap.smulRightL ℂ (ℂ × ℂ) ℂ π₁
        let L₂ := ContinuousLinearMap.smulRightL ℂ (ℂ × ℂ) ℂ π₂
        have hm1 : MeasureTheory.AEStronglyMeasurable
            (fun θ => L₁ (2 * ((γ θ - p₀.1) ^ 3)⁻¹ * f (γ θ, p₀.2)))
            (MeasureTheory.volume.restrict (Set.uIoc 0 (2 * Real.pi))) :=
          (L₁.continuous.comp ((continuous_const.mul hinv3_cont).mul hf0_cont)).aestronglyMeasurable
        have hm2 : MeasureTheory.AEStronglyMeasurable
            (fun θ => L₂ (((γ θ - p₀.1) ^ 2)⁻¹ * pderivD f (γ θ, p₀.2)))
            (MeasureTheory.volume.restrict (Set.uIoc 0 (2 * Real.pi))) :=
          L₂.continuous.comp_aestronglyMeasurable (hinv2_cont.aestronglyMeasurable.mul hpD_meas)
        exact hdγ_cont.aestronglyMeasurable.smul (hm1.add hm2)
      have hint_diff : DifferentiableAt ℂ (fun x => ∫ θ in (0 : ℝ)..(2 * Real.pi), F x θ) p₀ :=
        hparam_int_holo hB_open hp₀_B hF_cont hF'_meas
          (fun θ _ x hx => hF'_bnd θ x hx) (fun θ _ x hx => hF'_deriv θ x hx)
      have hconst_diff : DifferentiableAt ℂ
          (fun x => (2 * (Real.pi : ℂ) * Complex.I)⁻¹ * ∫ θ in (0 : ℝ)..(2 * Real.pi), F x θ) p₀ :=
        (differentiableAt_const _).mul hint_diff
      have hev : (fun x => (2 * (Real.pi : ℂ) * Complex.I)⁻¹ *
          ∫ θ in (0 : ℝ)..(2 * Real.pi), F x θ) =ᶠ[nhds p₀] pderivA f :=
        Filter.eventuallyEq_of_mem (hB_open.mem_nhds hp₀_B) hF_eq_cauchy
      exact (hconst_diff.congr_of_eventuallyEq hev.symm).differentiableWithinAt

    have hpderivD_holo : ∀ {U : Set (ℂ × ℂ)}, IsOpen U → ∀ {f : ℂ × ℂ → ℂ},
        DifferentiableOn ℂ f U → DifferentiableOn ℂ (pderivD f) U := by
      intro U hU f hf
      let swap : ℂ × ℂ → ℂ × ℂ := fun p => (p.2, p.1)
      have hswap_diff : Differentiable ℂ swap := π₂.differentiable.prodMk π₁.differentiable
      have hswap_open : IsOpen (swap ⁻¹' U) := hU.preimage continuous_swap
      have hf_swap : DifferentiableOn ℂ (f ∘ swap) (swap ⁻¹' U) :=
        hf.comp hswap_diff.differentiableOn fun _ hp => hp
      have hA := hpderivA_holo hswap_open hf_swap
      exact (hA.comp hswap_diff.differentiableOn fun _ hp => hp).congr fun p _ => rfl

    have hfderiv_decomp : ∀ {U : Set (ℂ × ℂ)}, IsOpen U → ∀ {f : ℂ × ℂ → ℂ},
        DifferentiableOn ℂ f U → ∀ q ∈ U,
          fderiv ℂ f q = π₁.smulRight (pderivA f q) + π₂.smulRight (pderivD f q) := by
      intro U hU f hf q hq
      have hfq : DifferentiableAt ℂ f q := hf.differentiableAt (hU.mem_nhds hq)
      have hA : HasDerivAt (fun z => f (z, q.2)) (fderiv ℂ f q (1, 0)) q.1 := by
        have h1 : HasDerivAt (fun z : ℂ => (z, q.2)) (1, 0) q.1 :=
          (hasDerivAt_id q.1).prodMk (hasDerivAt_const q.1 q.2)
        exact hfq.hasFDerivAt.comp_hasDerivAt q.1 h1
      have hD : HasDerivAt (fun w => f (q.1, w)) (fderiv ℂ f q (0, 1)) q.2 := by
        have h2 : HasDerivAt (fun w : ℂ => (q.1, w)) (0, 1) q.2 :=
          (hasDerivAt_const q.2 q.1).prodMk (hasDerivAt_id q.2)
        exact hfq.hasFDerivAt.comp_hasDerivAt q.2 h2
      apply ContinuousLinearMap.ext
      intro v
      have hv : v = v.1 • ((1 : ℂ), (0 : ℂ)) + v.2 • ((0 : ℂ), (1 : ℂ)) := by
        ext <;> simp
      conv_lhs => rw [hv]
      rw [map_add, map_smul, map_smul, ← hA.deriv, ← hD.deriv]
      simp [pderivA, pderivD, π₁, π₂, ContinuousLinearMap.smulRight_apply]

    have hpderiv_comm : ∀ {U : Set (ℂ × ℂ)}, IsOpen U → ∀ {f : ℂ × ℂ → ℂ},
        DifferentiableOn ℂ f U → ∀ p ∈ U, pderivA (pderivD f) p = pderivD (pderivA f) p := by
      intro U hU f hf p hp
      let g' : ℂ × ℂ → (ℂ × ℂ) →L[ℂ] ℂ := fun q =>
        π₁.smulRight (pderivA f q) + π₂.smulRight (pderivD f q)
      have hev : ∀ᶠ q in nhds p, HasFDerivAt f (g' q) q := by
        filter_upwards [hU.mem_nhds hp] with q hq
        change HasFDerivAt f (π₁.smulRight (pderivA f q) + π₂.smulRight (pderivD f q)) q
        rw [← hfderiv_decomp hU hf q hq]
        exact (hf.differentiableAt (hU.mem_nhds hq)).hasFDerivAt
      let L₁ := ContinuousLinearMap.smulRightL ℂ (ℂ × ℂ) ℂ π₁
      let L₂ := ContinuousLinearMap.smulRightL ℂ (ℂ × ℂ) ℂ π₂
      have hA_at : DifferentiableAt ℂ (pderivA f) p :=
        (hpderivA_holo hU hf).differentiableAt (hU.mem_nhds hp)
      have hD_at : DifferentiableAt ℂ (pderivD f) p :=
        (hpderivD_holo hU hf).differentiableAt (hU.mem_nhds hp)
      have hg'_diff : DifferentiableAt ℂ g' p :=
        (L₁.differentiableAt.comp p hA_at).add (L₂.differentiableAt.comp p hD_at)
      have hsymm := second_derivative_symmetric_of_eventually hev hg'_diff.hasFDerivAt
        ((1 : ℂ), (0 : ℂ)) ((0 : ℂ), (1 : ℂ))
      have hDA : HasDerivAt (fun w => g' (p.1, w)) (fderiv ℂ g' p (0, 1)) p.2 :=
        hg'_diff.hasFDerivAt.comp_hasDerivAt p.2
          ((hasDerivAt_const p.2 p.1).prodMk (hasDerivAt_id p.2))
      have hAD : HasDerivAt (fun z => g' (z, p.2)) (fderiv ℂ g' p (1, 0)) p.1 :=
        hg'_diff.hasFDerivAt.comp_hasDerivAt p.1
          ((hasDerivAt_id p.1).prodMk (hasDerivAt_const p.1 p.2))
      let ev10 : ((ℂ × ℂ) →L[ℂ] ℂ) →L[ℂ] ℂ := ContinuousLinearMap.apply ℂ ℂ (1, 0)
      let ev01 : ((ℂ × ℂ) →L[ℂ] ℂ) →L[ℂ] ℂ := ContinuousLinearMap.apply ℂ ℂ (0, 1)
      have h1 : HasDerivAt (fun w => pderivA f (p.1, w)) (fderiv ℂ g' p (0, 1) (1, 0)) p.2 := by
        have hc := ev10.hasFDerivAt.comp_hasDerivAt p.2 hDA
        simpa [Function.comp_def, ev10, g', π₁, π₂, ContinuousLinearMap.smulRight_apply] using hc
      have h2 : HasDerivAt (fun z => pderivD f (z, p.2)) (fderiv ℂ g' p (1, 0) (0, 1)) p.1 := by
        have hc := ev01.hasFDerivAt.comp_hasDerivAt p.1 hAD
        simpa [Function.comp_def, ev01, g', π₁, π₂, ContinuousLinearMap.smulRight_apply] using hc
      change deriv (fun z => pderivD f (z, p.2)) p.1 = deriv (fun w => pderivA f (p.1, w)) p.2
      rw [h2.deriv, h1.deriv, hsymm]

    have hiterY_step_A : ∀ (α : ℕ) (f : ℂ × ℂ → ℂ),
        iterDerivY (α + 1) f = iterDerivY α (pderivA f) := by
      intro α f
      induction α with
      | zero => rfl
      | succ α ih =>
        ext p
        change deriv (fun y' => iterDerivY (α + 1) f (y', p.2)) p.1 =
          deriv (fun y' => iterDerivY α (pderivA f) (y', p.2)) p.1
        rw [ih]

    have hiterY_holo : ∀ {U : Set (ℂ × ℂ)}, IsOpen U → ∀ {f : ℂ × ℂ → ℂ},
        DifferentiableOn ℂ f U → ∀ α : ℕ, DifferentiableOn ℂ (iterDerivY α f) U := by
      intro U hU f hf α
      induction α with
      | zero => exact hf
      | succ α ih => exact hpderivA_holo hU ih

    have hiterY_pderivD : ∀ {U : Set (ℂ × ℂ)}, IsOpen U → ∀ {f : ℂ × ℂ → ℂ},
        DifferentiableOn ℂ f U → ∀ (α : ℕ), ∀ p ∈ U,
          iterDerivY α (pderivD f) p = pderivD (iterDerivY α f) p := by
      intro U hU f hf α
      induction α with
      | zero => intro _ _; rfl
      | succ α ih =>
        intro p hp
        change pderivA (iterDerivY α (pderivD f)) p = pderivD (pderivA (iterDerivY α f)) p
        have hev : (fun z => iterDerivY α (pderivD f) (z, p.2)) =ᶠ[nhds p.1]
            (fun z => pderivD (iterDerivY α f) (z, p.2)) := by
          have hopen_slice : IsOpen {z : ℂ | (z, p.2) ∈ U} :=
            hU.preimage (continuous_id.prodMk continuous_const)
          exact Filter.eventuallyEq_of_mem (hopen_slice.mem_nhds hp) fun z hz => ih (z, p.2) hz
        have hcongr : pderivA (iterDerivY α (pderivD f)) p =
            pderivA (pderivD (iterDerivY α f)) p := hev.deriv_eq
        rw [hcongr]
        exact hpderiv_comm hU (hiterY_holo hU hf α) p hp

    have hiterYT_eq_iteratedDeriv : ∀ (α β : ℕ) (f : ℂ × ℂ → ℂ) (p : ℂ × ℂ),
        iterDerivYT α β f p = iteratedDeriv β (fun t' => iterDerivY α f (p.1, t')) p.2 := by
      intro α β f p
      rw [iteratedDeriv_eq_iterate]
      rfl

    have hiterYT_step : ∀ {U : Set (ℂ × ℂ)}, IsOpen U → ∀ {f : ℂ × ℂ → ℂ},
        DifferentiableOn ℂ f U → ∀ (α β : ℕ), ∀ p ∈ U,
          iterDerivYT (α + 1) β f p = iterDerivYT α β (pderivA f) p ∧
          iterDerivYT α (β + 1) f p = iterDerivYT α β (pderivD f) p := by
      intro U hU f hf α β p hp
      refine ⟨?_, ?_⟩
      · simp only [iterDerivYT, hiterY_step_A]
      · rw [hiterYT_eq_iteratedDeriv, hiterYT_eq_iteratedDeriv, iteratedDeriv_succ']
        have hopen_slice : IsOpen {t' : ℂ | (p.1, t') ∈ U} :=
          hU.preimage (continuous_const.prodMk continuous_id)
        have hev : deriv (fun t' => iterDerivY α f (p.1, t')) =ᶠ[nhds p.2]
            (fun t' => iterDerivY α (pderivD f) (p.1, t')) := by
          refine Filter.eventuallyEq_of_mem (hopen_slice.mem_nhds hp) fun t' ht' => ?_
          exact (hiterY_pderivD hU hf α (p.1, t') ht').symm
        exact hev.iteratedDeriv_eq β

    have coeff_taylor2D : ∀ (f : ℂ × ℂ → ℂ) (p₀ : ℂ × ℂ) (d : Fin 2 →₀ ℕ),
        MvPowerSeries.coeff d (taylor2D f p₀) =
          iterDerivYT (d 0) (d 1) f p₀ / (((d 0).factorial : ℂ) * ((d 1).factorial : ℂ)) :=
      fun _ _ _ => rfl

    have hdeg_zero_iff : ∀ d : Fin 2 →₀ ℕ, d = 0 ↔ d 0 + d 1 = 0 := by
      intro d
      constructor
      · rintro rfl; simp
      · intro h; ext i; fin_cases i <;> (simp; omega)

    have htaylor2D_const : ∀ (p₀ : ℂ × ℂ) (c : ℂ), taylor2D (fun _ => c) p₀ = MvPowerSeries.C c := by
      intro p₀ c
      have hiterY_const : ∀ α : ℕ, iterDerivY (α + 1) (fun _ => c) = fun _ => 0 := by
        intro α
        induction α with
        | zero => ext p; exact deriv_const p.1 c
        | succ α ih =>
          ext p
          change deriv (fun y' => iterDerivY (α + 1) (fun _ => c) (y', p.2)) p.1 = 0
          rw [ih]
          exact deriv_const p.1 (0 : ℂ)
      ext d
      rw [coeff_taylor2D, MvPowerSeries.coeff_C, hiterYT_eq_iteratedDeriv]
      by_cases hd : d = 0
      · subst hd; simp [iterDerivY]
      · rw [ite_eq_right_iff.mpr fun h => (hd h).elim]
        rcases Nat.eq_zero_or_pos (d 0) with hd0 | hd0_pos
        · have hd1_ne : d 1 ≠ 0 := fun hd1 => hd ((hdeg_zero_iff d).mpr (by omega))
          rw [hd0]
          change iteratedDeriv (d 1) (fun _ : ℂ => c) p₀.2 / _ = 0
          rw [iteratedDeriv_const, ite_eq_right_iff.mpr fun h => (hd1_ne h).elim, zero_div]
        · obtain ⟨α, hα⟩ := Nat.exists_eq_succ_of_ne_zero (ne_of_gt hd0_pos)
          rw [hα, hiterY_const α, iteratedDeriv_const]
          split_ifs <;> simp

    have htaylor2D_linear_coords : ∀ (p₀ : ℂ × ℂ),
        centeredTaylor2D Prod.fst p₀ = MvPowerSeries.X 0 ∧
        centeredTaylor2D Prod.snd p₀ = MvPowerSeries.X 1 := by
      intro p₀
      let f₁ : ℂ × ℂ → ℂ := fun p => p.1 - p₀.1
      let f₂ : ℂ × ℂ → ℂ := fun p => p.2 - p₀.2
      have hf₁_1 : iterDerivY 1 f₁ = fun _ => 1 := by
        ext q
        change deriv (fun y' : ℂ => y' - p₀.1) q.1 = 1
        rw [deriv_sub_const, deriv_id'']
      have hf₁_2 : ∀ a : ℕ, iterDerivY (a + 2) f₁ = fun _ => 0 := by
        intro a
        induction a with
        | zero =>
          ext q
          change deriv (fun y' : ℂ => iterDerivY 1 f₁ (y', q.2)) q.1 = 0
          rw [hf₁_1]; exact deriv_const q.1 (1 : ℂ)
        | succ a ih =>
          ext q
          change deriv (fun y' : ℂ => iterDerivY (a + 2) f₁ (y', q.2)) q.1 = 0
          rw [ih]; exact deriv_const q.1 (0 : ℂ)
      have hf₂_1 : ∀ a : ℕ, iterDerivY (a + 1) f₂ = fun _ => 0 := by
        intro a
        induction a with
        | zero =>
          ext q
          change deriv (fun _ : ℂ => q.2 - p₀.2) q.1 = 0
          exact deriv_const q.1 (q.2 - p₀.2)
        | succ a ih =>
          ext q
          change deriv (fun y' : ℂ => iterDerivY (a + 1) f₂ (y', q.2)) q.1 = 0
          rw [ih]; exact deriv_const q.1 (0 : ℂ)
      refine ⟨?_, ?_⟩
      · ext d
        change MvPowerSeries.coeff d (taylor2D f₁ p₀) = MvPowerSeries.coeff d (MvPowerSeries.X 0)
        rw [coeff_taylor2D, MvPowerSeries.coeff_X, hiterYT_eq_iteratedDeriv]
        have hsingle0 : d = Finsupp.single 0 1 ↔ d 0 = 1 ∧ d 1 = 0 := by
          rw [Finsupp.ext_iff, Fin.forall_fin_two]
          simp
        rcases d0_cases : d 0 with _ | _ | a
        · have h0 : (fun t' : ℂ => iterDerivY 0 f₁ (p₀.1, t')) = fun _ => 0 := by
            ext t'; simp [iterDerivY, f₁]
          rw [h0, iteratedDeriv_const]
          have hfalse : d ≠ Finsupp.single 0 1 := by rw [ne_eq, hsingle0]; omega
          rw [ite_eq_right_iff.mpr fun h => (hfalse h).elim]
          split_ifs <;> simp
        · rw [hf₁_1, iteratedDeriv_const]
          rcases d1_cases : d 1 with _ | b
          · have htrue : d = Finsupp.single 0 1 := hsingle0.mpr ⟨d0_cases, d1_cases⟩
            simp [htrue]
          · have hfalse : d ≠ Finsupp.single 0 1 := by rw [ne_eq, hsingle0]; omega
            simp [hfalse]
        · rw [hf₁_2 a, iteratedDeriv_const]
          have hfalse : d ≠ Finsupp.single 0 1 := by rw [ne_eq, hsingle0]; omega
          rw [ite_eq_right_iff.mpr fun h => (hfalse h).elim]
          split_ifs <;> simp
      · ext d
        change MvPowerSeries.coeff d (taylor2D f₂ p₀) = MvPowerSeries.coeff d (MvPowerSeries.X 1)
        rw [coeff_taylor2D, MvPowerSeries.coeff_X, hiterYT_eq_iteratedDeriv]
        have hsingle1 : d = Finsupp.single 1 1 ↔ d 0 = 0 ∧ d 1 = 1 := by
          rw [Finsupp.ext_iff, Fin.forall_fin_two]
          simp
        rcases d0_cases : d 0 with _ | a
        · have h0 : (fun t' : ℂ => iterDerivY 0 f₂ (p₀.1, t')) = fun t' => t' - p₀.2 := rfl
          rw [h0]
          rcases d1_cases : d 1 with _ | _ | b
          · have hfalse : d ≠ Finsupp.single 1 1 := by rw [ne_eq, hsingle1]; omega
            simp [hfalse]
          · have htrue : d = Finsupp.single 1 1 := hsingle1.mpr ⟨d0_cases, d1_cases⟩
            rw [ite_eq_left_iff.mpr fun h => (h htrue).elim, iteratedDeriv_one,
              deriv_sub_const, deriv_id'']
            norm_num
          · have hfalse : d ≠ Finsupp.single 1 1 := by rw [ne_eq, hsingle1]; omega
            have hd_lin : deriv (fun t' : ℂ => t' - p₀.2) = fun _ => (1 : ℂ) := by
              ext t'; rw [deriv_sub_const, deriv_id'']
            rw [ite_eq_right_iff.mpr fun h => (hfalse h).elim, iteratedDeriv_succ', hd_lin,
              iteratedDeriv_const]
            simp
        · rw [hf₂_1 a, iteratedDeriv_const]
          have hfalse : d ≠ Finsupp.single 1 1 := by rw [ne_eq, hsingle1]; omega
          rw [ite_eq_right_iff.mpr fun h => (hfalse h).elim]
          split_ifs <;> simp

    have htaylor2D_congr : ∀ {U : Set (ℂ × ℂ)}, IsOpen U → ∀ {p₀ : ℂ × ℂ}, p₀ ∈ U →
        ∀ {f₁ f₂ : ℂ × ℂ → ℂ}, (∀ p ∈ U, f₁ p = f₂ p) → taylor2D f₁ p₀ = taylor2D f₂ p₀ := by
      intro U hU p₀ hp₀ f₁ f₂ hfg
      have hiterY_eq : ∀ (α : ℕ), ∀ p ∈ U, iterDerivY α f₁ p = iterDerivY α f₂ p := by
        intro α
        induction α with
        | zero => exact hfg
        | succ α ih =>
          intro p hp
          have hopen_slice : IsOpen {y' : ℂ | (y', p.2) ∈ U} :=
            hU.preimage (continuous_id.prodMk continuous_const)
          have hev : (fun y' => iterDerivY α f₁ (y', p.2)) =ᶠ[nhds p.1]
              (fun y' => iterDerivY α f₂ (y', p.2)) :=
            Filter.eventuallyEq_of_mem (hopen_slice.mem_nhds hp) fun y' hy' => ih (y', p.2) hy'
          exact hev.deriv_eq
      ext d
      rw [coeff_taylor2D, coeff_taylor2D, hiterYT_eq_iteratedDeriv, hiterYT_eq_iteratedDeriv]
      have hopen_slice : IsOpen {t' : ℂ | (p₀.1, t') ∈ U} :=
        hU.preimage (continuous_const.prodMk continuous_id)
      have hev : (fun t' => iterDerivY (d 0) f₁ (p₀.1, t')) =ᶠ[nhds p₀.2]
          (fun t' => iterDerivY (d 0) f₂ (p₀.1, t')) :=
        Filter.eventuallyEq_of_mem (hopen_slice.mem_nhds hp₀) fun t' ht' =>
          hiterY_eq (d 0) (p₀.1, t') ht'
      rw [hev.iteratedDeriv_eq (d 1)]

    let mvDeriv (ι : Fin 2) (Φ : MvPowerSeries (Fin 2) ℂ) : MvPowerSeries (Fin 2) ℂ :=
      fun d => ((d ι + 1 : ℕ) : ℂ) * MvPowerSeries.coeff (d + Finsupp.single ι 1) Φ
    have coeff_mvDeriv : ∀ (ι : Fin 2) (Φ : MvPowerSeries (Fin 2) ℂ) (d : Fin 2 →₀ ℕ),
        MvPowerSeries.coeff d (mvDeriv ι Φ) =
          ((d ι + 1 : ℕ) : ℂ) * MvPowerSeries.coeff (d + Finsupp.single ι 1) Φ :=
      fun _ _ _ => rfl
    have coeff_comp1D : ∀ (f : PowerSeries ℂ) (Ψ : MvPowerSeries (Fin 2) ℂ) (d : Fin 2 →₀ ℕ),
        MvPowerSeries.coeff d (compPowerSeries2D f Ψ) =
          ∑ n ∈ Finset.range (d 0 + d 1 + 1),
            PowerSeries.coeff n f * MvPowerSeries.coeff d (Ψ ^ n) :=
      fun _ _ _ => rfl

    have hmv_add : ∀ (ι : Fin 2) (Φ Ψ : MvPowerSeries (Fin 2) ℂ),
        mvDeriv ι (Φ + Ψ) = mvDeriv ι Φ + mvDeriv ι Ψ := by
      intro ι Φ Ψ
      ext d
      rw [map_add, coeff_mvDeriv, coeff_mvDeriv, coeff_mvDeriv, map_add, mul_add]

    have hmv_mul_half : ∀ (ι : Fin 2) (Φ Ψ : MvPowerSeries (Fin 2) ℂ) (d : Fin 2 →₀ ℕ),
        MvPowerSeries.coeff d (mvDeriv ι Φ * Ψ) =
          ∑ p ∈ Finset.HasAntidiagonal.antidiagonal (d + Finsupp.single ι (1 : ℕ)),
            ((p.1 ι : ℕ) : ℂ) * MvPowerSeries.coeff p.1 Φ * MvPowerSeries.coeff p.2 Ψ := by
      intro ι Φ Ψ d
      let e : Fin 2 →₀ ℕ := Finsupp.single ι 1
      change MvPowerSeries.coeff d (mvDeriv ι Φ * Ψ) =
        ∑ p ∈ Finset.HasAntidiagonal.antidiagonal (d + e),
          ((p.1 ι : ℕ) : ℂ) * MvPowerSeries.coeff p.1 Φ * MvPowerSeries.coeff p.2 Ψ
      rw [MvPowerSeries.coeff_mul]
      let S_pos := (Finset.HasAntidiagonal.antidiagonal (d + e)).filter (fun p => p.1 ι ≠ 0)
      have hsum_filter :
          (∑ p ∈ Finset.HasAntidiagonal.antidiagonal (d + e),
            ((p.1 ι : ℕ) : ℂ) * MvPowerSeries.coeff p.1 Φ * MvPowerSeries.coeff p.2 Ψ) =
          ∑ p ∈ S_pos,
            ((p.1 ι : ℕ) : ℂ) * MvPowerSeries.coeff p.1 Φ * MvPowerSeries.coeff p.2 Ψ := by
        symm
        refine Finset.sum_subset (Finset.filter_subset _ _) fun p hp hnot => ?_
        rw [Finset.mem_filter, not_and, Classical.not_not] at hnot
        rw [hnot hp, Nat.cast_zero, zero_mul, zero_mul]
      rw [hsum_filter]
      refine Finset.sum_bij'
        (fun q _ => (q.1 + e, q.2))
        (fun p _ => (p.1 - e, p.2))
        ?_ ?_ ?_ ?_ ?_
      · intro q hq
        rw [Finset.HasAntidiagonal.mem_antidiagonal] at hq
        refine Finset.mem_filter.mpr ⟨?_, ?_⟩
        · rw [Finset.HasAntidiagonal.mem_antidiagonal]
          calc (q.1 + e) + q.2 = (q.1 + q.2) + e := by abel
            _ = d + e := by rw [hq]
        · simp [e]
      · intro p hp
        obtain ⟨hp_ant, hp_ne⟩ := Finset.mem_filter.mp hp
        rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp_ant ⊢
        ext j
        have hj := Finsupp.ext_iff.mp hp_ant j
        fin_cases j <;> fin_cases ι <;> simp [e] at hj hp_ne ⊢ <;> omega
      · intro q _
        ext j <;> simp [e]
      · intro p hp
        obtain ⟨_, hp_ne⟩ := Finset.mem_filter.mp hp
        ext j
        · fin_cases j <;> fin_cases ι <;> simp [e] at hp_ne ⊢ <;> omega
        · rfl
      · intro q _
        rw [coeff_mvDeriv]
        have hcoord : (q.1 + e) ι = q.1 ι + 1 := by simp [e]
        rw [hcoord]

    have hmv_mul : ∀ (ι : Fin 2) (Φ Ψ : MvPowerSeries (Fin 2) ℂ),
        mvDeriv ι (Φ * Ψ) = mvDeriv ι Φ * Ψ + Φ * mvDeriv ι Ψ := by
      intro ι Φ Ψ
      ext d
      let e : Fin 2 →₀ ℕ := Finsupp.single ι 1
      rw [map_add, hmv_mul_half ι Φ Ψ d, mul_comm Φ (mvDeriv ι Ψ), hmv_mul_half ι Ψ Φ d,
        coeff_mvDeriv, MvPowerSeries.coeff_mul, Finset.mul_sum]
      change (∑ x ∈ Finset.HasAntidiagonal.antidiagonal (d + e),
          ((d ι + 1 : ℕ) : ℂ) * (MvPowerSeries.coeff x.1 Φ * MvPowerSeries.coeff x.2 Ψ)) =
        (∑ p ∈ Finset.HasAntidiagonal.antidiagonal (d + e),
          ((p.1 ι : ℕ) : ℂ) * MvPowerSeries.coeff p.1 Φ * MvPowerSeries.coeff p.2 Ψ) +
        (∑ p ∈ Finset.HasAntidiagonal.antidiagonal (d + e),
          ((p.1 ι : ℕ) : ℂ) * MvPowerSeries.coeff p.1 Ψ * MvPowerSeries.coeff p.2 Φ)
      have hswap :
          (∑ p ∈ Finset.HasAntidiagonal.antidiagonal (d + e),
            ((p.1 ι : ℕ) : ℂ) * MvPowerSeries.coeff p.1 Ψ * MvPowerSeries.coeff p.2 Φ) =
          ∑ p ∈ Finset.HasAntidiagonal.antidiagonal (d + e),
            ((p.2 ι : ℕ) : ℂ) * MvPowerSeries.coeff p.1 Φ * MvPowerSeries.coeff p.2 Ψ := by
        refine Finset.sum_bij' (fun p _ => (p.2, p.1)) (fun p _ => (p.2, p.1))
          ?_ ?_ (fun _ _ => rfl) (fun _ _ => rfl) ?_
        · intro p hp
          rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp ⊢
          rw [add_comm]; exact hp
        · intro p hp
          rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp ⊢
          rw [add_comm]; exact hp
        · intro p _; ring
      rw [hswap, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun p hp => ?_
      rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp
      have hc : p.1 ι + p.2 ι = d ι + 1 := by
        have hj := Finsupp.ext_iff.mp hp ι
        simpa [e] using hj
      have hcast : ((p.1 ι : ℕ) : ℂ) + ((p.2 ι : ℕ) : ℂ) = ((d ι + 1 : ℕ) : ℂ) := by
        exact_mod_cast hc
      rw [← hcast]
      ring

    have hmv_one : ∀ ι : Fin 2, mvDeriv ι 1 = 0 := by
      intro ι
      ext m
      have hne : m + Finsupp.single ι 1 ≠ 0 := by
        intro h0
        have hc := Finsupp.ext_iff.mp h0 ι
        simp at hc
      rw [coeff_mvDeriv, map_zero, MvPowerSeries.coeff_one,
        ite_eq_right_iff.mpr fun h => (hne h).elim, mul_zero]

    have hmv_pow : ∀ (ι : Fin 2) (Ψ : MvPowerSeries (Fin 2) ℂ) (k : ℕ),
        mvDeriv ι (Ψ ^ (k + 1)) = ((k + 1 : ℕ) : ℂ) • (mvDeriv ι Ψ * Ψ ^ k) := by
      intro ι Ψ k
      induction k with
      | zero => simp
      | succ k ih =>
        rw [pow_succ Ψ (k + 1), hmv_mul, ih, smul_mul_assoc, mul_assoc, ← pow_succ,
          mul_comm (Ψ ^ (k + 1)) (mvDeriv ι Ψ)]
        have hcast : ((k + 1 + 1 : ℕ) : ℂ) = ((k + 1 : ℕ) : ℂ) + 1 := by push_cast; ring
        rw [hcast, add_smul, one_smul]

    have hpow_vanish : ∀ {Ψ : MvPowerSeries (Fin 2) ℂ}, MvPowerSeries.coeff 0 Ψ = 0 →
        ∀ (n : ℕ) (d : Fin 2 →₀ ℕ), d 0 + d 1 < n → MvPowerSeries.coeff d (Ψ ^ n) = 0 := by
      intro Ψ hΨ0 n
      induction n with
      | zero => intro _ hd; omega
      | succ n ih =>
        intro d hd
        rw [pow_succ, MvPowerSeries.coeff_mul]
        refine Finset.sum_eq_zero fun p hp => ?_
        rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp
        by_cases hp2 : p.2 = 0
        · rw [hp2, hΨ0, mul_zero]
        · have hp2_pos : 1 ≤ p.2 0 + p.2 1 := by
            have := mt (hdeg_zero_iff p.2).mpr hp2
            omega
          have h0 := Finsupp.ext_iff.mp hp 0
          have h1 := Finsupp.ext_iff.mp hp 1
          simp only [Finsupp.add_apply] at h0 h1
          rw [ih p.1 (by omega), zero_mul]

    have hmv_comp1D : ∀ (ι : Fin 2) (f : PowerSeries ℂ) (Ψ : MvPowerSeries (Fin 2) ℂ),
        MvPowerSeries.coeff 0 Ψ = 0 →
        mvDeriv ι (compPowerSeries2D f Ψ) =
          mvDeriv ι Ψ * compPowerSeries2D (PowerSeries.derivative f) Ψ := by
      intro ι f Ψ hΨ0
      ext d
      have hdeg_e : (d + Finsupp.single ι (1 : ℕ)) 0 + (d + Finsupp.single ι (1 : ℕ)) 1 =
          d 0 + d 1 + 1 := by
        fin_cases ι <;> simp <;> omega
      rw [coeff_mvDeriv, coeff_comp1D, hdeg_e, Finset.mul_sum]
      have hlhs :
          (∑ n ∈ Finset.range (d 0 + d 1 + 1 + 1),
            ((d ι + 1 : ℕ) : ℂ) *
              (PowerSeries.coeff n f * MvPowerSeries.coeff (d + Finsupp.single ι 1) (Ψ ^ n))) =
          ∑ n ∈ Finset.range (d 0 + d 1 + 1 + 1),
            PowerSeries.coeff n f * MvPowerSeries.coeff d (mvDeriv ι (Ψ ^ n)) := by
        refine Finset.sum_congr rfl fun n _ => ?_
        rw [coeff_mvDeriv]; ring
      rw [hlhs, Finset.sum_range_succ', pow_zero, hmv_one ι, MvPowerSeries.coeff_zero,
        mul_zero, add_zero]
      have hstep :
          (∑ k ∈ Finset.range (d 0 + d 1 + 1),
            PowerSeries.coeff (k + 1) f * MvPowerSeries.coeff d (mvDeriv ι (Ψ ^ (k + 1)))) =
          ∑ k ∈ Finset.range (d 0 + d 1 + 1),
            ∑ p ∈ Finset.HasAntidiagonal.antidiagonal d,
              MvPowerSeries.coeff p.1 (mvDeriv ι Ψ) *
                (PowerSeries.coeff k (PowerSeries.derivative f) * MvPowerSeries.coeff p.2 (Ψ ^ k)) := by
        refine Finset.sum_congr rfl fun k _ => ?_
        rw [hmv_pow ι Ψ k, map_smul, smul_eq_mul, MvPowerSeries.coeff_mul,
          PowerSeries.coeff_derivative]
        push_cast
        rw [Finset.mul_sum, Finset.mul_sum]
        exact Finset.sum_congr rfl fun _ _ => by ring
      rw [hstep, Finset.sum_comm, MvPowerSeries.coeff_mul]
      refine Finset.sum_congr rfl fun p hp => ?_
      rw [← Finset.mul_sum, coeff_comp1D]
      congr 1
      symm
      rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp
      have h0 := Finsupp.ext_iff.mp hp 0
      have h1 := Finsupp.ext_iff.mp hp 1
      simp only [Finsupp.add_apply] at h0 h1
      refine Finset.sum_subset (Finset.range_mono (by omega)) fun k _ hk_not => ?_
      rw [Finset.mem_range, not_lt] at hk_not
      rw [hpow_vanish hΨ0 k p.2 (by omega), mul_zero]

    have hmv_taylor : ∀ {U : Set (ℂ × ℂ)}, IsOpen U → ∀ {p₀ : ℂ × ℂ}, p₀ ∈ U →
        ∀ {f : ℂ × ℂ → ℂ}, DifferentiableOn ℂ f U →
          mvDeriv 0 (taylor2D f p₀) = taylor2D (pderivA f) p₀ ∧
          mvDeriv 1 (taylor2D f p₀) = taylor2D (pderivD f) p₀ := by
      intro U hU p₀ hp₀ f hf
      constructor
      · ext d
        rw [coeff_mvDeriv, coeff_taylor2D, coeff_taylor2D]
        have hd0 : (d + Finsupp.single (0 : Fin 2) (1 : ℕ)) 0 = d 0 + 1 := by simp
        have hd1 : (d + Finsupp.single (0 : Fin 2) (1 : ℕ)) 1 = d 1 := by simp
        rw [hd0, hd1, (hiterYT_step hU hf (d 0) (d 1) p₀ hp₀).1, Nat.factorial_succ (d 0),
          Nat.cast_mul]
        have hc : ((d 0 + 1 : ℕ) : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.succ_ne_zero _)
        have hf0 : ((d 0).factorial : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)
        have hf1 : ((d 1).factorial : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)
        field_simp
      · ext d
        rw [coeff_mvDeriv, coeff_taylor2D, coeff_taylor2D]
        have hd0 : (d + Finsupp.single (1 : Fin 2) (1 : ℕ)) 0 = d 0 := by simp
        have hd1 : (d + Finsupp.single (1 : Fin 2) (1 : ℕ)) 1 = d 1 + 1 := by simp
        rw [hd0, hd1, (hiterYT_step hU hf (d 0) (d 1) p₀ hp₀).2, Nat.factorial_succ (d 1),
          Nat.cast_mul]
        have hc : ((d 1 + 1 : ℕ) : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.succ_ne_zero _)
        have hf0 : ((d 0).factorial : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)
        have hf1 : ((d 1).factorial : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)
        field_simp

    have hcoeff_step : ∀ {Φ Ψ : MvPowerSeries (Fin 2) ℂ} {N : ℕ} {d : Fin 2 →₀ ℕ},
        d 0 + d 1 = N + 1 →
        (∀ d' : Fin 2 →₀ ℕ, d' 0 + d' 1 = N →
          MvPowerSeries.coeff d' (mvDeriv 0 Φ) = MvPowerSeries.coeff d' (mvDeriv 0 Ψ) ∧
          MvPowerSeries.coeff d' (mvDeriv 1 Φ) = MvPowerSeries.coeff d' (mvDeriv 1 Ψ)) →
        MvPowerSeries.coeff d Φ = MvPowerSeries.coeff d Ψ := by
      intro Φ Ψ N d hd heq
      by_cases hd0 : d 0 = 0
      · let d' : Fin 2 →₀ ℕ := d - Finsupp.single 1 1
        have hd'_add : d' + Finsupp.single 1 1 = d := by
          ext i; fin_cases i <;> simp [d'] <;> omega
        have hd'_deg : d' 0 + d' 1 = N := by
          have hsum := congr_arg (fun x : Fin 2 →₀ ℕ => x 0 + x 1) hd'_add
          simp only [Finsupp.add_apply, Finsupp.single_eq_same] at hsum
          have : (Finsupp.single (1 : Fin 2) (1 : ℕ)) 0 = 0 := by simp
          omega
        have hD := (heq d' hd'_deg).2
        rw [coeff_mvDeriv, coeff_mvDeriv, hd'_add] at hD
        exact mul_left_cancel₀ (Nat.cast_ne_zero.mpr (Nat.succ_ne_zero _)) hD
      · let d' : Fin 2 →₀ ℕ := d - Finsupp.single 0 1
        have hd'_add : d' + Finsupp.single 0 1 = d := by
          ext i; fin_cases i <;> simp [d'] <;> omega
        have hd'_deg : d' 0 + d' 1 = N := by
          have hsum := congr_arg (fun x : Fin 2 →₀ ℕ => x 0 + x 1) hd'_add
          simp only [Finsupp.add_apply, Finsupp.single_eq_same] at hsum
          have : (Finsupp.single (0 : Fin 2) (1 : ℕ)) 1 = 0 := by simp
          omega
        have hA := (heq d' hd'_deg).1
        rw [coeff_mvDeriv, coeff_mvDeriv, hd'_add] at hA
        exact mul_left_cancel₀ (Nat.cast_ne_zero.mpr (Nat.succ_ne_zero _)) hA

    have hslice_at : ∀ {U : Set (ℂ × ℂ)}, IsOpen U → ∀ {f : ℂ × ℂ → ℂ},
        DifferentiableOn ℂ f U → ∀ q ∈ U,
          DifferentiableAt ℂ (fun z => f (z, q.2)) q.1 ∧
          DifferentiableAt ℂ (fun w => f (q.1, w)) q.2 := by
      intro U hU f hf q hq
      have hfq : DifferentiableAt ℂ f q := hf.differentiableAt (hU.mem_nhds hq)
      exact ⟨hfq.comp q.1 (differentiableAt_id.prodMk (differentiableAt_const q.2)),
        hfq.comp q.2 ((differentiableAt_const q.1).prodMk differentiableAt_id)⟩

    have htaylor2D_add : ∀ {U : Set (ℂ × ℂ)}, IsOpen U → ∀ {p₀ : ℂ × ℂ}, p₀ ∈ U →
        ∀ {f g : ℂ × ℂ → ℂ}, DifferentiableOn ℂ f U → DifferentiableOn ℂ g U →
          taylor2D (fun p => f p + g p) p₀ = taylor2D f p₀ + taylor2D g p₀ := by
      intro U hU p₀ hp₀
      have hind : ∀ (N : ℕ) {f g : ℂ × ℂ → ℂ}, DifferentiableOn ℂ f U → DifferentiableOn ℂ g U →
          ∀ d : Fin 2 →₀ ℕ, d 0 + d 1 ≤ N →
            MvPowerSeries.coeff d (taylor2D (fun p => f p + g p) p₀) =
              MvPowerSeries.coeff d (taylor2D f p₀ + taylor2D g p₀) := by
        intro N
        induction N with
        | zero =>
          intro f g _ _ d hd
          have hd0 : d = 0 := (hdeg_zero_iff d).mpr (by omega)
          subst hd0
          rw [map_add, coeff_taylor2D, coeff_taylor2D, coeff_taylor2D]
          simp [iterDerivYT, iterDerivY]
        | succ N ih =>
          intro f g hf hg d hd
          by_cases hle : d 0 + d 1 ≤ N
          · exact ih hf hg d hle
          · refine hcoeff_step (N := N) (by omega) fun d' hd' => ?_
            have hfg : DifferentiableOn ℂ (fun p => f p + g p) U := hf.add hg
            have hpA : ∀ q ∈ U, pderivA (fun p => f p + g p) q = pderivA f q + pderivA g q :=
              fun q hq => deriv_add (hslice_at hU hf q hq).1 (hslice_at hU hg q hq).1
            have hpD : ∀ q ∈ U, pderivD (fun p => f p + g p) q = pderivD f q + pderivD g q :=
              fun q hq => deriv_add (hslice_at hU hf q hq).2 (hslice_at hU hg q hq).2
            constructor
            · rw [(hmv_taylor hU hp₀ hfg).1, htaylor2D_congr hU hp₀ hpA, hmv_add,
                (hmv_taylor hU hp₀ hf).1, (hmv_taylor hU hp₀ hg).1]
              exact ih (hpderivA_holo hU hf) (hpderivA_holo hU hg) d' (le_of_eq hd')
            · rw [(hmv_taylor hU hp₀ hfg).2, htaylor2D_congr hU hp₀ hpD, hmv_add,
                (hmv_taylor hU hp₀ hf).2, (hmv_taylor hU hp₀ hg).2]
              exact ih (hpderivD_holo hU hf) (hpderivD_holo hU hg) d' (le_of_eq hd')
      intro f g hf hg
      ext d
      exact hind (d 0 + d 1) hf hg d le_rfl

    have htaylor2D_mul : ∀ {U : Set (ℂ × ℂ)}, IsOpen U → ∀ {p₀ : ℂ × ℂ}, p₀ ∈ U →
        ∀ {f g : ℂ × ℂ → ℂ}, DifferentiableOn ℂ f U → DifferentiableOn ℂ g U →
          taylor2D (fun p => f p * g p) p₀ = taylor2D f p₀ * taylor2D g p₀ := by
      intro U hU p₀ hp₀
      have hind : ∀ (N : ℕ) {f g : ℂ × ℂ → ℂ}, DifferentiableOn ℂ f U → DifferentiableOn ℂ g U →
          ∀ d : Fin 2 →₀ ℕ, d 0 + d 1 ≤ N →
            MvPowerSeries.coeff d (taylor2D (fun p => f p * g p) p₀) =
              MvPowerSeries.coeff d (taylor2D f p₀ * taylor2D g p₀) := by
        intro N
        induction N with
        | zero =>
          intro f g _ _ d hd
          have hd0 : d = 0 := (hdeg_zero_iff d).mpr (by omega)
          subst hd0
          rw [MvPowerSeries.coeff_zero_eq_constantCoeff, map_mul,
            ← MvPowerSeries.coeff_zero_eq_constantCoeff,
            coeff_taylor2D, coeff_taylor2D, coeff_taylor2D]
          simp [iterDerivYT, iterDerivY]
        | succ N ih =>
          intro f g hf hg d hd
          by_cases hle : d 0 + d 1 ≤ N
          · exact ih hf hg d hle
          · refine hcoeff_step (N := N) (by omega) fun d' hd' => ?_
            have hfA := hpderivA_holo hU hf
            have hfD := hpderivD_holo hU hf
            have hgA := hpderivA_holo hU hg
            have hgD := hpderivD_holo hU hg
            have hfg : DifferentiableOn ℂ (fun p => f p * g p) U := hf.mul hg
            have hpA : ∀ q ∈ U,
                pderivA (fun p => f p * g p) q = pderivA f q * g q + f q * pderivA g q :=
              fun q hq => deriv_mul (hslice_at hU hf q hq).1 (hslice_at hU hg q hq).1
            have hpD : ∀ q ∈ U,
                pderivD (fun p => f p * g p) q = pderivD f q * g q + f q * pderivD g q :=
              fun q hq => deriv_mul (hslice_at hU hf q hq).2 (hslice_at hU hg q hq).2
            have hfAg : DifferentiableOn ℂ (fun p => pderivA f p * g p) U := hfA.mul hg
            have hfgA : DifferentiableOn ℂ (fun p => f p * pderivA g p) U := hf.mul hgA
            have hfDg : DifferentiableOn ℂ (fun p => pderivD f p * g p) U := hfD.mul hg
            have hfgD : DifferentiableOn ℂ (fun p => f p * pderivD g p) U := hf.mul hgD
            constructor
            · rw [(hmv_taylor hU hp₀ hfg).1, htaylor2D_congr hU hp₀ hpA,
                htaylor2D_add hU hp₀ hfAg hfgA,
                hmv_mul, (hmv_taylor hU hp₀ hf).1, (hmv_taylor hU hp₀ hg).1,
                map_add, map_add, ih hfA hg d' (le_of_eq hd'), ih hf hgA d' (le_of_eq hd')]
            · rw [(hmv_taylor hU hp₀ hfg).2, htaylor2D_congr hU hp₀ hpD,
                htaylor2D_add hU hp₀ hfDg hfgD,
                hmv_mul, (hmv_taylor hU hp₀ hf).2, (hmv_taylor hU hp₀ hg).2,
                map_add, map_add, ih hfD hg d' (le_of_eq hd'), ih hf hgD d' (le_of_eq hd')]
      intro f g hf hg
      ext d
      exact hind (d 0 + d 1) hf hg d le_rfl

    have htaylor2D_ring : ∀ {U : Set (ℂ × ℂ)}, IsOpen U → ∀ {p₀ : ℂ × ℂ}, p₀ ∈ U →
        ∀ {f g : ℂ × ℂ → ℂ}, DifferentiableOn ℂ f U → DifferentiableOn ℂ g U →
          taylor2D (fun p => f p + g p) p₀ = taylor2D f p₀ + taylor2D g p₀ ∧
          taylor2D (fun p => f p - g p) p₀ = taylor2D f p₀ - taylor2D g p₀ ∧
          taylor2D (fun p => f p * g p) p₀ = taylor2D f p₀ * taylor2D g p₀ := by
      intro U hU p₀ hp₀ f g hf hg
      refine ⟨htaylor2D_add hU hp₀ hf hg, ?_, htaylor2D_mul hU hp₀ hf hg⟩
      have hneg_g : DifferentiableOn ℂ (fun p => (fun _ : ℂ × ℂ => (-1 : ℂ)) p * g p) U :=
        (differentiableOn_const (-1 : ℂ)).mul hg
      have hsub_fn : (fun p => f p - g p) =
          (fun p => f p + (fun _ : ℂ × ℂ => (-1 : ℂ)) p * g p) := by
        ext p; ring
      rw [hsub_fn, htaylor2D_add hU hp₀ hf hneg_g,
        htaylor2D_mul hU hp₀ (differentiableOn_const (-1 : ℂ)) hg, htaylor2D_const p₀ (-1),
        map_neg, map_one]
      ring

    have htaylor2D_comp_1D : ∀ {U : Set (ℂ × ℂ)} {W : Set ℂ}, IsOpen U → IsOpen W →
        ∀ {p₀ : ℂ × ℂ}, p₀ ∈ U → ∀ {ψ : ℂ × ℂ → ℂ} {g : ℂ → ℂ},
          DifferentiableOn ℂ ψ U → DifferentiableOn ℂ g W → (∀ p ∈ U, ψ p ∈ W) →
          taylor2D (fun p => g (ψ p)) p₀ =
            compPowerSeries2D (lineArcHoloTaylor1D g (ψ p₀)) (centeredTaylor2D ψ p₀) := by
      intro U W hU hW p₀ hp₀ ψ g₀ hψ hg₀ hmaps
      let Ψ : MvPowerSeries (Fin 2) ℂ := centeredTaylor2D ψ p₀
      have hΨ0 : MvPowerSeries.coeff 0 Ψ = 0 := by
        change MvPowerSeries.coeff 0 (taylor2D (fun p => ψ p - ψ p₀) p₀) = 0
        rw [coeff_taylor2D]
        simp [iterDerivYT, iterDerivY]
      have hΨ_sub_holo : DifferentiableOn ℂ (fun p => ψ p - ψ p₀) U :=
        hψ.sub (differentiableOn_const (ψ p₀))
      have hΨ_dA : mvDeriv 0 Ψ = taylor2D (pderivA ψ) p₀ := by
        change mvDeriv 0 (taylor2D (fun p => ψ p - ψ p₀) p₀) = _
        rw [(hmv_taylor hU hp₀ hΨ_sub_holo).1]
        exact htaylor2D_congr hU hp₀ fun q _ => deriv_sub_const (f := fun z => ψ (z, q.2)) (ψ p₀)
      have hΨ_dD : mvDeriv 1 Ψ = taylor2D (pderivD ψ) p₀ := by
        change mvDeriv 1 (taylor2D (fun p => ψ p - ψ p₀) p₀) = _
        rw [(hmv_taylor hU hp₀ hΨ_sub_holo).2]
        exact htaylor2D_congr hU hp₀ fun q _ => deriv_sub_const (f := fun w => ψ (q.1, w)) (ψ p₀)
      have hderiv_holo1D : ∀ (h : ℂ → ℂ) (w₀ : ℂ),
          PowerSeries.derivative (holoTaylor1D h w₀) = holoTaylor1D (deriv h) w₀ := by
        intro h w₀
        ext n
        rw [PowerSeries.coeff_derivative, holoTaylor1D, holoTaylor1D,
          PowerSeries.coeff_mk, PowerSeries.coeff_mk, iteratedDeriv_succ',
          Nat.factorial_succ, Nat.cast_mul]
        have hc1 : ((n : ℂ) + 1) ≠ 0 := by exact_mod_cast Nat.succ_ne_zero n
        have hc2 : (n.factorial : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero n)
        push_cast
        field_simp
      have hind : ∀ (N : ℕ) {g : ℂ → ℂ}, DifferentiableOn ℂ g W →
          ∀ d : Fin 2 →₀ ℕ, d 0 + d 1 ≤ N →
            MvPowerSeries.coeff d (taylor2D (fun p => g (ψ p)) p₀) =
              MvPowerSeries.coeff d (compPowerSeries2D (holoTaylor1D g (ψ p₀)) Ψ) := by
        intro N
        induction N with
        | zero =>
          intro g _ d hd
          have hd0 : d = 0 := (hdeg_zero_iff d).mpr (by omega)
          subst hd0
          rw [coeff_taylor2D, coeff_comp1D]
          simp [iterDerivYT, iterDerivY, holoTaylor1D]
        | succ N ih =>
          intro g hg d hd
          by_cases hle : d 0 + d 1 ≤ N
          · exact ih hg d hle
          · refine hcoeff_step (N := N) (by omega) fun d' hd' => ?_
            have hψA := hpderivA_holo hU hψ
            have hψD := hpderivD_holo hU hψ
            have hg' : DifferentiableOn ℂ (deriv g) W := hg.deriv hW
            have hgψ : DifferentiableOn ℂ (fun p => g (ψ p)) U := hg.comp hψ fun p hp => hmaps p hp
            have hg'ψ : DifferentiableOn ℂ (fun p => deriv g (ψ p)) U :=
              hg'.comp hψ fun p hp => hmaps p hp
            have hpA : ∀ q ∈ U, pderivA (fun p => g (ψ p)) q = pderivA ψ q * deriv g (ψ q) := by
              intro q hq
              have hgat : DifferentiableAt ℂ g (ψ q) := hg.differentiableAt (hW.mem_nhds (hmaps q hq))
              simpa [pderivA, Function.comp_def, mul_comm] using
                deriv_comp q.1 hgat (hslice_at hU hψ q hq).1
            have hpD : ∀ q ∈ U, pderivD (fun p => g (ψ p)) q = pderivD ψ q * deriv g (ψ q) := by
              intro q hq
              have hgat : DifferentiableAt ℂ g (ψ q) := hg.differentiableAt (hW.mem_nhds (hmaps q hq))
              simpa [pderivD, Function.comp_def, mul_comm] using
                deriv_comp q.2 hgat (hslice_at hU hψ q hq).2
            have hdeg_le_right : ∀ r ∈ Finset.HasAntidiagonal.antidiagonal d', r.2 0 + r.2 1 ≤ N := by
              intro r hr
              rw [Finset.HasAntidiagonal.mem_antidiagonal] at hr
              have h0 := Finsupp.ext_iff.mp hr 0
              have h1 := Finsupp.ext_iff.mp hr 1
              simp only [Finsupp.add_apply] at h0 h1
              omega
            constructor
            · rw [(hmv_taylor hU hp₀ hgψ).1, htaylor2D_congr hU hp₀ hpA,
                htaylor2D_mul hU hp₀ hψA hg'ψ,
                hmv_comp1D 0 (holoTaylor1D g (ψ p₀)) Ψ hΨ0, hΨ_dA, hderiv_holo1D g (ψ p₀),
                MvPowerSeries.coeff_mul, MvPowerSeries.coeff_mul]
              exact Finset.sum_congr rfl fun r hr => by rw [ih hg' r.2 (hdeg_le_right r hr)]
            · rw [(hmv_taylor hU hp₀ hgψ).2, htaylor2D_congr hU hp₀ hpD,
                htaylor2D_mul hU hp₀ hψD hg'ψ,
                hmv_comp1D 1 (holoTaylor1D g (ψ p₀)) Ψ hΨ0, hΨ_dD, hderiv_holo1D g (ψ p₀),
                MvPowerSeries.coeff_mul, MvPowerSeries.coeff_mul]
              exact Finset.sum_congr rfl fun r hr => by rw [ih hg' r.2 (hdeg_le_right r hr)]
      ext d
      exact hind (d 0 + d 1) hg₀ d le_rfl

    exact ⟨htaylor2D_const, htaylor2D_linear_coords, htaylor2D_congr, htaylor2D_ring, htaylor2D_comp_1D⟩

  rcases hPartA with
    ⟨htaylor2D_const, htaylor2D_linear_coords, htaylor2D_congr, htaylor2D_ring, htaylor2D_comp_1D⟩

  
  
  
  let polyShift : ∀ {J : ℕ}, (Fin (J + 1) → ℂ) → PowerSeries ℂ :=
    fun c => ∑ l : Fin _, PowerSeries.C (c l) * PowerSeries.X ^ (l : ℕ)
  let polyComp : PowerSeries ℂ → PowerSeries ℂ → PowerSeries ℂ :=
    fun φ Z => PowerSeries.mk fun m =>
      ∑ n ∈ Finset.range (m + 1), PowerSeries.coeff n φ * PowerSeries.coeff m (Z ^ n)
  let polyMidShift : ∀ {k J : ℕ}, (Fin (J + 1) → Fin (k + 1) → ℂ) → Fin k → PowerSeries ℂ :=
    fun β i => polyShift (fun l => (β l i.castSucc + β l i.succ) / 2)
  let polyHalfStepShift : ∀ {k J : ℕ}, (Fin (J + 1) → Fin (k + 1) → ℂ) → Fin k → PowerSeries ℂ :=
    fun β i => polyShift (fun l => (β l i.succ - β l i.castSucc) / 2)
  let polySup : ∀ {k J : ℕ}, (ℂ → ℂ) → (Fin k → Fin (J + 1) → ℂ → ℂ) →
      (Fin (k + 1) → ℂ) → (Fin (J + 1) → Fin (k + 1) → ℂ) → Fin k → PowerSeries ℂ :=
    fun h_ℂ g α₀ β i =>
      polyComp (holoTaylor1D h_ℂ (lineChainMid α₀ i)) (polyMidShift β i) +
        ∑ l : Fin _, PowerSeries.X ^ (l : ℕ) *
          polyComp (holoTaylor1D (g i l) (lineChainMid α₀ i)) (polyMidShift β i)
  let polySupDeriv : ∀ {k J : ℕ}, (ℂ → ℂ) → (Fin k → Fin (J + 1) → ℂ → ℂ) →
      (Fin (k + 1) → ℂ) → (Fin (J + 1) → Fin (k + 1) → ℂ) → Fin k → PowerSeries ℂ :=
    fun h_ℂ g α₀ β i =>
      polyComp (holoTaylor1D (deriv h_ℂ) (lineChainMid α₀ i)) (polyMidShift β i) +
        ∑ l : Fin _, PowerSeries.X ^ (l : ℕ) *
          polyComp (holoTaylor1D (deriv (g i l)) (lineChainMid α₀ i)) (polyMidShift β i)
  let polySin : ∀ {k J : ℕ}, (Fin (k + 1) → ℂ) → (Fin (J + 1) → Fin (k + 1) → ℂ) →
      Fin k → PowerSeries ℂ :=
    fun α₀ β i => polyComp (holoTaylor1D Complex.sin (lineChainHalfStep α₀ i))
      (polyHalfStepShift β i)
  let polyCos : ∀ {k J : ℕ}, (Fin (k + 1) → ℂ) → (Fin (J + 1) → Fin (k + 1) → ℂ) →
      Fin k → PowerSeries ℂ :=
    fun α₀ β i => polyComp (holoTaylor1D Complex.cos (lineChainHalfStep α₀ i))
      (polyHalfStepShift β i)
  let polyAct : ∀ {k J : ℕ}, (ℂ → ℂ) → (Fin k → Fin (J + 1) → ℂ → ℂ) →
      (Fin (k + 1) → ℂ) → (Fin (J + 1) → Fin (k + 1) → ℂ) → PowerSeries ℂ :=
    fun h_ℂ g α₀ β => ∑ i : Fin _, 2 * polySup h_ℂ g α₀ β i * polySin α₀ β i
  let polyGrad : ∀ {k J : ℕ}, (ℂ → ℂ) → (Fin k → Fin (J + 1) → ℂ → ℂ) →
      (Fin (k + 1) → ℂ) → (Fin (J + 1) → Fin (k + 1) → ℂ) → Fin (k - 1) → PowerSeries ℂ :=
    fun {k _} h_ℂ g α₀ β r =>
      let i_L : Fin k := ⟨r.1, by have := r.2; omega⟩
      let i_R : Fin k := ⟨r.1 + 1, by have := r.2; omega⟩
      polySupDeriv h_ℂ g α₀ β i_L * polySin α₀ β i_L +
        polySup h_ℂ g α₀ β i_L * polyCos α₀ β i_L +
        polySupDeriv h_ℂ g α₀ β i_R * polySin α₀ β i_R -
        polySup h_ℂ g α₀ β i_R * polyCos α₀ β i_R

  have coeff_polyComp : ∀ (φ Z : PowerSeries ℂ) (m : ℕ),
      PowerSeries.coeff m (polyComp φ Z) =
        ∑ n ∈ Finset.range (m + 1), PowerSeries.coeff n φ * PowerSeries.coeff m (Z ^ n) :=
    fun _ _ m => PowerSeries.coeff_mk m _

  have coeff_polyShift : ∀ {J : ℕ} (c : Fin (J + 1) → ℂ) (n : ℕ),
      PowerSeries.coeff n (polyShift c) = if hn : n < J + 1 then c ⟨n, hn⟩ else 0 := by
    intro J c n
    dsimp only [polyShift]
    rw [map_sum]
    have hterm : ∀ l : Fin (J + 1),
        PowerSeries.coeff n (PowerSeries.C (c l) * PowerSeries.X ^ (l : ℕ)) =
          if n = (l : ℕ) then c l else 0 := by
      intro l
      rw [PowerSeries.coeff_C_mul, PowerSeries.coeff_X_pow]
      split_ifs <;> simp
    simp_rw [hterm]
    split_ifs with hn
    · refine (Finset.sum_eq_single (⟨n, hn⟩ : Fin (J + 1)) ?_ ?_).trans (by simp)
      · intro l _ hl_ne
        have hne : n ≠ (l : ℕ) := fun heq => hl_ne (Fin.ext heq.symm)
        exact ite_eq_right_iff.mpr fun h => (hne h).elim
      · intro hnot
        exact False.elim (hnot (Finset.mem_univ _))
    · refine Finset.sum_eq_zero fun l _ => ?_
      have hne : n ≠ (l : ℕ) := by have := l.2; omega
      exact ite_eq_right_iff.mpr fun h => (hne h).elim

  have hepsJet_poly : ∀ {k J : ℕ} (m : ℕ) {W_ψ : Set ℂ} (hW : IsOpen W_ψ)
      {h_ℂ : ℂ → ℂ} (hh : DifferentiableOn ℂ h_ℂ W_ψ)
      {g : Fin k → Fin (J + 1) → ℂ → ℂ} (hg : ∀ i l, DifferentiableOn ℂ (g i l) W_ψ)
      {α₀ : Fin (k + 1) → ℂ} (hmid : ∀ i : Fin k, lineChainMid α₀ i ∈ W_ψ)
      {β : Fin (J + 1) → Fin (k + 1) → ℂ} (hβ0 : ∀ s, β 0 s = 0),
        lineArcEpsJet m
            (fun ε => lineChainAction (lineArcPertSupport h_ℂ g ε) (lineArcPertAngles α₀ β ε)) =
          PowerSeries.coeff m (polyAct h_ℂ g α₀ β) ∧
        ∀ r : Fin (k - 1),
          lineArcEpsJet m
              (fun ε =>
                lineInteriorGrad (lineArcPertSupport h_ℂ g ε)
                  (lineArcPertSupportDeriv h_ℂ g ε) (lineArcPertAngles α₀ β ε) r) =
            PowerSeries.coeff m (polyGrad h_ℂ g α₀ β r) := by
    let HoloAtZero (F : ℂ → ℂ) : Prop :=
      ∃ U : Set ℂ, IsOpen U ∧ (0 : ℂ) ∈ U ∧ DifferentiableOn ℂ F U
    have hHolo_contDiffAt : ∀ {F : ℂ → ℂ}, HoloAtZero F → ∀ n : WithTop ℕ∞, ContDiffAt ℂ n F 0 := by
      rintro F ⟨U, hU, h0, hF⟩ n
      exact (hF.analyticAt (hU.mem_nhds h0)).contDiffAt
    have hHolo_const : ∀ c : ℂ, HoloAtZero (fun _ => c) :=
      fun c => ⟨Set.univ, isOpen_univ, Set.mem_univ 0, differentiableOn_const c⟩
    have hHolo_id : HoloAtZero (fun ε : ℂ => ε) :=
      ⟨Set.univ, isOpen_univ, Set.mem_univ 0, differentiableOn_id⟩
    have hHolo_add : ∀ {F G : ℂ → ℂ}, HoloAtZero F → HoloAtZero G →
        HoloAtZero (fun ε => F ε + G ε) := by
      rintro F G ⟨U₁, hU₁, h0₁, hF⟩ ⟨U₂, hU₂, h0₂, hG⟩
      exact ⟨U₁ ∩ U₂, hU₁.inter hU₂, ⟨h0₁, h0₂⟩,
        (hF.mono Set.inter_subset_left).add (hG.mono Set.inter_subset_right)⟩
    have hHolo_sub : ∀ {F G : ℂ → ℂ}, HoloAtZero F → HoloAtZero G →
        HoloAtZero (fun ε => F ε - G ε) := by
      rintro F G ⟨U₁, hU₁, h0₁, hF⟩ ⟨U₂, hU₂, h0₂, hG⟩
      exact ⟨U₁ ∩ U₂, hU₁.inter hU₂, ⟨h0₁, h0₂⟩,
        (hF.mono Set.inter_subset_left).sub (hG.mono Set.inter_subset_right)⟩
    have hHolo_mul : ∀ {F G : ℂ → ℂ}, HoloAtZero F → HoloAtZero G →
        HoloAtZero (fun ε => F ε * G ε) := by
      rintro F G ⟨U₁, hU₁, h0₁, hF⟩ ⟨U₂, hU₂, h0₂, hG⟩
      exact ⟨U₁ ∩ U₂, hU₁.inter hU₂, ⟨h0₁, h0₂⟩,
        (hF.mono Set.inter_subset_left).mul (hG.mono Set.inter_subset_right)⟩

    have hTay1D_const : ∀ (c z₀ : ℂ), holoTaylor1D (fun _ => c) z₀ = PowerSeries.C c := by
      intro c z₀
      ext n
      rw [holoTaylor1D, PowerSeries.coeff_mk, PowerSeries.coeff_C, iteratedDeriv_const]
      split_ifs with hn
      · subst hn; simp
      · simp
    have hTay1D_id : holoTaylor1D (fun ε : ℂ => ε) 0 = PowerSeries.X := by
      ext n
      rw [holoTaylor1D, PowerSeries.coeff_mk, PowerSeries.coeff_X]
      rcases n with _ | _ | k
      · simp
      · rw [ite_eq_left_iff.mpr fun h => (h rfl).elim, iteratedDeriv_one, deriv_id'']; norm_num
      · rw [ite_eq_right_iff.mpr (by omega), iteratedDeriv_succ', deriv_id'', iteratedDeriv_const]
        simp
    have hTay1D_add : ∀ {F G : ℂ → ℂ}, HoloAtZero F → HoloAtZero G →
        holoTaylor1D (fun ε => F ε + G ε) 0 = holoTaylor1D F 0 + holoTaylor1D G 0 := by
      intro F G hF hG
      ext n
      rw [map_add, holoTaylor1D, holoTaylor1D, holoTaylor1D,
        PowerSeries.coeff_mk, PowerSeries.coeff_mk, PowerSeries.coeff_mk,
        iteratedDeriv_fun_add (hHolo_contDiffAt hF n) (hHolo_contDiffAt hG n), add_div]
    have hTay1D_sub : ∀ {F G : ℂ → ℂ}, HoloAtZero F → HoloAtZero G →
        holoTaylor1D (fun ε => F ε - G ε) 0 = holoTaylor1D F 0 - holoTaylor1D G 0 := by
      intro F G hF hG
      ext n
      rw [map_sub, holoTaylor1D, holoTaylor1D, holoTaylor1D,
        PowerSeries.coeff_mk, PowerSeries.coeff_mk, PowerSeries.coeff_mk,
        iteratedDeriv_fun_sub (hHolo_contDiffAt hF n) (hHolo_contDiffAt hG n), sub_div]
    have hTay1D_mul : ∀ {F G : ℂ → ℂ}, HoloAtZero F → HoloAtZero G →
        holoTaylor1D (fun ε => F ε * G ε) 0 = holoTaylor1D F 0 * holoTaylor1D G 0 := by
      intro F G hF hG
      ext m
      rw [holoTaylor1D, PowerSeries.coeff_mk, PowerSeries.coeff_mul,
        Finset.Nat.sum_antidiagonal_eq_sum_range_succ
          (fun a b => PowerSeries.coeff a (holoTaylor1D F 0) *
            PowerSeries.coeff b (holoTaylor1D G 0)) m,
        iteratedDeriv_fun_mul (hHolo_contDiffAt hF m) (hHolo_contDiffAt hG m), Finset.sum_div]
      refine Finset.sum_congr rfl fun a ha => ?_
      rw [Finset.mem_range_succ_iff] at ha
      rw [holoTaylor1D, holoTaylor1D, PowerSeries.coeff_mk, PowerSeries.coeff_mk]
      have hfac_nat := Nat.choose_mul_factorial_mul_factorial ha
      have hfac : ((m.choose a : ℂ) * (a.factorial : ℂ) * ((m - a).factorial : ℂ)) =
          (m.factorial : ℂ) := by exact_mod_cast hfac_nat
      have hc_ne : (m.choose a : ℂ) ≠ 0 :=
        Nat.cast_ne_zero.mpr (Nat.ne_of_gt (Nat.choose_pos ha))
      have ha_ne : (a.factorial : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero a)
      have hb_ne : ((m - a).factorial : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)
      rw [← hfac]
      field_simp
    have hTay1D_pow : ∀ {F : ℂ → ℂ}, HoloAtZero F → ∀ n : ℕ,
        HoloAtZero (fun ε => F ε ^ n) ∧
        holoTaylor1D (fun ε => F ε ^ n) 0 = (holoTaylor1D F 0) ^ n := by
      intro F hF n
      induction n with
      | zero =>
        refine ⟨hHolo_const 1, ?_⟩
        simpa using hTay1D_const 1 0
      | succ n ih =>
        have hfn : (fun ε => F ε ^ (n + 1)) = (fun ε => F ε ^ n * F ε) := by
          ext ε; exact pow_succ (F ε) n
        rw [hfn, pow_succ]
        exact ⟨hHolo_mul ih.1 hF, (hTay1D_mul ih.1 hF).trans (by rw [ih.2])⟩
    have hTay1D_sum : ∀ {ι : Type} (s : Finset ι) (F : ι → ℂ → ℂ),
        (∀ i ∈ s, HoloAtZero (F i)) →
        HoloAtZero (fun ε => ∑ i ∈ s, F i ε) ∧
        holoTaylor1D (fun ε => ∑ i ∈ s, F i ε) 0 = ∑ i ∈ s, holoTaylor1D (F i) 0 := by
      intro ι s F hF
      classical
      induction s using Finset.induction_on with
      | empty =>
        refine ⟨hHolo_const 0, ?_⟩
        simpa using hTay1D_const 0 0
      | @insert a s ha ih =>
        have hF_a : HoloAtZero (F a) := hF a (Finset.mem_insert_self a s)
        have hF_s := ih (fun i hi => hF i (Finset.mem_insert_of_mem hi))
        have hfn : (fun ε => ∑ i ∈ insert a s, F i ε) =
            (fun ε => F a ε + ∑ i ∈ s, F i ε) := by
          ext ε; exact Finset.sum_insert ha
        rw [hfn, Finset.sum_insert ha]
        exact ⟨hHolo_add hF_a hF_s.1, (hTay1D_add hF_a hF_s.1).trans (by rw [hF_s.2])⟩

    let iterDslope (z₀ : ℂ) (n : ℕ) (G : ℂ → ℂ) : ℂ → ℂ :=
      ((fun f : ℂ → ℂ => dslope f z₀)^[n]) G
    have hiterDslope_holo : ∀ {W : Set ℂ}, IsOpen W → ∀ {z₀ : ℂ}, z₀ ∈ W →
        ∀ {G : ℂ → ℂ}, DifferentiableOn ℂ G W →
          ∀ n : ℕ, DifferentiableOn ℂ (iterDslope z₀ n G) W := by
      intro W hW z₀ hz₀ G hG n
      induction n with
      | zero => exact hG
      | succ n ih =>
        have hstep : iterDslope z₀ (n + 1) G = dslope (iterDslope z₀ n G) z₀ :=
          Function.iterate_succ_apply' _ n G
        rw [hstep]
        exact (Complex.differentiableOn_dslope (hW.mem_nhds hz₀)).mpr ih

    have hdslope_step_deriv : ∀ {W : Set ℂ}, IsOpen W → ∀ {z₀ : ℂ}, z₀ ∈ W →
        ∀ {f : ℂ → ℂ}, DifferentiableOn ℂ f W → ∀ k : ℕ,
          iteratedDeriv (k + 1) f z₀ =
            ((k + 1 : ℕ) : ℂ) * iteratedDeriv k (dslope f z₀) z₀ := by
      intro W hW z₀ hz₀ f hf k
      have hf_eq : f = fun z => f z₀ + (z - z₀) * dslope f z₀ z := by
        ext z
        have h := sub_smul_dslope f z₀ z
        rw [smul_eq_mul] at h
        linear_combination -h
      have hd_holo : DifferentiableOn ℂ (dslope f z₀) W :=
        (Complex.differentiableOn_dslope (hW.mem_nhds hz₀)).mpr hf
      have hd_cd : ContDiffAt ℂ (k + 1 : ℕ) (dslope f z₀) z₀ :=
        (hd_holo.analyticAt (hW.mem_nhds hz₀)).contDiffAt
      have hlin_cd : ContDiffAt ℂ (k + 1 : ℕ) (fun z : ℂ => z - z₀) z₀ :=
        contDiffAt_id.sub contDiffAt_const
      have hmul_cd : ContDiffAt ℂ (k + 1 : ℕ) (fun z : ℂ => (z - z₀) * dslope f z₀ z) z₀ :=
        hlin_cd.mul hd_cd
      conv_lhs => rw [hf_eq]
      rw [iteratedDeriv_fun_add contDiffAt_const hmul_cd, iteratedDeriv_const,
        ite_eq_right_iff.mpr fun h => (Nat.succ_ne_zero k h).elim, zero_add,
        iteratedDeriv_fun_mul hlin_cd hd_cd]
      rw [Finset.sum_eq_single 1 ?_ ?_]
      · rw [Nat.choose_one_right, iteratedDeriv_one, deriv_sub_const, deriv_id'',
          Nat.add_sub_cancel, mul_one]
      · intro a _ ha_ne
        rcases a with _ | _ | b
        · simp
        · exact False.elim (ha_ne rfl)
        · have hd_sub : deriv (fun z : ℂ => z - z₀) = fun _ => (1 : ℂ) := by
            ext z; rw [deriv_sub_const, deriv_id'']
          rw [iteratedDeriv_succ', hd_sub, iteratedDeriv_const]
          simp
      · intro hnot
        exact False.elim (hnot (Finset.mem_range.mpr (by omega)))

    have hiterDslope_val : ∀ {W : Set ℂ}, IsOpen W → ∀ {z₀ : ℂ}, z₀ ∈ W →
        ∀ (n : ℕ) {G : ℂ → ℂ}, DifferentiableOn ℂ G W →
          iterDslope z₀ n G z₀ = PowerSeries.coeff n (holoTaylor1D G z₀) := by
      intro W hW z₀ hz₀ n
      have hind : ∀ (n : ℕ) {G : ℂ → ℂ}, DifferentiableOn ℂ G W →
          iteratedDeriv n G z₀ = (n.factorial : ℂ) * iterDslope z₀ n G z₀ := by
        intro n
        induction n with
        | zero => intro G _; simp [iterDslope]
        | succ n ih =>
          intro G hG
          have hd_holo : DifferentiableOn ℂ (dslope G z₀) W :=
            (Complex.differentiableOn_dslope (hW.mem_nhds hz₀)).mpr hG
          have hshift : iterDslope z₀ (n + 1) G = iterDslope z₀ n (dslope G z₀) :=
            Function.iterate_succ_apply _ n G
          rw [hdslope_step_deriv hW hz₀ hG n, ih hd_holo, hshift, Nat.factorial_succ, Nat.cast_mul,
            mul_assoc]
      intro G hG
      rw [holoTaylor1D, PowerSeries.coeff_mk, hind n hG,
        mul_div_cancel_left₀ _ (Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero n))]

    have hiterDslope_expand : ∀ (z₀ : ℂ) (G : ℂ → ℂ) (M : ℕ) (z : ℂ),
        G z = (∑ n ∈ Finset.range (M + 1), iterDslope z₀ n G z₀ * (z - z₀) ^ n) +
          (z - z₀) ^ (M + 1) * iterDslope z₀ (M + 1) G z := by
      intro z₀ G M z
      induction M with
      | zero =>
        have h := sub_smul_dslope G z₀ z
        rw [smul_eq_mul] at h
        dsimp only [iterDslope]
        simp only [Nat.zero_add, Finset.range_one, Finset.sum_singleton, pow_zero, mul_one, pow_one,
          Function.iterate_zero_apply, Function.iterate_one]
        linear_combination -h
      | succ M ih =>
        have hstep := sub_smul_dslope (iterDslope z₀ (M + 1) G) z₀ z
        rw [smul_eq_mul] at hstep
        have hsucc : iterDslope z₀ (M + 1 + 1) G z = dslope (iterDslope z₀ (M + 1) G) z₀ z :=
          congr_fun (Function.iterate_succ_apply' _ (M + 1) G) z
        rw [Finset.sum_range_succ, pow_succ (z - z₀) (M + 1), hsucc]
        linear_combination ih - (z - z₀) ^ (M + 1) * hstep

    have hTay1D_comp : ∀ {W : Set ℂ}, IsOpen W → ∀ {z₀ : ℂ}, z₀ ∈ W →
        ∀ {G : ℂ → ℂ}, DifferentiableOn ℂ G W →
        ∀ {z_tilde : ℂ → ℂ}, HoloAtZero z_tilde → z_tilde 0 = 0 →
          HoloAtZero (fun ε => G (z₀ + z_tilde ε)) ∧
          holoTaylor1D (fun ε => G (z₀ + z_tilde ε)) 0 =
            polyComp (holoTaylor1D G z₀) (holoTaylor1D z_tilde 0) := by
      intro W hW z₀ hz₀ G hG z_tilde hz_holo hz0
      obtain ⟨U_z, hU_z, h0_z, hz_diff⟩ := hz_holo
      have hz_h0 : HoloAtZero z_tilde := ⟨U_z, hU_z, h0_z, hz_diff⟩
      let U' : Set ℂ := U_z ∩ (fun ε => z₀ + z_tilde ε) ⁻¹' W
      have hshift_cont : ContinuousOn (fun ε => z₀ + z_tilde ε) U_z :=
        continuousOn_const.add hz_diff.continuousOn
      have hU'_open : IsOpen U' := hshift_cont.isOpen_inter_preimage hU_z hW
      have h0_U' : (0 : ℂ) ∈ U' := ⟨h0_z, by simp [hz0, hz₀]⟩
      have hcomp_holo : HoloAtZero (fun ε => G (z₀ + z_tilde ε)) :=
        ⟨U', hU'_open, h0_U',
          hG.comp (differentiableOn_const z₀ |>.add (hz_diff.mono Set.inter_subset_left))
            fun _ hε => hε.2⟩
      refine ⟨hcomp_holo, ?_⟩
      ext m
      rw [coeff_polyComp]
      have hd_z : HoloAtZero (dslope z_tilde 0) :=
        ⟨U_z, hU_z, h0_z, (Complex.differentiableOn_dslope (hU_z.mem_nhds h0_z)).mpr hz_diff⟩
      have hrem_comp_holo : HoloAtZero (fun ε => iterDslope z₀ (m + 1) G (z₀ + z_tilde ε)) :=
        ⟨U', hU'_open, h0_U',
          (hiterDslope_holo hW hz₀ hG (m + 1)).comp
            (differentiableOn_const z₀ |>.add (hz_diff.mono Set.inter_subset_left))
            fun _ hε => hε.2⟩
      let Q : ℂ → ℂ := fun ε =>
        (dslope z_tilde 0 ε) ^ (m + 1) * iterDslope z₀ (m + 1) G (z₀ + z_tilde ε)
      have hQ_holo : HoloAtZero Q := hHolo_mul (hTay1D_pow hd_z (m + 1)).1 hrem_comp_holo
      have hfn_eq : (fun ε => G (z₀ + z_tilde ε)) =
          fun ε =>
            (∑ n ∈ Finset.range (m + 1),
              PowerSeries.coeff n (holoTaylor1D G z₀) * (z_tilde ε) ^ n) +
            ε ^ (m + 1) * Q ε := by
        ext ε
        have hexp := hiterDslope_expand z₀ G m (z₀ + z_tilde ε)
        have hsub : (z₀ + z_tilde ε) - z₀ = z_tilde ε := add_sub_cancel_left z₀ (z_tilde ε)
        rw [hsub] at hexp
        have hpow_fac : (z_tilde ε) ^ (m + 1) = ε ^ (m + 1) * (dslope z_tilde 0 ε) ^ (m + 1) := by
          have hs := sub_smul_dslope z_tilde 0 ε
          rw [sub_zero, hz0, sub_zero, smul_eq_mul] at hs
          rw [← hs, mul_pow]
        rw [hexp]
        congr 1
        · refine Finset.sum_congr rfl fun n _ => ?_
          rw [hiterDslope_val hW hz₀ n hG]
        · dsimp only [Q]
          rw [hpow_fac, mul_assoc]
      have hsum_part := hTay1D_sum (Finset.range (m + 1))
        (fun n ε => PowerSeries.coeff n (holoTaylor1D G z₀) * (z_tilde ε) ^ n)
        (fun n _ => hHolo_mul (hHolo_const _) (hTay1D_pow hz_h0 n).1)
      have hrem_part_holo : HoloAtZero (fun ε => ε ^ (m + 1) * Q ε) :=
        hHolo_mul (hTay1D_pow hHolo_id (m + 1)).1 hQ_holo
      rw [hfn_eq, hTay1D_add hsum_part.1 hrem_part_holo, map_add, hsum_part.2,
        hTay1D_mul (hTay1D_pow hHolo_id (m + 1)).1 hQ_holo,
        (hTay1D_pow hHolo_id (m + 1)).2, hTay1D_id,
        PowerSeries.coeff_X_pow_mul', ite_eq_right_iff.mpr (by omega), add_zero, map_sum]
      refine Finset.sum_congr rfl fun n _ => ?_
      rw [hTay1D_mul (hHolo_const _) (hTay1D_pow hz_h0 n).1,
        hTay1D_const, (hTay1D_pow hz_h0 n).2,
        PowerSeries.coeff_C_mul]

    intro k J m W_ψ hW h_ℂ hh g hg α₀ hmid β hβ0
    have hshift_eval : ∀ (c : Fin (J + 1) → ℂ), c 0 = 0 →
        HoloAtZero (fun ε : ℂ => ∑ l : Fin (J + 1), c l * ε ^ (l : ℕ)) ∧
        (∑ l : Fin (J + 1), c l * (0 : ℂ) ^ (l : ℕ)) = 0 ∧
        holoTaylor1D (fun ε : ℂ => ∑ l : Fin (J + 1), c l * ε ^ (l : ℕ)) 0 = polyShift c := by
      intro c hc0
      have hs := hTay1D_sum (Finset.univ : Finset (Fin (J + 1)))
        (fun (l : Fin (J + 1)) (ε : ℂ) => c l * ε ^ (l : ℕ))
        (fun l _ => hHolo_mul (hHolo_const (c l)) (hTay1D_pow hHolo_id (l : ℕ)).1)
      refine ⟨hs.1, ?_, ?_⟩
      · refine Finset.sum_eq_zero fun l _ => ?_
        by_cases hl0 : l = 0
        · subst hl0; simp [hc0]
        · have hne : (l : ℕ) ≠ 0 := fun h0 => hl0 (Fin.ext h0)
          rw [zero_pow hne, mul_zero]
      · rw [hs.2]
        refine Finset.sum_congr rfl fun l _ => ?_
        rw [hTay1D_mul (hHolo_const (c l)) (hTay1D_pow hHolo_id (l : ℕ)).1,
          hTay1D_const, (hTay1D_pow hHolo_id (l : ℕ)).2, hTay1D_id]
    let pertAng : ℂ → Fin (k + 1) → ℂ := lineArcPertAngles α₀ β
    let ψ_tilde : Fin k → ℂ → ℂ := fun i ε =>
      ∑ l : Fin (J + 1), ((β l i.castSucc + β l i.succ) / 2) * ε ^ (l : ℕ)
    let d_tilde : Fin k → ℂ → ℂ := fun i ε =>
      ∑ l : Fin (J + 1), ((β l i.succ - β l i.castSucc) / 2) * ε ^ (l : ℕ)
    have hmid_eq : ∀ (i : Fin k) (ε : ℂ),
        lineChainMid (pertAng ε) i = lineChainMid α₀ i + ψ_tilde i ε := by
      intro i ε
      dsimp only [lineChainMid, pertAng, lineArcPertAngles, ψ_tilde]
      rw [add_add_add_comm, add_div, ← Finset.sum_add_distrib, Finset.sum_div]
      congr 1
      refine Finset.sum_congr rfl fun l _ => by ring
    have hd_eq : ∀ (i : Fin k) (ε : ℂ),
        lineChainHalfStep (pertAng ε) i = lineChainHalfStep α₀ i + d_tilde i ε := by
      intro i ε
      dsimp only [lineChainHalfStep, pertAng, lineArcPertAngles, d_tilde]
      have hsub : (α₀ i.succ + ∑ l : Fin (J + 1), ε ^ (l : ℕ) * β l i.succ) -
          (α₀ i.castSucc + ∑ l : Fin (J + 1), ε ^ (l : ℕ) * β l i.castSucc) =
          (α₀ i.succ - α₀ i.castSucc) +
            ∑ l : Fin (J + 1), (ε ^ (l : ℕ) * β l i.succ - ε ^ (l : ℕ) * β l i.castSucc) := by
        rw [Finset.sum_sub_distrib]; ring
      rw [hsub, add_div, Finset.sum_div]
      congr 1
      refine Finset.sum_congr rfl fun l _ => by ring
    have hψ_props : ∀ i : Fin k,
        HoloAtZero (ψ_tilde i) ∧ ψ_tilde i 0 = 0 ∧
        holoTaylor1D (ψ_tilde i) 0 = polyMidShift β i :=
      fun i => hshift_eval _ (by simp [hβ0])
    have hd_props : ∀ i : Fin k,
        HoloAtZero (d_tilde i) ∧ d_tilde i 0 = 0 ∧
        holoTaylor1D (d_tilde i) 0 = polyHalfStepShift β i :=
      fun i => hshift_eval _ (by simp [hβ0])
    have hsup_eval : ∀ i : Fin k,
        HoloAtZero (fun ε => lineArcPertSupport h_ℂ g ε i (lineChainMid (pertAng ε) i)) ∧
        holoTaylor1D (fun ε => lineArcPertSupport h_ℂ g ε i (lineChainMid (pertAng ε) i)) 0 =
          polySup h_ℂ g α₀ β i := by
      intro i
      simp_rw [hmid_eq i, lineArcPertSupport]
      have hc0 := hTay1D_comp hW (hmid i) hh (hψ_props i).1 (hψ_props i).2.1
      have hcs : ∀ l : Fin (J + 1),
          HoloAtZero (fun ε => ε ^ (l : ℕ) * g i l (lineChainMid α₀ i + ψ_tilde i ε)) ∧
          holoTaylor1D (fun ε => ε ^ (l : ℕ) * g i l (lineChainMid α₀ i + ψ_tilde i ε)) 0 =
            PowerSeries.X ^ (l : ℕ) *
              polyComp (holoTaylor1D (g i l) (lineChainMid α₀ i)) (polyMidShift β i) := by
        intro l
        have hcl := hTay1D_comp hW (hmid i) (hg i l) (hψ_props i).1 (hψ_props i).2.1
        have hp := hTay1D_pow hHolo_id (l : ℕ)
        refine ⟨hHolo_mul hp.1 hcl.1, ?_⟩
        rw [hTay1D_mul hp.1 hcl.1, hp.2, hTay1D_id, hcl.2, (hψ_props i).2.2]
      have hsum := hTay1D_sum (Finset.univ : Finset (Fin (J + 1)))
        (fun (l : Fin (J + 1)) ε => ε ^ (l : ℕ) * g i l (lineChainMid α₀ i + ψ_tilde i ε))
        (fun l _ => (hcs l).1)
      refine ⟨hHolo_add hc0.1 hsum.1, ?_⟩
      rw [hTay1D_add hc0.1 hsum.1, hc0.2, (hψ_props i).2.2, hsum.2]
      dsimp only [polySup]
      congr 1
      exact Finset.sum_congr rfl fun l _ => (hcs l).2
    have hsupDeriv_eval : ∀ i : Fin k,
        HoloAtZero (fun ε => lineArcPertSupportDeriv h_ℂ g ε i (lineChainMid (pertAng ε) i)) ∧
        holoTaylor1D (fun ε => lineArcPertSupportDeriv h_ℂ g ε i (lineChainMid (pertAng ε) i)) 0 =
          polySupDeriv h_ℂ g α₀ β i := by
      intro i
      simp_rw [hmid_eq i, lineArcPertSupportDeriv]
      have hc0 := hTay1D_comp hW (hmid i) (hh.deriv hW) (hψ_props i).1 (hψ_props i).2.1
      have hcs : ∀ l : Fin (J + 1),
          HoloAtZero (fun ε => ε ^ (l : ℕ) * deriv (g i l) (lineChainMid α₀ i + ψ_tilde i ε)) ∧
          holoTaylor1D (fun ε => ε ^ (l : ℕ) * deriv (g i l) (lineChainMid α₀ i + ψ_tilde i ε)) 0 =
            PowerSeries.X ^ (l : ℕ) *
              polyComp (holoTaylor1D (deriv (g i l)) (lineChainMid α₀ i)) (polyMidShift β i) := by
        intro l
        have hcl := hTay1D_comp hW (hmid i) ((hg i l).deriv hW) (hψ_props i).1 (hψ_props i).2.1
        have hp := hTay1D_pow hHolo_id (l : ℕ)
        refine ⟨hHolo_mul hp.1 hcl.1, ?_⟩
        rw [hTay1D_mul hp.1 hcl.1, hp.2, hTay1D_id, hcl.2, (hψ_props i).2.2]
      have hsum := hTay1D_sum (Finset.univ : Finset (Fin (J + 1)))
        (fun (l : Fin (J + 1)) ε =>
          ε ^ (l : ℕ) * deriv (g i l) (lineChainMid α₀ i + ψ_tilde i ε))
        (fun l _ => (hcs l).1)
      refine ⟨hHolo_add hc0.1 hsum.1, ?_⟩
      rw [hTay1D_add hc0.1 hsum.1, hc0.2, (hψ_props i).2.2, hsum.2]
      dsimp only [polySupDeriv]
      congr 1
      exact Finset.sum_congr rfl fun l _ => (hcs l).2
    have hsin_eval : ∀ i : Fin k,
        HoloAtZero (fun ε => Complex.sin (lineChainHalfStep (pertAng ε) i)) ∧
        holoTaylor1D (fun ε => Complex.sin (lineChainHalfStep (pertAng ε) i)) 0 =
          polySin α₀ β i := by
      intro i
      simp_rw [hd_eq i]
      have hc := hTay1D_comp isOpen_univ (Set.mem_univ (lineChainHalfStep α₀ i))
        Complex.differentiable_sin.differentiableOn (hd_props i).1 (hd_props i).2.1
      exact ⟨hc.1, hc.2.trans (by rw [(hd_props i).2.2])⟩
    have hcos_eval : ∀ i : Fin k,
        HoloAtZero (fun ε => Complex.cos (lineChainHalfStep (pertAng ε) i)) ∧
        holoTaylor1D (fun ε => Complex.cos (lineChainHalfStep (pertAng ε) i)) 0 =
          polyCos α₀ β i := by
      intro i
      simp_rw [hd_eq i]
      have hc := hTay1D_comp isOpen_univ (Set.mem_univ (lineChainHalfStep α₀ i))
        Complex.differentiable_cos.differentiableOn (hd_props i).1 (hd_props i).2.1
      exact ⟨hc.1, hc.2.trans (by rw [(hd_props i).2.2])⟩
    have hjet_eq_coeff : ∀ F : ℂ → ℂ,
        lineArcEpsJet m F = PowerSeries.coeff m (holoTaylor1D F 0) := by
      intro F
      rw [holoTaylor1D, PowerSeries.coeff_mk]
      rfl
    refine ⟨?_, ?_⟩
    · rw [hjet_eq_coeff]
      unfold lineChainAction
      have hterms : ∀ i : Fin k,
          HoloAtZero (fun ε =>
            2 * lineArcPertSupport h_ℂ g ε i (lineChainMid (pertAng ε) i) *
              Complex.sin (lineChainHalfStep (pertAng ε) i)) ∧
          holoTaylor1D (fun ε =>
            2 * lineArcPertSupport h_ℂ g ε i (lineChainMid (pertAng ε) i) *
              Complex.sin (lineChainHalfStep (pertAng ε) i)) 0 =
            2 * polySup h_ℂ g α₀ β i * polySin α₀ β i := by
        intro i
        have hm1 := hHolo_mul (hHolo_const 2) (hsup_eval i).1
        refine ⟨hHolo_mul hm1 (hsin_eval i).1, ?_⟩
        rw [hTay1D_mul hm1 (hsin_eval i).1, hTay1D_mul (hHolo_const 2) (hsup_eval i).1,
          hTay1D_const, (hsup_eval i).2, (hsin_eval i).2]
        have hC2 : (PowerSeries.C (2 : ℂ) : PowerSeries ℂ) = 2 := map_ofNat PowerSeries.C 2
        rw [hC2]
      have hsum := hTay1D_sum (Finset.univ : Finset (Fin k))
        (fun i ε => 2 * lineArcPertSupport h_ℂ g ε i (lineChainMid (pertAng ε) i) *
          Complex.sin (lineChainHalfStep (pertAng ε) i))
        (fun i _ => (hterms i).1)
      rw [hsum.2]
      congr 1
      exact Finset.sum_congr rfl fun i _ => (hterms i).2
    · intro r
      rw [hjet_eq_coeff]
      unfold lineInteriorGrad
      dsimp only
      let i_L : Fin k := ⟨r.1, by have := r.2; omega⟩
      let i_R : Fin k := ⟨r.1 + 1, by have := r.2; omega⟩
      have ht1_holo := hHolo_mul (hsupDeriv_eval i_L).1 (hsin_eval i_L).1
      have ht2_holo := hHolo_mul (hsup_eval i_L).1 (hcos_eval i_L).1
      have ht3_holo := hHolo_mul (hsupDeriv_eval i_R).1 (hsin_eval i_R).1
      have ht4_holo := hHolo_mul (hsup_eval i_R).1 (hcos_eval i_R).1
      have h12_holo := hHolo_add ht1_holo ht2_holo
      have h123_holo := hHolo_add h12_holo ht3_holo
      rw [hTay1D_sub h123_holo ht4_holo, hTay1D_add h12_holo ht3_holo,
        hTay1D_add ht1_holo ht2_holo,
        hTay1D_mul (hsupDeriv_eval i_L).1 (hsin_eval i_L).1,
        hTay1D_mul (hsup_eval i_L).1 (hcos_eval i_L).1,
        hTay1D_mul (hsupDeriv_eval i_R).1 (hsin_eval i_R).1,
        hTay1D_mul (hsup_eval i_R).1 (hcos_eval i_R).1,
        (hsupDeriv_eval i_L).2, (hsin_eval i_L).2,
        (hsup_eval i_L).2, (hcos_eval i_L).2,
        (hsupDeriv_eval i_R).2, (hsin_eval i_R).2,
        (hsup_eval i_R).2, (hcos_eval i_R).2]

  
  
  
  let PsEqUpTo (L : ℕ) (P Q : PowerSeries ℂ) : Prop :=
    ∀ n ≤ L, PowerSeries.coeff n P = PowerSeries.coeff n Q
  have hEq_add : ∀ {L : ℕ} {P₁ P₂ Q₁ Q₂ : PowerSeries ℂ},
      PsEqUpTo L P₁ P₂ → PsEqUpTo L Q₁ Q₂ → PsEqUpTo L (P₁ + Q₁) (P₂ + Q₂) :=
    fun hP hQ n hn => by rw [map_add, map_add, hP n hn, hQ n hn]
  have hEq_sub : ∀ {L : ℕ} {P₁ P₂ Q₁ Q₂ : PowerSeries ℂ},
      PsEqUpTo L P₁ P₂ → PsEqUpTo L Q₁ Q₂ → PsEqUpTo L (P₁ - Q₁) (P₂ - Q₂) :=
    fun hP hQ n hn => by rw [map_sub, map_sub, hP n hn, hQ n hn]
  have hEq_mul : ∀ {L : ℕ} {P₁ P₂ Q₁ Q₂ : PowerSeries ℂ},
      PsEqUpTo L P₁ P₂ → PsEqUpTo L Q₁ Q₂ → PsEqUpTo L (P₁ * Q₁) (P₂ * Q₂) := by
    intro L P₁ P₂ Q₁ Q₂ hP hQ n hn
    rw [PowerSeries.coeff_mul, PowerSeries.coeff_mul]
    refine Finset.sum_congr rfl fun p hp => ?_
    rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp
    rw [hP p.1 (by omega), hQ p.2 (by omega)]
  have hEq_pow : ∀ {L : ℕ} {Z₁ Z₂ : PowerSeries ℂ},
      PsEqUpTo L Z₁ Z₂ → ∀ a : ℕ, PsEqUpTo L (Z₁ ^ a) (Z₂ ^ a) := by
    intro L Z₁ Z₂ hZ a
    induction a with
    | zero => intro _ _; rfl
    | succ a ih =>
      rw [pow_succ, pow_succ]
      exact hEq_mul ih hZ
  have hEq_comp : ∀ {L : ℕ} (φ₁ φ₂ : PowerSeries ℂ) {Z₁ Z₂ : PowerSeries ℂ},
      φ₁ = φ₂ → PsEqUpTo L Z₁ Z₂ → PsEqUpTo L (polyComp φ₁ Z₁) (polyComp φ₂ Z₂) := by
    intro L φ₁ φ₂ Z₁ Z₂ hφ hZ n hn
    subst hφ
    rw [coeff_polyComp, coeff_polyComp]
    exact Finset.sum_congr rfl fun a _ => by rw [hEq_pow hZ a n hn]

  have hepsJet_trunc_eq : ∀ {k J₁ J₂ l : ℕ} (_hJ : J₁ ≤ J₂) (_hl1 : 1 ≤ l) (_hlJ : l ≤ J₁)
      {W_ψ : Set ℂ} (_hW : IsOpen W_ψ) {h_ℂ : ℂ → ℂ} (_hh : DifferentiableOn ℂ h_ℂ W_ψ)
      {g₁ : Fin k → Fin (J₁ + 1) → ℂ → ℂ} {g₂ : Fin k → Fin (J₂ + 1) → ℂ → ℂ}
      (_hg₁ : ∀ i m, DifferentiableOn ℂ (g₁ i m) W_ψ)
      (_hg₂ : ∀ i m, DifferentiableOn ℂ (g₂ i m) W_ψ)
      (_hg₁0 : ∀ i z, g₁ i 0 z = 0) (_hg₂0 : ∀ i z, g₂ i 0 z = 0)
      (_hg_eq : ∀ i (m : Fin (J₁ + 1)), ∀ z ∈ W_ψ, g₂ i ⟨m.1, by omega⟩ z = g₁ i m z)
      {α₀ : Fin (k + 1) → ℂ} (_hmid : ∀ i : Fin k, lineChainMid α₀ i ∈ W_ψ)
      {β₁ : Fin (J₁ + 1) → Fin (k + 1) → ℂ} {β₂ : Fin (J₂ + 1) → Fin (k + 1) → ℂ}
      (_hβ₁0 : ∀ s, β₁ 0 s = 0) (_hβ₂0 : ∀ s, β₂ 0 s = 0)
      (_hβ_eq : ∀ (m : Fin (J₁ + 1)) s, β₂ ⟨m.1, by omega⟩ s = β₁ m s),
      lineArcEpsJet l
          (fun ε => lineChainAction (lineArcPertSupport h_ℂ g₂ ε) (lineArcPertAngles α₀ β₂ ε)) =
        lineArcEpsJet l
          (fun ε => lineChainAction (lineArcPertSupport h_ℂ g₁ ε) (lineArcPertAngles α₀ β₁ ε)) ∧
      ∀ r : Fin (k - 1),
        lineArcEpsJet l
            (fun ε =>
              lineInteriorGrad (lineArcPertSupport h_ℂ g₂ ε)
                (lineArcPertSupportDeriv h_ℂ g₂ ε) (lineArcPertAngles α₀ β₂ ε) r) =
          lineArcEpsJet l
            (fun ε =>
              lineInteriorGrad (lineArcPertSupport h_ℂ g₁ ε)
                (lineArcPertSupportDeriv h_ℂ g₁ ε) (lineArcPertAngles α₀ β₁ ε) r) := by
    intro k J₁ J₂ l hJ _hl1 hlJ W_ψ hW h_ℂ hh g₁ g₂ hg₁ hg₂ _ _ hg_eq α₀ hmid β₁ β₂ hβ₁0 hβ₂0 hβ_eq
    have hev₂ := hepsJet_poly l hW hh hg₂ hmid hβ₂0
    have hev₁ := hepsJet_poly l hW hh hg₁ hmid hβ₁0
    have hshift_eq : ∀ (c₁ : Fin (J₁ + 1) → ℂ) (c₂ : Fin (J₂ + 1) → ℂ),
        (∀ m : Fin (J₁ + 1), c₂ ⟨m.1, by omega⟩ = c₁ m) →
        PsEqUpTo l (polyShift c₂) (polyShift c₁) := by
      intro c₁ c₂ hc n hn
      rw [coeff_polyShift, coeff_polyShift]
      split_ifs with h2 h1
      · exact hc ⟨n, h1⟩
      · omega
      · omega
      · rfl
    have hmid_shift : ∀ i : Fin k, PsEqUpTo l (polyMidShift β₂ i) (polyMidShift β₁ i) :=
      fun i => hshift_eq _ _ fun m => by simp [hβ_eq m]
    have hd_shift : ∀ i : Fin k, PsEqUpTo l (polyHalfStepShift β₂ i) (polyHalfStepShift β₁ i) :=
      fun i => hshift_eq _ _ fun m => by simp [hβ_eq m]
    have hpert_sum : ∀ (i : Fin k) (F₁ : Fin (J₁ + 1) → ℂ → ℂ) (F₂ : Fin (J₂ + 1) → ℂ → ℂ),
        (∀ m : Fin (J₁ + 1), ∀ z ∈ W_ψ, F₂ ⟨m.1, by omega⟩ z = F₁ m z) →
        PsEqUpTo l
          (∑ m : Fin (J₂ + 1), PowerSeries.X ^ (m : ℕ) *
            polyComp (holoTaylor1D (F₂ m) (lineChainMid α₀ i)) (polyMidShift β₂ i))
          (∑ m : Fin (J₁ + 1), PowerSeries.X ^ (m : ℕ) *
            polyComp (holoTaylor1D (F₁ m) (lineChainMid α₀ i)) (polyMidShift β₁ i)) := by
      intro i F₁ F₂ hF_eq n hn
      rw [map_sum, map_sum]
      simp_rw [PowerSeries.coeff_X_pow_mul']
      rw [← Finset.sum_filter, ← Finset.sum_filter]
      refine Finset.sum_bij'
        (fun m hm => ⟨m.1, by have := (Finset.mem_filter.mp hm).2; omega⟩)
        (fun m _ => ⟨m.1, by omega⟩)
        ?_ ?_ ?_ ?_ ?_
      · intro m hm
        exact Finset.mem_filter.mpr ⟨Finset.mem_univ _, (Finset.mem_filter.mp hm).2⟩
      · intro m hm
        exact Finset.mem_filter.mpr ⟨Finset.mem_univ _, (Finset.mem_filter.mp hm).2⟩
      · intro _ _; ext; rfl
      · intro _ _; ext; rfl
      · intro m hm
        let m₁ : Fin (J₁ + 1) := ⟨m.1, by have := (Finset.mem_filter.mp hm).2; omega⟩
        have hTay_eq : holoTaylor1D (F₂ m) (lineChainMid α₀ i) =
            holoTaylor1D (F₁ m₁) (lineChainMid α₀ i) := by
          ext a
          rw [holoTaylor1D, holoTaylor1D, PowerSeries.coeff_mk, PowerSeries.coeff_mk]
          have hev : F₂ m =ᶠ[nhds (lineChainMid α₀ i)] F₁ m₁ :=
            Filter.eventuallyEq_of_mem (hW.mem_nhds (hmid i)) (hF_eq m₁)
          rw [hev.iteratedDeriv_eq a]
        exact hEq_comp _ _ hTay_eq (hmid_shift i) (n - m.1) (by omega)
    have hsup_eq : ∀ i : Fin k,
        PsEqUpTo l (polySup h_ℂ g₂ α₀ β₂ i) (polySup h_ℂ g₁ α₀ β₁ i) :=
      fun i => hEq_add (hEq_comp _ _ rfl (hmid_shift i)) (hpert_sum i (g₁ i) (g₂ i) (hg_eq i))
    have hsupD_eq : ∀ i : Fin k,
        PsEqUpTo l (polySupDeriv h_ℂ g₂ α₀ β₂ i) (polySupDeriv h_ℂ g₁ α₀ β₁ i) := by
      intro i
      refine hEq_add (hEq_comp _ _ rfl (hmid_shift i))
        (hpert_sum i (fun m => deriv (g₁ i m)) (fun m => deriv (g₂ i m)) ?_)
      intro m z hz
      have hev : g₂ i ⟨m.1, by omega⟩ =ᶠ[nhds z] g₁ i m :=
        Filter.eventuallyEq_of_mem (hW.mem_nhds hz) (hg_eq i m)
      exact hev.deriv_eq
    have hsin_eq : ∀ i : Fin k, PsEqUpTo l (polySin α₀ β₂ i) (polySin α₀ β₁ i) :=
      fun i => hEq_comp _ _ rfl (hd_shift i)
    have hcos_eq : ∀ i : Fin k, PsEqUpTo l (polyCos α₀ β₂ i) (polyCos α₀ β₁ i) :=
      fun i => hEq_comp _ _ rfl (hd_shift i)
    refine ⟨?_, ?_⟩
    · rw [hev₂.1, hev₁.1]
      dsimp only [polyAct]
      rw [map_sum, map_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      exact hEq_mul (hEq_mul (fun _ _ => rfl) (hsup_eq i)) (hsin_eq i) l le_rfl
    · intro r
      rw [hev₂.2 r, hev₁.2 r]
      let i_L : Fin k := ⟨r.1, by have := r.2; omega⟩
      let i_R : Fin k := ⟨r.1 + 1, by have := r.2; omega⟩
      exact hEq_sub
        (hEq_add (hEq_add (hEq_mul (hsupD_eq i_L) (hsin_eq i_L))
          (hEq_mul (hsup_eq i_L) (hcos_eq i_L)))
          (hEq_mul (hsupD_eq i_R) (hsin_eq i_R)))
        (hEq_mul (hsup_eq i_R) (hcos_eq i_R)) l le_rfl

  have hDiffOn_sum : ∀ {ι : Type} {V : Set (ℂ × ℂ)} (s : Finset ι)
      (f : ι → ℂ × ℂ → ℂ),
      (∀ i ∈ s, DifferentiableOn ℂ (f i) V) →
      DifferentiableOn ℂ (fun q => ∑ i ∈ s, f i q) V := by
    intro ι V s f hf
    classical
    induction s using Finset.induction_on with
    | empty => simp [differentiableOn_const]
    | @insert a s ha ih =>
      have hfn : (fun q => ∑ i ∈ insert a s, f i q) =
          (fun q => f a q + ∑ i ∈ s, f i q) := by
        ext q; exact Finset.sum_insert ha
      rw [hfn]
      exact (hf a (Finset.mem_insert_self a s)).add
        (ih fun i hi => hf i (Finset.mem_insert_of_mem hi))

  have hepsJet_holo : ∀ {k J : ℕ} (m : ℕ) {W_ψ : Set ℂ} {V : Set (ℂ × ℂ)}
      (_hW : IsOpen W_ψ) (_hV : IsOpen V) {h_ℂ : ℂ → ℂ} (_hh : DifferentiableOn ℂ h_ℂ W_ψ)
      {g : Fin k → Fin (J + 1) → ℂ → ℂ} (_hg : ∀ i l, DifferentiableOn ℂ (g i l) W_ψ)
      (_hg0 : ∀ i z, g i 0 z = 0) {α₀ : Fin (k + 1) → ℂ × ℂ → ℂ}
      (_hα₀ : ∀ s, DifferentiableOn ℂ (α₀ s) V)
      (_hmid : ∀ q ∈ V, ∀ i : Fin k, lineChainMid (fun s => α₀ s q) i ∈ W_ψ)
      {β : Fin (J + 1) → Fin (k + 1) → ℂ × ℂ → ℂ}
      (_hβ : ∀ l s, DifferentiableOn ℂ (β l s) V) (_hβ0 : ∀ s q, β 0 s q = 0),
      DifferentiableOn ℂ
        (fun q =>
          lineArcEpsJet m
            (fun ε =>
              lineChainAction (lineArcPertSupport h_ℂ g ε)
                (lineArcPertAngles (fun s => α₀ s q) (fun l s => β l s q) ε)))
        V ∧
      ∀ r : Fin (k - 1),
        DifferentiableOn ℂ
          (fun q =>
            lineArcEpsJet m
              (fun ε =>
                lineInteriorGrad (lineArcPertSupport h_ℂ g ε)
                  (lineArcPertSupportDeriv h_ℂ g ε)
                  (lineArcPertAngles (fun s => α₀ s q) (fun l s => β l s q) ε) r))
          V := by
    let PsHoloOn (V : Set (ℂ × ℂ)) (P : ℂ × ℂ → PowerSeries ℂ) : Prop :=
      ∀ n : ℕ, DifferentiableOn ℂ (fun q => PowerSeries.coeff n (P q)) V
    have hPsHolo_add : ∀ {V : Set (ℂ × ℂ)} {P Q : ℂ × ℂ → PowerSeries ℂ},
        PsHoloOn V P → PsHoloOn V Q → PsHoloOn V (fun q => P q + Q q) :=
      fun hP hQ n => ((hP n).add (hQ n)).congr fun _ _ => map_add _ _ _
    have hPsHolo_sub : ∀ {V : Set (ℂ × ℂ)} {P Q : ℂ × ℂ → PowerSeries ℂ},
        PsHoloOn V P → PsHoloOn V Q → PsHoloOn V (fun q => P q - Q q) :=
      fun hP hQ n => ((hP n).sub (hQ n)).congr fun _ _ => map_sub _ _ _
    have hPsHolo_mul : ∀ {V : Set (ℂ × ℂ)} {P Q : ℂ × ℂ → PowerSeries ℂ},
        PsHoloOn V P → PsHoloOn V Q → PsHoloOn V (fun q => P q * Q q) := by
      intro V P Q hP hQ n
      have hsum : DifferentiableOn ℂ
          (fun q => ∑ u ∈ Finset.HasAntidiagonal.antidiagonal n,
            PowerSeries.coeff u.1 (P q) * PowerSeries.coeff u.2 (Q q)) V :=
        hDiffOn_sum (Finset.HasAntidiagonal.antidiagonal n) _
          fun u _ => (hP u.1).mul (hQ u.2)
      exact hsum.congr fun q _ => PowerSeries.coeff_mul n (P q) (Q q)
    have hPsHolo_pow : ∀ {V : Set (ℂ × ℂ)} {Z : ℂ × ℂ → PowerSeries ℂ},
        PsHoloOn V Z → ∀ a : ℕ, PsHoloOn V (fun q => Z q ^ a) := by
      intro V Z hZ a
      induction a with
      | zero => exact fun n => differentiableOn_const (PowerSeries.coeff n 1)
      | succ a ih =>
        have hfn : (fun q => Z q ^ (a + 1)) = (fun q => Z q ^ a * Z q) :=
          funext fun q => pow_succ (Z q) a
        rw [hfn]
        exact hPsHolo_mul ih hZ
    have hPsHolo_X_pow_mul : ∀ {V : Set (ℂ × ℂ)} (l : ℕ) {P : ℂ × ℂ → PowerSeries ℂ},
        PsHoloOn V P → PsHoloOn V (fun q => PowerSeries.X ^ l * P q) := by
      intro V l P hP n
      by_cases hln : l ≤ n
      · exact (hP (n - l)).congr fun q _ => by
          rw [PowerSeries.coeff_X_pow_mul', ite_eq_left_iff.mpr fun h => (h hln).elim]
      · exact (differentiableOn_const 0).congr fun q _ => by
          rw [PowerSeries.coeff_X_pow_mul', ite_eq_right_iff.mpr fun h => (hln h).elim]
    have hPsHolo_sum : ∀ {V : Set (ℂ × ℂ)} {ι : Type} (s : Finset ι)
        (P : ι → ℂ × ℂ → PowerSeries ℂ),
        (∀ i ∈ s, PsHoloOn V (P i)) → PsHoloOn V (fun q => ∑ i ∈ s, P i q) := by
      intro V ι s P hP n
      have hs : DifferentiableOn ℂ (fun q => ∑ i ∈ s, PowerSeries.coeff n (P i q)) V :=
        hDiffOn_sum s (fun i q => PowerSeries.coeff n (P i q)) fun i hi => hP i hi n
      exact hs.congr fun q _ => map_sum (PowerSeries.coeff n) (fun i => P i q) s
    have hPsHolo_shift : ∀ {V : Set (ℂ × ℂ)} {J : ℕ} (c : Fin (J + 1) → ℂ × ℂ → ℂ),
        (∀ l, DifferentiableOn ℂ (c l) V) →
        PsHoloOn V (fun q => polyShift (fun l => c l q)) := by
      intro V J c hc n
      by_cases hn : n < J + 1
      · exact (hc ⟨n, hn⟩).congr fun q _ => by
          rw [coeff_polyShift, dif_pos hn]
      · exact (differentiableOn_const 0).congr fun q _ => by
          rw [coeff_polyShift, dif_neg hn]
    have hiter1D_holo : ∀ {W : Set ℂ}, IsOpen W → ∀ {G : ℂ → ℂ},
        DifferentiableOn ℂ G W → ∀ n : ℕ, DifferentiableOn ℂ (iteratedDeriv n G) W := by
      intro W hW G hG n
      induction n with
      | zero => simpa [iteratedDeriv_zero] using hG
      | succ n ih => rw [iteratedDeriv_succ]; exact ih.deriv hW
    have hPsHolo_comp : ∀ {V : Set (ℂ × ℂ)} {W : Set ℂ}, IsOpen W →
        ∀ {G : ℂ → ℂ}, DifferentiableOn ℂ G W →
        ∀ {z₀ : ℂ × ℂ → ℂ}, DifferentiableOn ℂ z₀ V → (∀ q ∈ V, z₀ q ∈ W) →
        ∀ {Z : ℂ × ℂ → PowerSeries ℂ}, PsHoloOn V Z →
          PsHoloOn V (fun q => polyComp (holoTaylor1D G (z₀ q)) (Z q)) := by
      intro V W hW G hG z₀ hz₀ hmaps Z hZ n
      have hs : DifferentiableOn ℂ
          (fun q => ∑ a ∈ Finset.range (n + 1),
            (iteratedDeriv a G (z₀ q) * ((a.factorial : ℂ))⁻¹) *
              PowerSeries.coeff n (Z q ^ a)) V := by
        refine hDiffOn_sum (Finset.range (n + 1)) _ fun a _ => ?_
        have hGa : DifferentiableOn ℂ (fun q => iteratedDeriv a G (z₀ q)) V :=
          (hiter1D_holo hW hG a).comp hz₀ fun q hq => hmaps q hq
        exact (hGa.mul (differentiableOn_const _)).mul (hPsHolo_pow hZ a n)
      refine hs.congr fun q _ => ?_
      rw [coeff_polyComp]
      refine Finset.sum_congr rfl fun a _ => ?_
      rw [holoTaylor1D, PowerSeries.coeff_mk, div_eq_mul_inv]

    intro k J m W_ψ V hW _hV h_ℂ hh g hg _hg0 α₀ hα₀ hmid β hβ hβ0
    have hmid_holo : ∀ i : Fin k, DifferentiableOn ℂ (fun q => lineChainMid (fun s => α₀ s q) i) V := by
      intro i
      exact (((hα₀ i.castSucc).add (hα₀ i.succ)).mul (differentiableOn_const (2 : ℂ)⁻¹)).congr
        fun q _ => (div_eq_mul_inv _ 2)
    have hd_holo : ∀ i : Fin k, DifferentiableOn ℂ (fun q => lineChainHalfStep (fun s => α₀ s q) i) V := by
      intro i
      exact (((hα₀ i.succ).sub (hα₀ i.castSucc)).mul (differentiableOn_const (2 : ℂ)⁻¹)).congr
        fun q _ => (div_eq_mul_inv _ 2)
    have hZmid_holo : ∀ i : Fin k, PsHoloOn V (fun q => polyMidShift (fun l s => β l s q) i) := by
      intro i
      refine hPsHolo_shift _ fun l => ?_
      exact (((hβ l i.castSucc).add (hβ l i.succ)).mul (differentiableOn_const (2 : ℂ)⁻¹)).congr
        fun q _ => (div_eq_mul_inv _ 2)
    have hZd_holo : ∀ i : Fin k, PsHoloOn V (fun q => polyHalfStepShift (fun l s => β l s q) i) := by
      intro i
      refine hPsHolo_shift _ fun l => ?_
      exact (((hβ l i.succ).sub (hβ l i.castSucc)).mul (differentiableOn_const (2 : ℂ)⁻¹)).congr
        fun q _ => (div_eq_mul_inv _ 2)
    have hsup_holo : ∀ i : Fin k,
        PsHoloOn V (fun q => polySup h_ℂ g (fun s => α₀ s q) (fun l s => β l s q) i) := by
      intro i
      refine hPsHolo_add
        (hPsHolo_comp hW hh (hmid_holo i) (fun q hq => hmid q hq i) (hZmid_holo i))
        (hPsHolo_sum (Finset.univ : Finset (Fin (J + 1)))
          (fun l q => PowerSeries.X ^ (l : ℕ) *
            polyComp (holoTaylor1D (g i l) (lineChainMid (fun s => α₀ s q) i))
              (polyMidShift (fun l s => β l s q) i))
          fun l _ =>
            hPsHolo_X_pow_mul (l : ℕ)
              (hPsHolo_comp hW (hg i l) (hmid_holo i) (fun q hq => hmid q hq i) (hZmid_holo i)))
    have hsupD_holo : ∀ i : Fin k,
        PsHoloOn V (fun q => polySupDeriv h_ℂ g (fun s => α₀ s q) (fun l s => β l s q) i) := by
      intro i
      refine hPsHolo_add
        (hPsHolo_comp hW (hh.deriv hW) (hmid_holo i) (fun q hq => hmid q hq i) (hZmid_holo i))
        (hPsHolo_sum (Finset.univ : Finset (Fin (J + 1)))
          (fun l q => PowerSeries.X ^ (l : ℕ) *
            polyComp (holoTaylor1D (deriv (g i l)) (lineChainMid (fun s => α₀ s q) i))
              (polyMidShift (fun l s => β l s q) i))
          fun l _ =>
            hPsHolo_X_pow_mul (l : ℕ)
              (hPsHolo_comp hW ((hg i l).deriv hW) (hmid_holo i) (fun q hq => hmid q hq i)
                (hZmid_holo i)))
    have hsin_holo : ∀ i : Fin k,
        PsHoloOn V (fun q => polySin (fun s => α₀ s q) (fun l s => β l s q) i) :=
      fun i => hPsHolo_comp isOpen_univ Complex.differentiable_sin.differentiableOn
        (hd_holo i) (fun _ _ => Set.mem_univ _) (hZd_holo i)
    have hcos_holo : ∀ i : Fin k,
        PsHoloOn V (fun q => polyCos (fun s => α₀ s q) (fun l s => β l s q) i) :=
      fun i => hPsHolo_comp isOpen_univ Complex.differentiable_cos.differentiableOn
        (hd_holo i) (fun _ _ => Set.mem_univ _) (hZd_holo i)
    have hconst2_holo : PsHoloOn V (fun _ => (2 : PowerSeries ℂ)) :=
      fun n => differentiableOn_const (PowerSeries.coeff n 2)
    have hact_holo : PsHoloOn V
        (fun q => polyAct h_ℂ g (fun s => α₀ s q) (fun l s => β l s q)) :=
      hPsHolo_sum (Finset.univ : Finset (Fin k))
        (fun i q => 2 * polySup h_ℂ g (fun s => α₀ s q) (fun l s => β l s q) i *
          polySin (fun s => α₀ s q) (fun l s => β l s q) i)
        fun i _ => hPsHolo_mul (hPsHolo_mul hconst2_holo (hsup_holo i)) (hsin_holo i)
    refine ⟨?_, ?_⟩
    · exact (hact_holo m).congr fun q hq =>
        (hepsJet_poly m hW hh hg (hmid q hq) (fun s => hβ0 s q)).1
    · intro r
      let i_L : Fin k := ⟨r.1, by have := r.2; omega⟩
      let i_R : Fin k := ⟨r.1 + 1, by have := r.2; omega⟩
      have hgrad_holo : PsHoloOn V
          (fun q => polyGrad h_ℂ g (fun s => α₀ s q) (fun l s => β l s q) r) :=
        hPsHolo_sub
          (hPsHolo_add
            (hPsHolo_add (hPsHolo_mul (hsupD_holo i_L) (hsin_holo i_L))
              (hPsHolo_mul (hsup_holo i_L) (hcos_holo i_L)))
            (hPsHolo_mul (hsupD_holo i_R) (hsin_holo i_R)))
          (hPsHolo_mul (hsup_holo i_R) (hcos_holo i_R))
      exact (hgrad_holo m).congr fun q hq =>
        (hepsJet_poly m hW hh hg (hmid q hq) (fun s => hβ0 s q)).2 r

  
  
  
  have hepsJet_succ_split :
      ∀ {k J : ℕ} (_hk : 2 ≤ k) {W_ψ : Set ℂ} (_hW : IsOpen W_ψ)
      {h_ℂ : ℂ → ℂ} (_hh : DifferentiableOn ℂ h_ℂ W_ψ)
      {g : Fin k → Fin (J + 1) → ℂ → ℂ} {g_top : Fin k → ℂ → ℂ}
      (_hg : ∀ i l, DifferentiableOn ℂ (g i l) W_ψ)
      (_hg_top : ∀ i, DifferentiableOn ℂ (g_top i) W_ψ)
      (_hg0 : ∀ i z, g i 0 z = 0) {α₀ : Fin (k + 1) → ℂ}
      (_hmid : ∀ i : Fin k, lineChainMid α₀ i ∈ W_ψ)
      {β : Fin (J + 1) → Fin (k + 1) → ℂ} {β_top : Fin (k + 1) → ℂ}
      (_hβ0 : ∀ s, β 0 s = 0) (_hβ_top_end : β_top 0 = 0 ∧ β_top (Fin.last k) = 0),
      let g_ext : Fin k → Fin (J + 1 + 1) → ℂ → ℂ := fun i => Fin.snoc (g i) (g_top i)
      let β_ext : Fin (J + 1 + 1) → Fin (k + 1) → ℂ := Fin.snoc β β_top
      let β_zero_top : Fin (J + 1 + 1) → Fin (k + 1) → ℂ := Fin.snoc β (fun _ => 0)
      lineArcEpsJet (J + 1)
          (fun ε => lineChainAction (lineArcPertSupport h_ℂ g_ext ε) (lineArcPertAngles α₀ β_ext ε)) =
        lineArcEpsJet (J + 1)
          (fun ε => lineChainAction (lineArcPertSupport h_ℂ g ε) (lineArcPertAngles α₀ β ε)) +
        (∑ i : Fin k, 2 * Complex.sin (lineChainHalfStep α₀ i) * g_top i (lineChainMid α₀ i)) +
        (∑ r : Fin (k - 1),
          lineInteriorGrad (fun _ => h_ℂ) (fun _ => deriv h_ℂ) α₀ r *
            β_top ⟨r.1 + 1, by have := r.2; omega⟩) ∧
      ∀ r : Fin (k - 1),
        lineArcEpsJet (J + 1)
            (fun ε =>
              lineInteriorGrad (lineArcPertSupport h_ℂ g_ext ε)
                (lineArcPertSupportDeriv h_ℂ g_ext ε) (lineArcPertAngles α₀ β_ext ε) r) =
          lineArcEpsJet (J + 1)
            (fun ε =>
              lineInteriorGrad (lineArcPertSupport h_ℂ g_ext ε)
                (lineArcPertSupportDeriv h_ℂ g_ext ε) (lineArcPertAngles α₀ β_zero_top ε) r) +
          ∑ s : Fin (k - 1),
            lineInteriorHess (fun _ => h_ℂ) (fun _ => deriv h_ℂ) (fun _ => deriv (deriv h_ℂ))
              α₀ r s * β_top ⟨s.1 + 1, by have := s.2; omega⟩ := by
    intro k J hk W_ψ hW h_ℂ hh g g_top hg hg_top hg0 α₀ hmid β β_top hβ0 hβ_top_end
    dsimp only
    let g_ext : Fin k → Fin (J + 1 + 1) → ℂ → ℂ := fun i => Fin.snoc (g i) (g_top i)
    let β_ext : Fin (J + 1 + 1) → Fin (k + 1) → ℂ := Fin.snoc β β_top
    let β_zero_top : Fin (J + 1 + 1) → Fin (k + 1) → ℂ := Fin.snoc β (fun _ => 0)
    have hg_ext_holo : ∀ (i : Fin k) (l : Fin (J + 1 + 1)), DifferentiableOn ℂ (g_ext i l) W_ψ := by
      intro i l
      refine Fin.lastCases ?_ ?_ l
      · dsimp only [g_ext]; rw [Fin.snoc_last]; exact hg_top i
      · intro m; dsimp only [g_ext]; rw [Fin.snoc_castSucc]; exact hg i m
    have h0_eq : (0 : Fin (J + 1 + 1)) = (0 : Fin (J + 1)).castSucc := rfl
    have hβ_ext0 : ∀ s, β_ext 0 s = 0 := by
      intro s; dsimp only [β_ext]; rw [h0_eq, Fin.snoc_castSucc]; exact hβ0 s
    have hβ_z0 : ∀ s, β_zero_top 0 s = 0 := by
      intro s; dsimp only [β_zero_top]; rw [h0_eq, Fin.snoc_castSucc]; exact hβ0 s
    let M : ℕ := J + 1
    have hM_def : M = J + 1 := rfl
    have hev_ext := hepsJet_poly M hW hh hg_ext_holo hmid hβ_ext0
    have hev_base := hepsJet_poly M hW hh hg hmid hβ0
    have hev_ztop := hepsJet_poly M hW hh hg_ext_holo hmid hβ_z0

    have hshift_snoc : ∀ (c : Fin (J + 1) → ℂ) (c_top : ℂ),
        polyShift (Fin.snoc c c_top) = polyShift c + PowerSeries.C c_top * PowerSeries.X ^ M := by
      intro c c_top
      dsimp only [polyShift]
      rw [Fin.sum_univ_castSucc, Fin.snoc_last]
      congr 1
      refine Finset.sum_congr rfl fun l _ => ?_
      rw [Fin.snoc_castSucc]; rfl

    have hcomp_pert : ∀ (φ Z : PowerSeries ℂ) (c : ℂ),
        PowerSeries.coeff 0 Z = 0 →
        PsEqUpTo J (polyComp φ (Z + PowerSeries.C c * PowerSeries.X ^ M)) (polyComp φ Z) ∧
        PowerSeries.coeff 0 (polyComp φ Z) = PowerSeries.coeff 0 φ ∧
        PowerSeries.coeff M (polyComp φ (Z + PowerSeries.C c * PowerSeries.X ^ M)) =
          PowerSeries.coeff M (polyComp φ Z) + PowerSeries.coeff 1 φ * c := by
      intro φ Z c hZ0
      let W : PowerSeries ℂ := PowerSeries.C c * PowerSeries.X ^ M
      have hW_lt : ∀ n ≤ J, PowerSeries.coeff n W = 0 := by
        intro n hn
        dsimp only [W]
        rw [PowerSeries.coeff_C_mul, PowerSeries.coeff_X_pow,
          ite_eq_right_iff.mpr (by omega), mul_zero]
      have hZW_eq : PsEqUpTo J (Z + W) Z := fun n hn => by rw [map_add, hW_lt n hn, add_zero]
      refine ⟨hEq_comp φ φ rfl hZW_eq, ?_, ?_⟩
      · rw [coeff_polyComp, Finset.range_one, Finset.sum_singleton, pow_zero,
          PowerSeries.coeff_one, ite_eq_left_iff.mpr fun h => (h rfl).elim, mul_one]
      · have hXdvdZ : PowerSeries.X ∣ Z :=
          PowerSeries.X_dvd_iff.mpr (by rwa [← PowerSeries.coeff_zero_eq_constantCoeff])
        have hXdvdW : PowerSeries.X ^ M ∣ W := ⟨PowerSeries.C c, mul_comm _ _⟩
        have hpow_ge2 : ∀ n : ℕ, 2 ≤ n → PowerSeries.coeff M ((Z + W) ^ n) = PowerSeries.coeff M (Z ^ n) := by
          intro n hn2
          rw [add_pow Z W n, Finset.sum_range_succ, Nat.sub_self, pow_zero, mul_one,
            Nat.choose_self, Nat.cast_one, mul_one, map_add, map_sum]
          have hsum0 : (∑ a ∈ Finset.range n,
              PowerSeries.coeff M (Z ^ a * W ^ (n - a) * (n.choose a : PowerSeries ℂ))) = 0 := by
            refine Finset.sum_eq_zero fun a ha => ?_
            rw [Finset.mem_range] at ha
            have hd1 : PowerSeries.X ^ a ∣ Z ^ a := pow_dvd_pow_of_dvd hXdvdZ a
            have hd2 : PowerSeries.X ^ (M * (n - a)) ∣ W ^ (n - a) := by
              rw [pow_mul]; exact pow_dvd_pow_of_dvd hXdvdW (n - a)
            have hd_tot : PowerSeries.X ^ (a + M * (n - a)) ∣
                Z ^ a * W ^ (n - a) * (n.choose a : PowerSeries ℂ) := by
              rw [pow_add]; exact dvd_mul_of_dvd_left (mul_dvd_mul hd1 hd2) _
            have hM_lt : M < a + M * (n - a) := by
              have hM_pos : 1 ≤ M := Nat.succ_pos J
              rcases Nat.eq_zero_or_pos a with rfl | ha_pos
              · rw [Nat.sub_zero, Nat.zero_add]
                nlinarith
              · have h1 : 1 ≤ n - a := by omega
                have h2 : M * 1 ≤ M * (n - a) := Nat.mul_le_mul_left M h1
                linarith
            exact PowerSeries.X_pow_dvd_iff.mp hd_tot M hM_lt
          rw [hsum0, zero_add]
        have hdiff : PowerSeries.coeff M (polyComp φ (Z + W)) - PowerSeries.coeff M (polyComp φ Z) =
            PowerSeries.coeff 1 φ * c := by
          rw [coeff_polyComp, coeff_polyComp, ← Finset.sum_sub_distrib]
          simp_rw [← mul_sub]
          rw [Finset.sum_eq_single 1 ?_ ?_]
          · have hWM : PowerSeries.coeff M W = c := by
              dsimp only [W]
              rw [PowerSeries.coeff_C_mul, PowerSeries.coeff_X_pow,
                ite_eq_left_iff.mpr fun h => (h rfl).elim, mul_one]
            rw [pow_one, pow_one, map_add, add_sub_cancel_left, hWM]
          · intro n _ hne1
            rcases n with _ | _ | m'
            · rw [pow_zero, pow_zero, sub_self, mul_zero]
            · exact False.elim (hne1 rfl)
            · rw [hpow_ge2 (m' + 2) (by omega), sub_self, mul_zero]
          · intro hnot
            exact False.elim (hnot (Finset.mem_range.mpr (by omega)))
        linear_combination hdiff

    have hmul_pert : ∀ {P₁ P₀ Q₁ Q₀ : PowerSeries ℂ} {dp dq : ℂ},
        PsEqUpTo J P₁ P₀ → PsEqUpTo J Q₁ Q₀ →
        PowerSeries.coeff M P₁ = PowerSeries.coeff M P₀ + dp →
        PowerSeries.coeff M Q₁ = PowerSeries.coeff M Q₀ + dq →
        PowerSeries.coeff M (P₁ * Q₁) =
          PowerSeries.coeff M (P₀ * Q₀) + dp * PowerSeries.coeff 0 Q₀ +
            PowerSeries.coeff 0 P₀ * dq := by
      intro P₁ P₀ Q₁ Q₀ dp dq hP hQ hPM hQM
      rw [PowerSeries.coeff_mul, PowerSeries.coeff_mul,
        Finset.Nat.sum_antidiagonal_eq_sum_range_succ
          (fun a b => PowerSeries.coeff a P₁ * PowerSeries.coeff b Q₁) M,
        Finset.Nat.sum_antidiagonal_eq_sum_range_succ
          (fun a b => PowerSeries.coeff a P₀ * PowerSeries.coeff b Q₀) M]
      have hsplit_M : ∀ f : ℕ → ℂ,
          (∑ a ∈ Finset.range (M + 1), f a) =
            f 0 + (∑ b ∈ Finset.range J, f (b + 1)) + f M := by
        intro f
        rw [Finset.sum_range_succ]
        have hsub : (∑ a ∈ Finset.range M, f a) = (∑ b ∈ Finset.range J, f (b + 1)) + f 0 :=
          Finset.sum_range_succ' f J
        rw [hsub]
        ring
      rw [hsplit_M (fun a => PowerSeries.coeff a P₁ * PowerSeries.coeff (M - a) Q₁),
        hsplit_M (fun a => PowerSeries.coeff a P₀ * PowerSeries.coeff (M - a) Q₀)]
      have hmid_sum :
          (∑ b ∈ Finset.range J,
            PowerSeries.coeff (b + 1) P₁ * PowerSeries.coeff (M - (b + 1)) Q₁) =
          ∑ b ∈ Finset.range J,
            PowerSeries.coeff (b + 1) P₀ * PowerSeries.coeff (M - (b + 1)) Q₀ := by
        refine Finset.sum_congr rfl fun b hb => ?_
        rw [Finset.mem_range] at hb
        have hb1 : b + 1 ≤ J := Nat.succ_le_of_lt hb
        have hb2 : M - (b + 1) ≤ J := by change (J + 1) - (b + 1) ≤ J; omega
        rw [hP (b + 1) hb1, hQ (M - (b + 1)) hb2]
      have hM_sub : M - M = 0 := Nat.sub_self M
      have hP0 : PowerSeries.coeff 0 P₁ = PowerSeries.coeff 0 P₀ := hP 0 (Nat.zero_le J)
      have hQ0 : PowerSeries.coeff 0 Q₁ = PowerSeries.coeff 0 Q₀ := hQ 0 (Nat.zero_le J)
      rw [hmid_sum, Nat.sub_zero, hM_sub, hP0, hQ0, hPM, hQM]
      ring

    have hTay0 : ∀ (F : ℂ → ℂ) (z₀ : ℂ), PowerSeries.coeff 0 (holoTaylor1D F z₀) = F z₀ := by
      intro F z₀; simp [holoTaylor1D]
    have hTay1 : ∀ (F : ℂ → ℂ) (z₀ : ℂ), PowerSeries.coeff 1 (holoTaylor1D F z₀) = deriv F z₀ := by
      intro F z₀; simp [holoTaylor1D, iteratedDeriv_one]
    have hComp_zero : ∀ Z : PowerSeries ℂ, polyComp 0 Z = 0 := by
      intro Z; ext n; simp [coeff_polyComp]
    have hholo_zero : ∀ z₀ : ℂ, holoTaylor1D (fun _ => (0 : ℂ)) z₀ = 0 := by
      intro z₀; ext n; rw [holoTaylor1D, PowerSeries.coeff_mk, map_zero, iteratedDeriv_const]
      split_ifs <;> simp

    let Z_mid : Fin k → PowerSeries ℂ := fun i => polyMidShift β i
    let Z_d : Fin k → PowerSeries ℂ := fun i => polyHalfStepShift β i
    let ψ_top : Fin k → ℂ := fun i => (β_top i.castSucc + β_top i.succ) / 2
    let d_top : Fin k → ℂ := fun i => (β_top i.succ - β_top i.castSucc) / 2
    have hZmid0 : ∀ i : Fin k, PowerSeries.coeff 0 (Z_mid i) = 0 := by
      intro i; dsimp only [Z_mid, polyMidShift]; rw [coeff_polyShift]; simp [hβ0]
    have hZd0 : ∀ i : Fin k, PowerSeries.coeff 0 (Z_d i) = 0 := by
      intro i; dsimp only [Z_d, polyHalfStepShift]; rw [coeff_polyShift]; simp [hβ0]
    have hmid_ext_eq : ∀ i : Fin k,
        polyMidShift β_ext i = Z_mid i + PowerSeries.C (ψ_top i) * PowerSeries.X ^ M := by
      intro i
      dsimp only [polyMidShift, β_ext, Z_mid, ψ_top]
      rw [← hshift_snoc]
      congr 1; ext l
      refine Fin.lastCases ?_ ?_ l <;> simp
    have hmid_ztop_eq : ∀ i : Fin k, polyMidShift β_zero_top i = Z_mid i := by
      intro i
      dsimp only [polyMidShift, β_zero_top, Z_mid]
      have h := hshift_snoc (fun l => (β l i.castSucc + β l i.succ) / 2) 0
      rw [map_zero, zero_mul, add_zero] at h
      rw [← h]
      congr 1; ext l
      refine Fin.lastCases ?_ ?_ l <;> simp
    have hd_ext_eq : ∀ i : Fin k,
        polyHalfStepShift β_ext i = Z_d i + PowerSeries.C (d_top i) * PowerSeries.X ^ M := by
      intro i
      dsimp only [polyHalfStepShift, β_ext, Z_d, d_top]
      rw [← hshift_snoc]
      congr 1; ext l
      refine Fin.lastCases ?_ ?_ l <;> simp
    have hd_ztop_eq : ∀ i : Fin k, polyHalfStepShift β_zero_top i = Z_d i := by
      intro i
      dsimp only [polyHalfStepShift, β_zero_top, Z_d]
      have h := hshift_snoc (fun l => (β l i.succ - β l i.castSucc) / 2) 0
      rw [map_zero, zero_mul, add_zero] at h
      rw [← h]
      congr 1; ext l
      refine Fin.lastCases ?_ ?_ l <;> simp

    have hpert_inv : ∀ (i : Fin k) (F : Fin (J + 1) → ℂ → ℂ),
        F 0 = (fun _ => 0) →
        PsEqUpTo M
          (∑ l : Fin (J + 1), PowerSeries.X ^ (l : ℕ) *
            polyComp (holoTaylor1D (F l) (lineChainMid α₀ i))
              (Z_mid i + PowerSeries.C (ψ_top i) * PowerSeries.X ^ M))
          (∑ l : Fin (J + 1), PowerSeries.X ^ (l : ℕ) *
            polyComp (holoTaylor1D (F l) (lineChainMid α₀ i)) (Z_mid i)) ∧
        PowerSeries.coeff 0
          (∑ l : Fin (J + 1), PowerSeries.X ^ (l : ℕ) *
            polyComp (holoTaylor1D (F l) (lineChainMid α₀ i)) (Z_mid i)) = 0 := by
      intro i F hF0
      refine ⟨fun n hn => ?_, ?_⟩
      · rw [map_sum, map_sum]
        refine Finset.sum_congr rfl fun l _ => ?_
        by_cases hl0 : l = 0
        · subst hl0; rw [hF0, hholo_zero, hComp_zero, hComp_zero]
        · have hl_pos : 1 ≤ (l : ℕ) := by
            have : (l : ℕ) ≠ 0 := fun h0 => hl0 (Fin.ext h0)
            omega
          rw [PowerSeries.coeff_X_pow_mul', PowerSeries.coeff_X_pow_mul']
          split_ifs with hln
          · exact (hcomp_pert _ (Z_mid i) (ψ_top i) (hZmid0 i)).1 (n - (l : ℕ)) (by omega)
          · rfl
      · rw [map_sum]
        refine Finset.sum_eq_zero fun l _ => ?_
        by_cases hl0 : l = 0
        · subst hl0; rw [hF0, hholo_zero, hComp_zero, mul_zero, map_zero]
        · have hl_pos : 1 ≤ (l : ℕ) := by
            have : (l : ℕ) ≠ 0 := fun h0 => hl0 (Fin.ext h0)
            omega
          rw [PowerSeries.coeff_X_pow_mul', if_neg (by omega)]

    have hsin_pert : ∀ i : Fin k,
        PsEqUpTo J (polySin α₀ β_ext i) (polySin α₀ β i) ∧
        PowerSeries.coeff 0 (polySin α₀ β i) = Complex.sin (lineChainHalfStep α₀ i) ∧
        PowerSeries.coeff M (polySin α₀ β_ext i) =
          PowerSeries.coeff M (polySin α₀ β i) +
            Complex.cos (lineChainHalfStep α₀ i) * d_top i := by
      intro i
      dsimp only [polySin]
      rw [hd_ext_eq i]
      have hp := hcomp_pert (holoTaylor1D Complex.sin (lineChainHalfStep α₀ i)) (Z_d i) (d_top i)
        (hZd0 i)
      refine ⟨hp.1, hp.2.1.trans (hTay0 _ _), ?_⟩
      rw [hp.2.2, hTay1, Complex.deriv_sin]

    have hcos_pert : ∀ i : Fin k,
        PsEqUpTo J (polyCos α₀ β_ext i) (polyCos α₀ β i) ∧
        PowerSeries.coeff 0 (polyCos α₀ β i) = Complex.cos (lineChainHalfStep α₀ i) ∧
        PowerSeries.coeff M (polyCos α₀ β_ext i) =
          PowerSeries.coeff M (polyCos α₀ β i) -
            Complex.sin (lineChainHalfStep α₀ i) * d_top i := by
      intro i
      dsimp only [polyCos]
      rw [hd_ext_eq i]
      have hp := hcomp_pert (holoTaylor1D Complex.cos (lineChainHalfStep α₀ i)) (Z_d i) (d_top i)
        (hZd0 i)
      refine ⟨hp.1, hp.2.1.trans (hTay0 _ _), ?_⟩
      rw [hp.2.2, hTay1, Complex.deriv_cos]
      ring

    have hsup_pert_act : ∀ i : Fin k,
        PsEqUpTo J (polySup h_ℂ g_ext α₀ β_ext i) (polySup h_ℂ g α₀ β i) ∧
        PowerSeries.coeff 0 (polySup h_ℂ g α₀ β i) = h_ℂ (lineChainMid α₀ i) ∧
        PowerSeries.coeff M (polySup h_ℂ g_ext α₀ β_ext i) =
          PowerSeries.coeff M (polySup h_ℂ g α₀ β i) +
            deriv h_ℂ (lineChainMid α₀ i) * ψ_top i + g_top i (lineChainMid α₀ i) := by
      intro i
      dsimp only [polySup]
      rw [hmid_ext_eq i, Fin.sum_univ_castSucc]
      have hcast_sum :
          (∑ l : Fin M, PowerSeries.X ^ (l.castSucc : ℕ) *
            polyComp (holoTaylor1D (g_ext i l.castSucc) (lineChainMid α₀ i))
              (Z_mid i + PowerSeries.C (ψ_top i) * PowerSeries.X ^ M)) =
          ∑ l : Fin (J + 1), PowerSeries.X ^ (l : ℕ) *
            polyComp (holoTaylor1D (g i l) (lineChainMid α₀ i))
              (Z_mid i + PowerSeries.C (ψ_top i) * PowerSeries.X ^ M) := by
        refine Finset.sum_congr rfl fun l _ => ?_
        dsimp only [g_ext]; rw [Fin.snoc_castSucc]; rfl
      have hlast_term :
          PowerSeries.X ^ (Fin.last M : ℕ) *
            polyComp (holoTaylor1D (g_ext i (Fin.last M)) (lineChainMid α₀ i))
              (Z_mid i + PowerSeries.C (ψ_top i) * PowerSeries.X ^ M) =
          PowerSeries.X ^ M *
            polyComp (holoTaylor1D (g_top i) (lineChainMid α₀ i))
              (Z_mid i + PowerSeries.C (ψ_top i) * PowerSeries.X ^ M) := by
        dsimp only [g_ext]; rw [Fin.snoc_last]; rfl
      rw [hcast_sum, hlast_term]
      have hc0 := hcomp_pert (holoTaylor1D h_ℂ (lineChainMid α₀ i)) (Z_mid i) (ψ_top i) (hZmid0 i)
      have hpi := hpert_inv i (g i) (funext (hg0 i))
      refine ⟨fun n hn => ?_, ?_, ?_⟩
      · rw [map_add, map_add, map_add, hc0.1 n hn, hpi.1 n (Nat.le_succ_of_le hn),
          PowerSeries.coeff_X_pow_mul', if_neg (not_le.mpr (Nat.lt_succ_of_le hn)), add_zero]
      · rw [map_add, hc0.2.1, hTay0, hpi.2, add_zero]
      · have htop_M :
            PowerSeries.coeff M (PowerSeries.X ^ M *
              polyComp (holoTaylor1D (g_top i) (lineChainMid α₀ i))
                (Z_mid i + PowerSeries.C (ψ_top i) * PowerSeries.X ^ M)) =
            g_top i (lineChainMid α₀ i) := by
          rw [PowerSeries.coeff_X_pow_mul', if_pos le_rfl,
            Nat.sub_self,
            (hcomp_pert (holoTaylor1D (g_top i) (lineChainMid α₀ i)) (Z_mid i) (ψ_top i)
              (hZmid0 i)).1 0 (Nat.zero_le J),
            (hcomp_pert (holoTaylor1D (g_top i) (lineChainMid α₀ i)) (Z_mid i) (ψ_top i)
              (hZmid0 i)).2.1,
            hTay0]
        rw [map_add, map_add, map_add, hc0.2.2, hTay1, hpi.1 M le_rfl, htop_M]
        ring

    have hsup_pert_grad : ∀ i : Fin k,
        PsEqUpTo J (polySup h_ℂ g_ext α₀ β_ext i) (polySup h_ℂ g_ext α₀ β_zero_top i) ∧
        PowerSeries.coeff 0 (polySup h_ℂ g_ext α₀ β_zero_top i) = h_ℂ (lineChainMid α₀ i) ∧
        PowerSeries.coeff M (polySup h_ℂ g_ext α₀ β_ext i) =
          PowerSeries.coeff M (polySup h_ℂ g_ext α₀ β_zero_top i) +
            deriv h_ℂ (lineChainMid α₀ i) * ψ_top i := by
      intro i
      have hbase_eq : polySup h_ℂ g_ext α₀ β_zero_top i =
          polySup h_ℂ g α₀ β i +
            PowerSeries.X ^ M * polyComp (holoTaylor1D (g_top i) (lineChainMid α₀ i)) (Z_mid i) := by
        have hsum_split :
            (∑ l : Fin (M + 1), PowerSeries.X ^ (l : ℕ) *
              polyComp (holoTaylor1D (g_ext i l) (lineChainMid α₀ i)) (Z_mid i)) =
            (∑ l : Fin (J + 1), PowerSeries.X ^ (l : ℕ) *
              polyComp (holoTaylor1D (g i l) (lineChainMid α₀ i)) (Z_mid i)) +
            PowerSeries.X ^ M * polyComp (holoTaylor1D (g_top i) (lineChainMid α₀ i)) (Z_mid i) := by
          rw [Fin.sum_univ_castSucc]
          congr 1
          · refine Finset.sum_congr rfl fun l _ => ?_
            dsimp only [g_ext]; rw [Fin.snoc_castSucc]; rfl
          · dsimp only [g_ext]; rw [Fin.snoc_last]; rfl
        dsimp only [polySup]
        rw [hmid_ztop_eq i, hsum_split]
        exact (add_assoc _ _ _).symm
      have hact := hsup_pert_act i
      refine ⟨fun n hn => ?_, ?_, ?_⟩
      · conv_rhs =>
          rw [hbase_eq, map_add, PowerSeries.coeff_X_pow_mul',
            if_neg (not_le.mpr (Nat.lt_succ_of_le hn)), add_zero]
        exact hact.1 n hn
      · rw [hbase_eq, map_add, hact.2.1, PowerSeries.coeff_X_pow_mul',
          if_neg (not_le.mpr (Nat.succ_pos J)), add_zero]
      · conv_rhs =>
          arg 1
          rw [hbase_eq, map_add, PowerSeries.coeff_X_pow_mul',
            if_pos le_rfl, Nat.sub_self,
            (hcomp_pert (holoTaylor1D (g_top i) (lineChainMid α₀ i)) (Z_mid i) (ψ_top i)
              (hZmid0 i)).2.1,
            hTay0]
        rw [hact.2.2]
        ring

    have hsupD_pert_grad : ∀ i : Fin k,
        PsEqUpTo J (polySupDeriv h_ℂ g_ext α₀ β_ext i) (polySupDeriv h_ℂ g_ext α₀ β_zero_top i) ∧
        PowerSeries.coeff 0 (polySupDeriv h_ℂ g_ext α₀ β_zero_top i) =
          deriv h_ℂ (lineChainMid α₀ i) ∧
        PowerSeries.coeff M (polySupDeriv h_ℂ g_ext α₀ β_ext i) =
          PowerSeries.coeff M (polySupDeriv h_ℂ g_ext α₀ β_zero_top i) +
            deriv (deriv h_ℂ) (lineChainMid α₀ i) * ψ_top i := by
      intro i
      have hext_eq : polySupDeriv h_ℂ g_ext α₀ β_ext i =
          polyComp (holoTaylor1D (deriv h_ℂ) (lineChainMid α₀ i))
            (Z_mid i + PowerSeries.C (ψ_top i) * PowerSeries.X ^ M) +
          (∑ l : Fin (J + 1), PowerSeries.X ^ (l : ℕ) *
            polyComp (holoTaylor1D (deriv (g i l)) (lineChainMid α₀ i))
              (Z_mid i + PowerSeries.C (ψ_top i) * PowerSeries.X ^ M)) +
          PowerSeries.X ^ M *
            polyComp (holoTaylor1D (deriv (g_top i)) (lineChainMid α₀ i))
              (Z_mid i + PowerSeries.C (ψ_top i) * PowerSeries.X ^ M) := by
        have hsum_split :
            (∑ l : Fin (M + 1), PowerSeries.X ^ (l : ℕ) *
              polyComp (holoTaylor1D (deriv (g_ext i l)) (lineChainMid α₀ i))
                (Z_mid i + PowerSeries.C (ψ_top i) * PowerSeries.X ^ M)) =
            (∑ l : Fin (J + 1), PowerSeries.X ^ (l : ℕ) *
              polyComp (holoTaylor1D (deriv (g i l)) (lineChainMid α₀ i))
                (Z_mid i + PowerSeries.C (ψ_top i) * PowerSeries.X ^ M)) +
            PowerSeries.X ^ M *
              polyComp (holoTaylor1D (deriv (g_top i)) (lineChainMid α₀ i))
                (Z_mid i + PowerSeries.C (ψ_top i) * PowerSeries.X ^ M) := by
          rw [Fin.sum_univ_castSucc]
          congr 1
          · refine Finset.sum_congr rfl fun l _ => ?_
            dsimp only [g_ext]; rw [Fin.snoc_castSucc]; rfl
          · dsimp only [g_ext]; rw [Fin.snoc_last]; rfl
        dsimp only [polySupDeriv]
        rw [hmid_ext_eq i, hsum_split, ← add_assoc]
      have hz_eq : polySupDeriv h_ℂ g_ext α₀ β_zero_top i =
          polyComp (holoTaylor1D (deriv h_ℂ) (lineChainMid α₀ i)) (Z_mid i) +
          (∑ l : Fin (J + 1), PowerSeries.X ^ (l : ℕ) *
            polyComp (holoTaylor1D (deriv (g i l)) (lineChainMid α₀ i)) (Z_mid i)) +
          PowerSeries.X ^ M *
            polyComp (holoTaylor1D (deriv (g_top i)) (lineChainMid α₀ i)) (Z_mid i) := by
        have hsum_split :
            (∑ l : Fin (M + 1), PowerSeries.X ^ (l : ℕ) *
              polyComp (holoTaylor1D (deriv (g_ext i l)) (lineChainMid α₀ i)) (Z_mid i)) =
            (∑ l : Fin (J + 1), PowerSeries.X ^ (l : ℕ) *
              polyComp (holoTaylor1D (deriv (g i l)) (lineChainMid α₀ i)) (Z_mid i)) +
            PowerSeries.X ^ M *
              polyComp (holoTaylor1D (deriv (g_top i)) (lineChainMid α₀ i)) (Z_mid i) := by
          rw [Fin.sum_univ_castSucc]
          congr 1
          · refine Finset.sum_congr rfl fun l _ => ?_
            dsimp only [g_ext]; rw [Fin.snoc_castSucc]; rfl
          · dsimp only [g_ext]; rw [Fin.snoc_last]; rfl
        dsimp only [polySupDeriv]
        rw [hmid_ztop_eq i, hsum_split, ← add_assoc]
      rw [hext_eq, hz_eq]
      have hdg0 : deriv (g i 0) = fun _ => 0 := by
        have h0fn : g i 0 = fun _ => 0 := funext (hg0 i)
        rw [h0fn]; ext z; exact deriv_const z (0 : ℂ)
      have hc0 := hcomp_pert (holoTaylor1D (deriv h_ℂ) (lineChainMid α₀ i)) (Z_mid i) (ψ_top i)
        (hZmid0 i)
      have hpi := hpert_inv i (fun l => deriv (g i l)) hdg0
      have hctop := hcomp_pert (holoTaylor1D (deriv (g_top i)) (lineChainMid α₀ i)) (Z_mid i)
        (ψ_top i) (hZmid0 i)
      refine ⟨fun n hn => ?_, ?_, ?_⟩
      · rw [map_add, map_add, map_add, map_add, hc0.1 n hn, hpi.1 n (Nat.le_succ_of_le hn),
          PowerSeries.coeff_X_pow_mul', PowerSeries.coeff_X_pow_mul',
          if_neg (not_le.mpr (Nat.lt_succ_of_le hn)),
          if_neg (not_le.mpr (Nat.lt_succ_of_le hn))]
      · rw [map_add, map_add, hc0.2.1, hTay0, hpi.2, PowerSeries.coeff_X_pow_mul',
          if_neg (not_le.mpr (Nat.succ_pos J)), add_zero, add_zero]
      · rw [map_add, map_add, map_add, map_add, hc0.2.2, hTay1, hpi.1 M le_rfl,
          PowerSeries.coeff_X_pow_mul', PowerSeries.coeff_X_pow_mul',
          if_pos le_rfl, if_pos le_rfl, Nat.sub_self,
          hctop.1 0 (Nat.zero_le J)]
        ring

    refine ⟨?_, ?_⟩
    · rw [hev_ext.1, hev_base.1]
      dsimp only [polyAct]
      rw [map_sum, map_sum]
      have hterm_split : ∀ i : Fin k,
          PowerSeries.coeff M (2 * polySup h_ℂ g_ext α₀ β_ext i * polySin α₀ β_ext i) =
            PowerSeries.coeff M (2 * polySup h_ℂ g α₀ β i * polySin α₀ β i) +
              2 * Complex.sin (lineChainHalfStep α₀ i) * g_top i (lineChainMid α₀ i) +
              ((deriv h_ℂ (lineChainMid α₀ i) * Complex.sin (lineChainHalfStep α₀ i) -
                  h_ℂ (lineChainMid α₀ i) * Complex.cos (lineChainHalfStep α₀ i)) *
                  β_top i.castSucc +
                (deriv h_ℂ (lineChainMid α₀ i) * Complex.sin (lineChainHalfStep α₀ i) +
                  h_ℂ (lineChainMid α₀ i) * Complex.cos (lineChainHalfStep α₀ i)) *
                  β_top i.succ) := by
        intro i
        have htwo_mul : ∀ P : PowerSeries ℂ, ∀ n : ℕ,
            PowerSeries.coeff n (2 * P) = 2 * PowerSeries.coeff n P := by
          intro P n
          have hC2 : (2 : PowerSeries ℂ) = PowerSeries.C 2 := (map_ofNat PowerSeries.C 2).symm
          rw [hC2, PowerSeries.coeff_C_mul]
        have h2sup_eq : PsEqUpTo J (2 * polySup h_ℂ g_ext α₀ β_ext i) (2 * polySup h_ℂ g α₀ β i) :=
          fun n hn => by rw [htwo_mul, htwo_mul, (hsup_pert_act i).1 n hn]
        have h2sup_M : PowerSeries.coeff M (2 * polySup h_ℂ g_ext α₀ β_ext i) =
            PowerSeries.coeff M (2 * polySup h_ℂ g α₀ β i) +
              2 * (deriv h_ℂ (lineChainMid α₀ i) * ψ_top i + g_top i (lineChainMid α₀ i)) := by
          rw [htwo_mul, htwo_mul, (hsup_pert_act i).2.2]; ring
        have hm := hmul_pert h2sup_eq (hsin_pert i).1 h2sup_M (hsin_pert i).2.2
        rw [hm, htwo_mul _ 0, (hsup_pert_act i).2.1, (hsin_pert i).2.1]
        dsimp only [ψ_top, d_top]
        ring
      simp_rw [hterm_split, Finset.sum_add_distrib]
      congr 1
      let A : Fin k → ℂ := fun i =>
        deriv h_ℂ (lineChainMid α₀ i) * Complex.sin (lineChainHalfStep α₀ i) -
          h_ℂ (lineChainMid α₀ i) * Complex.cos (lineChainHalfStep α₀ i)
      let B_seg : Fin k → ℂ := fun i =>
        deriv h_ℂ (lineChainMid α₀ i) * Complex.sin (lineChainHalfStep α₀ i) +
          h_ℂ (lineChainMid α₀ i) * Complex.cos (lineChainHalfStep α₀ i)
      change (∑ i : Fin k, A i * β_top i.castSucc) + (∑ i : Fin k, B_seg i * β_top i.succ) = _
      have hsum_cast : (∑ i : Fin k, A i * β_top i.castSucc) =
          ∑ r : Fin (k - 1),
            A ⟨r.1 + 1, by have := r.2; omega⟩ * β_top ⟨r.1 + 1, by have := r.2; omega⟩ := by
        let S_pos := Finset.univ.filter (fun i : Fin k => 1 ≤ i.1)
        have hfilt : (∑ i : Fin k, A i * β_top i.castSucc) =
            ∑ i ∈ S_pos, A i * β_top i.castSucc := by
          symm
          refine Finset.sum_subset (Finset.filter_subset _ _) fun i _ hi_not => ?_
          rw [Finset.mem_filter] at hi_not
          have hi0 : i.castSucc = 0 := Fin.ext (by
            have : ¬ 1 ≤ i.1 := fun h => hi_not ⟨Finset.mem_univ i, h⟩
            change i.1 = 0; omega)
          rw [hi0, hβ_top_end.1, mul_zero]
        rw [hfilt]
        refine Finset.sum_bij'
          (fun i hi => ⟨i.1 - 1, by have := i.2; have := (Finset.mem_filter.mp hi).2; omega⟩)
          (fun r _ => ⟨r.1 + 1, by have := r.2; omega⟩)
          (fun _ _ => Finset.mem_univ _)
          (fun r _ => Finset.mem_filter.mpr ⟨Finset.mem_univ _, by dsimp; omega⟩)
          (fun i hi => Fin.ext (by have := (Finset.mem_filter.mp hi).2; dsimp; omega))
          (fun r _ => Fin.ext (by dsimp))
          (fun i hi => by
            have h1 := (Finset.mem_filter.mp hi).2
            have hi_eq : (⟨i.1 - 1 + 1, by have := i.2; omega⟩ : Fin k) = i :=
