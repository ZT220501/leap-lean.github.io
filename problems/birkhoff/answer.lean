      have hZw_lo : D_rec / 2 < -Z_w.im := hZw_out.1
      have hZw_ge1 : 1 ≤ -Z_w.im := by linarith
      have hZw_hi : d_seq n * (-Z_w.im) ≤ δ_b :=
