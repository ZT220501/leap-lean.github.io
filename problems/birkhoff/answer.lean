    nlinarith
  let z : Fin P.N → ℂ := (r_y : ℂ) • P.w_vec y
  let F : Finset (Fin P.N) :=
    (Finset.univ \ I).filter (fun j : Fin P.N => Real.exp (-H_star / 8) < ‖z j‖)
