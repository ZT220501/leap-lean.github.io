              (E_base.Q_det ι d) * z ^ (d : ℕ) = 0 := by
        simpa only [E_base.A_coeff_def] using hz
      simpa only [E_base.A_coeff_def] using
        E_base.univ_separable ι _ z hA_last_nz hΔ_nz hz_eval
    have h_desc_ind :
        ∀ (k : ℕ) (hk : k < L_vert)
