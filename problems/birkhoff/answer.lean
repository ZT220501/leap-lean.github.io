    let t₀ : ℂ := p₀.2
    let U_slice : Set ℂ :=
      { y : ℂ | (y, t₀) ∈ W_up ∧ (y, t₀) ∈ finiteWallTube S.r_star S.h_X }
    let ι : ℂ → ℂ × ℂ := fun y => (y, t₀)
    have hι_diff : Differentiable ℂ ι :=
      Differentiable.prodMk differentiable_id (differentiable_const t₀)
    have hU_open : IsOpen U_slice :=
      (hW_up_open.inter S.tube_open).preimage hι_diff.continuous
    have hU_conv : Convex ℝ U_slice := by
      intro y₁ hy₁ y₂ hy₂ a b ha hb hab
      rcases hy₁ with ⟨⟨hy₁_1, hy₁_2, hy₁_3, hy₁_4, hy₁_5⟩, ⟨ht_r, hy₁_tlo, hy₁_thi⟩⟩
      rcases hy₂ with ⟨⟨hy₂_1, hy₂_2, hy₂_3, hy₂_4, _⟩, ⟨_, hy₂_tlo, hy₂_thi⟩⟩
      have hδ₁_pos : 0 < S.H - y₁.im := lt_trans (by positivity) hy₁_1
      have hδ₂_pos : 0 < S.H - y₂.im := lt_trans (by positivity) hy₂_1
      set z : ℂ := a • y₁ + b • y₂
      have hz_re : z.re = a * y₁.re + b * y₂.re := by simp [z]
      have hz_im : z.im = a * y₁.im + b * y₂.im := by simp [z]
      have hz_depth : S.H - z.im = a * (S.H - y₁.im) + b * (S.H - y₂.im) := by
        rw [hz_im]
        calc S.H - (a * y₁.im + b * y₂.im)
            = (a + b) * S.H - (a * y₁.im + b * y₂.im) := by rw [hab, one_mul]
          _ = a * (S.H - y₁.im) + b * (S.H - y₂.im) := by ring
      have hab_pos : 0 < a ∨ 0 < b := by
        by_contra! h_both
        linarith [ha, hb, hab]
      have h_lt_conv : ∀ u₁ u₂ c : ℝ, u₁ < c → u₂ < c → a * u₁ + b * u₂ < c := by
        intro u₁ u₂ c hu1 hu2
        have hc : c = a * c + b * c := by rw [← add_mul, hab, one_mul]
        rw [hc]
        rcases hab_pos with ha_p | hb_p
        · exact add_lt_add_of_lt_of_le (mul_lt_mul_of_pos_left hu1 ha_p)
            (mul_le_mul_of_nonneg_left hu2.le hb)
        · exact add_lt_add_of_le_of_lt (mul_le_mul_of_nonneg_left hu1.le ha)
            (mul_lt_mul_of_pos_left hu2 hb_p)
      have h_gt_conv : ∀ u₁ u₂ c : ℝ, c < u₁ → c < u₂ → c < a * u₁ + b * u₂ := by
        intro u₁ u₂ c hu1 hu2
        have hc : c = a * c + b * c := by rw [← add_mul, hab, one_mul]
        rw [hc]
        rcases hab_pos with ha_p | hb_p
        · exact add_lt_add_of_lt_of_le (mul_lt_mul_of_pos_left hu1 ha_p)
            (mul_le_mul_of_nonneg_left hu2.le hb)
        · exact add_lt_add_of_le_of_lt (mul_le_mul_of_nonneg_left hu1.le ha)
            (mul_lt_mul_of_pos_left hu2 hb_p)
      refine ⟨⟨?_, ?_, ?_, ?_, hy₁_5⟩, ⟨ht_r, ?_, ?_⟩⟩
      · change d / 2 < S.H - z.im
        rw [hz_depth]
        exact h_gt_conv _ _ _ hy₁_1 hy₂_1
      · change S.H - z.im < δ_ceil
        rw [hz_depth]
        exact h_lt_conv _ _ _ hy₁_2 hy₂_2
      · change |z.re - x₀| < m_steep * (S.H - z.im)
        have hz_re_sub : z.re - x₀ = a * (y₁.re - x₀) + b * (y₂.re - x₀) := by
          rw [hz_re]
          calc a * y₁.re + b * y₂.re - x₀
              = a * y₁.re + b * y₂.re - (a + b) * x₀ := by rw [hab, one_mul]
            _ = a * (y₁.re - x₀) + b * (y₂.re - x₀) := by ring
        have htri : |z.re - x₀| ≤ a * |y₁.re - x₀| + b * |y₂.re - x₀| := by
          rw [hz_re_sub]
          calc |a * (y₁.re - x₀) + b * (y₂.re - x₀)|
              ≤ |a * (y₁.re - x₀)| + |b * (y₂.re - x₀)| := abs_add_le _ _
            _ = a * |y₁.re - x₀| + b * |y₂.re - x₀| := by
                rw [abs_mul, abs_mul, abs_of_nonneg ha, abs_of_nonneg hb]
        have h_sum_lt : a * |y₁.re - x₀| + b * |y₂.re - x₀| <
            a * (m_steep * (S.H - y₁.im)) + b * (m_steep * (S.H - y₂.im)) := by
          rcases hab_pos with ha_p | hb_p
          · exact add_lt_add_of_lt_of_le (mul_lt_mul_of_pos_left hy₁_3 ha_p)
              (mul_le_mul_of_nonneg_left hy₂_3.le hb)
          · exact add_lt_add_of_le_of_lt (mul_le_mul_of_nonneg_left hy₁_3.le ha)
              (mul_lt_mul_of_pos_left hy₂_3 hb_p)
        rw [hz_depth, mul_add]
        linarith [htri, h_sum_lt]
      · change ‖t₀‖ < 10 * r * ((S.H - z.im) / d) ^ α
        rcases le_total (S.H - y₁.im) (S.H - y₂.im) with h12 | h21
        · have hz_ge : S.H - y₁.im ≤ S.H - z.im := by
            have hb_mul : b * (S.H - y₁.im) ≤ b * (S.H - y₂.im) :=
              mul_le_mul_of_nonneg_left h12 hb
            rw [hz_depth]
            calc S.H - y₁.im = (a + b) * (S.H - y₁.im) := by rw [hab, one_mul]
              _ = a * (S.H - y₁.im) + b * (S.H - y₁.im) := by ring
              _ ≤ a * (S.H - y₁.im) + b * (S.H - y₂.im) := by linarith
          have hrpow_le : ((S.H - y₁.im) / d) ^ α ≤ ((S.H - z.im) / d) ^ α :=
            Real.rpow_le_rpow (by positivity)
              (div_le_div_of_nonneg_right hz_ge hd_pos.le) hα_pos.le
          exact lt_of_lt_of_le hy₁_4 (mul_le_mul_of_nonneg_left hrpow_le (by positivity))
        · have hz_ge : S.H - y₂.im ≤ S.H - z.im := by
            have ha_mul : a * (S.H - y₂.im) ≤ a * (S.H - y₁.im) :=
              mul_le_mul_of_nonneg_left h21 ha
            rw [hz_depth]
            calc S.H - y₂.im = (a + b) * (S.H - y₂.im) := by rw [hab, one_mul]
              _ = a * (S.H - y₂.im) + b * (S.H - y₂.im) := by ring
              _ ≤ a * (S.H - y₁.im) + b * (S.H - y₂.im) := by linarith
          have hrpow_le : ((S.H - y₂.im) / d) ^ α ≤ ((S.H - z.im) / d) ^ α :=
            Real.rpow_le_rpow (by positivity)
              (div_le_div_of_nonneg_right hz_ge hd_pos.le) hα_pos.le
          exact lt_of_lt_of_le hy₂_4 (mul_le_mul_of_nonneg_left hrpow_le (by positivity))
      · change -S.h_X (starRingEnd ℂ t₀) < z.im
        rw [hz_im]
        exact h_gt_conv _ _ _ hy₁_tlo hy₂_tlo
      · change z.im < S.h_X t₀
        rw [hz_im]
        exact h_lt_conv _ _ _ hy₁_thi hy₂_thi
    have h_ana_up : AnalyticOnNhd ℂ (fun y => s_up (y, t₀)) U_slice :=
      (hs_up_holo_and_bound.1.comp hι_diff.differentiableOn (fun _ hy => hy.1)).analyticOnNhd
        hU_open
    have h_ana_𝔰 : AnalyticOnNhd ℂ (fun y => S.𝔰 (y, t₀)) U_slice :=
      (S.𝔰_holo.comp hι_diff.differentiableOn (fun _ hy => hy.2)).analyticOnNhd hU_open
    let y_anch : ℂ := (y₀.re : ℂ) + ((S.H - (3 / 4 : ℝ) * δ_ceil : ℝ) : ℂ) * Complex.I
    have hy_anch_re : y_anch.re = y₀.re := by simp [y_anch]
    have hy_anch_im : y_anch.im = S.H - (3 / 4 : ℝ) * δ_ceil := by simp [y_anch]
    have hy_anch_depth : S.H - y_anch.im = (3 / 4 : ℝ) * δ_ceil := by
      rw [hy_anch_im]; ring
    have hy₀_lt_anch : S.H - y₀.im < S.H - y_anch.im := by
      rw [hy_anch_depth]; linarith [h_deep, hδc_pos]
    have hy_anch_mem : y_anch ∈ U_slice := by
      refine ⟨⟨?_, ?_, ?_, ?_, hp5⟩, ⟨hp_tube.1, ?_, ?_⟩⟩
      · exact lt_trans hp1 hy₀_lt_anch
      · rw [hy_anch_depth]; linarith [hδc_pos]
      · rw [hy_anch_re]
        exact lt_trans hp3 (mul_lt_mul_of_pos_left hy₀_lt_anch hm_pos)
      · have hrpow_le : ((S.H - y₀.im) / d) ^ α ≤ ((S.H - y_anch.im) / d) ^ α :=
          Real.rpow_le_rpow (by positivity)
            (div_le_div_of_nonneg_right hy₀_lt_anch.le hd_pos.le) hα_pos.le
        exact lt_of_lt_of_le hp4 (mul_le_mul_of_nonneg_left hrpow_le (by positivity))
      · have hconj_ball : starRingEnd ℂ t₀ ∈ Metric.ball (0 : ℂ) S.r_star := by
          simpa [Metric.mem_ball, dist_zero_right, Complex.norm_conj] using hp_tube.1
        have hs_le : S.s_star ≤ S.h_X (starRingEnd ℂ t₀) :=
          (S.h_X_bounds _ hconj_ball).1
        rw [hy_anch_im]
        linarith [hs_le, S.s_star_pos, hδc_lt_half, S.H_pos]
      · linarith [hy₀_lt_anch, hp_tube.2.2]
    let W_anch : Set ℂ := U_slice ∩ { y : ℂ | (1 / 3 : ℝ) * δ_ceil < S.H - y.im }
    have hW_anch_open : IsOpen W_anch :=
      hU_open.inter (isOpen_lt continuous_const (continuous_const.sub Complex.continuous_im))
    have hy_anch_W : y_anch ∈ W_anch :=
      ⟨hy_anch_mem, show (1 / 3 : ℝ) * δ_ceil < S.H - y_anch.im by
        rw [hy_anch_depth]; linarith [hδc_pos]⟩
    have h_ev : (fun y => s_up (y, t₀)) =ᶠ[nhds y_anch] (fun y => S.𝔰 (y, t₀)) :=
      Filter.eventuallyEq_of_mem (hW_anch_open.mem_nhds hy_anch_W)
        (fun y hy => hs2_deep (y, t₀) hy.1.1 hy.2)
    have hy₀_mem : y₀ ∈ U_slice := ⟨hp₀, hp_tube⟩
    exact h_ana_up.eqOn_of_preconnected_of_eventuallyEq h_ana_𝔰 hU_conv.isPreconnected
      hy_anch_mem h_ev hy₀_mem

theorem steep_sector_cone_continuation (S : FiniteWallNonisotropicStrip)
    (A : SmallFieldChordActionData S) :
    SteepSectorPassageProp S :=
by
  have hJets : SteepContJetProp S A := steep_action_perturbation_jets S A
  have hSolver : SteepContSolverProp S A := steep_holomorphic_step_solver S A hJets
  have hBase : SteepContBaseBoundsProp S A := base_substrip_lift_quadratic_bounds S A
  have hAdm : SteepContStepAdmProp S A :=
    steep_cone_step_admissibility_and_mesh_sum S A hJets
  have hUp : SteepContUpwardProp S :=
    upward_steep_sector_passage S A hSolver hBase hAdm
  intro α m_steep γ_steep δ_ceil δ_b hα1 hα2 hm_pos hγ_pos hγ_lt hδc_pos hδc_lt_b hδb_lt_H
  let L : ℝ := 2 * (m_steep + 1 / γ_steep + 1)
  have hL_ge : m_steep ≤ L := by
    have h_inv_pos : 0 < 1 / γ_steep := div_pos one_pos hγ_pos
    dsimp [L]
    linarith
  refine ⟨L, hL_ge, ?_⟩
  intro K hK_pos
  obtain ⟨C_st, ε_st, d_st, hC_pos, hε_st_pos, hd_st_pos, hUpK⟩ :=
    hUp α m_steep γ_steep δ_ceil δ_b hα1 hα2 hm_pos hγ_pos hγ_lt hδc_pos hδc_lt_b hδb_lt_H K hK_pos
  refine ⟨C_st, ε_st, d_st, hC_pos, hε_st_pos, hd_st_pos, ?_⟩
  intro d x₀ r ε hd_pos hd_lt hr_pos hr_le hε_pos hε_le hCone
  obtain ⟨s_up, hs_up_holo, hs_up_props⟩ :=
    hUpK d x₀ r ε hd_pos hd_lt hr_pos hr_le hε_pos hε_le hCone
  let W_up : Set (ℂ × ℂ) :=
    { p : ℂ × ℂ |
      d / 2 < S.H - p.1.im ∧ S.H - p.1.im < δ_ceil ∧
      |p.1.re - x₀| < m_steep * (S.H - p.1.im) ∧
      ‖p.2‖ < 10 * r * ((S.H - p.1.im) / d) ^ α ∧
      γ_steep * ‖p.2‖ < p.2.im }
  let W_steep : Set (ℂ × ℂ) :=
    { p : ℂ × ℂ |
      d / 2 < S.H - p.1.im ∧ S.H - p.1.im < δ_ceil ∧
      |p.1.re - x₀| < m_steep * (S.H - p.1.im) ∧
      ‖p.2‖ < 10 * r * ((S.H - p.1.im) / d) ^ α ∧
      γ_steep * ‖p.2‖ < |p.2.im| }
  let s_steep : ℂ × ℂ → ℂ := fun p => if 0 ≤ p.2.im then s_up p else s_up (p.1, -p.2)
  refine ⟨s_steep, ?_, ?_⟩
  · intro p hp
    have h_abs_pos : 0 < |p.2.im| :=
      lt_of_le_of_lt (mul_nonneg hγ_pos.le (norm_nonneg p.2)) hp.2.2.2.2
    have him_ne : p.2.im ≠ 0 := abs_pos.mp h_abs_pos
    rcases lt_or_gt_of_ne him_ne with him_neg | him_pos
    · let U_neg : Set (ℂ × ℂ) := { q : ℂ × ℂ | q.2.im < 0 }
      have hU_neg_open : IsOpen U_neg :=
        isOpen_lt (Complex.continuous_im.comp continuous_snd) continuous_const
      let neg2 : ℂ × ℂ → ℂ × ℂ := fun q => (q.1, -q.2)
      have hneg2_diff : Differentiable ℂ neg2 :=
        Differentiable.prodMk differentiable_fst differentiable_snd.neg
      have h_maps : Set.MapsTo neg2 (W_steep ∩ U_neg) W_up := by
        intro q hq
        rcases hq with ⟨⟨hq1, hq2, hq3, hq4, hq5⟩, hq_neg⟩
        have habs : |q.2.im| = -q.2.im := abs_of_neg hq_neg
        refine ⟨hq1, hq2, hq3, ?_, ?_⟩
        · simpa [neg2] using hq4
        · simpa [neg2, habs] using hq5
      have h_comp_holo : DifferentiableOn ℂ (s_up ∘ neg2) (W_steep ∩ U_neg) :=
        hs_up_holo.comp hneg2_diff.differentiableOn h_maps
      have h_eq : Set.EqOn s_steep (s_up ∘ neg2) (W_steep ∩ U_neg) := by
        intro q hq
        have h_not_nonneg : ¬ (0 ≤ q.2.im) := not_le.mpr hq.2
        simp [s_steep, neg2, h_not_nonneg]
      have h_inter : DifferentiableWithinAt ℂ s_steep (W_steep ∩ U_neg) p :=
        (h_comp_holo.congr h_eq) p ⟨hp, him_neg⟩
      exact (differentiableWithinAt_inter (hU_neg_open.mem_nhds him_neg)).mp h_inter
    · let U_pos : Set (ℂ × ℂ) := { q : ℂ × ℂ | 0 < q.2.im }
      have hU_pos_open : IsOpen U_pos :=
        isOpen_lt continuous_const (Complex.continuous_im.comp continuous_snd)
      have h_sub : W_steep ∩ U_pos ⊆ W_up := by
        intro q hq
        rcases hq with ⟨⟨hq1, hq2, hq3, hq4, hq5⟩, hq_pos⟩
        have habs : |q.2.im| = q.2.im := abs_of_pos hq_pos
        refine ⟨hq1, hq2, hq3, hq4, ?_⟩
        rwa [habs] at hq5
      have h_up_inter : DifferentiableOn ℂ s_up (W_steep ∩ U_pos) :=
        hs_up_holo.mono h_sub
      have h_eq : Set.EqOn s_steep s_up (W_steep ∩ U_pos) := by
        intro q hq
        have hq_nonneg : 0 ≤ q.2.im := le_of_lt hq.2
        dsimp only [s_steep]
        split_ifs
        rfl
      have h_inter : DifferentiableWithinAt ℂ s_steep (W_steep ∩ U_pos) p :=
        (h_up_inter.congr h_eq) p ⟨hp, him_pos⟩
      exact (differentiableWithinAt_inter (hU_pos_open.mem_nhds him_pos)).mp h_inter
  · intro p hp1 hp2 hp3 hp4 hp5
    have h_abs_pos : 0 < |p.2.im| :=
      lt_of_le_of_lt (mul_nonneg hγ_pos.le (norm_nonneg p.2)) hp5
    have him_ne : p.2.im ≠ 0 := abs_pos.mp h_abs_pos
    rcases lt_or_gt_of_ne him_ne with him_neg | him_pos
    · have h_not_nonneg : ¬ (0 ≤ p.2.im) := not_le.mpr him_neg
      have h_neg_nonneg : 0 ≤ (-p.2).im := by simp; linarith
      have habs : |p.2.im| = (-p.2).im := by simp [abs_of_neg him_neg]
      have h_up := hs_up_props (p.1, -p.2) hp1 hp2 hp3
        (by simpa using hp4) (by simpa [habs] using hp5)
      have hs_eq : s_steep p = s_up (p.1, -p.2) := by
        dsimp only [s_steep]
        split_ifs
        rfl
      have hs_even : s_steep (p.1, -p.2) = s_steep p := by
        rw [hs_eq]
        dsimp only [s_steep]
        split_ifs
        rfl
      refine ⟨?_, hs_even, ?_, ?_⟩
      · rw [hs_eq]
        exact h_up.1
      · rw [hs_eq]
        simpa using h_up.2.1
      · intro hp_tube
        rcases hp_tube with ⟨ht_norm, ht_lo, ht_hi⟩
        have ht_ball : p.2 ∈ Metric.ball (0 : ℂ) S.r_star := by
          simpa [Metric.mem_ball, dist_zero_right] using ht_norm
        have hconj_ball : starRingEnd ℂ p.2 ∈ Metric.ball (0 : ℂ) S.r_star := by
          simpa [Metric.mem_ball, dist_zero_right, Complex.norm_conj] using ht_norm
        have h_neg_tube : (p.1, -p.2) ∈ finiteWallTube S.r_star S.h_X := by
          refine ⟨by simpa using ht_norm, ?_, ?_⟩
          · rw [map_neg, S.h_X_even (starRingEnd ℂ p.2) hconj_ball]
            exact ht_lo
          · rw [S.h_X_even p.2 ht_ball]
            exact ht_hi
        have h_tube_orig : p ∈ finiteWallTube S.r_star S.h_X := ⟨ht_norm, ht_lo, ht_hi⟩
        rw [hs_eq, h_up.2.2 h_neg_tube, S.𝔰_even p h_tube_orig]
    · have h_nonneg : 0 ≤ p.2.im := him_pos.le
      have h_neg_not_nonneg : ¬ (0 ≤ (-p.2).im) := by simp [not_le, him_pos]
      have habs : |p.2.im| = p.2.im := abs_of_pos him_pos
      have h_up := hs_up_props p hp1 hp2 hp3 hp4 (by rwa [habs] at hp5)
      have hs_eq : s_steep p = s_up p := by
        dsimp only [s_steep]
        split_ifs
        rfl
      have hs_even : s_steep (p.1, -p.2) = s_steep p := by
        rw [hs_eq]
        dsimp only [s_steep]
        split_ifs
        simp
      refine ⟨?_, hs_even, ?_, ?_⟩
      · rw [hs_eq]
        exact h_up.1
      · rw [hs_eq]
        exact h_up.2.1
      · intro hp_tube
        rw [hs_eq]
        exact h_up.2.2 hp_tube

theorem analytic_disk_cone_passage (S : FiniteWallNonisotropicStrip)
    (hSteep : SteepSectorPassageProp S) :
    ConePassageProp S :=
by
  classical
  let adBumpProp : ℝ → ℝ → ℝ → Prop := fun D₀ C₀ γ =>
    0 < C₀ ∧ 0 < γ ∧ γ < 1 / 4 ∧
    ∀ c : ℂ, ‖c‖ < 1 / 3 →
      ∃ g : ℂ → ℂ,
        Differentiable ℂ g ∧
        g 0 = 0 ∧
        (∀ ζ : ℂ, ‖ζ‖ ≤ 1 → ‖g ζ‖ ≤ C₀) ∧
        (∀ θ : ℝ, (g (circleMap 0 1 θ)).im ≤ 1 / 5) ∧
        (∀ θ : ℝ, |(c + circleMap 0 1 θ).im| ≤ γ * ‖c + circleMap 0 1 θ‖ →
          (g (circleMap 0 1 θ)).im ≤ -(D₀ + 1))
  let adConeDomain : ℝ → ℝ → ℝ → ℝ → ℝ → ℝ → ℝ → ℝ → Set (ℂ × ℂ) :=
    fun H x₀ m d r α δ_min δ_ceil =>
      { p : ℂ × ℂ |
        δ_min < H - p.1.im ∧ H - p.1.im < δ_ceil ∧
        |p.1.re - x₀| < m * (H - p.1.im) ∧
        ‖p.2‖ < r * ((H - p.1.im) / d) ^ α }
  let adSteepDomain : ℝ → ℝ → ℝ → ℝ → ℝ → ℝ → ℝ → ℝ → Set (ℂ × ℂ) :=
    fun H x₀ m_steep γ_steep d r α δ_ceil =>
      { p : ℂ × ℂ |
        d / 2 < H - p.1.im ∧ H - p.1.im < δ_ceil ∧
        |p.1.re - x₀| < m_steep * (H - p.1.im) ∧
        ‖p.2‖ < 10 * r * ((H - p.1.im) / d) ^ α ∧
        γ_steep * ‖p.2‖ < |p.2.im| }
  let adCirclePatchProp : Prop :=
    ∀ (V_comb P_patch : Set (ℂ × ℂ)) (U_comb : ℂ × ℂ → ℂ) (Φ_base : ℂ → ℂ × ℂ),
      IsOpen V_comb →
      DifferentiableOn ℂ U_comb V_comb →
      IsOpen P_patch →
