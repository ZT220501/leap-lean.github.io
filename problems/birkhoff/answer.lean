      have hd2 : HasDerivAt (fun t : ℝ => Real.exp (-2 * t)) (Real.exp (-2 * u) * (-2)) u := by
        simpa [Function.comp_def, mul_comm] using
          (Real.hasDerivAt_exp (-2 * u)).hasFDerivAt.comp_hasDerivAt u hd1
      have hd3 := hd2.const_mul (-4 : ℝ)
      have h_val : -4 * (Real.exp (-2 * u) * (-2)) = 8 * Real.exp (-2 * u) := by ring
      rwa [h_val] at hd3
    rw [intervalIntegral.integral_eq_sub_of_hasDerivAt h_prim h_exp2_int]
    have h1 : Real.exp (-2 * k₀) ≤ 1 := Real.exp_le_one_iff.mpr (by linarith)
    have h2 : 0 < Real.exp (-2 * K) := Real.exp_pos _
