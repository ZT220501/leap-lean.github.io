              (hDiff_mul (hdy_holo i_L) (hF''x_holo_ell i_L.succ)))
            (hDiff_sq (hℓ_holo_ell i_L)))
          (hDiff_sq (hn_holo i_L i_L.succ)),
        htay_sub_ell
          (hDiff_mul
            (hDiff_sub (hDiff_add (differentiableOn_const (1 : ℂ)) (hDiff_sq (hF'x_holo_ell i_R.castSucc)))
              (hDiff_mul (hdy_holo i_R) (hF''x_holo_ell i_R.castSucc)))
            (hDiff_sq (hℓ_holo_ell i_R)))
          (hDiff_sq (hn_holo i_R i_R.castSucc)),
        htay_mul_ell
          (hDiff_add (hDiff_add (differentiableOn_const (1 : ℂ)) (hDiff_sq (hF'x_holo_ell i_L.succ)))
            (hDiff_mul (hdy_holo i_L) (hF''x_holo_ell i_L.succ)))
          (hDiff_sq (hℓ_holo_ell i_L)),
        htay_mul_ell
          (hDiff_sub (hDiff_add (differentiableOn_const (1 : ℂ)) (hDiff_sq (hF'x_holo_ell i_R.castSucc)))
            (hDiff_mul (hdy_holo i_R) (hF''x_holo_ell i_R.castSucc)))
          (hDiff_sq (hℓ_holo_ell i_R)),
        htay_add_ell (hDiff_add (differentiableOn_const (1 : ℂ)) (hDiff_sq (hF'x_holo_ell i_L.succ)))
          (hDiff_mul (hdy_holo i_L) (hF''x_holo_ell i_L.succ)),
        htay_sub_ell (hDiff_add (differentiableOn_const (1 : ℂ)) (hDiff_sq (hF'x_holo_ell i_R.castSucc)))
          (hDiff_mul (hdy_holo i_R) (hF''x_holo_ell i_R.castSucc)),
        htay_add_ell (differentiableOn_const (1 : ℂ)) (hDiff_sq (hF'x_holo_ell i_L.succ)),
        htay_add_ell (differentiableOn_const (1 : ℂ)) (hDiff_sq (hF'x_holo_ell i_R.castSucc)),
        htay_mul_ell (hdy_holo i_L) (hF''x_holo_ell i_L.succ),
        htay_mul_ell (hdy_holo i_R) (hF''x_holo_ell i_R.castSucc),
        htay_sq_ell (hF'x_holo_ell i_L.succ), htay_sq_ell (hF'x_holo_ell i_R.castSucc),
        htay_sq_ell (hℓ_holo_ell i_L), htay_sq_ell (hℓ_holo_ell i_R),
        htay_sq_ell (hn_holo i_L i_L.succ), htay_sq_ell (hn_holo i_R i_R.castSucc),
        hJet.taylor2D_const, map_one,
        htay_Dy i_L, htay_Dy i_R, htay_F' i_L.succ, htay_F' i_R.castSucc,
        htay_F'' i_L.succ, htay_F'' i_R.castSucc,
        htay_n i_L i_L.succ, htay_n i_R i_R.castSucc,
        show taylor2D (G.ℓ_fn i_L) p₁ = pointRecLen0 ℓ_star x_star f₀ β₀ i_L from hL_tay_eq i_L,
        show taylor2D (G.ℓ_fn i_R) p₁ = pointRecLen0 ℓ_star x_star f₀ β₀ i_R from hL_tay_eq i_R]
      dsimp only [pointRecHess0]; rw [if_pos h1]
    · by_cases h2 : s.1 = r.1 + 1
      · have hfn : ∀ q ∈ U_ell, pointInteriorHess (fun i => G.ℓ_fn i q) G.F (deriv G.F)
            (deriv (deriv G.F)) (fun u => G.x_fn u q) r s =
              ((-1 - deriv G.F (G.x_fn i_R.succ q) * deriv G.F (G.x_fn i_R.castSucc q)) *
                  (G.ℓ_fn i_R q) ^ 2 +
                ((G.x_fn i_R.succ q - G.x_fn i_R.castSucc q) +
                  (G.F (G.x_fn i_R.succ q) - G.F (G.x_fn i_R.castSucc q)) *
                    deriv G.F (G.x_fn i_R.castSucc q)) *
                ((G.x_fn i_R.succ q - G.x_fn i_R.castSucc q) +
                  (G.F (G.x_fn i_R.succ q) - G.F (G.x_fn i_R.castSucc q)) *
                    deriv G.F (G.x_fn i_R.succ q))) * ((G.ℓ_fn i_R q)⁻¹) ^ 3 := by
          intro q _; dsimp only [pointInteriorHess]
          rw [if_neg h1, if_pos h2, div_eq_mul_inv, inv_pow]
        rw [hJet.taylor2D_congr hU_ell_open hp₁_U_ell hfn]
        have hnum_holo : DifferentiableOn ℂ
            (fun q => ((-1 : ℂ) - deriv G.F (G.x_fn i_R.succ q) *
                deriv G.F (G.x_fn i_R.castSucc q)) * (G.ℓ_fn i_R q) ^ 2 +
              ((G.x_fn i_R.succ q - G.x_fn i_R.castSucc q) +
                (G.F (G.x_fn i_R.succ q) - G.F (G.x_fn i_R.castSucc q)) *
                  deriv G.F (G.x_fn i_R.castSucc q)) *
              ((G.x_fn i_R.succ q - G.x_fn i_R.castSucc q) +
                (G.F (G.x_fn i_R.succ q) - G.F (G.x_fn i_R.castSucc q)) *
                  deriv G.F (G.x_fn i_R.succ q))) U_ell :=
          hDiff_add
            (hDiff_mul
              (hDiff_sub (differentiableOn_const (-1 : ℂ))
                (hDiff_mul (hF'x_holo_ell i_R.succ) (hF'x_holo_ell i_R.castSucc)))
              (hDiff_sq (hℓ_holo_ell i_R)))
            (hDiff_mul (hn_holo i_R i_R.castSucc) (hn_holo i_R i_R.succ))
        rw [htay_mul_inv_cube hnum_holo i_R,
          htay_add_ell
            (hDiff_mul
              (hDiff_sub (differentiableOn_const (-1 : ℂ))
                (hDiff_mul (hF'x_holo_ell i_R.succ) (hF'x_holo_ell i_R.castSucc)))
              (hDiff_sq (hℓ_holo_ell i_R)))
            (hDiff_mul (hn_holo i_R i_R.castSucc) (hn_holo i_R i_R.succ)),
          htay_mul_ell
            (hDiff_sub (differentiableOn_const (-1 : ℂ))
              (hDiff_mul (hF'x_holo_ell i_R.succ) (hF'x_holo_ell i_R.castSucc)))
            (hDiff_sq (hℓ_holo_ell i_R)),
          htay_sub_ell (differentiableOn_const (-1 : ℂ))
            (hDiff_mul (hF'x_holo_ell i_R.succ) (hF'x_holo_ell i_R.castSucc)),
          htay_mul_ell (hF'x_holo_ell i_R.succ) (hF'x_holo_ell i_R.castSucc),
          htay_sq_ell (hℓ_holo_ell i_R),
          htay_mul_ell (hn_holo i_R i_R.castSucc) (hn_holo i_R i_R.succ),
          hJet.taylor2D_const, map_neg, map_one,
          htay_F' i_R.succ, htay_F' i_R.castSucc,
          htay_n i_R i_R.castSucc, htay_n i_R i_R.succ,
          show taylor2D (G.ℓ_fn i_R) p₁ = pointRecLen0 ℓ_star x_star f₀ β₀ i_R from hL_tay_eq i_R]
        dsimp only [pointRecHess0]; rw [if_neg h1, if_pos h2]
      · by_cases h3 : r.1 = s.1 + 1
        · have hfn : ∀ q ∈ U_ell, pointInteriorHess (fun i => G.ℓ_fn i q) G.F (deriv G.F)
              (deriv (deriv G.F)) (fun u => G.x_fn u q) r s =
                ((-1 - deriv G.F (G.x_fn i_L.castSucc q) * deriv G.F (G.x_fn i_L.succ q)) *
                    (G.ℓ_fn i_L q) ^ 2 +
                  ((G.x_fn i_L.succ q - G.x_fn i_L.castSucc q) +
                    (G.F (G.x_fn i_L.succ q) - G.F (G.x_fn i_L.castSucc q)) *
                      deriv G.F (G.x_fn i_L.succ q)) *
                  ((G.x_fn i_L.succ q - G.x_fn i_L.castSucc q) +
                    (G.F (G.x_fn i_L.succ q) - G.F (G.x_fn i_L.castSucc q)) *
                      deriv G.F (G.x_fn i_L.castSucc q))) * ((G.ℓ_fn i_L q)⁻¹) ^ 3 := by
            intro q _; dsimp only [pointInteriorHess]
            rw [if_neg h1, if_neg h2, if_pos h3, div_eq_mul_inv, inv_pow]
          rw [hJet.taylor2D_congr hU_ell_open hp₁_U_ell hfn]
          have hnum_holo : DifferentiableOn ℂ
              (fun q => ((-1 : ℂ) - deriv G.F (G.x_fn i_L.castSucc q) *
                  deriv G.F (G.x_fn i_L.succ q)) * (G.ℓ_fn i_L q) ^ 2 +
                ((G.x_fn i_L.succ q - G.x_fn i_L.castSucc q) +
                  (G.F (G.x_fn i_L.succ q) - G.F (G.x_fn i_L.castSucc q)) *
                    deriv G.F (G.x_fn i_L.succ q)) *
                ((G.x_fn i_L.succ q - G.x_fn i_L.castSucc q) +
                  (G.F (G.x_fn i_L.succ q) - G.F (G.x_fn i_L.castSucc q)) *
                    deriv G.F (G.x_fn i_L.castSucc q))) U_ell :=
            hDiff_add
              (hDiff_mul
                (hDiff_sub (differentiableOn_const (-1 : ℂ))
                  (hDiff_mul (hF'x_holo_ell i_L.castSucc) (hF'x_holo_ell i_L.succ)))
                (hDiff_sq (hℓ_holo_ell i_L)))
              (hDiff_mul (hn_holo i_L i_L.succ) (hn_holo i_L i_L.castSucc))
          rw [htay_mul_inv_cube hnum_holo i_L,
            htay_add_ell
              (hDiff_mul
                (hDiff_sub (differentiableOn_const (-1 : ℂ))
                  (hDiff_mul (hF'x_holo_ell i_L.castSucc) (hF'x_holo_ell i_L.succ)))
                (hDiff_sq (hℓ_holo_ell i_L)))
              (hDiff_mul (hn_holo i_L i_L.succ) (hn_holo i_L i_L.castSucc)),
            htay_mul_ell
              (hDiff_sub (differentiableOn_const (-1 : ℂ))
                (hDiff_mul (hF'x_holo_ell i_L.castSucc) (hF'x_holo_ell i_L.succ)))
              (hDiff_sq (hℓ_holo_ell i_L)),
            htay_sub_ell (differentiableOn_const (-1 : ℂ))
              (hDiff_mul (hF'x_holo_ell i_L.castSucc) (hF'x_holo_ell i_L.succ)),
            htay_mul_ell (hF'x_holo_ell i_L.castSucc) (hF'x_holo_ell i_L.succ),
            htay_sq_ell (hℓ_holo_ell i_L),
            htay_mul_ell (hn_holo i_L i_L.succ) (hn_holo i_L i_L.castSucc),
            hJet.taylor2D_const, map_neg, map_one,
            htay_F' i_L.castSucc, htay_F' i_L.succ,
            htay_n i_L i_L.succ, htay_n i_L i_L.castSucc,
            show taylor2D (G.ℓ_fn i_L) p₁ = pointRecLen0 ℓ_star x_star f₀ β₀ i_L from hL_tay_eq i_L]
          dsimp only [pointRecHess0]; rw [if_neg h1, if_neg h2, if_pos h3]
        · have hfn : (fun q => pointInteriorHess (fun i => G.ℓ_fn i q) G.F (deriv G.F)
              (deriv (deriv G.F)) (fun u => G.x_fn u q) r s) = fun _ => (0 : ℂ) := by
            ext q; dsimp only [pointInteriorHess]; rw [if_neg h1, if_neg h2, if_neg h3]
          rw [hfn, hJet.taylor2D_const, map_zero]
          dsimp only [pointRecHess0]; rw [if_neg h1, if_neg h2, if_neg h3]

  have htay_A_pair : DifferentiableOn ℂ G.A_point U₀ ∧
      taylor2D G.A_point p₁ = ∑ i : Fin k, L_tay i := by
    have hsum : ∀ (s : Finset (Fin k)),
        (DifferentiableOn ℂ (fun q => ∑ i ∈ s, G.ℓ_fn i q) U₀) ∧
        taylor2D (fun q => ∑ i ∈ s, G.ℓ_fn i q) p₁ = ∑ i ∈ s, L_tay i := by
      intro s
      induction s using Finset.cons_induction with
      | empty =>
          simp only [Finset.sum_empty]
          exact ⟨differentiableOn_const 0, by rw [hJet.taylor2D_const, map_zero]⟩
      | cons a s ha ih =>
          simp only [Finset.sum_cons]
          refine ⟨hDiff_add (G.ℓ_holo_sq a).1 ih.1, ?_⟩
          rw [(hJet.taylor2D_ring hU₀_open hp₁_U₀ (G.ℓ_holo_sq a).1 ih.1).1, ih.2]
    exact hsum Finset.univ
  have hA_holo : DifferentiableOn ℂ G.A_point U₀ := htay_A_pair.1
  have htay_A_sum : taylor2D G.A_point p₁ = ∑ i : Fin k, L_tay i := htay_A_pair.2
  have hA_ab_holo : DifferentiableOn ℂ G.A_point_ab U_ab :=
    hA_holo.comp h_unsh_diff.differentiableOn (fun _ h => h)
  let S_ab : MvPowerSeries (Fin 2) ℂ := taylor2D G.A_point_ab p_ab
  have htay_A_ab : taylor2D G.A_point p₁ =
      pointArcComp2D S_ab (MvPowerSeries.X 0) (MvPowerSeries.X 0 + MvPowerSeries.X 1) := by
    rw [hJet.taylor2D_congr hU₀_open hp₁_U₀
      (f₂ := fun q => G.A_point_ab (q.1, q.1 + q.2))
      (fun q _ => by dsimp [PointGlancingChartData.A_point_ab, pointChartActionAB]; rw [add_sub_cancel_left])]
    have hc := hJet.taylor2D_comp_2D hU₀_open hU_ab_open hp₁_U₀
      differentiable_fst.differentiableOn
      (hDiff_add differentiable_fst.differentiableOn differentiable_snd.differentiableOn)
      hA_ab_holo h_sh_maps
    rw [hcent_fst, hcent_sum] at hc
    exact hc

  
  obtain ⟨Φ, hΦ_K, hΦ_const, ⟨r_core, hr_core_ne⟩⟩ :=
    hAlg.formal_arc K_pt E.N_core E.coreTuple hNonAlg
  let lift1 : ℂ → PowerSeries ℂ := pointRecLiftArcFn F_val Φ
  let lift2 : MvPowerSeries (Fin 2) ℂ → MvPowerSeries (Fin 2) (PowerSeries ℂ) :=
    pointRecLiftMv2D F_val Φ
  have hL1 := hLift.liftArcFn_props K_pt F_val Φ hK_le_F hΦ_K hΦ_const
  have hL1_const : ∀ z : ℂ, PowerSeries.constantCoeff (lift1 z) = z := hL1.1
  have hL1_K : ∀ x ∈ K_pt, lift1 x = PowerSeries.C x := hL1.2.1
  have hL1_ring : ∀ x ∈ F_val, ∀ y ∈ F_val,
      lift1 (x + y) = lift1 x + lift1 y ∧
      lift1 (x - y) = lift1 x - lift1 y ∧
      lift1 (x * y) = lift1 x * lift1 y := hL1.2.2.1
  have hL1_sq : ∀ z ∈ F_val, z ≠ 0 → (lift1 z) ^ 2 = (PowerSeries.C z) ^ 2 →
      lift1 z = PowerSeries.C z := hL1.2.2.2
  have hL2 := hLift.liftMv2D_ring F_val Φ
  have hL2_C : ∀ c : ℂ, lift2 (MvPowerSeries.C c) = MvPowerSeries.C (lift1 c) := hL2.1
  have hL2_ring : ∀ Ψ₁ Ψ₂ : MvPowerSeries (Fin 2) ℂ,
      (∀ d, MvPowerSeries.coeff d Ψ₁ ∈ F_val) →
      (∀ d, MvPowerSeries.coeff d Ψ₂ ∈ F_val) →
      lift2 (Ψ₁ + Ψ₂) = lift2 Ψ₁ + lift2 Ψ₂ ∧
      lift2 (Ψ₁ - Ψ₂) = lift2 Ψ₁ - lift2 Ψ₂ ∧
      lift2 (Ψ₁ * Ψ₂) = lift2 Ψ₁ * lift2 Ψ₂ := hL2.2
  have hL1_zero : lift1 0 = 0 := by rw [hL1_K 0 K_pt.zero_mem, map_zero]
  have hL1_one : lift1 1 = 1 := by rw [hL1_K 1 K_pt.one_mem, map_one]
  have hL2_zero : lift2 0 = 0 := by
    rw [← map_zero MvPowerSeries.C, hL2_C, hL1_zero, map_zero]
  have hL2_one : lift2 1 = 1 := by
    rw [← map_one MvPowerSeries.C, hL2_C, hL1_one, map_one]

  let Δx : Fin (k + 1) → PowerSeries ℂ := fun r => lift1 (x_star r) - PowerSeries.C (x_star r)
  let f_full : Fin (k + 1) → ℕ → PowerSeries ℂ := fun r =>
    pointRecJetSeq (fun m => lift1 (iteratedDeriv m G.F (x_star r))) (Δx r)
  let U_formal : ℕ → PowerSeries ℂ := pointRecFormalU F_val Φ S_ab
  let V_formal : ℕ → PowerSeries ℂ := pointRecFormalV F_val Φ S_ab
  let β_full : ℕ → Fin (k + 1) → MvPowerSeries (Fin 2) ℂ := fun l r d =>
    if l = 0 then MvPowerSeries.coeff d (β₀ r)
    else if d = 0 then PowerSeries.coeff l (Δx r)
    else PowerSeries.coeff l (lift1 (MvPowerSeries.coeff d (β₀ r)))

  have hΔx_const : ∀ r : Fin (k + 1), PowerSeries.constantCoeff (Δx r) = 0 := by
    intro r; dsimp only [Δx]
    rw [map_sub, hL1_const, PowerSeries.constantCoeff_C, sub_self]
  have hf_zero : ∀ r : Fin (k + 1), f_full r 0 = f₀ r := by
    intro r; ext n
    rw [hLift.jetSeq_zero, hL1_const]
    simp [f₀, pointArcHoloTaylor1D, holoTaylor1D]
  have hΔx_0 : Δx 0 = 0 := by
    dsimp only [Δx]; rw [hx_star_0, hL1_K _ ha₁_mem_K, sub_self]
  have hΔx_last : Δx (Fin.last k) = 0 := by
    dsimp only [Δx]; rw [hx_star_last, hL1_K _ hb₁_mem_K, sub_self]
  have hjet_C_zero : ∀ (c_seq : ℕ → ℂ) (l : ℕ), 1 ≤ l →
      pointRecJetSeq (fun m => PowerSeries.C (c_seq m)) 0 l = 0 := by
    intro c_seq l hl1; ext n
    simp only [pointRecJetSeq, PowerSeries.coeff_mk, map_zero, neg_zero]
    rw [Finset.sum_eq_single 0]
    · simp only [pow_zero, mul_one, Nat.add_zero, Nat.factorial_zero, Nat.cast_one, ← map_mul]
      rw [PowerSeries.coeff_C, if_neg (by omega)]
    · intro m _ hm0; rw [zero_pow hm0, mul_zero]
    · intro h0; exact False.elim (h0 (Finset.mem_range.mpr (by omega)))
  have hf_endpoints : ∀ l : ℕ, 1 ≤ l → f_full 0 l = 0 ∧ f_full (Fin.last k) l = 0 := by
    intro l hl1
    refine ⟨?_, ?_⟩
    · dsimp only [f_full]
      rw [hΔx_0]
      have hseq : (fun m => lift1 (iteratedDeriv m G.F (x_star 0))) =
          fun m => PowerSeries.C (iteratedDeriv m G.F (a₁ : ℂ)) := by
        funext m; rw [hx_star_0, hL1_K _ (E.endpoint_graph_jets_mem_K_pt m).1]
      rw [hseq]
      exact hjet_C_zero _ l hl1
    · dsimp only [f_full]
      rw [hΔx_last]
      have hseq : (fun m => lift1 (iteratedDeriv m G.F (x_star (Fin.last k)))) =
          fun m => PowerSeries.C (iteratedDeriv m G.F ((a₁ : ℂ) + (δ₁ : ℂ))) := by
        funext m; rw [hx_star_last, hL1_K _ (E.endpoint_graph_jets_mem_K_pt m).2]
      rw [hseq]
      exact hjet_C_zero _ l hl1
  have hβ_zero : ∀ r : Fin (k + 1), β_full 0 r = β₀ r := by
    intro r; ext d; rfl
  have hβ_endpoints : ∀ l : ℕ, 1 ≤ l → β_full l 0 = 0 ∧ β_full l (Fin.last k) = 0 := by
    intro l hl1
    have hl_ne : l ≠ 0 := by omega
    refine ⟨?_, ?_⟩
    · ext d
      change β_full l 0 d = 0
      dsimp only [β_full]; rw [if_neg hl_ne]
      split_ifs with hd0
      · rw [hΔx_0, map_zero]
      · rw [hL1_K _ (by rw [hβ₀_0]; exact hCI_X K_pt 0 d), PowerSeries.coeff_C, if_neg hl_ne]
    · ext d
      change β_full l (Fin.last k) d = 0
      dsimp only [β_full]; rw [if_neg hl_ne]
      split_ifs with hd0
      · rw [hΔx_last, map_zero]
      · have hmem : MvPowerSeries.coeff d (β₀ (Fin.last k)) ∈ K_pt := by
          rw [hβ₀_last]; exact hCI_add K_pt (hCI_X K_pt 0) (hCI_X K_pt 1) d
        rw [hL1_K _ hmem, PowerSeries.coeff_C, if_neg hl_ne]

  have hAbsc_eq : ∀ r : Fin (k + 1),
      pointArcFormalAbscissa2D1D β_full r = MvPowerSeries.C (Δx r) + lift2 (β₀ r) := by
    intro r
    ext d l
    change PowerSeries.coeff l (PowerSeries.mk fun m => MvPowerSeries.coeff d (β_full m r)) =
      PowerSeries.coeff l (MvPowerSeries.coeff d (MvPowerSeries.C (Δx r) + lift2 (β₀ r)))
    rw [PowerSeries.coeff_mk, map_add, MvPowerSeries.coeff_C, map_add]
    change β_full l r d =
      PowerSeries.coeff l (if d = 0 then Δx r else 0) +
        PowerSeries.coeff l (lift1 (MvPowerSeries.coeff d (β₀ r)))
    dsimp only [β_full]
    by_cases hl0 : l = 0
    · subst hl0
      rw [if_pos rfl]
      by_cases hd0 : d = 0
      · subst hd0
        rw [if_pos rfl, PowerSeries.coeff_zero_eq_constantCoeff, hΔx_const,
          hβ₀_coeff0 r, hL1_zero, map_zero, add_zero]
      · rw [if_neg hd0, map_zero, zero_add, PowerSeries.coeff_zero_eq_constantCoeff, hL1_const]
    · rw [if_neg hl0]
      by_cases hd0 : d = 0
      · subst hd0
        rw [if_pos rfl, if_pos rfl, hβ₀_coeff0 r, hL1_zero, map_zero, add_zero]
      · rw [if_neg hd0, if_neg hd0, map_zero, zero_add]

  
  have hlift_Dx : ∀ i : Fin k,
      lift2 (pointRecDx0 x_star β₀ i) = pointArcFormalDx2D1D x_star β_full i := by
    intro i
    dsimp only [pointRecDx0, pointArcFormalDx2D1D]
    have hc_mem : x_star i.succ - x_star i.castSucc ∈ F_val :=
      F_val.sub_mem (E.abscissa_mem_F_val i.succ) (E.abscissa_mem_F_val i.castSucc)
    rw [(hL2_ring _ _ (hCI_C F_val hc_mem) (hCI_sub F_val (hβ₀_mem i.succ) (hβ₀_mem i.castSucc))).1,
      hL2_C,
      (hL1_ring _ (E.abscissa_mem_F_val i.succ) _ (E.abscissa_mem_F_val i.castSucc)).2.1,
      (hL2_ring _ _ (hβ₀_mem i.succ) (hβ₀_mem i.castSucc)).2.1,
      hAbsc_eq i.succ, hAbsc_eq i.castSucc]
    have hx_s : lift1 (x_star i.succ) = PowerSeries.C (x_star i.succ) + Δx i.succ := by
      dsimp only [Δx]; ring
    have hx_c : lift1 (x_star i.castSucc) = PowerSeries.C (x_star i.castSucc) + Δx i.castSucc := by
      dsimp only [Δx]; ring
    rw [hx_s, hx_c]
    simp only [map_sub, map_add]
    ring
  have hlift_compF : ∀ u : Fin (k + 1),
      lift2 (compPowerSeries2D (f₀ u) (β₀ u)) =
        pointArcComp2D1D (f_full u) (pointArcFormalAbscissa2D1D β_full u) := by
    intro u
    rw [hAbsc_eq u]
    exact hLift.liftMv2D_comp_recenter K_pt F_val Φ hK_le_F hΦ_K
      (fun m => iteratedDeriv m G.F (x_star u)) (Δx u) (β₀ u)
      (E.graph_jets_mem_F_val u) (hΔx_const u) (hβ₀_coeff0 u) (hβ₀_mem u)
  have hlift_compF' : ∀ u : Fin (k + 1),
      lift2 (compPowerSeries2D (PowerSeries.derivative (f₀ u)) (β₀ u)) =
        pointArcComp2D1D (fun l => PowerSeries.derivative (f_full u l))
          (pointArcFormalAbscissa2D1D β_full u) := by
    intro u
    have hf0'_eq : PowerSeries.derivative (f₀ u) =
        PowerSeries.mk (fun n => iteratedDeriv (n + 1) G.F (x_star u) / (n.factorial : ℂ)) := by
      rw [← hHoloTaylor_deriv]
      ext n
      simp only [pointArcHoloTaylor1D, holoTaylor1D, PowerSeries.coeff_mk, iteratedDeriv_succ']
    have hf_deriv_seq : (fun l => PowerSeries.derivative (f_full u l)) =
        pointRecJetSeq (fun m => lift1 (iteratedDeriv (m + 1) G.F (x_star u))) (Δx u) := by
      ext l n
      rw [hLift.jetSeq_deriv]
    rw [hf0'_eq, hf_deriv_seq, hAbsc_eq u]
    exact hLift.liftMv2D_comp_recenter K_pt F_val Φ hK_le_F hΦ_K
      (fun m => iteratedDeriv (m + 1) G.F (x_star u)) (Δx u) (β₀ u)
      (fun m => E.graph_jets_mem_F_val u (m + 1)) (hΔx_const u) (hβ₀_coeff0 u) (hβ₀_mem u)
  have hlift_Dy : ∀ i : Fin k,
      lift2 (pointRecDy0 f₀ β₀ i) = pointArcFormalDy2D1D f_full β_full i := by
    intro i
    dsimp only [pointRecDy0, pointArcFormalDy2D1D]
    rw [(hL2_ring _ _
      (hCI_comp1D F_val (hf₀_mem i.succ) (hβ₀_mem i.succ))
      (hCI_comp1D F_val (hf₀_mem i.castSucc) (hβ₀_mem i.castSucc))).2.1,
      hlift_compF i.succ, hlift_compF i.castSucc]
  have hlift_EdgeSq : ∀ i : Fin k,
      lift2 (pointRecEdgeSq0 x_star f₀ β₀ i) = pointArcFormalEdgeSq2D1D x_star f_full β_full i := by
    intro i
    dsimp only [pointRecEdgeSq0, pointArcFormalEdgeSq2D1D]
    rw [(hL2_ring _ _ (hCI_pow F_val 2 (hDx0_mem i)) (hCI_pow F_val 2 (hDy0_mem i))).1,
      sq, sq,
      (hL2_ring _ _ (hDx0_mem i) (hDx0_mem i)).2.2,
      (hL2_ring _ _ (hDy0_mem i) (hDy0_mem i)).2.2,
      hlift_Dx i, hlift_Dy i, ← sq, ← sq]
  have hlift_Len_InvLen : ∀ i : Fin k,
      lift2 (L_tay i) =
        MvPowerSeries.C (PowerSeries.C (ℓ_star i)) *
          pointArcCompConst2D1D pointArcPsSqrt1p
            (pointArcFormalEdgeRel2D1D ℓ_star x_star f_full β_full i) ∧
      lift2 (L_inv_tay i) = pointArcFormalInvEdgeLen2D1D ℓ_star x_star f_full β_full i := by
    intro i
    have hsq_lift : (lift2 (L_tay i)) ^ 2 = pointArcFormalEdgeSq2D1D x_star f_full β_full i := by
      rw [sq, ← (hL2_ring _ _ (hL_tay_mem i) (hL_tay_mem i)).2.2, ← sq, hL_tay_sq i, hlift_EdgeSq i]
    have hinv_lift : lift2 (L_inv_tay i) * lift2 (L_tay i) = 1 := by
      rw [← (hL2_ring _ _ (hL_inv_tay_mem i) (hL_tay_mem i)).2.2, hL_inv_mul i, hL2_one]
    have hc0_lift : PowerSeries.constantCoeff (MvPowerSeries.coeff 0 (lift2 (L_tay i))) = ℓ_star i := by
      change PowerSeries.constantCoeff (lift1 (MvPowerSeries.coeff 0 (L_tay i))) = ℓ_star i
      rw [hL1_const, hL_tay_c0 i]
    have hu := hSqrt.unit_sqrt_2D1D (ℓ_star i)
      (pointArcFormalEdgeSq2D1D x_star f_full β_full i)
      (lift2 (L_tay i)) (lift2 (L_inv_tay i))
      (hℓ_star_ne i) hsq_lift hinv_lift hc0_lift
    exact ⟨hu.2.1, hu.2.2⟩
  have hlift_A_point :
      lift2 (taylor2D G.A_point p₁) = pointArcFormalLen2D1D ℓ_star x_star f_full β_full := by
    rw [htay_A_sum]
    have hsum_lift : ∀ (s : Finset (Fin k)),
        (CoeffsIn F_val (∑ i ∈ s, L_tay i)) ∧
        lift2 (∑ i ∈ s, L_tay i) =
          ∑ i ∈ s, MvPowerSeries.C (PowerSeries.C (ℓ_star i)) *
            pointArcCompConst2D1D pointArcPsSqrt1p
              (pointArcFormalEdgeRel2D1D ℓ_star x_star f_full β_full i) := by
      intro s
      induction s using Finset.cons_induction with
      | empty =>
          simp only [Finset.sum_empty]
          exact ⟨by simpa using hCI_C F_val F_val.zero_mem, hL2_zero⟩
      | cons a s ha ih =>
          simp only [Finset.sum_cons]
          refine ⟨hCI_add F_val (hL_tay_mem a) ih.1, ?_⟩
          rw [(hL2_ring _ _ (hL_tay_mem a) ih.1).1, (hlift_Len_InvLen a).1, ih.2]
    exact (hsum_lift Finset.univ).2
  have hFormalGrad_zero : ∀ r : Fin (k - 1),
      pointArcFormalGrad2D1D ℓ_star x_star f_full β_full r = 0 := by
    intro r
    let i_L : Fin k := ⟨r.1, by have := r.2; omega⟩
    let i_R : Fin k := ⟨r.1 + 1, by have := r.2; omega⟩
    have hterm_mem : ∀ (i : Fin k) (u : Fin (k + 1)),
        CoeffsIn F_val
          ((pointRecDx0 x_star β₀ i +
            pointRecDy0 f₀ β₀ i *
              compPowerSeries2D (PowerSeries.derivative (f₀ u)) (β₀ u)) *
            pointRecInvLen0 ℓ_star x_star f₀ β₀ i) := by
      intro i u
      rw [← hL_inv_tay_eq i]
      exact hCI_mul F_val
        (hCI_add F_val (hDx0_mem i)
          (hCI_mul F_val (hDy0_mem i) (hCI_comp1D F_val (hf₀'_mem u) (hβ₀_mem u))))
        (hL_inv_tay_mem i)
    have hterm_lift : ∀ (i : Fin k) (u : Fin (k + 1)),
        lift2 ((pointRecDx0 x_star β₀ i +
            pointRecDy0 f₀ β₀ i *
              compPowerSeries2D (PowerSeries.derivative (f₀ u)) (β₀ u)) *
            pointRecInvLen0 ℓ_star x_star f₀ β₀ i) =
          (pointArcFormalDx2D1D x_star β_full i +
            pointArcFormalDy2D1D f_full β_full i *
              pointArcComp2D1D (fun l => PowerSeries.derivative (f_full u l))
                (pointArcFormalAbscissa2D1D β_full u)) *
            pointArcFormalInvEdgeLen2D1D ℓ_star x_star f_full β_full i := by
      intro i u
      rw [← hL_inv_tay_eq i,
        (hL2_ring _ _
          (hCI_add F_val (hDx0_mem i)
            (hCI_mul F_val (hDy0_mem i) (hCI_comp1D F_val (hf₀'_mem u) (hβ₀_mem u))))
          (hL_inv_tay_mem i)).2.2,
        (hL2_ring _ _ (hDx0_mem i)
          (hCI_mul F_val (hDy0_mem i) (hCI_comp1D F_val (hf₀'_mem u) (hβ₀_mem u)))).1,
        (hL2_ring _ _ (hDy0_mem i) (hCI_comp1D F_val (hf₀'_mem u) (hβ₀_mem u))).2.2,
        hlift_Dx i, hlift_Dy i, hlift_compF' u, (hlift_Len_InvLen i).2]
    have hgrad_lift :
        lift2 (pointRecGrad0 ℓ_star x_star f₀ β₀ r) =
          pointArcFormalGrad2D1D ℓ_star x_star f_full β_full r := by
      dsimp only [pointRecGrad0, pointArcFormalGrad2D1D]
      rw [(hL2_ring _ _ (hterm_mem i_L i_L.succ) (hterm_mem i_R i_R.castSucc)).2.1,
        hterm_lift i_L i_L.succ, hterm_lift i_R i_R.castSucc]
    rw [← hgrad_lift, hGrad0_eq_zero r, hL2_zero]

  
  have hℓ_sq_f0 : ∀ i : Fin k,
      (ℓ_star i) ^ 2 =
        (x_star i.succ - x_star i.castSucc) ^ 2 +
          (PowerSeries.constantCoeff (f_full i.succ 0) -
            PowerSeries.constantCoeff (f_full i.castSucc 0)) ^ 2 := by
    intro i
    rw [hf_zero i.succ, hf_zero i.castSucc, hHoloTaylor_const, hHoloTaylor_const]
    exact (G.ℓ_holo_sq i).2 p₁ hp₁_U₀

  have hFin_split2 : ∀ (term : Fin (k + 1) → MvPowerSeries (Fin 2) ℂ),
      (∑ r : Fin (k + 1), term r) =
        (∑ r' : Fin (k - 1), term ⟨r'.1, by have := r'.2; omega⟩) +
          term ⟨k - 1, by omega⟩ + term ⟨k, by omega⟩ := by
    intro term
    let m := k - 1
    have hkm : (m + 1) + 1 = k + 1 := by omega
    let e : Fin ((m + 1) + 1) ≃ Fin (k + 1) := finCongr hkm
    rw [← Equiv.sum_comp e, Fin.sum_univ_castSucc, Fin.sum_univ_castSucc]
    apply congr_arg₂ (· + ·)
    · apply congr_arg₂ (· + ·)
      · apply Finset.sum_congr rfl; intro i _; apply congr_arg term; ext; rfl
      · apply congr_arg term; ext; rfl
    · apply congr_arg term; ext; dsimp [e, m]; omega

  have hformal_web_step : ∀ J : ℕ,
      ∑ r : Fin (k + 1),
        taylor2D (G.w_web r) p₁ *
          compPowerSeries2D
            (if h : r.1 < k - 1 then f_full ⟨r.1 + 1, by omega⟩ (J + 1)
             else if r.1 = k - 1 then U_formal (J + 1)
             else V_formal (J + 1))
            (centeredTaylor2D (G.ψ_web r) p₁) =
        -pointArcSlice2D1D (J + 1)
          (pointArcFormalLen2D1D ℓ_star x_star
            (pointArcTruncGraph J f_full) (pointArcTruncBeta J β_full)) := by
    intro J
    have hab := (hLift.liftMv2D_comp2D_ab_split K_pt F_val Φ hK_le_F hΦ_K S_ab
      E.action_ab_taylor_mem_F_val E.action_mixed_ab_mem_K_pt (J + 1) (by omega)).2
    change pointArcSlice2D1D (J + 1) (lift2 _) =
      compPowerSeries2D (U_formal (J + 1)) _ + compPowerSeries2D (V_formal (J + 1)) _ at hab
    rw [← htay_A_ab, hlift_A_point] at hab
    have htop := hSplit.len_top_split hk ℓ_star x_star f_full β_full
      hℓ_star_ne (fun r => by rw [hβ_zero r]; exact hβ₀_coeff0 r) hℓ_sq_f0
      (fun J' => hf_endpoints (J' + 1) (by omega))
      (fun J' => hβ_endpoints (J' + 1) (by omega)) J
    have hf0_fun : (fun u => f_full u 0) = f₀ := funext hf_zero
    have hβ0_fun : β_full 0 = β₀ := funext hβ_zero
    rw [hf0_fun, hβ0_fun] at htop
    have hgrad_sum_zero :
        (∑ r : Fin (k - 1),
          pointRecGrad0 ℓ_star x_star f₀ β₀ r *
            β_full (J + 1) ⟨r.1 + 1, by have := r.2; omega⟩) = 0 := by
      apply Finset.sum_eq_zero; intro r _
      rw [hGrad0_eq_zero r, zero_mul]
    rw [hgrad_sum_zero, add_zero] at htop
    let term : Fin (k + 1) → MvPowerSeries (Fin 2) ℂ := fun r =>
      taylor2D (G.w_web r) p₁ *
        compPowerSeries2D
          (if h : r.1 < k - 1 then f_full ⟨r.1 + 1, by omega⟩ (J + 1)
           else if r.1 = k - 1 then U_formal (J + 1)
           else V_formal (J + 1))
          (centeredTaylor2D (G.ψ_web r) p₁)
    have hterm_lt : ∀ r' : Fin (k - 1),
        term ⟨r'.1, by have := r'.2; omega⟩ =
          pointRecWeight0 ℓ_star x_star f₀ β₀ r' *
            compPowerSeries2D
              (f_full ⟨r'.1 + 1, by have := r'.2; omega⟩ (J + 1))
              (β₀ ⟨r'.1 + 1, by have := r'.2; omega⟩) := by
      intro r'
      dsimp only [term]
      rw [htay_w_web, htay_ψ_web, dif_pos r'.2, dif_pos r'.2, dif_pos r'.2]
    have hterm_km1 :
        term ⟨k - 1, by omega⟩ =
          -compPowerSeries2D (U_formal (J + 1)) (MvPowerSeries.X 0) := by
      dsimp only [term]
      have hnot : ¬(k - 1 < k - 1) := lt_irrefl _
      rw [htay_w_web, htay_ψ_web]
      simp only [dif_neg hnot, if_true, neg_one_mul]
    have hterm_k :
        term ⟨k, by omega⟩ =
          -compPowerSeries2D (V_formal (J + 1)) (MvPowerSeries.X 0 + MvPowerSeries.X 1) := by
      dsimp only [term]
      have hnot : ¬(k < k - 1) := by omega
      have hne : ¬(k = k - 1) := by omega
      rw [htay_w_web, htay_ψ_web]
      simp only [dif_neg hnot, if_neg hne, neg_one_mul]
    change (∑ r : Fin (k + 1), term r) = _
    rw [hFin_split2 term, Finset.sum_congr rfl (fun r' _ => hterm_lt r'), hterm_km1, hterm_k]
    linear_combination hab - htop

  have hformal_hess_step : ∀ (J : ℕ) (r : Fin (k - 1)),
      pointArcSlice2D1D (J + 1)
          (pointArcFormalGrad2D1D ℓ_star x_star
            (pointArcTruncGraph (J + 1) f_full) (pointArcTruncBeta J β_full) r) +
        ∑ s : Fin (k - 1),
          taylor2D
            (fun q => pointInteriorHess (fun i => G.ℓ_fn i q) G.F (deriv G.F) (deriv (deriv G.F))
              (fun u => G.x_fn u q) r s) p₁ *
          β_full (J + 1) ⟨s.1 + 1, by have := s.2; omega⟩ = 0 := by
    intro J r
    have htop := hSplit.grad_top_split hk ℓ_star x_star f_full β_full
      hℓ_star_ne (fun r => by rw [hβ_zero r]; exact hβ₀_coeff0 r) hℓ_sq_f0
      (fun J' => hβ_endpoints (J' + 1) (by omega)) J r
    have hf0_fun : (fun u => f_full u 0) = f₀ := funext hf_zero
    have hβ0_fun : β_full 0 = β₀ := funext hβ_zero
    rw [hf0_fun, hβ0_fun, hFormalGrad_zero r] at htop
    have h0_slice : pointArcSlice2D1D (J + 1) 0 = 0 := rfl
    rw [h0_slice] at htop
    have hsum_eq :
        (∑ s : Fin (k - 1),
          taylor2D
            (fun q => pointInteriorHess (fun i => G.ℓ_fn i q) G.F (deriv G.F) (deriv (deriv G.F))
              (fun u => G.x_fn u q) r s) p₁ *
          β_full (J + 1) ⟨s.1 + 1, by have := s.2; omega⟩) =
        ∑ s : Fin (k - 1),
          pointRecHess0 ℓ_star x_star f₀ β₀ r s *
            β_full (J + 1) ⟨s.1 + 1, by have := s.2; omega⟩ := by
      apply Finset.sum_congr rfl; intro s _
      rw [htay_Hess r s]
    rw [hsum_eq]
    exact htop.symm

  
  let H_tay : Matrix (Fin (k - 1)) (Fin (k - 1)) (MvPowerSeries (Fin 2) ℂ) := fun r s =>
    taylor2D
      (fun q => pointInteriorHess (fun i => G.ℓ_fn i q) G.F (deriv G.F) (deriv (deriv G.F))
        (fun u => G.x_fn u q) r s) p₁
  have hH_tay_unit : IsUnit H_tay.det := by
    rw [MvPowerSeries.isUnit_iff_constantCoeff]
    have hmap : (MvPowerSeries.constantCoeff : MvPowerSeries (Fin 2) ℂ →+* ℂ).mapMatrix H_tay =
        pointInteriorHess ℓ_star G.F (deriv G.F) (deriv (deriv G.F)) x_star := by
      ext r s
      change MvPowerSeries.constantCoeff (H_tay r s) = _
      rw [← MvPowerSeries.coeff_zero_eq_constantCoeff]
      exact htay_coeff0 _ p₁
    rw [RingHom.map_det, hmap]
    exact isUnit_iff_ne_zero.mpr hHess_det_ne
  have hH_tay_cancel : ∀ (v : Fin (k - 1) → MvPowerSeries (Fin 2) ℂ),
      (∀ r : Fin (k - 1), ∑ s : Fin (k - 1), H_tay r s * v s = 0) →
      ∀ s : Fin (k - 1), v s = 0 := by
    intro v hv s
    have hmv : H_tay.mulVec v = 0 := funext hv
    have hadj : ((H_tay.adjugate * H_tay).mulVec v) s = 0 := by
      rw [← Matrix.mulVec_mulVec, hmv, Matrix.mulVec_zero, Pi.zero_apply]
    rw [Matrix.adjugate_mul, Matrix.smul_mulVec, Matrix.one_mulVec, Pi.smul_apply,
      smul_eq_mul, mul_comm] at hadj
    exact hH_tay_unit.mul_left_eq_zero.mp hadj

  have hf_all_of_int : ∀ {m : ℕ}, 1 ≤ m →
      (∀ s : Fin (k - 1), f_full ⟨s.1 + 1, by have := s.2; omega⟩ m = 0) →
      ∀ r : Fin (k + 1), f_full r m = 0 := by
    intro m hm1 hint r
    by_cases hr0 : r.1 = 0
    · have : r = 0 := Fin.ext hr0
      rw [this]; exact (hf_endpoints m hm1).1
    · by_cases hrk : r.1 = k
      · have : r = Fin.last k := Fin.ext hrk
        rw [this]; exact (hf_endpoints m hm1).2
      · have hs_lt : r.1 - 1 < k - 1 := by have := r.2; omega
        have hr_eq : r = ⟨(⟨r.1 - 1, hs_lt⟩ : Fin (k - 1)).1 + 1, by omega⟩ := by
          ext; dsimp; omega
        rw [hr_eq]
        exact hint ⟨r.1 - 1, hs_lt⟩

  have hvanish_below : ∀ (M : ℕ),
      (∀ m : ℕ, 1 ≤ m → m ≤ M →
        ∀ s : Fin (k - 1), f_full ⟨s.1 + 1, by have := s.2; omega⟩ m = 0) →
      ∀ l : ℕ, 1 ≤ l → l ≤ M →
        (∀ r : Fin (k + 1), f_full r l = 0) ∧
        (∀ r : Fin (k + 1), β_full l r = 0) ∧
        U_formal l = 0 ∧ V_formal l = 0 := by
    intro M hfM l
    induction l using Nat.strong_induction_on with
    | h l ih =>
        intro hl1 hlM
        obtain ⟨J, rfl⟩ : ∃ J : ℕ, l = J + 1 := ⟨l - 1, by omega⟩
        have hf_all : ∀ m : ℕ, 1 ≤ m → m ≤ J + 1 → ∀ r : Fin (k + 1), f_full r m = 0 :=
          fun m hm1 hmJ => hf_all_of_int hm1 (hfM m hm1 (by omega))
        have hβ_prev : ∀ m : ℕ, 1 ≤ m → m ≤ J → ∀ r : Fin (k + 1), β_full m r = 0 :=
          fun m hm1 hmJ => (ih m (by omega) hm1 (by omega)).2.1
        have htrunc_f_J1 : ∀ (r : Fin (k + 1)) (m : ℕ), 1 ≤ m →
            pointArcTruncGraph (J + 1) f_full r m = 0 := by
          intro r m hm1
          dsimp only [pointArcTruncGraph]
          split_ifs with hmJ
          · exact hf_all m hm1 hmJ r
          · rfl
        have htrunc_f_J : ∀ (r : Fin (k + 1)) (m : ℕ), 1 ≤ m →
            pointArcTruncGraph J f_full r m = 0 := by
          intro r m hm1
          dsimp only [pointArcTruncGraph]
          split_ifs with hmJ
          · exact hf_all m hm1 (by omega) r
          · rfl
        have htrunc_β_J : ∀ (m : ℕ) (r : Fin (k + 1)), 1 ≤ m →
            pointArcTruncBeta J β_full m r = 0 := by
          intro m r hm1
          dsimp only [pointArcTruncBeta]
          split_ifs with hmJ
          · exact hβ_prev m hm1 hmJ r
          · rfl
        have hgrad_trunc_zero : ∀ r : Fin (k - 1),
            pointArcSlice2D1D (J + 1)
              (pointArcFormalGrad2D1D ℓ_star x_star
                (pointArcTruncGraph (J + 1) f_full) (pointArcTruncBeta J β_full) r) = 0 :=
          (hSplit.slice_pos_zero_of_pos_zero ℓ_star x_star
            (pointArcTruncGraph (J + 1) f_full) (pointArcTruncBeta J β_full) (J + 1)
            (by omega) htrunc_f_J1 htrunc_β_J).2
        have hβ_int_zero : ∀ s : Fin (k - 1),
            β_full (J + 1) ⟨s.1 + 1, by have := s.2; omega⟩ = 0 := by
          apply hH_tay_cancel
          intro r
          have hstep := hformal_hess_step J r
          rw [hgrad_trunc_zero r, zero_add] at hstep
          exact hstep
        have hβ_J1 : ∀ r : Fin (k + 1), β_full (J + 1) r = 0 := by
          intro r
          by_cases hr0 : r.1 = 0
          · rw [show r = 0 from Fin.ext hr0]; exact (hβ_endpoints (J + 1) (by omega)).1
          · by_cases hrk : r.1 = k
            · rw [show r = Fin.last k from Fin.ext hrk]; exact (hβ_endpoints (J + 1) (by omega)).2
            · have hs_lt : r.1 - 1 < k - 1 := by have := r.2; omega
              rw [show r = ⟨(⟨r.1 - 1, hs_lt⟩ : Fin (k - 1)).1 + 1, by omega⟩ by
                ext; dsimp; omega]
              exact hβ_int_zero ⟨r.1 - 1, hs_lt⟩
        have hlen_trunc_zero :
            pointArcSlice2D1D (J + 1)
              (pointArcFormalLen2D1D ℓ_star x_star
                (pointArcTruncGraph J f_full) (pointArcTruncBeta J β_full)) = 0 :=
          (hSplit.slice_pos_zero_of_pos_zero ℓ_star x_star
            (pointArcTruncGraph J f_full) (pointArcTruncBeta J β_full) (J + 1)
            (by omega) htrunc_f_J htrunc_β_J).1
        let term : Fin (k + 1) → MvPowerSeries (Fin 2) ℂ := fun r =>
          taylor2D (G.w_web r) p₁ *
            compPowerSeries2D
              (if h : r.1 < k - 1 then f_full ⟨r.1 + 1, by omega⟩ (J + 1)
               else if r.1 = k - 1 then U_formal (J + 1)
               else V_formal (J + 1))
              (centeredTaylor2D (G.ψ_web r) p₁)
        have hweb : (∑ r : Fin (k + 1), term r) = 0 := by
          simpa only [term, hlen_trunc_zero, neg_zero] using hformal_web_step J
        rw [hFin_split2 term] at hweb
        have hweb_int_zero :
            (∑ r' : Fin (k - 1), term ⟨r'.1, by have := r'.2; omega⟩) = 0 := by
          apply Finset.sum_eq_zero; intro r' _
          dsimp only [term]
          rw [dif_pos r'.2, hf_all (J + 1) (by omega) le_rfl _]
          have hcomp0 : compPowerSeries2D 0
              (centeredTaylor2D (G.ψ_web ⟨r'.1, by have := r'.2; omega⟩) p₁) = 0 := by
            ext d; change ∑ n ∈ Finset.range (d 0 + d 1 + 1), _ = 0; simp
          rw [hcomp0, mul_zero]
        have hterm_km1 :
            term ⟨k - 1, by omega⟩ =
              -compPowerSeries2D (U_formal (J + 1)) (MvPowerSeries.X 0) := by
          dsimp only [term]
          have hnot : ¬(k - 1 < k - 1) := lt_irrefl _
          rw [htay_w_web, htay_ψ_web]
          simp only [dif_neg hnot, if_true, neg_one_mul]
        have hterm_k :
            term ⟨k, by omega⟩ =
              -compPowerSeries2D (V_formal (J + 1)) (MvPowerSeries.X 0 + MvPowerSeries.X 1) := by
          dsimp only [term]
          have hnot : ¬(k < k - 1) := by omega
          have hne : ¬(k = k - 1) := by omega
          rw [htay_w_web, htay_ψ_web]
          simp only [dif_neg hnot, if_neg hne, neg_one_mul]
        rw [hweb_int_zero, zero_add, hterm_km1, hterm_k] at hweb
        have hUV_sum :
            compPowerSeries2D (U_formal (J + 1)) (MvPowerSeries.X 0) +
              compPowerSeries2D (V_formal (J + 1)) (MvPowerSeries.X 0 + MvPowerSeries.X 1) = 0 := by
          linear_combination -hweb
        have hU0_coeff : PowerSeries.coeff 0 (U_formal (J + 1)) = 0 :=
          (hLift.liftMv2D_comp2D_ab_split K_pt F_val Φ hK_le_F hΦ_K S_ab
            E.action_ab_taylor_mem_F_val E.action_mixed_ab_mem_K_pt (J + 1) (by omega)).1
        have hUV_zero := hSqrt.ab_split_unique (U_formal (J + 1)) (V_formal (J + 1))
          hU0_coeff hUV_sum
        exact ⟨hf_all (J + 1) (by omega) le_rfl, hβ_J1, hUV_zero.1, hUV_zero.2⟩

  
  have hex : ∃ p : ℕ, 1 ≤ p ∧
      ∃ r₀ : Fin (k - 1), f_full ⟨r₀.1 + 1, by have := r₀.2; omega⟩ p ≠ 0 := by
    by_contra hnone
    push_neg at hnone
    have hall : ∀ l : ℕ, 1 ≤ l →
        (∀ r : Fin (k + 1), f_full r l = 0) ∧
        (∀ r : Fin (k + 1), β_full l r = 0) := by
      intro l hl1
      have hv := hvanish_below l (fun m hm1 _ s => hnone m hm1 s) l hl1 le_rfl
      exact ⟨hv.1, hv.2.1⟩
    have hΔx_all_zero : ∀ r : Fin (k + 1), Δx r = 0 := by
      intro r; ext l
      by_cases hl0 : l = 0
      · subst hl0; rw [map_zero, PowerSeries.coeff_zero_eq_constantCoeff, hΔx_const r]
      · have hβ0_eq : MvPowerSeries.coeff 0 (β_full l r) = 0 := by
          rw [(hall l (by omega)).2 r, map_zero]
        change β_full l r 0 = 0 at hβ0_eq
        dsimp only [β_full] at hβ0_eq
        rw [if_neg hl0, if_pos rfl] at hβ0_eq
        simpa using hβ0_eq
    have hlift_x_C : ∀ r : Fin (k + 1), lift1 (x_star r) = PowerSeries.C (x_star r) :=
      fun r => sub_eq_zero.mp (hΔx_all_zero r)
    have hlift_jet_C : ∀ (r : Fin (k + 1)) (m : ℕ),
        lift1 (iteratedDeriv m G.F (x_star r)) =
          PowerSeries.C (iteratedDeriv m G.F (x_star r)) := by
      intro r m
      have hf_r_zero : ∀ l : ℕ, 1 ≤ l →
          pointRecJetSeq (fun q => lift1 (iteratedDeriv q G.F (x_star r))) 0 l = 0 := by
        intro l hl1
        have hfr := (hall l hl1).1 r
        dsimp only [f_full] at hfr
        rwa [hΔx_all_zero r] at hfr
      have hc := hLift.jetSeq_eq_C_of_zero_shift
        (fun q => lift1 (iteratedDeriv q G.F (x_star r))) hf_r_zero m
      rwa [hL1_const] at hc
    have hlift_ℓ_C : ∀ i : Fin k, lift1 (ℓ_star i) = PowerSeries.C (ℓ_star i) := by
      intro i
      apply hL1_sq (ℓ_star i) (E.chord_len_mem_F_val i) (hℓ_star_ne i)
      have hsq_eq : (ℓ_star i) ^ 2 =
          (x_star i.succ - x_star i.castSucc) ^ 2 +
            (iteratedDeriv 0 G.F (x_star i.succ) - iteratedDeriv 0 G.F (x_star i.castSucc)) ^ 2 := by
        simpa only [iteratedDeriv_zero, pointEdgeSq, PointGlancingChartData.x_fn] using
          (G.ℓ_holo_sq i).2 p₁ hp₁_U₀
      have h1 : (lift1 (ℓ_star i)) ^ 2 = lift1 ((ℓ_star i) ^ 2) := by
        rw [sq, sq, (hL1_ring _ (E.chord_len_mem_F_val i) _ (E.chord_len_mem_F_val i)).2.2]
      rw [h1, hsq_eq]
      have hdx_m : x_star i.succ - x_star i.castSucc ∈ F_val :=
        F_val.sub_mem (E.abscissa_mem_F_val i.succ) (E.abscissa_mem_F_val i.castSucc)
      have hdy_m : iteratedDeriv 0 G.F (x_star i.succ) -
          iteratedDeriv 0 G.F (x_star i.castSucc) ∈ F_val :=
        F_val.sub_mem (E.graph_jets_mem_F_val i.succ 0) (E.graph_jets_mem_F_val i.castSucc 0)
      rw [(hL1_ring _ (F_val.pow_mem hdx_m 2) _ (F_val.pow_mem hdy_m 2)).1,
        sq, sq,
        (hL1_ring _ hdx_m _ hdx_m).2.2, (hL1_ring _ hdy_m _ hdy_m).2.2,
        (hL1_ring _ (E.abscissa_mem_F_val i.succ) _ (E.abscissa_mem_F_val i.castSucc)).2.1,
        (hL1_ring _ (E.graph_jets_mem_F_val i.succ 0) _ (E.graph_jets_mem_F_val i.castSucc 0)).2.1,
        hlift_x_C i.succ, hlift_x_C i.castSucc,
        hlift_jet_C i.succ 0, hlift_jet_C i.castSucc 0,
        ← map_sub, ← map_mul, ← map_sub, ← map_mul, ← map_add,
        ← sq, ← sq, ← hsq_eq, map_pow]
    have hcore_C : lift1 (E.coreTuple r_core) = PowerSeries.C (E.coreTuple r_core) := by
      have hmem := E.core_entries_subset ⟨r_core, rfl⟩
      rcases hmem with ⟨r, hr⟩ | ⟨i, hi⟩ | ⟨r, m, hrm⟩
      · rw [hr]; exact hlift_x_C r
      · rw [hi]; exact hlift_ℓ_C i
      · rw [hrm]; exact hlift_jet_C r m
    have hz_mem : E.coreTuple r_core ∈ F_val :=
      Subfield.subset_closure (Or.inr ⟨r_core, rfl⟩)
    dsimp only [lift1, pointRecLiftArcFn] at hcore_C
    rw [dif_pos hz_mem] at hcore_C
    exact hr_core_ne hcore_C

  classical
  let p_min : ℕ := Nat.find hex
  obtain ⟨hp_pos, r₀, hr₀_ne⟩ := Nat.find_spec hex
  have hvanish_lt_p : ∀ l : ℕ, 1 ≤ l → l < p_min →
      (∀ r : Fin (k + 1), f_full r l = 0) ∧
      (∀ r : Fin (k + 1), β_full l r = 0) ∧
      U_formal l = 0 ∧ V_formal l = 0 := by
    intro l hl1 hlp
    refine hvanish_below (p_min - 1) ?_ l hl1 (by omega)
    intro m hm1 hm_le s
    have hlt : m < p_min := by omega
    have hnot := Nat.find_min hex hlt
    push_neg at hnot
    exact hnot hm1 s

  exact ⟨{
    p := p_min
    p_pos := hp_pos
    r₀ := r₀
    f_full := f_full
    U_formal := U_formal
    V_formal := V_formal
    β_full := β_full
    f_zero := hf_zero
    f_endpoints := hf_endpoints
    β_zero := hβ_zero
    β_endpoints := hβ_endpoints
    f_lead_ne_zero := hr₀_ne
    vanish_lt_p := hvanish_lt_p
    formal_web_step := hformal_web_step
    formal_hess_step := hformal_hess_step
  }⟩

theorem point_arc_single_step_web_continuation (Ω : Set Plane)
    (C : AnalyticGlancingCollar Ω)
    (B : BaseCollarAndCramerData C)
    (k : ℕ) (hk : 2 ≤ k)
    (G : PointGlancingChartData C B k)
    (a₁ δ₁ : ℝ)
    (ha₁ : a₁ ∈ Set.Ioo (G.a₀ - G.R / 4) (G.a₀ + G.R / 4))
    (hδ₁ : δ₁ ∈ Set.Ioo 0 G.δ_star)
    (hJet : PointArcJetAndTaylorToolkit)
    (hWeb : FiniteWebContinuationProp)
    (D_form : PointArcFormalDeformationData C B k G a₁ δ₁)
    (J : ℕ) (hJp : D_form.p ≤ J + 1)
    (S : PointArcStepAnalyticData C B k G a₁ δ₁ D_form J) :
    ∃ S' : PointArcStepAnalyticData C B k G a₁ δ₁ D_form (J + 1),
      ∀ (r : Fin (k + 1)) (m : Fin (J + 1)), S'.g r m.castSucc = S.g r m :=
by
  
  let p₁ : ℂ × ℂ := ((a₁ : ℂ), (δ₁ : ℂ))
  let U₀ : Set (ℂ × ℂ) := G.U_a ×ˢ G.U_d
  have hU₀_open : IsOpen U₀ := Metric.isOpen_ball.prod Metric.isOpen_ball
  have ha₁_abs : |a₁ - G.a₀| < G.R / 4 :=
    abs_lt.mpr ⟨by linarith [ha₁.1], by linarith [ha₁.2]⟩
  have ha₁_trap_strict : |a₁ - G.a₀| < G.R - G.C₀ * G.δ_star := by
    linarith [G.C₀_δ_star_lt, G.R_pos]
  have hq₁_trap : (a₁, δ₁) ∈ webTrapezoid G.a₀ G.R G.δ_star G.C₀ := by
    refine ⟨hδ₁.1, hδ₁.2, ?_⟩
    have hCδ : G.C₀ * δ₁ < G.C₀ * G.δ_star := mul_lt_mul_of_pos_left hδ₁.2 G.C₀_pos
    linarith
  have hp₁_Vp : p₁ ∈ S.V_plus := S.trapezoid_mem_V_plus (a₁, δ₁) hq₁_trap
  have hbase_sub_U₀ : ∀ q ∈ webBaseClosure G.a₀ G.R G.δ_star,
      ((q.1 : ℂ), (q.2 : ℂ)) ∈ U₀ := by
    intro q hq
    refine ⟨?_, ?_⟩
    · rw [PointGlancingChartData.U_a, Metric.mem_ball, Complex.dist_eq, ← Complex.ofReal_sub,
        Complex.norm_real, Real.norm_eq_abs]
      linarith [hq.2.2, G.R_pos]
    · rw [PointGlancingChartData.U_d, Metric.mem_ball, dist_zero_right, Complex.norm_real,
        Real.norm_eq_abs, abs_of_nonneg hq.1]
      linarith [hq.2.1, G.δ_star_pos]
  have hψ_web_holo : ∀ r : Fin (k + 1), DifferentiableOn ℂ (G.ψ_web r) U₀ := by
    intro r
    unfold PointGlancingChartData.ψ_web pointChartPsiWeb
    by_cases h1 : r.1 < k - 1
    · simp only [h1, ↓reduceDIte]
      exact (G.x_holo_maps ⟨r.1 + 1, by omega⟩).1
    · by_cases h2 : r.1 = k - 1
      · simp only [h1, ↓reduceDIte]
        simp only [h2, ↓reduceIte]
        exact (differentiable_fst : Differentiable ℂ (fun q : ℂ × ℂ => q.1)).differentiableOn
      · simp only [h1, ↓reduceDIte]
        simp only [h2, ↓reduceIte]
        exact (differentiable_fst.add differentiable_snd).differentiableOn
  have hx_maps_of_ψ : ∀ {V : Set (ℂ × ℂ)} {W : Set ℂ},
      V ⊆ U₀ → (∀ q ∈ V, ∀ r : Fin (k + 1), G.ψ_web r q ∈ W) →
      ∀ q ∈ V, ∀ s : Fin (k + 1), G.x_fn s q ∈ W := by
    intro V W hVU₀ hψW q hq s
    have hq_U₀ : q ∈ U₀ := hVU₀ hq
    by_cases hs0 : s.1 = 0
    · have hs_eq : s = 0 := Fin.ext hs0
      rw [hs_eq]
      dsimp only [PointGlancingChartData.x_fn]
      rw [(G.x_endpoints q hq_U₀).1]
      have hmem := hψW q hq ⟨k - 1, by omega⟩
      have hval : G.ψ_web ⟨k - 1, by omega⟩ q = q.1 := by
        dsimp only [PointGlancingChartData.ψ_web, pointChartPsiWeb]
        split_ifs <;> first | rfl | omega
      exact hval ▸ hmem
    · by_cases hsk : s.1 = k
      · have hs_eq : s = Fin.last k := Fin.ext hsk
        rw [hs_eq]
        dsimp only [PointGlancingChartData.x_fn]
        rw [(G.x_endpoints q hq_U₀).2]
        have hmem := hψW q hq (Fin.last k)
        have hval : G.ψ_web (Fin.last k) q = q.1 + q.2 := by
          dsimp only [PointGlancingChartData.ψ_web, pointChartPsiWeb, Fin.val_last]
          split_ifs <;> first | rfl | omega
        exact hval ▸ hmem
      · let r_s : Fin (k + 1) := ⟨s.1 - 1, by have := s.2; omega⟩
        have hr_lt : r_s.1 < k - 1 := by dsimp [r_s]; have := s.2; omega
        have hmem := hψW q hq r_s
        have hval : G.ψ_web r_s q = G.x_fn s q := by
          simp only [PointGlancingChartData.ψ_web, pointChartPsiWeb, r_s, hr_lt, ↓reduceDIte]
          congr 1
          ext
          dsimp only
          omega
        exact hval ▸ hmem
  have hx_maps_S : ∀ q ∈ S.V_plus, ∀ s : Fin (k + 1), G.x_fn s q ∈ S.W_ψ :=
    hx_maps_of_ψ S.V_plus_sub S.ψ_maps_W_ψ
  have hHoloZero : ∀ z₀ : ℂ, pointArcHoloTaylor1D (fun _ : ℂ => (0 : ℂ)) z₀ = 0 := by
    intro z₀
    ext n
    simp only [pointArcHoloTaylor1D, holoTaylor1D, PowerSeries.coeff_mk, map_zero]
    rcases n with _ | n
    · simp
    · rw [iteratedDeriv_const]
      simp
  have hg0_S : ∀ (r : Fin (k + 1)) (z : ℂ), S.g r 0 z = 0 :=
    fun r z => S.g_lt_p r 0 D_form.p_pos z

  
  have hw_web_holo : ∀ r : Fin (k + 1), DifferentiableOn ℂ (G.w_web r) S.V_plus := by
    intro r
    have hFx_U₀ : ∀ u : Fin (k + 1), DifferentiableOn ℂ (fun q => G.F (G.x_fn u q)) S.V_plus := by
      intro u
      exact (G.F_holo.comp (G.x_holo_maps u).1
        (fun q hq => ((G.x_holo_maps u).2 q hq).1)).mono S.V_plus_sub
    have hdiv_ℓ : ∀ {num : ℂ × ℂ → ℂ} (i : Fin k),
        DifferentiableOn ℂ num S.V_plus →
        DifferentiableOn ℂ (fun q => num q / G.ℓ_fn i q) S.V_plus := by
      intro num i hnum
      have hinv : DifferentiableOn ℂ (fun q => (G.ℓ_fn i q)⁻¹) S.V_plus :=
        (((G.ℓ_holo_sq i).1).mono S.V_plus_sub).inv (fun q hq => S.chord_ne_zero q hq i)
      exact (hnum.mul hinv).congr (fun q _ => div_eq_mul_inv (num q) (G.ℓ_fn i q))
    unfold PointGlancingChartData.w_web pointChartWWeb
    by_cases hr : r.1 < k - 1
    · simp only [hr, ↓reduceDIte]
      exact (hdiv_ℓ ⟨r.1, by omega⟩
        ((hFx_U₀ ⟨r.1 + 1, by omega⟩).sub (hFx_U₀ ⟨r.1, by omega⟩))).sub
        (hdiv_ℓ ⟨r.1 + 1, by omega⟩
          ((hFx_U₀ ⟨r.1 + 2, by omega⟩).sub (hFx_U₀ ⟨r.1 + 1, by omega⟩)))
    · simp only [hr, ↓reduceDIte]
      exact differentiableOn_const (-1)

  let B_len : ℂ × ℂ → ℂ := fun q =>
    pointArcEpsJet (J + 1)
      (fun ε =>
        pointRelChainLen (fun i => G.ℓ_fn i q) (pointArcPertGraph G.F S.g ε)
          (pointArcPertAbscissa (fun s => G.x_fn s q) (fun m s => S.β m s q) ε))
  have hB_len_holo : DifferentiableOn ℂ B_len S.V_plus :=
    (hJet.epsJet_holo (ℓ₀ := G.ℓ_fn) (x₀ := G.x_fn) (β := S.β) (J + 1)
      S.W_ψ_open S.V_plus_open (G.F_holo.mono S.W_ψ_sub_W_F) S.g_holo hg0_S
      (fun i => ((G.ℓ_holo_sq i).1).mono S.V_plus_sub) S.chord_ne_zero
      (fun r => ((G.x_holo_maps r).1).mono S.V_plus_sub) hx_maps_S
      (fun q hq i => (G.ℓ_holo_sq i).2 q (S.V_plus_sub hq))
      S.β_holo S.β_zero).1
  have hB_neg_holo : DifferentiableOn ℂ (fun q => -B_len q) S.V_plus := hB_len_holo.neg

  have hB_len_taylor : taylor2D B_len p₁ =
      pointArcSlice2D1D (J + 1)
        (pointArcFormalLen2D1D
          (fun i => G.ℓ_fn i p₁)
          (fun r => G.x_fn r p₁)
          (pointArcTruncGraph J D_form.f_full)
          (pointArcTruncBeta J D_form.β_full)) := by
    have ht := (hJet.taylor2D_epsJet_eq (ℓ₀ := G.ℓ_fn) (x₀ := G.x_fn) (β := S.β) (J + 1)
      S.W_ψ_open S.V_plus_open hp₁_Vp (G.F_holo.mono S.W_ψ_sub_W_F) S.g_holo hg0_S
      (fun i => ((G.ℓ_holo_sq i).1).mono S.V_plus_sub) S.chord_ne_zero
      (fun r => ((G.x_holo_maps r).1).mono S.V_plus_sub) hx_maps_S
      (fun q hq i => (G.ℓ_holo_sq i).2 q (S.V_plus_sub hq))
      S.β_holo S.β_zero).1
    have hf_seq_eq :
        (fun (r : Fin (k + 1)) (l : ℕ) =>
          if l = 0 then pointArcHoloTaylor1D G.F (G.x_fn r p₁)
          else if hl : l < J + 1 then pointArcHoloTaylor1D (S.g r ⟨l, hl⟩) (G.x_fn r p₁)
          else 0) =
        pointArcTruncGraph J D_form.f_full := by
      funext r l
      dsimp only [pointArcTruncGraph]
      by_cases hl0 : l = 0
      · subst hl0
        simpa using (D_form.f_zero r).symm
      · by_cases hlJ : l ≤ J
        · have hlJ1 : l < J + 1 := by omega
          simp only [hl0, ↓reduceIte, hlJ1, ↓reduceDIte, hlJ]
          exact S.g_taylor r ⟨l, hlJ1⟩ (Nat.pos_of_ne_zero hl0)
        · have hlJ1 : ¬ l < J + 1 := by omega
          simp only [hl0, ↓reduceIte, hlJ1, ↓reduceDIte, hlJ]
    have hβ_seq_eq :
        (fun (l : ℕ) (r : Fin (k + 1)) =>
          if l = 0 then centeredTaylor2D (G.x_fn r) p₁
          else if hl : l < J + 1 then taylor2D (S.β ⟨l, hl⟩ r) p₁
          else 0) =
        pointArcTruncBeta J D_form.β_full := by
      funext l r
      dsimp only [pointArcTruncBeta]
      by_cases hl0 : l = 0
      · subst hl0
        simpa using (D_form.β_zero r).symm
      · by_cases hlJ : l ≤ J
        · have hlJ1 : l < J + 1 := by omega
          simp only [hl0, ↓reduceIte, hlJ1, ↓reduceDIte, hlJ]
          exact S.β_taylor ⟨l, hlJ1⟩ r (Nat.pos_of_ne_zero hl0)
        · have hlJ1 : ¬ l < J + 1 := by omega
          simp only [hl0, ↓reduceIte, hlJ1, ↓reduceDIte, hlJ]
    simpa only [B_len, hf_seq_eq, hβ_seq_eq] using ht

  have hB_neg_taylor : taylor2D (fun q => -B_len q) p₁ = -taylor2D B_len p₁ := by
    have hfn : (fun q => -B_len q) = (fun q => (0 : ℂ) - B_len q) := by
      funext q; simp
    rw [hfn, (hJet.taylor2D_ring S.V_plus_open hp₁_Vp (differentiableOn_const 0) hB_len_holo).2.1,
      hJet.taylor2D_const p₁ 0, map_zero, zero_sub]

  let f_web : Fin (k + 1) → PowerSeries ℂ := fun r =>
    if h : r.1 < k - 1 then D_form.f_full ⟨r.1 + 1, by omega⟩ (J + 1)
    else if r.1 = k - 1 then D_form.U_formal (J + 1)
    else D_form.V_formal (J + 1)

  have hformal_web :
      ∑ r : Fin (k + 1),
        taylor2D (G.w_web r) p₁ *
          compPowerSeries2D (f_web r) (centeredTaylor2D (G.ψ_web r) p₁) =
        taylor2D (fun q => -B_len q) p₁ := by
    rw [hB_neg_taylor, hB_len_taylor]
    exact D_form.formal_web_step J

  obtain ⟨W_new, V_new, g_new, hW_new_open, _hW_new_preconn, hW_new_real,
      hV_new_open, _hV_new_preconn, _hV_new_U₀, _hV_new_Vp, hV_new_trap,
      hg_new_holo, hg_new_taylor_coeff, hg_new_eq⟩ :=
    hWeb (k + 1) (by omega) G.a₀ G.R G.δ_star G.C₀
      G.R_pos G.δ_star_pos G.C₀_pos G.C₀_δ_star_lt
      U₀ S.V_plus hU₀_open S.V_plus_open hbase_sub_U₀ S.trapezoid_mem_V_plus
      G.ψ_web G.w_web (fun q => -B_len q) hψ_web_holo hw_web_holo hB_neg_holo
      G.ψ_web_base
      (fun q hq => ⟨(G.trapezoid_nondeg q hq).2.2.2.2.2.2.1,
        (G.trapezoid_nondeg q hq).2.2.2.2.2.2.2.1⟩)
      a₁ δ₁ hδ₁.1 hδ₁.2 ha₁_trap_strict f_web hformal_web

  have hg_new_ps : ∀ r : Fin (k + 1),
      pointArcHoloTaylor1D (g_new r) (G.ψ_web r p₁) = f_web r := by
    intro r
    ext n
    simpa [pointArcHoloTaylor1D, holoTaylor1D] using (hg_new_taylor_coeff r).2 n

  let g_top : Fin (k + 1) → ℂ → ℂ := fun r =>
    if h0 : r.1 = 0 then fun _ => 0
    else if hk_end : r.1 = k then fun _ => 0
    else g_new ⟨r.1 - 1, by have := r.2; omega⟩
  let U_top : ℂ → ℂ := g_new ⟨k - 1, by omega⟩
  let V_top : ℂ → ℂ := g_new ⟨k, by omega⟩

  have hg_top_holo : ∀ r : Fin (k + 1), DifferentiableOn ℂ (g_top r) W_new := by
    intro r
    dsimp only [g_top]
    split_ifs
    · exact differentiableOn_const 0
    · exact differentiableOn_const 0
    · exact hg_new_holo _
  have hU_top_holo : DifferentiableOn ℂ U_top W_new := hg_new_holo _
  have hV_top_holo : DifferentiableOn ℂ V_top W_new := hg_new_holo _
  have hg_top_end : ∀ z : ℂ, g_top 0 z = 0 ∧ g_top (Fin.last k) z = 0 := by
    intro z
    have hk_ne0 : k ≠ 0 := by omega
    simp [g_top, hk_ne0]

  have hg_top_taylor : ∀ r : Fin (k + 1),
      pointArcHoloTaylor1D (g_top r) (G.x_fn r p₁) = D_form.f_full r (J + 1) := by
    intro r
    by_cases hr0 : r.1 = 0
    · have hr_eq : r = 0 := Fin.ext hr0
      rw [hr_eq]
      have hgt : g_top 0 = fun _ => 0 := by simp [g_top]
      rw [hgt, hHoloZero, (D_form.f_endpoints (J + 1) (by omega)).1]
    · by_cases hrk : r.1 = k
      · have hr_eq : r = Fin.last k := Fin.ext hrk
        rw [hr_eq]
        have hk_ne0 : k ≠ 0 := by omega
        have hgt : g_top (Fin.last k) = fun _ => 0 := by simp [g_top, hk_ne0]
        rw [hgt, hHoloZero, (D_form.f_endpoints (J + 1) (by omega)).2]
      · let r_w : Fin (k + 1) := ⟨r.1 - 1, by have := r.2; omega⟩
        have hr_w_lt : r_w.1 < k - 1 := by dsimp [r_w]; have := r.2; omega
        have hr_ne0 : r ≠ 0 := fun h => hr0 (congr_arg Fin.val h)
        have hgt : g_top r = g_new r_w := by simp [g_top, r_w, hr_ne0, hrk]
        have hidx : (⟨r_w.1 + 1, by omega⟩ : Fin (k + 1)) = r := by
          ext; dsimp [r_w]; omega
        have hψ_eq : G.ψ_web r_w p₁ = G.x_fn r p₁ := by
          simp only [PointGlancingChartData.ψ_web, pointChartPsiWeb, hr_w_lt, ↓reduceDIte, hidx]
        have hf_eq : f_web r_w = D_form.f_full r (J + 1) := by
          simp only [f_web, hr_w_lt, ↓reduceDIte, hidx]
        rw [hgt, ← hψ_eq, hg_new_ps r_w, hf_eq]

  have hU_top_taylor : pointArcHoloTaylor1D U_top (a₁ : ℂ) = D_form.U_formal (J + 1) := by
    let r_U : Fin (k + 1) := ⟨k - 1, by omega⟩
    have hψ_U : G.ψ_web r_U p₁ = (a₁ : ℂ) := by
      dsimp only [PointGlancingChartData.ψ_web, pointChartPsiWeb, r_U, p₁]
      split_ifs <;> first | rfl | omega
    have hf_U : f_web r_U = D_form.U_formal (J + 1) := by
      dsimp only [f_web, r_U]
      split_ifs <;> first | rfl | omega
    simpa only [U_top, r_U, hψ_U, hf_U] using hg_new_ps r_U

  have hV_top_taylor :
      pointArcHoloTaylor1D V_top ((a₁ : ℂ) + (δ₁ : ℂ)) = D_form.V_formal (J + 1) := by
    let r_V : Fin (k + 1) := ⟨k, by omega⟩
    have hψ_V : G.ψ_web r_V p₁ = (a₁ : ℂ) + (δ₁ : ℂ) := by
      dsimp only [PointGlancingChartData.ψ_web, pointChartPsiWeb, r_V, p₁]
      split_ifs <;> first | rfl | omega
    have hf_V : f_web r_V = D_form.V_formal (J + 1) := by
      dsimp only [f_web, r_V]
      split_ifs <;> first | rfl | omega
    simpa only [V_top, r_V, hψ_V, hf_V] using hg_new_ps r_V

  have hweb_split : ∀ q ∈ V_new,
      B_len q +
        (∑ r : Fin (k - 1),
          ((G.F (G.x_fn ⟨r.1 + 1, by have := r.2; omega⟩ q) -
              G.F (G.x_fn ⟨r.1, by have := r.2; omega⟩ q)) /
              G.ℓ_fn ⟨r.1, by have := r.2; omega⟩ q -
            (G.F (G.x_fn ⟨r.1 + 2, by have := r.2; omega⟩ q) -
              G.F (G.x_fn ⟨r.1 + 1, by have := r.2; omega⟩ q)) /
              G.ℓ_fn ⟨r.1 + 1, by have := r.2; omega⟩ q) *
            g_top ⟨r.1 + 1, by have := r.2; omega⟩
              (G.x_fn ⟨r.1 + 1, by have := r.2; omega⟩ q)) =
        U_top q.1 + V_top (q.1 + q.2) := by
    intro q hq
    have hsum_raw := (hg_new_eq q hq).2
    rw [Fin.sum_univ_castSucc] at hsum_raw
    let e_fin : Fin ((k - 1) + 1) ≃ Fin k := finCongr (Nat.sub_add_cancel (by omega : 1 ≤ k))
    rw [← Equiv.sum_comp e_fin (fun u : Fin k =>
      G.w_web u.castSucc q * g_new u.castSucc (G.ψ_web u.castSucc q)),
      Fin.sum_univ_castSucc] at hsum_raw
    have h_last_V :
        G.w_web (Fin.last k) q * g_new (Fin.last k) (G.ψ_web (Fin.last k) q) =
          (-1) * V_top (q.1 + q.2) := by
      have hw : G.w_web (Fin.last k) q = -1 := by
        dsimp only [PointGlancingChartData.w_web, pointChartWWeb, Fin.val_last]
        split_ifs <;> first | rfl | omega
      have hψ : G.ψ_web (Fin.last k) q = q.1 + q.2 := by
        dsimp only [PointGlancingChartData.ψ_web, pointChartPsiWeb, Fin.val_last]
        split_ifs <;> first | rfl | omega
      have hg : g_new (Fin.last k) = V_top := rfl
      rw [hw, hψ, hg]
    have h_last_U :
        G.w_web (e_fin (Fin.last (k - 1))).castSucc q *
            g_new (e_fin (Fin.last (k - 1))).castSucc
              (G.ψ_web (e_fin (Fin.last (k - 1))).castSucc q) =
          (-1) * U_top q.1 := by
      have hidx : (e_fin (Fin.last (k - 1))).castSucc = (⟨k - 1, by omega⟩ : Fin (k + 1)) := by
        ext; simp [e_fin]
      rw [hidx]
      have hw : G.w_web ⟨k - 1, by omega⟩ q = -1 := by
        dsimp only [PointGlancingChartData.w_web, pointChartWWeb]
        split_ifs <;> first | rfl | omega
      have hψ : G.ψ_web ⟨k - 1, by omega⟩ q = q.1 := by
        dsimp only [PointGlancingChartData.ψ_web, pointChartPsiWeb]
        split_ifs <;> first | rfl | omega
      have hg : g_new ⟨k - 1, by omega⟩ = U_top := rfl
      rw [hw, hψ, hg]
    have h_int_sum :
        (∑ r : Fin (k - 1),
          G.w_web (e_fin r.castSucc).castSucc q *
            g_new (e_fin r.castSucc).castSucc
              (G.ψ_web (e_fin r.castSucc).castSucc q)) =
        ∑ r : Fin (k - 1),
          ((G.F (G.x_fn ⟨r.1 + 1, by have := r.2; omega⟩ q) -
              G.F (G.x_fn ⟨r.1, by have := r.2; omega⟩ q)) /
              G.ℓ_fn ⟨r.1, by have := r.2; omega⟩ q -
            (G.F (G.x_fn ⟨r.1 + 2, by have := r.2; omega⟩ q) -
              G.F (G.x_fn ⟨r.1 + 1, by have := r.2; omega⟩ q)) /
              G.ℓ_fn ⟨r.1 + 1, by have := r.2; omega⟩ q) *
            g_top ⟨r.1 + 1, by have := r.2; omega⟩
              (G.x_fn ⟨r.1 + 1, by have := r.2; omega⟩ q) := by
      refine Finset.sum_congr rfl fun r _ => ?_
      have hidx : (e_fin r.castSucc).castSucc = (⟨r.1, by have := r.2; omega⟩ : Fin (k + 1)) := by
        ext; simp [e_fin]
      rw [hidx]
      have hw : G.w_web ⟨r.1, by have := r.2; omega⟩ q =
          (G.F (G.x_fn ⟨r.1 + 1, by have := r.2; omega⟩ q) -
              G.F (G.x_fn ⟨r.1, by have := r.2; omega⟩ q)) /
              G.ℓ_fn ⟨r.1, by have := r.2; omega⟩ q -
            (G.F (G.x_fn ⟨r.1 + 2, by have := r.2; omega⟩ q) -
              G.F (G.x_fn ⟨r.1 + 1, by have := r.2; omega⟩ q)) /
              G.ℓ_fn ⟨r.1 + 1, by have := r.2; omega⟩ q := by
        simp only [PointGlancingChartData.w_web, pointChartWWeb, PointGlancingChartData.x_fn,
          r.2, ↓reduceDIte]
      have hψ : G.ψ_web ⟨r.1, by have := r.2; omega⟩ q =
          G.x_fn ⟨r.1 + 1, by have := r.2; omega⟩ q := by
        simp only [PointGlancingChartData.ψ_web, pointChartPsiWeb, PointGlancingChartData.x_fn,
          r.2, ↓reduceDIte]
      have hgt : g_top ⟨r.1 + 1, by have := r.2; omega⟩ =
          g_new ⟨r.1, by have := r.2; omega⟩ := by
        have hnek : r.1 + 1 ≠ k := by have := r.2; omega
        simp [g_top, hnek]
      rw [hw, hψ, hgt]
    rw [h_int_sum, h_last_U, h_last_V] at hsum_raw
    linear_combination hsum_raw

  
  let W_int : Set ℂ := W_new ∩ S.W_ψ
  have hW_int_open : IsOpen W_int := hW_new_open.inter S.W_ψ_open
  let W_ψ' : Set ℂ := connectedComponentIn W_int (G.a₀ : ℂ)
  have hW'_open : IsOpen W_ψ' := hW_int_open.connectedComponentIn
  have hW'_preconn : IsPreconnected W_ψ' := isPreconnected_connectedComponentIn
  have hW'_sub_int : W_ψ' ⊆ W_int := connectedComponentIn_subset W_int (G.a₀ : ℂ)
  have hW'_sub_new : W_ψ' ⊆ W_new := fun _ hz => (hW'_sub_int hz).1
  have hW'_sub_S : W_ψ' ⊆ S.W_ψ := fun _ hz => (hW'_sub_int hz).2
  have hW'_sub_WF : W_ψ' ⊆ G.W_F := hW'_sub_S.trans S.W_ψ_sub_W_F
  have hW'_real : ∀ x : ℝ, |x - G.a₀| < G.R → (x : ℂ) ∈ W_ψ' := by
    let I_R : Set ℝ := Set.Ioo (G.a₀ - G.R) (G.a₀ + G.R)
    have hI_preconn : IsPreconnected ((fun x : ℝ => (x : ℂ)) '' I_R) :=
      (convex_Ioo _ _).isPreconnected.image _ Complex.continuous_ofReal.continuousOn
    have ha₀_mem : (G.a₀ : ℂ) ∈ (fun x : ℝ => (x : ℂ)) '' I_R :=
      ⟨G.a₀, ⟨by linarith [G.R_pos], by linarith [G.R_pos]⟩, rfl⟩
    have hI_sub : (fun x : ℝ => (x : ℂ)) '' I_R ⊆ W_int := by
      rintro _ ⟨x, hx, rfl⟩
      have hx_abs : |x - G.a₀| < G.R := abs_lt.mpr ⟨by linarith [hx.1], by linarith [hx.2]⟩
      exact ⟨hW_new_real x hx_abs, S.real_mem_W_ψ x hx_abs⟩
    have hsub := hI_preconn.subset_connectedComponentIn ha₀_mem hI_sub
    intro x hx
    have hx_bounds := abs_lt.mp hx
    exact hsub ⟨x, ⟨by linarith [hx_bounds.1], by linarith [hx_bounds.2]⟩, rfl⟩

  have hψ_trap_W' : ∀ q ∈ webTrapezoid G.a₀ G.R G.δ_star G.C₀,
      ∀ r : Fin (k + 1), G.ψ_web r ((q.1 : ℂ), (q.2 : ℂ)) ∈ W_ψ' := by
    intro q hq r
    have hCδ_pos : 0 < G.C₀ * q.2 := mul_pos G.C₀_pos hq.1
    have hq1_abs : |q.1 - G.a₀| < G.R := by linarith [hq.2.2]
    have hq1_W' : (q.1 : ℂ) ∈ W_ψ' := hW'_real q.1 hq1_abs
    have hW'_eq_q1 : W_ψ' = connectedComponentIn W_int (q.1 : ℂ) :=
      connectedComponentIn_eq hq1_W'
    let γ : ℝ → ℂ := fun t => G.ψ_web r ((q.1 : ℂ), (t : ℂ))
    have hγ_zero : γ 0 = (q.1 : ℂ) := by
      dsimp only [γ, PointGlancingChartData.ψ_web, pointChartPsiWeb]
      split_ifs with h1 h2
      · simpa using (G.x_at_zero ⟨r.1 + 1, by omega⟩ q.1 hq1_abs).1
      · rfl
      · simp
    have hspine_U₀ : Set.MapsTo (fun t : ℝ => ((q.1 : ℂ), (t : ℂ))) (Set.Icc 0 q.2) U₀ := by
      intro t ht
      exact hbase_sub_U₀ (q.1, t) ⟨ht.1, lt_of_le_of_lt ht.2 hq.2.1, le_of_lt hq1_abs⟩
    have hγ_cont : ContinuousOn γ (Set.Icc 0 q.2) :=
      (hψ_web_holo r).continuousOn.comp
        (continuous_const.prodMk Complex.continuous_ofReal).continuousOn hspine_U₀
    have hΓ_preconn : IsPreconnected (γ '' Set.Icc 0 q.2) :=
      (convex_Icc 0 q.2).isPreconnected.image γ hγ_cont
    have h0_mem_Γ : (q.1 : ℂ) ∈ γ '' Set.Icc 0 q.2 :=
      ⟨0, ⟨le_rfl, le_of_lt hq.1⟩, hγ_zero⟩
    have hΓ_sub : γ '' Set.Icc 0 q.2 ⊆ W_int := by
      rintro _ ⟨t, ht, rfl⟩
      rcases eq_or_lt_of_le ht.1 with rfl | ht_pos
      · rw [hγ_zero]
        exact hW'_sub_int hq1_W'
      · have ht_trap : (q.1, t) ∈ webTrapezoid G.a₀ G.R G.δ_star G.C₀ := by
          refine ⟨ht_pos, lt_of_le_of_lt ht.2 hq.2.1, ?_⟩
          have hCt : G.C₀ * t ≤ G.C₀ * q.2 :=
            mul_le_mul_of_nonneg_left ht.2 (le_of_lt G.C₀_pos)
          linarith [hq.2.2]
        exact ⟨(hg_new_eq _ (hV_new_trap (q.1, t) ht_trap)).1 r,
          S.ψ_maps_W_ψ _ (S.trapezoid_mem_V_plus (q.1, t) ht_trap) r⟩
    rw [hW'_eq_q1]
    exact hΓ_preconn.subset_connectedComponentIn h0_mem_Γ hΓ_sub
      ⟨q.2, ⟨le_of_lt hq.1, le_rfl⟩, rfl⟩

  let V_int : Set (ℂ × ℂ) :=
    V_new ∩ S.V_plus ∩ ⋂ r : Fin (k + 1), U₀ ∩ (G.ψ_web r) ⁻¹' W_ψ'
  have hV_int_open : IsOpen V_int := by
    refine (hV_new_open.inter S.V_plus_open).inter (isOpen_iInter_of_finite fun r => ?_)
    exact (hψ_web_holo r).continuousOn.isOpen_inter_preimage hU₀_open hW'_open
  let V_plus' : Set (ℂ × ℂ) := connectedComponentIn V_int p₁
  have hV'_open : IsOpen V_plus' := hV_int_open.connectedComponentIn
  have hV'_preconn : IsPreconnected V_plus' := isPreconnected_connectedComponentIn
  have hV'_sub_int : V_plus' ⊆ V_int := connectedComponentIn_subset V_int p₁
  have hV'_sub_new : V_plus' ⊆ V_new := fun _ hq => (hV'_sub_int hq).1.1
  have hV'_sub_S : V_plus' ⊆ S.V_plus := fun _ hq => (hV'_sub_int hq).1.2
  have hV'_sub_U₀ : V_plus' ⊆ U₀ := hV'_sub_S.trans S.V_plus_sub
  have hψ_maps_W' : ∀ q ∈ V_plus', ∀ r : Fin (k + 1), G.ψ_web r q ∈ W_ψ' :=
    fun q hq r => (Set.mem_iInter.mp (hV'_sub_int hq).2 r).2
  have hx_maps_W' : ∀ q ∈ V_plus', ∀ s : Fin (k + 1), G.x_fn s q ∈ W_ψ' :=
    hx_maps_of_ψ hV'_sub_U₀ hψ_maps_W'
  have hV'_trap : ∀ q ∈ webTrapezoid G.a₀ G.R G.δ_star G.C₀,
      ((q.1 : ℂ), (q.2 : ℂ)) ∈ V_plus' := by
    have hTrap_conv : Convex ℝ (webTrapezoid G.a₀ G.R G.δ_star G.C₀) := by
      intro x hx y hy a b ha hb hab
      rcases eq_or_lt_of_le ha with rfl | ha_pos
      · simp_all
      · refine ⟨?_, ?_, ?_⟩
        · have h1 : 0 < a * x.2 := mul_pos ha_pos hx.1
          have h2 : 0 ≤ b * y.2 := mul_nonneg hb (le_of_lt hy.1)
          change 0 < a * x.2 + b * y.2
          linarith
        · have h1 : a * x.2 < a * G.δ_star := mul_lt_mul_of_pos_left hx.2.1 ha_pos
          have h2 : b * y.2 ≤ b * G.δ_star := mul_le_mul_of_nonneg_left (le_of_lt hy.2.1) hb
          change a * x.2 + b * y.2 < G.δ_star
          calc a * x.2 + b * y.2
              < a * G.δ_star + b * G.δ_star := by linarith
            _ = G.δ_star := by rw [← add_mul, hab, one_mul]
        · change |(a * x.1 + b * y.1) - G.a₀| < G.R - G.C₀ * (a * x.2 + b * y.2)
          have hsplit : (a * x.1 + b * y.1) - G.a₀ =
              a * (x.1 - G.a₀) + b * (y.1 - G.a₀) := by
            calc (a * x.1 + b * y.1) - G.a₀
                = (a * x.1 + b * y.1) - (a + b) * G.a₀ := by rw [hab, one_mul]
              _ = a * (x.1 - G.a₀) + b * (y.1 - G.a₀) := by ring
          rw [hsplit]
          calc |a * (x.1 - G.a₀) + b * (y.1 - G.a₀)|
              ≤ |a * (x.1 - G.a₀)| + |b * (y.1 - G.a₀)| := abs_add_le _ _
            _ = a * |x.1 - G.a₀| + b * |y.1 - G.a₀| := by
                rw [abs_mul, abs_mul, abs_of_nonneg ha, abs_of_nonneg hb]
            _ < a * (G.R - G.C₀ * x.2) + b * (G.R - G.C₀ * y.2) := by
                have h1 : a * |x.1 - G.a₀| < a * (G.R - G.C₀ * x.2) :=
                  mul_lt_mul_of_pos_left hx.2.2 ha_pos
                have h2 : b * |y.1 - G.a₀| ≤ b * (G.R - G.C₀ * y.2) :=
                  mul_le_mul_of_nonneg_left (le_of_lt hy.2.2) hb
                linarith
            _ = G.R - G.C₀ * (a * x.2 + b * y.2) := by
                calc a * (G.R - G.C₀ * x.2) + b * (G.R - G.C₀ * y.2)
                    = (a + b) * G.R - G.C₀ * (a * x.2 + b * y.2) := by ring
                  _ = G.R - G.C₀ * (a * x.2 + b * y.2) := by rw [hab, one_mul]
    let embR2 : ℝ × ℝ → ℂ × ℂ := fun q => ((q.1 : ℂ), (q.2 : ℂ))
    have hembR2_cont : Continuous embR2 :=
      (Complex.continuous_ofReal.comp continuous_fst).prodMk
        (Complex.continuous_ofReal.comp continuous_snd)
    have hTrap_preconn : IsPreconnected (embR2 '' webTrapezoid G.a₀ G.R G.δ_star G.C₀) :=
      hTrap_conv.isPreconnected.image embR2 hembR2_cont.continuousOn
    have hp₁_img : p₁ ∈ embR2 '' webTrapezoid G.a₀ G.R G.δ_star G.C₀ :=
      ⟨(a₁, δ₁), hq₁_trap, rfl⟩
    have hTrap_sub_int : embR2 '' webTrapezoid G.a₀ G.R G.δ_star G.C₀ ⊆ V_int := by
      rintro _ ⟨q, hq, rfl⟩
      have hq_S : embR2 q ∈ S.V_plus := S.trapezoid_mem_V_plus q hq
      exact ⟨⟨hV_new_trap q hq, hq_S⟩,
        Set.mem_iInter.mpr fun r => ⟨S.V_plus_sub hq_S, hψ_trap_W' q hq r⟩⟩
    have hsub := hTrap_preconn.subset_connectedComponentIn hp₁_img hTrap_sub_int
    intro q hq
    exact hsub ⟨q, hq, rfl⟩
  have hp₁_Vp' : p₁ ∈ V_plus' := hV'_trap (a₁, δ₁) hq₁_trap

  
  
  let g' : Fin (k + 1) → Fin (J + 1 + 1) → ℂ → ℂ := fun r => Fin.snoc (S.g r) (g_top r)
  let U_split' : Fin (J + 1 + 1) → ℂ → ℂ := Fin.snoc S.U_split U_top
  let V_split' : Fin (J + 1 + 1) → ℂ → ℂ := Fin.snoc S.V_split V_top
  let β_zero_top : Fin (J + 1 + 1) → Fin (k + 1) → ℂ × ℂ → ℂ :=
    Fin.snoc S.β (fun _ _ => 0)

  have hg'_holo : ∀ (r : Fin (k + 1)) (l : Fin (J + 1 + 1)),
      DifferentiableOn ℂ (g' r l) W_ψ' := by
    intro r l
    refine Fin.lastCases ?_ ?_ l
    · simpa [g', Fin.snoc_last] using (hg_top_holo r).mono hW'_sub_new
    · intro m
      simpa [g', Fin.snoc_castSucc] using (S.g_holo r m).mono hW'_sub_S
  have hg'0 : ∀ (r : Fin (k + 1)) (z : ℂ), g' r 0 z = 0 := by
    intro r z
    have h0_eq : (0 : Fin (J + 1 + 1)) = (0 : Fin (J + 1)).castSucc := rfl
    rw [h0_eq]
    simpa [g', Fin.snoc_castSucc] using hg0_S r z
  have hg'_endpoints : ∀ (l : Fin (J + 1 + 1)) (z : ℂ),
      g' 0 l z = 0 ∧ g' (Fin.last k) l z = 0 := by
    intro l z
    refine Fin.lastCases ?_ ?_ l
    · simpa [g', Fin.snoc_last] using hg_top_end z
    · intro m
      simpa [g', Fin.snoc_castSucc] using S.g_endpoints m z
  have hg'_lt_p : ∀ (r : Fin (k + 1)) (l : Fin (J + 1 + 1)),
      (l : ℕ) < D_form.p → ∀ z : ℂ, g' r l z = 0 := by
    intro r
    refine Fin.lastCases ?_ ?_
    · intro hl
      exfalso
      have hl_val : ((Fin.last (J + 1) : Fin (J + 1 + 1)) : ℕ) = J + 1 := Fin.val_last _
      omega
    · intro m hm z
      simpa [g', Fin.snoc_castSucc] using S.g_lt_p r m (by simpa using hm) z
  have hg'_taylor : ∀ (r : Fin (k + 1)) (l : Fin (J + 1 + 1)), 1 ≤ (l : ℕ) →
      pointArcHoloTaylor1D (g' r l) (G.x_fn r p₁) = D_form.f_full r (l : ℕ) := by
    intro r
    refine Fin.lastCases ?_ ?_
    · intro _
      simpa [g', Fin.snoc_last, Fin.val_last] using hg_top_taylor r
    · intro m hm
      simpa [g', Fin.snoc_castSucc, Fin.val_castSucc] using S.g_taylor r m (by simpa using hm)

  have hUV'_holo : ∀ l : Fin (J + 1 + 1),
      DifferentiableOn ℂ (U_split' l) W_ψ' ∧ DifferentiableOn ℂ (V_split' l) W_ψ' := by
    refine Fin.lastCases ?_ ?_
    · exact ⟨by simpa [U_split', Fin.snoc_last] using hU_top_holo.mono hW'_sub_new,
        by simpa [V_split', Fin.snoc_last] using hV_top_holo.mono hW'_sub_new⟩
    · intro m
      exact ⟨by simpa [U_split', Fin.snoc_castSucc] using (S.UV_holo m).1.mono hW'_sub_S,
        by simpa [V_split', Fin.snoc_castSucc] using (S.UV_holo m).2.mono hW'_sub_S⟩
  have hUV'_lt_p : ∀ l : Fin (J + 1 + 1), (l : ℕ) < D_form.p →
      ∀ z : ℂ, U_split' l z = 0 ∧ V_split' l z = 0 := by
    refine Fin.lastCases ?_ ?_
    · intro hl
      exfalso
      have hl_val : ((Fin.last (J + 1) : Fin (J + 1 + 1)) : ℕ) = J + 1 := Fin.val_last _
      omega
    · intro m hm z
      simpa [U_split', V_split', Fin.snoc_castSucc] using S.UV_lt_p m (by simpa using hm) z
  have hUV'_taylor : ∀ l : Fin (J + 1 + 1), 1 ≤ (l : ℕ) →
      pointArcHoloTaylor1D (U_split' l) (a₁ : ℂ) = D_form.U_formal (l : ℕ) ∧
      pointArcHoloTaylor1D (V_split' l) ((a₁ : ℂ) + (δ₁ : ℂ)) = D_form.V_formal (l : ℕ) := by
    refine Fin.lastCases ?_ ?_
    · intro _
      exact ⟨by simpa [U_split', Fin.snoc_last, Fin.val_last] using hU_top_taylor,
        by simpa [V_split', Fin.snoc_last, Fin.val_last] using hV_top_taylor⟩
    · intro m hm
      simpa [U_split', V_split', Fin.snoc_castSucc, Fin.val_castSucc] using
        S.UV_taylor m (by simpa using hm)

  have hβ_zt_holo : ∀ (l : Fin (J + 1 + 1)) (r : Fin (k + 1)),
      DifferentiableOn ℂ (β_zero_top l r) V_plus' := by
    refine Fin.lastCases ?_ ?_
    · intro r
      simp [β_zero_top, Fin.snoc_last, differentiableOn_const]
    · intro m r
      simpa [β_zero_top, Fin.snoc_castSucc] using (S.β_holo m r).mono hV'_sub_S
  have hβ_zt_0 : ∀ (r : Fin (k + 1)) (q : ℂ × ℂ), β_zero_top 0 r q = 0 := by
    intro r q
    have h0_eq : (0 : Fin (J + 1 + 1)) = (0 : Fin (J + 1)).castSucc := rfl
    rw [h0_eq]
    simpa [β_zero_top, Fin.snoc_castSucc] using S.β_zero r q

  have hℓ_holo' : ∀ i : Fin k, DifferentiableOn ℂ (G.ℓ_fn i) V_plus' :=
    fun i => ((G.ℓ_holo_sq i).1).mono hV'_sub_U₀
  have hℓ_ne' : ∀ q ∈ V_plus', ∀ i : Fin k, G.ℓ_fn i q ≠ 0 :=
    fun q hq i => S.chord_ne_zero q (hV'_sub_S hq) i
  have hx_holo' : ∀ u : Fin (k + 1), DifferentiableOn ℂ (G.x_fn u) V_plus' :=
    fun u => ((G.x_holo_maps u).1).mono hV'_sub_U₀
  have hℓ_sq' : ∀ q ∈ V_plus', ∀ i : Fin k,
      (G.ℓ_fn i q) ^ 2 = pointEdgeSq (fun _ => G.F) (fun r => G.x_fn r q) i :=
    fun q hq i => (G.ℓ_holo_sq i).2 q (hV'_sub_U₀ hq)

  let H_pt : ℂ × ℂ → Matrix (Fin (k - 1)) (Fin (k - 1)) ℂ := fun q =>
    pointInteriorHess (fun i => G.ℓ_fn i q) G.F (deriv G.F) (deriv (deriv G.F))
      (fun u => G.x_fn u q)
  have hdet_ne' : ∀ q ∈ V_plus', (H_pt q).det ≠ 0 :=
    fun q hq => S.hess_det_ne_zero q (hV'_sub_S hq)

  have hH_pt_holo : ∀ r s : Fin (k - 1), DifferentiableOn ℂ (fun q => H_pt q r s) V_plus' := by
    intro r s
    have hF'_holo : DifferentiableOn ℂ (deriv G.F) G.W_F := G.F_holo.deriv G.W_F_open
    have hF''_holo : DifferentiableOn ℂ (deriv (deriv G.F)) G.W_F := hF'_holo.deriv G.W_F_open
    have hx_maps_WF : ∀ u : Fin (k + 1), Set.MapsTo (G.x_fn u) V_plus' G.W_F :=
      fun u _ hq => ((G.x_holo_maps u).2 _ (hV'_sub_U₀ hq)).1
    have hFx : ∀ u : Fin (k + 1), DifferentiableOn ℂ (fun q => G.F (G.x_fn u q)) V_plus' :=
      fun u => G.F_holo.comp (hx_holo' u) (hx_maps_WF u)
    have hF'x : ∀ u : Fin (k + 1),
        DifferentiableOn ℂ (fun q => deriv G.F (G.x_fn u q)) V_plus' :=
      fun u => hF'_holo.comp (hx_holo' u) (hx_maps_WF u)
    have hF''x : ∀ u : Fin (k + 1),
        DifferentiableOn ℂ (fun q => deriv (deriv G.F) (G.x_fn u q)) V_plus' :=
      fun u => hF''_holo.comp (hx_holo' u) (hx_maps_WF u)
    let i_L : Fin k := ⟨r.1, by have := r.2; omega⟩
    let i_R : Fin k := ⟨r.1 + 1, by have := r.2; omega⟩
    have hdiv3 : ∀ {num : ℂ × ℂ → ℂ} (i : Fin k),
        DifferentiableOn ℂ num V_plus' →
        DifferentiableOn ℂ (fun q => num q / (G.ℓ_fn i q) ^ 3) V_plus' := by
      intro num i hnum
      have hinv : DifferentiableOn ℂ (fun q => ((G.ℓ_fn i q) ^ 3)⁻¹) V_plus' :=
        ((hℓ_holo' i).pow 3).inv (fun q hq => pow_ne_zero 3 (hℓ_ne' q hq i))
      exact (hnum.mul hinv).congr (fun q _ => div_eq_mul_inv (num q) ((G.ℓ_fn i q) ^ 3))
    have hΔx_L : DifferentiableOn ℂ (fun q => G.x_fn i_L.succ q - G.x_fn i_L.castSucc q) V_plus' :=
      (hx_holo' i_L.succ).sub (hx_holo' i_L.castSucc)
    have hΔY_L : DifferentiableOn ℂ
        (fun q => G.F (G.x_fn i_L.succ q) - G.F (G.x_fn i_L.castSucc q)) V_plus' :=
      (hFx i_L.succ).sub (hFx i_L.castSucc)
    have hn_L_succ : DifferentiableOn ℂ
        (fun q => (G.x_fn i_L.succ q - G.x_fn i_L.castSucc q) +
          (G.F (G.x_fn i_L.succ q) - G.F (G.x_fn i_L.castSucc q)) *
            deriv G.F (G.x_fn i_L.succ q)) V_plus' :=
      hΔx_L.add (hΔY_L.mul (hF'x i_L.succ))
    have hn_L_cast : DifferentiableOn ℂ
        (fun q => (G.x_fn i_L.succ q - G.x_fn i_L.castSucc q) +
          (G.F (G.x_fn i_L.succ q) - G.F (G.x_fn i_L.castSucc q)) *
            deriv G.F (G.x_fn i_L.castSucc q)) V_plus' :=
      hΔx_L.add (hΔY_L.mul (hF'x i_L.castSucc))
    have hΔx_R : DifferentiableOn ℂ (fun q => G.x_fn i_R.succ q - G.x_fn i_R.castSucc q) V_plus' :=
      (hx_holo' i_R.succ).sub (hx_holo' i_R.castSucc)
    have hΔY_R : DifferentiableOn ℂ
        (fun q => G.F (G.x_fn i_R.succ q) - G.F (G.x_fn i_R.castSucc q)) V_plus' :=
      (hFx i_R.succ).sub (hFx i_R.castSucc)
    have hn_R_cast : DifferentiableOn ℂ
        (fun q => (G.x_fn i_R.succ q - G.x_fn i_R.castSucc q) +
          (G.F (G.x_fn i_R.succ q) - G.F (G.x_fn i_R.castSucc q)) *
            deriv G.F (G.x_fn i_R.castSucc q)) V_plus' :=
      hΔx_R.add (hΔY_R.mul (hF'x i_R.castSucc))
    have hn_R_succ : DifferentiableOn ℂ
        (fun q => (G.x_fn i_R.succ q - G.x_fn i_R.castSucc q) +
          (G.F (G.x_fn i_R.succ q) - G.F (G.x_fn i_R.castSucc q)) *
            deriv G.F (G.x_fn i_R.succ q)) V_plus' :=
      hΔx_R.add (hΔY_R.mul (hF'x i_R.succ))
    dsimp only [H_pt, pointInteriorHess]
    split_ifs
    · refine DifferentiableOn.add (hdiv3 i_L ?_) (hdiv3 i_R ?_)
      · exact ((((differentiableOn_const 1).add ((hF'x i_L.succ).pow 2)).add
          (hΔY_L.mul (hF''x i_L.succ))).mul ((hℓ_holo' i_L).pow 2)).sub (hn_L_succ.pow 2)
      · exact ((((differentiableOn_const 1).add ((hF'x i_R.castSucc).pow 2)).sub
          (hΔY_R.mul (hF''x i_R.castSucc))).mul ((hℓ_holo' i_R).pow 2)).sub (hn_R_cast.pow 2)
    · refine hdiv3 i_R ?_
      exact (((differentiableOn_const (-1)).sub ((hF'x i_R.succ).mul (hF'x i_R.castSucc))).mul
        ((hℓ_holo' i_R).pow 2)).add (hn_R_cast.mul hn_R_succ)
    · refine hdiv3 i_L ?_
      exact (((differentiableOn_const (-1)).sub ((hF'x i_L.castSucc).mul (hF'x i_L.succ))).mul
        ((hℓ_holo' i_L).pow 2)).add (hn_L_succ.mul hn_L_cast)
    · exact differentiableOn_const 0

  let R_grad : ℂ × ℂ → Fin (k - 1) → ℂ := fun q r =>
    pointArcEpsJet (J + 1)
      (fun ε =>
        pointRelInteriorGrad (fun i => G.ℓ_fn i q)
          (pointArcPertGraph G.F g' ε)
          (pointArcPertGraphDeriv G.F g' ε)
          (pointArcPertAbscissa (fun s => G.x_fn s q) (fun m s => β_zero_top m s q) ε) r)

  have hR_grad_holo : ∀ r : Fin (k - 1), DifferentiableOn ℂ (fun q => R_grad q r) V_plus' :=
    (hJet.epsJet_holo (ℓ₀ := G.ℓ_fn) (x₀ := G.x_fn) (β := β_zero_top) (J + 1)
      hW'_open hV'_open (G.F_holo.mono hW'_sub_WF) hg'_holo hg'0
      hℓ_holo' hℓ_ne' hx_holo' hx_maps_W' hℓ_sq' hβ_zt_holo hβ_zt_0).2

  let β_form_int : Fin (k - 1) → MvPowerSeries (Fin 2) ℂ :=
    fun s => D_form.β_full (J + 1) ⟨s.1 + 1, by have := s.2; omega⟩

  have hformal_hess : ∀ r : Fin (k - 1),
      taylor2D (fun q => R_grad q r) p₁ +
        ∑ s : Fin (k - 1), taylor2D (fun q => H_pt q r s) p₁ * β_form_int s = 0 := by
    intro r
    have ht := (hJet.taylor2D_epsJet_eq (ℓ₀ := G.ℓ_fn) (x₀ := G.x_fn) (β := β_zero_top) (J + 1)
      hW'_open hV'_open hp₁_Vp' (G.F_holo.mono hW'_sub_WF) hg'_holo hg'0
      hℓ_holo' hℓ_ne' hx_holo' hx_maps_W' hℓ_sq' hβ_zt_holo hβ_zt_0).2 r
    have hf_seq_eq :
        (fun (u : Fin (k + 1)) (l : ℕ) =>
          if l = 0 then pointArcHoloTaylor1D G.F (G.x_fn u p₁)
          else if hl : l < J + 1 + 1 then pointArcHoloTaylor1D (g' u ⟨l, hl⟩) (G.x_fn u p₁)
          else 0) =
        pointArcTruncGraph (J + 1) D_form.f_full := by
      funext u l
      dsimp only [pointArcTruncGraph]
      by_cases hl0 : l = 0
      · subst hl0
        simpa using (D_form.f_zero u).symm
      · by_cases hlJ1 : l ≤ J + 1
        · have hlJ2 : l < J + 1 + 1 := by omega
          simp only [hl0, ↓reduceIte, hlJ2, ↓reduceDIte, hlJ1]
          exact hg'_taylor u ⟨l, hlJ2⟩ (Nat.pos_of_ne_zero hl0)
        · have hlJ2 : ¬ l < J + 1 + 1 := by omega
          simp only [hl0, ↓reduceIte, hlJ2, ↓reduceDIte, hlJ1]
    have hβ_seq_eq :
        (fun (l : ℕ) (u : Fin (k + 1)) =>
          if l = 0 then centeredTaylor2D (G.x_fn u) p₁
          else if hl : l < J + 1 + 1 then taylor2D (β_zero_top ⟨l, hl⟩ u) p₁
          else 0) =
        pointArcTruncBeta J D_form.β_full := by
      funext l u
      dsimp only [pointArcTruncBeta]
      by_cases hl0 : l = 0
      · subst hl0
        simpa using (D_form.β_zero u).symm
      · by_cases hlJ : l ≤ J
        · have hlJ1 : l < J + 1 := by omega
          have hlJ2 : l < J + 1 + 1 := by omega
          simp only [hl0, ↓reduceIte, hlJ2, ↓reduceDIte, hlJ]
          have hcast : (⟨l, hlJ2⟩ : Fin (J + 1 + 1)) =
              (⟨l, hlJ1⟩ : Fin (J + 1)).castSucc := by
            ext; rfl
          have hzt : β_zero_top (⟨l, hlJ1⟩ : Fin (J + 1)).castSucc = S.β ⟨l, hlJ1⟩ :=
            Fin.snoc_castSucc (α := fun _ => Fin (k + 1) → ℂ × ℂ → ℂ)
              (fun _ _ => 0) S.β ⟨l, hlJ1⟩
          rw [hcast, hzt]
          exact S.β_taylor ⟨l, hlJ1⟩ u (Nat.pos_of_ne_zero hl0)
        · by_cases hlJ2 : l < J + 1 + 1
          · simp only [hl0, ↓reduceIte, hlJ2, ↓reduceDIte, hlJ]
            have hlast : (⟨l, hlJ2⟩ : Fin (J + 1 + 1)) = Fin.last (J + 1) := by
              ext; dsimp [Fin.val_last]; omega
            rw [hlast]
            have hzt : β_zero_top (Fin.last (J + 1)) u = fun _ => 0 := by
              simp [β_zero_top, Fin.snoc_last]
            rw [hzt, hJet.taylor2D_const p₁ 0, map_zero]
          · simp only [hl0, ↓reduceIte, hlJ2, ↓reduceDIte, hlJ]
    have hR_tay : taylor2D (fun q => R_grad q r) p₁ =
        pointArcSlice2D1D (J + 1)
          (pointArcFormalGrad2D1D
            (fun i => G.ℓ_fn i p₁)
            (fun u => G.x_fn u p₁)
            (pointArcTruncGraph (J + 1) D_form.f_full)
            (pointArcTruncBeta J D_form.β_full) r) := by
      simpa only [R_grad, hf_seq_eq, hβ_seq_eq] using ht
    rw [hR_tay]
    exact D_form.formal_hess_step J r

  
  have hprod_holo : ∀ {α : Type} (s : Finset α) (f : α → ℂ × ℂ → ℂ),
      (∀ a ∈ s, DifferentiableOn ℂ (f a) V_plus') →
      DifferentiableOn ℂ (fun q => ∏ a ∈ s, f a q) V_plus' := by
    intro α s f hf
    classical
    induction s using Finset.induction_on with
    | empty => simp [differentiableOn_const]
    | @insert a s ha ih =>
        have h1 : DifferentiableOn ℂ (f a) V_plus' := hf a (Finset.mem_insert_self a s)
        have h2 : DifferentiableOn ℂ (fun q => ∏ b ∈ s, f b q) V_plus' :=
          ih (fun b hb => hf b (Finset.mem_insert_of_mem hb))
        exact (h1.mul h2).congr (fun q _ => Finset.prod_insert ha)

  have hsum_holo : ∀ {α : Type} (s : Finset α) (f : α → ℂ × ℂ → ℂ),
      (∀ a ∈ s, DifferentiableOn ℂ (f a) V_plus') →
      DifferentiableOn ℂ (fun q => ∑ a ∈ s, f a q) V_plus' := by
    intro α s f hf
    classical
    induction s using Finset.induction_on with
    | empty => simp [differentiableOn_const]
    | @insert a s ha ih =>
        have h1 : DifferentiableOn ℂ (f a) V_plus' := hf a (Finset.mem_insert_self a s)
        have h2 : DifferentiableOn ℂ (fun q => ∑ b ∈ s, f b q) V_plus' :=
          ih (fun b hb => hf b (Finset.mem_insert_of_mem hb))
        exact (h1.add h2).congr (fun q _ => Finset.sum_insert ha)

  have hdet_holo : ∀ (M : ℂ × ℂ → Matrix (Fin (k - 1)) (Fin (k - 1)) ℂ),
      (∀ i j : Fin (k - 1), DifferentiableOn ℂ (fun q => M q i j) V_plus') →
      DifferentiableOn ℂ (fun q => (M q).det) V_plus' := by
    intro M hM
    have hfun : (fun q => (M q).det) = fun q =>
        ∑ σ : Equiv.Perm (Fin (k - 1)),
          ((Equiv.Perm.sign σ : ℤ) : ℂ) * ∏ i : Fin (k - 1), M q (σ i) i := by
      ext q
      simp only [Matrix.det_apply, Units.smul_def, zsmul_eq_mul]
    rw [hfun]
    exact hsum_holo Finset.univ
      (fun σ q => ((Equiv.Perm.sign σ : ℤ) : ℂ) * ∏ i : Fin (k - 1), M q (σ i) i)
      fun σ _ =>
        (differentiableOn_const _).mul
          (hprod_holo Finset.univ (fun i q => M q (σ i) i) fun i _ => hM (σ i) i)

  let β_int : Fin (k - 1) → ℂ × ℂ → ℂ :=
    fun u q => -((H_pt q).det)⁻¹ * ((H_pt q).cramer (R_grad q)) u

  have hβ_int_holo : ∀ u : Fin (k - 1), DifferentiableOn ℂ (β_int u) V_plus' := by
    intro u
    have hinv : DifferentiableOn ℂ (fun q => -((H_pt q).det)⁻¹) V_plus' :=
      ((hdet_holo H_pt hH_pt_holo).inv hdet_ne').neg
    have hcram : DifferentiableOn ℂ (fun q => ((H_pt q).cramer (R_grad q)) u) V_plus' := by
      have hfn : (fun q => ((H_pt q).cramer (R_grad q)) u) =
          fun q => ((H_pt q).updateCol u (R_grad q)).det := by
        ext q
        exact Matrix.cramer_apply (H_pt q) (R_grad q) u
      rw [hfn]
      refine hdet_holo (fun q => (H_pt q).updateCol u (R_grad q)) fun i j => ?_
      by_cases hju : j = u
      · subst hju
        simpa [Matrix.updateCol_apply] using hR_grad_holo i
      · simpa [Matrix.updateCol_apply, hju] using hH_pt_holo i j
    exact hinv.mul hcram

  have hβ_int_solve : ∀ q ∈ V_plus', ∀ r : Fin (k - 1),
      R_grad q r + ∑ s : Fin (k - 1), H_pt q r s * β_int s q = 0 := by
    intro q hq r
    have hmv : (∑ s : Fin (k - 1), H_pt q r s * β_int s q) =
        ((H_pt q).mulVec ((-(H_pt q).det⁻¹) • (H_pt q).cramer (R_grad q))) r := by
      rfl
    rw [hmv, Matrix.mulVec_smul, Matrix.mulVec_cramer]
    dsimp only [Pi.smul_apply, smul_eq_mul]
    have hdet : (H_pt q).det ≠ 0 := hdet_ne' q hq
    calc R_grad q r + -(H_pt q).det⁻¹ * ((H_pt q).det * R_grad q r)
        = R_grad q r - ((H_pt q).det⁻¹ * (H_pt q).det) * R_grad q r := by ring
      _ = R_grad q r - 1 * R_grad q r := by rw [inv_mul_cancel₀ hdet]
      _ = 0 := by ring

  have htaylor2D_sum : ∀ {α : Type} (s : Finset α) (f : α → ℂ × ℂ → ℂ),
      (∀ a ∈ s, DifferentiableOn ℂ (f a) V_plus') →
      taylor2D (fun q => ∑ a ∈ s, f a q) p₁ = ∑ a ∈ s, taylor2D (f a) p₁ := by
    intro α s f hf
    classical
    induction s using Finset.induction_on with
    | empty =>
        simp only [Finset.sum_empty]
        rw [hJet.taylor2D_const p₁ 0, map_zero]
    | @insert a s ha ih =>
        have h1 : DifferentiableOn ℂ (f a) V_plus' := hf a (Finset.mem_insert_self a s)
        have h2 : DifferentiableOn ℂ (fun q => ∑ b ∈ s, f b q) V_plus' :=
          hsum_holo s f (fun b hb => hf b (Finset.mem_insert_of_mem hb))
        have hfn : (fun q => ∑ b ∈ insert a s, f b q) =
            fun q => f a q + ∑ b ∈ s, f b q := by
          ext q; exact Finset.sum_insert ha
        rw [hfn, (hJet.taylor2D_ring hV'_open hp₁_Vp' h1 h2).1,
          ih (fun b hb => hf b (Finset.mem_insert_of_mem hb)), Finset.sum_insert ha]

  have hβ_int_ps_eq : ∀ r : Fin (k - 1),
      taylor2D (fun q => R_grad q r) p₁ +
        ∑ s : Fin (k - 1), taylor2D (fun q => H_pt q r s) p₁ * taylor2D (β_int s) p₁ = 0 := by
    intro r
    have hzero : taylor2D (fun q => R_grad q r + ∑ s : Fin (k - 1), H_pt q r s * β_int s q) p₁ =
        0 := by
      rw [hJet.taylor2D_congr hV'_open hp₁_Vp' (fun q hq => hβ_int_solve q hq r),
        hJet.taylor2D_const p₁ 0, map_zero]
    have hsum_h : DifferentiableOn ℂ
        (fun q => ∑ s : Fin (k - 1), H_pt q r s * β_int s q) V_plus' :=
      hsum_holo Finset.univ (fun s => fun q => H_pt q r s * β_int s q)
        (fun s _ => (hH_pt_holo r s).mul (hβ_int_holo s))
    rw [(hJet.taylor2D_ring hV'_open hp₁_Vp' (hR_grad_holo r) hsum_h).1,
      htaylor2D_sum Finset.univ (fun s => fun q => H_pt q r s * β_int s q)
        (fun s _ => (hH_pt_holo r s).mul (hβ_int_holo s))] at hzero
    have hmul_eq :
        (∑ s : Fin (k - 1), taylor2D (fun q => H_pt q r s * β_int s q) p₁) =
          ∑ s : Fin (k - 1), taylor2D (fun q => H_pt q r s) p₁ * taylor2D (β_int s) p₁ :=
      Finset.sum_congr rfl fun s _ =>
        (hJet.taylor2D_ring hV'_open hp₁_Vp' (hH_pt_holo r s) (hβ_int_holo s)).2.2
    rwa [hmul_eq] at hzero

  let M_ps : Matrix (Fin (k - 1)) (Fin (k - 1)) (MvPowerSeries (Fin 2) ℂ) :=
    fun r s => taylor2D (fun q => H_pt q r s) p₁
  let Δ_ps : Fin (k - 1) → MvPowerSeries (Fin 2) ℂ :=
    fun s => taylor2D (β_int s) p₁ - β_form_int s

  have hM_Δ : M_ps.mulVec Δ_ps = 0 := by
    funext r
    change (∑ s : Fin (k - 1), M_ps r s * (taylor2D (β_int s) p₁ - β_form_int s)) = 0
    simp_rw [mul_sub, Finset.sum_sub_distrib]
    linear_combination (hβ_int_ps_eq r) - (hformal_hess r)

  have hadj_zero : M_ps.det • Δ_ps = 0 := by
    calc M_ps.det • Δ_ps
        = (M_ps.det •
            (1 : Matrix (Fin (k - 1)) (Fin (k - 1)) (MvPowerSeries (Fin 2) ℂ))).mulVec Δ_ps := by
            rw [Matrix.smul_mulVec, Matrix.one_mulVec]
      _ = (M_ps.adjugate * M_ps).mulVec Δ_ps := by rw [Matrix.adjugate_mul]
      _ = M_ps.adjugate.mulVec (M_ps.mulVec Δ_ps) := by rw [Matrix.mulVec_mulVec]
      _ = M_ps.adjugate.mulVec 0 := by rw [hM_Δ]
      _ = 0 := Matrix.mulVec_zero _

  have hdet_ps_unit : IsUnit M_ps.det := by
    rw [MvPowerSeries.isUnit_iff_constantCoeff, RingHom.map_det]
    have hmap_eq : MvPowerSeries.constantCoeff.mapMatrix M_ps = H_pt p₁ := by
      ext r s
      rw [RingHom.mapMatrix_apply, Matrix.map_apply]
      change iterDerivYT 0 0 (fun q => H_pt q r s) p₁ /
          (((0 : ℕ).factorial : ℂ) * ((0 : ℕ).factorial : ℂ)) = H_pt p₁ r s
      simp [iterDerivYT, iterDerivY]
    rw [hmap_eq]
    exact (hdet_ne' p₁ hp₁_Vp').isUnit

  have hβ_int_taylor : ∀ u : Fin (k - 1), taylor2D (β_int u) p₁ = β_form_int u := by
    intro u
    have hmul0 : M_ps.det * Δ_ps u = 0 := congr_fun hadj_zero u
    rw [mul_comm] at hmul0
    exact sub_eq_zero.mp (hdet_ps_unit.mul_left_eq_zero.mp hmul0)

  
  let β_top : Fin (k + 1) → ℂ × ℂ → ℂ := fun s =>
    if h : 0 < s.1 ∧ s.1 < k then β_int ⟨s.1 - 1, by omega⟩ else fun _ => 0
  let β' : Fin (J + 1 + 1) → Fin (k + 1) → ℂ × ℂ → ℂ := Fin.snoc S.β β_top

  have hβ_top_holo : ∀ r : Fin (k + 1), DifferentiableOn ℂ (β_top r) V_plus' := by
    intro r
    dsimp only [β_top]
    split_ifs
    · exact hβ_int_holo _
    · exact differentiableOn_const 0
  have hβ_top_end : ∀ q : ℂ × ℂ, β_top 0 q = 0 ∧ β_top (Fin.last k) q = 0 := by
    intro q
    dsimp only [β_top, Fin.val_zero, Fin.val_last]
    constructor <;> (split_ifs <;> first | rfl | omega)
  have hβ_top_int : ∀ (u : Fin (k - 1)) (q : ℂ × ℂ),
      β_top ⟨u.1 + 1, by have := u.2; omega⟩ q = β_int u q := by
    intro u q
    have hu : 0 < u.1 + 1 ∧ u.1 + 1 < k := by have := u.2; omega
    simp only [β_top, hu.1, hu.2, and_self, ↓reduceDIte]
    congr 2
  have hβ_top_taylor : ∀ r : Fin (k + 1),
      taylor2D (β_top r) p₁ = D_form.β_full (J + 1) r := by
    intro r
    dsimp only [β_top]
    split_ifs with hr
    · rw [hβ_int_taylor ⟨r.1 - 1, by omega⟩]
      dsimp only [β_form_int]
      congr 1
      ext
      dsimp only
      omega
    · rw [hJet.taylor2D_const p₁ 0, map_zero]
      by_cases hr0 : r.1 = 0
      · have hr_eq : r = 0 := Fin.ext hr0
        rw [hr_eq, (D_form.β_endpoints (J + 1) (by omega)).1]
      · have hrk : r.1 = k := by have := r.2; omega
        have hr_eq : r = Fin.last k := Fin.ext hrk
        rw [hr_eq, (D_form.β_endpoints (J + 1) (by omega)).2]

  refine ⟨{
    W_ψ := W_ψ'
    V_plus := V_plus'
    g := g'
    U_split := U_split'
    V_split := V_split'
    β := β'
    W_ψ_open := hW'_open
    W_ψ_preconn := hW'_preconn
    W_ψ_sub_W_F := hW'_sub_WF
    real_mem_W_ψ := hW'_real
    V_plus_open := hV'_open
    V_plus_preconn := hV'_preconn
    V_plus_sub := hV'_sub_U₀
    trapezoid_mem_V_plus := hV'_trap
    ψ_maps_W_ψ := hψ_maps_W'
    chord_ne_zero := hℓ_ne'
    hess_det_ne_zero := hdet_ne'
    g_holo := hg'_holo
    g_endpoints := hg'_endpoints
    g_lt_p := hg'_lt_p
    g_taylor := hg'_taylor
    UV_holo := hUV'_holo
    UV_lt_p := hUV'_lt_p
    UV_taylor := hUV'_taylor
    β_holo := by
      refine Fin.lastCases ?_ ?_
      · intro r
        simpa [β', Fin.snoc_last] using hβ_top_holo r
      · intro m r
        simpa [β', Fin.snoc_castSucc] using (S.β_holo m r).mono hV'_sub_S
    β_zero := by
      intro r q
      have h0_eq : (0 : Fin (J + 1 + 1)) = (0 : Fin (J + 1)).castSucc := rfl
      rw [h0_eq]
      simpa [β', Fin.snoc_castSucc] using S.β_zero r q
    β_endpoints := by
      refine Fin.lastCases ?_ ?_
      · intro q
        simpa [β', Fin.snoc_last] using hβ_top_end q
      · intro m q
        simpa [β', Fin.snoc_castSucc] using S.β_endpoints m q
    β_taylor := by
      refine Fin.lastCases ?_ ?_
      · intro r _
        simpa [β', Fin.snoc_last, Fin.val_last] using hβ_top_taylor r
      · intro m r hm
        simpa [β', Fin.snoc_castSucc, Fin.val_castSucc] using
          S.β_taylor m r (by simpa using hm)
    grad_jet_zero := by
      intro q hq r l hl1 hlJ1
      have hβ'_pt : (fun m s => β' m s q) =
          Fin.snoc (fun m s => S.β m s q) (fun s => β_top s q) := by
        funext m s
        refine Fin.lastCases ?_ ?_ m <;> simp [β', Fin.snoc_last, Fin.snoc_castSucc]
      have hβ_zt_pt : (fun m s => β_zero_top m s q) =
          Fin.snoc (fun m s => S.β m s q) (fun _ => 0) := by
        funext m s
        refine Fin.lastCases ?_ ?_ m <;> simp [β_zero_top, Fin.snoc_last, Fin.snoc_castSucc]
      by_cases hlJ : l ≤ J
      · have htrunc :=
          (hJet.epsJet_trunc_eq
            (ℓ₀ := fun i => G.ℓ_fn i q) (x₀ := fun s => G.x_fn s q)
            (β₁ := fun m s => S.β m s q) (β₂ := fun m s => β' m s q)
            (Nat.le_succ J) hl1 hlJ hW'_open (G.F_holo.mono hW'_sub_WF)
            (fun u m => (S.g_holo u m).mono hW'_sub_S) hg'_holo hg0_S hg'0
            (fun u m z _ => by
              change g' u m.castSucc z = S.g u m z
              simp [g', Fin.snoc_castSucc])
            (hℓ_ne' q hq) (hx_maps_W' q hq) (hℓ_sq' q hq)
            (fun s => S.β_zero s q)
            (fun s => by
              have h0_eq : (0 : Fin (J + 1 + 1)) = (0 : Fin (J + 1)).castSucc := rfl
              rw [h0_eq]
              simpa [β', Fin.snoc_castSucc] using S.β_zero s q)
            (fun m s => by
              change β' m.castSucc s q = S.β m s q
              simp [β', Fin.snoc_castSucc])).2 r
        rw [htrunc]
        exact S.grad_jet_zero q (hV'_sub_S hq) r l hl1 hlJ
      · obtain rfl : l = J + 1 := by omega
        have hsplit :=
          (hJet.epsJet_succ_split
            (ℓ₀ := fun i => G.ℓ_fn i q) (x₀ := fun s => G.x_fn s q)
            (β := fun m s => S.β m s q) (β_top := fun s => β_top s q)
            hk hW'_open (G.F_holo.mono hW'_sub_WF)
            (fun u m => (S.g_holo u m).mono hW'_sub_S)
            (fun u => (hg_top_holo u).mono hW'_sub_new)
            hg0_S hg_top_end (hℓ_ne' q hq) (hx_maps_W' q hq) (hℓ_sq' q hq)
            (fun s => S.β_zero s q) (hβ_top_end q)).2 r
        rw [hβ'_pt, hsplit, ← hβ_zt_pt]
        have hsum_eq :
            (∑ s : Fin (k - 1), H_pt q r s * β_top ⟨s.1 + 1, by have := s.2; omega⟩ q) =
              ∑ s : Fin (k - 1), H_pt q r s * β_int s q :=
          Finset.sum_congr rfl fun s _ => by rw [hβ_top_int s q]
        change R_grad q r +
            ∑ s : Fin (k - 1), H_pt q r s * β_top ⟨s.1 + 1, by have := s.2; omega⟩ q = 0
        rw [hsum_eq]
        exact hβ_int_solve q hq r
    len_jet_split := by
      intro q hq
      have hβ'_pt : (fun m s => β' m s q) =
          Fin.snoc (fun m s => S.β m s q) (fun s => β_top s q) := by
        funext m s
        refine Fin.lastCases ?_ ?_ m <;> simp [β', Fin.snoc_last, Fin.snoc_castSucc]
      refine Fin.lastCases ?_ ?_
      · intro _
        have hsplit :=
          (hJet.epsJet_succ_split
            (ℓ₀ := fun i => G.ℓ_fn i q) (x₀ := fun s => G.x_fn s q)
            (β := fun m s => S.β m s q) (β_top := fun s => β_top s q)
            hk hW'_open (G.F_holo.mono hW'_sub_WF)
            (fun u m => (S.g_holo u m).mono hW'_sub_S)
            (fun u => (hg_top_holo u).mono hW'_sub_new)
            hg0_S hg_top_end (hℓ_ne' q hq) (hx_maps_W' q hq) (hℓ_sq' q hq)
            (fun s => S.β_zero s q) (hβ_top_end q)).1
        simp only [Fin.val_last, U_split', V_split', Fin.snoc_last]
        rw [hβ'_pt, hsplit]
        have hstat_zero :
            (∑ r : Fin (k - 1),
              pointRelInteriorGrad (fun i => G.ℓ_fn i q) (fun _ => G.F) (fun _ => deriv G.F)
                (fun s => G.x_fn s q) r *
                β_top ⟨r.1 + 1, by have := r.2; omega⟩ q) = 0 := by
          refine Finset.sum_eq_zero fun r _ => ?_
          rw [G.stationary_on_nondeg q (hV'_sub_U₀ hq) (hℓ_ne' q hq) r, zero_mul]
        rw [hstat_zero, add_zero]
        exact hweb_split q (hV'_sub_new hq)
      · intro m hm
        have hm1 : 1 ≤ (m : ℕ) := by simpa using hm
        have hmJ : (m : ℕ) ≤ J := by have := m.2; omega
        have htrunc :=
          (hJet.epsJet_trunc_eq
            (ℓ₀ := fun i => G.ℓ_fn i q) (x₀ := fun s => G.x_fn s q)
            (β₁ := fun m s => S.β m s q) (β₂ := fun m s => β' m s q)
            (Nat.le_succ J) hm1 hmJ hW'_open (G.F_holo.mono hW'_sub_WF)
            (fun u m => (S.g_holo u m).mono hW'_sub_S) hg'_holo hg0_S hg'0
            (fun u m z _ => by
              change g' u m.castSucc z = S.g u m z
              simp [g', Fin.snoc_castSucc])
            (hℓ_ne' q hq) (hx_maps_W' q hq) (hℓ_sq' q hq)
            (fun s => S.β_zero s q)
            (fun s => by
              have h0_eq : (0 : Fin (J + 1 + 1)) = (0 : Fin (J + 1)).castSucc := rfl
              rw [h0_eq]
              simpa [β', Fin.snoc_castSucc] using S.β_zero s q)
            (fun m s => by
              change β' m.castSucc s q = S.β m s q
              simp [β', Fin.snoc_castSucc])).1
        simp only [Fin.val_castSucc, U_split', V_split', Fin.snoc_castSucc]
        rw [htrunc]
        exact S.len_jet_split q (hV'_sub_S hq) m hm1
  }, by
    intro r m
    change g' r m.castSucc = S.g r m
    simp [g', Fin.snoc_castSucc]⟩

theorem point_formal_arc_web_continuation (Ω : Set Plane)
    (C : AnalyticGlancingCollar Ω)
    (B : BaseCollarAndCramerData C)
    (k : ℕ) (hk : 2 ≤ k)
    (G : PointGlancingChartData C B k)
    (a₁ δ₁ : ℝ)
    (ha₁ : a₁ ∈ Set.Ioo (G.a₀ - G.R / 4) (G.a₀ + G.R / 4))
    (hδ₁ : δ₁ ∈ Set.Ioo 0 G.δ_star)
    (E : PointCoreEliminationData C B k G a₁ δ₁)
    (hAlg : AlgebraicLiftingToolkit)
    (hWeb : FiniteWebContinuationProp)
    (hNonAlg : ∃ r : Fin E.N_core, ¬ IsAlgebraic (↥(pointBaseField C k G.Ψ a₁ δ₁)) (E.coreTuple r)) :
    Nonempty (PointContinuedDeformationData C B k G a₁ δ₁) :=
by
  have hJet : PointArcJetAndTaylorToolkit :=
    point_arc_jet_and_taylor_toolkit B.iterDerivYT_holo
  obtain ⟨D_form⟩ :=
    point_arc_formal_recentered_system Ω C B k hk G a₁ δ₁ ha₁ hδ₁ E hAlg hJet hNonAlg
  let p₁ : ℂ × ℂ := ((a₁ : ℂ), (δ₁ : ℂ))
  let U₀ : Set (ℂ × ℂ) := G.U_a ×ˢ G.U_d
  have hU₀_open : IsOpen U₀ := Metric.isOpen_ball.prod Metric.isOpen_ball
  have hq₁_trap : (a₁, δ₁) ∈ webTrapezoid G.a₀ G.R G.δ_star G.C₀ := by
    refine ⟨hδ₁.1, hδ₁.2, ?_⟩
    have ha₁_abs : |a₁ - G.a₀| < G.R / 4 :=
      abs_lt.mpr ⟨by linarith [ha₁.1], by linarith [ha₁.2]⟩
    have hCδ : G.C₀ * δ₁ < G.C₀ * G.δ_star := mul_lt_mul_of_pos_left hδ₁.2 G.C₀_pos
    linarith [G.C₀_δ_star_lt, G.R_pos]
  have htrap_sub_U₀ : ∀ q ∈ webTrapezoid G.a₀ G.R G.δ_star G.C₀,
      ((q.1 : ℂ), (q.2 : ℂ)) ∈ U₀ := by
    intro q hq
    refine ⟨?_, ?_⟩
    · rw [PointGlancingChartData.U_a, Metric.mem_ball, Complex.dist_eq, ← Complex.ofReal_sub,
        Complex.norm_real, Real.norm_eq_abs]
      have hpos : 0 < G.C₀ * q.2 := mul_pos G.C₀_pos hq.1
      linarith [hq.2.2, G.R_pos]
    · rw [PointGlancingChartData.U_d, Metric.mem_ball, dist_zero_right, Complex.norm_real,
        Real.norm_eq_abs, abs_of_pos hq.1]
      linarith [hq.2.1, G.δ_star_pos]
  have hp₁_U₀ : p₁ ∈ U₀ := htrap_sub_U₀ (a₁, δ₁) hq₁_trap
  have hF'_holo : DifferentiableOn ℂ (deriv G.F) G.W_F := G.F_holo.deriv G.W_F_open
  have hF''_holo : DifferentiableOn ℂ (deriv (deriv G.F)) G.W_F := hF'_holo.deriv G.W_F_open
  let U_ell : Set (ℂ × ℂ) :=
    U₀ ∩ ⋂ i : Fin k, U₀ ∩ (G.ℓ_fn i) ⁻¹' ({(0 : ℂ)}ᶜ)
  have hU_ell_open : IsOpen U_ell := by
    refine hU₀_open.inter (isOpen_iInter_of_finite fun i => ?_)
    exact ((G.ℓ_holo_sq i).1.continuousOn).isOpen_inter_preimage hU₀_open isOpen_compl_singleton
  have hU_ell_sub : U_ell ⊆ U₀ := Set.inter_subset_left
  have hU_ell_ne : ∀ q ∈ U_ell, ∀ i : Fin k, G.ℓ_fn i q ≠ 0 := by
    intro q hq i
    have hi := Set.mem_iInter.mp hq.2 i
    exact hi.2
  have hH_entry_cont : ∀ r s : Fin (k - 1),
      ContinuousOn
        (fun q : ℂ × ℂ =>
          pointInteriorHess (fun i => G.ℓ_fn i q) G.F (deriv G.F) (deriv (deriv G.F))
            (fun u => G.x_fn u q) r s)
        U_ell := by
    intro r s
    have hx_cont : ∀ u : Fin (k + 1), ContinuousOn (G.x_fn u) U_ell :=
      fun u => ((G.x_holo_maps u).1.mono hU_ell_sub).continuousOn
    have hx_maps : ∀ u : Fin (k + 1), Set.MapsTo (G.x_fn u) U_ell G.W_F :=
      fun u _ hq => ((G.x_holo_maps u).2 _ (hU_ell_sub hq)).1
    have hFx : ∀ u : Fin (k + 1), ContinuousOn (fun q => G.F (G.x_fn u q)) U_ell :=
      fun u => G.F_holo.continuousOn.comp (hx_cont u) (hx_maps u)
    have hF'x : ∀ u : Fin (k + 1),
        ContinuousOn (fun q => deriv G.F (G.x_fn u q)) U_ell :=
      fun u => hF'_holo.continuousOn.comp (hx_cont u) (hx_maps u)
    have hF''x : ∀ u : Fin (k + 1),
        ContinuousOn (fun q => deriv (deriv G.F) (G.x_fn u q)) U_ell :=
      fun u => hF''_holo.continuousOn.comp (hx_cont u) (hx_maps u)
    have hℓ_cont : ∀ i : Fin k, ContinuousOn (G.ℓ_fn i) U_ell :=
      fun i => ((G.ℓ_holo_sq i).1.mono hU_ell_sub).continuousOn
    let i_L : Fin k := ⟨r.1, by have := r.2; omega⟩
    let i_R : Fin k := ⟨r.1 + 1, by have := r.2; omega⟩
    have hdiv3 : ∀ {num : ℂ × ℂ → ℂ} (i : Fin k),
        ContinuousOn num U_ell →
        ContinuousOn (fun q => num q / (G.ℓ_fn i q) ^ 3) U_ell := by
      intro num i hnum
      have hinv : ContinuousOn (fun q => ((G.ℓ_fn i q) ^ 3)⁻¹) U_ell :=
        ((hℓ_cont i).pow 3).inv₀ (fun q hq => pow_ne_zero 3 (hU_ell_ne q hq i))
      exact (hnum.mul hinv).congr (fun q _ => div_eq_mul_inv (num q) ((G.ℓ_fn i q) ^ 3))
    have hΔx_L : ContinuousOn (fun q => G.x_fn i_L.succ q - G.x_fn i_L.castSucc q) U_ell :=
      (hx_cont i_L.succ).sub (hx_cont i_L.castSucc)
    have hΔY_L : ContinuousOn
        (fun q => G.F (G.x_fn i_L.succ q) - G.F (G.x_fn i_L.castSucc q)) U_ell :=
      (hFx i_L.succ).sub (hFx i_L.castSucc)
    have hn_L_succ : ContinuousOn
        (fun q => (G.x_fn i_L.succ q - G.x_fn i_L.castSucc q) +
          (G.F (G.x_fn i_L.succ q) - G.F (G.x_fn i_L.castSucc q)) *
            deriv G.F (G.x_fn i_L.succ q)) U_ell :=
      hΔx_L.add (hΔY_L.mul (hF'x i_L.succ))
    have hn_L_cast : ContinuousOn
        (fun q => (G.x_fn i_L.succ q - G.x_fn i_L.castSucc q) +
          (G.F (G.x_fn i_L.succ q) - G.F (G.x_fn i_L.castSucc q)) *
            deriv G.F (G.x_fn i_L.castSucc q)) U_ell :=
      hΔx_L.add (hΔY_L.mul (hF'x i_L.castSucc))
    have hΔx_R : ContinuousOn (fun q => G.x_fn i_R.succ q - G.x_fn i_R.castSucc q) U_ell :=
      (hx_cont i_R.succ).sub (hx_cont i_R.castSucc)
    have hΔY_R : ContinuousOn
        (fun q => G.F (G.x_fn i_R.succ q) - G.F (G.x_fn i_R.castSucc q)) U_ell :=
      (hFx i_R.succ).sub (hFx i_R.castSucc)
    have hn_R_cast : ContinuousOn
        (fun q => (G.x_fn i_R.succ q - G.x_fn i_R.castSucc q) +
          (G.F (G.x_fn i_R.succ q) - G.F (G.x_fn i_R.castSucc q)) *
            deriv G.F (G.x_fn i_R.castSucc q)) U_ell :=
      hΔx_R.add (hΔY_R.mul (hF'x i_R.castSucc))
    have hn_R_succ : ContinuousOn
        (fun q => (G.x_fn i_R.succ q - G.x_fn i_R.castSucc q) +
          (G.F (G.x_fn i_R.succ q) - G.F (G.x_fn i_R.castSucc q)) *
            deriv G.F (G.x_fn i_R.succ q)) U_ell :=
      hΔx_R.add (hΔY_R.mul (hF'x i_R.succ))
    unfold pointInteriorHess
    dsimp only
    split_ifs
    · refine ContinuousOn.add (hdiv3 i_L ?_) (hdiv3 i_R ?_)
      · exact (((continuousOn_const.add ((hF'x i_L.succ).pow 2)).add
          (hΔY_L.mul (hF''x i_L.succ))).mul ((hℓ_cont i_L).pow 2)).sub (hn_L_succ.pow 2)
      · exact (((continuousOn_const.add ((hF'x i_R.castSucc).pow 2)).sub
          (hΔY_R.mul (hF''x i_R.castSucc))).mul ((hℓ_cont i_R).pow 2)).sub (hn_R_cast.pow 2)
    · refine hdiv3 i_R ?_
      exact ((continuousOn_const.sub ((hF'x i_R.succ).mul (hF'x i_R.castSucc))).mul
        ((hℓ_cont i_R).pow 2)).add (hn_R_cast.mul hn_R_succ)
    · refine hdiv3 i_L ?_
      exact ((continuousOn_const.sub ((hF'x i_L.castSucc).mul (hF'x i_L.succ))).mul
        ((hℓ_cont i_L).pow 2)).add (hn_L_succ.mul hn_L_cast)
    · exact continuousOn_const
  let hessDet : ℂ × ℂ → ℂ := fun q =>
    (pointInteriorHess (fun i => G.ℓ_fn i q) G.F (deriv G.F) (deriv (deriv G.F))
      (fun u => G.x_fn u q)).det
  have hhessDet_cont : ContinuousOn hessDet U_ell := by
    have hfun : hessDet = fun q =>
        ∑ σ : Equiv.Perm (Fin (k - 1)),
          ((Equiv.Perm.sign σ : ℤ) : ℂ) *
            ∏ i : Fin (k - 1),
              pointInteriorHess (fun i => G.ℓ_fn i q) G.F (deriv G.F) (deriv (deriv G.F))
                (fun u => G.x_fn u q) (σ i) i := by
      ext q
      simp only [hessDet, Matrix.det_apply, Units.smul_def, zsmul_eq_mul]
    rw [hfun]
