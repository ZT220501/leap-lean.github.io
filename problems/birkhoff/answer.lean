          compPowerSeries2D (PowerSeries.derivative ((psDeriv^[k]) g)) (centeredTaylor2D (ψ i) p₁) = _
      rw [hmvΨ.2, hpD_sub]
  have hjet : ∀ (i : Fin m) {p₁ : ℂ × ℂ}, p₁ ∈ U_inter →
      ∀ (g : PowerSeries ℂ) (α β : ℕ),
      (mvDerivD^[β]) ((mvDerivA^[α])
        (taylor2D (w i) p₁ * compPowerSeries2D g (centeredTaylor2D (ψ i) p₁))) =
      ∑ k ∈ Finset.range (α + β + 1),
        taylor2D (webDiffCoeff (pderivA (ψ i)) (pderivD (ψ i)) (w i) α β k) p₁ *
