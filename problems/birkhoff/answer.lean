      have hh_tendsto : Filter.Tendsto h_seq Filter.atTop (nhdsWithin (0 : ℂ) {(0 : ℂ)}ᶜ) := by
        rw [tendsto_nhdsWithin_iff]
        refine ⟨?_, Filter.Eventually.of_forall (fun n => hh_ne n)⟩
        have ht_real : Filter.Tendsto (fun n : ℕ => ((1 : ℝ) / ((n : ℝ) + 1)) * (r / 2))
            Filter.atTop (nhds 0) := by
          simpa using tendsto_one_div_add_atTop_nhds_zero_nat.mul_const (r / 2)
        have ht_comp := Complex.continuous_ofReal.continuousAt.tendsto.comp ht_real
        rw [Complex.ofReal_zero] at ht_comp
        exact ht_comp
      let g_seq : ℕ → ℝ → ((ℂ × ℂ) →L[ℂ] ℂ) := fun n μ =>
        ((h_seq n)⁻¹ * (Φ μ (p₀.1 + h_seq n, p₀.2) - Φ μ p₀)) •
          ContinuousLinearMap.fst ℂ ℂ ℂ +
        ((h_seq n)⁻¹ * (Φ μ (p₀.1, p₀.2 + h_seq n) - Φ μ p₀)) •
          ContinuousLinearMap.snd ℂ ℂ ℂ
      have hg_meas : ∀ n : ℕ, MeasureTheory.AEStronglyMeasurable (g_seq n) μ₀ := by
        intro n
        have hp1_out : (p₀.1 + h_seq n, p₀.2) ∈ W_out := by
          apply hball2_sub
          rw [Metric.mem_ball, Prod.dist_eq, max_lt_iff]
          refine ⟨?_, by simp; linarith⟩
          simpa [dist_eq_norm] using hh_norm n
        have hp2_out : (p₀.1, p₀.2 + h_seq n) ∈ W_out := by
          apply hball2_sub
          rw [Metric.mem_ball, Prod.dist_eq, max_lt_iff]
