        have hH_pref : shcbWalkDependsOnPrefix n H_mn := by
          have han : shcbWalkDependsOnPrefix n (fun om => (a n om : ℂ)) :=
            hPrefComp Complex.continuous_ofReal.measurable (ha_pref n hn_lt)
          have ham : shcbWalkDependsOnPrefix n (fun om => (a m om : ℂ)) :=
            hPrefMono hmn.le (hPrefComp Complex.continuous_ofReal.measurable (ha_pref m hm_lt))
          have hΔm : shcbWalkDependsOnPrefix n (fun om => starRingEnd ℂ (Δ m om)) :=
            hPrefMono hmn
              (hPrefComp Complex.continuous_conj.measurable
                (hPrefPair measurable_sub (hImpactPref i (m + 1))
                  (hPrefMono (Nat.le_succ m) (hImpactPref i m))))
