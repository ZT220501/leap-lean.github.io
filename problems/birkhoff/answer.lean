        rw [heq] at hH_sq_diff_raw
        apply hJet.jet_mono le_rfl _ hH_sq_diff_raw
        have h_num : (2 : ℝ) ^ p * (2 * R₀ / (q : ℝ) ^ 2 * Δ) * (2 * (Real.pi + 1) / (q : ℝ)) =
            (((2 : ℝ) ^ p * (4 * R₀) * (Real.pi + 1)) / (q : ℝ) ^ 3) * Δ := by ring
        rw [h_num]
        apply mul_le_mul_of_nonneg_right _ hΔ
        apply div_le_div_of_nonneg_right _ (pow_nonneg hq_pos.le 3)
        dsimp [C_H2_val]
        have : 0 ≤ (2 : ℝ) ^ p * (Real.pi + 1) ^ 2 +
            (2 : ℝ) ^ p * (2 * R₀) * (2 * Real.pi + 1) := by positivity
        linarith
