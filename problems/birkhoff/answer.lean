    have hVol_G₂_lt : MeasureTheory.volume G₂ < ⊤ :=
      lt_of_le_of_lt (MeasureTheory.measure_mono (fun ζ hζ => hζ.1)) (hBall_lt_top _ _)
    have hCheb_pt : ∀ ζ ∈ 𝒟₂, (h₀ ^ (2 : ℕ) / 36) * B₂.indicator (fun _ => (1 : ℝ)) ζ ≤
        (localAmp S ζ - W ζ) ^ (2 : ℕ) := by
      intro ζ hζ
      by_cases hζB : ζ ∈ B₂
      · simp only [hζB, Set.indicator_of_mem, mul_one]
        have hW_gt : h₀ / 2 < |W ζ| := hζB.2
