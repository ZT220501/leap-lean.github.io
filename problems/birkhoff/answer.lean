            Complex.I * (w * circleMap 0 1 θ / (1 - w * circleMap 0 1 θ)) := by
        intro θ; ring
      simp_rw [h_congr, intervalIntegral.integral_const_mul] at hz
      exact (mul_eq_zero.mp hz).resolve_left Complex.I_ne_zero

    have h_cont_k1 : Continuous (fun θ : ℝ => circleMap 0 1 θ / (circleMap 0 1 θ - ζ)) :=
      (continuous_circleMap 0 1).div ((continuous_circleMap 0 1).sub continuous_const) h_sub_ne
    have h_cont_k2 : Continuous (fun θ : ℝ => w * circleMap 0 1 θ / (1 - w * circleMap 0 1 θ)) :=
      (continuous_const.mul (continuous_circleMap 0 1)).div
        (continuous_const.sub (continuous_const.mul (continuous_circleMap 0 1))) h_one_sub_ne
    have h_P_mass : (∫ θ in (0 : ℝ)..(2 * Real.pi), P_ζ θ) = 2 * Real.pi := by
      have hsum :
          (∫ θ in (0 : ℝ)..(2 * Real.pi), ((P_ζ θ : ℝ) : ℂ)) = ((2 * Real.pi : ℝ) : ℂ) := by
        have hadd := (intervalIntegral.integral_add
          (h_cont_k1.intervalIntegrable (μ := MeasureTheory.volume) 0 (2 * Real.pi))
          (h_cont_k2.intervalIntegrable (μ := MeasureTheory.volume) 0 (2 * Real.pi))).symm
        simp_rw [h_kernel_eq] at hadd
        rw [← hadd, h_int_1, h_int_2, add_zero]
        push_cast; rfl
      rw [intervalIntegral.integral_ofReal] at hsum
      exact Complex.ofReal_injective hsum

    have hFa_cont : Continuous (fun θ : ℝ => F (a, circleMap 0 1 θ)) :=
      hF_holo.continuousOn.comp_continuous
        (continuous_const.prodMk (continuous_circleMap 0 1))
        (fun θ => ⟨ha, h_sphere_in_Aζ _ (circleMap_mem_sphere 0 zero_le_one θ)⟩)

    have hFtilde_poisson :
        F_tilde (a, ζ) =
          (((2 * Real.pi)⁻¹ : ℝ) : ℂ) *
            ∫ θ in (0 : ℝ)..(2 * Real.pi), F (a, circleMap 0 1 θ) * ((P_ζ θ : ℝ) : ℂ) := by
      have hJ0 : J_hat (a, w) = 0 := hJhat_zero a ha w hw_ball
      calc
        F_tilde (a, ζ) = F_tilde (a, ζ) + J_hat (a, w) := by rw [hJ0, add_zero]
        _ = (((2 * Real.pi)⁻¹ : ℝ) : ℂ) *
              ((∫ θ in (0 : ℝ)..(2 * Real.pi),
                  F (a, circleMap 0 1 θ) * circleMap 0 1 θ / (circleMap 0 1 θ - ζ)) +
                (∫ θ in (0 : ℝ)..(2 * Real.pi),
                  F (a, circleMap 0 1 θ) *
                    (w * circleMap 0 1 θ / (1 - w * circleMap 0 1 θ)))) := by
            dsimp [F_tilde, J_hat]; ring
        _ = (((2 * Real.pi)⁻¹ : ℝ) : ℂ) *
              ∫ θ in (0 : ℝ)..(2 * Real.pi),
                (F (a, circleMap 0 1 θ) * circleMap 0 1 θ / (circleMap 0 1 θ - ζ) +
                  F (a, circleMap 0 1 θ) *
                    (w * circleMap 0 1 θ / (1 - w * circleMap 0 1 θ))) := by
            congr 1
            have hi1 : Continuous
                (fun θ : ℝ => F (a, circleMap 0 1 θ) * circleMap 0 1 θ / (circleMap 0 1 θ - ζ)) :=
              (hFa_cont.mul (continuous_circleMap 0 1)).div
                ((continuous_circleMap 0 1).sub continuous_const) h_sub_ne
            exact (intervalIntegral.integral_add
              (hi1.intervalIntegrable 0 (2 * Real.pi))
              ((hFa_cont.mul h_cont_k2).intervalIntegrable 0 (2 * Real.pi))).symm
        _ = (((2 * Real.pi)⁻¹ : ℝ) : ℂ) *
              ∫ θ in (0 : ℝ)..(2 * Real.pi), F (a, circleMap 0 1 θ) * ((P_ζ θ : ℝ) : ℂ) := by
            congr 1
            refine intervalIntegral.integral_congr fun θ _ => ?_
            calc
              F (a, circleMap 0 1 θ) * circleMap 0 1 θ / (circleMap 0 1 θ - ζ) +
                  F (a, circleMap 0 1 θ) * (w * circleMap 0 1 θ / (1 - w * circleMap 0 1 θ)) =
                F (a, circleMap 0 1 θ) *
                  (circleMap 0 1 θ / (circleMap 0 1 θ - ζ) +
                    w * circleMap 0 1 θ / (1 - w * circleMap 0 1 θ)) := by ring
              _ = F (a, circleMap 0 1 θ) * ((P_ζ θ : ℝ) : ℂ) := by rw [h_kernel_eq θ]

    have hFP_int : IntervalIntegrable
        (fun θ : ℝ => F (a, circleMap 0 1 θ) * ((P_ζ θ : ℝ) : ℂ))
        MeasureTheory.volume 0 (2 * Real.pi) :=
      (hFa_cont.mul (Complex.continuous_ofReal.comp hP_cont)).intervalIntegrable 0 (2 * Real.pi)
    have hFtilde_im :
        (F_tilde (a, ζ)).im =
          (2 * Real.pi)⁻¹ *
            ∫ θ in (0 : ℝ)..(2 * Real.pi), (F (a, circleMap 0 1 θ)).im * P_ζ θ := by
      rw [hFtilde_poisson, Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im, zero_mul, add_zero]
      congr 1
      have hcomm := (ContinuousLinearMap.intervalIntegral_comp_comm Complex.imCLM hFP_int).symm
      change Complex.imCLM (∫ θ in (0 : ℝ)..(2 * Real.pi),
        F (a, circleMap 0 1 θ) * ((P_ζ θ : ℝ) : ℂ)) = _
      rw [hcomm]
      refine intervalIntegral.integral_congr fun θ _ => ?_
      change (F (a, circleMap 0 1 θ) * ((P_ζ θ : ℝ) : ℂ)).im = _
      simp [Complex.mul_im]

    have h_nonempty_Icc : (Set.Icc (0 : ℝ) (2 * Real.pi)).Nonempty :=
      ⟨0, Set.left_mem_Icc.mpr Real.two_pi_pos.le⟩
    have h_abs_im_cont : Continuous (fun θ : ℝ => |(F (a, circleMap 0 1 θ)).im|) :=
      continuous_abs.comp (Complex.continuous_im.comp hFa_cont)
    obtain ⟨θ_star, _, hθ_max⟩ :=
      isCompact_Icc.exists_isMaxOn h_nonempty_Icc h_abs_im_cont.continuousOn
    let M_a : ℝ := |(F (a, circleMap 0 1 θ_star)).im|
    have hMa_lt : M_a < S.H :=
      hF_strip (a, circleMap 0 1 θ_star)
        ⟨ha, h_sphere_in_Aζ _ (circleMap_mem_sphere 0 zero_le_one θ_star)⟩
    have h_prod_cont : Continuous (fun θ : ℝ => |(F (a, circleMap 0 1 θ)).im * P_ζ θ|) :=
      continuous_abs.comp ((Complex.continuous_im.comp hFa_cont).mul hP_cont)
    have h_mono :
        (∫ θ in (0 : ℝ)..(2 * Real.pi), |(F (a, circleMap 0 1 θ)).im * P_ζ θ|) ≤
          ∫ θ in (0 : ℝ)..(2 * Real.pi), M_a * P_ζ θ := by
      refine intervalIntegral.integral_mono_on Real.two_pi_pos.le
        (h_prod_cont.intervalIntegrable 0 (2 * Real.pi))
        ((continuous_const.mul hP_cont).intervalIntegrable 0 (2 * Real.pi)) ?_
      intro θ hθ
      rw [abs_mul, abs_of_nonneg (hP_nonneg θ)]
      exact mul_le_mul_of_nonneg_right (hθ_max hθ) (hP_nonneg θ)
    have h_inv_pos : 0 < (2 * Real.pi)⁻¹ := inv_pos.mpr Real.two_pi_pos
    change |(F_tilde (a, ζ)).im| < S.H
    rw [hFtilde_im, abs_mul, abs_of_pos h_inv_pos]
    have h_abs_int :
        |∫ θ in (0 : ℝ)..(2 * Real.pi), (F (a, circleMap 0 1 θ)).im * P_ζ θ| ≤
          M_a * (2 * Real.pi) := by
      calc
        |∫ θ in (0 : ℝ)..(2 * Real.pi), (F (a, circleMap 0 1 θ)).im * P_ζ θ|
          ≤ ∫ θ in (0 : ℝ)..(2 * Real.pi), |(F (a, circleMap 0 1 θ)).im * P_ζ θ| :=
            intervalIntegral.abs_integral_le_integral_abs Real.two_pi_pos.le
        _ ≤ ∫ θ in (0 : ℝ)..(2 * Real.pi), M_a * P_ζ θ := h_mono
        _ = M_a * ∫ θ in (0 : ℝ)..(2 * Real.pi), P_ζ θ := intervalIntegral.integral_const_mul _ _
        _ = M_a * (2 * Real.pi) := by rw [h_P_mass]
    have h_scaled :
        (2 * Real.pi)⁻¹ *
            |∫ θ in (0 : ℝ)..(2 * Real.pi), (F (a, circleMap 0 1 θ)).im * P_ζ θ| ≤ M_a := by
      calc
        (2 * Real.pi)⁻¹ *
            |∫ θ in (0 : ℝ)..(2 * Real.pi), (F (a, circleMap 0 1 θ)).im * P_ζ θ|
          ≤ (2 * Real.pi)⁻¹ * (M_a * (2 * Real.pi)) :=
            mul_le_mul_of_nonneg_left h_abs_int h_inv_pos.le
        _ = M_a := by field_simp [Real.two_pi_pos.ne']
    exact lt_of_le_of_lt h_scaled hMa_lt

  
  let ε : ℝ := (1 / 8 : ℝ) * min S.s_star (min r η)
  have hε_pos : 0 < ε := by
    dsimp [ε]
    exact mul_pos (by norm_num) (lt_min S.s_star_pos (lt_min hr_pos hη_pos))
  have hε_lt_s_star : ε < S.s_star := by
    have hle : min S.s_star (min r η) ≤ S.s_star := min_le_left _ _
    dsimp [ε]; linarith [S.s_star_pos]
  have hε_le_r : 8 * ε ≤ r := by
    have hle : min S.s_star (min r η) ≤ r := le_trans (min_le_right _ _) (min_le_left _ _)
    dsimp [ε]; linarith
  have hε_le_η : 8 * ε ≤ η := by
    have hle : min S.s_star (min r η) ≤ η := le_trans (min_le_right _ _) (min_le_right _ _)
    dsimp [ε]; linarith

  let ζ_map : ℂ → ℂ := fun t => (t - (t₀ : ℂ)) / (r : ℂ)
  let Φ_inv : ℂ × ℂ → ℂ × ℂ :=
    fun p => (p.1 + (η : ℂ) * Complex.I * (ζ_map p.2) ^ 2, ζ_map p.2)
  let g : ℂ × ℂ → ℂ := fun p => F_tilde (Φ_inv p)

  have hζ_map_diff : Differentiable ℂ ζ_map :=
    (differentiable_id.sub (differentiable_const _)).div_const (r : ℂ)
  have hΦ_inv_diff : Differentiable ℂ Φ_inv :=
    (differentiable_fst.add
      ((differentiable_const _).mul ((hζ_map_diff.comp differentiable_snd).pow 2))).prodMk
      (hζ_map_diff.comp differentiable_snd)

  have hΨ_Φ_inv : ∀ p : ℂ × ℂ, Ψ (Φ_inv p) = p := by
    intro p
    have hr_ne : (r : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hr_pos.ne'
    ext1
    · dsimp [Ψ, Φ_inv]; ring
    · dsimp [Ψ, Φ_inv, ζ_map]
      rw [mul_div_cancel₀ _ hr_ne, add_sub_cancel]

  have h_Φ_shift_norm : ∀ p : ℂ × ℂ, ‖p.2 - (t₀ : ℂ)‖ < ε →
      ‖ζ_map p.2‖ < 1 / 8 ∧ ‖(Φ_inv p).1 - p.1‖ < η / 64 := by
    intro p hp2
    have hζ_norm_eq : ‖ζ_map p.2‖ = ‖p.2 - (t₀ : ℂ)‖ / r := by
      dsimp [ζ_map]
      rw [norm_div, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hr_pos]
    have hζ_lt : ‖ζ_map p.2‖ < 1 / 8 := by
      rw [hζ_norm_eq, div_lt_iff₀ hr_pos]
      linarith
    refine ⟨hζ_lt, ?_⟩
    have hsub_eq : (Φ_inv p).1 - p.1 = (η : ℂ) * Complex.I * (ζ_map p.2) ^ 2 := by
      dsimp [Φ_inv]; ring
    rw [hsub_eq, norm_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hη_pos,
      Complex.norm_I, mul_one, norm_pow]
    have hsq : ‖ζ_map p.2‖ ^ 2 < 1 / 64 := by nlinarith [norm_nonneg (ζ_map p.2)]
    nlinarith

  let y_edge : ℂ := (x_edge : ℂ) + (h : ℂ) * Complex.I
  have h_Wε_maps : ∀ p : ℂ × ℂ,
      ‖p.1 - y_edge‖ < ε → ‖p.2 - (t₀ : ℂ)‖ < ε →
      Φ_inv p ∈ D_a ×ˢ Metric.ball (0 : ℂ) 1 := by
    intro p hp1 hp2
    obtain ⟨hζ_lt, hshift_lt⟩ := h_Φ_shift_norm p hp2
    have hdist_y : ‖(Φ_inv p).1 - y_edge‖ < η / 4 := by
      have htri : ‖(Φ_inv p).1 - y_edge‖ ≤ ‖(Φ_inv p).1 - p.1‖ + ‖p.1 - y_edge‖ := by
        simpa [sub_add_sub_cancel] using norm_add_le ((Φ_inv p).1 - p.1) (p.1 - y_edge)
      linarith
    have hre_diff : |(Φ_inv p).1.re - x_edge| ≤ ‖(Φ_inv p).1 - y_edge‖ := by
      have hre_eq : ((Φ_inv p).1 - y_edge).re = (Φ_inv p).1.re - x_edge := by
        simp [y_edge]
      rw [← hre_eq]
      exact Complex.abs_re_le_norm _
    have him_diff : |(Φ_inv p).1.im - h| ≤ ‖(Φ_inv p).1 - y_edge‖ := by
      have him_eq : ((Φ_inv p).1 - y_edge).im = (Φ_inv p).1.im - h := by
        simp [y_edge]
      rw [← him_eq]
      exact Complex.abs_im_le_norm _
    rcases abs_lt.mp (lt_of_le_of_lt him_diff hdist_y) with ⟨him_lo, him_hi⟩
    refine ⟨⟨lt_of_le_of_lt hre_diff (by linarith), by linarith, by linarith⟩, ?_⟩
    rw [Metric.mem_ball, dist_zero_right]
    exact lt_trans hζ_lt (by norm_num)

  have hg_Wε : DifferentiableOn ℂ g
      { p : ℂ × ℂ | ‖p.1 - y_edge‖ < ε ∧ ‖p.2 - (t₀ : ℂ)‖ < ε } :=
    hFtilde_holo.comp hΦ_inv_diff.differentiableOn (fun p hp => h_Wε_maps p hp.1 hp.2)

  have hg_strip_Wε : ∀ p : ℂ × ℂ,
      ‖p.1 - y_edge‖ < ε → ‖p.2 - (t₀ : ℂ)‖ < ε → g p ∈ horizStrip S.H :=
    fun p hp1 hp2 => hFtilde_strip (Φ_inv p) (h_Wε_maps p hp1 hp2)

  obtain ⟨r_patch, hr_patch_pos, hr_patch_le, hr_patch_hX⟩ :=
    h_lsc_radius (h - ε / 16) (by linarith)
  let δ : ℝ := min ε (r_patch / 2)
  have hδ_pos : 0 < δ := lt_min hε_pos (half_pos hr_patch_pos)
  have hδ_le_ε : δ ≤ ε := min_le_left _ _
  have hδ_lt_rpatch : δ < r_patch :=
    lt_of_le_of_lt (min_le_right _ _) (by linarith)

  let V_bridge : Set (ℂ × ℂ) :=
    { p : ℂ × ℂ |
      |p.1.re - x_edge| < η / 2 ∧
      h - (5 / 2 : ℝ) * η < p.1.im ∧
      p.1.im < h - ε / 8 ∧
      ‖p.2 - (t₀ : ℂ)‖ < δ }
  let V_seed : Set (ℂ × ℂ) :=
    { p : ℂ × ℂ |
      |p.1.re - x_edge| < η / 2 ∧
      h - (5 / 2 : ℝ) * η < p.1.im ∧
      p.1.im < h - 2 * η ∧
      ‖p.2 - (t₀ : ℂ)‖ < δ }

  have hVbridge_open : IsOpen V_bridge :=
    (isOpen_lt (continuous_abs.comp ((Complex.continuous_re.comp continuous_fst).sub continuous_const))
      continuous_const).inter
      ((isOpen_lt continuous_const (Complex.continuous_im.comp continuous_fst)).inter
        ((isOpen_lt (Complex.continuous_im.comp continuous_fst) continuous_const).inter
          (isOpen_lt (continuous_norm.comp (continuous_snd.sub continuous_const)) continuous_const)))
  have hVseed_open : IsOpen V_seed :=
    (isOpen_lt (continuous_abs.comp ((Complex.continuous_re.comp continuous_fst).sub continuous_const))
      continuous_const).inter
      ((isOpen_lt continuous_const (Complex.continuous_im.comp continuous_fst)).inter
        ((isOpen_lt (Complex.continuous_im.comp continuous_fst) continuous_const).inter
          (isOpen_lt (continuous_norm.comp (continuous_snd.sub continuous_const)) continuous_const)))

  let p₀ : ℂ × ℂ :=
    ((x_edge : ℂ) + ((h - (9 / 4 : ℝ) * η : ℝ) : ℂ) * Complex.I, (t₀ : ℂ))
  have hp₀_seed : p₀ ∈ V_seed := by
    refine ⟨?_, ?_, ?_, ?_⟩
    · simp [p₀, hη_pos]
    · simp [p₀]; linarith
    · simp [p₀]; linarith
    · simp [p₀, hδ_pos]
  have hp₀_bridge : p₀ ∈ V_bridge :=
    ⟨hp₀_seed.1, hp₀_seed.2.1, by linarith [hp₀_seed.2.2.1], hp₀_seed.2.2.2⟩

  have hVbridge_convex : Convex ℝ V_bridge := by
    intro p₁ hp₁ p₂ hp₂ u₁ u₂ hu₁ hu₂ hu
    have hre : (u₁ • p₁ + u₂ • p₂).1.re - x_edge =
        u₁ * (p₁.1.re - x_edge) + u₂ * (p₂.1.re - x_edge) := by
      have hu₂_eq : u₂ = 1 - u₁ := by linarith
      simp only [Prod.fst_add, Prod.smul_fst, Complex.add_re, Complex.real_smul, Complex.mul_re,
        Complex.ofReal_re, Complex.ofReal_im, zero_mul, sub_zero, hu₂_eq]
      ring
    have him : (u₁ • p₁ + u₂ • p₂).1.im = u₁ * p₁.1.im + u₂ * p₂.1.im := by
      simp [Complex.real_smul]
    rcases abs_lt.mp hp₁.1 with ⟨hp₁_re1, hp₁_re2⟩
    rcases abs_lt.mp hp₂.1 with ⟨hp₂_re1, hp₂_re2⟩
    have hre_bounds := h_conv_lt hu₁ hu₂ hu hp₁_re1 hp₁_re2 hp₂_re1 hp₂_re2
    have him_bounds := h_conv_lt hu₁ hu₂ hu hp₁.2.1 hp₁.2.2.1 hp₂.2.1 hp₂.2.2.1
    refine ⟨by rw [hre, abs_lt]; exact hre_bounds, by rw [him]; exact him_bounds.1,
      by rw [him]; exact him_bounds.2, ?_⟩
    have hu₂_eq : u₂ = 1 - u₁ := by linarith
    have hsub2 : (u₁ • p₁ + u₂ • p₂).2 - (t₀ : ℂ) =
        u₁ • (p₁.2 - (t₀ : ℂ)) + u₂ • (p₂.2 - (t₀ : ℂ)) := by
      simp only [Prod.snd_add, Prod.smul_snd, Complex.real_smul, hu₂_eq]
      push_cast
      ring
    rw [hsub2]
    have htri : ‖u₁ • (p₁.2 - (t₀ : ℂ)) + u₂ • (p₂.2 - (t₀ : ℂ))‖ ≤
        u₁ * ‖p₁.2 - (t₀ : ℂ)‖ + u₂ * ‖p₂.2 - (t₀ : ℂ)‖ := by
      refine le_trans (norm_add_le _ _) ?_
      rw [norm_smul, norm_smul, Real.norm_of_nonneg hu₁, Real.norm_of_nonneg hu₂]
    have hnorm_lt := (h_conv_lt hu₁ hu₂ hu (by linarith [norm_nonneg (p₁.2 - (t₀ : ℂ)), hδ_pos] : -δ < ‖p₁.2 - (t₀ : ℂ)‖)
      hp₁.2.2.2 (by linarith [norm_nonneg (p₂.2 - (t₀ : ℂ)), hδ_pos] : -δ < ‖p₂.2 - (t₀ : ℂ)‖) hp₂.2.2.2).2
    exact lt_of_le_of_lt htri hnorm_lt

  have hVbridge_maps_Φ : ∀ p ∈ V_bridge, Φ_inv p ∈ D_a ×ˢ Metric.ball (0 : ℂ) 1 := by
    intro p hp
    obtain ⟨hζ_lt, hshift_lt⟩ := h_Φ_shift_norm p (lt_of_lt_of_le hp.2.2.2 hδ_le_ε)
    have hre_le : |(Φ_inv p).1.re - p.1.re| ≤ ‖(Φ_inv p).1 - p.1‖ := by
      simpa using Complex.abs_re_le_norm ((Φ_inv p).1 - p.1)
    have him_le : |(Φ_inv p).1.im - p.1.im| ≤ ‖(Φ_inv p).1 - p.1‖ := by
      simpa using Complex.abs_im_le_norm ((Φ_inv p).1 - p.1)
    rcases abs_lt.mp (lt_of_le_of_lt hre_le hshift_lt) with ⟨hre1, hre2⟩
    rcases abs_lt.mp (lt_of_le_of_lt him_le hshift_lt) with ⟨him1, him2⟩
    rcases abs_lt.mp hp.1 with ⟨hp_re1, hp_re2⟩
    refine ⟨⟨?_, by linarith [hp.2.1], by linarith [hp.2.2.1, hε_pos]⟩, ?_⟩
    · rw [abs_lt]; constructor <;> linarith
    · rw [Metric.mem_ball, dist_zero_right]
      exact lt_trans hζ_lt (by norm_num)

  have hg_Vbridge : DifferentiableOn ℂ g V_bridge :=
    hFtilde_holo.comp hΦ_inv_diff.differentiableOn hVbridge_maps_Φ

  have hVbridge_tube : V_bridge ⊆ finiteWallTube S.r_star S.h_X := by
    intro p hp
    have ht_lt_rp : ‖p.2 - (t₀ : ℂ)‖ < r_patch := lt_trans hp.2.2.2 hδ_lt_rpatch
    exact h_mem_tube p (lt_of_lt_of_le ht_lt_rp hr_patch_le)
      (by linarith [hp.2.1, hη_lt_h])
      (by linarith [hp.2.2.1, hr_patch_hX p.2 ht_lt_rp, hε_pos])

  have h𝔰_Vbridge : DifferentiableOn ℂ S.𝔰 V_bridge :=
    S.𝔰_holo.mono hVbridge_tube

  have hg_eq_seed : ∀ p ∈ V_seed, g p = S.𝔰 p := by
    intro p hp
    obtain ⟨hζ_lt, hshift_lt⟩ := h_Φ_shift_norm p (lt_of_lt_of_le hp.2.2.2 hδ_le_ε)
    have hp_bridge : p ∈ V_bridge :=
      ⟨hp.1, hp.2.1, by linarith [hp.2.2.1, hε_le_η, hε_pos], hp.2.2.2⟩
    have hDa_mem : (Φ_inv p).1 ∈ D_a := (hVbridge_maps_Φ p hp_bridge).1
    have him_le : |(Φ_inv p).1.im - p.1.im| ≤ ‖(Φ_inv p).1 - p.1‖ := by
      simpa using Complex.abs_im_le_norm ((Φ_inv p).1 - p.1)
    have him_hi : (Φ_inv p).1.im - p.1.im < η / 64 :=
      (abs_lt.mp (lt_of_le_of_lt him_le hshift_lt)).2
    have h_in_low : (Φ_inv p).1 ∈ I_low :=
      ⟨hDa_mem.1, hDa_mem.2.1, by linarith [hp.2.2.1]⟩
    have h_in_ball : (Φ_inv p).2 ∈ Metric.ball (0 : ℂ) 1 :=
      (hVbridge_maps_Φ p hp_bridge).2
    change F_tilde (Φ_inv p) = S.𝔰 p
    rw [hFtilde_low (Φ_inv p).1 h_in_low (Φ_inv p).2 h_in_ball, hΨ_Φ_inv p]

  have hg_eq_bridge : ∀ p ∈ V_bridge, g p = S.𝔰 p := by
    intro p hp
    let γ : ℂ → ℂ × ℂ := fun z => p₀ + z • (p - p₀)
    have hγ_diff : Differentiable ℂ γ :=
      (differentiable_const p₀).add (differentiable_id.smul_const (p - p₀))
    have hγ0 : γ 0 = p₀ := by simp [γ]
    have hγ1 : γ 1 = p := by simp [γ]
    let U_z : Set ℂ := γ ⁻¹' V_bridge
    have hUz_open : IsOpen U_z := hVbridge_open.preimage hγ_diff.continuous
    have h0_Uz : (0 : ℂ) ∈ U_z := by show γ 0 ∈ V_bridge; rw [hγ0]; exact hp₀_bridge
    have h1_Uz : (1 : ℂ) ∈ U_z := by show γ 1 ∈ V_bridge; rw [hγ1]; exact hp
    have hUz_convex : Convex ℝ U_z := by
      intro z₁ hz₁ z₂ hz₂ u₁ u₂ hu₁ hu₂ hu
      show γ (u₁ • z₁ + u₂ • z₂) ∈ V_bridge
      have hu₂_eq : u₂ = 1 - u₁ := by linarith
      have hγ_aff : γ (u₁ • z₁ + u₂ • z₂) = u₁ • γ z₁ + u₂ • γ z₂ := by
        ext1 <;>
        · simp only [γ, Prod.fst_add, Prod.snd_add, Prod.smul_fst, Prod.smul_snd,
            Prod.fst_sub, Prod.snd_sub, Complex.real_smul, smul_eq_mul, hu₂_eq]
          push_cast
          ring
      rw [hγ_aff]
      exact hVbridge_convex hz₁ hz₂ hu₁ hu₂ hu
    let h_line : ℂ → ℂ := fun z => g (γ z) - S.𝔰 (γ z)
    have hline_diff : DifferentiableOn ℂ h_line U_z :=
      (hg_Vbridge.comp hγ_diff.differentiableOn (fun _ hz => hz)).sub
        (h𝔰_Vbridge.comp hγ_diff.differentiableOn (fun _ hz => hz))
    have hline_ana : AnalyticOnNhd ℂ h_line U_z := hline_diff.analyticOnNhd hUz_open
    have hline_ev : h_line =ᶠ[nhds (0 : ℂ)] 0 := by
      refine Filter.eventuallyEq_iff_exists_mem.mpr
        ⟨γ ⁻¹' V_seed, (hVseed_open.preimage hγ_diff.continuous).mem_nhds ?_, ?_⟩
      · show γ 0 ∈ V_seed; rw [hγ0]; exact hp₀_seed
      · intro z hz
        show g (γ z) - S.𝔰 (γ z) = 0
        exact sub_eq_zero.mpr (hg_eq_seed (γ z) hz)
    have h1_zero : h_line 1 = 0 :=
      hline_ana.eqOn_zero_of_preconnected_of_eventuallyEq_zero
        hUz_convex.isPreconnected h0_Uz hline_ev h1_Uz
    dsimp [h_line] at h1_zero
    rw [hγ1] at h1_zero
    exact sub_eq_zero.mp h1_zero

  have hg_overlap : ∀ p : ℂ × ℂ,
      |p.1.re - x_edge| < ε / 4 →
      |p.1.im - (S.h_X (t₀ : ℂ) - ε / 2)| < ε / 4 →
      ‖p.2 - (t₀ : ℂ)‖ < δ →
      g p = S.𝔰 p := by
    intro p hre him ht
    apply hg_eq_bridge p
    have hh_eq : S.h_X (t₀ : ℂ) = h := rfl
    rw [hh_eq] at him
    rcases abs_lt.mp him with ⟨him1, him2⟩
    refine ⟨?_, ?_, ?_, ht⟩
    · linarith
    · linarith
    · linarith

  exact S.no_patch_at_real_wall t₀ x_edge ε ht₀_abs hε_pos hε_lt_s_star
    ⟨g, hg_Wε, hg_strip_Wε, δ, hδ_pos, hδ_le_ε, hg_overlap⟩

theorem interior_slice_limit_implies_wall_patch (S : FiniteWallNonisotropicStrip)
    (hChord : OddSliceChordProp S) (hJac : OddSliceJacobiProp S)
    (x_star : ℝ) (s_lim : Fin (oddSliceN S) → ℂ)
    (h_in_strip : ∀ j : Fin (oddSliceN S), s_lim j ∈ horizStrip S.H)
    (h_lim : ∀ j : Fin (oddSliceN S),
      Filter.Tendsto (sliceImpactSeq S (oddSliceN S) j.val)
        (nhdsWithin
          ((x_star : ℂ) + (sliceHeight S (oddSliceN S) : ℂ) * Complex.I)
          {y : ℂ | y ∈ horizStrip (sliceHeight S (oddSliceN S)) ∧
            |y.re - x_star| ≤ 2 * (sliceHeight S (oddSliceN S) - |y.im|)})
        (nhds (s_lim j)))
    (h_f_ne : ∀ j : Fin (oddSliceN S), S.f (s_lim j) ≠ 0)
    (h_sin_ne : ∀ j : Fin (oddSliceN S), Complex.sin (stateD0 S s_lim j) ≠ 0)
    (h_chord_ne : ∀ j : Fin (oddSliceN S), stateChordNum S s_lim j ≠ 0)
    (h_det_ne : ∀ j : Fin (oddSliceN S),
      (stateClearedB S (Finset.univ.erase j) ∅ s_lim).det ≠ 0) :
    False :=
by
  obtain ⟨A⟩ := slice_arc_ode_continuation S hChord hJac x_star s_lim
    h_in_strip h_lim h_f_ne h_sin_ne h_chord_ne h_det_ne
  obtain ⟨M⟩ := return_map_normal_form_extraction S hChord x_star A
  obtain ⟨K⟩ := steep_return_sector_continuation S M
  exact quadratic_disk_patch_contradiction S K

theorem odd_slice_jacobi_and_boundary_contact (S : FiniteWallNonisotropicStrip) :
    Nonempty (OddPeriodicSliceData S) :=
by
  have hChord : OddSliceChordProp S := odd_slice_chord_and_pos_reconstruction S
  have hJac : OddSliceJacobiProp S := odd_slice_jacobi_and_cofactor S hChord
  let N : ℕ := oddSliceN S
  have hN_ge_three : 3 ≤ N := by
    dsimp [N, oddSliceN]
    omega
  have hN_odd : Odd N :=
    ⟨Nat.floor (Real.pi / S.r_star) + 1, by dsimp [N, oddSliceN]; omega⟩
  have hN_pos : (0 : ℝ) < (N : ℝ) := by
    exact_mod_cast (lt_of_lt_of_le (by decide : 0 < 3) hN_ge_three)
  have ht0_pos : 0 < sliceParamT0 N := by
    unfold sliceParamT0
    exact div_pos (mul_pos (by norm_num) Real.pi_pos) hN_pos
  have ht0_lt : sliceParamT0 N < S.r_star := by
    unfold sliceParamT0
    rw [div_lt_iff₀ hN_pos]
    have hfl : Real.pi / S.r_star < (Nat.floor (Real.pi / S.r_star) : ℝ) + 1 :=
      Nat.lt_floor_add_one (Real.pi / S.r_star)
    have hpi_lt : Real.pi < ((Nat.floor (Real.pi / S.r_star) : ℝ) + 1) * S.r_star :=
      (div_lt_iff₀ S.r_star_pos).mp hfl
    have hN_cast : (N : ℝ) = 2 * (Nat.floor (Real.pi / S.r_star) : ℝ) + 3 := by
      dsimp [N, oddSliceN]
      push_cast
      ring
    rw [hN_cast]
    nlinarith [S.r_star_pos]
  have ht0_mem : (sliceParamT0 N : ℂ) ∈ Metric.ball (0 : ℂ) S.r_star := by
    rw [Metric.mem_ball, dist_zero_right, Complex.norm_real, Real.norm_eq_abs,
      abs_of_pos ht0_pos]
    exact ht0_lt
  let h : ℝ := sliceHeight S N
  have hh_pos : 0 < h :=
    lt_of_lt_of_le S.s_star_pos (S.h_X_bounds _ ht0_mem).1
  have hC_rec_pos : 0 < oddSliceCRec S := by
    unfold oddSliceCRec
    positivity
  have h_zero_in_strip : ((0 : ℝ) : ℂ) ∈ horizStrip h := by
    simp [horizStrip, hh_pos]
  have h_zero_not_Z : ((0 : ℝ) : ℂ) ∉ oddSliceZAll S :=
    hJac.real_not_mem_Z_all 0
  have h_f_holo : ∀ k : Fin N,
      DifferentiableOn ℂ (fun y => S.f (oddSliceStateVec S y k)) (horizStrip h) := by
    intro k
    exact S.f_holo.comp (hChord.impact_holo k.val)
      (fun y hy => hChord.impact_maps_to k.val y hy)
  have h_phi_holo : ∀ k : Fin N,
      DifferentiableOn ℂ (fun y => S.ϕ (oddSliceStateVec S y k)) (horizStrip h) := by
    intro k
    exact S.ϕ_holo.comp (hChord.impact_holo k.val)
      (fun y hy => hChord.impact_maps_to k.val y hy)
  have h_shifted_holo : ∀ (j : Fin N) (m : ℕ),
      DifferentiableOn ℂ
        (fun y => stateShiftedAngle S (oddSliceStateVec S y) j m) (horizStrip h) := by
    intro j m
    unfold stateShiftedAngle
    split_ifs with hm
    · exact h_phi_holo _
    · exact (h_phi_holo _).sub (differentiableOn_const _)
  have h_theta_holo : ∀ j : Fin N,
      DifferentiableOn ℂ
        (fun y => stateTheta S (oddSliceStateVec S y) j) (horizStrip h) := by
    intro j
    unfold stateTheta
    exact (differentiableOn_const _).add
      (DifferentiableOn.fun_sum (fun m _ => (differentiableOn_const _).mul (h_shifted_holo j m)))
  have h_d0_holo : ∀ j : Fin N,
      DifferentiableOn ℂ
        (fun y => stateD0 S (oddSliceStateVec S y) j) (horizStrip h) := by
    intro j
    unfold stateD0
    exact (h_theta_holo j).sub (h_phi_holo j)
  have h_sin_d0_holo : ∀ j : Fin N,
      DifferentiableOn ℂ
        (fun y => Complex.sin (stateD0 S (oddSliceStateVec S y) j)) (horizStrip h) := by
    intro j
    exact Complex.differentiable_sin.comp_differentiableOn (h_d0_holo j)
  have h_chord_holo : ∀ j : Fin N,
      DifferentiableOn ℂ
        (fun y => stateChordNum S (oddSliceStateVec S y) j) (horizStrip h) :=
    hChord.ℓ_num_holo
  have h_delta_holo :
      DifferentiableOn ℂ
        (fun y => stateDeltaRow S (oddSliceStateVec S y)) (horizStrip h) := by
    unfold stateDeltaRow
    exact (DifferentiableOn.fun_finsetProd (fun m _ => h_chord_holo m)).mul
      (DifferentiableOn.fun_finsetProd (fun m _ => h_sin_d0_holo m))
  have h_M0_entry_holo : ∀ i k : Fin N,
      DifferentiableOn ℂ
        (fun y => stateClearedM0Entry S (oddSliceStateVec S y) i k) (horizStrip h) := by
    intro i k
    unfold stateClearedM0Entry
    have hP_sin : DifferentiableOn ℂ
        (fun y => ∏ m : Fin N, Complex.sin (stateD0 S (oddSliceStateVec S y) m))
        (horizStrip h) :=
      DifferentiableOn.fun_finsetProd (fun m _ => h_sin_d0_holo m)
    have hP_ell : ∀ r : Fin N, DifferentiableOn ℂ
        (fun y => ∏ m ∈ Finset.univ.erase r, stateChordNum S (oddSliceStateVec S y) m)
        (horizStrip h) :=
      fun r => DifferentiableOn.fun_finsetProd (fun m _ => h_chord_holo m)
    refine ((?_ : DifferentiableOn ℂ _ (horizStrip h)).add ?_).add ?_
    · by_cases hik : i = k
      · simp only [hik, ↓reduceIte]
        exact (((((h_f_holo _).mul (h_f_holo _)).mul (hP_ell _)).add
          (((h_f_holo _).mul (h_f_holo _)).mul (hP_ell _))).mul hP_sin)
      · simp only [hik, ↓reduceIte]
        exact differentiableOn_const 0
    · by_cases hki : k = @cycNext (oddSliceN S) (oddSliceNeZero S) i
      · simp only [hki, ↓reduceIte]
        exact ((((h_f_holo _).mul (h_f_holo _)).mul (hP_ell _)).mul hP_sin)
      · simp only [hki, ↓reduceIte]
        exact differentiableOn_const 0
    · by_cases hik' : i = @cycNext (oddSliceN S) (oddSliceNeZero S) k
      · simp only [hik', ↓reduceIte]
        exact ((((h_f_holo _).mul (h_f_holo _)).mul (hP_ell _)).mul hP_sin)
      · simp only [hik', ↓reduceIte]
        exact differentiableOn_const 0
  have h_VDiag_holo : ∀ i : Fin N,
      DifferentiableOn ℂ
        (fun y => stateClearedVDiag S (oddSliceStateVec S y) i) (horizStrip h) := by
    intro i
    unfold stateClearedVDiag
    exact ((((differentiableOn_const _).mul ((h_f_holo i).pow 3)).mul
      (DifferentiableOn.fun_finsetProd (fun m _ => h_chord_holo m))).mul
      (DifferentiableOn.fun_finsetProd (fun m _ => h_sin_d0_holo m)))
  have h_B_entry_holo : ∀ (I F : Finset (Fin N)) (i k : Fin N),
      DifferentiableOn ℂ
        (fun y => stateClearedB S I F (oddSliceStateVec S y) i k) (horizStrip h) := by
    intro I F i k
    simp only [stateClearedB, Matrix.of_apply]
    by_cases hIF : i ∈ I ∪ F ∧ k ∈ I ∪ F
    · simp only [hIF, and_self, ↓reduceIte]
      by_cases hik : i = k
      · by_cases hiI : k ∈ I
        · simp only [hik, hiI, and_self, ↓reduceIte]
          exact (h_M0_entry_holo k k).sub (h_VDiag_holo k)
        · simp only [hik, hiI, and_false, ↓reduceIte, sub_zero]
          exact h_M0_entry_holo k k
      · simp only [hik, false_and, ↓reduceIte, sub_zero]
        exact h_M0_entry_holo i k
    · simp only [hIF, ↓reduceIte]
      by_cases hik : i = k
      · simp only [hik, ↓reduceIte]
        exact h_delta_holo
      · simp only [hik, ↓reduceIte]
        exact differentiableOn_const 0
  have h_det_holo : ∀ (I F : Finset (Fin N)),
      DifferentiableOn ℂ
        (fun y => (stateClearedB S I F (oddSliceStateVec S y)).det) (horizStrip h) := by
    intro I F
    have h_eq : (fun y => (stateClearedB S I F (oddSliceStateVec S y)).det) =
        fun y => ∑ σ : Equiv.Perm (Fin N),
          ((Equiv.Perm.sign σ : ℤ) : ℂ) *
            ∏ i : Fin N, stateClearedB S I F (oddSliceStateVec S y) (σ i) i := by
      ext y
      rw [Matrix.det_apply]
      refine Finset.sum_congr rfl fun σ _ => ?_
      simp only [Units.smul_def, zsmul_eq_mul]; rfl
    rw [h_eq]
    exact DifferentiableOn.fun_sum fun σ _ =>
      (differentiableOn_const _).mul
        (DifferentiableOn.fun_finsetProd fun i _ => h_B_entry_holo I F (σ i) i)
  obtain ⟨hFatou, hUniq⟩ := strip_nontangential_fatou_and_uniqueness h hh_pos
  have h_ae_lim : ∀ᵐ x : ℝ ∂MeasureTheory.volume, ∀ j : Fin N,
      ∃ s_lim : ℂ, |s_lim.im| ≤ S.H ∧
        ∀ A_cone : ℝ, 0 < A_cone →
          Filter.Tendsto (sliceImpactSeq S N j.val)
            (nhdsWithin ((x : ℂ) + (h : ℂ) * Complex.I)
              {y : ℂ | y ∈ horizStrip h ∧ |y.re - x| ≤ A_cone * (h - |y.im|)})
            (nhds s_lim) := by
    rw [Filter.eventually_all]
    intro j
    exact hFatou S.H S.H_pos (sliceImpactSeq S N j.val)
      (hChord.impact_holo j.val) (hChord.impact_quasiperiodic j.val)
      (hChord.impact_maps_to j.val)
  have h_ae_f : ∀ᵐ x : ℝ ∂MeasureTheory.volume, ∀ j : Fin N,
      ¬ Filter.Tendsto (fun y => S.f (oddSliceStateVec S y j))
          (nhdsWithin ((x : ℂ) + (h : ℂ) * Complex.I)
            {y : ℂ | y ∈ horizStrip h ∧ |y.re - x| ≤ 2 * (h - |y.im|)})
          (nhds 0) := by
    rw [Filter.eventually_all]
    intro j
    refine hUniq _ (h_f_holo j) ⟨0, fun h0 => h_zero_not_Z ⟨h_zero_in_strip, Or.inl ⟨j, Or.inl h0⟩⟩⟩
  have h_ae_sin : ∀ᵐ x : ℝ ∂MeasureTheory.volume, ∀ j : Fin N,
      ¬ Filter.Tendsto (fun y => Complex.sin (stateD0 S (oddSliceStateVec S y) j))
          (nhdsWithin ((x : ℂ) + (h : ℂ) * Complex.I)
            {y : ℂ | y ∈ horizStrip h ∧ |y.re - x| ≤ 2 * (h - |y.im|)})
          (nhds 0) := by
    rw [Filter.eventually_all]
    intro j
    refine hUniq _ (h_sin_d0_holo j)
      ⟨0, fun h0 => h_zero_not_Z ⟨h_zero_in_strip, Or.inl ⟨j, Or.inr (Or.inl h0)⟩⟩⟩
  have h_ae_chord : ∀ᵐ x : ℝ ∂MeasureTheory.volume, ∀ j : Fin N,
      ¬ Filter.Tendsto (fun y => stateChordNum S (oddSliceStateVec S y) j)
          (nhdsWithin ((x : ℂ) + (h : ℂ) * Complex.I)
            {y : ℂ | y ∈ horizStrip h ∧ |y.re - x| ≤ 2 * (h - |y.im|)})
          (nhds 0) := by
    rw [Filter.eventually_all]
    intro j
    refine hUniq _ (h_chord_holo j)
      ⟨0, fun h0 => h_zero_not_Z ⟨h_zero_in_strip, Or.inl ⟨j, Or.inr (Or.inr h0)⟩⟩⟩
  have h_ae_det : ∀ᵐ x : ℝ ∂MeasureTheory.volume, ∀ j : Fin N,
      ¬ Filter.Tendsto
          (fun y => (stateClearedB S (Finset.univ.erase j) ∅ (oddSliceStateVec S y)).det)
          (nhdsWithin ((x : ℂ) + (h : ℂ) * Complex.I)
            {y : ℂ | y ∈ horizStrip h ∧ |y.re - x| ≤ 2 * (h - |y.im|)})
          (nhds 0) := by
    rw [Filter.eventually_all]
    intro j
    refine hUniq _ (h_det_holo (Finset.univ.erase j) ∅) ⟨0, fun h0 => h_zero_not_Z
      ⟨h_zero_in_strip, Or.inr ⟨Finset.univ.erase j, ∅,
        Finset.erase_ssubset (Finset.mem_univ j), Finset.disjoint_empty_right _, h0⟩⟩⟩
  have h_open_H : IsOpen (horizStrip S.H) :=
    isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const
  have h_bdy_contact : ∀ᵐ x : ℝ ∂MeasureTheory.volume,
      ∀ sgn : ℝ, (sgn = 1 ∨ sgn = -1) →
        ∃ s_lim : Fin N → ℂ,
          (∀ A_cone : ℝ, 0 < A_cone → ∀ j : Fin N,
            Filter.Tendsto (sliceImpactSeq S N j.val)
              (nhdsWithin ((x : ℂ) + ((sgn * h : ℝ) : ℂ) * Complex.I)
                {y : ℂ | y ∈ horizStrip h ∧ |y.re - x| ≤ A_cone * (h - |y.im|)})
              (nhds (s_lim j))) ∧
          ∃ j : Fin N, |(s_lim j).im| = S.H := by
    filter_upwards [h_ae_lim, h_ae_f, h_ae_sin, h_ae_chord, h_ae_det] with
      x hx_lim hx_f hx_sin hx_chord hx_det
    let s_plus : Fin N → ℂ := fun j => Classical.choose (hx_lim j)
    have hs_plus_im : ∀ j : Fin N, |(s_plus j).im| ≤ S.H :=
      fun j => (Classical.choose_spec (hx_lim j)).1
    have hs_plus_lim : ∀ A_cone : ℝ, 0 < A_cone → ∀ j : Fin N,
        Filter.Tendsto (sliceImpactSeq S N j.val)
          (nhdsWithin ((x : ℂ) + (h : ℂ) * Complex.I)
            {y : ℂ | y ∈ horizStrip h ∧ |y.re - x| ≤ A_cone * (h - |y.im|)})
          (nhds (s_plus j)) :=
      fun A_cone hA j => (Classical.choose_spec (hx_lim j)).2 A_cone hA
    have hs_plus_hit : ∃ j : Fin N, |(s_plus j).im| = S.H := by
      by_contra h_no_hit
      push Not at h_no_hit
      have h_in_H : ∀ j : Fin N, s_plus j ∈ horizStrip S.H :=
        fun j => lt_of_le_of_ne (hs_plus_im j) (h_no_hit j)
      let flt : Filter ℂ :=
        nhdsWithin ((x : ℂ) + (h : ℂ) * Complex.I)
          {y : ℂ | y ∈ horizStrip h ∧ |y.re - x| ≤ 2 * (h - |y.im|)}
      have h_lim2 : ∀ j : Fin N,
          Filter.Tendsto (fun y => oddSliceStateVec S y j) flt (nhds (s_plus j)) :=
        fun j => hs_plus_lim 2 (by norm_num) j
      have ht_f : ∀ k : Fin N,
          Filter.Tendsto (fun y => S.f (oddSliceStateVec S y k)) flt (nhds (S.f (s_plus k))) := by
        intro k
        exact (S.f_holo.continuousOn.continuousAt (h_open_H.mem_nhds (h_in_H k))).tendsto.comp
          (h_lim2 k)
      have ht_phi : ∀ k : Fin N,
          Filter.Tendsto (fun y => S.ϕ (oddSliceStateVec S y k)) flt (nhds (S.ϕ (s_plus k))) := by
        intro k
        exact (S.ϕ_holo.continuousOn.continuousAt (h_open_H.mem_nhds (h_in_H k))).tendsto.comp
          (h_lim2 k)
      have ht_K : ∀ (k : Fin N) (i : Fin 2),
          Filter.Tendsto (fun y => holoScaledPos S (oddSliceStateVec S y k) i) flt
            (nhds (holoScaledPos S (s_plus k) i)) := by
        intro k i
        exact ((hChord.holoScaledPos_holo i).continuousOn.continuousAt
          (h_open_H.mem_nhds (h_in_H k))).tendsto.comp (h_lim2 k)
      have ht_shifted : ∀ (j : Fin N) (m : ℕ),
          Filter.Tendsto (fun y => stateShiftedAngle S (oddSliceStateVec S y) j m) flt
            (nhds (stateShiftedAngle S s_plus j m)) := by
        intro j m
        unfold stateShiftedAngle
        split_ifs with hm
        · exact ht_phi _
        · exact (ht_phi _).sub tendsto_const_nhds
      have ht_theta : ∀ j : Fin N,
          Filter.Tendsto (fun y => stateTheta S (oddSliceStateVec S y) j) flt
            (nhds (stateTheta S s_plus j)) := by
        intro j
        unfold stateTheta
        exact tendsto_const_nhds.add
          (tendsto_finsetSum _ fun m _ => tendsto_const_nhds.mul (ht_shifted j m))
      have ht_d0 : ∀ j : Fin N,
          Filter.Tendsto (fun y => stateD0 S (oddSliceStateVec S y) j) flt
            (nhds (stateD0 S s_plus j)) := by
        intro j
        unfold stateD0
        exact (ht_theta j).sub (ht_phi j)
      have ht_sin_d0 : ∀ j : Fin N,
          Filter.Tendsto (fun y => Complex.sin (stateD0 S (oddSliceStateVec S y) j)) flt
            (nhds (Complex.sin (stateD0 S s_plus j))) := by
        intro j
        exact (Complex.continuous_sin.continuousAt.tendsto).comp (ht_d0 j)
      have ht_cos_theta : ∀ j : Fin N,
          Filter.Tendsto (fun y => Complex.cos (stateTheta S (oddSliceStateVec S y) j)) flt
            (nhds (Complex.cos (stateTheta S s_plus j))) := by
        intro j
        exact (Complex.continuous_cos.continuousAt.tendsto).comp (ht_theta j)
      have ht_sin_theta : ∀ j : Fin N,
          Filter.Tendsto (fun y => Complex.sin (stateTheta S (oddSliceStateVec S y) j)) flt
            (nhds (Complex.sin (stateTheta S s_plus j))) := by
        intro j
        exact (Complex.continuous_sin.continuousAt.tendsto).comp (ht_theta j)
      have ht_chord : ∀ j : Fin N,
          Filter.Tendsto (fun y => stateChordNum S (oddSliceStateVec S y) j) flt
            (nhds (stateChordNum S s_plus j)) := by
        intro j
        unfold stateChordNum
        exact ((((ht_f j).mul (ht_K _ 0)).sub ((ht_f _).mul (ht_K j 0))).neg.mul
          (ht_sin_theta j)).add
          ((((ht_f j).mul (ht_K _ 1)).sub ((ht_f _).mul (ht_K j 1))).mul (ht_cos_theta j))
      have ht_delta :
          Filter.Tendsto (fun y => stateDeltaRow S (oddSliceStateVec S y)) flt
            (nhds (stateDeltaRow S s_plus)) := by
        unfold stateDeltaRow
        exact (tendsto_finsetProd _ fun m _ => ht_chord m).mul
          (tendsto_finsetProd _ fun m _ => ht_sin_d0 m)
      have ht_M0_entry : ∀ i k : Fin N,
          Filter.Tendsto (fun y => stateClearedM0Entry S (oddSliceStateVec S y) i k) flt
            (nhds (stateClearedM0Entry S s_plus i k)) := by
        intro i k
        unfold stateClearedM0Entry
        have htP_sin : Filter.Tendsto
            (fun y => ∏ m : Fin N, Complex.sin (stateD0 S (oddSliceStateVec S y) m)) flt
            (nhds (∏ m : Fin N, Complex.sin (stateD0 S s_plus m))) :=
          tendsto_finsetProd _ fun m _ => ht_sin_d0 m
        have htP_ell : ∀ r : Fin N, Filter.Tendsto
            (fun y => ∏ m ∈ Finset.univ.erase r, stateChordNum S (oddSliceStateVec S y) m) flt
            (nhds (∏ m ∈ Finset.univ.erase r, stateChordNum S s_plus m)) :=
          fun r => tendsto_finsetProd _ fun m _ => ht_chord m
        refine ((?_ : Filter.Tendsto _ flt _).add ?_).add ?_
        · by_cases hik : i = k
          · simp only [hik, ↓reduceIte]
            exact (((((ht_f _).mul (ht_f _)).mul (htP_ell _)).add
              (((ht_f _).mul (ht_f _)).mul (htP_ell _))).mul htP_sin)
          · simp only [hik, ↓reduceIte]
            exact tendsto_const_nhds
        · by_cases hki : k = @cycNext (oddSliceN S) (oddSliceNeZero S) i
          · simp only [hki, ↓reduceIte]
            exact ((((ht_f _).mul (ht_f _)).mul (htP_ell _)).mul htP_sin)
          · simp only [hki, ↓reduceIte]
            exact tendsto_const_nhds
        · by_cases hik' : i = @cycNext (oddSliceN S) (oddSliceNeZero S) k
          · simp only [hik', ↓reduceIte]
            exact ((((ht_f _).mul (ht_f _)).mul (htP_ell _)).mul htP_sin)
          · simp only [hik', ↓reduceIte]
            exact tendsto_const_nhds
      have ht_VDiag : ∀ i : Fin N,
          Filter.Tendsto (fun y => stateClearedVDiag S (oddSliceStateVec S y) i) flt
            (nhds (stateClearedVDiag S s_plus i)) := by
        intro i
        unfold stateClearedVDiag
        exact (((tendsto_const_nhds.mul ((ht_f i).pow 3)).mul
          (tendsto_finsetProd _ fun m _ => ht_chord m)).mul
          (tendsto_finsetProd _ fun m _ => ht_sin_d0 m))
      have ht_B_entry : ∀ (I F : Finset (Fin N)) (i k : Fin N),
          Filter.Tendsto (fun y => stateClearedB S I F (oddSliceStateVec S y) i k) flt
            (nhds (stateClearedB S I F s_plus i k)) := by
        intro I F i k
        simp only [stateClearedB, Matrix.of_apply]
        by_cases hIF : i ∈ I ∪ F ∧ k ∈ I ∪ F
        · simp only [hIF, and_self, ↓reduceIte]
          by_cases hik : i = k
          · by_cases hiI : k ∈ I
            · simp only [hik, hiI, and_self, ↓reduceIte]
              exact (ht_M0_entry k k).sub (ht_VDiag k)
            · simp only [hik, hiI, and_false, ↓reduceIte, sub_zero]
              exact ht_M0_entry k k
          · simp only [hik, false_and, ↓reduceIte, sub_zero]
            exact ht_M0_entry i k
        · simp only [hIF, ↓reduceIte]
          by_cases hik : i = k
          · simp only [hik, ↓reduceIte]
            exact ht_delta
          · simp only [hik, ↓reduceIte]
            exact tendsto_const_nhds
      have ht_det : ∀ (I F : Finset (Fin N)),
          Filter.Tendsto (fun y => (stateClearedB S I F (oddSliceStateVec S y)).det) flt
            (nhds ((stateClearedB S I F s_plus).det)) := by
        intro I F
        have h_eq1 : (fun y => (stateClearedB S I F (oddSliceStateVec S y)).det) =
            fun y => ∑ σ : Equiv.Perm (Fin N),
              ((Equiv.Perm.sign σ : ℤ) : ℂ) *
                ∏ i : Fin N, stateClearedB S I F (oddSliceStateVec S y) (σ i) i := by
          ext y; rw [Matrix.det_apply]
          refine Finset.sum_congr rfl fun σ _ => ?_
          simp only [Units.smul_def, zsmul_eq_mul]; rfl
        have h_eq2 : (stateClearedB S I F s_plus).det =
            ∑ σ : Equiv.Perm (Fin N),
              ((Equiv.Perm.sign σ : ℤ) : ℂ) *
                ∏ i : Fin N, stateClearedB S I F s_plus (σ i) i := by
          rw [Matrix.det_apply]
          refine Finset.sum_congr rfl fun σ _ => ?_
          simp only [Units.smul_def, zsmul_eq_mul]; rfl
        rw [h_eq1, h_eq2]
        exact tendsto_finsetSum _ fun σ _ =>
          tendsto_const_nhds.mul
            (tendsto_finsetProd _ fun i _ => ht_B_entry I F (σ i) i)
      exact interior_slice_limit_implies_wall_patch S hChord hJac x s_plus h_in_H h_lim2
        (fun j h0 => hx_f j (h0 ▸ ht_f j))
        (fun j h0 => hx_sin j (h0 ▸ ht_sin_d0 j))
        (fun j h0 => hx_chord j (h0 ▸ ht_chord j))
        (fun j h0 => hx_det j (h0 ▸ ht_det (Finset.univ.erase j) ∅))
    intro sgn hsgn
    rcases hsgn with rfl | rfl
    · refine ⟨s_plus, ?_, hs_plus_hit⟩
      intro A_cone hA j
      simpa [one_mul] using hs_plus_lim A_cone hA j
    · refine ⟨fun j => starRingEnd ℂ (s_plus j), ?_, ?_⟩
      · intro A_cone hA j
        let coneSet : Set ℂ :=
          {y : ℂ | y ∈ horizStrip h ∧ |y.re - x| ≤ A_cone * (h - |y.im|)}
        have h_conj_pt :
            starRingEnd ℂ ((x : ℂ) + (((-1 : ℝ) * h : ℝ) : ℂ) * Complex.I) =
              (x : ℂ) + (h : ℂ) * Complex.I := by
          simp
        have h_conj_maps : ∀ y ∈ coneSet, starRingEnd ℂ y ∈ coneSet := by
          intro y hy
          refine ⟨?_, ?_⟩
          · simp only [horizStrip, Set.mem_ofPred_eq, Complex.conj_im, abs_neg]
            exact hy.1
          · simpa only [Complex.conj_re, Complex.conj_im, abs_neg] using hy.2
        have h_conj_tendsto :
            Filter.Tendsto (starRingEnd ℂ)
              (nhdsWithin ((x : ℂ) + (((-1 : ℝ) * h : ℝ) : ℂ) * Complex.I) coneSet)
              (nhdsWithin ((x : ℂ) + (h : ℂ) * Complex.I) coneSet) := by
          refine tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within _ ?_ ?_
          · rw [← h_conj_pt]
            exact Complex.continuous_conj.continuousAt.tendsto.comp nhdsWithin_le_nhds
          · exact eventually_nhdsWithin_of_forall h_conj_maps
        have h_comp :=
          Complex.continuous_conj.continuousAt.tendsto.comp
            ((hs_plus_lim A_cone hA j).comp h_conj_tendsto)
        refine h_comp.congr' ?_
        filter_upwards [eventually_nhdsWithin_of_forall (fun y (hy : y ∈ coneSet) => hy)] with y hy
        dsimp [Function.comp]
        rw [hChord.impact_conj j.val y hy.1]
        simp only [RingHomCompTriple.comp_apply, RingHom.id_apply]
        rfl
      · obtain ⟨j₀, hj₀⟩ := hs_plus_hit
        exact ⟨j₀, by simpa [Complex.conj_im, abs_neg] using hj₀⟩
  exact ⟨{
    N := N
    instNeZero := oddSliceNeZero S
    N_odd := hN_odd
    N_ge_three := hN_ge_three
    t₀_lt_r_star := ht0_lt
    θ_seq := oddSliceTheta S
    θ_holo := hChord.θ_holo
    θ_quasiperiodic := hChord.θ_quasiperiodic
    θ_shift_N := hChord.θ_shift_N
    θ_conj := hChord.θ_conj
    θ_sum := hChord.θ_sum
    θ_real := hChord.θ_real
    ℓ_num := oddSliceChordNum S
    ℓ_num_holo := hChord.ℓ_num_holo
    ℓ_num_periodic := hChord.ℓ_num_periodic
    ℓ_real := hChord.ℓ_real
    C_rec := oddSliceCRec S
    C_rec_pos := hC_rec_pos
    Z_all := oddSliceZAll S
    Z_all_subset := hJac.Z_all_subset
    reg_open := hJac.reg_open
    real_not_mem_Z_all := hJac.real_not_mem_Z_all
    Z_all_periodic := hJac.Z_all_periodic
    Z_all_compact_finite := hJac.Z_all_compact_finite
    reg_speed_ne_zero := hJac.reg_speed_ne_zero
    reg_sin_d0_ne_zero := hJac.reg_sin_d0_ne_zero
    reg_chord_ne_zero := hJac.reg_chord_ne_zero
    reg_chord_vec := fun y hy => hChord.reg_chord_vec_pt y hy.1 (hJac.reg_speed_ne_zero y hy)
    reg_deriv_pos := fun y hy => hChord.reg_deriv_pos_pt y hy.1 (hJac.reg_speed_ne_zero y hy)
    reg_deriv_support := fun y hy =>
      hChord.reg_deriv_support_pt y hy.1 (hJac.reg_speed_ne_zero y hy)
    pos_reconstruction := fun y hy =>
      hChord.pos_reconstruction_pt y hy.1 (hJac.reg_speed_ne_zero y hy)
        (hJac.reg_sin_d0_ne_zero y hy)
    jacobi_null := hJac.jacobi_null
    jacobi_M0_mulVec := hJac.jacobi_M0_mulVec
    modified_det_ne_zero := hJac.modified_det_ne_zero
    cofactor_norm := hJac.cofactor_norm
    boundary_contact := h_bdy_contact
  }⟩

theorem adaptive_step_topological_admissibility (S : FiniteWallNonisotropicStrip)
    (P : OddPeriodicSliceData S) :
    AdaptiveStepTopPackage S P :=
by
  let h : ℝ := sliceHeight S P.N
  let Ω_reg : Set ℂ := horizStrip h \ P.Z_all
  let F_closed : Set ℂ := sliceRegClosedComp S P
  have hF_eq : F_closed = Ω_regᶜ := rfl
  have hF_closed : IsClosed F_closed := P.reg_open.isClosed_compl
  have hF_ne : F_closed.Nonempty := by
    refine ⟨(h : ℂ) * Complex.I, ?_⟩
    rw [hF_eq, Set.mem_compl_iff]
    intro hz
    have him : ((h : ℂ) * Complex.I).im = h := by simp
    have hlt : |((h : ℂ) * Complex.I).im| < h := hz.1
    rw [him] at hlt
    exact not_lt_of_ge (le_abs_self h) hlt
  have hSing_cont : Continuous (sliceSingDist S P) :=
    Metric.continuous_infDist_pt F_closed
  have hSing_nonneg : ∀ y : ℂ, 0 ≤ sliceSingDist S P y :=
    fun y => Metric.infDist_nonneg
  have hSing_zero : ∀ y : ℂ, y ∉ Ω_reg → sliceSingDist S P y = 0 := by
    intro y hy
    exact Metric.infDist_zero_of_mem (show y ∈ F_closed from hy)
  have hSing_pos_iff : ∀ y : ℂ, 0 < sliceSingDist S P y ↔ y ∈ Ω_reg := by
    intro y
    have h1 := hF_closed.notMem_iff_infDist_pos (x := y) hF_ne
    simp only [hF_eq, Set.mem_compl_iff, not_not] at h1
    exact h1.symm
  have hSing_per : ∀ y : ℂ, sliceSingDist S P (y + 2 * Real.pi) = sliceSingDist S P y := by
    intro y
    let τ : ℂ → ℂ := fun w => w + (2 : ℂ) * (Real.pi : ℂ)
    have h_iso : Isometry τ := isometry_add_right ((2 : ℂ) * (Real.pi : ℂ))
    have h_inv : ∀ w : ℂ, w ∈ F_closed ↔ τ w ∈ F_closed := by
      intro w
      change ¬ (|w.im| < h ∧ w ∉ P.Z_all) ↔ ¬ (|(τ w).im| < h ∧ τ w ∉ P.Z_all)
      have him : (τ w).im = w.im := by simp [τ]
      have hZ : w ∈ P.Z_all ↔ τ w ∈ P.Z_all := P.Z_all_periodic w
      rw [him, ← hZ]
    have h_img : τ '' F_closed = F_closed := by
      ext z
      constructor
      · rintro ⟨w, hw, rfl⟩
        exact (h_inv w).mp hw
      · intro hz
        refine ⟨z - (2 : ℂ) * (Real.pi : ℂ), ?_, sub_add_cancel z _⟩
        exact (h_inv _).mpr (by simpa only [τ, sub_add_cancel] using hz)
    have key := Metric.infDist_image (t := F_closed) (x := y) h_iso
    rw [h_img] at key
    exact key
  have hSafe_sub : ∀ y ∈ Ω_reg, Metric.closedBall y (sliceSafeBallRad S P y) ⊆ Ω_reg := by
    intro y hy ζ hζ
    have hd_pos : 0 < sliceSingDist S P y := (hSing_pos_iff y).mpr hy
    have hr_lt : sliceSafeBallRad S P y < sliceSingDist S P y := by
      unfold sliceSafeBallRad
      have hmin : min 1 (sliceSingDist S P y) ≤ sliceSingDist S P y := min_le_right _ _
      linarith
    have hζ_ball : ζ ∈ Metric.ball y (sliceSingDist S P y) :=
      Metric.closedBall_subset_ball hr_lt hζ
    rw [Metric.mem_ball, dist_comm] at hζ_ball
    by_contra hζ_not
    have h_le : sliceSingDist S P y ≤ dist y ζ :=
      Metric.infDist_le_dist_of_mem (show ζ ∈ F_closed from hζ_not)
    linarith
  have hr_cont : Continuous (sliceSafeBallRad S P) := by
    unfold sliceSafeBallRad
    exact continuous_const.mul (continuous_const.min hSing_cont)
  have hr_nonneg : ∀ y : ℂ, 0 ≤ sliceSafeBallRad S P y := by
    intro y
    unfold sliceSafeBallRad
    exact mul_nonneg (by norm_num) (le_min zero_le_one (hSing_nonneg y))
  have hTerm_nonneg : ∀ (k : Fin P.N) (ζ : ℂ), 0 ≤ sliceLocalSupTerm S P k ζ := by
    intro k ζ
    unfold sliceLocalSupTerm
    positivity
  let t₀ : ℝ := sliceParamT0 P.N
  have hN_pos : (0 : ℝ) < (P.N : ℝ) := by
    exact_mod_cast lt_of_lt_of_le (by decide : 0 < 3) P.N_ge_three
  have ht₀_pos : 0 < t₀ := div_pos Real.two_pi_pos hN_pos
  have ht₀_norm : ‖(t₀ : ℂ)‖ < S.r_star := by
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos ht₀_pos]
    exact P.t₀_lt_r_star
  have hTube_mem : ∀ (m : ℤ), ∀ ζ ∈ horizStrip h,
      (ζ + (m : ℂ) * (t₀ : ℂ), (t₀ : ℂ)) ∈ finiteWallTube S.r_star S.h_X := by
    intro m ζ hζ
    rcases abs_lt.mp (show |ζ.im| < h from hζ) with ⟨h_neg, h_pos⟩
    refine ⟨ht₀_norm, ?_, ?_⟩
    · simp [Complex.conj_ofReal]
      exact h_neg
    · simp
      exact h_pos
  have hImpact_maps : ∀ (m : ℤ), ∀ ζ ∈ horizStrip h,
      sliceImpactSeq S P.N m ζ ∈ horizStrip S.H := by
    intro m ζ hζ
    exact S.𝔰_maps_to _ (hTube_mem m ζ hζ)
  have hImpact_cont : ∀ (m : ℤ), ContinuousOn (sliceImpactSeq S P.N m) (horizStrip h) := by
    intro m
    let Φ : ℂ → ℂ × ℂ := fun ζ => (ζ + (m : ℂ) * (t₀ : ℂ), (t₀ : ℂ))
    have hΦ_cont : Continuous Φ :=
      (continuous_id.add continuous_const).prodMk continuous_const
    exact S.𝔰_holo.continuousOn.comp hΦ_cont.continuousOn (fun ζ hζ => hTube_mem m ζ hζ)
  have hSpeed_cont : ∀ (m : ℤ), ContinuousOn (sliceSpeedSeq S P.N m) (horizStrip h) := by
    intro m
    exact S.f_holo.continuousOn.comp (hImpact_cont m) (fun ζ hζ => hImpact_maps m ζ hζ)
  have hAngle_cont : ∀ (m : ℤ), ContinuousOn (sliceAngleSeq S P.N m) (horizStrip h) := by
    intro m
    exact S.ϕ_holo.continuousOn.comp (hImpact_cont m) (fun ζ hζ => hImpact_maps m ζ hζ)
  have hNormPowInv_cont : ∀ (g : ℂ → ℂ), ContinuousOn g Ω_reg → (∀ ζ ∈ Ω_reg, g ζ ≠ 0) →
      ContinuousOn (fun ζ => ‖g ζ‖ ^ 6) Ω_reg ∧
      ContinuousOn (fun ζ => (‖g ζ‖ ^ 6)⁻¹) Ω_reg := by
    intro g hg hg_ne
    have h_pow : ContinuousOn (fun ζ => ‖g ζ‖ ^ 6) Ω_reg :=
      (continuous_norm.continuousOn.comp hg (fun _ _ => Set.mem_univ _)).pow 6
    refine ⟨h_pow, h_pow.inv₀ ?_⟩
    intro ζ hζ
    exact pow_ne_zero 6 (norm_ne_zero_iff.mpr (hg_ne ζ hζ))
  have hTerm_contOn : ∀ (k : Fin P.N), ContinuousOn (sliceLocalSupTerm S P k) Ω_reg := by
    intro k
    have h_sp0 : ContinuousOn (sliceSpeedSeq S P.N k.val) Ω_reg :=
      (hSpeed_cont k.val).mono Set.sdiff_subset
    have h_sp1 : ContinuousOn (sliceSpeedSeq S P.N ((k.val : ℤ) + 1)) Ω_reg :=
      (hSpeed_cont ((k.val : ℤ) + 1)).mono Set.sdiff_subset
    have h_ang : ContinuousOn (sliceAngleSeq S P.N k.val) Ω_reg :=
      (hAngle_cont k.val).mono Set.sdiff_subset
    have h_theta : ContinuousOn (P.θ_seq k.val) Ω_reg :=
      (P.θ_holo k.val).continuousOn.mono Set.sdiff_subset
    have h_d0 : ContinuousOn (P.d0 k) Ω_reg := h_theta.sub h_ang
    have h_sin : ContinuousOn (fun ζ => Complex.sin (P.d0 k ζ)) Ω_reg :=
      Complex.continuous_sin.continuousOn.comp h_d0 (fun _ _ => Set.mem_univ _)
    have h_lnum : ContinuousOn (P.ℓ_num k) Ω_reg :=
      (P.ℓ_num_holo k).continuousOn.mono Set.sdiff_subset
    have h_ell : ContinuousOn (P.ℓ_slice k) Ω_reg := by
      refine h_lnum.div (h_sp0.mul h_sp1) ?_
      intro ζ hζ h_den
      apply P.reg_chord_ne_zero ζ hζ k
      change P.ℓ_slice k ζ = 0
      unfold OddPeriodicSliceData.ℓ_slice
      rw [h_den, div_zero]
    rcases hNormPowInv_cont _ h_sp0 (fun ζ hζ => P.reg_speed_ne_zero ζ hζ k) with ⟨hc1, hc2⟩
    rcases hNormPowInv_cont _ h_sin (fun ζ hζ => P.reg_sin_d0_ne_zero ζ hζ k) with ⟨hc4, hc5⟩
    rcases hNormPowInv_cont _ h_ell (fun ζ hζ => P.reg_chord_ne_zero ζ hζ k) with ⟨hc6, hc7⟩
    have hc3 : ContinuousOn (fun ζ => Real.exp (6 * |(sliceAngleSeq S P.N k.val ζ).im|)) Ω_reg := by
      have him : ContinuousOn (fun ζ => (sliceAngleSeq S P.N k.val ζ).im) Ω_reg :=
        Complex.continuous_im.continuousOn.comp h_ang (fun _ _ => Set.mem_univ _)
      have habs : ContinuousOn (fun ζ => |(sliceAngleSeq S P.N k.val ζ).im|) Ω_reg :=
        continuous_abs.continuousOn.comp him (fun _ _ => Set.mem_univ _)
      exact Real.continuous_exp.continuousOn.comp
        (continuousOn_const.mul habs) (fun _ _ => Set.mem_univ _)
    exact (((((hc1.add hc2).add hc3).add hc4).add hc5).add hc6).add hc7
  have hImpact_qper : ∀ (m : ℤ), ∀ ζ ∈ horizStrip h,
      sliceImpactSeq S P.N m (ζ + 2 * Real.pi) = sliceImpactSeq S P.N m ζ + 2 * Real.pi := by
    intro m ζ hζ
    unfold sliceImpactSeq
    have h_arg : ζ + 2 * Real.pi + (m : ℂ) * (sliceParamT0 P.N : ℂ) =
        (ζ + (m : ℂ) * (sliceParamT0 P.N : ℂ)) + 2 * Real.pi := by ring
    rw [h_arg]
    exact S.𝔰_quasiperiodic _ (hTube_mem m ζ hζ)
  have hTerm_per : ∀ (k : Fin P.N), ∀ ζ ∈ horizStrip h,
      sliceLocalSupTerm S P k (ζ + 2 * Real.pi) = sliceLocalSupTerm S P k ζ := by
    intro k ζ hζ
    have h_sp0 : sliceSpeedSeq S P.N k.val (ζ + 2 * Real.pi) = sliceSpeedSeq S P.N k.val ζ := by
      unfold sliceSpeedSeq
      rw [hImpact_qper k.val ζ hζ]
      exact S.f_periodic _ (hImpact_maps k.val ζ hζ)
    have h_sp1 : sliceSpeedSeq S P.N ((k.val : ℤ) + 1) (ζ + 2 * Real.pi) =
        sliceSpeedSeq S P.N ((k.val : ℤ) + 1) ζ := by
      unfold sliceSpeedSeq
      rw [hImpact_qper ((k.val : ℤ) + 1) ζ hζ]
      exact S.f_periodic _ (hImpact_maps ((k.val : ℤ) + 1) ζ hζ)
    have h_ang : sliceAngleSeq S P.N k.val (ζ + 2 * Real.pi) =
        sliceAngleSeq S P.N k.val ζ + 2 * Real.pi := by
      unfold sliceAngleSeq
      rw [hImpact_qper k.val ζ hζ]
      exact S.ϕ_quasiperiodic _ (hImpact_maps k.val ζ hζ)
    have h_ang_im : (sliceAngleSeq S P.N k.val (ζ + 2 * Real.pi)).im =
        (sliceAngleSeq S P.N k.val ζ).im := by
      rw [h_ang]
      simp
    have h_d0 : P.d0 k (ζ + 2 * Real.pi) = P.d0 k ζ := by
      unfold OddPeriodicSliceData.d0
      rw [P.θ_quasiperiodic k.val ζ hζ, h_ang]
      ring
    have h_ell : P.ℓ_slice k (ζ + 2 * Real.pi) = P.ℓ_slice k ζ := by
      unfold OddPeriodicSliceData.ℓ_slice
      rw [P.ℓ_num_periodic k ζ hζ, h_sp0, h_sp1]
    unfold sliceLocalSupTerm
    rw [h_sp0, h_ang_im, h_d0, h_ell]
  let B₁ : Set ℂ := Metric.closedBall (0 : ℂ) 1
  have hAff_mem_ball : ∀ (y : ℂ), ∀ u ∈ B₁,
      y + (sliceSafeBallRad S P y : ℂ) * u ∈ Metric.closedBall y (sliceSafeBallRad S P y) := by
    intro y u hu
    rw [Metric.mem_closedBall, dist_zero_right] at hu
    rw [Metric.mem_closedBall, dist_eq_norm, add_sub_cancel_left, norm_mul,
      Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hr_nonneg y)]
    exact mul_le_of_le_one_right (hr_nonneg y) hu
  have hAff_mem_reg : ∀ y ∈ Ω_reg, ∀ u ∈ B₁,
      y + (sliceSafeBallRad S P y : ℂ) * u ∈ Ω_reg := by
    intro y hy u hu
    exact hSafe_sub y hy (hAff_mem_ball y u hu)
  let M_sup : Fin P.N → ℂ → ℝ := fun k y =>
    sSup ((fun u : ℂ => sliceLocalSupTerm S P k (y + (sliceSafeBallRad S P y : ℂ) * u)) '' B₁)
  have hM_contOn : ∀ k : Fin P.N, ContinuousOn (M_sup k) Ω_reg := by
    intro k
    have : CompactSpace ↥B₁ := isCompact_iff_compactSpace.mp (isCompact_closedBall (0 : ℂ) 1)
    let ψ : ↥Ω_reg × ↥B₁ → ℂ := fun p =>
      (p.1 : ℂ) + (sliceSafeBallRad S P (p.1 : ℂ) : ℂ) * (p.2 : ℂ)
    have hψ_cont : Continuous ψ :=
      (continuous_subtype_val.comp continuous_fst).add
        ((Complex.continuous_ofReal.comp
          (hr_cont.comp (continuous_subtype_val.comp continuous_fst))).mul
          (continuous_subtype_val.comp continuous_snd))
    have hψ_mem : ∀ p : ↥Ω_reg × ↥B₁, ψ p ∈ Ω_reg :=
      fun p => hAff_mem_reg p.1.1 p.1.2 p.2.1 p.2.2
    let f : ↥Ω_reg → ↥B₁ → ℝ := fun y u => sliceLocalSupTerm S P k (ψ (y, u))
    have hf_cont : Continuous (Function.uncurry f) :=
      (hTerm_contOn k).comp_continuous hψ_cont hψ_mem
    have h_sup_cont : Continuous (fun y : ↥Ω_reg => sSup (f y '' Set.univ)) :=
      isCompact_univ.continuous_sSup hf_cont
    rw [continuousOn_iff_continuous_domRestrict]
    have h_eq : (Ω_reg.domRestrict (M_sup k)) = (fun y : ↥Ω_reg => sSup (f y '' Set.univ)) := by
      ext y
      let g_y : ℂ → ℝ := fun u =>
        sliceLocalSupTerm S P k ((y : ℂ) + (sliceSafeBallRad S P (y : ℂ) : ℂ) * u)
      have h_fy : f y = g_y ∘ Subtype.val := rfl
      rw [Set.domRestrict_apply, h_fy, Set.image_univ, Set.range_comp, Subtype.range_coe]
    rw [h_eq]
    exact h_sup_cont
  have hM_le : ∀ (k : Fin P.N), ∀ y ∈ Ω_reg,
      ∀ ζ ∈ Metric.closedBall y (sliceSafeBallRad S P y),
        sliceLocalSupTerm S P k ζ ≤ M_sup k y := by
    intro k y hy ζ hζ
    let r : ℝ := sliceSafeBallRad S P y
    let g_y : ℂ → ℝ := fun u => sliceLocalSupTerm S P k (y + (r : ℂ) * u)
    have hα_cont : Continuous (fun u : ℂ => y + (r : ℂ) * u) :=
      continuous_const.add (continuous_const.mul continuous_id)
    have hg_cont : ContinuousOn g_y B₁ :=
      (hTerm_contOn k).comp hα_cont.continuousOn (fun u hu => hAff_mem_reg y hy u hu)
    have h_bdd : BddAbove (g_y '' B₁) :=
      ((isCompact_closedBall (0 : ℂ) 1).image_of_continuousOn hg_cont).bddAbove
    have h_mem : sliceLocalSupTerm S P k ζ ∈ g_y '' B₁ := by
      by_cases hr0 : r = 0
      · have hζ_eq : ζ = y := by
          have hr0' : sliceSafeBallRad S P y = 0 := hr0
          rw [Metric.mem_closedBall, hr0'] at hζ
          exact dist_le_zero.mp hζ
        refine ⟨0, Metric.mem_closedBall_self zero_le_one, ?_⟩
        simp [g_y, hr0, hζ_eq]
      · have hr_nonneg_y : 0 ≤ r := hr_nonneg y
        have hrc_ne : (r : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hr0
        refine ⟨(ζ - y) / (r : ℂ), ?_, ?_⟩
        · rw [Metric.mem_closedBall, dist_zero_right, norm_div, Complex.norm_real,
            Real.norm_eq_abs, abs_of_nonneg hr_nonneg_y, ← dist_eq_norm]
          exact div_le_one_of_le₀ (Metric.mem_closedBall.mp hζ) hr_nonneg_y
        · dsimp only [g_y]
          rw [mul_div_cancel₀ _ hrc_ne, add_sub_cancel]
    exact le_csSup h_bdd h_mem
  have hM_nonneg : ∀ (k : Fin P.N) (y : ℂ), 0 ≤ M_sup k y := by
    intro k y
    apply Real.sSup_nonneg
    rintro _ ⟨u, _, rfl⟩
    exact hTerm_nonneg k _
  have hDenom_ge_one : ∀ y : ℂ, 1 ≤ sliceLocalSupDenom S P y := by
    intro y
    unfold sliceLocalSupDenom
    have hsum : 0 ≤ ∑ k : Fin P.N, M_sup k y :=
      Finset.sum_nonneg (fun k _ => hM_nonneg k y)
    linarith
  have hSafe_ball_sub_and_le : ∀ y ∈ Ω_reg, ∀ k : Fin P.N,
      ∀ ζ ∈ Metric.closedBall y (sliceSafeBallRad S P y),
        ζ ∈ Ω_reg ∧ sliceLocalSupTerm S P k ζ ≤ sliceLocalSupDenom S P y := by
    intro y hy k ζ hζ
    refine ⟨hSafe_sub y hy hζ, ?_⟩
    have h1 : sliceLocalSupTerm S P k ζ ≤ M_sup k y := hM_le k y hy ζ hζ
    have h2 : M_sup k y ≤ ∑ j : Fin P.N, M_sup j y :=
      Finset.single_le_sum (fun j _ => hM_nonneg j y) (Finset.mem_univ k)
    have h3 : ∑ j : Fin P.N, M_sup j y ≤ sliceLocalSupDenom S P y := by
      unfold sliceLocalSupDenom
      change ∑ j : Fin P.N, M_sup j y ≤ 1 + ∑ j : Fin P.N, M_sup j y
      linarith
    exact le_trans h1 (le_trans h2 h3)
  have hC_pos : ∀ L : ℝ,
      0 < Real.exp (-4 * (max L 2) ^ 7) / (10000 * (1 + S.H + S.c) ^ 3) := by
    intro L
    have hH := S.H_pos
    have hc := S.c_pos
    positivity
  have hC_le : ∀ L : ℝ,
      Real.exp (-4 * (max L 2) ^ 7) / (10000 * (1 + S.H + S.c) ^ 3) ≤ 1 / 100 := by
    intro L
    have hmax : (0 : ℝ) ≤ max L 2 := le_trans (by norm_num) (le_max_right L 2)
    have hexp : Real.exp (-4 * (max L 2) ^ 7) ≤ 1 := by
      rw [Real.exp_le_one_iff]
      have hp : 0 ≤ (max L 2) ^ 7 := pow_nonneg hmax 7
      linarith
    have hbase : 1 ≤ 1 + S.H + S.c := by linarith [S.H_pos, S.c_pos]
    have hpow : 1 ≤ (1 + S.H + S.c) ^ 3 := one_le_pow₀ hbase
    have hden_pos : 0 < 10000 * (1 + S.H + S.c) ^ 3 := by positivity
    rw [div_le_iff₀ hden_pos]
    linarith
  have hStep_nonneg : ∀ (L : ℝ) (y : ℂ), 0 ≤ adaptiveStepRadius S P L y := by
    intro L y
    unfold adaptiveStepRadius
    have hC := le_of_lt (hC_pos L)
    have hden : 0 ≤ sliceLocalSupDenom S P y := le_trans zero_le_one (hDenom_ge_one y)
    exact mul_nonneg hC (div_nonneg (pow_nonneg (le_min zero_le_one (hSing_nonneg y)) 4) hden)
  have hStep_pos_iff : ∀ (L : ℝ) (y : ℂ),
      0 < adaptiveStepRadius S P L y ↔ y ∈ Ω_reg := by
    intro L y
    constructor
    · intro hpos
      by_contra hy
      have h0 : sliceSingDist S P y = 0 := hSing_zero y hy
      unfold adaptiveStepRadius at hpos
      rw [h0, min_eq_right zero_le_one] at hpos
      norm_num at hpos
    · intro hy
      unfold adaptiveStepRadius
      have hd_pos : 0 < min 1 (sliceSingDist S P y) :=
        lt_min zero_lt_one ((hSing_pos_iff y).mpr hy)
      have hden_pos : 0 < sliceLocalSupDenom S P y :=
        lt_of_lt_of_le zero_lt_one (hDenom_ge_one y)
      exact mul_pos (hC_pos L) (div_pos (pow_pos hd_pos 4) hden_pos)
  have hStep_le_sing : ∀ (L : ℝ) (y : ℂ),
      adaptiveStepRadius S P L y ≤ (1 / 100 : ℝ) * min 1 (sliceSingDist S P y) := by
    intro L y
    unfold adaptiveStepRadius
    let d : ℝ := min 1 (sliceSingDist S P y)
    have hd0 : 0 ≤ d := le_min zero_le_one (hSing_nonneg y)
    have hd1 : d ≤ 1 := min_le_left 1 _
    have hd3 : d ^ 3 ≤ 1 := pow_le_one₀ hd0 hd1
    have hd4_le_d : d ^ 4 ≤ d := by
      calc d ^ 4 = d ^ 3 * d := by ring
      _ ≤ 1 * d := mul_le_mul_of_nonneg_right hd3 hd0
      _ = d := one_mul d
    have hfrac_le : d ^ 4 / sliceLocalSupDenom S P y ≤ d :=
      le_trans (div_le_self (pow_nonneg hd0 4) (hDenom_ge_one y)) hd4_le_d
    have hfrac_nonneg : 0 ≤ d ^ 4 / sliceLocalSupDenom S P y :=
      div_nonneg (pow_nonneg hd0 4) (le_trans zero_le_one (hDenom_ge_one y))
    exact mul_le_mul (hC_le L) hfrac_le hfrac_nonneg (by norm_num)
  have hStep_per : ∀ (L : ℝ) (y : ℂ),
      adaptiveStepRadius S P L (y + 2 * Real.pi) = adaptiveStepRadius S P L y := by
    intro L y
    by_cases hy : y ∈ Ω_reg
    · have hd_eq : sliceSingDist S P (y + 2 * Real.pi) = sliceSingDist S P y := hSing_per y
      have hr_eq : sliceSafeBallRad S P (y + 2 * Real.pi) = sliceSafeBallRad S P y := by
        unfold sliceSafeBallRad
        rw [hd_eq]
      have hDen_eq : sliceLocalSupDenom S P (y + 2 * Real.pi) = sliceLocalSupDenom S P y := by
        unfold sliceLocalSupDenom
        congr 1
        refine Finset.sum_congr rfl fun k _ => ?_
        congr 1
        refine Set.image_congr fun u hu => ?_
        rw [hr_eq]
        have hζ_mem : y + (sliceSafeBallRad S P y : ℂ) * u ∈ horizStrip h :=
          (hAff_mem_reg y hy u hu).1
        have h_add : (y + 2 * Real.pi) + (sliceSafeBallRad S P y : ℂ) * u =
            (y + (sliceSafeBallRad S P y : ℂ) * u) + 2 * Real.pi := by ring
        rw [h_add]
        exact hTerm_per k _ hζ_mem
      unfold adaptiveStepRadius
      rw [hd_eq, hDen_eq]
    · have hy2 : y + 2 * Real.pi ∉ Ω_reg := by
        intro hy2_in
        have hd_pos : 0 < sliceSingDist S P y := by
          rw [← hSing_per y]
          exact (hSing_pos_iff _).mpr hy2_in
        exact hy ((hSing_pos_iff y).mp hd_pos)
      unfold adaptiveStepRadius
      rw [hSing_zero _ hy2, hSing_zero _ hy, min_eq_right zero_le_one]
      norm_num
  have hStep_cont : ∀ L : ℝ, Continuous (adaptiveStepRadius S P L) := by
    intro L
    have hDen_contOn : ContinuousOn (sliceLocalSupDenom S P) Ω_reg :=
      continuousOn_const.add (continuousOn_finsetSum Finset.univ (fun k _ => hM_contOn k))
    rw [continuous_iff_continuousAt]
    intro y₀
    by_cases hy₀ : y₀ ∈ Ω_reg
    · have hDen_at : ContinuousAt (sliceLocalSupDenom S P) y₀ :=
        hDen_contOn.continuousAt (P.reg_open.mem_nhds hy₀)
      have hDen_ne : sliceLocalSupDenom S P y₀ ≠ 0 :=
        ne_of_gt (lt_of_lt_of_le zero_lt_one (hDenom_ge_one y₀))
      have hNum_cont : Continuous (fun y : ℂ => (min 1 (sliceSingDist S P y)) ^ 4) :=
        (continuous_const.min hSing_cont).pow 4
      unfold adaptiveStepRadius
      exact continuousAt_const.mul (hNum_cont.continuousAt.div hDen_at hDen_ne)
    · have hd0 : sliceSingDist S P y₀ = 0 := hSing_zero y₀ hy₀
      have hval0 : adaptiveStepRadius S P L y₀ = 0 := by
        unfold adaptiveStepRadius
        rw [hd0, min_eq_right zero_le_one]
        norm_num
      rw [ContinuousAt, hval0]
      let g : ℂ → ℝ := fun y => (1 / 100 : ℝ) * min 1 (sliceSingDist S P y)
      have hg_cont : Continuous g :=
        continuous_const.mul (continuous_const.min hSing_cont)
      have hg0 : g y₀ = 0 := by
        simp [g, hd0]
      have hg_tendsto : Filter.Tendsto g (nhds y₀) (nhds 0) := by
        rw [← hg0]
        exact hg_cont.continuousAt
      exact tendsto_of_tendsto_of_tendsto_of_le_of_le
        tendsto_const_nhds hg_tendsto (hStep_nonneg L) (hStep_le_sing L)
  exact
    { cont := hStep_cont
      periodic := hStep_per
      nonneg := hStep_nonneg
      pos_iff := hStep_pos_iff
      le_sing_dist := hStep_le_sing
      denom_ge_one := hDenom_ge_one
      safe_ball_sub_and_le := hSafe_ball_sub_and_le }

theorem adaptive_step_analytic_bounds (S : FiniteWallNonisotropicStrip)
    (P : OddPeriodicSliceData S) (hTop : AdaptiveStepTopPackage S P) :
    ∀ L : ℝ, 2 ≤ L → IsScaleAdmissibleStep S P (L ^ 2) (adaptiveStepRadius S P L) :=
by
  have h_strip_cayley : ∀ (H : ℝ) (f : ℂ → ℂ) (y : ℂ) (r_y : ℝ),
      0 < r_y → DifferentiableOn ℂ f (Metric.ball y r_y) →
      (∀ ζ ∈ Metric.ball y r_y, |(f ζ).im| < H) →
      (∀ ζ : ℂ, ∀ θ : ℝ, 0 ≤ θ → θ < 1 → ‖ζ - y‖ ≤ θ * r_y →
        ‖f ζ - f y‖ ≤ (2 * ‖ζ - y‖ / ((1 - θ) * r_y)) * (H - |(f y).im|)) ∧
      (∀ r : ℝ, 0 < r → r ≤ r_y / 4 → ∀ ζ ∈ Metric.closedBall y r,
        ‖deriv f ζ‖ ≤ 2 * H / r) := by
    intro H f y r_y hr_y hf_holo hf_maps
    have hy_mem : y ∈ Metric.ball y r_y := Metric.mem_ball_self hr_y
    have hfy_im : |(f y).im| < H := hf_maps y hy_mem
    let δ_y : ℝ := H - |(f y).im|
    have hδ_pos : 0 < δ_y := sub_pos.mpr hfy_im
    let ε : ℝ := if 0 ≤ (f y).im then 1 else -1
    have hε_norm : ‖(ε : ℂ)‖ = 1 := by
      dsimp only [ε]; split_ifs <;> simp
    have hε_fy : ε * (f y).im = |(f y).im| := by
      dsimp only [ε]; split_ifs with h0
      · simp [abs_of_nonneg h0]
      · simp [abs_of_neg (not_le.mp h0)]
    have hε_le : ∀ a : ℝ, ε * a ≤ |a| := by
      intro a; dsimp only [ε]; split_ifs
      · simpa using le_abs_self a
      · simpa using neg_le_abs a
    let g : ℂ → ℂ := fun w => (H : ℂ) + (ε : ℂ) * Complex.I * (f w - ((f y).re : ℂ))
    have hg_re : ∀ w : ℂ, (g w).re = H - ε * (f w).im := by
      intro w
      simp only [g, Complex.add_re, Complex.ofReal_re, mul_assoc, Complex.mul_re,
        Complex.ofReal_im, zero_mul, sub_zero, Complex.I_re, Complex.I_im, one_mul,
        Complex.sub_im]
      ring
    have hg_im : ∀ w : ℂ, (g w).im = ε * ((f w).re - (f y).re) := by
      intro w
      simp only [g, Complex.add_im, Complex.ofReal_im, zero_add, mul_assoc, Complex.mul_im,
        Complex.ofReal_re, zero_mul, add_zero, Complex.I_re, Complex.I_im, one_mul,
        Complex.sub_re]
    have hg_y : g y = (δ_y : ℂ) := by
      apply Complex.ext
      · rw [hg_re y, Complex.ofReal_re, hε_fy]
      · rw [hg_im y, Complex.ofReal_im]; ring
    have hg_sub_eq : ∀ w : ℂ, g w - (δ_y : ℂ) = (ε : ℂ) * Complex.I * (f w - f y) := by
      intro w; rw [← hg_y]; dsimp only [g]; ring
    have hg_sub_norm : ∀ w : ℂ, ‖g w - (δ_y : ℂ)‖ = ‖f w - f y‖ := by
      intro w; rw [hg_sub_eq w, norm_mul, norm_mul, hε_norm, Complex.norm_I, one_mul, one_mul]
    have hg_re_pos : ∀ w ∈ Metric.ball y r_y, 0 < (g w).re := by
      intro w hw
      linarith [hg_re w, hf_maps w hw, hε_le (f w).im]
    have hg_den_ne : ∀ w ∈ Metric.ball y r_y, g w + (δ_y : ℂ) ≠ 0 := by
      intro w hw h0
      have hre : (g w + (δ_y : ℂ)).re = (g w).re + δ_y := by simp
      rw [h0, Complex.zero_re] at hre
      linarith [hg_re_pos w hw]
    let Φ : ℂ → ℂ := fun w => (g w - (δ_y : ℂ)) / (g w + (δ_y : ℂ))
    have hΦ_y : Φ y = 0 := by simp [Φ, hg_y]
    have hg_holo : DifferentiableOn ℂ g (Metric.ball y r_y) :=
      (differentiableOn_const _).add
        (((differentiableOn_const _).mul (differentiableOn_const _)).mul
          (hf_holo.sub (differentiableOn_const _)))
    have hΦ_holo : DifferentiableOn ℂ Φ (Metric.ball y r_y) :=
      (hg_holo.sub (differentiableOn_const _)).div
        (hg_holo.add (differentiableOn_const _)) hg_den_ne
    have hΦ_maps : Set.MapsTo Φ (Metric.ball y r_y) (Metric.closedBall (Φ y) 1) := by
      intro w hw
      rw [Metric.mem_closedBall, hΦ_y, dist_zero_right]
      dsimp only [Φ]
      rw [norm_div, div_le_one (norm_pos_iff.mpr (hg_den_ne w hw)),
        Complex.norm_def, Complex.norm_def]
      apply Real.sqrt_le_sqrt
      simp only [Complex.normSq_apply, Complex.sub_re, Complex.sub_im, Complex.add_re,
        Complex.add_im, Complex.ofReal_re, Complex.ofReal_im, sub_zero, add_zero]
      nlinarith [hg_re_pos w hw, hδ_pos]
    have h_osc : ∀ ζ : ℂ, ∀ θ : ℝ, 0 ≤ θ → θ < 1 → ‖ζ - y‖ ≤ θ * r_y →
        ‖f ζ - f y‖ ≤ (2 * ‖ζ - y‖ / ((1 - θ) * r_y)) * δ_y := by
      intro ζ θ _hθ₀ hθ₁ hζ_le
      have hζ_mem : ζ ∈ Metric.ball y r_y := by
        rw [Metric.mem_ball, dist_eq_norm]; nlinarith
      have h_sp := Complex.dist_le_div_mul_dist_of_mapsTo_ball hΦ_holo hΦ_maps hζ_mem
      rw [hΦ_y, dist_zero_right, dist_eq_norm] at h_sp
      have hΦ_le_θ : ‖Φ ζ‖ ≤ θ := by
        calc ‖Φ ζ‖ ≤ 1 / r_y * ‖ζ - y‖ := h_sp
          _ ≤ 1 / r_y * (θ * r_y) := mul_le_mul_of_nonneg_left hζ_le (by positivity)
          _ = θ := by field_simp
      have h_alg : (1 - Φ ζ) * (g ζ - (δ_y : ℂ)) = 2 * (δ_y : ℂ) * Φ ζ := by
        have hne := hg_den_ne ζ hζ_mem
        dsimp only [Φ]
        field_simp
        ring
      have h_norm_eq : ‖(1 : ℂ) - Φ ζ‖ * ‖f ζ - f y‖ = 2 * δ_y * ‖Φ ζ‖ := by
        have h1 := congrArg norm h_alg
        rw [norm_mul, hg_sub_norm ζ, norm_mul, norm_mul, Complex.norm_ofNat,
          Complex.norm_real, Real.norm_eq_abs, abs_of_pos hδ_pos] at h1
        exact h1
      have h_one_sub : 1 - θ ≤ ‖(1 : ℂ) - Φ ζ‖ := by
        have h2 := norm_sub_norm_le (1 : ℂ) (Φ ζ)
        rw [norm_one] at h2
        linarith
      have h_one_sub_pos : 0 < 1 - θ := sub_pos.mpr hθ₁
      have h_prod : (1 - θ) * ‖f ζ - f y‖ ≤ 2 * δ_y * (1 / r_y * ‖ζ - y‖) := by
        calc (1 - θ) * ‖f ζ - f y‖ ≤ ‖(1 : ℂ) - Φ ζ‖ * ‖f ζ - f y‖ :=
              mul_le_mul_of_nonneg_right h_one_sub (norm_nonneg _)
          _ = 2 * δ_y * ‖Φ ζ‖ := h_norm_eq
          _ ≤ 2 * δ_y * (1 / r_y * ‖ζ - y‖) :=
              mul_le_mul_of_nonneg_left h_sp (by positivity)
      rw [div_mul_eq_mul_div, le_div_iff₀ (mul_pos h_one_sub_pos hr_y)]
      have h_rhs : 2 * δ_y * (1 / r_y * ‖ζ - y‖) * r_y = 2 * ‖ζ - y‖ * δ_y := by
        field_simp
      nlinarith [mul_le_mul_of_nonneg_right h_prod hr_y.le]
    refine ⟨h_osc, ?_⟩
    intro r hr_pos hr_le ζ hζ
    let f₀ : ℂ → ℂ := fun w => f w - f y
    have h_sub_ball : Metric.closedBall ζ r ⊆ Metric.ball y r_y := by
      intro w hw
      rw [Metric.mem_closedBall, dist_eq_norm] at hw hζ
      rw [Metric.mem_ball, dist_eq_norm]
      have h_tri : ‖w - y‖ ≤ ‖w - ζ‖ + ‖ζ - y‖ := by
        simpa using norm_add_le (w - ζ) (ζ - y)
      linarith
    have hf₀_holo : DifferentiableOn ℂ f₀ (Metric.ball y r_y) :=
      hf_holo.sub (differentiableOn_const _)
    have hf₀_dc : DiffContOnCl ℂ f₀ (Metric.ball ζ r) :=
      hf₀_holo.diffContOnCl_ball h_sub_ball
    have hf₀_sph : ∀ w ∈ Metric.sphere ζ r, ‖f₀ w‖ ≤ 2 * H := by
      intro w hw
      have hw_cb : w ∈ Metric.closedBall ζ r := Metric.sphere_subset_closedBall hw
      rw [Metric.mem_closedBall, dist_eq_norm] at hw_cb hζ
      have h_tri : ‖w - y‖ ≤ (1 / 2 : ℝ) * r_y := by
        have h1 : ‖w - y‖ ≤ ‖w - ζ‖ + ‖ζ - y‖ := by
          simpa using norm_add_le (w - ζ) (ζ - y)
        linarith
      have h_b := h_osc w (1 / 2) (by norm_num) (by norm_num) h_tri
      have h_frac : 2 * ‖w - y‖ / ((1 - 1 / 2) * r_y) ≤ 2 := by
        rw [div_le_iff₀ (by positivity)]
        linarith
      have hδ_le_H : δ_y ≤ H := sub_le_self H (abs_nonneg _)
      calc ‖f₀ w‖ = ‖f w - f y‖ := rfl
        _ ≤ (2 * ‖w - y‖ / ((1 - 1 / 2) * r_y)) * δ_y := h_b
        _ ≤ 2 * δ_y := mul_le_mul_of_nonneg_right h_frac hδ_pos.le
        _ ≤ 2 * H := by linarith
    have h_cau := Complex.norm_deriv_le_of_forall_mem_sphere_norm_le hr_pos hf₀_dc hf₀_sph
    simpa only [f₀, deriv_sub_const] using h_cau
  have h_holo_taylor_and_log : ∀ {U : Set ℂ}, IsOpen U →
      (∀ (g : ℂ → ℂ) (y : ℂ) (r₁ K₁ : ℝ),
        DifferentiableOn ℂ g U → 0 < r₁ → 0 ≤ K₁ → Metric.closedBall y r₁ ⊆ U →
        (∀ ζ ∈ Metric.closedBall y r₁, ‖deriv g ζ‖ ≤ K₁) →
        (∀ ζ ∈ Metric.closedBall y r₁, ‖g ζ - g y‖ ≤ K₁ * ‖ζ - y‖) ∧
        (∀ z : ℂ, ‖z‖ ≤ r₁ / 2 →
          ‖g (y + z) - g y - deriv g y * z‖ ≤ (2 * K₁ / r₁) * ‖z‖ ^ 2)) ∧
      (∀ (g : ℂ → ℂ) (y : ℂ) (r B : ℝ),
        DifferentiableOn ℂ g U → 0 < r → 1 ≤ B → Metric.closedBall y r ⊆ U →
        (∀ ζ ∈ Metric.closedBall y r, B⁻¹ ≤ ‖g ζ‖ ∧ ‖g ζ‖ ≤ B) →
        ∀ z : ℂ, ‖z‖ ≤ r / 2 →
          |Real.log ‖g (y + z)‖ - Real.log ‖g y‖| ≤ (2 * B ^ 2 / r) * ‖z‖) := by
    intro U hU
