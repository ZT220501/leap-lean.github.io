        rw [frontier_ball (0 : ℂ) hr_m_pos.ne', Metric.mem_sphere, dist_zero_right] at hτ
        have h_eq_norm : r_m ^ 2 * ‖h₂ τ‖ = ‖g τ‖ := by
          calc r_m ^ 2 * ‖h₂ τ‖ = ‖τ‖ ^ 2 * ‖h₂ τ‖ := by rw [hτ]
            _ = ‖τ ^ 2 * h₂ τ‖ := by rw [norm_mul, norm_pow]
            _ = ‖g τ‖ := by rw [h_mul τ]
