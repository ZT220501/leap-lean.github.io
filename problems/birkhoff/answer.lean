      have h1 := hk ⟨z, hz⟩
      have hv_eq : v_k (τ k) z = u_fn (φ₁ (η (τ k))) z := by simp [v_k, hkN]
      simpa [F, hz, hv_eq] using h1
    let nextSub (m : ℕ) (η : ℕ → ℕ) (hη : StrictMono η) :
