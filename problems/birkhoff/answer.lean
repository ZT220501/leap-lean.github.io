      ‖deriv (fun t : ℂ => K_err (y, t)) (t₀ : ℂ)‖ ≤ M_K / (δ / 8) := hKt_deriv_raw
      _ = (8 * δ⁻¹) * M_K := hdiv_eq
      _ ≤ (8 * Q₀) * M_K := mul_le_mul_of_nonneg_right h8_le hM_K_nonneg
      _ = M_quad_raw := rfl

theorem positive_rational_jet_lift (Ω : Set Plane)
    (B : AnalyticBoundaryData Ω)
    (S : GlancingScalePackage B) :
    PositiveJetLiftProp B S :=
by
  intro hCyc
  obtain ⟨C_z, hC_z, hSolve⟩ := prelim_lift_and_cyclic_jet_solve Ω B S hCyc
  have hReg := affine_jet_regularity_and_linear_bounds Ω B S hCyc
  have hQuad := exact_jet_cancellation_and_quad_bounds Ω B S
  let C_jet : ℝ := 1 + 10 * C_z
  let C_quad_out : ℝ := 8 * (3 * C_jet + S.C_quad * C_jet ^ 2)
  let B_lift : ℕ := 15
  let C_lift : ℝ := max ((8 / S.η_adm) * C_jet) (max (6 * C_jet) C_quad_out)
  have hη_adm_pos : 0 < S.η_adm := S.η_adm_pos
  have hC_quad_pos : 0 < S.C_quad := S.C_quad_pos
  have hC_jet_ge : 11 ≤ C_jet := by dsimp [C_jet]; linarith
  have hC_lift_ge_adm : (8 / S.η_adm) * C_jet ≤ C_lift := le_max_left _ _
  have hC_lift_ge_lin : 6 * C_jet ≤ C_lift := le_trans (le_max_left _ _) (le_max_right _ _)
  have hC_lift_ge_quad : C_quad_out ≤ C_lift := le_trans (le_max_right _ _) (le_max_right _ _)
  have hC_lift_ge_one : 1 ≤ C_lift := by linarith
  refine ⟨C_lift, B_lift, hC_lift_ge_one, ?_⟩
  intro s d δ ε η_slice N l q U U_star
    hs0 hs_act hd0 hd_act hd_half hδ0 hδ_lt hε0 hε1 hη_slice0 hN
    hU hRes hl1 hq2 hqN _hCop t₀ ht₀_lt hU_star Q η_tot hSmall

  have hδ_inv_pos : 0 < δ⁻¹ := inv_pos.mpr hδ0
  set Q₀ : ℝ := 1 + δ⁻¹
  have hQ₀_ge_one : 1 ≤ Q₀ := by dsimp [Q₀]; linarith
  have hQ₀_le_Q : Q₀ ≤ Q := by
    have hN_nonneg : (0 : ℝ) ≤ (N : ℝ) := Nat.cast_nonneg N
    change 1 + δ⁻¹ ≤ 1 + (N : ℝ) + δ⁻¹
    linarith
  have hQ_ge_one : 1 ≤ Q := le_trans hQ₀_ge_one hQ₀_le_Q
  have hQ_pos : 0 ≤ Q := by linarith
  have hη_tot_pos : 0 < η_tot := by change 0 < ε + η_slice; linarith
  have hη_tot_nonneg : 0 ≤ η_tot := le_of_lt hη_tot_pos
  have ht₀_pos : 0 < t₀ := by
    have hpi : 0 < Real.pi := by linarith [Real.pi_gt_three]
    change 0 < (2 * Real.pi * (l : ℝ)) / (q : ℝ)
    positivity

  set M_z : ℝ := C_z * Q ^ 5 * η_tot
  set ρ_jet : ℝ := η_slice + 10 * Q₀ ^ 2 * M_z
  have hM_z_nonneg : 0 ≤ M_z := by positivity
  have hρ_jet_nonneg : 0 ≤ ρ_jet := by positivity
  have hρ_jet_le : ρ_jet ≤ C_jet * Q ^ 7 * η_tot := by
    have h1 : (1 : ℝ) ≤ Q ^ 7 := one_le_pow₀ hQ_ge_one
    have hslice_le : η_slice ≤ Q ^ 7 * η_tot := by
      have hle : η_slice ≤ η_tot := by change η_slice ≤ ε + η_slice; linarith
      calc
        η_slice ≤ 1 * η_tot := by linarith
        _ ≤ Q ^ 7 * η_tot := mul_le_mul_of_nonneg_right h1 hη_tot_nonneg
    have hQ₀_sq : Q₀ ^ 2 ≤ Q ^ 2 :=
      pow_le_pow_left₀ (by linarith) hQ₀_le_Q 2
    have hMz_le : 10 * Q₀ ^ 2 * M_z ≤ 10 * C_z * Q ^ 7 * η_tot := by
      have hmul : Q₀ ^ 2 * M_z ≤ Q ^ 2 * M_z :=
        mul_le_mul_of_nonneg_right hQ₀_sq hM_z_nonneg
      calc
        10 * Q₀ ^ 2 * M_z = 10 * (Q₀ ^ 2 * M_z) := by ring
        _ ≤ 10 * (Q ^ 2 * M_z) := mul_le_mul_of_nonneg_left hmul (by norm_num)
        _ = 10 * C_z * Q ^ 7 * η_tot := by dsimp [M_z]; ring
    calc
      ρ_jet = η_slice + 10 * Q₀ ^ 2 * M_z := rfl
      _ ≤ Q ^ 7 * η_tot + 10 * C_z * Q ^ 7 * η_tot := by linarith
      _ = C_jet * Q ^ 7 * η_tot := by dsimp [C_jet]; ring

  have hρ_jet_adm : ρ_jet ≤ S.η_adm / 8 := by
    have hpow : Q ^ 7 ≤ Q ^ B_lift :=
      pow_le_pow_right₀ hQ_ge_one (by dsimp [B_lift]; omega)
    have hc_pos : 0 ≤ (8 / S.η_adm) * C_jet := by positivity
    have hstep1 : (8 / S.η_adm) * ρ_jet ≤ (8 / S.η_adm) * (C_jet * Q ^ 7 * η_tot) :=
      mul_le_mul_of_nonneg_left hρ_jet_le (by positivity)
    have hstep2 : ((8 / S.η_adm) * C_jet) * Q ^ 7 ≤ C_lift * Q ^ B_lift :=
      mul_le_mul hC_lift_ge_adm hpow (by positivity) (by linarith)
    have hmul : (8 / S.η_adm) * ρ_jet ≤ 1 := by
      calc
        (8 / S.η_adm) * ρ_jet ≤ ((8 / S.η_adm) * C_jet * Q ^ 7) * η_tot := by linarith
        _ ≤ (C_lift * Q ^ B_lift) * η_tot := mul_le_mul_of_nonneg_right hstep2 hη_tot_nonneg
        _ ≤ 1 := hSmall
    have h8 : 8 * ρ_jet ≤ S.η_adm := by
      have hle := mul_le_mul_of_nonneg_left hmul (le_of_lt hη_adm_pos)
      have hcancel : S.η_adm * ((8 / S.η_adm) * ρ_jet) = 8 * ρ_jet := by
        field_simp [ne_of_gt hη_adm_pos]
      linarith
    linarith

  have hη_slice_adm : η_slice ≤ S.η_adm / 8 := by
    have hnonneg : 0 ≤ 10 * Q₀ ^ 2 * M_z := by positivity
    have hle : η_slice ≤ ρ_jet := by dsimp [ρ_jet]; linarith
    exact le_trans hle hρ_jet_adm

  obtain ⟨z, hz_holo, hz_per, hz_bnd, hz_cancel⟩ :=
    hSolve s d δ ε η_slice N l q U U_star
      hs0 hs_act hd0 hd_act hd_half hδ0 hδ_lt hε0 hε1 hη_slice0 hη_slice_adm hN
      hU hRes hl1 hq2 hqN ht₀_lt hU_star

  obtain ⟨hU_tilde_holo7, hW_plus_holo7, hU_tilde_jet7, hW_plus_bnd7,
      hW_plus_holo8, hW_plus_per8, hg_plus_holo9, hg_plus_bounds9,
      hH_plus_holo9_4, hH_plus_holo10_8, hH_plus_dt_holo10⟩ :=
    hReg s d δ η_slice M_z t₀ l q U U_star z
      hs0 hs_act hd0 hd_act hd_half hδ0 hδ_lt hη_slice0 hM_z_nonneg
      hU ht₀_pos ht₀_lt rfl hU_star hz_holo
      (fun y hy => ⟨hz_per y hy, hz_bnd y hy⟩) hρ_jet_adm

  have hQuad_bounds :=
    hQuad s d δ ε η_slice ρ_jet t₀ l q U U_star z
      hs0 hs_act hd0 hd_act hd_half hδ0 hδ_lt hε0 hη_slice0 hρ_jet_nonneg hρ_jet_adm
      hU hRes ht₀_pos ht₀_lt rfl hU_star hz_holo hz_cancel
      hU_tilde_holo7 hW_plus_holo7 hU_tilde_jet7 hW_plus_bnd7 hH_plus_holo9_4

  have hM_lin_le : 6 * Q₀ * ρ_jet ≤ C_lift * Q ^ B_lift * η_tot := by
    have hpow : Q ^ 8 ≤ Q ^ B_lift :=
      pow_le_pow_right₀ hQ_ge_one (by dsimp [B_lift]; omega)
    have h1 : Q₀ * ρ_jet ≤ Q * (C_jet * Q ^ 7 * η_tot) :=
      mul_le_mul hQ₀_le_Q hρ_jet_le hρ_jet_nonneg hQ_pos
    have h2 : (6 * C_jet) * Q ^ 8 ≤ C_lift * Q ^ B_lift :=
      mul_le_mul hC_lift_ge_lin hpow (by positivity) (by linarith)
    calc
      6 * Q₀ * ρ_jet = 6 * (Q₀ * ρ_jet) := by ring
      _ ≤ 6 * (Q * (C_jet * Q ^ 7 * η_tot)) := mul_le_mul_of_nonneg_left h1 (by norm_num)
      _ = ((6 * C_jet) * Q ^ 8) * η_tot := by ring
      _ ≤ (C_lift * Q ^ B_lift) * η_tot := mul_le_mul_of_nonneg_right h2 hη_tot_nonneg

  have hM_quad_le :
      8 * Q₀ * (3 * Q₀ * ε * ρ_jet + S.C_quad * ρ_jet ^ 2) ≤
        C_lift * Q ^ B_lift * η_tot ^ 2 := by
    have hpow8_14 : Q ^ 8 ≤ Q ^ 14 := pow_le_pow_right₀ hQ_ge_one (by omega)
    have hε_le_tot : ε ≤ η_tot := by change ε ≤ ε + η_slice; linarith
    have hQ₀ε : Q₀ * ε ≤ Q * η_tot :=
      mul_le_mul hQ₀_le_Q hε_le_tot (le_of_lt hε0) hQ_pos
    have hterm1_8 : (Q₀ * ε) * ρ_jet ≤ (Q * η_tot) * (C_jet * Q ^ 7 * η_tot) :=
      mul_le_mul hQ₀ε hρ_jet_le hρ_jet_nonneg (by positivity)
    have hterm1 : 3 * Q₀ * ε * ρ_jet ≤ 3 * C_jet * Q ^ 14 * η_tot ^ 2 := by
      have hpow_mul : Q ^ 8 * (3 * C_jet * η_tot ^ 2) ≤ Q ^ 14 * (3 * C_jet * η_tot ^ 2) :=
        mul_le_mul_of_nonneg_right hpow8_14 (by positivity)
      calc
        3 * Q₀ * ε * ρ_jet = 3 * ((Q₀ * ε) * ρ_jet) := by ring
        _ ≤ 3 * ((Q * η_tot) * (C_jet * Q ^ 7 * η_tot)) :=
            mul_le_mul_of_nonneg_left hterm1_8 (by norm_num)
        _ = Q ^ 8 * (3 * C_jet * η_tot ^ 2) := by ring
        _ ≤ Q ^ 14 * (3 * C_jet * η_tot ^ 2) := hpow_mul
        _ = 3 * C_jet * Q ^ 14 * η_tot ^ 2 := by ring
    have hρ_sq : ρ_jet ^ 2 ≤ (C_jet * Q ^ 7 * η_tot) ^ 2 :=
      pow_le_pow_left₀ hρ_jet_nonneg hρ_jet_le 2
    have hterm2 : S.C_quad * ρ_jet ^ 2 ≤ S.C_quad * C_jet ^ 2 * Q ^ 14 * η_tot ^ 2 := by
      calc
        S.C_quad * ρ_jet ^ 2 ≤ S.C_quad * (C_jet * Q ^ 7 * η_tot) ^ 2 :=
            mul_le_mul_of_nonneg_left hρ_sq (le_of_lt hC_quad_pos)
        _ = S.C_quad * C_jet ^ 2 * Q ^ 14 * η_tot ^ 2 := by ring
    have hsum : 3 * Q₀ * ε * ρ_jet + S.C_quad * ρ_jet ^ 2 ≤
        (3 * C_jet + S.C_quad * C_jet ^ 2) * Q ^ 14 * η_tot ^ 2 := by
      linarith
    have hprod : Q₀ * (3 * Q₀ * ε * ρ_jet + S.C_quad * ρ_jet ^ 2) ≤
        Q * ((3 * C_jet + S.C_quad * C_jet ^ 2) * Q ^ 14 * η_tot ^ 2) :=
      mul_le_mul hQ₀_le_Q hsum (by positivity) hQ_pos
    calc
      8 * Q₀ * (3 * Q₀ * ε * ρ_jet + S.C_quad * ρ_jet ^ 2) =
          8 * (Q₀ * (3 * Q₀ * ε * ρ_jet + S.C_quad * ρ_jet ^ 2)) := by ring
      _ ≤ 8 * (Q * ((3 * C_jet + S.C_quad * C_jet ^ 2) * Q ^ 14 * η_tot ^ 2)) :=
          mul_le_mul_of_nonneg_left hprod (by norm_num)
      _ = C_quad_out * (Q ^ B_lift * η_tot ^ 2) := by dsimp [C_quad_out, B_lift]; ring
      _ ≤ C_lift * (Q ^ B_lift * η_tot ^ 2) :=
          mul_le_mul_of_nonneg_right hC_lift_ge_quad (by positivity)
      _ = C_lift * Q ^ B_lift * η_tot ^ 2 := by ring

  refine ⟨glancingJetWitness t₀ U U_star z, hW_plus_holo8, hW_plus_per8,
    hg_plus_holo9, ?_, hH_plus_holo10_8, hH_plus_dt_holo10, ?_⟩
  · intro y hy t ht
    obtain ⟨hper, hgn, hWn⟩ := hg_plus_bounds9 y hy t ht
    exact ⟨hper, le_trans hgn hM_lin_le, le_trans hWn hM_lin_le⟩
  · intro y hy
    obtain ⟨hv, hdt⟩ := hQuad_bounds y hy
    exact ⟨le_trans hv hM_quad_le, le_trans hdt hM_quad_le⟩

theorem rational_value_and_jet_compatibility (Ω : Set Plane)
    (B : AnalyticBoundaryData Ω)
    (S : GlancingScalePackage B) :
    RationalCompatProp B S :=
by
  obtain ⟨C_mesh, B_mesh, hC_mesh, hMesh⟩ := stationary_q_mesh_contraction Ω B S
  obtain ⟨C_slice, B_slice, hC_slice, hSlice⟩ := collar_periodic_leaf_exact_slice Ω B S
  have hCyc : CyclicJetAndDiffOpProp := cyclic_jet_and_diffop_calculus
  obtain ⟨C_lift, B_lift, hC_lift, hLift⟩ := positive_rational_jet_lift Ω B S hCyc
  let C_12 : ℝ := C_slice * C_mesh
  let B_12 : ℕ := B_mesh + B_slice
  let C_tot : ℝ := 1 + C_12
  let B_rat : ℕ := B_lift + 2 * B_12
  let C_rat : ℝ := C_lift * C_tot ^ 2
  have hC_12_ge : 1 ≤ C_12 := by nlinarith
  have hC_tot_ge : 2 ≤ C_tot := by linarith
  have hC_rat_pos : 0 < C_rat := by positivity
  refine ⟨C_rat, B_rat, hC_rat_pos, ?_⟩
  intro s d δ ε N U hs0 hs_act hd0 hd_act hd_half hδ0 hδ_lt hε0 hε1 hN hU hSmall hRes
    l q hl hq1 hqN hCop t₀ ht₀
  set Q : ℝ := 1 + (N : ℝ) + δ⁻¹
  have hQ_ge_one : 1 ≤ Q := by
    have hδ_inv_pos : 0 < δ⁻¹ := inv_pos.mpr hδ0
    have hN_nonneg : (0 : ℝ) ≤ (N : ℝ) := Nat.cast_nonneg N
    linarith
  set l_pos : ℕ := l.natAbs
  have hl_pos_ge : 1 ≤ l_pos := Nat.one_le_iff_ne_zero.mpr (Int.natAbs_ne_zero.mpr hl)
  set t_pos : ℝ := (2 * Real.pi * (l_pos : ℝ)) / (q : ℝ)
  have hq_pos : (0 : ℝ) < (q : ℝ) := by positivity
  have hpi_pos : 0 < Real.pi := by linarith [Real.pi_gt_three]
  have hl_abs : (l_pos : ℝ) = |(l : ℝ)| := by
    rcases le_total 0 l with hl0 | hl0
    · have h_int : (l_pos : ℤ) = l := Int.natAbs_of_nonneg hl0
      have h_real : (l_pos : ℝ) = (l : ℝ) := by exact_mod_cast h_int
      have hl0_r : (0 : ℝ) ≤ (l : ℝ) := by exact_mod_cast hl0
      rw [h_real, abs_of_nonneg hl0_r]
    · have h_int : (l_pos : ℤ) = -l := Int.ofNat_natAbs_of_nonpos hl0
      have h_real : (l_pos : ℝ) = -(l : ℝ) := by exact_mod_cast h_int
      have hl0_r : (l : ℝ) ≤ 0 := by exact_mod_cast hl0
      rw [h_real, abs_of_nonpos hl0_r]
  have ht_abs : |t₀| = t_pos := by
    change |(2 * Real.pi * (l : ℝ)) / (q : ℝ)| = (2 * Real.pi * (l_pos : ℝ)) / (q : ℝ)
    rw [abs_div, abs_mul, abs_of_pos (by positivity : (0 : ℝ) < 2 * Real.pi),
      abs_of_pos hq_pos, ← hl_abs]
  have ht_pos_lt : t_pos < d - 2 * δ := by
    rw [← ht_abs]
    exact ht₀
  have hq2 : 2 ≤ q := by
    have hd_lt_one : d < 1 := lt_of_le_of_lt hd_act S.d_act_lt_one
    have ht_pos_lt_one : t_pos < 1 := by linarith
    have h_num_lt_q : 2 * Real.pi * (l_pos : ℝ) < (q : ℝ) := by
      have hdiv : (2 * Real.pi * (l_pos : ℝ)) / (q : ℝ) < 1 := ht_pos_lt_one
      rwa [div_lt_iff₀ hq_pos, one_mul] at hdiv
    have hl_pos_real : (1 : ℝ) ≤ (l_pos : ℝ) := by exact_mod_cast hl_pos_ge
    have h_six_lt_q : (6 : ℝ) < (q : ℝ) := by nlinarith [Real.pi_gt_three]
    have h_six_lt_q_nat : 6 < q := by exact_mod_cast h_six_lt_q
    omega
  have hC_12_le_rat : C_12 ≤ C_rat := by
    change C_12 ≤ C_lift * C_tot ^ 2
    nlinarith
  have hC_mesh_le_12 : C_mesh ≤ C_12 := by
    change C_mesh ≤ C_slice * C_mesh
    nlinarith
  have hSmall_mesh : C_mesh * Q ^ B_mesh * ε ≤ 1 := by
    have hpow : Q ^ B_mesh ≤ Q ^ B_rat :=
      pow_le_pow_right₀ hQ_ge_one (by dsimp [B_rat, B_12]; omega)
    have hC : C_mesh ≤ C_rat := le_trans hC_mesh_le_12 hC_12_le_rat
    have hle : C_mesh * Q ^ B_mesh * ε ≤ C_rat * Q ^ B_rat * ε := by
      gcongr
    exact le_trans hle hSmall
  obtain ⟨X_mesh, hX_mesh⟩ :=
    hMesh s d δ ε N l_pos q U hs0 hs_act hd0 hd_act hd_half hδ0 hδ_lt hε0 hε1 hN
      hU hRes hl_pos_ge hq2 hqN hCop ht_pos_lt hSmall_mesh
  set η_mesh : ℝ := C_mesh * Q ^ B_mesh * ε
  have hη_mesh_pos : 0 < η_mesh := by positivity
  have h_slice_prod : C_slice * Q ^ B_slice * η_mesh = C_12 * Q ^ B_12 * ε := by
    change C_slice * Q ^ B_slice * (C_mesh * Q ^ B_mesh * ε) =
      (C_slice * C_mesh) * Q ^ (B_mesh + B_slice) * ε
    rw [pow_add]
    ring
  have hSmall_slice : C_slice * Q ^ B_slice * η_mesh ≤ 1 := by
    rw [h_slice_prod]
    have hpow : Q ^ B_12 ≤ Q ^ B_rat :=
      pow_le_pow_right₀ hQ_ge_one (by dsimp [B_rat]; omega)
    have hle : C_12 * Q ^ B_12 * ε ≤ C_rat * Q ^ B_rat * ε := by
      gcongr
    exact le_trans hle hSmall
  obtain ⟨U_star, hU_star⟩ :=
    hSlice s d δ η_mesh N l_pos q U X_mesh hs0 hs_act hd0 hd_act hd_half hδ0 hδ_lt
      hη_mesh_pos hN hU hl_pos_ge hq2 hqN hCop ht_pos_lt hX_mesh hSmall_slice
  set η_slice : ℝ := C_slice * Q ^ B_slice * η_mesh
  have hη_slice_nonneg : 0 ≤ η_slice := by positivity
  set η_tot : ℝ := ε + η_slice
  have hη_tot_nonneg : 0 ≤ η_tot := by positivity
  have hη_tot_le : η_tot ≤ C_tot * Q ^ B_12 * ε := by
    have h1 : (1 : ℝ) ≤ Q ^ B_12 := one_le_pow₀ hQ_ge_one
    have hε_le : ε ≤ 1 * Q ^ B_12 * ε := by nlinarith
    calc
      η_tot = ε + C_12 * Q ^ B_12 * ε := by rw [← h_slice_prod]
      _ ≤ 1 * Q ^ B_12 * ε + C_12 * Q ^ B_12 * ε := by linarith
      _ = C_tot * Q ^ B_12 * ε := by dsimp [C_tot]; ring
  have hM_lin_le : C_lift * Q ^ B_lift * η_tot ≤ C_rat * Q ^ B_rat * ε := by
    have hpow : Q ^ (B_lift + B_12) ≤ Q ^ B_rat :=
      pow_le_pow_right₀ hQ_ge_one (by dsimp [B_rat]; omega)
    have hC_tot_sq : C_tot ≤ C_tot ^ 2 := by nlinarith
    calc
      C_lift * Q ^ B_lift * η_tot
          ≤ C_lift * Q ^ B_lift * (C_tot * Q ^ B_12 * ε) := by gcongr
      _ = (C_lift * C_tot) * Q ^ (B_lift + B_12) * ε := by rw [pow_add]; ring
      _ ≤ (C_lift * C_tot ^ 2) * Q ^ B_rat * ε := by gcongr
      _ = C_rat * Q ^ B_rat * ε := rfl
  have hM_quad_le : C_lift * Q ^ B_lift * η_tot ^ 2 ≤ C_rat * Q ^ B_rat * ε ^ 2 := by
    have hpow2 : Q ^ B_rat = Q ^ B_lift * (Q ^ B_12) ^ 2 := by
      change Q ^ (B_lift + 2 * B_12) = Q ^ B_lift * (Q ^ B_12) ^ 2
      rw [pow_add, mul_comm 2 B_12, pow_mul]
    calc
      C_lift * Q ^ B_lift * η_tot ^ 2
          ≤ C_lift * Q ^ B_lift * (C_tot * Q ^ B_12 * ε) ^ 2 := by gcongr
      _ = C_rat * Q ^ B_rat * ε ^ 2 := by
          change C_lift * Q ^ B_lift * (C_tot * Q ^ B_12 * ε) ^ 2 =
            (C_lift * C_tot ^ 2) * Q ^ B_rat * ε ^ 2
          rw [hpow2]
          ring
  have hSmall_lift : C_lift * Q ^ B_lift * η_tot ≤ 1 := le_trans hM_lin_le hSmall
  obtain ⟨W_plus, hW_plus⟩ :=
    hLift s d δ ε η_slice N l_pos q U U_star hs0 hs_act hd0 hd_act hd_half hδ0 hδ_lt
      hε0 hε1 hη_slice_nonneg hN hU hRes hl_pos_ge hq2 hqN hCop ht_pos_lt hU_star hSmall_lift
  rcases hW_plus with ⟨hW_plus_holo, hW_plus_per, hg_plus_holo, hg_plus_bounds,
    hH_plus_holo, hH_plus_dt_holo, hH_plus_bounds⟩
  rcases lt_or_gt_of_ne hl with hl_neg | hl_pos
  · 
    have hl_eq : (l : ℝ) = -(l_pos : ℝ) := by
      have h_int : (l_pos : ℤ) = -l := Int.ofNat_natAbs_of_nonpos hl_neg.le
      have h_real : (l_pos : ℝ) = -(l : ℝ) := by exact_mod_cast h_int
      linarith
    have ht_eq : t₀ = -t_pos := by
      dsimp [t₀, t_pos]
      rw [hl_eq]
      ring
    have ht_neg_ℂ : -(t₀ : ℂ) = (t_pos : ℂ) := by
      rw [ht_eq]
      push_cast
      ring
    let W_jet : ℂ × ℂ → ℂ := fun p => W_plus (p.1, -p.2)
    let refMap : ℂ × ℂ → ℂ × ℂ := fun p => (p.1, -p.2)
    have href_diff : Differentiable ℂ refMap := differentiable_fst.prodMk differentiable_snd.neg
    have hball_ref : ∀ t ∈ Metric.ball (t₀ : ℂ) (δ / 8),
        -t ∈ Metric.ball (t_pos : ℂ) (δ / 8) := by
      intro t ht
      rw [Metric.mem_ball, dist_eq_norm] at ht ⊢
      have hnorm : -t - (t_pos : ℂ) = -(t - (t₀ : ℂ)) := by
        rw [← ht_neg_ℂ]
        ring
      rw [hnorm, norm_neg]
      exact ht
    have hU_adm : IsAdmissibleGlancingCand s d S.η_adm U := by
      refine ⟨hU.1, hU.2.1, hU.2.2.1, hU.2.2.2.1, ?_⟩
      intro k hk y t hyt
      exact le_trans (hU.2.2.2.2 k hk y t hyt) (by linarith [S.η_adm_pos])
    have ht_ball_bounds : ∀ t ∈ Metric.ball (t₀ : ℂ) (δ / 8),
        ‖t‖ < d ∧ |t.im| < δ / 8 := by
      intro t ht
      rw [Metric.mem_ball, dist_eq_norm] at ht
      have ht₀_norm : ‖(t₀ : ℂ)‖ = t_pos := by
        rw [Complex.norm_real, Real.norm_eq_abs, ht_abs]
      have ht_norm : ‖t‖ < d := by
        have htri : ‖t‖ ≤ ‖t - (t₀ : ℂ)‖ + ‖(t₀ : ℂ)‖ := norm_le_norm_sub_add t (t₀ : ℂ)
        linarith
      have ht_im : |t.im| < δ / 8 := by
        have him : t.im = (t - (t₀ : ℂ)).im := by simp
        rw [him]
        exact lt_of_le_of_lt (Complex.abs_im_le_norm (t - (t₀ : ℂ))) ht
      exact ⟨ht_norm, ht_im⟩
    have hstrip_shift : ∀ (σ : ℝ) (y : ℂ),
        y ∈ horizStrip σ → y + 2 * Real.pi ∈ horizStrip σ := by
      intro σ y hy
      change |(y + (2 * (Real.pi : ℂ))).im| < σ
      have him : (y + (2 * (Real.pi : ℂ))).im = y.im := by simp
      rw [him]
      exact hy
    have hW_jet_holo : DifferentiableOn ℂ W_jet
        (horizStrip (s - 8 * δ) ×ˢ Metric.ball (t₀ : ℂ) (δ / 8)) :=
      hW_plus_holo.comp href_diff.differentiableOn (fun p hp => ⟨hp.1, hball_ref p.2 hp.2⟩)
    have hW_jet_per : ∀ y ∈ horizStrip (s - 8 * δ), ∀ t ∈ Metric.ball (t₀ : ℂ) (δ / 8),
        W_jet (y + 2 * Real.pi, t) = W_jet (y, t) := by
      intro y hy t ht
      exact hW_plus_per y hy (-t) (hball_ref t ht)
    have hdiff_W_eq : ∀ y ∈ horizStrip (s - 9 * δ), ∀ t ∈ Metric.ball (t₀ : ℂ) (δ / 8),
        glancingDiffOp W_jet (y, t) = glancingDiffOp W_plus (y, -t) :=
      hCyc.2.1 (s - 8 * δ) (s - 9 * δ) t₀ (δ / 8) W_plus W_jet
        (by linarith) (by positivity) (by linarith) (fun _ _ _ _ => rfl)
    let g_plus : ℂ × ℂ → ℂ := fun p => glancingLinCoeff B U p * glancingDiffOp W_plus p
    let g_jet : ℂ × ℂ → ℂ := fun p => glancingLinCoeff B U p * glancingDiffOp W_jet p
    have hg_eq : ∀ y ∈ horizStrip (s - 9 * δ), ∀ t ∈ Metric.ball (t₀ : ℂ) (δ / 8),
        g_jet (y, t) = g_plus (y, -t) := by
      intro y hy t ht
      obtain ⟨ht_norm, ht_im⟩ := ht_ball_bounds t ht
      have hyt_dom : (y, t) ∈ glancingDomain (1 / 2) s d := by
        refine ⟨ht_norm, ?_⟩
        have hy_im : |y.im| < s - 9 * δ := hy
        linarith
      have ha_even : glancingLinCoeff B U (y, -t) = glancingLinCoeff B U (y, t) :=
        ((S.linCoeff_props s d U hs0 hs_act hd0 hd_act hd_half hU_adm).2 y t hyt_dom).2.1
      dsimp [g_jet, g_plus]
      rw [hdiff_W_eq y hy t ht, ha_even]
    have hg_jet_holo : DifferentiableOn ℂ g_jet
        (horizStrip (s - 9 * δ) ×ˢ Metric.ball (t₀ : ℂ) (δ / 8)) :=
      (hg_plus_holo.comp href_diff.differentiableOn
        (fun p hp => ⟨hp.1, hball_ref p.2 hp.2⟩)).congr
        (fun p hp => hg_eq p.1 hp.1 p.2 hp.2)
    have hg_jet_bounds : ∀ y ∈ horizStrip (s - 9 * δ), ∀ t ∈ Metric.ball (t₀ : ℂ) (δ / 8),
        g_jet (y + 2 * Real.pi, t) = g_jet (y, t) ∧
        ‖g_jet (y, t)‖ ≤ C_rat * Q ^ B_rat * ε ∧
        ‖glancingDiffOp W_jet (y, t)‖ ≤ C_rat * Q ^ B_rat * ε := by
      intro y hy t ht
      have hy_per : y + 2 * Real.pi ∈ horizStrip (s - 9 * δ) := hstrip_shift (s - 9 * δ) y hy
      have ht_ref : -t ∈ Metric.ball (t_pos : ℂ) (δ / 8) := hball_ref t ht
      obtain ⟨hg_p_per, hg_p_norm, hW_p_norm⟩ := hg_plus_bounds y hy (-t) ht_ref
      refine ⟨?_, ?_, ?_⟩
      · rw [hg_eq (y + 2 * Real.pi) hy_per t ht, hg_eq y hy t ht]
        exact hg_p_per
      · rw [hg_eq y hy t ht]
        exact le_trans hg_p_norm hM_lin_le
      · rw [hdiff_W_eq y hy t ht]
        exact le_trans hW_p_norm hM_lin_le
    have hdiff_g_eq : ∀ y ∈ horizStrip (s - 10 * δ), ∀ t ∈ Metric.ball (t₀ : ℂ) (δ / 8),
        glancingDiffOp g_jet (y, t) = glancingDiffOp g_plus (y, -t) :=
      hCyc.2.1 (s - 9 * δ) (s - 10 * δ) t₀ (δ / 8) g_plus g_jet
        (by linarith) (by positivity) (by linarith) hg_eq
    let H_plus : ℂ × ℂ → ℂ := fun p => glancingResidualOp B U p + glancingDiffOp g_plus p
    let H_compat : ℂ × ℂ → ℂ := fun p => glancingResidualOp B U p + glancingDiffOp g_jet p
    have hH_eq : ∀ y ∈ horizStrip (s - 10 * δ), ∀ t ∈ Metric.ball (t₀ : ℂ) (δ / 8),
        H_compat (y, t) = H_plus (y, -t) := by
      intro y hy t ht
      obtain ⟨ht_norm, ht_im⟩ := ht_ball_bounds t ht
      have hyt_dom : (y, t) ∈ glancingDomain 1 s d := by
        refine ⟨ht_norm, ?_⟩
        have hy_im : |y.im| < s - 10 * δ := hy
        linarith
      have hE_even : glancingResidualOp B U (y, -t) = glancingResidualOp B U (y, t) :=
        ((S.E_op_props s d U hs0 hs_act hd0 hd_act hd_half hU_adm).2.1 y t hyt_dom).2.1
      dsimp [H_compat, H_plus]
      rw [hdiff_g_eq y hy t ht, hE_even]
    have hH_compat_holo : DifferentiableOn ℂ H_compat
        (horizStrip (s - 10 * δ) ×ˢ Metric.ball (t₀ : ℂ) (δ / 8)) :=
      (hH_plus_holo.comp href_diff.differentiableOn
        (fun p hp => ⟨hp.1, hball_ref p.2 hp.2⟩)).congr
        (fun p hp => hH_eq p.1 hp.1 p.2 hp.2)
    have hderiv_eq : ∀ y ∈ horizStrip (s - 10 * δ),
        deriv (fun t : ℂ => H_compat (y, t)) (t₀ : ℂ) =
          -deriv (fun u : ℂ => H_plus (y, u)) (t_pos : ℂ) := by
      intro y hy
      have hev : (fun t : ℂ => H_compat (y, t)) =ᶠ[nhds (t₀ : ℂ)]
          (fun t : ℂ => H_plus (y, -t)) :=
        Filter.eventually_of_mem (Metric.ball_mem_nhds (t₀ : ℂ) (by positivity))
          (fun t ht => hH_eq y hy t ht)
      rw [hev.deriv_eq, deriv_comp_neg (fun u : ℂ => H_plus (y, u)) (t₀ : ℂ), ht_neg_ℂ]
    have hH_compat_dt_holo : DifferentiableOn ℂ
        (fun y : ℂ => deriv (fun t : ℂ => H_compat (y, t)) (t₀ : ℂ))
        (horizStrip (s - 10 * δ)) :=
      hH_plus_dt_holo.neg.congr (fun y hy => hderiv_eq y hy)
    have hH_compat_bounds : ∀ y ∈ horizStrip (s - 10 * δ),
        ‖H_compat (y, (t₀ : ℂ))‖ ≤ C_rat * Q ^ B_rat * ε ^ 2 ∧
        ‖deriv (fun t : ℂ => H_compat (y, t)) (t₀ : ℂ)‖ ≤ C_rat * Q ^ B_rat * ε ^ 2 := by
      intro y hy
      have ht₀_mem : (t₀ : ℂ) ∈ Metric.ball (t₀ : ℂ) (δ / 8) :=
        Metric.mem_ball_self (by positivity)
      obtain ⟨hval_plus, hdt_plus⟩ := hH_plus_bounds y hy
      refine ⟨?_, ?_⟩
      · have hval_eq : H_compat (y, (t₀ : ℂ)) = H_plus (y, (t_pos : ℂ)) := by
          rw [hH_eq y hy (t₀ : ℂ) ht₀_mem, ht_neg_ℂ]
        rw [hval_eq]
        exact le_trans hval_plus hM_quad_le
      · rw [hderiv_eq y hy, norm_neg]
        exact le_trans hdt_plus hM_quad_le
    exact ⟨W_jet, hW_jet_holo, hW_jet_per, hg_jet_holo, hg_jet_bounds,
      hH_compat_holo, hH_compat_dt_holo, hH_compat_bounds⟩
  · 
    have hl_eq : (l : ℝ) = (l_pos : ℝ) := by
      have h_int : (l_pos : ℤ) = l := Int.natAbs_of_nonneg hl_pos.le
      exact_mod_cast h_int.symm
    have ht_eq : t₀ = t_pos := by
      dsimp [t₀, t_pos]
      rw [hl_eq]
    refine ⟨W_plus, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · simpa only [ht_eq] using hW_plus_holo
    · intro y hy t ht
      rw [ht_eq] at ht
      exact hW_plus_per y hy t ht
    · simpa only [ht_eq] using hg_plus_holo
    · intro y hy t ht
      rw [ht_eq] at ht
      obtain ⟨hper, hgn, hWn⟩ := hg_plus_bounds y hy t ht
      exact ⟨hper, le_trans hgn hM_lin_le, le_trans hWn hM_lin_le⟩
    · simpa only [ht_eq] using hH_plus_holo
    · simpa only [ht_eq] using hH_plus_dt_holo
    · intro y hy
      rw [ht_eq]
      obtain ⟨hv, hdt⟩ := hH_plus_bounds y hy
      exact ⟨le_trans hv hM_quad_le, le_trans hdt hM_quad_le⟩

theorem buffered_sinc_fourier_division : BufferedFourierDivProp :=
by
  have cos_sin_tau_bound : ∀ (z : ℂ) (τ : ℝ), 0 ≤ τ → τ ≤ 1 →
      ‖Complex.cos ((τ : ℂ) * z)‖ ≤ Real.exp |z.im| ∧
      ‖-(τ : ℂ) * Complex.sin ((τ : ℂ) * z)‖ ≤ Real.exp |z.im| := by
    intro z τ hτ0 hτ1
    have him : |((τ : ℂ) * z).im| ≤ |z.im| := by
      simp only [Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im, zero_mul, add_zero]
      rw [abs_mul, abs_of_nonneg hτ0]
      exact mul_le_of_le_one_left (abs_nonneg _) hτ1
    have hexp1 : ‖Complex.exp (((τ : ℂ) * z) * Complex.I)‖ ≤ Real.exp |z.im| := by
      rw [Complex.norm_exp]
      apply Real.exp_le_exp.mpr
      simp only [Complex.mul_re, Complex.I_re, mul_zero, Complex.I_im, mul_one, zero_sub]
      linarith [neg_abs_le (((τ : ℂ) * z).im)]
    have hexp2 : ‖Complex.exp (-((τ : ℂ) * z) * Complex.I)‖ ≤ Real.exp |z.im| := by
      rw [Complex.norm_exp]
      apply Real.exp_le_exp.mpr
      simp only [Complex.mul_re, Complex.neg_re, Complex.neg_im, Complex.I_re, mul_zero,
        Complex.I_im, mul_one, zero_sub, neg_neg]
      linarith [le_abs_self (((τ : ℂ) * z).im)]
    constructor
    · rw [Complex.cos]
      calc ‖(Complex.exp ((τ : ℂ) * z * Complex.I) +
              Complex.exp (-((τ : ℂ) * z) * Complex.I)) / 2‖
          = ‖Complex.exp ((τ : ℂ) * z * Complex.I) +
              Complex.exp (-((τ : ℂ) * z) * Complex.I)‖ / 2 := by
            rw [norm_div, Complex.norm_ofNat]
        _ ≤ (Real.exp |z.im| + Real.exp |z.im|) / 2 := by
            gcongr
            exact (norm_add_le _ _).trans (add_le_add hexp1 hexp2)
        _ = Real.exp |z.im| := by ring
    · have hsin : ‖Complex.sin ((τ : ℂ) * z)‖ ≤ Real.exp |z.im| := by
        rw [Complex.sin]
        calc ‖(Complex.exp (-((τ : ℂ) * z) * Complex.I) -
                Complex.exp ((τ : ℂ) * z * Complex.I)) * Complex.I / 2‖
            = ‖Complex.exp (-((τ : ℂ) * z) * Complex.I) -
                Complex.exp ((τ : ℂ) * z * Complex.I)‖ / 2 := by
              rw [norm_div, norm_mul, Complex.norm_I, mul_one, Complex.norm_ofNat]
          _ ≤ (Real.exp |z.im| + Real.exp |z.im|) / 2 := by
              gcongr
              exact (norm_sub_le _ _).trans (add_le_add hexp2 hexp1)
          _ = Real.exp |z.im| := by ring
      rw [norm_mul, norm_neg, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hτ0]
      calc τ * ‖Complex.sin ((τ : ℂ) * z)‖ ≤ 1 * Real.exp |z.im| :=
            mul_le_mul hτ1 hsin (norm_nonneg _) zero_le_one
        _ = Real.exp |z.im| := one_mul _
  have sinc_hasDerivAt : ∀ (z₀ : ℂ),
      HasDerivAt sinc_ℂ (∫ τ in (0 : ℝ)..(1 : ℝ), -(τ : ℂ) * Complex.sin ((τ : ℂ) * z₀)) z₀ := by
    intro z₀
    have h := intervalIntegral.hasDerivAt_integral_of_dominated_loc_of_deriv_le
      (F := fun (z : ℂ) (τ : ℝ) => Complex.cos ((τ : ℂ) * z))
      (F' := fun (z : ℂ) (τ : ℝ) => -(τ : ℂ) * Complex.sin ((τ : ℂ) * z))
      (x₀ := z₀) (s := Metric.ball z₀ 1) (bound := fun _ : ℝ => Real.exp (‖z₀‖ + 1))
      (a := (0 : ℝ)) (b := (1 : ℝ)) (μ := MeasureTheory.volume)
      (Metric.ball_mem_nhds z₀ zero_lt_one)
      (Filter.Eventually.of_forall fun z =>
        (Complex.continuous_cos.comp (Complex.continuous_ofReal.mul continuous_const)).aestronglyMeasurable)
      ((Complex.continuous_cos.comp (Complex.continuous_ofReal.mul continuous_const)).intervalIntegrable _ _)
      (((Complex.continuous_ofReal.neg).mul
        (Complex.continuous_sin.comp (Complex.continuous_ofReal.mul continuous_const))).aestronglyMeasurable)
      ?_ intervalIntegrable_const ?_
    · exact h.2
    · refine Filter.Eventually.of_forall fun τ hτ z hz => ?_
      rw [Set.uIoc_of_le zero_le_one] at hτ
      have h1 := (cos_sin_tau_bound z τ (le_of_lt hτ.1) hτ.2).2
      refine h1.trans (Real.exp_le_exp.mpr ?_)
      have hzim : |z.im| ≤ ‖z‖ := Complex.abs_im_le_norm z
      have hznorm : ‖z‖ ≤ ‖z₀‖ + 1 := by
        have hdist : ‖z - z₀‖ < 1 := by simpa [dist_eq_norm] using Metric.mem_ball.mp hz
        linarith [norm_sub_norm_le z z₀]
      linarith
    · refine Filter.Eventually.of_forall fun τ _ z _ => ?_
      have hd := (Complex.hasDerivAt_cos ((τ : ℂ) * z)).comp z ((hasDerivAt_id z).const_mul (τ : ℂ))
      dsimp only [Function.comp_def] at hd
      convert hd using 1
      ring
  have hSinc : SincDivisorCalculusProp_bfd := by
    have h_diff : Differentiable ℂ sinc_ℂ := fun z => (sinc_hasDerivAt z).differentiableAt
    have h_zero : sinc_ℂ 0 = 1 := by simp [sinc_ℂ]
    have h_mul : ∀ z : ℂ, z * sinc_ℂ z = Complex.sin z := by
      intro z
      have hftc := intervalIntegral.integral_eq_sub_of_hasDerivAt
        (f := fun τ : ℝ => Complex.sin ((τ : ℂ) * z))
        (f' := fun τ : ℝ => Complex.cos ((τ : ℂ) * z) * z)
        (a := (0 : ℝ)) (b := (1 : ℝ))
        (fun τ _ => by
          have h1 : HasDerivAt (fun t : ℝ => (t : ℂ) * z) ((1 : ℂ) * z) τ :=
            ((hasDerivAt_id τ).ofReal_comp).mul_const z
          have h2 := (Complex.hasDerivAt_sin ((τ : ℂ) * z)).scomp τ h1
          dsimp only [Function.comp_def] at h2
          convert h2 using 1
          simp [mul_comm])
        (((Complex.continuous_cos.comp
          (Complex.continuous_ofReal.mul continuous_const)).mul continuous_const).intervalIntegrable _ _)
      rw [intervalIntegral.integral_mul_const] at hftc
      simp only [Complex.ofReal_one, one_mul, Complex.ofReal_zero, zero_mul, Complex.sin_zero,
        sub_zero] at hftc
      change sinc_ℂ z * z = Complex.sin z at hftc
      rw [mul_comm, hftc]
    have h_even : ∀ z : ℂ, sinc_ℂ (-z) = sinc_ℂ z := by
      intro z
      simp only [sinc_ℂ, mul_neg, Complex.cos_neg]
    have h_conj : ∀ z : ℂ, sinc_ℂ (starRingEnd ℂ z) = starRingEnd ℂ (sinc_ℂ z) := by
      intro z
      simp only [sinc_ℂ]
      have hf_int : IntervalIntegrable (fun τ : ℝ => Complex.cos ((τ : ℂ) * z))
          MeasureTheory.volume 0 1 :=
        (Complex.continuous_cos.comp (Complex.continuous_ofReal.mul continuous_const)).intervalIntegrable _ _
      have hcomm := (Complex.conjCLE.toContinuousLinearMap).intervalIntegral_comp_comm hf_int
      dsimp [Complex.conjCLE] at hcomm
      rw [← hcomm]
      refine intervalIntegral.integral_congr fun τ _ => ?_
      rw [← Complex.cos_conj]
      simp
    have h_bounds : ∀ z : ℂ, ‖sinc_ℂ z‖ ≤ Real.exp |z.im| ∧ ‖deriv sinc_ℂ z‖ ≤ Real.exp |z.im| := by
      intro z
      constructor
      · calc ‖sinc_ℂ z‖
            = ‖∫ τ in (0 : ℝ)..(1 : ℝ), Complex.cos ((τ : ℂ) * z)‖ := rfl
          _ ≤ Real.exp |z.im| * |(1 : ℝ) - 0| := by
              refine intervalIntegral.norm_integral_le_of_norm_le_const fun τ hτ => ?_
              rw [Set.uIoc_of_le zero_le_one] at hτ
              exact (cos_sin_tau_bound z τ (le_of_lt hτ.1) hτ.2).1
          _ = Real.exp |z.im| := by norm_num
      · rw [(sinc_hasDerivAt z).deriv]
        calc ‖∫ τ in (0 : ℝ)..(1 : ℝ), -(τ : ℂ) * Complex.sin ((τ : ℂ) * z)‖
            ≤ Real.exp |z.im| * |(1 : ℝ) - 0| := by
              refine intervalIntegral.norm_integral_le_of_norm_le_const fun τ hτ => ?_
              rw [Set.uIoc_of_le zero_le_one] at hτ
              exact (cos_sin_tau_bound z τ (le_of_lt hτ.1) hτ.2).2
          _ = Real.exp |z.im| := by norm_num
    have h_int : ∀ (n : ℤ) (t : ℂ),
        (∫ μ in (-1 / 2 : ℝ)..(1 / 2 : ℝ),
          Complex.exp (Complex.I * (n : ℂ) * (μ : ℂ) * t)) = sinc_ℂ ((n : ℂ) * t / 2) := by
      intro n t
      by_cases hnt : (n : ℂ) * t = 0
      · have h0 : (n : ℂ) * t / 2 = 0 := by rw [hnt, zero_div]
        rw [h0, h_zero]
        have heq : ∀ μ : ℝ, Complex.exp (Complex.I * (n : ℂ) * (μ : ℂ) * t) = 1 := by
          intro μ
          have : Complex.I * (n : ℂ) * (μ : ℂ) * t = Complex.I * (μ : ℂ) * ((n : ℂ) * t) := by ring
          rw [this, hnt, mul_zero, Complex.exp_zero]
        simp_rw [heq]
        simp [intervalIntegral.integral_const]
        norm_num
      · let z : ℂ := (n : ℂ) * t / 2
        have hz : z ≠ 0 := div_ne_zero hnt two_ne_zero
        have h2iz : 2 * Complex.I * z ≠ 0 := mul_ne_zero (mul_ne_zero two_ne_zero Complex.I_ne_zero) hz
        have hftc := intervalIntegral.integral_eq_sub_of_hasDerivAt
          (f := fun μ : ℝ => Complex.exp (2 * Complex.I * z * (μ : ℂ)) / (2 * Complex.I * z))
          (f' := fun μ : ℝ => Complex.exp (Complex.I * (n : ℂ) * (μ : ℂ) * t))
          (a := (-1 / 2 : ℝ)) (b := (1 / 2 : ℝ))
          (fun μ _ => by
            have h1 : HasDerivAt (fun x : ℝ => 2 * Complex.I * z * (x : ℂ)) (2 * Complex.I * z) μ := by
              simpa using (((hasDerivAt_id μ).ofReal_comp).const_mul (2 * Complex.I * z))
            have h2 := ((Complex.hasDerivAt_exp _).scomp μ h1).div_const (2 * Complex.I * z)
            dsimp only [Function.comp_def] at h2
            convert h2 using 1
            rw [smul_eq_mul, mul_comm (2 * Complex.I * z), mul_div_cancel_right₀ _ h2iz]
            congr 1; dsimp [z]; ring)
          ((Complex.continuous_exp.comp
            (((continuous_const.mul Complex.continuous_ofReal).mul continuous_const))).intervalIntegrable _ _)
        rw [hftc]
        have he1 : 2 * Complex.I * z * (((1 / 2 : ℝ) : ℂ)) = z * Complex.I := by push_cast; ring
        have he2 : 2 * Complex.I * z * (((-1 / 2 : ℝ) : ℂ)) = -z * Complex.I := by push_cast; ring
        rw [he1, he2]
        have hsin_eq : ∀ w : ℂ, w ≠ 0 →
            Complex.exp (w * Complex.I) / (2 * Complex.I * w) -
              Complex.exp (-w * Complex.I) / (2 * Complex.I * w) = Complex.sin w / w := by
          intro w hw
          rw [Complex.sin]
          field_simp [hw, Complex.I_ne_zero]
          rw [Complex.I_sq]
          ring
        rw [hsin_eq z hz, ← h_mul z, mul_div_cancel_left₀ _ hz]
    have h_pij : ∀ j : ℤ, j ≠ 0 → sinc_ℂ ((Real.pi : ℂ) * (j : ℂ)) = 0 := by
      intro j hj
      have hpz : (Real.pi : ℂ) * (j : ℂ) ≠ 0 :=
        mul_ne_zero (Complex.ofReal_ne_zero.mpr Real.pi_ne_zero) (Int.cast_ne_zero.mpr hj)
