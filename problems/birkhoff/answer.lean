            have h1 := norm_add_le
              ((b 0 - w 1) + ∑ m ∈ Finset.range j, t * (J_step (m + 1) - 1))
              (t * (J_step (j + 1) - 1))
            have h2 := norm_add_le (b 0 - w 1)
              (∑ m ∈ Finset.range j, t * (J_step (m + 1) - 1))
            have h3 : ‖∑ m ∈ Finset.range j, t * (J_step (m + 1) - 1)‖ ≤
                ∑ m ∈ Finset.range j, ‖t‖ * ‖J_step (m + 1) - 1‖ := by
              refine le_trans (norm_sum_le _ _) (Finset.sum_le_sum fun m _ => ?_)
              rw [norm_mul]
            rw [norm_mul] at h1
            linarith only [h1, h2, h3]
          have h_piece1 : ‖b 0 - w 1‖ ≤
              ‖t‖ ^ 2 * M_scale ^ 2 * (D (j + 2)) ^ (1 - 2 * α) :=
            hb0_D (j + 2) hj2_le
          have h_piece3 : ‖t‖ * ‖J_step (j + 1) - 1‖ ≤
              C_J * ‖t‖ ^ 2 * M_scale ^ 2 * (D (j + 2)) ^ (1 - 2 * α) := by
            have h_nonneg_rhs : 0 ≤ C_J * ‖t‖ ^ 2 * M_scale ^ 2 * (D (j + 2)) ^ (-2 * α) :=
              mul_nonneg (mul_nonneg (mul_nonneg hCJ_pos.le (sq_nonneg _)) (sq_nonneg _))
                (Real.rpow_nonneg (hD_pos (j + 2) hj2_le).le _)
            calc ‖t‖ * ‖J_step (j + 1) - 1‖
                ≤ D (j + 2) * (C_J * ‖t‖ ^ 2 * M_scale ^ 2 * (D (j + 2)) ^ (-2 * α)) :=
                  mul_le_mul ht_le_Dj2 hJ_top (norm_nonneg _) (hD_pos (j + 2) hj2_le).le
              _ = C_J * ‖t‖ ^ 2 * M_scale ^ 2 * ((D (j + 2)) ^ (-2 * α) * D (j + 2)) := by ring
              _ = C_J * ‖t‖ ^ 2 * M_scale ^ 2 * (D (j + 2)) ^ (1 - 2 * α) := by
                  rw [← hDj2_split]
          have h_sum_le2 : ∑ m ∈ Finset.range j, ‖t‖ * ‖J_step (m + 1) - 1‖ ≤
              (C_J * ‖t‖ ^ 3 * M_scale ^ 2) * ∑ m ∈ Finset.range j, (D (m + 2)) ^ (-2 * α) := by
            rw [Finset.mul_sum]
            refine Finset.sum_le_sum fun m hm => ?_
            have hm_lt : m < j := Finset.mem_range.mp hm
            have hm_J := ih_J (m + 1) (by omega)
            calc ‖t‖ * ‖J_step (m + 1) - 1‖
                ≤ ‖t‖ * (C_J * ‖t‖ ^ 2 * M_scale ^ 2 * (D (m + 2)) ^ (-2 * α)) :=
                  mul_le_mul_of_nonneg_left hm_J (norm_nonneg t)
              _ = (C_J * ‖t‖ ^ 3 * M_scale ^ 2) * (D (m + 2)) ^ (-2 * α) := by ring
          let S_pos : ℝ :=
            ∑ i ∈ Finset.range j,
              (D (j + 2) + ((i + 1 : ℕ) : ℝ) * t.im) ^ (-(2 * α))
          have h_refl_pos :
              ∑ m ∈ Finset.range j, (D (m + 2)) ^ (-2 * α) = S_pos := by
            rw [← Finset.sum_range_reflect (fun m => (D (m + 2)) ^ (-2 * α)) j]
            refine Finset.sum_congr rfl fun i hi => ?_
            have hi_lt : i < j := Finset.mem_range.mp hi
            have h_idx : (((j - 1 - i) + 2 : ℕ) : ℝ) + ((i + 1 : ℕ) : ℝ) =
                ((j + 2 : ℕ) : ℝ) := by
              exact_mod_cast (by omega : ((j - 1 - i) + 2) + (i + 1) = j + 2)
            have hD_shift : D ((j - 1 - i) + 2) = D (j + 2) + ((i + 1 : ℕ) : ℝ) * t.im := by
              rw [hD_eq ((j - 1 - i) + 2), hD_eq (j + 2)]
              linear_combination -t.im * h_idx
            have hexp : (-2 * α : ℝ) = -(2 * α) := by ring
            rw [hD_shift, hexp]
          have hSpos_nonneg : 0 ≤ S_pos := by
            refine Finset.sum_nonneg fun i _ => ?_
            have hbase_pos : 0 < D (j + 2) + ((i + 1 : ℕ) : ℝ) * t.im :=
              add_pos_of_pos_of_nonneg (hD_pos (j + 2) hj2_le) (by positivity)
            exact Real.rpow_nonneg hbase_pos.le _
          have h_mesh_pos : t.im * S_pos ≤ (D (j + 2)) ^ (1 - 2 * α) / (2 * α - 1) :=
            hMesh (2 * α) (D (j + 2)) t.im j
              (by linarith only [hα1]) (hD_pos (j + 2) hj2_le) htim_pos
          have h_piece2 :
              (C_J * ‖t‖ ^ 3 * M_scale ^ 2) * S_pos ≤
                (C_J / ((2 * α - 1) * γ_steep)) *
                  ‖t‖ ^ 2 * M_scale ^ 2 * (D (j + 2)) ^ (1 - 2 * α) := by
            have hc1 : C_J * ‖t‖ ^ 3 * M_scale ^ 2 ≤
                C_J * (‖t‖ ^ 2 * (t.im / γ_steep)) * M_scale ^ 2 :=
              mul_le_mul_of_nonneg_right
                (mul_le_mul_of_nonneg_left ht_cubed_le hCJ_pos.le) (sq_nonneg M_scale)
            calc (C_J * ‖t‖ ^ 3 * M_scale ^ 2) * S_pos
