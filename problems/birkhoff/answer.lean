        ∀ T ∈ upperHalfDiskOpen, H_plus T T_c w = g_plus T T_c w := by
      intro T_c hTc w hw T hT
      let W_conv : Set ℂ := Metric.ball (0 : ℂ) (t₀ + δ₀) ∩ { ζ : ℂ | -δ₀ < ζ.im }
      have hW_open : IsOpen W_conv :=
        Metric.isOpen_ball.inter (isOpen_lt continuous_const Complex.continuous_im)
      have hW_conv : Convex ℝ W_conv := by
        refine (convex_ball (0 : ℂ) (t₀ + δ₀)).inter ?_
        intro x hx y hy a b ha hb hab
