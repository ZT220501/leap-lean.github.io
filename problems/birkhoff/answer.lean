        · rw [hU0, zero_mul]
        · have h0 : MvPowerSeries.coeff (Finsupp.single (1 : Fin 2) m)
              ((MvPowerSeries.X 0 : MvPowerSeries (Fin 2) ℂ) ^ (n + 1)) = 0 := by
            have hp := congr_arg (PowerSeries.coeff m)
              (hπ_pow 1 (MvPowerSeries.X 0) (n + 1))
            rw [hπ1_X0, zero_pow (Nat.succ_ne_zero n), map_zero, PowerSeries.coeff_mk] at hp
            exact hp
          rw [h0, mul_zero]
