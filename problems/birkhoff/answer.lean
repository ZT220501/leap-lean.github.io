            have hQ1_d : MvPowerSeries.coeff d (Q1 - Q1_0) =
                c_d i * MvPowerSeries.coeff d ηd := by
              rw [map_sub, hSub.coeff_comp1D_pert hn1 _ hd_eq (h_step_ref_c0 i) hηd_vb, hS_c1 i]
              ring
            have hP2_d : MvPowerSeries.coeff d (P2 - P2_0) = h1 * MvPowerSeries.coeff d ηψ := by
              rw [map_sub, hSub.coeff_comp1D_pert hn1 _ hd_eq (h_mid_ref_c0 i) hηψ_vb, htr_c1]
              ring
            have hQ2_d : MvPowerSeries.coeff d (Q2 - Q2_0) =
                (-s_d i) * MvPowerSeries.coeff d ηd := by
              rw [map_sub, hSub.coeff_comp1D_pert hn1 _ hd_eq (h_step_ref_c0 i) hηd_vb, hC_c1 i]
              ring
            have hM1 : MvPowerSeries.coeff d (P1 * Q1) - MvPowerSeries.coeff d (P1_0 * Q1_0) =
                s_d i * (h2 * MvPowerSeries.coeff d ηψ) +
                  h1 * (c_d i * MvPowerSeries.coeff d ηd) := by
              rw [hSub.coeff_mul_pert hn1 hd_eq hP1_vb hQ1_vb, h_coeff0_comp, h_coeff0_comp,
