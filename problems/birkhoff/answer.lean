        stepBound i ≤ G.c_small ∧
        G.C_step * (1 + (N_seq i : ℝ) + (δ i)⁻¹) ^ B₀ * (ε_bar i) ^ 2 ≤ ε_bar (i + 1) := by
      intro i
      have h2i_ge1 : (1 : ℝ) ≤ (2 : ℝ) ^ i := one_le_pow₀ (by norm_num)
      have h2i_pos : (0 : ℝ) < (2 : ℝ) ^ i := by positivity
      have hδ_pos : 0 < δ i := by dsimp [δ]; positivity
      have hδ_le : δ i ≤ d₀ / 400 := by
