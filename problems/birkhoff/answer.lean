    have h_id : 2 * p₀ - (2 * starRingEnd ℂ p₀ - s) = s + ((4 * p₀.im : ℝ) : ℂ) * Complex.I := by
      apply Complex.ext
      · simp
      · simp; ring
    rw [← h_id, (ha_centers p₀ hp₀_ord).2, (ha_centers (starRingEnd ℂ p₀) hp₀_bar_ord).2, neg_neg]
  let Λ : Submodule ℤ ℂ :=
    { carrier := { w_per : ℂ | ∀ s : ℂ, a (s + w_per) = a s }
      zero_mem' := fun s => by simp
      add_mem' := fun {w₁ w₂} h₁ h₂ s => by rw [← add_assoc, h₂, h₁]
      smul_mem' := by
        intro n w_per hω
        induction n using Int.induction_on with
        | zero => intro s; simp
        | succ k ih =>
          intro s
          have : ((k : ℤ) + 1) • w_per = (k : ℤ) • w_per + w_per := add_zsmul w_per k 1 |>.trans (by simp)
          rw [this, ← add_assoc, hω, ih]
        | pred k ih =>
          intro s
          have h_neg : ∀ t : ℂ, a (t - w_per) = a t := fun t => by
            have := hω (t - w_per)
            simpa [sub_add_cancel] using this.symm
          have : (-(k : ℤ) - 1) • w_per = (-(k : ℤ)) • w_per - w_per := by
            rw [sub_eq_add_neg, add_zsmul, neg_one_zsmul, ← sub_eq_add_neg]
          rw [this, ← add_sub_assoc, h_neg, ih] }
  have hΛ_disc : DiscreteTopology ↥Λ := by
    have ha0_hd : HasDerivAt a (deriv a 0) 0 := by
      simpa using ha0_ana.differentiableAt.hasDerivAt
    have h_slope : Filter.Tendsto (slope a 0) (nhdsWithin 0 {0}ᶜ) (nhds (deriv a 0)) :=
      hasDerivAt_iff_tendsto_slope.mp ha0_hd
    have h_ev_ne : ∀ᶠ z in nhdsWithin (0 : ℂ) {0}ᶜ, a z ≠ a 0 := by
      filter_upwards [h_slope.eventually (eventually_ne_nhds ha0_deriv)] with z hz h_eq
      apply hz
      simp [slope, h_eq]
    rw [eventually_nhdsWithin_iff, Metric.eventually_nhds_iff_ball] at h_ev_ne
    obtain ⟨δ, hδ_pos, hδ⟩ := h_ev_ne
    rw [discreteTopology_iff_isOpen_singleton]
    intro x
    rw [Metric.isOpen_singleton_iff]
    refine ⟨δ, hδ_pos, fun y hy => ?_⟩
    have h_dist : (y : ℂ) - (x : ℂ) ∈ Metric.ball (0 : ℂ) δ := by
      rw [Metric.mem_ball, dist_zero_right, ← dist_eq_norm]
      exact hy
    by_contra h_ne
    have h_sub_ne : (y : ℂ) - (x : ℂ) ≠ 0 :=
      sub_ne_zero.mpr (fun h => h_ne (Subtype.ext h))
    have ha_eq : a ((y : ℂ) - (x : ℂ)) = a 0 := by
      simpa using (y - x).2 0
    exact hδ ((y : ℂ) - (x : ℂ)) h_dist h_sub_ne ha_eq
  have hΛ_span : Submodule.span ℝ (Λ : Set ℂ) = ⊤ := by
    rw [eq_top_iff]
    intro z _
    let w_re : ℂ := (2 * Real.pi : ℝ)
    let w_im : ℂ := ((4 * p₀.im : ℝ) : ℂ) * Complex.I
    have hw_re_mem : w_re ∈ (Λ : Set ℂ) := fun s => by simpa [w_re] using ha_per s
    have hw_im_mem : w_im ∈ (Λ : Set ℂ) := ha_per_im
    have hw_re_ne : (2 * Real.pi : ℝ) ≠ 0 := mul_ne_zero two_ne_zero Real.pi_ne_zero
    have hw_im_ne : (4 * p₀.im : ℝ) ≠ 0 := mul_ne_zero (by norm_num) hp₀_im
    have hz_eq : z = (z.re / (2 * Real.pi)) • w_re + (z.im / (4 * p₀.im)) • w_im := by
      have h1 : (z.re / (2 * Real.pi)) • w_re = (z.re : ℂ) := by
        dsimp [w_re]
        rw [← Complex.ofReal_mul, div_mul_cancel₀ _ hw_re_ne]
      have h2 : (z.im / (4 * p₀.im)) • w_im = (z.im : ℂ) * Complex.I := by
        dsimp [w_im]
        rw [← mul_assoc, ← Complex.ofReal_mul, div_mul_cancel₀ _ hw_im_ne]
      rw [h1, h2, Complex.re_add_im]
    rw [hz_eq]
    exact Submodule.add_mem _
      (Submodule.smul_mem _ _ (Submodule.subset_span hw_re_mem))
      (Submodule.smul_mem _ _ (Submodule.subset_span hw_im_mem))
  have hΛ_lat : IsZLattice ℝ Λ := @IsZLattice.mk ℝ _ ℂ _ _ Λ hΛ_disc hΛ_span
  have hΛ_free : Module.Free ℤ ↥Λ := @ZLattice.module_free ℝ _ _ _ _ _ ℂ _ _ _ _ Λ hΛ_disc hΛ_lat
  have hΛ_fin : Module.Finite ℤ ↥Λ := @ZLattice.module_finite ℝ _ _ _ _ _ ℂ _ _ _ _ Λ hΛ_disc hΛ_lat
  have hΛ_rank : Module.finrank ℤ ↥Λ = 2 :=
    (@ZLattice.rank ℝ _ _ _ _ _ ℂ _ _ _ _ Λ hΛ_disc hΛ_lat).trans Complex.finrank_real_complex
  let e_lat : Module.Basis (Fin 2) ℤ ↥Λ :=
    @Module.finBasisOfFinrankEq ℤ ↥Λ _ _ _ hΛ_free _ hΛ_fin 2 hΛ_rank
  let b : Module.Basis (Fin 2) ℝ ℂ :=
    @Module.Basis.ofZLatticeBasis ℝ _ _ _ _ _ ℂ _ _ _ _ Λ hΛ_disc (Fin 2) hΛ_lat e_lat
  have hb_mem : ∀ i : Fin 2, b i ∈ Λ := by
    intro i
    have h_eq : b i = (e_lat i : ℂ) :=
      @Module.Basis.ofZLatticeBasis_apply ℝ _ _ _ _ _ ℂ _ _ _ _ Λ hΛ_disc (Fin 2) hΛ_lat e_lat i
    rw [h_eq]
    exact (e_lat i).2
  have hb0 : ∀ s : ℂ, a (s + b 0) = a s := hb_mem 0
  have hb1 : ∀ s : ℂ, a (s + b 1) = a s := hb_mem 1
  have hb_per_iff : ∀ z : ℂ,
      (∀ s : ℂ, a (s + z) = a s) ↔ ∃ m n : ℤ, b.repr z 0 = m ∧ b.repr z 1 = n := by
    intro z
    constructor
    · intro hz
      let z_lat : ↥Λ := ⟨z, hz⟩
      refine ⟨e_lat.repr z_lat 0, e_lat.repr z_lat 1, ?_, ?_⟩
      · exact @Module.Basis.ofZLatticeBasis_repr_apply ℝ _ _ _ _ _ ℂ _ _ _ _ Λ hΛ_disc
          (Fin 2) hΛ_lat e_lat z_lat 0
      · exact @Module.Basis.ofZLatticeBasis_repr_apply ℝ _ _ _ _ _ ℂ _ _ _ _ Λ hΛ_disc
          (Fin 2) hΛ_lat e_lat z_lat 1
    · rintro ⟨m, n, hm, hn⟩
      have hz_sum : z = m • b 0 + n • b 1 := by
        have h_repr := b.sum_repr z
        rw [Fin.sum_univ_two, hm, hn, Int.cast_smul_eq_zsmul, Int.cast_smul_eq_zsmul] at h_repr
        exact h_repr.symm
      rw [hz_sum]
      exact Λ.add_mem (Λ.smul_mem m (hb_mem 0)) (Λ.smul_mem n (hb_mem 1))
  have hb_liouville : ∀ F : ℂ → ℂ, Differentiable ℂ F →
      (∀ s : ℂ, F (s + b 0) = F s) → (∀ s : ℂ, F (s + b 1) = F s) →
      ∃ c₀ : ℂ, ∀ s : ℂ, F s = c₀ := by
    intro F hF hFb0 hFb1
    have hF_zsmul : ∀ (w_per : ℂ), (∀ s : ℂ, F (s + w_per) = F s) →
        ∀ (k : ℤ) (s : ℂ), F (s + k • w_per) = F s := by
      intro w_per hω k
      induction k using Int.induction_on with
      | zero => intro s; simp
      | succ k ih =>
        intro s
        have : ((k : ℤ) + 1) • w_per = (k : ℤ) • w_per + w_per := add_zsmul w_per k 1 |>.trans (by simp)
        rw [this, ← add_assoc, hω, ih]
      | pred k ih =>
        intro s
        have h_neg : ∀ t : ℂ, F (t - w_per) = F t := fun t => by
          have := hω (t - w_per)
          simpa [sub_add_cancel] using this.symm
        have : (-(k : ℤ) - 1) • w_per = (-(k : ℤ)) • w_per - w_per := by
          rw [sub_eq_add_neg, add_zsmul, neg_one_zsmul, ← sub_eq_add_neg]
        rw [this, ← add_sub_assoc, h_neg, ih]
    let φ_box : ℝ × ℝ → ℂ := fun p => p.1 • b 0 + p.2 • b 1
    have hφ_cont : Continuous φ_box :=
      (continuous_fst.smul continuous_const).add (continuous_snd.smul continuous_const)
    let K : Set ℂ := φ_box '' (Set.Icc (0 : ℝ) 1 ×ˢ Set.Icc (0 : ℝ) 1)
    have hK_comp : IsCompact K := (isCompact_Icc.prod isCompact_Icc).image hφ_cont
    have hFK_bdd : Bornology.IsBounded (F '' K) :=
      (hK_comp.image hF.continuous).isBounded
    have h_range_sub : Set.range F ⊆ F '' K := by
      rintro _ ⟨z, rfl⟩
      let u := b.repr z 0
      let v := b.repr z 1
      let w : ℂ := Int.fract u • b 0 + Int.fract v • b 1
      have hw_K : w ∈ K := ⟨(Int.fract u, Int.fract v),
        ⟨⟨Int.fract_nonneg u, le_of_lt (Int.fract_lt_one u)⟩,
         ⟨Int.fract_nonneg v, le_of_lt (Int.fract_lt_one v)⟩⟩, rfl⟩
      have hz_eq : z = w + ⌊u⌋ • b 0 + ⌊v⌋ • b 1 := by
        have h_repr := b.sum_repr z
        rw [Fin.sum_univ_two] at h_repr
        have hu : u = (⌊u⌋ : ℝ) + Int.fract u := (Int.floor_add_fract u).symm
        have hv : v = (⌊v⌋ : ℝ) + Int.fract v := (Int.floor_add_fract v).symm
        calc
          z = u • b 0 + v • b 1 := h_repr.symm
          _ = ((⌊u⌋ : ℝ) + Int.fract u) • b 0 + ((⌊v⌋ : ℝ) + Int.fract v) • b 1 := by
              rw [← hu, ← hv]
          _ = w + (⌊u⌋ : ℝ) • b 0 + (⌊v⌋ : ℝ) • b 1 := by
              dsimp [w]; push_cast; ring
          _ = w + ⌊u⌋ • b 0 + ⌊v⌋ • b 1 := by
              rw [Int.cast_smul_eq_zsmul, Int.cast_smul_eq_zsmul]
      refine ⟨w, hw_K, ?_⟩
      rw [hz_eq, hF_zsmul (b 1) hFb1 ⌊v⌋, hF_zsmul (b 0) hFb0 ⌊u⌋]
    obtain ⟨c₀, hc₀⟩ := hF.exists_eq_const_of_bounded (hFK_bdd.subset h_range_sub)
    exact ⟨c₀, fun s => congrFun hc₀ s⟩
  
  let q₁ : ℂ := if meromorphicOrderAt a p₀ = -1 then p₀ else starRingEnd ℂ p₀
  have hq₁_pole : meromorphicOrderAt a q₁ = -1 := by
    dsimp [q₁]
    split_ifs with hp
    · exact hp
    · rcases (ha_centers p₀ hp₀_ord).1 with h1 | hm1
      · rw [ha_conj_ord p₀, h1]
      · exact absurd hm1 hp
  have hq₁_ord_ne : meromorphicOrderAt a q₁ ≠ 0 := by rw [hq₁_pole]; decide
  have hq₁_odd : ∀ s : ℂ, a (2 * q₁ - s) = -a s := (ha_centers q₁ hq₁_ord_ne).2
  let isPer : ℂ → Prop := fun z => ∀ s : ℂ, a (s + z) = a s
  have isPer_add : ∀ z₁ z₂ : ℂ, isPer z₁ → isPer z₂ → isPer (z₁ + z₂) :=
    fun z₁ z₂ h₁ h₂ s => by rw [← add_assoc, h₂, h₁]
  have isPer_neg : ∀ z : ℂ, isPer z → isPer (-z) := fun z hz s => by
    have := hz (s - z)
    simpa [sub_eq_add_neg, add_assoc] using this.symm
  have isPer_sub : ∀ z₁ z₂ : ℂ, isPer z₁ → isPer z₂ → isPer (z₁ - z₂) :=
    fun z₁ z₂ h₁ h₂ => sub_eq_add_neg z₁ z₂ ▸ isPer_add z₁ (-z₂) h₁ (isPer_neg z₂ h₂)
  have isPer_zsmul : ∀ (m n : ℤ), isPer (m • b 0 + n • b 1) := by
    intro m n
    refine (hb_per_iff _).mpr ⟨m, n, ?_, ?_⟩
    · rw [← Int.cast_smul_eq_zsmul (R := ℝ), ← Int.cast_smul_eq_zsmul (R := ℝ),
        map_add, map_smul, map_smul, b.repr_self, b.repr_self]
      simp
    · rw [← Int.cast_smul_eq_zsmul (R := ℝ), ← Int.cast_smul_eq_zsmul (R := ℝ),
        map_add, map_smul, map_smul, b.repr_self, b.repr_self]
      simp
  have isPer_ord : ∀ (z s : ℂ), isPer z → meromorphicOrderAt a (s + z) = meromorphicOrderAt a s := by
    intro z s hz
    have h_shift := (ha_shift_ord_nf 1 z s one_ne_zero).2
    have h_fun : (fun w : ℂ => a (w + z)) = a := funext hz
    rw [h_fun] at h_shift
    exact h_shift.symm
  
  let c : Fin 2 × Fin 2 → ℂ :=
    fun e => q₁ + ((e.1.val : ℝ) / 2) • b 0 + ((e.2.val : ℝ) / 2) • b 1
  have hc_sub_q₁ : ∀ e : Fin 2 × Fin 2,
      c e - q₁ = ((e.1.val : ℝ) / 2) • b 0 + ((e.2.val : ℝ) / 2) • b 1 := by
    intro e; dsimp [c]; abel
  have hc_inj_mod : ∀ e₁ e₂ : Fin 2 × Fin 2, isPer (c e₁ - c e₂) → e₁ = e₂ := by
    intro e₁ e₂ hper
    obtain ⟨m, n, hm, hn⟩ := (hb_per_iff (c e₁ - c e₂)).mp hper
    have h_diff : c e₁ - c e₂ = (c e₁ - q₁) - (c e₂ - q₁) := by abel
    rw [h_diff, hc_sub_q₁, hc_sub_q₁] at hm hn
    simp only [map_sub, map_add, map_smul, b.repr_self] at hm hn
    have hm' : ((e₁.1.val : ℝ) - (e₂.1.val : ℝ)) = 2 * (m : ℝ) := by
      simp [Fin.isValue] at hm; linarith
    have hn' : ((e₁.2.val : ℝ) - (e₂.2.val : ℝ)) = 2 * (n : ℝ) := by
      simp [Fin.isValue] at hn; linarith
    have hm_int : (e₁.1.val : ℤ) - (e₂.1.val : ℤ) = 2 * m := by exact_mod_cast hm'
    have hn_int : (e₁.2.val : ℤ) - (e₂.2.val : ℤ) = 2 * n := by exact_mod_cast hn'
    have h1 := e₁.1.isLt; have h2 := e₂.1.isLt
    have h3 := e₁.2.isLt; have h4 := e₂.2.isLt
    ext <;> omega
  have h_center_mem : ∀ q : ℂ, meromorphicOrderAt a q ≠ 0 →
      ∃ (e : Fin 2 × Fin 2) (m n : ℤ), q = c e + m • b 0 + n • b 1 := by
    intro q hq
    have hper2 : isPer (2 * (q - q₁)) := by
      intro s
      have h_id : 2 * q - (2 * q₁ - s) = s + 2 * (q - q₁) := by ring
      rw [← h_id, (ha_centers q hq).2, hq₁_odd, neg_neg]
    obtain ⟨M, N, hM, hN⟩ := (hb_per_iff (2 * (q - q₁))).mp hper2
    have h2_smul : (2 : ℂ) * (q - q₁) = (2 : ℝ) • (q - q₁) := by
      simp [Complex.real_smul]
    rw [h2_smul, map_smul] at hM hN
    simp only [Finsupp.coe_smul, Pi.smul_apply, smul_eq_mul] at hM hN
    have he₁_lt : (M % 2).toNat < 2 := by omega
    have he₂_lt : (N % 2).toNat < 2 := by omega
    let e : Fin 2 × Fin 2 := (⟨(M % 2).toNat, he₁_lt⟩, ⟨(N % 2).toNat, he₂_lt⟩)
    let m : ℤ := M / 2
    let n : ℤ := N / 2
    have hM_split : M = 2 * m + (e.1.val : ℤ) := by
      dsimp [e, m]; omega
    have hN_split : N = 2 * n + (e.2.val : ℤ) := by
      dsimp [e, n]; omega
    refine ⟨e, m, n, ?_⟩
    suffices h_sub : q - q₁ = (c e - q₁) + m • b 0 + n • b 1 by
      linear_combination h_sub
    apply b.repr.injective
    ext i
    fin_cases i
    · rw [hc_sub_q₁, ← Int.cast_smul_eq_zsmul (R := ℝ), ← Int.cast_smul_eq_zsmul (R := ℝ),
        map_add, map_add, map_add, map_smul, map_smul, map_smul, map_smul, b.repr_self, b.repr_self]
      simp at hM ⊢
      have hM_real : (M : ℝ) = 2 * (m : ℝ) + (e.1.val : ℝ) := by exact_mod_cast hM_split
      linarith
    · rw [hc_sub_q₁, ← Int.cast_smul_eq_zsmul (R := ℝ), ← Int.cast_smul_eq_zsmul (R := ℝ),
        map_add, map_add, map_add, map_smul, map_smul, map_smul, map_smul, b.repr_self, b.repr_self]
      simp at hN ⊢
      have hN_real : (N : ℝ) = 2 * (n : ℝ) + (e.2.val : ℝ) := by exact_mod_cast hN_split
      linarith
  have hc_centers : ∀ e : Fin 2 × Fin 2,
      meromorphicOrderAt a (c e) = 1 ∨ meromorphicOrderAt a (c e) = -1 := by
    intro e
    let W_e : ℂ := (e.1.val : ℤ) • b 0 + (e.2.val : ℤ) • b 1
    have hW_per : isPer W_e := isPer_zsmul _ _
    have h_id : (2 * q₁ - c e) + W_e = c e := by
      dsimp [c, W_e]
      rw [← Int.cast_smul_eq_zsmul (R := ℝ), ← Int.cast_smul_eq_zsmul (R := ℝ)]
      simp only [Int.cast_natCast, Complex.real_smul]
      push_cast
      ring
    have ha_neg : a (c e) = -a (c e) := by
      calc
        a (c e) = a ((2 * q₁ - c e) + W_e) := by rw [h_id]
        _ = a (2 * q₁ - c e) := hW_per _
        _ = -a (c e) := hq₁_odd (c e)
    have ha_ce_zero : a (c e) = 0 := by linear_combination ha_neg / 2
    exact (ha_centers (c e) ((ha_zero_iff (c e)).mp ha_ce_zero)).1
  
  let P : Finset (Fin 2 × Fin 2) :=
    Finset.univ.filter (fun e => meromorphicOrderAt a (c e) = -1)
  let Z : Finset (Fin 2 × Fin 2) :=
    Finset.univ.filter (fun e => meromorphicOrderAt a (c e) = 1)
  have hPZ_disj : Disjoint P Z := by
    rw [Finset.disjoint_filter]
    intro e _ hp hz
    rw [hp] at hz
    exact absurd hz (by decide)
  have hPZ_union : P ∪ Z = Finset.univ := by
    ext e
    simp only [Finset.mem_union, Finset.mem_filter, Finset.mem_univ, true_and, iff_true, P, Z]
    exact (hc_centers e).symm
  have hPZ_sum : P.card + Z.card = 4 := by
    have h_card := Finset.card_union_of_disjoint hPZ_disj
    rw [hPZ_union] at h_card
    have huniv : (Finset.univ : Finset (Fin 2 × Fin 2)).card = 4 := by decide
    omega
  have h_conj_rep : ∀ e : Fin 2 × Fin 2,
      ∃ e' : Fin 2 × Fin 2, isPer (starRingEnd ℂ (c e) - c e') := by
    intro e
    have h_bar_ne : meromorphicOrderAt a (starRingEnd ℂ (c e)) ≠ 0 := by
      rw [ha_conj_ord (c e)]
      rcases hc_centers e with h1 | hm1
      · rw [h1]; decide
      · rw [hm1]; decide
    obtain ⟨e', m, n, heq⟩ := h_center_mem (starRingEnd ℂ (c e)) h_bar_ne
    refine ⟨e', ?_⟩
    have h_diff : starRingEnd ℂ (c e) - c e' = m • b 0 + n • b 1 := by
      linear_combination heq
    rw [h_diff]
    exact isPer_zsmul m n
  let σ : Fin 2 × Fin 2 → Fin 2 × Fin 2 := fun e => Classical.choose (h_conj_rep e)
  have hσ_per : ∀ e : Fin 2 × Fin 2, isPer (starRingEnd ℂ (c e) - c (σ e)) :=
    fun e => Classical.choose_spec (h_conj_rep e)
  have hσ_ord : ∀ e : Fin 2 × Fin 2,
      meromorphicOrderAt a (c (σ e)) = -meromorphicOrderAt a (c e) := by
    intro e
    have h_eq : starRingEnd ℂ (c e) = c (σ e) + (starRingEnd ℂ (c e) - c (σ e)) := by abel
    have h_per_ord := isPer_ord (starRingEnd ℂ (c e) - c (σ e)) (c (σ e)) (hσ_per e)
    rw [← h_eq, ha_conj_ord] at h_per_ord
    exact h_per_ord.symm
  have hσ_inj : Function.Injective σ := by
    intro e₁ e₂ h_eq
    have h₁ := hσ_per e₁
    have h₂ := hσ_per e₂
    rw [← h_eq] at h₂
    have h_sub := isPer_sub _ _ h₁ h₂
    have h_bar : starRingEnd ℂ (c e₁ - c e₂) =
        (starRingEnd ℂ (c e₁) - c (σ e₁)) - (starRingEnd ℂ (c e₂) - c (σ e₁)) := by
      simp only [map_sub]; abel
    rw [← h_bar] at h_sub
    have h_unbar : isPer (c e₁ - c e₂) := by
      simpa [Complex.conj_conj] using ha_conj_per _ h_sub
    exact hc_inj_mod e₁ e₂ h_unbar
  have hP_le_Z : P.card ≤ Z.card := by
    refine Finset.card_le_card_of_injOn σ (fun e he => ?_) hσ_inj.injOn
