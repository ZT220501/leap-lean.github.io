          have hv2_mero : MeromorphicAt (iteratedDeriv 2 v_j) 0 := by
            rw [hv2_eq_d]; exact hv_mero.deriv.deriv
          have hv2_exact : meromorphicOrderAt (iteratedDeriv 2 v_j) 0 =
              (((m - 2 : ℤ)) : WithTop ℤ) := by
            refine (meromorphicOrderAt_eq_int_iff hv2_mero).mpr ⟨g₂, hg₂_ana, hg₂_ne, ?_⟩
            rw [hv2_eq_d]
