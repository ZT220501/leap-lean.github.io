          ih (Nat.lt_of_succ_lt hk1) p_mid r'_mid M_mid hp_mid_B0 hp_mid_exc0
            hr'_mid_pos hball_r'mid_Ω0
            (fun ι => (hM_mid_holo_rm ι).mono (fun q hq => (hball_r'mid_sub hq).1))
            hM_mid_solves_i0
        refine ⟨p_bot, r_bot, M_bot, hp_bot_uni, hp_bot_base, hr_bot_pos, hball_rbot_uni,
          hM_bot_holo, hM_bot_solves, ?_⟩
        intro Ψ hΨ
        have h1 := hTransfer_detour hΨ (hΩ_open i₁) hreg1_sub_Ω1 hr_curr hball_curr
          hr_m_pos (hF_holo i₁) hM_curr_holo hCh
        have h2 := hTransfer_overlap hΨ
          Metric.isOpen_ball (convex_ball _ _).isPreconnected
          Metric.isOpen_ball (convex_ball _ _).isPreconnected
          Metric.isOpen_ball (Metric.nonempty_ball.mpr hr'_mid_pos)
          (fun q hq => (hball_r'mid_sub hq).1) Subset.rfl
          (fun q hq c => (hF_holo i₁ q hq c).mono (Set.Subset.trans hball_rm_sub hreg1_sub_Ω1))
          hM_mid_holo_rm
          (fun q hq c => (hF_holo i₀ q hq c).mono hball_r'mid_Ω0)
          (fun ι => (hM_mid_holo_rm ι).mono (fun q hq => (hball_r'mid_sub hq).1))
          hF1_eq_F0 (fun _ _ _ => rfl)
        exact h1.trans (h2.trans (h_ih_iff hΨ))
    refine ⟨hPrim_iff, ?_⟩
    intro M_top hM_top_holo hM_top_solves
    obtain ⟨p_init, ⟨hp_init_Btop, hp_init_anc⟩, hp_init_exc⟩ :=
      hH_exc_open_wit i_top (B_ball i_top ∩ Ω_anc)
        (Metric.isOpen_ball.inter hAnc_open) hTop_compat.1 Set.inter_subset_left
    have hreg_top_open : IsOpen { q ∈ B_ball i_top | H_exc i_top q ≠ 0 } :=
      (continuousOn_open_iff Metric.isOpen_ball).mp (hH_exc_holo i_top).continuousOn
        {(0 : ℂ)}ᶜ isOpen_compl_singleton
    obtain ⟨r_init, hr_init_pos, hV_init_sub_both⟩ :=
      Metric.isOpen_iff.mp (hAnc_open.inter hreg_top_open) p_init
        ⟨hp_init_anc, hp_init_Btop, hp_init_exc⟩
    let V_init : Set (ℂ × ℂ) := Metric.ball p_init r_init
    have hV_init_Ωtop : V_init ⊆ Ω_k i_top := by
      intro q hq
      have hq_reg := (hV_init_sub_both hq).2
      have hq_exc := hq_reg.2
      simp only [H_exc, mul_ne_zero_iff] at hq_exc
      exact ⟨hq_reg.1, hq_exc.1.1.1.1⟩
    have hFtop_eq_Fanc : ∀ q ∈ F_all, ∀ c : Fin 2,
        ∀ p ∈ V_init, F_k i_top q c p = F_anc q c p := by
      intro q hq c p hp
      have hp_Ωtop := hV_init_Ωtop hp
      exact hTop_compat.2 q hq c p ⟨hp_Ωtop.1, (hV_init_sub_both hp).1⟩
        ((hD_prod_nz i_top p).mp hp_Ωtop.2 q hq c)
    have hM_top_holo_V : ∀ ι : Fin 2, DifferentiableOn ℂ (M_top ι) V_init :=
      fun ι => (hM_top_holo ι).mono (fun q hq => ((hV_init_sub_both hq).1).1)
    have hM_top_solves_cl : ∀ ι : Fin 2, ∀ p ∈ V_init,
        ∑ d : Fin (E_base.D_det ι + 1), C_cl i_top ι d p * (M_top ι p) ^ (d : ℕ) = 0 := by
      intro ι p hp
      have h_congr : ∀ d : Fin (E_base.D_det ι + 1),
          MvPolynomial.eval (lineJetEnv (E_base.M_det ι) (F_k i_top 0) (F_k i_top b_int) p)
            (E_base.Q_det ι d) =
          MvPolynomial.eval (lineJetEnv (E_base.M_det ι) (F_anc 0) (F_anc b_int) p)
            (E_base.Q_det ι d) :=
        fun d => (hL_line_eval (E_base.M_det ι) (E_base.Q_det ι d)).2
          (M₁ := fun _ _ => 0) (M₂ := fun _ _ => 0)
          Metric.isOpen_ball hFtop_eq_Fanc (fun _ _ _ => rfl) p hp
      have h_ev_top :
          ∑ d : Fin (E_base.D_det ι + 1),
            MvPolynomial.eval (lineJetEnv (E_base.M_det ι) (F_k i_top 0) (F_k i_top b_int) p)
              (E_base.Q_det ι d) * (M_top ι p) ^ (d : ℕ) = 0 := by
        simpa only [h_congr] using hM_top_solves ι p (hV_init_sub_both hp).1
      exact (h_cl_solves_iff i_top ι p (hV_init_Ωtop hp) (M_top ι p)).mpr h_ev_top
    obtain ⟨p_bot, r_bot, M_bot, hp_bot_uni, hp_bot_base, hr_bot_pos, hball_rbot_uni,
        hM_bot_holo, hM_bot_solves, h_bot_iff⟩ :=
      h_desc_ind (L_vert - 1) (Nat.sub_lt hL_pos Nat.one_pos) p_init r_init M_top
        hp_init_Btop hp_init_exc hr_init_pos hV_init_Ωtop hM_top_holo_V hM_top_solves_cl
    let p_end : ℂ × ℂ := ((E_base.y₀ : ℂ), (E_base.t_end : ℂ))
    have hp_end_bidisk : p_end ∈ Metric.ball (E_base.y₀ : ℂ) E_base.r_y ×ˢ
        Metric.ball (0 : ℂ) E_base.r_t := by
      refine ⟨Metric.mem_ball_self E_base.r_y_pos, ?_⟩
      rw [Metric.mem_ball, dist_zero_right, Complex.norm_real, Real.norm_eq_abs,
        abs_of_pos E_base.t_end_pos]
      linarith [E_base.t_end_lt, E_base.r_t_pos]
    have hp_end_uni : p_end ∈ U_uni := E_base.bidisk_sub_unified hp_end_bidisk
    have hp_end_base_nz : H_base p_end ≠ 0 := by
      dsimp only [H_base]
      rw [← E_base.H_base_factor p_end hp_end_bidisk]
      refine mul_ne_zero (pow_ne_zero E_base.m_t ?_)
        (E_base.H_tilde_ne_zero p_end hp_end_bidisk)
      exact Complex.ofReal_ne_zero.mpr (ne_of_gt E_base.t_end_pos)
    obtain ⟨r_end_raw, M₁_end, hr_end_raw_pos, hball_raw_sub, hM₁_holo_raw,
        hM₁_solves_raw, hCh_end⟩ :=
      K_cont.detour_root_chain E_base.A_coeff p_bot p_end r_bot M_bot
        hUni_open hUni_conv hH_base_holo E_base.D_det_pos E_base.base_coeff_holo
        h_sep_base hp_bot_uni hp_bot_base hp_end_uni hp_end_base_nz
        hr_bot_pos hball_rbot_uni hM_bot_holo hM_bot_solves
    let r_end : ℝ :=
      min r_end_raw
        (min (3 * E_base.r_y / 4)
          (min (E_base.t_end / 2) (3 * E_base.r_t / 4 - E_base.t_end)))
    have hr_end_pos : 0 < r_end :=
      lt_min hr_end_raw_pos
        (lt_min (by linarith [E_base.r_y_pos])
          (lt_min (by linarith [E_base.t_end_pos]) (by linarith [E_base.t_end_lt])))
    have hr_end_le_raw : r_end ≤ r_end_raw := min_le_left _ _
    have hr_end_le_ry : r_end ≤ 3 * E_base.r_y / 4 :=
      le_trans (min_le_right _ _) (min_le_left _ _)
    have hr_end_le_t2 : r_end ≤ E_base.t_end / 2 :=
      le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_left _ _))
    have hr_end_le_gap : r_end ≤ 3 * E_base.r_t / 4 - E_base.t_end :=
      le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_right _ _))
    have hball_end_sub :
        Metric.ball p_end r_end ⊆
          Metric.ball (E_base.y₀ : ℂ) (3 * E_base.r_y / 4) ×ˢ
            { t : ℂ | 0 < ‖t‖ ∧ ‖t‖ < 3 * E_base.r_t / 4 } := by
      intro p hp
      rw [Metric.mem_ball, Prod.dist_eq] at hp
      have hp1 : dist p.1 (E_base.y₀ : ℂ) < r_end := lt_of_le_of_lt (le_max_left _ _) hp
      have hp2 : ‖p.2 - (E_base.t_end : ℂ)‖ < r_end := by
        simpa only [dist_eq_norm] using lt_of_le_of_lt (le_max_right _ _) hp
      have ht_norm : ‖(E_base.t_end : ℂ)‖ = E_base.t_end := by
        rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos E_base.t_end_pos]
      have h_tri_lo : E_base.t_end ≤ ‖p.2 - (E_base.t_end : ℂ)‖ + ‖p.2‖ := by
        calc E_base.t_end = ‖(E_base.t_end : ℂ)‖ := ht_norm.symm
          _ = ‖((E_base.t_end : ℂ) - p.2) + p.2‖ := by ring_nf
          _ ≤ ‖(E_base.t_end : ℂ) - p.2‖ + ‖p.2‖ := norm_add_le _ _
          _ = ‖p.2 - (E_base.t_end : ℂ)‖ + ‖p.2‖ := by rw [norm_sub_rev]
      have h_tri_hi : ‖p.2‖ ≤ ‖p.2 - (E_base.t_end : ℂ)‖ + E_base.t_end := by
        calc ‖p.2‖ = ‖(p.2 - (E_base.t_end : ℂ)) + (E_base.t_end : ℂ)‖ := by ring_nf
          _ ≤ ‖p.2 - (E_base.t_end : ℂ)‖ + ‖(E_base.t_end : ℂ)‖ := norm_add_le _ _
          _ = ‖p.2 - (E_base.t_end : ℂ)‖ + E_base.t_end := by rw [ht_norm]
      refine ⟨Metric.mem_ball.mpr (lt_of_lt_of_le hp1 hr_end_le_ry), ?_, ?_⟩
      · linarith [E_base.t_end_pos, hp2, hr_end_le_t2, h_tri_lo]
      · linarith [hp2, hr_end_le_gap, h_tri_hi]
    refine ⟨V_init, r_end, M₁_end, Metric.isOpen_ball,
      Metric.nonempty_ball.mpr hr_init_pos, fun q hq => (hV_init_sub_both hq).1,
      hr_end_pos, hball_end_sub,
      fun ι => (hM₁_holo_raw ι).mono (Metric.ball_subset_ball hr_end_le_raw),
      fun ι p hp => hM₁_solves_raw ι p (Metric.ball_subset_ball hr_end_le_raw hp), ?_⟩
    intro Ψ hΨ
    have h_init_eq :
        (∀ p ∈ V_init, Ψ F_anc M_top p = 0) ↔
        (∀ p ∈ V_init, Ψ (F_k i_top) M_top p = 0) :=
      hTransfer_overlap hΨ Metric.isOpen_ball (convex_ball _ _).isPreconnected
        Metric.isOpen_ball (convex_ball _ _).isPreconnected
        Metric.isOpen_ball (Metric.nonempty_ball.mpr hr_init_pos) Subset.rfl Subset.rfl
        (fun q hq c => (hAnc_holo q hq c).mono (fun r hr => (hV_init_sub_both hr).1))
        hM_top_holo_V
        (fun q hq c => (hF_holo i_top q hq c).mono hV_init_Ωtop)
        hM_top_holo_V
        (fun q hq c p hp => (hFtop_eq_Fanc q hq c p hp).symm)
        (fun _ _ _ => rfl)
    have h_end_det := hTransfer_detour hΨ hUni_open (fun _ hq => hq.1) hr_bot_pos
      hball_rbot_uni hr_end_raw_pos hUni_holo hM_bot_holo hCh_end
    have h_end_shrink := hTransfer_overlap hΨ
      Metric.isOpen_ball (convex_ball _ _).isPreconnected
      Metric.isOpen_ball (convex_ball _ _).isPreconnected
      Metric.isOpen_ball (Metric.nonempty_ball.mpr hr_end_pos)
      (Metric.ball_subset_ball hr_end_le_raw) Subset.rfl
      (fun q hq c => (hUni_holo q hq c).mono (fun r hr => (hball_raw_sub hr).1))
      hM₁_holo_raw
      (fun q hq c => (hUni_holo q hq c).mono
        (fun r hr => (hball_raw_sub (Metric.ball_subset_ball hr_end_le_raw hr)).1))
      (fun ι => (hM₁_holo_raw ι).mono (Metric.ball_subset_ball hr_end_le_raw))
      (fun _ _ _ _ _ => rfl) (fun _ _ _ => rfl)
    exact h_init_eq.trans ((h_bot_iff hΨ).trans (h_end_det.trans h_end_shrink))
  
  refine ⟨{
    primary_solves_at_anchor := fun ι => by
      have h_base : ∀ p ∈ U_uni,
          ∑ d : Fin (E_base.D_det ι + 1),
            MvPolynomial.eval
              (lineJetEnv (E_base.M_det ι) (dualLineShift C 0) (dualLineShift C b_int) p)
              (E_base.Q_det ι d) *
            (dualLineShift C 1 ι p) ^ (d : ℕ) = 0 := by
        intro p hp
        simpa only [b_int, E_base.A_coeff_def] using E_base.base_primary_solves ι p hp
      exact (hPrim_iff
        (hL_line_poly (E_base.M_det ι) (E_base.D_det ι) ι (E_base.Q_det ι))).mp h_base
    ascend_rank_one := fun h => (hPrim_iff hL_rank_one).mp h
    ascend_reflect := fun h p hp ι =>
      (hPrim_iff (hL_reflect_res ι)).mp (fun q hq => h q hq ι) p hp
    descend_primary_w2_zero := fun h => (hPrim_iff hL_w2_comp).mpr h
    descend_primary_iso_line := fun s_iso c_star h =>
      (hPrim_iff (hL_iso_line s_iso c_star)).mpr h
    descend_primary_prev_eq := fun h p hp =>
      ⟨(hPrim_iff hL_prev_cross₀).mpr (fun q hq => (h q hq).1) p hp,
       (hPrim_iff hL_prev_cross₁).mpr (fun q hq => (h q hq).2) p hp⟩
    primary_poly_transfer := fun M D ι_star P_coeff =>
      hPrim_iff (hL_sym_poly M D ι_star P_coeff)
    descend_branch := fun M_top hM_holo hM_solves ⟨ι_def, hM_ne⟩ => by
      obtain ⟨V_init, r_end, M₁_end, hV_open, hV_ne, hV_sub, hr_end_pos, hball_end_sub,
          hM₁_holo, hM₁_solves, hBr_iff⟩ := hBr_desc M_top hM_holo hM_solves
      refine ⟨V_init, r_end, M₁_end, hV_open, hV_ne, hV_sub, hr_end_pos, hball_end_sub,
        hM₁_holo, hM₁_solves, ?_,
        fun h => (hBr_iff hL_rank_one).mp (fun p hp => h p (hV_sub hp)),
        fun h p hp ι =>
          (hBr_iff (hL_reflect_res ι)).mp (fun q hq => h q (hV_sub hq) ι) p hp,
        fun h => (hBr_iff hL_w2_comp).mpr h,
        fun s_iso c_star h => (hBr_iff (hL_iso_line s_iso c_star)).mpr h,
        fun h p hp =>
          ⟨(hBr_iff hL_prev_cross₀).mpr (fun q hq => (h q hq).1) p hp,
           (hBr_iff hL_prev_cross₁).mpr (fun q hq => (h q hq).2) p hp⟩,
        fun M D ι_star P_coeff => hBr_iff (hL_sym_poly M D ι_star P_coeff)⟩
      refine ⟨ι_def, ?_⟩
      by_contra h_all_eq
      push Not at h_all_eq
      have h_diff_end :
          ∀ p ∈ Metric.ball ((E_base.y₀ : ℂ), (E_base.t_end : ℂ)) r_end,
            M₁_end ι_def p - dualLineShift C 1 ι_def p = 0 :=
        fun p hp => sub_eq_zero.mpr (h_all_eq p hp)
      have h_diff_init := (hBr_iff (hL_branch_diff ι_def)).mpr h_diff_end
      obtain ⟨p_wit, hp_wit_V, hp_wit_ne⟩ := hM_ne V_init hV_open hV_ne hV_sub
      exact hp_wit_ne (sub_eq_zero.mp (h_diff_init p_wit hp_wit_V))
  }⟩

theorem wall_loop_descent_to_punctured_collar (Ω : Set Plane)
    (C : AnalyticGlancingCollar Ω)
    (hDet : EndpointDeterminationData C)
    (W : CollarWidthTubeData C hDet)
    (hKit : Holo2DAndTaylorToolkit)
    (t₂ : ℝ)
    (D_wall : AlignedWallDefectData W t₂)
    (N_idx : ℕ)
    (q_idx : Fin N_idx → ℤ)
    (hq_unaligned : ∀ a : Fin N_idx, q_idx a ≤ 0 ∨ D_wall.K < (q_idx a).natAbs) :
    Nonempty (PuncturedGlancingBridgeData W t₂ D_wall q_idx) :=
by
  have hK_cont : ZeroAvoidingRootContKit :=
    zero_avoiding_preconnected_and_root_detour hKit
  obtain ⟨E_base⟩ :=
    endpoint_jet_clearing_and_glancing_bidisk Ω C hDet W hKit D_wall.K N_idx q_idx
  obtain ⟨Top⟩ :=
    wall_loop_top_branch_and_monodromy_transfer Ω C hDet W hKit t₂ D_wall N_idx q_idx
      hq_unaligned hK_cont
  obtain ⟨Vert⟩ :=
    vertical_chart_chain_ascent_descent Ω C hDet W hKit t₂ D_wall.H₂ D_wall.x_star
      D_wall.K N_idx q_idx D_wall.t₂_mem D_wall.h_L_eq_H₂ D_wall.H₂_ge hK_cont E_base
      Top.ρ Top.r_anchor Top.H_top_guard Top.ρ_pos Top.ρ_lt Top.r_anchor_pos
      Top.anchor_in_chart Top.guard_holo Top.guard_witness Top.guard_den_ne_zero
  have hM₁_top_solves :
      ∀ ι : Fin 2,
        ∀ p ∈ { p ∈ Metric.ball (wallAnchorPt D_wall.x_star D_wall.H₂ Top.ρ t₂) Top.r_anchor |
                  Top.H_top_guard p ≠ 0 },
          ∑ d : Fin (E_base.D_det ι + 1),
            MvPolynomial.eval
              (lineJetEnv (E_base.M_det ι)
                (wallAnchorField W D_wall.x_star D_wall.H₂ Top.ρ t₂ 0)
                (wallAnchorField W D_wall.x_star D_wall.H₂ Top.ρ t₂
                  (wallBridgeB D_wall.K : ℤ)) p)
              (E_base.Q_det ι d) *
            (Top.M₁_top ι p) ^ (d : ℕ) = 0 :=
    fun ι => Top.loop_root_transfer (E_base.M_det ι) (E_base.D_det ι) ι (E_base.Q_det ι)
      (Vert.primary_solves_at_anchor ι)
  obtain ⟨V_init, r_end, M₁_end, hV_init_open, hV_init_ne, hV_init_sub, hr_end_pos,
      hball_end_sub, hM₁_end_holo, hM₁_end_solves, hM₁_ne_primary,
      hDesc_rk, hDesc_rf, hDesc_w2, hDesc_iso, hDesc_prev, hDesc_poly⟩ :=
    Vert.descend_branch Top.M₁_top Top.M₁_top_holo hM₁_top_solves Top.M₁_top_ne_primary
  let S_sym : ℕ := Finset.univ.sup fun a : Fin N_idx => (q_idx a).natAbs
  let J_sym : ℝ := (S_sym : ℝ) + 2
  let S_all : ℕ := (wallAllShifts D_wall.K q_idx).sup (fun q : ℤ => q.natAbs)
  have hJ_sym_eq : J_sym = (S_sym : ℝ) + 2 := rfl
  have hS_sym_nonneg : (0 : ℝ) ≤ (S_sym : ℝ) := Nat.cast_nonneg S_sym
  have hJ_sym_ge_two : (2 : ℝ) ≤ J_sym := by linarith
  have h2J_sym_pos : (0 : ℝ) < 2 * J_sym := by linarith
  have hS_le : S_sym ≤ S_all := by
    refine Finset.sup_le (fun a _ => ?_)
    have hmem_un : q_idx a ∈ wallUnalignedShifts D_wall.K q_idx :=
      Finset.mem_union_right _ (Finset.mem_image_of_mem q_idx (Finset.mem_univ a))
    have hmem_all : q_idx a ∈ wallAllShifts D_wall.K q_idx :=
      Finset.mem_insert_of_mem hmem_un
    exact Finset.le_sup (f := fun q : ℤ => q.natAbs) hmem_all
  have hJ_le : J_sym ≤ wallAllJBound D_wall.K q_idx := by
    have hcast : (S_sym : ℝ) ≤ (S_all : ℝ) := Nat.cast_le.mpr hS_le
    change (S_sym : ℝ) + 2 ≤ (S_all : ℝ) + 2
    linarith
  have h2J_all_pos : (0 : ℝ) < 2 * wallAllJBound D_wall.K q_idx := by linarith
  have hUni_sub_sym :
      wallUnifiedDom W.s_base W.r_base D_wall.K q_idx ⊆
        symCollarDom W.s_base W.r_base q_idx := by
    intro p hp
    rcases hp with ⟨hp1, hp2, hp3⟩
    refine ⟨hp1, hp2, lt_of_lt_of_le hp3 ?_⟩
    exact div_le_div_of_nonneg_left (le_of_lt W.s_base_pos) h2J_sym_pos (by linarith)
  have hU_uni_open : IsOpen (wallUnifiedDom W.s_base W.r_base D_wall.K q_idx) := by
    refine IsOpen.inter ?_ (IsOpen.inter ?_ ?_)
    · exact isOpen_lt (continuous_abs.comp (Complex.continuous_im.comp continuous_fst))
        continuous_const
    · exact isOpen_lt (continuous_norm.comp continuous_snd) continuous_const
    · exact isOpen_lt (continuous_abs.comp (Complex.continuous_im.comp continuous_snd))
        continuous_const
  have hU_uni_ne : (wallUnifiedDom W.s_base W.r_base D_wall.K q_idx).Nonempty := by
    refine ⟨((0 : ℂ), (0 : ℂ)), ?_⟩
    refine ⟨?_, ?_, ?_⟩
    · simp only [Complex.zero_im, abs_zero]
      linarith [W.s_base_pos]
    · simpa only [norm_zero] using W.r_base_pos
    · simp only [Complex.zero_im, abs_zero]
      exact div_pos W.s_base_pos h2J_all_pos
  have hU_sym_open : IsOpen (symCollarDom W.s_base W.r_base q_idx) := by
    refine IsOpen.inter ?_ (IsOpen.inter ?_ ?_)
    · exact isOpen_lt (continuous_abs.comp (Complex.continuous_im.comp continuous_fst))
        continuous_const
    · exact isOpen_lt (continuous_norm.comp continuous_snd) continuous_const
    · exact isOpen_lt (continuous_abs.comp (Complex.continuous_im.comp continuous_snd))
        continuous_const
  have h_lin_lt : ∀ (x y M : ℝ), |x| < M → |y| < M →
      ∀ (a b : ℝ), 0 ≤ a → 0 ≤ b → a + b = 1 → |a * x + b * y| < M := by
    intro x y M hx hy a b ha hb hab
    have htri : |a * x + b * y| ≤ a * |x| + b * |y| := by
      calc |a * x + b * y| ≤ |a * x| + |b * y| := abs_add_le _ _
        _ = a * |x| + b * |y| := by
            rw [abs_mul, abs_mul, abs_of_nonneg ha, abs_of_nonneg hb]
    rcases eq_or_lt_of_le ha with rfl | ha_pos
    · simp only [zero_add] at hab
      subst hab
      linarith
    · have h1 : a * |x| < a * M := mul_lt_mul_of_pos_left hx ha_pos
      have h2 : b * |y| ≤ b * M := mul_le_mul_of_nonneg_left (le_of_lt hy) hb
      have h3 : a * M + b * M = M := by rw [← add_mul, hab, one_mul]
      linarith
  have hU_sym_convex : Convex ℝ (symCollarDom W.s_base W.r_base q_idx) := by
    intro p hp q hq a b ha hb hab
    rcases hp with ⟨hp1, hp2, hp3⟩
    rcases hq with ⟨hq1, hq2, hq3⟩
    refine ⟨?_, ?_, ?_⟩
    · have him : (a • p + b • q).1.im = a * p.1.im + b * q.1.im := by
        change (a • p.1 + b • q.1).im = a * p.1.im + b * q.1.im
        simp [Complex.add_im, Complex.real_smul, Complex.mul_im]
      rw [him]
      exact h_lin_lt p.1.im q.1.im (W.s_base / 2) hp1 hq1 a b ha hb hab
    · change ‖a • p.2 + b • q.2‖ < W.r_base
      have htri : ‖a • p.2 + b • q.2‖ ≤ a * ‖p.2‖ + b * ‖q.2‖ := by
        calc ‖a • p.2 + b • q.2‖ ≤ ‖a • p.2‖ + ‖b • q.2‖ := norm_add_le _ _
          _ = a * ‖p.2‖ + b * ‖q.2‖ := by
              rw [norm_smul, norm_smul, Real.norm_of_nonneg ha, Real.norm_of_nonneg hb]
      rcases eq_or_lt_of_le ha with rfl | ha_pos
      · simp only [zero_add] at hab
        subst hab
        linarith
      · have h1 : a * ‖p.2‖ < a * W.r_base := mul_lt_mul_of_pos_left hp2 ha_pos
        have h2 : b * ‖q.2‖ ≤ b * W.r_base := mul_le_mul_of_nonneg_left (le_of_lt hq2) hb
        have h3 : a * W.r_base + b * W.r_base = W.r_base := by rw [← add_mul, hab, one_mul]
        linarith
    · have him : (a • p + b • q).2.im = a * p.2.im + b * q.2.im := by
        change (a • p.2 + b • q.2).im = a * p.2.im + b * q.2.im
        simp [Complex.add_im, Complex.real_smul, Complex.mul_im]
      rw [him]
      exact h_lin_lt p.2.im q.2.im (W.s_base / (2 * J_sym)) hp3 hq3 a b ha hb hab
  have hU_sym_preconn : IsPreconnected (symCollarDom W.s_base W.r_base q_idx) :=
    hU_sym_convex.isPreconnected
  have hDual_holo_sym : ∀ (q : ℤ), |(q : ℝ)| ≤ J_sym → ∀ c : Fin 2,
      DifferentiableOn ℂ (dualLineShift C q c)
        (symCollarDom W.s_base W.r_base q_idx) := by
    intro q hq_le c
    have hAff_diff : Differentiable ℂ (fun r : ℂ × ℂ => (r.1 + (q : ℂ) * r.2, r.2)) :=
      (differentiable_fst.add ((differentiable_const _).mul differentiable_snd)).prodMk
        differentiable_snd
    have hAff_maps : Set.MapsTo (fun r : ℂ × ℂ => (r.1 + (q : ℂ) * r.2, r.2))
        (symCollarDom W.s_base W.r_base q_idx)
        { w : ℂ × ℂ | |w.1.im| < 2 * hDet.s_det ∧ ‖w.2‖ < 2 * hDet.r_det } := by
      intro r ⟨hr1, hr2, hr3⟩
      have hr3_mul : |r.2.im| * (2 * J_sym) < W.s_base :=
        (lt_div_iff₀ h2J_sym_pos).mp hr3
      have hJ_im : J_sym * |r.2.im| < W.s_base / 2 := by linarith
      have hq_im : |((q : ℂ) * r.2).im| < W.s_base / 2 := by
        have him_eq : ((q : ℂ) * r.2).im = (q : ℝ) * r.2.im := by
          simp [Complex.mul_im]
        rw [him_eq, abs_mul]
        exact lt_of_le_of_lt (mul_le_mul_of_nonneg_right hq_le (abs_nonneg _)) hJ_im
      have h_add : |(r.1 + (q : ℂ) * r.2).im| ≤ |r.1.im| + |((q : ℂ) * r.2).im| := by
        simpa only [Complex.add_im] using abs_add_le r.1.im ((q : ℂ) * r.2).im
      exact ⟨by linarith [W.s_base_le_det, hDet.s_det_pos],
        by linarith [W.r_base_le_det, hDet.r_det_pos]⟩
    change DifferentiableOn ℂ
      ((fun w : ℂ × ℂ => glancingDualLine C w.1 w.2 c) ∘
        (fun r : ℂ × ℂ => (r.1 + (q : ℂ) * r.2, r.2)))
      (symCollarDom W.s_base W.r_base q_idx)
    exact (hDet.dualLine_holo c).comp hAff_diff.differentiableOn hAff_maps
  have hDual0_holo : ∀ c : Fin 2,
      DifferentiableOn ℂ (dualLineShift C 0 c) (symCollarDom W.s_base W.r_base q_idx) :=
    fun c => hDual_holo_sym 0 (by norm_num; linarith) c
  have hDual1_holo : ∀ c : Fin 2,
      DifferentiableOn ℂ (dualLineShift C 1 c) (symCollarDom W.s_base W.r_base q_idx) :=
    fun c => hDual_holo_sym 1 (by norm_num; linarith) c
  have hDualNeg1_holo : ∀ c : Fin 2,
      DifferentiableOn ℂ (dualLineShift C (-1) c) (symCollarDom W.s_base W.r_base q_idx) :=
    fun c => hDual_holo_sym (-1) (by norm_num; linarith) c
  have hHomInt_holo : ∀ {E F : Fin 2 → ℂ × ℂ → ℂ},
      (∀ c : Fin 2, DifferentiableOn ℂ (E c) (symCollarDom W.s_base W.r_base q_idx)) →
      (∀ c : Fin 2, DifferentiableOn ℂ (F c) (symCollarDom W.s_base W.r_base q_idx)) →
      ∀ k : Fin 3,
        DifferentiableOn ℂ (homIntersect E F k) (symCollarDom W.s_base W.r_base q_idx) := by
    intro E F hE hF k
    fin_cases k
    · exact (hF 1).sub (hE 1)
    · exact (hE 0).sub (hF 0)
    · exact ((hE 0).mul (hF 1)).sub ((hE 1).mul (hF 0))
  have hJet_holo_sym : ∀ (M : ℕ) (v : SymJetVar N_idx M),
      DifferentiableOn ℂ (fun q => symJetEnv C q_idx M q v)
        (symCollarDom W.s_base W.r_base q_idx) := by
    intro M v
    have hv_nat : (q_idx v.1).natAbs ≤ S_sym :=
      Finset.le_sup (f := fun b : Fin N_idx => (q_idx b).natAbs) (Finset.mem_univ v.1)
    have hv_cast : (((q_idx v.1).natAbs : ℕ) : ℝ) ≤ (S_sym : ℝ) := Nat.cast_le.mpr hv_nat
    have hv_abs : |(q_idx v.1 : ℝ)| = (((q_idx v.1).natAbs : ℕ) : ℝ) := by
      rcases Int.natAbs_eq (q_idx v.1) with h | h
      · have hR := congrArg (Int.cast (R := ℝ)) h
        rw [Int.cast_natCast] at hR
        rw [hR, abs_of_nonneg (Nat.cast_nonneg _)]
      · have hR := congrArg (Int.cast (R := ℝ)) h
        rw [Int.cast_neg, Int.cast_natCast] at hR
        rw [hR, abs_neg, abs_of_nonneg (Nat.cast_nonneg _)]
    have hv_le : |(q_idx v.1 : ℝ)| ≤ J_sym := by linarith
    exact hKit.iterDerivYT_holo hU_sym_open (hDual_holo_sym (q_idx v.1) hv_le v.2.1)
      v.2.2.1.1 v.2.2.2.1
  have hEval_holo_sym : ∀ (M : ℕ) (P : MvPolynomial (SymJetVar N_idx M) ℂ),
      DifferentiableOn ℂ (fun q => MvPolynomial.eval (symJetEnv C q_idx M q) P)
        (symCollarDom W.s_base W.r_base q_idx) := by
    intro M P
    refine MvPolynomial.induction_on
      (motive := fun Q_p => DifferentiableOn ℂ
        (fun q => MvPolynomial.eval (symJetEnv C q_idx M q) Q_p)
        (symCollarDom W.s_base W.r_base q_idx))
      P
      (fun c => by
        simpa only [MvPolynomial.eval_C] using
          (differentiableOn_const c :
            DifferentiableOn ℂ (fun _ : ℂ × ℂ => c) (symCollarDom W.s_base W.r_base q_idx)))
      (fun P₁ P₂ ih₁ ih₂ => by
        have hfn :
            (fun q => MvPolynomial.eval (symJetEnv C q_idx M q) (P₁ + P₂)) =
              (fun q => MvPolynomial.eval (symJetEnv C q_idx M q) P₁ +
                MvPolynomial.eval (symJetEnv C q_idx M q) P₂) := by
          ext q
          exact map_add _ P₁ P₂
        rw [hfn]
        exact ih₁.add ih₂)
      (fun P₁ v ih => by
        have hfn :
            (fun q => MvPolynomial.eval (symJetEnv C q_idx M q) (P₁ * MvPolynomial.X v)) =
              (fun q => MvPolynomial.eval (symJetEnv C q_idx M q) P₁ *
                symJetEnv C q_idx M q v) := by
          ext q
          simp only [map_mul, MvPolynomial.eval_X]
        rw [hfn]
        exact ih.mul (hJet_holo_sym M v))
  refine ⟨{
    y₀ := E_base.y₀
    r_y := E_base.r_y
    r_t := E_base.r_t
    t_end := E_base.t_end
    r_end := r_end
    r_y_pos := E_base.r_y_pos
    r_t_pos := E_base.r_t_pos
    t_end_pos := E_base.t_end_pos
    t_end_lt := E_base.t_end_lt
    r_end_pos := hr_end_pos
    bidisk_sub_dom := Set.Subset.trans E_base.bidisk_sub_unified hUni_sub_sym
    ball_end_sub := hball_end_sub
    D_det := E_base.D_det
    D_det_pos := E_base.D_det_pos
    A_coeff := E_base.A_coeff
    m_t := E_base.m_t
    H_tilde := E_base.H_tilde
    coeff_holo := fun ι d => (E_base.base_coeff_holo ι d).mono E_base.bidisk_sub_unified
    H_tilde_holo := E_base.H_tilde_holo
    H_tilde_ne_zero := E_base.H_tilde_ne_zero
    lead_dvd := fun ι => by
      fin_cases ι
      · refine ⟨fun p => E_base.Δ_base 0 p *
            E_base.A_coeff 1 (Fin.last (E_base.D_det 1)) p * E_base.Δ_base 1 p, ?_, ?_⟩
        · exact (((E_base.base_disc_holo 0).mono E_base.bidisk_sub_unified).mul
            ((E_base.base_coeff_holo 1 (Fin.last (E_base.D_det 1))).mono
              E_base.bidisk_sub_unified)).mul
            ((E_base.base_disc_holo 1).mono E_base.bidisk_sub_unified)
        · intro p hp
          change p.2 ^ E_base.m_t * E_base.H_tilde p =
            E_base.A_coeff 0 (Fin.last (E_base.D_det 0)) p *
              (E_base.Δ_base 0 p * E_base.A_coeff 1 (Fin.last (E_base.D_det 1)) p *
                E_base.Δ_base 1 p)
          rw [E_base.H_base_factor p hp]
          ring
      · refine ⟨fun p => E_base.A_coeff 0 (Fin.last (E_base.D_det 0)) p *
            E_base.Δ_base 0 p * E_base.Δ_base 1 p, ?_, ?_⟩
        · exact (((E_base.base_coeff_holo 0 (Fin.last (E_base.D_det 0))).mono
              E_base.bidisk_sub_unified).mul
            ((E_base.base_disc_holo 0).mono E_base.bidisk_sub_unified)).mul
            ((E_base.base_disc_holo 1).mono E_base.bidisk_sub_unified)
        · intro p hp
          change p.2 ^ E_base.m_t * E_base.H_tilde p =
            E_base.A_coeff 1 (Fin.last (E_base.D_det 1)) p *
              (E_base.A_coeff 0 (Fin.last (E_base.D_det 0)) p * E_base.Δ_base 0 p *
                E_base.Δ_base 1 p)
          rw [E_base.H_base_factor p hp]
          ring
    separable_punc := E_base.separable_punc
    M₁_end := M₁_end
    M₁_end_holo := hM₁_end_holo
    M₁_end_solves := hM₁_end_solves
    M₁_ne_primary := hM₁_ne_primary
    fwd_rank_one := fun h_rk => by
      have h_rk_uni : ∀ p ∈ wallUnifiedDom W.s_base W.r_base D_wall.K q_idx,
          homRankOneDet (homIntersect (dualLineShift C 0) (dualLineShift C 1)) p = 0 := by
        intro p ⟨hp1, hp2, _⟩
        exact h_rk p (by linarith [W.s_base_le_det, W.s_base_pos])
          (lt_of_lt_of_le hp2 W.r_base_le_det)
      exact hDesc_rk (Top.loop_fwd_rank_one (Vert.ascend_rank_one h_rk_uni))
    fwd_reflect := fun h_rf => by
      have h_rf_uni : ∀ p ∈ wallUnifiedDom W.s_base W.r_base D_wall.K q_idx,
          ∀ ι : Fin 2, homReflectRes (dualLineShift C 0) (dualLineShift C 1) ι p = 0 := by
        intro p ⟨hp1, hp2, _⟩ ι
        exact h_rf p (by linarith [W.s_base_le_det, W.s_base_pos])
          (lt_of_lt_of_le hp2 W.r_base_le_det) ι
      exact hDesc_rf (Top.loop_fwd_reflect (Vert.ascend_reflect h_rf_uni))
    rev_w2_zero := fun h_w2_end => by
      have h_w2_uni : ∀ p ∈ wallUnifiedDom W.s_base W.r_base D_wall.K q_idx,
          homIntersect (dualLineShift C 0) (dualLineShift C 1) 2 p = 0 :=
        Vert.descend_primary_w2_zero
          (Top.loop_rev_w2_zero V_init hV_init_open hV_init_ne hV_init_sub
            (hDesc_w2 h_w2_end))
      exact hKit.eqOn_zero_of_preconnected_2D hU_sym_open hU_sym_preconn
        hU_uni_open hU_uni_ne hUni_sub_sym
        (hHomInt_holo hDual0_holo hDual1_holo 2) h_w2_uni
    rev_iso_line := fun s_iso c_star h_iso_end => by
      have h_iso_uni : ∀ p ∈ wallUnifiedDom W.s_base W.r_base D_wall.K q_idx,
          homIntersect (dualLineShift C 0) (dualLineShift C 1) 0 p +
            s_iso * Complex.I * homIntersect (dualLineShift C 0) (dualLineShift C 1) 1 p -
            c_star * homIntersect (dualLineShift C 0) (dualLineShift C 1) 2 p = 0 :=
        Vert.descend_primary_iso_line s_iso c_star
          (Top.loop_rev_iso_line s_iso c_star V_init hV_init_open hV_init_ne hV_init_sub
            (hDesc_iso s_iso c_star h_iso_end))
      have h_holo : DifferentiableOn ℂ
          (fun p => homIntersect (dualLineShift C 0) (dualLineShift C 1) 0 p +
            s_iso * Complex.I * homIntersect (dualLineShift C 0) (dualLineShift C 1) 1 p -
            c_star * homIntersect (dualLineShift C 0) (dualLineShift C 1) 2 p)
          (symCollarDom W.s_base W.r_base q_idx) :=
        ((hHomInt_holo hDual0_holo hDual1_holo 0).add
          ((differentiableOn_const (s_iso * Complex.I)).mul
            (hHomInt_holo hDual0_holo hDual1_holo 1))).sub
          ((differentiableOn_const c_star).mul
            (hHomInt_holo hDual0_holo hDual1_holo 2))
      exact hKit.eqOn_zero_of_preconnected_2D hU_sym_open hU_sym_preconn
        hU_uni_open hU_uni_ne hUni_sub_sym h_holo h_iso_uni
    rev_prev_eq := fun h_prev_end => by
      have h_prev_uni :=
        Vert.descend_primary_prev_eq
          (Top.loop_rev_prev_eq V_init hV_init_open hV_init_ne hV_init_sub
            (hDesc_prev h_prev_end))
      let W₁ := homIntersect (dualLineShift C 0) (dualLineShift C 1)
      let W₀ := homIntersect (dualLineShift C (-1)) (dualLineShift C 0)
      have hW₁ : ∀ k : Fin 3, DifferentiableOn ℂ (W₁ k) (symCollarDom W.s_base W.r_base q_idx) :=
        hHomInt_holo hDual0_holo hDual1_holo
      have hW₀ : ∀ k : Fin 3, DifferentiableOn ℂ (W₀ k) (symCollarDom W.s_base W.r_base q_idx) :=
        hHomInt_holo hDualNeg1_holo hDual0_holo
      have h0_sym : ∀ p ∈ symCollarDom W.s_base W.r_base q_idx,
          W₁ 0 p * W₀ 2 p - W₀ 0 p * W₁ 2 p = 0 :=
        hKit.eqOn_zero_of_preconnected_2D hU_sym_open hU_sym_preconn
          hU_uni_open hU_uni_ne hUni_sub_sym
          (((hW₁ 0).mul (hW₀ 2)).sub ((hW₀ 0).mul (hW₁ 2)))
          (fun p hp => (h_prev_uni p hp).1)
      have h1_sym : ∀ p ∈ symCollarDom W.s_base W.r_base q_idx,
          W₁ 1 p * W₀ 2 p - W₀ 1 p * W₁ 2 p = 0 :=
        hKit.eqOn_zero_of_preconnected_2D hU_sym_open hU_sym_preconn
          hU_uni_open hU_uni_ne hUni_sub_sym
          (((hW₁ 1).mul (hW₀ 2)).sub ((hW₀ 1).mul (hW₁ 2)))
          (fun p hp => (h_prev_uni p hp).2)
      exact fun p hp => ⟨h0_sym p hp, h1_sym p hp⟩
    poly_transfer := fun M D ι_star P_coeff => by
      have hPoly_holo : DifferentiableOn ℂ
          (fun q => ∑ d : Fin (D + 1),
            MvPolynomial.eval (symJetEnv C q_idx M q) (P_coeff d) *
              (dualLineShift C 1 ι_star q) ^ (d : ℕ))
          (symCollarDom W.s_base W.r_base q_idx) := by
        have h_sum : ∀ s : Finset (Fin (D + 1)),
            DifferentiableOn ℂ
              (fun q => ∑ d ∈ s,
                MvPolynomial.eval (symJetEnv C q_idx M q) (P_coeff d) *
                  (dualLineShift C 1 ι_star q) ^ (d : ℕ))
              (symCollarDom W.s_base W.r_base q_idx) := by
          intro s
          induction s using Finset.induction_on with
          | empty =>
            have h_fn0 :
                (fun q : ℂ × ℂ => ∑ d ∈ (∅ : Finset (Fin (D + 1))),
                  MvPolynomial.eval (symJetEnv C q_idx M q) (P_coeff d) *
                    (dualLineShift C 1 ι_star q) ^ (d : ℕ)) =
                (fun _ : ℂ × ℂ => (0 : ℂ)) := by
              ext q
              exact Finset.sum_empty
            rw [h_fn0]
            exact differentiableOn_const (0 : ℂ)
          | @insert d s hd ih =>
            have h_term : DifferentiableOn ℂ
                (fun q => MvPolynomial.eval (symJetEnv C q_idx M q) (P_coeff d) *
                  (dualLineShift C 1 ι_star q) ^ (d : ℕ))
                (symCollarDom W.s_base W.r_base q_idx) :=
              (hEval_holo_sym M (P_coeff d)).mul ((hDual1_holo ι_star).pow (d : ℕ))
            have h_fn :
                (fun q => ∑ j ∈ insert d s,
                  MvPolynomial.eval (symJetEnv C q_idx M q) (P_coeff j) *
                    (dualLineShift C 1 ι_star q) ^ (j : ℕ)) =
                (fun q =>
                  MvPolynomial.eval (symJetEnv C q_idx M q) (P_coeff d) *
                    (dualLineShift C 1 ι_star q) ^ (d : ℕ) +
                  ∑ j ∈ s,
                    MvPolynomial.eval (symJetEnv C q_idx M q) (P_coeff j) *
                      (dualLineShift C 1 ι_star q) ^ (j : ℕ)) := by
              ext q
              exact Finset.sum_insert hd
            rw [h_fn]
            exact h_term.add ih
        exact h_sum Finset.univ
      have h_sym_iff_uni :
          (∀ p ∈ symCollarDom W.s_base W.r_base q_idx,
            ∑ d : Fin (D + 1),
              MvPolynomial.eval (symJetEnv C q_idx M p) (P_coeff d) *
                (dualLineShift C 1 ι_star p) ^ (d : ℕ) = 0) ↔
          (∀ p ∈ wallUnifiedDom W.s_base W.r_base D_wall.K q_idx,
            ∑ d : Fin (D + 1),
              MvPolynomial.eval (symJetEnv C q_idx M p) (P_coeff d) *
                (dualLineShift C 1 ι_star p) ^ (d : ℕ) = 0) :=
        ⟨fun h p hp => h p (hUni_sub_sym hp),
         fun h => hKit.eqOn_zero_of_preconnected_2D hU_sym_open hU_sym_preconn
           hU_uni_open hU_uni_ne hUni_sub_sym hPoly_holo h⟩
      exact h_sym_iff_uni.trans
        ((Vert.primary_poly_transfer M D ι_star P_coeff).trans
          ((Top.loop_poly_transfer M D ι_star P_coeff V_init hV_init_open hV_init_ne
            hV_init_sub).trans
            (hDesc_poly M D ι_star P_coeff)))
  }⟩

theorem puiseux_log_cover_and_removable_germ (Ω : Set Plane)
    (C : AnalyticGlancingCollar Ω)
    (hDet : EndpointDeterminationData C)
    (W : CollarWidthTubeData C hDet)
    (hKit : Holo2DAndTaylorToolkit)
    (hSepCont : SeparableRectRootContProp)
    (t₂ : ℝ)
    (D_wall : AlignedWallDefectData W t₂)
    (N_idx : ℕ)
    (q_idx : Fin N_idx → ℤ)
    (B_col : BaseCollarBilliardData C hDet)
    (Br : PuncturedGlancingBridgeData W t₂ D_wall q_idx) :
    Nonempty (PuiseuxCoverGermData W t₂ D_wall q_idx Br) :=
by
  
  
  
  let rectOpen : ℝ → ℝ → ℝ → ℝ → Set ℂ :=
    fun a₁ a₂ b₁ b₂ => { w : ℂ | a₁ < w.re ∧ w.re < a₂ ∧ b₁ < w.im ∧ w.im < b₂ }
  have hRect_open : ∀ a₁ a₂ b₁ b₂, IsOpen (rectOpen a₁ a₂ b₁ b₂) := by
    intro a₁ a₂ b₁ b₂
    exact (isOpen_lt continuous_const Complex.continuous_re).inter
      ((isOpen_lt Complex.continuous_re continuous_const).inter
        ((isOpen_lt continuous_const Complex.continuous_im).inter
          (isOpen_lt Complex.continuous_im continuous_const)))
  have hRect_convex : ∀ a₁ a₂ b₁ b₂, Convex ℝ (rectOpen a₁ a₂ b₁ b₂) := by
    intro a₁ a₂ b₁ b₂ x hx y hy a b ha hb hab
    have hre : (a • x + b • y).re = a * x.re + b * y.re := by
      simp [Complex.add_re, Complex.real_smul, Complex.mul_re]
    have him : (a • x + b • y).im = a * x.im + b * y.im := by
      simp [Complex.add_im, Complex.real_smul, Complex.mul_im]
    have h_comb : ∀ {u v c₁ c₂ : ℝ}, c₁ < u → u < c₂ → c₁ < v → v < c₂ →
        c₁ < a * u + b * v ∧ a * u + b * v < c₂ := by
      intro u v c₁ c₂ hu1 hu2 hv1 hv2
      rcases eq_or_lt_of_le ha with rfl | ha_pos
      · have hb1 : b = 1 := by linarith
        subst hb1
        exact ⟨by linarith, by linarith⟩
      · have h1 : 0 < a * (u - c₁) := mul_pos ha_pos (sub_pos.mpr hu1)
        have h2 : 0 ≤ b * (v - c₁) := mul_nonneg hb (le_of_lt (sub_pos.mpr hv1))
        have h3 : 0 < a * (c₂ - u) := mul_pos ha_pos (sub_pos.mpr hu2)
        have h4 : 0 ≤ b * (c₂ - v) := mul_nonneg hb (le_of_lt (sub_pos.mpr hv2))
        have id1 : a * u + b * v - c₁ = a * (u - c₁) + b * (v - c₁) := by
          calc a * u + b * v - c₁ = a * u + b * v - (a + b) * c₁ := by rw [hab, one_mul]
            _ = a * (u - c₁) + b * (v - c₁) := by ring
        have id2 : c₂ - (a * u + b * v) = a * (c₂ - u) + b * (c₂ - v) := by
          calc c₂ - (a * u + b * v) = (a + b) * c₂ - (a * u + b * v) := by rw [hab, one_mul]
            _ = a * (c₂ - u) + b * (c₂ - v) := by ring
        exact ⟨by linarith, by linarith⟩
    obtain ⟨hr1, hr2⟩ := h_comb hx.1 hx.2.1 hy.1 hy.2.1
    obtain ⟨hi1, hi2⟩ := h_comb hx.2.2.1 hx.2.2.2 hy.2.2.1 hy.2.2.2
    exact ⟨by linarith, by linarith, by linarith, by linarith⟩
  have hHalf_open : ∀ B : ℝ, IsOpen { w : ℂ | w.re < B } :=
    fun B => isOpen_lt Complex.continuous_re continuous_const
  have hHalf_convex : ∀ B : ℝ, Convex ℝ { w : ℂ | w.re < B } := by
    intro B x hx y hy a b ha hb hab
    change (a • x + b • y).re < B
    have hre : (a • x + b • y).re = a * x.re + b * y.re := by
      simp [Complex.add_re, Complex.real_smul, Complex.mul_re]
    rw [hre]
    have hx' : x.re < B := hx
    have hy' : y.re < B := hy
    rcases eq_or_lt_of_le ha with rfl | ha_pos
    · have hb1 : b = 1 := by linarith
      subst hb1; linarith
    · have h1 : 0 < a * (B - x.re) := mul_pos ha_pos (sub_pos.mpr hx')
      have h2 : 0 ≤ b * (B - y.re) := mul_nonneg hb (le_of_lt (sub_pos.mpr hy'))
      have id1 : B - (a * x.re + b * y.re) = a * (B - x.re) + b * (B - y.re) := by
        calc B - (a * x.re + b * y.re) = (a + b) * B - (a * x.re + b * y.re) := by rw [hab, one_mul]
          _ = a * (B - x.re) + b * (B - y.re) := by ring
      linarith

  let U_Br : Set (ℂ × ℂ) := Metric.ball (Br.y₀ : ℂ) Br.r_y ×ˢ Metric.ball (0 : ℂ) Br.r_t
  let U_Br_punc : Set (ℂ × ℂ) :=
    Metric.ball (Br.y₀ : ℂ) Br.r_y ×ˢ (Metric.ball (0 : ℂ) Br.r_t \ {0})
  let B_end : Set (ℂ × ℂ) := Metric.ball ((Br.y₀ : ℂ), (Br.t_end : ℂ)) Br.r_end
  let U_log : Set (ℂ × ℂ) :=
    Metric.ball (Br.y₀ : ℂ) (5 * Br.r_y / 8) ×ˢ { w : ℂ | w.re < Real.log (3 * Br.r_t / 4) }
  let w_end : ℂ := (Real.log Br.t_end : ℂ)
  let q_end : ℂ × ℂ := ((Br.y₀ : ℂ), (Br.t_end : ℂ))
  let p_log_end : ℂ × ℂ := ((Br.y₀ : ℂ), w_end)
  let τ_2pi : ℂ := 2 * (Real.pi : ℂ) * Complex.I
  let E_exp : ℂ × ℂ → ℂ × ℂ := fun p => (p.1, Complex.exp p.2)

  have hU_log_open : IsOpen U_log :=
    Metric.isOpen_ball.prod (hHalf_open _)
  have hU_log_preconn : IsPreconnected U_log :=
    ((convex_ball (Br.y₀ : ℂ) (5 * Br.r_y / 8)).prod (hHalf_convex _)).isPreconnected
  have hE_exp_diff : Differentiable ℂ E_exp :=
    differentiable_fst.prodMk (Complex.differentiable_exp.comp differentiable_snd)
  have hlog_t_end_lt : Real.log Br.t_end < Real.log (3 * Br.r_t / 4) :=
    Real.log_lt_log Br.t_end_pos Br.t_end_lt
  have hlog_34_lt : Real.log (3 * Br.r_t / 4) < Real.log Br.r_t :=
    Real.log_lt_log (by linarith [Br.r_t_pos]) (by linarith [Br.r_t_pos])
  have hexp_w_end : Complex.exp w_end = (Br.t_end : ℂ) := by
    dsimp [w_end]
    rw [← Complex.ofReal_exp, Real.exp_log Br.t_end_pos]
  have hw_end_re : w_end.re = Real.log Br.t_end := Complex.ofReal_re _
  have hw_end_im : w_end.im = 0 := Complex.ofReal_im _
  have hτ_2pi_re : τ_2pi.re = 0 := by simp [τ_2pi]
  have hexp_add_int : ∀ (z : ℂ) (n : ℤ), Complex.exp (z + (n : ℂ) * τ_2pi) = Complex.exp z := by
    intro z n
    rw [Complex.exp_add, show τ_2pi = 2 * ↑Real.pi * Complex.I from rfl,
      Complex.exp_int_mul_two_pi_mul_I, mul_one]
  have hexp_mem_punc : ∀ y w : ℂ,
      y ∈ Metric.ball (Br.y₀ : ℂ) Br.r_y → w.re < Real.log Br.r_t →
        (y, Complex.exp w) ∈ U_Br_punc := by
    intro y w hy hw
    refine ⟨hy, ⟨?_, Complex.exp_ne_zero w⟩⟩
    rw [Metric.mem_ball, dist_zero_right, Complex.norm_exp]
    have hexp_lt := Real.exp_lt_exp.mpr hw
    rwa [Real.exp_log Br.r_t_pos] at hexp_lt
  have hU_log_maps_Br : ∀ p ∈ U_log, E_exp p ∈ U_Br_punc :=
    fun p hp => hexp_mem_punc p.1 p.2
      (Metric.ball_subset_ball (by linarith [Br.r_y_pos]) hp.1)
      (lt_trans hp.2 hlog_34_lt)
  have hB_end_sub_Br : B_end ⊆ U_Br := by
    intro p hp
    obtain ⟨hp1, hp2_pos, hp2_lt⟩ := Br.ball_end_sub hp
    exact ⟨Metric.ball_subset_ball (by linarith [Br.r_y_pos]) hp1,
      by rw [Metric.mem_ball, dist_zero_right]; linarith [Br.r_t_pos]⟩

  
  
  
  have h_s1 : ∃ (d : ℕ) (r_log_end : ℝ) (M_log : Fin 2 → ℂ × ℂ → ℂ),
      1 ≤ d ∧ 0 < r_log_end ∧
      (∀ ι : Fin 2, DifferentiableOn ℂ (M_log ι) U_log) ∧
      (∀ ι : Fin 2, ∀ p ∈ U_log,
        ∑ m : Fin (Br.D_det ι + 1),
          Br.A_coeff ι m (p.1, Complex.exp p.2) * (M_log ι p) ^ (m : ℕ) = 0) ∧
      (∀ ι : Fin 2, ∀ p ∈ U_log, ∀ n : ℤ,
        M_log ι (p.1, p.2 + (n : ℂ) * ((d : ℂ) * τ_2pi)) = M_log ι p) ∧
      Metric.ball p_log_end r_log_end ⊆ U_log ∧
      (∀ p ∈ Metric.ball p_log_end r_log_end, (p.1, Complex.exp p.2) ∈ B_end) ∧
      (∀ ι : Fin 2, ∀ p ∈ Metric.ball p_log_end r_log_end,
        M_log ι p = Br.M₁_end ι (p.1, Complex.exp p.2)) := by
    
    let δ_w0 : ℝ := (Real.log (3 * Br.r_t / 4) - Real.log Br.t_end) / 2
    have hδ_w0_pos : 0 < δ_w0 := by dsimp [δ_w0]; linarith
    have hw_ball_re : ∀ w ∈ Metric.ball w_end δ_w0, w.re < Real.log (3 * Br.r_t / 4) := by
      intro w hw
      have hre_sub : |w.re - Real.log Br.t_end| < δ_w0 := by
        have h1 : |(w - w_end).re| ≤ ‖w - w_end‖ := Complex.abs_re_le_norm (w - w_end)
        have h2 : ‖w - w_end‖ < δ_w0 := by simpa [Metric.mem_ball, dist_eq_norm] using hw
        have h3 : (w - w_end).re = w.re - Real.log Br.t_end := by simp [w_end]
        rw [h3] at h1
        exact lt_of_le_of_lt h1 h2
      rw [abs_lt] at hre_sub
      dsimp [δ_w0] at hre_sub
      linarith
    let a₁ : ℝ := Br.y₀ - 7 * Br.r_y / 10
    let a₂ : ℝ := Br.y₀ + 7 * Br.r_y / 10
    let b₁ : ℝ := -7 * Br.r_y / 10
    let b₂ : ℝ := 7 * Br.r_y / 10
    let a₁' : ℝ := Br.y₀ - 13 * Br.r_y / 20
    let a₂' : ℝ := Br.y₀ + 13 * Br.r_y / 20
    let b₁' : ℝ := -13 * Br.r_y / 20
    let b₂' : ℝ := 13 * Br.r_y / 20
    have hQy_sub : rectOpen a₁ a₂ b₁ b₂ ⊆ Metric.ball (Br.y₀ : ℂ) Br.r_y := by
      intro y hy
      rw [Metric.mem_ball, dist_eq_norm]
      have hsq : ‖y - (Br.y₀ : ℂ)‖ ^ 2 = (y.re - Br.y₀) ^ 2 + y.im ^ 2 := by
        rw [← Complex.normSq_eq_norm_sq, Complex.normSq_apply]
        simp
        ring
      obtain ⟨hy1, hy2, hy3, hy4⟩ := hy
      dsimp [a₁, a₂, b₁, b₂] at hy1 hy2 hy3 hy4
      have hre_sq : (y.re - Br.y₀) ^ 2 < (7 * Br.r_y / 10) ^ 2 := by nlinarith
      have him_sq : y.im ^ 2 < (7 * Br.r_y / 10) ^ 2 := by nlinarith
      have hnorm_sq : ‖y - (Br.y₀ : ℂ)‖ ^ 2 < Br.r_y ^ 2 := by
        nlinarith [Br.r_y_pos]
      nlinarith [norm_nonneg (y - (Br.y₀ : ℂ)), Br.r_y_pos]
    have hBall58_sub_Qy' : Metric.ball (Br.y₀ : ℂ) (5 * Br.r_y / 8) ⊆ rectOpen a₁' a₂' b₁' b₂' := by
      intro y hy
      have hnorm : ‖y - (Br.y₀ : ℂ)‖ < 5 * Br.r_y / 8 := by
        simpa [Metric.mem_ball, dist_eq_norm] using hy
      have hre : |y.re - Br.y₀| < 13 * Br.r_y / 20 := by
        have h1 : |(y - (Br.y₀ : ℂ)).re| ≤ ‖y - (Br.y₀ : ℂ)‖ := Complex.abs_re_le_norm _
        simp only [Complex.sub_re, Complex.ofReal_re] at h1
        linarith [Br.r_y_pos]
      have him : |y.im| < 13 * Br.r_y / 20 := by
        have h1 : |(y - (Br.y₀ : ℂ)).im| ≤ ‖y - (Br.y₀ : ℂ)‖ := Complex.abs_im_le_norm _
        simp only [Complex.sub_im, Complex.ofReal_im, sub_zero] at h1
        linarith [Br.r_y_pos]
      rw [abs_lt] at hre him
      exact ⟨by dsimp [a₁']; linarith, by dsimp [a₂']; linarith,
        by dsimp [b₁']; linarith, by dsimp [b₂']; linarith⟩
    have hInit_sep : ∀ ι : Fin 2,
        let U_init := rectOpen a₁ a₂ b₁ b₂ ×ˢ Metric.ball w_end δ_w0
        let A_init : Fin (Br.D_det ι + 1) → ℂ × ℂ → ℂ :=
          fun m q => Br.A_coeff ι m (E_exp q)
        (∀ m : Fin (Br.D_det ι + 1), DifferentiableOn ℂ (A_init m) U_init) ∧
        (∀ q ∈ U_init,
          A_init (Fin.last (Br.D_det ι)) q ≠ 0 ∧
          ∀ z : ℂ,
            ∑ m : Fin (Br.D_det ι + 1), A_init m q * z ^ (m : ℕ) = 0 →
            ∑ m : Fin (Br.D_det ι),
              (((m : ℕ) + 1 : ℕ) : ℂ) * A_init m.succ q * z ^ (m : ℕ) ≠ 0) := by
      intro ι
      have hmaps : ∀ q ∈ rectOpen a₁ a₂ b₁ b₂ ×ˢ Metric.ball w_end δ_w0,
          E_exp q ∈ U_Br_punc :=
        fun q hq => hexp_mem_punc q.1 q.2 (hQy_sub hq.1) (lt_trans (hw_ball_re q.2 hq.2) hlog_34_lt)
      refine ⟨fun m => (Br.coeff_holo ι m).comp hE_exp_diff.differentiableOn
        (fun q hq => ⟨(hmaps q hq).1, (hmaps q hq).2.1⟩),
        fun q hq => Br.separable_punc ι (E_exp q) (hmaps q hq)⟩
    have h_init_ex : ∀ ι : Fin 2,
        ∃ (δ_t : ℝ) (Λ : ℂ × ℂ → ℂ),
          0 < δ_t ∧ δ_t ≤ δ_w0 ∧
          DifferentiableOn ℂ Λ (rectOpen a₁' a₂' b₁' b₂' ×ˢ Metric.ball w_end δ_t) ∧
          Λ ((Br.y₀ : ℂ), w_end) = Br.M₁_end ι q_end ∧
          ∀ q ∈ rectOpen a₁' a₂' b₁' b₂' ×ˢ Metric.ball w_end δ_t,
            ∑ m : Fin (Br.D_det ι + 1), Br.A_coeff ι m (E_exp q) * (Λ q) ^ (m : ℕ) = 0 := by
      intro ι
      have hpkg := hSepCont a₁ a₂ b₁ b₂ w_end δ_w0 (Br.D_det ι)
        (by dsimp [a₁, a₂]; linarith [Br.r_y_pos])
        (by dsimp [b₁, b₂]; linarith [Br.r_y_pos])
        hδ_w0_pos (Br.D_det_pos ι)
        (fun m q => Br.A_coeff ι m (E_exp q))
        (hInit_sep ι).1 (hInit_sep ι).2
      refine hpkg.2 a₁' a₂' b₁' b₂' (Br.y₀ : ℂ) (Br.M₁_end ι q_end)
        (by dsimp [a₁, a₁']; linarith [Br.r_y_pos])
        (by dsimp [a₁', a₂']; linarith [Br.r_y_pos])
        (by dsimp [a₂', a₂]; linarith [Br.r_y_pos])
        (by dsimp [b₁, b₁']; linarith [Br.r_y_pos])
        (by dsimp [b₁', b₂']; linarith [Br.r_y_pos])
        (by dsimp [b₂', b₂]; linarith [Br.r_y_pos])
        (by simp [a₁']; linarith [Br.r_y_pos])
        (by simp [a₂']; linarith [Br.r_y_pos])
        (by simp [b₁']; linarith [Br.r_y_pos])
        (by simp [b₂']; linarith [Br.r_y_pos]) ?_
      have h_eq : E_exp ((Br.y₀ : ℂ), w_end) = q_end := Prod.ext rfl hexp_w_end
      rw [h_eq]
      exact Br.M₁_end_solves ι q_end (Metric.mem_ball_self Br.r_end_pos)
    choose δ_init Λ_init hδ_init_pos hδ_init_le hΛ_init_holo hΛ_init_seed hΛ_init_solves
      using h_init_ex
    let δ_w1 : ℝ := min (δ_init 0) (δ_init 1)
    have hδ_w1_pos : 0 < δ_w1 := lt_min (hδ_init_pos 0) (hδ_init_pos 1)
    have hδ_w1_le : ∀ ι : Fin 2, δ_w1 ≤ δ_init ι := by
      intro ι; fin_cases ι <;> [exact min_le_left _ _; exact min_le_right _ _]
    have hE_p_log_end : E_exp p_log_end = q_end := Prod.ext rfl hexp_w_end
    have hE_nhds : E_exp ⁻¹' B_end ∈ nhds p_log_end :=
      hE_exp_diff.continuous.continuousAt.preimage_mem_nhds
        (hE_p_log_end.symm ▸ Metric.ball_mem_nhds q_end Br.r_end_pos)
    obtain ⟨r_e, hr_e_pos, hr_e_sub⟩ := Metric.mem_nhds_iff.mp hE_nhds
    let r_log_end : ℝ := min r_e (min (5 * Br.r_y / 8) δ_w1)
    have hr_log_end_pos : 0 < r_log_end :=
      lt_min hr_e_pos (lt_min (by positivity [Br.r_y_pos]) hδ_w1_pos)
    have hr_log_le_58 : r_log_end ≤ 5 * Br.r_y / 8 :=
      le_trans (min_le_right r_e (min (5 * Br.r_y / 8) δ_w1)) (min_le_left _ _)
    have hr_log_le_w1 : r_log_end ≤ δ_w1 :=
      le_trans (min_le_right r_e (min (5 * Br.r_y / 8) δ_w1)) (min_le_right _ _)
    have hexp_maps_end : ∀ p ∈ Metric.ball p_log_end r_log_end, E_exp p ∈ B_end :=
      fun p hp => hr_e_sub (Metric.ball_subset_ball (min_le_left _ _) hp)
    have hB_log_end_sub : Metric.ball p_log_end r_log_end ⊆ U_log := by
      intro p hp
      rw [← ball_prod_same] at hp
      exact ⟨Metric.ball_subset_ball hr_log_le_58 hp.1,
        hw_ball_re p.2 (Metric.ball_subset_ball
          (le_trans hr_log_le_w1 (le_trans (hδ_w1_le 0) (hδ_init_le 0))) hp.2)⟩
    have hΛ_eq_end : ∀ ι : Fin 2, ∀ p ∈ Metric.ball p_log_end r_log_end,
        Λ_init ι p = Br.M₁_end ι (E_exp p) := by
      intro ι p hp
      have hpkg := hSepCont a₁ a₂ b₁ b₂ w_end δ_w0 (Br.D_det ι)
        (by dsimp [a₁, a₂]; linarith [Br.r_y_pos])
        (by dsimp [b₁, b₂]; linarith [Br.r_y_pos])
        hδ_w0_pos (Br.D_det_pos ι)
        (fun m q => Br.A_coeff ι m (E_exp q))
        (hInit_sep ι).1 (hInit_sep ι).2
      have hsub_init : Metric.ball p_log_end r_log_end ⊆
          rectOpen a₁' a₂' b₁' b₂' ×ˢ Metric.ball w_end (δ_init ι) := by
        intro q hq
        rw [← ball_prod_same] at hq
        exact ⟨hBall58_sub_Qy' (Metric.ball_subset_ball hr_log_le_58 hq.1),
          Metric.ball_subset_ball (le_trans hr_log_le_w1 (hδ_w1_le ι)) hq.2⟩
      have hsub_outer : Metric.ball p_log_end r_log_end ⊆
          rectOpen a₁ a₂ b₁ b₂ ×ˢ Metric.ball w_end δ_w0 := by
        intro q hq
        obtain ⟨hq1, hq2⟩ := hsub_init hq
        exact ⟨⟨by dsimp [a₁, a₁'] at hq1 ⊢; linarith [Br.r_y_pos, hq1.1],
                by dsimp [a₂, a₂'] at hq1 ⊢; linarith [Br.r_y_pos, hq1.2.1],
                by dsimp [b₁, b₁'] at hq1 ⊢; linarith [Br.r_y_pos, hq1.2.2.1],
                by dsimp [b₂, b₂'] at hq1 ⊢; linarith [Br.r_y_pos, hq1.2.2.2]⟩,
          Metric.ball_subset_ball (hδ_init_le ι) hq2⟩
      exact hpkg.1 (Metric.ball p_log_end r_log_end) (Λ_init ι)
        (fun q => Br.M₁_end ι (E_exp q)) p_log_end
        Metric.isOpen_ball (convex_ball _ _).isPreconnected hsub_outer
        (Metric.mem_ball_self hr_log_end_pos)
        ((hΛ_init_holo ι).mono hsub_init)
        ((Br.M₁_end_holo ι).comp hE_exp_diff.differentiableOn hexp_maps_end)
        (fun q hq => hΛ_init_solves ι q (hsub_init hq))
        (fun q hq => Br.M₁_end_solves ι (E_exp q) (hexp_maps_end q hq))
        (by rw [hΛ_init_seed ι, hE_p_log_end]) p hp

    
    let E_swap : ℂ × ℂ → ℂ × ℂ := fun q => (q.2, Complex.exp q.1)
    have hE_swap_diff : Differentiable ℂ E_swap :=
      differentiable_snd.prodMk (Complex.differentiable_exp.comp differentiable_fst)
    let R_w : ℂ → Set ℂ := fun w_st =>
      rectOpen (min w_st.re w_end.re - 2) (Real.log Br.r_t)
        (min w_st.im 0 - 2) (max w_st.im 0 + 2)
    let R'_w : ℂ → Set ℂ := fun w_st =>
      rectOpen (min w_st.re w_end.re - 1) (Real.log (3 * Br.r_t / 4))
        (min w_st.im 0 - 1) (max w_st.im 0 + 1)
    have hRw_sub : ∀ w_st : ℂ, R'_w w_st ⊆ R_w w_st := by
      intro w_st w ⟨h1, h2, h3, h4⟩
      exact ⟨by linarith, lt_trans h2 hlog_34_lt, by linarith, by linarith⟩
    have hw_end_mem_R' : ∀ w_st : ℂ, w_end ∈ R'_w w_st := by
      intro w_st
      refine ⟨?_, ?_, ?_, ?_⟩
      · linarith [min_le_right w_st.re w_end.re]
      · simpa [hw_end_re] using hlog_t_end_lt
      · linarith [min_le_right w_st.im 0, hw_end_im]
      · linarith [le_max_right w_st.im 0, hw_end_im]
    have hw_self_mem_R' : ∀ w_st : ℂ, w_st.re < Real.log (3 * Br.r_t / 4) → w_st ∈ R'_w w_st := by
      intro w_st hw_re
      exact ⟨by linarith [min_le_left w_st.re w_end.re], hw_re,
        by linarith [min_le_left w_st.im 0], by linarith [le_max_left w_st.im 0]⟩
    have hSep_swap : ∀ (w_st t_c : ℂ) (r_ty : ℝ) (ι : Fin 2),
        0 < r_ty → Metric.ball t_c r_ty ⊆ Metric.ball (Br.y₀ : ℂ) Br.r_y →
        let U_sw := R_w w_st ×ˢ Metric.ball t_c r_ty
        let A_sw : Fin (Br.D_det ι + 1) → ℂ × ℂ → ℂ :=
          fun m q => Br.A_coeff ι m (E_swap q)
        ((∀ (V : Set (ℂ × ℂ)) (g₁ g₂ : ℂ × ℂ → ℂ) (q₀ : ℂ × ℂ),
            IsOpen V → IsPreconnected V → V ⊆ U_sw → q₀ ∈ V →
            DifferentiableOn ℂ g₁ V → DifferentiableOn ℂ g₂ V →
            (∀ q ∈ V, ∑ m : Fin (Br.D_det ι + 1), A_sw m q * (g₁ q) ^ (m : ℕ) = 0) →
            (∀ q ∈ V, ∑ m : Fin (Br.D_det ι + 1), A_sw m q * (g₂ q) ^ (m : ℕ) = 0) →
            g₁ q₀ = g₂ q₀ → ∀ q ∈ V, g₁ q = g₂ q) ∧
          (∀ (a₁' a₂' b₁' b₂' : ℝ) (w₀ z₀ : ℂ),
            min w_st.re w_end.re - 2 < a₁' → a₁' < a₂' → a₂' < Real.log Br.r_t →
            min w_st.im 0 - 2 < b₁' → b₁' < b₂' → b₂' < max w_st.im 0 + 2 →
            a₁' < w₀.re → w₀.re < a₂' → b₁' < w₀.im → w₀.im < b₂' →
            ∑ m : Fin (Br.D_det ι + 1), A_sw m (w₀, t_c) * z₀ ^ (m : ℕ) = 0 →
            ∃ (δ_t : ℝ) (Λ : ℂ × ℂ → ℂ),
              0 < δ_t ∧ δ_t ≤ r_ty ∧
              DifferentiableOn ℂ Λ (rectOpen a₁' a₂' b₁' b₂' ×ˢ Metric.ball t_c δ_t) ∧
              Λ (w₀, t_c) = z₀ ∧
              ∀ q ∈ rectOpen a₁' a₂' b₁' b₂' ×ˢ Metric.ball t_c δ_t,
                ∑ m : Fin (Br.D_det ι + 1), A_sw m q * (Λ q) ^ (m : ℕ) = 0)) := by
      intro w_st t_c r_ty ι hr_ty hball_sub
      have hmaps : ∀ q ∈ R_w w_st ×ˢ Metric.ball t_c r_ty, E_swap q ∈ U_Br_punc :=
        fun q hq => hexp_mem_punc q.2 q.1 (hball_sub hq.2) hq.1.2.1
      exact hSepCont (min w_st.re w_end.re - 2) (Real.log Br.r_t)
        (min w_st.im 0 - 2) (max w_st.im 0 + 2) t_c r_ty (Br.D_det ι)
        (by linarith [min_le_right w_st.re w_end.re, hw_end_re, hlog_t_end_lt, hlog_34_lt])
        (by linarith [min_le_right w_st.im 0, le_max_right w_st.im 0])
        hr_ty (Br.D_det_pos ι)
        (fun m q => Br.A_coeff ι m (E_swap q))
        (fun m => (Br.coeff_holo ι m).comp hE_swap_diff.differentiableOn
          (fun q hq => ⟨(hmaps q hq).1, (hmaps q hq).2.1⟩))
        (fun q hq => Br.separable_punc ι (E_swap q) (hmaps q hq))
    let r_y_loc : U_log → ℝ := fun u => 5 * Br.r_y / 8 - dist u.1.1 (Br.y₀ : ℂ)
    have hr_y_loc_pos : ∀ u : U_log, 0 < r_y_loc u := by
      intro u
      have hu : dist u.1.1 (Br.y₀ : ℂ) < 5 * Br.r_y / 8 := Metric.mem_ball.mp u.2.1
      dsimp [r_y_loc]; linarith
    have hr_y_loc_sub58 : ∀ u : U_log,
        Metric.ball u.1.1 (r_y_loc u) ⊆ Metric.ball (Br.y₀ : ℂ) (5 * Br.r_y / 8) :=
      fun u => Metric.ball_subset_ball' (by dsimp [r_y_loc]; linarith)
    have hr_y_loc_subBr : ∀ u : U_log,
        Metric.ball u.1.1 (r_y_loc u) ⊆ Metric.ball (Br.y₀ : ℂ) Br.r_y :=
      fun u => Set.Subset.trans (hr_y_loc_sub58 u)
        (Metric.ball_subset_ball (by linarith [Br.r_y_pos]))
    have h_loc_ex : ∀ (u : U_log) (ι : Fin 2),
        ∃ (δ_t : ℝ) (Φ : ℂ × ℂ → ℂ),
          0 < δ_t ∧ δ_t ≤ r_y_loc u ∧
          DifferentiableOn ℂ Φ (R'_w u.1.2 ×ˢ Metric.ball u.1.1 δ_t) ∧
          Φ (w_end, u.1.1) = Λ_init ι (u.1.1, w_end) ∧
          ∀ q ∈ R'_w u.1.2 ×ˢ Metric.ball u.1.1 δ_t,
            ∑ m : Fin (Br.D_det ι + 1), Br.A_coeff ι m (E_swap q) * (Φ q) ^ (m : ℕ) = 0 := by
      intro u ι
      have hw_end_in := hw_end_mem_R' u.1.2
      refine (hSep_swap u.1.2 u.1.1 (r_y_loc u) ι (hr_y_loc_pos u) (hr_y_loc_subBr u)).2
        (min u.1.2.re w_end.re - 1) (Real.log (3 * Br.r_t / 4))
        (min u.1.2.im 0 - 1) (max u.1.2.im 0 + 1)
        w_end (Λ_init ι (u.1.1, w_end))
        (by linarith)
        (by linarith [min_le_right u.1.2.re w_end.re, hw_end_re, hlog_t_end_lt])
        hlog_34_lt
        (by linarith)
        (by linarith [min_le_right u.1.2.im 0, le_max_right u.1.2.im 0])
        (by linarith)
        hw_end_in.1 hw_end_in.2.1 hw_end_in.2.2.1 hw_end_in.2.2.2 ?_
      exact hΛ_init_solves ι (u.1.1, w_end)
        ⟨hBall58_sub_Qy' u.2.1, Metric.mem_ball_self (hδ_init_pos ι)⟩
    choose δ_loc Φ_loc hδ_loc_pos hδ_loc_le hΦ_loc_holo hΦ_loc_seed hΦ_loc_solves using h_loc_ex
    have hΦ_eq_Λ : ∀ (u : U_log) (ι : Fin 2),
        ∀ w ∈ R'_w u.1.2 ∩ Metric.ball w_end δ_w1,
          ∀ y ∈ Metric.ball u.1.1 (δ_loc u ι),
            Φ_loc u ι (w, y) = Λ_init ι (y, w) := by
      intro u ι w hw y hy
      let V_ov : Set (ℂ × ℂ) :=
        (R'_w u.1.2 ∩ Metric.ball w_end δ_w1) ×ˢ Metric.ball u.1.1 (δ_loc u ι)
      have hV_open : IsOpen V_ov :=
        ((hRect_open _ _ _ _).inter Metric.isOpen_ball).prod Metric.isOpen_ball
      have hV_preconn : IsPreconnected V_ov :=
        (((hRect_convex _ _ _ _).inter (convex_ball _ _)).prod (convex_ball _ _)).isPreconnected
      have hV_sub_loc : V_ov ⊆ R'_w u.1.2 ×ˢ Metric.ball u.1.1 (δ_loc u ι) :=
        fun q hq => ⟨hq.1.1, hq.2⟩
      have hV_sub_sw : V_ov ⊆ R_w u.1.2 ×ˢ Metric.ball u.1.1 (r_y_loc u) :=
        fun q hq => ⟨hRw_sub u.1.2 hq.1.1, Metric.ball_subset_ball (hδ_loc_le u ι) hq.2⟩
      have hV_maps_init : ∀ q ∈ V_ov,
          (q.2, q.1) ∈ rectOpen a₁' a₂' b₁' b₂' ×ˢ Metric.ball w_end (δ_init ι) :=
        fun q hq => ⟨hBall58_sub_Qy' (hr_y_loc_sub58 u (Metric.ball_subset_ball (hδ_loc_le u ι) hq.2)),
          Metric.ball_subset_ball (hδ_w1_le ι) hq.1.2⟩
      have hswap_diff : Differentiable ℂ (fun q : ℂ × ℂ => (q.2, q.1)) :=
        differentiable_snd.prodMk differentiable_fst
      exact (hSep_swap u.1.2 u.1.1 (r_y_loc u) ι (hr_y_loc_pos u) (hr_y_loc_subBr u)).1
        V_ov (Φ_loc u ι) (fun q => Λ_init ι (q.2, q.1)) (w_end, u.1.1)
        hV_open hV_preconn hV_sub_sw
        ⟨⟨hw_end_mem_R' u.1.2, Metric.mem_ball_self hδ_w1_pos⟩,
          Metric.mem_ball_self (hδ_loc_pos u ι)⟩
        ((hΦ_loc_holo u ι).mono hV_sub_loc)
        ((hΛ_init_holo ι).comp hswap_diff.differentiableOn hV_maps_init)
        (fun q hq => hΦ_loc_solves u ι q (hV_sub_loc hq))
        (fun q hq => hΛ_init_solves ι (q.2, q.1) (hV_maps_init q hq))
        (hΦ_loc_seed u ι) (w, y) ⟨hw, hy⟩
    have hΦ_compat : ∀ (u₁ u₂ : U_log) (ι : Fin 2) (y w : ℂ),
        y ∈ Metric.ball u₁.1.1 (δ_loc u₁ ι) ∩ Metric.ball u₂.1.1 (δ_loc u₂ ι) →
        w ∈ R'_w u₁.1.2 ∩ R'_w u₂.1.2 →
        Φ_loc u₁ ι (w, y) = Φ_loc u₂ ι (w, y) := by
      intro u₁ u₂ ι y w hy hw
      let V₁₂ : Set (ℂ × ℂ) :=
        (R'_w u₁.1.2 ∩ R'_w u₂.1.2) ×ˢ
          (Metric.ball u₁.1.1 (δ_loc u₁ ι) ∩ Metric.ball u₂.1.1 (δ_loc u₂ ι))
      have hV_open : IsOpen V₁₂ :=
        ((hRect_open _ _ _ _).inter (hRect_open _ _ _ _)).prod
          (Metric.isOpen_ball.inter Metric.isOpen_ball)
      have hV_preconn : IsPreconnected V₁₂ :=
        (((hRect_convex _ _ _ _).inter (hRect_convex _ _ _ _)).prod
          ((convex_ball _ _).inter (convex_ball _ _))).isPreconnected
      have hV_sub₁ : V₁₂ ⊆ R'_w u₁.1.2 ×ˢ Metric.ball u₁.1.1 (δ_loc u₁ ι) :=
        fun q hq => ⟨hq.1.1, hq.2.1⟩
      have hV_sub₂ : V₁₂ ⊆ R'_w u₂.1.2 ×ˢ Metric.ball u₂.1.1 (δ_loc u₂ ι) :=
        fun q hq => ⟨hq.1.2, hq.2.2⟩
      have hV_sub_sw : V₁₂ ⊆ R_w u₁.1.2 ×ˢ Metric.ball u₁.1.1 (r_y_loc u₁) :=
        fun q hq => ⟨hRw_sub u₁.1.2 hq.1.1, Metric.ball_subset_ball (hδ_loc_le u₁ ι) hq.2.1⟩
      have h_seed_eq : Φ_loc u₁ ι (w_end, y) = Φ_loc u₂ ι (w_end, y) := by
        rw [hΦ_eq_Λ u₁ ι w_end ⟨hw_end_mem_R' u₁.1.2, Metric.mem_ball_self hδ_w1_pos⟩ y hy.1,
            hΦ_eq_Λ u₂ ι w_end ⟨hw_end_mem_R' u₂.1.2, Metric.mem_ball_self hδ_w1_pos⟩ y hy.2]
      exact (hSep_swap u₁.1.2 u₁.1.1 (r_y_loc u₁) ι (hr_y_loc_pos u₁) (hr_y_loc_subBr u₁)).1
        V₁₂ (Φ_loc u₁ ι) (Φ_loc u₂ ι) (w_end, y)
        hV_open hV_preconn hV_sub_sw
        ⟨⟨hw_end_mem_R' u₁.1.2, hw_end_mem_R' u₂.1.2⟩, hy⟩
        ((hΦ_loc_holo u₁ ι).mono hV_sub₁)
        ((hΦ_loc_holo u₂ ι).mono hV_sub₂)
        (fun q hq => hΦ_loc_solves u₁ ι q (hV_sub₁ hq))
        (fun q hq => hΦ_loc_solves u₂ ι q (hV_sub₂ hq))
        h_seed_eq (w, y) ⟨hw, hy⟩

    let M_log : Fin 2 → ℂ × ℂ → ℂ :=
      fun ι p => @dite ℂ (p ∈ U_log) (Classical.propDecidable _)
        (fun hp => Φ_loc ⟨p, hp⟩ ι (p.2, p.1)) (fun _ => 0)
    have hM_log_def : ∀ (ι : Fin 2) (p : ℂ × ℂ) (hp : p ∈ U_log),
        M_log ι p = Φ_loc ⟨p, hp⟩ ι (p.2, p.1) :=
      fun ι p hp => @dite_eq_left_of_eq_true ℂ (p ∈ U_log) (Classical.propDecidable _)
        (fun h => Φ_loc ⟨p, h⟩ ι (p.2, p.1)) (fun _ => 0) (eq_true hp)
    have hM_log_local : ∀ (u : U_log) (ι : Fin 2),
        ∀ q ∈ Metric.ball u.1.1 (δ_loc u ι) ×ˢ R'_w u.1.2,
          q ∈ U_log ∧ M_log ι q = Φ_loc u ι (q.2, q.1) := by
      intro u ι q hq
      have hq_mem : q ∈ U_log :=
        ⟨hr_y_loc_sub58 u (Metric.ball_subset_ball (hδ_loc_le u ι) hq.1), hq.2.2.1⟩
      refine ⟨hq_mem, ?_⟩
      rw [hM_log_def ι q hq_mem]
      exact hΦ_compat ⟨q, hq_mem⟩ u ι q.1 q.2
        ⟨Metric.mem_ball_self (hδ_loc_pos ⟨q, hq_mem⟩ ι), hq.1⟩
        ⟨hw_self_mem_R' q.2 hq_mem.2, hq.2⟩
    have hM_log_holo : ∀ ι : Fin 2, DifferentiableOn ℂ (M_log ι) U_log := by
      intro ι p hp
      let u : U_log := ⟨p, hp⟩
      let O_u : Set (ℂ × ℂ) := Metric.ball p.1 (δ_loc u ι) ×ˢ R'_w p.2
      have hO_open : IsOpen O_u := Metric.isOpen_ball.prod (hRect_open _ _ _ _)
      have hp_O : p ∈ O_u :=
        ⟨Metric.mem_ball_self (hδ_loc_pos u ι), hw_self_mem_R' p.2 hp.2⟩
      have hswap_diff : Differentiable ℂ (fun q : ℂ × ℂ => (q.2, q.1)) :=
        differentiable_snd.prodMk differentiable_fst
      have hcomp_holo : DifferentiableOn ℂ (fun q : ℂ × ℂ => Φ_loc u ι (q.2, q.1)) O_u := by
        change DifferentiableOn ℂ ((Φ_loc u ι) ∘ (fun q : ℂ × ℂ => (q.2, q.1))) O_u
        exact (hΦ_loc_holo u ι).comp hswap_diff.differentiableOn (fun q hq => ⟨hq.2, hq.1⟩)
      have hcomp_at : DifferentiableAt ℂ (fun q : ℂ × ℂ => Φ_loc u ι (q.2, q.1)) p :=
        hcomp_holo.differentiableAt (hO_open.mem_nhds hp_O)
      exact (hcomp_at.congr_of_eventuallyEq
        (Filter.eventuallyEq_of_mem (hO_open.mem_nhds hp_O)
          (fun q hq => (hM_log_local u ι q hq).2))).differentiableWithinAt
    have hM_log_solves : ∀ ι : Fin 2, ∀ p ∈ U_log,
        ∑ m : Fin (Br.D_det ι + 1),
          Br.A_coeff ι m (p.1, Complex.exp p.2) * (M_log ι p) ^ (m : ℕ) = 0 := by
      intro ι p hp
      rw [hM_log_def ι p hp]
      exact hΦ_loc_solves ⟨p, hp⟩ ι (p.2, p.1)
        ⟨hw_self_mem_R' p.2 hp.2, Metric.mem_ball_self (hδ_loc_pos ⟨p, hp⟩ ι)⟩
    have hM_log_eq_end : ∀ ι : Fin 2, ∀ p ∈ Metric.ball p_log_end r_log_end,
        M_log ι p = Br.M₁_end ι (p.1, Complex.exp p.2) := by
      intro ι p hp
      have hp_U : p ∈ U_log := hB_log_end_sub hp
      rw [hM_log_def ι p hp_U]
      have hp_prod : p ∈ Metric.ball (Br.y₀ : ℂ) r_log_end ×ˢ Metric.ball w_end r_log_end := by
        rwa [ball_prod_same]
      have hw_w1 : p.2 ∈ Metric.ball w_end δ_w1 :=
        Metric.ball_subset_ball hr_log_le_w1 hp_prod.2
      rw [hΦ_eq_Λ ⟨p, hp_U⟩ ι p.2 ⟨hw_self_mem_R' p.2 hp_U.2, hw_w1⟩ p.1
        (Metric.mem_ball_self (hδ_loc_pos ⟨p, hp_U⟩ ι))]
      exact hΛ_eq_end ι p hp

    
    have h_per_ι : ∀ ι : Fin 2, ∃ d_ι : ℕ, 1 ≤ d_ι ∧
        ∀ p ∈ U_log, M_log ι (p.1, p.2 + (d_ι : ℂ) * τ_2pi) = M_log ι p := by
      intro ι
      let D_ι : ℕ := Br.D_det ι
      have hq_end_punc : q_end ∈ U_Br_punc := by
        refine ⟨Metric.mem_ball_self Br.r_y_pos, ⟨?_, Complex.ofReal_ne_zero.mpr Br.t_end_pos.ne'⟩⟩
        rw [Metric.mem_ball, dist_zero_right, Complex.norm_real, Real.norm_eq_abs,
          abs_of_pos Br.t_end_pos]
        linarith [Br.t_end_lt, Br.r_t_pos]
      have hlead_ne : Br.A_coeff ι (Fin.last D_ι) q_end ≠ 0 :=
        (Br.separable_punc ι q_end hq_end_punc).1
      let P₀ : Polynomial ℂ :=
        ∑ m : Fin (D_ι + 1), Polynomial.C (Br.A_coeff ι m q_end) * Polynomial.X ^ (m : ℕ)
      have hP₀_coeff : ∀ k : ℕ, P₀.coeff k =
          ∑ m : Fin (D_ι + 1), if k = (m : ℕ) then Br.A_coeff ι m q_end else 0 := by
        intro k
        dsimp only [P₀]
        rw [Polynomial.finsetSum_coeff]
        refine Finset.sum_congr rfl fun m _ => ?_
        rw [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
        split_ifs <;> ring
      have hP₀_coeff_D : P₀.coeff D_ι = Br.A_coeff ι (Fin.last D_ι) q_end := by
        rw [hP₀_coeff, Finset.sum_eq_single (Fin.last D_ι)]
        · simp
        · intro m _ hm
          have hval : D_ι ≠ (m : ℕ) := fun heq => hm (Fin.ext heq.symm)
          simp [hval]
        · intro hnot; exact False.elim (hnot (Finset.mem_univ _))
      have hP₀_ne : P₀ ≠ 0 := by
        intro h0
        rw [h0, Polynomial.coeff_zero] at hP₀_coeff_D
        exact hlead_ne hP₀_coeff_D.symm
      have hP₀_deg : P₀.natDegree ≤ D_ι := by
        rw [Polynomial.natDegree_le_iff_coeff_eq_zero]
        intro k hk
        rw [hP₀_coeff]
        refine Finset.sum_eq_zero fun m _ => ?_
        have hval : k ≠ (m : ℕ) := by have := m.2; omega
        simp [hval]
      let z_nat : ℕ → ℂ := fun k => M_log ι ((Br.y₀ : ℂ), w_end + (k : ℂ) * τ_2pi)
      have hz_mem_U : ∀ k : ℕ, ((Br.y₀ : ℂ), w_end + (k : ℂ) * τ_2pi) ∈ U_log := by
        intro k
        refine ⟨Metric.mem_ball_self (by positivity [Br.r_y_pos]), ?_⟩
        change (w_end + (k : ℂ) * τ_2pi).re < Real.log (3 * Br.r_t / 4)
        have hre : (w_end + (k : ℂ) * τ_2pi).re = Real.log Br.t_end := by
          simp [w_end, τ_2pi]
        rw [hre]
        exact hlog_t_end_lt
      have hz_maps : Set.MapsTo (fun k : Fin (D_ι + 1) => z_nat k.1)
          (↑(Finset.univ : Finset (Fin (D_ι + 1)))) (↑P₀.roots.toFinset) := by
        intro k _
        rw [Finset.mem_coe, Multiset.mem_toFinset, Polynomial.mem_roots hP₀_ne,
          Polynomial.IsRoot.def]
        dsimp only [P₀]
        rw [Polynomial.eval_finsetSum]
        have h_sol := hM_log_solves ι ((Br.y₀ : ℂ), w_end + (k.1 : ℂ) * τ_2pi) (hz_mem_U k.1)
        have hexp_k : Complex.exp (w_end + (k.1 : ℂ) * τ_2pi) = (Br.t_end : ℂ) := by
          have h1 := hexp_add_int w_end (k.1 : ℤ)
          rw [Int.cast_natCast] at h1
          rw [h1, hexp_w_end]
        rw [hexp_k] at h_sol
        simpa [z_nat] using h_sol
      have hcard_lt : P₀.roots.toFinset.card < (Finset.univ : Finset (Fin (D_ι + 1))).card := by
        have h1 : P₀.roots.toFinset.card ≤ P₀.roots.card := Multiset.toFinset_card_le P₀.roots
        have h2 : P₀.roots.card ≤ P₀.natDegree := Polynomial.card_roots' P₀
        simp only [Finset.card_univ, Fintype.card_fin]
        omega
      obtain ⟨k₁, _, k₂, _, hk_ne, hzk_eq⟩ :=
        Finset.exists_ne_map_eq_of_card_lt_of_maps_to hcard_lt hz_maps
      have hex_ab : ∃ a b : ℕ, a < b ∧ z_nat a = z_nat b := by
        rcases lt_trichotomy k₁.1 k₂.1 with hlt | heq | hgt
        · exact ⟨k₁.1, k₂.1, hlt, hzk_eq⟩
        · exact False.elim (hk_ne (Fin.ext heq))
        · exact ⟨k₂.1, k₁.1, hgt, hzk_eq.symm⟩
      obtain ⟨a, b, hab_lt, hz_ab⟩ := hex_ab
      refine ⟨b - a, by omega, ?_⟩
      intro p hp
      let w₁ : ℂ := p.2 - (a : ℂ) * τ_2pi
      have hw₁_re : w₁.re = p.2.re := by simp [w₁, τ_2pi]
      let V_per : Set (ℂ × ℂ) := R'_w w₁ ×ˢ Metric.ball (Br.y₀ : ℂ) (5 * Br.r_y / 8)
      have hVp_open : IsOpen V_per := (hRect_open _ _ _ _).prod Metric.isOpen_ball
      have hVp_preconn : IsPreconnected V_per :=
        ((hRect_convex _ _ _ _).prod (convex_ball _ _)).isPreconnected
      have hVp_sub : V_per ⊆ R_w w₁ ×ˢ Metric.ball (Br.y₀ : ℂ) Br.r_y :=
        fun q hq => ⟨hRw_sub w₁ hq.1, Metric.ball_subset_ball (by linarith [Br.r_y_pos]) hq.2⟩
      have hshift_holo : ∀ m_sh : ℕ,
          DifferentiableOn ℂ (fun q : ℂ × ℂ => M_log ι (q.2, q.1 + (m_sh : ℂ) * τ_2pi)) V_per ∧
          ∀ q ∈ V_per,
            ∑ m : Fin (Br.D_det ι + 1),
              Br.A_coeff ι m (E_swap q) *
                (M_log ι (q.2, q.1 + (m_sh : ℂ) * τ_2pi)) ^ (m : ℕ) = 0 := by
        intro m_sh
        let sh_map : ℂ × ℂ → ℂ × ℂ := fun q => (q.2, q.1 + (m_sh : ℂ) * τ_2pi)
        have hsh_diff : Differentiable ℂ sh_map :=
          differentiable_snd.prodMk (differentiable_fst.add (differentiable_const _))
        have hsh_maps : Set.MapsTo sh_map V_per U_log := by
          intro q hq
          refine ⟨hq.2, ?_⟩
          change (q.1 + (m_sh : ℂ) * τ_2pi).re < Real.log (3 * Br.r_t / 4)
          have hre : (q.1 + (m_sh : ℂ) * τ_2pi).re = q.1.re := by simp [τ_2pi]
          rw [hre]
          exact hq.1.2.1
        refine ⟨by
          change DifferentiableOn ℂ ((M_log ι) ∘ sh_map) V_per
          exact (hM_log_holo ι).comp hsh_diff.differentiableOn hsh_maps, fun q hq => ?_⟩
        have h_sol := hM_log_solves ι (sh_map q) (hsh_maps hq)
        have hexp_eq : Complex.exp (q.1 + (m_sh : ℂ) * τ_2pi) = Complex.exp q.1 := by
          have h1 := hexp_add_int q.1 (m_sh : ℤ)
          rwa [Int.cast_natCast] at h1
        dsimp only [sh_map, E_swap] at h_sol ⊢
        rwa [hexp_eq] at h_sol
      have h_eq_V :=
        (hSep_swap w₁ (Br.y₀ : ℂ) Br.r_y ι Br.r_y_pos Set.Subset.rfl).1
          V_per
          (fun q => M_log ι (q.2, q.1 + (a : ℂ) * τ_2pi))
          (fun q => M_log ι (q.2, q.1 + (b : ℂ) * τ_2pi))
          (w_end, (Br.y₀ : ℂ))
          hVp_open hVp_preconn hVp_sub
          ⟨hw_end_mem_R' w₁, Metric.mem_ball_self (by positivity [Br.r_y_pos])⟩
          (hshift_holo a).1 (hshift_holo b).1
          (hshift_holo a).2 (hshift_holo b).2
          hz_ab (w₁, p.1)
          ⟨hw_self_mem_R' w₁ (by rw [hw₁_re]; exact hp.2), hp.1⟩
      have hw₁_a : w₁ + (a : ℂ) * τ_2pi = p.2 := by dsimp [w₁]; ring
      have ha_add : a + (b - a) = b := by omega
      have hb_cast : (b : ℂ) = (a : ℂ) + ((b - a : ℕ) : ℂ) := by exact_mod_cast ha_add.symm
      have hw₁_b : w₁ + (b : ℂ) * τ_2pi = p.2 + ((b - a : ℕ) : ℂ) * τ_2pi := by
        rw [hb_cast]; dsimp [w₁]; ring
      rw [hw₁_a, hw₁_b] at h_eq_V
      exact h_eq_V.symm

    choose d_fn hd_fn_pos hd_fn_per using h_per_ι
    have h_nat_mul_per : ∀ (ι : Fin 2) (s : ℕ),
        (∀ p ∈ U_log, M_log ι (p.1, p.2 + (s : ℂ) * τ_2pi) = M_log ι p) →
        ∀ (k : ℕ), ∀ p ∈ U_log,
          M_log ι (p.1, p.2 + (k : ℂ) * ((s : ℂ) * τ_2pi)) = M_log ι p := by
      intro ι s hs k
      induction k with
      | zero =>
        intro p _
        simp
      | succ k ih =>
        intro p hp
        have hp_sh : (p.1, p.2 + (k : ℂ) * ((s : ℂ) * τ_2pi)) ∈ U_log := by
          refine ⟨hp.1, ?_⟩
          change (p.2 + (k : ℂ) * ((s : ℂ) * τ_2pi)).re < Real.log (3 * Br.r_t / 4)
          have hre : (p.2 + (k : ℂ) * ((s : ℂ) * τ_2pi)).re = p.2.re := by simp [τ_2pi]
          rw [hre]; exact hp.2
        have h_assoc : p.2 + ((k + 1 : ℕ) : ℂ) * ((s : ℂ) * τ_2pi) =
            (p.2 + (k : ℂ) * ((s : ℂ) * τ_2pi)) + (s : ℂ) * τ_2pi := by
          push_cast; ring
        rw [h_assoc, hs _ hp_sh, ih p hp]
    let d : ℕ := d_fn 0 * d_fn 1
    have hd_pos : 1 ≤ d := Nat.mul_pos (hd_fn_pos 0) (hd_fn_pos 1)
    have hd_base : ∀ ι : Fin 2, ∀ p ∈ U_log,
        M_log ι (p.1, p.2 + (d : ℂ) * τ_2pi) = M_log ι p := by
      intro ι p hp
      fin_cases ι
      · have h1 := h_nat_mul_per 0 (d_fn 0) (hd_fn_per 0) (d_fn 1) p hp
        have heq : (d_fn 1 : ℂ) * ((d_fn 0 : ℂ) * τ_2pi) = (d : ℂ) * τ_2pi := by
          dsimp [d]; push_cast; ring
        rwa [heq] at h1
      · have h1 := h_nat_mul_per 1 (d_fn 1) (hd_fn_per 1) (d_fn 0) p hp
        have heq : (d_fn 0 : ℂ) * ((d_fn 1 : ℂ) * τ_2pi) = (d : ℂ) * τ_2pi := by
          dsimp [d]; push_cast; ring
        rwa [heq] at h1
    have hM_log_per : ∀ ι : Fin 2, ∀ p ∈ U_log, ∀ n : ℤ,
        M_log ι (p.1, p.2 + (n : ℂ) * ((d : ℂ) * τ_2pi)) = M_log ι p := by
      intro ι p hp n
      rcases Int.eq_nat_or_neg n with ⟨k, rfl | rfl⟩
      · simpa only [Int.cast_natCast] using h_nat_mul_per ι d (hd_base ι) k p hp
      · have hp_neg : (p.1, p.2 - (k : ℂ) * ((d : ℂ) * τ_2pi)) ∈ U_log := by
          refine ⟨hp.1, ?_⟩
          change (p.2 - (k : ℂ) * ((d : ℂ) * τ_2pi)).re < Real.log (3 * Br.r_t / 4)
          have hre : (p.2 - (k : ℂ) * ((d : ℂ) * τ_2pi)).re = p.2.re := by simp [τ_2pi]
          rw [hre]; exact hp.2
        have hpos := h_nat_mul_per ι d (hd_base ι) k
          (p.1, p.2 - (k : ℂ) * ((d : ℂ) * τ_2pi)) hp_neg
        have hsub : (p.2 - (k : ℂ) * ((d : ℂ) * τ_2pi)) + (k : ℂ) * ((d : ℂ) * τ_2pi) = p.2 := by
          ring
        rw [hsub] at hpos
        have hcast : p.2 + ((-(k : ℤ) : ℤ) : ℂ) * ((d : ℂ) * τ_2pi) =
            p.2 - (k : ℂ) * ((d : ℂ) * τ_2pi) := by
          push_cast; ring
        rw [hcast]
        exact hpos.symm
    exact ⟨d, r_log_end, M_log, hd_pos, hr_log_end_pos, hM_log_holo, hM_log_solves,
      hM_log_per, hB_log_end_sub, hexp_maps_end, hM_log_eq_end⟩

  obtain ⟨d, r_log_end, M_log, hd_pos, hr_log_end_pos, hM_log_holo, hM_log_solves,
    hM_log_per, hB_log_end_sub, hexp_maps_end, hM_log_eq_end⟩ := h_s1

  
  
  
  have hd_ne_zero : d ≠ 0 := Nat.ne_of_gt hd_pos
  have hd_pos_R : (0 : ℝ) < (d : ℝ) := Nat.cast_pos.mpr hd_pos
  have hd_ne_R : (d : ℝ) ≠ 0 := ne_of_gt hd_pos_R
  have hd_ne_C : (d : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr hd_ne_zero

  have h_s2 : ∃ (r_yp r_τ : ℝ) (K_p : ℕ) (M_puis N_puis : Fin 2 → ℂ × ℂ → ℂ),
      0 < r_yp ∧ r_yp ≤ Br.r_y / 2 ∧
      0 < r_τ ∧ r_τ ^ d < Br.r_t / 2 ∧
      (∀ ι : Fin 2,
        DifferentiableOn ℂ (M_puis ι)
          (Metric.ball (Br.y₀ : ℂ) r_yp ×ˢ (Metric.ball (0 : ℂ) r_τ \ {0}))) ∧
      (∀ ι : Fin 2,
        DifferentiableOn ℂ (N_puis ι)
          (Metric.ball (Br.y₀ : ℂ) r_yp ×ˢ Metric.ball (0 : ℂ) r_τ)) ∧
      (∀ ι : Fin 2,
        ∀ p ∈ Metric.ball (Br.y₀ : ℂ) r_yp ×ˢ Metric.ball (0 : ℂ) r_τ,
          p.2 ≠ 0 → N_puis ι p = p.2 ^ K_p * M_puis ι p) ∧
      (∀ p ∈ Metric.ball (Br.y₀ : ℂ) r_yp ×ˢ (Metric.ball (0 : ℂ) r_τ \ {0}),
        (p.1, (d : ℂ) * Complex.log p.2) ∈ U_log ∧
        Complex.exp ((d : ℂ) * Complex.log p.2) = p.2 ^ d ∧
        ∀ ι : Fin 2, M_puis ι p = M_log ι (p.1, (d : ℂ) * Complex.log p.2)) ∧
      (∀ p ∈ Metric.ball (Br.y₀ : ℂ) r_yp ×ˢ (Metric.ball (0 : ℂ) r_τ \ {0}),
        ∃ (O_τ : Set ℂ) (ℓ : ℂ → ℂ),
          IsOpen O_τ ∧ p.2 ∈ O_τ ∧ DifferentiableAt ℂ ℓ p.2 ∧
          ∀ y ∈ Metric.ball (Br.y₀ : ℂ) r_yp, ∀ ζ ∈ O_τ,
            (y, ℓ ζ) ∈ U_log ∧
            Complex.exp (ℓ ζ) = ζ ^ d ∧
            ∀ ι : Fin 2, M_puis ι (y, ζ) = M_log ι (y, ℓ ζ)) ∧
      (∀ y ∈ Metric.ball (Br.y₀ : ℂ) r_yp, ∀ w : ℂ,
        w.re < (d : ℝ) * Real.log r_τ →
        (y, w) ∈ U_log ∧
        (y, Complex.exp (w / (d : ℂ))) ∈
          Metric.ball (Br.y₀ : ℂ) r_yp ×ˢ (Metric.ball (0 : ℂ) r_τ \ {0}) ∧
        (Complex.exp (w / (d : ℂ))) ^ d = Complex.exp w ∧
        ∀ ι : Fin 2, M_puis ι (y, Complex.exp (w / (d : ℂ))) = M_log ι (y, w)) := by
    let r_τ_raw : ℝ := (3 * Br.r_t / 4) ^ ((d : ℝ)⁻¹)
    have hr_τ_raw_pos : 0 < r_τ_raw :=
      Real.rpow_pos_of_pos (by linarith [Br.r_t_pos]) _
    have hr_τ_raw_pow : r_τ_raw ^ d = 3 * Br.r_t / 4 := by
      dsimp [r_τ_raw]
      rw [← Real.rpow_natCast, ← Real.rpow_mul (by linarith [Br.r_t_pos]),
        inv_mul_cancel₀ hd_ne_R, Real.rpow_one]
    have hd_log_raw : (d : ℝ) * Real.log r_τ_raw = Real.log (3 * Br.r_t / 4) := by
      rw [← Real.log_pow, hr_τ_raw_pow]
    let r_yp : ℝ := Br.r_y / 2
    have hr_yp_pos : 0 < r_yp := by dsimp [r_yp]; positivity [Br.r_y_pos]
    have hr_yp_le : r_yp ≤ Br.r_y / 2 := le_rfl
    let r_τ : ℝ := r_τ_raw / 2
    have hr_τ_pos : 0 < r_τ := by dsimp [r_τ]; positivity
    have hr_τ_pow_lt : r_τ ^ d < Br.r_t / 2 := by
      have hd_sub : d = (d - 1) + 1 := (Nat.sub_add_cancel hd_pos).symm
      have hhalf_pow : (1 / 2 : ℝ) ^ d ≤ 1 / 2 := by
        rw [hd_sub, pow_succ]
        have h1 : (1 / 2 : ℝ) ^ (d - 1) ≤ 1 := pow_le_one₀ (by norm_num) (by norm_num)
        linarith
      have hpow_eq : r_τ ^ d = r_τ_raw ^ d * (1 / 2 : ℝ) ^ d := by
        dsimp [r_τ]
        rw [div_eq_mul_inv, mul_pow]
        norm_num
      rw [hpow_eq, hr_τ_raw_pow]
      nlinarith [Br.r_t_pos]

    let K_p : ℕ := d * Br.m_t + 1
    let M_puis : Fin 2 → ℂ × ℂ → ℂ :=
      fun ι p => M_log ι (p.1, (d : ℂ) * Complex.log p.2)
    let N_puis : Fin 2 → ℂ × ℂ → ℂ :=
      fun ι p => if p.2 = 0 then 0 else p.2 ^ K_p * M_puis ι p
    let B_puis : Set (ℂ × ℂ) := Metric.ball (Br.y₀ : ℂ) r_yp ×ˢ Metric.ball (0 : ℂ) r_τ
    let B_puis_punc : Set (ℂ × ℂ) :=
      Metric.ball (Br.y₀ : ℂ) r_yp ×ˢ (Metric.ball (0 : ℂ) r_τ \ {0})
    let U_punc_raw : Set (ℂ × ℂ) :=
      Metric.ball (Br.y₀ : ℂ) (5 * Br.r_y / 8) ×ˢ (Metric.ball (0 : ℂ) r_τ_raw \ {0})
    have hU_punc_raw_open : IsOpen U_punc_raw :=
      Metric.isOpen_ball.prod (Metric.isOpen_ball.inter isOpen_compl_singleton)
    have hB_puis_punc_sub_raw : B_puis_punc ⊆ U_punc_raw :=
      Set.prod_mono
        (Metric.ball_subset_ball (by dsimp [r_yp]; linarith [Br.r_y_pos]))
        (fun τ hτ => ⟨Metric.ball_subset_ball (by dsimp [r_τ]; linarith) hτ.1, hτ.2⟩)

    have hN_puis_eq : ∀ ι : Fin 2, ∀ p ∈ B_puis, p.2 ≠ 0 →
        N_puis ι p = p.2 ^ K_p * M_puis ι p := by
      intro ι p _ hp2
      simp [N_puis, hp2]

    have hlog_mem_U_log : ∀ y ζ : ℂ,
        y ∈ Metric.ball (Br.y₀ : ℂ) (5 * Br.r_y / 8) →
        ζ ∈ Metric.ball (0 : ℂ) r_τ_raw \ {0} →
          (y, (d : ℂ) * Complex.log ζ) ∈ U_log ∧
          Complex.exp ((d : ℂ) * Complex.log ζ) = ζ ^ d := by
      intro y ζ hy hζ
      have hζ_norm_lt : ‖ζ‖ < r_τ_raw := by simpa [Metric.mem_ball, dist_zero_right] using hζ.1
      have hζ_norm_pos : 0 < ‖ζ‖ := norm_pos_iff.mpr hζ.2
      refine ⟨⟨hy, ?_⟩, ?_⟩
      · change ((d : ℂ) * Complex.log ζ).re < Real.log (3 * Br.r_t / 4)
        have hre : ((d : ℂ) * Complex.log ζ).re = (d : ℝ) * Real.log ‖ζ‖ := by
          simp [Complex.mul_re, Complex.log_re]
        rw [hre, ← hd_log_raw]
        exact mul_lt_mul_of_pos_left (Real.log_lt_log hζ_norm_pos hζ_norm_lt) hd_pos_R
      · rw [Complex.exp_nat_mul, Complex.exp_log hζ.2]

    have hLocalLift : ∀ (R : ℝ), 0 < R → R ≤ r_τ_raw →
        ∀ τ₀ ∈ Metric.ball (0 : ℂ) R \ {0},
          ∃ (O_τ : Set ℂ) (ℓ : ℂ → ℂ),
            IsOpen O_τ ∧ τ₀ ∈ O_τ ∧ DifferentiableAt ℂ ℓ τ₀ ∧
            ∀ y ∈ Metric.ball (Br.y₀ : ℂ) (5 * Br.r_y / 8), ∀ ζ ∈ O_τ,
              (y, ℓ ζ) ∈ U_log ∧
              Complex.exp (ℓ ζ) = ζ ^ d ∧
              ∀ ι : Fin 2, M_puis ι (y, ζ) = M_log ι (y, ℓ ζ) := by
      intro R _ hR_le τ₀ hτ₀
      rcases Complex.mem_slitPlane_or_neg_mem_slitPlane hτ₀.2 with hslit | hneg_slit
      · refine ⟨Metric.ball (0 : ℂ) R ∩ Complex.slitPlane,
          fun ζ => (d : ℂ) * Complex.log ζ,
          Metric.isOpen_ball.inter Complex.isOpen_slitPlane,
          ⟨hτ₀.1, hslit⟩,
          (Complex.differentiableAt_log hslit).const_mul (d : ℂ), ?_⟩
        intro y hy ζ hζ
        have hζ_raw : ζ ∈ Metric.ball (0 : ℂ) r_τ_raw \ {0} :=
          ⟨Metric.ball_subset_ball hR_le hζ.1, Complex.slitPlane_ne_zero hζ.2⟩
        obtain ⟨h1, h2⟩ := hlog_mem_U_log y ζ hy hζ_raw
        exact ⟨h1, h2, fun _ => rfl⟩
      · refine ⟨Metric.ball (0 : ℂ) R ∩ (fun ζ : ℂ => -ζ) ⁻¹' Complex.slitPlane,
          fun ζ => (d : ℂ) * (Complex.log (-ζ) + (Real.pi : ℂ) * Complex.I),
          Metric.isOpen_ball.inter (Complex.isOpen_slitPlane.preimage continuous_neg),
          ⟨hτ₀.1, hneg_slit⟩,
          (((Complex.differentiableAt_log hneg_slit).comp τ₀ differentiableAt_id.neg).add
            (differentiableAt_const _)).const_mul (d : ℂ), ?_⟩
        intro y hy ζ hζ
        have hneg_ne : -ζ ≠ 0 := Complex.slitPlane_ne_zero hζ.2
        have hζ_ne : ζ ≠ 0 := neg_ne_zero.mp hneg_ne
        have hζ_norm_lt : ‖ζ‖ < r_τ_raw :=
          by simpa [Metric.mem_ball, dist_zero_right] using Metric.ball_subset_ball hR_le hζ.1
        have hζ_norm_pos : 0 < ‖ζ‖ := norm_pos_iff.mpr hζ_ne
        have hℓ_U : (y, (d : ℂ) * (Complex.log (-ζ) + (Real.pi : ℂ) * Complex.I)) ∈ U_log := by
          refine ⟨hy, ?_⟩
          change ((d : ℂ) * (Complex.log (-ζ) + (Real.pi : ℂ) * Complex.I)).re <
            Real.log (3 * Br.r_t / 4)
          have hre : ((d : ℂ) * (Complex.log (-ζ) + (Real.pi : ℂ) * Complex.I)).re =
              (d : ℝ) * Real.log ‖ζ‖ := by
            simp [Complex.mul_re, Complex.add_re, Complex.log_re]
          rw [hre, ← hd_log_raw]
          exact mul_lt_mul_of_pos_left (Real.log_lt_log hζ_norm_pos hζ_norm_lt) hd_pos_R
        have hexp_one : Complex.exp (Complex.log (-ζ) + (Real.pi : ℂ) * Complex.I) = ζ := by
          rw [Complex.exp_add, Complex.exp_log hneg_ne, Complex.exp_pi_mul_I]
          ring
        have hexp_d : Complex.exp ((d : ℂ) * (Complex.log (-ζ) + (Real.pi : ℂ) * Complex.I)) =
            ζ ^ d := by
          rw [Complex.exp_nat_mul, hexp_one]
        have hexp_eq_log :
            Complex.exp (Complex.log ζ) =
              Complex.exp (Complex.log (-ζ) + (Real.pi : ℂ) * Complex.I) := by
          rw [Complex.exp_log hζ_ne, hexp_one]
        obtain ⟨n, hn⟩ := Complex.exp_eq_exp_iff_exists_int.mp hexp_eq_log
        refine ⟨hℓ_U, hexp_d, fun ι => ?_⟩
        dsimp only [M_puis]
        have hmul : (d : ℂ) * Complex.log ζ =
            (d : ℂ) * (Complex.log (-ζ) + (Real.pi : ℂ) * Complex.I) +
              (n : ℂ) * ((d : ℂ) * τ_2pi) := by
          rw [hn]
          dsimp [τ_2pi]
          ring
        rw [hmul]
        exact hM_log_per ι _ hℓ_U n

    have hM_puis_raw_holo : ∀ ι : Fin 2, DifferentiableOn ℂ (M_puis ι) U_punc_raw := by
      intro ι q₀ hq₀
      obtain ⟨O_τ, ℓ, hO_open, hq₀_O, hℓ_diff, hℓ_props⟩ :=
        hLocalLift r_τ_raw hr_τ_raw_pos le_rfl q₀.2 hq₀.2
      let O_2d : Set (ℂ × ℂ) := Metric.ball (Br.y₀ : ℂ) (5 * Br.r_y / 8) ×ˢ O_τ
      have hO2_open : IsOpen O_2d := Metric.isOpen_ball.prod hO_open
      have hq₀_O2 : q₀ ∈ O_2d := ⟨hq₀.1, hq₀_O⟩
      have hmap_diff : DifferentiableAt ℂ (fun q : ℂ × ℂ => (q.1, ℓ q.2)) q₀ :=
        differentiableAt_fst.prodMk (hℓ_diff.comp q₀ differentiableAt_snd)
      have hcomp_diff : DifferentiableAt ℂ (fun q : ℂ × ℂ => M_log ι (q.1, ℓ q.2)) q₀ :=
        ((hM_log_holo ι).differentiableAt
          (hU_log_open.mem_nhds (hℓ_props q₀.1 hq₀.1 q₀.2 hq₀_O).1)).comp q₀ hmap_diff
      exact (hcomp_diff.congr_of_eventuallyEq
        (Filter.eventuallyEq_of_mem (hO2_open.mem_nhds hq₀_O2)
          (fun q hq => (hℓ_props q.1 hq.1 q.2 hq.2).2.2 ι))).differentiableWithinAt

    have hM_puis_holo : ∀ ι : Fin 2, DifferentiableOn ℂ (M_puis ι) B_puis_punc :=
      fun ι => (hM_puis_raw_holo ι).mono hB_puis_punc_sub_raw

    have hpullback_exp_div_d :
        ∀ y ∈ Metric.ball (Br.y₀ : ℂ) r_yp, ∀ w : ℂ,
          w.re < (d : ℝ) * Real.log r_τ →
          (y, w) ∈ U_log ∧
          (y, Complex.exp (w / (d : ℂ))) ∈ B_puis_punc ∧
          (Complex.exp (w / (d : ℂ))) ^ d = Complex.exp w ∧
          ∀ ι : Fin 2, M_puis ι (y, Complex.exp (w / (d : ℂ))) = M_log ι (y, w) := by
      intro y hy w hw
      have hy_58 : y ∈ Metric.ball (Br.y₀ : ℂ) (5 * Br.r_y / 8) :=
