        ‖sliceAngleSeq S P.N k.val y‖ +
          Real.log (1 + ‖slicePosSeq S P.N k.val y‖) +
          |Real.log ‖Complex.sin (P.d0 k y)‖| +
          |Real.log ‖P.ℓ_slice k y‖|) (Finset.mem_univ j)) hGeom
    have h1 : 0 ≤ ‖sliceAngleSeq S P.N j.val y‖ := norm_nonneg _
    have h2 : 0 ≤ Real.log (1 + ‖slicePosSeq S P.N j.val y‖) :=
