    let γ : ℝ → ℝ → ℂ := fun x₀ θ =>
      ((x₀ + ρ * Real.cos θ : ℝ) : ℂ) + ((y₀ + ρ * Real.sin θ : ℝ) : ℂ) * Complex.I
    have hγ_mem : ∀ x₀ θ : ℝ, γ x₀ θ ∈ horizStrip S.H := by
      intro x₀ θ
      change |(γ x₀ θ).im| < S.H
      rw [him_rect]
      have hsin : |ρ * Real.sin θ| ≤ ρ := by
        rw [abs_mul, abs_of_pos hρ_pos]
        exact mul_le_of_le_one_right hρ_pos.le (Real.abs_sin_le_one θ)
      calc |y₀ + ρ * Real.sin θ| ≤ |y₀| + |ρ * Real.sin θ| := abs_add_le _ _
