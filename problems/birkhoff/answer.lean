        exact Real.abs_sin_le_one θ)
  have h_int_sin : (∫ θ, Real.sin θ ∂unifTwoPiMeasure) = 0 := by
    rw [h_unif_interval, integral_sin, Real.cos_zero, Real.cos_two_pi, sub_self, mul_zero]
  have h_sin_sq_int : MeasureTheory.Integrable (fun θ : ℝ => Real.sin θ ^ 2) unifTwoPiMeasure :=
    MeasureTheory.Integrable.of_bound
      (Real.continuous_sin.pow 2).measurable.aestronglyMeasurable 1
