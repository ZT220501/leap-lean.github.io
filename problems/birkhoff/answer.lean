      have hp₂_in_Z : p₂ ∈ Z_set := ⟨hp₂Ω, B_cr.eqOn_zero_of_preconnected_2D Metric.isOpen_ball
        (convex_ball _ _).isPreconnected Metric.isOpen_ball ⟨q₁, Metric.mem_ball_self hδ'_pos⟩
        (fun q hq => (hδ'_sub q hq).1.2) (h_cleared_holo M R P p₂ hp₂Ω) h_p₂_zero_sub⟩
