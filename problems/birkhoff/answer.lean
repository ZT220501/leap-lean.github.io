            have h1 : t + 1 ≤ 2 * ((m.1 : ℝ) + 1) / (N : ℝ) := by linarith
            have h2 : (t + 1) * (N : ℝ) ≤ 2 * ((m.1 : ℝ) + 1) := (le_div_iff₀ hN_pos_real).mp h1
