      Real.sqrt_mul (sq_nonneg Δ), Real.sqrt_sq hΔ.le]
  have h_bound_ζ := hq_t_bound ζ hζ_mem
  have hf_t_eq : (∫ w in Metric.ball (0 : ℂ) 1, (K - Real.log ‖f_t w‖)) =
      ∫ w in Metric.ball (0 : ℂ) 1, (K - Real.log ‖f (z₀ + (Δ : ℂ) * w)‖) := by
    simp [f_t, φ_z]
  have h_ratio_eq : (Real.pi * Δ ^ 2)⁻¹ * (∫ w in Metric.ball z₀ Δ, (K - Real.log ‖f w‖)) =
      Real.pi⁻¹ * ∫ w in Metric.ball (0 : ℂ) 1, (K - Real.log ‖f_t w‖) := by
    rw [hf_dst_val, hf_t_eq]
    field_simp [Real.pi_ne_zero, hΔ.ne']
  rwa [hq_ζ_sqrt, ← h_ratio_eq] at h_bound_ζ

theorem periodic_strip_q_from_f_bound (hUniv : UniversalDiskLogDeficitProp)
    (U : Set ℂ) (s_star : ℝ) (f q : ℂ → ℂ)
    (hPer : PeriodicShapeField U s_star f q) :
    ∃ C_strip : ℝ, 0 < C_strip ∧
      ∀ (z₀ : ℂ) (Δ K : ℝ), 0 < Δ →
        Metric.closedBall z₀ Δ ⊆ U →
        (∀ x : ℝ, ∀ y ∈ Set.Icc (z₀.im - Δ) (z₀.im + Δ),
          ‖f ((x : ℂ) + (y : ℂ) * Complex.I)‖ ≤ Real.exp K) →
        Real.sqrt ‖q z₀‖ ≤ C_strip * Δ⁻¹ * (1 + Δ⁻¹) * (1 + max K 0) :=
by
  
  have h_s1 : ∀ (Y ε y : ℝ), 0 < Y → horizStrip Y ⊆ U → 0 < ε → |y| < Y →
      (∫ x in (0 : ℝ)..(2 * Real.pi), (1 / 2 : ℝ) * Real.log (‖f (x : ℂ)‖ ^ 2 + ε ^ 2)) ≤
      (∫ x in (0 : ℝ)..(2 * Real.pi),
        (1 / 2 : ℝ) * Real.log (‖f ((x : ℂ) + (y : ℂ) * Complex.I)‖ ^ 2 + ε ^ 2)) := by
    intro Y ε y hY hStrip hε hy
    have h_open : IsOpen (horizStrip Y) :=
      isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const
    have hf_strip : DifferentiableOn ℂ f (horizStrip Y) := hPer.f_holo.mono hStrip
    have hf1_strip : DifferentiableOn ℂ (deriv f) (horizStrip Y) := hf_strip.deriv h_open
    have hf2_strip : DifferentiableOn ℂ (deriv (deriv f)) (horizStrip Y) := hf1_strip.deriv h_open
    let Φ : ℝ → ℝ → ℂ := fun x t => (x : ℂ) + (t : ℂ) * Complex.I
    have hΦ_im : ∀ x t : ℝ, (Φ x t).im = t := by
      intro x t
      simp [Φ]
    have hΦ_mem : ∀ x t : ℝ, |t| < Y → Φ x t ∈ horizStrip Y := by
      intro x t ht
      change |(Φ x t).im| < Y
      rwa [hΦ_im]
    let U2 : Set (ℝ × ℝ) := { p : ℝ × ℝ | |p.2| < Y }
    have h_jet : ∃ (u u_x u_xx u_y u_yy : ℝ → ℝ → ℝ),
        (∀ x t : ℝ, u x t = (1 / 2 : ℝ) * Real.log (‖f (Φ x t)‖ ^ 2 + ε ^ 2)) ∧
        (∀ x t : ℝ, |t| < Y →
          HasDerivAt (fun x' => u x' t) (u_x x t) x ∧
          HasDerivAt (fun x' => u_x x' t) (u_xx x t) x) ∧
        (∀ x t : ℝ, |t| < Y →
          HasDerivAt (fun t' => u x t') (u_y x t) t ∧
          HasDerivAt (fun t' => u_y x t') (u_yy x t) t) ∧
        (∀ x t : ℝ, 0 ≤ u_xx x t + u_yy x t) ∧
        ContinuousOn (fun p : ℝ × ℝ => u p.1 p.2) U2 ∧
        ContinuousOn (fun p : ℝ × ℝ => u_xx p.1 p.2) U2 ∧
        ContinuousOn (fun p : ℝ × ℝ => u_y p.1 p.2) U2 ∧
        ContinuousOn (fun p : ℝ × ℝ => u_yy p.1 p.2) U2 := by
      obtain ⟨z, hz_eq⟩ : ∃ z : ℝ → ℝ → ℂ, ∀ x t, z x t = f (Φ x t) :=
        ⟨fun x t => f (Φ x t), fun _ _ => rfl⟩
      obtain ⟨w, hw_eq⟩ : ∃ w : ℝ → ℝ → ℂ, ∀ x t, w x t = deriv f (Φ x t) :=
        ⟨fun x t => deriv f (Φ x t), fun _ _ => rfl⟩
      obtain ⟨v, hv_eq⟩ : ∃ v : ℝ → ℝ → ℂ, ∀ x t, v x t = deriv (deriv f) (Φ x t) :=
        ⟨fun x t => deriv (deriv f) (Φ x t), fun _ _ => rfl⟩
      let S : ℝ → ℝ → ℝ := fun x t => (z x t).re ^ 2 + (z x t).im ^ 2 + ε ^ 2
      let u : ℝ → ℝ → ℝ := fun x t => (1 / 2 : ℝ) * Real.log (S x t)
      let S_x : ℝ → ℝ → ℝ := fun x t => 2 * ((z x t).re * (w x t).re + (z x t).im * (w x t).im)
      let S_xx : ℝ → ℝ → ℝ := fun x t =>
        2 * ((w x t).re ^ 2 + (w x t).im ^ 2 + (z x t).re * (v x t).re + (z x t).im * (v x t).im)
      let S_y : ℝ → ℝ → ℝ := fun x t => 2 * (-(z x t).re * (w x t).im + (z x t).im * (w x t).re)
      let S_yy : ℝ → ℝ → ℝ := fun x t =>
        2 * ((w x t).im ^ 2 + (w x t).re ^ 2 - (z x t).re * (v x t).re - (z x t).im * (v x t).im)
      let u_x : ℝ → ℝ → ℝ := fun x t => S_x x t / (2 * S x t)
      let u_xx : ℝ → ℝ → ℝ := fun x t => (S_xx x t * S x t - (S_x x t) ^ 2) / (2 * (S x t) ^ 2)
      let u_y : ℝ → ℝ → ℝ := fun x t => S_y x t / (2 * S x t)
      let u_yy : ℝ → ℝ → ℝ := fun x t => (S_yy x t * S x t - (S_y x t) ^ 2) / (2 * (S x t) ^ 2)
      have hS_eq : ∀ x t : ℝ, S x t = ‖f (Φ x t)‖ ^ 2 + ε ^ 2 := by
        intro x t
        have hsq : ‖f (Φ x t)‖ ^ 2 = (f (Φ x t)).re ^ 2 + (f (Φ x t)).im ^ 2 := by
          rw [Complex.sq_norm, Complex.normSq_apply]
          ring
        dsimp [S]
        rw [hz_eq]
        linarith
      have hS_pos : ∀ x t : ℝ, 0 < S x t := by
        intro x t
        dsimp [S]
        positivity
      have hΦ_dx : ∀ x t : ℝ, HasDerivAt (fun x' : ℝ => Φ x' t) 1 x := by
        intro x t
        simpa [Φ] using (Complex.ofRealCLM.hasDerivAt (x := x)).add_const ((t : ℂ) * Complex.I)
      have hΦ_dt : ∀ x t : ℝ, HasDerivAt (fun t' : ℝ => Φ x t') Complex.I t := by
        intro x t
        simpa [Φ] using
          ((Complex.ofRealCLM.hasDerivAt (x := t)).mul_const Complex.I).const_add (x : ℂ)
      have hz_dx : ∀ x t : ℝ, |t| < Y → HasDerivAt (fun x' => z x' t) (w x t) x := by
        intro x t ht
        have hf_at : HasDerivAt f (w x t) (Φ x t) := by
          rw [hw_eq]
          exact (hf_strip.differentiableAt (h_open.mem_nhds (hΦ_mem x t ht))).hasDerivAt
        have h1 := hf_at.scomp x (hΦ_dx x t)
        rw [one_smul] at h1
        have hfn : (f ∘ fun x' => Φ x' t) = fun x' => z x' t := by
          funext x'
          exact (hz_eq x' t).symm
        rwa [hfn] at h1
      have hw_dx : ∀ x t : ℝ, |t| < Y → HasDerivAt (fun x' => w x' t) (v x t) x := by
        intro x t ht
        have hf1_at : HasDerivAt (deriv f) (v x t) (Φ x t) := by
          rw [hv_eq]
          exact (hf1_strip.differentiableAt (h_open.mem_nhds (hΦ_mem x t ht))).hasDerivAt
        have h1 := hf1_at.scomp x (hΦ_dx x t)
        rw [one_smul] at h1
        have hfn : (deriv f ∘ fun x' => Φ x' t) = fun x' => w x' t := by
          funext x'
          exact (hw_eq x' t).symm
        rwa [hfn] at h1
      have hz_dt : ∀ x t : ℝ, |t| < Y → HasDerivAt (fun t' => z x t') (Complex.I * w x t) t := by
        intro x t ht
        have hf_at : HasDerivAt f (w x t) (Φ x t) := by
          rw [hw_eq]
          exact (hf_strip.differentiableAt (h_open.mem_nhds (hΦ_mem x t ht))).hasDerivAt
        have h1 := hf_at.scomp t (hΦ_dt x t)
        rw [smul_eq_mul] at h1
        have hfn : (f ∘ fun t' => Φ x t') = fun t' => z x t' := by
          funext t'
          exact (hz_eq x t').symm
        rwa [hfn] at h1
      have hw_dt : ∀ x t : ℝ, |t| < Y → HasDerivAt (fun t' => w x t') (Complex.I * v x t) t := by
        intro x t ht
        have hf1_at : HasDerivAt (deriv f) (v x t) (Φ x t) := by
          rw [hv_eq]
          exact (hf1_strip.differentiableAt (h_open.mem_nhds (hΦ_mem x t ht))).hasDerivAt
        have h1 := hf1_at.scomp t (hΦ_dt x t)
        rw [smul_eq_mul] at h1
        have hfn : (deriv f ∘ fun t' => Φ x t') = fun t' => w x t' := by
          funext t'
          exact (hw_eq x t').symm
        rwa [hfn] at h1
      have hu_dx_both : ∀ x t : ℝ, |t| < Y →
          HasDerivAt (fun x' => u x' t) (u_x x t) x ∧
          HasDerivAt (fun x' => u_x x' t) (u_xx x t) x := by
        intro x t ht
        have hz_re : HasDerivAt (fun x' => (z x' t).re) (w x t).re x :=
          Complex.reCLM.hasFDerivAt.comp_hasDerivAt x (hz_dx x t ht)
        have hz_im : HasDerivAt (fun x' => (z x' t).im) (w x t).im x :=
          Complex.imCLM.hasFDerivAt.comp_hasDerivAt x (hz_dx x t ht)
        have hw_re : HasDerivAt (fun x' => (w x' t).re) (v x t).re x :=
          Complex.reCLM.hasFDerivAt.comp_hasDerivAt x (hw_dx x t ht)
        have hw_im : HasDerivAt (fun x' => (w x' t).im) (v x t).im x :=
          Complex.imCLM.hasFDerivAt.comp_hasDerivAt x (hw_dx x t ht)
        have hS_d : HasDerivAt (fun x' => S x' t) (S_x x t) x := by
          convert ((hz_re.pow 2).add (hz_im.pow 2)).add_const (ε ^ 2) using 1
          dsimp [S_x]
          ring
        have hSx_d : HasDerivAt (fun x' => S_x x' t) (S_xx x t) x := by
          convert (((hz_re.mul hw_re).add (hz_im.mul hw_im)).const_mul 2) using 1
          dsimp [S_xx]
          ring
        have hu_d : HasDerivAt (fun x' => u x' t) (u_x x t) x := by
          convert ((hS_d.log (hS_pos x t).ne').const_mul (1 / 2 : ℝ)) using 1
          dsimp [u_x]
          ring
        have hux_d : HasDerivAt (fun x' => u_x x' t) (u_xx x t) x := by
          have h2S_ne : 2 * S x t ≠ 0 := by linarith [hS_pos x t]
          convert hSx_d.div (hS_d.const_mul 2) h2S_ne using 1
