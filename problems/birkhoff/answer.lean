            Complex.I))) := by
        have hc : Continuous (fun p : ℝ × ℝ =>
            (p.2 : ℂ) + ((h_seq j + (3 / 2 : ℝ) * (((R : ℝ) + 1) * ℓ_seq j) * Real.sin p.1 : ℝ) : ℂ) *
              Complex.I) := by fun_prop
        have hm : ∀ p : ℝ × ℝ,
            (p.2 : ℂ) + ((h_seq j + (3 / 2 : ℝ) * (((R : ℝ) + 1) * ℓ_seq j) * Real.sin p.1 : ℝ) : ℂ) *
              Complex.I ∈ horizStrip S.H := by
          intro p
          change |((p.2 : ℂ) + ((h_seq j + (3 / 2 : ℝ) * (((R : ℝ) + 1) * ℓ_seq j) * Real.sin p.1 : ℝ) : ℂ) *
            Complex.I).im| < S.H
          rw [him_rect]
