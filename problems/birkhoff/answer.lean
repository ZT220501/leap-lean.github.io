      intro i
      refine (hδ_Ioo_ev.and ((hΔx₀_re_ev i).and (hm₀_ball_ev i))).mono
        fun δ ⟨hδ_mem, ⟨hdx_re, hdx_ne⟩, hm_b⟩ => ?_
