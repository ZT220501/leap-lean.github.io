              webDiffCoeff (pderivA (ψ i)) (pderivD (ψ i)) (w i) α β k p *
                pderivD (ψ i) p) p₁ * F (k + 1)) := by
        rw [← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl fun k _ => ?_
        rw [(hKit.mvDeriv_rules.1 _ _).2.2.2,
          (hKit.mvDeriv_rules.2 hU_inter hp₁ (hC_holo i α β k)).2,
          (hchain i hp₁.1 g k).2, ← mul_assoc,
          ← ((hKit.taylor2D_algebra hU_inter hp₁).2 (hC_holo i α β k) (hBψ_inter i)).2.2]
      rw [hlhs]
      have hidx : α + (β + 1) + 1 = (α + β + 1) + 1 := by omega
      rw [hidx]
      symm
      calc
        ∑ k ∈ Finset.range ((α + β + 1) + 1),
            taylor2D (webDiffCoeff (pderivA (ψ i)) (pderivD (ψ i)) (w i) α (β + 1) k) p₁ * F k
            = (∑ k ∈ Finset.range (α + β + 1),
                taylor2D (webDiffCoeff (pderivA (ψ i)) (pderivD (ψ i)) (w i) α (β + 1) (k + 1)) p₁ *
                  F (k + 1)) +
              taylor2D (webDiffCoeff (pderivA (ψ i)) (pderivD (ψ i)) (w i) α (β + 1) 0) p₁ * F 0 :=
              Finset.sum_range_succ' _ (α + β + 1)
        _ = (∑ k ∈ Finset.range (α + β + 1),
                (taylor2D (pderivD (webDiffCoeff (pderivA (ψ i)) (pderivD (ψ i)) (w i) α β
                    (k + 1))) p₁ * F (k + 1) +
                  taylor2D (fun p =>
                    webDiffCoeff (pderivA (ψ i)) (pderivD (ψ i)) (w i) α β k p *
                      pderivD (ψ i) p) p₁ * F (k + 1))) +
              taylor2D (pderivD (webDiffCoeff (pderivA (ψ i)) (pderivD (ψ i)) (w i) α β 0)) p₁ *
                F 0 := by
              congr 1
              refine Finset.sum_congr rfl fun k _ => ?_
              have hmul_holo : DifferentiableOn ℂ
                  (fun p =>
                    webDiffCoeff (pderivA (ψ i)) (pderivD (ψ i)) (w i) α β k p *
                      pderivD (ψ i) p) U_inter :=
                (hC_holo i α β k).mul (hBψ_inter i)
              have hadd := ((hKit.taylor2D_algebra hU_inter hp₁).2
                ((hKit.pderiv_holo hU_inter (hC_holo i α β (k + 1))).2) hmul_holo).1
              change taylor2D (fun p =>
                  pderivD (webDiffCoeff (pderivA (ψ i)) (pderivD (ψ i)) (w i) α β (k + 1)) p +
                    webDiffCoeff (pderivA (ψ i)) (pderivD (ψ i)) (w i) α β k p *
                      pderivD (ψ i) p) p₁ * F (k + 1) = _
              rw [hadd, add_mul]
        _ = ((∑ k ∈ Finset.range (α + β + 1),
                taylor2D (pderivD (webDiffCoeff (pderivA (ψ i)) (pderivD (ψ i)) (w i) α β
                  (k + 1))) p₁ * F (k + 1)) +
              taylor2D (pderivD (webDiffCoeff (pderivA (ψ i)) (pderivD (ψ i)) (w i) α β 0)) p₁ *
                F 0) +
            (∑ k ∈ Finset.range (α + β + 1),
              taylor2D (fun p =>
                webDiffCoeff (pderivA (ψ i)) (pderivD (ψ i)) (w i) α β k p *
                  pderivD (ψ i) p) p₁ * F (k + 1)) := by
              rw [Finset.sum_add_distrib]
              abel
        _ = (∑ k ∈ Finset.range ((α + β + 1) + 1),
              taylor2D (pderivD (webDiffCoeff (pderivA (ψ i)) (pderivD (ψ i)) (w i) α β k)) p₁ *
                F k) +
            (∑ k ∈ Finset.range (α + β + 1),
              taylor2D (fun p =>
                webDiffCoeff (pderivA (ψ i)) (pderivD (ψ i)) (w i) α β k p *
                  pderivD (ψ i) p) p₁ * F (k + 1)) := by
              rw [← Finset.sum_range_succ'
                (fun k =>
                  taylor2D (pderivD (webDiffCoeff (pderivA (ψ i)) (pderivD (ψ i)) (w i) α β k)) p₁ *
                    F k)
                (α + β + 1)]
        _ = (∑ k ∈ Finset.range (α + β + 1),
