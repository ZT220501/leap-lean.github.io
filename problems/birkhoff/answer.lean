    let W_poly : List ℂ → Polynomial ℂ :=
      fun L => (L.map (fun α => Polynomial.X - Polynomial.C α)).prod
    let R_poly : List ℂ → Polynomial ℂ :=
      fun L => (L.map (fun α => 1 - Polynomial.C α * Polynomial.X)).prod
    have hW_monic_deg : ∀ L : List ℂ, (W_poly L).Monic ∧ (W_poly L).natDegree = L.length := by
      intro L
      induction L with
