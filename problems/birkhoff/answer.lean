      MvPowerSeries.coeff 0 S ≠ 0 → lineCoreCoeffsIn L S := by
    intro L S T hS2 hT hs0_mem hs0_ne
    rw [sq] at hS2
    have h2s0_mem : 2 * MvPowerSeries.coeff 0 S ∈ L := by
      simpa using L.mul_mem (h_nat_mem L 2) hs0_mem
    have h2s0_ne : 2 * MvPowerSeries.coeff 0 S ≠ 0 := mul_ne_zero two_ne_zero hs0_ne
    have h_ind : ∀ N : ℕ, ∀ d : Fin 2 →₀ ℕ, d 0 + d 1 = N → MvPowerSeries.coeff d S ∈ L := by
      intro N
      induction N using Nat.strong_induction_on with
      | h N ih =>
        intro d hd
        by_cases hN0 : N = 0
        · have hd0 : d = 0 := (h_eq_zero_iff d).mpr (by omega)
          rw [hd0]
          exact hs0_mem
        · have hd_ne : d ≠ 0 := fun h => hN0 (by rw [← hd, (h_eq_zero_iff d).mp h])
          have h_cd : MvPowerSeries.coeff d (S * S) = MvPowerSeries.coeff d T := by rw [hS2]
          have hd0_mem : (d, (0 : Fin 2 →₀ ℕ)) ∈ Finset.HasAntidiagonal.antidiagonal d :=
            Finset.HasAntidiagonal.mem_antidiagonal.mpr (add_zero d)
