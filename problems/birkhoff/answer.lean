      have hf_holo : ∀ i : Fin 2, DifferentiableOn ℂ (f₀ i) B' ∧ DifferentiableOn ℂ (f₁ i) B' := by
        intro i
        constructor
        · exact (((h_num_den_holo p₁ hp₁ (0, i)).1.mono hB'_sub₁).mul
            (((h_num_den_holo p₁ hp₁ (0, i)).2.mono hB'_sub₁).inv (h_den1_nz (0, i))))
        · exact (((h_num_den_holo p₁ hp₁ (1, i)).1.mono hB'_sub₁).mul
            (((h_num_den_holo p₁ hp₁ (1, i)).2.mono hB'_sub₁).inv (h_den1_nz (1, i))))
      have h_rel₁ : ∀ ci : Fin 2 × Fin 2, ∀ q ∈ B',
          ssbpcPairNum E₀ E₁ p₁ q ci =
            (if ci.1 = 0 then f₀ ci.2 q else f₁ ci.2 q) * ssbpcPairDen E₀ E₁ p₁ q ci := by
        intro ⟨c, i⟩ q hq
        have hnz := h_den1_nz (c, i) q hq
        fin_cases c <;> dsimp [ssbpcPairNum, ssbpcPairDen, f₀, f₁] at hnz ⊢ <;>
          exact (inv_mul_cancel_right₀ hnz _).symm
      have h_rel₂ : ∀ ci : Fin 2 × Fin 2, ∀ q ∈ B',
          ssbpcPairNum E₀ E₁ p₂ q ci =
            (if ci.1 = 0 then f₀ ci.2 q else f₁ ci.2 q) * ssbpcPairDen E₀ E₁ p₂ q ci := by
        intro ⟨c, i⟩ q hq
        have hnz := h_den1_nz (c, i) q hq
        have hq₁_b := Metric.ball_subset_ball (h_ci_rad_le p₁ (c, i)) (hB'_sub₁ hq)
        have hq₂_b := Metric.ball_subset_ball (h_ci_rad_le p₂ (c, i)) (hB'_sub₂ hq)
        fin_cases c
        · dsimp [ssbpcPairNum, ssbpcPairDen, f₀] at hnz hq₁_b hq₂_b ⊢
          have hc_eq := (E₀ i).compat p₁ hp₁ p₂ hp₂ q ⟨hq₁_b, hq₂_b⟩
          calc (E₀ i).num p₂ q
              = ((E₀ i).num p₂ q * (E₀ i).den p₁ q) * ((E₀ i).den p₁ q)⁻¹ :=
                (mul_inv_cancel_right₀ hnz _).symm
            _ = ((E₀ i).num p₁ q * (E₀ i).den p₂ q) * ((E₀ i).den p₁ q)⁻¹ := by rw [← hc_eq]
            _ = (E₀ i).num p₁ q * ((E₀ i).den p₁ q)⁻¹ * (E₀ i).den p₂ q := by ring
        · dsimp [ssbpcPairNum, ssbpcPairDen, f₁] at hnz hq₁_b hq₂_b ⊢
          have hc_eq := (E₁ i).compat p₁ hp₁ p₂ hp₂ q ⟨hq₁_b, hq₂_b⟩
          calc (E₁ i).num p₂ q
              = ((E₁ i).num p₂ q * (E₁ i).den p₁ q) * ((E₁ i).den p₁ q)⁻¹ :=
                (mul_inv_cancel_right₀ hnz _).symm
            _ = ((E₁ i).num p₁ q * (E₁ i).den p₂ q) * ((E₁ i).den p₁ q)⁻¹ := by rw [← hc_eq]
            _ = (E₁ i).num p₁ q * ((E₁ i).den p₁ q)⁻¹ * (E₁ i).den p₂ q := by ring
      let diff_fn : ℂ × ℂ → ℂ := fun q =>
        ssbpcClearedPoly M R P E₀ E₁ A p₁ q * ((ssbpcPairDenProd E₀ E₁ p₂ q) ^ (2 * M + 1)) ^ R -
        ssbpcClearedPoly M R P E₀ E₁ A p₂ q * ((ssbpcPairDenProd E₀ E₁ p₁ q) ^ (2 * M + 1)) ^ R
      have h_diff_holo : DifferentiableOn ℂ diff_fn B₁₂ :=
