        rw [h_back] at h1
        exact h1.symm
    obtain ⟨M_slab, hM_slab_ge_one, hM_slab⟩ :
        ∃ M_slab : ℝ, 1 ≤ M_slab ∧ ∀ w : ℂ, |w.im| ≤ H₃ → shapeModulus S w ≤ M_slab := by
      let R_slab : Set (ℝ × ℝ) := Set.Icc (0 : ℝ) (2 * Real.pi) ×ˢ Set.Icc (-H₃) H₃
