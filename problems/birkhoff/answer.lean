            ‖F (y, t) - c_j y * t ^ (2 * j)‖ ≤ C_rem * ‖t‖ ^ (2 * j + 2)) := by
      intro s s_mid d M_prev j F hs_mid_pos hs_lt hd_pos hM_prev hj hF_holo hF_sym hF_int hF_ord
      obtain ⟨r_t, M_sup, hr_t_pos, hr_t_le_d4, h2r_lt_d, hM_sup_pos, hF_bd⟩ :=
