        refine hExt2D1D fun d n => ?_
        rw [hT_coeff, map_add, map_add, hT_coeff, hT_coeff]
        simp only [map_add]
        rw [(hLC.taylor2D_ring hV hp₁ (hP n) (hQ n)).1, map_add]
      have hT_sub : ∀ {P Q : (ℂ × ℂ) → PowerSeries ℂ},
