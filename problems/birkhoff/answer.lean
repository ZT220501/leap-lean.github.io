          exact deriv_comp ζ
            (hG_diff.differentiableAt (hV_open.mem_nhds (hf_maps ζ hζ)))
            (hf_diff.differentiableAt ((hOpen σ').mem_nhds hζ))
        rw [iteratedDeriv_succ', h_ev.iteratedDeriv_eq m]
