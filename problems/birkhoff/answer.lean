      rw [hy_hit_0, sub_zero, L.𝔰_raw_zero s₀ hs₀]
    have hEv_prev_lt : ∀ᶠ t in nhds (0 : ℂ), ‖L.𝔰_raw (y_hit t - t, t) - s₀‖ < ρ_f := by
      have hcont : ContinuousAt (fun t : ℂ => ‖L.𝔰_raw (y_hit t - t, t) - s₀‖) 0 :=
