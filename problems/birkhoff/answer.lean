          refine Filter.Eventually.of_forall (fun t ht x hx => ?_)
          exact ((hF_diff t (huIoc_sub ht)).differentiableAt
            (hΩ_open.mem_nhds (hs_sub_Ω hx))).hasDerivAt
        obtain ⟨_, hInt_deriv⟩ := intervalIntegral.hasDerivAt_integral_of_dominated_loc_of_deriv_le
          hs_nhds hF_meas hFx₀_int hF'x₀_meas hbound_le hbound_int hhas_deriv
        exact hInt_deriv.differentiableAt.differentiableWithinAt
      intro Ω_x K hΩ_open hK_cont hK_diff
      have hI1_diff : DifferentiableOn ℂ (fun x => ∫ σ in (-t₀)..t₀, K x (σ : ℂ)) Ω_x := by
        apply hparam_interval (-t₀) t₀ (by linarith) Ω_x (fun x σ => K x (σ : ℂ)) hΩ_open
