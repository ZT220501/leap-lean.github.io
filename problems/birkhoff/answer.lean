        dsimp only [M_f]
        field_simp [hq_ne]
      have hCoeff : 2 * F_bd.C_force_lip / (q : ℝ) ^ 2 ≤ 1 / 4 := by
        rw [div_le_iff₀ hq_sq_pos]
        linarith
      have hTerm : (2 * F_bd.C_force_lip / (q : ℝ) ^ 2) * Δ_star ≤ (1 / 4 : ℝ) * Δ_star :=
        mul_le_mul_of_nonneg_right hCoeff hΔ_nonneg
      linarith
    have hBall := hBall_mono hRad hBall_raw
    refine ⟨?_, ?_⟩
    · intro j hj k hk z hz
      have hSubFn :
          (fun ζ => stripMeshStep_ℂ J_C q W₁ d₁ j ζ - stripMeshStep_ℂ J_C q W₂ d₂ j ζ) =
            dirichletInv_ℂ q f_diff j := by
        ext ζ
        exact hDir.sub_eq q (stripMeshForcing_ℂ J_C q W₁ d₁) (stripMeshForcing_ℂ J_C q W₂ d₂) j ζ
      rw [hSubFn]
      exact (hBall.2.2.1 j hj).2.2.2 k hk z hz
    · intro j hj k hk z hz
      have hStepFn :
          (fun ζ =>
            (stripMeshStep_ℂ J_C q W₁ d₁ (j + 1) ζ - stripMeshStep_ℂ J_C q W₁ d₁ j ζ) -
              (stripMeshStep_ℂ J_C q W₂ d₂ (j + 1) ζ - stripMeshStep_ℂ J_C q W₂ d₂ j ζ)) =
            (fun ζ => dirichletInv_ℂ q f_diff (j + 1) ζ - dirichletInv_ℂ q f_diff j ζ) := by
        ext ζ
        have h1 := hDir.sub_eq q (stripMeshForcing_ℂ J_C q W₁ d₁)
          (stripMeshForcing_ℂ J_C q W₂ d₂) (j + 1) ζ
        have h0 := hDir.sub_eq q (stripMeshForcing_ℂ J_C q W₁ d₁)
          (stripMeshForcing_ℂ J_C q W₂ d₂) j ζ
        change (dirichletInv_ℂ q (stripMeshForcing_ℂ J_C q W₁ d₁) (j + 1) ζ -
