            have hnLc := F_val.add_mem hΔxL (F_val.mul_mem hΔYL (hJ1 i_L.castSucc))
            have hnRc := F_val.add_mem hΔxR (F_val.mul_mem hΔYR (hJ1 i_R.castSucc))
            have hnRs := F_val.add_mem hΔxR (F_val.mul_mem hΔYR (hJ1 i_R.succ))
            split_ifs
            · exact F_val.add_mem
                (F_val.div_mem
