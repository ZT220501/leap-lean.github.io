      exact (ContinuousLinearMap.fst ℂ ℂ ℂ).hasFDerivAt.comp_hasDerivAt 0 hΨ_t
    have hy_hit_cont : ContinuousAt y_hit 0 := hy_hit_deriv.continuousAt
    have hEv_right : ∀ᶠ t in nhds (0 : ℂ), L.𝔰_raw (y_hit t, t) = s₀ := by
      have hR := hStrictΦ.eventually_right_inverse
      rw [hΦ_p₀] at hR
      have hCont_pair : ContinuousAt (fun t : ℂ => (s₀, t)) 0 :=
        continuousAt_const.prodMk continuousAt_id
      refine (hCont_pair.eventually hR).mono (fun t ht => ?_)
      have ht1 : F₁ (Ψ (s₀, t)) = s₀ := congr_arg Prod.fst ht
      have ht2 : (Ψ (s₀, t)).2 = t := congr_arg Prod.snd ht
      have hpair : Ψ (s₀, t) = (y_hit t, t) := Prod.ext rfl ht2
