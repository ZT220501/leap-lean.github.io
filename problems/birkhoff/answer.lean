      linarith
    have h_term1 : |(t₂ - s₂) * (D₁ - D₂)| ≤ ((C_sec * C_den) / (q : ℝ) ^ 4) * M := by
      rw [abs_mul]
      have h1 : |t₂ - s₂| * |D₁ - D₂| ≤ (C_sec / (q : ℝ) ^ 4) * (C_den * M) :=
        mul_le_mul ht₂s₂_sec hD_diff (abs_nonneg _) (by positivity)
      have h2 : (C_sec / (q : ℝ) ^ 4) * (C_den * M) =
