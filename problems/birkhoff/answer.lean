          P.D_pass / 2 < -Z.im ∧ -Z.im < D₀ + (m : ℝ) + 4 ∧
          |Z.re| < (A₀ + 3) * (-Z.im) }
      have hT_32 : ‖T_star‖ < (3 / 2 : ℝ) * T₀ := by linarith
      have hS_slice_holo : DifferentiableOn ℂ (fun Z => P.S_seq n (T_star, Z)) W_m :=
