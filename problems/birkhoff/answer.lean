            have hQ1_vb : lineCoreVanishesBelow n (Q1 - Q1_0) :=
              h_vb_comp_sub n _ (d0 + ηd) d0 (by simpa using hηd_vb)
            have hP2_vb : lineCoreVanishesBelow n (P2 - P2_0) :=
              h_vb_comp_sub n _ (ψ0 + ηψ) ψ0 (by simpa using hηψ_vb)
            have hQ2_vb : lineCoreVanishesBelow n (Q2 - Q2_0) :=
              h_vb_comp_sub n _ (d0 + ηd) d0 (by simpa using hηd_vb)
            have hP1_d : MvPowerSeries.coeff d (P1 - P1_0) = h2 * MvPowerSeries.coeff d ηψ := by
