        exact ⟨heq0, by linear_combination heq0 - heqm⟩
      have hInit_open : IsOpen { p : ℂ × ℂ | |p.1.im| < K.s_init ∧ ‖p.2‖ < K.r_init } :=
        (hOpen_strip K.s_init).prod (hBall_open K.r_init)
      have h𝔰0_diff : DifferentiableAt ℂ L.𝔰_raw (y, t) := by
        have hmem : (y, t) ∈ { p : ℂ × ℂ | |p.1.im| < K.s_init ∧ ‖p.2‖ < K.r_init } :=
          ⟨(hB_bounds (y, t) hyt_B).1, (hB_bounds (y, t) hyt_B).2.2.1⟩
        have hd_init := K.𝔰_init_holo.differentiableAt (hInit_open.mem_nhds hmem)
        have hev : L.𝔰_raw =ᶠ[nhds (y, t)] K.𝔰_init :=
          Filter.eventually_of_mem (hB_open.mem_nhds hyt_B)
            (fun p hp => L.𝔰_raw_init_eq p.1 p.2 (hB_bounds p hp).1 (hB_bounds p hp).2.2.1)
        exact hd_init.congr_of_eventuallyEq hev
      have h𝔰m_diff : DifferentiableAt ℂ (fun p : ℂ × ℂ => L.𝔰_raw (p.1 - p.2, p.2)) (y, t) := by
        have hmem : (y - t, t) ∈ { p : ℂ × ℂ | |p.1.im| < K.s_init ∧ ‖p.2‖ < K.r_init } :=
          ⟨(hB_bounds (y, t) hyt_B).2.1, (hB_bounds (y, t) hyt_B).2.2.1⟩
        have hd_sub : DifferentiableAt ℂ (fun p : ℂ × ℂ => (p.1 - p.2, p.2)) (y, t) :=
          (differentiableAt_fst.sub differentiableAt_snd).prodMk differentiableAt_snd
        have hd_init :=
          (K.𝔰_init_holo.differentiableAt (hInit_open.mem_nhds hmem)).comp (y, t) hd_sub
        have hev : (fun p : ℂ × ℂ => L.𝔰_raw (p.1 - p.2, p.2)) =ᶠ[nhds (y, t)]
            (fun p : ℂ × ℂ => K.𝔰_init (p.1 - p.2, p.2)) :=
          Filter.eventually_of_mem (hB_open.mem_nhds hyt_B)
            (fun p hp =>
              L.𝔰_raw_init_eq (p.1 - p.2) p.2 (hB_bounds p hp).2.1 (hB_bounds p hp).2.2.1)
        exact hd_init.congr_of_eventuallyEq hev
      let Ty : ℂ →L[ℂ] ℂ × ℂ := (ContinuousLinearMap.id ℂ ℂ).prod 0
      let Tt : ℂ →L[ℂ] ℂ × ℂ := (0 : ℂ →L[ℂ] ℂ).prod (ContinuousLinearMap.id ℂ ℂ)
      have hSliceDiff : ∀ F : ℂ × ℂ → ℂ, DifferentiableAt ℂ F (y, t) →
          HasDerivAt (fun y' : ℂ => F (y', t)) (deriv (fun y' : ℂ => F (y', t)) y) y ∧
          HasDerivAt (fun t' : ℂ => F (y, t')) (deriv (fun t' : ℂ => F (y, t')) t) t := by
        intro F hF
        have hy_c : HasDerivAt (fun y' : ℂ => (y', t)) (1, 0) y := by
          have h := Ty.hasDerivAt (x := y) |>.const_add (0, t)
          have hf : (fun y' : ℂ => (0, t) + Ty y') = (fun y' : ℂ => (y', t)) := by
            ext y' <;> simp [Ty]
          have hv : Ty 1 = ((1 : ℂ), (0 : ℂ)) := by simp [Ty]
          rwa [hf, hv] at h
        have ht_c : HasDerivAt (fun t' : ℂ => (y, t')) (0, 1) t := by
          have h := Tt.hasDerivAt (x := t) |>.const_add (y, 0)
          have hf : (fun t' : ℂ => (y, 0) + Tt t') = (fun t' : ℂ => (y, t')) := by
            ext t' <;> simp [Tt]
          have hv : Tt 1 = ((0 : ℂ), (1 : ℂ)) := by simp [Tt]
          rwa [hf, hv] at h
        exact ⟨(hF.hasFDerivAt.comp_hasDerivAt y hy_c).differentiableAt.hasDerivAt,
               (hF.hasFDerivAt.comp_hasDerivAt t ht_c).differentiableAt.hasDerivAt⟩
      obtain ⟨hd_s0_y, hd_s0_t⟩ := hSliceDiff L.𝔰_raw h𝔰0_diff
      obtain ⟨hd_sm_y, hd_sm_t⟩ := hSliceDiff (fun p => L.𝔰_raw (p.1 - p.2, p.2)) h𝔰m_diff
      dsimp only at hd_sm_y hd_sm_t
      set s0 := L.𝔰_raw (y, t)
      set sm := L.𝔰_raw (y - t, t)
      have hs0_base : s0 ∈ horizStrip M.s_base := by
        dsimp only [s0]
        rw [L.𝔰_raw_init_eq y t (hB_bounds (y, t) hyt_B).1 (hB_bounds (y, t) hyt_B).2.2.1]
        exact K.𝔰_init_maps_to y t (hB_bounds (y, t) hyt_B).1 (hB_bounds (y, t) hyt_B).2.2.1
      have hsm_base : sm ∈ horizStrip M.s_base := by
        dsimp only [sm]
        rw [L.𝔰_raw_init_eq (y - t) t (hB_bounds (y, t) hyt_B).2.1 (hB_bounds (y, t) hyt_B).2.2.1]
        exact K.𝔰_init_maps_to (y - t) t
          (hB_bounds (y, t) hyt_B).2.1 (hB_bounds (y, t) hyt_B).2.2.1
      have hfs0_ne : K.f s0 ≠ 0 := K.f_base_ne_zero s0 hs0_base
      have hfsm_ne : K.f sm ≠ 0 := K.f_base_ne_zero sm hsm_base
      have hs0_DH : s0 ∈ D_H := hbase_sub_DH hs0_base
      have hsm_DH : sm ∈ D_H := hbase_sub_DH hsm_base
      have hΓ0_s0 := (K.Γ_reg_holo s0 hs0_DH hfs0_ne).1.hasDerivAt
      have hΓ1_s0 := (K.Γ_reg_holo s0 hs0_DH hfs0_ne).2.hasDerivAt
      have hΓ0_sm := (K.Γ_reg_holo sm hsm_DH hfsm_ne).1.hasDerivAt
      have hΓ1_sm := (K.Γ_reg_holo sm hsm_DH hfsm_ne).2.hasDerivAt
      set θ := Θ_sh (y, t)
      set θ_y := deriv (fun y' : ℂ => Θ_sh (y', t)) y
      set θ_t := deriv (fun t' : ℂ => Θ_sh (y, t')) t
      have hΘ_y : HasDerivAt (fun y' : ℂ => Θ_sh (y', t)) θ_y y :=
        hd_Θ_y.differentiableAt.hasDerivAt
      have hΘ_t : HasDerivAt (fun t' : ℂ => Θ_sh (y, t')) θ_t t :=
        hd_Θ_t.differentiableAt.hasDerivAt
      have hp_y_hd : HasDerivAt (fun y' : ℂ => p_sh (y', t))
          (deriv (fun y' : ℂ => p_sh (y', t)) y) y := hd_p_y.differentiableAt.hasDerivAt
      have hp_t_hd : HasDerivAt (fun t' : ℂ => p_sh (y, t'))
          (deriv (fun t' : ℂ => p_sh (y, t')) t) t := hd_p_t.differentiableAt.hasDerivAt
      set s0_y := deriv (fun y' : ℂ => L.𝔰_raw (y', t)) y
      set s0_t := deriv (fun t' : ℂ => L.𝔰_raw (y, t')) t
      set sm_y := deriv (fun y' : ℂ => L.𝔰_raw (y' - t, t)) y
      set sm_t := deriv (fun t' : ℂ => L.𝔰_raw (y - t', t')) t
      set γ0_0 := deriv (fun z => K.Γ z 0) s0
      set γ0_1 := deriv (fun z => K.Γ z 1) s0
      set γm_0 := deriv (fun z => K.Γ z 0) sm
      set γm_1 := deriv (fun z => K.Γ z 1) sm
      set Δ0_b := K.Γ s0 0 - K.Γ sm 0
      set Δ1_b := K.Γ s0 1 - K.Γ sm 1
      have hy_nhds : { y' : ℂ | (y', t) ∈ B_col } ∈ nhds y :=
        (continuous_id.prodMk continuous_const).continuousAt.eventually (hB_open.mem_nhds hyt_B)
      have ht_nhds : { t' : ℂ | (y, t') ∈ B_col } ∈ nhds t :=
        (continuous_const.prodMk continuous_id).continuousAt.eventually (hB_open.mem_nhds hyt_B)
      have hg0_y := hΓ0_s0.comp y hd_s0_y
      have hg1_y := hΓ1_s0.comp y hd_s0_y
      have hgm0_y := hΓ0_sm.comp y hd_sm_y
      have hgm1_y := hΓ1_sm.comp y hd_sm_y
      have hcos_y := (Complex.hasDerivAt_cos θ).comp y hΘ_y
      have hsin_y := (Complex.hasDerivAt_sin θ).comp y hΘ_y
      have hd_orth_y := ((hg0_y.sub hgm0_y).mul hcos_y).add ((hg1_y.sub hgm1_y).mul hsin_y)
      have horth_y_eq : (γ0_0 * s0_y - γm_0 * sm_y) * Complex.cos θ +
          Δ0_b * (-Complex.sin θ * θ_y) +
          ((γ0_1 * s0_y - γm_1 * sm_y) * Complex.sin θ +
           Δ1_b * (Complex.cos θ * θ_y)) = 0 := by
        have hev : ((((fun z => K.Γ z 0) ∘ fun y' => L.𝔰_raw (y', t)) -
              ((fun z => K.Γ z 0) ∘ fun y' => L.𝔰_raw (y' - t, t))) *
              (Complex.cos ∘ fun y' => Θ_sh (y', t)) +
            (((fun z => K.Γ z 1) ∘ fun y' => L.𝔰_raw (y', t)) -
              ((fun z => K.Γ z 1) ∘ fun y' => L.𝔰_raw (y' - t, t))) *
              (Complex.sin ∘ fun y' => Θ_sh (y', t))) =ᶠ[nhds y]
            (fun _ => (0 : ℂ)) :=
          Filter.eventually_of_mem hy_nhds (fun y' hy' => (hProj (y', t) hy').2)
        exact hd_orth_y.unique ((hasDerivAt_const y (0 : ℂ)).congr_of_eventuallyEq hev)
      have hg0_t := hΓ0_s0.comp t hd_s0_t
      have hg1_t := hΓ1_s0.comp t hd_s0_t
      have hgm0_t := hΓ0_sm.comp t hd_sm_t
      have hgm1_t := hΓ1_sm.comp t hd_sm_t
      have hcos_t := (Complex.hasDerivAt_cos θ).comp t hΘ_t
      have hsin_t := (Complex.hasDerivAt_sin θ).comp t hΘ_t
      have hd_orth_t := ((hg0_t.sub hgm0_t).mul hcos_t).add ((hg1_t.sub hgm1_t).mul hsin_t)
      have horth_t_eq : (γ0_0 * s0_t - γm_0 * sm_t) * Complex.cos θ +
          Δ0_b * (-Complex.sin θ * θ_t) +
          ((γ0_1 * s0_t - γm_1 * sm_t) * Complex.sin θ +
           Δ1_b * (Complex.cos θ * θ_t)) = 0 := by
        have hev : ((((fun z => K.Γ z 0) ∘ fun t' => L.𝔰_raw (y, t')) -
              ((fun z => K.Γ z 0) ∘ fun t' => L.𝔰_raw (y - t', t'))) *
              (Complex.cos ∘ fun t' => Θ_sh (y, t')) +
            (((fun z => K.Γ z 1) ∘ fun t' => L.𝔰_raw (y, t')) -
              ((fun z => K.Γ z 1) ∘ fun t' => L.𝔰_raw (y - t', t'))) *
              (Complex.sin ∘ fun t' => Θ_sh (y, t'))) =ᶠ[nhds t]
            (fun _ => (0 : ℂ)) :=
          Filter.eventually_of_mem ht_nhds (fun t' ht' => (hProj (y, t') ht').2)
        exact hd_orth_t.unique ((hasDerivAt_const t (0 : ℂ)).congr_of_eventuallyEq hev)
      have hd_proj_y := (hg0_y.mul hcos_y).add (hg1_y.mul hsin_y)
      have hp_y_eq : deriv (fun y' : ℂ => p_sh (y', t)) y =
          (γ0_0 * s0_y) * Complex.cos θ + K.Γ s0 0 * (-Complex.sin θ * θ_y) +
          ((γ0_1 * s0_y) * Complex.sin θ + K.Γ s0 1 * (Complex.cos θ * θ_y)) := by
        have hev : (fun y' : ℂ => p_sh (y', t)) =ᶠ[nhds y]
            (((fun z => K.Γ z 0) ∘ fun y' => L.𝔰_raw (y', t)) *
                (Complex.cos ∘ fun y' => Θ_sh (y', t)) +
              ((fun z => K.Γ z 1) ∘ fun y' => L.𝔰_raw (y', t)) *
                (Complex.sin ∘ fun y' => Θ_sh (y', t))) :=
          Filter.eventually_of_mem hy_nhds (fun y' hy' => (hProj (y', t) hy').1.symm)
        exact hp_y_hd.unique (hd_proj_y.congr_of_eventuallyEq hev)
      have hd_proj_t := (hg0_t.mul hcos_t).add (hg1_t.mul hsin_t)
      have hp_t_eq : deriv (fun t' : ℂ => p_sh (y, t')) t =
          (γ0_0 * s0_t) * Complex.cos θ + K.Γ s0 0 * (-Complex.sin θ * θ_t) +
          ((γ0_1 * s0_t) * Complex.sin θ + K.Γ s0 1 * (Complex.cos θ * θ_t)) := by
        have hev : (fun t' : ℂ => p_sh (y, t')) =ᶠ[nhds t]
            (((fun z => K.Γ z 0) ∘ fun t' => L.𝔰_raw (y, t')) *
                (Complex.cos ∘ fun t' => Θ_sh (y, t')) +
              ((fun z => K.Γ z 1) ∘ fun t' => L.𝔰_raw (y, t')) *
                (Complex.sin ∘ fun t' => Θ_sh (y, t'))) :=
          Filter.eventually_of_mem ht_nhds (fun t' ht' => (hProj (y, t') ht').1.symm)
        exact hp_t_hd.unique (hd_proj_t.congr_of_eventuallyEq hev)
      have horth_pt : Δ0_b * Complex.cos θ + Δ1_b * Complex.sin θ = 0 :=
        (hProj (y, t) hyt_B).2
      have hpyth_θ : Complex.cos θ ^ 2 + Complex.sin θ ^ 2 = 1 := Complex.cos_sq_add_sin_sq θ
      set L_len : ℂ := -Δ0_b * Complex.sin θ + Δ1_b * Complex.cos θ
      have hL_cos : L_len * Complex.cos θ = Δ1_b := by
        dsimp only [L_len]
        linear_combination -Complex.sin θ * horth_pt + Δ1_b * hpyth_θ
      have hL_sin : L_len * Complex.sin θ = -Δ0_b := by
        dsimp only [L_len]
        linear_combination Complex.cos θ * horth_pt - Δ0_b * hpyth_θ
      have hL_sq : L_len ^ 2 = Δ0_b ^ 2 + Δ1_b ^ 2 := by
        dsimp only [L_len]
        linear_combination -(Δ0_b * Complex.cos θ + Δ1_b * Complex.sin θ) * horth_pt +
          (Δ0_b ^ 2 + Δ1_b ^ 2) * hpyth_θ
      have hθ_y_elim : (Δ0_b ^ 2 + Δ1_b ^ 2) * θ_y =
          Δ0_b * (γ0_1 * s0_y - γm_1 * sm_y) - Δ1_b * (γ0_0 * s0_y - γm_0 * sm_y) := by
        linear_combination
          L_len * horth_y_eq -
          (γ0_0 * s0_y - γm_0 * sm_y) * hL_cos -
          (γ0_1 * s0_y - γm_1 * sm_y) * hL_sin -
          θ_y * hL_sq
      have hθ_t_elim : (Δ0_b ^ 2 + Δ1_b ^ 2) * θ_t =
          Δ0_b * (γ0_1 * s0_t - γm_1 * sm_t) - Δ1_b * (γ0_0 * s0_t - γm_0 * sm_t) := by
        linear_combination
          L_len * horth_t_eq -
          (γ0_0 * s0_t - γm_0 * sm_t) * hL_cos -
          (γ0_1 * s0_t - γm_1 * sm_t) * hL_sin -
          θ_t * hL_sq
      have hA_eq : C.A t = (γ0_0 * Complex.cos θ + γ0_1 * Complex.sin θ) *
          (s0_y * θ_t - s0_t * θ_y) := by
        rw [← hSymp_sh, hp_y_eq, hp_t_eq]
        ring
      have hγ0_0_eq : (K.f s0) ^ 2 * γ0_0 = -(C.c : ℂ) * Complex.sin (K.ϕ s0) := by
        dsimp only [γ0_0]
        rw [K.Γ_deriv₀ s0 hs0_DH hfs0_ne]
        field_simp [hfs0_ne]
      have hγ0_1_eq : (K.f s0) ^ 2 * γ0_1 = (C.c : ℂ) * Complex.cos (K.ϕ s0) := by
        dsimp only [γ0_1]
        rw [K.Γ_deriv₁ s0 hs0_DH hfs0_ne]
        field_simp [hfs0_ne]
      have hγm_0_eq : (K.f sm) ^ 2 * γm_0 = -(C.c : ℂ) * Complex.sin (K.ϕ sm) := by
        dsimp only [γm_0]
        rw [K.Γ_deriv₀ sm hsm_DH hfsm_ne]
        field_simp [hfsm_ne]
      have hγm_1_eq : (K.f sm) ^ 2 * γm_1 = (C.c : ℂ) * Complex.cos (K.ϕ sm) := by
        dsimp only [γm_1]
        rw [K.Γ_deriv₁ sm hsm_DH hfsm_ne]
        field_simp [hfsm_ne]
      set J : ℂ := s0_y * sm_t - s0_t * sm_y
      have hFactor1 : (K.f s0) ^ 2 * L_len * (γ0_0 * Complex.cos θ + γ0_1 * Complex.sin θ) =
          -(C.c : ℂ) * (Δ0_b * Complex.cos (K.ϕ s0) + Δ1_b * Complex.sin (K.ϕ s0)) := by
        linear_combination
          (K.f s0) ^ 2 * γ0_0 * hL_cos + (K.f s0) ^ 2 * γ0_1 * hL_sin +
          Δ1_b * hγ0_0_eq - Δ0_b * hγ0_1_eq
      have hFactor2 : (K.f sm) ^ 2 * (Δ0_b ^ 2 + Δ1_b ^ 2) * (s0_y * θ_t - s0_t * θ_y) =
          -(C.c : ℂ) * J * (Δ0_b * Complex.cos (K.ϕ sm) + Δ1_b * Complex.sin (K.ϕ sm)) := by
        dsimp only [J]
        linear_combination
          (K.f sm) ^ 2 * s0_y * hθ_t_elim - (K.f sm) ^ 2 * s0_t * hθ_y_elim -
          Δ0_b * (s0_y * sm_t - s0_t * sm_y) * hγm_1_eq +
          Δ1_b * (s0_y * sm_t - s0_t * sm_y) * hγm_0_eq
      have hUnsquared : C.A t * (K.f s0) ^ 2 * (K.f sm) ^ 2 * L_len * (Δ0_b ^ 2 + Δ1_b ^ 2) =
          (C.c : ℂ) ^ 2 * J *
            (Δ0_b * Complex.cos (K.ϕ s0) + Δ1_b * Complex.sin (K.ϕ s0)) *
            (Δ0_b * Complex.cos (K.ϕ sm) + Δ1_b * Complex.sin (K.ϕ sm)) := by
        rw [hA_eq]
        linear_combination
          ((K.f sm) ^ 2 * (Δ0_b ^ 2 + Δ1_b ^ 2) * (s0_y * θ_t - s0_t * θ_y)) * hFactor1 +
          (-(C.c : ℂ) * (Δ0_b * Complex.cos (K.ϕ s0) + Δ1_b * Complex.sin (K.ϕ s0))) * hFactor2
      change (C.A t) ^ 2 * (K.f s0) ^ 4 * (K.f sm) ^ 4 * (Δ0_b ^ 2 + Δ1_b ^ 2) ^ 3 =
        (C.c : ℂ) ^ 4 * J ^ 2 *
          (Δ0_b * Complex.cos (K.ϕ s0) + Δ1_b * Complex.sin (K.ϕ s0)) ^ 2 *
          (Δ0_b * Complex.cos (K.ϕ sm) + Δ1_b * Complex.sin (K.ϕ sm)) ^ 2
      linear_combination
        (C.A t * (K.f s0) ^ 2 * (K.f sm) ^ 2 * L_len * (Δ0_b ^ 2 + Δ1_b ^ 2) +
          (C.c : ℂ) ^ 2 * J *
            (Δ0_b * Complex.cos (K.ϕ s0) + Δ1_b * Complex.sin (K.ϕ s0)) *
            (Δ0_b * Complex.cos (K.ϕ sm) + Δ1_b * Complex.sin (K.ϕ sm))) * hUnsquared -
        (C.A t) ^ 2 * (K.f s0) ^ 4 * (K.f sm) ^ 4 * (Δ0_b ^ 2 + Δ1_b ^ 2) ^ 2 * hL_sq
    
    let S : Set ℂ := horizStrip H'
    have hS_open : IsOpen S := hOpen_strip H'
    have hS_preconn : IsPreconnected S := (hConv_strip H').isPreconnected
    let LHS_fn : ℂ → ℂ := fun y =>
      (C.A t₀) ^ 2 * (K.f (g₀ y)) ^ 4 * (K.f (g_m y)) ^ 4 *
        ((K.Γ (g₀ y) 0 - K.Γ (g_m y) 0) ^ 2 + (K.Γ (g₀ y) 1 - K.Γ (g_m y) 1) ^ 2) ^ 3
    let RHS_fn : ℂ → ℂ := fun y =>
      (C.c : ℂ) ^ 4 * (J_slice y) ^ 2 *
        ((K.Γ (g₀ y) 0 - K.Γ (g_m y) 0) * Complex.cos (K.ϕ (g₀ y)) +
          (K.Γ (g₀ y) 1 - K.Γ (g_m y) 1) * Complex.sin (K.ϕ (g₀ y))) ^ 2 *
        ((K.Γ (g₀ y) 0 - K.Γ (g_m y) 0) * Complex.cos (K.ϕ (g_m y)) +
          (K.Γ (g₀ y) 1 - K.Γ (g_m y) 1) * Complex.sin (K.ϕ (g_m y))) ^ 2
    let Diff : ℂ → ℂ := fun y => LHS_fn y - RHS_fn y
    have hg₀_anal : AnalyticOnNhd ℂ g₀ S := hg₀_holo.analyticOnNhd hS_open
    have hgm_anal : AnalyticOnNhd ℂ g_m S := hgm_holo.analyticOnNhd hS_open
    have holo_to_mero : ∀ h : ℂ → ℂ, DifferentiableOn ℂ h S → MeromorphicOn h S :=
      fun _ hh => (hh.analyticOnNhd hS_open).meromorphicOn
    have hm_fg₀ : MeromorphicOn (fun y => K.f (g₀ y)) S :=
      holo_to_mero _ (K.f_holo.comp hg₀_holo hg₀_maps)
    have hm_fgm : MeromorphicOn (fun y => K.f (g_m y)) S :=
      holo_to_mero _ (K.f_holo.comp hgm_holo hgm_maps)
    have hm_cϕ0 : MeromorphicOn (fun y => Complex.cos (K.ϕ (g₀ y))) S :=
      holo_to_mero _ (Complex.differentiable_cos.differentiableOn.comp
        (K.ϕ_holo.comp hg₀_holo hg₀_maps) (Set.mapsTo_univ _ _))
    have hm_sϕ0 : MeromorphicOn (fun y => Complex.sin (K.ϕ (g₀ y))) S :=
      holo_to_mero _ (Complex.differentiable_sin.differentiableOn.comp
        (K.ϕ_holo.comp hg₀_holo hg₀_maps) (Set.mapsTo_univ _ _))
    have hm_cϕm : MeromorphicOn (fun y => Complex.cos (K.ϕ (g_m y))) S :=
      holo_to_mero _ (Complex.differentiable_cos.differentiableOn.comp
        (K.ϕ_holo.comp hgm_holo hgm_maps) (Set.mapsTo_univ _ _))
    have hm_sϕm : MeromorphicOn (fun y => Complex.sin (K.ϕ (g_m y))) S :=
      holo_to_mero _ (Complex.differentiable_sin.differentiableOn.comp
        (K.ϕ_holo.comp hgm_holo hgm_maps) (Set.mapsTo_univ _ _))
    have hm_J : MeromorphicOn J_slice S := holo_to_mero _ hJ_holo
    have hm_Γ0_0 : MeromorphicOn (fun y => K.Γ (g₀ y) 0) S :=
