          have h := sub_smul_dslope f a ζ
          rw [smul_eq_mul, hfa, sub_zero] at h
          exact h.symm
        have hf₁_ne : ∀ᶠ ζ in nhdsWithin a ({a}ᶜ : Set ℂ), f₁ ζ = (ζ - a) ^ m₀ * v ζ := by
          filter_upwards [hf_ev.filter_mono nhdsWithin_le_nhds, eventually_mem_nhdsWithin] with ζ hζ hne
          have hsub_ne : ζ - a ≠ 0 := sub_ne_zero.mpr (Set.mem_compl_singleton_iff.mp hne)
