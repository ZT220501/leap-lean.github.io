            32805 / (q : ℝ) ^ 4 := by ring
        have h_m : |u₁ - u₂| *
            (u₁ ^ 4 + u₁ ^ 3 * u₂ + u₁ ^ 2 * u₂ ^ 2 + u₁ * u₂ ^ 3 + u₂ ^ 4) ≤
