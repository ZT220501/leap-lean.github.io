  have hLift : LineRecFormalLiftToolkit := by
    clear hTrig hSub hNonAlg hJet hAlg E hδ₁ ha₁ δ₁ a₁ G hk k B C Ω
    have h_jet0 : ∀ (A : ℕ → PowerSeries ℂ) (Δ : PowerSeries ℂ) (n : ℕ),
        PowerSeries.coeff n (lineRecJetSeq A Δ 0) =
          PowerSeries.constantCoeff (A n) / (n.factorial : ℂ) := by
      intro A Δ n
      unfold lineRecJetSeq
      rw [PowerSeries.coeff_mk, Finset.range_one, Finset.sum_singleton]
      simp only [Nat.factorial_zero, Nat.cast_one, mul_one, add_zero, pow_zero,
        PowerSeries.coeff_C_mul, PowerSeries.coeff_zero_eq_constantCoeff]
      ring
    have h_jet_deriv : ∀ (A : ℕ → PowerSeries ℂ) (Δ : PowerSeries ℂ) (l : ℕ),
        PowerSeries.derivative (lineRecJetSeq A Δ l) = lineRecJetSeq (fun m => A (m + 1)) Δ l := by
      intro A Δ l
      ext n
      rw [PowerSeries.coeff_derivative]
      simp only [lineRecJetSeq, PowerSeries.coeff_mk, map_sum, PowerSeries.coeff_C_mul, mul_assoc]
      rw [Finset.sum_mul]
      apply Finset.sum_congr rfl
      intro r _
      have h_idx : n + 1 + r = n + r + 1 := by omega
      rw [h_idx]
