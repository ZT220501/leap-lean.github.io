      intro p hp
      exact h_prod_holo (U := Metric.ball p (ssbpcPairChartRad E₀ E₁ p))
        Finset.univ (fun ci q => ssbpcPairDen E₀ E₁ p q ci)
        (fun ci _ => (h_num_den_holo p hp ci).2)
    have h_single_den_nz : ∀ {F : MeroOn2D Ω_dom} {p : ℂ × ℂ}, p ∈ Ω_dom →
        ∀ V : Set (ℂ × ℂ), IsOpen V → V.Nonempty → V ⊆ Metric.ball p (F.rad p) →
        ∃ q ∈ V, F.den p q ≠ 0 := by
      intro F p hp V hV hV_ne hV_sub
      by_contra h_none
      have h_all : ∀ q ∈ V, F.den p q = 0 :=
        fun q hq => not_ne_iff.mp (fun hne => h_none ⟨q, hq, hne⟩)
      obtain ⟨q_nz, hq_nz_mem, hq_nz⟩ := F.den_ne_zero p hp
      exact hq_nz (B_cr.eqOn_zero_of_preconnected_2D Metric.isOpen_ball
