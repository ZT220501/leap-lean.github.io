      let n_L_cast := Δx_L + ΔY_L * F'_L_cast
      let Δx_R := pointRecDx0 x_star β₀ i_R
      let ΔY_R := pointRecDy0 f₀ β₀ i_R
      let L_R := pointRecLen0 ℓ_star x_star f₀ β₀ i_R
      let invL_R := pointRecInvLen0 ℓ_star x_star f₀ β₀ i_R
      let F'_R_cast := F'₀ i_R.castSucc
      let F'_R_succ := F'₀ i_R.succ
      let F''_R_cast := F''₀ i_R.castSucc
      let n_R_cast := Δx_R + ΔY_R * F'_R_cast
      let n_R_succ := Δx_R + ΔY_R * F'_R_succ
      let H_diag :=
        (((1 + F'_L_succ ^ 2 + ΔY_L * F''_L_succ) * L_L ^ 2 - n_L_succ ^ 2) * invL_L ^ 3) +
        (((1 + F'_R_cast ^ 2 - ΔY_R * F''_R_cast) * L_R ^ 2 - n_R_cast ^ 2) * invL_R ^ 3)
      let H_right := ((-1 - F'_R_succ * F'_R_cast) * L_R ^ 2 + n_R_cast * n_R_succ) * invL_R ^ 3
      let H_left := ((-1 - F'_L_cast * F'_L_succ) * L_L ^ 2 + n_L_succ * n_L_cast) * invL_L ^ 3
      have hLeft_mod : ModEq j
          ((pointArcFormalDx2D1D x_star β_full i_L +
            pointArcFormalDy2D1D f_full β_full i_L *
              pointArcComp2D1D (fun l => PowerSeries.derivative (f_full i_L.succ l))
                (pointArcFormalAbscissa2D1D β_full i_L.succ)) *
            pointArcFormalInvEdgeLen2D1D ℓ_star x_star f_full β_full i_L)
          ((pointArcFormalDx2D1D x_star β_J i_L +
            pointArcFormalDy2D1D f_j β_J i_L *
              pointArcComp2D1D (fun l => PowerSeries.derivative (f_j i_L.succ l))
                (pointArcFormalAbscissa2D1D β_J i_L.succ)) *
            pointArcFormalInvEdgeLen2D1D ℓ_star x_star f_j β_J i_L +
            X_ε ^ j * ι₀
              ((((1 + F'_L_succ ^ 2 + ΔY_L * F''_L_succ) * L_L ^ 2 - n_L_succ ^ 2) * invL_L ^ 3) *
                δ i_L.succ + H_left * δ i_L.castSucc)) := by
        have hprod_dy := hMod_trans
          (hMod_mul (hDy_var i_L) (hF'_var i_L.succ))
          (hMod_mul_pert _ _ _ _)
        rw [hDy_sl0, hF'_sl0] at hprod_dy
        have hnum := hMod_add_pert (hDx_var i_L) hprod_dy
        have htot := hMod_trans (hMod_mul hnum (hInvLen_var i_L)) (hMod_mul_pert _ _ _ _)
        have hnum_sl0 : pointArcSlice2D1D 0
            (pointArcFormalDx2D1D x_star β_J i_L +
              pointArcFormalDy2D1D f_j β_J i_L *
                pointArcComp2D1D (fun l => PowerSeries.derivative (f_j i_L.succ l))
                  (pointArcFormalAbscissa2D1D β_J i_L.succ)) = n_L_succ := by
          rw [hslice0_add, hDx_sl0, hslice0_mul, hDy_sl0, hF'_sl0]
        rw [hnum_sl0, hInvLen_sl0] at htot
        have hring_L :
            n_L_succ * (-(n_L_succ * δ i_L.succ - n_L_cast * δ i_L.castSucc) * invL_L ^ 3) +
              ((δ i_L.succ - δ i_L.castSucc) +
                (ΔY_L * (F''_L_succ * δ i_L.succ) +
                  (F'_L_succ * δ i_L.succ - F'_L_cast * δ i_L.castSucc) * F'_L_succ)) * invL_L =
            (((1 + F'_L_succ ^ 2 + ΔY_L * F''_L_succ) * L_L ^ 2 - n_L_succ ^ 2) * invL_L ^ 3) *
              δ i_L.succ + H_left * δ i_L.castSucc := by
          dsimp only [H_left]
          conv_lhs => arg 2; rw [show invL_L = L_L ^ 2 * invL_L ^ 3 from hInv_eq_L2_I3 i_L]
          ring
        rwa [hring_L] at htot
      have hRight_mod : ModEq j
          ((pointArcFormalDx2D1D x_star β_full i_R +
            pointArcFormalDy2D1D f_full β_full i_R *
              pointArcComp2D1D (fun l => PowerSeries.derivative (f_full i_R.castSucc l))
                (pointArcFormalAbscissa2D1D β_full i_R.castSucc)) *
            pointArcFormalInvEdgeLen2D1D ℓ_star x_star f_full β_full i_R)
          ((pointArcFormalDx2D1D x_star β_J i_R +
            pointArcFormalDy2D1D f_j β_J i_R *
              pointArcComp2D1D (fun l => PowerSeries.derivative (f_j i_R.castSucc l))
                (pointArcFormalAbscissa2D1D β_J i_R.castSucc)) *
            pointArcFormalInvEdgeLen2D1D ℓ_star x_star f_j β_J i_R +
            X_ε ^ j * ι₀
              (-((((1 + F'_R_cast ^ 2 - ΔY_R * F''_R_cast) * L_R ^ 2 - n_R_cast ^ 2) * invL_R ^ 3) *
                δ i_R.castSucc + H_right * δ i_R.succ))) := by
        have hprod_dy := hMod_trans
          (hMod_mul (hDy_var i_R) (hF'_var i_R.castSucc))
          (hMod_mul_pert _ _ _ _)
        rw [hDy_sl0, hF'_sl0] at hprod_dy
        have hnum := hMod_add_pert (hDx_var i_R) hprod_dy
        have htot := hMod_trans (hMod_mul hnum (hInvLen_var i_R)) (hMod_mul_pert _ _ _ _)
        have hnum_sl0 : pointArcSlice2D1D 0
            (pointArcFormalDx2D1D x_star β_J i_R +
              pointArcFormalDy2D1D f_j β_J i_R *
                pointArcComp2D1D (fun l => PowerSeries.derivative (f_j i_R.castSucc l))
                  (pointArcFormalAbscissa2D1D β_J i_R.castSucc)) = n_R_cast := by
          rw [hslice0_add, hDx_sl0, hslice0_mul, hDy_sl0, hF'_sl0]
        rw [hnum_sl0, hInvLen_sl0] at htot
        have hring_R :
            n_R_cast * (-(n_R_succ * δ i_R.succ - n_R_cast * δ i_R.castSucc) * invL_R ^ 3) +
              ((δ i_R.succ - δ i_R.castSucc) +
                (ΔY_R * (F''_R_cast * δ i_R.castSucc) +
                  (F'_R_succ * δ i_R.succ - F'_R_cast * δ i_R.castSucc) * F'_R_cast)) * invL_R =
            -((((1 + F'_R_cast ^ 2 - ΔY_R * F''_R_cast) * L_R ^ 2 - n_R_cast ^ 2) * invL_R ^ 3) *
              δ i_R.castSucc + H_right * δ i_R.succ) := by
          dsimp only [H_right]
          conv_lhs => arg 2; rw [show invL_R = L_R ^ 2 * invL_R ^ 3 from hInv_eq_L2_I3 i_R]
          ring
        rwa [hring_R] at htot
      have hGrad_mod : ModEq j
          (pointArcFormalGrad2D1D ℓ_star x_star f_full β_full r)
          (pointArcFormalGrad2D1D ℓ_star x_star f_j β_J r +
            X_ε ^ j * ι₀ (H_diag * δ i_L.succ + H_right * δ i_R.succ + H_left * δ i_L.castSucc)) := by
        have hs := hMod_sub_pert hLeft_mod hRight_mod
        have hcomb_hess :
            ((((1 + F'_L_succ ^ 2 + ΔY_L * F''_L_succ) * L_L ^ 2 - n_L_succ ^ 2) * invL_L ^ 3) *
              δ i_L.succ + H_left * δ i_L.castSucc) -
            (-((((1 + F'_R_cast ^ 2 - ΔY_R * F''_R_cast) * L_R ^ 2 - n_R_cast ^ 2) * invL_R ^ 3) *
              δ i_R.castSucc + H_right * δ i_R.succ)) =
            H_diag * δ i_L.succ + H_right * δ i_R.succ + H_left * δ i_L.castSucc := by
          rw [hi_LR_eq]
          dsimp only [H_diag]
          ring
        rwa [hcomb_hess] at hs
      rw [hSlice_top_extract hGrad_mod]
      apply congr_arg₂ (· + ·) rfl
      have hite3 : ∀ (p₁ p₂ p₃ : Prop) [Decidable p₁] [Decidable p₂] [Decidable p₃]
          (A B C : MvPowerSeries (Fin 2) ℂ),
          (p₁ → ¬p₂) → (p₁ → ¬p₃) → (p₂ → ¬p₃) →
          (if p₁ then A else if p₂ then B else if p₃ then C else 0) =
            (if p₁ then A else 0) + (if p₂ then B else 0) + (if p₃ then C else 0) := by
        intro p₁ p₂ p₃ _ _ _ A B C h12 h13 h23
        by_cases h1 : p₁
        · simp only [if_pos h1, if_neg (h12 h1), if_neg (h13 h1), add_zero]
        · by_cases h2 : p₂
          · simp only [if_neg h1, if_pos h2, if_neg (h23 h2), zero_add, add_zero]
          · by_cases h3 : p₃
            · simp only [if_neg h1, if_neg h2, if_pos h3, zero_add]
            · simp only [if_neg h1, if_neg h2, if_neg h3, add_zero]
      have hHess_decomp : ∀ s : Fin (k - 1),
          pointRecHess0 ℓ_star x_star f₀ β₀ r s =
            (if r.1 = s.1 then H_diag else 0) +
            (if s.1 = r.1 + 1 then H_right else 0) +
            (if r.1 = s.1 + 1 then H_left else 0) :=
        fun s => hite3 (r.1 = s.1) (s.1 = r.1 + 1) (r.1 = s.1 + 1) H_diag H_right H_left
          (by omega) (by omega) (by omega)
      have hsum_diag :
          (∑ s : Fin (k - 1),
            (if r.1 = s.1 then H_diag else 0) * δ ⟨s.1 + 1, by have := s.2; omega⟩) =
            H_diag * δ i_L.succ := by
        rw [Finset.sum_eq_single r]
        · rw [if_pos rfl]; rfl
        · intro s _ hsr
          have hne : r.1 ≠ s.1 := fun h => hsr (Fin.ext h).symm
          rw [if_neg hne, zero_mul]
        · intro hr; exact False.elim (hr (Finset.mem_univ r))
      have hsum_right :
          (∑ s : Fin (k - 1),
            (if s.1 = r.1 + 1 then H_right else 0) * δ ⟨s.1 + 1, by have := s.2; omega⟩) =
            H_right * δ i_R.succ := by
        by_cases hr_hi : r.1 + 1 < k - 1
        · rw [Finset.sum_eq_single ⟨r.1 + 1, hr_hi⟩]
          · rw [if_pos rfl]; rfl
          · intro s _ hs
            have hne : s.1 ≠ r.1 + 1 := fun h => hs (Fin.ext h)
            rw [if_neg hne, zero_mul]
          · intro hm; exact False.elim (hm (Finset.mem_univ _))
        · have hzero : (∑ s : Fin (k - 1),
              (if s.1 = r.1 + 1 then H_right else 0) * δ ⟨s.1 + 1, by have := s.2; omega⟩) = 0 := by
            apply Finset.sum_eq_zero; intro s _
            rw [if_neg (by have := s.2; omega), zero_mul]
          have hlast : i_R.succ = Fin.last k := by ext; dsimp [i_R]; have := r.2; omega
          rw [hzero, hlast]; dsimp only [δ, j]; rw [(hβ_end J).2, mul_zero]
      have hsum_left :
          (∑ s : Fin (k - 1),
            (if r.1 = s.1 + 1 then H_left else 0) * δ ⟨s.1 + 1, by have := s.2; omega⟩) =
            H_left * δ i_L.castSucc := by
        by_cases hr0 : r.1 = 0
        · have hzero : (∑ s : Fin (k - 1),
              (if r.1 = s.1 + 1 then H_left else 0) * δ ⟨s.1 + 1, by have := s.2; omega⟩) = 0 := by
            apply Finset.sum_eq_zero; intro s _
            rw [if_neg (by omega), zero_mul]
          have hcast0 : i_L.castSucc = 0 := by ext; exact hr0
          rw [hzero, hcast0]; dsimp only [δ, j]; rw [(hβ_end J).1, mul_zero]
        · rw [Finset.sum_eq_single ⟨r.1 - 1, by have := r.2; omega⟩]
          · rw [if_pos (by dsimp; omega)]
            apply congr_arg (H_left * ·)
            apply congr_arg δ
            ext; dsimp [i_L]; omega
          · intro s _ hs
            have hne : r.1 ≠ s.1 + 1 := by
              intro h; apply hs; ext; dsimp; omega
            rw [if_neg hne, zero_mul]
          · intro hm; exact False.elim (hm (Finset.mem_univ _))
      symm
      calc (∑ s : Fin (k - 1),
              pointRecHess0 ℓ_star x_star (fun u => f_full u 0) (β_full 0) r s *
                β_full (J + 1) ⟨s.1 + 1, by have := s.2; omega⟩)
        _ = ∑ s : Fin (k - 1),
              (((if r.1 = s.1 then H_diag else 0) +
                (if s.1 = r.1 + 1 then H_right else 0) +
                (if r.1 = s.1 + 1 then H_left else 0)) *
                δ ⟨s.1 + 1, by have := s.2; omega⟩) := by
            apply Finset.sum_congr rfl; intro s _
            exact congr_arg (· * δ ⟨s.1 + 1, by have := s.2; omega⟩) (hHess_decomp s)
        _ = (∑ s : Fin (k - 1),
              (if r.1 = s.1 then H_diag else 0) * δ ⟨s.1 + 1, by have := s.2; omega⟩) +
            (∑ s : Fin (k - 1),
              (if s.1 = r.1 + 1 then H_right else 0) * δ ⟨s.1 + 1, by have := s.2; omega⟩) +
            (∑ s : Fin (k - 1),
              (if r.1 = s.1 + 1 then H_left else 0) * δ ⟨s.1 + 1, by have := s.2; omega⟩) := by
            simp only [add_mul, Finset.sum_add_distrib]
        _ = H_diag * δ i_L.succ + H_right * δ i_R.succ + H_left * δ i_L.castSucc := by
            rw [hsum_diag, hsum_right, hsum_left]
    exact ⟨h_len_top, h_grad_top, h_slice_pos_zero⟩
  
  let p₁ : ℂ × ℂ := ((a₁ : ℂ), (δ₁ : ℂ))
  let p_ab : ℂ × ℂ := ((a₁ : ℂ), (a₁ : ℂ) + (δ₁ : ℂ))
  let U₀ : Set (ℂ × ℂ) := G.U_a ×ˢ G.U_d
  have hU₀_open : IsOpen U₀ := Metric.isOpen_ball.prod Metric.isOpen_ball
  have hp₁_U₀ : p₁ ∈ U₀ := by
    refine ⟨?_, ?_⟩
    · rw [PointGlancingChartData.U_a, Metric.mem_ball, Complex.dist_eq, ← Complex.ofReal_sub,
        Complex.norm_real, Real.norm_eq_abs, abs_lt]
      constructor <;> linarith [ha₁.1, ha₁.2, G.R_pos]
    · rw [PointGlancingChartData.U_d, Metric.mem_ball, dist_zero_right, Complex.norm_real,
        Real.norm_eq_abs, abs_of_pos hδ₁.1]
      linarith [hδ₁.2, G.δ_star_pos]
  have hp₁_trap : (a₁, δ₁) ∈ webTrapezoid G.a₀ G.R G.δ_star G.C₀ := by
    refine ⟨hδ₁.1, hδ₁.2, ?_⟩
    have habs : |a₁ - G.a₀| < G.R / 4 := abs_lt.mpr ⟨by linarith [ha₁.1], by linarith [ha₁.2]⟩
    have hmul : G.C₀ * δ₁ < G.C₀ * G.δ_star := mul_lt_mul_of_pos_left hδ₁.2 G.C₀_pos
    linarith [G.C₀_δ_star_lt, G.R_pos]
  have htrap := G.trapezoid_nondeg (a₁, δ₁) hp₁_trap
  let ℓ_star : Fin k → ℂ := fun i => G.ℓ_fn i p₁
  let x_star : Fin (k + 1) → ℂ := fun r => G.x_fn r p₁
  have hℓ_star_ne : ∀ i : Fin k, ℓ_star i ≠ 0 := by
    intro i h0
    have hre := (htrap.2.2.2.2.2.1 i).1
    change 0 < (ℓ_star i).re at hre
    rw [h0, Complex.zero_re] at hre
    exact lt_irrefl 0 hre
  have hHess_det_ne :
      (pointInteriorHess ℓ_star G.F (deriv G.F) (deriv (deriv G.F)) x_star).det ≠ 0 :=
    htrap.2.2.2.2.2.2.2.2
  let U_ell : Set (ℂ × ℂ) := U₀ ∩ ⋂ i : Fin k, (U₀ ∩ (G.ℓ_fn i) ⁻¹' ({0}ᶜ : Set ℂ))
  have hU_ell_open : IsOpen U_ell := by
    refine hU₀_open.inter (isOpen_iInter_of_finite fun i => ?_)
    exact (G.ℓ_holo_sq i).1.continuousOn.isOpen_inter_preimage hU₀_open isOpen_compl_singleton
  have hU_ell_sub : U_ell ⊆ U₀ := Set.inter_subset_left
  have hℓ_ne_on : ∀ q ∈ U_ell, ∀ i : Fin k, G.ℓ_fn i q ≠ 0 := by
    intro q hq i
    have hi := Set.mem_iInter.mp hq.2 i
    exact hi.2
  have hp₁_U_ell : p₁ ∈ U_ell :=
    ⟨hp₁_U₀, Set.mem_iInter.mpr fun i => ⟨hp₁_U₀, hℓ_star_ne i⟩⟩
  let K_pt : Subfield ℂ := pointBaseField C k G.Ψ a₁ δ₁
  let F_val : Subfield ℂ := E.F_val
  have hK_le_F : K_pt ≤ F_val := fun x hx => Subfield.subset_closure (Or.inl hx)
  have hrot_mem_K : ∀ (P : Fin 2 → ℂ),
      (∀ c : Fin 2, P c ∈ K_pt) → rotCoordX G.rotIdx P ∈ K_pt := by
    intro P hP
    rcases G.rotIdx with ⟨idx, hidx⟩
    interval_cases idx
    · exact hP 0
    · exact K_pt.neg_mem (hP 0)
    · exact hP 1
    · exact hP 1 |> K_pt.neg_mem
  have ha₁_mem_K : (a₁ : ℂ) ∈ K_pt := by
    have hleft := (G.Φ_left_inv p₁ hp₁_U₀).1
    change p₁.1 ∈ K_pt
    rw [← hleft]
    apply hrot_mem_K; intro c
    have hmem : pointJetFnAll C k (Sum.inl (0, c, 0, 0)) (G.Ψ p₁) ∈ K_pt :=
      Subfield.subset_closure (Or.inr ⟨Sum.inl (0, c, 0, 0), rfl⟩)
    simpa [pointJetFnAll, iterDerivYT, iterDerivY] using hmem
  have hb₁_mem_K : (a₁ : ℂ) + (δ₁ : ℂ) ∈ K_pt := by
    have hleft1 : pointChartACoord C G.rotIdx (G.Ψ p₁) = (a₁ : ℂ) := (G.Φ_left_inv p₁ hp₁_U₀).1
    have hleft2 : pointChartBCoord C k G.rotIdx (G.Ψ p₁) -
        pointChartACoord C G.rotIdx (G.Ψ p₁) = (δ₁ : ℂ) := (G.Φ_left_inv p₁ hp₁_U₀).2
    have hb_eq : pointChartBCoord C k G.rotIdx (G.Ψ p₁) = (a₁ : ℂ) + (δ₁ : ℂ) := by
      linear_combination hleft2 + hleft1
    rw [← hb_eq]
    apply hrot_mem_K; intro c
    have hmem : pointJetFnAll C k (Sum.inl (1, c, 0, 0)) (G.Ψ p₁) ∈ K_pt :=
      Subfield.subset_closure (Or.inr ⟨Sum.inl (1, c, 0, 0), rfl⟩)
    simpa [pointJetFnAll, iterDerivYT, iterDerivY] using hmem
  have hx_star_0 : x_star 0 = (a₁ : ℂ) := (G.x_endpoints p₁ hp₁_U₀).1
  have hx_star_last : x_star (Fin.last k) = (a₁ : ℂ) + (δ₁ : ℂ) := (G.x_endpoints p₁ hp₁_U₀).2

  
  have hNat_mem : ∀ (L : Subfield ℂ) (n : ℕ), (n : ℂ) ∈ L := by
    intro L n
    induction n with
    | zero => simpa using L.zero_mem
    | succ m ih => push_cast; exact L.add_mem ih L.one_mem
  let CoeffsIn : Subfield ℂ → MvPowerSeries (Fin 2) ℂ → Prop :=
    fun L S => ∀ d : Fin 2 →₀ ℕ, MvPowerSeries.coeff d S ∈ L
  have hCI_C : ∀ (L : Subfield ℂ) {c : ℂ}, c ∈ L → CoeffsIn L (MvPowerSeries.C c) := by
    intro L c hc d
    rw [MvPowerSeries.coeff_C]
    split_ifs
    · exact hc
    · exact L.zero_mem
  have hCI_X : ∀ (L : Subfield ℂ) (s : Fin 2), CoeffsIn L (MvPowerSeries.X s) := by
    intro L s d
    rw [MvPowerSeries.coeff_X]
    split_ifs
    · exact L.one_mem
    · exact L.zero_mem
  have hCI_add : ∀ (L : Subfield ℂ) {A B : MvPowerSeries (Fin 2) ℂ},
      CoeffsIn L A → CoeffsIn L B → CoeffsIn L (A + B) := by
    intro L A B hA hB d; rw [map_add]; exact L.add_mem (hA d) (hB d)
  have hCI_sub : ∀ (L : Subfield ℂ) {A B : MvPowerSeries (Fin 2) ℂ},
      CoeffsIn L A → CoeffsIn L B → CoeffsIn L (A - B) := by
    intro L A B hA hB d; rw [map_sub]; exact L.sub_mem (hA d) (hB d)
  have hCI_mul : ∀ (L : Subfield ℂ) {A B : MvPowerSeries (Fin 2) ℂ},
      CoeffsIn L A → CoeffsIn L B → CoeffsIn L (A * B) := by
    intro L A B hA hB d
    rw [MvPowerSeries.coeff_mul]
    exact L.sum_mem fun p _ => L.mul_mem (hA p.1) (hB p.2)
  have hCI_pow : ∀ (L : Subfield ℂ) {A : MvPowerSeries (Fin 2) ℂ} (n : ℕ),
      CoeffsIn L A → CoeffsIn L (A ^ n) := by
    intro L A n hA
    induction n with
    | zero =>
        intro d; rw [pow_zero, MvPowerSeries.coeff_one]
        split_ifs <;> [exact L.one_mem; exact L.zero_mem]
    | succ m ih => rw [pow_succ]; exact hCI_mul L ih hA
  have hCI_comp1D : ∀ (L : Subfield ℂ) {f : PowerSeries ℂ} {ψ : MvPowerSeries (Fin 2) ℂ},
      (∀ n : ℕ, PowerSeries.coeff n f ∈ L) → CoeffsIn L ψ →
      CoeffsIn L (compPowerSeries2D f ψ) := by
    intro L f ψ hf hψ d
    change ∑ n ∈ Finset.range (d 0 + d 1 + 1), _ ∈ L
    exact L.sum_mem fun n _ => L.mul_mem (hf n) (hCI_pow L n hψ d)
  have hCI_comp2D : ∀ (L : Subfield ℂ) {S Φ₀ Φ₁ : MvPowerSeries (Fin 2) ℂ},
      CoeffsIn L S → CoeffsIn L Φ₀ → CoeffsIn L Φ₁ →
      CoeffsIn L (pointArcComp2D S Φ₀ Φ₁) := by
    intro L S Φ₀ Φ₁ hS h0 h1 d
    change ∑ a ∈ Finset.range (d 0 + d 1 + 1), ∑ b ∈ Finset.range (d 0 + d 1 + 1), _ ∈ L
    exact L.sum_mem fun a _ => L.sum_mem fun b _ =>
      L.mul_mem (hS _) (hCI_mul L (hCI_pow L a h0) (hCI_pow L b h1) d)
  have hPsSqrt_mem : ∀ (L : Subfield ℂ),
      (∀ n : ℕ, PowerSeries.coeff n pointArcPsSqrt1p ∈ L) ∧
      (∀ n : ℕ, PowerSeries.coeff n pointArcPsInvSqrt1p ∈ L) := by
    intro L
    rcases hJet.psSqrt1p_laws with ⟨hS0, hI0, hS_sq, hSI⟩
    have hS0' : PowerSeries.coeff 0 pointArcPsSqrt1p = 1 := by
      rwa [PowerSeries.coeff_zero_eq_constantCoeff]
    have hI0' : PowerSeries.coeff 0 pointArcPsInvSqrt1p = 1 := by
      rwa [PowerSeries.coeff_zero_eq_constantCoeff]
    have hSS : pointArcPsSqrt1p * pointArcPsSqrt1p = 1 + PowerSeries.X := by
      simpa [sq] using hS_sq
    have h2_mem : (2 : ℂ) ∈ L := by
      simpa [one_add_one_eq_two] using L.add_mem L.one_mem L.one_mem
    have hS_mem : ∀ n : ℕ, PowerSeries.coeff n pointArcPsSqrt1p ∈ L := by
      intro n
      induction n using Nat.strong_induction_on with
      | h n ih =>
          cases n with
          | zero => rw [hS0']; exact L.one_mem
          | succ m =>
              have hmul := congr_arg (PowerSeries.coeff (m + 1)) hSS
              rw [PowerSeries.coeff_mul,
                Finset.Nat.sum_antidiagonal_eq_sum_range_succ
                  (fun a b => PowerSeries.coeff a pointArcPsSqrt1p *
                    PowerSeries.coeff b pointArcPsSqrt1p) (m + 1),
                Finset.sum_range_succ, Finset.sum_range_succ'] at hmul
              simp only [Nat.sub_self, Nat.sub_zero, hS0', one_mul, mul_one] at hmul
              have hmid_eq :
                  (∑ x ∈ Finset.range m,
                    PowerSeries.coeff (x + 1) pointArcPsSqrt1p *
                      PowerSeries.coeff (m + 1 - (x + 1)) pointArcPsSqrt1p) =
                  ∑ x ∈ Finset.range m,
                    PowerSeries.coeff (x + 1) pointArcPsSqrt1p *
                      PowerSeries.coeff (m - x) pointArcPsSqrt1p := by
                apply Finset.sum_congr rfl; intro x _; simp
              rw [hmid_eq] at hmul
              have hrhs_mem : PowerSeries.coeff (m + 1) (1 + PowerSeries.X : PowerSeries ℂ) ∈ L := by
                rw [map_add, PowerSeries.coeff_one, if_neg (Nat.succ_ne_zero m), zero_add,
                  PowerSeries.coeff_X]
                split_ifs
                · exact L.one_mem
                · exact L.zero_mem
              have hsum_mem :
                  (∑ x ∈ Finset.range m,
                    PowerSeries.coeff (x + 1) pointArcPsSqrt1p *
                      PowerSeries.coeff (m - x) pointArcPsSqrt1p) ∈ L := by
                refine L.sum_mem fun x hx => ?_
                have hxm : x < m := Finset.mem_range.mp hx
                exact L.mul_mem (ih (x + 1) (by omega)) (ih (m - x) (by omega))
              have hsolve : PowerSeries.coeff (m + 1) pointArcPsSqrt1p =
                  (PowerSeries.coeff (m + 1) (1 + PowerSeries.X : PowerSeries ℂ) -
                    ∑ x ∈ Finset.range m,
                      PowerSeries.coeff (x + 1) pointArcPsSqrt1p *
                        PowerSeries.coeff (m - x) pointArcPsSqrt1p) / 2 := by
                rw [eq_div_iff (by norm_num : (2 : ℂ) ≠ 0)]
                linear_combination hmul
              rw [hsolve]
              exact L.div_mem (L.sub_mem hrhs_mem hsum_mem) h2_mem
    have hI_mem : ∀ n : ℕ, PowerSeries.coeff n pointArcPsInvSqrt1p ∈ L := by
      intro n
      induction n using Nat.strong_induction_on with
      | h n ih =>
          cases n with
          | zero => rw [hI0']; exact L.one_mem
          | succ m =>
              have hmul := congr_arg (PowerSeries.coeff (m + 1)) hSI
              rw [PowerSeries.coeff_mul,
                Finset.Nat.sum_antidiagonal_eq_sum_range_succ
                  (fun a b => PowerSeries.coeff a pointArcPsSqrt1p *
                    PowerSeries.coeff b pointArcPsInvSqrt1p) (m + 1),
                Finset.sum_range_succ'] at hmul
              simp only [Nat.sub_zero, hS0', one_mul, PowerSeries.coeff_one,
                if_neg (Nat.succ_ne_zero m)] at hmul
              have hmid_eq :
                  (∑ x ∈ Finset.range (m + 1),
                    PowerSeries.coeff (x + 1) pointArcPsSqrt1p *
                      PowerSeries.coeff (m + 1 - (x + 1)) pointArcPsInvSqrt1p) =
                  ∑ x ∈ Finset.range (m + 1),
                    PowerSeries.coeff (x + 1) pointArcPsSqrt1p *
                      PowerSeries.coeff (m - x) pointArcPsInvSqrt1p := by
                apply Finset.sum_congr rfl; intro x _; simp
              rw [hmid_eq] at hmul
              have hsolve : PowerSeries.coeff (m + 1) pointArcPsInvSqrt1p =
                  -∑ x ∈ Finset.range (m + 1),
                    PowerSeries.coeff (x + 1) pointArcPsSqrt1p *
                      PowerSeries.coeff (m - x) pointArcPsInvSqrt1p := by
                linear_combination hmul
              rw [hsolve]
              refine L.neg_mem (L.sum_mem fun x _ => ?_)
              exact L.mul_mem (hS_mem (x + 1)) (ih (m - x) (by omega))
    exact ⟨hS_mem, hI_mem⟩

  have hHoloTaylor_deriv : ∀ (g : ℂ → ℂ) (z₀ : ℂ),
      pointArcHoloTaylor1D (deriv g) z₀ =
        PowerSeries.derivative (pointArcHoloTaylor1D g z₀) := by
    intro g z₀
    ext n
    rw [PowerSeries.coeff_derivative]
    simp only [pointArcHoloTaylor1D, holoTaylor1D, PowerSeries.coeff_mk]
    rw [iteratedDeriv_succ', Nat.factorial_succ, Nat.cast_mul, Nat.cast_add, Nat.cast_one]
    have hn1 : ((n : ℂ) + 1) ≠ 0 := by
      exact_mod_cast Nat.succ_ne_zero n
    field_simp [hn1]
  have hHoloTaylor_const : ∀ (g : ℂ → ℂ) (z₀ : ℂ),
      PowerSeries.constantCoeff (pointArcHoloTaylor1D g z₀) = g z₀ := by
    intro g z₀
    rw [← PowerSeries.coeff_zero_eq_constantCoeff]
    simp [pointArcHoloTaylor1D, holoTaylor1D]
  have htay_coeff0 : ∀ (f : ℂ × ℂ → ℂ) (p₀ : ℂ × ℂ),
      MvPowerSeries.coeff 0 (taylor2D f p₀) = f p₀ := by
    intro f p₀
    change taylor2D f p₀ 0 = f p₀
    simp [taylor2D, iterDerivYT, iterDerivY]
  have hcent_coeff0 : ∀ (ψ : ℂ × ℂ → ℂ) (p₀ : ℂ × ℂ),
      MvPowerSeries.coeff 0 (centeredTaylor2D ψ p₀) = 0 := by
    intro ψ p₀
    rw [centeredTaylor2D, htay_coeff0, sub_self]

  
  have hDiff_add : ∀ {U : Set (ℂ × ℂ)} {f g : ℂ × ℂ → ℂ},
      DifferentiableOn ℂ f U → DifferentiableOn ℂ g U →
      DifferentiableOn ℂ (fun q => f q + g q) U := fun hf hg => hf.add hg
  have hDiff_sub : ∀ {U : Set (ℂ × ℂ)} {f g : ℂ × ℂ → ℂ},
      DifferentiableOn ℂ f U → DifferentiableOn ℂ g U →
      DifferentiableOn ℂ (fun q => f q - g q) U := fun hf hg => hf.sub hg
  have hDiff_mul : ∀ {U : Set (ℂ × ℂ)} {f g : ℂ × ℂ → ℂ},
      DifferentiableOn ℂ f U → DifferentiableOn ℂ g U →
      DifferentiableOn ℂ (fun q => f q * g q) U := fun hf hg => hf.mul hg
  have hDiff_sq : ∀ {U : Set (ℂ × ℂ)} {f : ℂ × ℂ → ℂ},
      DifferentiableOn ℂ f U → DifferentiableOn ℂ (fun q => (f q) ^ 2) U := fun hf => hf.pow 2
  have hDiff_cube : ∀ {U : Set (ℂ × ℂ)} {f : ℂ × ℂ → ℂ},
      DifferentiableOn ℂ f U → DifferentiableOn ℂ (fun q => (f q) ^ 3) U := fun hf => hf.pow 3

  
  let f₀ : Fin (k + 1) → PowerSeries ℂ := fun r => pointArcHoloTaylor1D G.F (x_star r)
  let β₀ : Fin (k + 1) → MvPowerSeries (Fin 2) ℂ := fun r => centeredTaylor2D (G.x_fn r) p₁
  have hβ₀_coeff0 : ∀ r : Fin (k + 1), MvPowerSeries.coeff 0 (β₀ r) = 0 :=
    fun r => hcent_coeff0 (G.x_fn r) p₁
  have hcent_fst : centeredTaylor2D Prod.fst p₁ = MvPowerSeries.X 0 :=
    (hJet.taylor2D_linear_coords p₁).1
  have hcent_snd : centeredTaylor2D Prod.snd p₁ = MvPowerSeries.X 1 :=
    (hJet.taylor2D_linear_coords p₁).2
  have hcent_sum : centeredTaylor2D (fun q : ℂ × ℂ => q.1 + q.2) p₁ =
      MvPowerSeries.X 0 + MvPowerSeries.X 1 := by
    change taylor2D (fun q : ℂ × ℂ => (q.1 + q.2) - (p₁.1 + p₁.2)) p₁ = _
    rw [hJet.taylor2D_congr hU₀_open hp₁_U₀
      (f₂ := fun q : ℂ × ℂ => (q.1 - p₁.1) + (q.2 - p₁.2)) (fun q _ => by ring)]
    rw [(hJet.taylor2D_ring hU₀_open hp₁_U₀
      (hDiff_sub differentiable_fst.differentiableOn (differentiableOn_const _))
      (hDiff_sub differentiable_snd.differentiableOn (differentiableOn_const _))).1]
    exact congr_arg₂ (· + ·) hcent_fst hcent_snd
  have hβ₀_0 : β₀ 0 = MvPowerSeries.X 0 := by
    dsimp only [β₀, centeredTaylor2D]
    rw [hJet.taylor2D_congr hU₀_open hp₁_U₀ (f₂ := fun q : ℂ × ℂ => q.1 - p₁.1)
      (fun q hq => by
        simp only [PointGlancingChartData.x_fn, (G.x_endpoints q hq).1,
          (G.x_endpoints p₁ hp₁_U₀).1])]
    exact hcent_fst
  have hβ₀_last : β₀ (Fin.last k) = MvPowerSeries.X 0 + MvPowerSeries.X 1 := by
    dsimp only [β₀, centeredTaylor2D]
    rw [hJet.taylor2D_congr hU₀_open hp₁_U₀
      (f₂ := fun q : ℂ × ℂ => (q.1 + q.2) - (p₁.1 + p₁.2))
      (fun q hq => by
        simp only [PointGlancingChartData.x_fn, (G.x_endpoints q hq).2,
          (G.x_endpoints p₁ hp₁_U₀).2])]
    exact hcent_sum
  have htay_x : ∀ r : Fin (k + 1),
      taylor2D (G.x_fn r) p₁ = MvPowerSeries.C (x_star r) + β₀ r := by
    intro r
    rw [hJet.taylor2D_congr hU₀_open hp₁_U₀
      (f₂ := fun q => x_star r + (G.x_fn r q - x_star r)) (fun q _ => by ring)]
    rw [(hJet.taylor2D_ring hU₀_open hp₁_U₀ (differentiableOn_const _)
      (hDiff_sub (G.x_holo_maps r).1 (differentiableOn_const _))).1,
      hJet.taylor2D_const]
    rfl
  let U_ab : Set (ℂ × ℂ) := (fun q_ab : ℂ × ℂ => (q_ab.1, q_ab.2 - q_ab.1)) ⁻¹' U₀
  have h_unsh_diff : Differentiable ℂ (fun q_ab : ℂ × ℂ => (q_ab.1, q_ab.2 - q_ab.1)) :=
    differentiable_fst.prodMk (differentiable_snd.sub differentiable_fst)
  have hU_ab_open : IsOpen U_ab := hU₀_open.preimage h_unsh_diff.continuous
  have h_sh_maps : ∀ q ∈ U₀, (q.1, q.1 + q.2) ∈ U_ab := by
    intro q hq; change (q.1, (q.1 + q.2) - q.1) ∈ U₀; simpa using hq
  have hp_ab_unsh : (p_ab.1, p_ab.2 - p_ab.1) = p₁ := by
    ext <;> simp [p_ab, p₁]
  have hβ₀_mem : ∀ r : Fin (k + 1), CoeffsIn F_val (β₀ r) := by
    intro r
    let F_cent : ℂ × ℂ → ℂ := fun q_ab =>
      G.x_fn r (q_ab.1, q_ab.2 - q_ab.1) - G.x_fn r (p_ab.1, p_ab.2 - p_ab.1)
    have hF_cent_holo : DifferentiableOn ℂ F_cent U_ab :=
      hDiff_sub ((G.x_holo_maps r).1.comp h_unsh_diff.differentiableOn (fun _ h => h))
        (differentiableOn_const _)
    have hβ_eq : β₀ r = pointArcComp2D
        (centeredTaylor2D (fun q_ab => G.x_fn r (q_ab.1, q_ab.2 - q_ab.1)) p_ab)
        (MvPowerSeries.X 0) (MvPowerSeries.X 0 + MvPowerSeries.X 1) := by
      dsimp only [β₀, centeredTaylor2D]
      rw [hJet.taylor2D_congr hU₀_open hp₁_U₀
        (f₂ := fun q => F_cent (q.1, q.1 + q.2))
        (fun q _ => by dsimp [F_cent]; rw [add_sub_cancel_left, hp_ab_unsh])]
      have hc := hJet.taylor2D_comp_2D hU₀_open hU_ab_open hp₁_U₀
        differentiable_fst.differentiableOn
        (hDiff_add differentiable_fst.differentiableOn differentiable_snd.differentiableOn)
        hF_cent_holo h_sh_maps
      rw [hcent_fst, hcent_sum] at hc
      exact hc
    rw [hβ_eq]
    exact hCI_comp2D F_val (E.abscissa_ab_taylor_mem_F_val r)
      (hCI_X F_val 0) (hCI_add F_val (hCI_X F_val 0) (hCI_X F_val 1))

  have hF'_holo : DifferentiableOn ℂ (deriv G.F) G.W_F := G.F_holo.deriv G.W_F_open
  have hF''_holo : DifferentiableOn ℂ (deriv (deriv G.F)) G.W_F := hF'_holo.deriv G.W_F_open
  have hx_maps : ∀ q ∈ U₀, ∀ u : Fin (k + 1), G.x_fn u q ∈ G.W_F :=
    fun q hq u => ((G.x_holo_maps u).2 q hq).1
  have htay_F : ∀ u : Fin (k + 1),
      taylor2D (fun q => G.F (G.x_fn u q)) p₁ = compPowerSeries2D (f₀ u) (β₀ u) :=
    fun u => hJet.taylor2D_comp_1D hU₀_open G.W_F_open hp₁_U₀
      (G.x_holo_maps u).1 G.F_holo (fun q hq => hx_maps q hq u)
  have htay_F' : ∀ u : Fin (k + 1),
      taylor2D (fun q => deriv G.F (G.x_fn u q)) p₁ =
        compPowerSeries2D (PowerSeries.derivative (f₀ u)) (β₀ u) := by
    intro u
    rw [hJet.taylor2D_comp_1D hU₀_open G.W_F_open hp₁_U₀
      (G.x_holo_maps u).1 hF'_holo (fun q hq => hx_maps q hq u), hHoloTaylor_deriv]
  have htay_F'' : ∀ u : Fin (k + 1),
      taylor2D (fun q => deriv (deriv G.F) (G.x_fn u q)) p₁ =
        compPowerSeries2D (PowerSeries.derivative (PowerSeries.derivative (f₀ u))) (β₀ u) := by
    intro u
    rw [hJet.taylor2D_comp_1D hU₀_open G.W_F_open hp₁_U₀
      (G.x_holo_maps u).1 hF''_holo (fun q hq => hx_maps q hq u),
      hHoloTaylor_deriv, hHoloTaylor_deriv]

  
  have hx_holo_ell : ∀ u : Fin (k + 1), DifferentiableOn ℂ (G.x_fn u) U_ell :=
    fun u => (G.x_holo_maps u).1.mono hU_ell_sub
  have hFx_holo_ell : ∀ u : Fin (k + 1), DifferentiableOn ℂ (fun q => G.F (G.x_fn u q)) U_ell :=
    fun u => G.F_holo.comp (hx_holo_ell u) (fun q hq => hx_maps q (hU_ell_sub hq) u)
  have hF'x_holo_ell : ∀ u : Fin (k + 1),
      DifferentiableOn ℂ (fun q => deriv G.F (G.x_fn u q)) U_ell :=
    fun u => hF'_holo.comp (hx_holo_ell u) (fun q hq => hx_maps q (hU_ell_sub hq) u)
  have hF''x_holo_ell : ∀ u : Fin (k + 1),
      DifferentiableOn ℂ (fun q => deriv (deriv G.F) (G.x_fn u q)) U_ell :=
    fun u => hF''_holo.comp (hx_holo_ell u) (fun q hq => hx_maps q (hU_ell_sub hq) u)
  have hℓ_holo_ell : ∀ i : Fin k, DifferentiableOn ℂ (G.ℓ_fn i) U_ell :=
    fun i => (G.ℓ_holo_sq i).1.mono hU_ell_sub
  have hℓ_inv_holo_ell : ∀ i : Fin k, DifferentiableOn ℂ (fun q => (G.ℓ_fn i q)⁻¹) U_ell :=
    fun i => (hℓ_holo_ell i).inv (fun q hq => hℓ_ne_on q hq i)
  have htay_add_ell : ∀ {f g : ℂ × ℂ → ℂ},
      DifferentiableOn ℂ f U_ell → DifferentiableOn ℂ g U_ell →
      taylor2D (fun q => f q + g q) p₁ = taylor2D f p₁ + taylor2D g p₁ :=
    fun hf hg => (hJet.taylor2D_ring hU_ell_open hp₁_U_ell hf hg).1
  have htay_sub_ell : ∀ {f g : ℂ × ℂ → ℂ},
      DifferentiableOn ℂ f U_ell → DifferentiableOn ℂ g U_ell →
      taylor2D (fun q => f q - g q) p₁ = taylor2D f p₁ - taylor2D g p₁ :=
    fun hf hg => (hJet.taylor2D_ring hU_ell_open hp₁_U_ell hf hg).2.1
  have htay_mul_ell : ∀ {f g : ℂ × ℂ → ℂ},
      DifferentiableOn ℂ f U_ell → DifferentiableOn ℂ g U_ell →
      taylor2D (fun q => f q * g q) p₁ = taylor2D f p₁ * taylor2D g p₁ :=
    fun hf hg => (hJet.taylor2D_ring hU_ell_open hp₁_U_ell hf hg).2.2
  have htay_sq_ell : ∀ {f : ℂ × ℂ → ℂ},
      DifferentiableOn ℂ f U_ell →
      taylor2D (fun q => (f q) ^ 2) p₁ = (taylor2D f p₁) ^ 2 := by
    intro f hf
    rw [hJet.taylor2D_congr hU_ell_open hp₁_U_ell (f₂ := fun q => f q * f q)
      (fun q _ => sq (f q)), htay_mul_ell hf hf, ← sq]
  have htay_cube_ell : ∀ {f : ℂ × ℂ → ℂ},
      DifferentiableOn ℂ f U_ell →
      taylor2D (fun q => (f q) ^ 3) p₁ = (taylor2D f p₁) ^ 3 := by
    intro f hf
    rw [hJet.taylor2D_congr hU_ell_open hp₁_U_ell (f₂ := fun q => (f q) ^ 2 * f q)
      (fun q _ => pow_succ (f q) 2), htay_mul_ell (hDiff_sq hf) hf, htay_sq_ell hf, ← pow_succ]
  have htay_Dx : ∀ i : Fin k,
      taylor2D (fun q => G.x_fn i.succ q - G.x_fn i.castSucc q) p₁ =
        pointRecDx0 x_star β₀ i := by
    intro i
    rw [htay_sub_ell (hx_holo_ell i.succ) (hx_holo_ell i.castSucc),
      htay_x i.succ, htay_x i.castSucc]
    dsimp only [pointRecDx0]
    rw [map_sub]
    ring
  have htay_Dy : ∀ i : Fin k,
      taylor2D (fun q => G.F (G.x_fn i.succ q) - G.F (G.x_fn i.castSucc q)) p₁ =
        pointRecDy0 f₀ β₀ i := by
    intro i
    rw [htay_sub_ell (hFx_holo_ell i.succ) (hFx_holo_ell i.castSucc),
      htay_F i.succ, htay_F i.castSucc]
    rfl

  let L_tay : Fin k → MvPowerSeries (Fin 2) ℂ := fun i => taylor2D (G.ℓ_fn i) p₁
  let L_inv_tay : Fin k → MvPowerSeries (Fin 2) ℂ :=
    fun i => taylor2D (fun q => (G.ℓ_fn i q)⁻¹) p₁
  have hL_tay_sq : ∀ i : Fin k, (L_tay i) ^ 2 = pointRecEdgeSq0 x_star f₀ β₀ i := by
    intro i
    rw [← htay_sq_ell (hℓ_holo_ell i),
      hJet.taylor2D_congr hU_ell_open hp₁_U_ell
        (f₂ := fun q => (G.x_fn i.succ q - G.x_fn i.castSucc q) ^ 2 +
          (G.F (G.x_fn i.succ q) - G.F (G.x_fn i.castSucc q)) ^ 2)
        (fun q hq => (G.ℓ_holo_sq i).2 q (hU_ell_sub hq)),
      htay_add_ell (hDiff_sq (hDiff_sub (hx_holo_ell i.succ) (hx_holo_ell i.castSucc)))
        (hDiff_sq (hDiff_sub (hFx_holo_ell i.succ) (hFx_holo_ell i.castSucc))),
      htay_sq_ell (hDiff_sub (hx_holo_ell i.succ) (hx_holo_ell i.castSucc)),
      htay_sq_ell (hDiff_sub (hFx_holo_ell i.succ) (hFx_holo_ell i.castSucc)),
      htay_Dx i, htay_Dy i]
    rfl
  have hL_inv_mul : ∀ i : Fin k, L_inv_tay i * L_tay i = 1 := by
    intro i
    rw [← htay_mul_ell (hℓ_inv_holo_ell i) (hℓ_holo_ell i),
      hJet.taylor2D_congr hU_ell_open hp₁_U_ell (f₂ := fun _ => (1 : ℂ))
        (fun q hq => inv_mul_cancel₀ (hℓ_ne_on q hq i)),
      hJet.taylor2D_const, map_one]
  have hL_tay_c0 : ∀ i : Fin k, MvPowerSeries.coeff 0 (L_tay i) = ℓ_star i :=
    fun i => htay_coeff0 (G.ℓ_fn i) p₁
  have hL_tay_eq : ∀ i : Fin k, L_tay i = pointRecLen0 ℓ_star x_star f₀ β₀ i := by
    intro i
    exact (hSqrt.unit_sqrt_2D (ℓ_star i) (pointRecEdgeSq0 x_star f₀ β₀ i)
      (L_tay i) (L_inv_tay i) (hℓ_star_ne i) (hL_tay_sq i) (hL_inv_mul i) (hL_tay_c0 i)).2.1
  have hL_inv_tay_eq : ∀ i : Fin k, L_inv_tay i = pointRecInvLen0 ℓ_star x_star f₀ β₀ i := by
    intro i
    exact (hSqrt.unit_sqrt_2D (ℓ_star i) (pointRecEdgeSq0 x_star f₀ β₀ i)
      (L_tay i) (L_inv_tay i) (hℓ_star_ne i) (hL_tay_sq i) (hL_inv_mul i) (hL_tay_c0 i)).2.2

  
  have hf₀_mem : ∀ (u : Fin (k + 1)) (n : ℕ), PowerSeries.coeff n (f₀ u) ∈ F_val := by
    intro u n
    simp only [f₀, pointArcHoloTaylor1D, holoTaylor1D, PowerSeries.coeff_mk]
    exact F_val.div_mem (E.graph_jets_mem_F_val u n) (hNat_mem F_val n.factorial)
  have hf₀'_mem : ∀ (u : Fin (k + 1)) (n : ℕ),
      PowerSeries.coeff n (PowerSeries.derivative (f₀ u)) ∈ F_val := by
    intro u n
    rw [PowerSeries.coeff_derivative]
    exact F_val.mul_mem (hf₀_mem u (n + 1))
      (F_val.add_mem (hNat_mem F_val n) F_val.one_mem)
  have hDx0_mem : ∀ i : Fin k, CoeffsIn F_val (pointRecDx0 x_star β₀ i) := by
    intro i
    exact hCI_add F_val
      (hCI_C F_val (F_val.sub_mem (E.abscissa_mem_F_val i.succ) (E.abscissa_mem_F_val i.castSucc)))
      (hCI_sub F_val (hβ₀_mem i.succ) (hβ₀_mem i.castSucc))
  have hDy0_mem : ∀ i : Fin k, CoeffsIn F_val (pointRecDy0 f₀ β₀ i) := by
    intro i
    exact hCI_sub F_val
      (hCI_comp1D F_val (hf₀_mem i.succ) (hβ₀_mem i.succ))
      (hCI_comp1D F_val (hf₀_mem i.castSucc) (hβ₀_mem i.castSucc))
  have hEdgeSq0_mem : ∀ i : Fin k, CoeffsIn F_val (pointRecEdgeSq0 x_star f₀ β₀ i) :=
    fun i => hCI_add F_val (hCI_pow F_val 2 (hDx0_mem i)) (hCI_pow F_val 2 (hDy0_mem i))
  have hEdgeRel0_mem : ∀ i : Fin k, CoeffsIn F_val (pointRecEdgeRel0 ℓ_star x_star f₀ β₀ i) := by
    intro i
    exact hCI_mul F_val
      (hCI_sub F_val (hEdgeSq0_mem i)
        (hCI_C F_val (F_val.pow_mem (E.chord_len_mem_F_val i) 2)))
      (hCI_C F_val (F_val.inv_mem (F_val.pow_mem (E.chord_len_mem_F_val i) 2)))
  have hL_tay_mem : ∀ i : Fin k, CoeffsIn F_val (L_tay i) := by
    intro i
    rw [hL_tay_eq i]
    exact hCI_mul F_val (hCI_C F_val (E.chord_len_mem_F_val i))
      (hCI_comp1D F_val (hPsSqrt_mem F_val).1 (hEdgeRel0_mem i))
  have hL_inv_tay_mem : ∀ i : Fin k, CoeffsIn F_val (L_inv_tay i) := by
    intro i
    rw [hL_inv_tay_eq i]
    exact hCI_mul F_val (hCI_C F_val (F_val.inv_mem (E.chord_len_mem_F_val i)))
      (hCI_comp1D F_val (hPsSqrt_mem F_val).2 (hEdgeRel0_mem i))

  
  have hRelEdgeLen_eq : ∀ q ∈ U_ell, ∀ i : Fin k,
      pointRelEdgeLen (fun j => G.ℓ_fn j q) (fun _ => G.F) (fun s => G.x_fn s q) i =
        G.ℓ_fn i q := by
    intro q hq i
    dsimp only [pointRelEdgeLen]
    rw [← (G.ℓ_holo_sq i).2 q (hU_ell_sub hq), sub_self, zero_div]
    simp [sqrt1p]
  have htay_w_web : ∀ r : Fin (k + 1),
      taylor2D (G.w_web r) p₁ =
        if h : r.1 < k - 1 then pointRecWeight0 ℓ_star x_star f₀ β₀ ⟨r.1, h⟩ else -1 := by
    intro r
    by_cases hr : r.1 < k - 1
    · rw [dif_pos hr]
      let i_L : Fin k := ⟨r.1, by omega⟩
      let i_R : Fin k := ⟨r.1 + 1, by omega⟩
      have hw_eq : ∀ q ∈ U_ell, G.w_web r q =
          (G.F (G.x_fn i_L.succ q) - G.F (G.x_fn i_L.castSucc q)) * (G.ℓ_fn i_L q)⁻¹ -
          (G.F (G.x_fn i_R.succ q) - G.F (G.x_fn i_R.castSucc q)) * (G.ℓ_fn i_R q)⁻¹ := by
        intro q _
        dsimp only [PointGlancingChartData.w_web, pointChartWWeb, PointGlancingChartData.x_fn,
          i_L, i_R]
        rw [dif_pos hr, div_eq_mul_inv, div_eq_mul_inv]
        rfl
      rw [hJet.taylor2D_congr hU_ell_open hp₁_U_ell hw_eq,
        htay_sub_ell
          (hDiff_mul (hDiff_sub (hFx_holo_ell i_L.succ) (hFx_holo_ell i_L.castSucc))
            (hℓ_inv_holo_ell i_L))
          (hDiff_mul (hDiff_sub (hFx_holo_ell i_R.succ) (hFx_holo_ell i_R.castSucc))
            (hℓ_inv_holo_ell i_R)),
        htay_mul_ell (hDiff_sub (hFx_holo_ell i_L.succ) (hFx_holo_ell i_L.castSucc))
          (hℓ_inv_holo_ell i_L),
        htay_mul_ell (hDiff_sub (hFx_holo_ell i_R.succ) (hFx_holo_ell i_R.castSucc))
          (hℓ_inv_holo_ell i_R),
        htay_Dy i_L, htay_Dy i_R]
      change _ * L_inv_tay i_L - _ * L_inv_tay i_R = _
      rw [hL_inv_tay_eq i_L, hL_inv_tay_eq i_R]
      rfl
    · rw [dif_neg hr]
      have hw_eq : ∀ q ∈ U_ell, G.w_web r q = (-1 : ℂ) := by
        intro q _; simp [PointGlancingChartData.w_web, pointChartWWeb, hr]
      rw [hJet.taylor2D_congr hU_ell_open hp₁_U_ell hw_eq, hJet.taylor2D_const, map_neg, map_one]
  have htay_ψ_web : ∀ r : Fin (k + 1),
      centeredTaylor2D (G.ψ_web r) p₁ =
        if h : r.1 < k - 1 then β₀ ⟨r.1 + 1, by omega⟩
        else if r.1 = k - 1 then MvPowerSeries.X 0
        else MvPowerSeries.X 0 + MvPowerSeries.X 1 := by
    intro r
    by_cases hr : r.1 < k - 1
    · rw [dif_pos hr]
      have hfn : G.ψ_web r = G.x_fn ⟨r.1 + 1, by omega⟩ := by
        ext q; simp [PointGlancingChartData.ψ_web, pointChartPsiWeb, hr, PointGlancingChartData.x_fn]
      rw [hfn]
    · rw [dif_neg hr]
      by_cases hr_eq : r.1 = k - 1
      · rw [if_pos hr_eq]
        have hfn : G.ψ_web r = Prod.fst := by
          ext q; simp [PointGlancingChartData.ψ_web, pointChartPsiWeb, hr, hr_eq]
        rw [hfn]; exact hcent_fst
      · rw [if_neg hr_eq]
        have hfn : G.ψ_web r = fun q : ℂ × ℂ => q.1 + q.2 := by
          ext q; simp [PointGlancingChartData.ψ_web, pointChartPsiWeb, hr, hr_eq]
        rw [hfn]; exact hcent_sum
  have hGrad0_eq_zero : ∀ r : Fin (k - 1), pointRecGrad0 ℓ_star x_star f₀ β₀ r = 0 := by
    intro r
    let i_L : Fin k := ⟨r.1, by have := r.2; omega⟩
    let i_R : Fin k := ⟨r.1 + 1, by have := r.2; omega⟩
    have hgrad_on : ∀ q ∈ U_ell,
        ((G.x_fn i_L.succ q - G.x_fn i_L.castSucc q) +
          (G.F (G.x_fn i_L.succ q) - G.F (G.x_fn i_L.castSucc q)) *
            deriv G.F (G.x_fn i_L.succ q)) * (G.ℓ_fn i_L q)⁻¹ -
        ((G.x_fn i_R.succ q - G.x_fn i_R.castSucc q) +
          (G.F (G.x_fn i_R.succ q) - G.F (G.x_fn i_R.castSucc q)) *
            deriv G.F (G.x_fn i_R.castSucc q)) * (G.ℓ_fn i_R q)⁻¹ = 0 := by
      intro q hq
      have hstat := G.stationary_on_nondeg q (hU_ell_sub hq) (hℓ_ne_on q hq) r
      dsimp only [pointRelInteriorGrad] at hstat
      rw [hRelEdgeLen_eq q hq i_L, hRelEdgeLen_eq q hq i_R,
        div_eq_mul_inv, div_eq_mul_inv] at hstat
      exact hstat
    have hL_num_holo : DifferentiableOn ℂ
        (fun q => (G.x_fn i_L.succ q - G.x_fn i_L.castSucc q) +
          (G.F (G.x_fn i_L.succ q) - G.F (G.x_fn i_L.castSucc q)) *
            deriv G.F (G.x_fn i_L.succ q)) U_ell :=
      hDiff_add (hDiff_sub (hx_holo_ell i_L.succ) (hx_holo_ell i_L.castSucc))
        (hDiff_mul (hDiff_sub (hFx_holo_ell i_L.succ) (hFx_holo_ell i_L.castSucc))
          (hF'x_holo_ell i_L.succ))
    have hR_num_holo : DifferentiableOn ℂ
        (fun q => (G.x_fn i_R.succ q - G.x_fn i_R.castSucc q) +
          (G.F (G.x_fn i_R.succ q) - G.F (G.x_fn i_R.castSucc q)) *
            deriv G.F (G.x_fn i_R.castSucc q)) U_ell :=
      hDiff_add (hDiff_sub (hx_holo_ell i_R.succ) (hx_holo_ell i_R.castSucc))
        (hDiff_mul (hDiff_sub (hFx_holo_ell i_R.succ) (hFx_holo_ell i_R.castSucc))
          (hF'x_holo_ell i_R.castSucc))
    have htay0 := hJet.taylor2D_congr hU_ell_open hp₁_U_ell hgrad_on
    rw [hJet.taylor2D_const, map_zero] at htay0
    rw [htay_sub_ell (hDiff_mul hL_num_holo (hℓ_inv_holo_ell i_L))
      (hDiff_mul hR_num_holo (hℓ_inv_holo_ell i_R)),
      htay_mul_ell hL_num_holo (hℓ_inv_holo_ell i_L),
      htay_mul_ell hR_num_holo (hℓ_inv_holo_ell i_R),
      htay_add_ell (hDiff_sub (hx_holo_ell i_L.succ) (hx_holo_ell i_L.castSucc))
        (hDiff_mul (hDiff_sub (hFx_holo_ell i_L.succ) (hFx_holo_ell i_L.castSucc))
          (hF'x_holo_ell i_L.succ)),
      htay_add_ell (hDiff_sub (hx_holo_ell i_R.succ) (hx_holo_ell i_R.castSucc))
        (hDiff_mul (hDiff_sub (hFx_holo_ell i_R.succ) (hFx_holo_ell i_R.castSucc))
          (hF'x_holo_ell i_R.castSucc)),
      htay_mul_ell (hDiff_sub (hFx_holo_ell i_L.succ) (hFx_holo_ell i_L.castSucc))
        (hF'x_holo_ell i_L.succ),
      htay_mul_ell (hDiff_sub (hFx_holo_ell i_R.succ) (hFx_holo_ell i_R.castSucc))
        (hF'x_holo_ell i_R.castSucc),
      htay_Dx i_L, htay_Dy i_L, htay_F' i_L.succ,
      htay_Dx i_R, htay_Dy i_R, htay_F' i_R.castSucc] at htay0
    change _ * L_inv_tay i_L - _ * L_inv_tay i_R = 0 at htay0
    rw [hL_inv_tay_eq i_L, hL_inv_tay_eq i_R] at htay0
    exact htay0

  have htay_mul_inv_cube : ∀ {num : ℂ × ℂ → ℂ},
      DifferentiableOn ℂ num U_ell → ∀ i : Fin k,
      taylor2D (fun q => num q * ((G.ℓ_fn i q)⁻¹) ^ 3) p₁ =
        taylor2D num p₁ * (pointRecInvLen0 ℓ_star x_star f₀ β₀ i) ^ 3 := by
    intro num hnum i
    rw [htay_mul_ell hnum (hDiff_cube (hℓ_inv_holo_ell i)),
      htay_cube_ell (hℓ_inv_holo_ell i)]
    change taylor2D num p₁ * (L_inv_tay i) ^ 3 = _
    rw [hL_inv_tay_eq i]
  have htay_Hess : ∀ (r s : Fin (k - 1)),
      taylor2D
        (fun q => pointInteriorHess (fun i => G.ℓ_fn i q) G.F (deriv G.F) (deriv (deriv G.F))
          (fun u => G.x_fn u q) r s) p₁ =
        pointRecHess0 ℓ_star x_star f₀ β₀ r s := by
    intro r s
    let i_L : Fin k := ⟨r.1, by have := r.2; omega⟩
    let i_R : Fin k := ⟨r.1 + 1, by have := r.2; omega⟩
    have hdx_holo : ∀ i : Fin k, DifferentiableOn ℂ
        (fun q => G.x_fn i.succ q - G.x_fn i.castSucc q) U_ell :=
      fun i => hDiff_sub (hx_holo_ell i.succ) (hx_holo_ell i.castSucc)
    have hdy_holo : ∀ i : Fin k, DifferentiableOn ℂ
        (fun q => G.F (G.x_fn i.succ q) - G.F (G.x_fn i.castSucc q)) U_ell :=
      fun i => hDiff_sub (hFx_holo_ell i.succ) (hFx_holo_ell i.castSucc)
    have hn_holo : ∀ (i : Fin k) (u : Fin (k + 1)), DifferentiableOn ℂ
        (fun q => (G.x_fn i.succ q - G.x_fn i.castSucc q) +
          (G.F (G.x_fn i.succ q) - G.F (G.x_fn i.castSucc q)) * deriv G.F (G.x_fn u q)) U_ell :=
      fun i u => hDiff_add (hdx_holo i) (hDiff_mul (hdy_holo i) (hF'x_holo_ell u))
    have htay_n : ∀ (i : Fin k) (u : Fin (k + 1)),
        taylor2D (fun q => (G.x_fn i.succ q - G.x_fn i.castSucc q) +
          (G.F (G.x_fn i.succ q) - G.F (G.x_fn i.castSucc q)) * deriv G.F (G.x_fn u q)) p₁ =
        pointRecDx0 x_star β₀ i +
          pointRecDy0 f₀ β₀ i * compPowerSeries2D (PowerSeries.derivative (f₀ u)) (β₀ u) := by
      intro i u
      rw [htay_add_ell (hdx_holo i) (hDiff_mul (hdy_holo i) (hF'x_holo_ell u)),
        htay_mul_ell (hdy_holo i) (hF'x_holo_ell u), htay_Dx i, htay_Dy i, htay_F' u]
    by_cases h1 : r.1 = s.1
    · have hfn : ∀ q ∈ U_ell, pointInteriorHess (fun i => G.ℓ_fn i q) G.F (deriv G.F)
          (deriv (deriv G.F)) (fun u => G.x_fn u q) r s =
            (((1 + deriv G.F (G.x_fn i_L.succ q) ^ 2 +
                (G.F (G.x_fn i_L.succ q) - G.F (G.x_fn i_L.castSucc q)) *
                  deriv (deriv G.F) (G.x_fn i_L.succ q)) * (G.ℓ_fn i_L q) ^ 2 -
              ((G.x_fn i_L.succ q - G.x_fn i_L.castSucc q) +
                (G.F (G.x_fn i_L.succ q) - G.F (G.x_fn i_L.castSucc q)) *
                  deriv G.F (G.x_fn i_L.succ q)) ^ 2) * ((G.ℓ_fn i_L q)⁻¹) ^ 3) +
            (((1 + deriv G.F (G.x_fn i_R.castSucc q) ^ 2 -
                (G.F (G.x_fn i_R.succ q) - G.F (G.x_fn i_R.castSucc q)) *
                  deriv (deriv G.F) (G.x_fn i_R.castSucc q)) * (G.ℓ_fn i_R q) ^ 2 -
              ((G.x_fn i_R.succ q - G.x_fn i_R.castSucc q) +
                (G.F (G.x_fn i_R.succ q) - G.F (G.x_fn i_R.castSucc q)) *
                  deriv G.F (G.x_fn i_R.castSucc q)) ^ 2) * ((G.ℓ_fn i_R q)⁻¹) ^ 3) := by
        intro q _; dsimp only [pointInteriorHess]
        rw [if_pos h1, div_eq_mul_inv, inv_pow, div_eq_mul_inv, inv_pow]
      rw [hJet.taylor2D_congr hU_ell_open hp₁_U_ell hfn]
      have hnumL_holo : DifferentiableOn ℂ
          (fun q => (1 + deriv G.F (G.x_fn i_L.succ q) ^ 2 +
              (G.F (G.x_fn i_L.succ q) - G.F (G.x_fn i_L.castSucc q)) *
                deriv (deriv G.F) (G.x_fn i_L.succ q)) * (G.ℓ_fn i_L q) ^ 2 -
            ((G.x_fn i_L.succ q - G.x_fn i_L.castSucc q) +
              (G.F (G.x_fn i_L.succ q) - G.F (G.x_fn i_L.castSucc q)) *
                deriv G.F (G.x_fn i_L.succ q)) ^ 2) U_ell :=
        hDiff_sub
          (hDiff_mul
            (hDiff_add (hDiff_add (differentiableOn_const (1 : ℂ)) (hDiff_sq (hF'x_holo_ell i_L.succ)))
              (hDiff_mul (hdy_holo i_L) (hF''x_holo_ell i_L.succ)))
            (hDiff_sq (hℓ_holo_ell i_L)))
          (hDiff_sq (hn_holo i_L i_L.succ))
      have hnumR_holo : DifferentiableOn ℂ
          (fun q => (1 + deriv G.F (G.x_fn i_R.castSucc q) ^ 2 -
              (G.F (G.x_fn i_R.succ q) - G.F (G.x_fn i_R.castSucc q)) *
                deriv (deriv G.F) (G.x_fn i_R.castSucc q)) * (G.ℓ_fn i_R q) ^ 2 -
            ((G.x_fn i_R.succ q - G.x_fn i_R.castSucc q) +
              (G.F (G.x_fn i_R.succ q) - G.F (G.x_fn i_R.castSucc q)) *
                deriv G.F (G.x_fn i_R.castSucc q)) ^ 2) U_ell :=
        hDiff_sub
          (hDiff_mul
            (hDiff_sub (hDiff_add (differentiableOn_const (1 : ℂ)) (hDiff_sq (hF'x_holo_ell i_R.castSucc)))
