      exact False.elim (hmem (Finset.mem_range.mpr (by omega)))
  have hDslope_at_center : ∀ (n : ℕ) {W : Set ℂ} (hW : IsOpen W) {z₀ : ℂ} (hz₀ : z₀ ∈ W)
      {G : ℂ → ℂ} (hG : DifferentiableOn ℂ G W),
      lineCoalescingDslopeIter G z₀ n z₀ = PowerSeries.coeff n (holoTaylor1D G z₀) := by
    intro n
    induction n with
    | zero =>
        intro W _ z₀ _ G _
        simp [lineCoalescingDslopeIter, holoTaylor1D]
    | succ n ih =>
        intro W hW z₀ hz₀ G hG
        rw [hDslope_comm, ih hW hz₀ ((Complex.differentiableOn_dslope (hW.mem_nhds hz₀)).mpr hG)]
        simp only [holoTaylor1D, PowerSeries.coeff_mk]
        rw [hIterDeriv_dslope hW hz₀ hG n, Nat.factorial_succ, Nat.cast_mul]
        have hn1 : ((n + 1 : ℕ) : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
        exact (mul_div_mul_left _ _ hn1).symm
  have hDslope_taylor : ∀ {W : Set ℂ} (hW : IsOpen W) {z₀ : ℂ} (hz₀ : z₀ ∈ W)
      {G : ℂ → ℂ} (hG : DifferentiableOn ℂ G W) (M : ℕ) (z : ℂ),
      G z = (∑ n ∈ Finset.range (M + 1),
        PowerSeries.coeff n (holoTaylor1D G z₀) * (z - z₀) ^ n) +
        (z - z₀) ^ (M + 1) * lineCoalescingDslopeIter G z₀ (M + 1) z := by
    intro W hW z₀ hz₀ G hG M z
    induction M with
    | zero =>
        simp only [Finset.range_one, Finset.sum_singleton, pow_zero, mul_one, zero_add, pow_one,
          ← hDslope_at_center 0 hW hz₀ hG]
        have hsub := sub_smul_dslope G z₀ z
        simp only [smul_eq_mul] at hsub
        change G z = G z₀ + (z - z₀) * dslope G z₀ z
        linear_combination -hsub
    | succ M ih =>
        have hsub := sub_smul_dslope (lineCoalescingDslopeIter G z₀ (M + 1)) z₀ z
        simp only [smul_eq_mul] at hsub
        have hstep : lineCoalescingDslopeIter G z₀ (M + 1) z =
            PowerSeries.coeff (M + 1) (holoTaylor1D G z₀) +
              (z - z₀) * lineCoalescingDslopeIter G z₀ (M + 2) z := by
          rw [← hDslope_at_center (M + 1) hW hz₀ hG]
          change lineCoalescingDslopeIter G z₀ (M + 1) z =
            lineCoalescingDslopeIter G z₀ (M + 1) z₀ +
              (z - z₀) * dslope (lineCoalescingDslopeIter G z₀ (M + 1)) z₀ z
          linear_combination -hsub
        rw [Finset.sum_range_succ, ih, hstep]
        ring
  have hHolo_comp : ∀ {W : Set ℂ} (hW : IsOpen W) {z₀ : ℂ} (hz₀ : z₀ ∈ W)
      {G : ℂ → ℂ} (hG : DifferentiableOn ℂ G W) {z_fn : ℂ → ℂ}
      (hz : paJetHoloAtZero z_fn) (hz0 : z_fn 0 = 0),
      paJetHoloAtZero (fun ε => G (z₀ + z_fn ε)) ∧
      holoTaylor1D (fun ε => G (z₀ + z_fn ε)) 0 =
        pointArcPolyComp (holoTaylor1D G z₀) (holoTaylor1D z_fn 0) := by
    intro W hW z₀ hz₀ G hG z_fn hz hz0
    have hcomp_holo : ∀ {H : ℂ → ℂ}, DifferentiableOn ℂ H W →
        paJetHoloAtZero (fun ε => H (z₀ + z_fn ε)) := by
      intro H hH
      rcases hz with ⟨⟨U_z, hUz, h0_Uz, hdz⟩⟩
      let U' : Set ℂ := U_z ∩ (fun ε => z₀ + z_fn ε) ⁻¹' W
      have hcont : ContinuousOn (fun ε => z₀ + z_fn ε) U_z :=
        continuousOn_const.add hdz.continuousOn
      have hU'_open : IsOpen U' := hcont.isOpen_inter_preimage hUz hW
      have h0_U' : (0 : ℂ) ∈ U' := ⟨h0_Uz, by simp [hz0, hz₀]⟩
