  have h_eq_deriv_m_raw :
      ((S.c * t ^ 3 : ℝ) : ℂ) * (((t⁻¹ : ℝ) : ℂ) * deriv g_m J_m) =
        ((g_arc v₀ * (1 - Real.cos (θ_m - ϕ_0)) : ℝ) : ℂ) :=
    (hscaled_m.congr_of_eventuallyEq hev_m.symm).unique hArcChord_m.ofReal_comp
  have h_eq_deriv_m :
      ((S.c * t ^ 2 : ℝ) : ℂ) * deriv g_m J_m =
        ((g_arc v₀ * (1 - Real.cos (θ_m - ϕ_0)) : ℝ) : ℂ) := by
    have hsimp : ((S.c * t ^ 3 : ℝ) : ℂ) * (((t⁻¹ : ℝ) : ℂ) * deriv g_m J_m) =
        ((S.c * t ^ 2 : ℝ) : ℂ) * deriv g_m J_m := by
      push_cast
      field_simp [ht_ℂ_ne]
    rwa [hsimp] at h_eq_deriv_m_raw
  
  let P_t : ℂ × ℂ → ℂ := fun q => smallChordActionP (sfcaStripPhi S) q.1 q.2 (t : ℂ)
  have htJp : (t : ℂ) * J_p = s_p - s_0 := mul_div_cancel₀ _ ht_ℂ_ne
  have hPhi_p_diff : DifferentiableAt ℂ (sfcaStripPhi S) (s_0, (t : ℂ) * J_p) :=
    hHolo.differentiableAt (hOpen.mem_nhds (by rw [htJp]; exact hdom_p))
  have hpair_p : DifferentiableAt ℂ (fun q : ℂ × ℂ => (q.1, (t : ℂ) * q.2)) (s_0, J_p) := by
    fun_prop
  have hq2_pow : DifferentiableAt ℂ (fun q : ℂ × ℂ => q.2 ^ 3) (s_0, J_p) := by
    fun_prop
  have hP_raw := hq2_pow.mul (hPhi_p_diff.comp (s_0, J_p) hpair_p)
  have hP_diff : DifferentiableAt ℂ P_t (s_0, J_p) := hP_raw
  let L : (ℂ × ℂ) →L[ℂ] ℂ := fderiv ℂ P_t (s_0, J_p)
  have hP : HasFDerivAt P_t L (s_0, J_p) := hP_diff.hasFDerivAt
  have hdJ : deriv (fun J' => smallChordActionP (sfcaStripPhi S) s_0 J' (t : ℂ)) J_p =
      L (0, 1) := by
    have hp : HasDerivAt (fun J' : ℂ => (s_0, J')) (0, 1) J_p :=
      (hasDerivAt_const J_p s_0).prodMk (hasDerivAt_id J_p)
    exact (hP.comp_hasDerivAt J_p hp).deriv
  have hds : deriv (fun s' => smallChordActionP (sfcaStripPhi S) s' J_p (t : ℂ)) s_0 =
      L (1, 0) := by
    have hp : HasDerivAt (fun s' : ℂ => (s', J_p)) (1, 0) s_0 :=
      (hasDerivAt_id s_0).prodMk (hasDerivAt_const s_0 J_p)
    exact (hP.comp_hasDerivAt s_0 hp).deriv
  let γ_p : ℝ → ℂ × ℂ := fun u => ((u : ℂ), (((w₀ - u) / t : ℝ) : ℂ))
  have hγ_eq : γ_p v₀ = (s_0, J_p) := Prod.ext hv₀_eq hJp_eq
  have h_u1 : HasDerivAt (fun u : ℝ => (u : ℂ)) 1 v₀ := by
    simpa using (hasDerivAt_id v₀).ofReal_comp
  have h_u2_R : HasDerivAt (fun u : ℝ => (w₀ - u) / t) (-t⁻¹) v₀ := by
    have hsub : HasDerivAt (fun u : ℝ => w₀ - u) (-1) v₀ :=
      (hasDerivAt_id v₀).const_sub w₀
    simpa [neg_div, one_div] using hsub.div_const t
  have h_u2 : HasDerivAt (fun u : ℝ => (((w₀ - u) / t : ℝ) : ℂ)) (-(t : ℂ)⁻¹) v₀ := by
    simpa using h_u2_R.ofReal_comp
  have hγ_deriv : HasDerivAt γ_p (1, -(t : ℂ)⁻¹) v₀ := h_u1.prodMk h_u2
  have hP_R : HasFDerivAt P_t (L.restrictScalars ℝ) (γ_p v₀) := by
    rw [hγ_eq]
    exact hP.restrictScalars ℝ
  have hcomp_p_raw := hP_R.comp_hasDerivAt v₀ hγ_deriv
  have hL_val : (L.restrictScalars ℝ) (1, -(t : ℂ)⁻¹) = L (1, 0) - (t : ℂ)⁻¹ * L (0, 1) := by
    rw [ContinuousLinearMap.coe_restrictScalars']
    have h_vec : ((1 : ℂ), -(t : ℂ)⁻¹) = (1, 0) - (t : ℂ)⁻¹ • ((0 : ℂ), (1 : ℂ)) := by
      ext <;> simp
    rw [h_vec, L.map_sub, L.map_smul, smul_eq_mul]
  have hcomp_p : HasDerivAt (fun u : ℝ => P_t (γ_p u))
      (L (1, 0) - (t : ℂ)⁻¹ * L (0, 1)) v₀ := by
    simpa [Function.comp_def, hL_val] using hcomp_p_raw
  
  let V_p : Set ℝ :=
    Set.Iio w₀ ∩
      (fun u : ℝ => ((u : ℂ), ((w₀ - u : ℝ) : ℂ))) ⁻¹' (smallChordDomain S sfcaEtaSL)
  have hVp_open : IsOpen V_p := by
    refine isOpen_Iio.inter (hOpen.preimage ?_)
    exact Complex.continuous_ofReal.prodMk
      (Complex.continuous_ofReal.comp (continuous_const.sub continuous_id))
  have hv₀_Vp : v₀ ∈ V_p := by
    refine ⟨hv₀_lt_w₀, ?_⟩
    change ((v₀ : ℂ), ((w₀ - v₀ : ℝ) : ℂ)) ∈ smallChordDomain S sfcaEtaSL
    rw [Complex.ofReal_sub, hv₀_eq, hw₀_eq]
    exact hdom_p
  have h_eq_Vp : ∀ u ∈ V_p,
      ((S.c * t ^ 3 : ℝ) : ℂ) * P_t (γ_p u) =
        (sgaRealArcMinusChord S u w₀ : ℂ) := by
    intro u hu
    dsimp only [P_t, γ_p, smallChordActionP]
    have h1 : (t : ℂ) * (((w₀ - u) / t : ℝ) : ℂ) = ((w₀ - u : ℝ) : ℂ) := by
      push_cast
      exact mul_div_cancel₀ _ ht_ℂ_ne
    have h2 : ((S.c * t ^ 3 : ℝ) : ℂ) * (((w₀ - u) / t : ℝ) : ℂ) ^ 3 =
        ((S.c * (w₀ - u) ^ 3 : ℝ) : ℂ) := by
      push_cast
      field_simp [ht_ℂ_ne]
    rw [← mul_assoc, h2, h1]
    exact hGeom u w₀ hu.1 hu.2
  have hscaled_p := hcomp_p.const_mul ((S.c * t ^ 3 : ℝ) : ℂ)
  have hev_p :
      (fun u : ℝ => ((S.c * t ^ 3 : ℝ) : ℂ) * P_t (γ_p u)) =ᶠ[nhds v₀]
        (fun u : ℝ => (sgaRealArcMinusChord S u w₀ : ℂ)) :=
    Filter.eventuallyEq_of_mem (hVp_open.mem_nhds hv₀_Vp) h_eq_Vp
  have h_eq_deriv_p_raw :
      ((S.c * t ^ 3 : ℝ) : ℂ) * (L (1, 0) - (t : ℂ)⁻¹ * L (0, 1)) =
        ((-g_arc v₀ * (1 - Real.cos (θ_0 - ϕ_0)) : ℝ) : ℂ) :=
    (hscaled_p.congr_of_eventuallyEq hev_p.symm).unique hArcChord_p.ofReal_comp
  have h_lhs_p :
      ((S.c * t ^ 3 : ℝ) : ℂ) * (L (1, 0) - (t : ℂ)⁻¹ * L (0, 1)) =
        -(((S.c * t ^ 2 : ℝ) : ℂ) * (L (0, 1) - (t : ℂ) * L (1, 0))) := by
    push_cast
    field_simp [ht_ℂ_ne]
    ring
  have h_eq_deriv_p :
      ((S.c * t ^ 2 : ℝ) : ℂ) * (L (0, 1) - (t : ℂ) * L (1, 0)) =
        ((g_arc v₀ * (1 - Real.cos (θ_m - ϕ_0)) : ℝ) : ℂ) := by
    rw [h_lhs_p, hcos_eq] at h_eq_deriv_p_raw
    have hrhs : ((-g_arc v₀ * (1 - Real.cos (θ_m - ϕ_0)) : ℝ) : ℂ) =
        -((g_arc v₀ * (1 - Real.cos (θ_m - ϕ_0)) : ℝ) : ℂ) := by
      rw [neg_mul, Complex.ofReal_neg]
    rw [hrhs] at h_eq_deriv_p_raw
    exact neg_inj.mp h_eq_deriv_p_raw
  have h_match :
      ((S.c * t ^ 2 : ℝ) : ℂ) * (L (0, 1) - (t : ℂ) * L (1, 0)) =
        ((S.c * t ^ 2 : ℝ) : ℂ) * deriv g_m J_m :=
    h_eq_deriv_p.trans h_eq_deriv_m.symm
  have hct2_ne : ((S.c * t ^ 2 : ℝ) : ℂ) ≠ 0 := by
    apply Complex.ofReal_ne_zero.mpr
    have hc_pos : 0 < S.c * t ^ 2 := mul_pos S.c_pos (pow_pos ht_pos 2)
    exact hc_pos.ne'
  have h_cancel := mul_left_cancel₀ hct2_ne h_match
  rw [← hdJ, ← hds] at h_cancel
  exact h_cancel

theorem substrip_displacement_and_domain_bounds (S : FiniteWallNonisotropicStrip) :
    ∀ H₁ : ℝ, 0 < H₁ → H₁ < S.H →
      ∃ (r_sub : ℝ) (J_m_tilde J_p_tilde : ℂ × ℂ → ℂ),
        0 < r_sub ∧ r_sub < S.r_star ∧
        DifferentiableOn ℂ J_m_tilde (horizStrip H₁ ×ˢ Metric.ball (0 : ℂ) r_sub) ∧
        DifferentiableOn ℂ J_p_tilde (horizStrip H₁ ×ˢ Metric.ball (0 : ℂ) r_sub) ∧
        ∀ y t : ℂ, y ∈ horizStrip H₁ → ‖t‖ < r_sub →
          (y, t) ∈ finiteWallTube S.r_star S.h_X ∧
          (y + t, t) ∈ finiteWallTube S.r_star S.h_X ∧
          (y - t, t) ∈ finiteWallTube S.r_star S.h_X ∧
          t * J_m_tilde (y, t) = S.𝔰 (y, t) - S.𝔰 (y - t, t) ∧
          t * J_p_tilde (y, t) = S.𝔰 (y + t, t) - S.𝔰 (y, t) ∧
          (S.𝔰 (y - t, t), t * J_m_tilde (y, t)) ∈ smallChordDomain S sfcaEtaSL ∧
          (S.𝔰 (y, t), t * J_p_tilde (y, t)) ∈ smallChordDomain S sfcaEtaSL ∧
          ‖J_m_tilde (y, t) - 1‖ < 1 / 16 ∧
          ‖J_p_tilde (y, t) - 1‖ < 1 / 16 :=
by
  intro H₁ hH₁_pos hH₁_lt
  have hOpen_strip : ∀ B : ℝ, IsOpen (horizStrip B) :=
    fun B => isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const
  
  let H₂ : ℝ := (2 * H₁ + S.H) / 3
  let H₃ : ℝ := (H₁ + 2 * S.H) / 3
  have hH₁_lt_H₂ : H₁ < H₂ := by dsimp [H₂]; linarith
  have hH₂_lt_H₃ : H₂ < H₃ := by dsimp [H₂, H₃]; linarith
  have hH₃_lt_H : H₃ < S.H := by dsimp [H₃]; linarith
  have hH₂_lt_H : H₂ < S.H := lt_trans hH₂_lt_H₃ hH₃_lt_H
  have hH₂_pos : 0 < H₂ := lt_trans hH₁_pos hH₁_lt_H₂
  have hH₃_pos : 0 < H₃ := lt_trans hH₂_pos hH₂_lt_H₃
  have hgap_pos : 0 < H₂ - H₁ := by linarith
  obtain ⟨u_lsc, hu_open, hu_eq⟩ := lowerSemicontinuousOn_iff_preimage_Ioi.mp S.h_X_lsc H₃
  let V_lsc : Set ℂ := Metric.ball (0 : ℂ) S.r_star ∩ S.h_X ⁻¹' Set.Ioi H₃
  have hV_open : IsOpen V_lsc := by
    change IsOpen (Metric.ball (0 : ℂ) S.r_star ∩ S.h_X ⁻¹' Set.Ioi H₃)
    rw [hu_eq]
    exact Metric.isOpen_ball.inter hu_open
  have h0_V : (0 : ℂ) ∈ V_lsc := by
    refine ⟨Metric.mem_ball_self S.r_star_pos, ?_⟩
    change H₃ < S.h_X 0
    rw [S.h_X_zero]
    exact hH₃_lt_H
  obtain ⟨δ₀, hδ₀_pos, hδ₀_sub⟩ := Metric.isOpen_iff.mp hV_open 0 h0_V
  let δ_lsc : ℝ := min δ₀ (S.r_star / 2)
  have hδ_lsc_pos : 0 < δ_lsc := lt_min hδ₀_pos (by linarith [S.r_star_pos])
  have hδ_lsc_le_δ₀ : δ_lsc ≤ δ₀ := min_le_left _ _
  have hδ_lsc_lt_r : δ_lsc < S.r_star := by
    have : δ_lsc ≤ S.r_star / 2 := min_le_right _ _
    linarith [S.r_star_pos]
  let U₃ : Set (ℂ × ℂ) := horizStrip H₃ ×ˢ Metric.ball (0 : ℂ) δ_lsc
  have hU₃_tube : U₃ ⊆ finiteWallTube S.r_star S.h_X := by
    intro q hq
    rcases hq with ⟨hq1, hq2⟩
    have hzim : |q.1.im| < H₃ := hq1
    rw [abs_lt] at hzim
    have ht_norm : ‖q.2‖ < δ_lsc := mem_ball_zero_iff.mp hq2
    have ht_V : q.2 ∈ V_lsc := hδ₀_sub (mem_ball_zero_iff.mpr (lt_of_lt_of_le ht_norm hδ_lsc_le_δ₀))
    have ht_conj_V : starRingEnd ℂ q.2 ∈ V_lsc := by
      apply hδ₀_sub
      rw [mem_ball_zero_iff, Complex.norm_conj]
      exact lt_of_lt_of_le ht_norm hδ_lsc_le_δ₀
    have hh_t : H₃ < S.h_X q.2 := ht_V.2
    have hh_conj : H₃ < S.h_X (starRingEnd ℂ q.2) := ht_conj_V.2
    exact ⟨lt_trans ht_norm hδ_lsc_lt_r, by linarith [hzim.1], by linarith [hzim.2]⟩

  
  let Δ : ℂ → ℂ → ℂ := fun z t => S.𝔰 (z, t) - z
  let g₁ : ℂ → ℂ → ℂ := fun z => dslope (Δ z) 0
  let W : ℂ × ℂ → ℂ := fun q => dslope (g₁ q.1) 0 q.2
  have hW_fac : ∀ z : ℂ, z ∈ horizStrip H₃ → ∀ t : ℂ, t ^ 2 * W (z, t) = Δ z t := by
    intro z hz t
    have hz_H : z ∈ horizStrip S.H := lt_trans hz hH₃_lt_H
    have hΔ0 : Δ z 0 = 0 := by simp [Δ, S.𝔰_zero z hz_H]
    have hg₁0 : g₁ z 0 = 0 := by
      dsimp [g₁, Δ]
      rw [dslope_same, deriv_sub_const, S.𝔰_deriv_t_zero z hz_H]
    have h1 := sub_smul_dslope (Δ z) 0 t
    simp only [sub_zero, smul_eq_mul, hΔ0] at h1
    have h2 := sub_smul_dslope (g₁ z) 0 t
    simp only [sub_zero, smul_eq_mul, hg₁0] at h2
    calc t ^ 2 * W (z, t) = t * (t * W (z, t)) := by ring
      _ = t * g₁ z t := by rw [h2]
      _ = Δ z t := h1

  
  have hΔ_holo : DifferentiableOn ℂ (fun q : ℂ × ℂ => Δ q.1 q.2) U₃ :=
    (S.𝔰_holo.mono hU₃_tube).sub (differentiable_fst (𝕜 := ℂ)).differentiableOn
  have hΔ_cont : ContinuousOn (fun q : ℂ × ℂ => Δ q.1 q.2) U₃ := hΔ_holo.continuousOn
  have hW_1d_holo : ∀ z ∈ horizStrip H₃,
      DifferentiableOn ℂ (fun τ => W (z, τ)) (Metric.ball (0 : ℂ) δ_lsc) := by
    intro z hz
    have h_nhds : Metric.ball (0 : ℂ) δ_lsc ∈ nhds (0 : ℂ) :=
      Metric.isOpen_ball.mem_nhds (Metric.mem_ball_self hδ_lsc_pos)
    have hι_diff : Differentiable ℂ (fun τ : ℂ => (z, τ)) :=
      (differentiable_const z).prodMk differentiable_id
    have hΔ_z : DifferentiableOn ℂ (Δ z) (Metric.ball (0 : ℂ) δ_lsc) :=
      hΔ_holo.comp hι_diff.differentiableOn (fun _ hτ => ⟨hz, hτ⟩)
    have hg₁_z : DifferentiableOn ℂ (g₁ z) (Metric.ball (0 : ℂ) δ_lsc) :=
      (Complex.differentiableOn_dslope h_nhds).mpr hΔ_z
    exact (Complex.differentiableOn_dslope h_nhds).mpr hg₁_z

  
  let ρ_W : ℝ := (3 / 4 : ℝ) * δ_lsc
  let r_W : ℝ := (3 / 5 : ℝ) * δ_lsc
  have hρ_W_pos : 0 < ρ_W := by dsimp [ρ_W]; positivity
  have hr_W_pos : 0 < r_W := by dsimp [r_W]; positivity
  have hhalf_lt_rW : δ_lsc / 2 < r_W := by dsimp [r_W]; linarith
  have hrW_lt_ρW : r_W < ρ_W := by dsimp [r_W, ρ_W]; linarith
  have hρW_lt_δ : ρ_W < δ_lsc := by dsimp [ρ_W]; linarith
  let U_W : Set (ℂ × ℂ) := horizStrip H₃ ×ˢ Metric.ball (0 : ℂ) r_W
  have hUW_open : IsOpen U_W := (hOpen_strip H₃).prod Metric.isOpen_ball
  let ζ_W : ℝ → ℂ := circleMap 0 ρ_W
  let K_W : ℂ × ℂ → ℝ → ℂ := fun q θ => Δ q.1 (ζ_W θ) / (ζ_W θ * (ζ_W θ - q.2))
  let W_int : ℂ × ℂ → ℂ := fun q =>
    ((2 * Real.pi : ℝ) : ℂ)⁻¹ * ∫ θ in (0 : ℝ)..(2 * Real.pi), K_W q θ
  have hζ_norm : ∀ θ : ℝ, ‖ζ_W θ‖ = ρ_W := by
    intro θ
    dsimp [ζ_W]
    rw [norm_circleMap_zero, abs_of_pos hρ_W_pos]
  have hζ_ne : ∀ θ : ℝ, ζ_W θ ≠ 0 := fun _ => circleMap_ne_center hρ_W_pos.ne'
  have hζ_sub_lb : ∀ t : ℂ, ‖t‖ < r_W → ∀ θ : ℝ, (3 / 20 : ℝ) * δ_lsc ≤ ‖ζ_W θ - t‖ := by
    intro t ht θ
    have h1 := norm_sub_norm_le (ζ_W θ) t
    rw [hζ_norm θ] at h1
    dsimp [ρ_W, r_W] at ht h1
    linarith
  have hW_eq_int : ∀ q ∈ U_W, W q = W_int q := by
    intro q hq
    rcases q with ⟨z, t⟩
    rcases hq with ⟨hz, ht⟩
    have ht_norm : ‖t‖ < r_W := mem_ball_zero_iff.mp ht
    have ht_ball_ρ : t ∈ Metric.ball (0 : ℂ) ρ_W :=
      mem_ball_zero_iff.mpr (lt_trans ht_norm hrW_lt_ρW)
    have h_cl_sub : Metric.closedBall (0 : ℂ) ρ_W ⊆ Metric.ball (0 : ℂ) δ_lsc :=
      fun w hw => mem_ball_zero_iff.mpr (lt_of_le_of_lt (mem_closedBall_zero_iff.mp hw) hρW_lt_δ)
    have h_diffCont : DiffContOnCl ℂ (fun τ => W (z, τ)) (Metric.ball (0 : ℂ) ρ_W) :=
      (hW_1d_holo z hz).diffContOnCl_ball h_cl_sub
    have hcauchy := (h_diffCont.two_pi_i_inv_smul_circleIntegral_sub_inv_smul ht_ball_ρ).symm
    have h_sphere_eq : Set.EqOn (fun ζ : ℂ => (ζ - t)⁻¹ • W (z, ζ))
        (fun ζ : ℂ => (ζ - t)⁻¹ • (Δ z ζ / ζ ^ 2)) (Metric.sphere (0 : ℂ) ρ_W) := by
      intro ζ hζ
      have hζ_n : ‖ζ‖ = ρ_W := by simpa using hζ
      have hζ_nz : ζ ≠ 0 := by rw [← norm_pos_iff, hζ_n]; exact hρ_W_pos
      have hW_div : W (z, ζ) = Δ z ζ / ζ ^ 2 :=
        eq_div_of_mul_eq (pow_ne_zero 2 hζ_nz) (by rw [mul_comm]; exact hW_fac z hz ζ)
      simp [hW_div]
    rw [circleIntegral.integral_congr hρ_W_pos.le h_sphere_eq] at hcauchy
    unfold circleIntegral at hcauchy
    simp only [smul_eq_mul] at hcauchy
    rw [← intervalIntegral.integral_const_mul] at hcauchy
    dsimp [W_int]
    rw [← intervalIntegral.integral_const_mul, hcauchy]
    congr 1
    funext θ
    rw [deriv_circleMap 0 ρ_W θ]
    change (2 * (Real.pi : ℂ) * Complex.I)⁻¹ *
        ((ζ_W θ * Complex.I) * ((ζ_W θ - t)⁻¹ * (Δ z (ζ_W θ) / (ζ_W θ) ^ 2))) =
      ((2 * Real.pi : ℝ) : ℂ)⁻¹ * (Δ z (ζ_W θ) / (ζ_W θ * (ζ_W θ - t)))
    have h_pi_ne : (Real.pi : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr Real.pi_ne_zero
    have hI_ne : Complex.I ≠ 0 := Complex.I_ne_zero
    have hζ_nz : ζ_W θ ≠ 0 := hζ_ne θ
    have hsub_nz : ζ_W θ - t ≠ 0 := by
      rw [← norm_pos_iff]
      exact lt_of_lt_of_le (by positivity) (hζ_sub_lb t ht_norm θ)
    push_cast
    field_simp [h_pi_ne, hI_ne, hζ_nz, hsub_nz]
  have hW_periodic : ∀ z t : ℂ, (z, t) ∈ U_W → W (z + 2 * Real.pi, t) = W (z, t) := by
    intro z t hzt
    have hzt' : (z + 2 * Real.pi, t) ∈ U_W := by
      refine ⟨?_, hzt.2⟩
      simpa [horizStrip] using hzt.1
    rw [hW_eq_int (z + 2 * Real.pi, t) hzt', hW_eq_int (z, t) hzt]
    dsimp [W_int, K_W]
    congr 2
    funext θ
    have h_in_U₃ : (z, ζ_W θ) ∈ U₃ :=
      ⟨hzt.1, mem_ball_zero_iff.mpr (by rw [hζ_norm θ]; exact hρW_lt_δ)⟩
    have hqp := S.𝔰_quasiperiodic (z, ζ_W θ) (hU₃_tube h_in_U₃)
    dsimp [Δ] at hqp ⊢
    rw [hqp]
    ring_nf

  
  have h_cauchy_fderiv : ∀ (q₀ : ℂ × ℂ) (r M : ℝ) (g : ℂ × ℂ → ℂ),
      0 < r → 0 ≤ M →
      DifferentiableOn ℂ g (Metric.ball q₀ (2 * r)) →
      (∀ q ∈ Metric.ball q₀ (2 * r), ‖g q‖ ≤ M) →
      ∀ q ∈ Metric.ball q₀ r, ‖fderiv ℂ g q‖ ≤ M / r := by
    intro q₀ r M g hr_pos hM_nn hg_holo hg_bdd q hq
    refine ContinuousLinearMap.opNorm_le_bound _ (div_nonneg hM_nn hr_pos.le) (fun v => ?_)
    by_cases hv : v = 0
    · simp [hv]
    · have hv_pos : 0 < ‖v‖ := norm_pos_iff.mpr hv
      let R_v : ℝ := r / ‖v‖
      have hRv_pos : 0 < R_v := div_pos hr_pos hv_pos
      let σ : ℂ → ℂ × ℂ := fun ζ => q + ζ • v
      let φ : ℂ → ℂ := fun ζ => g (σ ζ)
      have hσ_maps : Set.MapsTo σ (Metric.closedBall (0 : ℂ) R_v) (Metric.ball q₀ (2 * r)) := by
        intro ζ hζ
        have hζ_le : ‖ζ‖ ≤ r / ‖v‖ := mem_closedBall_zero_iff.mp hζ
        have hζv : ‖ζ • v‖ ≤ r := by
          rw [norm_smul]
          exact (le_div_iff₀ hv_pos).mp hζ_le
        have hq_dist : ‖q - q₀‖ < r := mem_ball_iff_norm.mp hq
        rw [mem_ball_iff_norm]
        have h_eq : σ ζ - q₀ = (q - q₀) + ζ • v := by dsimp [σ]; abel
        rw [h_eq]
        exact lt_of_le_of_lt (norm_add_le _ _) (by linarith)
      have hσ_diff : Differentiable ℂ σ :=
        (differentiable_const q).add (differentiable_id.smul_const v)
      have hφ_diffCont : DiffContOnCl ℂ φ (Metric.ball (0 : ℂ) R_v) :=
        (hg_holo.comp hσ_diff.differentiableOn hσ_maps).diffContOnCl_ball Subset.rfl
      have hφ_sphere : ∀ ζ ∈ Metric.sphere (0 : ℂ) R_v, ‖φ ζ‖ ≤ M :=
        fun ζ hζ => hg_bdd (σ ζ) (hσ_maps (Metric.sphere_subset_closedBall hζ))
      have h_deriv_le :=
        Complex.norm_deriv_le_of_forall_mem_sphere_norm_le hRv_pos hφ_diffCont hφ_sphere
      have hσ0 : HasDerivAt σ v 0 := by
        simpa [σ, one_smul] using ((hasDerivAt_id (0 : ℂ)).smul_const v).const_add q
      have hq_2r : q ∈ Metric.ball q₀ (2 * r) :=
        Metric.ball_subset_ball (by linarith) hq
      have hg_at : HasFDerivAt g (fderiv ℂ g q) (σ 0) := by
        simpa [σ] using (hg_holo.differentiableAt (Metric.isOpen_ball.mem_nhds hq_2r)).hasFDerivAt
      have h_deriv_eq : deriv φ 0 = fderiv ℂ g q v := (hg_at.comp_hasDerivAt 0 hσ0).deriv
      rw [← h_deriv_eq]
      have h_rhs : M / R_v = M / r * ‖v‖ := by
        dsimp [R_v]
        field_simp [hr_pos.ne', hv_pos.ne']
      rwa [h_rhs] at h_deriv_le

  
  have h_lin_decomp : ∀ L : (ℂ × ℂ) →L[ℂ] ℂ,
      L = (L (1, 0)) • ContinuousLinearMap.fst ℂ ℂ ℂ +
        (L (0, 1)) • ContinuousLinearMap.snd ℂ ℂ ℂ := by
    intro L
    refine ContinuousLinearMap.ext fun p => ?_
    have hp : p = p.1 • ((1 : ℂ), (0 : ℂ)) + p.2 • ((0 : ℂ), (1 : ℂ)) := by
      apply Prod.ext <;> simp
    conv_lhs => rw [hp]
    rw [map_add, map_smul, map_smul]
    simp [smul_eq_mul, mul_comm]

  
  have hW_holo : DifferentiableOn ℂ W U_W := by
    refine DifferentiableOn.congr ?_ hW_eq_int
    have hInt_holo : DifferentiableOn ℂ
        (fun q : ℂ × ℂ => ∫ θ in (0 : ℝ)..(2 * Real.pi), K_W q θ) U_W := by
      intro q₀ hq₀
      obtain ⟨R₀, hR₀_pos, hR₀_sub⟩ := Metric.isOpen_iff.mp hUW_open q₀ hq₀
      let r : ℝ := R₀ / 3
      have hr_pos : 0 < r := by dsimp [r]; positivity
      have h2r_pos : 0 < 2 * r := by positivity
      let V₀ : Set (ℂ × ℂ) := Metric.ball q₀ (2 * r)
      have hq₀_V₀ : q₀ ∈ V₀ := Metric.mem_ball_self h2r_pos
      have hV₀_sub_UW : V₀ ⊆ U_W :=
        fun q hq => hR₀_sub (Metric.ball_subset_ball (by dsimp [r]; linarith) hq)
      let K_z : Set ℂ := Metric.closedBall q₀.1 (2 * r)
      have hKz_sub : K_z ⊆ horizStrip H₃ := by
        intro z hz
        have h_dist : dist (z, q₀.2) q₀ < R₀ := by
          rw [Prod.dist_eq, dist_self]
          have hz' : dist z q₀.1 ≤ 2 * r := mem_closedBall.mp hz
          rw [max_eq_left dist_nonneg]
          dsimp [r] at hz' ⊢
          linarith
        exact (hR₀_sub (mem_ball.mpr h_dist)).1
      let K_comp : Set (ℂ × ℂ) := K_z ×ˢ Metric.sphere (0 : ℂ) ρ_W
      have hK_comp_compact : IsCompact K_comp :=
        (isCompact_closedBall q₀.1 (2 * r)).prod (isCompact_sphere 0 ρ_W)
      have hK_comp_sub : K_comp ⊆ U₃ := by
        intro p hp
        refine ⟨hKz_sub hp.1, mem_ball_zero_iff.mpr ?_⟩
        have h_sp : ‖p.2‖ = ρ_W := by simpa using hp.2
        rw [h_sp]
        exact hρW_lt_δ
      obtain ⟨M_raw, hM_raw⟩ :=
        hK_comp_compact.exists_bound_of_continuousOn (hΔ_cont.mono hK_comp_sub)
      let M_Δ : ℝ := max M_raw 0
      have hM_Δ_nn : 0 ≤ M_Δ := le_max_right _ _
      let den_lb : ℝ := ρ_W * ((3 / 20 : ℝ) * δ_lsc)
      have hden_lb_pos : 0 < den_lb := by dsimp [den_lb]; positivity
      let M_int : ℝ := M_Δ / den_lb
      have hM_int_nn : 0 ≤ M_int := div_nonneg hM_Δ_nn hden_lb_pos.le
      have hden_lb_le : ∀ q ∈ V₀, ∀ θ : ℝ, den_lb ≤ ‖ζ_W θ * (ζ_W θ - q.2)‖ := by
        intro q hq θ
        have ht_norm : ‖q.2‖ < r_W := mem_ball_zero_iff.mp (hV₀_sub_UW hq).2
        rw [norm_mul, hζ_norm θ]
        exact mul_le_mul_of_nonneg_left (hζ_sub_lb q.2 ht_norm θ) hρ_W_pos.le
      have hden_ne : ∀ q ∈ V₀, ∀ θ : ℝ, ζ_W θ * (ζ_W θ - q.2) ≠ 0 := by
        intro q hq θ
        rw [← norm_pos_iff]
        exact lt_of_lt_of_le hden_lb_pos (hden_lb_le q hq θ)
      have hKW_bdd : ∀ q ∈ V₀, ∀ θ : ℝ, ‖K_W q θ‖ ≤ M_int := by
        intro q hq θ
        have hq1_Kz : q.1 ∈ K_z := by
          rw [mem_closedBall]
          have hq' : dist q q₀ < 2 * r := mem_ball.mp hq
          exact le_trans (le_max_left (dist q.1 q₀.1) (dist q.2 q₀.2))
            (by simpa [Prod.dist_eq] using hq'.le)
        have h_mem_comp : (q.1, ζ_W θ) ∈ K_comp :=
          ⟨hq1_Kz, circleMap_mem_sphere 0 hρ_W_pos.le θ⟩
        have h_num_le : ‖Δ q.1 (ζ_W θ)‖ ≤ M_Δ :=
          le_trans (hM_raw (q.1, ζ_W θ) h_mem_comp) (le_max_left _ _)
        dsimp [K_W, M_int]
        rw [norm_div]
        exact div_le_div₀ hM_Δ_nn h_num_le hden_lb_pos (hden_lb_le q hq θ)
      have hKW_cont : ∀ q ∈ V₀, Continuous (K_W q) := by
        intro q hq
        have h_pair_cont : Continuous (fun θ : ℝ => (q.1, ζ_W θ)) :=
          continuous_const.prodMk (continuous_circleMap 0 ρ_W)
        have h_pair_maps : Set.MapsTo (fun θ : ℝ => (q.1, ζ_W θ)) Set.univ U₃ :=
          fun θ _ => ⟨(hV₀_sub_UW hq).1, mem_ball_zero_iff.mpr (by rw [hζ_norm θ]; exact hρW_lt_δ)⟩
        have h_num_c : Continuous (fun θ : ℝ => Δ q.1 (ζ_W θ)) :=
          continuousOn_univ.mp (hΔ_cont.comp h_pair_cont.continuousOn h_pair_maps)
        have h_den_c : Continuous (fun θ : ℝ => ζ_W θ * (ζ_W θ - q.2)) :=
          (continuous_circleMap 0 ρ_W).mul ((continuous_circleMap 0 ρ_W).sub continuous_const)
        exact h_num_c.div h_den_c (hden_ne q hq)
      have hKW_holo : ∀ θ : ℝ, DifferentiableOn ℂ (fun q : ℂ × ℂ => K_W q θ) V₀ := by
        intro θ
        have h_pair_diff : Differentiable ℂ (fun q : ℂ × ℂ => (q.1, ζ_W θ)) :=
          (differentiable_fst (𝕜 := ℂ)).prodMk (differentiable_const (ζ_W θ))
        have h_pair_maps : Set.MapsTo (fun q : ℂ × ℂ => (q.1, ζ_W θ)) V₀ U₃ :=
          fun q hq => ⟨(hV₀_sub_UW hq).1, mem_ball_zero_iff.mpr (by rw [hζ_norm θ]; exact hρW_lt_δ)⟩
        have h_num_h : DifferentiableOn ℂ (fun q : ℂ × ℂ => Δ q.1 (ζ_W θ)) V₀ :=
          hΔ_holo.comp h_pair_diff.differentiableOn h_pair_maps
        have hConst : ∀ c : ℂ, DifferentiableOn ℂ (fun _ : ℂ × ℂ => c) V₀ :=
          fun c => differentiableOn_const c
        have h_den_h : DifferentiableOn ℂ (fun q : ℂ × ℂ => ζ_W θ * (ζ_W θ - q.2)) V₀ :=
          (hConst (ζ_W θ)).mul ((hConst (ζ_W θ)).sub (differentiable_snd (𝕜 := ℂ)).differentiableOn)
        have h_inv_h : DifferentiableOn ℂ (fun q : ℂ × ℂ => (ζ_W θ * (ζ_W θ - q.2))⁻¹) V₀ :=
          fun q hq => (h_den_h q hq).fun_inv (hden_ne q hq θ)
        have h_eq_mul : (fun q : ℂ × ℂ => K_W q θ) =
            fun q : ℂ × ℂ => Δ q.1 (ζ_W θ) * (ζ_W θ * (ζ_W θ - q.2))⁻¹ := by
          funext q
          exact div_eq_mul_inv _ _
        rw [h_eq_mul]
        exact h_num_h.mul h_inv_h
      let μ_int := MeasureTheory.volume.restrict (Set.uIoc (0 : ℝ) (2 * Real.pi))
      let F' : ℂ × ℂ → ℝ → (ℂ × ℂ) →L[ℂ] ℂ := fun q θ => fderiv ℂ (fun q' => K_W q' θ) q
      have h_dir_meas : ∀ e : ℂ × ℂ, ‖e‖ ≤ 1 →
          MeasureTheory.AEStronglyMeasurable (fun θ : ℝ => F' q₀ θ e) μ_int := by
        intro e he_norm
        let ζ_seq : ℕ → ℂ := fun n => ((r / 2 : ℝ) : ℂ) / ((n + 1 : ℕ) : ℂ)
        have hζs_norm : ∀ n : ℕ, ‖ζ_seq n‖ = (r / 2) / ((n : ℝ) + 1) := by
          intro n
          dsimp [ζ_seq]
          rw [norm_div, Complex.norm_real, Real.norm_of_nonneg (by positivity),
            ← Nat.cast_add_one, Complex.norm_natCast, Nat.cast_add, Nat.cast_one]
        have hζs_le : ∀ n : ℕ, ‖ζ_seq n‖ ≤ r / 2 := by
          intro n
          rw [hζs_norm n]
          exact div_le_self (by positivity) (by linarith [Nat.cast_nonneg (α := ℝ) n])
        have hζs_ne : ∀ n : ℕ, ζ_seq n ≠ 0 := by
          intro n
          rw [← norm_pos_iff, hζs_norm n]
          positivity
        have hζs_tendsto_0 : Filter.Tendsto ζ_seq Filter.atTop (nhds (0 : ℂ)) :=
          (tendsto_const_div_atTop_nhds_zero_nat ((r / 2 : ℝ) : ℂ)).comp
            (Filter.tendsto_add_atTop_nat 1)
        have hζs_tendsto : Filter.Tendsto ζ_seq Filter.atTop (nhdsWithin (0 : ℂ) {(0 : ℂ)}ᶜ) :=
          tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within ζ_seq hζs_tendsto_0
            (Filter.Eventually.of_forall hζs_ne)
        have h_pt_in : ∀ n : ℕ, q₀ + ζ_seq n • e ∈ V₀ := by
          intro n
          rw [mem_ball_iff_norm, add_sub_cancel_left, norm_smul]
          have h_prod : ‖ζ_seq n‖ * ‖e‖ ≤ (r / 2) * 1 :=
            mul_le_mul (hζs_le n) he_norm (norm_nonneg _) (by positivity)
          linarith
        refine aestronglyMeasurable_of_tendsto_ae Filter.atTop
          (f := fun n θ => (ζ_seq n)⁻¹ • (K_W (q₀ + ζ_seq n • e) θ - K_W q₀ θ)) ?_ ?_
        · intro n
          have h_dq_cont : Continuous
              (fun θ : ℝ => (ζ_seq n)⁻¹ • (K_W (q₀ + ζ_seq n • e) θ - K_W q₀ θ)) :=
            ((hKW_cont _ (h_pt_in n)).sub (hKW_cont q₀ hq₀_V₀)).const_smul (ζ_seq n)⁻¹
          exact h_dq_cont.aestronglyMeasurable
        · refine Filter.Eventually.of_forall (fun θ => ?_)
          have h_aff : HasDerivAt (fun ζ : ℂ => q₀ + ζ • e) e 0 := by
            simpa [one_smul] using ((hasDerivAt_id (0 : ℂ)).smul_const e).const_add q₀
          have h_fd : HasFDerivAt (fun q => K_W q θ) (F' q₀ θ) (q₀ + (0 : ℂ) • e) := by
            simpa using ((hKW_holo θ).differentiableAt (Metric.isOpen_ball.mem_nhds hq₀_V₀)).hasFDerivAt
          have h_sl := (hasDerivAt_iff_tendsto_slope_zero.mp
            (h_fd.comp_hasDerivAt 0 h_aff)).comp hζs_tendsto
          simpa only [Function.comp_def, zero_add, zero_smul, add_zero] using h_sl
      have h_e1_meas : MeasureTheory.AEStronglyMeasurable (fun θ : ℝ => F' q₀ θ (1, 0)) μ_int :=
        h_dir_meas (1, 0) (by simp [Prod.norm_def])
      have h_e2_meas : MeasureTheory.AEStronglyMeasurable (fun θ : ℝ => F' q₀ θ (0, 1)) μ_int :=
        h_dir_meas (0, 1) (by simp [Prod.norm_def])
      have hF'_meas : MeasureTheory.AEStronglyMeasurable (F' q₀) μ_int := by
        have h_eq : F' q₀ = fun θ : ℝ =>
            (F' q₀ θ (1, 0)) • ContinuousLinearMap.fst ℂ ℂ ℂ +
              (F' q₀ θ (0, 1)) • ContinuousLinearMap.snd ℂ ℂ ℂ := by
          funext θ
          exact h_lin_decomp (F' q₀ θ)
        rw [h_eq]
        exact ((continuous_id.smul continuous_const).comp_aestronglyMeasurable h_e1_meas).add
          ((continuous_id.smul continuous_const).comp_aestronglyMeasurable h_e2_meas)
      have h_hasFDeriv :=
        intervalIntegral.hasFDerivAt_integral_of_dominated_of_fderiv_le
          (𝕜 := ℂ) (F := K_W) (F' := F') (x₀ := q₀) (s := Metric.ball q₀ r)
          (bound := fun _ => M_int / r) (a := 0) (b := 2 * Real.pi)
          (Metric.isOpen_ball.mem_nhds (Metric.mem_ball_self hr_pos))
          (Filter.eventually_of_mem (Metric.isOpen_ball.mem_nhds hq₀_V₀)
            (fun q hq => (hKW_cont q hq).aestronglyMeasurable))
          (hKW_cont q₀ hq₀_V₀).continuousOn.intervalIntegrable
          hF'_meas
          (Filter.Eventually.of_forall (fun θ _ q hq =>
            h_cauchy_fderiv q₀ r M_int (fun q' => K_W q' θ) hr_pos hM_int_nn
              (hKW_holo θ) (fun q' hq' => hKW_bdd q' hq' θ) q hq))
          intervalIntegrable_const
          (Filter.Eventually.of_forall (fun θ _ q hq =>
            ((hKW_holo θ).differentiableAt
              (Metric.isOpen_ball.mem_nhds (Metric.ball_subset_ball (by linarith) hq))).hasFDerivAt))
      exact h_hasFDeriv.differentiableAt.differentiableWithinAt
    exact hInt_holo.const_mul (((2 * Real.pi : ℝ) : ℂ)⁻¹)

  
  have hDerivF_holo : DifferentiableOn ℂ (deriv S.f) (horizStrip S.H) :=
    S.f_holo.deriv (hOpen_strip S.H)
  have hDerivF_periodic : ∀ s ∈ horizStrip S.H, deriv S.f (s + 2 * Real.pi) = deriv S.f s := by
    intro s hs
    have hs' : s + 2 * Real.pi ∈ horizStrip S.H := by simpa [horizStrip] using hs
    have hf_at : HasDerivAt S.f (deriv S.f (s + 2 * Real.pi)) (s + 2 * Real.pi) :=
      (S.f_holo.differentiableAt ((hOpen_strip S.H).mem_nhds hs')).hasDerivAt
    have h_sh : HasDerivAt (fun w : ℂ => w + 2 * Real.pi) 1 s :=
      (hasDerivAt_id s).add_const (2 * (Real.pi : ℂ))
    have h_comp : deriv (fun w : ℂ => S.f (w + 2 * Real.pi)) s = deriv S.f (s + 2 * Real.pi) := by
      simpa [Function.comp_def, mul_one] using (hf_at.comp s h_sh).deriv
    have h_ev : (fun w : ℂ => S.f (w + 2 * Real.pi)) =ᶠ[nhds s] S.f :=
      Filter.eventually_of_mem ((hOpen_strip S.H).mem_nhds hs) (fun w hw => S.f_periodic w hw)
    rw [← h_comp, h_ev.deriv_eq]
  have h_mod_2pi : ∀ (B : ℝ) (Φ : ℂ → ℂ),
      (∀ s ∈ horizStrip B, Φ (s + 2 * Real.pi) = Φ s) →
      ∀ z ∈ horizStrip B, ∃ x₀ ∈ Set.Icc (0 : ℝ) (2 * Real.pi),
        Φ z = Φ ((x₀ : ℂ) + (z.im : ℂ) * Complex.I) := by
    intro B Φ hΦ_per
    have h_nat : ∀ (n : ℕ) (s : ℂ), s ∈ horizStrip B →
        Φ (s + (((n : ℝ) * (2 * Real.pi) : ℝ) : ℂ)) = Φ s := by
      intro n
      induction n with
      | zero => intro s _; simp
      | succ n ih =>
        intro s hs
        have hs_n : s + (((n : ℝ) * (2 * Real.pi) : ℝ) : ℂ) ∈ horizStrip B := by
          simpa [horizStrip] using hs
        have h_step : s + ((((n + 1 : ℕ) : ℝ) * (2 * Real.pi) : ℝ) : ℂ) =
            (s + (((n : ℝ) * (2 * Real.pi) : ℝ) : ℂ)) + 2 * Real.pi := by
          push_cast; ring
        rw [h_step, hΦ_per _ hs_n, ih s hs]
    have h_int : ∀ (k : ℤ) (s : ℂ), s ∈ horizStrip B →
        Φ (s + (((k : ℝ) * (2 * Real.pi) : ℝ) : ℂ)) = Φ s := by
      intro k s hs
      rcases k with n | n
      · simpa using h_nat n s hs
      · set s' : ℂ := s + (((Int.negSucc n : ℝ) * (2 * Real.pi) : ℝ) : ℂ)
        have hs' : s' ∈ horizStrip B := by simpa [s', horizStrip] using hs
        have h_back : s' + ((((n + 1 : ℕ) : ℝ) * (2 * Real.pi) : ℝ) : ℂ) = s := by
          simp only [s', Int.cast_negSucc]; push_cast; ring
        have h1 := h_nat (n + 1) s' hs'
        rw [h_back] at h1
        exact h1.symm
    intro z hz
    have h2pi : (0 : ℝ) < 2 * Real.pi := by positivity
    let k : ℤ := ⌊z.re / (2 * Real.pi)⌋
    let x₀ : ℝ := z.re - (k : ℝ) * (2 * Real.pi)
    have hx₀_nn : 0 ≤ x₀ := by
      have := (le_div_iff₀ h2pi).mp (Int.floor_le (z.re / (2 * Real.pi)))
      dsimp [x₀]; linarith
    have hx₀_le : x₀ ≤ 2 * Real.pi := by
      have := (div_lt_iff₀ h2pi).mp (Int.lt_floor_add_one (z.re / (2 * Real.pi)))
      dsimp [x₀]; linarith
    set z₀ : ℂ := (x₀ : ℂ) + (z.im : ℂ) * Complex.I
    have hz₀ : z₀ ∈ horizStrip B := by simpa [z₀, horizStrip] using hz
    have hz_eq : z₀ + (((k : ℝ) * (2 * Real.pi) : ℝ) : ℂ) = z := by
      apply Complex.ext <;> simp [z₀, x₀]
    refine ⟨x₀, ⟨hx₀_nn, hx₀_le⟩, ?_⟩
    change Φ z = Φ z₀
    rw [← hz_eq, h_int k z₀ hz₀]

  
  let R_H₂ : Set (ℝ × ℝ) := Set.Icc (0 : ℝ) (2 * Real.pi) ×ˢ Set.Icc (-H₂) H₂
  have hR_H₂_comp : IsCompact R_H₂ := isCompact_Icc.prod isCompact_Icc
  let K_box : Set ((ℝ × ℝ) × ℂ) := R_H₂ ×ˢ Metric.closedBall (0 : ℂ) (δ_lsc / 2)
  have hK_box_comp : IsCompact K_box := hR_H₂_comp.prod (isCompact_closedBall 0 (δ_lsc / 2))
  let ψ_W : (ℝ × ℝ) × ℂ → ℂ × ℂ := fun p => ((p.1.1 : ℂ) + (p.1.2 : ℂ) * Complex.I, p.2)
  have hψ_W_cont : Continuous ψ_W := by fun_prop
  have hψ_W_maps : Set.MapsTo ψ_W K_box U_W := by
    intro p hp
    rcases hp with ⟨⟨_, hp_im_lo, hp_im_hi⟩, hp_t⟩
    refine ⟨?_, ?_⟩
    · change |((p.1.1 : ℂ) + (p.1.2 : ℂ) * Complex.I).im| < H₃
      simp only [Complex.add_im, Complex.ofReal_im, Complex.mul_im, Complex.ofReal_re,
        Complex.I_im, Complex.I_re, mul_one, mul_zero, add_zero, zero_add]
      rw [abs_lt]
      exact ⟨by linarith, by linarith⟩
    · exact mem_ball_zero_iff.mpr (lt_of_le_of_lt (mem_closedBall_zero_iff.mp hp_t) hhalf_lt_rW)
  obtain ⟨C_W, hC_W⟩ :=
    hK_box_comp.exists_bound_of_continuousOn
      (hW_holo.continuousOn.comp hψ_W_cont.continuousOn hψ_W_maps)
  let M_W : ℝ := max C_W 1
  have hM_W_ge_one : 1 ≤ M_W := le_max_right _ _
  have hM_W_pos : 0 < M_W := lt_of_lt_of_le zero_lt_one hM_W_ge_one
  have hW_sub_bound : ∀ z t : ℂ, |z.im| ≤ H₂ → ‖t‖ ≤ δ_lsc / 2 → ‖W (z, t)‖ ≤ M_W := by
    intro z t hz_im ht_le
    have hz_H₃ : z ∈ horizStrip H₃ := lt_of_le_of_lt hz_im hH₂_lt_H₃
    have ht_rW : t ∈ Metric.ball (0 : ℂ) r_W :=
      mem_ball_zero_iff.mpr (lt_of_le_of_lt ht_le hhalf_lt_rW)
    obtain ⟨x₀, hx₀, hW_eq⟩ :=
      h_mod_2pi H₃ (fun s => W (s, t)) (fun s hs => hW_periodic s t ⟨hs, ht_rW⟩) z hz_H₃
    have hp_mem : ((x₀, z.im), t) ∈ K_box :=
      ⟨⟨hx₀, abs_le.mp hz_im⟩, mem_closedBall_zero_iff.mpr ht_le⟩
    rw [hW_eq]
    exact le_trans (hC_W ((x₀, z.im), t) hp_mem) (le_max_left _ _)

  let φ_s : ℝ × ℝ → ℂ := fun p => (p.1 : ℂ) + (p.2 : ℂ) * Complex.I
  have hφ_s_cont : Continuous φ_s := by fun_prop
  have hφ_s_maps : Set.MapsTo φ_s R_H₂ (horizStrip S.H) := by
    intro p hp
    rcases hp with ⟨_, hp_lo, hp_hi⟩
    change |(φ_s p).im| < S.H
    have him : (φ_s p).im = p.2 := by simp [φ_s]
    rw [him, abs_lt]
    exact ⟨by linarith, by linarith⟩
  obtain ⟨C_f, hC_f⟩ := hR_H₂_comp.exists_bound_of_continuousOn
    (S.f_holo.continuousOn.comp hφ_s_cont.continuousOn hφ_s_maps)
  obtain ⟨C_df, hC_df⟩ := hR_H₂_comp.exists_bound_of_continuousOn
    (hDerivF_holo.continuousOn.comp hφ_s_cont.continuousOn hφ_s_maps)
  obtain ⟨C_q, hC_q⟩ := hR_H₂_comp.exists_bound_of_continuousOn
    (S.q_holo.continuousOn.comp hφ_s_cont.continuousOn hφ_s_maps)
  let M_field : ℝ := max (max C_f C_df) (max C_q 1)
  have hM_field_ge_one : 1 ≤ M_field := le_trans (le_max_right _ _) (le_max_right _ _)
  have hM_field_pos : 0 < M_field := lt_of_lt_of_le zero_lt_one hM_field_ge_one
  have hField_bound : ∀ s ∈ horizStrip H₂,
      ‖S.f s‖ ≤ M_field ∧ ‖deriv S.f s‖ ≤ M_field ∧ ‖S.q s‖ ≤ M_field := by
    intro s hs
    have hs_H : s ∈ horizStrip S.H := lt_trans hs hH₂_lt_H
    have hs_im : s.im ∈ Set.Icc (-H₂) H₂ := abs_le.mp (le_of_lt hs)
    obtain ⟨xf, hxf, hf_eq⟩ := h_mod_2pi S.H S.f S.f_periodic s hs_H
    obtain ⟨xdf, hxdf, hdf_eq⟩ := h_mod_2pi S.H (deriv S.f) hDerivF_periodic s hs_H
    obtain ⟨xq, hxq, hq_eq⟩ := h_mod_2pi S.H S.q S.q_periodic s hs_H
    refine ⟨?_, ?_, ?_⟩
    · rw [hf_eq]
      exact le_trans (hC_f (xf, s.im) ⟨hxf, hs_im⟩)
        (le_trans (le_max_left _ _) (le_max_left _ _))
    · rw [hdf_eq]
      exact le_trans (hC_df (xdf, s.im) ⟨hxdf, hs_im⟩)
        (le_trans (le_max_right _ _) (le_max_left _ _))
    · rw [hq_eq]
      exact le_trans (hC_q (xq, s.im) ⟨hxq, hs_im⟩)
        (le_trans (le_max_left _ _) (le_max_right _ _))

  
  have heta_pos : 0 < sfcaEtaSL := by norm_num [sfcaEtaSL]
  let r_sub : ℝ :=
    min (min (δ_lsc / 4) (S.r_star / 2))
      (min (min (H₂ - H₁) 1 / (64 * M_W)) (sfcaEtaSL / (4 * M_field)))
  have hr_pos : 0 < r_sub := by
    refine lt_min (lt_min (by positivity) (by linarith [S.r_star_pos]))
      (lt_min (div_pos (lt_min hgap_pos zero_lt_one) (by positivity)) (by positivity))
  have hr_lt : r_sub < S.r_star := by
    have : r_sub ≤ S.r_star / 2 := le_trans (min_le_left _ _) (min_le_right _ _)
    linarith [S.r_star_pos]
  have hr_le_δ4 : r_sub ≤ δ_lsc / 4 := le_trans (min_le_left _ _) (min_le_left _ _)
  have hr_MW_le : r_sub * M_W ≤ min (H₂ - H₁) 1 / 64 := by
    have h1 : r_sub ≤ min (H₂ - H₁) 1 / (64 * M_W) :=
      le_trans (min_le_right _ _) (min_le_left _ _)
    have h2 := mul_le_mul_of_nonneg_right h1 hM_W_pos.le
    have h_eq : min (H₂ - H₁) 1 / (64 * M_W) * M_W = min (H₂ - H₁) 1 / 64 := by
      field_simp [hM_W_pos.ne']
    rwa [h_eq] at h2
  have hr_MW_le_gap : r_sub * M_W ≤ (H₂ - H₁) / 64 :=
    le_trans hr_MW_le (div_le_div_of_nonneg_right (min_le_left _ _) (by norm_num))
  have hr_MW_le_inv64 : r_sub * M_W ≤ 1 / 64 :=
    le_trans hr_MW_le (div_le_div_of_nonneg_right (min_le_right _ _) (by norm_num))
  have hr_le_rMW : r_sub ≤ r_sub * M_W := by nlinarith
  have hr_le_gap : r_sub ≤ (H₂ - H₁) / 64 := le_trans hr_le_rMW hr_MW_le_gap
  have hr_le_inv64 : r_sub ≤ 1 / 64 := le_trans hr_le_rMW hr_MW_le_inv64
  have hr_Mf_le : r_sub * M_field ≤ sfcaEtaSL / 4 := by
    have h1 : r_sub ≤ sfcaEtaSL / (4 * M_field) :=
      le_trans (min_le_right _ _) (min_le_right _ _)
    have h2 := mul_le_mul_of_nonneg_right h1 hM_field_pos.le
    have h_eq : sfcaEtaSL / (4 * M_field) * M_field = sfcaEtaSL / 4 := by
      field_simp [hM_field_pos.ne']
    rwa [h_eq] at h2

  let shift_p : ℂ × ℂ → ℂ × ℂ := fun p => (p.1 + p.2, p.2)
  let shift_m : ℂ × ℂ → ℂ × ℂ := fun p => (p.1 - p.2, p.2)
  let J_m_tilde : ℂ × ℂ → ℂ := fun p => 1 + p.2 * (W p - W (shift_m p))
  let J_p_tilde : ℂ × ℂ → ℂ := fun p => 1 + p.2 * (W (shift_p p) - W p)
  let U₁ : Set (ℂ × ℂ) := horizStrip H₁ ×ˢ Metric.ball (0 : ℂ) r_sub

  have h_shift_im : ∀ y t : ℂ, y ∈ horizStrip H₁ → ‖t‖ < r_sub →
      |y.im| < H₁ + (H₂ - H₁) / 64 ∧
      |(y + t).im| < H₁ + (H₂ - H₁) / 64 ∧
      |(y - t).im| < H₁ + (H₂ - H₁) / 64 := by
    intro y t hy ht
    have hy_im : |y.im| < H₁ := hy
    have ht_im : |t.im| < (H₂ - H₁) / 64 :=
      lt_of_le_of_lt (Complex.abs_im_le_norm t) (lt_of_lt_of_le ht hr_le_gap)
    refine ⟨by linarith, ?_, ?_⟩
    · rw [Complex.add_im]
      exact lt_of_le_of_lt (abs_add_le _ _) (by linarith)
    · rw [Complex.sub_im]
      exact lt_of_le_of_lt (abs_sub _ _) (by linarith)

  have h_pt_in_domains : ∀ z t : ℂ, |z.im| < H₁ + (H₂ - H₁) / 64 → ‖t‖ < r_sub →
      z ∈ horizStrip H₂ ∧ z ∈ horizStrip H₃ ∧ (z, t) ∈ U_W ∧ (z, t) ∈ U₃ ∧
      (z, t) ∈ finiteWallTube S.r_star S.h_X ∧ ‖W (z, t)‖ ≤ M_W := by
    intro z t hzim ht
    have hz_H₂ : z ∈ horizStrip H₂ := by change |z.im| < H₂; linarith
    have hz_H₃ : z ∈ horizStrip H₃ := lt_trans hz_H₂ hH₂_lt_H₃
    have ht_half : ‖t‖ ≤ δ_lsc / 2 := by linarith
    have ht_rW : ‖t‖ < r_W := lt_of_le_of_lt ht_half hhalf_lt_rW
    have ht_δ : ‖t‖ < δ_lsc := lt_trans ht_rW hrW_lt_ρW |>.trans hρW_lt_δ
    have h_UW : (z, t) ∈ U_W := ⟨hz_H₃, mem_ball_zero_iff.mpr ht_rW⟩
    have h_U₃ : (z, t) ∈ U₃ := ⟨hz_H₃, mem_ball_zero_iff.mpr ht_δ⟩
    exact ⟨hz_H₂, hz_H₃, h_UW, h_U₃, hU₃_tube h_U₃, hW_sub_bound z t hz_H₂.le ht_half⟩

  have hU₁_sub_UW : U₁ ⊆ U_W := by
    intro p hp
    have ht : ‖p.2‖ < r_sub := mem_ball_zero_iff.mp hp.2
    exact (h_pt_in_domains p.1 p.2 (h_shift_im p.1 p.2 hp.1 ht).1 ht).2.2.1
  have hshift_p_maps : Set.MapsTo shift_p U₁ U_W := by
    intro p hp
    have ht : ‖p.2‖ < r_sub := mem_ball_zero_iff.mp hp.2
    exact (h_pt_in_domains (p.1 + p.2) p.2 (h_shift_im p.1 p.2 hp.1 ht).2.1 ht).2.2.1
  have hshift_m_maps : Set.MapsTo shift_m U₁ U_W := by
    intro p hp
    have ht : ‖p.2‖ < r_sub := mem_ball_zero_iff.mp hp.2
    exact (h_pt_in_domains (p.1 - p.2) p.2 (h_shift_im p.1 p.2 hp.1 ht).2.2 ht).2.2.1

  have hshift_p_diff : Differentiable ℂ shift_p :=
    ((differentiable_fst (𝕜 := ℂ)).add (differentiable_snd (𝕜 := ℂ))).prodMk
      (differentiable_snd (𝕜 := ℂ))
  have hshift_m_diff : Differentiable ℂ shift_m :=
    ((differentiable_fst (𝕜 := ℂ)).sub (differentiable_snd (𝕜 := ℂ))).prodMk
      (differentiable_snd (𝕜 := ℂ))
  have hW_0_holo : DifferentiableOn ℂ W U₁ := hW_holo.mono hU₁_sub_UW
  have hW_p_holo : DifferentiableOn ℂ (fun p => W (shift_p p)) U₁ :=
    hW_holo.comp hshift_p_diff.differentiableOn hshift_p_maps
  have hW_m_holo : DifferentiableOn ℂ (fun p => W (shift_m p)) U₁ :=
    hW_holo.comp hshift_m_diff.differentiableOn hshift_m_maps
  have hConst1_U₁ : DifferentiableOn ℂ (fun _ : ℂ × ℂ => (1 : ℂ)) U₁ :=
    differentiableOn_const (1 : ℂ)
  have hsnd_U₁ : DifferentiableOn ℂ (fun p : ℂ × ℂ => p.2) U₁ :=
    (differentiable_snd (𝕜 := ℂ)).differentiableOn
  have hJm_holo : DifferentiableOn ℂ J_m_tilde U₁ :=
    hConst1_U₁.add (hsnd_U₁.mul (hW_0_holo.sub hW_m_holo))
  have hJp_holo : DifferentiableOn ℂ J_p_tilde U₁ :=
    hConst1_U₁.add (hsnd_U₁.mul (hW_p_holo.sub hW_0_holo))

  
  have h_in_scd : ∀ s_a h_a : ℂ,
      s_a ∈ horizStrip H₂ → s_a + h_a ∈ horizStrip H₂ → ‖h_a‖ < 2 * r_sub →
      (s_a, h_a) ∈ smallChordDomain S sfcaEtaSL := by
    intro s_a h_a hsa hsaha hha
    have hsa_H : s_a ∈ horizStrip S.H := lt_trans hsa hH₂_lt_H
    have hsaha_H : s_a + h_a ∈ horizStrip S.H := lt_trans hsaha hH₂_lt_H
    have hha_le_one : ‖h_a‖ ≤ 1 := by linarith
    have hha2_lt : ‖h_a ^ 2‖ < 2 * r_sub := by
      calc ‖h_a ^ 2‖ = ‖h_a‖ * ‖h_a‖ := by rw [norm_pow, sq]
        _ ≤ ‖h_a‖ * 1 := mul_le_mul_of_nonneg_left hha_le_one (norm_nonneg _)
        _ = ‖h_a‖ := mul_one _
        _ < 2 * r_sub := hha
    obtain ⟨hf_le, hdf_le, _⟩ := hField_bound s_a hsa
    have h_f_lt : ‖h_a * S.f s_a‖ < sfcaEtaSL := by
      calc ‖h_a * S.f s_a‖ = ‖h_a‖ * ‖S.f s_a‖ := norm_mul _ _
        _ ≤ ‖h_a‖ * M_field := mul_le_mul_of_nonneg_left hf_le (norm_nonneg _)
        _ < (2 * r_sub) * M_field := mul_lt_mul_of_pos_right hha hM_field_pos
        _ = 2 * (r_sub * M_field) := by ring
        _ ≤ 2 * (sfcaEtaSL / 4) := mul_le_mul_of_nonneg_left hr_Mf_le (by norm_num)
        _ < sfcaEtaSL := by linarith
    have h_df_lt : ‖h_a ^ 2 * deriv S.f s_a‖ < sfcaEtaSL := by
      calc ‖h_a ^ 2 * deriv S.f s_a‖ = ‖h_a ^ 2‖ * ‖deriv S.f s_a‖ := norm_mul _ _
        _ ≤ ‖h_a ^ 2‖ * M_field := mul_le_mul_of_nonneg_left hdf_le (norm_nonneg _)
        _ < (2 * r_sub) * M_field := mul_lt_mul_of_pos_right hha2_lt hM_field_pos
        _ = 2 * (r_sub * M_field) := by ring
        _ ≤ 2 * (sfcaEtaSL / 4) := mul_le_mul_of_nonneg_left hr_Mf_le (by norm_num)
        _ < sfcaEtaSL := by linarith
    refine ⟨hsa_H, hsaha_H, h_f_lt, h_df_lt, ?_⟩
    intro w hw
    rcases hw with ⟨hw0, hw1⟩
    have hseg_H₂ : s_a + (w : ℂ) * h_a ∈ horizStrip H₂ := by
      change |(s_a + (w : ℂ) * h_a).im| < H₂
      have him : (s_a + (w : ℂ) * h_a).im = (1 - w) * s_a.im + w * (s_a + h_a).im := by
        simp [Complex.add_im, Complex.mul_im]
        ring
      rw [him, abs_lt]
      have h1 : |s_a.im| < H₂ := hsa
      have h2 : |(s_a + h_a).im| < H₂ := hsaha
      rw [abs_lt] at h1 h2
      rcases eq_or_lt_of_le hw0 with rfl | hw_pos
      · simp [h1.1, h1.2]
      · constructor <;> nlinarith
    have hq_le : ‖S.q (s_a + (w : ℂ) * h_a)‖ ≤ M_field := (hField_bound _ hseg_H₂).2.2
    calc ‖h_a ^ 2 * S.q (s_a + (w : ℂ) * h_a)‖
        = ‖h_a ^ 2‖ * ‖S.q (s_a + (w : ℂ) * h_a)‖ := norm_mul _ _
      _ ≤ ‖h_a ^ 2‖ * M_field := mul_le_mul_of_nonneg_left hq_le (norm_nonneg _)
      _ < (2 * r_sub) * M_field := mul_lt_mul_of_pos_right hha2_lt hM_field_pos
      _ = 2 * (r_sub * M_field) := by ring
      _ ≤ 2 * (sfcaEtaSL / 4) := mul_le_mul_of_nonneg_left hr_Mf_le (by norm_num)
      _ < sfcaEtaSL := by linarith

  
  refine ⟨r_sub, J_m_tilde, J_p_tilde, hr_pos, hr_lt, hJm_holo, hJp_holo, ?_⟩
  intro y t hy ht
  obtain ⟨hy_sh, hyp_sh, hym_sh⟩ := h_shift_im y t hy ht
  obtain ⟨_, hy_H₃, _, _, hy_tube, hWy_le⟩ := h_pt_in_domains y t hy_sh ht
  obtain ⟨_, hyp_H₃, _, _, hyp_tube, hWyp_le⟩ := h_pt_in_domains (y + t) t hyp_sh ht
  obtain ⟨_, hym_H₃, _, _, hym_tube, hWym_le⟩ := h_pt_in_domains (y - t) t hym_sh ht
  have hs_eq : ∀ z : ℂ, z ∈ horizStrip H₃ → S.𝔰 (z, t) = z + t ^ 2 * W (z, t) := by
    intro z hz
    have h := hW_fac z hz t
    dsimp [Δ] at h
    linear_combination -h
  have h_lift_H₂ : ∀ z : ℂ, |z.im| < H₁ + (H₂ - H₁) / 64 →
      z ∈ horizStrip H₃ → ‖W (z, t)‖ ≤ M_W → S.𝔰 (z, t) ∈ horizStrip H₂ := by
    intro z hzim hz_H₃ hWz
    change |(S.𝔰 (z, t)).im| < H₂
    rw [hs_eq z hz_H₃, Complex.add_im]
    have htW : ‖t‖ * ‖W (z, t)‖ ≤ r_sub * M_W :=
      mul_le_mul ht.le hWz (norm_nonneg _) hr_pos.le
    have ht2W : ‖t ^ 2 * W (z, t)‖ ≤ (H₂ - H₁) / 64 := by
      calc ‖t ^ 2 * W (z, t)‖ = ‖t‖ * (‖t‖ * ‖W (z, t)‖) := by
            rw [norm_mul, norm_pow, sq, mul_assoc]
        _ ≤ r_sub * (r_sub * M_W) :=
            mul_le_mul ht.le htW (by positivity) hr_pos.le
        _ ≤ ((H₂ - H₁) / 64) * 1 :=
            mul_le_mul hr_le_gap (by linarith) (by positivity) (by positivity)
        _ = (H₂ - H₁) / 64 := mul_one _
    have him_le : |(t ^ 2 * W (z, t)).im| ≤ (H₂ - H₁) / 64 :=
      le_trans (Complex.abs_im_le_norm _) ht2W
    exact lt_of_le_of_lt (abs_add_le _ _) (by linarith)

  have hs0_H₂ : S.𝔰 (y, t) ∈ horizStrip H₂ := h_lift_H₂ y hy_sh hy_H₃ hWy_le
  have hsp_H₂ : S.𝔰 (y + t, t) ∈ horizStrip H₂ := h_lift_H₂ (y + t) hyp_sh hyp_H₃ hWyp_le
  have hsm_H₂ : S.𝔰 (y - t, t) ∈ horizStrip H₂ := h_lift_H₂ (y - t) hym_sh hym_H₃ hWym_le

  have hJm_alg : t * J_m_tilde (y, t) = S.𝔰 (y, t) - S.𝔰 (y - t, t) := by
    rw [hs_eq y hy_H₃, hs_eq (y - t) hym_H₃]
    dsimp [J_m_tilde, shift_m]
    ring
  have hJp_alg : t * J_p_tilde (y, t) = S.𝔰 (y + t, t) - S.𝔰 (y, t) := by
    rw [hs_eq (y + t) hyp_H₃, hs_eq y hy_H₃]
    dsimp [J_p_tilde, shift_p]
    ring

  have hJm_close : ‖J_m_tilde (y, t) - 1‖ < 1 / 16 := by
    have h_sub_eq : J_m_tilde (y, t) - 1 = t * (W (y, t) - W (y - t, t)) := by
      dsimp [J_m_tilde, shift_m]; ring
    rw [h_sub_eq, norm_mul]
    have h_diff : ‖W (y, t) - W (y - t, t)‖ ≤ 2 * M_W :=
      le_trans (norm_sub_le _ _) (by linarith)
    calc ‖t‖ * ‖W (y, t) - W (y - t, t)‖
        ≤ ‖t‖ * (2 * M_W) := mul_le_mul_of_nonneg_left h_diff (norm_nonneg _)
      _ < r_sub * (2 * M_W) := mul_lt_mul_of_pos_right ht (by positivity)
      _ = 2 * (r_sub * M_W) := by ring
      _ ≤ 2 * (1 / 64) := mul_le_mul_of_nonneg_left hr_MW_le_inv64 (by norm_num)
      _ < 1 / 16 := by norm_num

  have hJp_close : ‖J_p_tilde (y, t) - 1‖ < 1 / 16 := by
    have h_sub_eq : J_p_tilde (y, t) - 1 = t * (W (y + t, t) - W (y, t)) := by
      dsimp [J_p_tilde, shift_p]; ring
    rw [h_sub_eq, norm_mul]
    have h_diff : ‖W (y + t, t) - W (y, t)‖ ≤ 2 * M_W :=
      le_trans (norm_sub_le _ _) (by linarith)
    calc ‖t‖ * ‖W (y + t, t) - W (y, t)‖
        ≤ ‖t‖ * (2 * M_W) := mul_le_mul_of_nonneg_left h_diff (norm_nonneg _)
      _ < r_sub * (2 * M_W) := mul_lt_mul_of_pos_right ht (by positivity)
      _ = 2 * (r_sub * M_W) := by ring
      _ ≤ 2 * (1 / 64) := mul_le_mul_of_nonneg_left hr_MW_le_inv64 (by norm_num)
      _ < 1 / 16 := by norm_num

  have hJm_norm : ‖J_m_tilde (y, t)‖ ≤ 2 := by
    have h1 := norm_le_norm_sub_add (J_m_tilde (y, t)) 1
    rw [norm_one] at h1
    linarith
  have hJp_norm : ‖J_p_tilde (y, t)‖ ≤ 2 := by
    have h1 := norm_le_norm_sub_add (J_p_tilde (y, t)) 1
    rw [norm_one] at h1
    linarith

  have hscd_m : (S.𝔰 (y - t, t), t * J_m_tilde (y, t)) ∈ smallChordDomain S sfcaEtaSL := by
    refine h_in_scd (S.𝔰 (y - t, t)) (t * J_m_tilde (y, t)) hsm_H₂ ?_ ?_
    · rw [hJm_alg, add_sub_cancel]
      exact hs0_H₂
    · calc ‖t * J_m_tilde (y, t)‖ = ‖t‖ * ‖J_m_tilde (y, t)‖ := norm_mul _ _
        _ ≤ ‖t‖ * 2 := mul_le_mul_of_nonneg_left hJm_norm (norm_nonneg _)
        _ < r_sub * 2 := mul_lt_mul_of_pos_right ht (by norm_num)
        _ = 2 * r_sub := by ring

  have hscd_p : (S.𝔰 (y, t), t * J_p_tilde (y, t)) ∈ smallChordDomain S sfcaEtaSL := by
    refine h_in_scd (S.𝔰 (y, t)) (t * J_p_tilde (y, t)) hs0_H₂ ?_ ?_
    · rw [hJp_alg, add_sub_cancel]
      exact hsp_H₂
    · calc ‖t * J_p_tilde (y, t)‖ = ‖t‖ * ‖J_p_tilde (y, t)‖ := norm_mul _ _
        _ ≤ ‖t‖ * 2 := mul_le_mul_of_nonneg_left hJp_norm (norm_nonneg _)
        _ < r_sub * 2 := mul_lt_mul_of_pos_right ht (by norm_num)
        _ = 2 * r_sub := by ring

  exact ⟨hy_tube, hyp_tube, hym_tube, hJm_alg, hJp_alg, hscd_m, hscd_p, hJm_close, hJp_close⟩

theorem bivar_partial_holo_and_real_slice_continuation : (∀ (Ω : Set (ℂ × ℂ)) (Phi : ℂ × ℂ → ℂ),
      IsOpen Ω →
      DifferentiableOn ℂ Phi Ω →
      DifferentiableOn ℂ (fun q : ℂ × ℂ => deriv (fun z => Phi (z, q.2)) q.1) Ω ∧
      DifferentiableOn ℂ (fun q : ℂ × ℂ => deriv (fun w => Phi (q.1, w)) q.2) Ω) ∧
    (∀ (H₁ r_sub : ℝ) (F₁ F₂ : ℂ × ℂ → ℂ),
      0 < H₁ → 0 < r_sub →
      DifferentiableOn ℂ F₁ (horizStrip H₁ ×ˢ Metric.ball (0 : ℂ) r_sub) →
      DifferentiableOn ℂ F₂ (horizStrip H₁ ×ˢ Metric.ball (0 : ℂ) r_sub) →
      (∀ x t : ℝ, 0 < t → t < r_sub → F₁ ((x : ℂ), (t : ℂ)) = F₂ ((x : ℂ), (t : ℂ))) →
      ∀ y t : ℂ, y ∈ horizStrip H₁ → ‖t‖ < r_sub → F₁ (y, t) = F₂ (y, t)) :=
by
  have h_partial_1 : ∀ (Ω : Set (ℂ × ℂ)) (Phi : ℂ × ℂ → ℂ),
      IsOpen Ω →
      DifferentiableOn ℂ Phi Ω →
      DifferentiableOn ℂ (fun q : ℂ × ℂ => deriv (fun z => Phi (z, q.2)) q.1) Ω := by
    intro Ω Phi hOpen hPhi q₀ hq₀
    obtain ⟨ε, hε_pos, hε_sub⟩ := Metric.isOpen_iff.mp hOpen q₀ hq₀
    let r : ℝ := ε / 4
    have hr : 0 < r := by positivity
    let K₃ : Set (ℂ × ℂ) := Metric.closedBall q₀ (3 * r)
    let K₂ : Set (ℂ × ℂ) := Metric.closedBall q₀ (2 * r)
    have hK₃_sub : K₃ ⊆ Ω :=
      (Metric.closedBall_subset_ball (by dsimp [r]; linarith)).trans hε_sub
    have hK₂_sub_K₃ : K₂ ⊆ K₃ :=
      Metric.closedBall_subset_closedBall (by linarith)
    have hK₂_sub : K₂ ⊆ Ω := hK₂_sub_K₃.trans hK₃_sub
    obtain ⟨C₀, hC₀⟩ :=
      (isCompact_closedBall q₀ (3 * r)).exists_bound_of_continuousOn
        (hPhi.continuousOn.mono hK₃_sub)
    let M : ℝ := max C₀ 0
    have hPhi_le_M : ∀ p ∈ K₃, ‖Phi p‖ ≤ M := fun p hp =>
      (hC₀ p hp).trans (le_max_left _ _)
    have hfderiv_le : ∀ p ∈ K₂, ‖fderiv ℂ Phi p‖ ≤ 2 * M / r := by
      intro p hp
      have hp_K₃ : p ∈ K₃ := hK₂_sub_K₃ hp
      have hball_K₃ : Metric.ball p r ⊆ K₃ := by
        intro p' hp'
        rw [Metric.mem_closedBall] at hp ⊢
        rw [Metric.mem_ball] at hp'
        linarith [dist_triangle p' p q₀]
      have hmaps : Set.MapsTo Phi (Metric.ball p r) (Metric.closedBall (Phi p) (2 * M)) := by
        intro p' hp'
        rw [Metric.mem_closedBall, dist_eq_norm]
        calc ‖Phi p' - Phi p‖ ≤ ‖Phi p'‖ + ‖Phi p‖ := norm_sub_le _ _
          _ ≤ M + M := add_le_add (hPhi_le_M p' (hball_K₃ hp')) (hPhi_le_M p hp_K₃)
          _ = 2 * M := by ring
      exact Complex.norm_fderiv_le_div_of_mapsTo_ball
        (hPhi.mono (hball_K₃.trans hK₃_sub)) hmaps hr
    let s_nhd : Set (ℂ × ℂ) := Metric.ball q₀ r
    have hs_nhds : s_nhd ∈ nhds q₀ := Metric.ball_mem_nhds q₀ hr
    let c : ℝ → ℂ × ℂ := fun θ => (circleMap 0 r θ, 0)
    let κ : ℝ → ℂ := fun θ => (2 * (Real.pi : ℂ))⁻¹ * (circleMap 0 r θ)⁻¹
    have hc_cont : Continuous c := (continuous_circleMap 0 r).prodMk continuous_const
    have hcm_ne : ∀ θ : ℝ, circleMap 0 r θ ≠ 0 := fun θ => circleMap_ne_center hr.ne'
    have hκ_cont : Continuous κ :=
      continuous_const.mul ((continuous_circleMap 0 r).inv₀ hcm_ne)
    have hcm_norm : ∀ θ : ℝ, ‖circleMap 0 r θ‖ = r := by
      intro θ
      rw [norm_circleMap_zero, abs_of_pos hr]
    have hκ_norm : ∀ θ : ℝ, ‖κ θ‖ = (2 * Real.pi)⁻¹ * r⁻¹ := by
      intro θ
      dsimp [κ]
      rw [norm_mul, norm_inv, norm_inv, hcm_norm θ]
      congr 1
      have h2pi_nonneg : (0 : ℝ) ≤ 2 * Real.pi := by positivity
      calc ‖(2 * (Real.pi : ℂ))‖⁻¹ = ‖((2 * Real.pi : ℝ) : ℂ)‖⁻¹ := by push_cast; rfl
        _ = (2 * Real.pi)⁻¹ := by rw [Complex.norm_real, Real.norm_of_nonneg h2pi_nonneg]
    have h_slice_K₂ : ∀ q ∈ s_nhd, ∀ ζ ∈ Metric.closedBall q.1 r, (ζ, q.2) ∈ K₂ := by
      intro q hq ζ hζ
      rw [Metric.mem_ball] at hq
      rw [Metric.mem_closedBall] at hζ ⊢
      have hd1 : dist (ζ, q.2) q ≤ r := by
        rw [Prod.dist_eq, dist_self]
        exact max_le hζ hr.le
      linarith [dist_triangle (ζ, q.2) q q₀]
    have h_add_c_eq : ∀ (q : ℂ × ℂ) (θ : ℝ), (circleMap q.1 r θ, q.2) = q + c θ := by
      intro q θ
      apply Prod.ext
      · change circleMap q.1 r θ = q.1 + circleMap 0 r θ
        linear_combination circleMap_sub_center q.1 r θ
      · simp [c]
    have h_add_c_K₂ : ∀ q ∈ s_nhd, ∀ θ : ℝ, q + c θ ∈ K₂ := by
      intro q hq θ
      rw [← h_add_c_eq q θ]
      refine h_slice_K₂ q hq (circleMap q.1 r θ) ?_
      rw [Metric.mem_closedBall, dist_eq_norm, circleMap_sub_center, hcm_norm θ]
    have h_cauchy_eq : ∀ q ∈ s_nhd,
        deriv (fun z => Phi (z, q.2)) q.1 =
          ∫ θ in (0 : ℝ)..(2 * Real.pi), κ θ • Phi (q + c θ) := by
      intro q hq
      let U_q : Set ℂ := { ζ : ℂ | (ζ, q.2) ∈ Ω }
      have hUq_open : IsOpen U_q := hOpen.preimage (continuous_id.prodMk continuous_const)
      have hcb_sub : Metric.closedBall q.1 r ⊆ U_q := fun ζ hζ =>
        hK₂_sub (h_slice_K₂ q hq ζ hζ)
      have hg_diff : DifferentiableOn ℂ (fun z => Phi (z, q.2)) U_q :=
        hPhi.comp (differentiable_id.prodMk (differentiable_const q.2)).differentiableOn
          (fun _ hζ => hζ)
      have h_cif :=
        (Complex.two_pi_I_inv_smul_circleIntegral_sub_sq_inv_smul_of_differentiable
          hUq_open hcb_sub hg_diff (Metric.mem_ball_self hr)).symm
      rw [h_cif, circleIntegral_def_Icc, MeasureTheory.integral_Icc_eq_integral_Ioc,
        ← intervalIntegral.integral_of_le Real.two_pi_pos.le, ← intervalIntegral.integral_smul]
      refine intervalIntegral.integral_congr (fun θ _ => ?_)
      rw [deriv_circleMap, circleMap_sub_center, h_add_c_eq q θ]
      dsimp only [κ]
      simp only [smul_eq_mul]
      have hne_cm : circleMap 0 r θ ≠ 0 := hcm_ne θ
      have hne_2pi : (2 : ℂ) * (Real.pi : ℂ) ≠ 0 :=
        mul_ne_zero two_ne_zero (Complex.ofReal_ne_zero.mpr Real.pi_ne_zero)
      have hne_I : Complex.I ≠ 0 := Complex.I_ne_zero
      field_simp [hne_cm, hne_2pi, hne_I]
    let F : ℂ × ℂ → ℝ → ℂ := fun q θ => κ θ • Phi (q + c θ)
    let F' : ℂ × ℂ → ℝ → ((ℂ × ℂ) →L[ℂ] ℂ) := fun q θ => κ θ • fderiv ℂ Phi (q + c θ)
    let B : ℝ := ((2 * Real.pi)⁻¹ * r⁻¹) * (2 * M / r)
    have hF_cont : ∀ q ∈ s_nhd, Continuous (F q) := by
      intro q hq
      refine hκ_cont.smul ?_
      exact hPhi.continuousOn.comp_continuous (continuous_const.add hc_cont)
        (fun θ => hK₂_sub (h_add_c_K₂ q hq θ))
    have hF_meas : ∀ᶠ q in nhds q₀,
        MeasureTheory.AEStronglyMeasurable (F q)
          (MeasureTheory.volume.restrict (Set.uIoc 0 (2 * Real.pi))) := by
      refine Filter.eventually_of_mem hs_nhds (fun q hq => ?_)
      exact ((hF_cont q hq).continuousOn.aestronglyMeasurable measurableSet_uIcc).mono_measure
        (MeasureTheory.Measure.restrict_mono Set.uIoc_subset_uIcc le_rfl)
    have hFq₀_int : IntervalIntegrable (F q₀) MeasureTheory.volume 0 (2 * Real.pi) :=
      (hF_cont q₀ (Metric.mem_ball_self hr)).intervalIntegrable 0 (2 * Real.pi)
    have hF'q₀_meas :
        MeasureTheory.AEStronglyMeasurable (F' q₀)
          (MeasureTheory.volume.restrict (Set.uIoc 0 (2 * Real.pi))) := by
      have hm_fd : MeasureTheory.AEStronglyMeasurable
          (fun θ => fderiv ℂ Phi (q₀ + c θ))
          (MeasureTheory.volume.restrict (Set.uIoc 0 (2 * Real.pi))) :=
        ((measurable_fderiv ℂ Phi).comp
          (continuous_const.add hc_cont).measurable).aestronglyMeasurable
      exact hκ_cont.measurable.aestronglyMeasurable.smul hm_fd
    have hF'_bound : ∀ᵐ θ ∂MeasureTheory.volume, θ ∈ Set.uIoc 0 (2 * Real.pi) →
        ∀ q ∈ s_nhd, ‖F' q θ‖ ≤ B := by
      refine Filter.Eventually.of_forall (fun θ _ q hq => ?_)
      dsimp only [F', B]
      rw [norm_smul, hκ_norm θ]
      exact mul_le_mul_of_nonneg_left (hfderiv_le (q + c θ) (h_add_c_K₂ q hq θ)) (by positivity)
    have hB_int : IntervalIntegrable (fun _ : ℝ => B) MeasureTheory.volume 0 (2 * Real.pi) :=
      intervalIntegrable_const
    have h_int_fderiv :=
      intervalIntegral.hasFDerivAt_integral_of_dominated_of_fderiv_le
        (F := F) (F' := F') hs_nhds hF_meas hFq₀_int hF'q₀_meas hF'_bound hB_int
        (Filter.Eventually.of_forall (fun θ _ q hq => by
          have h_at : DifferentiableAt ℂ Phi (q + c θ) :=
            hPhi.differentiableAt (hOpen.mem_nhds (hK₂_sub (h_add_c_K₂ q hq θ)))
          have h_comp := h_at.hasFDerivAt.comp q ((hasFDerivAt_id q).add_const (c θ))
          rw [ContinuousLinearMap.comp_id] at h_comp
          exact h_comp.const_smul (κ θ)))
    have h_ev :
        (fun q : ℂ × ℂ => ∫ θ in (0 : ℝ)..(2 * Real.pi), F q θ) =ᶠ[nhds q₀]
          (fun q : ℂ × ℂ => deriv (fun z => Phi (z, q.2)) q.1) :=
      Filter.eventually_of_mem hs_nhds (fun q hq => (h_cauchy_eq q hq).symm)
    exact (h_int_fderiv.differentiableAt.congr_of_eventuallyEq h_ev.symm).differentiableWithinAt
  refine ⟨?_, ?_⟩
  · intro Ω Phi hOpen hPhi
    refine ⟨h_partial_1 Ω Phi hOpen hPhi, ?_⟩
    let σ : (ℂ × ℂ) ≃L[ℂ] (ℂ × ℂ) := ContinuousLinearEquiv.prodComm ℂ ℂ ℂ
    let Ω' : Set (ℂ × ℂ) := σ ⁻¹' Ω
    have hΩ'_open : IsOpen Ω' := hOpen.preimage σ.continuous
    have hPsi : DifferentiableOn ℂ (fun p => Phi (σ p)) Ω' :=
      hPhi.comp σ.differentiable.differentiableOn (fun _ hp => hp)
    have h1 := h_partial_1 Ω' (fun p => Phi (σ p)) hΩ'_open hPsi
    exact h1.comp σ.differentiable.differentiableOn (fun q hq => by simpa [Ω', σ] using hq)
  · intro H₁ r_sub F₁ F₂ hH₁ hr hF₁ hF₂ hReal
    let S₁ : Set ℂ := horizStrip H₁
    let B_t : Set ℂ := Metric.ball (0 : ℂ) r_sub
    have hStage1 : ∀ (x : ℝ), ∀ t ∈ B_t, F₁ ((x : ℂ), t) = F₂ ((x : ℂ), t) := by
      intro x t ht_mem
      have hx_S₁ : (x : ℂ) ∈ S₁ := by simpa [S₁, horizStrip] using hH₁
      have h_emb : Differentiable ℂ (fun τ : ℂ => ((x : ℂ), τ)) :=
        (differentiable_const (x : ℂ)).prodMk differentiable_id
      have h_maps : Set.MapsTo (fun τ : ℂ => ((x : ℂ), τ)) B_t (S₁ ×ˢ B_t) :=
        fun τ hτ => ⟨hx_S₁, hτ⟩
      have hg₁_ana : AnalyticOnNhd ℂ (fun τ => F₁ ((x : ℂ), τ)) B_t :=
        (hF₁.comp h_emb.differentiableOn h_maps).analyticOnNhd Metric.isOpen_ball
      have hg₂_ana : AnalyticOnNhd ℂ (fun τ => F₂ ((x : ℂ), τ)) B_t :=
        (hF₂.comp h_emb.differentiableOn h_maps).analyticOnNhd Metric.isOpen_ball
      have hfreq_t : ∃ᶠ τ : ℂ in nhdsWithin (0 : ℂ) {(0 : ℂ)}ᶜ,
          F₁ ((x : ℂ), τ) = F₂ ((x : ℂ), τ) := by
        rw [Filter.frequently_iff]
        intro V hV
        obtain ⟨ε, hε_pos, hε_sub⟩ := Metric.mem_nhdsWithin_iff.mp hV
        let t₀ : ℝ := min (ε / 2) (r_sub / 2)
        have ht₀_pos : 0 < t₀ := lt_min (by positivity) (by positivity)
        have ht₀_lt_ε : t₀ < ε := lt_of_le_of_lt (min_le_left _ _) (by linarith)
        have ht₀_lt_r : t₀ < r_sub := lt_of_le_of_lt (min_le_right _ _) (by linarith)
        refine ⟨(t₀ : ℂ), hε_sub ⟨?_, ?_⟩, hReal x t₀ ht₀_pos ht₀_lt_r⟩
        · rw [mem_ball_zero_iff, Complex.norm_real, Real.norm_of_nonneg ht₀_pos.le]
          exact ht₀_lt_ε
        · exact Complex.ofReal_ne_zero.mpr ht₀_pos.ne'
      exact hg₁_ana.eqOn_of_preconnected_of_frequently_eq hg₂_ana
        (convex_ball (0 : ℂ) r_sub).isPreconnected (Metric.mem_ball_self hr) hfreq_t ht_mem
    have hS₁_open : IsOpen S₁ :=
      isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const
    have hS₁_eq : S₁ = Complex.imCLM.toLinearMap ⁻¹' Set.Ioo (-H₁) H₁ := by
      ext s
      simp [S₁, horizStrip, abs_lt]
    have hS₁_preconn : IsPreconnected S₁ := by
      rw [hS₁_eq]
      exact ((convex_Ioo (-H₁) H₁).linear_preimage Complex.imCLM.toLinearMap).isPreconnected
    have h0_S₁ : (0 : ℂ) ∈ S₁ := by simpa [S₁, horizStrip] using hH₁
    intro y t hy ht
    have ht_mem : t ∈ B_t := mem_ball_zero_iff.mpr ht
    have h_emb_y : Differentiable ℂ (fun z : ℂ => (z, t)) :=
      differentiable_id.prodMk (differentiable_const t)
    have h_maps_y : Set.MapsTo (fun z : ℂ => (z, t)) S₁ (S₁ ×ˢ B_t) :=
      fun z hz => ⟨hz, ht_mem⟩
    have hh₁_ana : AnalyticOnNhd ℂ (fun z => F₁ (z, t)) S₁ :=
      (hF₁.comp h_emb_y.differentiableOn h_maps_y).analyticOnNhd hS₁_open
    have hh₂_ana : AnalyticOnNhd ℂ (fun z => F₂ (z, t)) S₁ :=
      (hF₂.comp h_emb_y.differentiableOn h_maps_y).analyticOnNhd hS₁_open
    have hfreq_y : ∃ᶠ z : ℂ in nhdsWithin (0 : ℂ) {(0 : ℂ)}ᶜ,
        F₁ (z, t) = F₂ (z, t) := by
      rw [Filter.frequently_iff]
      intro V hV
      obtain ⟨ε, hε_pos, hε_sub⟩ := Metric.mem_nhdsWithin_iff.mp hV
      let x₀ : ℝ := ε / 2
      have hx₀_pos : 0 < x₀ := by positivity
      have hx₀_lt_ε : x₀ < ε := by dsimp [x₀]; linarith
      refine ⟨(x₀ : ℂ), hε_sub ⟨?_, ?_⟩, hStage1 x₀ t ht_mem⟩
      · rw [mem_ball_zero_iff, Complex.norm_real, Real.norm_of_nonneg hx₀_pos.le]
        exact hx₀_lt_ε
      · exact Complex.ofReal_ne_zero.mpr hx₀_pos.ne'
    exact hh₁_ana.eqOn_of_preconnected_of_frequently_eq hh₂_ana
      hS₁_preconn h0_S₁ hfreq_y hy

theorem strip_geometric_action_and_exact_recurrence (S : FiniteWallNonisotropicStrip)
    (hVolt : SfcaVolterraKernelProp)
    (hUniv : SfcaUniversalChordProp)
    (hOpen : IsOpen (smallChordDomain S sfcaEtaSL))
    (hHolo : DifferentiableOn ℂ (sfcaStripPhi S) (smallChordDomain S sfcaEtaSL)) :
    ∀ H₁ : ℝ, 0 < H₁ → H₁ < S.H →
      ∃ r_sub : ℝ, 0 < r_sub ∧ r_sub < S.r_star ∧
        ∀ y t : ℂ, y ∈ horizStrip H₁ → ‖t‖ < r_sub →
          (y, t) ∈ finiteWallTube S.r_star S.h_X ∧
          (y + t, t) ∈ finiteWallTube S.r_star S.h_X ∧
          (y - t, t) ∈ finiteWallTube S.r_star S.h_X ∧
          (t ≠ 0 →
            let s_m := S.𝔰 (y - t, t)
            let s_0 := S.𝔰 (y, t)
            let s_p := S.𝔰 (y + t, t)
            let J_m := (s_0 - s_m) / t
            let J_p := (s_p - s_0) / t
            (s_m, s_0 - s_m) ∈ smallChordDomain S sfcaEtaSL ∧
            (s_0, s_p - s_0) ∈ smallChordDomain S sfcaEtaSL ∧
            ‖J_m - 1‖ < 1 / 16 ∧
            ‖J_p - 1‖ < 1 / 16 ∧
            deriv (fun J' => smallChordActionP (sfcaStripPhi S) s_0 J' t) J_p -
              t * deriv (fun s' => smallChordActionP (sfcaStripPhi S) s' J_p t) s_0 =
              deriv (fun J' => smallChordActionP (sfcaStripPhi S) s_m J' t) J_m) :=
by
  intro H₁ hH₁_pos hH₁_lt
  obtain ⟨r_sub, J_m_tilde, J_p_tilde, hr_pos, hr_lt, hJm_holo, hJp_holo, hSub⟩ :=
    substrip_displacement_and_domain_bounds S H₁ hH₁_pos hH₁_lt
  obtain ⟨hPartHolo, hCont2D⟩ := bivar_partial_holo_and_real_slice_continuation
  obtain ⟨hPhi₁_holo, hPhi₂_holo⟩ :=
    hPartHolo (smallChordDomain S sfcaEtaSL) (sfcaStripPhi S) hOpen hHolo
  let Φ₁ : ℂ × ℂ → ℂ := fun q => deriv (fun z => sfcaStripPhi S (z, q.2)) q.1
  let Φ₂ : ℂ × ℂ → ℂ := fun q => deriv (fun w => sfcaStripPhi S (q.1, w)) q.2
  have h_deriv_s : ∀ s J t : ℂ,
      deriv (fun s' => smallChordActionP (sfcaStripPhi S) s' J t) s =
        J ^ 3 * Φ₁ (s, t * J) := by
    intro s J t
    change deriv (fun s' => J ^ 3 * sfcaStripPhi S (s', t * J)) s =
      J ^ 3 * deriv (fun z => sfcaStripPhi S (z, t * J)) s
    exact deriv_const_mul_field (J ^ 3)
  have h_deriv_J : ∀ s J t : ℂ, (s, t * J) ∈ smallChordDomain S sfcaEtaSL →
      deriv (fun J' => smallChordActionP (sfcaStripPhi S) s J' t) J =
        3 * J ^ 2 * sfcaStripPhi S (s, t * J) + J ^ 3 * (Φ₂ (s, t * J) * t) := by
    intro s J t hdom
    have hPhi_at : DifferentiableAt ℂ (sfcaStripPhi S) (s, t * J) :=
      hHolo.differentiableAt (hOpen.mem_nhds hdom)
    have h_pair : DifferentiableAt ℂ (fun w : ℂ => (s, w)) (t * J) := by fun_prop
    have h_w : HasDerivAt (fun w : ℂ => sfcaStripPhi S (s, w)) (Φ₂ (s, t * J)) (t * J) :=
      (hPhi_at.comp (t * J) h_pair).hasDerivAt
    have h_lin : HasDerivAt (fun J' : ℂ => t * J') t J := by
      simpa using (hasDerivAt_id J).const_mul t
    have h_comp : HasDerivAt (fun J' : ℂ => sfcaStripPhi S (s, t * J'))
        (Φ₂ (s, t * J) * t) J :=
      h_w.comp J h_lin
    have h_pow : HasDerivAt (fun J' : ℂ => J' ^ 3) (3 * J ^ 2) J := by
      simpa using hasDerivAt_pow 3 J
    have h_prod : HasDerivAt (fun J' : ℂ => smallChordActionP (sfcaStripPhi S) s J' t)
        (3 * J ^ 2 * sfcaStripPhi S (s, t * J) + J ^ 3 * (Φ₂ (s, t * J) * t)) J :=
      h_pow.mul h_comp
    exact h_prod.deriv
  let U₁ : Set (ℂ × ℂ) := horizStrip H₁ ×ˢ Metric.ball (0 : ℂ) r_sub
  let μ_p : ℂ × ℂ → ℂ × ℂ := fun p => (S.𝔰 p, p.2 * J_p_tilde p)
  let shift_m : ℂ × ℂ → ℂ × ℂ := fun p => (p.1 - p.2, p.2)
  let μ_m : ℂ × ℂ → ℂ × ℂ := fun p => (S.𝔰 (shift_m p), p.2 * J_m_tilde p)
  let LHS_ext : ℂ × ℂ → ℂ := fun p =>
    (3 * (J_p_tilde p) ^ 2 * sfcaStripPhi S (μ_p p) +
      (J_p_tilde p) ^ 3 * (Φ₂ (μ_p p) * p.2)) -
    p.2 * ((J_p_tilde p) ^ 3 * Φ₁ (μ_p p))
  let RHS_ext : ℂ × ℂ → ℂ := fun p =>
    3 * (J_m_tilde p) ^ 2 * sfcaStripPhi S (μ_m p) +
      (J_m_tilde p) ^ 3 * (Φ₂ (μ_m p) * p.2)
  have h_𝔰_0_holo : DifferentiableOn ℂ S.𝔰 U₁ :=
    S.𝔰_holo.mono (fun p hp => (hSub p.1 p.2 hp.1 (mem_ball_zero_iff.mp hp.2)).1)
  have h_shift_m_holo : DifferentiableOn ℂ shift_m U₁ := by
    dsimp [shift_m]
    fun_prop
  have h_𝔰_m_holo : DifferentiableOn ℂ (fun p => S.𝔰 (shift_m p)) U₁ :=
    S.𝔰_holo.comp h_shift_m_holo
      (fun p hp => (hSub p.1 p.2 hp.1 (mem_ball_zero_iff.mp hp.2)).2.2.1)
  have h_snd_holo : DifferentiableOn ℂ (fun p : ℂ × ℂ => p.2) U₁ := by fun_prop
  have h_μ_p_holo : DifferentiableOn ℂ μ_p U₁ :=
    h_𝔰_0_holo.prodMk (h_snd_holo.mul hJp_holo)
  have h_μ_p_maps : Set.MapsTo μ_p U₁ (smallChordDomain S sfcaEtaSL) :=
    fun p hp => (hSub p.1 p.2 hp.1 (mem_ball_zero_iff.mp hp.2)).2.2.2.2.2.2.1
  have h_μ_m_holo : DifferentiableOn ℂ μ_m U₁ :=
    h_𝔰_m_holo.prodMk (h_snd_holo.mul hJm_holo)
  have h_μ_m_maps : Set.MapsTo μ_m U₁ (smallChordDomain S sfcaEtaSL) :=
    fun p hp => (hSub p.1 p.2 hp.1 (mem_ball_zero_iff.mp hp.2)).2.2.2.2.2.1
  have hPhi_p_holo : DifferentiableOn ℂ (fun p => sfcaStripPhi S (μ_p p)) U₁ :=
    hHolo.comp h_μ_p_holo h_μ_p_maps
  have hPhi₁_p_holo : DifferentiableOn ℂ (fun p => Φ₁ (μ_p p)) U₁ :=
    hPhi₁_holo.comp h_μ_p_holo h_μ_p_maps
  have hPhi₂_p_holo : DifferentiableOn ℂ (fun p => Φ₂ (μ_p p)) U₁ :=
    hPhi₂_holo.comp h_μ_p_holo h_μ_p_maps
  have hPhi_m_holo : DifferentiableOn ℂ (fun p => sfcaStripPhi S (μ_m p)) U₁ :=
    hHolo.comp h_μ_m_holo h_μ_m_maps
  have hPhi₂_m_holo : DifferentiableOn ℂ (fun p => Φ₂ (μ_m p)) U₁ :=
    hPhi₂_holo.comp h_μ_m_holo h_μ_m_maps
  have hLHS_holo : DifferentiableOn ℂ LHS_ext U₁ := by
    refine (((hJp_holo.pow 2).const_mul 3).mul hPhi_p_holo |>.add
      ((hJp_holo.pow 3).mul (hPhi₂_p_holo.mul h_snd_holo))).sub ?_
    exact h_snd_holo.mul ((hJp_holo.pow 3).mul hPhi₁_p_holo)
  have hRHS_holo : DifferentiableOn ℂ RHS_ext U₁ :=
    (((hJm_holo.pow 2).const_mul 3).mul hPhi_m_holo).add
      ((hJm_holo.pow 3).mul (hPhi₂_m_holo.mul h_snd_holo))
  have h_bridge : ∀ y t : ℂ, y ∈ horizStrip H₁ → ‖t‖ < r_sub → t ≠ 0 →
      LHS_ext (y, t) =
        deriv (fun J' => smallChordActionP (sfcaStripPhi S) (S.𝔰 (y, t)) J' t)
          ((S.𝔰 (y + t, t) - S.𝔰 (y, t)) / t) -
        t * deriv (fun s' => smallChordActionP (sfcaStripPhi S) s'
          ((S.𝔰 (y + t, t) - S.𝔰 (y, t)) / t) t) (S.𝔰 (y, t)) ∧
      RHS_ext (y, t) =
        deriv (fun J' => smallChordActionP (sfcaStripPhi S) (S.𝔰 (y - t, t)) J' t)
          ((S.𝔰 (y, t) - S.𝔰 (y - t, t)) / t) := by
    intro y t hy ht ht_ne
    have hSub_yt := hSub y t hy ht
    have hJm_mul : t * J_m_tilde (y, t) = S.𝔰 (y, t) - S.𝔰 (y - t, t) := hSub_yt.2.2.2.1
    have hJp_mul : t * J_p_tilde (y, t) = S.𝔰 (y + t, t) - S.𝔰 (y, t) := hSub_yt.2.2.2.2.1
    have hdom_m' : (S.𝔰 (y - t, t), t * J_m_tilde (y, t)) ∈ smallChordDomain S sfcaEtaSL :=
      hSub_yt.2.2.2.2.2.1
    have hdom_p' : (S.𝔰 (y, t), t * J_p_tilde (y, t)) ∈ smallChordDomain S sfcaEtaSL :=
      hSub_yt.2.2.2.2.2.2.1
    have hJm_eq : J_m_tilde (y, t) = (S.𝔰 (y, t) - S.𝔰 (y - t, t)) / t :=
      eq_div_of_mul_eq ht_ne (by rw [mul_comm]; exact hJm_mul)
    have hJp_eq : J_p_tilde (y, t) = (S.𝔰 (y + t, t) - S.𝔰 (y, t)) / t :=
      eq_div_of_mul_eq ht_ne (by rw [mul_comm]; exact hJp_mul)
    have hdJ_p := h_deriv_J (S.𝔰 (y, t)) (J_p_tilde (y, t)) t hdom_p'
    have hds_p := h_deriv_s (S.𝔰 (y, t)) (J_p_tilde (y, t)) t
    have hdJ_m := h_deriv_J (S.𝔰 (y - t, t)) (J_m_tilde (y, t)) t hdom_m'
    constructor
    · dsimp only [LHS_ext, μ_p]
      rw [← hdJ_p, ← hds_p, hJp_eq]
    · dsimp only [RHS_ext, μ_m, shift_m]
      rw [← hdJ_m, hJm_eq]
  have hGeom := real_chord_arc_minus_chord_identity S hVolt hUniv
  have h_real_eq : ∀ x t : ℝ, 0 < t → t < r_sub →
      LHS_ext ((x : ℂ), (t : ℂ)) = RHS_ext ((x : ℂ), (t : ℂ)) := by
    intro x t ht_pos ht_lt
    have hx_mem : (x : ℂ) ∈ horizStrip H₁ := by
      simpa [horizStrip] using hH₁_pos
    have ht_norm : ‖(t : ℂ)‖ < r_sub := by
      rw [Complex.norm_real, Real.norm_of_nonneg ht_pos.le]
      exact ht_lt
    have ht_ne : (t : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr ht_pos.ne'
    have hSub_xt := hSub (x : ℂ) (t : ℂ) hx_mem ht_norm
    have hdom_m :
        (S.𝔰 ((x : ℂ) - (t : ℂ), (t : ℂ)),
          S.𝔰 ((x : ℂ), (t : ℂ)) - S.𝔰 ((x : ℂ) - (t : ℂ), (t : ℂ))) ∈
            smallChordDomain S sfcaEtaSL := by
      rw [← hSub_xt.2.2.2.1]
      exact hSub_xt.2.2.2.2.2.1
    have hdom_p :
        (S.𝔰 ((x : ℂ), (t : ℂ)),
          S.𝔰 ((x : ℂ) + (t : ℂ), (t : ℂ)) - S.𝔰 ((x : ℂ), (t : ℂ))) ∈
            smallChordDomain S sfcaEtaSL := by
      rw [← hSub_xt.2.2.2.2.1]
      exact hSub_xt.2.2.2.2.2.2.1
    obtain ⟨hL_br, hR_br⟩ := h_bridge (x : ℂ) (t : ℂ) hx_mem ht_norm ht_ne
    rw [hL_br, hR_br]
    exact real_collar_stationary_action_recurrence S hOpen hHolo hGeom
      x t ht_pos (lt_trans ht_lt hr_lt) hdom_m hdom_p
  have h_all_eq : ∀ y t : ℂ, y ∈ horizStrip H₁ → ‖t‖ < r_sub →
      LHS_ext (y, t) = RHS_ext (y, t) :=
    hCont2D H₁ r_sub LHS_ext RHS_ext hH₁_pos hr_pos hLHS_holo hRHS_holo h_real_eq
  refine ⟨r_sub, hr_pos, hr_lt, ?_⟩
  intro y t hy ht
  have hSub_yt := hSub y t hy ht
  refine ⟨hSub_yt.1, hSub_yt.2.1, hSub_yt.2.2.1, ?_⟩
  intro ht_ne
  have hJm_eq : J_m_tilde (y, t) = (S.𝔰 (y, t) - S.𝔰 (y - t, t)) / t :=
    eq_div_of_mul_eq ht_ne (by rw [mul_comm]; exact hSub_yt.2.2.2.1)
  have hJp_eq : J_p_tilde (y, t) = (S.𝔰 (y + t, t) - S.𝔰 (y, t)) / t :=
    eq_div_of_mul_eq ht_ne (by rw [mul_comm]; exact hSub_yt.2.2.2.2.1)
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · rw [← hSub_yt.2.2.2.1]
    exact hSub_yt.2.2.2.2.2.1
  · rw [← hSub_yt.2.2.2.2.1]
    exact hSub_yt.2.2.2.2.2.2.1
  · rw [← hJm_eq]
    exact hSub_yt.2.2.2.2.2.2.2.1
  · rw [← hJp_eq]
    exact hSub_yt.2.2.2.2.2.2.2.2
  · obtain ⟨hL_br, hR_br⟩ := h_bridge y t hy ht ht_ne
    rw [← hL_br, ← hR_br]
    exact h_all_eq y t hy ht

theorem small_field_chord_action_and_frozen_limits (S : FiniteWallNonisotropicStrip) :
    Nonempty (SmallFieldChordActionData S) :=
by
  have hVolt : SfcaVolterraKernelProp := volterra_unit_interval_kernels
  have hUniv : SfcaUniversalChordProp := universal_chord_functional_and_frozen_bounds hVolt
  obtain ⟨C_univ, hC_pos, hUnivBounds⟩ := hUniv.exists_lip_bounds
  obtain ⟨hOpen, hHolo, hRev⟩ := strip_chord_domain_and_holomorphy S hVolt hUniv
  have hRec := strip_geometric_action_and_exact_recurrence S hVolt hUniv hOpen hHolo
  have hPotCont : ∀ s h : ℂ, (s, h) ∈ smallChordDomain S sfcaEtaSL →
      ContinuousOn (sfcaStripPot S s h) (Set.Icc (0 : ℝ) 1) := by
    intro s h hq
    have hs : |s.im| < S.H := hq.1
    have hsh : |(s + h).im| < S.H := hq.2.1
    have hMaps : Set.MapsTo (fun w : ℝ => s + (w : ℂ) * h) (Set.Icc (0 : ℝ) 1) (horizStrip S.H) := by
      intro w hw
      rcases hw with ⟨hw0, hw1⟩
      change |(s + (w : ℂ) * h).im| < S.H
      have him : (s + (w : ℂ) * h).im = (1 - w) * s.im + w * (s + h).im := by
        simp [Complex.add_im, Complex.mul_im]
        ring
      rw [him, abs_lt]
      rw [abs_lt] at hs hsh
      rcases hs with ⟨hs_lo, hs_hi⟩
      rcases hsh with ⟨hsh_lo, hsh_hi⟩
      rcases eq_or_lt_of_le hw0 with rfl | hw_pos
      · simp [hs_lo, hs_hi]
      · have h1w : 0 ≤ 1 - w := by linarith
        constructor <;> nlinarith
    have hSegCont : ContinuousOn (fun w : ℝ => s + (w : ℂ) * h) (Set.Icc (0 : ℝ) 1) :=
      (continuous_const.add (Complex.continuous_ofReal.mul continuous_const)).continuousOn
    exact continuousOn_const.mul (S.q_holo.continuousOn.comp' hSegCont hMaps)
  refine ⟨{
    η_SL := sfcaEtaSL
    C_SL := C_univ
    Phi := sfcaStripPhi S
    η_SL_pos := by norm_num [sfcaEtaSL]
    η_SL_lt := by norm_num [sfcaEtaSL]
    C_SL_pos := hC_pos
    domain_open := hOpen
    Phi_holo := hHolo
    Phi_zero := ?_
    Phi_rev := hRev
    Phi_bound := ?_
    Phi_approx_first := ?_
    Phi_approx_second := ?_
    exact_recurrence := hRec
  }⟩
  · intro s _hs
    have hPot0 : sfcaStripPot S s 0 = fun _ => 0 := by
      ext w
      simp [sfcaStripPot]
    simpa [sfcaStripPhi, hPot0] using hUniv.frozen_evals.1
  · intro s h M_q hq hMq_nonneg hMq
    exact ((hUnivBounds (sfcaStripPot S s h) (h * S.f s) (h ^ 2 * deriv S.f s)
      (hPotCont s h hq) hq.2.2.2.2 hq.2.2.1 hq.2.2.2.1).1 M_q hMq_nonneg hMq).1
  · intro s h M_q hq hMq_nonneg hMq
    exact ((hUnivBounds (sfcaStripPot S s h) (h * S.f s) (h ^ 2 * deriv S.f s)
      (hPotCont s h hq) hq.2.2.2.2 hq.2.2.1 hq.2.2.2.1).1 M_q hMq_nonneg hMq).2
  · intro s h μ M_diff hq hμ hMdiff_nonneg hMdiff
    exact (hUnivBounds (sfcaStripPot S s h) (h * S.f s) (h ^ 2 * deriv S.f s)
      (hPotCont s h hq) hq.2.2.2.2 hq.2.2.1 hq.2.2.2.1).2 μ M_diff hμ hMdiff_nonneg hMdiff

theorem steep_action_perturbation_jets (S : FiniteWallNonisotropicStrip)
    (A : SmallFieldChordActionData S) :
    SteepContJetProp S A :=
by
  let U₂ : Set (ℂ × ℂ) := smallChordDomain S A.η_SL
  let W₃ : Set (ℂ × ℂ × ℂ) := steepContTripleDomain S A.η_SL
  let π : ℂ × ℂ × ℂ → ℂ × ℂ := fun q => (q.1, q.2.2 * q.2.1)
  have hπ_diff : Differentiable ℂ π :=
    differentiable_fst.prodMk
      ((differentiable_snd.comp differentiable_snd).mul
        (differentiable_fst.comp differentiable_snd))
  have hW₃_open : IsOpen W₃ := A.domain_open.preimage hπ_diff.continuous

  have h_param_holo : ∀ (a b : ℝ) (W : Set (ℂ × ℂ)) (F : ℝ → ℂ × ℂ → ℂ),
      IsOpen W →
      ContinuousOn (fun q : ℝ × (ℂ × ℂ) => F q.1 q.2) (Set.uIcc a b ×ˢ W) →
      (∀ τ ∈ Set.uIcc a b, DifferentiableOn ℂ (F τ) W) →
      DifferentiableOn ℂ (fun p : ℂ × ℂ => ∫ τ in a..b, F τ p) W := by
    intro a b W F hW hCont hHolo p₀ hp₀
    obtain ⟨ε, hε, hε_sub⟩ := Metric.isOpen_iff.mp hW p₀ hp₀
    let r : ℝ := ε / 3
    have hr : 0 < r := by positivity
    have h2r_lt : 2 * r < ε := by dsimp only [r]; linarith
    have h2r_sub : Metric.closedBall p₀ (2 * r) ⊆ W :=
      (Metric.closedBall_subset_ball h2r_lt).trans hε_sub
    have hK_compact : IsCompact (Set.uIcc a b ×ˢ Metric.closedBall p₀ (2 * r)) :=
      isCompact_uIcc.prod (isCompact_closedBall p₀ (2 * r))
    have hK_sub : Set.uIcc a b ×ˢ Metric.closedBall p₀ (2 * r) ⊆ Set.uIcc a b ×ˢ W :=
      Set.prod_mono Subset.rfl h2r_sub
    obtain ⟨C₀, hC₀⟩ := hK_compact.exists_bound_of_continuousOn (hCont.mono hK_sub)
    let M : ℝ := max C₀ 0
    have hM_bound : ∀ τ ∈ Set.uIcc a b, ∀ q ∈ Metric.closedBall p₀ (2 * r), ‖F τ q‖ ≤ M := by
      intro τ hτ q hq
      exact (hC₀ (τ, q) ⟨hτ, hq⟩).trans (le_max_left _ _)
    let s : Set (ℂ × ℂ) := Metric.ball p₀ r
    have hs_nhds : s ∈ nhds p₀ := Metric.ball_mem_nhds p₀ hr
    have hs_2r : ∀ p ∈ s, ∀ q ∈ Metric.ball p r, q ∈ Metric.closedBall p₀ (2 * r) := by
      intro p hp q hq
      rw [Metric.mem_closedBall]
      have hp' : dist p p₀ < r := hp
      have hq' : dist q p < r := hq
      linarith [dist_triangle q p p₀]
    have hs_sub : s ⊆ W := fun p hp =>
      h2r_sub (Metric.ball_subset_closedBall
        (Metric.mem_ball.mpr (by linarith [Metric.mem_ball.mp hp])))
    have h_slice_cont : ∀ p ∈ W, ContinuousOn (fun τ : ℝ => F τ p) (Set.uIcc a b) := fun p hp =>
      hCont.comp (continuous_id.prodMk continuous_const).continuousOn (fun τ hτ => ⟨hτ, hp⟩)
    let μ₀ : MeasureTheory.Measure ℝ := MeasureTheory.volume.restrict (Set.uIoc a b)
    have hμ_le : μ₀ ≤ MeasureTheory.volume.restrict (Set.uIcc a b) :=
      MeasureTheory.Measure.restrict_mono Set.uIoc_subset_uIcc le_rfl
    have hF_meas : ∀ᶠ p in nhds p₀, MeasureTheory.AEStronglyMeasurable (fun τ => F τ p) μ₀ := by
      filter_upwards [hs_nhds] with p hp
      exact ((h_slice_cont p (hs_sub hp)).aestronglyMeasurable measurableSet_uIcc).mono_measure hμ_le
    have hF_int : IntervalIntegrable (fun τ => F τ p₀) MeasureTheory.volume a b :=
      (h_slice_cont p₀ hp₀).intervalIntegrable
    let δ : ℕ → ℝ := fun n => (1 / ((n : ℝ) + 1)) * (r / 2)
    let h : ℕ → ℂ := fun n => ((δ n : ℝ) : ℂ)
    have hδ_pos : ∀ n : ℕ, 0 < δ n := fun n => by positivity
    have hδ_lt : ∀ n : ℕ, δ n < r := by
      intro n
      have hn : (1 : ℝ) ≤ (n : ℝ) + 1 := by linarith [(Nat.cast_nonneg n : (0 : ℝ) ≤ n)]
      have h1 : 1 / ((n : ℝ) + 1) ≤ 1 := div_le_one_of_le₀ hn (by positivity)
      dsimp only [δ]
      nlinarith
    have hh_ne : ∀ n : ℕ, h n ≠ 0 := fun n => Complex.ofReal_ne_zero.mpr (hδ_pos n).ne'
    have hh_norm : ∀ n : ℕ, ‖h n‖ < r := by
      intro n
      rw [Complex.norm_real, Real.norm_of_nonneg (hδ_pos n).le]
      exact hδ_lt n
    let e₁ : ℂ × ℂ := ((1 : ℂ), (0 : ℂ))
    let e₂ : ℂ × ℂ := ((0 : ℂ), (1 : ℂ))
    have hp1_mem : ∀ n : ℕ, p₀ + h n • e₁ ∈ W := by
      intro n
      apply hs_sub
      rw [Metric.mem_ball, dist_self_add_left, Prod.norm_def]
      simp [e₁, hh_norm n]
    have hp2_mem : ∀ n : ℕ, p₀ + h n • e₂ ∈ W := by
      intro n
      apply hs_sub
      rw [Metric.mem_ball, dist_self_add_left, Prod.norm_def]
      simp [e₂, hh_norm n]
    have hh_tendsto : Filter.Tendsto h Filter.atTop (nhdsWithin (0 : ℂ) {(0 : ℂ)}ᶜ) := by
      rw [tendsto_nhdsWithin_iff]
      refine ⟨?_, Filter.Eventually.of_forall
        (fun n => Set.mem_compl_singleton_iff.mpr (hh_ne n))⟩
      have h0 : Filter.Tendsto δ Filter.atTop (nhds (0 : ℝ)) := by
        simpa [δ] using tendsto_one_div_add_atTop_nhds_zero_nat.mul_const (r / 2)
      simpa [h, Function.comp_def] using (Complex.continuous_ofReal.tendsto 0).comp h0
    let g_seq : ℕ → ℝ → ((ℂ × ℂ) →L[ℂ] ℂ) := fun n τ =>
      ((h n)⁻¹ • (F τ (p₀ + h n • e₁) - F τ p₀)) • ContinuousLinearMap.fst ℂ ℂ ℂ +
      ((h n)⁻¹ • (F τ (p₀ + h n • e₂) - F τ p₀)) • ContinuousLinearMap.snd ℂ ℂ ℂ
    have hg_meas : ∀ n : ℕ, MeasureTheory.AEStronglyMeasurable (g_seq n) μ₀ := by
      intro n
      have hc1 : ContinuousOn
          (fun τ => (h n)⁻¹ • (F τ (p₀ + h n • e₁) - F τ p₀)) (Set.uIcc a b) :=
        (continuousOn_const (c := (h n)⁻¹)).smul
          ((h_slice_cont _ (hp1_mem n)).sub (h_slice_cont p₀ hp₀))
      have hc2 : ContinuousOn
          (fun τ => (h n)⁻¹ • (F τ (p₀ + h n • e₂) - F τ p₀)) (Set.uIcc a b) :=
        (continuousOn_const (c := (h n)⁻¹)).smul
          ((h_slice_cont _ (hp2_mem n)).sub (h_slice_cont p₀ hp₀))
      have hcg : ContinuousOn (g_seq n) (Set.uIcc a b) :=
        (hc1.smul (continuousOn_const (c := ContinuousLinearMap.fst ℂ ℂ ℂ))).add
          (hc2.smul (continuousOn_const (c := ContinuousLinearMap.snd ℂ ℂ ℂ)))
      exact (hcg.aestronglyMeasurable measurableSet_uIcc).mono_measure hμ_le
    have hF'_meas : MeasureTheory.AEStronglyMeasurable (fun τ => fderiv ℂ (F τ) p₀) μ₀ := by
      refine aestronglyMeasurable_of_tendsto_ae Filter.atTop hg_meas ?_
      filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_uIoc] with τ hτ_ioc
      have hτ : τ ∈ Set.uIcc a b := Set.uIoc_subset_uIcc hτ_ioc
      have hFD : HasFDerivAt (F τ) (fderiv ℂ (F τ) p₀) p₀ :=
        ((hHolo τ hτ).differentiableAt (hW.mem_nhds hp₀)).hasFDerivAt
      have ht1 :=
        (hasLineDerivAt_iff_tendsto_slope_zero.mp (hFD.hasLineDerivAt e₁)).comp hh_tendsto
      have ht2 :=
        (hasLineDerivAt_iff_tendsto_slope_zero.mp (hFD.hasLineDerivAt e₂)).comp hh_tendsto
      have ht_sum : Filter.Tendsto (g_seq · τ) Filter.atTop
          (nhds ((fderiv ℂ (F τ) p₀ e₁) • ContinuousLinearMap.fst ℂ ℂ ℂ +
            (fderiv ℂ (F τ) p₀ e₂) • ContinuousLinearMap.snd ℂ ℂ ℂ)) :=
        (ht1.smul_const _).add (ht2.smul_const _)
      have hL_eq : (fderiv ℂ (F τ) p₀ e₁) • ContinuousLinearMap.fst ℂ ℂ ℂ +
          (fderiv ℂ (F τ) p₀ e₂) • ContinuousLinearMap.snd ℂ ℂ ℂ = fderiv ℂ (F τ) p₀ := by
        refine ContinuousLinearMap.ext (fun ⟨v₁, v₂⟩ => ?_)
        have hv : ((v₁, v₂) : ℂ × ℂ) = v₁ • e₁ + v₂ • e₂ := by ext <;> simp [e₁, e₂]
        conv_rhs => rw [hv, (fderiv ℂ (F τ) p₀).map_add, (fderiv ℂ (F τ) p₀).map_smul,
          (fderiv ℂ (F τ) p₀).map_smul]
        simp [mul_comm]
      rwa [hL_eq] at ht_sum
    have h_fderiv_bound : ∀ τ ∈ Set.uIcc a b, ∀ p ∈ s, ‖fderiv ℂ (F τ) p‖ ≤ 2 * M / r := by
      intro τ hτ p hp
      have hball_sub : Metric.ball p r ⊆ W := fun q hq => h2r_sub (hs_2r p hp q hq)
      have hmaps : Set.MapsTo (F τ) (Metric.ball p r) (Metric.closedBall (F τ p) (2 * M)) := by
        intro q hq
        rw [Metric.mem_closedBall, dist_eq_norm]
        have hq2r : q ∈ Metric.closedBall p₀ (2 * r) := hs_2r p hp q hq
        have hp2r : p ∈ Metric.closedBall p₀ (2 * r) := hs_2r p hp p (Metric.mem_ball_self hr)
        calc ‖F τ q - F τ p‖ ≤ ‖F τ q‖ + ‖F τ p‖ := norm_sub_le _ _
          _ ≤ M + M := add_le_add (hM_bound τ hτ q hq2r) (hM_bound τ hτ p hp2r)
          _ = 2 * M := by ring
      exact Complex.norm_fderiv_le_div_of_mapsTo_ball ((hHolo τ hτ).mono hball_sub) hmaps hr
    have h_ae_bound :
        ∀ᵐ τ : ℝ, τ ∈ Set.uIoc a b → ∀ p ∈ s, ‖fderiv ℂ (F τ) p‖ ≤ 2 * M / r :=
      Filter.Eventually.of_forall
        (fun τ hτ p hp => h_fderiv_bound τ (Set.uIoc_subset_uIcc hτ) p hp)
    have h_ae_diff :
        ∀ᵐ τ : ℝ, τ ∈ Set.uIoc a b → ∀ p ∈ s, HasFDerivAt (F τ) (fderiv ℂ (F τ) p) p :=
      Filter.Eventually.of_forall (fun τ hτ p hp =>
        ((hHolo τ (Set.uIoc_subset_uIcc hτ)).differentiableAt
          (hW.mem_nhds (hs_sub hp))).hasFDerivAt)
    have hIntFD := intervalIntegral.hasFDerivAt_integral_of_dominated_of_fderiv_le
      (𝕜 := ℂ) (F := fun p τ => F τ p) (F' := fun p τ => fderiv ℂ (F τ) p)
      (bound := fun _ => 2 * M / r)
      hs_nhds hF_meas hF_int hF'_meas h_ae_bound intervalIntegrable_const h_ae_diff
    exact hIntFD.differentiableAt.differentiableWithinAt

  have h_partial_1 : ∀ (W : Set (ℂ × ℂ)) (U : ℂ × ℂ → ℂ),
      IsOpen W → DifferentiableOn ℂ U W →
      DifferentiableOn ℂ (fun p : ℂ × ℂ => deriv (fun ξ : ℂ => U (ξ, p.2)) p.1) W := by
    intro W U hW hU p₀ hp₀
    obtain ⟨ε, hε, hε_sub⟩ := Metric.isOpen_iff.mp hW p₀ hp₀
    let r : ℝ := ε / 2
    have hr : 0 < r := half_pos hε
    let R_c : ℝ := (3 / 2 : ℝ) * r
    have hRc : 0 < R_c := by positivity
    let B₀ : Set (ℂ × ℂ) := Metric.ball p₀.1 r ×ˢ Metric.ball p₀.2 r
    have hB₀_open : IsOpen B₀ := Metric.isOpen_ball.prod Metric.isOpen_ball
    have hp₀_B₀ : p₀ ∈ B₀ := ⟨Metric.mem_ball_self hr, Metric.mem_ball_self hr⟩
    have h_in_W : ∀ z t : ℂ, dist z p₀.1 ≤ R_c → dist t p₀.2 < r → (z, t) ∈ W := by
      intro z t hz ht
      apply hε_sub
      rw [Metric.mem_ball, Prod.dist_eq, max_lt_iff]
      dsimp only [r, R_c] at hz ht ⊢
      exact ⟨by linarith, by linarith⟩
    let F : ℝ → ℂ × ℂ → ℂ := fun θ p =>
      (2 * (Real.pi : ℂ) * Complex.I)⁻¹ *
        (deriv (circleMap p₀.1 R_c) θ *
          (((circleMap p₀.1 R_c θ - p.1) ^ 2)⁻¹ * U (circleMap p₀.1 R_c θ, p.2)))
    have h_cm_dist : ∀ θ : ℝ, dist (circleMap p₀.1 R_c θ) p₀.1 = R_c := by
      intro θ
      rw [dist_eq_norm, circleMap_sub_center]
      simp [circleMap, abs_of_pos hRc]
    have h_sub_ne : ∀ θ : ℝ, ∀ p ∈ B₀, (circleMap p₀.1 R_c θ - p.1) ^ 2 ≠ 0 := by
      intro θ p hp
      apply pow_ne_zero 2
      rw [sub_ne_zero]
      intro h_eq
      have hd1 : dist (circleMap p₀.1 R_c θ) p₀.1 = R_c := h_cm_dist θ
      have hd2 : dist p.1 p₀.1 < r := hp.1
      rw [h_eq] at hd1
      dsimp only [R_c] at hd1
      linarith
    have hF_cont : ContinuousOn (fun q : ℝ × (ℂ × ℂ) => F q.1 q.2)
        (Set.uIcc 0 (2 * Real.pi) ×ˢ B₀) := by
      have hc_deriv : Continuous (fun q : ℝ × (ℂ × ℂ) => deriv (circleMap p₀.1 R_c) q.1) := by
        rw [show (fun q : ℝ × (ℂ × ℂ) => deriv (circleMap p₀.1 R_c) q.1) =
            fun q : ℝ × (ℂ × ℂ) => circleMap 0 R_c q.1 * Complex.I by
          ext q; exact deriv_circleMap p₀.1 R_c q.1]
        exact ((continuous_circleMap 0 R_c).comp continuous_fst).mul continuous_const
      have hc_cm : Continuous (fun q : ℝ × (ℂ × ℂ) => circleMap p₀.1 R_c q.1) :=
        (continuous_circleMap p₀.1 R_c).comp continuous_fst
      have hc_U : ContinuousOn (fun q : ℝ × (ℂ × ℂ) => U (circleMap p₀.1 R_c q.1, q.2.2))
          (Set.uIcc 0 (2 * Real.pi) ×ˢ B₀) := by
        refine hU.continuousOn.comp
          (hc_cm.prodMk (continuous_snd.comp continuous_snd)).continuousOn ?_
        intro q hq
        exact h_in_W _ _ (h_cm_dist q.1).le hq.2.2
      have hc_inv : ContinuousOn
          (fun q : ℝ × (ℂ × ℂ) => ((circleMap p₀.1 R_c q.1 - q.2.1) ^ 2)⁻¹)
          (Set.uIcc 0 (2 * Real.pi) ×ˢ B₀) :=
        ContinuousOn.inv₀
          (((hc_cm.sub (continuous_fst.comp continuous_snd)).pow 2).continuousOn)
          (fun q hq => h_sub_ne q.1 q.2 hq.2)
      exact continuousOn_const.mul (hc_deriv.continuousOn.mul (hc_inv.mul hc_U))
    have hF_holo : ∀ θ ∈ Set.uIcc 0 (2 * Real.pi), DifferentiableOn ℂ (F θ) B₀ := by
      intro θ _
      have hd_inv : DifferentiableOn ℂ
          (fun p : ℂ × ℂ => ((circleMap p₀.1 R_c θ - p.1) ^ 2)⁻¹) B₀ :=
        DifferentiableOn.inv
          (((differentiableOn_const (circleMap p₀.1 R_c θ)).sub
            differentiable_fst.differentiableOn).pow 2)
          (fun p hp => h_sub_ne θ p hp)
      have hd_U : DifferentiableOn ℂ (fun p : ℂ × ℂ => U (circleMap p₀.1 R_c θ, p.2)) B₀ :=
        hU.comp ((differentiable_const (circleMap p₀.1 R_c θ)).prodMk
          differentiable_snd).differentiableOn
          (fun p hp => h_in_W _ _ (h_cm_dist θ).le hp.2)
      exact (differentiableOn_const _).mul ((differentiableOn_const _).mul (hd_inv.mul hd_U))
    have hInt_holo : DifferentiableOn ℂ
        (fun p : ℂ × ℂ => ∫ θ in (0 : ℝ)..(2 * Real.pi), F θ p) B₀ :=
      h_param_holo 0 (2 * Real.pi) B₀ F hB₀_open hF_cont hF_holo
    have h_eq_on_B₀ : DifferentiableOn ℂ
        (fun p : ℂ × ℂ => deriv (fun ξ : ℂ => U (ξ, p.2)) p.1) B₀ := by
      refine hInt_holo.congr ?_
      intro p hp
      have hp1_Rc : p.1 ∈ Metric.ball p₀.1 R_c := by
        rw [Metric.mem_ball]
        have hd2 : dist p.1 p₀.1 < r := hp.1
        dsimp only [R_c]
        linarith
      have hCauchy := (Complex.two_pi_I_inv_smul_circleIntegral_sub_sq_inv_smul_of_differentiable
        (hW.preimage (continuous_id.prodMk continuous_const))
        (fun z hz => h_in_W z p.2 hz hp.2)
        (hU.comp (differentiable_id.prodMk (differentiable_const p.2)).differentiableOn
          (fun _ hy' => hy'))
        hp1_Rc).symm
      dsimp only [Function.comp_def, id_eq] at hCauchy
      rw [hCauchy, circleIntegral_def_Icc, MeasureTheory.integral_Icc_eq_integral_Ioc,
        ← intervalIntegral.integral_of_le Real.two_pi_pos.le, ← intervalIntegral.integral_smul]
      refine intervalIntegral.integral_congr (fun θ _ => ?_)
      simp [F, smul_eq_mul, mul_assoc]
    exact (h_eq_on_B₀.differentiableAt (hB₀_open.mem_nhds hp₀_B₀)).differentiableWithinAt

  have h_partial_2 : ∀ (W : Set (ℂ × ℂ)) (U : ℂ × ℂ → ℂ),
      IsOpen W → DifferentiableOn ℂ U W →
      DifferentiableOn ℂ (fun p : ℂ × ℂ => deriv (fun ζ : ℂ => U (p.1, ζ)) p.2) W := by
    intro W U hW hU
    let S_swap := ContinuousLinearEquiv.prodComm ℂ ℂ ℂ
    have h1 := h_partial_1 (S_swap ⁻¹' W) (U ∘ S_swap) (hW.preimage S_swap.continuous)
      (hU.comp S_swap.differentiable.differentiableOn (fun _ hq => hq))
    have h2 := h1.comp S_swap.differentiable.differentiableOn
      (fun p hp => show S_swap (S_swap p) ∈ W by simpa [S_swap] using hp)
    exact h2.congr (fun p _ => rfl)

  let Φ₁ : ℂ × ℂ → ℂ := fun p => deriv (fun ξ : ℂ => A.Phi (ξ, p.2)) p.1
  let Φ₂ : ℂ × ℂ → ℂ := fun p => deriv (fun ζ : ℂ => A.Phi (p.1, ζ)) p.2
  have hΦ₁_holo : DifferentiableOn ℂ Φ₁ U₂ := h_partial_1 U₂ A.Phi A.domain_open A.Phi_holo
  have hΦ₂_holo : DifferentiableOn ℂ Φ₂ U₂ := h_partial_2 U₂ A.Phi A.domain_open A.Phi_holo

  have hHasDS : ∀ s J t : ℂ, (s, t * J) ∈ U₂ →
      HasDerivAt (fun s' : ℂ => steepContActionA A.Phi s' J t)
        (J ^ 3 * Φ₁ (s, t * J)) s := by
    intro s J t h_mem
    let V₁ : Set ℂ := { s' : ℂ | (s', t * J) ∈ U₂ }
    have hV₁_open : IsOpen V₁ := A.domain_open.preimage (continuous_id.prodMk continuous_const)
    have h_diff1 : DifferentiableAt ℂ (fun s' : ℂ => A.Phi (s', t * J)) s :=
      (A.Phi_holo.comp
        (differentiable_id.prodMk (differentiable_const (t * J))).differentiableOn
        (fun _ hs' => hs')).differentiableAt (hV₁_open.mem_nhds h_mem)
    have hd1 : HasDerivAt (fun s' : ℂ => A.Phi (s', t * J)) (Φ₁ (s, t * J)) s :=
      h_diff1.hasDerivAt
    simpa [steepContActionA] using (hd1.sub_const (1 / 24 : ℂ)).const_mul (J ^ 3)

  have hEqDS : ∀ s J t : ℂ, (s, t * J) ∈ U₂ →
      steepContActionDS A.Phi s J t = J ^ 3 * Φ₁ (s, t * J) := by
    intro s J t h_mem
    exact (hHasDS s J t h_mem).deriv

  have hHasDJ : ∀ s J t : ℂ, (s, t * J) ∈ U₂ →
      HasDerivAt (fun J' : ℂ => steepContActionA A.Phi s J' t)
        (3 * J ^ 2 * (A.Phi (s, t * J) - (1 / 24 : ℂ)) + J ^ 3 * (Φ₂ (s, t * J) * t)) J := by
    intro s J t h_mem
    let V₂ : Set ℂ := { ζ : ℂ | (s, ζ) ∈ U₂ }
    have hV₂_open : IsOpen V₂ := A.domain_open.preimage (continuous_const.prodMk continuous_id)
    have h_diff2 : DifferentiableAt ℂ (fun ζ : ℂ => A.Phi (s, ζ)) (t * J) :=
      (A.Phi_holo.comp
        ((differentiable_const s).prodMk differentiable_id).differentiableOn
        (fun _ hζ => hζ)).differentiableAt (hV₂_open.mem_nhds h_mem)
    have hd2 : HasDerivAt (fun ζ : ℂ => A.Phi (s, ζ)) (Φ₂ (s, t * J)) (t * J) :=
      h_diff2.hasDerivAt
    have h_lin : HasDerivAt (fun J' : ℂ => t * J') t J := by
      simpa using (hasDerivAt_id J).const_mul t
    have hd_comp : HasDerivAt (fun J' : ℂ => A.Phi (s, t * J') - (1 / 24 : ℂ))
        (Φ₂ (s, t * J) * t) J :=
      (hd2.comp J h_lin).sub_const (1 / 24 : ℂ)
    have hd_pow : HasDerivAt (fun J' : ℂ => J' ^ 3) (3 * J ^ 2) J := by
      simpa using hasDerivAt_pow 3 J
    exact hd_pow.mul hd_comp

  have hEqDJ : ∀ s J t : ℂ, (s, t * J) ∈ U₂ →
      steepContActionDJ A.Phi s J t =
        3 * J ^ 2 * (A.Phi (s, t * J) - (1 / 24 : ℂ)) + J ^ 3 * (Φ₂ (s, t * J) * t) := by
    intro s J t h_mem
    exact (hHasDJ s J t h_mem).deriv

  have hpJ : DifferentiableOn ℂ (fun q : ℂ × ℂ × ℂ => q.2.1) W₃ :=
    (differentiable_fst.comp differentiable_snd).differentiableOn
  have hpt : DifferentiableOn ℂ (fun q : ℂ × ℂ × ℂ => q.2.2) W₃ :=
    (differentiable_snd.comp differentiable_snd).differentiableOn
  have hPhi_comp : DifferentiableOn ℂ (fun q : ℂ × ℂ × ℂ => A.Phi (π q)) W₃ :=
    A.Phi_holo.comp hπ_diff.differentiableOn (fun _ hq => hq)
  have hΦ₁_comp : DifferentiableOn ℂ (fun q : ℂ × ℂ × ℂ => Φ₁ (π q)) W₃ :=
    hΦ₁_holo.comp hπ_diff.differentiableOn (fun _ hq => hq)
  have hΦ₂_comp : DifferentiableOn ℂ (fun q : ℂ × ℂ × ℂ => Φ₂ (π q)) W₃ :=
    hΦ₂_holo.comp hπ_diff.differentiableOn (fun _ hq => hq)

  have hDJ_holo : DifferentiableOn ℂ
      (fun q : ℂ × ℂ × ℂ => steepContActionDJ A.Phi q.1 q.2.1 q.2.2) W₃ := by
    have h_rhs : DifferentiableOn ℂ
        (fun q : ℂ × ℂ × ℂ =>
          3 * q.2.1 ^ 2 * (A.Phi (π q) - (1 / 24 : ℂ)) +
            q.2.1 ^ 3 * (Φ₂ (π q) * q.2.2)) W₃ :=
      (((differentiableOn_const (3 : ℂ)).mul (hpJ.pow 2)).mul
        (hPhi_comp.sub_const (1 / 24 : ℂ))).add
        ((hpJ.pow 3).mul (hΦ₂_comp.mul hpt))
    exact h_rhs.congr (fun q hq => hEqDJ q.1 q.2.1 q.2.2 hq)

  have hDS_holo : DifferentiableOn ℂ
      (fun q : ℂ × ℂ × ℂ => steepContActionDS A.Phi q.1 q.2.1 q.2.2) W₃ := by
    have h_rhs : DifferentiableOn ℂ
        (fun q : ℂ × ℂ × ℂ => q.2.1 ^ 3 * Φ₁ (π q)) W₃ :=
      (hpJ.pow 3).mul hΦ₁_comp
    exact h_rhs.congr (fun q hq => hEqDS q.1 q.2.1 q.2.2 hq)

  have hP_split : ∀ s J' t : ℂ,
      smallChordActionP A.Phi s J' t =
        (1 / 24 : ℂ) * J' ^ 3 + steepContActionA A.Phi s J' t := by
    intro s J' t
    dsimp [smallChordActionP, steepContActionA]
    ring

  have hP_deriv_J : ∀ s J t : ℂ, (s, t * J) ∈ U₂ →
      deriv (fun J' : ℂ => smallChordActionP A.Phi s J' t) J =
        (1 / 8 : ℂ) * J ^ 2 + steepContActionDJ A.Phi s J t := by
    intro s J t h_mem
    have hd_cub : HasDerivAt (fun J' : ℂ => (1 / 24 : ℂ) * J' ^ 3) ((1 / 8 : ℂ) * J ^ 2) J := by
      have h1 := (hasDerivAt_pow 3 J).const_mul (1 / 24 : ℂ)
      convert h1 using 1
      ring
    have hd_act : HasDerivAt (fun J' : ℂ => steepContActionA A.Phi s J' t)
        (steepContActionDJ A.Phi s J t) J := by
      rw [hEqDJ s J t h_mem]
      exact hHasDJ s J t h_mem
    have hd_sum := hd_cub.add hd_act
    have h_fn : (fun J' : ℂ => smallChordActionP A.Phi s J' t) =
        (fun J' : ℂ => (1 / 24 : ℂ) * J' ^ 3 + steepContActionA A.Phi s J' t) := by
      ext J'
      exact hP_split s J' t
    rw [h_fn]
    exact hd_sum.deriv

  have hP_deriv_s : ∀ s J t : ℂ, (s, t * J) ∈ U₂ →
      deriv (fun s' : ℂ => smallChordActionP A.Phi s' J t) s =
        steepContActionDS A.Phi s J t := by
    intro s J t h_mem
    have hd_act : HasDerivAt (fun s' : ℂ => steepContActionA A.Phi s' J t)
        (steepContActionDS A.Phi s J t) s := by
      rw [hEqDS s J t h_mem]
      exact hHasDS s J t h_mem
    have hd_sum : HasDerivAt
        (fun s' : ℂ => (1 / 24 : ℂ) * J ^ 3 + steepContActionA A.Phi s' J t)
        (steepContActionDS A.Phi s J t) s :=
      hd_act.const_add ((1 / 24 : ℂ) * J ^ 3)
    have h_fn : (fun s' : ℂ => smallChordActionP A.Phi s' J t) =
        (fun s' : ℂ => (1 / 24 : ℂ) * J ^ 3 + steepContActionA A.Phi s' J t) := by
      ext s'
      exact hP_split s' J t
    rw [h_fn]
    exact hd_sum.deriv

  have hConj4 : ∀ s_m J_m s_0 t J : ℂ,
      (s_m, t * J_m) ∈ U₂ → (s_0, t * J) ∈ U₂ →
      steepContResidual A.Phi s_m J_m s_0 t J =
        (deriv (fun J' => smallChordActionP A.Phi s_0 J' t) J -
          t * deriv (fun s' => smallChordActionP A.Phi s' J t) s_0) -
        deriv (fun J' => smallChordActionP A.Phi s_m J' t) J_m := by
    intro s_m J_m s_0 t J hm h0
    rw [hP_deriv_J s_0 J t h0, hP_deriv_s s_0 J t h0, hP_deriv_J s_m J_m t hm]
    dsimp [steepContResidual, steepContPerturbG]
    ring

  have hDiffG_J : ∀ s_0 t J : ℂ, (s_0, t * J) ∈ U₂ →
      DifferentiableAt ℂ (steepContPerturbG A.Phi s_0 t) J := by
    intro s_0 t J h0
    let ι_J : ℂ → ℂ × ℂ × ℂ := fun J' => (s_0, (J', t))
    have hι_diff : Differentiable ℂ ι_J :=
      (differentiable_const s_0).prodMk (differentiable_id.prodMk (differentiable_const t))
    let W_J : Set ℂ := ι_J ⁻¹' W₃
    have hWJ_open : IsOpen W_J := hW₃_open.preimage hι_diff.continuous
    have hDJ_at : DifferentiableAt ℂ (fun J' : ℂ => steepContActionDJ A.Phi s_0 J' t) J :=
      (hDJ_holo.comp hι_diff.differentiableOn (fun _ hJ' => hJ')).differentiableAt
        (hWJ_open.mem_nhds h0)
    have hDS_at : DifferentiableAt ℂ (fun J' : ℂ => steepContActionDS A.Phi s_0 J' t) J :=
      (hDS_holo.comp hι_diff.differentiableOn (fun _ hJ' => hJ')).differentiableAt
        (hWJ_open.mem_nhds h0)
    exact hDJ_at.sub (hDS_at.const_mul t)

  have hConj5 : ∀ s_m J_m s_0 t J : ℂ,
      (s_0, t * J) ∈ U₂ →
      HasDerivAt (fun J' => steepContResidual A.Phi s_m J_m s_0 t J')
        ((1 / 4 : ℂ) * J + deriv (steepContPerturbG A.Phi s_0 t) J) J := by
    intro s_m J_m s_0 t J h0
    have hd_quad : HasDerivAt (fun J' : ℂ => (1 / 8 : ℂ) * (J' ^ 2 - J_m ^ 2))
        ((1 / 4 : ℂ) * J) J := by
      have h1 := ((hasDerivAt_pow 2 J).sub_const (J_m ^ 2)).const_mul (1 / 8 : ℂ)
      convert h1 using 1
      ring
    have hd_G : HasDerivAt (steepContPerturbG A.Phi s_0 t)
        (deriv (steepContPerturbG A.Phi s_0 t) J) J :=
      (hDiffG_J s_0 t J h0).hasDerivAt
    simpa [steepContResidual] using
      (hd_quad.add hd_G).sub_const (steepContActionDJ A.Phi s_m J_m t)

  have h_cauchy_closed : ∀ (f : ℂ → ℂ) (c : ℂ) (R C : ℝ),
      0 < R →
      (∀ z ∈ Metric.closedBall c R, DifferentiableAt ℂ f z) →
      (∀ z ∈ Metric.closedBall c R, ‖f z‖ ≤ C) →
      ‖deriv f c‖ ≤ C / R := by
    intro f c R C hR hf_diff hf_bnd
    have hf_on : DifferentiableOn ℂ f (Metric.closedBall c R) :=
      fun z hz => (hf_diff z hz).differentiableWithinAt
    have hf_dc : DiffContOnCl ℂ f (Metric.ball c R) :=
      hf_on.diffContOnCl_ball Subset.rfl
    exact Complex.norm_deriv_le_of_forall_mem_sphere_norm_le hR hf_dc
      (fun z hz => hf_bnd z (Metric.sphere_subset_closedBall hz))

  have hDiffDJ_s : ∀ s J t : ℂ, (s, t * J) ∈ U₂ →
      DifferentiableAt ℂ (fun s' : ℂ => steepContActionDJ A.Phi s' J t) s := by
    intro s J t h_mem
    let ι_s : ℂ → ℂ × ℂ × ℂ := fun s' => (s', (J, t))
    have hι_diff : Differentiable ℂ ι_s :=
      differentiable_id.prodMk (differentiable_const (J, t))
    let W_s : Set ℂ := ι_s ⁻¹' W₃
    have hWs_open : IsOpen W_s := hW₃_open.preimage hι_diff.continuous
    exact (hDJ_holo.comp hι_diff.differentiableOn (fun _ hs' => hs')).differentiableAt
      (hWs_open.mem_nhds h_mem)

  have hConj6 : ∀ s_m s_0 J_m t : ℂ, ∀ ρ_s ρ_J M_a : ℝ,
      0 < ρ_s → 0 < ρ_J → 0 ≤ M_a → ‖J_m - 1‖ ≤ ρ_J →
      (∀ θ ∈ Set.Icc (0 : ℝ) 1,
        ∀ s' ∈ Metric.closedBall ((1 - (θ : ℂ)) * s_m + (θ : ℂ) * s_0) ρ_s,
        ∀ J' ∈ Metric.closedBall (1 : ℂ) (3 * ρ_J),
          (s', t * J') ∈ U₂ ∧ ‖steepContActionA A.Phi s' J' t‖ ≤ M_a) →
      (∀ J ∈ Metric.closedBall J_m ρ_J,
        ‖deriv (steepContPerturbG A.Phi s_0 t) J‖ ≤
          4 * M_a / ρ_J ^ 2 + 2 * ‖t‖ * M_a / (ρ_s * ρ_J)) ∧
      ‖steepContActionDS A.Phi s_0 J_m t‖ ≤ M_a / ρ_s ∧
      ‖steepContActionDJ A.Phi s_0 J_m t - steepContActionDJ A.Phi s_m J_m t‖ ≤
        (M_a / (ρ_s * ρ_J)) * ‖s_0 - s_m‖ := by
    intro s_m s_0 J_m t ρ_s ρ_J M_a hρ_s hρ_J _hM_a hJm hBound
    have hJm_in3 : J_m ∈ Metric.closedBall (1 : ℂ) (3 * ρ_J) := by
      rw [Metric.mem_closedBall, dist_eq_norm]
      linarith
    have hBound0 : ∀ s' ∈ Metric.closedBall s_0 ρ_s,
        ∀ J' ∈ Metric.closedBall (1 : ℂ) (3 * ρ_J),
          (s', t * J') ∈ U₂ ∧ ‖steepContActionA A.Phi s' J' t‖ ≤ M_a := by
      intro s' hs' J' hJ'
      have hθ1 : (1 : ℝ) ∈ Set.Icc (0 : ℝ) 1 := ⟨zero_le_one, le_rfl⟩
      have hs'_1 :
          s' ∈ Metric.closedBall ((1 - ((1 : ℝ) : ℂ)) * s_m + ((1 : ℝ) : ℂ) * s_0) ρ_s := by
        simpa using hs'
      exact hBound 1 hθ1 s' hs'_1 J' hJ'
    have hs0_self : s_0 ∈ Metric.closedBall s_0 ρ_s := Metric.mem_closedBall_self hρ_s.le
    have hDS_s0 : ∀ J₁ ∈ Metric.closedBall (1 : ℂ) (3 * ρ_J),
        ‖steepContActionDS A.Phi s_0 J₁ t‖ ≤ M_a / ρ_s := by
      intro J₁ hJ₁
      exact h_cauchy_closed (fun s' => steepContActionA A.Phi s' J₁ t) s_0 ρ_s M_a hρ_s
        (fun s' hs' => (hHasDS s' J₁ t (hBound0 s' hs' J₁ hJ₁).1).differentiableAt)
        (fun s' hs' => (hBound0 s' hs' J₁ hJ₁).2)
    refine ⟨?_, hDS_s0 J_m hJm_in3, ?_⟩
    · intro J hJ
      have hJ_dist1 : ‖J - 1‖ ≤ 2 * ρ_J := by
        have hJ_Jm : ‖J - J_m‖ ≤ ρ_J := by simpa [Metric.mem_closedBall, dist_eq_norm] using hJ
        calc ‖J - 1‖ = ‖(J - J_m) + (J_m - 1)‖ := by ring_nf
          _ ≤ ‖J - J_m‖ + ‖J_m - 1‖ := norm_add_le _ _
          _ ≤ 2 * ρ_J := by linarith
      let r_J : ℝ := ρ_J / 2
      have hr_J : 0 < r_J := half_pos hρ_J
      have hJ1_in3 : ∀ J₁ ∈ Metric.closedBall J r_J, J₁ ∈ Metric.closedBall (1 : ℂ) (3 * ρ_J) := by
        intro J₁ hJ₁
        rw [Metric.mem_closedBall, dist_eq_norm] at hJ₁ ⊢
        calc ‖J₁ - 1‖ = ‖(J₁ - J) + (J - 1)‖ := by ring_nf
          _ ≤ ‖J₁ - J‖ + ‖J - 1‖ := norm_add_le _ _
          _ ≤ 3 * ρ_J := by dsimp [r_J] at hJ₁; linarith
      have hG_bnd : ∀ J₁ ∈ Metric.closedBall J r_J,
          ‖steepContPerturbG A.Phi s_0 t J₁‖ ≤ M_a / r_J + ‖t‖ * (M_a / ρ_s) := by
        intro J₁ hJ₁
        have hz_in3 : ∀ z ∈ Metric.closedBall J₁ r_J,
            z ∈ Metric.closedBall (1 : ℂ) (3 * ρ_J) := by
          intro z hz
          rw [Metric.mem_closedBall, dist_eq_norm] at hz hJ₁ ⊢
          have h_eq : z - 1 = ((z - J₁) + (J₁ - J)) + (J - 1) := by ring
          have h_tri1 := norm_add_le ((z - J₁) + (J₁ - J)) (J - 1)
          have h_tri2 := norm_add_le (z - J₁) (J₁ - J)
          rw [h_eq]
          dsimp [r_J] at hz hJ₁
          linarith
        have hDJ_J1 : ‖steepContActionDJ A.Phi s_0 J₁ t‖ ≤ M_a / r_J :=
          h_cauchy_closed (fun z => steepContActionA A.Phi s_0 z t) J₁ r_J M_a hr_J
            (fun z hz =>
              (hHasDJ s_0 z t (hBound0 s_0 hs0_self z (hz_in3 z hz)).1).differentiableAt)
            (fun z hz => (hBound0 s_0 hs0_self z (hz_in3 z hz)).2)
        have hDS_J1 : ‖steepContActionDS A.Phi s_0 J₁ t‖ ≤ M_a / ρ_s :=
          hDS_s0 J₁ (hJ1_in3 J₁ hJ₁)
        calc ‖steepContPerturbG A.Phi s_0 t J₁‖
            = ‖steepContActionDJ A.Phi s_0 J₁ t - t * steepContActionDS A.Phi s_0 J₁ t‖ := rfl
          _ ≤ ‖steepContActionDJ A.Phi s_0 J₁ t‖ + ‖t * steepContActionDS A.Phi s_0 J₁ t‖ :=
              norm_sub_le _ _
          _ = ‖steepContActionDJ A.Phi s_0 J₁ t‖ + ‖t‖ * ‖steepContActionDS A.Phi s_0 J₁ t‖ := by
              rw [norm_mul]
          _ ≤ M_a / r_J + ‖t‖ * (M_a / ρ_s) :=
              add_le_add hDJ_J1 (mul_le_mul_of_nonneg_left hDS_J1 (norm_nonneg t))
      have h_raw : ‖deriv (steepContPerturbG A.Phi s_0 t) J‖ ≤
          (M_a / r_J + ‖t‖ * (M_a / ρ_s)) / r_J :=
        h_cauchy_closed (steepContPerturbG A.Phi s_0 t) J r_J
          (M_a / r_J + ‖t‖ * (M_a / ρ_s)) hr_J
          (fun J₁ hJ₁ => hDiffG_J s_0 t J₁ (hBound0 s_0 hs0_self J₁ (hJ1_in3 J₁ hJ₁)).1)
          hG_bnd
      have h_alg : (M_a / r_J + ‖t‖ * (M_a / ρ_s)) / r_J =
          4 * M_a / ρ_J ^ 2 + 2 * ‖t‖ * M_a / (ρ_s * ρ_J) := by
        dsimp [r_J]
        field_simp [hρ_s.ne', hρ_J.ne']
        ring
      rwa [h_alg] at h_raw
    · let h_DJ : ℂ → ℂ := fun s' => steepContActionDJ A.Phi s' J_m t
      have hz_Jm_in3 : ∀ z ∈ Metric.closedBall J_m ρ_J,
          z ∈ Metric.closedBall (1 : ℂ) (3 * ρ_J) := by
        intro z hz
        rw [Metric.mem_closedBall, dist_eq_norm] at hz ⊢
        calc ‖z - 1‖ = ‖(z - J_m) + (J_m - 1)‖ := by ring_nf
          _ ≤ ‖z - J_m‖ + ‖J_m - 1‖ := norm_add_le _ _
          _ ≤ 3 * ρ_J := by linarith
      have h_seg_data : ∀ σ ∈ segment ℝ s_m s_0,
          DifferentiableAt ℂ h_DJ σ ∧ ‖deriv h_DJ σ‖ ≤ M_a / (ρ_s * ρ_J) := by
        intro σ hσ
        rw [segment_eq_image ℝ s_m s_0] at hσ
        rcases hσ with ⟨θ, hθ, rfl⟩
        set c_θ : ℂ := (1 - θ) • s_m + θ • s_0
        have hc_eq : c_θ = (1 - (θ : ℂ)) * s_m + (θ : ℂ) * s_0 := by
          simp [c_θ, Complex.real_smul]
        have hBθ : ∀ s' ∈ Metric.closedBall c_θ ρ_s,
            ∀ J' ∈ Metric.closedBall (1 : ℂ) (3 * ρ_J),
              (s', t * J') ∈ U₂ ∧ ‖steepContActionA A.Phi s' J' t‖ ≤ M_a := by
          intro s' hs' J' hJ'
          rw [hc_eq] at hs'
          exact hBound θ hθ s' hs' J' hJ'
        have hc_self : c_θ ∈ Metric.closedBall c_θ ρ_s := Metric.mem_closedBall_self hρ_s.le
        have h_diff_σ : DifferentiableAt ℂ h_DJ c_θ :=
          hDiffDJ_s c_θ J_m t (hBθ c_θ hc_self J_m hJm_in3).1
        have h_DJ_ball : ∀ s' ∈ Metric.closedBall c_θ ρ_s, ‖h_DJ s'‖ ≤ M_a / ρ_J := by
          intro s' hs'
          exact h_cauchy_closed (fun z => steepContActionA A.Phi s' z t) J_m ρ_J M_a hρ_J
            (fun z hz => (hHasDJ s' z t (hBθ s' hs' z (hz_Jm_in3 z hz)).1).differentiableAt)
            (fun z hz => (hBθ s' hs' z (hz_Jm_in3 z hz)).2)
        have h_deriv_σ : ‖deriv h_DJ c_θ‖ ≤ (M_a / ρ_J) / ρ_s :=
          h_cauchy_closed h_DJ c_θ ρ_s (M_a / ρ_J) hρ_s
            (fun s' hs' => hDiffDJ_s s' J_m t (hBθ s' hs' J_m hJm_in3).1)
            h_DJ_ball
        have h_div_eq : (M_a / ρ_J) / ρ_s = M_a / (ρ_s * ρ_J) := by
          rw [div_div, mul_comm ρ_J ρ_s]
        rw [h_div_eq] at h_deriv_σ
        exact ⟨h_diff_σ, h_deriv_σ⟩
      exact Convex.norm_image_sub_le_of_norm_deriv_le
        (fun σ hσ => (h_seg_data σ hσ).1)
        (fun σ hσ => (h_seg_data σ hσ).2)
        (convex_segment s_m s_0)
        (left_mem_segment ℝ s_m s_0)
        (right_mem_segment ℝ s_m s_0)

  exact ⟨hW₃_open, hDJ_holo, hDS_holo, hConj4, hConj5, hConj6⟩

theorem steep_holomorphic_step_solver (S : FiniteWallNonisotropicStrip)
    (A : SmallFieldChordActionData S)
    (hJets : SteepContJetProp S A) :
    SteepContSolverProp S A :=
by
  have hCore : ∀ (ρ_J : ℝ) (s_m s_0 t : ℂ),
      IsSteepContContractivePt S A ρ_J s_m s_0 t →
      let J_m := (s_0 - s_m) / t
      let J_p := steepContSolJ A.Phi s_m s_0 t
      (∀ n : ℕ, steepContIterJ A.Phi s_m s_0 t n ∈ Metric.closedBall J_m ρ_J) ∧
      (∀ n : ℕ,
        ‖steepContIterJ A.Phi s_m s_0 t n - steepContIterJ A.Phi s_m s_0 t (n + 1)‖ ≤
          (ρ_J / 2) * (1 / 2 : ℝ) ^ n) ∧
      Filter.Tendsto (steepContIterJ A.Phi s_m s_0 t) Filter.atTop (nhds J_p) ∧
      (‖J_p - J_m‖ ≤ 8 * ‖steepContResidual A.Phi s_m J_m s_0 t J_m‖ ∧
      deriv (fun J' => smallChordActionP A.Phi s_0 J' t) J_p -
        t * deriv (fun s' => smallChordActionP A.Phi s' J_p t) s_0 =
        deriv (fun J' => smallChordActionP A.Phi s_m J' t) J_m ∧
      (∀ J' ∈ Metric.closedBall J_m ρ_J,
        deriv (fun J'' => smallChordActionP A.Phi s_0 J'' t) J' -
          t * deriv (fun s' => smallChordActionP A.Phi s' J' t) s_0 =
          deriv (fun J'' => smallChordActionP A.Phi s_m J'' t) J_m →
        J' = J_p)) := by
    intro ρ_J s_m s_0 t hPt
    rcases hPt with ⟨ht, hρ_pos, hρ_le, hJm_one, hsm_dom, hball, hres_init⟩
    let J_m : ℂ := (s_0 - s_m) / t
    let R : ℂ → ℂ := fun w => steepContResidual A.Phi s_m J_m s_0 t w
    let T : ℂ → ℂ := fun w => w - (4 : ℂ) * R w
    let u : ℕ → ℂ := steepContIterJ A.Phi s_m s_0 t
    let J_p : ℂ := steepContSolJ A.Phi s_m s_0 t
    have hT_hasDeriv : ∀ w ∈ Metric.closedBall J_m ρ_J,
        HasDerivAt T (-(w - 1) - (4 : ℂ) * deriv (steepContPerturbG A.Phi s_0 t) w) w := by
      intro w hw
      have hR_d : HasDerivAt R ((1 / 4 : ℂ) * w + deriv (steepContPerturbG A.Phi s_0 t) w) w :=
        hJets.2.2.2.2.1 s_m J_m s_0 t w (hball w hw).1
      have hT_d : HasDerivAt T
          (1 - (4 : ℂ) * ((1 / 4 : ℂ) * w + deriv (steepContPerturbG A.Phi s_0 t) w)) w :=
        (hasDerivAt_id w).sub (hR_d.const_mul (4 : ℂ))
      convert hT_d using 1
      ring
    have hT_deriv_le : ∀ w ∈ Metric.closedBall J_m ρ_J, ‖deriv T w‖ ≤ 1 / 2 := by
      intro w hw
      have hw_dist : ‖w - J_m‖ ≤ ρ_J := by simpa [Metric.mem_closedBall, dist_eq_norm] using hw
      have hw_one : ‖w - 1‖ ≤ 2 * ρ_J := by
        have hsplit : w - 1 = (w - J_m) + (J_m - 1) := by ring
        rw [hsplit]
        exact le_trans (norm_add_le _ _) (by linarith)
      have hG_le : ‖deriv (steepContPerturbG A.Phi s_0 t) w‖ ≤ 1 / 32 := (hball w hw).2
      rw [(hT_hasDeriv w hw).deriv]
      have h4 : ‖(4 : ℂ) * deriv (steepContPerturbG A.Phi s_0 t) w‖ =
          4 * ‖deriv (steepContPerturbG A.Phi s_0 t) w‖ := by
        rw [norm_mul]
        norm_num
      have htri := norm_sub_le (-(w - 1)) ((4 : ℂ) * deriv (steepContPerturbG A.Phi s_0 t) w)
      rw [norm_neg, h4] at htri
      linarith
    have hT_lip : ∀ w₁ ∈ Metric.closedBall J_m ρ_J, ∀ w₂ ∈ Metric.closedBall J_m ρ_J,
        ‖T w₂ - T w₁‖ ≤ (1 / 2 : ℝ) * ‖w₂ - w₁‖ := by
      intro w₁ hw₁ w₂ hw₂
      exact Convex.norm_image_sub_le_of_norm_deriv_le
        (fun w hw => (hT_hasDeriv w hw).differentiableAt)
        hT_deriv_le (convex_closedBall J_m ρ_J) hw₁ hw₂
    have hJm_mem : J_m ∈ Metric.closedBall J_m ρ_J := Metric.mem_closedBall_self hρ_pos.le
    have hTJm_sub : ‖T J_m - J_m‖ = 4 * ‖R J_m‖ := by
      have hsub : T J_m - J_m = -(4 : ℂ) * R J_m := by dsimp [T]; ring
      rw [hsub, norm_mul]
      norm_num
    have hT_maps : ∀ w ∈ Metric.closedBall J_m ρ_J, T w ∈ Metric.closedBall J_m ρ_J := by
      intro w hw
      rw [Metric.mem_closedBall, dist_eq_norm]
      have hw_dist : ‖w - J_m‖ ≤ ρ_J := by simpa [Metric.mem_closedBall, dist_eq_norm] using hw
      have hlip := hT_lip J_m hJm_mem w hw
      have hsplit : T w - J_m = (T w - T J_m) + (T J_m - J_m) := by ring
      rw [hsplit]
      have htri := norm_add_le (T w - T J_m) (T J_m - J_m)
      linarith
    have hu_mem : ∀ n : ℕ, u n ∈ Metric.closedBall J_m ρ_J := by
      intro n
      induction n with
      | zero => exact hJm_mem
      | succ n ih => exact hT_maps (u n) ih
    have hu_step : ∀ n : ℕ, dist (u n) (u (n + 1)) ≤ (4 * ‖R J_m‖) * (1 / 2 : ℝ) ^ n := by
      intro n
      induction n with
      | zero =>
        rw [pow_zero, mul_one, dist_comm, dist_eq_norm]
        exact hTJm_sub.le
      | succ n ih =>
        rw [dist_eq_norm] at ih ⊢
        have h1 : ‖u (n + 1) - u (n + 2)‖ ≤ (1 / 2 : ℝ) * ‖u n - u (n + 1)‖ :=
          hT_lip (u (n + 1)) (hu_mem (n + 1)) (u n) (hu_mem n)
        calc ‖u (n + 1) - u (n + 2)‖
            ≤ (1 / 2 : ℝ) * ‖u n - u (n + 1)‖ := h1
          _ ≤ (1 / 2 : ℝ) * ((4 * ‖R J_m‖) * (1 / 2 : ℝ) ^ n) :=
              mul_le_mul_of_nonneg_left ih (by norm_num)
          _ = (4 * ‖R J_m‖) * (1 / 2 : ℝ) ^ (n + 1) := by ring
    have hu_step_ρ : ∀ n : ℕ, ‖u n - u (n + 1)‖ ≤ (ρ_J / 2) * (1 / 2 : ℝ) ^ n := by
      intro n
      have hpow : 0 ≤ (1 / 2 : ℝ) ^ n := by positivity
      have h1 : dist (u n) (u (n + 1)) ≤ (4 * ‖R J_m‖) * (1 / 2 : ℝ) ^ n := hu_step n
      rw [dist_eq_norm] at h1
      calc ‖u n - u (n + 1)‖
          ≤ (4 * ‖R J_m‖) * (1 / 2 : ℝ) ^ n := h1
        _ ≤ (ρ_J / 2) * (1 / 2 : ℝ) ^ n :=
            mul_le_mul_of_nonneg_right (by linarith) hpow
    have hu_cauchy : CauchySeq u :=
      cauchySeq_of_le_geometric (1 / 2 : ℝ) (4 * ‖R J_m‖) (by norm_num) hu_step
    have hu_lim : Filter.Tendsto u Filter.atTop (nhds J_p) := hu_cauchy.tendsto_limUnder
    have hJp_mem : J_p ∈ Metric.closedBall J_m ρ_J :=
      Metric.isClosed_closedBall.mem_of_tendsto hu_lim (Filter.Eventually.of_forall hu_mem)
    have hJp_bound : ‖J_p - J_m‖ ≤ 8 * ‖steepContResidual A.Phi s_m J_m s_0 t J_m‖ := by
      have hd := dist_le_of_le_geometric_of_tendsto₀ (1 / 2 : ℝ) (4 * ‖R J_m‖)
        (by norm_num) hu_step hu_lim
      have hu0 : dist (u 0) J_p = ‖J_p - J_m‖ := by rw [dist_comm, dist_eq_norm]; rfl
      calc ‖J_p - J_m‖
          ≤ (4 * ‖R J_m‖) / (1 - 1 / 2) := by rwa [← hu0]
        _ = 8 * ‖steepContResidual A.Phi s_m J_m s_0 t J_m‖ := by dsimp [R]; ring
    have hTJp : T J_p = J_p := by
      have hlim1 : Filter.Tendsto (fun n => T (u n)) Filter.atTop (nhds (T J_p)) :=
        ((hT_hasDeriv J_p hJp_mem).continuousAt.tendsto).comp hu_lim
      have hlim2 : Filter.Tendsto (fun n => u (n + 1)) Filter.atTop (nhds J_p) :=
        (Filter.tendsto_add_atTop_iff_nat 1).mpr hu_lim
      exact tendsto_nhds_unique hlim1 hlim2
    have hRJp : R J_p = 0 := by
      have hsub : J_p - (4 : ℂ) * R J_p = J_p := hTJp
      have hmul : (4 : ℂ) * R J_p = 0 := by linear_combination -hsub
      exact (mul_eq_zero.mp hmul).resolve_left (by norm_num)
    have hJp_rec :
        deriv (fun J' => smallChordActionP A.Phi s_0 J' t) J_p -
          t * deriv (fun s' => smallChordActionP A.Phi s' J_p t) s_0 =
          deriv (fun J' => smallChordActionP A.Phi s_m J' t) J_m := by
      have h_eq := hJets.2.2.2.1 s_m J_m s_0 t J_p hsm_dom (hball J_p hJp_mem).1
      dsimp only [R] at hRJp
      rw [hRJp] at h_eq
      exact sub_eq_zero.mp h_eq.symm
    have hJp_uniq : ∀ J' ∈ Metric.closedBall J_m ρ_J,
        deriv (fun J'' => smallChordActionP A.Phi s_0 J'' t) J' -
          t * deriv (fun s' => smallChordActionP A.Phi s' J' t) s_0 =
          deriv (fun J'' => smallChordActionP A.Phi s_m J'' t) J_m →
        J' = J_p := by
      intro J' hJ'_mem hJ'_rec
      have hRJ' : R J' = 0 := by
        dsimp only [R]
        rw [hJets.2.2.2.1 s_m J_m s_0 t J' hsm_dom (hball J' hJ'_mem).1]
        exact sub_eq_zero.mpr hJ'_rec
      have hTJ' : T J' = J' := by simp [T, hRJ']
      have hlip := hT_lip J_p hJp_mem J' hJ'_mem
      rw [hTJ', hTJp] at hlip
      have hnorm_nonneg : 0 ≤ ‖J' - J_p‖ := norm_nonneg _
      have hnorm_zero : ‖J' - J_p‖ ≤ 0 := by linarith
      exact sub_eq_zero.mp (norm_le_zero_iff.mp hnorm_zero)
    exact ⟨hu_mem, hu_step_ρ, hu_lim, hJp_bound, hJp_rec, hJp_uniq⟩
  let π₂ : (ℂ × ℂ) →L[ℂ] ℂ :=
    { toFun := Prod.snd
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl
      cont := continuous_snd }
  have htriple_holo : ∀ {U : Set (ℂ × ℂ)} {f₁ f₂ f₃ : ℂ × ℂ → ℂ},
      DifferentiableOn ℂ f₁ U → DifferentiableOn ℂ f₂ U → DifferentiableOn ℂ f₃ U →
      DifferentiableOn ℂ (fun p : ℂ × ℂ => (f₁ p, (f₂ p, f₃ p))) U := by
    intro U f₁ f₂ f₃ hf₁ hf₂ hf₃
    have hlin : DifferentiableOn ℂ
        (fun p : ℂ × ℂ =>
          f₁ p • ((1 : ℂ), ((0 : ℂ), (0 : ℂ))) +
          f₂ p • ((0 : ℂ), ((1 : ℂ), (0 : ℂ))) +
          f₃ p • ((0 : ℂ), ((0 : ℂ), (1 : ℂ)))) U :=
      ((hf₁.smul_const _).add (hf₂.smul_const _)).add (hf₃.smul_const _)
    exact hlin.congr (fun p _ => by ext <;> simp)
  have hslice1_hasDeriv : ∀ y t : ℂ, HasDerivAt (fun ξ : ℂ => (ξ, t)) (1, 0) y := by
    intro y t
    have h := ((hasDerivAt_id y).smul_const ((1 : ℂ), (0 : ℂ))).add
      (hasDerivAt_const y ((0 : ℂ), t))
    convert h using 1
    · ext ξ <;> simp
    · ext <;> simp
  have hslice2_hasDeriv : ∀ y t : ℂ, HasDerivAt (fun ζ : ℂ => (y, ζ)) (0, 1) t := by
    intro y t
    have h := (hasDerivAt_const t (y, (0 : ℂ))).add
      ((hasDerivAt_id t).smul_const ((0 : ℂ), (1 : ℂ)))
    convert h using 1
    · ext ζ <;> simp
    · ext <;> simp
  have hfderiv_2d : ∀ (g : ℂ × ℂ → ℂ) (y t : ℂ),
      DifferentiableAt ℂ g (y, t) →
      ‖fderiv ℂ g (y, t)‖ ≤
        ‖deriv (fun ξ : ℂ => g (ξ, t)) y‖ + ‖deriv (fun ζ : ℂ => g (y, ζ)) t‖ := by
    intro g y t hg
    let L := fderiv ℂ g (y, t)
    have hL : HasFDerivAt g L (y, t) := hg.hasFDerivAt
    have h1 : HasDerivAt (fun ξ : ℂ => g (ξ, t)) (L (1, 0)) y :=
      hL.comp_hasDerivAt y (hslice1_hasDeriv y t)
    have h2 : HasDerivAt (fun ζ : ℂ => g (y, ζ)) (L (0, 1)) t :=
      hL.comp_hasDerivAt t (hslice2_hasDeriv y t)
    rw [h1.deriv, h2.deriv]
    refine ContinuousLinearMap.opNorm_le_bound L (by positivity) (fun h => ?_)
    have hh : h = h.1 • ((1 : ℂ), (0 : ℂ)) + h.2 • ((0 : ℂ), (1 : ℂ)) := by
      ext <;> simp
    have hLh : L h = h.1 • L (1, 0) + h.2 • L (0, 1) := by
      conv_lhs => rw [hh]
      rw [L.map_add, L.map_smul, L.map_smul]
    rw [hLh]
    have hn1 : ‖h.1‖ ≤ ‖h‖ := le_max_left ‖h.1‖ ‖h.2‖
    have hn2 : ‖h.2‖ ≤ ‖h‖ := le_max_right ‖h.1‖ ‖h.2‖
    calc ‖h.1 • L (1, 0) + h.2 • L (0, 1)‖
        ≤ ‖h.1 • L (1, 0)‖ + ‖h.2 • L (0, 1)‖ := norm_add_le _ _
      _ = ‖h.1‖ * ‖L (1, 0)‖ + ‖h.2‖ * ‖L (0, 1)‖ := by simp
      _ ≤ ‖h‖ * ‖L (1, 0)‖ + ‖h‖ * ‖L (0, 1)‖ := by gcongr
      _ = (‖L (1, 0)‖ + ‖L (0, 1)‖) * ‖h‖ := by ring
  refine ⟨fun ρ_J s_m s_0 t hPt => (hCore ρ_J s_m s_0 t hPt).2.2.2, ?_⟩
  intro U ρ_J s_m s_0 hU hs_m hs_0 hContr
  let v : ℕ → ℂ × ℂ → ℂ := fun n p => steepContIterJ A.Phi (s_m p) (s_0 p) p.2 n
  let v_inf : ℂ × ℂ → ℂ := fun p => steepContSolJ A.Phi (s_m p) (s_0 p) p.2
  have hsnd : DifferentiableOn ℂ (fun p : ℂ × ℂ => p.2) U := π₂.differentiableOn
  have hv0 : DifferentiableOn ℂ (v 0) U := by
    have h_inv : DifferentiableOn ℂ (fun p : ℂ × ℂ => (p.2)⁻¹) U :=
      hsnd.inv (fun p hp => (hContr p hp).1)
    have h_mul : DifferentiableOn ℂ (fun p : ℂ × ℂ => (s_0 p - s_m p) * (p.2)⁻¹) U :=
      (hs_0.sub hs_m).mul h_inv
    exact h_mul.congr (fun p _ => div_eq_mul_inv (s_0 p - s_m p) p.2)
  have hcomp3 : ∀ (F : ℂ × ℂ × ℂ → ℂ) {f₁ f₂ f₃ : ℂ × ℂ → ℂ},
      DifferentiableOn ℂ F (steepContTripleDomain S A.η_SL) →
      DifferentiableOn ℂ f₁ U → DifferentiableOn ℂ f₂ U → DifferentiableOn ℂ f₃ U →
      (∀ p ∈ U, (f₁ p, f₃ p * f₂ p) ∈ smallChordDomain S A.η_SL) →
      DifferentiableOn ℂ (fun p : ℂ × ℂ => F (f₁ p, (f₂ p, f₃ p))) U := by
    intro F f₁ f₂ f₃ hF hf₁ hf₂ hf₃ hmaps
    exact hF.comp (htriple_holo hf₁ hf₂ hf₃) hmaps
  have hv : ∀ n : ℕ, DifferentiableOn ℂ (v n) U := by
    intro n
    induction n with
    | zero => exact hv0
    | succ n ih =>
      have hvn_dom : ∀ p ∈ U, (s_0 p, p.2 * v n p) ∈ smallChordDomain S A.η_SL := by
        intro p hp
        have hvn_mem : v n p ∈ Metric.closedBall ((s_0 p - s_m p) / p.2) ρ_J :=
          (hCore ρ_J (s_m p) (s_0 p) p.2 (hContr p hp)).1 n
        exact ((hContr p hp).2.2.2.2.2.1 (v n p) hvn_mem).1
      have hvm_dom : ∀ p ∈ U, (s_m p, p.2 * v 0 p) ∈ smallChordDomain S A.η_SL :=
        fun p hp => (hContr p hp).2.2.2.2.1
      have hDJ_n : DifferentiableOn ℂ
          (fun p : ℂ × ℂ => steepContActionDJ A.Phi (s_0 p) (v n p) p.2) U :=
        hcomp3 (fun q => steepContActionDJ A.Phi q.1 q.2.1 q.2.2)
          hJets.2.1 hs_0 ih hsnd hvn_dom
      have hDS_n : DifferentiableOn ℂ
          (fun p : ℂ × ℂ => steepContActionDS A.Phi (s_0 p) (v n p) p.2) U :=
        hcomp3 (fun q => steepContActionDS A.Phi q.1 q.2.1 q.2.2)
          hJets.2.2.1 hs_0 ih hsnd hvn_dom
      have hDJ_m : DifferentiableOn ℂ
          (fun p : ℂ × ℂ => steepContActionDJ A.Phi (s_m p) (v 0 p) p.2) U :=
        hcomp3 (fun q => steepContActionDJ A.Phi q.1 q.2.1 q.2.2)
          hJets.2.1 hs_m hv0 hsnd hvm_dom
      have h_quad : DifferentiableOn ℂ
          (fun p : ℂ × ℂ => (1 / 8 : ℂ) * ((v n p) ^ 2 - (v 0 p) ^ 2)) U :=
        ((ih.pow 2).sub (hv0.pow 2)).const_mul (1 / 8 : ℂ)
      have h_pert : DifferentiableOn ℂ
          (fun p : ℂ × ℂ => steepContPerturbG A.Phi (s_0 p) p.2 (v n p)) U :=
        hDJ_n.sub (hsnd.mul hDS_n)
      have h_res : DifferentiableOn ℂ
          (fun p : ℂ × ℂ => steepContResidual A.Phi (s_m p) (v 0 p) (s_0 p) p.2 (v n p)) U :=
        (h_quad.add h_pert).sub hDJ_m
      exact ih.sub (h_res.const_mul (4 : ℂ))
  intro p₀ hp₀
  have hρ_pos : 0 < ρ_J := (hContr p₀ hp₀).2.1
  obtain ⟨R_open, hR_pos, hR_sub⟩ := Metric.isOpen_iff.mp hU p₀ hp₀
  let r₀ : ℝ := R_open / 3
  have hr₀_pos : 0 < r₀ := by dsimp [r₀]; positivity
  let P₀ : Set (ℂ × ℂ) := Metric.ball p₀ r₀
  have hP₀_sub : P₀ ⊆ U := by
    intro p hp
    apply hR_sub
    rw [Metric.mem_ball] at hp ⊢
    dsimp [r₀] at hp
    linarith
  have hfderiv_step : ∀ p ∈ P₀, ∀ n : ℕ,
      dist (fderiv ℂ (v n) p) (fderiv ℂ (v (n + 1)) p) ≤ (ρ_J / r₀) * (1 / 2 : ℝ) ^ n := by
    intro p hp n
    have hp_dist : max (dist p.1 p₀.1) (dist p.2 p₀.2) < r₀ := by
      simpa [P₀, Metric.mem_ball, Prod.dist_eq] using hp
    have hy_lt : dist p.1 p₀.1 < r₀ := lt_of_le_of_lt (le_max_left _ _) hp_dist
    have ht_lt : dist p.2 p₀.2 < r₀ := lt_of_le_of_lt (le_max_right _ _) hp_dist
    let d_n : ℂ × ℂ → ℂ := fun q => v n q - v (n + 1) q
    have hdn_holo : DifferentiableOn ℂ d_n U := (hv n).sub (hv (n + 1))
    let V₁ : Set ℂ := Metric.ball p₀.1 (3 * r₀)
    have hV₁_maps : Set.MapsTo (fun ξ : ℂ => (ξ, p.2)) V₁ U := by
      intro ξ hξ
      apply hR_sub
      rw [Metric.mem_ball] at hξ
      rw [Metric.mem_ball, Prod.dist_eq, max_lt_iff]
      dsimp [r₀] at hξ ht_lt
      exact ⟨by linarith, by linarith⟩
    have hslice1_diff : Differentiable ℂ (fun ξ : ℂ => (ξ, p.2)) :=
      fun ξ => (hslice1_hasDeriv ξ p.2).differentiableAt
    have hslice1_holo : DifferentiableOn ℂ (fun ξ : ℂ => d_n (ξ, p.2)) V₁ :=
      hdn_holo.comp hslice1_diff.differentiableOn hV₁_maps
    have hcb1_sub : Metric.closedBall p.1 r₀ ⊆ V₁ := by
      intro ξ hξ
      rw [Metric.mem_closedBall] at hξ
      rw [Metric.mem_ball]
      exact lt_of_le_of_lt (dist_triangle ξ p.1 p₀.1) (by linarith)
    have hdc1 : DiffContOnCl ℂ (fun ξ : ℂ => d_n (ξ, p.2)) (Metric.ball p.1 r₀) :=
      hslice1_holo.diffContOnCl_ball hcb1_sub
    have hsph1 : ∀ ξ ∈ Metric.sphere p.1 r₀,
        ‖d_n (ξ, p.2)‖ ≤ (ρ_J / 2) * (1 / 2 : ℝ) ^ n := by
      intro ξ hξ
      have hξU : (ξ, p.2) ∈ U := hV₁_maps (hcb1_sub (Metric.sphere_subset_closedBall hξ))
      exact (hCore ρ_J (s_m (ξ, p.2)) (s_0 (ξ, p.2)) p.2 (hContr (ξ, p.2) hξU)).2.1 n
    have hderiv1 : ‖deriv (fun ξ : ℂ => d_n (ξ, p.2)) p.1‖ ≤
        ((ρ_J / 2) * (1 / 2 : ℝ) ^ n) / r₀ :=
      Complex.norm_deriv_le_of_forall_mem_sphere_norm_le hr₀_pos hdc1 hsph1
    let V₂ : Set ℂ := Metric.ball p₀.2 (3 * r₀)
    have hV₂_maps : Set.MapsTo (fun ζ : ℂ => (p.1, ζ)) V₂ U := by
      intro ζ hζ
      apply hR_sub
      rw [Metric.mem_ball] at hζ
      rw [Metric.mem_ball, Prod.dist_eq, max_lt_iff]
      dsimp [r₀] at hζ hy_lt
      exact ⟨by linarith, by linarith⟩
    have hslice2_diff : Differentiable ℂ (fun ζ : ℂ => (p.1, ζ)) :=
      fun ζ => (hslice2_hasDeriv p.1 ζ).differentiableAt
    have hslice2_holo : DifferentiableOn ℂ (fun ζ : ℂ => d_n (p.1, ζ)) V₂ :=
      hdn_holo.comp hslice2_diff.differentiableOn hV₂_maps
    have hcb2_sub : Metric.closedBall p.2 r₀ ⊆ V₂ := by
      intro ζ hζ
      rw [Metric.mem_closedBall] at hζ
      rw [Metric.mem_ball]
      exact lt_of_le_of_lt (dist_triangle ζ p.2 p₀.2) (by linarith)
    have hdc2 : DiffContOnCl ℂ (fun ζ : ℂ => d_n (p.1, ζ)) (Metric.ball p.2 r₀) :=
      hslice2_holo.diffContOnCl_ball hcb2_sub
    have hsph2 : ∀ ζ ∈ Metric.sphere p.2 r₀,
        ‖d_n (p.1, ζ)‖ ≤ (ρ_J / 2) * (1 / 2 : ℝ) ^ n := by
      intro ζ hζ
      have hζU : (p.1, ζ) ∈ U := hV₂_maps (hcb2_sub (Metric.sphere_subset_closedBall hζ))
      exact (hCore ρ_J (s_m (p.1, ζ)) (s_0 (p.1, ζ)) ζ (hContr (p.1, ζ) hζU)).2.1 n
    have hderiv2 : ‖deriv (fun ζ : ℂ => d_n (p.1, ζ)) p.2‖ ≤
        ((ρ_J / 2) * (1 / 2 : ℝ) ^ n) / r₀ :=
      Complex.norm_deriv_le_of_forall_mem_sphere_norm_le hr₀_pos hdc2 hsph2
    have hpU : p ∈ U := hP₀_sub hp
    have hvn_at : DifferentiableAt ℂ (v n) p := (hv n).differentiableAt (hU.mem_nhds hpU)
    have hvn1_at : DifferentiableAt ℂ (v (n + 1)) p :=
      (hv (n + 1)).differentiableAt (hU.mem_nhds hpU)
    have hdn_at : DifferentiableAt ℂ d_n (p.1, p.2) := hvn_at.sub hvn1_at
    rw [dist_eq_norm, ← fderiv_sub hvn_at hvn1_at]
    calc ‖fderiv ℂ d_n (p.1, p.2)‖
        ≤ ‖deriv (fun ξ : ℂ => d_n (ξ, p.2)) p.1‖ +
            ‖deriv (fun ζ : ℂ => d_n (p.1, ζ)) p.2‖ :=
          hfderiv_2d d_n p.1 p.2 hdn_at
      _ ≤ ((ρ_J / 2) * (1 / 2 : ℝ) ^ n) / r₀ + ((ρ_J / 2) * (1 / 2 : ℝ) ^ n) / r₀ :=
          add_le_add hderiv1 hderiv2
      _ = (ρ_J / r₀) * (1 / 2 : ℝ) ^ n := by ring
  let g' : (ℂ × ℂ) → ((ℂ × ℂ) →L[ℂ] ℂ) :=
    fun p => Filter.limUnder Filter.atTop (fun n => fderiv ℂ (v n) p)
  have hg'_tail : ∀ p ∈ P₀, ∀ n : ℕ,
      dist (g' p) (fderiv ℂ (v n) p) ≤ (2 * ρ_J / r₀) * (1 / 2 : ℝ) ^ n := by
    intro p hp n
    have hcauchy : CauchySeq (fun k => fderiv ℂ (v k) p) :=
      cauchySeq_of_le_geometric (1 / 2 : ℝ) (ρ_J / r₀) (by norm_num) (hfderiv_step p hp)
    have hlim : Filter.Tendsto (fun k => fderiv ℂ (v k) p) Filter.atTop (nhds (g' p)) :=
      hcauchy.tendsto_limUnder
    have hd := dist_le_of_le_geometric_of_tendsto (1 / 2 : ℝ) (ρ_J / r₀)
      (by norm_num) (hfderiv_step p hp) hlim n
    rw [dist_comm]
    calc dist (fderiv ℂ (v n) p) (g' p)
        ≤ (ρ_J / r₀) * (1 / 2 : ℝ) ^ n / (1 - 1 / 2) := hd
      _ = (2 * ρ_J / r₀) * (1 / 2 : ℝ) ^ n := by ring
  have hunif : TendstoUniformlyOn (fun n p => fderiv ℂ (v n) p) g' Filter.atTop P₀ := by
    rw [Metric.tendstoUniformlyOn_iff]
    intro ε hε
    have hzero : Filter.Tendsto (fun n : ℕ => (2 * ρ_J / r₀) * (1 / 2 : ℝ) ^ n)
        Filter.atTop (nhds 0) := by
      simpa using
        (tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num : (0 : ℝ) ≤ 1 / 2)
          (by norm_num : (1 / 2 : ℝ) < 1)).const_mul (2 * ρ_J / r₀)
    filter_upwards [(tendsto_order.mp hzero).2 ε hε] with n hn p hp
    exact lt_of_le_of_lt (hg'_tail p hp n) hn
  have hv_fderiv : ∀ n : ℕ, ∀ x ∈ P₀, HasFDerivAt (v n) (fderiv ℂ (v n) x) x := by
    intro n x hx
    exact ((hv n).differentiableAt (hU.mem_nhds (hP₀_sub hx))).hasFDerivAt
  have hv_pt : ∀ x ∈ P₀, Filter.Tendsto (fun n => v n x) Filter.atTop (nhds (v_inf x)) := by
    intro x hx
    exact (hCore ρ_J (s_m x) (s_0 x) x.2 (hContr x (hP₀_sub hx))).2.2.1
  have h_fderiv_p₀ : HasFDerivAt v_inf (g' p₀) p₀ :=
    hasFDerivAt_of_tendstoUniformlyOn Metric.isOpen_ball hunif hv_fderiv hv_pt
      (Metric.mem_ball_self hr₀_pos)
  exact h_fderiv_p₀.differentiableAt.differentiableWithinAt

theorem base_substrip_lift_quadratic_bounds (S : FiniteWallNonisotropicStrip)
    (A : SmallFieldChordActionData S) :
    SteepContBaseBoundsProp S A :=
by
  intro δ_ceil hδ_pos hδ_lt
  have hH_pos : 0 < S.H := S.H_pos
  let H_1 : ℝ := S.H - δ_ceil / 8
  let H_2 : ℝ := S.H - (3 / 16 : ℝ) * δ_ceil
  let ρ_z : ℝ := δ_ceil / 32
  have hH1_pos : 0 < H_1 := by dsimp [H_1]; linarith
  have hH1_lt : H_1 < S.H := by dsimp [H_1]; linarith
  have hH2_pos : 0 < H_2 := by dsimp [H_2]; linarith
  have hH2_lt_H1 : H_2 < H_1 := by dsimp [H_1, H_2]; linarith
  have hρz_pos : 0 < ρ_z := by dsimp [ρ_z]; linarith
  obtain ⟨r_sub, hr_sub_pos, hr_sub_lt, hRec⟩ := A.exact_recurrence H_1 hH1_pos hH1_lt
  let r_1 : ℝ := r_sub / 2
  have hr1_pos : 0 < r_1 := by dsimp [r_1]; linarith
  have hr1_lt_sub : r_1 < r_sub := by dsimp [r_1]; linarith
  let r_base : ℝ := min r_1 ρ_z
  have hr_base_pos : 0 < r_base := lt_min hr1_pos hρz_pos
  have hr_base_le_r1 : r_base ≤ r_1 := min_le_left _ _
  have hr_base_le_ρz : r_base ≤ ρ_z := min_le_right _ _
  have hr_base_lt_star : r_base < S.r_star :=
    lt_of_le_of_lt hr_base_le_r1 (lt_trans hr1_lt_sub hr_sub_lt)
  let U_sub : Set (ℂ × ℂ) := horizStrip H_1 ×ˢ Metric.ball (0 : ℂ) r_sub
  let g : ℂ × ℂ → ℂ := fun p => S.𝔰 p - p.1
  have hU_sub_tube : U_sub ⊆ finiteWallTube S.r_star S.h_X := by
    intro p hp
    rcases hp with ⟨hz, ht⟩
    have ht_norm : ‖p.2‖ < r_sub := by simpa [Metric.mem_ball, dist_zero_right] using ht
    exact (hRec p.1 p.2 hz ht_norm).1
  have hg_holo : DifferentiableOn ℂ g U_sub :=
    (S.𝔰_holo.mono hU_sub_tube).sub differentiable_fst.differentiableOn
  have hg_cont : ContinuousOn g U_sub := hg_holo.continuousOn
  have hg_per_one : ∀ (z t : ℂ), z ∈ horizStrip H_1 → ‖t‖ < r_sub →
      g (z + 2 * Real.pi, t) = g (z, t) := by
    intro z t hz ht
    have h_mem : (z, t) ∈ finiteWallTube S.r_star S.h_X := (hRec z t hz ht).1
    have hqp := S.𝔰_quasiperiodic (z, t) h_mem
    dsimp [g] at hqp ⊢
    rw [hqp]
    ring
  have hg_per_nat : ∀ (n : ℕ) (z t : ℂ), z ∈ horizStrip H_1 → ‖t‖ < r_sub →
      g (z + (((n : ℝ) * (2 * Real.pi) : ℝ) : ℂ), t) = g (z, t) := by
    intro n
    induction n with
    | zero =>
      intro z t _ _
      simp
    | succ n ih =>
      intro z t hz ht
      have hz_n : z + (((n : ℝ) * (2 * Real.pi) : ℝ) : ℂ) ∈ horizStrip H_1 := by
        simpa [horizStrip] using hz
      have h_step : z + ((((n + 1 : ℕ) : ℝ) * (2 * Real.pi) : ℝ) : ℂ) =
          (z + (((n : ℝ) * (2 * Real.pi) : ℝ) : ℂ)) + 2 * Real.pi := by
        push_cast
        ring
      rw [h_step, hg_per_one _ t hz_n ht, ih z t hz ht]
  have hg_per_int : ∀ (k : ℤ) (z t : ℂ), z ∈ horizStrip H_1 → ‖t‖ < r_sub →
      g (z + (((k : ℝ) * (2 * Real.pi) : ℝ) : ℂ), t) = g (z, t) := by
    intro k z t hz ht
    rcases k with n | n
    · simpa using hg_per_nat n z t hz ht
    · set z' : ℂ := z + (((Int.negSucc n : ℝ) * (2 * Real.pi) : ℝ) : ℂ)
      have hz' : z' ∈ horizStrip H_1 := by
        simpa [z', horizStrip] using hz
      have h_back : z' + ((((n + 1 : ℕ) : ℝ) * (2 * Real.pi) : ℝ) : ℂ) = z := by
        simp only [z', Int.cast_negSucc]
        push_cast
        ring
      have h1 := hg_per_nat (n + 1) z' t hz' ht
      rw [h_back] at h1
      exact h1.symm
  have hg_mod_2pi : ∀ (z t : ℂ), z ∈ horizStrip H_1 → ‖t‖ < r_sub →
      ∃ x₀ ∈ Set.Icc (0 : ℝ) (2 * Real.pi),
        g (z, t) = g ((x₀ : ℂ) + (z.im : ℂ) * Complex.I, t) := by
    intro z t hz ht
    have h2pi : (0 : ℝ) < 2 * Real.pi := by positivity
    let k : ℤ := ⌊z.re / (2 * Real.pi)⌋
    let x₀ : ℝ := z.re - (k : ℝ) * (2 * Real.pi)
    have hk_le : (k : ℝ) ≤ z.re / (2 * Real.pi) := Int.floor_le _
    have hk_lt : z.re / (2 * Real.pi) < (k : ℝ) + 1 := Int.lt_floor_add_one _
    have hx₀_nonneg : 0 ≤ x₀ := by
      have := (le_div_iff₀ h2pi).mp hk_le
      linarith
    have hx₀_le : x₀ ≤ 2 * Real.pi := by
      have := (div_lt_iff₀ h2pi).mp hk_lt
      linarith
    refine ⟨x₀, ⟨hx₀_nonneg, hx₀_le⟩, ?_⟩
    set z₀ : ℂ := (x₀ : ℂ) + (z.im : ℂ) * Complex.I
    have hz₀ : z₀ ∈ horizStrip H_1 := by
      simpa [z₀, horizStrip] using hz
    have hz_eq : z₀ + (((k : ℝ) * (2 * Real.pi) : ℝ) : ℂ) = z := by
      apply Complex.ext
      · simp [z₀, x₀]
      · simp [z₀]
    rw [← hz_eq, hg_per_int k z₀ t hz₀ ht]
  let K_box : Set ((ℝ × ℝ) × ℂ) :=
    (Set.Icc (0 : ℝ) (2 * Real.pi) ×ˢ Set.Icc (-H_2) H_2) ×ˢ
      Metric.closedBall (0 : ℂ) r_1
  have hK_comp : IsCompact K_box :=
    (isCompact_Icc.prod isCompact_Icc).prod (isCompact_closedBall (0 : ℂ) r_1)
  have hK_ne : K_box.Nonempty :=
    ⟨((0, 0), 0), ⟨⟨le_rfl, by positivity⟩, ⟨by linarith, by linarith⟩⟩,
      Metric.mem_closedBall_self hr1_pos.le⟩
  let ψ : (ℝ × ℝ) × ℂ → ℂ × ℂ := fun q => ((q.1.1 : ℂ) + (q.1.2 : ℂ) * Complex.I, q.2)
  have hψ_cont : Continuous ψ := by fun_prop
  have hψ_maps : Set.MapsTo ψ K_box U_sub := by
    intro q hq
    rcases hq with ⟨⟨_, hq_im_lo, hq_im_hi⟩, hq_t⟩
    refine ⟨?_, ?_⟩
    · change |((q.1.1 : ℂ) + (q.1.2 : ℂ) * Complex.I).im| < H_1
      have him : ((q.1.1 : ℂ) + (q.1.2 : ℂ) * Complex.I).im = q.1.2 := by simp
      rw [him, abs_lt]
      constructor <;> linarith
    · exact Metric.closedBall_subset_ball hr1_lt_sub hq_t
  have h_norm_cont : ContinuousOn (fun q => ‖g (ψ q)‖) K_box :=
    (continuous_norm.comp_continuousOn hg_cont).comp hψ_cont.continuousOn hψ_maps
  obtain ⟨q_max, _, hq_max⟩ := hK_comp.exists_isMaxOn hK_ne h_norm_cont
  let M_box : ℝ := max ‖g (ψ q_max)‖ 1
  have hM_box_ge_one : 1 ≤ M_box := le_max_right _ _
  have hM_box_pos : 0 < M_box := lt_of_lt_of_le zero_lt_one hM_box_ge_one
  have hg_slab_bdd : ∀ (z t : ℂ), |z.im| ≤ H_2 → ‖t‖ ≤ r_1 → ‖g (z, t)‖ ≤ M_box := by
    intro z t hz_im ht_r1
    have hz_H1 : z ∈ horizStrip H_1 := lt_of_le_of_lt hz_im hH2_lt_H1
    have ht_sub : ‖t‖ < r_sub := lt_of_le_of_lt ht_r1 hr1_lt_sub
    obtain ⟨x₀, hx₀, hg_eq⟩ := hg_mod_2pi z t hz_H1 ht_sub
    have hq_mem : ((x₀, z.im), t) ∈ K_box := by
      refine ⟨⟨hx₀, abs_le.mp hz_im⟩, ?_⟩
      simpa [Metric.mem_closedBall, dist_zero_right] using ht_r1
    have hg_psi : g ((x₀ : ℂ) + (z.im : ℂ) * Complex.I, t) = g (ψ ((x₀, z.im), t)) := rfl
    rw [hg_eq, hg_psi]
    exact le_trans (hq_max hq_mem) (le_max_left _ _)
  let C_0 : ℝ := M_box / r_1 ^ 2
  have hC0_pos : 0 < C_0 := by positivity
  have hg_quad_bdd : ∀ (z t : ℂ), |z.im| ≤ H_2 → ‖t‖ ≤ r_1 →
      ‖g (z, t)‖ ≤ C_0 * ‖t‖ ^ 2 := by
    intro z t hz_im ht_r1
    have hz_H1 : z ∈ horizStrip H_1 := lt_of_le_of_lt hz_im hH2_lt_H1
    have hz_H : z ∈ horizStrip S.H := lt_trans hz_H1 hH1_lt
    let f_z : ℂ → ℂ := fun w => g (z, w)
    have hf_holo : DifferentiableOn ℂ f_z (Metric.ball 0 r_sub) := by
      have h_slice_diff : Differentiable ℂ (fun w : ℂ => (z, w)) :=
        Differentiable.prodMk (differentiable_const z) differentiable_id
      have h_slice_maps : Set.MapsTo (fun w : ℂ => (z, w)) (Metric.ball 0 r_sub) U_sub :=
        fun w hw => ⟨hz_H1, hw⟩
      exact hg_holo.comp h_slice_diff.differentiableOn h_slice_maps
    have hf0 : f_z 0 = 0 := by
      dsimp [f_z, g]
      rw [S.𝔰_zero z hz_H, sub_self]
    have hdf0 : deriv f_z 0 = 0 := by
      have h_d : deriv (fun w : ℂ => S.𝔰 (z, w) - z) 0 = deriv (fun w : ℂ => S.𝔰 (z, w)) 0 :=
        deriv_sub_const z
      dsimp [f_z, g]
      rw [h_d, S.𝔰_deriv_t_zero z hz_H]
    let q_z : ℂ → ℂ := dslope (dslope f_z 0) 0
    have h_nhds : Metric.ball (0 : ℂ) r_sub ∈ nhds (0 : ℂ) :=
      Metric.ball_mem_nhds 0 hr_sub_pos
    have hd1_holo : DifferentiableOn ℂ (dslope f_z 0) (Metric.ball 0 r_sub) :=
      (Complex.differentiableOn_dslope h_nhds).mpr hf_holo
    have hq_holo : DifferentiableOn ℂ q_z (Metric.ball 0 r_sub) :=
      (Complex.differentiableOn_dslope h_nhds).mpr hd1_holo
    have hd1_zero : dslope f_z 0 0 = 0 := by
      rw [dslope_same, hdf0]
    have hf_eq : ∀ w : ℂ, f_z w = w ^ 2 * q_z w := by
      intro w
      have h1 := sub_smul_dslope f_z 0 w
      have h2 := sub_smul_dslope (dslope f_z 0) 0 w
      simp only [sub_zero, smul_eq_mul, hf0, hd1_zero] at h1 h2
      calc f_z w = w * dslope f_z 0 w := h1.symm
        _ = w * (w * q_z w) := by rw [← h2]
        _ = w ^ 2 * q_z w := by ring
    have hq_dc : DiffContOnCl ℂ q_z (Metric.ball 0 r_1) :=
      hq_holo.diffContOnCl_ball (Metric.closedBall_subset_ball hr1_lt_sub)
    have hq_front : ∀ w ∈ frontier (Metric.ball (0 : ℂ) r_1), ‖q_z w‖ ≤ C_0 := by
      intro w hw
      rw [frontier_ball (0 : ℂ) hr1_pos.ne'] at hw
      have hw_norm : ‖w‖ = r_1 := by simpa [Metric.mem_sphere, dist_zero_right] using hw
      have hfw : ‖f_z w‖ ≤ M_box := hg_slab_bdd z w hz_im hw_norm.le
      rw [hf_eq w, norm_mul, norm_pow, hw_norm] at hfw
      exact (le_div_iff₀' (sq_pos_of_pos hr1_pos)).mpr hfw
    have ht_cl : t ∈ closure (Metric.ball (0 : ℂ) r_1) := by
      rw [closure_ball (0 : ℂ) hr1_pos.ne']
      simpa [Metric.mem_closedBall, dist_zero_right] using ht_r1
    have hqt : ‖q_z t‖ ≤ C_0 :=
      Complex.norm_le_of_forall_mem_frontier_norm_le Metric.isBounded_ball hq_dc hq_front ht_cl
    calc ‖g (z, t)‖ = ‖f_z t‖ := rfl
      _ = ‖t ^ 2 * q_z t‖ := by rw [hf_eq t]
      _ = ‖t‖ ^ 2 * ‖q_z t‖ := by rw [norm_mul, norm_pow]
      _ ≤ ‖t‖ ^ 2 * C_0 := mul_le_mul_of_nonneg_left hqt (sq_nonneg _)
      _ = C_0 * ‖t‖ ^ 2 := mul_comm _ _
  let C_base : ℝ := max C_0 (32 * C_0 / δ_ceil)
  have hC_base_pos : 0 < C_base := lt_of_lt_of_le hC0_pos (le_max_left _ _)
  have hC0_le_base : C_0 ≤ C_base := le_max_left _ _
  have hC1_le_base : 32 * C_0 / δ_ceil ≤ C_base := le_max_right _ _
  refine ⟨r_base, C_base, hr_base_pos, hr_base_lt_star, hC_base_pos, ?_⟩
  intro y t hy_im ht_lt
  have hy_H2 : |y.im| ≤ H_2 := by dsimp [H_2]; linarith
  have hy_H1 : y ∈ horizStrip H_1 := lt_of_le_of_lt hy_H2 hH2_lt_H1
  have ht_r1 : ‖t‖ ≤ r_1 := le_trans ht_lt.le hr_base_le_r1
  have ht_ρz : ‖t‖ ≤ ρ_z := le_trans ht_lt.le hr_base_le_ρz
  have ht_sub : ‖t‖ < r_sub := lt_of_le_of_lt ht_r1 hr1_lt_sub
  have hRec_yt := hRec y t hy_H1 ht_sub
  have h_disp_yt : ‖S.𝔰 (y, t) - y‖ ≤ C_base * ‖t‖ ^ 2 := by
    calc ‖S.𝔰 (y, t) - y‖ = ‖g (y, t)‖ := rfl
      _ ≤ C_0 * ‖t‖ ^ 2 := hg_quad_bdd y t hy_H2 ht_r1
      _ ≤ C_base * ‖t‖ ^ 2 := mul_le_mul_of_nonneg_right hC0_le_base (sq_nonneg _)
  refine ⟨hRec_yt.1, hRec_yt.2.1, hRec_yt.2.2.1, h_disp_yt, ?_⟩
  intro ht_ne
  have ht_pos : 0 < ‖t‖ := norm_pos_iff.mpr ht_ne
  rcases hRec_yt.2.2.2 ht_ne with ⟨hDom1, hDom2, _, _, hEq⟩
  let h_t : ℂ → ℂ := fun z => g (z, t)
  have hh_holo : DifferentiableOn ℂ h_t (horizStrip H_1) := by
    have h_slice_diff : Differentiable ℂ (fun z : ℂ => (z, t)) :=
      Differentiable.prodMk differentiable_id (differentiable_const t)
    have h_slice_maps : Set.MapsTo (fun z : ℂ => (z, t)) (horizStrip H_1) U_sub :=
      fun z hz => ⟨hz, by simpa [Metric.mem_ball, dist_zero_right] using ht_sub⟩
    exact hg_holo.comp h_slice_diff.differentiableOn h_slice_maps
  have h_open_H1 : IsOpen (horizStrip H_1) :=
    isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const
  have h_disk_im : ∀ w ∈ Metric.closedBall y ρ_z,
      ∀ ζ ∈ Metric.closedBall w ρ_z, |ζ.im| ≤ H_2 := by
    intro w hw ζ hζ
    have hw_norm : ‖w - y‖ ≤ ρ_z := by simpa [Metric.mem_closedBall, dist_eq_norm] using hw
    have hζ_norm : ‖ζ - w‖ ≤ ρ_z := by simpa [Metric.mem_closedBall, dist_eq_norm] using hζ
    have h_im_w : |(w - y).im| ≤ ρ_z := le_trans (Complex.abs_im_le_norm (w - y)) hw_norm
    have h_im_ζ : |(ζ - w).im| ≤ ρ_z := le_trans (Complex.abs_im_le_norm (ζ - w)) hζ_norm
    have h_eq_im : ζ.im = y.im + (w - y).im + (ζ - w).im := by simp
    rw [abs_le] at hy_im h_im_w h_im_ζ ⊢
    dsimp [H_2, ρ_z] at h_im_w h_im_ζ ⊢
    constructor <;> linarith
  have h_deriv_bd : ∀ w ∈ Metric.closedBall y ρ_z,
      DifferentiableAt ℂ h_t w ∧ ‖deriv h_t w‖ ≤ (32 * C_0 / δ_ceil) * ‖t‖ ^ 2 := by
    intro w hw
    have h_sub : Metric.closedBall w ρ_z ⊆ horizStrip H_1 := by
      intro ζ hζ
      exact lt_of_le_of_lt (h_disk_im w hw ζ hζ) hH2_lt_H1
    have hw_mem : w ∈ horizStrip H_1 := h_sub (Metric.mem_closedBall_self hρz_pos.le)
    have h_diffAt : DifferentiableAt ℂ h_t w :=
      hh_holo.differentiableAt (h_open_H1.mem_nhds hw_mem)
    have h_dc : DiffContOnCl ℂ h_t (Metric.ball w ρ_z) :=
      hh_holo.diffContOnCl_ball h_sub
    have h_sph : ∀ ζ ∈ Metric.sphere w ρ_z, ‖h_t ζ‖ ≤ C_0 * ‖t‖ ^ 2 := by
      intro ζ hζ
      exact hg_quad_bdd ζ t (h_disk_im w hw ζ (Metric.sphere_subset_closedBall hζ)) ht_r1
    have h_cauchy := Complex.norm_deriv_le_of_forall_mem_sphere_norm_le hρz_pos h_dc h_sph
    have h_div_eq : (C_0 * ‖t‖ ^ 2) / ρ_z = (32 * C_0 / δ_ceil) * ‖t‖ ^ 2 := by
      dsimp [ρ_z]
      ring
    rw [h_div_eq] at h_cauchy
    exact ⟨h_diffAt, h_cauchy⟩
  have h_conv : Convex ℝ (Metric.closedBall y ρ_z) := convex_closedBall y ρ_z
  have hy_mem : y ∈ Metric.closedBall y ρ_z := Metric.mem_closedBall_self hρz_pos.le
  have hyp_mem : y + t ∈ Metric.closedBall y ρ_z := by
    simpa [Metric.mem_closedBall, dist_eq_norm] using ht_ρz
  have hym_mem : y - t ∈ Metric.closedBall y ρ_z := by
    simpa [Metric.mem_closedBall, dist_eq_norm] using ht_ρz
  have h_mvt_p := h_conv.norm_image_sub_le_of_norm_deriv_le
    (fun w hw => (h_deriv_bd w hw).1) (fun w hw => (h_deriv_bd w hw).2) hy_mem hyp_mem
  have h_mvt_m := h_conv.norm_image_sub_le_of_norm_deriv_le
    (fun w hw => (h_deriv_bd w hw).1) (fun w hw => (h_deriv_bd w hw).2) hym_mem hy_mem
  have h_diff_p : ‖h_t (y + t) - h_t y‖ ≤ ((32 * C_0 / δ_ceil) * ‖t‖ ^ 2) * ‖t‖ := by
    simpa using h_mvt_p
  have h_diff_m : ‖h_t y - h_t (y - t)‖ ≤ ((32 * C_0 / δ_ceil) * ‖t‖ ^ 2) * ‖t‖ := by
    simpa using h_mvt_m
  dsimp only
  have hJm_eq : (S.𝔰 (y, t) - S.𝔰 (y - t, t)) / t - 1 = (h_t y - h_t (y - t)) / t := by
    dsimp [h_t, g]
    field_simp [ht_ne]
    ring
  have hJp_eq : (S.𝔰 (y + t, t) - S.𝔰 (y, t)) / t - 1 = (h_t (y + t) - h_t y) / t := by
    dsimp [h_t, g]
    field_simp [ht_ne]
    ring
  have hJm_bd : ‖(S.𝔰 (y, t) - S.𝔰 (y - t, t)) / t - 1‖ ≤ C_base * ‖t‖ ^ 2 := by
    rw [hJm_eq, norm_div]
    exact le_trans ((div_le_iff₀ ht_pos).mpr h_diff_m)
      (mul_le_mul_of_nonneg_right hC1_le_base (sq_nonneg _))
  have hJp_bd : ‖(S.𝔰 (y + t, t) - S.𝔰 (y, t)) / t - 1‖ ≤ C_base * ‖t‖ ^ 2 := by
    rw [hJp_eq, norm_div]
    exact le_trans ((div_le_iff₀ ht_pos).mpr h_diff_p)
      (mul_le_mul_of_nonneg_right hC1_le_base (sq_nonneg _))
  exact ⟨hJm_bd, hJp_bd, hDom1, hDom2, hEq⟩

theorem steep_cone_step_admissibility_and_mesh_sum (S : FiniteWallNonisotropicStrip)
    (A : SmallFieldChordActionData S)
    (hJets : SteepContJetProp S A) :
    SteepContStepAdmProp S A :=
by
  constructor
  · 
    intro β x_start Δ M hβ hx_pos hΔ_pos
    have h1β_neg : 1 - β < 0 := by linarith only [hβ]
    have h1β_ne : 1 - β ≠ 0 := ne_of_lt h1β_neg
    let g : ℝ → ℝ := fun u => (x_start + u) ^ (1 - β) / (1 - β)
    have hg_deriv : ∀ u : ℝ, 0 ≤ u → HasDerivAt g ((x_start + u) ^ (-β)) u := by
      intro u hu
      have hxu_pos : 0 < x_start + u := by linarith only [hx_pos, hu]
      have h1 : HasDerivAt (fun v : ℝ => x_start + v) 1 u := by
        simpa using (hasDerivAt_id u).const_add x_start
      have h2 : HasDerivAt (fun z : ℝ => z ^ (1 - β))
          ((1 - β) * (x_start + u) ^ ((1 - β) - 1)) (x_start + u) :=
        Real.hasDerivAt_rpow_const (Or.inl (ne_of_gt hxu_pos))
      have h3 : HasDerivAt g
          (((1 - β) * (x_start + u) ^ ((1 - β) - 1) * 1) / (1 - β)) u :=
        (h2.comp u h1).div_const (1 - β)
      have h_eq : ((1 - β) * (x_start + u) ^ ((1 - β) - 1) * 1) / (1 - β) =
          (x_start + u) ^ (-β) := by
        have h_exp : (1 - β) - 1 = -β := by ring
        rw [h_exp, mul_one, mul_div_cancel_left₀ _ h1β_ne]
      rwa [h_eq] at h3
    let f_tele : ℕ → ℝ := fun k => g ((k : ℝ) * Δ)
    have h_step : ∀ j : ℕ,
        Δ * (x_start + (((j + 1 : ℕ) : ℝ)) * Δ) ^ (-β) ≤ f_tele (j + 1) - f_tele j := by
      intro j
      set a_j : ℝ := (j : ℝ) * Δ
      set b_j : ℝ := (((j + 1 : ℕ) : ℝ)) * Δ
      have ha_nonneg : 0 ≤ a_j := mul_nonneg (Nat.cast_nonneg j) hΔ_pos.le
      have hba : b_j - a_j = Δ := by
        dsimp [a_j, b_j]
        push_cast
        ring
      have hab : a_j < b_j := by linarith only [hba, hΔ_pos]
      have hg_cont : ContinuousOn g (Set.Icc a_j b_j) := by
        intro u hu
        exact (hg_deriv u (le_trans ha_nonneg hu.1)).continuousAt.continuousWithinAt
      have hg_oo : ∀ u ∈ Set.Ioo a_j b_j, HasDerivAt g ((x_start + u) ^ (-β)) u := by
        intro u hu
        exact hg_deriv u (le_trans ha_nonneg (le_of_lt hu.1))
      obtain ⟨c, hc_mem, hc_eq⟩ := exists_hasDerivAt_eq_slope g
        (fun u => (x_start + u) ^ (-β)) hab hg_cont hg_oo
      have hxc_pos : 0 < x_start + c := by linarith only [hx_pos, ha_nonneg, hc_mem.1]
      have hxc_le : x_start + c ≤ x_start + b_j := by linarith only [hc_mem.2]
      have h_mono : (x_start + b_j) ^ (-β) ≤ (x_start + c) ^ (-β) :=
        Real.rpow_le_rpow_of_nonpos hxc_pos hxc_le (by linarith only [hβ])
      rw [hc_eq, hba] at h_mono
      have h_mul := mul_le_mul_of_nonneg_left h_mono hΔ_pos.le
      have h_cancel : Δ * ((g b_j - g a_j) / Δ) = g b_j - g a_j :=
        mul_div_cancel₀ _ hΔ_pos.ne'
      rw [h_cancel] at h_mul
      exact h_mul
    have h_sum : Δ * (∑ j ∈ Finset.range M, (x_start + (((j + 1 : ℕ) : ℝ)) * Δ) ^ (-β)) ≤
        f_tele M - f_tele 0 := by
      rw [Finset.mul_sum, ← Finset.sum_range_sub f_tele M]
      exact Finset.sum_le_sum (fun j _ => h_step j)
    have hf0 : f_tele 0 = -(x_start ^ (1 - β) / (β - 1)) := by
      dsimp [f_tele, g]
      simp only [Nat.cast_zero, zero_mul, add_zero]
      have h_sub : 1 - β = -(β - 1) := by ring
      rw [h_sub, div_neg]
    have hfM_nonpos : f_tele M ≤ 0 := by
      dsimp [f_tele, g]
      have h_pos_base : 0 < x_start + (M : ℝ) * Δ := by positivity
      have h_pos_num : 0 < (x_start + (M : ℝ) * Δ) ^ (1 - β) :=
        Real.rpow_pos_of_pos h_pos_base (1 - β)
      exact le_of_lt (div_neg_of_pos_of_neg h_pos_num h1β_neg)
    linarith only [h_sum, hf0, hfM_nonpos]
  · 
    intro α m_steep γ_steep δ_ceil δ_b K hα1 hα2 hm_pos hγ_pos hγ_lt hδc_pos hδc_lt_b hδb_lt_H
      hK_pos L ρ_J
    have hCSL_pos : 0 < A.C_SL := A.C_SL_pos
    have hηSL_pos : 0 < A.η_SL := A.η_SL_pos
    let K1 : ℝ := 1 + 20 * K
    have hK1_gt_one : 1 < K1 := by dsimp [K1]; linarith only [hK_pos]
    have hK1_pos : 0 < K1 := lt_trans zero_lt_one hK1_gt_one
    have hρJ_pos : 0 < ρ_J := by dsimp [ρ_J]; positivity
    have hρJ_le : ρ_J ≤ 1 / 32 := by
      dsimp [ρ_J]
      rw [div_le_div_iff₀ (by positivity) (by norm_num)]
      linarith only [hK_pos]
    let C_Ma : ℝ := 1000000 * A.C_SL * K1 ^ 4
    have hCMa_pos : 0 < C_Ma := by positivity
    let C_res : ℝ := 320 * K1 * (2 / ρ_J + 1) * C_Ma
    have hCres_pos : 0 < C_res := by positivity
    let D_G : ℝ := 4 / ρ_J ^ 2 + 1600 * K / ρ_J
    have hDG_pos : 0 < D_G := by positivity
    let Θ_adm : ℝ :=
      min (min 1 (A.η_SL / (640 * K1 ^ 2)))
        (min (1 / (32 * D_G * C_Ma)) (ρ_J / (20 * K * C_res)))
    have hΘ_pos : 0 < Θ_adm :=
      lt_min (lt_min zero_lt_one (by positivity)) (lt_min (by positivity) (by positivity))
    have hΘ_le_one : Θ_adm ≤ 1 := le_trans (min_le_left _ _) (min_le_left _ _)
    have hΘ_le_η : Θ_adm ≤ A.η_SL / (640 * K1 ^ 2) :=
      le_trans (min_le_left _ _) (min_le_right _ _)
    have hΘ_le_G : Θ_adm ≤ 1 / (32 * D_G * C_Ma) :=
      le_trans (min_le_right _ _) (min_le_left _ _)
    have hΘ_le_res : Θ_adm ≤ ρ_J / (20 * K * C_res) :=
      le_trans (min_le_right _ _) (min_le_right _ _)
    refine ⟨Θ_adm, C_res, hΘ_pos, hCres_pos, ?_⟩
    intro d x₀ r ε hd_pos hr_pos hr_le hε_pos hΘ_in hCone z_0 t s_m s_0 ht_steep hzp_lo hzm_hi
      hzp_re ht_norm hsm_err hs0_err hJm_err
    
    have ht_im_pos : 0 < t.im :=
      lt_of_le_of_lt (mul_nonneg hγ_pos.le (norm_nonneg t)) ht_steep
    have ht_norm_pos : 0 < ‖t‖ := lt_of_lt_of_le ht_im_pos (Complex.im_le_norm t)
    have ht_ne : t ≠ 0 := norm_pos_iff.mp ht_norm_pos
    let J_m : ℂ := (s_0 - s_m) / t
