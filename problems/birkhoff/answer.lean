            -2 * w_max.im * (ζ.im - w_max.im) := by
          simp
        have h_half : ((1 / 2 : ℂ) * (((ζ.re - w_max.re : ℝ) : ℂ) +
            ((ζ.im - w_max.im : ℝ) : ℂ) * Complex.I) ^ 2).re =
            (1 / 2 : ℝ) * ((ζ.re - w_max.re) ^ 2 - (ζ.im - w_max.im) ^ 2) := by
