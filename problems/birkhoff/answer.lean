    have hab_lt_2pi : |a' - b'| < 2 * Real.pi := by
      rw [← Real.dist_eq, hab_dist]
      exact lt_of_lt_of_le hab (min_le_right _ _)
    have ha_mem : a' ∈ Set.Icc (-2 * Real.pi) (4 * Real.pi) :=
