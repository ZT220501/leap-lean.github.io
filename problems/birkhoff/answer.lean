      intro A c
      rw [Polynomial.comp_assoc]
      have hX : (Polynomial.X + Polynomial.C c).comp (Polynomial.X - Polynomial.C c) = Polynomial.X := by
        simp
      rw [hX, Polynomial.comp_X]
    have h_comp_ne : ∀ (A : Polynomial ℂ), A ≠ 0 → A.comp (Polynomial.X + 1) ≠ 0 := by
