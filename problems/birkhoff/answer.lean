        rw [Metric.mem_ball, dist_eq_norm] at hz'
        exact (hv_props z' t (lt_of_lt_of_le hz' hr₁_le_2rZ) (lt_of_lt_of_le ht hr₁_le_2rZ)).2.2.2.2
      have hev_t : (fun t' => X_Z (z, t')) =ᶠ[nhds t] (fun t' => G.Z_loc (v (z, t'))) := by
