          (∀ k ≤ m,
            y₀ + (k : ℂ) * (if pos then b else -b) ∈
              Metric.closedBall y_edge (M.ρ_1 / 3)) →
          ‖z₀.1 - y₀‖ ≤ C_init * ‖b‖ →
          ‖z₀.2 / b - p₀ y₀‖ ≤ C_init * ‖b‖ →
          ∀ k ≤ m,
            (stepMap pos)^[k] z₀ ∈ Metric.ball y_edge M.ρ_0 ×ˢ Metric.ball (0 : ℂ) M.ρ_v := by
    let B_0 : Set ℂ := Metric.ball y_edge M.ρ_0
    let K_u : Set ℂ := Metric.closedBall y_edge (M.ρ_1 / 2)
    let K_uv : Set (ℂ × ℂ) := K_u ×ˢ Metric.closedBall (0 : ℂ) (M.ρ_v1 / 2)
    have hKu_sub : K_u ⊆ B_0 := by
      intro u hu
      rw [Metric.mem_closedBall] at hu
      rw [Metric.mem_ball]
      linarith
    have hKuv_sub : K_uv ⊆ B_0 ×ˢ Metric.ball (0 : ℂ) M.ρ_v := by
      rintro ⟨u, v⟩ ⟨hu, hv⟩
      refine ⟨hKu_sub hu, ?_⟩
      rw [Metric.mem_closedBall] at hv
      rw [Metric.mem_ball]
      linarith
    have hσ1_holo : DifferentiableOn ℂ (deriv M.σ) B_0 := M.σ_holo.deriv isOpen_ball
    have hσ2_holo : DifferentiableOn ℂ (deriv (deriv M.σ)) B_0 := hσ1_holo.deriv isOpen_ball
    have hp0_holo : DifferentiableOn ℂ p₀ B_0 := M.σ_holo.fun_inv M.σ_ne_zero
    have hp0_1_holo : DifferentiableOn ℂ (deriv p₀) B_0 := hp0_holo.deriv isOpen_ball
    have hp0_2_holo : DifferentiableOn ℂ (deriv (deriv p₀)) B_0 := hp0_1_holo.deriv isOpen_ball
    have hp0_deriv_eq : ∀ u ∈ B_0, deriv p₀ u = -deriv M.σ u * p₀ u ^ 2 := by
      intro u hu
      have hne : M.σ u ≠ 0 := M.σ_ne_zero u hu
      have hda : DifferentiableAt ℂ M.σ u := M.σ_holo.differentiableAt (isOpen_ball.mem_nhds hu)
      have hhda := hda.hasDerivAt.fun_inv hne
      rw [hhda.deriv]
      dsimp [p₀]
      field_simp
    have hKu_comp : IsCompact K_u := isCompact_closedBall y_edge (M.ρ_1 / 2)
    have hKuv_comp : IsCompact K_uv :=
      hKu_comp.prod (isCompact_closedBall (0 : ℂ) (M.ρ_v1 / 2))
    obtain ⟨M_σ_r, hM_σ_r⟩ :=
      hKu_comp.exists_bound_of_continuousOn (M.σ_holo.continuousOn.mono hKu_sub)
    obtain ⟨M_σ1_r, hM_σ1_r⟩ :=
      hKu_comp.exists_bound_of_continuousOn (hσ1_holo.continuousOn.mono hKu_sub)
    obtain ⟨L_σ1_r, hL_σ1_r⟩ :=
      hKu_comp.exists_bound_of_continuousOn (hσ2_holo.continuousOn.mono hKu_sub)
    obtain ⟨M_p0_r, hM_p0_r⟩ :=
      hKu_comp.exists_bound_of_continuousOn (hp0_holo.continuousOn.mono hKu_sub)
    obtain ⟨L_p0'_r, hL_p0'_r⟩ :=
      hKu_comp.exists_bound_of_continuousOn (hp0_2_holo.continuousOn.mono hKu_sub)
    obtain ⟨M_Ap_r, hM_Ap_r⟩ :=
      hKuv_comp.exists_bound_of_continuousOn (M.rem_holo.1.continuousOn.mono hKuv_sub)
    obtain ⟨M_Bp_r, hM_Bp_r⟩ :=
      hKuv_comp.exists_bound_of_continuousOn (M.rem_holo.2.1.continuousOn.mono hKuv_sub)
    obtain ⟨M_Am_r, hM_Am_r⟩ :=
      hKuv_comp.exists_bound_of_continuousOn (M.rem_holo.2.2.1.continuousOn.mono hKuv_sub)
    obtain ⟨M_Bm_r, hM_Bm_r⟩ :=
      hKuv_comp.exists_bound_of_continuousOn (M.rem_holo.2.2.2.continuousOn.mono hKuv_sub)
    let M_σ : ℝ := max M_σ_r 1
    let M_σ1 : ℝ := max M_σ1_r 1
    let L_σ1 : ℝ := max L_σ1_r 1
    let M_p0 : ℝ := max M_p0_r 1
    let L_p0' : ℝ := max L_p0'_r 1
    let M_rem : ℝ := max (max (max M_Ap_r M_Bp_r) (max M_Am_r M_Bm_r)) 1
    have hM_σ_ge1 : 1 ≤ M_σ := le_max_right _ _
    have hM_σ1_ge1 : 1 ≤ M_σ1 := le_max_right _ _
    have hL_σ1_ge1 : 1 ≤ L_σ1 := le_max_right _ _
    have hM_p0_ge1 : 1 ≤ M_p0 := le_max_right _ _
    have hL_p0'_ge1 : 1 ≤ L_p0' := le_max_right _ _
    have hM_rem_ge1 : 1 ≤ M_rem := le_max_right _ _
    have hM_σ_bd : ∀ u ∈ K_u, ‖M.σ u‖ ≤ M_σ :=
      fun u hu => le_trans (hM_σ_r u hu) (le_max_left _ _)
    have hM_σ1_bd : ∀ u ∈ K_u, ‖deriv M.σ u‖ ≤ M_σ1 :=
      fun u hu => le_trans (hM_σ1_r u hu) (le_max_left _ _)
    have hL_σ1_bd : ∀ u ∈ K_u, ‖deriv (deriv M.σ) u‖ ≤ L_σ1 :=
      fun u hu => le_trans (hL_σ1_r u hu) (le_max_left _ _)
    have hM_p0_bd : ∀ u ∈ K_u, ‖p₀ u‖ ≤ M_p0 :=
      fun u hu => le_trans (hM_p0_r u hu) (le_max_left _ _)
    have hL_p0'_bd : ∀ u ∈ K_u, ‖deriv (deriv p₀) u‖ ≤ L_p0' :=
      fun u hu => le_trans (hL_p0'_r u hu) (le_max_left _ _)
    have hLip_σ : ∀ u ∈ K_u, ∀ y ∈ K_u, ‖M.σ u - M.σ y‖ ≤ M_σ1 * ‖u - y‖ :=
      fun u hu y hy => Convex.norm_image_sub_le_of_norm_deriv_le
        (fun z hz => M.σ_holo.differentiableAt (isOpen_ball.mem_nhds (hKu_sub hz)))
        hM_σ1_bd (convex_closedBall y_edge (M.ρ_1 / 2)) hy hu
    have hLip_σ1 : ∀ u ∈ K_u, ∀ y ∈ K_u, ‖deriv M.σ u - deriv M.σ y‖ ≤ L_σ1 * ‖u - y‖ :=
      fun u hu y hy => Convex.norm_image_sub_le_of_norm_deriv_le
        (fun z hz => hσ1_holo.differentiableAt (isOpen_ball.mem_nhds (hKu_sub hz)))
        hL_σ1_bd (convex_closedBall y_edge (M.ρ_1 / 2)) hy hu
    have hLip_p0' : ∀ u ∈ K_u, ∀ y ∈ K_u, ‖deriv p₀ u - deriv p₀ y‖ ≤ L_p0' * ‖u - y‖ :=
      fun u hu y hy => Convex.norm_image_sub_le_of_norm_deriv_le
        (fun z hz => hp0_1_holo.differentiableAt (isOpen_ball.mem_nhds (hKu_sub hz)))
        hL_p0'_bd (convex_closedBall y_edge (M.ρ_1 / 2)) hy hu
    have hTaylor_p0 : ∀ y ∈ Metric.closedBall y_edge (M.ρ_1 / 3), ∀ w : ℂ, ‖w‖ ≤ M.ρ_1 / 6 →
        ‖p₀ (y + w) - p₀ y + w * deriv M.σ y * p₀ y ^ 2‖ ≤ L_p0' * ‖w‖ ^ 2 := by
      intro y hy_cb w hw_le
      have hy_dist : dist y y_edge ≤ M.ρ_1 / 3 := Metric.mem_closedBall.mp hy_cb
      have hDy_sub : Metric.closedBall y ‖w‖ ⊆ K_u := by
        intro z hz
        rw [Metric.mem_closedBall] at hz ⊢
        calc dist z y_edge ≤ dist z y + dist y y_edge := dist_triangle z y y_edge
          _ ≤ M.ρ_1 / 2 := by linarith
      have hy_in_Dy : y ∈ Metric.closedBall y ‖w‖ := Metric.mem_closedBall_self (norm_nonneg w)
      have hyw_in_Dy : y + w ∈ Metric.closedBall y ‖w‖ := by
        rw [Metric.mem_closedBall, dist_eq_norm, add_sub_cancel_left]
      let q_fn : ℂ → ℂ := fun z => p₀ z - deriv p₀ y * z
      have hq_hda : ∀ z ∈ Metric.closedBall y ‖w‖,
          HasDerivAt q_fn (deriv p₀ z - deriv p₀ y) z := by
        intro z hz
        have h1 := (hp0_holo.differentiableAt (isOpen_ball.mem_nhds (hKu_sub (hDy_sub hz)))).hasDerivAt
        have h2 : HasDerivAt (fun z : ℂ => deriv p₀ y * z) (deriv p₀ y) z := by
          have ht := (hasDerivAt_id z).const_mul (deriv p₀ y)
          rw [mul_one] at ht
          exact ht
        exact h1.sub h2
      have hmvt := Convex.norm_image_sub_le_of_norm_deriv_le
        (fun z hz => (hq_hda z hz).differentiableAt)
        (fun z hz => by
          rw [(hq_hda z hz).deriv]
          have hz_le : ‖z - y‖ ≤ ‖w‖ := by
            rw [← dist_eq_norm]
            exact Metric.mem_closedBall.mp hz
          calc ‖deriv p₀ z - deriv p₀ y‖
              ≤ L_p0' * ‖z - y‖ := hLip_p0' z (hDy_sub hz) y (hDy_sub hy_in_Dy)
            _ ≤ L_p0' * ‖w‖ := mul_le_mul_of_nonneg_left hz_le (by linarith))
        (convex_closedBall y ‖w‖) hy_in_Dy hyw_in_Dy
      have hq_diff : q_fn (y + w) - q_fn y = p₀ (y + w) - p₀ y + w * deriv M.σ y * p₀ y ^ 2 := by
        dsimp [q_fn]
        rw [hp0_deriv_eq y (hKu_sub (hDy_sub hy_in_Dy))]
        ring
      rw [hq_diff, add_sub_cancel_left] at hmvt
      calc ‖p₀ (y + w) - p₀ y + w * deriv M.σ y * p₀ y ^ 2‖
          ≤ (L_p0' * ‖w‖) * ‖w‖ := hmvt
        _ = L_p0' * ‖w‖ ^ 2 := by ring
    let r_e : ℝ := min (M.ρ_1 / 6) 1
    have hr_e_pos : 0 < r_e := lt_min (by linarith) zero_lt_one
    let P_max : ℝ := M_p0 + 1
    have hP_max_pos : 0 < P_max := by linarith
    let C_1 : ℝ := max (M_σ1 * P_max + M_σ) (L_σ1 * P_max ^ 2 + 2 * M_σ1 * P_max)
    let C_2 : ℝ := max (P_max ^ 2 * M_rem) (P_max ^ 3 * M_rem + L_p0')
    have hC1_pos : 0 < C_1 := by
      have : 0 < M_σ1 * P_max + M_σ := by positivity
      exact lt_of_lt_of_le this (le_max_left _ _)
    have hC2_pos : 0 < C_2 := by
      have : 0 < P_max ^ 2 * M_rem := by positivity
      exact lt_of_lt_of_le this (le_max_left _ _)
    have hOneStep : ∀ (pos : Bool) (b y : ℂ) (z : ℂ × ℂ),
        b ≠ 0 → ‖b‖ ≤ M.ρ_1 / 6 → ‖b‖ * P_max ≤ M.ρ_v1 / 2 →
        y ∈ Metric.closedBall y_edge (M.ρ_1 / 3) →
        max ‖z.1 - y‖ ‖z.2 / b - p₀ y‖ ≤ r_e →
        z ∈ B_0 ×ˢ Metric.ball (0 : ℂ) M.ρ_v ∧
        max ‖(stepMap pos z).1 - (y + if pos then b else -b)‖
            ‖(stepMap pos z).2 / b - p₀ (y + if pos then b else -b)‖ ≤
          (1 + C_1 * ‖b‖) * max ‖z.1 - y‖ ‖z.2 / b - p₀ y‖ + C_2 * ‖b‖ ^ 2 := by
      intro pos b y z hb_ne hb_le1 hb_le2 hy_cb he_le
      let u : ℂ := z.1
      let v : ℂ := z.2
      let p : ℂ := v / b
      let e : ℝ := max ‖u - y‖ ‖p - p₀ y‖
      let b_tilde : ℂ := if pos then b else -b
      have hb_tilde_norm : ‖b_tilde‖ = ‖b‖ := by cases pos <;> simp [b_tilde]
      have he_nonneg : 0 ≤ e := le_trans (norm_nonneg _) (le_max_left _ _)
      have he_le_ρ16 : e ≤ M.ρ_1 / 6 := le_trans he_le (min_le_left _ _)
      have he_le_1 : e ≤ 1 := le_trans he_le (min_le_right _ _)
      have hy_Ku : y ∈ K_u := by
        rw [Metric.mem_closedBall] at hy_cb ⊢; linarith
      have hu_Ku : u ∈ K_u := by
        have h1 : ‖u - y‖ ≤ e := le_max_left _ _
        have h2 : dist y y_edge ≤ M.ρ_1 / 3 := Metric.mem_closedBall.mp hy_cb
        rw [Metric.mem_closedBall]
        calc dist u y_edge ≤ dist u y + dist y y_edge := dist_triangle u y y_edge
          _ = ‖u - y‖ + dist y y_edge := by rw [dist_eq_norm]
          _ ≤ M.ρ_1 / 2 := by linarith
      have hy_B0 : y ∈ B_0 := hKu_sub hy_Ku
      have hu_B0 : u ∈ B_0 := hKu_sub hu_Ku
      have hp_le : ‖p‖ ≤ P_max := by
        have h1 : ‖p - p₀ y‖ ≤ e := le_max_right _ _
        have h2 : ‖p₀ y‖ ≤ M_p0 := hM_p0_bd y hy_Ku
        have h3 : p = (p - p₀ y) + p₀ y := by ring
        calc ‖p‖ = ‖(p - p₀ y) + p₀ y‖ := by rw [← h3]
          _ ≤ ‖p - p₀ y‖ + ‖p₀ y‖ := norm_add_le _ _
          _ ≤ P_max := by dsimp [P_max]; linarith
      have hp_sum_le : ‖p + p₀ y‖ ≤ 2 * P_max := by
        have h2 : ‖p₀ y‖ ≤ M_p0 := hM_p0_bd y hy_Ku
        calc ‖p + p₀ y‖ ≤ ‖p‖ + ‖p₀ y‖ := norm_add_le _ _
          _ ≤ 2 * P_max := by dsimp [P_max]; linarith
      have hv_eq : v = b * p := (mul_div_cancel₀ v hb_ne).symm
      have hv_cb : v ∈ Metric.closedBall (0 : ℂ) (M.ρ_v1 / 2) := by
        rw [Metric.mem_closedBall, dist_zero_right, hv_eq, norm_mul]
        exact le_trans (mul_le_mul_of_nonneg_left hp_le (norm_nonneg b)) hb_le2
      have huv_Kuv : (u, v) ∈ K_uv := ⟨hu_Ku, hv_cb⟩
      have huv_dom : (u, v) ∈ B_0 ×ˢ Metric.ball (0 : ℂ) M.ρ_v := hKuv_sub huv_Kuv
      refine ⟨huv_dom, ?_⟩
      let A_uv : ℂ := if pos then M.A_plus (u, v) else M.A_minus (u, v)
      let B_uv : ℂ := if pos then M.B_plus (u, v) else M.B_minus (u, v)
      have hA_le : ‖A_uv‖ ≤ M_rem := by
        cases pos
        · exact le_trans (hM_Am_r (u, v) huv_Kuv)
            (le_trans (le_max_left _ _) (le_trans (le_max_right _ _) (le_max_left _ _)))
        · exact le_trans (hM_Ap_r (u, v) huv_Kuv)
            (le_trans (le_max_left _ _) (le_trans (le_max_left _ _) (le_max_left _ _)))
      have hB_le : ‖B_uv‖ ≤ M_rem := by
        cases pos
        · exact le_trans (hM_Bm_r (u, v) huv_Kuv)
            (le_trans (le_max_right _ _) (le_trans (le_max_right _ _) (le_max_left _ _)))
        · exact le_trans (hM_Bp_r (u, v) huv_Kuv)
            (le_trans (le_max_right _ _) (le_trans (le_max_left _ _) (le_max_left _ _)))
      have hu'_eq : (stepMap pos z).1 = u + b_tilde * M.σ u * p + b ^ 2 * p ^ 2 * A_uv := by
        change (stepMap pos (u, v)).1 = u + b_tilde * M.σ u * p + b ^ 2 * p ^ 2 * A_uv
        cases pos
        · have hF := congrArg Prod.fst (M.F_minus_eq u huv_dom.1 v huv_dom.2)
          dsimp [stepMap, b_tilde, A_uv] at hF ⊢
          rw [hF]
          generalize M.A_minus (u, v) = am
          rw [hv_eq]
          ring
        · have hF := congrArg Prod.fst (M.F_plus_eq u huv_dom.1 v huv_dom.2)
          dsimp [stepMap, b_tilde, A_uv] at hF ⊢
          rw [hF]
          generalize M.A_plus (u, v) = ap
          rw [hv_eq]
          ring
      have hp'_eq :
          (stepMap pos z).2 / b =
            p - b_tilde * deriv M.σ u * p ^ 2 + b ^ 2 * p ^ 3 * B_uv := by
        change (stepMap pos (u, v)).2 / b =
          p - b_tilde * deriv M.σ u * p ^ 2 + b ^ 2 * p ^ 3 * B_uv
        cases pos
        · have hF := congrArg Prod.snd (M.F_minus_eq u huv_dom.1 v huv_dom.2)
          dsimp [stepMap, b_tilde, B_uv] at hF ⊢
          rw [hF]
          generalize M.B_minus (u, v) = bm
          rw [hv_eq]
          field_simp
          ring
        · have hF := congrArg Prod.snd (M.F_plus_eq u huv_dom.1 v huv_dom.2)
          dsimp [stepMap, b_tilde, B_uv] at hF ⊢
          rw [hF]
          generalize M.B_plus (u, v) = bp
          rw [hv_eq]
          field_simp
      
      have hu'_bd : ‖(stepMap pos z).1 - (y + b_tilde)‖ ≤ (1 + C_1 * ‖b‖) * e + C_2 * ‖b‖ ^ 2 := by
        have hσp0 : M.σ y * p₀ y = 1 := mul_inv_cancel₀ (M.σ_ne_zero y hy_B0)
        have h_alg : (stepMap pos z).1 - (y + b_tilde) =
            (u - y) + b_tilde * ((M.σ u - M.σ y) * p + M.σ y * (p - p₀ y)) +
              b ^ 2 * p ^ 2 * A_uv := by
          rw [hu'_eq]
          calc u + b_tilde * M.σ u * p + b ^ 2 * p ^ 2 * A_uv - (y + b_tilde)
              = u + b_tilde * M.σ u * p + b ^ 2 * p ^ 2 * A_uv -
                  (y + b_tilde * (M.σ y * p₀ y)) := by rw [hσp0, mul_one]
            _ = (u - y) + b_tilde * ((M.σ u - M.σ y) * p + M.σ y * (p - p₀ y)) +
                  b ^ 2 * p ^ 2 * A_uv := by ring
        rw [h_alg]
        have ht1 : ‖M.σ u - M.σ y‖ * ‖p‖ ≤ M_σ1 * P_max * e := by
          have hlip : ‖M.σ u - M.σ y‖ ≤ M_σ1 * e :=
            le_trans (hLip_σ u hu_Ku y hy_Ku)
              (mul_le_mul_of_nonneg_left (le_max_left _ _) (by linarith))
          calc ‖M.σ u - M.σ y‖ * ‖p‖
              ≤ (M_σ1 * e) * P_max :=
                mul_le_mul hlip hp_le (norm_nonneg _) (by positivity)
            _ = M_σ1 * P_max * e := by ring
        have ht2 : ‖M.σ y‖ * ‖p - p₀ y‖ ≤ M_σ * e :=
          mul_le_mul (hM_σ_bd y hy_Ku) (le_max_right _ _) (norm_nonneg _) (by linarith)
        have ht3 : ‖b ^ 2 * p ^ 2 * A_uv‖ ≤ P_max ^ 2 * M_rem * ‖b‖ ^ 2 := by
          rw [norm_mul, norm_mul, norm_pow, norm_pow]
          have hp2 : ‖p‖ ^ 2 ≤ P_max ^ 2 := pow_le_pow_left₀ (norm_nonneg p) hp_le 2
          have hpA : ‖p‖ ^ 2 * ‖A_uv‖ ≤ P_max ^ 2 * M_rem :=
            mul_le_mul hp2 hA_le (norm_nonneg _) (by positivity)
          calc ‖b‖ ^ 2 * ‖p‖ ^ 2 * ‖A_uv‖
              = ‖b‖ ^ 2 * (‖p‖ ^ 2 * ‖A_uv‖) := by ring
            _ ≤ ‖b‖ ^ 2 * (P_max ^ 2 * M_rem) :=
              mul_le_mul_of_nonneg_left hpA (sq_nonneg _)
            _ = P_max ^ 2 * M_rem * ‖b‖ ^ 2 := by ring
        have hmid : ‖b_tilde * ((M.σ u - M.σ y) * p + M.σ y * (p - p₀ y))‖ ≤
            C_1 * ‖b‖ * e := by
          rw [norm_mul, hb_tilde_norm]
          have hsum : ‖(M.σ u - M.σ y) * p + M.σ y * (p - p₀ y)‖ ≤
              (M_σ1 * P_max + M_σ) * e := by
            calc ‖(M.σ u - M.σ y) * p + M.σ y * (p - p₀ y)‖
                ≤ ‖(M.σ u - M.σ y) * p‖ + ‖M.σ y * (p - p₀ y)‖ := norm_add_le _ _
              _ = ‖M.σ u - M.σ y‖ * ‖p‖ + ‖M.σ y‖ * ‖p - p₀ y‖ := by rw [norm_mul, norm_mul]
              _ ≤ (M_σ1 * P_max + M_σ) * e := by linarith
          have hc1 : (M_σ1 * P_max + M_σ) * e ≤ C_1 * e :=
            mul_le_mul_of_nonneg_right (le_max_left _ _) he_nonneg
          calc ‖b‖ * ‖(M.σ u - M.σ y) * p + M.σ y * (p - p₀ y)‖
              ≤ ‖b‖ * (C_1 * e) :=
                mul_le_mul_of_nonneg_left (le_trans hsum hc1) (norm_nonneg b)
            _ = C_1 * ‖b‖ * e := by ring
        have hc2 : P_max ^ 2 * M_rem * ‖b‖ ^ 2 ≤ C_2 * ‖b‖ ^ 2 :=
          mul_le_mul_of_nonneg_right (le_max_left _ _) (sq_nonneg _)
        have hu_e : ‖u - y‖ ≤ e := le_max_left _ _
        let u_mid := b_tilde * ((M.σ u - M.σ y) * p + M.σ y * (p - p₀ y))
        have hna_u := norm_add_le (u - y) u_mid
        calc ‖(u - y) + u_mid + b ^ 2 * p ^ 2 * A_uv‖
            ≤ ‖(u - y) + u_mid‖ + ‖b ^ 2 * p ^ 2 * A_uv‖ := norm_add_le _ _
          _ ≤ ‖u - y‖ + ‖u_mid‖ + ‖b ^ 2 * p ^ 2 * A_uv‖ := by linarith
          _ ≤ (1 + C_1 * ‖b‖) * e + C_2 * ‖b‖ ^ 2 := by linarith
      
      have hp'_bd :
          ‖(stepMap pos z).2 / b - p₀ (y + b_tilde)‖ ≤ (1 + C_1 * ‖b‖) * e + C_2 * ‖b‖ ^ 2 := by
        have h_alg : (stepMap pos z).2 / b - p₀ (y + b_tilde) =
            (p - p₀ y) -
              b_tilde * ((deriv M.σ u - deriv M.σ y) * p ^ 2 +
                deriv M.σ y * (p + p₀ y) * (p - p₀ y)) +
              b ^ 2 * p ^ 3 * B_uv -
              (p₀ (y + b_tilde) - p₀ y + b_tilde * deriv M.σ y * p₀ y ^ 2) := by
          rw [hp'_eq]
          ring
        rw [h_alg]
        have hp2 : ‖p‖ ^ 2 ≤ P_max ^ 2 := pow_le_pow_left₀ (norm_nonneg p) hp_le 2
        have hp3 : ‖p‖ ^ 3 ≤ P_max ^ 3 := pow_le_pow_left₀ (norm_nonneg p) hp_le 3
        have ht1 : ‖deriv M.σ u - deriv M.σ y‖ * ‖p‖ ^ 2 ≤ L_σ1 * P_max ^ 2 * e := by
          have hlip : ‖deriv M.σ u - deriv M.σ y‖ ≤ L_σ1 * e :=
            le_trans (hLip_σ1 u hu_Ku y hy_Ku)
              (mul_le_mul_of_nonneg_left (le_max_left _ _) (by linarith))
          calc ‖deriv M.σ u - deriv M.σ y‖ * ‖p‖ ^ 2
              ≤ (L_σ1 * e) * P_max ^ 2 :=
                mul_le_mul hlip hp2 (sq_nonneg _) (by positivity)
            _ = L_σ1 * P_max ^ 2 * e := by ring
        have ht2 : ‖deriv M.σ y‖ * ‖p + p₀ y‖ * ‖p - p₀ y‖ ≤ 2 * M_σ1 * P_max * e := by
          have h12 : ‖deriv M.σ y‖ * ‖p + p₀ y‖ ≤ M_σ1 * (2 * P_max) :=
            mul_le_mul (hM_σ1_bd y hy_Ku) hp_sum_le (norm_nonneg _) (by linarith)
          calc ‖deriv M.σ y‖ * ‖p + p₀ y‖ * ‖p - p₀ y‖
              ≤ (M_σ1 * (2 * P_max)) * e :=
                mul_le_mul h12 (le_max_right _ _) (norm_nonneg _) (by positivity)
            _ = 2 * M_σ1 * P_max * e := by ring
        have hmid :
            ‖b_tilde * ((deriv M.σ u - deriv M.σ y) * p ^ 2 +
                deriv M.σ y * (p + p₀ y) * (p - p₀ y))‖ ≤ C_1 * ‖b‖ * e := by
          rw [norm_mul, hb_tilde_norm]
          have hsum :
              ‖(deriv M.σ u - deriv M.σ y) * p ^ 2 +
                  deriv M.σ y * (p + p₀ y) * (p - p₀ y)‖ ≤
                (L_σ1 * P_max ^ 2 + 2 * M_σ1 * P_max) * e := by
            calc ‖(deriv M.σ u - deriv M.σ y) * p ^ 2 +
                    deriv M.σ y * (p + p₀ y) * (p - p₀ y)‖
                ≤ ‖(deriv M.σ u - deriv M.σ y) * p ^ 2‖ +
                    ‖deriv M.σ y * (p + p₀ y) * (p - p₀ y)‖ := norm_add_le _ _
              _ = ‖deriv M.σ u - deriv M.σ y‖ * ‖p‖ ^ 2 +
                    ‖deriv M.σ y‖ * ‖p + p₀ y‖ * ‖p - p₀ y‖ := by
                  rw [norm_mul, norm_pow, norm_mul, norm_mul]
              _ ≤ (L_σ1 * P_max ^ 2 + 2 * M_σ1 * P_max) * e := by linarith
          have hc1 : (L_σ1 * P_max ^ 2 + 2 * M_σ1 * P_max) * e ≤ C_1 * e :=
            mul_le_mul_of_nonneg_right (le_max_right _ _) he_nonneg
          calc ‖b‖ * ‖(deriv M.σ u - deriv M.σ y) * p ^ 2 +
                  deriv M.σ y * (p + p₀ y) * (p - p₀ y)‖
              ≤ ‖b‖ * (C_1 * e) :=
                mul_le_mul_of_nonneg_left (le_trans hsum hc1) (norm_nonneg b)
            _ = C_1 * ‖b‖ * e := by ring
        have ht3 : ‖b ^ 2 * p ^ 3 * B_uv‖ ≤ P_max ^ 3 * M_rem * ‖b‖ ^ 2 := by
          rw [norm_mul, norm_mul, norm_pow, norm_pow]
          have hpB : ‖p‖ ^ 3 * ‖B_uv‖ ≤ P_max ^ 3 * M_rem :=
            mul_le_mul hp3 hB_le (norm_nonneg _) (by positivity)
          calc ‖b‖ ^ 2 * ‖p‖ ^ 3 * ‖B_uv‖
              = ‖b‖ ^ 2 * (‖p‖ ^ 3 * ‖B_uv‖) := by ring
            _ ≤ ‖b‖ ^ 2 * (P_max ^ 3 * M_rem) :=
              mul_le_mul_of_nonneg_left hpB (sq_nonneg _)
            _ = P_max ^ 3 * M_rem * ‖b‖ ^ 2 := by ring
        have ht4 : ‖p₀ (y + b_tilde) - p₀ y + b_tilde * deriv M.σ y * p₀ y ^ 2‖ ≤
            L_p0' * ‖b‖ ^ 2 := by
          have h := hTaylor_p0 y hy_cb b_tilde (by rw [hb_tilde_norm]; exact hb_le1)
          simpa only [hb_tilde_norm] using h
        have hc2 : (P_max ^ 3 * M_rem + L_p0') * ‖b‖ ^ 2 ≤ C_2 * ‖b‖ ^ 2 :=
          mul_le_mul_of_nonneg_right (le_max_right _ _) (sq_nonneg _)
        have hp_e : ‖p - p₀ y‖ ≤ e := le_max_right _ _
        let t_lin := b_tilde * ((deriv M.σ u - deriv M.σ y) * p ^ 2 +
          deriv M.σ y * (p + p₀ y) * (p - p₀ y))
        let t_cub := b ^ 2 * p ^ 3 * B_uv
        let t_tay := p₀ (y + b_tilde) - p₀ y + b_tilde * deriv M.σ y * p₀ y ^ 2
        calc ‖(p - p₀ y) - t_lin + t_cub - t_tay‖
            ≤ ‖(p - p₀ y) - t_lin + t_cub‖ + ‖t_tay‖ := norm_sub_le _ _
          _ ≤ ‖(p - p₀ y) - t_lin‖ + ‖t_cub‖ + ‖t_tay‖ := by
              linarith [norm_add_le ((p - p₀ y) - t_lin) t_cub]
          _ ≤ ‖p - p₀ y‖ + ‖t_lin‖ + ‖t_cub‖ + ‖t_tay‖ := by
              linarith [norm_sub_le (p - p₀ y) t_lin]
          _ ≤ (1 + C_1 * ‖b‖) * e + C_2 * ‖b‖ ^ 2 := by linarith
      exact max_le hu'_bd hp'_bd
    
