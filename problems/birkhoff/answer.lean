          have hs1 : (∑ s : Fin (k - 1), if s = r then diag_c * β_top i_L.succ else 0) =
              diag_c * β_top i_L.succ := by simp
          have hs2 : (∑ s : Fin (k - 1), if s.1 = r.1 + 1 then sup_c * β_top i_R.succ else 0) =
              sup_c * β_top i_R.succ := by
            by_cases hr_hi : r.1 + 1 < k - 1
            · rw [Finset.sum_eq_single ⟨r.1 + 1, hr_hi⟩]
              · simp
              · intro s _ hs; rw [if_neg (fun heq => hs (Fin.ext heq))]
              · intro hm; exact False.elim (hm (Finset.mem_univ _))
            · have hlast_eq : i_R.succ = Fin.last k := by
                ext; dsimp only [i_R, Fin.val_succ, Fin.val_last]; have := r.2; omega
              rw [hlast_eq, hβ_top_end.2, mul_zero]
              exact Finset.sum_eq_zero fun s _ => if_neg (by have := s.2; omega)
          have hs3 : (∑ s : Fin (k - 1), if r.1 = s.1 + 1 then sub_c * β_top i_L.castSucc else 0) =
