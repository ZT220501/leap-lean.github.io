    have h_num_den_holo : ∀ p ∈ Ω_dom, ∀ ci : Fin 2 × Fin 2,
        DifferentiableOn ℂ (fun q => ssbpcPairNum E₀ E₁ p q ci)
          (Metric.ball p (ssbpcPairChartRad E₀ E₁ p)) ∧
        DifferentiableOn ℂ (fun q => ssbpcPairDen E₀ E₁ p q ci)
          (Metric.ball p (ssbpcPairChartRad E₀ E₁ p)) := by
      intro p hp ⟨c, i⟩
      have h_le := h_ci_rad_le p (c, i)
      fin_cases c
      · dsimp [ssbpcPairNum, ssbpcPairDen] at h_le ⊢
        exact ⟨((E₀ i).num_holo p hp).mono (Metric.ball_subset_ball h_le),
