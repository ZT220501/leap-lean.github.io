      intro g z
      by_cases hz : z = 0
      · subst hz
        simp only [neg_zero, dslope_same]
        simpa using deriv_comp_neg g 0
      · have hnz : -z ≠ 0 := neg_ne_zero.mpr hz
        rw [dslope_of_ne _ hnz, dslope_of_ne _ hz, slope_def_field, slope_def_field]
        simp only [neg_neg, neg_zero, sub_zero, div_neg]
    have hd_neg_val : ∀ (g : ℂ → ℂ) (z : ℂ),
        dslope (fun w => -g w) 0 z = -dslope g 0 z := by
      intro g z
      by_cases hz : z = 0
      · subst hz
        simp only [dslope_same]
        exact deriv.neg
      · rw [dslope_of_ne _ hz, dslope_of_ne _ hz, slope_def_field, slope_def_field]
        ring
    have hd2_even : ∀ (N : ℂ → ℂ → ℂ), (∀ w₀ w₁ : ℂ, N (-w₀) (-w₁) = N w₀ w₁) →
        ∀ b₀ b₁ : ℂ,
          dslope (fun w₀ => dslope (fun w₁ => N w₀ w₁) 0 (-b₁)) 0 (-b₀) =
            dslope (fun w₀ => dslope (fun w₁ => N w₀ w₁) 0 b₁) 0 b₀ := by
      intro N hN b₀ b₁
      have h_inner : (fun w₀ => dslope (fun w₁ => N w₀ w₁) 0 (-b₁)) =
          (fun w₀ => -dslope (fun w₁ => N (-w₀) w₁) 0 b₁) := by
        funext w₀
        have h_eq : (fun w₁ => N w₀ w₁) = (fun w₁ => N (-w₀) (-w₁)) := by
          funext w₁; exact (hN w₀ w₁).symm
        rw [h_eq, hd_neg_arg (fun w₁ => N (-w₀) w₁) b₁]
      rw [h_inner,
        hd_neg_arg (fun w₀ => -dslope (fun w₁ => N w₀ w₁) 0 b₁) b₀,
        hd_neg_val (fun w₀ => dslope (fun w₁ => N w₀ w₁) 0 b₁) b₀,
        neg_neg]
    have hSym := hVolt.2.2.1.1 Q a₀ a₁ hQ
    set b₀ : ℂ := a₀
    set b₁ : ℂ := a₀ * c0Kernel Q 1 + a₁ * k0Kernel Q 1
    have hb₁_neg : (-a₀) * c0Kernel Q 1 + (-a₁) * k0Kernel Q 1 = -b₁ := by
      dsimp [b₁]; ring
    unfold slDivided
    dsimp only
    rw [hb₁_neg]
    by_cases hne : b₀ ≠ 0 ∧ b₁ ≠ 0
    · have hne' : -b₀ ≠ 0 ∧ -b₁ ≠ 0 := ⟨neg_ne_zero.mpr hne.1, neg_ne_zero.mpr hne.2⟩
      rw [if_pos hne', if_pos hne, hSym.2.2.2.1]
      ring
    · have hne' : ¬ (-b₀ ≠ 0 ∧ -b₁ ≠ 0) := by
        rintro ⟨h1, h2⟩
        exact hne ⟨neg_ne_zero.mp h1, neg_ne_zero.mp h2⟩
      rw [if_neg hne', if_neg hne]
      have h1 := hd2_even (slNumerator Q) hSym.2.2.2.2 b₀ b₁
      have h2 := hd2_even (fun w₁ w₀ => slNumerator Q w₀ w₁)
        (fun w₁ w₀ => hSym.2.2.2.2 w₀ w₁) b₁ b₀
      rw [h1, h2]
  have part1_small_field : ∀ (hVolt : VolterraDivisionProp) (X : ExpStripData),
      IsExpObstructionStrip X →
      ∃ η_sf C_sf : ℝ, 0 < η_sf ∧ 0 < C_sf ∧
        ∀ (s₀ : ℂ) (r_s r_t M₀ : ℝ),
          0 < r_s → 0 < r_t → 4 * r_t ≤ r_s → 0 ≤ M₀ → r_t * M₀ ≤ η_sf →
          Metric.ball s₀ r_s ⊆ X.D_strip →
          (∀ w ∈ Metric.ball s₀ r_s, ‖X.f w‖ ≤ M₀ ∧ Real.sqrt ‖X.q w‖ ≤ M₀) →
          DifferentiableOn ℂ (fun q : ℂ × ℂ × ℂ => chordActionP X q.1 q.2.1 q.2.2)
            { q : ℂ × ℂ × ℂ | ‖q.1 - s₀‖ < r_s / 4 ∧ ‖q.2.1 - 1‖ < 1 / 4 ∧ ‖q.2.2‖ < r_t } ∧
          (∀ s J t : ℂ, ‖s - s₀‖ < r_s / 8 → ‖J - 1‖ < 1 / 8 → ‖t‖ < r_t / 2 →
            chordActionP X (s + t * J) J (-t) = chordActionP X s J t) ∧
