        have hev0 : (fun z' => iterDerivY α Δ (z', 0)) =ᶠ[nhds z] (fun _ => (0 : ℂ)) := by
          filter_upwards [Metric.isOpen_ball.mem_nhds hz] with z' hz'
          exact ih z' hz'
        rw [hev0.deriv_eq, deriv_const]
    let e₀ : Fin 2 →₀ ℕ := Finsupp.single 0 1
    let e₁ : Fin 2 →₀ ℕ := Finsupp.single 1 1
    have hmvA_coeff : ∀ (Ψ : MvPowerSeries (Fin 2) ℂ) (d : Fin 2 →₀ ℕ),
        MvPowerSeries.coeff d (mvDerivA Ψ) =
          ((d 0 + 1 : ℕ) : ℂ) * MvPowerSeries.coeff (d + e₀) Ψ := fun _ _ => rfl
    have hmvD_coeff : ∀ (Ψ : MvPowerSeries (Fin 2) ℂ) (d : Fin 2 →₀ ℕ),
        MvPowerSeries.coeff d (mvDerivD Ψ) =
          ((d 1 + 1 : ℕ) : ℂ) * MvPowerSeries.coeff (d + e₁) Ψ := fun _ _ => rfl
    have hΦ_Δ_vanish : ∀ (β : ℕ) (d : Fin 2 →₀ ℕ), d 1 ≤ β → MvPowerSeries.coeff d Φ_Δ = 0 := by
