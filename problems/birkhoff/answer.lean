        dsimp [δ]; positivity
      have h4δ_le : 4 * δ ≤ min (min ρ_star (R - ρ_star)) (min r_g (2 * (ρ_star - x_lo))) := by
        dsimp [δ]; linarith
      have h2δ_lt_ρ : 2 * δ < ρ_star := by
        have : 4 * δ ≤ ρ_star := le_trans h4δ_le (le_trans (min_le_left _ _) (min_le_left _ _))
        linarith
      have h2δ_lt_diffR : 2 * δ < R - ρ_star := by
        have : 4 * δ ≤ R - ρ_star := le_trans h4δ_le (le_trans (min_le_left _ _) (min_le_right _ _))
        linarith
      have h2δ_lt_rg : 2 * δ < r_g := by
        have : 4 * δ ≤ r_g := le_trans h4δ_le (le_trans (min_le_right _ _) (min_le_left _ _))
        linarith
      have hδ_lt_xlo : δ < ρ_star - x_lo := by
        have : 4 * δ ≤ 2 * (ρ_star - x_lo) :=
