        intro q
        change (MvPolynomial.eval₂Hom K₀.subtype
          (Sum.elim (fun v => jetFn v (Ψ q)) (fun _ => zFn (Ψ q)))) R_poly = _
        simp only [R_poly, map_sum, map_mul, map_pow, MvPolynomial.eval₂Hom_X',
          MvPolynomial.coe_eval₂Hom, MvPolynomial.eval₂_rename]
        rfl
      have hR_zero_on_U : ∀ q ∈ U_a ×ˢ U_d, evalFn R_poly q = 0 :=
        h_gen R_poly (by rw [hR_eval q₁]; exact hQ_tilde_ann_q₁)
      let S_vars : Finset ι_all := Finset.univ.biUnion (fun d : Fin (D₀ + 1) => (Q_tilde d).vars)
      rcases hemb S_vars with ⟨M, hM_sub⟩
      let liftVar : ι_all → MvPolynomial (σ M) ℂ := fun v =>
        if hv : v ∈ Set.range (emb M) then MvPolynomial.X (Classical.choose hv) else 0
      let Q₀ : Fin (D₀ + 1) → MvPolynomial (σ M) ℂ := fun d =>
        MvPolynomial.eval₂Hom (MvPolynomial.C.comp K₀.subtype) liftVar (Q_tilde d)
      have hQ₀_eval_eq : ∀ (d : Fin (D₀ + 1)) (p : ℂ × ℂ),
          MvPolynomial.eval (fun w => jetFn (emb M w) p) (Q₀ d) =
            MvPolynomial.eval₂ K₀.subtype (fun v => jetFn v p) (Q_tilde d) := by
        intro d p
        have hcomp : ((MvPolynomial.eval (fun w => jetFn (emb M w) p)).comp
            (MvPolynomial.eval₂Hom (MvPolynomial.C.comp K₀.subtype) liftVar)) (Q_tilde d) =
            MvPolynomial.eval₂ K₀.subtype
              (fun v => MvPolynomial.eval (fun w => jetFn (emb M w) p) (liftVar v)) (Q_tilde d) := by
          have hext : (MvPolynomial.eval (fun w => jetFn (emb M w) p)).comp
              (MvPolynomial.eval₂Hom (MvPolynomial.C.comp K₀.subtype) liftVar) =
              MvPolynomial.eval₂Hom K₀.subtype
                (fun v => MvPolynomial.eval (fun w => jetFn (emb M w) p) (liftVar v)) := by
            apply MvPolynomial.ringHom_ext'
            · ext c; simp
            · intro v; simp
          exact RingHom.congr_fun hext (Q_tilde d)
        change ((MvPolynomial.eval (fun w => jetFn (emb M w) p)).comp
          (MvPolynomial.eval₂Hom (MvPolynomial.C.comp K₀.subtype) liftVar)) (Q_tilde d) = _
        rw [hcomp, MvPolynomial.eval₂_eq, MvPolynomial.eval₂_eq]
        refine Finset.sum_congr rfl fun m hm_sup => ?_
        congr 1
        refine Finset.prod_congr rfl fun v hv_m => ?_
        have hv_vars : v ∈ (Q_tilde d).vars :=
          (MvPolynomial.mem_vars v).mpr ⟨m, hm_sup, hv_m⟩
        have hv_S : v ∈ S_vars := Finset.mem_biUnion.mpr ⟨d, Finset.mem_univ d, hv_vars⟩
        have hv_rng : v ∈ Set.range (emb M) := hM_sub hv_S
        simp only [liftVar, hv_rng, ↓reduceDIte, MvPolynomial.eval_X]
        rw [Classical.choose_spec hv_rng]
      let F_rel : ℂ × ℂ → ℂ := fun p =>
        ∑ d : Fin (D₀ + 1),
          MvPolynomial.eval (fun w => jetFn (emb M w) p) (Q₀ d) * (zFn p) ^ (d : ℕ)
      have hMvHolo : ∀ P_mv : MvPolynomial (σ M) ℂ,
