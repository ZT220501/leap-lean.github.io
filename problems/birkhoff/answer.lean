  have h_log_one_add : ∀ u : ℂ, ‖u‖ ≤ 1 / 3 → ‖Complex.log (1 + u)‖ ≤ 2 * ‖u‖ := by
    intro u hu
    have h_hd : ∀ w ∈ Metric.closedBall (0 : ℂ) (1 / 3),
        HasDerivAt (fun ζ : ℂ => Complex.log (1 + ζ)) ((1 + w)⁻¹) w := by
      intro w hw
      rw [Metric.mem_closedBall, dist_zero_right] at hw
      have hw_re : -1 / 3 ≤ w.re := by
        have := Complex.abs_re_le_norm w; rw [abs_le] at this; linarith
      have h_slit : 1 + w ∈ Complex.slitPlane := by
        refine Complex.mem_slitPlane_iff.mpr (Or.inl ?_)
        simp only [Complex.add_re, Complex.one_re]; linarith
      have h1 : HasDerivAt (fun ζ : ℂ => 1 + ζ) 1 w := (hasDerivAt_id w).const_add 1
      have h2 := h1.clog h_slit
      simpa [one_div] using h2
    have h_diff : ∀ w ∈ Metric.closedBall (0 : ℂ) (1 / 3),
        DifferentiableAt ℂ (fun ζ : ℂ => Complex.log (1 + ζ)) w :=
      fun w hw => (h_hd w hw).differentiableAt
    have h_dbound : ∀ w ∈ Metric.closedBall (0 : ℂ) (1 / 3),
        ‖deriv (fun ζ : ℂ => Complex.log (1 + ζ)) w‖ ≤ 2 := by
      intro w hw
      rw [(h_hd w hw).deriv, norm_inv]
      rw [Metric.mem_closedBall, dist_zero_right] at hw
      have h_lo : (2 / 3 : ℝ) ≤ ‖1 + w‖ := by
        have htri := norm_sub_norm_le (1 : ℂ) (-w)
        simp only [sub_neg_eq_add, norm_one, norm_neg] at htri
        linarith
      have h_pos : (0 : ℝ) < ‖1 + w‖ := by linarith
      rw [inv_le_iff_one_le_mul₀ h_pos]
      linarith
    have h_mvt := Convex.norm_image_sub_le_of_norm_deriv_le h_diff h_dbound
      (convex_closedBall (0 : ℂ) (1 / 3))
      (Metric.mem_closedBall_self (by norm_num))
      (by rwa [Metric.mem_closedBall, dist_zero_right])
    simpa using h_mvt

  
  have h_exp_sub_one : ∀ w : ℂ, ‖w‖ ≤ 1 / 2 → ‖Complex.exp w - 1‖ ≤ 2 * ‖w‖ := by
    intro w hw
    have h_diff : ∀ ζ ∈ Metric.closedBall (0 : ℂ) (1 / 2),
