      have hIntP := hPairInt hσ' hBsl_nn hLsl_nn hΔ_nn hContEta hEtaPair
      have hc_norm : ‖(c : ℂ)‖ ≤ 1 := by simpa [Complex.norm_real, Real.norm_eq_abs] using hc_abs
      have hSlP := hPairConstMul (C := 1) rfl zero_le_one hBsl_nn hLsl_nn hΔ_nn hc_norm hIntP
      rw [one_mul, one_mul] at hSlP
      refine ⟨hSlP, fun z hz => ⟨?_, ?_⟩⟩
      · dsimp [skrSlopeW]
        rw [norm_mul, Complex.norm_real, Real.norm_eq_abs]
        have hint : ‖∫ η in (0 : ℝ)..1, deriv W₁ (z + ((η * c : ℝ) : ℂ) * H₁ z)‖ ≤ M :=
          hNormInt01 (fun η hη => by
            have hmem := hCalc.mem_horizStrip_of_tau_seg σ τ (η * c) z (H₁ z) hτ
