  let W₂ : Set (ℂ × ℂ) := Metric.ball w₂ δ₂ ×ˢ Metric.ball (0 : ℂ) R
  let U_col2 : Set (ℂ × ℂ) := Metric.ball w₂ δ₂ ×ˢ A_col
