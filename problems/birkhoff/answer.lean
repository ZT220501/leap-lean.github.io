          τ ∈ Set.Icc (0 : ℝ) 1 → |κ| ≤ 2 → c ∈ Set.Icc (-τ) (1 - τ) →
          IsBoundedStripExt (m + 15) σ M w₁ W₁ →
          IsBoundedStripExt (m + 15) σ M w₂ W₂ →
          IsSkrStripBnd m σ' 1 H₁ → IsSkrStripBnd m σ' 1 H₂ →
