    have hDeltaPhi : ∀ (γ_fn : ℝ → ℝ),
        ContinuousOn γ_fn (Set.Icc (0 : ℝ) 1) →
        (∀ α ∈ Set.Icc (0 : ℝ) 1, γ_fn α ∈ Set.Icc (0 : ℝ) 1) →
        ParamBndAt B_D
          (fun α ζ =>
            deltaPhi_ℂ W (ζ - (τ_fn α : ℂ) * H_fam α ζ)
              (ζ + ((γ_fn α - τ_fn α : ℝ) : ℂ) * H_fam α ζ)) := by
      intro γ_fn hγ_cont hγ_mem
      have hγH := hParamMul
        (hParamAlphaScalar 1 (fun α => (γ_fn α : ℂ)) zero_le_one
          (Complex.continuous_ofReal.comp_continuousOn hγ_cont)
          (fun α hα => by
            rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hγ_mem α hα).1]
            exact (hγ_mem α hα).2))
        hH_param
      have hIntTheta : ParamBndAt B_pExp1
          (fun α ζ => ∫ θ in (0 : ℝ)..1,
            Complex.exp (W (ζ + ((θ * γ_fn α - τ_fn α : ℝ) : ℂ) * H_fam α ζ))) := by
        refine hParamInt hBpExp1_nn
          (fun θ hθ => (hShiftedExp (fun α => θ * γ_fn α - τ_fn α)
            ((continuousOn_const.mul hγ_cont).sub hτ_cont)
            (fun α hα => ⟨by nlinarith [hθ.1, (hγ_mem α hα).1],
              by nlinarith [hθ.1, hθ.2, (hγ_mem α hα).1, (hγ_mem α hα).2]⟩)).1)
          (fun α hα z hz => ?_)
        refine Complex.continuous_exp.comp_continuousOn (hW.1.continuousOn.comp ?_ ?_)
        · exact continuousOn_const.add
            ((Complex.continuous_ofReal.comp
              ((continuous_id.mul continuous_const).sub continuous_const)).continuousOn.mul
              continuousOn_const)
        · intro θ hθ
          exact hCalc.mem_horizStrip_of_tau_seg σ (τ_fn α) (θ * γ_fn α - τ_fn α) z (H_fam α z)
            (hFam α hα).1
            ⟨by nlinarith [hθ.1, (hγ_mem α hα).1],
              by nlinarith [hθ.1, hθ.2, (hγ_mem α hα).1, (hγ_mem α hα).2]⟩
            ((hFam α hα).2.2.1 z hz).1 ((hFam α hα).2.2.1 z hz).2
      refine hParamCongr (fun α _ ζ _ => ?_) (hParamMul hγH hIntTheta)
      dsimp [deltaPhi_ℂ]
      have hdiff : (ζ + ((γ_fn α - τ_fn α : ℝ) : ℂ) * H_fam α ζ) -
          (ζ - (τ_fn α : ℂ) * H_fam α ζ) = (γ_fn α : ℂ) * H_fam α ζ := by
        push_cast; ring
      have hIntEq :
          (fun θ : ℝ => Complex.exp (W (ζ - (τ_fn α : ℂ) * H_fam α ζ +
              (θ : ℂ) * ((γ_fn α : ℂ) * H_fam α ζ)))) =
          (fun θ : ℝ => Complex.exp (W (ζ + ((θ * γ_fn α - τ_fn α : ℝ) : ℂ) * H_fam α ζ))) := by
        ext θ; congr 2; push_cast; ring
      rw [hdiff, hIntEq]

    
    let R_D : ℝ := B_D + 1
    have hRD_pos : 0 < R_D := by linarith
    have hCosBallD := hCalc.cos_ball_bnd R_D hRD_pos
    have hSinBallD := hCalc.sin_ball_bnd R_D hRD_pos
    have hD_tau := hDeltaPhi τ_fn hτ_cont (fun α hα => (hFam α hα).1)
    have hCosD_tau := hParamComp Metric.isOpen_ball (Real.exp_nonneg _) hD_tau.1 hCosBallD.1
      (fun j _ w hw => hCosBallD.2 j w hw)
      (fun α hα => ⟨(hD_tau.2.1 α hα).1,
        fun z hz => Metric.mem_ball.mpr
          (by rw [dist_zero_right]; linarith [hBndPt (hD_tau.2.1 α hα) z hz]),
        fun j _ hjm z hz => (hD_tau.2.1 α hα).2 j hjm z hz⟩)
      hD_tau.2.2
    have hExpZero := hShiftedExp (fun _ => 0) continuousOn_const
      (fun α hα => ⟨by linarith [(hFam α hα).1.1], by linarith [(hFam α hα).1.2]⟩)
    have hOneSubCos := hParamSub
      (hParamAlphaScalar 1 (fun _ => 1) zero_le_one continuousOn_const (fun _ _ => by simp))
      hCosD_tau
    have hTwoOneSubCos := hParamMul
      (hParamAlphaScalar ‖(2 : ℂ)‖ (fun _ => 2) (norm_nonneg _) continuousOn_const
        (fun _ _ => le_rfl))
      hOneSubCos
    have hTerm1 : ParamBndAt _
        (fun α ζ =>
          2 * (1 - Complex.cos (deltaPhi_ℂ W (ζ - (τ_fn α : ℂ) * H_fam α ζ) ζ)) *
            Complex.exp (-2 * W ζ)) :=
      hParamCongr
        (fun α _ ζ _ => by simp [sub_self])
        (hParamMul hTwoOneSubCos hExpZero.2)

    
    let B_sinD : ℝ := Real.exp R_D * skrCompConst m B_D
    have hBsinD_nn : 0 ≤ B_sinD := mul_nonneg (Real.exp_nonneg _) (hCompConstNonneg m B_D)
    let B_betaInt : ℝ := (2 : ℝ) ^ m * B_sinD * B_pExp2
    have hBbetaInt_nn : 0 ≤ B_betaInt := by positivity
    have hBetaSlice : ∀ β ∈ Set.Icc (0 : ℝ) 1,
        ParamBndAt B_betaInt
          (fun α ζ =>
            let μ := ζ + ((1 - τ_fn α : ℝ) : ℂ) * H_fam α ζ
            Complex.sin (deltaPhi_ℂ W (ζ - (τ_fn α : ℂ) * H_fam α ζ) (ζ + (β : ℂ) * (μ - ζ))) *
              Complex.exp (-2 * W (ζ + (β : ℂ) * (μ - ζ)))) := by
      intro β hβ
      let γ_β : ℝ → ℝ := fun α => τ_fn α + β * (1 - τ_fn α)
      have hγβ_cont : ContinuousOn γ_β (Set.Icc (0 : ℝ) 1) :=
        hτ_cont.add (continuousOn_const.mul (continuousOn_const.sub hτ_cont))
      have hγβ_mem : ∀ α ∈ Set.Icc (0 : ℝ) 1, γ_β α ∈ Set.Icc (0 : ℝ) 1 := by
        intro α hα
        exact ⟨by dsimp [γ_β]; nlinarith [(hFam α hα).1.1, (hFam α hα).1.2, hβ.1],
          by dsimp [γ_β]; nlinarith [(hFam α hα).1.1, (hFam α hα).1.2, hβ.2]⟩
      have hD_β := hDeltaPhi γ_β hγβ_cont hγβ_mem
      have hSin_β := hParamComp Metric.isOpen_ball (Real.exp_nonneg _) hD_β.1 hSinBallD.1
        (fun j _ w hw => hSinBallD.2 j w hw)
        (fun α hα => ⟨(hD_β.2.1 α hα).1,
          fun z hz => Metric.mem_ball.mpr
            (by rw [dist_zero_right]; linarith [hBndPt (hD_β.2.1 α hα) z hz]),
          fun j _ hjm z hz => (hD_β.2.1 α hα).2 j hjm z hz⟩)
        hD_β.2.2
      have hExp_β := (hShiftedExp (fun α => β * (1 - τ_fn α))
        (continuousOn_const.mul (continuousOn_const.sub hτ_cont))
        (fun α hα => ⟨by nlinarith [(hFam α hα).1.1, (hFam α hα).1.2, hβ.1],
          by nlinarith [(hFam α hα).1.1, (hFam α hα).1.2, hβ.2]⟩)).2
      refine hParamCongr (fun α _ ζ _ => ?_) (hParamMul hSin_β hExp_β)
      dsimp only
      have hpt : ζ + (β : ℂ) * ((ζ + ((1 - τ_fn α : ℝ) : ℂ) * H_fam α ζ) - ζ) =
          ζ + ((β * (1 - τ_fn α) : ℝ) : ℂ) * H_fam α ζ := by push_cast; ring
      have hpt2 : ζ + ((γ_β α - τ_fn α : ℝ) : ℂ) * H_fam α ζ =
          ζ + ((β * (1 - τ_fn α) : ℝ) : ℂ) * H_fam α ζ := by dsimp [γ_β]; push_cast; ring
      rw [hpt, hpt2]

    have hBetaContAt : ∀ α ∈ Set.Icc (0 : ℝ) 1, ∀ z ∈ horizStrip σ',
        ContinuousOn
          (fun β : ℝ =>
            let μ := z + ((1 - τ_fn α : ℝ) : ℂ) * H_fam α z
            Complex.sin (deltaPhi_ℂ W (z - (τ_fn α : ℂ) * H_fam α z) (z + (β : ℂ) * (μ - z))) *
              Complex.exp (-2 * W (z + (β : ℂ) * (μ - z))))
          (Set.Icc (0 : ℝ) 1) := by
      intro α hα z hz
      let X₀ := z - (τ_fn α : ℂ) * H_fam α z
      let μ₀ := z + ((1 - τ_fn α : ℝ) : ℂ) * H_fam α z
      have hMemSeg : ∀ β ∈ Set.Icc (0 : ℝ) 1, ∀ θ ∈ Set.Icc (0 : ℝ) 1,
          X₀ + (θ : ℂ) * ((z + (β : ℂ) * (μ₀ - z)) - X₀) ∈ horizStrip σ := by
        intro β hβ θ hθ
        have hc_val : X₀ + (θ : ℂ) * ((z + (β : ℂ) * (μ₀ - z)) - X₀) =
            z + ((θ * (τ_fn α + β * (1 - τ_fn α)) - τ_fn α : ℝ) : ℂ) * H_fam α z := by
          dsimp [X₀, μ₀]; push_cast; ring
        rw [hc_val]
        have hγ0 : 0 ≤ τ_fn α + β * (1 - τ_fn α) :=
          by nlinarith [(hFam α hα).1.1, (hFam α hα).1.2, hβ.1]
        have hγ1 : τ_fn α + β * (1 - τ_fn α) ≤ 1 :=
          by nlinarith [(hFam α hα).1.1, (hFam α hα).1.2, hβ.2]
        exact hCalc.mem_horizStrip_of_tau_seg σ (τ_fn α)
          (θ * (τ_fn α + β * (1 - τ_fn α)) - τ_fn α) z (H_fam α z) (hFam α hα).1
          ⟨by nlinarith [hθ.1], by nlinarith [hθ.1, hθ.2]⟩
          ((hFam α hα).2.2.1 z hz).1 ((hFam α hα).2.2.1 z hz).2
      have hIntCont : ContinuousOn
          (fun β : ℝ => ∫ θ in (0 : ℝ)..1,
            Complex.exp (W (X₀ + (θ : ℂ) * ((z + (β : ℂ) * (μ₀ - z)) - X₀))))
          (Set.Icc (0 : ℝ) 1) := by
        refine hCalc.param_int_cont (Real.exp M)
          (fun β θ => Complex.exp (W (X₀ + (θ : ℂ) * ((z + (β : ℂ) * (μ₀ - z)) - X₀))))
          (Real.exp_nonneg M) ?_ ?_ ?_
        · intro β hβ
          refine Complex.continuous_exp.comp_continuousOn (hW.1.continuousOn.comp ?_
            (fun θ hθ => hMemSeg β hβ θ hθ))
          exact continuousOn_const.add (Complex.continuous_ofReal.continuousOn.mul continuousOn_const)
        · intro θ hθ
          refine Complex.continuous_exp.comp_continuousOn (hW.1.continuousOn.comp ?_
            (fun β hβ => hMemSeg β hβ θ hθ))
          exact continuousOn_const.add (continuousOn_const.mul
            ((continuousOn_const.add (Complex.continuous_ofReal.continuousOn.mul continuousOn_const)).sub
              continuousOn_const))
        · intro β hβ θ hθ
          rw [Complex.norm_exp]
          refine Real.exp_le_exp.mpr (le_trans (Complex.re_le_norm _) ?_)
          simpa [iteratedDeriv_zero] using hW.2.2.2.2 0 (by omega) _ (hMemSeg β hβ θ hθ)
      have hD_cont : ContinuousOn
          (fun β : ℝ => deltaPhi_ℂ W X₀ (z + (β : ℂ) * (μ₀ - z))) (Set.Icc (0 : ℝ) 1) :=
        (((continuousOn_const.add
          (Complex.continuous_ofReal.continuousOn.mul continuousOn_const)).sub
          continuousOn_const)).mul hIntCont
      have hExp_cont : ContinuousOn
          (fun β : ℝ => Complex.exp (-2 * W (z + (β : ℂ) * (μ₀ - z)))) (Set.Icc (0 : ℝ) 1) := by
        refine Complex.continuous_exp.comp_continuousOn (continuousOn_const.mul
          (hW.1.continuousOn.comp ?_ ?_))
        · exact continuousOn_const.add (Complex.continuous_ofReal.continuousOn.mul continuousOn_const)
        · intro β hβ
          have h1 := hMemSeg β hβ 1 ⟨zero_le_one, le_rfl⟩
          simpa using h1
      exact (Complex.continuous_sin.comp_continuousOn hD_cont).mul hExp_cont

    have hBetaIntP := hParamInt hBbetaInt_nn hBetaSlice hBetaContAt
    have hMuSubZ : ParamBndAt ((2 : ℝ) ^ m * 1 * 1)
        (fun α ζ => (ζ + ((1 - τ_fn α : ℝ) : ℂ) * H_fam α ζ) - ζ) := by
      refine hParamCongr (fun _ _ _ _ => (add_sub_cancel_left _ _).symm) ?_
      exact hParamMul
        (hParamAlphaScalar 1 (fun α => ((1 - τ_fn α : ℝ) : ℂ)) zero_le_one
          (Complex.continuous_ofReal.comp_continuousOn (continuousOn_const.sub hτ_cont))
          (fun α hα => by
            rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (by linarith [(hFam α hα).1.2])]
            linarith [(hFam α hα).1.1]))
        hH_param
    have hExpW0 : ParamBndAt B_pExp1 (fun _ ζ => Complex.exp (W ζ)) :=
      hParamCongr (fun _ _ _ _ => by simp) hExpZero.1
    have hTerm2 := hParamMul (hParamMul hExpW0 hMuSubZ) hBetaIntP
    have hKerParam := hParamSub hTerm1 hTerm2
    exact hKerParam.2.2

  
  
  
  · intro σ σ' sgn τ ΔH_scaled q w₁ w₂ W₁ W₂ H₁ H₂
      hσ hσ' hσ'σ hq hsgn hΔH_nn _ _ hW₁ hW₂ hτ hH₁_holo hH₂_holo hSeg hPert hLipH
    dsimp only
    obtain ⟨hq_pos, hq_ge1, _, hH₁_step, hH₁_one, _⟩ :=
      hStepNorm hq hsgn hH₁_holo (fun k hk z hz => (hPert k hk z hz).1)
    obtain ⟨_, _, _, hH₂_step, hH₂_one, _⟩ :=
      hStepNorm hq hsgn hH₂_holo (fun k hk z hz => (hPert k hk z hz).2)
    have hq_le_q2 : (q : ℝ) ≤ (q : ℝ) ^ 2 := by nlinarith
    have hq2_ge1 : 1 ≤ (q : ℝ) ^ 2 := by nlinarith
    have hq2_pos : 0 < (q : ℝ) ^ 2 := sq_pos_of_pos hq_pos
    have hq3_pos : 0 < (q : ℝ) ^ 3 := pow_pos hq_pos 3
    let ΔW : ℝ := stripDiffSup (m + 15) σ W₁ W₂
    have hΔW_nn : 0 ≤ ΔW :=
      (hCalc.stripDiffSup_nonneg_and_le (m + 15) σ M w₁ w₂ W₁ W₂ hσ.1 hW₁ hW₂).1
    let Δ_tot : ℝ := ΔH_scaled + ΔW
    have hΔtot_nn : 0 ≤ Δ_tot := add_nonneg hΔH_nn hΔW_nn
    have hHdiff_q2 : IsSkrStripBnd m σ' (ΔH_scaled / (q : ℝ) ^ 2) (fun ζ => H₁ ζ - H₂ ζ) :=
      ⟨hH₁_holo.sub hH₂_holo, fun k hk z hz => (le_div_iff₀' hq2_pos).mpr (hLipH k hk z hz)⟩
    have hHdiff_tot_q2 : IsSkrStripBnd m σ' (Δ_tot / (q : ℝ) ^ 2) (fun ζ => H₁ ζ - H₂ ζ) :=
      hCalc.bnd_mono (div_le_div_of_nonneg_right (by dsimp [Δ_tot]; linarith) (le_of_lt hq2_pos))
        hHdiff_q2
    have hHdiff_unscaled : IsSkrStripBnd m σ' ΔH_scaled (fun ζ => H₁ ζ - H₂ ζ) :=
      hCalc.bnd_mono (div_le_self hΔH_nn hq2_ge1) hHdiff_q2
    obtain ⟨hR1_bnd, _, hRdiff_bnd⟩ :=
      hRemPair σ σ' τ ΔH_scaled w₁ w₂ W₁ W₂ H₁ H₂
        hσ.1 hσ' hσ'σ hΔH_nn hτ hW₁ hW₂ hH₁_one hH₂_one hSeg hHdiff_unscaled
    let c₀ : ℂ := (((3 / 2 : ℝ) * τ ^ 2 - 1 / 2 : ℝ) : ℂ)
    have hc₀_norm : ‖c₀‖ ≤ 1 := by
      dsimp [c₀]
      rw [Complex.norm_real, Real.norm_eq_abs, abs_le]
      have hτ2_nn : 0 ≤ τ ^ 2 := sq_nonneg τ
      have hτ2_le1 : τ ^ 2 ≤ 1 := by nlinarith [hτ.1, hτ.2]
      exact ⟨by linarith, by linarith⟩
    
    have hHsum : IsSkrStripBnd m σ' ((2 * B_step) / (q : ℝ)) (fun ζ => H₁ ζ + H₂ ζ) := by
      have hs := hCalc.bnd_add hH₁_step hH₂_step
      have heq : B_step / (q : ℝ) + B_step / (q : ℝ) = (2 * B_step) / (q : ℝ) := by ring
      rwa [heq] at hs
    have hS1_prod := hCalc.bnd_mul hHdiff_tot_q2 hHsum
    have hS1_nn : 0 ≤ (2 : ℝ) ^ m * (Δ_tot / (q : ℝ) ^ 2) * ((2 * B_step) / (q : ℝ)) := by
      positivity
    have hS1 := hCalc.bnd_mono
      (mul_le_mul_of_nonneg_right hc₀_norm hS1_nn)
      (hCalc.bnd_const_mul c₀ hS1_nn hS1_prod)
    
    have hHH_le : (2 : ℝ) ^ m * (B_step / (q : ℝ)) * (B_step / (q : ℝ)) ≤
        ((2 : ℝ) ^ m * B_step ^ 2) / (q : ℝ) := by
      have heq : (2 : ℝ) ^ m * (B_step / (q : ℝ)) * (B_step / (q : ℝ)) =
          ((2 : ℝ) ^ m * B_step ^ 2) / (q : ℝ) ^ 2 := by ring
      rw [heq]
      exact div_le_div_of_nonneg_left (by positivity) hq_pos hq_le_q2
    have hH11 := hCalc.bnd_mono hHH_le (hCalc.bnd_mul hH₁_step hH₁_step)
    have hH12 := hCalc.bnd_mono hHH_le (hCalc.bnd_mul hH₁_step hH₂_step)
    have hH22 := hCalc.bnd_mono hHH_le (hCalc.bnd_mul hH₂_step hH₂_step)
    have hHquadSum := hCalc.bnd_add (hCalc.bnd_add hH11 hH12) hH22
    have hS2 := hCalc.bnd_mul (hCalc.bnd_mul hHdiff_tot_q2 hHquadSum) hR1_bnd
    
    have hS3 := hCalc.bnd_mul (hCalc.bnd_mul (hCalc.bnd_mul hH₂_step hH₂_step) hH₂_step) hRdiff_bnd
    have hAll := hCalc.bnd_add (hCalc.bnd_add hS1 hS2) hS3
    have hAll_eq :
        (1 * ((2 : ℝ) ^ m * (Δ_tot / (q : ℝ) ^ 2) * ((2 * B_step) / (q : ℝ))) +
          (2 : ℝ) ^ m *
            ((2 : ℝ) ^ m * (Δ_tot / (q : ℝ) ^ 2) *
              (((2 : ℝ) ^ m * B_step ^ 2) / (q : ℝ) +
                ((2 : ℝ) ^ m * B_step ^ 2) / (q : ℝ) +
                ((2 : ℝ) ^ m * B_step ^ 2) / (q : ℝ))) *
            M_rem) +
          (2 : ℝ) ^ m *
            ((2 : ℝ) ^ m * ((2 : ℝ) ^ m * (B_step / (q : ℝ)) * (B_step / (q : ℝ))) *
              (B_step / (q : ℝ))) *
            (L_rem * Δ_tot) =
        (C_lip * Δ_tot) / (q : ℝ) ^ 3 := by
      dsimp [C_lip]
      have h3m : (2 : ℝ) ^ (3 * m) = (2 : ℝ) ^ m * (2 : ℝ) ^ m * (2 : ℝ) ^ m := by
        rw [show 3 * m = m + m + m by omega, pow_add, pow_add]
      rw [h3m]
      ring
    rw [hAll_eq] at hAll
    have hEqDiff : Set.EqOn
        (fun ζ =>
          (c₀ * ((H₁ ζ - H₂ ζ) * (H₁ ζ + H₂ ζ)) +
            (((H₁ ζ - H₂ ζ) * (H₁ ζ * H₁ ζ + H₁ ζ * H₂ ζ + H₂ ζ * H₂ ζ)) *
              skrKerRem W₁ τ (H₁ ζ) ζ)) +
          (((H₂ ζ * H₂ ζ) * H₂ ζ) * (skrKerRem W₁ τ (H₁ ζ) ζ - skrKerRem W₂ τ (H₂ ζ) ζ)))
        (fun ζ =>
          cellKernelMinus_ℂ W₁ (ζ - (τ : ℂ) * H₁ ζ) (ζ + ((1 - τ : ℝ) : ℂ) * H₁ ζ) ζ -
            cellKernelMinus_ℂ W₂ (ζ - (τ : ℂ) * H₂ ζ) (ζ + ((1 - τ : ℝ) : ℂ) * H₂ ζ) ζ)
        (horizStrip σ') := by
      intro ζ hζ
      dsimp only
      have hf1 := hPt.factor_eq σ τ W₁ (H₁ ζ) ζ hσ.1 hW₁.1 hτ
        (hStripSub hσ'σ hζ) (hSeg ζ hζ).1 (hSeg ζ hζ).2.1
      have hf2 := hPt.factor_eq σ τ W₂ (H₂ ζ) ζ hσ.1 hW₂.1 hτ
        (hStripSub hσ'σ hζ) (hSeg ζ hζ).2.2.1 (hSeg ζ hζ).2.2.2
      rw [hf1, hf2]
      dsimp [c₀]
      ring
    have hDiffBnd := hBndCongr hEqDiff hAll
    intro k hk z hz
    have hk_le := hDiffBnd.2 k hk z hz
    have h1 : (q : ℝ) ^ 3 *
        ‖iteratedDeriv k
          (fun ζ =>
            cellKernelMinus_ℂ W₁ (ζ - (τ : ℂ) * H₁ ζ) (ζ + ((1 - τ : ℝ) : ℂ) * H₁ ζ) ζ -
              cellKernelMinus_ℂ W₂ (ζ - (τ : ℂ) * H₂ ζ) (ζ + ((1 - τ : ℝ) : ℂ) * H₂ ζ) ζ)
          z‖ ≤ C_lip * Δ_tot :=
      (le_div_iff₀' hq3_pos).mp hk_le
    have hClip_le : C_lip ≤ C_red := by
      have : C_lip ≤ max C_asymp C_lip := le_max_right _ _
      dsimp [C_red]; linarith
    exact le_trans h1 (mul_le_mul_of_nonneg_right hClip_le hΔtot_nn)

theorem strip_cell_kernel_system (m : ℕ) (M : ℝ)
    (hm : 2 ≤ m) (hM : 0 < M) (S : StationaryMeshSystem m (M + 1))
    (H_inv : StripHalfCellInvSystem m M S) :
    Nonempty (StripKernelSystem m M S H_inv) :=
by
  have hCalc : SkrCalcToolkit := strip_ker_calc_toolkit
  have hPt : SkrPointwiseProp := pointwise_kernel_identities_and_factorization
