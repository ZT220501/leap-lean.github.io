      have hV_wt : rp_HasPSLaurentWeight 1 (rp_jetVSeries u_lt) := by
        intro m
        simp only [rp_jetVSeries, PowerSeries.coeff_mk]
        by_cases hm : m % 2 = 0 ∧ 2 ≤ m
        · simp only [hm, and_self, ite_true]
          have hi : 1 ≤ m / 2 := by omega
          obtain ⟨h1, h2⟩ := hu_lt (m / 2) hi
          refine ⟨h1, le_trans (WithTop.coe_le_coe.mpr (by omega)) h2⟩
        · simp only [hm, ite_false]
          refine ⟨analyticAt_const.meromorphicAt, ?_⟩
          rw [meromorphicOrderAt_const]; simp
      have h_lead_wt : ∀ m : ℕ,
          MeromorphicAt (fun _ : ℂ => if m = 1 then (1 : ℂ) else 0) 0 ∧
            ((1 - (m : ℤ) : ℤ) : WithTop ℤ) ≤
              meromorphicOrderAt (fun _ : ℂ => if m = 1 then (1 : ℂ) else 0) 0 := by
        intro m
        by_cases hm : m = 1
        · subst hm; simp only [ite_true]
          refine ⟨analyticAt_const.meromorphicAt, ?_⟩
          rw [meromorphicOrderAt_const]; simp
        · simp only [ite_eq_right_iff.mpr (fun h => absurd h hm)]
          refine ⟨analyticAt_const.meromorphicAt, ?_⟩
          rw [meromorphicOrderAt_const]; simp
      have hHP_wt : rp_HasPSLaurentWeight 1 (rp_jetHPlusSeries u_lt) := by
        intro m
        have h_eq : (fun z => PowerSeries.coeff m (rp_jetHPlusSeries u_lt z)) =
            (fun z => (if m = 1 then (1 : ℂ) else 0) +
              ∑ p ∈ Finset.HasAntidiagonal.antidiagonal m,
                if p.1 % 2 = 0 ∧ 2 ≤ p.1 ∧ 1 ≤ p.2 then
                  iteratedDeriv p.2 (u_lt (p.1 / 2)) z / (p.2.factorial : ℂ)
                else 0) := by ext z; simp [rp_jetHPlusSeries]
        rw [h_eq]
        obtain ⟨hm₁, ho₁⟩ := h_lead_wt m
        have h_sum := h_mero_sum (Finset.HasAntidiagonal.antidiagonal m) (1 - (m : ℤ))
          (fun p z =>
            if p.1 % 2 = 0 ∧ 2 ≤ p.1 ∧ 1 ≤ p.2 then
              iteratedDeriv p.2 (u_lt (p.1 / 2)) z / (p.2.factorial : ℂ)
            else 0) ?_
        · exact ⟨hm₁.add h_sum.1, le_trans (le_min ho₁ h_sum.2) (meromorphicOrderAt_add hm₁ h_sum.1)⟩
        · intro p hp
          have hp_sum : p.1 + p.2 = m := Finset.HasAntidiagonal.mem_antidiagonal.mp hp
          by_cases hcond : p.1 % 2 = 0 ∧ 2 ≤ p.1 ∧ 1 ≤ p.2
          · simp only [hcond, and_self, ite_true]
            have hi : 1 ≤ p.1 / 2 := by omega
            obtain ⟨hu_m, hu_o⟩ := hu_lt (p.1 / 2) hi
            obtain ⟨hd_m, hd_o⟩ := h_iter_ord p.2 (1 - 2 * ((p.1 / 2 : ℕ) : ℤ)) (u_lt (p.1 / 2)) hu_m hu_o
            have h_div : (fun z => iteratedDeriv p.2 (u_lt (p.1 / 2)) z / (p.2.factorial : ℂ)) =
                (fun z => (p.2.factorial : ℂ)⁻¹ * iteratedDeriv p.2 (u_lt (p.1 / 2)) z) := by
              ext z; rw [div_eq_inv_mul]
            rw [h_div]
            exact h_const_mul_ord (p.2.factorial : ℂ)⁻¹ (1 - (m : ℤ)) _ hd_m
              (le_trans (WithTop.coe_le_coe.mpr (by omega)) hd_o)
          · simp only [hcond, ite_false]
            refine ⟨analyticAt_const.meromorphicAt, ?_⟩
            rw [meromorphicOrderAt_const]; simp
      have hHM_wt : rp_HasPSLaurentWeight 1 (rp_jetHMinusSeries u_lt) := by
        intro m
        have h_eq : (fun z => PowerSeries.coeff m (rp_jetHMinusSeries u_lt z)) =
            (fun z => (if m = 1 then (1 : ℂ) else 0) +
              ∑ p ∈ Finset.HasAntidiagonal.antidiagonal m,
                if p.1 % 2 = 0 ∧ 2 ≤ p.1 ∧ 1 ≤ p.2 then
                  (-1 : ℂ) ^ (p.2 + 1) * (iteratedDeriv p.2 (u_lt (p.1 / 2)) z / (p.2.factorial : ℂ))
                else 0) := by ext z; simp [rp_jetHMinusSeries]
        rw [h_eq]
        obtain ⟨hm₁, ho₁⟩ := h_lead_wt m
        have h_sum := h_mero_sum (Finset.HasAntidiagonal.antidiagonal m) (1 - (m : ℤ))
          (fun p z =>
            if p.1 % 2 = 0 ∧ 2 ≤ p.1 ∧ 1 ≤ p.2 then
              (-1 : ℂ) ^ (p.2 + 1) * (iteratedDeriv p.2 (u_lt (p.1 / 2)) z / (p.2.factorial : ℂ))
            else 0) ?_
        · exact ⟨hm₁.add h_sum.1, le_trans (le_min ho₁ h_sum.2) (meromorphicOrderAt_add hm₁ h_sum.1)⟩
        · intro p hp
          have hp_sum : p.1 + p.2 = m := Finset.HasAntidiagonal.mem_antidiagonal.mp hp
          by_cases hcond : p.1 % 2 = 0 ∧ 2 ≤ p.1 ∧ 1 ≤ p.2
          · simp only [hcond, and_self, ite_true]
            have hi : 1 ≤ p.1 / 2 := by omega
            obtain ⟨hu_m, hu_o⟩ := hu_lt (p.1 / 2) hi
            obtain ⟨hd_m, hd_o⟩ := h_iter_ord p.2 (1 - 2 * ((p.1 / 2 : ℕ) : ℤ)) (u_lt (p.1 / 2)) hu_m hu_o
            have h_div : (fun z => (-1 : ℂ) ^ (p.2 + 1) *
                  (iteratedDeriv p.2 (u_lt (p.1 / 2)) z / (p.2.factorial : ℂ))) =
                (fun z => ((-1 : ℂ) ^ (p.2 + 1) * (p.2.factorial : ℂ)⁻¹) *
                  iteratedDeriv p.2 (u_lt (p.1 / 2)) z) := by ext z; ring
            rw [h_div]
            exact h_const_mul_ord _ (1 - (m : ℤ)) _ hd_m
              (le_trans (WithTop.coe_le_coe.mpr (by omega)) hd_o)
          · simp only [hcond, ite_false]
            refine ⟨analyticAt_const.meromorphicAt, ?_⟩
            rw [meromorphicOrderAt_const]; simp
      have hPoly_wt : rp_HasPSLaurentWeight 0 (rp_reflPolySeries G N u_lt) := by
        unfold rp_reflPolySeries
        apply h_wt_sum; intro d _
        apply h_wt_sum; intro k _
        have h_sub : rp_HasPSLaurentWeight (-(k.1 : ℤ) - (k.2 : ℤ))
            (fun z => rp_substPS (holoTaylor1D (reflDiffCoeff G k.1 k.2) z) (rp_jetVSeries u_lt z)) := by
          apply h_wt_subst _ _ _ _ hV_wt
          intro r
          have h_c : (fun z => PowerSeries.coeff r (holoTaylor1D (reflDiffCoeff G k.1 k.2) z)) =
              (fun z => (r.factorial : ℂ)⁻¹ * iteratedDeriv r (reflDiffCoeff G k.1 k.2) z) := by
            ext z; simp [holoTaylor1D, div_eq_inv_mul]
          rw [h_c]
          obtain ⟨hm_r, ho_r⟩ := S.refl_coeff_mero_order k.1 k.2 r
          exact h_const_mul_ord (r.factorial : ℂ)⁻¹ (-(k.1 : ℤ) - (k.2 : ℤ) - (r : ℤ)) _ hm_r ho_r
        have h_prod1 := h_wt_mul h_sub (h_wt_pow k.1 hHM_wt)
        have h_prod2 := h_wt_mul h_prod1 (h_wt_pow k.2 hHP_wt)
        have h_w0 : (-(k.1 : ℤ) - (k.2 : ℤ)) + (k.1 : ℤ) + (k.2 : ℤ) = 0 := by omega
        rwa [h_w0] at h_prod2
      simpa using hPoly_wt β
    · intro j hj v_j F_trunc hv_mero hF_mero hF_ord h_ode
      have hf0 : ‖(0 : ℂ)‖ < S.δ₁ := by simpa using S.δ₁_pos
      obtain ⟨hf_ana, hf_ne⟩ := S.f_tilde_ball 0 hf0
      let q : ℂ → ℂ := fun z => -(Complex.I * S.f_tilde z)⁻¹
      have hI_ft_ne : Complex.I * S.f_tilde 0 ≠ 0 := mul_ne_zero Complex.I_ne_zero hf_ne
      have hq_ana : AnalyticAt ℂ q 0 :=
        ((analyticAt_const.mul hf_ana).inv hI_ft_ne).neg
      have h_ft_ev : ∀ᶠ z in nhds (0 : ℂ), S.f_tilde z ≠ 0 :=
        hf_ana.continuousAt.eventually_ne hf_ne
      have h_v2_eq : iteratedDeriv 2 v_j =ᶠ[nhdsWithin (0 : ℂ) {(0 : ℂ)}ᶜ]
          fun z => q z * z * F_trunc z := by
        rw [eventuallyEq_nhdsWithin_iff]
        filter_upwards [Metric.ball_mem_nhds (0 : ℂ) S.δ₁_pos, h_ft_ev] with z hz_ball hft_z hz_ne
        have hz_pos : 0 < ‖z‖ := norm_pos_iff.mpr hz_ne
        have hz_lt : ‖z‖ < S.δ₁ := by simpa using Metric.mem_ball.mp hz_ball
        have h_eq1 := h_ode z hz_pos hz_lt
        rw [S.f_expansion z hz_pos hz_lt] at h_eq1
        have hz_ne0 : z ≠ 0 := hz_ne
        dsimp [q]
        calc
          iteratedDeriv 2 v_j z =
              (Complex.I * (z⁻¹ * S.f_tilde z) * iteratedDeriv 2 v_j z) *
                z * (Complex.I * S.f_tilde z)⁻¹ := by
            field_simp [hz_ne0, hft_z, Complex.I_ne_zero]
          _ = (- F_trunc z) * z * (Complex.I * S.f_tilde z)⁻¹ := by rw [h_eq1]
          _ = -(Complex.I * S.f_tilde z)⁻¹ * z * F_trunc z := by ring
      have hv2_ord : ((-1 - 2 * (j : ℤ) : ℤ) : WithTop ℤ) ≤
          meromorphicOrderAt (iteratedDeriv 2 v_j) 0 := by
        rw [meromorphicOrderAt_congr h_v2_eq]
        have hqz_mero : MeromorphicAt (fun z => q z * z) 0 := hq_ana.meromorphicAt.mul h_id_mero
        have hm1 : meromorphicOrderAt (fun z => q z * z * F_trunc z) 0 =
            meromorphicOrderAt (fun z => q z * z) 0 + meromorphicOrderAt F_trunc 0 :=
          meromorphicOrderAt_mul hqz_mero hF_mero
        have hm2 : meromorphicOrderAt (fun z => q z * z) 0 =
            meromorphicOrderAt q 0 + meromorphicOrderAt (id : ℂ → ℂ) 0 :=
          meromorphicOrderAt_mul hq_ana.meromorphicAt h_id_mero
        rw [hm1, hm2, meromorphicOrderAt_id]
        have h_le : (0 : WithTop ℤ) + (1 : WithTop ℤ) + ((- (2 * (j : ℤ) + 2) : ℤ) : WithTop ℤ) ≤
            meromorphicOrderAt q 0 + (1 : WithTop ℤ) + meromorphicOrderAt F_trunc 0 :=
          add_le_add (add_le_add hq_ana.meromorphicOrderAt_nonneg le_rfl) hF_ord
        exact le_trans (by
          change ((-1 - 2 * (j : ℤ) : ℤ) : WithTop ℤ) ≤
            (((0 + 1 + -(2 * (j : ℤ) + 2) : ℤ)) : WithTop ℤ)
          exact WithTop.coe_le_coe.mpr (by omega)) h_le
      have hv_ord : ((1 - 2 * (j : ℤ) : ℤ) : WithTop ℤ) ≤ meromorphicOrderAt v_j 0 := by
        by_contra h_lt
        rw [not_le] at h_lt
        cases h_eq : meromorphicOrderAt v_j 0 with
        | top =>
          rw [h_eq] at h_lt
          exact not_lt_of_ge le_top h_lt
        | coe m =>
          rw [h_eq] at h_lt
          have hm_lt : m < 1 - 2 * (j : ℤ) := WithTop.coe_lt_coe.mp h_lt
          obtain ⟨g, hg_ana, hg_ne, hg_eq⟩ := (meromorphicOrderAt_eq_int_iff hv_mero).mp h_eq
          have hg_eq' : v_j =ᶠ[nhdsWithin (0 : ℂ) {(0 : ℂ)}ᶜ] fun z => z ^ m * g z :=
            hg_eq.mono fun z hz => by simpa [sub_zero, smul_eq_mul] using hz
          have hd1 := h_deriv_zpow_mul m v_j g hg_ana hg_eq'
          let g₁ : ℂ → ℂ := fun z => (m : ℂ) * g z + z * deriv g z
          have hg₁_ana : AnalyticAt ℂ g₁ 0 :=
            (analyticAt_const.mul hg_ana).add (analyticAt_id.mul hg_ana.deriv)
          have hd2 := h_deriv_zpow_mul (m - 1) (deriv v_j) g₁ hg₁_ana hd1
          let g₂ : ℂ → ℂ := fun z => ((m - 1 : ℤ) : ℂ) * g₁ z + z * deriv g₁ z
          have hg₂_ana : AnalyticAt ℂ g₂ 0 :=
            (analyticAt_const.mul hg₁_ana).add (analyticAt_id.mul hg₁_ana.deriv)
          have hg₂_ne : g₂ 0 ≠ 0 := by
            have hm0 : (m : ℂ) ≠ 0 := Int.cast_ne_zero.mpr (by omega)
            have hm1 : ((m - 1 : ℤ) : ℂ) ≠ 0 := Int.cast_ne_zero.mpr (by omega)
            have h_val : g₂ 0 = ((m - 1 : ℤ) : ℂ) * ((m : ℂ) * g 0) := by simp [g₂, g₁]
