            have h_sub := Finset.sum_range_sub (fun m => b m - w (m + 1)) (j + 1)
            have h_congr :
                ∑ m ∈ Finset.range (j + 1), ((b (m + 1) - w (m + 2)) - (b m - w (m + 1))) =
                ∑ m ∈ Finset.range (j + 1), t * (J_step (m + 1) - 1) :=
