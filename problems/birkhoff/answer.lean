              (h_ec_mul (h_ec_comp _ _ (hf i_L) (h_mid_ec i_L)) (h_cos_ec i_L)))
            (h_ec_mul (h_ec_comp _ _ (h_df i_R) (h_mid_ec i_R)) (h_sin_ec i_R)))
