      rw [h_comp_shift_inv, Polynomial.mul_comp, Polynomial.pow_comp] at h_comp
      have h_lin : (Polynomial.X - Polynomial.C z).comp (Polynomial.X - Polynomial.C c) =
          Polynomial.X - Polynomial.C (z + c) := by
        simp [map_add]
        ring
      rw [h_lin] at h_comp
      exact ⟨H.comp (Polynomial.X - Polynomial.C c), h_comp⟩
    have h_rm_shift : ∀ (A : Polynomial ℂ) (z : ℂ),
        Polynomial.rootMultiplicity z (A.comp (Polynomial.X + 1)) =
          Polynomial.rootMultiplicity (z + 1) A := by
      intro A z
      by_cases hA : A = 0
      · subst hA; simp
      · have hX1 : (Polynomial.X + 1 : Polynomial ℂ) = Polynomial.X + Polynomial.C 1 := by simp
        rw [hX1]
        apply le_antisymm
        · exact h_rm_shift_le A 1 z hA
        · have hA1_ne : A.comp (Polynomial.X + Polynomial.C 1) ≠ 0 := by
            rw [← hX1]; exact h_comp_ne A hA
          have h2 := h_rm_shift_le (A.comp (Polynomial.X + Polynomial.C 1)) (-1) (z + 1) hA1_ne
          have h_inv : (A.comp (Polynomial.X + Polynomial.C 1)).comp (Polynomial.X + Polynomial.C (-1)) = A := by
            simpa [sub_eq_add_neg] using h_comp_shift_inv A 1
          have h_z : z + 1 + (-1) = z := by ring
          rwa [h_inv, h_z] at h2
    let S_geom : Polynomial ℂ → Polynomial ℂ → ℕ → Polynomial ℂ :=
      fun A B k => ∑ i ∈ Finset.range k, A ^ i * B ^ (k - 1 - i)
    have hS_mul : ∀ (A B : Polynomial ℂ) (k : ℕ), S_geom A B k * (A - B) = A ^ k - B ^ k :=
      fun A B k => geom_sum₂_mul A B k
    have hS_eval_B0 : ∀ (A B : Polynomial ℂ) (k : ℕ) (z : ℂ), 1 ≤ k → B.eval z = 0 →
        (S_geom A B k).eval z = (A.eval z) ^ (k - 1) := by
      intro A B k z hk hBz
      simp only [S_geom, Polynomial.eval_finsetSum, Polynomial.eval_mul, Polynomial.eval_pow]
      rw [Finset.sum_eq_single (k - 1)]
      · simp
      · intro i hi hi_ne
        have hi_lt : i < k := Finset.mem_range.mp hi
        have h_pos : k - 1 - i ≠ 0 := by omega
        rw [hBz, zero_pow h_pos, mul_zero]
      · intro h_not
        exact absurd (Finset.mem_range.mpr (by omega)) h_not
    have hS_eval_A0 : ∀ (A B : Polynomial ℂ) (k : ℕ) (z : ℂ), 1 ≤ k → A.eval z = 0 →
        (S_geom A B k).eval z = (B.eval z) ^ (k - 1) := by
      intro A B k z hk hAz
      simp only [S_geom, Polynomial.eval_finsetSum, Polynomial.eval_mul, Polynomial.eval_pow]
      rw [Finset.sum_eq_single 0]
      · simp
      · intro i _ hi_ne
        rw [hAz, zero_pow hi_ne, zero_mul]
      · intro h_not
        exact absurd (Finset.mem_range.mpr (by omega)) h_not
    have hS_eval_eq : ∀ (A B : Polynomial ℂ) (k : ℕ) (z : ℂ), 1 ≤ k → A.eval z = B.eval z →
        (S_geom A B k).eval z = (k : ℂ) * (B.eval z) ^ (k - 1) := by
      intro A B k z hk hAB
      simp only [S_geom, Polynomial.eval_finsetSum, Polynomial.eval_mul, Polynomial.eval_pow, hAB]
      have h_congr : ∑ i ∈ Finset.range k, (B.eval z) ^ i * (B.eval z) ^ (k - 1 - i) =
          ∑ _i ∈ Finset.range k, (B.eval z) ^ (k - 1) := by
        apply Finset.sum_congr rfl
        intro i hi
        rw [← pow_add]
        have hi_lt : i < k := Finset.mem_range.mp hi
        congr 1
        omega
      rw [h_congr, Finset.sum_const, Finset.card_range, nsmul_eq_mul]
    let P_plus : Polynomial ℂ := P_ρ.comp (Polynomial.X + 1)
    let Q_plus : Polynomial ℂ := Q_ρ.comp (Polynomial.X + 1)
    have hP_plus_ne : P_plus ≠ 0 := h_comp_ne P_ρ hP_ne
    have hQ_plus_ne : Q_plus ≠ 0 := h_comp_ne Q_ρ hQ_ne
    have h_diff_plus_ne : P_plus - Q_plus ≠ 0 := by
      have h_eq : P_plus - Q_plus = (P_ρ - Q_ρ).comp (Polynomial.X + 1) := by
        dsimp [P_plus, Q_plus]; rw [Polynomial.sub_comp]
      rw [h_eq]
      exact h_comp_ne (P_ρ - Q_ρ) h_diff_ne
    let P_set : Finset ℂ := Q_ρ.roots.toFinset
