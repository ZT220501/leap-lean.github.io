    intro l x hl j₁ j₂ L_l R_rect
    have hj12 : j₁ ≤ j₂ := max_le (hl.trans (by linarith)) (by linarith)
    have hexp_j1 : Real.exp (-j₁) ≤ S.H / 20 :=
      (Real.exp_le_exp.mpr (neg_le_neg (le_max_left _ _))).trans hexp_k₀
    have hR_sub_strip : R_rect ⊆ horizStrip S.H := by
      intro w ⟨_, hw1, hw2⟩
      change |w.im| < S.H
      have hw_pos : 0 ≤ w.im := by linarith [S.H_pos]
      rw [abs_of_nonneg hw_pos]
      linarith [Real.exp_pos (-j₂)]
    have hR_compact : IsCompact R_rect := by
      let K_R : Set ℂ :=
        (fun p : ℝ × ℝ => (p.1 : ℂ) + (p.2 : ℂ) * Complex.I) ''
          (Set.Icc (x - L_l) (x + L_l) ×ˢ Set.Icc (S.H - Real.exp (-j₁)) (S.H - Real.exp (-j₂)))
      have hKR : IsCompact K_R :=
        (isCompact_Icc.prod isCompact_Icc).image
          ((Complex.continuous_ofReal.comp continuous_fst).add
            ((Complex.continuous_ofReal.comp continuous_snd).mul continuous_const))
      have hR_closed : IsClosed R_rect :=
        (isClosed_le (continuous_abs.comp (Complex.continuous_re.sub continuous_const))
          continuous_const).inter
          ((isClosed_le continuous_const Complex.continuous_im).inter
            (isClosed_le Complex.continuous_im continuous_const))
      refine hKR.of_isClosed_subset hR_closed fun w ⟨hw1, hw2, hw3⟩ => ?_
      rw [abs_sub_le_iff] at hw1
      exact ⟨(w.re, w.im), ⟨⟨by linarith, by linarith⟩, hw2, hw3⟩, Complex.re_add_im w⟩
    have hInt_R1 : MeasureTheory.IntegrableOn (shapeModulus S) R_rect MeasureTheory.volume :=
      (hM_cont.mono hR_sub_strip).integrableOn_compact hR_compact
    have hInt_R2 : MeasureTheory.IntegrableOn (fun w => (shapeModulus S w) ^ 2)
        R_rect MeasureTheory.volume :=
      ((hM_cont.mono hR_sub_strip).pow 2).integrableOn_compact hR_compact
    let I₁ : ℝ := ∫ w in R_rect, shapeModulus S w
    let I₂ : ℝ := ∫ w in R_rect, (shapeModulus S w) ^ 2
    have hI₁_nonneg : 0 ≤ I₁ := MeasureTheory.integral_nonneg fun w => hM_nonneg w
    have hI₂_nonneg : 0 ≤ I₂ := MeasureTheory.integral_nonneg fun w => sq_nonneg _
    let r_l : ℝ := (1 / 2 : ℝ) * Real.exp (-A) * Real.exp (-l)
