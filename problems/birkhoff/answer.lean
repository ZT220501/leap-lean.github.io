      let K_pt : Subfield ℂ :=
        Subfield.closure ((K₀ : Set ℂ) ∪ Set.range (fun v : ι_all => jetFn v (Ψ q₁)))
      have hK_pt_le : K_pt ≤ E_frac := by
        refine Subfield.closure_le.mpr ?_
        rintro z (hzK₀ | ⟨v, rfl⟩)
        · exact ⟨MvPolynomial.C ⟨z, hzK₀⟩, 1, by simp, by simp [ev_pt]⟩
        · exact ⟨MvPolynomial.X v, 1, by simp, by simp [ev_pt]⟩
      rcases h_alg a₁ ha₁_mem d₁ hd₁_mem with ⟨p_alg, hp_ne, hp_aeval⟩
      let D₀ : ℕ := p_alg.natDegree
