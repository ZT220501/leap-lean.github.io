  obtain ⟨S_lead_raw, _⟩ :=
    point_arc_single_step_web_continuation Ω C B k hk G a₁ δ₁ ha₁ hδ₁ hJet hWeb
      D_form p₀ (by omega) S_base
  let S_p : PointArcStepAnalyticData C B k G a₁ δ₁ D_form D_form.p := hp₀ ▸ S_lead_raw
  let W_lead : Set ℂ := S_p.W_ψ
  let g_lead : Fin (k + 1) → ℂ → ℂ := fun r => S_p.g r (Fin.last D_form.p)
  let tower : ∀ m : ℕ,
      { S : PointArcStepAnalyticData C B k G a₁ δ₁ D_form (D_form.p + m) //
        ∀ r : Fin (k + 1), S.g r ⟨D_form.p, by omega⟩ = g_lead r } :=
    fun m =>
      Nat.rec
        (motive := fun m =>
          { S : PointArcStepAnalyticData C B k G a₁ δ₁ D_form (D_form.p + m) //
            ∀ r : Fin (k + 1), S.g r ⟨D_form.p, by omega⟩ = g_lead r })
        ⟨S_p, fun _ => rfl⟩
        (fun m ih =>
          let h_step := point_arc_single_step_web_continuation Ω C B k hk G a₁ δ₁ ha₁ hδ₁
            hJet hWeb D_form (D_form.p + m) (by omega) ih.1
          let S_next := Classical.choose h_step
          have h_eq := Classical.choose_spec h_step
          ⟨S_next, fun r => (h_eq r ⟨D_form.p, by omega⟩).trans (ih.2 r)⟩)
