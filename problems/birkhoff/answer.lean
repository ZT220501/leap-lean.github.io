        let R_poly : Polynomial ℂ :=
          Polynomial.C ((α : ℂ) ^ 2) * Q_plus ^ α * S_geom P_plus Q_plus γ * P_ρ ^ α * S_geom P_ρ Q_ρ γ
        have hL_rm : ∀ z : ℂ, Polynomial.rootMultiplicity z L_poly =
            γ * Polynomial.rootMultiplicity (z + 1) P_ρ +
            Polynomial.rootMultiplicity z (S_geom P_plus Q_plus α) +
            γ * p_mult z +
            Polynomial.rootMultiplicity z (S_geom P_ρ Q_ρ α) := by
          intro z
          have hc_ne : Polynomial.C ((γ : ℂ) ^ 2) ≠ 0 := Polynomial.C_ne_zero.mpr hγ_c_ne
          have h1 : Polynomial.C ((γ : ℂ) ^ 2) * P_plus ^ γ ≠ 0 :=
            mul_ne_zero hc_ne (pow_ne_zero γ hP_plus_ne)
          have h2 : Polynomial.C ((γ : ℂ) ^ 2) * P_plus ^ γ * S_geom P_plus Q_plus α ≠ 0 :=
