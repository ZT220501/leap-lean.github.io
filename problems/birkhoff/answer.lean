      calc ∑ w ∈ F.roots.toFinset, Polynomial.rootMultiplicity w F
        = ∑ w ∈ F.roots.toFinset, Multiset.count w F.roots :=
            Finset.sum_congr rfl (fun w _ => (Polynomial.count_roots F).symm)
        _ = F.roots.card := Multiset.toFinset_sum_count_eq F.roots
        _ = F.natDegree := IsAlgClosed.card_roots_eq_natDegree
    have hW_sum_le : ∀ (S : Finset ℂ),
        ∑ w ∈ S, Polynomial.rootMultiplicity w W_ρ ≤ 2 * s - 2 := by
      intro S
      have h_union : ∑ w ∈ W_ρ.roots.toFinset ∪ S, Polynomial.rootMultiplicity w W_ρ =
