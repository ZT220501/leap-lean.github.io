        · exact ((hu_props m (φ₁ (η k)) h_ge).2.1 z (hKm_sub_Um m hz)).1
        · simp [hM₀_pos.le]
      have hv_lip : ∀ k : ℕ, ∀ x ∈ K_m m, ∀ y ∈ K_m m, ‖v_k k x - v_k k y‖ ≤ L₀ * ‖x - y‖ := by
        intro k x hx y hy
