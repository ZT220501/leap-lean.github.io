        hσ hR_pos hΔ_nonneg hq_force hq_R hσ_mesh_pos hσ_mesh_le
        hw₁ hw₂ hW₁ hW₂ hd₁ hd₂ hΔ_d hΔ_step j hj
      refine ⟨hf₁.1.sub hf₂.1, ?_, ?_, hLip⟩
      · intro z hz
        simp only [hf₁.2.1 z hz, hf₂.2.1 z hz]
      · intro z hz
        simp only [map_sub, hf₁.2.2.1 z hz, hf₂.2.2.1 z hz]
    have hBall_raw :
        IsStripMeshDispBall (m + 2) q σ_mesh (2 * (q : ℝ) ^ 4 * M_f)
          (dirichletInv_ℂ q f_diff) :=
      hDir.maps_to_ball (m + 2) q σ_mesh M_f f_diff hq1 hσ_mesh_pos hMf_nonneg hf_diff_bnd
    have hRad : 2 * (q : ℝ) ^ 4 * M_f ≤ (1 / 4 : ℝ) * Δ_star + 2 * F_bd.C_force_lip * Δ_W := by
      have hExpand :
          2 * (q : ℝ) ^ 4 * M_f =
