                  = (1 + MvPowerSeries.C ((m : ℂ) + 1)) * (Z₀₀ * Z₀₀ ^ m) * δ := by ring
                _ = MvPowerSeries.C (((m + 1 : ℕ) : ℂ) + 1) * Z₀₀ ^ (m + 1) * δ := by
                    rw [h1, pow_succ']
