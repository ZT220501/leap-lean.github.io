      (∀ p ∈ adSteepDomain S.H x₀ (2 * (m + C₀ + 2)) ((4 / 5) * γ) d r α δ_ceil,
        ‖U_steep p‖ ≤ (2 : ℝ) ^ (1 - 2 * α) * M_amp * (S.H - p.1.im) ^ (1 - 2 * α)) →
      (∀ p ∈ adConeDomain S.H x₀ m d r α (δ_star / 2) δ_ceil ∩
          adSteepDomain S.H x₀ (2 * (m + C₀ + 2)) ((4 / 5) * γ) d r α δ_ceil,
        U₀ p = U_steep p) →
      DifferentiableOn ℂ U_prev (adConeDomain S.H x₀ m d r α δ_prev δ_ceil) →
      (∀ p ∈ adConeDomain S.H x₀ m d r α (δ_star / 2) δ_ceil, U_prev p = U₀ p) →
      (∀ p ∈ adConeDomain S.H x₀ m d r α δ_prev δ_ceil, U_prev (p.1, -p.2) = U_prev p) →
      (∀ p ∈ adConeDomain S.H x₀ m d r α δ_prev δ_ceil,
        ‖U_prev p‖ ≤ M_amp * (S.H - p.1.im) ^ (1 - 2 * α)) →
      ∃ U_next : ℂ × ℂ → ℂ,
        DifferentiableOn ℂ U_next (adConeDomain S.H x₀ m d r α δ_next δ_ceil) ∧
        (∀ p ∈ adConeDomain S.H x₀ m d r α δ_prev δ_ceil, U_next p = U_prev p) ∧
        (∀ p ∈ adConeDomain S.H x₀ m d r α δ_next δ_ceil, U_next (p.1, -p.2) = U_next p) ∧
        (∀ p ∈ adConeDomain S.H x₀ m d r α δ_next δ_ceil,
          ‖U_next p‖ ≤ M_amp * (S.H - p.1.im) ^ (1 - 2 * α)) := by
    intro x₀ α d r D₀ C₀ γ m δ_star δ_ceil M_amp δ_prev δ_next U₀ U_steep U_prev
      hα1 hα2 hd_pos hr_pos hM_amp hD₀_ge hD₀_rpow hBump hPatch hm_pos hm_D₀
      hδs_pos hd_lt_δs hd_le_next hnext_lt_prev hprev_le_half hprev_le_two hceil_ge
      hU_steep_holo hU_steep_bd hU₀_steep hU_prev_holo hU_prev_U₀ hU_prev_even hU_prev_bd
    rcases hBump with ⟨hC₀_pos, hγ_pos, hγ_lt, hBump_fn⟩
    have hα_pos : 0 < α := by linarith
    let m_steep : ℝ := 2 * (m + C₀ + 2)
    let γ_steep : ℝ := (4 / 5) * γ
    let Ω_prev : Set (ℂ × ℂ) := adConeDomain S.H x₀ m d r α δ_prev δ_ceil
    let Ω_next : Set (ℂ × ℂ) := adConeDomain S.H x₀ m d r α δ_next δ_ceil
    let Ω₀ : Set (ℂ × ℂ) := adConeDomain S.H x₀ m d r α (δ_star / 2) δ_ceil
    let W_steep : Set (ℂ × ℂ) := adSteepDomain S.H x₀ m_steep γ_steep d r α δ_ceil
    have hnext_pos : 0 < δ_next := lt_of_lt_of_le hd_pos hd_le_next
    have hprev_pos : 0 < δ_prev := lt_trans hnext_pos hnext_lt_prev
    have h1d_uniq : ∀ (U_s V_s : Set ℂ) (f₁ f₂ : ℂ → ℂ) (z₀ z : ℂ),
        IsOpen U_s → Convex ℝ U_s →
        DifferentiableOn ℂ f₁ U_s → DifferentiableOn ℂ f₂ U_s →
        IsOpen V_s → z₀ ∈ U_s → z₀ ∈ V_s → z ∈ U_s →
        (∀ w ∈ V_s, f₁ w = f₂ w) → f₁ z = f₂ z := by
      intro U_s V_s f₁ f₂ z₀ z hUo hUc hf₁ hf₂ hVo hz₀U hz₀V hzU h_eq
      have hev : f₁ =ᶠ[nhds z₀] f₂ :=
        Filter.eventuallyEq_iff_exists_mem.mpr ⟨V_s, hVo.mem_nhds hz₀V, h_eq⟩
      exact (hf₁.analyticOnNhd hUo).eqOn_of_preconnected_of_eventuallyEq
        (hf₂.analyticOnNhd hUo) hUc.isPreconnected hz₀U hev hzU
    have h_slice_diff : ∀ (F_2d : ℂ × ℂ → ℂ) (W_2d : Set (ℂ × ℂ)) (U_1d : Set ℂ) (t_fix : ℂ),
        IsOpen W_2d → DifferentiableOn ℂ F_2d W_2d →
        (∀ y ∈ U_1d, (y, t_fix) ∈ W_2d) →
        DifferentiableOn ℂ (fun y => F_2d (y, t_fix)) U_1d := by
      intro F_2d W_2d U_1d t_fix hWo hFd hmem y hy
      have h1 : DifferentiableAt ℂ F_2d (y, t_fix) :=
        hFd.differentiableAt (hWo.mem_nhds (hmem y hy))
      have h2 : DifferentiableAt ℂ (fun z : ℂ => (z, t_fix)) y :=
        differentiableAt_id.prodMk (differentiableAt_const t_fix)
      have h3 : DifferentiableAt ℂ (fun z : ℂ => F_2d (z, t_fix)) y :=
        DifferentiableAt.comp y h1 h2
      exact h3.differentiableWithinAt
    have h_cone_open : ∀ δ_m : ℝ, 0 < δ_m → IsOpen (adConeDomain S.H x₀ m d r α δ_m δ_ceil) := by
      intro δ_m _
      have h1 : IsOpen { p : ℂ × ℂ | δ_m < S.H - p.1.im } :=
        isOpen_lt continuous_const (continuous_const.sub (Complex.continuous_im.comp continuous_fst))
      have h2 : IsOpen { p : ℂ × ℂ | S.H - p.1.im < δ_ceil } :=
        isOpen_lt (continuous_const.sub (Complex.continuous_im.comp continuous_fst)) continuous_const
      have h3 : IsOpen { p : ℂ × ℂ | |p.1.re - x₀| < m * (S.H - p.1.im) } :=
        isOpen_lt (continuous_abs.comp ((Complex.continuous_re.comp continuous_fst).sub continuous_const))
          (continuous_const.mul (continuous_const.sub (Complex.continuous_im.comp continuous_fst)))
      have hrpow_cont : Continuous (fun p : ℂ × ℂ => r * ((S.H - p.1.im) / d) ^ α) :=
        continuous_const.mul
          (((continuous_const.sub (Complex.continuous_im.comp continuous_fst)).div_const d).rpow_const
            (fun _ => Or.inr hα_pos.le))
      have h4 : IsOpen { p : ℂ × ℂ | ‖p.2‖ < r * ((S.H - p.1.im) / d) ^ α } :=
        isOpen_lt (continuous_norm.comp continuous_snd) hrpow_cont
      exact h1.inter (h2.inter (h3.inter h4))
    have hW_steep_open : IsOpen W_steep := by
      have h1 : IsOpen { p : ℂ × ℂ | d / 2 < S.H - p.1.im } :=
        isOpen_lt continuous_const (continuous_const.sub (Complex.continuous_im.comp continuous_fst))
      have h2 : IsOpen { p : ℂ × ℂ | S.H - p.1.im < δ_ceil } :=
        isOpen_lt (continuous_const.sub (Complex.continuous_im.comp continuous_fst)) continuous_const
      have h3 : IsOpen { p : ℂ × ℂ | |p.1.re - x₀| < m_steep * (S.H - p.1.im) } :=
        isOpen_lt (continuous_abs.comp ((Complex.continuous_re.comp continuous_fst).sub continuous_const))
          (continuous_const.mul (continuous_const.sub (Complex.continuous_im.comp continuous_fst)))
      have hrpow_cont : Continuous (fun p : ℂ × ℂ => 10 * r * ((S.H - p.1.im) / d) ^ α) :=
        continuous_const.mul
          (((continuous_const.sub (Complex.continuous_im.comp continuous_fst)).div_const d).rpow_const
            (fun _ => Or.inr hα_pos.le))
      have h4 : IsOpen { p : ℂ × ℂ | ‖p.2‖ < 10 * r * ((S.H - p.1.im) / d) ^ α } :=
        isOpen_lt (continuous_norm.comp continuous_snd) hrpow_cont
      have h5 : IsOpen { p : ℂ × ℂ | γ_steep * ‖p.2‖ < |p.2.im| } :=
        isOpen_lt (continuous_const.mul (continuous_norm.comp continuous_snd))
          (continuous_abs.comp (Complex.continuous_im.comp continuous_snd))
      exact h1.inter (h2.inter (h3.inter (h4.inter h5)))
    have hΩ_prev_open : IsOpen Ω_prev := h_cone_open δ_prev hprev_pos
    have hΩ_next_open : IsOpen Ω_next := h_cone_open δ_next hnext_pos
    have hΩ₀_open : IsOpen Ω₀ := h_cone_open (δ_star / 2) (by positivity)
    have h_gen_slice_conv : ∀ (P_c : Prop) (a_lo a_hi slope B_lim coeff : ℝ),
        0 < a_lo → 0 < coeff →
        Convex ℝ { y : ℂ |
          a_lo < S.H - y.im ∧ S.H - y.im < a_hi ∧
          |y.re - x₀| < slope * (S.H - y.im) ∧
          B_lim < coeff * ((S.H - y.im) / d) ^ α ∧ P_c } := by
      intro P_c a_lo a_hi slope B_lim coeff halo_pos hcoeff_pos y₁ hy₁ y₂ hy₂ u v hu hv huv
      rcases eq_or_lt_of_le hu with rfl | hu_pos
      · have hv1 : v = 1 := by linarith
        subst hv1; simpa using hy₂
      rcases eq_or_lt_of_le hv with rfl | hv_pos
      · have hu1 : u = 1 := by linarith
        subst hu1; simpa using hy₁
      rcases hy₁ with ⟨h1_lo, h1_hi, h1_re, h1_t, hP⟩
      rcases hy₂ with ⟨h2_lo, h2_hi, h2_re, h2_t, _⟩
      have him : (u • y₁ + v • y₂).im = u * y₁.im + v * y₂.im := by simp [Complex.real_smul]
      have hre : (u • y₁ + v • y₂).re = u * y₁.re + v * y₂.re := by simp [Complex.real_smul]
      have hdepth : S.H - (u • y₁ + v • y₂).im = u * (S.H - y₁.im) + v * (S.H - y₂.im) := by
        rw [him]
        calc S.H - (u * y₁.im + v * y₂.im) = (u + v) * S.H - (u * y₁.im + v * y₂.im) := by
              rw [huv, one_mul]
          _ = u * (S.H - y₁.im) + v * (S.H - y₂.im) := by ring
      refine ⟨?_, ?_, ?_, ?_, hP⟩
      · rw [hdepth]
        calc a_lo = (u + v) * a_lo := by rw [huv, one_mul]
          _ = u * a_lo + v * a_lo := by ring
          _ < u * (S.H - y₁.im) + v * (S.H - y₂.im) :=
              add_lt_add (mul_lt_mul_of_pos_left h1_lo hu_pos) (mul_lt_mul_of_pos_left h2_lo hv_pos)
      · rw [hdepth]
        calc u * (S.H - y₁.im) + v * (S.H - y₂.im)
            < u * a_hi + v * a_hi :=
              add_lt_add (mul_lt_mul_of_pos_left h1_hi hu_pos) (mul_lt_mul_of_pos_left h2_hi hv_pos)
          _ = (u + v) * a_hi := by ring
          _ = a_hi := by rw [huv, one_mul]
      · rw [hre, hdepth]
        have hsplit : u * y₁.re + v * y₂.re - x₀ = u * (y₁.re - x₀) + v * (y₂.re - x₀) := by
          calc u * y₁.re + v * y₂.re - x₀ = u * y₁.re + v * y₂.re - (u + v) * x₀ := by
                rw [huv, one_mul]
            _ = u * (y₁.re - x₀) + v * (y₂.re - x₀) := by ring
        rw [hsplit]
        calc |u * (y₁.re - x₀) + v * (y₂.re - x₀)|
            ≤ |u * (y₁.re - x₀)| + |v * (y₂.re - x₀)| := abs_add_le _ _
          _ = u * |y₁.re - x₀| + v * |y₂.re - x₀| := by
              rw [abs_mul, abs_mul, abs_of_pos hu_pos, abs_of_pos hv_pos]
          _ < u * (slope * (S.H - y₁.im)) + v * (slope * (S.H - y₂.im)) :=
              add_lt_add (mul_lt_mul_of_pos_left h1_re hu_pos) (mul_lt_mul_of_pos_left h2_re hv_pos)
          _ = slope * (u * (S.H - y₁.im) + v * (S.H - y₂.im)) := by ring
      · rw [hdepth]
        let δ_m : ℝ := min (S.H - y₁.im) (S.H - y₂.im)
        have hδm_pos : 0 < δ_m := lt_min (lt_trans halo_pos h1_lo) (lt_trans halo_pos h2_lo)
        have hδm_le : δ_m ≤ u * (S.H - y₁.im) + v * (S.H - y₂.im) := by
          have hle1 : δ_m ≤ S.H - y₁.im := min_le_left _ _
          have hle2 : δ_m ≤ S.H - y₂.im := min_le_right _ _
          calc δ_m = (u + v) * δ_m := by rw [huv, one_mul]
            _ = u * δ_m + v * δ_m := by ring
            _ ≤ u * (S.H - y₁.im) + v * (S.H - y₂.im) :=
                add_le_add (mul_le_mul_of_nonneg_left hle1 hu) (mul_le_mul_of_nonneg_left hle2 hv)
        have hB_lt_m : B_lim < coeff * (δ_m / d) ^ α := by
          rcases min_choice (S.H - y₁.im) (S.H - y₂.im) with hmin | hmin <;>
          · dsimp [δ_m]; rwa [hmin]
        have hrpow_le : (δ_m / d) ^ α ≤ ((u * (S.H - y₁.im) + v * (S.H - y₂.im)) / d) ^ α :=
          Real.rpow_le_rpow (by positivity)
            (div_le_div_of_nonneg_right hδm_le hd_pos.le) hα_pos.le
        exact lt_of_lt_of_le hB_lt_m (mul_le_mul_of_nonneg_left hrpow_le hcoeff_pos.le)
    have h_cone_slice_conv : ∀ (δ_m : ℝ) (t₀ : ℂ), 0 < δ_m →
        Convex ℝ { y : ℂ | (y, t₀) ∈ adConeDomain S.H x₀ m d r α δ_m δ_ceil } := by
      intro δ_m t₀ hδm_pos
      convert h_gen_slice_conv True δ_m δ_ceil m ‖t₀‖ r hδm_pos hr_pos using 1
      ext y; simp [adConeDomain]
    have hW_slice_conv : ∀ t₀ : ℂ, Convex ℝ { y : ℂ | (y, t₀) ∈ W_steep } := by
      intro t₀
      exact h_gen_slice_conv (γ_steep * ‖t₀‖ < |t₀.im|) (d / 2) δ_ceil m_steep ‖t₀‖ (10 * r)
        (by positivity) (by positivity)
    have hΩ₀_sub_prev : Ω₀ ⊆ Ω_prev := fun p hp => ⟨lt_of_le_of_lt hprev_le_half hp.1, hp.2⟩
    have h_collar_eq : ∀ p ∈ Ω_prev ∩ W_steep, U_prev p = U_steep p := by
      intro p hp
      rcases p with ⟨y₀, t₀⟩
      rcases hp with ⟨hp_prev, hp_steep⟩
      let U_s : Set ℂ := { y : ℂ | (y, t₀) ∈ Ω_prev ∩ W_steep }
      let V_s : Set ℂ := { y : ℂ | (y, t₀) ∈ Ω₀ ∩ W_steep }
      have hUs_open : IsOpen U_s :=
        (hΩ_prev_open.inter hW_steep_open).preimage (continuous_id.prodMk continuous_const)
      have hVs_open : IsOpen V_s :=
        (hΩ₀_open.inter hW_steep_open).preimage (continuous_id.prodMk continuous_const)
      have hUs_conv : Convex ℝ U_s :=
        (h_cone_slice_conv δ_prev t₀ hprev_pos).inter (hW_slice_conv t₀)
      let δ_low : ℝ := max (S.H - y₀.im) ((3 / 4) * δ_star)
      let y_low : ℂ := (y₀.re : ℂ) + ((S.H - δ_low : ℝ) : ℂ) * Complex.I
      have hy_low_im : S.H - y_low.im = δ_low := by simp [y_low]
      have hδ_low_ge1 : S.H - y₀.im ≤ δ_low := le_max_left _ _
      have hδ_low_ge2 : (3 / 4) * δ_star ≤ δ_low := le_max_right _ _
      have hδ_low_lt : δ_low < δ_ceil := by
        refine max_lt hp_prev.2.1 ?_
        have : (3 / 4) * δ_star < (D₀ + 2 * C₀ + 6) * δ_star :=
          mul_lt_mul_of_pos_right (by linarith) hδs_pos
        linarith
      have hy_low_V : y_low ∈ V_s := by
        have hre : y_low.re = y₀.re := by simp [y_low]
        have h0_pos : 0 < S.H - y₀.im := lt_trans hprev_pos hp_prev.1
        have hrpow_le : ((S.H - y₀.im) / d) ^ α ≤ (δ_low / d) ^ α :=
          Real.rpow_le_rpow (by positivity)
            (div_le_div_of_nonneg_right hδ_low_ge1 hd_pos.le) hα_pos.le
        refine ⟨⟨?_, ?_, ?_, ?_⟩, ⟨?_, ?_, ?_, ?_, hp_steep.2.2.2.2⟩⟩
        · rw [hy_low_im]; linarith
        · rw [hy_low_im]; exact hδ_low_lt
        · rw [hre, hy_low_im]
          exact lt_of_lt_of_le hp_prev.2.2.1 (mul_le_mul_of_nonneg_left hδ_low_ge1 hm_pos.le)
        · rw [hy_low_im]
          exact lt_of_lt_of_le hp_prev.2.2.2 (mul_le_mul_of_nonneg_left hrpow_le hr_pos.le)
        · rw [hy_low_im]; linarith
        · rw [hy_low_im]; exact hδ_low_lt
        · rw [hre, hy_low_im]
          have hm_st_pos : 0 < m_steep := by dsimp [m_steep]; positivity
          exact lt_of_lt_of_le hp_steep.2.2.1 (mul_le_mul_of_nonneg_left hδ_low_ge1 hm_st_pos.le)
        · rw [hy_low_im]
          exact lt_of_lt_of_le hp_steep.2.2.2.1
            (mul_le_mul_of_nonneg_left hrpow_le (by positivity))
      have hy_low_U : y_low ∈ U_s := ⟨hΩ₀_sub_prev hy_low_V.1, hy_low_V.2⟩
      have hf1_diff : DifferentiableOn ℂ (fun y => U_prev (y, t₀)) U_s :=
        h_slice_diff U_prev Ω_prev U_s t₀ hΩ_prev_open hU_prev_holo (fun _ hy => hy.1)
      have hf2_diff : DifferentiableOn ℂ (fun y => U_steep (y, t₀)) U_s :=
        h_slice_diff U_steep W_steep U_s t₀ hW_steep_open hU_steep_holo (fun _ hy => hy.2)
      exact h1d_uniq U_s V_s (fun y => U_prev (y, t₀)) (fun y => U_steep (y, t₀)) y_low y₀
        hUs_open hUs_conv hf1_diff hf2_diff hVs_open hy_low_U hy_low_V ⟨hp_prev, hp_steep⟩
        (fun w hw => (hU_prev_U₀ (w, t₀) hw.1).trans (hU₀_steep (w, t₀) hw))
    let V_comb : Set (ℂ × ℂ) := Ω_prev ∪ W_steep
    have hV_comb_open : IsOpen V_comb := hΩ_prev_open.union hW_steep_open
    let U_comb : ℂ × ℂ → ℂ := fun p => if p ∈ Ω_prev then U_prev p else U_steep p
    have hU_comb_prev : ∀ p ∈ Ω_prev, U_comb p = U_prev p := fun p hp => by simp [U_comb, hp]
    have hU_comb_steep : ∀ p ∈ W_steep, U_comb p = U_steep p := by
      intro p hp
      by_cases h : p ∈ Ω_prev
      · simp only [U_comb, h, ↓reduceIte]; exact h_collar_eq p ⟨h, hp⟩
      · simp [U_comb, h]
    have hU_comb_holo : DifferentiableOn ℂ U_comb V_comb := by
      intro p hp
      apply DifferentiableAt.differentiableWithinAt
      rcases hp with hp | hp
      · exact (hU_prev_holo.differentiableAt (hΩ_prev_open.mem_nhds hp)).congr_of_eventuallyEq
          (Filter.eventuallyEq_iff_exists_mem.mpr ⟨Ω_prev, hΩ_prev_open.mem_nhds hp, hU_comb_prev⟩)
      · exact (hU_steep_holo.differentiableAt (hW_steep_open.mem_nhds hp)).congr_of_eventuallyEq
          (Filter.eventuallyEq_iff_exists_mem.mpr ⟨W_steep, hW_steep_open.mem_nhds hp, hU_comb_steep⟩)
    let IsActive : ℂ × ℂ → Prop := fun p => p ∈ Ω_next ∧ S.H - p.1.im < (3 / 2) * δ_prev
    let δ_h_fn : ℂ × ℂ → ℝ := fun p => S.H - p.1.im
    let R_fn : ℂ × ℂ → ℝ := fun p => r * (δ_h_fn p / d) ^ α
    let σ_fn : ℂ × ℂ → ℝ := fun p => (D₀ + C₀ + 2) * δ_h_fn p
    let μy_fn : ℂ × ℂ → ℝ := fun p => (1 / 20) * min (δ_h_fn p) (δ_h_fn p - δ_next)
    let μt_fn : ℂ × ℂ → ℝ := fun p => min ((R_fn p - ‖p.2‖) / 2) (γ * R_fn p / 20)
    let W_rect : ℂ × ℂ → Set ℂ := fun p =>
      { y : ℂ |
        |y.re - p.1.re| < μy_fn p ∧
        p.1.im - σ_fn p - μy_fn p < y.im ∧
        y.im < p.1.im + μy_fn p }
    let S_rect : ℂ × ℂ → Set ℂ := fun p =>
      { y : ℂ |
        |y.re - p.1.re| < μy_fn p ∧
        p.1.im - σ_fn p - μy_fn p < y.im ∧
        y.im < p.1.im - σ_fn p + μy_fn p }
    let P_box : ℂ × ℂ → Set (ℂ × ℂ) := fun p => W_rect p ×ˢ Metric.ball p.2 (μt_fn p)
    have h_rect_open_conv : ∀ a xr y_lo y_hi : ℝ, 0 < a →
        IsOpen { y : ℂ | |y.re - xr| < a ∧ y_lo < y.im ∧ y.im < y_hi } ∧
        Convex ℝ { y : ℂ | |y.re - xr| < a ∧ y_lo < y.im ∧ y.im < y_hi } := by
      intro a xr y_lo y_hi _
      constructor
      · exact (isOpen_lt (continuous_abs.comp (Complex.continuous_re.sub continuous_const))
          continuous_const).inter
          ((isOpen_lt continuous_const Complex.continuous_im).inter
            (isOpen_lt Complex.continuous_im continuous_const))
      · intro y₁ hy₁ y₂ hy₂ u v hu hv huv
        rcases eq_or_lt_of_le hu with rfl | hu_pos
        · have hv1 : v = 1 := by linarith
          subst hv1; simpa using hy₂
        rcases eq_or_lt_of_le hv with rfl | hv_pos
        · have hu1 : u = 1 := by linarith
