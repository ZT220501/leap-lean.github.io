      rw [Metric.mem_ball, dist_eq_norm] at hz
      have hz_2rZ : ‖z - z₀‖ < 2 * r_Z := lt_of_lt_of_le hz hr₁_le_2rZ
      obtain ⟨hz_pos, hz_lt⟩ := hz_ball_punc z hz_2rZ
      have hz_δ₀ : ‖z‖ < G.δ₀ := lt_of_lt_of_le hz_lt S.δ₁_le
      have hD0 : G.D_ZW (z, 0) ≠ 0 := G.D_ZW_slice_ne_zero z hz_pos hz_δ₀
      dsimp only [Δ, X_W, v]
      rw [G.slice_W_eq z hz_pos hz_δ₀, mul_div_cancel_right₀ _ hD0, hv_zero z hz_2rZ, sub_self]
    have hΔ_iterY0 : ∀ (α : ℕ), ∀ z ∈ Metric.ball z₀ r₁, iterDerivY α Δ (z, 0) = 0 := by
      intro α
      induction α with
      | zero => exact hΔ_slice0
      | succ α ih =>
