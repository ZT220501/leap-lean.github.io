              simp [hm0, hne]
        | succ n ih => rw [pow_succ, pow_succ, hπ_mul, ih]
      have hπ1_X0 : π 1 (MvPowerSeries.X 0) = 0 := by
        ext m
        rw [PowerSeries.coeff_mk, MvPowerSeries.coeff_X, map_zero]
