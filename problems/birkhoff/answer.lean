          simpa [dist_eq_norm] using hh_norm n
        have hc0 : ContinuousOn (fun μ : ℝ => Φ μ p₀) I_cc :=
          hΦ_cont.comp (continuous_id.prodMk continuous_const).continuousOn (fun μ hμ => ⟨hμ, hp₀⟩)
        have hc1 : ContinuousOn (fun μ : ℝ => Φ μ (p₀.1 + h_seq n, p₀.2)) I_cc :=
          hΦ_cont.comp (continuous_id.prodMk continuous_const).continuousOn
            (fun μ hμ => ⟨hμ, hp1_out⟩)
        have hc2 : ContinuousOn (fun μ : ℝ => Φ μ (p₀.1, p₀.2 + h_seq n)) I_cc :=
          hΦ_cont.comp (continuous_id.prodMk continuous_const).continuousOn
            (fun μ hμ => ⟨hμ, hp2_out⟩)
        have hcg : ContinuousOn (g_seq n) I_cc :=
          ((continuousOn_const.mul (hc1.sub hc0)).smul continuousOn_const).add
            ((continuousOn_const.mul (hc2.sub hc0)).smul continuousOn_const)
        exact (hcg.aestronglyMeasurable measurableSet_uIcc).mono_measure hμ_le
      have hg_lim : ∀ μ ∈ I_cc,
          Filter.Tendsto (fun n => g_seq n μ) Filter.atTop (nhds (fderiv ℂ (Φ μ) p₀)) := by
        intro μ hμ
        have hfderiv_p₀ : HasFDerivAt (Φ μ) (fderiv ℂ (Φ μ) p₀) p₀ :=
          ((hΦ_holo μ hμ).differentiableAt (hW_out_open.mem_nhds hp₀)).hasFDerivAt
        have hd1 : HasDerivAt (fun z : ℂ => Φ μ (p₀.1 + z, p₀.2))
            (fderiv ℂ (Φ μ) p₀ (1, 0)) 0 := by
          have hin : HasDerivAt (fun z : ℂ => (p₀.1 + z, p₀.2)) ((1 : ℂ), (0 : ℂ)) 0 := by
