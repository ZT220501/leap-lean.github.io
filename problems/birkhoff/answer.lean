            (PowerSeries.coeff l) (A (n + r + 1) * (-Δ) ^ r) * ((n : ℂ) + 1)
          = (1 / (((n + 1).factorial : ℂ) * (r.factorial : ℂ)) * ((n : ℂ) + 1)) *
              (PowerSeries.coeff l) (A (n + r + 1) * (-Δ) ^ r) := by ring
        _ = 1 / ((n.factorial : ℂ) * (r.factorial : ℂ)) *
              (PowerSeries.coeff l) (A (n + r + 1) * (-Δ) ^ r) := by rw [h_fac]
    have h_jet_zero_shift : ∀ (A : ℕ → PowerSeries ℂ),
