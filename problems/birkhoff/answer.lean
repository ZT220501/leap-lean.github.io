    normAction_conj := A.normAction_conj
    normAction2_eq_neg_swap := A.normAction2_eq_neg_swap
    deriv_normAction1_right := A.deriv_normAction1_right
    deriv_normAction2_left := A.deriv_normAction2_left
    normAction_real_stationary_iff := A.normAction_real_stationary_iff
    normAction_bound := A.normAction_bound
    residual_and_linCoeff_ne_zero := O.residual_and_linCoeff_ne_zero
    enlarged_holo_and_bounds := O.enlarged_holo_and_bounds
