    have hk_not_F : k ∉ F := fun hkF => hk_not (Finset.mem_union_right I hkF)
    have hk_sdiff : k ∈ Finset.univ \ I := Finset.mem_sdiff.mpr ⟨Finset.mem_univ k, hk_not_I⟩
    exact le_of_not_gt fun hgt => hk_not_F (Finset.mem_filter.mpr ⟨hk_sdiff, hgt⟩)
  have hV_on_F : ∀ j ∈ F,
      ‖jacobiVDiag P.N S.c (fun i => sliceSpeedSeq S P.N i.val y) (fun i => P.d0 i y) j‖ ≤
