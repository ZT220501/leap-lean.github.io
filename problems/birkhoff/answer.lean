        rw [h_fac, abs_mul,
          abs_of_nonneg (by positivity :
            0 ≤ u₁ ^ 4 + u₁ ^ 3 * u₂ + u₁ ^ 2 * u₂ ^ 2 + u₁ * u₂ ^ 3 + u₂ ^ 4)]
        have h_deg4 :
            u₁ ^ 4 + u₁ ^ 3 * u₂ + u₁ ^ 2 * u₂ ^ 2 + u₁ * u₂ ^ 3 + u₂ ^ 4 ≤
