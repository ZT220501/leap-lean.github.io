        rintro A₁ B₁ A₂ B₂ c₁ c₂ ⟨hA₁, hB₁, Ψ₁, hΨ₁, he₁⟩ ⟨hA₂, hB₂, Ψ₂, hΨ₂, he₂⟩
        have hDB₁ : DifferentiableOn ℂ (dslope B₁ 0) U₀ :=
