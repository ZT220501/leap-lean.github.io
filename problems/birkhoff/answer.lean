              have him_z : (z + ((n : ℤ) : ℂ) * (2 * (Real.pi : ℂ))).im = z.im := by simp
              have him_t : |t.im| ≤ 2 * r_t := (Complex.abs_im_le_norm t).trans ht.le
              rw [him_z]; linarith
            have hsplit : z + (((n : ℤ) + 1 : ℤ) : ℂ) * (2 * (Real.pi : ℂ)) =
                (z + ((n : ℤ) : ℂ) * (2 * (Real.pi : ℂ))) + 2 * Real.pi := by push_cast; ring
            rw [hsplit, hF_per _ t hzn_mem, ihn z hz]
        | pred n ihn =>
            intro z hz
            have hzn_mem : (z + ((-(n : ℤ) - 1 : ℤ) : ℂ) * (2 * (Real.pi : ℂ)), t) ∈
                glancingDomain 1 s d := by
              refine ⟨ht.trans h2r_lt_d, ?_⟩
              have him_z : (z + ((-(n : ℤ) - 1 : ℤ) : ℂ) * (2 * (Real.pi : ℂ))).im = z.im := by simp
              have him_t : |t.im| ≤ 2 * r_t := (Complex.abs_im_le_norm t).trans ht.le
              rw [him_z]; linarith
            have h1 := hF_per _ t hzn_mem
            have hsplit : (z + ((-(n : ℤ) - 1 : ℤ) : ℂ) * (2 * (Real.pi : ℂ))) + 2 * Real.pi =
                z + ((-(n : ℤ)) : ℂ) * (2 * (Real.pi : ℂ)) := by push_cast; ring
            rw [hsplit, ← Int.cast_neg, ihn z hz] at h1
            exact h1.symm
      have hy_eq : y = y₀ + (k : ℂ) * (2 * (Real.pi : ℂ)) := by dsimp [y₀]; push_cast; ring
      have hy₀_im_lt : |y₀.im| < s_mid := by rw [hy₀_im]; exact hy
      have hp₀_K : (y₀, t) ∈ K := ⟨hy₀_re, hy₀_im_lt.le, ht.le⟩
      rw [hy_eq, hF_shift k y₀ hy₀_im_lt]
      have hle : ‖F (y₀, t)‖ ≤ ‖F p_max‖ := hp_max hp₀_K
      linarith
    have hExtract_cj : ∀ (s s_mid d M_prev : ℝ) (j : ℕ) (F : ℂ × ℂ → ℂ),
        0 < s_mid → s_mid < s → 0 < d → 0 < M_prev → 1 ≤ j →
        DifferentiableOn ℂ F (glancingDomain 1 s d) →
        (∀ y t : ℂ, (y, t) ∈ glancingDomain 1 s d →
          F (y + 2 * Real.pi, t) = F (y, t) ∧
          F (y, -t) = F (y, t) ∧
          F (starRingEnd ℂ y, starRingEnd ℂ t) = starRingEnd ℂ (F (y, t))) →
        (∀ t : ℂ, ‖t‖ < d → (∫ x in (0 : ℝ)..(2 * Real.pi), F (x, t)) = 0) →
        (∀ p ∈ glancingDomain 1 s d, ‖F p‖ ≤ M_prev * ‖p.2‖ ^ (2 * j)) →
        ∃ (r_t C_rem : ℝ) (c_j : ℂ → ℂ),
          0 < r_t ∧ r_t ≤ d / 4 ∧ 0 < C_rem ∧
          DifferentiableOn ℂ c_j (horizStrip s_mid) ∧
          (∀ y ∈ horizStrip s_mid, c_j (y + 2 * Real.pi) = c_j y) ∧
          (∀ y ∈ horizStrip s_mid, c_j (starRingEnd ℂ y) = starRingEnd ℂ (c_j y)) ∧
