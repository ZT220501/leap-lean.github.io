      have hW_sub : { ζ : ℂ | ‖ζ‖ ≤ t₀ ∧ 0 ≤ ζ.im } ⊆ W_conv := by
        intro ζ ⟨hnorm, him⟩
        refine ⟨?_, ?_⟩
        · rw [Metric.mem_ball, dist_zero_right]
