        PculUnifBdd φ D (fun τ e => ∑ j ∈ s, A j τ e) (fun e => ∑ j ∈ s, A₀ j e) := by
      intro ι s A A₀ hs
      classical
      induction s using Finset.induction_on with
      | empty => simpa using u_const 0
      | @insert j s hj ih =>
          have h1 := hs j (Finset.mem_insert_self j s)
          have h2 := ih fun i hi => hs i (Finset.mem_insert_of_mem hi)
