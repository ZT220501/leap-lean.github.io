      have haff : γ (a • z₁ + b • z₂) = a • γ z₁ + b • γ z₂ := by
        have habC : (a : ℂ) + (b : ℂ) = 1 := by exact_mod_cast hab
        have hbC : (b : ℂ) = 1 - (a : ℂ) := eq_sub_of_add_eq' habC
