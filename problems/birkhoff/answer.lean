      field_simp [hq_nz]
    rw [h_lhs, h_rhs] at h_mul
    have h_coef : 8 / 5 * K_step ≤ C_tot := by
      dsimp [C_tot]; linarith
    have h_div : (8 / 5 * K_step) / (q : ℝ) ^ 3 ≤ C_tot / (q : ℝ) ^ 3 :=
      div_le_div_of_nonneg_right h_coef (by positivity)
    exact le_trans h_mul (mul_le_mul_of_nonneg_right h_div hM_nonneg)
  have hM_contr : M ≤ (1 / 2) * M := by
    have hε_nonneg : 0 ≤ (C_tot / (q : ℝ) ^ 3) * M :=
      mul_nonneg (div_nonneg (le_of_lt hC_tot_pos) (by positivity)) hM_nonneg
    have h1 := h_poincare ((C_tot / (q : ℝ) ^ 3) * M) hε_nonneg h_sec_diff_bnd
    have h_alg : (q : ℝ) * ((C_tot / (q : ℝ) ^ 3) * M) = (C_tot / (q : ℝ) ^ 2) * M := by
      field_simp [hq_nz]
    rw [h_alg] at h1
    have h_half : C_tot / (q : ℝ) ^ 2 ≤ 1 / 2 :=
      (div_le_iff₀ hq2_pos).mpr (by linarith)
    exact le_trans h1 (mul_le_mul_of_nonneg_right h_half hM_nonneg)
  have hM_zero : M = 0 := by linarith
  have hδ_zero : ∀ r : ℕ, r < q → δ r = 0 := by
    intro r hr
    have hle : |δ r| ≤ 0 := by
      have := hδ_le_M r hr
      linarith
    exact abs_nonpos_iff.mp hle
  funext j
  by_cases hj : j ≤ q
  · have h_zero : u j = 0 := by
      rw [← hu_sum j]
      apply Finset.sum_eq_zero
      intro r hr
      exact hδ_zero r (lt_of_lt_of_le (Finset.mem_range.mp hr) hj)
    exact sub_eq_zero.mp h_zero
  · have hj_gt : q < j := by omega
    rw [hX₁_tail j hj_gt, hX₂_tail j hj_gt]

theorem real_jet_and_candidate_uniqueness (m : ℕ) (M₁ : ℝ)
    (hm : 2 ≤ m) (hM₁ : 0 < M₁) :
    Nonempty (RealJetAndUniquenessData m M₁) :=
by
  obtain ⟨H_base⟩ := real_primPhi_and_action_taylor m M₁ hm hM₁
  obtain ⟨H_mid⟩ := real_midpoint_disp_jet_bounds m M₁ hm hM₁ H_base
  obtain ⟨H_jet⟩ := real_action_jet_comp_bounds m M₁ hm hM₁ H_base H_mid
  obtain ⟨N_uniq, hN_uniq, hCandUniq⟩ :=
    real_candidate_mesh_uniqueness m M₁ hm hM₁ H_base H_jet
  let N_jet_R : ℕ := max (max H_mid.N_mid H_jet.N_jet) N_uniq
  refine ⟨{
    C_mid_R := H_mid.C_mid_R
    C_jet_R := H_jet.C_jet_R
    N_jet_R := N_jet_R
    C_mid_R_pos := H_mid.C_mid_R_pos
    C_jet_R_pos := H_jet.C_jet_R_pos
    N_jet_R_ge_four := le_trans hN_uniq (le_max_right _ _)
    a_R := realJetA
    b_R := realJetB
    action_factor := fun w hw X T _ => H_base.action_factor w hw X T
    candidate_unique := fun q w hq hw x X₁ X₂ hX₁ hX₂ =>
      hCandUniq q w (le_trans (le_max_right _ _) hq) hw x X₁ X₂ hX₁ hX₂
    midpoint_props := ?_
    jet_props := fun q ρ sgn w e_X τ_T hq hsgn hw he hτ =>
      H_jet.jet_props q ρ sgn w e_X τ_T
        (le_trans (le_trans (le_max_right _ _) (le_max_left _ _)) hq) hsgn hw he hτ
    midpoint_lip := ?_
    jet_lip := fun q ρ sgn Δe Δτ w₁ w₂ e_X₁ τ_T₁ e_X₂ τ_T₂ hq hsgn hΔe hΔτ
        hw₁ hw₂ he₁ hτ₁ he₂ hτ₂ hde hdτ =>
      H_jet.jet_lip q ρ sgn Δe Δτ w₁ w₂ e_X₁ τ_T₁ e_X₂ τ_T₂
        (le_trans (le_trans (le_max_right _ _) (le_max_left _ _)) hq)
        hsgn hΔe hΔτ hw₁ hw₂ he₁ hτ₁ he₂ hτ₂ hde hdτ
  }⟩
  · intro q ρ w e_X τ_T hq hw he hτ
    dsimp only
    have hq_mid : H_mid.N_mid ≤ q :=
      le_trans (le_trans (le_max_left _ _) (le_max_left _ _)) hq
    have hc_T : |2 * Real.pi / (q : ℝ)| ≤ 2 * Real.pi / (q : ℝ) := by
      rw [abs_of_nonneg (by positivity)]
    have hMid := (H_mid.midpoint_u_props q ρ (2 * Real.pi / (q : ℝ)) w e_X τ_T
      hq_mid hc_T hw he hτ).2 1 ⟨zero_le_one, le_rfl⟩
    have hEq :
        realMidpointDispU w (fun x => x + ρ + e_X x)
          (fun x => 2 * Real.pi / (q : ℝ) + τ_T x) 1 =
        fun x => midpoint_ℝ w (x + ρ + e_X x)
          ((x + ρ + e_X x) + (2 * Real.pi / (q : ℝ) + τ_T x)) -
          ((x + ρ + e_X x) + (2 * Real.pi / (q : ℝ) + τ_T x) / 2) := by
      funext x
      simp [realMidpointDispU]
    rwa [hEq] at hMid
  · intro q ρ Δe Δτ w₁ w₂ e_X₁ τ_T₁ e_X₂ τ_T₂ hq hΔe hΔτ hw₁ hw₂ he₁ hτ₁ he₂ hτ₂ hde hdτ
    dsimp only
    intro k hk x
    have hq_mid : H_mid.N_mid ≤ q :=
      le_trans (le_trans (le_max_left _ _) (le_max_left _ _)) hq
    have hc_T : |2 * Real.pi / (q : ℝ)| ≤ 2 * Real.pi / (q : ℝ) := by
      rw [abs_of_nonneg (by positivity)]
    have hLip := H_mid.midpoint_u_lip q ρ (2 * Real.pi / (q : ℝ)) Δe Δτ 1
      w₁ w₂ e_X₁ τ_T₁ e_X₂ τ_T₂ hq_mid hc_T ⟨zero_le_one, le_rfl⟩
      hΔe hΔτ hw₁ hw₂ he₁ hτ₁ he₂ hτ₂ hde hdτ k hk x
    have hEq :
        (fun y =>
          realMidpointDispU w₁ (fun x => x + ρ + e_X₁ x)
            (fun x => 2 * Real.pi / (q : ℝ) + τ_T₁ x) 1 y -
          realMidpointDispU w₂ (fun x => x + ρ + e_X₂ x)
            (fun x => 2 * Real.pi / (q : ℝ) + τ_T₂ x) 1 y) =
        (fun y =>
          (midpoint_ℝ w₁ (y + ρ + e_X₁ y)
            ((y + ρ + e_X₁ y) + (2 * Real.pi / (q : ℝ) + τ_T₁ y)) -
            ((y + ρ + e_X₁ y) + (2 * Real.pi / (q : ℝ) + τ_T₁ y) / 2)) -
          (midpoint_ℝ w₂ (y + ρ + e_X₂ y)
            ((y + ρ + e_X₂ y) + (2 * Real.pi / (q : ℝ) + τ_T₂ y)) -
            ((y + ρ + e_X₂ y) + (2 * Real.pi / (q : ℝ) + τ_T₂ y) / 2))) := by
      funext y
      simp [realMidpointDispU]
    rwa [hEq] at hLip

theorem strip_calculus_and_containment : StripCalculusToolkit :=
by
  have hOpen : ∀ H : ℝ, IsOpen (horizStrip H) := fun H =>
    isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const
  have deriv_conj_strip : ∀ (σ : ℝ) (f : ℂ → ℂ),
      DifferentiableOn ℂ f (horizStrip σ) →
      (∀ z ∈ horizStrip σ, f (starRingEnd ℂ z) = starRingEnd ℂ (f z)) →
      ∀ z ∈ horizStrip σ, deriv f (starRingEnd ℂ z) = starRingEnd ℂ (deriv f z) := by
    intro σ f hf_holo hf_conj z hz
    have hconj_mem : ∀ {w : ℂ}, w ∈ horizStrip σ → starRingEnd ℂ w ∈ horizStrip σ := by
      intro w hw
      change |(starRingEnd ℂ w).im| < σ
      change |w.im| < σ at hw
      simpa [Complex.conj_im, abs_neg] using hw
    have hda : HasDerivAt f (deriv f z) z :=
      (hf_holo.differentiableAt ((hOpen σ).mem_nhds hz)).hasDerivAt
    have hda_conj : HasDerivAt f (starRingEnd ℂ (deriv f z)) (starRingEnd ℂ z) := by
      rw [hasDerivAt_iff_tendsto_slope_zero]
      have hconj_tendsto : Filter.Tendsto (starRingEnd ℂ)
          (nhdsWithin (0 : ℂ) {(0 : ℂ)}ᶜ) (nhdsWithin (0 : ℂ) {(0 : ℂ)}ᶜ) := by
        rw [tendsto_nhdsWithin_iff]
        refine ⟨?_, ?_⟩
        · simpa only [map_zero] using
            (Complex.continuous_conj.tendsto (0 : ℂ)).mono_left nhdsWithin_le_nhds
        · filter_upwards [self_mem_nhdsWithin] with h hh
          simp only [Set.mem_compl_iff, Set.mem_singleton_iff] at hh ⊢
          exact (map_ne_zero (starRingEnd ℂ)).mpr hh
      have h_lim := (Complex.continuous_conj.tendsto (deriv f z)).comp
        ((hasDerivAt_iff_tendsto_slope_zero.mp hda).comp hconj_tendsto)
      refine h_lim.congr' ?_
      have hnhds : {h : ℂ | starRingEnd ℂ z + h ∈ horizStrip σ} ∈
          nhdsWithin (0 : ℂ) {(0 : ℂ)}ᶜ := by
        apply nhdsWithin_le_nhds
        have hcont : Continuous (fun h : ℂ => starRingEnd ℂ z + h) :=
          continuous_const.add continuous_id
        exact hcont.continuousAt.preimage_mem_nhds
          ((hOpen σ).mem_nhds (by simpa using hconj_mem hz))
      filter_upwards [hnhds] with h hh
      dsimp only [Function.comp_def]
      have hz_add : z + starRingEnd ℂ h ∈ horizStrip σ := by
        have h1 := hconj_mem hh
        simpa only [map_add, Complex.conj_conj] using h1
      have hf1 : f (starRingEnd ℂ z + h) = starRingEnd ℂ (f (z + starRingEnd ℂ h)) := by
        have h2 := hf_conj (z + starRingEnd ℂ h) hz_add
        simpa only [map_add, Complex.conj_conj] using h2
      rw [smul_eq_mul, smul_eq_mul, map_mul, map_inv₀, Complex.conj_conj, map_sub,
        hf1, hf_conj z hz]
    exact hda_conj.deriv
  have hConv : ∀ H : ℝ, Convex ℝ (horizStrip H) := by
    intro H
    have hEq : horizStrip H = Complex.imLm ⁻¹' Set.Ioo (-H) H := by
      ext s
      change |s.im| < H ↔ -H < s.im ∧ s.im < H
      exact abs_lt
    rw [hEq]
    exact (convex_Ioo (-H) H).linear_preimage Complex.imLm
  have hRealMem : ∀ {H : ℝ}, 0 < H → ∀ r : ℝ, (r : ℂ) ∈ horizStrip H := by
    intro H hH r
    change |(r : ℂ).im| < H
    simpa [Complex.ofReal_im] using hH
  have hContDiffAt : ∀ {H : ℝ} {f : ℂ → ℂ},
      DifferentiableOn ℂ f (horizStrip H) →
      ∀ {z : ℂ}, z ∈ horizStrip H → ∀ k : ℕ, ContDiffAt ℂ (k : WithTop ℕ∞) f z := by
    intro H f hf z hz k
    exact ((hf.contDiffOn (hOpen H)).contDiffAt ((hOpen H).mem_nhds hz)).of_le le_top
  
  have h_vert_strip_maps_to : ∀ (σ σ' α ρ : ℝ) (e : ℂ → ℂ),
      0 < σ → 0 < σ' → 0 ≤ α → σ' ≤ (1 - 2 * α) * σ →
      DifferentiableOn ℂ e (horizStrip σ') →
      (∀ z ∈ horizStrip σ', e (starRingEnd ℂ z) = starRingEnd ℂ (e z)) →
      (∀ z ∈ horizStrip σ', ‖deriv e z‖ ≤ α) →
      ∀ z ∈ horizStrip σ', z + (ρ : ℂ) + e z ∈ horizStrip σ := by
    intro σ σ' α ρ e hσ hσ' hα hσ'_le he_holo he_conj he_deriv z hz
    let x : ℂ := (z.re : ℂ)
    have hx : x ∈ horizStrip σ' := hRealMem hσ' z.re
    have hex_im : (e x).im = 0 := by
      have h1 := he_conj x hx
      rw [Complex.conj_ofReal] at h1
      exact Complex.conj_eq_iff_im.mp h1.symm
    have hDiffAt : ∀ w ∈ horizStrip σ', DifferentiableAt ℂ e w :=
      fun w hw => he_holo.differentiableAt ((hOpen σ').mem_nhds hw)
    have hMVT : ‖e z - e x‖ ≤ α * ‖z - x‖ :=
      Convex.norm_image_sub_le_of_norm_deriv_le (𝕜 := ℂ) hDiffAt he_deriv (hConv σ') hx hz
    have hzx : z - x = (z.im : ℂ) * Complex.I := by
      dsimp [x]
      have hre := Complex.re_add_im z
      linear_combination -hre
    have hzx_norm : ‖z - x‖ = |z.im| := by
      rw [hzx, norm_mul, Complex.norm_real, Real.norm_eq_abs, Complex.norm_I, mul_one]
    rw [hzx_norm] at hMVT
    have him_eq : (z + (ρ : ℂ) + e z).im = z.im + (e z - e x).im := by
      simp [Complex.add_im, Complex.sub_im, Complex.ofReal_im, hex_im]
    have him_le : |(z + (ρ : ℂ) + e z).im| ≤ (1 + α) * |z.im| := by
      rw [him_eq]
      calc
        |z.im + (e z - e x).im| ≤ |z.im| + |(e z - e x).im| := abs_add_le _ _
        _ ≤ |z.im| + ‖e z - e x‖ := add_le_add le_rfl (Complex.abs_im_le_norm _)
        _ ≤ |z.im| + α * |z.im| := add_le_add le_rfl hMVT
        _ = (1 + α) * |z.im| := by ring
    change |(z + (ρ : ℂ) + e z).im| < σ
    have hz' : |z.im| < σ' := hz
    have h1 : (1 + α) * |z.im| < (1 + α) * σ' :=
      mul_lt_mul_of_pos_left hz' (by linarith)
    have h2 : (1 + α) * σ' ≤ (1 + α) * ((1 - 2 * α) * σ) :=
      mul_le_mul_of_nonneg_left hσ'_le (by linarith)
    have h3 : (1 + α) * ((1 - 2 * α) * σ) ≤ σ := by nlinarith [sq_nonneg α]
    exact lt_of_le_of_lt him_le (lt_of_lt_of_le h1 (le_trans h2 h3))
  
  have hIterHoloPerConj : ∀ (σ : ℝ) (W : ℂ → ℂ),
      DifferentiableOn ℂ W (horizStrip σ) →
      (∀ ζ ∈ horizStrip σ, W (ζ + 2 * Real.pi) = W ζ) →
      (∀ ζ ∈ horizStrip σ, W (starRingEnd ℂ ζ) = starRingEnd ℂ (W ζ)) →
      ∀ n : ℕ,
        DifferentiableOn ℂ (iteratedDeriv n W) (horizStrip σ) ∧
        (∀ ζ ∈ horizStrip σ, iteratedDeriv n W (ζ + 2 * Real.pi) = iteratedDeriv n W ζ) ∧
        (∀ ζ ∈ horizStrip σ,
          iteratedDeriv n W (starRingEnd ℂ ζ) = starRingEnd ℂ (iteratedDeriv n W ζ)) := by
    intro σ W hW_holo hW_per hW_conj n
    induction n with
    | zero =>
      simp only [iteratedDeriv_zero]
      exact ⟨hW_holo, hW_per, hW_conj⟩
    | succ n ih =>
      rw [iteratedDeriv_succ]
      refine ⟨ih.1.deriv (hOpen σ), ?_, deriv_conj_strip σ _ ih.1 ih.2.2⟩
      intro ζ hζ
      have h_ev : (fun z : ℂ => iteratedDeriv n W (z + 2 * (Real.pi : ℂ))) =ᶠ[nhds ζ]
          iteratedDeriv n W :=
        Filter.eventuallyEq_of_mem ((hOpen σ).mem_nhds hζ) ih.2.1
      calc
        deriv (iteratedDeriv n W) (ζ + 2 * (Real.pi : ℂ))
            = deriv (fun z : ℂ => iteratedDeriv n W (z + 2 * (Real.pi : ℂ))) ζ := by
              simpa using (deriv_comp_add_const (iteratedDeriv n W) (2 * (Real.pi : ℂ)) ζ).symm
        _ = deriv (iteratedDeriv n W) ζ := h_ev.deriv_eq
  
  have h_stripExt_iteratedDeriv_props :
      ∀ (r₀ d : ℕ) (σ M₁ : ℝ) (w : ℝ → ℝ) (W : ℂ → ℂ),
        IsBoundedStripExt r₀ σ M₁ w W →
        d ≤ r₀ →
        DifferentiableOn ℂ (iteratedDeriv d W) (horizStrip σ) ∧
        (∀ ζ ∈ horizStrip σ, iteratedDeriv d W (ζ + 2 * Real.pi) = iteratedDeriv d W ζ) ∧
        (∀ ζ ∈ horizStrip σ,
          iteratedDeriv d W (starRingEnd ℂ ζ) = starRingEnd ℂ (iteratedDeriv d W ζ)) ∧
        (∀ j : ℕ, j + d ≤ r₀ → ∀ ζ ∈ horizStrip σ,
          ‖iteratedDeriv j (iteratedDeriv d W) ζ‖ ≤ M₁) := by
    intro r₀ d σ M₁ w W hW _hd
    obtain ⟨h1, h2, h3⟩ := hIterHoloPerConj σ W hW.1 hW.2.2.1 hW.2.2.2.1 d
    refine ⟨h1, h2, h3, ?_⟩
    intro j hjd ζ hζ
    rw [iteratedDeriv_eq_iterate, iteratedDeriv_eq_iterate, ← Function.iterate_add_apply,
      ← iteratedDeriv_eq_iterate]
    exact hW.2.2.2.2 (j + d) hjd ζ hζ
  
  have h_stripDiffSup_nonneg_and_le :
      ∀ (r₀ : ℕ) (σ M₁ : ℝ) (w₁ w₂ : ℝ → ℝ) (W₁ W₂ : ℂ → ℂ),
        0 < σ →
        IsBoundedStripExt r₀ σ M₁ w₁ W₁ →
        IsBoundedStripExt r₀ σ M₁ w₂ W₂ →
        0 ≤ stripDiffSup r₀ σ W₁ W₂ ∧
        ∀ (j d : ℕ), j + d ≤ r₀ → ∀ ζ ∈ horizStrip σ,
          ‖iteratedDeriv j (fun z => iteratedDeriv d W₁ z - iteratedDeriv d W₂ z) ζ‖ ≤
            stripDiffSup r₀ σ W₁ W₂ := by
    intro r₀ σ M₁ w₁ w₂ W₁ W₂ _hσ hW₁ hW₂
    have hSubDeriv : ∀ (k : ℕ) {z : ℂ}, z ∈ horizStrip σ →
        iteratedDeriv k (W₁ - W₂) z = iteratedDeriv k W₁ z - iteratedDeriv k W₂ z := by
      intro k z hz
      exact iteratedDeriv_sub (hContDiffAt hW₁.1 hz k) (hContDiffAt hW₂.1 hz k)
    refine ⟨?_, ?_⟩
    · apply Real.sSup_nonneg
      rintro r ⟨k, _, ζ, _, rfl⟩
      exact norm_nonneg _
    · have hBdd : BddAbove { r : ℝ | ∃ k ≤ r₀, ∃ ζ ∈ horizStrip σ,
          r = ‖iteratedDeriv k (W₁ - W₂) ζ‖ } := by
        refine ⟨M₁ + M₁, ?_⟩
        rintro r ⟨k, hk, ζ, hζ, rfl⟩
        rw [hSubDeriv k hζ]
        exact (norm_sub_le _ _).trans
          (add_le_add (hW₁.2.2.2.2 k hk ζ hζ) (hW₂.2.2.2.2 k hk ζ hζ))
      intro j d hjd ζ hζ
      have h_ev : (fun z : ℂ => iteratedDeriv d W₁ z - iteratedDeriv d W₂ z) =ᶠ[nhds ζ]
          iteratedDeriv d (W₁ - W₂) :=
        Filter.eventuallyEq_of_mem ((hOpen σ).mem_nhds hζ) (fun z hz => (hSubDeriv d hz).symm)
      rw [h_ev.iteratedDeriv_eq j, iteratedDeriv_eq_iterate, iteratedDeriv_eq_iterate,
        ← Function.iterate_add_apply, ← iteratedDeriv_eq_iterate]
      exact le_csSup hBdd ⟨j + d, hjd, ζ, hζ, rfl⟩
  
  have h_real_iteratedDeriv_eq :
      ∀ (r₀ : ℕ) (σ M₁ : ℝ) (w : ℝ → ℝ) (W : ℂ → ℂ),
        0 < σ →
        IsPeriodicSmoothBounded r₀ M₁ w →
        IsBoundedStripExt r₀ σ M₁ w W →
        ∀ k : ℕ, k ≤ r₀ → ∀ r : ℝ,
          iteratedDeriv k W (r : ℂ) = ((iteratedDeriv k w r : ℝ) : ℂ) := by
    intro r₀ σ M₁ w W hσ hw hW k hk
    induction k with
    | zero =>
      intro r
      simp only [iteratedDeriv_zero]
      exact hW.2.1 r
    | succ k ih =>
      intro r
      have hIH := ih (Nat.le_of_succ_le hk)
      have hWk_holo : DifferentiableOn ℂ (iteratedDeriv k W) (horizStrip σ) :=
        (hIterHoloPerConj σ W hW.1 hW.2.2.1 hW.2.2.2.1 k).1
      have hWk_at : DifferentiableAt ℂ (iteratedDeriv k W) (r : ℂ) :=
        hWk_holo.differentiableAt ((hOpen σ).mem_nhds (hRealMem hσ r))
      have hL : HasDerivAt (fun y : ℝ => iteratedDeriv k W (y : ℂ))
          (deriv (iteratedDeriv k W) (r : ℂ)) r :=
        hWk_at.hasDerivAt.comp_ofReal
      have hwk_diff : Differentiable ℝ (iteratedDeriv k w) :=
        ContDiff.differentiable_iteratedDeriv k hw.2.1 (by exact_mod_cast Nat.lt_of_succ_le hk)
      have hR : HasDerivAt (fun y : ℝ => ((iteratedDeriv k w y : ℝ) : ℂ))
          (((deriv (iteratedDeriv k w) r : ℝ) : ℂ)) r :=
        (hwk_diff r).hasDerivAt.ofReal_comp
      have hFunEq : (fun y : ℝ => iteratedDeriv k W (y : ℂ)) =
          (fun y : ℝ => ((iteratedDeriv k w y : ℝ) : ℂ)) :=
        funext hIH
      rw [hFunEq] at hL
      rw [iteratedDeriv_succ, iteratedDeriv_succ]
      exact hL.unique hR
  
  have hBndCongr : ∀ {p : ℕ} {σ' M : ℝ} {f g : ℂ → ℂ},
      IsStripBounded p σ' M f →
      (∀ z ∈ horizStrip σ', g z = f z) →
      IsStripBounded p σ' M g := by
    intro p σ' M f g hf hfg
    refine ⟨hf.1.congr hfg, ?_⟩
    intro k hk z hz
    have h_ev : g =ᶠ[nhds z] f :=
      Filter.eventuallyEq_of_mem ((hOpen σ').mem_nhds hz) hfg
    rw [h_ev.iteratedDeriv_eq k]
    exact hf.2 k hk z hz
  
  have h_bounded_const : ∀ (p : ℕ) (σ' : ℝ) (c : ℂ),
      IsStripBounded p σ' ‖c‖ (fun _ => c) := by
    intro p σ' c
    refine ⟨differentiableOn_const c, ?_⟩
    intro k _hk z _hz
    rw [iteratedDeriv_const]
    split_ifs
    · exact le_rfl
    · simp only [norm_zero]
      exact norm_nonneg c
  have h_holo_const_real : ∀ (p : ℕ) (σ' c : ℝ),
      IsStripHoloSymBounded p σ' |c| (fun _ => (c : ℂ)) := by
    intro p σ' c
    refine ⟨?_, fun _ _ => rfl, fun _ _ => (Complex.conj_ofReal c).symm⟩
    simpa only [Complex.norm_real, Real.norm_eq_abs] using h_bounded_const p σ' (c : ℂ)
  have h_bounded_mono : ∀ {p : ℕ} {σ' M₁ M₂ : ℝ} {f : ℂ → ℂ},
      M₁ ≤ M₂ → IsStripBounded p σ' M₁ f → IsStripBounded p σ' M₂ f := by
    intro p σ' M₁ M₂ f hM hf
    exact ⟨hf.1, fun k hk z hz => le_trans (hf.2 k hk z hz) hM⟩
  have h_holo_mono : ∀ {p : ℕ} {σ' M₁ M₂ : ℝ} {f : ℂ → ℂ},
      M₁ ≤ M₂ → IsStripHoloSymBounded p σ' M₁ f → IsStripHoloSymBounded p σ' M₂ f := by
    intro p σ' M₁ M₂ f hM hf
    exact ⟨h_bounded_mono hM hf.1, hf.2⟩
  have h_bounded_add : ∀ {p : ℕ} {σ' M₁ M₂ : ℝ} {f g : ℂ → ℂ},
      IsStripBounded p σ' M₁ f → IsStripBounded p σ' M₂ g →
      IsStripBounded p σ' (M₁ + M₂) (fun z => f z + g z) := by
    intro p σ' M₁ M₂ f g hf hg
    refine ⟨hf.1.add hg.1, ?_⟩
    intro k hk z hz
    rw [iteratedDeriv_fun_add (hContDiffAt hf.1 hz k) (hContDiffAt hg.1 hz k)]
    exact (norm_add_le _ _).trans (add_le_add (hf.2 k hk z hz) (hg.2 k hk z hz))
  have h_holo_add : ∀ {p : ℕ} {σ' M₁ M₂ : ℝ} {f g : ℂ → ℂ},
      IsStripHoloSymBounded p σ' M₁ f → IsStripHoloSymBounded p σ' M₂ g →
      IsStripHoloSymBounded p σ' (M₁ + M₂) (fun z => f z + g z) := by
    intro p σ' M₁ M₂ f g hf hg
    refine ⟨h_bounded_add hf.1 hg.1, ?_, ?_⟩
    · intro z hz
      dsimp only
      rw [hf.2.1 z hz, hg.2.1 z hz]
    · intro z hz
      dsimp only
      rw [hf.2.2 z hz, hg.2.2 z hz, map_add]
  have h_bounded_neg : ∀ {p : ℕ} {σ' M : ℝ} {f : ℂ → ℂ},
      IsStripBounded p σ' M f → IsStripBounded p σ' M (fun z => -f z) := by
    intro p σ' M f hf
    refine ⟨hf.1.neg, ?_⟩
    intro k hk z hz
    rw [iteratedDeriv_fun_neg, norm_neg]
    exact hf.2 k hk z hz
  have h_holo_neg : ∀ {p : ℕ} {σ' M : ℝ} {f : ℂ → ℂ},
