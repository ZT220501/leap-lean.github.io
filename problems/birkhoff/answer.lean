      ext w; simp [A_surv]
    rw [h_eq_set]
    apply MeasurableSet.biInter (Finset.countable_toSet _)
    intro i hi
    have hiM : i ≤ M := by have := Finset.mem_range.mp hi; omega
    exact measurableSet_Ioi.preimage (hZ_meas i hiM)
  have hY_meas : ∀ k ≤ M, Measurable (Y_stop k) :=
    fun k hk => Finset.measurable_sum (Finset.range k) (fun j hj => by
      have hjM : j < M := lt_of_lt_of_le (Finset.mem_range.mp hj) hk
      exact Measurable.ite (hA_meas j (by omega)) (hξ_meas j hjM) measurable_const)
  have hY_bdd : ∀ k ≤ M, ∀ w : ℕ → ℝ, |Y_stop k w| ≤ (M : ℝ) * (2 * B) := by
