          JetDiff A' B' c' := by
        rintro A A' B B' c c' ⟨hA, hB, Ψ, hΨ, h_eq⟩ hAA' hBB' hcc'
        subst hcc'
        refine ⟨hA.congr fun ε hε => (hAA' ε hε).symm,
          hB.congr fun ε hε => (hBB' ε hε).symm, Ψ, hΨ, fun ε hε => ?_⟩
        rw [← hAA' ε hε, ← hBB' ε hε]
        exact h_eq ε hε
      have jd_add : ∀ {A₁ B₁ A₂ B₂ : ℂ → ℂ} {c₁ c₂ : ℂ},
          JetDiff A₁ B₁ c₁ → JetDiff A₂ B₂ c₂ →
          JetDiff (fun ε => A₁ ε + A₂ ε) (fun ε => B₁ ε + B₂ ε) (c₁ + c₂) := by
        rintro A₁ B₁ A₂ B₂ c₁ c₂ ⟨hA₁, hB₁, Ψ₁, hΨ₁, he₁⟩ ⟨hA₂, hB₂, Ψ₂, hΨ₂, he₂⟩
        refine ⟨hA₁.add hA₂, hB₁.add hB₂, fun ε => Ψ₁ ε + Ψ₂ ε, hΨ₁.add hΨ₂, fun ε hε => ?_⟩
        linear_combination he₁ ε hε + he₂ ε hε
      have jd_sub : ∀ {A₁ B₁ A₂ B₂ : ℂ → ℂ} {c₁ c₂ : ℂ},
          JetDiff A₁ B₁ c₁ → JetDiff A₂ B₂ c₂ →
          JetDiff (fun ε => A₁ ε - A₂ ε) (fun ε => B₁ ε - B₂ ε) (c₁ - c₂) := by
        rintro A₁ B₁ A₂ B₂ c₁ c₂ ⟨hA₁, hB₁, Ψ₁, hΨ₁, he₁⟩ ⟨hA₂, hB₂, Ψ₂, hΨ₂, he₂⟩
        refine ⟨hA₁.sub hA₂, hB₁.sub hB₂, fun ε => Ψ₁ ε - Ψ₂ ε, hΨ₁.sub hΨ₂, fun ε hε => ?_⟩
        linear_combination he₁ ε hε - he₂ ε hε
      have jd_const_mul : ∀ (k₀ : ℂ) {A B : ℂ → ℂ} {c : ℂ},
          JetDiff A B c → JetDiff (fun ε => k₀ * A ε) (fun ε => k₀ * B ε) (k₀ * c) := by
        rintro k₀ A B c ⟨hA, hB, Ψ, hΨ, he⟩
        refine ⟨(differentiableOn_const k₀).mul hA, (differentiableOn_const k₀).mul hB,
          fun ε => k₀ * Ψ ε, (differentiableOn_const k₀).mul hΨ, fun ε hε => ?_⟩
        linear_combination k₀ * he ε hε
      have jd_mul : ∀ {A₁ B₁ A₂ B₂ : ℂ → ℂ} {c₁ c₂ : ℂ},
