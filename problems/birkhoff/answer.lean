        w_map_zero := hw_zero
        w_map_deriv_zero := hw_deriv_zero
        w_map_odd := hw_odd
        w_map_deriv := hw_deriv
        w_map_real := hw_real_eq
        w_real_cont := hw_real_cont
        w_real_strictMono := hw_real_strictMono
        w_real_zero := hw_real_zero
