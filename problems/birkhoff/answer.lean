            intro i hi
            have hai_le : a + i ≤ T := by omega
            dsimp only [D_seq]
            calc
              ‖sliceTinySupMart S P bG r_star j y_seq (a + i) -
                  sliceTinySupMart S P bG r_star j y_seq a‖
                  ≤ ‖sliceTinySupMart S P bG r_star j y_seq (a + i)‖ +
                      ‖sliceTinySupMart S P bG r_star j y_seq a‖ := norm_sub_le _ _
              _ ≤ Real.exp (-bG / 3) + Real.exp (-bG / 3) :=
                    add_le_add (hy_mart (a + i) hai_le j).2 (hy_mart a ha_le j).2
              _ = 2 * Real.exp (-bG / 3) := by ring
