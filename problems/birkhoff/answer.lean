          rp_HasPSLaurentWeight w₀ (fun z => rp_substPS (Φ z) (Ψ z)) := by
        intro w₀ Φ Ψ hΦ hΨ β
        have h_eq : (fun z => PowerSeries.coeff β (rp_substPS (Φ z) (Ψ z))) =
            (fun z => ∑ r ∈ Finset.range (β + 1),
              PowerSeries.coeff r (Φ z) * PowerSeries.coeff β ((Ψ z) ^ r)) := by
          ext z; simp [rp_substPS]
        rw [h_eq]
        apply h_mero_sum
        intro r _
        obtain ⟨hm₁, ho₁⟩ := hΦ r
        obtain ⟨hm₂, ho₂⟩ := h_wt_pow r hΨ β
        refine ⟨hm₁.mul hm₂, ?_⟩
        have hmul : meromorphicOrderAt
              (fun z => PowerSeries.coeff r (Φ z) * PowerSeries.coeff β ((Ψ z) ^ r)) 0 =
            meromorphicOrderAt (fun z => PowerSeries.coeff r (Φ z)) 0 +
              meromorphicOrderAt (fun z => PowerSeries.coeff β ((Ψ z) ^ r)) 0 :=
          meromorphicOrderAt_mul hm₁ hm₂
        rw [hmul]
        have h_le := add_le_add ho₁ ho₂
        rw [← WithTop.coe_add] at h_le
        exact le_trans (WithTop.coe_le_coe.mpr (by omega)) h_le
      intro u j _ hu N β
      let u_lt := rp_truncJet u j
      have hu_lt : ∀ i : ℕ, 1 ≤ i →
          MeromorphicAt (u_lt i) 0 ∧
            ((1 - 2 * (i : ℤ) : ℤ) : WithTop ℤ) ≤ meromorphicOrderAt (u_lt i) 0 := by
        intro i hi
