        rw [hslice0_add, hXj_VE δ 0 hj1, add_zero]
      have hVB₀ : VanishesBelow 1 Z₀ := hVB_of_slice0 hZ0
      have hVB₁ : VanishesBelow 1 Z₁ := hVB_of_slice0 (hZ₁_slice0.symm ▸ hZ0)
      have hpow_pert : ∀ m : ℕ,
          ModEq j (Z₁ ^ (m + 1))
            (Z₀ ^ (m + 1) +
              X_ε ^ j * ι₀ (MvPowerSeries.C ((m : ℂ) + 1) * Z₀₀ ^ m * δ)) := by
