        rcases eq_or_lt_of_le hu.1 with rfl | hu_pos
        · simp [γ₁] at hzS; exact hp.2 hzS
        · have : γ₁ u ∈ L t₀ := ⟨hzS, Or.inl ⟨u, ⟨hu_pos, hu.2⟩, hγ₁_eq u⟩⟩
          rw [hL_empty] at this; exact this
      have hP₂_sub : P₂ ⊆ U \ S := by
        rintro z ⟨u, hu, rfl⟩
        refine ⟨hU_conv hwt₀_U hq.1 (sub_nonneg.mpr hu.2) hu.1 (sub_add_cancel 1 u), fun hzS => ?_⟩
