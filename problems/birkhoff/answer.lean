  have hBall2D_id : ∀ (p₀ p₁ : ℂ × ℂ) (R₀ r₁ : ℝ) (f : ℂ × ℂ → ℂ),
      DifferentiableOn ℂ f (Metric.ball p₀ R₀) →
      p₁ ∈ Metric.ball p₀ R₀ → 0 < r₁ →
      (∀ q ∈ Metric.ball p₁ r₁, f q = 0) →
      ∀ q ∈ Metric.ball p₀ R₀, f q = 0 := by
    intro p₀ p₁ R₀ r₁ f hf hp₁ hr₁ hzero q hq
    let γ : ℂ → ℂ × ℂ := fun z => p₁ + z • (q - p₁)
    have hγ_diff : Differentiable ℂ γ :=
      (differentiable_const p₁).add (differentiable_id.smul_const (q - p₁))
    let V : Set ℂ := γ ⁻¹' Metric.ball p₀ R₀
    have hV_open : IsOpen V := Metric.isOpen_ball.preimage hγ_diff.continuous
