      exact ⟨⟨U', hU'_open, h0_U', hH.comp hd_in fun ε hε => hε.2⟩⟩
    refine ⟨hcomp_holo hG, ?_⟩
    rcases hz with ⟨⟨U_z, hUz, h0_Uz, hdz⟩⟩
    have hz_restore : paJetHoloAtZero z_fn := ⟨⟨U_z, hUz, h0_Uz, hdz⟩⟩
    have hds_holo : paJetHoloAtZero (dslope z_fn 0) :=
      ⟨⟨U_z, hUz, h0_Uz, (Complex.differentiableOn_dslope (hUz.mem_nhds h0_Uz)).mpr hdz⟩⟩
    have hz_eq : ∀ ε : ℂ, z_fn ε = ε * dslope z_fn 0 ε := by
      intro ε
      have hsub := sub_smul_dslope z_fn 0 ε
      simp only [sub_zero, hz0, smul_eq_mul] at hsub
      exact hsub.symm
    ext m
    let c_fn : ℕ → ℂ := fun n => PowerSeries.coeff n (holoTaylor1D G z₀)
    let rem_fn : ℂ → ℂ := fun ε =>
      (dslope z_fn 0 ε) ^ (m + 1) * lineCoalescingDslopeIter G z₀ (m + 1) (z₀ + z_fn ε)
    have hrem_holo : paJetHoloAtZero rem_fn :=
      (hHolo_mul (hHolo_pow hds_holo (m + 1)).1
        (hcomp_holo (hDslope_holo hW hz₀ hG (m + 1)))).1
    have hG_expand : (fun ε => G (z₀ + z_fn ε)) = fun ε =>
        (∑ n ∈ Finset.range (m + 1), c_fn n * (z_fn ε) ^ n) +
        ε ^ (m + 1) * rem_fn ε := by
      ext ε
      have ht := hDslope_taylor hW hz₀ hG m (z₀ + z_fn ε)
      have hsub : z₀ + z_fn ε - z₀ = z_fn ε := by ring
      have hp : z_fn ε ^ (m + 1) = ε ^ (m + 1) * dslope z_fn 0 ε ^ (m + 1) := by
        rw [hz_eq ε, mul_pow]
      rw [hsub] at ht
      rw [ht, hp]
      dsimp only [rem_fn, c_fn]
      ring
    have hterm_holo : ∀ n : ℕ,
        paJetHoloAtZero (fun ε => c_fn n * (z_fn ε) ^ n) ∧
        holoTaylor1D (fun ε => c_fn n * (z_fn ε) ^ n) 0 =
          PowerSeries.C (c_fn n) * (holoTaylor1D z_fn 0) ^ n := by
      intro n
      have hm := hHolo_mul (hHolo_const (c_fn n)).1 (hHolo_pow hz_restore n).1
      refine ⟨hm.1, ?_⟩
      rw [hm.2, (hHolo_const (c_fn n)).2, (hHolo_pow hz_restore n).2]
    have hsum_tay := hHolo_sum (Finset.range (m + 1))
      (fun n ε => c_fn n * (z_fn ε) ^ n)
      (fun n _ => (hterm_holo n).1)
    have hrem_tay := hHolo_mul (hHolo_pow hHolo_id.1 (m + 1)).1 hrem_holo
    have hfull_tay := hHolo_add hsum_tay.1 hrem_tay.1
    rw [hG_expand, hfull_tay.2, hsum_tay.2, hrem_tay.2, (hHolo_pow hHolo_id.1 (m + 1)).2,
      hHolo_id.2, map_add, PowerSeries.coeff_X_pow_mul', if_neg (by omega), add_zero,
      map_sum]
    simp only [pointArcPolyComp, PowerSeries.coeff_mk]
    apply Finset.sum_congr rfl
    intro n _
    rw [(hterm_holo n).2, PowerSeries.coeff_C_mul]
  
