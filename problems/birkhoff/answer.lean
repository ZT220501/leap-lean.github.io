      have hfront_sub : frontier upperHalfDiskOpen ⊆ upperHalfDiskBdry := by
        rw [hOpen_hd.frontier_eq]
        intro ζ ⟨hζ_cl, hζ_not⟩
        rcases hcl_sub hζ_cl with h_in | h_bdry
        · exact False.elim (hζ_not h_in)
        · exact h_bdry
      let E : ℂ → ℂ := fun ζ => Complex.exp (-Complex.I * g_tilde ζ)
      have hE_holo : DifferentiableOn ℂ E W_ext :=
