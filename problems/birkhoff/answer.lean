    d_act_pos := O.d_act_pos
    d_act_lt_half_s_act := O.d_act_lt_half_s_act
    d_act_lt_one := O.d_act_lt_one
    d_act_lt_half_δ_col := O.d_act_lt_half_δ_col
    d_act_lt_half_τ₀ := O.d_act_lt_half_τ₀
    η_adm_pos := O.η_adm_pos
    η_adm_le_inv32 := O.η_adm_le_inv32
    η_adm_le_quarter_s₀ := O.η_adm_le_quarter_s₀
    M_act_pos := A.M_act_pos
    M_E_pos := O.M_E_pos
    C_quad_pos := F.C_quad_pos
    partial_y_holo := hCalc.partial_y_holo
    partial_t_holo := hCalc.partial_t_holo
    real_step_collar := O.real_step_collar
    E_op_props := O.E_op_props
