            have : R_b + (N : ℝ) * δ = R := hxN
            linarith
          have hz_eq_R : z = R := le_antisymm hz_hi hxN_le_z
          rw [hz_eq_R, hk_succ, hxN]
          exact ⟨(hx_mem k (by omega)).2, le_rfl⟩
      by_cases hik : i ≤ k
      · have hik_real : (i : ℝ) ≤ (k : ℝ) := by exact_mod_cast hik
        have hv_le_xk : v ≤ x k := by
          dsimp [v, x]
          linarith [mul_le_mul_of_nonneg_right hik_real hδ_pos.le]
        have hv_le_z : v ≤ z := le_trans hv_le_xk h_brack.1
        have hμ_lo : μ v ≤ μ z := hμ (hx_mem i hi_le_N) ⟨hz_lo, hz_hi⟩ hv_le_z
        have hμ_hi : μ z ≤ a (k + 1) :=
          hμ ⟨hz_lo, hz_hi⟩ (hx_mem (k + 1) hk_succ_le_N) h_brack.2
        have h_abs_μ : |μ z - μ v| ≤ a (k + 1) - a i := by
          rw [abs_of_nonneg (by linarith)]
          dsimp [a, v]
          linarith
        have h_sec := h_no_right (k + 1) (by omega) hk_succ_le_N
        have h_idx_le : ((k + 1 : ℕ) : ℝ) - (i : ℝ) ≤ |z - v| + 1 := by
          push_cast
          have h_nonneg : 0 ≤ (k : ℝ) - (i : ℝ) := by linarith
          have h_mul_δ : (k : ℝ) - (i : ℝ) ≤ ((k : ℝ) - (i : ℝ)) * δ := by
            nlinarith [hδ_ge_one]
          have h_xk_v : ((k : ℝ) - (i : ℝ)) * δ = x k - v := by dsimp [x, v]; ring
          have h_abs_zv : z - v = |z - v| := (abs_of_nonneg (by linarith)).symm
          linarith [h_brack.1]
        calc |μ z - μ v| ≤ a (k + 1) - a i := h_abs_μ
          _ ≤ η * (((k + 1 : ℕ) : ℝ) - (i : ℝ)) := h_sec
          _ ≤ η * (|z - v| + 1) := mul_le_mul_of_nonneg_left h_idx_le hη_pos.le
          _ ≤ ε * (|z - v| + 1) := mul_le_mul_of_nonneg_right hη_le_ε (by positivity)
          _ = ε * |z - v| + ε := by ring
      · have hk1_le_i : k + 1 ≤ i := by omega
        have hk1_real : ((k + 1 : ℕ) : ℝ) ≤ (i : ℝ) := by exact_mod_cast hk1_le_i
        have hxk1_le_v : x (k + 1) ≤ v := by
          dsimp [v, x]
          linarith [mul_le_mul_of_nonneg_right hk1_real hδ_pos.le]
        have hz_le_v : z ≤ v := le_trans h_brack.2 hxk1_le_v
        have hμ_lo : a k ≤ μ z := hμ (hx_mem k (by omega)) ⟨hz_lo, hz_hi⟩ h_brack.1
        have hμ_hi : μ z ≤ μ v := hμ ⟨hz_lo, hz_hi⟩ (hx_mem i hi_le_N) hz_le_v
        have h_abs_μ : |μ z - μ v| ≤ a i - a k := by
          rw [abs_sub_comm, abs_of_nonneg (by linarith)]
          dsimp [a, v]
          linarith
        have h_sec := h_no_left k hk1_le_i
        have h_idx_le : (i : ℝ) - (k : ℝ) ≤ |z - v| + 1 := by
          have h_nonneg : 0 ≤ (i : ℝ) - ((k + 1 : ℕ) : ℝ) := by linarith
          have h_mul_δ :
              (i : ℝ) - ((k + 1 : ℕ) : ℝ) ≤ ((i : ℝ) - ((k + 1 : ℕ) : ℝ)) * δ := by
            nlinarith [hδ_ge_one]
          have h_v_xk1 : ((i : ℝ) - ((k + 1 : ℕ) : ℝ)) * δ = v - x (k + 1) := by
            dsimp [x, v]; ring
          have h_abs_zv : v - z = |z - v| := by
            rw [abs_sub_comm, abs_of_nonneg (by linarith)]
          have h_cast : ((k + 1 : ℕ) : ℝ) = (k : ℝ) + 1 := by push_cast; ring
          linarith [h_brack.2]
        calc |μ z - μ v| ≤ a i - a k := h_abs_μ
          _ ≤ η * ((i : ℝ) - (k : ℝ)) := h_sec
          _ ≤ η * (|z - v| + 1) := mul_le_mul_of_nonneg_left h_idx_le hη_pos.le
          _ ≤ ε * (|z - v| + 1) := mul_le_mul_of_nonneg_right hη_le_ε (by positivity)
          _ = ε * |z - v| + ε := by ring

  have h_convex_inv :
      ∀ (U_symm : Set ℝ) (ρ : ℝ → ℝ) (h_b : ℝ),
        IsOpen U_symm →
        Convex ℝ U_symm →
        (0 : ℝ) ∈ U_symm →
        (∀ y ∈ U_symm, -y ∈ U_symm) →
        (∀ y ∈ U_symm, ρ (-y) = ρ y) →
        ConvexOn ℝ U_symm ρ →
        0 < h_b →
        h_b ∈ U_symm →
        1 ≤ ρ h_b →
        ρ 0 < ρ h_b →
        (∀ z : ℝ, ρ h_b ≤ z → ∃ Y ∈ U_symm, h_b ≤ Y ∧ z ≤ ρ Y) →
        ∃ h μ : ℝ → ℝ, CgpsInverseChordData U_symm ρ h_b h μ := by
    intro U_symm ρ h_b hU_open hU_conv h0_mem hU_symm hρ_even hρ_conv
      hb_pos hb_mem hRb_ge_one hRb_gt_zero hρ_unbdd
    have hρ_cont : ContinuousOn ρ U_symm := hρ_conv.continuousOn hU_open
    have hint_eq : interior U_symm = U_symm := hU_open.interior_eq
    have hρ_mono_nonneg :
        ∀ y₁ y₂ : ℝ, 0 ≤ y₁ → y₁ ≤ y₂ → y₂ ∈ U_symm → y₁ ∈ U_symm ∧ ρ y₁ ≤ ρ y₂ := by
      intro y₁ y₂ hy₁ hy₁₂ hy₂
      rcases eq_or_lt_of_le (le_trans hy₁ hy₁₂) with hy₂0 | hy₂_pos
      · have hy₁_eq : y₁ = 0 := by linarith
        have hy₂_eq : y₂ = 0 := by linarith
        rw [hy₁_eq, hy₂_eq]
        exact ⟨h0_mem, le_rfl⟩
      · let a : ℝ := (y₂ - y₁) / (2 * y₂)
        let b : ℝ := (y₂ + y₁) / (2 * y₂)
        have ha : 0 ≤ a := div_nonneg (by linarith) (by positivity)
        have hb : 0 ≤ b := div_nonneg (by linarith) (by positivity)
        have hab : a + b = 1 := by
          dsimp [a, b]
          field_simp [hy₂_pos.ne']
          ring
        have hcomb : a • (-y₂) + b • y₂ = y₁ := by
          simp only [smul_eq_mul]
          dsimp [a, b]
          field_simp [hy₂_pos.ne']
          ring
        have hny₂ : -y₂ ∈ U_symm := hU_symm y₂ hy₂
        have hy₁_mem : y₁ ∈ U_symm := by
          rw [← hcomb]
          exact hU_conv hny₂ hy₂ ha hb hab
        have hineq := hρ_conv.2 hny₂ hy₂ ha hb hab
        simp only [smul_eq_mul] at hineq hcomb
        rw [hcomb, hρ_even y₂ hy₂] at hineq
        refine ⟨hy₁_mem, ?_⟩
        calc ρ y₁ ≤ a * ρ y₂ + b * ρ y₂ := hineq
          _ = (a + b) * ρ y₂ := by ring
          _ = ρ y₂ := by rw [hab, one_mul]
    let D_plus : ℝ → ℝ := fun y => derivWithin ρ (Set.Ioi y) y
    let s₀ : ℝ := (ρ h_b - ρ 0) / h_b
    have hs₀_pos : 0 < s₀ := div_pos (by linarith) hb_pos
    have hD_mono : MonotoneOn D_plus U_symm := by
      have hm := hρ_conv.monotoneOn_rightDeriv
      rwa [hint_eq] at hm
    have hD_secant_zero : ∀ y ∈ U_symm, 0 < y → (ρ y - ρ 0) / y ≤ D_plus y := by
      intro y hy_mem hy_pos
      have hy_int : y ∈ interior U_symm := by rwa [hint_eq]
      have h1 := hρ_conv.slope_le_leftDeriv_of_mem_interior h0_mem hy_int hy_pos
      have h2 := hρ_conv.leftDeriv_le_rightDeriv_of_mem_interior hy_int
      rw [slope_def_field, sub_zero] at h1
      exact le_trans h1 h2
    have hs₀_le_D : ∀ y ∈ U_symm, h_b ≤ y → s₀ ≤ D_plus y := by
      intro y hy_mem hy_ge
      exact le_trans (hD_secant_zero h_b hb_mem hb_pos) (hD_mono hb_mem hy_mem hy_ge)
    have hρ_strictMono : ∀ y₁ y₂ : ℝ, h_b ≤ y₁ → y₁ < y₂ → y₂ ∈ U_symm → ρ y₁ < ρ y₂ := by
      intro y₁ y₂ hy₁_ge hy₁₂ hy₂_mem
      have hy₁_mem : y₁ ∈ U_symm :=
        (hρ_mono_nonneg y₁ y₂ (le_trans hb_pos.le hy₁_ge) hy₁₂.le hy₂_mem).1
      have hy₁_int : y₁ ∈ interior U_symm := by rwa [hint_eq]
      have h_sl := hρ_conv.rightDeriv_le_slope_of_mem_interior hy₁_int hy₂_mem hy₁₂
      rw [slope_def_field] at h_sl
      have hD_pos : 0 < D_plus y₁ := lt_of_lt_of_le hs₀_pos (hs₀_le_D y₁ hy₁_mem hy₁_ge)
      have h_pos_div : 0 < (ρ y₂ - ρ y₁) / (y₂ - y₁) := lt_of_lt_of_le hD_pos h_sl
      have h_diff_pos : 0 < ρ y₂ - ρ y₁ := (div_pos_iff_of_pos_right (by linarith)).mp h_pos_div
      linarith
    have h_inv_ex : ∀ z : ℝ, ρ h_b ≤ z → ∃ y : ℝ, h_b ≤ y ∧ y ∈ U_symm ∧ ρ y = z := by
      intro z hz
      obtain ⟨Y, hY_mem, hY_ge, hz_le⟩ := hρ_unbdd z hz
      have hIcc_sub : Set.Icc h_b Y ⊆ U_symm := hU_conv.ordConnected.out hb_mem hY_mem
      have h_cont_Icc : ContinuousOn ρ (Set.Icc h_b Y) := hρ_cont.mono hIcc_sub
      obtain ⟨y, hy_Icc, hy_eq⟩ := intermediate_value_Icc hY_ge h_cont_Icc ⟨hz, hz_le⟩
      exact ⟨y, hy_Icc.1, hIcc_sub hy_Icc, hy_eq⟩
    let h : ℝ → ℝ := fun z => if hz : ρ h_b ≤ z then Classical.choose (h_inv_ex z hz) else h_b
    let μ : ℝ → ℝ := fun z => Real.log (D_plus (h z))
    have hh_spec : ∀ z : ℝ, ρ h_b ≤ z → h_b ≤ h z ∧ h z ∈ U_symm ∧ ρ (h z) = z := by
      intro z hz
      have heq : h z = Classical.choose (h_inv_ex z hz) := by simp [h, hz]
      rw [heq]
      exact Classical.choose_spec (h_inv_ex z hz)
    have hh_strictMono : StrictMonoOn h (Set.Ici (ρ h_b)) := by
      intro z₁ hz₁ z₂ hz₂ hz₁₂
      obtain ⟨h1_ge, h1_mem, h1_eq⟩ := hh_spec z₁ hz₁
      obtain ⟨h2_ge, _, h2_eq⟩ := hh_spec z₂ hz₂
      by_contra! h_le
      have h_rho_le := (hρ_mono_nonneg (h z₂) (h z₁) (le_trans hb_pos.le h2_ge) h_le h1_mem).2
      rw [h1_eq, h2_eq] at h_rho_le
      linarith
    have hh_left_inv : ∀ y ∈ U_symm, h_b ≤ y → ρ h_b ≤ ρ y ∧ h (ρ y) = y := by
      intro y hy_mem hy_ge
      have h_ge : ρ h_b ≤ ρ y := (hρ_mono_nonneg h_b y hb_pos.le hy_ge hy_mem).2
      obtain ⟨hh_ge, hh_mem, hh_eq⟩ := hh_spec (ρ y) h_ge
      refine ⟨h_ge, ?_⟩
      rcases lt_trichotomy (h (ρ y)) y with hlt | heq | hgt
      · exfalso
        have := hρ_strictMono (h (ρ y)) y hh_ge hlt hy_mem
        linarith
      · exact heq
      · exfalso
        have := hρ_strictMono y (h (ρ y)) hy_ge hgt hh_mem
        linarith
    have hexp_μ : ∀ z : ℝ, ρ h_b ≤ z → Real.exp (μ z) = D_plus (h z) := by
      intro z hz
      obtain ⟨hh_ge, hh_mem, _⟩ := hh_spec z hz
      have hD_pos : 0 < D_plus (h z) := lt_of_lt_of_le hs₀_pos (hs₀_le_D (h z) hh_mem hh_ge)
      exact Real.exp_log hD_pos
    have hμ_mono : MonotoneOn μ (Set.Ici (ρ h_b)) := by
      intro z₁ hz₁ z₂ hz₂ hz₁₂
      obtain ⟨h1_ge, h1_mem, _⟩ := hh_spec z₁ hz₁
      obtain ⟨_, h2_mem, _⟩ := hh_spec z₂ hz₂
      have hh_le : h z₁ ≤ h z₂ := hh_strictMono.monotoneOn hz₁ hz₂ hz₁₂
      have hD1_pos : 0 < D_plus (h z₁) := lt_of_lt_of_le hs₀_pos (hs₀_le_D (h z₁) h1_mem h1_ge)
      exact Real.log_le_log hD1_pos (hD_mono h1_mem h2_mem hh_le)
    have h_chord : ∀ z₁ z₂ : ℝ, ρ h_b ≤ z₁ → z₁ < z₂ →
        Real.exp (-μ z₂) * (z₂ - z₁) ≤ h z₂ - h z₁ ∧
        h z₂ - h z₁ ≤ Real.exp (-μ z₁) * (z₂ - z₁) := by
      intro z₁ z₂ hz₁ hz₁₂
      have hz₂ : ρ h_b ≤ z₂ := le_trans hz₁ hz₁₂.le
      obtain ⟨_, h1_mem, h1_eq⟩ := hh_spec z₁ hz₁
      obtain ⟨_, h2_mem, h2_eq⟩ := hh_spec z₂ hz₂
      have hh_lt : h z₁ < h z₂ := hh_strictMono hz₁ hz₂ hz₁₂
      have h1_int : h z₁ ∈ interior U_symm := by rwa [hint_eq]
      have h2_int : h z₂ ∈ interior U_symm := by rwa [hint_eq]
      have h_lo_sl := hρ_conv.rightDeriv_le_slope_of_mem_interior h1_int h2_mem hh_lt
      have h_hi_sl := le_trans
        (hρ_conv.slope_le_leftDeriv_of_mem_interior h1_mem h2_int hh_lt)
        (hρ_conv.leftDeriv_le_rightDeriv_of_mem_interior h2_int)
      rw [slope_def_field, h1_eq, h2_eq] at h_lo_sl h_hi_sl
      have hexp1 := hexp_μ z₁ hz₁
      have hexp2 := hexp_μ z₂ hz₂
      change D_plus (h z₁) ≤ (z₂ - z₁) / (h z₂ - h z₁) at h_lo_sl
      change (z₂ - z₁) / (h z₂ - h z₁) ≤ D_plus (h z₂) at h_hi_sl
      rw [← hexp1] at h_lo_sl
      rw [← hexp2] at h_hi_sl
      have hdh_pos : 0 < h z₂ - h z₁ := by linarith
      refine ⟨?_, ?_⟩
      · have hmul : z₂ - z₁ ≤ Real.exp (μ z₂) * (h z₂ - h z₁) :=
          (div_le_iff₀ hdh_pos).mp h_hi_sl
        have hmul2 := mul_le_mul_of_nonneg_left hmul (Real.exp_pos (-μ z₂)).le
        have hcancel : Real.exp (-μ z₂) * (Real.exp (μ z₂) * (h z₂ - h z₁)) = h z₂ - h z₁ := by
          calc Real.exp (-μ z₂) * (Real.exp (μ z₂) * (h z₂ - h z₁))
              = (Real.exp (-μ z₂) * Real.exp (μ z₂)) * (h z₂ - h z₁) := by ring
            _ = Real.exp (-μ z₂ + μ z₂) * (h z₂ - h z₁) := by rw [← Real.exp_add]
            _ = h z₂ - h z₁ := by simp
        rwa [hcancel] at hmul2
      · have hmul : Real.exp (μ z₁) * (h z₂ - h z₁) ≤ z₂ - z₁ :=
          (le_div_iff₀ hdh_pos).mp h_lo_sl
        have hmul2 := mul_le_mul_of_nonneg_left hmul (Real.exp_pos (-μ z₁)).le
        have hcancel : Real.exp (-μ z₁) * (Real.exp (μ z₁) * (h z₂ - h z₁)) = h z₂ - h z₁ := by
          calc Real.exp (-μ z₁) * (Real.exp (μ z₁) * (h z₂ - h z₁))
              = (Real.exp (-μ z₁) * Real.exp (μ z₁)) * (h z₂ - h z₁) := by ring
            _ = Real.exp (-μ z₁ + μ z₁) * (h z₂ - h z₁) := by rw [← Real.exp_add]
            _ = h z₂ - h z₁ := by simp
        rwa [hcancel] at hmul2
    refine ⟨h, μ, {
      hb_pos := hb_pos
      hb_mem := hb_mem
      Rb_ge_one := hRb_ge_one
      Rb_gt_zero_val := hRb_gt_zero
      ρ_mono_nonneg := hρ_mono_nonneg
      ρ_bdd_on_Icc := fun B hB_nn hB_mem =>
        ⟨ρ B, fun y hy => (hρ_mono_nonneg y B hy.1 hy.2 hB_mem).2⟩
      h_mem_and_inv := hh_spec
      h_strictMono := hh_strictMono
      h_left_inv := hh_left_inv
      μ_mono := hμ_mono
      exp_μ_ge_secant := by
        intro z hz
        obtain ⟨hh_ge, hh_mem, hh_eq⟩ := hh_spec z hz
        calc (z - ρ 0) / h z
            = (ρ (h z) - ρ 0) / h z := by rw [hh_eq]
          _ ≤ D_plus (h z) := hD_secant_zero (h z) hh_mem (lt_of_lt_of_le hb_pos hh_ge)
          _ = Real.exp (μ z) := (hexp_μ z hz).symm
      exp_μ_ge_base := by
        intro z hz
        obtain ⟨hh_ge, hh_mem, _⟩ := hh_spec z hz
        rw [hexp_μ z hz]
        exact hs₀_le_D (h z) hh_mem hh_ge
      chord_bounds := h_chord
      exp_decay_height := by
        intro c R_star hc hR_star hμ_lin R₁ R₂ hR₁ hR₁₂
        let M : ℕ := ⌊R₂ - R₁⌋₊ + 1
        have hR₂_lt : R₂ < R₁ + (M : ℝ) := by
          dsimp [M]
          push_cast
          have := Nat.lt_floor_add_one (R₂ - R₁)
          linarith
        have hR₁_ge_b : ρ h_b ≤ R₁ := le_trans hR_star hR₁
        have hR₂_ge_b : ρ h_b ≤ R₂ := le_trans hR₁_ge_b hR₁₂
        have hRM_ge_b : ρ h_b ≤ R₁ + (M : ℝ) := le_trans hR₂_ge_b hR₂_lt.le
        have hh_lt : h R₂ < h (R₁ + (M : ℝ)) := hh_strictMono hR₂_ge_b hRM_ge_b hR₂_lt
        have h_tele : h (R₁ + (M : ℝ)) - h R₁ =
            ∑ j ∈ Finset.range M, (h (R₁ + ((j + 1 : ℕ) : ℝ)) - h (R₁ + (j : ℝ))) := by
          have hs := Finset.sum_range_sub (fun j : ℕ => h (R₁ + (j : ℝ))) M
          simpa using hs.symm
        let r : ℝ := Real.exp (-c)
        have hr_pos : 0 < r := Real.exp_pos _
        have hr_lt_one : r < 1 := by
          dsimp [r]
          calc Real.exp (-c) < Real.exp 0 := Real.exp_lt_exp.mpr (by linarith)
            _ = 1 := Real.exp_zero
        have hr_ne_one : r ≠ 1 := hr_lt_one.ne
        have h_step_le : ∀ j ∈ Finset.range M,
            h (R₁ + ((j + 1 : ℕ) : ℝ)) - h (R₁ + (j : ℝ)) ≤ Real.exp (-c * R₁) * r ^ j := by
          intro j _
          have hj_nn : (0 : ℝ) ≤ (j : ℝ) := Nat.cast_nonneg j
          have hz_ge_star : R_star ≤ R₁ + (j : ℝ) := by linarith
          have hz_ge_b : ρ h_b ≤ R₁ + (j : ℝ) := le_trans hR_star hz_ge_star
          have hz_lt : R₁ + (j : ℝ) < R₁ + ((j + 1 : ℕ) : ℝ) := by push_cast; linarith
          have hch := (h_chord (R₁ + (j : ℝ)) (R₁ + ((j + 1 : ℕ) : ℝ)) hz_ge_b hz_lt).2
          have hdiff_one : (R₁ + ((j + 1 : ℕ) : ℝ)) - (R₁ + (j : ℝ)) = 1 := by push_cast; ring
          rw [hdiff_one, mul_one] at hch
          have hμ_ge : c * (R₁ + (j : ℝ)) ≤ μ (R₁ + (j : ℝ)) := hμ_lin _ hz_ge_star
          have hexp_le : Real.exp (-μ (R₁ + (j : ℝ))) ≤ Real.exp (-c * (R₁ + (j : ℝ))) :=
            Real.exp_le_exp.mpr (by linarith)
          have hexp_eq : Real.exp (-c * (R₁ + (j : ℝ))) = Real.exp (-c * R₁) * r ^ j := by
            dsimp [r]
            rw [← Real.exp_nat_mul, ← Real.exp_add]
            congr 1
            ring
          exact le_trans hch (by rwa [← hexp_eq])
        have h_sum_le :
            ∑ j ∈ Finset.range M, (h (R₁ + ((j + 1 : ℕ) : ℝ)) - h (R₁ + (j : ℝ))) ≤
              Real.exp (-c * R₁) * ∑ j ∈ Finset.range M, r ^ j := by
          rw [Finset.mul_sum]
          exact Finset.sum_le_sum h_step_le
        have h_geom : ∑ j ∈ Finset.range M, r ^ j ≤ 1 / (1 - r) := by
          rw [geom_sum_eq hr_ne_one]
          have h_eq : (r ^ M - 1) / (r - 1) = (1 - r ^ M) / (1 - r) := by
            have h1 : 1 - r ≠ 0 := by linarith
            have h2 : r - 1 ≠ 0 := by linarith
            field_simp [h1, h2]
            ring
          rw [h_eq]
          exact div_le_div_of_nonneg_right (by linarith [pow_pos hr_pos M]) (by linarith)
