      _ ≤ MeasureTheory.volume.real (E_p ∪ E_m) + MeasureTheory.volume.real (E_0p ∪ E_0m) :=
          MeasureTheory.measureReal_union_le _ _
      _ ≤ (MeasureTheory.volume.real E_p + MeasureTheory.volume.real E_m) +
