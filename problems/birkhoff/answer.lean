    have hH₃_pos : 0 < H₃ := by dsimp [H₃]; linarith
    have hH₃_lt : H₃ < S.H := by dsimp [H₃, η]; linarith
    have hlsc_at : ∀ᶠ t in nhdsWithin (0 : ℂ) (Metric.ball (0 : ℂ) S.r_star), H₃ < S.h_X t :=
      S.h_X_lsc 0 (Metric.mem_ball_self S.r_star_pos) H₃ (by dsimp only; rw [S.h_X_zero]; exact hH₃_lt)
