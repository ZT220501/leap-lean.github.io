                (nhds ((q : ℝ) ^ 2 * ‖iteratedDeriv k (d_star j) z‖)) :=
            (hd_star_tend j hj k z hz).norm.const_mul ((q : ℝ) ^ 2)
          exact le_of_tendsto' hConv (fun n => ((hd_iter_ball n).2.2.1 j hj).2.2.2 k hk z hz)
      · intro j hj k hk z hz
        have hConv :
            Filter.Tendsto
              (fun n => (q : ℝ) ^ 3 * ‖iteratedDeriv k (fun ζ => d n (j + 1) ζ - d n j ζ) z‖)
