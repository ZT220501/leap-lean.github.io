          (le_of_lt hM₁) (le_of_lt hBp_pos) hW0.1
          (fun j hj u hu => hW0.2.2.2 j (by omega) u hu)
          hX_holo hX_maps hX_deriv
      have hWX : IsStripHoloSymBounded p₀ σ' M_W (fun z => W (z + (ρ : ℂ) + e_X z)) :=
