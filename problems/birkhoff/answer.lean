                  have := Finsupp.ext_iff.mp hp_eq j
                  simpa [Finsupp.single_eq_of_ne hji] using this
                have hp2j : p.2 j = 0 := by omega
                simp [Finsupp.single_eq_of_ne hji, hp2j]
