        3 * R₀ / (q : ℝ) ^ 2 ≤ 1 / (q : ℝ) ∧ 3 * R₀ / (q : ℝ) ^ 2 ≤ 1 := by
      intro q hq
      have hq4_nat : 4 ≤ q := le_trans hN_ge4 hq
      have hq4 : (4 : ℝ) ≤ (q : ℝ) := by exact_mod_cast hq4_nat
      have hq_pos : 0 < (q : ℝ) := by linarith
      have hq_ceil : (Nat.ceil (4 * R₀) + 4 : ℕ) ≤ q := le_trans (le_max_right _ _) hq
      have h4R_le_q : 4 * R₀ ≤ (q : ℝ) := by
        have h1 : 4 * R₀ ≤ (Nat.ceil (4 * R₀) : ℝ) := Nat.le_ceil (4 * R₀)
        have h2 : (Nat.ceil (4 * R₀) : ℝ) ≤ (q : ℝ) := by
          exact_mod_cast le_trans (Nat.le_add_right _ 4) hq_ceil
        linarith
      have h1q : 1 / (q : ℝ) ≤ 1 := by
        rw [div_le_iff₀ hq_pos]; linarith
      have hR_q2_le_1q : 3 * R₀ / (q : ℝ) ^ 2 ≤ 1 / (q : ℝ) := by
        rw [div_le_div_iff₀ (sq_pos_of_pos hq_pos) hq_pos]
        nlinarith
      have h2R_q2_le_1q : 2 * R₀ / (q : ℝ) ^ 2 ≤ 1 / (q : ℝ) := by
