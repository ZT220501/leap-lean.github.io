      have h_gt : Real.sqrt VQ < E1 := lt_of_not_ge h_not_le
      have hE1_pos : 0 < E1 := lt_of_le_of_lt (Real.sqrt_nonneg VQ) h_gt
      have h_pt_amgm : ∀ om : dtpcChainSpace M,
