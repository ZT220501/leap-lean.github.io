            N_vert ⟨0, hL_pos⟩ q c p / D_vert ⟨0, hL_pos⟩ q c p = dualLineShift C q c p) ∧
      (∀ (k : ℕ) (hk : k + 1 < L_vert),
        let i₀ : Fin L_vert := ⟨k, Nat.lt_of_succ_lt hk⟩
        let i₁ : Fin L_vert := ⟨k + 1, hk⟩
        (Metric.ball (c_vert i₀) (R_vert i₀) ∩
          Metric.ball (c_vert i₁) (R_vert i₁)).Nonempty ∧
