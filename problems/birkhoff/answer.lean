              rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (ha_bounds n om).1]
              exact le_trans (mul_le_mul (ha_bounds n om).2.1 (hStepBounds n om).1
                (norm_nonneg _) zero_le_one) (one_mul S.H).le
          _ = (N_cap : ℝ) * S.H := by simp
      have hCrossZero : ∀ m n : ℕ, m < n → n < N_cap →
          MeasureTheory.Integrable
