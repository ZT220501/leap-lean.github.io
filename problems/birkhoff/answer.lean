      have hα_full_eq : (fun s' => (a : ℂ) + (τ : ℂ) ^ p * X_fam_J τ e s') =
          fun s' => M.α₀ (τ ^ p) s' +
            ∑ r' : Fin (J + 1), ((τ : ℂ) ^ 2 * e) ^ (r' : ℕ) * M.β r' (τ ^ p) s' := by
        ext s'
        have hr := hα_rescale J le_rfl τ hτ_pos hτp_mem e s'
        have hfilt_univ : Finset.univ.filter (fun r' : Fin (J + 1) => (r' : ℕ) < J + 1) =
            Finset.univ := Finset.filter_true_of_mem fun r' _ => r'.2
        rw [hfilt_univ] at hr
        exact hr
      dsimp only [F_term2]
      rw [hα_full_eq, Finset.mul_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun q _ => ?_
      by_cases hpq : p ≤ (q : ℕ)
      · rw [if_pos hpq, if_pos hpq]
        have hpow_q : ((τ : ℂ) ^ 2) ^ ((q : ℕ) - 1) * (τ : ℂ) ^ 2 =
            (τ : ℂ) ^ (2 * ((q : ℕ) - p)) * (τ : ℂ) ^ (2 * p) := by
          rw [← pow_mul, ← pow_add, ← pow_add]
          congr 1; omega
        have h3p : ((τ : ℂ) ^ (3 * p))⁻¹ = ((τ : ℂ) ^ (2 * p))⁻¹ * ((τ : ℂ) ^ p)⁻¹ := by
          have h3 : 3 * p = 2 * p + p := by omega
          rw [h3, pow_add, _root_.mul_inv_rev, mul_comm]
        rw [mul_pow]
        calc ((q : ℕ) : ℂ) * e ^ ((q : ℕ) - 1) * (τ : ℂ) ^ (2 * ((q : ℕ) - p)) *
              M.g i q _ * (2 * Complex.sin _ * ((τ : ℂ) ^ p)⁻¹)
            = (((τ : ℂ) ^ (2 * ((q : ℕ) - p)) * (τ : ℂ) ^ (2 * p)) *
                (((τ : ℂ) ^ (2 * p))⁻¹ * ((τ : ℂ) ^ p)⁻¹)) *
              (((q : ℕ) : ℂ) * e ^ ((q : ℕ) - 1) * M.g i q _ * (2 * Complex.sin _)) := by
              field_simp [hτ2p_ne]
          _ = ((τ : ℂ) ^ 2 * ((τ : ℂ) ^ (3 * p))⁻¹) *
              (((q : ℕ) : ℂ) * (((τ : ℂ) ^ 2) ^ ((q : ℕ) - 1) * e ^ ((q : ℕ) - 1)) *
                M.g i q _ * (2 * Complex.sin _)) := by
              rw [← hpow_q, ← h3p]; ring
      · rw [if_neg hpq, if_neg hpq, mul_zero]
    rw [hF_eq, h_cmul]
    have hcomp := h_comp_mul ((τ : ℂ) ^ 2)
      (fun ε : ℂ =>
        ∑ i : Fin k, ∑ q : Fin (J + 1),
          if p ≤ (q : ℕ) then
            ((q : ℕ) : ℂ) * ε ^ ((q : ℕ) - 1) *
              M.g i q (lineChainMid (fun s' => M.α₀ (τ ^ p) s' +
                ∑ r' : Fin (J + 1), ε ^ (r' : ℕ) * M.β r' (τ ^ p) s') i) *
              (2 * Complex.sin (lineChainHalfStep (fun s' => M.α₀ (τ ^ p) s' +
                ∑ r' : Fin (J + 1), ε ^ (r' : ℕ) * M.β r' (τ ^ p) s') i))
          else 0) (l₀ - 1) 0
    rw [mul_zero] at hcomp
    rw [hcomp, hjet2]
    have hexp_l₀ : (τ : ℂ) ^ 2 * (((τ : ℂ) ^ 2) ^ (l₀ - 1)) = (τ : ℂ) ^ (2 * l₀) := by
      rw [← pow_mul, ← pow_add]
      congr 1; omega
    dsimp [C_rhs]
    calc ((τ : ℂ) ^ 2 * ((τ : ℂ) ^ (3 * p))⁻¹) *
          (((τ : ℂ) ^ 2) ^ (l₀ - 1) * ((l₀.factorial : ℂ) * M.K l₀_fin))
        = ((l₀.factorial : ℂ) * M.K l₀_fin) *
            (((τ : ℂ) ^ 2 * (((τ : ℂ) ^ 2) ^ (l₀ - 1))) * ((τ : ℂ) ^ (3 * p))⁻¹) := by ring
      _ = (l₀.factorial : ℂ) * M.K l₀_fin *
            ((τ : ℂ) ^ (2 * l₀) * ((τ : ℂ) ^ (3 * p))⁻¹) := by rw [hexp_l₀]
  let L_lim : ℂ := iteratedDeriv (l₀ - 1) f_term2_lim 0
  have hRHS_tendsto_L :
      Filter.Tendsto (fun τ : ℝ => C_rhs * ((τ : ℂ) ^ (2 * l₀) * ((τ : ℂ) ^ (3 * p))⁻¹))
        φ (nhds L_lim) :=
    hLHS_tendsto.congr' hRHS_ev
  have hτ_to_0 : Filter.Tendsto (fun τ : ℝ => (τ : ℂ)) φ (nhds 0) := by
    simpa using (Complex.continuous_ofReal.tendsto 0).mono_left nhdsWithin_le_nhds
  have hL_zero : L_lim = 0 := by
    cases d with
    | zero =>
      have h_inv_p : Filter.Tendsto (fun τ : ℝ => C_rhs * ((τ : ℂ) ^ p)⁻¹) φ (nhds L_lim) := by
        refine hRHS_tendsto_L.congr' (hτ_ev.mono fun τ ⟨hτ_pos, _⟩ => ?_)
        have hτ2p_ne : (τ : ℂ) ^ (2 * p) ≠ 0 :=
          pow_ne_zero (2 * p) (Complex.ofReal_ne_zero.mpr (ne_of_gt hτ_pos))
        have h2l0 : 2 * l₀ = 2 * p := by dsimp [l₀, m]; omega
        have h3p : 3 * p = 2 * p + p := by omega
        rw [h2l0, h3p, pow_add, _root_.mul_inv_rev]
        field_simp [hτ2p_ne]
      have hτp_0 : Filter.Tendsto (fun τ : ℝ => (τ : ℂ) ^ p) φ (nhds 0) := by
        have h0 : (0 : ℂ) ^ p = 0 := zero_pow (by omega)
        simpa [h0] using hτ_to_0.pow p
      have hmul_0 : Filter.Tendsto (fun τ : ℝ => (C_rhs * ((τ : ℂ) ^ p)⁻¹) * (τ : ℂ) ^ p)
          φ (nhds 0) := by
        simpa using h_inv_p.mul hτp_0
      have hmul_const : Filter.Tendsto (fun τ : ℝ => (C_rhs * ((τ : ℂ) ^ p)⁻¹) * (τ : ℂ) ^ p)
          φ (nhds C_rhs) := by
        refine tendsto_const_nhds.congr' (hτ_ev.mono fun τ ⟨hτ_pos, _⟩ => ?_)
        dsimp only
        have hτp_ne : (τ : ℂ) ^ p ≠ 0 :=
          pow_ne_zero p (Complex.ofReal_ne_zero.mpr (ne_of_gt hτ_pos))
        rw [mul_assoc, inv_mul_cancel₀ hτp_ne, mul_one]
      have hC0 : C_rhs = 0 := tendsto_nhds_unique hmul_const hmul_0
      have h0_lim : Filter.Tendsto (fun τ : ℝ => C_rhs * ((τ : ℂ) ^ p)⁻¹) φ (nhds 0) := by
        simp_rw [hC0, zero_mul]
        exact tendsto_const_nhds
      exact tendsto_nhds_unique h_inv_p h0_lim
    | succ d' =>
      have h2m3 : 2 * m - 3 = 2 * d' + 1 := by dsimp [m]; omega
      let e_pos : ℕ := (2 * m - 3) * p
      have he_pos : 1 ≤ e_pos := by dsimp [e_pos]; rw [h2m3]; nlinarith
      have h_pos_pow : Filter.Tendsto (fun τ : ℝ => C_rhs * (τ : ℂ) ^ e_pos) φ (nhds 0) := by
        have h0 : (0 : ℂ) ^ e_pos = 0 := zero_pow (by omega)
        have hp0 : Filter.Tendsto (fun τ : ℝ => (τ : ℂ) ^ e_pos) φ (nhds 0) := by
          simpa [h0] using hτ_to_0.pow e_pos
        simpa using (tendsto_const_nhds (x := C_rhs)).mul hp0
      have h_pos_lim : Filter.Tendsto (fun τ : ℝ => C_rhs * (τ : ℂ) ^ e_pos) φ (nhds L_lim) := by
        refine hRHS_tendsto_L.congr' (hτ_ev.mono fun τ ⟨hτ_pos, _⟩ => ?_)
        dsimp only
        have hτ3p_ne : (τ : ℂ) ^ (3 * p) ≠ 0 :=
          pow_ne_zero (3 * p) (Complex.ofReal_ne_zero.mpr (ne_of_gt hτ_pos))
        have hexp : 2 * l₀ = e_pos + 3 * p := by
          dsimp [l₀, e_pos]; rw [h2m3]; dsimp [m]; ring
        rw [hexp, pow_add, mul_assoc ((τ : ℂ) ^ e_pos), mul_inv_cancel₀ hτ3p_ne, mul_one]
      exact tendsto_nhds_unique h_pos_lim h_pos_pow
  dsimp [L_lim] at hL_zero
  rw [hf_term2_deriv] at hL_zero
  have hfac_ne : ((l₀ - 1).factorial : ℂ) ≠ 0 :=
    Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)
  have h1 := (mul_eq_zero.mp hL_zero).resolve_left hp_ne
  exact (mul_eq_zero.mp h1).resolve_left hfac_ne

theorem line_endpoint_chain_determination (Ω : Set Plane)
    (C : AnalyticGlancingCollar Ω)
    (B : BaseCollarAndCramerData C)
    (hAlg : AlgebraicLiftingToolkit)
    (hWeb : FiniteWebContinuationProp) :
    LineEndpointDetProp C B.s_det B.r_det :=
by
  intro k hk j hj0 hjk ι
  obtain ⟨G⟩ := line_glancing_chart_and_hessian Ω C B k hk
  let W : Set (ℂ × ℂ) := lineChainBox C B k
  have hk_pos : (0 : ℝ) < (k : ℝ) := by positivity
  have hW_open : IsOpen W := by
    refine IsOpen.inter ?_ ?_
    · exact isOpen_lt (continuous_abs.comp (Complex.continuous_im.comp continuous_fst))
        continuous_const
    · exact isOpen_lt (continuous_norm.comp continuous_snd) continuous_const
  have hW_convex : Convex ℝ W := by
    intro p hp q hq a b ha hb hab
    rcases eq_or_lt_of_le ha with rfl | ha_pos
    · simp_all
    · refine ⟨?_, ?_⟩
      · have h1 : (a • p + b • q).1.im = a * p.1.im + b * q.1.im := by simp
        rw [h1]
        calc |a * p.1.im + b * q.1.im|
            ≤ |a * p.1.im| + |b * q.1.im| := abs_add_le _ _
          _ = a * |p.1.im| + b * |q.1.im| := by
              rw [abs_mul, abs_mul, abs_of_nonneg ha, abs_of_nonneg hb]
          _ < a * B.s_det + b * B.s_det := by
              have hlt1 : a * |p.1.im| < a * B.s_det := mul_lt_mul_of_pos_left hp.1 ha_pos
              have hle2 : b * |q.1.im| ≤ b * B.s_det :=
                mul_le_mul_of_nonneg_left (le_of_lt hq.1) hb
              linarith
          _ = B.s_det := by rw [← add_mul, hab, one_mul]
      · have h2 : (a • p + b • q).2 = a • p.2 + b • q.2 := rfl
        rw [h2]
        calc ‖a • p.2 + b • q.2‖
            ≤ ‖a • p.2‖ + ‖b • q.2‖ := norm_add_le _ _
          _ = a * ‖p.2‖ + b * ‖q.2‖ := by
              rw [norm_smul, norm_smul, Real.norm_of_nonneg ha, Real.norm_of_nonneg hb]
          _ < a * (B.r_det / (k : ℝ)) + b * (B.r_det / (k : ℝ)) := by
              have hlt1 : a * ‖p.2‖ < a * (B.r_det / (k : ℝ)) :=
                mul_lt_mul_of_pos_left hp.2 ha_pos
              have hle2 : b * ‖q.2‖ ≤ b * (B.r_det / (k : ℝ)) :=
                mul_le_mul_of_nonneg_left (le_of_lt hq.2) hb
              linarith
          _ = B.r_det / (k : ℝ) := by rw [← add_mul, hab, one_mul]
  have hW_nonempty : W.Nonempty := by
    refine ⟨(0, 0), ?_⟩
    simp [W, lineChainBox, B.s_det_pos, div_pos B.r_det_pos hk_pos]
  have hemb_exhaust : ∀ S : Finset LineJetAll,
      ∃ M : ℕ, (S : Set LineJetAll) ⊆ Set.range (lineJetEmb M) := by
    intro S
    refine ⟨S.sup (fun v => max v.2.2.1 v.2.2.2), ?_⟩
    intro v hv
    have hv_sup : max v.2.2.1 v.2.2.2 ≤ S.sup (fun u => max u.2.2.1 u.2.2.2) :=
      Finset.le_sup (f := fun u : LineJetAll => max u.2.2.1 u.2.2.2) hv
    have h1 : v.2.2.1 < S.sup (fun u => max u.2.2.1 u.2.2.2) + 1 :=
      Nat.lt_succ_of_le ((le_max_left _ _).trans hv_sup)
    have h2 : v.2.2.2 < S.sup (fun u => max u.2.2.1 u.2.2.2) + 1 :=
      Nat.lt_succ_of_le ((le_max_right _ _).trans hv_sup)
    exact ⟨(v.1, v.2.1, ⟨v.2.2.1, h1⟩, ⟨v.2.2.2, h2⟩), rfl⟩
  have hShift_maps : ∀ (m : ℕ), m ≤ k →
      Set.MapsTo (fun q : ℂ × ℂ => (q.1 + (m : ℂ) * q.2, q.2)) W
        { p : ℂ × ℂ | |p.1.im| < 2 * B.s_det ∧ ‖p.2‖ < 2 * B.r_det } := by
    intro m hm q hq
    have hm_le : (m : ℝ) ≤ (k : ℝ) := Nat.cast_le.mpr hm
    have hq2_nonneg : 0 ≤ ‖q.2‖ := norm_nonneg _
    have h_im_le : |((m : ℂ) * q.2).im| ≤ (k : ℝ) * ‖q.2‖ := by
      calc |((m : ℂ) * q.2).im|
          ≤ ‖(m : ℂ) * q.2‖ := Complex.abs_im_le_norm _
        _ = (m : ℝ) * ‖q.2‖ := by rw [norm_mul, Complex.norm_natCast]
        _ ≤ (k : ℝ) * ‖q.2‖ := mul_le_mul_of_nonneg_right hm_le hq2_nonneg
    have h_mul_lt : (k : ℝ) * ‖q.2‖ < B.r_det := (lt_div_iff₀' hk_pos).mp hq.2
    refine ⟨?_, ?_⟩
    · have him_eq : (q.1 + (m : ℂ) * q.2).im = q.1.im + ((m : ℂ) * q.2).im :=
        Complex.add_im _ _
      rw [him_eq]
      have htri : |q.1.im + ((m : ℂ) * q.2).im| ≤ |q.1.im| + |((m : ℂ) * q.2).im| :=
        abs_add_le _ _
      linarith [hq.1, B.r_det_lt_s_det, B.s_det_pos]
    · have hk_ge1 : (1 : ℝ) ≤ (k : ℝ) := by exact_mod_cast (by omega : 1 ≤ k)
      have hdiv_le : B.r_det / (k : ℝ) ≤ B.r_det :=
        div_le_self (le_of_lt B.r_det_pos) hk_ge1
      linarith [hq.2, B.r_det_pos]
  have hShift_holo : ∀ (m : ℕ), m ≤ k → ∀ c : Fin 2,
      DifferentiableOn ℂ (fun q : ℂ × ℂ => glancingDualLine C (q.1 + (m : ℂ) * q.2) q.2 c) W := by
    intro m hm c
    have haff : Differentiable ℂ (fun q : ℂ × ℂ => (q.1 + (m : ℂ) * q.2, q.2)) :=
      (differentiable_fst.add (differentiable_const _ |>.mul differentiable_snd)).prodMk
        differentiable_snd
    change DifferentiableOn ℂ
      ((fun p : ℂ × ℂ => glancingDualLine C p.1 p.2 c) ∘
        (fun q : ℂ × ℂ => (q.1 + (m : ℂ) * q.2, q.2))) W
    exact (B.dualLine_holo c).comp haff.differentiableOn (hShift_maps m hm)
  have hW_sub_base : W ⊆ { p : ℂ × ℂ | |p.1.im| < 2 * B.s_det ∧ ‖p.2‖ < 2 * B.r_det } := by
    intro q hq
    refine ⟨by linarith [hq.1, B.s_det_pos], ?_⟩
    have hk_ge1 : (1 : ℝ) ≤ (k : ℝ) := by exact_mod_cast (by omega : 1 ≤ k)
    have hdiv_le : B.r_det / (k : ℝ) ≤ B.r_det :=
      div_le_self (le_of_lt B.r_det_pos) hk_ge1
    linarith [hq.2, B.r_det_pos]
  have hjet_holo : ∀ v : LineJetAll, DifferentiableOn ℂ (lineJetFnAll C k v) W := by
    intro v
    unfold lineJetFnAll
    split_ifs
    · exact B.iterDerivYT_holo hW_open ((B.dualLine_holo v.2.1).mono hW_sub_base) v.2.2.1 v.2.2.2
    · exact B.iterDerivYT_holo hW_open (hShift_holo k le_rfl v.2.1) v.2.2.1 v.2.2.2
  let zFn : ℂ × ℂ → ℂ := fun p => glancingDualLine C (p.1 + (j : ℂ) * p.2) p.2 ι
  have hzFn_holo : DifferentiableOn ℂ zFn W :=
    hShift_holo j (le_of_lt hjk) ι
  have h_strip_open : IsOpen (horizStrip (2 * C.s_h)) :=
    isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const
  have h_real_mem_strip : ∀ θ : ℝ, (θ : ℂ) ∈ horizStrip (2 * C.s_h) := by
    intro θ
    simp [horizStrip, C.s_h_pos]
  have h_deriv1_real : ∀ θ : ℝ, deriv C.h_ℂ (θ : ℂ) = ((deriv C.h θ : ℝ) : ℂ) := by
    intro θ
    have hℂ : HasDerivAt (fun x : ℝ => C.h_ℂ (x : ℂ)) (deriv C.h_ℂ (θ : ℂ)) θ :=
      ((C.h_ℂ_holo.differentiableAt (h_strip_open.mem_nhds (h_real_mem_strip θ))).hasDerivAt).comp_ofReal
    have hℝ : HasDerivAt (fun x : ℝ => ((C.h x : ℝ) : ℂ)) ((deriv C.h θ : ℝ) : ℂ) θ :=
      (((C.h_smooth.differentiable (by simp)).differentiableAt).hasDerivAt).ofReal_comp
    have hfun : (fun x : ℝ => C.h_ℂ (x : ℂ)) = (fun x : ℝ => ((C.h x : ℝ) : ℂ)) :=
      funext C.h_ℂ_real
    exact hℂ.unique (hfun ▸ hℝ)
  have hh'_holo : DifferentiableOn ℂ (deriv C.h_ℂ) (horizStrip (2 * C.s_h)) :=
    C.h_ℂ_holo.deriv h_strip_open
  have h_deriv2_real : ∀ θ : ℝ,
      deriv (deriv C.h_ℂ) (θ : ℂ) = ((deriv (deriv C.h) θ : ℝ) : ℂ) := by
    intro θ
    have hℂ : HasDerivAt (fun x : ℝ => deriv C.h_ℂ (x : ℂ)) (deriv (deriv C.h_ℂ) (θ : ℂ)) θ :=
      ((hh'_holo.differentiableAt (h_strip_open.mem_nhds (h_real_mem_strip θ))).hasDerivAt).comp_ofReal
    have hh'_smooth : ContDiff ℝ ((1 : WithTop ℕ∞)) (deriv C.h) := by
      have h2 : ContDiff ℝ ((1 : WithTop ℕ∞) + 1) C.h := C.h_smooth.of_le (by decide)
      exact h2.deriv'
    have hℝ : HasDerivAt (fun x : ℝ => ((deriv C.h x : ℝ) : ℂ))
        ((deriv (deriv C.h) θ : ℝ) : ℂ) θ :=
      ((hh'_smooth.differentiable_one.differentiableAt).hasDerivAt).ofReal_comp
    have hfun : (fun x : ℝ => deriv C.h_ℂ (x : ℂ)) = (fun x : ℝ => ((deriv C.h x : ℝ) : ℂ)) :=
      funext h_deriv1_real
    exact hℂ.unique (hfun ▸ hℝ)
  have hr_ne_all : ∀ a : ℝ, C.h_ℂ (a : ℂ) + deriv (deriv C.h_ℂ) (a : ℂ) ≠ 0 := by
    intro a
    rw [C.h_ℂ_real a, h_deriv2_real a, ← Complex.ofReal_add]
    exact Complex.ofReal_ne_zero.mpr (ne_of_gt (C.r_pos a))
  have hK0_count : Countable (↥(⊥ : Subfield ℂ)) := by
    rw [Subfield.bot_eq_of_charZero]
    exact Set.countable_range (algebraMap ℚ ℂ)
  have ha_lt : G.a₀ - G.R / 4 < G.a₀ + G.R / 4 := by linarith [G.R_pos]
  have ha_sub : ∀ a ∈ Set.Ioo (G.a₀ - G.R / 4) (G.a₀ + G.R / 4), (a : ℂ) ∈ G.U_a := by
    intro a ha
    rw [LineGlancingChartData.U_a, Metric.mem_ball, Complex.dist_eq, ← Complex.ofReal_sub,
      Complex.norm_real, Real.norm_eq_abs, abs_lt]
    constructor <;> linarith [ha.1, ha.2, G.R_pos]
  have hd_sub : ∀ d ∈ Set.Ioo (0 : ℝ) G.δ_star, (d : ℂ) ∈ G.U_d := by
    intro d hd
    rw [LineGlancingChartData.U_d, Metric.mem_ball, dist_zero_right, Complex.norm_real,
      Real.norm_eq_abs, abs_of_pos hd.1]
    linarith [hd.2, G.δ_star_pos]
  have hΨ_maps_W : ∀ q ∈ G.U_a ×ˢ G.U_d, G.Ψ q ∈ W :=
    fun q hq => G.V_W_sub (G.Ψ_maps_V_W q hq)
  have hΨ_surj_V : ∀ p ∈ G.V_W, ∃ q ∈ G.U_a ×ˢ G.U_d, G.Ψ q = p := by
    intro p hp
    exact ⟨_, (G.Φ_right_inv p hp).1, (G.Φ_right_inv p hp).2⟩
  have hPtAlg : ∀ a₁ ∈ Set.Ioo (G.a₀ - G.R / 4) (G.a₀ + G.R / 4),
      ∀ δ₁ ∈ Set.Ioo (0 : ℝ) G.δ_star,
        IsAlgebraic (↥(linePointField C k G.Ψ a₁ δ₁))
          (zFn (G.Ψ ((a₁ : ℂ), (δ₁ : ℂ)))) := by
    intro a₁ ha₁ δ₁ hδ₁
    obtain ⟨E⟩ := line_core_vandermonde_elimination Ω C B k hk G hAlg a₁ δ₁ ha₁ hδ₁
    have hCoreAlg : ∀ r : Fin E.N_core, IsAlgebraic (↥E.K_end) (E.coreTuple r) := by
      by_contra hNotAll
      rw [not_forall] at hNotAll
      obtain ⟨D_cont⟩ :=
        line_formal_arc_web_continuation Ω C B k hk G a₁ δ₁ ha₁ hδ₁ E hAlg hWeb hNotAll
      have hg_zero_Ioo : ∀ a ∈ Set.Ioo (G.a₀ - G.R) (G.a₀ + G.R),
          D_cont.g_lead D_cont.i₀ (a : ℂ) = 0 := by
        intro a ha
        exact line_coalescing_cubic_variational_zero k D_cont.p hk D_cont.p_pos a C.h_ℂ
          (hr_ne_all a) (fun i => D_cont.g_lead i (a : ℂ)) hAlg
          (fun n hn => D_cont.trunc_models (n * D_cont.p)
            (by nlinarith [D_cont.p_pos]) a ha)
          D_cont.i₀
      have hg_analytic : AnalyticOnNhd ℂ (D_cont.g_lead D_cont.i₀) D_cont.W_lead :=
        (Complex.analyticOnNhd_iff_differentiableOn D_cont.W_lead_open).mpr
          (D_cont.g_lead_holo D_cont.i₀)
      have ha₀_mem : (G.a₀ : ℂ) ∈ D_cont.W_lead :=
        D_cont.real_mem_W_lead G.a₀ (by simp [G.R_pos])
      have h_freq : ∃ᶠ z in nhdsWithin (G.a₀ : ℂ) {(G.a₀ : ℂ)}ᶜ,
          D_cont.g_lead D_cont.i₀ z = 0 := by
        let x_seq : ℕ → ℝ := fun n => G.a₀ + G.R / ((n : ℝ) + 2)
        have hx_tendsto_R : Filter.Tendsto x_seq Filter.atTop (nhds G.a₀) := by
          have hdiv : Filter.Tendsto (fun n : ℕ => G.R / ((n : ℝ) + 2)) Filter.atTop (nhds 0) :=
            tendsto_const_nhds.div_atTop
              (Filter.tendsto_atTop_add_const_right _ 2 tendsto_natCast_atTop_atTop)
          simpa [x_seq] using tendsto_const_nhds.add hdiv
        have hx_tendsto_C : Filter.Tendsto (fun n : ℕ => (x_seq n : ℂ))
            Filter.atTop (nhds (G.a₀ : ℂ)) :=
          (Complex.continuous_ofReal.tendsto G.a₀).comp hx_tendsto_R
        have hx_ne : ∀ n : ℕ, (x_seq n : ℂ) ∈ ({(G.a₀ : ℂ)}ᶜ : Set ℂ) := by
          intro n
          simp only [Set.mem_compl_iff, Set.mem_singleton_iff, Complex.ofReal_inj, x_seq]
          have hpos : 0 < G.R / ((n : ℝ) + 2) := div_pos G.R_pos (by positivity)
          linarith
        have hx_nhdsWithin : Filter.Tendsto (fun n : ℕ => (x_seq n : ℂ))
            Filter.atTop (nhdsWithin (G.a₀ : ℂ) {(G.a₀ : ℂ)}ᶜ) :=
          tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within _ hx_tendsto_C
            (Filter.Eventually.of_forall hx_ne)
        have hx_zero : ∀ n : ℕ, D_cont.g_lead D_cont.i₀ (x_seq n : ℂ) = 0 := by
          intro n
          apply hg_zero_Ioo (x_seq n)
          have hn_nonneg : (0 : ℝ) ≤ (n : ℝ) := Nat.cast_nonneg n
          have hden : (2 : ℝ) ≤ (n : ℝ) + 2 := by linarith
          have hpos : 0 < G.R / ((n : ℝ) + 2) := div_pos G.R_pos (by linarith)
          have hle : G.R / ((n : ℝ) + 2) ≤ G.R / 2 :=
            div_le_div_of_nonneg_left (le_of_lt G.R_pos) (by norm_num) hden
          constructor <;> linarith [G.R_pos]
        exact hx_nhdsWithin.frequently (Filter.Frequently.of_forall hx_zero)
      have hg_eq_zero : Set.EqOn (D_cont.g_lead D_cont.i₀) 0 D_cont.W_lead :=
        hg_analytic.eqOn_zero_of_preconnected_of_frequently_eq_zero
          D_cont.W_lead_preconn ha₀_mem h_freq
      let z₁ : ℂ := G.ψ_fn D_cont.i₀ ((a₁ : ℂ), (δ₁ : ℂ))
      have hz₁_mem : z₁ ∈ D_cont.W_lead := (D_cont.g_lead_taylor D_cont.i₀).1
      have h_ev_zero : D_cont.g_lead D_cont.i₀ =ᶠ[nhds z₁] (fun _ : ℂ => (0 : ℂ)) :=
        Filter.eventuallyEq_of_mem (D_cont.W_lead_open.mem_nhds hz₁_mem)
          (fun w hw => hg_eq_zero hw)
      have hf_zero : D_cont.f_lead D_cont.i₀ = 0 := by
        ext n
        rw [map_zero, ← (D_cont.g_lead_taylor D_cont.i₀).2 n,
          h_ev_zero.iteratedDeriv_eq n, iteratedDeriv_const]
        split_ifs <;> simp
      exact D_cont.f_lead_i₀_ne_zero hf_zero
    let z_val : ℂ := zFn (G.Ψ ((a₁ : ℂ), (δ₁ : ℂ)))
    have hz_mem_F : z_val ∈ E.F_val := E.dualLine_mem_F_val j hj0 hjk ι
    have hz_alg_Kend : IsAlgebraic (↥E.K_end) z_val := by
      by_contra hz_not_alg
      let c_ext : Fin (E.N_core + 1) → ℂ := Fin.snoc E.coreTuple z_val
      have hc_last : c_ext (Fin.last E.N_core) = z_val :=
        Fin.snoc_last (α := fun _ => ℂ) z_val E.coreTuple
      have hc_cast : ∀ r : Fin E.N_core, c_ext r.castSucc = E.coreTuple r :=
        fun r => Fin.snoc_castSucc (α := fun _ => ℂ) z_val E.coreTuple r
      have h_ext_nonAlg : ∃ s : Fin (E.N_core + 1), ¬ IsAlgebraic (↥E.K_end) (c_ext s) :=
        ⟨Fin.last E.N_core, hc_last.symm ▸ hz_not_alg⟩
      obtain ⟨Φ, hΦ_K, hΦ_const, ⟨s₀, hs₀_ne⟩⟩ :=
        hAlg.formal_arc E.K_end (E.N_core + 1) c_ext h_ext_nonAlg
      let F_ext : Subfield ℂ := Subfield.closure ((E.K_end : Set ℂ) ∪ Set.range c_ext)
      have hΦ_fixes_alg : ∀ (y : ↥F_ext),
          IsAlgebraic (↥E.K_end) (y : ℂ) → Φ y = PowerSeries.C (y : ℂ) := by
        intro y hy_alg
        rcases hy_alg with ⟨P, hP_ne, hP_aeval⟩
        let P_ℂ : Polynomial ℂ := P.map (algebraMap (↥E.K_end) ℂ)
        have hP_ℂ_ne : P_ℂ ≠ 0 :=
          Polynomial.map_ne_zero hP_ne
        have hP_ℂ_eval : P_ℂ.eval (y : ℂ) = 0 := by
          have haeval_eq : Polynomial.aeval (y : ℂ) P = P_ℂ.eval (y : ℂ) := by
            rw [Polynomial.aeval_def, Polynomial.eval₂_eq_eval_map]
          exact haeval_eq ▸ hP_aeval
        have hK_le_Fext : E.K_end ≤ F_ext :=
          fun x hx => Subfield.subset_closure (Or.inl hx)
        let ι_K : ↥E.K_end →+* ↥F_ext := Subfield.inclusion hK_le_Fext
        have hΦ_comp : Φ.comp ι_K = PowerSeries.C.comp (algebraMap (↥E.K_end) ℂ) :=
          RingHom.ext fun ⟨x, hx⟩ => hΦ_K x hx
        have hP_Φ_eval : (P_ℂ.map PowerSeries.C).eval (Φ y) = 0 := by
          have hmap : P_ℂ.map PowerSeries.C = (P.map ι_K).map Φ := by
            rw [Polynomial.map_map, Polynomial.map_map, hΦ_comp]
          rw [hmap, Polynomial.eval_map_apply Φ y, ← map_zero Φ]
          congr 1
          apply Subtype.ext
          change algebraMap (↥F_ext) ℂ ((P.map ι_K).eval y) = (0 : ℂ)
          have hval : (algebraMap (↥F_ext) ℂ).comp ι_K = algebraMap (↥E.K_end) ℂ := rfl
          rw [← Polynomial.eval_map_apply (algebraMap (↥F_ext) ℂ) y,
            Polynomial.map_map, hval]
          exact hP_ℂ_eval
        obtain ⟨Q, hPQ, hQ_ndvd⟩ :=
          Polynomial.exists_eq_pow_rootMultiplicity_mul_and_not_dvd P_ℂ hP_ℂ_ne (y : ℂ)
        have hQ_eval_ne : Q.eval (y : ℂ) ≠ 0 := by
          intro hQ0
          exact hQ_ndvd (Polynomial.dvd_iff_isRoot.mpr hQ0)
        have hprod_zero :
            (Φ y - PowerSeries.C (y : ℂ)) ^ (Polynomial.rootMultiplicity (y : ℂ) P_ℂ) *
              (Q.map PowerSeries.C).eval (Φ y) = 0 := by
          have h := hP_Φ_eval
          rw [hPQ, Polynomial.map_mul, Polynomial.map_pow, Polynomial.map_sub,
            Polynomial.map_X, Polynomial.map_C, Polynomial.eval_mul, Polynomial.eval_pow,
            Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C] at h
          exact h
        have hQ_ps_ne : (Q.map PowerSeries.C).eval (Φ y) ≠ 0 := by
          intro hQ_ps
          apply hQ_eval_ne
          have hc := congr_arg PowerSeries.constantCoeff hQ_ps
          rw [map_zero] at hc
          have hc_eq : PowerSeries.constantCoeff ((Q.map PowerSeries.C).eval (Φ y)) =
              Q.eval (y : ℂ) := by
            rw [← Polynomial.eval₂_eq_eval_map, Polynomial.hom_eval₂]
            have hcomp : PowerSeries.constantCoeff.comp (PowerSeries.C (R := ℂ)) =
                RingHom.id ℂ :=
              RingHom.ext fun w => by simp
            rw [hcomp, hΦ_const y, Polynomial.eval₂_id]
          exact hc_eq ▸ hc
        rcases mul_eq_zero.mp hprod_zero with hpow | hQ0
        · exact sub_eq_zero.mp (eq_zero_of_pow_eq_zero hpow)
        · exact False.elim (hQ_ps_ne hQ0)
      let L_fix : Subfield ℂ :=
        { carrier := { w : ℂ | ∃ hw : w ∈ F_ext, Φ ⟨w, hw⟩ = PowerSeries.C w }
          mul_mem' := by
            rintro a b ⟨ha, hΦa⟩ ⟨hb, hΦb⟩
            refine ⟨F_ext.mul_mem ha hb, ?_⟩
            change Φ (⟨a, ha⟩ * ⟨b, hb⟩) = PowerSeries.C (a * b)
            rw [map_mul, hΦa, hΦb, map_mul]
          one_mem' := ⟨F_ext.one_mem, by change Φ 1 = PowerSeries.C 1; rw [map_one, map_one]⟩
          add_mem' := by
            rintro a b ⟨ha, hΦa⟩ ⟨hb, hΦb⟩
            refine ⟨F_ext.add_mem ha hb, ?_⟩
            change Φ (⟨a, ha⟩ + ⟨b, hb⟩) = PowerSeries.C (a + b)
            rw [map_add, hΦa, hΦb, map_add]
          zero_mem' := ⟨F_ext.zero_mem, by change Φ 0 = PowerSeries.C 0; rw [map_zero, map_zero]⟩
          neg_mem' := by
            rintro a ⟨ha, hΦa⟩
            refine ⟨F_ext.neg_mem ha, ?_⟩
            change Φ (-⟨a, ha⟩) = PowerSeries.C (-a)
            rw [map_neg, hΦa, map_neg]
          inv_mem' := by
            rintro a ⟨ha, hΦa⟩
            refine ⟨F_ext.inv_mem ha, ?_⟩
            by_cases ha0 : a = 0
            · subst ha0
              have h0 : (⟨(0 : ℂ)⁻¹, F_ext.inv_mem ha⟩ : ↥F_ext) = 0 := by
                apply Subtype.ext
                exact _root_.inv_zero
              rw [h0, _root_.inv_zero, map_zero, map_zero]
            · have ha_sub_ne : (⟨a, ha⟩ : ↥F_ext) ≠ 0 := Subtype.coe_ne_coe.mp ha0
              have hCa_ne : (PowerSeries.C a : PowerSeries ℂ) ≠ 0 := by
                intro hC0
                exact ha0 (by simpa using congr_arg PowerSeries.constantCoeff hC0)
              apply mul_right_cancel₀ hCa_ne
              calc Φ ⟨a⁻¹, F_ext.inv_mem ha⟩ * PowerSeries.C a
                  = Φ ⟨a⁻¹, F_ext.inv_mem ha⟩ * Φ ⟨a, ha⟩ := by rw [← hΦa]
                _ = Φ (⟨a, ha⟩⁻¹ * ⟨a, ha⟩) := by rw [← map_mul]; rfl
                _ = 1 := by rw [inv_mul_cancel₀ ha_sub_ne, map_one]
                _ = PowerSeries.C (a⁻¹ * a) := by rw [inv_mul_cancel₀ ha0, map_one]
                _ = PowerSeries.C a⁻¹ * PowerSeries.C a := by rw [map_mul] }
      have hFval_le_Lfix : E.F_val ≤ L_fix := by
        apply Subfield.closure_le.mpr
        rintro w (hwK | ⟨r, rfl⟩)
        · exact ⟨Subfield.subset_closure (Or.inl hwK), hΦ_K w hwK⟩
        · have hr_mem : E.coreTuple r ∈ F_ext :=
            Subfield.subset_closure (Or.inr ⟨r.castSucc, hc_cast r⟩)
          exact ⟨hr_mem, hΦ_fixes_alg ⟨E.coreTuple r, hr_mem⟩ (hCoreAlg r)⟩
      rcases hFval_le_Lfix hz_mem_F with ⟨hz_Fext, hΦz⟩
      refine hs₀_ne ?_
      refine Fin.lastCases ?_ ?_ s₀
      · have hsub_eq : (⟨c_ext (Fin.last E.N_core),
            Subfield.subset_closure (Or.inr ⟨Fin.last E.N_core, rfl⟩)⟩ : ↥F_ext) =
            ⟨z_val, hz_Fext⟩ := Subtype.ext hc_last
        rw [hsub_eq, hc_last]
        exact hΦz
      · intro r
        have hr_mem : E.coreTuple r ∈ F_ext :=
          Subfield.subset_closure (Or.inr ⟨r.castSucc, hc_cast r⟩)
        have hsub_eq : (⟨c_ext r.castSucc,
            Subfield.subset_closure (Or.inr ⟨r.castSucc, rfl⟩)⟩ : ↥F_ext) =
            ⟨E.coreTuple r, hr_mem⟩ := Subtype.ext (hc_cast r)
        rw [hsub_eq, hc_cast r]
        exact hΦ_fixes_alg ⟨E.coreTuple r, hr_mem⟩ (hCoreAlg r)
    exact E.K_end_alg_over_pt z_val hz_alg_Kend
  obtain ⟨M, D, hD, Q, Disc, hVanish, ⟨p_wit, hp_wit, hQD_ne, hDisc_ne⟩, hSep⟩ :=
    hAlg.lift_separable LineJetAll LineJetVar lineJetEmb hemb_exhaust W hW_open hW_convex
      hW_nonempty (lineJetFnAll C k) zFn hjet_holo hzFn_holo
      (G.a₀ - G.R / 4) (G.a₀ + G.R / 4) 0 G.δ_star ha_lt G.δ_star_pos
      G.U_a G.U_d Metric.isOpen_ball (convex_ball _ _).isPreconnected
      Metric.isOpen_ball (convex_ball _ _).isPreconnected ha_sub hd_sub
      G.Ψ G.Ψ_holo hΨ_maps_W G.V_W G.V_W_open G.V_W_nonempty G.V_W_sub hΨ_surj_V
      (⊥ : Subfield ℂ) hPtAlg
  refine ⟨M, D, hD, Q, Disc, ?_, ?_, hSep⟩
  · intro y t hy ht
    exact hVanish (y, t) ⟨hy, ht⟩
  · exact ⟨p_wit.1, p_wit.2, hp_wit.1, hp_wit.2, hQD_ne, hDisc_ne⟩

theorem point_glancing_chart_and_symplectic (Ω : Set Plane)
    (C : AnalyticGlancingCollar Ω)
    (B : BaseCollarAndCramerData C)
    (k : ℕ) (hk : 2 ≤ k) :
    Nonempty (PointGlancingChartData C B k) :=
by
  
  have h_s1 : Nonempty (PointLocalGraphData C) := by
    let θ₀ : ℝ := C.ϕ 0
    have h_quad : ∃ rotIdx : Fin 4, 1 / 2 < -Real.sin (θ₀ + pointRotAngleR rotIdx) := by
      by_contra h_none
      push_neg at h_none
      have h0 := h_none ⟨0, by decide⟩
      have h1 := h_none ⟨1, by decide⟩
      have h2 := h_none ⟨2, by decide⟩
      have h3 := h_none ⟨3, by decide⟩
      have e0 : -Real.sin (θ₀ + pointRotAngleR ⟨0, by decide⟩) = -Real.sin θ₀ := by
        simp [pointRotAngleR]
      have e1 : -Real.sin (θ₀ + pointRotAngleR ⟨1, by decide⟩) = Real.sin θ₀ := by
        simp [pointRotAngleR, Real.sin_add_pi]
      have e2 : -Real.sin (θ₀ + pointRotAngleR ⟨2, by decide⟩) = Real.cos θ₀ := by
        change -Real.sin (θ₀ + -Real.pi / 2) = Real.cos θ₀
        rw [show θ₀ + -Real.pi / 2 = θ₀ - Real.pi / 2 by ring, Real.sin_sub,
          Real.cos_pi_div_two, Real.sin_pi_div_two]
        ring
      have e3 : -Real.sin (θ₀ + pointRotAngleR ⟨3, by decide⟩) = -Real.cos θ₀ := by
        change -Real.sin (θ₀ + Real.pi / 2) = -Real.cos θ₀
        rw [Real.sin_add_pi_div_two]
      rw [e0] at h0; rw [e1] at h1; rw [e2] at h2; rw [e3] at h3
      have hsq := Real.sin_sq_add_cos_sq θ₀
      nlinarith
    obtain ⟨rotIdx, h_sin_base⟩ := h_quad
    have h_rot_tan_all : ∀ (r : Fin 4) (θ : ℂ),
        rotCoordX r ![-Complex.sin θ, Complex.cos θ] =
          -Complex.sin (θ + pointRotAngle r) ∧
        rotCoordY r ![-Complex.sin θ, Complex.cos θ] =
          Complex.cos (θ + pointRotAngle r) := by
      intro r θ
      fin_cases r
      · simp [rotCoordX, rotCoordY, pointRotAngle, pointRotAngleR]
      · simp [rotCoordX, rotCoordY, pointRotAngle, pointRotAngleR,
          Complex.sin_add, Complex.cos_add]
      · simp only [rotCoordX, rotCoordY, pointRotAngle, pointRotAngleR,
          Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons]
        push_cast
        rw [show θ + -↑Real.pi / 2 = θ - Real.pi / 2 by ring,
          Complex.sin_sub, Complex.cos_sub, Complex.sin_pi_div_two, Complex.cos_pi_div_two]
        constructor <;> ring
      · simp only [rotCoordX, rotCoordY, pointRotAngle, pointRotAngleR,
          Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons]
        push_cast
        rw [Complex.sin_add, Complex.cos_add, Complex.sin_pi_div_two, Complex.cos_pi_div_two]
        constructor <;> ring
    let S_h : Set ℂ := horizStrip (2 * C.s_h)
    have hSh_open : IsOpen S_h :=
      isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const
    have h_real_mem_Sh : ∀ x : ℝ, (x : ℂ) ∈ S_h := by
      intro x; simp [S_h, horizStrip, C.s_h_pos]
    have hh'_holo : DifferentiableOn ℂ (deriv C.h_ℂ) S_h := C.h_ℂ_holo.deriv hSh_open
    have hh''_holo : DifferentiableOn ℂ (deriv (deriv C.h_ℂ)) S_h := hh'_holo.deriv hSh_open
    let r_ℂ : ℂ → ℂ := fun θ => C.h_ℂ θ + deriv (deriv C.h_ℂ) θ
    have hr_ℂ_holo : DifferentiableOn ℂ r_ℂ S_h := C.h_ℂ_holo.add hh''_holo
    have h_supp_deriv0 : ∀ θ ∈ S_h,
        HasDerivAt (fun w => pointSupportCurve C w 0) (r_ℂ θ * (-Complex.sin θ)) θ := by
      intro θ hθ
      have hd_h : HasDerivAt C.h_ℂ (deriv C.h_ℂ θ) θ :=
        (C.h_ℂ_holo.differentiableAt (hSh_open.mem_nhds hθ)).hasDerivAt
      have hd_h' : HasDerivAt (deriv C.h_ℂ) (deriv (deriv C.h_ℂ) θ) θ :=
        (hh'_holo.differentiableAt (hSh_open.mem_nhds hθ)).hasDerivAt
      have hd := (hd_h.mul (Complex.hasDerivAt_cos θ)).sub (hd_h'.mul (Complex.hasDerivAt_sin θ))
      exact hd.congr_deriv (by change _ = (C.h_ℂ θ + deriv (deriv C.h_ℂ) θ) * _; ring)
    have h_supp_deriv1 : ∀ θ ∈ S_h,
        HasDerivAt (fun w => pointSupportCurve C w 1) (r_ℂ θ * Complex.cos θ) θ := by
      intro θ hθ
      have hd_h : HasDerivAt C.h_ℂ (deriv C.h_ℂ θ) θ :=
        (C.h_ℂ_holo.differentiableAt (hSh_open.mem_nhds hθ)).hasDerivAt
      have hd_h' : HasDerivAt (deriv C.h_ℂ) (deriv (deriv C.h_ℂ) θ) θ :=
        (hh'_holo.differentiableAt (hSh_open.mem_nhds hθ)).hasDerivAt
      have hd := (hd_h.mul (Complex.hasDerivAt_sin θ)).add (hd_h'.mul (Complex.hasDerivAt_cos θ))
      exact hd.congr_deriv (by change _ = (C.h_ℂ θ + deriv (deriv C.h_ℂ) θ) * _; ring)
    have hXY_deriv_all : ∀ (r : Fin 4), ∀ θ ∈ S_h,
        HasDerivAt (fun w => rotCoordX r (pointSupportCurve C w))
          (r_ℂ θ * (-Complex.sin (θ + pointRotAngle r))) θ ∧
        HasDerivAt (fun w => rotCoordY r (pointSupportCurve C w))
          (r_ℂ θ * Complex.cos (θ + pointRotAngle r)) θ := by
      intro r θ hθ
      have h0 := h_supp_deriv0 θ hθ
      have h1 := h_supp_deriv1 θ hθ
      obtain ⟨htX, htY⟩ := h_rot_tan_all r θ
      fin_cases r
      · simp only [rotCoordX, rotCoordY, Matrix.cons_val_zero, Matrix.cons_val_one,
          Matrix.head_cons] at htX htY ⊢
        exact ⟨h0.congr_deriv (by rw [← htX]), h1.congr_deriv (by rw [← htY])⟩
      · simp only [rotCoordX, rotCoordY, Matrix.cons_val_zero, Matrix.cons_val_one,
          Matrix.head_cons] at htX htY ⊢
        exact ⟨(h0.neg.congr_of_eventuallyEq (Filter.Eventually.of_forall fun _ => rfl)).congr_deriv
            (by rw [← htX]; ring),
          (h1.neg.congr_of_eventuallyEq (Filter.Eventually.of_forall fun _ => rfl)).congr_deriv
            (by rw [← htY]; ring)⟩
      · simp only [rotCoordX, rotCoordY, Matrix.cons_val_zero, Matrix.cons_val_one,
          Matrix.head_cons] at htX htY ⊢
        exact ⟨h1.congr_deriv (by rw [← htX]),
          (h0.neg.congr_of_eventuallyEq (Filter.Eventually.of_forall fun _ => rfl)).congr_deriv
            (by rw [← htY]; ring)⟩
      · simp only [rotCoordX, rotCoordY, Matrix.cons_val_zero, Matrix.cons_val_one,
          Matrix.head_cons] at htX htY ⊢
        exact ⟨(h1.neg.congr_of_eventuallyEq (Filter.Eventually.of_forall fun _ => rfl)).congr_deriv
            (by rw [← htX]; ring),
          h0.congr_deriv (by rw [← htY])⟩
    let X_rot : ℂ → ℂ := fun θ => rotCoordX rotIdx (pointSupportCurve C θ)
    let Y_rot : ℂ → ℂ := fun θ => rotCoordY rotIdx (pointSupportCurve C θ)
    have hX_deriv : ∀ θ ∈ S_h,
        HasDerivAt X_rot (r_ℂ θ * (-Complex.sin (θ + pointRotAngle rotIdx))) θ :=
      fun θ hθ => (hXY_deriv_all rotIdx θ hθ).1
    have hY_deriv : ∀ θ ∈ S_h,
        HasDerivAt Y_rot (r_ℂ θ * Complex.cos (θ + pointRotAngle rotIdx)) θ :=
      fun θ hθ => (hXY_deriv_all rotIdx θ hθ).2
    have h_conj_deriv : ∀ {f : ℂ → ℂ} {z d : ℂ}, HasDerivAt f d z →
        HasDerivAt (fun w => starRingEnd ℂ (f (starRingEnd ℂ w)))
          (starRingEnd ℂ d) (starRingEnd ℂ z) := by
      intro f z d hf
      rw [hasDerivAt_iff_tendsto] at hf ⊢
      have h_eq : (fun x' : ℂ =>
          ‖x' - (starRingEnd ℂ) z‖⁻¹ *
            ‖(starRingEnd ℂ) (f ((starRingEnd ℂ) x')) -
                (starRingEnd ℂ) (f ((starRingEnd ℂ) ((starRingEnd ℂ) z))) -
              (x' - (starRingEnd ℂ) z) • (starRingEnd ℂ) d‖) =
        (fun y : ℂ => ‖y - z‖⁻¹ * ‖f y - f z - (y - z) • d‖) ∘ (starRingEnd ℂ) := by
        ext w
        simp only [Function.comp_apply, Complex.conj_conj, smul_eq_mul]
        have h1 : w - (starRingEnd ℂ) z = (starRingEnd ℂ) ((starRingEnd ℂ) w - z) := by
          simp [map_sub]
        have h2 : (starRingEnd ℂ) (f ((starRingEnd ℂ) w)) - (starRingEnd ℂ) (f z) -
            (w - (starRingEnd ℂ) z) * (starRingEnd ℂ) d =
            (starRingEnd ℂ) (f ((starRingEnd ℂ) w) - f z - ((starRingEnd ℂ) w - z) * d) := by
          rw [h1]
          simp [map_sub, map_mul]
        rw [h2, h1, Complex.norm_conj, Complex.norm_conj]
      rw [h_eq]
      have h_cont : Filter.Tendsto (starRingEnd ℂ) (nhds ((starRingEnd ℂ) z)) (nhds z) := by
        simpa using Complex.continuous_conj.tendsto ((starRingEnd ℂ) z)
      exact hf.comp h_cont
    have hSh_conj : ∀ w ∈ S_h, starRingEnd ℂ w ∈ S_h := by
      intro w hw
      simpa [S_h, horizStrip, Complex.conj_im] using hw
    have hh'_conj : ∀ w ∈ S_h, deriv C.h_ℂ (starRingEnd ℂ w) = starRingEnd ℂ (deriv C.h_ℂ w) := by
      intro w hw
      have hd : HasDerivAt C.h_ℂ (deriv C.h_ℂ w) w :=
        (C.h_ℂ_holo.differentiableAt (hSh_open.mem_nhds hw)).hasDerivAt
      have hd_c := h_conj_deriv hd
      have hev : C.h_ℂ =ᶠ[nhds (starRingEnd ℂ w)]
          (fun z => starRingEnd ℂ (C.h_ℂ (starRingEnd ℂ z))) := by
        filter_upwards [hSh_open.mem_nhds (hSh_conj w hw)] with z hz
        simpa using C.h_ℂ_conj (starRingEnd ℂ z) (hSh_conj z hz)
      exact (hd_c.congr_of_eventuallyEq hev).deriv
    have hXY_conj_all : ∀ (r : Fin 4), ∀ w ∈ S_h,
        rotCoordX r (pointSupportCurve C (starRingEnd ℂ w)) =
          starRingEnd ℂ (rotCoordX r (pointSupportCurve C w)) ∧
        rotCoordY r (pointSupportCurve C (starRingEnd ℂ w)) =
          starRingEnd ℂ (rotCoordY r (pointSupportCurve C w)) := by
      intro r w hw
      have hc0 : pointSupportCurve C (starRingEnd ℂ w) 0 =
          starRingEnd ℂ (pointSupportCurve C w 0) := by
        simp [pointSupportCurve, C.h_ℂ_conj w hw, hh'_conj w hw, Complex.cos_conj, Complex.sin_conj]
      have hc1 : pointSupportCurve C (starRingEnd ℂ w) 1 =
          starRingEnd ℂ (pointSupportCurve C w 1) := by
        simp [pointSupportCurve, C.h_ℂ_conj w hw, hh'_conj w hw, Complex.cos_conj, Complex.sin_conj]
      fin_cases r <;> simp [rotCoordX, rotCoordY, hc0, hc1]
    have hX_conj : ∀ w ∈ S_h, X_rot (starRingEnd ℂ w) = starRingEnd ℂ (X_rot w) :=
      fun w hw => (hXY_conj_all rotIdx w hw).1
    have hY_conj : ∀ w ∈ S_h, Y_rot (starRingEnd ℂ w) = starRingEnd ℂ (Y_rot w) :=
      fun w hw => (hXY_conj_all rotIdx w hw).2
    have hh'_real : ∀ θ : ℝ, deriv C.h_ℂ (θ : ℂ) = ((deriv C.h θ : ℝ) : ℂ) := by
      intro θ
      have hc : HasDerivAt (fun y : ℝ => C.h_ℂ (y : ℂ)) (deriv C.h_ℂ (θ : ℂ)) θ :=
        ((C.h_ℂ_holo.differentiableAt (hSh_open.mem_nhds (h_real_mem_Sh θ))).hasDerivAt).comp_ofReal
      have hr : HasDerivAt (fun y : ℝ => (C.h y : ℂ)) ((deriv C.h θ : ℝ) : ℂ) θ :=
        ((C.h_smooth.differentiable (by decide) θ).hasDerivAt).ofReal_comp
      have heq : (fun y : ℝ => C.h_ℂ (y : ℂ)) = (fun y : ℝ => (C.h y : ℂ)) :=
        funext C.h_ℂ_real
      exact hc.unique (heq ▸ hr)
    have hh''_real : ∀ θ : ℝ, deriv (deriv C.h_ℂ) (θ : ℂ) = ((deriv (deriv C.h) θ : ℝ) : ℂ) := by
      intro θ
      have hc : HasDerivAt (fun y : ℝ => deriv C.h_ℂ (y : ℂ)) (deriv (deriv C.h_ℂ) (θ : ℂ)) θ :=
        ((hh'_holo.differentiableAt (hSh_open.mem_nhds (h_real_mem_Sh θ))).hasDerivAt).comp_ofReal
      have h_smooth' : ContDiff ℝ ((1 : WithTop ℕ∞) + 1) C.h := C.h_smooth.of_le (by decide)
      have hr : HasDerivAt (fun y : ℝ => ((deriv C.h y : ℝ) : ℂ)) ((deriv (deriv C.h) θ : ℝ) : ℂ) θ :=
        ((h_smooth'.deriv'.differentiable_one θ).hasDerivAt).ofReal_comp
      have heq : (fun y : ℝ => deriv C.h_ℂ (y : ℂ)) = (fun y : ℝ => ((deriv C.h y : ℝ) : ℂ)) :=
        funext hh'_real
      exact hc.unique (heq ▸ hr)
    have hr_ℂ_real : ∀ θ : ℝ, r_ℂ (θ : ℂ) = ((C.h θ + deriv (deriv C.h) θ : ℝ) : ℂ) := by
      intro θ
      simp [r_ℂ, C.h_ℂ_real θ, hh''_real θ]
    let a₀ : ℝ := (X_rot (θ₀ : ℂ)).re
    have ha₀_eq : (a₀ : ℂ) = X_rot (θ₀ : ℂ) := by
      have him0 : (X_rot (θ₀ : ℂ)).im = 0 := by
        have hc := hX_conj (θ₀ : ℂ) (h_real_mem_Sh θ₀)
        simp only [Complex.conj_ofReal] at hc
        exact Complex.conj_eq_iff_im.mp hc.symm
      exact Complex.ext (by simp [a₀]) (by simp [him0])
    have hX_deriv_cont : ContinuousOn (fun θ => r_ℂ θ * (-Complex.sin (θ + pointRotAngle rotIdx))) S_h :=
      hr_ℂ_holo.continuousOn.mul
        ((Complex.continuous_sin.comp (continuous_id.add continuous_const)).neg.continuousOn)
    have hX_strict : ∀ θ ∈ S_h,
        HasStrictDerivAt X_rot (r_ℂ θ * (-Complex.sin (θ + pointRotAngle rotIdx))) θ := by
      intro θ hθ
      exact hasStrictDerivAt_of_hasDerivAt_of_continuousAt
        (Filter.eventually_of_mem (hSh_open.mem_nhds hθ) hX_deriv)
        (hX_deriv_cont.continuousAt (hSh_open.mem_nhds hθ))
    have hr₀_pos : 0 < C.h θ₀ + deriv (deriv C.h) θ₀ := C.r_pos θ₀
    have hX'_θ₀_ne : r_ℂ (θ₀ : ℂ) * (-Complex.sin ((θ₀ : ℂ) + pointRotAngle rotIdx)) ≠ 0 := by
      rw [hr_ℂ_real θ₀]
      have hsin_eq : -Complex.sin ((θ₀ : ℂ) + pointRotAngle rotIdx) =
          ((-Real.sin (θ₀ + pointRotAngleR rotIdx) : ℝ) : ℂ) := by
        simp [pointRotAngle, ← Complex.ofReal_add, ← Complex.ofReal_sin]
      rw [hsin_eq]
      exact mul_ne_zero (Complex.ofReal_ne_zero.mpr (ne_of_gt hr₀_pos))
        (Complex.ofReal_ne_zero.mpr (ne_of_gt (by linarith [h_sin_base])))
    have hX_equiv := (hX_strict (θ₀ : ℂ) (h_real_mem_Sh θ₀)).hasStrictFDerivAt_equiv hX'_θ₀_ne
    obtain ⟨e_θ, he_θ_coe, hθ₀_src⟩ : ∃ e_θ : OpenPartialHomeomorph ℂ ℂ,
        (↑e_θ : ℂ → ℂ) = X_rot ∧ (θ₀ : ℂ) ∈ e_θ.source :=
      ⟨hX_equiv.toOpenPartialHomeomorph X_rot, rfl, hX_equiv.mem_toOpenPartialHomeomorph_source⟩
    have ha₀_tgt : (a₀ : ℂ) ∈ e_θ.target := by
      rw [ha₀_eq, ← he_θ_coe]
      exact e_θ.map_source hθ₀_src
    have he_θ_symm_a₀ : e_θ.symm (a₀ : ℂ) = (θ₀ : ℂ) := by
      rw [ha₀_eq, ← he_θ_coe]
      exact e_θ.left_inv hθ₀_src
    have h_sin_re_θ₀ : 1 / 4 < (-Complex.sin ((θ₀ : ℂ) + pointRotAngle rotIdx)).re := by
      have hsin_eq : -Complex.sin ((θ₀ : ℂ) + pointRotAngle rotIdx) =
          ((-Real.sin (θ₀ + pointRotAngleR rotIdx) : ℝ) : ℂ) := by
        simp [pointRotAngle, ← Complex.ofReal_add, ← Complex.ofReal_sin]
      rw [hsin_eq, Complex.ofReal_re]
      linarith [h_sin_base]
    have hr_θ₀_ne : r_ℂ (θ₀ : ℂ) ≠ 0 := by
      rw [hr_ℂ_real θ₀]
      exact Complex.ofReal_ne_zero.mpr (ne_of_gt hr₀_pos)
    have h_nhds_θ : e_θ.source ∩ S_h ∩
        { θ : ℂ | 1 / 4 < (-Complex.sin (θ + pointRotAngle rotIdx)).re } ∩
        { θ : ℂ | r_ℂ θ ≠ 0 } ∈ nhds (θ₀ : ℂ) := by
      refine Filter.inter_mem (Filter.inter_mem (Filter.inter_mem
        (e_θ.open_source.mem_nhds hθ₀_src) (hSh_open.mem_nhds (h_real_mem_Sh θ₀))) ?_) ?_
      · have hopen_sin : IsOpen { θ : ℂ | 1 / 4 < (-Complex.sin (θ + pointRotAngle rotIdx)).re } :=
          isOpen_lt continuous_const
            (Complex.continuous_re.comp
              (Complex.continuous_sin.comp (continuous_id.add continuous_const)).neg)
        exact hopen_sin.mem_nhds h_sin_re_θ₀
      · exact (hr_ℂ_holo.continuousOn.continuousAt (hSh_open.mem_nhds (h_real_mem_Sh θ₀))).eventually_ne
          hr_θ₀_ne
    obtain ⟨ρ_θ, hρ_θ_pos, hρ_θ_sub⟩ := Metric.mem_nhds_iff.mp h_nhds_θ
    let B_θ : Set ℂ := Metric.ball (θ₀ : ℂ) ρ_θ
    have h_nhds_x : e_θ.target ∩ e_θ.symm ⁻¹' B_θ ∈ nhds (a₀ : ℂ) := by
      refine Filter.inter_mem (e_θ.open_target.mem_nhds ha₀_tgt) ?_
      exact (e_θ.continuousOn_symm.continuousAt (e_θ.open_target.mem_nhds ha₀_tgt)).eventually
        (Metric.isOpen_ball.mem_nhds (by simpa [B_θ, he_θ_symm_a₀] using hρ_θ_pos))
    obtain ⟨ρ_x, hρ_x_pos, hρ_x_sub⟩ := Metric.mem_nhds_iff.mp h_nhds_x
    let W_F : Set ℂ := Metric.ball (a₀ : ℂ) ρ_x
    let W_θ : Set ℂ := B_θ ∩ X_rot ⁻¹' W_F
    let θ_inv : ℂ → ℂ := e_θ.symm
    let F : ℂ → ℂ := fun z => Y_rot (θ_inv z)
    have hX_cont_B : ContinuousOn X_rot B_θ := by
      intro θ hθ
      exact (hX_deriv θ (hρ_θ_sub hθ).1.1.2).continuousAt.continuousWithinAt
    have hW_θ_open : IsOpen W_θ :=
      hX_cont_B.isOpen_inter_preimage Metric.isOpen_ball Metric.isOpen_ball
    have hθ₀_mem_W_θ : (θ₀ : ℂ) ∈ W_θ := by
      refine ⟨Metric.mem_ball_self hρ_θ_pos, ?_⟩
      change X_rot (θ₀ : ℂ) ∈ W_F
      rw [← ha₀_eq]
      exact Metric.mem_ball_self hρ_x_pos
    have hW_θ_sub_B : W_θ ⊆ B_θ := Set.inter_subset_left
    have hW_θ_sub_Sh : W_θ ⊆ S_h := fun θ hθ => (hρ_θ_sub hθ.1).1.1.2
    have hW_θ_nondeg : ∀ θ ∈ W_θ,
        1 / 4 < (-Complex.sin (θ + pointRotAngle rotIdx)).re ∧ r_ℂ θ ≠ 0 :=
      fun θ hθ => ⟨(hρ_θ_sub hθ.1).1.2, (hρ_θ_sub hθ.1).2⟩
    have hθ_inv_maps : ∀ z ∈ W_F, θ_inv z ∈ W_θ := by
      intro z hz
      have hB : θ_inv z ∈ B_θ := (hρ_x_sub hz).2
      refine ⟨hB, ?_⟩
      change X_rot (e_θ.symm z) ∈ W_F
      rw [← he_θ_coe, e_θ.right_inv (hρ_x_sub hz).1]
      exact hz
    have hθ_left_inv : ∀ θ ∈ W_θ,
        X_rot θ ∈ W_F ∧ θ_inv (X_rot θ) = θ ∧ Y_rot θ = F (X_rot θ) := by
      intro θ hθ
      have hsrc : θ ∈ e_θ.source := (hρ_θ_sub hθ.1).1.1.1
      have hinv : θ_inv (X_rot θ) = θ := by
        change e_θ.symm (X_rot θ) = θ
        rw [← he_θ_coe]
        exact e_θ.left_inv hsrc
      exact ⟨hθ.2, hinv, by simp [F, hinv]⟩
    have hθ_right_inv : ∀ z ∈ W_F, X_rot (θ_inv z) = z ∧ Y_rot (θ_inv z) = F z := by
      intro z hz
      refine ⟨?_, rfl⟩
      change X_rot (e_θ.symm z) = z
      rw [← he_θ_coe]
      exact e_θ.right_inv (hρ_x_sub hz).1
    have hθ_inv_hasDeriv : ∀ z ∈ W_F,
        HasDerivAt θ_inv
          ((r_ℂ (θ_inv z) * (-Complex.sin (θ_inv z + pointRotAngle rotIdx)))⁻¹) z := by
      intro z hz
      have hW := hθ_inv_maps z hz
      have hnd := hW_θ_nondeg (θ_inv z) hW
      have hsin_ne : -Complex.sin (θ_inv z + pointRotAngle rotIdx) ≠ 0 := by
        intro h0
        have : (-Complex.sin (θ_inv z + pointRotAngle rotIdx)).re = 0 := by rw [h0]; simp
        linarith [hnd.1]
      have hd_ne : r_ℂ (θ_inv z) * (-Complex.sin (θ_inv z + pointRotAngle rotIdx)) ≠ 0 :=
        mul_ne_zero hnd.2 hsin_ne
      exact e_θ.hasDerivAt_symm (hρ_x_sub hz).1 hd_ne
        (he_θ_coe.symm ▸ hX_deriv (θ_inv z) (hW_θ_sub_Sh hW))
    have hθ_inv_holo : DifferentiableOn ℂ θ_inv W_F :=
      fun z hz => (hθ_inv_hasDeriv z hz).differentiableAt.differentiableWithinAt
    have hF_hasDeriv : ∀ z ∈ W_F,
        HasDerivAt F
          (Complex.cos (θ_inv z + pointRotAngle rotIdx) /
            (-Complex.sin (θ_inv z + pointRotAngle rotIdx))) z := by
      intro z hz
      have hW := hθ_inv_maps z hz
      have hnd := hW_θ_nondeg (θ_inv z) hW
      have hsin_ne : -Complex.sin (θ_inv z + pointRotAngle rotIdx) ≠ 0 := by
        intro h0
        have : (-Complex.sin (θ_inv z + pointRotAngle rotIdx)).re = 0 := by rw [h0]; simp
        linarith [hnd.1]
      have hr_ne : r_ℂ (θ_inv z) ≠ 0 := hnd.2
      have hdY := hY_deriv (θ_inv z) (hW_θ_sub_Sh hW)
      have hdθ := hθ_inv_hasDeriv z hz
      exact (hdY.comp z hdθ).congr_deriv (by field_simp [hr_ne, hsin_ne])
    have hF_holo : DifferentiableOn ℂ F W_F :=
      fun z hz => (hF_hasDeriv z hz).differentiableAt.differentiableWithinAt
    have hF_deriv_eq : ∀ z ∈ W_F,
        deriv F z =
          Complex.cos (θ_inv z + pointRotAngle rotIdx) /
            (-Complex.sin (θ_inv z + pointRotAngle rotIdx)) :=
      fun z hz => (hF_hasDeriv z hz).deriv
    have hF_deriv2_eq : ∀ z ∈ W_F,
        deriv (deriv F) z =
          1 / (r_ℂ (θ_inv z) * (-Complex.sin (θ_inv z + pointRotAngle rotIdx)) ^ 3) := by
      intro z hz
      have hW := hθ_inv_maps z hz
      have hnd := hW_θ_nondeg (θ_inv z) hW
      have hsin_ne : -Complex.sin (θ_inv z + pointRotAngle rotIdx) ≠ 0 := by
        intro h0
        have : (-Complex.sin (θ_inv z + pointRotAngle rotIdx)).re = 0 := by rw [h0]; simp
        linarith [hnd.1]
      have hsin_ne' : Complex.sin (θ_inv z + pointRotAngle rotIdx) ≠ 0 := neg_ne_zero.mp hsin_ne
      have hr_ne : r_ℂ (θ_inv z) ≠ 0 := hnd.2
      let g_tan : ℂ → ℂ := fun θ =>
        Complex.cos (θ + pointRotAngle rotIdx) / (-Complex.sin (θ + pointRotAngle rotIdx))
      have hev : deriv F =ᶠ[nhds z] (g_tan ∘ θ_inv) :=
        Filter.eventuallyEq_of_mem (Metric.isOpen_ball.mem_nhds hz)
          (fun w hw => hF_deriv_eq w hw)
      rw [hev.deriv_eq]
      have hd_sh : HasDerivAt (fun θ => θ + pointRotAngle rotIdx) 1 (θ_inv z) :=
        ((hasDerivAt_id (θ_inv z)).add_const (pointRotAngle rotIdx)).congr_of_eventuallyEq
          (Filter.Eventually.of_forall fun _ => rfl)
      have hd_num : HasDerivAt (fun θ : ℂ => Complex.cos (θ + pointRotAngle rotIdx))
          (-Complex.sin (θ_inv z + pointRotAngle rotIdx)) (θ_inv z) := by
        have h1 := HasDerivAt.comp (θ_inv z)
          (Complex.hasDerivAt_cos (θ_inv z + pointRotAngle rotIdx)) hd_sh
        exact h1.congr_deriv (mul_one _)
      have hd_den : HasDerivAt (fun θ : ℂ => -Complex.sin (θ + pointRotAngle rotIdx))
          (-Complex.cos (θ_inv z + pointRotAngle rotIdx)) (θ_inv z) := by
        have h1 := HasDerivAt.comp (θ_inv z)
          (Complex.hasDerivAt_sin (θ_inv z + pointRotAngle rotIdx)) hd_sh
        exact (h1.congr_deriv (mul_one _)).neg
      have hd_gtan : HasDerivAt g_tan
          (1 / (-Complex.sin (θ_inv z + pointRotAngle rotIdx)) ^ 2) (θ_inv z) := by
        refine (hd_num.div hd_den hsin_ne).congr_deriv ?_
        have hcs := Complex.cos_sq_add_sin_sq (θ_inv z + pointRotAngle rotIdx)
        field_simp [hsin_ne']
        linear_combination hcs
      have hd_comp := hd_gtan.comp z (hθ_inv_hasDeriv z hz)
      rw [hd_comp.deriv]
      field_simp [hr_ne, hsin_ne']
    have hF_real : ∀ x : ℝ, |x - a₀| < ρ_x →
        (x : ℂ) ∈ W_F ∧
        (F (x : ℂ)).im = 0 ∧
        deriv (deriv F) (x : ℂ) ≠ 0 ∧
        ∃ v_x : ℝ, deriv F (x : ℂ) = (v_x : ℂ) := by
      intro x hx
      have hx_mem : (x : ℂ) ∈ W_F := by
        rw [Metric.mem_ball, Complex.dist_eq, ← Complex.ofReal_sub, Complex.norm_real,
          Real.norm_eq_abs]
        exact hx
      have hθ_W : θ_inv (x : ℂ) ∈ W_θ := hθ_inv_maps (x : ℂ) hx_mem
      have hθ_B : θ_inv (x : ℂ) ∈ B_θ := hθ_W.1
      have hθ_conj_B : starRingEnd ℂ (θ_inv (x : ℂ)) ∈ B_θ := by
        rw [Metric.mem_ball, Complex.dist_eq] at hθ_B ⊢
        have heq : starRingEnd ℂ (θ_inv (x : ℂ)) - (θ₀ : ℂ) =
            starRingEnd ℂ (θ_inv (x : ℂ) - (θ₀ : ℂ)) := by simp [map_sub]
        rw [heq, Complex.norm_conj]
        exact hθ_B
      have hθ_eq_conj : starRingEnd ℂ (θ_inv (x : ℂ)) = θ_inv (x : ℂ) := by
        apply e_θ.injOn (hρ_θ_sub hθ_conj_B).1.1.1 (hρ_θ_sub hθ_B).1.1.1
        rw [he_θ_coe, hX_conj _ (hW_θ_sub_Sh hθ_W), (hθ_right_inv (x : ℂ) hx_mem).1,
          Complex.conj_ofReal]
      have hθ_im : (θ_inv (x : ℂ)).im = 0 := Complex.conj_eq_iff_im.mp hθ_eq_conj
      have hθ_re_eq : (((θ_inv (x : ℂ)).re : ℝ) : ℂ) = θ_inv (x : ℂ) := by
        conv_rhs => rw [← Complex.re_add_im (θ_inv (x : ℂ)), hθ_im]
        simp
      have hF_im : (F (x : ℂ)).im = 0 := by
        apply Complex.conj_eq_iff_im.mp
        dsimp [F]
        rw [← hY_conj _ (hW_θ_sub_Sh hθ_W), hθ_eq_conj]
      have hnd := hW_θ_nondeg (θ_inv (x : ℂ)) hθ_W
      have hsin_ne : -Complex.sin (θ_inv (x : ℂ) + pointRotAngle rotIdx) ≠ 0 := by
        intro h0
        have : (-Complex.sin (θ_inv (x : ℂ) + pointRotAngle rotIdx)).re = 0 := by rw [h0]; simp
        linarith [hnd.1]
      have hF''_ne : deriv (deriv F) (x : ℂ) ≠ 0 := by
        rw [hF_deriv2_eq (x : ℂ) hx_mem]
        exact one_div_ne_zero (mul_ne_zero hnd.2 (pow_ne_zero 3 hsin_ne))
      refine ⟨hx_mem, hF_im, hF''_ne, ?_⟩
      let α_x : ℝ := (θ_inv (x : ℂ)).re + pointRotAngleR rotIdx
      refine ⟨Real.cos α_x / (-Real.sin α_x), ?_⟩
      rw [hF_deriv_eq (x : ℂ) hx_mem, ← hθ_re_eq]
      dsimp [α_x, pointRotAngle]
      push_cast
      rw [← Complex.ofReal_add, ← Complex.ofReal_cos, ← Complex.ofReal_sin]
    exact ⟨{
      rotIdx := rotIdx
      a₀ := a₀
      ρ_x := ρ_x
      ρ_x_pos := hρ_x_pos
      sin_rot_base_gt := h_sin_base
      a₀_eq := ha₀_eq
      W_θ := W_θ
      W_θ_open := hW_θ_open
      θ₀_mem_W_θ := hθ₀_mem_W_θ
      W_θ_sub_strip := hW_θ_sub_Sh
      F := F
      θ_inv := θ_inv
      F_holo := hF_holo
      θ_inv_holo := hθ_inv_holo
      θ_inv_base := he_θ_symm_a₀
      θ_inv_maps := hθ_inv_maps
      θ_left_inv := hθ_left_inv
      θ_right_inv := hθ_right_inv
