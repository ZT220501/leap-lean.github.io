  obtain ⟨x_seq, hH_gt_half, h_ex_unit, h_ex_ball, h_ex_cone⟩ : ∃ x_seq : ℕ → ℝ,
      (∀ j : ℕ, 1 / 2 < H_row j (x_seq j)) ∧
      (∀ j : ℕ, ((j : ℝ) + 1) * (U_circ j (x_seq j) - H_row j (x_seq j)) ≤ H_row j (x_seq j)) ∧
