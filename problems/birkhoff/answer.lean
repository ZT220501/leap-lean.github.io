        (hΨ_diff.comp ((differentiable_const a).prodMk differentiable_id)).differentiableOn ?_
      intro z hz
      exact (hΨ_low a ha z (by simpa [Metric.mem_ball, dist_zero_right] using hz)).2
    have hGa_dc : DiffContOnCl ℂ G_a (Metric.ball (0 : ℂ) 1) :=
      hGa_holo.diffContOnCl_ball (Metric.closedBall_subset_ball (by norm_num))
    have h_cauchy := hGa_dc.circleIntegral_sub_inv_smul hζ
    unfold circleIntegral at h_cauchy
    simp only [deriv_circleMap, smul_eq_mul] at h_cauchy
