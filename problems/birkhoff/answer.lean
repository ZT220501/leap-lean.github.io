      change |z₀.im| < 2 * C.s₀; simp [z₀, hs₀_pos]
    have hθ₀_strip : θ₀ ∈ horizStrip (2 * C.s_h) := C.ϕ_ℂ_maps_to z₀ hz₀_strip
    have hc_ϕ_ne : deriv C.ϕ_ℂ z₀ ≠ 0 := C.ϕ_ℂ_deriv_ne_zero z₀ hz₀_strip
    
    have hStrict0 : HasStrictDerivAt C.ϕ_ℂ (deriv C.ϕ_ℂ z₀) z₀ :=
      (C.ϕ_ℂ_holo.analyticAt ((h_open_strip (2 * C.s₀)).mem_nhds hz₀_strip)).hasStrictDerivAt
    let e_oph := hStrict0.hasStrictFDerivAt_equiv hc_ϕ_ne
    let φ_oph := e_oph.toOpenPartialHomeomorph C.ϕ_ℂ
    let ϕ_inv : ℂ → ℂ := φ_oph.symm
    have hcoe : (φ_oph : ℂ → ℂ) = C.ϕ_ℂ := e_oph.toOpenPartialHomeomorph_coe
    have hz₀_src : z₀ ∈ φ_oph.source := e_oph.mem_toOpenPartialHomeomorph_source
    obtain ⟨r_inv, hr_inv_pos, hr_inv_sub⟩ :=
      Metric.isOpen_iff.mp (φ_oph.open_source.inter (h_open_strip (2 * C.s₀)))
        z₀ ⟨hz₀_src, hz₀_strip⟩
    have hθ₀_tgt : θ₀ ∈ φ_oph.target := by
      dsimp [θ₀]; rw [← hcoe]; exact φ_oph.map_source hz₀_src
    have hleft0 : ϕ_inv θ₀ = z₀ := by
      dsimp [ϕ_inv, θ₀]; rw [← hcoe]; exact φ_oph.left_inv hz₀_src
    have hcont_inv : ContinuousAt ϕ_inv θ₀ :=
      φ_oph.continuousOn_symm.continuousAt (φ_oph.open_target.mem_nhds hθ₀_tgt)
    obtain ⟨δ_θ, hδ_θ_pos, hδ_θ_sub⟩ := Metric.mem_nhds_iff.mp
      (Filter.inter_mem (φ_oph.open_target.mem_nhds hθ₀_tgt)
        (hcont_inv.preimage_mem_nhds (by rw [hleft0]; exact Metric.ball_mem_nhds z₀ hr_inv_pos)))
    have hϕ_inv_holo : DifferentiableOn ℂ ϕ_inv (Metric.ball θ₀ δ_θ) := by
      intro w hw
      obtain ⟨hw_tgt, hw_pre⟩ := hδ_θ_sub hw
      have hs_strip : ϕ_inv w ∈ horizStrip (2 * C.s₀) := (hr_inv_sub hw_pre).2
      have hStrict_s : HasStrictDerivAt φ_oph (deriv C.ϕ_ℂ (ϕ_inv w)) (ϕ_inv w) := by
        rw [hcoe]
        exact (C.ϕ_ℂ_holo.analyticAt ((h_open_strip (2 * C.s₀)).mem_nhds hs_strip)).hasStrictDerivAt
      exact (φ_oph.hasStrictDerivAt_symm hw_tgt
        (C.ϕ_ℂ_deriv_ne_zero _ hs_strip) hStrict_s).hasDerivAt.differentiableAt.differentiableWithinAt
    have hϕ_inv_right : ∀ w ∈ Metric.ball θ₀ δ_θ,
        ϕ_inv w ∈ Metric.ball z₀ r_inv ∧ C.ϕ_ℂ (ϕ_inv w) = w := by
      intro w hw
      obtain ⟨hw_tgt, hw_pre⟩ := hδ_θ_sub hw
      refine ⟨hw_pre, ?_⟩
      rw [← hcoe]; exact φ_oph.right_inv hw_tgt
    have hϕ_inv_left : ∀ y ∈ Metric.ball z₀ r_inv, ϕ_inv (C.ϕ_ℂ y) = y := by
      intro y hy
      rw [← hcoe]; exact φ_oph.left_inv (hr_inv_sub hy).1
    have hp₀_wide : p₀ ∈ D_wide := ⟨by simp [p₀, z₀, hs_det_pos], by simp [p₀, hr_det_pos]⟩
    have hTheta_zero : ∀ y : ℂ, |y.im| < 2 * C.s₁ → glancingTheta C y 0 = C.ϕ_ℂ y := by
      intro y hy; unfold glancingTheta; rw [C.U_zero y hy]
    have hψ_at_zero : ∀ y : ℂ, |y.im| < (3 / 2 : ℝ) * hDet.s_det →
        ψ_minus (y, 0) = C.ϕ_ℂ y ∧ ψ_plus (y, 0) = C.ϕ_ℂ y := by
      intro y hy
      have hy2 : |y.im| < 2 * C.s₁ := by linarith
      refine ⟨?_, ?_⟩
      · rw [hψ_minus_eq (y, 0)]; simp [hTheta_zero y hy2]
      · rw [hψ_plus_eq (y, 0)]; simp [hTheta_zero y hy2]
    have hψ_p₀ : ψ_minus p₀ = θ₀ ∧ ψ_plus p₀ = θ₀ :=
      hψ_at_zero z₀ (by simp [z₀, hs_det_pos])
    have hψ_m_cont : ContinuousAt ψ_minus p₀ :=
      hψ_minus_holo.1.continuousOn.continuousAt (hD_wide_open.mem_nhds hp₀_wide)
    have hψ_p_cont : ContinuousAt ψ_plus p₀ :=
      hψ_plus_holo.1.continuousOn.continuousAt (hD_wide_open.mem_nhds hp₀_wide)
    obtain ⟨δ_ψ, hδ_ψ_pos, hδ_ψ_sub⟩ := Metric.mem_nhds_iff.mp
      (Filter.inter_mem
        (hψ_m_cont.preimage_mem_nhds (by rw [hψ_p₀.1]; exact Metric.ball_mem_nhds θ₀ hδ_θ_pos))
        (hψ_p_cont.preimage_mem_nhds (by rw [hψ_p₀.2]; exact Metric.ball_mem_nhds θ₀ hδ_θ_pos)))
    let r_0 : ℝ := min (min r_inv δ_ψ) (min (hDet.s_det / 4) (hDet.r_det / 4))
    have hr_0_pos : 0 < r_0 :=
      lt_min (lt_min hr_inv_pos hδ_ψ_pos) (lt_min (by positivity) (by positivity))
    have hr_0_inv : r_0 ≤ r_inv := le_trans (min_le_left _ _) (min_le_left _ _)
    have hr_0_δψ : r_0 ≤ δ_ψ := le_trans (min_le_left _ _) (min_le_right _ _)
    have hr_0_s : r_0 ≤ hDet.s_det / 4 := le_trans (min_le_right _ _) (min_le_left _ _)
    have hr_0_r : r_0 ≤ hDet.r_det / 4 := le_trans (min_le_right _ _) (min_le_right _ _)
    let D_0 : Set (ℂ × ℂ) := Metric.ball z₀ r_0 ×ˢ Metric.ball (0 : ℂ) r_0
    have hD_0_sub_wide : D_0 ⊆ D_wide := by
      intro p hp
      have hy_im : |p.1.im| < r_0 := by
        have h1 : |p.1.im - z₀.im| ≤ ‖p.1 - z₀‖ := by
          simpa only [Complex.sub_im] using Complex.abs_im_le_norm (p.1 - z₀)
        have hz₀_im : z₀.im = 0 := by simp [z₀]
        have hball : ‖p.1 - z₀‖ < r_0 := by simpa [Metric.mem_ball, dist_eq_norm] using hp.1
        rw [hz₀_im, sub_zero] at h1
        linarith
      have ht_norm : ‖p.2‖ < r_0 := by simpa [Metric.mem_ball, dist_zero_right] using hp.2
      exact ⟨by linarith, by linarith⟩
    have hD_0_maps_θ : ∀ p ∈ D_0,
        ψ_minus p ∈ Metric.ball θ₀ δ_θ ∧ ψ_plus p ∈ Metric.ball θ₀ δ_θ := by
      intro p hp
      apply hδ_ψ_sub
      rw [Metric.mem_ball, Prod.dist_eq, max_lt_iff]
      exact ⟨lt_of_lt_of_le hp.1 hr_0_δψ, lt_of_lt_of_le hp.2 hr_0_δψ⟩
    let s_minus : ℂ × ℂ → ℂ := fun p => ϕ_inv (ψ_minus p)
    let s_plus : ℂ × ℂ → ℂ := fun p => ϕ_inv (ψ_plus p)
    have hs_minus_holo_D0 : DifferentiableOn ℂ s_minus D_0 :=
      hϕ_inv_holo.comp (hψ_minus_holo.1.mono hD_0_sub_wide) (fun p hp => (hD_0_maps_θ p hp).1)
    have hs_plus_holo_D0 : DifferentiableOn ℂ s_plus D_0 :=
      hϕ_inv_holo.comp (hψ_plus_holo.1.mono hD_0_sub_wide) (fun p hp => (hD_0_maps_θ p hp).2)
    have hs_curve_D0 : ∀ p ∈ D_0,
        glancingBoundaryCurve C (s_minus p) = glancingImpact C (p.1 - p.2 / 2) p.2 ∧
        glancingBoundaryCurve C (s_plus p) = glancingImpact C (p.1 + p.2 / 2) p.2 := by
      intro p hp
      have hm_eq : C.ϕ_ℂ (s_minus p) = ψ_minus p := (hϕ_inv_right _ (hD_0_maps_θ p hp).1).2
      have hp_eq : C.ϕ_ℂ (s_plus p) = ψ_plus p := (hϕ_inv_right _ (hD_0_maps_θ p hp).2).2
      refine ⟨?_, ?_⟩
      · unfold glancingBoundaryCurve glancingImpact; rw [hm_eq]
      · unfold glancingBoundaryCurve glancingImpact; rw [hp_eq]
    have hs_at_zero : ∀ y ∈ Metric.ball z₀ r_0, s_minus (y, 0) = y ∧ s_plus (y, 0) = y := by
      intro y hy
      have hy_im : |y.im| < (3 / 2 : ℝ) * hDet.s_det :=
        (@hD_0_sub_wide (y, 0) ⟨hy, Metric.mem_ball_self hr_0_pos⟩).1
      obtain ⟨hm0, hp0⟩ := hψ_at_zero y hy_im
      have hy_inv : y ∈ Metric.ball z₀ r_inv := Metric.ball_subset_ball hr_0_inv hy
      exact ⟨by dsimp [s_minus]; rw [hm0, hϕ_inv_left y hy_inv],
        by dsimp [s_plus]; rw [hp0, hϕ_inv_left y hy_inv]⟩
    
    let Θ_fn : ℂ × ℂ → ℂ := fun q => glancingTheta C q.1 q.2
    have hp₀_Dθ : p₀ ∈ D_θ := ⟨by simp [p₀, z₀, hs_det_pos], by simp [p₀, hr_det_pos]⟩
    have hpderiv_Θ_holo : DifferentiableOn ℂ (pderivA Θ_fn) D_θ :=
      (hKit.pderiv_holo hD_θ_open hTheta_holo.1).1
    have hpderiv_Θ_p₀ : pderivA Θ_fn p₀ = deriv C.ϕ_ℂ z₀ := by
      unfold pderivA
      dsimp only [p₀, Θ_fn]
      apply Filter.EventuallyEq.deriv_eq
      have hz₀_2s₁ : z₀ ∈ horizStrip (2 * C.s₁) := by
        change |z₀.im| < 2 * C.s₁; simp [z₀, hs₁_pos]
      filter_upwards [(h_open_strip (2 * C.s₁)).mem_nhds hz₀_2s₁] with w hw
      exact hTheta_zero w hw
    have hc_ϕ_pos : 0 < ‖deriv C.ϕ_ℂ z₀‖ := norm_pos_iff.mpr hc_ϕ_ne
    have hcont_pderiv_Θ : ContinuousAt (pderivA Θ_fn) p₀ :=
      hpderiv_Θ_holo.continuousOn.continuousAt (hD_θ_open.mem_nhds hp₀_Dθ)
    obtain ⟨δ_Θ, hδ_Θ_pos, hδ_Θ_sub⟩ := Metric.mem_nhds_iff.mp
      (Filter.inter_mem (hD_θ_open.mem_nhds hp₀_Dθ)
        (hcont_pderiv_Θ.preimage_mem_nhds
          (by rw [hpderiv_Θ_p₀]; exact Metric.ball_mem_nhds (deriv C.ϕ_ℂ z₀) (half_pos hc_ϕ_pos))))
    let r_1 : ℝ := min (r_0 / 2) (δ_Θ / 3)
    have hr_1_pos : 0 < r_1 := lt_min (by positivity) (by positivity)
    have hr_1_le_half : r_1 ≤ r_0 / 2 := min_le_left _ _
    have hr_1_le_δΘ : 3 * r_1 ≤ δ_Θ := by
      have : r_1 ≤ δ_Θ / 3 := min_le_right _ _; linarith
    let D_1 : Set (ℂ × ℂ) := Metric.ball z₀ r_1 ×ˢ Metric.ball (0 : ℂ) r_1
    have hD_1_sub_D0 : D_1 ⊆ D_0 :=
      Set.prod_mono (Metric.ball_subset_ball (by linarith)) (Metric.ball_subset_ball (by linarith))
    have hs_sep_D1 : ∀ p ∈ D_1, p.2 ≠ 0 → s_plus p ≠ s_minus p := by
      rintro ⟨y, t⟩ ⟨hy_b, ht_b⟩ ht_ne heq
      have hψ_eq : ψ_plus (y, t) = ψ_minus (y, t) := by
        have h1 := (hϕ_inv_right _ (hD_0_maps_θ (y, t) (hD_1_sub_D0 ⟨hy_b, ht_b⟩)).2).2
        have h2 := (hϕ_inv_right _ (hD_0_maps_θ (y, t) (hD_1_sub_D0 ⟨hy_b, ht_b⟩)).1).2
        have hcon := congrArg C.ϕ_ℂ heq
        dsimp only [s_plus, s_minus] at hcon
        rw [h1, h2] at hcon
        exact hcon
      rw [hψ_plus_eq (y, t), hψ_minus_eq (y, t)] at hψ_eq
      have hΘ_eq : Θ_fn (y + t, t) = Θ_fn (y - t, t) := by
        dsimp only [Θ_fn]; linear_combination 2 * hψ_eq
      let f_t : ℂ → ℂ := fun w => Θ_fn (w, t) - deriv C.ϕ_ℂ z₀ * w
      have hw_in_ball : ∀ w ∈ Metric.ball z₀ (2 * r_1), (w, t) ∈ Metric.ball p₀ δ_Θ := by
        intro w hw
        rw [Metric.mem_ball, Prod.dist_eq, max_lt_iff]
        have ht_r1 : dist t 0 < r_1 := ht_b
        exact ⟨by linarith [Metric.mem_ball.mp hw], by linarith⟩
      have hf_diff : ∀ w ∈ Metric.ball z₀ (2 * r_1),
          HasDerivAt f_t (pderivA Θ_fn (w, t) - deriv C.ϕ_ℂ z₀) w := by
        intro w hw
        have hwt_Dθ : (w, t) ∈ D_θ := (hδ_Θ_sub (hw_in_ball w hw)).1
        have hΘ_at : DifferentiableAt ℂ Θ_fn (w, t) :=
          hTheta_holo.1.differentiableAt (hD_θ_open.mem_nhds hwt_Dθ)
        have h1 : HasDerivAt (fun w' : ℂ => Θ_fn (w', t)) (pderivA Θ_fn (w, t)) w :=
          (hSliceHasDeriv hΘ_at).1
        have h2 : HasDerivAt (fun w' : ℂ => deriv C.ϕ_ℂ z₀ * w') (deriv C.ϕ_ℂ z₀) w := by
          simpa using (hasDerivAt_id w).const_mul (deriv C.ϕ_ℂ z₀)
        exact h1.sub h2
      have hf_bnd : ∀ w ∈ Metric.ball z₀ (2 * r_1), ‖deriv f_t w‖ ≤ ‖deriv C.ϕ_ℂ z₀‖ / 2 := by
        intro w hw
        rw [(hf_diff w hw).deriv]
        have hlt : dist (pderivA Θ_fn (w, t)) (deriv C.ϕ_ℂ z₀) < ‖deriv C.ϕ_ℂ z₀‖ / 2 :=
          (hδ_Θ_sub (hw_in_ball w hw)).2
        rw [dist_eq_norm] at hlt
        exact le_of_lt hlt
      have hym_mem : y - t ∈ Metric.ball z₀ (2 * r_1) := by
        rw [Metric.mem_ball, dist_eq_norm]
        have hy_n : ‖y - z₀‖ < r_1 := by simpa [Metric.mem_ball, dist_eq_norm] using hy_b
        have ht_n : ‖t‖ < r_1 := by simpa [Metric.mem_ball, dist_zero_right] using ht_b
        rw [show y - t - z₀ = (y - z₀) - t by ring]
        linarith [norm_sub_le (y - z₀) t]
      have hyp_mem : y + t ∈ Metric.ball z₀ (2 * r_1) := by
        rw [Metric.mem_ball, dist_eq_norm]
        have hy_n : ‖y - z₀‖ < r_1 := by simpa [Metric.mem_ball, dist_eq_norm] using hy_b
        have ht_n : ‖t‖ < r_1 := by simpa [Metric.mem_ball, dist_zero_right] using ht_b
        rw [show y + t - z₀ = (y - z₀) + t by ring]
        linarith [norm_add_le (y - z₀) t]
      have hmvt := (convex_ball z₀ (2 * r_1)).norm_image_sub_le_of_norm_deriv_le
        (fun w hw => (hf_diff w hw).differentiableAt) hf_bnd hym_mem hyp_mem
      have hft_diff : f_t (y + t) - f_t (y - t) = -(2 : ℂ) * deriv C.ϕ_ℂ z₀ * t := by
        dsimp [f_t]; rw [hΘ_eq]; ring
      have harg_diff : (y + t) - (y - t) = (2 : ℂ) * t := by ring
      rw [hft_diff, harg_diff, norm_mul, norm_mul, norm_neg, Complex.norm_ofNat,
        norm_mul, Complex.norm_ofNat] at hmvt
      have ht_pos_n : 0 < ‖t‖ := norm_pos_iff.mpr ht_ne
      nlinarith [mul_pos hc_ϕ_pos ht_pos_n]
    
    let g_inc : ℂ → ℂ × ℂ → ℂ :=
      fun w p => dualLineShift C 0 0 p * Γ w 0 + dualLineShift C 0 1 p * Γ w 1 - 1
    have hg_d1 : ∀ p : ℂ × ℂ, ∀ w ∈ horizStrip (2 * C.s₀),
        HasDerivAt (fun z => g_inc z p)
          (dualLineShift C 0 0 p * deriv (fun z => Γ z 0) w +
            dualLineShift C 0 1 p * deriv (fun z => Γ z 1) w) w := by
      intro p w hw
      have hd0 : HasDerivAt (fun z => Γ z 0) (deriv (fun z => Γ z 0) w) w :=
        ((hΓ_holo 0).differentiableAt ((h_open_strip (2 * C.s₀)).mem_nhds hw)).hasDerivAt
      have hd1 : HasDerivAt (fun z => Γ z 1) (deriv (fun z => Γ z 1) w) w :=
        ((hΓ_holo 1).differentiableAt ((h_open_strip (2 * C.s₀)).mem_nhds hw)).hasDerivAt
      exact ((hd0.const_mul (dualLineShift C 0 0 p)).add
        (hd1.const_mul (dualLineShift C 0 1 p))).sub_const 1
    have hg_d2 : ∀ p : ℂ × ℂ, ∀ w ∈ horizStrip (2 * C.s₀),
        deriv (deriv (fun z => g_inc z p)) w =
          dualLineShift C 0 0 p * deriv (deriv (fun z => Γ z 0)) w +
            dualLineShift C 0 1 p * deriv (deriv (fun z => Γ z 1)) w := by
      intro p w hw
      have hev : deriv (fun z => g_inc z p) =ᶠ[nhds w]
          (fun z => dualLineShift C 0 0 p * deriv (fun u => Γ u 0) z +
            dualLineShift C 0 1 p * deriv (fun u => Γ u 1) z) := by
        filter_upwards [(h_open_strip (2 * C.s₀)).mem_nhds hw] with z hz
        exact (hg_d1 p z hz).deriv
      rw [hev.deriv_eq]
      have hd0 : HasDerivAt (deriv (fun u => Γ u 0)) (deriv (deriv (fun u => Γ u 0)) w) w :=
        ((hΓ_d1_holo 0).differentiableAt ((h_open_strip (2 * C.s₀)).mem_nhds hw)).hasDerivAt
      have hd1 : HasDerivAt (deriv (fun u => Γ u 1)) (deriv (deriv (fun u => Γ u 1)) w) w :=
        ((hΓ_d1_holo 1).differentiableAt ((h_open_strip (2 * C.s₀)).mem_nhds hw)).hasDerivAt
      exact ((hd0.const_mul (dualLineShift C 0 0 p)).add
        (hd1.const_mul (dualLineShift C 0 1 p))).deriv
    have hg_d1_diag_zero : ∀ y ∈ horizStrip (2 * C.s₀), |y.im| < 2 * C.s₁ →
        deriv (fun z => g_inc z (y, 0)) y = 0 := by
      intro y hy_s₀ hy_2s₁
      rw [(hg_d1 (y, 0) y hy_s₀).deriv]
      obtain ⟨hd0, hd1⟩ := hΓ_deriv y hy_s₀
      rw [hd0.deriv, hd1.deriv]
      simp only [dualLineShift, Int.cast_zero, zero_mul, add_zero, glancingDualLine,
        Matrix.cons_val_zero, Matrix.cons_val_one, hTheta_zero y hy_2s₁]
      ring
    have hoff_z₀ : glancingOffset C z₀ 0 = (C.h (C.ϕ x₀) : ℂ) := by
      have hθ : glancingTheta C z₀ 0 = (C.ϕ x₀ : ℂ) := by
        rw [hTheta_zero z₀ (by simp [z₀, hs₁_pos])]
        exact C.ϕ_ℂ_real x₀
      unfold glancingOffset supportAction1_ℂ
      simp [z₀, hθ, C.h_ℂ_real]
    have hh_z₀_ne : (C.h (C.ϕ x₀) : ℂ) ≠ 0 :=
      Complex.ofReal_ne_zero.mpr (C.h_pos (C.ϕ x₀)).ne'
    have hr_θ₀_ne : r_ℂ θ₀ ≠ 0 := by
      intro hr0
      have hnorm := C.lazutkin_norm_ℂ z₀ hz₀_strip
      change r_ℂ θ₀ * (deriv C.ϕ_ℂ z₀) ^ 3 = (C.c : ℂ) at hnorm
      rw [hr0, zero_mul] at hnorm
      exact (Complex.ofReal_ne_zero.mpr C.c_pos.ne') hnorm.symm
    have hg_d2_at_p₀ : deriv (deriv (fun z => g_inc z p₀)) z₀ =
        -(r_ℂ θ₀ * (deriv C.ϕ_ℂ z₀) ^ 2 / (C.h (C.ϕ x₀) : ℂ)) := by
      have hθ_z₀ : glancingTheta C z₀ 0 = θ₀ :=
        hTheta_zero z₀ (by simp [z₀, hs₁_pos])
      let K_fn : ℂ → ℂ := fun w => -(r_ℂ (C.ϕ_ℂ w) * deriv C.ϕ_ℂ w / (C.h (C.ϕ x₀) : ℂ))
      let S_fn : ℂ → ℂ := fun w => Complex.sin (C.ϕ_ℂ w - θ₀)
      have hev1 : deriv (fun z => g_inc z p₀) =ᶠ[nhds z₀] (fun w => K_fn w * S_fn w) := by
        filter_upwards [(h_open_strip (2 * C.s₀)).mem_nhds hz₀_strip] with w hw
        rw [(hg_d1 p₀ w hw).deriv]
        obtain ⟨hd0, hd1⟩ := hΓ_deriv w hw
        rw [hd0.deriv, hd1.deriv]
        simp only [p₀, dualLineShift, Int.cast_zero, zero_mul, add_zero, glancingDualLine,
          Matrix.cons_val_zero, Matrix.cons_val_one, hθ_z₀, hoff_z₀, K_fn, S_fn,
          Complex.sin_sub]
        ring
      rw [hev1.deriv_eq]
      have hK_holo : DifferentiableOn ℂ K_fn (horizStrip (2 * C.s₀)) := by
        have hϕ'_holo : DifferentiableOn ℂ (deriv C.ϕ_ℂ) (horizStrip (2 * C.s₀)) :=
          C.ϕ_ℂ_holo.deriv (h_open_strip (2 * C.s₀))
        exact (((hr_ℂ_holo.comp C.ϕ_ℂ_holo C.ϕ_ℂ_maps_to).mul hϕ'_holo).div_const _).neg
      have hK_at : HasDerivAt K_fn (deriv K_fn z₀) z₀ :=
        (hK_holo.differentiableAt ((h_open_strip (2 * C.s₀)).mem_nhds hz₀_strip)).hasDerivAt
      have hϕ_at : HasDerivAt C.ϕ_ℂ (deriv C.ϕ_ℂ z₀) z₀ :=
        (C.ϕ_ℂ_holo.differentiableAt ((h_open_strip (2 * C.s₀)).mem_nhds hz₀_strip)).hasDerivAt
      have hS_at : HasDerivAt S_fn (Complex.cos (θ₀ - θ₀) * deriv C.ϕ_ℂ z₀) z₀ :=
        HasDerivAt.comp (h₂ := Complex.sin) (h := fun w => C.ϕ_ℂ w - θ₀) z₀
          (Complex.hasDerivAt_sin (C.ϕ_ℂ z₀ - θ₀)) (hϕ_at.sub_const θ₀)
      have hS_zero : S_fn z₀ = 0 := by dsimp [S_fn, θ₀]; simp
      have hKS : deriv (fun w => K_fn w * S_fn w) z₀ =
          deriv K_fn z₀ * S_fn z₀ + K_fn z₀ * (Complex.cos (θ₀ - θ₀) * deriv C.ϕ_ℂ z₀) :=
        (hK_at.mul hS_at).deriv
      rw [hKS, hS_zero, mul_zero, zero_add, sub_self, Complex.cos_zero,
        one_mul]
      dsimp [K_fn, θ₀]; ring
    let c₀ : ℂ := (1 / 2 : ℂ) * deriv (deriv (fun z => g_inc z p₀)) z₀
    have hc₀_ne : c₀ ≠ 0 := by
      dsimp [c₀]
      rw [hg_d2_at_p₀]
      exact mul_ne_zero (by norm_num)
        (neg_ne_zero.mpr (div_ne_zero (mul_ne_zero hr_θ₀_ne (pow_ne_zero 2 hc_ϕ_ne)) hh_z₀_ne))
    have hc₀_pos : 0 < ‖c₀‖ := norm_pos_iff.mpr hc₀_ne
    let G₂ : ℂ × (ℂ × ℂ) → ℂ := fun q =>
      dualLineShift C 0 0 q.2 * deriv (deriv (fun z => Γ z 0)) q.1 +
        dualLineShift C 0 1 q.2 * deriv (deriv (fun z => Γ z 1)) q.1
    have hG₂_cont : ContinuousAt G₂ (z₀, p₀) := by
      have hL0_0_at : ContinuousAt (dualLineShift C 0 0) p₀ :=
        (hL₀_holo 0).continuousOn.continuousAt (hD_wide_open.mem_nhds hp₀_wide)
      have hL0_1_at : ContinuousAt (dualLineShift C 0 1) p₀ :=
        (hL₀_holo 1).continuousOn.continuousAt (hD_wide_open.mem_nhds hp₀_wide)
      have hΓ0_at : ContinuousAt (deriv (deriv (fun z => Γ z 0))) z₀ :=
        (hΓ_d2_holo 0).continuousOn.continuousAt ((h_open_strip (2 * C.s₀)).mem_nhds hz₀_strip)
      have hΓ1_at : ContinuousAt (deriv (deriv (fun z => Γ z 1))) z₀ :=
        (hΓ_d2_holo 1).continuousOn.continuousAt ((h_open_strip (2 * C.s₀)).mem_nhds hz₀_strip)
      exact ((ContinuousAt.comp (x := (z₀, p₀)) hL0_0_at continuousAt_snd).mul
        (ContinuousAt.comp (x := (z₀, p₀)) hΓ0_at continuousAt_fst)).add
        ((ContinuousAt.comp (x := (z₀, p₀)) hL0_1_at continuousAt_snd).mul
        (ContinuousAt.comp (x := (z₀, p₀)) hΓ1_at continuousAt_fst))
    have hG₂_base : G₂ (z₀, p₀) = 2 * c₀ := by
      dsimp [G₂, c₀]; rw [← hg_d2 p₀ z₀ hz₀_strip]; ring
    obtain ⟨δ_2, hδ_2_pos, hδ_2_sub⟩ := Metric.mem_nhds_iff.mp
      (hG₂_cont.preimage_mem_nhds
        (by rw [hG₂_base]; exact Metric.ball_mem_nhds (2 * c₀) (half_pos hc₀_pos)))
    let r_s : ℝ := min (min r_inv δ_2) (min (hDet.s_det / 5) (hDet.r_det / 5))
    have hr_s_pos : 0 < r_s :=
      lt_min (lt_min hr_inv_pos hδ_2_pos) (lt_min (by positivity) (by positivity))
    have hr_s_inv : r_s ≤ r_inv := le_trans (min_le_left _ _) (min_le_left _ _)
    have hr_s_δ2 : r_s ≤ δ_2 := le_trans (min_le_left _ _) (min_le_right _ _)
    have hr_s_lt : r_s < min (hDet.s_det / 4) (hDet.r_det / 4) := by
      have hs5 : r_s ≤ hDet.s_det / 5 := le_trans (min_le_right _ _) (min_le_left _ _)
      have hr5 : r_s ≤ hDet.r_det / 5 := le_trans (min_le_right _ _) (min_le_right _ _)
      exact lt_min (by linarith) (by linarith)
    let B_s : Set ℂ := Metric.ball z₀ r_s
    have hB_s_strip : B_s ⊆ horizStrip (2 * C.s₀) :=
      fun w hw => (hr_inv_sub (Metric.ball_subset_ball hr_s_inv hw)).2
    
    have hp₀_D0 : p₀ ∈ D_0 := ⟨Metric.mem_ball_self hr_0_pos, Metric.mem_ball_self hr_0_pos⟩
    have hs_m_p₀ : s_minus p₀ = z₀ := (hs_at_zero z₀ (Metric.mem_ball_self hr_0_pos)).1
    have hs_p_p₀ : s_plus p₀ = z₀ := (hs_at_zero z₀ (Metric.mem_ball_self hr_0_pos)).2
    have hD_0_open : IsOpen D_0 := Metric.isOpen_ball.prod Metric.isOpen_ball
    have hs_m_cont : ContinuousAt s_minus p₀ :=
      hs_minus_holo_D0.continuousOn.continuousAt (hD_0_open.mem_nhds hp₀_D0)
    have hs_p_cont : ContinuousAt s_plus p₀ :=
      hs_plus_holo_D0.continuousOn.continuousAt (hD_0_open.mem_nhds hp₀_D0)
    have hr_ψ_cont : ContinuousAt (fun q => r_ℂ (ψ_plus q)) p₀ :=
      (hr_ℂ_holo.comp hψ_plus_holo.1 hψ_plus_holo.2).continuousOn.continuousAt
        (hD_wide_open.mem_nhds hp₀_wide)
    have hr_ψ_p₀ : r_ℂ (ψ_plus p₀) ≠ 0 := by rw [hψ_p₀.2]; exact hr_θ₀_ne
    have hdψ_y_holo : DifferentiableOn ℂ (iterDerivYT 1 0 ψ_plus) D_wide :=
      hKit.iterDerivYT_holo hD_wide_open hψ_plus_holo.1 1 0
    have hdψ_y_cont : ContinuousAt (iterDerivYT 1 0 ψ_plus) p₀ :=
      hdψ_y_holo.continuousOn.continuousAt (hD_wide_open.mem_nhds hp₀_wide)
    have hdψ_y_p₀ : iterDerivYT 1 0 ψ_plus p₀ ≠ 0 := by
      have heq_d : iterDerivYT 1 0 ψ_plus p₀ = deriv C.ϕ_ℂ z₀ := by
        change deriv (fun y' : ℂ => ψ_plus (y', 0)) z₀ = deriv C.ϕ_ℂ z₀
        apply Filter.EventuallyEq.deriv_eq
        have hz₀_wide : z₀ ∈ horizStrip ((3 / 2 : ℝ) * hDet.s_det) := by
          change |z₀.im| < (3 / 2 : ℝ) * hDet.s_det; simp [z₀, hs_det_pos]
        filter_upwards [(h_open_strip ((3 / 2 : ℝ) * hDet.s_det)).mem_nhds hz₀_wide] with y hy
        exact (hψ_at_zero y hy).2
      rw [heq_d]; exact hc_ϕ_ne
    obtain ⟨δ_3, hδ_3_pos, hδ_3_sub⟩ := Metric.mem_nhds_iff.mp
      (Filter.inter_mem
        (Filter.inter_mem
          (hs_m_cont.preimage_mem_nhds (by rw [hs_m_p₀]; exact Metric.ball_mem_nhds z₀ hr_s_pos))
          (hs_p_cont.preimage_mem_nhds (by rw [hs_p_p₀]; exact Metric.ball_mem_nhds z₀ hr_s_pos)))
        (Filter.inter_mem
          (hr_ψ_cont.preimage_mem_nhds (isOpen_compl_singleton.mem_nhds hr_ψ_p₀))
          (hdψ_y_cont.preimage_mem_nhds (isOpen_compl_singleton.mem_nhds hdψ_y_p₀))))
    let r_env : ℝ := min (min r_s r_1) (min δ_2 δ_3)
    have hr_env_pos : 0 < r_env :=
      lt_min (lt_min hr_s_pos hr_1_pos) (lt_min hδ_2_pos hδ_3_pos)
    have hr_env_le_s : r_env ≤ r_s := le_trans (min_le_left _ _) (min_le_left _ _)
    have hr_env_le_r1 : r_env ≤ r_1 := le_trans (min_le_left _ _) (min_le_right _ _)
    have hr_env_le_δ2 : r_env ≤ δ_2 := le_trans (min_le_right _ _) (min_le_left _ _)
    have hr_env_le_δ3 : r_env ≤ δ_3 := le_trans (min_le_right _ _) (min_le_right _ _)
    let D_env : Set (ℂ × ℂ) := Metric.ball z₀ r_env ×ˢ Metric.ball (0 : ℂ) r_env
    have hD_env_sub_D1 : D_env ⊆ D_1 :=
      Set.prod_mono (Metric.ball_subset_ball hr_env_le_r1) (Metric.ball_subset_ball hr_env_le_r1)
    have hD_env_sub_D0 : D_env ⊆ D_0 := hD_env_sub_D1.trans hD_1_sub_D0
    have hD_env_δ3 : ∀ p ∈ D_env,
        (s_minus p ∈ B_s ∧ s_plus p ∈ B_s) ∧
        r_ℂ (ψ_plus p) ≠ 0 ∧ iterDerivYT 1 0 ψ_plus p ≠ 0 := by
      intro p hp
      apply hδ_3_sub
      rw [Metric.mem_ball, Prod.dist_eq, max_lt_iff]
      exact ⟨lt_of_lt_of_le hp.1 hr_env_le_δ3, lt_of_lt_of_le hp.2 hr_env_le_δ3⟩
    let h_rem : ℂ → ℂ × ℂ → ℂ :=
      fun w p => g_inc w p - c₀ * (w - s_minus p) * (w - s_plus p)
    let Q_inc : ℂ → ℂ × ℂ → ℂ :=
      fun s p => c₀ + dslope (dslope (fun z => h_rem z p) (s_minus p)) (s_plus p) s
    refine ⟨r_s, r_env, s_minus, s_plus, Q_inc,
      hr_env_pos, hr_env_le_s, hr_s_lt,
      hs_minus_holo_D0.mono hD_env_sub_D0,
      hs_plus_holo_D0.mono hD_env_sub_D0,
      fun p hp => ⟨(hD_env_δ3 p hp).1.1, (hD_env_δ3 p hp).1.2,
        (hs_curve_D0 p (hD_env_sub_D0 hp)).1, (hs_curve_D0 p (hD_env_sub_D0 hp)).2⟩,
      ?_, ?_⟩
    · 
      intro s hs p hp
      have hp_D1 : p ∈ D_1 := hD_env_sub_D1 hp
      have hp_D0 : p ∈ D_0 := hD_env_sub_D0 hp
      have hp_wide : p ∈ D_wide := hD_0_sub_wide hp_D0
      obtain ⟨⟨hsm_Bs, hsp_Bs⟩, _, _⟩ := hD_env_δ3 p hp
      obtain ⟨hΓ_sm, hΓ_sp⟩ := hs_curve_D0 p hp_D0
      obtain ⟨hb0, _, _, hbt⟩ := hD_wide_bounds p hp_wide
      obtain ⟨hinc_m, hinc_p⟩ := hIncidence p.1 p.2 hb0 hbt
      have harg0 : p.1 + ((0 : ℤ) : ℂ) * p.2 = p.1 := by push_cast; ring
      have hg_sm : g_inc (s_minus p) p = 0 := by
        dsimp [g_inc]
        change dualLineShift C 0 0 p * glancingBoundaryCurve C (s_minus p) 0 +
          dualLineShift C 0 1 p * glancingBoundaryCurve C (s_minus p) 1 - 1 = 0
        rw [hΓ_sm]; simp only [dualLineShift, harg0]; linear_combination hinc_m
      have hg_sp : g_inc (s_plus p) p = 0 := by
        dsimp [g_inc]
        change dualLineShift C 0 0 p * glancingBoundaryCurve C (s_plus p) 0 +
          dualLineShift C 0 1 p * glancingBoundaryCurve C (s_plus p) 1 - 1 = 0
        rw [hΓ_sp]; simp only [dualLineShift, harg0]; linear_combination hinc_p
      let hp_fn : ℂ → ℂ := fun z => h_rem z p
      have hhp_sm : hp_fn (s_minus p) = 0 := by dsimp [hp_fn, h_rem]; rw [hg_sm]; ring
      have hhp_sp : hp_fn (s_plus p) = 0 := by dsimp [hp_fn, h_rem]; rw [hg_sp]; ring
      have hhp_d1 : ∀ w ∈ horizStrip (2 * C.s₀),
          HasDerivAt hp_fn
            (deriv (fun z => g_inc z p) w - c₀ * ((w - s_plus p) + (w - s_minus p))) w := by
        intro w hw
        have hd_g : HasDerivAt (fun z => g_inc z p) (deriv (fun z => g_inc z p) w) w :=
          (hg_d1 p w hw).deriv ▸ hg_d1 p w hw
        have hd_q : HasDerivAt (fun z => c₀ * (z - s_minus p) * (z - s_plus p))
            (c₀ * ((w - s_plus p) + (w - s_minus p))) w := by
          have h1 : HasDerivAt (fun z => z - s_minus p) 1 w :=
            (hasDerivAt_id w).sub_const (s_minus p)
          have h2 : HasDerivAt (fun z => z - s_plus p) 1 w :=
            (hasDerivAt_id w).sub_const (s_plus p)
          have hval : c₀ * 1 * (w - s_plus p) + c₀ * (w - s_minus p) * 1 =
              c₀ * ((w - s_plus p) + (w - s_minus p)) := by ring
          rw [← hval]
          exact (h1.const_mul c₀).mul h2
        exact hd_g.sub hd_q
      have hhp_holo : DifferentiableOn ℂ hp_fn B_s :=
        fun w hw => (hhp_d1 w (hB_s_strip hw)).differentiableAt.differentiableWithinAt
      have hhp_d2_bnd : ∀ w ∈ B_s, ‖deriv (deriv hp_fn) w‖ ≤ ‖c₀‖ / 2 := by
        intro w hw
        have hw_strip : w ∈ horizStrip (2 * C.s₀) := hB_s_strip hw
        have hev : deriv hp_fn =ᶠ[nhds w]
            (fun z => (dualLineShift C 0 0 p * deriv (fun u => Γ u 0) z +
                dualLineShift C 0 1 p * deriv (fun u => Γ u 1) z) -
              c₀ * ((z - s_plus p) + (z - s_minus p))) := by
          filter_upwards [(h_open_strip (2 * C.s₀)).mem_nhds hw_strip] with z hz
          rw [(hhp_d1 z hz).deriv, (hg_d1 p z hz).deriv]
        rw [hev.deriv_eq]
        have hd_rhs : HasDerivAt
            (fun z => dualLineShift C 0 0 p * deriv (fun u => Γ u 0) z +
              dualLineShift C 0 1 p * deriv (fun u => Γ u 1) z)
            (G₂ (w, p)) w :=
          ((((hΓ_d1_holo 0).differentiableAt
              ((h_open_strip (2 * C.s₀)).mem_nhds hw_strip)).hasDerivAt).const_mul _).add
            ((((hΓ_d1_holo 1).differentiableAt
              ((h_open_strip (2 * C.s₀)).mem_nhds hw_strip)).hasDerivAt).const_mul _)
        have hd_lin : HasDerivAt (fun z => c₀ * ((z - s_plus p) + (z - s_minus p))) (2 * c₀) w := by
          have h1 : HasDerivAt (fun z => (z - s_plus p) + (z - s_minus p)) (1 + 1) w :=
            ((hasDerivAt_id w).sub_const _).add ((hasDerivAt_id w).sub_const _)
          have hval2 : c₀ * (1 + 1) = 2 * c₀ := by ring
          rw [← hval2]
          exact h1.const_mul c₀
        have hsub_d : deriv
            (fun z => (dualLineShift C 0 0 p * deriv (fun u => Γ u 0) z +
                dualLineShift C 0 1 p * deriv (fun u => Γ u 1) z) -
              c₀ * ((z - s_plus p) + (z - s_minus p))) w = G₂ (w, p) - 2 * c₀ :=
          (hd_rhs.sub hd_lin).deriv
        rw [hsub_d]
        have hmem_δ2 : (w, p) ∈ Metric.ball (z₀, p₀) δ_2 := by
          rw [Metric.mem_ball, Prod.dist_eq, max_lt_iff]
          refine ⟨lt_of_lt_of_le hw hr_s_δ2, ?_⟩
          rw [Prod.dist_eq, max_lt_iff]
          exact ⟨lt_of_lt_of_le hp.1 hr_env_le_δ2, lt_of_lt_of_le hp.2 hr_env_le_δ2⟩
        have hlt : dist (G₂ (w, p)) (2 * c₀) < ‖c₀‖ / 2 := hδ_2_sub hmem_δ2
        rw [dist_eq_norm] at hlt
        exact le_of_lt hlt
      have hg1_mul : ∀ w : ℂ, (w - s_minus p) * dslope hp_fn (s_minus p) w = hp_fn w := by
        intro w
        have hsub := sub_smul_dslope hp_fn (s_minus p) w
        rw [hhp_sm, sub_zero, smul_eq_mul] at hsub
        exact hsub
      have hg1_sp : dslope hp_fn (s_minus p) (s_plus p) = 0 := by
        by_cases ht0 : p.2 = 0
        · have hp_eta : p = (p.1, 0) := Prod.ext rfl ht0
          have hp1_D0 : p.1 ∈ Metric.ball z₀ r_0 := hp_D0.1
          obtain ⟨hsm0, hsp0⟩ := hs_at_zero p.1 hp1_D0
          rw [hp_eta] at hhp_d1 ⊢
          rw [hsm0, hsp0, dslope_same]
          have hp1_strip : p.1 ∈ horizStrip (2 * C.s₀) :=
            hB_s_strip (by rw [← hsm0, ← hp_eta]; exact hsm_Bs)
          have hp1_2s₁ : |p.1.im| < 2 * C.s₁ := by
            have : |p.1.im| < 2 * C.s₀ := hp1_strip
            have : |p.1.im| < (3 / 2 : ℝ) * hDet.s_det := hp_wide.1
            linarith
          have hd_at_p1 := (hhp_d1 p.1 hp1_strip).deriv
          rw [hp_eta, hsm0, hsp0, sub_self, add_zero, mul_zero, sub_zero,
            hg_d1_diag_zero p.1 hp1_strip hp1_2s₁] at hd_at_p1
          exact hd_at_p1
        · have hne : s_plus p - s_minus p ≠ 0 :=
            sub_ne_zero.mpr (hs_sep_D1 p hp_D1 ht0)
          have hmul := hg1_mul (s_plus p)
          rw [hhp_sp] at hmul
          exact (mul_eq_zero.mp hmul).resolve_left hne
      have hQ_mul :
          (s - s_plus p) * dslope (dslope hp_fn (s_minus p)) (s_plus p) s =
            dslope hp_fn (s_minus p) s := by
        have hsub := sub_smul_dslope (dslope hp_fn (s_minus p)) (s_plus p) s
        rw [hg1_sp, sub_zero, smul_eq_mul] at hsub
        exact hsub
      have hfactor :
          dualLineShift C 0 0 p * glancingBoundaryCurve C s 0 +
            dualLineShift C 0 1 p * glancingBoundaryCurve C s 1 - 1 =
            (s - s_minus p) * (s - s_plus p) * Q_inc s p := by
        change g_inc s p =
          (s - s_minus p) * (s - s_plus p) *
            (c₀ + dslope (dslope hp_fn (s_minus p)) (s_plus p) s)
        have hstep :
            (s - s_minus p) * (s - s_plus p) *
              (c₀ + dslope (dslope hp_fn (s_minus p)) (s_plus p) s) =
              c₀ * (s - s_minus p) * (s - s_plus p) +
                (s - s_minus p) *
                  ((s - s_plus p) * dslope (dslope hp_fn (s_minus p)) (s_plus p) s) := by ring
        rw [hstep, hQ_mul, hg1_mul s]
        dsimp [hp_fn, h_rem]; ring
      
      have hM_nonneg : 0 ≤ ‖c₀‖ / 2 := by positivity
      have hd1_holo : DifferentiableOn ℂ (deriv hp_fn) B_s := hhp_holo.deriv Metric.isOpen_ball
      have hseg : ∀ z ∈ B_s, ∀ u ∈ Set.uIcc (0 : ℝ) 1,
          s_minus p + (u : ℂ) * (z - s_minus p) ∈ B_s := by
        intro z hz u hu
        rw [Set.uIcc_of_le zero_le_one] at hu
        have heq : s_minus p + (u : ℂ) * (z - s_minus p) = (1 - u) • s_minus p + u • z := by
          simp [Complex.real_smul]; ring
        rw [heq]
        exact (convex_ball z₀ r_s) hsm_Bs hz (by linarith [hu.2]) hu.1 (by ring)
      have hg1_int : ∀ z ∈ B_s,
          dslope hp_fn (s_minus p) z =
            ∫ u in (0 : ℝ)..1, deriv hp_fn (s_minus p + (u : ℂ) * (z - s_minus p)) := by
        intro z hz
        by_cases hne : z = s_minus p
        · rw [hne]; simp [dslope_same]
        · have hderiv : ∀ u ∈ Set.uIcc (0 : ℝ) 1,
              HasDerivAt (fun t : ℝ => hp_fn (s_minus p + (t : ℂ) * (z - s_minus p)))
                ((z - s_minus p) * deriv hp_fn (s_minus p + (u : ℂ) * (z - s_minus p))) u := by
            intro u hu
            have h1 : HasDerivAt (fun t : ℝ => s_minus p + (t : ℂ) * (z - s_minus p))
                (z - s_minus p) u := by
              simpa using
                (((hasDerivAt_id u).ofReal_comp.mul_const (z - s_minus p)).const_add (s_minus p))
            have h2 : HasDerivAt hp_fn (deriv hp_fn (s_minus p + (u : ℂ) * (z - s_minus p)))
                (s_minus p + (u : ℂ) * (z - s_minus p)) :=
              (hhp_holo.differentiableAt
                (Metric.isOpen_ball.mem_nhds (hseg z hz u hu))).hasDerivAt
            simpa [Function.comp_def, mul_comm] using
              (h2.hasFDerivAt.restrictScalars ℝ).comp_hasDerivAt u h1
          have hint_f : IntervalIntegrable
              (fun u : ℝ => deriv hp_fn (s_minus p + (u : ℂ) * (z - s_minus p)))
              MeasureTheory.volume 0 1 :=
            (hd1_holo.continuousOn.comp
              (continuous_const.add (Complex.continuous_ofReal.mul continuous_const)).continuousOn
              (hseg z hz)).intervalIntegrable
          have hftc := intervalIntegral.integral_eq_sub_of_hasDerivAt hderiv
            (hint_f.const_mul (z - s_minus p))
          rw [intervalIntegral.integral_const_mul] at hftc
          simp only [Complex.ofReal_one, Complex.ofReal_zero, one_mul, zero_mul, add_zero,
            add_sub_cancel] at hftc
          rw [dslope_of_ne hp_fn hne, slope_def_field, ← hftc,
            mul_div_cancel_left₀ _ (sub_ne_zero.mpr hne)]
      have hg1_lip : ∀ z ∈ B_s,
          ‖dslope hp_fn (s_minus p) z - dslope hp_fn (s_minus p) (s_plus p)‖ ≤
            (‖c₀‖ / 2) * ‖z - s_plus p‖ := by
        intro z hz
        rw [hg1_int z hz, hg1_int (s_plus p) hsp_Bs]
        have hint1 : IntervalIntegrable
            (fun u : ℝ => deriv hp_fn (s_minus p + (u : ℂ) * (z - s_minus p)))
            MeasureTheory.volume 0 1 :=
          (hd1_holo.continuousOn.comp
            (continuous_const.add (Complex.continuous_ofReal.mul continuous_const)).continuousOn
            (hseg z hz)).intervalIntegrable
        have hint2 : IntervalIntegrable
            (fun u : ℝ => deriv hp_fn (s_minus p + (u : ℂ) * (s_plus p - s_minus p)))
            MeasureTheory.volume 0 1 :=
          (hd1_holo.continuousOn.comp
            (continuous_const.add (Complex.continuous_ofReal.mul continuous_const)).continuousOn
            (hseg (s_plus p) hsp_Bs)).intervalIntegrable
        rw [← intervalIntegral.integral_sub hint1 hint2]
        have hbound : ∀ u ∈ Set.uIoc (0 : ℝ) 1,
            ‖deriv hp_fn (s_minus p + (u : ℂ) * (z - s_minus p)) -
              deriv hp_fn (s_minus p + (u : ℂ) * (s_plus p - s_minus p))‖ ≤
              (‖c₀‖ / 2) * ‖z - s_plus p‖ := by
          intro u hu
          rw [Set.uIoc_of_le zero_le_one] at hu
          have hu_mem : u ∈ Set.uIcc (0 : ℝ) 1 := by
            rw [Set.uIcc_of_le zero_le_one]; exact ⟨le_of_lt hu.1, hu.2⟩
          have hmvt := (convex_ball z₀ r_s).norm_image_sub_le_of_norm_deriv_le
            (fun w hw => hd1_holo.differentiableAt (Metric.isOpen_ball.mem_nhds hw))
            hhp_d2_bnd (hseg (s_plus p) hsp_Bs u hu_mem) (hseg z hz u hu_mem)
          have hnorm_diff :
              ‖(s_minus p + (u : ℂ) * (z - s_minus p)) -
                (s_minus p + (u : ℂ) * (s_plus p - s_minus p))‖ =
                u * ‖z - s_plus p‖ := by
            rw [show (s_minus p + (u : ℂ) * (z - s_minus p)) -
                (s_minus p + (u : ℂ) * (s_plus p - s_minus p)) = (u : ℂ) * (z - s_plus p) by ring,
              norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hu.1]
          rw [hnorm_diff] at hmvt
          have hu_le : u * ‖z - s_plus p‖ ≤ 1 * ‖z - s_plus p‖ :=
            mul_le_mul_of_nonneg_right hu.2 (norm_nonneg _)
          exact le_trans hmvt (by nlinarith [hM_nonneg])
        have hint_le := intervalIntegral.norm_integral_le_of_norm_le_const hbound
        simpa using hint_le
      have hQ_tilde_le : ‖dslope (dslope hp_fn (s_minus p)) (s_plus p) s‖ ≤ ‖c₀‖ / 2 := by
        by_cases hne : s = s_plus p
        · rw [hne, dslope_same]
          refine norm_deriv_le_of_lip' hM_nonneg ?_
          filter_upwards [Metric.isOpen_ball.mem_nhds hsp_Bs] with z hz
          exact hg1_lip z hz
        · rw [dslope_of_ne _ hne, slope_def_field, norm_div]
          exact (div_le_iff₀ (norm_pos_iff.mpr (sub_ne_zero.mpr hne))).mpr (hg1_lip s hs)
      have hQ_ne : Q_inc s p ≠ 0 := by
        intro hQ0
        have heq_neg : dslope (dslope hp_fn (s_minus p)) (s_plus p) s = -c₀ :=
          eq_neg_of_add_eq_zero_right hQ0
        rw [heq_neg, norm_neg] at hQ_tilde_le
        linarith [hc₀_pos]
      exact ⟨hQ_ne, hfactor⟩
    · 
      intro B F hB_open hB_sub hF_holo hHyp q hq ι
      have hB_wide : B ⊆ D_wide := hB_sub.trans (hD_env_sub_D0.trans hD_0_sub_wide)
      have hq_env : q ∈ D_env := hB_sub hq
      have hq_wide : q ∈ D_wide := hB_wide hq
      obtain ⟨hW2_ne, hW0_fac, hW1_fac, hRes0⟩ := hHyp q hq
      have hReflect := (hUnifiedReflect B F hB_open hB_wide hF_holo
        (fun q' hq' => ⟨(hHyp q' hq').2.1, (hHyp q' hq').2.2.1⟩) q hq).2 ι
      rw [hRes0 ι] at hReflect
      obtain ⟨_, hr_ψ_ne, hdψ_ne⟩ := hD_env_δ3 q hq_env
      obtain ⟨hb0, hb1, _, hbt⟩ := hD_wide_bounds q hq_wide
      have hp₀_ne : glancingOffset C q.1 q.2 ≠ 0 := hDet.offset_ne_zero q.1 q.2 hb0 hbt
      have hp₁_ne : glancingOffset C (q.1 + q.2) q.2 ≠ 0 :=
        hDet.offset_ne_zero (q.1 + q.2) q.2 hb1 hbt
      have hpref_ne :
          homIntersect (dualLineShift C 0) F 2 q *
            ((homIntersect (dualLineShift C 0) F 2 q ^ 2 * r_ℂ (ψ_plus q) *
                iterDerivYT 1 0 ψ_plus q) ^ 2 *
              glancingOffset C (q.1 + q.2) q.2 / glancingOffset C q.1 q.2) ≠ 0 :=
        mul_ne_zero hW2_ne
          (div_ne_zero
            (mul_ne_zero
              (pow_ne_zero 2 (mul_ne_zero (mul_ne_zero (pow_ne_zero 2 hW2_ne) hr_ψ_ne) hdψ_ne))
              hp₁_ne)
            hp₀_ne)
      have hsub_zero : dualLineShift C 1 ι q - F ι q = 0 :=
        (mul_eq_zero.mp hReflect.symm).resolve_left hpref_ne
      exact (sub_eq_zero.mp hsub_zero).symm
  exact ⟨{
    dualLine_even := hDualLineEven
    symJet_neg_t := fun q_idx neg_idx M p hneg ht hsh v =>
      hSymJetNegT q_idx neg_idx M p hneg ht hsh v
    primary_rank_one := hPrimaryRankOne
    primary_reflect := hPrimaryReflect
    primary_w2_ne_zero := hPrimaryW2
    primary_not_isotropic_line := hPrimaryNotIso
    primary_step_distinct := hPrimaryStep
    envelope_quad_factor := hEnvelopeQuadFactor
  }⟩

theorem zero_avoiding_preconnected_and_root_detour (hKit : Holo2DAndTaylorToolkit) :
    ZeroAvoidingRootContKit :=
by
  
  have hDetour : ∀ {U : Set (ℂ × ℂ)} {H : ℂ × ℂ → ℂ} {p_a p_b : ℂ × ℂ},
      IsOpen U → Convex ℝ U → DifferentiableOn ℂ H U →
      p_a ∈ U → H p_a ≠ 0 → p_b ∈ U → H p_b ≠ 0 →
      ∃ p₁ p₂ : ℂ × ℂ,
        (∀ τ ∈ Set.Icc (0 : ℝ) 1, (1 - τ) • p_a + τ • p₁ ∈ { q ∈ U | H q ≠ 0 }) ∧
        (∀ τ ∈ Set.Icc (0 : ℝ) 1, (1 - τ) • p₁ + τ • p₂ ∈ { q ∈ U | H q ≠ 0 }) ∧
        (∀ τ ∈ Set.Icc (0 : ℝ) 1, (1 - τ) • p₂ + τ • p_b ∈ { q ∈ U | H q ≠ 0 }) := by
    intro U H p_a p_b hU hConv hH hp_a hHa hp_b hHb
    let φ : ℂ → ℂ × ℂ := fun z =>
      ((1 - z) * p_a.1 + z * p_b.1, (1 - z) * p_a.2 + z * p_b.2)
    have hφ_diff : Differentiable ℂ φ :=
      ((((differentiable_const (1 : ℂ)).sub differentiable_id).mul
          (differentiable_const p_a.1)).add
        (differentiable_id.mul (differentiable_const p_b.1))).prodMk
      ((((differentiable_const (1 : ℂ)).sub differentiable_id).mul
          (differentiable_const p_a.2)).add
        (differentiable_id.mul (differentiable_const p_b.2)))
    have hφ0 : φ 0 = p_a := by ext <;> simp [φ]
    have hφ1 : φ 1 = p_b := by ext <;> simp [φ]
    have hφ_seg : ∀ (z₀ z₁ : ℂ) (τ : ℝ),
        (1 - τ) • φ z₀ + τ • φ z₁ =
          φ (((1 - τ : ℝ) : ℂ) * z₀ + (τ : ℂ) * z₁) := by
      intro z₀ z₁ τ
      ext <;>
        simp only [φ, Prod.smul_fst, Prod.smul_snd, Prod.fst_add, Prod.snd_add,
          Complex.real_smul] <;>
        push_cast <;> ring
    have hφ_real_mem : ∀ u ∈ Set.Icc (0 : ℝ) 1, φ (u : ℂ) ∈ U := by
      intro u hu
      have h_eq : (1 - u) • p_a + u • p_b = φ (u : ℂ) := by
        rw [← hφ0, ← hφ1, hφ_seg]
        simp
      rw [← h_eq]
      exact hConv hp_a hp_b (sub_nonneg.mpr hu.2) hu.1 (sub_add_cancel 1 u)
    let I_ℂ : Set ℂ := Complex.ofReal '' Set.Icc (0 : ℝ) 1
    have hI_comp : IsCompact I_ℂ := isCompact_Icc.image Complex.continuous_ofReal
    have hU_pre_open : IsOpen (φ ⁻¹' U) := hU.preimage hφ_diff.continuous
    have hI_sub : I_ℂ ⊆ φ ⁻¹' U := by
      rintro z ⟨u, hu, rfl⟩
      exact hφ_real_mem u hu
    obtain ⟨ε, hε_pos, hε_thick⟩ :=
      hI_comp.exists_thickening_subset_open hU_pre_open hI_sub
    let δ : ℝ := ε / 2
    have hδ_pos : 0 < δ := by dsimp [δ]; linarith
    let R_δ : Set ℂ := { z : ℂ | -δ < z.re ∧ z.re < 1 + δ ∧ -δ < z.im ∧ z.im < δ }
    have hRδ_eq : R_δ =
        (Complex.reCLM ⁻¹' Set.Ioo (-δ) (1 + δ)) ∩
          (Complex.imCLM ⁻¹' Set.Ioo (-δ) δ) := by
      ext z
      simp [R_δ, Set.mem_Ioo, and_assoc]
    have hRδ_open : IsOpen R_δ := by
      rw [hRδ_eq]
      exact (isOpen_Ioo.preimage Complex.reCLM.continuous).inter
        (isOpen_Ioo.preimage Complex.imCLM.continuous)
    have hRδ_preconn : IsPreconnected R_δ := by
      rw [hRδ_eq]
      exact (((convex_Ioo (-δ) (1 + δ)).linear_preimage Complex.reCLM.toLinearMap).inter
        ((convex_Ioo (-δ) δ).linear_preimage Complex.imCLM.toLinearMap)).isPreconnected
    have hφ_maps : Set.MapsTo φ R_δ U := by
      intro z ⟨hz_re1, hz_re2, hz_im1, hz_im2⟩
      have h_clamp : ∃ u ∈ Set.Icc (0 : ℝ) 1, |z.re - u| < δ := by
        rcases le_or_gt z.re 0 with hz0 | hz0
        · refine ⟨0, ⟨le_rfl, zero_le_one⟩, abs_lt.mpr ⟨by linarith, by linarith⟩⟩
        · rcases le_or_gt z.re 1 with hz1 | hz1
          · refine ⟨z.re, ⟨le_of_lt hz0, hz1⟩, by simp [hδ_pos]⟩
          · refine ⟨1, ⟨zero_le_one, le_rfl⟩, abs_lt.mpr ⟨by linarith, by linarith⟩⟩
      obtain ⟨u, hu_mem, hu_re⟩ := h_clamp
      have hz_im : |z.im| < δ := abs_lt.mpr ⟨hz_im1, hz_im2⟩
      have hz_sub : z - (u : ℂ) = ((z.re - u : ℝ) : ℂ) + (z.im : ℂ) * Complex.I := by
        apply Complex.ext <;> simp
      have h_dist : dist z (u : ℂ) < ε := by
        rw [dist_eq_norm, hz_sub]
        calc ‖((z.re - u : ℝ) : ℂ) + (z.im : ℂ) * Complex.I‖
            ≤ ‖((z.re - u : ℝ) : ℂ)‖ + ‖(z.im : ℂ) * Complex.I‖ := norm_add_le _ _
          _ = |z.re - u| + |z.im| := by
              rw [norm_mul, Complex.norm_I, mul_one, Complex.norm_real, Complex.norm_real,
                Real.norm_eq_abs, Real.norm_eq_abs]
          _ < δ + δ := add_lt_add hu_re hz_im
          _ = ε := by dsimp [δ]; ring
      exact hε_thick (Metric.mem_thickening_iff.mpr ⟨(u : ℂ), ⟨u, hu_mem, rfl⟩, h_dist⟩)
    let h : ℂ → ℂ := H ∘ φ
    have hh_diff : DifferentiableOn ℂ h R_δ := hH.comp hφ_diff.differentiableOn hφ_maps
    have hh_ana : AnalyticOnNhd ℂ h R_δ := hh_diff.analyticOnNhd hRδ_open
    have h0_Rδ : (0 : ℂ) ∈ R_δ := by
      refine ⟨?_, ?_, ?_, ?_⟩ <;> simp <;> linarith
    have h1_Rδ : (1 : ℂ) ∈ R_δ := by
      refine ⟨?_, ?_, ?_, ?_⟩ <;> simp <;> linarith
    have hh0 : h 0 ≠ 0 := by simpa [h, hφ0] using hHa
    have hh1 : h 1 ≠ 0 := by simpa [h, hφ1] using hHb
    obtain ⟨r₀, hr₀_pos, hr₀_nz⟩ :=
      Metric.mem_nhds_iff.mp
        ((hh_ana 0 h0_Rδ).continuousAt.preimage_mem_nhds
          (isOpen_compl_singleton.mem_nhds hh0))
    obtain ⟨r₁, hr₁_pos, hr₁_nz⟩ :=
      Metric.mem_nhds_iff.mp
        ((hh_ana 1 h1_Rδ).continuousAt.preimage_mem_nhds
          (isOpen_compl_singleton.mem_nhds hh1))
    let η₀ : ℝ := min (δ / 2) (min r₀ r₁)
    have hη₀_pos : 0 < η₀ := lt_min (by linarith) (lt_min hr₀_pos hr₁_pos)
    let ψ_ℂ : ℝ × ℝ → ℂ := fun x => (x.1 : ℂ) + (x.2 : ℂ) * Complex.I
    have hψ_cont : Continuous ψ_ℂ :=
      (Complex.continuous_ofReal.comp continuous_fst).add
        ((Complex.continuous_ofReal.comp continuous_snd).mul continuous_const)
    let K_rect : Set ℂ := ψ_ℂ '' (Set.Icc (0 : ℝ) 1 ×ˢ Set.Icc (-δ / 2) (δ / 2))
    have hK_comp : IsCompact K_rect := (isCompact_Icc.prod isCompact_Icc).image hψ_cont
    have hK_sub_Rδ : K_rect ⊆ R_δ := by
      rintro z ⟨⟨x, y⟩, ⟨⟨hx1, hx2⟩, ⟨hy1, hy2⟩⟩, rfl⟩
      have hre : (ψ_ℂ (x, y)).re = x := by simp [ψ_ℂ]
      have him : (ψ_ℂ (x, y)).im = y := by simp [ψ_ℂ]
      exact ⟨by linarith, by linarith, by linarith, by linarith⟩
    let Z_K : Set ℂ := K_rect ∩ h ⁻¹' {(0 : ℂ)}
    have hZK_closed : IsClosed Z_K :=
      (hh_diff.continuousOn.mono hK_sub_Rδ).preimage_isClosed_of_isClosed
        hK_comp.isClosed isClosed_singleton
    have hZK_comp : IsCompact Z_K :=
      hK_comp.of_isClosed_subset hZK_closed Set.inter_subset_left
    have h_iso : ∀ z : ↥Z_K, ∃ r_z : ℝ, 0 < r_z ∧
        ∀ w ∈ Metric.ball z.1 r_z, w ≠ z.1 → h w ≠ 0 := by
      intro z
      have hz_Rδ : z.1 ∈ R_δ := hK_sub_Rδ z.2.1
      rcases (hh_ana z.1 hz_Rδ).eventually_eq_zero_or_eventually_ne_zero with h_ev0 | h_ev_ne
      · exfalso
        have h0_eq : h 0 = 0 :=
          AnalyticOnNhd.eqOn_zero_of_preconnected_of_eventuallyEq_zero
            hh_ana hRδ_preconn hz_Rδ h_ev0 h0_Rδ
        exact hh0 h0_eq
      · rw [eventually_nhdsWithin_iff, Metric.eventually_nhds_iff] at h_ev_ne
        obtain ⟨r_z, hr_z_pos, hr_z⟩ := h_ev_ne
        exact ⟨r_z, hr_z_pos, fun w hw hw_ne => hr_z (Metric.mem_ball.mp hw) hw_ne⟩
    choose r_iso hr_iso_pos hr_iso using h_iso
    obtain ⟨t_cov, ht_cov⟩ :=
      hZK_comp.elim_finite_subcover
        (fun z : ↥Z_K => Metric.ball z.1 (r_iso z))
        (fun _ => Metric.isOpen_ball)
        (fun x hx => Set.mem_iUnion.mpr ⟨⟨x, hx⟩, Metric.mem_ball_self (hr_iso_pos ⟨x, hx⟩)⟩)
    have hZK_sub_fin : Z_K ⊆ Subtype.val '' (t_cov : Set ↥Z_K) := by
      intro w hw
      have hw_un := ht_cov hw
      rcases Set.mem_iUnion₂.mp hw_un with ⟨z, hz_t, hw_ball⟩
      refine ⟨z, hz_t, ?_⟩
      by_contra hw_ne
      exact hr_iso z w hw_ball (Ne.symm hw_ne) hw.2
    have hZK_fin : Z_K.Finite := (t_cov.finite_toSet.image Subtype.val).subset hZK_sub_fin
    let F_im : Set ℝ := Complex.im '' Z_K
    have hFim_fin : F_im.Finite := hZK_fin.image Complex.im
    let g_seq : ℕ → ℝ := fun n => η₀ / (4 * ((n : ℝ) + 1))
    have hg_inj : Function.Injective g_seq := by
      intro m n hmn
      dsimp [g_seq] at hmn
      have hm_pos : (0 : ℝ) < 4 * ((m : ℝ) + 1) := by positivity
      have hn_pos : (0 : ℝ) < 4 * ((n : ℝ) + 1) := by positivity
      rw [div_eq_div_iff (ne_of_gt hm_pos) (ne_of_gt hn_pos)] at hmn
      have h_lin : 4 * ((m : ℝ) + 1) = 4 * ((n : ℝ) + 1) :=
        mul_left_cancel₀ (ne_of_gt hη₀_pos) (by linarith)
      have h_cast : (m : ℝ) = (n : ℝ) := by linarith
      exact Nat.cast_inj.mp h_cast
    have hg_inf : (Set.range g_seq).Infinite := Set.infinite_range_of_injective hg_inj
    have hex_n : ∃ n : ℕ, g_seq n ∉ F_im := by
      by_contra h_all
      push Not at h_all
      exact hg_inf (hFim_fin.subset (by rintro _ ⟨n, rfl⟩; exact h_all n))
    obtain ⟨n₀, hn₀_not_mem⟩ := hex_n
    let s₀ : ℝ := g_seq n₀
    have hs₀_pos : 0 < s₀ := by
      dsimp [s₀, g_seq]
      exact div_pos hη₀_pos (by positivity)
    have hs₀_lt_η₀ : s₀ < η₀ := by
      dsimp [s₀, g_seq]
      have hden_gt : (1 : ℝ) < 4 * ((n₀ : ℝ) + 1) := by
        have hn0 : (0 : ℝ) ≤ (n₀ : ℝ) := Nat.cast_nonneg n₀
        linarith
      exact div_lt_self hη₀_pos hden_gt
    have hs₀_le_δ2 : s₀ ≤ δ / 2 :=
      le_of_lt (lt_of_lt_of_le hs₀_lt_η₀ (min_le_left _ _))
    have hs₀_lt_r₀ : s₀ < r₀ :=
      lt_of_lt_of_le hs₀_lt_η₀ (le_trans (min_le_right _ _) (min_le_left _ _))
    have hs₀_lt_r₁ : s₀ < r₁ :=
      lt_of_lt_of_le hs₀_lt_η₀ (le_trans (min_le_right _ _) (min_le_right _ _))
    let z₁ : ℂ := (s₀ : ℂ) * Complex.I
    let z₂ : ℂ := 1 + (s₀ : ℂ) * Complex.I
    refine ⟨φ z₁, φ z₂, ?_, ?_, ?_⟩
    · 
      intro τ hτ
      have h_pt : (1 - τ) • p_a + τ • φ z₁ = φ (((τ * s₀ : ℝ) : ℂ) * Complex.I) := by
        rw [← hφ0, hφ_seg]
        congr 1
        dsimp [z₁]
        push_cast
        ring
      rw [h_pt]
      let ζ₁ : ℂ := ((τ * s₀ : ℝ) : ℂ) * Complex.I
      have hτs_nonneg : 0 ≤ τ * s₀ := mul_nonneg hτ.1 (le_of_lt hs₀_pos)
      have hτs_le : τ * s₀ ≤ s₀ := mul_le_of_le_one_left (le_of_lt hs₀_pos) hτ.2
      have hζ₁_Rδ : ζ₁ ∈ R_δ := by
        have hre : ζ₁.re = 0 := by simp [ζ₁]
        have him : ζ₁.im = τ * s₀ := by simp [ζ₁]
        exact ⟨by linarith, by linarith, by linarith, by linarith⟩
      have hζ₁_ball : ζ₁ ∈ Metric.ball (0 : ℂ) r₀ := by
        rw [Metric.mem_ball, dist_zero_right]
        dsimp [ζ₁]
        rw [norm_mul, Complex.norm_I, mul_one, Complex.norm_real, Real.norm_eq_abs,
          abs_of_nonneg hτs_nonneg]
        exact lt_of_le_of_lt hτs_le hs₀_lt_r₀
      exact ⟨hφ_maps hζ₁_Rδ, hr₀_nz hζ₁_ball⟩
    · 
      intro τ hτ
      have h_pt : (1 - τ) • φ z₁ + τ • φ z₂ = φ (ψ_ℂ (τ, s₀)) := by
        rw [hφ_seg]
        congr 1
        dsimp [z₁, z₂, ψ_ℂ]
        push_cast
        ring
      rw [h_pt]
      let ζ₂ : ℂ := ψ_ℂ (τ, s₀)
      have hζ₂_K : ζ₂ ∈ K_rect :=
        ⟨(τ, s₀), ⟨hτ, ⟨by linarith, hs₀_le_δ2⟩⟩, rfl⟩
      refine ⟨hφ_maps (hK_sub_Rδ hζ₂_K), ?_⟩
      intro hh_zero
      apply hn₀_not_mem
      have hζ₂_ZK : ζ₂ ∈ Z_K := ⟨hζ₂_K, hh_zero⟩
      have him : ζ₂.im = s₀ := by simp [ζ₂, ψ_ℂ]
      exact ⟨ζ₂, hζ₂_ZK, him⟩
    · 
      intro τ hτ
      have h_pt : (1 - τ) • φ z₂ + τ • p_b =
          φ (1 + (((1 - τ) * s₀ : ℝ) : ℂ) * Complex.I) := by
        rw [← hφ1, hφ_seg]
        congr 1
        dsimp [z₂]
        push_cast
        ring
      rw [h_pt]
      let ζ₃ : ℂ := 1 + (((1 - τ) * s₀ : ℝ) : ℂ) * Complex.I
      have h1τ_nonneg : 0 ≤ (1 - τ) * s₀ :=
        mul_nonneg (sub_nonneg.mpr hτ.2) (le_of_lt hs₀_pos)
      have h1τ_le : (1 - τ) * s₀ ≤ s₀ :=
        mul_le_of_le_one_left (le_of_lt hs₀_pos) (by linarith [hτ.1])
      have hζ₃_Rδ : ζ₃ ∈ R_δ := by
        have hre : ζ₃.re = 1 := by simp [ζ₃]
        have him : ζ₃.im = (1 - τ) * s₀ := by simp [ζ₃]
        exact ⟨by linarith, by linarith, by linarith, by linarith⟩
      have hζ₃_ball : ζ₃ ∈ Metric.ball (1 : ℂ) r₁ := by
        rw [Metric.mem_ball, dist_eq_norm]
        have hsub : ζ₃ - 1 = (((1 - τ) * s₀ : ℝ) : ℂ) * Complex.I := by
          dsimp [ζ₃]; ring
        rw [hsub, norm_mul, Complex.norm_I, mul_one, Complex.norm_real, Real.norm_eq_abs,
          abs_of_nonneg h1τ_nonneg]
        exact lt_of_le_of_lt h1τ_le hs₀_lt_r₁
      exact ⟨hφ_maps hζ₃_Rδ, hr₁_nz hζ₃_ball⟩

  refine {
    isPreconnected_compl_zero := ?_
    exists_nonzero_finset_on_open := ?_
    detour_root_chain := ?_
  }
  · 
    intro U H hU hConv hH
    refine isPreconnected_of_forall_pair (fun p_a hp_a p_b hp_b => ?_)
    obtain ⟨p₁, p₂, hseg₁, hseg₂, hseg₃⟩ :=
      hDetour hU hConv hH hp_a.1 hp_a.2 hp_b.1 hp_b.2
    let segSet : ℂ × ℂ → ℂ × ℂ → Set (ℂ × ℂ) :=
