    have h_eq_fn : ((fun q : ℂ × ℂ × ℂ => chordActionP X q.1 q.2.1 q.2.2) ∘
        fun p : ℂ × ℂ => (p.1, ((1 : ℂ), p.2))) = fun p : ℂ × ℂ => chordPhi X p.1 p.2 := by
      funext p
      simp [Function.comp, chordActionP]
    rw [h_eq_fn] at h_at
    exact h_at.differentiableWithinAt
  let Φ₁ : ℂ × ℂ → ℂ := fun p => deriv (fun z => chordPhi X z p.2) p.1
  let Φ₂ : ℂ × ℂ → ℂ := fun p => deriv (fun z => chordPhi X p.1 z) p.2
  have hΦ_parts : DifferentiableOn ℂ Φ₁ Ω_phi ∧ DifferentiableOn ℂ Φ₂ Ω_phi :=
    partial_derivs_holo_2d Ω_phi (fun p => chordPhi X p.1 p.2) hΩ_open hPhi_holo
  have h_part_formulas : ∀ s J t : ℂ, (s, t * J) ∈ Ω_phi →
      deriv (fun s' => chordActionP X s' J t) s = J ^ 3 * Φ₁ (s, t * J) ∧
      deriv (fun J' => chordActionP X s J' t) J =
        3 * J ^ 2 * chordPhi X s (t * J) + J ^ 3 * (Φ₂ (s, t * J) * t) := by
    intro s J t h_in
    refine ⟨?_, ?_⟩
    · have hs_at : DifferentiableAt ℂ (fun s' => chordPhi X s' (t * J)) s :=
        (hPhi_holo.comp (differentiable_id.prodMk (differentiable_const (t * J))).differentiableOn
          (fun s' hs' => hs')).differentiableAt
          ((hΩ_open.preimage (continuous_id.prodMk continuous_const)).mem_nhds h_in)
      exact (hs_at.hasDerivAt.const_mul (J ^ 3)).deriv
    · have hh_at : DifferentiableAt ℂ (fun h' => chordPhi X s h') (t * J) :=
        (hPhi_holo.comp ((differentiable_const s).prodMk differentiable_id).differentiableOn
          (fun h' hh' => hh')).differentiableAt
          ((hΩ_open.preimage (continuous_const.prodMk continuous_id)).mem_nhds h_in)
      have htJ_d : HasDerivAt (fun J' : ℂ => t * J') t J :=
        hasDerivAt_congr_d ((hasDerivAt_id J).const_mul t) (by ring)
      have hJ_comp : HasDerivAt (fun J' : ℂ => chordPhi X s (t * J'))
          (Φ₂ (s, t * J) * t) J :=
        hh_at.hasDerivAt.comp J htJ_d
      have hJ3_d : HasDerivAt (fun J' : ℂ => J' ^ 3) (3 * J ^ 2) J :=
        hasDerivAt_congr_d ((hasDerivAt_id J).pow 3) (by dsimp; ring)
      exact (hJ3_d.mul hJ_comp).deriv
  let U_rec : Set (ℂ × ℂ) := horizStrip (X.s_star / 3) ×ˢ Metric.ball (0 : ℂ) r_rec
  let g_prev : ℂ × ℂ → ℂ × ℂ :=
    fun p => (X.𝔰 (p.1 - p.2, p.2), p.2 * J_prev_tilde p)
  let g_curr : ℂ × ℂ → ℂ × ℂ :=
    fun p => (X.𝔰 (p.1, p.2), p.2 * J_curr_tilde p)
  have hg_maps : ∀ p ∈ U_rec, g_prev p ∈ Ω_phi ∧ g_curr p ∈ Ω_phi := by
    intro p ⟨hp1, hp2⟩
    rw [Metric.mem_ball, dist_zero_right] at hp2
    obtain ⟨him_p, him_c, hJp_1, hJc_1, _, _⟩ := hCollar_pt p.1 p.2 hp1 hp2
    have hJp_n : ‖J_prev_tilde p‖ < 9 / 8 := by
      have := norm_le_insert' (J_prev_tilde p) 1; norm_num at this; linarith
    have hJc_n : ‖J_curr_tilde p‖ < 9 / 8 := by
      have := norm_le_insert' (J_curr_tilde p) 1; norm_num at this; linarith
    refine ⟨⟨him_p, ?_⟩, ⟨him_c, ?_⟩⟩
    · rw [Metric.mem_ball, dist_zero_right, norm_mul]
      calc ‖p.2‖ * ‖J_prev_tilde p‖ ≤ ‖p.2‖ * (9 / 8) :=
            mul_le_mul_of_nonneg_left hJp_n.le (norm_nonneg _)
        _ < r_rec * (9 / 8) := by linarith
        _ < r_t_base := by linarith
    · rw [Metric.mem_ball, dist_zero_right, norm_mul]
      calc ‖p.2‖ * ‖J_curr_tilde p‖ ≤ ‖p.2‖ * (9 / 8) :=
            mul_le_mul_of_nonneg_left hJc_n.le (norm_nonneg _)
        _ < r_rec * (9 / 8) := by linarith
        _ < r_t_base := by linarith
  have hg_prev_holo : DifferentiableOn ℂ g_prev U_rec :=
    hs_prev_holo.prodMk (differentiable_snd.differentiableOn.mul hJp_holo)
  have hg_curr_holo : DifferentiableOn ℂ g_curr U_rec :=
    hs_curr_holo.prodMk (differentiable_snd.differentiableOn.mul hJc_holo)
  let F_ext : ℂ × ℂ → ℂ := fun p =>
    (3 * (J_curr_tilde p) ^ 2 * chordPhi X (g_curr p).1 (g_curr p).2 +
      (J_curr_tilde p) ^ 3 * (Φ₂ (g_curr p) * p.2) -
      p.2 * ((J_curr_tilde p) ^ 3 * Φ₁ (g_curr p))) -
    (3 * (J_prev_tilde p) ^ 2 * chordPhi X (g_prev p).1 (g_prev p).2 +
      (J_prev_tilde p) ^ 3 * (Φ₂ (g_prev p) * p.2))
  have hF_ext_holo : DifferentiableOn ℂ F_ext U_rec := by
    have hc_phi := hPhi_holo.comp hg_curr_holo (fun p hp => (hg_maps p hp).2)
    have hc_1 := hΦ_parts.1.comp hg_curr_holo (fun p hp => (hg_maps p hp).2)
    have hc_2 := hΦ_parts.2.comp hg_curr_holo (fun p hp => (hg_maps p hp).2)
    have hp_phi := hPhi_holo.comp hg_prev_holo (fun p hp => (hg_maps p hp).1)
    have hp_2 := hΦ_parts.2.comp hg_prev_holo (fun p hp => (hg_maps p hp).1)
    have ht_d : DifferentiableOn ℂ (fun p : ℂ × ℂ => p.2) U_rec :=
      differentiable_snd.differentiableOn
    exact ((((hJc_holo.pow 2).const_mul 3).mul hc_phi).add
      ((hJc_holo.pow 3).mul (hc_2.mul ht_d)) |>.sub
      (ht_d.mul ((hJc_holo.pow 3).mul hc_1))).sub
      ((((hJp_holo.pow 2).const_mul 3).mul hp_phi).add
        ((hJp_holo.pow 3).mul (hp_2.mul ht_d)))
  have hArc_Ω : ∀ u v : ℝ, u < v → ((u : ℂ), ((v - u : ℝ) : ℂ)) ∈ Ω_phi →
      ((X.c * (v - u) ^ 3 : ℝ) : ℂ) * chordPhi X (u : ℂ) ((v - u : ℝ) : ℂ) =
        (draftRealArcMinusChord X u v : ℂ) := by
    intro u v huv ⟨hu_st, hv_ball⟩
    rw [Metric.mem_ball, dist_zero_right, Complex.norm_real, Real.norm_eq_abs,
      abs_of_pos (sub_pos.mpr huv)] at hv_ball
    obtain ⟨_, hb_u⟩ := hSub_bounds (u : ℂ) hu_st
    have hu_in_ball : (u : ℂ) ∈ Metric.ball (u : ℂ) (X.s_star / 5) :=
      Metric.mem_ball_self (by linarith [hX.s_star_pos])
    apply part2_wronskian hVolt X hX u v huv
    · intro w ⟨hw0, hw1⟩
      have hzw_in : (u : ℂ) + (w : ℂ) * ((v - u : ℝ) : ℂ) ∈
          Metric.ball (u : ℂ) (X.s_star / 5) := by
        rw [Metric.mem_ball, dist_eq_norm, add_sub_cancel_left, norm_mul,
          Complex.norm_real, Complex.norm_real, Real.norm_eq_abs, Real.norm_eq_abs,
          abs_of_nonneg hw0, abs_of_pos (sub_pos.mpr huv)]
        calc w * (v - u) ≤ 1 * r_t_base :=
              mul_le_mul hw1 hv_ball.le (sub_pos.mpr huv).le zero_le_one
          _ < X.s_star / 5 := by linarith [hX.s_star_pos]
      dsimp [stripPotential]
      rw [norm_mul, norm_pow, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (sub_pos.mpr huv)]
      calc (v - u) ^ 2 * ‖X.q ((u : ℂ) + (w : ℂ) * ((v - u : ℝ) : ℂ))‖
          ≤ r_t_base ^ 2 * ‖X.q ((u : ℂ) + (w : ℂ) * ((v - u : ℝ) : ℂ))‖ :=
            mul_le_mul_of_nonneg_right (pow_le_pow_left₀ (sub_pos.mpr huv).le hv_ball.le 2)
              (norm_nonneg _)
        _ ≤ 1 / 64 := (hb_u _ hzw_in).2.2.1
    · rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (sub_pos.mpr huv)]
      calc (v - u) * ‖X.f (u : ℂ)‖ ≤ r_t_base * ‖X.f (u : ℂ)‖ :=
            mul_le_mul_of_nonneg_right hv_ball.le (norm_nonneg _)
        _ ≤ 1 / 256 := (hb_u _ hu_in_ball).2.2.2.1
    · rw [norm_mul, norm_pow, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (sub_pos.mpr huv)]
      calc (v - u) ^ 2 * ‖deriv X.f (u : ℂ)‖ ≤ r_t_base ^ 2 * ‖deriv X.f (u : ℂ)‖ :=
            mul_le_mul_of_nonneg_right (pow_le_pow_left₀ (sub_pos.mpr huv).le hv_ball.le 2)
              (norm_nonneg _)
        _ ≤ 1 / 256 := (hb_u _ hu_in_ball).2.2.2.2
  have hF_real_zero : ∀ x t : ℝ, 0 < t → t < r_rec → F_ext ((x : ℂ), (t : ℂ)) = 0 := by
    intro x t ht_pos ht_lt
    have hx_im : |(x : ℂ).im| < X.s_star / 3 := by simp [hX.s_star_pos]
    have ht_norm : ‖(t : ℂ)‖ < r_rec := by
      rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos ht_pos]; exact ht_lt
    have hp_mem : ((x : ℂ), (t : ℂ)) ∈ U_rec := ⟨hx_im, by simpa [Metric.mem_ball] using ht_norm⟩
    obtain ⟨_, _, _, _, hJp_mul, hJc_mul⟩ := hCollar_pt (x : ℂ) (t : ℂ) hx_im ht_norm
    obtain ⟨hgp_in, hgc_in⟩ := hg_maps ((x : ℂ), (t : ℂ)) hp_mem
    have ht_ne : (t : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr ht_pos.ne'
    have hJp_eq : J_prev_tilde ((x : ℂ), (t : ℂ)) =
        (X.𝔰 ((x : ℂ), (t : ℂ)) - X.𝔰 ((x : ℂ) - (t : ℂ), (t : ℂ))) / (t : ℂ) :=
      eq_div_of_mul_eq ht_ne (by rw [mul_comm]; exact hJp_mul)
    have hJc_eq : J_curr_tilde ((x : ℂ), (t : ℂ)) =
        (X.𝔰 ((x : ℂ) + (t : ℂ), (t : ℂ)) - X.𝔰 ((x : ℂ), (t : ℂ))) / (t : ℂ) :=
      eq_div_of_mul_eq ht_ne (by rw [mul_comm]; exact hJc_mul)
    have h_var := part4_real_variation X hX Ω_phi hΩ_open hPhi_holo hArc_Ω
      x t ht_pos (lt_trans ht_lt hr_rec_lt)
      (by dsimp [g_prev] at hgp_in; rwa [hJp_mul] at hgp_in)
      (by dsimp [g_curr] at hgc_in; rwa [hJc_mul] at hgc_in)
    dsimp only at h_var
    dsimp [F_ext, g_prev, g_curr]
    rw [hJp_eq, hJc_eq]
    exact sub_eq_zero.mpr h_var
  have h_strip_conv : Convex ℝ (horizStrip (X.s_star / 3)) := by
    intro z₁ hz₁ z₂ hz₂ a b ha hb hab
    change |(a • z₁ + b • z₂).im| < X.s_star / 3
    change |z₁.im| < X.s_star / 3 at hz₁
    change |z₂.im| < X.s_star / 3 at hz₂
    have him : (a • z₁ + b • z₂).im = a * z₁.im + b * z₂.im := by simp
    rw [him]
    calc |a * z₁.im + b * z₂.im| ≤ |a * z₁.im| + |b * z₂.im| := abs_add_le _ _
      _ = a * |z₁.im| + b * |z₂.im| := by
          rw [abs_mul, abs_mul, abs_of_nonneg ha, abs_of_nonneg hb]
      _ < a * (X.s_star / 3) + b * (X.s_star / 3) := by
          rcases eq_or_lt_of_le ha with rfl | ha_pos
          · simp only [zero_add] at hab; subst hab; linarith
          · nlinarith
      _ = (a + b) * (X.s_star / 3) := by ring
      _ = X.s_star / 3 := by rw [hab, one_mul]
  have hF_step1 : ∀ y ∈ horizStrip (X.s_star / 3), ∀ t : ℝ, 0 < t → t < r_rec →
      F_ext (y, (t : ℂ)) = 0 := by
    intro y hy t ht0 ht1
    have ht_ball : (t : ℂ) ∈ Metric.ball (0 : ℂ) r_rec := by
      rw [Metric.mem_ball, dist_zero_right, Complex.norm_real, Real.norm_eq_abs, abs_of_pos ht0]
      exact ht1
    have h1d_holo : DifferentiableOn ℂ (fun z => F_ext (z, (t : ℂ)))
        (horizStrip (X.s_star / 3)) :=
      hF_ext_holo.comp (differentiable_id.prodMk (differentiable_const (t : ℂ))).differentiableOn
        (fun z hz => ⟨hz, ht_ball⟩)
    have h1d_ana : AnalyticOnNhd ℂ (fun z => F_ext (z, (t : ℂ))) (horizStrip (X.s_star / 3)) :=
      (Complex.analyticOnNhd_iff_differentiableOn (h_open_strip (X.s_star / 3))).mpr h1d_holo
    have h0_mem : (0 : ℂ) ∈ horizStrip (X.s_star / 3) := by
      simp [horizStrip, hX.s_star_pos]
    have h_freq : ∃ᶠ z in nhdsWithin (0 : ℂ) {(0 : ℂ)}ᶜ, F_ext (z, (t : ℂ)) = 0 := by
      rw [Filter.frequently_iff]
      intro V hV
      rw [Metric.mem_nhdsWithin_iff] at hV
      obtain ⟨ε, hε_pos, hε_sub⟩ := hV
      let x_w : ℝ := ε / 2
      have hx_pos : 0 < x_w := by positivity
      refine ⟨(x_w : ℂ), hε_sub ⟨?_, ?_⟩, hF_real_zero x_w t ht0 ht1⟩
      · rw [Metric.mem_ball, dist_zero_right, Complex.norm_real, Real.norm_eq_abs,
          abs_of_pos hx_pos]
        dsimp [x_w]; linarith
      · exact Complex.ofReal_ne_zero.mpr hx_pos.ne'
    exact h1d_ana.eqOn_zero_of_preconnected_of_frequently_eq_zero
      h_strip_conv.isPreconnected h0_mem h_freq hy
  have hF_all_zero : ∀ p ∈ U_rec, F_ext p = 0 := by
    intro p ⟨hp1, hp2⟩
    have h2d_holo : DifferentiableOn ℂ (fun τ => F_ext (p.1, τ)) (Metric.ball (0 : ℂ) r_rec) :=
      hF_ext_holo.comp ((differentiable_const p.1).prodMk differentiable_id).differentiableOn
        (fun τ hτ => ⟨hp1, hτ⟩)
    have h2d_ana : AnalyticOnNhd ℂ (fun τ => F_ext (p.1, τ)) (Metric.ball (0 : ℂ) r_rec) :=
      (Complex.analyticOnNhd_iff_differentiableOn Metric.isOpen_ball).mpr h2d_holo
    have h0_ball : (0 : ℂ) ∈ Metric.ball (0 : ℂ) r_rec := Metric.mem_ball_self hr_rec_pos
    have h_freq : ∃ᶠ τ in nhdsWithin (0 : ℂ) {(0 : ℂ)}ᶜ, F_ext (p.1, τ) = 0 := by
      rw [Filter.frequently_iff]
      intro V hV
      rw [Metric.mem_nhdsWithin_iff] at hV
      obtain ⟨ε, hε_pos, hε_sub⟩ := hV
      let t_w : ℝ := min (ε / 2) (r_rec / 2)
      have ht_pos : 0 < t_w := lt_min (by positivity) (by positivity)
      have ht_lt_r : t_w < r_rec :=
        lt_of_le_of_lt (min_le_right _ _) (by linarith)
      have ht_lt_ε : t_w < ε :=
        lt_of_le_of_lt (min_le_left _ _) (by linarith)
      refine ⟨(t_w : ℂ), hε_sub ⟨?_, ?_⟩, hF_step1 p.1 hp1 t_w ht_pos ht_lt_r⟩
      · rw [Metric.mem_ball, dist_zero_right, Complex.norm_real, Real.norm_eq_abs,
          abs_of_pos ht_pos]
        exact ht_lt_ε
      · exact Complex.ofReal_ne_zero.mpr ht_pos.ne'
    exact h2d_ana.eqOn_zero_of_preconnected_of_frequently_eq_zero
      (convex_ball (0 : ℂ) r_rec).isPreconnected h0_ball h_freq hp2
  refine ⟨r_rec, hr_rec_pos, hr_rec_lt, ?_⟩
  intro y t hy ht_pos ht_lt
  have ht_ne : t ≠ 0 := norm_pos_iff.mp ht_pos
  have hp_mem : (y, t) ∈ U_rec := ⟨hy, by simpa [Metric.mem_ball] using ht_lt⟩
  obtain ⟨_, _, _, _, hJp_mul, hJc_mul⟩ := hCollar_pt y t hy ht_lt
  obtain ⟨hgp_in, hgc_in⟩ := hg_maps (y, t) hp_mem
  set s_prev : ℂ := X.𝔰 (y - t, t)
  set s_curr : ℂ := X.𝔰 (y, t)
  set s_next : ℂ := X.𝔰 (y + t, t)
  set J_prev : ℂ := (s_curr - s_prev) / t
  set J_curr : ℂ := (s_next - s_curr) / t
  have hJp_eq : J_prev_tilde (y, t) = J_prev :=
    eq_div_of_mul_eq ht_ne (by rw [mul_comm]; exact hJp_mul)
  have hJc_eq : J_curr_tilde (y, t) = J_curr :=
    eq_div_of_mul_eq ht_ne (by rw [mul_comm]; exact hJc_mul)
  have hgp_mem : (s_prev, t * J_prev) ∈ Ω_phi := by
    dsimp [g_prev] at hgp_in; rwa [hJp_eq] at hgp_in
  have hgc_mem : (s_curr, t * J_curr) ∈ Ω_phi := by
    dsimp [g_curr] at hgc_in; rwa [hJc_eq] at hgc_in
  obtain ⟨hds_curr, hdJ_curr⟩ := h_part_formulas s_curr J_curr t hgc_mem
  obtain ⟨_, hdJ_prev⟩ := h_part_formulas s_prev J_prev t hgp_mem
  have hF0 := hF_all_zero (y, t) hp_mem
  dsimp [F_ext, g_prev, g_curr] at hF0
  rw [hJp_eq, hJc_eq] at hF0
  change deriv (fun J' => chordActionP X s_curr J' t) J_curr -
    t * deriv (fun s' => chordActionP X s' J_curr t) s_curr =
    deriv (fun J' => chordActionP X s_prev J' t) J_prev
  rw [hdJ_curr, hds_curr, hdJ_prev]
  exact sub_eq_zero.mp hF0

theorem frozen_action_regular_convergence (hVolt : VolterraDivisionProp) (X : ExpStripData) (hX : IsExpObstructionStrip X)
    (kind : ExpProfileKind) (seq : ExpSequenceData X kind) (S₀ J₀ T₀ : ℂ)
    (hReg : IsRegularFrozenState kind (T₀ * seq.c₀ * Complex.exp (-Complex.I * S₀)) J₀) :
    ∃ (δ_reg : ℝ) (N_reg : ℕ), 0 < δ_reg ∧
      (∀ n ≥ N_reg,
        DifferentiableOn ℂ
          (fun q : ℂ × ℂ × ℂ =>
            chordActionP X
              ((seq.x_seq n : ℂ) + (seq.h_seq n : ℂ) * Complex.I +
                (seq.ℓ_seq n : ℂ) * q.1)
              q.2.1
              (q.2.2 / (seq.m_seq n : ℂ)))
          { q : ℂ × ℂ × ℂ |
            ‖q.1 - S₀‖ < δ_reg ∧ ‖q.2.1 - J₀‖ < δ_reg ∧ ‖q.2.2 - T₀‖ < δ_reg }) ∧
      TendstoUniformlyOn
        (fun (n : ℕ) (q : ℂ × ℂ × ℂ) =>
          chordActionP X
            ((seq.x_seq n : ℂ) + (seq.h_seq n : ℂ) * Complex.I +
              (seq.ℓ_seq n : ℂ) * q.1)
            q.2.1
            (q.2.2 / (seq.m_seq n : ℂ)))
        (fun q : ℂ × ℂ × ℂ =>
          frozenActionP kind (q.2.2 * seq.c₀ * Complex.exp (-Complex.I * q.1)) q.2.1)
        Filter.atTop
        { q : ℂ × ℂ × ℂ |
          ‖q.1 - S₀‖ < δ_reg ∧ ‖q.2.1 - J₀‖ < δ_reg ∧ ‖q.2.2 - T₀‖ < δ_reg } :=
by
  
  
  
  have hDeep1 : ∀ Λ : ℂ, deepPurePhiSqFirst (Λ ^ 2) = frozenPhiFirst Λ := by
    intro Λ
    unfold deepPurePhiSqFirst frozenPhiFirst
    split_ifs with hΛ
    · rw [hΛ, zero_pow two_ne_zero]
      have htsum : (∑' m : ℕ, (-(0 : ℂ) / 4) ^ m / ((2 * m + 3).factorial : ℂ)) = 1 / 6 := by
        rw [tsum_eq_single 0]
        · simp [Nat.factorial]
        · intro m hm; simp [zero_pow hm]
      rw [htsum]; norm_num
    · let z : ℂ := Λ / 2
      have hz : z ≠ 0 := div_ne_zero hΛ two_ne_zero
      have hsin := (hasSum_nat_add_iff' 1).mpr (Complex.hasSum_sin z)
      have h0 : (∑ i ∈ Finset.range 1,
          (-1 : ℂ) ^ i * z ^ (2 * i + 1) / ((2 * i + 1).factorial : ℂ)) = z := by
        simp
      rw [h0] at hsin
      have hmul := hsin.mul_left (-(1 / (z ^ 3)))
      have h_eq : (fun m : ℕ => -(1 / z ^ 3) *
          ((-1 : ℂ) ^ (m + 1) * z ^ (2 * (m + 1) + 1) / ((2 * (m + 1) + 1).factorial : ℂ))) =
          (fun m : ℕ => (-(Λ ^ 2) / 4) ^ m / ((2 * m + 3).factorial : ℂ)) := by
        ext m
        have hm1 : 2 * (m + 1) + 1 = 3 + 2 * m := by omega
        have hm2 : 2 * m + 3 = 3 + 2 * m := by omega
        rw [hm1, hm2, pow_add (-1 : ℂ) m 1, pow_add z 3 (2 * m), pow_mul z 2 m]
        have hz2 : z ^ 2 = Λ ^ 2 / 4 := by dsimp [z]; ring
        have hneg : (-(Λ ^ 2) / 4) ^ m = (-1 : ℂ) ^ m * (Λ ^ 2 / 4) ^ m := by
          have : -(Λ ^ 2) / 4 = (-1 : ℂ) * (Λ ^ 2 / 4) := by ring
          rw [this, mul_pow]
        rw [hz2, hneg]
        have hz3 : z ^ 3 ≠ 0 := pow_ne_zero 3 hz
        have hf : ((3 + 2 * m).factorial : ℂ) ≠ 0 :=
          Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)
        field_simp [hz3, hf]
      rw [h_eq] at hmul
      rw [hmul.tsum_eq]
      dsimp [z]
      field_simp [hΛ]
      ring

  let frozenPhi : ExpProfileKind → ℂ → ℂ := fun k Λ =>
    match k with
    | .firstField => frozenPhiFirst Λ
    | .secondField =>
        (∑' m : ℕ, ((2 * m + 2 : ℕ) : ℂ) * Λ ^ (2 * m) /
          (8 * (4 : ℂ) ^ m * ((2 * m + 3).factorial : ℂ))) /
          Complex.cosh (Λ / 2)

  have h_factor : ∀ (k : ExpProfileKind) (lam J : ℂ),
      frozenActionP k lam J = J ^ 3 * frozenPhi k (lam * J) := by
    intro k lam J
    cases k with
    | firstField =>
      dsimp [frozenActionP, frozenPhi]
      rw [← hDeep1 (lam * J)]
      dsimp [deepPurePhiSqFirst]
      rw [← mul_assoc, ← tsum_mul_left]
      congr 1
      ext m
      have hJ : J ^ (2 * m + 3) = J ^ 3 * (J ^ 2) ^ m := by
        rw [pow_add, pow_mul, mul_comm]
      have hlam : lam ^ (2 * m) = (lam ^ 2) ^ m := pow_mul lam 2 m
      have h2 : (2 : ℂ) ^ (2 * m + 2) = 4 * (4 : ℂ) ^ m := by
        rw [pow_add, pow_mul]
        norm_num
        ring
      have hneg : (-((lam * J) ^ 2) / 4) ^ m =
          (-1 : ℂ) ^ m * (lam ^ 2) ^ m * (J ^ 2) ^ m / (4 : ℂ) ^ m := by
        have : -((lam * J) ^ 2) / 4 = ((-1 : ℂ) * lam ^ 2 * J ^ 2) / 4 := by ring
        rw [this, div_pow, mul_pow, mul_pow]
      rw [hJ, hlam, h2, hneg]
      ring
    | secondField =>
      dsimp [frozenActionP, frozenPhi]
      rw [← mul_div_assoc, ← tsum_mul_left]
      congr 2
      ext m
      have hJ : J ^ (2 * m + 3) = J ^ 3 * J ^ (2 * m) := by
        rw [pow_add, mul_comm]
      have hmul : (lam * J) ^ (2 * m) = lam ^ (2 * m) * J ^ (2 * m) := mul_pow lam J (2 * m)
      rw [hJ, hmul]
      ring

  have h_phi_zero : ∀ k : ExpProfileKind, frozenPhi k 0 = (1 / 24 : ℂ) := by
    intro k
    cases k with
    | firstField =>
      simp [frozenPhi, frozenPhiFirst]
    | secondField =>
      dsimp [frozenPhi]
      have hsum : (∑' m : ℕ, ((2 * m + 2 : ℕ) : ℂ) * (0 : ℂ) ^ (2 * m) /
          (8 * (4 : ℂ) ^ m * ((2 * m + 3).factorial : ℂ))) = (1 / 24 : ℂ) := by
        rw [tsum_eq_single 0]
        · simp [Nat.factorial]
          norm_num
        · intro m hm
          have hpow : (0 : ℂ) ^ (2 * m) = 0 := zero_pow (by omega)
          simp [hpow]
      rw [hsum]
      simp

  have h_phi_first : ∀ Λ : ℂ, Λ ≠ 0 →
      frozenPhi .firstField Λ = (1 - 2 * Complex.sin (Λ / 2) / Λ) / Λ ^ 2 := by
    intro Λ hΛ
    dsimp [frozenPhi, frozenPhiFirst]
    rw [ite_eq_right_iff.mpr fun h => False.elim (hΛ h)]
    field_simp [hΛ]
    ring

  have h_phi_second : ∀ Λ : ℂ, Λ ≠ 0 → Complex.cosh (Λ / 2) ≠ 0 →
      frozenPhi .secondField Λ =
        1 / (2 * Λ ^ 2) - Complex.sinh (Λ / 2) / (Λ ^ 3 * Complex.cosh (Λ / 2)) := by
    intro Λ hΛ hcosh
    let z : ℂ := Λ / 2
    have hs1 := (Complex.hasSum_cosh z).mul_left z
    have hs2 := Complex.hasSum_sinh z
    have hs_diff := hs1.sub hs2
    have h_term : (fun n : ℕ => z * (z ^ (2 * n) / ((2 * n).factorial : ℂ)) -
        z ^ (2 * n + 1) / ((2 * n + 1).factorial : ℂ)) =
        (fun n : ℕ => ((2 * n : ℕ) : ℂ) * z ^ (2 * n + 1) / ((2 * n + 1).factorial : ℂ)) := by
      ext n
      have hfac : ((2 * n + 1).factorial : ℂ) =
          ((2 * n + 1 : ℕ) : ℂ) * ((2 * n).factorial : ℂ) := by
        rw [Nat.factorial_succ]
        push_cast
        rfl
      have hne1 : ((2 * n).factorial : ℂ) ≠ 0 :=
        Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)
      have hne2 : ((2 * n + 1 : ℕ) : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
      rw [hfac]
      field_simp [hne1, hne2]
      push_cast
      ring
    rw [h_term] at hs_diff
    have hs_shift : HasSum
        (fun m : ℕ => ((2 * (m + 1) : ℕ) : ℂ) * z ^ (2 * (m + 1) + 1) /
          ((2 * (m + 1) + 1).factorial : ℂ))
        (z * Complex.cosh z - Complex.sinh z) := by
      have h0 : (∑ i ∈ Finset.range 1,
          ((2 * i : ℕ) : ℂ) * z ^ (2 * i + 1) / ((2 * i + 1).factorial : ℂ)) = 0 := by
        simp
      have hs' := (hasSum_nat_add_iff' 1).mpr hs_diff
      rwa [h0, sub_zero] at hs'
    have hs_scaled := hs_shift.mul_left ((Λ ^ 3)⁻¹)
    have h_scaled_eq : (fun m : ℕ => (Λ ^ 3)⁻¹ *
        (((2 * (m + 1) : ℕ) : ℂ) * z ^ (2 * (m + 1) + 1) /
          ((2 * (m + 1) + 1).factorial : ℂ))) =
        (fun m : ℕ => ((2 * m + 2 : ℕ) : ℂ) * Λ ^ (2 * m) /
          (8 * (4 : ℂ) ^ m * ((2 * m + 3).factorial : ℂ))) := by
      ext m
      have hm1 : 2 * (m + 1) = 2 * m + 2 := by omega
      have hm2 : 2 * m + 2 + 1 = 2 * m + 3 := by omega
      rw [hm1, hm2]
      have hzpow : z ^ (2 * m + 3) = Λ ^ 3 * Λ ^ (2 * m) / (8 * (4 : ℂ) ^ m) := by
        dsimp [z]
        have hexp : 2 * m + 3 = 3 + 2 * m := by omega
        have hsq : (Λ / 2) ^ 2 = Λ ^ 2 / 4 := by ring
        rw [hexp, pow_add, pow_mul, hsq, div_pow, div_pow, ← pow_mul]
        ring
      rw [hzpow]
      have h4ne : (4 : ℂ) ^ m ≠ 0 := pow_ne_zero m (by norm_num)
      have hfne : ((2 * m + 3).factorial : ℂ) ≠ 0 :=
        Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)
      field_simp [hΛ, h4ne, hfne]
    rw [h_scaled_eq] at hs_scaled
    dsimp [frozenPhi]
    rw [hs_scaled.tsum_eq]
    dsimp only [z]
    set c_val : ℂ := Complex.cosh (Λ / 2)
    set s_val : ℂ := Complex.sinh (Λ / 2)
    have hc_ne : c_val ≠ 0 := hcosh
    field_simp [hΛ, hc_ne]

  have h_reg_first : ∀ lam J : ℂ, IsRegularFrozenState .firstField lam J →
      J ≠ 0 ∧ (lam ≠ 0 → Complex.sin (lam * J / 2) ≠ 0) := by
    intro lam J ⟨hJ, hdd⟩
    refine ⟨hJ, fun hlam => ?_⟩
    have hact_eq : ∀ w : ℂ,
        frozenActionP .firstField lam w =
          w / lam ^ 2 - 2 * Complex.sin (lam * w / 2) / lam ^ 3 := by
      intro w
      by_cases hw : w = 0
      · subst hw
        dsimp [frozenActionP]
        have h0 : (∑' m : ℕ, (-1 : ℂ) ^ m * (0 : ℂ) ^ (2 * m + 3) * lam ^ (2 * m) /
            ((2 : ℂ) ^ (2 * m + 2) * ((2 * m + 3).factorial : ℂ))) = 0 := by
          simp [zero_pow (by omega : 2 * _ + 3 ≠ 0)]
        rw [h0]; simp
      · rw [h_factor .firstField lam w, h_phi_first (lam * w) (mul_ne_zero hlam hw)]
        field_simp [hlam, hw]
    have h_lin_fn : ∀ w : ℂ, HasDerivAt (fun x : ℂ => lam * x / 2) (lam / 2) w := by
      intro w
      convert ((hasDerivAt_id w).const_mul lam).div_const 2 using 1
      · rfl
      · ring
    have hd1 : ∀ w : ℂ,
        HasDerivAt (frozenActionP .firstField lam)
          (1 / lam ^ 2 - Complex.cos (lam * w / 2) / lam ^ 2) w := by
      intro w
      have h_sin : HasDerivAt (fun x : ℂ => Complex.sin (lam * x / 2))
          (Complex.cos (lam * w / 2) * (lam / 2)) w := by
        convert HasDerivAt.comp w (Complex.hasDerivAt_sin (lam * w / 2)) (h_lin_fn w) using 1; rfl
      have h_rhs : HasDerivAt
          (fun x : ℂ => x / lam ^ 2 - 2 * Complex.sin (lam * x / 2) / lam ^ 3)
          (1 / lam ^ 2 - Complex.cos (lam * w / 2) / lam ^ 2) w := by
        convert ((hasDerivAt_id w).div_const (lam ^ 2)).sub
          ((h_sin.const_mul 2).div_const (lam ^ 3)) using 1
        · rfl
        · field_simp [hlam]
      exact h_rhs.congr_of_eventuallyEq (Filter.Eventually.of_forall hact_eq)
    have hd1_eq : deriv (frozenActionP .firstField lam) =
        fun w : ℂ => 1 / lam ^ 2 - Complex.cos (lam * w / 2) / lam ^ 2 := by
      ext w; exact (hd1 w).deriv
    have hd2 : HasDerivAt (deriv (frozenActionP .firstField lam))
        (Complex.sin (lam * J / 2) / (2 * lam)) J := by
      rw [hd1_eq]
      have h_cos : HasDerivAt (fun x : ℂ => Complex.cos (lam * x / 2))
          (-Complex.sin (lam * J / 2) * (lam / 2)) J := by
        convert HasDerivAt.comp J (Complex.hasDerivAt_cos (lam * J / 2)) (h_lin_fn J) using 1; rfl
      convert (hasDerivAt_const J (1 / lam ^ 2)).sub (h_cos.div_const (lam ^ 2)) using 1
      field_simp [hlam]; ring
    rw [hd2.deriv] at hdd
    intro hsin0
    rw [hsin0, zero_div] at hdd
    exact hdd rfl

  have h_reg_second : ∀ lam J : ℂ, IsRegularFrozenState .secondField lam J →
      J ≠ 0 ∧ Complex.cosh (lam * J / 2) ≠ 0 ∧
        (lam ≠ 0 → Complex.sinh (lam * J / 2) ≠ 0) := by
    intro lam J ⟨hJ, hcosh, hdd⟩
    refine ⟨hJ, hcosh, fun hlam => ?_⟩
    let V : Set ℂ := { w : ℂ | Complex.cosh (lam * w / 2) ≠ 0 }
    have hV_open : IsOpen V := isOpen_ne.preimage (by fun_prop)
    have hJ_mem : J ∈ V := hcosh
    let g : ℂ → ℂ := fun w =>
      w / (2 * lam ^ 2) - Complex.sinh (lam * w / 2) / (lam ^ 3 * Complex.cosh (lam * w / 2))
    have hact_eq : ∀ w ∈ V, frozenActionP .secondField lam w = g w := by
      intro w hw
      by_cases hw0 : w = 0
      · subst hw0
        dsimp [frozenActionP, g]
        have h0 : (∑' m : ℕ, ((2 * m + 2 : ℕ) : ℂ) * (0 : ℂ) ^ (2 * m + 3) * lam ^ (2 * m) /
            (8 * (4 : ℂ) ^ m * ((2 * m + 3).factorial : ℂ))) = 0 := by
          simp [zero_pow (by omega : 2 * _ + 3 ≠ 0)]
        rw [h0]; simp
      · rw [h_factor .secondField lam w, h_phi_second (lam * w) (mul_ne_zero hlam hw0) hw]
        dsimp [g]
        have hc : Complex.cosh (lam * w / 2) ≠ 0 := hw
        field_simp [hlam, hw0, hc]
    have h_lin_fn : ∀ w : ℂ, HasDerivAt (fun x : ℂ => lam * x / 2) (lam / 2) w := by
      intro w
      convert ((hasDerivAt_id w).const_mul lam).div_const 2 using 1
      · rfl
      · ring
    have hd1 : ∀ w ∈ V,
        deriv (frozenActionP .secondField lam) w =
          1 / (2 * lam ^ 2) - 1 / (2 * lam ^ 2 * Complex.cosh (lam * w / 2) ^ 2) := by
      intro w hw
      have h_sh : HasDerivAt (fun x : ℂ => Complex.sinh (lam * x / 2))
          (Complex.cosh (lam * w / 2) * (lam / 2)) w := by
        convert HasDerivAt.comp w (Complex.hasDerivAt_sinh (lam * w / 2)) (h_lin_fn w) using 1; rfl
      have h_ch : HasDerivAt (fun x : ℂ => Complex.cosh (lam * x / 2))
          (Complex.sinh (lam * w / 2) * (lam / 2)) w := by
        convert HasDerivAt.comp w (Complex.hasDerivAt_cosh (lam * w / 2)) (h_lin_fn w) using 1; rfl
      have hc_ne : Complex.cosh (lam * w / 2) ≠ 0 := hw
      have hden_ne : lam ^ 3 * Complex.cosh (lam * w / 2) ≠ 0 :=
        mul_ne_zero (pow_ne_zero 3 hlam) hc_ne
      have h_quot := h_sh.div (h_ch.const_mul (lam ^ 3)) hden_ne
      have h_g : HasDerivAt g
          (1 / (2 * lam ^ 2) - 1 / (2 * lam ^ 2 * Complex.cosh (lam * w / 2) ^ 2)) w := by
        convert ((hasDerivAt_id w).div_const (2 * lam ^ 2)).sub h_quot using 1
        · rfl
        · have hid := Complex.cosh_sq_sub_sinh_sq (lam * w / 2)
          have hsh2 : Complex.sinh (lam * w / 2) ^ 2 =
              Complex.cosh (lam * w / 2) ^ 2 - 1 := by
            calc Complex.sinh (lam * w / 2) ^ 2
                = Complex.cosh (lam * w / 2) ^ 2 -
                    (Complex.cosh (lam * w / 2) ^ 2 - Complex.sinh (lam * w / 2) ^ 2) := by ring
              _ = Complex.cosh (lam * w / 2) ^ 2 - 1 := by rw [hid]
          field_simp [hlam, hc_ne]
          rw [hsh2]
          ring
      have hev : frozenActionP .secondField lam =ᶠ[nhds w] g :=
        Filter.eventuallyEq_iff_exists_mem.mpr ⟨V, hV_open.mem_nhds hw, hact_eq⟩
      exact (h_g.congr_of_eventuallyEq hev).deriv
    have hd2 : HasDerivAt (deriv (frozenActionP .secondField lam))
        (Complex.sinh (lam * J / 2) / (2 * lam * Complex.cosh (lam * J / 2) ^ 3)) J := by
      let g' : ℂ → ℂ := fun w =>
        1 / (2 * lam ^ 2) - 1 / (2 * lam ^ 2 * Complex.cosh (lam * w / 2) ^ 2)
      have h_ch : HasDerivAt (fun x : ℂ => Complex.cosh (lam * x / 2))
          (Complex.sinh (lam * J / 2) * (lam / 2)) J := by
        convert HasDerivAt.comp J (Complex.hasDerivAt_cosh (lam * J / 2)) (h_lin_fn J) using 1; rfl
      have h_den : HasDerivAt (fun x : ℂ => 2 * lam ^ 2 * Complex.cosh (lam * x / 2) ^ 2)
          (2 * lam ^ 2 * (2 * Complex.cosh (lam * J / 2) ^ 1 *
            (Complex.sinh (lam * J / 2) * (lam / 2)))) J :=
        (h_ch.pow 2).const_mul (2 * lam ^ 2)
      have hc_ne : Complex.cosh (lam * J / 2) ≠ 0 := hcosh
      have hden_ne : 2 * lam ^ 2 * Complex.cosh (lam * J / 2) ^ 2 ≠ 0 :=
        mul_ne_zero (mul_ne_zero two_ne_zero (pow_ne_zero 2 hlam)) (pow_ne_zero 2 hc_ne)
      have h_g' : HasDerivAt g'
          (Complex.sinh (lam * J / 2) / (2 * lam * Complex.cosh (lam * J / 2) ^ 3)) J := by
        convert (hasDerivAt_const J (1 / (2 * lam ^ 2))).sub
          ((hasDerivAt_const J (1 : ℂ)).div h_den hden_ne) using 1
        field_simp [hlam, hc_ne]; ring
      have hev : deriv (frozenActionP .secondField lam) =ᶠ[nhds J] g' :=
        Filter.eventuallyEq_iff_exists_mem.mpr ⟨V, hV_open.mem_nhds hJ_mem, hd1⟩
      exact h_g'.congr_of_eventuallyEq hev
    rw [hd2.deriv] at hdd
    intro hsinh0
    rw [hsinh0, zero_div] at hdd
    exact hdd rfl

  
  
  
  have h_deriv_exp : ∀ (c d : ℂ) (w : ℝ),
      HasDerivAt (fun x : ℝ => Complex.exp (c * (x : ℂ) + d))
        (c * Complex.exp (c * (w : ℂ) + d)) w := by
    intro c d w
    have h1 : HasDerivAt (fun z : ℂ => c * z + d) (c * 1 + 0) (w : ℂ) :=
      ((hasDerivAt_id (w : ℂ)).const_mul c).add (hasDerivAt_const (w : ℂ) d)
    have h2 : HasDerivAt (fun z : ℂ => Complex.exp (c * z + d))
        (c * Complex.exp (c * (w : ℂ) + d)) (w : ℂ) := by
      convert (Complex.hasDerivAt_exp (c * (w : ℂ) + d)).comp (w : ℂ) h1 using 1
      · rfl
      · ring
    exact h2.comp_ofReal

  have h_deriv_cosh : ∀ (ν : ℂ) (w : ℝ),
      HasDerivAt (fun x : ℝ => Complex.cosh (ν * (x : ℂ)))
        (ν * Complex.sinh (ν * (w : ℂ))) w := by
    intro ν w
    have h1 : HasDerivAt (fun z : ℂ => ν * z) (ν * 1) (w : ℂ) :=
      (hasDerivAt_id (w : ℂ)).const_mul ν
    have h2 : HasDerivAt (fun z : ℂ => Complex.cosh (ν * z))
        (ν * Complex.sinh (ν * (w : ℂ))) (w : ℂ) := by
      convert (Complex.hasDerivAt_cosh (ν * (w : ℂ))).comp (w : ℂ) h1 using 1
      · rfl
      · ring
    exact h2.comp_ofReal

  have h_deriv_sinh : ∀ (ν : ℂ) (w : ℝ),
      HasDerivAt (fun x : ℝ => Complex.sinh (ν * (x : ℂ)))
        (ν * Complex.cosh (ν * (w : ℂ))) w := by
    intro ν w
    have h1 : HasDerivAt (fun z : ℂ => ν * z) (ν * 1) (w : ℂ) :=
      (hasDerivAt_id (w : ℂ)).const_mul ν
    have h2 : HasDerivAt (fun z : ℂ => Complex.sinh (ν * z))
        (ν * Complex.cosh (ν * (w : ℂ))) (w : ℂ) := by
      convert (Complex.hasDerivAt_sinh (ν * (w : ℂ))).comp (w : ℂ) h1 using 1
      · rfl
      · ring
    exact h2.comp_ofReal

  have h_kern_zero : ∀ w ∈ Set.Icc (0 : ℝ) 1,
      c0Kernel (fun _ => 0) w = 1 ∧ c0Deriv (fun _ => 0) w = 0 ∧
      k0Kernel (fun _ => 0) w = (w : ℂ) ∧ k0Deriv (fun _ => 0) w = 1 := by
    obtain ⟨_, _, _, _, _, _, _, _, _, hIVP, _⟩ :=
      hVolt.1 (fun _ => 0) continuousOn_const
    have hc := hIVP (fun _ => 1) (fun _ => 0) continuousOn_const continuousOn_const
      (fun w _ => ⟨hasDerivWithinAt_const w _ 1, by simpa using hasDerivWithinAt_const w _ (0 : ℂ)⟩)
    have hk := hIVP (fun x : ℝ => (x : ℂ)) (fun _ => 1)
      Complex.continuous_ofReal.continuousOn continuousOn_const
      (fun w _ => ⟨((hasDerivAt_id (w : ℂ)).comp_ofReal).hasDerivWithinAt,
        by simpa using hasDerivWithinAt_const w _ (1 : ℂ)⟩)
    intro w hw
    obtain ⟨hc1, hc2⟩ := hc w hw
    obtain ⟨hk1, hk2⟩ := hk w hw
    simp only [one_mul, zero_mul, add_zero, Complex.ofReal_zero, zero_add] at hc1 hc2 hk1 hk2
    exact ⟨hc1.symm, hc2.symm, hk1.symm, hk2.symm⟩

  have h_kern_const_sq : ∀ (Q : ℝ → ℂ) (ν : ℂ), ν ≠ 0 →
      ContinuousOn Q (Set.Icc (0 : ℝ) 1) →
      (∀ w ∈ Set.Icc (0 : ℝ) 1, Q w = ν ^ 2) →
      c0Kernel Q 1 = Complex.cosh ν ∧ k0Kernel Q 1 = Complex.sinh ν / ν := by
    intro Q ν hν hQ_cont hQ_eq
    obtain ⟨_, _, _, _, _, _, _, _, _, hIVP, _⟩ := hVolt.1 Q hQ_cont
    have h1_mem : (1 : ℝ) ∈ Set.Icc (0 : ℝ) 1 := ⟨zero_le_one, le_rfl⟩
    have hc := hIVP (fun x => Complex.cosh (ν * (x : ℂ)))
      (fun x => ν * Complex.sinh (ν * (x : ℂ)))
      (by fun_prop) (by fun_prop)
      (fun w hw => ⟨(h_deriv_cosh ν w).hasDerivWithinAt, by
        have hd := (h_deriv_sinh ν w).const_mul ν
        rw [hQ_eq w hw]
        convert hd.hasDerivWithinAt using 1
        ring⟩)
      1 h1_mem
    have hk := hIVP (fun x => Complex.sinh (ν * (x : ℂ)) / ν)
      (fun x => Complex.cosh (ν * (x : ℂ)))
      (by fun_prop) (by fun_prop)
      (fun w hw => ⟨by
        have hd := (h_deriv_sinh ν w).div_const ν
        rw [mul_div_cancel_left₀ _ hν] at hd
        exact hd.hasDerivWithinAt, by
        have hd := h_deriv_cosh ν w
        rw [hQ_eq w hw]
        convert hd.hasDerivWithinAt using 1
        field_simp [hν]⟩)
      1 h1_mem
    have hc1 := hc.1
    have hk1 := hk.1
    simp only [Complex.ofReal_zero, mul_zero, Complex.cosh_zero, Complex.sinh_zero,
      zero_div, one_mul, zero_mul, add_zero, zero_add, Complex.ofReal_one, mul_one] at hc1 hk1
    exact ⟨hc1.symm, hk1.symm⟩

  have h_kern_neg_quarter_sq : ∀ (Q : ℝ → ℂ) (μ : ℂ), μ ≠ 0 →
      ContinuousOn Q (Set.Icc (0 : ℝ) 1) →
      (∀ w ∈ Set.Icc (0 : ℝ) 1, Q w = -μ ^ 2 / 4) →
      k0Kernel Q 1 = 2 * Complex.sin (μ / 2) / μ := by
    intro Q μ hμ hQ_cont hQ_eq
    let ν : ℂ := (μ / 2) * Complex.I
    have hν : ν ≠ 0 := mul_ne_zero (div_ne_zero hμ two_ne_zero) Complex.I_ne_zero
    have hν_sq : ν ^ 2 = -μ ^ 2 / 4 := by
      dsimp [ν]
      rw [mul_pow, Complex.I_sq]
      ring
    have hk := (h_kern_const_sq Q ν hν hQ_cont (fun w hw => by rw [hQ_eq w hw, hν_sq])).2
    rw [hk]
    dsimp [ν]
    rw [Complex.sinh_mul_I]
    field_simp [hμ, Complex.I_ne_zero]

  have h_pert_cont_of : ∀ (sgn a₀ a₁ : ℂ) (Q : ℝ → ℂ),
      ContinuousOn Q (Set.Icc (0 : ℝ) 1) →
      ContinuousOn (pertPotential sgn Q a₀ a₁) (Set.Icc (0 : ℝ) 1) := by
    intro sgn a₀ a₁ Q hQ
    obtain ⟨_, _, _, _, hc0_c, hc0d_c, hk0_c, hk0d_c, _, _, _⟩ := hVolt.1 Q hQ
    unfold pertPotential
    refine (hQ.sub ?_).sub ?_
    · exact continuousOn_const.mul ((hc0d_c.const_mul a₀).add (hk0d_c.const_mul a₁))
    · exact continuousOn_const.mul (((hc0_c.const_mul a₀).add (hk0_c.const_mul a₁)).pow 2)

  have h_sl_first : ∀ Λ : ℂ, Λ ≠ 0 → Complex.sin (Λ / 2) ≠ 0 →
      slDivided (fun _ => 0) Λ 0 = (1 - 2 * Complex.sin (Λ / 2) / Λ) / Λ ^ 2 := by
    intro Λ hΛ hsin
    have hpert_eq : ∀ (sgn : ℂ) (w : ℝ), w ∈ Set.Icc (0 : ℝ) 1 →
        pertPotential sgn (fun _ => 0) Λ 0 w = -Λ ^ 2 / 4 := by
      intro sgn w hw
      obtain ⟨h1, h2, h3, h4⟩ := h_kern_zero w hw
      dsimp [pertPotential]
      rw [h1, h2, h3, h4]
      ring
    set k : ℂ := 2 * Complex.sin (Λ / 2) / Λ
    have hk_ne : k ≠ 0 := div_ne_zero (mul_ne_zero two_ne_zero hsin) hΛ
    have hkp : kPlusVal (fun _ => 0) Λ 0 = k :=
      h_kern_neg_quarter_sq _ Λ hΛ (h_pert_cont_of 1 Λ 0 _ continuousOn_const) (hpert_eq 1)
    have hkm : kMinusVal (fun _ => 0) Λ 0 = k :=
      h_kern_neg_quarter_sq _ Λ hΛ (h_pert_cont_of (-1) Λ 0 _ continuousOn_const) (hpert_eq (-1))
    have hroot : canonRoot (fun _ => 0) Λ 0 = k := by
      dsimp [canonRoot]
      rw [hkp, hkm]
      have h_one : 4 * k * k / (k + k) ^ 2 = 1 := by
        field_simp [hk_ne]
        ring
      rw [h_one, Complex.log_one, mul_zero, Complex.exp_zero, mul_one]
      ring
    have h1_mem : (1 : ℝ) ∈ Set.Icc (0 : ℝ) 1 := ⟨zero_le_one, le_rfl⟩
    obtain ⟨hc0_1, _, hk0_1, _⟩ := h_kern_zero 1 h1_mem
    dsimp [slDivided]
    rw [hc0_1, hk0_1, Complex.ofReal_one]
    have hb : Λ ≠ 0 ∧ Λ * 1 + 0 * 1 ≠ 0 := ⟨hΛ, by simpa using hΛ⟩
    rw [ite_eq_left_iff.mpr fun h => False.elim (h hb), hroot]
    ring

  have h_sl_second : ∀ Λ : ℂ, Λ ≠ 0 → k0Kernel (fun _ => Λ ^ 2) 1 ≠ 0 →
      Complex.cosh (Λ / 2) ≠ 0 ∧ Complex.sinh (Λ / 2) ≠ 0 ∧
      slDivided (fun _ => Λ ^ 2) 0 0 =
        1 / (2 * Λ ^ 2) - Complex.sinh (Λ / 2) / (Λ ^ 3 * Complex.cosh (Λ / 2)) := by
    intro Λ hΛ hk0_ne
    let Q_Λ : ℝ → ℂ := fun _ => Λ ^ 2
    obtain ⟨_, hk0_1⟩ :=
      h_kern_const_sq Q_Λ Λ hΛ continuousOn_const (fun _ _ => rfl)
    have hsinh_two : Complex.sinh Λ = 2 * Complex.sinh (Λ / 2) * Complex.cosh (Λ / 2) := by
      have h2 : Λ = 2 * (Λ / 2) := by ring
      conv_lhs => rw [h2]
      exact Complex.sinh_two_mul (Λ / 2)
    have hsinh_Λ_ne : Complex.sinh Λ ≠ 0 := by
      intro h0
      apply hk0_ne
      rw [hk0_1, h0, zero_div]
    rw [hsinh_two] at hsinh_Λ_ne
    have hcosh_ne : Complex.cosh (Λ / 2) ≠ 0 := right_ne_zero_of_mul hsinh_Λ_ne
    have hsinh_ne : Complex.sinh (Λ / 2) ≠ 0 :=
      right_ne_zero_of_mul (left_ne_zero_of_mul hsinh_Λ_ne)
    refine ⟨hcosh_ne, hsinh_ne, ?_⟩

    obtain ⟨δ_Q, r_b, _, hδ_Q, _, _, _, _, hHoloDiv⟩ :=
      hVolt.2.2.2 Q_Λ continuousOn_const hk0_ne
    let B_b1 : ℝ := ‖c0Kernel Q_Λ 1 + Λ * k0Kernel Q_Λ 1‖ + 1
    have hB_b1_pos : 0 < B_b1 := by positivity
    let r_η : ℝ := min (r_b / 4) (r_b / (4 * B_b1))
    have hr_η_pos : 0 < r_η := lt_min (by positivity) (by positivity)
    let U_η : Set (ℂ × ℂ) := Metric.ball (0 : ℂ) r_η ×ˢ Metric.ball (0 : ℂ) 1
    have hU_η_open : IsOpen U_η := Metric.isOpen_ball.prod Metric.isOpen_ball
    have h_sl_holo : DifferentiableOn ℂ (fun p : ℂ × ℂ => slDivided Q_Λ p.1 (p.1 * Λ)) U_η := by
      refine hHoloDiv U_η (fun _ => Q_Λ) Prod.fst (fun p => p.1 * Λ)
        hU_η_open continuousOn_const (fun _ _ => differentiableOn_const _)
        (fun _ _ _ _ => by simp [hδ_Q])
        differentiable_fst.differentiableOn
        (differentiable_fst.mul_const Λ).differentiableOn ?_
      intro p ⟨hp1, _⟩
      rw [Metric.mem_ball, dist_zero_right] at hp1
      have hp1_lt1 : ‖p.1‖ < r_b / 4 := lt_of_lt_of_le hp1 (min_le_left _ _)
      have hp1_lt2 : ‖p.1‖ < r_b / (4 * B_b1) := lt_of_lt_of_le hp1 (min_le_right _ _)
      refine ⟨by linarith, ?_⟩
      have h_eq : p.1 * c0Kernel Q_Λ 1 + p.1 * Λ * k0Kernel Q_Λ 1 =
          p.1 * (c0Kernel Q_Λ 1 + Λ * k0Kernel Q_Λ 1) := by ring
      rw [h_eq, norm_mul]
      have h_le : ‖c0Kernel Q_Λ 1 + Λ * k0Kernel Q_Λ 1‖ ≤ B_b1 := by dsimp [B_b1]; linarith
      have h_mul : ‖p.1‖ * B_b1 < r_b / 4 := by
        have := (lt_div_iff₀ (by positivity : 0 < 4 * B_b1)).mp hp1_lt2
        linarith
      nlinarith [norm_nonneg p.1]
    have h0_mem_U : ((0 : ℂ), (0 : ℂ)) ∈ U_η :=
      ⟨Metric.mem_ball_self hr_η_pos, Metric.mem_ball_self zero_lt_one⟩
    have h_cont_0 : ContinuousAt (fun η : ℂ => slDivided Q_Λ η (η * Λ)) 0 := by
      have hc2 := h_sl_holo.continuousOn.continuousAt (hU_η_open.mem_nhds h0_mem_U)
      have h_in_c : Continuous (fun η : ℂ => (η, (0 : ℂ))) :=
        continuous_id.prodMk continuous_const
      rw [ContinuousAt]
      exact hc2.tendsto.comp (by simpa using h_in_c.continuousAt.tendsto)

    obtain ⟨_, _, _, _, _, _, _, _, _, hIVP_Q, _⟩ :=
      hVolt.1 Q_Λ continuousOn_const
    have hF_eq : ∀ (η : ℂ) (w : ℝ), w ∈ Set.Icc (0 : ℝ) 1 →
        η * c0Kernel Q_Λ w + (η * Λ) * k0Kernel Q_Λ w = η * Complex.exp (Λ * (w : ℂ)) ∧
        η * c0Deriv Q_Λ w + (η * Λ) * k0Deriv Q_Λ w = η * Λ * Complex.exp (Λ * (w : ℂ)) := by
      intro η w hw
      have hd1 : ∀ x : ℝ, HasDerivAt (fun t : ℝ => η * Complex.exp (Λ * (t : ℂ)))
          (η * Λ * Complex.exp (Λ * (x : ℂ))) x := by
        intro x
        convert (h_deriv_exp Λ 0 x).const_mul η using 1
        · ext t; simp
        · simp; ring
      have hd2 : ∀ x : ℝ, HasDerivAt (fun t : ℝ => η * Λ * Complex.exp (Λ * (t : ℂ)))
          (Q_Λ x * (η * Complex.exp (Λ * (x : ℂ)))) x := by
        intro x
        convert (h_deriv_exp Λ 0 x).const_mul (η * Λ) using 1
        · ext t; simp
        · dsimp [Q_Λ]; simp; ring
      have hsol := hIVP_Q (fun t => η * Complex.exp (Λ * (t : ℂ)))
        (fun t => η * Λ * Complex.exp (Λ * (t : ℂ)))
        (by fun_prop) (by fun_prop)
        (fun x _ => ⟨(hd1 x).hasDerivWithinAt, (hd2 x).hasDerivWithinAt⟩)
        w hw
      obtain ⟨hsol1, hsol2⟩ := hsol
      simp only [Complex.ofReal_zero, mul_zero, Complex.exp_zero, mul_one] at hsol1 hsol2
      exact ⟨hsol1.symm, hsol2.symm⟩

    let A : ℝ → ℂ := fun w => (Complex.exp (Λ * (w : ℂ)) - 1) / Λ
    let ℐ : ℂ → ℂ := fun z =>
      ∫ w in (0 : ℝ)..1, Complex.exp (-2 * Λ * (w : ℂ) + z * A w)

    have hWron_pert : ∀ (sgn η : ℂ), sgn ^ 2 = 1 →
        k0Kernel (pertPotential sgn Q_Λ η (η * Λ)) 1 =
          Complex.exp (Λ - sgn * (Complex.I / 2) * η * A 1) * ℐ (sgn * Complex.I * η) := by
      intro sgn η hsgn
      obtain ⟨_, _, _, _, _, _, _, _, _, _, hWron⟩ :=
        hVolt.1 (pertPotential sgn Q_Λ η (η * Λ))
          (h_pert_cont_of sgn η (η * Λ) Q_Λ continuousOn_const)
      let A_ℂ : ℂ → ℂ := fun z => (Complex.exp (Λ * z) - 1) / Λ
      let ψ_ℂ : ℂ → ℂ := fun z => Λ * z - sgn * (Complex.I / 2) * η * A_ℂ z
      let ψ : ℝ → ℂ := fun w => ψ_ℂ (w : ℂ)
      let ψ' : ℝ → ℂ := fun w => Λ - sgn * (Complex.I / 2) * η * Complex.exp (Λ * (w : ℂ))
      let g : ℝ → ℂ := fun w => Complex.exp (ψ w)
      let g' : ℝ → ℂ := fun w => ψ' w * g w
      have hdg : ∀ w : ℝ, HasDerivAt g (g' w) w := by
        intro w
        have hd_lin : HasDerivAt (fun z : ℂ => Λ * z) (Λ * 1) (w : ℂ) :=
          (hasDerivAt_id (w : ℂ)).const_mul Λ
        have hd_exp_z : HasDerivAt (fun z : ℂ => Complex.exp (Λ * z))
            (Λ * Complex.exp (Λ * (w : ℂ))) (w : ℂ) := by
          convert (Complex.hasDerivAt_exp (Λ * (w : ℂ))).comp (w : ℂ) hd_lin using 1
          · rfl
          · ring
        have hd_A : HasDerivAt A_ℂ (Complex.exp (Λ * (w : ℂ))) (w : ℂ) := by
          dsimp [A_ℂ]
          convert (hd_exp_z.sub (hasDerivAt_const (w : ℂ) (1 : ℂ))).div_const Λ using 1
          simp [mul_div_cancel_left₀ _ hΛ]
        have hd_ψ_z : HasDerivAt ψ_ℂ (ψ' w) (w : ℂ) := by
          dsimp [ψ_ℂ, ψ']
          convert hd_lin.sub (hd_A.const_mul (sgn * (Complex.I / 2) * η)) using 1
          ring
        have hd_g_z : HasDerivAt (fun z : ℂ => Complex.exp (ψ_ℂ z)) (g' w) (w : ℂ) := by
          dsimp [g', g, ψ]
          convert (Complex.hasDerivAt_exp (ψ_ℂ (w : ℂ))).comp (w : ℂ) hd_ψ_z using 1
          · rfl
          · ring
        exact hd_g_z.comp_ofReal
      have hdψ' : ∀ w : ℝ, HasDerivAt ψ'
          (-sgn * (Complex.I / 2) * η * Λ * Complex.exp (Λ * (w : ℂ))) w := by
        intro w
        dsimp [ψ']
        have hd := (hasDerivAt_const w Λ).sub
          (((h_deriv_exp Λ 0 w).const_mul (sgn * (Complex.I / 2) * η)))
        convert hd using 1
        · ext x; simp
        · simp; ring
      have hdg' : ∀ w ∈ Set.Icc (0 : ℝ) 1,
          HasDerivAt g' (pertPotential sgn Q_Λ η (η * Λ) w * g w) w := by
        intro w hw
        obtain ⟨hFw, hFpw⟩ := hF_eq η w hw
        have hprod := (hdψ' w).mul (hdg w)
        convert hprod using 1
        dsimp [pertPotential, Q_Λ, ψ', g']
        rw [hFw, hFpw]
        ring_nf
        simp only [Complex.I_sq, hsgn]
        ring
      have hw_eq := hWron g g' (by dsimp [g, ψ, ψ_ℂ, A_ℂ]; fun_prop)
        (by dsimp [g', ψ', g, ψ, ψ_ℂ, A_ℂ]; fun_prop)
        (fun w hw => ⟨Complex.exp_ne_zero _, (hdg w).hasDerivWithinAt,
          (hdg' w hw).hasDerivWithinAt⟩)
      have hg0 : g 0 = 1 := by dsimp [g, ψ, ψ_ℂ, A_ℂ]; simp
      have hg1 : g 1 = Complex.exp (Λ - sgn * (Complex.I / 2) * η * A 1) := by
        dsimp [g, ψ, ψ_ℂ, A_ℂ, A]; simp
      have hint_eq : (∫ w in (0 : ℝ)..1, (g w)⁻¹ ^ 2) = ℐ (sgn * Complex.I * η) := by
        dsimp [ℐ]
        congr 1
        ext w
        dsimp [g, ψ, ψ_ℂ, A_ℂ, A]
        rw [← Complex.exp_neg, ← Complex.exp_nat_mul]
        congr 1
        push_cast
        ring
      rw [hw_eq, hg0, hg1, one_mul, hint_eq]

    have hk0_I0 : k0Kernel Q_Λ 1 = Complex.exp Λ * ℐ 0 := by
      have h0 := hWron_pert 1 0 (by norm_num)
      have h_pert0 : ∀ w ∈ Set.Icc (0 : ℝ) 1, pertPotential 1 Q_Λ 0 (0 * Λ) w = Q_Λ w := by
        intro w _
        dsimp [pertPotential]
        ring
      have h_lip := (hVolt.2.1.1 ‖Λ ^ 2‖ 0 (pertPotential 1 Q_Λ 0 (0 * Λ)) Q_Λ
        (norm_nonneg _) le_rfl
        (h_pert_cont_of 1 0 (0 * Λ) Q_Λ continuousOn_const)
        continuousOn_const
        (fun w hw => ⟨by rw [h_pert0 w hw], le_rfl, by rw [h_pert0 w hw, sub_self, norm_zero]⟩)
        1 ⟨zero_le_one, le_rfl⟩).2.2.2.2.2.1
      rw [mul_zero, norm_le_zero_iff, sub_eq_zero] at h_lip
      rw [← h_lip, h0]
      simp

    let I₀ : ℂ := ∫ w in (0 : ℝ)..1, Complex.exp (-2 * Λ * (w : ℂ))
    let I₁ : ℂ := ∫ w in (0 : ℝ)..1, Complex.exp (-2 * Λ * (w : ℂ)) * A w
    let I₂ : ℂ := ∫ w in (0 : ℝ)..1, Complex.exp (-2 * Λ * (w : ℂ)) * (A w) ^ 2
    have hI0_eq : ℐ 0 = I₀ := by dsimp [ℐ, I₀]; simp
    have hI0_ne : I₀ ≠ 0 := by
      intro h0
      apply hk0_ne
      rw [hk0_I0, hI0_eq, h0, mul_zero]

    let E : ℂ → ℂ := fun z => ℐ z - (I₀ + z * I₁ + (z ^ 2 / 2) * I₂)
    let M_A : ℝ := (Real.exp ‖Λ‖ + 1) / ‖Λ‖
    have hM_A_nonneg : 0 ≤ M_A := by positivity
    let C_E : ℝ := Real.exp (2 * ‖Λ‖) * M_A ^ 3 * Real.exp M_A
    have hC_E_nonneg : 0 ≤ C_E := by positivity
    have hA_bound : ∀ w ∈ Set.Icc (0 : ℝ) 1, ‖A w‖ ≤ M_A := by
      intro w ⟨hw0, hw1⟩
      dsimp [A, M_A]
      rw [norm_div]
      refine div_le_div_of_nonneg_right ?_ (norm_nonneg Λ)
      calc ‖Complex.exp (Λ * (w : ℂ)) - 1‖
          ≤ ‖Complex.exp (Λ * (w : ℂ))‖ + ‖(1 : ℂ)‖ := norm_sub_le _ _
        _ ≤ Real.exp ‖Λ * (w : ℂ)‖ + 1 := by
            linarith [Complex.norm_exp_le_exp_norm (Λ * (w : ℂ)), norm_one (α := ℂ)]
        _ ≤ Real.exp ‖Λ‖ + 1 := by
            have hw_norm : ‖Λ * (w : ℂ)‖ ≤ ‖Λ‖ := by
              rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg hw0]
              exact mul_le_of_le_one_right (norm_nonneg Λ) hw1
            linarith [Real.exp_le_exp.mpr hw_norm]

    have hE_bound : ∀ z : ℂ, ‖z‖ ≤ 1 → ‖E z‖ ≤ C_E * ‖z‖ ^ 3 := by
      intro z hz
      have h_int_eq : E z = ∫ w in (0 : ℝ)..1,
          Complex.exp (-2 * Λ * (w : ℂ)) *
            (Complex.exp (z * A w) - (1 + z * A w + (z * A w) ^ 2 / 2)) := by
        dsimp [E, ℐ, I₀, I₁, I₂]
        have hi0 : IntervalIntegrable (fun w : ℝ => Complex.exp (-2 * Λ * (w : ℂ)))
            MeasureTheory.volume 0 1 := (by fun_prop : Continuous _).intervalIntegrable 0 1
        have hi1 : IntervalIntegrable (fun w : ℝ => Complex.exp (-2 * Λ * (w : ℂ)) * A w)
            MeasureTheory.volume 0 1 := (by dsimp [A]; fun_prop : Continuous _).intervalIntegrable 0 1
        have hi2 : IntervalIntegrable (fun w : ℝ => Complex.exp (-2 * Λ * (w : ℂ)) * (A w) ^ 2)
            MeasureTheory.volume 0 1 := (by dsimp [A]; fun_prop : Continuous _).intervalIntegrable 0 1
        have hiz : IntervalIntegrable
            (fun w : ℝ => Complex.exp (-2 * Λ * (w : ℂ) + z * A w))
            MeasureTheory.volume 0 1 := (by dsimp [A]; fun_prop : Continuous _).intervalIntegrable 0 1
        rw [← intervalIntegral.integral_const_mul z,
            ← intervalIntegral.integral_const_mul (z ^ 2 / 2),
            ← intervalIntegral.integral_add hi0 (hi1.const_mul z),
            ← intervalIntegral.integral_add (hi0.add (hi1.const_mul z)) (hi2.const_mul (z ^ 2 / 2)),
            ← intervalIntegral.integral_sub hiz
              ((hi0.add (hi1.const_mul z)).add (hi2.const_mul (z ^ 2 / 2)))]
        congr 1
        ext w
        rw [Complex.exp_add]
        ring
      rw [h_int_eq]
      have h_pt : ∀ w ∈ Set.uIoc (0 : ℝ) 1,
          ‖Complex.exp (-2 * Λ * (w : ℂ)) *
            (Complex.exp (z * A w) - (1 + z * A w + (z * A w) ^ 2 / 2))‖ ≤
            C_E * ‖z‖ ^ 3 := by
        intro w hw
        rw [Set.uIoc_of_le zero_le_one] at hw
        have hw_icc : w ∈ Set.Icc (0 : ℝ) 1 := ⟨hw.1.le, hw.2⟩
        have hAw : ‖A w‖ ≤ M_A := hA_bound w hw_icc
        have hzAw : ‖z * A w‖ ≤ M_A := by
          rw [norm_mul]
          exact le_trans (mul_le_of_le_one_left (norm_nonneg _) hz) hAw
        have hrem : ‖Complex.exp (z * A w) - (1 + z * A w + (z * A w) ^ 2 / 2)‖ ≤
            ‖z * A w‖ ^ 3 * Real.exp ‖z * A w‖ := by
          have h3 := Complex.norm_exp_sub_sum_le_norm_mul_exp (z * A w) 3
          have hsum : (∑ m ∈ Finset.range 3, (z * A w) ^ m / (m.factorial : ℂ)) =
              1 + z * A w + (z * A w) ^ 2 / 2 := by
            simp [Finset.sum_range_succ, Nat.factorial]
          rwa [hsum] at h3
        have hexp_w : ‖Complex.exp (-2 * Λ * (w : ℂ))‖ ≤ Real.exp (2 * ‖Λ‖) := by
          calc ‖Complex.exp (-2 * Λ * (w : ℂ))‖
              ≤ Real.exp ‖-2 * Λ * (w : ℂ)‖ := Complex.norm_exp_le_exp_norm _
            _ ≤ Real.exp (2 * ‖Λ‖) := by
                apply Real.exp_le_exp.mpr
                rw [norm_mul, norm_mul, norm_neg, Complex.norm_ofNat, Complex.norm_real,
                  Real.norm_of_nonneg hw_icc.1]
                exact mul_le_of_le_one_right (by positivity) hw_icc.2
        have hrem' : ‖Complex.exp (z * A w) - (1 + z * A w + (z * A w) ^ 2 / 2)‖ ≤
            M_A ^ 3 * Real.exp M_A * ‖z‖ ^ 3 := by
          calc ‖Complex.exp (z * A w) - (1 + z * A w + (z * A w) ^ 2 / 2)‖
              ≤ ‖z * A w‖ ^ 3 * Real.exp ‖z * A w‖ := hrem
            _ ≤ (‖z‖ * M_A) ^ 3 * Real.exp M_A := by
                refine mul_le_mul ?_ (Real.exp_le_exp.mpr hzAw) (by positivity) (by positivity)
                rw [norm_mul]
                exact pow_le_pow_left₀ (by positivity)
                  (mul_le_mul_of_nonneg_left hAw (norm_nonneg z)) 3
            _ = M_A ^ 3 * Real.exp M_A * ‖z‖ ^ 3 := by ring
        rw [norm_mul]
        calc ‖Complex.exp (-2 * Λ * (w : ℂ))‖ *
              ‖Complex.exp (z * A w) - (1 + z * A w + (z * A w) ^ 2 / 2)‖
            ≤ Real.exp (2 * ‖Λ‖) * (M_A ^ 3 * Real.exp M_A * ‖z‖ ^ 3) :=
              mul_le_mul hexp_w hrem' (norm_nonneg _) (by positivity)
          _ = C_E * ‖z‖ ^ 3 := by dsimp [C_E]; ring
      simpa using intervalIntegral.norm_integral_le_of_norm_le_const h_pt
    have hℐ_eq : ∀ z : ℂ, ℐ z = I₀ + z * I₁ + (z ^ 2 / 2) * I₂ + E z := by
      intro z; dsimp [E]; ring
    have hE_tendsto : Filter.Tendsto E (nhds 0) (nhds 0) := by
      rw [Metric.tendsto_nhds_nhds]
      intro ε hε
      let δ : ℝ := min 1 ((ε / (C_E + 1)) ^ (1 / 3 : ℝ))
      have hδ_pos : 0 < δ := lt_min zero_lt_one (Real.rpow_pos_of_pos (by positivity) _)
      refine ⟨δ, hδ_pos, fun z hz => ?_⟩
      rw [dist_zero_right] at hz ⊢
      have hz1 : ‖z‖ ≤ 1 := le_trans hz.le (min_le_left _ _)
      have hz2 : ‖z‖ < (ε / (C_E + 1)) ^ (1 / 3 : ℝ) := lt_of_lt_of_le hz (min_le_right _ _)
      have hz3 : ‖z‖ ^ 3 < ε / (C_E + 1) := by
        rcases eq_or_lt_of_le (norm_nonneg z) with h0 | hpos
        · rw [← h0, zero_pow (by norm_num)]; positivity
        · calc ‖z‖ ^ 3 = (‖z‖ ^ (3 : ℕ)) := rfl
            _ < (((ε / (C_E + 1)) ^ (1 / 3 : ℝ)) ^ (3 : ℕ)) :=
                pow_lt_pow_left₀ hz2 hpos.le (by norm_num)
            _ = ε / (C_E + 1) := by
                rw [← Real.rpow_natCast, ← Real.rpow_mul (by positivity)]
                norm_num
      have hEb := hE_bound z hz1
      have h_lt : ‖z‖ ^ 3 * (C_E + 1) < ε :=
        (lt_div_iff₀ (by positivity : 0 < C_E + 1)).mp hz3
      nlinarith [norm_nonneg z, pow_nonneg (norm_nonneg z) 3]

    have hℐ_cont : ContinuousAt ℐ 0 := by
      have hpoly : ContinuousAt (fun z : ℂ => I₀ + z * I₁ + (z ^ 2 / 2) * I₂) 0 := by fun_prop
      have hE0 : E 0 = 0 := by dsimp [E]; rw [hI0_eq]; ring
      have hsum : ContinuousAt (fun z : ℂ => I₀ + z * I₁ + (z ^ 2 / 2) * I₂ + E z) 0 := by
        rw [ContinuousAt]
        convert hpoly.tendsto.add hE_tendsto using 1
        simp [hE0]
      exact hsum.congr (Filter.Eventually.of_forall fun z => (hℐ_eq z).symm)

    set k₀ : ℂ := k0Kernel Q_Λ 1
    have hkp_tendsto : Filter.Tendsto (fun η : ℂ => kPlusVal Q_Λ η (η * Λ)) (nhds 0) (nhds k₀) := by
      have h_eq : (fun η : ℂ => kPlusVal Q_Λ η (η * Λ)) =
          (fun η : ℂ => Complex.exp (Λ - (Complex.I / 2) * η * A 1) * ℐ (Complex.I * η)) := by
        ext η
        simpa [kPlusVal, one_mul] using hWron_pert 1 η (by norm_num)
      rw [h_eq, show k₀ = Complex.exp Λ * ℐ 0 from hk0_I0]
      have hc1 : ContinuousAt (fun η : ℂ => Complex.exp (Λ - (Complex.I / 2) * η * A 1)) 0 := by
        fun_prop
      have hin1 : Continuous (fun η : ℂ => Complex.I * η) := by fun_prop
      have hin1_t : Filter.Tendsto (fun η : ℂ => Complex.I * η) (nhds 0) (nhds 0) := by
        simpa using (hin1.continuousAt (x := (0 : ℂ))).tendsto
      have ht2 : Filter.Tendsto (fun η : ℂ => ℐ (Complex.I * η)) (nhds 0) (nhds (ℐ 0)) :=
        hℐ_cont.tendsto.comp hin1_t
      convert hc1.tendsto.mul ht2 using 1
      simp
    have hkm_tendsto : Filter.Tendsto (fun η : ℂ => kMinusVal Q_Λ η (η * Λ)) (nhds 0) (nhds k₀) := by
      have h_eq : (fun η : ℂ => kMinusVal Q_Λ η (η * Λ)) =
          (fun η : ℂ => Complex.exp (Λ + (Complex.I / 2) * η * A 1) * ℐ (-Complex.I * η)) := by
        ext η
        simpa [kMinusVal, sub_neg_eq_add] using hWron_pert (-1) η (by norm_num)
      rw [h_eq, show k₀ = Complex.exp Λ * ℐ 0 from hk0_I0]
      have hc1 : ContinuousAt (fun η : ℂ => Complex.exp (Λ + (Complex.I / 2) * η * A 1)) 0 := by
        fun_prop
      have hin2 : Continuous (fun η : ℂ => -Complex.I * η) := by fun_prop
      have hin2_t : Filter.Tendsto (fun η : ℂ => -Complex.I * η) (nhds 0) (nhds 0) := by
        simpa using (hin2.continuousAt (x := (0 : ℂ))).tendsto
      have ht2 : Filter.Tendsto (fun η : ℂ => ℐ (-Complex.I * η)) (nhds 0) (nhds (ℐ 0)) :=
        hℐ_cont.tendsto.comp hin2_t
      convert hc1.tendsto.mul ht2 using 1
      simp

    let Ξ : ℂ → ℂ := fun η =>
      4 * kPlusVal Q_Λ η (η * Λ) * kMinusVal Q_Λ η (η * Λ) /
        (kPlusVal Q_Λ η (η * Λ) + kMinusVal Q_Λ η (η * Λ)) ^ 2
    have hΞ_tendsto : Filter.Tendsto Ξ (nhds 0) (nhds 1) := by
      have hnum : Filter.Tendsto
          (fun η => 4 * kPlusVal Q_Λ η (η * Λ) * kMinusVal Q_Λ η (η * Λ))
          (nhds 0) (nhds (4 * k₀ * k₀)) :=
        ((tendsto_const_nhds.mul hkp_tendsto).mul hkm_tendsto)
      have hden : Filter.Tendsto
          (fun η => (kPlusVal Q_Λ η (η * Λ) + kMinusVal Q_Λ η (η * Λ)) ^ 2)
          (nhds 0) (nhds ((k₀ + k₀) ^ 2)) :=
        (hkp_tendsto.add hkm_tendsto).pow 2
      have hden_ne : (k₀ + k₀) ^ 2 ≠ 0 :=
        pow_ne_zero 2 (by rw [← two_mul]; exact mul_ne_zero two_ne_zero hk0_ne)
      convert hnum.div hden hden_ne using 1
      field_simp [hk0_ne]
      ring
    have h1_slit : (1 : ℂ) ∈ Complex.slitPlane :=
      Complex.mem_slitPlane_iff.mpr (Or.inl (by simp))
    have hroot_tendsto : Filter.Tendsto (fun η => canonRoot Q_Λ η (η * Λ)) (nhds 0) (nhds k₀) := by
      have h1 : Filter.Tendsto
          (fun η => (kPlusVal Q_Λ η (η * Λ) + kMinusVal Q_Λ η (η * Λ)) / 2)
          (nhds 0) (nhds ((k₀ + k₀) / 2)) :=
        (hkp_tendsto.add hkm_tendsto).div_const 2
      have hlog : ContinuousAt (fun z : ℂ => Complex.exp ((1 / 2 : ℂ) * Complex.log z)) 1 :=
        Complex.continuous_exp.continuousAt.comp
          (continuousAt_const.mul (Complex.differentiableAt_log h1_slit).continuousAt)
      have h2 : Filter.Tendsto
          (fun η => Complex.exp ((1 / 2 : ℂ) * Complex.log (Ξ η)))
          (nhds 0) (nhds (Complex.exp ((1 / 2 : ℂ) * Complex.log 1))) :=
        hlog.tendsto.comp hΞ_tendsto
      have hmul := h1.mul h2
      have hlim_eq : ((k₀ + k₀) / 2) * Complex.exp ((1 / 2 : ℂ) * Complex.log 1) = k₀ := by
        simp
      rw [hlim_eq] at hmul
      exact hmul

    have h_quot_tendsto : Filter.Tendsto
        (fun η : ℂ => (I₀ ^ 2 - ℐ (Complex.I * η) * ℐ (-Complex.I * η)) / η ^ 2)
        (nhdsWithin 0 {(0 : ℂ)}ᶜ) (nhds (I₀ * I₂ - I₁ ^ 2)) := by
      rw [Metric.tendsto_nhdsWithin_nhds]
      intro ε hε
      let P_p : ℂ → ℂ := fun η => I₀ + Complex.I * η * I₁ - (η ^ 2 / 2) * I₂
      let P_m : ℂ → ℂ := fun η => I₀ - Complex.I * η * I₁ - (η ^ 2 / 2) * I₂
      let M_P : ℝ := ‖I₀‖ + ‖I₁‖ + ‖I₂‖ + 1
      let B_err : ℝ := ‖I₂‖ ^ 2 + 2 * M_P * C_E + C_E ^ 2 + 1
      have hB_pos : 0 < B_err := by positivity
      let δ : ℝ := min 1 (ε / B_err)
      have hδ_pos : 0 < δ := lt_min zero_lt_one (by positivity)
      refine ⟨δ, hδ_pos, fun η hη_ne hη_lt => ?_⟩
      rw [Set.mem_compl_singleton_iff] at hη_ne
      rw [dist_zero_right] at hη_lt
      have hη_le1 : ‖η‖ ≤ 1 := le_trans hη_lt.le (min_le_left _ _)
      have hη_lt_B : ‖η‖ < ε / B_err := lt_of_lt_of_le hη_lt (min_le_right _ _)
      have hℐ_p : ℐ (Complex.I * η) = P_p η + E (Complex.I * η) := by
        rw [hℐ_eq]; dsimp [P_p]
        have hIsq : (Complex.I * η) ^ 2 = -η ^ 2 := by rw [mul_pow, Complex.I_sq]; ring
        rw [hIsq]; ring
      have hℐ_m : ℐ (-Complex.I * η) = P_m η + E (-Complex.I * η) := by
        rw [hℐ_eq]; dsimp [P_m]
        have hIsq : (-Complex.I * η) ^ 2 = -η ^ 2 := by rw [mul_pow, neg_sq, Complex.I_sq]; ring
        rw [hIsq]; ring
      have hP_prod : I₀ ^ 2 - P_p η * P_m η =
          η ^ 2 * (I₀ * I₂ - I₁ ^ 2 - (1 / 4 : ℂ) * I₂ ^ 2 * η ^ 2) := by
        dsimp [P_p, P_m]
        ring_nf
        simp only [Complex.I_sq]
        ring
      have h_diff_eq : (I₀ ^ 2 - ℐ (Complex.I * η) * ℐ (-Complex.I * η)) / η ^ 2 -
          (I₀ * I₂ - I₁ ^ 2) =
          -(1 / 4 : ℂ) * I₂ ^ 2 * η ^ 2 -
            (P_p η * E (-Complex.I * η) + P_m η * E (Complex.I * η) +
              E (Complex.I * η) * E (-Complex.I * η)) / η ^ 2 := by
        have h_exp_num : I₀ ^ 2 - ℐ (Complex.I * η) * ℐ (-Complex.I * η) =
            (I₀ ^ 2 - P_p η * P_m η) -
              (P_p η * E (-Complex.I * η) + P_m η * E (Complex.I * η) +
                E (Complex.I * η) * E (-Complex.I * η)) := by
          rw [hℐ_p, hℐ_m]; ring
        rw [h_exp_num, hP_prod]
        have hη2_ne : η ^ 2 ≠ 0 := pow_ne_zero 2 hη_ne
        field_simp [hη2_ne]
        ring
      rw [dist_eq_norm, h_diff_eq]
      have hEp : ‖E (Complex.I * η)‖ ≤ C_E * ‖η‖ ^ 3 := by
        simpa using hE_bound (Complex.I * η) (by simpa using hη_le1)
      have hEm : ‖E (-Complex.I * η)‖ ≤ C_E * ‖η‖ ^ 3 := by
        simpa using hE_bound (-Complex.I * η) (by simpa using hη_le1)
      have hPp_le : ‖P_p η‖ ≤ M_P := by
        dsimp [P_p, M_P]
        have h1 := norm_sub_le (I₀ + Complex.I * η * I₁) ((η ^ 2 / 2) * I₂)
        have h2 := norm_add_le I₀ (Complex.I * η * I₁)
        have h3 : ‖Complex.I * η * I₁‖ ≤ ‖I₁‖ := by
          rw [norm_mul, norm_mul, Complex.norm_I, one_mul]
          exact mul_le_of_le_one_left (norm_nonneg _) hη_le1
        have h4 : ‖(η ^ 2 / 2) * I₂‖ ≤ ‖I₂‖ := by
          rw [norm_mul, norm_div, norm_pow, Complex.norm_ofNat]
          exact mul_le_of_le_one_left (norm_nonneg _) (by nlinarith [norm_nonneg η])
        linarith
      have hPm_le : ‖P_m η‖ ≤ M_P := by
        dsimp [P_m, M_P]
        have h1 := norm_sub_le (I₀ - Complex.I * η * I₁) ((η ^ 2 / 2) * I₂)
        have h2 := norm_sub_le I₀ (Complex.I * η * I₁)
        have h3 : ‖Complex.I * η * I₁‖ ≤ ‖I₁‖ := by
          rw [norm_mul, norm_mul, Complex.norm_I, one_mul]
          exact mul_le_of_le_one_left (norm_nonneg _) hη_le1
        have h4 : ‖(η ^ 2 / 2) * I₂‖ ≤ ‖I₂‖ := by
          rw [norm_mul, norm_div, norm_pow, Complex.norm_ofNat]
          exact mul_le_of_le_one_left (norm_nonneg _) (by nlinarith [norm_nonneg η])
        linarith
      have hη_pos : 0 < ‖η‖ := norm_pos_iff.mpr hη_ne
      have h_num_le : ‖P_p η * E (-Complex.I * η) + P_m η * E (Complex.I * η) +
          E (Complex.I * η) * E (-Complex.I * η)‖ ≤
          (2 * M_P * C_E + C_E ^ 2) * ‖η‖ ^ 3 := by
        have h1 := norm_add_le
          (P_p η * E (-Complex.I * η) + P_m η * E (Complex.I * η))
          (E (Complex.I * η) * E (-Complex.I * η))
        have h2 := norm_add_le (P_p η * E (-Complex.I * η)) (P_m η * E (Complex.I * η))
        have h3 : ‖P_p η * E (-Complex.I * η)‖ ≤ M_P * (C_E * ‖η‖ ^ 3) := by
          rw [norm_mul]; exact mul_le_mul hPp_le hEm (norm_nonneg _) (by positivity)
        have h4 : ‖P_m η * E (Complex.I * η)‖ ≤ M_P * (C_E * ‖η‖ ^ 3) := by
          rw [norm_mul]; exact mul_le_mul hPm_le hEp (norm_nonneg _) (by positivity)
        have h5 : ‖E (Complex.I * η) * E (-Complex.I * η)‖ ≤ C_E ^ 2 * ‖η‖ ^ 3 := by
          rw [norm_mul]
          have hη6 : ‖η‖ ^ 6 ≤ ‖η‖ ^ 3 := by
            have : ‖η‖ ^ 3 ≤ 1 := pow_le_one₀ hη_pos.le hη_le1
            nlinarith [pow_nonneg hη_pos.le 3]
          calc ‖E (Complex.I * η)‖ * ‖E (-Complex.I * η)‖
              ≤ (C_E * ‖η‖ ^ 3) * (C_E * ‖η‖ ^ 3) :=
                mul_le_mul hEp hEm (norm_nonneg _) (by positivity)
            _ = C_E ^ 2 * ‖η‖ ^ 6 := by ring
            _ ≤ C_E ^ 2 * ‖η‖ ^ 3 := mul_le_mul_of_nonneg_left hη6 (sq_nonneg C_E)
        linarith
      have h_div_le : ‖(P_p η * E (-Complex.I * η) + P_m η * E (Complex.I * η) +
          E (Complex.I * η) * E (-Complex.I * η)) / η ^ 2‖ ≤
          (2 * M_P * C_E + C_E ^ 2) * ‖η‖ := by
        rw [norm_div, norm_pow]
        have := div_le_div_of_nonneg_right h_num_le (sq_nonneg ‖η‖)
        have h_cancel : (2 * M_P * C_E + C_E ^ 2) * ‖η‖ ^ 3 / ‖η‖ ^ 2 =
            (2 * M_P * C_E + C_E ^ 2) * ‖η‖ := by field_simp [hη_pos.ne']
        rwa [h_cancel] at this
      have h_first_le : ‖-(1 / 4 : ℂ) * I₂ ^ 2 * η ^ 2‖ ≤ ‖I₂‖ ^ 2 * ‖η‖ := by
        rw [norm_mul, norm_mul, norm_neg, norm_div, norm_one, Complex.norm_ofNat,
          norm_pow, norm_pow]
        have hη2 : ‖η‖ ^ 2 ≤ ‖η‖ := by nlinarith
        nlinarith [sq_nonneg ‖I₂‖]
      have h_tot : ‖-(1 / 4 : ℂ) * I₂ ^ 2 * η ^ 2 -
          (P_p η * E (-Complex.I * η) + P_m η * E (Complex.I * η) +
            E (Complex.I * η) * E (-Complex.I * η)) / η ^ 2‖ ≤ B_err * ‖η‖ := by
        have hsub := norm_sub_le (-(1 / 4 : ℂ) * I₂ ^ 2 * η ^ 2)
          ((P_p η * E (-Complex.I * η) + P_m η * E (Complex.I * η) +
            E (Complex.I * η) * E (-Complex.I * η)) / η ^ 2)
        dsimp [B_err]; linarith
      have h_lt_eps : B_err * ‖η‖ < ε := by
        have := (lt_div_iff₀ hB_pos).mp hη_lt_B
        linarith
      exact lt_of_le_of_lt h_tot h_lt_eps

    have h_sl_ev : ∀ᶠ η : ℂ in nhdsWithin 0 {(0 : ℂ)}ᶜ,
        slDivided Q_Λ η (η * Λ) =
          (Complex.exp Λ / (k₀ + canonRoot Q_Λ η (η * Λ))) *
            ((I₀ ^ 2 - ℐ (Complex.I * η) * ℐ (-Complex.I * η)) / η ^ 2) := by
      have hev_Ξ : ∀ᶠ η : ℂ in nhds 0, Ξ η ∈ Complex.slitPlane :=
        hΞ_tendsto.eventually (Complex.isOpen_slitPlane.mem_nhds h1_slit)
      have hev_sum : ∀ᶠ η : ℂ in nhds 0,
          kPlusVal Q_Λ η (η * Λ) + kMinusVal Q_Λ η (η * Λ) ≠ 0 :=
        (hkp_tendsto.add hkm_tendsto).eventually_ne
          (by rw [← two_mul]; exact mul_ne_zero two_ne_zero hk0_ne)
      have hev_root : ∀ᶠ η : ℂ in nhds 0, k₀ + canonRoot Q_Λ η (η * Λ) ≠ 0 :=
        (tendsto_const_nhds.add hroot_tendsto).eventually_ne
          (by rw [← two_mul]; exact mul_ne_zero two_ne_zero hk0_ne)
      filter_upwards [nhdsWithin_le_nhds (hev_Ξ.and (hev_sum.and hev_root)),
        self_mem_nhdsWithin] with η ⟨hΞ_mem, hsum_ne, hroot_sum_ne⟩ hη_ne
      rw [Set.mem_compl_singleton_iff] at hη_ne
      have hb1_eq : η * c0Kernel Q_Λ 1 + (η * Λ) * k0Kernel Q_Λ 1 = η * Complex.exp Λ := by
        simpa using (hF_eq η 1 ⟨zero_le_one, le_rfl⟩).1
      have hb_ne : η ≠ 0 ∧ η * c0Kernel Q_Λ 1 + (η * Λ) * k0Kernel Q_Λ 1 ≠ 0 :=
        ⟨hη_ne, by rw [hb1_eq]; exact mul_ne_zero hη_ne (Complex.exp_ne_zero Λ)⟩
      dsimp [slDivided]
      rw [ite_eq_left_iff.mpr fun h => False.elim (h hb_ne), hb1_eq]
      have hΞ_ne : Ξ η ≠ 0 := Complex.slitPlane_ne_zero hΞ_mem
      have hroot_sq : (canonRoot Q_Λ η (η * Λ)) ^ 2 =
          Complex.exp (2 * Λ) * (ℐ (Complex.I * η) * ℐ (-Complex.I * η)) := by
        have hexp_sq : (Complex.exp ((1 / 2 : ℂ) * Complex.log (Ξ η))) ^ 2 = Ξ η := by
          rw [← Complex.exp_nat_mul]
          have : ((2 : ℕ) : ℂ) * ((1 / 2 : ℂ) * Complex.log (Ξ η)) = Complex.log (Ξ η) := by
            push_cast; ring
          rw [this, Complex.exp_log hΞ_ne]
        have hkp_eq : kPlusVal Q_Λ η (η * Λ) =
            Complex.exp (Λ - (Complex.I / 2) * η * A 1) * ℐ (Complex.I * η) := by
          simpa [kPlusVal, one_mul] using hWron_pert 1 η (by norm_num)
        have hkm_eq : kMinusVal Q_Λ η (η * Λ) =
            Complex.exp (Λ + (Complex.I / 2) * η * A 1) * ℐ (-Complex.I * η) := by
          simpa [kMinusVal, sub_neg_eq_add] using hWron_pert (-1) η (by norm_num)
        calc (canonRoot Q_Λ η (η * Λ)) ^ 2
            = ((kPlusVal Q_Λ η (η * Λ) + kMinusVal Q_Λ η (η * Λ)) / 2) ^ 2 *
                (Complex.exp ((1 / 2 : ℂ) * Complex.log (Ξ η))) ^ 2 := by
                dsimp [canonRoot]; ring
          _ = ((kPlusVal Q_Λ η (η * Λ) + kMinusVal Q_Λ η (η * Λ)) / 2) ^ 2 * Ξ η := by
                rw [hexp_sq]
          _ = kPlusVal Q_Λ η (η * Λ) * kMinusVal Q_Λ η (η * Λ) := by
                dsimp [Ξ]; field_simp [hsum_ne]; ring
          _ = (Complex.exp (Λ - (Complex.I / 2) * η * A 1) *
                Complex.exp (Λ + (Complex.I / 2) * η * A 1)) *
                (ℐ (Complex.I * η) * ℐ (-Complex.I * η)) := by
                rw [hkp_eq, hkm_eq]; ring
          _ = Complex.exp (2 * Λ) * (ℐ (Complex.I * η) * ℐ (-Complex.I * η)) := by
                rw [← Complex.exp_add]; congr 2; ring
      have hk0_sq : k₀ ^ 2 = Complex.exp (2 * Λ) * I₀ ^ 2 := by
        rw [show k₀ = Complex.exp Λ * ℐ 0 from hk0_I0, hI0_eq, mul_pow, ← Complex.exp_nat_mul]
        push_cast; rfl
      have h_num_diff : k₀ - canonRoot Q_Λ η (η * Λ) =
          Complex.exp (2 * Λ) * (I₀ ^ 2 - ℐ (Complex.I * η) * ℐ (-Complex.I * η)) /
            (k₀ + canonRoot Q_Λ η (η * Λ)) := by
        rw [eq_div_iff hroot_sum_ne]
        calc (k₀ - canonRoot Q_Λ η (η * Λ)) * (k₀ + canonRoot Q_Λ η (η * Λ))
            = k₀ ^ 2 - (canonRoot Q_Λ η (η * Λ)) ^ 2 := by ring
          _ = Complex.exp (2 * Λ) * I₀ ^ 2 -
                Complex.exp (2 * Λ) * (ℐ (Complex.I * η) * ℐ (-Complex.I * η)) := by
                rw [hk0_sq, hroot_sq]
          _ = Complex.exp (2 * Λ) * (I₀ ^ 2 - ℐ (Complex.I * η) * ℐ (-Complex.I * η)) := by ring
      have hexp2 : Complex.exp (2 * Λ) = Complex.exp Λ * Complex.exp Λ := by
        rw [← Complex.exp_add]; ring_nf
      have hexp_ne : Complex.exp Λ ≠ 0 := Complex.exp_ne_zero Λ
      change (k₀ - canonRoot Q_Λ η (η * Λ)) / (η * (η * Complex.exp Λ)) = _
      rw [h_num_diff, hexp2]
      field_simp [hη_ne, hexp_ne, hroot_sum_ne]

    have h_pref_tendsto : Filter.Tendsto
        (fun η : ℂ => Complex.exp Λ / (k₀ + canonRoot Q_Λ η (η * Λ)))
        (nhdsWithin 0 {(0 : ℂ)}ᶜ) (nhds (1 / (2 * I₀))) := by
      have h1 : Filter.Tendsto
          (fun η : ℂ => Complex.exp Λ / (k₀ + canonRoot Q_Λ η (η * Λ)))
          (nhds 0) (nhds (Complex.exp Λ / (k₀ + k₀))) :=
        tendsto_const_nhds.div (tendsto_const_nhds.add hroot_tendsto)
          (by rw [← two_mul]; exact mul_ne_zero two_ne_zero hk0_ne)
      have h_val : Complex.exp Λ / (k₀ + k₀) = 1 / (2 * I₀) := by
        rw [show k₀ = Complex.exp Λ * ℐ 0 from hk0_I0, hI0_eq]
        have hexp_ne : Complex.exp Λ ≠ 0 := Complex.exp_ne_zero Λ
        field_simp [hexp_ne, hI0_ne]; ring
      rw [← h_val]
      exact h1.mono_left nhdsWithin_le_nhds

    have h_lim_rhs : Filter.Tendsto (fun η : ℂ => slDivided Q_Λ η (η * Λ))
        (nhdsWithin 0 {(0 : ℂ)}ᶜ) (nhds ((I₀ * I₂ - I₁ ^ 2) / (2 * I₀))) := by
      have hmul := h_pref_tendsto.mul h_quot_tendsto
      have h_eq_lim : (1 / (2 * I₀)) * (I₀ * I₂ - I₁ ^ 2) = (I₀ * I₂ - I₁ ^ 2) / (2 * I₀) := by
        ring
      rw [h_eq_lim] at hmul
      exact hmul.congr' (Filter.EventuallyEq.symm h_sl_ev)
    have h_lim_lhs : Filter.Tendsto (fun η : ℂ => slDivided Q_Λ η (η * Λ))
        (nhdsWithin 0 {(0 : ℂ)}ᶜ) (nhds (slDivided Q_Λ 0 0)) := by
      simpa using h_cont_0.tendsto.mono_left nhdsWithin_le_nhds
    have hsl_eq_var : slDivided Q_Λ 0 0 = (I₀ * I₂ - I₁ ^ 2) / (2 * I₀) :=
      tendsto_nhds_unique h_lim_lhs h_lim_rhs

    have hint_exp : ∀ c : ℂ, c ≠ 0 →
        (∫ w in (0 : ℝ)..1, Complex.exp (c * (w : ℂ))) = (Complex.exp c - 1) / c := by
      intro c hc
      have hd : ∀ x ∈ Set.uIcc (0 : ℝ) 1,
          HasDerivAt (fun w : ℝ => Complex.exp (c * (w : ℂ)) / c)
            (Complex.exp (c * (x : ℂ))) x := by
        intro x _
        convert (h_deriv_exp c 0 x).div_const c using 1
        · ext t; simp
        · simp [mul_div_cancel_left₀ _ hc]
      rw [intervalIntegral.integral_eq_sub_of_hasDerivAt hd
        ((by fun_prop : Continuous _).intervalIntegrable 0 1)]
      simp; ring
    set u : ℂ := Complex.exp (Λ / 2)
    have hu_ne : u ≠ 0 := Complex.exp_ne_zero _
    have hexp_neg1 : Complex.exp (-Λ) = (u ^ 2)⁻¹ := by
      dsimp [u]; rw [← Complex.exp_nat_mul, ← Complex.exp_neg]; congr 1; push_cast; ring
    have hexp_neg2 : Complex.exp (-2 * Λ) = (u ^ 4)⁻¹ := by
      dsimp [u]; rw [← Complex.exp_nat_mul, ← Complex.exp_neg]; congr 1; push_cast; ring
    have hI0_val : I₀ = (1 - (u ^ 4)⁻¹) / (2 * Λ) := by
      dsimp [I₀]
      rw [hint_exp (-2 * Λ) (mul_ne_zero (by norm_num) hΛ), hexp_neg2]
      field_simp [hΛ]; ring
    have hI1_val : I₁ = ((1 - (u ^ 2)⁻¹) / Λ - (1 - (u ^ 4)⁻¹) / (2 * Λ)) / Λ := by
      have h_eq : (fun w : ℝ => Complex.exp (-2 * Λ * (w : ℂ)) * A w) =
          (fun w : ℝ => (Complex.exp (-Λ * (w : ℂ)) - Complex.exp (-2 * Λ * (w : ℂ))) / Λ) := by
        ext w; dsimp [A]
        have hexp : Complex.exp (-2 * Λ * (w : ℂ)) * Complex.exp (Λ * (w : ℂ)) =
            Complex.exp (-Λ * (w : ℂ)) := by rw [← Complex.exp_add]; congr 1; ring
        calc Complex.exp (-2 * Λ * (w : ℂ)) * ((Complex.exp (Λ * (w : ℂ)) - 1) / Λ)
            = (Complex.exp (-2 * Λ * (w : ℂ)) * Complex.exp (Λ * (w : ℂ)) -
                Complex.exp (-2 * Λ * (w : ℂ))) / Λ := by ring
          _ = (Complex.exp (-Λ * (w : ℂ)) - Complex.exp (-2 * Λ * (w : ℂ))) / Λ := by rw [hexp]
      dsimp [I₁]
      rw [h_eq, intervalIntegral.integral_div, intervalIntegral.integral_sub
        ((by fun_prop : Continuous _).intervalIntegrable 0 1)
        ((by fun_prop : Continuous _).intervalIntegrable 0 1),
        hint_exp (-Λ) (neg_ne_zero.mpr hΛ),
        hint_exp (-2 * Λ) (mul_ne_zero (by norm_num) hΛ), hexp_neg1, hexp_neg2]
      field_simp [hΛ]; ring
    have hI2_val : I₂ = (1 - 2 * ((1 - (u ^ 2)⁻¹) / Λ) + (1 - (u ^ 4)⁻¹) / (2 * Λ)) / Λ ^ 2 := by
      have h_eq : (fun w : ℝ => Complex.exp (-2 * Λ * (w : ℂ)) * (A w) ^ 2) =
          (fun w : ℝ => (1 - 2 * Complex.exp (-Λ * (w : ℂ)) +
            Complex.exp (-2 * Λ * (w : ℂ))) / Λ ^ 2) := by
        ext w; dsimp [A]
        have hexp1 : Complex.exp (-2 * Λ * (w : ℂ)) * Complex.exp (Λ * (w : ℂ)) =
            Complex.exp (-Λ * (w : ℂ)) := by rw [← Complex.exp_add]; congr 1; ring
        have hexp2 : Complex.exp (-2 * Λ * (w : ℂ)) * (Complex.exp (Λ * (w : ℂ))) ^ 2 = 1 := by
          rw [← Complex.exp_nat_mul, ← Complex.exp_add]
          have : -2 * Λ * (w : ℂ) + ((2 : ℕ) : ℂ) * (Λ * (w : ℂ)) = 0 := by push_cast; ring
          rw [this, Complex.exp_zero]
        calc Complex.exp (-2 * Λ * (w : ℂ)) * (((Complex.exp (Λ * (w : ℂ)) - 1) / Λ) ^ 2)
            = (Complex.exp (-2 * Λ * (w : ℂ)) * (Complex.exp (Λ * (w : ℂ))) ^ 2 -
                2 * (Complex.exp (-2 * Λ * (w : ℂ)) * Complex.exp (Λ * (w : ℂ))) +
                Complex.exp (-2 * Λ * (w : ℂ))) / Λ ^ 2 := by ring
          _ = (1 - 2 * Complex.exp (-Λ * (w : ℂ)) +
                Complex.exp (-2 * Λ * (w : ℂ))) / Λ ^ 2 := by rw [hexp1, hexp2]
      dsimp [I₂]
      have hi_c : IntervalIntegrable (fun _ : ℝ => (1 : ℂ)) MeasureTheory.volume 0 1 :=
        intervalIntegrable_const
      have hi_1 : IntervalIntegrable (fun w : ℝ => 2 * Complex.exp (-Λ * (w : ℂ)))
          MeasureTheory.volume 0 1 := (by fun_prop : Continuous _).intervalIntegrable 0 1
      have hi_2 : IntervalIntegrable (fun w : ℝ => Complex.exp (-2 * Λ * (w : ℂ)))
          MeasureTheory.volume 0 1 := (by fun_prop : Continuous _).intervalIntegrable 0 1
      rw [h_eq, intervalIntegral.integral_div,
        intervalIntegral.integral_add (hi_c.sub hi_1) hi_2,
        intervalIntegral.integral_sub hi_c hi_1,
        intervalIntegral.integral_const_mul 2,
        intervalIntegral.integral_const,
        hint_exp (-Λ) (neg_ne_zero.mpr hΛ),
        hint_exp (-2 * Λ) (mul_ne_zero (by norm_num) hΛ), hexp_neg1, hexp_neg2]
      simp only [sub_zero, one_smul]
      field_simp [hΛ]; ring
    have hsinh_u : Complex.sinh (Λ / 2) = (u - u⁻¹) / 2 := by
      rw [Complex.sinh]; dsimp [u]; rw [Complex.exp_neg]
    have hcosh_u : Complex.cosh (Λ / 2) = (u + u⁻¹) / 2 := by
      rw [Complex.cosh]; dsimp [u]; rw [Complex.exp_neg]
    have hu4_ne : 1 - (u ^ 4)⁻¹ ≠ 0 := by
      intro h0; apply hI0_ne; rw [hI0_val, h0, zero_div]
    have hu_plus_ne : u + u⁻¹ ≠ 0 := by
      intro h0; apply hcosh_ne; rw [hcosh_u, h0, zero_div]
    have hu2_plus_ne : u ^ 2 + 1 ≠ 0 := by
      intro h0; apply hu_plus_ne
      have : u + u⁻¹ = (u ^ 2 + 1) / u := by field_simp [hu_ne]
      rw [this, h0, zero_div]
    have hu4_sub_ne : u ^ 4 - 1 ≠ 0 := by
      intro h0; apply hu4_ne
      have : 1 - (u ^ 4)⁻¹ = (u ^ 4 - 1) / u ^ 4 := by field_simp [hu_ne]
      rw [this, h0, zero_div]
    rw [hsl_eq_var, hI0_val, hI1_val, hI2_val, hsinh_u, hcosh_u]
    field_simp [hΛ, hu_ne, hu_plus_ne, hu2_plus_ne, hu4_sub_ne]
    ring

  
  
  
  let H₀ : ℂ := T₀ * J₀
  let p₀ : ℂ × ℂ := (S₀, H₀)
  let U₁ : Set (ℂ × ℂ) := { p : ℂ × ℂ | ‖p.1 - S₀‖ < 1 ∧ ‖p.2 - H₀‖ < 1 }
  let s_n : ℕ → ℂ := fun n => (seq.x_seq n : ℂ) + (seq.h_seq n : ℂ) * Complex.I
  let s_pt : ℕ → ℂ × ℂ → ℂ := fun n p => s_n n + (seq.ℓ_seq n : ℂ) * p.1
  let h_pt : ℕ → ℂ × ℂ → ℂ := fun n p => p.2 / (seq.m_seq n : ℂ)
  let b_n : ℕ → ℝ := fun n => seq.ℓ_seq n * seq.m_seq n
  let Λ_fn : ℂ × ℂ → ℂ := fun p => p.2 * seq.c₀ * Complex.exp (-Complex.I * p.1)
  let q_lim : ℂ × ℂ → ℂ := fun p =>
    ExpProfileKind.casesOn kind 0 ((Λ_fn p) ^ 2)
  let a₀_lim : ℂ × ℂ → ℂ := fun p =>
    ExpProfileKind.casesOn kind (Λ_fn p) 0
  let Q_seq : ℕ → ℂ × ℂ → ℝ → ℂ := fun n p w => stripPotential X (s_pt n p) (h_pt n p) w
  let a₀_seq : ℕ → ℂ × ℂ → ℂ := fun n p => h_pt n p * X.f (s_pt n p)
  let a₁_seq : ℕ → ℂ × ℂ → ℂ := fun n p => (h_pt n p) ^ 2 * deriv X.f (s_pt n p)

  have h_step3 : ∃ N₀ : ℕ,
      (∀ n ≥ N₀,
        (∀ p ∈ U₁, s_pt n p ∈ X.D_strip ∧ s_pt n p + h_pt n p ∈ X.D_strip) ∧
        ContinuousOn (fun q : (ℂ × ℂ) × ℝ => Q_seq n q.1 q.2) (U₁ ×ˢ Set.Icc (0 : ℝ) 1) ∧
        (∀ p ∈ U₁, ContinuousOn (Q_seq n p) (Set.Icc (0 : ℝ) 1)) ∧
        (∀ w ∈ Set.Icc (0 : ℝ) 1, DifferentiableOn ℂ (fun p => Q_seq n p w) U₁) ∧
        DifferentiableOn ℂ (a₀_seq n) U₁ ∧
        DifferentiableOn ℂ (a₁_seq n) U₁) ∧
      (∀ ε : ℝ, 0 < ε → ∃ N ≥ N₀, ∀ n ≥ N, ∀ p ∈ U₁, ∀ w ∈ Set.Icc (0 : ℝ) 1,
        ‖Q_seq n p w - q_lim p‖ < ε) ∧
      (∀ ε : ℝ, 0 < ε → ∃ N ≥ N₀, ∀ n ≥ N, ∀ p ∈ U₁,
        ‖a₀_seq n p - a₀_lim p‖ < ε) ∧
      (∀ ε : ℝ, 0 < ε → ∃ N ≥ N₀, ∀ n ≥ N, ∀ p ∈ U₁,
        ‖a₁_seq n p‖ < ε) := by
    let R_exh : ℝ := ‖S₀‖ + ‖H₀‖ + 4
    obtain ⟨N_exh, hN_exh⟩ := seq.exhausts_ℂ R_exh (by positivity)
    obtain ⟨N_b, hN_b⟩ := Filter.tendsto_atTop_atTop.mp seq.b_tendsto (‖H₀‖ + 2)
    let N₀ : ℕ := max N_exh N_b
    let Z_n : ℕ → ℂ × ℂ → ℝ → ℂ := fun n p w => p.1 + (w : ℂ) * p.2 / (b_n n : ℂ)
    have hℓ_ne : ∀ n, (seq.ℓ_seq n : ℂ) ≠ 0 :=
      fun n => Complex.ofReal_ne_zero.mpr (seq.ℓ_pos n).ne'
    have hm_ne : ∀ n, (seq.m_seq n : ℂ) ≠ 0 :=
      fun n => Complex.ofReal_ne_zero.mpr (seq.m_pos n).ne'
    have hb_pos : ∀ n, 0 < b_n n := fun n => mul_pos (seq.ℓ_pos n) (seq.m_pos n)
    have h_seg_eq : ∀ (n : ℕ) (p : ℂ × ℂ) (w : ℝ),
        s_pt n p + (w : ℂ) * h_pt n p = s_n n + (seq.ℓ_seq n : ℂ) * Z_n n p w := by
      intro n p w
      dsimp [s_pt, h_pt, Z_n, b_n]
      push_cast
      have hℓ := hℓ_ne n
      have hm := hm_ne n
      field_simp [hℓ, hm]
      ring
    have h_p2_bound : ∀ p ∈ U₁, ‖p.2‖ ≤ ‖H₀‖ + 1 := by
      intro p hp
      calc ‖p.2‖ = ‖H₀ + (p.2 - H₀)‖ := by ring_nf
        _ ≤ ‖H₀‖ + ‖p.2 - H₀‖ := norm_add_le _ _
        _ ≤ ‖H₀‖ + 1 := by linarith [hp.2]
    have hZ_shift : ∀ n ≥ N₀, ∀ p ∈ U₁, ∀ w ∈ Set.Icc (0 : ℝ) 1,
        ‖Z_n n p w - p.1‖ ≤ (‖H₀‖ + 1) / b_n n ∧
        Z_n n p w ∈ Metric.closedBall S₀ 2 ∧
        s_pt n p + (w : ℂ) * h_pt n p ∈ X.D_strip := by
      intro n hn p hp w ⟨hw0, hw1⟩
      have hn_exh : N_exh ≤ n := le_trans (le_max_left _ _) hn
      have hn_b : N_b ≤ n := le_trans (le_max_right _ _) hn
      have hbn_ge : ‖H₀‖ + 2 ≤ b_n n := hN_b n hn_b
      have hbn_pos : 0 < b_n n := hb_pos n
      have hp2 := h_p2_bound p hp
      have hdiff : ‖Z_n n p w - p.1‖ ≤ (‖H₀‖ + 1) / b_n n := by
        have hsub : Z_n n p w - p.1 = (w : ℂ) * p.2 / (b_n n : ℂ) := by dsimp [Z_n]; ring
        rw [hsub, norm_div, norm_mul, Complex.norm_real, Real.norm_of_nonneg hw0,
          Complex.norm_real, Real.norm_of_nonneg hbn_pos.le]
        refine div_le_div_of_nonneg_right ?_ hbn_pos.le
        calc w * ‖p.2‖ ≤ 1 * (‖H₀‖ + 1) := mul_le_mul hw1 hp2 (norm_nonneg _) zero_le_one
          _ = ‖H₀‖ + 1 := one_mul _
      have hdiff_le1 : (‖H₀‖ + 1) / b_n n ≤ 1 :=
        (div_le_one hbn_pos).mpr (by linarith)
      have hZ_S0 : ‖Z_n n p w - S₀‖ ≤ 2 := by
        calc ‖Z_n n p w - S₀‖ = ‖(p.1 - S₀) + (Z_n n p w - p.1)‖ := by ring_nf
          _ ≤ ‖p.1 - S₀‖ + ‖Z_n n p w - p.1‖ := norm_add_le _ _
          _ ≤ 1 + 1 := by linarith [hp.1, hdiff, hdiff_le1]
          _ = 2 := by norm_num
      have hZ_norm : ‖Z_n n p w‖ ≤ R_exh := by
        calc ‖Z_n n p w‖ = ‖S₀ + (Z_n n p w - S₀)‖ := by ring_nf
          _ ≤ ‖S₀‖ + ‖Z_n n p w - S₀‖ := norm_add_le _ _
          _ ≤ R_exh := by dsimp [R_exh]; linarith [norm_nonneg H₀]
      refine ⟨hdiff, ?_, ?_⟩
      · rw [Metric.mem_closedBall, dist_eq_norm]; exact hZ_S0
      · rw [h_seg_eq]
        exact hN_exh n hn_exh (Z_n n p w) hZ_norm

    refine ⟨N₀, ?_, ?_, ?_, ?_⟩
    · intro n hn
      have hs0 : ∀ p ∈ U₁, s_pt n p ∈ X.D_strip := by
        intro p hp
        simpa using (hZ_shift n hn p hp 0 ⟨le_rfl, zero_le_one⟩).2.2
      have hs1 : ∀ p ∈ U₁, s_pt n p + h_pt n p ∈ X.D_strip := by
        intro p hp
        simpa using (hZ_shift n hn p hp 1 ⟨zero_le_one, le_rfl⟩).2.2
      refine ⟨fun p hp => ⟨hs0 p hp, hs1 p hp⟩, ?_, ?_, ?_, ?_, ?_⟩
      · dsimp [Q_seq, stripPotential]
        refine ContinuousOn.mul (by fun_prop) ?_
        exact hX.q_holo.continuousOn.comp (by dsimp [s_pt, h_pt]; fun_prop)
          (fun q hq => (hZ_shift n hn q.1 hq.1 q.2 hq.2).2.2)
      · intro p hp
        dsimp [Q_seq, stripPotential]
        exact continuousOn_const.mul
          (hX.q_holo.continuousOn.comp (by fun_prop)
            (fun w hw => (hZ_shift n hn p hp w hw).2.2))
      · intro w hw
        dsimp [Q_seq, stripPotential]
        refine DifferentiableOn.mul (by dsimp [h_pt]; fun_prop) ?_
        exact hX.q_holo.comp (by dsimp [s_pt, h_pt]; fun_prop)
          (fun p hp => (hZ_shift n hn p hp w hw).2.2)
      · dsimp [a₀_seq]
        exact DifferentiableOn.mul (by dsimp [h_pt]; fun_prop)
          (hX.f_holo.comp (by dsimp [s_pt]; fun_prop) hs0)
      · dsimp [a₁_seq]
        exact DifferentiableOn.mul (by dsimp [h_pt]; fun_prop)
          ((hX.f_holo.deriv hX.D_strip_open).comp (by dsimp [s_pt]; fun_prop) hs0)

    · 
      intro ε hε
      let K_Z : Set ℂ := Metric.closedBall S₀ 2
      have hK_comp : IsCompact K_Z := isCompact_closedBall S₀ 2
      let Q_tilde : ℕ → ℂ → ℂ := fun n Z =>
        (((seq.m_seq n) ^ 2)⁻¹ : ℂ) * X.q (s_n n + (seq.ℓ_seq n : ℂ) * Z)
      let Q_lim_Z : ℂ → ℂ :=
        ExpProfileKind.casesOn kind (fun _ => 0)
          (fun Z => seq.c₀ ^ 2 * Complex.exp (-2 * Complex.I * Z))
      have hQ_unif : TendstoUniformlyOn Q_tilde Q_lim_Z Filter.atTop K_Z := by
        have hq := tendstoLocallyUniformly_iff_forall_isCompact.mp seq.q_conv K_Z hK_comp
        cases kind <;> exact hq
      have hQ_cont : Continuous Q_lim_Z := by dsimp [Q_lim_Z]; cases kind <;> fun_prop
      have hQ_uc : UniformContinuousOn Q_lim_Z K_Z :=
        hK_comp.uniformContinuousOn_of_continuous hQ_cont.continuousOn
      let M_H : ℝ := (‖H₀‖ + 1) ^ 2 + 1
      have hM_H_pos : 0 < M_H := by positivity
      obtain ⟨δ_uc, hδ_uc_pos, hδ_uc⟩ :=
        Metric.uniformContinuousOn_iff.mp hQ_uc (ε / (2 * M_H)) (by positivity)
      obtain ⟨N_q1, hN_q1⟩ := Filter.eventually_atTop.mp
        (Metric.tendstoUniformlyOn_iff.mp hQ_unif (ε / (2 * M_H)) (by positivity))
      obtain ⟨N_q2, hN_q2⟩ := Filter.tendsto_atTop_atTop.mp seq.b_tendsto
        ((‖H₀‖ + 1) / δ_uc + 1)
      refine ⟨max N₀ (max N_q1 N_q2), le_max_left _ _, ?_⟩
      intro n hn p hp w hw
      have hn0 : N₀ ≤ n := le_trans (le_max_left _ _) hn
      have hn1 : N_q1 ≤ n := le_trans (le_trans (le_max_left _ _) (le_max_right _ _)) hn
      have hn2 : N_q2 ≤ n := le_trans (le_trans (le_max_right _ _) (le_max_right _ _)) hn
      obtain ⟨hZ_dist, hZ_mem, _⟩ := hZ_shift n hn0 p hp w hw
      have hp1_mem : p.1 ∈ K_Z := by
        rw [Metric.mem_closedBall, dist_eq_norm]; linarith [hp.1]
      have h_dist_lt : dist (Z_n n p w) p.1 < δ_uc := by
        rw [dist_eq_norm]
        have hbn_gt : (‖H₀‖ + 1) / δ_uc < b_n n := by linarith [hN_q2 n hn2]
        have hbn_pos : 0 < b_n n := hb_pos n
        have hdiv_lt : (‖H₀‖ + 1) / b_n n < δ_uc := by
          rw [div_lt_iff₀ hbn_pos]
          have := (div_lt_iff₀ hδ_uc_pos).mp hbn_gt
          linarith
        exact lt_of_le_of_lt hZ_dist hdiv_lt
      have h1 : ‖Q_tilde n (Z_n n p w) - Q_lim_Z (Z_n n p w)‖ < ε / (2 * M_H) := by
        have hd := hN_q1 n hn1 (Z_n n p w) hZ_mem
        rwa [dist_comm, dist_eq_norm] at hd
      have h2 : ‖Q_lim_Z (Z_n n p w) - Q_lim_Z p.1‖ < ε / (2 * M_H) := by
        have hd := hδ_uc (Z_n n p w) hZ_mem p.1 hp1_mem h_dist_lt
        rwa [dist_eq_norm] at hd
      have hQ_rew : Q_seq n p w = p.2 ^ 2 * Q_tilde n (Z_n n p w) := by
        dsimp [Q_seq, stripPotential, Q_tilde]
        rw [h_seg_eq]
        dsimp [h_pt]
        have hm := hm_ne n
        field_simp [hm]
      have hqlim_rew : q_lim p = p.2 ^ 2 * Q_lim_Z p.1 := by
        cases kind with
        | firstField => simp [q_lim, Q_lim_Z]
        | secondField =>
          dsimp [q_lim, Q_lim_Z, Λ_fn]
          have hexp2 : Complex.exp (-Complex.I * p.1) ^ 2 =
              Complex.exp (-2 * Complex.I * p.1) := by
            rw [← Complex.exp_nat_mul]; congr 1; push_cast; ring
          calc (p.2 * seq.c₀ * Complex.exp (-Complex.I * p.1)) ^ 2
              = p.2 ^ 2 * seq.c₀ ^ 2 * Complex.exp (-Complex.I * p.1) ^ 2 := by ring
            _ = p.2 ^ 2 * (seq.c₀ ^ 2 * Complex.exp (-2 * Complex.I * p.1)) := by
                rw [hexp2]; ring
      rw [hQ_rew, hqlim_rew, ← mul_sub, norm_mul, norm_pow]
      have hp2_sq : ‖p.2‖ ^ 2 ≤ M_H := by
        have hp2 := h_p2_bound p hp
        have : ‖p.2‖ ^ 2 ≤ (‖H₀‖ + 1) ^ 2 := pow_le_pow_left₀ (norm_nonneg _) hp2 2
        dsimp [M_H]; linarith
      have h_tri : ‖Q_tilde n (Z_n n p w) - Q_lim_Z p.1‖ < ε / M_H := by
        calc ‖Q_tilde n (Z_n n p w) - Q_lim_Z p.1‖
            = ‖(Q_tilde n (Z_n n p w) - Q_lim_Z (Z_n n p w)) +
                (Q_lim_Z (Z_n n p w) - Q_lim_Z p.1)‖ := by ring_nf
          _ ≤ ‖Q_tilde n (Z_n n p w) - Q_lim_Z (Z_n n p w)‖ +
                ‖Q_lim_Z (Z_n n p w) - Q_lim_Z p.1‖ := norm_add_le _ _
          _ < ε / (2 * M_H) + ε / (2 * M_H) := add_lt_add h1 h2
          _ = ε / M_H := by ring
      calc ‖p.2‖ ^ 2 * ‖Q_tilde n (Z_n n p w) - Q_lim_Z p.1‖
          ≤ M_H * ‖Q_tilde n (Z_n n p w) - Q_lim_Z p.1‖ :=
            mul_le_mul_of_nonneg_right hp2_sq (norm_nonneg _)
        _ < M_H * (ε / M_H) := mul_lt_mul_of_pos_left h_tri hM_H_pos
        _ = ε := mul_div_cancel₀ ε hM_H_pos.ne'

    · 
      intro ε hε
      let K_Z : Set ℂ := Metric.closedBall S₀ 2
      let F_tilde : ℕ → ℂ → ℂ := fun n Z =>
        ((seq.m_seq n)⁻¹ : ℂ) * X.f (s_n n + (seq.ℓ_seq n : ℂ) * Z)
      let F_lim_Z : ℂ → ℂ :=
        ExpProfileKind.casesOn kind
          (fun Z => seq.c₀ * Complex.exp (-Complex.I * Z)) (fun _ => 0)
      have hF_unif : TendstoUniformlyOn F_tilde F_lim_Z Filter.atTop K_Z := by
        have hf := tendstoLocallyUniformly_iff_forall_isCompact.mp seq.f_conv K_Z
          (isCompact_closedBall S₀ 2)
        cases kind <;> exact hf
      let M_H1 : ℝ := ‖H₀‖ + 2
      have hM_H1_pos : 0 < M_H1 := by positivity
      obtain ⟨N_f, hN_f⟩ := Filter.eventually_atTop.mp
        (Metric.tendstoUniformlyOn_iff.mp hF_unif (ε / M_H1) (by positivity))
      refine ⟨max N₀ N_f, le_max_left _ _, ?_⟩
      intro n hn p hp
      have hn_f : N_f ≤ n := le_trans (le_max_right _ _) hn
      have hp1_mem : p.1 ∈ K_Z := by
        rw [Metric.mem_closedBall, dist_eq_norm]; linarith [hp.1]
      have hd := hN_f n hn_f p.1 hp1_mem
      rw [dist_comm, dist_eq_norm] at hd
      have ha0_rew : a₀_seq n p = p.2 * F_tilde n p.1 := by
        dsimp [a₀_seq, h_pt, F_tilde, s_pt]
        ring
      have halim_rew : a₀_lim p = p.2 * F_lim_Z p.1 := by
        cases kind <;> simp [a₀_lim, F_lim_Z, Λ_fn, mul_assoc]
      rw [ha0_rew, halim_rew, ← mul_sub, norm_mul]
      have hp2 : ‖p.2‖ ≤ M_H1 := by
        have := h_p2_bound p hp
        dsimp [M_H1]; linarith
      calc ‖p.2‖ * ‖F_tilde n p.1 - F_lim_Z p.1‖
          ≤ M_H1 * ‖F_tilde n p.1 - F_lim_Z p.1‖ :=
            mul_le_mul_of_nonneg_right hp2 (norm_nonneg _)
        _ < M_H1 * (ε / M_H1) := mul_lt_mul_of_pos_left hd hM_H1_pos
        _ = ε := mul_div_cancel₀ ε hM_H1_pos.ne'

    · 
      intro ε hε
      let K_Z : Set ℂ := Metric.closedBall S₀ 2
      let F_tilde : ℕ → ℂ → ℂ := fun n Z =>
        ((seq.m_seq n)⁻¹ : ℂ) * X.f (s_n n + (seq.ℓ_seq n : ℂ) * Z)
      let F_lim_Z : ℂ → ℂ :=
        ExpProfileKind.casesOn kind
          (fun Z => seq.c₀ * Complex.exp (-Complex.I * Z)) (fun _ => 0)
      have hF_unif : TendstoUniformlyOn F_tilde F_lim_Z Filter.atTop K_Z := by
        have hf := tendstoLocallyUniformly_iff_forall_isCompact.mp seq.f_conv K_Z
          (isCompact_closedBall S₀ 2)
        cases kind <;> exact hf
      have hF_cont : Continuous F_lim_Z := by dsimp [F_lim_Z]; cases kind <;> fun_prop
      obtain ⟨M₀, hM₀⟩ :=
        (isCompact_closedBall S₀ 2).exists_bound_of_continuousOn hF_cont.continuousOn
      let M_F : ℝ := max M₀ 0 + 1
      have hM_F_pos : 0 < M_F := by positivity
      obtain ⟨N_f1, hN_f1⟩ := Filter.eventually_atTop.mp
        (Metric.tendstoUniformlyOn_iff.mp hF_unif 1 zero_lt_one)
      let B_num : ℝ := ((‖H₀‖ + 1) ^ 2 + 1) * M_F
      have hB_num_pos : 0 < B_num := by positivity
      obtain ⟨N_b1, hN_b1⟩ := Filter.tendsto_atTop_atTop.mp seq.b_tendsto (B_num / ε + 1)
      refine ⟨max N₀ (max N_f1 N_b1), le_max_left _ _, ?_⟩
      intro n hn p hp
      have hn0 : N₀ ≤ n := le_trans (le_max_left _ _) hn
      have hn_exh : N_exh ≤ n := le_trans (le_max_left _ _) hn0
      have hn_f1 : N_f1 ≤ n := le_trans (le_trans (le_max_left _ _) (le_max_right _ _)) hn
      have hn_b1 : N_b1 ≤ n := le_trans (le_trans (le_max_right _ _) (le_max_right _ _)) hn
      have hF_holo_ball : DifferentiableOn ℂ (F_tilde n) (Metric.ball S₀ 3) := by
        dsimp [F_tilde]
        refine DifferentiableOn.const_mul ?_ _
        refine hX.f_holo.comp (by fun_prop) ?_
        intro Z hZ
        rw [Metric.mem_ball, dist_eq_norm] at hZ
        apply hN_exh n hn_exh Z
        calc ‖Z‖ = ‖S₀ + (Z - S₀)‖ := by ring_nf
          _ ≤ ‖S₀‖ + ‖Z - S₀‖ := norm_add_le _ _
          _ ≤ R_exh := by dsimp [R_exh]; linarith [norm_nonneg H₀]
      have h_cb_sub : Metric.closedBall p.1 1 ⊆ Metric.ball S₀ 3 := by
        intro z hz
        rw [Metric.mem_closedBall, dist_eq_norm] at hz
        rw [Metric.mem_ball, dist_eq_norm]
        calc ‖z - S₀‖ = ‖(z - p.1) + (p.1 - S₀)‖ := by ring_nf
          _ ≤ ‖z - p.1‖ + ‖p.1 - S₀‖ := norm_add_le _ _
          _ < 3 := by linarith [hp.1]
      have h_diff_cont : DiffContOnCl ℂ (F_tilde n) (Metric.ball p.1 1) :=
        hF_holo_ball.diffContOnCl_ball h_cb_sub
      have h_sph_bound : ∀ z ∈ Metric.sphere p.1 1, ‖F_tilde n z‖ ≤ M_F := by
        intro z hz
        rw [Metric.mem_sphere, dist_eq_norm] at hz
        have hz_K : z ∈ K_Z := by
          rw [Metric.mem_closedBall, dist_eq_norm]
          calc ‖z - S₀‖ = ‖(z - p.1) + (p.1 - S₀)‖ := by ring_nf
            _ ≤ ‖z - p.1‖ + ‖p.1 - S₀‖ := norm_add_le _ _
            _ ≤ 2 := by linarith [hp.1]
        have hd := hN_f1 n hn_f1 z hz_K
        rw [dist_comm, dist_eq_norm] at hd
        have hlim_le : ‖F_lim_Z z‖ ≤ M₀ := hM₀ z hz_K
        calc ‖F_tilde n z‖ = ‖F_lim_Z z + (F_tilde n z - F_lim_Z z)‖ := by ring_nf
          _ ≤ ‖F_lim_Z z‖ + ‖F_tilde n z - F_lim_Z z‖ := norm_add_le _ _
          _ ≤ M_F := by dsimp [M_F]; linarith [le_max_left M₀ 0]
      have h_deriv_le : ‖deriv (F_tilde n) p.1‖ ≤ M_F := by
        have hcauchy := Complex.norm_deriv_le_of_forall_mem_sphere_norm_le
          zero_lt_one h_diff_cont h_sph_bound
        simpa using hcauchy
      have hs_mem : s_pt n p ∈ X.D_strip := by
        simpa using (hZ_shift n hn0 p hp 0 ⟨le_rfl, zero_le_one⟩).2.2
      have hf_at : DifferentiableAt ℂ X.f (s_pt n p) :=
        hX.f_holo.differentiableAt (hX.D_strip_open.mem_nhds hs_mem)
      have h_chain : deriv (F_tilde n) p.1 =
          ((seq.m_seq n)⁻¹ : ℂ) * (deriv X.f (s_pt n p) * (seq.ℓ_seq n : ℂ)) := by
        have hg : HasDerivAt (fun Z : ℂ => s_n n + (seq.ℓ_seq n : ℂ) * Z)
