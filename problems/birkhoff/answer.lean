    have huv_b : u_b + v_b = 1 := by
      dsimp only [u_b, v_b]
      field_simp [hb_ne]
      ring
    have him_eq : (r.1 + ((1 : ℤ) : ℂ) * r.2).im =
        u_b * r.1.im + v_b * (r.1 + (b : ℂ) * r.2).im := by
      dsimp only [u_b, v_b]
      simp only [Int.cast_one, one_mul, Complex.add_im, Complex.mul_im,
        Complex.natCast_re, Complex.natCast_im, zero_mul, add_zero]
      field_simp [hb_ne]
      ring
    rw [him_eq]
    exact h_lin_lt _ _ (2 * hDet.s_det) hr2 hr3 u_b v_b hu_b hv_b huv_b
  have hJet_holo_V : ∀ (M : ℕ) (v : LineJetVar M),
      DifferentiableOn ℂ
        (fun p => lineJetEnv M (dualLineShift C 0) (dualLineShift C (b : ℤ)) p v) V_det := by
    intro M v
    by_cases hv : v.1 = 0 <;> simp only [lineJetEnv, hv, ↓reduceIte]
    · exact hKit.iterDerivYT_holo hV_det_open (hL0_holo v.2.1) v.2.2.1.1 v.2.2.2.1
    · exact hKit.iterDerivYT_holo hV_det_open (hLb_holo v.2.1) v.2.2.1.1 v.2.2.2.1
  have hEval_holo_V : ∀ (M : ℕ) (P : MvPolynomial (LineJetVar M) ℂ),
      DifferentiableOn ℂ
        (fun p => MvPolynomial.eval
          (lineJetEnv M (dualLineShift C 0) (dualLineShift C (b : ℤ)) p) P)
        V_det := by
    intro M P
    refine MvPolynomial.induction_on
      (motive := fun Q_p => DifferentiableOn ℂ
        (fun p => MvPolynomial.eval
          (lineJetEnv M (dualLineShift C 0) (dualLineShift C (b : ℤ)) p) Q_p)
        V_det)
      P
      (fun c => by
        simpa only [MvPolynomial.eval_C] using
          (differentiableOn_const c : DifferentiableOn ℂ _ V_det))
      (fun P₁ P₂ ih₁ ih₂ => by
        have hfn :
            (fun p => MvPolynomial.eval
              (lineJetEnv M (dualLineShift C 0) (dualLineShift C (b : ℤ)) p) (P₁ + P₂)) =
            (fun p => MvPolynomial.eval
              (lineJetEnv M (dualLineShift C 0) (dualLineShift C (b : ℤ)) p) P₁ +
              MvPolynomial.eval
                (lineJetEnv M (dualLineShift C 0) (dualLineShift C (b : ℤ)) p) P₂) := by
          ext p; exact map_add _ P₁ P₂
        rw [hfn]
        exact ih₁.add ih₂)
      (fun P₁ v ih => by
        have hfn :
            (fun p => MvPolynomial.eval
              (lineJetEnv M (dualLineShift C 0) (dualLineShift C (b : ℤ)) p)
              (P₁ * MvPolynomial.X v)) =
            (fun p => MvPolynomial.eval
              (lineJetEnv M (dualLineShift C 0) (dualLineShift C (b : ℤ)) p) P₁ *
              lineJetEnv M (dualLineShift C 0) (dualLineShift C (b : ℤ)) p v) := by
          ext p; simp only [map_mul, MvPolynomial.eval_X]
        rw [hfn]
        exact ih.mul (hJet_holo_V M v))
  have hA_holo_V : ∀ ι d, DifferentiableOn ℂ (A_coeff ι d) V_det :=
    fun ι d => hEval_holo_V (M_det ι) (Q_det ι d)
  have hΔ_holo_V : ∀ ι, DifferentiableOn ℂ (Δ_base ι) V_det :=
    fun ι => hEval_holo_V (M_det ι) (Disc_det ι)
  let Φ_solves : Fin 2 → ℂ × ℂ → ℂ := fun ι p =>
    ∑ d : Fin (D_det ι + 1), A_coeff ι d p * (dualLineShift C 1 ι p) ^ (d : ℕ)
  have hΦ_holo_V : ∀ ι : Fin 2, DifferentiableOn ℂ (Φ_solves ι) V_det := by
    intro ι
    have h_sum : ∀ s : Finset (Fin (D_det ι + 1)),
        DifferentiableOn ℂ
          (fun p => ∑ d ∈ s, A_coeff ι d p * (dualLineShift C 1 ι p) ^ (d : ℕ)) V_det := by
      intro s
      induction s using Finset.induction_on with
      | empty =>
        simpa only [Finset.sum_empty] using (differentiableOn_const (0 : ℂ))
      | @insert d s hd ih =>
        have h_fn :
            (fun p => ∑ j ∈ insert d s, A_coeff ι j p * (dualLineShift C 1 ι p) ^ (j : ℕ)) =
            (fun p => A_coeff ι d p * (dualLineShift C 1 ι p) ^ (d : ℕ) +
              ∑ j ∈ s, A_coeff ι j p * (dualLineShift C 1 ι p) ^ (j : ℕ)) := by
          ext p; exact Finset.sum_insert hd
        rw [h_fn]
        exact ((hA_holo_V ι d).mul (h_pow_holo (hL1_holo ι) (d : ℕ))).add ih
    exact h_sum Finset.univ
  let U_small : Set (ℂ × ℂ) :=
    { p : ℂ × ℂ | |p.1.im| < hDet.s_det ∧ ‖p.2‖ < hDet.r_det / (b : ℝ) }
  have hU_small_open : IsOpen U_small :=
    (isOpen_lt (continuous_abs.comp (Complex.continuous_im.comp continuous_fst))
      continuous_const).inter
      (isOpen_lt (continuous_norm.comp continuous_snd) continuous_const)
  have hU_small_ne : U_small.Nonempty :=
    ⟨((0 : ℂ), (0 : ℂ)), by simp [U_small, hDet.s_det_pos, div_pos hDet.r_det_pos hb_pos]⟩
  have hU_small_sub : U_small ⊆ V_det := by
    intro p ⟨hp1, hp2⟩
    have hp2_mul : ‖p.2‖ * (b : ℝ) < hDet.r_det := (lt_div_iff₀ hb_pos).mp hp2
    have h2_le : 2 * ‖p.2‖ ≤ ‖p.2‖ * (b : ℝ) := by nlinarith [norm_nonneg p.2]
    have him_b : |(p.1 + (b : ℂ) * p.2).im| ≤ |p.1.im| + ‖p.2‖ * (b : ℝ) := by
      have him_eq : (p.1 + (b : ℂ) * p.2).im = p.1.im + (b : ℝ) * p.2.im := by
        simp [Complex.add_im, Complex.mul_im]
      rw [him_eq]
      calc |p.1.im + (b : ℝ) * p.2.im|
          ≤ |p.1.im| + |(b : ℝ) * p.2.im| := abs_add_le _ _
        _ = |p.1.im| + (b : ℝ) * |p.2.im| := by rw [abs_mul, abs_of_pos hb_pos]
        _ ≤ |p.1.im| + (b : ℝ) * ‖p.2‖ := by
            gcongr; exact Complex.abs_im_le_norm p.2
        _ = |p.1.im| + ‖p.2‖ * (b : ℝ) := by ring
    exact ⟨by linarith [hDet.r_det_pos], by linarith [hDet.s_det_pos],
      by linarith [hDet.r_det_lt_s_det, hDet.s_det_pos]⟩
  let S_all : ℕ := (wallAllShifts K q_idx).sup (fun q : ℤ => q.natAbs)
  have hJ_all_eq : wallAllJBound K q_idx = (S_all : ℝ) + 2 := rfl
  have hb_mem_all : (b : ℤ) ∈ wallAllShifts K q_idx := by
    refine Finset.mem_insert_of_mem (Finset.mem_union_left _ ?_)
    simp [b]
  have hb_le_S : b ≤ S_all := by
    have h := Finset.le_sup (f := fun q : ℤ => q.natAbs) hb_mem_all
    simpa only [Int.natAbs_natCast] using h
  have hb_le_J : (b : ℝ) ≤ wallAllJBound K q_idx := by
    have hcast : (b : ℝ) ≤ (S_all : ℝ) := Nat.cast_le.mpr hb_le_S
    linarith [hJ_all_eq]
  have hJ_all_pos : 0 < wallAllJBound K q_idx := by linarith [hb_pos, hb_le_J]
  have h2J_all_pos : 0 < 2 * wallAllJBound K q_idx := by linarith
  let U_uni : Set (ℂ × ℂ) := wallUnifiedDom W.s_base W.r_base K q_idx
  have hU_uni_open : IsOpen U_uni := by
    refine IsOpen.inter ?_ (IsOpen.inter ?_ ?_)
    · exact isOpen_lt (continuous_abs.comp (Complex.continuous_im.comp continuous_fst))
        continuous_const
    · exact isOpen_lt (continuous_norm.comp continuous_snd) continuous_const
    · exact isOpen_lt (continuous_abs.comp (Complex.continuous_im.comp continuous_snd))
        continuous_const
  have hU_uni_ne : U_uni.Nonempty := by
    refine ⟨((0 : ℂ), (0 : ℂ)), ?_, ?_, ?_⟩
    · simp only [Complex.zero_im, abs_zero]; linarith [W.s_base_pos]
    · simpa only [norm_zero] using W.r_base_pos
    · simp only [Complex.zero_im, abs_zero]; exact div_pos W.s_base_pos h2J_all_pos
  have hU_uni_sub : U_uni ⊆ V_det := by
    intro p ⟨hp1, hp2, hp3⟩
    have hp3_mul : |p.2.im| * (2 * wallAllJBound K q_idx) < W.s_base :=
      (lt_div_iff₀ h2J_all_pos).mp hp3
    have hb_im : (b : ℝ) * |p.2.im| < W.s_base / 2 := by
      have hle : 2 * ((b : ℝ) * |p.2.im|) ≤ |p.2.im| * (2 * wallAllJBound K q_idx) := by
        nlinarith [abs_nonneg p.2.im, hb_le_J]
      linarith
    have him_b : |(p.1 + (b : ℂ) * p.2).im| ≤ |p.1.im| + (b : ℝ) * |p.2.im| := by
      have him_eq : (p.1 + (b : ℂ) * p.2).im = p.1.im + (b : ℝ) * p.2.im := by
        simp [Complex.add_im, Complex.mul_im]
      rw [him_eq]
      simpa only [abs_mul, abs_of_pos hb_pos] using abs_add_le p.1.im ((b : ℝ) * p.2.im)
    exact ⟨by linarith [W.r_base_le_det, hDet.r_det_pos],
      by linarith [W.s_base_le_det, hDet.s_det_pos],
      by linarith [W.s_base_le_det, hDet.s_det_pos]⟩
  have hΦ_small : ∀ ι : Fin 2, ∀ p ∈ U_small, Φ_solves ι p = 0 := by
    intro ι p ⟨hp1, hp2⟩
    have h_raw := (h_det_props ι).1 p.1 p.2 hp1 hp2
    dsimp only [Φ_solves, A_coeff]
    rw [h_shift0, h_shiftb]
    simpa only [h_shift1 p.1 p.2 ι, Prod.mk.eta] using h_raw
  have hΦ_uni : ∀ ι : Fin 2, ∀ p ∈ U_uni, Φ_solves ι p = 0 :=
    fun ι p hp =>
      hKit.eqOn_zero_of_preconnected_2D hV_det_open hV_det_preconn
        hU_small_open hU_small_ne hU_small_sub (hΦ_holo_V ι) (hΦ_small ι) p (hU_uni_sub hp)
  let DenseNZ : (ℂ × ℂ → ℂ) → Prop :=
    fun f => ∀ O : Set (ℂ × ℂ), IsOpen O → O.Nonempty → O ⊆ V_det → ∃ p ∈ O, f p ≠ 0
  have h_dense_of_wit : ∀ {f : ℂ × ℂ → ℂ},
      DifferentiableOn ℂ f V_det → (∃ p₀ ∈ V_det, f p₀ ≠ 0) → DenseNZ f := by
    intro f hf ⟨p₀, hp₀, hfp₀⟩ O hO hOne hOsub
    by_contra h_zero
    push Not at h_zero
    exact hfp₀ (hKit.eqOn_zero_of_preconnected_2D hV_det_open hV_det_preconn
      hO hOne hOsub hf h_zero p₀ hp₀)
  have h_dense_mul : ∀ {f g : ℂ × ℂ → ℂ},
      ContinuousOn f V_det → DenseNZ f → DenseNZ g → DenseNZ (fun p => f p * g p) := by
    intro f g hf_cont hdf hdg O hO hOne hOsub
    obtain ⟨p₁, hp₁, hfp₁⟩ := hdf O hO hOne hOsub
    have hf_at : ContinuousAt f p₁ :=
      hf_cont.continuousAt (hV_det_open.mem_nhds (hOsub hp₁))
    obtain ⟨δ, hδ_pos, hball⟩ :=
      Metric.mem_nhds_iff.mp
        (Filter.inter_mem (hO.mem_nhds hp₁) (hf_at.eventually_ne hfp₁))
    obtain ⟨p₂, hp₂, hgp₂⟩ :=
      hdg (Metric.ball p₁ δ) Metric.isOpen_ball (Metric.nonempty_ball.mpr hδ_pos)
        (fun q hq => hOsub (hball hq).1)
    exact ⟨p₂, (hball hp₂).1, mul_ne_zero (hball hp₂).2 hgp₂⟩
  have hA_dense : ∀ ι : Fin 2, DenseNZ (A_coeff ι (Fin.last (D_det ι))) := by
    intro ι
    obtain ⟨y, t, hy, ht, hQ_nz, _⟩ := (h_det_props ι).2.1
    refine h_dense_of_wit (hA_holo_V ι (Fin.last (D_det ι))) ⟨(y, t), hU_small_sub ⟨hy, ht⟩, ?_⟩
    dsimp only [A_coeff]
    rw [h_shift0, h_shiftb]
    exact hQ_nz
  have hΔ_dense : ∀ ι : Fin 2, DenseNZ (Δ_base ι) := by
    intro ι
    obtain ⟨y, t, hy, ht, _, hD_nz⟩ := (h_det_props ι).2.1
    refine h_dense_of_wit (hΔ_holo_V ι) ⟨(y, t), hU_small_sub ⟨hy, ht⟩, ?_⟩
    dsimp only [Δ_base]
    rw [h_shift0, h_shiftb]
    exact hD_nz
  let H_base : ℂ × ℂ → ℂ := fun p =>
    A_coeff 0 (Fin.last (D_det 0)) p * Δ_base 0 p *
      A_coeff 1 (Fin.last (D_det 1)) p * Δ_base 1 p
  have hH_base_holo_V : DifferentiableOn ℂ H_base V_det :=
    (((hA_holo_V 0 (Fin.last (D_det 0))).mul (hΔ_holo_V 0)).mul
      (hA_holo_V 1 (Fin.last (D_det 1)))).mul (hΔ_holo_V 1)
  have hH_base_dense : DenseNZ H_base := by
    have h01 : DenseNZ (fun p => A_coeff 0 (Fin.last (D_det 0)) p * Δ_base 0 p) :=
      h_dense_mul (hA_holo_V 0 (Fin.last (D_det 0))).continuousOn (hA_dense 0) (hΔ_dense 0)
    have h012 : DenseNZ (fun p => A_coeff 0 (Fin.last (D_det 0)) p * Δ_base 0 p *
        A_coeff 1 (Fin.last (D_det 1)) p) :=
      h_dense_mul
        ((hA_holo_V 0 (Fin.last (D_det 0))).continuousOn.mul (hΔ_holo_V 0).continuousOn)
        h01 (hA_dense 1)
    exact h_dense_mul
      (((hA_holo_V 0 (Fin.last (D_det 0))).continuousOn.mul (hΔ_holo_V 0).continuousOn).mul
        (hA_holo_V 1 (Fin.last (D_det 1))).continuousOn)
      h012 (hΔ_dense 1)
  let r₀ : ℝ :=
    min (W.s_base / 4) (min (W.r_base / 2) (W.s_base / (4 * wallAllJBound K q_idx)))
  have hr₀_pos : 0 < r₀ :=
    lt_min (by linarith [W.s_base_pos])
      (lt_min (by linarith [W.r_base_pos]) (div_pos W.s_base_pos (by linarith)))
  let B_orig : Set (ℂ × ℂ) := Metric.ball (0 : ℂ) r₀ ×ˢ Metric.ball (0 : ℂ) r₀
  have hB_orig_sub_uni : B_orig ⊆ U_uni := by
    intro p ⟨hp1, hp2⟩
    rw [Metric.mem_ball, dist_zero_right] at hp1 hp2
    have hr₀_1 : r₀ ≤ W.s_base / 4 := min_le_left _ _
    have hr₀_2 : r₀ ≤ W.r_base / 2 := le_trans (min_le_right _ _) (min_le_left _ _)
    have hr₀_3 : r₀ ≤ W.s_base / (4 * wallAllJBound K q_idx) :=
      le_trans (min_le_right _ _) (min_le_right _ _)
    have him1 : |p.1.im| ≤ ‖p.1‖ := Complex.abs_im_le_norm p.1
    have him2 : |p.2.im| ≤ ‖p.2‖ := Complex.abs_im_le_norm p.2
    have h_div_lt :
        W.s_base / (4 * wallAllJBound K q_idx) < W.s_base / (2 * wallAllJBound K q_idx) :=
      div_lt_div_of_pos_left W.s_base_pos h2J_all_pos (by linarith)
    exact ⟨by linarith [W.s_base_pos], by linarith [W.r_base_pos], by linarith⟩
  have hH_base_nz_orig : ∃ p ∈ B_orig, H_base p ≠ 0 :=
    hH_base_dense B_orig (Metric.isOpen_ball.prod Metric.isOpen_ball)
      ⟨((0 : ℂ), (0 : ℂ)), Metric.mem_ball_self hr₀_pos, Metric.mem_ball_self hr₀_pos⟩
      (Set.Subset.trans hB_orig_sub_uni hU_uni_sub)
  obtain ⟨y₀, r_y, r_t, m_t, H_tilde, hr_y_pos, hr_t_pos, h_bi_sub_orig,
      hH_tilde_bi_holo, hH_tilde_bi_nz, hH_bi_factor⟩ :=
    h_s2 r₀ hr₀_pos H_base (hH_base_holo_V.mono (Set.Subset.trans hB_orig_sub_uni hU_uni_sub))
      hH_base_nz_orig
  refine ⟨{
    M_det := M_det
    D_det := D_det
    D_det_pos := D_det_pos
    Q_det := Q_det
    Disc_det := Disc_det
    A_coeff := A_coeff
    Δ_base := Δ_base
    A_coeff_def := fun _ _ _ => rfl
    Δ_base_def := fun _ _ => rfl
    univ_separable := fun ι env z hlead hdisc hroot =>
      (h_det_props ι).2.2 env z hlead hdisc hroot
    base_coeff_holo := fun ι d => (hA_holo_V ι d).mono hU_uni_sub
    base_disc_holo := fun ι => (hΔ_holo_V ι).mono hU_uni_sub
    base_lead_witness := fun ι => hA_dense ι U_uni hU_uni_open hU_uni_ne hU_uni_sub
    base_disc_witness := fun ι => hΔ_dense ι U_uni hU_uni_open hU_uni_ne hU_uni_sub
    base_primary_solves := hΦ_uni
    y₀ := y₀
    r_y := r_y
    r_t := r_t
    t_end := r_t / 2
    m_t := m_t
    H_tilde := H_tilde
    r_y_pos := hr_y_pos
    r_t_pos := hr_t_pos
    t_end_pos := by linarith [hr_t_pos]
    t_end_lt := by linarith [hr_t_pos]
    bidisk_sub_unified := Set.Subset.trans h_bi_sub_orig hB_orig_sub_uni
    H_tilde_holo := hH_tilde_bi_holo
    H_tilde_ne_zero := hH_tilde_bi_nz
    H_base_factor := hH_bi_factor
    separable_punc := fun ι p ⟨hp1, hp2_ball, hp2_ne⟩ => by
      have hp_bi : p ∈ Metric.ball (y₀ : ℂ) r_y ×ˢ Metric.ball (0 : ℂ) r_t := ⟨hp1, hp2_ball⟩
      have hp2_ne' : p.2 ≠ 0 := hp2_ne
      have hprod_nz :
          A_coeff 0 (Fin.last (D_det 0)) p * Δ_base 0 p *
            A_coeff 1 (Fin.last (D_det 1)) p * Δ_base 1 p ≠ 0 := by
        change H_base p ≠ 0
        rw [← hH_bi_factor p hp_bi]
        exact mul_ne_zero (pow_ne_zero m_t hp2_ne') (hH_tilde_bi_nz p hp_bi)
      have h012_nz :
          A_coeff 0 (Fin.last (D_det 0)) p * Δ_base 0 p *
            A_coeff 1 (Fin.last (D_det 1)) p ≠ 0 := left_ne_zero_of_mul hprod_nz
      have hΔ1_nz : Δ_base 1 p ≠ 0 := right_ne_zero_of_mul hprod_nz
      have h01_nz : A_coeff 0 (Fin.last (D_det 0)) p * Δ_base 0 p ≠ 0 :=
        left_ne_zero_of_mul h012_nz
      have hA1_nz : A_coeff 1 (Fin.last (D_det 1)) p ≠ 0 := right_ne_zero_of_mul h012_nz
      have hA0_nz : A_coeff 0 (Fin.last (D_det 0)) p ≠ 0 := left_ne_zero_of_mul h01_nz
      have hΔ0_nz : Δ_base 0 p ≠ 0 := right_ne_zero_of_mul h01_nz
      fin_cases ι
      · exact ⟨hA0_nz, fun z hz => (h_det_props 0).2.2 _ z hA0_nz hΔ0_nz hz⟩
      · exact ⟨hA1_nz, fun z hz => (h_det_props 1).2.2 _ z hA1_nz hΔ1_nz hz⟩
    clear_pair := h_s3 M_det D_det Q_det Disc_det
  }⟩

theorem wall_loop_top_branch_and_monodromy_transfer (Ω : Set Plane)
    (C : AnalyticGlancingCollar Ω)
    (hDet : EndpointDeterminationData C)
    (W : CollarWidthTubeData C hDet)
    (hKit : Holo2DAndTaylorToolkit)
    (t₂ : ℝ)
    (D_wall : AlignedWallDefectData W t₂)
    (N_idx : ℕ)
    (q_idx : Fin N_idx → ℤ)
    (hq_unaligned : ∀ a : Fin N_idx, q_idx a ≤ 0 ∨ D_wall.K < (q_idx a).natAbs)
    (K_cont : ZeroAvoidingRootContKit) :
    Nonempty (WallLoopTopBranchData W t₂ D_wall q_idx) :=
by
  
  
  
  have hSum_holo : ∀ {α : Type} (s : Finset α) {U : Set (ℂ × ℂ)} (f : α → ℂ × ℂ → ℂ),
      (∀ i ∈ s, DifferentiableOn ℂ (f i) U) →
      DifferentiableOn ℂ (fun p => ∑ i ∈ s, f i p) U := by
    intro α s U f hf
    classical
    induction s using Finset.induction_on with
    | empty =>
      simpa only [Finset.sum_empty] using
        (differentiableOn_const (0 : ℂ) : DifferentiableOn ℂ (fun _ : ℂ × ℂ => (0 : ℂ)) U)
    | @insert a s ha ih =>
      have hfn : (fun p => ∑ i ∈ insert a s, f i p) = (fun p => f a p + ∑ i ∈ s, f i p) := by
        ext p; exact Finset.sum_insert ha
      rw [hfn]
      exact (hf a (Finset.mem_insert_self a s)).add
        (ih (fun i hi => hf i (Finset.mem_insert_of_mem hi)))
  have hProd_holo : ∀ {α : Type} (s : Finset α) {U : Set (ℂ × ℂ)} (f : α → ℂ × ℂ → ℂ),
      (∀ i ∈ s, DifferentiableOn ℂ (f i) U) →
      DifferentiableOn ℂ (fun p => ∏ i ∈ s, f i p) U := by
    intro α s U f hf
    classical
    induction s using Finset.induction_on with
    | empty =>
      simpa only [Finset.prod_empty] using
        (differentiableOn_const (1 : ℂ) : DifferentiableOn ℂ (fun _ : ℂ × ℂ => (1 : ℂ)) U)
    | @insert a s ha ih =>
      have hfn : (fun p => ∏ i ∈ insert a s, f i p) = (fun p => f a p * ∏ i ∈ s, f i p) := by
        ext p; exact Finset.prod_insert ha
      rw [hfn]
      exact (hf a (Finset.mem_insert_self a s)).mul
        (ih (fun i hi => hf i (Finset.mem_insert_of_mem hi)))
  have hExists_nz_open : ∀ {U V : Set (ℂ × ℂ)} {f : ℂ × ℂ → ℂ},
      IsOpen U → IsPreconnected U → IsOpen V → V.Nonempty → V ⊆ U →
      DifferentiableOn ℂ f U → (∃ p ∈ U, f p ≠ 0) →
      ∃ q ∈ V, f q ≠ 0 := by
    intro U V f hU_op hU_pr hV_op hV_ne hV_sub hf_holo ⟨p₀, hp₀_mem, hp₀_nz⟩
    by_contra h_all
    have h_zero : ∀ q ∈ V, f q = 0 :=
      fun q hq => not_ne_iff.mp (fun hne => h_all ⟨q, hq, hne⟩)
    exact hp₀_nz (hKit.eqOn_zero_of_preconnected_2D hU_op hU_pr hV_op hV_ne hV_sub
      hf_holo h_zero p₀ hp₀_mem)
  have hProd_nz : ∀ {α : Type} (s : Finset α) {U : Set (ℂ × ℂ)} (f : α → ℂ × ℂ → ℂ),
      IsOpen U → IsPreconnected U → U.Nonempty →
      (∀ i ∈ s, DifferentiableOn ℂ (f i) U ∧ ∃ p ∈ U, f i p ≠ 0) →
      ∃ p ∈ U, (∏ i ∈ s, f i p) ≠ 0 := by
    intro α s U f hU_op hU_pr hU_ne hf
    classical
    induction s using Finset.induction_on with
    | empty =>
      obtain ⟨p₀, hp₀⟩ := hU_ne
      exact ⟨p₀, hp₀, by simp⟩
    | @insert a s ha ih =>
      have h_s_holo : DifferentiableOn ℂ (fun p => ∏ i ∈ s, f i p) U :=
        hProd_holo s f (fun i hi => (hf i (Finset.mem_insert_of_mem hi)).1)
      have h_s_nz : ∃ p ∈ U, (∏ i ∈ s, f i p) ≠ 0 :=
        ih (fun i hi => hf i (Finset.mem_insert_of_mem hi))
      obtain ⟨ha_holo, pa, hpa_mem, hpa_nz⟩ := hf a (Finset.mem_insert_self a s)
      let Va : Set (ℂ × ℂ) := U ∩ (f a) ⁻¹' ({0}ᶜ)
      have hVa_op : IsOpen Va :=
        ha_holo.continuousOn.isOpen_inter_preimage hU_op isOpen_compl_singleton
      have hVa_ne : Va.Nonempty := ⟨pa, hpa_mem, hpa_nz⟩
      obtain ⟨q, hq_Va, hq_prod⟩ :=
        hExists_nz_open hU_op hU_pr hVa_op hVa_ne Set.inter_subset_left h_s_holo h_s_nz
      refine ⟨q, hq_Va.1, ?_⟩
      rw [Finset.prod_insert ha]
      exact mul_ne_zero hq_Va.2 hq_prod
  have hMero_cont : ∀ {W₁ W₂ : Set (ℂ × ℂ)} (F₁ : MeroOn2D W₁) (F₂ : MeroOn2D W₂)
      {U V : Set (ℂ × ℂ)},
      IsOpen U → IsPreconnected U → U ⊆ W₁ ∩ W₂ →
      IsOpen V → V.Nonempty → V ⊆ U →
      MeroEqOn F₁ F₂ V → MeroEqOn F₁ F₂ U := by
    intro W₁ W₂ F₁ F₂ U V hU_op hU_pr hU_sub hV_op hV_ne hV_sub hEqV
    refine ⟨hU_sub, ?_⟩
    let R : ℂ × ℂ → ℝ := fun p => min (F₁.rad p) (F₂.rad p)
    have hR_pos : ∀ p ∈ U, 0 < R p := fun p hp =>
      lt_min (F₁.rad_pos p (hU_sub hp).1) (F₂.rad_pos p (hU_sub hp).2)
    let S : Set (ℂ × ℂ) :=
      { p ∈ U | ∀ z ∈ Metric.ball p (R p),
          F₁.num p z * F₂.den p z = F₂.num p z * F₁.den p z }
    have h_transfer : ∀ p₁ ∈ S, ∀ p₂ ∈ U,
        (Metric.ball p₁ (R p₁) ∩ Metric.ball p₂ (R p₂)).Nonempty → p₂ ∈ S := by
      intro p₁ hp₁ p₂ hp₂ hO_ne
      let O := Metric.ball p₁ (R p₁) ∩ Metric.ball p₂ (R p₂)
      have hO_op : IsOpen O := Metric.isOpen_ball.inter Metric.isOpen_ball
      have hO_sub1 : O ⊆ Metric.ball p₁ (F₁.rad p₁) := fun z hz =>
        Metric.ball_subset_ball (min_le_left _ _) hz.1
      have hO_sub2 : O ⊆ Metric.ball p₁ (F₂.rad p₁) := fun z hz =>
        Metric.ball_subset_ball (min_le_right _ _) hz.1
      obtain ⟨z₁, hz₁_O, hz₁_nz⟩ := hExists_nz_open Metric.isOpen_ball
        (convex_ball p₁ (F₁.rad p₁)).isPreconnected hO_op hO_ne hO_sub1
        (F₁.den_holo p₁ (hU_sub hp₁.1).1) (F₁.den_ne_zero p₁ (hU_sub hp₁.1).1)
      let O₁ : Set (ℂ × ℂ) := O ∩ (F₁.den p₁) ⁻¹' ({0}ᶜ)
      have hO₁_op : IsOpen O₁ :=
        ((F₁.den_holo p₁ (hU_sub hp₁.1).1).mono hO_sub1).continuousOn.isOpen_inter_preimage
          hO_op isOpen_compl_singleton
      have hO₁_ne : O₁.Nonempty := ⟨z₁, hz₁_O, hz₁_nz⟩
      obtain ⟨z₂, hz₂_O₁, hz₂_nz⟩ := hExists_nz_open Metric.isOpen_ball
        (convex_ball p₁ (F₂.rad p₁)).isPreconnected hO₁_op hO₁_ne
        (Set.Subset.trans Set.inter_subset_left hO_sub2)
        (F₂.den_holo p₁ (hU_sub hp₁.1).2) (F₂.den_ne_zero p₁ (hU_sub hp₁.1).2)
      let O₂ : Set (ℂ × ℂ) := O₁ ∩ (F₂.den p₁) ⁻¹' ({0}ᶜ)
      have hO₂_op : IsOpen O₂ :=
        ((F₂.den_holo p₁ (hU_sub hp₁.1).2).mono
          (Set.Subset.trans Set.inter_subset_left hO_sub2)).continuousOn.isOpen_inter_preimage
          hO₁_op isOpen_compl_singleton
      have hO₂_ne : O₂.Nonempty := ⟨z₂, hz₂_O₁, hz₂_nz⟩
      have hO₂_sub_p₂ : O₂ ⊆ Metric.ball p₂ (R p₂) := fun z hz => hz.1.1.2
      have h_diff_holo : DifferentiableOn ℂ
          (fun z => F₁.num p₂ z * F₂.den p₂ z - F₂.num p₂ z * F₁.den p₂ z)
          (Metric.ball p₂ (R p₂)) :=
        (((F₁.num_holo p₂ (hU_sub hp₂).1).mono (Metric.ball_subset_ball (min_le_left _ _))).mul
          ((F₂.den_holo p₂ (hU_sub hp₂).2).mono (Metric.ball_subset_ball (min_le_right _ _)))).sub
        (((F₂.num_holo p₂ (hU_sub hp₂).2).mono (Metric.ball_subset_ball (min_le_right _ _))).mul
          ((F₁.den_holo p₂ (hU_sub hp₂).1).mono (Metric.ball_subset_ball (min_le_left _ _))))
      have h_diff_zero_O₂ : ∀ z ∈ O₂,
          F₁.num p₂ z * F₂.den p₂ z - F₂.num p₂ z * F₁.den p₂ z = 0 := by
        intro z hz
        have hz_O : z ∈ O := hz.1.1
        have hd₁ : F₁.den p₁ z ≠ 0 := hz.1.2
        have hd₂ : F₂.den p₁ z ≠ 0 := hz.2
        have hc₁ := F₁.compat p₁ (hU_sub hp₁.1).1 p₂ (hU_sub hp₂).1 z
          ⟨Metric.ball_subset_ball (min_le_left _ _) hz_O.1,
           Metric.ball_subset_ball (min_le_left _ _) hz_O.2⟩
        have hc₂ := F₂.compat p₁ (hU_sub hp₁.1).2 p₂ (hU_sub hp₂).2 z
          ⟨Metric.ball_subset_ball (min_le_right _ _) hz_O.1,
           Metric.ball_subset_ball (min_le_right _ _) hz_O.2⟩
        have hS₁ := hp₁.2 z hz_O.1
        have h_prod_zero :
            (F₁.num p₂ z * F₂.den p₂ z - F₂.num p₂ z * F₁.den p₂ z) *
              (F₁.den p₁ z * F₂.den p₁ z) = 0 := by
          calc (F₁.num p₂ z * F₂.den p₂ z - F₂.num p₂ z * F₁.den p₂ z) *
                (F₁.den p₁ z * F₂.den p₁ z)
              = (F₁.num p₂ z * F₁.den p₁ z) * (F₂.den p₂ z * F₂.den p₁ z) -
                (F₂.num p₂ z * F₂.den p₁ z) * (F₁.den p₂ z * F₁.den p₁ z) := by ring
            _ = (F₁.num p₁ z * F₁.den p₂ z) * (F₂.den p₂ z * F₂.den p₁ z) -
                (F₂.num p₁ z * F₂.den p₂ z) * (F₁.den p₂ z * F₁.den p₁ z) := by rw [← hc₁, ← hc₂]
            _ = (F₁.num p₁ z * F₂.den p₁ z - F₂.num p₁ z * F₁.den p₁ z) *
                (F₁.den p₂ z * F₂.den p₂ z) := by ring
            _ = 0 := by rw [sub_eq_zero.mpr hS₁, zero_mul]
        exact (mul_eq_zero.mp h_prod_zero).resolve_right (mul_ne_zero hd₁ hd₂)
      have h_all := hKit.eqOn_zero_of_preconnected_2D Metric.isOpen_ball
        (convex_ball p₂ (R p₂)).isPreconnected hO₂_op hO₂_ne hO₂_sub_p₂
        h_diff_holo h_diff_zero_O₂
      exact ⟨hp₂, fun z hz => sub_eq_zero.mp (h_all z hz)⟩
    intro p hp z hz
    have hp_S : p ∈ S := by
      by_contra hp_not
      let u_open : Set (ℂ × ℂ) := ⋃ q ∈ S, Metric.ball q (R q)
      let v_open : Set (ℂ × ℂ) := ⋃ q ∈ U \ S, Metric.ball q (R q)
      have hu_op : IsOpen u_open := isOpen_biUnion (fun _ _ => Metric.isOpen_ball)
      have hv_op : IsOpen v_open := isOpen_biUnion (fun _ _ => Metric.isOpen_ball)
      have h_cov : U ⊆ u_open ∪ v_open := by
        intro q hq
        by_cases hqS : q ∈ S
        · exact Or.inl (Set.mem_biUnion hqS (Metric.mem_ball_self (hR_pos q hq)))
        · exact Or.inr (Set.mem_biUnion ⟨hq, hqS⟩ (Metric.mem_ball_self (hR_pos q hq)))
      obtain ⟨p_v, hp_v⟩ := hV_ne
      have hp_v_S : p_v ∈ S := ⟨hV_sub hp_v, hEqV.2 p_v hp_v⟩
      have hu_ne : (U ∩ u_open).Nonempty :=
        ⟨p_v, hV_sub hp_v, Set.mem_biUnion hp_v_S (Metric.mem_ball_self (hR_pos p_v (hV_sub hp_v)))⟩
      have hv_ne : (U ∩ v_open).Nonempty :=
        ⟨p, hp, Set.mem_biUnion ⟨hp, hp_not⟩ (Metric.mem_ball_self (hR_pos p hp))⟩
      obtain ⟨x, _, hx_u, hx_v⟩ := hU_pr u_open v_open hu_op hv_op h_cov hu_ne hv_ne
      rcases Set.mem_iUnion₂.mp hx_u with ⟨p₁, hp₁_S, hx_b1⟩
      rcases Set.mem_iUnion₂.mp hx_v with ⟨p₂, hp₂_diff, hx_b2⟩
      exact hp₂_diff.2 (h_transfer p₁ hp₁_S p₂ hp₂_diff.1 ⟨x, hx_b1, hx_b2⟩)
    exact hp_S.2 z hz
  
  
  
  let x_star : ℝ := D_wall.x_star
  let H₂ : ℝ := D_wall.H₂
  have hH₂_pos : 0 < H₂ := by linarith [W.s_base_pos, D_wall.H₂_ge]
  have ht₂_norm : ‖(t₂ : ℂ)‖ < W.r_base := by
    simpa [Complex.norm_real, Real.norm_eq_abs] using D_wall.t₂_mem
  have ht₂_ball : (t₂ : ℂ) ∈ Metric.ball (0 : ℂ) W.r_base := by
    simpa [Metric.mem_ball, dist_zero_right] using ht₂_norm
  let y_star : ℂ := (x_star : ℂ) + (H₂ : ℂ) * Complex.I
  let y_wall : ℤ → ℂ := fun q => ((x_star + (q : ℝ) * t₂ : ℝ) : ℂ) + (H₂ : ℂ) * Complex.I
  have hy_wall_eq : ∀ q : ℤ, y_wall q = y_star + (q : ℂ) * (t₂ : ℂ) := by
    intro q; dsimp [y_wall, y_star]; push_cast; ring
  let c_wall : ℤ → ℂ × ℂ := fun q => (y_wall q, (t₂ : ℂ))
  let F_un : Finset ℤ := wallUnalignedShifts D_wall.K q_idx
  let F_all : Finset ℤ := wallAllShifts D_wall.K q_idx
  have h0_mem_un : (0 : ℤ) ∈ F_un :=
    Finset.mem_union_left _ (by simp)
  have hneg1_mem_un : (-1 : ℤ) ∈ F_un :=
    Finset.mem_union_left _ (by simp)
  have hb_mem_un : ((wallBridgeB D_wall.K : ℕ) : ℤ) ∈ F_un :=
    Finset.mem_union_left _ (by simp)
  have hqidx_mem_un : ∀ a : Fin N_idx, q_idx a ∈ F_un :=
    fun a => Finset.mem_union_right _ (Finset.mem_image_of_mem q_idx (Finset.mem_univ a))
  have h1_mem_all : (1 : ℤ) ∈ F_all := Finset.mem_insert_self (1 : ℤ) F_un
  have hun_sub_all : ∀ {q : ℤ}, q ∈ F_un → q ∈ F_all :=
    fun hq => Finset.mem_insert_of_mem hq
  have hF_un_ne : F_un.Nonempty := ⟨0, h0_mem_un⟩
  have hF_att_ne : F_un.attach.Nonempty := Finset.attach_nonempty_iff.mpr hF_un_ne
  have hF_all_ne : F_all.Nonempty := ⟨1, h1_mem_all⟩
  have h_un_cond : ∀ q ∈ F_un, q ≤ 0 ∨ D_wall.K < q.natAbs := by
    intro q hq
    rcases Finset.mem_union.mp hq with h_fixed | h_img
    · simp only [Finset.mem_insert, Finset.mem_singleton] at h_fixed
      rcases h_fixed with rfl | rfl | rfl
      · exact Or.inl (by omega)
      · exact Or.inl (by omega)
      · right; dsimp [wallBridgeB]; omega
    · rcases Finset.mem_image.mp h_img with ⟨a, _, rfl⟩
      exact hq_unaligned a
  have h_reg_un : ∀ u : { q // q ∈ F_un },
      WallRegAt W t₂ H₂ (x_star + (u.1 : ℝ) * t₂) :=
    fun u => D_wall.unaligned_wall_reg u.1 (h_un_cond u.1 u.2)
  choose δ_x_u δ_t_u G_u hδ_x_pos hδ_t_pos hδ_t_sub hG_eq using h_reg_un
  have hc_wall_mem : ∀ u : { q // q ∈ F_un },
      c_wall u.1 ∈ Metric.ball (y_wall u.1) (δ_x_u u) ×ˢ Metric.ball (t₂ : ℂ) (δ_t_u u) :=
    fun u => ⟨Metric.mem_ball_self (hδ_x_pos u), Metric.mem_ball_self (hδ_t_pos u)⟩
  let R_u : { q // q ∈ F_un } → ℝ := fun u =>
    min (min ((G_u u 0).rad (c_wall u.1)) ((G_u u 1).rad (c_wall u.1)))
      (min (δ_x_u u) (δ_t_u u))
  have hR_u_pos : ∀ u : { q // q ∈ F_un }, 0 < R_u u := fun u =>
    lt_min
      (lt_min ((G_u u 0).rad_pos _ (hc_wall_mem u)) ((G_u u 1).rad_pos _ (hc_wall_mem u)))
      (lt_min (hδ_x_pos u) (hδ_t_pos u))
  let R_wall : ℝ := F_un.attach.inf' hF_att_ne R_u
  have hR_wall_pos : 0 < R_wall :=
    (Finset.lt_inf'_iff hF_att_ne).mpr (fun u _ => hR_u_pos u)
  have hR_wall_le : ∀ u : { q // q ∈ F_un }, R_wall ≤ R_u u :=
    fun u => Finset.inf'_le R_u (Finset.mem_attach F_un u)
  let ρ : ℝ := (1 / 2 : ℝ) * min D_wall.ρ₀ (R_wall / 4)
  have hρ_pos : 0 < ρ := by
    have hmin : 0 < min D_wall.ρ₀ (R_wall / 4) :=
      lt_min D_wall.ρ₀_pos (by linarith [hR_wall_pos])
    dsimp only [ρ]
    linarith
  have hρ_lt_ρ₀ : ρ < D_wall.ρ₀ := by
    have hle : min D_wall.ρ₀ (R_wall / 4) ≤ D_wall.ρ₀ := min_le_left _ _
    dsimp only [ρ]
    linarith [D_wall.ρ₀_pos]
  have hρ_lt_half_s : ρ < W.s_base / 2 := lt_trans hρ_lt_ρ₀ D_wall.ρ₀_lt
  have h8ρ_le : 8 * ρ ≤ R_wall := by
    have hle : min D_wall.ρ₀ (R_wall / 4) ≤ R_wall / 4 := min_le_right _ _
    dsimp only [ρ]
    linarith
  let p_anc : ℂ × ℂ := wallAnchorPt x_star H₂ ρ t₂
  let y₀ : ℂ := y_star - (ρ : ℂ) * Complex.I
  have hp_anc_fst : p_anc.1 = y₀ := by
    dsimp [p_anc, wallAnchorPt, y₀, y_star]; push_cast; ring
  have hp_anc_eq : p_anc = (y₀, (t₂ : ℂ)) := Prod.ext hp_anc_fst rfl
  let c_shift : ℤ → ℂ × ℂ := fun q => wallShiftPair q p_anc
  have hc_shift_eq : ∀ q : ℤ, c_shift q = (y_wall q - (ρ : ℂ) * Complex.I, (t₂ : ℂ)) := by
    intro q
    ext
    · change p_anc.1 + (q : ℂ) * p_anc.2 = y_wall q - (ρ : ℂ) * Complex.I
      rw [hp_anc_fst, hy_wall_eq]
      dsimp [p_anc, wallAnchorPt, y₀]
      ring
    · rfl
  have hc_shift_in_tube : ∀ q : ℤ, c_shift q ∈ meroTubeENNR W.r_base W.h_L := by
    intro q
    have him : (c_shift q).1.im = H₂ - ρ := by
