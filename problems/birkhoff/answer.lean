          = (G q * G₂.den p q) * G₂.den q₀ q - (q.1 - w₁) ^ m * (G₂.num q₀ q * G₂.den p q) := by ring
        _ = ((q.1 - w₁) ^ m * G₂.num p q) * G₂.den q₀ q -
