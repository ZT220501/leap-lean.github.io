      have h_diff_B' : ∀ q ∈ B', diff_fn q = 0 := by
        intro q hq
        dsimp [diff_fn]
        rw [h_spec_on_open M R P hR p₁ hp₁ Metric.isOpen_ball hB'_sub₁ hf_holo h_rel₁ q hq,
          h_spec_on_open M R P hR p₂ hp₂ Metric.isOpen_ball hB'_sub₂ hf_holo h_rel₂ q hq]
        ring
      have h_zero := B_cr.eqOn_zero_of_preconnected_2D hB₁₂_open hB₁₂_conv.isPreconnected
        Metric.isOpen_ball ⟨q₁, Metric.mem_ball_self hδ'_pos⟩
        (fun q hq => (hδ'_sub q hq).1) h_diff_holo h_diff_B' q₀ hq₀
      exact sub_eq_zero.mp h_zero
    have h_agrees_base : ∀ (M R : ℕ) (P : MvPolynomial (PointJetVar M) ℂ),
        ssbpcPolyDeg P ≤ R →
        ∀ p ∈ B_base, ∃ r_ag : ℝ,
          0 < r_ag ∧ r_ag ≤ ssbpcPairChartRad E₀ E₁ p ∧ Metric.ball p r_ag ⊆ B_base ∧
