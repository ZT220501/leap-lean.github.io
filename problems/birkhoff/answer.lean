            have h1 : 2 * (m.1 : ℝ) / (N : ℝ) ≤ t + 1 := by linarith
            have h2 : 2 * (m.1 : ℝ) ≤ (t + 1) * (N : ℝ) := (div_le_iff₀ hN_pos_real).mp h1
