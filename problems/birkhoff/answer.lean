        calc d_n * (C_L / ε) ^ (32 : ℝ) ≤ d_n * R := by gcongr
          _ = R * d_n := mul_comm _ _
          _ ≤ wallDepth S s := h_zone2
      have hCL_div_nonneg : 0 ≤ C_L / ε := div_nonneg hCL_pos.le hε_pos.le
      have hu_rpow_le : C_L * u ^ (1 / 32 : ℝ) ≤ ε := by
        have h1 := Real.rpow_le_rpow
          (mul_nonneg hu_pos.le (Real.rpow_nonneg hCL_div_nonneg _))
          hu_prod_le (by norm_num : (0 : ℝ) ≤ 1 / 32)
        rw [Real.one_rpow, Real.mul_rpow hu_pos.le (Real.rpow_nonneg hCL_div_nonneg _),
          ← Real.rpow_mul hCL_div_nonneg] at h1
        have h_32 : (32 : ℝ) * (1 / 32 : ℝ) = 1 := by norm_num
        rw [h_32, Real.rpow_one, mul_div_assoc', div_le_one hε_pos] at h1
        linarith
      calc (d_n / B_n) * shapeModulus S s * (wallDepth S s / d_n) ^ (17 / 32 : ℝ)
          ≤ C_L * u ^ (9 / 16 : ℝ) * (u⁻¹) ^ (17 / 32 : ℝ) := by
            rw [h_inv_u]
            exact mul_le_mul_of_nonneg_right h_cone_s (Real.rpow_nonneg (inv_nonneg.mpr hu_pos.le) _)
        _ = C_L * (u ^ (9 / 16 : ℝ) * (u⁻¹) ^ (17 / 32 : ℝ)) := by ring
        _ = C_L * u ^ (1 / 32 : ℝ) := by rw [h_exp_id]
        _ ≤ ε := hu_rpow_le
  
  let F_seq : ℕ → ℂ → ℂ := fun n => F_diag (τ n)
  let q_seq : ℕ → ℂ → ℂ := fun n => q_diag (τ n)
  let Q_lim : ℂ → ℂ := fun z =>
    Filter.limUnder (nhdsWithin z {z}ᶜ) (fun w => deriv (deriv F) w / F w)
  have hH_convex : Convex ℝ criticalLowerHalfPlane := by
    intro z₁ hz₁ z₂ hz₂ a b ha hb hab
    change (a • z₁ + b • z₂).im < 0
    simp only [Complex.add_im, Complex.real_smul, Complex.mul_im, Complex.ofReal_re,
      Complex.ofReal_im, zero_mul, add_zero]
    change z₁.im < 0 at hz₁
    change z₂.im < 0 at hz₂
    rcases lt_or_eq_of_le ha with ha_pos | rfl
    · have h1 : a * z₁.im < 0 := mul_neg_of_pos_of_neg ha_pos hz₁
      have h2 : b * z₂.im ≤ 0 := mul_nonpos_of_nonneg_of_nonpos hb hz₂.le
      linarith
    · have hb1 : b = 1 := by linarith
      rw [hb1]
      linarith
  have hH_preconn : IsPreconnected criticalLowerHalfPlane := hH_convex.isPreconnected
  have hF_d1_holo : DifferentiableOn ℂ (deriv F) criticalLowerHalfPlane :=
    hF_holo.deriv isOpen_H
  have hF_d2_holo : DifferentiableOn ℂ (deriv (deriv F)) criticalLowerHalfPlane :=
    hF_d1_holo.deriv isOpen_H
  have hQ_eq_div : ∀ w ∈ criticalLowerHalfPlane, F w ≠ 0 →
      Q_lim w = deriv (deriv F) w / F w := by
    intro w hw hFw
    have hc1 : ContinuousAt (deriv (deriv F)) w :=
      (hF_d2_holo.differentiableAt (isOpen_H.mem_nhds hw)).continuousAt
    have hc2 : ContinuousAt F w :=
      (hF_holo.differentiableAt (isOpen_H.mem_nhds hw)).continuousAt
    exact ((hc1.div hc2 hFw).tendsto.mono_left nhdsWithin_le_nhds).limUnder_eq
  have hQ_local : ∀ z₀ ∈ criticalLowerHalfPlane, ∃ r : ℝ, 0 < r ∧
      Metric.ball z₀ r ⊆ criticalLowerHalfPlane ∧
      (∀ w ∈ Metric.closedBall z₀ r, w ≠ z₀ → F w ≠ 0) ∧
      DifferentiableOn ℂ Q_lim (Metric.ball z₀ r) := by
    intro z₀ hz₀
    have hz₀_neg : z₀.im < 0 := hz₀
    have hF_ana : AnalyticOnNhd ℂ F criticalLowerHalfPlane :=
      (Complex.analyticOnNhd_iff_differentiableOn isOpen_H).mpr hF_holo
    have h_not_freq : ¬ ∃ᶠ w in nhdsWithin z₀ {z₀}ᶜ, F w = 0 := by
      intro h_freq
      have h_eq0 := hF_ana.eqOn_zero_of_preconnected_of_frequently_eq_zero hH_preconn hz₀ h_freq
      rcases hF_nonzero with ⟨z_nz, hz_mem, hz_nz⟩
      exact hz_nz (h_eq0 hz_mem)
    rw [Filter.not_frequently] at h_not_freq
    obtain ⟨δ₁, hδ₁_pos, hδ₁⟩ := Metric.mem_nhdsWithin_iff.mp h_not_freq
    let r : ℝ := min ((-z₀.im) / 4) (δ₁ / 2)
    have hr_pos : 0 < r := lt_min (by linarith) (by positivity)
    have hr_le_im : r ≤ (-z₀.im) / 4 := min_le_left _ _
    have hr_le_δ : r ≤ δ₁ / 2 := min_le_right _ _
    let m : ℕ := max 1 (Nat.ceil (-z₀.im) + 1)
    have hm : 1 ≤ m := le_max_left 1 _
    have hm_gt_im : -z₀.im < (m : ℝ) := by
      calc -z₀.im ≤ (Nat.ceil (-z₀.im) : ℝ) := Nat.le_ceil _
        _ < (Nat.ceil (-z₀.im) : ℝ) + 1 := lt_add_one _
        _ = ((Nat.ceil (-z₀.im) + 1 : ℕ) : ℝ) := (Nat.cast_add_one _).symm
        _ ≤ (m : ℝ) := Nat.cast_le.mpr (le_max_right 1 _)
    let U_ball : Set ℂ := Metric.ball z₀ (2 * r)
    have hU_ball_sub_Um : U_ball ⊆ U_strip m := by
      intro w hw
      rw [Metric.mem_ball, dist_eq_norm] at hw
      have h_im_diff := abs_le.mp (le_of_lt (lt_of_le_of_lt (Complex.abs_im_le_norm (w - z₀)) hw))
      simp only [Complex.sub_im] at h_im_diff
      exact ⟨by linarith, by linarith⟩
    have hUm_sub_H : U_strip m ⊆ criticalLowerHalfPlane := fun _ hw => hw.2
    have h_cball_sub_Uball : Metric.closedBall z₀ r ⊆ U_ball :=
      Metric.closedBall_subset_ball (by linarith)
    have h_cball_sub_Um : Metric.closedBall z₀ r ⊆ U_strip m :=
      Subset.trans h_cball_sub_Uball hU_ball_sub_Um
    have h_ball_sub_H : Metric.ball z₀ r ⊆ criticalLowerHalfPlane :=
      Subset.trans Metric.ball_subset_closedBall (Subset.trans h_cball_sub_Um hUm_sub_H)
    have hF_punct_nz : ∀ w ∈ Metric.closedBall z₀ r, w ≠ z₀ → F w ≠ 0 := by
      intro w hw hw_ne
      rw [Metric.mem_closedBall] at hw
      have hw_ball : w ∈ Metric.ball z₀ δ₁ := Metric.mem_ball.mpr (lt_of_le_of_lt hw (by linarith))
      exact hδ₁ ⟨hw_ball, Set.mem_compl_singleton_iff.mpr hw_ne⟩
    
    have hF_conv_ball : TendstoLocallyUniformlyOn F_seq F Filter.atTop U_ball :=
      hF_conv.mono (Subset.trans hU_ball_sub_Um hUm_sub_H)
    have hF_seq_diff : ∀ᶠ n in Filter.atTop, DifferentiableOn ℂ (F_seq n) U_ball :=
      Filter.eventually_atTop.mpr ⟨m, fun n hn =>
        ((h_strip m hm (τ n) (le_trans hn (hτ.id_le n))).1).mono hU_ball_sub_Um⟩
    have h_d1_conv : TendstoLocallyUniformlyOn (deriv ∘ F_seq) (deriv F) Filter.atTop U_ball :=
      hF_conv_ball.deriv hF_seq_diff Metric.isOpen_ball
    have hF_seq_d1_diff : ∀ᶠ n in Filter.atTop, DifferentiableOn ℂ ((deriv ∘ F_seq) n) U_ball :=
      hF_seq_diff.mono fun n hn => hn.deriv Metric.isOpen_ball
    have h_d2_conv : TendstoLocallyUniformlyOn (deriv ∘ (deriv ∘ F_seq)) (deriv (deriv F))
        Filter.atTop U_ball :=
      h_d1_conv.deriv hF_seq_d1_diff Metric.isOpen_ball
    
    have hSr_comp : IsCompact (Metric.sphere z₀ r) := isCompact_sphere z₀ r
    have hSr_ne : (Metric.sphere z₀ r).Nonempty := NormedSpace.sphere_nonempty.mpr hr_pos.le
    have hSr_sub_Uball : Metric.sphere z₀ r ⊆ U_ball :=
      Subset.trans Metric.sphere_subset_closedBall h_cball_sub_Uball
    have hSr_sub_H : Metric.sphere z₀ r ⊆ criticalLowerHalfPlane :=
      Subset.trans hSr_sub_Uball (Subset.trans hU_ball_sub_Um hUm_sub_H)
    obtain ⟨w_min, hw_min_mem, hw_min⟩ := hSr_comp.exists_isMinOn hSr_ne
      (continuous_norm.comp_continuousOn (hF_holo.continuousOn.mono hSr_sub_H))
    let m_sph : ℝ := ‖F w_min‖
    have hm_sph_pos : 0 < m_sph := by
      have hw_ne : w_min ≠ z₀ := by
        intro h_eq
        have h_dist : dist w_min z₀ = r := Metric.mem_sphere.mp hw_min_mem
        rw [h_eq, dist_self] at h_dist
        linarith
      exact norm_pos_iff.mpr (hF_punct_nz w_min (Metric.sphere_subset_closedBall hw_min_mem) hw_ne)
    obtain ⟨w_max, _hw_max_mem, hw_max⟩ := hSr_comp.exists_isMaxOn hSr_ne
      (continuous_norm.comp_continuousOn (hF_d2_holo.continuousOn.mono hSr_sub_H))
    let M_d2 : ℝ := ‖deriv (deriv F) w_max‖
    have hF_unif_Sr := (tendstoLocallyUniformlyOn_iff_forall_isCompact Metric.isOpen_ball).mp
      hF_conv_ball (Metric.sphere z₀ r) hSr_sub_Uball hSr_comp
    have hd2_unif_Sr := (tendstoLocallyUniformlyOn_iff_forall_isCompact Metric.isOpen_ball).mp
      h_d2_conv (Metric.sphere z₀ r) hSr_sub_Uball hSr_comp
    obtain ⟨N_a, hN_a⟩ := Filter.eventually_atTop.mp
      (Metric.tendstoUniformlyOn_iff.mp hF_unif_Sr (m_sph / 2) (by positivity))
    obtain ⟨N_b, hN_b⟩ := Filter.eventually_atTop.mp
      (Metric.tendstoUniformlyOn_iff.mp hd2_unif_Sr 1 zero_lt_one)
    let N₁ : ℕ := max m (max N_a N_b)
    let M_q : ℝ := (M_d2 + 1) / (m_sph / 2)
    have hq_ball_bdd : ∀ n ≥ N₁, ∀ w ∈ Metric.closedBall z₀ r, ‖q_seq n w‖ ≤ M_q := by
      intro n hn
      have hm_le_n : m ≤ n := le_trans (le_max_left _ _) hn
      have hNa_le_n : N_a ≤ n := le_trans (le_max_left _ _) (le_trans (le_max_right _ _) hn)
      have hNb_le_n : N_b ≤ n := le_trans (le_max_right _ _) (le_trans (le_max_right _ _) hn)
      rcases h_strip m hm (τ n) (le_trans hm_le_n (hτ.id_le n)) with ⟨_, hq_holo_n, h_ode_n⟩
      have hq_dc : DiffContOnCl ℂ (q_seq n) (Metric.ball z₀ r) := by
        refine (hq_holo_n.mono ?_).diffContOnCl
        rw [closure_ball z₀ hr_pos.ne']
        exact h_cball_sub_Um
      have hq_front : ∀ w ∈ frontier (Metric.ball z₀ r), ‖q_seq n w‖ ≤ M_q := by
        rw [frontier_ball z₀ hr_pos.ne']
        intro w hw
        have hF_min_w : m_sph ≤ ‖F w‖ := isMinOn_iff.mp hw_min w hw
        have hF_dist_w : ‖F w - F_seq n w‖ < m_sph / 2 := by
          simpa only [dist_eq_norm] using hN_a n hNa_le_n w hw
        have hFn_gt : m_sph / 2 < ‖F_seq n w‖ := by
          linarith [norm_sub_norm_le (F w) (F_seq n w)]
        have hd2_max_w : ‖deriv (deriv F) w‖ ≤ M_d2 := isMaxOn_iff.mp hw_max w hw
        have hd2_dist_w : ‖deriv (deriv F) w - deriv (deriv (F_seq n)) w‖ < 1 := by
          simpa only [Function.comp_apply, dist_eq_norm] using hN_b n hNb_le_n w hw
        have h_rev : ‖deriv (deriv (F_seq n)) w - deriv (deriv F) w‖ < 1 := by
          rwa [norm_sub_rev]
        have hd2n_le : ‖deriv (deriv (F_seq n)) w‖ ≤ M_d2 + 1 := by
          linarith [norm_sub_norm_le (deriv (deriv (F_seq n)) w) (deriv (deriv F) w)]
        have hw_Um : w ∈ U_strip m := h_cball_sub_Um (Metric.sphere_subset_closedBall hw)
        have h_prod_norm : ‖deriv (deriv (F_seq n)) w‖ = ‖q_seq n w‖ * ‖F_seq n w‖ := by
          rw [h_ode_n w hw_Um, norm_mul]
        rw [le_div_iff₀ (by positivity)]
        calc ‖q_seq n w‖ * (m_sph / 2) ≤ ‖q_seq n w‖ * ‖F_seq n w‖ :=
              mul_le_mul_of_nonneg_left hFn_gt.le (norm_nonneg _)
          _ = ‖deriv (deriv (F_seq n)) w‖ := h_prod_norm.symm
          _ ≤ M_d2 + 1 := hd2n_le
      intro w hw
      rw [← closure_ball z₀ hr_pos.ne'] at hw
      exact Complex.norm_le_of_forall_mem_frontier_norm_le Metric.isBounded_ball hq_dc hq_front hw
    
    have h_bdd_punct : BddAbove
        (norm ∘ (fun w => deriv (deriv F) w / F w) '' (Metric.ball z₀ r \ {z₀})) := by
      refine ⟨M_q, ?_⟩
      rintro _ ⟨w, ⟨hw_ball, hw_not_mem⟩, rfl⟩
      have hw_ne : w ≠ z₀ := Set.mem_compl_singleton_iff.mp hw_not_mem
      have hw_cball : w ∈ Metric.closedBall z₀ r := Metric.ball_subset_closedBall hw_ball
      have hw_Uball : w ∈ U_ball := h_cball_sub_Uball hw_cball
      have hFw_nz : F w ≠ 0 := hF_punct_nz w hw_cball hw_ne
      have h_unif_w1 := (tendstoLocallyUniformlyOn_iff_forall_isCompact Metric.isOpen_ball).mp
        hF_conv_ball {w} (Set.singleton_subset_iff.mpr hw_Uball) isCompact_singleton
      have h_unif_w2 := (tendstoLocallyUniformlyOn_iff_forall_isCompact Metric.isOpen_ball).mp
        h_d2_conv {w} (Set.singleton_subset_iff.mpr hw_Uball) isCompact_singleton
      have h_tends_F : Filter.Tendsto (fun n => F_seq n w) Filter.atTop (nhds (F w)) :=
        h_unif_w1.tendsto_at (Set.mem_singleton w)
      have h_tends_d2 : Filter.Tendsto (fun n => deriv (deriv (F_seq n)) w) Filter.atTop
          (nhds (deriv (deriv F) w)) :=
        h_unif_w2.tendsto_at (Set.mem_singleton w)
      have h_tends_div : Filter.Tendsto (fun n => deriv (deriv (F_seq n)) w / F_seq n w)
          Filter.atTop (nhds (deriv (deriv F) w / F w)) :=
        h_tends_d2.div h_tends_F hFw_nz
      have h_ev_le : ∀ᶠ n in Filter.atTop, ‖deriv (deriv (F_seq n)) w / F_seq n w‖ ≤ M_q := by
        filter_upwards [Filter.eventually_ge_atTop N₁, h_tends_F.eventually_ne hFw_nz] with n hn hFn_nz
        have hm_le_n : m ≤ n := le_trans (le_max_left _ _) hn
        have h_ode_w := (h_strip m hm (τ n) (le_trans hm_le_n (hτ.id_le n))).2.2 w
          (h_cball_sub_Um hw_cball)
        rw [h_ode_w, mul_div_cancel_right₀ _ hFn_nz]
        exact hq_ball_bdd n hn w hw_cball
      exact le_of_tendsto (continuous_norm.continuousAt.tendsto.comp h_tends_div) h_ev_le
    have h_punct_sub_H : Metric.ball z₀ r \ {z₀} ⊆ criticalLowerHalfPlane :=
      fun _ hw => h_ball_sub_H hw.1
    have h_div_diff : DifferentiableOn ℂ (fun w => deriv (deriv F) w / F w)
        (Metric.ball z₀ r \ {z₀}) :=
      (hF_d2_holo.mono h_punct_sub_H).div (hF_holo.mono h_punct_sub_H) fun w hw =>
        hF_punct_nz w (Metric.ball_subset_closedBall hw.1) (Set.mem_compl_singleton_iff.mp hw.2)
    have h_upd_diff : DifferentiableOn ℂ
        (Function.update (fun w => deriv (deriv F) w / F w) z₀ (Q_lim z₀))
        (Metric.ball z₀ r) :=
      Complex.differentiableOn_update_limUnder_of_bddAbove
        (Metric.ball_mem_nhds z₀ hr_pos) h_div_diff h_bdd_punct
    have hQ_ball : DifferentiableOn ℂ Q_lim (Metric.ball z₀ r) := by
      refine h_upd_diff.congr fun w hw => ?_
      by_cases hw_eq : w = z₀
      · subst hw_eq
        simp
      · rw [Function.update_of_ne hw_eq]
        exact hQ_eq_div w (h_ball_sub_H hw)
          (hF_punct_nz w (Metric.ball_subset_closedBall hw) hw_eq)
    exact ⟨r, hr_pos, h_ball_sub_H, hF_punct_nz, hQ_ball⟩
  have hQ_lim_holo : DifferentiableOn ℂ Q_lim criticalLowerHalfPlane := by
    intro z₀ hz₀
    obtain ⟨r, hr_pos, _, _, hQ_ball⟩ := hQ_local z₀ hz₀
    exact (hQ_ball.differentiableAt
      (Metric.isOpen_ball.mem_nhds (Metric.mem_ball_self hr_pos))).differentiableWithinAt
  have hderiv2_F : ∀ z ∈ criticalLowerHalfPlane, deriv (deriv F) z = Q_lim z * F z := by
    intro z₀ hz₀
    obtain ⟨r, hr_pos, h_ball_sub_H, hF_punct_nz, _⟩ := hQ_local z₀ hz₀
    let w_seq : ℕ → ℂ := fun k => z₀ + (((r / 2) / ((k : ℝ) + 1) : ℝ) : ℂ)
    have hw_mem : ∀ k : ℕ, w_seq k ∈ Metric.ball z₀ r ∧ w_seq k ≠ z₀ := by
      intro k
      let δ_k : ℝ := (r / 2) / ((k : ℝ) + 1)
      have hδ_k_pos : 0 < δ_k := by positivity
      have hk_ge_one : (1 : ℝ) ≤ (k : ℝ) + 1 := by
        have : (0 : ℝ) ≤ (k : ℝ) := Nat.cast_nonneg k
        linarith
      have hδ_k_lt : δ_k < r := by
        calc δ_k ≤ r / 2 := div_le_self (by positivity) hk_ge_one
          _ < r := by linarith
      constructor
      · rw [Metric.mem_ball, dist_eq_norm]
        have h_sub : w_seq k - z₀ = ((δ_k : ℝ) : ℂ) := by simp [w_seq, δ_k]
        rw [h_sub, Complex.norm_real, Real.norm_of_nonneg hδ_k_pos.le]
        exact hδ_k_lt
      · intro h_eq
        have h_zero : ((δ_k : ℝ) : ℂ) = 0 := by
          have : z₀ + ((δ_k : ℝ) : ℂ) = z₀ + 0 := by simpa [w_seq, δ_k] using h_eq
          exact add_left_cancel this
        exact hδ_k_pos.ne' (Complex.ofReal_eq_zero.mp h_zero)
    have hw_ode : ∀ k : ℕ, deriv (deriv F) (w_seq k) = Q_lim (w_seq k) * F (w_seq k) := by
      intro k
      rcases hw_mem k with ⟨hk_ball, hk_ne⟩
      have hFw_nz : F (w_seq k) ≠ 0 :=
        hF_punct_nz (w_seq k) (Metric.ball_subset_closedBall hk_ball) hk_ne
      rw [hQ_eq_div (w_seq k) (h_ball_sub_H hk_ball) hFw_nz, div_mul_cancel₀ _ hFw_nz]
    have hw_tendsto : Filter.Tendsto w_seq Filter.atTop (nhds z₀) := by
      rw [Metric.tendsto_atTop]
      intro ε hε
      refine ⟨Nat.ceil ((r / 2) / ε), fun k hk => ?_⟩
      let δ_k : ℝ := (r / 2) / ((k : ℝ) + 1)
      have hδ_k_pos : 0 < δ_k := by positivity
      have h_sub : w_seq k - z₀ = ((δ_k : ℝ) : ℂ) := by simp [w_seq, δ_k]
      rw [dist_eq_norm, h_sub, Complex.norm_real, Real.norm_of_nonneg hδ_k_pos.le]
      have h_denom : (r / 2) / ε < (k : ℝ) + 1 := by
        calc (r / 2) / ε ≤ (Nat.ceil ((r / 2) / ε) : ℝ) := Nat.le_ceil _
          _ ≤ (k : ℝ) := Nat.cast_le.mpr hk
          _ < (k : ℝ) + 1 := lt_add_one _
      have h_pos_k : (0 : ℝ) < (k : ℝ) + 1 := by positivity
      exact (div_lt_iff₀ h_pos_k).mpr (by
        have := (div_lt_iff₀ hε).mp h_denom
        linarith)
    have hc_d2 : ContinuousAt (deriv (deriv F)) z₀ :=
      (hF_d2_holo.differentiableAt (isOpen_H.mem_nhds hz₀)).continuousAt
    have hc_Q : ContinuousAt Q_lim z₀ :=
      (hQ_lim_holo.differentiableAt (isOpen_H.mem_nhds hz₀)).continuousAt
    have hc_F : ContinuousAt F z₀ :=
      (hF_holo.differentiableAt (isOpen_H.mem_nhds hz₀)).continuousAt
    have h_lhs : Filter.Tendsto (fun k => deriv (deriv F) (w_seq k)) Filter.atTop
        (nhds (deriv (deriv F) z₀)) :=
      hc_d2.tendsto.comp hw_tendsto
    have h_rhs : Filter.Tendsto (fun k => Q_lim (w_seq k) * F (w_seq k)) Filter.atTop
        (nhds (Q_lim z₀ * F z₀)) :=
      (hc_Q.tendsto.comp hw_tendsto).mul (hc_F.tendsto.comp hw_tendsto)
    have h_lhs' : Filter.Tendsto (fun k => Q_lim (w_seq k) * F (w_seq k)) Filter.atTop
        (nhds (deriv (deriv F) z₀)) := by
      simpa only [hw_ode] using h_lhs
    exact tendsto_nhds_unique h_lhs' h_rhs
  
  have h_mom_sub : TendstoLocallyUniformly
      (fun n v => Real.exp v * (rowMomentFull S (K_seq n + v) / rowMomentFull S (K_seq n)))
      (fun v => Real.exp (L_lim v)) Filter.atTop :=
    fun u hu x =>
      let ⟨t, ht, h⟩ := h_mom u hu x
      ⟨t, ht, hτ.tendsto_atTop.eventually h⟩
  exact ⟨{
    F := F
    Q_lim := Q_lim
    L_lim := L_lim
    lam := lam
    β := 3 / 8
    a := P'
    α := 9 / 16
    δ_b := δ_b
    C_env2 := C_env2
    K_seq := K_seq
    ξ_seq := ξ_seq
    F_holo := hF_holo
    Q_lim_holo := hQ_lim_holo
    F_nonzero := hF_nonzero
    deriv2_F := hderiv2_F
    one_le_lam := hlam
    β_pos := by norm_num
    β_lt_half := by norm_num
    a_pos := by linarith
    half_lt_α := by norm_num
    α_lt_one_sub_β := by norm_num
    δ_b_pos := hδ_pos
    δ_b_lt := hδ_lt
    C_env2_pos := hC_env2
    L_lim_cont := hL_cont
    L_lim_zero := hL_zero
    L_lim_slope_top := hL_top
    L_lim_slope_bot := hL_bot
    K_seq_ge := hK_seq_ge
    K_seq_tendsto := hK_tendsto
    B_seq_tendsto := hB_tendsto
    moment_law_conv := h_mom_sub
    global_envelope := fun n l hl => h_env (τ n) l hl
    cone_bound := h_cone_real
    F_conv := hF_conv
    Q_conv := hQ_conv
  }⟩

theorem bounded_contact_second_scale_extraction (S : FiniteWallNonisotropicStrip)
    (hBoot : CriticalBootstrapPackage S)
    (k_seq k_anc_seq ε_seq : ℕ → ℝ) (w_seq : ℕ → ℝ → ℝ) (m : ℝ → ℝ)
    (hTuple : IsProhibitedCriticalTuple S k_seq k_anc_seq ε_seq w_seq)
    (hm_pos : ∀ D : ℝ, 0 < D → 0 < m D)
    (hm_lim : TendstoLocallyUniformlyOn
      (fun n D =>
        rowMomentFull S (k_seq n - Real.log D) / (rowMomentFull S (k_seq n) * D))
      m Filter.atTop (Set.Ioi 0))
    (hBounded : MomentLawBoundedBranch m) :
    Nonempty (SecondScaleFirstFieldData S) :=
by
  obtain ⟨h_basic, hk_top, hB_top, hε_zero, h_norm, _⟩ := id hTuple
  have h_basic_k : ∀ n : ℕ, criticalDepthThreshold S ≤ k_seq n ∧
      0 < ε_seq n ∧ 1 ≤ rowMomentFull S (k_seq n) := by
    intro n
    rcases h_basic n with ⟨h1, h2, h3, h4⟩
    exact ⟨le_trans h1 h2, h3, h4⟩
  obtain ⟨x_seq, ρ_star, lam, C_env, P', hlam, hC_env, hP', hx_nonneg, _hx_top,
    hρ_cont, hρ_zero, hρ_top, hρ_bot, hρ_conv, h_right, h_left, h_x_growth⟩ :=
    hBounded.exists_data
  obtain ⟨L_lim, N_env, ⟨hL_cont, hL_zero, hL_top, hL_bot⟩, hN_env, h_mom_transfer⟩ :=
    recentered_global_envelope_and_moment_law S k_seq ε_seq m x_seq ρ_star lam C_env P'
      h_basic_k hk_top hB_top hε_zero h_norm hm_pos hm_lim hlam hC_env hP' hx_nonneg
      hρ_cont hρ_zero hρ_top hρ_bot hρ_conv h_right h_left h_x_growth
  have hToolkit : SecondScaleKernelTileToolkit S := periodic_poisson_and_tile_toolkit S
  have hC_env2_pos : 0 < 4 * Real.exp C_env := by positivity
  have hN_env_boot : ∀ j : ℕ, ∀ n ≥ N_env j,
      criticalDepthThreshold S ≤ k_seq n - x_seq j ∧
      (j : ℝ) + 1 ≤ k_seq n - x_seq j ∧
      2 * ((j : ℝ) + 2) * Real.exp (-(k_seq n - x_seq j)) ≤
        (1 / 4 : ℝ) * Real.exp (-criticalDepthThreshold S) ∧
      (j : ℝ) + 1 ≤ rowMomentFull S (k_seq n - x_seq j) ∧
      (1 / 2 : ℝ) * m (Real.exp (x_seq j)) ≤
        rowMomentFull S (k_seq n - x_seq j) /
          (rowMomentFull S (k_seq n) * Real.exp (x_seq j)) ∧
      IsCriticalEnvelope S (3 / 8) P' 1 (4 * Real.exp C_env)
        (fun l => rowMomentFull S (k_seq n - x_seq j) *
          Real.exp ((3 / 8 : ℝ) * max (k_seq n - x_seq j - l) 0 +
            P' * max (l - (k_seq n - x_seq j)) 0)) := by
    intro j n hn
    rcases hN_env j n hn with ⟨h1, h2, h3, h4, h5, _h6, h7⟩
    exact ⟨h1, h2, h3, h4, h5, h7⟩
  obtain ⟨n_sel, ξ_diag, _hn_strict, hn_ge_env, h_cone_diag, hF_bdd_diag, hQ_vanish_diag⟩ :=
    weighted_bootstrap_diagonal_and_center_selection S hBoot hToolkit
      k_seq k_anc_seq ε_seq w_seq x_seq m P' (4 * Real.exp C_env) N_env
      hTuple hP' hC_env2_pos hx_nonneg hm_pos hN_env_boot
  have hK_basic : ∀ j : ℕ,
      criticalDepthThreshold S ≤ k_seq (n_sel j) - x_seq j ∧
      (j : ℝ) + 1 ≤ k_seq (n_sel j) - x_seq j ∧
      2 * ((j : ℝ) + 2) * Real.exp (-(k_seq (n_sel j) - x_seq j)) ≤
        (1 / 4 : ℝ) * Real.exp (-criticalDepthThreshold S) ∧
      (j : ℝ) + 1 ≤ rowMomentFull S (k_seq (n_sel j) - x_seq j) := by
    intro j
    rcases hN_env j (n_sel j) (hn_ge_env j) with ⟨h1, h2, h3, h4, _⟩
    exact ⟨h1, h2, h3, h4⟩
  have h_env_diag : ∀ j : ℕ, ∀ l : ℝ, criticalDepthThreshold S ≤ l →
      rowMomentFull S l ≤
        (4 * Real.exp C_env) * rowMomentFull S (k_seq (n_sel j) - x_seq j) *
          Real.exp ((3 / 8 : ℝ) * max (k_seq (n_sel j) - x_seq j - l) 0 +
            P' * max (l - (k_seq (n_sel j) - x_seq j)) 0) := by
    intro j l hl
    exact (hN_env j (n_sel j) (hn_ge_env j)).2.2.2.2.2.1 l hl
  exact halfplane_normal_family_and_quotient_regularity S hBoot L_lim
    lam P' (4 * Real.exp C_env) (fun j => k_seq (n_sel j) - x_seq j) ξ_diag
    hlam hP' hC_env2_pos hL_cont hL_zero hL_top hL_bot
    hK_basic (h_mom_transfer n_sel hn_ge_env) h_env_diag
    h_cone_diag hF_bdd_diag hQ_vanish_diag

theorem moment_law_and_second_scale_extraction (S : FiniteWallNonisotropicStrip)
    (hCrit : CriticalWallData S)
    (hBoot : CriticalBootstrapPackage S)
    (hProhib : ProhibitedCriticalSequence S) :
    Nonempty (SecondScaleFirstFieldData S) :=
by
  rcases hProhib with ⟨k_seq, k_anc_seq, ε_seq, w_seq,
    h_basic, hk_top, hB_top, hε_zero, h_norm,
    hk_anc_top, hs_top, hw, h_coarse_tile, h_coarse_V, h_q_prob⟩
  have h_basic_k : ∀ n : ℕ, criticalDepthThreshold S ≤ k_seq n ∧
      0 < ε_seq n ∧ 1 ≤ rowMomentFull S (k_seq n) := by
    intro n
    rcases h_basic n with ⟨h1, h2, h3, h4⟩
    exact ⟨le_trans h1 h2, h3, h4⟩
  obtain ⟨σ, m, hσ, hm_pos, hm_one, hm_le, hm_conv, hm_lim⟩ :=
    hadamard_moment_law_compactness S k_seq ε_seq h_basic_k hk_top hε_zero h_norm
  have hTuple_sub : IsProhibitedCriticalTuple S
      (k_seq ∘ σ) (k_anc_seq ∘ σ) (ε_seq ∘ σ) (w_seq ∘ σ) := by
    refine ⟨fun n => h_basic (σ n),
      hk_top.comp hσ.tendsto_atTop,
      hB_top.comp hσ.tendsto_atTop,
      hε_zero.comp hσ.tendsto_atTop,
      fun n j hj => h_norm (σ n) j hj,
      hk_anc_top.comp hσ.tendsto_atTop,
      hs_top.comp hσ.tendsto_atTop,
      fun n => hw (σ n),
      ?_, ?_, ?_⟩
    · intro β A hβ0 hβ1 hA
      obtain ⟨C_βA, hC_pos, N₀, hN₀⟩ := h_coarse_tile β A hβ0 hβ1 hA
      exact ⟨C_βA, hC_pos, N₀, fun n hn j hj1 hj2 => hN₀ (σ n) (le_trans hn (hσ.id_le n)) j hj1 hj2⟩
    · intro β hβ0 hβ1
      obtain ⟨C_β, hC_pos, N₀, hN₀⟩ := h_coarse_V β hβ0 hβ1
      exact ⟨C_β, hC_pos, N₀, fun n hn => hN₀ (σ n) (le_trans hn (hσ.id_le n))⟩
    · intro K hK_comp hK_ne hK_sub
      exact (h_q_prob K hK_comp hK_ne hK_sub).comp hσ.tendsto_atTop
  rcases convex_moment_contact_dichotomy m hm_pos hm_one hm_le hm_conv with hSteep | hBounded
  · exact False.elim (steep_contact_moment_law_exclusion S hCrit (k_seq ∘ σ) (ε_seq ∘ σ) m
      (fun n => h_basic_k (σ n))
      (hk_top.comp hσ.tendsto_atTop)
      (hB_top.comp hσ.tendsto_atTop)
      (hε_zero.comp hσ.tendsto_atTop)
      (fun n j hj => h_norm (σ n) j hj)
      hm_pos hm_lim hSteep)
  · exact bounded_contact_second_scale_extraction S hBoot
      (k_seq ∘ σ) (k_anc_seq ∘ σ) (ε_seq ∘ σ) (w_seq ∘ σ) m
      hTuple_sub hm_pos hm_lim hBounded

theorem glued_cusp_impact_models (S : FiniteWallNonisotropicStrip)
    (hCrit : CriticalWallData S)
    (M : SecondScaleFirstFieldData S)
    (R ε' : ℝ) (hR : 0 < R) (hε' : 0 < ε') :
    let r := 1 / (M.lam + ε')
    let m₀ := 2 / Real.cos (Real.pi * r / 2) + R + 4
    ∃ t₀ c_ε D₀ : ℝ, 0 < t₀ ∧ 0 < c_ε ∧ 10 ≤ D₀ ∧
      ∀ D_min H_req : ℝ, 0 < D_min → D_min ≤ 1 → 0 < H_req →
        ∃ N₀ : ℕ, ∀ n ≥ N₀,
          ∃ (U : Set (ℂ × ℂ)) (Φ : ℂ × ℂ → ℂ),
            IsOpen U ∧
            DifferentiableOn ℂ Φ U ∧
            (∀ p ∈ U, (Φ p).im < 0) ∧
            ({ p : ℂ × ℂ |
                p.1.im = 0 ∧ |p.1.re| ≤ t₀ ∧
                D_min + c_ε ^ (-r) * |p.1.re| ^ r < -p.2.im ∧
                -p.2.im < H_req } ⊆ U) ∧
            ({ p : ℂ × ℂ |
                ‖p.1‖ < 2 * t₀ ∧
                D₀ < -p.2.im ∧ -p.2.im < H_req ∧
                |p.2.re| < m₀ * (-p.2.im) } ⊆ U) ∧
            (∀ Y : ℂ, 0 < -Y.im → -Y.im < H_req →
              Φ (0, Y) = Y ∧
              deriv (fun T : ℂ => Φ (T, Y)) 0 = 0 ∧
              deriv (deriv (fun T : ℂ => Φ (T, Y))) 0 =
                2 * ((Real.exp (-M.K_seq n) / (rowMomentFull S (M.K_seq n)) ^ 2 : ℝ) : ℂ) *
                  S.V ((M.ξ_seq n : ℂ) + (S.H : ℂ) * Complex.I +
                    (Real.exp (-M.K_seq n) : ℂ) * Y)) :=
by
  intro r m₀
  have hlam_ge1 : 1 ≤ M.lam := M.one_le_lam
  have hden_gt1 : 1 < M.lam + ε' := by linarith
  have hden_pos : 0 < M.lam + ε' := by linarith
  have hr0 : 0 < r := by dsimp [r]; positivity
  have hr1 : r < 1 := by
    dsimp [r]
    rw [div_lt_one hden_pos]
    exact hden_gt1
  have hinv_r : 1 / r = M.lam + ε' := by
    dsimp [r]
    field_simp [ne_of_gt hden_pos]
  have hcos_pos : 0 < Real.cos (Real.pi * r / 2) :=
    Real.cos_pos_of_mem_Ioo ⟨by nlinarith [Real.pi_pos], by nlinarith [Real.pi_pos]⟩
  have hm₀_pos : 0 < m₀ := by
    dsimp [m₀]
    have : 0 < 2 / Real.cos (Real.pi * r / 2) := by positivity
    linarith
  let c₁ : ℝ := (1 / 2 + (1 - M.β)) / 2
  let α₁ : ℝ := (1 / 2 + c₁) / 2
  have hc₁_gt_half : 1 / 2 < c₁ := by dsimp [c₁]; linarith [M.β_lt_half]
  have hc₁_lt_sub : c₁ < 1 - M.β := by dsimp [c₁]; linarith [M.β_lt_half]
  have hc₁_lt1 : c₁ < 1 := by linarith [M.β_pos]
  have hα₁_gt_half : 1 / 2 < α₁ := by dsimp [α₁]; linarith
  have hα₁_lt_c₁ : α₁ < c₁ := by dsimp [α₁]; linarith
  have hα₁_lt1 : α₁ < 1 := by linarith
  have hinv_r_gt_c₁ : c₁ < 1 / r := by linarith
  let k₀ : ℝ := criticalDepthThreshold S
  have hk₀_ge1 : 1 ≤ k₀ := le_max_left _ _
  have hexp_k₀_le : Real.exp (-k₀) ≤ S.H / 20 := by
    have hlog : -Real.log (S.H / 20) ≤ k₀ := le_max_right _ _
    have h1 : -k₀ ≤ Real.log (S.H / 20) := by linarith
    calc Real.exp (-k₀) ≤ Real.exp (Real.log (S.H / 20)) := Real.exp_le_exp.mpr h1
      _ = S.H / 20 := Real.exp_log (by linarith [S.H_pos])
  let δ_b1 : ℝ := Real.exp (-k₀) / 2
  have hδ_b1_pos : 0 < δ_b1 := by dsimp [δ_b1]; positivity
  have hδ_b1_lt : δ_b1 < S.H / 2 := by dsimp [δ_b1]; linarith [S.H_pos]
  have hInt : BootInteriorTransferProp S := liouville_disk_and_interior_transfer S
  have hRealWall : BootRealWallTransferProp S :=
    (cone_real_wall_transfer_and_strip_bound S hCrit).1
  obtain ⟨L₁, δ_star1, hL₁_pos, hδ_star1_pos, hδ_star1_lt, hTransK⟩ :=
    hRealWall α₁ δ_b1 hα₁_gt_half hα₁_lt1 hδ_b1_pos hδ_b1_lt
  obtain ⟨ε₀_1, d₀_1, hε₀_1_pos, hd₀_1_pos, hTrans⟩ := hTransK 1 zero_lt_one
  let A : ℝ := max 1 L₁
  have hA_ge1 : 1 ≤ A := le_max_left 1 L₁
  have hA_nonneg : 0 ≤ A := by linarith
  have hL₁_le_A : L₁ ≤ A := le_max_right 1 L₁
  obtain ⟨C_t2, hC_t2_pos, hTileRows⟩ := hInt.tile_L2_from_rows A hA_ge1
  obtain ⟨B_slope, hB_slope⟩ := Filter.eventually_atTop.mp
    (M.L_lim_slope_top.eventually (Metric.ball_mem_nhds M.lam hε'))
  let U₀ : ℝ := max 1 B_slope
  have hU₀_ge1 : 1 ≤ U₀ := le_max_left _ _
  have hIcc_U₀ : (Set.Icc (0 : ℝ) U₀).Nonempty := Set.nonempty_Icc.mpr (by linarith)
  obtain ⟨u_max, _, hu_max⟩ :=
    isCompact_Icc.exists_isMaxOn hIcc_U₀ M.L_lim_cont.continuousOn
  let C_L : ℝ := max 0 (M.L_lim u_max)
  have hC_L_nonneg : 0 ≤ C_L := le_max_left _ _
  have hL_lim_le : ∀ u : ℝ, 0 ≤ u → M.L_lim u ≤ C_L + u / r := by
    intro u hu
    by_cases huU : u ≤ U₀
    · have h1 : M.L_lim u ≤ M.L_lim u_max := isMaxOn_iff.mp hu_max u ⟨hu, huU⟩
      have h2 : M.L_lim u_max ≤ C_L := le_max_right _ _
      have h3 : 0 ≤ u / r := div_nonneg hu (le_of_lt hr0)
      linarith
    · have huU' : U₀ < u := lt_of_not_ge huU
      have hu_pos : 0 < u := by linarith
      have hu_B : B_slope ≤ u := le_trans (le_max_right _ _) (le_of_lt huU')
      have hdist : |M.L_lim u / u - M.lam| < ε' := by
        simpa [Real.dist_eq] using hB_slope u hu_B
      have hlt : M.L_lim u / u < 1 / r := by
        rw [hinv_r]
        linarith [(abs_lt.mp hdist).2]
      have hmul : M.L_lim u < (1 / r) * u := (div_lt_iff₀ hu_pos).mp hlt
      have heq : (1 / r) * u = u / r := by ring
      linarith
  let C_glob : ℝ :=
    max M.C_env2 ((Real.exp C_L + 1) * Real.exp ((1 / r - c₁) * (Real.log 20 + A + 1)))
  have hC_glob_pos : 0 < C_glob := lt_of_lt_of_le M.C_env2_pos (le_max_left _ _)
  let q₁ : ℝ := Real.exp (-2 * (1 - α₁))
  let q₂ : ℝ := Real.exp (-2 * (c₁ - α₁))
  have hq₁_pos : 0 < q₁ := Real.exp_pos _
  have hq₁_lt1 : q₁ < 1 := Real.exp_lt_one_iff.mpr (by linarith)
  have hq₂_pos : 0 < q₂ := Real.exp_pos _
  have hq₂_lt1 : q₂ < 1 := Real.exp_lt_one_iff.mpr (by linarith)
  let C_win : ℝ := 2 * (A + 1) * C_glob ^ 2 * Real.exp (2 * (1 - c₁) * (A + 1))
  have hC_win_pos : 0 < C_win := by dsimp [C_win]; positivity
  let C_sum_sq : ℝ := C_t2 * (1 / (1 - q₁) + C_win / (1 - q₂))
  have h1mq₁_pos : 0 < 1 - q₁ := by linarith
  have h1mq₂_pos : 0 < 1 - q₂ := by linarith
  have hC_sum_sq_pos : 0 < C_sum_sq := by dsimp [C_sum_sq]; positivity
  let C_cone : ℝ := Real.exp (α₁ + (1 - α₁) * Real.log 20) * Real.sqrt C_sum_sq
  have hC_cone_pos : 0 < C_cone := by dsimp [C_cone]; positivity
  let c_ε : ℝ := min (1 / 4) (ε₀_1 / (2 * (2 : ℝ) ^ α₁ * C_cone))
  have hc_ε : 0 < c_ε := by dsimp [c_ε]; positivity
  let t₀ : ℝ := c_ε / 2
  have ht₀ : 0 < t₀ := half_pos hc_ε
  have hMα_lt1 : M.α < 1 := by linarith [M.α_lt_one_sub_β, M.β_pos]
  obtain ⟨L_cp, δ_star2, hL_cp_pos, hδ_star2_pos, hδ_star2_lt, hCP_K⟩ :=
    hCrit.cone_passage M.α m₀ M.δ_b M.half_lt_α hMα_lt1 hm₀_pos M.δ_b_pos M.δ_b_lt
  obtain ⟨C_2, ε₀_2, d₀_2, hC_2_pos, hε₀_2_pos, hd₀_2_pos, hCP⟩ := hCP_K 1 zero_lt_one
  obtain ⟨C_Lcp, hC_Lcp_pos, N_cb, hN_cb⟩ := M.cone_bound L_cp hL_cp_pos
  let D₀ : ℝ := max 10 ((2 * t₀ * C_Lcp / ε₀_2 + 1) ^ 2)
  have hD₀ : 10 ≤ D₀ := le_max_left _ _
  have hD₀_pos : 0 < D₀ := by linarith
  have hD₀_ge1 : 1 ≤ D₀ := by linarith
  let ε_cp : ℝ := 2 * t₀ * C_Lcp * D₀ ^ (-M.α)
  have hε_cp_pos : 0 < ε_cp := by dsimp [ε_cp]; positivity
  have hε_cp_le : ε_cp ≤ ε₀_2 := by
    let B_cp : ℝ := 2 * t₀ * C_Lcp / ε₀_2 + 1
    have hB_cp_pos : 0 < B_cp := by dsimp [B_cp]; positivity
    have hB_sq : B_cp ^ 2 ≤ D₀ := le_max_right _ _
    have hB_le_half : B_cp ≤ D₀ ^ (1 / 2 : ℝ) := by
      calc B_cp = Real.sqrt (B_cp ^ 2) := (Real.sqrt_sq (le_of_lt hB_cp_pos)).symm
        _ ≤ Real.sqrt D₀ := Real.sqrt_le_sqrt hB_sq
        _ = D₀ ^ (1 / 2 : ℝ) := Real.sqrt_eq_rpow D₀
    have hhalf_le_α : D₀ ^ (1 / 2 : ℝ) ≤ D₀ ^ M.α :=
      Real.rpow_le_rpow_of_exponent_le hD₀_ge1 (le_of_lt M.half_lt_α)
    have hdiv_lt : 2 * t₀ * C_Lcp / ε₀_2 < D₀ ^ M.α := by
      have : 2 * t₀ * C_Lcp / ε₀_2 < B_cp := by dsimp [B_cp]; linarith
      linarith
    have hmul_lt : 2 * t₀ * C_Lcp < ε₀_2 * D₀ ^ M.α := by
      have := (div_lt_iff₀ hε₀_2_pos).mp hdiv_lt
      linarith [mul_comm (D₀ ^ M.α) ε₀_2]
    have hcancel : D₀ ^ M.α * D₀ ^ (-M.α) = 1 := by
      rw [← Real.rpow_add hD₀_pos, add_neg_cancel, Real.rpow_zero]
    have h1 := mul_le_mul_of_nonneg_right (le_of_lt hmul_lt)
      (by positivity : 0 ≤ D₀ ^ (-M.α))
    dsimp [ε_cp]
    linarith [show ε₀_2 * D₀ ^ M.α * D₀ ^ (-M.α) = ε₀_2 by rw [mul_assoc, hcancel, mul_one]]
  refine ⟨t₀, c_ε, D₀, ht₀, hc_ε, hD₀, ?_⟩
  intro D_min H_req hD_min_pos hD_min_le1 hH_req_pos
  have h20_Dmin_gt1 : 1 < 20 / D_min := by
    rw [one_lt_div hD_min_pos]
    linarith
  have hlog20_Dmin_pos : 0 < Real.log (20 / D_min) := Real.log_pos h20_Dmin_gt1
  let U_max : ℝ := Real.log (20 / D_min) + A + 1
  have hU_max_pos : 0 < U_max := by dsimp [U_max]; linarith
  have hUnif_mom : TendstoUniformlyOn
      (fun n v => Real.exp v * (rowMomentFull S (M.K_seq n + v) / rowMomentFull S (M.K_seq n)))
      (fun v => Real.exp (M.L_lim v)) Filter.atTop (Set.Icc 0 U_max) :=
    tendstoLocallyUniformly_iff_forall_isCompact.mp M.moment_law_conv
      (Set.Icc 0 U_max) isCompact_Icc
  obtain ⟨N_cone, hN_cone⟩ := Filter.eventually_atTop.mp
    (Metric.tendstoUniformlyOn_iff.mp hUnif_mom 1 zero_lt_one)
  let d_seq : ℕ → ℝ := fun n => Real.exp (-M.K_seq n)
  let B_seq : ℕ → ℝ := fun n => rowMomentFull S (M.K_seq n)
  have hd_tendsto : Filter.Tendsto d_seq Filter.atTop (nhds 0) :=
    Real.tendsto_exp_atBot.comp (Filter.tendsto_neg_atTop_atBot.comp M.K_seq_tendsto)
  let δ_d : ℝ :=
    min (min d₀_1 (δ_star1 / 4))
      (min (d₀_2 / D₀)
        (min (min δ_star2 (S.H / 2) / max H_req (D₀ + 1)) (S.r_star / c_ε)))
  have hδ_d_pos : 0 < δ_d :=
    lt_min (lt_min hd₀_1_pos (div_pos hδ_star1_pos (by norm_num)))
      (lt_min (div_pos hd₀_2_pos hD₀_pos)
