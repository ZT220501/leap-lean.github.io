              unfold sliceTinySupMart
              rw [Finset.sum_range_succ, add_sub_cancel_left, hAngCut hai_le, h_tiny i hi_lt]
              simp
            rw [hD_step]
            exact (mul_inv_cancel_left₀ (hR_ne_zero_ℂ (a + i)) _).symm
