        · have := (le_div_iff₀ h2pi_pos).mp (Int.floor_le (y.re / (2 * Real.pi)))
          linarith
        · have := (div_lt_iff₀ h2pi_pos).mp (Int.lt_floor_add_one (y.re / (2 * Real.pi)))
          linarith
      have hF_shift : ∀ (n : ℤ) (z : ℂ), |z.im| < s_mid →
