    rw [norm_mul]
    have hHalf : ‖(1 / 2 : ℂ)‖ = 1 / 2 := by norm_num
    rw [hHalf]
    have hIntBnd : ‖∫ s in (0 : ℝ)..1, gG t s‖ ≤ M_ker * |(1 : ℝ) - 0| := by
