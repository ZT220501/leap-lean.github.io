          (-(C.h_ℂ ψ + deriv (deriv C.h_ℂ) ψ) * Complex.sin ψ) ψ ∧
        HasDerivAt (fun w => F_curve w 1)
          ((C.h_ℂ ψ + deriv (deriv C.h_ℂ) ψ) * Complex.cos ψ) ψ := by
      intro ψ hψ
      have hh_d : HasDerivAt C.h_ℂ (deriv C.h_ℂ ψ) ψ :=
        (C.h_ℂ_holo.differentiableAt (hStrip_sh_open.mem_nhds hψ)).hasDerivAt
      have hh'_d : HasDerivAt (deriv C.h_ℂ) (deriv (deriv C.h_ℂ) ψ) ψ :=
        (hh'_holo.differentiableAt (hStrip_sh_open.mem_nhds hψ)).hasDerivAt
      have hcos_d : HasDerivAt Complex.cos (-Complex.sin ψ) ψ := Complex.hasDerivAt_cos ψ
      have hsin_d : HasDerivAt Complex.sin (Complex.cos ψ) ψ := Complex.hasDerivAt_sin ψ
      refine ⟨?_, ?_⟩
      · convert (hh_d.mul hcos_d).sub (hh'_d.mul hsin_d) using 1
        · ext w; rfl
        · ring
      · convert (hh_d.mul hsin_d).add (hh'_d.mul hcos_d) using 1
        · ext w; rfl
        · ring
    have hF_holo : ∀ i : Fin 2, DifferentiableOn ℂ (fun ψ => F_curve ψ i) (horizStrip (2 * C.s_h)) := by
      intro i ψ hψ
      fin_cases i
      · exact (hF_deriv ψ hψ).1.differentiableAt.differentiableWithinAt
      · exact (hF_deriv ψ hψ).2.differentiableAt.differentiableWithinAt
    have h_shift_mem : ∀ q ∈ collarBaseBox M, ∀ c : ℝ, |c| ≤ 1 / 2 →
        |(q.1 + (c : ℂ) * q.2).im| < C.s₁ ∧ ‖q.2‖ < C.r₁ := by
      rintro ⟨y, t⟩ ⟨hy, ht⟩ c hc
      have h1 : |(y + (c : ℂ) * t).im| ≤ |y.im| + |c| * |t.im| := by
        simpa [Complex.add_im, abs_mul] using abs_add_le y.im (c * t.im)
      have h2 : |c| * |t.im| ≤ (1 / 2) * ‖t‖ :=
        mul_le_mul hc (Complex.abs_im_le_norm t) (abs_nonneg _) (by norm_num)
      exact ⟨by linarith, by linarith⟩
    have hTheta_shift_holo : ∀ c : ℝ, |c| ≤ 1 / 2 →
        DifferentiableOn ℂ (fun q : ℂ × ℂ => glancingTheta C (q.1 + (c : ℂ) * q.2) q.2)
