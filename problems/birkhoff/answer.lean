        have : w₀ - z₀ = ((r₁ / 2 : ℝ) : ℂ) := by dsimp [w₀]; ring
        rw [this, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (by linarith)]
      have htri := dist_triangle z w₀ z₀
      have : r₁ ≤ r_V := min_le_right _ _
      linarith
    · intro i z hz
      have hwz₀ : dist w₀ z₀ = r₁ / 2 := by
        rw [dist_eq_norm]
        have : w₀ - z₀ = ((r₁ / 2 : ℝ) : ℂ) := by dsimp [w₀]; ring
        rw [this, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (by linarith)]
      have hz_lt : dist z z₀ < r₁ := by
        have htri := dist_triangle z w₀ z₀
        rw [Metric.mem_ball] at hz
        linarith
      have hz_gt : 0 < dist z z₀ := by
        have htri := dist_triangle w₀ z z₀
        rw [Metric.mem_ball, dist_comm] at hz
        linarith
