  let psDeriv : PowerSeries ℂ → PowerSeries ℂ := fun h => PowerSeries.derivative h
  have hchain : ∀ (i : Fin m) {p₁ : ℂ × ℂ}, p₁ ∈ U₀ → ∀ (g : PowerSeries ℂ) (k : ℕ),
      mvDerivA (compPowerSeries2D ((psDeriv^[k]) g) (centeredTaylor2D (ψ i) p₁)) =
