          intro θ hθ s hs
          have hc : s * θ ∈ Set.Icc (0 : ℝ) 1 :=
            ⟨mul_nonneg hs.1 hθ.1, by nlinarith [hs.1, hs.2, hθ.1, hθ.2]⟩
          have hEq : X₀ + (s : ℂ) * ((θ : ℂ) * Y₀) = X₀ + ((s * θ : ℝ) : ℂ) * Y₀ := by
            push_cast; ring
