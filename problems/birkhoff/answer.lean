        let i₀ : Fin L_vert := ⟨0, hL_pos⟩
        obtain ⟨p_b1, ⟨hp_b1_B0, hp_b1_uni⟩, hp_b1_exc⟩ :=
          hH_exc_open_wit i₀ (B_ball i₀ ∩ U_uni)
            (Metric.isOpen_ball.inter hUni_open) hBot_compat.1 Set.inter_subset_left
        let V_b0_exc : Set (ℂ × ℂ) := { p ∈ B_ball i₀ ∩ U_uni | H_exc i₀ p ≠ 0 }
        have hV_b0_exc_open : IsOpen V_b0_exc :=
          (continuousOn_open_iff (Metric.isOpen_ball.inter hUni_open)).mp
