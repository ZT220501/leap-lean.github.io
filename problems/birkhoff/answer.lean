    have hs_eq : s = s' + (((m : ℝ) * (2 * Real.pi) : ℝ) : ℂ) := by dsimp [s']; ring
    rw [hs_eq, hM_int_per m s' (hKlow_sub hs'_mem)]
    exact le_csSup hKlow_bdd ⟨s', hs'_mem, rfl⟩

  let W_A : ℝ := (A + 1) * Real.exp A
  have hTile_rect_dom : ∀ (l x : ℝ), k₀ ≤ l →
      let j₁ : ℝ := max k₀ (l - A - 1)
      let j₂ : ℝ := l + A + 1
      let L_l : ℝ := W_A * Real.exp (-l)
      let R_rect : Set ℂ :=
        { w : ℂ | |w.re - x| ≤ L_l ∧ S.H - Real.exp (-j₁) ≤ w.im ∧ w.im ≤ S.H - Real.exp (-j₂) }
      tileSupModulus S A l x ≤ Real.exp (-l) * M_low +
        (4 * Real.exp (2 * A) / Real.pi) * Real.exp l * ∫ w in R_rect, shapeModulus S w ∧
