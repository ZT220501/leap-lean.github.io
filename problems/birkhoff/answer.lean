      have h1 : 1 + (ε / r) * d ^ α₁ ≤ 2 * ((ε / r) * d ^ α₁) := by linarith
      have hsq1 : (1 + (ε / r) * d ^ α₁) ^ 2 ≤ (2 * ((ε / r) * d ^ α₁)) ^ 2 :=
