      have hsh : y + ((j + 2 : ℕ) : ℂ) * (t₀ : ℂ) = z + (t₀ : ℂ) := by
        dsimp [z]; push_cast; ring
      rw [hsh]
    rw [hXj, hXj1, hXj2]
    exact hact_zero

theorem collar_periodic_leaf_exact_slice (Ω : Set Plane)
    (B : AnalyticBoundaryData Ω)
    (S : GlancingScalePackage B) :
    CollarExactSliceProp B S :=
by
  let C_slice : ℝ := max 40 (80 / S.η_adm)
  let B_slice : ℕ := 2
  have hC_slice_ge40 : (40 : ℝ) ≤ C_slice := le_max_left _ _
  have hC_slice_ge_adm : 80 / S.η_adm ≤ C_slice := le_max_right _ _
  refine ⟨C_slice, B_slice, by linarith, ?_⟩
  intro s d δ η_mesh N l q U X_mesh
    hs0 hs_act hd0 hd_act hd_half hδ0 hδ_lt hη0 hN hU
    hl hq hqN hCop ht₀_lt hX_mesh Q hSmall
  set t₀ : ℝ := (2 * Real.pi * (l : ℝ)) / (q : ℝ)
  set η_slice : ℝ := C_slice * Q ^ B_slice * η_mesh
  
  have hOpenStrip : ∀ H : ℝ, IsOpen (horizStrip H) :=
    fun H => isOpen_Iio.preimage (continuous_abs.comp Complex.continuous_im)
  have hConvStrip : ∀ H : ℝ, Convex ℝ (horizStrip H) := by
    intro H z₁ hz₁ z₂ hz₂ a b ha hb hab
    change |(a • z₁ + b • z₂).im| < H
    have him : (a • z₁ + b • z₂).im = a * z₁.im + b * z₂.im := by simp
    rw [him]
    have h1 : |z₁.im| < H := hz₁
    have h2 : |z₂.im| < H := hz₂
    have htri : |a * z₁.im + b * z₂.im| ≤ |a * z₁.im| + |b * z₂.im| := abs_add_le _ _
    rw [abs_mul, abs_mul, abs_of_nonneg ha, abs_of_nonneg hb] at htri
    rcases eq_or_lt_of_le ha with rfl | ha_pos
    · simp at hab; subst hab; linarith
    · have haH : a * |z₁.im| < a * H := mul_lt_mul_of_pos_left h1 ha_pos
      have hbH : b * |z₂.im| ≤ b * H := mul_le_mul_of_nonneg_left h2.le hb
      have hsum : a * H + b * H = H := by
        calc a * H + b * H = (a + b) * H := by ring
          _ = H := by rw [hab, one_mul]
      linarith
  have hStripMono : ∀ {H₁ H₂ : ℝ}, H₁ ≤ H₂ → horizStrip H₁ ⊆ horizStrip H₂ :=
    fun hle _ hz => lt_of_lt_of_le hz hle
  have hRealMemStrip : ∀ {H : ℝ}, 0 < H → ∀ r : ℝ, (r : ℂ) ∈ horizStrip H := by
    intro H hH r
    change |(r : ℂ).im| < H
    simp [hH]
  have hShiftPiStrip : ∀ {H : ℝ} {z : ℂ}, z ∈ horizStrip H → z + 2 * Real.pi ∈ horizStrip H := by
    intro H z hz
    change |(z + 2 * (Real.pi : ℂ)).im| < H
    have him : (z + 2 * (Real.pi : ℂ)).im = z.im := by simp
    rw [him]
    exact hz
  have hConjMemStrip : ∀ {H : ℝ} {z : ℂ}, z ∈ horizStrip H → starRingEnd ℂ z ∈ horizStrip H := by
    intro H z hz
    change |(starRingEnd ℂ z).im| < H
    rw [Complex.conj_im, abs_neg]
    exact hz
  have hOfRealEq_of_conj : ∀ w : ℂ, starRingEnd ℂ w = w → ((w.re : ℝ) : ℂ) = w := by
    intro w hw
    have him : (starRingEnd ℂ w).im = w.im := congrArg Complex.im hw
    rw [Complex.conj_im] at him
    apply Complex.ext
    · simp
    · simp; linarith
  
  have hs5_pos : 0 < s - 5 * δ := by linarith
  have hs4_pos : 0 < s - 4 * δ := by linarith
  have hs3_pos : 0 < s - 3 * δ := by linarith
  have hs2_pos : 0 < s - 2 * δ := by linarith
  have hs1_pos : 0 < s - δ := by linarith
  have hq_pos_R : (0 : ℝ) < (q : ℝ) := by positivity
  have hl_ge1_R : (1 : ℝ) ≤ (l : ℝ) := by exact_mod_cast hl
  have hpi_gt3 : (3 : ℝ) < Real.pi := Real.pi_gt_three
  have ht₀_pos : 0 < t₀ := by positivity
  have ht₀_lt_d : t₀ < d := by linarith
  have ht₀_lt_d_act : t₀ < S.d_act := lt_of_lt_of_le ht₀_lt_d hd_act
  have ht₀_norm : ‖(t₀ : ℂ)‖ = t₀ := by
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos ht₀_pos]
  have hδ_inv_pos : 0 < δ⁻¹ := inv_pos.mpr hδ0
  have hN_nonneg : (0 : ℝ) ≤ (N : ℝ) := Nat.cast_nonneg N
  have h1_add_δ_le_Q : 1 + δ⁻¹ ≤ Q := by dsimp [Q]; linarith
  have h1_le_1_add_δ : 1 ≤ 1 + δ⁻¹ := by linarith
  have hQ_ge1 : 1 ≤ Q := by linarith
  have hsq_le_Q2 : (1 + δ⁻¹) ^ 2 ≤ Q ^ B_slice := by
    change (1 + δ⁻¹) ^ 2 ≤ Q ^ 2
    gcongr
  have hSlice_bound : 40 * (1 + δ⁻¹) ^ 2 * η_mesh ≤ η_slice := by
    dsimp [η_slice]
    gcongr
  have h40_le_1 : 40 * (1 + δ⁻¹) ^ 2 * η_mesh ≤ 1 := le_trans hSlice_bound hSmall
  have hAdm_bound : 40 * (1 + δ⁻¹) ^ 2 * η_mesh ≤ S.η_adm / 2 := by
    have hη_adm_pos : 0 < S.η_adm := S.η_adm_pos
    have hη_adm_ne : S.η_adm ≠ 0 := hη_adm_pos.ne'
    have h80 : (80 / S.η_adm) * (1 + δ⁻¹) ^ 2 * η_mesh ≤ 1 := by
      have hle : (80 / S.η_adm) * (1 + δ⁻¹) ^ 2 * η_mesh ≤ C_slice * Q ^ B_slice * η_mesh := by
        gcongr
      exact le_trans hle hSmall
    have hmul : (S.η_adm / 2) * ((80 / S.η_adm) * (1 + δ⁻¹) ^ 2 * η_mesh) ≤ S.η_adm / 2 := by
      nlinarith
    have heq : (S.η_adm / 2) * ((80 / S.η_adm) * (1 + δ⁻¹) ^ 2 * η_mesh) =
        40 * (1 + δ⁻¹) ^ 2 * η_mesh := by
      field_simp [hη_adm_ne]
      ring
    linarith
  have hη_small_δ : 16 * η_mesh ≤ δ := by
    have hδ_inv_le_sq : δ⁻¹ ≤ (1 + δ⁻¹) ^ 2 := by nlinarith
    have h40_δinv : 40 * δ⁻¹ * η_mesh ≤ 1 := by
      have hle : 40 * δ⁻¹ * η_mesh ≤ 40 * (1 + δ⁻¹) ^ 2 * η_mesh := by gcongr
      exact le_trans hle h40_le_1
    have hmul : δ * (40 * δ⁻¹ * η_mesh) ≤ δ := by nlinarith
    have heq : δ * (40 * δ⁻¹ * η_mesh) = 40 * η_mesh := by
      field_simp [hδ0.ne']
    linarith
  have h2η_le_quarter_t₀ : 2 * η_mesh ≤ t₀ / 4 := by
    have hq_le_N_R : (q : ℝ) ≤ (N : ℝ) := by exact_mod_cast hqN
    have hq_le_Q : (q : ℝ) ≤ Q := by dsimp [Q]; linarith
    have hq_le_Q2 : (q : ℝ) ≤ Q ^ B_slice := by
      change (q : ℝ) ≤ Q ^ 2
      nlinarith
    have h40q : 40 * (q : ℝ) * η_mesh ≤ 1 := by
      have hle : 40 * (q : ℝ) * η_mesh ≤ C_slice * Q ^ B_slice * η_mesh := by gcongr
      exact le_trans hle hSmall
    have h8q_lt : 8 * η_mesh * (q : ℝ) ≤ 2 * Real.pi * (l : ℝ) := by nlinarith
    have hdiv : 8 * η_mesh ≤ (2 * Real.pi * (l : ℝ)) / (q : ℝ) :=
      (le_div_iff₀ hq_pos_R).mpr h8q_lt
    change 2 * η_mesh ≤ ((2 * Real.pi * (l : ℝ)) / (q : ℝ)) / 4
    linarith
  
  set u : ℂ → ℂ := fun z => U (z, (t₀ : ℂ))
  have hMemDom0 : ∀ z ∈ horizStrip s, (z, (t₀ : ℂ)) ∈ glancingDomain 0 s d := by
    intro z hz
    refine ⟨?_, ?_⟩
    · rw [ht₀_norm]; exact ht₀_lt_d
    · change |z.im| < s - 0 * |(t₀ : ℂ).im|
      have hz' : |z.im| < s := hz
      linarith
  have hu_holo : DifferentiableOn ℂ u (horizStrip s) :=
    hU.1.comp (differentiable_id.prodMk (differentiable_const (t₀ : ℂ))).differentiableOn
      (fun z hz => hMemDom0 z hz)
  have hu_qp : ∀ z ∈ horizStrip s, u (z + 2 * Real.pi) = u z + 2 * Real.pi :=
    fun z hz => hU.2.1 z (t₀ : ℂ) (hMemDom0 z hz)
  have hu_conj : ∀ z ∈ horizStrip s, u (starRingEnd ℂ z) = starRingEnd ℂ (u z) := by
    intro z hz
    have h1 := hU.2.2.2.1 z (t₀ : ℂ) (hMemDom0 z hz)
    rw [Complex.conj_ofReal] at h1
    exact h1
  have hu_iter_adm : ∀ k : ℕ, k ≤ 3 → ∀ z ∈ horizStrip s,
      ‖iteratedDeriv k (fun w : ℂ => u w - w) z‖ ≤ 3 * S.η_adm / 4 :=
    fun k hk z hz => hU.2.2.2.2 k hk z (t₀ : ℂ) (hMemDom0 z hz)
  have hu_deriv : ∀ z ∈ horizStrip s, ‖deriv (fun w : ℂ => u w - w) z‖ ≤ 1 / 4 := by
    intro z hz
    have h1 := hu_iter_adm 1 (by omega) z hz
    rw [iteratedDeriv_one] at h1
    have h2 : S.η_adm ≤ 1 / 32 := S.η_adm_le_inv32
    linarith
  have he_u_lip : ∀ z₁ ∈ horizStrip s, ∀ z₂ ∈ horizStrip s,
      ‖(u z₂ - z₂) - (u z₁ - z₁)‖ ≤ (1 / 4 : ℝ) * ‖z₂ - z₁‖ := by
    intro z₁ hz₁ z₂ hz₂
    have he_holo : DifferentiableOn ℂ (fun w : ℂ => u w - w) (horizStrip s) :=
      hu_holo.sub differentiableOn_id
    exact Convex.norm_image_sub_le_of_norm_deriv_le
      (fun _z hz => he_holo.differentiableAt ((hOpenStrip s).mem_nhds hz))
      hu_deriv (hConvStrip s) hz₁ hz₂
  
  have ht₀_lt_τ₀ : t₀ < B.τ₀ := by
    have h1 : S.d_act < B.τ₀ / 2 := S.d_act_lt_half_τ₀
    have h2 : 0 < B.τ₀ := B.τ₀_pos
    linarith
  obtain ⟨⟨b_star, hb_star, hb_star_per⟩, hAllPer⟩ :=
    B.rational_leaf_all_periodic l q (by omega) (by omega) hCop ht₀_lt_τ₀
  have hIterMonoB : ∀ (m : ℕ) {b₁ b₂ : ℝ},
      b₁ ∈ Set.Ioo 0 B.b₀ → b₂ ∈ Set.Ioo 0 B.b₀ → b₁ < b₂ →
      ∀ z : ℝ, (B.F_col b₁)^[m + 1] z < (B.F_col b₂)^[m + 1] z := by
    intro m
    induction m with
    | zero =>
      intro b₁ b₂ hb₁ hb₂ hlt z
      simpa using B.F_col_strictMono_b b₁ b₂ hb₁.1 hlt hb₂.2 z
    | succ m ih =>
      intro b₁ b₂ hb₁ hb₂ hlt z
      rw [Function.iterate_succ_apply' (B.F_col b₁) (m + 1) z,
          Function.iterate_succ_apply' (B.F_col b₂) (m + 1) z]
      exact lt_trans
        (B.F_col_strictMono_x b₁ hb₁ (ih hb₁ hb₂ hlt z))
        (B.F_col_strictMono_b b₁ b₂ hb₁.1 hlt hb₂.2 ((B.F_col b₂)^[m + 1] z))
  have hϕ_mono : StrictMono B.ϕ := strictMono_of_deriv_pos B.ϕ_deriv_pos
  have hOrbit : ∀ x : ℝ, ∀ j : ℕ, j ≤ q →
      (X_mesh j (x : ℂ)).re = (B.F_col b_star)^[j] ((u (x : ℂ)).re) := by
    intro x
    have hx_Y1 : (x : ℂ) ∈ horizStrip (s - δ) := hRealMemStrip hs1_pos x
    let x_seq : ℕ → ℝ := fun j => (X_mesh j (x : ℂ)).re
    have hx_seq_C : ∀ j : ℕ, j ≤ q → ((x_seq j : ℝ) : ℂ) = X_mesh j (x : ℂ) := by
      intro j hj
      apply hOfRealEq_of_conj
      have hconj := ((hX_mesh.2.1 j hj).2 (x : ℂ) hx_Y1).2.1
      rw [Complex.conj_ofReal] at hconj
      exact hconj.symm
    have hx_0 : x_seq 0 = (u (x : ℂ)).re := by
      dsimp [x_seq]
      rw [(hX_mesh.1 (x : ℂ) hx_Y1).1]
    have hx_q : x_seq q = x_seq 0 + 2 * Real.pi * (l : ℝ) := by
      dsimp [x_seq]
      rw [(hX_mesh.1 (x : ℂ) hx_Y1).2, (hX_mesh.1 (x : ℂ) hx_Y1).1, Complex.add_re,
        Complex.ofReal_re]
    have hx_step : ∀ j : ℕ, j < q →
        0 < x_seq (j + 1) - x_seq j ∧ x_seq (j + 1) - x_seq j ≤ (3 / 2 : ℝ) * S.d_act := by
      intro j hj
      let z_j : ℂ := (x : ℂ) + (j : ℂ) * (t₀ : ℂ)
      let z_j1 : ℂ := (x : ℂ) + ((j + 1 : ℕ) : ℂ) * (t₀ : ℂ)
      have hzj_eq : z_j = ((x + (j : ℝ) * t₀ : ℝ) : ℂ) := by dsimp [z_j]; push_cast; ring
      have hzj1_eq : z_j1 = ((x + ((j + 1 : ℕ) : ℝ) * t₀ : ℝ) : ℂ) := by
        dsimp [z_j1]; push_cast; ring
      have hzj_mem : z_j ∈ horizStrip s := by rw [hzj_eq]; exact hRealMemStrip hs0 _
      have hzj1_mem : z_j1 ∈ horizStrip s := by rw [hzj1_eq]; exact hRealMemStrip hs0 _
      have hsub_z : z_j1 - z_j = (t₀ : ℂ) := by dsimp [z_j1, z_j]; push_cast; ring
      have hlip_u := he_u_lip z_j hzj_mem z_j1 hzj1_mem
      rw [hsub_z, ht₀_norm] at hlip_u
      have hre_lip : |((u z_j1 - z_j1) - (u z_j - z_j)).re| ≤ (1 / 4 : ℝ) * t₀ :=
        le_trans (Complex.abs_re_le_norm _) hlip_u
      have hre_simp : ((u z_j1 - z_j1) - (u z_j - z_j)).re =
          (u z_j1).re - (u z_j).re - t₀ := by
        have hrew : (u z_j1 - z_j1) - (u z_j - z_j) = (u z_j1 - u z_j) - (z_j1 - z_j) := by ring
        rw [hrew, hsub_z]
        simp
      rw [hre_simp, abs_le] at hre_lip
      have hmesh_j := ((hX_mesh.2.1 j (by omega)).2 (x : ℂ) hx_Y1).2.2
      have hmesh_j1 := ((hX_mesh.2.1 (j + 1) (by omega)).2 (x : ℂ) hx_Y1).2.2
      have hre_j : |x_seq j - (u z_j).re| ≤ η_mesh := by
        have h1 : |(X_mesh j (x : ℂ) - u z_j).re| ≤ η_mesh :=
          le_trans (Complex.abs_re_le_norm _) hmesh_j
        rwa [Complex.sub_re] at h1
      have hre_j1 : |x_seq (j + 1) - (u z_j1).re| ≤ η_mesh := by
        have h1 : |(X_mesh (j + 1) (x : ℂ) - u z_j1).re| ≤ η_mesh :=
          le_trans (Complex.abs_re_le_norm _) hmesh_j1
        rwa [Complex.sub_re] at h1
      rw [abs_le] at hre_j hre_j1
      exact ⟨by linarith, by linarith⟩
    have hx_col : ∀ j : ℕ, j < q →
        x_seq (j + 1) - x_seq j < B.δ_col ∧
        0 < B.ϕ (x_seq (j + 1)) - B.ϕ (x_seq j) ∧
        B.ϕ (x_seq (j + 1)) - B.ϕ (x_seq j) < Real.pi :=
      fun j hj => S.real_step_collar (x_seq j) (x_seq (j + 1)) (hx_step j hj).1 (hx_step j hj).2
    obtain ⟨b, ⟨hb_mem, hb_01⟩, _⟩ :=
      B.collar_fills_steps (x_seq 0) (x_seq 1) (hx_step 0 (by omega)).1 (hx_col 0 (by omega)).1
    have hTrack : ∀ j : ℕ, j < q →
        x_seq j = (B.F_col b)^[j] (x_seq 0) ∧
        x_seq (j + 1) = (B.F_col b)^[j + 1] (x_seq 0) := by
      intro j
      induction j with
      | zero =>
        intro _
        exact ⟨rfl, hb_01.symm⟩
      | succ j ih =>
        intro hj1
        obtain ⟨ih0, ih1⟩ := ih (by omega)
        refine ⟨ih1, ?_⟩
        have hz1_eq : x_seq (j + 1) = B.F_col b (x_seq j) := by
          rw [ih1, Function.iterate_succ_apply' (B.F_col b) j (x_seq 0), ← ih0]
        let z₀ : ℝ := x_seq j
        let z₁ : ℝ := x_seq (j + 1)
        let z₂ : ℝ := x_seq (j + 2)
        let z₂' : ℝ := B.F_col b z₁
        have hstep_b := B.F_col_step_bounds b hb_mem z₁
        have hz1_lt_z2' : z₁ < z₂' := by linarith [hstep_b.1]
        have hϕ_pos' : 0 < B.ϕ z₂' - B.ϕ z₁ := sub_pos.mpr (hϕ_mono hz1_lt_z2')
        have hstat_C :
            normAction1_ℂ B (z₁ : ℂ) (z₂ : ℂ) + normAction2_ℂ B (z₀ : ℂ) (z₁ : ℂ) = 0 := by
          dsimp [z₀, z₁, z₂]
          rw [hx_seq_C (j + 1) (by omega), hx_seq_C (j + 2) (by omega), hx_seq_C j (by omega)]
          exact hX_mesh.2.2 j hj1 (x : ℂ) hx_Y1
        have hstat_R : -supportAction1_ℝ B.h (B.ϕ z₁) (B.ϕ z₂) =
            supportAction2_ℝ B.h (B.ϕ z₀) (B.ϕ z₁) :=
          (S.normAction_real_stationary_iff z₀ z₁ z₂).mp hstat_C
        have hstat_R' : -supportAction1_ℝ B.h (B.ϕ z₁) (B.ϕ z₂') =
            supportAction2_ℝ B.h (B.ϕ z₀) (B.ϕ z₁) := by
          dsimp [z₂']
          rw [show z₁ = B.F_col b z₀ from hz1_eq]
          exact B.F_col_stationary b hb_mem z₀
        have hz2_eq : z₂ = z₂' :=
          B.forward_step_unique z₀ z₁ z₂ z₂'
            (hx_col j (by omega)).2.1 (hx_col j (by omega)).2.2
            (hx_col (j + 1) hj1).2.1 (hx_col (j + 1) hj1).2.2
            hϕ_pos' hstep_b.2 hstat_R hstat_R'
        calc
          x_seq (j + 2) = B.F_col b (x_seq (j + 1)) := hz2_eq
          _ = B.F_col b ((B.F_col b)^[j + 1] (x_seq 0)) := by rw [ih1]
          _ = (B.F_col b)^[j + 2] (x_seq 0) :=
            (Function.iterate_succ_apply' (B.F_col b) (j + 1) (x_seq 0)).symm
    have hTrackAll : ∀ j : ℕ, j ≤ q → x_seq j = (B.F_col b)^[j] (x_seq 0) := by
      intro j hj
      rcases lt_or_eq_of_le hj with hj_lt | hj_eq
      · exact (hTrack j hj_lt).1
      · rw [hj_eq]
        have hqm1 : (q - 1) + 1 = q := by omega
        have h1 := (hTrack (q - 1) (by omega)).2
        rwa [hqm1] at h1
    have hb_per_all : ∀ z : ℝ, (B.F_col b)^[q] z = z + 2 * Real.pi * (l : ℝ) :=
      hAllPer b hb_mem ⟨x_seq 0, by rw [← hTrackAll q le_rfl, hx_q]⟩
    have hb_eq : b = b_star := by
      have h0_eq : (B.F_col b)^[q] 0 = (B.F_col b_star)^[q] 0 := by
        rw [hb_per_all 0, hb_star_per 0]
      have hqm1 : (q - 1) + 1 = q := by omega
      rcases lt_trichotomy b b_star with hlt | heq | hgt
      · have hlt0 := hIterMonoB (q - 1) hb_mem hb_star hlt 0
        rw [hqm1] at hlt0
        linarith
      · exact heq
      · have hgt0 := hIterMonoB (q - 1) hb_star hb_mem hgt 0
        rw [hqm1] at hgt0
        linarith
    intro j hj
    rw [← hx_0, ← hb_eq]
    exact hTrackAll j hj
  
  have hStripInvert : ∀ (σ σ' c M : ℝ) (f X : ℂ → ℂ),
      0 < σ' → 0 ≤ M → σ' + 2 * M ≤ σ →
      DifferentiableOn ℂ f (horizStrip σ) →
      (∀ z ∈ horizStrip σ, f (z + 2 * Real.pi) = f z + 2 * Real.pi) →
      (∀ z ∈ horizStrip σ, f (starRingEnd ℂ z) = starRingEnd ℂ (f z)) →
      (∀ z ∈ horizStrip σ, ‖deriv (fun w : ℂ => f w - w) z‖ ≤ 1 / 4) →
      DifferentiableOn ℂ X (horizStrip σ') →
      (∀ y ∈ horizStrip σ', X (y + 2 * Real.pi) = X y + 2 * Real.pi) →
      (∀ y ∈ horizStrip σ', X (starRingEnd ℂ y) = starRingEnd ℂ (X y)) →
      (∀ y ∈ horizStrip σ', ‖X y - f (y + (c : ℂ))‖ ≤ M) →
      (∀ z₁ ∈ horizStrip σ, ∀ z₂ ∈ horizStrip σ, f z₁ = f z₂ → z₁ = z₂) ∧
      ∃ ζ : ℂ → ℂ,
        DifferentiableOn ℂ ζ (horizStrip σ') ∧
        (∀ y ∈ horizStrip σ',
          ζ (y + 2 * Real.pi) = ζ y ∧
          ζ (starRingEnd ℂ y) = starRingEnd ℂ (ζ y) ∧
          ‖ζ y‖ ≤ 2 * M ∧
