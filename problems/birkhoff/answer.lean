            have hsub_eq : (α :: L).length - (k + 1) = (d - (k + 1)) + 1 := by
              simp only [List.length_cons, d]
              omega
            rw [hsub_eq, hR_step, hW_step]
            simp only [Polynomial.coeff_sub, Polynomial.coeff_C_mul, Polynomial.coeff_X_mul]
            rw [ih (k + 1) (by omega), ih k (by omega)]
            have hidx : d - k = d - (k + 1) + 1 := by omega
            rw [hidx]
    let Φ_ps : List ℂ → PowerSeries ℂ :=
