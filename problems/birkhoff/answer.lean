          B_cr.iterDerivYT_holo hU ih 1 0
        have h_pA_D : DifferentiableOn ℂ (pderivA D_f) U :=
          B_cr.iterDerivYT_holo hU hD 1 0
        exact (h_pA_ih.mul hD).sub ((ih.const_mul (((a + 1 : ℕ) : ℂ))).mul h_pA_D)
    have h_quotYT_holo : ∀ {U : Set (ℂ × ℂ)} {D_f N_f : ℂ × ℂ → ℂ},
        IsOpen U → DifferentiableOn ℂ D_f U → DifferentiableOn ℂ N_f U →
        ∀ a b : ℕ, DifferentiableOn ℂ (ssbpcQuotNumYT D_f a b N_f) U := by
      intro U D_f N_f hU hD hN a b
      induction b with
      | zero => exact h_quotY_holo hU hD hN a
      | succ b ih =>
        have h_pD_ih : DifferentiableOn ℂ (pderivD (ssbpcQuotNumYT D_f a b N_f)) U :=
          B_cr.iterDerivYT_holo hU ih 0 1
        have h_pD_D : DifferentiableOn ℂ (pderivD D_f) U :=
          B_cr.iterDerivYT_holo hU hD 0 1
        exact (h_pD_ih.mul hD).sub ((ih.const_mul (((a + b + 1 : ℕ) : ℂ))).mul h_pD_D)
    have h_homog_holo : ∀ {σ : Type} [Fintype σ] {U : Set (ℂ × ℂ)}
