            ∑ m ∈ Finset.range (p.1 0 + p.1 1 + 1), _
          simp_rw [MvPowerSeries.coeff_C_mul]
          symm
          refine Finset.sum_subset (Finset.range_mono (by omega)) ?_
          intro m _ hmp
          rw [Finset.mem_range] at hmp
          rw [hVB2D_pow hZ0 m p.1 (by omega), mul_zero]
        · rfl
      rw [hstep, htail_eq]
      ring
    have hMod_compConst_pert : ∀ {J : ℕ} (φ : PowerSeries ℂ)
        {U : MvPowerSeries (Fin 2) (PowerSeries ℂ)} (δ : MvPowerSeries (Fin 2) ℂ),
