      have h := mul_le_mul_of_nonneg_right hCoeff1 hCK_nn
      linarith only [h]
    have hb2 : 9 * A.C_amp ^ (3 : ℕ) * K ^ (1 / 50 : ℝ) ≤
        9 * (1 + L) ^ 2 * (A.C_amp ^ (3 : ℕ) * K ^ (1 / 50 : ℝ)) := by
      have h := mul_le_mul_of_nonneg_right h1L_ge_one hCK_nn
      linarith only [h]
    have hb3 : (4 * (v + s - w_top) + 1) ^ 2 * A.C_amp ^ (3 : ℕ) * K ^ (1 / 50 : ℝ) ≤
        289 * (1 + L) ^ 2 * (A.C_amp ^ (3 : ℕ) * K ^ (1 / 50 : ℝ)) := by
      have h := mul_le_mul_of_nonneg_right hCoeff3 hCK_nn
      linarith only [h]
    have h_ring3 : (2 * Real.pi)⁻¹ *
        (3 * (∫ x in (0 : ℝ)..(2 * Real.pi), (localAmp S (upperRowPt S v (x + 0)) - localAmp S (upperRowPt S w_top (x + 0))) ^ 2) +
         3 * (∫ x in (0 : ℝ)..(2 * Real.pi), (localAmp S (upperRowPt S w_top (x + u)) - localAmp S (upperRowPt S w_top x)) ^ 2) +
         3 * (∫ x in (0 : ℝ)..(2 * Real.pi), (localAmp S (upperRowPt S (v + s) (x + u)) - localAmp S (upperRowPt S w_top (x + u))) ^ 2)) =
        3 * ((2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi), (localAmp S (upperRowPt S v (x + 0)) - localAmp S (upperRowPt S w_top (x + 0))) ^ 2) +
        3 * ((2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi), (localAmp S (upperRowPt S w_top (x + u)) - localAmp S (upperRowPt S w_top x)) ^ 2) +
        3 * ((2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi), (localAmp S (upperRowPt S (v + s) (x + u)) - localAmp S (upperRowPt S w_top (x + u))) ^ 2) := by ring
    have hBoundL : (2 * Real.pi)⁻¹ *
        (∫ x in (0 : ℝ)..(2 * Real.pi),
          (localAmp S (upperRowPt S (v + s) (x + u)) - localAmp S (upperRowPt S v x)) ^ 2) ≤
        1000 * ((1 + L) ^ 2 * (A.C_amp ^ (3 : ℕ) * K ^ (1 / 50 : ℝ))) := by
      have h_nn : 0 ≤ (1 + L) ^ 2 * (A.C_amp ^ (3 : ℕ) * K ^ (1 / 50 : ℝ)) :=
        mul_nonneg (sq_nonneg _) hCK_nn
      linarith only [hScaled3, h_ring3, hLeg1_raw, hLeg2, hLeg3_raw, hb1, hb2, hb3, h_nn]
    have hFinal := mul_le_mul_of_nonneg_right hLogSqrt hCK_nn
    rw [hRu_def, hd_def] at hFinal
    have h_ringF : 1000 * (16 * (1 + Real.sqrt (|u| / Real.exp (-v))) * (A.C_amp ^ (3 : ℕ) * K ^ (1 / 50 : ℝ))) =
        (16000 * A.C_amp ^ (3 : ℕ) * K ^ (1 / 50 : ℝ)) * (1 + Real.sqrt (|u| / Real.exp (-v))) := by ring
    linarith only [hBoundL, hFinal, h_ringF]
  
  set d : ℝ := Real.exp (-v) with hd_def
  set d' : ℝ := Real.exp (-(v + s)) with hd'_def
  have hd_pos : 0 < d := Real.exp_pos _
  have hd'_pos : 0 < d' := Real.exp_pos _
  have hd'_lt_d : d' < d := by
    rw [hd'_def, hd_def]; exact Real.exp_lt_exp.mpr (by linarith only [hs.1])
  have hd_lt_H : d < S.H := by linarith only [hBandExp v hv_band, hH_pos]
  have hd'_lt_H : d' < S.H := lt_trans hd'_lt_d hd_lt_H
  have hEpsPos : 0 < A.epsK K := Real.exp_pos _
  obtain ⟨ha₁_cont, ha₁_per, hReg_v_tr⟩ := h_reg v hd_lt_H
  obtain ⟨hg₁_cont, hg₁_per⟩ := hReg_v_tr (A.epsK K) hEpsPos
  obtain ⟨ha₂_cont, ha₂_per, hReg_vs_tr⟩ := h_reg (v + s) hd'_lt_H
  obtain ⟨hg₂_cont, hg₂_per⟩ := hReg_vs_tr (A.epsK K) hEpsPos
  let κ : ℝ → ℝ := stripExitKernel (S.H - d') (S.H - d)
  have hκ_cont : Continuous κ := hKern.kernel_cont d d' hd'_pos hd'_lt_d hd_lt_H
  have hκ_nonneg : ∀ u : ℝ, 0 ≤ κ u := fun u => (hKern.kernel_pos d d' hd'_pos hd'_lt_d hd_lt_H u).le
  have hκ_int : MeasureTheory.Integrable κ MeasureTheory.volume :=
    hKern.kernel_integrable d d' hd'_pos hd'_lt_d hd_lt_H
  have hκ_one : (∫ u : ℝ, κ u) = 1 :=
    hKern.kernel_integral_one d d' hd'_pos hd'_lt_d hd_lt_H
  have hκ_tail : ∀ R : ℝ, 0 < R → (∫ u in {u : ℝ | R * d < |u|}, κ u) ≤ 1 / R :=
    fun R hR => hKern.kernel_tail_le d d' R hd'_pos hd'_lt_d hd_lt_H hR
  obtain ⟨_hM_nn, hM_glob, hMκ_int, hSplit⟩ := h_s3
    (fun x => truncLogSpeed S (A.epsK K) (upperRowPt S v x))
    (fun x => truncLogSpeed S (A.epsK K) (upperRowPt S (v + s) x))
    (fun x => localAmp S (upperRowPt S v x))
    (fun x => localAmp S (upperRowPt S (v + s) x))
    κ hg₁_cont hg₁_per hg₂_cont hg₂_per ha₁_cont ha₁_per ha₂_cont ha₂_per
    hκ_cont hκ_nonneg hκ_int hκ_one
  have hRowGlob : ∀ w ∈ Set.Icc K (2 * K), ∀ x : ℝ,
      |localAmp S (upperRowPt S w x)| ≤ A.C_glob * K ^ (3 : ℕ) := by
    intro w hw x
    refine A.global_amp_poly_bound K hK_amp_le (upperRowPt S w x) ?_
    simp only [upperRowPt, Complex.add_im, Complex.ofReal_im, Complex.ofReal_re,
      Complex.mul_im, Complex.I_re, Complex.I_im, mul_one, mul_zero, add_zero, zero_add]
    have hw_lt : Real.exp (-w) < S.H := by linarith only [hBandExp w hw, hH_pos]
    rw [abs_of_pos (sub_pos.mpr hw_lt)]
    have hexp_ge : Real.exp (-(41 / 20 : ℝ) * K) ≤ Real.exp (-w) :=
      Real.exp_le_exp.mpr (by linarith only [hw.2, hK200])
    linarith only [hexp_ge]
  have hBglob_nn : 0 ≤ A.C_glob * K ^ (3 : ℕ) :=
    mul_nonneg (le_trans zero_le_one A.one_le_C_glob) (by positivity)
  have hTailAll : ∀ u : ℝ,
      ((2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi),
        (localAmp S (upperRowPt S (v + s) (x + u)) - localAmp S (upperRowPt S v x)) ^ 2) ≤
        4 * A.C_glob ^ (2 : ℕ) * K ^ (6 : ℕ) := by
    intro u
    have h1 := hM_glob (A.C_glob * K ^ (3 : ℕ)) hBglob_nn
      (hRowGlob v hv_band) (hRowGlob (v + s) hvs_band) u
    have h2 : 4 * (A.C_glob * K ^ (3 : ℕ)) ^ (2 : ℕ) = 4 * A.C_glob ^ (2 : ℕ) * K ^ (6 : ℕ) := by ring
    linarith only [h1, h2]
  have hK50_nn : 0 ≤ K ^ (1 / 50 : ℝ) := Real.rpow_nonneg (by linarith only [hK200]) _
  set B_mod : ℝ := 16000 * A.C_amp ^ (3 : ℕ) * K ^ (1 / 50 : ℝ) with hB_mod_def
  set B_tail : ℝ := 4 * A.C_glob ^ (2 : ℕ) * K ^ (6 : ℕ) with hB_tail_def
  have hB_mod_nn : 0 ≤ B_mod := by rw [hB_mod_def]; exact mul_nonneg (by positivity) hK50_nn
  have hB_tail_nn : 0 ≤ B_tail := by rw [hB_tail_def]; positivity
  have hIntMK_le := h_s4 d K B_mod B_tail
    (fun u => (2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi),
      (localAmp S (upperRowPt S (v + s) (x + u)) - localAmp S (upperRowPt S v x)) ^ 2)
    κ hd_pos hB_mod_nn hB_tail_nn hκ_nonneg hκ_int hMκ_int hκ_one hκ_tail
    hModBound (fun u _ => hTailAll u)
  have hTailCrush : B_tail * Real.exp (-K / 20) ≤ 1 := by
    rw [hB_tail_def]
    have hK_nn : 0 ≤ K := by linarith only [hK200]
    have h_fac := Real.pow_div_factorial_le_exp (K / 20) (by linarith only [hK200]) 7
    have h_mulK6 : 4 * ((7 : ℕ).factorial : ℝ) * (20 : ℝ) ^ (7 : ℕ) * A.C_glob ^ (2 : ℕ) * K ^ (6 : ℕ) ≤
        K ^ (7 : ℕ) := by
      have h := mul_le_mul_of_nonneg_right hK_tail_le (pow_nonneg hK_nn 6)
      have hr : K * K ^ (6 : ℕ) = K ^ (7 : ℕ) := by ring
      linarith only [h, hr]
    have h_le_pow : 4 * A.C_glob ^ (2 : ℕ) * K ^ (6 : ℕ) ≤
        (K / 20) ^ (7 : ℕ) / ((7 : ℕ).factorial : ℝ) := by
      rw [div_pow, div_div]
      exact (le_div_iff₀ (by positivity)).mpr (by linarith only [h_mulK6])
    have h_le_exp : 4 * A.C_glob ^ (2 : ℕ) * K ^ (6 : ℕ) ≤ Real.exp (K / 20) :=
      le_trans h_le_pow h_fac
    have hexp_pos : 0 < Real.exp (K / 20) := Real.exp_pos _
    calc (4 * A.C_glob ^ (2 : ℕ) * K ^ (6 : ℕ)) * Real.exp (-K / 20)
        = (4 * A.C_glob ^ (2 : ℕ) * K ^ (6 : ℕ)) * (Real.exp (K / 20))⁻¹ := by
          rw [neg_div, Real.exp_neg]
      _ ≤ Real.exp (K / 20) * (Real.exp (K / 20))⁻¹ :=
          mul_le_mul_of_nonneg_right h_le_exp (inv_nonneg.mpr hexp_pos.le)
      _ = 1 := mul_inv_cancel₀ hexp_pos.ne'
  have hDef_v : (2 * Real.pi)⁻¹ *
      (∫ x in (0 : ℝ)..(2 * Real.pi),
        (localAmp S (upperRowPt S v x) -
          truncLogSpeed S (A.epsK K) (upperRowPt S v x)) ^ 2) ≤
      A.C_amp * K ^ (1 / 50 : ℝ) :=
    (A.small_moment_row_l2 K hK_amp_le hSmall v hv_band).2.2.2
  have hDef_vs : (2 * Real.pi)⁻¹ *
      (∫ x in (0 : ℝ)..(2 * Real.pi),
        (localAmp S (upperRowPt S (v + s) x) -
          truncLogSpeed S (A.epsK K) (upperRowPt S (v + s) x)) ^ 2) ≤
      A.C_amp * K ^ (1 / 50 : ℝ) :=
    (A.small_moment_row_l2 K hK_amp_le hSmall (v + s) hvs_band).2.2.2
  have hOne_le_K50 : 1 ≤ K ^ (1 / 50 : ℝ) :=
    Real.one_le_rpow (by linarith only [hK200]) (by norm_num)
  have hC_amp_le_cube : A.C_amp ≤ A.C_amp ^ (3 : ℕ) := by
    nlinarith only [hC_amp_ge1, sq_nonneg (A.C_amp - 1)]
  have hOne_le_cube : 1 ≤ A.C_amp ^ (3 : ℕ) := le_trans hC_amp_ge1 hC_amp_le_cube
  have hOne_le_CK : 1 ≤ A.C_amp ^ (3 : ℕ) * K ^ (1 / 50 : ℝ) := by
    nlinarith only [hOne_le_cube, hOne_le_K50]
  have hCK_le_cube : A.C_amp * K ^ (1 / 50 : ℝ) ≤ A.C_amp ^ (3 : ℕ) * K ^ (1 / 50 : ℝ) :=
    mul_le_mul_of_nonneg_right hC_amp_le_cube hK50_nn
  change (2 * Real.pi)⁻¹ *
      (∫ x in (0 : ℝ)..(2 * Real.pi),
        ∫ u : ℝ,
          (truncLogSpeed S (A.epsK K) (upperRowPt S (v + s) (x + u)) -
            truncLogSpeed S (A.epsK K) (upperRowPt S v x)) ^ 2 * κ u) ≤
      C_inc * K ^ (1 / 50 : ℝ)
  rw [hB_mod_def] at hIntMK_le
  rw [hC_inc_def]
  have hCK_nn : 0 ≤ A.C_amp ^ (3 : ℕ) * K ^ (1 / 50 : ℝ) := mul_nonneg (by positivity) hK50_nn
  linarith only [hSplit, hDef_vs, hDef_v, hIntMK_le, hTailCrush, hOne_le_CK, hCK_le_cube, hCK_nn]

theorem step_grid_tanaka_slice_bound (S : FiniteWallNonisotropicStrip)
    (hTanaka : DiscreteTanakaProp)
    (hKern : StripExitKernelData S)
    (K ε C_inc s : ℝ)
    (hK : 200 ≤ K)
    (hDepth : Real.exp (-K) < S.H / 4)
    (hε : 0 < ε)
    (hC : 0 < C_inc)
    (hs : s ∈ Set.Icc (2 : ℝ) 4)
    (hInt : MeasureTheory.IntegrableOn
      (fun v : ℝ => (2 * Real.pi)⁻¹ *
        ∫ x in (0 : ℝ)..(2 * Real.pi), stepOccupDensity S ε (K ^ (3 / 50 : ℝ)) s x v)
      (Set.Icc ((11 / 10 : ℝ) * K) ((19 / 10 : ℝ) * K + 8)) MeasureTheory.volume)
    (hStep : ∀ v ∈ Set.Icc ((11 / 10 : ℝ) * K) ((49 / 25 : ℝ) * K),
      (2 * Real.pi)⁻¹ *
        (∫ x in (0 : ℝ)..(2 * Real.pi),
          ∫ u : ℝ,
            (truncLogSpeed S ε (upperRowPt S (v + s) (x + u)) -
              truncLogSpeed S ε (upperRowPt S v x)) ^ 2 *
            stripExitKernel (S.H - Real.exp (-(v + s))) (S.H - Real.exp (-v)) u) ≤
        C_inc * K ^ (1 / 50 : ℝ)) :
    (∫ v in ((11 / 10 : ℝ) * K)..((19 / 10 : ℝ) * K),
      (2 * Real.pi)⁻¹ *
        ∫ x in (0 : ℝ)..(2 * Real.pi), stepOccupDensity S ε (K ^ (3 / 50 : ℝ)) s x v) ≤
      (100 * (3 + 2 * Real.sqrt C_inc) + 16 * C_inc) * K ^ (47 / 50 : ℝ) :=
by
  let h₀ : ℝ := K ^ (3 / 50 : ℝ)
  let R : ℝ := K ^ (3 / 5 : ℝ)
  let q : ℝ := (4 / 5 : ℝ) * K / s
  let M : ℕ := Nat.floor q + 1
  let c : ℕ → ℝ := fun m => (11 / 10 : ℝ) * K + (m : ℝ) * s
  let O : ℝ → ℝ := fun v =>
    (2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi), stepOccupDensity S ε h₀ s x v
  let stepVar : ℝ → ℝ := fun v =>
    (2 * Real.pi)⁻¹ *
      ∫ x in (0 : ℝ)..(2 * Real.pi),
        ∫ u : ℝ,
          (truncLogSpeed S ε (upperRowPt S (v + s) (x + u)) -
            truncLogSpeed S ε (upperRowPt S v x)) ^ 2 *
          stripExitKernel (S.H - Real.exp (-(v + s))) (S.H - Real.exp (-v)) u
  let B_chain : ℝ := (25 * (3 + 2 * Real.sqrt C_inc) + 4 * C_inc) * K ^ (47 / 50 : ℝ)
  
  have hs_lo : 2 ≤ s := hs.1
  have hs_hi : s ≤ 4 := hs.2
  have hs_pos : 0 < s := by linarith
  have hs_nonneg : 0 ≤ s := by linarith
  have hK_pos : 0 < K := by linarith
  have hK_ge_one : 1 ≤ K := by linarith
  have hh₀_pos : 0 < h₀ := Real.rpow_pos_of_pos hK_pos _
  have hR_pos : 0 < R := Real.rpow_pos_of_pos hK_pos _
  have h4_le_K27 : (4 : ℝ) ≤ K ^ (27 / 50 : ℝ) := by
    calc (4 : ℝ) = Real.sqrt ((4 : ℝ) ^ 2) := (Real.sqrt_sq (by norm_num)).symm
      _ ≤ Real.sqrt K := Real.sqrt_le_sqrt (by linarith)
      _ ≤ K ^ (27 / 50 : ℝ) := by
          rw [Real.sqrt_eq_rpow]
          exact Real.rpow_le_rpow_of_exponent_le hK_ge_one (by norm_num)
  have h4h₀_le_R : 4 * h₀ ≤ R := by
    calc 4 * h₀ ≤ K ^ (27 / 50 : ℝ) * K ^ (3 / 50 : ℝ) :=
          mul_le_mul_of_nonneg_right h4_le_K27 (le_of_lt hh₀_pos)
      _ = K ^ ((27 / 50 : ℝ) + (3 / 50 : ℝ)) := (Real.rpow_add hK_pos _ _).symm
      _ = R := by dsimp only [R]; norm_num
  have hh₀_lt_R : h₀ < R := by linarith
  have hR_sub_ge : (1 / 2 : ℝ) * R ≤ R - h₀ := by linarith
  have hR_sq_sub : (1 / 4 : ℝ) * R ^ 2 ≤ (R - h₀) ^ 2 := by nlinarith
  have hq_nonneg : 0 ≤ q := by
    dsimp only [q]
    positivity
  have hqs : q * s = (4 / 5 : ℝ) * K := by
    dsimp only [q]
    exact div_mul_cancel₀ _ (ne_of_gt hs_pos)
  have hq_le : q ≤ (2 / 5 : ℝ) * K := by
    have h1 : q * s ≤ ((2 / 5 : ℝ) * K) * s := by nlinarith [hqs, hs_lo, hK_pos]
    exact le_of_mul_le_mul_right h1 hs_pos
  have hfloor_le_q : (Nat.floor q : ℝ) ≤ q := Nat.floor_le hq_nonneg
  have hM_cast : (M : ℝ) = (Nat.floor q : ℝ) + 1 := by
    dsimp only [M]
    push_cast
    rfl
  have hM_le_K : (M : ℝ) ≤ K := by linarith
  have hM_nonneg : (0 : ℝ) ≤ (M : ℝ) := Nat.cast_nonneg M
  have hMs_gt : (4 / 5 : ℝ) * K < (M : ℝ) * s := by
    have hlt : q < (M : ℝ) := by
      rw [hM_cast]
      exact Nat.lt_floor_add_one q
    nlinarith [hqs, hs_pos, hlt]
  have hMs_le : (M : ℝ) * s ≤ (4 / 5 : ℝ) * K + 4 := by
    have hfl_s : (Nat.floor q : ℝ) * s ≤ (4 / 5 : ℝ) * K := by
      nlinarith [hfloor_le_q, hs_pos, hqs]
    nlinarith [hM_cast, hfl_s, hs_hi]
  have hc0 : c 0 = (11 / 10 : ℝ) * K := by
    dsimp only [c]
    simp
  have hc_succ : ∀ m : ℕ, c (m + 1) = c m + s := by
    intro m
    dsimp only [c]
    push_cast
    ring
  have hcM_gt : (19 / 10 : ℝ) * K < c M := by
    dsimp only [c]
    linarith
  have hcM_le4 : c M ≤ (19 / 10 : ℝ) * K + 4 := by
    dsimp only [c]
    linarith
  have hc_ge_v0 : ∀ m : ℕ, (11 / 10 : ℝ) * K ≤ c m := by
    intro m
    dsimp only [c]
    have hm0 : (0 : ℝ) ≤ (m : ℝ) := Nat.cast_nonneg m
    nlinarith
  have hc_le_hi : ∀ m < M, c m ≤ (19 / 10 : ℝ) * K := by
    intro m hm
    have hm_le : m ≤ Nat.floor q := Nat.lt_succ_iff.mp hm
    have hm_cast : (m : ℝ) ≤ q := le_trans (Nat.cast_le.mpr hm_le) hfloor_le_q
    have hms : (m : ℝ) * s ≤ (4 / 5 : ℝ) * K := by nlinarith [hm_cast, hs_pos, hqs]
    dsimp only [c]
    linarith
  have h_band_cap : (19 / 10 : ℝ) * K + 4 ≤ (49 / 25 : ℝ) * K := by linarith
  have h_depth_v : ∀ v : ℝ, K ≤ v →
      0 < Real.exp (-(v + s)) ∧
      Real.exp (-(v + s)) < Real.exp (-v) ∧
      Real.exp (-v) < S.H := by
    intro v hv
    have h1 : 0 < Real.exp (-(v + s)) := Real.exp_pos _
    have h2 : Real.exp (-(v + s)) < Real.exp (-v) := Real.exp_lt_exp.mpr (by linarith)
    have h3 : Real.exp (-v) ≤ Real.exp (-K) := Real.exp_le_exp.mpr (by linarith)
    have h4 : Real.exp (-v) < S.H := by linarith [hDepth, S.H_pos]
    exact ⟨h1, h2, h4⟩
  
  have h_row_mem : ∀ w : ℝ, Real.exp (-w) < S.H → ∀ x : ℝ,
      upperRowPt S w x ∈ horizStrip S.H := by
    intro w hw x
    change |(upperRowPt S w x).im| < S.H
    simp only [upperRowPt, Complex.add_im, Complex.ofReal_im, Complex.mul_im, Complex.ofReal_re,
      Complex.I_re, Complex.I_im, mul_one, mul_zero, add_zero, zero_add]
    exact abs_lt.mpr ⟨by linarith [Real.exp_pos (-w), S.H_pos], by linarith [Real.exp_pos (-w)]⟩
  have h_row_cont : ∀ w : ℝ, Real.exp (-w) < S.H →
      Continuous (fun x : ℝ => truncLogSpeed S ε (upperRowPt S w x)) := by
    intro w hw
    have hpt_cont : Continuous (fun x : ℝ => upperRowPt S w x) := by
      unfold upperRowPt
      exact Complex.continuous_ofReal.add continuous_const
    have hf_cont : Continuous (fun x : ℝ => S.f (upperRowPt S w x)) :=
      S.f_holo.continuousOn.comp_continuous hpt_cont (h_row_mem w hw)
    have hmax_cont : Continuous (fun x : ℝ => max ‖S.f (upperRowPt S w x)‖ ε) :=
      hf_cont.norm.max continuous_const
    unfold truncLogSpeed
    exact Continuous.log hmax_cont (fun x => ne_of_gt (lt_of_lt_of_le hε (le_max_right _ _)))
  have h_row_per : ∀ w : ℝ, Real.exp (-w) < S.H →
      Function.Periodic (fun x : ℝ => truncLogSpeed S ε (upperRowPt S w x)) (2 * Real.pi) := by
    intro w hw x
    have hpt_shift : upperRowPt S w (x + 2 * Real.pi) = upperRowPt S w x + 2 * Real.pi := by
      unfold upperRowPt
      push_cast
      ring
    simp only [truncLogSpeed, hpt_shift, S.f_periodic (upperRowPt S w x) (h_row_mem w hw x)]
  
  have hO_nonneg : ∀ v : ℝ, K ≤ v → 0 ≤ O v := by
    intro v hv
    obtain ⟨hd'0, hd'_lt_d, hd_lt_H⟩ := h_depth_v v hv
    dsimp only [O]
    refine mul_nonneg (by positivity) (intervalIntegral.integral_nonneg (by positivity) ?_)
    intro x _
    unfold stepOccupDensity
    split_ifs
    · refine MeasureTheory.integral_nonneg (fun u => ?_)
      exact mul_nonneg (le_min (sq_nonneg _) (sq_nonneg _))
        (le_of_lt (hKern.kernel_pos _ _ hd'0 hd'_lt_d hd_lt_H u))
    · exact le_rfl
  have hStepVar_nonneg : ∀ v : ℝ, K ≤ v → 0 ≤ stepVar v := by
    intro v hv
    obtain ⟨hd'0, hd'_lt_d, hd_lt_H⟩ := h_depth_v v hv
    dsimp only [stepVar]
    refine mul_nonneg (by positivity) (intervalIntegral.integral_nonneg (by positivity) ?_)
    intro x _
    refine MeasureTheory.integral_nonneg (fun u => ?_)
    exact mul_nonneg (sq_nonneg _)
      (le_of_lt (hKern.kernel_pos _ _ hd'0 hd'_lt_d hd_lt_H u))
  
  have hK_mul_1_50 : K * K ^ (1 / 50 : ℝ) = K ^ (51 / 50 : ℝ) := by
    calc K * K ^ (1 / 50 : ℝ) = K ^ (1 : ℝ) * K ^ (1 / 50 : ℝ) := by rw [Real.rpow_one]
      _ = K ^ ((1 : ℝ) + (1 / 50 : ℝ)) := (Real.rpow_add hK_pos _ _).symm
      _ = K ^ (51 / 50 : ℝ) := by norm_num
  have hsqrt_K51 : Real.sqrt (K ^ (51 / 50 : ℝ)) = K ^ (51 / 100 : ℝ) := by
    rw [Real.sqrt_eq_rpow, ← Real.rpow_mul (le_of_lt hK_pos)]
    norm_num
  have hh₀_sq_le : h₀ * h₀ ≤ K ^ (47 / 50 : ℝ) := by
    calc h₀ * h₀ = K ^ ((3 / 50 : ℝ) + (3 / 50 : ℝ)) := (Real.rpow_add hK_pos _ _).symm
      _ ≤ K ^ (47 / 50 : ℝ) := Real.rpow_le_rpow_of_exponent_le hK_ge_one (by norm_num)
  have hh₀_R_le : h₀ * R ≤ K ^ (47 / 50 : ℝ) := by
    calc h₀ * R = K ^ ((3 / 50 : ℝ) + (3 / 5 : ℝ)) := (Real.rpow_add hK_pos _ _).symm
      _ ≤ K ^ (47 / 50 : ℝ) := Real.rpow_le_rpow_of_exponent_le hK_ge_one (by norm_num)
  have hh₀_K51_le : h₀ * K ^ (51 / 100 : ℝ) ≤ K ^ (47 / 50 : ℝ) := by
    calc h₀ * K ^ (51 / 100 : ℝ) = K ^ ((3 / 50 : ℝ) + (51 / 100 : ℝ)) :=
          (Real.rpow_add hK_pos _ _).symm
      _ ≤ K ^ (47 / 50 : ℝ) := Real.rpow_le_rpow_of_exponent_le hK_ge_one (by norm_num)
  have hK_post_eq : K * h₀ ^ 2 * K ^ (51 / 50 : ℝ) = K ^ (47 / 50 : ℝ) * R ^ 2 := by
    have hR2 : R ^ 2 = K ^ (6 / 5 : ℝ) := by
      calc R ^ 2 = K ^ (3 / 5 : ℝ) * K ^ (3 / 5 : ℝ) := sq R
        _ = K ^ ((3 / 5 : ℝ) + (3 / 5 : ℝ)) := (Real.rpow_add hK_pos _ _).symm
        _ = K ^ (6 / 5 : ℝ) := by norm_num
    have hh₀2 : h₀ ^ 2 = K ^ (6 / 50 : ℝ) := by
      calc h₀ ^ 2 = K ^ (3 / 50 : ℝ) * K ^ (3 / 50 : ℝ) := sq h₀
        _ = K ^ ((3 / 50 : ℝ) + (3 / 50 : ℝ)) := (Real.rpow_add hK_pos _ _).symm
        _ = K ^ (6 / 50 : ℝ) := by norm_num
    calc K * h₀ ^ 2 * K ^ (51 / 50 : ℝ)
        = K ^ (1 : ℝ) * K ^ (6 / 50 : ℝ) * K ^ (51 / 50 : ℝ) := by rw [Real.rpow_one, hh₀2]
      _ = K ^ ((1 : ℝ) + (6 / 50 : ℝ) + (51 / 50 : ℝ)) := by
          rw [← Real.rpow_add hK_pos, ← Real.rpow_add hK_pos]
      _ = K ^ ((47 / 50 : ℝ) + (6 / 5 : ℝ)) := by norm_num
      _ = K ^ (47 / 50 : ℝ) * K ^ (6 / 5 : ℝ) := Real.rpow_add hK_pos _ _
      _ = K ^ (47 / 50 : ℝ) * R ^ 2 := by rw [hR2]
  
  have h_chain_bound : ∀ t ∈ Set.Icc (0 : ℝ) s,
      (∑ m ∈ Finset.range M, O (t + c m)) ≤ B_chain := by
    intro t ht
    let g : ℕ → ℝ → ℝ := fun m x => truncLogSpeed S ε (upperRowPt S (t + c m) x)
    let κ : ℕ → ℝ → ℝ := fun m u =>
      stripExitKernel (S.H - Real.exp (-(t + c m + s))) (S.H - Real.exp (-(t + c m))) u
    have htc : ∀ m : ℕ, t + c (m + 1) = t + c m + s := by
      intro m
      rw [hc_succ m, ← add_assoc]
    have hK_le_tc : ∀ m : ℕ, K ≤ t + c m := by
      intro m
      linarith [ht.1, hc_ge_v0 m]
    have h_tan := hTanaka M h₀ R g κ hh₀_pos hh₀_lt_R
      (fun m _ => h_row_cont (t + c m) (h_depth_v (t + c m) (hK_le_tc m)).2.2)
      (fun m _ => h_row_per (t + c m) (h_depth_v (t + c m) (hK_le_tc m)).2.2)
      (fun m _ => by
        obtain ⟨hd'0, hd'_lt_d, hd_lt_H⟩ := h_depth_v (t + c m) (hK_le_tc m)
        exact hKern.kernel_cont _ _ hd'0 hd'_lt_d hd_lt_H)
      (fun m _ u => by
        obtain ⟨hd'0, hd'_lt_d, hd_lt_H⟩ := h_depth_v (t + c m) (hK_le_tc m)
        exact le_of_lt (hKern.kernel_pos _ _ hd'0 hd'_lt_d hd_lt_H u))
      (fun m _ => by
        obtain ⟨hd'0, hd'_lt_d, hd_lt_H⟩ := h_depth_v (t + c m) (hK_le_tc m)
        exact hKern.kernel_integrable _ _ hd'0 hd'_lt_d hd_lt_H)
      (fun m _ => by
        obtain ⟨hd'0, hd'_lt_d, hd_lt_H⟩ := h_depth_v (t + c m) (hK_le_tc m)
        exact hKern.kernel_integral_one _ _ hd'0 hd'_lt_d hd_lt_H)
      (fun m _ x => by
        dsimp only [g, κ]
        rw [htc m]
        exact hKern.trunc_submean ε (t + c m) (t + c m + s) x hε (by linarith)
          (h_depth_v (t + c m) (hK_le_tc m)).2.2)
    have h_lhs_eq : (∑ m ∈ Finset.range M, O (t + c m)) =
        ∑ m ∈ Finset.range M,
          (2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi),
            (if |g m x| ≤ h₀ then
              ∫ u : ℝ, min ((g (m + 1) (x + u) - g m x) ^ 2) (h₀ ^ 2) * κ m u
            else 0) := by
      refine Finset.sum_congr rfl (fun m _ => ?_)
      dsimp only [O, stepOccupDensity, g, κ]
      simp only [htc m]
    let V : ℝ := ∑ m ∈ Finset.range M, stepVar (t + c m)
    have hV_eq : V =
        ∑ m ∈ Finset.range M,
          (2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi),
            (∫ u : ℝ, (g (m + 1) (x + u) - g m x) ^ 2 * κ m u) := by
      dsimp only [V]
      refine Finset.sum_congr rfl (fun m _ => ?_)
      dsimp only [stepVar, g, κ]
      simp only [htc m]
    rw [← h_lhs_eq, ← hV_eq] at h_tan
    have hV_nonneg : 0 ≤ V :=
      Finset.sum_nonneg (fun m _ => hStepVar_nonneg (t + c m) (hK_le_tc m))
    have hV_le : V ≤ C_inc * K ^ (51 / 50 : ℝ) := by
      have h_sum_le : V ≤ ∑ _m ∈ Finset.range M, (C_inc * K ^ (1 / 50 : ℝ)) := by
        refine Finset.sum_le_sum (fun m hm => ?_)
        have hm_lt : m < M := Finset.mem_range.mp hm
        have h_mem_band : t + c m ∈ Set.Icc ((11 / 10 : ℝ) * K) ((49 / 25 : ℝ) * K) := by
          refine ⟨by linarith [ht.1, hc_ge_v0 m], ?_⟩
          linarith [ht.2, hs_hi, hc_le_hi m hm_lt, h_band_cap]
        exact hStep (t + c m) h_mem_band
      have h_const_sum : (∑ _m ∈ Finset.range M, (C_inc * K ^ (1 / 50 : ℝ))) =
          (M : ℝ) * (C_inc * K ^ (1 / 50 : ℝ)) := by
        rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
      have h_step_nonneg : 0 ≤ C_inc * K ^ (1 / 50 : ℝ) :=
        mul_nonneg (le_of_lt hC) (Real.rpow_nonneg (le_of_lt hK_pos) _)
      calc V ≤ (M : ℝ) * (C_inc * K ^ (1 / 50 : ℝ)) := by linarith [h_sum_le, h_const_sum]
        _ ≤ K * (C_inc * K ^ (1 / 50 : ℝ)) :=
            mul_le_mul_of_nonneg_right hM_le_K h_step_nonneg
        _ = C_inc * (K * K ^ (1 / 50 : ℝ)) := by ring
        _ = C_inc * K ^ (51 / 50 : ℝ) := by rw [hK_mul_1_50]
    have hsqrt_V_le : Real.sqrt V ≤ Real.sqrt C_inc * K ^ (51 / 100 : ℝ) := by
      calc Real.sqrt V ≤ Real.sqrt (C_inc * K ^ (51 / 50 : ℝ)) := Real.sqrt_le_sqrt hV_le
        _ = Real.sqrt C_inc * Real.sqrt (K ^ (51 / 50 : ℝ)) := Real.sqrt_mul (le_of_lt hC) _
        _ = Real.sqrt C_inc * K ^ (51 / 100 : ℝ) := by rw [hsqrt_K51]
    have hh₀_sqrtV_le : h₀ * Real.sqrt V ≤ Real.sqrt C_inc * K ^ (47 / 50 : ℝ) := by
      calc h₀ * Real.sqrt V ≤ h₀ * (Real.sqrt C_inc * K ^ (51 / 100 : ℝ)) :=
            mul_le_mul_of_nonneg_left hsqrt_V_le (le_of_lt hh₀_pos)
        _ = Real.sqrt C_inc * (h₀ * K ^ (51 / 100 : ℝ)) := by ring
        _ ≤ Real.sqrt C_inc * K ^ (47 / 50 : ℝ) :=
            mul_le_mul_of_nonneg_left hh₀_K51_le (Real.sqrt_nonneg _)
    have h_term1 : 25 * h₀ * (h₀ + 2 * R + 2 * Real.sqrt V) ≤
        25 * (3 + 2 * Real.sqrt C_inc) * K ^ (47 / 50 : ℝ) := by
      have hexp : 25 * h₀ * (h₀ + 2 * R + 2 * Real.sqrt V) =
          25 * (h₀ * h₀ + 2 * (h₀ * R) + 2 * (h₀ * Real.sqrt V)) := by ring
      linarith [hexp, hh₀_sq_le, hh₀_R_le, hh₀_sqrtV_le]
    have h_term2 : (M : ℝ) * h₀ ^ 2 * V / (R - h₀) ^ 2 ≤
        4 * C_inc * K ^ (47 / 50 : ℝ) := by
      have hnum_nonneg : 0 ≤ (M : ℝ) * h₀ ^ 2 * V :=
        mul_nonneg (mul_nonneg hM_nonneg (sq_nonneg h₀)) hV_nonneg
      have hR2_pos : 0 < R ^ 2 := sq_pos_of_pos hR_pos
      have hnum_le : (M : ℝ) * h₀ ^ 2 * V ≤ C_inc * K ^ (47 / 50 : ℝ) * R ^ 2 := by
        calc (M : ℝ) * h₀ ^ 2 * V ≤ K * h₀ ^ 2 * V :=
              mul_le_mul_of_nonneg_right
                (mul_le_mul_of_nonneg_right hM_le_K (sq_nonneg h₀)) hV_nonneg
          _ ≤ K * h₀ ^ 2 * (C_inc * K ^ (51 / 50 : ℝ)) :=
              mul_le_mul_of_nonneg_left hV_le (mul_nonneg (le_of_lt hK_pos) (sq_nonneg h₀))
          _ = C_inc * (K * h₀ ^ 2 * K ^ (51 / 50 : ℝ)) := by ring
          _ = C_inc * (K ^ (47 / 50 : ℝ) * R ^ 2) := by rw [hK_post_eq]
          _ = C_inc * K ^ (47 / 50 : ℝ) * R ^ 2 := by ring
      calc (M : ℝ) * h₀ ^ 2 * V / (R - h₀) ^ 2
          ≤ (M : ℝ) * h₀ ^ 2 * V / ((1 / 4 : ℝ) * R ^ 2) :=
            div_le_div_of_nonneg_left hnum_nonneg (by positivity) hR_sq_sub
        _ = (4 * ((M : ℝ) * h₀ ^ 2 * V)) * (R ^ 2)⁻¹ := by ring
        _ ≤ (4 * (C_inc * K ^ (47 / 50 : ℝ) * R ^ 2)) * (R ^ 2)⁻¹ :=
            mul_le_mul_of_nonneg_right (by linarith [hnum_le]) (by positivity)
        _ = (4 * C_inc * K ^ (47 / 50 : ℝ)) * R ^ 2 / R ^ 2 := by ring
        _ = 4 * C_inc * K ^ (47 / 50 : ℝ) :=
            mul_div_cancel_right₀ _ (ne_of_gt hR2_pos)
    dsimp only [B_chain]
    linarith [h_tan, h_term1, h_term2]
  
  have hO_int : ∀ a b : ℝ, (11 / 10 : ℝ) * K ≤ a → a ≤ b → b ≤ (19 / 10 : ℝ) * K + 8 →
      IntervalIntegrable O MeasureTheory.volume a b := by
    intro a b ha hab hb
    rw [intervalIntegrable_iff_integrableOn_Icc_of_le hab]
    exact hInt.mono_set (fun v hv => ⟨le_trans ha hv.1, le_trans hv.2 hb⟩)
  have hO_int_adj : ∀ m < M,
      IntervalIntegrable O MeasureTheory.volume (c m) (c (m + 1)) := by
    intro m hm
    rw [hc_succ m]
    exact hO_int (c m) (c m + s) (hc_ge_v0 m) (by linarith) (by linarith [hc_le_hi m hm, hs_hi])
  have hO_int_shift : ∀ m ∈ Finset.range M,
      IntervalIntegrable (fun t : ℝ => O (t + c m)) MeasureTheory.volume 0 s := by
    intro m hm
    have hm_lt : m < M := Finset.mem_range.mp hm
    have hint_cm : IntervalIntegrable O MeasureTheory.volume (c m) (c m + s) :=
      hO_int (c m) (c m + s) (hc_ge_v0 m) (by linarith) (by linarith [hc_le_hi m hm_lt, hs_hi])
    have hcomp := hint_cm.comp_add_right (c m)
    simpa only [sub_self, add_sub_cancel_left] using hcomp
  have h_telescope : (∫ t in (0 : ℝ)..s, ∑ m ∈ Finset.range M, O (t + c m)) =
      ∫ v in ((11 / 10 : ℝ) * K)..(c M), O v := by
    calc (∫ t in (0 : ℝ)..s, ∑ m ∈ Finset.range M, O (t + c m))
        = ∑ m ∈ Finset.range M, ∫ t in (0 : ℝ)..s, O (t + c m) :=
          intervalIntegral.integral_finsetSum hO_int_shift
      _ = ∑ m ∈ Finset.range M, ∫ v in (c m)..(c (m + 1)), O v := by
          refine Finset.sum_congr rfl (fun m _ => ?_)
          rw [intervalIntegral.integral_comp_add_right O (c m), zero_add, add_comm s (c m),
            ← hc_succ m]
      _ = ∫ v in (c 0)..(c M), O v :=
          intervalIntegral.sum_integral_adjacent_intervals hO_int_adj
      _ = ∫ v in ((11 / 10 : ℝ) * K)..(c M), O v := by rw [hc0]
  have h_sum_int : IntervalIntegrable (fun t : ℝ => ∑ m ∈ Finset.range M, O (t + c m))
      MeasureTheory.volume 0 s := by
    have h_fn_eq : (fun t : ℝ => ∑ m ∈ Finset.range M, O (t + c m)) =
        ∑ m ∈ Finset.range M, fun t : ℝ => O (t + c m) := by
      ext t
      simp only [Finset.sum_apply]
    rw [h_fn_eq]
    exact IntervalIntegrable.sum (Finset.range M) (fun m hm => hO_int_shift m hm)
  have hB_chain_nonneg : 0 ≤ B_chain := by
    dsimp only [B_chain]
    positivity
  have h_int_cM_le : (∫ v in ((11 / 10 : ℝ) * K)..(c M), O v) ≤
      (100 * (3 + 2 * Real.sqrt C_inc) + 16 * C_inc) * K ^ (47 / 50 : ℝ) := by
    rw [← h_telescope]
    have hmono : (∫ t in (0 : ℝ)..s, ∑ m ∈ Finset.range M, O (t + c m)) ≤
        ∫ _t in (0 : ℝ)..s, B_chain :=
      intervalIntegral.integral_mono_on hs_nonneg h_sum_int intervalIntegrable_const h_chain_bound
    have hconst : (∫ _t in (0 : ℝ)..s, B_chain) = s * B_chain := by
      rw [intervalIntegral.integral_const, smul_eq_mul, sub_zero]
    have hsB : s * B_chain ≤ 4 * B_chain :=
      mul_le_mul_of_nonneg_right hs_hi hB_chain_nonneg
    have h4B : 4 * B_chain =
        (100 * (3 + 2 * Real.sqrt C_inc) + 16 * C_inc) * K ^ (47 / 50 : ℝ) := by
      dsimp only [B_chain]
      ring
    linarith [hmono, hconst, hsB, h4B]
  have h_split : (∫ v in ((11 / 10 : ℝ) * K)..((19 / 10 : ℝ) * K), O v) +
      (∫ v in ((19 / 10 : ℝ) * K)..(c M), O v) =
      ∫ v in ((11 / 10 : ℝ) * K)..(c M), O v := by
    refine intervalIntegral.integral_add_adjacent_intervals ?_ ?_
    · exact hO_int ((11 / 10 : ℝ) * K) ((19 / 10 : ℝ) * K) le_rfl (by linarith) (by linarith)
    · exact hO_int ((19 / 10 : ℝ) * K) (c M) (by linarith) (le_of_lt hcM_gt)
        (by linarith [hcM_le4])
  have h_tail_nonneg : 0 ≤ ∫ v in ((19 / 10 : ℝ) * K)..(c M), O v := by
    refine intervalIntegral.integral_nonneg (le_of_lt hcM_gt) (fun v hv => ?_)
    exact hO_nonneg v (by linarith [hv.1])
  linarith [h_int_cM_le, h_split, h_tail_nonneg]

theorem small_moment_occupation_budget (S : FiniteWallNonisotropicStrip)
    (hBudget : CriticalAngleBudgetData S)
    (hTanaka : DiscreteTanakaProp)
    (hKern : StripExitKernelData S)
    (A : AmplitudeDeficitData S hBudget) :
    SmallMomentOccupationBound S A :=
by
  obtain ⟨C_inc, K_inc, hC_inc_pos, hK_inc_ge, hStepInc⟩ :=
    trunc_speed_step_l2_increment S hBudget hKern A
  set C_slice : ℝ := 100 * (3 + 2 * Real.sqrt C_inc) + 16 * C_inc
  have hC_slice_pos : 0 < C_slice := by
    dsimp only [C_slice]
    positivity
  have hC_occ_pos : 0 < 4 * Real.pi * C_slice := by positivity
  refine ⟨4 * Real.pi * C_slice, K_inc, hC_occ_pos, hK_inc_ge, ?_⟩
  intro K hK hSmall
  have hK_amp_le : A.K_amp ≤ K := le_trans hK_inc_ge hK
  have hk₀_le_amp : hBudget.k₀ ≤ A.K_amp := le_trans (le_max_left _ _) A.K_amp_ge
  have h200_le_amp : (200 : ℝ) ≤ A.K_amp := le_trans (le_max_right _ _) A.K_amp_ge
  have hk₀_le_K : hBudget.k₀ ≤ K := le_trans hk₀_le_amp hK_amp_le
  have h200_le_K : (200 : ℝ) ≤ K := le_trans h200_le_amp hK_amp_le
  have hK_pos : 0 < K := by linarith
  have hv_le : (11 / 10 : ℝ) * K ≤ (19 / 10 : ℝ) * K := by linarith
  have hExpK : Real.exp (-K) < S.H / 4 := by
    have h1 : Real.exp (-K) ≤ Real.exp (-hBudget.k₀) :=
      Real.exp_le_exp_of_le (by linarith)
    linarith [hBudget.exp_neg_k₀_lt, S.H_pos]
  have hExpVlo : Real.exp (-((11 / 10 : ℝ) * K)) < S.H / 4 := by
    have h1 : Real.exp (-((11 / 10 : ℝ) * K)) ≤ Real.exp (-K) :=
      Real.exp_le_exp_of_le (by linarith)
    linarith
  have hEpsPos : 0 < A.epsK K := Real.exp_pos _
  have hh₀Pos : 0 < K ^ (3 / 50 : ℝ) := Real.rpow_pos_of_pos hK_pos _
  obtain ⟨hInt2D, hIntSlice, hFubini⟩ :=
    row_occup_fubini_and_integrable S hKern (A.epsK K) (K ^ (3 / 50 : ℝ))
      ((11 / 10 : ℝ) * K) ((19 / 10 : ℝ) * K) hEpsPos hh₀Pos hv_le hExpVlo
  refine ⟨hInt2D, ?_⟩
  have hB_nonneg : 0 ≤ C_slice * K ^ (47 / 50 : ℝ) :=
    mul_nonneg (le_of_lt hC_slice_pos) (Real.rpow_nonneg (le_of_lt hK_pos) _)
  have hBound := hFubini (C_slice * K ^ (47 / 50 : ℝ)) hB_nonneg ?_
  · calc
      (∫ p in Set.Icc (0 : ℝ) (2 * Real.pi) ×ˢ
          Set.Icc ((11 / 10 : ℝ) * K) ((19 / 10 : ℝ) * K),
        rowOccupDensity S (A.epsK K) (K ^ (3 / 50 : ℝ)) p.1 p.2) ≤
          4 * Real.pi * (C_slice * K ^ (47 / 50 : ℝ)) := hBound
      _ = 4 * Real.pi * C_slice * K ^ (47 / 50 : ℝ) := by ring
  · intro s hs
    exact step_grid_tanaka_slice_bound S hTanaka hKern K (A.epsK K) C_inc s
      h200_le_K hExpK hEpsPos hC_inc_pos hs (hIntSlice s hs)
      (fun v hv => hStepInc K hK hSmall v hv s hs)

theorem unit_disk_curv_log_oscillation (κ₀ : ℝ) (hκ₀ : 0 < κ₀) :
    ∃ c₂ : ℝ, 0 < c₂ ∧
      ∀ g : ℂ → ℂ,
        DifferentiableOn ℂ g (Metric.ball (0 : ℂ) 1) →
        (∃ w ∈ Metric.ball (0 : ℂ) 1, g w ≠ 0) →
        κ₀ * ‖g 0‖ ≤ ‖deriv (deriv g) 0‖ →
        MeasureTheory.IntegrableOn (fun w : ℂ => |Real.log ‖g w‖|)
          (Metric.ball (0 : ℂ) 1) MeasureTheory.volume →
        c₂ ≤ (Real.pi)⁻¹ * ∫ w in Metric.ball (0 : ℂ) 1, |Real.log ‖g w‖| :=
by
  let δ₀ : ℝ := min (1 / 4 : ℝ) (κ₀ ^ (2 : ℕ) / 256)
  have hδ₀_pos : 0 < δ₀ := lt_min (by norm_num) (by positivity)
  have hδ₀_le_quarter : δ₀ ≤ 1 / 4 := min_le_left _ _
  have hδ₀_le_κ : δ₀ ≤ κ₀ ^ (2 : ℕ) / 256 := min_le_right _ _
  let η : ℝ := δ₀ / 3
  have hη_pos : 0 < η := by positivity
  have hη_le_twelfth : η ≤ 1 / 12 := by
    change δ₀ / 3 ≤ 1 / 12
    linarith
  have hη_le_one : η ≤ 1 := by linarith
  let c₂ : ℝ := η ^ (3 : ℕ) / 512
  have hc₂_pos : 0 < c₂ := by positivity
  refine ⟨c₂, hc₂_pos, ?_⟩
  intro g hg_diff hg_nz hg_curv hg_int
  set I : ℝ := (Real.pi)⁻¹ * ∫ w in Metric.ball (0 : ℂ) 1, |Real.log ‖g w‖|
  have hInt_nn : 0 ≤ ∫ w in Metric.ball (0 : ℂ) 1, |Real.log ‖g w‖| :=
    MeasureTheory.setIntegral_nonneg Metric.isOpen_ball.measurableSet (fun _ _ => abs_nonneg _)
  have hI_nn : 0 ≤ I := mul_nonneg (inv_nonneg.mpr Real.pi_pos.le) hInt_nn
  have h_pi_I : ∫ w in Metric.ball (0 : ℂ) 1, |Real.log ‖g w‖| = Real.pi * I := by
    dsimp [I]
    rw [← mul_assoc, mul_inv_cancel₀ (ne_of_gt Real.pi_pos), one_mul]
  have hg_ana : AnalyticOnNhd ℂ g (Metric.ball (0 : ℂ) 1) :=
    hg_diff.analyticOnNhd Metric.isOpen_ball

  
  have h_s1 : ∀ w₀ ∈ Metric.closedBall (0 : ℂ) (1 / 2), ‖g w₀‖ ≤ Real.exp (16 * I) := by
    intro w₀ hw₀
    have hw₀_norm : ‖w₀‖ ≤ 1 / 2 := by simpa [Metric.mem_closedBall, dist_zero_right] using hw₀
    by_cases hgw₀_le : ‖g w₀‖ ≤ 1
    · exact le_trans hgw₀_le (Real.one_le_exp (by positivity))
    · have hgw₀_gt : 1 < ‖g w₀‖ := lt_of_not_ge hgw₀_le
      have hgw₀_pos : 0 < ‖g w₀‖ := lt_trans zero_lt_one hgw₀_gt
      have hgw₀_ne : g w₀ ≠ 0 := norm_pos_iff.mp hgw₀_pos
      have hcb_sub : Metric.closedBall w₀ (1 / 4) ⊆ Metric.ball (0 : ℂ) 1 := by
        intro z hz
        rw [Metric.mem_closedBall, dist_eq_norm] at hz
        rw [Metric.mem_ball, dist_zero_right]
        have htri : ‖z‖ ≤ ‖z - w₀‖ + ‖w₀‖ := by
          simpa only [sub_add_cancel] using norm_add_le (z - w₀) w₀
        linarith
      have hball_sub : Metric.ball w₀ (1 / 4) ⊆ Metric.ball (0 : ℂ) 1 :=
        Set.Subset.trans Metric.ball_subset_closedBall hcb_sub
      have hw₀_in_ball : w₀ ∈ Metric.ball (0 : ℂ) 1 :=
        hcb_sub (Metric.mem_closedBall_self (by norm_num))
      have hg_ana_w₀ : AnalyticAt ℂ g w₀ := hg_ana w₀ hw₀_in_ball
      let u_pos : ℂ → ℝ := fun z => Real.log (max ‖g z‖ 1)
      have hu_nn : ∀ z : ℂ, 0 ≤ u_pos z := fun z => Real.log_nonneg (le_max_right _ _)
      have hlog_le_u : ∀ z : ℂ, Real.log ‖g z‖ ≤ u_pos z := by
        intro z
        by_cases hgz : ‖g z‖ = 0
        · simp [hgz, hu_nn z]
        · exact Real.log_le_log (lt_of_le_of_ne (norm_nonneg _) (Ne.symm hgz)) (le_max_left _ _)
      have hu_le_abs : ∀ z : ℂ, u_pos z ≤ |Real.log ‖g z‖| := by
        intro z
        by_cases h1 : ‖g z‖ ≤ 1
        · have hmax : max ‖g z‖ 1 = 1 := max_eq_right h1
          simp [u_pos, hmax]
        · have h1_gt : 1 < ‖g z‖ := lt_of_not_ge h1
          have hmax : max ‖g z‖ 1 = ‖g z‖ := max_eq_left (le_of_lt h1_gt)
          dsimp [u_pos]
          rw [hmax]
          exact le_abs_self _
      have hu_cont : ContinuousOn u_pos (Metric.ball (0 : ℂ) 1) := by
        have hmax_cont : ContinuousOn (fun z : ℂ => max ‖g z‖ 1) (Metric.ball (0 : ℂ) 1) :=
          continuous_max.comp_continuousOn (hg_diff.continuousOn.norm.prodMk continuousOn_const)
        exact hmax_cont.log (fun z _ => ne_of_gt (lt_of_lt_of_le zero_lt_one (le_max_right _ _)))
      have h_jensen_r : ∀ r ∈ Set.Ioo (0 : ℝ) (1 / 4),
          2 * Real.pi * Real.log ‖g w₀‖ ≤
            ∫ θ in Set.Ioo (-Real.pi) Real.pi, u_pos (circleMap w₀ r θ) := by
        intro r hr
        have hr_pos : 0 < r := hr.1
        have hr_lt : r < 1 / 4 := hr.2
        have hr_abs : |r| = r := abs_of_pos hr_pos
        have hcb_r_sub : Metric.closedBall w₀ |r| ⊆ Metric.ball (0 : ℂ) 1 :=
          Set.Subset.trans
            (Metric.closedBall_subset_closedBall (by rw [hr_abs]; exact le_of_lt hr_lt)) hcb_sub
        have hg_ana_r : AnalyticOnNhd ℂ g (Metric.closedBall w₀ |r|) := hg_ana.mono hcb_r_sub
        have hg_mero_r : MeromorphicOn g (Metric.closedBall w₀ |r|) := hg_ana_r.meromorphicOn
        have hj := MeromorphicOn.circleAverage_log_norm (ne_of_gt hr_pos) hg_mero_r
        set D := MeromorphicOn.divisor g (Metric.closedBall w₀ |r|)
        have htrail : meromorphicTrailingCoeffAt g w₀ = g w₀ :=
          hg_ana_w₀.meromorphicTrailingCoeffAt_of_ne_zero hgw₀_ne
        have hDw₀ : D w₀ = 0 := by
          have hw₀_mem_r : w₀ ∈ Metric.closedBall w₀ |r| :=
            Metric.mem_closedBall_self (abs_nonneg r)
          rw [MeromorphicOn.divisor_apply hg_mero_r hw₀_mem_r]
          have hord : meromorphicOrderAt g w₀ = 0 :=
            (hg_ana_w₀.meromorphicNFAt).meromorphicOrderAt_eq_zero_iff.mpr hgw₀_ne
          simp [hord]
        have hfin_nn : 0 ≤ ∑ᶠ u : ℂ, (D u : ℝ) * Real.log (r * ‖w₀ - u‖⁻¹) := by
          refine finsum_nonneg (fun u => ?_)
          by_cases hDu : D u = 0
          · simp [hDu]
          · have hDu_nn : 0 ≤ D u := MeromorphicOn.AnalyticOnNhd.divisor_nonneg hg_ana_r u
            have hDu_nn_real : (0 : ℝ) ≤ (D u : ℝ) := by exact_mod_cast hDu_nn
            have hu_mem : u ∈ Metric.closedBall w₀ |r| := by
              by_contra hu_not
              exact hDu (D.apply_eq_zero_of_notMem hu_not)
            have hu_ne : w₀ ≠ u := by
              intro heq
              subst heq
              exact hDu hDw₀
            have hdist_pos : 0 < ‖w₀ - u‖ := norm_pos_iff.mpr (sub_ne_zero.mpr hu_ne)
            have hdist_le : ‖w₀ - u‖ ≤ r := by
              rw [Metric.mem_closedBall, dist_comm, dist_eq_norm, hr_abs] at hu_mem
              exact hu_mem
            have hratio_ge : 1 ≤ r * ‖w₀ - u‖⁻¹ := by
              rw [← div_eq_mul_inv, le_div_iff₀ hdist_pos, one_mul]
              exact hdist_le
            exact mul_nonneg hDu_nn_real (Real.log_nonneg hratio_ge)
        have h_ca_log : Real.log ‖g w₀‖ ≤ Real.circleAverage (fun x => Real.log ‖g x‖) w₀ r := by
          rw [hj, hDw₀, htrail]
          simp only [Int.cast_zero, zero_mul, add_zero]
          linarith
        have hci_log : CircleIntegrable (fun x => Real.log ‖g x‖) w₀ r :=
          MeromorphicOn.circleIntegrable_log_norm
            (hg_mero_r.mono_set Metric.sphere_subset_closedBall)
        have hci_u : CircleIntegrable u_pos w₀ r := by
          refine (hu_cont.mono ?_).circleIntegrable (le_of_lt hr_pos)
          rw [← hr_abs]
          exact Set.Subset.trans Metric.sphere_subset_closedBall hcb_r_sub
        have h_ca_le : Real.log ‖g w₀‖ ≤ Real.circleAverage u_pos w₀ r :=
          le_trans h_ca_log (Real.circleAverage_mono hci_log hci_u (fun x _ => hlog_le_u x))
        rw [Real.circleAverage_def, smul_eq_mul] at h_ca_le
        have h_mul := mul_le_mul_of_nonneg_left h_ca_le Real.two_pi_pos.le
        rw [← mul_assoc, mul_inv_cancel₀ (ne_of_gt Real.two_pi_pos), one_mul] at h_mul
        have h_per : Function.Periodic (fun θ => u_pos (circleMap w₀ r θ)) (2 * Real.pi) :=
          fun θ => by simp [periodic_circleMap w₀ r θ]
        have h_shift := h_per.intervalIntegral_add_eq (-Real.pi) 0
        have h_end1 : -Real.pi + 2 * Real.pi = Real.pi := by ring
        have h_end2 : (0 : ℝ) + 2 * Real.pi = 2 * Real.pi := zero_add _
        rw [h_end1, h_end2] at h_shift
        rw [← h_shift, intervalIntegral.integral_of_le (by linarith [Real.pi_pos]),
          MeasureTheory.integral_Ioc_eq_integral_Ioo] at h_mul
        exact h_mul
      
      have h_preimg : (fun z : ℂ => z + w₀) ⁻¹' Metric.ball w₀ (1 / 4) =
          Metric.ball (0 : ℂ) (1 / 4) := by
        ext z
        simp [Metric.mem_ball, dist_eq_norm]
      have h_trans : (∫ y in Metric.ball w₀ (1 / 4), u_pos y) =
          ∫ z in Metric.ball (0 : ℂ) (1 / 4), u_pos (z + w₀) := by
        have hmp := (MeasureTheory.measurePreserving_add_right MeasureTheory.volume w₀).setIntegral_preimage_emb
          (MeasurableEquiv.addRight w₀).measurableEmbedding u_pos (Metric.ball w₀ (1 / 4))
        change (∫ x in (fun z : ℂ => z + w₀) ⁻¹' Metric.ball w₀ (1 / 4), u_pos (x + w₀)) =
          ∫ y in Metric.ball w₀ (1 / 4), u_pos y at hmp
        rw [h_preimg] at hmp
        exact hmp.symm
      let f₀ : ℂ → ℝ := (Metric.ball (0 : ℂ) (1 / 4)).indicator (fun z => u_pos (z + w₀))
      let R_pol : Set (ℝ × ℝ) := Set.Ioo (0 : ℝ) (1 / 4) ×ˢ Set.Ioo (-Real.pi) Real.pi
      let Φ : ℝ × ℝ → ℝ := fun p => p.1 * u_pos (circleMap w₀ p.1 p.2)
      have h_polar_eq : (∫ y in Metric.ball w₀ (1 / 4), u_pos y) = ∫ p in R_pol, Φ p := by
        rw [h_trans, ← MeasureTheory.integral_indicator Metric.isOpen_ball.measurableSet,
          ← Complex.integral_comp_polarCoord_symm f₀]
        have h_target_eq : polarCoord.target = Set.Ioi (0 : ℝ) ×ˢ Set.Ioo (-Real.pi) Real.pi :=
          polarCoord_target
        have h_meas_target : MeasurableSet polarCoord.target := by
          rw [h_target_eq]
          exact isOpen_Ioi.measurableSet.prod isOpen_Ioo.measurableSet
        have h_meas_R : MeasurableSet R_pol :=
          isOpen_Ioo.measurableSet.prod isOpen_Ioo.measurableSet
        have h_sub_target : R_pol ⊆ polarCoord.target := by
          rw [h_target_eq]
          exact Set.prod_mono (fun r hr => hr.1) Set.Subset.rfl
        have h_congr : Set.EqOn (fun p : ℝ × ℝ => p.1 • f₀ (Complex.polarCoord.symm p))
            (R_pol.indicator Φ) polarCoord.target := by
          intro p hp
          rw [h_target_eq] at hp
          have hp1_pos : 0 < p.1 := hp.1
          have hsymm_eq : (Complex.polarCoord.symm p : ℂ) =
              (p.1 : ℂ) * Complex.exp ((p.2 : ℂ) * Complex.I) := by
            rw [Complex.polarCoord_symm_apply, Complex.exp_mul_I]
            simp [Complex.ofReal_cos, Complex.ofReal_sin]
          have hsymm_norm : ‖(Complex.polarCoord.symm p : ℂ)‖ = p.1 := by
            rw [hsymm_eq, norm_mul, Complex.norm_real, Real.norm_of_nonneg (le_of_lt hp1_pos),
              Complex.norm_exp_ofReal_mul_I, mul_one]
          have hadd_eq : (Complex.polarCoord.symm p : ℂ) + w₀ = circleMap w₀ p.1 p.2 := by
            rw [hsymm_eq, circleMap, add_comm]
          by_cases hp1_lt : p.1 < 1 / 4
          · have hp_in_R : p ∈ R_pol := ⟨⟨hp1_pos, hp1_lt⟩, hp.2⟩
            have hp_in_ball : (Complex.polarCoord.symm p : ℂ) ∈ Metric.ball (0 : ℂ) (1 / 4) := by
              rw [Metric.mem_ball, dist_zero_right, hsymm_norm]
              exact hp1_lt
            change p.1 * f₀ (Complex.polarCoord.symm p) = R_pol.indicator Φ p
            rw [Set.indicator_of_mem hp_in_R]
            dsimp only [f₀, Φ]
            rw [Set.indicator_of_mem hp_in_ball, hadd_eq]
          · have hp_not_R : p ∉ R_pol := fun h => hp1_lt h.1.2
            have hp_not_ball : (Complex.polarCoord.symm p : ℂ) ∉ Metric.ball (0 : ℂ) (1 / 4) := by
              rw [Metric.mem_ball, dist_zero_right, hsymm_norm]
              exact hp1_lt
            change p.1 * f₀ (Complex.polarCoord.symm p) = R_pol.indicator Φ p
            rw [Set.indicator_of_notMem hp_not_R]
            dsimp only [f₀]
            rw [Set.indicator_of_notMem hp_not_ball, mul_zero]
        rw [MeasureTheory.setIntegral_congr_fun h_meas_target h_congr,
          MeasureTheory.setIntegral_indicator h_meas_R, Set.inter_eq_right.mpr h_sub_target]
      let K_pol : Set (ℝ × ℝ) := Set.Icc (0 : ℝ) (1 / 4) ×ˢ Set.Icc (-Real.pi) Real.pi
      have h_cm_cont : Continuous (fun p : ℝ × ℝ => circleMap w₀ p.1 p.2) := by
        dsimp [circleMap]
        exact continuous_const.add
          ((Complex.continuous_ofReal.comp continuous_fst).mul
            (Complex.continuous_exp.comp
              ((Complex.continuous_ofReal.comp continuous_snd).mul continuous_const)))
      have h_cm_maps : Set.MapsTo (fun p : ℝ × ℝ => circleMap w₀ p.1 p.2)
          K_pol (Metric.ball (0 : ℂ) 1) := by
        intro p hp
        refine hcb_sub ?_
        rw [Metric.mem_closedBall, dist_eq_norm]
        have hd : circleMap w₀ p.1 p.2 - w₀ = (p.1 : ℂ) * Complex.exp ((p.2 : ℂ) * Complex.I) := by
          simp [circleMap]
        rw [hd, norm_mul, Complex.norm_real, Real.norm_of_nonneg hp.1.1,
          Complex.norm_exp_ofReal_mul_I, mul_one]
        exact hp.1.2
      have hΦ_cont : ContinuousOn Φ K_pol :=
        continuousOn_fst.mul (hu_cont.comp h_cm_cont.continuousOn h_cm_maps)
      have hΦ_int : MeasureTheory.IntegrableOn Φ R_pol MeasureTheory.volume :=
        (hΦ_cont.integrableOn_compact (isCompact_Icc.prod isCompact_Icc)).mono_set
          (Set.prod_mono Set.Ioo_subset_Icc_self Set.Ioo_subset_Icc_self)
      have hΦ_prod : MeasureTheory.IntegrableOn Φ R_pol
          (MeasureTheory.volume.prod MeasureTheory.volume) := by
        rwa [← MeasureTheory.Measure.volume_eq_prod ℝ ℝ]
      have h_fub : (∫ p in R_pol, Φ p) =
          ∫ r in Set.Ioo (0 : ℝ) (1 / 4),
            ∫ θ in Set.Ioo (-Real.pi) Real.pi, r * u_pos (circleMap w₀ r θ) := by
        rw [MeasureTheory.Measure.volume_eq_prod ℝ ℝ]
        exact MeasureTheory.setIntegral_prod Φ hΦ_prod
      have h_slice_int : MeasureTheory.IntegrableOn
          (fun r : ℝ => ∫ θ in Set.Ioo (-Real.pi) Real.pi, r * u_pos (circleMap w₀ r θ))
          (Set.Ioo (0 : ℝ) (1 / 4)) MeasureTheory.volume := by
        have h1 : MeasureTheory.Integrable Φ
            ((MeasureTheory.volume.restrict (Set.Ioo (0 : ℝ) (1 / 4))).prod
              (MeasureTheory.volume.restrict (Set.Ioo (-Real.pi) Real.pi))) := by
          rw [MeasureTheory.Measure.prod_restrict]
          exact hΦ_prod
        exact h1.integral_prod_left
      have h_lhs_int : MeasureTheory.IntegrableOn
          (fun r : ℝ => r * (2 * Real.pi * Real.log ‖g w₀‖))
          (Set.Ioo (0 : ℝ) (1 / 4)) MeasureTheory.volume :=
        ((continuous_id.mul continuous_const).continuousOn.integrableOn_compact isCompact_Icc).mono_set
          Set.Ioo_subset_Icc_self
      have h_int_r_ge : (∫ r in Set.Ioo (0 : ℝ) (1 / 4), r * (2 * Real.pi * Real.log ‖g w₀‖)) ≤
          ∫ y in Metric.ball w₀ (1 / 4), u_pos y := by
        rw [h_polar_eq, h_fub]
        refine MeasureTheory.setIntegral_mono_on h_lhs_int h_slice_int isOpen_Ioo.measurableSet ?_
        intro r hr
        rw [MeasureTheory.integral_const_mul]
        exact mul_le_mul_of_nonneg_left (h_jensen_r r hr) (le_of_lt hr.1)
      have h_eval_lhs : (∫ r in Set.Ioo (0 : ℝ) (1 / 4), r * (2 * Real.pi * Real.log ‖g w₀‖)) =
          (Real.pi / 16) * Real.log ‖g w₀‖ := by
        rw [MeasureTheory.integral_mul_const, ← MeasureTheory.integral_Ioc_eq_integral_Ioo,
          ← intervalIntegral.integral_of_le (by norm_num : (0 : ℝ) ≤ 1 / 4), integral_id]
        ring
      have hu_int_ball : MeasureTheory.IntegrableOn u_pos
          (Metric.ball w₀ (1 / 4)) MeasureTheory.volume :=
        ((hu_cont.mono hcb_sub).integrableOn_compact (isCompact_closedBall _ _)).mono_set
          Metric.ball_subset_closedBall
      have h_le_sub : (∫ y in Metric.ball w₀ (1 / 4), u_pos y) ≤
          ∫ y in Metric.ball w₀ (1 / 4), |Real.log ‖g y‖| :=
        MeasureTheory.setIntegral_mono_on hu_int_ball (hg_int.mono_set hball_sub)
          Metric.isOpen_ball.measurableSet (fun y _ => hu_le_abs y)
      have h_le_full : (∫ y in Metric.ball w₀ (1 / 4), |Real.log ‖g y‖|) ≤
          ∫ y in Metric.ball (0 : ℂ) 1, |Real.log ‖g y‖| :=
        MeasureTheory.setIntegral_mono_set hg_int
          (Filter.Eventually.of_forall (fun _ => abs_nonneg _)) hball_sub.eventuallyLE
      have h_pi16_le : (Real.pi / 16) * Real.log ‖g w₀‖ ≤ Real.pi * I := by
        linarith [h_int_r_ge, h_eval_lhs, h_le_sub, h_le_full, h_pi_I]
      have h_log_le : Real.log ‖g w₀‖ ≤ 16 * I := by
        have h_pos : 0 < Real.pi / 16 := by positivity
        have h_rew : (Real.pi / 16) * Real.log ‖g w₀‖ ≤ (Real.pi / 16) * (16 * I) := by
          linarith [h_pi16_le]
        exact le_of_mul_le_mul_left h_rew h_pos
      rw [← Real.exp_log hgw₀_pos]
      exact Real.exp_le_exp.mpr h_log_le

  
  have h_s2 : ∀ M : ℝ, 0 ≤ M → (∀ w ∈ Metric.sphere (0 : ℂ) (1 / 2), ‖g w‖ ≤ M) →
      ‖g 0‖ ^ (2 : ℕ) + (1 / 64 : ℝ) * ‖deriv (deriv g) 0‖ ^ (2 : ℕ) ≤ M ^ (2 : ℕ) := by
    intro M hM_nn hM_bd
    have hg_cb : DifferentiableOn ℂ g (Metric.closedBall (0 : ℂ) (1 / 2)) :=
      hg_diff.mono (Metric.closedBall_subset_ball (by norm_num))
    let a₀ : ℂ := g 0
    let a₂ : ℂ := (1 / 8 : ℂ) * deriv (deriv g) 0
    let γ : ℝ → ℂ := circleMap (0 : ℂ) (1 / 2)
    let W : ℝ → ℂ := fun θ => g (γ θ)
    let E₂ : ℝ → ℂ := fun θ => Complex.exp ((2 * Complex.I) * (θ : ℂ))
    have hγ_mem : ∀ θ : ℝ, γ θ ∈ Metric.sphere (0 : ℂ) (1 / 2) :=
      fun θ => circleMap_mem_sphere (0 : ℂ) (by norm_num) θ
    have hγ_ne : ∀ θ : ℝ, γ θ ≠ 0 := by
      intro θ h0
      have hnorm : ‖γ θ‖ = 1 / 2 := by simpa [Metric.mem_sphere, dist_zero_right] using hγ_mem θ
      rw [h0, norm_zero] at hnorm
      norm_num at hnorm
    have hW_cont : Continuous W :=
      hg_cb.continuousOn.comp_continuous (continuous_circleMap 0 (1 / 2))
        (fun θ => Metric.sphere_subset_closedBall (hγ_mem θ))
    have hE₂_cont : Continuous E₂ :=
      Complex.continuous_exp.comp (continuous_const.mul Complex.continuous_ofReal)
    have hE₂_norm : ∀ θ : ℝ, ‖E₂ θ‖ = 1 := by
      intro θ
      have heq : (2 * Complex.I) * (θ : ℂ) = ((2 * θ : ℝ) : ℂ) * Complex.I := by push_cast; ring
      rw [(show E₂ θ = Complex.exp ((2 * Complex.I) * (θ : ℂ)) from rfl), heq,
        Complex.norm_exp_ofReal_mul_I]
    have hE₂_mul_conj : ∀ θ : ℝ, E₂ θ * starRingEnd ℂ (E₂ θ) = 1 := by
      intro θ
      rw [Complex.mul_conj, Complex.normSq_eq_norm_sq, hE₂_norm θ]
      norm_num
    
    have hc0 := hg_cb.circleIntegral_one_div_sub_center_pow_smul (by norm_num : (0 : ℝ) < 1 / 2) 0
    have hint_W : (∫ θ in (0 : ℝ)..(2 * Real.pi), W θ) = (2 * Real.pi : ℂ) * a₀ := by
      unfold circleIntegral at hc0
      have h_simp0 : ∀ θ : ℝ,
          deriv (circleMap 0 (1 / 2)) θ • ((1 / (circleMap 0 (1 / 2) θ - 0) ^ (0 + 1)) •
            g (circleMap 0 (1 / 2) θ)) = Complex.I * W θ := by
        intro θ
        rw [deriv_circleMap, smul_eq_mul, smul_eq_mul]
        change (γ θ * Complex.I) * ((1 / (γ θ - 0) ^ 1) * W θ) = Complex.I * W θ
        have hne := hγ_ne θ
        field_simp [hne]
        ring
      simp_rw [h_simp0, intervalIntegral.integral_const_mul] at hc0
      simp only [Nat.factorial_zero, Nat.cast_one, div_one, iteratedDeriv_zero, smul_eq_mul] at hc0
      have hI_eq : Complex.I * (∫ θ in (0 : ℝ)..(2 * Real.pi), W θ) =
          Complex.I * ((2 * Real.pi : ℂ) * a₀) := by
        calc Complex.I * (∫ θ in (0 : ℝ)..(2 * Real.pi), W θ)
            = 2 * ↑Real.pi * Complex.I * a₀ := hc0
          _ = Complex.I * ((2 * Real.pi : ℂ) * a₀) := by ring
      exact mul_left_cancel₀ Complex.I_ne_zero hI_eq
    
    have hc2 := hg_cb.circleIntegral_one_div_sub_center_pow_smul (by norm_num : (0 : ℝ) < 1 / 2) 2
    have hint_E2W : (∫ θ in (0 : ℝ)..(2 * Real.pi), starRingEnd ℂ (E₂ θ) * W θ) =
        (2 * Real.pi : ℂ) * a₂ := by
      unfold circleIntegral at hc2
      have hγ_sq : ∀ θ : ℝ, (γ θ) ^ (2 : ℕ) = (1 / 4 : ℂ) * E₂ θ := by
        intro θ
        dsimp [γ, E₂]
        rw [circleMap_zero, mul_pow, sq (Complex.exp _), ← Complex.exp_add]
