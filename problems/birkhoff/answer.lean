    obtain ⟨m, hm⟩ := h_exists_center
    let J : Set ℝ := Set.Ioo (c m - δ / 2) (c m + δ / 2)
    have hJ_inf : J.Infinite := Set.Ioo_infinite (by linarith)
    obtain ⟨t, ht_J, ht_not_F⟩ := (hJ_inf.sdiff hF).nonempty
    have hm_nonneg : (0 : ℝ) ≤ (m.1 : ℝ) := Nat.cast_nonneg m.1
    have hm_lt : (m.1 : ℝ) + 1 ≤ (S_near.card : ℝ) + 1 := by
      have : m.1 + 1 ≤ M := m.2
      exact_mod_cast this
    have ht_lo : a < t := by
      have : c m - δ / 2 < t := ht_J.1
      dsimp [c] at this
      nlinarith
    have ht_hi : t < b := by
      have : t < c m + δ / 2 := ht_J.2
      dsimp [c] at this
      nlinarith
    refine ⟨t, ⟨ht_lo, ht_hi⟩, ht_not_F, ?_⟩
    intro r hr
    have h_cm := hm r hr
    have ht_dist : |t - c m| < δ / 2 := by
      rw [abs_lt]
      exact ⟨by linarith [ht_J.1], by linarith [ht_J.2]⟩
    have h_tri : |c m - r| ≤ |c m - t| + |t - r| := by
      have : c m - r = (c m - t) + (t - r) := by ring
      rw [this]
      exact abs_add_le _ _
    rw [abs_sub_comm] at ht_dist
    linarith

  
  have h_rect_inv_sq_zero : ∀ (U : Set ℂ) (f : ℂ → ℂ) (a b y_lo y_hi : ℝ),
      IsOpen U → DifferentiableOn ℂ f U →
      (∀ z ∈ U, f z = 0 → deriv f z ≠ 0 ∧ deriv (deriv f) z = 0) →
      a ≤ b → y_lo ≤ y_hi →
      Set.Icc a b ×ℂ Set.Icc y_lo y_hi ⊆ U →
      (∀ x ∈ Set.Icc a b, f ((x : ℂ) + (y_lo : ℂ) * Complex.I) ≠ 0) →
      (∀ x ∈ Set.Icc a b, f ((x : ℂ) + (y_hi : ℂ) * Complex.I) ≠ 0) →
      (∀ y ∈ Set.Icc y_lo y_hi, f ((a : ℂ) + (y : ℂ) * Complex.I) ≠ 0) →
      (∀ y ∈ Set.Icc y_lo y_hi, f ((b : ℂ) + (y : ℂ) * Complex.I) ≠ 0) →
      ((∫ x in a..b, (f ((x : ℂ) + (y_lo : ℂ) * Complex.I))⁻¹ ^ 2) -
        ∫ x in a..b, (f ((x : ℂ) + (y_hi : ℂ) * Complex.I))⁻¹ ^ 2) +
        Complex.I * (∫ y in y_lo..y_hi, (f ((b : ℂ) + (y : ℂ) * Complex.I))⁻¹ ^ 2) -
        Complex.I * (∫ y in y_lo..y_hi, (f ((a : ℂ) + (y : ℂ) * Complex.I))⁻¹ ^ 2) = 0 := by
    intro U f a b y_lo y_hi hU hf hsimple hab hy hRU h_bot h_top h_left h_right
    let R_box : Set ℂ := Set.Icc a b ×ℂ Set.Icc y_lo y_hi
    have hZ_fin : {z : ℂ | z ∈ R_box ∧ f z = 0}.Finite :=
