    have hBad_lt : ∑ m ∈ Bad, MeasureTheory.volume.real (A n ∩ I_m m) < ε / 2 := by
      have h1 : ∑ m ∈ Bad, MeasureTheory.volume.real (A n ∩ I_m m) ≤
