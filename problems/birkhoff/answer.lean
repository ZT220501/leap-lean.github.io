        IntervalIntegrable (fun θ : ℝ => (L.b_shift (γ θ)).im)
          MeasureTheory.volume 0 (2 * Real.pi) :=
      hb_im_cont.intervalIntegrable 0 (2 * Real.pi)
    have hb_complex_int :
        IntervalIntegrable (fun θ : ℝ => L.b_shift (γ θ))
          MeasureTheory.volume 0 (2 * Real.pi) :=
      hb_complex_cont.intervalIntegrable 0 (2 * Real.pi)
    have hb_im_int_eq :
        (∫ θ in (0 : ℝ)..(2 * Real.pi), (L.b_shift (γ θ)).im) =
          (2 * Real.pi) * (L.b_shift t₀).im := by
      have him := Complex.imCLM.intervalIntegral_comp_comm hb_complex_int
      calc (∫ θ in (0 : ℝ)..(2 * Real.pi), (L.b_shift (γ θ)).im)
          = Complex.imCLM (∫ θ in (0 : ℝ)..(2 * Real.pi), L.b_shift (γ θ)) := him
        _ = ((2 * (Real.pi : ℂ)) * L.b_shift t₀).im := by rw [h_int_b_complex]; rfl
        _ = (2 * Real.pi) * (L.b_shift t₀).im := by simp [Complex.mul_im]
    
    let e : ℝ → ℂ := fun θ => Complex.exp ((θ : ℂ) * Complex.I)
    have he_cont : Continuous e :=
      Complex.continuous_exp.comp (Complex.continuous_ofReal.mul continuous_const)
    have he_per : ∀ θ : ℝ, e (θ + 2 * Real.pi) = e θ := by
      intro θ
      dsimp only [e]
      have hsplit : ((θ + 2 * Real.pi : ℝ) : ℂ) * Complex.I =
          (θ : ℂ) * Complex.I + 2 * (Real.pi : ℂ) * Complex.I := by push_cast; ring
      rw [hsplit, Complex.exp_add, Complex.exp_two_pi_mul_I, mul_one]
    let Φ : ℕ → ℝ → ℝ → ℝ := fun n θ φ => g_M φ + (n : ℝ) * ‖e θ - e φ‖
    let I_seq : ℕ → ℝ → ℝ := fun n θ => iInf (fun φ : ℝ => Φ n θ φ)
    let q_seq : ℕ → ℝ → ℝ := fun n θ => I_seq n θ - M.s_base / (2 * ((n : ℝ) + 1))
    have hΦ_bdd : ∀ n : ℕ, ∀ θ : ℝ, BddBelow (Set.range (fun φ : ℝ => Φ n θ φ)) := by
      intro n θ
      refine ⟨M.s_base, ?_⟩
      rintro _ ⟨φ, rfl⟩
      have hge := (hg_raw_bounds (γ φ) (hγ_mem φ)).1
      have hnn : 0 ≤ (n : ℝ) * ‖e θ - e φ‖ := mul_nonneg (Nat.cast_nonneg n) (norm_nonneg _)
      dsimp only [Φ, g_M]
      linarith
    have hI_ge : ∀ n : ℕ, ∀ θ : ℝ, M.s_base ≤ I_seq n θ := by
      intro n θ
      refine le_ciInf (fun φ => ?_)
      have hge := (hg_raw_bounds (γ φ) (hγ_mem φ)).1
      have hnn : 0 ≤ (n : ℝ) * ‖e θ - e φ‖ := mul_nonneg (Nat.cast_nonneg n) (norm_nonneg _)
      dsimp only [Φ, g_M]
      linarith
    have hI_le : ∀ n : ℕ, ∀ θ : ℝ, I_seq n θ ≤ g_M θ := by
      intro n θ
      have hle := ciInf_le (hΦ_bdd n θ) θ
      simpa [Φ] using hle
    have hshift_pos : ∀ n : ℕ, 0 < M.s_base / (2 * ((n : ℝ) + 1)) := by
      intro n
      exact div_pos M.s_base_pos (by positivity)
    have hshift_le_half : ∀ n : ℕ, M.s_base / (2 * ((n : ℝ) + 1)) ≤ M.s_base / 2 := by
      intro n
      apply div_le_div_of_nonneg_left (le_of_lt M.s_base_pos) two_pos
      have hn : (0 : ℝ) ≤ (n : ℝ) := Nat.cast_nonneg n
      linarith
    have hq_pos : ∀ n : ℕ, ∀ θ : ℝ, 0 < q_seq n θ := by
      intro n θ
      have h1 := hI_ge n θ
      have h2 := hshift_le_half n
      dsimp only [q_seq]
      linarith [M.s_base_pos]
    have hq_lt : ∀ n : ℕ, ∀ θ : ℝ, q_seq n θ < g_M θ := by
      intro n θ
      have h1 := hI_le n θ
      have h2 := hshift_pos n
      dsimp only [q_seq]
      linarith
    have hq_per : ∀ n : ℕ, Function.Periodic (q_seq n) (2 * Real.pi) := by
      intro n θ
      have hI_eq : I_seq n (θ + 2 * Real.pi) = I_seq n θ := by
        dsimp only [I_seq, Φ]
        simp only [he_per θ]
      dsimp only [q_seq]
      rw [hI_eq]
    have hI_lip : ∀ n : ℕ, ∀ θ₁ θ₂ : ℝ, I_seq n θ₁ - I_seq n θ₂ ≤ (n : ℝ) * ‖e θ₁ - e θ₂‖ := by
      intro n θ₁ θ₂
      have hle : I_seq n θ₁ - (n : ℝ) * ‖e θ₁ - e θ₂‖ ≤ I_seq n θ₂ := by
        refine le_ciInf (fun φ => ?_)
        have h1 : I_seq n θ₁ ≤ g_M φ + (n : ℝ) * ‖e θ₁ - e φ‖ := ciInf_le (hΦ_bdd n θ₁) φ
        have htri : ‖e θ₁ - e φ‖ ≤ ‖e θ₁ - e θ₂‖ + ‖e θ₂ - e φ‖ := by
          calc ‖e θ₁ - e φ‖ = ‖(e θ₁ - e θ₂) + (e θ₂ - e φ)‖ := by congr 1; ring
            _ ≤ ‖e θ₁ - e θ₂‖ + ‖e θ₂ - e φ‖ := norm_add_le _ _
        have hmul :
            (n : ℝ) * ‖e θ₁ - e φ‖ ≤ (n : ℝ) * ‖e θ₁ - e θ₂‖ + (n : ℝ) * ‖e θ₂ - e φ‖ := by
          calc (n : ℝ) * ‖e θ₁ - e φ‖
              ≤ (n : ℝ) * (‖e θ₁ - e θ₂‖ + ‖e θ₂ - e φ‖) :=
                mul_le_mul_of_nonneg_left htri (Nat.cast_nonneg n)
            _ = (n : ℝ) * ‖e θ₁ - e θ₂‖ + (n : ℝ) * ‖e θ₂ - e φ‖ := mul_add _ _ _
        dsimp only [Φ]
        linarith
      linarith
    have hq_cont : ∀ n : ℕ, Continuous (q_seq n) := by
      intro n
      rw [Metric.continuous_iff]
      intro θ₀ ε hε
      have hn1_pos : (0 : ℝ) < (n : ℝ) + 1 := by positivity
      obtain ⟨δ, hδ_pos, hδ⟩ := Metric.continuous_iff.mp he_cont θ₀ (ε / ((n : ℝ) + 1))
        (div_pos hε hn1_pos)
      refine ⟨δ, hδ_pos, fun θ hθ => ?_⟩
      have he_dist : ‖e θ - e θ₀‖ < ε / ((n : ℝ) + 1) := by
        simpa [dist_eq_norm] using hδ θ hθ
      have hb1 := hI_lip n θ θ₀
      have hb2 := hI_lip n θ₀ θ
      rw [norm_sub_rev (e θ₀) (e θ)] at hb2
      have habs : |q_seq n θ - q_seq n θ₀| ≤ ((n : ℝ) + 1) * ‖e θ - e θ₀‖ := by
        have hdiff : q_seq n θ - q_seq n θ₀ = I_seq n θ - I_seq n θ₀ := by
          dsimp only [q_seq]; ring
        rw [hdiff, abs_le]
        have hnn : 0 ≤ ‖e θ - e θ₀‖ := norm_nonneg _
        constructor <;> linarith
      rw [Real.dist_eq]
      calc |q_seq n θ - q_seq n θ₀|
          ≤ ((n : ℝ) + 1) * ‖e θ - e θ₀‖ := habs
        _ < ((n : ℝ) + 1) * (ε / ((n : ℝ) + 1)) := mul_lt_mul_of_pos_left he_dist hn1_pos
        _ = ε := mul_div_cancel₀ ε (ne_of_gt hn1_pos)
    have hq_tendsto :
        ∀ θ : ℝ, Filter.Tendsto (fun n => q_seq n θ) Filter.atTop (nhds (g_M θ)) := by
      intro θ
      rw [Metric.tendsto_atTop]
      intro ε hε
      obtain ⟨U, hU_open, hU_eq⟩ :=
        lowerSemicontinuousOn_iff_preimage_Ioi.mp hlsc_raw (g_M θ - ε / 2)
      have hγθ_in : γ θ ∈ Metric.ball (0 : ℂ) L.r_star ∩ U := by
        rw [← hU_eq]
        refine ⟨hγ_mem θ, ?_⟩
        change g_M θ - ε / 2 < g_M θ
        linarith
      obtain ⟨δ_z, hδ_z_pos, hball_sub⟩ :=
        Metric.isOpen_iff.mp (Metric.isOpen_ball.inter hU_open) (γ θ) hγθ_in
      let δ : ℝ := δ_z / ρ
      have hδ_pos : 0 < δ := div_pos hδ_z_pos hρ
      obtain ⟨N, hN⟩ := exists_nat_gt (max (g_M θ / δ) (M.s_base / ε))
      refine ⟨N, fun n hn => ?_⟩
      have hn_real : (N : ℝ) ≤ (n : ℝ) := Nat.cast_le.mpr hn
      have hN_left : g_M θ / δ < (n : ℝ) :=
        lt_of_le_of_lt (le_max_left _ _) (lt_of_lt_of_le hN hn_real)
      have hN_right : M.s_base / ε < (n : ℝ) :=
        lt_of_le_of_lt (le_max_right _ _) (lt_of_lt_of_le hN hn_real)
      have hI_lower : g_M θ - ε / 2 ≤ I_seq n θ := by
        refine le_ciInf (fun φ => ?_)
        by_cases hclose : ‖e φ - e θ‖ < δ
        · have hγ_dist : ‖γ φ - γ θ‖ < δ_z := by
            have hsub : γ φ - γ θ = (ρ : ℂ) * (e φ - e θ) := by dsimp [γ, e]; ring
            rw [hsub, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hρ]
            calc ρ * ‖e φ - e θ‖ < ρ * (δ_z / ρ) := mul_lt_mul_of_pos_left hclose hρ
              _ = δ_z := mul_div_cancel₀ δ_z (ne_of_gt hρ)
          have hφ_in : γ φ ∈ Metric.ball (0 : ℂ) L.r_star ∩
              (fun t : ℂ => (M.h_X t).toReal) ⁻¹' Set.Ioi (g_M θ - ε / 2) := by
            rw [hU_eq]
            apply hball_sub
            simpa [Metric.mem_ball, dist_eq_norm] using hγ_dist
          have hgφ : g_M θ - ε / 2 < g_M φ := hφ_in.2
          have hnn : 0 ≤ (n : ℝ) * ‖e θ - e φ‖ := mul_nonneg (Nat.cast_nonneg n) (norm_nonneg _)
          dsimp only [Φ]
          linarith
        · have hfar : δ ≤ ‖e θ - e φ‖ := by
            rw [norm_sub_rev (e θ) (e φ)]
            exact le_of_not_gt hclose
          have hpen : g_M θ < (n : ℝ) * ‖e θ - e φ‖ := by
            have h1 : g_M θ < (n : ℝ) * δ := (div_lt_iff₀ hδ_pos).mp hN_left
            have h2 : (n : ℝ) * δ ≤ (n : ℝ) * ‖e θ - e φ‖ :=
              mul_le_mul_of_nonneg_left hfar (Nat.cast_nonneg n)
            linarith
          have hgφ_pos : 0 < g_M φ :=
            lt_of_lt_of_le M.s_base_pos (hg_raw_bounds (γ φ) (hγ_mem φ)).1
          dsimp only [Φ]
          linarith
      have hshift_lt : M.s_base / (2 * ((n : ℝ) + 1)) < ε / 2 := by
        have hs_lt : M.s_base < (n : ℝ) * ε := (div_lt_iff₀ hε).mp hN_right
        have hden_pos : (0 : ℝ) < 2 * ((n : ℝ) + 1) := by positivity
        rw [div_lt_div_iff₀ hden_pos two_pos]
        nlinarith
      have hq_upper := hq_lt n θ
      rw [Real.dist_eq, abs_lt]
      dsimp only [q_seq] at hq_upper ⊢
      constructor <;> linarith
    have h_dom_conv :
        Filter.Tendsto (fun n => ∫ θ in (0 : ℝ)..(2 * Real.pi), q_seq n θ)
          Filter.atTop (nhds (∫ θ in (0 : ℝ)..(2 * Real.pi), g_M θ)) := by
      apply intervalIntegral.tendsto_integral_filter_of_dominated_convergence
        (fun _ => H + L.s_star)
      · exact Filter.Eventually.of_forall (fun n => (hq_cont n).aestronglyMeasurable)
      · refine Filter.Eventually.of_forall (fun n => Filter.Eventually.of_forall (fun θ _ => ?_))
        have hpos := hq_pos n θ
        have hlt := hq_lt n θ
        have hle := (hg_raw_bounds (γ θ) (hγ_mem θ)).2
        rw [Real.norm_eq_abs, abs_of_pos hpos]
        dsimp only [g_M] at hlt
        linarith
      · exact intervalIntegrable_const
      · exact Filter.Eventually.of_forall (fun θ _ => hq_tendsto θ)
    have h_supermean_n : ∀ n : ℕ,
        (∫ θ in (0 : ℝ)..(2 * Real.pi), q_seq n θ) ≤ (2 * Real.pi) * (M.h_X t₀).toReal := by
      intro n
      have hsm := M.h_X_supermean t₀ ρ hρ ht₀_ρ_base (q_seq n) (hq_cont n) (hq_per n)
        (fun θ => ⟨le_of_lt (hq_pos n θ),
          (ENNReal.ofReal_lt_iff_lt_toReal (le_of_lt (hq_pos n θ))
            (h_ne_top (γ θ) (hγ_mem θ))).mpr (hq_lt n θ)⟩)
      have hsm_real : (2 * Real.pi)⁻¹ * (∫ θ in (0 : ℝ)..(2 * Real.pi), q_seq n θ) ≤
          (M.h_X t₀).toReal :=
        (ENNReal.ofReal_le_iff_le_toReal (h_ne_top t₀ ht₀_mem)).mp hsm
      have h2pi : 0 < 2 * Real.pi := Real.two_pi_pos
      calc (∫ θ in (0 : ℝ)..(2 * Real.pi), q_seq n θ)
          = (2 * Real.pi) * ((2 * Real.pi)⁻¹ * ∫ θ in (0 : ℝ)..(2 * Real.pi), q_seq n θ) := by
              rw [← mul_assoc, mul_inv_cancel₀ (ne_of_gt h2pi), one_mul]
        _ ≤ (2 * Real.pi) * (M.h_X t₀).toReal :=
              mul_le_mul_of_nonneg_left hsm_real (le_of_lt h2pi)
    have hg_int_le :
        (∫ θ in (0 : ℝ)..(2 * Real.pi), g_M θ) ≤ (2 * Real.pi) * (M.h_X t₀).toReal :=
      le_of_tendsto' h_dom_conv h_supermean_n
    have hd_int_split :
        (∫ θ in (0 : ℝ)..(2 * Real.pi), d_γ θ) =
          (2 * Real.pi) * H -
            ((∫ θ in (0 : ℝ)..(2 * Real.pi), g_M θ) +
              ∫ θ in (0 : ℝ)..(2 * Real.pi), (L.b_shift (γ θ)).im) := by
      change (∫ θ in (0 : ℝ)..(2 * Real.pi),
          (H - (g_M θ + (L.b_shift (γ θ)).im))) = _
      rw [intervalIntegral.integral_sub intervalIntegrable_const (hg_int.add hb_int),
        intervalIntegral.integral_const, sub_zero, smul_eq_mul,
        intervalIntegral.integral_add hg_int hb_int]
    rw [hb_im_int_eq] at hd_int_split
    have hd_lower :
        (2 * Real.pi) * (H - finiteWallWidthFn M L t₀) ≤
          ∫ θ in (0 : ℝ)..(2 * Real.pi), d_γ θ := by
      unfold finiteWallWidthFn
      linarith
    have h2pi_inv_nonneg : 0 ≤ (2 * Real.pi)⁻¹ := inv_nonneg.mpr Real.two_pi_pos.le
    have hfinal := mul_le_mul_of_nonneg_left hd_lower h2pi_inv_nonneg
    rw [← mul_assoc, inv_mul_cancel₀ Real.two_pi_pos.ne', one_mul] at hfinal
    exact ⟨hd_intOn, hfinal⟩
  exact ⟨hH_pos, hs_lt_H, h_ne_top, htube_eq, hbounds, hzero, heven, hlsc, htube_open, hdef_sub⟩

theorem cone_lift_to_shifted_dual_lines (Ω : Set Plane)
    (C : AnalyticGlancingCollar Ω)
    (M : MeromorphicCollarData C)
    (K : NonisotropicCurveData C M)
    (L : NormalizedGlobalLiftData C M K)
    (H δ_star d x₀ : ℝ)
    (hH : M.h_X 0 = ENNReal.ofReal H)
    (hδ0 : 0 < δ_star)
    (hδH : δ_star < H - L.s_star)
    (hd0 : 0 < d)
    (hd_δ : d < δ_star / 6)
    (hd_r : d < L.r_star / 4)
    (s_tilde : ℂ × ℂ → ℂ)
    (hs_holo : DifferentiableOn ℂ s_tilde (coneDomain H δ_star d x₀))
    (hs_maps : ∀ p ∈ coneDomain H δ_star d x₀, s_tilde p ∈ horizStrip H)
    (η : ℝ) (hη : 0 < η)
    (hs_eq : ∀ p ∈ coneDomain H δ_star d x₀,
      δ_star / 2 < H - p.1.im → ‖p.2‖ < η → s_tilde p = L.𝔰 p) :
    Nonempty (ShiftedConeDualLines C M L H δ_star d x₀) :=
by
  let _ := hδ0
  have hH_pos : 0 < H := by linarith [L.s_star_pos]
  have hStrip : horizStripENNR (M.h_X 0) = horizStrip H := by
    ext s
    change ENNReal.ofReal |s.im| < M.h_X 0 ↔ |s.im| < H
    rw [hH]
    exact ENNReal.ofReal_lt_ofReal_iff hH_pos
  have hStrip_open : IsOpen (horizStrip H) :=
    isOpen_Iio.preimage (continuous_abs.comp Complex.continuous_im)
  have hs_lt_base : L.s_star < M.s_base := by
    linarith [L.s_star_le, K.s_init_le, M.s_base_pos]
  have hr_lt_base : L.r_star < M.r_base := by
    linarith [L.r_star_le, K.r_init_le, M.r_base_pos]

  have h_conv_lt : ∀ {x y u v a b : ℝ},
      0 ≤ a → 0 ≤ b → a + b = 1 → x < u → y < v → a * x + b * y < a * u + b * v := by
    intro x y u v a b ha hb hab hxu hyv
    rcases eq_or_lt_of_le ha with rfl | ha_pos
    · simp only [zero_add] at hab; subst hab; simp [hyv]
    · have h1 : a * x < a * u := mul_lt_mul_of_pos_left hxu ha_pos
      have h2 : b * y ≤ b * v := mul_le_mul_of_nonneg_left (le_of_lt hyv) hb
      linarith

  have h_conv_lt_right : ∀ {x y c a b : ℝ},
      0 ≤ a → 0 ≤ b → a + b = 1 → x < c → y < c → a * x + b * y < c := by
    intro x y c a b ha hb hab hxc hyc
    calc a * x + b * y < a * c + b * c := h_conv_lt ha hb hab hxc hyc
      _ = (a + b) * c := by ring
      _ = c := by rw [hab, one_mul]

  have h_conv_lt_left : ∀ {c u v a b : ℝ},
      0 ≤ a → 0 ≤ b → a + b = 1 → c < u → c < v → c < a * u + b * v := by
    intro c u v a b ha hb hab hcu hcv
    calc c = (a + b) * c := by rw [hab, one_mul]
      _ = a * c + b * c := by ring
      _ < a * u + b * v := h_conv_lt ha hb hab hcu hcv

  
  
  
  have h_id2D_ball : ∀ (c : ℂ × ℂ) (R : ℝ) {p₀ : ℂ × ℂ} {r₀ : ℝ} {f : ℂ × ℂ → ℂ},
      p₀ ∈ Metric.ball c R → 0 < r₀ →
      DifferentiableOn ℂ f (Metric.ball c R) →
      (∀ z ∈ Metric.ball p₀ r₀, f z = 0) →
      ∀ q ∈ Metric.ball c R, f q = 0 := by
    intro c R p₀ r₀ f hp₀ hr₀ hf hzero q hq
    let γ : ℂ → ℂ × ℂ := fun w => (p₀.1 + w * (q.1 - p₀.1), p₀.2 + w * (q.2 - p₀.2))
    have hγ_diff : Differentiable ℂ γ :=
      ((differentiable_const p₀.1).add (differentiable_id.mul_const (q.1 - p₀.1))).prodMk
        ((differentiable_const p₀.2).add (differentiable_id.mul_const (q.2 - p₀.2)))
    let U_1d : Set ℂ := γ ⁻¹' Metric.ball c R
    have hU_open : IsOpen U_1d := Metric.isOpen_ball.preimage hγ_diff.continuous
    have hU_conv : Convex ℝ U_1d := by
      intro w₁ hw₁ w₂ hw₂ a b ha hb hab
      have habC : (a : ℂ) + (b : ℂ) = 1 := by exact_mod_cast hab
      have hγ_comb : γ (a • w₁ + b • w₂) = a • γ w₁ + b • γ w₂ := by
        ext
        · simp only [γ, Prod.smul_fst, Prod.fst_add, Complex.real_smul]
          linear_combination -p₀.1 * habC
        · simp only [γ, Prod.smul_snd, Prod.snd_add, Complex.real_smul]
          linear_combination -p₀.2 * habC
      change γ (a • w₁ + b • w₂) ∈ Metric.ball c R
      rw [hγ_comb]
      exact convex_ball c R hw₁ hw₂ ha hb hab
    have hγ0 : γ 0 = p₀ := by ext <;> simp [γ]
    have hγ1 : γ 1 = q := by ext <;> simp [γ]
    have h0_mem : (0 : ℂ) ∈ U_1d := by change γ 0 ∈ Metric.ball c R; rwa [hγ0]
    have h1_mem : (1 : ℂ) ∈ U_1d := by change γ 1 ∈ Metric.ball c R; rwa [hγ1]
    have hfγ_ana : AnalyticOnNhd ℂ (fun w => f (γ w)) U_1d :=
      (hf.comp hγ_diff.differentiableOn (fun _ hw => hw)).analyticOnNhd hU_open
    have hfγ_ev : (fun w => f (γ w)) =ᶠ[nhds (0 : ℂ)] 0 := by
      have h_pre : γ ⁻¹' Metric.ball p₀ r₀ ∈ nhds (0 : ℂ) :=
        hγ_diff.continuous.continuousAt.preimage_mem_nhds
          (by rw [hγ0]; exact Metric.ball_mem_nhds p₀ hr₀)
      exact Filter.eventually_of_mem h_pre (fun w hw => hzero (γ w) hw)
    have h1_eq := hfγ_ana.eqOn_zero_of_preconnected_of_eventuallyEq_zero
      hU_conv.isPreconnected h0_mem hfγ_ev h1_mem
    change f (γ 1) = 0 at h1_eq
    rwa [hγ1] at h1_eq

  have h_id2D : ∀ {W V : Set (ℂ × ℂ)},
      IsOpen W → IsPreconnected W → IsOpen V → V.Nonempty → V ⊆ W →
      ∀ {f : ℂ × ℂ → ℂ}, DifferentiableOn ℂ f W → (∀ p ∈ V, f p = 0) → ∀ p ∈ W, f p = 0 := by
    intro W V hWo hWp hVo ⟨p_init, hp_init⟩ hVW f hf hV0
    let O_zero : Set (ℂ × ℂ) := { p ∈ W | ∃ r > 0, ∀ z ∈ Metric.ball p r, f z = 0 }
    let O_nz : Set (ℂ × ℂ) := { p ∈ W | ∃ r > 0, Metric.ball p r ⊆ W \ O_zero }
    have hO_zero_open : IsOpen O_zero := by
      rw [Metric.isOpen_iff]
      intro p ⟨hpW, r, hr, hsub⟩
      obtain ⟨rW, hrW, hballW⟩ := Metric.isOpen_iff.mp hWo p hpW
      let r₀ := min r rW
      refine ⟨r₀, lt_min hr hrW, fun q hq => ⟨hballW (Metric.ball_subset_ball (min_le_right _ _) hq),
        r₀ - dist q p, sub_pos.mpr hq, ?_⟩⟩
      intro z hz
      exact hsub z (Metric.ball_subset_ball (min_le_left _ _)
        (Metric.ball_subset_ball' (by linarith) hz))
    have hO_nz_open : IsOpen O_nz := by
      rw [Metric.isOpen_iff]
      intro p ⟨_, r, hr, hsub⟩
      refine ⟨r, hr, fun q hq => ⟨(hsub hq).1, r - dist q p, sub_pos.mpr hq, ?_⟩⟩
      exact Set.Subset.trans (Metric.ball_subset_ball' (by linarith)) hsub
    have h_cov : W ⊆ O_zero ∪ O_nz := by
      intro p hpW
      obtain ⟨R, hR, hballW⟩ := Metric.isOpen_iff.mp hWo p hpW
      by_cases hp0 : p ∈ O_zero
      · exact Or.inl hp0
      · refine Or.inr ⟨hpW, R, hR, fun q hq => ⟨hballW hq, fun ⟨_, rq, hrq, hqz⟩ => ?_⟩⟩
        exact hp0 ⟨hpW, R, hR, h_id2D_ball p R hq hrq (hf.mono hballW) hqz⟩
    have h_disj : W ∩ (O_zero ∩ O_nz) = ∅ := by
      ext p; simp only [Set.mem_inter_iff, Set.mem_empty_iff_false, iff_false, not_and]
      intro _ hp0 ⟨_, r, hr, hsub⟩
      exact (hsub (Metric.mem_ball_self hr)).2 hp0
    have h_init_zero : p_init ∈ O_zero := by
      obtain ⟨rV, hrV, hballV⟩ := Metric.isOpen_iff.mp hVo p_init hp_init
      exact ⟨hVW hp_init, rV, hrV, fun z hz => hV0 z (hballV hz)⟩
    rcases (isPreconnected_iff_subset_of_disjoint.mp hWp) O_zero O_nz hO_zero_open hO_nz_open
        h_cov h_disj with hSub0 | hSubNz
    · intro p hpW
      obtain ⟨_, r, hr, hsub⟩ := hSub0 hpW
      exact hsub p (Metric.mem_ball_self hr)
    · obtain ⟨_, r, hr, hsub⟩ := hSubNz (hVW hp_init)
      exact False.elim ((hsub (Metric.mem_ball_self hr)).2 h_init_zero)

  
  
  
  have h_exists_nz : ∀ {W V : Set (ℂ × ℂ)} {f : ℂ × ℂ → ℂ},
      IsOpen W → IsPreconnected W → DifferentiableOn ℂ f W →
      (∃ q₁ ∈ W, f q₁ ≠ 0) → IsOpen V → V.Nonempty → V ⊆ W →
      ∃ q ∈ V, f q ≠ 0 := by
    intro W V f hWo hWp hf ⟨q₁, hq₁W, hq₁⟩ hVo hVn hVW
    by_contra h_all
    have h_zero : ∀ q ∈ V, f q = 0 := fun q hq => by
      by_contra hne; exact h_all ⟨q, hq, hne⟩
    exact hq₁ (h_id2D hWo hWp hVo hVn hVW hf h_zero q₁ hq₁W)

  have h_meroEqOn_of_local : ∀ {W₁ W₂ U : Set (ℂ × ℂ)}
      (F₁ : MeroOn2D W₁) (F₂ : MeroOn2D W₂),
      U ⊆ W₁ ∩ W₂ →
      (∀ p ∈ U, ∃ r : ℝ, 0 < r ∧ ∀ q ∈ Metric.ball p r,
        F₁.num p q * F₂.den p q = F₂.num p q * F₁.den p q) →
      MeroEqOn F₁ F₂ U := by
    intro W₁ W₂ U F₁ F₂ hU hloc
    refine ⟨hU, fun p hp q hq => ?_⟩
    obtain ⟨hp₁, hp₂⟩ := hU hp
    obtain ⟨r, hr, h_eq⟩ := hloc p hp
    let R := min (F₁.rad p) (F₂.rad p)
    have hR : 0 < R := lt_min (F₁.rad_pos p hp₁) (F₂.rad_pos p hp₂)
    let r₀ := min r R
    have hr₀ : 0 < r₀ := lt_min hr hR
    have h_diff_holo : DifferentiableOn ℂ
        (fun z => F₁.num p z * F₂.den p z - F₂.num p z * F₁.den p z) (Metric.ball p R) := by
      have hsub₁ : Metric.ball p R ⊆ Metric.ball p (F₁.rad p) :=
        Metric.ball_subset_ball (min_le_left _ _)
      have hsub₂ : Metric.ball p R ⊆ Metric.ball p (F₂.rad p) :=
        Metric.ball_subset_ball (min_le_right _ _)
      exact ((F₁.num_holo p hp₁).mono hsub₁ |>.mul ((F₂.den_holo p hp₂).mono hsub₂)).sub
        (((F₂.num_holo p hp₂).mono hsub₂).mul ((F₁.den_holo p hp₁).mono hsub₁))
    have h_zero : ∀ z ∈ Metric.ball p r₀,
        F₁.num p z * F₂.den p z - F₂.num p z * F₁.den p z = 0 := by
      intro z hz
      exact sub_eq_zero.mpr (h_eq z (Metric.ball_subset_ball (min_le_left _ _) hz))
    exact sub_eq_zero.mp (h_id2D Metric.isOpen_ball
      (convex_ball p R).isPreconnected Metric.isOpen_ball ⟨p, Metric.mem_ball_self hr₀⟩
      (Metric.ball_subset_ball (min_le_right _ _)) h_diff_holo h_zero q hq)

  have h_meroEqOn_symm : ∀ {W₁ W₂ U : Set (ℂ × ℂ)}
      {F₁ : MeroOn2D W₁} {F₂ : MeroOn2D W₂},
      MeroEqOn F₁ F₂ U → MeroEqOn F₂ F₁ U := by
    intro W₁ W₂ U F₁ F₂ ⟨hU, hEq⟩
    refine ⟨fun p hp => ⟨(hU hp).2, (hU hp).1⟩, fun p hp q hq => ?_⟩
    rw [min_comm] at hq
    exact (hEq p hp q hq).symm

  have h_meroEqOn_mono : ∀ {W₁ W₂ U V : Set (ℂ × ℂ)}
      {F₁ : MeroOn2D W₁} {F₂ : MeroOn2D W₂},
      V ⊆ U → MeroEqOn F₁ F₂ U → MeroEqOn F₁ F₂ V := by
    intro W₁ W₂ U V F₁ F₂ hVU ⟨hU, hEq⟩
    exact ⟨Set.Subset.trans hVU hU, fun p hp => hEq p (hVU hp)⟩

  have h_meroEqOn_trans : ∀ {W₁ W₂ W₃ U : Set (ℂ × ℂ)}
      {F₁ : MeroOn2D W₁} {F₂ : MeroOn2D W₂} {F₃ : MeroOn2D W₃},
      MeroEqOn F₁ F₂ U → MeroEqOn F₂ F₃ U → MeroEqOn F₁ F₃ U := by
    intro W₁ W₂ W₃ U F₁ F₂ F₃ ⟨hU₁₂, hEq₁₂⟩ ⟨hU₂₃, hEq₂₃⟩
    refine h_meroEqOn_of_local F₁ F₃ (fun p hp => ⟨(hU₁₂ hp).1, (hU₂₃ hp).2⟩) (fun p hp => ?_)
    have hp₁ : p ∈ W₁ := (hU₁₂ hp).1
    have hp₂ : p ∈ W₂ := (hU₁₂ hp).2
    have hp₃ : p ∈ W₃ := (hU₂₃ hp).2
    let r := min (F₁.rad p) (min (F₂.rad p) (F₃.rad p))
    have hr : 0 < r := lt_min (F₁.rad_pos p hp₁) (lt_min (F₂.rad_pos p hp₂) (F₃.rad_pos p hp₃))
    refine ⟨r, hr, fun q hq => ?_⟩
    have h_sub₂ : Metric.ball p r ⊆ Metric.ball p (F₂.rad p) :=
      Metric.ball_subset_ball (le_trans (min_le_right _ _) (min_le_left _ _))
    let V_nz : Set (ℂ × ℂ) := Metric.ball p r ∩ (F₂.den p) ⁻¹' {(0 : ℂ)}ᶜ
    have hV_open : IsOpen V_nz :=
      ((F₂.den_holo p hp₂).continuousOn.mono h_sub₂).isOpen_inter_preimage
        Metric.isOpen_ball isOpen_compl_singleton
    obtain ⟨q₀, hq₀⟩ := h_exists_nz Metric.isOpen_ball (convex_ball p (F₂.rad p)).isPreconnected
      (F₂.den_holo p hp₂) (F₂.den_ne_zero p hp₂) Metric.isOpen_ball
      ⟨p, Metric.mem_ball_self hr⟩ h_sub₂
    have hV_ne : V_nz.Nonempty := ⟨q₀, hq₀.1, hq₀.2⟩
    have h_holo : DifferentiableOn ℂ
        (fun z => F₁.num p z * F₃.den p z - F₃.num p z * F₁.den p z) (Metric.ball p r) := by
      have hs₁ : Metric.ball p r ⊆ Metric.ball p (F₁.rad p) := Metric.ball_subset_ball (min_le_left _ _)
      have hs₃ : Metric.ball p r ⊆ Metric.ball p (F₃.rad p) :=
        Metric.ball_subset_ball (le_trans (min_le_right _ _) (min_le_right _ _))
      exact ((F₁.num_holo p hp₁).mono hs₁ |>.mul ((F₃.den_holo p hp₃).mono hs₃)).sub
        (((F₃.num_holo p hp₃).mono hs₃).mul ((F₁.den_holo p hp₁).mono hs₁))
    have h_van : ∀ z ∈ V_nz, F₁.num p z * F₃.den p z - F₃.num p z * F₁.den p z = 0 := by
      intro z ⟨hz_ball, hz_nz⟩
      have hz₁₂ : z ∈ Metric.ball p (min (F₁.rad p) (F₂.rad p)) :=
        Metric.ball_subset_ball (min_le_min_left _ (min_le_left _ _)) hz_ball
      have hz₂₃ : z ∈ Metric.ball p (min (F₂.rad p) (F₃.rad p)) :=
        Metric.ball_subset_ball (min_le_right _ _) hz_ball
      have h1 := hEq₁₂ p hp z hz₁₂
      have h2 := hEq₂₃ p hp z hz₂₃
      have hmul : (F₁.num p z * F₃.den p z - F₃.num p z * F₁.den p z) * F₂.den p z = 0 := by
        linear_combination F₃.den p z * h1 + F₁.den p z * h2
      exact (mul_eq_zero.mp hmul).resolve_right hz_nz
    exact sub_eq_zero.mp (h_id2D Metric.isOpen_ball
      (convex_ball p r).isPreconnected hV_open hV_ne (fun _ hz => hz.1) h_holo h_van q hq)

  have h_meroEqOn_propagate : ∀ {W₁ W₂ U V : Set (ℂ × ℂ)}
      {F₁ : MeroOn2D W₁} {F₂ : MeroOn2D W₂},
      IsOpen U → IsPreconnected U → U ⊆ W₁ ∩ W₂ →
      IsOpen V → V.Nonempty → V ⊆ U →
      MeroEqOn F₁ F₂ V → MeroEqOn F₁ F₂ U := by
    intro W₁ W₂ U V F₁ F₂ hUo hUp hUW hVo ⟨p_init, hp_init⟩ hVU ⟨_, hVEq⟩
    refine ⟨hUW, ?_⟩
    let δ : ℂ × ℂ → ℝ := fun p => min (F₁.rad p) (F₂.rad p)
    let diffFn : ℂ × ℂ → ℂ × ℂ → ℂ :=
      fun p q => F₁.num p q * F₂.den p q - F₂.num p q * F₁.den p q
    let S_eq : Set (ℂ × ℂ) := { p ∈ U | ∀ q ∈ Metric.ball p (δ p), diffFn p q = 0 }
    have h_diff_holo : ∀ p ∈ U, DifferentiableOn ℂ (diffFn p) (Metric.ball p (δ p)) := by
      intro p hp
      obtain ⟨hp₁, hp₂⟩ := hUW hp
      have hs₁ : Metric.ball p (δ p) ⊆ Metric.ball p (F₁.rad p) := Metric.ball_subset_ball (min_le_left _ _)
      have hs₂ : Metric.ball p (δ p) ⊆ Metric.ball p (F₂.rad p) := Metric.ball_subset_ball (min_le_right _ _)
      exact ((F₁.num_holo p hp₁).mono hs₁ |>.mul ((F₂.den_holo p hp₂).mono hs₂)).sub
        (((F₂.num_holo p hp₂).mono hs₂).mul ((F₁.den_holo p hp₁).mono hs₁))
    have h_transfer : ∀ p₁ ∈ U, ∀ p₂ ∈ U,
        (Metric.ball p₁ (δ p₁) ∩ Metric.ball p₂ (δ p₂)).Nonempty →
        (p₁ ∈ S_eq → p₂ ∈ S_eq) := by
      intro p₁ hp₁ p₂ hp₂ hB_ne hp₁_eq
      obtain ⟨hp₁W₁, hp₁W₂⟩ := hUW hp₁
      obtain ⟨hp₂W₁, hp₂W₂⟩ := hUW hp₂
      refine ⟨hp₂, fun q hq => ?_⟩
      let B₁₂ := Metric.ball p₁ (δ p₁) ∩ Metric.ball p₂ (δ p₂)
      have hB_open : IsOpen B₁₂ := Metric.isOpen_ball.inter Metric.isOpen_ball
      have hB_sub₁ : B₁₂ ⊆ Metric.ball p₁ (F₁.rad p₁) :=
        fun z hz => Metric.ball_subset_ball (min_le_left _ _) hz.1
      have hB_sub₂ : B₁₂ ⊆ Metric.ball p₁ (F₂.rad p₁) :=
        fun z hz => Metric.ball_subset_ball (min_le_right _ _) hz.1
      let U₁ : Set (ℂ × ℂ) := B₁₂ ∩ (F₁.den p₁) ⁻¹' {(0 : ℂ)}ᶜ
      have hU₁_open : IsOpen U₁ :=
        ((F₁.den_holo p₁ hp₁W₁).continuousOn.mono hB_sub₁).isOpen_inter_preimage
          hB_open isOpen_compl_singleton
      obtain ⟨z₁, hz₁B, hz₁nz⟩ := h_exists_nz Metric.isOpen_ball
        (convex_ball p₁ (F₁.rad p₁)).isPreconnected (F₁.den_holo p₁ hp₁W₁) (F₁.den_ne_zero p₁ hp₁W₁)
        hB_open hB_ne hB_sub₁
      let U₂ : Set (ℂ × ℂ) := U₁ ∩ (F₂.den p₁) ⁻¹' {(0 : ℂ)}ᶜ
      have hU₂_open : IsOpen U₂ :=
        ((F₂.den_holo p₁ hp₁W₂).continuousOn.mono (fun z hz => hB_sub₂ hz.1)).isOpen_inter_preimage
          hU₁_open isOpen_compl_singleton
      obtain ⟨z₂, hz₂U₁, hz₂nz⟩ := h_exists_nz Metric.isOpen_ball
        (convex_ball p₁ (F₂.rad p₁)).isPreconnected (F₂.den_holo p₁ hp₁W₂) (F₂.den_ne_zero p₁ hp₁W₂)
        hU₁_open ⟨z₁, hz₁B, hz₁nz⟩ (fun z hz => hB_sub₂ hz.1)
      have h_van_U₂ : ∀ z ∈ U₂, diffFn p₂ z = 0 := by
        intro z ⟨⟨hzB, hden₁⟩, hden₂⟩
        have hc₁ := F₁.compat p₁ hp₁W₁ p₂ hp₂W₁ z
          ⟨Metric.ball_subset_ball (min_le_left _ _) hzB.1,
           Metric.ball_subset_ball (min_le_left _ _) hzB.2⟩
        have hc₂ := F₂.compat p₁ hp₁W₂ p₂ hp₂W₂ z
          ⟨Metric.ball_subset_ball (min_le_right _ _) hzB.1,
           Metric.ball_subset_ball (min_le_right _ _) hzB.2⟩
        have hp₁_z : diffFn p₁ z = 0 := hp₁_eq.2 z hzB.1
        have hmul : diffFn p₂ z * (F₁.den p₁ z * F₂.den p₁ z) = 0 := by
          dsimp only [diffFn] at hp₁_z ⊢
          linear_combination F₁.den p₂ z * F₂.den p₂ z * hp₁_z -
            F₂.den p₁ z * F₂.den p₂ z * hc₁ + F₁.den p₁ z * F₁.den p₂ z * hc₂
        exact (mul_eq_zero.mp hmul).resolve_right (mul_ne_zero hden₁ hden₂)
      have hδ₂ : 0 < δ p₂ := lt_min (F₁.rad_pos p₂ hp₂W₁) (F₂.rad_pos p₂ hp₂W₂)
      exact h_id2D Metric.isOpen_ball (convex_ball p₂ (δ p₂)).isPreconnected
        hU₂_open ⟨z₂, hz₂U₁, hz₂nz⟩ (fun z hz => hz.1.1.2) (h_diff_holo p₂ hp₂) h_van_U₂ q hq
    let O_yes := { p ∈ U | ∃ r > 0, Metric.ball p r ⊆ S_eq }
    let O_no := { p ∈ U | ∃ r > 0, Metric.ball p r ⊆ U \ S_eq }
    have hO_yes_open : IsOpen O_yes := by
      rw [Metric.isOpen_iff]
      intro p ⟨hpU, r, hr, hsub⟩
      refine ⟨r, hr, fun q hq => ⟨(hsub hq).1, r - dist q p, sub_pos.mpr hq, ?_⟩⟩
      exact Set.Subset.trans (Metric.ball_subset_ball' (by linarith)) hsub
    have hO_no_open : IsOpen O_no := by
      rw [Metric.isOpen_iff]
      intro p ⟨hpU, r, hr, hsub⟩
      refine ⟨r, hr, fun q hq => ⟨(hsub hq).1, r - dist q p, sub_pos.mpr hq, ?_⟩⟩
      exact Set.Subset.trans (Metric.ball_subset_ball' (by linarith)) hsub
    have hU_cov : U ⊆ O_yes ∪ O_no := by
      intro p hpU
      obtain ⟨rU, hrU, hballU⟩ := Metric.isOpen_iff.mp hUo p hpU
      obtain ⟨hpW₁, hpW₂⟩ := hUW hpU
      let r := min rU (δ p)
      have hr : 0 < r := lt_min hrU (lt_min (F₁.rad_pos p hpW₁) (F₂.rad_pos p hpW₂))
      by_cases hpS : p ∈ S_eq
      · refine Or.inl ⟨hpU, r, hr, fun q hq => ?_⟩
        have hqU : q ∈ U := hballU (Metric.ball_subset_ball (min_le_left _ _) hq)
        have hδq : 0 < δ q := lt_min (F₁.rad_pos q (hUW hqU).1) (F₂.rad_pos q (hUW hqU).2)
        exact h_transfer p hpU q hqU
          ⟨q, Metric.ball_subset_ball (min_le_right _ _) hq, Metric.mem_ball_self hδq⟩ hpS
      · refine Or.inr ⟨hpU, r, hr, fun q hq => ⟨hballU (Metric.ball_subset_ball (min_le_left _ _) hq), ?_⟩⟩
        intro hqS
        have hqU : q ∈ U := hballU (Metric.ball_subset_ball (min_le_left _ _) hq)
        have hδq : 0 < δ q := lt_min (F₁.rad_pos q (hUW hqU).1) (F₂.rad_pos q (hUW hqU).2)
        exact hpS (h_transfer q hqU p hpU
          ⟨q, Metric.mem_ball_self hδq, Metric.ball_subset_ball (min_le_right _ _) hq⟩ hqS)
    have h_disj : U ∩ (O_yes ∩ O_no) = ∅ := by
      ext p
      simp only [Set.mem_inter_iff, Set.mem_empty_iff_false, iff_false, not_and]
      intro _ ⟨_, r₁, hr₁, hs₁⟩ ⟨_, r₂, hr₂, hs₂⟩
      exact (hs₂ (Metric.mem_ball_self hr₂)).2 (hs₁ (Metric.mem_ball_self hr₁))
    have h_init_yes : p_init ∈ O_yes := by
      obtain ⟨rV, hrV, hballV⟩ := Metric.isOpen_iff.mp hVo p_init hp_init
      refine ⟨hVU hp_init, rV, hrV, fun q hq => ⟨hVU (hballV hq), fun z hz => ?_⟩⟩
      exact sub_eq_zero.mpr (hVEq q (hballV hq) z hz)
    rcases (isPreconnected_iff_subset_of_disjoint.mp hUp) O_yes O_no hO_yes_open hO_no_open
        hU_cov h_disj with hSubYes | hSubNo
    · intro p hpU q hq
      obtain ⟨_, r, hr, hsub⟩ := hSubYes hpU
      exact sub_eq_zero.mp ((hsub (Metric.mem_ball_self hr)).2 q hq)
    · obtain ⟨_, r, hr, hsub⟩ := hSubNo (hVU hp_init)
      obtain ⟨_, r₁, hr₁, hs₁⟩ := h_init_yes
      exact False.elim ((hsub (Metric.mem_ball_self hr)).2 (hs₁ (Metric.mem_ball_self hr₁)))

  
  
  
  let reflectW : (Fin 2 → ℂ) → (Fin 2 → ℂ) → (Fin 2 → ℂ) :=
    fun P Q => ![P 1 - Q 1, Q 0 - P 0]
  let reflectVtilde : (Fin 2 → ℂ) → (Fin 2 → ℂ) → ℂ → (Fin 2 → ℂ) :=
    fun P Q ψ =>
      let W := reflectW P Q
      let dot := W 0 * Complex.cos ψ + W 1 * Complex.sin ψ
      ![2 * dot * Complex.cos ψ - W 0, 2 * dot * Complex.sin ψ - W 1]
  let reflectDen : (Fin 2 → ℂ) → (Fin 2 → ℂ) → ℂ → ℂ :=
    fun P Q ψ =>
      let V := reflectVtilde P Q ψ
      P 0 * V 0 + P 1 * V 1

  have h_Vtilde_homog : ∀ (P Q : Fin 2 → ℂ) (ψ c : ℂ) (i : Fin 2),
      reflectVtilde (fun j => c * P j) (fun j => c * Q j) ψ i =
        c * reflectVtilde P Q ψ i := by
    intro P Q ψ c
    refine Fin.forall_fin_two.mpr ⟨?_, ?_⟩
    · simp [reflectVtilde, reflectW]; ring
    · simp [reflectVtilde, reflectW]; ring

  have h_Den_homog : ∀ (P Q : Fin 2 → ℂ) (ψ c : ℂ),
      reflectDen (fun j => c * P j) (fun j => c * Q j) ψ =
        c ^ 2 * reflectDen P Q ψ := by
    intro P Q ψ c
    simp [reflectDen, reflectVtilde, reflectW]
    ring

  have h_pole_clear_1d : ∀ s₀ ∈ horizStrip H,
      ∃ (r_s : ℝ) (N : ℕ) (P_hol : Fin 2 → ℂ → ℂ),
        0 < r_s ∧
        Metric.ball s₀ r_s ⊆ horizStrip H ∧
        (∀ i : Fin 2, DifferentiableOn ℂ (P_hol i) (Metric.ball s₀ r_s)) ∧
        (K.f s₀ ≠ 0 → N = 0 ∧ ∀ i : Fin 2, ∀ z ∈ Metric.ball s₀ r_s, P_hol i z = K.Γ z i) ∧
        (∀ i : Fin 2, ∀ z ∈ Metric.ball s₀ r_s, z ≠ s₀ →
          P_hol i z = (z - s₀) ^ N * K.Γ z i) := by
    intro s₀ hs₀
    have hs₀_ennr : s₀ ∈ horizStripENNR (M.h_X 0) := hStrip.symm ▸ hs₀
    by_cases hf : K.f s₀ ≠ 0
    · have hf_cont : ContinuousAt K.f s₀ :=
        (hStrip ▸ K.f_holo).continuousOn.continuousAt (hStrip_open.mem_nhds hs₀)
      have h_nhds : horizStrip H ∩ { z : ℂ | K.f z ≠ 0 } ∈ nhds s₀ :=
        Filter.inter_mem (hStrip_open.mem_nhds hs₀) (hf_cont.eventually_ne hf)
      obtain ⟨r_s, hr_s, hball⟩ := Metric.mem_nhds_iff.mp h_nhds
      refine ⟨r_s, 0, fun i z => K.Γ z i, hr_s, fun z hz => (hball hz).1, ?_,
        fun _ => ⟨rfl, fun _ _ _ => rfl⟩, fun _ _ _ _ => by simp⟩
      refine Fin.forall_fin_two.mpr ⟨?_, ?_⟩
      · exact fun z hz => (K.Γ_reg_holo z (hStrip.symm ▸ (hball hz).1) (hball hz).2).1.differentiableWithinAt
      · exact fun z hz => (K.Γ_reg_holo z (hStrip.symm ▸ (hball hz).1) (hball hz).2).2.differentiableWithinAt
    · obtain ⟨n₀, g₀, hg₀_ana, hg₀_eq⟩ :=
        MeromorphicAt.iff_eventuallyEq_zpow_smul_analyticAt.mp (K.Γ_mero.1 s₀ hs₀_ennr)
      obtain ⟨n₁, g₁, hg₁_ana, hg₁_eq⟩ :=
        MeromorphicAt.iff_eventuallyEq_zpow_smul_analyticAt.mp (K.Γ_mero.2 s₀ hs₀_ennr)
      let N : ℕ := max (-n₀).toNat (-n₁).toNat
      let M₀ : ℕ := (n₀ + (N : ℤ)).toNat
      let M₁ : ℕ := (n₁ + (N : ℤ)).toNat
      have hM₀ : (M₀ : ℤ) = n₀ + (N : ℤ) := by
        have hle : (-n₀).toNat ≤ N := le_max_left _ _
        omega
      have hM₁ : (M₁ : ℤ) = n₁ + (N : ℤ) := by
        have hle : (-n₁).toNat ≤ N := le_max_right _ _
        omega
      have h_nhds : (horizStrip H ∩ { z : ℂ | DifferentiableAt ℂ g₀ z } ∩
          { z : ℂ | DifferentiableAt ℂ g₁ z }) ∈ nhds s₀ :=
        Filter.inter_mem
          (Filter.inter_mem (hStrip_open.mem_nhds hs₀)
            (Complex.analyticAt_iff_eventually_differentiableAt.mp hg₀_ana))
          (Complex.analyticAt_iff_eventually_differentiableAt.mp hg₁_ana)
      obtain ⟨r₁, hr₁, hball₁⟩ := Metric.mem_nhds_iff.mp h_nhds
      obtain ⟨r₂, hr₂, hball₂⟩ := Metric.mem_nhdsWithin_iff.mp (Filter.inter_mem hg₀_eq hg₁_eq)
      let r_s := min r₁ r₂
      have hr_s : 0 < r_s := lt_min hr₁ hr₂
      let P_hol : Fin 2 → ℂ → ℂ :=
        ![fun z => (z - s₀) ^ M₀ * g₀ z, fun z => (z - s₀) ^ M₁ * g₁ z]
      refine ⟨r_s, N, P_hol, hr_s,
        fun z hz => ((hball₁ (Metric.ball_subset_ball (min_le_left _ _) hz)).1).1, ?_,
        fun h_abs => absurd h_abs hf, ?_⟩
      · refine Fin.forall_fin_two.mpr ⟨?_, ?_⟩
        · intro z hz
          have hz₁ := hball₁ (Metric.ball_subset_ball (min_le_left _ _) hz)
          exact (((differentiableAt_id.sub (differentiableAt_const s₀)).pow M₀).mul
            hz₁.1.2).differentiableWithinAt
        · intro z hz
          have hz₁ := hball₁ (Metric.ball_subset_ball (min_le_left _ _) hz)
          exact (((differentiableAt_id.sub (differentiableAt_const s₀)).pow M₁).mul
            hz₁.2).differentiableWithinAt
      · refine Fin.forall_fin_two.mpr ⟨?_, ?_⟩
        · intro z hz hzne
          obtain ⟨heq₀, _⟩ := hball₂ ⟨Metric.ball_subset_ball (min_le_right _ _) hz, hzne⟩
          have hsub_ne : z - s₀ ≠ 0 := sub_ne_zero.mpr hzne
          simp only [P_hol, Matrix.cons_val_zero]
          rw [heq₀, smul_eq_mul, ← mul_assoc, ← zpow_natCast (z - s₀) N,
            ← zpow_add₀ hsub_ne, add_comm (N : ℤ) n₀, ← hM₀, zpow_natCast]
        · intro z hz hzne
          obtain ⟨_, heq₁⟩ := hball₂ ⟨Metric.ball_subset_ball (min_le_right _ _) hz, hzne⟩
          have hsub_ne : z - s₀ ≠ 0 := sub_ne_zero.mpr hzne
          simp only [P_hol, Matrix.cons_val_one, Matrix.cons_val_zero]
          rw [heq₁, smul_eq_mul, ← mul_assoc, ← zpow_natCast (z - s₀) N,
            ← zpow_add₀ hsub_ne, add_comm (N : ℤ) n₁, ← hM₁, zpow_natCast]

  have h_mkReflectedMero : ∀ {W : Set (ℂ × ℂ)} (hWo : IsOpen W) (hWc : Convex ℝ W)
      (g_near g_far : ℂ × ℂ → ℂ)
      (hgn_holo : DifferentiableOn ℂ g_near W)
      (hgf_holo : DifferentiableOn ℂ g_far W)
      (hgn_maps : ∀ p ∈ W, g_near p ∈ horizStrip H)
      (hgf_maps : ∀ p ∈ W, g_far p ∈ horizStrip H)
      (hgn_nc : ∃ q₁ ∈ W, ∃ q₂ ∈ W, g_near q₁ ≠ g_near q₂)
      (hgf_nc : ∃ q₁ ∈ W, ∃ q₂ ∈ W, g_far q₁ ≠ g_far q₂)
      {U₀ : Set (ℂ × ℂ)} (hU₀_sub : U₀ ⊆ W)
      (hU₀_reg : ∀ q ∈ U₀, K.f (g_near q) ≠ 0 ∧ K.f (g_far q) ≠ 0)
      {q₀ : ℂ × ℂ} (hq₀ : q₀ ∈ U₀)
      (hD_q₀ : reflectDen (K.Γ (g_near q₀)) (K.Γ (g_far q₀)) (K.ϕ (g_near q₀)) ≠ 0),
      ∃ F : Fin 2 → MeroOn2D W,
        ∀ {U_reg : Set (ℂ × ℂ)}, IsOpen U_reg → U_reg ⊆ W →
          (∀ q ∈ U_reg, K.f (g_near q) ≠ 0 ∧ K.f (g_far q) ≠ 0) →
          (U_reg.Nonempty → ∃ q ∈ U_reg,
            reflectDen (K.Γ (g_near q)) (K.Γ (g_far q)) (K.ϕ (g_near q)) ≠ 0) ∧
          (∀ p ∈ U_reg, ∃ r : ℝ, 0 < r ∧ r ≤ (F 0).rad p ∧ (F 1).rad p = (F 0).rad p ∧
            Metric.ball p r ⊆ U_reg ∧
            ∀ q ∈ Metric.ball p r, ∀ i : Fin 2,
              (F i).num p q =
                reflectVtilde (K.Γ (g_near q)) (K.Γ (g_far q)) (K.ϕ (g_near q)) i ∧
              (F i).den p q =
                reflectDen (K.Γ (g_near q)) (K.Γ (g_far q)) (K.ϕ (g_near q))) := by
    intro W hWo hWc g_near g_far hgn_holo hgf_holo hgn_maps hgf_maps hgn_nc hgf_nc
      U₀ hU₀_sub hU₀_reg q₀ hq₀ hD_q₀
    have hWp : IsPreconnected W := hWc.isPreconnected
    have hϕ_holo_H : DifferentiableOn ℂ K.ϕ (horizStrip H) := hStrip ▸ K.ϕ_holo
    have hψ_holo : DifferentiableOn ℂ (fun q => K.ϕ (g_near q)) W :=
      hϕ_holo_H.comp hgn_holo hgn_maps
    have h_local_chart : ∀ p : ℂ × ℂ, ∃ (rad : ℝ) (N₁ N₂ : ℕ) (P_hol Q_hol : Fin 2 → ℂ → ℂ),
        (p ∈ W →
          0 < rad ∧
          Metric.ball p rad ⊆ W ∧
          (∀ i : Fin 2, DifferentiableOn ℂ (fun q => P_hol i (g_near q)) (Metric.ball p rad)) ∧
          (∀ i : Fin 2, DifferentiableOn ℂ (fun q => Q_hol i (g_far q)) (Metric.ball p rad)) ∧
          (K.f (g_near p) ≠ 0 → N₁ = 0 ∧
            ∀ i : Fin 2, ∀ q ∈ Metric.ball p rad, P_hol i (g_near q) = K.Γ (g_near q) i) ∧
          (K.f (g_far p) ≠ 0 → N₂ = 0 ∧
            ∀ i : Fin 2, ∀ q ∈ Metric.ball p rad, Q_hol i (g_far q) = K.Γ (g_far q) i) ∧
          (∀ i : Fin 2, ∀ q ∈ Metric.ball p rad, g_near q ≠ g_near p →
            P_hol i (g_near q) = (g_near q - g_near p) ^ N₁ * K.Γ (g_near q) i) ∧
          (∀ i : Fin 2, ∀ q ∈ Metric.ball p rad, g_far q ≠ g_far p →
            Q_hol i (g_far q) = (g_far q - g_far p) ^ N₂ * K.Γ (g_far q) i)) := by
      intro p
      by_cases hp : p ∈ W
      · obtain ⟨r₁, N₁, P_hol, hr₁, _, hP_holo, hP_reg, hP_punc⟩ :=
          h_pole_clear_1d (g_near p) (hgn_maps p hp)
        obtain ⟨r₂, N₂, Q_hol, hr₂, _, hQ_holo, hQ_reg, hQ_punc⟩ :=
          h_pole_clear_1d (g_far p) (hgf_maps p hp)
        have hgn_cont : ContinuousAt g_near p :=
          hgn_holo.continuousOn.continuousAt (hWo.mem_nhds hp)
        have hgf_cont : ContinuousAt g_far p :=
          hgf_holo.continuousOn.continuousAt (hWo.mem_nhds hp)
        have h_nhds : (W ∩ g_near ⁻¹' Metric.ball (g_near p) r₁ ∩
            g_far ⁻¹' Metric.ball (g_far p) r₂) ∈ nhds p :=
          Filter.inter_mem
            (Filter.inter_mem (hWo.mem_nhds hp) (hgn_cont.preimage_mem_nhds (Metric.ball_mem_nhds _ hr₁)))
            (hgf_cont.preimage_mem_nhds (Metric.ball_mem_nhds _ hr₂))
        obtain ⟨rad, hrad, hball⟩ := Metric.mem_nhds_iff.mp h_nhds
        have hballW : Metric.ball p rad ⊆ W := fun q hq => ((hball hq).1).1
        have hmap₁ : Set.MapsTo g_near (Metric.ball p rad) (Metric.ball (g_near p) r₁) :=
          fun q hq => ((hball hq).1).2
        have hmap₂ : Set.MapsTo g_far (Metric.ball p rad) (Metric.ball (g_far p) r₂) :=
          fun q hq => (hball hq).2
        refine ⟨rad, N₁, N₂, P_hol, Q_hol, fun _ => ⟨hrad, hballW,
          fun i => (hP_holo i).comp (hgn_holo.mono hballW) hmap₁,
          fun i => (hQ_holo i).comp (hgf_holo.mono hballW) hmap₂,
          fun hfn => ⟨(hP_reg hfn).1, fun i q hq => (hP_reg hfn).2 i (g_near q) (hmap₁ hq)⟩,
          fun hff => ⟨(hQ_reg hff).1, fun i q hq => (hQ_reg hff).2 i (g_far q) (hmap₂ hq)⟩,
          fun i q hq hne => hP_punc i (g_near q) (hmap₁ hq) hne,
          fun i q hq hne => hQ_punc i (g_far q) (hmap₂ hq) hne⟩⟩
      · exact ⟨1, 0, 0, fun _ _ => 0, fun _ _ => 0, fun h => absurd h hp⟩
    choose rad N₁ N₂ P_hol Q_hol h_chart using h_local_chart
    let E_fn : (ℂ × ℂ) → (ℂ × ℂ → ℂ) :=
      fun p q => (g_near q - g_near p) ^ (N₁ p) * (g_far q - g_far p) ^ (N₂ p)
    let P_tilde : (ℂ × ℂ) → (ℂ × ℂ) → (Fin 2 → ℂ) :=
      fun p q i => (g_far q - g_far p) ^ (N₂ p) * P_hol p i (g_near q)
    let Q_tilde : (ℂ × ℂ) → (ℂ × ℂ) → (Fin 2 → ℂ) :=
      fun p q i => (g_near q - g_near p) ^ (N₁ p) * Q_hol p i (g_far q)
    let N_chart : Fin 2 → (ℂ × ℂ) → (ℂ × ℂ → ℂ) :=
      fun i p q => E_fn p q * reflectVtilde (P_tilde p q) (Q_tilde p q) (K.ϕ (g_near q)) i
    let D_chart : (ℂ × ℂ) → (ℂ × ℂ → ℂ) :=
      fun p q => reflectDen (P_tilde p q) (Q_tilde p q) (K.ϕ (g_near q))

    have hE_holo : ∀ p, DifferentiableOn ℂ (E_fn p) W := by
      intro p
      exact ((hgn_holo.sub (differentiableOn_const _)).pow (N₁ p)).mul
        ((hgf_holo.sub (differentiableOn_const _)).pow (N₂ p))
    have hN_holo : ∀ i : Fin 2, ∀ p ∈ W, DifferentiableOn ℂ (N_chart i p) (Metric.ball p (rad p)) := by
      refine Fin.forall_fin_two.mpr ⟨?_, ?_⟩
      · intro p hp
        obtain ⟨_, hballW, hPh, hQh, _, _, _, _⟩ := h_chart p hp
        have hPt : ∀ j : Fin 2, DifferentiableOn ℂ (fun q => P_tilde p q j) (Metric.ball p (rad p)) :=
          fun j => (((hgf_holo.mono hballW).sub (differentiableOn_const _)).pow (N₂ p)).mul (hPh j)
        have hQt : ∀ j : Fin 2, DifferentiableOn ℂ (fun q => Q_tilde p q j) (Metric.ball p (rad p)) :=
          fun j => (((hgn_holo.mono hballW).sub (differentiableOn_const _)).pow (N₁ p)).mul (hQh j)
        have hψ_ball := hψ_holo.mono hballW
        have hcos := hψ_ball.ccos
        have hsin := hψ_ball.csin
        have hW₀ := (hPt 1).sub (hQt 1)
        have hW₁ := (hQt 0).sub (hPt 0)
        have hdot := (hW₀.mul hcos).add (hW₁.mul hsin)
        exact ((hE_holo p).mono hballW).mul
          ((((differentiableOn_const (2 : ℂ)).mul hdot).mul hcos).sub hW₀)
      · intro p hp
        obtain ⟨_, hballW, hPh, hQh, _, _, _, _⟩ := h_chart p hp
        have hPt : ∀ j : Fin 2, DifferentiableOn ℂ (fun q => P_tilde p q j) (Metric.ball p (rad p)) :=
          fun j => (((hgf_holo.mono hballW).sub (differentiableOn_const _)).pow (N₂ p)).mul (hPh j)
        have hQt : ∀ j : Fin 2, DifferentiableOn ℂ (fun q => Q_tilde p q j) (Metric.ball p (rad p)) :=
          fun j => (((hgn_holo.mono hballW).sub (differentiableOn_const _)).pow (N₁ p)).mul (hQh j)
        have hψ_ball := hψ_holo.mono hballW
        have hcos := hψ_ball.ccos
        have hsin := hψ_ball.csin
        have hW₀ := (hPt 1).sub (hQt 1)
        have hW₁ := (hQt 0).sub (hPt 0)
        have hdot := (hW₀.mul hcos).add (hW₁.mul hsin)
        exact ((hE_holo p).mono hballW).mul
          ((((differentiableOn_const (2 : ℂ)).mul hdot).mul hsin).sub hW₁)
    have hD_holo : ∀ p ∈ W, DifferentiableOn ℂ (D_chart p) (Metric.ball p (rad p)) := by
      intro p hp
      obtain ⟨_, hballW, hPh, hQh, _, _, _, _⟩ := h_chart p hp
      have hPt : ∀ j : Fin 2, DifferentiableOn ℂ (fun q => P_tilde p q j) (Metric.ball p (rad p)) :=
        fun j => (((hgf_holo.mono hballW).sub (differentiableOn_const _)).pow (N₂ p)).mul (hPh j)
      have hQt : ∀ j : Fin 2, DifferentiableOn ℂ (fun q => Q_tilde p q j) (Metric.ball p (rad p)) :=
        fun j => (((hgn_holo.mono hballW).sub (differentiableOn_const _)).pow (N₁ p)).mul (hQh j)
      have hψ_ball := hψ_holo.mono hballW
      have hcos := hψ_ball.ccos
      have hsin := hψ_ball.csin
      have hW₀ := (hPt 1).sub (hQt 1)
      have hW₁ := (hQt 0).sub (hPt 0)
      have hdot := (hW₀.mul hcos).add (hW₁.mul hsin)
      have hV₀ := (((differentiableOn_const (2 : ℂ)).mul hdot).mul hcos).sub hW₀
      have hV₁ := (((differentiableOn_const (2 : ℂ)).mul hdot).mul hsin).sub hW₁
      exact ((hPt 0).mul hV₀).add ((hPt 1).mul hV₁)

    have h_punc_eq : ∀ p ∈ W, ∀ q ∈ Metric.ball p (rad p),
        g_near q ≠ g_near p → g_far q ≠ g_far p →
        D_chart p q = (E_fn p q) ^ 2 *
          reflectDen (K.Γ (g_near q)) (K.Γ (g_far q)) (K.ϕ (g_near q)) ∧
        ∀ i : Fin 2, N_chart i p q = (E_fn p q) ^ 2 *
          reflectVtilde (K.Γ (g_near q)) (K.Γ (g_far q)) (K.ϕ (g_near q)) i := by
      intro p hp q hq hne₁ hne₂
      obtain ⟨_, _, _, _, _, _, hPp, hQp⟩ := h_chart p hp
      have hPt_eq : P_tilde p q = fun j => E_fn p q * K.Γ (g_near q) j := by
        ext j
        dsimp only [P_tilde, E_fn]
        rw [hPp j q hq hne₁]
        ring
      have hQt_eq : Q_tilde p q = fun j => E_fn p q * K.Γ (g_far q) j := by
        ext j
        dsimp only [Q_tilde, E_fn]
        rw [hQp j q hq hne₂]
        ring
      refine ⟨?_, fun i => ?_⟩
      · dsimp only [D_chart]
        rw [hPt_eq, hQt_eq, h_Den_homog]
      · dsimp only [N_chart]
        rw [hPt_eq, hQt_eq, h_Vtilde_homog]
        ring

    have h_reg_eq : ∀ p ∈ W, K.f (g_near p) ≠ 0 → K.f (g_far p) ≠ 0 →
        ∀ q ∈ Metric.ball p (rad p),
          D_chart p q = reflectDen (K.Γ (g_near q)) (K.Γ (g_far q)) (K.ϕ (g_near q)) ∧
          ∀ i : Fin 2, N_chart i p q =
            reflectVtilde (K.Γ (g_near q)) (K.Γ (g_far q)) (K.ϕ (g_near q)) i := by
      intro p hp hfn hff q hq
      obtain ⟨_, _, _, _, hPr, hQr, _, _⟩ := h_chart p hp
      obtain ⟨hN₁0, hPeq⟩ := hPr hfn
      obtain ⟨hN₂0, hQeq⟩ := hQr hff
      have hE1 : E_fn p q = 1 := by simp [E_fn, hN₁0, hN₂0]
      have hPt_eq : P_tilde p q = K.Γ (g_near q) := by
        ext j; simp [P_tilde, hN₂0, hPeq j q hq]
      have hQt_eq : Q_tilde p q = K.Γ (g_far q) := by
        ext j; simp [Q_tilde, hN₁0, hQeq j q hq]
      refine ⟨by dsimp only [D_chart]; rw [hPt_eq, hQt_eq],
        fun i => by dsimp only [N_chart]; rw [hE1, one_mul, hPt_eq, hQt_eq]⟩

    have h_gn_nonconst : ∀ {V : Set (ℂ × ℂ)}, IsOpen V → V.Nonempty → V ⊆ W →
        ∀ s : ℂ, ∃ q ∈ V, g_near q ≠ s := by
      intro V hVo hVn hVW s
      by_contra h_all
      have h_eq : ∀ q ∈ V, g_near q = s := fun q hq => by
        by_contra hne; exact h_all ⟨q, hq, hne⟩
      obtain ⟨q₁, hq₁W, q₂, hq₂W, hne⟩ := hgn_nc
      have h_zero : ∀ z ∈ W, g_near z - s = 0 :=
        h_id2D hWo hWp hVo hVn hVW
          (hgn_holo.sub (differentiableOn_const s))
          (fun z hz => sub_eq_zero.mpr (h_eq z hz))
      exact hne ((sub_eq_zero.mp (h_zero q₁ hq₁W)).trans (sub_eq_zero.mp (h_zero q₂ hq₂W)).symm)

    have h_gf_nonconst : ∀ {V : Set (ℂ × ℂ)}, IsOpen V → V.Nonempty → V ⊆ W →
        ∀ s : ℂ, ∃ q ∈ V, g_far q ≠ s := by
      intro V hVo hVn hVW s
      by_contra h_all
      have h_eq : ∀ q ∈ V, g_far q = s := fun q hq => by
        by_contra hne; exact h_all ⟨q, hq, hne⟩
      obtain ⟨q₁, hq₁W, q₂, hq₂W, hne⟩ := hgf_nc
      have h_zero : ∀ z ∈ W, g_far z - s = 0 :=
        h_id2D hWo hWp hVo hVn hVW
          (hgf_holo.sub (differentiableOn_const s))
          (fun z hz => sub_eq_zero.mpr (h_eq z hz))
      exact hne ((sub_eq_zero.mp (h_zero q₁ hq₁W)).trans (sub_eq_zero.mp (h_zero q₂ hq₂W)).symm)

    have h_punc_open_ne : ∀ p₁ ∈ W, ∀ p₂ ∈ W, ∀ {V : Set (ℂ × ℂ)},
        IsOpen V → V.Nonempty → V ⊆ W →
        ∃ V_st : Set (ℂ × ℂ), IsOpen V_st ∧ V_st.Nonempty ∧ V_st ⊆ V ∧
          ∀ z ∈ V_st, g_near z ≠ g_near p₁ ∧ g_far z ≠ g_far p₁ ∧
            g_near z ≠ g_near p₂ ∧ g_far z ≠ g_far p₂ := by
      intro p₁ _ p₂ _ V hVo hVn hVW
      let V₁ : Set (ℂ × ℂ) := V ∩ g_near ⁻¹' {g_near p₁}ᶜ
      have hV₁o : IsOpen V₁ :=
        (hgn_holo.continuousOn.mono hVW).isOpen_inter_preimage hVo isOpen_compl_singleton
      obtain ⟨z₁, hz₁V, hz₁⟩ := h_gn_nonconst hVo hVn hVW (g_near p₁)
      let V₂ : Set (ℂ × ℂ) := V₁ ∩ g_far ⁻¹' {g_far p₁}ᶜ
      have hV₂o : IsOpen V₂ :=
        (hgf_holo.continuousOn.mono (fun _ hz => hVW hz.1)).isOpen_inter_preimage hV₁o isOpen_compl_singleton
      obtain ⟨z₂, hz₂V₁, hz₂⟩ := h_gf_nonconst hV₁o ⟨z₁, hz₁V, hz₁⟩ (fun _ hz => hVW hz.1) (g_far p₁)
      let V₃ : Set (ℂ × ℂ) := V₂ ∩ g_near ⁻¹' {g_near p₂}ᶜ
      have hV₃o : IsOpen V₃ :=
        (hgn_holo.continuousOn.mono (fun _ hz => hVW hz.1.1)).isOpen_inter_preimage hV₂o isOpen_compl_singleton
      obtain ⟨z₃, hz₃V₂, hz₃⟩ := h_gn_nonconst hV₂o ⟨z₂, hz₂V₁, hz₂⟩ (fun _ hz => hVW hz.1.1) (g_near p₂)
      let V₄ : Set (ℂ × ℂ) := V₃ ∩ g_far ⁻¹' {g_far p₂}ᶜ
      have hV₄o : IsOpen V₄ :=
        (hgf_holo.continuousOn.mono (fun _ hz => hVW hz.1.1.1)).isOpen_inter_preimage hV₃o isOpen_compl_singleton
      obtain ⟨z₄, hz₄V₃, hz₄⟩ := h_gf_nonconst hV₃o ⟨z₃, hz₃V₂, hz₃⟩ (fun _ hz => hVW hz.1.1.1) (g_far p₂)
      exact ⟨V₄, hV₄o, ⟨z₄, hz₄V₃, hz₄⟩, fun _ hz => hz.1.1.1.1,
        fun z hz => ⟨hz.1.1.1.2, hz.1.1.2, hz.1.2, hz.2⟩⟩

    have hD_compat : ∀ p₁ ∈ W, ∀ p₂ ∈ W,
        ∀ q ∈ Metric.ball p₁ (rad p₁) ∩ Metric.ball p₂ (rad p₂),
          D_chart p₁ q * (E_fn p₂ q) ^ 2 = D_chart p₂ q * (E_fn p₁ q) ^ 2 := by
      intro p₁ hp₁ p₂ hp₂ q hq
      let B₁₂ := Metric.ball p₁ (rad p₁) ∩ Metric.ball p₂ (rad p₂)
      have hB_open : IsOpen B₁₂ := Metric.isOpen_ball.inter Metric.isOpen_ball
      have hB_conv : Convex ℝ B₁₂ := (convex_ball p₁ (rad p₁)).inter (convex_ball p₂ (rad p₂))
      have hB_subW : B₁₂ ⊆ W := fun z hz => (h_chart p₁ hp₁).2.1 hz.1
      obtain ⟨V_st, hV_sto, hV_stne, hV_stsub, hV_stpunc⟩ :=
        h_punc_open_ne p₁ hp₁ p₂ hp₂ hB_open ⟨q, hq⟩ hB_subW
      have h_holo : DifferentiableOn ℂ
          (fun z => D_chart p₁ z * (E_fn p₂ z) ^ 2 - D_chart p₂ z * (E_fn p₁ z) ^ 2) B₁₂ :=
        (((hD_holo p₁ hp₁).mono (fun _ hz => hz.1)).mul (((hE_holo p₂).pow 2).mono hB_subW)).sub
          (((hD_holo p₂ hp₂).mono (fun _ hz => hz.2)).mul (((hE_holo p₁).pow 2).mono hB_subW))
      have h_van : ∀ z ∈ V_st, D_chart p₁ z * (E_fn p₂ z) ^ 2 - D_chart p₂ z * (E_fn p₁ z) ^ 2 = 0 := by
        intro z hz
        obtain ⟨hn₁, hf₁, hn₂, hf₂⟩ := hV_stpunc z hz
        have hzB := hV_stsub hz
        rw [(h_punc_eq p₁ hp₁ z hzB.1 hn₁ hf₁).1, (h_punc_eq p₂ hp₂ z hzB.2 hn₂ hf₂).1]
        ring
      exact sub_eq_zero.mp (h_id2D hB_open hB_conv.isPreconnected
        hV_sto hV_stne hV_stsub h_holo h_van q hq)

    have hND_compat : ∀ i : Fin 2, ∀ p₁ ∈ W, ∀ p₂ ∈ W,
        ∀ q ∈ Metric.ball p₁ (rad p₁) ∩ Metric.ball p₂ (rad p₂),
          N_chart i p₁ q * D_chart p₂ q = N_chart i p₂ q * D_chart p₁ q := by
      intro i p₁ hp₁ p₂ hp₂ q hq
      let B₁₂ := Metric.ball p₁ (rad p₁) ∩ Metric.ball p₂ (rad p₂)
      have hB_open : IsOpen B₁₂ := Metric.isOpen_ball.inter Metric.isOpen_ball
      have hB_conv : Convex ℝ B₁₂ := (convex_ball p₁ (rad p₁)).inter (convex_ball p₂ (rad p₂))
      have hB_subW : B₁₂ ⊆ W := fun z hz => (h_chart p₁ hp₁).2.1 hz.1
      obtain ⟨V_st, hV_sto, hV_stne, hV_stsub, hV_stpunc⟩ :=
        h_punc_open_ne p₁ hp₁ p₂ hp₂ hB_open ⟨q, hq⟩ hB_subW
      have h_holo : DifferentiableOn ℂ
          (fun z => N_chart i p₁ z * D_chart p₂ z - N_chart i p₂ z * D_chart p₁ z) B₁₂ :=
        (((hN_holo i p₁ hp₁).mono (fun _ hz => hz.1)).mul ((hD_holo p₂ hp₂).mono (fun _ hz => hz.2))).sub
          (((hN_holo i p₂ hp₂).mono (fun _ hz => hz.2)).mul ((hD_holo p₁ hp₁).mono (fun _ hz => hz.1)))
      have h_van : ∀ z ∈ V_st, N_chart i p₁ z * D_chart p₂ z - N_chart i p₂ z * D_chart p₁ z = 0 := by
        intro z hz
        obtain ⟨hn₁, hf₁, hn₂, hf₂⟩ := hV_stpunc z hz
        have hzB := hV_stsub hz
        obtain ⟨hD₁, hN₁eq⟩ := h_punc_eq p₁ hp₁ z hzB.1 hn₁ hf₁
        obtain ⟨hD₂, hN₂eq⟩ := h_punc_eq p₂ hp₂ z hzB.2 hn₂ hf₂
        rw [hN₁eq i, hN₂eq i, hD₁, hD₂]
        ring
      exact sub_eq_zero.mp (h_id2D hB_open hB_conv.isPreconnected
        hV_sto hV_stne hV_stsub h_holo h_van q hq)

    let S_nz : Set (ℂ × ℂ) := { p ∈ W | ∃ q ∈ Metric.ball p (rad p), D_chart p q ≠ 0 }
    have h_nz_transfer : ∀ p₁ ∈ W, ∀ p₂ ∈ W,
        (Metric.ball p₁ (rad p₁) ∩ Metric.ball p₂ (rad p₂)).Nonempty →
        p₁ ∈ S_nz → p₂ ∈ S_nz := by
      intro p₁ hp₁ p₂ hp₂ hB_ne ⟨_, hD₁_nz⟩
      refine ⟨hp₂, ?_⟩
      let B₁₂ := Metric.ball p₁ (rad p₁) ∩ Metric.ball p₂ (rad p₂)
      have hB_open : IsOpen B₁₂ := Metric.isOpen_ball.inter Metric.isOpen_ball
      have hB_sub₁ : B₁₂ ⊆ Metric.ball p₁ (rad p₁) := fun _ hz => hz.1
      have hB_subW : B₁₂ ⊆ W := fun z hz => (h_chart p₁ hp₁).2.1 hz.1
      let U_d : Set (ℂ × ℂ) := B₁₂ ∩ (D_chart p₁) ⁻¹' {(0 : ℂ)}ᶜ
      have hUd_open : IsOpen U_d :=
        ((hD_holo p₁ hp₁).continuousOn.mono hB_sub₁).isOpen_inter_preimage hB_open isOpen_compl_singleton
      obtain ⟨z₁, hz₁B, hz₁nz⟩ := h_exists_nz Metric.isOpen_ball
        (convex_ball p₁ (rad p₁)).isPreconnected (hD_holo p₁ hp₁) hD₁_nz hB_open hB_ne hB_sub₁
      obtain ⟨V_st, _, ⟨z₂, hz₂V⟩, hV_stsub, hV_stpunc⟩ :=
        h_punc_open_ne p₁ hp₁ p₂ hp₂ hUd_open ⟨z₁, hz₁B, hz₁nz⟩ (fun _ hz => hB_subW hz.1)
      have hz₂U : z₂ ∈ U_d := hV_stsub hz₂V
      obtain ⟨_, _, hn₂, hf₂⟩ := hV_stpunc z₂ hz₂V
      have hE₂_nz : (E_fn p₂ z₂) ^ 2 ≠ 0 :=
        pow_ne_zero 2 (mul_ne_zero (pow_ne_zero _ (sub_ne_zero.mpr hn₂))
          (pow_ne_zero _ (sub_ne_zero.mpr hf₂)))
      have hmul : D_chart p₂ z₂ * (E_fn p₁ z₂) ^ 2 ≠ 0 := by
        rw [← hD_compat p₁ hp₁ p₂ hp₂ z₂ hz₂U.1]
        exact mul_ne_zero hz₂U.2 hE₂_nz
      exact ⟨z₂, hz₂U.1.2, left_ne_zero_of_mul hmul⟩

    have hq₀W : q₀ ∈ W := hU₀_sub hq₀
    have hq₀_nz : q₀ ∈ S_nz := by
      have hrad_q₀ : 0 < rad q₀ := (h_chart q₀ hq₀W).1
      refine ⟨hq₀W, q₀, Metric.mem_ball_self hrad_q₀, ?_⟩
      rw [(h_reg_eq q₀ hq₀W (hU₀_reg q₀ hq₀).1 (hU₀_reg q₀ hq₀).2 q₀
        (Metric.mem_ball_self hrad_q₀)).1]
      exact hD_q₀

    have hS_open : IsOpen S_nz := by
      rw [Metric.isOpen_iff]
      intro p hpS
      refine ⟨rad p, (h_chart p hpS.1).1, fun q hq => ?_⟩
      have hqW : q ∈ W := (h_chart p hpS.1).2.1 hq
      exact h_nz_transfer p hpS.1 q hqW ⟨q, hq, Metric.mem_ball_self (h_chart q hqW).1⟩ hpS

    have hSc_open : IsOpen (W \ S_nz) := by
      rw [Metric.isOpen_iff]
      intro p ⟨hpW, hp_not⟩
      refine ⟨rad p, (h_chart p hpW).1, fun q hq => ?_⟩
      have hqW : q ∈ W := (h_chart p hpW).2.1 hq
      exact ⟨hqW, fun hqS =>
        hp_not (h_nz_transfer q hqW p hpW ⟨q, Metric.mem_ball_self (h_chart q hqW).1, hq⟩ hqS)⟩

    have hW_sub_S : W ⊆ S_nz := by
      have h_cov : W ⊆ S_nz ∪ (W \ S_nz) :=
        fun p hp => (Classical.em (p ∈ S_nz)).imp id (fun h => ⟨hp, h⟩)
      have h_disj : W ∩ (S_nz ∩ (W \ S_nz)) = ∅ := by
        ext p; simp only [Set.mem_inter_iff, Set.mem_sdiff, Set.mem_empty_iff_false, iff_false]
        rintro ⟨_, hpS, _, hnot⟩; exact hnot hpS
      rcases (isPreconnected_iff_subset_of_disjoint.mp hWp) S_nz (W \ S_nz) hS_open hSc_open
          h_cov h_disj with h1 | h2
      · exact h1
      · exact False.elim ((h2 hq₀W).2 hq₀_nz)

    let F : Fin 2 → MeroOn2D W := fun i => {
      rad := rad
      num := N_chart i
      den := D_chart
      rad_pos := fun p hp => (h_chart p hp).1
      ball_sub := fun p hp => (h_chart p hp).2.1
      num_holo := hN_holo i
      den_holo := hD_holo
      den_ne_zero := fun p hp => (hW_sub_S hp).2
      compat := hND_compat i
    }
    refine ⟨F, ?_⟩
    intro U_reg hUo hUW hUreg
    refine ⟨?_, ?_⟩
    · rintro ⟨p, hp⟩
      obtain ⟨rU, hrU, hballU⟩ := Metric.isOpen_iff.mp hUo p hp
      have hpW : p ∈ W := hUW hp
      let r := min rU (rad p)
      have hr : 0 < r := lt_min hrU (h_chart p hpW).1
      obtain ⟨q, hq_ball, hDq_nz⟩ := h_exists_nz Metric.isOpen_ball
        (convex_ball p (rad p)).isPreconnected (hD_holo p hpW) (hW_sub_S hpW).2
        Metric.isOpen_ball ⟨p, Metric.mem_ball_self hr⟩ (Metric.ball_subset_ball (min_le_right _ _))
      refine ⟨q, hballU (Metric.ball_subset_ball (min_le_left _ _) hq_ball), ?_⟩
      rwa [← (h_reg_eq p hpW (hUreg p hp).1 (hUreg p hp).2 q
        (Metric.ball_subset_ball (min_le_right _ _) hq_ball)).1]
    · intro p hp
      obtain ⟨rU, hrU, hballU⟩ := Metric.isOpen_iff.mp hUo p hp
      have hpW : p ∈ W := hUW hp
      let r := min rU (rad p)
      refine ⟨r, lt_min hrU (h_chart p hpW).1, min_le_right _ _, rfl,
        Set.Subset.trans (Metric.ball_subset_ball (min_le_left _ _)) hballU, fun q hq i => ?_⟩
      obtain ⟨hDeq, hNeq⟩ := h_reg_eq p hpW (hUreg p hp).1 (hUreg p hp).2 q
        (Metric.ball_subset_ball (min_le_right _ _) hq)
      exact ⟨hNeq i, hDeq⟩

  
  
  
  let shift_c : ℂ → ℂ × ℂ → ℂ × ℂ := fun c p => (p.1 + c * p.2, p.2)
  have hsh_diff : ∀ c : ℂ, Differentiable ℂ (shift_c c) :=
    fun c => (differentiable_fst.add (differentiable_snd.const_mul c)).prodMk differentiable_snd
  have hsh_cont : ∀ c : ℂ, Continuous (shift_c c) := fun c => (hsh_diff c).continuous
  have hsh_conv : ∀ {S : Set (ℂ × ℂ)} (c : ℂ), Convex ℝ S → Convex ℝ (shift_c c ⁻¹' S) := by
    intro S c hSc p hp q hq a b ha hb hab
    have heq : shift_c c (a • p + b • q) = a • shift_c c p + b • shift_c c q := by
      (ext <;> simp [shift_c, Complex.real_smul]); ring
    change shift_c c (a • p + b • q) ∈ S
    rw [heq]
    exact hSc hp hq ha hb hab

  have hCone_open : IsOpen (coneDomain H δ_star d x₀) := by
    have hf_dep : Continuous (fun p : ℂ × ℂ => H - p.1.im) :=
      continuous_const.sub (Complex.continuous_im.comp continuous_fst)
    exact (isOpen_lt continuous_const hf_dep).inter
      ((isOpen_lt hf_dep continuous_const).inter
        ((isOpen_lt (continuous_abs.comp ((Complex.continuous_re.comp continuous_fst).sub continuous_const))
          (continuous_const.mul hf_dep)).inter
          (isOpen_lt (continuous_norm.comp continuous_snd) continuous_const)))

  have hCone_conv : Convex ℝ (coneDomain H δ_star d x₀) := by
    intro p hp q hq a b ha hb hab
    rcases hp with ⟨hpd, hpδ, hpre, hp2⟩
    rcases hq with ⟨hqd, hqδ, hqre, hq2⟩
    have him : (a • p + b • q).1.im = a * p.1.im + b * q.1.im := by simp
    have hre : (a • p + b • q).1.re = a * p.1.re + b * q.1.re := by simp
    have hdepth : H - (a • p + b • q).1.im = a * (H - p.1.im) + b * (H - q.1.im) := by
      rw [him]; linear_combination H * hab.symm
    have habs : |(a • p + b • q).1.re - x₀| ≤ a * |p.1.re - x₀| + b * |q.1.re - x₀| := by
      have hlin : (a • p + b • q).1.re - x₀ = a * (p.1.re - x₀) + b * (q.1.re - x₀) := by
        rw [hre]; linear_combination -x₀ * hab.symm
      rw [hlin]
      calc |a * (p.1.re - x₀) + b * (q.1.re - x₀)|
          ≤ |a * (p.1.re - x₀)| + |b * (q.1.re - x₀)| := abs_add_le _ _
        _ = a * |p.1.re - x₀| + b * |q.1.re - x₀| := by
            rw [abs_mul, abs_mul, abs_of_nonneg ha, abs_of_nonneg hb]
    have hnorm2 : ‖(a • p + b • q).2‖ ≤ a * ‖p.2‖ + b * ‖q.2‖ := by
      calc ‖a • p.2 + b • q.2‖ ≤ ‖a • p.2‖ + ‖b • q.2‖ := norm_add_le _ _
        _ = a * ‖p.2‖ + b * ‖q.2‖ := by
            rw [norm_smul, norm_smul, Real.norm_of_nonneg ha, Real.norm_of_nonneg hb]
    have hc1 := h_conv_lt_left ha hb hab hpd hqd
    have hc2 := h_conv_lt_right ha hb hab hpδ hqδ
    have hc3 := h_conv_lt ha hb hab hpre hqre
    have hc4 := h_conv_lt_right ha hb hab hp2 hq2
    refine ⟨?_, ?_, ?_, ?_⟩
    · rw [hdepth]; exact hc1
    · rw [hdepth]; exact hc2
    · rw [hdepth]; linarith
    · linarith

  have hBack_eq : coneDomainBack H δ_star d x₀ =
      shift_c (-3 / 2 : ℂ) ⁻¹' coneDomain H δ_star d x₀ ∩
      shift_c (-1 / 2 : ℂ) ⁻¹' coneDomain H δ_star d x₀ := by
    ext p
    change ((p.1 - (3 / 2 : ℂ) * p.2, p.2) ∈ coneDomain H δ_star d x₀ ∧
        (p.1 - (1 / 2 : ℂ) * p.2, p.2) ∈ coneDomain H δ_star d x₀) ↔
      ((p.1 + (-3 / 2 : ℂ) * p.2, p.2) ∈ coneDomain H δ_star d x₀ ∧
        (p.1 + (-1 / 2 : ℂ) * p.2, p.2) ∈ coneDomain H δ_star d x₀)
    have h1 : p.1 - (3 / 2 : ℂ) * p.2 = p.1 + (-3 / 2 : ℂ) * p.2 := by ring
    have h2 : p.1 - (1 / 2 : ℂ) * p.2 = p.1 + (-1 / 2 : ℂ) * p.2 := by ring
    rw [h1, h2]
  have hFwd_eq : coneDomainFwd H δ_star d x₀ =
      shift_c (1 / 2 : ℂ) ⁻¹' coneDomain H δ_star d x₀ ∩
      shift_c (3 / 2 : ℂ) ⁻¹' coneDomain H δ_star d x₀ := rfl

  have hBack_open : IsOpen (coneDomainBack H δ_star d x₀) := by
    rw [hBack_eq]
    exact (hCone_open.preimage (hsh_cont _)).inter (hCone_open.preimage (hsh_cont _))
  have hBack_conv : Convex ℝ (coneDomainBack H δ_star d x₀) := by
    rw [hBack_eq]
    exact (hsh_conv _ hCone_conv).inter (hsh_conv _ hCone_conv)
  have hFwd_open : IsOpen (coneDomainFwd H δ_star d x₀) := by
    rw [hFwd_eq]
    exact (hCone_open.preimage (hsh_cont _)).inter (hCone_open.preimage (hsh_cont _))
  have hFwd_conv : Convex ℝ (coneDomainFwd H δ_star d x₀) := by
    rw [hFwd_eq]
    exact (hsh_conv _ hCone_conv).inter (hsh_conv _ hCone_conv)

  obtain ⟨η₂, p_reg, p_alt, r_reg,
      hη₂_pos, hη₂_d40, hη₂_s8, hη₂_r4,
      h_lsc_η₂, h_bshift_η₂,
      hs_eq_η₂,
      hp_reg_2, hp_alt_2, hp_reg_mem, hp_alt_mem,
      hst_ne, hLs_ne,
      hr_reg_pos, hB_reg_sub, hB_reg_f⟩ :
      ∃ (η₂ : ℝ) (p_reg p_alt : ℂ × ℂ) (r_reg : ℝ),
        0 < η₂ ∧ η₂ ≤ d / 40 ∧ η₂ ≤ L.s_star / 8 ∧ η₂ ≤ L.r_star / 4 ∧
        (∀ t : ℂ, ‖t‖ < η₂ → ENNReal.ofReal (H - d / 20) < M.h_X t) ∧
        (∀ t : ℂ, ‖t‖ < η₂ → ‖L.b_shift t‖ < min (d / 80) (L.s_star / 8)) ∧
        (∀ q ∈ coneDomain H δ_star d x₀, ‖q.2‖ < η₂ → s_tilde q = L.𝔰 q) ∧
        p_reg.2 = 0 ∧ p_alt.2 = 0 ∧
        p_reg ∈ coneDomainBack H δ_star d x₀ ∩ coneDomainFwd H δ_star d x₀ ∩ {p | ‖p.2‖ < η₂} ∧
        p_alt ∈ coneDomainBack H δ_star d x₀ ∩ coneDomainFwd H δ_star d x₀ ∩ {p | ‖p.2‖ < η₂} ∧
        s_tilde p_reg ≠ s_tilde p_alt ∧ L.𝔰 p_reg ≠ L.𝔰 p_alt ∧
        0 < r_reg ∧
        Metric.ball p_reg r_reg ⊆
          coneDomainBack H δ_star d x₀ ∩ coneDomainFwd H δ_star d x₀ ∩ {p | ‖p.2‖ < η₂} ∧
        (∀ q ∈ Metric.ball p_reg r_reg,
          K.f (L.𝔰 (shift_c (-3 / 2 : ℂ) q)) ≠ 0 ∧ K.f (L.𝔰 (shift_c (-1 / 2 : ℂ) q)) ≠ 0 ∧
          K.f (L.𝔰 (shift_c (1 / 2 : ℂ) q)) ≠ 0 ∧ K.f (L.𝔰 (shift_c (3 / 2 : ℂ) q)) ≠ 0) := by
    have h0_mem : (0 : ℂ) ∈ Metric.ball (0 : ℂ) M.r_base := Metric.mem_ball_self M.r_base_pos
    have h_lt_H : ENNReal.ofReal (H - d / 20) < M.h_X 0 := by
      rw [hH, ENNReal.ofReal_lt_ofReal_iff hH_pos]; linarith
    have hlsc0 :=
      (lowerSemicontinuousWithinAt_iff.mp (M.h_X_lsc 0 h0_mem)) (ENNReal.ofReal (H - d / 20)) h_lt_H
    rw [Metric.isOpen_ball.nhdsWithin_eq h0_mem, Metric.eventually_nhds_iff_ball] at hlsc0
    obtain ⟨r_lsc, hr_lsc, h_lsc_ball⟩ := hlsc0
    have hb_cont0 : ContinuousAt L.b_shift 0 :=
      L.b_shift_holo.continuousOn.continuousAt (Metric.isOpen_ball.mem_nhds h0_mem)
    let ε_b := min (d / 80) (L.s_star / 8)
    have hε_b : 0 < ε_b := lt_min (by linarith) (by linarith [L.s_star_pos])
    have hb_ev : ∀ᶠ t in nhds (0 : ℂ), L.b_shift t ∈ Metric.ball (0 : ℂ) ε_b := by
      have hball0 : Metric.ball (0 : ℂ) ε_b ∈ nhds (L.b_shift 0) := by
        rw [L.b_shift_zero]
        exact Metric.ball_mem_nhds 0 hε_b
      exact hb_cont0.preimage_mem_nhds hball0
    obtain ⟨r_b, hr_b, h_rb_ball⟩ := Metric.eventually_nhds_iff_ball.mp hb_ev
    let η₂ := min η (min r_lsc (min r_b (min (d / 40) (min (L.s_star / 8) (L.r_star / 4)))))
    have hη₂_pos : 0 < η₂ := lt_min hη (lt_min hr_lsc (lt_min hr_b
      (lt_min (by linarith) (lt_min (by linarith [L.s_star_pos]) (by linarith [L.r_star_pos])))))
    have hη₂_η : η₂ ≤ η := min_le_left _ _
    have hη₂_lsc : η₂ ≤ r_lsc := le_trans (min_le_right _ _) (min_le_left _ _)
    have hη₂_rb : η₂ ≤ r_b := le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_left _ _))
    have hη₂_d40 : η₂ ≤ d / 40 :=
      le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_left _ _)))
    have hη₂_s8 : η₂ ≤ L.s_star / 8 :=
      le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (le_trans (min_le_right _ _)
        (le_trans (min_le_right _ _) (min_le_left _ _))))
    have hη₂_r4 : η₂ ≤ L.r_star / 4 :=
      le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (le_trans (min_le_right _ _)
        (le_trans (min_le_right _ _) (min_le_right _ _))))
    have h_lsc_η₂ : ∀ t : ℂ, ‖t‖ < η₂ → ENNReal.ofReal (H - d / 20) < M.h_X t := by
      intro t ht
      exact h_lsc_ball t (by rw [Metric.mem_ball, dist_zero_right]; linarith)
    have h_bshift_η₂ : ∀ t : ℂ, ‖t‖ < η₂ → ‖L.b_shift t‖ < min (d / 80) (L.s_star / 8) := by
      intro t ht
      have hm := h_rb_ball t (by rw [Metric.mem_ball, dist_zero_right]; linarith)
      rwa [Metric.mem_ball, dist_zero_right] at hm

    let T_sl := { q : ℂ × ℂ | -L.s_star / 2 < q.1.im ∧ q.1.im < H - d / 10 ∧ ‖q.2‖ < η₂ }
    have hT_sl_sub : T_sl ⊆ L.T_norm := by
      intro q ⟨hq_lo, hq_hi, hq_t⟩
      rw [L.T_norm_iff]
      have hqt_r : ‖q.2‖ < L.r_star := by linarith [L.r_star_pos]
      have hqt_base : ‖q.2‖ < M.r_base := lt_trans hqt_r hr_lt_base
      have hb_bd := h_bshift_η₂ q.2 hq_t
      have hb_im : |(L.b_shift q.2).im| ≤ ‖L.b_shift q.2‖ := Complex.abs_im_le_norm _
      have hb_d : ‖L.b_shift q.2‖ < d / 80 := lt_of_lt_of_le hb_bd (min_le_left _ _)
      have hb_s : ‖L.b_shift q.2‖ < L.s_star / 8 := lt_of_lt_of_le hb_bd (min_le_right _ _)
      refine ⟨hqt_r, hqt_base, ?_, ?_⟩
      · have h_neg_im : -(q.1 - L.b_shift q.2).im < M.s_base := by
          have := (abs_le.mp hb_im).2
          simp only [Complex.sub_im]
          linarith
        exact lt_of_lt_of_le ((ENNReal.ofReal_lt_ofReal_iff M.s_base_pos).mpr h_neg_im)
          (M.h_X_ge (starRingEnd ℂ q.2) (by rw [Metric.mem_ball, dist_zero_right, RCLike.norm_conj]; exact hqt_base))
      · have h_pos_im : (q.1 - L.b_shift q.2).im ≤ H - d / 20 := by
          have := (abs_le.mp hb_im).1
          simp only [Complex.sub_im]
          linarith
        exact lt_of_le_of_lt (ENNReal.ofReal_le_ofReal h_pos_im) (h_lsc_η₂ q.2 hq_t)

    let U₁ := coneDomain H δ_star d x₀ ∩ { q : ℂ × ℂ | ‖q.2‖ < η₂ }
    have hU₁_open : IsOpen U₁ :=
      hCone_open.inter (isOpen_lt (continuous_norm.comp continuous_snd) continuous_const)
    have hU₁_conv : Convex ℝ U₁ := by
      refine hCone_conv.inter (fun p hp q hq a b ha hb hab => ?_)
      have hnorm : ‖(a • p + b • q).2‖ ≤ a * ‖p.2‖ + b * ‖q.2‖ := by
        calc ‖a • p.2 + b • q.2‖ ≤ ‖a • p.2‖ + ‖b • q.2‖ := norm_add_le _ _
          _ = a * ‖p.2‖ + b * ‖q.2‖ := by
              rw [norm_smul, norm_smul, Real.norm_of_nonneg ha, Real.norm_of_nonneg hb]
      have hc := h_conv_lt_right ha hb hab hp hq
      exact lt_of_le_of_lt hnorm hc
    have hU₁_sub_T : U₁ ⊆ L.T_norm := by
      intro q ⟨⟨hqd, hqδ, _, _⟩, hqt⟩
      exact hT_sl_sub ⟨by linarith [L.s_star_pos], by linarith, hqt⟩

    have hs_eq_η₂ : ∀ q ∈ coneDomain H δ_star d x₀, ‖q.2‖ < η₂ → s_tilde q = L.𝔰 q := by
      intro q hq_cone hq_t
      let V₁ := U₁ ∩ { p : ℂ × ℂ | δ_star / 2 < H - p.1.im }
      have hV₁_open : IsOpen V₁ :=
        hU₁_open.inter (isOpen_lt continuous_const (continuous_const.sub (Complex.continuous_im.comp continuous_fst)))
      let p_deep : ℂ × ℂ := ((x₀ : ℂ) + ((H - 3 * δ_star / 4 : ℝ) : ℂ) * Complex.I, 0)
      have hp_deep : p_deep ∈ V₁ := by
        have hp_im : p_deep.1.im = H - 3 * δ_star / 4 := by simp [p_deep]
        have hp_re : p_deep.1.re = x₀ := by simp [p_deep]
        refine ⟨⟨⟨?_, ?_, ?_, ?_⟩, ?_⟩, ?_⟩
        · rw [hp_im]; linarith
        · rw [hp_im]; linarith
        · rw [hp_re, hp_im, sub_self, abs_zero]; linarith
        · simp [p_deep, hd0]
        · simp [p_deep, hη₂_pos]
        · change δ_star / 2 < H - p_deep.1.im; rw [hp_im]; linarith
      have h_diff_holo : DifferentiableOn ℂ (fun p => s_tilde p - L.𝔰 p) U₁ :=
        (hs_holo.mono Set.inter_subset_left).sub (L.𝔰_holo.mono hU₁_sub_T)
      have h_van : ∀ p ∈ V₁, s_tilde p - L.𝔰 p = 0 := by
        intro p ⟨⟨hp_c, hp_η⟩, hp_d⟩
        exact sub_eq_zero.mpr (hs_eq p hp_c hp_d (lt_of_lt_of_le hp_η hη₂_η))
      exact sub_eq_zero.mp (h_id2D hU₁_open hU₁_conv.isPreconnected
        hV₁_open ⟨p_deep, hp_deep⟩ Set.inter_subset_left h_diff_holo h_van q ⟨hq_cone, hq_t⟩)

    let s_mid : ℂ := (x₀ : ℂ) + ((H - 3 * d : ℝ) : ℂ) * Complex.I
    have hs_mid_H : s_mid ∈ horizStrip H := by
      change |s_mid.im| < H
      have him : s_mid.im = H - 3 * d := by simp [s_mid]
      rw [him, abs_of_pos (by linarith)]
      linarith
    have hStrip_conv : Convex ℝ (horizStrip H) := by
      intro z₁ hz₁ z₂ hz₂ a b ha hb hab
      change |(a • z₁ + b • z₂).im| < H
      have him : (a • z₁ + b • z₂).im = a * z₁.im + b * z₂.im := by simp
      rw [him]
      have habs : |a * z₁.im + b * z₂.im| ≤ a * |z₁.im| + b * |z₂.im| := by
        calc |a * z₁.im + b * z₂.im| ≤ |a * z₁.im| + |b * z₂.im| := abs_add_le _ _
          _ = a * |z₁.im| + b * |z₂.im| := by
              rw [abs_mul, abs_mul, abs_of_nonneg ha, abs_of_nonneg hb]
      exact lt_of_le_of_lt habs (h_conv_lt_right ha hb hab hz₁ hz₂)
    have hf_ana : AnalyticOnNhd ℂ K.f (horizStrip H) :=
      (hStrip ▸ K.f_holo).analyticOnNhd hStrip_open
    have hf_not_ev_zero : ¬ (∀ᶠ z in nhds s_mid, K.f z = 0) := by
      intro h_ev
      have h0_mem_H : (0 : ℂ) ∈ horizStrip H := by
        change |(0 : ℂ).im| < H; simp [hH_pos]
      have h0_eq : K.f 0 = 0 :=
        hf_ana.eqOn_zero_of_preconnected_of_eventuallyEq_zero
          hStrip_conv.isPreconnected hs_mid_H h_ev h0_mem_H
      have h0_pos : 0 < (K.f ((0 : ℝ) : ℂ)).re := (K.f_real_pos 0).1
      rw [Complex.ofReal_zero, h0_eq, Complex.zero_re] at h0_pos
      exact lt_irrefl 0 h0_pos
    have hf_punc : ∀ᶠ z in nhdsWithin s_mid {s_mid}ᶜ, K.f z ≠ 0 :=
      ((hf_ana s_mid hs_mid_H).eventually_eq_zero_or_eventually_ne_zero).resolve_left hf_not_ev_zero
    obtain ⟨ε_f, hε_f, hball_f⟩ := Metric.mem_nhdsWithin_iff.mp hf_punc
    let δ_x : ℝ := if K.f s_mid ≠ 0 then 0 else min (d / 2) (ε_f / 2)
    have hδ_x_nonneg : 0 ≤ δ_x := by
      dsimp only [δ_x]; split_ifs
      · exact le_rfl
      · exact le_of_lt (lt_min (by linarith) (by linarith))
    have hδ_x_le : δ_x ≤ d / 2 := by
      dsimp only [δ_x]; split_ifs
      · linarith
      · exact min_le_left _ _
    let s_reg : ℂ := s_mid + (δ_x : ℂ)
    have hs_reg_f : K.f s_reg ≠ 0 := by
      dsimp only [s_reg, δ_x]
      split_ifs with hfm
      · simpa
      · have hpos : 0 < min (d / 2) (ε_f / 2) := lt_min (by linarith) (by linarith)
        have h_dist : s_mid + ((min (d / 2) (ε_f / 2) : ℝ) : ℂ) ∈ Metric.ball s_mid ε_f := by
          rw [Metric.mem_ball, dist_self_add_left, Complex.norm_real, Real.norm_of_nonneg (le_of_lt hpos)]
          linarith [min_le_right (d / 2) (ε_f / 2)]
        have h_ne : s_mid + ((min (d / 2) (ε_f / 2) : ℝ) : ℂ) ≠ s_mid := by
          intro heq
          have hc0 : ((min (d / 2) (ε_f / 2) : ℝ) : ℂ) = 0 := by linear_combination heq
          have := congr_arg Complex.re hc0
          simp only [Complex.ofReal_re, Complex.zero_re] at this
          linarith
        exact hball_f ⟨h_dist, h_ne⟩
    have hs_reg_H : s_reg ∈ horizStrip H := by
      change |s_reg.im| < H
      have him : s_reg.im = H - 3 * d := by simp [s_reg, s_mid]
      rw [him, abs_of_pos (by linarith)]; linarith
    have hs_alt_H : s_reg + (d : ℂ) ∈ horizStrip H := by
      change |(s_reg + (d : ℂ)).im| < H
      have him : (s_reg + (d : ℂ)).im = H - 3 * d := by simp [s_reg, s_mid]
      rw [him, abs_of_pos (by linarith)]; linarith

    let p_reg : ℂ × ℂ := (s_reg, 0)
    let p_alt : ℂ × ℂ := (s_reg + (d : ℂ), 0)
    have hp_reg_cone : p_reg ∈ coneDomain H δ_star d x₀ := by
      have him : p_reg.1.im = H - 3 * d := by simp [p_reg, s_reg, s_mid]
      have hre : p_reg.1.re = x₀ + δ_x := by simp [p_reg, s_reg, s_mid]
      refine ⟨by rw [him]; linarith, by rw [him]; linarith, ?_, by simp [p_reg, hd0]⟩
      rw [hre, him, add_sub_cancel_left, abs_of_nonneg hδ_x_nonneg]
      linarith
    have hp_alt_cone : p_alt ∈ coneDomain H δ_star d x₀ := by
      have him : p_alt.1.im = H - 3 * d := by simp [p_alt, s_reg, s_mid]
      have hre : p_alt.1.re = x₀ + (δ_x + d) := by simp [p_alt, s_reg, s_mid, add_assoc]
      refine ⟨by rw [him]; linarith, by rw [him]; linarith, ?_, by simp [p_alt, hd0]⟩
      rw [hre, him, add_sub_cancel_left, abs_of_nonneg (by linarith)]
      linarith
    let O_reg := coneDomainBack H δ_star d x₀ ∩ coneDomainFwd H δ_star d x₀ ∩ {p | ‖p.2‖ < η₂}
    have hp_reg_mem : p_reg ∈ O_reg := by
      refine ⟨⟨⟨by simpa [p_reg], by simpa [p_reg]⟩, ⟨by simpa [p_reg], by simpa [p_reg]⟩⟩,
        by simp [p_reg, hη₂_pos]⟩
    have hp_alt_mem : p_alt ∈ O_reg := by
      refine ⟨⟨⟨by simpa [p_alt], by simpa [p_alt]⟩, ⟨by simpa [p_alt], by simpa [p_alt]⟩⟩,
        by simp [p_alt, hη₂_pos]⟩
    have hLs_reg : L.𝔰 p_reg = s_reg := L.𝔰_zero s_reg (hStrip.symm ▸ hs_reg_H)
    have hLs_alt : L.𝔰 p_alt = s_reg + (d : ℂ) := L.𝔰_zero (s_reg + (d : ℂ)) (hStrip.symm ▸ hs_alt_H)
    have hLs_ne : L.𝔰 p_reg ≠ L.𝔰 p_alt := by
      rw [hLs_reg, hLs_alt]
      intro heq
      have hd_zero : (d : ℂ) = 0 := by linear_combination heq.symm
      have := congr_arg Complex.re hd_zero
      simp only [Complex.ofReal_re, Complex.zero_re] at this
      linarith
    have hst_ne : s_tilde p_reg ≠ s_tilde p_alt := by
      rw [hs_eq_η₂ p_reg hp_reg_cone (by simp [p_reg, hη₂_pos]),
          hs_eq_η₂ p_alt hp_alt_cone (by simp [p_alt, hη₂_pos])]
      exact hLs_ne

    have hO_reg_open : IsOpen O_reg :=
      (hBack_open.inter hFwd_open).inter (isOpen_lt (continuous_norm.comp continuous_snd) continuous_const)
    have h_f_shift_nhds : ∀ c : ℂ, shift_c c '' O_reg ⊆ U₁ →
        ∀ᶠ q in nhds p_reg, K.f (L.𝔰 (shift_c c q)) ≠ 0 := by
      intro c hc_map
      have hsh_p : shift_c c p_reg = p_reg := by simp [shift_c, p_reg]
      have hLs_cont : ContinuousAt L.𝔰 (shift_c c p_reg) := by
        rw [hsh_p]
        exact (L.𝔰_holo.mono hU₁_sub_T).continuousOn.continuousAt
          (hU₁_open.mem_nhds ⟨hp_reg_cone, by simp [p_reg, hη₂_pos]⟩)
      have hf_cont : ContinuousAt K.f (L.𝔰 (shift_c c p_reg)) := by
        rw [hsh_p, hLs_reg]
        exact (hStrip ▸ K.f_holo).continuousOn.continuousAt (hStrip_open.mem_nhds hs_reg_H)
      have hcomp_cont : ContinuousAt (fun q => K.f (L.𝔰 (shift_c c q))) p_reg :=
        (hf_cont.comp hLs_cont).comp (hsh_cont c).continuousAt
      exact hcomp_cont.eventually_ne (by rw [hsh_p, hLs_reg]; exact hs_reg_f)
    have h_nhds_all : (O_reg ∩
        {q | K.f (L.𝔰 (shift_c (-3 / 2 : ℂ) q)) ≠ 0} ∩
        {q | K.f (L.𝔰 (shift_c (-1 / 2 : ℂ) q)) ≠ 0} ∩
        {q | K.f (L.𝔰 (shift_c (1 / 2 : ℂ) q)) ≠ 0} ∩
        {q | K.f (L.𝔰 (shift_c (3 / 2 : ℂ) q)) ≠ 0}) ∈ nhds p_reg := by
      refine Filter.inter_mem (Filter.inter_mem (Filter.inter_mem (Filter.inter_mem
        (hO_reg_open.mem_nhds hp_reg_mem) ?_) ?_) ?_) ?_
      · refine h_f_shift_nhds (-3 / 2 : ℂ) ?_
        rintro _ ⟨q, ⟨⟨hqB, _⟩, hqt⟩, rfl⟩
        rw [hBack_eq] at hqB; exact ⟨hqB.1, hqt⟩
      · refine h_f_shift_nhds (-1 / 2 : ℂ) ?_
        rintro _ ⟨q, ⟨⟨hqB, _⟩, hqt⟩, rfl⟩
        rw [hBack_eq] at hqB; exact ⟨hqB.2, hqt⟩
      · refine h_f_shift_nhds (1 / 2 : ℂ) ?_
        rintro _ ⟨q, ⟨⟨_, hqF⟩, hqt⟩, rfl⟩
        exact ⟨hqF.1, hqt⟩
      · refine h_f_shift_nhds (3 / 2 : ℂ) ?_
        rintro _ ⟨q, ⟨⟨_, hqF⟩, hqt⟩, rfl⟩
        exact ⟨hqF.2, hqt⟩
    obtain ⟨r_reg, hr_reg_pos, hball_reg⟩ := Metric.mem_nhds_iff.mp h_nhds_all
    exact ⟨η₂, p_reg, p_alt, r_reg,
      hη₂_pos, hη₂_d40, hη₂_s8, hη₂_r4,
      h_lsc_η₂, h_bshift_η₂, hs_eq_η₂,
      rfl, rfl, hp_reg_mem, hp_alt_mem, hst_ne, hLs_ne,
      hr_reg_pos,
      fun q hq => ((((hball_reg hq).1).1).1).1,
      fun q hq => ⟨((((hball_reg hq).1).1).1).2, (((hball_reg hq).1).1).2,
        ((hball_reg hq).1).2, (hball_reg hq).2⟩⟩

  let sliceLift : Set (ℂ × ℂ) :=
    { q : ℂ × ℂ | -L.s_star / 2 < q.1.im ∧ q.1.im < H - d / 10 ∧ ‖q.2‖ < η₂ }
  let sliceBack : Set (ℂ × ℂ) :=
    shift_c (-3 / 2 : ℂ) ⁻¹' sliceLift ∩ shift_c (-1 / 2 : ℂ) ⁻¹' sliceLift
  let sliceFwd : Set (ℂ × ℂ) :=
    shift_c (1 / 2 : ℂ) ⁻¹' sliceLift ∩ shift_c (3 / 2 : ℂ) ⁻¹' sliceLift

  have hSliceLift_open : IsOpen sliceLift :=
    (isOpen_lt continuous_const (Complex.continuous_im.comp continuous_fst)).inter
      ((isOpen_lt (Complex.continuous_im.comp continuous_fst) continuous_const).inter
        (isOpen_lt (continuous_norm.comp continuous_snd) continuous_const))
  have hSliceLift_conv : Convex ℝ sliceLift := by
    intro p ⟨hp1, hp2, hp3⟩ q ⟨hq1, hq2, hq3⟩ a b ha hb hab
    have him : (a • p + b • q).1.im = a * p.1.im + b * q.1.im := by simp
    have hnorm : ‖(a • p + b • q).2‖ ≤ a * ‖p.2‖ + b * ‖q.2‖ := by
      calc ‖a • p.2 + b • q.2‖ ≤ ‖a • p.2‖ + ‖b • q.2‖ := norm_add_le _ _
        _ = a * ‖p.2‖ + b * ‖q.2‖ := by
            rw [norm_smul, norm_smul, Real.norm_of_nonneg ha, Real.norm_of_nonneg hb]
    have hc1 := h_conv_lt_left ha hb hab hp1 hq1
    have hc2 := h_conv_lt_right ha hb hab hp2 hq2
    have hc3 := h_conv_lt_right ha hb hab hp3 hq3
    exact ⟨by rw [him]; exact hc1, by rw [him]; exact hc2, lt_of_le_of_lt hnorm hc3⟩
  have hSliceBack_open : IsOpen sliceBack :=
    (hSliceLift_open.preimage (hsh_cont _)).inter (hSliceLift_open.preimage (hsh_cont _))
  have hSliceBack_conv : Convex ℝ sliceBack :=
    (hsh_conv _ hSliceLift_conv).inter (hsh_conv _ hSliceLift_conv)
  have hSliceFwd_open : IsOpen sliceFwd :=
    (hSliceLift_open.preimage (hsh_cont _)).inter (hSliceLift_open.preimage (hsh_cont _))
  have hSliceFwd_conv : Convex ℝ sliceFwd :=
    (hsh_conv _ hSliceLift_conv).inter (hsh_conv _ hSliceLift_conv)

  have hSliceLift_sub_T : sliceLift ⊆ L.T_norm := by
    intro q ⟨hq_lo, hq_hi, hq_t⟩
    rw [L.T_norm_iff]
    have hqt_r : ‖q.2‖ < L.r_star := by linarith [L.r_star_pos]
    have hqt_base : ‖q.2‖ < M.r_base := lt_trans hqt_r hr_lt_base
    have hb_bd := h_bshift_η₂ q.2 hq_t
    have hb_im : |(L.b_shift q.2).im| ≤ ‖L.b_shift q.2‖ := Complex.abs_im_le_norm _
    have hb_d : ‖L.b_shift q.2‖ < d / 80 := lt_of_lt_of_le hb_bd (min_le_left _ _)
    have hb_s : ‖L.b_shift q.2‖ < L.s_star / 8 := lt_of_lt_of_le hb_bd (min_le_right _ _)
    refine ⟨hqt_r, hqt_base, ?_, ?_⟩
    · have h_neg_im : -(q.1 - L.b_shift q.2).im < M.s_base := by
        have := (abs_le.mp hb_im).2
        simp only [Complex.sub_im]; linarith
      exact lt_of_lt_of_le ((ENNReal.ofReal_lt_ofReal_iff M.s_base_pos).mpr h_neg_im)
        (M.h_X_ge (starRingEnd ℂ q.2)
          (by rw [Metric.mem_ball, dist_zero_right, RCLike.norm_conj]; exact hqt_base))
    · have h_pos_im : (q.1 - L.b_shift q.2).im ≤ H - d / 20 := by
        have := (abs_le.mp hb_im).1
        simp only [Complex.sub_im]; linarith
      exact lt_of_le_of_lt (ENNReal.ofReal_le_ofReal h_pos_im) (h_lsc_η₂ q.2 hq_t)

  have hCone_η₂_sub_sliceLift :
      coneDomain H δ_star d x₀ ∩ { q : ℂ × ℂ | ‖q.2‖ < η₂ } ⊆ sliceLift := by
    intro q ⟨⟨hqd, hqδ, _, _⟩, hqt⟩
    exact ⟨by linarith [L.s_star_pos], by linarith, hqt⟩

  have hBack_η₂_sub : coneDomainBack H δ_star d x₀ ∩ { p : ℂ × ℂ | ‖p.2‖ < η₂ } ⊆ sliceBack := by
    intro p ⟨hpB, hpt⟩
    rw [hBack_eq] at hpB
    exact ⟨hCone_η₂_sub_sliceLift ⟨hpB.1, hpt⟩, hCone_η₂_sub_sliceLift ⟨hpB.2, hpt⟩⟩

  have hFwd_η₂_sub : coneDomainFwd H δ_star d x₀ ∩ { p : ℂ × ℂ | ‖p.2‖ < η₂ } ⊆ sliceFwd := by
    intro p ⟨hpF, hpt⟩
    exact ⟨hCone_η₂_sub_sliceLift ⟨hpF.1, hpt⟩, hCone_η₂_sub_sliceLift ⟨hpF.2, hpt⟩⟩

  
  
  
  obtain ⟨p_real, r_real, hr_real_pos, hB_real_sub, hB_real_maps_base,
      hB_real_f, hB_real_id⟩ :
      ∃ (p_real : ℂ × ℂ) (r_real : ℝ),
        0 < r_real ∧
        Metric.ball p_real r_real ⊆ sliceBack ∩ sliceFwd ∧
        Set.MapsTo (fun p : ℂ × ℂ => (p.1 - L.b_shift p.2, p.2))
          (Metric.ball p_real r_real)
          { q : ℂ × ℂ | |q.1.im| < M.s_base ∧ ‖q.2‖ < M.r_base } ∧
        (∀ q ∈ Metric.ball p_real r_real,
          K.f (L.𝔰 (shift_c (-3 / 2 : ℂ) q)) ≠ 0 ∧ K.f (L.𝔰 (shift_c (-1 / 2 : ℂ) q)) ≠ 0 ∧
          K.f (L.𝔰 (shift_c (1 / 2 : ℂ) q)) ≠ 0 ∧ K.f (L.𝔰 (shift_c (3 / 2 : ℂ) q)) ≠ 0) ∧
        (∀ q ∈ Metric.ball p_real r_real,
          let Pm := K.Γ (L.𝔰 (shift_c (-1 / 2 : ℂ) q))
          let Qm := K.Γ (L.𝔰 (shift_c (-3 / 2 : ℂ) q))
          let ψm := K.ϕ (L.𝔰 (shift_c (-1 / 2 : ℂ) q))
          let Pp := K.Γ (L.𝔰 (shift_c (1 / 2 : ℂ) q))
          let Qp := K.Γ (L.𝔰 (shift_c (3 / 2 : ℂ) q))
          let ψp := K.ϕ (L.𝔰 (shift_c (1 / 2 : ℂ) q))
          reflectDen Pm Qm ψm ≠ 0 ∧ reflectDen Pp Qp ψp ≠ 0 ∧
          ∀ i : Fin 2,
            reflectVtilde Pm Qm ψm i =
              glancingDualLine C (q.1 - L.b_shift q.2) q.2 i * reflectDen Pm Qm ψm ∧
            reflectVtilde Pp Qp ψp i =
              glancingDualLine C (q.1 - L.b_shift q.2) q.2 i * reflectDen Pp Qp ψp) := by
    have h0_mem : (0 : ℂ) ∈ Metric.ball (0 : ℂ) M.r_base := Metric.mem_ball_self M.r_base_pos
    have hb_cont0 : ContinuousAt L.b_shift 0 :=
      L.b_shift_holo.continuousOn.continuousAt (Metric.isOpen_ball.mem_nhds h0_mem)
    let ε_base := min (L.s_star / 8) (M.s_base / 8)
    have hε_base : 0 < ε_base :=
      lt_min (by linarith [L.s_star_pos]) (by linarith [M.s_base_pos])
    have hb_ev : ∀ᶠ t in nhds (0 : ℂ), L.b_shift t ∈ Metric.ball (0 : ℂ) ε_base := by
      have hball0 : Metric.ball (0 : ℂ) ε_base ∈ nhds (L.b_shift 0) := by
        rw [L.b_shift_zero]
        exact Metric.ball_mem_nhds 0 hε_base
      exact hb_cont0.preimage_mem_nhds hball0
    obtain ⟨δ_b, hδ_b, h_δb_ball⟩ := Metric.eventually_nhds_iff_ball.mp hb_ev
    let ρ_y := min (L.s_star / 4) (M.s_base / 4)
    let ρ_t := min η₂ (min δ_b (min (L.s_star / 8) (min (L.r_star / 4)
      (min (M.s_base / 8) (M.r_base / 4)))))
    have hρ_y : 0 < ρ_y :=
      lt_min (by linarith [L.s_star_pos]) (by linarith [M.s_base_pos])
    have hρ_t : 0 < ρ_t := lt_min hη₂_pos (lt_min hδ_b (lt_min (by linarith [L.s_star_pos])
      (lt_min (by linarith [L.r_star_pos]) (lt_min (by linarith [M.s_base_pos])
        (by linarith [M.r_base_pos])))))
    have hρy_s : ρ_y ≤ L.s_star / 4 := min_le_left _ _
    have hρy_m : ρ_y ≤ M.s_base / 4 := min_le_right _ _
    have hρt_η₂ : ρ_t ≤ η₂ := min_le_left _ _
    have hρt_δb : ρ_t ≤ δ_b := le_trans (min_le_right _ _) (min_le_left _ _)
    have hρt_s8 : ρ_t ≤ L.s_star / 8 :=
      le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_left _ _))
    have hρt_r4 : ρ_t ≤ L.r_star / 4 :=
      le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_left _ _)))
    have hρt_ms : ρ_t ≤ M.s_base / 8 :=
      le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (le_trans (min_le_right _ _)
        (le_trans (min_le_right _ _) (min_le_left _ _))))
    have hρt_mr : ρ_t ≤ M.r_base / 4 :=
      le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (le_trans (min_le_right _ _)
        (le_trans (min_le_right _ _) (min_le_right _ _))))

    let U_base := { p : ℂ × ℂ | |p.1.im| < ρ_y ∧ ‖p.2‖ < ρ_t }
    have hU_base_open : IsOpen U_base :=
      (isOpen_lt (continuous_abs.comp (Complex.continuous_im.comp continuous_fst)) continuous_const).inter
        (isOpen_lt (continuous_norm.comp continuous_snd) continuous_const)

    have h_bshift_ub : ∀ p ∈ U_base, ‖L.b_shift p.2‖ < ε_base := by
      intro p hp
      have hm := h_δb_ball p.2 (by rw [Metric.mem_ball, dist_zero_right]; linarith [hp.2])
      rwa [Metric.mem_ball, dist_zero_right] at hm

    have hU_base_slice : ∀ c : ℂ, ‖c‖ ≤ 3 / 2 → ∀ p ∈ U_base, shift_c c p ∈ sliceLift := by
      intro c hc p ⟨hpy, hpt⟩
      have h_im_bd : |(shift_c c p).1.im| < L.s_star / 2 := by
        calc |(p.1 + c * p.2).im| = |p.1.im + (c * p.2).im| := by simp
          _ ≤ |p.1.im| + |(c * p.2).im| := abs_add_le _ _
          _ ≤ |p.1.im| + ‖c * p.2‖ := by linarith [Complex.abs_im_le_norm (c * p.2)]
          _ = |p.1.im| + ‖c‖ * ‖p.2‖ := by rw [norm_mul]
          _ < L.s_star / 4 + (3 / 2) * (L.s_star / 8) := by nlinarith [norm_nonneg p.2, norm_nonneg c]
          _ < L.s_star / 2 := by linarith [L.s_star_pos]
      have h_abs := abs_lt.mp h_im_bd
      exact ⟨by linarith [h_abs.1], by linarith [h_abs.2], lt_of_lt_of_le hpt hρt_η₂⟩

    have h_norm_c : ‖(-3 / 2 : ℂ)‖ ≤ 3 / 2 ∧ ‖(-1 / 2 : ℂ)‖ ≤ 3 / 2 ∧
        ‖(1 / 2 : ℂ)‖ ≤ 3 / 2 ∧ ‖(3 / 2 : ℂ)‖ ≤ 3 / 2 := by
      norm_num

    have hU_base_sub_slices : U_base ⊆ sliceBack ∩ sliceFwd := by
      intro p hp
      exact ⟨⟨hU_base_slice _ h_norm_c.1 p hp, hU_base_slice _ h_norm_c.2.1 p hp⟩,
        ⟨hU_base_slice _ h_norm_c.2.2.1 p hp, hU_base_slice _ h_norm_c.2.2.2 p hp⟩⟩

    have hU_base_maps_m : Set.MapsTo (fun p : ℂ × ℂ => (p.1 - L.b_shift p.2, p.2))
        U_base { q : ℂ × ℂ | |q.1.im| < M.s_base ∧ ‖q.2‖ < M.r_base } := by
      intro p ⟨hpy, hpt⟩
      have hb_m : ‖L.b_shift p.2‖ < M.s_base / 8 :=
        lt_of_lt_of_le (h_bshift_ub p ⟨hpy, hpt⟩) (min_le_right _ _)
      refine ⟨?_, by linarith [M.r_base_pos]⟩
      calc |(p.1 - L.b_shift p.2).im| = |p.1.im - (L.b_shift p.2).im| := by simp
        _ ≤ |p.1.im| + |(L.b_shift p.2).im| := abs_sub _ _
        _ ≤ |p.1.im| + ‖L.b_shift p.2‖ := by linarith [Complex.abs_im_le_norm (L.b_shift p.2)]
        _ < M.s_base := by linarith [M.s_base_pos]

    have h_init_eval : ∀ c : ℂ, ‖c‖ ≤ 3 / 2 → ∀ p ∈ U_base,
        K.f (L.𝔰 (shift_c c p)) ≠ 0 ∧
        K.Γ (L.𝔰 (shift_c c p)) = glancingImpact C (p.1 - L.b_shift p.2 + c * p.2) p.2 ∧
        K.ϕ (L.𝔰 (shift_c c p)) = glancingMidAngle C (p.1 - L.b_shift p.2 + c * p.2) p.2 := by
      intro c hc p ⟨hpy, hpt⟩
      have hb_s : ‖L.b_shift p.2‖ < L.s_star / 8 :=
        lt_of_lt_of_le (h_bshift_ub p ⟨hpy, hpt⟩) (min_le_left _ _)
      have hu_im : |(p.1 - L.b_shift p.2 + c * p.2).im| < K.s_init := by
        calc |(p.1 - L.b_shift p.2 + c * p.2).im|
            = |p.1.im - (L.b_shift p.2).im + (c * p.2).im| := by simp
          _ ≤ |p.1.im - (L.b_shift p.2).im| + |(c * p.2).im| := abs_add_le _ _
          _ ≤ |p.1.im| + |(L.b_shift p.2).im| + ‖c * p.2‖ := by
              linarith [abs_sub p.1.im (L.b_shift p.2).im, Complex.abs_im_le_norm (c * p.2)]
          _ ≤ |p.1.im| + ‖L.b_shift p.2‖ + ‖c‖ * ‖p.2‖ := by
              rw [norm_mul]; linarith [Complex.abs_im_le_norm (L.b_shift p.2)]
          _ < L.s_star / 4 + L.s_star / 8 + (3 / 2) * (L.s_star / 8) := by
              nlinarith [norm_nonneg p.2, norm_nonneg c]
          _ < K.s_init := by linarith [L.s_star_pos, L.s_star_le]
      have ht_r : ‖p.2‖ < K.r_init := by linarith [L.r_star_pos, L.r_star_le]
      have h_eq_init : L.𝔰 (shift_c c p) = K.𝔰_init (p.1 - L.b_shift p.2 + c * p.2, p.2) := by
        change L.𝔰_raw (p.1 + c * p.2 - L.b_shift p.2, p.2) = _
        have h_arg : p.1 + c * p.2 - L.b_shift p.2 = p.1 - L.b_shift p.2 + c * p.2 := by ring
        rw [h_arg]
        exact L.𝔰_raw_init_eq _ _ hu_im ht_r
      rw [h_eq_init]
      exact ⟨K.f_base_ne_zero _ (K.𝔰_init_maps_to _ _ hu_im ht_r),
        (K.𝔰_init_impact _ _ hu_im ht_r).symm,
        K.𝔰_init_ϕ _ _ hu_im ht_r⟩

    have h_impact_proj : ∀ w t : ℂ, |w.im| < C.s₁ → ‖t‖ < C.r₁ →
        (glancingImpact C (w - t / 2) t 0 * Complex.cos (glancingTheta C w t) +
          glancingImpact C (w - t / 2) t 1 * Complex.sin (glancingTheta C w t) =
            glancingOffset C w t) ∧
        (glancingImpact C (w + t / 2) t 0 * Complex.cos (glancingTheta C w t) +
          glancingImpact C (w + t / 2) t 1 * Complex.sin (glancingTheta C w t) =
            glancingOffset C w t) := by
      intro w t hw ht
      have hstat := C.glancing_stationary w t hw ht
      refine ⟨?_, ?_⟩
      · let θ₀ := glancingTheta C (w - t) t
        let θ₁ := glancingTheta C w t
        let ψ := (θ₀ + θ₁) / 2
        have hmid : glancingMidAngle C (w - t / 2) t = ψ := by
          dsimp only [glancingMidAngle, ψ, θ₀, θ₁]
          have h1 : w - t / 2 - t / 2 = w - t := by ring
          have h2 : w - t / 2 + t / 2 = w := by ring
          rw [h1, h2]
        have hsub : θ₁ - ψ = (θ₁ - θ₀) / 2 := by dsimp only [ψ]; ring
        have hc := Complex.cos_sub θ₁ ψ
        have hs := Complex.sin_sub θ₁ ψ
        rw [hsub] at hc hs
        dsimp only [glancingImpact, glancingOffset]
        simp only [Matrix.cons_val_zero, Matrix.cons_val_one, hmid]
        change (C.h_ℂ ψ * Complex.cos ψ - deriv C.h_ℂ ψ * Complex.sin ψ) * Complex.cos θ₁ +
            (C.h_ℂ ψ * Complex.sin ψ + deriv C.h_ℂ ψ * Complex.cos ψ) * Complex.sin θ₁ =
          -supportAction1_ℂ C.h_ℂ (C.ϕ_ℂ (C.U (w, t))) (C.ϕ_ℂ (C.U (w + t, t)))
        rw [hstat]
        change (C.h_ℂ ψ * Complex.cos ψ - deriv C.h_ℂ ψ * Complex.sin ψ) * Complex.cos θ₁ +
            (C.h_ℂ ψ * Complex.sin ψ + deriv C.h_ℂ ψ * Complex.cos ψ) * Complex.sin θ₁ =
          deriv C.h_ℂ ψ * Complex.sin ((θ₁ - θ₀) / 2) + C.h_ℂ ψ * Complex.cos ((θ₁ - θ₀) / 2)
        linear_combination C.h_ℂ ψ * hc.symm + deriv C.h_ℂ ψ * hs.symm
      · let θ₁ := glancingTheta C w t
        let θ₂ := glancingTheta C (w + t) t
        let ψ := (θ₁ + θ₂) / 2
        have hmid : glancingMidAngle C (w + t / 2) t = ψ := by
          dsimp only [glancingMidAngle, ψ, θ₁, θ₂]
          have h1 : w + t / 2 - t / 2 = w := by ring
          have h2 : w + t / 2 + t / 2 = w + t := by ring
          rw [h1, h2]
        have hsub : ψ - θ₁ = (θ₂ - θ₁) / 2 := by dsimp only [ψ]; ring
        have hc := Complex.cos_sub ψ θ₁
        have hs := Complex.sin_sub ψ θ₁
        rw [hsub] at hc hs
        dsimp only [glancingImpact, glancingOffset, supportAction1_ℂ]
        simp only [Matrix.cons_val_zero, Matrix.cons_val_one, hmid]
        linear_combination C.h_ℂ ψ * hc.symm - deriv C.h_ℂ ψ * hs.symm

    have h_cramer_step : ∀ w t : ℂ, |w.im| < C.s₁ → |w.im| < 2 * M.s_base → ‖t‖ < M.r_base →
        let P_minus := glancingImpact C (w - t / 2) t
        let P_plus := glancingImpact C (w + t / 2) t
        let Δ := P_minus 0 * P_plus 1 - P_minus 1 * P_plus 0
        let p_w := glancingOffset C w t
        P_plus 1 - P_minus 1 = (Δ / p_w) * Complex.cos (glancingTheta C w t) ∧
        P_minus 0 - P_plus 0 = (Δ / p_w) * Complex.sin (glancingTheta C w t) := by
      intro w t hw_s1 hw_sb ht_rb
      have ht_r1 : ‖t‖ < C.r₁ := by linarith [M.r_base_lt_r₁, C.r₁_pos]
      have hpw_ne : glancingOffset C w t ≠ 0 :=
        M.offset_ne_zero w t hw_sb (by linarith [M.r_base_pos])
      obtain ⟨hm, hp⟩ := h_impact_proj w t hw_s1 ht_r1
      dsimp only
      refine ⟨?_, ?_⟩
      · rw [div_mul_eq_mul_div, eq_div_iff hpw_ne]
        linear_combination glancingImpact C (w + t / 2) t 1 * hm.symm -
          glancingImpact C (w - t / 2) t 1 * hp.symm
      · rw [div_mul_eq_mul_div, eq_div_iff hpw_ne]
        linear_combination glancingImpact C (w - t / 2) t 0 * hp.symm -
          glancingImpact C (w + t / 2) t 0 * hm.symm

    have h_trig_reflect : ∀ θ ψ : ℂ,
        2 * (Complex.cos θ * Complex.cos ψ + Complex.sin θ * Complex.sin ψ) * Complex.cos ψ -
          Complex.cos θ = Complex.cos (2 * ψ - θ) ∧
        2 * (Complex.cos θ * Complex.cos ψ + Complex.sin θ * Complex.sin ψ) * Complex.sin ψ -
          Complex.sin θ = Complex.sin (2 * ψ - θ) := by
      intro θ ψ
      generalize hh : ψ - θ = h
      have hθ : θ = ψ - h := by linear_combination -hh
      have h2 : 2 * ψ - (ψ - h) = ψ + h := by ring
      have hcs : Complex.cos ψ ^ 2 + Complex.sin ψ ^ 2 = 1 := Complex.cos_sq_add_sin_sq ψ
      rw [hθ, h2, Complex.cos_sub, Complex.sin_sub, Complex.cos_add, Complex.sin_add]
      exact ⟨by linear_combination 2 * Complex.cos h * Complex.cos ψ * hcs,
             by linear_combination 2 * Complex.cos h * Complex.sin ψ * hcs⟩

    have h_reflect_unit : ∀ (P Q : Fin 2 → ℂ) (a θ ψ : ℂ),
        reflectW P Q 0 = a * Complex.cos θ →
        reflectW P Q 1 = a * Complex.sin θ →
        reflectVtilde P Q ψ 0 = a * Complex.cos (2 * ψ - θ) ∧
        reflectVtilde P Q ψ 1 = a * Complex.sin (2 * ψ - θ) ∧
        reflectDen P Q ψ =
          a * (P 0 * Complex.cos (2 * ψ - θ) + P 1 * Complex.sin (2 * ψ - θ)) := by
      intro P Q a θ ψ hW0 hW1
      obtain ⟨ht0, ht1⟩ := h_trig_reflect θ ψ
      have hv0 : reflectVtilde P Q ψ 0 = a * Complex.cos (2 * ψ - θ) := by
        dsimp only [reflectVtilde]
        simp only [Matrix.cons_val_zero]
        rw [hW0, hW1]; linear_combination a * ht0
      have hv1 : reflectVtilde P Q ψ 1 = a * Complex.sin (2 * ψ - θ) := by
        dsimp only [reflectVtilde]
        simp only [Matrix.cons_val_one, Matrix.cons_val_zero]
        rw [hW0, hW1]; linear_combination a * ht1
      refine ⟨hv0, hv1, ?_⟩
      dsimp only [reflectDen]; rw [hv0, hv1]; ring

    have h_cramer_on_U : ∀ p ∈ U_base,
        let u := p.1 - L.b_shift p.2
        let t := p.2
        let Pm := K.Γ (L.𝔰 (shift_c (-1 / 2 : ℂ) p))
        let Qm := K.Γ (L.𝔰 (shift_c (-3 / 2 : ℂ) p))
        let ψm := K.ϕ (L.𝔰 (shift_c (-1 / 2 : ℂ) p))
        let Pp := K.Γ (L.𝔰 (shift_c (1 / 2 : ℂ) p))
        let Qp := K.Γ (L.𝔰 (shift_c (3 / 2 : ℂ) p))
        let ψp := K.ϕ (L.𝔰 (shift_c (1 / 2 : ℂ) p))
        let Δ_m := glancingImpact C (u - t - t / 2) t 0 * glancingImpact C (u - t + t / 2) t 1 -
          glancingImpact C (u - t - t / 2) t 1 * glancingImpact C (u - t + t / 2) t 0
        let Δ_p := glancingImpact C (u + t - t / 2) t 0 * glancingImpact C (u + t + t / 2) t 1 -
          glancingImpact C (u + t - t / 2) t 1 * glancingImpact C (u + t + t / 2) t 0
        reflectDen Pm Qm ψm = (Δ_m / glancingOffset C (u - t) t) * glancingOffset C u t ∧
        reflectDen Pp Qp ψp = (-Δ_p / glancingOffset C (u + t) t) * glancingOffset C u t ∧
        ∀ i : Fin 2,
          reflectVtilde Pm Qm ψm i = glancingDualLine C u t i * reflectDen Pm Qm ψm ∧
          reflectVtilde Pp Qp ψp i = glancingDualLine C u t i * reflectDen Pp Qp ψp := by
      intro p hp
      dsimp only
      set u := p.1 - L.b_shift p.2
      set t := p.2
      have hb_m : ‖L.b_shift t‖ < M.s_base / 8 :=
        lt_of_lt_of_le (h_bshift_ub p hp) (min_le_right _ _)
      have ht_rb : ‖t‖ < M.r_base := by linarith [hp.2, M.r_base_pos]
      have ht_r1 : ‖t‖ < C.r₁ := by linarith [M.r_base_lt_r₁, C.r₁_pos]
      have hu_im : |u.im| < M.s_base := by
        calc |u.im| = |p.1.im - (L.b_shift t).im| := by simp [u, t]
          _ ≤ |p.1.im| + |(L.b_shift t).im| := abs_sub _ _
          _ ≤ |p.1.im| + ‖L.b_shift t‖ := by linarith [Complex.abs_im_le_norm (L.b_shift t)]
          _ < M.s_base := by linarith [hp.1, M.s_base_pos]
      have hum_im : |(u - t).im| < M.s_base + M.r_base := by
        calc |(u - t).im| ≤ |u.im| + |t.im| := by simp only [Complex.sub_im]; exact abs_sub _ _
          _ ≤ |u.im| + ‖t‖ := by linarith [Complex.abs_im_le_norm t]
          _ < M.s_base + M.r_base := by linarith
      have hup_im : |(u + t).im| < M.s_base + M.r_base := by
        calc |(u + t).im| ≤ |u.im| + |t.im| := by simp only [Complex.add_im]; exact abs_add_le _ _
          _ ≤ |u.im| + ‖t‖ := by linarith [Complex.abs_im_le_norm t]
          _ < M.s_base + M.r_base := by linarith
      have hp0_ne : glancingOffset C u t ≠ 0 :=
        M.offset_ne_zero u t (by linarith [M.s_base_pos]) (by linarith [M.r_base_pos])

      have h_m1 := h_init_eval (-1 / 2 : ℂ) h_norm_c.2.1 p hp
      have h_m3 := h_init_eval (-3 / 2 : ℂ) h_norm_c.1 p hp
      have h_p1 := h_init_eval (1 / 2 : ℂ) h_norm_c.2.2.1 p hp
      have h_p3 := h_init_eval (3 / 2 : ℂ) h_norm_c.2.2.2 p hp

      have ha_m1 : u + (-1 / 2 : ℂ) * t = u - t / 2 := by ring
      have ha_m1' : u - t + t / 2 = u - t / 2 := by ring
      have ha_m3 : u + (-3 / 2 : ℂ) * t = u - t - t / 2 := by ring
      have ha_p1 : u + (1 / 2 : ℂ) * t = u + t / 2 := by ring
      have ha_p1' : u + t - t / 2 = u + t / 2 := by ring
      have ha_p3 : u + (3 / 2 : ℂ) * t = u + t + t / 2 := by ring

      let Pm := glancingImpact C (u - t / 2) t
      let Qm := glancingImpact C (u - t - t / 2) t
      let ψm := glancingMidAngle C (u - t / 2) t
      let Pp := glancingImpact C (u + t / 2) t
      let Qp := glancingImpact C (u + t + t / 2) t
      let ψp := glancingMidAngle C (u + t / 2) t

      have hPm_eq : K.Γ (L.𝔰 (shift_c (-1 / 2 : ℂ) p)) = Pm := by rw [h_m1.2.1, ha_m1]
      have hQm_eq : K.Γ (L.𝔰 (shift_c (-3 / 2 : ℂ) p)) = Qm := by rw [h_m3.2.1, ha_m3]
      have hψm_eq : K.ϕ (L.𝔰 (shift_c (-1 / 2 : ℂ) p)) = ψm := by rw [h_m1.2.2, ha_m1]
      have hPp_eq : K.Γ (L.𝔰 (shift_c (1 / 2 : ℂ) p)) = Pp := by rw [h_p1.2.1, ha_p1]
      have hQp_eq : K.Γ (L.𝔰 (shift_c (3 / 2 : ℂ) p)) = Qp := by rw [h_p3.2.1, ha_p3]
      have hψp_eq : K.ϕ (L.𝔰 (shift_c (1 / 2 : ℂ) p)) = ψp := by rw [h_p1.2.2, ha_p1]

      obtain ⟨hcr_m0, hcr_m1⟩ := h_cramer_step (u - t) t
        (by linarith [M.r_base_lt_s_base, M.s_base_le_s₁, M.s_base_pos])
        (by linarith [M.r_base_lt_s_base, M.s_base_pos]) ht_rb
      simp only [ha_m1'] at hcr_m0 hcr_m1
      let Δ_m := Qm 0 * Pm 1 - Qm 1 * Pm 0
      let p_m := glancingOffset C (u - t) t
      let θ_m := glancingTheta C (u - t) t
      let θ₀ := glancingTheta C u t
      have hWm0 : reflectW Pm Qm 0 = (Δ_m / p_m) * Complex.cos θ_m := by
        dsimp only [reflectW]; simp only [Matrix.cons_val_zero]; exact hcr_m0
      have hWm1 : reflectW Pm Qm 1 = (Δ_m / p_m) * Complex.sin θ_m := by
        dsimp only [reflectW]; simp only [Matrix.cons_val_one, Matrix.cons_val_zero]; exact hcr_m1
      have h2ψm : 2 * ψm - θ_m = θ₀ := by
        dsimp only [ψm, glancingMidAngle, θ_m, θ₀]
        have h_sub1 : u - t / 2 - t / 2 = u - t := by ring
        have h_sub2 : u - t / 2 + t / 2 = u := by ring
        rw [h_sub1, h_sub2]; ring
      obtain ⟨hVm0, hVm1, hDm⟩ := h_reflect_unit Pm Qm (Δ_m / p_m) θ_m ψm hWm0 hWm1
      rw [h2ψm] at hVm0 hVm1 hDm
      have hproj := h_impact_proj u t (by linarith [M.s_base_le_s₁, M.s_base_pos]) ht_r1
      rw [hproj.1] at hDm

      obtain ⟨hcr_p0, hcr_p1⟩ := h_cramer_step (u + t) t
        (by linarith [M.r_base_lt_s_base, M.s_base_le_s₁, M.s_base_pos])
        (by linarith [M.r_base_lt_s_base, M.s_base_pos]) ht_rb
      simp only [ha_p1'] at hcr_p0 hcr_p1
      let Δ_p := Pp 0 * Qp 1 - Pp 1 * Qp 0
      let p_p := glancingOffset C (u + t) t
      let θ_p := glancingTheta C (u + t) t
      have hWp0 : reflectW Pp Qp 0 = (-Δ_p / p_p) * Complex.cos θ_p := by
        dsimp only [reflectW]; simp only [Matrix.cons_val_zero]
        have : Pp 1 - Qp 1 = -(Qp 1 - Pp 1) := by ring
        rw [this, hcr_p0]; ring
      have hWp1 : reflectW Pp Qp 1 = (-Δ_p / p_p) * Complex.sin θ_p := by
        dsimp only [reflectW]; simp only [Matrix.cons_val_one, Matrix.cons_val_zero]
        have : Qp 0 - Pp 0 = -(Pp 0 - Qp 0) := by ring
        rw [this, hcr_p1]; ring
      have h2ψp : 2 * ψp - θ_p = θ₀ := by
        dsimp only [ψp, glancingMidAngle, θ_p, θ₀]
        have h_add1 : u + t / 2 - t / 2 = u := by ring
        have h_add2 : u + t / 2 + t / 2 = u + t := by ring
        rw [h_add1, h_add2]; ring
      obtain ⟨hVp0, hVp1, hDp⟩ := h_reflect_unit Pp Qp (-Δ_p / p_p) θ_p ψp hWp0 hWp1
      rw [h2ψp] at hVp0 hVp1 hDp
      rw [hproj.2] at hDp

      rw [hPm_eq, hQm_eq, hψm_eq, hPp_eq, hQp_eq, hψp_eq]
      have hDm' : reflectDen Pm Qm ψm =
          ((Qm 0 * glancingImpact C (u - t + t / 2) t 1 -
            Qm 1 * glancingImpact C (u - t + t / 2) t 0) / p_m) * glancingOffset C u t := by
        rw [hDm]; dsimp only [Δ_m, Pm]; rw [ha_m1']
      have hDp' : reflectDen Pp Qp ψp =
          (-(glancingImpact C (u + t - t / 2) t 0 * Qp 1 -
            glancingImpact C (u + t - t / 2) t 1 * Qp 0) / p_p) * glancingOffset C u t := by
        rw [hDp]; dsimp only [Δ_p, Pp]; rw [ha_p1']
      refine ⟨hDm', hDp', Fin.forall_fin_two.mpr ⟨⟨?_, ?_⟩, ⟨?_, ?_⟩⟩⟩
      · rw [hVm0, hDm]; simp only [glancingDualLine, Matrix.cons_val_zero, θ₀]
        field_simp [hp0_ne]
      · rw [hVp0, hDp]; simp only [glancingDualLine, Matrix.cons_val_zero, θ₀]
        field_simp [hp0_ne]
      · rw [hVm1, hDm]; simp only [glancingDualLine, Matrix.cons_val_one, Matrix.cons_val_zero, θ₀]
        field_simp [hp0_ne]
      · rw [hVp1, hDp]; simp only [glancingDualLine, Matrix.cons_val_one, Matrix.cons_val_zero, θ₀]
        field_simp [hp0_ne]

    let t_re : ℝ := ρ_t / 2
    have ht_re_def : t_re = ρ_t / 2 := rfl
    have ht_re_pos : 0 < t_re := by linarith
    have ht_re_init : t_re < K.r_init := by linarith [L.r_star_le, L.r_star_pos]
    have ht_re_m : t_re < M.r_base := by linarith [M.r_base_pos]
    have ht_re_r1 : t_re < C.r₁ := by linarith [M.r_base_lt_r₁, C.r₁_pos]
    let p_real : ℂ × ℂ := ((x₀ : ℂ), (t_re : ℂ))
    have hp_real_U : p_real ∈ U_base := by
      refine ⟨by simp [p_real, hρ_y], ?_⟩
      simp only [p_real, Complex.norm_real, Real.norm_of_nonneg (le_of_lt ht_re_pos)]
      linarith
    have hb_im_zero : (L.b_shift (t_re : ℂ)).im = 0 := by
      have hconj := L.b_shift_conj (t_re : ℂ) (by
        rw [Metric.mem_ball, dist_zero_right, Complex.norm_real, Real.norm_of_nonneg (le_of_lt ht_re_pos)]
        exact ht_re_m)
      rw [Complex.conj_ofReal] at hconj
      exact Complex.conj_eq_iff_im.mp hconj.symm
    let u_re : ℝ := x₀ - (L.b_shift (t_re : ℂ)).re
    have hu_real_eq : p_real.1 - L.b_shift p_real.2 = (u_re : ℂ) := by
      apply Complex.ext
      · simp [p_real, u_re]
      · simp [p_real, hb_im_zero]

    
    have hϕ_nat_qp : ∀ (n : ℕ) (s : ℝ),
        C.ϕ (s + (n : ℝ) * (2 * Real.pi)) = C.ϕ s + (n : ℝ) * (2 * Real.pi) := by
      intro n
      induction n with
      | zero => intro s; simp
      | succ n ih =>
        intro s
        have hstep : s + ((n + 1 : ℕ) : ℝ) * (2 * Real.pi) =
            (s + (n : ℝ) * (2 * Real.pi)) + 2 * Real.pi := by push_cast; ring
        rw [hstep, C.ϕ_quasiperiodic, ih]
        push_cast; ring

    have hϕ_int_qp : ∀ (k : ℤ) (s : ℝ),
        C.ϕ (s + (k : ℝ) * (2 * Real.pi)) = C.ϕ s + (k : ℝ) * (2 * Real.pi) := by
      intro k s
      rcases Int.eq_nat_or_neg k with ⟨n, rfl | rfl⟩
      · exact_mod_cast hϕ_nat_qp n s
      · have h1 := hϕ_nat_qp n (s - (n : ℝ) * (2 * Real.pi))
        have h2 : s - (n : ℝ) * (2 * Real.pi) + (n : ℝ) * (2 * Real.pi) = s := by ring
        rw [h2] at h1
        have h_arg : s + ((-(n : ℤ) : ℤ) : ℝ) * (2 * Real.pi) = s - (n : ℝ) * (2 * Real.pi) := by
          push_cast; ring
        have h3 : ((-(n : ℤ) : ℤ) : ℝ) = -(n : ℝ) := by push_cast; ring
        rw [h_arg, h3]
        linarith

    have h_theta_real : ∀ r : ℝ,
        glancingTheta C (r : ℂ) (t_re : ℂ) = ((C.ϕ (C.U ((r : ℂ), (t_re : ℂ))).re : ℝ) : ℂ) := by
      intro r
      have htr_norm : ‖(t_re : ℂ)‖ < C.r₁ := by
        rw [Complex.norm_real, Real.norm_of_nonneg (le_of_lt ht_re_pos)]; exact ht_re_r1
      have hconj := C.U_conj (r : ℂ) (t_re : ℂ)
        (by simp; linarith [C.r₁_pos, C.r₁_lt_s₁]) htr_norm
      rw [Complex.conj_ofReal, Complex.conj_ofReal] at hconj
      have him : (C.U ((r : ℂ), (t_re : ℂ))).im = 0 := Complex.conj_eq_iff_im.mp hconj.symm
      have heq : C.U ((r : ℂ), (t_re : ℂ)) = ((C.U ((r : ℂ), (t_re : ℂ))).re : ℂ) :=
        Complex.ext rfl (by simp [him])
      dsimp only [glancingTheta]
      exact (congr_arg C.ϕ_ℂ heq).trans (C.ϕ_ℂ_real _)

    have h_real_impact_eval : ∀ y : ℝ,
        ∃ s_y : ℝ,
          glancingImpact C (y : ℂ) (t_re : ℂ) = K.Γ (s_y : ℂ) ∧
          C.ϕ s_y =
            (C.ϕ (C.U (((y - t_re / 2 : ℝ) : ℂ), (t_re : ℂ))).re +
              C.ϕ (C.U (((y + t_re / 2 : ℝ) : ℂ), (t_re : ℂ))).re) / 2 := by
      intro y
      have hy_im : |(y : ℂ).im| < K.s_init := by simp [K.s_init_pos]
      have ht_norm : ‖(t_re : ℂ)‖ < K.r_init := by
        rw [Complex.norm_real, Real.norm_of_nonneg (le_of_lt ht_re_pos)]; exact ht_re_init
      let s_c := K.𝔰_init ((y : ℂ), (t_re : ℂ))
      have hconj := K.𝔰_init_conj (y : ℂ) (t_re : ℂ) hy_im ht_norm
      rw [Complex.conj_ofReal, Complex.conj_ofReal] at hconj
      have him : s_c.im = 0 := Complex.conj_eq_iff_im.mp hconj.symm
      have hsc_eq : s_c = (s_c.re : ℂ) := Complex.ext rfl (by simp [him])
      have hsc_strip : s_c ∈ horizStrip M.s_base := K.𝔰_init_maps_to _ _ hy_im ht_norm
      have hϕ_eq : (C.ϕ s_c.re : ℂ) = glancingMidAngle C (y : ℂ) (t_re : ℂ) := by
        calc (C.ϕ s_c.re : ℂ) = C.ϕ_ℂ (s_c.re : ℂ) := (C.ϕ_ℂ_real s_c.re).symm
          _ = C.ϕ_ℂ s_c := by rw [← hsc_eq]
          _ = K.ϕ s_c := (K.base_ϕ_eq s_c hsc_strip).1.symm
          _ = glancingMidAngle C (y : ℂ) (t_re : ℂ) := K.𝔰_init_ϕ _ _ hy_im ht_norm
      refine ⟨s_c.re, ?_, ?_⟩
      · rw [← hsc_eq]
        exact K.𝔰_init_impact _ _ hy_im ht_norm
      · have h1 : (y : ℂ) - (t_re : ℂ) / 2 = ((y - t_re / 2 : ℝ) : ℂ) := by push_cast; ring
        have h2 : (y : ℂ) + (t_re : ℂ) / 2 = ((y + t_re / 2 : ℝ) : ℂ) := by push_cast; ring
        dsimp only [glancingMidAngle] at hϕ_eq
        rw [h1, h2, h_theta_real, h_theta_real] at hϕ_eq
        have hre := congr_arg Complex.re hϕ_eq
        simpa using hre

    have h_real_delta_nz : ∀ x : ℝ,
        glancingImpact C ((x : ℂ) - (t_re : ℂ) / 2) (t_re : ℂ) 0 *
            glancingImpact C ((x : ℂ) + (t_re : ℂ) / 2) (t_re : ℂ) 1 -
          glancingImpact C ((x : ℂ) - (t_re : ℂ) / 2) (t_re : ℂ) 1 *
            glancingImpact C ((x : ℂ) + (t_re : ℂ) / 2) (t_re : ℂ) 0 ≠ 0 := by
      intro x hΔ0
      have hcramer := h_cramer_step (x : ℂ) (t_re : ℂ)
        (by simp; linarith [C.r₁_pos, C.r₁_lt_s₁])
        (by simp [M.s_base_pos])
        (by rw [Complex.norm_real, Real.norm_of_nonneg (le_of_lt ht_re_pos)]; exact ht_re_m)
      dsimp only at hcramer
      rw [hΔ0, zero_div, zero_mul, zero_mul] at hcramer
      have hP_eq : glancingImpact C ((x : ℂ) - (t_re : ℂ) / 2) (t_re : ℂ) =
          glancingImpact C ((x : ℂ) + (t_re : ℂ) / 2) (t_re : ℂ) := by
        ext i
        rcases Fin.exists_fin_two.mp ⟨i, rfl⟩ with rfl | rfl
        · exact sub_eq_zero.mp hcramer.2
        · exact (sub_eq_zero.mp hcramer.1).symm
      obtain ⟨s₁, hs₁_Γ, hs₁_ϕ⟩ := h_real_impact_eval (x - t_re / 2)
      obtain ⟨s₂, hs₂_Γ, hs₂_ϕ⟩ := h_real_impact_eval (x + t_re / 2)
      have hc1 : ((x - t_re / 2 : ℝ) : ℂ) = (x : ℂ) - (t_re : ℂ) / 2 := by push_cast; ring
      have hc2 : ((x + t_re / 2 : ℝ) : ℂ) = (x : ℂ) + (t_re : ℂ) / 2 := by push_cast; ring
      rw [hc1] at hs₁_Γ
      rw [hc2] at hs₂_Γ
      rw [hs₁_Γ, hs₂_Γ] at hP_eq
      obtain ⟨k, hk⟩ := K.Γ_real_simple s₂ s₁ hP_eq.symm
      have hs₂_eq : s₂ = s₁ + (k : ℝ) * (2 * Real.pi) := by linarith
      have hϕ_diff_k : C.ϕ s₂ - C.ϕ s₁ = (k : ℝ) * (2 * Real.pi) := by
        rw [hs₂_eq, hϕ_int_qp]; ring
      have ha1 : x - t_re / 2 - t_re / 2 = x - t_re := by ring
      have ha2 : x - t_re / 2 + t_re / 2 = x := by ring
      have ha3 : x + t_re / 2 - t_re / 2 = x := by ring
      have ha4 : x + t_re / 2 + t_re / 2 = x + t_re := by ring
      rw [ha1, ha2] at hs₁_ϕ
      rw [ha3, ha4] at hs₂_ϕ
      have hstep1 := C.U_real_step_pos (x - t_re) t_re ht_re_pos ht_re_r1
      have ha5 : ((x - t_re + t_re : ℝ) : ℂ) = (x : ℂ) := by push_cast; ring
      simp only [Complex.ofReal_sub] at hstep1 hs₁_ϕ
      have ha5' : (x : ℂ) - (t_re : ℂ) + (t_re : ℂ) = (x : ℂ) := by ring
      rw [ha5'] at hstep1
      have hstep2 := C.U_real_step_pos x t_re ht_re_pos ht_re_r1
      simp only [Complex.ofReal_add] at hstep2 hs₂_ϕ
      have h_pos_diff : 0 < C.ϕ s₂ - C.ϕ s₁ := by linarith [hstep1.2.1, hstep2.2.1]
      have h_lt_pi : C.ϕ s₂ - C.ϕ s₁ < Real.pi := by linarith [hstep1.2.2, hstep2.2.2]
      rw [hϕ_diff_k] at h_pos_diff h_lt_pi
      rcases le_or_gt k 0 with hk0 | hk1
      · have hk_nonpos : (k : ℝ) ≤ 0 := Int.cast_nonpos.mpr hk0
        have hmul_le : (k : ℝ) * (2 * Real.pi) ≤ 0 :=
          mul_nonpos_of_nonpos_of_nonneg hk_nonpos (by linarith [Real.pi_pos])
        linarith
      · have hk_ge1 : (1 : ℝ) ≤ (k : ℝ) := by exact_mod_cast Int.add_one_le_iff.mpr hk1
        nlinarith [Real.pi_pos]

    obtain ⟨hDm_real, hDp_real, _⟩ := h_cramer_on_U p_real hp_real_U
    have htr2_norm : ‖(t_re : ℂ)‖ < 2 * M.r_base := by
      rw [Complex.norm_real, Real.norm_of_nonneg (le_of_lt ht_re_pos)]; linarith [M.r_base_pos]
    have hp0_nz : glancingOffset C (u_re : ℂ) (t_re : ℂ) ≠ 0 :=
      M.offset_ne_zero (u_re : ℂ) (t_re : ℂ) (by simp [M.s_base_pos]) htr2_norm

    have hDm_real_nz : reflectDen (K.Γ (L.𝔰 (shift_c (-1 / 2 : ℂ) p_real)))
        (K.Γ (L.𝔰 (shift_c (-3 / 2 : ℂ) p_real))) (K.ϕ (L.𝔰 (shift_c (-1 / 2 : ℂ) p_real))) ≠ 0 := by
      rw [hDm_real, hu_real_eq]
      change (((glancingImpact C ((u_re : ℂ) - (t_re : ℂ) - (t_re : ℂ) / 2) (t_re : ℂ) 0 *
          glancingImpact C ((u_re : ℂ) - (t_re : ℂ) + (t_re : ℂ) / 2) (t_re : ℂ) 1 -
        glancingImpact C ((u_re : ℂ) - (t_re : ℂ) - (t_re : ℂ) / 2) (t_re : ℂ) 1 *
          glancingImpact C ((u_re : ℂ) - (t_re : ℂ) + (t_re : ℂ) / 2) (t_re : ℂ) 0) /
        glancingOffset C ((u_re : ℂ) - (t_re : ℂ)) (t_re : ℂ)) *
        glancingOffset C (u_re : ℂ) (t_re : ℂ)) ≠ 0
      have hpm_nz : glancingOffset C ((u_re : ℂ) - (t_re : ℂ)) (t_re : ℂ) ≠ 0 :=
        M.offset_ne_zero ((u_re : ℂ) - (t_re : ℂ)) (t_re : ℂ) (by simp [M.s_base_pos]) htr2_norm
      have hΔm_nz := h_real_delta_nz (u_re - t_re)
      simp only [Complex.ofReal_sub] at hΔm_nz
      exact mul_ne_zero (div_ne_zero hΔm_nz hpm_nz) hp0_nz

    have hDp_real_nz : reflectDen (K.Γ (L.𝔰 (shift_c (1 / 2 : ℂ) p_real)))
        (K.Γ (L.𝔰 (shift_c (3 / 2 : ℂ) p_real))) (K.ϕ (L.𝔰 (shift_c (1 / 2 : ℂ) p_real))) ≠ 0 := by
      rw [hDp_real, hu_real_eq]
      change ((-((glancingImpact C ((u_re : ℂ) + (t_re : ℂ) - (t_re : ℂ) / 2) (t_re : ℂ) 0 *
          glancingImpact C ((u_re : ℂ) + (t_re : ℂ) + (t_re : ℂ) / 2) (t_re : ℂ) 1 -
        glancingImpact C ((u_re : ℂ) + (t_re : ℂ) - (t_re : ℂ) / 2) (t_re : ℂ) 1 *
          glancingImpact C ((u_re : ℂ) + (t_re : ℂ) + (t_re : ℂ) / 2) (t_re : ℂ) 0)) /
        glancingOffset C ((u_re : ℂ) + (t_re : ℂ)) (t_re : ℂ)) *
        glancingOffset C (u_re : ℂ) (t_re : ℂ)) ≠ 0
      have hpp_nz : glancingOffset C ((u_re : ℂ) + (t_re : ℂ)) (t_re : ℂ) ≠ 0 :=
        M.offset_ne_zero ((u_re : ℂ) + (t_re : ℂ)) (t_re : ℂ) (by simp [M.s_base_pos]) htr2_norm
      have hΔp_nz := h_real_delta_nz (u_re + t_re)
      simp only [Complex.ofReal_add] at hΔp_nz
      exact mul_ne_zero (div_ne_zero (neg_ne_zero.mpr hΔp_nz) hpp_nz) hp0_nz

    have h_shift_L_cont : ∀ c : ℂ, ‖c‖ ≤ 3 / 2 →
        ContinuousAt (fun q => K.Γ (L.𝔰 (shift_c c q)) 0) p_real ∧
        ContinuousAt (fun q => K.Γ (L.𝔰 (shift_c c q)) 1) p_real ∧
        ContinuousAt (fun q => K.ϕ (L.𝔰 (shift_c c q))) p_real := by
      intro c hc
      have hsh_mem : shift_c c p_real ∈ sliceLift := hU_base_slice c hc p_real hp_real_U
      have hLs_at_sh : ContinuousAt L.𝔰 (shift_c c p_real) :=
        (L.𝔰_holo.mono hSliceLift_sub_T).continuousOn.continuousAt
          (hSliceLift_open.mem_nhds hsh_mem)
      have hs_in_D : L.𝔰 (shift_c c p_real) ∈ horizStripENNR (M.h_X 0) :=
        L.𝔰_maps_to _ (hSliceLift_sub_T hsh_mem)
      have hreg := K.Γ_reg_holo _ hs_in_D (h_init_eval c hc p_real hp_real_U).1
      have hϕ_cont : ContinuousAt K.ϕ (L.𝔰 (shift_c c p_real)) :=
        (hStrip ▸ K.ϕ_holo).continuousOn.continuousAt (hStrip_open.mem_nhds (hStrip ▸ hs_in_D))
      exact ⟨(hreg.1.continuousAt.comp hLs_at_sh).comp (hsh_cont c).continuousAt,
        (hreg.2.continuousAt.comp hLs_at_sh).comp (hsh_cont c).continuousAt,
        (hϕ_cont.comp hLs_at_sh).comp (hsh_cont c).continuousAt⟩

    have hDen_cont : ∀ c₁ c₂ : ℂ, ‖c₁‖ ≤ 3 / 2 → ‖c₂‖ ≤ 3 / 2 →
        ContinuousAt (fun q =>
          reflectDen (K.Γ (L.𝔰 (shift_c c₁ q))) (K.Γ (L.𝔰 (shift_c c₂ q))) (K.ϕ (L.𝔰 (shift_c c₁ q)))) p_real := by
      intro c₁ c₂ hc₁ hc₂
      obtain ⟨hP0, hP1, hψ⟩ := h_shift_L_cont c₁ hc₁
      obtain ⟨hQ0, hQ1, _⟩ := h_shift_L_cont c₂ hc₂
      have hcos := Complex.continuous_cos.continuousAt.comp hψ
      have hsin := Complex.continuous_sin.continuousAt.comp hψ
      have hW0 := hP1.sub hQ1
      have hW1 := hQ0.sub hP0
      have hdot := (hW0.mul hcos).add (hW1.mul hsin)
      exact (hP0.mul (((continuousAt_const.mul hdot).mul hcos).sub hW0)).add
        (hP1.mul (((continuousAt_const.mul hdot).mul hsin).sub hW1))

    have hDm_ev := (hDen_cont (-1 / 2) (-3 / 2) h_norm_c.2.1 h_norm_c.1).eventually_ne hDm_real_nz
    have hDp_ev := (hDen_cont (1 / 2) (3 / 2) h_norm_c.2.2.1 h_norm_c.2.2.2).eventually_ne hDp_real_nz
    obtain ⟨r_real, hr_real_pos, hball_real⟩ := Metric.mem_nhds_iff.mp
      (Filter.inter_mem (hU_base_open.mem_nhds hp_real_U) (Filter.inter_mem hDm_ev hDp_ev))
    refine ⟨p_real, r_real, hr_real_pos,
      fun q hq => hU_base_sub_slices (hball_real hq).1,
      fun q hq => hU_base_maps_m (hball_real hq).1,
      fun q hq => ⟨(h_init_eval _ h_norm_c.1 q (hball_real hq).1).1,
        (h_init_eval _ h_norm_c.2.1 q (hball_real hq).1).1,
        (h_init_eval _ h_norm_c.2.2.1 q (hball_real hq).1).1,
        (h_init_eval _ h_norm_c.2.2.2 q (hball_real hq).1).1⟩,
      fun q hq => ⟨(hball_real hq).2.1, (hball_real hq).2.2,
        (h_cramer_on_U q (hball_real hq).1).2.2⟩⟩

  
  
  
  let B_real := Metric.ball p_real r_real
  let B_reg := Metric.ball p_reg r_reg
  have hp_real_mem : p_real ∈ B_real := Metric.mem_ball_self hr_real_pos
  have hp_reg_ball : p_reg ∈ B_reg := Metric.mem_ball_self hr_reg_pos

  have hsh_reg_eq : ∀ c : ℂ, shift_c c p_reg = p_reg ∧ shift_c c p_alt = p_alt := by
    intro c
    refine ⟨?_, ?_⟩
    · ext <;> simp [shift_c, hp_reg_2]
    · ext <;> simp [shift_c, hp_alt_2]

  have hB_reg_sub_slice : B_reg ⊆ sliceBack ∩ sliceFwd := by
    intro q hq
    have hm := hB_reg_sub hq
    exact ⟨hBack_η₂_sub ⟨hm.1.1, hm.2⟩, hFwd_η₂_sub ⟨hm.1.2, hm.2⟩⟩

  have hLs_sliceLift_holo : DifferentiableOn ℂ L.𝔰 sliceLift := L.𝔰_holo.mono hSliceLift_sub_T
  have hLs_sliceLift_maps : ∀ q ∈ sliceLift, L.𝔰 q ∈ horizStrip H :=
    fun q hq => hStrip ▸ L.𝔰_maps_to q (hSliceLift_sub_T hq)

  obtain ⟨Q_back_sl, hQ_back_sl_reg⟩ := h_mkReflectedMero hSliceBack_open hSliceBack_conv
    (fun p => L.𝔰 (shift_c (-1 / 2 : ℂ) p)) (fun p => L.𝔰 (shift_c (-3 / 2 : ℂ) p))
    (hLs_sliceLift_holo.comp (hsh_diff _).differentiableOn (fun _ hp => hp.2))
    (hLs_sliceLift_holo.comp (hsh_diff _).differentiableOn (fun _ hp => hp.1))
    (fun _ hp => hLs_sliceLift_maps _ hp.2)
    (fun _ hp => hLs_sliceLift_maps _ hp.1)
    ⟨p_reg, (hB_reg_sub_slice hp_reg_ball).1,
     p_alt, hBack_η₂_sub ⟨hp_alt_mem.1.1, hp_alt_mem.2⟩,
     by rw [(hsh_reg_eq _).1, (hsh_reg_eq _).2]; exact hLs_ne⟩
    ⟨p_reg, (hB_reg_sub_slice hp_reg_ball).1,
     p_alt, hBack_η₂_sub ⟨hp_alt_mem.1.1, hp_alt_mem.2⟩,
     by rw [(hsh_reg_eq _).1, (hsh_reg_eq _).2]; exact hLs_ne⟩
    (fun _ hq => (hB_real_sub hq).1)
    (fun q hq => ⟨(hB_real_f q hq).2.1, (hB_real_f q hq).1⟩)
    hp_real_mem (hB_real_id p_real hp_real_mem).1

  obtain ⟨Q_fwd_sl, hQ_fwd_sl_reg⟩ := h_mkReflectedMero hSliceFwd_open hSliceFwd_conv
    (fun p => L.𝔰 (shift_c (1 / 2 : ℂ) p)) (fun p => L.𝔰 (shift_c (3 / 2 : ℂ) p))
    (hLs_sliceLift_holo.comp (hsh_diff _).differentiableOn (fun _ hp => hp.1))
    (hLs_sliceLift_holo.comp (hsh_diff _).differentiableOn (fun _ hp => hp.2))
    (fun _ hp => hLs_sliceLift_maps _ hp.1)
    (fun _ hp => hLs_sliceLift_maps _ hp.2)
    ⟨p_reg, (hB_reg_sub_slice hp_reg_ball).2,
     p_alt, hFwd_η₂_sub ⟨hp_alt_mem.1.2, hp_alt_mem.2⟩,
     by rw [(hsh_reg_eq _).1, (hsh_reg_eq _).2]; exact hLs_ne⟩
    ⟨p_reg, (hB_reg_sub_slice hp_reg_ball).2,
     p_alt, hFwd_η₂_sub ⟨hp_alt_mem.1.2, hp_alt_mem.2⟩,
     by rw [(hsh_reg_eq _).1, (hsh_reg_eq _).2]; exact hLs_ne⟩
    (fun _ hq => (hB_real_sub hq).2)
    (fun q hq => ⟨(hB_real_f q hq).2.2.1, (hB_real_f q hq).2.2.2⟩)
    hp_real_mem (hB_real_id p_real hp_real_mem).2.1

  have hst_eq_on_B_reg : ∀ q ∈ B_reg,
      s_tilde (shift_c (-3 / 2 : ℂ) q) = L.𝔰 (shift_c (-3 / 2 : ℂ) q) ∧
      s_tilde (shift_c (-1 / 2 : ℂ) q) = L.𝔰 (shift_c (-1 / 2 : ℂ) q) ∧
      s_tilde (shift_c (1 / 2 : ℂ) q) = L.𝔰 (shift_c (1 / 2 : ℂ) q) ∧
      s_tilde (shift_c (3 / 2 : ℂ) q) = L.𝔰 (shift_c (3 / 2 : ℂ) q) := by
    intro q hq
    obtain ⟨⟨hqB, hqF⟩, hqt⟩ := hB_reg_sub hq
    rw [hBack_eq] at hqB
    exact ⟨hs_eq_η₂ _ hqB.1 hqt, hs_eq_η₂ _ hqB.2 hqt,
      hs_eq_η₂ _ hqF.1 hqt, hs_eq_η₂ _ hqF.2 hqt⟩

  have hQ_back_B_reg_pack := hQ_back_sl_reg Metric.isOpen_ball
    (fun _ hq => (hB_reg_sub_slice hq).1)
    (fun q hq => ⟨(hB_reg_f q hq).2.1, (hB_reg_f q hq).1⟩)
  obtain ⟨q₀_back, hq₀_back_mem, hD_q₀_back_sl⟩ := hQ_back_B_reg_pack.1 ⟨p_reg, hp_reg_ball⟩
  have hD_q₀_back_st :
      reflectDen (K.Γ (s_tilde (shift_c (-1 / 2 : ℂ) q₀_back)))
        (K.Γ (s_tilde (shift_c (-3 / 2 : ℂ) q₀_back)))
        (K.ϕ (s_tilde (shift_c (-1 / 2 : ℂ) q₀_back))) ≠ 0 := by
    rw [(hst_eq_on_B_reg q₀_back hq₀_back_mem).2.1, (hst_eq_on_B_reg q₀_back hq₀_back_mem).1]
    exact hD_q₀_back_sl

  have hQ_fwd_B_reg_pack := hQ_fwd_sl_reg Metric.isOpen_ball
    (fun _ hq => (hB_reg_sub_slice hq).2)
    (fun q hq => ⟨(hB_reg_f q hq).2.2.1, (hB_reg_f q hq).2.2.2⟩)
  obtain ⟨q₀_fwd, hq₀_fwd_mem, hD_q₀_fwd_sl⟩ := hQ_fwd_B_reg_pack.1 ⟨p_reg, hp_reg_ball⟩
  have hD_q₀_fwd_st :
      reflectDen (K.Γ (s_tilde (shift_c (1 / 2 : ℂ) q₀_fwd)))
        (K.Γ (s_tilde (shift_c (3 / 2 : ℂ) q₀_fwd)))
        (K.ϕ (s_tilde (shift_c (1 / 2 : ℂ) q₀_fwd))) ≠ 0 := by
    rw [(hst_eq_on_B_reg q₀_fwd hq₀_fwd_mem).2.2.1, (hst_eq_on_B_reg q₀_fwd hq₀_fwd_mem).2.2.2]
    exact hD_q₀_fwd_sl

  have hBack_maps_near : Set.MapsTo (shift_c (-1 / 2 : ℂ))
      (coneDomainBack H δ_star d x₀) (coneDomain H δ_star d x₀) := by
    intro p hp; rw [hBack_eq] at hp; exact hp.2
  have hBack_maps_far : Set.MapsTo (shift_c (-3 / 2 : ℂ))
      (coneDomainBack H δ_star d x₀) (coneDomain H δ_star d x₀) := by
    intro p hp; rw [hBack_eq] at hp; exact hp.1

  obtain ⟨L_back, hL_back_reg⟩ := h_mkReflectedMero hBack_open hBack_conv
    (fun p => s_tilde (shift_c (-1 / 2 : ℂ) p)) (fun p => s_tilde (shift_c (-3 / 2 : ℂ) p))
    (hs_holo.comp (hsh_diff _).differentiableOn hBack_maps_near)
    (hs_holo.comp (hsh_diff _).differentiableOn hBack_maps_far)
    (fun p hp => hs_maps _ (hBack_maps_near hp))
    (fun p hp => hs_maps _ (hBack_maps_far hp))
    ⟨p_reg, hp_reg_mem.1.1, p_alt, hp_alt_mem.1.1,
     by rw [(hsh_reg_eq _).1, (hsh_reg_eq _).2]; exact hst_ne⟩
    ⟨p_reg, hp_reg_mem.1.1, p_alt, hp_alt_mem.1.1,
     by rw [(hsh_reg_eq _).1, (hsh_reg_eq _).2]; exact hst_ne⟩
    (fun _ hq => (hB_reg_sub hq).1.1)
    (fun q hq => by
      rw [(hst_eq_on_B_reg q hq).2.1, (hst_eq_on_B_reg q hq).1]
      exact ⟨(hB_reg_f q hq).2.1, (hB_reg_f q hq).1⟩)
    hq₀_back_mem hD_q₀_back_st

  obtain ⟨L_fwd, hL_fwd_reg⟩ := h_mkReflectedMero hFwd_open hFwd_conv
    (fun p => s_tilde (shift_c (1 / 2 : ℂ) p)) (fun p => s_tilde (shift_c (3 / 2 : ℂ) p))
    (hs_holo.comp (hsh_diff _).differentiableOn (fun _ hp => hp.1))
    (hs_holo.comp (hsh_diff _).differentiableOn (fun _ hp => hp.2))
    (fun _ hp => hs_maps _ hp.1)
    (fun _ hp => hs_maps _ hp.2)
    ⟨p_reg, hp_reg_mem.1.2, p_alt, hp_alt_mem.1.2,
     by rw [(hsh_reg_eq _).1, (hsh_reg_eq _).2]; exact hst_ne⟩
    ⟨p_reg, hp_reg_mem.1.2, p_alt, hp_alt_mem.1.2,
     by rw [(hsh_reg_eq _).1, (hsh_reg_eq _).2]; exact hst_ne⟩
    (fun _ hq => (hB_reg_sub hq).1.2)
    (fun q hq => by
      rw [(hst_eq_on_B_reg q hq).2.2.1, (hst_eq_on_B_reg q hq).2.2.2]
      exact ⟨(hB_reg_f q hq).2.2.1, (hB_reg_f q hq).2.2.2⟩)
    hq₀_fwd_mem hD_q₀_fwd_st

  have hL_back_eq_sl_Breg : ∀ i : Fin 2, MeroEqOn (L_back i) (Q_back_sl i) B_reg := by
    intro i
    have hLb_pack := (hL_back_reg Metric.isOpen_ball (fun _ hq => (hB_reg_sub hq).1.1)
      (fun q hq => by
        rw [(hst_eq_on_B_reg q hq).2.1, (hst_eq_on_B_reg q hq).1]
        exact ⟨(hB_reg_f q hq).2.1, (hB_reg_f q hq).1⟩)).2
    refine h_meroEqOn_of_local (L_back i) (Q_back_sl i)
      (fun q hq => ⟨(hB_reg_sub hq).1.1, (hB_reg_sub_slice hq).1⟩) (fun p hp => ?_)
    obtain ⟨r₁, hr₁, _, _, hsub₁, heq₁⟩ := hLb_pack p hp
    obtain ⟨r₂, hr₂, _, _, _, heq₂⟩ := hQ_back_B_reg_pack.2 p hp
    refine ⟨min r₁ r₂, lt_min hr₁ hr₂, fun q hq => ?_⟩
    have hq₁ : q ∈ Metric.ball p r₁ := Metric.ball_subset_ball (min_le_left _ _) hq
    have hq₂ : q ∈ Metric.ball p r₂ := Metric.ball_subset_ball (min_le_right _ _) hq
    have hq_reg : q ∈ B_reg := hsub₁ hq₁
    obtain ⟨hN₁, hD₁⟩ := heq₁ q hq₁ i
    obtain ⟨hN₂, hD₂⟩ := heq₂ q hq₂ i
    rw [hN₁, hD₁, hN₂, hD₂, (hst_eq_on_B_reg q hq_reg).2.1, (hst_eq_on_B_reg q hq_reg).1]

  have hL_fwd_eq_sl_Breg : ∀ i : Fin 2, MeroEqOn (L_fwd i) (Q_fwd_sl i) B_reg := by
    intro i
    have hLf_pack := (hL_fwd_reg Metric.isOpen_ball (fun _ hq => (hB_reg_sub hq).1.2)
      (fun q hq => by
        rw [(hst_eq_on_B_reg q hq).2.2.1, (hst_eq_on_B_reg q hq).2.2.2]
        exact ⟨(hB_reg_f q hq).2.2.1, (hB_reg_f q hq).2.2.2⟩)).2
    refine h_meroEqOn_of_local (L_fwd i) (Q_fwd_sl i)
      (fun q hq => ⟨(hB_reg_sub hq).1.2, (hB_reg_sub_slice hq).2⟩) (fun p hp => ?_)
    obtain ⟨r₁, hr₁, _, _, hsub₁, heq₁⟩ := hLf_pack p hp
    obtain ⟨r₂, hr₂, _, _, _, heq₂⟩ := hQ_fwd_B_reg_pack.2 p hp
    refine ⟨min r₁ r₂, lt_min hr₁ hr₂, fun q hq => ?_⟩
    have hq₁ : q ∈ Metric.ball p r₁ := Metric.ball_subset_ball (min_le_left _ _) hq
    have hq₂ : q ∈ Metric.ball p r₂ := Metric.ball_subset_ball (min_le_right _ _) hq
    have hq_reg : q ∈ B_reg := hsub₁ hq₁
    obtain ⟨hN₁, hD₁⟩ := heq₁ q hq₁ i
    obtain ⟨hN₂, hD₂⟩ := heq₂ q hq₂ i
    rw [hN₁, hD₁, hN₂, hD₂, (hst_eq_on_B_reg q hq_reg).2.2.1, (hst_eq_on_B_reg q hq_reg).2.2.2]

  have hQ_back_B_real_pack := (hQ_back_sl_reg Metric.isOpen_ball
    (fun _ hq => (hB_real_sub hq).1)
    (fun q hq => ⟨(hB_real_f q hq).2.1, (hB_real_f q hq).1⟩)).2
  have hQ_fwd_B_real_pack := (hQ_fwd_sl_reg Metric.isOpen_ball
    (fun _ hq => (hB_real_sub hq).2)
    (fun q hq => ⟨(hB_real_f q hq).2.2.1, (hB_real_f q hq).2.2.2⟩)).2

  have hQ_back_eq_fwd_Breal : ∀ i : Fin 2, MeroEqOn (Q_back_sl i) (Q_fwd_sl i) B_real := by
    intro i
    refine h_meroEqOn_of_local (Q_back_sl i) (Q_fwd_sl i) hB_real_sub (fun p hp => ?_)
    obtain ⟨r₁, hr₁, _, _, hsub₁, heq₁⟩ := hQ_back_B_real_pack p hp
    obtain ⟨r₂, hr₂, _, _, _, heq₂⟩ := hQ_fwd_B_real_pack p hp
    refine ⟨min r₁ r₂, lt_min hr₁ hr₂, fun q hq => ?_⟩
    have hq₁ : q ∈ Metric.ball p r₁ := Metric.ball_subset_ball (min_le_left _ _) hq
    have hq₂ : q ∈ Metric.ball p r₂ := Metric.ball_subset_ball (min_le_right _ _) hq
    have hq_real : q ∈ B_real := hsub₁ hq₁
    obtain ⟨hN₁, hD₁⟩ := heq₁ q hq₁ i
    obtain ⟨hN₂, hD₂⟩ := heq₂ q hq₂ i
    obtain ⟨_, _, hid⟩ := hB_real_id q hq_real
    rw [hN₁, hD₁, hN₂, hD₂, (hid i).1, (hid i).2]
    ring

  have h_back_eq_fwd : ∀ i : Fin 2,
      MeroEqOn (L_back i) (L_fwd i)
        (coneDomainBack H δ_star d x₀ ∩ coneDomainFwd H δ_star d x₀) := by
    intro i
    have hQ_slices : MeroEqOn (Q_back_sl i) (Q_fwd_sl i) (sliceBack ∩ sliceFwd) :=
      h_meroEqOn_propagate (hSliceBack_open.inter hSliceFwd_open)
        (hSliceBack_conv.inter hSliceFwd_conv).isPreconnected
        (fun _ hp => hp) Metric.isOpen_ball ⟨p_real, hp_real_mem⟩ hB_real_sub
        (hQ_back_eq_fwd_Breal i)
    have hQ_Breg : MeroEqOn (Q_back_sl i) (Q_fwd_sl i) B_reg :=
      h_meroEqOn_mono hB_reg_sub_slice hQ_slices
    have hL_Breg : MeroEqOn (L_back i) (L_fwd i) B_reg :=
      h_meroEqOn_trans (h_meroEqOn_trans (hL_back_eq_sl_Breg i) hQ_Breg)
        (h_meroEqOn_symm (hL_fwd_eq_sl_Breg i))
    exact h_meroEqOn_propagate (hBack_open.inter hFwd_open)
      (hBack_conv.inter hFwd_conv).isPreconnected
      (fun _ hp => hp) Metric.isOpen_ball ⟨p_reg, hp_reg_ball⟩
      (fun _ hq => (hB_reg_sub hq).1) hL_Breg

  let S_shift : ℂ × ℂ → ℂ × ℂ := fun p => (p.1 - L.b_shift p.2, p.2)
  let S_unshift : ℂ × ℂ → ℂ × ℂ := fun q => (q.1 + L.b_shift q.2, q.2)
  let O_rbase : Set (ℂ × ℂ) := { q : ℂ × ℂ | ‖q.2‖ < M.r_base }
  have hO_rbase_open : IsOpen O_rbase :=
    isOpen_lt (continuous_norm.comp continuous_snd) continuous_const
  have hS_shift_holo : DifferentiableOn ℂ S_shift O_rbase := by
    have hb2 : DifferentiableOn ℂ (fun p : ℂ × ℂ => L.b_shift p.2) O_rbase :=
      L.b_shift_holo.comp differentiable_snd.differentiableOn
        (fun p hp => by rw [Metric.mem_ball, dist_zero_right]; exact hp)
    exact (differentiable_fst.differentiableOn.sub hb2).prodMk differentiable_snd.differentiableOn
  have hS_unshift_cont : ContinuousOn S_unshift O_rbase := by
    have hb2 : DifferentiableOn ℂ (fun q : ℂ × ℂ => L.b_shift q.2) O_rbase :=
      L.b_shift_holo.comp differentiable_snd.differentiableOn
        (fun q hq => by rw [Metric.mem_ball, dist_zero_right]; exact hq)
    exact ((differentiable_fst.differentiableOn.add hb2).prodMk differentiable_snd.differentiableOn).continuousOn

  have hSliceBack_maps_WL : Set.MapsTo S_shift sliceBack (meroTubeENNR M.r_base M.h_L) := by
    intro p ⟨_, hp_m1⟩
    obtain ⟨hp_lo, hp_hi, hpt⟩ := hp_m1
    have hpt_r : ‖p.2‖ < M.r_base := by linarith [L.r_star_pos]
    have hpt_ball : p.2 ∈ Metric.ball (0 : ℂ) M.r_base := by
      rw [Metric.mem_ball, dist_zero_right]; exact hpt_r
    have hpt_conj_ball : starRingEnd ℂ p.2 ∈ Metric.ball (0 : ℂ) M.r_base := by
      rw [Metric.mem_ball, dist_zero_right, RCLike.norm_conj]; exact hpt_r
    have hb_bd := h_bshift_η₂ p.2 hpt
    have hb_im : |(L.b_shift p.2).im| ≤ ‖L.b_shift p.2‖ := Complex.abs_im_le_norm _
    have hb_d : ‖L.b_shift p.2‖ < d / 80 := lt_of_lt_of_le hb_bd (min_le_left _ _)
    have hb_s : ‖L.b_shift p.2‖ < L.s_star / 8 := lt_of_lt_of_le hb_bd (min_le_right _ _)
    have hhalf_im : |((-1 / 2 : ℂ) * p.2).im| ≤ η₂ / 2 := by
      calc |((-1 / 2 : ℂ) * p.2).im| ≤ ‖(-1 / 2 : ℂ) * p.2‖ := Complex.abs_im_le_norm _
        _ = (1 / 2) * ‖p.2‖ := by rw [norm_mul]; norm_num
        _ ≤ η₂ / 2 := by linarith
    have h_decomp : (p.1 - L.b_shift p.2).im =
        (shift_c (-1 / 2 : ℂ) p).1.im - ((-1 / 2 : ℂ) * p.2).im - (L.b_shift p.2).im := by
      simp [shift_c]
    refine ⟨hpt_r, ?_, ?_⟩
    · have h_neg : -(p.1 - L.b_shift p.2).im < M.s_base := by
        have := (abs_le.mp hb_im).1
        have := (abs_le.mp hb_im).2
        have := (abs_le.mp hhalf_im).1
        have := (abs_le.mp hhalf_im).2
        rw [h_decomp]; linarith
      have h1 : ENNReal.ofReal (-(p.1 - L.b_shift p.2).im) < M.h_X (starRingEnd ℂ p.2) :=
        lt_of_lt_of_le ((ENNReal.ofReal_lt_ofReal_iff M.s_base_pos).mpr h_neg) (M.h_X_ge _ hpt_conj_ball)
      rw [M.h_L_eq _ hpt_conj_ball]
      exact lt_of_lt_of_le h1 le_self_add
    · have h_pos : (p.1 - L.b_shift p.2).im ≤ H - d / 20 := by
        have := (abs_le.mp hb_im).1
        have := (abs_le.mp hb_im).2
        have := (abs_le.mp hhalf_im).1
        have := (abs_le.mp hhalf_im).2
        rw [h_decomp]; linarith
      have h1 : ENNReal.ofReal (p.1 - L.b_shift p.2).im < M.h_X p.2 :=
        lt_of_le_of_lt (ENNReal.ofReal_le_ofReal h_pos) (h_lsc_η₂ p.2 hpt)
      rw [M.h_L_eq _ hpt_ball]
      exact lt_of_lt_of_le h1 le_self_add

  have hSliceBack_sub_Or : sliceBack ⊆ O_rbase := fun p hp => (hSliceBack_maps_WL hp).1

  have h_pull_rad : ∀ (i : Fin 2) (p : ℂ × ℂ),
      ∃ r : ℝ, p ∈ sliceBack →
        0 < r ∧ Metric.ball p r ⊆ sliceBack ∧
        Set.MapsTo S_shift (Metric.ball p r)
          (Metric.ball (S_shift p) ((M.L_mero i).rad (S_shift p))) := by
    intro i p
    by_cases hp : p ∈ sliceBack
    · have hΦp : S_shift p ∈ meroTubeENNR M.r_base M.h_L := hSliceBack_maps_WL hp
      have hrad_pos : 0 < (M.L_mero i).rad (S_shift p) := (M.L_mero i).rad_pos _ hΦp
      have hΦ_cont : ContinuousAt S_shift p :=
        (hS_shift_holo.mono hSliceBack_sub_Or).continuousOn.continuousAt (hSliceBack_open.mem_nhds hp)
      have h_nhds : sliceBack ∩
          S_shift ⁻¹' Metric.ball (S_shift p) ((M.L_mero i).rad (S_shift p)) ∈ nhds p :=
        Filter.inter_mem (hSliceBack_open.mem_nhds hp)
          (hΦ_cont.preimage_mem_nhds (Metric.ball_mem_nhds _ hrad_pos))
      obtain ⟨r, hr, hball⟩ := Metric.mem_nhds_iff.mp h_nhds
      exact ⟨r, fun _ => ⟨hr, fun q hq => (hball hq).1, fun q hq => (hball hq).2⟩⟩
    · exact ⟨1, fun h => absurd h hp⟩
  choose rad_pull h_rad_pull using h_pull_rad

  let L_mero_sl : Fin 2 → MeroOn2D sliceBack := fun i => {
    rad := rad_pull i
    num := fun p q => (M.L_mero i).num (S_shift p) (S_shift q)
    den := fun p q => (M.L_mero i).den (S_shift p) (S_shift q)
    rad_pos := fun p hp => (h_rad_pull i p hp).1
    ball_sub := fun p hp => (h_rad_pull i p hp).2.1
    num_holo := fun p hp =>
      ((M.L_mero i).num_holo _ (hSliceBack_maps_WL hp)).comp
        (hS_shift_holo.mono (Set.Subset.trans (h_rad_pull i p hp).2.1 hSliceBack_sub_Or))
        (h_rad_pull i p hp).2.2
    den_holo := fun p hp =>
      ((M.L_mero i).den_holo _ (hSliceBack_maps_WL hp)).comp
        (hS_shift_holo.mono (Set.Subset.trans (h_rad_pull i p hp).2.1 hSliceBack_sub_Or))
        (h_rad_pull i p hp).2.2
    den_ne_zero := by
      intro p hp
      obtain ⟨hr_p, _, _⟩ := h_rad_pull i p hp
      have hΦp : S_shift p ∈ meroTubeENNR M.r_base M.h_L := hSliceBack_maps_WL hp
      have hΨ_cont : ContinuousAt S_unshift (S_shift p) :=
        hS_unshift_cont.continuousAt (hO_rbase_open.mem_nhds hΦp.1)
      have hΨΦ : S_unshift (S_shift p) = p := by ext <;> simp [S_shift, S_unshift]
      have h_nhds : S_unshift ⁻¹' Metric.ball p (rad_pull i p) ∩
          Metric.ball (S_shift p) ((M.L_mero i).rad (S_shift p)) ∈ nhds (S_shift p) :=
        Filter.inter_mem
          (hΨ_cont.preimage_mem_nhds (by rw [hΨΦ]; exact Metric.ball_mem_nhds p hr_p))
          (Metric.ball_mem_nhds _ ((M.L_mero i).rad_pos _ hΦp))
      obtain ⟨ε, hε, hball_ε⟩ := Metric.mem_nhds_iff.mp h_nhds
      obtain ⟨y_st, hy_st_ball, hy_st_nz⟩ := h_exists_nz Metric.isOpen_ball
        (convex_ball (S_shift p) ((M.L_mero i).rad (S_shift p))).isPreconnected
        ((M.L_mero i).den_holo _ hΦp) ((M.L_mero i).den_ne_zero _ hΦp)
        Metric.isOpen_ball ⟨S_shift p, Metric.mem_ball_self hε⟩
        (fun z hz => (hball_ε hz).2)
      have hΦΨ : S_shift (S_unshift y_st) = y_st := by ext <;> simp [S_shift, S_unshift]
      refine ⟨S_unshift y_st, (hball_ε hy_st_ball).1, ?_⟩
      rwa [hΦΨ]
    compat := by
      intro p₁ hp₁ p₂ hp₂ q hq
      exact (M.L_mero i).compat (S_shift p₁) (hSliceBack_maps_WL hp₁)
        (S_shift p₂) (hSliceBack_maps_WL hp₂) (S_shift q)
        ⟨(h_rad_pull i p₁ hp₁).2.2 hq.1, (h_rad_pull i p₂ hp₂).2.2 hq.2⟩
  }

  have hQ_eq_Lmero_Breal : ∀ i : Fin 2, MeroEqOn (Q_back_sl i) (L_mero_sl i) B_real := by
    intro i
    refine h_meroEqOn_of_local (Q_back_sl i) (L_mero_sl i)
      (fun q hq => ⟨(hB_real_sub hq).1, (hB_real_sub hq).1⟩) (fun p hp => ?_)
    obtain ⟨r₁, hr₁, _, _, hsub₁, heq₁⟩ := hQ_back_B_real_pack p hp
    have hΦp_base := hB_real_maps_base hp
    obtain ⟨r_L, hr_L, _, _, heq_L⟩ := (M.L_agrees i).2 (S_shift p) hΦp_base
    have hΦ_cont : ContinuousAt S_shift p :=
      (hS_shift_holo.mono hSliceBack_sub_Or).continuousOn.continuousAt
        (hSliceBack_open.mem_nhds (hB_real_sub hp).1)
    obtain ⟨r₂, hr₂, hball₂⟩ := Metric.mem_nhds_iff.mp
      (hΦ_cont.preimage_mem_nhds (Metric.ball_mem_nhds (S_shift p) hr_L))
    refine ⟨min r₁ r₂, lt_min hr₁ hr₂, fun q hq => ?_⟩
    have hq₁ : q ∈ Metric.ball p r₁ := Metric.ball_subset_ball (min_le_left _ _) hq
    have hq₂ : q ∈ Metric.ball p r₂ := Metric.ball_subset_ball (min_le_right _ _) hq
    have hq_real : q ∈ B_real := hsub₁ hq₁
    obtain ⟨hN₁, hD₁⟩ := heq₁ q hq₁ i
    have hL_q := heq_L (S_shift q) (hball₂ hq₂)
    obtain ⟨_, _, hid⟩ := hB_real_id q hq_real
    dsimp only [L_mero_sl]
    rw [hN₁, hD₁, hL_q, (hid i).1]
    dsimp only [S_shift]
    ring

  have h_back_eq_mero : ∀ i : Fin 2,
      MeroEqOnPullback (L_back i) (M.L_mero i) S_shift
        (coneDomainBack H δ_star d x₀ ∩ { p : ℂ × ℂ | ‖p.2‖ < η₂ }) := by
    intro i
    let U_back := coneDomainBack H δ_star d x₀ ∩ { p : ℂ × ℂ | ‖p.2‖ < η₂ }
    have hU_back_open : IsOpen U_back :=
      hBack_open.inter (isOpen_lt (continuous_norm.comp continuous_snd) continuous_const)
    have hU_back_conv : Convex ℝ U_back := by
      refine hBack_conv.inter (fun p hp q hq a b ha hb hab => ?_)
      have hnorm : ‖(a • p + b • q).2‖ ≤ a * ‖p.2‖ + b * ‖q.2‖ := by
        calc ‖a • p.2 + b • q.2‖ ≤ ‖a • p.2‖ + ‖b • q.2‖ := norm_add_le _ _
          _ = a * ‖p.2‖ + b * ‖q.2‖ := by
              rw [norm_smul, norm_smul, Real.norm_of_nonneg ha, Real.norm_of_nonneg hb]
      exact lt_of_le_of_lt hnorm (h_conv_lt_right ha hb hab hp hq)
    have hQ_eq_sl : MeroEqOn (Q_back_sl i) (L_mero_sl i) sliceBack :=
      h_meroEqOn_propagate hSliceBack_open hSliceBack_conv.isPreconnected
        (fun _ hp => ⟨hp, hp⟩) Metric.isOpen_ball ⟨p_real, hp_real_mem⟩
        (fun _ hq => (hB_real_sub hq).1) (hQ_eq_Lmero_Breal i)
    have hLb_eq_Q : MeroEqOn (L_back i) (Q_back_sl i) U_back :=
      h_meroEqOn_propagate hU_back_open hU_back_conv.isPreconnected
        (fun p hp => ⟨hp.1, hBack_η₂_sub hp⟩) Metric.isOpen_ball ⟨p_reg, hp_reg_ball⟩
        (fun q hq => ⟨(hB_reg_sub hq).1.1, (hB_reg_sub hq).2⟩) (hL_back_eq_sl_Breg i)
    have hLb_eq_Lm : MeroEqOn (L_back i) (L_mero_sl i) U_back :=
      h_meroEqOn_trans hLb_eq_Q (h_meroEqOn_mono hBack_η₂_sub hQ_eq_sl)
    refine ⟨Set.inter_subset_left, hSliceBack_maps_WL.mono_left hBack_η₂_sub, fun p hp => ?_⟩
    have hp_sl : p ∈ sliceBack := hBack_η₂_sub hp
    let r := min ((L_back i).rad p) ((L_mero_sl i).rad p)
    have hr : 0 < r := lt_min ((L_back i).rad_pos p hp.1) ((L_mero_sl i).rad_pos p hp_sl)
    refine ⟨r, hr, min_le_left _ _,
      (h_rad_pull i p hp_sl).2.2.mono_left (Metric.ball_subset_ball (min_le_right _ _)),
      fun q hq => hLb_eq_Lm.2 p hp q hq⟩

  exact ⟨{
    L_back := L_back
    L_fwd := L_fwd
    back_eq_fwd := h_back_eq_fwd
    η₂ := η₂
    η₂_pos := hη₂_pos
    η₂_le := by linarith
    back_eq_mero := h_back_eq_mero
  }⟩

theorem quadratic_disk_cone_wall_contradiction (Ω : Set Plane)
    (C : AnalyticGlancingCollar Ω)
    (M : MeromorphicCollarData C)
    (K : NonisotropicCurveData C M)
    (L : NormalizedGlobalLiftData C M K)
    (H δ_star : ℝ)
    (hH : M.h_X 0 = ENNReal.ofReal H)
    (hδ0 : 0 < δ_star)
    (hδH : δ_star < H - L.s_star) :
    ∃ d₀ : ℝ, 0 < d₀ ∧ ∀ d x₀ : ℝ, 0 < d → d < d₀ →
      IsEmpty (ShiftedConeDualLines C M L H δ_star d x₀) :=
by
  
  have hTK : QdMero2DPullbackGluingToolkit := by
    clear Ω C M K L H δ_star hH hδ0 hδH
    have eqOn_zero_of_ball_2D :
        ∀ {p₂ p₁ : ℂ × ℂ} {R r₁ : ℝ} {f : ℂ × ℂ → ℂ},
          p₁ ∈ Metric.ball p₂ R → 0 < r₁ →
          DifferentiableOn ℂ f (Metric.ball p₂ R) →
          (∀ q ∈ Metric.ball p₁ r₁, f q = 0) →
          ∀ q ∈ Metric.ball p₂ R, f q = 0 := by
      intro p₂ p₁ R r₁ f hp₁ hr₁ hf h0 q hq
      let γ : ℂ → ℂ × ℂ := fun z => p₁ + z • (q - p₁)
      have hγ_diff : Differentiable ℂ γ :=
        (differentiable_id.smul_const (q - p₁)).const_add p₁
      let Ω_z : Set ℂ := γ ⁻¹' Metric.ball p₂ R
      have hΩ_open : IsOpen Ω_z := Metric.isOpen_ball.preimage hγ_diff.continuous
      have h0_mem : (0 : ℂ) ∈ Ω_z := by
        show p₁ + (0 : ℂ) • (q - p₁) ∈ Metric.ball p₂ R
        simpa using hp₁
      have h1_mem : (1 : ℂ) ∈ Ω_z := by
        show p₁ + (1 : ℂ) • (q - p₁) ∈ Metric.ball p₂ R
        simpa using hq
      have hΩ_conv : Convex ℝ Ω_z := by
        intro z₁ hz₁ z₂ hz₂ a b ha hb hab
        show γ (a • z₁ + b • z₂) ∈ Metric.ball p₂ R
        have h_aff : γ (a • z₁ + b • z₂) = a • γ z₁ + b • γ z₂ := by
          dsimp [γ]
          have habC : (a : ℂ) + (b : ℂ) = 1 := by exact_mod_cast hab
          ext
          · simp [Complex.real_smul]; linear_combination -(p₁.1) * habC
          · simp [Complex.real_smul]; linear_combination -(p₁.2) * habC
        rw [h_aff]
        exact (convex_ball p₂ R) hz₁ hz₂ ha hb hab
      have hfg_diff : DifferentiableOn ℂ (f ∘ γ) Ω_z :=
        hf.comp hγ_diff.differentiableOn (fun _ hz => hz)
      have hfg_ana : AnalyticOnNhd ℂ (f ∘ γ) Ω_z := hfg_diff.analyticOnNhd hΩ_open
      have h_ev : f ∘ γ =ᶠ[nhds (0 : ℂ)] 0 := by
        have h_nhds : γ ⁻¹' Metric.ball p₁ r₁ ∈ nhds (0 : ℂ) := by
          apply hγ_diff.continuous.continuousAt.preimage_mem_nhds
          apply Metric.isOpen_ball.mem_nhds
          show p₁ + (0 : ℂ) • (q - p₁) ∈ Metric.ball p₁ r₁
          rw [zero_smul, add_zero]
          exact Metric.mem_ball_self hr₁
        exact Filter.eventually_of_mem h_nhds (fun z hz => h0 (γ z) hz)
      have h_eq := hfg_ana.eqOn_zero_of_preconnected_of_eventuallyEq_zero
        hΩ_conv.isPreconnected h0_mem h_ev h1_mem
      simpa [γ] using h_eq
    have eqOn_zero_of_preconnected_2D :
        ∀ {W V : Set (ℂ × ℂ)} {f : ℂ × ℂ → ℂ},
          IsOpen W → IsPreconnected W → DifferentiableOn ℂ f W →
          IsOpen V → V.Nonempty → V ⊆ W →
          (∀ p ∈ V, f p = 0) → ∀ p ∈ W, f p = 0 := by
      intro W V f hW_open hW_pre hf hV_open ⟨v₀, hv₀⟩ hVW hV0
      let S : Set (ℂ × ℂ) :=
        { p ∈ W | ∃ r : ℝ, 0 < r ∧ Metric.ball p r ⊆ W ∧ ∀ q ∈ Metric.ball p r, f q = 0 }
      have hS_open : IsOpen S := by
        rw [Metric.isOpen_iff]
        rintro p ⟨_, r, hr, hsub, hzero⟩
        refine ⟨r, hr, fun p' hp' => ?_⟩
        have hr' : 0 < r - dist p' p := sub_pos.mpr hp'
        have hsub' : Metric.ball p' (r - dist p' p) ⊆ Metric.ball p r := by
          intro q hq
          rw [Metric.mem_ball] at hq hp' ⊢
          linarith [dist_triangle q p' p]
        exact ⟨hsub hp', r - dist p' p, hr', Subset.trans hsub' hsub,
          fun q hq => hzero q (hsub' hq)⟩
      have hWS_ne : (W ∩ S).Nonempty := by
        obtain ⟨r, hr, hsub⟩ := Metric.isOpen_iff.mp hV_open v₀ hv₀
        exact ⟨v₀, hVW hv₀, hVW hv₀, r, hr, Subset.trans hsub hVW, fun q hq => hV0 q (hsub hq)⟩
      have h_cl : closure S ∩ W ⊆ S := by
        rintro p₂ ⟨hp₂_cl, hp₂_W⟩
        obtain ⟨R, hR, hR_sub⟩ := Metric.isOpen_iff.mp hW_open p₂ hp₂_W
        obtain ⟨p₁, ⟨_, r₁, hr₁, _, hzero₁⟩, hp₁_dist⟩ :=
          Metric.mem_closure_iff.mp hp₂_cl R hR
        have hp₁_ball : p₁ ∈ Metric.ball p₂ R := by
          rwa [Metric.mem_ball, dist_comm]
        exact ⟨hp₂_W, R, hR, hR_sub,
          eqOn_zero_of_ball_2D hp₁_ball hr₁ (hf.mono hR_sub) hzero₁⟩
      have hW_sub := hW_pre.subset_of_closure_inter_subset hS_open hWS_ne h_cl
      intro p hp
      obtain ⟨_, r, hr, _, hzero⟩ := hW_sub hp
      exact hzero p (Metric.mem_ball_self hr)
    have exists_ne_zero_on_subopen :
        ∀ {B V : Set (ℂ × ℂ)} {g : ℂ × ℂ → ℂ},
          IsOpen B → IsPreconnected B → DifferentiableOn ℂ g B →
          (∃ q₀ ∈ B, g q₀ ≠ 0) →
          IsOpen V → V.Nonempty → V ⊆ B →
          ∃ (q₁ : ℂ × ℂ) (δ : ℝ), 0 < δ ∧ Metric.ball q₁ δ ⊆ V ∧
            ∀ q ∈ Metric.ball q₁ δ, g q ≠ 0 := by
      intro B V g hB_open hB_pre hg ⟨q₀, hq₀B, hq₀_ne⟩ hV_open hV_ne hVB
      have h_not_all_zero : ¬ ∀ q ∈ V, g q = 0 := by
        intro hall
        exact hq₀_ne (eqOn_zero_of_preconnected_2D hB_open hB_pre hg hV_open hV_ne hVB hall q₀ hq₀B)
      obtain ⟨q₁, hq₁⟩ := not_forall.mp h_not_all_zero
      obtain ⟨hq₁V, hq₁_ne⟩ := not_imp.mp hq₁
      have hg_cont : ContinuousAt g q₁ :=
        (hg.continuousOn.continuousAt (hB_open.mem_nhds (hVB hq₁V)))
      have h_ev : ∀ᶠ q in nhds q₁, q ∈ V ∧ g q ≠ 0 :=
        Filter.Eventually.and (hV_open.mem_nhds hq₁V) (hg_cont.eventually_ne hq₁_ne)
      obtain ⟨δ, hδ_pos, hδ⟩ := Metric.eventually_nhds_iff.mp h_ev
      exact ⟨q₁, δ, hδ_pos, fun q hq => (hδ hq).1, fun q hq => (hδ hq).2⟩
    have meroEqOn_of_local :
        ∀ {W₁ W₂ U : Set (ℂ × ℂ)} {F₁ : MeroOn2D W₁} {F₂ : MeroOn2D W₂},
          U ⊆ W₁ ∩ W₂ →
          (∀ p ∈ U, ∃ V_p : Set (ℂ × ℂ), IsOpen V_p ∧ V_p.Nonempty ∧
            V_p ⊆ Metric.ball p (min (F₁.rad p) (F₂.rad p)) ∧
            ∀ q ∈ V_p, F₁.num p q * F₂.den p q = F₂.num p q * F₁.den p q) →
          MeroEqOn F₁ F₂ U := by
      intro W₁ W₂ U F₁ F₂ hU hloc
      refine ⟨hU, fun p hp q hq => ?_⟩
      obtain ⟨hp₁, hp₂⟩ := hU hp
      obtain ⟨V_p, hVp_open, hVp_ne, hVp_sub, hVp_eq⟩ := hloc p hp
      let r := min (F₁.rad p) (F₂.rad p)
      have hf_holo : DifferentiableOn ℂ
          (fun z => F₁.num p z * F₂.den p z - F₂.num p z * F₁.den p z) (Metric.ball p r) :=
        ((F₁.num_holo p hp₁).mono (Metric.ball_subset_ball (min_le_left _ _)) |>.mul
          ((F₂.den_holo p hp₂).mono (Metric.ball_subset_ball (min_le_right _ _)))).sub
        (((F₂.num_holo p hp₂).mono (Metric.ball_subset_ball (min_le_right _ _))).mul
          ((F₁.den_holo p hp₁).mono (Metric.ball_subset_ball (min_le_left _ _))))
      have hzero := eqOn_zero_of_preconnected_2D Metric.isOpen_ball (convex_ball p r).isPreconnected
        hf_holo hVp_open hVp_ne hVp_sub (fun z hz => sub_eq_zero.mpr (hVp_eq z hz)) q hq
      exact sub_eq_zero.mp hzero
    have h_eq_symm : ∀ {W₁ W₂ : Set (ℂ × ℂ)} {F₁ : MeroOn2D W₁} {F₂ : MeroOn2D W₂}
        {U : Set (ℂ × ℂ)}, MeroEqOn F₁ F₂ U → MeroEqOn F₂ F₁ U := by
      intro W₁ W₂ F₁ F₂ U ⟨hU, heq⟩
      refine ⟨fun p hp => ⟨(hU hp).2, (hU hp).1⟩, fun p hp q hq => ?_⟩
      rw [min_comm] at hq
      exact (heq p hp q hq).symm
    have h_eq_trans : ∀ {W₁ W₂ W₃ : Set (ℂ × ℂ)} {F₁ : MeroOn2D W₁} {F₂ : MeroOn2D W₂}
        {F₃ : MeroOn2D W₃} {U : Set (ℂ × ℂ)},
        MeroEqOn F₁ F₂ U → MeroEqOn F₂ F₃ U → MeroEqOn F₁ F₃ U := by
      intro W₁ W₂ W₃ F₁ F₂ F₃ U ⟨hU12, heq12⟩ ⟨hU23, heq23⟩
      apply meroEqOn_of_local (fun p hp => ⟨(hU12 hp).1, (hU23 hp).2⟩)
      intro p hp
      have hp1 : p ∈ W₁ := (hU12 hp).1
      have hp2 : p ∈ W₂ := (hU12 hp).2
      have hp3 : p ∈ W₃ := (hU23 hp).2
      let r := min (min (F₁.rad p) (F₃.rad p)) (F₂.rad p)
      have hr_pos : 0 < r :=
        lt_min (lt_min (F₁.rad_pos p hp1) (F₃.rad_pos p hp3)) (F₂.rad_pos p hp2)
      obtain ⟨q₁, δ, hδ_pos, hδ_sub, hδ_ne⟩ :=
        exists_ne_zero_on_subopen Metric.isOpen_ball (convex_ball p (F₂.rad p)).isPreconnected
          (F₂.den_holo p hp2) (F₂.den_ne_zero p hp2)
          Metric.isOpen_ball ⟨p, Metric.mem_ball_self hr_pos⟩
          (Metric.ball_subset_ball (min_le_right _ _))
      refine ⟨Metric.ball q₁ δ, Metric.isOpen_ball, ⟨q₁, Metric.mem_ball_self hδ_pos⟩,
        Subset.trans hδ_sub (Metric.ball_subset_ball (min_le_left _ _)), fun q hq => ?_⟩
      have hq_r : q ∈ Metric.ball p r := hδ_sub hq
      have h12 : F₁.num p q * F₂.den p q = F₂.num p q * F₁.den p q :=
        heq12 p hp q (Metric.ball_subset_ball
          (le_min (le_trans (min_le_left _ _) (min_le_left _ _)) (min_le_right _ _)) hq_r)
      have h23 : F₂.num p q * F₃.den p q = F₃.num p q * F₂.den p q :=
        heq23 p hp q (Metric.ball_subset_ball
          (le_min (min_le_right _ _) (le_trans (min_le_left _ _) (min_le_right _ _))) hq_r)
      apply mul_right_cancel₀ (hδ_ne q hq)
      calc (F₁.num p q * F₃.den p q) * F₂.den p q
          = (F₁.num p q * F₂.den p q) * F₃.den p q := by ring
        _ = (F₂.num p q * F₁.den p q) * F₃.den p q := by rw [h12]
        _ = (F₂.num p q * F₃.den p q) * F₁.den p q := by ring
        _ = (F₃.num p q * F₂.den p q) * F₁.den p q := by rw [h23]
        _ = (F₃.num p q * F₁.den p q) * F₂.den p q := by ring
    have h_eq_pre : ∀ {W₁ W₂ U V : Set (ℂ × ℂ)} {F₁ : MeroOn2D W₁} {F₂ : MeroOn2D W₂},
        IsOpen U → IsPreconnected U → U ⊆ W₁ ∩ W₂ →
        IsOpen V → V.Nonempty → V ⊆ U →
        MeroEqOn F₁ F₂ V → MeroEqOn F₁ F₂ U := by
      intro W₁ W₂ U V F₁ F₂ hU_open hU_pre hU_sub hV_open ⟨v₀, hv₀⟩ hVU ⟨_, hV_eq⟩
      have h_step : ∀ {p₁ p₂ : ℂ × ℂ}, p₁ ∈ W₁ ∩ W₂ → p₂ ∈ W₁ ∩ W₂ →
          (∀ q ∈ Metric.ball p₁ (min (F₁.rad p₁) (F₂.rad p₁)),
            F₁.num p₁ q * F₂.den p₁ q = F₂.num p₁ q * F₁.den p₁ q) →
          (Metric.ball p₁ (min (F₁.rad p₁) (F₂.rad p₁)) ∩
            Metric.ball p₂ (min (F₁.rad p₂) (F₂.rad p₂))).Nonempty →
          ∀ q ∈ Metric.ball p₂ (min (F₁.rad p₂) (F₂.rad p₂)),
            F₁.num p₂ q * F₂.den p₂ q = F₂.num p₂ q * F₁.den p₂ q := by
        intro p₁ p₂ ⟨hp₁1, hp₁2⟩ ⟨hp₂1, hp₂2⟩ heq₁ h_inter_ne
        let B₁ := Metric.ball p₁ (min (F₁.rad p₁) (F₂.rad p₁))
        let B₂ := Metric.ball p₂ (min (F₁.rad p₂) (F₂.rad p₂))
        obtain ⟨q_a, δ_a, hδ_a, hsub_a, hne_a⟩ :=
          exists_ne_zero_on_subopen Metric.isOpen_ball (convex_ball p₁ (F₁.rad p₁)).isPreconnected
            (F₁.den_holo p₁ hp₁1) (F₁.den_ne_zero p₁ hp₁1)
            (Metric.isOpen_ball.inter Metric.isOpen_ball) h_inter_ne
            (Subset.trans Set.inter_subset_left (Metric.ball_subset_ball (min_le_left _ _)))
        obtain ⟨q_b, δ_b, hδ_b, hsub_b, hne_b⟩ :=
          exists_ne_zero_on_subopen Metric.isOpen_ball (convex_ball p₁ (F₂.rad p₁)).isPreconnected
            (F₂.den_holo p₁ hp₁2) (F₂.den_ne_zero p₁ hp₁2)
            Metric.isOpen_ball ⟨q_a, Metric.mem_ball_self hδ_a⟩
            (Subset.trans hsub_a
              (Subset.trans Set.inter_subset_left (Metric.ball_subset_ball (min_le_right _ _))))
        have h_eq_sub : ∀ q ∈ Metric.ball q_b δ_b,
            F₁.num p₂ q * F₂.den p₂ q = F₂.num p₂ q * F₁.den p₂ q := by
          intro q hq
          have hq_a : q ∈ Metric.ball q_a δ_a := hsub_b hq
          have hq_inter : q ∈ B₁ ∩ B₂ := hsub_a hq_a
          have hc1 : F₁.num p₁ q * F₁.den p₂ q = F₁.num p₂ q * F₁.den p₁ q :=
            F₁.compat p₁ hp₁1 p₂ hp₂1 q
              ⟨Metric.ball_subset_ball (min_le_left _ _) hq_inter.1,
               Metric.ball_subset_ball (min_le_left _ _) hq_inter.2⟩
          have hc2 : F₂.num p₁ q * F₂.den p₂ q = F₂.num p₂ q * F₂.den p₁ q :=
            F₂.compat p₁ hp₁2 p₂ hp₂2 q
              ⟨Metric.ball_subset_ball (min_le_right _ _) hq_inter.1,
               Metric.ball_subset_ball (min_le_right _ _) hq_inter.2⟩
          have he1 : F₁.num p₁ q * F₂.den p₁ q = F₂.num p₁ q * F₁.den p₁ q :=
            heq₁ q hq_inter.1
          have hden_ne : F₁.den p₁ q * F₂.den p₁ q ≠ 0 :=
            mul_ne_zero (hne_a q hq_a) (hne_b q hq)
          apply mul_right_cancel₀ hden_ne
          calc (F₁.num p₂ q * F₂.den p₂ q) * (F₁.den p₁ q * F₂.den p₁ q)
              = (F₁.num p₂ q * F₁.den p₁ q) * F₂.den p₂ q * F₂.den p₁ q := by ring
            _ = (F₁.num p₁ q * F₁.den p₂ q) * F₂.den p₂ q * F₂.den p₁ q := by rw [← hc1]
            _ = (F₁.num p₁ q * F₂.den p₁ q) * F₁.den p₂ q * F₂.den p₂ q := by ring
            _ = (F₂.num p₁ q * F₁.den p₁ q) * F₁.den p₂ q * F₂.den p₂ q := by rw [he1]
            _ = (F₂.num p₁ q * F₂.den p₂ q) * F₁.den p₂ q * F₁.den p₁ q := by ring
            _ = (F₂.num p₂ q * F₂.den p₁ q) * F₁.den p₂ q * F₁.den p₁ q := by rw [hc2]
            _ = (F₂.num p₂ q * F₁.den p₂ q) * (F₁.den p₁ q * F₂.den p₁ q) := by ring
        have hf_holo : DifferentiableOn ℂ
            (fun z => F₁.num p₂ z * F₂.den p₂ z - F₂.num p₂ z * F₁.den p₂ z) B₂ :=
          ((F₁.num_holo p₂ hp₂1).mono (Metric.ball_subset_ball (min_le_left _ _)) |>.mul
            ((F₂.den_holo p₂ hp₂2).mono (Metric.ball_subset_ball (min_le_right _ _)))).sub
          (((F₂.num_holo p₂ hp₂2).mono (Metric.ball_subset_ball (min_le_right _ _))).mul
            ((F₁.den_holo p₂ hp₂1).mono (Metric.ball_subset_ball (min_le_left _ _))))
        intro q hq
        exact sub_eq_zero.mp (eqOn_zero_of_preconnected_2D Metric.isOpen_ball
          (convex_ball _ _).isPreconnected hf_holo Metric.isOpen_ball
          ⟨q_b, Metric.mem_ball_self hδ_b⟩
          (Subset.trans hsub_b (Subset.trans hsub_a Set.inter_subset_right))
          (fun z hz => sub_eq_zero.mpr (h_eq_sub z hz)) q hq)
      let S : Set (ℂ × ℂ) :=
        { p ∈ U | ∀ q ∈ Metric.ball p (min (F₁.rad p) (F₂.rad p)),
            F₁.num p q * F₂.den p q = F₂.num p q * F₁.den p q }
      have hS_open : IsOpen S := by
        rw [Metric.isOpen_iff]
        rintro p₁ ⟨hp₁U, heq₁⟩
        obtain ⟨rU, hrU, hsubU⟩ := Metric.isOpen_iff.mp hU_open p₁ hp₁U
        let r := min rU (min (F₁.rad p₁) (F₂.rad p₁))
        have hr : 0 < r := lt_min hrU
          (lt_min (F₁.rad_pos p₁ (hU_sub hp₁U).1) (F₂.rad_pos p₁ (hU_sub hp₁U).2))
        refine ⟨r, hr, fun p₂ hp₂ => ?_⟩
        have hp₂U : p₂ ∈ U := hsubU (Metric.ball_subset_ball (min_le_left _ _) hp₂)
        have hp₂_B₁ : p₂ ∈ Metric.ball p₁ (min (F₁.rad p₁) (F₂.rad p₁)) :=
          Metric.ball_subset_ball (min_le_right _ _) hp₂
        have hp₂_B₂ : p₂ ∈ Metric.ball p₂ (min (F₁.rad p₂) (F₂.rad p₂)) :=
          Metric.mem_ball_self
            (lt_min (F₁.rad_pos p₂ (hU_sub hp₂U).1) (F₂.rad_pos p₂ (hU_sub hp₂U).2))
        exact ⟨hp₂U, h_step (hU_sub hp₁U) (hU_sub hp₂U) heq₁ ⟨p₂, hp₂_B₁, hp₂_B₂⟩⟩
      have hUS_ne : (U ∩ S).Nonempty :=
        ⟨v₀, hVU hv₀, hVU hv₀, hV_eq v₀ hv₀⟩
      have h_cl : closure S ∩ U ⊆ S := by
        rintro p₂ ⟨hp₂_cl, hp₂U⟩
        have hr₂ : 0 < min (F₁.rad p₂) (F₂.rad p₂) :=
          lt_min (F₁.rad_pos p₂ (hU_sub hp₂U).1) (F₂.rad_pos p₂ (hU_sub hp₂U).2)
        obtain ⟨p₁, ⟨hp₁U, heq₁⟩, hp₁_dist⟩ :=
          Metric.mem_closure_iff.mp hp₂_cl (min (F₁.rad p₂) (F₂.rad p₂)) hr₂
        have hp₁_B₂ : p₁ ∈ Metric.ball p₂ (min (F₁.rad p₂) (F₂.rad p₂)) := by
          rwa [Metric.mem_ball, dist_comm]
        have hp₁_B₁ : p₁ ∈ Metric.ball p₁ (min (F₁.rad p₁) (F₂.rad p₁)) :=
          Metric.mem_ball_self
            (lt_min (F₁.rad_pos p₁ (hU_sub hp₁U).1) (F₂.rad_pos p₁ (hU_sub hp₁U).2))
        exact ⟨hp₂U, h_step (hU_sub hp₁U) (hU_sub hp₂U) heq₁ ⟨p₁, hp₁_B₁, hp₁_B₂⟩⟩
      have hU_S := hU_pre.subset_of_closure_inter_subset hS_open hUS_ne h_cl
      exact ⟨hU_sub, fun p hp => (hU_S hp).2⟩
    have h_glue_two : ∀ {U₁ U₂ U : Set (ℂ × ℂ)},
        IsOpen U₁ → IsOpen U₂ → U = U₁ ∪ U₂ →
        ∀ (G₁ : MeroOn2D U₁) (G₂ : MeroOn2D U₂),
          MeroEqOn G₁ G₂ (U₁ ∩ U₂) →
          ∃ G : MeroOn2D U, MeroEqOn G G₁ U₁ ∧ MeroEqOn G G₂ U₂ := by
      classical
      intro U₁ U₂ U _ _ hU_eq G₁ G₂ ⟨_, h12⟩
      have mem_U₂ : ∀ {p}, p ∈ U → p ∉ U₁ → p ∈ U₂ := by
        intro p hp hp1
        rw [hU_eq] at hp
        exact hp.resolve_left hp1
      let G : MeroOn2D U := {
        rad := fun p => if p ∈ U₁ then G₁.rad p else G₂.rad p
        num := fun p => if p ∈ U₁ then G₁.num p else G₂.num p
        den := fun p => if p ∈ U₁ then G₁.den p else G₂.den p
        rad_pos := fun p hp => by
          by_cases hp1 : p ∈ U₁
          · simp [hp1, G₁.rad_pos p hp1]
          · simp [hp1, G₂.rad_pos p (mem_U₂ hp hp1)]
        ball_sub := fun p hp => by
          by_cases hp1 : p ∈ U₁
          · simp only [hp1, ↓reduceIte]
            exact Subset.trans (G₁.ball_sub p hp1) (hU_eq ▸ Set.subset_union_left)
          · simp only [hp1, ↓reduceIte]
            exact Subset.trans (G₂.ball_sub p (mem_U₂ hp hp1)) (hU_eq ▸ Set.subset_union_right)
        num_holo := fun p hp => by
          by_cases hp1 : p ∈ U₁
          · simp [hp1, G₁.num_holo p hp1]
          · simp [hp1, G₂.num_holo p (mem_U₂ hp hp1)]
        den_holo := fun p hp => by
          by_cases hp1 : p ∈ U₁
          · simp [hp1, G₁.den_holo p hp1]
          · simp [hp1, G₂.den_holo p (mem_U₂ hp hp1)]
        den_ne_zero := fun p hp => by
          by_cases hp1 : p ∈ U₁
          · simp only [hp1, ↓reduceIte]; exact G₁.den_ne_zero p hp1
          · simp only [hp1, ↓reduceIte]; exact G₂.den_ne_zero p (mem_U₂ hp hp1)
        compat := by
          have cross_compat : ∀ p₁ ∈ U₁, ∀ p₂ ∈ U₂,
              ∀ q ∈ Metric.ball p₁ (G₁.rad p₁) ∩ Metric.ball p₂ (G₂.rad p₂),
                G₁.num p₁ q * G₂.den p₂ q = G₂.num p₂ q * G₁.den p₁ q := by
            intro p₁ hp₁ p₂ hp₂ q hq
            let B := Metric.ball p₁ (G₁.rad p₁) ∩ Metric.ball p₂ (G₂.rad p₂)
            have hqU1 : q ∈ U₁ := G₁.ball_sub p₁ hp₁ hq.1
            have hqU2 : q ∈ U₂ := G₂.ball_sub p₂ hp₂ hq.2
            let Bq := Metric.ball q (min (G₁.rad q) (G₂.rad q))
            have hrq : 0 < min (G₁.rad q) (G₂.rad q) :=
              lt_min (G₁.rad_pos q hqU1) (G₂.rad_pos q hqU2)
            obtain ⟨q_a, δ_a, hδ_a, hsub_a, hne_a⟩ :=
              exists_ne_zero_on_subopen Metric.isOpen_ball (convex_ball q (G₁.rad q)).isPreconnected
                (G₁.den_holo q hqU1) (G₁.den_ne_zero q hqU1)
                ((Metric.isOpen_ball.inter Metric.isOpen_ball).inter Metric.isOpen_ball)
                ⟨q, hq, Metric.mem_ball_self hrq⟩
                (Subset.trans Set.inter_subset_right (Metric.ball_subset_ball (min_le_left _ _)))
            obtain ⟨q_b, δ_b, hδ_b, hsub_b, hne_b⟩ :=
              exists_ne_zero_on_subopen Metric.isOpen_ball (convex_ball q (G₂.rad q)).isPreconnected
                (G₂.den_holo q hqU2) (G₂.den_ne_zero q hqU2)
                Metric.isOpen_ball ⟨q_a, Metric.mem_ball_self hδ_a⟩
                (Subset.trans hsub_a
                  (Subset.trans Set.inter_subset_right (Metric.ball_subset_ball (min_le_right _ _))))
            have h_eq_sub : ∀ z ∈ Metric.ball q_b δ_b,
                G₁.num p₁ z * G₂.den p₂ z = G₂.num p₂ z * G₁.den p₁ z := by
              intro z hz
              have hza : z ∈ Metric.ball q_a δ_a := hsub_b hz
              have hzB : z ∈ B ∧ z ∈ Bq := hsub_a hza
              have hc1 : G₁.num p₁ z * G₁.den q z = G₁.num q z * G₁.den p₁ z :=
                G₁.compat p₁ hp₁ q hqU1 z
                  ⟨hzB.1.1, Metric.ball_subset_ball (min_le_left _ _) hzB.2⟩
              have hc2 : G₂.num p₂ z * G₂.den q z = G₂.num q z * G₂.den p₂ z :=
                G₂.compat p₂ hp₂ q hqU2 z
                  ⟨hzB.1.2, Metric.ball_subset_ball (min_le_right _ _) hzB.2⟩
              have he12 : G₁.num q z * G₂.den q z = G₂.num q z * G₁.den q z :=
                h12 q ⟨hqU1, hqU2⟩ z hzB.2
              apply mul_right_cancel₀ (mul_ne_zero (hne_a z hza) (hne_b z hz))
              calc (G₁.num p₁ z * G₂.den p₂ z) * (G₁.den q z * G₂.den q z)
                  = (G₁.num p₁ z * G₁.den q z) * G₂.den p₂ z * G₂.den q z := by ring
                _ = (G₁.num q z * G₁.den p₁ z) * G₂.den p₂ z * G₂.den q z := by rw [hc1]
                _ = (G₁.num q z * G₂.den q z) * G₁.den p₁ z * G₂.den p₂ z := by ring
                _ = (G₂.num q z * G₁.den q z) * G₁.den p₁ z * G₂.den p₂ z := by rw [he12]
                _ = (G₂.num q z * G₂.den p₂ z) * G₁.den q z * G₁.den p₁ z := by ring
                _ = (G₂.num p₂ z * G₂.den q z) * G₁.den q z * G₁.den p₁ z := by rw [← hc2]
                _ = (G₂.num p₂ z * G₁.den p₁ z) * (G₁.den q z * G₂.den q z) := by ring
            have hf_holo : DifferentiableOn ℂ
                (fun z => G₁.num p₁ z * G₂.den p₂ z - G₂.num p₂ z * G₁.den p₁ z) B :=
              ((G₁.num_holo p₁ hp₁).mono Set.inter_subset_left |>.mul
                ((G₂.den_holo p₂ hp₂).mono Set.inter_subset_right)).sub
              (((G₂.num_holo p₂ hp₂).mono Set.inter_subset_right).mul
                ((G₁.den_holo p₁ hp₁).mono Set.inter_subset_left))
            exact sub_eq_zero.mp (eqOn_zero_of_preconnected_2D
              (Metric.isOpen_ball.inter Metric.isOpen_ball)
              ((convex_ball _ _).inter (convex_ball _ _)).isPreconnected
              hf_holo Metric.isOpen_ball ⟨q_b, Metric.mem_ball_self hδ_b⟩
              (Subset.trans hsub_b (Subset.trans hsub_a Set.inter_subset_left))
              (fun z hz => sub_eq_zero.mpr (h_eq_sub z hz)) q hq)
          intro p₁ hp₁ p₂ hp₂ q hq
          by_cases h1 : p₁ ∈ U₁ <;> by_cases h2 : p₂ ∈ U₁
          · simp only [h1, h2, ↓reduceIte] at hq ⊢
            exact G₁.compat p₁ h1 p₂ h2 q hq
          · simp only [h1, h2, ↓reduceIte] at hq ⊢
            exact cross_compat p₁ h1 p₂ (mem_U₂ hp₂ h2) q hq
          · simp only [h1, h2, ↓reduceIte] at hq ⊢
            exact (cross_compat p₂ h2 p₁ (mem_U₂ hp₁ h1) q ⟨hq.2, hq.1⟩).symm
          · simp only [h1, h2, ↓reduceIte] at hq ⊢
            exact G₂.compat p₁ (mem_U₂ hp₁ h1) p₂ (mem_U₂ hp₂ h2) q hq
      }
      refine ⟨G, ?_, ?_⟩
      · refine ⟨fun p hp => ⟨hU_eq ▸ Or.inl hp, hp⟩, fun p hp q hq => ?_⟩
        simp [G, hp]
      · refine ⟨fun p hp => ⟨hU_eq ▸ Or.inr hp, hp⟩, fun p hp q hq => ?_⟩
        by_cases hp1 : p ∈ U₁
        · simp only [G, hp1, ↓reduceIte] at hq ⊢
          exact h12 p ⟨hp1, hp⟩ q hq
        · simp [G, hp1]
    have pullback_ne_zero :
        ∀ {U W O : Set (ℂ × ℂ)} {Φ Φ_inv : ℂ × ℂ → ℂ × ℂ} {p : ℂ × ℂ} {r_W : ℝ}
          {h : ℂ × ℂ → ℂ},
          QdHasContTwoSidedInvOn Φ Φ_inv U W →
          p ∈ O → IsOpen O → O ⊆ U →
          0 < r_W → Metric.ball (Φ p) r_W ⊆ W →
          DifferentiableOn ℂ h (Metric.ball (Φ p) r_W) →
          (∃ z₀ ∈ Metric.ball (Φ p) r_W, h z₀ ≠ 0) →
          ∃ q ∈ O, h (Φ q) ≠ 0 := by
      intro U W O Φ Φ_inv p r_W h hInv hpO hO_open hOU hr_W hball_W hh h_ne
      obtain ⟨_, hW_open, _, hMaps, hCont_inv, hLeft, hRight⟩ := hInv
      have hΦp_W : Φ p ∈ W := hMaps (hOU hpO)
      have hContAt : ContinuousAt Φ_inv (Φ p) :=
        hCont_inv.continuousAt (hW_open.mem_nhds hΦp_W)
      have h_pre : Φ_inv ⁻¹' O ∈ nhds (Φ p) :=
        hContAt.preimage_mem_nhds (hO_open.mem_nhds (by rwa [hLeft p (hOU hpO)]))
      obtain ⟨δ_raw, hδ_raw_pos, hδ_raw⟩ := Metric.mem_nhds_iff.mp h_pre
      let δ := min δ_raw r_W
      have hδ_pos : 0 < δ := lt_min hδ_raw_pos hr_W
      obtain ⟨q', δ', hδ'_pos, hsub', hne'⟩ :=
        exists_ne_zero_on_subopen Metric.isOpen_ball (convex_ball _ _).isPreconnected
          hh h_ne Metric.isOpen_ball ⟨Φ p, Metric.mem_ball_self hδ_pos⟩
          (Metric.ball_subset_ball (min_le_right _ _))
      have hq'_mem : q' ∈ Metric.ball (Φ p) δ := hsub' (Metric.mem_ball_self hδ'_pos)
      have hq'_W : q' ∈ W := hball_W (Metric.ball_subset_ball (min_le_right _ _) hq'_mem)
      refine ⟨Φ_inv q', hδ_raw (Metric.ball_subset_ball (min_le_left _ _) hq'_mem), ?_⟩
      rw [hRight q' hq'_W]
      exact hne' q' (Metric.mem_ball_self hδ'_pos)
    have h_exists_pullback : ∀ {U W : Set (ℂ × ℂ)} {Φ Φ_inv : ℂ × ℂ → ℂ × ℂ},
        QdHasContTwoSidedInvOn Φ Φ_inv U W →
        ∀ F : MeroOn2D W, ∃ G : MeroOn2D U, MeroEqOnPullback G F Φ U := by
      classical
      intro U W Φ Φ_inv hInv F
      have ⟨hU_open, _, hΦ_holo, hMaps, _, _, _⟩ := hInv
      have hex_rad : ∀ p : ℂ × ℂ, p ∈ U →
          ∃ r : ℝ, 0 < r ∧ Metric.ball p r ⊆ U ∧
            Set.MapsTo Φ (Metric.ball p r) (Metric.ball (Φ p) (F.rad (Φ p))) := by
        intro p hp
        have hContAt : ContinuousAt Φ p :=
