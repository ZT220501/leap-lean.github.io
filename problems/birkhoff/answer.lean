      have hw₀_mem : w₀ ∈ horizStrip S.H := by simpa [w₀, φ, horizStrip] using hw_mem
      have hw_eq : w₀ + (((k : ℝ) * (2 * Real.pi) : ℝ) : ℂ) = w := by
