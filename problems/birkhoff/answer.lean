                ∑ m ∈ Finset.range (j + 1), (D (m + 1)) ^ (-2 * α - 1) := by
            rw [Finset.mul_sum]
            refine Finset.sum_le_sum fun m hm => ?_
            have hm_lt : m < j + 1 := Finset.mem_range.mp hm
