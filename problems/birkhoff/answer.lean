    have hq2_le_32 : ‖q ^ 2‖ ≤ Real.exp (-(3 / 2 : ℝ) * z.re) := by
      rw [norm_pow, hq_norm, ← Real.exp_nat_mul]
      exact Real.exp_le_exp.mpr (by linarith)
    have hzq_le_32 : ‖z * q‖ ≤ 3 * Real.exp (-(3 / 2 : ℝ) * z.re) := by
      rw [norm_mul, hq_norm]
      have hz_lt := h_norm_z_S0 z ⟨hz_re, hz_im⟩
      calc ‖z‖ * Real.exp (-2 * z.re)
