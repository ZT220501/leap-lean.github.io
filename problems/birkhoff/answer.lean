      have hϕ_yz : C.ϕ_ℂ (Ψ (z, 0)).1 = G_gr.θ_inv z := by
        rw [hΨz, ← he_ϕ_coe]; exact e_ϕ.right_inv hθ_tgt
      have hΘ_yz : glancingTheta C (Ψ (z, 0)).1 0 = G_gr.θ_inv z := by
        simp [glancingTheta, C.U_zero _ hyz_2s₁, hϕ_yz]
      have h2_zero : (Ψ (z, 0)).2 = 0 := by rw [hΨz]
      have hμ_r : ∀ r : Fin (k + 1),
