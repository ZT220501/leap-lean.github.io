          intro v
          have hmain_eq := hEqUp_comp (φ₁ := pointArcHoloTaylor1D F (x₀ v))
            (fun _ _ => rfl) (hsh_pert v).1
          have hmain_d := hComp_pert (pointArcHoloTaylor1D F (x₀ v)) (hc_ztop.1 v) (hsh_pert v).1
          have hc1F : PowerSeries.coeff 1 (pointArcHoloTaylor1D F (x₀ v)) = deriv F (x₀ v) := by
