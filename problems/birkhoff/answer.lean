  have h_holo_real_mul : ∀ {p : ℕ} {σ' M : ℝ} (c : ℝ) {f : ℂ → ℂ},
      0 ≤ M → IsStripHoloSymBounded p σ' M f →
      IsStripHoloSymBounded p σ' (|c| * M) (fun z => (c : ℂ) * f z) := by
    intro p σ' M c f hM hf
    refine ⟨?_, ?_, ?_⟩
    · simpa only [Complex.norm_real, Real.norm_eq_abs] using h_bounded_const_mul (c : ℂ) hM hf.1
    · intro z hz
      dsimp only
      rw [hf.2.1 z hz]
    · intro z hz
      dsimp only
      rw [hf.2.2 z hz, map_mul, Complex.conj_ofReal]
  have h_bounded_mul : ∀ {p : ℕ} {σ' M₁ M₂ : ℝ} {f g : ℂ → ℂ},
      IsStripBounded p σ' M₁ f → IsStripBounded p σ' M₂ g →
      IsStripBounded p σ' ((2 : ℝ) ^ p * M₁ * M₂) (fun z => f z * g z) := by
    intro p σ' M₁ M₂ f g hf hg
    refine ⟨hf.1.mul hg.1, ?_⟩
    intro k hk z hz
    have hM₁ : 0 ≤ M₁ := le_trans (norm_nonneg _) (hf.2 0 (Nat.zero_le p) z hz)
    have hM₂ : 0 ≤ M₂ := le_trans (norm_nonneg _) (hg.2 0 (Nat.zero_le p) z hz)
    rw [iteratedDeriv_fun_mul (hContDiffAt hf.1 hz k) (hContDiffAt hg.1 hz k)]
    calc
      ‖∑ i ∈ Finset.range (k + 1),
          (k.choose i : ℂ) * iteratedDeriv i f z * iteratedDeriv (k - i) g z‖
          ≤ ∑ i ∈ Finset.range (k + 1),
              ‖(k.choose i : ℂ) * iteratedDeriv i f z * iteratedDeriv (k - i) g z‖ :=
            norm_sum_le _ _
      _ ≤ ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * (M₁ * M₂) := by
            apply Finset.sum_le_sum
            intro i hi
            have hi_le : i ≤ k := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
            rw [norm_mul, norm_mul, Complex.norm_natCast, mul_assoc]
            apply mul_le_mul_of_nonneg_left _ (Nat.cast_nonneg _)
            exact mul_le_mul (hf.2 i (le_trans hi_le hk) z hz)
              (hg.2 (k - i) (le_trans (Nat.sub_le k i) hk) z hz)
              (norm_nonneg _) hM₁
      _ = (∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ)) * (M₁ * M₂) :=
            (Finset.sum_mul _ _ _).symm
      _ = (2 : ℝ) ^ k * (M₁ * M₂) := by
            have hsum : (∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ)) = (2 : ℝ) ^ k := by
              exact_mod_cast Nat.sum_range_choose k
            rw [hsum]
      _ ≤ (2 : ℝ) ^ p * (M₁ * M₂) :=
            mul_le_mul_of_nonneg_right (pow_le_pow_right₀ (by norm_num) hk) (mul_nonneg hM₁ hM₂)
      _ = (2 : ℝ) ^ p * M₁ * M₂ := by ring
  have h_holo_mul : ∀ {p : ℕ} {σ' M₁ M₂ : ℝ} {f g : ℂ → ℂ},
      IsStripHoloSymBounded p σ' M₁ f → IsStripHoloSymBounded p σ' M₂ g →
      IsStripHoloSymBounded p σ' ((2 : ℝ) ^ p * M₁ * M₂) (fun z => f z * g z) := by
    intro p σ' M₁ M₂ f g hf hg
    refine ⟨h_bounded_mul hf.1 hg.1, ?_, ?_⟩
    · intro z hz
      dsimp only
      rw [hf.2.1 z hz, hg.2.1 z hz]
    · intro z hz
      dsimp only
      rw [hf.2.2 z hz, hg.2.2 z hz, map_mul]
  have h_bounded_mul_diff :
      ∀ {p : ℕ} {σ' M_f M_g Δf Δg : ℝ} {f₁ f₂ g₁ g₂ : ℂ → ℂ},
        IsStripBounded p σ' M_f f₁ →
        IsStripBounded p σ' M_g g₂ →
        IsStripBounded p σ' Δf (fun z => f₁ z - f₂ z) →
        IsStripBounded p σ' Δg (fun z => g₁ z - g₂ z) →
        IsStripBounded p σ' ((2 : ℝ) ^ p * (M_f * Δg + Δf * M_g))
          (fun z => f₁ z * g₁ z - f₂ z * g₂ z) := by
    intro p σ' M_f M_g Δf Δg f₁ f₂ g₁ g₂ hf₁ hg₂ hdf hdg
    have hEq : (fun z => f₁ z * g₁ z - f₂ z * g₂ z) =
        (fun z => f₁ z * (g₁ z - g₂ z) + (f₁ z - f₂ z) * g₂ z) :=
      funext fun z => by ring
    have hBoundEq : (2 : ℝ) ^ p * M_f * Δg + (2 : ℝ) ^ p * Δf * M_g =
        (2 : ℝ) ^ p * (M_f * Δg + Δf * M_g) := by ring
    rw [hEq, ← hBoundEq]
    exact h_bounded_add (h_bounded_mul hf₁ hdg) (h_bounded_mul hdf hg₂)
  
  have h_exp_ball_bound : ∀ (R : ℝ),
      0 < R →
      DifferentiableOn ℂ Complex.exp (Metric.ball (0 : ℂ) R) ∧
      (∀ w : ℂ, Complex.exp (starRingEnd ℂ w) = starRingEnd ℂ (Complex.exp w)) ∧
      (∀ j : ℕ, ∀ w ∈ Metric.ball (0 : ℂ) R,
        ‖iteratedDeriv j Complex.exp w‖ ≤ Real.exp R) := by
    intro R _hR
    have hIterExp : ∀ j : ℕ, iteratedDeriv j Complex.exp = Complex.exp := by
      intro j
      induction j with
      | zero => exact iteratedDeriv_zero
      | succ j ih => rw [iteratedDeriv_succ, ih, Complex.deriv_exp]
    refine ⟨Complex.differentiable_exp.differentiableOn, Complex.exp_conj, ?_⟩
    intro j w hw
    rw [hIterExp j, Complex.norm_exp, Real.exp_le_exp]
    have hw' : ‖w‖ < R := by simpa using hw
    exact (le_abs_self w.re).trans ((Complex.abs_re_le_norm w).trans (le_of_lt hw'))
  have h_sin_ball_bound : ∀ (R : ℝ),
      0 < R →
      DifferentiableOn ℂ Complex.sin (Metric.ball (0 : ℂ) R) ∧
      (∀ w : ℂ, Complex.sin (starRingEnd ℂ w) = starRingEnd ℂ (Complex.sin w)) ∧
      (∀ j : ℕ, ∀ w ∈ Metric.ball (0 : ℂ) R,
        ‖iteratedDeriv j Complex.sin w‖ ≤ Real.exp R) := by
    intro R _hR
    have hExpI : ∀ z : ℂ, ‖Complex.exp (z * Complex.I)‖ ≤ Real.exp ‖z‖ := by
      intro z
      rw [Complex.norm_exp, Real.exp_le_exp]
      calc
        (z * Complex.I).re ≤ |(z * Complex.I).re| := le_abs_self _
        _ ≤ ‖z * Complex.I‖ := Complex.abs_re_le_norm _
        _ = ‖z‖ := by rw [norm_mul, Complex.norm_I, mul_one]
    have hSinCos0 : ∀ w : ℂ,
        ‖Complex.sin w‖ ≤ Real.exp ‖w‖ ∧ ‖Complex.cos w‖ ≤ Real.exp ‖w‖ := by
      intro w
      have h1 : ‖Complex.exp (w * Complex.I)‖ ≤ Real.exp ‖w‖ := hExpI w
      have h2 : ‖Complex.exp (-w * Complex.I)‖ ≤ Real.exp ‖w‖ := by
        simpa only [norm_neg] using hExpI (-w)
      refine ⟨?_, ?_⟩
      · rw [Complex.sin, norm_div, norm_mul, Complex.norm_I, mul_one, Complex.norm_ofNat]
        have hsub : ‖Complex.exp (-w * Complex.I) - Complex.exp (w * Complex.I)‖ ≤
            2 * Real.exp ‖w‖ := by
          calc
            ‖Complex.exp (-w * Complex.I) - Complex.exp (w * Complex.I)‖
                ≤ ‖Complex.exp (-w * Complex.I)‖ + ‖Complex.exp (w * Complex.I)‖ :=
                  norm_sub_le _ _
            _ ≤ Real.exp ‖w‖ + Real.exp ‖w‖ := add_le_add h2 h1
            _ = 2 * Real.exp ‖w‖ := by ring
        linarith
      · rw [Complex.cos, norm_div, Complex.norm_ofNat]
        have hadd : ‖Complex.exp (w * Complex.I) + Complex.exp (-w * Complex.I)‖ ≤
            2 * Real.exp ‖w‖ := by
          calc
            ‖Complex.exp (w * Complex.I) + Complex.exp (-w * Complex.I)‖
                ≤ ‖Complex.exp (w * Complex.I)‖ + ‖Complex.exp (-w * Complex.I)‖ :=
                  norm_add_le _ _
            _ ≤ Real.exp ‖w‖ + Real.exp ‖w‖ := add_le_add h1 h2
            _ = 2 * Real.exp ‖w‖ := by ring
        linarith
    have hIterSinCos : ∀ j : ℕ, ∀ w : ℂ,
        ‖iteratedDeriv j Complex.sin w‖ ≤ Real.exp ‖w‖ ∧
        ‖iteratedDeriv j Complex.cos w‖ ≤ Real.exp ‖w‖ := by
      intro j
      induction j with
      | zero =>
        intro w
        simpa only [iteratedDeriv_zero] using hSinCos0 w
      | succ j ih =>
        intro w
        have hdsin : deriv Complex.sin = Complex.cos := Complex.deriv_sin
        have hdcos : deriv Complex.cos = fun z => -Complex.sin z :=
          funext fun _ => Complex.deriv_cos
        refine ⟨?_, ?_⟩
        · rw [iteratedDeriv_succ', hdsin]
          exact (ih w).2
        · rw [iteratedDeriv_succ', hdcos, iteratedDeriv_fun_neg, norm_neg]
          exact (ih w).1
    refine ⟨Complex.differentiable_sin.differentiableOn, Complex.sin_conj, ?_⟩
    intro j w hw
    have hw' : ‖w‖ < R := by simpa using hw
    exact le_trans (hIterSinCos j w).1 (Real.exp_le_exp.mpr (le_of_lt hw'))
  
  have h_continuousOn_param_int : ∀ (M : ℝ) (g : ℝ → ℝ → ℂ),
      0 ≤ M →
      (∀ u ∈ Set.Icc (0 : ℝ) 1, ContinuousOn (g u) (Set.Icc (0 : ℝ) 1)) →
      (∀ t ∈ Set.Icc (0 : ℝ) 1, ContinuousOn (fun u => g u t) (Set.Icc (0 : ℝ) 1)) →
      (∀ u ∈ Set.Icc (0 : ℝ) 1, ∀ t ∈ Set.Icc (0 : ℝ) 1, ‖g u t‖ ≤ M) →
      ContinuousOn (fun u => ∫ t in (0 : ℝ)..1, g u t) (Set.Icc (0 : ℝ) 1) := by
    intro M g _hM hg_t hg_u hg_bnd u₀ hu₀
    have huIoc_sub : Set.uIoc (0 : ℝ) 1 ⊆ Set.Icc (0 : ℝ) 1 := by
      rw [Set.uIoc_of_le zero_le_one]
