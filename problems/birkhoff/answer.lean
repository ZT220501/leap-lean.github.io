    rw [div_le_div_iff₀ (by positivity) (mul_pos hrx_pos hS_pos)]
    nlinarith
  have hΦ_upper : ∀ y s : ℝ, 0 ≤ s → y ≤ R + s → Φ_tan y ≤ h + 2 * R + 2 * s := by
