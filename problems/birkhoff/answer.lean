      (∀ (j L_nat l : ℕ), l + 1 = L_nat → L_nat ≤ j →
        J_cone j L_nat (x_seq j) ≤ (16 * ((2 : ℝ) ^ l) * B_cone L_nat) * H_row j (x_seq j)) := by
    let P_pen : ℕ → ℝ → ℝ := fun j x =>
      ((j : ℝ) + 1) * (U_circ j x - H_row j x) +
        (∑ r ∈ Finset.range (j + 1), J_ball j (r + 1) x / (16 * ((2 : ℝ) ^ r) * A_ball (r + 1))) +
        (∑ l ∈ Finset.range (j + 1), J_cone j (l + 1) x / (16 * ((2 : ℝ) ^ l) * B_cone (l + 1)))
    have hgeom_half : ∀ n : ℕ,
