            dsimp [w₁, w₂]; field_simp [hden.ne']
          linarith
        have hD_pos : 0 < D := (hK'_sub hD).1
        have hb_ge := hb_ge_two M
        have h1_le : 1 - D ≤ b_M M - 1 := by linarith
        nlinarith [hU_pos M, hU_le_B M]
      · rw [hψ_one n]
        linarith [hB_pos M]
      · have ha_le := ha_le_half M
        have hden : 0 < D - a_M M := by linarith
        let w₁ : ℝ := (D - 1) / (D - a_M M)
        let w₂ : ℝ := (1 - a_M M) / (D - a_M M)
        have hw₁ : 0 ≤ w₁ := div_nonneg (by linarith) (le_of_lt hden)
        have hw₂ : 0 ≤ w₂ := div_nonneg (by linarith) (le_of_lt hden)
        have hw_sum : w₁ + w₂ = 1 := by dsimp [w₁, w₂]; field_simp [hden.ne']; ring
        have hw_pt : w₁ * a_M M + w₂ * D = 1 := by dsimp [w₁, w₂]; field_simp [hden.ne']; ring
        have ha_mem : a_M M ∈ K'_M M :=
          ⟨le_rfl, le_trans ha_le (le_trans (by norm_num) (hb_ge_two M))⟩
        have h_cvx := (hm_conv n).2 (hK'_sub ha_mem) (hK'_sub hD) hw₁ hw₂ hw_sum
        simp only [smul_eq_mul] at h_cvx
        rw [hw_pt, hm_one n, Real.log_one] at h_cvx
        have h_a_up : ψ n (a_M M) ≤ U_M M := h_upper_K' (a_M M) ha_mem
        have h_lin : 0 ≤ w₁ * U_M M + w₂ * ψ n D := by
          have : w₁ * ψ n (a_M M) ≤ w₁ * U_M M := mul_le_mul_of_nonneg_left h_a_up hw₁
          dsimp [ψ] at *
          linarith
        have h_mul_den : 0 ≤ (D - 1) * U_M M + (1 - a_M M) * ψ n D := by
          have := mul_le_mul_of_nonneg_left h_lin (le_of_lt hden)
          have heq : (D - a_M M) * (w₁ * U_M M + w₂ * ψ n D) =
              (D - 1) * U_M M + (1 - a_M M) * ψ n D := by
            dsimp [w₁, w₂]; field_simp [hden.ne']
          linarith
        have hD_le : D - 1 ≤ (2 : ℝ) ^ (M + 1) := by
          have := hD.2
          dsimp [b_M] at this
          linarith
        have h_ratio : D - 1 ≤ (2 : ℝ) ^ (M + 2) * (1 - a_M M) := by
          have h_pow : (2 : ℝ) ^ (M + 2) = 2 * (2 : ℝ) ^ (M + 1) := by ring
          rw [h_pow]
          have h_half : (1 / 2 : ℝ) ≤ 1 - a_M M := by linarith
          nlinarith [(by positivity : (0 : ℝ) < (2 : ℝ) ^ (M + 1))]
        have h_B_def : B_M M = (2 : ℝ) ^ (M + 2) * U_M M := rfl
        nlinarith [hU_pos M]
    exact abs_le.mpr ⟨hψ_lo, hψ_hi⟩
  have h_lip_K : ∀ (M n : ℕ), N_M M ≤ n →
      ∀ x ∈ K_M M, ∀ y ∈ K_M M, |ψ n x - ψ n y| ≤ L_M M * |x - y| := by
    intro M n hn
    obtain ⟨hR_b, _⟩ := hN_M M n hn
    have hK'_sub : K'_M M ⊆ Set.Ioc 0 (R_seq n) := by
      intro z hz
      exact ⟨lt_of_lt_of_le (ha_pos M) hz.1, le_trans hz.2 hR_b⟩
    have h_lt : ∀ x ∈ K_M M, ∀ y ∈ K_M M, x < y → |ψ n y - ψ n x| ≤ L_M M * (y - x) := by
      intro x hx y hy hxy
      have ha_p := ha_pos M
      have h1_pow : (1 : ℝ) ≤ (2 : ℝ) ^ M := one_le_pow₀ (by norm_num)
      have hxm_mem : x - a_M M ∈ K'_M M := by
        refine ⟨?_, ?_⟩
        · have hx1 := hx.1
          have heq : (1 / 2 : ℝ) ^ M - a_M M = a_M M := by dsimp [a_M]; ring
          linarith
        · have hx2 := hx.2
          have hb_eq : b_M M = 2 * (2 : ℝ) ^ M := by dsimp [b_M]; ring
          linarith
      have hyp_mem : y + a_M M ∈ K'_M M := by
        refine ⟨?_, ?_⟩
        · have hy1 := hy.1
          have ha_le_km : a_M M ≤ (1 / 2 : ℝ) ^ M := by
            dsimp [a_M]; rw [pow_succ]; nlinarith [(by positivity : (0 : ℝ) < (1 / 2 : ℝ) ^ M)]
          linarith
        · have hy2 := hy.2
          have ha_le := ha_le_half M
          have hb_eq : b_M M = 2 * (2 : ℝ) ^ M := by dsimp [b_M]; ring
          linarith
      have h_km_sub : K_M M ⊆ K'_M M := by
        intro z hz
        refine ⟨?_, ?_⟩
        · have : a_M M ≤ (1 / 2 : ℝ) ^ M := by
            dsimp [a_M]; rw [pow_succ]; nlinarith [(by positivity : (0 : ℝ) < (1 / 2 : ℝ) ^ M)]
          exact le_trans this hz.1
        · have : (2 : ℝ) ^ M ≤ b_M M := by
            dsimp [b_M]; rw [pow_succ]; nlinarith [(by positivity : (0 : ℝ) < (2 : ℝ) ^ M)]
