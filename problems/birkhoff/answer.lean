                  ((continuousOn_fst.add hG2_cont).sub continuousOn_const)
              exact hΦ_holo.continuousOn.comp hmap_cont
                (fun p hp => (hCollar_Uw_mem p.2 (hBdry_sub_collar hp.2) T_c hTc p.1 hp.1).2.2)
            exact hnum_cont.div (continuousOn_snd.sub continuousOn_const)
              (fun p hp => hDisjoint_bdry p.2 hp.2 T hT_hd)
          · intro ζ hζ
            have hnum : DifferentiableOn ℂ (fun w => g_plus ζ T_c w) U_w := by
              have hmap : DifferentiableOn ℂ (fun w => (ζ, w + G ζ - G T_c)) U_w :=
                (differentiableOn_const ζ).prodMk
                  ((differentiableOn_id.add (differentiableOn_const (G ζ))).sub
                    (differentiableOn_const (G T_c)))
              exact hΦ_holo.comp hmap
                (fun w hw => (hCollar_Uw_mem ζ (hBdry_sub_collar hζ) T_c hTc w hw).2.2)
