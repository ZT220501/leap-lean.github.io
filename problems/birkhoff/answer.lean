  have hDslope_holo : ∀ {W : Set ℂ} (hW : IsOpen W) {z₀ : ℂ} (hz₀ : z₀ ∈ W)
      {G : ℂ → ℂ} (hG : DifferentiableOn ℂ G W) (n : ℕ),
      DifferentiableOn ℂ (lineCoalescingDslopeIter G z₀ n) W := by
    intro W hW z₀ hz₀ G hG n
    induction n with
    | zero => exact hG
    | succ n ih =>
        exact (Complex.differentiableOn_dslope (hW.mem_nhds hz₀)).mpr ih
  have hDslope_comm : ∀ (G : ℂ → ℂ) (z₀ : ℂ) (n : ℕ),
      lineCoalescingDslopeIter G z₀ (n + 1) = lineCoalescingDslopeIter (dslope G z₀) z₀ n := by
    intro G z₀ n
    induction n with
    | zero => rfl
    | succ n ih =>
        change dslope (lineCoalescingDslopeIter G z₀ (n + 1)) z₀ =
          dslope (lineCoalescingDslopeIter (dslope G z₀) z₀ n) z₀
        rw [ih]
  have hIterDeriv_dslope : ∀ {W : Set ℂ} (hW : IsOpen W) {z₀ : ℂ} (hz₀ : z₀ ∈ W)
      {f : ℂ → ℂ} (hf : DifferentiableOn ℂ f W) (k : ℕ),
      iteratedDeriv (k + 1) f z₀ = ((k + 1 : ℕ) : ℂ) * iteratedDeriv k (dslope f z₀) z₀ := by
    intro W hW z₀ hz₀ f hf k
    have hfeq : f = fun z => f z₀ + (z - z₀) * dslope f z₀ z := by
      ext z
      have hsub := sub_smul_dslope f z₀ z
      simp only [smul_eq_mul] at hsub
      linear_combination -hsub
    have hcd_ds : ContDiffAt ℂ (k + 1 : ℕ) (dslope f z₀) z₀ :=
      ((((Complex.differentiableOn_dslope (hW.mem_nhds hz₀)).mpr hf).contDiffOn hW).contDiffAt
        (hW.mem_nhds hz₀)).of_le le_top
    have hcd_sub : ContDiffAt ℂ (k + 1 : ℕ) (fun z : ℂ => z - z₀) z₀ :=
      contDiffAt_id.sub contDiffAt_const
    have hcd_mul : ContDiffAt ℂ (k + 1 : ℕ) (fun z : ℂ => (z - z₀) * dslope f z₀ z) z₀ :=
      hcd_sub.mul hcd_ds
    conv_lhs => rw [hfeq]
    rw [iteratedDeriv_fun_add contDiffAt_const hcd_mul, iteratedDeriv_const,
      if_neg (Nat.succ_ne_zero k), zero_add, iteratedDeriv_fun_mul hcd_sub hcd_ds]
    rw [Finset.sum_eq_single 1]
    · simp only [Nat.choose_one_right, Nat.add_sub_cancel, iteratedDeriv_one, nsmul_eq_mul]
      have hd1 : deriv (fun z : ℂ => z - z₀) z₀ = 1 := by simp
      rw [hd1, mul_one]
    · intro i _ hi_ne1
      rcases i with _ | _ | i
      · simp
      · exact False.elim (hi_ne1 rfl)
      · have hd0 : iteratedDeriv (i + 1 + 1) (fun z : ℂ => z - z₀) z₀ = 0 := by
          rw [show i + 1 + 1 = (i + 1) + 1 from rfl, iteratedDeriv_succ',
