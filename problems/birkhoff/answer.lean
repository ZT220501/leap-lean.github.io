    linarith [div_le_self hΔe hq_one, div_le_self hΔW_nn hq_one]

theorem strip_jet_composition_and_lipschitz (m : ℕ) (M₁ C_zeta : ℝ)
    (hm : 2 ≤ m) (hM₁ : 0 < M₁) (hCz : 0 < C_zeta)
    (hCalc : StripCalculusToolkit) :
    Nonempty (StripJetCompSystem m M₁ C_zeta) :=
by
  
  have hStrip_open : ∀ H : ℝ, IsOpen (horizStrip H) := fun H =>
    isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const
  have hStrip_convex : ∀ H : ℝ, Convex ℝ (horizStrip H) := by
    intro H
    have hEq : horizStrip H = Complex.imLm ⁻¹' Set.Ioo (-H) H := by
      ext z
      simp [horizStrip, abs_lt]
    rw [hEq]
    exact (convex_Ioo (-H) H).linear_preimage Complex.imLm
  have hStrip_sym : ∀ {H : ℝ} {z : ℂ}, z ∈ horizStrip H →
      z + 2 * Real.pi ∈ horizStrip H ∧ starRingEnd ℂ z ∈ horizStrip H := by
    intro H z hz
    change |z.im| < H at hz
    refine ⟨?_, ?_⟩
    · change |(z + 2 * Real.pi).im| < H
      simpa using hz
    · change |(starRingEnd ℂ z).im| < H
      simpa using hz
  have hBnd_congr : ∀ {p : ℕ} {σ' M : ℝ} {f g : ℂ → ℂ},
      IsStripBounded p σ' M f → (∀ z ∈ horizStrip σ', g z = f z) →
      IsStripBounded p σ' M g := by
    intro p σ' M f g hf hgf
    refine ⟨hf.1.congr hgf, ?_⟩
    intro k hk z hz
    have hEv : g =ᶠ[nhds z] f :=
      Filter.eventuallyEq_of_mem ((hStrip_open σ').mem_nhds hz) hgf
    rw [hEv.iteratedDeriv_eq]
    exact hf.2 k hk z hz
  have hHolo_congr : ∀ {p : ℕ} {σ' M : ℝ} {f g : ℂ → ℂ},
      IsStripHoloSymBounded p σ' M f → (∀ z ∈ horizStrip σ', g z = f z) →
      IsStripHoloSymBounded p σ' M g := by
    intro p σ' M f g hf hgf
    refine ⟨hBnd_congr hf.1 hgf, ?_, ?_⟩
    · intro z hz
      rw [hgf (z + 2 * Real.pi) (hStrip_sym hz).1, hgf z hz, hf.2.1 z hz]
    · intro z hz
      rw [hgf (starRingEnd ℂ z) (hStrip_sym hz).2, hgf z hz, hf.2.2 z hz]
  have hPair_congr : ∀ {p : ℕ} {σ' M L Δ : ℝ} {f₁ f₂ g₁ g₂ : ℂ → ℂ},
      sjcHoloLipPair p σ' M L Δ f₁ f₂ →
      (∀ z ∈ horizStrip σ', g₁ z = f₁ z) →
      (∀ z ∈ horizStrip σ', g₂ z = f₂ z) →
      sjcHoloLipPair p σ' M L Δ g₁ g₂ := by
    intro p σ' M L Δ f₁ f₂ g₁ g₂ hf hg₁ hg₂
    refine ⟨hf.1, hf.2.1, hf.2.2.1, hHolo_congr hf.2.2.2.1 hg₁, hHolo_congr hf.2.2.2.2.1 hg₂, ?_⟩
    exact hBnd_congr hf.2.2.2.2.2 (fun z hz => by simp [hg₁ z hz, hg₂ z hz])
  have hCont_rSinc : Continuous rSinc_C := by
    have hInner : Continuous (fun p : ℂ × ℝ =>
        ∫ s in (0 : ℝ)..1,
          ((1 - s : ℝ) : ℂ) ^ 2 * Complex.sin (((s * p.2 : ℝ) : ℂ) * p.1)) := by
      apply intervalIntegral.continuous_parametric_intervalIntegral_of_continuous'
      fun_prop
    have hOuter : Continuous (fun u : ℂ =>
        ∫ r in (0 : ℝ)..1,
          (r : ℂ) ^ 3 *
            (∫ s in (0 : ℝ)..1,
              ((1 - s : ℝ) : ℂ) ^ 2 * Complex.sin (((s * r : ℝ) : ℂ) * u))) := by
      apply intervalIntegral.continuous_parametric_intervalIntegral_of_continuous'
      have h1 : Continuous (fun p : ℂ × ℝ => (p.2 : ℂ) ^ 3) := by fun_prop
      exact h1.mul hInner
    exact continuous_const.mul hOuter
  have hCompConst_pos : ∀ (p : ℕ) (B : ℝ), 0 ≤ shjCompConst p B := by
    intro p B
    cases p with
    | zero => simp [shjCompConst]
    | succ k =>
      simp only [shjCompConst]
      exact le_trans zero_le_one (le_max_left 1 _)
  have hPair_const_real : ∀ (p : ℕ) (σ' c Δ : ℝ), 0 ≤ Δ →
      sjcHoloLipPair p σ' |c| 0 Δ (fun _ => (c : ℂ)) (fun _ => (c : ℂ)) := by
    intro p σ' c Δ hΔ
    refine ⟨abs_nonneg c, le_rfl, hΔ, hCalc.holo_const_real p σ' c, hCalc.holo_const_real p σ' c, ?_⟩
    have h0 := hCalc.bounded_const p σ' (0 : ℂ)
    rw [norm_zero, ← zero_mul Δ] at h0
    exact hBnd_congr h0 (fun _ _ => sub_self _)
  have hPair_mono : ∀ {p : ℕ} {σ' M₁ M₂ L₁ L₂ Δ : ℝ} {f₁ f₂ : ℂ → ℂ},
      M₁ ≤ M₂ → L₁ ≤ L₂ → sjcHoloLipPair p σ' M₁ L₁ Δ f₁ f₂ →
      sjcHoloLipPair p σ' M₂ L₂ Δ f₁ f₂ := by
    intro p σ' M₁ M₂ L₁ L₂ Δ f₁ f₂ hM hL hf
    refine ⟨le_trans hf.1 hM, le_trans hf.2.1 hL, hf.2.2.1,
      hCalc.holo_mono hM hf.2.2.2.1, hCalc.holo_mono hM hf.2.2.2.2.1,
      hCalc.bounded_mono (mul_le_mul_of_nonneg_right hL hf.2.2.1) hf.2.2.2.2.2⟩
  have hPair_add : ∀ {p : ℕ} {σ' M_f L_f M_g L_g Δ : ℝ} {f₁ f₂ g₁ g₂ : ℂ → ℂ},
      sjcHoloLipPair p σ' M_f L_f Δ f₁ f₂ →
      sjcHoloLipPair p σ' M_g L_g Δ g₁ g₂ →
      sjcHoloLipPair p σ' (M_f + M_g) (L_f + L_g) Δ
        (fun z => f₁ z + g₁ z) (fun z => f₂ z + g₂ z) := by
    intro p σ' M_f L_f M_g L_g Δ f₁ f₂ g₁ g₂ hf hg
    refine ⟨add_nonneg hf.1 hg.1, add_nonneg hf.2.1 hg.2.1, hf.2.2.1,
      hCalc.holo_add hf.2.2.2.1 hg.2.2.2.1, hCalc.holo_add hf.2.2.2.2.1 hg.2.2.2.2.1, ?_⟩
    have hDiff := hCalc.bounded_add hf.2.2.2.2.2 hg.2.2.2.2.2
    rw [← add_mul] at hDiff
    exact hBnd_congr hDiff (fun _ _ => by ring)
  have hPair_sub : ∀ {p : ℕ} {σ' M_f L_f M_g L_g Δ : ℝ} {f₁ f₂ g₁ g₂ : ℂ → ℂ},
      sjcHoloLipPair p σ' M_f L_f Δ f₁ f₂ →
      sjcHoloLipPair p σ' M_g L_g Δ g₁ g₂ →
      sjcHoloLipPair p σ' (M_f + M_g) (L_f + L_g) Δ
        (fun z => f₁ z - g₁ z) (fun z => f₂ z - g₂ z) := by
    intro p σ' M_f L_f M_g L_g Δ f₁ f₂ g₁ g₂ hf hg
    refine ⟨add_nonneg hf.1 hg.1, add_nonneg hf.2.1 hg.2.1, hf.2.2.1,
      hCalc.holo_sub hf.2.2.2.1 hg.2.2.2.1, hCalc.holo_sub hf.2.2.2.2.1 hg.2.2.2.2.1, ?_⟩
    have hDiff := hCalc.bounded_sub hf.2.2.2.2.2 hg.2.2.2.2.2
    rw [← add_mul] at hDiff
    exact hBnd_congr hDiff (fun _ _ => by ring)
  have hPair_real_mul : ∀ {p : ℕ} {σ' M_f L_f Δ : ℝ} (c : ℝ) {f₁ f₂ : ℂ → ℂ},
      sjcHoloLipPair p σ' M_f L_f Δ f₁ f₂ →
      sjcHoloLipPair p σ' (|c| * M_f) (|c| * L_f) Δ
        (fun z => (c : ℂ) * f₁ z) (fun z => (c : ℂ) * f₂ z) := by
    intro p σ' M_f L_f Δ c f₁ f₂ hf
    refine ⟨mul_nonneg (abs_nonneg c) hf.1, mul_nonneg (abs_nonneg c) hf.2.1, hf.2.2.1,
      hCalc.holo_real_mul c hf.1 hf.2.2.2.1, hCalc.holo_real_mul c hf.1 hf.2.2.2.2.1, ?_⟩
    have hDiff := hCalc.bounded_const_mul (c : ℂ) (mul_nonneg hf.2.1 hf.2.2.1) hf.2.2.2.2.2
    have hNorm : ‖(c : ℂ)‖ * (L_f * Δ) = (|c| * L_f) * Δ := by
      rw [Complex.norm_real, Real.norm_eq_abs, mul_assoc]
    rw [hNorm] at hDiff
    exact hBnd_congr hDiff (fun _ _ => by ring)
  have hPair_real_mul_le : ∀ {p : ℕ} {σ' M_f L_f Δ : ℝ} (c : ℝ) {f₁ f₂ : ℂ → ℂ},
      |c| ≤ 1 → sjcHoloLipPair p σ' M_f L_f Δ f₁ f₂ →
      sjcHoloLipPair p σ' M_f L_f Δ
        (fun z => (c : ℂ) * f₁ z) (fun z => (c : ℂ) * f₂ z) := by
    intro p σ' M_f L_f Δ c f₁ f₂ hc hf
    exact hPair_mono
      (by nlinarith [hf.1]) (by nlinarith [hf.2.1]) (hPair_real_mul c hf)
  have hPair_mul : ∀ {p : ℕ} {σ' M_f L_f M_g L_g Δ : ℝ} {f₁ f₂ g₁ g₂ : ℂ → ℂ},
      sjcHoloLipPair p σ' M_f L_f Δ f₁ f₂ →
      sjcHoloLipPair p σ' M_g L_g Δ g₁ g₂ →
      sjcHoloLipPair p σ'
        ((2 : ℝ) ^ p * M_f * M_g)
        ((2 : ℝ) ^ p * (M_f * L_g + L_f * M_g))
        Δ
        (fun z => f₁ z * g₁ z) (fun z => f₂ z * g₂ z) := by
    intro p σ' M_f L_f M_g L_g Δ f₁ f₂ g₁ g₂ hf hg
    have hM_nn : 0 ≤ (2 : ℝ) ^ p * M_f * M_g :=
      mul_nonneg (mul_nonneg (by positivity) hf.1) hg.1
    have hL_nn : 0 ≤ (2 : ℝ) ^ p * (M_f * L_g + L_f * M_g) :=
      mul_nonneg (by positivity) (add_nonneg (mul_nonneg hf.1 hg.2.1) (mul_nonneg hf.2.1 hg.1))
    refine ⟨hM_nn, hL_nn, hf.2.2.1,
      hCalc.holo_mul hf.2.2.2.1 hg.2.2.2.1, hCalc.holo_mul hf.2.2.2.2.1 hg.2.2.2.2.1, ?_⟩
    have hDiff :=
      hCalc.bounded_mul_diff hf.2.2.2.1.1 hg.2.2.2.2.1.1 hf.2.2.2.2.2 hg.2.2.2.2.2
    have hEq : (2 : ℝ) ^ p * (M_f * (L_g * Δ) + (L_f * Δ) * M_g) =
        ((2 : ℝ) ^ p * (M_f * L_g + L_f * M_g)) * Δ := by ring
    rw [hEq] at hDiff
    exact hDiff
  have hPair_pow : ∀ {p : ℕ} {σ' M_f L_f Δ : ℝ} (d : ℕ) {f₁ f₂ : ℂ → ℂ},
      sjcHoloLipPair p σ' M_f L_f Δ f₁ f₂ →
      sjcHoloLipPair p σ' (sjcPowM p M_f d) (sjcPowL p M_f L_f d) Δ
        (fun z => f₁ z ^ d) (fun z => f₂ z ^ d) := by
    intro p σ' M_f L_f Δ d f₁ f₂ hf
    induction d with
    | zero =>
      have h1 := hPair_const_real p σ' 1 Δ hf.2.2.1
      rw [abs_of_nonneg zero_le_one] at h1
      exact hPair_congr h1 (fun _ _ => by simp) (fun _ _ => by simp)
    | succ k ih =>
      exact hPair_congr (hPair_mul ih hf)
        (fun _ _ => pow_succ _ _) (fun _ _ => pow_succ _ _)
  have hPair_div : ∀ {p : ℕ} {σ' M_f L_f M_g L_g Δ : ℝ} {f₁ f₂ g₁ g₂ : ℂ → ℂ},
      sjcHoloLipPair p σ' M_f L_f Δ f₁ f₂ →
      sjcHoloLipPair p σ' M_g L_g Δ g₁ g₂ →
      (∀ z ∈ horizStrip σ', ‖g₁ z - 1‖ ≤ 1 / 2 ∧ ‖g₂ z - 1‖ ≤ 1 / 2) →
      sjcHoloLipPair p σ'
        (sjcDivM p M_f M_g) (sjcDivL p M_f L_f M_g L_g) Δ
        (fun z => f₁ z / g₁ z) (fun z => f₂ z / g₂ z) := by
    intro p σ' M_f L_f M_g L_g Δ f₁ f₂ g₁ g₂ hf hg hClose
    have hInvM_nn : 0 ≤ sjcInvM p M_g :=
      mul_nonneg (by positivity) (hCompConst_pos p M_g)
    have hInvL_nn : 0 ≤ sjcInvL p M_g L_g :=
      mul_nonneg (mul_nonneg (by positivity) hInvM_nn) hg.2.1
    have hInvDiff :=
      hCalc.bounded_inv_diff hg.1 (mul_nonneg hg.2.1 hg.2.2.1)
        hg.2.2.2.1.1 hg.2.2.2.2.1.1
        (fun z hz => (hClose z hz).1) (fun z hz => (hClose z hz).2)
        hg.2.2.2.2.2
    have hEqInv :
        (2 : ℝ) ^ p * (((p + 1).factorial : ℝ) * (4 : ℝ) ^ (p + 2)) *
            shjCompConst p M_g * (L_g * Δ) =
          sjcInvL p M_g L_g * Δ := by
      dsimp [sjcInvL, sjcInvM]
      ring
    rw [hEqInv] at hInvDiff
    have hInvPair : sjcHoloLipPair p σ' (sjcInvM p M_g) (sjcInvL p M_g L_g) Δ
        (fun z => (g₁ z)⁻¹) (fun z => (g₂ z)⁻¹) :=
      ⟨hInvM_nn, hInvL_nn, hg.2.2.1,
        hCalc.holo_inv hg.1 hg.2.2.2.1 (fun z hz => (hClose z hz).1),
        hCalc.holo_inv hg.1 hg.2.2.2.2.1 (fun z hz => (hClose z hz).2),
        hInvDiff⟩
    exact hPair_congr (hPair_mul hf hInvPair)
      (fun _ _ => div_eq_mul_inv _ _) (fun _ _ => div_eq_mul_inv _ _)
  have hPair_param_int : ∀ {p : ℕ} {σ' M L Δ : ℝ} {F₁ F₂ : ℝ → ℂ → ℂ},
      (∀ z ∈ horizStrip σ',
        ContinuousOn (fun t => F₁ t z) (Set.Icc (0 : ℝ) 1) ∧
        ContinuousOn (fun t => F₂ t z) (Set.Icc (0 : ℝ) 1)) →
      (∀ t ∈ Set.Icc (0 : ℝ) 1, sjcHoloLipPair p σ' M L Δ (F₁ t) (F₂ t)) →
      sjcHoloLipPair p σ' M L Δ
        (fun z => ∫ t in (0 : ℝ)..1, F₁ t z)
        (fun z => ∫ t in (0 : ℝ)..1, F₂ t z) := by
    intro p σ' M L Δ F₁ F₂ hCont hF
    have h0 : (0 : ℝ) ∈ Set.Icc (0 : ℝ) 1 := ⟨le_rfl, zero_le_one⟩
    obtain ⟨hM, hL, hΔ, _, _, _⟩ := hF 0 h0
    refine ⟨hM, hL, hΔ,
      hCalc.param_int_holo p σ' M F₁ hM (fun z hz => (hCont z hz).1)
        (fun t ht => (hF t ht).2.2.2.1),
      hCalc.param_int_holo p σ' M F₂ hM (fun z hz => (hCont z hz).2)
        (fun t ht => (hF t ht).2.2.2.2.1),
      ?_⟩
    have hIntDiff :=
      (hCalc.param_int_bound p σ' (L * Δ) (fun t z => F₁ t z - F₂ t z)
        (mul_nonneg hL hΔ)
        (fun z hz => (hCont z hz).1.sub (hCont z hz).2)
        (fun t ht => (hF t ht).2.2.2.2.2)).1
    refine hBnd_congr hIntDiff ?_
    intro z hz
    have huIcc : Set.uIcc (0 : ℝ) 1 = Set.Icc (0 : ℝ) 1 := Set.uIcc_of_le zero_le_one
    have hInt1 : IntervalIntegrable (fun t => F₁ t z) MeasureTheory.volume (0 : ℝ) 1 := by
      apply ContinuousOn.intervalIntegrable
      rw [huIcc]
      exact (hCont z hz).1
    have hInt2 : IntervalIntegrable (fun t => F₂ t z) MeasureTheory.volume (0 : ℝ) 1 := by
      apply ContinuousOn.intervalIntegrable
      rw [huIcc]
      exact (hCont z hz).2
    exact (intervalIntegral.integral_sub hInt1 hInt2).symm
  have hPair_exp : ∀ {p : ℕ} {σ' M_f L_f Δ : ℝ} {f₁ f₂ : ℂ → ℂ},
      sjcHoloLipPair p σ' M_f L_f Δ f₁ f₂ →
      sjcHoloLipPair p σ' (sjcExpM p M_f) (sjcExpL p M_f L_f) Δ
        (fun z => Complex.exp (f₁ z)) (fun z => Complex.exp (f₂ z)) := by
    intro p σ' M_f L_f Δ f₁ f₂ hf
    obtain ⟨hMf, hLf, hΔ, hf₁, hf₂, hf_diff⟩ := hf
    let R : ℝ := M_f + 1
    have hR_pos : 0 < R := by linarith
    obtain ⟨hExp_holo, hExp_conj, hExp_bnd⟩ := hCalc.exp_ball_bound R hR_pos
    have hf₁_mem : ∀ z ∈ horizStrip σ', f₁ z ∈ Metric.ball (0 : ℂ) R := by
      intro z hz
      rw [mem_ball_zero_iff]
      have h0 := hf₁.1.2 0 (Nat.zero_le p) z hz
      rw [iteratedDeriv_zero] at h0
      linarith
    have hf₂_mem : ∀ z ∈ horizStrip σ', f₂ z ∈ Metric.ball (0 : ℂ) R := by
      intro z hz
      rw [mem_ball_zero_iff]
      have h0 := hf₂.1.2 0 (Nat.zero_le p) z hz
      rw [iteratedDeriv_zero] at h0
      linarith
    have hExpM_nn : 0 ≤ sjcExpM p M_f :=
      mul_nonneg (le_of_lt (Real.exp_pos _)) (hCompConst_pos p M_f)
    have hExpL_nn : 0 ≤ sjcExpL p M_f L_f :=
      mul_nonneg (hCompConst_pos p M_f)
        (mul_nonneg (mul_nonneg (by positivity) (le_of_lt (Real.exp_pos _))) hLf)
    have hBnd1 : IsStripBounded p σ' (sjcExpM p M_f) (fun z => Complex.exp (f₁ z)) :=
      hCalc.comp_bound p σ' (Real.exp R) M_f (Metric.ball (0 : ℂ) R) Complex.exp f₁
        Metric.isOpen_ball (le_of_lt (Real.exp_pos _)) hMf hExp_holo
        (fun j _ w hw => hExp_bnd j w hw) hf₁.1.1 hf₁_mem
        (fun j _ hj z hz => hf₁.1.2 j hj z hz)
    have hBnd2 : IsStripBounded p σ' (sjcExpM p M_f) (fun z => Complex.exp (f₂ z)) :=
      hCalc.comp_bound p σ' (Real.exp R) M_f (Metric.ball (0 : ℂ) R) Complex.exp f₂
        Metric.isOpen_ball (le_of_lt (Real.exp_pos _)) hMf hExp_holo
        (fun j _ w hw => hExp_bnd j w hw) hf₂.1.1 hf₂_mem
        (fun j _ hj z hz => hf₂.1.2 j hj z hz)
    have hDiff0 : ∀ j : ℕ, j ≤ p → ∀ w ∈ Metric.ball (0 : ℂ) R,
        ‖iteratedDeriv j (fun ζ => Complex.exp ζ - Complex.exp ζ) w‖ ≤ 0 := by
      intro j _ w _
      simp only [sub_self]
      rcases j with _ | j <;> simp
    have hCompDiff :=
      hCalc.comp_diff_bound p σ' (Real.exp R) 0 M_f (L_f * Δ) (Metric.ball (0 : ℂ) R)
        Complex.exp Complex.exp f₁ f₂
        Metric.isOpen_ball (convex_ball (0 : ℂ) R)
        (le_of_lt (Real.exp_pos _)) le_rfl hMf (mul_nonneg hLf hΔ)
        hExp_holo hExp_holo hDiff0 (fun j _ w hw => hExp_bnd j w hw)
        hf₁.1.1 hf₂.1.1 hf₁_mem hf₂_mem
        (fun j _ hj z hz => hf₁.1.2 j hj z hz)
        (fun j _ hj z hz => hf₂.1.2 j hj z hz)
        hf_diff
    have hEqL : shjCompConst p M_f * (0 + (2 : ℝ) ^ p * Real.exp R * (L_f * Δ)) =
        sjcExpL p M_f L_f * Δ := by
      dsimp [sjcExpL, R]
      ring
    rw [hEqL] at hCompDiff
    refine ⟨hExpM_nn, hExpL_nn, hΔ,
      ⟨hBnd1, fun z hz => by dsimp only; rw [hf₁.2.1 z hz],
        fun z hz => by dsimp only; rw [hf₁.2.2 z hz, hExp_conj]⟩,
      ⟨hBnd2, fun z hz => by dsimp only; rw [hf₂.2.1 z hz],
        fun z hz => by dsimp only; rw [hf₂.2.2 z hz, hExp_conj]⟩,
      hCompDiff⟩
  have hPair_sin : ∀ {p : ℕ} {σ' M_f L_f Δ : ℝ} {f₁ f₂ : ℂ → ℂ},
      sjcHoloLipPair p σ' M_f L_f Δ f₁ f₂ →
      sjcHoloLipPair p σ' (sjcExpM p M_f) (sjcExpL p M_f L_f) Δ
        (fun z => Complex.sin (f₁ z)) (fun z => Complex.sin (f₂ z)) := by
    intro p σ' M_f L_f Δ f₁ f₂ hf
    obtain ⟨hMf, hLf, hΔ, hf₁, hf₂, hf_diff⟩ := hf
    let R : ℝ := M_f + 1
    have hR_pos : 0 < R := by linarith
    obtain ⟨hSin_holo, hSin_conj, hSin_bnd⟩ := hCalc.sin_ball_bound R hR_pos
