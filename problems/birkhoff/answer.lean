      have hmB : ModEq j (B * (X_ε ^ j * ι₀ δA))
          (X_ε ^ j * ι₀ (δA * pointArcSlice2D1D 0 B)) := by
        refine hMod_trans (hMod_mul_vanish B _ (hVE_mul_any _ (hVE_X_pow j))) ?_
        rw [← mul_assoc, mul_comm (ι₀ _), mul_assoc, ← hι_mul, mul_comm δA]
        exact hMod_refl j _
      have htot := hMod_add (hMod_add (hMod_refl j (A * B)) (hMod_add hmA hmB)) hq0
      rwa [add_zero, ← mul_add (X_ε ^ j), ← hι_add] at htot
    have hMod_add_pert : ∀ {j : ℕ} {A A₀ B B₀ : MvPowerSeries (Fin 2) (PowerSeries ℂ)}
        {δA δB : MvPowerSeries (Fin 2) ℂ},
        ModEq j A (A₀ + X_ε ^ j * ι₀ δA) →
        ModEq j B (B₀ + X_ε ^ j * ι₀ δB) →
        ModEq j (A + B) ((A₀ + B₀) + X_ε ^ j * ι₀ (δA + δB)) := by
      intro j A A₀ B B₀ δA δB hA hB
      have hs := hMod_add hA hB
      have halg : (A₀ + X_ε ^ j * ι₀ δA) + (B₀ + X_ε ^ j * ι₀ δB) =
          (A₀ + B₀) + X_ε ^ j * (ι₀ δA + ι₀ δB) := by ring
      rwa [halg, ← hι_add] at hs
    have hMod_sub_pert : ∀ {j : ℕ} {A A₀ B B₀ : MvPowerSeries (Fin 2) (PowerSeries ℂ)}
        {δA δB : MvPowerSeries (Fin 2) ℂ},
        ModEq j A (A₀ + X_ε ^ j * ι₀ δA) →
        ModEq j B (B₀ + X_ε ^ j * ι₀ δB) →
        ModEq j (A - B) ((A₀ - B₀) + X_ε ^ j * ι₀ (δA - δB)) := by
      intro j A A₀ B B₀ δA δB hA hB
      have hs := hMod_sub hA hB
      have halg : (A₀ + X_ε ^ j * ι₀ δA) - (B₀ + X_ε ^ j * ι₀ δB) =
          (A₀ - B₀) + X_ε ^ j * (ι₀ δA - ι₀ δB) := by ring
      rwa [halg, ← hι_sub] at hs
    have hMod_rel_pert : ∀ {j : ℕ} {A A₀ : MvPowerSeries (Fin 2) (PowerSeries ℂ)}
        {δA : MvPowerSeries (Fin 2) ℂ} (c₁ c₂ : ℂ),
        ModEq j A (A₀ + X_ε ^ j * ι₀ δA) →
        ModEq j
          ((A - MvPowerSeries.C (PowerSeries.C c₁)) * MvPowerSeries.C (PowerSeries.C c₂))
          ((A₀ - MvPowerSeries.C (PowerSeries.C c₁)) * MvPowerSeries.C (PowerSeries.C c₂) +
            X_ε ^ j * ι₀ (δA * MvPowerSeries.C c₂)) := by
      intro j A A₀ δA c₁ c₂ hA
      have hm := hMod_mul
        (hMod_sub hA (hMod_refl j (MvPowerSeries.C (PowerSeries.C c₁))))
        (hMod_refl j (MvPowerSeries.C (PowerSeries.C c₂)))
      have halg :
          ((A₀ + X_ε ^ j * ι₀ δA) - MvPowerSeries.C (PowerSeries.C c₁)) *
            MvPowerSeries.C (PowerSeries.C c₂) =
          (A₀ - MvPowerSeries.C (PowerSeries.C c₁)) * MvPowerSeries.C (PowerSeries.C c₂) +
            X_ε ^ j * (ι₀ δA * MvPowerSeries.C (PowerSeries.C c₂)) := by ring
      have hc2_mul : ι₀ δA * MvPowerSeries.C (PowerSeries.C c₂) =
          ι₀ (δA * MvPowerSeries.C c₂) := by
        rw [← hι_C c₂, ← hι_mul]
      rwa [halg, hc2_mul] at hm
    have hMod_C_mul_pert : ∀ {j : ℕ} {A A₀ : MvPowerSeries (Fin 2) (PowerSeries ℂ)}
        {δA : MvPowerSeries (Fin 2) ℂ} (c : ℂ),
        ModEq j A (A₀ + X_ε ^ j * ι₀ δA) →
        ModEq j
          (MvPowerSeries.C (PowerSeries.C c) * A)
          (MvPowerSeries.C (PowerSeries.C c) * A₀ +
            X_ε ^ j * ι₀ (MvPowerSeries.C c * δA)) := by
      intro j A A₀ δA c hA
      have hm := hMod_mul (hMod_refl j (MvPowerSeries.C (PowerSeries.C c))) hA
      have halg :
          MvPowerSeries.C (PowerSeries.C c) * (A₀ + X_ε ^ j * ι₀ δA) =
          MvPowerSeries.C (PowerSeries.C c) * A₀ +
            X_ε ^ j * (MvPowerSeries.C (PowerSeries.C c) * ι₀ δA) := by ring
      have hc_mul : MvPowerSeries.C (PowerSeries.C c) * ι₀ δA =
          ι₀ (MvPowerSeries.C c * δA) := by
        rw [← hι_C c, ← hι_mul]
      rwa [halg, hc_mul] at hm
    have hAbsc_trunc_mod : ∀ {k : ℕ} (J : ℕ)
        (β_full : ℕ → Fin (k + 1) → MvPowerSeries (Fin 2) ℂ) (u : Fin (k + 1)),
        ModEq (J + 1)
          (pointArcFormalAbscissa2D1D β_full u)
          (pointArcFormalAbscissa2D1D (pointArcTruncBeta (J + 1) β_full) u) := by
      intro k J β_full u l hl
      have hl_le : l ≤ J + 1 := by omega
      rw [hSlice_zero_iff]; intro d
      rw [map_sub, map_sub, sub_eq_zero]
      have hd1 : MvPowerSeries.coeff d (pointArcFormalAbscissa2D1D β_full u) =
          PowerSeries.mk (fun l' => MvPowerSeries.coeff d (β_full l' u)) := rfl
      have hd2 : MvPowerSeries.coeff d
          (pointArcFormalAbscissa2D1D (pointArcTruncBeta (J + 1) β_full) u) =
          PowerSeries.mk (fun l' =>
            MvPowerSeries.coeff d (pointArcTruncBeta (J + 1) β_full l' u)) := rfl
      rw [hd1, hd2, PowerSeries.coeff_mk, PowerSeries.coeff_mk]
      simp [pointArcTruncBeta, hl_le]
    have hAbsc_top_split : ∀ {k : ℕ} (J : ℕ)
        (β_full : ℕ → Fin (k + 1) → MvPowerSeries (Fin 2) ℂ) (u : Fin (k + 1)),
        pointArcFormalAbscissa2D1D (pointArcTruncBeta (J + 1) β_full) u =
          pointArcFormalAbscissa2D1D (pointArcTruncBeta J β_full) u +
            X_ε ^ (J + 1) * ι₀ (β_full (J + 1) u) := by
      intro k J β_full u; ext d l
      rw [map_add, map_add]
      have hd1 : MvPowerSeries.coeff d
          (pointArcFormalAbscissa2D1D (pointArcTruncBeta (J + 1) β_full) u) =
          PowerSeries.mk (fun l' => MvPowerSeries.coeff d (pointArcTruncBeta (J + 1) β_full l' u)) := rfl
      have hd2 : MvPowerSeries.coeff d
          (pointArcFormalAbscissa2D1D (pointArcTruncBeta J β_full) u) =
          PowerSeries.mk (fun l' => MvPowerSeries.coeff d (pointArcTruncBeta J β_full l' u)) := rfl
      rw [hd1, hd2, PowerSeries.coeff_mk, PowerSeries.coeff_mk]
      dsimp only [X_ε, pointArcTruncBeta]
      rw [← map_pow, MvPowerSeries.coeff_C_mul]
      have h0 : MvPowerSeries.coeff d (ι₀ (β_full (J + 1) u)) =
          PowerSeries.C (MvPowerSeries.coeff d (β_full (J + 1) u)) := rfl
      rw [h0, mul_comm, PowerSeries.coeff_C_mul_X_pow]
      by_cases hlj : l = J + 1
      · subst hlj
        rw [if_pos le_rfl, if_neg (by omega), if_pos rfl, map_zero, zero_add]
      · rw [if_neg hlj, add_zero]
        by_cases hlJ : l ≤ J
        · rw [if_pos (by omega), if_pos hlJ]
        · rw [if_neg (by omega), if_neg hlJ]
    have hEdgeRel0_zero : ∀ {k : ℕ} (ℓ_star : Fin k → ℂ) (x_star : Fin (k + 1) → ℂ)
        (f₀ : Fin (k + 1) → PowerSeries ℂ) (β₀ : Fin (k + 1) → MvPowerSeries (Fin 2) ℂ),
        (∀ r : Fin (k + 1), MvPowerSeries.coeff 0 (β₀ r) = 0) →
        (∀ i : Fin k,
          (ℓ_star i) ^ 2 =
            (x_star i.succ - x_star i.castSucc) ^ 2 +
              (PowerSeries.constantCoeff (f₀ i.succ) -
                PowerSeries.constantCoeff (f₀ i.castSucc)) ^ 2) →
        ∀ i : Fin k, MvPowerSeries.coeff 0 (pointRecEdgeRel0 ℓ_star x_star f₀ β₀ i) = 0 := by
      intro k ℓ_star x_star f₀ β₀ hβ0 hℓ_sq i
      have hcomp0 : ∀ u : Fin (k + 1),
          MvPowerSeries.coeff 0 (compPowerSeries2D (f₀ u) (β₀ u)) =
            PowerSeries.constantCoeff (f₀ u) := by
        intro u
        change ∑ n ∈ Finset.range (0 + 0 + 1), _ = _
        rw [Finset.range_one, Finset.sum_singleton, pow_zero, MvPowerSeries.coeff_one,
          if_pos rfl, mul_one, PowerSeries.coeff_zero_eq_constantCoeff]
      dsimp only [pointRecEdgeRel0, pointRecEdgeSq0, pointRecDx0, pointRecDy0]
      rw [MvPowerSeries.coeff_zero_eq_constantCoeff, map_mul, map_sub, map_add,
        map_pow, map_pow, MvPowerSeries.constantCoeff_C, MvPowerSeries.constantCoeff_C,
        map_add, MvPowerSeries.constantCoeff_C, map_sub, map_sub]
      simp only [← MvPowerSeries.coeff_zero_eq_constantCoeff] at *
      rw [hβ0 i.succ, hβ0 i.castSucc, hcomp0 i.succ, hcomp0 i.castSucc, hℓ_sq i]
      ring
    have hLen_InvLen_mul : ∀ {k : ℕ} (ℓ_star : Fin k → ℂ) (x_star : Fin (k + 1) → ℂ)
        (f₀ : Fin (k + 1) → PowerSeries ℂ) (β₀ : Fin (k + 1) → MvPowerSeries (Fin 2) ℂ),
        (∀ i : Fin k, ℓ_star i ≠ 0) →
        (∀ i : Fin k, MvPowerSeries.coeff 0 (pointRecEdgeRel0 ℓ_star x_star f₀ β₀ i) = 0) →
        ∀ i : Fin k,
          pointRecLen0 ℓ_star x_star f₀ β₀ i * pointRecInvLen0 ℓ_star x_star f₀ β₀ i = 1 := by
      intro k ℓ_star x_star f₀ β₀ hℓ_ne hRel0 i
      calc pointRecLen0 ℓ_star x_star f₀ β₀ i * pointRecInvLen0 ℓ_star x_star f₀ β₀ i
          = (MvPowerSeries.C (ℓ_star i) * MvPowerSeries.C ((ℓ_star i)⁻¹)) *
              (compPowerSeries2D S (pointRecEdgeRel0 ℓ_star x_star f₀ β₀ i) *
                compPowerSeries2D I (pointRecEdgeRel0 ℓ_star x_star f₀ β₀ i)) := by
              dsimp only [pointRecLen0, pointRecInvLen0]; ring
        _ = 1 * 1 := by
              rw [← map_mul, mul_inv_cancel₀ (hℓ_ne i), map_one, hcomp2D_SI (hRel0 i)]
        _ = 1 := one_mul 1
    have hTelescope : ∀ {k : ℕ} (_hk : 2 ≤ k) (A B : Fin k → MvPowerSeries (Fin 2) ℂ)
        (V : Fin (k + 1) → MvPowerSeries (Fin 2) ℂ),
        V 0 = 0 → V (Fin.last k) = 0 →
        (∑ i : Fin k, (A i * V i.succ - B i * V i.castSucc)) =
          ∑ r : Fin (k - 1),
            (A ⟨r.1, by have := r.2; omega⟩ - B ⟨r.1 + 1, by have := r.2; omega⟩) *
              V ⟨r.1 + 1, by have := r.2; omega⟩ := by
      intro k hk A B V hV0 hVk
      rw [Finset.sum_sub_distrib]
      have h_succ : (∑ i : Fin k, A i * V i.succ) =
          ∑ r : Fin (k - 1),
            A ⟨r.1, by have := r.2; omega⟩ * V ⟨r.1 + 1, by have := r.2; omega⟩ := by
        have h_filt : (∑ i : Fin k, A i * V i.succ) =
            ∑ i ∈ (Finset.univ : Finset (Fin k)).filter (fun i => i.1 < k - 1), A i * V i.succ := by
          symm
          refine Finset.sum_subset (Finset.filter_subset _ _) ?_
          intro i _ hnot
          simp only [Finset.mem_filter, Finset.mem_univ, true_and, not_lt] at hnot
          have hik : i.1 = k - 1 := by have := i.2; omega
          have hlast : i.succ = Fin.last k := by ext; dsimp; omega
          rw [hlast, hVk, mul_zero]
        rw [h_filt]
        symm
        refine Finset.sum_bij (fun (r : Fin (k - 1)) _ => (⟨r.1, by have := r.2; omega⟩ : Fin k))
          ?_ ?_ ?_ ?_
        · intro r _; simp [r.2]
        · intro r₁ _ r₂ _ heq; ext; exact Fin.mk.inj heq
        · intro i hi
          rw [Finset.mem_filter] at hi
          exact ⟨⟨i.1, hi.2⟩, Finset.mem_univ _, by ext; rfl⟩
        · intro r _; rfl
      have h_cast : (∑ i : Fin k, B i * V i.castSucc) =
          ∑ r : Fin (k - 1),
            B ⟨r.1 + 1, by have := r.2; omega⟩ * V ⟨r.1 + 1, by have := r.2; omega⟩ := by
        have h_filt : (∑ i : Fin k, B i * V i.castSucc) =
            ∑ i ∈ (Finset.univ : Finset (Fin k)).filter (fun i => i.1 ≠ 0), B i * V i.castSucc := by
          symm
          refine Finset.sum_subset (Finset.filter_subset _ _) ?_
          intro i _ hnot
          simp only [Finset.mem_filter, Finset.mem_univ, true_and, not_ne_iff] at hnot
          have h0 : i.castSucc = 0 := by ext; exact hnot
          rw [h0, hV0, mul_zero]
        rw [h_filt]
        symm
        refine Finset.sum_bij (fun (r : Fin (k - 1)) _ => (⟨r.1 + 1, by have := r.2; omega⟩ : Fin k))
          ?_ ?_ ?_ ?_
        · intro r _; simp
        · intro r₁ _ r₂ _ heq; ext; have := Fin.mk.inj heq; omega
        · intro i hi
          rw [Finset.mem_filter] at hi
          exact ⟨⟨i.1 - 1, by have := i.2; have := hi.2; omega⟩, Finset.mem_univ _,
            by ext; dsimp; have := hi.2; omega⟩
        · intro r _; rfl
      rw [h_succ, h_cast, ← Finset.sum_sub_distrib]
      apply Finset.sum_congr rfl; intro r _
      ring
    have h_len_top :
        ∀ {k : ℕ} (_hk : 2 ≤ k) (ℓ_star : Fin k → ℂ) (x_star : Fin (k + 1) → ℂ)
          (f_full : Fin (k + 1) → ℕ → PowerSeries ℂ)
          (β_full : ℕ → Fin (k + 1) → MvPowerSeries (Fin 2) ℂ),
          (∀ i : Fin k, ℓ_star i ≠ 0) →
          (∀ r : Fin (k + 1), MvPowerSeries.coeff 0 (β_full 0 r) = 0) →
          (∀ i : Fin k,
            (ℓ_star i) ^ 2 =
              (x_star i.succ - x_star i.castSucc) ^ 2 +
                (PowerSeries.constantCoeff (f_full i.succ 0) -
                  PowerSeries.constantCoeff (f_full i.castSucc 0)) ^ 2) →
          (∀ J : ℕ, f_full 0 (J + 1) = 0 ∧ f_full (Fin.last k) (J + 1) = 0) →
          (∀ J : ℕ, β_full (J + 1) 0 = 0 ∧ β_full (J + 1) (Fin.last k) = 0) →
          ∀ J : ℕ,
            pointArcSlice2D1D (J + 1) (pointArcFormalLen2D1D ℓ_star x_star f_full β_full) =
              pointArcSlice2D1D (J + 1)
                  (pointArcFormalLen2D1D ℓ_star x_star
                    (pointArcTruncGraph J f_full) (pointArcTruncBeta J β_full)) +
                (∑ r : Fin (k - 1),
                  pointRecWeight0 ℓ_star x_star (fun u => f_full u 0) (β_full 0) r *
                    compPowerSeries2D
                      (f_full ⟨r.1 + 1, by have := r.2; omega⟩ (J + 1))
                      (β_full 0 ⟨r.1 + 1, by have := r.2; omega⟩)) +
                ∑ r : Fin (k - 1),
                  pointRecGrad0 ℓ_star x_star (fun u => f_full u 0) (β_full 0) r *
                    β_full (J + 1) ⟨r.1 + 1, by have := r.2; omega⟩ := by
      intro k hk ℓ_star x_star f_full β_full hℓ_ne hβ0 hℓ_sq hf_end hβ_end J
      let j := J + 1
      let f₀ := fun u => f_full u 0
      let β₀ := β_full 0
      let f_j := pointArcTruncGraph j f_full
      let f_J := pointArcTruncGraph J f_full
      let β_j := pointArcTruncBeta j β_full
      let β_J := pointArcTruncBeta J β_full
      have hRel0 : ∀ i : Fin k, MvPowerSeries.coeff 0 (pointRecEdgeRel0 ℓ_star x_star f₀ β₀ i) = 0 :=
        hEdgeRel0_zero ℓ_star x_star f₀ β₀ hβ0 hℓ_sq
      have hAbsc_sl0 : ∀ u : Fin (k + 1),
          pointArcSlice2D1D 0 (pointArcFormalAbscissa2D1D β_J u) = β₀ u := by
        intro u; ext d
        change PowerSeries.coeff 0 (MvPowerSeries.coeff d (pointArcFormalAbscissa2D1D β_J u)) = _
        have hd : MvPowerSeries.coeff d (pointArcFormalAbscissa2D1D β_J u) =
            PowerSeries.mk (fun l => MvPowerSeries.coeff d (β_J l u)) := rfl
        rw [hd, PowerSeries.coeff_mk]
        simp [β_J, pointArcTruncBeta, β₀]
      have hAbsc_sl0_zero : ∀ u : Fin (k + 1),
          MvPowerSeries.coeff 0 (pointArcSlice2D1D 0 (pointArcFormalAbscissa2D1D β_J u)) = 0 := by
        intro u; rw [hAbsc_sl0]; exact hβ0 u
      have hDx_sl0 : ∀ i : Fin k,
          pointArcSlice2D1D 0 (pointArcFormalDx2D1D x_star β_J i) = pointRecDx0 x_star β₀ i := by
        intro i
        dsimp only [pointArcFormalDx2D1D, pointRecDx0]
        rw [hslice0_add, hslice0_C, hslice0_sub, hAbsc_sl0, hAbsc_sl0]
      have hDy_sl0 : ∀ i : Fin k,
          pointArcSlice2D1D 0 (pointArcFormalDy2D1D f_J β_J i) = pointRecDy0 f₀ β₀ i := by
        intro i
        dsimp only [pointArcFormalDy2D1D, pointRecDy0]
        rw [hslice0_sub, hslice0_comp2D1D _ (hAbsc_sl0_zero i.succ),
          hslice0_comp2D1D _ (hAbsc_sl0_zero i.castSucc), hAbsc_sl0, hAbsc_sl0]
        simp [f_J, pointArcTruncGraph, f₀]
      have hRel_sl0 : ∀ i : Fin k,
          pointArcSlice2D1D 0 (pointArcFormalEdgeRel2D1D ℓ_star x_star f_J β_J i) =
            pointRecEdgeRel0 ℓ_star x_star f₀ β₀ i := by
        intro i
        dsimp only [pointArcFormalEdgeRel2D1D, pointArcFormalEdgeSq2D1D,
          pointRecEdgeRel0, pointRecEdgeSq0]
        rw [hslice0_mul, hslice0_sub, hslice0_add, hslice0_pow, hslice0_pow,
          hslice0_C, hslice0_C, hDx_sl0, hDy_sl0]
      let g_top : Fin (k + 1) → MvPowerSeries (Fin 2) ℂ :=
        fun u => compPowerSeries2D (f_full u j) (β₀ u)
      let F'₀ : Fin (k + 1) → MvPowerSeries (Fin 2) ℂ :=
        fun u => compPowerSeries2D (PowerSeries.derivative (f₀ u)) (β₀ u)
      have hComp_u_pert : ∀ u : Fin (k + 1),
          ModEq j
            (pointArcComp2D1D (f_full u) (pointArcFormalAbscissa2D1D β_full u))
            (pointArcComp2D1D (f_J u) (pointArcFormalAbscissa2D1D β_J u) +
              X_ε ^ j * ι₀ (g_top u + F'₀ u * β_full j u)) := by
        intro u
        have ht1 : ModEq j
            (pointArcComp2D1D (f_full u) (pointArcFormalAbscissa2D1D β_full u))
            (pointArcComp2D1D (f_j u) (pointArcFormalAbscissa2D1D β_j u)) :=
          hMod_comp_trunc_seq _ _ (fun l hl => by simp [f_j, pointArcTruncGraph, hl])
            (hAbsc_trunc_mod J β_full u)
        have ht2 : ModEq j
            (pointArcComp2D1D (f_j u) (pointArcFormalAbscissa2D1D β_j u))
            (pointArcComp2D1D (f_j u) (pointArcFormalAbscissa2D1D β_J u) +
              X_ε ^ j * ι₀ (F'₀ u * β_full j u)) := by
          rw [hAbsc_top_split J β_full u]
          have hf_j0 : f_j u 0 = f₀ u := by simp [f_j, pointArcTruncGraph, f₀]
          simpa only [hf_j0, hAbsc_sl0] using
            hMod_comp_arg_pert (f_j u) (β_full j u) (hAbsc_sl0_zero u)
        have ht3 := hMod_comp_graph_pert (J := J) (f_full u) (hAbsc_sl0_zero u)
        rw [hAbsc_sl0] at ht3
        refine hMod_trans ht1 (hMod_trans ht2 ?_)
        have hcomb := hMod_add ht3 (hMod_refl j (X_ε ^ j * ι₀ (F'₀ u * β_full j u)))
        rwa [add_assoc, ← mul_add, ← hι_add] at hcomb
      have hDx_pert : ∀ i : Fin k,
          ModEq j
            (pointArcFormalDx2D1D x_star β_full i)
            (pointArcFormalDx2D1D x_star β_J i +
              X_ε ^ j * ι₀ (β_full j i.succ - β_full j i.castSucc)) := by
        intro i
        have hsub_absc : ModEq j
            (pointArcFormalAbscissa2D1D β_full i.succ -
              pointArcFormalAbscissa2D1D β_full i.castSucc)
            ((pointArcFormalAbscissa2D1D β_J i.succ -
              pointArcFormalAbscissa2D1D β_J i.castSucc) +
              X_ε ^ j * ι₀ (β_full j i.succ - β_full j i.castSucc)) := by
          refine hMod_sub_pert ?_ ?_
          · rw [← hAbsc_top_split J β_full i.succ]; exact hAbsc_trunc_mod J β_full i.succ
          · rw [← hAbsc_top_split J β_full i.castSucc]; exact hAbsc_trunc_mod J β_full i.castSucc
        have hadd := hMod_add
          (hMod_refl j (MvPowerSeries.C (PowerSeries.C (x_star i.succ - x_star i.castSucc))))
          hsub_absc
        rwa [← add_assoc] at hadd
      let δy : Fin k → MvPowerSeries (Fin 2) ℂ := fun i =>
        (g_top i.succ - g_top i.castSucc) +
          (F'₀ i.succ * β_full j i.succ - F'₀ i.castSucc * β_full j i.castSucc)
      have hDy_pert : ∀ i : Fin k,
          ModEq j
            (pointArcFormalDy2D1D f_full β_full i)
            (pointArcFormalDy2D1D f_J β_J i + X_ε ^ j * ι₀ (δy i)) := by
        intro i
        have hs := hMod_sub_pert (hComp_u_pert i.succ) (hComp_u_pert i.castSucc)
        have hδy_eq : (g_top i.succ + F'₀ i.succ * β_full j i.succ) -
            (g_top i.castSucc + F'₀ i.castSucc * β_full j i.castSucc) = δy i := by
          dsimp only [δy]; ring
        rwa [hδy_eq] at hs
      let edge_top : Fin k → MvPowerSeries (Fin 2) ℂ := fun i =>
        (pointRecDx0 x_star β₀ i * (β_full j i.succ - β_full j i.castSucc) +
          pointRecDy0 f₀ β₀ i * δy i) *
          pointRecInvLen0 ℓ_star x_star f₀ β₀ i
      have hEdgeLen_pert : ∀ i : Fin k,
