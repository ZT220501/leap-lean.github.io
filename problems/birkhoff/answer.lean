      lineCoreCoeffsIn L U₁ → lineCoreCoeffsIn L U₂ →
      lineCoreCoeffsIn L (lineCoreComp2D F U₁ U₂) := by
    intro L F U₁ U₂ hF _hU₁0 _hU₂0 hU₁ hU₂ d
    rw [MvPowerSeries.coeff_apply, lineCoreComp2D]
    exact L.sum_mem fun a _ =>
      L.sum_mem fun b _ =>
        L.mul_mem (hF _) (h_mul_mem L (h_pow_mem L hU₁ a) (h_pow_mem L hU₂ b) d)
  have h_pos_of_deriv_mem : ∀ (L : Subfield ℂ) {S : MvPowerSeries (Fin 2) ℂ},
