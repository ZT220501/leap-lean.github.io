            ε ^ (l + 1) *
              (∑ j ∈ Finset.Ico 2 (l + 1),
                lineCoalescingDslopeIter F z₀ j z₀ *
                  (ε ^ (j - 2) * W_Δ ε *
                    ∑ q ∈ Finset.range j, (D_A ε) ^ q * (dslope B 0 ε) ^ (j - 1 - q))) := by
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl fun j hj => ?_
