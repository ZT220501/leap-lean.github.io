          linarith
        rw [h_ioo_ioc, hper_eq]
        exact mul_le_mul_of_nonneg_left hint_bound hr0.le
      have h_lhs_int : MeasureTheory.IntegrableOn
          (fun r : ℝ => ∫ θ in Set.Ioo (-Real.pi) Real.pi, r * g (circleMap z₀ r θ))
          (Set.Ioo (0 : ℝ) R) MeasureTheory.volume := by
        rw [MeasureTheory.IntegrableOn, ← MeasureTheory.Measure.prod_restrict] at hprod_int'
        exact hprod_int'.integral_prod_left
