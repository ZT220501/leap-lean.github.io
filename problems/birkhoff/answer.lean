          ∑ s ∈ Finset.range (N + 1),
            MvPowerSeries.C (PowerSeries.C (1 / (s.factorial : ℂ)) * A s) * Ψ_lift ^ s := by
        let G_term : ℕ → ℕ → MvPowerSeries (Fin 2) (PowerSeries ℂ) := fun n m =>
          MvPowerSeries.C
