    have hϕ_at : HasDerivAt S.ϕ (sliceSpeedSeq S P.N j.val y)
        (sliceImpactSeq S P.N j.val y) := by
      dsimp only [sliceSpeedSeq]
      rw [← S.deriv_ϕ _ hw_mem]
      exact (S.ϕ_holo.differentiableAt (h_open_H.mem_nhds hw_mem)).hasDerivAt
    exact (hϕ_at.comp y himp_at).deriv

  
  have h_sin_bounds : ∀ j : Fin P.N,
      ‖Complex.sin (P.d0 j y)‖ ≤ Real.exp (M ^ σ) ∧
