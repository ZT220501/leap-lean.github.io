        (Real.hasDerivAt_exp (-u)).hasFDerivAt.comp_hasDerivAt u (hasDerivAt_neg u)
    have h_fn : ν = fun t : ℝ => S.H + -Real.exp (-t) := by ext t; dsimp [ν]; ring
    rw [h_fn]
