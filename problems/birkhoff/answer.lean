      have hd1 := hδ₁ (lt_of_lt_of_le hdist (min_le_left _ _))
      have hd2 := hδ₂ (lt_of_lt_of_le hdist (min_le_right _ _))
      rw [dist_eq_norm] at hd1 hd2
      have hΛ_lo : c_Λ / 2 ≤ ‖Λ_fn p‖ := by
        have := norm_add_le (Λ_fn p) (Λ_fn p₀ - Λ_fn p)
        have h_eq : Λ_fn p + (Λ_fn p₀ - Λ_fn p) = Λ_fn p₀ := by ring
        rw [h_eq, norm_sub_rev] at this
        dsimp [c_Λ] at hd1 ⊢; linarith
      have hΛ_hi : ‖Λ_fn p‖ ≤ 2 * c_Λ := by
        have := norm_add_le (Λ_fn p₀) (Λ_fn p - Λ_fn p₀)
        have h_eq : Λ_fn p₀ + (Λ_fn p - Λ_fn p₀) = Λ_fn p := by ring
        rw [h_eq] at this
        dsimp [c_Λ] at hd1 ⊢; linarith
      have hk_lo : c_k / 2 ≤ ‖k_lim p‖ := by
        have := norm_add_le (k_lim p) (k_lim p₀ - k_lim p)
        have h_eq : k_lim p + (k_lim p₀ - k_lim p) = k_lim p₀ := by ring
        rw [h_eq, norm_sub_rev] at this
        dsimp [c_k] at hd2 ⊢; linarith
      have hk_hi : ‖k_lim p‖ ≤ 2 * c_k := by
        have := norm_add_le (k_lim p₀) (k_lim p - k_lim p₀)
        have h_eq : k_lim p₀ + (k_lim p - k_lim p₀) = k_lim p := by ring
        rw [h_eq] at this
        dsimp [c_k] at hd2 ⊢; linarith
      exact ⟨hΛ_lo, hΛ_hi, hk_lo, hk_hi, norm_pos_iff.mp (by linarith)⟩

    
    have h_unif_all : ∀ ε : ℝ, 0 < ε → ∃ N ≥ N₀, ∀ n ≥ N, ∀ p ∈ U_δ,
        ‖k0Kernel (Q_seq n p) 1 - 1‖ < ε ∧
        ‖a₀_seq n p - Λ_fn p‖ < ε ∧
        ‖(a₀_seq n p * c0Kernel (Q_seq n p) 1 + a₁_seq n p * k0Kernel (Q_seq n p) 1) -
          Λ_fn p‖ < ε ∧
        ‖kPlusVal (Q_seq n p) (a₀_seq n p) (a₁_seq n p) - k_lim p‖ < ε ∧
        ‖kMinusVal (Q_seq n p) (a₀_seq n p) (a₁_seq n p) - k_lim p‖ < ε := by
      intro ε hε
      let M_pert : ℝ := c_Λ ^ 2 + 2
      have hM_pert_nonneg : 0 ≤ M_pert := by positivity
      let η_pert : ℝ := min 1 (ε / (2 * Real.exp M_pert))
      have hη_pert_pos : 0 < η_pert := lt_min zero_lt_one (by positivity)
      let A_Fw : ℝ := (2 * c_Λ + 1) * Real.exp 1 + 1 + Real.exp 1
      have hA_Fw_pos : 0 < A_Fw := by positivity
      let A_Fpw : ℝ := (2 * c_Λ + 1) * (2 * Real.exp 1) + (1 + Real.exp 1)
      have hA_Fpw_pos : 0 < A_Fpw := by positivity
      let C_comb : ℝ := 1 + 2 * A_Fpw + (c_Λ + 1) * A_Fw + Real.exp 1
      have hC_comb_pos : 0 < C_comb := by positivity
      have hA_Fw_le_C : A_Fw ≤ C_comb := by
        have h1 : 1 * A_Fw ≤ (c_Λ + 1) * A_Fw :=
          mul_le_mul_of_nonneg_right (by linarith) hA_Fw_pos.le
        dsimp [C_comb]
        linarith [Real.exp_pos 1]
      let δ_in : ℝ := min 1 (min (ε / (2 * C_comb)) (η_pert / C_comb))
      have hδ_in_pos : 0 < δ_in :=
        lt_min zero_lt_one (lt_min (by positivity) (by positivity))
      obtain ⟨N_Q, hNQ0, hNQ⟩ := h3_Q δ_in hδ_in_pos
      obtain ⟨N_a0, _, hNa0⟩ := h3_a0 δ_in hδ_in_pos
      obtain ⟨N_a1, _, hNa1⟩ := h3_a1 δ_in hδ_in_pos
      refine ⟨max N_Q (max N_a0 N_a1), le_trans hNQ0 (le_max_left _ _), ?_⟩
      intro n hn p hp
      have hp1 : p ∈ U₁ := hU_sub hp
      have hn0 : N₀ ≤ n := le_trans hNQ0 (le_trans (le_max_left _ _) hn)
      have hnQ : N_Q ≤ n := le_trans (le_max_left _ _) hn
      have hna0 : N_a0 ≤ n := le_trans (le_trans (le_max_left _ _) (le_max_right _ _)) hn
      have hna1 : N_a1 ≤ n := le_trans (le_trans (le_max_right _ _) (le_max_right _ _)) hn
      obtain ⟨_, hΛ_hi, _, _, hΛ_ne⟩ := h_bounds_Uδ p hp
      have hδ_in_le1 : δ_in ≤ 1 := min_le_left _ _
      have hQ_cont_p : ContinuousOn (Q_seq n p) (Set.Icc (0 : ℝ) 1) :=
        hQ_slice_cont n hn0 p hp1
      have hQ_le : ∀ w ∈ Set.Icc (0 : ℝ) 1, ‖Q_seq n p w‖ ≤ δ_in := by
        intro w hw
        have := hNQ n hnQ p hp1 w hw
        rw [hq_zero p, sub_zero] at this
        exact this.le
      have h_lip1 := hVolt.2.1.1 1 δ_in (Q_seq n p) (fun _ => 0)
        zero_le_one hδ_in_pos.le hQ_cont_p continuousOn_const
        (fun w hw => ⟨le_trans (hQ_le w hw) hδ_in_le1, by simp, by simpa using hQ_le w hw⟩)
      have ha0_lt : ‖a₀_seq n p - Λ_fn p‖ < δ_in := by
        simpa [ha0_eq_Λ p] using hNa0 n hna0 p hp1
      have ha1_lt : ‖a₁_seq n p‖ < δ_in := hNa1 n hna1 p hp1
      have ha0_norm : ‖a₀_seq n p‖ ≤ 2 * c_Λ + 1 := by
        calc ‖a₀_seq n p‖ = ‖Λ_fn p + (a₀_seq n p - Λ_fn p)‖ := by ring_nf
          _ ≤ ‖Λ_fn p‖ + ‖a₀_seq n p - Λ_fn p‖ := norm_add_le _ _
          _ ≤ 2 * c_Λ + 1 := by linarith
      have h1_icc : (1 : ℝ) ∈ Set.Icc (0 : ℝ) 1 := ⟨zero_le_one, le_rfl⟩
      obtain ⟨hc0_0_1, _, hk0_0_1, _⟩ := h_kern_zero 1 h1_icc
      have hk0_diff : ‖k0Kernel (Q_seq n p) 1 - 1‖ ≤ Real.exp 1 * δ_in := by
        have h := (h_lip1 1 h1_icc).2.2.2.2.2.1
        rwa [hk0_0_1, Complex.ofReal_one] at h
      have hc0_diff : ‖c0Kernel (Q_seq n p) 1 - 1‖ ≤ Real.exp 1 * δ_in := by
        have h := (h_lip1 1 h1_icc).2.2.2.2.1
        rwa [hc0_0_1] at h
      have hk0_le : ‖k0Kernel (Q_seq n p) 1‖ ≤ Real.exp 1 := (h_lip1 1 h1_icc).2.1
      have hb1_diff : ‖(a₀_seq n p * c0Kernel (Q_seq n p) 1 +
          a₁_seq n p * k0Kernel (Q_seq n p) 1) - Λ_fn p‖ ≤ C_comb * δ_in := by
        have h_rew : (a₀_seq n p * c0Kernel (Q_seq n p) 1 +
            a₁_seq n p * k0Kernel (Q_seq n p) 1) - Λ_fn p =
            a₀_seq n p * (c0Kernel (Q_seq n p) 1 - 1) +
            (a₀_seq n p - Λ_fn p) + a₁_seq n p * k0Kernel (Q_seq n p) 1 := by ring
        rw [h_rew]
        have t1 := norm_add_le
          (a₀_seq n p * (c0Kernel (Q_seq n p) 1 - 1) + (a₀_seq n p - Λ_fn p))
          (a₁_seq n p * k0Kernel (Q_seq n p) 1)
        have t2 := norm_add_le
          (a₀_seq n p * (c0Kernel (Q_seq n p) 1 - 1)) (a₀_seq n p - Λ_fn p)
        have m1 : ‖a₀_seq n p * (c0Kernel (Q_seq n p) 1 - 1)‖ ≤
            (2 * c_Λ + 1) * (Real.exp 1 * δ_in) := by
          rw [norm_mul]; exact mul_le_mul ha0_norm hc0_diff (norm_nonneg _) (by positivity)
        have m2 : ‖a₁_seq n p * k0Kernel (Q_seq n p) 1‖ ≤ δ_in * Real.exp 1 := by
          rw [norm_mul]; exact mul_le_mul ha1_lt.le hk0_le (norm_nonneg _) (by positivity)
        have h_sum_b1 : ‖a₀_seq n p * (c0Kernel (Q_seq n p) 1 - 1) +
            (a₀_seq n p - Λ_fn p) + a₁_seq n p * k0Kernel (Q_seq n p) 1‖ ≤ A_Fw * δ_in := by
          have h_expand : A_Fw * δ_in =
              (2 * c_Λ + 1) * (Real.exp 1 * δ_in) + δ_in + δ_in * Real.exp 1 := by
            dsimp [A_Fw]; ring
          linarith
        exact le_trans h_sum_b1 (mul_le_mul_of_nonneg_right hA_Fw_le_C hδ_in_pos.le)
      have h_pert_diff : ∀ (sgn : ℂ), ‖sgn‖ = 1 → ∀ w ∈ Set.Icc (0 : ℝ) 1,
          ‖pertPotential sgn (Q_seq n p) (a₀_seq n p) (a₁_seq n p) w -
            (-(Λ_fn p) ^ 2 / 4)‖ ≤ C_comb * δ_in := by
        intro sgn hsgn_norm w hw
        obtain ⟨hc0_0, hc0d_0, hk0_0, hk0d_0⟩ := h_kern_zero w hw
        obtain ⟨hc0_b, hk0_b, _, hk0d_b, hc0_l, _, hc0d_l, _⟩ := h_lip1 w hw
        rw [hc0_0] at hc0_l
        rw [hc0d_0, sub_zero] at hc0d_l
        set Fw := a₀_seq n p * c0Kernel (Q_seq n p) w + a₁_seq n p * k0Kernel (Q_seq n p) w
        set Fpw := a₀_seq n p * c0Deriv (Q_seq n p) w + a₁_seq n p * k0Deriv (Q_seq n p) w
        have hFw_diff : ‖Fw - Λ_fn p‖ ≤ A_Fw * δ_in := by
          have h_rew : Fw - Λ_fn p = a₀_seq n p * (c0Kernel (Q_seq n p) w - 1) +
              (a₀_seq n p - Λ_fn p) + a₁_seq n p * k0Kernel (Q_seq n p) w := by
            dsimp [Fw]; ring
          rw [h_rew]
          have t1 := norm_add_le
            (a₀_seq n p * (c0Kernel (Q_seq n p) w - 1) + (a₀_seq n p - Λ_fn p))
            (a₁_seq n p * k0Kernel (Q_seq n p) w)
          have t2 := norm_add_le
            (a₀_seq n p * (c0Kernel (Q_seq n p) w - 1)) (a₀_seq n p - Λ_fn p)
          have m1 : ‖a₀_seq n p * (c0Kernel (Q_seq n p) w - 1)‖ ≤
              (2 * c_Λ + 1) * (Real.exp 1 * δ_in) := by
            rw [norm_mul]; exact mul_le_mul ha0_norm hc0_l (norm_nonneg _) (by positivity)
          have m2 : ‖a₁_seq n p * k0Kernel (Q_seq n p) w‖ ≤ δ_in * Real.exp 1 := by
            rw [norm_mul]; exact mul_le_mul ha1_lt.le hk0_b (norm_nonneg _) (by positivity)
          have h_expand : A_Fw * δ_in =
              (2 * c_Λ + 1) * (Real.exp 1 * δ_in) + δ_in + δ_in * Real.exp 1 := by
            dsimp [A_Fw]; ring
          linarith
        have hFw_plus : ‖Fw + Λ_fn p‖ ≤ 4 * c_Λ + 4 := by
          have h1 := norm_add_le (2 * Λ_fn p) (Fw - Λ_fn p)
          have h_eq : 2 * Λ_fn p + (Fw - Λ_fn p) = Fw + Λ_fn p := by ring
          rw [h_eq, norm_mul, Complex.norm_ofNat] at h1
          have : ‖Fw - Λ_fn p‖ ≤ 2 := by
            have hC_small : C_comb * δ_in ≤ 1 := by
              have : δ_in ≤ η_pert / C_comb :=
                le_trans (min_le_right _ _) (min_le_right _ _)
              have hη_le1 : η_pert ≤ 1 := min_le_left _ _
              have := (le_div_iff₀ hC_comb_pos).mp this
              linarith
            have hA_le_C_mul : A_Fw * δ_in ≤ C_comb * δ_in :=
              mul_le_mul_of_nonneg_right hA_Fw_le_C hδ_in_pos.le
            linarith
          linarith
        have hFpw_le : ‖Fpw‖ ≤ A_Fpw * δ_in := by
          dsimp [Fpw, A_Fpw]
          have t1 := norm_add_le (a₀_seq n p * c0Deriv (Q_seq n p) w)
            (a₁_seq n p * k0Deriv (Q_seq n p) w)
          have m1 : ‖a₀_seq n p * c0Deriv (Q_seq n p) w‖ ≤
              (2 * c_Λ + 1) * ((1 + 1) * Real.exp 1 * δ_in) := by
            rw [norm_mul]; exact mul_le_mul ha0_norm hc0d_l (norm_nonneg _) (by positivity)
          have m2 : ‖a₁_seq n p * k0Deriv (Q_seq n p) w‖ ≤ δ_in * (1 + 1 * Real.exp 1) := by
            rw [norm_mul]; exact mul_le_mul ha1_lt.le hk0d_b (norm_nonneg _) (by positivity)
          linarith
        have h_rew : pertPotential sgn (Q_seq n p) (a₀_seq n p) (a₁_seq n p) w -
            (-(Λ_fn p) ^ 2 / 4) =
            Q_seq n p w - sgn * (3 * Complex.I / 2) * Fpw -
              (1 / 4 : ℂ) * ((Fw - Λ_fn p) * (Fw + Λ_fn p)) := by
          dsimp [pertPotential, Fw, Fpw]; ring
        rw [h_rew]
        have t1 := norm_sub_le (Q_seq n p w - sgn * (3 * Complex.I / 2) * Fpw)
          ((1 / 4 : ℂ) * ((Fw - Λ_fn p) * (Fw + Λ_fn p)))
        have t2 := norm_sub_le (Q_seq n p w) (sgn * (3 * Complex.I / 2) * Fpw)
        have hQ_w := hQ_le w hw
        have m_mid : ‖sgn * (3 * Complex.I / 2) * Fpw‖ ≤ 2 * ‖Fpw‖ := by
          rw [norm_mul, norm_mul, hsgn_norm, one_mul, norm_div, norm_mul,
            Complex.norm_ofNat, Complex.norm_I, Complex.norm_ofNat]
          linarith [norm_nonneg Fpw]
        have m_sq : ‖(1 / 4 : ℂ) * ((Fw - Λ_fn p) * (Fw + Λ_fn p))‖ ≤
            (c_Λ + 1) * ‖Fw - Λ_fn p‖ := by
          rw [norm_mul, norm_mul, norm_div, norm_one, Complex.norm_ofNat]
          have := mul_le_mul_of_nonneg_left hFw_plus (norm_nonneg (Fw - Λ_fn p))
          linarith
        have m_sq' : (c_Λ + 1) * ‖Fw - Λ_fn p‖ ≤ (c_Λ + 1) * (A_Fw * δ_in) :=
          mul_le_mul_of_nonneg_left hFw_diff (by positivity)
        have h_rem_pos : 0 ≤ Real.exp 1 * δ_in := by positivity
        have h_expand_C : C_comb * δ_in =
            δ_in + 2 * (A_Fpw * δ_in) + (c_Λ + 1) * (A_Fw * δ_in) + Real.exp 1 * δ_in := by
          dsimp [C_comb]; ring
        linarith

      have hC_δ_lt_eps : C_comb * δ_in < ε := by
        have : δ_in ≤ ε / (2 * C_comb) :=
          le_trans (min_le_right _ _) (min_le_left _ _)
        have := (le_div_iff₀ (by positivity : 0 < 2 * C_comb)).mp this
        linarith
      have hC_δ_le_η : C_comb * δ_in ≤ η_pert := by
        have : δ_in ≤ η_pert / C_comb :=
          le_trans (min_le_right _ _) (min_le_right _ _)
        have hm := (le_div_iff₀ hC_comb_pos).mp this
        linarith
      have hk_pm : ∀ (sgn : ℂ), ‖sgn‖ = 1 →
          ‖k0Kernel (pertPotential sgn (Q_seq n p) (a₀_seq n p) (a₁_seq n p)) 1 -
            k_lim p‖ < ε := by
        intro sgn hsgn_norm
        have hP_diff := fun w hw => le_trans (h_pert_diff sgn hsgn_norm w hw) hC_δ_le_η
        have h_lim_M : ‖-(Λ_fn p) ^ 2 / 4‖ ≤ c_Λ ^ 2 := by
          rw [norm_div, norm_neg, norm_pow, Complex.norm_ofNat]
          have : ‖Λ_fn p‖ ^ 2 ≤ (2 * c_Λ) ^ 2 :=
            pow_le_pow_left₀ (norm_nonneg _) hΛ_hi 2
          linarith
        have hP_M : ∀ w ∈ Set.Icc (0 : ℝ) 1,
            ‖pertPotential sgn (Q_seq n p) (a₀_seq n p) (a₁_seq n p) w‖ ≤ M_pert := by
          intro w hw
          have hd := hP_diff w hw
          have hη1 : η_pert ≤ 1 := min_le_left _ _
          calc ‖pertPotential sgn (Q_seq n p) (a₀_seq n p) (a₁_seq n p) w‖
              ≤ ‖-(Λ_fn p) ^ 2 / 4‖ +
                ‖pertPotential sgn (Q_seq n p) (a₀_seq n p) (a₁_seq n p) w -
                  (-(Λ_fn p) ^ 2 / 4)‖ := by
                have := norm_add_le (-(Λ_fn p) ^ 2 / 4)
                  (pertPotential sgn (Q_seq n p) (a₀_seq n p) (a₁_seq n p) w - (-(Λ_fn p) ^ 2 / 4))
                simpa using this
            _ ≤ M_pert := by dsimp [M_pert]; linarith
        have h_lip2 := (hVolt.2.1.1 M_pert η_pert
          (pertPotential sgn (Q_seq n p) (a₀_seq n p) (a₁_seq n p))
          (fun _ => -(Λ_fn p) ^ 2 / 4)
          hM_pert_nonneg hη_pert_pos.le
          (h_pert_cont_of sgn _ _ _ hQ_cont_p) continuousOn_const
          (fun w hw => ⟨hP_M w hw, by dsimp [M_pert]; linarith, hP_diff w hw⟩)
          1 h1_icc).2.2.2.2.2.1
        have hk_const : k0Kernel (fun _ => -(Λ_fn p) ^ 2 / 4) 1 = k_lim p :=
          h_kern_neg_quarter_sq _ (Λ_fn p) hΛ_ne continuousOn_const (fun _ _ => rfl)
        rw [hk_const] at h_lip2
        have hη_eps : Real.exp M_pert * η_pert < ε := by
          have : η_pert ≤ ε / (2 * Real.exp M_pert) := min_le_right _ _
          have := (le_div_iff₀ (by positivity : 0 < 2 * Real.exp M_pert)).mp this
          linarith
        exact lt_of_le_of_lt h_lip2 hη_eps

      refine ⟨?_, ?_, lt_of_le_of_lt hb1_diff hC_δ_lt_eps,
        hk_pm 1 (by simp), hk_pm (-1) (by simp)⟩
      · have hC_ge : Real.exp 1 ≤ C_comb := by
          have hp : 0 < (c_Λ + 1) * A_Fw := by positivity
          dsimp [C_comb]; linarith [hA_Fpw_pos, hp]
        have : Real.exp 1 * δ_in ≤ C_comb * δ_in :=
          mul_le_mul_of_nonneg_right hC_ge hδ_in_pos.le
        exact lt_of_le_of_lt (le_trans hk0_diff this) hC_δ_lt_eps
      · have hC_ge1 : 1 ≤ C_comb := by
          have hp : 0 < (c_Λ + 1) * A_Fw := by positivity
          dsimp [C_comb]; linarith [Real.exp_pos 1, hA_Fpw_pos, hp]
        have : δ_in ≤ C_comb * δ_in := by
          simpa using mul_le_mul_of_nonneg_right hC_ge1 hδ_in_pos.le
        exact lt_trans (lt_of_lt_of_le ha0_lt this) hC_δ_lt_eps

    
    let η₀ : ℝ := min (1 / 2) (min (c_Λ / 4) (c_k / 8))
    have hη₀_pos : 0 < η₀ := lt_min (by norm_num) (lt_min (by positivity) (by positivity))
    obtain ⟨N₁, hN₁_ge, hN₁⟩ := h_unif_all η₀ hη₀_pos
    have hη₀_1 : η₀ ≤ 1 / 2 := min_le_left _ _
    have hη₀_2 : η₀ ≤ c_Λ / 4 := le_trans (min_le_right _ _) (min_le_left _ _)
    have hη₀_3 : η₀ ≤ c_k / 8 := le_trans (min_le_right _ _) (min_le_right _ _)

    have h_safe : ∀ n ≥ N₁, ∀ p ∈ U_δ,
        k0Kernel (Q_seq n p) 1 ≠ 0 ∧
        c_Λ / 4 ≤ ‖a₀_seq n p‖ ∧
        c_Λ / 4 ≤ ‖a₀_seq n p * c0Kernel (Q_seq n p) 1 +
          a₁_seq n p * k0Kernel (Q_seq n p) 1‖ ∧
        3 * c_k / 4 ≤ ‖kPlusVal (Q_seq n p) (a₀_seq n p) (a₁_seq n p) +
          kMinusVal (Q_seq n p) (a₀_seq n p) (a₁_seq n p)‖ ∧
        (4 * kPlusVal (Q_seq n p) (a₀_seq n p) (a₁_seq n p) *
            kMinusVal (Q_seq n p) (a₀_seq n p) (a₁_seq n p) /
          (kPlusVal (Q_seq n p) (a₀_seq n p) (a₁_seq n p) +
            kMinusVal (Q_seq n p) (a₀_seq n p) (a₁_seq n p)) ^ 2) ∈ Complex.slitPlane := by
      intro n hn p hp
      obtain ⟨hk0_d, hb0_d, hb1_d, hkp_d, hkm_d⟩ := hN₁ n hn p hp
      obtain ⟨hΛ_lo, _, hk_lo, _, _⟩ := h_bounds_Uδ p hp
      have hk0_ne : k0Kernel (Q_seq n p) 1 ≠ 0 := by
        intro h0
        rw [h0, zero_sub, norm_neg, norm_one] at hk0_d
        linarith
      have hb0_lo : c_Λ / 4 ≤ ‖a₀_seq n p‖ := by
        have := norm_add_le (a₀_seq n p) (Λ_fn p - a₀_seq n p)
        have h_eq : a₀_seq n p + (Λ_fn p - a₀_seq n p) = Λ_fn p := by ring
        rw [h_eq, norm_sub_rev] at this
        linarith
      set b₁_val := a₀_seq n p * c0Kernel (Q_seq n p) 1 + a₁_seq n p * k0Kernel (Q_seq n p) 1
      have hb1_lo : c_Λ / 4 ≤ ‖b₁_val‖ := by
        have := norm_add_le b₁_val (Λ_fn p - b₁_val)
        have h_eq : b₁_val + (Λ_fn p - b₁_val) = Λ_fn p := by ring
        rw [h_eq, norm_sub_rev] at this
        linarith
      set kp := kPlusVal (Q_seq n p) (a₀_seq n p) (a₁_seq n p)
      set km := kMinusVal (Q_seq n p) (a₀_seq n p) (a₁_seq n p)
      have hsum_lo : 3 * c_k / 4 ≤ ‖kp + km‖ := by
        have h_diff : ‖(kp + km) - 2 * k_lim p‖ < c_k / 4 := by
          calc ‖(kp + km) - 2 * k_lim p‖
              = ‖(kp - k_lim p) + (km - k_lim p)‖ := by ring_nf
            _ ≤ ‖kp - k_lim p‖ + ‖km - k_lim p‖ := norm_add_le _ _
            _ < c_k / 4 := by linarith
        have h2k : c_k ≤ ‖2 * k_lim p‖ := by
          rw [norm_mul, Complex.norm_ofNat]; linarith
        have := norm_add_le (kp + km) (2 * k_lim p - (kp + km))
        have h_eq : (kp + km) + (2 * k_lim p - (kp + km)) = 2 * k_lim p := by ring
        rw [h_eq, norm_sub_rev] at this
        linarith
      have hsum_ne : kp + km ≠ 0 := norm_pos_iff.mp (by linarith)
      have hΞ_diff : ‖4 * kp * km / (kp + km) ^ 2 - 1‖ < 1 / 2 := by
        have h_alg : 4 * kp * km / (kp + km) ^ 2 - 1 = -(kp - km) ^ 2 / (kp + km) ^ 2 := by
          field_simp [hsum_ne]; ring
        rw [h_alg, norm_div, norm_neg, norm_pow, norm_pow]
        have hsub_lt : ‖kp - km‖ < c_k / 4 := by
          calc ‖kp - km‖ = ‖(kp - k_lim p) - (km - k_lim p)‖ := by ring_nf
            _ ≤ ‖kp - k_lim p‖ + ‖km - k_lim p‖ := norm_sub_le _ _
            _ < c_k / 4 := by linarith
        have h_sq_lt : ‖kp - km‖ ^ 2 < (c_k / 4) ^ 2 :=
          pow_lt_pow_left₀ hsub_lt (norm_nonneg _) (by norm_num)
        have h_den_ge : (3 * c_k / 4) ^ 2 ≤ ‖kp + km‖ ^ 2 :=
          pow_le_pow_left₀ (by positivity) hsum_lo 2
        have h_den_pos : 0 < ‖kp + km‖ ^ 2 := by positivity
        rw [div_lt_iff₀ h_den_pos]
        nlinarith [sq_pos_of_pos hc_k_pos]
      have hΞ_slit : 4 * kp * km / (kp + km) ^ 2 ∈ Complex.slitPlane := by
        rw [Complex.mem_slitPlane_iff]
        left
        have hre := Complex.abs_re_le_norm (4 * kp * km / (kp + km) ^ 2 - 1)
        rw [Complex.sub_re, Complex.one_re, abs_le] at hre
        linarith
      exact ⟨hk0_ne, hb0_lo, hb1_lo, hsum_lo, hΞ_slit⟩

    refine ⟨δ, N₁, hδ_pos, hδ_le1, hN₁_ge, fun p hp => (h_bounds_Uδ p hp).2.2.2.2, ?_, ?_⟩
    · intro n hn
      have hn0 : N₀ ≤ n := le_trans hN₁_ge hn
      obtain ⟨_, hQ_c, _, hQ_h, ha0_h, ha1_h⟩ := h3_holo n hn0
      obtain ⟨hc0_h, hk0_h, hkp_h, hkm_h⟩ :=
        hVolt.2.1.2 U_δ (Q_seq n) (a₀_seq n) (a₁_seq n) (hU_δ_open δ)
          (hQ_c.mono (Set.prod_mono_left hU_sub))
          (fun w hw => (hQ_h w hw).mono hU_sub)
          (ha0_h.mono hU_sub) (ha1_h.mono hU_sub)
      refine ⟨fun p hp => (h_safe n hn p hp).1, ?_⟩
      have h_diff_div : ∀ {f g : ℂ × ℂ → ℂ},
          DifferentiableOn ℂ f U_δ → DifferentiableOn ℂ g U_δ →
          (∀ p ∈ U_δ, g p ≠ 0) → DifferentiableOn ℂ (fun p => f p / g p) U_δ := by
        intro f g hf hg hne
        have hinv : DifferentiableOn ℂ (fun p => (g p)⁻¹) U_δ :=
          DifferentiableOn.comp (t := {(0 : ℂ)}ᶜ)
            (fun z hz => (differentiableAt_inv
              (Set.mem_compl_singleton_iff.mp hz)).differentiableWithinAt)
            hg (fun p hp => Set.mem_compl_singleton_iff.mpr (hne p hp))
        exact (hf.mul hinv).congr (fun p _ => div_eq_mul_inv (f p) (g p))
      let b₁_fn : ℂ × ℂ → ℂ := fun p =>
        a₀_seq n p * c0Kernel (Q_seq n p) 1 + a₁_seq n p * k0Kernel (Q_seq n p) 1
      let Ξ_fn : ℂ × ℂ → ℂ := fun p =>
        4 * kPlusVal (Q_seq n p) (a₀_seq n p) (a₁_seq n p) *
          kMinusVal (Q_seq n p) (a₀_seq n p) (a₁_seq n p) /
          (kPlusVal (Q_seq n p) (a₀_seq n p) (a₁_seq n p) +
            kMinusVal (Q_seq n p) (a₀_seq n p) (a₁_seq n p)) ^ 2
      have hb1_h : DifferentiableOn ℂ b₁_fn U_δ :=
        ((ha0_h.mono hU_sub).mul hc0_h).add ((ha1_h.mono hU_sub).mul hk0_h)
      have hΞ_num_h : DifferentiableOn ℂ
          (fun p => 4 * kPlusVal (Q_seq n p) (a₀_seq n p) (a₁_seq n p) *
            kMinusVal (Q_seq n p) (a₀_seq n p) (a₁_seq n p)) U_δ :=
        ((differentiableOn_const (4 : ℂ)).mul hkp_h).mul hkm_h
      have hΞ_den_h : DifferentiableOn ℂ
          (fun p => (kPlusVal (Q_seq n p) (a₀_seq n p) (a₁_seq n p) +
            kMinusVal (Q_seq n p) (a₀_seq n p) (a₁_seq n p)) ^ 2) U_δ :=
        (hkp_h.add hkm_h).pow 2
      have hΞ_h : DifferentiableOn ℂ Ξ_fn U_δ := by
        refine h_diff_div hΞ_num_h hΞ_den_h ?_
        intro p hp
        have hlo := (h_safe n hn p hp).2.2.2.1
        exact pow_ne_zero 2 (norm_pos_iff.mp (by linarith))
      have hlog_h : DifferentiableOn ℂ (fun p => Complex.log (Ξ_fn p)) U_δ :=
        DifferentiableOn.comp
          (fun z hz => (Complex.differentiableAt_log hz).differentiableWithinAt)
          hΞ_h (fun p hp => (h_safe n hn p hp).2.2.2.2)
      have hroot_h : DifferentiableOn ℂ
          (fun p => canonRoot (Q_seq n p) (a₀_seq n p) (a₁_seq n p)) U_δ := by
        dsimp [canonRoot]
        have havg_h : DifferentiableOn ℂ
            (fun p => (kPlusVal (Q_seq n p) (a₀_seq n p) (a₁_seq n p) +
              kMinusVal (Q_seq n p) (a₀_seq n p) (a₁_seq n p)) / 2) U_δ :=
          h_diff_div (hkp_h.add hkm_h) (differentiableOn_const (2 : ℂ)) (fun _ _ => two_ne_zero)
        exact havg_h.mul
          (Complex.differentiable_exp.comp_differentiableOn
            ((differentiableOn_const (1 / 2 : ℂ)).mul hlog_h))
      have hquot_h : DifferentiableOn ℂ
          (fun p => (k0Kernel (Q_seq n p) 1 -
            canonRoot (Q_seq n p) (a₀_seq n p) (a₁_seq n p)) /
            (a₀_seq n p * b₁_fn p)) U_δ := by
        have hnum_q : DifferentiableOn ℂ
            (fun p => k0Kernel (Q_seq n p) 1 -
              canonRoot (Q_seq n p) (a₀_seq n p) (a₁_seq n p)) U_δ :=
          hk0_h.sub hroot_h
        have hden_q : DifferentiableOn ℂ (fun p => a₀_seq n p * b₁_fn p) U_δ :=
          (ha0_h.mono hU_sub).mul hb1_h
        refine h_diff_div hnum_q hden_q ?_
        intro p hp
        obtain ⟨_, hb0_lo, hb1_lo, _, _⟩ := h_safe n hn p hp
        exact mul_ne_zero (norm_pos_iff.mp (by linarith)) (norm_pos_iff.mp (by linarith))
      refine hquot_h.congr ?_
      intro p hp
      obtain ⟨_, hb0_lo, hb1_lo, _, _⟩ := h_safe n hn p hp
      have hb_ne : a₀_seq n p ≠ 0 ∧ b₁_fn p ≠ 0 :=
        ⟨norm_pos_iff.mp (by linarith), norm_pos_iff.mp (by linarith)⟩
      dsimp [slDivided, b₁_fn]
      rw [ite_eq_left_iff.mpr fun h => False.elim (h hb_ne)]

    · 
      rw [Metric.tendstoUniformlyOn_iff]
      intro ε hε
      let D_min : ℝ := (c_Λ / 4) ^ 2 * (c_Λ / 2) ^ 2
      have hD_min_pos : 0 < D_min := by positivity
      let M_num_lim : ℝ := 1 + 2 * c_k
      let C_alg : ℝ := (12 * c_Λ ^ 2 + M_num_lim * (5 * c_Λ)) / D_min + 1
      have hC_alg_pos : 0 < C_alg := by positivity
      let ε₁ : ℝ := ε / (2 * C_alg)
      have hε₁_pos : 0 < ε₁ := by positivity
      have h1_slit : (1 : ℂ) ∈ Complex.slitPlane :=
        Complex.mem_slitPlane_iff.mpr (Or.inl (by simp))
      have h_sqrt_cont : ContinuousAt
          (fun z : ℂ => Complex.exp ((1 / 2 : ℂ) * Complex.log z)) 1 :=
        Complex.continuous_exp.continuousAt.comp
          (continuousAt_const.mul (Complex.differentiableAt_log h1_slit).continuousAt)
      obtain ⟨δ_sq, hδ_sq_pos, hδ_sq⟩ :=
        Metric.continuousAt_iff.mp h_sqrt_cont (ε₁ / (6 * c_k + 1)) (by positivity)
      let η_f : ℝ := min η₀ (min ε₁ ((3 * c_k / 8) * Real.sqrt (min 1 δ_sq)))
      have hη_f_pos : 0 < η_f :=
        lt_min hη₀_pos (lt_min hε₁_pos (mul_pos (by positivity)
          (Real.sqrt_pos.mpr (lt_min zero_lt_one hδ_sq_pos))))
