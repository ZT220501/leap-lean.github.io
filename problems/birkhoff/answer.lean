            (fun ζ => skrKerRem W₁ τ (H₁ ζ) ζ)
            (fun ζ => skrKerRem W₂ τ (H₂ ζ) ζ) := by
    let B_I : ℝ := ‖(1 : ℂ)‖ + (2 : ℝ) ^ m * 1 * B_rE
