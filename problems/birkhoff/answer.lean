        have hderiv_f_U : ∀ w ∈ U, deriv f w = g₁ w + (w - s₀) * deriv g₁ w := by
          intro w hwU
          have hg₁_at : HasDerivAt g₁ (deriv g₁ w) w :=
            (hg₁_diff.differentiableAt (hU.mem_nhds hwU)).hasDerivAt
          have hprod_at : HasDerivAt (fun w' => (w' - s₀) * g₁ w')
