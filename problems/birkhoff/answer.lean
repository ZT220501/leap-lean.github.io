    · rw [abs_zero]; positivity
  have hZ_meas : ∀ k ≤ M, Measurable (Z_mart k) :=
    fun k hk => Finset.measurable_sum (Finset.range k) (fun j hj =>
      hξ_meas j (lt_of_lt_of_le (Finset.mem_range.mp hj) hk))
  have hA_meas : ∀ k ≤ M, MeasurableSet {w : ℕ → ℝ | A_surv k w} := by
