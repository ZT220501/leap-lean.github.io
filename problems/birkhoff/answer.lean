        _ = f₀ p := by dsimp [h]; rw [hΦ_zero p hp]
    · intro p _ M_bd h_bd
      have h2pi_pos : (0 : ℝ) < 2 * Real.pi := by positivity
      have h_int_le :
          ‖∫ ϕ in (0 : ℝ)..(2 * Real.pi), f₀ (Φ (p, e_cir ϕ))‖ ≤
            M_bd * |2 * Real.pi - 0| := by
        refine intervalIntegral.norm_integral_le_of_norm_le_const (fun ϕ hϕ => ?_)
        rw [Set.uIoc_of_le h2pi_pos.le] at hϕ
        exact h_bd ϕ (Set.Ioc_subset_Icc_self hϕ)
      rw [sub_zero, abs_of_pos h2pi_pos] at h_int_le
      dsimp [circleAvgCont]
      rw [norm_mul, norm_inv, Complex.norm_real, Real.norm_of_nonneg h2pi_pos.le]
      calc (2 * Real.pi)⁻¹ * ‖∫ ϕ in (0 : ℝ)..(2 * Real.pi), f₀ (Φ (p, e_cir ϕ))‖
          ≤ (2 * Real.pi)⁻¹ * (M_bd * (2 * Real.pi)) :=
            mul_le_mul_of_nonneg_left h_int_le (by positivity)
        _ = M_bd := by field_simp [h2pi_pos.ne']

  intro hBump α K₀ γ₀ hα₁ hα₂ hK₀ hγ₀_pos hγ₀_lt
  have hK₀_pos : 0 < K₀ := by linarith
  have hα_pos : 0 < α := by linarith
  let η_init : ℝ := 1 / (8 * K₀)
  have hη_init_pos : 0 < η_init := by dsimp [η_init]; positivity
  obtain ⟨C_bump_init, C_err_init, γ_init, hCb, hCerr, hγ_pos, hγ_lt_γ₀, hBump_apply⟩ :=
    hBump 1 η_init γ₀ zero_lt_one hη_init_pos hγ₀_pos hγ₀_lt
  have hγ_lt_8 : γ_init < 1 / 8 := lt_trans hγ_lt_γ₀ hγ₀_lt
  refine ⟨C_bump_init, γ_init, hCb, hγ_pos, hγ_lt_γ₀, ?_⟩

  intro x₀ h_ref s_base ρ_base m_aux d r M_scale C_st C_init s_base_fn U_base s_steep
    hs_base hs_le_h hρ_base hm_aux hd h4d hr hM_scale hC_st hC_init hr_small hC_init_le
    m_steep_init A₀ δ_seed U_base_dom W_steep_init Ω_mid
    hU_holo hU_props hs_steep_holo hs_steep_props hs_steep_base

  have hh_ref : 0 < h_ref := lt_of_lt_of_le hs_base hs_le_h
  have hm_steep_pos : 0 < m_steep_init := by dsimp [m_steep_init]; positivity
  have hA₀_ge_one : 1 ≤ A₀ := le_max_left _ _
  have hA₀_pos : 0 < A₀ := lt_of_lt_of_le zero_lt_one hA₀_ge_one
  have hδ_seed_pos : 0 < δ_seed := by dsimp [δ_seed]; positivity
  have hδ_seed_lt_16 : δ_seed < s_base / 16 := by
    dsimp [δ_seed]
    exact div_lt_div_of_pos_left hs_base (by norm_num) (by linarith)

  
  let U_bh : Set (ℂ × ℂ) := { p : ℂ × ℂ | |p.1.im| < s_base / 2 ∧ ‖p.2‖ < ρ_base }
  have hc_depth : Continuous (fun p : ℂ × ℂ => h_ref - p.1.im) :=
    continuous_const.sub (Complex.continuous_im.comp continuous_fst)
  have hc_re : Continuous (fun p : ℂ × ℂ => |p.1.re - x₀|) :=
    continuous_abs.comp ((Complex.continuous_re.comp continuous_fst).sub continuous_const)
  have hc_t : Continuous (fun p : ℂ × ℂ => ‖p.2‖) := continuous_norm.comp continuous_snd
  have hc_rpow : Continuous (fun p : ℂ × ℂ => ((h_ref - p.1.im) / d) ^ α) :=
    (hc_depth.div_const d).rpow_const (fun _ => Or.inr hα_pos.le)

  have hU_bh_open : IsOpen U_bh :=
    (isOpen_lt (continuous_abs.comp (Complex.continuous_im.comp continuous_fst))
      continuous_const).inter (isOpen_lt hc_t continuous_const)
  have hU_bh_sub : U_bh ⊆ U_base_dom := fun p hp => ⟨by linarith [hp.1], hp.2⟩

  have hW_open : IsOpen W_steep_init :=
    (isOpen_lt continuous_const hc_depth).inter <|
      (isOpen_lt hc_depth continuous_const).inter <|
        (isOpen_lt hc_re (continuous_const.mul hc_depth)).inter <|
          (isOpen_lt hc_t (continuous_const.mul hc_rpow)).inter <|
            isOpen_lt (continuous_const.mul hc_t)
              (continuous_abs.comp (Complex.continuous_im.comp continuous_snd))

  have hΩ_open : IsOpen Ω_mid :=
    (isOpen_lt continuous_const hc_depth).inter <|
      (isOpen_lt hc_depth continuous_const).inter <|
        (isOpen_lt hc_re (continuous_const.mul hc_depth)).inter <|
          isOpen_lt hc_t (continuous_const.mul hc_rpow)

  have hW_conv : IsDownwardVertConvex W_steep_init := by
    refine ⟨hW_open, fun y t hyt _ τ hτ_lo hτ_hi => ?_⟩
    rcases hyt with ⟨hp1, _, hp3, hp4, hp5⟩
    have hy'_re : ((y.re : ℂ) + (τ : ℂ) * Complex.I).re = y.re := by simp
    have hy'_im : ((y.re : ℂ) + (τ : ℂ) * Complex.I).im = τ := by simp
    have hδ_pos : 0 < h_ref - y.im := lt_trans (by positivity) hp1
    have hδ_le : h_ref - y.im ≤ h_ref - τ := by linarith
    have hrpow_le : ((h_ref - y.im) / d) ^ α ≤ ((h_ref - τ) / d) ^ α :=
      Real.rpow_le_rpow (by positivity) (div_le_div_of_nonneg_right hδ_le hd.le) hα_pos.le
    refine ⟨?_, ?_, ?_, ?_, hp5⟩
    · rw [hy'_im]; linarith
    · rw [hy'_im]; linarith
    · rw [hy'_re, hy'_im]
      exact lt_of_lt_of_le hp3 (mul_le_mul_of_nonneg_left hδ_le hm_steep_pos.le)
    · rw [hy'_im]
      exact lt_of_lt_of_le hp4 (mul_le_mul_of_nonneg_left hrpow_le (by positivity))

  have hΩ_conv : IsDownwardVertConvex Ω_mid := by
    refine ⟨hΩ_open, fun y t hyt _ τ hτ_lo hτ_hi => ?_⟩
    rcases hyt with ⟨hp1, _, hp3, hp4⟩
    have hy'_re : ((y.re : ℂ) + (τ : ℂ) * Complex.I).re = y.re := by simp
    have hy'_im : ((y.re : ℂ) + (τ : ℂ) * Complex.I).im = τ := by simp
    have hδ_pos : 0 < h_ref - y.im := lt_trans (by positivity) hp1
    have hδ_le : h_ref - y.im ≤ h_ref - τ := by linarith
    have hrpow_le : ((h_ref - y.im) / d) ^ α ≤ ((h_ref - τ) / d) ^ α :=
      Real.rpow_le_rpow (by positivity) (div_le_div_of_nonneg_right hδ_le hd.le) hα_pos.le
    refine ⟨?_, ?_, ?_, ?_⟩
    · rw [hy'_im]; linarith
    · rw [hy'_im]; linarith
    · rw [hy'_re, hy'_im]
      exact lt_of_lt_of_le hp3 (mul_le_mul_of_nonneg_left hδ_le hm_aux.le)
    · rw [hy'_im]
      exact lt_of_lt_of_le hp4 (mul_le_mul_of_nonneg_left hrpow_le hr.le)

  have hW_t_ne : ∀ p ∈ W_steep_init, p.2 ≠ 0 := by
    intro p hp h0
    have h5 := hp.2.2.2.2
    simp [h0] at h5

  let U_steep : ℂ × ℂ → ℂ := fun p => (s_steep p - p.1) / p.2 ^ 2
  have hU_steep_holo : DifferentiableOn ℂ U_steep W_steep_init := by
    have hp1 : DifferentiableOn ℂ (fun p : ℂ × ℂ => p.1) W_steep_init :=
      differentiable_fst.differentiableOn
    have hp2 : DifferentiableOn ℂ (fun p : ℂ × ℂ => p.2) W_steep_init :=
      differentiable_snd.differentiableOn
    have hp2_inv : DifferentiableOn ℂ (fun p : ℂ × ℂ => (p.2 ^ 2)⁻¹) W_steep_init :=
      (hp2.pow 2).inv (fun p hp => pow_ne_zero 2 (hW_t_ne p hp))
    exact ((hs_steep_holo.sub hp1).mul hp2_inv).congr (fun _ _ => div_eq_mul_inv _ _)
  have hU_steep_norm : ∀ p ∈ W_steep_init,
      ‖U_steep p‖ ≤ C_st * M_scale ^ 2 * (h_ref - p.1.im) ^ (1 - 2 * α) := by
    intro p hp
    have ht_pos : 0 < ‖p.2‖ := norm_pos_iff.mpr (hW_t_ne p hp)
    have h_st := (hs_steep_props p.1 p.2 hp).2
    dsimp [U_steep]
    rw [norm_div, norm_pow, div_le_iff₀ (pow_pos ht_pos 2)]
    exact le_of_le_of_eq h_st (by ring)

  classical
  let U_comb : ℂ × ℂ → ℂ := fun p => if p ∈ W_steep_init then U_steep p else U_base p
  have hU_comb_st : ∀ p ∈ W_steep_init, U_comb p = U_steep p := by
    intro p hp; simp only [U_comb, hp, ↓reduceIte]
  have hU_comb_bh : ∀ p ∈ U_bh, U_comb p = U_base p := by
    intro p hp_bh
    dsimp [U_comb]
    split_ifs with hp_st
    · have ht2_ne : p.2 ^ 2 ≠ 0 := pow_ne_zero 2 (hW_t_ne p hp_st)
      have h_eq_fn : s_steep p = s_base_fn p := hs_steep_base p hp_st hp_bh.1 hp_bh.2
      have h_div : s_base_fn (p.1, p.2) - p.1 = p.2 ^ 2 * U_base (p.1, p.2) :=
        (hU_props p.1 p.2 (hU_bh_sub hp_bh)).1
      dsimp [U_steep]
      rw [h_eq_fn, show s_base_fn p - p.1 = p.2 ^ 2 * U_base p from h_div]
      exact mul_div_cancel_left₀ (U_base p) ht2_ne
    · rfl
  let U₀_comb : Set (ℂ × ℂ) := W_steep_init ∪ U_bh
  have hU₀_comb_open : IsOpen U₀_comb := hW_open.union hU_bh_open
  have hU_comb_holo : DifferentiableOn ℂ U_comb U₀_comb :=
    (hU_steep_holo.congr hU_comb_st).union_of_isOpen
      ((hU_holo.mono hU_bh_sub).congr hU_comb_bh) hW_open hU_bh_open
  clear_value U_comb

  
  have hPatches : ∀ p_star ∈ Ω_mid,
      ∃ (V B : Set ℂ) (H : ℂ × ℂ → ℂ),
        IsOpen V ∧ Convex ℝ V ∧ p_star.1 ∈ V ∧ (∀ y ∈ V, (y.re : ℂ) ∈ V) ∧
        IsOpen B ∧ p_star.2 ∈ B ∧
        DifferentiableOn ℂ H (V ×ˢ B) ∧
        (∀ q ∈ V ×ˢ B, |q.1.im| < δ_seed → q ∈ U_bh ∧ H q = U_base q) ∧
        ‖H p_star‖ ≤ A₀ * M_scale ^ 2 * (h_ref - p_star.1.im) ^ (1 - 2 * α) := by
    intro p_star hp_star
    let x_star : ℝ := p_star.1.re
    let σ_star : ℝ := p_star.1.im
    let t_star : ℂ := p_star.2
    let δ_h : ℝ := h_ref - σ_star
    let R₀ : ℝ := r * (δ_h / d) ^ α
    rcases hp_star with ⟨hδ_lo, hδ_hi, hx_star_re, ht_star_lt⟩
    change h_ref / (2 * K₀) < δ_h at hδ_lo
    change δ_h < h_ref + δ_seed at hδ_hi
    change |x_star - x₀| < m_aux * δ_h at hx_star_re
    change ‖t_star‖ < R₀ at ht_star_lt
    have hδ_h_pos : 0 < δ_h := lt_trans (by positivity) hδ_lo
    have hR₀_pos : 0 < R₀ := by dsimp [R₀]; positivity
    have hδ_h_lt_2h : δ_h < 2 * h_ref := by linarith only [hδ_hi, hδ_seed_lt_16, hs_base, hs_le_h]
    have hσ_star_lo : -δ_seed < σ_star := by dsimp [δ_h] at hδ_hi; linarith only [hδ_hi]
    have hσ_star_hi : σ_star < h_ref := by dsimp [δ_h] at hδ_h_pos; linarith only [hδ_h_pos]

    let c : ℂ := t_star / ((3 * R₀ : ℝ) : ℂ)
    have hc_lt : ‖c‖ < 1 / 3 := by
      dsimp [c]
      rw [norm_div, Complex.norm_real, Real.norm_of_nonneg (by positivity),
        div_lt_iff₀ (by positivity)]
      linarith only [ht_star_lt]

    let θ_r : ℝ := s_base / (16 * C_err_init * (h_ref + s_base))
    have hθ_r_pos : 0 < θ_r := by dsimp [θ_r]; positivity
    let r' : ℝ := max (1 / 2) (1 - θ_r)
    have hr'_lo : 1 / 2 ≤ r' := le_max_left _ _
    have hr'_pos : 0 < r' := lt_of_lt_of_le (by norm_num) hr'_lo
    have hr'_hi : r' < 1 := max_lt (by norm_num) (by linarith only [hθ_r_pos])
    have h1_lt_inv : 1 < 1 / r' := (one_lt_div hr'_pos).mpr hr'_hi
    have hCerr_r' : C_err_init * (1 - r') ≤ s_base / (16 * (h_ref + s_base)) := by
      have h1_sub : 1 - r' ≤ θ_r := by
        have : 1 - θ_r ≤ r' := le_max_right _ _
        linarith only [this]
      calc C_err_init * (1 - r')
          ≤ C_err_init * θ_r := mul_le_mul_of_nonneg_left h1_sub hCerr.le
        _ = s_base / (16 * (h_ref + s_base)) := by
            dsimp [θ_r]
            have hne : h_ref + s_base ≠ 0 := by positivity
            field_simp [hCerr.ne', hne]

    obtain ⟨g, hg_holo, hg_zero, hg_disk, hg_col_raw⟩ :=
      hBump_apply c r' hc_lt hr'_lo hr'_hi

    let μ_y : ℝ := min (δ_seed / 2) (δ_h / (24 * (2 + C_bump_init)))
    have hμ_y_pos : 0 < μ_y := lt_min (by positivity) (by positivity)
    have hμ_y_le_seed : μ_y ≤ δ_seed / 2 := min_le_left _ _
    have hμ_y_le_δh : (2 + C_bump_init) * μ_y ≤ δ_h / 24 := by
      have hle : μ_y ≤ δ_h / (24 * (2 + C_bump_init)) := min_le_right _ _
      have hden_pos : 0 < 24 * (2 + C_bump_init) := by positivity
      have hmul := (le_div_iff₀ hden_pos).mp hle
      linarith only [hmul]

    let μ_t : ℝ := min ((R₀ - ‖t_star‖) / 2) (γ_init * R₀ / 10)
    have hμ_t_pos : 0 < μ_t := lt_min (by linarith only [ht_star_lt]) (by positivity)
    have hμ_t_le_R₀ : μ_t ≤ (R₀ - ‖t_star‖) / 2 := min_le_left _ _
    have hμ_t_le_γ : μ_t ≤ γ_init * R₀ / 10 := min_le_right _ _

    let V : Set ℂ :=
      { y : ℂ |
        x_star - μ_y < y.re ∧ y.re < x_star + μ_y ∧
        -δ_seed < y.im ∧ y.im < max σ_star 0 + μ_y }
    let B : Set ℂ := Metric.ball t_star μ_t

    have hV_open : IsOpen V :=
      (isOpen_lt continuous_const Complex.continuous_re).inter <|
        (isOpen_lt Complex.continuous_re continuous_const).inter <|
          (isOpen_lt continuous_const Complex.continuous_im).inter <|
            isOpen_lt Complex.continuous_im continuous_const
    have hV_conv : Convex ℝ V := by
      intro y₁ hy₁ y₂ hy₂ a b ha hb hab
      rcases hy₁ with ⟨h1a, h1b, h1c, h1d⟩
      rcases hy₂ with ⟨h2a, h2b, h2c, h2d⟩
      have hre := h_conv_lt (x_star - μ_y) (x_star + μ_y) y₁.re y₂.re a b
        h1a h1b h2a h2b ha hb hab
      have him := h_conv_lt (-δ_seed) (max σ_star 0 + μ_y) y₁.im y₂.im a b
        h1c h1d h2c h2d ha hb hab
      refine ⟨?_, ?_, ?_, ?_⟩ <;> simp [hre.1, hre.2, him.1, him.2]
    have hp1_V : p_star.1 ∈ V := by
      have hmax : σ_star ≤ max σ_star 0 := le_max_left _ _
      exact ⟨by dsimp [x_star]; linarith only [hμ_y_pos],
        by dsimp [x_star]; linarith only [hμ_y_pos],
        hσ_star_lo, by dsimp [σ_star] at *; linarith only [hmax, hμ_y_pos]⟩
    have hV_re : ∀ y ∈ V, (y.re : ℂ) ∈ V := by
      intro y hy
      have hmax : 0 ≤ max σ_star 0 := le_max_right _ _
      exact ⟨by simp [hy.1], by simp [hy.2.1],
        by simp; linarith only [hδ_seed_pos],
        by simp; linarith only [hmax, hμ_y_pos]⟩
    have hB_open : IsOpen B := Metric.isOpen_ball
    have hp2_B : p_star.2 ∈ B := Metric.mem_ball_self hμ_t_pos

    let Φ : (ℂ × ℂ) × ℂ → ℂ × ℂ := fun q =>
      (q.1.1 - Complex.I * (q.1.1 - (x_star : ℂ)) * g q.2,
       q.1.2 + ((3 * R₀ : ℝ) : ℂ) * q.2)
    have hΦ_holo : DifferentiableOn ℂ Φ ((V ×ˢ B) ×ˢ Metric.ball (0 : ℂ) (1 / r')) := by
      have h_q11 : DifferentiableOn ℂ (fun q : (ℂ × ℂ) × ℂ => q.1.1)
          ((V ×ˢ B) ×ˢ Metric.ball (0 : ℂ) (1 / r')) :=
        (differentiable_fst.comp differentiable_fst).differentiableOn
      have h_q12 : DifferentiableOn ℂ (fun q : (ℂ × ℂ) × ℂ => q.1.2)
          ((V ×ˢ B) ×ˢ Metric.ball (0 : ℂ) (1 / r')) :=
        (differentiable_snd.comp differentiable_fst).differentiableOn
      have h_g : DifferentiableOn ℂ (fun q : (ℂ × ℂ) × ℂ => g q.2)
          ((V ×ˢ B) ×ˢ Metric.ball (0 : ℂ) (1 / r')) :=
        hg_holo.comp differentiableOn_snd (fun _ h => h.2)
      have h_fst := h_q11.sub (((differentiableOn_const Complex.I).mul
        (h_q11.sub (differentiableOn_const (x_star : ℂ)))).mul h_g)
      have h_snd := h_q12.add
        ((differentiableOn_const ((3 * R₀ : ℝ) : ℂ)).mul differentiableOn_snd)
      exact fun x hx => (h_fst x hx).prodMk (h_snd x hx)
    have hΦ_zero : ∀ q ∈ V ×ˢ B, Φ (q, 0) = q := by
      intro q _
      ext <;> simp [Φ, hg_zero]

    have h2δ_seed_eq : 2 * δ_seed * (1 + C_bump_init) = s_base / 8 := by
      dsimp [δ_seed]
      have hne : 1 + C_bump_init ≠ 0 := by positivity
      field_simp [hne]
      ring

    
    have hΦ_disk_common : ∀ q ∈ V ×ˢ B, ∀ ζ ∈ Metric.closedBall (0 : ℂ) 1,
        ‖(Φ (q, ζ)).2‖ < 4 * R₀ ∧
        ‖(Φ (q, ζ)).2‖ < ρ_base ∧
        (2 / 3) * δ_h < h_ref - (Φ (q, ζ)).1.im := by
      intro q hq ζ hζ
      rcases hq with ⟨⟨hy_lo, hy_hi, hσ_lo, hσ_hi⟩, ht_ball⟩
      have hζ_norm : ‖ζ‖ ≤ 1 := by simpa [Metric.mem_closedBall] using hζ
      obtain ⟨hg_norm, hg_im_lo, hg_im_hi⟩ := hg_disk ζ hζ
      have hg_re_abs : |(g ζ).re| ≤ C_bump_init :=
        le_trans (Complex.abs_re_le_norm _) hg_norm
      have ht_dist : ‖q.2 - t_star‖ < μ_t := by
        simpa [B, Metric.mem_ball, dist_eq_norm] using ht_ball
      have htc_lt : ‖q.2‖ < R₀ := by
        have htri : ‖q.2‖ ≤ ‖t_star‖ + ‖q.2 - t_star‖ := by
          simpa using norm_add_le t_star (q.2 - t_star)
        linarith only [htri, ht_dist, hμ_t_le_R₀, ht_star_lt]
      have ht'_lt_4R₀ : ‖(Φ (q, ζ)).2‖ < 4 * R₀ := by
        dsimp [Φ]
        have htri := norm_add_le q.2 (((3 * R₀ : ℝ) : ℂ) * ζ)
        have hmul_n : ‖((3 * R₀ : ℝ) : ℂ) * ζ‖ ≤ 3 * R₀ := by
          rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg (by positivity)]
          exact mul_le_of_le_one_right (by positivity) hζ_norm
        linarith only [htri, htc_lt, hmul_n]
      have h4R₀_lt_ρ : 4 * R₀ < ρ_base := by
        have hrpow_le : (δ_h / d) ^ α ≤ (2 * h_ref / d) ^ α :=
          Real.rpow_le_rpow (by positivity)
            (div_le_div_of_nonneg_right hδ_h_lt_2h.le hd.le) hα_pos.le
        have h4 : 4 * R₀ ≤ 4 * r * (2 * h_ref / d) ^ α := by
          dsimp [R₀]
          have hmul := mul_le_mul_of_nonneg_left hrpow_le (by positivity : 0 ≤ 4 * r)
          linarith only [hmul]
        have hpos_fac : 0 < r * (2 * h_ref / d) ^ α := by positivity
        linarith only [h4, hpos_fac, hr_small]
      let u : ℝ := q.1.re - x_star
      let σ : ℝ := q.1.im
      have hu_abs : |u| < μ_y :=
        abs_lt.mpr ⟨by dsimp [u]; linarith only [hy_lo], by dsimp [u]; linarith only [hy_hi]⟩
      have hy'_im : (Φ (q, ζ)).1.im = σ * (1 + (g ζ).im) - u * (g ζ).re := by
        dsimp [Φ, u, σ]
        simp [mul_assoc]
        ring
      have h1_gim_nonneg : 0 ≤ 1 + (g ζ).im := by linarith only [hg_im_lo]
      have h1_gim_lt_2 : 1 + (g ζ).im < 2 := by
        dsimp [η_init] at hg_im_hi
        have h8K : 1 / (8 * K₀) < 1 := (div_lt_one (by positivity)).mpr (by linarith only [hK₀])
        linarith only [hg_im_hi, h8K]
      have hmax_nonneg : 0 ≤ max σ_star 0 := le_max_right _ _
      have hσ_term_le :
          σ * (1 + (g ζ).im) ≤ max σ_star 0 * (1 + η_init) + 2 * μ_y := by
        have h1 : σ * (1 + (g ζ).im) ≤ (max σ_star 0 + μ_y) * (1 + (g ζ).im) :=
          mul_le_mul_of_nonneg_right hσ_hi.le h1_gim_nonneg
        have h2 : max σ_star 0 * (1 + (g ζ).im) ≤ max σ_star 0 * (1 + η_init) :=
          mul_le_mul_of_nonneg_left (by linarith only [hg_im_hi]) hmax_nonneg
        have h3 : μ_y * (1 + (g ζ).im) ≤ 2 * μ_y := by nlinarith only [hμ_y_pos, h1_gim_lt_2]
        linarith only [h1, h2, h3]
      have hu_term_lt : -u * (g ζ).re < C_bump_init * μ_y := by
        have h1 : -u * (g ζ).re ≤ |u * (g ζ).re| := by
          have hneg := neg_le_abs (u * (g ζ).re)
          linarith only [hneg]
        rw [abs_mul] at h1
        have h2 : |u| * |(g ζ).re| ≤ |u| * C_bump_init :=
          mul_le_mul_of_nonneg_left hg_re_abs (abs_nonneg u)
        have h3 : |u| * C_bump_init < μ_y * C_bump_init :=
          mul_lt_mul_of_pos_right hu_abs hCb
        linarith only [h1, h2, h3]
      have hy'_im_lt : (Φ (q, ζ)).1.im < max σ_star 0 * (1 + η_init) + δ_h / 24 := by
        rw [hy'_im]
        linarith only [hσ_term_le, hu_term_lt, hμ_y_le_δh]
      refine ⟨ht'_lt_4R₀, lt_trans ht'_lt_4R₀ h4R₀_lt_ρ, ?_⟩
      rcases le_or_gt 0 σ_star with hσ_ge | hσ_neg
      · rw [max_eq_left hσ_ge] at hy'_im_lt
        have hη_bound : σ_star * η_init < δ_h / 4 := by
          dsimp [η_init]
          have h0 : σ_star * (1 / (8 * K₀)) = σ_star / (8 * K₀) := by ring
          have h1 : σ_star / (8 * K₀) ≤ h_ref / (8 * K₀) :=
            div_le_div_of_nonneg_right hσ_star_hi.le (by positivity)
          have h2 : h_ref / (8 * K₀) = (h_ref / (2 * K₀)) / 4 := by ring
          linarith only [h0, h1, h2, hδ_lo]
        have hσ_eq : σ_star = h_ref - δ_h := by dsimp [δ_h]; ring
        linarith only [hy'_im_lt, hη_bound, hσ_eq, hδ_h_pos]
      · rw [max_eq_right hσ_neg.le] at hy'_im_lt
        have hδ_lt_17 : δ_h < (17 / 16) * h_ref := by
          linarith only [hδ_hi, hδ_seed_lt_16, hs_le_h]
        linarith only [hy'_im_lt, hδ_lt_17, hδ_h_pos]

    have hΦ_seed : ∀ q ∈ V ×ˢ B, |q.1.im| < δ_seed →
        ∀ ζ ∈ Metric.closedBall (0 : ℂ) 1, Φ (q, ζ) ∈ U_bh := by
      intro q hq hσ_abs ζ hζ
      obtain ⟨_, ht'_ρ, _⟩ := hΦ_disk_common q hq ζ hζ
      rcases hq with ⟨⟨hy_lo, hy_hi, _, _⟩, _⟩
      obtain ⟨hg_norm, _, _⟩ := hg_disk ζ hζ
      have hg_re_abs : |(g ζ).re| ≤ C_bump_init :=
        le_trans (Complex.abs_re_le_norm _) hg_norm
      have hg_im_abs : |(g ζ).im| ≤ C_bump_init :=
        le_trans (Complex.abs_im_le_norm _) hg_norm
      let u : ℝ := q.1.re - x_star
      let σ : ℝ := q.1.im
      have hu_abs : |u| < δ_seed / 2 :=
        lt_of_lt_of_le
          (abs_lt.mpr ⟨by dsimp [u]; linarith only [hy_lo], by dsimp [u]; linarith only [hy_hi]⟩)
          hμ_y_le_seed
      have hy'_im : (Φ (q, ζ)).1.im = σ + σ * (g ζ).im - u * (g ζ).re := by
        dsimp [Φ, u, σ]
        simp [mul_assoc]
        ring
      refine ⟨?_, ht'_ρ⟩
      rw [hy'_im]
      have htri1 : |σ + σ * (g ζ).im - u * (g ζ).re| ≤
          |σ + σ * (g ζ).im| + |u * (g ζ).re| := abs_sub _ _
      have htri2 : |σ + σ * (g ζ).im| ≤ |σ| + |σ * (g ζ).im| := abs_add_le _ _
      rw [abs_mul] at htri1 htri2
      have h1 : |σ| * |(g ζ).im| ≤ δ_seed * C_bump_init :=
        mul_le_mul hσ_abs.le hg_im_abs (abs_nonneg _) hδ_seed_pos.le
      have h2 : |u| * |(g ζ).re| ≤ (δ_seed / 2) * C_bump_init :=
        mul_le_mul hu_abs.le hg_re_abs (abs_nonneg _) (by positivity)
      linarith only [htri1, htri2, hσ_abs, h1, h2, hδ_seed_pos, h2δ_seed_eq, hs_base]

    have hΦ_cir : ∀ q ∈ V ×ˢ B, ∀ ϕ : ℝ,
        let ζ := Complex.exp ((ϕ : ℂ) * Complex.I)
        Φ (q, ζ) ∈ U_bh ∨
        (Φ (q, ζ) ∈ W_steep_init ∧ (2 / 3) * δ_h < h_ref - (Φ (q, ζ)).1.im) := by
      intro q hq ϕ ζ
      have hζ_norm : ‖ζ‖ = 1 := Complex.norm_exp_ofReal_mul_I ϕ
      have hζ_sph : ζ ∈ Metric.sphere (0 : ℂ) 1 := by simp [hζ_norm]
      have hζ_cl : ζ ∈ Metric.closedBall (0 : ℂ) 1 := by simp [Metric.mem_closedBall, hζ_norm]
      obtain ⟨ht'_4R₀, ht'_ρ, hdepth_23⟩ := hΦ_disk_common q hq ζ hζ_cl
      rcases hq with ⟨⟨hy_lo, hy_hi, hσ_lo, hσ_hi⟩, ht_ball⟩
      obtain ⟨hg_norm, hg_im_lo, hg_im_hi⟩ := hg_disk ζ hζ_cl
      have hg_re_abs : |(g ζ).re| ≤ C_bump_init :=
        le_trans (Complex.abs_re_le_norm _) hg_norm
      let u : ℝ := q.1.re - x_star
      let σ : ℝ := q.1.im
      have hu_abs : |u| < μ_y :=
        abs_lt.mpr ⟨by dsimp [u]; linarith only [hy_lo], by dsimp [u]; linarith only [hy_hi]⟩
      have hu_seed : |u| < δ_seed / 2 := lt_of_lt_of_le hu_abs hμ_y_le_seed
      have hmax_lt_h : max σ_star 0 < h_ref := max_lt hσ_star_hi hh_ref
      have hσ_abs_lt : |σ| < h_ref + s_base := by
        rw [abs_lt]
        exact ⟨by dsimp [σ] at *; linarith only [hσ_lo, hδ_seed_lt_16, hs_base, hh_ref],
          by dsimp [σ] at *; linarith only [hσ_hi, hmax_lt_h, hμ_y_le_seed, hδ_seed_lt_16, hs_base]⟩
      have hy'_re : (Φ (q, ζ)).1.re = x_star + u * (1 + (g ζ).im) + σ * (g ζ).re := by
        dsimp [Φ, u, σ]
        simp [mul_assoc]
        ring
      have hy'_im : (Φ (q, ζ)).1.im = σ * (1 + (g ζ).im) - u * (g ζ).re := by
        dsimp [Φ, u, σ]
        simp [mul_assoc]
        ring
      have h1_gim_nonneg : 0 ≤ 1 + (g ζ).im := by linarith only [hg_im_lo]
      have h1_gim_lt_2 : 1 + (g ζ).im < 2 := by
        dsimp [η_init] at hg_im_hi
        have h8K : 1 / (8 * K₀) < 1 := (div_lt_one (by positivity)).mpr (by linarith only [hK₀])
        linarith only [hg_im_hi, h8K]

      rcases le_or_gt |(c + ζ).im| ((6 / 5) * γ_init * ‖c + ζ‖) with h_col | h_steep
      · left
        obtain ⟨_, hg_col_hi⟩ := hg_col_raw ζ hζ_sph h_col
        have hg_col_bound : 1 + (g ζ).im ≤ s_base / (16 * (h_ref + s_base)) :=
          le_trans hg_col_hi hCerr_r'
        refine ⟨?_, ht'_ρ⟩
        rw [hy'_im]
        have htri : |σ * (1 + (g ζ).im) - u * (g ζ).re| ≤
            |σ * (1 + (g ζ).im)| + |u * (g ζ).re| := abs_sub _ _
        rw [abs_mul, abs_mul, abs_of_nonneg h1_gim_nonneg] at htri
        have h1 : |σ| * (1 + (g ζ).im) ≤ s_base / 16 := by
          calc |σ| * (1 + (g ζ).im)
              ≤ (h_ref + s_base) * (s_base / (16 * (h_ref + s_base))) :=
                mul_le_mul hσ_abs_lt.le hg_col_bound h1_gim_nonneg (by positivity)
            _ = s_base / 16 := by
                have hne : h_ref + s_base ≠ 0 := by positivity
                field_simp [hne]
        have h2 : |u| * |(g ζ).re| ≤ (δ_seed / 2) * C_bump_init :=
          mul_le_mul hu_seed.le hg_re_abs (abs_nonneg _) (by positivity)
        linarith only [htri, h1, h2, hδ_seed_pos, h2δ_seed_eq, hs_base]
      · right
        refine ⟨⟨?_, ?_, ?_, ?_, ?_⟩, hdepth_23⟩
        · linarith only [hd, h4d, hδ_lo, hdepth_23]
        · rw [hy'_im]
          have h1 : -2 * δ_seed ≤ σ * (1 + (g ζ).im) := by
            rcases le_or_gt 0 σ with hσ0 | hσ0
            · have hpos_p : 0 ≤ σ * (1 + (g ζ).im) := mul_nonneg hσ0 h1_gim_nonneg
              linarith only [hpos_p, hδ_seed_pos]
            · nlinarith only [hσ_lo, hσ0, h1_gim_nonneg, h1_gim_lt_2]
          have h2 : u * (g ζ).re ≤ (δ_seed / 2) * C_bump_init := by
            have hle : u * (g ζ).re ≤ |u * (g ζ).re| := le_abs_self _
            rw [abs_mul] at hle
            exact le_trans hle
              (mul_le_mul hu_seed.le hg_re_abs (abs_nonneg _) (by positivity))
          have h3 : 0 ≤ δ_seed * C_bump_init := mul_nonneg hδ_seed_pos.le hCb.le
          linarith only [h1, h2, h3, hδ_seed_pos, h2δ_seed_eq, hs_base]
        · rw [hy'_re]
          have hsub : x_star + u * (1 + (g ζ).im) + σ * (g ζ).re - x₀ =
              (x_star - x₀) + (u * (1 + (g ζ).im) + σ * (g ζ).re) := by ring
          rw [hsub]
          have htri1 := abs_add_le (x_star - x₀) (u * (1 + (g ζ).im) + σ * (g ζ).re)
          have htri2 := abs_add_le (u * (1 + (g ζ).im)) (σ * (g ζ).re)
          rw [abs_mul, abs_mul, abs_of_nonneg h1_gim_nonneg] at htri2
          have hu2 : |u| * (1 + (g ζ).im) ≤ 2 * μ_y := by
            nlinarith only [abs_nonneg u, hu_abs, h1_gim_nonneg, h1_gim_lt_2]
          have h2μ : 2 * μ_y ≤ 2 * δ_h := by
            nlinarith only [hμ_y_pos, hCb, hμ_y_le_δh, hδ_h_pos]
          have h2h_le : 2 * h_ref ≤ 4 * K₀ * δ_h := by
            have hdiv := (div_lt_iff₀ (by positivity : 0 < 2 * K₀)).mp hδ_lo
            linarith only [hdiv]
          have hσ_g : |σ| * |(g ζ).re| ≤ 4 * K₀ * C_bump_init * δ_h := by
            have hσ2 : |σ| ≤ 2 * h_ref := by linarith only [hσ_abs_lt, hs_le_h]
            calc |σ| * |(g ζ).re|
                ≤ (2 * h_ref) * C_bump_init :=
                  mul_le_mul hσ2 hg_re_abs (abs_nonneg _) (by positivity)
              _ ≤ (4 * K₀ * δ_h) * C_bump_init :=
                  mul_le_mul_of_nonneg_right h2h_le hCb.le
              _ = 4 * K₀ * C_bump_init * δ_h := by ring
          have hsum_lt :
              |(x_star - x₀) + (u * (1 + (g ζ).im) + σ * (g ζ).re)| <
                m_steep_init * (δ_h / 2) := by
            dsimp [m_steep_init]
            nlinarith only [htri1, htri2, hx_star_re, hu2, h2μ, hσ_g, hCb, hδ_h_pos]
          have h_half_lt : m_steep_init * (δ_h / 2) <
              m_steep_init * (h_ref - (Φ (q, ζ)).1.im) :=
            mul_lt_mul_of_pos_left (by linarith only [hδ_h_pos, hdepth_23]) hm_steep_pos
          exact lt_trans hsum_lt h_half_lt
        · have h23_rpow : (2 / 3 : ℝ) ≤ (2 / 3 : ℝ) ^ α := by
            simpa using Real.rpow_le_rpow_of_exponent_ge
              (by norm_num : (0 : ℝ) < 2 / 3) (by norm_num : (2 / 3 : ℝ) ≤ 1) hα₂.le
          have hrpow_mul : ((2 / 3) * δ_h / d) ^ α = (2 / 3 : ℝ) ^ α * (δ_h / d) ^ α := by
            rw [show (2 / 3) * δ_h / d = (2 / 3) * (δ_h / d) by ring]
            exact Real.mul_rpow (by norm_num) (by positivity)
          have hrpow_mono : ((2 / 3) * δ_h / d) ^ α ≤
              ((h_ref - (Φ (q, ζ)).1.im) / d) ^ α :=
            Real.rpow_le_rpow (by positivity)
              (div_le_div_of_nonneg_right hdepth_23.le hd.le) hα_pos.le
          calc ‖(Φ (q, ζ)).2‖
              < 4 * R₀ := ht'_4R₀
            _ < 10 * (2 / 3 : ℝ) * R₀ := by linarith only [hR₀_pos]
            _ ≤ 10 * (2 / 3 : ℝ) ^ α * R₀ :=
                mul_le_mul_of_nonneg_right
                  (mul_le_mul_of_nonneg_left h23_rpow (by norm_num)) hR₀_pos.le
            _ = 10 * r * ((2 / 3) * δ_h / d) ^ α := by
                dsimp [R₀]; rw [hrpow_mul]; ring
            _ ≤ 10 * r * ((h_ref - (Φ (q, ζ)).1.im) / d) ^ α :=
                mul_le_mul_of_nonneg_left hrpow_mono (by positivity)
        · let w₀ : ℂ := t_star + ((3 * R₀ : ℝ) : ℂ) * ζ
          let Δ_t : ℂ := q.2 - t_star
          have ht'_eq : (Φ (q, ζ)).2 = w₀ + Δ_t := by dsimp [Φ, w₀, Δ_t]; ring
          have hw₀_eq : w₀ = ((3 * R₀ : ℝ) : ℂ) * (c + ζ) := by
            dsimp [w₀, c]
            have hne : ((3 * R₀ : ℝ) : ℂ) ≠ 0 :=
              Complex.ofReal_ne_zero.mpr (by positivity)
            field_simp [hne]
          have hcz_gt : 2 / 3 < ‖c + ζ‖ := by
            have htri : ‖ζ‖ ≤ ‖c + ζ‖ + ‖c‖ := by
              have := norm_sub_le (c + ζ) c
              simpa using this
            linarith only [hζ_norm, htri, hc_lt]
          have hw₀_norm : ‖w₀‖ = 3 * R₀ * ‖c + ζ‖ := by
            rw [hw₀_eq, norm_mul, Complex.norm_real, Real.norm_of_nonneg (by positivity)]
          have hw₀_gt : 2 * R₀ < ‖w₀‖ := by nlinarith only [hw₀_norm, hcz_gt, hR₀_pos]
          have hw₀_im : |w₀.im| = 3 * R₀ * |(c + ζ).im| := by
            have him : w₀.im = 3 * R₀ * (c + ζ).im := by rw [hw₀_eq]; simp
            rw [him, abs_mul, abs_of_pos (by positivity)]
          have hw₀_steep : (6 / 5) * γ_init * ‖w₀‖ < |w₀.im| := by
            rw [hw₀_norm, hw₀_im]
            have hmul := mul_lt_mul_of_pos_left h_steep (by positivity : 0 < 3 * R₀)
            linarith only [hmul]
          have hΔ_lt : ‖Δ_t‖ < γ_init * R₀ / 10 :=
            lt_of_lt_of_le (by simpa [B, Δ_t, Metric.mem_ball, dist_eq_norm] using ht_ball)
              hμ_t_le_γ
          have hΔ_im : |Δ_t.im| < γ_init * R₀ / 10 :=
            lt_of_le_of_lt (Complex.abs_im_le_norm _) hΔ_lt
          have ht'_norm_le : ‖(Φ (q, ζ)).2‖ ≤ ‖w₀‖ + ‖Δ_t‖ := by
            rw [ht'_eq]; exact norm_add_le w₀ Δ_t
          have hw₀_im_le : |w₀.im| ≤ |(Φ (q, ζ)).2.im| + |Δ_t.im| := by
            have hsub : w₀.im = (Φ (q, ζ)).2.im - Δ_t.im := by rw [ht'_eq]; simp
            rw [hsub]
            exact abs_sub _ _
          have hγ_Δ : γ_init * ‖Δ_t‖ < γ_init * R₀ / 10 := by
            nlinarith only [hγ_pos, hγ_lt_8, norm_nonneg Δ_t, hΔ_lt]
          have hγR_pos : 0 < γ_init * R₀ := mul_pos hγ_pos hR₀_pos
          have hw₀_steep' : (6 / 5) * (γ_init * ‖w₀‖) < |w₀.im| := by
            have heq : (6 / 5) * (γ_init * ‖w₀‖) = (6 / 5) * γ_init * ‖w₀‖ := by ring
            linarith only [heq, hw₀_steep]
          have hγ_t' : γ_init * ‖(Φ (q, ζ)).2‖ ≤ γ_init * ‖w₀‖ + γ_init * ‖Δ_t‖ := by
            have hmul := mul_le_mul_of_nonneg_left ht'_norm_le hγ_pos.le
            linarith only [hmul]
          have hγ_w₀ : 2 * (γ_init * R₀) < γ_init * ‖w₀‖ := by
            have hmul := mul_lt_mul_of_pos_left hw₀_gt hγ_pos
            linarith only [hmul]
          linarith only [hγR_pos, hγ_t', hγ_w₀, hw₀_steep', hw₀_im_le, hγ_Δ, hΔ_im]

    let H : ℂ × ℂ → ℂ := circleAvgCont U_comb Φ
    have hΦ_cir_U₀ : ∀ q ∈ V ×ˢ B, ∀ ϕ : ℝ,
        Φ (q, Complex.exp ((ϕ : ℂ) * Complex.I)) ∈ U₀_comb := by
      intro q hq ϕ
      rcases hΦ_cir q hq ϕ with h_bh | ⟨h_st, _⟩
      · exact Or.inr h_bh
      · exact Or.inl h_st
    obtain ⟨hH_holo, hH_eval, hH_bd⟩ :=
      h_s2 (V ×ˢ B) U₀_comb U_comb Φ (1 / r') (hV_open.prod hB_open)
        hU₀_comb_open hU_comb_holo h1_lt_inv hΦ_holo hΦ_zero hΦ_cir_U₀

    refine ⟨V, B, H, hV_open, hV_conv, hp1_V, hV_re, hB_open, hp2_B, hH_holo, ?_, ?_⟩
    · intro q hq hq_im
      have hq_bh : q ∈ U_bh := by
        have h0 := hΦ_seed q hq hq_im 0 (Metric.mem_closedBall_self zero_le_one)
        rwa [hΦ_zero q hq] at h0
      have h_eq1 : H q = U_comb q :=
        hH_eval q hq (fun ζ hζ => Or.inr (hΦ_seed q hq hq_im ζ hζ))
      rw [h_eq1, hU_comb_bh q hq_bh]
      exact ⟨hq_bh, rfl⟩
    · refine hH_bd p_star ⟨hp1_V, hp2_B⟩ (A₀ * M_scale ^ 2 * δ_h ^ (1 - 2 * α)) (fun ϕ _ => ?_)
      rcases hΦ_cir p_star ⟨hp1_V, hp2_B⟩ ϕ with h_bh | ⟨h_st, h_depth⟩
      · rw [hU_comb_bh _ h_bh]
        have hub : ‖U_base (Φ (p_star, Complex.exp ((ϕ : ℂ) * Complex.I)))‖ ≤ C_init :=
          (hU_props _ _ (hU_bh_sub h_bh)).2.2
        have hrpow_le : (2 * h_ref) ^ (1 - 2 * α) ≤ δ_h ^ (1 - 2 * α) :=
          Real.rpow_le_rpow_of_nonpos hδ_h_pos hδ_h_lt_2h.le (by linarith only [hα₁])
        calc ‖U_base (Φ (p_star, Complex.exp ((ϕ : ℂ) * Complex.I)))‖
            ≤ C_init := hub
          _ ≤ M_scale ^ 2 * (2 * h_ref) ^ (1 - 2 * α) := hC_init_le
          _ ≤ M_scale ^ 2 * δ_h ^ (1 - 2 * α) :=
              mul_le_mul_of_nonneg_left hrpow_le (by positivity)
          _ = 1 * M_scale ^ 2 * δ_h ^ (1 - 2 * α) := by ring
          _ ≤ A₀ * M_scale ^ 2 * δ_h ^ (1 - 2 * α) :=
              mul_le_mul_of_nonneg_right
                (mul_le_mul_of_nonneg_right hA₀_ge_one (by positivity)) (by positivity)
      · rw [hU_comb_st _ h_st]
        have hst_b := hU_steep_norm _ h_st
        have hrpow_le :
            (h_ref - (Φ (p_star, Complex.exp ((ϕ : ℂ) * Complex.I))).1.im) ^ (1 - 2 * α) ≤
              ((2 / 3) * δ_h) ^ (1 - 2 * α) :=
          Real.rpow_le_rpow_of_nonpos (by positivity) h_depth.le (by linarith only [hα₁])
        have h23_eq : ((2 / 3) * δ_h) ^ (1 - 2 * α) =
            (3 / 2 : ℝ) ^ (2 * α - 1) * δ_h ^ (1 - 2 * α) := by
          rw [Real.mul_rpow (by norm_num) hδ_h_pos.le]
          congr 1
          have h_inv : (2 / 3 : ℝ) = (3 / 2 : ℝ) ^ (-1 : ℝ) := by
            rw [Real.rpow_neg_one]; norm_num
          rw [h_inv, ← Real.rpow_mul (by norm_num)]
          ring_nf
        have hA₀_st : (3 / 2 : ℝ) ^ (2 * α - 1) * C_st ≤ A₀ := le_max_right _ _
        calc ‖U_steep (Φ (p_star, Complex.exp ((ϕ : ℂ) * Complex.I)))‖
            ≤ C_st * M_scale ^ 2 *
                (h_ref - (Φ (p_star, Complex.exp ((ϕ : ℂ) * Complex.I))).1.im) ^ (1 - 2 * α) :=
              hst_b
          _ ≤ C_st * M_scale ^ 2 * ((2 / 3) * δ_h) ^ (1 - 2 * α) :=
              mul_le_mul_of_nonneg_left hrpow_le (by positivity)
          _ = ((3 / 2 : ℝ) ^ (2 * α - 1) * C_st) * M_scale ^ 2 * δ_h ^ (1 - 2 * α) := by
              rw [h23_eq]; ring
          _ ≤ A₀ * M_scale ^ 2 * δ_h ^ (1 - 2 * α) :=
              mul_le_mul_of_nonneg_right
                (mul_le_mul_of_nonneg_right hA₀_st (by positivity)) (by positivity)

  
  clear h_s2 hBump_apply h_conv_lt U_steep hU_steep_holo hU_steep_norm
    U_comb hU_comb_st hU_comb_bh U₀_comb hU₀_comb_open hU_comb_holo
  let V_ch : ∀ p ∈ Ω_mid, Set ℂ := fun p hp => (hPatches p hp).choose
  let B_ch : ∀ p ∈ Ω_mid, Set ℂ := fun p hp => (hPatches p hp).choose_spec.choose
  let H_ch : ∀ p ∈ Ω_mid, ℂ × ℂ → ℂ := fun p hp =>
    (hPatches p hp).choose_spec.choose_spec.choose
  have h_ch_spec : ∀ (p : ℂ × ℂ) (hp : p ∈ Ω_mid),
      IsOpen (V_ch p hp) ∧ Convex ℝ (V_ch p hp) ∧ p.1 ∈ V_ch p hp ∧
      (∀ y ∈ V_ch p hp, (y.re : ℂ) ∈ V_ch p hp) ∧
      IsOpen (B_ch p hp) ∧ p.2 ∈ B_ch p hp ∧
      DifferentiableOn ℂ (H_ch p hp) (V_ch p hp ×ˢ B_ch p hp) ∧
      (∀ q ∈ V_ch p hp ×ˢ B_ch p hp, |q.1.im| < δ_seed →
        q ∈ U_bh ∧ H_ch p hp q = U_base q) ∧
      ‖H_ch p hp p‖ ≤ A₀ * M_scale ^ 2 * (h_ref - p.1.im) ^ (1 - 2 * α) :=
    fun p hp => (hPatches p hp).choose_spec.choose_spec.choose_spec
  clear_value V_ch B_ch H_ch
  clear hPatches

  have h_overlap : ∀ (p₁ p₂ : ℂ × ℂ) (hp₁ : p₁ ∈ Ω_mid) (hp₂ : p₂ ∈ Ω_mid) (q₀ : ℂ × ℂ),
      q₀ ∈ V_ch p₁ hp₁ ×ˢ B_ch p₁ hp₁ →
      q₀ ∈ V_ch p₂ hp₂ ×ˢ B_ch p₂ hp₂ →
      H_ch p₁ hp₁ q₀ = H_ch p₂ hp₂ q₀ := by
    intro p₁ p₂ hp₁ hp₂ q₀ hq₁ hq₂
    obtain ⟨hV₁_open, hV₁_conv, _, hV₁_re, _, _, hH₁_holo, hH₁_seed, _⟩ := h_ch_spec p₁ hp₁
    obtain ⟨hV₂_open, hV₂_conv, _, hV₂_re, _, _, hH₂_holo, hH₂_seed, _⟩ := h_ch_spec p₂ hp₂
    let V₁₂ : Set ℂ := V_ch p₁ hp₁ ∩ V_ch p₂ hp₂
    have hV₁₂_open : IsOpen V₁₂ := hV₁_open.inter hV₂_open
    have hV₁₂_pre : IsPreconnected V₁₂ := (hV₁_conv.inter hV₂_conv).isPreconnected
    have hy₀_mem : q₀.1 ∈ V₁₂ := ⟨hq₁.1, hq₂.1⟩
    let z₀ : ℂ := (q₀.1.re : ℂ)
    have hz₀_mem : z₀ ∈ V₁₂ := ⟨hV₁_re q₀.1 hq₁.1, hV₂_re q₀.1 hq₂.1⟩
    let g₁ : ℂ → ℂ := fun y => H_ch p₁ hp₁ (y, q₀.2)
    let g₂ : ℂ → ℂ := fun y => H_ch p₂ hp₂ (y, q₀.2)
    have hg₁_ana : AnalyticOnNhd ℂ g₁ V₁₂ := by
      refine DifferentiableOn.analyticOnNhd ?_ hV₁₂_open
      exact hH₁_holo.comp (differentiable_id.prodMk (differentiable_const q₀.2)).differentiableOn
        (fun y hy => ⟨hy.1, hq₁.2⟩)
    have hg₂_ana : AnalyticOnNhd ℂ g₂ V₁₂ := by
      refine DifferentiableOn.analyticOnNhd ?_ hV₁₂_open
      exact hH₂_holo.comp (differentiable_id.prodMk (differentiable_const q₀.2)).differentiableOn
        (fun y hy => ⟨hy.2, hq₂.2⟩)
    have h_ev : g₁ =ᶠ[nhds z₀] g₂ := by
      have hO_nhds : V₁₂ ∩ Metric.ball z₀ δ_seed ∈ nhds z₀ :=
        (hV₁₂_open.inter Metric.isOpen_ball).mem_nhds
          ⟨hz₀_mem, Metric.mem_ball_self hδ_seed_pos⟩
      filter_upwards [hO_nhds] with y hy
      have hy_im : |y.im| < δ_seed := by
        have hy_dist : ‖y - z₀‖ < δ_seed := by
          simpa [Metric.mem_ball, dist_eq_norm] using hy.2
        have him_eq : y.im = (y - z₀).im := by simp [z₀]
        rw [him_eq]
        exact lt_of_le_of_lt (Complex.abs_im_le_norm _) hy_dist
      dsimp [g₁, g₂]
      rw [(hH₁_seed (y, q₀.2) ⟨hy.1.1, hq₁.2⟩ hy_im).2,
          (hH₂_seed (y, q₀.2) ⟨hy.1.2, hq₂.2⟩ hy_im).2]
    exact hg₁_ana.eqOn_of_preconnected_of_eventuallyEq hg₂_ana hV₁₂_pre hz₀_mem h_ev hy₀_mem

  let U_mid : ℂ × ℂ → ℂ := fun p => if hp : p ∈ Ω_mid then H_ch p hp p else 0
  have hU_mid_holo : DifferentiableOn ℂ U_mid Ω_mid := by
    intro p₀ hp₀
    obtain ⟨hV₀_open, _, hp₀_1, _, hB₀_open, hp₀_2, hH₀_holo, _, _⟩ := h_ch_spec p₀ hp₀
    let W₀ : Set (ℂ × ℂ) := Ω_mid ∩ (V_ch p₀ hp₀ ×ˢ B_ch p₀ hp₀)
    have hW₀_open : IsOpen W₀ := hΩ_open.inter (hV₀_open.prod hB₀_open)
    have hp₀_W₀ : p₀ ∈ W₀ := ⟨hp₀, hp₀_1, hp₀_2⟩
    have h_eq_W₀ : ∀ q ∈ W₀, U_mid q = H_ch p₀ hp₀ q := by
      intro q hq
      simp only [U_mid, hq.1, ↓reduceDIte]
      exact h_overlap q p₀ hq.1 hp₀ q
        ⟨(h_ch_spec q hq.1).2.2.1, (h_ch_spec q hq.1).2.2.2.2.2.1⟩ hq.2
    have h_diff_W₀ : DifferentiableOn ℂ U_mid W₀ :=
      (hH₀_holo.mono Set.inter_subset_right).congr h_eq_W₀
    exact ((h_diff_W₀ p₀ hp₀_W₀).differentiableAt
      (hW₀_open.mem_nhds hp₀_W₀)).differentiableWithinAt

  have hU_mid_seed : ∀ p ∈ Ω_mid, |p.1.im| < δ_seed →
      p ∈ U_bh ∧ U_mid p = U_base p := by
    intro p hp hp_im
    simp only [U_mid, hp, ↓reduceDIte]
    exact (h_ch_spec p hp).2.2.2.2.2.2.2.1 p
      ⟨(h_ch_spec p hp).2.2.1, (h_ch_spec p hp).2.2.2.2.2.1⟩ hp_im

  have hU_mid_norm : ∀ p ∈ Ω_mid,
      ‖U_mid p‖ ≤ A₀ * M_scale ^ 2 * (h_ref - p.1.im) ^ (1 - 2 * α) := by
    intro p hp
    simp only [U_mid, hp, ↓reduceDIte]
    exact (h_ch_spec p hp).2.2.2.2.2.2.2.2

  clear_value U_mid
  clear V_ch B_ch H_ch h_ch_spec h_overlap

  let s_band₀ : ℂ × ℂ → ℂ := fun p => p.1 + p.2 ^ 2 * U_mid p
  have hs_band₀_holo : DifferentiableOn ℂ s_band₀ Ω_mid := by
    have hp1 : DifferentiableOn ℂ (fun p : ℂ × ℂ => p.1) Ω_mid :=
      differentiable_fst.differentiableOn
    have hp2 : DifferentiableOn ℂ (fun p : ℂ × ℂ => p.2) Ω_mid :=
      differentiable_snd.differentiableOn
    exact hp1.add ((hp2.pow 2).mul hU_mid_holo)

  have hs_band₀_zero : ∀ y : ℂ, (y, (0 : ℂ)) ∈ Ω_mid → s_band₀ (y, 0) = y := by
    intro y _
    simp [s_band₀]

  have hs_band₀_disp : ∀ y₀ t₀ : ℂ, (y₀, t₀) ∈ Ω_mid →
      ‖s_band₀ (y₀, t₀) - y₀‖ ≤
        A₀ * ‖t₀‖ ^ 2 * M_scale ^ 2 * (h_ref - y₀.im) ^ (1 - 2 * α) := by
    intro y₀ t₀ hy₀
    have h_sub : s_band₀ (y₀, t₀) - y₀ = t₀ ^ 2 * U_mid (y₀, t₀) := by
      dsimp [s_band₀]; ring
    rw [h_sub, norm_mul, norm_pow]
    have h_ub := hU_mid_norm (y₀, t₀) hy₀
    calc ‖t₀‖ ^ 2 * ‖U_mid (y₀, t₀)‖
        ≤ ‖t₀‖ ^ 2 * (A₀ * M_scale ^ 2 * (h_ref - y₀.im) ^ (1 - 2 * α)) :=
          mul_le_mul_of_nonneg_left h_ub (by positivity)
      _ = A₀ * ‖t₀‖ ^ 2 * M_scale ^ 2 * (h_ref - y₀.im) ^ (1 - 2 * α) := by ring

  have hs_band₀_seed : ∀ p ∈ Ω_mid, |p.1.im| < δ_seed → s_band₀ p = s_base_fn p := by
    intro p hp hp_im
    obtain ⟨hp_bh, h_eq_U⟩ := hU_mid_seed p hp hp_im
    have h_div := (hU_props p.1 p.2 (hU_bh_sub hp_bh)).1
    dsimp [s_band₀]
    rw [h_eq_U]
    linear_combination -h_div

  have hΩ_neg : ∀ y t : ℂ, (y, t) ∈ Ω_mid → (y, -t) ∈ Ω_mid := by
    intro y t hyt
    exact ⟨hyt.1, hyt.2.1, hyt.2.2.1, by simpa only [norm_neg] using hyt.2.2.2⟩

  have hs_band₀_even_seed : ∀ y t : ℂ, (y, t) ∈ Ω_mid → |y.im| < δ_seed →
      s_band₀ (y, -t) = s_band₀ (y, t) := by
    intro y t hyt hy_im
    obtain ⟨hp_bh, h_eq1⟩ := hU_mid_seed (y, t) hyt hy_im
    obtain ⟨_, h_eq2⟩ := hU_mid_seed (y, -t) (hΩ_neg y t hyt) hy_im
    have hU_even := (hU_props y t (hU_bh_sub hp_bh)).2.1
    dsimp [s_band₀]
    rw [h_eq1, h_eq2, hU_even]
    ring

  clear_value s_band₀

  refine ⟨s_band₀, hs_band₀_holo, ?_, hs_band₀_zero, hs_band₀_seed, ?_⟩
  · intro y₀ t₀ hy₀
    refine ⟨?_, hs_band₀_disp y₀ t₀ hy₀⟩
    rcases lt_or_ge y₀.im 0 with hy₀_neg | hy₀_nonneg
    · have hy₀_im : |y₀.im| < δ_seed := by
        rw [abs_of_neg hy₀_neg]
        have h21 := hy₀.2.1
        linarith only [h21]
      exact hs_band₀_even_seed y₀ t₀ hy₀ hy₀_im
    · let f_neg : ℂ × ℂ → ℂ := fun p => s_band₀ (p.1, -p.2)
      have hf_neg_holo : DifferentiableOn ℂ f_neg Ω_mid :=
        hs_band₀_holo.comp (differentiable_fst.prodMk differentiable_snd.neg).differentiableOn
          (fun p hp => hΩ_neg p.1 p.2 hp)
      have hy₀_re_mem : ((y₀.re : ℂ), t₀) ∈ Ω_mid := by
        have h0 := hΩ_conv.2 y₀ t₀ hy₀ hy₀_nonneg 0 le_rfl hy₀_nonneg
        simpa only [Complex.ofReal_zero, zero_mul, add_zero] using h0
      have h_slice_open : IsOpen { y : ℂ | (y, t₀) ∈ Ω_mid } :=
        hΩ_open.preimage (continuous_id.prodMk continuous_const)
      obtain ⟨δ₁, hδ₁_pos, hδ₁_ball⟩ :=
        Metric.isOpen_iff.mp h_slice_open (y₀.re : ℂ) hy₀_re_mem
      let δ₀ : ℝ := min δ₁ δ_seed
      have hδ₀_pos : 0 < δ₀ := lt_min hδ₁_pos hδ_seed_pos
      have h_seed_ball : ∀ y : ℂ, ‖y - (y₀.re : ℂ)‖ < δ₀ → f_neg (y, t₀) = s_band₀ (y, t₀) := by
        intro y hy_ball
        have hy_mem : (y, t₀) ∈ Ω_mid :=
          hδ₁_ball (by
            rw [Metric.mem_ball, dist_eq_norm]
            exact lt_of_lt_of_le hy_ball (min_le_left _ _))
        have hy_im : |y.im| < δ_seed := by
          have him_eq : y.im = (y - (y₀.re : ℂ)).im := by
            simp only [Complex.sub_im, Complex.ofReal_im, sub_zero]
          rw [him_eq]
          exact lt_of_le_of_lt (Complex.abs_im_le_norm _)
            (lt_of_lt_of_le hy_ball (min_le_right _ _))
        exact hs_band₀_even_seed y t₀ hy_mem hy_im
      exact hVertUniq Ω_mid Ω_mid f_neg s_band₀ y₀ t₀ δ₀
        hΩ_conv hΩ_conv hf_neg_holo hs_band₀_holo ⟨hy₀, hy₀⟩ hy₀_nonneg hδ₀_pos h_seed_ball
  · intro p hp
    have h_steep_seed : ∀ q ∈ Ω_mid ∩ W_steep_init, |q.1.im| < δ_seed →
        s_band₀ q = s_steep q := by
      intro q hq hq_im
      obtain ⟨hq_bh, _⟩ := hU_mid_seed q hq.1 hq_im
      rw [hs_band₀_seed q hq.1 hq_im, (hs_steep_base q hq.2 hq_bh.1 hq_bh.2).symm]
    rcases lt_or_ge p.1.im 0 with hp_neg | hp_nonneg
    · refine h_steep_seed p hp ?_
      rw [abs_of_neg hp_neg]
      have h21 := hp.1.2.1
      linarith only [h21]
    · have hp_re_mem : ((p.1.re : ℂ), p.2) ∈ Ω_mid ∩ W_steep_init :=
        ⟨by
          have h0 := hΩ_conv.2 p.1 p.2 hp.1 hp_nonneg 0 le_rfl hp_nonneg
          simpa only [Complex.ofReal_zero, zero_mul, add_zero] using h0,
         by
          have h0 := hW_conv.2 p.1 p.2 hp.2 hp_nonneg 0 le_rfl hp_nonneg
          simpa only [Complex.ofReal_zero, zero_mul, add_zero] using h0⟩
      have h_slice_open : IsOpen { y : ℂ | (y, p.2) ∈ Ω_mid ∩ W_steep_init } :=
        (hΩ_open.inter hW_open).preimage (continuous_id.prodMk continuous_const)
      obtain ⟨δ₁, hδ₁_pos, hδ₁_ball⟩ :=
        Metric.isOpen_iff.mp h_slice_open (p.1.re : ℂ) hp_re_mem
      let δ₀ : ℝ := min δ₁ δ_seed
      have hδ₀_pos : 0 < δ₀ := lt_min hδ₁_pos hδ_seed_pos
      have h_seed_ball : ∀ y : ℂ, ‖y - (p.1.re : ℂ)‖ < δ₀ →
          s_band₀ (y, p.2) = s_steep (y, p.2) := by
        intro y hy_ball
        have hy_mem : (y, p.2) ∈ Ω_mid ∩ W_steep_init :=
          hδ₁_ball (by
            rw [Metric.mem_ball, dist_eq_norm]
            exact lt_of_lt_of_le hy_ball (min_le_left _ _))
        have hy_im : |y.im| < δ_seed := by
          have him_eq : y.im = (y - (p.1.re : ℂ)).im := by
            simp only [Complex.sub_im, Complex.ofReal_im, sub_zero]
          rw [him_eq]
          exact lt_of_le_of_lt (Complex.abs_im_le_norm _)
            (lt_of_lt_of_le hy_ball (min_le_right _ _))
        exact h_steep_seed (y, p.2) hy_mem hy_im
      exact hVertUniq Ω_mid W_steep_init s_band₀ s_steep p.1 p.2 δ₀
        hΩ_conv hW_conv hs_band₀_holo hs_steep_holo hp hp_nonneg hδ₀_pos h_seed_ball

theorem cone_parameter_recurrence_continuation : EntireConeParamRecurrenceProp :=
by
  intro X hD_strip P α γ_rec hα1 hα2 hγ1 hγ2 x₀ h_ref d δ_top m₀ R_par M_scale C_disp s_cone
    hd h4d hm₀ hR_par hM_scale hC_disp Ω_rec hShape hs_holo hs_disp hs_steep_rec
    y t₀ δ_y hδ_lo hδ_hi hy_re ht₀_ne ht₀_lt hR_le h_sf_cond h_disp_cond
  have hδ_pos : 0 < δ_y := by linarith

  
  have hΩ_open : IsOpen Ω_rec := by
    have hc_im : Continuous (fun p : ℂ × ℂ => p.1.im) :=
      Complex.continuous_im.comp continuous_fst
    have hc_depth : Continuous (fun p : ℂ × ℂ => h_ref - p.1.im) :=
      continuous_const.sub hc_im
    have hc_re : Continuous (fun p : ℂ × ℂ => |p.1.re - x₀|) :=
      continuous_abs.comp ((Complex.continuous_re.comp continuous_fst).sub continuous_const)
    have hc_cone : Continuous (fun p : ℂ × ℂ => m₀ * (h_ref - p.1.im)) :=
      continuous_const.mul hc_depth
    have hc_t : Continuous (fun p : ℂ × ℂ => ‖p.2‖) :=
      continuous_norm.comp continuous_snd
    exact (isOpen_lt continuous_const hc_depth).inter <|
      (isOpen_lt hc_depth continuous_const).inter <|
        (isOpen_lt hc_re hc_cone).inter (isOpen_lt hc_t continuous_const)

  have h_ball_in_Ω : ∀ z ∈ Metric.closedBall y (δ_y / 4),
      ∀ t' : ℂ, ‖t'‖ < R_par →
      (3 / 4 : ℝ) * δ_y ≤ h_ref - z.im ∧ (z, t') ∈ Ω_rec := by
    intro z hz t' ht'
    rw [Metric.mem_closedBall, dist_eq_norm] at hz
    have him_abs : |z.im - y.im| ≤ δ_y / 4 := by
      have h1 : |(z - y).im| ≤ ‖z - y‖ := Complex.abs_im_le_norm (z - y)
      simpa using le_trans h1 hz
    have hre_abs : |z.re - y.re| ≤ δ_y / 4 := by
      have h1 : |(z - y).re| ≤ ‖z - y‖ := Complex.abs_re_le_norm (z - y)
      simpa using le_trans h1 hz
    have him_bounds := abs_le.mp him_abs
    have h_depth_lo : (3 / 4 : ℝ) * δ_y ≤ h_ref - z.im := by
      dsimp [δ_y] at *; linarith
    have h_depth_hi : h_ref - z.im ≤ (5 / 4 : ℝ) * δ_y := by
      dsimp [δ_y] at *; linarith
    refine ⟨h_depth_lo, ?_, ?_, ?_, ht'⟩
    · linarith
    · linarith
    · have htri : |z.re - x₀| ≤ |z.re - y.re| + |y.re - x₀| := abs_sub_le z.re y.re x₀
      have hre_sum : |z.re - x₀| < m₀ * ((3 / 4 : ℝ) * δ_y) := by linarith
      exact lt_of_lt_of_le hre_sum (mul_le_mul_of_nonneg_left h_depth_lo (by linarith))

  let g : ℂ → ℂ → ℂ := fun t' z => s_cone (z, t') - z
  let B_disp : ℝ := 2 * C_disp * R_par ^ 2 * δ_y ^ (1 - 2 * α)
  have hB_disp_le : B_disp ≤ δ_y / 512 := by
    have hrpow_split : δ_y ^ (1 - 2 * α) = δ_y * δ_y ^ (-2 * α) := by
      have heq : (1 : ℝ) - 2 * α = 1 + (-2 * α) := by ring
      rw [heq, Real.rpow_add hδ_pos 1 (-2 * α), Real.rpow_one]
    have hB_eq : B_disp = (1 / 32 : ℝ) * (64 * C_disp * R_par ^ 2 * δ_y ^ (-2 * α)) * δ_y := by
      dsimp [B_disp]
      rw [hrpow_split]
      ring
    rw [hB_eq]
    have h1 : (1 / 32 : ℝ) * (64 * C_disp * R_par ^ 2 * δ_y ^ (-2 * α)) ≤
        (1 / 32 : ℝ) * (1 / 16) :=
      mul_le_mul_of_nonneg_left h_disp_cond (by norm_num)
    have h2 := mul_le_mul_of_nonneg_right h1 hδ_pos.le
    linarith

  have hg_bound : ∀ z ∈ Metric.closedBall y (δ_y / 4), ∀ t' : ℂ, ‖t'‖ < R_par →
      ‖g t' z‖ ≤ B_disp := by
    intro z hz t' ht'
    obtain ⟨h_depth_lo, h_mem⟩ := h_ball_in_Ω z hz t' ht'
    have hdisp := hs_disp z t' h_mem
    have h_half_le : (1 / 2 : ℝ) * δ_y ≤ h_ref - z.im := by linarith
    have hrpow1 : (h_ref - z.im) ^ (1 - 2 * α) ≤ ((1 / 2 : ℝ) * δ_y) ^ (1 - 2 * α) :=
      Real.rpow_le_rpow_of_nonpos (by positivity) h_half_le (by linarith)
    have hrpow2 : ((1 / 2 : ℝ) * δ_y) ^ (1 - 2 * α) =
        (1 / 2 : ℝ) ^ (1 - 2 * α) * δ_y ^ (1 - 2 * α) :=
      Real.mul_rpow (by norm_num) hδ_pos.le
    have h_two_pow : (1 / 2 : ℝ) ^ (1 - 2 * α) ≤ 2 := by
      have heq : (1 / 2 : ℝ) ^ (1 - 2 * α) = (2 : ℝ) ^ (2 * α - 1) := by
        calc (1 / 2 : ℝ) ^ (1 - 2 * α)
            = ((2 : ℝ)⁻¹) ^ (1 - 2 * α) := by norm_num
          _ = ((2 : ℝ) ^ (-1 : ℝ)) ^ (1 - 2 * α) := by rw [Real.rpow_neg_one]
          _ = (2 : ℝ) ^ ((-1 : ℝ) * (1 - 2 * α)) := (Real.rpow_mul (by norm_num) _ _).symm
          _ = (2 : ℝ) ^ (2 * α - 1) := by ring_nf
      rw [heq]
      calc (2 : ℝ) ^ (2 * α - 1) ≤ (2 : ℝ) ^ (1 : ℝ) :=
            Real.rpow_le_rpow_of_exponent_le (by norm_num) (by linarith)
        _ = 2 := Real.rpow_one 2
    have hrpow_le : (h_ref - z.im) ^ (1 - 2 * α) ≤ 2 * δ_y ^ (1 - 2 * α) := by
      rw [hrpow2] at hrpow1
      exact le_trans hrpow1 (mul_le_mul_of_nonneg_right h_two_pow (by positivity))
    have h_depth_pos : 0 < h_ref - z.im := by linarith
    have ht_sq : ‖t'‖ ^ 2 ≤ R_par ^ 2 :=
      pow_le_pow_left₀ (norm_nonneg t') ht'.le 2
    calc ‖g t' z‖
        ≤ C_disp * ‖t'‖ ^ 2 * (h_ref - z.im) ^ (1 - 2 * α) := hdisp
      _ ≤ C_disp * R_par ^ 2 * (2 * δ_y ^ (1 - 2 * α)) := by
          refine mul_le_mul (mul_le_mul_of_nonneg_left ht_sq hC_disp) hrpow_le
            (Real.rpow_nonneg h_depth_pos.le _) (by positivity)
      _ = B_disp := by dsimp [B_disp]; ring

  
  have hg_at : ∀ t' : ℂ, ‖t'‖ < R_par →
      ∀ z ∈ Metric.closedBall y (δ_y / 4), DifferentiableAt ℂ (g t') z := by
    intro t' ht' z hz
    have h_mem : (z, t') ∈ Ω_rec := (h_ball_in_Ω z hz t' ht').2
    have hs_at : DifferentiableAt ℂ s_cone (z, t') :=
      hs_holo.differentiableAt (hΩ_open.mem_nhds h_mem)
    have h_pair : DifferentiableAt ℂ (fun w : ℂ => (w, t')) z :=
      differentiableAt_id.prodMk (differentiableAt_const t')
    exact (hs_at.comp z h_pair).sub differentiableAt_id

  have hg_deriv_bound : ∀ t' : ℂ, ‖t'‖ < R_par →
      ∀ w ∈ Metric.ball y (δ_y / 8), ‖deriv (g t') w‖ ≤ 1 / 64 := by
    intro t' ht' w hw
    rw [Metric.mem_ball] at hw
    have h_sub_cb : Metric.closedBall w (δ_y / 8) ⊆ Metric.closedBall y (δ_y / 4) :=
      Metric.closedBall_subset_closedBall' (by linarith)
    have hg_on4 : DifferentiableOn ℂ (g t') (Metric.closedBall y (δ_y / 4)) :=
      fun z hz => (hg_at t' ht' z hz).differentiableWithinAt
    have hdc : DiffContOnCl ℂ (g t') (Metric.ball w (δ_y / 8)) :=
      hg_on4.diffContOnCl_ball h_sub_cb
    have h_sph : ∀ ζ ∈ Metric.sphere w (δ_y / 8), ‖g t' ζ‖ ≤ B_disp :=
      fun ζ hζ => hg_bound ζ (h_sub_cb (Metric.sphere_subset_closedBall hζ)) t' ht'
    have hcauchy :=
      Complex.norm_deriv_le_of_forall_mem_sphere_norm_le (by positivity : 0 < δ_y / 8) hdc h_sph
    calc ‖deriv (g t') w‖
        ≤ B_disp / (δ_y / 8) := hcauchy
      _ ≤ (δ_y / 512) / (δ_y / 8) := div_le_div_of_nonneg_right hB_disp_le (by positivity)
      _ = 1 / 64 := by field_simp [hδ_pos.ne']; ring

  let U_punc : Set ℂ := { t' : ℂ | ‖t'‖ < R_par ∧ t' ≠ 0 }
  let s_prev_fn : ℂ → ℂ := fun t' => s_cone (y - t', t')
  let s_curr_fn : ℂ → ℂ := fun t' => s_cone (y, t')
  let s_next_fn : ℂ → ℂ := fun t' => s_cone (y + t', t')
  let J_prev_fn : ℂ → ℂ := fun t' => (s_curr_fn t' - s_prev_fn t') / t'
  let J_curr_fn : ℂ → ℂ := fun t' => (s_next_fn t' - s_curr_fn t') / t'

  have h_shifts_in_ball8 : ∀ t' : ℂ, ‖t'‖ < R_par →
      y - t' ∈ Metric.ball y (δ_y / 8) ∧
      y ∈ Metric.ball y (δ_y / 8) ∧
      y + t' ∈ Metric.ball y (δ_y / 8) := by
    intro t' ht'
    have ht'_lt8 : ‖t'‖ < δ_y / 8 := by linarith
    refine ⟨?_, Metric.mem_ball_self (by positivity), ?_⟩
    · rw [Metric.mem_ball, dist_eq_norm]
      have : y - t' - y = -t' := by ring
      rw [this, norm_neg]
      exact ht'_lt8
    · rw [Metric.mem_ball, dist_eq_norm]
      have : y + t' - y = t' := by ring
      rw [this]
      exact ht'_lt8

  have h_ball8_sub_cb4 : Metric.ball y (δ_y / 8) ⊆ Metric.closedBall y (δ_y / 4) := by
    intro z hz
    rw [Metric.mem_ball] at hz
    rw [Metric.mem_closedBall]
    linarith

  have h_shifts_in_Ω : ∀ t' : ℂ, ‖t'‖ < R_par →
      (y - t', t') ∈ Ω_rec ∧ (y, t') ∈ Ω_rec ∧ (y + t', t') ∈ Ω_rec := by
    intro t' ht'
    obtain ⟨hm, hc, hp⟩ := h_shifts_in_ball8 t' ht'
    exact ⟨(h_ball_in_Ω _ (h_ball8_sub_cb4 hm) t' ht').2,
      (h_ball_in_Ω _ (h_ball8_sub_cb4 hc) t' ht').2,
      (h_ball_in_Ω _ (h_ball8_sub_cb4 hp) t' ht').2⟩

  have h_state_bounds : ∀ t' ∈ U_punc,
      ‖s_curr_fn t' - y‖ < (δ_y / 2) / 4 ∧
      ‖s_prev_fn t' - y‖ < (δ_y / 2) / 4 ∧
      ‖J_curr_fn t' - 1‖ < 1 / 4 ∧
      ‖J_prev_fn t' - 1‖ < 1 / 4 := by
    intro t' ⟨ht'_lt, ht'_ne⟩
    have ht'_pos : 0 < ‖t'‖ := norm_pos_iff.mpr ht'_ne
    obtain ⟨hm8, hc8, hp8⟩ := h_shifts_in_ball8 t' ht'_lt
    have hg_at8 : ∀ w ∈ Metric.ball y (δ_y / 8), DifferentiableAt ℂ (g t') w :=
      fun w hw => hg_at t' ht'_lt w (h_ball8_sub_cb4 hw)
    have hmvt_curr : ‖g t' (y + t') - g t' y‖ ≤ (1 / 64 : ℝ) * ‖(y + t') - y‖ :=
      (convex_ball y (δ_y / 8)).norm_image_sub_le_of_norm_deriv_le
        hg_at8 (hg_deriv_bound t' ht'_lt) hc8 hp8
    have hmvt_prev : ‖g t' y - g t' (y - t')‖ ≤ (1 / 64 : ℝ) * ‖y - (y - t')‖ :=
      (convex_ball y (δ_y / 8)).norm_image_sub_le_of_norm_deriv_le
        hg_at8 (hg_deriv_bound t' ht'_lt) hm8 hc8
    have hJ_curr_eq : J_curr_fn t' - 1 = (g t' (y + t') - g t' y) / t' := by
      dsimp [J_curr_fn, s_next_fn, s_curr_fn, g]
      field_simp [ht'_ne]
      ring
    have hJ_prev_eq : J_prev_fn t' - 1 = (g t' y - g t' (y - t')) / t' := by
      dsimp [J_prev_fn, s_curr_fn, s_prev_fn, g]
      field_simp [ht'_ne]
      ring
    refine ⟨?_, ?_, ?_, ?_⟩
    · have h1 : ‖g t' y‖ ≤ B_disp := hg_bound y (h_ball8_sub_cb4 hc8) t' ht'_lt
      change ‖g t' y‖ < (δ_y / 2) / 4
      linarith
    · have hs_prev_eq : s_prev_fn t' - y = g t' (y - t') - t' := by
        dsimp [s_prev_fn, g]; ring
      rw [hs_prev_eq]
      have h1 : ‖g t' (y - t') - t'‖ ≤ ‖g t' (y - t')‖ + ‖t'‖ := norm_sub_le _ _
      have h2 : ‖g t' (y - t')‖ ≤ B_disp := hg_bound (y - t') (h_ball8_sub_cb4 hm8) t' ht'_lt
      linarith
    · rw [hJ_curr_eq, norm_div]
      have hsub : (y + t') - y = t' := by ring
      rw [hsub] at hmvt_curr
      have hdiv : ‖g t' (y + t') - g t' y‖ / ‖t'‖ ≤ 1 / 64 :=
        (div_le_iff₀ ht'_pos).mpr hmvt_curr
      linarith
    · rw [hJ_prev_eq, norm_div]
      have hsub : y - (y - t') = t' := by ring
      rw [hsub] at hmvt_prev
      have hdiv : ‖g t' y - g t' (y - t')‖ / ‖t'‖ ≤ 1 / 64 :=
        (div_le_iff₀ ht'_pos).mpr hmvt_prev
      linarith

  
  let r_s : ℝ := δ_y / 2
  let r_t : ℝ := 2 * R_par
  let M₀ : ℝ := 2 * M_scale * δ_y ^ (-α)
  let U_act : Set (ℂ × ℂ × ℂ) :=
    { q : ℂ × ℂ × ℂ | ‖q.1 - y‖ < r_s / 4 ∧ ‖q.2.1 - 1‖ < 1 / 4 ∧ ‖q.2.2‖ < r_t }
  let F_act : ℂ × ℂ × ℂ → ℂ := fun q => P.p_act q.1 q.2.1 q.2.2

  have hF_act_holo : DifferentiableOn ℂ F_act U_act := by
    refine (P.small_field y r_s r_t M₀
      (by dsimp [r_s]; positivity)
      (by dsimp [r_t]; positivity)
      (by dsimp [r_s, r_t]; linarith)
      (by dsimp [M₀]; positivity)
      (by
        have heq : r_t * M₀ = 4 * R_par * M_scale * δ_y ^ (-α) := by
          dsimp [r_t, M₀]; ring
        rw [heq]; exact h_sf_cond)
      (by rw [hD_strip]; exact Set.subset_univ _)
      ?_).1
    intro w hw
    rw [Metric.mem_ball, dist_eq_norm] at hw
    have him_lt : |w.im - y.im| < δ_y / 2 := by
      have h1 : |(w - y).im| ≤ ‖w - y‖ := Complex.abs_im_le_norm (w - y)
      exact lt_of_le_of_lt (by simpa using h1) (by dsimp [r_s] at hw; exact hw)
    have him_bounds := abs_lt.mp him_lt
    have hw_lo : (1 / 2 : ℝ) * δ_y < h_ref - w.im := by dsimp [δ_y] at *; linarith
    have hw_hi : h_ref - w.im < (3 / 2 : ℝ) * δ_y := by dsimp [δ_y] at *; linarith
    have hw_d : d ≤ h_ref - w.im := by linarith
    have hw_top : h_ref - w.im ≤ (3 / 2 : ℝ) * δ_top := by linarith
    obtain ⟨hf_w, hq_w⟩ := hShape w hw_d hw_top
    have hrpow1 : (h_ref - w.im) ^ (-α) ≤ ((1 / 2 : ℝ) * δ_y) ^ (-α) :=
      Real.rpow_le_rpow_of_nonpos (by positivity) hw_lo.le (by linarith)
    have hrpow2 : ((1 / 2 : ℝ) * δ_y) ^ (-α) = (1 / 2 : ℝ) ^ (-α) * δ_y ^ (-α) :=
      Real.mul_rpow (by norm_num) hδ_pos.le
    have h_two_α : (1 / 2 : ℝ) ^ (-α) ≤ 2 := by
      have heq : (1 / 2 : ℝ) ^ (-α) = (2 : ℝ) ^ α := by
        calc (1 / 2 : ℝ) ^ (-α)
            = ((2 : ℝ)⁻¹) ^ (-α) := by norm_num
          _ = ((2 : ℝ) ^ (-1 : ℝ)) ^ (-α) := by rw [Real.rpow_neg_one]
          _ = (2 : ℝ) ^ ((-1 : ℝ) * (-α)) := (Real.rpow_mul (by norm_num) _ _).symm
          _ = (2 : ℝ) ^ α := by ring_nf
      rw [heq]
      calc (2 : ℝ) ^ α ≤ (2 : ℝ) ^ (1 : ℝ) :=
            Real.rpow_le_rpow_of_exponent_le (by norm_num) (by linarith)
        _ = 2 := Real.rpow_one 2
    have h_bound_M₀ : M_scale * (h_ref - w.im) ^ (-α) ≤ M₀ := by
      have hrpow_le : (h_ref - w.im) ^ (-α) ≤ 2 * δ_y ^ (-α) := by
        rw [hrpow2] at hrpow1
        exact le_trans hrpow1 (mul_le_mul_of_nonneg_right h_two_α (by positivity))
      calc M_scale * (h_ref - w.im) ^ (-α)
          ≤ M_scale * (2 * δ_y ^ (-α)) :=
            mul_le_mul_of_nonneg_left hrpow_le hM_scale.le
        _ = M₀ := by dsimp [M₀]; ring
    exact ⟨le_trans hf_w h_bound_M₀, le_trans hq_w h_bound_M₀⟩

  have hU_act_open : IsOpen U_act := by
    have hc1 : Continuous (fun q : ℂ × ℂ × ℂ => ‖q.1 - y‖) :=
      continuous_norm.comp (continuous_fst.sub continuous_const)
    have hc2 : Continuous (fun q : ℂ × ℂ × ℂ => ‖q.2.1 - 1‖) :=
      continuous_norm.comp ((continuous_fst.comp continuous_snd).sub continuous_const)
    have hc3 : Continuous (fun q : ℂ × ℂ × ℂ => ‖q.2.2‖) :=
      continuous_norm.comp (continuous_snd.comp continuous_snd)
    exact (isOpen_lt hc1 continuous_const).inter <|
      (isOpen_lt hc2 continuous_const).inter (isOpen_lt hc3 continuous_const)

  
  have h_param_deriv_at :
      ∀ (t₁ : ℂ) (ε : ℝ) (Φ : ℂ × ℂ → ℂ),
        0 < ε → DifferentiableOn ℂ Φ (Metric.ball (t₁, (0 : ℂ)) ε) →
        DifferentiableAt ℂ (fun t' => deriv (fun w => Φ (t', w)) 0) t₁ := by
    intro t₁ ε Φ hε hΦ
    let r : ℝ := ε / 4
    have hr : 0 < r := by dsimp [r]; positivity
    let K : Set (ℂ × ℂ) := Metric.closedBall (t₁, (0 : ℂ)) (3 * r)
    have hK_sub : K ⊆ Metric.ball (t₁, (0 : ℂ)) ε := by
      intro p hp
      rw [Metric.mem_ball]
      have hp' : dist p (t₁, (0 : ℂ)) ≤ 3 * r := Metric.mem_closedBall.mp hp
      dsimp [r] at hp'
      linarith
    obtain ⟨M, hM⟩ :=
      (isCompact_closedBall (t₁, (0 : ℂ)) (3 * r)).exists_bound_of_continuousOn
        (hΦ.continuousOn.mono hK_sub)
    let M₁ : ℝ := max M 0
    have hM₁_nonneg : 0 ≤ M₁ := le_max_right _ _
    have h_in_K : ∀ t' w : ℂ, dist t' t₁ ≤ 2 * r → ‖w‖ ≤ 2 * r → (t', w) ∈ K := by
      intro t' w ht' hw
      rw [Metric.mem_closedBall, Prod.dist_eq]
      exact max_le (by linarith) (by rw [dist_zero_right]; linarith)
    have hΦ_at_K : ∀ p ∈ K, DifferentiableAt ℂ Φ p :=
      fun p hp => hΦ.differentiableAt (Metric.isOpen_ball.mem_nhds (hK_sub hp))
    let w_fn : ℝ → ℂ := circleMap 0 r
    let κ_fn : ℝ → ℂ := fun θ => deriv (circleMap 0 r) θ * ((w_fn θ - 0) ^ 2)⁻¹
    have hw_norm : ∀ θ : ℝ, ‖w_fn θ‖ = r := by
      intro θ
      dsimp [w_fn]
      rw [norm_circleMap_zero, abs_of_pos hr]
    have hw_sq_ne : ∀ θ : ℝ, (w_fn θ - 0) ^ 2 ≠ 0 := by
      intro θ
      rw [sub_zero]
      exact pow_ne_zero 2 (norm_pos_iff.mp (by rw [hw_norm θ]; exact hr))
    have hderiv_cm_eq : deriv (circleMap 0 r) = fun θ => w_fn θ * Complex.I :=
      funext (deriv_circleMap 0 r)
    have hκ_cont : Continuous κ_fn := by
      dsimp [κ_fn]
      rw [hderiv_cm_eq]
      exact ((continuous_circleMap 0 r).mul continuous_const).mul
        ((((continuous_circleMap 0 r).sub continuous_const).pow 2).inv₀ hw_sq_ne)
    have hκ_norm : ∀ θ : ℝ, ‖κ_fn θ‖ = r⁻¹ := by
      intro θ
      dsimp [κ_fn]
      rw [deriv_circleMap, sub_zero, norm_mul, norm_mul, Complex.norm_I, mul_one,
        norm_inv, norm_pow, hw_norm θ]
      field_simp [hr.ne']
    let G_int : ℂ → ℝ → ℂ := fun t' θ => κ_fn θ * Φ (t', w_fn θ)
    let G_int' : ℂ → ℝ → ℂ :=
      fun t' θ => κ_fn θ * ((fderiv ℂ Φ (t', w_fn θ)) ((1 : ℂ), (0 : ℂ)))
    have hG_cont_θ : ∀ t' ∈ Metric.ball t₁ r, Continuous (G_int t') := by
      intro t' ht'
      have ht'_le : dist t' t₁ ≤ 2 * r := le_trans (Metric.mem_ball.mp ht').le (by linarith)
      refine hκ_cont.mul <| hΦ.continuousOn.comp_continuous
        (continuous_const.prodMk (continuous_circleMap 0 r)) fun θ =>
          hK_sub (h_in_K t' (w_fn θ) ht'_le (by rw [hw_norm θ]; linarith))
    have hG_meas : ∀ᶠ t' in nhds t₁,
        MeasureTheory.AEStronglyMeasurable (G_int t')
          (MeasureTheory.volume.restrict (Set.uIoc (0 : ℝ) (2 * Real.pi))) := by
      filter_upwards [Metric.ball_mem_nhds t₁ hr] with t' ht'
      exact (hG_cont_θ t' ht').aestronglyMeasurable
    have hG_int : IntervalIntegrable (G_int t₁) MeasureTheory.volume 0 (2 * Real.pi) :=
      (hG_cont_θ t₁ (Metric.mem_ball_self hr)).intervalIntegrable 0 (2 * Real.pi)
    have hG'_meas : MeasureTheory.AEStronglyMeasurable (G_int' t₁)
        (MeasureTheory.volume.restrict (Set.uIoc (0 : ℝ) (2 * Real.pi))) := by
      have hm_pt : Measurable (fun θ : ℝ => (t₁, w_fn θ)) :=
        (continuous_const.prodMk (continuous_circleMap 0 r)).measurable
      have hm_fd : Measurable (fun θ : ℝ => (fderiv ℂ Φ (t₁, w_fn θ)) ((1 : ℂ), (0 : ℂ))) :=
        (ContinuousLinearMap.apply ℂ ℂ ((1 : ℂ), (0 : ℂ))).continuous.measurable.comp
          ((measurable_fderiv ℂ Φ).comp hm_pt)
      exact (hκ_cont.measurable.mul hm_fd).aestronglyMeasurable
    have h_has_deriv : ∀ θ : ℝ, ∀ t' ∈ Metric.ball t₁ r,
        HasDerivAt (fun ζ => G_int ζ θ) (G_int' t' θ) t' := by
      intro θ t' ht'
      have ht'_le : dist t' t₁ ≤ 2 * r := le_trans (Metric.mem_ball.mp ht').le (by linarith)
      have hp_K : (t', w_fn θ) ∈ K := h_in_K t' (w_fn θ) ht'_le (by rw [hw_norm θ]; linarith)
      have hd_inner : HasDerivAt (fun ζ : ℂ => (ζ, w_fn θ)) ((1 : ℂ), (0 : ℂ)) t' :=
        (hasDerivAt_id t').prodMk (hasDerivAt_const t' (w_fn θ))
      exact ((hΦ_at_K _ hp_K).hasFDerivAt.comp_hasDerivAt t' hd_inner).const_mul (κ_fn θ)
    have h_bound : ∀ θ : ℝ, ∀ t' ∈ Metric.ball t₁ r, ‖G_int' t' θ‖ ≤ M₁ / r ^ 2 := by
      intro θ t' ht'
      have ht'_lt : dist t' t₁ < r := Metric.mem_ball.mp ht'
      have h_cb_in_K : ∀ ζ ∈ Metric.closedBall t' r, (ζ, w_fn θ) ∈ K := by
        intro ζ hζ
        have hζ_le : dist ζ t' ≤ r := Metric.mem_closedBall.mp hζ
        have h_dist : dist ζ t₁ ≤ 2 * r := by
          calc dist ζ t₁ ≤ dist ζ t' + dist t' t₁ := dist_triangle _ _ _
            _ ≤ r + r := add_le_add hζ_le ht'_lt.le
            _ = 2 * r := by ring
        exact h_in_K ζ (w_fn θ) h_dist (by rw [hw_norm θ]; linarith)
      have h_slice_on : DifferentiableOn ℂ (fun ζ => Φ (ζ, w_fn θ)) (Metric.closedBall t' r) := by
        intro ζ hζ
        exact ((hΦ_at_K _ (h_cb_in_K ζ hζ)).comp ζ
          (differentiableAt_id.prodMk (differentiableAt_const (w_fn θ)))).differentiableWithinAt
      have hdc : DiffContOnCl ℂ (fun ζ => Φ (ζ, w_fn θ)) (Metric.ball t' r) :=
        h_slice_on.diffContOnCl_ball Set.Subset.rfl
      have h_sph : ∀ ζ ∈ Metric.sphere t' r, ‖Φ (ζ, w_fn θ)‖ ≤ M₁ := fun ζ hζ =>
        le_trans (hM _ (h_cb_in_K ζ (Metric.sphere_subset_closedBall hζ))) (le_max_left _ _)
      have hcauchy := Complex.norm_deriv_le_of_forall_mem_sphere_norm_le hr hdc h_sph
      have hd_eq : ((fderiv ℂ Φ (t', w_fn θ)) ((1 : ℂ), (0 : ℂ))) =
          deriv (fun ζ => Φ (ζ, w_fn θ)) t' := by
        have ht'_le : dist t' t₁ ≤ 2 * r := le_trans ht'_lt.le (by linarith)
        have hp_K : (t', w_fn θ) ∈ K := h_in_K t' (w_fn θ) ht'_le (by rw [hw_norm θ]; linarith)
        exact (((hΦ_at_K _ hp_K).hasFDerivAt.comp_hasDerivAt t'
          ((hasDerivAt_id t').prodMk (hasDerivAt_const t' (w_fn θ))))).deriv.symm
      dsimp [G_int']
      rw [norm_mul, hκ_norm θ, hd_eq]
      calc r⁻¹ * ‖deriv (fun ζ => Φ (ζ, w_fn θ)) t'‖
          ≤ r⁻¹ * (M₁ / r) := mul_le_mul_of_nonneg_left hcauchy (by positivity)
        _ = M₁ / r ^ 2 := by field_simp [hr.ne']
    have h_int_deriv :=
      (intervalIntegral.hasDerivAt_integral_of_dominated_loc_of_deriv_le
        (Metric.ball_mem_nhds t₁ hr) hG_meas hG_int hG'_meas
        (Filter.Eventually.of_forall fun θ _ t' ht' => h_bound θ t' ht')
        intervalIntegrable_const
        (Filter.Eventually.of_forall fun θ _ t' ht' => h_has_deriv θ t' ht')).2
    have h_int_diff : DifferentiableAt ℂ
        (fun t' => (2 * (Real.pi : ℂ) * Complex.I)⁻¹ *
          ∫ θ in (0 : ℝ)..(2 * Real.pi), G_int t' θ) t₁ :=
      h_int_deriv.differentiableAt.const_mul _
    have h_rep : (fun t' => deriv (fun w => Φ (t', w)) 0) =ᶠ[nhds t₁]
        (fun t' => (2 * (Real.pi : ℂ) * Complex.I)⁻¹ *
          ∫ θ in (0 : ℝ)..(2 * Real.pi), G_int t' θ) := by
      filter_upwards [Metric.ball_mem_nhds t₁ hr] with t' ht'
      have ht'_le : dist t' t₁ ≤ 2 * r := le_trans (Metric.mem_ball.mp ht').le (by linarith)
      have hw_on : DifferentiableOn ℂ (fun w => Φ (t', w)) (Metric.ball (0 : ℂ) (2 * r)) := by
        intro w hw
        have hw_le : ‖w‖ ≤ 2 * r := ( by simpa using Metric.mem_ball.mp hw : ‖w‖ < 2 * r ).le
        exact ((hΦ_at_K _ (h_in_K t' w ht'_le hw_le)).comp w
          ((differentiableAt_const t').prodMk differentiableAt_id)).differentiableWithinAt
      have hcb_sub : Metric.closedBall (0 : ℂ) r ⊆ Metric.ball (0 : ℂ) (2 * r) := by
        intro w hw
        rw [Metric.mem_ball]
        have : dist w 0 ≤ r := Metric.mem_closedBall.mp hw
        linarith
      rw [← Complex.cderiv_eq_deriv Metric.isOpen_ball hw_on hr hcb_sub]
      simp only [Complex.cderiv, circleIntegral, smul_eq_mul, G_int, κ_fn, w_fn, mul_assoc]
    exact h_int_diff.congr_of_eventuallyEq h_rep

  have hU_punc_open : IsOpen U_punc :=
    (isOpen_lt continuous_norm continuous_const).inter (isOpen_ne.preimage continuous_id)

  have hs_prev_holo : DifferentiableOn ℂ s_prev_fn U_punc :=
    hs_holo.comp ((differentiableOn_const y).sub differentiableOn_id |>.prodMk differentiableOn_id)
      (fun t' ht' => (h_shifts_in_Ω t' ht'.1).1)
  have hs_curr_holo : DifferentiableOn ℂ s_curr_fn U_punc :=
    hs_holo.comp ((differentiableOn_const y).prodMk differentiableOn_id)
      (fun t' ht' => (h_shifts_in_Ω t' ht'.1).2.1)
  have hs_next_holo : DifferentiableOn ℂ s_next_fn U_punc :=
    hs_holo.comp ((differentiableOn_const y).add differentiableOn_id |>.prodMk differentiableOn_id)
      (fun t' ht' => (h_shifts_in_Ω t' ht'.1).2.2)

  have hJ_prev_holo : DifferentiableOn ℂ J_prev_fn U_punc :=
    (hs_curr_holo.sub hs_prev_holo).div differentiableOn_id (fun _ ht' => ht'.2)
  have hJ_curr_holo : DifferentiableOn ℂ J_curr_fn U_punc :=
    (hs_next_holo.sub hs_curr_holo).div differentiableOn_id (fun _ ht' => ht'.2)

  have hdJ_curve_holo : ∀ (a b : ℂ → ℂ),
      DifferentiableOn ℂ a U_punc → DifferentiableOn ℂ b U_punc →
      (∀ t' ∈ U_punc, (a t', (b t', t')) ∈ U_act) →
      DifferentiableOn ℂ (fun t' => deriv (fun J' => P.p_act (a t') J' t') (b t')) U_punc := by
    intro a b ha hb hmaps t₁ ht₁
    let Ψ : ℂ × ℂ → ℂ × ℂ × ℂ := fun p => (a p.1, (p.2 + b p.1, p.1))
    let W : Set (ℂ × ℂ) := { p : ℂ × ℂ | p.1 ∈ U_punc ∧ Ψ p ∈ U_act }
    have hΨ_holo_all : DifferentiableOn ℂ Ψ (U_punc ×ˢ Set.univ) :=
      (ha.comp differentiableOn_fst (fun p hp => hp.1)).prodMk <|
        (differentiableOn_snd.add (hb.comp differentiableOn_fst (fun p hp => hp.1))).prodMk
          differentiableOn_fst
    have hW_nhds : W ∈ nhds (t₁, (0 : ℂ)) := by
      have h1 : U_punc ×ˢ (Set.univ : Set ℂ) ∈ nhds (t₁, (0 : ℂ)) :=
        (hU_punc_open.prod isOpen_univ).mem_nhds ⟨ht₁, trivial⟩
      have hΨ_cont : ContinuousAt Ψ (t₁, (0 : ℂ)) :=
        (hΨ_holo_all.differentiableAt h1).continuousAt
      have hΨ_mem : Ψ (t₁, (0 : ℂ)) ∈ U_act := by
        simpa [Ψ] using hmaps t₁ ht₁
      exact Filter.inter_mem
        (continuous_fst.continuousAt.preimage_mem_nhds (hU_punc_open.mem_nhds ht₁))
        (hΨ_cont.preimage_mem_nhds (hU_act_open.mem_nhds hΨ_mem))
    obtain ⟨ε, hε, hball_W⟩ := Metric.mem_nhds_iff.mp hW_nhds
    have hΦ_holo : DifferentiableOn ℂ (F_act ∘ Ψ) (Metric.ball (t₁, (0 : ℂ)) ε) :=
      hF_act_holo.comp
        (hΨ_holo_all.mono fun p hp => ⟨(hball_W hp).1, trivial⟩)
        (fun p hp => (hball_W hp).2)
    have h_at := h_param_deriv_at t₁ ε (F_act ∘ Ψ) hε hΦ_holo
    have h_eq : (fun t' => deriv (fun J' => P.p_act (a t') J' t') (b t')) =
        (fun t' => deriv (fun w => (F_act ∘ Ψ) (t', w)) 0) := by
      ext t'
      have hshift := deriv_comp_add_const (fun J' => P.p_act (a t') J' t') (b t') (0 : ℂ)
      simpa [F_act, Ψ] using hshift.symm
    rw [h_eq]
    exact h_at.differentiableWithinAt

  have hdS_curve_holo : ∀ (a b : ℂ → ℂ),
      DifferentiableOn ℂ a U_punc → DifferentiableOn ℂ b U_punc →
      (∀ t' ∈ U_punc, (a t', (b t', t')) ∈ U_act) →
      DifferentiableOn ℂ (fun t' => deriv (fun s' => P.p_act s' (b t') t') (a t')) U_punc := by
    intro a b ha hb hmaps t₁ ht₁
    let Ψ : ℂ × ℂ → ℂ × ℂ × ℂ := fun p => (p.2 + a p.1, (b p.1, p.1))
    let W : Set (ℂ × ℂ) := { p : ℂ × ℂ | p.1 ∈ U_punc ∧ Ψ p ∈ U_act }
    have hΨ_holo_all : DifferentiableOn ℂ Ψ (U_punc ×ˢ Set.univ) :=
      (differentiableOn_snd.add (ha.comp differentiableOn_fst (fun p hp => hp.1))).prodMk <|
        (hb.comp differentiableOn_fst (fun p hp => hp.1)).prodMk differentiableOn_fst
    have hW_nhds : W ∈ nhds (t₁, (0 : ℂ)) := by
      have h1 : U_punc ×ˢ (Set.univ : Set ℂ) ∈ nhds (t₁, (0 : ℂ)) :=
        (hU_punc_open.prod isOpen_univ).mem_nhds ⟨ht₁, trivial⟩
      have hΨ_cont : ContinuousAt Ψ (t₁, (0 : ℂ)) :=
        (hΨ_holo_all.differentiableAt h1).continuousAt
      have hΨ_mem : Ψ (t₁, (0 : ℂ)) ∈ U_act := by
        simpa [Ψ] using hmaps t₁ ht₁
      exact Filter.inter_mem
        (continuous_fst.continuousAt.preimage_mem_nhds (hU_punc_open.mem_nhds ht₁))
        (hΨ_cont.preimage_mem_nhds (hU_act_open.mem_nhds hΨ_mem))
    obtain ⟨ε, hε, hball_W⟩ := Metric.mem_nhds_iff.mp hW_nhds
    have hΦ_holo : DifferentiableOn ℂ (F_act ∘ Ψ) (Metric.ball (t₁, (0 : ℂ)) ε) :=
      hF_act_holo.comp
        (hΨ_holo_all.mono fun p hp => ⟨(hball_W hp).1, trivial⟩)
        (fun p hp => (hball_W hp).2)
    have h_at := h_param_deriv_at t₁ ε (F_act ∘ Ψ) hε hΦ_holo
    have h_eq : (fun t' => deriv (fun s' => P.p_act s' (b t') t') (a t')) =
        (fun t' => deriv (fun w => (F_act ∘ Ψ) (t', w)) 0) := by
      ext t'
      have hshift := deriv_comp_add_const (fun s' => P.p_act s' (b t') t') (a t') (0 : ℂ)
      simpa [F_act, Ψ] using hshift.symm
    rw [h_eq]
    exact h_at.differentiableWithinAt

  have hγ_curr_maps : ∀ t' ∈ U_punc, (s_curr_fn t', (J_curr_fn t', t')) ∈ U_act := by
    intro t' ht'
    obtain ⟨hsc, _, hJc, _⟩ := h_state_bounds t' ht'
    exact ⟨hsc, hJc, by dsimp [r_t]; linarith [ht'.1]⟩
  have hγ_prev_maps : ∀ t' ∈ U_punc, (s_prev_fn t', (J_prev_fn t', t')) ∈ U_act := by
    intro t' ht'
    obtain ⟨_, hsp, _, hJp⟩ := h_state_bounds t' ht'
    exact ⟨hsp, hJp, by dsimp [r_t]; linarith [ht'.1]⟩

  let F_res : ℂ → ℂ := fun t' =>
    deriv (fun J' => P.p_act (s_curr_fn t') J' t') (J_curr_fn t') -
      t' * deriv (fun s' => P.p_act s' (J_curr_fn t') t') (s_curr_fn t') -
      deriv (fun J' => P.p_act (s_prev_fn t') J' t') (J_prev_fn t')

  have hF_res_holo : DifferentiableOn ℂ F_res U_punc :=
    ((hdJ_curve_holo s_curr_fn J_curr_fn hs_curr_holo hJ_curr_holo hγ_curr_maps).sub
      (differentiableOn_id.mul
        (hdS_curve_holo s_curr_fn J_curr_fn hs_curr_holo hJ_curr_holo hγ_curr_maps))).sub
      (hdJ_curve_holo s_prev_fn J_prev_fn hs_prev_holo hJ_prev_holo hγ_prev_maps)

  have hF_res_ana : AnalyticOnNhd ℂ F_res U_punc :=
    hF_res_holo.analyticOnNhd hU_punc_open

  
  have h_prop : ∀ (H V : Set ℂ) (w₀ : ℂ),
      H ⊆ U_punc → Convex ℝ H → IsOpen V → V ⊆ H → w₀ ∈ V →
      (∀ t' ∈ V, F_res t' = 0) → ∀ t' ∈ H, F_res t' = 0 := by
    intro H V w₀ hH_sub hH_conv hV_open hV_sub hw₀ hV_zero t' ht'
    have h_ev : F_res =ᶠ[nhds w₀] 0 :=
      Filter.eventuallyEq_of_mem (hV_open.mem_nhds hw₀) hV_zero
    have h_eqOn :=
      (hF_res_ana.mono hH_sub).eqOn_zero_of_preconnected_of_eventuallyEq_zero
        hH_conv.isPreconnected (hV_sub hw₀) h_ev
    simpa using h_eqOn ht'

  let H_up : Set ℂ := Metric.ball (0 : ℂ) R_par ∩ { t' : ℂ | 0 < t'.im }
  let H_right : Set ℂ := Metric.ball (0 : ℂ) R_par ∩ { t' : ℂ | 0 < t'.re }
  let H_left : Set ℂ := Metric.ball (0 : ℂ) R_par ∩ { t' : ℂ | t'.re < 0 }
  let H_down : Set ℂ := Metric.ball (0 : ℂ) R_par ∩ { t' : ℂ | t'.im < 0 }

  have hH_up_open : IsOpen H_up :=
    Metric.isOpen_ball.inter (isOpen_lt continuous_const Complex.continuous_im)
  have hH_right_open : IsOpen H_right :=
    Metric.isOpen_ball.inter (isOpen_lt continuous_const Complex.continuous_re)
  have hH_left_open : IsOpen H_left :=
    Metric.isOpen_ball.inter (isOpen_lt Complex.continuous_re continuous_const)
  have hH_down_open : IsOpen H_down :=
    Metric.isOpen_ball.inter (isOpen_lt Complex.continuous_im continuous_const)

  have hH_up_sub : H_up ⊆ U_punc := by
    intro t' ⟨hb, him⟩
    refine ⟨by simpa using hb, ?_⟩
    intro h0; subst h0; simp at him
  have hH_right_sub : H_right ⊆ U_punc := by
    intro t' ⟨hb, hre⟩
    refine ⟨by simpa using hb, ?_⟩
    intro h0; subst h0; simp at hre
  have hH_left_sub : H_left ⊆ U_punc := by
    intro t' ⟨hb, hre⟩
    refine ⟨by simpa using hb, ?_⟩
    intro h0; subst h0; simp at hre
  have hH_down_sub : H_down ⊆ U_punc := by
    intro t' ⟨hb, him⟩
    refine ⟨by simpa using hb, ?_⟩
    intro h0; subst h0; simp at him

  have hH_up_conv : Convex ℝ H_up :=
    (convex_ball (0 : ℂ) R_par).inter
      ((convex_Ioi (0 : ℝ)).linear_preimage Complex.imCLM.toLinearMap)
  have hH_right_conv : Convex ℝ H_right :=
    (convex_ball (0 : ℂ) R_par).inter
      ((convex_Ioi (0 : ℝ)).linear_preimage Complex.reCLM.toLinearMap)
  have hH_left_conv : Convex ℝ H_left :=
    (convex_ball (0 : ℂ) R_par).inter
      ((convex_Iio (0 : ℝ)).linear_preimage Complex.reCLM.toLinearMap)
  have hH_down_conv : Convex ℝ H_down :=
    (convex_ball (0 : ℂ) R_par).inter
      ((convex_Iio (0 : ℝ)).linear_preimage Complex.imCLM.toLinearMap)

  
  let V_steep : Set ℂ := { t' : ℂ | ‖t'‖ < R_par ∧ γ_rec * ‖t'‖ < t'.im }
  have hV_steep_open : IsOpen V_steep :=
    (isOpen_lt continuous_norm continuous_const).inter
      (isOpen_lt (continuous_const.mul continuous_norm) Complex.continuous_im)
  have hV_steep_sub : V_steep ⊆ H_up := by
    intro t' ⟨ht'_lt, ht'_im⟩
    exact ⟨by simpa using ht'_lt, lt_of_le_of_lt (by positivity) ht'_im⟩
  let w_up : ℂ := ((R_par / 2 : ℝ) : ℂ) * Complex.I
  have hw_up_mem : w_up ∈ V_steep := by
    have hw_norm : ‖w_up‖ = R_par / 2 := by
      dsimp [w_up]
      rw [norm_mul, Complex.norm_I, mul_one, Complex.norm_real, Real.norm_of_nonneg (by positivity)]
    have hw_im : w_up.im = R_par / 2 := by simp [w_up]
    refine ⟨by linarith, ?_⟩
    rw [hw_norm, hw_im]
    nlinarith
  have hV_steep_zero : ∀ t' ∈ V_steep, F_res t' = 0 := by
    intro t' ⟨ht'_lt, ht'_steep⟩
    obtain ⟨hmΩ, hcΩ, hpΩ⟩ := h_shifts_in_Ω t' ht'_lt
    have hrec := hs_steep_rec y t' ht'_steep hmΩ hcΩ hpΩ
    dsimp [F_res, s_curr_fn, s_prev_fn, s_next_fn, J_curr_fn, J_prev_fn]
    exact sub_eq_zero.mpr hrec
  have hZero_up : ∀ t' ∈ H_up, F_res t' = 0 :=
    h_prop H_up V_steep w_up hH_up_sub hH_up_conv hV_steep_open hV_steep_sub hw_up_mem hV_steep_zero

  
  let w_ur : ℂ := ((R_par / 4 : ℝ) : ℂ) + ((R_par / 4 : ℝ) : ℂ) * Complex.I
  have hw_ur_mem : w_ur ∈ H_up ∩ H_right := by
    have hw_norm : ‖w_ur‖ < R_par := by
      have h1 : ‖w_ur‖ ≤ ‖((R_par / 4 : ℝ) : ℂ)‖ + ‖((R_par / 4 : ℝ) : ℂ) * Complex.I‖ :=
        norm_add_le _ _
      have h2 : ‖((R_par / 4 : ℝ) : ℂ)‖ = R_par / 4 := by
        rw [Complex.norm_real, Real.norm_of_nonneg (by positivity)]
      have h3 : ‖((R_par / 4 : ℝ) : ℂ) * Complex.I‖ = R_par / 4 := by
        rw [norm_mul, Complex.norm_I, mul_one, h2]
      linarith
    have hw_ball : w_ur ∈ Metric.ball (0 : ℂ) R_par := by simpa using hw_norm
    exact ⟨⟨hw_ball, by simp [w_ur]; positivity⟩, ⟨hw_ball, by simp [w_ur]; positivity⟩⟩
  have hZero_right : ∀ t' ∈ H_right, F_res t' = 0 :=
    h_prop H_right (H_up ∩ H_right) w_ur hH_right_sub hH_right_conv
      (hH_up_open.inter hH_right_open) Set.inter_subset_right hw_ur_mem
      (fun t' ht' => hZero_up t' ht'.1)

  
  let w_ul : ℂ := -((R_par / 4 : ℝ) : ℂ) + ((R_par / 4 : ℝ) : ℂ) * Complex.I
  have hw_ul_mem : w_ul ∈ H_up ∩ H_left := by
    have hw_norm : ‖w_ul‖ < R_par := by
      have h1 : ‖w_ul‖ ≤ ‖-((R_par / 4 : ℝ) : ℂ)‖ + ‖((R_par / 4 : ℝ) : ℂ) * Complex.I‖ :=
        norm_add_le _ _
      have h2 : ‖-((R_par / 4 : ℝ) : ℂ)‖ = R_par / 4 := by
        rw [norm_neg, Complex.norm_real, Real.norm_of_nonneg (by positivity)]
      have h3 : ‖((R_par / 4 : ℝ) : ℂ) * Complex.I‖ = R_par / 4 := by
        rw [norm_mul, Complex.norm_I, mul_one, Complex.norm_real, Real.norm_of_nonneg (by positivity)]
      linarith
    have hw_ball : w_ul ∈ Metric.ball (0 : ℂ) R_par := by simpa using hw_norm
    exact ⟨⟨hw_ball, by simp [w_ul]; positivity⟩, ⟨hw_ball, by simp [w_ul]; linarith⟩⟩
  have hZero_left : ∀ t' ∈ H_left, F_res t' = 0 :=
    h_prop H_left (H_up ∩ H_left) w_ul hH_left_sub hH_left_conv
      (hH_up_open.inter hH_left_open) Set.inter_subset_right hw_ul_mem
      (fun t' ht' => hZero_up t' ht'.1)

  
  let w_dr : ℂ := ((R_par / 4 : ℝ) : ℂ) - ((R_par / 4 : ℝ) : ℂ) * Complex.I
  have hw_dr_mem : w_dr ∈ H_right ∩ H_down := by
    have hw_norm : ‖w_dr‖ < R_par := by
      have h1 : ‖w_dr‖ ≤ ‖((R_par / 4 : ℝ) : ℂ)‖ + ‖((R_par / 4 : ℝ) : ℂ) * Complex.I‖ :=
        norm_sub_le _ _
      have h2 : ‖((R_par / 4 : ℝ) : ℂ)‖ = R_par / 4 := by
        rw [Complex.norm_real, Real.norm_of_nonneg (by positivity)]
      have h3 : ‖((R_par / 4 : ℝ) : ℂ) * Complex.I‖ = R_par / 4 := by
        rw [norm_mul, Complex.norm_I, mul_one, h2]
      linarith
    have hw_ball : w_dr ∈ Metric.ball (0 : ℂ) R_par := by simpa using hw_norm
    exact ⟨⟨hw_ball, by simp [w_dr]; positivity⟩, ⟨hw_ball, by simp [w_dr]; linarith⟩⟩
  have hZero_down : ∀ t' ∈ H_down, F_res t' = 0 :=
    h_prop H_down (H_right ∩ H_down) w_dr hH_down_sub hH_down_conv
      (hH_right_open.inter hH_down_open) Set.inter_subset_right hw_dr_mem
      (fun t' ht' => hZero_right t' ht'.1)

  
  have ht₀_ball : t₀ ∈ Metric.ball (0 : ℂ) R_par := by
    rw [Metric.mem_ball, dist_zero_right]
    linarith
  have hF_t₀ : F_res t₀ = 0 := by
    rcases lt_trichotomy t₀.im 0 with him_neg | him_zero | him_pos
    · exact hZero_down t₀ ⟨ht₀_ball, him_neg⟩
    · have hre_ne : t₀.re ≠ 0 := by
        intro hre_zero
        apply ht₀_ne
        exact Complex.ext hre_zero him_zero
      rcases lt_or_gt_of_ne hre_ne with hre_neg | hre_pos
      · exact hZero_left t₀ ⟨ht₀_ball, hre_neg⟩
      · exact hZero_right t₀ ⟨ht₀_ball, hre_pos⟩
    · exact hZero_up t₀ ⟨ht₀_ball, him_pos⟩
  exact sub_eq_zero.mp hF_t₀

theorem entire_strip_deep_passage_anchor (hSteep : RefSteepContinuationProp)
    (hBump : SchwarzPoissonBumpProp)
    (hDyad : RefDyadicConeFillingProp)
    (E : EntireNonisotropicStrip)
    (P : ChordActionPackage E.toExpStripData)
    (kind : ExpProfileKind)
    (seq : ExpSequenceData E.toExpStripData kind)
    (α₀ C_ℓ C_cone : ℝ)
    (hα₁ : 1 / 2 < α₀) (hα₂ : α₀ < 1)
    (hCℓ : 0 < C_ℓ) (hCcone : 0 < C_cone)
    (h_bounds : ∀ n : ℕ, 0 < seq.h_seq n ∧ seq.ℓ_seq n ≤ C_ℓ)
    (hh_tendsto : Filter.Tendsto seq.h_seq Filter.atTop Filter.atTop)
    (hlog_tendsto : Filter.Tendsto
      (fun n => Real.log (1 + seq.h_seq n / seq.ℓ_seq n) / Real.log (seq.m_seq n))
      Filter.atTop (nhds 0))
    (hCone : ∃ N₀ : ℕ, ∀ n ≥ N₀, ∀ s : ℂ,
      seq.ℓ_seq n ≤ seq.h_seq n - s.im → seq.h_seq n - s.im ≤ seq.h_seq n →
      max ‖E.f s‖ (Real.sqrt ‖E.q s‖) ≤
        C_cone * seq.m_seq n * (seq.ℓ_seq n / (seq.h_seq n - s.im)) ^ α₀) :
    DeepPassageAnchorData E.toExpStripData P kind seq :=
by
  let s_base_full : ℝ := (3 / 4) * E.s_star
  let ρ_base : ℝ := min (E.r_star / 2) (P.r_rec / 2)
  have hs_star_pos : 0 < E.s_star := E.s_star_pos
  have hr_star_pos : 0 < E.r_star := E.r_star_pos
  have hr_rec_pos : 0 < P.r_rec := P.r_rec_pos
  have hρ_base_pos : 0 < ρ_base := lt_min (by positivity) (by positivity)
  have hρ_le_rstar : ρ_base ≤ E.r_star / 2 := min_le_left _ _
  have hρ_le_rrec : ρ_base ≤ P.r_rec / 2 := min_le_right _ _
  obtain ⟨C_init, U_base, N_shape, hC_init_ge_one, hU_holo, hU_props, hlim1, hlim2, hShape⟩ :=
    entire_collar_quotient_and_reflected_bounds E P kind seq α₀ C_ℓ C_cone
      hα₁ hα₂ hCℓ hCcone h_bounds hh_tendsto hlog_tendsto hCone
  have hC_init_pos : 0 < C_init := lt_of_lt_of_le zero_lt_one hC_init_ge_one
  obtain ⟨D_dip, C_bump, M_ceil, γ_dyad, hD_dip, hC_bump, hM_ceil,
      hγ_dyad_pos, hγ_dyad_lt, hDyad_apply⟩ := hDyad α₀ hα₁ hα₂
  let K₀ : ℝ := 4 * M_ceil
  have hK₀_gt_32 : 32 < K₀ := by dsimp [K₀]; linarith
  have hK₀_pos : 0 < K₀ := by linarith
  obtain ⟨C_bump_init, γ_init, hCb_init, hγ_init_pos, hγ_init_lt, hInit_apply⟩ :=
    affine_schwarz_poisson_band_initializer hBump α₀ K₀ γ_dyad
      hα₁ hα₂ (by linarith) hγ_dyad_pos hγ_dyad_lt
  have hD_strip_eq : E.toExpStripData.D_strip = Set.univ := rfl
  have hD_strip_open : IsOpen E.toExpStripData.D_strip := isOpen_univ
  have hD_strip_conv : Convex ℝ E.toExpStripData.D_strip := convex_univ
  obtain ⟨C_st, η_st, hC_st_ge_one, hη_st_pos, _, hSteep_apply⟩ :=
    hSteep E.toExpStripData hD_strip_open P α₀ γ_init
      hα₁ hα₂ hγ_init_pos (by linarith)
  have hC_st_pos : 0 < C_st := lt_of_lt_of_le zero_lt_one hC_st_ge_one
  have hRec_apply :=
    cone_parameter_recurrence_continuation E.toExpStripData hD_strip_eq P α₀ γ_dyad
      hα₁ hα₂ hγ_dyad_pos (by linarith)

  intro T_max hT_max
  let A₀ : ℝ := max 1 ((3 / 2 : ℝ) ^ (2 * α₀ - 1) * C_st)
  have hA₀_ge_one : 1 ≤ A₀ := le_max_left _ _
  have hA₀_pos : 0 < A₀ := lt_of_lt_of_le zero_lt_one hA₀_ge_one
  let A_ind : ℝ := max A₀ ((2 : ℝ) ^ (2 * α₀ - 1) * C_st)
  have hA_ind_ge_one : 1 ≤ A_ind := le_trans hA₀_ge_one (le_max_left _ _)
  have hA_ind_pos : 0 < A_ind := lt_of_lt_of_le zero_lt_one hA_ind_ge_one
  let C_anc : ℝ := 9 * A_ind * C_cone ^ 2
  have hC_anc_pos : 0 < C_anc := by positivity

  let B₁ : ℝ := max 1 (12 * T_max * C_cone / η_st)
  let B₂ : ℝ := max 1 (24 * T_max * C_cone / P.η_sf)
  let B₃ : ℝ := max 1 (4096 * C_anc * T_max ^ 2)
  let D_anc : ℝ := max 40 (max (2 * B₁ ^ 2) (max (B₂ ^ 2) B₃))
  have hD_anc_ge_40 : 40 ≤ D_anc := le_max_left _ _
  have hD_anc_pos : 0 < D_anc := by linarith
  have hB₁_ge_one : 1 ≤ B₁ := le_max_left _ _
  have hB₂_ge_one : 1 ≤ B₂ := le_max_left _ _
  have hB₃_ge_one : 1 ≤ B₃ := le_max_left _ _
  have hη_sf_pos : 0 < P.η_sf := P.η_sf_pos

  have hD_anc_B₁ : 12 * T_max * C_cone * (D_anc / 2) ^ (-α₀) ≤ η_st := by
    have h2B₁ : 2 * B₁ ^ 2 ≤ D_anc :=
      le_trans (le_max_left _ _) (le_max_right _ _)
    have hB₁_sq : B₁ ^ 2 ≤ D_anc / 2 := by linarith
    have h1_le : 1 ≤ D_anc / 2 := by linarith
    have he1 : (D_anc / 2) ^ (-α₀) ≤ (D_anc / 2) ^ (-1 / 2 : ℝ) :=
      Real.rpow_le_rpow_of_exponent_le h1_le (by linarith)
    have he2 : (D_anc / 2) ^ (-1 / 2 : ℝ) ≤ (B₁ ^ (2 : ℕ)) ^ (-1 / 2 : ℝ) :=
      Real.rpow_le_rpow_of_nonpos (by positivity) hB₁_sq (by norm_num)
    have he3 : ((B₁ : ℝ) ^ (2 : ℕ)) ^ (-1 / 2 : ℝ) = B₁⁻¹ := by
      rw [← Real.rpow_natCast B₁ 2, ← Real.rpow_mul (by positivity)]
      norm_num
      exact Real.rpow_neg_one B₁
    have hle_inv : (D_anc / 2) ^ (-α₀) ≤ B₁⁻¹ := by linarith
    have hdiv_le : 12 * T_max * C_cone / η_st ≤ B₁ := le_max_right _ _
    have hmul_B₁ : 12 * T_max * C_cone ≤ B₁ * η_st := (div_le_iff₀ hη_st_pos).mp hdiv_le
    calc 12 * T_max * C_cone * (D_anc / 2) ^ (-α₀)
        ≤ 12 * T_max * C_cone * B₁⁻¹ :=
          mul_le_mul_of_nonneg_left hle_inv (by positivity)
      _ ≤ (B₁ * η_st) * B₁⁻¹ :=
          mul_le_mul_of_nonneg_right hmul_B₁ (by positivity)
      _ = η_st := by field_simp [(lt_of_lt_of_le zero_lt_one hB₁_ge_one).ne']

  have hD_anc_B₂ : 24 * T_max * C_cone * D_anc ^ (-α₀) ≤ P.η_sf := by
    have hB₂_sq : B₂ ^ 2 ≤ D_anc :=
      le_trans (le_max_left _ _) (le_trans (le_max_right _ _) (le_max_right _ _))
    have h1_le : 1 ≤ D_anc := by linarith
    have he1 : D_anc ^ (-α₀) ≤ D_anc ^ (-1 / 2 : ℝ) :=
      Real.rpow_le_rpow_of_exponent_le h1_le (by linarith)
    have he2 : D_anc ^ (-1 / 2 : ℝ) ≤ (B₂ ^ (2 : ℕ)) ^ (-1 / 2 : ℝ) :=
      Real.rpow_le_rpow_of_nonpos (by positivity) hB₂_sq (by norm_num)
    have he3 : ((B₂ : ℝ) ^ (2 : ℕ)) ^ (-1 / 2 : ℝ) = B₂⁻¹ := by
      rw [← Real.rpow_natCast B₂ 2, ← Real.rpow_mul (by positivity)]
      norm_num
      exact Real.rpow_neg_one B₂
    have hle_inv : D_anc ^ (-α₀) ≤ B₂⁻¹ := by linarith
    have hdiv_le : 24 * T_max * C_cone / P.η_sf ≤ B₂ := le_max_right _ _
    have hmul_B₂ : 24 * T_max * C_cone ≤ B₂ * P.η_sf := (div_le_iff₀ hη_sf_pos).mp hdiv_le
    calc 24 * T_max * C_cone * D_anc ^ (-α₀)
        ≤ 24 * T_max * C_cone * B₂⁻¹ :=
          mul_le_mul_of_nonneg_left hle_inv (by positivity)
      _ ≤ (B₂ * P.η_sf) * B₂⁻¹ :=
          mul_le_mul_of_nonneg_right hmul_B₂ (by positivity)
      _ = P.η_sf := by field_simp [(lt_of_lt_of_le zero_lt_one hB₂_ge_one).ne']

  have hD_anc_B₃ : 256 * C_anc * T_max ^ 2 * D_anc ^ (-2 * α₀) ≤ 1 / 16 := by
    have hB₃_le : B₃ ≤ D_anc :=
      le_trans (le_max_right _ _) (le_trans (le_max_right _ _) (le_max_right _ _))
    have h1_le : 1 ≤ D_anc := by linarith
    have he1 : D_anc ^ (-2 * α₀) ≤ D_anc ^ (-1 : ℝ) :=
      Real.rpow_le_rpow_of_exponent_le h1_le (by linarith)
    have he2 : D_anc ^ (-1 : ℝ) ≤ B₃ ^ (-1 : ℝ) :=
      Real.rpow_le_rpow_of_nonpos (by positivity) hB₃_le (by norm_num)
    have hle_inv : D_anc ^ (-2 * α₀) ≤ B₃⁻¹ := by
      rw [Real.rpow_neg_one B₃] at he2
      exact le_trans he1 he2
    have h4096 : 4096 * C_anc * T_max ^ 2 ≤ B₃ := le_max_right _ _
    have hB₃_pos : 0 < B₃ := lt_of_lt_of_le zero_lt_one hB₃_ge_one
    calc 256 * C_anc * T_max ^ 2 * D_anc ^ (-2 * α₀)
        ≤ 256 * C_anc * T_max ^ 2 * B₃⁻¹ :=
          mul_le_mul_of_nonneg_left hle_inv (by positivity)
      _ = (4096 * C_anc * T_max ^ 2) * B₃⁻¹ / 16 := by ring
      _ ≤ B₃ * B₃⁻¹ / 16 := by
          gcongr
      _ = 1 / 16 := by field_simp [hB₃_pos.ne']

  clear_value D_anc
  clear B₁ B₂ B₃ hB₁_ge_one hB₂_ge_one hB₃_ge_one

  refine ⟨D_anc, C_anc, α₀, hD_anc_pos, hC_anc_pos, hα₁, hα₂, ?_⟩
  intro A D_top hA hD_top

  let s_base_init : ℝ := E.s_star / 4
  have hs_base_init_pos : 0 < s_base_init := by positivity
  let δ_seed : ℝ := s_base_init / (16 * (1 + C_bump_init))
  have hδ_seed_pos : 0 < δ_seed := by positivity
  have hδ_seed_lt : δ_seed < s_base_init / 16 := by
    dsimp [δ_seed]
    have hden : 16 < 16 * (1 + C_bump_init) := by linarith
    exact div_lt_div_of_pos_left hs_base_init_pos (by norm_num) hden
  let Δ_slab : ℝ := E.s_star / 2
  have hΔ_slab_pos : 0 < Δ_slab := by positivity

  let m₀ : ℝ := 2 * A + 4
  have hm₀_ge_4 : 4 ≤ m₀ := by dsimp [m₀]; linarith
  have hm₀_pos : 0 < m₀ := by linarith
  let m_aux : ℝ := max m₀ ((C_bump + 4) / (D_dip - 1))
  have hm_aux_pos : 0 < m_aux := lt_of_lt_of_le hm₀_pos (le_max_left _ _)
  let m_steep_dyad : ℝ := 2 * (m_aux + C_bump + 2)
  let m_steep_init : ℝ := 2 * (m_aux + (4 * K₀ + 1) * C_bump_init + 2)
  let m_steep_big : ℝ := max m_steep_dyad m_steep_init
  have hm_steep_big_pos : 0 < m_steep_big :=
    lt_of_lt_of_le (by positivity : 0 < m_steep_dyad) (le_max_left _ _)

  let R_phys : ℕ → ℝ := fun n => 2 * T_max / seq.m_seq n
  let r_seq : ℕ → ℝ := fun n => 4 * T_max / seq.m_seq n
  let δ₀ : ℕ → ℝ := fun n => seq.h_seq n / K₀
  let d_seq : ℕ → ℝ := fun n => (D_anc / 2) * seq.ℓ_seq n
  let δ_ceil : ℕ → ℝ := fun n => seq.h_seq n + E.s_star / 4
  let M_scale : ℕ → ℝ := fun n => 3 * C_cone * seq.m_seq n * (seq.ℓ_seq n) ^ α₀

  let U_base_phys : ℕ → Set (ℂ × ℂ) := fun n =>
    { p : ℂ × ℂ | ‖p.2‖ < R_phys n ∧ |p.1.im| < δ_seed / 2 }
  let U_upper : ℕ → Set (ℂ × ℂ) := fun n =>
    { p : ℂ × ℂ |
      ‖p.2‖ < R_phys n ∧
      d_seq n < seq.h_seq n - p.1.im ∧
      seq.h_seq n - p.1.im < 2 * δ₀ n ∧
      |p.1.re - seq.x_seq n| < m₀ * (seq.h_seq n - p.1.im) }
  let U_lower : ℕ → Set (ℂ × ℂ) := fun n =>
    { p : ℂ × ℂ |
      ‖p.2‖ < R_phys n ∧
      δ₀ n < seq.h_seq n - p.1.im ∧
      seq.h_seq n - p.1.im < seq.h_seq n + δ_seed / 2 ∧
      |p.1.re - seq.x_seq n| < m₀ * (seq.h_seq n - p.1.im) }
  let U_phys : ℕ → Set (ℂ × ℂ) := fun n =>
    U_upper n ∪ (U_lower n ∪ U_base_phys n)
  let δ_base : ℕ → ℝ := fun _ => δ_seed / 2

  
  let ε_lim1 : ℝ :=
    min (Δ_slab / 16) (ρ_base / 2) / (48 * T_max * (4 / D_anc) ^ α₀)
  have hε_lim1_pos : 0 < ε_lim1 := by positivity
  let c_mul2 : ℝ := 9 * C_cone ^ 2 * (2 : ℝ) ^ (1 - 2 * α₀)
  have hc_mul2_pos : 0 < c_mul2 := by positivity
  let B_lim2 : ℝ := C_init * (1 + 16 / (γ_init * Δ_slab)) / c_mul2

  obtain ⟨N₁, hN₁⟩ :=
    (Filter.tendsto_atTop_atTop.mp hh_tendsto) (max (2 * E.s_star) (4 * δ_seed))
  obtain ⟨N₂, hN₂⟩ :=
    (Filter.tendsto_atTop_atTop.mp seq.h_div_ℓ_tendsto)
      (max (8 * K₀ * D_anc) (4 * K₀ * (D_top + 4)))
  obtain ⟨N₃, hN₃⟩ :=
    (Filter.tendsto_atTop_atTop.mp seq.b_tendsto)
      (max (8 * T_max / (D_anc * η_st)) (64 * T_max))
  obtain ⟨N₄, hN₄⟩ :=
    (Filter.tendsto_atTop_atTop.mp seq.m_tendsto) (4 * T_max / ρ_base + 1)
  obtain ⟨N₅, hN₅⟩ := (Metric.tendsto_atTop.mp hlim1) ε_lim1 hε_lim1_pos
  obtain ⟨N₆, hN₆⟩ := (Filter.tendsto_atTop_atTop.mp hlim2) B_lim2

  let N_init : ℕ := max N_shape (max (max N₁ N₂) (max (max N₃ N₄) (max N₅ N₆)))

  have h_exists_n : ∀ n ≥ N_init, ∃ s_t : ℂ × ℂ → ℂ,
      let s_n : ℂ := (seq.x_seq n : ℂ) + (seq.h_seq n : ℂ) * Complex.I
      let coneSet : Set (ℂ × ℂ) :=
        { p : ℂ × ℂ |
          D_anc < -p.1.im ∧ -p.1.im < D_top ∧
          |p.1.re| < A * (-p.1.im) ∧ ‖p.2‖ < T_max }
      IsOpen (U_phys n) ∧
      0 < δ_base n ∧
      (∀ y t : ℂ, (y, t) ∈ U_phys n → 0 ≤ y.im →
        ∀ τ : ℝ, 0 ≤ τ → τ ≤ y.im →
          ((y.re : ℂ) + (τ : ℂ) * Complex.I, t) ∈ U_phys n) ∧
      (∀ y t : ℂ, (y, t) ∈ U_phys n → (y, -t) ∈ U_phys n) ∧
      DifferentiableOn ℂ s_t (U_phys n) ∧
      (∀ p ∈ U_phys n, s_t p ∈ E.toExpStripData.D_strip) ∧
      (∀ y t : ℂ, (y, t) ∈ U_phys n → s_t (y, -t) = s_t (y, t)) ∧
      (∀ y t : ℂ, |y.im| < δ_base n → ‖t‖ < T_max / seq.m_seq n →
        (y, t) ∈ U_phys n ∧ (y, t) ∈ E.toExpStripData.Tube ∧
          s_t (y, t) = E.toExpStripData.𝔰 (y, t)) ∧
      (∀ y : ℂ, (s_n + (seq.ℓ_seq n : ℂ) * y, (0 : ℂ)) ∈ U_phys n →
        D_anc < -y.im → -y.im < D_top → |y.re| < A * (-y.im) →
        s_t (s_n + (seq.ℓ_seq n : ℂ) * y, 0) =
          s_n + (seq.ℓ_seq n : ℂ) * y) ∧
      (∀ p ∈ coneSet,
        (s_n + (seq.ℓ_seq n : ℂ) * p.1, p.2 / (seq.m_seq n : ℂ)) ∈ U_phys n ∧
        0 < (s_n + (seq.ℓ_seq n : ℂ) * p.1).im ∧
        ‖(s_t (s_n + (seq.ℓ_seq n : ℂ) * p.1, p.2 / (seq.m_seq n : ℂ)) - s_n) /
            (seq.ℓ_seq n : ℂ) - p.1‖ ≤
          C_anc * ‖p.2‖ ^ 2 * (-p.1.im) ^ (1 - 2 * α₀)) ∧
      (∀ Y T : ℂ, T ≠ 0 →
        (Y, T) ∈ coneSet →
        (Y - T / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ), T) ∈ coneSet →
        (Y + T / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ), T) ∈ coneSet →
        let t : ℂ := T / (seq.m_seq n : ℂ)
        let y : ℂ := s_n + (seq.ℓ_seq n : ℂ) * Y
        let s_prev : ℂ := s_t (y - t, t)
        let s_curr : ℂ := s_t (y, t)
        let s_next : ℂ := s_t (y + t, t)
        let J_prev : ℂ := (s_curr - s_prev) / t
        let J_curr : ℂ := (s_next - s_curr) / t
        deriv (fun J' => P.p_act s_curr J' t) J_curr -
          t * deriv (fun s' => P.p_act s' J_curr t) s_curr =
          deriv (fun J' => P.p_act s_prev J' t) J_prev) := by
    intro n hn
    have hn_shape : N_shape ≤ n := le_trans (le_max_left _ _) hn
    have hn_rest : max (max N₁ N₂) (max (max N₃ N₄) (max N₅ N₆)) ≤ n :=
      le_trans (le_max_right _ _) hn
    have hn₁ : N₁ ≤ n :=
      le_trans (le_max_left _ _) (le_trans (le_max_left _ _) hn_rest)
    have hn₂ : N₂ ≤ n :=
      le_trans (le_max_right _ _) (le_trans (le_max_left _ _) hn_rest)
    have hn₃ : N₃ ≤ n :=
      le_trans (le_max_left _ _) (le_trans (le_max_left _ _) (le_trans (le_max_right _ _) hn_rest))
    have hn₄ : N₄ ≤ n :=
      le_trans (le_max_right _ _) (le_trans (le_max_left _ _) (le_trans (le_max_right _ _) hn_rest))
    have hn₅ : N₅ ≤ n :=
      le_trans (le_max_left _ _) (le_trans (le_max_right _ _) (le_trans (le_max_right _ _) hn_rest))
    have hn₆ : N₆ ≤ n :=
      le_trans (le_max_right _ _) (le_trans (le_max_right _ _) (le_trans (le_max_right _ _) hn_rest))

    have hh_pos : 0 < seq.h_seq n := (h_bounds n).1
    have hℓ_pos : 0 < seq.ℓ_seq n := seq.ℓ_pos n
    have hm_pos : 0 < seq.m_seq n := seq.m_pos n
    have hd_pos : 0 < d_seq n := by dsimp [d_seq]; positivity
    have hδ₀_pos : 0 < δ₀ n := by dsimp [δ₀]; positivity
    have hr_pos : 0 < r_seq n := by dsimp [r_seq]; positivity
    have hR_phys_pos : 0 < R_phys n := by dsimp [R_phys]; positivity
    have hM_pos : 0 < M_scale n := by dsimp [M_scale]; positivity

    have hh_ge_2s : 2 * E.s_star ≤ seq.h_seq n :=
      le_trans (le_max_left _ _) (hN₁ n hn₁)
    have hh_ge_4seed : 4 * δ_seed ≤ seq.h_seq n :=
      le_trans (le_max_right _ _) (hN₁ n hn₁)
    have hh_div_ℓ_anc : 8 * K₀ * D_anc ≤ seq.h_seq n / seq.ℓ_seq n :=
      le_trans (le_max_left _ _) (hN₂ n hn₂)
    have hh_div_ℓ_top : 4 * K₀ * (D_top + 4) ≤ seq.h_seq n / seq.ℓ_seq n :=
      le_trans (le_max_right _ _) (hN₂ n hn₂)
    have hh_ge_anc : 8 * K₀ * D_anc * seq.ℓ_seq n ≤ seq.h_seq n :=
      (le_div_iff₀ hℓ_pos).mp hh_div_ℓ_anc
    have hh_ge_top : 4 * K₀ * (D_top + 4) * seq.ℓ_seq n ≤ seq.h_seq n :=
      (le_div_iff₀ hℓ_pos).mp hh_div_ℓ_top
    have hb_ge_st : 8 * T_max / (D_anc * η_st) ≤ seq.ℓ_seq n * seq.m_seq n :=
      le_trans (le_max_left _ _) (hN₃ n hn₃)
    have hb_ge_64 : 64 * T_max ≤ seq.ℓ_seq n * seq.m_seq n :=
      le_trans (le_max_right _ _) (hN₃ n hn₃)
    have hm_gt_4T : 4 * T_max / ρ_base < seq.m_seq n := by
      have := hN₄ n hn₄
      linarith
    have hR_phys_lt_ρ : R_phys n < ρ_base := by
      dsimp [R_phys]
      have h1 : 4 * T_max < seq.m_seq n * ρ_base := (div_lt_iff₀ hρ_base_pos).mp hm_gt_4T
      have h2 : 2 * T_max < seq.m_seq n * ρ_base := by linarith
      exact (div_lt_iff₀ hm_pos).mpr (by linarith)

    have hlim1_n : (seq.m_seq n)⁻¹ * (1 + seq.h_seq n / seq.ℓ_seq n) ^ α₀ < ε_lim1 := by
      have hd_dist := hN₅ n hn₅
      have hnonneg : 0 ≤ (seq.m_seq n)⁻¹ * (1 + seq.h_seq n / seq.ℓ_seq n) ^ α₀ := by positivity
      rw [Real.dist_eq, sub_zero, abs_of_nonneg hnonneg] at hd_dist
      exact hd_dist

    have h_param_small :
        12 * r_seq n * (2 * seq.h_seq n / d_seq n) ^ α₀ ≤
          min (Δ_slab / 16) (ρ_base / 2) := by
      have h_ratio_le : 2 * seq.h_seq n / d_seq n ≤ (4 / D_anc) * (1 + seq.h_seq n / seq.ℓ_seq n) := by
        have h_eq : 2 * seq.h_seq n / d_seq n = (4 / D_anc) * (seq.h_seq n / seq.ℓ_seq n) := by
          dsimp [d_seq]
          field_simp [hD_anc_pos.ne', hℓ_pos.ne']
          ring
        rw [h_eq]
        exact mul_le_mul_of_nonneg_left (by linarith) (by positivity)
      have hrpow_le : (2 * seq.h_seq n / d_seq n) ^ α₀ ≤
          (4 / D_anc) ^ α₀ * (1 + seq.h_seq n / seq.ℓ_seq n) ^ α₀ := by
        calc (2 * seq.h_seq n / d_seq n) ^ α₀
            ≤ ((4 / D_anc) * (1 + seq.h_seq n / seq.ℓ_seq n)) ^ α₀ :=
              Real.rpow_le_rpow (by positivity) h_ratio_le (by positivity)
          _ = (4 / D_anc) ^ α₀ * (1 + seq.h_seq n / seq.ℓ_seq n) ^ α₀ :=
              Real.mul_rpow (by positivity) (by positivity)
      have h12r : 12 * r_seq n = 48 * T_max * (seq.m_seq n)⁻¹ := by
        dsimp [r_seq]
        ring
      have hprod_lt :
          48 * T_max * (4 / D_anc) ^ α₀ *
            ((seq.m_seq n)⁻¹ * (1 + seq.h_seq n / seq.ℓ_seq n) ^ α₀) <
          min (Δ_slab / 16) (ρ_base / 2) := by
        have h_pos_fac : 0 < 48 * T_max * (4 / D_anc) ^ α₀ := by positivity
        have hmul := mul_lt_mul_of_pos_left hlim1_n h_pos_fac
        have h_cancel : 48 * T_max * (4 / D_anc) ^ α₀ * ε_lim1 =
            min (Δ_slab / 16) (ρ_base / 2) := by
          dsimp [ε_lim1]
          field_simp [h_pos_fac.ne']
        rwa [h_cancel] at hmul
      calc 12 * r_seq n * (2 * seq.h_seq n / d_seq n) ^ α₀
          ≤ (48 * T_max * (seq.m_seq n)⁻¹) *
              ((4 / D_anc) ^ α₀ * (1 + seq.h_seq n / seq.ℓ_seq n) ^ α₀) := by
            rw [h12r]
            exact mul_le_mul_of_nonneg_left hrpow_le (by positivity)
        _ = 48 * T_max * (4 / D_anc) ^ α₀ *
              ((seq.m_seq n)⁻¹ * (1 + seq.h_seq n / seq.ℓ_seq n) ^ α₀) := by ring
        _ ≤ min (Δ_slab / 16) (ρ_base / 2) := hprod_lt.le

    have hδ_ceil_le_2h : δ_ceil n ≤ 2 * seq.h_seq n := by
      dsimp [δ_ceil]
      linarith
    have hδ_ceil_pos : 0 < δ_ceil n := by dsimp [δ_ceil]; positivity

    have h_steep_param_small :
        12 * r_seq n * (δ_ceil n / d_seq n) ^ α₀ ≤ min (Δ_slab / 16) (ρ_base / 2) := by
      have hdiv_le : δ_ceil n / d_seq n ≤ 2 * seq.h_seq n / d_seq n :=
        div_le_div_of_nonneg_right hδ_ceil_le_2h hd_pos.le
      have hrpow_le : (δ_ceil n / d_seq n) ^ α₀ ≤ (2 * seq.h_seq n / d_seq n) ^ α₀ :=
        Real.rpow_le_rpow (by positivity) hdiv_le (by positivity)
      exact le_trans (mul_le_mul_of_nonneg_left hrpow_le (by positivity)) h_param_small

    have h_init_param_small : 8 * r_seq n * (2 * seq.h_seq n / d_seq n) ^ α₀ ≤ ρ_base := by
      have h8_le_12 : 8 * r_seq n * (2 * seq.h_seq n / d_seq n) ^ α₀ ≤
          12 * r_seq n * (2 * seq.h_seq n / d_seq n) ^ α₀ := by
        have : 0 ≤ r_seq n * (2 * seq.h_seq n / d_seq n) ^ α₀ := by positivity
        linarith
      have hmin_le : min (Δ_slab / 16) (ρ_base / 2) ≤ ρ_base / 2 := min_le_right _ _
      linarith

    have h_absorb_2h :
        C_init * (1 + 8 * δ_ceil n / (γ_init * Δ_slab)) ≤
          M_scale n ^ 2 * (2 * seq.h_seq n) ^ (1 - 2 * α₀) := by
      have hlim2_n : B_lim2 ≤
          (seq.m_seq n) ^ 2 * (seq.ℓ_seq n) ^ (2 * α₀) *
            (seq.h_seq n) ^ (1 - 2 * α₀) / (1 + seq.h_seq n) := hN₆ n hn₆
      have h1h_pos : 0 < 1 + seq.h_seq n := by positivity
      have hmul1 : B_lim2 * (1 + seq.h_seq n) ≤
          (seq.m_seq n) ^ 2 * (seq.ℓ_seq n) ^ (2 * α₀) * (seq.h_seq n) ^ (1 - 2 * α₀) :=
        (le_div_iff₀ h1h_pos).mp hlim2_n
      have hmul2 : c_mul2 * (B_lim2 * (1 + seq.h_seq n)) ≤
          c_mul2 * ((seq.m_seq n) ^ 2 * (seq.ℓ_seq n) ^ (2 * α₀) *
            (seq.h_seq n) ^ (1 - 2 * α₀)) :=
        mul_le_mul_of_nonneg_left hmul1 hc_mul2_pos.le
      have hrhs_eq :
          c_mul2 * ((seq.m_seq n) ^ 2 * (seq.ℓ_seq n) ^ (2 * α₀) *
            (seq.h_seq n) ^ (1 - 2 * α₀)) =
          M_scale n ^ 2 * (2 * seq.h_seq n) ^ (1 - 2 * α₀) := by
        dsimp [c_mul2, M_scale]
        have hℓ_pow : ((seq.ℓ_seq n) ^ α₀) ^ (2 : ℕ) = (seq.ℓ_seq n) ^ (2 * α₀) := by
          rw [← Real.rpow_natCast ((seq.ℓ_seq n) ^ α₀) 2, ← Real.rpow_mul hℓ_pos.le]
          ring_nf
        have h2h_pow : (2 * seq.h_seq n) ^ (1 - 2 * α₀) =
            (2 : ℝ) ^ (1 - 2 * α₀) * (seq.h_seq n) ^ (1 - 2 * α₀) :=
          Real.mul_rpow (by norm_num) hh_pos.le
        rw [h2h_pow]
        calc 9 * C_cone ^ 2 * (2 : ℝ) ^ (1 - 2 * α₀) *
              (seq.m_seq n ^ 2 * seq.ℓ_seq n ^ (2 * α₀) * seq.h_seq n ^ (1 - 2 * α₀))
            = 9 * C_cone ^ 2 * seq.m_seq n ^ 2 * ((seq.ℓ_seq n ^ α₀) ^ (2 : ℕ)) *
                ((2 : ℝ) ^ (1 - 2 * α₀) * seq.h_seq n ^ (1 - 2 * α₀)) := by
              rw [hℓ_pow]; ring
          _ = (3 * C_cone * seq.m_seq n * seq.ℓ_seq n ^ α₀) ^ 2 *
                ((2 : ℝ) ^ (1 - 2 * α₀) * seq.h_seq n ^ (1 - 2 * α₀)) := by ring
      have hlhs_eq : c_mul2 * (B_lim2 * (1 + seq.h_seq n)) =
          C_init * (1 + 16 / (γ_init * Δ_slab)) * (1 + seq.h_seq n) := by
        dsimp [B_lim2]
        field_simp [hc_mul2_pos.ne']
      have hlhs_le :
          C_init * (1 + 8 * δ_ceil n / (γ_init * Δ_slab)) ≤
            C_init * (1 + 16 / (γ_init * Δ_slab)) * (1 + seq.h_seq n) := by
        have h8_le : 8 * δ_ceil n ≤ 16 * (1 + seq.h_seq n) := by linarith
        have hdiv_le : 8 * δ_ceil n / (γ_init * Δ_slab) ≤
            (16 / (γ_init * Δ_slab)) * (1 + seq.h_seq n) := by
          have : (16 / (γ_init * Δ_slab)) * (1 + seq.h_seq n) =
              16 * (1 + seq.h_seq n) / (γ_init * Δ_slab) := by ring
          rw [this]
          exact div_le_div_of_nonneg_right h8_le (by positivity)
        have h1_le_add : 1 + 8 * δ_ceil n / (γ_init * Δ_slab) ≤
            (1 + 16 / (γ_init * Δ_slab)) * (1 + seq.h_seq n) := by
          nlinarith only [hdiv_le, hh_pos]
        calc C_init * (1 + 8 * δ_ceil n / (γ_init * Δ_slab))
            ≤ C_init * ((1 + 16 / (γ_init * Δ_slab)) * (1 + seq.h_seq n)) :=
              mul_le_mul_of_nonneg_left h1_le_add hC_init_pos.le
          _ = C_init * (1 + 16 / (γ_init * Δ_slab)) * (1 + seq.h_seq n) := by ring
      linarith

    clear_value N_init ε_lim1 c_mul2 B_lim2
    clear hN₁ hN₂ hN₃ hN₄ hN₅ hN₆ hn_rest

    have h_absorb_ceil :
        C_init * (1 + 8 * δ_ceil n / (γ_init * Δ_slab)) ≤
          M_scale n ^ 2 * (δ_ceil n) ^ (1 - 2 * α₀) := by
      have hrpow_le : (2 * seq.h_seq n) ^ (1 - 2 * α₀) ≤ (δ_ceil n) ^ (1 - 2 * α₀) :=
        Real.rpow_le_rpow_of_nonpos hδ_ceil_pos hδ_ceil_le_2h (by linarith)
      exact le_trans h_absorb_2h (mul_le_mul_of_nonneg_left hrpow_le (by positivity))

    have hC_init_le_2h : C_init ≤ M_scale n ^ 2 * (2 * seq.h_seq n) ^ (1 - 2 * α₀) := by
      have h_ge : C_init ≤ C_init * (1 + 8 * δ_ceil n / (γ_init * Δ_slab)) := by
        have : 0 ≤ 8 * δ_ceil n / (γ_init * Δ_slab) := by positivity
        nlinarith only [this, hC_init_pos]
      exact le_trans h_ge h_absorb_2h

    have hr_div_d : r_seq n / d_seq n ≤ η_st := by
      have h_eq : r_seq n / d_seq n =
          (8 * T_max / D_anc) / (seq.ℓ_seq n * seq.m_seq n) := by
        dsimp [r_seq, d_seq]
        field_simp [hm_pos.ne', hD_anc_pos.ne', hℓ_pos.ne']
        ring
      rw [h_eq]
      have hprod_pos : 0 < seq.ℓ_seq n * seq.m_seq n := mul_pos hℓ_pos hm_pos
      rw [div_le_iff₀ hprod_pos]
      have hmul := (div_le_iff₀ (mul_pos hD_anc_pos hη_st_pos)).mp hb_ge_st
      have : 8 * T_max / D_anc ≤ η_st * (seq.ℓ_seq n * seq.m_seq n) := by
        rw [div_le_iff₀ hD_anc_pos]
        linarith
      linarith

    have hr_d_M : r_seq n * (d_seq n) ^ (-α₀) * M_scale n ≤ η_st := by
      have hd_rpow : (d_seq n) ^ (-α₀) = (D_anc / 2) ^ (-α₀) * (seq.ℓ_seq n) ^ (-α₀) := by
        dsimp [d_seq]
        exact Real.mul_rpow (by positivity) hℓ_pos.le
      have hℓ_cancel : (seq.ℓ_seq n) ^ (-α₀) * (seq.ℓ_seq n) ^ α₀ = 1 := by
        rw [← Real.rpow_add hℓ_pos]
        norm_num
      have h_eq : r_seq n * (d_seq n) ^ (-α₀) * M_scale n =
          12 * T_max * C_cone * (D_anc / 2) ^ (-α₀) := by
        dsimp [r_seq, M_scale]
        rw [hd_rpow]
        calc (4 * T_max / seq.m_seq n) * ((D_anc / 2) ^ (-α₀) * seq.ℓ_seq n ^ (-α₀)) *
              (3 * C_cone * seq.m_seq n * seq.ℓ_seq n ^ α₀)
            = 12 * T_max * C_cone * (D_anc / 2) ^ (-α₀) *
                (seq.m_seq n / seq.m_seq n) *
                (seq.ℓ_seq n ^ (-α₀) * seq.ℓ_seq n ^ α₀) := by ring
          _ = 12 * T_max * C_cone * (D_anc / 2) ^ (-α₀) := by
              rw [div_self hm_pos.ne', hℓ_cancel]; ring
      rw [h_eq]
      exact hD_anc_B₁

    have h_shape_scaled : ∀ s : ℂ,
        seq.ℓ_seq n ≤ seq.h_seq n - s.im →
        seq.h_seq n - s.im ≤ (3 / 2) * seq.h_seq n →
        ‖E.f s‖ ≤ M_scale n * (seq.h_seq n - s.im) ^ (-α₀) ∧
        Real.sqrt ‖E.q s‖ ≤ M_scale n * (seq.h_seq n - s.im) ^ (-α₀) := by
      intro s hs_lo hs_hi
      have hδ_pos : 0 < seq.h_seq n - s.im := lt_of_lt_of_le hℓ_pos hs_lo
      obtain ⟨hf_b, hq_b⟩ := hShape n hn_shape s hs_lo hs_hi
      have hrpow_div : (seq.ℓ_seq n / (seq.h_seq n - s.im)) ^ α₀ =
          (seq.ℓ_seq n) ^ α₀ * (seq.h_seq n - s.im) ^ (-α₀) := by
        calc (seq.ℓ_seq n / (seq.h_seq n - s.im)) ^ α₀
            = (seq.ℓ_seq n * (seq.h_seq n - s.im)⁻¹) ^ α₀ := by rw [div_eq_mul_inv]
          _ = (seq.ℓ_seq n) ^ α₀ * ((seq.h_seq n - s.im)⁻¹) ^ α₀ :=
              Real.mul_rpow hℓ_pos.le (inv_nonneg.mpr hδ_pos.le)
          _ = (seq.ℓ_seq n) ^ α₀ * ((seq.h_seq n - s.im) ^ (-1 : ℝ)) ^ α₀ := by
              rw [← Real.rpow_neg_one (seq.h_seq n - s.im)]
          _ = (seq.ℓ_seq n) ^ α₀ * (seq.h_seq n - s.im) ^ (-α₀) := by
              rw [← Real.rpow_mul hδ_pos.le]; ring_nf
      have hrhs_eq :
          (3 * C_cone) * seq.m_seq n * (seq.ℓ_seq n / (seq.h_seq n - s.im)) ^ α₀ =
            M_scale n * (seq.h_seq n - s.im) ^ (-α₀) := by
        dsimp [M_scale]
        rw [hrpow_div]
        ring
      rw [hrhs_eq] at hf_b hq_b
      exact ⟨hf_b, hq_b⟩

    
    have hDℓ_pos : 0 < D_anc * seq.ℓ_seq n := mul_pos hD_anc_pos hℓ_pos
    have h2Δ_le_ceil : 2 * Δ_slab ≤ δ_ceil n := by
      dsimp [Δ_slab, δ_ceil]; linarith
    have h4d_le_ceil : 4 * d_seq n ≤ δ_ceil n - Δ_slab := by
      dsimp [d_seq, δ_ceil, Δ_slab]
      have h1 : 2 * D_anc * seq.ℓ_seq n ≤ seq.h_seq n / 2 := by
        have hle : 4 * (D_anc * seq.ℓ_seq n) ≤ (8 * K₀) * (D_anc * seq.ℓ_seq n) :=
          mul_le_mul_of_nonneg_right (by linarith only [hK₀_gt_32]) hDℓ_pos.le
        have heq1 : (8 * K₀) * (D_anc * seq.ℓ_seq n) = 8 * K₀ * D_anc * seq.ℓ_seq n := by ring
        have heq2 : 2 * D_anc * seq.ℓ_seq n = 2 * (D_anc * seq.ℓ_seq n) := by ring
        linarith only [hle, heq1, heq2, hh_ge_anc]
      linarith only [h1, hh_ge_2s, hs_star_pos]

    let L_in : ℝ := 2 * m_steep_big + 2 / γ_init + 4
    let S_init_n : Set (ℂ × ℂ) :=
      { p : ℂ × ℂ |
        δ_ceil n - Δ_slab < seq.h_seq n - p.1.im ∧ seq.h_seq n - p.1.im < δ_ceil n ∧
        |p.1.re - seq.x_seq n| < L_in * (seq.h_seq n - p.1.im) ∧
        ‖p.2‖ < 12 * r_seq n * (δ_ceil n / d_seq n) ^ α₀ }
    have hS_init_bounds : ∀ p ∈ S_init_n,
        |p.1.im| < E.s_star / 4 ∧ ‖p.2‖ < ρ_base := by
      intro p hp
      rcases hp with ⟨hp1, hp2, _, hp4⟩
      have him : |p.1.im| < E.s_star / 4 := by
        rw [abs_lt]
        dsimp [δ_ceil, Δ_slab] at hp1 hp2
        constructor <;> linarith
      have ht : ‖p.2‖ < ρ_base := by
        have hle := le_trans h_steep_param_small (min_le_right _ _)
        linarith
      exact ⟨him, ht⟩
    have hS_init_sub_T : S_init_n ⊆ E.T := by
      intro p hp
      obtain ⟨him, ht⟩ := hS_init_bounds p hp
      apply E.T_base_subset
      left
      exact ⟨by linarith, by linarith⟩

    obtain ⟨s_steep, hs_steep_holo, _, hs_steep_props, hs_steep_base, hs_steep_rec⟩ :=
      hSteep_apply (seq.x_seq n) (seq.h_seq n) m_steep_big (d_seq n) (δ_ceil n) Δ_slab
        (r_seq n) (M_scale n) C_init E.𝔰
        hm_steep_big_pos hd_pos hΔ_slab_pos h2Δ_le_ceil h4d_le_ceil hr_pos hM_pos
        hC_init_pos.le (le_trans h_steep_param_small (min_le_left _ _))
        hr_div_d hr_d_M h_absorb_ceil
        (by
          intro s hs_lo hs_hi _
          have hs_ℓ : seq.ℓ_seq n ≤ seq.h_seq n - s.im := by
            dsimp [d_seq] at hs_lo
            nlinarith only [hs_lo, hD_anc_ge_40, hℓ_pos]
          have hs_top : seq.h_seq n - s.im ≤ (3 / 2) * seq.h_seq n := by
            dsimp [δ_ceil] at hs_hi
            linarith only [hs_hi, hh_ge_2s, hh_pos]
          obtain ⟨hf_s, hq_s⟩ := h_shape_scaled s hs_ℓ hs_top
          exact ⟨Set.mem_univ _, hf_s, hq_s⟩)
        (E.𝔰_holo.mono hS_init_sub_T)
        (by
          intro y t hyt
          obtain ⟨him, ht⟩ := hS_init_bounds (y, t) hyt
          have hT : (y, t) ∈ E.T := hS_init_sub_T hyt
          have him_full : |y.im| < s_base_full := by dsimp [s_base_full]; linarith
          obtain ⟨h_div, _, h_ub⟩ := hU_props y t him_full ht
          refine ⟨E.𝔰_even y t hT, ?_⟩
          calc ‖E.𝔰 (y, t) - y‖
              = ‖t ^ 2 * U_base (y, t)‖ := by rw [h_div]
            _ = ‖t‖ ^ 2 * ‖U_base (y, t)‖ := by rw [norm_mul, norm_pow]
            _ ≤ ‖t‖ ^ 2 * C_init := mul_le_mul_of_nonneg_left h_ub (by positivity)
            _ = C_init * ‖t‖ ^ 2 := mul_comm _ _)
        (fun y _ => E.𝔰_zero y)
        (by
          intro y t ht_ne _ hyt _
          obtain ⟨him, ht⟩ := hS_init_bounds (y, t) hyt
          dsimp at him ht
          have him_3 : |y.im| < E.toExpStripData.s_star / 3 := by
            change |y.im| < E.s_star / 3
            linarith
          have ht_rec : ‖t‖ < P.r_rec := by linarith
          exact P.base_recurrence y t him_3 (norm_pos_iff.mpr ht_ne) ht_rec)

    
    have h4d_le_mid : 4 * d_seq n ≤ seq.h_seq n / (2 * K₀) := by
      dsimp [d_seq]
      rw [le_div_iff₀ (by positivity : 0 < 2 * K₀)]
      have heq : 4 * (D_anc / 2 * seq.ℓ_seq n) * (2 * K₀) =
          (8 * K₀ * D_anc * seq.ℓ_seq n) / 2 := by ring
      linarith only [heq, hh_ge_anc, hh_pos]
    let W_steep_big : Set (ℂ × ℂ) :=
      { p : ℂ × ℂ |
        d_seq n / 2 < seq.h_seq n - p.1.im ∧
        seq.h_seq n - p.1.im < δ_ceil n - Δ_slab / 4 ∧
        |p.1.re - seq.x_seq n| < m_steep_big * (seq.h_seq n - p.1.im) ∧
        ‖p.2‖ < 10 * r_seq n * ((seq.h_seq n - p.1.im) / d_seq n) ^ α₀ ∧
        γ_init * ‖p.2‖ < |p.2.im| }
    let W_steep_init : Set (ℂ × ℂ) :=
      { p : ℂ × ℂ |
        d_seq n / 2 < seq.h_seq n - p.1.im ∧
        seq.h_seq n - p.1.im < seq.h_seq n + s_base_init / 2 ∧
        |p.1.re - seq.x_seq n| < m_steep_init * (seq.h_seq n - p.1.im) ∧
        ‖p.2‖ < 10 * r_seq n * ((seq.h_seq n - p.1.im) / d_seq n) ^ α₀ ∧
        γ_init * ‖p.2‖ < |p.2.im| }
    have hW_init_sub_big : W_steep_init ⊆ W_steep_big := by
      intro p hp
      rcases hp with ⟨hp1, hp2, hp3, hp4, hp5⟩
      have hδ_pos_p : 0 < seq.h_seq n - p.1.im := lt_trans (by positivity) hp1
      have hceil_eq : seq.h_seq n + s_base_init / 2 = δ_ceil n - Δ_slab / 4 := by
        dsimp [s_base_init, δ_ceil, Δ_slab]; ring
      have hm_le : m_steep_init ≤ m_steep_big := le_max_right _ _
      refine ⟨hp1, by linarith, ?_, hp4, hp5⟩
      exact lt_of_lt_of_le hp3 (mul_le_mul_of_nonneg_right hm_le hδ_pos_p.le)

    obtain ⟨s_band₀, hs_band₀_holo, hs_band₀_props, hs_band₀_zero,
        hs_band₀_base, hs_band₀_steep⟩ :=
      hInit_apply (seq.x_seq n) (seq.h_seq n) s_base_init ρ_base m_aux (d_seq n)
        (r_seq n) (M_scale n) C_st C_init E.𝔰 U_base s_steep
        hs_base_init_pos (by dsimp [s_base_init]; linarith) hρ_base_pos hm_aux_pos
        hd_pos h4d_le_mid hr_pos hM_pos hC_st_pos hC_init_pos.le
        h_init_param_small hC_init_le_2h
        (hU_holo.mono (fun p hp => ⟨by dsimp [s_base_init, s_base_full] at *; linarith [hp.1], hp.2⟩))
        (fun y t hyt => hU_props y t (by dsimp [s_base_init, s_base_full] at *; linarith [hyt.1]) hyt.2)
        (hs_steep_holo.mono hW_init_sub_big)
        (fun y t hyt => hs_steep_props y t (hW_init_sub_big hyt))
        (by
          intro p hp him _
          have hp_big : p ∈ W_steep_big := hW_init_sub_big hp
          have h_im_lt : p.1.im < s_base_init / 2 := (abs_lt.mp him).2
          have h_slab_gt : δ_ceil n - (3 / 4) * Δ_slab < seq.h_seq n - p.1.im := by
            dsimp [δ_ceil, Δ_slab, s_base_init] at *
            linarith
          exact hs_steep_base p.1 p.2 hp_big h_slab_gt)

    
    have hd_lt_δ₀ : d_seq n < δ₀ n := by
      dsimp [d_seq, δ₀]
      rw [lt_div_iff₀ hK₀_pos]
      have heq : D_anc / 2 * seq.ℓ_seq n * K₀ =
          (8 * K₀ * D_anc * seq.ℓ_seq n) / 16 := by ring
      linarith only [heq, hh_ge_anc, hh_pos]
    let Ω_mid : Set (ℂ × ℂ) :=
      { p : ℂ × ℂ |
        seq.h_seq n / (2 * K₀) < seq.h_seq n - p.1.im ∧
        seq.h_seq n - p.1.im < seq.h_seq n + δ_seed ∧
        |p.1.re - seq.x_seq n| < m_aux * (seq.h_seq n - p.1.im) ∧
        ‖p.2‖ < r_seq n * ((seq.h_seq n - p.1.im) / d_seq n) ^ α₀ }
    let Ω_init : Set (ℂ × ℂ) :=
      { p : ℂ × ℂ |
        δ₀ n < seq.h_seq n - p.1.im ∧
        seq.h_seq n - p.1.im < M_ceil * δ₀ n ∧
        |p.1.re - seq.x_seq n| < m_aux * (seq.h_seq n - p.1.im) ∧
        ‖p.2‖ < r_seq n * ((seq.h_seq n - p.1.im) / d_seq n) ^ α₀ }
    let W_steep_dyad : Set (ℂ × ℂ) :=
      { p : ℂ × ℂ |
        d_seq n / 2 < seq.h_seq n - p.1.im ∧
        seq.h_seq n - p.1.im < M_ceil * δ₀ n ∧
        |p.1.re - seq.x_seq n| < m_steep_dyad * (seq.h_seq n - p.1.im) ∧
        ‖p.2‖ < 10 * r_seq n * ((seq.h_seq n - p.1.im) / d_seq n) ^ α₀ ∧
        γ_dyad * ‖p.2‖ < |p.2.im| }
    let Ω_out : Set (ℂ × ℂ) :=
      { p : ℂ × ℂ |
        d_seq n < seq.h_seq n - p.1.im ∧
        seq.h_seq n - p.1.im < 2 * δ₀ n ∧
        |p.1.re - seq.x_seq n| < m₀ * (seq.h_seq n - p.1.im) ∧
        ‖p.2‖ < r_seq n * ((seq.h_seq n - p.1.im) / d_seq n) ^ α₀ }

    have hMceil_δ₀ : M_ceil * δ₀ n = seq.h_seq n / 4 := by
      dsimp [δ₀, K₀]
      field_simp [(by linarith : M_ceil ≠ 0)]
    have hΩ_init_sub_mid : Ω_init ⊆ Ω_mid := by
      intro p hp
      rcases hp with ⟨hp1, hp2, hp3, hp4⟩
      have hlo : seq.h_seq n / (2 * K₀) < δ₀ n := by
        dsimp [δ₀]
        have : seq.h_seq n / (2 * K₀) = (seq.h_seq n / K₀) / 2 := by ring
        linarith
      refine ⟨lt_trans hlo hp1, ?_, hp3, hp4⟩
      rw [hMceil_δ₀] at hp2
      linarith
    have hW_dyad_sub_big : W_steep_dyad ⊆ W_steep_big := by
      intro p hp
      rcases hp with ⟨hp1, hp2, hp3, hp4, hp5⟩
      have hδ_pos_p : 0 < seq.h_seq n - p.1.im := lt_trans (by positivity) hp1
      have hm_le : m_steep_dyad ≤ m_steep_big := le_max_left _ _
      have hγ_le : γ_init * ‖p.2‖ ≤ γ_dyad * ‖p.2‖ :=
        mul_le_mul_of_nonneg_right hγ_init_lt.le (norm_nonneg _)
      refine ⟨hp1, ?_, lt_of_lt_of_le hp3 (mul_le_mul_of_nonneg_right hm_le hδ_pos_p.le),
        hp4, lt_of_le_of_lt hγ_le hp5⟩
      rw [hMceil_δ₀] at hp2
      dsimp [δ_ceil, Δ_slab]
      linarith

    obtain ⟨s_cone, hs_cone_holo, _, hs_cone_props, hs_cone_zero,
        hs_cone_init, hs_cone_steep⟩ :=
      hDyad_apply E.toExpStripData hD_strip_open hD_strip_conv
        (seq.x_seq n) (seq.h_seq n) m₀ (d_seq n) (δ₀ n) (r_seq n) (M_scale n)
        C_st A₀ s_band₀ s_steep
        hm₀_pos hd_pos hd_lt_δ₀ hr_pos hM_pos hC_st_pos hA₀_pos.le
        (hs_band₀_holo.mono hΩ_init_sub_mid)
        (fun y t hyt => hs_band₀_props y t (hΩ_init_sub_mid hyt))
        (fun y hy => hs_band₀_zero y (hΩ_init_sub_mid hy))
        (hs_steep_holo.mono hW_dyad_sub_big)
        (fun y t hyt => hs_steep_props y t (hW_dyad_sub_big hyt))
        (by
          intro p hp
          rcases hp with ⟨hp_init, hp_dyad⟩
          have hp_mid : p ∈ Ω_mid := hΩ_init_sub_mid hp_init
          have hδ_pos_p : 0 < seq.h_seq n - p.1.im := lt_trans hδ₀_pos hp_init.1
          have hm_aux_lt : m_aux < m_steep_init := by
            dsimp [m_steep_init]
            have : 0 < (4 * K₀ + 1) * C_bump_init := by positivity
            linarith
          have hp_w_init : p ∈ W_steep_init := by
            refine ⟨hp_dyad.1, ?_, ?_, hp_dyad.2.2.2.1, ?_⟩
            · have hp2 := hp_dyad.2.1
              rw [hMceil_δ₀] at hp2
              linarith
            · exact lt_trans hp_init.2.2.1
                (mul_lt_mul_of_pos_right hm_aux_lt hδ_pos_p)
            · exact lt_of_le_of_lt
                (mul_le_mul_of_nonneg_right hγ_init_lt.le (norm_nonneg _))
                hp_dyad.2.2.2.2
          exact hs_band₀_steep p ⟨hp_mid, hp_w_init⟩)
        (fun _ _ _ _ => Set.subset_univ _)

    clear hSteep_apply hInit_apply hDyad_apply L_in S_init_n hS_init_bounds hS_init_sub_T
      W_steep_init hW_init_sub_big

    
    classical
    let s_t : ℂ × ℂ → ℂ := fun p =>
      if p ∈ U_upper n then s_cone p
      else if p ∈ U_lower n then s_band₀ p
      else E.𝔰 p

    have hU_upper_open : IsOpen (U_upper n) := by
      have hc_t : Continuous (fun p : ℂ × ℂ => ‖p.2‖) := continuous_norm.comp continuous_snd
      have hc_im : Continuous (fun p : ℂ × ℂ => p.1.im) := Complex.continuous_im.comp continuous_fst
      have hc_depth : Continuous (fun p : ℂ × ℂ => seq.h_seq n - p.1.im) := continuous_const.sub hc_im
      have hc_re_diff : Continuous (fun p : ℂ × ℂ => |p.1.re - seq.x_seq n|) :=
        continuous_abs.comp ((Complex.continuous_re.comp continuous_fst).sub continuous_const)
      have hc_cone : Continuous (fun p : ℂ × ℂ => m₀ * (seq.h_seq n - p.1.im)) :=
        continuous_const.mul hc_depth
      exact (isOpen_lt hc_t continuous_const).inter <|
        (isOpen_lt continuous_const hc_depth).inter <|
          (isOpen_lt hc_depth continuous_const).inter (isOpen_lt hc_re_diff hc_cone)
    have hU_lower_open : IsOpen (U_lower n) := by
      have hc_t : Continuous (fun p : ℂ × ℂ => ‖p.2‖) := continuous_norm.comp continuous_snd
      have hc_im : Continuous (fun p : ℂ × ℂ => p.1.im) := Complex.continuous_im.comp continuous_fst
      have hc_depth : Continuous (fun p : ℂ × ℂ => seq.h_seq n - p.1.im) := continuous_const.sub hc_im
      have hc_re_diff : Continuous (fun p : ℂ × ℂ => |p.1.re - seq.x_seq n|) :=
        continuous_abs.comp ((Complex.continuous_re.comp continuous_fst).sub continuous_const)
      have hc_cone : Continuous (fun p : ℂ × ℂ => m₀ * (seq.h_seq n - p.1.im)) :=
        continuous_const.mul hc_depth
      exact (isOpen_lt hc_t continuous_const).inter <|
        (isOpen_lt continuous_const hc_depth).inter <|
          (isOpen_lt hc_depth continuous_const).inter (isOpen_lt hc_re_diff hc_cone)
    have hU_base_open : IsOpen (U_base_phys n) :=
      (isOpen_lt (continuous_norm.comp continuous_snd) continuous_const).inter
        (isOpen_lt (continuous_abs.comp (Complex.continuous_im.comp continuous_fst)) continuous_const)
    have hU_phys_open : IsOpen (U_phys n) :=
      hU_upper_open.union (hU_lower_open.union hU_base_open)

    have hR_phys_lt_cone : ∀ δ_p : ℝ, d_seq n < δ_p →
        R_phys n < r_seq n * (δ_p / d_seq n) ^ α₀ := by
      intro δ_p hδ_gt
      have h1_le : 1 ≤ δ_p / d_seq n := (one_le_div hd_pos).mpr hδ_gt.le
      have hrpow_ge : 1 ≤ (δ_p / d_seq n) ^ α₀ := Real.one_le_rpow h1_le (by positivity)
      have hR_lt_r : R_phys n < r_seq n := by
        dsimp [R_phys, r_seq]
        exact div_lt_div_of_pos_right (by linarith only [hT_max]) hm_pos
      calc R_phys n < r_seq n * 1 := by linarith only [hR_lt_r]
        _ ≤ r_seq n * (δ_p / d_seq n) ^ α₀ :=
            mul_le_mul_of_nonneg_left hrpow_ge hr_pos.le

    have hU_upper_sub_out : U_upper n ⊆ Ω_out := by
      intro p hp
      rcases hp with ⟨hp_t, hp_lo, hp_hi, hp_re⟩
      exact ⟨hp_lo, hp_hi, hp_re, lt_trans hp_t (hR_phys_lt_cone _ hp_lo)⟩
    have hU_lower_sub_mid : U_lower n ⊆ Ω_mid := by
      intro p hp
      rcases hp with ⟨hp_t, hp_lo, hp_hi, hp_re⟩
      have hδ_pos_p : 0 < seq.h_seq n - p.1.im := lt_trans hδ₀_pos hp_lo
      have hlo : seq.h_seq n / (2 * K₀) < δ₀ n := by
        dsimp [δ₀]
        have : seq.h_seq n / (2 * K₀) = (seq.h_seq n / K₀) / 2 := by ring
        linarith only [this, hδ₀_pos]
      have hm_le : m₀ ≤ m_aux := le_max_left _ _
      exact ⟨lt_trans hlo hp_lo, by linarith only [hp_hi, hδ_seed_pos],
        lt_of_lt_of_le hp_re (mul_le_mul_of_nonneg_right hm_le hδ_pos_p.le),
        lt_trans hp_t (hR_phys_lt_cone _ (lt_trans hd_lt_δ₀ hp_lo))⟩
    have hU_base_sub_T : U_base_phys n ⊆ E.T := by
      intro p hp
      rcases hp with ⟨hp_t, hp_im⟩
      apply E.T_base_subset
      left
      refine ⟨?_, ?_⟩
      · dsimp [s_base_init] at hδ_seed_lt
        linarith only [hp_im, hδ_seed_lt, hδ_seed_pos, hs_star_pos]
      · have h1 : ‖p.2‖ < ρ_base := lt_trans hp_t hR_phys_lt_ρ
        linarith only [h1, hρ_le_rstar, hr_star_pos]

    have hs_t_upper : ∀ p ∈ U_upper n, s_t p = s_cone p := by
      intro p hp
      dsimp [s_t]
      split_ifs
      rfl
    have hs_t_lower : ∀ p ∈ U_lower n, s_t p = s_band₀ p := by
      intro p hp
      dsimp [s_t]
      split_ifs with h_up
      · have hp_out : p ∈ Ω_out := hU_upper_sub_out h_up
        have hp_init : p ∈ Ω_init := by
          have hδ_pos_p : 0 < seq.h_seq n - p.1.im := lt_trans hδ₀_pos hp.2.1
          have hm_le : m₀ ≤ m_aux := le_max_left _ _
          have h2δ₀_lt : 2 * δ₀ n < M_ceil * δ₀ n :=
            mul_lt_mul_of_pos_right (by linarith only [hM_ceil]) hδ₀_pos
          exact ⟨hp.2.1, lt_trans h_up.2.2.1 h2δ₀_lt,
            lt_of_lt_of_le hp.2.2.2 (mul_le_mul_of_nonneg_right hm_le hδ_pos_p.le),
            hp_out.2.2.2⟩
        exact hs_cone_init p ⟨hp_out, hp_init⟩
      · rfl
    have hs_t_base : ∀ p ∈ U_base_phys n, s_t p = E.𝔰 p := by
      intro p hp
      have h_not_up : p ∉ U_upper n := by
        intro h_up
        have him_lt : p.1.im < δ_seed / 2 := (abs_lt.mp hp.2).2
        have h2δ₀_lt : 2 * δ₀ n < seq.h_seq n / 16 := by
          dsimp [δ₀]
          rw [← mul_div_assoc, div_lt_iff₀ hK₀_pos]
          nlinarith only [hh_pos, hK₀_gt_32]
        have h_up_hi := h_up.2.2.1
        linarith only [him_lt, h2δ₀_lt, hh_ge_4seed, h_up_hi, hh_pos]
      dsimp [s_t]
      split_ifs with h_lo
      · have hp2 := hp.2
        exact hs_band₀_base p (hU_lower_sub_mid h_lo) (by linarith only [hp2, hδ_seed_pos])
      · rfl

    have hs_t_holo_upper : DifferentiableOn ℂ s_t (U_upper n) :=
      (hs_cone_holo.mono hU_upper_sub_out).congr hs_t_upper
    have hs_t_holo_lower : DifferentiableOn ℂ s_t (U_lower n) :=
      (hs_band₀_holo.mono hU_lower_sub_mid).congr hs_t_lower
    have hs_t_holo_base : DifferentiableOn ℂ s_t (U_base_phys n) :=
      (E.𝔰_holo.mono hU_base_sub_T).congr hs_t_base
    have hs_t_holo : DifferentiableOn ℂ s_t (U_phys n) :=
      hs_t_holo_upper.union_of_isOpen
        (hs_t_holo_lower.union_of_isOpen hs_t_holo_base hU_lower_open hU_base_open)
        hU_upper_open (hU_lower_open.union hU_base_open)

    clear_value s_t
    clear hs_t_holo_upper hs_t_holo_lower hs_t_holo_base
      hU_upper_open hU_lower_open hU_base_open

    
    let s_n : ℂ := (seq.x_seq n : ℂ) + (seq.h_seq n : ℂ) * Complex.I
    let coneSet : Set (ℂ × ℂ) :=
      { p : ℂ × ℂ |
        D_anc < -p.1.im ∧ -p.1.im < D_top ∧
        |p.1.re| < A * (-p.1.im) ∧ ‖p.2‖ < T_max }
    have h_cone_maps_upper : ∀ Y T : ℂ,
        D_anc < -Y.im → -Y.im < D_top → |Y.re| < A * (-Y.im) → ‖T‖ < 2 * T_max →
        (s_n + (seq.ℓ_seq n : ℂ) * Y, T / (seq.m_seq n : ℂ)) ∈ U_upper n := by
      intro Y T hY_lo hY_hi hY_re hT_lt
      have hy_re : (s_n + (seq.ℓ_seq n : ℂ) * Y).re = seq.x_seq n + seq.ℓ_seq n * Y.re := by
        simp [s_n]
      have hy_im : (s_n + (seq.ℓ_seq n : ℂ) * Y).im = seq.h_seq n + seq.ℓ_seq n * Y.im := by
        simp [s_n]
      have hδ_eq : seq.h_seq n - (s_n + (seq.ℓ_seq n : ℂ) * Y).im = seq.ℓ_seq n * (-Y.im) := by
        rw [hy_im]; ring
      have ht_norm : ‖T / (seq.m_seq n : ℂ)‖ < R_phys n := by
        dsimp [R_phys]
        rw [norm_div, Complex.norm_real, Real.norm_of_nonneg hm_pos.le]
        exact div_lt_div_of_pos_right hT_lt hm_pos
      have hd_lt : d_seq n < seq.h_seq n - (s_n + (seq.ℓ_seq n : ℂ) * Y).im := by
        rw [hδ_eq]; dsimp [d_seq]
        nlinarith only [hY_lo, hD_anc_pos, hℓ_pos]
      have hhi_lt : seq.h_seq n - (s_n + (seq.ℓ_seq n : ℂ) * Y).im < 2 * δ₀ n := by
        rw [hδ_eq]
        dsimp [δ₀]
        rw [← mul_div_assoc, lt_div_iff₀ hK₀_pos,
          show seq.ℓ_seq n * -Y.im * K₀ = (K₀ * (-Y.im)) * seq.ℓ_seq n by ring]
        have h1 : K₀ * (-Y.im) < 4 * K₀ * (D_top + 4) := by
          nlinarith only [hY_hi, hK₀_pos, hD_top, hD_anc_pos]
        have h2 : (K₀ * (-Y.im)) * seq.ℓ_seq n < 4 * K₀ * (D_top + 4) * seq.ℓ_seq n :=
          mul_lt_mul_of_pos_right h1 hℓ_pos
        linarith only [h2, hh_ge_top, hh_pos]
      have hre_lt :
          |(s_n + (seq.ℓ_seq n : ℂ) * Y).re - seq.x_seq n| <
            m₀ * (seq.h_seq n - (s_n + (seq.ℓ_seq n : ℂ) * Y).im) := by
        have h_sub : (s_n + (seq.ℓ_seq n : ℂ) * Y).re - seq.x_seq n = seq.ℓ_seq n * Y.re := by
          rw [hy_re]; ring
        rw [h_sub, abs_mul, abs_of_pos hℓ_pos, hδ_eq]
        have hY_pos : 0 < -Y.im := lt_trans hD_anc_pos hY_lo
        have h2 : A < m₀ := by dsimp [m₀]; linarith only [hA]
        calc seq.ℓ_seq n * |Y.re|
            < seq.ℓ_seq n * (A * (-Y.im)) := mul_lt_mul_of_pos_left hY_re hℓ_pos
          _ < seq.ℓ_seq n * (m₀ * (-Y.im)) :=
              mul_lt_mul_of_pos_left (mul_lt_mul_of_pos_right h2 hY_pos) hℓ_pos
          _ = m₀ * (seq.ℓ_seq n * (-Y.im)) := by ring
      exact ⟨ht_norm, hd_lt, hhi_lt, hre_lt⟩

    refine ⟨s_t, hU_phys_open, by dsimp [δ_base]; positivity, ?_, ?_, hs_t_holo,
      fun _ _ => Set.mem_univ _, ?_, ?_, ?_, ?_, ?_⟩
    · 
      intro y t hyt _ τ hτ_lo hτ_hi
      have hy'_re : ((y.re : ℂ) + (τ : ℂ) * Complex.I).re = y.re := by simp
      have hy'_im : ((y.re : ℂ) + (τ : ℂ) * Complex.I).im = τ := by simp
      rcases hyt with h_up | h_lo | h_base
      · by_cases h_split : seq.h_seq n - ((y.re : ℂ) + (τ : ℂ) * Complex.I).im < 2 * δ₀ n
        · left
          refine ⟨h_up.1, ?_, h_split, ?_⟩
          · have h_up_lo := h_up.2.1
            rw [hy'_im]; linarith only [h_up_lo, hτ_hi]
          · rw [hy'_re, hy'_im]
            exact lt_of_lt_of_le h_up.2.2.2
              (mul_le_mul_of_nonneg_left (by linarith only [hτ_hi]) hm₀_pos.le)
        · right; left
          refine ⟨h_up.1, ?_, ?_, ?_⟩
          · linarith only [h_split, hδ₀_pos]
          · rw [hy'_im]; linarith only [hτ_lo, hδ_seed_pos]
          · rw [hy'_re, hy'_im]
            exact lt_of_lt_of_le h_up.2.2.2
              (mul_le_mul_of_nonneg_left (by linarith only [hτ_hi]) hm₀_pos.le)
      · right; left
        refine ⟨h_lo.1, ?_, ?_, ?_⟩
        · have h_lo_1 := h_lo.2.1
          rw [hy'_im]; linarith only [h_lo_1, hτ_hi]
        · rw [hy'_im]; linarith only [hτ_lo, hδ_seed_pos]
        · rw [hy'_re, hy'_im]
          exact lt_of_lt_of_le h_lo.2.2.2
            (mul_le_mul_of_nonneg_left (by linarith only [hτ_hi]) hm₀_pos.le)
      · right; right
        refine ⟨h_base.1, ?_⟩
        have hb2 := (abs_lt.mp h_base.2).2
        rw [hy'_im, abs_of_nonneg hτ_lo]
        linarith only [hτ_hi, hb2]
    · 
      intro y t hyt
      rcases hyt with h_up | h_lo | h_base
      · left; simpa [U_upper] using h_up
      · right; left; simpa [U_lower] using h_lo
      · right; right; simpa [U_base_phys] using h_base
    · 
      intro y t hyt
      rcases hyt with h_up | h_lo | h_base
      · have h_up_neg : (y, -t) ∈ U_upper n := by simpa [U_upper] using h_up
        rw [hs_t_upper (y, -t) h_up_neg, hs_t_upper (y, t) h_up]
        exact (hs_cone_props y t (hU_upper_sub_out h_up)).1
      · have h_lo_neg : (y, -t) ∈ U_lower n := by simpa [U_lower] using h_lo
        rw [hs_t_lower (y, -t) h_lo_neg, hs_t_lower (y, t) h_lo]
        exact (hs_band₀_props y t (hU_lower_sub_mid h_lo)).1
      · have h_base_neg : (y, -t) ∈ U_base_phys n := by simpa [U_base_phys] using h_base
        rw [hs_t_base (y, -t) h_base_neg, hs_t_base (y, t) h_base]
        exact E.𝔰_even y t (hU_base_sub_T h_base)
    · 
      intro y t hy_im ht_norm
      have ht_R : ‖t‖ < R_phys n := by
        dsimp [R_phys]
        have hlt : T_max / seq.m_seq n < 2 * T_max / seq.m_seq n :=
          div_lt_div_of_pos_right (by linarith only [hT_max]) hm_pos
        linarith only [ht_norm, hlt]
      have h_mem_base : (y, t) ∈ U_base_phys n := ⟨ht_R, hy_im⟩
      exact ⟨Or.inr (Or.inr h_mem_base), hU_base_sub_T h_mem_base,
        hs_t_base (y, t) h_mem_base⟩
    · 
      intro Y _ hY_lo hY_hi hY_re
      have h0 : (s_n + (seq.ℓ_seq n : ℂ) * Y, (0 : ℂ)) ∈ U_upper n := by
        simpa using h_cone_maps_upper Y 0 hY_lo hY_hi hY_re (by simp; positivity)
      rw [hs_t_upper _ h0]
      exact hs_cone_zero _ (hU_upper_sub_out h0)
    · 
      intro p hp
      rcases hp with ⟨hY_lo, hY_hi, hY_re, hT_lt⟩
      have hp_up : (s_n + (seq.ℓ_seq n : ℂ) * p.1, p.2 / (seq.m_seq n : ℂ)) ∈ U_upper n :=
        h_cone_maps_upper p.1 p.2 hY_lo hY_hi hY_re (by linarith only [hT_lt, hT_max])
      refine ⟨Or.inl hp_up, ?_, ?_⟩
      · have him : (s_n + (seq.ℓ_seq n : ℂ) * p.1).im =
            seq.h_seq n + seq.ℓ_seq n * p.1.im := by simp [s_n]
        rw [him]
        have h1 : seq.ℓ_seq n * (-p.1.im) < D_top * seq.ℓ_seq n := by
          nlinarith only [hY_hi, hℓ_pos]
        have h2 : D_top * seq.ℓ_seq n < 4 * K₀ * (D_top + 4) * seq.ℓ_seq n := by
          have h2a : D_top < 4 * K₀ * (D_top + 4) := by
            nlinarith only [hK₀_gt_32, hD_top, hD_anc_pos]
          exact mul_lt_mul_of_pos_right h2a hℓ_pos
        linarith only [h1, h2, hh_ge_top]
      · let y : ℂ := s_n + (seq.ℓ_seq n : ℂ) * p.1
        let t : ℂ := p.2 / (seq.m_seq n : ℂ)
        change ‖(s_t (y, t) - s_n) / (seq.ℓ_seq n : ℂ) - p.1‖ ≤
          C_anc * ‖p.2‖ ^ 2 * (-p.1.im) ^ (1 - 2 * α₀)
        rw [hs_t_upper (y, t) hp_up]
        have h_sub_eq :
            (s_cone (y, t) - s_n) / (seq.ℓ_seq n : ℂ) - p.1 =
              (s_cone (y, t) - y) / (seq.ℓ_seq n : ℂ) := by
          have hℓ_c_ne : (seq.ℓ_seq n : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hℓ_pos.ne'
          dsimp [y]
          field_simp [hℓ_c_ne]
          ring
        rw [h_sub_eq, norm_div, Complex.norm_real, Real.norm_of_nonneg hℓ_pos.le]
        have h_disp := (hs_cone_props y t (hU_upper_sub_out hp_up)).2
        have hδ_eq : seq.h_seq n - y.im = seq.ℓ_seq n * (-p.1.im) := by simp [y, s_n]
        have ht_sq : ‖t‖ ^ 2 = ‖p.2‖ ^ 2 / (seq.m_seq n) ^ 2 := by
          dsimp [t]
          rw [norm_div, Complex.norm_real, Real.norm_of_nonneg hm_pos.le, div_pow]
        have hY_pos : 0 < -p.1.im := lt_trans hD_anc_pos hY_lo
        have hδ_rpow : (seq.h_seq n - y.im) ^ (1 - 2 * α₀) =
            (seq.ℓ_seq n) ^ (1 - 2 * α₀) * (-p.1.im) ^ (1 - 2 * α₀) := by
          rw [hδ_eq]
          exact Real.mul_rpow hℓ_pos.le hY_pos.le
        have hℓ_pow2 : ((seq.ℓ_seq n) ^ α₀) ^ (2 : ℕ) = (seq.ℓ_seq n) ^ (2 * α₀) := by
          rw [← Real.rpow_natCast ((seq.ℓ_seq n) ^ α₀) 2, ← Real.rpow_mul hℓ_pos.le]
          ring_nf
        have hℓ_sum : (seq.ℓ_seq n) ^ (2 * α₀) * (seq.ℓ_seq n) ^ (1 - 2 * α₀) = seq.ℓ_seq n := by
          rw [← Real.rpow_add hℓ_pos]
          have : 2 * α₀ + (1 - 2 * α₀) = 1 := by ring
          rw [this, Real.rpow_one]
        have hrhs_eq :
            (A_ind * ‖t‖ ^ 2 * M_scale n ^ 2 * (seq.h_seq n - y.im) ^ (1 - 2 * α₀)) /
              seq.ℓ_seq n =
            C_anc * ‖p.2‖ ^ 2 * (-p.1.im) ^ (1 - 2 * α₀) := by
          dsimp [M_scale, C_anc]
          rw [ht_sq, hδ_rpow]
          calc (A_ind * (‖p.2‖ ^ 2 / seq.m_seq n ^ 2) *
                (3 * C_cone * seq.m_seq n * seq.ℓ_seq n ^ α₀) ^ 2 *
                (seq.ℓ_seq n ^ (1 - 2 * α₀) * (-p.1.im) ^ (1 - 2 * α₀))) / seq.ℓ_seq n
              = 9 * A_ind * C_cone ^ 2 * ‖p.2‖ ^ 2 * (-p.1.im) ^ (1 - 2 * α₀) *
                  (seq.m_seq n ^ 2 / seq.m_seq n ^ 2) *
                  ((((seq.ℓ_seq n ^ α₀) ^ (2 : ℕ)) * seq.ℓ_seq n ^ (1 - 2 * α₀)) /
                    seq.ℓ_seq n) := by ring
            _ = 9 * A_ind * C_cone ^ 2 * ‖p.2‖ ^ 2 * (-p.1.im) ^ (1 - 2 * α₀) := by
                rw [div_self (pow_ne_zero 2 hm_pos.ne'), hℓ_pow2, hℓ_sum, div_self hℓ_pos.ne']
                ring
        rw [← hrhs_eq]
        exact div_le_div_of_nonneg_right h_disp hℓ_pos.le
    · 
      intro Y T hT_ne hY_mem _ _
      rcases hY_mem with ⟨hY_lo, hY_hi, hY_re, hT_lt⟩
      have hΩ_rec_eq :
          { p : ℂ × ℂ |
            d_seq n < seq.h_seq n - p.1.im ∧
            seq.h_seq n - p.1.im < 2 * δ₀ n ∧
            |p.1.re - seq.x_seq n| < m₀ * (seq.h_seq n - p.1.im) ∧
            ‖p.2‖ < R_phys n } = U_upper n := by
        ext p
        exact ⟨fun ⟨h1, h2, h3, h4⟩ => ⟨h4, h1, h2, h3⟩,
          fun ⟨h4, h1, h2, h3⟩ => ⟨h1, h2, h3, h4⟩⟩
      have h4d_lt_2δ₀ : 4 * d_seq n < 2 * δ₀ n := by
        dsimp [d_seq, δ₀]
        rw [← mul_div_assoc, lt_div_iff₀ hK₀_pos]
        nlinarith only [hh_ge_anc, hh_pos, hK₀_pos, hD_anc_pos, hℓ_pos]
      let y : ℂ := s_n + (seq.ℓ_seq n : ℂ) * Y
      let t₀ : ℂ := T / (seq.m_seq n : ℂ)
      have hy_re : y.re = seq.x_seq n + seq.ℓ_seq n * Y.re := by simp [y, s_n]
      have hy_im : y.im = seq.h_seq n + seq.ℓ_seq n * Y.im := by simp [y, s_n]
      have hδ_y_eq : seq.h_seq n - y.im = seq.ℓ_seq n * (-Y.im) := by rw [hy_im]; ring
      have hY_pos : 0 < -Y.im := lt_trans hD_anc_pos hY_lo
      have hδ_y_pos : 0 < seq.h_seq n - y.im := by rw [hδ_y_eq]; positivity
      have hδ_y_gt_D : D_anc * seq.ℓ_seq n < seq.h_seq n - y.im := by
        rw [hδ_y_eq]; nlinarith only [hY_lo, hℓ_pos]

      exact hRec_apply (seq.x_seq n) (seq.h_seq n) (d_seq n) (2 * δ₀ n) m₀
        (R_phys n) (M_scale n) (A_ind * M_scale n ^ 2) s_t
        hd_pos h4d_lt_2δ₀ (by linarith only [hm₀_ge_4]) hR_phys_pos hM_pos (by positivity)
        (by
          intro w hw_lo hw_hi
          have hw_ℓ : seq.ℓ_seq n ≤ seq.h_seq n - w.im := by
            dsimp [d_seq] at hw_lo
            nlinarith only [hw_lo, hD_anc_ge_40, hℓ_pos]
          have hw_top : seq.h_seq n - w.im ≤ (3 / 2) * seq.h_seq n := by
            have h3δ₀ : (3 / 2) * (2 * δ₀ n) < (3 / 2) * seq.h_seq n := by
              dsimp [δ₀]
              have hlt32 : seq.h_seq n / K₀ < seq.h_seq n / 32 :=
                div_lt_div_of_pos_left hh_pos (by norm_num) hK₀_gt_32
              linarith only [hlt32, hh_pos]
            linarith only [hw_hi, h3δ₀]
          exact h_shape_scaled w hw_ℓ hw_top)
        (by rw [hΩ_rec_eq]; exact hs_t_holo.mono Set.subset_union_left)
        (by
          intro z t' hzt'
          rw [hΩ_rec_eq] at hzt'
          rw [hs_t_upper (z, t') hzt']
          have h_b := (hs_cone_props z t' (hU_upper_sub_out hzt')).2
          exact le_of_le_of_eq h_b (by ring))
        (by
          intro z t' ht'_steep hz_prev hz_curr hz_next
          rw [hΩ_rec_eq] at hz_prev hz_curr hz_next
          have h_in_dyad : ∀ q ∈ U_upper n, γ_dyad * ‖q.2‖ < q.2.im →
              q ∈ Ω_out ∩ W_steep_dyad := by
            intro q hq hq_im
            have hq_out : q ∈ Ω_out := hU_upper_sub_out hq
            have hδ_q : 0 < seq.h_seq n - q.1.im := lt_trans hd_pos hq.2.1
            have hm_le : m₀ ≤ m_steep_dyad := by
              dsimp [m_steep_dyad, m_aux]
              have hle_m : m₀ ≤ max m₀ ((C_bump + 4) / (D_dip - 1)) := le_max_left _ _
              linarith only [hle_m, hm₀_pos, hC_bump]
            have h2δ₀_lt : 2 * δ₀ n < M_ceil * δ₀ n :=
              mul_lt_mul_of_pos_right (by linarith only [hM_ceil]) hδ₀_pos
            have hq_im_pos : 0 < q.2.im :=
              lt_of_le_of_lt (by positivity) hq_im
            have hq1 := hq.2.1
            have hq_out4 := hq_out.2.2.2
            have hr_pos_q : 0 < r_seq n * ((seq.h_seq n - q.1.im) / d_seq n) ^ α₀ :=
              lt_of_le_of_lt (norm_nonneg _) hq_out4
            refine ⟨hq_out, ?_⟩
            exact ⟨by linarith only [hq1, hd_pos], lt_trans hq.2.2.1 h2δ₀_lt,
              lt_of_lt_of_le hq.2.2.2 (mul_le_mul_of_nonneg_right hm_le hδ_q.le),
              lt_trans hq_out4 (by linarith only [hr_pos_q]),
              by rwa [abs_of_pos hq_im_pos]⟩
          have hp_d := h_in_dyad (z - t', t') hz_prev ht'_steep
          have hc_d := h_in_dyad (z, t') hz_curr ht'_steep
          have hn_d := h_in_dyad (z + t', t') hz_next ht'_steep
          have heq_p : s_t (z - t', t') = s_steep (z - t', t') := by
            rw [hs_t_upper _ hz_prev, hs_cone_steep _ hp_d]
          have heq_c : s_t (z, t') = s_steep (z, t') := by
            rw [hs_t_upper _ hz_curr, hs_cone_steep _ hc_d]
          have heq_n : s_t (z + t', t') = s_steep (z + t', t') := by
            rw [hs_t_upper _ hz_next, hs_cone_steep _ hn_d]
          dsimp only
          rw [heq_p, heq_c, heq_n]
          have ht'_init : γ_init * ‖t'‖ < t'.im :=
            lt_of_le_of_lt (mul_le_mul_of_nonneg_right hγ_init_lt.le (norm_nonneg _)) ht'_steep
          exact hs_steep_rec z t' ht'_init
            (hW_dyad_sub_big hp_d.2) (hW_dyad_sub_big hc_d.2) (hW_dyad_sub_big hn_d.2))
        y t₀
        (by dsimp [d_seq]; linarith only [hδ_y_gt_D])
        (by
          dsimp [δ₀]
          rw [hδ_y_eq, ← mul_div_assoc, lt_div_iff₀ hK₀_pos,
            show (5 / 4) * (seq.ℓ_seq n * -Y.im) * K₀ = ((5 / 4) * K₀ * (-Y.im)) * seq.ℓ_seq n by ring]
          have h1 : (5 / 4) * K₀ * (-Y.im) < 4 * K₀ * (D_top + 4) := by
            nlinarith only [hY_hi, hK₀_pos, hD_top, hD_anc_pos]
          have h2 : ((5 / 4) * K₀ * (-Y.im)) * seq.ℓ_seq n < 4 * K₀ * (D_top + 4) * seq.ℓ_seq n :=
            mul_lt_mul_of_pos_right h1 hℓ_pos
          linarith only [h2, hh_ge_top, hh_pos])
        (by
          have h_sub : y.re - seq.x_seq n = seq.ℓ_seq n * Y.re := by rw [hy_re]; ring
          rw [h_sub, abs_mul, abs_of_pos hℓ_pos, hδ_y_eq]
          have h2 : A < (3 / 4 : ℝ) * m₀ - 1 / 4 := by dsimp [m₀]; linarith only [hA]
          calc seq.ℓ_seq n * |Y.re|
              < seq.ℓ_seq n * (A * (-Y.im)) := mul_lt_mul_of_pos_left hY_re hℓ_pos
            _ < seq.ℓ_seq n * (((3 / 4 : ℝ) * m₀ - 1 / 4) * (-Y.im)) :=
                mul_lt_mul_of_pos_left (mul_lt_mul_of_pos_right h2 hY_pos) hℓ_pos
            _ = ((3 / 4 : ℝ) * m₀ - 1 / 4) * (seq.ℓ_seq n * (-Y.im)) := by ring)
        (div_ne_zero hT_ne (Complex.ofReal_ne_zero.mpr hm_pos.ne'))
        (by
          dsimp [t₀, R_phys]
          rw [norm_div, Complex.norm_real, Real.norm_of_nonneg hm_pos.le]
          have : 2 * T_max / seq.m_seq n / 2 = T_max / seq.m_seq n := by ring
          rw [this]
          exact div_lt_div_of_pos_right hT_lt hm_pos)
        (by
          dsimp [R_phys]
          have h1 : 2 * T_max ≤ (seq.ℓ_seq n / 32) * seq.m_seq n := by
            have heq : (seq.ℓ_seq n / 32) * seq.m_seq n = (seq.ℓ_seq n * seq.m_seq n) / 32 := by ring
            linarith only [heq, hb_ge_64]
          have h2 : 2 * T_max / seq.m_seq n ≤ seq.ℓ_seq n / 32 :=
            (div_le_iff₀ hm_pos).mpr h1
          have h3 : seq.ℓ_seq n < D_anc * seq.ℓ_seq n := by
            nlinarith only [hD_anc_ge_40, hℓ_pos]
          linarith only [h2, h3, hδ_y_gt_D])
        (by
          have hrpow_le : (seq.h_seq n - y.im) ^ (-α₀) ≤ (D_anc * seq.ℓ_seq n) ^ (-α₀) :=
            Real.rpow_le_rpow_of_nonpos (by positivity) hδ_y_gt_D.le (by linarith)
          have hrpow_mul : (D_anc * seq.ℓ_seq n) ^ (-α₀) =
              D_anc ^ (-α₀) * (seq.ℓ_seq n) ^ (-α₀) :=
            Real.mul_rpow hD_anc_pos.le hℓ_pos.le
          have hℓ_cancel : (seq.ℓ_seq n) ^ α₀ * (seq.ℓ_seq n) ^ (-α₀) = 1 := by
            rw [← Real.rpow_add hℓ_pos]; norm_num
          calc 4 * R_phys n * M_scale n * (seq.h_seq n - y.im) ^ (-α₀)
              ≤ 4 * R_phys n * M_scale n * (D_anc * seq.ℓ_seq n) ^ (-α₀) :=
                mul_le_mul_of_nonneg_left hrpow_le (by positivity)
            _ = 24 * T_max * C_cone * D_anc ^ (-α₀) := by
                dsimp [R_phys, M_scale]
                rw [hrpow_mul]
                calc 4 * (2 * T_max / seq.m_seq n) *
                      (3 * C_cone * seq.m_seq n * seq.ℓ_seq n ^ α₀) *
                      (D_anc ^ (-α₀) * seq.ℓ_seq n ^ (-α₀))
                    = 24 * T_max * C_cone * D_anc ^ (-α₀) *
                        (seq.m_seq n / seq.m_seq n) *
                        (seq.ℓ_seq n ^ α₀ * seq.ℓ_seq n ^ (-α₀)) := by ring
                  _ = 24 * T_max * C_cone * D_anc ^ (-α₀) := by
                      rw [div_self hm_pos.ne', hℓ_cancel]; ring
            _ ≤ P.η_sf := hD_anc_B₂)
        (by
          have hrpow_le : (seq.h_seq n - y.im) ^ (-2 * α₀) ≤ (D_anc * seq.ℓ_seq n) ^ (-2 * α₀) :=
            Real.rpow_le_rpow_of_nonpos (by positivity) hδ_y_gt_D.le (by linarith)
          have hrpow_mul : (D_anc * seq.ℓ_seq n) ^ (-2 * α₀) =
              D_anc ^ (-2 * α₀) * (seq.ℓ_seq n) ^ (-2 * α₀) :=
            Real.mul_rpow hD_anc_pos.le hℓ_pos.le
          have hℓ_pow2 : ((seq.ℓ_seq n) ^ α₀) ^ (2 : ℕ) = (seq.ℓ_seq n) ^ (2 * α₀) := by
            rw [← Real.rpow_natCast ((seq.ℓ_seq n) ^ α₀) 2, ← Real.rpow_mul hℓ_pos.le]
            ring_nf
          have hℓ_cancel : (seq.ℓ_seq n) ^ (2 * α₀) * (seq.ℓ_seq n) ^ (-2 * α₀) = 1 := by
            rw [← Real.rpow_add hℓ_pos]; norm_num
          calc 64 * (A_ind * M_scale n ^ 2) * R_phys n ^ 2 * (seq.h_seq n - y.im) ^ (-2 * α₀)
              ≤ 64 * (A_ind * M_scale n ^ 2) * R_phys n ^ 2 * (D_anc * seq.ℓ_seq n) ^ (-2 * α₀) :=
                mul_le_mul_of_nonneg_left hrpow_le (by positivity)
            _ = 256 * C_anc * T_max ^ 2 * D_anc ^ (-2 * α₀) := by
                dsimp [R_phys, M_scale, C_anc]
                rw [hrpow_mul]
                calc 64 * (A_ind * (3 * C_cone * seq.m_seq n * seq.ℓ_seq n ^ α₀) ^ 2) *
                      (2 * T_max / seq.m_seq n) ^ 2 *
                      (D_anc ^ (-2 * α₀) * seq.ℓ_seq n ^ (-2 * α₀))
                    = 256 * (9 * A_ind * C_cone ^ 2) * T_max ^ 2 * D_anc ^ (-2 * α₀) *
                        (seq.m_seq n ^ 2 / seq.m_seq n ^ 2) *
                        (((seq.ℓ_seq n ^ α₀) ^ (2 : ℕ)) * seq.ℓ_seq n ^ (-2 * α₀)) := by ring
                  _ = 256 * (9 * A_ind * C_cone ^ 2) * T_max ^ 2 * D_anc ^ (-2 * α₀) := by
                      rw [div_self (pow_ne_zero 2 hm_pos.ne'), hℓ_pow2, hℓ_cancel]; ring
            _ ≤ 1 / 16 := hD_anc_B₃)

  classical
  let s_tilde : ℕ → ℂ × ℂ → ℂ := fun n =>
    if hn : n ≥ N_init then Classical.choose (h_exists_n n hn) else E.𝔰
  refine ⟨N_init, U_phys, s_tilde, δ_base, fun n hn => ?_⟩
  have h_spec := Classical.choose_spec (h_exists_n n hn)
  have hs_eq : s_tilde n = Classical.choose (h_exists_n n hn) := by simp [s_tilde, hn]
  rw [hs_eq]
  exact h_spec

theorem dfmc_frozen_kernel_and_legendre_calculus (kind : ExpProfileKind) :
    Nonempty (DfmcFrozenKernelData kind) :=
by
  let B1 : Set ℂ := Metric.ball (0 : ℂ) 1
  
  have hCosh : ∀ u ∈ B1, Complex.cosh u ≠ 0 := by
    intro u hu h_zero
    have hu_lt : ‖u‖ < 1 := by simpa [B1, Metric.mem_ball, dist_zero_right] using hu
    have hcos : Complex.cos (u * Complex.I) = 0 := by
      rw [Complex.cos_mul_I]
      exact h_zero
    obtain ⟨k, hk⟩ := Complex.cos_eq_zero_iff.mp hcos
    let r : ℝ := (2 * (k : ℝ) + 1) * Real.pi / 2
    have hk_real : u * Complex.I = (r : ℂ) := by
      rw [hk]
      dsimp [r]
      push_cast
      ring
    have hnorm := congrArg norm hk_real
    rw [norm_mul, Complex.norm_I, mul_one, Complex.norm_real, Real.norm_eq_abs] at hnorm
    have hpi : 3 < Real.pi := Real.pi_gt_three
    have hr_gt_one : 1 < |r| := by
      rcases le_or_gt 0 k with hk0 | hk0
      · have hk_nonneg : (0 : ℝ) ≤ (k : ℝ) := by exact_mod_cast hk0
        have hr_gt : 1 < r := by dsimp [r]; nlinarith
        exact lt_of_lt_of_le hr_gt (le_abs_self r)
      · have hk_le : k ≤ -1 := by omega
        have hk_le' : (k : ℝ) ≤ -1 := by exact_mod_cast hk_le
        have hr_lt : r < -1 := by dsimp [r]; nlinarith
        exact lt_of_lt_of_le (by linarith) (neg_le_abs r)
    linarith
  
  have hEntireSeries : ∀ (c : ℕ → ℂ),
      (∀ m : ℕ, ‖c m‖ ≤ 1 / (m.factorial : ℝ)) →
      Differentiable ℂ (fun z : ℂ => ∑' m : ℕ, c m * z ^ m) ∧
        (∑' m : ℕ, c m * (0 : ℂ) ^ m) = c 0 := by
    intro c hc
    have h_zero : (∑' m : ℕ, c m * (0 : ℂ) ^ m) = c 0 := by
      rw [tsum_eq_single 0]
      · simp
      · intro m hm
        simp [zero_pow hm]
    refine ⟨fun z₀ => ?_, h_zero⟩
    let R : ℝ := ‖z₀‖ + 1
    have hR1 : 1 ≤ R := by dsimp [R]; linarith [norm_nonneg z₀]
    have hR_pos : 0 < R := lt_of_lt_of_le zero_lt_one hR1
    let g : ℕ → ℂ → ℂ := fun m w => c m * w ^ m
    let g' : ℕ → ℂ → ℂ := fun m w =>
      match m with
      | 0 => 0
      | k + 1 => c (k + 1) * (((k + 1 : ℕ) : ℂ) * w ^ k)
    let u : ℕ → ℝ := fun m => (2 * R) ^ m / (m.factorial : ℝ)
    have hu_sum : Summable u := Real.summable_pow_div_factorial (2 * R)
    have hg_deriv : ∀ m : ℕ, ∀ y ∈ Metric.ball (0 : ℂ) R, HasDerivAt (g m) (g' m y) y := by
      intro m y _
      cases m with
      | zero =>
        dsimp [g, g']
        simpa using hasDerivAt_const y (c 0 * 1)
      | succ k =>
        dsimp [g, g']
        simpa using (hasDerivAt_pow (k + 1) y).const_mul (c (k + 1))
    have hg'_bound : ∀ m : ℕ, ∀ y ∈ Metric.ball (0 : ℂ) R, ‖g' m y‖ ≤ u m := by
      intro m y hy
      have hy_le : ‖y‖ ≤ R := le_of_lt (by simpa [Metric.mem_ball, dist_zero_right] using hy)
      cases m with
      | zero =>
        simp [g', u]
      | succ k =>
        dsimp [g', u]
        rw [norm_mul, norm_mul, norm_pow, Complex.norm_natCast]
        have hyk : ‖y‖ ^ k ≤ R ^ (k + 1) :=
          le_trans (pow_le_pow_left₀ (norm_nonneg y) hy_le k)
            (pow_le_pow_right₀ hR1 (Nat.le_succ k))
        have hk2 : ((k + 1 : ℕ) : ℝ) ≤ (2 : ℝ) ^ (k + 1) := by
          exact_mod_cast le_of_lt (Nat.lt_two_pow_self (n := k + 1))
        have hprod : ((k + 1 : ℕ) : ℝ) * ‖y‖ ^ k ≤ (2 * R) ^ (k + 1) := by
          calc ((k + 1 : ℕ) : ℝ) * ‖y‖ ^ k
              ≤ (2 : ℝ) ^ (k + 1) * R ^ (k + 1) :=
                mul_le_mul hk2 hyk (by positivity) (by positivity)
            _ = (2 * R) ^ (k + 1) := by rw [mul_pow]
        calc ‖c (k + 1)‖ * (((k + 1 : ℕ) : ℝ) * ‖y‖ ^ k)
            ≤ (1 / ((k + 1).factorial : ℝ)) * (2 * R) ^ (k + 1) :=
              mul_le_mul (hc (k + 1)) hprod (by positivity) (by positivity)
          _ = (2 * R) ^ (k + 1) / ((k + 1).factorial : ℝ) := one_div_mul_eq_div _ _
    have hg0_sum : Summable (fun m : ℕ => g m 0) := by
      refine Summable.of_norm_bounded (Real.summable_pow_div_factorial 0) (fun m => ?_)
      cases m with
      | zero =>
        dsimp [g]
        simpa using hc 0
      | succ k =>
        dsimp [g]
        simp [zero_pow (Nat.succ_ne_zero k)]
    have hz₀_mem : z₀ ∈ Metric.ball (0 : ℂ) R := by
      simp [Metric.mem_ball, dist_zero_right, R]
    have h0_mem : (0 : ℂ) ∈ Metric.ball (0 : ℂ) R := by
      simp [Metric.mem_ball, hR_pos]
    exact (hasDerivAt_tsum_of_isPreconnected hu_sum Metric.isOpen_ball
      (convex_ball (0 : ℂ) R).isPreconnected hg_deriv hg'_bound h0_mem hg0_sum
      hz₀_mem).differentiableAt
  have hExistsPhi : ∃ tildePhi : ℂ → ℂ,
      DifferentiableOn ℂ tildePhi B1 ∧
      (∀ u ∈ B1, tildePhi (-u) = tildePhi u) ∧
      tildePhi 0 = 1 / 24 ∧
      (∀ lam J : ℂ, frozenActionP kind lam J = J ^ 3 * tildePhi (lam * J / 2)) := by
    cases kind with
    | firstField =>
      let cF : ℕ → ℂ := fun m => (-1 : ℂ) ^ m / (4 * ((2 * m + 3).factorial : ℂ))
      have hcF_bound : ∀ m : ℕ, ‖cF m‖ ≤ 1 / (m.factorial : ℝ) := by
        intro m
        dsimp [cF]
        rw [norm_div, norm_pow, norm_neg, norm_one, one_pow, norm_mul,
          Complex.norm_ofNat, Complex.norm_natCast]
        have hm_pos : (0 : ℝ) < (m.factorial : ℝ) := Nat.cast_pos.mpr (Nat.factorial_pos m)
        have hfac_le : m.factorial ≤ 4 * (2 * m + 3).factorial := by
          have h1 : m.factorial ≤ (2 * m + 3).factorial := Nat.factorial_le (by omega)
          omega
        have hfac_le_real : (m.factorial : ℝ) ≤ 4 * ((2 * m + 3).factorial : ℝ) := by
          exact_mod_cast hfac_le
        exact one_div_le_one_div_of_le hm_pos hfac_le_real
      obtain ⟨hSF_diff, hSF_zero⟩ := hEntireSeries cF hcF_bound
      let tildePhi : ℂ → ℂ := fun u => ∑' m : ℕ, cF m * (u ^ 2) ^ m
      refine ⟨tildePhi, ?_, ?_, ?_, ?_⟩
      · exact (hSF_diff.comp (differentiable_id.pow 2)).differentiableOn
      · intro u _
        dsimp [tildePhi]
        simp
      · dsimp [tildePhi]
        rw [sq, zero_mul, hSF_zero]
        dsimp [cF]
        norm_num [Nat.factorial]
      · intro lam J
        dsimp [tildePhi, frozenActionP, cF]
        rw [← tsum_mul_left]
        refine tsum_congr (fun m => ?_)
        have h_pow1 : ((lam * J / 2) ^ 2) ^ m = lam ^ (2 * m) * J ^ (2 * m) / (4 : ℂ) ^ m := by
          calc ((lam * J / 2) ^ 2) ^ m
              = ((lam ^ 2 * J ^ 2) / 4) ^ m := by congr 1; ring
            _ = (lam ^ 2 * J ^ 2) ^ m / (4 : ℂ) ^ m := div_pow _ _ _
            _ = lam ^ (2 * m) * J ^ (2 * m) / (4 : ℂ) ^ m := by
                rw [mul_pow, ← pow_mul, ← pow_mul]
        have h_pow2 : (2 : ℂ) ^ (2 * m + 2) = 4 * (4 : ℂ) ^ m := by
          rw [pow_add, pow_mul]
          ring
        have h_powJ : J ^ (2 * m + 3) = J ^ 3 * J ^ (2 * m) := by
          rw [pow_add]
          ring
        rw [h_pow1, h_pow2, h_powJ, div_mul_div_comm, mul_div_assoc']
        congr 1
        · ring
        · ring
    | secondField =>
      let cQ : ℕ → ℂ := fun m => ((2 * m + 2 : ℕ) : ℂ) / (8 * ((2 * m + 3).factorial : ℂ))
      have hcQ_bound : ∀ m : ℕ, ‖cQ m‖ ≤ 1 / (m.factorial : ℝ) := by
        intro m
        dsimp [cQ]
        rw [norm_div, Complex.norm_natCast, norm_mul, Complex.norm_ofNat, Complex.norm_natCast]
        have hm_pos : (0 : ℝ) < (m.factorial : ℝ) := Nat.cast_pos.mpr (Nat.factorial_pos m)
        have h8_pos : (0 : ℝ) < 8 * ((2 * m + 3).factorial : ℝ) := by
          have : (0 : ℝ) < ((2 * m + 3).factorial : ℝ) :=
            Nat.cast_pos.mpr (Nat.factorial_pos _)
          linarith
        rw [div_le_iff₀ h8_pos, one_div_mul_eq_div, le_div_iff₀ hm_pos]
        have h_nat : (2 * m + 2) * m.factorial ≤ 8 * (2 * m + 3).factorial := by
          have h1 : m.factorial ≤ (2 * m + 2).factorial := Nat.factorial_le (by omega)
          have h2 : (2 * m + 2) * m.factorial ≤ (2 * m + 3) * (2 * m + 2).factorial :=
            Nat.mul_le_mul (by omega) h1
          have h3 : (2 * m + 3).factorial = (2 * m + 3) * (2 * m + 2).factorial :=
            Nat.factorial_succ (2 * m + 2)
          omega
        simpa [one_mul] using (show (((2 * m + 2) * m.factorial : ℕ) : ℝ) ≤
          ((8 * (2 * m + 3).factorial : ℕ) : ℝ) by exact_mod_cast h_nat)
      obtain ⟨hSQ_diff, hSQ_zero⟩ := hEntireSeries cQ hcQ_bound
      let SQ : ℂ → ℂ := fun z => ∑' m : ℕ, cQ m * z ^ m
      let tildePhi : ℂ → ℂ := fun u => SQ (u ^ 2) / Complex.cosh u
      refine ⟨tildePhi, ?_, ?_, ?_, ?_⟩
      · exact ((hSQ_diff.comp (differentiable_id.pow 2)).differentiableOn).div
          Complex.differentiable_cosh.differentiableOn hCosh
      · intro u _
        dsimp [tildePhi]
        rw [neg_sq, Complex.cosh_neg]
      · dsimp [tildePhi, SQ]
        rw [sq, zero_mul, hSQ_zero, Complex.cosh_zero]
        dsimp [cQ]
        norm_num [Nat.factorial]
      · intro lam J
        dsimp [tildePhi, SQ, frozenActionP, cQ]
        rw [← mul_div_assoc, ← tsum_mul_left]
        congr 1
        refine tsum_congr (fun m => ?_)
        have h_pow1 : ((lam * J / 2) ^ 2) ^ m = lam ^ (2 * m) * J ^ (2 * m) / (4 : ℂ) ^ m := by
          calc ((lam * J / 2) ^ 2) ^ m
              = ((lam ^ 2 * J ^ 2) / 4) ^ m := by congr 1; ring
            _ = (lam ^ 2 * J ^ 2) ^ m / (4 : ℂ) ^ m := div_pow _ _ _
            _ = lam ^ (2 * m) * J ^ (2 * m) / (4 : ℂ) ^ m := by
                rw [mul_pow, ← pow_mul, ← pow_mul]
        have h_powJ : J ^ (2 * m + 3) = J ^ 3 * J ^ (2 * m) := by
          rw [pow_add]
          ring
        rw [h_pow1, h_powJ, div_mul_div_comm, mul_div_assoc']
        congr 1
        · ring
        · ring
  obtain ⟨tildePhi, hPhi_holo, hPhi_even, hPhi_zero, hAction⟩ := hExistsPhi
  
  let M_ker : ℂ → ℂ := fun u => 3 * tildePhi u + u * deriv tildePhi u
  let G_ker : ℂ → ℂ := fun u => 12 * (2 * tildePhi u + u * deriv tildePhi u)
  let H_ker : ℂ → ℂ := fun u => 2 * M_ker u + u * deriv M_ker u
  have hPhi'_holo : DifferentiableOn ℂ (deriv tildePhi) B1 :=
    hPhi_holo.deriv Metric.isOpen_ball
  have hM_holo : DifferentiableOn ℂ M_ker B1 :=
    (hPhi_holo.const_mul 3).add (differentiableOn_id.mul hPhi'_holo)
  have hG_holo : DifferentiableOn ℂ G_ker B1 :=
    ((hPhi_holo.const_mul 2).add (differentiableOn_id.mul hPhi'_holo)).const_mul 12
  have hM'_holo : DifferentiableOn ℂ (deriv M_ker) B1 :=
    hM_holo.deriv Metric.isOpen_ball
  have hH_holo : DifferentiableOn ℂ H_ker B1 :=
    (hM_holo.const_mul 2).add (differentiableOn_id.mul hM'_holo)
  have hM_zero : M_ker 0 = 1 / 8 := by
    dsimp [M_ker]
    rw [hPhi_zero]
    norm_num
  have hG_zero : G_ker 0 = 1 := by
    dsimp [G_ker]
    rw [hPhi_zero]
    norm_num
  have hH_zero : H_ker 0 = 1 / 4 := by
    dsimp [H_ker]
    rw [hM_zero]
    norm_num
  have hG_even : ∀ u ∈ B1, G_ker (-u) = G_ker u := by
    intro u hu
    have h_neg_u : -u ∈ B1 := by simpa [B1] using hu
    have h_diff_u : DifferentiableAt ℂ tildePhi u :=
      hPhi_holo.differentiableAt (Metric.isOpen_ball.mem_nhds hu)
    have h_diff_neg_u : DifferentiableAt ℂ tildePhi (-u) :=
      hPhi_holo.differentiableAt (Metric.isOpen_ball.mem_nhds h_neg_u)
    have h_comp : HasDerivAt (fun w : ℂ => tildePhi (-w)) (deriv tildePhi (-u) * (-1)) u :=
      h_diff_neg_u.hasDerivAt.comp u (hasDerivAt_id u).neg
    have h_ev : tildePhi =ᶠ[nhds u] (fun w : ℂ => tildePhi (-w)) :=
      Filter.eventuallyEq_of_mem (Metric.isOpen_ball.mem_nhds hu)
        (fun w hw => (hPhi_even w hw).symm)
    have h_deriv_eq : deriv tildePhi (-u) * (-1) = deriv tildePhi u :=
      (h_comp.congr_of_eventuallyEq h_ev).unique h_diff_u.hasDerivAt
    have h_mul_eq : (-u) * deriv tildePhi (-u) = u * deriv tildePhi u := by
      calc (-u) * deriv tildePhi (-u)
          = u * (deriv tildePhi (-u) * (-1)) := by ring
        _ = u * deriv tildePhi u := by rw [h_deriv_eq]
    dsimp [G_ker]
    rw [hPhi_even u hu, h_mul_eq]
  have h_dJ : ∀ lam J : ℂ, ‖lam * J / 2‖ < 1 →
      deriv (frozenActionP kind lam) J = J ^ 2 * M_ker (lam * J / 2) := by
    intro lam J hu
    have hu_mem : lam * J / 2 ∈ B1 := by simpa [B1, Metric.mem_ball, dist_zero_right] using hu
    have h_phi_at : HasDerivAt tildePhi (deriv tildePhi (lam * J / 2)) (lam * J / 2) :=
      (hPhi_holo.differentiableAt (Metric.isOpen_ball.mem_nhds hu_mem)).hasDerivAt
    have h_lin : HasDerivAt (fun J' : ℂ => lam * J' / 2) (lam * 1 / 2) J :=
      ((hasDerivAt_id J).const_mul lam).div_const 2
    have h_prod : HasDerivAt (fun J' : ℂ => J' ^ 3 * tildePhi (lam * J' / 2))
        ((((3 : ℕ) : ℂ) * J ^ (3 - 1)) * tildePhi (lam * J / 2) +
          J ^ 3 * (deriv tildePhi (lam * J / 2) * (lam * 1 / 2))) J :=
      (hasDerivAt_pow 3 J).mul (h_phi_at.comp J h_lin)
    have h_fn_eq : frozenActionP kind lam = fun J' : ℂ => J' ^ 3 * tildePhi (lam * J' / 2) :=
      funext (hAction lam)
    rw [h_fn_eq, h_prod.deriv]
    dsimp [M_ker]
    ring
  have hEnergy : ∀ lam J : ℂ, ‖lam * J / 2‖ < 1 →
      frozenEnergyE kind lam J = (J ^ 3 / 12) * G_ker (lam * J / 2) := by
    intro lam J hu
    unfold frozenEnergyE
    rw [h_dJ lam J hu, hAction lam J]
    dsimp [M_ker, G_ker]
    ring
  have h_dJJ : ∀ lam J : ℂ, ‖lam * J / 2‖ < 1 →
      deriv (deriv (frozenActionP kind lam)) J = J * H_ker (lam * J / 2) := by
    intro lam J hu
    have hu_mem : lam * J / 2 ∈ B1 := by simpa [B1, Metric.mem_ball, dist_zero_right] using hu
    let W_lam : Set ℂ := { J' : ℂ | ‖lam * J' / 2‖ < 1 }
    have hW_open : IsOpen W_lam :=
      isOpen_lt (continuous_norm.comp ((continuous_const.mul continuous_id).div_const 2))
        continuous_const
    have h_ev : deriv (frozenActionP kind lam) =ᶠ[nhds J]
        fun J' : ℂ => J' ^ 2 * M_ker (lam * J' / 2) :=
      Filter.eventuallyEq_of_mem (hW_open.mem_nhds hu) (fun J' hJ' => h_dJ lam J' hJ')
    have hM_at : HasDerivAt M_ker (deriv M_ker (lam * J / 2)) (lam * J / 2) :=
      (hM_holo.differentiableAt (Metric.isOpen_ball.mem_nhds hu_mem)).hasDerivAt
    have h_lin : HasDerivAt (fun J' : ℂ => lam * J' / 2) (lam * 1 / 2) J :=
      ((hasDerivAt_id J).const_mul lam).div_const 2
    have hM_comp : HasDerivAt (M_ker ∘ fun J' : ℂ => lam * J' / 2)
        (deriv M_ker (lam * J / 2) * (lam * 1 / 2)) J :=
      hM_at.comp J h_lin
    have h_prod : HasDerivAt (fun J' : ℂ => J' ^ 2 * M_ker (lam * J' / 2))
        ((((2 : ℕ) : ℂ) * J ^ (2 - 1)) * M_ker (lam * J / 2) +
          J ^ 2 * (deriv M_ker (lam * J / 2) * (lam * 1 / 2))) J :=
      (hasDerivAt_pow 2 J).mul hM_comp
    rw [(h_prod.congr_of_eventuallyEq h_ev).deriv]
    dsimp [H_ker]
    ring
  have h0_mem_B1 : (0 : ℂ) ∈ B1 := by simp [B1]
  have hH_cont : ContinuousAt H_ker 0 :=
    (hH_holo.differentiableAt (Metric.isOpen_ball.mem_nhds h0_mem_B1)).continuousAt
  obtain ⟨δ_reg, hδ_pos, hδ_ball⟩ :=
    Metric.continuousAt_iff.mp hH_cont (1 / 8) (by norm_num)
  let r_reg : ℝ := min δ_reg 1
  have hr_pos : 0 < r_reg := lt_min hδ_pos zero_lt_one
  have hr_le : r_reg ≤ 1 := min_le_right _ _
  have hReg : ∀ lam J : ℂ, J ≠ 0 → ‖lam * J / 2‖ < r_reg →
      IsRegularFrozenState kind lam J := by
    intro lam J hJ hu_reg
    have hu1 : ‖lam * J / 2‖ < 1 := lt_of_lt_of_le hu_reg (min_le_right _ _)
    have hu_δ : dist (lam * J / 2) 0 < δ_reg := by
      simpa [dist_zero_right] using lt_of_lt_of_le hu_reg (min_le_left _ _)
    have hH_dist : ‖H_ker (lam * J / 2) - 1 / 4‖ < 1 / 8 := by
      have hd := hδ_ball hu_δ
      rwa [hH_zero, dist_eq_norm] at hd
    have hH_ne : H_ker (lam * J / 2) ≠ 0 := by
      intro hH0
      rw [hH0] at hH_dist
      norm_num at hH_dist
    have hdJJ_ne : deriv (deriv (frozenActionP kind lam)) J ≠ 0 := by
      rw [h_dJJ lam J hu1]
      exact mul_ne_zero hJ hH_ne
    have hcosh_ne : Complex.cosh (lam * J / 2) ≠ 0 :=
      hCosh (lam * J / 2) (by simpa [B1, Metric.mem_ball, dist_zero_right] using hu1)
    cases kind with
    | firstField => exact ⟨hJ, hdJJ_ne⟩
    | secondField => exact ⟨hJ, hcosh_ne, hdJJ_ne⟩
  have hHolo2d : ∀ (c₀ T : ℂ),
      DifferentiableOn ℂ
        (fun q : ℂ × ℂ =>
          frozenActionP kind (T * c₀ * Complex.exp (-Complex.I * q.1)) q.2)
        { q : ℂ × ℂ | ‖T * c₀ * Complex.exp (-Complex.I * q.1) * q.2 / 2‖ < 1 } := by
    intro c₀ T
    let U_2d : Set (ℂ × ℂ) :=
      { q : ℂ × ℂ | ‖T * c₀ * Complex.exp (-Complex.I * q.1) * q.2 / 2‖ < 1 }
    let Φ_arg : ℂ × ℂ → ℂ := fun q => T * c₀ * Complex.exp (-Complex.I * q.1) * q.2 / 2
    have hΦ_num_diff : Differentiable ℂ
        (fun q : ℂ × ℂ => T * c₀ * Complex.exp (-Complex.I * q.1) * q.2) :=
      ((differentiable_const (T * c₀)).mul
        (Complex.differentiable_exp.comp
          ((differentiable_const (-Complex.I)).mul differentiable_fst))).mul
        differentiable_snd
    have hΦ_diff : Differentiable ℂ Φ_arg := by
      dsimp [Φ_arg]
      simp_rw [div_eq_mul_inv]
      exact hΦ_num_diff.mul (differentiable_const ((2 : ℂ)⁻¹))
    have h_maps : Set.MapsTo Φ_arg U_2d B1 := by
      intro q hq
      simpa [B1, Metric.mem_ball, dist_zero_right, Φ_arg, U_2d] using hq
    have h_comp : DifferentiableOn ℂ (fun q : ℂ × ℂ => q.2 ^ 3 * tildePhi (Φ_arg q)) U_2d :=
      (differentiable_snd.pow 3).differentiableOn.mul
        (hPhi_holo.comp hΦ_diff.differentiableOn h_maps)
    exact h_comp.congr (fun q _ => hAction (T * c₀ * Complex.exp (-Complex.I * q.1)) q.2)
  
  have hLegendre : ∀ (V : Set ℂ) (S_star : ℂ → ℂ) (c₀ T : ℂ),
      IsOpen V →
      DifferentiableOn ℂ S_star V →
      (∀ Y ∈ V, ‖T * c₀ * Complex.exp (-Complex.I * S_star Y) * deriv S_star Y / 2‖ < 1) →
      (∀ Y ∈ V,
        deriv (fun Y' =>
          deriv (fun J' =>
            frozenActionP kind (T * c₀ * Complex.exp (-Complex.I * S_star Y')) J')
            (deriv S_star Y')) Y =
        deriv (fun S' =>
          frozenActionP kind (T * c₀ * Complex.exp (-Complex.I * S')) (deriv S_star Y))
          (S_star Y)) →
      ∀ Y ∈ V,
        deriv (fun Y' =>
          frozenEnergyE kind (T * c₀ * Complex.exp (-Complex.I * S_star Y'))
            (deriv S_star Y')) Y = 0 := by
    intro V S_star c₀ T hV hS hBall hEL Y hY
    let J_star : ℂ → ℂ := deriv S_star
    let lam_star : ℂ → ℂ := fun Y' => T * c₀ * Complex.exp (-Complex.I * S_star Y')
    let u_star : ℂ → ℂ := fun Y' => lam_star Y' * J_star Y' / 2
    let g : ℂ → ℂ := fun Y' => deriv (frozenActionP kind (lam_star Y')) (J_star Y')
    let h : ℂ → ℂ := fun Y' => frozenActionP kind (lam_star Y') (J_star Y')
    have hJ_holo : DifferentiableOn ℂ J_star V := hS.deriv hV
    have hV_nhds : V ∈ nhds Y := hV.mem_nhds hY
    have hS_deriv : HasDerivAt S_star (J_star Y) Y :=
      (hS.differentiableAt hV_nhds).hasDerivAt
    have hJ_deriv : HasDerivAt J_star (deriv J_star Y) Y :=
      (hJ_holo.differentiableAt hV_nhds).hasDerivAt
    have hlam_deriv : HasDerivAt lam_star
        ((T * c₀) * (Complex.exp (-Complex.I * S_star Y) * (-Complex.I * J_star Y))) Y :=
      ((Complex.hasDerivAt_exp (-Complex.I * S_star Y)).comp Y
        (hS_deriv.const_mul (-Complex.I))).const_mul (T * c₀)
    let u'_val : ℂ :=
      (((T * c₀) * (Complex.exp (-Complex.I * S_star Y) * (-Complex.I * J_star Y))) *
        J_star Y + lam_star Y * deriv J_star Y) / 2
    have hu_deriv : HasDerivAt u_star u'_val Y :=
      (hlam_deriv.mul hJ_deriv).div_const 2
    have hu_Y_mem : u_star Y ∈ B1 := by
      simpa [B1, Metric.mem_ball, dist_zero_right, u_star, lam_star, J_star] using hBall Y hY
    have hPhi_at_uY : HasDerivAt tildePhi (deriv tildePhi (u_star Y)) (u_star Y) :=
      (hPhi_holo.differentiableAt (Metric.isOpen_ball.mem_nhds hu_Y_mem)).hasDerivAt
    have hg_eq_on : ∀ Y' ∈ V, g Y' = (J_star Y') ^ 2 * M_ker (u_star Y') :=
      fun Y' hY' => h_dJ (lam_star Y') (J_star Y') (hBall Y' hY')
    have hg_ev : g =ᶠ[nhds Y] fun Y' : ℂ => (J_star Y') ^ 2 * M_ker (u_star Y') :=
      Filter.eventuallyEq_of_mem hV_nhds hg_eq_on
    have hg_rhs_diff : DifferentiableAt ℂ (fun Y' : ℂ => (J_star Y') ^ 2 * M_ker (u_star Y')) Y :=
      (hJ_deriv.differentiableAt.pow 2).mul
        ((hM_holo.differentiableAt (Metric.isOpen_ball.mem_nhds hu_Y_mem)).comp Y
          hu_deriv.differentiableAt)
    have hg_deriv : HasDerivAt g (deriv g Y) Y :=
      (hg_rhs_diff.congr_of_eventuallyEq hg_ev).hasDerivAt
    have hg_Y : g Y = (J_star Y) ^ 2 * M_ker (u_star Y) := hg_eq_on Y hY
    
    let ν : ℂ → ℂ := fun S' => T * c₀ * Complex.exp (-Complex.I * S') * J_star Y / 2
    have hν_eq : ν (S_star Y) = u_star Y := rfl
    have hν_deriv : HasDerivAt ν
        (((T * c₀) * (Complex.exp (-Complex.I * S_star Y) * (-Complex.I * 1)) *
          J_star Y) / 2) (S_star Y) :=
      ((((Complex.hasDerivAt_exp (-Complex.I * S_star Y)).comp (S_star Y)
        ((hasDerivAt_id (S_star Y)).const_mul (-Complex.I))).const_mul (T * c₀)).mul_const
        (J_star Y)).div_const 2
    have hPhi_at_ν : HasDerivAt tildePhi (deriv tildePhi (u_star Y)) (ν (S_star Y)) := by
      rwa [hν_eq]
    have hRHS_fn : (fun S' : ℂ =>
        frozenActionP kind (T * c₀ * Complex.exp (-Complex.I * S')) (J_star Y)) =
        fun S' : ℂ => (J_star Y) ^ 3 * tildePhi (ν S') :=
      funext (fun S' => hAction (T * c₀ * Complex.exp (-Complex.I * S')) (J_star Y))
    let rhs_val : ℂ :=
      (J_star Y) ^ 3 * (deriv tildePhi (u_star Y) *
        (((T * c₀) * (Complex.exp (-Complex.I * S_star Y) * (-Complex.I * 1)) *
          J_star Y) / 2))
    have hRHS_eq : deriv (fun S' : ℂ =>
        frozenActionP kind (T * c₀ * Complex.exp (-Complex.I * S')) (J_star Y)) (S_star Y) =
        rhs_val := by
      rw [hRHS_fn]
      exact ((hPhi_at_ν.comp (S_star Y) hν_deriv).const_mul ((J_star Y) ^ 3)).deriv
    have hdg_eq : deriv g Y = rhs_val := (hEL Y hY).trans hRHS_eq
    
    have hh_fn : h = fun Y' : ℂ => (J_star Y') ^ 3 * tildePhi (u_star Y') :=
      funext (fun Y' => hAction (lam_star Y') (J_star Y'))
    let h'_val : ℂ :=
      (((3 : ℕ) : ℂ) * (J_star Y) ^ (3 - 1) * deriv J_star Y) * tildePhi (u_star Y) +
        (J_star Y) ^ 3 * (deriv tildePhi (u_star Y) * u'_val)
    have hh_deriv : HasDerivAt h h'_val Y := by
      rw [hh_fn]
      exact (hJ_deriv.fun_pow 3).mul (hPhi_at_uY.comp Y hu_deriv)
    
    have hE_deriv : HasDerivAt (fun Y' : ℂ =>
        frozenEnergyE kind (lam_star Y') (J_star Y'))
        ((deriv J_star Y * g Y + J_star Y * deriv g Y) - h'_val) Y :=
      (hJ_deriv.mul hg_deriv).sub hh_deriv
    have hE_zero_val : (deriv J_star Y * g Y + J_star Y * deriv g Y) - h'_val = 0 := by
      rw [hg_Y, hdg_eq]
      dsimp [M_ker, rhs_val, h'_val, u'_val, u_star, lam_star]
      ring
    rw [hE_zero_val] at hE_deriv
    exact hE_deriv.deriv
  exact
    ⟨{ tildePhi := tildePhi
       G_ker := G_ker
       r_reg := r_reg
       r_reg_pos := hr_pos
       r_reg_le_one := hr_le
       tildePhi_holo := hPhi_holo
       G_ker_holo := hG_holo
       tildePhi_even := hPhi_even
       G_ker_even := hG_even
       tildePhi_zero := hPhi_zero
       G_ker_zero := hG_zero
       action_eq := hAction
       energy_eq := hEnergy
       regular_of_small := hReg
       frozen_action_holo_2d := hHolo2d
       legendre_deriv_zero := hLegendre }⟩

theorem dfmc_analytic_model_and_ode_uniqueness (kind : ExpProfileKind)
    (K_ker : DfmcFrozenKernelData kind) :
    Nonempty (DfmcAnalyticModelPackage kind) :=
by
  
  
  
  have hG_diff0 : DifferentiableAt ℂ K_ker.G_ker 0 :=
    K_ker.G_ker_holo.differentiableAt (Metric.ball_mem_nhds 0 zero_lt_one)
  obtain ⟨δ_G, hδ_G_pos, hδ_G⟩ :=
    Metric.continuousAt_iff.mp hG_diff0.continuousAt (1 / 2) (by norm_num)
  let r₀ : ℝ := min δ_G (K_ker.r_reg / 2)
  have hr₀_pos : 0 < r₀ := lt_min hδ_G_pos (half_pos K_ker.r_reg_pos)
  have hr₀_lt_reg : r₀ < K_ker.r_reg :=
    lt_of_le_of_lt (min_le_right _ _) (half_lt_self K_ker.r_reg_pos)
  have hr₀_lt_one : r₀ < 1 := lt_of_lt_of_le hr₀_lt_reg K_ker.r_reg_le_one
  have hG_slit : ∀ u : ℂ, ‖u‖ < r₀ → K_ker.G_ker u ∈ Complex.slitPlane ∧ K_ker.G_ker u ≠ 0 := by
    intro u hu
    have hu_δ : dist u 0 < δ_G := by
      rw [dist_zero_right]
      exact lt_of_lt_of_le hu (min_le_left _ _)
    have h_dist : ‖K_ker.G_ker u - 1‖ < 1 / 2 := by
      simpa [dist_eq_norm, K_ker.G_ker_zero] using hδ_G hu_δ
    have h_re_abs : |(K_ker.G_ker u - 1).re| ≤ ‖K_ker.G_ker u - 1‖ :=
      Complex.abs_re_le_norm _
    have h_re_pos : 0 < (K_ker.G_ker u).re := by
      rw [abs_le] at h_re_abs
      simp only [Complex.sub_re, Complex.one_re] at h_re_abs
      linarith
    refine ⟨Complex.mem_slitPlane_iff.mpr (Or.inl h_re_pos), ?_⟩
    intro h0
    simp [h0] at h_re_pos

  let g_pos : ℂ → ℂ := fun u => Complex.exp ((1 / 3 : ℂ) * Complex.log (K_ker.G_ker u))
  let g_neg : ℂ → ℂ := fun u => Complex.exp (-(1 / 3 : ℂ) * Complex.log (K_ker.G_ker u))
  have hg_pos_zero : g_pos 0 = 1 := by simp [g_pos, K_ker.G_ker_zero]
  have hg_neg_zero : g_neg 0 = 1 := by simp [g_neg, K_ker.G_ker_zero]
  have hg_pos_even : ∀ u : ℂ, ‖u‖ < r₀ → g_pos (-u) = g_pos u := by
    intro u hu
    have hu1 : u ∈ Metric.ball (0 : ℂ) 1 := by
      rw [Metric.mem_ball, dist_zero_right]
      exact lt_trans hu hr₀_lt_one
    dsimp [g_pos]
    rw [K_ker.G_ker_even u hu1]
  have hg_neg_even : ∀ u : ℂ, ‖u‖ < r₀ → g_neg (-u) = g_neg u := by
    intro u hu
    have hu1 : u ∈ Metric.ball (0 : ℂ) 1 := by
      rw [Metric.mem_ball, dist_zero_right]
      exact lt_trans hu hr₀_lt_one
    dsimp [g_neg]
    rw [K_ker.G_ker_even u hu1]
  have hg_pos_diff : ∀ u : ℂ, ‖u‖ < r₀ → DifferentiableAt ℂ g_pos u := by
    intro u hu
    have hu1 : u ∈ Metric.ball (0 : ℂ) 1 := by
      rw [Metric.mem_ball, dist_zero_right]
      exact lt_trans hu hr₀_lt_one
    have hG_u : DifferentiableAt ℂ K_ker.G_ker u :=
      K_ker.G_ker_holo.differentiableAt (isOpen_ball.mem_nhds hu1)
    have hlog_u : DifferentiableAt ℂ (fun z => Complex.log (K_ker.G_ker z)) u :=
      (Complex.differentiableAt_log (hG_slit u hu).1).comp u hG_u
    exact ((differentiableAt_const _).mul hlog_u).cexp
  have hg_neg_diff : ∀ u : ℂ, ‖u‖ < r₀ → DifferentiableAt ℂ g_neg u := by
    intro u hu
    have hu1 : u ∈ Metric.ball (0 : ℂ) 1 := by
      rw [Metric.mem_ball, dist_zero_right]
      exact lt_trans hu hr₀_lt_one
    have hG_u : DifferentiableAt ℂ K_ker.G_ker u :=
      K_ker.G_ker_holo.differentiableAt (isOpen_ball.mem_nhds hu1)
    have hlog_u : DifferentiableAt ℂ (fun z => Complex.log (K_ker.G_ker z)) u :=
      (Complex.differentiableAt_log (hG_slit u hu).1).comp u hG_u
    exact ((differentiableAt_const _).mul hlog_u).cexp
  have hg_mul_one : ∀ u : ℂ, ‖u‖ < r₀ → g_pos u * g_neg u = 1 := by
    intro u _
    dsimp [g_pos, g_neg]
    rw [← Complex.exp_add]
    have h0 : (1 / 3 : ℂ) * Complex.log (K_ker.G_ker u) +
        -(1 / 3 : ℂ) * Complex.log (K_ker.G_ker u) = 0 := by ring
    rw [h0, Complex.exp_zero]
  have hg_pos_cube : ∀ u : ℂ, ‖u‖ < r₀ → (g_pos u) ^ 3 = K_ker.G_ker u := by
    intro u hu
    dsimp [g_pos]
    rw [← Complex.exp_nat_mul]
    have h3 : ((3 : ℕ) : ℂ) * ((1 / 3 : ℂ) * Complex.log (K_ker.G_ker u)) =
        Complex.log (K_ker.G_ker u) := by
      push_cast
      ring
    rw [h3]
    exact Complex.exp_log (hG_slit u hu).2
  have hg_neg_cube : ∀ u : ℂ, ‖u‖ < r₀ → (g_neg u) ^ 3 * K_ker.G_ker u = 1 := by
    intro u hu
    rw [← hg_pos_cube u hu, ← mul_pow, mul_comm, hg_mul_one u hu, one_pow]

  obtain ⟨δ_g, hδ_g_pos, hδ_g⟩ :=
    Metric.continuousAt_iff.mp (hg_pos_diff 0 (by simpa using hr₀_pos)).continuousAt
      (1 / 6) (by norm_num)
  let r_g : ℝ := min r₀ δ_g
  have hr_g_pos : 0 < r_g := lt_min hr₀_pos hδ_g_pos
  have hg_pos_near : ∀ u : ℂ, ‖u‖ < r_g → ‖g_pos u - 1‖ < 1 / 6 := by
    intro u hu
    have hu_δ : dist u 0 < δ_g := by
      rw [dist_zero_right]
      exact lt_of_lt_of_le hu (min_le_right _ _)
    simpa [dist_eq_norm, hg_pos_zero] using hδ_g hu_δ

  let Ψ : ℂ → ℂ := fun u => (2 * u) * g_pos u
  have hΨ_zero : Ψ 0 = 0 := by simp [Ψ]
  have hΨ_odd : ∀ u : ℂ, ‖u‖ < r_g → Ψ (-u) = -Ψ u := by
    intro u hu
    have hu0 : ‖u‖ < r₀ := lt_of_lt_of_le hu (min_le_left _ _)
    dsimp [Ψ]
    rw [hg_pos_even u hu0]
    ring
  have hΨ_holo : DifferentiableOn ℂ Ψ (Metric.ball 0 r_g) := by
    intro u hu
    rw [Metric.mem_ball, dist_zero_right] at hu
    have hu0 : ‖u‖ < r₀ := lt_of_lt_of_le hu (min_le_left _ _)
    exact (((differentiableAt_const (2 : ℂ)).mul differentiableAt_id).mul
      (hg_pos_diff u hu0)).differentiableWithinAt
  have hΨ_ana : AnalyticAt ℂ Ψ 0 :=
    hΨ_holo.analyticAt (Metric.ball_mem_nhds 0 hr_g_pos)
  have hΨ_hasDeriv0 : HasDerivAt Ψ 2 0 := by
    have h1 : HasDerivAt (fun u : ℂ => 2 * u) (2 * 1) 0 :=
      (hasDerivAt_id (0 : ℂ)).const_mul 2
    have h2 : HasDerivAt g_pos (deriv g_pos 0) 0 :=
      (hg_pos_diff 0 (by simpa using hr₀_pos)).hasDerivAt
    have h3 := h1.mul h2
    convert h3 using 1
    simp [hg_pos_zero]
  have hΨ_deriv_ne : deriv Ψ 0 ≠ 0 := by
    rw [hΨ_hasDeriv0.deriv]
    norm_num
  have hΨ_strict : HasStrictDerivAt Ψ (deriv Ψ 0) 0 := hΨ_ana.hasStrictDerivAt
  let U : ℂ → ℂ := hΨ_strict.localInverse Ψ (deriv Ψ 0) 0 hΨ_deriv_ne
  have hU_ana : AnalyticAt ℂ U 0 := by
    simpa [U, hΨ_zero] using hΨ_ana.analyticAt_localInverse hΨ_deriv_ne
  obtain ⟨δ_L, hδ_L_pos, hδ_L⟩ :=
    Metric.eventually_nhds_iff.mp (hΨ_strict.eventually_left_inverse hΨ_deriv_ne)
  let r_u : ℝ := min r_g δ_L
  have hr_u_pos : 0 < r_u := lt_min hr_g_pos hδ_L_pos
  have hU_left : ∀ u : ℂ, ‖u‖ < r_u → U (Ψ u) = u := by
    intro u hu
    have hu_δ : dist u 0 < δ_L := by
      rw [dist_zero_right]
      exact lt_of_lt_of_le hu (min_le_right _ _)
    exact hδ_L hu_δ
  have hU_zero : U 0 = 0 := by
    have h := hU_left 0 (by simpa using hr_u_pos)
    simpa [hΨ_zero] using h
  have hU_ev : ∀ᶠ lam in nhds (0 : ℂ),
      DifferentiableAt ℂ U lam ∧ Ψ (U lam) = lam ∧ U lam ∈ Metric.ball (0 : ℂ) r_u := by
    have h1 := Complex.analyticAt_iff_eventually_differentiableAt.mp hU_ana
    have h2 : ∀ᶠ lam in nhds (0 : ℂ), Ψ (U lam) = lam := by
      simpa [U, hΨ_zero] using hΨ_strict.eventually_right_inverse hΨ_deriv_ne
    have h3 : ∀ᶠ lam in nhds (0 : ℂ), U lam ∈ Metric.ball (0 : ℂ) r_u :=
      hU_ana.continuousAt.eventually_mem (by rw [hU_zero]; exact Metric.ball_mem_nhds 0 hr_u_pos)
    exact h1.and (h2.and h3)
  obtain ⟨δ_lam, hδ_lam_pos, hδ_lam⟩ := Metric.eventually_nhds_iff.mp hU_ev

  let ρ_J : ℝ := 1 / 6
  have hρ_J_pos : 0 < ρ_J := by norm_num
  have hρ_J_lt : ρ_J < 1 / 4 := by norm_num
  let r_J : ℝ := min δ_lam r_u
  have hr_J_pos : 0 < r_J := lt_min hδ_lam_pos hr_u_pos
  let J_mod : ℂ → ℂ := fun lam => g_neg (U lam)

  have hU_props : ∀ lam : ℂ, ‖lam‖ < r_J →
      DifferentiableAt ℂ U lam ∧ Ψ (U lam) = lam ∧ ‖U lam‖ < r_u := by
    intro lam hlam
    have hd : dist lam 0 < δ_lam := by
      rw [dist_zero_right]
      exact lt_of_lt_of_le hlam (min_le_left _ _)
    rcases hδ_lam hd with ⟨h1, h2, h3⟩
    rw [Metric.mem_ball, dist_zero_right] at h3
    exact ⟨h1, h2, h3⟩
  have hU_odd : ∀ lam : ℂ, ‖lam‖ < r_J → U (-lam) = -U lam := by
    intro lam hlam
    have h_neg_lam : ‖-lam‖ < r_J := by simpa using hlam
    have hu_lt : ‖U lam‖ < r_u := (hU_props lam hlam).2.2
    have hu_g : ‖U lam‖ < r_g := lt_of_lt_of_le hu_lt (min_le_left _ _)
    have h_neg_u : ‖-U lam‖ < r_u := by simpa using hu_lt
    have hΨ_neg : Ψ (-U lam) = -lam := by
      rw [hΨ_odd (U lam) hu_g, (hU_props lam hlam).2.1]
    have hL := hU_left (-U lam) h_neg_u
    rw [hΨ_neg] at hL
    exact hL

  have hJ_mod_zero : J_mod 0 = 1 := by simp [J_mod, hU_zero, hg_neg_zero]
  have hJ_mod_ne : ∀ lam ∈ Metric.ball (0 : ℂ) r_J, J_mod lam ≠ 0 := by
    intro lam _
    exact Complex.exp_ne_zero _
  have hJ_mod_even : ∀ lam ∈ Metric.ball (0 : ℂ) r_J, J_mod (-lam) = J_mod lam := by
    intro lam hlam
    rw [Metric.mem_ball, dist_zero_right] at hlam
    have hu0 : ‖U lam‖ < r₀ :=
      lt_of_lt_of_le (hU_props lam hlam).2.2
        (le_trans (min_le_left _ _) (min_le_left _ _))
    dsimp [J_mod]
    rw [hU_odd lam hlam, hg_neg_even (U lam) hu0]
  have hJ_mod_holo : DifferentiableOn ℂ J_mod (Metric.ball (0 : ℂ) r_J) := by
    intro lam hlam
    rw [Metric.mem_ball, dist_zero_right] at hlam
    have hu0 : ‖U lam‖ < r₀ :=
      lt_of_lt_of_le (hU_props lam hlam).2.2
        (le_trans (min_le_left _ _) (min_le_left _ _))
    exact ((hg_neg_diff (U lam) hu0).comp lam (hU_props lam hlam).1).differentiableWithinAt
  have hJ_mod_energy : ∀ lam ∈ Metric.ball (0 : ℂ) r_J,
      frozenEnergyE kind lam (J_mod lam) = 1 / 12 := by
    intro lam hlam
    rw [Metric.mem_ball, dist_zero_right] at hlam
    set u := U lam
    have hu_u : ‖u‖ < r_u := (hU_props lam hlam).2.2
    have hu0 : ‖u‖ < r₀ :=
      lt_of_lt_of_le hu_u (le_trans (min_le_left _ _) (min_le_left _ _))
    have hΨ_u : Ψ u = lam := (hU_props lam hlam).2.1
    have h_arg : lam * J_mod lam / 2 = u := by
      calc lam * J_mod lam / 2
          = Ψ u * g_neg u / 2 := by rw [hΨ_u]
        _ = (2 * u * g_pos u) * g_neg u / 2 := rfl
        _ = u * (g_pos u * g_neg u) := by ring
        _ = u := by rw [hg_mul_one u hu0, mul_one]
    have hu1 : ‖lam * J_mod lam / 2‖ < 1 := by
      rw [h_arg]
      exact lt_trans hu0 hr₀_lt_one
    rw [K_ker.energy_eq lam (J_mod lam) hu1, h_arg]
    have hcube : (J_mod lam) ^ 3 * K_ker.G_ker u = 1 := hg_neg_cube u hu0
    calc ((J_mod lam) ^ 3 / 12) * K_ker.G_ker u
        = ((J_mod lam) ^ 3 * K_ker.G_ker u) / 12 := by ring
      _ = 1 / 12 := by rw [hcube]

  have h_poly_reg : ∀ lam J : ℂ, ‖lam‖ < r_J → ‖J - 1‖ < ρ_J →
      ‖lam * J / 2‖ < 1 ∧ IsRegularFrozenState kind lam J := by
    intro lam J hlam hJ
    have hJ_upper : ‖J‖ < 7 / 6 := by
      have h1' : ‖(J - 1) + 1‖ ≤ ‖J - 1‖ + ‖(1 : ℂ)‖ := norm_add_le (J - 1) 1
      simp only [sub_add_cancel, norm_one] at h1'
      dsimp [ρ_J] at hJ
      linarith
    have hJ_lower : 5 / 6 < ‖J‖ := by
      have h1 : ‖(1 : ℂ)‖ ≤ ‖1 - J‖ + ‖J‖ := by
        simpa using norm_add_le (1 - J) J
      rw [norm_one, norm_sub_rev] at h1
      dsimp [ρ_J] at hJ
      linarith
    have hJ_ne : J ≠ 0 := by
      intro h0
      rw [h0, norm_zero] at hJ_lower
      linarith
    have hu_le_lam : ‖lam * J / 2‖ ≤ ‖lam‖ := by
      rw [norm_div, norm_mul, Complex.norm_ofNat]
      have hlam_nn : 0 ≤ ‖lam‖ := norm_nonneg lam
      nlinarith
    have hu_lt_rJ : ‖lam * J / 2‖ < r_J := lt_of_le_of_lt hu_le_lam hlam
    have hu_lt_r0 : ‖lam * J / 2‖ < r₀ :=
      lt_of_lt_of_le hu_lt_rJ
        (le_trans (min_le_right _ _) (le_trans (min_le_left _ _) (min_le_left _ _)))
    exact ⟨lt_trans hu_lt_r0 hr₀_lt_one,
      K_ker.regular_of_small lam J hJ_ne (lt_trans hu_lt_r0 hr₀_lt_reg)⟩

  have h_root_unique : ∀ lam J : ℂ, ‖lam‖ < r_J → ‖J - 1‖ < ρ_J →
      frozenEnergyE kind lam J = 1 / 12 → J = J_mod lam := by
    intro lam J hlam hJ hE
    have hJ_upper : ‖J‖ < 7 / 6 := by
      have h1 : ‖(J - 1) + 1‖ ≤ ‖J - 1‖ + ‖(1 : ℂ)‖ := norm_add_le (J - 1) 1
      simp only [sub_add_cancel, norm_one] at h1
      dsimp [ρ_J] at hJ
      linarith
    set u' : ℂ := lam * J / 2
    have hu'_le_lam : ‖u'‖ ≤ ‖lam‖ := by
      dsimp [u']
      rw [norm_div, norm_mul, Complex.norm_ofNat]
      have hlam_nn : 0 ≤ ‖lam‖ := norm_nonneg lam
      nlinarith
    have hu'_lt_rJ : ‖u'‖ < r_J := lt_of_le_of_lt hu'_le_lam hlam
    have hu'_lt_ru : ‖u'‖ < r_u := lt_of_lt_of_le hu'_lt_rJ (min_le_right _ _)
    have hu'_lt_rg : ‖u'‖ < r_g := lt_of_lt_of_le hu'_lt_ru (min_le_left _ _)
    have hu'_lt_r0 : ‖u'‖ < r₀ := lt_of_lt_of_le hu'_lt_rg (min_le_left _ _)
    have hu'_lt_1 : ‖u'‖ < 1 := lt_trans hu'_lt_r0 hr₀_lt_one
    have hE_eq := K_ker.energy_eq lam J hu'_lt_1
    rw [hE] at hE_eq
    have h_prod_one : J ^ 3 * K_ker.G_ker u' = 1 := by
      linear_combination -12 * hE_eq
    set ζ : ℂ := J * g_pos u'
    have hζ_cube : ζ ^ 3 = 1 := by
      dsimp [ζ]
      rw [mul_pow, hg_pos_cube u' hu'_lt_r0, h_prod_one]
    have hζ_fac : (ζ - 1) * (ζ ^ 2 + ζ + 1) = 0 := by
      calc (ζ - 1) * (ζ ^ 2 + ζ + 1) = ζ ^ 3 - 1 := by ring
        _ = 0 := by rw [hζ_cube, sub_self]
    have hg_near : ‖g_pos u' - 1‖ < 1 / 6 := hg_pos_near u' hu'_lt_rg
    have hg_norm : ‖g_pos u'‖ < 7 / 6 := by
      have h1 : ‖(g_pos u' - 1) + 1‖ ≤ ‖g_pos u' - 1‖ + ‖(1 : ℂ)‖ :=
        norm_add_le (g_pos u' - 1) 1
      simp only [sub_add_cancel, norm_one] at h1
      linarith
    have hζ_near : ‖ζ - 1‖ < 1 / 2 := by
      have h_split : ζ - 1 = (J - 1) * g_pos u' + (g_pos u' - 1) := by
        dsimp [ζ]
        ring
      rw [h_split]
      have h1 : ‖(J - 1) * g_pos u' + (g_pos u' - 1)‖ ≤
          ‖(J - 1) * g_pos u'‖ + ‖g_pos u' - 1‖ := norm_add_le _ _
      rw [norm_mul] at h1
      dsimp [ρ_J] at hJ
      nlinarith [norm_nonneg (J - 1), norm_nonneg (g_pos u')]
    have h_quad_ne : ζ ^ 2 + ζ + 1 ≠ 0 := by
      intro hq0
      have h_eq3 : (ζ - 1) ^ 2 + 3 * (ζ - 1) = -3 := by
        linear_combination hq0
      have h_norm3 : ‖(ζ - 1) ^ 2 + 3 * (ζ - 1)‖ = 3 := by
        rw [h_eq3]
        norm_num
      have h_tri : ‖(ζ - 1) ^ 2 + 3 * (ζ - 1)‖ ≤ ‖(ζ - 1) ^ 2‖ + ‖3 * (ζ - 1)‖ :=
        norm_add_le _ _
      rw [norm_pow, norm_mul, Complex.norm_ofNat] at h_tri
      nlinarith [norm_nonneg (ζ - 1)]
    have hζ_eq_one : ζ = 1 := by
      rcases mul_eq_zero.mp hζ_fac with h1 | h2
      · exact sub_eq_zero.mp h1
      · exact False.elim (h_quad_ne h2)
    have hΨ_u' : Ψ u' = lam := by
      calc Ψ u' = (2 * (lam * J / 2)) * g_pos u' := rfl
        _ = lam * (J * g_pos u') := by ring
        _ = lam * ζ := rfl
        _ = lam := by rw [hζ_eq_one, mul_one]
    have hu'_eq : u' = U lam := by
      have hL := hU_left u' hu'_lt_ru
      rw [hΨ_u'] at hL
      exact hL.symm
    calc J = J * (g_pos u' * g_neg u') := by rw [hg_mul_one u' hu'_lt_r0, mul_one]
      _ = ζ * g_neg u' := by dsimp [ζ]; ring
      _ = g_neg u' := by rw [hζ_eq_one, one_mul]
      _ = J_mod lam := by dsimp [J_mod]; rw [hu'_eq]

  
  
  
  let f_inv : ℂ → ℂ := fun ξ => (J_mod ξ)⁻¹
  have hf_inv_zero : f_inv 0 = 1 := by simp [f_inv, hJ_mod_zero]
  have hf_inv_even : ∀ ξ ∈ Metric.ball (0 : ℂ) r_J, f_inv (-ξ) = f_inv ξ := by
    intro ξ hξ
    dsimp [f_inv]
    rw [hJ_mod_even ξ hξ]
  have hf_inv_holo : DifferentiableOn ℂ f_inv (Metric.ball (0 : ℂ) r_J) := by
    intro ξ hξ
    exact ((hJ_mod_holo.differentiableAt (isOpen_ball.mem_nhds hξ)).inv
      (hJ_mod_ne ξ hξ)).differentiableWithinAt
  have hf_inv_deriv0 : deriv f_inv 0 = 0 := by
    have hd_pos : HasDerivAt f_inv (deriv f_inv 0) 0 :=
      (hf_inv_holo.differentiableAt (Metric.ball_mem_nhds 0 hr_J_pos)).hasDerivAt
    have hd_pos' : HasDerivAt f_inv (deriv f_inv 0) (-(0 : ℂ)) := by
      rwa [neg_zero]
    have hd_neg : HasDerivAt (fun ξ => f_inv (-ξ)) (deriv f_inv 0 * (-1)) 0 :=
      hd_pos'.comp (0 : ℂ) (hasDerivAt_neg (0 : ℂ))
    have hev : f_inv =ᶠ[nhds (0 : ℂ)] (fun ξ => f_inv (-ξ)) :=
      Filter.eventuallyEq_of_mem (Metric.ball_mem_nhds 0 hr_J_pos)
        (fun ξ hξ => (hf_inv_even ξ hξ).symm)
    have hd_eq : deriv f_inv 0 * (-1) = deriv f_inv 0 :=
      (hd_neg.congr_of_eventuallyEq hev).unique hd_pos
    linear_combination -hd_eq / 2

  let q : ℂ → ℂ := dslope f_inv 0
  have hq_holo : DifferentiableOn ℂ q (Metric.ball (0 : ℂ) r_J) :=
    (Complex.differentiableOn_dslope (Metric.ball_mem_nhds 0 hr_J_pos)).mpr hf_inv_holo
  have hq_zero : q 0 = 0 := by simp [q, dslope_same, hf_inv_deriv0]
  have hq_mul : ∀ ξ : ℂ, ξ * q ξ = f_inv ξ - 1 := by
    intro ξ
    simpa [q, hf_inv_zero] using sub_smul_dslope f_inv 0 ξ
  have hq_odd : ∀ ξ ∈ Metric.ball (0 : ℂ) r_J, q (-ξ) = -q ξ := by
    intro ξ hξ
    by_cases h0 : ξ = 0
    · simp [h0, hq_zero]
    · have h_neg_ne : -ξ ≠ 0 := neg_ne_zero.mpr h0
      have h1 : (-ξ) * q (-ξ) = (-ξ) * (-q ξ) := by
        calc (-ξ) * q (-ξ) = f_inv (-ξ) - 1 := hq_mul (-ξ)
          _ = f_inv ξ - 1 := by rw [hf_inv_even ξ hξ]
          _ = ξ * q ξ := (hq_mul ξ).symm
          _ = (-ξ) * (-q ξ) := by ring
      exact mul_left_cancel₀ h_neg_ne h1

  let r_half : ℝ := r_J / 2
  have hr_half_pos : 0 < r_half := half_pos hr_J_pos
  have hr_half_le : r_half ≤ r_J := half_le_self hr_J_pos.le
  have hcb_sub_q : Metric.closedBall (0 : ℂ) r_half ⊆ Metric.ball (0 : ℂ) r_J :=
    Metric.closedBall_subset_ball (half_lt_self hr_J_pos)

  let q₂ : ℂ → ℂ := dslope q 0
  have hq₂_holo : DifferentiableOn ℂ q₂ (Metric.ball (0 : ℂ) r_J) :=
    (Complex.differentiableOn_dslope (Metric.ball_mem_nhds 0 hr_J_pos)).mpr hq_holo
  obtain ⟨B₁, hB₁⟩ :=
    (isCompact_closedBall (0 : ℂ) r_half).exists_bound_of_continuousOn
      (hq₂_holo.continuousOn.mono hcb_sub_q)
  let M₁ : ℝ := max B₁ 1
  have hM₁_pos : 0 < M₁ := lt_of_lt_of_le zero_lt_one (le_max_right _ _)
  have hq_lin : ∀ z ∈ Metric.closedBall (0 : ℂ) r_half, ‖q z‖ ≤ M₁ * ‖z‖ := by
    intro z hz
    have hmul : z * q₂ z = q z := by
      simpa [q₂, hq_zero] using sub_smul_dslope q 0 z
    rw [← hmul, norm_mul, mul_comm]
    exact mul_le_mul_of_nonneg_right (le_trans (hB₁ z hz) (le_max_left _ _)) (norm_nonneg z)

  have hdq_holo : DifferentiableOn ℂ (deriv q) (Metric.ball (0 : ℂ) r_J) :=
    hq_holo.deriv isOpen_ball
  obtain ⟨B_dq, hB_dq⟩ :=
    (isCompact_closedBall (0 : ℂ) r_half).exists_bound_of_continuousOn
      (hdq_holo.continuousOn.mono hcb_sub_q)
  let M_dq : ℝ := max B_dq 1
  have hM_dq_pos : 0 < M_dq := lt_of_lt_of_le zero_lt_one (le_max_right _ _)
  have hdq_bdd : ∀ z ∈ Metric.closedBall (0 : ℂ) r_half, ‖deriv q z‖ ≤ M_dq :=
    fun z hz => le_trans (hB_dq z hz) (le_max_left _ _)

  let I_prim : ℂ → ℂ := fun lam => ∫ t in (0 : ℝ)..1, lam * q ((t : ℂ) * lam)
  have hI_zero : I_prim 0 = 0 := by simp [I_prim]
  have hI_even : ∀ lam ∈ Metric.ball (0 : ℂ) r_half, I_prim (-lam) = I_prim lam := by
    intro lam hlam
    rw [Metric.mem_ball, dist_zero_right] at hlam
    dsimp [I_prim]
    refine intervalIntegral.integral_congr (fun t ht => ?_)
    rw [Set.uIcc_of_le zero_le_one] at ht
    have htl_mem : (t : ℂ) * lam ∈ Metric.ball (0 : ℂ) r_J := by
      rw [Metric.mem_ball, dist_zero_right, norm_mul, Complex.norm_real,
        Real.norm_of_nonneg ht.1]
      have h1 : t * ‖lam‖ ≤ 1 * r_half :=
        mul_le_mul ht.2 hlam.le (norm_nonneg _) zero_le_one
      rw [one_mul] at h1
      exact lt_of_le_of_lt h1 (half_lt_self hr_J_pos)
    have h_neg_arg : (t : ℂ) * (-lam) = -((t : ℂ) * lam) := by ring
    rw [h_neg_arg, hq_odd _ htl_mem]
    ring
  have hI_bound : ∀ lam ∈ Metric.ball (0 : ℂ) r_half, ‖I_prim lam‖ ≤ M₁ * ‖lam‖ ^ 2 := by
    intro lam hlam
    rw [Metric.mem_ball, dist_zero_right] at hlam
    have h_int_le : ∀ t ∈ Set.uIoc (0 : ℝ) 1,
        ‖lam * q ((t : ℂ) * lam)‖ ≤ M₁ * ‖lam‖ ^ 2 := by
      intro t ht
      rw [Set.uIoc_of_le zero_le_one] at ht
      have ht_pos : 0 ≤ t := ht.1.le
      have htl_cb : (t : ℂ) * lam ∈ Metric.closedBall (0 : ℂ) r_half := by
        rw [Metric.mem_closedBall, dist_zero_right, norm_mul, Complex.norm_real,
          Real.norm_of_nonneg ht_pos]
        nlinarith [ht.2, norm_nonneg lam]
      have hq_le := hq_lin _ htl_cb
      rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg ht_pos] at hq_le
      rw [norm_mul]
      calc ‖lam‖ * ‖q ((t : ℂ) * lam)‖
          ≤ ‖lam‖ * (M₁ * (t * ‖lam‖)) :=
            mul_le_mul_of_nonneg_left hq_le (norm_nonneg lam)
        _ = (M₁ * ‖lam‖ ^ 2) * t := by ring
        _ ≤ (M₁ * ‖lam‖ ^ 2) * 1 :=
            mul_le_mul_of_nonneg_left ht.2 (by positivity)
        _ = M₁ * ‖lam‖ ^ 2 := mul_one _
    have h_norm := intervalIntegral.norm_integral_le_of_norm_le_const h_int_le
    simpa [I_prim] using h_norm

  have hI_hasDeriv : ∀ lam₀ ∈ Metric.ball (0 : ℂ) r_half,
      HasDerivAt I_prim (q lam₀) lam₀ := by
    intro lam₀ hlam₀
    let F : ℂ → ℝ → ℂ := fun x t => x * q ((t : ℂ) * x)
    let F' : ℂ → ℝ → ℂ := fun x t =>
      q ((t : ℂ) * x) + x * (deriv q ((t : ℂ) * x) * (t : ℂ))
    have h_maps_cb : ∀ x ∈ Metric.ball (0 : ℂ) r_half,
        Set.MapsTo (fun t : ℝ => (t : ℂ) * x) (Set.uIcc 0 1)
          (Metric.closedBall (0 : ℂ) r_half) := by
      intro x hx t ht
      rw [Set.uIcc_of_le zero_le_one] at ht
      rw [Metric.mem_ball, dist_zero_right] at hx
      rw [Metric.mem_closedBall, dist_zero_right, norm_mul, Complex.norm_real,
        Real.norm_of_nonneg ht.1]
      nlinarith [ht.2, norm_nonneg x]
    have hF_cont : ∀ x ∈ Metric.ball (0 : ℂ) r_half,
        ContinuousOn (F x) (Set.uIcc 0 1) := by
      intro x hx
      have h_lin_cont : Continuous (fun t : ℝ => (t : ℂ) * x) :=
        Complex.continuous_ofReal.mul continuous_const
      have hq_comp : ContinuousOn (fun t : ℝ => q ((t : ℂ) * x)) (Set.uIcc 0 1) :=
        (hq_holo.continuousOn.mono hcb_sub_q).comp h_lin_cont.continuousOn (h_maps_cb x hx)
      exact continuousOn_const.mul hq_comp
    have hF'_cont : ContinuousOn (F' lam₀) (Set.uIcc 0 1) := by
      have h_lin_cont : Continuous (fun t : ℝ => (t : ℂ) * lam₀) :=
        Complex.continuous_ofReal.mul continuous_const
      have hq_comp : ContinuousOn (fun t : ℝ => q ((t : ℂ) * lam₀)) (Set.uIcc 0 1) :=
        (hq_holo.continuousOn.mono hcb_sub_q).comp h_lin_cont.continuousOn
          (h_maps_cb lam₀ hlam₀)
      have hdq_comp : ContinuousOn (fun t : ℝ => deriv q ((t : ℂ) * lam₀)) (Set.uIcc 0 1) :=
        (hdq_holo.continuousOn.mono hcb_sub_q).comp h_lin_cont.continuousOn
          (h_maps_cb lam₀ hlam₀)
      exact hq_comp.add
        (continuousOn_const.mul (hdq_comp.mul Complex.continuous_ofReal.continuousOn))
    have h_leibniz :=
      intervalIntegral.hasDerivAt_integral_of_dominated_loc_of_deriv_le
        (μ := MeasureTheory.volume)
        (s := Metric.ball (0 : ℂ) r_half)
        (bound := fun _ : ℝ => M₁ * r_half + r_half * M_dq)
        (F := F) (F' := F') (x₀ := lam₀) (a := 0) (b := 1)
        (isOpen_ball.mem_nhds hlam₀)
        (Filter.eventually_of_mem (isOpen_ball.mem_nhds hlam₀) (fun x hx =>
          ((hF_cont x hx).mono Set.uIoc_subset_uIcc).aestronglyMeasurable measurableSet_uIoc))
        (hF_cont lam₀ hlam₀).intervalIntegrable
        ((hF'_cont.mono Set.uIoc_subset_uIcc).aestronglyMeasurable measurableSet_uIoc)
        (Filter.Eventually.of_forall (fun t ht x hx => by
          have ht_uIcc : t ∈ Set.uIcc (0 : ℝ) 1 := Set.uIoc_subset_uIcc ht
          have htx_cb := h_maps_cb x hx ht_uIcc
          rw [Set.uIcc_of_le zero_le_one] at ht_uIcc
          rw [Metric.mem_ball, dist_zero_right] at hx
          have htx_norm : ‖(t : ℂ) * x‖ ≤ r_half := by
            simpa [Metric.mem_closedBall, dist_zero_right] using htx_cb
          have ht_norm : ‖(t : ℂ)‖ ≤ 1 := by
            rw [Complex.norm_real, Real.norm_of_nonneg ht_uIcc.1]
            exact ht_uIcc.2
          have h1 : ‖q ((t : ℂ) * x)‖ ≤ M₁ * r_half :=
            le_trans (hq_lin _ htx_cb) (mul_le_mul_of_nonneg_left htx_norm hM₁_pos.le)
          have h2 : ‖x * (deriv q ((t : ℂ) * x) * (t : ℂ))‖ ≤ r_half * M_dq := by
            rw [norm_mul, norm_mul]
            have hd := hdq_bdd _ htx_cb
            have hprod : ‖deriv q ((t : ℂ) * x)‖ * ‖(t : ℂ)‖ ≤ M_dq * 1 :=
              mul_le_mul hd ht_norm (norm_nonneg _) hM_dq_pos.le
            have hx_le : ‖x‖ ≤ r_half := hx.le
            nlinarith [norm_nonneg x]
          exact le_trans (norm_add_le _ _) (add_le_add h1 h2)))
        intervalIntegrable_const
        (Filter.Eventually.of_forall (fun t ht x hx => by
          have ht_uIcc : t ∈ Set.uIcc (0 : ℝ) 1 := Set.uIoc_subset_uIcc ht
          have htx_ball : (t : ℂ) * x ∈ Metric.ball (0 : ℂ) r_J :=
            hcb_sub_q (h_maps_cb x hx ht_uIcc)
          have hq_at : HasDerivAt q (deriv q ((t : ℂ) * x)) ((t : ℂ) * x) :=
            (hq_holo.differentiableAt (isOpen_ball.mem_nhds htx_ball)).hasDerivAt
          have h_lin : HasDerivAt (fun x' : ℂ => (t : ℂ) * x') ((t : ℂ) * 1) x :=
            (hasDerivAt_id x).const_mul (t : ℂ)
          have h_comp := hq_at.comp x h_lin
          have h_prod : HasDerivAt (fun x' => F x' t)
              (1 * q ((t : ℂ) * x) + x * (deriv q ((t : ℂ) * x) * ((t : ℂ) * 1))) x :=
            (hasDerivAt_id x).mul h_comp
          have h_eq : 1 * q ((t : ℂ) * x) + x * (deriv q ((t : ℂ) * x) * ((t : ℂ) * 1)) =
              F' x t := by
            dsimp [F']
            ring
          rwa [h_eq] at h_prod))
    have h_ftc : ∫ t in (0 : ℝ)..1, F' lam₀ t = q lam₀ := by
      have h_gamma_deriv : ∀ t ∈ Set.uIcc (0 : ℝ) 1,
          HasDerivAt (fun s : ℝ => (s : ℂ) * q ((s : ℂ) * lam₀)) (F' lam₀ t) t := by
        intro t ht
        have htl_ball : (t : ℂ) * lam₀ ∈ Metric.ball (0 : ℂ) r_J :=
          hcb_sub_q (h_maps_cb lam₀ hlam₀ ht)
        have hq_at : HasDerivAt q (deriv q ((t : ℂ) * lam₀)) ((t : ℂ) * lam₀) :=
          (hq_holo.differentiableAt (isOpen_ball.mem_nhds htl_ball)).hasDerivAt
        have h_lin : HasDerivAt (fun z : ℂ => z * lam₀) (1 * lam₀) (t : ℂ) :=
          (hasDerivAt_id (t : ℂ)).mul_const lam₀
        have h_comp := hq_at.comp (t : ℂ) h_lin
        have h_prod_c : HasDerivAt (fun z : ℂ => z * q (z * lam₀))
            (1 * q ((t : ℂ) * lam₀) +
              (t : ℂ) * (deriv q ((t : ℂ) * lam₀) * (1 * lam₀))) (t : ℂ) :=
          (hasDerivAt_id (t : ℂ)).mul h_comp
        have h_eq_deriv : 1 * q ((t : ℂ) * lam₀) +
            (t : ℂ) * (deriv q ((t : ℂ) * lam₀) * (1 * lam₀)) = F' lam₀ t := by
          dsimp [F']
          ring
        rw [h_eq_deriv] at h_prod_c
        exact h_prod_c.comp_ofReal
      have hint :=
        intervalIntegral.integral_eq_sub_of_hasDerivAt h_gamma_deriv h_leibniz.1
      simpa using hint
    rw [h_ftc] at h_leibniz
    exact h_leibniz.2

  let W : ℂ → ℂ := fun lam => lam * Complex.exp (I_prim lam)
  have hW_zero : W 0 = 0 := by simp [W]
  have hW_odd : ∀ lam ∈ Metric.ball (0 : ℂ) r_half, W (-lam) = -W lam := by
    intro lam hlam
    dsimp [W]
    rw [hI_even lam hlam]
    ring
  have hW_hasDeriv : ∀ lam ∈ Metric.ball (0 : ℂ) r_half,
      HasDerivAt W ((J_mod lam)⁻¹ * Complex.exp (I_prim lam)) lam := by
    intro lam hlam
    have h_exp := (hI_hasDeriv lam hlam).cexp
    have h_prod : HasDerivAt W
        (1 * Complex.exp (I_prim lam) + lam * (Complex.exp (I_prim lam) * q lam)) lam :=
      (hasDerivAt_id lam).mul h_exp
    have hq_eq : 1 + lam * q lam = (J_mod lam)⁻¹ := by
      rw [hq_mul lam]
      dsimp [f_inv]
      ring
    have h_eq : 1 * Complex.exp (I_prim lam) + lam * (Complex.exp (I_prim lam) * q lam) =
        (J_mod lam)⁻¹ * Complex.exp (I_prim lam) := by
      calc 1 * Complex.exp (I_prim lam) + lam * (Complex.exp (I_prim lam) * q lam)
          = (1 + lam * q lam) * Complex.exp (I_prim lam) := by ring
        _ = (J_mod lam)⁻¹ * Complex.exp (I_prim lam) := by rw [hq_eq]
    rwa [h_eq] at h_prod
  have hW_holo_half : DifferentiableOn ℂ W (Metric.ball (0 : ℂ) r_half) :=
    fun lam hlam => (hW_hasDeriv lam hlam).differentiableAt.differentiableWithinAt
  have hW_ode : ∀ lam ∈ Metric.ball (0 : ℂ) r_half,
      lam * J_mod lam * deriv W lam = W lam := by
    intro lam hlam
    rw [(hW_hasDeriv lam hlam).deriv]
    have hJ_ne := hJ_mod_ne lam (Metric.ball_subset_ball hr_half_le hlam)
    calc lam * J_mod lam * ((J_mod lam)⁻¹ * Complex.exp (I_prim lam))
        = lam * (J_mod lam * (J_mod lam)⁻¹) * Complex.exp (I_prim lam) := by ring
      _ = W lam := by rw [mul_inv_cancel₀ hJ_ne, mul_one]

  have hW_ana : AnalyticAt ℂ W 0 :=
    hW_holo_half.analyticAt (Metric.ball_mem_nhds 0 hr_half_pos)
  have hW_deriv0 : deriv W 0 = 1 := by
    rw [(hW_hasDeriv 0 (Metric.mem_ball_self hr_half_pos)).deriv]
    simp [hJ_mod_zero, hI_zero]
  have hW_deriv_ne : deriv W 0 ≠ 0 := by
    rw [hW_deriv0]
    exact one_ne_zero
  have hW_strict : HasStrictDerivAt W (deriv W 0) 0 := hW_ana.hasStrictDerivAt
  let Λ : ℂ → ℂ := hW_strict.localInverse W (deriv W 0) 0 hW_deriv_ne
  have hΛ_ana : AnalyticAt ℂ Λ 0 := by
    simpa [Λ, hW_zero] using hW_ana.analyticAt_localInverse hW_deriv_ne
  obtain ⟨δ_WL, hδ_WL_pos, hδ_WL⟩ :=
    Metric.eventually_nhds_iff.mp (hW_strict.eventually_left_inverse hW_deriv_ne)
  let r_lam : ℝ := min r_half δ_WL
  have hr_lam_pos : 0 < r_lam := lt_min hr_half_pos hδ_WL_pos
  have hr_lam_le_half : r_lam ≤ r_half := min_le_left _ _
  have hr_lam_le_J : r_lam ≤ r_J := le_trans hr_lam_le_half hr_half_le
  have hΛ_left : ∀ lam ∈ Metric.ball (0 : ℂ) r_lam, Λ (W lam) = lam := by
    intro lam hlam
    rw [Metric.mem_ball, dist_zero_right] at hlam
    have hd : dist lam 0 < δ_WL := by
      rw [dist_zero_right]
      exact lt_of_lt_of_le hlam (min_le_right _ _)
    exact hδ_WL hd
  have hΛ_zero : Λ 0 = 0 := by
    have h := hΛ_left 0 (Metric.mem_ball_self hr_lam_pos)
    simpa [hW_zero] using h
  have hΛ_ev : ∀ᶠ w in nhds (0 : ℂ),
      DifferentiableAt ℂ Λ w ∧ W (Λ w) = w ∧ Λ w ∈ Metric.ball (0 : ℂ) r_lam := by
    have h1 := Complex.analyticAt_iff_eventually_differentiableAt.mp hΛ_ana
    have h2 : ∀ᶠ w in nhds (0 : ℂ), W (Λ w) = w := by
      simpa [Λ, hW_zero] using hW_strict.eventually_right_inverse hW_deriv_ne
    have h3 : ∀ᶠ w in nhds (0 : ℂ), Λ w ∈ Metric.ball (0 : ℂ) r_lam :=
      hΛ_ana.continuousAt.eventually_mem
        (by rw [hΛ_zero]; exact Metric.ball_mem_nhds 0 hr_lam_pos)
    exact h1.and (h2.and h3)
  obtain ⟨ρ₀, hρ₀_pos, hρ₀⟩ := Metric.eventually_nhds_iff.mp hΛ_ev

  have hΛ_props : ∀ w ∈ Metric.ball (0 : ℂ) ρ₀,
      DifferentiableAt ℂ Λ w ∧ W (Λ w) = w ∧ Λ w ∈ Metric.ball (0 : ℂ) r_lam := by
    intro w hw
    rw [Metric.mem_ball, dist_zero_right] at hw
    have hd : dist w 0 < ρ₀ := by rwa [dist_zero_right]
    exact hρ₀ hd
  have hΛ_holo₀ : DifferentiableOn ℂ Λ (Metric.ball (0 : ℂ) ρ₀) :=
    fun w hw => (hΛ_props w hw).1.differentiableWithinAt
  have hΛ_odd : ∀ w ∈ Metric.ball (0 : ℂ) ρ₀, Λ (-w) = -Λ w := by
    intro w hw
    have hlam_mem : Λ w ∈ Metric.ball (0 : ℂ) r_lam := (hΛ_props w hw).2.2
    have hlam_half : Λ w ∈ Metric.ball (0 : ℂ) r_half :=
      Metric.ball_subset_ball hr_lam_le_half hlam_mem
    have h_neg_lam : -Λ w ∈ Metric.ball (0 : ℂ) r_lam := by
      simpa using hlam_mem
    have hW_neg : W (-Λ w) = -w := by
      rw [hW_odd (Λ w) hlam_half, (hΛ_props w hw).2.1]
    have hL := hΛ_left (-Λ w) h_neg_lam
    rw [hW_neg] at hL
    exact hL
  have hΛ_deriv_rel : ∀ w ∈ Metric.ball (0 : ℂ) ρ₀,
      ((J_mod (Λ w))⁻¹ * Complex.exp (I_prim (Λ w))) * deriv Λ w = 1 := by
    intro w hw
    have hlam_half : Λ w ∈ Metric.ball (0 : ℂ) r_half :=
      Metric.ball_subset_ball hr_lam_le_half (hΛ_props w hw).2.2
    have h_comp := (hW_hasDeriv (Λ w) hlam_half).comp w (hΛ_props w hw).1.hasDerivAt
    have hev : id =ᶠ[nhds w] (W ∘ Λ) :=
      Filter.eventuallyEq_of_mem (isOpen_ball.mem_nhds hw)
        (fun z hz => ((hΛ_props z hz).2.1).symm)
    exact (h_comp.congr_of_eventuallyEq hev).unique (hasDerivAt_id w)

  let ρ_mod : ℝ := ρ₀ / 2
  have hρ_mod_pos : 0 < ρ_mod := half_pos hρ₀_pos
  have hρ_mod_le : ρ_mod ≤ ρ₀ := half_le_self hρ₀_pos.le
  have hcb_sub_Λ : Metric.closedBall (0 : ℂ) ρ_mod ⊆ Metric.ball (0 : ℂ) ρ₀ :=
    Metric.closedBall_subset_ball (half_lt_self hρ₀_pos)
  let Λ₂ : ℂ → ℂ := dslope Λ 0
  have hΛ₂_holo : DifferentiableOn ℂ Λ₂ (Metric.ball (0 : ℂ) ρ₀) :=
    (Complex.differentiableOn_dslope (Metric.ball_mem_nhds 0 hρ₀_pos)).mpr hΛ_holo₀
  obtain ⟨B_Λ, hB_Λ⟩ :=
    (isCompact_closedBall (0 : ℂ) ρ_mod).exists_bound_of_continuousOn
      (hΛ₂_holo.continuousOn.mono hcb_sub_Λ)
  let M_Λ : ℝ := max B_Λ 1
  have hM_Λ_pos : 0 < M_Λ := lt_of_lt_of_le zero_lt_one (le_max_right _ _)
  have hΛ_lin : ∀ w ∈ Metric.closedBall (0 : ℂ) ρ_mod, ‖Λ w‖ ≤ M_Λ * ‖w‖ := by
    intro w hw
    have hmul : w * Λ₂ w = Λ w := by
      simpa [Λ₂, hΛ_zero] using sub_smul_dslope Λ 0 w
    rw [← hmul, norm_mul, mul_comm]
    exact mul_le_mul_of_nonneg_right (le_trans (hB_Λ w hw) (le_max_left _ _)) (norm_nonneg w)

  let C_Δ : ℝ := max 1 (M₁ * M_Λ ^ 2)
  have hC_Δ_pos : 0 < C_Δ := lt_of_lt_of_le zero_lt_one (le_max_left _ _)
  let Δ₀ : ℂ → ℂ := fun w => -Complex.I * I_prim (Λ w)
  have hΔ₀_zero : Δ₀ 0 = 0 := by simp [Δ₀, hΛ_zero, hI_zero]
  have hΔ₀_hasDeriv : ∀ w ∈ Metric.ball (0 : ℂ) ρ_mod,
      HasDerivAt Δ₀ (-Complex.I * (q (Λ w) * deriv Λ w)) w := by
    intro w hw
    have hw₀ : w ∈ Metric.ball (0 : ℂ) ρ₀ := Metric.ball_subset_ball hρ_mod_le hw
    have hlam_half : Λ w ∈ Metric.ball (0 : ℂ) r_half :=
      Metric.ball_subset_ball hr_lam_le_half (hΛ_props w hw₀).2.2
    exact ((hI_hasDeriv (Λ w) hlam_half).comp w (hΛ_props w hw₀).1.hasDerivAt).const_mul
      (-Complex.I)
  have hΔ₀_holo : DifferentiableOn ℂ Δ₀ (Metric.ball (0 : ℂ) ρ_mod) :=
    fun w hw => (hΔ₀_hasDeriv w hw).differentiableAt.differentiableWithinAt
  have hΔ₀_even : ∀ w ∈ Metric.ball (0 : ℂ) ρ_mod, Δ₀ (-w) = Δ₀ w := by
    intro w hw
    have hw₀ : w ∈ Metric.ball (0 : ℂ) ρ₀ := Metric.ball_subset_ball hρ_mod_le hw
    have hlam_half : Λ w ∈ Metric.ball (0 : ℂ) r_half :=
      Metric.ball_subset_ball hr_lam_le_half (hΛ_props w hw₀).2.2
    dsimp [Δ₀]
    rw [hΛ_odd w hw₀, hI_even (Λ w) hlam_half]
  have hΔ₀_bound : ∀ w ∈ Metric.ball (0 : ℂ) ρ_mod, ‖Δ₀ w‖ ≤ C_Δ * ‖w‖ ^ 2 := by
    intro w hw
    have hw₀ : w ∈ Metric.ball (0 : ℂ) ρ₀ := Metric.ball_subset_ball hρ_mod_le hw
    have hw_cb : w ∈ Metric.closedBall (0 : ℂ) ρ_mod := Metric.ball_subset_closedBall hw
    have hlam_half : Λ w ∈ Metric.ball (0 : ℂ) r_half :=
      Metric.ball_subset_ball hr_lam_le_half (hΛ_props w hw₀).2.2
    have h1 : ‖Δ₀ w‖ = ‖I_prim (Λ w)‖ := by
      dsimp [Δ₀]
      rw [norm_mul, norm_neg, Complex.norm_I, one_mul]
    have h2 : ‖I_prim (Λ w)‖ ≤ M₁ * ‖Λ w‖ ^ 2 := hI_bound (Λ w) hlam_half
    have h3 : ‖Λ w‖ ^ 2 ≤ (M_Λ * ‖w‖) ^ 2 :=
      pow_le_pow_left₀ (norm_nonneg _) (hΛ_lin w hw_cb) 2
    calc ‖Δ₀ w‖ = ‖I_prim (Λ w)‖ := h1
      _ ≤ M₁ * ‖Λ w‖ ^ 2 := h2
      _ ≤ M₁ * (M_Λ * ‖w‖) ^ 2 := mul_le_mul_of_nonneg_left h3 hM₁_pos.le
      _ = (M₁ * M_Λ ^ 2) * ‖w‖ ^ 2 := by ring
      _ ≤ C_Δ * ‖w‖ ^ 2 :=
          mul_le_mul_of_nonneg_right (le_max_right _ _) (sq_nonneg _)

  have h_exp_shift : ∀ (w_coeff Y : ℂ),
      ‖w_coeff * Complex.exp (-Complex.I * Y)‖ < ρ_mod →
      w_coeff * Complex.exp (-Complex.I *
        (Y + Δ₀ (w_coeff * Complex.exp (-Complex.I * Y)))) =
        Λ (w_coeff * Complex.exp (-Complex.I * Y)) := by
    intro w_coeff Y hw
    set w := w_coeff * Complex.exp (-Complex.I * Y)
    have hw₀ : w ∈ Metric.ball (0 : ℂ) ρ₀ := by
      rw [Metric.mem_ball, dist_zero_right]
      exact lt_of_lt_of_le hw hρ_mod_le
    set lam := Λ w
    have hW_lam : W lam = w := (hΛ_props w hw₀).2.1
    have h_arg : -Complex.I * (Y + Δ₀ w) = -Complex.I * Y + (-I_prim lam) := by
      dsimp [Δ₀, lam]
      calc -Complex.I * (Y + -Complex.I * I_prim (Λ w))
          = -Complex.I * Y + (Complex.I ^ 2) * I_prim (Λ w) := by ring
        _ = -Complex.I * Y + (-I_prim (Λ w)) := by rw [Complex.I_sq]; ring
    rw [h_arg, Complex.exp_add]
    calc w_coeff * (Complex.exp (-Complex.I * Y) * Complex.exp (-I_prim lam))
        = w * Complex.exp (-I_prim lam) := by dsimp [w]; ring
      _ = W lam * Complex.exp (-I_prim lam) := by rw [hW_lam]
      _ = lam * (Complex.exp (I_prim lam) * Complex.exp (-I_prim lam)) := by
          dsimp [W]; ring
      _ = lam * Complex.exp (I_prim lam + -I_prim lam) := by rw [← Complex.exp_add]
      _ = lam := by simp

  have h_shift_hasDeriv : ∀ (w_coeff Y : ℂ),
      ‖w_coeff * Complex.exp (-Complex.I * Y)‖ < ρ_mod →
      HasDerivAt (fun Y' => Y' + Δ₀ (w_coeff * Complex.exp (-Complex.I * Y')))
        (J_mod (Λ (w_coeff * Complex.exp (-Complex.I * Y)))) Y := by
    intro w_coeff Y hw
    set w := w_coeff * Complex.exp (-Complex.I * Y)
    have hw_ball : w ∈ Metric.ball (0 : ℂ) ρ_mod := by
      rwa [Metric.mem_ball, dist_zero_right]
    have hw₀ : w ∈ Metric.ball (0 : ℂ) ρ₀ := Metric.ball_subset_ball hρ_mod_le hw_ball
    set lam := Λ w
    have hlam_J : lam ∈ Metric.ball (0 : ℂ) r_J :=
      Metric.ball_subset_ball hr_lam_le_J (hΛ_props w hw₀).2.2
    have hJ_ne : J_mod lam ≠ 0 := hJ_mod_ne lam hlam_J
    have hW_lam : lam * Complex.exp (I_prim lam) = w := (hΛ_props w hw₀).2.1
    have h_rel : ((J_mod lam)⁻¹ * Complex.exp (I_prim lam)) * deriv Λ w = 1 :=
      hΛ_deriv_rel w hw₀
    have h_ω : HasDerivAt (fun Y' : ℂ => w_coeff * Complex.exp (-Complex.I * Y'))
        (-Complex.I * w) Y := by
      have h1 : HasDerivAt (fun Y' : ℂ => -Complex.I * Y') (-Complex.I * 1) Y :=
        (hasDerivAt_id Y).const_mul (-Complex.I)
      have h2 := h1.cexp.const_mul w_coeff
      convert h2 using 1
      dsimp [w]
      ring
    have h_comp := (hΔ₀_hasDeriv w hw_ball).comp Y h_ω
    have h_sum : HasDerivAt (fun Y' => Y' + Δ₀ (w_coeff * Complex.exp (-Complex.I * Y')))
        (1 + (-Complex.I * (q lam * deriv Λ w)) * (-Complex.I * w)) Y :=
      (hasDerivAt_id Y).add h_comp
    have h_prod : w * q lam * deriv Λ w = 1 - J_mod lam := by
      have h_wq : w * q lam * deriv Λ w =
          (lam * q lam) * J_mod lam *
            (((J_mod lam)⁻¹ * Complex.exp (I_prim lam)) * deriv Λ w) := by
        calc w * q lam * deriv Λ w
            = (lam * Complex.exp (I_prim lam)) * q lam * deriv Λ w := by rw [← hW_lam]
          _ = (lam * q lam) * (J_mod lam * (J_mod lam)⁻¹) *
                Complex.exp (I_prim lam) * deriv Λ w := by
              rw [mul_inv_cancel₀ hJ_ne]; ring
          _ = (lam * q lam) * J_mod lam *
                (((J_mod lam)⁻¹ * Complex.exp (I_prim lam)) * deriv Λ w) := by ring
      rw [h_wq, h_rel, mul_one, hq_mul lam]
      dsimp [f_inv]
      calc ((J_mod lam)⁻¹ - 1) * J_mod lam
          = (J_mod lam)⁻¹ * J_mod lam - J_mod lam := by ring
        _ = 1 - J_mod lam := by rw [inv_mul_cancel₀ hJ_ne]
    have h_eq : 1 + (-Complex.I * (q lam * deriv Λ w)) * (-Complex.I * w) = J_mod lam := by
      calc 1 + (-Complex.I * (q lam * deriv Λ w)) * (-Complex.I * w)
          = 1 + (Complex.I ^ 2) * (w * q lam * deriv Λ w) := by ring
        _ = 1 - w * q lam * deriv Λ w := by rw [Complex.I_sq]; ring
        _ = 1 - (1 - J_mod lam) := by rw [h_prod]
        _ = J_mod lam := by ring
    rwa [h_eq] at h_sum

  
  
  
  refine ⟨{
    ρ_mod := ρ_mod
    r_lam := r_lam
    ρ_J := ρ_J
    C_Δ := C_Δ
    Δ₀ := Δ₀
    ρ_mod_pos := hρ_mod_pos
    r_lam_pos := hr_lam_pos
    ρ_J_pos := hρ_J_pos
    ρ_J_lt := hρ_J_lt
    C_Δ_pos := hC_Δ_pos
    Δ₀_holo := hΔ₀_holo
    Δ₀_zero := hΔ₀_zero
    Δ₀_even := hΔ₀_even
    Δ₀_bound := hΔ₀_bound
    model_energy := fun w_coeff Y hw => by
      rw [h_exp_shift w_coeff Y hw, (h_shift_hasDeriv w_coeff Y hw).deriv]
      have hw₀ : w_coeff * Complex.exp (-Complex.I * Y) ∈ Metric.ball (0 : ℂ) ρ₀ := by
        rw [Metric.mem_ball, dist_zero_right]
        exact lt_of_lt_of_le hw hρ_mod_le
      exact hJ_mod_energy _ (Metric.ball_subset_ball hr_lam_le_J (hΛ_props _ hw₀).2.2)
    regular_on_polydisk := fun lam J hlam hJ =>
      h_poly_reg lam J (lt_of_lt_of_le hlam hr_lam_le_J) hJ
    cone_ode_uniqueness := ?_
  }⟩
  intro w_coeff D₁ A₁ S_star hD₁ hA₁ hS_holo hS_tendsto hS_cone
  let 𝒞 : Set ℂ := { Y : ℂ | D₁ < -Y.im ∧ |Y.re| < A₁ * (-Y.im) }
  have h𝒞_open : IsOpen 𝒞 :=
    (isOpen_lt continuous_const Complex.continuous_im.neg).inter
      (isOpen_lt (continuous_abs.comp Complex.continuous_re)
        (continuous_const.mul Complex.continuous_im.neg))
  have h𝒞_conv : Convex ℝ 𝒞 := by
    intro Y₁ hY₁ Y₂ hY₂ a b ha hb hab
    by_cases ha0 : a = 0
    · have hb1 : b = 1 := by linarith
      simpa [ha0, hb1] using hY₂
    · have ha_pos : 0 < a := lt_of_le_of_ne ha (Ne.symm ha0)
      rcases hY₁ with ⟨hY₁_im, hY₁_re⟩
      rcases hY₂ with ⟨hY₂_im, hY₂_re⟩
      have him : (a • Y₁ + b • Y₂).im = a * Y₁.im + b * Y₂.im := by simp
      have hre : (a • Y₁ + b • Y₂).re = a * Y₁.re + b * Y₂.re := by simp
      refine ⟨?_, ?_⟩
      · rw [him]
        have h1 : a * D₁ < a * (-Y₁.im) := mul_lt_mul_of_pos_left hY₁_im ha_pos
        have h2 : b * D₁ ≤ b * (-Y₂.im) := mul_le_mul_of_nonneg_left hY₂_im.le hb
        nlinarith
      · rw [him, hre]
        have h_abs : |a * Y₁.re + b * Y₂.re| ≤ a * |Y₁.re| + b * |Y₂.re| := by
          calc |a * Y₁.re + b * Y₂.re|
              ≤ |a * Y₁.re| + |b * Y₂.re| := abs_add_le _ _
            _ = a * |Y₁.re| + b * |Y₂.re| := by
                rw [abs_mul, abs_mul, abs_of_nonneg ha, abs_of_nonneg hb]
        have h1 : a * |Y₁.re| < a * (A₁ * (-Y₁.im)) :=
          mul_lt_mul_of_pos_left hY₁_re ha_pos
        have h2 : b * |Y₂.re| ≤ b * (A₁ * (-Y₂.im)) :=
          mul_le_mul_of_nonneg_left hY₂_re.le hb
        linarith

  let lam_star : ℂ → ℂ := fun Y => w_coeff * Complex.exp (-Complex.I * S_star Y)
  let F_int : ℂ → ℂ := fun Y => W (lam_star Y) * Complex.exp (Complex.I * Y)
  have hS_deriv_eq : ∀ Y ∈ 𝒞, deriv S_star Y = J_mod (lam_star Y) := by
    intro Y hY
    rcases hS_cone Y hY.1 hY.2 with ⟨_, hlam_lt, hJ_lt, hE⟩
    exact h_root_unique (lam_star Y) (deriv S_star Y)
      (lt_of_lt_of_le hlam_lt hr_lam_le_J) hJ_lt hE
  have hF_hasDeriv : ∀ Y ∈ 𝒞, HasDerivAt F_int 0 Y := by
    intro Y hY
    rcases hS_cone Y hY.1 hY.2 with ⟨_, hlam_lt, _, _⟩
    have hlam_half : lam_star Y ∈ Metric.ball (0 : ℂ) r_half := by
      rw [Metric.mem_ball, dist_zero_right]
      exact lt_of_lt_of_le hlam_lt hr_lam_le_half
    have hS_at : HasDerivAt S_star (J_mod (lam_star Y)) Y := by
      rw [← hS_deriv_eq Y hY]
      exact (hS_holo.differentiableAt (h𝒞_open.mem_nhds hY)).hasDerivAt
    have hlam_at : HasDerivAt lam_star (-Complex.I * (lam_star Y * J_mod (lam_star Y))) Y := by
      have h1 := (hS_at.const_mul (-Complex.I)).cexp.const_mul w_coeff
      convert h1 using 1
      dsimp [lam_star]
      ring
    have hW_at : HasDerivAt W (deriv W (lam_star Y)) (lam_star Y) :=
      (hW_hasDeriv (lam_star Y) hlam_half).differentiableAt.hasDerivAt
    have hW_comp : HasDerivAt (fun Y' => W (lam_star Y')) (-Complex.I * W (lam_star Y)) Y := by
      have hc : HasDerivAt (fun Y' => W (lam_star Y'))
          (deriv W (lam_star Y) * (-Complex.I * (lam_star Y * J_mod (lam_star Y)))) Y :=
        hW_at.comp Y hlam_at
      have h_eq : deriv W (lam_star Y) * (-Complex.I * (lam_star Y * J_mod (lam_star Y))) =
          -Complex.I * W (lam_star Y) := by
        calc deriv W (lam_star Y) * (-Complex.I * (lam_star Y * J_mod (lam_star Y)))
            = -Complex.I * (lam_star Y * J_mod (lam_star Y) * deriv W (lam_star Y)) := by ring
          _ = -Complex.I * W (lam_star Y) := by rw [hW_ode (lam_star Y) hlam_half]
      rwa [h_eq] at hc
    have hexp_at : HasDerivAt (fun Y' : ℂ => Complex.exp (Complex.I * Y'))
        (Complex.exp (Complex.I * Y) * Complex.I) Y := by
      have h1 : HasDerivAt (fun Y' : ℂ => Complex.I * Y') (Complex.I * 1) Y :=
        (hasDerivAt_id Y).const_mul Complex.I
      have h2 := h1.cexp
      rwa [mul_one] at h2
    have hprod : HasDerivAt F_int
        ((-Complex.I * W (lam_star Y)) * Complex.exp (Complex.I * Y) +
          W (lam_star Y) * (Complex.exp (Complex.I * Y) * Complex.I)) Y :=
      hW_comp.mul hexp_at
    have h_zero : (-Complex.I * W (lam_star Y)) * Complex.exp (Complex.I * Y) +
        W (lam_star Y) * (Complex.exp (Complex.I * Y) * Complex.I) = 0 := by ring
    rwa [h_zero] at hprod
  have hF_const : ∀ Y₁ ∈ 𝒞, ∀ Y₂ ∈ 𝒞, F_int Y₁ = F_int Y₂ := by
    intro Y₁ hY₁ Y₂ hY₂
    have h_diff : DifferentiableOn ℂ F_int 𝒞 :=
      fun Z hZ => (hF_hasDeriv Z hZ).differentiableAt.differentiableWithinAt
    have h_le : ‖F_int Y₁ - F_int Y₂‖ ≤ 0 * ‖Y₁ - Y₂‖ :=
      h𝒞_conv.norm_image_sub_le_of_norm_deriv_le
        (fun Z hZ => h_diff.differentiableAt (h𝒞_open.mem_nhds hZ))
        (fun Z hZ => by rw [(hF_hasDeriv Z hZ).deriv, norm_zero])
        hY₂ hY₁
    rw [ zero_mul, norm_le_zero_iff] at h_le
    exact sub_eq_zero.mp h_le

  let Y_ray : ℝ → ℂ := fun τ => -(τ : ℂ) * Complex.I
  let δ_ray : ℝ → ℂ := fun τ => S_star (Y_ray τ) + (τ : ℂ) * Complex.I
  have hY_ray_mem : ∀ τ : ℝ, D₁ + 1 ≤ τ → Y_ray τ ∈ 𝒞 := by
    intro τ hτ
    have hτ_pos : 0 < τ := by linarith
    refine ⟨?_, ?_⟩
    · simp [Y_ray]
      linarith
    · simp [Y_ray]
      exact mul_pos hA₁ hτ_pos
  have hexp_neg_tendsto :
      Filter.Tendsto (fun τ : ℝ => Complex.exp (-(τ : ℂ))) Filter.atTop (nhds 0) := by
    rw [tendsto_zero_iff_norm_tendsto_zero]
    have h_eq : (fun τ : ℝ => ‖Complex.exp (-(τ : ℂ))‖) = fun τ : ℝ => Real.exp (-τ) := by
      ext τ
      rw [Complex.norm_exp]
      simp
    rw [h_eq]
    exact Real.tendsto_exp_neg_atTop_nhds_zero
  have hlam_ray_eq : ∀ τ : ℝ,
      lam_star (Y_ray τ) =
        w_coeff * Complex.exp (-(τ : ℂ)) * Complex.exp (-Complex.I * δ_ray τ) := by
    intro τ
    have h_arg : -Complex.I * S_star (Y_ray τ) = -(τ : ℂ) + (-Complex.I * δ_ray τ) := by
      have hS_eq : S_star (Y_ray τ) = δ_ray τ - (τ : ℂ) * Complex.I := by
        dsimp [δ_ray]
        ring
      rw [hS_eq]
      calc -Complex.I * (δ_ray τ - (τ : ℂ) * Complex.I)
          = (Complex.I ^ 2) * (τ : ℂ) + (-Complex.I * δ_ray τ) := by ring
        _ = -(τ : ℂ) + (-Complex.I * δ_ray τ) := by rw [Complex.I_sq]; ring
    dsimp [lam_star]
    rw [h_arg, Complex.exp_add]
    ring
  have hexp_δ_tendsto :
      Filter.Tendsto (fun τ : ℝ => Complex.exp (-Complex.I * δ_ray τ))
        Filter.atTop (nhds 1) := by
    have h1 : Filter.Tendsto (fun τ : ℝ => -Complex.I * δ_ray τ)
        Filter.atTop (nhds (-Complex.I * 0)) :=
      hS_tendsto.const_mul (-Complex.I)
    rw [mul_zero] at h1
    have h2 : Filter.Tendsto (fun τ : ℝ => Complex.exp (-Complex.I * δ_ray τ))
        Filter.atTop (nhds (Complex.exp 0)) :=
      Complex.continuous_exp.continuousAt.tendsto.comp h1
    rwa [Complex.exp_zero] at h2
  have hlam_ray_tendsto :
      Filter.Tendsto (fun τ : ℝ => lam_star (Y_ray τ)) Filter.atTop (nhds 0) := by
    have h1 : Filter.Tendsto
        (fun τ : ℝ => (w_coeff * Complex.exp (-(τ : ℂ))) * Complex.exp (-Complex.I * δ_ray τ))
        Filter.atTop (nhds ((w_coeff * 0) * 1)) :=
      (hexp_neg_tendsto.const_mul w_coeff).mul hexp_δ_tendsto
    rw [mul_zero, zero_mul] at h1
    exact h1.congr (fun τ => (hlam_ray_eq τ).symm)
  have hI_cont0 : ContinuousAt I_prim 0 :=
    (hI_hasDeriv 0 (Metric.mem_ball_self hr_half_pos)).continuousAt
  have hF_ray_tendsto :
      Filter.Tendsto (fun τ : ℝ => F_int (Y_ray τ)) Filter.atTop (nhds w_coeff) := by
    let g_lim : ℝ → ℂ := fun τ =>
      (w_coeff * Complex.exp (-Complex.I * δ_ray τ)) *
        Complex.exp (I_prim (lam_star (Y_ray τ)))
    have hg_tendsto : Filter.Tendsto g_lim Filter.atTop (nhds w_coeff) := by
      have hI_lim : Filter.Tendsto (fun τ : ℝ => I_prim (lam_star (Y_ray τ)))
          Filter.atTop (nhds (I_prim 0)) :=
        hI_cont0.tendsto.comp hlam_ray_tendsto
      rw [hI_zero] at hI_lim
      have hexp_I : Filter.Tendsto (fun τ : ℝ => Complex.exp (I_prim (lam_star (Y_ray τ))))
          Filter.atTop (nhds (Complex.exp 0)) :=
        Complex.continuous_exp.continuousAt.tendsto.comp hI_lim
      rw [Complex.exp_zero] at hexp_I
      have hwδ : Filter.Tendsto (fun τ : ℝ => w_coeff * Complex.exp (-Complex.I * δ_ray τ))
          Filter.atTop (nhds (w_coeff * 1)) :=
        hexp_δ_tendsto.const_mul w_coeff
      have hprod : Filter.Tendsto g_lim Filter.atTop (nhds ((w_coeff * 1) * 1)) :=
        hwδ.mul hexp_I
      rwa [mul_one, mul_one] at hprod
    refine hg_tendsto.congr' ?_
    filter_upwards [Filter.eventually_ge_atTop (D₁ + 1)] with τ hτ
    have hIY : Complex.I * Y_ray τ = (τ : ℂ) := by
      dsimp [Y_ray]
      calc Complex.I * (-(τ : ℂ) * Complex.I) = -(Complex.I ^ 2) * (τ : ℂ) := by ring
        _ = (τ : ℂ) := by rw [Complex.I_sq]; ring
    dsimp [F_int, W, g_lim]
    rw [hIY]
    have hl := hlam_ray_eq τ
    calc (w_coeff * Complex.exp (-Complex.I * δ_ray τ)) *
          Complex.exp (I_prim (lam_star (Y_ray τ)))
        = w_coeff * Complex.exp (-(τ : ℂ) + (τ : ℂ)) *
            Complex.exp (-Complex.I * δ_ray τ) *
            Complex.exp (I_prim (lam_star (Y_ray τ))) := by simp
      _ = w_coeff * (Complex.exp (-(τ : ℂ)) * Complex.exp (τ : ℂ)) *
            Complex.exp (-Complex.I * δ_ray τ) *
            Complex.exp (I_prim (lam_star (Y_ray τ))) := by rw [Complex.exp_add]
      _ = (w_coeff * Complex.exp (-(τ : ℂ)) * Complex.exp (-Complex.I * δ_ray τ)) *
            Complex.exp (I_prim (lam_star (Y_ray τ))) * Complex.exp (τ : ℂ) := by ring
      _ = lam_star (Y_ray τ) * Complex.exp (I_prim (lam_star (Y_ray τ))) *
            Complex.exp (τ : ℂ) := by rw [← hl]

  have hW_lam_eq : ∀ Y ∈ 𝒞, W (lam_star Y) = w_coeff * Complex.exp (-Complex.I * Y) := by
    intro Y hY
    have h_const_lim : Filter.Tendsto (fun τ : ℝ => F_int (Y_ray τ))
        Filter.atTop (nhds (F_int Y)) := by
      refine tendsto_const_nhds.congr' ?_
      filter_upwards [Filter.eventually_ge_atTop (D₁ + 1)] with τ hτ
      exact hF_const Y hY (Y_ray τ) (hY_ray_mem τ hτ)
    have hF_eq : F_int Y = w_coeff := tendsto_nhds_unique h_const_lim hF_ray_tendsto
    calc W (lam_star Y)
        = W (lam_star Y) * (Complex.exp (Complex.I * Y) * Complex.exp (-Complex.I * Y)) := by
            rw [← Complex.exp_add]; simp
      _ = F_int Y * Complex.exp (-Complex.I * Y) := by dsimp [F_int]; ring
      _ = w_coeff * Complex.exp (-Complex.I * Y) := by rw [hF_eq]

  let S_mod : ℂ → ℂ := fun Y' => Y' + Δ₀ (w_coeff * Complex.exp (-Complex.I * Y'))
  let D_diff : ℂ → ℂ := fun Y' => S_star Y' - S_mod Y'
  have hD_hasDeriv : ∀ Y ∈ 𝒞, HasDerivAt D_diff 0 Y := by
    intro Y hY
    rcases hS_cone Y hY.1 hY.2 with ⟨hw_lt, hlam_lt, _, _⟩
    have hlam_mem : lam_star Y ∈ Metric.ball (0 : ℂ) r_lam := by
      rwa [Metric.mem_ball, dist_zero_right]
    have hlam_eq_Λ : lam_star Y = Λ (w_coeff * Complex.exp (-Complex.I * Y)) := by
      have hL := hΛ_left (lam_star Y) hlam_mem
      rw [hW_lam_eq Y hY] at hL
      exact hL.symm
    have hS_at : HasDerivAt S_star (J_mod (lam_star Y)) Y := by
      rw [← hS_deriv_eq Y hY]
      exact (hS_holo.differentiableAt (h𝒞_open.mem_nhds hY)).hasDerivAt
    have hmod_at : HasDerivAt S_mod (J_mod (lam_star Y)) Y := by
      rw [hlam_eq_Λ]
      exact h_shift_hasDeriv w_coeff Y hw_lt
    have hsub : HasDerivAt D_diff (J_mod (lam_star Y) - J_mod (lam_star Y)) Y :=
      hS_at.sub hmod_at
    rwa [sub_self] at hsub
  have hD_const : ∀ Y₁ ∈ 𝒞, ∀ Y₂ ∈ 𝒞, D_diff Y₁ = D_diff Y₂ := by
    intro Y₁ hY₁ Y₂ hY₂
    have h_diff : DifferentiableOn ℂ D_diff 𝒞 :=
      fun Z hZ => (hD_hasDeriv Z hZ).differentiableAt.differentiableWithinAt
    have h_le : ‖D_diff Y₁ - D_diff Y₂‖ ≤ 0 * ‖Y₁ - Y₂‖ :=
      h𝒞_conv.norm_image_sub_le_of_norm_deriv_le
        (fun Z hZ => h_diff.differentiableAt (h𝒞_open.mem_nhds hZ))
        (fun Z hZ => by rw [(hD_hasDeriv Z hZ).deriv, norm_zero])
        hY₂ hY₁
    rw [zero_mul, norm_le_zero_iff] at h_le
    exact sub_eq_zero.mp h_le
  have hD_ray_tendsto : Filter.Tendsto (fun τ : ℝ => D_diff (Y_ray τ))
      Filter.atTop (nhds 0) := by
    have hΔ_cont0 : ContinuousAt Δ₀ 0 :=
      (hΔ₀_hasDeriv 0 (Metric.mem_ball_self hρ_mod_pos)).continuousAt
    have hw_ray_lim : Filter.Tendsto (fun τ : ℝ => w_coeff * Complex.exp (-(τ : ℂ)))
        Filter.atTop (nhds (w_coeff * 0)) :=
      hexp_neg_tendsto.const_mul w_coeff
    rw [mul_zero] at hw_ray_lim
    have hΔ_ray_lim : Filter.Tendsto
        (fun τ : ℝ => Δ₀ (w_coeff * Complex.exp (-(τ : ℂ)))) Filter.atTop (nhds (Δ₀ 0)) :=
      hΔ_cont0.tendsto.comp hw_ray_lim
    rw [hΔ₀_zero] at hΔ_ray_lim
    have h_sub_lim : Filter.Tendsto
        (fun τ : ℝ => δ_ray τ - Δ₀ (w_coeff * Complex.exp (-(τ : ℂ))))
        Filter.atTop (nhds (0 - 0)) :=
      hS_tendsto.sub hΔ_ray_lim
    rw [sub_self] at h_sub_lim
    refine h_sub_lim.congr (fun τ => ?_)
    have h_neg_IY : -Complex.I * Y_ray τ = -(τ : ℂ) := by
      dsimp [Y_ray]
      calc -Complex.I * (-(τ : ℂ) * Complex.I) = (Complex.I ^ 2) * (τ : ℂ) := by ring
        _ = -(τ : ℂ) := by rw [Complex.I_sq]; ring
    dsimp [D_diff, S_mod, δ_ray]
    rw [h_neg_IY]
    dsimp [Y_ray]
    ring

  intro Y hY_im hY_re
  have hY : Y ∈ 𝒞 := ⟨hY_im, hY_re⟩
  have h_const_lim : Filter.Tendsto (fun τ : ℝ => D_diff (Y_ray τ))
      Filter.atTop (nhds (D_diff Y)) := by
    refine tendsto_const_nhds.congr' ?_
    filter_upwards [Filter.eventually_ge_atTop (D₁ + 1)] with τ hτ
    exact hD_const Y hY (Y_ray τ) (hY_ray_mem τ hτ)
  have hD_zero : D_diff Y = 0 := tendsto_nhds_unique h_const_lim hD_ray_tendsto
  exact sub_eq_zero.mp hD_zero

theorem dfmc_vertical_uniqueness_and_arzela_extraction (X : ExpStripData) (P : ChordActionPackage X)
    (kind : ExpProfileKind) (seq : ExpSequenceData X kind)
    (T_max D_anc C_anc α D₀ A D_top : ℝ)
    (hT_max : 0 < T_max) (hD_anc : 0 < D_anc) (hC_anc : 0 < C_anc)
    (hα₁ : 1 / 2 < α) (hα₂ : α < 1) (hD₀_ge : D_anc ≤ D₀)
    (hA : 0 < A) (hD_top : D₀ + 2 < D_top)
    (hAnc2 : DfmcHasAnchorAt X P kind seq (2 * T_max) D_anc C_anc α)
    (N_init : ℕ) (U_phys : ℕ → Set (ℂ × ℂ))
    (s_tilde : ℕ → ℂ × ℂ → ℂ) (δ_base : ℕ → ℝ)
    (hWit : DfmcAnchorWitnessAt X P kind seq (2 * T_max) D_anc C_anc α
      (A + 2) (D_top + 4) N_init U_phys s_tilde δ_base)
    (S_cand : ℂ × ℂ → ℂ)
    (hS_cont : ContinuousOn S_cand { p : ℂ × ℂ | D₀ < -p.1.im ∧ ‖p.2‖ < T_max })
    (hS_zero : ∀ Y : ℂ, D₀ < -Y.im → S_cand (Y, 0) = Y)
    (K : Set (ℂ × ℂ)) (hK_comp : IsCompact K)
    (hK_sub : K ⊆ { p : ℂ × ℂ |
      D₀ < -p.1.im ∧ -p.1.im < D_top ∧ |p.1.re| < A * (-p.1.im) ∧ ‖p.2‖ < T_max })
    (ε : ℝ) (hε : 0 < ε)
    (hFail : ¬ ∃ N₁ : ℕ, N_init ≤ N₁ ∧ ∀ n ≥ N₁, ∀ p ∈ K,
      let s_n : ℂ := (seq.x_seq n : ℂ) + (seq.h_seq n : ℂ) * Complex.I
      ‖(s_tilde n (s_n + (seq.ℓ_seq n : ℂ) * p.1, p.2 / (seq.m_seq n : ℂ)) - s_n) /
          (seq.ℓ_seq n : ℂ) - S_cand p‖ < ε) :
    ∃ L : DfmcExtractedLimit X P kind seq D₀ C_anc α A T_max,
      L.S_star L.Y_star ≠ S_cand (L.Y_star, L.T_star) :=
by
  have hD₀_pos : 0 < D₀ := lt_of_lt_of_le hD_anc hD₀_ge
  have hD_top_pos : 0 < D_top := by linarith
  
  have h_lip_of_holo_bdd : ∀ (U Ω : Set ℂ) (r M : ℝ) (f : ℂ → ℂ),
      IsOpen U → Convex ℝ U → 0 < r →
      (∀ w ∈ U, Metric.closedBall w r ⊆ Ω) →
      DifferentiableOn ℂ f Ω →
      (∀ z ∈ Ω, ‖f z‖ ≤ M) →
      ∀ x ∈ U, ∀ y ∈ U, ‖f x - f y‖ ≤ (M / r) * ‖x - y‖ := by
    intro U Ω r M f hU_open hU_conv hr h_ball hf_holo hf_bdd x hx y hy
    have hU_sub : U ⊆ Ω := fun w hw => h_ball w hw (Metric.mem_closedBall_self hr.le)
    have hf_U : DifferentiableOn ℂ f U := hf_holo.mono hU_sub
    have h_deriv : ∀ w ∈ U, ‖deriv f w‖ ≤ M / r := fun w hw =>
      Complex.norm_deriv_le_of_forall_mem_sphere_norm_le hr
        (hf_holo.diffContOnCl_ball (h_ball w hw))
        (fun z hz => hf_bdd z (h_ball w hw (Metric.sphere_subset_closedBall hz)))
    exact hU_conv.norm_image_sub_le_of_norm_deriv_le
      (fun w hw => (hf_U w hw).differentiableAt (hU_open.mem_nhds hw)) h_deriv hy hx
  
  have h_vert_uniq : ∀ (A₁ D_top₁ A₂ D_top₂ : ℝ)
      (N₁ N₂ : ℕ) (U₁ U₂ : ℕ → Set (ℂ × ℂ))
      (s₁ s₂ : ℕ → ℂ × ℂ → ℂ) (δ₁ δ₂ : ℕ → ℝ),
      DfmcAnchorWitnessAt X P kind seq (2 * T_max) D_anc C_anc α A₁ D_top₁ N₁ U₁ s₁ δ₁ →
      DfmcAnchorWitnessAt X P kind seq (2 * T_max) D_anc C_anc α A₂ D_top₂ N₂ U₂ s₂ δ₂ →
      ∀ n : ℕ, N₁ ≤ n → N₂ ≤ n →
      ∀ Y T : ℂ,
        D_anc < -Y.im → -Y.im < D_top₁ → -Y.im < D_top₂ →
        |Y.re| < A₁ * (-Y.im) → |Y.re| < A₂ * (-Y.im) → ‖T‖ < 2 * T_max →
        rescaledLift seq (s₁ n) n Y T = rescaledLift seq (s₂ n) n Y T := by
    intro A₁ D_top₁ A₂ D_top₂ N₁ N₂ U₁ U₂ s₁ s₂ δ₁ δ₂ hW₁ hW₂ n hn₁ hn₂ Y T
      hY_lo hY_hi₁ hY_hi₂ hY_re₁ hY_re₂ hT
    rcases hW₁ n hn₁ with
      ⟨hOpen₁, hδ₁, hVert₁, _, hHolo₁, _, _, hBase₁, _, hCone₁, _⟩
    rcases hW₂ n hn₂ with
      ⟨hOpen₂, hδ₂, hVert₂, _, hHolo₂, _, _, hBase₂, _, hCone₂, _⟩
    let y₀ : ℂ := expBasePt seq n + (seq.ℓ_seq n : ℂ) * Y
    let t₀ : ℂ := T / (seq.m_seq n : ℂ)
    have hc₁ := hCone₁ (Y, T) ⟨hY_lo, hY_hi₁, hY_re₁, hT⟩
    have hc₂ := hCone₂ (Y, T) ⟨hY_lo, hY_hi₂, hY_re₂, hT⟩
    have hm_pos : 0 < seq.m_seq n := seq.m_pos n
    have ht₀_lt : ‖t₀‖ < (2 * T_max) / seq.m_seq n := by
      dsimp [t₀]
      rw [norm_div, Complex.norm_real, Real.norm_of_nonneg hm_pos.le]
      exact div_lt_div_of_pos_right hT hm_pos
    have hs_eq : s₁ n (y₀, t₀) = s₂ n (y₀, t₀) := by
      let ι : ℂ → ℂ × ℂ := fun z => ((y₀.re : ℂ) + z * Complex.I, t₀)
      have hι_diff : Differentiable ℂ ι :=
        ((differentiable_const _).add
          (differentiable_id.mul (differentiable_const Complex.I))).prodMk
          (differentiable_const t₀)
      let W : Set ℂ := ι ⁻¹' (U₁ n ∩ U₂ n)
      have hW_open : IsOpen W := (hOpen₁.inter hOpen₂).preimage hι_diff.continuous
      let f₁ : ℂ → ℂ := fun z => s₁ n (ι z)
      let f₂ : ℂ → ℂ := fun z => s₂ n (ι z)
      have hf₁_ana : AnalyticOnNhd ℂ f₁ W :=
        (Complex.analyticOnNhd_iff_differentiableOn hW_open).mpr
          (hHolo₁.comp hι_diff.differentiableOn (fun _ hz => hz.1))
      have hf₂_ana : AnalyticOnNhd ℂ f₂ W :=
        (Complex.analyticOnNhd_iff_differentiableOn hW_open).mpr
          (hHolo₂.comp hι_diff.differentiableOn (fun _ hz => hz.2))
      have hy₀_im : 0 ≤ y₀.im := hc₁.2.1.le
      let γ : Set ℂ := Complex.ofRealCLM '' Set.Icc (0 : ℝ) y₀.im
      have hγ_comp : IsCompact γ := isCompact_Icc.image Complex.ofRealCLM.continuous
      have hγ_conv : Convex ℝ γ :=
        (convex_Icc (0 : ℝ) y₀.im).linear_image Complex.ofRealCLM.toLinearMap
      have hγ_sub : γ ⊆ W := by
        rintro _ ⟨τ, ⟨hτ₀, hτ₁⟩, rfl⟩
        change ((y₀.re : ℂ) + (τ : ℂ) * Complex.I, t₀) ∈ U₁ n ∩ U₂ n
        exact ⟨hVert₁ y₀ t₀ hc₁.1 hy₀_im τ hτ₀ hτ₁, hVert₂ y₀ t₀ hc₂.1 hy₀_im τ hτ₀ hτ₁⟩
      obtain ⟨δ_th, hδ_th_pos, hV_sub_W⟩ :=
        hγ_comp.exists_thickening_subset_open hW_open hγ_sub
      let V : Set ℂ := Metric.thickening δ_th γ
      have hV_preconn : IsPreconnected V := (hγ_conv.thickening δ_th).isPreconnected
      have h0_mem_γ : (0 : ℂ) ∈ γ := ⟨0, ⟨le_rfl, hy₀_im⟩, by simp⟩
      have hy_mem_γ : (y₀.im : ℂ) ∈ γ := ⟨y₀.im, ⟨hy₀_im, le_rfl⟩, by simp⟩
      have h0_mem_V : (0 : ℂ) ∈ V := Metric.self_subset_thickening hδ_th_pos γ h0_mem_γ
      have hy_mem_V : (y₀.im : ℂ) ∈ V := Metric.self_subset_thickening hδ_th_pos γ hy_mem_γ
      let δ₀ : ℝ := min (δ₁ n) (δ₂ n)
      have hδ₀_pos : 0 < δ₀ := lt_min hδ₁ hδ₂
      have h_ev_eq : f₁ =ᶠ[nhds (0 : ℂ)] f₂ := by
        filter_upwards [Metric.ball_mem_nhds (0 : ℂ) hδ₀_pos] with z hz
        rw [Metric.mem_ball, dist_zero_right] at hz
        have hz_im : |(ι z).1.im| < δ₀ := by
          have him : (ι z).1.im = z.re := by simp [ι]
          rw [him]
          exact lt_of_le_of_lt (Complex.abs_re_le_norm z) hz
        have hb₁ := (hBase₁ (ι z).1 t₀ (lt_of_lt_of_le hz_im (min_le_left _ _)) ht₀_lt).2.2
        have hb₂ := (hBase₂ (ι z).1 t₀ (lt_of_lt_of_le hz_im (min_le_right _ _)) ht₀_lt).2.2
        exact hb₁.trans hb₂.symm
      have h_eq_V := (hf₁_ana.mono hV_sub_W).eqOn_of_preconnected_of_eventuallyEq
        (hf₂_ana.mono hV_sub_W) hV_preconn h0_mem_V h_ev_eq hy_mem_V
      have hι_end : ι (y₀.im : ℂ) = (y₀, t₀) := by
        apply Prod.ext
        · exact Complex.re_add_im y₀
        · rfl
      simpa [f₁, f₂, hι_end] using h_eq_V
    dsimp [rescaledLift]
    change (s₁ n (y₀, t₀) - expBasePt seq n) / (seq.ℓ_seq n : ℂ) =
      (s₂ n (y₀, t₀) - expBasePt seq n) / (seq.ℓ_seq n : ℂ)
    rw [hs_eq]
  
  have h_step_fail : ∀ M : ℕ, ∃ np : ℕ × (ℂ × ℂ),
      max N_init M ≤ np.1 ∧ np.2 ∈ K ∧
      ε ≤ ‖rescaledLift seq (s_tilde np.1) np.1 np.2.1 np.2.2 - S_cand np.2‖ := by
    intro M
    by_contra! h_all
    refine hFail ⟨max N_init M, le_max_left _ _, fun n hn p hp => ?_⟩
    exact h_all (n, p) hn hp
  let np_seq : ℕ → ℕ × (ℂ × ℂ) :=
    Nat.rec (Classical.choose (h_step_fail 0))
      (fun _ prev => Classical.choose (h_step_fail (prev.1 + 1)))
  have h_np_spec : ∀ k : ℕ,
      N_init ≤ (np_seq k).1 ∧ (np_seq k).2 ∈ K ∧
      ε ≤ ‖rescaledLift seq (s_tilde (np_seq k).1) (np_seq k).1
        (np_seq k).2.1 (np_seq k).2.2 - S_cand (np_seq k).2‖ := by
    intro k
    cases k with
    | zero =>
      have hs := Classical.choose_spec (h_step_fail 0)
      exact ⟨le_trans (le_max_left _ _) hs.1, hs.2.1, hs.2.2⟩
    | succ k =>
      have hs := Classical.choose_spec (h_step_fail ((np_seq k).1 + 1))
      exact ⟨le_trans (le_max_left _ _) hs.1, hs.2.1, hs.2.2⟩
  have h_np_mono : StrictMono (fun k => (np_seq k).1) := by
    refine strictMono_nat_of_lt_succ fun k => ?_
    have hs := (Classical.choose_spec (h_step_fail ((np_seq k).1 + 1))).1
    have h_le : (np_seq k).1 + 1 ≤ (np_seq (k + 1)).1 :=
      le_trans (le_max_right _ _) hs
    omega
  obtain ⟨p_star, hp_star_K, τ₀_K, hτ₀_K_mono, hq_tend⟩ :=
    hK_comp.tendsto_subseq (fun k => (h_np_spec k).2.1)
  let Y_star : ℂ := p_star.1
  let T_star : ℂ := p_star.2
  rcases hK_sub hp_star_K with ⟨hY_star_lo, hY_star_hi, hY_star_re, hT_star_lt⟩
  let ν₀ : ℕ → ℕ := fun k => (np_seq (τ₀_K k)).1
  let q_seq : ℕ → ℂ × ℂ := fun k => (np_seq (τ₀_K k)).2
  have hν₀_mono : StrictMono ν₀ := h_np_mono.comp hτ₀_K_mono
  have hν₀_init : ∀ k : ℕ, N_init ≤ ν₀ k := fun k => (h_np_spec (τ₀_K k)).1
  have hν₀_err : ∀ k : ℕ,
      ε ≤ ‖rescaledLift seq (s_tilde (ν₀ k)) (ν₀ k) (q_seq k).1 (q_seq k).2 -
        S_cand (q_seq k)‖ := fun k => (h_np_spec (τ₀_K k)).2.2
  let ρ_T : ℝ := T_max / 4
  have hρ_T_pos : 0 < ρ_T := by dsimp [ρ_T]; positivity
  let δ_Y : ℝ := min ((-Y_star.im - D₀) / 4) (min 1 (D₀ / (4 * (A + 4))))
  have hδ_Y_pos : 0 < δ_Y := by
    refine lt_min ?_ (lt_min one_pos (by positivity))
    have : 0 < -Y_star.im - D₀ := sub_pos.mpr hY_star_lo
    positivity
  have h_poly_cone : ∀ Y ∈ Metric.closedBall Y_star (2 * δ_Y),
      ∀ T ∈ Metric.closedBall T_star (2 * ρ_T),
        D₀ < -Y.im ∧ D_anc < -Y.im ∧ -Y.im < D_top + 4 ∧
        |Y.re| < (A + 2) * (-Y.im) ∧ ‖T‖ < 2 * T_max := by
    intro Y hY T hT
    rw [Metric.mem_closedBall, dist_eq_norm] at hY hT
    have hT_bound : ‖T‖ < 2 * T_max := by
      have h1 : ‖T‖ ≤ ‖T - T_star‖ + ‖T_star‖ := norm_le_norm_sub_add T T_star
      dsimp [ρ_T] at hT
      linarith
    have h_im_diff : |Y.im - Y_star.im| ≤ 2 * δ_Y := by
      have : (Y - Y_star).im = Y.im - Y_star.im := Complex.sub_im Y Y_star
      rw [← this]
      exact le_trans (Complex.abs_im_le_norm _) hY
    have h_re_diff : |Y.re - Y_star.re| ≤ 2 * δ_Y := by
      have : (Y - Y_star).re = Y.re - Y_star.re := Complex.sub_re Y Y_star
      rw [← this]
      exact le_trans (Complex.abs_re_le_norm _) hY
    rw [abs_le] at h_im_diff h_re_diff
    have hδ1 : δ_Y ≤ (-Y_star.im - D₀) / 4 := min_le_left _ _
    have hδ2 : δ_Y ≤ 1 := le_trans (min_le_right _ _) (min_le_left _ _)
    have hδ3 : δ_Y ≤ D₀ / (4 * (A + 4)) := le_trans (min_le_right _ _) (min_le_right _ _)
    have hY_lo : D₀ < -Y.im := by linarith
    have hY_anc : D_anc < -Y.im := lt_of_le_of_lt hD₀_ge hY_lo
    have hY_hi : -Y.im < D_top + 4 := by linarith
    have hY_re : |Y.re| < (A + 2) * (-Y.im) := by
      have h_prod : 4 * (A + 4) * δ_Y ≤ D₀ := by
        have hA4 : (0 : ℝ) < 4 * (A + 4) := by positivity
        have := (le_div_iff₀ hA4).mp hδ3
        linarith
      have h_re_abs : |Y.re| ≤ |Y_star.re| + 2 * δ_Y := by
        rw [abs_le]
        constructor <;> linarith [le_abs_self Y_star.re, neg_abs_le Y_star.re]
      nlinarith
    exact ⟨hY_lo, hY_anc, hY_hi, hY_re, hT_bound⟩
  let M_star : ℝ := C_anc * (2 * T_max) ^ 2 * D₀ ^ (1 - 2 * α)
  have hM_star_pos : 0 < M_star :=
    mul_pos (mul_pos hC_anc (pow_pos (by positivity) 2)) (Real.rpow_pos_of_pos hD₀_pos _)
  have h_poly_bdd : ∀ n ≥ N_init,
      ∀ Y ∈ Metric.closedBall Y_star (2 * δ_Y),
      ∀ T ∈ Metric.closedBall T_star (2 * ρ_T),
        (expBasePt seq n + (seq.ℓ_seq n : ℂ) * Y, T / (seq.m_seq n : ℂ)) ∈ U_phys n ∧
        ‖rescaledLift seq (s_tilde n) n Y T - Y‖ ≤ M_star := by
    intro n hn Y hY T hT
    rcases h_poly_cone Y hY T hT with ⟨hY_lo, hY_anc, hY_hi, hY_re, hT_lt2⟩
    rcases hWit n hn with ⟨_, _, _, _, _, _, _, _, _, hCone, _⟩
    have hc := hCone (Y, T) ⟨hY_anc, hY_hi, hY_re, hT_lt2⟩
    refine ⟨hc.1, ?_⟩
    have hrpow : (-Y.im) ^ (1 - 2 * α) ≤ D₀ ^ (1 - 2 * α) :=
      Real.rpow_le_rpow_of_nonpos hD₀_pos hY_lo.le (by linarith)
    have hT_sq : ‖T‖ ^ 2 ≤ (2 * T_max) ^ 2 :=
      pow_le_pow_left₀ (norm_nonneg T) hT_lt2.le 2
    have h1 : C_anc * ‖T‖ ^ 2 * (-Y.im) ^ (1 - 2 * α) ≤ M_star := by
      dsimp [M_star]
      have h_nonneg : 0 ≤ (-Y.im) ^ (1 - 2 * α) :=
        Real.rpow_nonneg (lt_trans hD₀_pos hY_lo).le _
      exact mul_le_mul (mul_le_mul_of_nonneg_left hT_sq hC_anc.le) hrpow h_nonneg (by positivity)
    exact le_trans hc.2.2 h1
  have h_slice_lip : ∀ n ≥ N_init,
      ∀ Y ∈ Metric.ball Y_star δ_Y, ∀ T ∈ Metric.ball T_star ρ_T,
        ‖rescaledLift seq (s_tilde n) n Y T - rescaledLift seq (s_tilde n) n Y_star T_star‖ ≤
          (M_star / ρ_T) * ‖T - T_star‖ + (M_star / δ_Y + 1) * ‖Y - Y_star‖ := by
    intro n hn Y hY T hT
    rcases hWit n hn with ⟨_, _, _, _, hHolo, _, _, _, _, _, _⟩
    have hY_cb : Y ∈ Metric.closedBall Y_star (2 * δ_Y) :=
      Metric.ball_subset_closedBall (Metric.ball_subset_ball (by linarith) hY)
    have hT_star_cb : T_star ∈ Metric.closedBall T_star (2 * ρ_T) :=
      Metric.mem_closedBall_self (by positivity)
    
    let g₁ : ℂ → ℂ := fun T' => rescaledLift seq (s_tilde n) n Y T' - Y
    have hg₁_holo : DifferentiableOn ℂ g₁ (Metric.closedBall T_star (2 * ρ_T)) := by
      let φ_T : ℂ → ℂ × ℂ := fun T' =>
        (expBasePt seq n + (seq.ℓ_seq n : ℂ) * Y, T' * ((seq.m_seq n : ℂ))⁻¹)
      have hφ_diff : Differentiable ℂ φ_T :=
        (differentiable_const _).prodMk (differentiable_id.mul_const _)
      have hφ_maps : Set.MapsTo φ_T (Metric.closedBall T_star (2 * ρ_T)) (U_phys n) := by
        intro T' hT'
        simpa [φ_T, div_eq_mul_inv] using (h_poly_bdd n hn Y hY_cb T' hT').1
      have h_comp : DifferentiableOn ℂ
          (fun T' => ((s_tilde n (φ_T T') - expBasePt seq n) * ((seq.ℓ_seq n : ℂ))⁻¹) - Y)
          (Metric.closedBall T_star (2 * ρ_T)) :=
        (((hHolo.comp hφ_diff.differentiableOn hφ_maps).sub
          (differentiableOn_const _)).mul_const _).sub (differentiableOn_const _)
      exact h_comp.congr fun T' _ => by dsimp [g₁, rescaledLift, φ_T]; simp [div_eq_mul_inv]
    have h_ball_T : ∀ w ∈ Metric.ball T_star ρ_T,
        Metric.closedBall w ρ_T ⊆ Metric.closedBall T_star (2 * ρ_T) := by
      intro w hw z hz
      rw [Metric.mem_ball] at hw
      rw [Metric.mem_closedBall] at hz ⊢
      calc dist z T_star ≤ dist z w + dist w T_star := dist_triangle z w T_star
        _ ≤ ρ_T + ρ_T := add_le_add hz hw.le
        _ = 2 * ρ_T := by ring
    have hg₁_lip := h_lip_of_holo_bdd (Metric.ball T_star ρ_T)
      (Metric.closedBall T_star (2 * ρ_T)) ρ_T M_star g₁
      Metric.isOpen_ball (convex_ball T_star ρ_T) hρ_T_pos h_ball_T hg₁_holo
      (fun T' hT' => (h_poly_bdd n hn Y hY_cb T' hT').2)
      T hT T_star (Metric.mem_ball_self hρ_T_pos)
    
    let g₂ : ℂ → ℂ := fun Y' => rescaledLift seq (s_tilde n) n Y' T_star - Y'
    have hg₂_holo : DifferentiableOn ℂ g₂ (Metric.closedBall Y_star (2 * δ_Y)) := by
      let φ_Y : ℂ → ℂ × ℂ := fun Y' =>
        (expBasePt seq n + (seq.ℓ_seq n : ℂ) * Y', T_star / (seq.m_seq n : ℂ))
      have hφ_diff : Differentiable ℂ φ_Y :=
