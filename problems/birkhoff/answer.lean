    have he_X : IsRealJetPerturb p ((4 * (q : ℝ))⁻¹) (d (j + 1)) :=
      hJet_mono hRq2_le (hd.2.2.2.1 (j + 1) (by omega))
    have hτ_t : IsRealJetPerturb p ((4 * (q : ℝ))⁻¹) (fun x => d (j + 2) x - d (j + 1) x) :=
      hJet_mono hRq3_le (hd.2.2.2.2 (j + 1) hj)
    have hτ_s : IsRealJetPerturb p ((4 * (q : ℝ))⁻¹) (fun x => d (j + 1) x - d j x) :=
