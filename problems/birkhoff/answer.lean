          _ < L_α * (ε / L_α) := mul_lt_mul_of_pos_left hdist hLα_pos
          _ = ε := mul_div_cancel₀ ε (ne_of_gt hLα_pos)
  · intro σ q w₁ w₂ W₁ W₂ X_ℂ₁ μ_ℂ₁ X_ℂ₂ μ_ℂ₂ xInvMinus₁ xInvPlus₁ xInvMinus₂ xInvPlus₂
      hσ hq hKinv_lt hAdm₁ hAdm₂ j hj α hα k hk z hz
    obtain ⟨_, hq2_pos, hKm_lt1, hσm_pos, hσi_pos, hδ0, hδ_le, _⟩ :=
      hScaleProps hσ hq hKinv_lt
    have hNm_le_q : S.N_mesh ≤ q := le_trans hN_le hq
    obtain ⟨hw₁, hW₁, hMesh₁, hInv₁⟩ := hAdm₁
    obtain ⟨hw₂, hW₂, hMesh₂, hInv₂⟩ := hAdm₂
    obtain ⟨hm₁, hp₁⟩ :=
      (hMeshPerturbSingle hσ hNm_le_q hKm_lt1 hMesh₁ j hj).1 α hα
    obtain ⟨hm₂, hp₂⟩ :=
      (hMeshPerturbSingle hσ hNm_le_q hKm_lt1 hMesh₂ j hj).1 α hα
    have hLipPert :=
      hMeshPerturbLip hσ hNm_le_q hKm_lt1 hw₁ hw₂ hW₁ hW₂ hMesh₁ hMesh₂ j hj α hα
    obtain ⟨hxm₁_holo, hxp₁_holo, hmaps₁, hfwd₁, _, _, _⟩ := (hInv₁ j hj).1 α hα
    obtain ⟨hxm₂_holo, hxp₂_holo, hmaps₂, hfwd₂, _, _, _⟩ := (hInv₂ j hj).1 α hα
    let σ_mesh := (1 - S.K_mesh / (q : ℝ) ^ 2) * σ
    let σ_inv := (1 - K_inv / (q : ℝ) ^ 2) * σ
    let δ_e := 3 * S.R_mesh / (q : ℝ) ^ 2
    let Δ_W := stripDiffSup (m + 15) σ W₁ W₂
    have hΔW_pos : 0 ≤ Δ_W := hSupNonneg σ W₁ W₂
    have hRightM₁ : IsShciShiftRightInv σ_mesh σ_inv (shciShiftMinus q j α)
        (shciPerturbMinus q X_ℂ₁ μ_ℂ₁ j α) (xInvMinus₁ j α) :=
      ⟨hxm₁_holo, fun ζ hζ => (hmaps₁ ζ hζ).1, fun ζ hζ => by
        have h := (hfwd₁ ζ hζ).1
        dsimp [shciPerturbMinus]
        linear_combination h⟩
    have hRightM₂ : IsShciShiftRightInv σ_mesh σ_inv (shciShiftMinus q j α)
        (shciPerturbMinus q X_ℂ₂ μ_ℂ₂ j α) (xInvMinus₂ j α) :=
      ⟨hxm₂_holo, fun ζ hζ => (hmaps₂ ζ hζ).1, fun ζ hζ => by
        have h := (hfwd₂ ζ hζ).1
        dsimp [shciPerturbMinus]
        linear_combination h⟩
    have hRightP₁ : IsShciShiftRightInv σ_mesh σ_inv (shciShiftPlus q j α)
        (shciPerturbPlus q X_ℂ₁ μ_ℂ₁ j α) (xInvPlus₁ j α) :=
      ⟨hxp₁_holo, fun ζ hζ => (hmaps₁ ζ hζ).2, fun ζ hζ => by
        have h := (hfwd₁ ζ hζ).2
        dsimp [shciPerturbPlus]
        linear_combination h⟩
    have hRightP₂ : IsShciShiftRightInv σ_mesh σ_inv (shciShiftPlus q j α)
        (shciPerturbPlus q X_ℂ₂ μ_ℂ₂ j α) (xInvPlus₂ j α) :=
      ⟨hxp₂_holo, fun ζ hζ => (hmaps₂ ζ hζ).2, fun ζ hζ => by
        have h := (hfwd₂ ζ hζ).2
        dsimp [shciPerturbPlus]
        linear_combination h⟩
    have hLk_le : shciJetL k ≤ max (shciJetB (m + 1)) (shciJetL (m + 1)) :=
      le_trans (hJetLMono hk) (le_max_right _ _)
    have hq2_cancel : (q : ℝ) ^ 2 * (shciJetL k * (0 + δ_e * Δ_W)) =
        (3 * S.R_mesh * shciJetL k) * Δ_W := by
      dsimp [δ_e]
      field_simp [ne_of_gt hq2_pos]
      ring
    refine ⟨?_, ?_⟩
    · have hb := hJetDiff (m + 1) hσm_pos hσi_pos hδ0 hδ_le (mul_nonneg hδ0 hΔW_pos)
        hm₁.1 hm₂.1
        (fun r hr ζ hζ => ⟨hm₁.2.2.2.2 r hr ζ hζ, hm₂.2.2.2.2 r hr ζ hζ⟩)
        (fun r hr ζ hζ => (hLipPert r hr ζ hζ).1)
        hRightM₁ hRightM₂ k hk z hz
      rw [sub_self, abs_zero] at hb
      calc (q : ℝ) ^ 2 *
            ‖iteratedDeriv k (fun ζ : ℂ => xInvMinus₁ j α ζ - xInvMinus₂ j α ζ) z‖
          ≤ (q : ℝ) ^ 2 * (shciJetL k * (0 + δ_e * Δ_W)) :=
            mul_le_mul_of_nonneg_left hb (le_of_lt hq2_pos)
        _ = (3 * S.R_mesh * shciJetL k) * Δ_W := hq2_cancel
        _ ≤ (3 * S.R_mesh * max (shciJetB (m + 1)) (shciJetL (m + 1))) * Δ_W :=
            mul_le_mul_of_nonneg_right
              (mul_le_mul_of_nonneg_left hLk_le (by linarith)) hΔW_pos
        _ ≤ C_inv * Δ_W :=
            mul_le_mul_of_nonneg_right (by dsimp [C_inv]; linarith) hΔW_pos
    · have hb := hJetDiff (m + 1) hσm_pos hσi_pos hδ0 hδ_le (mul_nonneg hδ0 hΔW_pos)
        hp₁.1 hp₂.1
        (fun r hr ζ hζ => ⟨hp₁.2.2.2.2 r hr ζ hζ, hp₂.2.2.2.2 r hr ζ hζ⟩)
        (fun r hr ζ hζ => (hLipPert r hr ζ hζ).2)
        hRightP₁ hRightP₂ k hk z hz
      rw [sub_self, abs_zero] at hb
      calc (q : ℝ) ^ 2 *
            ‖iteratedDeriv k (fun ζ : ℂ => xInvPlus₁ j α ζ - xInvPlus₂ j α ζ) z‖
          ≤ (q : ℝ) ^ 2 * (shciJetL k * (0 + δ_e * Δ_W)) :=
            mul_le_mul_of_nonneg_left hb (le_of_lt hq2_pos)
        _ = (3 * S.R_mesh * shciJetL k) * Δ_W := hq2_cancel
        _ ≤ (3 * S.R_mesh * max (shciJetB (m + 1)) (shciJetL (m + 1))) * Δ_W :=
            mul_le_mul_of_nonneg_right
              (mul_le_mul_of_nonneg_left hLk_le (by linarith)) hΔW_pos
        _ ≤ C_inv * Δ_W :=
            mul_le_mul_of_nonneg_right (by dsimp [C_inv]; linarith) hΔW_pos

theorem strip_ker_calc_toolkit : SkrCalcToolkit :=
by
  have hOpenStrip : ∀ H : ℝ, IsOpen (horizStrip H) := fun H =>
    isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const
  have hConvStrip : ∀ H : ℝ, Convex ℝ (horizStrip H) := by
    intro H
    have hEq : horizStrip H = Complex.imLm ⁻¹' Set.Ioo (-H) H := by
      ext s
      change |s.im| < H ↔ -H < Complex.imLm s ∧ Complex.imLm s < H
      rw [Complex.imLm_coe, abs_lt]
    rw [hEq]
    exact (convex_Ioo (-H) H).linear_preimage Complex.imLm
  have hMemTauSeg : ∀ (σ τ c : ℝ) (z H : ℂ),
      τ ∈ Set.Icc (0 : ℝ) 1 →
      c ∈ Set.Icc (-τ) (1 - τ) →
      z - (τ : ℂ) * H ∈ horizStrip σ →
      z + ((1 - τ : ℝ) : ℂ) * H ∈ horizStrip σ →
      z + (c : ℂ) * H ∈ horizStrip σ := by
    intro σ τ c z H _hτ hc hA hB'
    have ha : 0 ≤ 1 - τ - c := by linarith [hc.2]
    have hb : 0 ≤ c + τ := by linarith [hc.1]
    have hab : (1 - τ - c) + (c + τ) = 1 := by ring
    have hmem := hConvStrip σ hA hB' ha hb hab
    have hlin :
        (1 - τ - c) • (z - (τ : ℂ) * H) + (c + τ) • (z + ((1 - τ : ℝ) : ℂ) * H) =
          z + (c : ℂ) * H := by
      simp only [Complex.real_smul]
      push_cast
      ring
    rwa [hlin] at hmem
  have hHoloIter : ∀ {σ' : ℝ} {f : ℂ → ℂ},
      DifferentiableOn ℂ f (horizStrip σ') →
      ∀ n : ℕ, DifferentiableOn ℂ (iteratedDeriv n f) (horizStrip σ') := by
    intro σ' f hf n
    induction n with
    | zero =>
      simpa only [iteratedDeriv_zero] using hf
    | succ n ih =>
      rw [iteratedDeriv_succ]
      exact ih.deriv (hOpenStrip σ')
  have hContDiffAt : ∀ {σ' : ℝ} {f : ℂ → ℂ} {z : ℂ} (n : ℕ),
      DifferentiableOn ℂ f (horizStrip σ') → z ∈ horizStrip σ' →
      ContDiffAt ℂ (n : WithTop ℕ∞) f z := fun n hf hz =>
    ((hf.contDiffOn (hOpenStrip _)).contDiffAt ((hOpenStrip _).mem_nhds hz)).of_le le_top
  have hStripExtDeriv : ∀ (r₀ d : ℕ) (σ M₁ : ℝ) (w : ℝ → ℝ) (W : ℂ → ℂ),
      0 < σ →
      IsBoundedStripExt r₀ σ M₁ w W →
      d ≤ r₀ →
      DifferentiableOn ℂ (iteratedDeriv d W) (horizStrip σ) ∧
      ∀ j : ℕ, j + d ≤ r₀ → ∀ ζ ∈ horizStrip σ,
        ‖iteratedDeriv j (iteratedDeriv d W) ζ‖ ≤ M₁ := by
    intro r₀ d σ M₁ w W _hσ hW _hd
    refine ⟨hHoloIter hW.1 d, ?_⟩
    intro j hjd ζ hζ
    rw [iteratedDeriv_eq_iterate, iteratedDeriv_eq_iterate, ← Function.iterate_add_apply,
      ← iteratedDeriv_eq_iterate]
    exact hW.2.2.2.2 (j + d) hjd ζ hζ
  have hStripDiffSup : ∀ (r₀ : ℕ) (σ M₁ : ℝ) (w₁ w₂ : ℝ → ℝ) (W₁ W₂ : ℂ → ℂ),
      0 < σ →
      IsBoundedStripExt r₀ σ M₁ w₁ W₁ →
      IsBoundedStripExt r₀ σ M₁ w₂ W₂ →
      0 ≤ stripDiffSup r₀ σ W₁ W₂ ∧
      ∀ (j d : ℕ), j + d ≤ r₀ → ∀ ζ ∈ horizStrip σ,
        ‖iteratedDeriv j (fun z => iteratedDeriv d W₁ z - iteratedDeriv d W₂ z) ζ‖ ≤
          stripDiffSup r₀ σ W₁ W₂ := by
    intro r₀ σ M₁ w₁ w₂ W₁ W₂ _hσ hW₁ hW₂
    refine ⟨?_, ?_⟩
    · apply Real.sSup_nonneg
      rintro r ⟨j, _, ζ, _, rfl⟩
      exact norm_nonneg _
    · have hBdd : BddAbove { r : ℝ | ∃ k ≤ r₀, ∃ z ∈ horizStrip σ,
          r = ‖iteratedDeriv k (W₁ - W₂) z‖ } := by
        refine ⟨M₁ + M₁, ?_⟩
        rintro r ⟨k, hk, z, hz, rfl⟩
        rw [iteratedDeriv_sub (hContDiffAt k hW₁.1 hz) (hContDiffAt k hW₂.1 hz)]
        exact le_trans (norm_sub_le _ _)
          (add_le_add (hW₁.2.2.2.2 k hk z hz) (hW₂.2.2.2.2 k hk z hz))
      intro j d hjd ζ hζ
      have hEqOn : Set.EqOn
          (fun z => iteratedDeriv d W₁ z - iteratedDeriv d W₂ z)
          (iteratedDeriv d (W₁ - W₂)) (horizStrip σ) := by
        intro z hz
        exact (iteratedDeriv_sub (hContDiffAt d hW₁.1 hz) (hContDiffAt d hW₂.1 hz)).symm
      rw [(hEqOn.eventuallyEq_of_mem ((hOpenStrip σ).mem_nhds hζ)).iteratedDeriv_eq j]
      rw [iteratedDeriv_eq_iterate, iteratedDeriv_eq_iterate, ← Function.iterate_add_apply,
        ← iteratedDeriv_eq_iterate]
      exact le_csSup hBdd ⟨j + d, hjd, ζ, hζ, rfl⟩
  have hBndCongr : ∀ {p : ℕ} {σ' B : ℝ} {f g : ℂ → ℂ},
      IsSkrStripBnd p σ' B f →
      Set.EqOn g f (horizStrip σ') →
      IsSkrStripBnd p σ' B g := by
    intro p σ' B f g hf hgf
    refine ⟨hf.1.congr hgf, ?_⟩
    intro k hk z hz
    rw [(hgf.eventuallyEq_of_mem ((hOpenStrip σ').mem_nhds hz)).iteratedDeriv_eq k]
    exact hf.2 k hk z hz
  have hBndConst : ∀ (p : ℕ) (σ' : ℝ) (c : ℂ),
      IsSkrStripBnd p σ' ‖c‖ (fun _ => c) := by
    intro p σ' c
    refine ⟨differentiableOn_const c, ?_⟩
    intro k _hk z _hz
    rw [iteratedDeriv_const]
    split_ifs
    · exact le_rfl
    · simp only [norm_zero, norm_nonneg]
  have hBndMono : ∀ {p : ℕ} {σ' B₁ B₂ : ℝ} {f : ℂ → ℂ},
      B₁ ≤ B₂ → IsSkrStripBnd p σ' B₁ f → IsSkrStripBnd p σ' B₂ f :=
    fun hB hf => ⟨hf.1, fun k hk z hz => le_trans (hf.2 k hk z hz) hB⟩
  have hBndAdd : ∀ {p : ℕ} {σ' B₁ B₂ : ℝ} {f g : ℂ → ℂ},
      IsSkrStripBnd p σ' B₁ f → IsSkrStripBnd p σ' B₂ g →
      IsSkrStripBnd p σ' (B₁ + B₂) (fun z => f z + g z) := by
    intro p σ' B₁ B₂ f g hf hg
    refine ⟨hf.1.add hg.1, ?_⟩
    intro k hk z hz
    rw [iteratedDeriv_fun_add (hContDiffAt k hf.1 hz) (hContDiffAt k hg.1 hz)]
    exact le_trans (norm_add_le _ _) (add_le_add (hf.2 k hk z hz) (hg.2 k hk z hz))
  have hBndNeg : ∀ {p : ℕ} {σ' B : ℝ} {f : ℂ → ℂ},
      IsSkrStripBnd p σ' B f → IsSkrStripBnd p σ' B (fun z => -f z) := by
    intro p σ' B f hf
    refine ⟨hf.1.neg, ?_⟩
    intro k hk z hz
    rw [iteratedDeriv_fun_neg, norm_neg]
    exact hf.2 k hk z hz
  have hBndSub : ∀ {p : ℕ} {σ' B₁ B₂ : ℝ} {f g : ℂ → ℂ},
      IsSkrStripBnd p σ' B₁ f → IsSkrStripBnd p σ' B₂ g →
      IsSkrStripBnd p σ' (B₁ + B₂) (fun z => f z - g z) := by
    intro p σ' B₁ B₂ f g hf hg
    have hfn : (fun z => f z - g z) = (fun z => f z + -g z) := by
      ext z; exact sub_eq_add_neg (f z) (g z)
    rw [hfn]
    exact hBndAdd hf (hBndNeg hg)
  have hBndConstMul : ∀ {p : ℕ} {σ' B : ℝ} (c : ℂ) {f : ℂ → ℂ},
      0 ≤ B → IsSkrStripBnd p σ' B f →
      IsSkrStripBnd p σ' (‖c‖ * B) (fun z => c * f z) := by
    intro p σ' B c f _hB hf
    refine ⟨hf.1.const_mul c, ?_⟩
    intro k hk z hz
    rw [iteratedDeriv_const_mul c (hContDiffAt k hf.1 hz), norm_mul]
    exact mul_le_mul_of_nonneg_left (hf.2 k hk z hz) (norm_nonneg c)
  have hBndMul : ∀ {p : ℕ} {σ' B₁ B₂ : ℝ} {f g : ℂ → ℂ},
      IsSkrStripBnd p σ' B₁ f → IsSkrStripBnd p σ' B₂ g →
      IsSkrStripBnd p σ' ((2 : ℝ) ^ p * B₁ * B₂) (fun z => f z * g z) := by
    intro p σ' B₁ B₂ f g hf hg
    refine ⟨hf.1.mul hg.1, ?_⟩
    intro k hk z hz
    have hB₁_nn : 0 ≤ B₁ := le_trans (norm_nonneg _) (hf.2 0 (Nat.zero_le p) z hz)
    have hB₂_nn : 0 ≤ B₂ := le_trans (norm_nonneg _) (hg.2 0 (Nat.zero_le p) z hz)
    rw [iteratedDeriv_fun_mul (hContDiffAt k hf.1 hz) (hContDiffAt k hg.1 hz)]
    have hsum_le :
        ‖∑ i ∈ Finset.range (k + 1),
          (k.choose i : ℂ) * iteratedDeriv i f z * iteratedDeriv (k - i) g z‖ ≤
        ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * (B₁ * B₂) := by
      refine le_trans (norm_sum_le _ _) (Finset.sum_le_sum ?_)
      intro i hi
      have hik : i ≤ k := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
      have hip : i ≤ p := le_trans hik hk
      have hkip : k - i ≤ p := le_trans (Nat.sub_le k i) hk
      rw [mul_assoc, norm_mul, norm_mul, Complex.norm_natCast]
      exact mul_le_mul_of_nonneg_left
        (mul_le_mul (hf.2 i hip z hz) (hg.2 (k - i) hkip z hz) (norm_nonneg _) hB₁_nn)
        (Nat.cast_nonneg _)
    have hchoose :
        (∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * (B₁ * B₂)) =
          (2 : ℝ) ^ k * B₁ * B₂ := by
      rw [← Finset.sum_mul]
      have hc : (∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ)) = (2 : ℝ) ^ k := by
        exact_mod_cast Nat.sum_range_choose k
      rw [hc, mul_assoc]
    have hpow : (2 : ℝ) ^ k * B₁ * B₂ ≤ (2 : ℝ) ^ p * B₁ * B₂ := by
      have h2 : (2 : ℝ) ^ k ≤ (2 : ℝ) ^ p := pow_le_pow_right₀ (by norm_num) hk
      nlinarith [mul_nonneg hB₁_nn hB₂_nn]
    exact le_trans hsum_le (by rw [hchoose]; exact hpow)
  have hBndMulDiff : ∀ {p : ℕ} {σ' M_f M_g Δf Δg : ℝ} {f₁ f₂ g₁ g₂ : ℂ → ℂ},
      IsSkrStripBnd p σ' M_f f₁ →
      IsSkrStripBnd p σ' M_g g₂ →
      IsSkrStripBnd p σ' Δf (fun z => f₁ z - f₂ z) →
      IsSkrStripBnd p σ' Δg (fun z => g₁ z - g₂ z) →
      IsSkrStripBnd p σ' ((2 : ℝ) ^ p * (M_f * Δg + Δf * M_g))
        (fun z => f₁ z * g₁ z - f₂ z * g₂ z) := by
    intro p σ' M_f M_g Δf Δg f₁ f₂ g₁ g₂ hf₁ hg₂ hdf hdg
    have hfn : (fun z => f₁ z * g₁ z - f₂ z * g₂ z) =
        (fun z => f₁ z * (g₁ z - g₂ z) + (f₁ z - f₂ z) * g₂ z) := by
      ext z; ring
    have hval : (2 : ℝ) ^ p * M_f * Δg + (2 : ℝ) ^ p * Δf * M_g =
        (2 : ℝ) ^ p * (M_f * Δg + Δf * M_g) := by ring
    rw [hfn, ← hval]
    exact hBndAdd (hBndMul hf₁ hdg) (hBndMul hdf hg₂)
  have hNormExp : ∀ ζ : ℂ, ‖Complex.exp ζ‖ ≤ Real.exp ‖ζ‖ := by
    intro ζ
    rw [Complex.norm_exp]
    exact Real.exp_le_exp.mpr (le_trans (le_abs_self ζ.re) (Complex.abs_re_le_norm ζ))
  have hExpIter : ∀ j : ℕ, iteratedDeriv j Complex.exp = Complex.exp := by
    intro j
    induction j with
    | zero => exact iteratedDeriv_zero
    | succ j ih => rw [iteratedDeriv_succ', Complex.deriv_exp, ih]
  have hExpBall : ∀ (R : ℝ), 0 < R →
      DifferentiableOn ℂ Complex.exp (Metric.ball (0 : ℂ) R) ∧
      ∀ j : ℕ, ∀ w ∈ Metric.ball (0 : ℂ) R, ‖iteratedDeriv j Complex.exp w‖ ≤ Real.exp R := by
    intro R _hR
    refine ⟨Complex.differentiable_exp.differentiableOn, ?_⟩
    intro j w hw
    rw [hExpIter j]
    exact le_trans (hNormExp w)
      (Real.exp_le_exp.mpr (le_of_lt (by simpa [Metric.mem_ball, dist_zero_right] using hw)))
  have hCosSinIter : ∀ j : ℕ, ∀ w : ℂ,
      ‖iteratedDeriv j Complex.cos w‖ ≤ Real.exp ‖w‖ ∧
      ‖iteratedDeriv j Complex.sin w‖ ≤ Real.exp ‖w‖ := by
    intro j
    induction j with
    | zero =>
      intro w
      simp only [iteratedDeriv_zero]
      have hwI : ‖w * Complex.I‖ = ‖w‖ := by rw [norm_mul, Complex.norm_I, mul_one]
      have hnwI : ‖-w * Complex.I‖ = ‖w‖ := by rw [norm_mul, norm_neg, Complex.norm_I, mul_one]
      have he₁ : ‖Complex.exp (w * Complex.I)‖ ≤ Real.exp ‖w‖ := by
        simpa [hwI] using hNormExp (w * Complex.I)
      have he₂ : ‖Complex.exp (-w * Complex.I)‖ ≤ Real.exp ‖w‖ := by
        simpa [hnwI] using hNormExp (-w * Complex.I)
      refine ⟨?_, ?_⟩
      · rw [Complex.cos, norm_div, Complex.norm_ofNat]
        have hsum := le_trans (norm_add_le _ _) (add_le_add he₁ he₂)
        linarith
      · rw [Complex.sin, norm_div, norm_mul, Complex.norm_I, mul_one, Complex.norm_ofNat]
        have hsub := le_trans (norm_sub_le _ _) (add_le_add he₂ he₁)
        linarith
    | succ j ih =>
      intro w
      refine ⟨?_, ?_⟩
      · have hdcos : deriv Complex.cos = fun z => -Complex.sin z := by
          ext z; simp [Complex.deriv_cos]
        rw [iteratedDeriv_succ', hdcos, iteratedDeriv_fun_neg, norm_neg]
        exact (ih w).2
      · rw [iteratedDeriv_succ', Complex.deriv_sin]
        exact (ih w).1
  have hCosBall : ∀ (R : ℝ), 0 < R →
      DifferentiableOn ℂ Complex.cos (Metric.ball (0 : ℂ) R) ∧
      ∀ j : ℕ, ∀ w ∈ Metric.ball (0 : ℂ) R, ‖iteratedDeriv j Complex.cos w‖ ≤ Real.exp R := by
    intro R _hR
    refine ⟨Complex.differentiable_cos.differentiableOn, ?_⟩
    intro j w hw
    exact le_trans ((hCosSinIter j w).1)
