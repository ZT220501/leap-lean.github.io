      have h_ev : ∀ᶠ q in nhds q₁, q ∈ B₁₂ ∧ ssbpcPairDenProd E₀ E₁ p₁ q ≠ 0 :=
        Filter.eventually_and.mpr ⟨hB₁₂_open.mem_nhds hq₁_mem,
