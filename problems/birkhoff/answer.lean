                  (MvPowerSeries.coeff d (P2 * Q2) - MvPowerSeries.coeff d (P2_0 * Q2_0)) := by
                simp only [map_sub, map_add]; ring
              rw [h_lin, hM1, hM2, hηψ_d, hηd_d]
              ring
            · have h_lin : MvPowerSeries.coeff d ((P1 * Q1 - P2 * Q2) - (P1_0 * Q1_0 - P2_0 * Q2_0)) =
                  (MvPowerSeries.coeff d (P1 * Q1) - MvPowerSeries.coeff d (P1_0 * Q1_0)) -
                  (MvPowerSeries.coeff d (P2 * Q2) - MvPowerSeries.coeff d (P2_0 * Q2_0)) := by
                simp only [map_sub]; ring
              rw [h_lin, hM1, hM2, hηψ_d, hηd_d]
              ring
          
          let H_mat := lcJetFormalHess h_ser s_d c_d
          let x_vec : Fin (k - 1) → ℂ :=
            fun s => MvPowerSeries.coeff d (η ⟨s.1 + 1, by have := s.2; omega⟩)
          let b_vec : Fin (k - 1) → ℂ :=
            fun r => -MvPowerSeries.coeff d (lcJetGrad2D h_tr S_ser C_ser α_ref r)
