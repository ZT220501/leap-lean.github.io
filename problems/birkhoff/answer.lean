      fun_prop
    have hQ_zero : Q_N 0 = 0 := by
      simp [Q_N]
    have hg_zero : g 0 = 0 := by
      simp [g, hQ_zero]
    
    have h_range_split : ∀ {M : Type} [AddCommMonoid M] (n : ℕ) (φ : ℕ → M),
