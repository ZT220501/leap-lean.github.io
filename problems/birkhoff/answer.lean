        filter_upwards [hmem] with w ⟨hwB, hw_ne⟩
        obtain ⟨hwD, hfw⟩ := hball w hwB hw_ne
        exact (hH0_reg_per w hwD hfw).symm
      have ht1 : Filter.Tendsto (supportProfileH0 K)
          (nhdsWithin s {s}ᶜ) (nhds (supportProfileH0 K s)) :=
        tendsto_nhdsWithin_of_tendsto_nhds (hH0_diffAt s hs).continuousAt
      have hshift_cont : ContinuousAt (fun w : ℂ => w + 2 * Real.pi) s :=
        continuousAt_id.add continuousAt_const
      have ht2 : Filter.Tendsto (fun w => supportProfileH0 K (w + 2 * Real.pi))
          (nhdsWithin s {s}ᶜ) (nhds (supportProfileH0 K (s + 2 * Real.pi))) :=
        tendsto_nhdsWithin_of_tendsto_nhds
          ((hH0_diffAt (s + 2 * Real.pi) hs_per).continuousAt.tendsto.comp hshift_cont.tendsto)
      exact tendsto_nhds_unique ht2 (ht1.congr' hev)
    · exact hH0_reg_per s hs hfs
  have hH0_conj : ∀ s ∈ D_H,
      supportProfileH0 K (starRingEnd ℂ s) = starRingEnd ℂ (supportProfileH0 K s) := by
    intro s hs
    by_cases hfs : K.f s = 0
    · obtain ⟨ρ, hρ, hball⟩ := (hH0_zero s hs hfs).2
      have hs_conj : starRingEnd ℂ s ∈ D_H := hD_conj s hs
      have hmem : Metric.ball s ρ \ {s} ∈ nhdsWithin s {s}ᶜ :=
        Filter.inter_mem
          (nhdsWithin_le_nhds (Metric.isOpen_ball.mem_nhds (Metric.mem_ball_self hρ)))
          self_mem_nhdsWithin
      have hev : (fun w => starRingEnd ℂ (supportProfileH0 K w)) =ᶠ[nhdsWithin s {s}ᶜ]
          fun w => supportProfileH0 K (starRingEnd ℂ w) := by
        filter_upwards [hmem] with w ⟨hwB, hw_ne⟩
        obtain ⟨hwD, hfw⟩ := hball w hwB hw_ne
        exact (hH0_reg_conj w hwD hfw).symm
      have ht1 : Filter.Tendsto (fun w => starRingEnd ℂ (supportProfileH0 K w))
          (nhdsWithin s {s}ᶜ) (nhds (starRingEnd ℂ (supportProfileH0 K s))) :=
        tendsto_nhdsWithin_of_tendsto_nhds
          (Complex.continuous_conj.continuousAt.comp (hH0_diffAt s hs).continuousAt)
      have ht2 : Filter.Tendsto (fun w => supportProfileH0 K (starRingEnd ℂ w))
          (nhdsWithin s {s}ᶜ) (nhds (supportProfileH0 K (starRingEnd ℂ s))) :=
        tendsto_nhdsWithin_of_tendsto_nhds
          ((hH0_diffAt (starRingEnd ℂ s) hs_conj).continuousAt.comp
            Complex.continuous_conj.continuousAt)
      exact tendsto_nhds_unique ht2 (ht1.congr' hev)
    · exact hH0_reg_conj s hs hfs
  exact ⟨hq_holo, hderiv2_f, hq_per, hq_conj, hH0_holo, hH0_per, hH0_conj, hH0_eq, hH0_deriv⟩

theorem real_collar_chord_geometry (Ω : Set Plane)
    (C : AnalyticGlancingCollar Ω)
    (M : MeromorphicCollarData C)
    (K : NonisotropicCurveData C M)
    (L : NormalizedGlobalLiftData C M K) :
    RealCollarChordProp C M K L :=
by
  intro x t ht0 htr
  
  have ht_r_init : t < K.r_init := by linarith [L.r_star_le, K.r_init_pos]
  have ht_r_base : t < M.r_base := by linarith [K.r_init_le, M.r_base_pos]
  have ht_r₁ : t < C.r₁ := by linarith [M.r_base_lt_r₁, C.r₁_pos]
  have hs₁_pos : 0 < C.s₁ := by linarith [C.r₁_pos, C.r₁_lt_s₁]
  have ht_abs : |t| = t := abs_of_pos ht0
  have ht_abs_r₁ : |t| < C.r₁ := by rwa [ht_abs]
  have ht_norm : ‖(t : ℂ)‖ = t := by
    rw [Complex.norm_real, Real.norm_eq_abs, ht_abs]
  have ht_norm_init : ‖(t : ℂ)‖ < K.r_init := by rwa [ht_norm]
  have ht_norm_base : ‖(t : ℂ)‖ < M.r_base := by rwa [ht_norm]
  have ht_norm_r₁ : ‖(t : ℂ)‖ < C.r₁ := by rwa [ht_norm]
  have ht_ball_base : (t : ℂ) ∈ Metric.ball (0 : ℂ) M.r_base := by
    simpa using ht_norm_base
  let β : ℝ := (L.b_shift (t : ℂ)).re
  have hb_conj : starRingEnd ℂ (L.b_shift (t : ℂ)) = L.b_shift (t : ℂ) := by
    have h := L.b_shift_conj (t : ℂ) ht_ball_base
    rw [Complex.conj_ofReal] at h
    exact h.symm
  have hb_eq : L.b_shift (t : ℂ) = (β : ℂ) :=
    (Complex.conj_eq_iff_re.mp hb_conj).symm
  
  let v : ℝ → ℝ := fun w : ℝ => (C.U ((w : ℂ), (t : ℂ))).re
  have hU_real : ∀ w : ℝ, C.U ((w : ℂ), (t : ℂ)) = (v w : ℂ) := by
    intro w
    have hw_im : |(w : ℂ).im| < 2 * C.s₁ := by
      simp [Complex.ofReal_im]
      linarith
    have hc := C.U_conj (w : ℂ) (t : ℂ) hw_im ht_norm_r₁
    rw [Complex.conj_ofReal, Complex.conj_ofReal] at hc
    exact (Complex.conj_eq_iff_re.mp hc.symm).symm
  have hv_quasi : ∀ w : ℝ, v (w + 2 * Real.pi) = v w + 2 * Real.pi := by
    intro w
    have hw_im : |(w : ℂ).im| < 2 * C.s₁ := by
      simp [Complex.ofReal_im]
      linarith
    have hq := C.U_quasiperiodic (w : ℂ) (t : ℂ) hw_im ht_norm_r₁
    have hcast : (((w + 2 * Real.pi : ℝ) : ℂ), (t : ℂ)) =
        ((w : ℂ) + 2 * (Real.pi : ℂ), (t : ℂ)) := by
      ext <;> push_cast <;> ring
    have h1 : (v (w + 2 * Real.pi) : ℂ) = ((v w + 2 * Real.pi : ℝ) : ℂ) := by
      rw [← hU_real (w + 2 * Real.pi), hcast, hq, hU_real w]
      push_cast
      ring
    exact Complex.ofReal_inj.mp h1
  have hv_deriv_pos : ∀ w : ℝ, 0 < deriv v w :=
    fun w => C.U_real_deriv_pos w t ht_abs_r₁
  have hv_hasDeriv : ∀ w : ℝ, HasDerivAt v (deriv v w) w :=
    fun w => (differentiableAt_of_deriv_ne_zero (ne_of_gt (hv_deriv_pos w))).hasDerivAt
  
  have hglΘ_real : ∀ w : ℝ, glancingTheta C (w : ℂ) (t : ℂ) = (C.ϕ (v w) : ℂ) := by
    intro w
    unfold glancingTheta
    rw [hU_real w, C.ϕ_ℂ_real (v w)]
  have hΘ_real : ∀ r : ℝ, L.Θ_gl ((r : ℂ), (t : ℂ)) = (C.ϕ (v (r - β)) : ℂ) := by
    intro r
    change glancingTheta C ((r : ℂ) - L.b_shift (t : ℂ)) (t : ℂ) = (C.ϕ (v (r - β)) : ℂ)
    have hsub : (r : ℂ) - L.b_shift (t : ℂ) = ((r - β : ℝ) : ℂ) := by
      rw [hb_eq]
      push_cast
      ring
    rw [hsub, hglΘ_real (r - β)]
  have hp_add_half : ((x : ℂ) + (t : ℂ) / 2, (t : ℂ)) = (((x + t / 2 : ℝ) : ℂ), (t : ℂ)) := by
    ext <;> push_cast <;> ring
  have hp_sub_half : ((x : ℂ) - (t : ℂ) / 2, (t : ℂ)) = (((x - t / 2 : ℝ) : ℂ), (t : ℂ)) := by
    ext <;> push_cast <;> ring
  have hp_add_t : ((x : ℂ) + (t : ℂ), (t : ℂ)) = (((x + t : ℝ) : ℂ), (t : ℂ)) := by
    ext <;> push_cast <;> ring
  have hp_per_half :
      ((x : ℂ) + 2 * (Real.pi : ℂ) + (t : ℂ) / 2, (t : ℂ)) =
        (((x + 2 * Real.pi + t / 2 : ℝ) : ℂ), (t : ℂ)) := by
    ext <;> push_cast <;> ring
  let u : ℝ := x - β
  let θ₀ : ℝ := C.ϕ (v (u - t / 2))
  let θ₁ : ℝ := C.ϕ (v (u + t / 2))
  let θ₂ : ℝ := C.ϕ (v (u + 3 * t / 2))
  have hΘ_sub_eq : L.Θ_gl ((x : ℂ) - (t : ℂ) / 2, (t : ℂ)) = (θ₀ : ℂ) := by
    rw [hp_sub_half, hΘ_real (x - t / 2)]
    have hr : x - t / 2 - β = u - t / 2 := by dsimp [u]; ring
    rw [hr]
  have hΘ_add_eq : L.Θ_gl ((x : ℂ) + (t : ℂ) / 2, (t : ℂ)) = (θ₁ : ℂ) := by
    rw [hp_add_half, hΘ_real (x + t / 2)]
    have hr : x + t / 2 - β = u + t / 2 := by dsimp [u]; ring
    rw [hr]
  have hConj1 : (L.Θ_gl ((x : ℂ) + (t : ℂ) / 2, (t : ℂ))).im = 0 := by
    rw [hΘ_add_eq, Complex.ofReal_im]
  have hΘ_add_re : (L.Θ_gl ((x : ℂ) + (t : ℂ) / 2, (t : ℂ))).re = θ₁ := by
    rw [hΘ_add_eq, Complex.ofReal_re]
  have hΘ_sub_re : (L.Θ_gl ((x : ℂ) - (t : ℂ) / 2, (t : ℂ))).re = θ₀ := by
    rw [hΘ_sub_eq, Complex.ofReal_re]
  have hConj6 :
      (L.Θ_gl ((x : ℂ) + 2 * (Real.pi : ℂ) + (t : ℂ) / 2, (t : ℂ))).re =
        (L.Θ_gl ((x : ℂ) + (t : ℂ) / 2, (t : ℂ))).re + 2 * Real.pi := by
    rw [hp_per_half, hΘ_real (x + 2 * Real.pi + t / 2), Complex.ofReal_re, hΘ_add_re]
    have hr : x + 2 * Real.pi + t / 2 - β = (u + t / 2) + 2 * Real.pi := by dsimp [u]; ring
    rw [hr, hv_quasi (u + t / 2), C.ϕ_quasiperiodic (v (u + t / 2))]
  
  let σ : ℝ → ℝ := fun x' : ℝ => (L.𝔰 ((x' : ℂ), (t : ℂ))).re
  let e : ℂ → ℂ := fun z : ℂ => K.𝔰_init (z - (β : ℂ), (t : ℂ))
  have h𝔰_eq_init : ∀ x' : ℝ,
      L.𝔰 ((x' : ℂ), (t : ℂ)) = K.𝔰_init (((x' - β : ℝ) : ℂ), (t : ℂ)) := by
    intro x'
    change L.𝔰_raw ((x' : ℂ) - L.b_shift (t : ℂ), (t : ℂ)) =
      K.𝔰_init (((x' - β : ℝ) : ℂ), (t : ℂ))
    have hsub : (x' : ℂ) - L.b_shift (t : ℂ) = ((x' - β : ℝ) : ℂ) := by
      rw [hb_eq]
      push_cast
      ring
    rw [hsub]
    have him : |((x' - β : ℝ) : ℂ).im| < K.s_init := by
      simp [Complex.ofReal_im, K.s_init_pos]
    exact L.𝔰_raw_init_eq ((x' - β : ℝ) : ℂ) (t : ℂ) him ht_norm_init
  have h𝔰_real : ∀ x' : ℝ, L.𝔰 ((x' : ℂ), (t : ℂ)) = (σ x' : ℂ) := by
    intro x'
    have him : |((x' - β : ℝ) : ℂ).im| < K.s_init := by
      simp [Complex.ofReal_im, K.s_init_pos]
    have hc := K.𝔰_init_conj ((x' - β : ℝ) : ℂ) (t : ℂ) him ht_norm_init
    rw [Complex.conj_ofReal, Complex.conj_ofReal] at hc
    have h1 : K.𝔰_init (((x' - β : ℝ) : ℂ), (t : ℂ)) =
        ((K.𝔰_init (((x' - β : ℝ) : ℂ), (t : ℂ))).re : ℂ) :=
      (Complex.conj_eq_iff_re.mp hc.symm).symm
    have h2 : (K.𝔰_init (((x' - β : ℝ) : ℂ), (t : ℂ))).re = σ x' := by
      dsimp [σ]
      rw [h𝔰_eq_init x']
    rw [h𝔰_eq_init x', h1, h2]
  have hS_init_open : IsOpen { p : ℂ × ℂ | |p.1.im| < K.s_init ∧ ‖p.2‖ < K.r_init } :=
    (isOpen_lt (continuous_abs.comp (Complex.continuous_im.comp continuous_fst))
      continuous_const).inter
      (isOpen_lt (continuous_norm.comp continuous_snd) continuous_const)
  have hσ_hasDeriv : ∀ x' : ℝ, HasDerivAt σ (deriv σ x') x' := by
    intro x'
    have hp₀_mem : ((x' : ℂ) - (β : ℂ), (t : ℂ)) ∈
        { p : ℂ × ℂ | |p.1.im| < K.s_init ∧ ‖p.2‖ < K.r_init } := by
      have hsub : (x' : ℂ) - (β : ℂ) = ((x' - β : ℝ) : ℂ) := by push_cast; ring
      refine ⟨?_, ht_norm_init⟩
      rw [hsub]
      simp [Complex.ofReal_im, K.s_init_pos]
    have hdiff_init : DifferentiableAt ℂ K.𝔰_init ((x' : ℂ) - (β : ℂ), (t : ℂ)) :=
      K.𝔰_init_holo.differentiableAt (hS_init_open.mem_nhds hp₀_mem)
    have hdiff_map : DifferentiableAt ℂ (fun z : ℂ => (z - (β : ℂ), (t : ℂ))) (x' : ℂ) :=
      (differentiableAt_id.sub (differentiableAt_const (β : ℂ))).prodMk
        (differentiableAt_const (t : ℂ))
    have hdiff_e : DifferentiableAt ℂ e (x' : ℂ) :=
      DifferentiableAt.comp (x' : ℂ) hdiff_init hdiff_map
    have hd_re : HasDerivAt (fun r : ℝ => (e (r : ℂ)).re) (deriv e (x' : ℂ)).re x' :=
      hdiff_e.hasDerivAt.real_of_complex
    have he_eq_σ : (fun r : ℝ => (e (r : ℂ)).re) = σ := by
      funext r
      dsimp [e, σ]
      rw [h𝔰_eq_init r]
      have hsub : (r : ℂ) - (β : ℂ) = ((r - β : ℝ) : ℂ) := by push_cast; ring
      rw [hsub]
    rw [he_eq_σ] at hd_re
    exact hd_re.differentiableAt.hasDerivAt
  
  have hσ_mem_base : ∀ x' : ℝ, (σ x' : ℂ) ∈ horizStrip M.s_base := by
    intro x'
    change |(σ x' : ℂ).im| < M.s_base
    simp [Complex.ofReal_im, M.s_base_pos]
  have hKϕ_real : ∀ x' : ℝ, K.ϕ (L.𝔰 ((x' : ℂ), (t : ℂ))) = (C.ϕ (σ x') : ℂ) := by
    intro x'
    rw [h𝔰_real x', (K.base_ϕ_eq (σ x' : ℂ) (hσ_mem_base x')).1, C.ϕ_ℂ_real (σ x')]
  have h_mid : ∀ x' : ℝ,
      C.ϕ (σ x') = (1 / 2 : ℝ) * (C.ϕ (v (x' - β - t / 2)) + C.ϕ (v (x' - β + t / 2))) := by
    intro x'
    have him : |((x' - β : ℝ) : ℂ).im| < K.s_init := by
      simp [Complex.ofReal_im, K.s_init_pos]
    have h1 := K.𝔰_init_ϕ ((x' - β : ℝ) : ℂ) (t : ℂ) him ht_norm_init
    rw [← h𝔰_eq_init x', hKϕ_real x'] at h1
    unfold glancingMidAngle at h1
    have hs1 : ((x' - β : ℝ) : ℂ) - (t : ℂ) / 2 = ((x' - β - t / 2 : ℝ) : ℂ) := by
      push_cast; ring
    have hs2 : ((x' - β : ℝ) : ℂ) + (t : ℂ) / 2 = ((x' - β + t / 2 : ℝ) : ℂ) := by
      push_cast; ring
    rw [hs1, hs2, hglΘ_real (x' - β - t / 2), hglΘ_real (x' - β + t / 2)] at h1
    have h2 : (C.ϕ (σ x') : ℂ) =
        (((1 / 2 : ℝ) * (C.ϕ (v (x' - β - t / 2)) + C.ϕ (v (x' - β + t / 2))) : ℝ) : ℂ) := by
      rw [h1]
      push_cast
      ring
    exact Complex.ofReal_inj.mp h2
  let ψ₀ : ℝ := C.ϕ (σ x)
  let ψ₁ : ℝ := C.ϕ (σ (x + t))
  have hψ₀_eq : ψ₀ = (1 / 2 : ℝ) * (θ₀ + θ₁) := by
    dsimp [ψ₀, θ₀, θ₁, u]
    exact h_mid x
  have hψ₁_eq : ψ₁ = (1 / 2 : ℝ) * (θ₁ + θ₂) := by
    have hm := h_mid (x + t)
    have hr1 : (x + t) - β - t / 2 = u + t / 2 := by dsimp [u]; ring
    have hr2 : (x + t) - β + t / 2 = u + 3 * t / 2 := by dsimp [u]; ring
    rw [hr1, hr2] at hm
    exact hm
  have hKϕ_x_re : (K.ϕ (L.𝔰 ((x : ℂ), (t : ℂ)))).re = ψ₀ := by
    rw [hKϕ_real x, Complex.ofReal_re]
  have hConj5 :
      (L.Θ_gl ((x : ℂ) - (t : ℂ) / 2, (t : ℂ))).re +
        (L.Θ_gl ((x : ℂ) + (t : ℂ) / 2, (t : ℂ))).re =
        2 * (K.ϕ (L.𝔰 ((x : ℂ), (t : ℂ)))).re := by
    rw [hΘ_sub_re, hΘ_add_re, hKϕ_x_re]
    linarith [hψ₀_eq]
  have hstep₀ := C.U_real_step_pos (u - t / 2) t ht0 ht_r₁
  have hstep₀_cast :
      (C.U (((u - t / 2 : ℝ) : ℂ) + (t : ℂ), (t : ℂ))).re = v (u + t / 2) := by
    have hc : (((u - t / 2 : ℝ) : ℂ) + (t : ℂ), (t : ℂ)) =
        (((u + t / 2 : ℝ) : ℂ), (t : ℂ)) := by
      ext <;> push_cast <;> ring
    rw [hc]
  have hθ₁_sub_θ₀_pos : 0 < θ₁ - θ₀ := by
    dsimp [θ₀, θ₁]
    have h := hstep₀.2.1
    rwa [hstep₀_cast] at h
  have hθ₁_sub_θ₀_lt : θ₁ - θ₀ < Real.pi := by
    dsimp [θ₀, θ₁]
    have h := hstep₀.2.2
    rwa [hstep₀_cast] at h
  have hstep₁ := C.U_real_step_pos (u + t / 2) t ht0 ht_r₁
  have hstep₁_cast :
      (C.U (((u + t / 2 : ℝ) : ℂ) + (t : ℂ), (t : ℂ))).re = v (u + 3 * t / 2) := by
    have hc : (((u + t / 2 : ℝ) : ℂ) + (t : ℂ), (t : ℂ)) =
        (((u + 3 * t / 2 : ℝ) : ℂ), (t : ℂ)) := by
      ext <;> push_cast <;> ring
    rw [hc]
  have hθ₂_sub_θ₁_pos : 0 < θ₂ - θ₁ := by
    dsimp [θ₁, θ₂]
    have h := hstep₁.2.1
    rwa [hstep₁_cast] at h
  have hθ₂_sub_θ₁_lt : θ₂ - θ₁ < Real.pi := by
    dsimp [θ₁, θ₂]
    have h := hstep₁.2.2
    rwa [hstep₁_cast] at h
  have hConj7 :
      0 < (L.Θ_gl ((x : ℂ) + (t : ℂ) / 2, (t : ℂ))).re -
        (K.ϕ (L.𝔰 ((x : ℂ), (t : ℂ)))).re := by
    rw [hΘ_add_re, hKϕ_x_re]
    linarith [hψ₀_eq, hθ₁_sub_θ₀_pos]
  have hConj8 :
      (L.Θ_gl ((x : ℂ) + (t : ℂ) / 2, (t : ℂ))).re -
        (K.ϕ (L.𝔰 ((x : ℂ), (t : ℂ)))).re < Real.pi / 2 := by
    rw [hΘ_add_re, hKϕ_x_re]
    linarith [hψ₀_eq, hθ₁_sub_θ₀_lt]
  have hψ_lt : ψ₀ < ψ₁ := by
    linarith [hψ₀_eq, hψ₁_eq, hθ₁_sub_θ₀_pos, hθ₂_sub_θ₁_pos]
  have hψ₀_lower : -(Real.pi / 2) < ψ₀ - θ₁ := by
    linarith [hψ₀_eq, hθ₁_sub_θ₀_lt]
  have hψ₁_upper : ψ₁ - θ₁ < Real.pi / 2 := by
    linarith [hψ₁_eq, hθ₂_sub_θ₁_lt]
  have hϕ_diff : Differentiable ℝ C.ϕ := C.ϕ_smooth.differentiable (by simp)
  have hσ_deriv_pos : ∀ x' : ℝ, 0 < deriv σ x' := by
    intro x'
    have hLHS : HasDerivAt (fun r : ℝ => C.ϕ (σ r)) (deriv C.ϕ (σ x') * deriv σ x') x' :=
      HasDerivAt.comp x' (hϕ_diff (σ x')).hasDerivAt (hσ_hasDeriv x')
    have hsh₁ : HasDerivAt (fun r : ℝ => r - β - t / 2) 1 x' :=
      ((hasDerivAt_id x').sub_const β).sub_const (t / 2)
    have hsh₂ : HasDerivAt (fun r : ℝ => r - β + t / 2) 1 x' :=
      ((hasDerivAt_id x').sub_const β).add_const (t / 2)
    have hv₁ := (hv_hasDeriv (x' - β - t / 2)).comp x' hsh₁
    change HasDerivAt (fun r : ℝ => v (r - β - t / 2))
      (deriv v (x' - β - t / 2) * 1) x' at hv₁
    have hv₂ := (hv_hasDeriv (x' - β + t / 2)).comp x' hsh₂
    change HasDerivAt (fun r : ℝ => v (r - β + t / 2))
      (deriv v (x' - β + t / 2) * 1) x' at hv₂
    have hϕ₁ : HasDerivAt (fun r : ℝ => C.ϕ (v (r - β - t / 2)))
        (deriv C.ϕ (v (x' - β - t / 2)) * (deriv v (x' - β - t / 2) * 1)) x' :=
      HasDerivAt.comp x' (hϕ_diff (v (x' - β - t / 2))).hasDerivAt hv₁
    have hϕ₂ : HasDerivAt (fun r : ℝ => C.ϕ (v (r - β + t / 2)))
        (deriv C.ϕ (v (x' - β + t / 2)) * (deriv v (x' - β + t / 2) * 1)) x' :=
      HasDerivAt.comp x' (hϕ_diff (v (x' - β + t / 2))).hasDerivAt hv₂
    have hRHS : HasDerivAt
        (fun r : ℝ => (1 / 2 : ℝ) * (C.ϕ (v (r - β - t / 2)) + C.ϕ (v (r - β + t / 2))))
        ((1 / 2 : ℝ) *
          (deriv C.ϕ (v (x' - β - t / 2)) * (deriv v (x' - β - t / 2) * 1) +
            deriv C.ϕ (v (x' - β + t / 2)) * (deriv v (x' - β + t / 2) * 1))) x' :=
      (hϕ₁.add hϕ₂).const_mul (1 / 2 : ℝ)
    rw [funext h_mid] at hLHS
    have hderiv_eq := hLHS.unique hRHS
    have hp1 : 0 < deriv C.ϕ (v (x' - β - t / 2)) * deriv v (x' - β - t / 2) :=
      mul_pos (C.ϕ_deriv_pos _) (hv_deriv_pos _)
    have hp2 : 0 < deriv C.ϕ (v (x' - β + t / 2)) * deriv v (x' - β + t / 2) :=
      mul_pos (C.ϕ_deriv_pos _) (hv_deriv_pos _)
    have hp0 : 0 < deriv C.ϕ (σ x') := C.ϕ_deriv_pos (σ x')
    nlinarith
  have hConj3 : 0 < deriv (fun x' : ℝ => (L.𝔰 ((x' : ℂ), (t : ℂ))).re) x :=
    hσ_deriv_pos x
  
  have hσ_mono : StrictMono σ := strictMono_of_deriv_pos hσ_deriv_pos
  have hConj4 :
      0 < (L.𝔰 ((x : ℂ) + (t : ℂ), (t : ℂ))).re - (L.𝔰 ((x : ℂ), (t : ℂ))).re := by
    have hlt : σ x < σ (x + t) := hσ_mono (by linarith [ht0])
    have hre1 : (L.𝔰 ((x : ℂ) + (t : ℂ), (t : ℂ))).re = σ (x + t) := by
      rw [hp_add_t]
    have hre0 : (L.𝔰 ((x : ℂ), (t : ℂ))).re = σ x := rfl
    linarith
  
  have hh_strip_open : IsOpen (horizStrip (2 * C.s_h)) :=
    isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const
  have hh2 : ContDiff ℝ ((1 : WithTop ℕ∞) + 1) C.h := C.h_smooth.of_le (by decide)
  have hh_diff : Differentiable ℝ C.h := C.h_smooth.differentiable (by simp)
  have hh'_diff : Differentiable ℝ (deriv C.h) := hh2.deriv'.differentiable_one
  have hh_deriv_real : ∀ θ : ℝ, deriv C.h_ℂ (θ : ℂ) = ((deriv C.h θ : ℝ) : ℂ) := by
    intro θ
    have hmem : (θ : ℂ) ∈ horizStrip (2 * C.s_h) := by
      change |(θ : ℂ).im| < 2 * C.s_h
      simp [Complex.ofReal_im]
      linarith [C.s_h_pos]
    have hd1 : HasDerivAt (fun r : ℝ => C.h_ℂ (r : ℂ)) (deriv C.h_ℂ (θ : ℂ)) θ :=
      (C.h_ℂ_holo.differentiableAt (hh_strip_open.mem_nhds hmem)).hasDerivAt.comp_ofReal
    have hd2 : HasDerivAt (fun r : ℝ => (C.h r : ℂ)) ((deriv C.h θ : ℝ) : ℂ) θ :=
      (hh_diff θ).hasDerivAt.ofReal_comp
    rw [funext C.h_ℂ_real] at hd1
    exact hd1.unique hd2
  let γ₀ : ℝ → ℝ := fun θ : ℝ => C.h θ * Real.cos θ - deriv C.h θ * Real.sin θ
  let γ₁ : ℝ → ℝ := fun θ : ℝ => C.h θ * Real.sin θ + deriv C.h θ * Real.cos θ
  have hΓ_real : ∀ x' : ℝ,
      K.Γ (L.𝔰 ((x' : ℂ), (t : ℂ))) 0 = (γ₀ (C.ϕ (σ x')) : ℂ) ∧
      K.Γ (L.𝔰 ((x' : ℂ), (t : ℂ))) 1 = (γ₁ (C.ϕ (σ x')) : ℂ) := by
    intro x'
    rw [h𝔰_real x', K.Γ_base_eq (σ x' : ℂ) (hσ_mem_base x')]
    unfold glancingBoundaryCurve
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one,
      C.ϕ_ℂ_real (σ x'), C.h_ℂ_real, hh_deriv_real, ← Complex.ofReal_cos, ← Complex.ofReal_sin]
    constructor <;> (dsimp [γ₀, γ₁]; push_cast; ring)
  have hΓ_x0 : K.Γ (L.𝔰 ((x : ℂ), (t : ℂ))) 0 = (γ₀ ψ₀ : ℂ) := (hΓ_real x).1
  have hΓ_x1 : K.Γ (L.𝔰 ((x : ℂ), (t : ℂ))) 1 = (γ₁ ψ₀ : ℂ) := (hΓ_real x).2
  have hΓ_xt0 : K.Γ (L.𝔰 ((x : ℂ) + (t : ℂ), (t : ℂ))) 0 = (γ₀ ψ₁ : ℂ) := by
    rw [hp_add_t]
    exact (hΓ_real (x + t)).1
  have hΓ_xt1 : K.Γ (L.𝔰 ((x : ℂ) + (t : ℂ), (t : ℂ))) 1 = (γ₁ ψ₁ : ℂ) := by
    rw [hp_add_t]
    exact (hΓ_real (x + t)).2
  have hp_gl_act1 :
      L.p_gl ((x : ℂ) + (t : ℂ) / 2, (t : ℂ)) =
        -supportAction1_ℂ C.h_ℂ (θ₁ : ℂ) (θ₂ : ℂ) := by
    rw [hp_add_half]
    change glancingOffset C (((x + t / 2 : ℝ) : ℂ) - L.b_shift (t : ℂ)) (t : ℂ) = _
    have hsub : ((x + t / 2 : ℝ) : ℂ) - L.b_shift (t : ℂ) = ((u + t / 2 : ℝ) : ℂ) := by
      rw [hb_eq]
      dsimp [u]
      push_cast
      ring
    rw [hsub]
    unfold glancingOffset
    have hadd : ((u + t / 2 : ℝ) : ℂ) + (t : ℂ) = ((u + 3 * t / 2 : ℝ) : ℂ) := by
      push_cast; ring
    rw [hadd, hglΘ_real (u + t / 2), hglΘ_real (u + 3 * t / 2)]
  have hstat :
      -supportAction1_ℂ C.h_ℂ (θ₁ : ℂ) (θ₂ : ℂ) =
        supportAction2_ℂ C.h_ℂ (θ₀ : ℂ) (θ₁ : ℂ) := by
    have him : |((u + t / 2 : ℝ) : ℂ).im| < C.s₁ := by
      simp [Complex.ofReal_im, hs₁_pos]
    have hs := C.glancing_stationary ((u + t / 2 : ℝ) : ℂ) (t : ℂ) him ht_norm_r₁
    change -supportAction1_ℂ C.h_ℂ
        (glancingTheta C ((u + t / 2 : ℝ) : ℂ) (t : ℂ))
        (glancingTheta C (((u + t / 2 : ℝ) : ℂ) + (t : ℂ)) (t : ℂ)) =
      supportAction2_ℂ C.h_ℂ
        (glancingTheta C (((u + t / 2 : ℝ) : ℂ) - (t : ℂ)) (t : ℂ))
        (glancingTheta C ((u + t / 2 : ℝ) : ℂ) (t : ℂ)) at hs
    have hadd : ((u + t / 2 : ℝ) : ℂ) + (t : ℂ) = ((u + 3 * t / 2 : ℝ) : ℂ) := by
      push_cast; ring
    have hsub : ((u + t / 2 : ℝ) : ℂ) - (t : ℂ) = ((u - t / 2 : ℝ) : ℂ) := by
      push_cast; ring
    rw [hadd, hsub, hglΘ_real (u + t / 2), hglΘ_real (u + 3 * t / 2),
      hglΘ_real (u - t / 2)] at hs
    exact hs
  have hnorm_proj : ∀ ψ : ℝ,
      C.h ψ * Real.cos (ψ - θ₁) - deriv C.h ψ * Real.sin (ψ - θ₁) =
        γ₀ ψ * Real.cos θ₁ + γ₁ ψ * Real.sin θ₁ := by
    intro ψ
    dsimp [γ₀, γ₁]
    rw [Real.cos_sub, Real.sin_sub]
    ring
  have hact1_eval :
      -supportAction1_ℂ C.h_ℂ (θ₁ : ℂ) (θ₂ : ℂ) =
        ((γ₀ ψ₁ * Real.cos θ₁ + γ₁ ψ₁ * Real.sin θ₁ : ℝ) : ℂ) := by
    unfold supportAction1_ℂ
    have hm1 : ((θ₁ : ℂ) + (θ₂ : ℂ)) / 2 = (ψ₁ : ℂ) := by
      have hr : (θ₁ + θ₂) / 2 = ψ₁ := by linarith [hψ₁_eq]
      rw [← hr]
      push_cast
      ring
    have hm2 : ((θ₂ : ℂ) - (θ₁ : ℂ)) / 2 = ((ψ₁ - θ₁ : ℝ) : ℂ) := by
      have hr : (θ₂ - θ₁) / 2 = ψ₁ - θ₁ := by linarith [hψ₁_eq]
      rw [← hr]
      push_cast
      ring
    rw [hm1, hm2, hh_deriv_real ψ₁, C.h_ℂ_real ψ₁, ← Complex.ofReal_sin, ← Complex.ofReal_cos,
      ← hnorm_proj ψ₁]
    push_cast
    ring
  have hact2_eval :
      supportAction2_ℂ C.h_ℂ (θ₀ : ℂ) (θ₁ : ℂ) =
        ((γ₀ ψ₀ * Real.cos θ₁ + γ₁ ψ₀ * Real.sin θ₁ : ℝ) : ℂ) := by
    unfold supportAction2_ℂ
    have hm1 : ((θ₀ : ℂ) + (θ₁ : ℂ)) / 2 = (ψ₀ : ℂ) := by
      have hr : (θ₀ + θ₁) / 2 = ψ₀ := by linarith [hψ₀_eq]
      rw [← hr]
      push_cast
      ring
    have hm2 : ((θ₁ : ℂ) - (θ₀ : ℂ)) / 2 = ((-(ψ₀ - θ₁) : ℝ) : ℂ) := by
      have hr : (θ₁ - θ₀) / 2 = -(ψ₀ - θ₁) := by linarith [hψ₀_eq]
      rw [← hr]
      push_cast
      ring
    rw [hm1, hm2, hh_deriv_real ψ₀, C.h_ℂ_real ψ₀, ← Complex.ofReal_sin, ← Complex.ofReal_cos,
      Real.sin_neg, Real.cos_neg, ← hnorm_proj ψ₀]
    push_cast
    ring
  have hp_gl_eval :
      L.p_gl ((x : ℂ) + (t : ℂ) / 2, (t : ℂ)) =
        ((γ₀ ψ₀ * Real.cos θ₁ + γ₁ ψ₀ * Real.sin θ₁ : ℝ) : ℂ) := by
    rw [hp_gl_act1, hstat, hact2_eval]
  have hConj2 : (L.p_gl ((x : ℂ) + (t : ℂ) / 2, (t : ℂ))).im = 0 := by
    rw [hp_gl_eval, Complex.ofReal_im]
  have hConj12 :
      L.p_gl ((x : ℂ) + (t : ℂ) / 2, (t : ℂ)) =
        K.Γ (L.𝔰 ((x : ℂ), (t : ℂ))) 0 *
            (Real.cos ((L.Θ_gl ((x : ℂ) + (t : ℂ) / 2, (t : ℂ))).re) : ℂ) +
          K.Γ (L.𝔰 ((x : ℂ), (t : ℂ))) 1 *
            (Real.sin ((L.Θ_gl ((x : ℂ) + (t : ℂ) / 2, (t : ℂ))).re) : ℂ) := by
    rw [hp_gl_eval, hΓ_x0, hΓ_x1, hΘ_add_re]
    push_cast
    ring
  let d₀ : ℝ := γ₀ ψ₁ - γ₀ ψ₀
  let d₁ : ℝ := γ₁ ψ₁ - γ₁ ψ₀
  have hd_orth : d₀ * Real.cos θ₁ + d₁ * Real.sin θ₁ = 0 := by
    have heq_c : ((γ₀ ψ₁ * Real.cos θ₁ + γ₁ ψ₁ * Real.sin θ₁ : ℝ) : ℂ) =
        ((γ₀ ψ₀ * Real.cos θ₁ + γ₁ ψ₀ * Real.sin θ₁ : ℝ) : ℂ) := by
      rw [← hact1_eval, hstat, hact2_eval]
    have heq_r := Complex.ofReal_inj.mp heq_c
    dsimp [d₀, d₁]
    linarith
  have hℓ_eq : realCollarChordLen L x t = -d₀ * Real.sin θ₁ + d₁ * Real.cos θ₁ := by
    unfold realCollarChordLen
    rw [hΓ_xt0, hΓ_x0, hΓ_xt1, hΓ_x1, hΘ_add_re]
    have hd0_re : ((γ₀ ψ₁ : ℂ) - (γ₀ ψ₀ : ℂ)).re = d₀ := rfl
    have hd1_re : ((γ₁ ψ₁ : ℂ) - (γ₁ ψ₀ : ℂ)).re = d₁ := rfl
    rw [hd0_re, hd1_re]
  have h_pyth : Real.sin θ₁ ^ 2 + Real.cos θ₁ ^ 2 = 1 := Real.sin_sq_add_cos_sq θ₁
  have hd₀_eq : d₀ = -realCollarChordLen L x t * Real.sin θ₁ := by
    rw [hℓ_eq]
    calc
      d₀ = d₀ * (Real.sin θ₁ ^ 2 + Real.cos θ₁ ^ 2) := by rw [h_pyth, mul_one]
      _ = (d₀ * Real.cos θ₁ + d₁ * Real.sin θ₁) * Real.cos θ₁ -
            (-d₀ * Real.sin θ₁ + d₁ * Real.cos θ₁) * Real.sin θ₁ := by ring
      _ = -(-d₀ * Real.sin θ₁ + d₁ * Real.cos θ₁) * Real.sin θ₁ := by
            rw [hd_orth]; ring
  have hd₁_eq : d₁ = realCollarChordLen L x t * Real.cos θ₁ := by
    rw [hℓ_eq]
    calc
      d₁ = d₁ * (Real.sin θ₁ ^ 2 + Real.cos θ₁ ^ 2) := by rw [h_pyth, mul_one]
      _ = (d₀ * Real.cos θ₁ + d₁ * Real.sin θ₁) * Real.sin θ₁ +
            (-d₀ * Real.sin θ₁ + d₁ * Real.cos θ₁) * Real.cos θ₁ := by ring
      _ = (-d₀ * Real.sin θ₁ + d₁ * Real.cos θ₁) * Real.cos θ₁ := by
            rw [hd_orth]; ring
  have hConj10 :
      K.Γ (L.𝔰 ((x : ℂ) + (t : ℂ), (t : ℂ))) 0 - K.Γ (L.𝔰 ((x : ℂ), (t : ℂ))) 0 =
        -(realCollarChordLen L x t : ℂ) *
          (Real.sin ((L.Θ_gl ((x : ℂ) + (t : ℂ) / 2, (t : ℂ))).re) : ℂ) := by
    rw [hΓ_xt0, hΓ_x0, hΘ_add_re, ← Complex.ofReal_sub]
    change (d₀ : ℂ) = _
    rw [hd₀_eq]
    push_cast
    ring
  have hConj11 :
      K.Γ (L.𝔰 ((x : ℂ) + (t : ℂ), (t : ℂ))) 1 - K.Γ (L.𝔰 ((x : ℂ), (t : ℂ))) 1 =
        (realCollarChordLen L x t : ℂ) *
          (Real.cos ((L.Θ_gl ((x : ℂ) + (t : ℂ) / 2, (t : ℂ))).re) : ℂ) := by
    rw [hΓ_xt1, hΓ_x1, hΘ_add_re, ← Complex.ofReal_sub]
    change (d₁ : ℂ) = _
    rw [hd₁_eq]
    push_cast
    ring
  
  let G : ℝ → ℝ := fun θ : ℝ => C.h θ * Real.sin (θ - θ₁) + deriv C.h θ * Real.cos (θ - θ₁)
  have hG_eq : ∀ θ : ℝ, G θ = -γ₀ θ * Real.sin θ₁ + γ₁ θ * Real.cos θ₁ := by
    intro θ
    dsimp [G, γ₀, γ₁]
    rw [Real.sin_sub, Real.cos_sub]
    ring
  have hℓ_G : realCollarChordLen L x t = G ψ₁ - G ψ₀ := by
    rw [hℓ_eq, hG_eq ψ₁, hG_eq ψ₀]
    dsimp [d₀, d₁]
    ring
  have hG_deriv : ∀ θ : ℝ,
      HasDerivAt G ((C.h θ + deriv (deriv C.h) θ) * Real.cos (θ - θ₁)) θ := by
    intro θ
    have hsub : HasDerivAt (fun r : ℝ => r - θ₁) 1 θ := (hasDerivAt_id θ).sub_const θ₁
    have hsin := (Real.hasDerivAt_sin (θ - θ₁)).comp θ hsub
    change HasDerivAt (fun r : ℝ => Real.sin (r - θ₁)) (Real.cos (θ - θ₁) * 1) θ at hsin
    have hcos := (Real.hasDerivAt_cos (θ - θ₁)).comp θ hsub
    change HasDerivAt (fun r : ℝ => Real.cos (r - θ₁)) (-Real.sin (θ - θ₁) * 1) θ at hcos
    have hm1 := (hh_diff θ).hasDerivAt.mul hsin
    have hm2 := (hh'_diff θ).hasDerivAt.mul hcos
    have hsum := hm1.add hm2
    have hval : (deriv C.h θ * Real.sin (θ - θ₁) + C.h θ * (Real.cos (θ - θ₁) * 1)) +
        (deriv (deriv C.h) θ * Real.cos (θ - θ₁) + deriv C.h θ * (-Real.sin (θ - θ₁) * 1)) =
        (C.h θ + deriv (deriv C.h) θ) * Real.cos (θ - θ₁) := by ring
    rw [hval] at hsum
    exact hsum
  have hG_diff : Differentiable ℝ G := fun θ => (hG_deriv θ).differentiableAt
  have hG_mono : StrictMonoOn G (Set.Icc ψ₀ ψ₁) := by
    refine strictMonoOn_of_hasDerivWithinAt_pos (convex_Icc ψ₀ ψ₁)
      hG_diff.continuous.continuousOn (fun θ _ => (hG_deriv θ).hasDerivWithinAt) ?_
    intro θ hθ
    rw [interior_Icc] at hθ
    have hcos_pos : 0 < Real.cos (θ - θ₁) :=
      Real.cos_pos_of_mem_Ioo ⟨by linarith [hψ₀_lower, hθ.1], by linarith [hψ₁_upper, hθ.2]⟩
    exact mul_pos (C.r_pos θ) hcos_pos
  have hConj9 : 0 < realCollarChordLen L x t := by
    have hlt : G ψ₀ < G ψ₁ :=
      hG_mono ⟨le_rfl, le_of_lt hψ_lt⟩ ⟨le_of_lt hψ_lt, le_rfl⟩ hψ_lt
    linarith [hℓ_G]
  exact ⟨hConj1, hConj2, hConj3, hConj4, hConj5, hConj6,
    hConj7, hConj8, hConj9, hConj10, hConj11, hConj12⟩

theorem first_impact_displacement_law (Ω : Set Plane)
    (C : AnalyticGlancingCollar Ω)
    (M : MeromorphicCollarData C)
    (K : NonisotropicCurveData C M)
    (L : NormalizedGlobalLiftData C M K)
    (hQ_holo : DifferentiableOn ℂ (speedPotentialQ K) (horizStripENNR (M.h_X 0)))
    (hDeriv2_f : ∀ s ∈ horizStripENNR (M.h_X 0),
      deriv (deriv K.f) s = speedPotentialQ K s * K.f s)
    (hChord : RealCollarChordProp C M K L) :
    DifferentiableOn ℂ (firstImpactDisplacementV L) (horizStripENNR (M.h_X 0)) ∧
    (∀ s ∈ horizStripENNR (M.h_X 0),
      firstImpactDisplacementV L (s + 2 * Real.pi) = firstImpactDisplacementV L s) ∧
    (∀ s ∈ horizStripENNR (M.h_X 0),
      firstImpactDisplacementV L (starRingEnd ℂ s) =
        starRingEnd ℂ (firstImpactDisplacementV L s)) ∧
    (∫ x in (0 : ℝ)..(2 * Real.pi), firstImpactDisplacementV L x) = 0 ∧
    (∀ y ∈ horizStripENNR (M.h_X 0), deriv (fun t : ℂ => L.𝔰 (y, t)) 0 = 0) ∧
    (∀ y ∈ horizStripENNR (M.h_X 0),
      deriv (deriv (fun t : ℂ => L.𝔰 (y, t))) 0 = 2 * firstImpactDisplacementV L y) ∧
    (∀ s ∈ horizStripENNR (M.h_X 0),
      deriv (firstImpactDisplacementV L) s = (1 / 120 : ℂ) *
        (K.f s ^ 2 + 8 * speedPotentialQ K s -
          (2 * Real.pi)⁻¹ *
            ∫ x in (0 : ℝ)..(2 * Real.pi), (K.f x ^ 2 + 8 * speedPotentialQ K x))) :=
by
  let D_H : Set ℂ := horizStripENNR (M.h_X 0)
  let S_base : Set ℂ := horizStrip M.s_base
  let V : ℂ → ℂ := firstImpactDisplacementV L
  
  
  
  have hs_star_lt_base : L.s_star < M.s_base := by
    linarith [L.s_star_le, K.s_init_le, M.s_base_pos]
  have hr_star_lt_base : L.r_star < M.r_base := by
    linarith [L.r_star_le, K.r_init_le, M.r_base_pos]
  have h0_ball_rbase : (0 : ℂ) ∈ Metric.ball (0 : ℂ) M.r_base :=
    Metric.mem_ball_self M.r_base_pos
  have hhX0_ge : ENNReal.ofReal M.s_base ≤ M.h_X 0 :=
    M.h_X_ge 0 h0_ball_rbase
  have hS_base_open : IsOpen S_base :=
    isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const
  have hS_base_sub_DH : S_base ⊆ D_H := by
    intro s hs
    have hlt : ENNReal.ofReal |s.im| < ENNReal.ofReal M.s_base :=
      (ENNReal.ofReal_lt_ofReal_iff M.s_base_pos).mpr hs
    exact lt_of_lt_of_le hlt hhX0_ge
  have hreal_S_base : ∀ x : ℝ, (x : ℂ) ∈ S_base := by
    intro x
    change |(x : ℂ).im| < M.s_base
    simpa using M.s_base_pos
  have hreal_DH : ∀ x : ℝ, (x : ℂ) ∈ D_H :=
    fun x => hS_base_sub_DH (hreal_S_base x)
  have hDH_open_conv : IsOpen D_H ∧ Convex ℝ D_H := by
    rcases eq_top_or_lt_top (M.h_X 0) with hTop | hLtTop
    · have hDH_univ : D_H = Set.univ := by
        ext s
        simp [D_H, horizStripENNR, hTop]
      rw [hDH_univ]
      exact ⟨isOpen_univ, convex_univ⟩
    · let H : ℝ := (M.h_X 0).toReal
      have hH_eq : M.h_X 0 = ENNReal.ofReal H :=
        (ENNReal.ofReal_toReal (ne_of_lt hLtTop)).symm
      have hH_pos : 0 < H := by
        have hle : ENNReal.ofReal M.s_base ≤ ENNReal.ofReal H := hH_eq ▸ hhX0_ge
        by_contra hnp
        push_neg at hnp
        have h0 : ENNReal.ofReal H = 0 := ENNReal.ofReal_eq_zero.mpr hnp
        rw [h0, nonpos_iff_eq_zero, ENNReal.ofReal_eq_zero] at hle
        linarith [M.s_base_pos]
      have hDH_eq : D_H = horizStrip H := by
        ext s
        change ENNReal.ofReal |s.im| < M.h_X 0 ↔ |s.im| < H
        rw [hH_eq]
        exact ENNReal.ofReal_lt_ofReal_iff hH_pos
      rw [hDH_eq]
      refine ⟨isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const, ?_⟩
      intro s₁ hs₁ s₂ hs₂ a b ha hb hab
      change |(a • s₁ + b • s₂).im| < H
      have him : (a • s₁ + b • s₂).im = a * s₁.im + b * s₂.im := by
        simp [Complex.add_im, Complex.real_smul, Complex.mul_im]
      rw [him]
      by_cases ha0 : a = 0
      · subst ha0
        have hb1 : b = 1 := by linarith
        subst hb1
        simpa [horizStrip] using hs₂
      · have ha_pos : 0 < a := lt_of_le_of_ne ha (Ne.symm ha0)
        calc |a * s₁.im + b * s₂.im|
            ≤ |a * s₁.im| + |b * s₂.im| := abs_add_le _ _
          _ = a * |s₁.im| + b * |s₂.im| := by
              rw [abs_mul, abs_mul, abs_of_nonneg ha, abs_of_nonneg hb]
          _ < a * H + b * H :=
              add_lt_add_of_lt_of_le (mul_lt_mul_of_pos_left hs₁ ha_pos)
                (mul_le_mul_of_nonneg_left hs₂.le hb)
          _ = (a + b) * H := by ring
          _ = H := by rw [hab, one_mul]
  have hDH_open : IsOpen D_H := hDH_open_conv.1
  have hDH_pre : IsPreconnected D_H := hDH_open_conv.2.isPreconnected
  let W_cyl : Set (ℂ × ℂ) :=
    { p : ℂ × ℂ | |p.1.im| < L.s_star / 2 ∧ ‖p.2‖ < L.r_star }
  have hW_cyl_open : IsOpen W_cyl :=
    (isOpen_lt (continuous_abs.comp (Complex.continuous_im.comp continuous_fst))
      continuous_const).inter
    (isOpen_lt (continuous_norm.comp continuous_snd) continuous_const)
  have hW_cyl_sub : W_cyl ⊆ L.T_norm := by
    intro p ⟨hy_im, ht_norm⟩
    rw [L.T_norm_iff]
    refine ⟨ht_norm, ?_⟩
    have ht_rbase : ‖p.2‖ < M.r_base := lt_trans ht_norm hr_star_lt_base
    have hct_rbase : (starRingEnd ℂ p.2) ∈ Metric.ball (0 : ℂ) M.r_base := by
      simpa using ht_rbase
    have ht_ball_rbase : p.2 ∈ Metric.ball (0 : ℂ) M.r_base := by
      simpa using ht_rbase
    have hb_small : ‖L.b_shift p.2‖ < L.s_star / 4 :=
      L.b_shift_small p.2 (by simpa using ht_norm)
    have him_abs : |(p.1 - L.b_shift p.2).im| < M.s_base := by
      have h1 : |(p.1 - L.b_shift p.2).im| ≤ |p.1.im| + |(L.b_shift p.2).im| := by
        simpa [Complex.sub_im] using abs_sub p.1.im (L.b_shift p.2).im
      have h2 : |(L.b_shift p.2).im| ≤ ‖L.b_shift p.2‖ := Complex.abs_im_le_norm _
      linarith [L.s_star_pos, hs_star_lt_base]
    refine ⟨ht_rbase, ?_, ?_⟩
    · have hn : -(p.1 - L.b_shift p.2).im < M.s_base :=
        lt_of_le_of_lt (neg_le_abs _) him_abs
      exact lt_of_lt_of_le ((ENNReal.ofReal_lt_ofReal_iff M.s_base_pos).mpr hn)
        (M.h_X_ge _ hct_rbase)
    · have hp1 : (p.1 - L.b_shift p.2).im < M.s_base :=
        lt_of_le_of_lt (le_abs_self _) him_abs
      exact lt_of_lt_of_le ((ENNReal.ofReal_lt_ofReal_iff M.s_base_pos).mpr hp1)
        (M.h_X_ge _ ht_ball_rbase)
  
  have diffAt_pair : ∀ (a b y₀ t₀ z : ℂ),
      DifferentiableAt ℂ (fun w : ℂ => (a * w + y₀, b * w + t₀)) z := by
    intro a b y₀ t₀ z
    let L_ab : ℂ →L[ℂ] (ℂ × ℂ) :=
      { toLinearMap :=
          { toFun := fun w => (a * w, b * w)
            map_add' := fun u v => by ext <;> simp [mul_add]
            map_smul' := fun c u => by ext <;> simp [mul_left_comm] }
        cont := (continuous_const.mul continuous_id).prodMk
          (continuous_const.mul continuous_id) }
    have hlin : DifferentiableAt ℂ (fun w : ℂ => L_ab w + (y₀, t₀)) z :=
      L_ab.differentiableAt.add (differentiableAt_const (y₀, t₀))
    exact hlin
  
  
  
  have norm_le_of_bound_and_local_pow :
      ∀ (N : ℕ) {R M_b : ℝ} {f : ℂ → ℂ},
        0 < R → 0 ≤ M_b →
        DifferentiableOn ℂ f (Metric.ball (0 : ℂ) R) →
        (∀ z ∈ Metric.ball (0 : ℂ) R, ‖f z‖ ≤ M_b) →
        (∃ C_l δ_l : ℝ, 0 < δ_l ∧ ∀ z : ℂ, ‖z‖ < δ_l → ‖f z‖ ≤ C_l * ‖z‖ ^ N) →
        ∀ z ∈ Metric.ball (0 : ℂ) R, ‖f z‖ ≤ (M_b / R ^ N) * ‖z‖ ^ N := by
    intro N
    induction N with
    | zero =>
      intro R M_b f _ _ _ hM _ z hz
      simpa using hM z hz
    | succ N ih =>
      intro R M_b f hR hM hf_diff hf_bnd ⟨C_l, δ_l, hδ, hloc⟩
      have hf0 : f 0 = 0 := by
        have h0 : ‖f 0‖ ≤ C_l * ‖(0 : ℂ)‖ ^ (N + 1) := hloc 0 (by simpa using hδ)
        simp only [norm_zero, ne_eq, Nat.add_eq_zero_iff, one_ne_zero, and_false,
          not_false_eq_true, zero_pow, mul_zero] at h0
        exact norm_le_zero_iff.mp h0
      let g : ℂ → ℂ := dslope f 0
      have hball_nhds : Metric.ball (0 : ℂ) R ∈ nhds (0 : ℂ) := Metric.ball_mem_nhds 0 hR
      have hg_diff : DifferentiableOn ℂ g (Metric.ball (0 : ℂ) R) :=
        (Complex.differentiableOn_dslope hball_nhds).mpr hf_diff
      have hg_bnd : ∀ z ∈ Metric.ball (0 : ℂ) R, ‖g z‖ ≤ M_b / R := by
        intro z hz
        apply Complex.norm_dslope_le_div_of_mapsTo_ball hf_diff _ hz
        intro w hw
        rw [Metric.mem_closedBall, dist_eq_norm, hf0, sub_zero]
        exact hf_bnd w hw
      let C' : ℝ := max C_l 0
      let δ' : ℝ := min δ_l R
      have hδ' : 0 < δ' := lt_min hδ hR
      have hg_punc : ∀ z : ℂ, z ≠ 0 → ‖z‖ < δ' → ‖g z‖ ≤ C' * ‖z‖ ^ N := by
        intro z hz0 hzδ
        have hgz : g z = f z / z := by
          simp only [g, dslope_of_ne f hz0, slope, sub_zero, hf0, vsub_eq_sub, smul_eq_mul]
          ring
        rw [hgz, norm_div]
        have hfz : ‖f z‖ ≤ C' * ‖z‖ ^ (N + 1) := by
          calc ‖f z‖ ≤ C_l * ‖z‖ ^ (N + 1) := hloc z (lt_of_lt_of_le hzδ (min_le_left _ _))
            _ ≤ C' * ‖z‖ ^ (N + 1) :=
              mul_le_mul_of_nonneg_right (le_max_left _ _) (pow_nonneg (norm_nonneg z) _)
        rw [div_le_iff₀ (norm_pos_iff.mpr hz0)]
        calc ‖f z‖ ≤ C' * ‖z‖ ^ (N + 1) := hfz
          _ = C' * ‖z‖ ^ N * ‖z‖ := by rw [pow_succ]; ring
      have hg0 : ‖g 0‖ ≤ C' * ‖(0 : ℂ)‖ ^ N := by
        have hg_cont : ContinuousAt (fun z : ℂ => ‖g z‖) 0 :=
          (hg_diff.differentiableAt hball_nhds).continuousAt.norm
        have hrhs_cont : ContinuousAt (fun z : ℂ => C' * ‖z‖ ^ N) 0 := by fun_prop
        have hev : ∀ᶠ z in nhdsWithin (0 : ℂ) {(0 : ℂ)}ᶜ, ‖g z‖ ≤ C' * ‖z‖ ^ N := by
          rw [eventually_nhdsWithin_iff]
          filter_upwards [Metric.ball_mem_nhds (0 : ℂ) hδ'] with z hzball hz0
          exact hg_punc z (Set.mem_compl_singleton_iff.mp hz0) (by simpa using hzball)
        exact le_of_tendsto_of_tendsto hg_cont.continuousWithinAt
          hrhs_cont.continuousWithinAt hev
      have hg_loc : ∃ C₁ δ₁ : ℝ, 0 < δ₁ ∧ ∀ z : ℂ, ‖z‖ < δ₁ → ‖g z‖ ≤ C₁ * ‖z‖ ^ N := by
        refine ⟨C', δ', hδ', fun z hz => ?_⟩
        by_cases hz0 : z = 0
        · subst hz0; exact hg0
        · exact hg_punc z hz0 hz
      have hg_est := ih hR (div_nonneg hM hR.le) hg_diff hg_bnd hg_loc
      intro z hz
      have hfg : z * g z = f z := by
        have := sub_smul_dslope f 0 z
        simpa [g, hf0] using this
      calc ‖f z‖ = ‖z * g z‖ := by rw [hfg]
        _ = ‖z‖ * ‖g z‖ := norm_mul z (g z)
        _ ≤ ‖z‖ * ((M_b / R / R ^ N) * ‖z‖ ^ N) :=
          mul_le_mul_of_nonneg_left (hg_est z hz) (norm_nonneg z)
        _ = (M_b / R ^ (N + 1)) * ‖z‖ ^ (N + 1) := by
          rw [div_div, ← pow_succ']
          ring
  have even_dslope2 :
      ∀ {R : ℝ} {g : ℂ → ℂ},
        0 < R →
        DifferentiableOn ℂ g (Metric.ball (0 : ℂ) R) →
        g 0 = 0 →
        (∀ z ∈ Metric.ball (0 : ℂ) R, g (-z) = g z) →
        ∃ d₂ : ℂ → ℂ,
          DifferentiableOn ℂ d₂ (Metric.ball (0 : ℂ) R) ∧
          (∀ z : ℂ, g z = z ^ 2 * d₂ z) ∧
          (∀ z ∈ Metric.ball (0 : ℂ) R, d₂ (-z) = d₂ z) ∧
          deriv (deriv g) 0 = 2 * d₂ 0 ∧
          (∀ M_b : ℝ, 0 ≤ M_b → (∀ z ∈ Metric.ball (0 : ℂ) R, ‖g z‖ ≤ M_b) →
            ∀ z ∈ Metric.ball (0 : ℂ) R, ‖d₂ z‖ ≤ M_b / R ^ 2) := by
    intro R g hR hg_diff hg0 hg_even
    have hball_nhds : Metric.ball (0 : ℂ) R ∈ nhds (0 : ℂ) := Metric.ball_mem_nhds 0 hR
    let d₁ : ℂ → ℂ := dslope g 0
    let d₂ : ℂ → ℂ := dslope d₁ 0
    have hd₁_diff : DifferentiableOn ℂ d₁ (Metric.ball (0 : ℂ) R) :=
      (Complex.differentiableOn_dslope hball_nhds).mpr hg_diff
    have hd₂_diff : DifferentiableOn ℂ d₂ (Metric.ball (0 : ℂ) R) :=
      (Complex.differentiableOn_dslope hball_nhds).mpr hd₁_diff
    have hdg0 : deriv g 0 = 0 := by
      have hev : (fun z : ℂ => g (-z)) =ᶠ[nhds (0 : ℂ)] g := by
        filter_upwards [hball_nhds] with z hz using hg_even z hz
      have h1 : deriv (fun z : ℂ => g (-z)) 0 = deriv g 0 := hev.deriv_eq
      rw [deriv_comp_neg, neg_zero] at h1
      linear_combination -h1 / 2
    have hd₁0 : d₁ 0 = 0 := by simpa [d₁, dslope_same] using hdg0
    have hfac1 : ∀ z : ℂ, z * d₁ z = g z := by
      intro z
      have := sub_smul_dslope g 0 z
      simpa [d₁, hg0] using this
    have hfac2 : ∀ z : ℂ, z * d₂ z = d₁ z := by
      intro z
      have := sub_smul_dslope d₁ 0 z
      simpa [d₂, hd₁0] using this
    have hfac : ∀ z : ℂ, g z = z ^ 2 * d₂ z := by
      intro z
      calc g z = z * d₁ z := (hfac1 z).symm
        _ = z * (z * d₂ z) := by rw [hfac2 z]
        _ = z ^ 2 * d₂ z := by ring
    have hd₂_even : ∀ z ∈ Metric.ball (0 : ℂ) R, d₂ (-z) = d₂ z := by
      intro z hz
      by_cases hz0 : z = 0
      · simp [hz0]
      · have hnz : -z ≠ 0 := neg_ne_zero.mpr hz0
        have hd₁_odd : d₁ (-z) = -d₁ z := by
          simp only [d₁, dslope_of_ne g hnz, dslope_of_ne g hz0, slope, sub_zero, hg0,
            hg_even z hz, vsub_eq_sub, smul_eq_mul]
          ring
        simp only [d₂, dslope_of_ne d₁ hnz, dslope_of_ne d₁ hz0, slope, sub_zero, hd₁0,
          hd₁_odd, vsub_eq_sub, smul_eq_mul]
        ring
    have hddg0 : deriv (deriv g) 0 = 2 * d₂ 0 := by
      have hderiv_eq : deriv g =ᶠ[nhds (0 : ℂ)] fun w => d₁ w + w * deriv d₁ w := by
        filter_upwards [hball_nhds] with w hw
        have hw_nhds : Metric.ball (0 : ℂ) R ∈ nhds w := Metric.isOpen_ball.mem_nhds hw
        have hd₁_at : HasDerivAt d₁ (deriv d₁ w) w :=
          (hd₁_diff.differentiableAt hw_nhds).hasDerivAt
        have hmul : HasDerivAt (fun z : ℂ => z * d₁ z) (1 * d₁ w + w * deriv d₁ w) w :=
          (hasDerivAt_id w).mul hd₁_at
        have hgw : HasDerivAt g (1 * d₁ w + w * deriv d₁ w) w := by
          simpa [funext hfac1] using hmul
        simpa using hgw.deriv
      have h2 : deriv (deriv g) 0 = deriv (fun w : ℂ => d₁ w + w * deriv d₁ w) 0 :=
        Filter.EventuallyEq.deriv_eq hderiv_eq
      have hdd₁_diff : DifferentiableOn ℂ (deriv d₁) (Metric.ball (0 : ℂ) R) :=
        hd₁_diff.deriv Metric.isOpen_ball
      have hd₁_at0 : HasDerivAt d₁ (deriv d₁ 0) 0 :=
        (hd₁_diff.differentiableAt hball_nhds).hasDerivAt
      have hdd₁_at0 : HasDerivAt (deriv d₁) (deriv (deriv d₁) 0) 0 :=
        (hdd₁_diff.differentiableAt hball_nhds).hasDerivAt
      have hsum : HasDerivAt (fun w : ℂ => d₁ w + w * deriv d₁ w)
          (deriv d₁ 0 + (1 * deriv d₁ 0 + 0 * deriv (deriv d₁) 0)) 0 :=
        hd₁_at0.add ((hasDerivAt_id (0 : ℂ)).mul hdd₁_at0)
      have hd₂0 : d₂ 0 = deriv d₁ 0 := dslope_same d₁ 0
      rw [h2, hsum.deriv, hd₂0]
      ring
    refine ⟨d₂, hd₂_diff, hfac, hd₂_even, hddg0, ?_⟩
    intro M_b _ hM z hz
    have hd₁_bnd : ∀ w ∈ Metric.ball (0 : ℂ) R, ‖d₁ w‖ ≤ M_b / R := by
      intro w hw
      apply Complex.norm_dslope_le_div_of_mapsTo_ball hg_diff _ hw
      intro u hu
      rw [Metric.mem_closedBall, dist_eq_norm, hg0, sub_zero]
      exact hM u hu
    have hd₂_bnd : ‖d₂ z‖ ≤ (M_b / R) / R := by
      apply Complex.norm_dslope_le_div_of_mapsTo_ball hd₁_diff _ hz
      intro u hu
      rw [Metric.mem_closedBall, dist_eq_norm, hd₁0, sub_zero]
      exact hd₁_bnd u hu
    simpa [div_div, sq] using hd₂_bnd
  
  
  
  
  have h𝔰_d2 : ∀ y ∈ D_H, deriv (deriv (fun t : ℂ => L.𝔰 (y, t))) 0 = 2 * V y := by
    intro y _
    dsimp [V, firstImpactDisplacementV]
    ring
  have hV_holo : DifferentiableOn ℂ V D_H := by
    intro y₀ hy₀
    obtain ⟨δ_y_raw, δ_t, hδ_y_raw, hδ_t, _, hU_sub_raw⟩ := L.zero_slice_nhd y₀ hy₀
    obtain ⟨δ_D, hδ_D, hball_DH⟩ := Metric.mem_nhds_iff.mp (hDH_open.mem_nhds hy₀)
    let δ_y : ℝ := min δ_y_raw δ_D
    have hδ_y : 0 < δ_y := lt_min hδ_y_raw hδ_D
    have hy_sub_DH : Metric.ball y₀ δ_y ⊆ D_H :=
      Set.Subset.trans (Metric.ball_subset_ball (min_le_right _ _)) hball_DH
    let U : Set (ℂ × ℂ) := Metric.ball y₀ δ_y ×ˢ Metric.ball (0 : ℂ) δ_t
    have hU_open : IsOpen U := Metric.isOpen_ball.prod Metric.isOpen_ball
    have hU_sub : U ⊆ L.T_norm := by
      rintro ⟨y, t⟩ ⟨hy, ht⟩
      exact hU_sub_raw ⟨Metric.ball_subset_ball (min_le_left _ _) hy, ht⟩
    have h𝔰_U : DifferentiableOn ℂ L.𝔰 U := L.𝔰_holo.mono hU_sub
    let r_y : ℝ := δ_y / 2
    let r_t : ℝ := δ_t / 2
    have hr_y : 0 < r_y := half_pos hδ_y
    have hr_t : 0 < r_t := half_pos hδ_t
    let K₀ : Set (ℂ × ℂ) := Metric.closedBall y₀ r_y ×ˢ Metric.closedBall (0 : ℂ) r_t
    have hK₀_comp : IsCompact K₀ :=
      (isCompact_closedBall y₀ r_y).prod (isCompact_closedBall (0 : ℂ) r_t)
    have hK₀_sub : K₀ ⊆ U := by
      rintro ⟨y, t⟩ ⟨hy, ht⟩
      exact ⟨lt_of_le_of_lt (Metric.mem_closedBall.mp hy) (half_lt_self hδ_y),
        lt_of_le_of_lt (Metric.mem_closedBall.mp ht) (half_lt_self hδ_t)⟩
    have hdiff_cont : ContinuousOn (fun p : ℂ × ℂ => L.𝔰 p - p.1) K₀ :=
      (h𝔰_U.mono hK₀_sub).continuousOn.sub continuous_fst.continuousOn
    obtain ⟨B₀, hB₀⟩ := hK₀_comp.exists_bound_of_continuousOn hdiff_cont
    let M₁ : ℝ := max B₀ 0
    have hM₁ : 0 ≤ M₁ := le_max_right _ _
    have hunif_est : ∀ y ∈ Metric.ball y₀ r_y, ∀ t ∈ Metric.ball (0 : ℂ) r_t, t ≠ 0 →
        ‖(L.𝔰 (y, t) - y) / t ^ 2 - V y‖ ≤ (2 * M₁ / r_t ^ 4) * ‖t‖ ^ 2 := by
      intro y hy t ht hne
      have hy_cl : y ∈ Metric.closedBall y₀ r_y := Metric.ball_subset_closedBall hy
      have hy_δ : y ∈ Metric.ball y₀ δ_y := lt_trans hy (half_lt_self hδ_y)
      have hy_DH : y ∈ D_H := hy_sub_DH hy_δ
      let g_y : ℂ → ℂ := fun w => L.𝔰 (y, w) - y
      have hgy_diff : DifferentiableOn ℂ g_y (Metric.ball (0 : ℂ) r_t) := by
        intro w hw
        have hw_δ : w ∈ Metric.ball (0 : ℂ) δ_t := lt_trans hw (half_lt_self hδ_t)
        have hp_mem : (y, w) ∈ U := ⟨hy_δ, hw_δ⟩
        have h2d := h𝔰_U.differentiableAt (hU_open.mem_nhds hp_mem)
        have h1d : DifferentiableAt ℂ (fun z : ℂ => (y, z)) w := by
          simpa using diffAt_pair 0 1 y 0 w
        exact ((h2d.comp w h1d).sub (differentiableAt_const y)).differentiableWithinAt
      have hgy0 : g_y 0 = 0 := by simp [g_y, L.𝔰_zero y hy_DH]
      have hgy_even : ∀ w ∈ Metric.ball (0 : ℂ) r_t, g_y (-w) = g_y w := by
        intro w hw
        have hp_mem : (y, w) ∈ U := ⟨hy_δ, lt_trans hw (half_lt_self hδ_t)⟩
        simp [g_y, L.𝔰_even (y, w) (hU_sub hp_mem)]
      have hgy_bnd : ∀ w ∈ Metric.ball (0 : ℂ) r_t, ‖g_y w‖ ≤ M₁ := fun w hw =>
        le_trans (hB₀ (y, w) ⟨hy_cl, Metric.ball_subset_closedBall hw⟩) (le_max_left _ _)
      obtain ⟨d₂, hd₂_diff, hfac2, hd₂_even, hdd_gy, hd₂_bnd⟩ :=
        even_dslope2 hr_t hgy_diff hgy0 hgy_even
      have hdd_gy_eq : deriv (deriv g_y) 0 = 2 * V y := by
        have hdg : deriv g_y =ᶠ[nhds (0 : ℂ)] deriv (fun w : ℂ => L.𝔰 (y, w)) := by
          filter_upwards [Metric.ball_mem_nhds (0 : ℂ) hr_t] with w _
          simp [g_y, deriv_sub_const]
        rw [Filter.EventuallyEq.deriv_eq hdg, h𝔰_d2 y hy_DH]
      have hd₂0 : d₂ 0 = V y := by linear_combination (hdd_gy_eq - hdd_gy) / 2
      have hVy_bnd : ‖V y‖ ≤ M₁ / r_t ^ 2 := by
        rw [← hd₂0]
        exact hd₂_bnd M₁ hM₁ hgy_bnd 0 (Metric.mem_ball_self hr_t)
      let h_y : ℂ → ℂ := fun w => d₂ w - V y
      have hhy_diff : DifferentiableOn ℂ h_y (Metric.ball (0 : ℂ) r_t) :=
        hd₂_diff.sub (differentiableOn_const (V y))
      have hhy0 : h_y 0 = 0 := by simp [h_y, hd₂0]
      have hhy_even : ∀ w ∈ Metric.ball (0 : ℂ) r_t, h_y (-w) = h_y w := by
        intro w hw; simp [h_y, hd₂_even w hw]
      have hhy_bnd : ∀ w ∈ Metric.ball (0 : ℂ) r_t, ‖h_y w‖ ≤ 2 * M₁ / r_t ^ 2 := by
        intro w hw
        calc ‖d₂ w - V y‖ ≤ ‖d₂ w‖ + ‖V y‖ := norm_sub_le _ _
          _ ≤ M₁ / r_t ^ 2 + M₁ / r_t ^ 2 := add_le_add (hd₂_bnd M₁ hM₁ hgy_bnd w hw) hVy_bnd
          _ = 2 * M₁ / r_t ^ 2 := by ring
      obtain ⟨d₄, _, hfac4, _, _, hd₄_bnd⟩ :=
        even_dslope2 hr_t hhy_diff hhy0 hhy_even
      have hd₄_t := hd₄_bnd (2 * M₁ / r_t ^ 2) (by positivity) hhy_bnd t ht
      have hquot : (L.𝔰 (y, t) - y) / t ^ 2 - V y = t ^ 2 * d₄ t := by
        have h1 : (L.𝔰 (y, t) - y) / t ^ 2 = d₂ t := by
          change g_y t / t ^ 2 = d₂ t
          rw [hfac2 t]
          field_simp [hne]
