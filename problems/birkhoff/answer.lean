        ⟨by linarith [hψ_bounds.1, Real.pi_pos], by linarith [hψ_bounds.2, Real.pi_pos]⟩
  have h_angle_sum : M.θ + M.δ_θ < Real.pi / 2 := by
    linarith [M.θ_lt, M.δ_θ_lt, Real.pi_pos]
  have hBall3_both : ∀ Z ∈ Metric.closedBall Y_plus (3 * B.ε_patch),
