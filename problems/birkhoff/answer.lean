      intro w hw
      have hd_shift : HasDerivAt (fun ζ : ℂ => s₀ + ζ) 1 w := by
        simpa using (hasDerivAt_id w).const_add s₀
      have hd_ϕw : HasDerivAt (fun ζ : ℂ => K.ϕ (s₀ + ζ)) (K.f (s₀ + w)) w := by
