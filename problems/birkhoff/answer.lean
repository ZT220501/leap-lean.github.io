      nlinarith
    have hd_Phi : HasDerivAt PhiQ (2 * z * Complex.tanh z / (Complex.cosh z) ^ 2) z := by
      have h_eq_fn : PhiQ = fun w => Complex.sinh w / Complex.cosh w - w / (Complex.cosh w) ^ 2 := by
        ext w; simp [PhiQ, Complex.tanh_eq_sinh_div_cosh]
      rw [h_eq_fn]
      have hd_tanh : HasDerivAt (fun w => Complex.sinh w / Complex.cosh w)
          ((Complex.cosh z * Complex.cosh z - Complex.sinh z * Complex.sinh z) /
            (Complex.cosh z) ^ 2) z :=
        (Complex.hasDerivAt_sinh z).div (Complex.hasDerivAt_cosh z) hcosh_ne
