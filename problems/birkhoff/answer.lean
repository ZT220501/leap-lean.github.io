  have hW_up_open : IsOpen W_up := by
    have hc_im1 : Continuous (fun p : ℂ × ℂ => h_ref - p.1.im) :=
      continuous_const.sub (Complex.continuous_im.comp continuous_fst)
    have hc_re1 : Continuous (fun p : ℂ × ℂ => |p.1.re - x₀|) :=
      continuous_abs.comp ((Complex.continuous_re.comp continuous_fst).sub continuous_const)
    have hc_rpow : Continuous (fun p : ℂ × ℂ => 10 * r * ((h_ref - p.1.im) / d) ^ α) :=
      continuous_const.mul ((hc_im1.div_const d).rpow_const (fun _ => Or.inr hα_pos.le))
    have hO1 : IsOpen { p : ℂ × ℂ | d / 2 < h_ref - p.1.im } :=
      isOpen_lt continuous_const hc_im1
    have hO2 : IsOpen { p : ℂ × ℂ | h_ref - p.1.im < δ_ceil - Δ_slab / 4 } :=
