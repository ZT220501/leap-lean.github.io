                (Q_plus ^ α * (S_geom P_plus Q_plus γ * (P_plus - Q_plus)) *
                  P_ρ ^ α * (S_geom P_ρ Q_ρ γ * (P_ρ - Q_ρ))) := by
                rw [hS_mul, hS_mul]
