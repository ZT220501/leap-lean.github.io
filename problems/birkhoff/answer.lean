        rw [hdΔ_z, hdΔ_t]
        linear_combination hrk_eq
      have hZ_ne : deriv G.Z_loc (v (z, t)) ≠ 0 := S.deriv_Z_ne_zero (v (z, t)) hvp.1 hvp.2
