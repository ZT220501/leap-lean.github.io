                (pcJetEdgeTermCast x_base ℓ_base I_ser F_tr β_ser i_R -
                  pcJetEdgeTermCast x_base ℓ_base I_ser F_ser β_ser i_R) := by
                unfold pcJetGrad2D; dsimp only [i_L, i_R]; ring
              rw [hid]
              exact h_vb_sub (hES_agree i_L) (hEC_agree i_R)
            have h0 := hG_vb d (by omega)
            rw [map_sub, hGrad_tay r, map_zero, sub_zero] at h0
