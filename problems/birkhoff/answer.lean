          ‖J_step (m + 1) - J_step m‖ ≤
            C_res * ‖t‖ ^ 3 * M_scale ^ 2 * (D (m + 1)) ^ (-2 * α - 1)) ∧
        (∀ m < j, (b (m + 1) - w (m + 2)) - (b m - w (m + 1)) = t * (J_step (m + 1) - 1)) := by
      intro j
      induction j with
      | zero =>
        intro _
        refine ⟨?_, ?_, ?_, ?_, ?_⟩
        · rw [hw_zero]
