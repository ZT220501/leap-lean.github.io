        ext s
        rw [Complex.sq_norm, Complex.normSq_apply]
        ring
      rw [hsq]
      convert (hre.pow 2).add (him.pow 2) using 1
      ring
    have hReImBound : ∀ u v : ℂ, |u.re * v.re + u.im * v.im| ≤ ‖u‖ * ‖v‖ := by
      intro u v
      have hsq : (u.re * v.re + u.im * v.im) ^ 2 ≤ (‖u‖ * ‖v‖) ^ 2 := by
        have hu : ‖u‖ ^ 2 = u.re ^ 2 + u.im ^ 2 := by
          rw [Complex.sq_norm, Complex.normSq_apply]; ring
        have hv : ‖v‖ ^ 2 = v.re ^ 2 + v.im ^ 2 := by
          rw [Complex.sq_norm, Complex.normSq_apply]; ring
        rw [mul_pow, hu, hv]
        nlinarith [sq_nonneg (u.re * v.im - u.im * v.re)]
      exact abs_le.mpr (abs_le_of_sq_le_sq' hsq (mul_nonneg (norm_nonneg _) (norm_nonneg _)))
    set μ : ℝ := (3 / 2 : ℝ) * H_b
    have hE_deriv : ∀ t ∈ Set.Icc (0 : ℝ) 1, ∃ E' : ℝ,
        HasDerivAt E E' t ∧ |E'| ≤ μ * E t := by
      intro t ht
      have hmem_ball : γ_ℂ (t : ℂ) ∈ K_ball := hγ_mem t ht
      have hmem_strip : γ_ℂ (t : ℂ) ∈ horizStrip S.H :=
        (hBallSubGen x d hd_pos hd_lt _ hmem_ball).1
      have hd1 := hNormSqDeriv S.f t (S.f_holo.differentiableAt (hOpenStrip.mem_nhds hmem_strip))
      have hd2 := hNormSqDeriv (deriv S.f) t
        (hDerivFHolo.differentiableAt (hOpenStrip.mem_nhds hmem_strip))
      refine ⟨_, hd1.add (hd2.const_mul (lam⁻¹ ^ 2)), ?_⟩
      set ξ := γ_ℂ (t : ℂ)
      set a := ‖S.f ξ‖
      set b := lam⁻¹ * ‖deriv S.f ξ‖
      have ha_nn : 0 ≤ a := norm_nonneg _
      have hb_nn : 0 ≤ b := mul_nonneg (inv_nonneg.mpr hlam_pos.le) (norm_nonneg _)
      have hb_eq : ‖deriv S.f ξ‖ = lam * b := by
        dsimp [b]; rw [← mul_assoc, mul_inv_cancel₀ hlam_pos.ne', one_mul]
      have h_d2f : deriv (deriv S.f) ξ = S.q ξ * S.f ξ := S.deriv2_f ξ hmem_strip
      have hterm1 : |2 * ((S.f ξ).re * (deriv S.f ξ * w).re +
          (S.f ξ).im * (deriv S.f ξ * w).im)| ≤ 2 * a * (lam * b * ‖w‖) := by
        rw [abs_mul, abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 2)]
        have hcs := hReImBound (S.f ξ) (deriv S.f ξ * w)
        rw [norm_mul, hb_eq] at hcs
        linarith
      have hterm2 : |lam⁻¹ ^ 2 * (2 * ((deriv S.f ξ).re * (deriv (deriv S.f) ξ * w).re +
          (deriv S.f ξ).im * (deriv (deriv S.f) ξ * w).im))| ≤ 2 * lam * ‖w‖ * a * b := by
        rw [abs_mul, abs_mul, abs_of_nonneg (sq_nonneg _), abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 2)]
        have hcs := hReImBound (deriv S.f ξ) (deriv (deriv S.f) ξ * w)
        have h_norm_rhs : ‖deriv S.f ξ‖ * ‖deriv (deriv S.f) ξ * w‖ =
            (lam * b) * (‖S.q ξ‖ * a * ‖w‖) := by
          rw [h_d2f, norm_mul, norm_mul, hb_eq]
        rw [h_norm_rhs] at hcs
        have hq_b : ‖S.q ξ‖ ≤ lam ^ 2 := hq_le ξ hmem_ball
        have h_prod : ‖S.q ξ‖ * a * ‖w‖ ≤ lam ^ 2 * a * ‖w‖ :=
          mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hq_b ha_nn) (norm_nonneg _)
        have h_cs2 : (lam * b) * (‖S.q ξ‖ * a * ‖w‖) ≤ (lam * b) * (lam ^ 2 * a * ‖w‖) :=
          mul_le_mul_of_nonneg_left h_prod (mul_nonneg hlam_pos.le hb_nn)
        have h_simp : lam⁻¹ ^ 2 * (2 * ((lam * b) * (lam ^ 2 * a * ‖w‖))) = 2 * lam * ‖w‖ * a * b := by
          field_simp [hlam_pos.ne']
        calc lam⁻¹ ^ 2 * (2 * |(deriv S.f ξ).re * (deriv (deriv S.f) ξ * w).re +
              (deriv S.f ξ).im * (deriv (deriv S.f) ξ * w).im|)
            ≤ lam⁻¹ ^ 2 * (2 * ((lam * b) * (‖S.q ξ‖ * a * ‖w‖))) :=
              mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hcs (by norm_num)) (sq_nonneg _)
          _ ≤ lam⁻¹ ^ 2 * (2 * ((lam * b) * (lam ^ 2 * a * ‖w‖))) :=
              mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left h_cs2 (by norm_num)) (sq_nonneg _)
          _ = 2 * lam * ‖w‖ * a * b := h_simp
      have hab_le : 4 * lam * ‖w‖ * a * b ≤ 2 * lam * ‖w‖ * E t := by
        have hEt : E t = a ^ 2 + b ^ 2 := by
          dsimp [E, E_pt, a, b]; ring
        rw [hEt]
        have h2ab : 2 * a * b ≤ a ^ 2 + b ^ 2 := by nlinarith [sq_nonneg (a - b)]
        have hlw_nn : 0 ≤ 2 * lam * ‖w‖ := by positivity
        nlinarith
      have hlw_le_μ : 2 * lam * ‖w‖ ≤ μ := by
        dsimp [lam, μ]
        have : 2 * (2 * H_b / d) * ‖w‖ ≤ 2 * (2 * H_b / d) * (3 * d / 8) :=
          mul_le_mul_of_nonneg_left hw_norm (by positivity)
        have h_eq : 2 * (2 * H_b / d) * (3 * d / 8) = (3 / 2 : ℝ) * H_b := by
          field_simp [hd_pos.ne']
          ring
        linarith
      have hEt_nn : 0 ≤ E t := (hE_pos ξ hmem_strip).le
      have h_abs := abs_add_le
        (2 * ((S.f ξ).re * (deriv S.f ξ * w).re + (S.f ξ).im * (deriv S.f ξ * w).im))
        (lam⁻¹ ^ 2 * (2 * ((deriv S.f ξ).re * (deriv (deriv S.f) ξ * w).re +
          (deriv S.f ξ).im * (deriv (deriv S.f) ξ * w).im)))
      refine le_trans h_abs ?_
      calc _ ≤ 2 * a * (lam * b * ‖w‖) + 2 * lam * ‖w‖ * a * b := add_le_add hterm1 hterm2
        _ = 4 * lam * ‖w‖ * a * b := by ring
        _ ≤ 2 * lam * ‖w‖ * E t := hab_le
        _ ≤ μ * E t := mul_le_mul_of_nonneg_right hlw_le_μ hEt_nn
    have hE_upper : E 1 ≤ Real.exp μ * E 0 := by
      set g_minus : ℝ → ℝ := fun t => Real.exp (-μ * t) * E t
      have hg_deriv : ∀ t ∈ Set.Icc (0 : ℝ) 1, ∃ g' : ℝ,
          HasDerivAt g_minus g' t ∧ g' ≤ 0 := by
        intro t ht
        obtain ⟨E', hE', hE'_le⟩ := hE_deriv t ht
        have hexp : HasDerivAt (fun s : ℝ => Real.exp (-μ * s)) (Real.exp (-μ * t) * (-μ)) t := by
          simpa using ((hasDerivAt_id t).const_mul (-μ)).exp
        refine ⟨_, hexp.mul hE', ?_⟩
        have h1 : E' ≤ μ * E t := (abs_le.mp hE'_le).2
        have h2 : 0 < Real.exp (-μ * t) := Real.exp_pos _
        nlinarith
      have h_anti : AntitoneOn g_minus (Set.Icc 0 1) := by
        refine antitoneOn_of_deriv_nonpos (convex_Icc 0 1) ?_ ?_ ?_
        · intro t ht
          obtain ⟨g', hg', _⟩ := hg_deriv t ht
          exact hg'.continuousAt.continuousWithinAt
        · intro t ht
          obtain ⟨g', hg', _⟩ := hg_deriv t (interior_subset ht)
          exact hg'.differentiableAt.differentiableWithinAt
        · intro t ht
          obtain ⟨g', hg', hg'_np⟩ := hg_deriv t (interior_subset ht)
          rwa [hg'.deriv]
      have h01 : g_minus 1 ≤ g_minus 0 :=
        h_anti ⟨le_rfl, zero_le_one⟩ ⟨zero_le_one, le_rfl⟩ zero_le_one
      dsimp [g_minus] at h01
      simp only [mul_one, mul_zero, Real.exp_zero, one_mul] at h01
      calc E 1 = Real.exp μ * (Real.exp (-μ) * E 1) := by
            rw [← mul_assoc, ← Real.exp_add, add_neg_cancel, Real.exp_zero, one_mul]
        _ ≤ Real.exp μ * E 0 := mul_le_mul_of_nonneg_left h01 (Real.exp_pos _).le
    have hE_lower : E 0 ≤ Real.exp μ * E 1 := by
      set g_plus : ℝ → ℝ := fun t => Real.exp (μ * t) * E t
      have hg_deriv : ∀ t ∈ Set.Icc (0 : ℝ) 1, ∃ g' : ℝ,
          HasDerivAt g_plus g' t ∧ 0 ≤ g' := by
        intro t ht
        obtain ⟨E', hE', hE'_le⟩ := hE_deriv t ht
        have hexp : HasDerivAt (fun s : ℝ => Real.exp (μ * s)) (Real.exp (μ * t) * μ) t := by
          simpa using ((hasDerivAt_id t).const_mul μ).exp
        refine ⟨_, hexp.mul hE', ?_⟩
        have h1 : -(μ * E t) ≤ E' := (abs_le.mp hE'_le).1
        have h2 : 0 < Real.exp (μ * t) := Real.exp_pos _
        nlinarith
      have h_mono : MonotoneOn g_plus (Set.Icc 0 1) := by
        refine monotoneOn_of_deriv_nonneg (convex_Icc 0 1) ?_ ?_ ?_
        · intro t ht
          obtain ⟨g', hg', _⟩ := hg_deriv t ht
          exact hg'.continuousAt.continuousWithinAt
        · intro t ht
          obtain ⟨g', hg', _⟩ := hg_deriv t (interior_subset ht)
          exact hg'.differentiableAt.differentiableWithinAt
        · intro t ht
          obtain ⟨g', hg', hg'_nn⟩ := hg_deriv t (interior_subset ht)
          rwa [hg'.deriv]
      have h01 : g_plus 0 ≤ g_plus 1 :=
        h_mono ⟨le_rfl, zero_le_one⟩ ⟨zero_le_one, le_rfl⟩ zero_le_one
      dsimp [g_plus] at h01
      simp only [mul_zero, Real.exp_zero, one_mul, mul_one] at h01
      exact h01
    set L_amp : ℂ → ℝ := fun ξ => ‖S.f ξ‖ + stripSymDepth S ξ * ‖deriv S.f ξ‖
    have hL_cmp : ∀ ξ ∈ K_ball, E_pt ξ ≤ (L_amp ξ) ^ 2 ∧ (L_amp ξ) ^ 2 ≤ 18 * H_b ^ 2 * E_pt ξ := by
      intro ξ hξ
      have hb_sub := hBallSubGen x d hd_pos hd_lt ξ hξ
      set a := ‖S.f ξ‖
      set b := lam⁻¹ * ‖deriv S.f ξ‖
      have ha_nn : 0 ≤ a := norm_nonneg _
      have hb_nn : 0 ≤ b := mul_nonneg (inv_nonneg.mpr hlam_pos.le) (norm_nonneg _)
      have hb_eq : ‖deriv S.f ξ‖ = (2 * H_b / d) * b := by
        have : ‖deriv S.f ξ‖ = lam * b := by
          dsimp [b]; rw [← mul_assoc, mul_inv_cancel₀ hlam_pos.ne', one_mul]
        exact this
      have hE_eq : E_pt ξ = a ^ 2 + b ^ 2 := by dsimp [E_pt, a, b]; ring
      have hL_lo : a + b ≤ L_amp ξ := by
        dsimp [L_amp]
        rw [hb_eq]
        have h1 : (d / 2) * ((2 * H_b / d) * b) ≤ stripSymDepth S ξ * ((2 * H_b / d) * b) :=
          mul_le_mul_of_nonneg_right hb_sub.2.2.1 (by positivity)
        have h2 : (d / 2) * ((2 * H_b / d) * b) = H_b * b := by
          field_simp [hd_pos.ne']
        have h3 : b ≤ H_b * b := le_mul_of_one_le_left hb_nn hHb_ge_one
        linarith
      have hL_hi : L_amp ξ ≤ 3 * H_b * (a + b) := by
        dsimp [L_amp]
        rw [hb_eq]
        have h1 : stripSymDepth S ξ * ((2 * H_b / d) * b) ≤ (3 * d / 2) * ((2 * H_b / d) * b) :=
          mul_le_mul_of_nonneg_right hb_sub.2.2.2 (by positivity)
        have h2 : (3 * d / 2) * ((2 * H_b / d) * b) = 3 * H_b * b := by
          field_simp [hd_pos.ne']
        have h3 : a ≤ 3 * H_b * a := by nlinarith
        linarith
      rw [hE_eq]
      constructor
      · have hsq : (a + b) ^ 2 ≤ (L_amp ξ) ^ 2 :=
          pow_le_pow_left₀ (add_nonneg ha_nn hb_nn) hL_lo 2
        nlinarith
      · have hsq : (L_amp ξ) ^ 2 ≤ (3 * H_b * (a + b)) ^ 2 :=
          pow_le_pow_left₀ (le_trans (add_nonneg ha_nn hb_nn) hL_lo) hL_hi 2
        have h2ab : (a + b) ^ 2 ≤ 2 * (a ^ 2 + b ^ 2) := by nlinarith [sq_nonneg (a - b)]
        nlinarith
    have h_factor_le : 18 * H_b ^ 2 * Real.exp μ ≤ (Real.exp (5 * H_b)) ^ 2 := by
      have h2_le : (2 : ℝ) ≤ Real.exp 1 := by linarith [Real.add_one_le_exp (1 : ℝ)]
      have h18_le : (18 : ℝ) ≤ Real.exp (5 * H_b) := by
        have h32 : (18 : ℝ) ≤ 2 ^ 5 := by norm_num
        have hpow : (2 : ℝ) ^ 5 ≤ (Real.exp 1) ^ 5 := pow_le_pow_left₀ (by norm_num) h2_le 5
        rw [← Real.exp_nat_mul] at hpow
        have hexp_mono : Real.exp ((5 : ℕ) * 1) ≤ Real.exp (5 * H_b) :=
          Real.exp_le_exp.mpr (by push_cast; linarith)
        linarith
      have hHb_exp : H_b ^ 2 ≤ Real.exp (2 * H_b) := by
        have h1 : H_b ≤ Real.exp H_b := by linarith [Real.add_one_le_exp H_b]
        have h2 : H_b ^ 2 ≤ (Real.exp H_b) ^ 2 := pow_le_pow_left₀ (by linarith) h1 2
        rwa [← Real.exp_nat_mul, show ((2 : ℕ) : ℝ) * H_b = 2 * H_b by norm_num] at h2
      calc 18 * H_b ^ 2 * Real.exp μ
          ≤ Real.exp (5 * H_b) * Real.exp (2 * H_b) * Real.exp ((3 / 2 : ℝ) * H_b) := by
            gcongr
        _ = Real.exp ((17 / 2 : ℝ) * H_b) := by
            rw [← Real.exp_add, ← Real.exp_add]
            congr 1; ring
        _ ≤ Real.exp (10 * H_b) := Real.exp_le_exp.mpr (by linarith)
        _ = (Real.exp (5 * H_b)) ^ 2 := by
            rw [← Real.exp_nat_mul]
            congr 1; ring
    have hz_in_K : z ∈ K_ball := by
      have : γ_ℂ (1 : ℂ) = z := by simp [γ_ℂ, w]
      rw [← this]
      exact hγ_mem 1 ⟨zero_le_one, le_rfl⟩
    have hγ0 : γ_ℂ (0 : ℂ) = z₀ := by simp [γ_ℂ]
    have hγ1 : γ_ℂ (1 : ℂ) = z := by simp [γ_ℂ, w]
    have hLz_pos : 0 < L_amp z := hAmpArgPos z (hBallSubGen x d hd_pos hd_lt z hz_in_K).1
    have hLz0_pos : 0 < L_amp z₀ := hAmpArgPos z₀ (hBallSubGen x d hd_pos hd_lt z₀ hz₀_mem).1
    have h_upper_sq : (L_amp z) ^ 2 ≤ (Real.exp (5 * H_b) * L_amp z₀) ^ 2 := by
      have h1 := (hL_cmp z hz_in_K).2
      have h2 : E_pt z ≤ Real.exp μ * E_pt z₀ := by simpa [E, hγ0, hγ1] using hE_upper
