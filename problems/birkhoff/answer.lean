          ‖P.S_seq (φ₁ (ψ k)) (T_star, Y) - Y‖ ≤
            P.C_pass * T₀ ^ 2 * (-Y.im) ^ (1 - 2 * α) := by
        filter_upwards [(hφ₁.comp hψ_mono).tendsto_atTop.eventually
