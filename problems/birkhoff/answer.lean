          dsimp only [R_seq] at h_ab
          linarith
    have h_eq : sliceSupportSeq S P.N j.val (y_seq (a + d)) =
        sliceSupportSeq S P.N j.val (y_seq a) +
          (sliceSupportSeq S P.N j.val (y_seq (a + d)) - sliceSupportSeq S P.N j.val (y_seq a)) := by
      ring
    have h_sup_a :
        ‖sliceSupportSeq S P.N j.val (y_seq a)‖ ≤
          2 * Real.exp r_star * sliceRunningPosMax S P y_seq a :=
