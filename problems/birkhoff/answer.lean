                2 * (n : ℝ) + 1 := by ring
          linarith
        have hsq_nonneg : 0 ≤ ((n.centralBinom : ℝ) / (4 : ℝ) ^ n) ^ 2 := sq_nonneg _
        calc (2 * ((n : ℝ) + 1) + 1) *
              (((2 * (n : ℝ) + 1) / (2 * (n : ℝ) + 2)) *
                ((n.centralBinom : ℝ) / (4 : ℝ) ^ n)) ^ 2
