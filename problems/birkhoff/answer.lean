            Complex.exp (W (X₀ + (s : ℂ) * ((θ : ℂ) * Y₀)) - W X₀)
        have hPtMem : ∀ θ ∈ Set.Icc (0 : ℝ) 1, ∀ s ∈ Set.Icc (0 : ℝ) 1,
