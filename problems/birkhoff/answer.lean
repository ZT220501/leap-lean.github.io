      simp only [glancingImpact, Matrix.cons_val_zero, Matrix.cons_val_one, hμ_p]
      rw [h_trig, show (θ_0 + θ_p) / 2 - θ_0 = (θ_p - θ_0) / 2 by ring]
      unfold glancingOffset supportAction1_ℂ
