    have hpde : ∀ p ∈ W₁, pderivA v p * pderivD Δ p = pderivD v p * pderivA Δ p := by
      rintro ⟨z, t⟩ hp
      have hz : ‖z - z₀‖ < r₁ := by simpa [dist_eq_norm] using Metric.mem_ball.mp hp.1
      have ht : ‖t‖ < r₁ := by simpa [dist_zero_right] using Metric.mem_ball.mp hp.2
      have hvp : v (z, t) ∈ U₁ := hv_maps_U₁ (z, t) hp
      have hZ_diff_at : DifferentiableAt ℂ G.Z_loc (v (z, t)) :=
