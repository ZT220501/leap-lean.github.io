            · refine Finset.sup'_le _ _ fun n hn => ?_
              have hn_le : n ≤ m := Nat.lt_succ_iff.mp (Finset.mem_range.mp hn)
              rcases eq_or_lt_of_le hn_le with rfl | hn_lt
              · exact hLog_m_lt.le
              · have hn_mem : n ∈ Finset.range ((m - 1) + 1) :=
                  Finset.mem_range.mpr (Nat.lt_succ_of_le (Nat.le_sub_one_of_lt hn_lt))
                have hle_m1 := Finset.le_sup'
                  (fun k => sliceLogDepth S P j (walkPos ρ om k)) hn_mem
                change sliceLogDepth S P j (walkPos ρ om n) ≤ sliceHistory S P ρ om j (m - 1) at hle_m1
                linarith
          let l : ℤ := ⌊sliceHistory S P ρ om j m⌋
          have hl_mem : l ∈ I_M := by
            refine Finset.mem_Icc.mpr ⟨Int.floor_mono hHist_m_bounds.1, ?_⟩
            have h1 : l ≤ ⌊M + 1⌋ := Int.floor_mono hHist_m_bounds.2
            rw [Int.floor_add_one] at h1
            exact h1
          obtain ⟨n₀, hn₀_mem, hn₀_eq⟩ := Finset.exists_mem_eq_sup'
            ⟨0, Finset.mem_range.mpr (Nat.zero_lt_succ m)⟩
            (fun n => sliceLogDepth S P j (walkPos ρ om n))
          change sliceHistory S P ρ om j m = sliceLogDepth S P j (walkPos ρ om n₀) at hn₀_eq
          have hn₀_le_m : n₀ ≤ m := Nat.lt_succ_iff.mp (Finset.mem_range.mp hn₀_mem)
          have hd_n₀ : sliceShapeDepth S P j (walkPos ρ om n₀) ≤ Real.exp (-(l : ℝ)) := by
            have hl_le : (l : ℝ) ≤ sliceLogDepth S P j (walkPos ρ om n₀) := by
              rw [← hn₀_eq]; exact Int.floor_le _
            dsimp only [sliceLogDepth] at hl_le
            have h1 : Real.log (sliceShapeDepth S P j (walkPos ρ om n₀)) ≤ -(l : ℝ) := by linarith
            rw [← Real.exp_log (hDepthPosLeH om n₀ j).1]
            exact Real.exp_le_exp.mpr h1
          have hR_m : Real.exp (-(l : ℝ) - 1) * M ^ 4 ≤ sliceShapeDepth S P j (walkPos ρ om m) := by
            have hlt_l1 : sliceHistory S P ρ om j m < (l : ℝ) + 1 := Int.lt_floor_add_one _
            have hlog_gt : -(l : ℝ) - 1 + 4 * Real.log M ≤
                Real.log (sliceShapeDepth S P j (walkPos ρ om m)) := by
              dsimp only [sliceLogDepth] at hret
              linarith
            have hexp_eq : Real.exp (-(l : ℝ) - 1 + 4 * Real.log M) =
                Real.exp (-(l : ℝ) - 1) * M ^ 4 := by
              rw [Real.exp_add, show (4 : ℝ) * Real.log M = ((4 : ℕ) : ℝ) * Real.log M by norm_num,
                Real.exp_nat_mul, Real.exp_log hM_pos]
            rw [← hexp_eq, ← Real.exp_log (hDepthPosLeH om m j).1]
            exact Real.exp_le_exp.mpr hlog_gt
          refine Set.mem_iUnion₂.mpr ⟨(j, l), Finset.mem_product.mpr ⟨Finset.mem_univ j, hl_mem⟩, ?_⟩
          dsimp only [B_jl]
          let σ_l : WalkSpace → ℕ := fun om' =>
            @Nat.find (fun k => N_cap ≤ k ∨
              sliceShapeDepth S P j (walkPos ρ om' k) ≤ Real.exp (-(l : ℝ)))
              (Classical.decPred _) ⟨N_cap, Or.inl le_rfl⟩
          have hσ_le_n₀ : σ_l om ≤ n₀ := hFindMin' _ (Or.inr hd_n₀)
          have hσ_le_m : σ_l om ≤ m := le_trans hσ_le_n₀ hn₀_le_m
          have hd_σl : sliceShapeDepth S P j (walkPos ρ om (σ_l om)) ≤ Real.exp (-(l : ℝ)) := by
            have hspec := @Nat.find_spec (fun k => N_cap ≤ k ∨
              sliceShapeDepth S P j (walkPos ρ om k) ≤ Real.exp (-(l : ℝ)))
              (Classical.decPred _) ⟨N_cap, Or.inl le_rfl⟩
            rcases hspec with hgeN | hdl
            · have hEq_n₀ : σ_l om = n₀ := le_antisymm hσ_le_n₀ (le_trans (le_trans hn₀_le_m hm_N) hgeN)
              rw [hEq_n₀]; exact hd_n₀
