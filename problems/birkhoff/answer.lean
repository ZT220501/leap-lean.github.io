      hJet_congr (fun x => by simp only [one_mul]) hb_p_raw
    obtain ⟨_, hb_m_raw⟩ :=
      J_R.jet_props q ρ (-1) w (d (j + 1)) (fun x => -(d (j + 1) x - d j x))
