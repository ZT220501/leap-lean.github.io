      refine ⟨heq, fun h0 => ?_⟩
      rw [h0, Complex.zero_re] at hℓ_re
      exact lt_irrefl 0 hℓ_re
    have hℓ₀_div_lim : ∀ i : Fin k,
        Filter.Tendsto (fun δ : ℝ => ℓ₀ δ i / (δ : ℂ)) φ (nhds ((s_a : ℂ) / (k : ℂ))) := by
      intro i
      have hσ_lim : Filter.Tendsto (fun δ : ℝ => pculSlopeSpeed v_a (m₀ δ i)) φ (nhds (s_a : ℂ)) := by
        rw [← hσ_at_va]
        exact hσ_cont_va.tendsto.comp (hm₀_lim i)
      have hprod := (hΔx₀_div i).mul hσ_lim
      have hlim_eq : (1 / (k : ℂ)) * (s_a : ℂ) = (s_a : ℂ) / (k : ℂ) := by ring
      rw [hlim_eq] at hprod
      refine hprod.congr' ((hℓ₀_eq_ev i).mono fun δ ⟨heq, _⟩ => ?_)
      dsimp only
      rw [heq]
