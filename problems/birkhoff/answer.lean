      refine ⟨Real.contDiff_cos.comp (contDiff_const.mul contDiff_id), zero_le_one, fun k _ u => ?_⟩
      have hc : ContDiff ℝ (k : WithTop ℕ∞) Real.cos := Real.contDiff_cos
