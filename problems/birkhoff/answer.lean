        H_plus T T_c Y = g_plus T T_c Y := by
      intro T_c hTc T ⟨hT_hd, hT_col⟩
      have hfR_holo : DifferentiableOn ℂ (fun w => g_plus T T_c w) U_w := by
        have hmap : DifferentiableOn ℂ (fun w => (T, w + G T - G T_c)) U_w :=
          (differentiableOn_const T).prodMk
            ((differentiableOn_id.add (differentiableOn_const (G T))).sub
