        have h_rhs : (A₀ + 3) * (-Y.im - δ₀) ≤ (A₀ + 3) * (-Z.im) := by nlinarith
        nlinarith [hY.1, hY.2.2]
      have hUm_sub_Wm : U_m m ⊆ W_m :=
