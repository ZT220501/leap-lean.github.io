      have hQ_tilde_ev : ∀ d : Fin (D₀ + 1),
          ev_pt (Q_tilde d) = ((p_alg.coeff (d : ℕ) : ↥K_pt) : ℂ) * B_prod := by
        intro d
        dsimp only [Q_tilde, B_prod]
        rw [map_mul, map_prod, ← Finset.mul_prod_erase Finset.univ _ (Finset.mem_univ d), hAB_eq d]
        field_simp [hBd_ne d]
      have hQ_tilde_lead_ne : ev_pt (Q_tilde (Fin.last D₀)) ≠ 0 := by
        rw [hQ_tilde_ev (Fin.last D₀)]
        have hlead_ne : p_alg.coeff D₀ ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr hp_ne
        have hlead_C_ne : ((p_alg.coeff D₀ : ↥K_pt) : ℂ) ≠ 0 := fun h =>
