              simp [h_tr, lcJetTrunc1D, this, h1]
            have htr'_c0 : PowerSeries.coeff 0 (PowerSeries.derivative (h_tr i)) = h1 := by
              rw [PowerSeries.coeff_derivative, htr_c1]; simp
            have htr'_c1 : PowerSeries.coeff 1 (PowerSeries.derivative (h_tr i)) = h2 := by
              have : 2 ≤ n + 1 := by omega
              rw [PowerSeries.coeff_derivative]
              simp [h_tr, lcJetTrunc1D, this, h2]
              ring
            let P1 := compPowerSeries2D (PowerSeries.derivative (h_tr i)) (ψ0 + ηψ)
            let P1_0 := compPowerSeries2D (PowerSeries.derivative (h_tr i)) ψ0
            let Q1 := compPowerSeries2D (S_ser i) (d0 + ηd)
            let Q1_0 := compPowerSeries2D (S_ser i) d0
            let P2 := compPowerSeries2D (h_tr i) (ψ0 + ηψ)
            let P2_0 := compPowerSeries2D (h_tr i) ψ0
            let Q2 := compPowerSeries2D (C_ser i) (d0 + ηd)
            let Q2_0 := compPowerSeries2D (C_ser i) d0
            have hP1_vb : lineCoreVanishesBelow n (P1 - P1_0) :=
