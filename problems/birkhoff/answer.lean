  have hCA_vanish : ∀ (i : Fin m) (α k : ℕ), α < k →
      webDiffCoeffA (pderivA (ψ i)) (w i) α k = fun _ => 0 := by
    intro i α
    induction α with
    | zero =>
      intro k hk
      cases k with
      | zero => omega
      | succ k => rfl
    | succ α ih =>
      intro k hk
      cases k with
      | zero => omega
      | succ k =>
        ext p
        change pderivA (webDiffCoeffA (pderivA (ψ i)) (w i) α (k + 1)) p +
            webDiffCoeffA (pderivA (ψ i)) (w i) α k p * pderivA (ψ i) p = 0
        rw [ih (k + 1) (by omega), ih k (by omega), hpderivA_zero]
        simp
  have hC_vanish : ∀ (i : Fin m) (α β k : ℕ), α + β < k →
      webDiffCoeff (pderivA (ψ i)) (pderivD (ψ i)) (w i) α β k = fun _ => 0 := by
    intro i α β
    induction β with
    | zero =>
      intro k hk
      exact hCA_vanish i α k (by omega)
    | succ β ih =>
      intro k hk
      cases k with
      | zero => omega
      | succ k =>
        ext p
        change pderivD (webDiffCoeff (pderivA (ψ i)) (pderivD (ψ i)) (w i) α β (k + 1)) p +
            webDiffCoeff (pderivA (ψ i)) (pderivD (ψ i)) (w i) α β k p * pderivD (ψ i) p = 0
        rw [ih (k + 1) (by omega), ih k (by omega), hpderivD_zero]
        simp
  have hCA_diag : ∀ (i : Fin m) (α : ℕ) (p : ℂ × ℂ),
      webDiffCoeffA (pderivA (ψ i)) (w i) α α p = w i p * (pderivA (ψ i) p) ^ α := by
    intro i α
    induction α with
    | zero =>
      intro p
      change w i p = w i p * (pderivA (ψ i) p) ^ 0
      rw [pow_zero, mul_one]
    | succ α ih =>
      intro p
      change pderivA (webDiffCoeffA (pderivA (ψ i)) (w i) α (α + 1)) p +
          webDiffCoeffA (pderivA (ψ i)) (w i) α α p * pderivA (ψ i) p =
        w i p * (pderivA (ψ i) p) ^ (α + 1)
      rw [hCA_vanish i α (α + 1) (by omega), hpderivA_zero, ih p]
      simp [pow_succ, mul_assoc]
  have hC_diag : ∀ (i : Fin m) (α β : ℕ) (p : ℂ × ℂ),
