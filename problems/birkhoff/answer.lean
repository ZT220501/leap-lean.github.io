        (lt_trans hq.2 (div_lt_div_of_pos_left hDet.r_det_pos (by linarith) (by linarith)))
    have hqw_mem : q_w ∈ V_tilde := h_line_sub q_w hqw_im hqw_t
    have hB_sub : bandShearedBaseBox W.s_base x_c s_minus t₁ S.r₁ ε ⊆ V_tilde := by
