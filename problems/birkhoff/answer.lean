            MvPowerSeries.C (PowerSeries.coeff (m + 1) (g_seq 0) * ((m : ℂ) + 1)) *
              Z₀₀ ^ m * δ := by
          rw [← mul_assoc, ← mul_assoc, ← map_mul]
        rw [hderiv_alg]
        exact hMod_refl j _
      intro l hl
      rw [hSlice_zero_iff]; intro d
      let M := d 0 + d 1 + j + 1
      have hsum_mod : ModEq j
          (∑ m ∈ Finset.range M,
            MvPowerSeries.C (PowerSeries.mk (fun l' => PowerSeries.coeff (m + 1) (g_seq l'))) *
              Z₁ ^ (m + 1))
          ((∑ m ∈ Finset.range M,
            MvPowerSeries.C (PowerSeries.mk (fun l' => PowerSeries.coeff (m + 1) (g_seq l'))) *
              Z₀ ^ (m + 1)) +
            X_ε ^ j *
              ι₀ (∑ m ∈ Finset.range M,
                MvPowerSeries.C (PowerSeries.coeff m (PowerSeries.derivative (g_seq 0))) *
                  Z₀₀ ^ m * δ)) := by
        have hs := hMod_sum j (Finset.range M) _ _ (fun m _ => hterm_pert m)
        rwa [Finset.sum_add_distrib, ← Finset.mul_sum, ← hι_sum] at hs
      rw [map_sub, map_sub, sub_eq_zero, map_add, map_add,
        hComp2D1D_trunc g_seq hVB₁ d l M (by omega),
        hComp2D1D_trunc g_seq hVB₀ d l M (by omega),
        Finset.sum_range_succ' _ M, Finset.sum_range_succ' _ M]
      simp only [pow_zero, mul_one, map_add]
      have hstep := (hSlice_zero_iff l _).mp (hsum_mod l hl) d
      rw [map_sub, map_sub, sub_eq_zero, map_add, map_add] at hstep
      have hXj_coeff : ∀ Φ : MvPowerSeries (Fin 2) ℂ,
          PowerSeries.coeff l (MvPowerSeries.coeff d (X_ε ^ j * ι₀ Φ)) =
            if l = j then MvPowerSeries.coeff d Φ else 0 := by
        intro Φ
        by_cases hlj : l = j
        · subst hlj
          rw [if_pos rfl]
          dsimp only [X_ε]
          rw [← map_pow, MvPowerSeries.coeff_C_mul]
          have h0 : MvPowerSeries.coeff d (ι₀ Φ) = PowerSeries.C (MvPowerSeries.coeff d Φ) := rfl
          rw [h0]
          simpa [zero_add, PowerSeries.coeff_C] using
            PowerSeries.coeff_X_pow_mul (PowerSeries.C (MvPowerSeries.coeff d Φ)) j 0
        · rw [if_neg hlj]
          exact congr_arg (MvPowerSeries.coeff d) (hXj_VE Φ l (by omega))
      have htail_eq :
          PowerSeries.coeff l (MvPowerSeries.coeff d
            (X_ε ^ j * ι₀ (∑ m ∈ Finset.range M,
              MvPowerSeries.C (PowerSeries.coeff m (PowerSeries.derivative (g_seq 0))) *
                Z₀₀ ^ m * δ))) =
          PowerSeries.coeff l (MvPowerSeries.coeff d
            (X_ε ^ j * ι₀ (compPowerSeries2D (PowerSeries.derivative (g_seq 0)) Z₀₀ * δ))) := by
        rw [hXj_coeff, hXj_coeff]
        split_ifs with hlj
        · rw [← Finset.sum_mul, MvPowerSeries.coeff_mul, MvPowerSeries.coeff_mul]
