    let Ω_map : Set (ℂ × (ℂ × ℂ)) := Ω_base ∩ F_map ⁻¹' U
    have hΩ_map_open : IsOpen Ω_map := hF_map_cont.isOpen_inter_preimage hΩ_base_open hU_open
    let K_prod : Set (ℂ × (ℂ × ℂ)) :=
      upperHalfDiskBdry ×ˢ (Metric.closedBall (0 : ℂ) ρ_star ×ˢ K_seg)
    have hK_prod_compact : IsCompact K_prod :=
      hCompact_bdry.prod ((isCompact_closedBall (0 : ℂ) ρ_star).prod hK_seg_compact)
    have hK_prod_sub : K_prod ⊆ Ω_map := by
      rintro ⟨ζ, T_c, w⟩ ⟨hζ, hTc, y, hy, rfl⟩
      obtain ⟨hζG, hTcG, hmemU⟩ := hBdry_mem ζ hζ T_c hTc y hy
      exact ⟨⟨hζG, hTcG⟩, hmemU⟩
    obtain ⟨δ_th, hδ_th_pos, hδ_th_sub⟩ :=
      hK_prod_compact.exists_thickening_subset_open hΩ_map_open hK_prod_sub
    let V_collar : Set ℂ := Metric.thickening δ_th upperHalfDiskBdry
    have hV_collar_open : IsOpen V_collar := Metric.isOpen_thickening
    have hBdry_sub_collar : upperHalfDiskBdry ⊆ V_collar :=
      Metric.self_subset_thickening hδ_th_pos _
    let U_w : Set ℂ :=
      { w : ℂ | |w.re - Y.re| < δ_th / 3 ∧
        -D_deep - δ_th / 3 < w.im ∧ w.im < Y.im + δ_th / 3 }
    have hUw_open : IsOpen U_w := by
      have h1 : IsOpen { w : ℂ | |w.re - Y.re| < δ_th / 3 } :=
        isOpen_lt (continuous_abs.comp (Complex.continuous_re.sub continuous_const)) continuous_const
      have h2 : IsOpen { w : ℂ | -D_deep - δ_th / 3 < w.im } :=
        isOpen_lt continuous_const Complex.continuous_im
      have h3 : IsOpen { w : ℂ | w.im < Y.im + δ_th / 3 } :=
        isOpen_lt Complex.continuous_im continuous_const
      exact h1.inter (h2.inter h3)
    have hUw_conv : Convex ℝ U_w := by
      intro x hx y hy a b ha hb hab
      obtain ⟨hx_re, hx_l, hx_u⟩ := hx
      obtain ⟨hy_re, hy_l, hy_u⟩ := hy
      have hre_comb : (a • x + b • y).re - Y.re = a * (x.re - Y.re) + b * (y.re - Y.re) := by
        simp only [Complex.add_re, Complex.real_smul, Complex.mul_re, Complex.ofReal_re,
          Complex.ofReal_im, zero_mul, sub_zero]
        linear_combination Y.re * hab
      have him_comb : (a • x + b • y).im = a * x.im + b * y.im := by
        simp only [Complex.add_im, Complex.real_smul, Complex.mul_im, Complex.ofReal_re,
          Complex.ofReal_im, zero_mul, add_zero]
      refine ⟨?_, ?_, ?_⟩
      · rw [hre_comb]
        have htri := abs_add_le (a * (x.re - Y.re)) (b * (y.re - Y.re))
        rw [abs_mul, abs_mul, abs_of_nonneg ha, abs_of_nonneg hb] at htri
        rcases eq_or_lt_of_le ha with rfl | ha_pos
        · have hb1 : b = 1 := by linarith
          subst hb1; linarith
        · have hax := mul_lt_mul_of_pos_left hx_re ha_pos
          have hby := mul_le_mul_of_nonneg_left (le_of_lt hy_re) hb
          have h1 : a * (δ_th / 3) + b * (δ_th / 3) = δ_th / 3 := by
            linear_combination (δ_th / 3) * hab
          linarith
      · rw [him_comb]
        rcases eq_or_lt_of_le ha with rfl | ha_pos
        · have hb1 : b = 1 := by linarith
          subst hb1; linarith
        · have hax := mul_lt_mul_of_pos_left hx_l ha_pos
          have hby := mul_le_mul_of_nonneg_left (le_of_lt hy_l) hb
          have h1 : a * (-D_deep - δ_th / 3) + b * (-D_deep - δ_th / 3) = -D_deep - δ_th / 3 := by
            linear_combination (-D_deep - δ_th / 3) * hab
          linarith
      · rw [him_comb]
        rcases eq_or_lt_of_le ha with rfl | ha_pos
        · have hb1 : b = 1 := by linarith
          subst hb1; linarith
        · have hax := mul_lt_mul_of_pos_left hx_u ha_pos
          have hby := mul_le_mul_of_nonneg_left (le_of_lt hy_u) hb
          have h1 : a * (Y.im + δ_th / 3) + b * (Y.im + δ_th / 3) = Y.im + δ_th / 3 := by
            linear_combination (Y.im + δ_th / 3) * hab
          linarith
    have hUw_preconn : IsPreconnected U_w := hUw_conv.isPreconnected
    have hw₀_in_Uw : w₀ ∈ U_w := by
      refine ⟨?_, ?_, ?_⟩
      · simp [w₀]; positivity
      · simp [w₀]; linarith
      · simp [w₀]; linarith
    have hY_in_Uw : Y ∈ U_w := by
      refine ⟨?_, ?_, ?_⟩
      · simp; positivity
      · linarith
      · linarith
    have hCollar_Uw_mem : ∀ ζ ∈ V_collar, ∀ T_c ∈ Metric.closedBall (0 : ℂ) ρ_star, ∀ w ∈ U_w,
        ζ ∈ V_G ∧ T_c ∈ V_G ∧ (ζ, w + G ζ - G T_c) ∈ U := by
      intro ζ hζ T_c hTc w hw
      rw [Metric.mem_thickening_iff] at hζ
      obtain ⟨ζ', hζ'_mem, hζ_dist⟩ := hζ
      obtain ⟨hw_re, hw_l, hw_u⟩ := hw
      let y_p : ℝ := min (max (-w.im) (-Y.im)) D_deep
      have hyp_mem : y_p ∈ Set.Icc (-Y.im) D_deep :=
        ⟨le_min (le_max_right _ _) (le_of_lt hY_lt_deep), min_le_right _ _⟩
      have hyp_im : |w.im + y_p| < δ_th / 3 := by
        dsimp [y_p]
        rcases le_total (-w.im) (-Y.im) with h1 | h1
        · rw [max_eq_right h1, min_eq_left (le_of_lt hY_lt_deep)]
          exact abs_lt.mpr ⟨by linarith, by linarith⟩
        · rw [max_eq_left h1]
          rcases le_total (-w.im) D_deep with h2 | h2
          · rw [min_eq_left h2, add_neg_cancel, abs_zero]
