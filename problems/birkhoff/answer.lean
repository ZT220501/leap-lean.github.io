      have hΔ_t₂ : Δ_bad (t₂ : ℂ) ≠ 0 := fun h0 => ht₂_not_E ⟨ht₂_ball, h0⟩
      obtain ⟨r_u, r_t', z, hr_u, hr_t', hz_holo, hz_t₂, hz_prop⟩ :=
        hΔ_slice (t₂ : ℂ) ht₂_ball hΔ_t₂ y_star hy_star
      refine ⟨r_u, r_t', z, hr_u, hr_t', hz_holo, hz_t₂, ?_⟩
      intro u hu t ht
      obtain ⟨hzu_ry, ht_rt, hu_W_nz⟩ := hz_prop u hu t ht
      have hzu_Ry : z t + u ∈ Metric.ball y₀ R_y :=
        Metric.ball_subset_ball hr_y_le hzu_ry
      have ht_Rt : t ∈ Metric.ball t_tilde R_t :=
        Metric.ball_subset_ball hr_t_le ht_rt
      refine ⟨⟨hsub_y hzu_Ry, hsub_t ht_Rt⟩, ?_⟩
      intro hu_ne hH_zero
      exact hu_W_nz hu_ne ((hW_iff (z t + u) hzu_ry t ht_rt).mp hH_zero)
    · have hH_cont : ContinuousAt H (y₀, t_tilde) :=
        (hHolo.differentiableAt (hBidisk_open.mem_nhds ⟨hy₀_Uy, ht_Ut⟩)).continuousAt
      obtain ⟨δ, hδ_pos, hδ_nz⟩ :=
        Metric.mem_nhds_iff.mp (hH_cont.eventually_ne hH_q0)
      let r_y : ℝ := min δ R_y
      let r_t : ℝ := min δ R_t
      have hr_y_pos : 0 < r_y := lt_min hδ_pos hR_y_pos
      have hr_t_pos : 0 < r_t := lt_min hδ_pos hR_t_pos
      let B : Set (ℂ × ℂ) := Metric.ball y₀ (r_y / 2) ×ˢ Metric.ball t_tilde (r_t / 2)
      refine ⟨B, ∅, Metric.isOpen_ball.prod Metric.isOpen_ball,
        ⟨Metric.mem_ball_self (by positivity), Metric.mem_ball_self (by positivity)⟩,
        Set.countable_empty, ?_⟩
      intro y_star t₂ ⟨hy_star, ht₂_ball⟩ _
      refine ⟨r_y / 2, r_t / 2, fun _ => y_star, by positivity, by positivity,
        differentiableOn_const y_star, rfl, ?_⟩
      intro u hu t ht
      have hyu_ry : y_star + u ∈ Metric.ball y₀ r_y := by
        rw [Metric.mem_ball]
        have h1 : dist y_star y₀ < r_y / 2 := Metric.mem_ball.mp hy_star
        have h2 : dist (y_star + u) y_star < r_y / 2 := by
          simpa [Metric.mem_ball, dist_eq_norm] using hu
        linarith [dist_triangle (y_star + u) y_star y₀]
      have ht_rt : t ∈ Metric.ball t_tilde r_t := by
        rw [Metric.mem_ball]
        have h1 : dist (t₂ : ℂ) t_tilde < r_t / 2 := Metric.mem_ball.mp ht₂_ball
        have h2 : dist t (t₂ : ℂ) < r_t / 2 := Metric.mem_ball.mp ht
        linarith [dist_triangle t (t₂ : ℂ) t_tilde]
      refine ⟨⟨hsub_y (Metric.ball_subset_ball (min_le_right _ _) hyu_ry),
        hsub_t (Metric.ball_subset_ball (min_le_right _ _) ht_rt)⟩, fun _ => ?_⟩
      apply hδ_nz
      rw [Metric.mem_ball, Prod.dist_eq, max_lt_iff]
      exact ⟨lt_of_lt_of_le (Metric.mem_ball.mp hyu_ry) (min_le_left _ _),
        lt_of_lt_of_le (Metric.mem_ball.mp ht_rt) (min_le_left _ _)⟩
  choose B_fn E_loc_fn hB_open hq_mem_B hEloc_cnt hB_slice using h_local_box
  obtain ⟨T_cnt, hT_cnt, hT_union⟩ :=
    TopologicalSpace.isOpen_iUnion_countable B_fn hB_open
  let E_weier : Set ℝ := E_slice ∪ ⋃ q ∈ T_cnt, E_loc_fn q
  have hE_weier_cnt : E_weier.Countable :=
    hE_slice_cnt.union (hT_cnt.biUnion fun q _ => hEloc_cnt q)
  refine ⟨E_weier, hE_weier_cnt, ?_⟩
  intro t₂ ht₂_not_E ht₂_34
  have ht₂_Ut : (t₂ : ℂ) ∈ U_t := Metric.ball_subset_ball (by linarith) ht₂_34
  have ht₂_yp_nz : H (y_p, (t₂ : ℂ)) ≠ 0 :=
    fun h0 => ht₂_not_E (Or.inl ⟨ht₂_Ut, h0⟩)
  have ht₂_Dgood : (t₂ : ℂ) ∈ D_good :=
    ⟨ht₂_Ut, Set.mem_compl_singleton_iff.mpr ht₂_yp_nz⟩
  have hslice_t₂_holo : DifferentiableOn ℂ (fun y => H (y, (t₂ : ℂ))) U_y :=
    hHolo.comp (differentiable_id.prodMk (differentiable_const (t₂ : ℂ))).differentiableOn
      (fun y hy => ⟨hy, ht₂_Ut⟩)
  have hFin_zeros :
      ({ y : ℂ | y ∈ Metric.closedBall y_c (3 * ρ_y / 4) ∧ H (y, (t₂ : ℂ)) = 0 }).Finite :=
    (h_zero_disc_cnt_fin y_c ρ_y hρ_y (fun y => H (y, (t₂ : ℂ))) hslice_t₂_holo
      ⟨y_p, hy_p, ht₂_yp_nz⟩).2 (3 * ρ_y / 4) (by linarith)
  refine ⟨hFin_zeros, ?_⟩
  intro y_star hy_star
  let q₀ : ↥Ω_good := ⟨(y_star, (t₂ : ℂ)), ⟨hy_star, ht₂_Dgood⟩⟩
  have hmem_union : (y_star, (t₂ : ℂ)) ∈ ⋃ q : ↥Ω_good, B_fn q :=
    Set.mem_iUnion.mpr ⟨q₀, hq_mem_B q₀⟩
  rw [← hT_union] at hmem_union
  rcases Set.mem_iUnion₂.mp hmem_union with ⟨q₁, hq₁_T, hmem_Bq₁⟩
  have ht₂_not_loc : t₂ ∉ E_loc_fn q₁ :=
    fun hbad => ht₂_not_E (Or.inr (Set.mem_iUnion₂.mpr ⟨q₁, hq₁_T, hbad⟩))
  exact hB_slice q₁ y_star t₂ hmem_Bq₁ ht₂_not_loc

theorem separable_poly_rect_root_continuation : SeparableRectRootContProp :=
by
  intro a₁ a₂ b₁ b₂ t_c r_t D _ha _hb hr_t _hD R_w U A hA_holo hSep
  have hRw_open : IsOpen R_w :=
    (isOpen_lt continuous_const Complex.continuous_re).inter
      ((isOpen_lt Complex.continuous_re continuous_const).inter
        ((isOpen_lt continuous_const Complex.continuous_im).inter
          (isOpen_lt Complex.continuous_im continuous_const)))
  have hU_open : IsOpen U := hRw_open.prod Metric.isOpen_ball
  
  let π₁ : (ℂ × ℂ) →L[ℂ] ℂ :=
    { toLinearMap :=
        { toFun := Prod.fst
          map_add' := fun _ _ => rfl
          map_smul' := fun _ _ => rfl }
      cont := continuous_fst }
  let π₂ : (ℂ × ℂ) →L[ℂ] ℂ :=
    { toLinearMap :=
        { toFun := Prod.snd
          map_add' := fun _ _ => rfl
          map_smul' := fun _ _ => rfl }
      cont := continuous_snd }
  let j₁ : ℂ →L[ℂ] (ℂ × ℂ) :=
    { toLinearMap :=
        { toFun := fun z => (z, 0)
          map_add' := fun _ _ => by ext <;> simp
          map_smul' := fun _ _ => by ext <;> simp }
      cont := continuous_id.prodMk continuous_const }
  let j₂ : ℂ →L[ℂ] (ℂ × ℂ) :=
    { toLinearMap :=
        { toFun := fun z => (0, z)
          map_add' := fun _ _ => by ext <;> simp
          map_smul' := fun _ _ => by ext <;> simp }
      cont := continuous_const.prodMk continuous_id }
  let τ_swap : (ℂ × ℂ) →L[ℂ] (ℂ × ℂ) :=
    { toLinearMap :=
        { toFun := fun p => (p.2, p.1)
          map_add' := fun _ _ => rfl
          map_smul' := fun _ _ => rfl }
      cont := continuous_snd.prodMk continuous_fst }
  let S₁ := ContinuousLinearMap.smulRightL ℂ (ℂ × ℂ) ℂ π₁
  let S₂ := ContinuousLinearMap.smulRightL ℂ (ℂ × ℂ) ℂ π₂
  have hpderivA_contAt : ∀ {W : Set (ℂ × ℂ)} {g : ℂ × ℂ → ℂ} {q_s : ℂ × ℂ},
      IsOpen W → DifferentiableOn ℂ g W → q_s ∈ W → ContinuousAt (pderivA g) q_s := by
    intro W g q_s hW hg hq_s
    obtain ⟨r₀, hr₀_pos, hr₀_sub⟩ := Metric.isOpen_iff.mp hW q_s hq_s
    let R : ℝ := r₀ / 4
    have hR_pos : 0 < R := by dsimp [R]; linarith
    have hR_ne : R ≠ 0 := ne_of_gt hR_pos
    let K : Set (ℂ × ℂ) := Metric.closedBall q_s (3 * R)
    have hK_sub_W : K ⊆ W :=
      Set.Subset.trans (Metric.closedBall_subset_ball (by dsimp [R]; linarith)) hr₀_sub
    have hg_ucont : UniformContinuousOn g K :=
      (isCompact_closedBall q_s (3 * R)).uniformContinuousOn_of_continuous
        (hg.continuousOn.mono hK_sub_W)
    have h_slice_holo : ∀ (w z₀ : ℂ) (ρ_s : ℝ),
        (∀ ζ ∈ Metric.ball z₀ ρ_s, (ζ, w) ∈ W) →
        DifferentiableOn ℂ (fun ζ => g (ζ, w)) (Metric.ball z₀ ρ_s) := by
      intro w z₀ ρ_s h_mem ζ hζ
      have hι_d : HasDerivAt (fun ζ' : ℂ => (ζ', w)) (1, 0) ζ := by
        simpa [j₁] using (j₁.hasDerivAt (x := ζ)).add_const ((0 : ℂ), w)
      exact ((hg.differentiableAt (hW.mem_nhds (h_mem ζ hζ))).comp ζ
        hι_d.differentiableAt).differentiableWithinAt
    have h_base_mem : ∀ ζ ∈ Metric.ball q_s.1 (2 * R), (ζ, q_s.2) ∈ W := by
      intro ζ hζ
      apply hr₀_sub
      rw [Metric.mem_ball, Prod.dist_eq]
      have h1 : dist ζ q_s.1 < 2 * R := Metric.mem_ball.mp hζ
      exact max_lt (by dsimp [R] at h1 ⊢; linarith) (by simp [hr₀_pos])
    have h_base_deriv_holo :
        DifferentiableOn ℂ (fun z => pderivA g (z, q_s.2)) (Metric.ball q_s.1 (2 * R)) :=
      (h_slice_holo q_s.2 q_s.1 (2 * R) h_base_mem).deriv Metric.isOpen_ball
    have h_base_cont : ContinuousAt (fun z => pderivA g (z, q_s.2)) q_s.1 :=
      (h_base_deriv_holo.differentiableAt
        (Metric.isOpen_ball.mem_nhds (Metric.mem_ball_self (by linarith)))).continuousAt
    rw [Metric.continuousAt_iff]
    intro ε hε
    obtain ⟨δ₁, hδ₁_pos, hδ₁⟩ :=
      Metric.uniformContinuousOn_iff.mp hg_ucont (R * (ε / 3)) (mul_pos hR_pos (by linarith))
    obtain ⟨δ₂, hδ₂_pos, hδ₂⟩ :=
      Metric.continuousAt_iff.mp h_base_cont (ε / 3) (by linarith)
    refine ⟨min R (min δ₁ δ₂), lt_min hR_pos (lt_min hδ₁_pos hδ₂_pos), ?_⟩
    rintro ⟨z, w⟩ hq_dist
    have hq_R : dist (z, w) q_s < R := lt_of_lt_of_le hq_dist (min_le_left _ _)
    have hq_δ₁ : dist (z, w) q_s < δ₁ :=
      lt_of_lt_of_le hq_dist (le_trans (min_le_right _ _) (min_le_left _ _))
    have hq_δ₂ : dist (z, w) q_s < δ₂ :=
      lt_of_lt_of_le hq_dist (le_trans (min_le_right _ _) (min_le_right _ _))
    rw [Prod.dist_eq] at hq_R hq_δ₁ hq_δ₂
    have hz_R : dist z q_s.1 < R := lt_of_le_of_lt (le_max_left _ _) hq_R
    have hw_R : dist w q_s.2 < R := lt_of_le_of_lt (le_max_right _ _) hq_R
    have hw_δ₁ : dist w q_s.2 < δ₁ := lt_of_le_of_lt (le_max_right _ _) hq_δ₁
    have hz_δ₂ : dist z q_s.1 < δ₂ := lt_of_le_of_lt (le_max_left _ _) hq_δ₂
    have h_term₂ : dist (pderivA g (z, q_s.2)) (pderivA g q_s) < ε / 3 := hδ₂ hz_δ₂
    have hw_mem : ∀ ζ ∈ Metric.ball z (2 * R), (ζ, w) ∈ W := by
      intro ζ hζ
      apply hr₀_sub
      rw [Metric.mem_ball, Prod.dist_eq]
      have hζz : dist ζ z < 2 * R := Metric.mem_ball.mp hζ
      have hζ1 : dist ζ q_s.1 ≤ dist ζ z + dist z q_s.1 := dist_triangle ζ z q_s.1
      exact max_lt (by dsimp [R] at hζz hz_R ⊢; linarith) (by dsimp [R] at hw_R ⊢; linarith)
    have hqs_mem : ∀ ζ ∈ Metric.ball z (2 * R), (ζ, q_s.2) ∈ W := by
      intro ζ hζ
      apply hr₀_sub
      rw [Metric.mem_ball, Prod.dist_eq]
      have hζz : dist ζ z < 2 * R := Metric.mem_ball.mp hζ
      have hζ1 : dist ζ q_s.1 ≤ dist ζ z + dist z q_s.1 := dist_triangle ζ z q_s.1
      exact max_lt (by dsimp [R] at hζz hz_R ⊢; linarith) (by simp [hr₀_pos])
    have hw_holo := h_slice_holo w z (2 * R) hw_mem
    have hqs_holo := h_slice_holo q_s.2 z (2 * R) hqs_mem
    let Δ_fn : ℂ → ℂ := fun ζ => g (ζ, w) - g (ζ, q_s.2)
    have hΔ_holo : DifferentiableOn ℂ Δ_fn (Metric.ball z (2 * R)) := hw_holo.sub hqs_holo
    have hz_in_2R : z ∈ Metric.ball z (2 * R) := Metric.mem_ball_self (by linarith)
    have hΔ_deriv : deriv Δ_fn z = pderivA g (z, w) - pderivA g (z, q_s.2) :=
      deriv_sub (hw_holo.differentiableAt (Metric.isOpen_ball.mem_nhds hz_in_2R))
        (hqs_holo.differentiableAt (Metric.isOpen_ball.mem_nhds hz_in_2R))
    have hΔ_dc : DiffContOnCl ℂ Δ_fn (Metric.ball z R) :=
      ⟨hΔ_holo.mono (Metric.ball_subset_ball (by linarith)),
       hΔ_holo.continuousOn.mono
         (Set.Subset.trans closure_ball_subset_closedBall
           (Metric.closedBall_subset_ball (by linarith)))⟩
    have hΔ_sph : ∀ ζ ∈ Metric.sphere z R, ‖Δ_fn ζ‖ ≤ R * (ε / 3) := by
      intro ζ hζ
      have hζz : dist ζ z = R := Metric.mem_sphere.mp hζ
      have hζ1 : dist ζ q_s.1 ≤ 3 * R := by
        have htr := dist_triangle ζ z q_s.1
        linarith
      have h_zw_K : (ζ, w) ∈ K := by
        rw [Metric.mem_closedBall, Prod.dist_eq]
        exact max_le hζ1 (by linarith)
      have h_zqs_K : (ζ, q_s.2) ∈ K := by
        rw [Metric.mem_closedBall, Prod.dist_eq]
        exact max_le hζ1 (by simp; linarith)
      have h_pair_dist : dist (ζ, w) (ζ, q_s.2) < δ₁ := by
        rw [Prod.dist_eq, dist_self]
        exact max_lt hδ₁_pos hw_δ₁
      rw [← dist_eq_norm]
      exact le_of_lt (hδ₁ (ζ, w) h_zw_K (ζ, q_s.2) h_zqs_K h_pair_dist)
    have h_cauchy :=
      Complex.norm_deriv_le_of_forall_mem_sphere_norm_le hR_pos hΔ_dc hΔ_sph
    rw [hΔ_deriv, mul_div_cancel_left₀ _ hR_ne, ← dist_eq_norm] at h_cauchy
    calc dist (pderivA g (z, w)) (pderivA g q_s)
        ≤ dist (pderivA g (z, w)) (pderivA g (z, q_s.2)) +
            dist (pderivA g (z, q_s.2)) (pderivA g q_s) := dist_triangle _ _ _
      _ < ε := by linarith
  have hStrict2D : ∀ (g : ℂ × ℂ → ℂ), DifferentiableOn ℂ g U →
      ∀ q_s ∈ U, HasStrictFDerivAt g (S₁ (pderivA g q_s) + S₂ (pderivD g q_s)) q_s := by
    intro g hg q_s hq_s
    have hpA_cont : ContinuousAt (pderivA g) q_s := hpderivA_contAt hU_open hg hq_s
    have hpD_cont : ContinuousAt (pderivD g) q_s := by
      have hW'_open : IsOpen (τ_swap ⁻¹' U) := hU_open.preimage τ_swap.continuous
      have hg_swap : DifferentiableOn ℂ (g ∘ τ_swap) (τ_swap ⁻¹' U) :=
        hg.comp τ_swap.differentiableOn (fun _ hp => hp)
      have hqs_swap : τ_swap q_s ∈ τ_swap ⁻¹' U := by
        change (q_s.1, q_s.2) ∈ U
        exact hq_s
      exact (hpderivA_contAt hW'_open hg_swap hqs_swap).comp τ_swap.continuous.continuousAt
    have hfderiv_on : ∀ q ∈ U, HasFDerivAt g (S₁ (pderivA g q) + S₂ (pderivD g q)) q := by
      intro q hq
      have hgd : HasFDerivAt g (fderiv ℂ g q) q :=
        (hg.differentiableAt (hU_open.mem_nhds hq)).hasFDerivAt
      have hι₁ : HasDerivAt (fun z : ℂ => (z, q.2)) (1, 0) q.1 := by
        simpa [j₁] using (j₁.hasDerivAt (x := q.1)).add_const ((0 : ℂ), q.2)
      have hι₂ : HasDerivAt (fun z : ℂ => (q.1, z)) (0, 1) q.2 := by
        simpa [j₂] using (j₂.hasDerivAt (x := q.2)).add_const (q.1, (0 : ℂ))
      have hpA : pderivA g q = (fderiv ℂ g q) (1, 0) := by
        have h1 : HasFDerivAt g (fderiv ℂ g q) (q.1, q.2) := hgd
        exact (h1.comp_hasDerivAt q.1 hι₁).deriv
      have hpD : pderivD g q = (fderiv ℂ g q) (0, 1) := by
        have h2 : HasFDerivAt g (fderiv ℂ g q) (q.1, q.2) := hgd
        exact (h2.comp_hasDerivAt q.2 hι₂).deriv
      have hu_decomp : ∀ u : ℂ × ℂ, u = u.1 • ((1 : ℂ), (0 : ℂ)) + u.2 • ((0 : ℂ), (1 : ℂ)) := by
        intro u; ext <;> simp
      have h_eq : fderiv ℂ g q = S₁ (pderivA g q) + S₂ (pderivD g q) := by
        refine ContinuousLinearMap.ext (fun u => ?_)
        conv_lhs => rw [hu_decomp u]
        rw [map_add, map_smul, map_smul, ← hpA, ← hpD]
        simp [S₁, S₂, π₁, π₂]
      rwa [← h_eq]
    have h_ev : ∀ᶠ q in nhds q_s, HasFDerivAt g (S₁ (pderivA g q) + S₂ (pderivD g q)) q :=
      Filter.eventually_of_mem (hU_open.mem_nhds hq_s) hfderiv_on
    have h_cont : ContinuousAt (fun q => S₁ (pderivA g q) + S₂ (pderivD g q)) q_s :=
      (S₁.continuous.continuousAt.comp hpA_cont).add
        (S₂.continuous.continuousAt.comp hpD_cont)
    exact hasStrictFDerivAt_of_hasFDerivAt_of_continuousAt h_ev h_cont
  
  let p_q : ((ℂ × ℂ) × ℂ) →L[ℂ] (ℂ × ℂ) :=
    { toLinearMap :=
        { toFun := Prod.fst
          map_add' := fun _ _ => rfl
          map_smul' := fun _ _ => rfl }
      cont := continuous_fst }
  let p_z : ((ℂ × ℂ) × ℂ) →L[ℂ] ℂ :=
    { toLinearMap :=
        { toFun := Prod.snd
          map_add' := fun _ _ => rfl
          map_smul' := fun _ _ => rfl }
      cont := continuous_snd }
  let ι₀_CLM : (ℂ × ℂ) →L[ℂ] ((ℂ × ℂ) × ℂ) :=
    { toLinearMap :=
        { toFun := fun q => (q, 0)
          map_add' := fun _ _ => Prod.ext rfl (by simp)
          map_smul' := fun _ _ => Prod.ext rfl (by simp) }
      cont := continuous_id.prodMk continuous_const }
  let P_fn : ℂ × ℂ → ℂ → ℂ := fun q z => ∑ d : Fin (D + 1), A d q * z ^ (d : ℕ)
  let Pz_fn : ℂ × ℂ → ℂ → ℂ :=
    fun q z => ∑ d : Fin D, (((d : ℕ) + 1 : ℕ) : ℂ) * A d.succ q * z ^ (d : ℕ)
  let Φ_fn : (ℂ × ℂ) × ℂ → (ℂ × ℂ) × ℂ := fun x => (x.1, P_fn x.1 x.2)
  have hΦ_strict : ∀ q₀ ∈ U, ∀ z₀ : ℂ, Pz_fn q₀ z₀ ≠ 0 →
      ∃ L_Φ : ((ℂ × ℂ) × ℂ) ≃L[ℂ] ((ℂ × ℂ) × ℂ),
        HasStrictFDerivAt Φ_fn (L_Φ : ((ℂ × ℂ) × ℂ) →L[ℂ] ((ℂ × ℂ) × ℂ)) (q₀, z₀) := by
    intro q₀ hq₀ z₀ hlam₀
    let L_A : Fin (D + 1) → (ℂ × ℂ) →L[ℂ] ℂ :=
      fun d => S₁ (pderivA (A d) q₀) + S₂ (pderivD (A d) q₀)
    let L_q : (ℂ × ℂ) →L[ℂ] ℂ := ∑ d : Fin (D + 1), (z₀ ^ (d : ℕ)) • L_A d
    let lam₀ : ℂ := Pz_fn q₀ z₀
    let L_Φ : ((ℂ × ℂ) × ℂ) ≃L[ℂ] ((ℂ × ℂ) × ℂ) :=
      ContinuousLinearEquiv.mk
        { toFun := fun x => (x.1, L_q x.1 + lam₀ * x.2)
          invFun := fun y => (y.1, lam₀⁻¹ * (y.2 - L_q y.1))
          left_inv := fun ⟨u, w⟩ =>
            Prod.ext rfl (by dsimp; rw [add_sub_cancel_left, inv_mul_cancel_left₀ hlam₀])
          right_inv := fun ⟨u, v⟩ =>
            Prod.ext rfl (by dsimp; rw [mul_inv_cancel_left₀ hlam₀, add_sub_cancel])
          map_add' := fun ⟨u₁, w₁⟩ ⟨u₂, w₂⟩ =>
            Prod.ext rfl (by dsimp; rw [map_add]; ring)
          map_smul' := fun c ⟨u, w⟩ =>
            Prod.ext rfl (by
              change L_q (c • u) + lam₀ * (c * w) = c * (L_q u + lam₀ * w)
              rw [map_smul, smul_eq_mul]
              ring) }
        (continuous_fst.prodMk
          ((L_q.continuous.comp continuous_fst).add (continuous_const.mul continuous_snd)))
        (continuous_fst.prodMk
          (continuous_const.mul (continuous_snd.sub (L_q.continuous.comp continuous_fst))))
    have h_term : ∀ d : Fin (D + 1),
        HasStrictFDerivAt (fun x : (ℂ × ℂ) × ℂ => A d x.1 * x.2 ^ (d : ℕ))
          ((A d q₀) • ((((d : ℕ) : ℂ) * z₀ ^ ((d : ℕ) - 1)) • p_z) +
            (z₀ ^ (d : ℕ)) • ((L_A d).comp p_q))
          (q₀, z₀) := by
      intro d
      have h1 : HasStrictFDerivAt (fun x : (ℂ × ℂ) × ℂ => A d x.1)
          ((L_A d).comp p_q) (q₀, z₀) :=
        (hStrict2D (A d) (hA_holo d) q₀ hq₀).comp (q₀, z₀) (p_q.hasStrictFDerivAt (x := (q₀, z₀)))
      have h2 : HasStrictFDerivAt (fun x : (ℂ × ℂ) × ℂ => x.2 ^ (d : ℕ))
          ((((d : ℕ) : ℂ) * z₀ ^ ((d : ℕ) - 1)) • p_z) (q₀, z₀) :=
        (hasStrictDerivAt_pow (d : ℕ) z₀).comp_hasStrictFDerivAt
          (q₀, z₀) (p_z.hasStrictFDerivAt (x := (q₀, z₀)))
      exact h1.mul h2
    have hP_sum : HasStrictFDerivAt (fun x : (ℂ × ℂ) × ℂ => P_fn x.1 x.2)
        (∑ d : Fin (D + 1),
          ((A d q₀) • ((((d : ℕ) : ℂ) * z₀ ^ ((d : ℕ) - 1)) • p_z) +
            (z₀ ^ (d : ℕ)) • ((L_A d).comp p_q)))
        (q₀, z₀) := by
      have h_fn : (∑ d : Fin (D + 1), fun x : (ℂ × ℂ) × ℂ => A d x.1 * x.2 ^ (d : ℕ)) =
          (fun x => P_fn x.1 x.2) := by
        ext x; simp [P_fn]
      rw [← h_fn]
      exact HasStrictFDerivAt.sum (u := Finset.univ) (fun d _ => h_term d)
    have hΦ_raw := (p_q.hasStrictFDerivAt (x := (q₀, z₀))).prodMk hP_sum
    refine ⟨L_Φ, ?_⟩
    convert hΦ_raw using 1
    refine ContinuousLinearMap.ext (fun ⟨u, w⟩ => ?_)
    refine Prod.ext rfl ?_
    change L_q u + lam₀ * w = _
    simp only [ContinuousLinearMap.prod_apply, _root_.sum_apply,
      _root_.add_apply, _root_.smul_apply,
      ContinuousLinearMap.comp_apply, L_q, smul_eq_mul]
    change (∑ x : Fin (D + 1), z₀ ^ (x : ℕ) * (L_A x) u) + lam₀ * w =
      ∑ x : Fin (D + 1), (A x q₀ * (↑↑x * z₀ ^ ((x : ℕ) - 1) * w) + z₀ ^ (x : ℕ) * (L_A x) u)
    rw [Finset.sum_add_distrib]
    have h_w_sum :
        (∑ x : Fin (D + 1), A x q₀ * (↑↑x * z₀ ^ ((x : ℕ) - 1) * w)) = lam₀ * w := by
      rw [Fin.sum_univ_succ]
      simp only [Fin.val_zero, CharP.cast_eq_zero, zero_mul, mul_zero, zero_add, Fin.val_succ,
        Nat.add_sub_cancel, lam₀, Pz_fn, Finset.sum_mul]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      push_cast
      ring
    rw [h_w_sum]
    ring
  have hLoc_sheet : ∀ q_s ∈ U, ∀ z_s : ℂ, P_fn q_s z_s = 0 →
      ∃ (δ_q δ_z : ℝ) (ρ : ℂ × ℂ → ℂ),
        0 < δ_q ∧ 0 < δ_z ∧
        Metric.ball q_s δ_q ⊆ U ∧
        DifferentiableOn ℂ ρ (Metric.ball q_s δ_q) ∧
        ρ q_s = z_s ∧
        (∀ q ∈ Metric.ball q_s δ_q, ρ q ∈ Metric.ball z_s δ_z ∧ P_fn q (ρ q) = 0) ∧
        (∀ q ∈ Metric.ball q_s δ_q, ∀ z ∈ Metric.ball z_s δ_z, P_fn q z = 0 → z = ρ q) := by
    intro q_s hq_s z_s hz_s
    have hPz_s : Pz_fn q_s z_s ≠ 0 := (hSep q_s hq_s).2 z_s hz_s
    obtain ⟨L_s, hf_s⟩ := hΦ_strict q_s hq_s z_s hPz_s
    let e := hf_s.toOpenPartialHomeomorph Φ_fn
    have he_coe : (e : (ℂ × ℂ) × ℂ → (ℂ × ℂ) × ℂ) = Φ_fn := hf_s.toOpenPartialHomeomorph_coe
    have hx_src : (q_s, z_s) ∈ e.source := hf_s.mem_toOpenPartialHomeomorph_source
    have hΦ_pt : Φ_fn (q_s, z_s) = (q_s, 0) := Prod.ext rfl hz_s
    have hy_tgt : (q_s, (0 : ℂ)) ∈ e.target := by
      rw [← hΦ_pt]
      exact hf_s.image_mem_toOpenPartialHomeomorph_target
    have he_symm_pt : e.symm (q_s, 0) = (q_s, z_s) := by
      have h_eq : e (q_s, z_s) = (q_s, 0) := by rw [he_coe]; exact hΦ_pt
      rw [← h_eq]
      exact e.left_inv hx_src
    have h_open_src : IsOpen ((U ×ˢ (Set.univ : Set ℂ)) ∩ e.source) :=
      (hU_open.prod isOpen_univ).inter e.open_source
    obtain ⟨δ_z, hδ_z_pos, hδ_z_sub⟩ :=
      Metric.isOpen_iff.mp h_open_src (q_s, z_s) ⟨⟨hq_s, trivial⟩, hx_src⟩
    have h_tgt_nhds : e.target ∩ e.symm ⁻¹' Metric.ball (q_s, z_s) δ_z ∈ nhds (q_s, (0 : ℂ)) :=
      Filter.inter_mem (e.open_target.mem_nhds hy_tgt)
        ((e.continuousAt_symm hy_tgt).preimage_mem_nhds
          (he_symm_pt.symm ▸ Metric.ball_mem_nhds (q_s, z_s) hδ_z_pos))
    have h_q_nhds :
        (ι₀_CLM ⁻¹' (e.target ∩ e.symm ⁻¹' Metric.ball (q_s, z_s) δ_z)) ∩
          Metric.ball q_s δ_z ∈ nhds q_s :=
      Filter.inter_mem (ι₀_CLM.continuous.continuousAt.preimage_mem_nhds h_tgt_nhds)
        (Metric.ball_mem_nhds q_s hδ_z_pos)
    obtain ⟨δ_q, hδ_q_pos, hδ_q_sub⟩ := Metric.mem_nhds_iff.mp h_q_nhds
    let ρ : ℂ × ℂ → ℂ := fun q => p_z (e.symm (ι₀_CLM q))
    have hball_U : Metric.ball q_s δ_q ⊆ U := by
      intro q hq
      have hq_bz : q ∈ Metric.ball q_s δ_z := (hδ_q_sub hq).2
      have hqz_ball : (q, z_s) ∈ Metric.ball (q_s, z_s) δ_z := by
        rw [← ball_prod_same]
        exact ⟨hq_bz, Metric.mem_ball_self hδ_z_pos⟩
      exact (hδ_z_sub hqz_ball).1.1
    have hρ_props : ∀ q ∈ Metric.ball q_s δ_q,
        e.symm (ι₀_CLM q) = (q, ρ q) ∧ ρ q ∈ Metric.ball z_s δ_z ∧ P_fn q (ρ q) = 0 := by
      intro q hq
      obtain ⟨⟨hq_tgt, hq_symm_ball⟩, _⟩ := hδ_q_sub hq
      have h_rinv : Φ_fn (e.symm (ι₀_CLM q)) = ι₀_CLM q := by
        rw [← he_coe]
        exact e.right_inv hq_tgt
      have h_fst : (e.symm (ι₀_CLM q)).1 = q := congr_arg Prod.fst h_rinv
      have h_snd : P_fn (e.symm (ι₀_CLM q)).1 (ρ q) = 0 := congr_arg Prod.snd h_rinv
      rw [h_fst] at h_snd
      rw [← ball_prod_same] at hq_symm_ball
      exact ⟨Prod.ext h_fst rfl, hq_symm_ball.2, h_snd⟩
    have hρ_holo : DifferentiableOn ℂ ρ (Metric.ball q_s δ_q) := by
      intro q hq
      obtain ⟨⟨hq_tgt, _⟩, _⟩ := hδ_q_sub hq
      obtain ⟨he_symm_eq, _, hρ_sol⟩ := hρ_props q hq
      have hq_U : q ∈ U := hball_U hq
      have hPz_q : Pz_fn q (ρ q) ≠ 0 := (hSep q hq_U).2 (ρ q) hρ_sol
      obtain ⟨L_q_eqv, hf_q⟩ := hΦ_strict q hq_U (ρ q) hPz_q
      have hf_e : HasStrictFDerivAt e
          (L_q_eqv : ((ℂ × ℂ) × ℂ) →L[ℂ] ((ℂ × ℂ) × ℂ)) (e.symm (ι₀_CLM q)) := by
        rwa [he_coe, he_symm_eq]
      have h_symm_diff : DifferentiableAt ℂ e.symm (ι₀_CLM q) :=
        (e.hasStrictFDerivAt_symm hq_tgt hf_e).differentiableAt
      exact ((p_z.differentiableAt.comp (ι₀_CLM q) h_symm_diff).comp
        q ι₀_CLM.differentiableAt).differentiableWithinAt
    have hρ_pt : ρ q_s = z_s := by
      change (e.symm (q_s, 0)).2 = z_s
      rw [he_symm_pt]
    have hρ_uniq : ∀ q ∈ Metric.ball q_s δ_q, ∀ z ∈ Metric.ball z_s δ_z,
        P_fn q z = 0 → z = ρ q := by
      intro q hq z hz_ball hz_sol
      have hq_bz : q ∈ Metric.ball q_s δ_z := (hδ_q_sub hq).2
      have hqz_ball : (q, z) ∈ Metric.ball (q_s, z_s) δ_z := by
        rw [← ball_prod_same]
        exact ⟨hq_bz, hz_ball⟩
      have hqz_src : (q, z) ∈ e.source := (hδ_z_sub hqz_ball).2
      have he_qz : e (q, z) = ι₀_CLM q := by
        rw [he_coe]
        exact Prod.ext rfl hz_sol
      have h_linv : e.symm (e (q, z)) = (q, z) := e.left_inv hqz_src
      rw [he_qz] at h_linv
      exact (congr_arg Prod.snd h_linv).symm
    exact ⟨δ_q, δ_z, ρ, hδ_q_pos, hδ_z_pos, hball_U, hρ_holo, hρ_pt,
      fun q hq => ⟨(hρ_props q hq).2.1, (hρ_props q hq).2.2⟩, hρ_uniq⟩
  
  have hUniq : ∀ (V : Set (ℂ × ℂ)) (g₁ g₂ : ℂ × ℂ → ℂ) (q₀ : ℂ × ℂ),
      IsOpen V → IsPreconnected V → V ⊆ U → q₀ ∈ V →
      DifferentiableOn ℂ g₁ V → DifferentiableOn ℂ g₂ V →
      (∀ q ∈ V, P_fn q (g₁ q) = 0) →
      (∀ q ∈ V, P_fn q (g₂ q) = 0) →
      g₁ q₀ = g₂ q₀ →
      ∀ q ∈ V, g₁ q = g₂ q := by
    intro V g₁ g₂ q₀ hV_open hV_preconn hV_sub hq₀ hg₁ hg₂ hg₁_sol hg₂_sol hg_eq
    let S_eq : Set (ℂ × ℂ) := { q ∈ V | g₁ q = g₂ q }
    have hSeq_open : IsOpen S_eq := by
      rw [Metric.isOpen_iff]
      intro q_s ⟨hq_V, hq_eq⟩
      let z_s := g₁ q_s
      obtain ⟨δ_q, δ_z, ρ, hδ_q_pos, hδ_z_pos, _, _, _, _, hρ_uniq⟩ :=
        hLoc_sheet q_s (hV_sub hq_V) z_s (hg₁_sol q_s hq_V)
      have hg₁_cont : ContinuousAt g₁ q_s :=
        (hg₁.differentiableAt (hV_open.mem_nhds hq_V)).continuousAt
      have hg₂_cont : ContinuousAt g₂ q_s :=
        (hg₂.differentiableAt (hV_open.mem_nhds hq_V)).continuousAt
      have hz₁_mem : g₁ ⁻¹' Metric.ball z_s δ_z ∈ nhds q_s :=
        hg₁_cont.preimage_mem_nhds (Metric.ball_mem_nhds z_s hδ_z_pos)
      have hz₂_mem : g₂ ⁻¹' Metric.ball z_s δ_z ∈ nhds q_s :=
        hg₂_cont.preimage_mem_nhds (hq_eq ▸ Metric.ball_mem_nhds z_s hδ_z_pos)
      have hM_nhds :
          V ∩ Metric.ball q_s δ_q ∩ g₁ ⁻¹' Metric.ball z_s δ_z ∩
            g₂ ⁻¹' Metric.ball z_s δ_z ∈ nhds q_s :=
        Filter.inter_mem
          (Filter.inter_mem
            (Filter.inter_mem (hV_open.mem_nhds hq_V) (Metric.ball_mem_nhds q_s hδ_q_pos))
            hz₁_mem)
          hz₂_mem
      obtain ⟨r, hr_pos, hr_sub⟩ := Metric.mem_nhds_iff.mp hM_nhds
      refine ⟨r, hr_pos, fun p hp => ?_⟩
      obtain ⟨⟨⟨hp_V, hp_δq⟩, hp_g₁⟩, hp_g₂⟩ := hr_sub hp
      have h1 : g₁ p = ρ p := hρ_uniq p hp_δq (g₁ p) hp_g₁ (hg₁_sol p hp_V)
      have h2 : g₂ p = ρ p := hρ_uniq p hp_δq (g₂ p) hp_g₂ (hg₂_sol p hp_V)
      exact ⟨hp_V, h1.trans h2.symm⟩
    have hSeq_closed : closure S_eq ∩ V ⊆ S_eq := by
      rintro q_s ⟨hq_cl, hq_V⟩
      refine ⟨hq_V, ?_⟩
      by_contra h_ne
      have hg₁_cont : ContinuousAt g₁ q_s :=
        (hg₁.differentiableAt (hV_open.mem_nhds hq_V)).continuousAt
      have hg₂_cont : ContinuousAt g₂ q_s :=
        (hg₂.differentiableAt (hV_open.mem_nhds hq_V)).continuousAt
      have h_sub_ne : g₁ q_s - g₂ q_s ≠ 0 := sub_ne_zero.mpr h_ne
      have h_ev : ∀ᶠ p in nhds q_s, g₁ p - g₂ p ≠ 0 :=
        (hg₁_cont.sub hg₂_cont).preimage_mem_nhds (isOpen_compl_singleton.mem_nhds h_sub_ne)
      obtain ⟨r, hr_pos, hr_sub⟩ := Metric.mem_nhds_iff.mp h_ev
      obtain ⟨p, hp_Seq, hp_dist⟩ := Metric.mem_closure_iff.mp hq_cl r hr_pos
      have hp_ball : p ∈ Metric.ball q_s r := by
        rw [Metric.mem_ball, dist_comm]
        exact hp_dist
      exact hr_sub hp_ball (sub_eq_zero.mpr hp_Seq.2)
    have hV_sub_Seq : V ⊆ S_eq :=
      hV_preconn.subset_of_closure_inter_subset hSeq_open ⟨q₀, hq₀, hq₀, hg_eq⟩ hSeq_closed
    exact fun q hq => (hV_sub_Seq hq).2
  refine ⟨hUniq, ?_⟩
  
  intro a₁' a₂' b₁' b₂' w₀ z₀ ha₁' ha₁₂' ha₂' hb₁' hb₁₂' hb₂' hw₀_re₁ hw₀_re₂ hw₀_im₁ hw₀_im₂ hz₀ R_w'
  let P_poly : ℂ × ℂ → Polynomial ℂ :=
    fun q => ∑ d : Fin (D + 1), Polynomial.C (A d q) * Polynomial.X ^ (d : ℕ)
  have hP_eval : ∀ q z, Polynomial.eval z (P_poly q) = P_fn q z := by
    intro q z
    simp [P_poly, P_fn, Polynomial.eval_finsetSum]
  have hPz_eval : ∀ q z, Polynomial.eval z (Polynomial.derivative (P_poly q)) = Pz_fn q z := by
    intro q z
    simp only [P_poly, map_sum, Polynomial.derivative_C_mul_X_pow, Polynomial.eval_finsetSum,
      Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_pow, Polynomial.eval_X]
    rw [Fin.sum_univ_succ]
    simp only [Fin.val_zero, CharP.cast_eq_zero, mul_zero, zero_mul, zero_add, Fin.val_succ,
      Nat.add_sub_cancel, Pz_fn]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    push_cast
    ring
  have hP_deg_ne : ∀ q ∈ U, P_poly q ≠ 0 ∧ (P_poly q).natDegree = D ∧
      (P_poly q).roots.toFinset.card = D := by
    intro q hq
    have h_coeff : ∀ n : ℕ, (P_poly q).coeff n =
        ∑ d : Fin (D + 1), if n = (d : ℕ) then A d q else 0 := by
      intro n
      simp [P_poly, Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
    have h_coeff_D : (P_poly q).coeff D = A (Fin.last D) q := by
      rw [h_coeff D]
      have h_eq : (∑ d : Fin (D + 1), if D = (d : ℕ) then A d q else 0) =
          ∑ d : Fin (D + 1), if d = Fin.last D then A d q else 0 := by
        refine Finset.sum_congr rfl (fun d _ => ?_)
        have h_iff : (D = (d : ℕ)) ↔ (d = Fin.last D) :=
          ⟨fun h => Fin.ext h.symm, fun h => by subst h; rfl⟩
        simp [h_iff]
      rw [h_eq, Finset.sum_ite_eq' Finset.univ (Fin.last D)]
      simp
    have h_ne : P_poly q ≠ 0 := by
      intro h0
      apply (hSep q hq).1
      rw [← h_coeff_D, h0, Polynomial.coeff_zero]
    have h_deg_ge : D ≤ (P_poly q).natDegree :=
      Polynomial.le_natDegree_of_ne_zero (h_coeff_D ▸ (hSep q hq).1)
    have h_deg_le : (P_poly q).natDegree ≤ D := by
      rw [Polynomial.natDegree_le_iff_coeff_eq_zero]
      intro N hN
      rw [h_coeff N]
      refine Finset.sum_eq_zero (fun d _ => ?_)
      have h_neq : N ≠ (d : ℕ) := by have := d.2; omega
      simp [h_neq]
    have h_deg : (P_poly q).natDegree = D := le_antisymm h_deg_le h_deg_ge
    have h_nodup : (P_poly q).roots.Nodup := by
      rw [Multiset.nodup_iff_count_le_one]
      intro z
      rw [Polynomial.count_roots]
      by_contra h_gt
      have h_one_lt : 1 < Polynomial.rootMultiplicity z (P_poly q) := not_le.mp h_gt
      obtain ⟨h_root, h_droot⟩ := (Polynomial.one_lt_rootMultiplicity_iff_isRoot h_ne).mp h_one_lt
      rw [Polynomial.IsRoot.def, hP_eval] at h_root
      rw [Polynomial.IsRoot.def, hPz_eval] at h_droot
      exact (hSep q hq).2 z h_root h_droot
    have h_card : (P_poly q).roots.toFinset.card = D := by
      rw [Multiset.toFinset_card_of_nodup h_nodup, IsAlgClosed.card_roots_eq_natDegree, h_deg]
    exact ⟨h_ne, h_deg, h_card⟩
  have hTriv_at : ∀ q ∈ U, ∃ r_q : ℝ, 0 < r_q ∧ Metric.ball q r_q ⊆ U ∧
      ∀ q' ∈ Metric.ball q r_q, ∀ z_s : ℂ, P_fn q' z_s = 0 →
        ∃ σ : ℂ × ℂ → ℂ,
          DifferentiableOn ℂ σ (Metric.ball q r_q) ∧
          σ q' = z_s ∧
          ∀ q'' ∈ Metric.ball q r_q, P_fn q'' (σ q'') = 0 := by
    intro q hq
    obtain ⟨hPq_ne, _, hS₀_card⟩ := hP_deg_ne q hq
    let S₀ : Finset ℂ := (P_poly q).roots.toFinset
    have h_root_S₀ : ∀ z : ↥S₀, P_fn q z.1 = 0 := by
      intro z
      have hz_mem : z.1 ∈ (P_poly q).roots := Multiset.mem_toFinset.mp z.2
      have hz_isRoot : (P_poly q).IsRoot z.1 := (Polynomial.mem_roots hPq_ne).mp hz_mem
      rwa [Polynomial.IsRoot.def, hP_eval] at hz_isRoot
    choose δ_z _ ρ_z hδ_z_pos _ _ hρ_z_holo hρ_z_pt hρ_z_sol _ using
      fun z : ↥S₀ => hLoc_sheet q hq z.1 (h_root_S₀ z)
    have hM_balls : (⋂ z : ↥S₀, Metric.ball q (δ_z z)) ∈ nhds q :=
      Filter.iInter_mem.mpr (fun z => Metric.ball_mem_nhds q (hδ_z_pos z))
    have hM_sep :
        (⋂ p : ↥S₀ × ↥S₀, { q' : ℂ × ℂ | p.1 ≠ p.2 → ρ_z p.1 q' ≠ ρ_z p.2 q' }) ∈ nhds q := by
      rw [Filter.iInter_mem]
      intro ⟨z₁, z₂⟩
      by_cases h_eq : z₁ = z₂
      · exact Filter.univ_mem' (fun _ h_ne => False.elim (h_ne h_eq))
      · have hc₁ : ContinuousAt (ρ_z z₁) q :=
          ((hρ_z_holo z₁).differentiableAt
            (Metric.isOpen_ball.mem_nhds (Metric.mem_ball_self (hδ_z_pos z₁)))).continuousAt
        have hc₂ : ContinuousAt (ρ_z z₂) q :=
          ((hρ_z_holo z₂).differentiableAt
            (Metric.isOpen_ball.mem_nhds (Metric.mem_ball_self (hδ_z_pos z₂)))).continuousAt
        have h_diff_ne : ρ_z z₁ q - ρ_z z₂ q ≠ 0 := by
          rw [hρ_z_pt z₁, hρ_z_pt z₂]
          exact sub_ne_zero.mpr (fun hv => h_eq (Subtype.ext hv))
        have h_ev : ∀ᶠ q' in nhds q, ρ_z z₁ q' - ρ_z z₂ q' ≠ 0 :=
          (hc₁.sub hc₂).preimage_mem_nhds (isOpen_compl_singleton.mem_nhds h_diff_ne)
        exact Filter.mem_of_superset h_ev (fun q' hq' _ => sub_ne_zero.mp hq')
    have hM_all :
        U ∩ (⋂ z : ↥S₀, Metric.ball q (δ_z z)) ∩
          (⋂ p : ↥S₀ × ↥S₀, { q' : ℂ × ℂ | p.1 ≠ p.2 → ρ_z p.1 q' ≠ ρ_z p.2 q' }) ∈ nhds q :=
      Filter.inter_mem (Filter.inter_mem (hU_open.mem_nhds hq) hM_balls) hM_sep
