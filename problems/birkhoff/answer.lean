    let φ : ℂ → ℂ := fun S' => F_act n (S', q_curr.2.1, T)
    let ψ : ℂ → ℂ := fun s' => (s' - s_n) / ℓ_n
    have h_comp_eq : (fun s' => P.p_act s' q_curr.2.1 t_step) = φ ∘ ψ := by
