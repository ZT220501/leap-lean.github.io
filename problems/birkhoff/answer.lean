      dsimp [C_env, ρ] at h1 h2 ⊢
      linarith
  · 
    intro j
    have h1 := hx_base_gap j
    have h2 := hx_base_lip j
    have h3 : ρ_c x₀ ≤ |ρ_c x₀| := le_abs_self _
    have h4 : 0 ≤ K₁ * x₀ := mul_nonneg (by linarith) hx₀
    have h5 : 0 ≤ (C₀ + |ρ_c x₀| + x₀ + 1) * x_seq j :=
      mul_nonneg (by linarith [abs_nonneg (ρ_c x₀)]) (hx_seq_nonneg j)
    dsimp [C_env, ρ] at h1 ⊢
    linarith

theorem convex_moment_contact_dichotomy (m : ℝ → ℝ)
    (hm_pos : ∀ D : ℝ, 0 < D → 0 < m D)
    (hm_one : m 1 = 1)
    (hm_le : ∀ D : ℝ, 0 < D → m D ≤ D⁻¹)
    (hm_conv : ConvexOn ℝ (Set.Ioi 0) (fun D => Real.log (m D))) :
    MomentLawSteepBranch m ∨ MomentLawBoundedBranch m :=
by
  obtain ⟨p, ρ_c, hρ_cont, hρ_mono, hρ_ge, hp_pos, hp_exp, hp_int,
      hρc_cont, hρc_bounds, hρc_lo, hρc_lb, hρc_att, hρc_flat⟩ :=
    convex_log_moment_envelope_calculus m hm_pos hm_one hm_le hm_conv
  by_cases h_unbdd : ∀ x₀ M : ℝ, ∃ z : ℝ,
      x₀ ≤ z ∧ ρ_c z = -Real.log (m (Real.exp z)) ∧ M ≤ p z
  · exact Or.inl (unbounded_contact_steep_branch m p ρ_c
      hm_pos hp_pos hp_exp hp_int hρc_bounds hρc_lb hρc_att h_unbdd)
  · simp only [not_forall, not_exists, not_and, not_le] at h_unbdd
    rcases h_unbdd with ⟨x₀_raw, M_raw, h_raw⟩
    let x₀ : ℝ := max x₀_raw 0
    let K₁ : ℝ := max M_raw 1
    have hx₀ : 0 ≤ x₀ := le_max_right x₀_raw 0
    have hK₁ : 1 ≤ K₁ := le_max_right M_raw 1
    have h_bdd : ∀ z : ℝ, x₀ ≤ z → ρ_c z = -Real.log (m (Real.exp z)) → p z ≤ K₁ := by
      intro z hz h_eq
      exact le_of_lt (lt_of_lt_of_le (h_raw z (le_trans (le_max_left x₀_raw 0) hz) h_eq)
        (le_max_left M_raw 1))
    obtain ⟨hρc_lip, r, hr_eq, hr_lo, hr_hi, hr_ge⟩ :=
      bounded_contact_envelope_lipschitz m p ρ_c x₀ K₁
        hK₁ hρ_cont hp_exp hp_int hρc_cont hρc_bounds hρc_lo hρc_flat h_bdd
    obtain ⟨m_seq, q_star, lam, hlam, _, hm_seq_ge, hm_seq_top,
        hq_cont, hq_zero, hq_lip, hq_top, hq_bot, hq_lim⟩ :=
      bilipschitz_shift_two_ended_slope r x₀ K₁ hx₀ hK₁ hr_lo hr_hi hr_ge
    exact Or.inr (contact_limit_transfer_to_bounded_branch
      m p ρ_c r m_seq q_star x₀ K₁ lam
      hx₀ hK₁ hlam hρ_mono hρ_ge hp_pos hp_exp hp_int
      hρc_bounds hρc_lo hρc_lip hρc_flat hr_eq
      hm_seq_ge hm_seq_top hq_cont hq_zero hq_lip hq_top hq_bot hq_lim)

theorem steep_diagonal_moment_scale_transfer (S : FiniteWallNonisotropicStrip)
    (k_seq ε_seq : ℕ → ℝ) (m : ℝ → ℝ)
    (h_basic : ∀ n : ℕ, criticalDepthThreshold S ≤ k_seq n ∧
      0 < ε_seq n ∧ 1 ≤ rowMomentFull S (k_seq n))
    (hk_top : Filter.Tendsto k_seq Filter.atTop Filter.atTop)
    (hB_top : Filter.Tendsto (fun n => rowMomentFull S (k_seq n)) Filter.atTop Filter.atTop)
    (hε_zero : Filter.Tendsto ε_seq Filter.atTop (nhds 0))
    (h_norm : ∀ n : ℕ, ∀ j : ℝ, criticalDepthThreshold S ≤ j →
      rowMomentFull S j ≤ rowMomentFull S (k_seq n) * Real.exp (ε_seq n * |j - k_seq n|))
    (hm_pos : ∀ D : ℝ, 0 < D → 0 < m D)
    (hm_lim : TendstoLocallyUniformlyOn
      (fun n D =>
        rowMomentFull S (k_seq n - Real.log D) / (rowMomentFull S (k_seq n) * D))
      m Filter.atTop (Set.Ioi 0))
    (hSteep : MomentLawSteepBranch m) :
    ∃ (C_tail' : ℝ) (h_seq ℓ_seq m0_seq : ℕ → ℝ),
      SteepDiagonalRowData S ((1 / 4 : ℝ) * Real.exp (-criticalDepthThreshold S))
        C_tail' h_seq ℓ_seq m0_seq :=
by
  let k₀ : ℝ := criticalDepthThreshold S
  let δ_b : ℝ := (1 / 4 : ℝ) * Real.exp (-k₀)
  have hk₀_pos_exp : 0 < Real.exp (-k₀) := Real.exp_pos (-k₀)
  have hexp_k₀_le : Real.exp (-k₀) ≤ S.H / 20 := by
    have hk₀_ge : -Real.log (S.H / 20) ≤ k₀ := le_max_right 1 (-Real.log (S.H / 20))
    have hSH20_pos : 0 < S.H / 20 := by linarith [S.H_pos]
    calc
      Real.exp (-k₀) ≤ Real.exp (Real.log (S.H / 20)) :=
        Real.exp_le_exp.mpr (by linarith)
      _ = S.H / 20 := Real.exp_log hSH20_pos
  have hδ_pos : 0 < δ_b := by positivity
  have hδ_le : δ_b ≤ S.H / 80 := by
    have h_def : δ_b = (1 / 4 : ℝ) * Real.exp (-k₀) := rfl
    linarith
  have hδ_53_lt : (5 / 3 : ℝ) * δ_b < S.H := by linarith [S.H_pos]
  have hδ_72_lt_exp : (7 / 2 : ℝ) * δ_b < Real.exp (-k₀) := by
    have h_def : δ_b = (1 / 4 : ℝ) * Real.exp (-k₀) := rfl
    linarith
  have hδ_72_lt_H : (7 / 2 : ℝ) * δ_b < S.H := by linarith [S.H_pos]
  let d_seq : ℕ → ℝ := fun n => Real.exp (-k_seq n)
  let B_seq : ℕ → ℝ := fun n => rowMomentFull S (k_seq n)
  let m_approx : ℕ → ℝ → ℝ := fun n D =>
    rowMomentFull S (k_seq n - Real.log D) / (B_seq n * D)
  have hd_pos : ∀ n : ℕ, 0 < d_seq n := fun n => Real.exp_pos (-k_seq n)
  have hB_ge_one : ∀ n : ℕ, 1 ≤ B_seq n := fun n => (h_basic n).2.2
  have hB_pos : ∀ n : ℕ, 0 < B_seq n := fun n => lt_of_lt_of_le zero_lt_one (hB_ge_one n)
  have hE_nonneg : ∀ y : ℝ, 0 ≤ steepRowEnergy S y := by
    intro y
    unfold steepRowEnergy
    apply mul_nonneg (inv_nonneg.mpr Real.two_pi_pos.le)
    exact intervalIntegral.integral_nonneg Real.two_pi_pos.le
      (fun x _ => by positivity)
  have h_exp_shift : ∀ (n : ℕ) {D : ℝ}, 0 < D →
      Real.exp (-(k_seq n - Real.log D)) = d_seq n * D := by
    intro n D hD
    have h1 : -(k_seq n - Real.log D) = -k_seq n + Real.log D := by ring
    rw [h1, Real.exp_add, Real.exp_log hD]
  have hm_approx_eq : ∀ (n : ℕ) {D : ℝ}, 0 < D →
      m_approx n D =
        (d_seq n / B_seq n) * Real.sqrt (steepRowEnergy S (S.H - d_seq n * D)) := by
    intro n D hD
    have hrow : rowMomentFull S (k_seq n - Real.log D) =
        (d_seq n * D) * Real.sqrt (steepRowEnergy S (S.H - d_seq n * D)) := by
      unfold rowMomentFull
      simp_rw [h_exp_shift n hD]
      rfl
    dsimp only [m_approx]
    rw [hrow]
    have hB_ne : B_seq n ≠ 0 := (hB_pos n).ne'
    have hD_ne : D ≠ 0 := hD.ne'
    field_simp [hB_ne, hD_ne]
  have hm_approx_nonneg : ∀ (n : ℕ) {D : ℝ}, 0 < D → 0 ≤ m_approx n D := by
    intro n D hD
    rw [hm_approx_eq n hD]
    exact mul_nonneg (div_nonneg (hd_pos n).le (hB_pos n).le) (Real.sqrt_nonneg _)
  have h_energy_eq : ∀ (n : ℕ) {D : ℝ}, 0 < D →
      steepRowEnergy S (S.H - d_seq n * D) =
        ((B_seq n / d_seq n) * m_approx n D) ^ 2 := by
    intro n D hD
    have h_sqrt : (B_seq n / d_seq n) * m_approx n D =
        Real.sqrt (steepRowEnergy S (S.H - d_seq n * D)) := by
      rw [hm_approx_eq n hD]
      have hd_ne : d_seq n ≠ 0 := (hd_pos n).ne'
      have hB_ne : B_seq n ≠ 0 := (hB_pos n).ne'
      field_simp [hd_ne, hB_ne]
    rw [h_sqrt, Real.sq_sqrt (hE_nonneg (S.H - d_seq n * D))]
  have h_energy_ratio : ∀ (n : ℕ) {D₁ D₂ : ℝ}, 0 < D₁ → 0 < D₂ → m_approx n D₁ ≠ 0 →
      steepRowEnergy S (S.H - d_seq n * D₂) /
        ((B_seq n / d_seq n) * m_approx n D₁) ^ 2 =
        (m_approx n D₂ / m_approx n D₁) ^ 2 := by
    intro n D₁ D₂ _ hD₂ hm₁_ne
    rw [h_energy_eq n hD₂]
    have hd_ne : d_seq n ≠ 0 := (hd_pos n).ne'
    have hB_ne : B_seq n ≠ 0 := (hB_pos n).ne'
    field_simp [hd_ne, hB_ne, hm₁_ne]
  obtain ⟨x_st, P_st, C_tail, hC_tail, h_xp, _hx_top, hP_top, h_loc_unif, h_tail⟩ :=
    hSteep.exists_data
  let R : ℕ → ℝ := fun j => 2 * ((j : ℝ) + 2)
  let δ_st : ℕ → ℝ := fun j =>
    (16 * Real.exp 2 * (2 * Real.exp 1 + 1) * ((j : ℝ) + 1))⁻¹
  have hR_ge_four : ∀ j : ℕ, 4 ≤ R j := by
    intro j
    dsimp only [R]
    linarith [Nat.cast_nonneg (α := ℝ) j]
  have hδ_st_pos : ∀ j : ℕ, 0 < δ_st j := fun j => by
    dsimp only [δ_st]
    positivity
  have hδ_st_le : ∀ j : ℕ, δ_st j ≤ 1 / 48 := by
    intro j
    have he1 : (1 : ℝ) ≤ Real.exp 1 := Real.one_le_exp (by norm_num)
    have he2 : (1 : ℝ) ≤ Real.exp 2 := Real.one_le_exp (by norm_num)
    have hj0 : (0 : ℝ) ≤ (j : ℝ) := Nat.cast_nonneg j
    have h_f12 : (48 : ℝ) ≤ 16 * Real.exp 2 * (2 * Real.exp 1 + 1) := by nlinarith
    have h_den : (48 : ℝ) ≤ 16 * Real.exp 2 * (2 * Real.exp 1 + 1) * ((j : ℝ) + 1) := by
      nlinarith
    have h_inv := inv_anti₀ (by norm_num : (0 : ℝ) < 48) h_den
    dsimp only [δ_st]
    linarith
  have h_stage1 : ∀ j : ℕ, ∃ k : ℕ,
      3 * ((j : ℝ) + 3) < P_st k ∧
      ∀ u ∈ Set.Icc (-R j) (R j),
        |m (Real.exp (x_st k) * (1 - u / P_st k)) / m (Real.exp (x_st k)) - Real.exp u| <
          δ_st j := by
    intro j
    have ev1 : ∀ᶠ k in Filter.atTop, 3 * ((j : ℝ) + 3) < P_st k :=
      hP_top.eventually (Filter.eventually_gt_atTop (3 * ((j : ℝ) + 3)))
    have h_unif := tendstoLocallyUniformly_iff_forall_isCompact.mp h_loc_unif
      (Set.Icc (-R j) (R j)) isCompact_Icc
    have ev2_raw := Metric.tendstoUniformlyOn_iff.mp h_unif (δ_st j) (hδ_st_pos j)
    have ev2 : ∀ᶠ k in Filter.atTop, ∀ u ∈ Set.Icc (-R j) (R j),
        |m (Real.exp (x_st k) * (1 - u / P_st k)) / m (Real.exp (x_st k)) - Real.exp u| <
          δ_st j := by
      filter_upwards [ev2_raw] with k hk u hu
      have h_dist := hk u hu
      rw [Real.dist_eq, abs_sub_comm] at h_dist
      exact h_dist
    exact (ev1.and ev2).exists
  choose κ hκ using h_stage1
  let D_star : ℕ → ℝ := fun j => Real.exp (x_st (κ j))
  let P_star : ℕ → ℝ := fun j => P_st (κ j)
  let m_star : ℕ → ℝ := fun j => m (D_star j)
  have hD_star_ge_one : ∀ j : ℕ, 1 ≤ D_star j :=
    fun j => Real.one_le_exp (h_xp (κ j)).1
  have hD_star_pos : ∀ j : ℕ, 0 < D_star j :=
    fun j => lt_of_lt_of_le zero_lt_one (hD_star_ge_one j)
  have hm_star_pos : ∀ j : ℕ, 0 < m_star j :=
    fun j => hm_pos (D_star j) (hD_star_pos j)
  have hP_star_gt : ∀ j : ℕ, 3 * ((j : ℝ) + 3) < P_star j := fun j => (hκ j).1
  have hP_star_ge_one : ∀ j : ℕ, 1 ≤ P_star j := fun j => (h_xp (κ j)).2
  have hP_star_pos : ∀ j : ℕ, 0 < P_star j :=
    fun j => lt_of_lt_of_le zero_lt_one (hP_star_ge_one j)
  let L_cut : ℕ → ℝ := fun j =>
    max 0 ((7 / 2 : ℝ) * Real.log (P_star j) -
      4 * Real.log ((1 / 2 : ℝ) * m_star j * C_tail))
  let V_cut : ℕ → ℝ := fun j => Real.exp (L_cut j)
  let D_hi : ℕ → ℝ := fun j =>
    max ((5 / 3 : ℝ) * D_star j) (D_star j * (1 + V_cut j / P_star j))
  let I_set : ℕ → Set ℝ := fun j => Set.Icc ((1 / 3 : ℝ) * D_star j) (D_hi j)
  let η_loc : ℕ → ℝ := fun j =>
    m_star j * δ_st j / (2 * (Real.exp (R j) + 2))
  let η_tail : ℕ → ℝ := fun j =>
    (1 / 2 : ℝ) * m_star j * C_tail * (1 + V_cut j) ^ (-(5 / 8 : ℝ))
  let η_tol : ℕ → ℝ := fun j => min (η_loc j) (η_tail j)
  have hV_cut_ge_one : ∀ j : ℕ, 1 ≤ V_cut j :=
    fun j => Real.one_le_exp (le_max_left _ _)
  have hV_cut_pos : ∀ j : ℕ, 0 < V_cut j :=
    fun j => lt_of_lt_of_le zero_lt_one (hV_cut_ge_one j)
  have hη_loc_pos : ∀ j : ℕ, 0 < η_loc j := fun j => by
    have hm := hm_star_pos j
    have hδ := hδ_st_pos j
    dsimp only [η_loc]
    positivity
  have hη_tail_pos : ∀ j : ℕ, 0 < η_tail j := fun j => by
    have hm := hm_star_pos j
    have hV := hV_cut_pos j
    dsimp only [η_tail]
    positivity
  have hη_tol_pos : ∀ j : ℕ, 0 < η_tol j :=
    fun j => lt_min (hη_loc_pos j) (hη_tail_pos j)
  have hη_loc_lt_half : ∀ j : ℕ, η_loc j < (1 / 2 : ℝ) * m_star j := by
    intro j
    dsimp only [η_loc]
    rw [div_lt_iff₀ (by positivity)]
    have hm := hm_star_pos j
    have hδ := hδ_st_le j
    have hexp : 0 < Real.exp (R j) := Real.exp_pos (R j)
    nlinarith
  have hI_sub : ∀ j : ℕ, I_set j ⊆ Set.Ioi 0 := by
    intro j D hD
    have hD_pos := hD_star_pos j
    have h_lo : (1 / 3 : ℝ) * D_star j ≤ D := hD.1
    exact Set.mem_Ioi.mpr (by linarith)
  have hD_star_mem_I : ∀ j : ℕ, D_star j ∈ I_set j := by
    intro j
    have hD_pos := hD_star_pos j
    refine ⟨by linarith, ?_⟩
    exact le_trans (by linarith : D_star j ≤ (5 / 3 : ℝ) * D_star j)
      (le_max_left ((5 / 3 : ℝ) * D_star j) _)
  have hd_zero : Filter.Tendsto d_seq Filter.atTop (nhds 0) :=
    Real.tendsto_exp_atBot.comp (Filter.tendsto_neg_atTop_atBot.comp hk_top)
  have h_stage2 : ∀ j : ℕ, ∃ n : ℕ,
      d_seq n * D_star j < min δ_b (1 / ((j : ℝ) + 1)) ∧
      ε_seq n < 1 / 8 ∧
      2 * P_star j * ((j : ℝ) + 1) / (D_star j * m_star j) ≤ B_seq n ∧
      ∀ D ∈ I_set j, |m_approx n D - m D| < η_tol j := by
    intro j
    have hdD_zero : Filter.Tendsto (fun n => d_seq n * D_star j) Filter.atTop (nhds 0) := by
      simpa using hd_zero.mul_const (D_star j)
    have h_min_pos : 0 < min δ_b (1 / ((j : ℝ) + 1)) :=
      lt_min hδ_pos (by positivity)
    have ev1 := hdD_zero.eventually (gt_mem_nhds h_min_pos)
    have ev2 := hε_zero.eventually (gt_mem_nhds (by norm_num : (0 : ℝ) < 1 / 8))
    have ev3 := hB_top.eventually
      (Filter.eventually_ge_atTop (2 * P_star j * ((j : ℝ) + 1) / (D_star j * m_star j)))
    have h_unif := (tendstoLocallyUniformlyOn_iff_forall_isCompact isOpen_Ioi).mp
      hm_lim (I_set j) (hI_sub j) isCompact_Icc
    have ev4_raw := Metric.tendstoUniformlyOn_iff.mp h_unif (η_tol j) (hη_tol_pos j)
    have ev4 : ∀ᶠ n in Filter.atTop, ∀ D ∈ I_set j, |m_approx n D - m D| < η_tol j := by
      filter_upwards [ev4_raw] with n hn D hD
      have h_dist := hn D hD
      rw [Real.dist_eq, abs_sub_comm] at h_dist
      exact h_dist
    exact (ev1.and (ev2.and (ev3.and ev4))).exists
  choose ν hν using h_stage2
  let C_tail' : ℝ := 9 * C_tail ^ 2
  let h_seq : ℕ → ℝ := fun j => S.H - d_seq (ν j) * D_star j
  let ℓ_seq : ℕ → ℝ := fun j => d_seq (ν j) * D_star j / P_star j
  let m0_seq : ℕ → ℝ := fun j =>
    (B_seq (ν j) / d_seq (ν j)) * m_approx (ν j) (D_star j)
  have hm_approx_star_gt : ∀ j : ℕ,
      (1 / 2 : ℝ) * m_star j < m_approx (ν j) (D_star j) := by
    intro j
    have h_err : |m_approx (ν j) (D_star j) - m_star j| < η_tol j :=
      (hν j).2.2.2 (D_star j) (hD_star_mem_I j)
    have h_lt_half : |m_approx (ν j) (D_star j) - m_star j| < (1 / 2 : ℝ) * m_star j :=
      lt_of_lt_of_le (lt_of_lt_of_le h_err (min_le_left _ _)) (hη_loc_lt_half j).le
    have h_low := (abs_lt.mp h_lt_half).1
    linarith
  have hm_approx_star_pos : ∀ j : ℕ, 0 < m_approx (ν j) (D_star j) := fun j => by
    have hm := hm_star_pos j
    linarith [hm_approx_star_gt j]
  have hdD_lt_δ : ∀ j : ℕ, d_seq (ν j) * D_star j < δ_b :=
    fun j => lt_of_lt_of_le (hν j).1 (min_le_left _ _)
  have hdD_lt_inv : ∀ j : ℕ, d_seq (ν j) * D_star j < 1 / ((j : ℝ) + 1) :=
    fun j => lt_of_lt_of_le (hν j).1 (min_le_right _ _)
  have h_row_basic : ∀ j : ℕ,
      0 < h_seq j ∧
      h_seq j < S.H ∧
      S.H - h_seq j < δ_b ∧
      0 < ℓ_seq j ∧
      0 < m0_seq j ∧
      3 * ((j : ℝ) + 3) * ℓ_seq j < S.H - h_seq j ∧
      steepRowEnergy S (h_seq j) = (m0_seq j) ^ 2 := by
    intro j
    have hd_j := hd_pos (ν j)
    have hD_j := hD_star_pos j
    have hP_j := hP_star_pos j
    have hB_j := hB_pos (ν j)
    have hm_j := hm_approx_star_pos j
    have hdD_pos : 0 < d_seq (ν j) * D_star j := mul_pos hd_j hD_j
    have hdD_δ := hdD_lt_δ j
    have hh_sub : S.H - h_seq j = d_seq (ν j) * D_star j := by
      dsimp only [h_seq]; ring
    have hℓ_pos : 0 < ℓ_seq j := div_pos hdD_pos hP_j
    refine ⟨?_, ?_, ?_, hℓ_pos, ?_, ?_, ?_⟩
    · dsimp only [h_seq]
      linarith [S.H_pos]
    · dsimp only [h_seq]
      linarith
    · rw [hh_sub]
      exact hdD_δ
    · exact mul_pos (div_pos hB_j hd_j) hm_j
    · rw [hh_sub]
      calc
        3 * ((j : ℝ) + 3) * ℓ_seq j < P_star j * ℓ_seq j :=
          mul_lt_mul_of_pos_right (hP_star_gt j) hℓ_pos
        _ = d_seq (ν j) * D_star j := by
          dsimp only [ℓ_seq]
          exact mul_div_cancel₀ _ hP_j.ne'
    · exact h_energy_eq (ν j) hD_j
  have hg_zero : Filter.Tendsto (fun j => d_seq (ν j) * D_star j) Filter.atTop (nhds 0) :=
    squeeze_zero
      (fun j => mul_nonneg (hd_pos (ν j)).le (hD_star_pos j).le)
      (fun j => (hdD_lt_inv j).le)
      tendsto_one_div_add_atTop_nhds_zero_nat
  have hh_tendsto : Filter.Tendsto h_seq Filter.atTop (nhds S.H) := by
    simpa [h_seq] using (tendsto_const_nhds (x := S.H)).sub hg_zero
  have hℓ_tendsto : Filter.Tendsto ℓ_seq Filter.atTop (nhds 0) :=
    squeeze_zero
      (fun j => div_nonneg (mul_nonneg (hd_pos (ν j)).le (hD_star_pos j).le) (hP_star_pos j).le)
      (fun j => div_le_self (mul_nonneg (hd_pos (ν j)).le (hD_star_pos j).le) (hP_star_ge_one j))
      hg_zero
  have hj1_top : Filter.Tendsto (fun j : ℕ => (j : ℝ) + 1) Filter.atTop Filter.atTop :=
    Filter.Tendsto.atTop_add tendsto_natCast_atTop_atTop tendsto_const_nhds
  have hprod_tendsto : Filter.Tendsto (fun j => ℓ_seq j * m0_seq j) Filter.atTop Filter.atTop := by
    refine Filter.tendsto_atTop_mono ?_ hj1_top
    intro j
    have hd_ne : d_seq (ν j) ≠ 0 := (hd_pos (ν j)).ne'
    have hD_pos := hD_star_pos j
    have hm_pos_j := hm_star_pos j
    have hP_pos := hP_star_pos j
    have hB_pos_j := hB_pos (ν j)
    have h_prod_eq : ℓ_seq j * m0_seq j =
        (B_seq (ν j) * D_star j * m_approx (ν j) (D_star j)) / P_star j := by
      dsimp only [ℓ_seq, m0_seq]
      field_simp [hd_ne, hP_pos.ne']
    rw [h_prod_eq, le_div_iff₀ hP_pos]
    have hB_ge : 2 * P_star j * ((j : ℝ) + 1) ≤ B_seq (ν j) * (D_star j * m_star j) :=
      (div_le_iff₀ (mul_pos hD_pos hm_pos_j)).mp (hν j).2.2.1
    have hm_ge : (1 / 2 : ℝ) * m_star j ≤ m_approx (ν j) (D_star j) :=
      (hm_approx_star_gt j).le
    have hBD_nonneg : 0 ≤ B_seq (ν j) * D_star j := mul_nonneg hB_pos_j.le hD_pos.le
    have h_step : B_seq (ν j) * (D_star j * m_star j) ≤
        2 * (B_seq (ν j) * D_star j * m_approx (ν j) (D_star j)) := by
      calc
        B_seq (ν j) * (D_star j * m_star j) =
            2 * ((B_seq (ν j) * D_star j) * ((1 / 2 : ℝ) * m_star j)) := by ring
        _ ≤ 2 * ((B_seq (ν j) * D_star j) * m_approx (ν j) (D_star j)) :=
          mul_le_mul_of_nonneg_left
            (mul_le_mul_of_nonneg_left hm_ge hBD_nonneg) (by norm_num)
        _ = 2 * (B_seq (ν j) * D_star j * m_approx (ν j) (D_star j)) := by ring
    linarith
  have hratio_tendsto :
      Filter.Tendsto (fun j => (S.H - h_seq j) / ℓ_seq j) Filter.atTop Filter.atTop := by
    refine Filter.tendsto_atTop_mono ?_ hj1_top
    intro j
