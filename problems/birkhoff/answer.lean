      have hsinh_pos : 0 < Real.sinh d_a := lt_of_lt_of_le hda_pos (hsinh_ge d_a (le_of_lt hda_pos))
      have hker_nonneg : ∀ u : ℝ, 0 ≤ periodicPoissonKernel d_a u :=
