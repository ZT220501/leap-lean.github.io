            refine Finset.sum_eq_zero fun i hi => ?_
            rw [Finset.mem_filter] at hi
            have hik : i.1 + 1 = k := by have := i.2; omega
            have h_succ_last : i.succ = Fin.last k := Fin.ext hik
            have hΔ_l : Δ (Fin.last k) = 0 := hΔ_last
            rw [h_succ_last, hΔ_l, mul_zero]
