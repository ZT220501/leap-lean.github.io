      let τ_r : ℕ → ℝ := fun n => r_t / ((n : ℝ) + 2)
      let f_approx : ℕ → ℂ → ℂ := fun n y => ((τ_r n : ℂ) ^ (2 * j))⁻¹ * F (y, (τ_r n : ℂ))
      have hτ_r_pos : ∀ n : ℕ, 0 < τ_r n := fun n => by dsimp [τ_r]; positivity
      have hτ_r_lt : ∀ n : ℕ, τ_r n < R := by
        intro n; dsimp [τ_r, R]
        rw [div_lt_iff₀ (by positivity)]
        nlinarith [Nat.cast_nonneg (α := ℝ) n]
      have hτ_r_norm : ∀ n : ℕ, ‖(τ_r n : ℂ)‖ = τ_r n := by
        intro n
        rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos (hτ_r_pos n)]
      have hτ_r_lt_2r : ∀ n : ℕ, ‖(τ_r n : ℂ)‖ < 2 * r_t := by
        intro n; rw [hτ_r_norm n]; exact hτ_r_lt n
      have hτ_r_ball : ∀ n : ℕ, (τ_r n : ℂ) ∈ Metric.ball (0 : ℂ) R := by
        intro n; rw [Metric.mem_ball, dist_zero_right, hτ_r_norm n]; exact hτ_r_lt n
      have hf_approx_eq : ∀ (n : ℕ), ∀ y ∈ horizStrip s_mid,
          f_approx n y = glancingIterDslopeAtZero (2 * j) (fun z => F (y, z)) (τ_r n : ℂ) := by
        intro n y hy
        have hne : (τ_r n : ℂ) ≠ 0 := by exact_mod_cast (hτ_r_pos n).ne'
        have hpeq := hD2j_eq y hy (τ_r n : ℂ)
        dsimp [f_approx]
        rw [hpeq, inv_mul_cancel_left₀ (pow_ne_zero (2 * j) hne)]
      have hf_unif : TendstoUniformlyOn f_approx c_j Filter.atTop (horizStrip s_mid) := by
        rw [Metric.tendstoUniformlyOn_iff]
        intro ε hε
        have h_tend0 : Filter.Tendsto (fun n : ℕ => (2 * B2j / R) * τ_r n) Filter.atTop (nhds 0) := by
          have h1 : Filter.Tendsto τ_r Filter.atTop (nhds 0) :=
            tendsto_const_nhds.div_atTop
              (Filter.tendsto_atTop_add_const_right Filter.atTop 2 tendsto_natCast_atTop_atTop)
          simpa using h1.const_mul (2 * B2j / R)
        filter_upwards [(tendsto_order.mp h_tend0).2 ε hε] with n hn y hy
        rw [dist_comm, dist_eq_norm, hf_approx_eq n y hy]
        have hlip := hD2j_lip y hy (τ_r n : ℂ) (hτ_r_ball n)
        rw [hτ_r_norm n] at hlip
        exact lt_of_le_of_lt hlip hn
      have hf_approx_holo : ∀ n : ℕ, DifferentiableOn ℂ (f_approx n) (horizStrip s_mid) := by
        intro n
        refine (hF_holo.comp (differentiable_id.prodMk
          (differentiable_const (τ_r n : ℂ))).differentiableOn ?_).const_mul _
        intro y hy
        exact (hF_bd y hy (τ_r n : ℂ) (hτ_r_lt_2r n)).1
      have hc_holo : DifferentiableOn ℂ c_j (horizStrip s_mid) :=
        hf_unif.tendstoLocallyUniformlyOn.differentiableOn
          (Filter.Eventually.of_forall hf_approx_holo) (hOpenStrip s_mid)
      have hc_per : ∀ y ∈ horizStrip s_mid, c_j (y + 2 * Real.pi) = c_j y := by
        intro y hy
        have hy_sh : y + 2 * Real.pi ∈ horizStrip s_mid := by
          change |y.im| < s_mid at hy
          change |(y + 2 * Real.pi).im| < s_mid; simpa using hy
        have ht1 := hf_unif.tendsto_at hy_sh
        have ht2 := hf_unif.tendsto_at hy
        have heq_n : ∀ n : ℕ, f_approx n (y + 2 * Real.pi) = f_approx n y := by
          intro n; dsimp [f_approx]
          have hm : (y, (τ_r n : ℂ)) ∈ glancingDomain 1 s d :=
            (hF_bd y hy (τ_r n : ℂ) (hτ_r_lt_2r n)).1
          rw [(hF_sym y (τ_r n : ℂ) hm).1]
        exact tendsto_nhds_unique ht1 (by simpa [heq_n] using ht2)
      have hc_conj : ∀ y ∈ horizStrip s_mid, c_j (starRingEnd ℂ y) = starRingEnd ℂ (c_j y) := by
        intro y hy
        have hy_cj : starRingEnd ℂ y ∈ horizStrip s_mid := by
          change |y.im| < s_mid at hy
          change |(starRingEnd ℂ y).im| < s_mid; simpa using hy
        have ht1 := hf_unif.tendsto_at hy_cj
        have ht2 := (Complex.continuous_conj.tendsto (c_j y)).comp (hf_unif.tendsto_at hy)
        have heq_n : ∀ n : ℕ, f_approx n (starRingEnd ℂ y) = starRingEnd ℂ (f_approx n y) := by
          intro n; dsimp [f_approx]
          have hm : (y, (τ_r n : ℂ)) ∈ glancingDomain 1 s d :=
            (hF_bd y hy (τ_r n : ℂ) (hτ_r_lt_2r n)).1
          have hsym := (hF_sym y (τ_r n : ℂ) hm).2.2
          simp only [Complex.conj_ofReal] at hsym
          rw [hsym, map_mul, map_inv₀, map_pow, Complex.conj_ofReal]
        exact tendsto_nhds_unique ht1 (by simpa [Function.comp_def, heq_n] using ht2)
      have hc_int : (∫ x in (0 : ℝ)..(2 * Real.pi), c_j x) = 0 := by
        have hc_cont_r : Continuous (fun x : ℝ => c_j x) := by
          refine ContinuousOn.comp_continuous hc_holo.continuousOn Complex.continuous_ofReal ?_
          intro x; simp [horizStrip, hs_mid_pos]
        have hf_cont_r : ∀ n : ℕ, Continuous (fun x : ℝ => f_approx n x) := by
          intro n
          have hcont_on : ContinuousOn (f_approx n) (horizStrip s_mid) := (hf_approx_holo n).continuousOn
          exact hcont_on.comp_continuous Complex.continuous_ofReal
            (fun x => by simp [horizStrip, hs_mid_pos])
        have hint_n : ∀ n : ℕ, (∫ x in (0 : ℝ)..(2 * Real.pi), f_approx n x) = 0 := by
          intro n; dsimp [f_approx]
          have ht_lt_d : ‖(τ_r n : ℂ)‖ < d := (hτ_r_lt_2r n).trans h2r_lt_d
          rw [intervalIntegral.integral_const_mul, hF_int (τ_r n : ℂ) ht_lt_d, mul_zero]
        have hnorm_tend0 : Filter.Tendsto
            (fun n : ℕ => ((2 * B2j / R) * τ_r n) * |(2 * Real.pi : ℝ) - 0|)
            Filter.atTop (nhds 0) := by
          have h1 : Filter.Tendsto τ_r Filter.atTop (nhds 0) :=
            tendsto_const_nhds.div_atTop
              (Filter.tendsto_atTop_add_const_right Filter.atTop 2 tendsto_natCast_atTop_atTop)
          simpa using (h1.const_mul (2 * B2j / R)).mul_const |(2 * Real.pi : ℝ) - 0|
        have hnorm_le_zero : ‖∫ x in (0 : ℝ)..(2 * Real.pi), c_j x‖ ≤ 0 := by
          refine ge_of_tendsto hnorm_tend0 (Filter.Eventually.of_forall fun n => ?_)
          have hsub_int : (∫ x in (0 : ℝ)..(2 * Real.pi), c_j x) =
              ∫ x in (0 : ℝ)..(2 * Real.pi), (c_j x - f_approx n x) := by
            rw [intervalIntegral.integral_sub
              (hc_cont_r.intervalIntegrable 0 (2 * Real.pi))
              ((hf_cont_r n).intervalIntegrable 0 (2 * Real.pi)), hint_n n, sub_zero]
          rw [hsub_int]
          refine intervalIntegral.norm_integral_le_of_norm_le_const fun x _ => ?_
          have hx_mem : (x : ℂ) ∈ horizStrip s_mid := by simp [horizStrip, hs_mid_pos]
          rw [norm_sub_rev, hf_approx_eq n x hx_mem]
          have hlip := hD2j_lip x hx_mem (τ_r n : ℂ) (hτ_r_ball n)
          rwa [hτ_r_norm n] at hlip
        exact norm_le_zero_iff.mp hnorm_le_zero
      exact ⟨r_t, C_rem, c_j, hr_t_pos, hr_t_le_d4, hC_rem_pos,
        hc_holo, hc_per, hc_conj, hc_int, hRem_bd⟩
    let s_stage : ℕ → ℝ := fun j => (3 / 4 - (j : ℝ) / (4 * ((m : ℝ) + 1))) * G.s_act
    let η_stage : ℕ → ℝ := fun j => ((j : ℝ) / (4 * ((m : ℝ) + 1))) * G.η_adm
    have hs_stage_bounds : ∀ j ≤ m, G.s_act / 2 < s_stage j ∧ s_stage j < G.s_act := by
      intro j hj
      have hm_pos : (0 : ℝ) < 4 * ((m : ℝ) + 1) := by positivity
      have hj_le : (j : ℝ) ≤ (m : ℝ) := Nat.cast_le.mpr hj
      have hfrac_lt : (j : ℝ) / (4 * ((m : ℝ) + 1)) < 1 / 4 := by
        rw [div_lt_div_iff₀ hm_pos (by norm_num)]
        linarith
      have hfrac_nonneg : 0 ≤ (j : ℝ) / (4 * ((m : ℝ) + 1)) := by positivity
      dsimp [s_stage]
      exact ⟨by nlinarith, by nlinarith⟩
    have hs_stage_step : ∀ j < m, s_stage (j + 1) < s_stage j := by
      intro j _
      dsimp [s_stage]
      have hm_pos : (0 : ℝ) < 4 * ((m : ℝ) + 1) := by positivity
      have hdiff : ((j : ℝ) / (4 * ((m : ℝ) + 1))) < (((j + 1 : ℕ) : ℝ) / (4 * ((m : ℝ) + 1))) := by
        rw [div_lt_div_iff₀ hm_pos hm_pos]
        push_cast; linarith
      nlinarith
    have hη_stage_bounds : ∀ j ≤ m, 0 ≤ η_stage j ∧ η_stage j ≤ G.η_adm / 4 := by
      intro j hj
      have hm_pos : (0 : ℝ) < 4 * ((m : ℝ) + 1) := by positivity
      have hj_le : (j : ℝ) ≤ (m : ℝ) := Nat.cast_le.mpr hj
      have hfrac_le : (j : ℝ) / (4 * ((m : ℝ) + 1)) ≤ 1 / 4 := by
        rw [div_le_div_iff₀ hm_pos (by norm_num)]
        linarith
      dsimp [η_stage]
      exact ⟨by positivity, by nlinarith⟩
    have hη_stage_step : ∀ j < m, η_stage j < η_stage (j + 1) := by
      intro j _
      dsimp [η_stage]
      have hm_pos : (0 : ℝ) < 4 * ((m : ℝ) + 1) := by positivity
      have hdiff : ((j : ℝ) / (4 * ((m : ℝ) + 1))) < (((j + 1 : ℕ) : ℝ) / (4 * ((m : ℝ) + 1))) := by
        rw [div_lt_div_iff₀ hm_pos hm_pos]
        push_cast; linarith
      nlinarith
    have hRec : ∀ j : ℕ, j ≤ m →
        ∃ (d_j M_j : ℝ) (U_j : ℂ × ℂ → ℂ),
          0 < d_j ∧ d_j ≤ G.d_act ∧ d_j < s_stage j / 2 ∧
          0 < M_j ∧
          IsAdmissibleGlancingCand (s_stage j) d_j (η_stage j) U_j ∧
          (∀ y : ℂ, |y.im| < s_stage j → U_j (y, 0) = y) ∧
          (∀ p ∈ glancingDomain 1 (s_stage j) d_j,
            ‖G.E_op U_j p‖ ≤ M_j * ‖p.2‖ ^ (2 * j + 2)) := by
      intro j; induction j with
      | zero =>
          intro _
          let U0 : ℂ × ℂ → ℂ := fun p => p.1
          have hAdm0_full : IsAdmissibleGlancingCand G.s_act G.d_act G.η_adm U0 := by
            refine ⟨differentiable_fst.differentiableOn,
              fun _ _ _ => rfl, fun _ _ _ => rfl, fun _ _ _ => rfl, fun k _ y t _ => ?_⟩
            have hfn : (fun y' : ℂ => U0 (y', t) - y') = fun _ => (0 : ℂ) := by ext y'; simp [U0]
            rw [hfn, iteratedDeriv_const]
            split_ifs <;> simp [hη_pos.le]
          have hE0_props := G.E_op_props G.s_act G.d_act U0 hs_act_pos le_rfl
            hd_act_pos le_rfl G.d_act_lt hAdm0_full
          have hs0_pos : 0 < s_stage 0 :=
            (div_pos hs_act_pos (by norm_num)).trans (hs_stage_bounds 0 (by omega)).1
          have hs0_lt : s_stage 0 < G.s_act := (hs_stage_bounds 0 (by omega)).2
          obtain ⟨r_t, M_sup, hr_t_pos, hr_t_le_d4, h2r_lt_d, hM_sup_pos, hF_bd⟩ :=
            hStripDisk_bound G.s_act (s_stage 0) G.d_act (G.E_op U0)
              hs0_pos hs0_lt hd_act_pos hE0_props.1 (fun y t hyt => (hE0_props.2.1 y t hyt).1)
          let d0 : ℝ := min r_t (s_stage 0 / 3)
          have hd0_pos : 0 < d0 := lt_min hr_t_pos (by positivity)
          have hd0_le_act : d0 ≤ G.d_act := (min_le_left _ _).trans (by linarith)
          have hd0_lt_half : d0 < s_stage 0 / 2 :=
            lt_of_le_of_lt (min_le_right _ _) (by linarith)
          let M0 : ℝ := 1 + M_sup / (2 * r_t) ^ 2
          have hM0_pos : 0 < M0 := by positivity
          have hη0_eq : η_stage 0 = 0 := by simp [η_stage]
          have hAdm0 : IsAdmissibleGlancingCand (s_stage 0) d0 (η_stage 0) U0 := by
            refine ⟨differentiable_fst.differentiableOn,
              fun _ _ _ => rfl, fun _ _ _ => rfl, fun _ _ _ => rfl, fun k _ y t _ => ?_⟩
            rw [hη0_eq]
            have hfn : (fun y' : ℂ => U0 (y', t) - y') = fun _ => (0 : ℂ) := by ext y'; simp [U0]
            rw [hfn, iteratedDeriv_const]
            split_ifs <;> simp
          refine ⟨d0, M0, U0, hd0_pos, hd0_le_act, hd0_lt_half, hM0_pos, hAdm0,
            fun _ _ => rfl, fun p hp => ?_⟩
          have hy_lt : |p.1.im| < s_stage 0 := by
            have := hp.2; linarith [abs_nonneg p.2.im]
          have ht_lt_2r : ‖p.2‖ < 2 * r_t := by
            have : d0 ≤ r_t := min_le_left _ _
            linarith [hp.1]
          let gy : ℂ → ℂ := fun τ => G.E_op U0 (p.1, τ)
          have hgy_holo : DifferentiableOn ℂ gy (Metric.ball 0 (2 * r_t)) := by
            refine hE0_props.1.comp ((differentiable_const p.1).prodMk differentiable_id).differentiableOn ?_
            intro τ hτ
            exact (hF_bd p.1 hy_lt τ (by simpa using hτ)).1
          have hgy0 : gy 0 = 0 := by
            dsimp [gy]
            rw [hE0_props.2.2.2 p.1 (hy_lt.trans hs0_lt)]
            have hd_id : deriv (fun y' : ℂ => U0 (y', 0)) = fun _ => (1 : ℂ) := by
              ext z; simp [U0]
            rw [hd_id, deriv_const]
            simp
          have hgy_even : ∀ z ∈ Metric.ball (0 : ℂ) (2 * r_t), gy (-z) = gy z := by
            intro z hz
            exact (hE0_props.2.1 p.1 z (hF_bd p.1 hy_lt z (by simpa using hz)).1).2.1
          have hgy_bd : ∀ z ∈ Metric.ball (0 : ℂ) (2 * r_t), ‖gy z‖ ≤ M_sup :=
            fun z hz => (hF_bd p.1 hy_lt z (by simpa using hz)).2
          have hquad := hEven_quad_bound (2 * r_t) M_sup gy (by positivity) hM_sup_pos.le
            hgy_holo hgy0 hgy_even hgy_bd p.2 (by simpa using ht_lt_2r)
          have hpow_2 : 2 * 0 + 2 = 2 := rfl
          rw [hpow_2]
          calc ‖G.E_op U0 p‖ = ‖gy p.2‖ := rfl
            _ ≤ (M_sup / (2 * r_t) ^ 2) * ‖p.2‖ ^ 2 := hquad
            _ ≤ M0 * ‖p.2‖ ^ 2 :=
                mul_le_mul_of_nonneg_right (by dsimp [M0]; linarith) (sq_nonneg _)
      | succ j ih =>
          intro hj1_le
          have hj_lt : j < m := hj1_le
          obtain ⟨d_prev, M_prev, U_prev, hd_prev_pos, hd_prev_le, hd_prev_lt, hM_prev_pos,
            hAdm_prev, hZero_prev, hRes_prev⟩ := ih hj_lt.le
          have hs_prev_lt : s_stage (j + 1) < s_stage j := hs_stage_step j hj_lt
          have hs_next_pos : 0 < s_stage (j + 1) :=
            (div_pos hs_act_pos (by norm_num)).trans (hs_stage_bounds (j + 1) hj1_le).1
          have hs_prev_pos : 0 < s_stage j := hs_next_pos.trans hs_prev_lt
          have hs_prev_le : s_stage j ≤ G.s_act := (hs_stage_bounds j hj_lt.le).2.le
          let s_mid : ℝ := (s_stage j + 2 * s_stage (j + 1)) / 3
          let s_sub : ℝ := (s_mid + s_stage (j + 1)) / 2
          have hs_mid_lt : s_mid < s_stage j := by dsimp [s_mid]; linarith
          have hs_sub_lt : s_sub < s_mid := by dsimp [s_sub, s_mid]; linarith
          have hs_next_lt_sub : s_stage (j + 1) < s_sub := by dsimp [s_sub, s_mid]; linarith
          have hs_sub_pos : 0 < s_sub := hs_next_pos.trans hs_next_lt_sub
          have hs_mid_pos : 0 < s_mid := hs_sub_pos.trans hs_sub_lt
          have hη_prev_le : η_stage j ≤ G.η_adm :=
            (hη_stage_bounds j hj_lt.le).2.trans (by linarith)
          have hAdm_prev_full : IsAdmissibleGlancingCand (s_stage j) d_prev G.η_adm U_prev :=
            ⟨hAdm_prev.1, hAdm_prev.2.1, hAdm_prev.2.2.1, hAdm_prev.2.2.2.1,
              fun k hk y t hyt => (hAdm_prev.2.2.2.2 k hk y t hyt).trans hη_prev_le⟩
          have hE_prev := G.E_op_props (s_stage j) d_prev U_prev
            hs_prev_pos hs_prev_le hd_prev_pos hd_prev_le hd_prev_lt hAdm_prev_full
          have h2j1 : 2 * j + 2 = 2 * (j + 1) := by omega
          rw [h2j1] at hRes_prev
          obtain ⟨r_t, C_rem, c_j, hr_t_pos, hr_t_le_d4, hC_rem_pos,
            hc_holo, hc_per, hc_conj, hc_int, hRem_bd⟩ :=
            hExtract_cj (s_stage j) s_mid d_prev M_prev (j + 1) (G.E_op U_prev)
              hs_mid_pos hs_mid_lt hd_prev_pos hM_prev_pos (by omega)
              hE_prev.1 hE_prev.2.1 hE_prev.2.2.1 hRes_prev
          obtain ⟨u_j, M_u, hM_u_pos, hu_holo, hu_per, hu_conj, hu_bound, hu_ode⟩ :=
            hSolve_ODE s_mid s_sub c_j hs_sub_pos hs_sub_lt hc_holo hc_per hc_conj hc_int
          let d_in : ℝ := min r_t (s_sub / 3)
          have hd_in_pos : 0 < d_in := lt_min hr_t_pos (by positivity)
          have hd_in_lt_prev : d_in < d_prev :=
            lt_of_le_of_lt (min_le_left _ _) (by linarith)
          have hd_in_le_act : d_in ≤ G.d_act := hd_in_lt_prev.le.trans hd_prev_le
          have hd_in_lt_half : d_in < s_sub / 2 :=
            lt_of_le_of_lt (min_le_right _ _) (by linarith)
          have hsub_d0 : glancingDomain 0 s_sub d_in ⊆ glancingDomain 0 (s_stage j) d_prev := by
            intro p hp
            exact ⟨hp.1.trans hd_in_lt_prev, by
              have hp2 := hp.2; simp at hp2 ⊢; linarith⟩
          have hAdm_in : IsAdmissibleGlancingCand s_sub d_in (η_stage j) U_prev :=
            ⟨hAdm_prev.1.mono hsub_d0,
              fun y t hyt => hAdm_prev.2.1 y t (hsub_d0 hyt),
              fun y t hyt => hAdm_prev.2.2.1 y t (hsub_d0 hyt),
              fun y t hyt => hAdm_prev.2.2.2.1 y t (hsub_d0 hyt),
              fun k hk y t hyt => hAdm_prev.2.2.2.2 k hk y t (hsub_d0 hyt)⟩
          obtain ⟨d₁, M_next, hd₁_pos, hd₁_le_in, hd₁_lt_half, hM_next_pos, hAdm_next, hPert⟩ :=
            G.formal_perturbation s_sub (s_stage (j + 1)) d_in
              (η_stage j) (η_stage (j + 1)) M_prev M_u (j + 1) U_prev u_j
              hs_next_pos hs_next_lt_sub (hs_sub_lt.le.trans (hs_mid_lt.le.trans hs_prev_le))
              hd_in_pos hd_in_le_act hd_in_lt_half
              (hη_stage_bounds j hj_lt.le).1 (hη_stage_step j hj_lt)
              ((hη_stage_bounds (j + 1) hj1_le).2.trans (by linarith))
              hM_prev_pos hM_u_pos (by omega)
              hAdm_in
              (fun y hy => hZero_prev y (by linarith))
              (fun p hp => hRes_prev p ⟨hp.1.trans hd_in_lt_prev, by linarith [hp.2]⟩)
              hu_holo hu_per hu_conj hu_bound
          refine ⟨d₁, M_next + C_rem, fun p => U_prev p + u_j p.1 * p.2 ^ (2 * (j + 1)),
            hd₁_pos, hd₁_le_in.trans hd_in_le_act, hd₁_lt_half,
            by positivity, hAdm_next,
            fun y hy => by
              dsimp only
              rw [hZero_prev y (by linarith), zero_pow (by omega), mul_zero, add_zero],
            fun p hp => ?_⟩
          have hy_sub : p.1 ∈ horizStrip s_sub := by
            change |p.1.im| < s_sub
            have := hp.2; linarith [abs_nonneg p.2.im]
          have hy_mid : |p.1.im| < s_mid := hy_sub.trans hs_sub_lt
          have ht_2r : ‖p.2‖ < 2 * r_t := by
            have h1 : d₁ ≤ r_t := hd₁_le_in.trans (min_le_left _ _)
            linarith [hp.1]
          have hpert_p := hPert p hp
          have hode_p : (1 / 4 : ℂ) * deriv (deriv u_j) p.1 * p.2 ^ (2 * (j + 1)) =
              -c_j p.1 * p.2 ^ (2 * (j + 1)) := by
            rw [hu_ode p.1 hy_sub]
          rw [hode_p] at hpert_p
          have hrem_p := hRem_bd p.1 hy_mid p.2 ht_2r
          let U_next : ℂ × ℂ → ℂ := fun q => U_prev q + u_j q.1 * q.2 ^ (2 * (j + 1))
          have htri : ‖G.E_op U_next p‖ ≤
              ‖G.E_op U_next p - (G.E_op U_prev p + -c_j p.1 * p.2 ^ (2 * (j + 1)))‖ +
              ‖G.E_op U_prev p - c_j p.1 * p.2 ^ (2 * (j + 1))‖ := by
            have : G.E_op U_next p =
                (G.E_op U_next p - (G.E_op U_prev p + -c_j p.1 * p.2 ^ (2 * (j + 1)))) +
                (G.E_op U_prev p - c_j p.1 * p.2 ^ (2 * (j + 1))) := by ring
            conv_lhs => rw [this]
            exact norm_add_le _ _
          calc ‖G.E_op U_next p‖
              ≤ M_next * ‖p.2‖ ^ (2 * (j + 1) + 2) + C_rem * ‖p.2‖ ^ (2 * (j + 1) + 2) :=
                htri.trans (add_le_add hpert_p hrem_p)
            _ = (M_next + C_rem) * ‖p.2‖ ^ (2 * (j + 1) + 2) := by ring
    obtain ⟨d_m, M_m, U_m, hd_pos, hd_le, hd_lt, hM_pos, hAdm_m, hZero_m, hRes_m⟩ := hRec m le_rfl
    have hs_m_pos : 0 < s_stage m :=
      (div_pos hs_act_pos (by norm_num)).trans (hs_stage_bounds m le_rfl).1
    have hs_m_le : s_stage m ≤ G.s_act := (hs_stage_bounds m le_rfl).2.le
    have hη_m_le : η_stage m ≤ G.η_adm / 4 := (hη_stage_bounds m le_rfl).2
