      · exact Or.inl ⟨0, h01, by simp [γ₂]⟩
      · refine Or.inr ⟨1, h11, ?_⟩
        ext <;> simp [γ₁, Complex.re_add_im]
    have hTsh_preconn : IsPreconnected (meroTubeShift (meroTubeENNR M.r_base M.h_X)) := by
      apply h_preconn_of_join
      rintro ⟨y, t⟩ ⟨hq0, hqm, hqp⟩
      let γ₁ : ℝ → ℂ × ℂ := fun η => ((y.re : ℂ) + ((η * y.im : ℝ) : ℂ) * Complex.I, t)
