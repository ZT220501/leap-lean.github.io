          exact le_trans (le_max_left _ _) (le_max_right _ _)
        have hvp_norm : ‖v_p‖ ≤ 1 := by
          dsimp [v_p]
          rw [norm_div, hδw_c_norm, div_le_one hδw_pos]
          exact le_trans (le_max_right _ _) (le_max_right _ _)
        have h_dir_diff : ∀ p_m p_0 p_p : ℂ,
            ‖p_m‖ ≤ r → ‖p_0‖ ≤ r → ‖p_p‖ ≤ r →
            DifferentiableAt ℂ
              (fun ζ : ℂ => sqmcStencil B u t₀ z (p_m + ζ * v_m) (p_0 + ζ * v_0) (p_p + ζ * v_p))
