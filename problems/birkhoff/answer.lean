          dsimp [B_p]; linarith
      obtain ⟨hX_holo, hX_maps, hX_per, hX_conj, hX_deriv⟩ :=
        hCurve 0 ⟨le_rfl, zero_le_one⟩
      have hX_simp : (fun z => (z + (ρ : ℂ) + e_X z) + ((0 : ℝ) : ℂ) * Y z) =
          (fun z => z + (ρ : ℂ) + e_X z) := by ext z; simp
      rw [hX_simp] at hX_holo hX_maps hX_per hX_conj hX_deriv
      have hWX_bdd : IsStripBounded p₀ σ' M_W (fun z => W (z + (ρ : ℂ) + e_X z)) :=
