      dsimp [stripExitKernel]
      rw [hK_denom y₀ u]
      have hu_eq : Real.pi * u / (2 * H_p) = c_sc * u := by dsimp [c_sc]; ring
      have hy_eq : Real.pi * y₀ / (2 * H_p) = c_sc * y₀ := by dsimp [c_sc]; ring
