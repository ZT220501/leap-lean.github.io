            IsPeriodicSmoothBounded (m + 15) M w₂ →
            ∀ (σ_sgn : ℝ) (B₁ H₁ B₂ H₂ : ℝ → ℝ),
              IsCellBaseStepPair_fcks (m + 2) R₀ q σ_sgn B₁ H₁ →
              IsCellBaseStepPair_fcks (m + 2) R₀ q σ_sgn B₂ H₂ →
              IsCellBaseStepDiff_fcks (m + 2) R₀ q (realDiffSup (m + 15) w₁ w₂) B₁ H₁ B₂ H₂ →
              ∀ β ∈ Set.Icc (0 : ℝ) 1,
                HasCJetBound_fcks (m + 2) ((C_res / (q : ℝ) ^ 3) * realDiffSup (m + 15) w₁ w₂)
                  (fun x : ℝ =>
                    rescaledCellKernel_fcks w₁ B₁ H₁ β x - rescaledCellKernel_fcks w₂ B₂ H₂ β x)) := by
    let p : ℕ := m + 2
    let N_res : ℕ := max 4 (Nat.ceil (4 * R₀) + 4)
    have hN_ge4 : 4 ≤ N_res := le_max_left _ _
    have hCJetToDeriv : ∀ {B_0 : ℝ} {f : ℝ → ℝ},
        HasCJetBound_fcks p B_0 f → HasDerivJetBound_fcks p B_0 f := by
      intro B_0 f hf
      exact ⟨hf.1, hf.2.1, fun k _ hk x => hf.2.2 k hk x⟩
    have hCompFactorPos : ∀ (n : ℕ) (B_0 : ℝ), 0 ≤ B_0 → 0 < compJetFactor_fcks n B_0 := by
      intro n B_0 hB0
      induction n with
      | zero => simp [compJetFactor_fcks]
      | succ n ih =>
        simp only [compJetFactor_fcks]
        have : 0 ≤ (2 : ℝ) ^ n * B_0 * compJetFactor_fcks n B_0 := by positivity
        linarith
    have hScale : ∀ q : ℕ, N_res ≤ q →
        (4 : ℝ) ≤ (q : ℝ) ∧ 0 < (q : ℝ) ∧ 1 / (q : ℝ) ≤ 1 ∧
