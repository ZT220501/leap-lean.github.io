      ∃ M : MeroOn2D W', ∀ (U : Set (ℂ × ℂ)) (f g : ℂ × ℂ → ℂ),
        MeroAgreesHolo F f U → MeroAgreesHolo G g U →
        MeroAgreesHolo M (fun p => f p + g p) U := by
    intro W' F G
    refine ⟨{
