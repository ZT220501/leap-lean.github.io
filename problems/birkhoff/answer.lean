        intro j hj_mem
        have hj_k0 : k₀ ≤ j := (le_max_left _ _).trans hj_mem.1
        let pt_j : ℝ → ℂ := fun x => (x : ℂ) + ((S.H - Real.exp (-j) : ℝ) : ℂ) * Complex.I
