      rw [hZW_prod]
      exact div_ne_zero (pow_ne_zero 2 hc_ne) (pow_ne_zero 4 hf_ne)
    have hZaW : deriv G.Z_loc z + (G.a_loc z) ^ 2 * deriv G.W_loc z = 0 := by
      rw [hZ', hW']
      field_simp [ha_ne, hf_ne]
      ring
    have hZ'_ev : deriv G.Z_loc =ᶠ[nhds z]
        fun w => Complex.I * (G.c : ℂ) * G.a_loc w / (G.f_loc w) ^ 2 := by
      filter_upwards [hU₀_open.mem_nhds hz] with w hw
      exact (G.reg_on_punctured w hw.1 hw.2).2.2.2.2.2.2.1
    have hW'_ev : deriv G.W_loc =ᶠ[nhds z]
        fun w => -Complex.I * (G.c : ℂ) / (G.a_loc w * (G.f_loc w) ^ 2) := by
      filter_upwards [hU₀_open.mem_nhds hz] with w hw
      exact (G.reg_on_punctured w hw.1 hw.2).2.2.2.2.2.2.2.1
    have ha_hd : HasDerivAt G.a_loc (Complex.I * G.f_loc z * G.a_loc z) z :=
      ha' ▸ ha_ana.differentiableAt.hasDerivAt
    have hf_hd : HasDerivAt G.f_loc (deriv G.f_loc z) z :=
      hf_ana.differentiableAt.hasDerivAt
    have hf2_hd : HasDerivAt (fun w => (G.f_loc w) ^ 2)
        (2 * G.f_loc z * deriv G.f_loc z) z := by
      have h_mul : HasDerivAt (fun w => G.f_loc w * G.f_loc w)
          (deriv G.f_loc z * G.f_loc z + G.f_loc z * deriv G.f_loc z) z := hf_hd.mul hf_hd
      simpa only [sq, show deriv G.f_loc z * G.f_loc z + G.f_loc z * deriv G.f_loc z =
        2 * G.f_loc z * deriv G.f_loc z by ring] using h_mul
    have hZ''_hd : HasDerivAt (fun w => Complex.I * (G.c : ℂ) * G.a_loc w / (G.f_loc w) ^ 2)
        ((Complex.I * (G.c : ℂ) * (Complex.I * G.f_loc z * G.a_loc z) * (G.f_loc z) ^ 2 -
          Complex.I * (G.c : ℂ) * G.a_loc z * (2 * G.f_loc z * deriv G.f_loc z)) /
          ((G.f_loc z) ^ 2) ^ 2) z :=
      (ha_hd.const_mul (Complex.I * (G.c : ℂ))).div hf2_hd (pow_ne_zero 2 hf_ne)
    have hW''_hd : HasDerivAt
        (fun w => -Complex.I * (G.c : ℂ) / (G.a_loc w * (G.f_loc w) ^ 2))
        ((0 * (G.a_loc z * (G.f_loc z) ^ 2) -
          (-Complex.I * (G.c : ℂ)) *
            ((Complex.I * G.f_loc z * G.a_loc z) * (G.f_loc z) ^ 2 +
              G.a_loc z * (2 * G.f_loc z * deriv G.f_loc z))) /
          (G.a_loc z * (G.f_loc z) ^ 2) ^ 2) z :=
      (hasDerivAt_const z (-Complex.I * (G.c : ℂ))).div (ha_hd.mul hf2_hd)
        (mul_ne_zero ha_ne (pow_ne_zero 2 hf_ne))
    have hZ'' : deriv (deriv G.Z_loc) z =
        ((- (G.c : ℂ) * (G.f_loc z) ^ 2 * G.a_loc z -
          2 * Complex.I * (G.c : ℂ) * G.a_loc z * deriv G.f_loc z) /
          (G.f_loc z) ^ 3) := by
      rw [hZ'_ev.deriv_eq, hZ''_hd.deriv]
      field_simp [hf_ne]
      ring_nf
      rw [Complex.I_sq]
      ring
    have hW'' : deriv (deriv G.W_loc) z =
        ((-(G.c : ℂ) * (G.f_loc z) ^ 2 + 2 * Complex.I * (G.c : ℂ) * deriv G.f_loc z) /
          (G.a_loc z * (G.f_loc z) ^ 3)) := by
      rw [hW'_ev.deriv_eq, hW''_hd.deriv]
      field_simp [ha_ne, hf_ne]
      ring_nf
      rw [Complex.I_sq]
      ring
    have hWronsk : deriv (deriv G.Z_loc) z * deriv G.W_loc z -
        deriv G.Z_loc z * deriv (deriv G.W_loc) z =
        2 * Complex.I * (G.c : ℂ) ^ 2 / (G.f_loc z) ^ 3 := by
      rw [hZ'', hW'', hZ', hW']
      field_simp [ha_ne, hf_ne]
      ring_nf
    refine ⟨hZW_ne, hZaW, ?_⟩
    rw [hWronsk, hZW_prod]
    have h_lhs : (2 * Complex.I * (G.c : ℂ) ^ 2 / (G.f_loc z) ^ 3) ^ 4 =
        16 * Complex.I ^ 4 * (G.c : ℂ) ^ 8 / (G.f_loc z) ^ 12 := by ring
    rw [h_lhs, hI4]
    field_simp [hf_ne]
  let U₁ : Set ℂ := {z : ℂ | 0 < ‖z‖ ∧ ‖z‖ < ε₁}
  have hU₁_open : IsOpen U₁ :=
    (isOpen_lt continuous_const continuous_norm).inter (isOpen_lt continuous_norm continuous_const)
  have hZ'_comp : ∀ w ∈ U₁, deriv G.Z_loc w = deriv G.Z_loc (τ w) * deriv τ w := by
    intro w hw
    have hw_ball : w ∈ Metric.ball (0 : ℂ) ε₁ := by simpa using hw.2
    have hτw : τ w ∈ U₀ := ⟨(hτ_symm w hw.1 hw.2).1, (hτ_symm w hw.1 hw.2).2.1⟩
    have hZ_ev : G.Z_loc =ᶠ[nhds w] fun u => G.Z_loc (τ u) := by
      filter_upwards [hU₁_open.mem_nhds hw] with u hu
      exact ((hτ_symm u hu.1 hu.2).2.2.1).symm
    have h_hd : HasDerivAt (fun u => G.Z_loc (τ u)) (deriv G.Z_loc (τ w) * deriv τ w) w :=
      (G.reg_on_punctured (τ w) hτw.1 hτw.2).1.differentiableAt.hasDerivAt.comp w
        (hτ_ana w hw_ball).differentiableAt.hasDerivAt
    exact hZ_ev.deriv_eq.trans h_hd.deriv
  have hW'_comp : ∀ w ∈ U₁, deriv G.W_loc w = deriv G.W_loc (τ w) * deriv τ w := by
    intro w hw
    have hw_ball : w ∈ Metric.ball (0 : ℂ) ε₁ := by simpa using hw.2
    have hτw : τ w ∈ U₀ := ⟨(hτ_symm w hw.1 hw.2).1, (hτ_symm w hw.1 hw.2).2.1⟩
    have hW_ev : G.W_loc =ᶠ[nhds w] fun u => G.W_loc (τ u) := by
      filter_upwards [hU₁_open.mem_nhds hw] with u hu
      exact ((hτ_symm u hu.1 hu.2).2.2.2).symm
    have h_hd : HasDerivAt (fun u => G.W_loc (τ u)) (deriv G.W_loc (τ w) * deriv τ w) w :=
      (G.reg_on_punctured (τ w) hτw.1 hτw.2).2.1.differentiableAt.hasDerivAt.comp w
        (hτ_ana w hw_ball).differentiableAt.hasDerivAt
    exact hW_ev.deriv_eq.trans h_hd.deriv
  have h_pow6_ball : ∀ z ∈ Metric.ball (0 : ℂ) ε₁, (deriv τ z) ^ 6 = 1 := by
    intro z hz_ball
    by_cases hz0 : z = 0
    · subst hz0
      rw [hτ_deriv0]
      norm_num
    · have hz_pos : 0 < ‖z‖ := norm_pos_iff.mpr hz0
      have hz_lt : ‖z‖ < ε₁ := by simpa using hz_ball
      have hz_U₁ : z ∈ U₁ := ⟨hz_pos, hz_lt⟩
      have hz_U₀ : z ∈ U₀ := ⟨hz_pos, lt_of_lt_of_le hz_lt hε₁_le⟩
      have hτz_U₀ : τ z ∈ U₀ := ⟨(hτ_symm z hz_pos hz_lt).1, (hτ_symm z hz_pos hz_lt).2.1⟩
      have hZ''_comp : deriv (deriv G.Z_loc) z =
          deriv (deriv G.Z_loc) (τ z) * (deriv τ z) ^ 2 +
            deriv G.Z_loc (τ z) * deriv (deriv τ) z := by
        have h_ev : deriv G.Z_loc =ᶠ[nhds z] fun w => deriv G.Z_loc (τ w) * deriv τ w := by
          filter_upwards [hU₁_open.mem_nhds hz_U₁] with w hw
          exact hZ'_comp w hw
        have h1 : HasDerivAt (fun w => deriv G.Z_loc (τ w))
            (deriv (deriv G.Z_loc) (τ z) * deriv τ z) z :=
          (G.reg_on_punctured (τ z) hτz_U₀.1 hτz_U₀.2).1.deriv.differentiableAt.hasDerivAt.comp z
            (hτ_ana z hz_ball).differentiableAt.hasDerivAt
        have h2 : HasDerivAt (deriv τ) (deriv (deriv τ) z) z :=
          (hτ_ana z hz_ball).deriv.differentiableAt.hasDerivAt
        have h12 : HasDerivAt (fun w => deriv G.Z_loc (τ w) * deriv τ w)
            (deriv (deriv G.Z_loc) (τ z) * deriv τ z * deriv τ z +
              deriv G.Z_loc (τ z) * deriv (deriv τ) z) z := h1.mul h2
        rw [h_ev.deriv_eq, h12.deriv]
        ring
      have hW''_comp : deriv (deriv G.W_loc) z =
          deriv (deriv G.W_loc) (τ z) * (deriv τ z) ^ 2 +
            deriv G.W_loc (τ z) * deriv (deriv τ) z := by
        have h_ev : deriv G.W_loc =ᶠ[nhds z] fun w => deriv G.W_loc (τ w) * deriv τ w := by
          filter_upwards [hU₁_open.mem_nhds hz_U₁] with w hw
          exact hW'_comp w hw
        have h1 : HasDerivAt (fun w => deriv G.W_loc (τ w))
            (deriv (deriv G.W_loc) (τ z) * deriv τ z) z :=
          (G.reg_on_punctured (τ z) hτz_U₀.1 hτz_U₀.2).2.1.deriv.differentiableAt.hasDerivAt.comp z
            (hτ_ana z hz_ball).differentiableAt.hasDerivAt
        have h2 : HasDerivAt (deriv τ) (deriv (deriv τ) z) z :=
          (hτ_ana z hz_ball).deriv.differentiableAt.hasDerivAt
        have h12 : HasDerivAt (fun w => deriv G.W_loc (τ w) * deriv τ w)
            (deriv (deriv G.W_loc) (τ z) * deriv τ z * deriv τ z +
              deriv G.W_loc (τ z) * deriv (deriv τ) z) z := h1.mul h2
        rw [h_ev.deriv_eq, h12.deriv]
        ring
      have hWr_scale : deriv (deriv G.Z_loc) z * deriv G.W_loc z -
          deriv G.Z_loc z * deriv (deriv G.W_loc) z =
          (deriv (deriv G.Z_loc) (τ z) * deriv G.W_loc (τ z) -
            deriv G.Z_loc (τ z) * deriv (deriv G.W_loc) (τ z)) * (deriv τ z) ^ 3 := by
        rw [hZ''_comp, hW''_comp, hZ'_comp z hz_U₁, hW'_comp z hz_U₁]
        ring
      have h_id_z := (hU₀_ident z hz_U₀).2.2
      have h_id_τz := (hU₀_ident (τ z) hτz_U₀).2.2
      have hZW_τz_ne := (hU₀_ident (τ z) hτz_U₀).1
      have hτ'_ne : deriv τ z ≠ 0 := by
        intro h0
        have hZW_z := (hU₀_ident z hz_U₀).1
        rw [hZ'_comp z hz_U₁, h0, mul_zero, zero_mul] at hZW_z
        exact hZW_z rfl
      have h_eq12 : 16 * (G.c : ℂ) ^ 2 *
          (deriv G.Z_loc (τ z) * deriv G.W_loc (τ z)) ^ 3 * (deriv τ z) ^ 12 =
          16 * (G.c : ℂ) ^ 2 *
            (deriv G.Z_loc (τ z) * deriv G.W_loc (τ z)) ^ 3 * (deriv τ z) ^ 6 := by
        calc
          16 * (G.c : ℂ) ^ 2 *
              (deriv G.Z_loc (τ z) * deriv G.W_loc (τ z)) ^ 3 * (deriv τ z) ^ 12
            = ((deriv (deriv G.Z_loc) (τ z) * deriv G.W_loc (τ z) -
                deriv G.Z_loc (τ z) * deriv (deriv G.W_loc) (τ z)) ^ 4) *
                (deriv τ z) ^ 12 := by rw [h_id_τz]
          _ = (deriv (deriv G.Z_loc) z * deriv G.W_loc z -
                deriv G.Z_loc z * deriv (deriv G.W_loc) z) ^ 4 := by
                rw [hWr_scale]; ring
          _ = 16 * (G.c : ℂ) ^ 2 * (deriv G.Z_loc z * deriv G.W_loc z) ^ 3 := h_id_z
          _ = 16 * (G.c : ℂ) ^ 2 *
                (deriv G.Z_loc (τ z) * deriv G.W_loc (τ z)) ^ 3 * (deriv τ z) ^ 6 := by
                rw [hZ'_comp z hz_U₁, hW'_comp z hz_U₁]; ring
      have h_fac_ne : 16 * (G.c : ℂ) ^ 2 *
          (deriv G.Z_loc (τ z) * deriv G.W_loc (τ z)) ^ 3 * (deriv τ z) ^ 6 ≠ 0 :=
        mul_ne_zero
          (mul_ne_zero (mul_ne_zero (by norm_num) (pow_ne_zero 2 hc_ne))
            (pow_ne_zero 3 hZW_τz_ne))
          (pow_ne_zero 6 hτ'_ne)
      apply mul_left_cancel₀ h_fac_ne
      calc
        16 * (G.c : ℂ) ^ 2 *
            (deriv G.Z_loc (τ z) * deriv G.W_loc (τ z)) ^ 3 * (deriv τ z) ^ 6 * (deriv τ z) ^ 6
          = 16 * (G.c : ℂ) ^ 2 *
              (deriv G.Z_loc (τ z) * deriv G.W_loc (τ z)) ^ 3 * (deriv τ z) ^ 12 := by ring
        _ = 16 * (G.c : ℂ) ^ 2 *
              (deriv G.Z_loc (τ z) * deriv G.W_loc (τ z)) ^ 3 * (deriv τ z) ^ 6 * 1 := by
              rw [h_eq12, mul_one]
  let B := Metric.ball (0 : ℂ) ε₁
  have h0_mem_B : (0 : ℂ) ∈ B := Metric.mem_ball_self hε₁_pos
  have hτ'_diff : DifferentiableOn ℂ (deriv τ) B :=
    fun z hz => (hτ_ana z hz).deriv.differentiableAt.differentiableWithinAt
  have hτ''_zero : Set.EqOn (deriv (deriv τ)) 0 B := by
    intro z hz
    have h_ev : (deriv τ ^ 6) =ᶠ[nhds z] fun _ => (1 : ℂ) := by
      filter_upwards [Metric.isOpen_ball.mem_nhds hz] with w hw
      exact h_pow6_ball w hw
    have h_hd := (hτ_ana z hz).deriv.differentiableAt.hasDerivAt.pow 6
    have h_d0 : ((6 : ℕ) : ℂ) * (deriv τ z) ^ (6 - 1) * deriv (deriv τ) z = 0 := by
      have := h_ev.deriv_eq.trans (deriv_const z (1 : ℂ))
      rwa [h_hd.deriv] at this
    have hτ'_ne : deriv τ z ≠ 0 := by
      intro h0
      have h6 := h_pow6_ball z hz
      simp [h0] at h6
    have h6_ne : ((6 : ℕ) : ℂ) * (deriv τ z) ^ (6 - 1) ≠ 0 :=
      mul_ne_zero (by norm_num) (pow_ne_zero 5 hτ'_ne)
    exact (mul_eq_zero.mp h_d0).resolve_left h6_ne
  have hτ'_eq : ∀ z ∈ B, deriv τ z = -1 := by
    intro z hz
    have h_eq := Metric.isOpen_ball.is_const_of_deriv_eq_zero (convex_ball (0 : ℂ) ε₁).isPreconnected
      hτ'_diff hτ''_zero hz h0_mem_B
    rwa [hτ_deriv0] at h_eq
  have hτ_eq_neg : ∀ z ∈ B, τ z = -z := by
    have hg_diff : DifferentiableOn ℂ (fun w => τ w + w) B :=
      fun w hw => ((hτ_ana w hw).differentiableAt.add differentiableAt_id).differentiableWithinAt
    have hg_deriv : Set.EqOn (deriv (fun w => τ w + w)) 0 B := by
      intro w hw
      have h_hd : HasDerivAt (fun u => τ u + u) (deriv τ w + 1) w :=
        (hτ_ana w hw).differentiableAt.hasDerivAt.add (hasDerivAt_id w)
      simp [h_hd.deriv, hτ'_eq w hw]
    intro z hz
    have h_eq := Metric.isOpen_ball.is_const_of_deriv_eq_zero (convex_ball (0 : ℂ) ε₁).isPreconnected
      hg_diff hg_deriv hz h0_mem_B
    simp only [hτ0, add_zero] at h_eq
    linear_combination h_eq
  have hua_sum_cont : ContinuousAt (fun z : ℂ => G.u_a (-z) + G.u_a z) 0 :=
    ((G.u_a_analytic.fun_comp_of_eq analyticAt_id.neg neg_zero).add G.u_a_analytic).continuousAt
  have hua_sum_ne0 : G.u_a (-(0 : ℂ)) + G.u_a 0 ≠ 0 := by
    rw [neg_zero, ← two_mul]
    exact mul_ne_zero two_ne_zero G.u_a_ne_zero
  obtain ⟨r₂, hr₂_pos, hr₂_ne⟩ :=
    Metric.eventually_nhds_iff.mp (hua_sum_cont.eventually_ne hua_sum_ne0)
  refine ⟨min ε₁ r₂, lt_min hε₁_pos hr₂_pos, le_trans (min_le_left _ _) hε₁_le, ?_⟩
  intro z hz_pos hz_lt
  have hz_lt1 : ‖z‖ < ε₁ := lt_of_lt_of_le hz_lt (min_le_left _ _)
  have hz_ltr2 : ‖z‖ < r₂ := lt_of_lt_of_le hz_lt (min_le_right _ _)
  have hz_B : z ∈ B := Metric.mem_ball.mpr (by simpa [dist_zero_right] using hz_lt1)
  have hz_U₁ : z ∈ U₁ := ⟨hz_pos, hz_lt1⟩
  have hz_U₀ : z ∈ U₀ := ⟨hz_pos, lt_of_lt_of_le hz_lt1 hε₁_le⟩
  have hneg_U₀ : -z ∈ U₀ := by
    refine ⟨?_, ?_⟩
    · simpa using hz_pos
    · simpa using lt_of_lt_of_le hz_lt1 hε₁_le
  have hτz := hτ_eq_neg z hz_B
  have hZ_even : G.Z_loc (-z) = G.Z_loc z := by
    have := (hτ_symm z hz_pos hz_lt1).2.2.1
    rwa [hτz] at this
  have hW_even : G.W_loc (-z) = G.W_loc z := by
    have := (hτ_symm z hz_pos hz_lt1).2.2.2
    rwa [hτz] at this
  have hZ'_odd : deriv G.Z_loc (-z) * (-1) = deriv G.Z_loc z := by
    have h := (hZ'_comp z hz_U₁).symm
    rwa [hτz, hτ'_eq z hz_B] at h
  have hW'_odd : deriv G.W_loc (-z) * (-1) = deriv G.W_loc z := by
    have h := (hW'_comp z hz_U₁).symm
    rwa [hτz, hτ'_eq z hz_B] at h
  have hZaW_z := (hU₀_ident z hz_U₀).2.1
  have hZaW_neg := (hU₀_ident (-z) hneg_U₀).2.1
  have hW'_ne : deriv G.W_loc z ≠ 0 :=
    fun h0 => (hU₀_ident z hz_U₀).1 (by simp [h0])
  have ha_sq : (G.a_loc (-z)) ^ 2 = (G.a_loc z) ^ 2 := by
    have h_diff : ((G.a_loc (-z)) ^ 2 - (G.a_loc z) ^ 2) * deriv G.W_loc z = 0 := by
      linear_combination -hZaW_neg - hZaW_z - hZ'_odd - (G.a_loc (-z)) ^ 2 * hW'_odd
    exact sub_eq_zero.mp ((mul_eq_zero.mp h_diff).resolve_right hW'_ne)
  have ha_z := G.a_eq z hz_U₀.1 hz_U₀.2
  have ha_neg := G.a_eq (-z) hneg_U₀.1 hneg_U₀.2
  simp only [pow_one] at ha_z ha_neg
  have hz_ne : z ≠ 0 := norm_pos_iff.mp hz_pos
  have hua_sq : (G.u_a (-z)) ^ 2 = (G.u_a z) ^ 2 := by
    apply mul_left_cancel₀ (pow_ne_zero 2 hz_ne)
    calc
      z ^ 2 * (G.u_a (-z)) ^ 2 = ((-z) * G.u_a (-z)) ^ 2 := by ring
      _ = (G.a_loc (-z)) ^ 2 := by rw [ha_neg]
      _ = (G.a_loc z) ^ 2 := ha_sq
      _ = (z * G.u_a z) ^ 2 := by rw [ha_z]
      _ = z ^ 2 * (G.u_a z) ^ 2 := by ring
  have hua_prod : (G.u_a (-z) - G.u_a z) * (G.u_a (-z) + G.u_a z) = 0 := by
    linear_combination hua_sq
  have hua_sum_ne : G.u_a (-z) + G.u_a z ≠ 0 :=
    hr₂_ne (by simpa [dist_zero_right] using hz_ltr2)
  have hua_even : G.u_a (-z) = G.u_a z :=
    sub_eq_zero.mp ((mul_eq_zero.mp hua_prod).resolve_right hua_sum_ne)
  refine ⟨hZ_even, hW_even, ?_⟩
  rw [ha_neg, ha_z, hua_even]
  ring

theorem elliptic_normal_pole_cancellation (a : ℂ → ℂ) (ϕ : ℝ → ℝ) (p₀ : ℂ)
    (ha_nf : MeromorphicNFOn a Set.univ)
    (hϕ_diff : Differentiable ℝ ϕ)
    (hϕ_deriv : deriv ϕ 0 ≠ 0)
    (ha_real : ∀ x : ℝ, a x = Complex.exp (Complex.I * ϕ x))
    (ha_per : ∀ s : ℂ, a (s + 2 * Real.pi) = a s)
    (ha_conj : ∀ q : ℂ, ∀ᶠ z in nhdsWithin q {q}ᶜ, a (starRingEnd ℂ z) * starRingEnd ℂ (a z) = 1)
    (hp₀_im : p₀.im ≠ 0)
    (hp₀_ord : meromorphicOrderAt a p₀ ≠ 0)
    (ha_centers : ∀ q : ℂ, meromorphicOrderAt a q ≠ 0 →
      (meromorphicOrderAt a q = 1 ∨ meromorphicOrderAt a q = -1) ∧
      ∀ s : ℂ, a (2 * q - s) = -a s) :
    ∃ B₀ C₀ D₀ : ℝ, ∀ x : ℝ,
      (deriv ϕ x) ^ 2 = C₀ + B₀ * Real.cos (2 * ϕ x) + D₀ * Real.sin (2 * ϕ x) :=
by
  
  have hpLim : ∀ (f : ℂ → ℂ),
      (∀ s : ℂ, ∃ (V : Set ℂ) (q_s : ℂ → ℂ),
        IsOpen V ∧ s ∈ V ∧ DifferentiableOn ℂ q_s V ∧ ∀ z ∈ V, z ≠ s → f z = q_s z) →
      Differentiable ℂ (fun s => Filter.limUnder (nhdsWithin s {s}ᶜ) f) ∧
      (∀ (s : ℂ) (V : Set ℂ) (q_s : ℂ → ℂ),
        IsOpen V → s ∈ V → DifferentiableOn ℂ q_s V → (∀ z ∈ V, z ≠ s → f z = q_s z) →
        Filter.limUnder (nhdsWithin s {s}ᶜ) f = q_s s) ∧
      (∀ w_per : ℂ, (∀ z : ℂ, f (z + w_per) = f z) →
        ∀ s : ℂ, Filter.limUnder (nhdsWithin (s + w_per) {s + w_per}ᶜ) f =
          Filter.limUnder (nhdsWithin s {s}ᶜ) f) := by
    intro f hf_loc
    have h_local_tend : ∀ (s : ℂ) (V : Set ℂ) (q_s : ℂ → ℂ),
        IsOpen V → s ∈ V → DifferentiableOn ℂ q_s V → (∀ z ∈ V, z ≠ s → f z = q_s z) →
        ∀ z ∈ V, Filter.Tendsto f (nhdsWithin z {z}ᶜ) (nhds (q_s z)) := by
      intro s V q_s hV hs hq_diff hfg z hz
