      have hlt1 : ‖lam_seq n‖ < 1 := by
        rw [hnorm]
        calc r_seq * (1 / ((n : ℝ) + 1)) ≤ r_seq * 1 :=
              mul_le_mul_of_nonneg_left h_inv_le hr_seq_pos.le
          _ = r_seq := mul_one _
          _ ≤ 1 / 2 := hr_seq_le_half
          _ < 1 := by norm_num
      exact ⟨by rwa [hnorm], hlt1, norm_pos_iff.mp (by rwa [hnorm])⟩
    have hlam_nhdsWithin : Filter.Tendsto lam_seq Filter.atTop (nhdsWithin 0 {(0 : ℂ)}ᶜ) :=
      tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within lam_seq hlam_tendsto
        (Filter.Eventually.of_forall fun n => (hlam_bounds n).2.2)
    have hLim1 : Filter.Tendsto (fun n => slDivided (fun _ => 0) (lam_seq n) 0)
        Filter.atTop (nhds (slDivided (fun _ => 0) 0 0)) :=
      hCont_lam.tendsto.comp hlam_tendsto
    have hLim2 : Filter.Tendsto (fun n => slDivided (fun _ => 0) (lam_seq n) 0)
        Filter.atTop (nhds (1 / 24 : ℂ)) := by
      refine (hFreeLim.comp hlam_nhdsWithin).congr' ?_
      filter_upwards with n
      exact (hFreeTrig (lam_seq n) (hlam_bounds n).1 (hlam_bounds n).2.1).symm
    exact tendsto_nhds_unique hLim1 hLim2

  refine ⟨hODE, hLip, ⟨hNeg, ?_, hGlancingZero⟩, hPart4⟩
  intro Q a₀ a₁ hQ hk0
  dsimp only
  set Q_rev : ℝ → ℂ := fun w => Q (1 - w)
  set b₁ : ℂ := a₀ * c0Kernel Q 1 + a₁ * k0Kernel Q 1
  set b₁' : ℂ := a₀ * c0Deriv Q 1 + a₁ * k0Deriv Q 1
  have hk0_rev : k0Kernel Q_rev 1 ≠ 0 := by
    rw [(hNeg Q 0 0 hQ).1]
    exact hk0
  have hb₁_rev : (-b₁) * c0Kernel Q_rev 1 + b₁' * k0Kernel Q_rev 1 = -a₀ :=
    (hRevRoot Q a₀ a₁ hQ).2.symm
  rw [hDivEq Q_rev hk0_rev (-b₁) b₁', hb₁_rev, hDivEq Q hk0 a₀ a₁]
  exact hBivarRev (slNumerator Q) (slNumerator Q_rev) a₀ b₁ (hRevNum Q hQ hk0)

theorem small_field_and_base_collar_recurrence (hVolt : VolterraDivisionProp) (X : ExpStripData) (hX : IsExpObstructionStrip X) :
    (∃ η_sf C_sf : ℝ, 0 < η_sf ∧ 0 < C_sf ∧
      ∀ (s₀ : ℂ) (r_s r_t M₀ : ℝ),
        0 < r_s → 0 < r_t → 4 * r_t ≤ r_s → 0 ≤ M₀ → r_t * M₀ ≤ η_sf →
        Metric.ball s₀ r_s ⊆ X.D_strip →
        (∀ w ∈ Metric.ball s₀ r_s, ‖X.f w‖ ≤ M₀ ∧ Real.sqrt ‖X.q w‖ ≤ M₀) →
        DifferentiableOn ℂ (fun q : ℂ × ℂ × ℂ => chordActionP X q.1 q.2.1 q.2.2)
          { q : ℂ × ℂ × ℂ | ‖q.1 - s₀‖ < r_s / 4 ∧ ‖q.2.1 - 1‖ < 1 / 4 ∧ ‖q.2.2‖ < r_t } ∧
        (∀ s J t : ℂ, ‖s - s₀‖ < r_s / 8 → ‖J - 1‖ < 1 / 8 → ‖t‖ < r_t / 2 →
          chordActionP X (s + t * J) J (-t) = chordActionP X s J t) ∧
        (∀ s J t : ℂ, ‖s - s₀‖ < r_s / 4 → ‖J - 1‖ < 1 / 4 → ‖t‖ < r_t →
          ‖chordActionP X s J t - J ^ 3 / 24‖ ≤ C_sf * ‖t‖ ^ 2 * M₀ ^ 2)) ∧
    (∃ r_rec : ℝ, 0 < r_rec ∧ r_rec < X.r_star ∧
      ∀ y t : ℂ, |y.im| < X.s_star / 3 → 0 < ‖t‖ → ‖t‖ < r_rec →
        let s_prev := X.𝔰 (y - t, t)
        let s_curr := X.𝔰 (y, t)
        let s_next := X.𝔰 (y + t, t)
        let J_prev := (s_curr - s_prev) / t
        let J_curr := (s_next - s_curr) / t
        deriv (fun J' => chordActionP X s_curr J' t) J_curr -
          t * deriv (fun s' => chordActionP X s' J_curr t) s_curr =
          deriv (fun J' => chordActionP X s_prev J' t) J_prev) :=
by
  have hasDerivAt_congr_d : ∀ {𝕜 E : Type} [NontriviallyNormedField 𝕜]
      [NormedAddCommGroup E] [NormedSpace 𝕜 E] {f : 𝕜 → E} {f' g' : E} {x : 𝕜},
      HasDerivAt f f' x → f' = g' → HasDerivAt f g' x :=
    fun hf h => h ▸ hf
  have k0Kernel_zero_one : ∀ (hVolt : VolterraDivisionProp),
      k0Kernel (fun _ => 0) 1 = 1 := by
    intro hVolt
    have h1 := (hVolt.1 (fun _ => 0) continuousOn_const).2.2.2.2.2.2.2.2.2.1
      (fun w : ℝ => (w : ℂ)) (fun _ : ℝ => (1 : ℂ))
      Complex.continuous_ofReal.continuousOn continuousOn_const
      (fun w _ =>
        ⟨(by simpa using (hasDerivAt_id w).ofReal_comp.hasDerivWithinAt),
         (by simpa using hasDerivWithinAt_const w (Set.Icc (0 : ℝ) 1) (1 : ℂ))⟩)
      1 ⟨zero_le_one, le_rfl⟩
    simpa using h1.1.symm
  have ode_endpoint_id : ∀ (hVolt : VolterraDivisionProp) (X : ExpStripData)
      (_hX : IsExpObstructionStrip X) (s h : ℂ),
      (∀ w ∈ Set.Icc (0 : ℝ) 1, s + (w : ℂ) * h ∈ X.D_strip) →
      ContinuousOn (stripPotential X s h) (Set.Icc (0 : ℝ) 1) ∧
      ∀ w ∈ Set.Icc (0 : ℝ) 1,
        (h * X.f s) * c0Kernel (stripPotential X s h) w +
          (h ^ 2 * deriv X.f s) * k0Kernel (stripPotential X s h) w =
            h * X.f (s + (w : ℂ) * h) ∧
        (h * X.f s) * c0Deriv (stripPotential X s h) w +
          (h ^ 2 * deriv X.f s) * k0Deriv (stripPotential X s h) w =
            h ^ 2 * deriv X.f (s + (w : ℂ) * h) := by
    intro hVolt X hX s h h_seg
    have hdf_holo : DifferentiableOn ℂ (deriv X.f) X.D_strip :=
      hX.f_holo.deriv hX.D_strip_open
    let γ : ℝ → ℂ := fun w => s + (w : ℂ) * h
    have hγ_deriv : ∀ w : ℝ, HasDerivAt γ h w := by
      intro w
      have h1 : HasDerivAt (fun w : ℝ => s + (w : ℂ) * h) (0 + 1 * h) w :=
        (hasDerivAt_const w s).add (((hasDerivAt_id w).ofReal_comp).mul_const h)
      exact hasDerivAt_congr_d h1 (by ring)
    have hγ_cont : Continuous γ :=
      continuous_const.add (Complex.continuous_ofReal.mul continuous_const)
    have hQ_cont : ContinuousOn (stripPotential X s h) (Set.Icc (0 : ℝ) 1) :=
      continuousOn_const.mul (hX.q_holo.continuousOn.comp hγ_cont.continuousOn h_seg)
    refine ⟨hQ_cont, ?_⟩
    let y : ℝ → ℂ := fun w => h * X.f (γ w)
    let y' : ℝ → ℂ := fun w => h ^ 2 * deriv X.f (γ w)
    have hy_cont : ContinuousOn y (Set.Icc (0 : ℝ) 1) :=
      continuousOn_const.mul (hX.f_holo.continuousOn.comp hγ_cont.continuousOn h_seg)
    have hy'_cont : ContinuousOn y' (Set.Icc (0 : ℝ) 1) :=
      continuousOn_const.mul (hdf_holo.continuousOn.comp hγ_cont.continuousOn h_seg)
    have h_ivp := (hVolt.1 (stripPotential X s h) hQ_cont).2.2.2.2.2.2.2.2.2.1
      y y' hy_cont hy'_cont ?_
    · intro w hw
      have hw_eq := h_ivp w hw
      have hy0 : y 0 = h * X.f s := by simp [y, γ]
      have hy'0 : y' 0 = h ^ 2 * deriv X.f s := by simp [y', γ]
      rw [hy0, hy'0] at hw_eq
      exact ⟨hw_eq.1.symm, hw_eq.2.symm⟩
    · intro w hw
      have hγw : γ w ∈ X.D_strip := h_seg w hw
      have hf_at : HasDerivAt X.f (deriv X.f (γ w)) (γ w) :=
        (hX.f_holo.differentiableAt (hX.D_strip_open.mem_nhds hγw)).hasDerivAt
      have hdf_at : HasDerivAt (deriv X.f) (deriv (deriv X.f) (γ w)) (γ w) :=
        (hdf_holo.differentiableAt (hX.D_strip_open.mem_nhds hγw)).hasDerivAt
      have hy_d : HasDerivAt y (y' w) w := by
        refine hasDerivAt_congr_d ((hf_at.scomp w (hγ_deriv w)).const_mul h) ?_
        dsimp [y']
        ring
      have hy'_d : HasDerivAt y' (stripPotential X s h w * y w) w := by
        refine hasDerivAt_congr_d ((hdf_at.scomp w (hγ_deriv w)).const_mul (h ^ 2)) ?_
        dsimp [stripPotential, y, γ]
        rw [hX.deriv2_f (s + (w : ℂ) * h) hγw]
        ring
      exact ⟨hy_d.hasDerivWithinAt, hy'_d.hasDerivWithinAt⟩
  have slDivided_neg_even : ∀ (hVolt : VolterraDivisionProp) (Q : ℝ → ℂ),
      ContinuousOn Q (Set.Icc (0 : ℝ) 1) → ∀ (a₀ a₁ : ℂ),
      slDivided Q (-a₀) (-a₁) = slDivided Q a₀ a₁ := by
    intro hVolt Q hQ a₀ a₁
    have hd_neg_arg : ∀ (g : ℂ → ℂ) (z : ℂ),
