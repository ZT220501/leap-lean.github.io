      have h1 := M.h_X_lsc 0 h0_rbase (ENNReal.ofReal H_tilde) hHt_lt
      rwa [nhdsWithin_eq_nhds.mpr (Metric.isOpen_ball.mem_nhds h0_rbase)] at h1
    obtain ⟨δ_lsc, hδ_lsc_pos, hδ_lsc⟩ := Metric.eventually_nhds_iff_ball.mp h_ev_lsc
    let δ₁ : ℝ := min δ_lsc (min M.r_base (min (K.r_init / 2) (H_tilde - H')))
    have hδ₁_pos : 0 < δ₁ :=
      lt_min hδ_lsc_pos (lt_min M.r_base_pos (lt_min (half_pos K.r_init_pos) (by linarith)))
    have hδ₁_lsc : δ₁ ≤ δ_lsc := min_le_left _ _
    have hδ₁_rbase : δ₁ ≤ M.r_base := le_trans (min_le_right _ _) (min_le_left _ _)
    have hδ₁_rinit : δ₁ ≤ K.r_init / 2 :=
      le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_left _ _))
    have hδ₁_gap : δ₁ ≤ H_tilde - H' :=
      le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_right _ _))
    let W₁ : Set (ℂ × ℂ) := horizStrip H' ×ˢ Metric.ball (0 : ℂ) δ₁
    have hW₁_open : IsOpen W₁ := (hOpen_strip H').prod Metric.isOpen_ball
    have hW₁_sub : ∀ p ∈ W₁,
        p ∈ meroTubeENNR M.r_base M.h_X ∧ (p.1 - p.2, p.2) ∈ meroTubeENNR M.r_base M.h_X := by
      intro p hp
      have hy_im : |p.1.im| < H' := hp.1
      have ht_norm : ‖p.2‖ < δ₁ := by simpa [Metric.mem_ball, dist_zero_right] using hp.2
      have ht_lsc : p.2 ∈ Metric.ball (0 : ℂ) δ_lsc := by
        simp [Metric.mem_ball, dist_zero_right]; linarith
      have hct_lsc : starRingEnd ℂ p.2 ∈ Metric.ball (0 : ℂ) δ_lsc := by
        simp [Metric.mem_ball, dist_zero_right]; linarith
      have h_t_gt : ENNReal.ofReal H_tilde < M.h_X p.2 := hδ_lsc p.2 ht_lsc
      have h_ct_gt : ENNReal.ofReal H_tilde < M.h_X (starRingEnd ℂ p.2) := hδ_lsc _ hct_lsc
      have h_sub_im : |(p.1 - p.2).im| < H_tilde := by
        rw [Complex.sub_im]
        have h1 := abs_sub p.1.im p.2.im
        have h2 := Complex.abs_im_le_norm p.2
        linarith
      have h_ennr : ∀ u : ℝ, |u| < H_tilde →
          ENNReal.ofReal (-u) < M.h_X (starRingEnd ℂ p.2) ∧ ENNReal.ofReal u < M.h_X p.2 := by
        intro u hu
        obtain ⟨hu1, hu2⟩ := abs_lt.mp hu
        exact ⟨lt_of_le_of_lt (ENNReal.ofReal_le_ofReal (by linarith)) h_ct_gt,
               lt_of_le_of_lt (ENNReal.ofReal_le_ofReal (by linarith)) h_t_gt⟩
      exact ⟨⟨by linarith, (h_ennr p.1.im (by linarith)).1, (h_ennr p.1.im (by linarith)).2⟩,
             ⟨by linarith, (h_ennr (p.1 - p.2).im h_sub_im).1,
              (h_ennr (p.1 - p.2).im h_sub_im).2⟩⟩
    let F₁ : ℂ × ℂ → ℂ := L.𝔰_raw
    let F₂ : ℂ × ℂ → ℂ := fun p => L.𝔰_raw (p.1 - p.2, p.2)
    have hF₁_holo : DifferentiableOn ℂ F₁ W₁ := L.𝔰_raw_holo.mono (fun p hp => (hW₁_sub p hp).1)
    have hF₂_holo : DifferentiableOn ℂ F₂ W₁ :=
      L.𝔰_raw_holo.comp
        ((differentiable_fst.sub differentiable_snd).prodMk differentiable_snd).differentiableOn
        (fun p hp => (hW₁_sub p hp).2)
    
    have hDslopeApprox : ∀ {U_y : Set ℂ} {t_c : ℂ} {R M_b : ℝ} {F : ℂ × ℂ → ℂ},
        0 < R →
        DifferentiableOn ℂ F (U_y ×ˢ Metric.ball t_c (2 * R)) →
        (∀ y ∈ U_y, ∀ t ∈ Metric.ball t_c (2 * R), ‖F (y, t)‖ ≤ M_b) →
        ∀ {y : ℂ}, y ∈ U_y → ∀ {t : ℂ}, t ∈ Metric.ball t_c R →
        ∀ {h : ℂ}, ‖h‖ < R →
        ‖dslope (fun t' : ℂ => F (y, t')) t (t + h) - deriv (fun t' : ℂ => F (y, t')) t‖ ≤
          (4 * M_b / R ^ 2) * ‖h‖ := by
      intro U_y t_c R M_b F hR hF_h hF_b y hy t ht h hh
      have hsub_ball : Metric.ball t R ⊆ Metric.ball t_c (2 * R) := by
        intro w hw
        rw [Metric.mem_ball] at hw ht ⊢
        calc
          dist w t_c ≤ dist w t + dist t t_c := dist_triangle w t t_c
          _ < R + R := add_lt_add hw ht
          _ = 2 * R := by ring
      let g_sl : ℂ → ℂ := fun w => F (y, w)
      have hg_holo : DifferentiableOn ℂ g_sl (Metric.ball t R) :=
        hF_h.comp ((differentiable_const y).prodMk differentiable_id).differentiableOn
          (fun w hw => ⟨hy, hsub_ball hw⟩)
      have ht_self : t ∈ Metric.ball t R := Metric.mem_ball_self hR
      have hg_maps : Set.MapsTo g_sl (Metric.ball t R) (Metric.closedBall (g_sl t) (2 * M_b)) := by
        intro w hw
        rw [Metric.mem_closedBall, dist_eq_norm]
        calc
          ‖g_sl w - g_sl t‖ ≤ ‖g_sl w‖ + ‖g_sl t‖ := norm_sub_le _ _
          _ ≤ M_b + M_b :=
            add_le_add (hF_b y hy w (hsub_ball hw)) (hF_b y hy t (hsub_ball ht_self))
          _ = 2 * M_b := by ring
      let d₁_sl : ℂ → ℂ := dslope g_sl t
      have hd₁_sl_holo : DifferentiableOn ℂ d₁_sl (Metric.ball t R) :=
        (Complex.differentiableOn_dslope (Metric.isOpen_ball.mem_nhds ht_self)).mpr hg_holo
      have hd₁_sl_bdd : ∀ w ∈ Metric.ball t R, ‖d₁_sl w‖ ≤ (2 * M_b) / R :=
        fun w hw => Complex.norm_dslope_le_div_of_mapsTo_ball hg_holo hg_maps hw
      have hd₁_sl_maps : Set.MapsTo d₁_sl (Metric.ball t R)
          (Metric.closedBall (d₁_sl t) (4 * M_b / R)) := by
        intro w hw
        rw [Metric.mem_closedBall, dist_eq_norm]
        calc
          ‖d₁_sl w - d₁_sl t‖ ≤ ‖d₁_sl w‖ + ‖d₁_sl t‖ := norm_sub_le _ _
          _ ≤ (2 * M_b) / R + (2 * M_b) / R := add_le_add (hd₁_sl_bdd w hw) (hd₁_sl_bdd t ht_self)
          _ = 4 * M_b / R := by ring
      have hth_mem : t + h ∈ Metric.ball t R := by
        simpa [Metric.mem_ball, dist_eq_norm] using hh
      have hd₂_le : ‖dslope d₁_sl t (t + h)‖ ≤ (4 * M_b / R) / R :=
        Complex.norm_dslope_le_div_of_mapsTo_ball hd₁_sl_holo hd₁_sl_maps hth_mem
      have hsub_eq : d₁_sl (t + h) - deriv g_sl t = h * dslope d₁_sl t (t + h) := by
        have hs := sub_smul_dslope d₁_sl t (t + h)
        have hd_same : d₁_sl t = deriv g_sl t := dslope_same g_sl t
        rw [add_sub_cancel_left, smul_eq_mul, hd_same] at hs
        exact hs.symm
      calc
        ‖d₁_sl (t + h) - deriv g_sl t‖ = ‖h‖ * ‖dslope d₁_sl t (t + h)‖ := by rw [hsub_eq, norm_mul]
        _ ≤ ‖h‖ * ((4 * M_b / R) / R) := mul_le_mul_of_nonneg_left hd₂_le (norm_nonneg h)
        _ = (4 * M_b / R ^ 2) * ‖h‖ := by ring
    have hSlicePartialT : ∀ {U : Set ℂ}, IsOpen U → ∀ {t_c : ℂ} {δ : ℝ}, 0 < δ →
        ∀ {F : ℂ × ℂ → ℂ}, DifferentiableOn ℂ F (U ×ˢ Metric.ball t_c δ) →
        DifferentiableOn ℂ (fun y : ℂ => deriv (fun t' : ℂ => F (y, t')) t_c) U := by
      intro U hU t_c δ hδ F hF y_c hy_c
      obtain ⟨r_y, hry_pos, hry_sub⟩ := Metric.isOpen_iff.mp hU y_c hy_c
      let ρ_y : ℝ := r_y / 2
      have hρ_y_pos : 0 < ρ_y := half_pos hry_pos
      have hcb_y : Metric.closedBall y_c ρ_y ⊆ U :=
        Set.Subset.trans (Metric.closedBall_subset_ball (half_lt_self hry_pos)) hry_sub
      let R : ℝ := δ / 4
      have hR_pos : 0 < R := div_pos hδ (by norm_num)
      have hcb_t : Metric.closedBall t_c (2 * R) ⊆ Metric.ball t_c δ :=
        Metric.closedBall_subset_ball (by dsimp [R]; linarith)
      have hball_t : Metric.ball t_c (2 * R) ⊆ Metric.closedBall t_c (2 * R) :=
        Metric.ball_subset_closedBall
      let K_box : Set (ℂ × ℂ) := Metric.closedBall y_c ρ_y ×ˢ Metric.closedBall t_c (2 * R)
      have hK_sub : K_box ⊆ U ×ˢ Metric.ball t_c δ := Set.prod_mono hcb_y hcb_t
      have hK_compact : IsCompact K_box :=
        (isCompact_closedBall y_c ρ_y).prod (isCompact_closedBall t_c (2 * R))
      obtain ⟨M₀, hM₀⟩ := hK_compact.exists_bound_of_continuousOn
        (continuous_norm.comp_continuousOn (hF.continuousOn.mono hK_sub))
      let M_b : ℝ := max M₀ 0
      have _hMb_nonneg : 0 ≤ M_b := le_max_right _ _
      let h_seq : ℕ → ℂ := fun n => ((R / (2 * ((n : ℝ) + 1)) : ℝ) : ℂ)
      have hh_ne : ∀ n : ℕ, h_seq n ≠ 0 :=
        fun _ => Complex.ofReal_ne_zero.mpr (ne_of_gt (div_pos hR_pos (by positivity)))
      have hh_norm : ∀ n : ℕ, ‖h_seq n‖ = R / (2 * ((n : ℝ) + 1)) := by
        intro n
        have hp : 0 ≤ R / (2 * ((n : ℝ) + 1)) := le_of_lt (div_pos hR_pos (by positivity))
        dsimp only [h_seq]
        rw [Complex.norm_real, Real.norm_of_nonneg hp]
      have hh_lt_R : ∀ n : ℕ, ‖h_seq n‖ < R := by
        intro n
        rw [hh_norm n]
        have hge : (2 : ℝ) ≤ 2 * ((n : ℝ) + 1) := by linarith [Nat.cast_nonneg (α := ℝ) n]
        calc
          R / (2 * ((n : ℝ) + 1)) ≤ R / 2 :=
            div_le_div_of_nonneg_left (le_of_lt hR_pos) (by norm_num) hge
          _ < R := half_lt_self hR_pos
      let G_seq : ℕ → ℂ → ℂ := fun n y => (F (y, t_c + h_seq n) - F (y, t_c)) / h_seq n
      have hG_holo : ∀ n : ℕ, DifferentiableOn ℂ (G_seq n) (Metric.ball y_c ρ_y) := by
        intro n
        have ht_n : t_c + h_seq n ∈ Metric.ball t_c δ :=
          hcb_t (hball_t (by
            simpa [Metric.mem_ball, dist_eq_norm] using lt_trans (hh_lt_R n) (by linarith)))
        have ht_0 : t_c ∈ Metric.ball t_c δ := Metric.mem_ball_self hδ
        have hf1 : DifferentiableOn ℂ (fun y : ℂ => F (y, t_c + h_seq n)) (Metric.ball y_c ρ_y) :=
          hF.comp (differentiable_id.prodMk (differentiable_const _)).differentiableOn
            (fun y hy => ⟨hcb_y (Metric.ball_subset_closedBall hy), ht_n⟩)
        have hf0 : DifferentiableOn ℂ (fun y : ℂ => F (y, t_c)) (Metric.ball y_c ρ_y) :=
          hF.comp (differentiable_id.prodMk (differentiable_const _)).differentiableOn
            (fun y hy => ⟨hcb_y (Metric.ball_subset_closedBall hy), ht_0⟩)
        exact (hf1.sub hf0).div_const (h_seq n)
      have hUnif : TendstoUniformlyOn G_seq (fun y : ℂ => deriv (fun t' : ℂ => F (y, t')) t_c)
          Filter.atTop (Metric.ball y_c ρ_y) := by
        rw [Metric.tendstoUniformlyOn_iff]
        intro ε hε
        have _hC_pos : 0 < (4 * M_b / R ^ 2) + 1 := by positivity
        have h_tend : Filter.Tendsto
            (fun n : ℕ => ((4 * M_b / R ^ 2) + 1) * (R / (2 * ((n : ℝ) + 1))))
            Filter.atTop (nhds 0) := by
          have h1 : Filter.Tendsto (fun n : ℕ => ((n : ℝ) + 1)⁻¹) Filter.atTop (nhds 0) :=
            tendsto_inv_atTop_zero.comp (tendsto_natCast_atTop_atTop.atTop_add tendsto_const_nhds)
          have h2 := h1.const_mul (((4 * M_b / R ^ 2) + 1) * (R / 2))
          rw [mul_zero] at h2
          refine h2.congr (fun n => ?_)
          have hn1 : ((n : ℝ) + 1) ≠ 0 := by positivity
          field_simp [hn1]
        refine (h_tend.eventually (isOpen_Iio.mem_nhds hε)).mono (fun n hn y hy => ?_)
        rw [dist_comm, dist_eq_norm]
        have hG_eq : G_seq n y = dslope (fun t' : ℂ => F (y, t')) t_c (t_c + h_seq n) := by
          rw [dslope_of_ne _ (by simp [hh_ne n])]
          simp [G_seq, slope, vsub_eq_sub, div_eq_inv_mul]
        rw [hG_eq]
        have hle := hDslopeApprox (M_b := M_b) hR_pos
          (hF.mono (Set.prod_mono hcb_y (Set.Subset.trans hball_t hcb_t)))
          (fun y' hy' t' ht' => le_trans
            (by simpa [Real.norm_eq_abs, abs_norm] using hM₀ (y', t') ⟨hy', hball_t ht'⟩)
            (le_max_left M₀ 0))
          (Metric.ball_subset_closedBall hy)
          (Metric.mem_ball_self hR_pos)
          (hh_lt_R n)
        rw [hh_norm n] at hle
        have hpos_step : 0 ≤ R / (2 * ((n : ℝ) + 1)) := le_of_lt (div_pos hR_pos (by positivity))
        have hlt_n : ((4 * M_b / R ^ 2) + 1) * (R / (2 * ((n : ℝ) + 1))) < ε := hn
        linarith
      have hDiff_ball : DifferentiableOn ℂ (fun y : ℂ => deriv (fun t' : ℂ => F (y, t')) t_c)
          (Metric.ball y_c ρ_y) :=
        hUnif.tendstoLocallyUniformlyOn.differentiableOn
          (Filter.Eventually.of_forall hG_holo) Metric.isOpen_ball
      exact (hDiff_ball.differentiableAt
        (Metric.isOpen_ball.mem_nhds (Metric.mem_ball_self hρ_y_pos))).differentiableWithinAt
    have hPartialT_cont : ∀ {W : Set (ℂ × ℂ)}, IsOpen W → ∀ {q₀ : ℂ × ℂ}, q₀ ∈ W →
        ∀ {F : ℂ × ℂ → ℂ}, DifferentiableOn ℂ F W →
        ContinuousAt (fun p : ℂ × ℂ => deriv (fun t' : ℂ => F (p.1, t')) p.2) q₀ := by
      intro W hW q₀ hq₀ F hF
      obtain ⟨r₀, hr₀_pos, hr₀_sub⟩ := Metric.isOpen_iff.mp hW q₀ hq₀
      let R : ℝ := r₀ / 3
      have hR_pos : 0 < R := div_pos hr₀_pos (by norm_num)
      let K_box : Set (ℂ × ℂ) := Metric.closedBall q₀.1 R ×ˢ Metric.closedBall q₀.2 (2 * R)
      have hK_sub : K_box ⊆ W := by
        intro q hq
        apply hr₀_sub
        rw [Metric.mem_ball, Prod.dist_eq]
        have h1 : dist q.1 q₀.1 ≤ R := hq.1
        have h2 : dist q.2 q₀.2 ≤ 2 * R := hq.2
        have hm : max (dist q.1 q₀.1) (dist q.2 q₀.2) ≤ 2 * R := max_le (by linarith) h2
        dsimp [R] at hm
        linarith
      obtain ⟨M₀, hM₀⟩ := ((isCompact_closedBall q₀.1 R).prod
        (isCompact_closedBall q₀.2 (2 * R))).exists_bound_of_continuousOn
        (continuous_norm.comp_continuousOn (hF.continuousOn.mono hK_sub))
      let M_b : ℝ := max M₀ 0
      have _hMb_nonneg : 0 ≤ M_b := le_max_right _ _
      rw [Metric.continuousAt_iff]
      intro ε hε
      let C_b : ℝ := (4 * M_b / R ^ 2) + 1
      have hC_pos : 0 < C_b := by positivity
      let h_r : ℝ := min (R / 2) (ε / (3 * C_b))
      have hhr_pos : 0 < h_r := lt_min (half_pos hR_pos) (div_pos hε (by positivity))
      let h : ℂ := (h_r : ℂ)
      have hh_ne : h ≠ 0 := Complex.ofReal_ne_zero.mpr (ne_of_gt hhr_pos)
      have hh_norm : ‖h‖ = h_r := by simp [h, Real.norm_eq_abs, abs_of_pos hhr_pos]
      have hh_lt_R : ‖h‖ < R := by
        rw [hh_norm]
        exact lt_of_le_of_lt (min_le_left _ _) (half_lt_self hR_pos)
      have hCh_lt : (4 * M_b / R ^ 2) * ‖h‖ < ε / 3 := by
        rw [hh_norm]
        have hle : h_r ≤ ε / (3 * C_b) := min_le_right _ _
        have h1 : (4 * M_b / R ^ 2) * h_r < C_b * h_r := by dsimp [C_b]; nlinarith
        have h2 : C_b * h_r ≤ ε / 3 := by
          calc
            C_b * h_r ≤ C_b * (ε / (3 * C_b)) := mul_le_mul_of_nonneg_left hle (le_of_lt hC_pos)
            _ = ε / 3 := by field_simp [ne_of_gt hC_pos]
        linarith
      let DQ : ℂ × ℂ → ℂ := fun p => (F (p.1, p.2 + h) - F p) / h
      have hq₀_h_W : (q₀.1, q₀.2 + h) ∈ W := by
        apply hK_sub
        refine ⟨Metric.mem_closedBall_self (le_of_lt hR_pos), ?_⟩
        rw [Metric.mem_closedBall, dist_eq_norm, add_sub_cancel_left]
        linarith
      have hF_cont0 : ContinuousAt F q₀ := (hF.differentiableAt (hW.mem_nhds hq₀)).continuousAt
      have hF_conth : ContinuousAt (fun p : ℂ × ℂ => F (p.1, p.2 + h)) q₀ :=
        ContinuousAt.comp (f := fun p : ℂ × ℂ => (p.1, p.2 + h))
          (hF.differentiableAt (hW.mem_nhds hq₀_h_W)).continuousAt
          (continuousAt_fst.prodMk (continuousAt_snd.add continuousAt_const))
      have hDQ_cont : ContinuousAt DQ q₀ := (hF_conth.sub hF_cont0).div_const h
      obtain ⟨δ_dq, hδ_dq_pos, hδ_dq⟩ := Metric.continuousAt_iff.mp hDQ_cont (ε / 3) (by linarith)
      refine ⟨min δ_dq R, lt_min hδ_dq_pos hR_pos, ?_⟩
      intro p hp_dist
      have hp_dq : dist (DQ p) (DQ q₀) < ε / 3 :=
        hδ_dq (lt_of_lt_of_le hp_dist (min_le_left _ _))
      have hp_R : dist p q₀ < R := lt_of_lt_of_le hp_dist (min_le_right _ _)
      rw [Prod.dist_eq] at hp_R
      have hp1_cb : p.1 ∈ Metric.closedBall q₀.1 R :=
        le_of_lt (lt_of_le_of_lt (le_max_left _ _) hp_R)
      have hp2_ball : p.2 ∈ Metric.ball q₀.2 R :=
        lt_of_le_of_lt (le_max_right _ _) hp_R
      have hDQ_eq : ∀ q : ℂ × ℂ, DQ q = dslope (fun t' : ℂ => F (q.1, t')) q.2 (q.2 + h) := by
        intro q
        rw [dslope_of_ne _ (by simp [hh_ne])]
        simp [DQ, slope, vsub_eq_sub, div_eq_inv_mul]
      have hF_box_holo : DifferentiableOn ℂ F
          (Metric.closedBall q₀.1 R ×ˢ Metric.ball q₀.2 (2 * R)) :=
        hF.mono (Set.Subset.trans
          (Set.prod_mono Set.Subset.rfl Metric.ball_subset_closedBall) hK_sub)
      have hF_box_bdd : ∀ y' ∈ Metric.closedBall q₀.1 R, ∀ t' ∈ Metric.ball q₀.2 (2 * R),
          ‖F (y', t')‖ ≤ M_b :=
        fun y' hy' t' ht' => le_trans
          (by simpa [Real.norm_eq_abs, abs_norm] using
            hM₀ (y', t') ⟨hy', Metric.ball_subset_closedBall ht'⟩)
          (le_max_left M₀ 0)
      have herr_p : ‖DQ p - deriv (fun t' : ℂ => F (p.1, t')) p.2‖ ≤ (4 * M_b / R ^ 2) * ‖h‖ := by
        rw [hDQ_eq p]
        exact hDslopeApprox hR_pos hF_box_holo hF_box_bdd hp1_cb hp2_ball hh_lt_R
      have herr_0 : ‖DQ q₀ - deriv (fun t' : ℂ => F (q₀.1, t')) q₀.2‖ ≤
          (4 * M_b / R ^ 2) * ‖h‖ := by
        rw [hDQ_eq q₀]
        exact hDslopeApprox hR_pos hF_box_holo hF_box_bdd
          (Metric.mem_closedBall_self (le_of_lt hR_pos))
          (Metric.mem_ball_self hR_pos) hh_lt_R
      rw [dist_eq_norm] at hp_dq ⊢
      have htri : ‖deriv (fun t' : ℂ => F (p.1, t')) p.2 -
            deriv (fun t' : ℂ => F (q₀.1, t')) q₀.2‖ ≤
          ‖DQ p - deriv (fun t' : ℂ => F (p.1, t')) p.2‖ +
          ‖DQ p - DQ q₀‖ +
          ‖DQ q₀ - deriv (fun t' : ℂ => F (q₀.1, t')) q₀.2‖ := by
        have heq : deriv (fun t' : ℂ => F (p.1, t')) p.2 -
            deriv (fun t' : ℂ => F (q₀.1, t')) q₀.2 =
          -(DQ p - deriv (fun t' : ℂ => F (p.1, t')) p.2) +
            (DQ p - DQ q₀) +
            (DQ q₀ - deriv (fun t' : ℂ => F (q₀.1, t')) q₀.2) := by ring
        rw [heq]
        calc
          ‖-(DQ p - deriv (fun t' : ℂ => F (p.1, t')) p.2) +
              (DQ p - DQ q₀) +
              (DQ q₀ - deriv (fun t' : ℂ => F (q₀.1, t')) q₀.2)‖ ≤
            ‖-(DQ p - deriv (fun t' : ℂ => F (p.1, t')) p.2) + (DQ p - DQ q₀)‖ +
              ‖DQ q₀ - deriv (fun t' : ℂ => F (q₀.1, t')) q₀.2‖ := norm_add_le _ _
          _ ≤ ‖DQ p - deriv (fun t' : ℂ => F (p.1, t')) p.2‖ +
              ‖DQ p - DQ q₀‖ +
              ‖DQ q₀ - deriv (fun t' : ℂ => F (q₀.1, t')) q₀.2‖ := by
            have hn := norm_add_le
              (-(DQ p - deriv (fun t' : ℂ => F (p.1, t')) p.2)) (DQ p - DQ q₀)
            rw [norm_neg] at hn
            linarith
      linarith
    let L_fn : ℂ × ℂ → ((ℂ × ℂ) →L[ℂ] ℂ) := fun p =>
      iterDerivYT 1 0 F₁ p • ContinuousLinearMap.fst ℂ ℂ ℂ +
      iterDerivYT 0 1 F₁ p • ContinuousLinearMap.snd ℂ ℂ ℂ
    have hs₀_H' : s₀ ∈ horizStrip H' := lt_of_le_of_lt (le_max_left _ _) hH'_gt
    let p₀ : ℂ × ℂ := (s₀, 0)
    have hp₀_W₁ : p₀ ∈ W₁ := ⟨hs₀_H', Metric.mem_ball_self hδ₁_pos⟩
    have h01_1_cont : ContinuousAt (iterDerivYT 0 1 F₁) p₀ :=
      hPartialT_cont hW₁_open hp₀_W₁ hF₁_holo
    have h10_1_cont : ContinuousAt (iterDerivYT 1 0 F₁) p₀ := by
      let swap : ℂ × ℂ → ℂ × ℂ := fun q => (q.2, q.1)
      have hswap_cont : Continuous swap := continuous_snd.prodMk continuous_fst
      have hswap_diff : Differentiable ℂ swap := differentiable_snd.prodMk differentiable_fst
      let W_sw : Set (ℂ × ℂ) := swap ⁻¹' W₁
      have hW_sw : IsOpen W_sw := hW₁_open.preimage hswap_cont
      have hp₀_sw : (p₀.2, p₀.1) ∈ W_sw := hp₀_W₁
      have hF_sw : DifferentiableOn ℂ (fun q : ℂ × ℂ => F₁ (swap q)) W_sw :=
        hF₁_holo.comp hswap_diff.differentiableOn (fun _ hq => hq)
      have hc := hPartialT_cont hW_sw hp₀_sw hF_sw
      exact ContinuousAt.comp
        (g := fun q : ℂ × ℂ => deriv (fun y' : ℂ => F₁ (y', q.1)) q.2)
        (f := swap) hc hswap_cont.continuousAt
    have hF₁_fderiv_W₁ : ∀ p ∈ W₁, HasFDerivAt F₁ (L_fn p) p := by
      intro p hp
      have hd : DifferentiableAt ℂ F₁ p := hF₁_holo.differentiableAt (hW₁_open.mem_nhds hp)
      let T1 : ℂ →L[ℂ] ℂ × ℂ := (ContinuousLinearMap.id ℂ ℂ).prod 0
      let T2 : ℂ →L[ℂ] ℂ × ℂ := (0 : ℂ →L[ℂ] ℂ).prod (ContinuousLinearMap.id ℂ ℂ)
      have hd1 : iterDerivYT 1 0 F₁ p = (fderiv ℂ F₁ p) (1, 0) := by
        change deriv (fun y' : ℂ => F₁ (y', p.2)) p.1 = _
        have hc : HasDerivAt (fun y' : ℂ => (y', p.2)) (1, 0) p.1 := by
          have h := T1.hasDerivAt (x := p.1) |>.const_add (0, p.2)
          have hf : (fun y' : ℂ => (0, p.2) + T1 y') = (fun y' : ℂ => (y', p.2)) := by
            ext y' <;> simp [T1]
          have hv : T1 1 = ((1 : ℂ), (0 : ℂ)) := by simp [T1]
          rwa [hf, hv] at h
        exact (hd.hasFDerivAt.comp_hasDerivAt p.1 hc).deriv
      have hd2 : iterDerivYT 0 1 F₁ p = (fderiv ℂ F₁ p) (0, 1) := by
        change deriv (fun t' : ℂ => F₁ (p.1, t')) p.2 = _
        have hc : HasDerivAt (fun t' : ℂ => (p.1, t')) (0, 1) p.2 := by
          have h := T2.hasDerivAt (x := p.2) |>.const_add (p.1, 0)
          have hf : (fun t' : ℂ => (p.1, 0) + T2 t') = (fun t' : ℂ => (p.1, t')) := by
            ext t' <;> simp [T2]
          have hv : T2 1 = ((0 : ℂ), (1 : ℂ)) := by simp [T2]
          rwa [hf, hv] at h
        exact (hd.hasFDerivAt.comp_hasDerivAt p.2 hc).deriv
      have hL_eq : fderiv ℂ F₁ p = L_fn p := by
        refine ContinuousLinearMap.ext (fun ⟨u_v, v_v⟩ => ?_)
        have hvec : ((u_v, v_v) : ℂ × ℂ) =
            u_v • ((1 : ℂ), (0 : ℂ)) + v_v • ((0 : ℂ), (1 : ℂ)) := by
          ext <;> simp
        calc
          (fderiv ℂ F₁ p) (u_v, v_v) =
              (fderiv ℂ F₁ p) (u_v • ((1 : ℂ), (0 : ℂ)) + v_v • ((0 : ℂ), (1 : ℂ))) := by
            rw [← hvec]
          _ = u_v * (fderiv ℂ F₁ p) (1, 0) + v_v * (fderiv ℂ F₁ p) (0, 1) := by
            rw [map_add, map_smul, map_smul, smul_eq_mul, smul_eq_mul]
          _ = L_fn p (u_v, v_v) := by
            dsimp only [L_fn]
            rw [← hd1, ← hd2]
            simp [mul_comm]
      exact hL_eq ▸ hd.hasFDerivAt
    have h10_p₀ : iterDerivYT 1 0 F₁ p₀ = 1 := by
      change deriv (fun y' : ℂ => L.𝔰_raw (y', 0)) s₀ = 1
      have hev : (fun y' : ℂ => L.𝔰_raw (y', 0)) =ᶠ[nhds s₀] id := by
        refine Filter.eventually_of_mem ((hOpen_strip H').mem_nhds hs₀_H') (fun y' hy' => ?_)
        have hy'_DH : y' ∈ D_H := by
          have hy'_im : |y'.im| < H_tilde := lt_trans hy' hH'_lt
          exact lt_of_le_of_lt (ENNReal.ofReal_le_ofReal (le_of_lt hy'_im)) hHt_lt
        exact L.𝔰_raw_zero y' hy'_DH
      exact ((hasDerivAt_id s₀).congr_of_eventuallyEq hev).deriv
    have h01_p₀ : iterDerivYT 0 1 F₁ p₀ = 0 := by
      change deriv (fun t' : ℂ => L.𝔰_raw (s₀, t')) 0 = 0
      have hdiff_t : DifferentiableAt ℂ (fun t' : ℂ => L.𝔰_raw (s₀, t')) 0 := by
        let T2 : ℂ →L[ℂ] ℂ × ℂ := (0 : ℂ →L[ℂ] ℂ).prod (ContinuousLinearMap.id ℂ ℂ)
        have hc : HasDerivAt (fun t' : ℂ => (s₀, t')) (0, 1) 0 := by
          have h := T2.hasDerivAt (x := 0) |>.const_add (s₀, 0)
          have hf : (fun t' : ℂ => (s₀, 0) + T2 t') = (fun t' : ℂ => (s₀, t')) := by
            ext t' <;> simp [T2]
          have hv : T2 1 = ((0 : ℂ), (1 : ℂ)) := by simp [T2]
          rwa [hf, hv] at h
        exact ((hF₁_fderiv_W₁ p₀ hp₀_W₁).comp_hasDerivAt 0 hc).differentiableAt
      set d₀ := deriv (fun t' : ℂ => L.𝔰_raw (s₀, t')) 0
      have hd_pos : HasDerivAt (fun t' : ℂ => L.𝔰_raw (s₀, t')) d₀ 0 := hdiff_t.hasDerivAt
      have hd_neg : HasDerivAt (fun t' : ℂ => L.𝔰_raw (s₀, -t')) (-d₀) 0 := by
        have hd_pos' : HasDerivAt (fun t' : ℂ => L.𝔰_raw (s₀, t')) d₀ (-(0 : ℂ)) := by
          rw [neg_zero]; exact hd_pos
        have h := hd_pos'.comp (0 : ℂ) (hasDerivAt_id (0 : ℂ)).neg
        have hd_eq : d₀ * -1 = -d₀ := by ring
        rw [hd_eq] at h
        exact h
      have hev_even : (fun t' : ℂ => L.𝔰_raw (s₀, -t')) =ᶠ[nhds (0 : ℂ)]
          (fun t' : ℂ => L.𝔰_raw (s₀, t')) := by
        refine Filter.eventually_of_mem
          (Metric.isOpen_ball.mem_nhds (Metric.mem_ball_self hδ₁_pos)) (fun t' ht' => ?_)
        exact L.𝔰_raw_even (s₀, t') (hW₁_sub (s₀, t') ⟨hs₀_H', ht'⟩).1
      have heq : -d₀ = d₀ := hd_neg.unique (hd_pos.congr_of_eventuallyEq hev_even)
      have h2 : (2 : ℂ) * d₀ = 0 := by linear_combination -heq
      exact (mul_eq_zero.mp h2).resolve_left two_ne_zero
    have hL_p₀ : L_fn p₀ = ContinuousLinearMap.fst ℂ ℂ ℂ :=
      ContinuousLinearMap.ext (fun ⟨u_v, v_v⟩ => by simp [L_fn, h10_p₀, h01_p₀])
    have hL_cont : ContinuousAt L_fn p₀ :=
      (h10_1_cont.smul continuousAt_const).add (h01_1_cont.smul continuousAt_const)
    have hStrict1 : HasStrictFDerivAt F₁ (ContinuousLinearMap.fst ℂ ℂ ℂ) p₀ := by
      rw [← hL_p₀]
      exact hasStrictFDerivAt_of_hasFDerivAt_of_continuousAt
        (Filter.eventually_of_mem (hW₁_open.mem_nhds hp₀_W₁) hF₁_fderiv_W₁) hL_cont
    let Φ : ℂ × ℂ → ℂ × ℂ := fun p => (F₁ p, p.2)
    have hStrictΦ : HasStrictFDerivAt Φ
        (ContinuousLinearEquiv.refl ℂ (ℂ × ℂ) : (ℂ × ℂ) →L[ℂ] (ℂ × ℂ)) p₀ := by
      have h := hStrict1.prodMk (hasStrictFDerivAt_snd (p := p₀))
      convert h using 1
      exact ContinuousLinearMap.ext (fun ⟨u_v, v_v⟩ => by simp)
    have hΦ_p₀ : Φ p₀ = (s₀, 0) := by
      dsimp only [Φ, F₁, p₀]
