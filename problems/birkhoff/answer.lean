        exact Filter.eventually_of_mem hnhds (fun w hw => hDeep_eq T_c hTc w hw.1 T hT_hd)
      exact hfL_ana.eqOn_of_preconnected_of_eventuallyEq hfR_ana hUw_preconn hw₀_in_Uw hev hY_in_Uw
    have hIm_neg_hd : ∀ T_c ∈ Metric.closedBall (0 : ℂ) ρ_star,
        ∀ T ∈ upperHalfDiskOpen, (H_plus T T_c Y).im < 0 := by
      intro T_c hTc T hT
      let g_tilde : ℂ → ℂ := fun ζ =>
        if ζ ∈ upperHalfDiskOpen then H_plus ζ T_c Y else g_plus ζ T_c Y
      let W_ext : Set ℂ := upperHalfDiskOpen ∪ V_collar
      have hH_holo_hd : DifferentiableOn ℂ (fun ζ₀ => H_plus ζ₀ T_c Y) upperHalfDiskOpen := by
        have hI_holo : DifferentiableOn ℂ
            (fun ζ₀ => upperHalfDiskIntegral (fun ζ => g_plus ζ T_c Y / (ζ - ζ₀)))
            upperHalfDiskOpen := by
          apply hCauchyP upperHalfDiskOpen
            (fun ζ₀ ζ => g_plus ζ T_c Y / (ζ - ζ₀)) hOpen_hd
          · have hg_bdry_cont : ContinuousOn (fun ζ => g_plus ζ T_c Y) upperHalfDiskBdry := by
              have hG_bdry : ContinuousOn G upperHalfDiskBdry :=
                hG_holo.continuousOn.mono
                  (fun ζ hζ => (hCollar_Uw_mem ζ (hBdry_sub_collar hζ) T_c hTc Y hY_in_Uw).1)
              have hmap : ContinuousOn (fun ζ => (ζ, Y + G ζ - G T_c)) upperHalfDiskBdry :=
                continuousOn_id.prodMk ((continuousOn_const.add hG_bdry).sub continuousOn_const)
              exact hΦ_holo.continuousOn.comp hmap
