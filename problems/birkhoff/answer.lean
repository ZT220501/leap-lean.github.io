          Complex.I * (F (a, circleMap 0 1 θ) * circleMap 0 1 θ / (circleMap 0 1 θ - ζ)) := by
      intro θ
      have h_eq : F (a, circleMap 0 1 θ) = G_a (circleMap 0 1 θ) :=
        hF_low a ha (circleMap 0 1 θ) (h_sphere_in_Aζ _ (circleMap_mem_sphere 0 zero_le_one θ))
      rw [h_eq, div_eq_mul_inv]
      ring
    simp_rw [h_congr, intervalIntegral.integral_const_mul] at h_cauchy
    have h_cancel_I :
        (∫ θ in (0 : ℝ)..(2 * Real.pi),
          F (a, circleMap 0 1 θ) * circleMap 0 1 θ / (circleMap 0 1 θ - ζ)) =
        (2 * (Real.pi : ℂ)) * G_a ζ := by
      apply mul_left_cancel₀ Complex.I_ne_zero
      linear_combination h_cauchy
    dsimp [F_tilde, G_a] at *
    rw [h_cancel_I]
    have h2pi_ne : (2 * (Real.pi : ℂ)) ≠ 0 :=
      mul_ne_zero two_ne_zero (Complex.ofReal_ne_zero.mpr Real.pi_ne_zero)
    push_cast
    field_simp [h2pi_ne]

  have hJhat_low : ∀ a ∈ I_low, ∀ w ∈ Metric.ball (0 : ℂ) 1, J_hat (a, w) = 0 := by
    intro a ha w hw
    let G_a : ℂ → ℂ := fun z => S.𝔰 (Ψ (a, z))
    have hGa_holo : DifferentiableOn ℂ G_a (Metric.ball (0 : ℂ) (11 / 10)) := by
