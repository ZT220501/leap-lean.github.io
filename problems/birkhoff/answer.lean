        have hr_pos_k : 0 < r_jk j k := (hk_adm k hk_mem).2.1
        nlinarith [norm_nonneg (s - c_jkq)]
      rcases hk_adm k hk_mem with ⟨_, hr_pos_k, h_strip_k⟩
      have hdom_s : Φ s / (m0_seq j) ^ 2 ≤ maj (y_jk j k) (r_jk j k) x_jkq / (m0_seq j) ^ 2 :=
        div_le_div_of_nonneg_right
          (((hMaj (y_jk j k) (r_jk j k) hr_pos_k h_strip_k).2.2.1 x_jkq).2 s hs_ball)
