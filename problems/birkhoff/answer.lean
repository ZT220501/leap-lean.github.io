        ext v
        exact (div_mul_cancel₀ _ hD_nz).symm
      conv_lhs => rw [h_eq]
      exact h_homog_eval R P hR (fun v => ssbpcClearedJetEnv M E₀ E₁ A p q v / D_com) D_com
