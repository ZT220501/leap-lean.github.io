    have : (0 : ℝ) < 2 * Real.pi := by positivity
    have h2re : ((2 : ℂ) * (Real.pi : ℂ)).re = 2 * Real.pi := by simp
    rw [h2re] at h_im
    linarith
  
  have hs3_max : ∀ (G : ℂ → ℂ) (z₀ : ℂ) (M_bound : ℝ)
      (γ_bot σ_right γ_top σ_left : List ℂ),
      γ_bot ≠ [] → σ_right ≠ [] → γ_top ≠ [] → σ_left ≠ [] →
      DifferentiableOn ℂ G criticalLowerHalfPlane →
      z₀ ∈ criticalLowerHalfPlane →
      0 ≤ M_bound →
      meshPolyTrace γ_bot ⊆ criticalLowerHalfPlane →
      meshPolyTrace σ_right ⊆ criticalLowerHalfPlane →
      meshPolyTrace γ_top ⊆ criticalLowerHalfPlane →
      meshPolyTrace σ_left ⊆ criticalLowerHalfPlane →
      (∀ w ∈ meshPolyTrace γ_bot, w.im < z₀.im ∧ ‖G w‖ ≤ M_bound) →
      (∀ w ∈ meshPolyTrace σ_right, z₀.re < w.re ∧ ‖G w‖ ≤ M_bound) →
      (∀ w ∈ meshPolyTrace γ_top, z₀.im < w.im ∧ ‖G w‖ ≤ M_bound) →
      (∀ w ∈ meshPolyTrace σ_left, w.re < z₀.re ∧ ‖G w‖ ≤ M_bound) →
      (meshPolyTrace γ_bot ∩ meshPolyTrace σ_left).Nonempty →
      (meshPolyTrace γ_bot ∩ meshPolyTrace σ_right).Nonempty →
      (meshPolyTrace γ_top ∩ meshPolyTrace σ_right).Nonempty →
      (meshPolyTrace γ_top ∩ meshPolyTrace σ_left).Nonempty →
      ‖G z₀‖ ≤ M_bound := by
    intro G z₀ M_bound γ_bot σ_right γ_top σ_left h_bot h_right h_top h_left
      hG_holo hz₀ hM h_bot_sub h_right_sub h_top_sub h_left_sub
      h_bot_sep h_right_sep h_top_sep h_left_sep h_c0 h_c1 h_c2 h_c3
    have hH_open : IsOpen criticalLowerHalfPlane :=
      isOpen_lt Complex.continuous_im continuous_const
    have hH_conv : Convex ℝ criticalLowerHalfPlane := convex_halfSpace_im_lt 0
    have h_prefix_spec : ∀ (L : List ℂ) (hL : L ≠ []) (p : ℂ) (hp : p ∈ meshPolyTrace L),
        ∃ hP : mpwcPolyPrefixTo L hL p hp ≠ [],
          (mpwcPolyPrefixTo L hL p hp).head hP = L.head hL ∧
          (mpwcPolyPrefixTo L hL p hp).getLast hP = p ∧
          meshPolyTrace (mpwcPolyPrefixTo L hL p hp) ⊆ meshPolyTrace L := by
      intro L
      induction L with
      | nil => intro hL; exact absurd rfl hL
      | cons a tail ih =>
        cases tail with
        | nil =>
          intro _ p hp
          simp only [meshPolyTrace, Set.mem_singleton_iff] at hp
          subst hp
          exact ⟨List.cons_ne_nil p [], rfl, rfl, by simp [mpwcPolyPrefixTo, meshPolyTrace]⟩
        | cons b rest =>
          intro _ p hp
          simp only [mpwcPolyPrefixTo]
          split_ifs with hseg
          · refine ⟨List.cons_ne_nil a [p], rfl, rfl, ?_⟩
            have h_pair : meshPolyTrace [a, p] = segment ℝ a p := by
              simp only [meshPolyTrace, Set.union_singleton,
                Set.insert_eq_of_mem (right_mem_segment ℝ a p)]
            rw [h_pair]
            exact Subset.trans ((convex_segment a b).segment_subset (left_mem_segment ℝ a b) hseg)
              (fun w hw => Or.inl hw)
          · obtain ⟨hP_rest, h_hd, h_last, h_sub⟩ :=
              ih (List.cons_ne_nil b rest) p (hp.resolve_left hseg)
            obtain ⟨c, tail_P, hP_eq⟩ := List.exists_cons_of_ne_nil hP_rest
            have hc_eq : c = b := by
              have := h_hd
              simp only [hP_eq, List.head_cons] at this
              exact this
            refine ⟨List.cons_ne_nil a _, rfl, ?_, ?_⟩
            · rw [List.getLast_cons hP_rest]; exact h_last
            · intro w hw
              rw [hP_eq, hc_eq] at hw h_sub
              rcases hw with hw_ab | hw_rest
              · exact Or.inl hw_ab
              · exact Or.inr (h_sub hw_rest)
    have h_poly_lin : ∀ (L : List ℂ) (f g : ℂ → ℂ) (c : ℂ),
        ContinuousOn f (meshPolyTrace L) →
        ContinuousOn g (meshPolyTrace L) →
        mpwcPolyIntegral (fun w => f w - c * g w) L =
          mpwcPolyIntegral f L - c * mpwcPolyIntegral g L := by
      intro L f g c
      induction L with
      | nil => intro _ _; simp [mpwcPolyIntegral]
      | cons a tail ih =>
        cases tail with
        | nil => intro _ _; simp [mpwcPolyIntegral]
        | cons b rest =>
          intro hf hg
          let γ_seg : ℝ → ℂ := fun t => (1 - t) • a + t • b
          have hγ_mem : ∀ t ∈ Set.uIcc (0 : ℝ) 1, γ_seg t ∈ meshPolyTrace (a :: b :: rest) := by
            intro t ht
            rw [Set.uIcc_of_le zero_le_one] at ht
            exact Or.inl (by rw [segment_eq_image]; exact ⟨t, ht, rfl⟩)
          have h_int_f : IntervalIntegrable (fun t => (b - a) * f (γ_seg t))
