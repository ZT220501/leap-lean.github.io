            have huv_ext : ∀ uv ∈ Finset.HasAntidiagonal.antidiagonal d,
                (∑ ij ∈ Finset.HasAntidiagonal.antidiagonal n_deg,
                  PowerSeries.coeff ij.1 (MvPowerSeries.coeff uv.1 (pointArcCompConst2D1D φ W)) *
                    PowerSeries.coeff ij.2 (MvPowerSeries.coeff uv.2 (pointArcCompConst2D1D ψ W))) =
                ∑ b ∈ Finset.range (K_tot + 1), ∑ a ∈ Finset.range (K_tot + 1),
                  PowerSeries.coeff b φ * PowerSeries.coeff a ψ *
                    PowerSeries.coeff n_deg
                      (MvPowerSeries.coeff uv.1 (W ^ b) * MvPowerSeries.coeff uv.2 (W ^ a)) := by
              intro uv huv
              have huv_eq : uv.1 + uv.2 = d := Finset.HasAntidiagonal.mem_antidiagonal.mp huv
              have hd0 : uv.1 0 + uv.2 0 = d 0 := by rw [← huv_eq]; rfl
              have hd1 : uv.1 1 + uv.2 1 = d 1 := by rw [← huv_eq]; rfl
              have hij_ext : ∀ ij ∈ Finset.HasAntidiagonal.antidiagonal n_deg,
                  PowerSeries.coeff ij.1 (MvPowerSeries.coeff uv.1 (pointArcCompConst2D1D φ W)) *
                    PowerSeries.coeff ij.2 (MvPowerSeries.coeff uv.2 (pointArcCompConst2D1D ψ W)) =
                  ∑ b ∈ Finset.range (K_tot + 1), ∑ a ∈ Finset.range (K_tot + 1),
                    PowerSeries.coeff b φ * PowerSeries.coeff a ψ *
                      (PowerSeries.coeff ij.1 (MvPowerSeries.coeff uv.1 (W ^ b)) *
                        PowerSeries.coeff ij.2 (MvPowerSeries.coeff uv.2 (W ^ a))) := by
                intro ij hij
                have hij_eq : ij.1 + ij.2 = n_deg := Finset.HasAntidiagonal.mem_antidiagonal.mp hij
                rw [hC_eval φ uv.1 ij.1, hC_eval ψ uv.2 ij.2]
                have hs1 : (∑ b ∈ Finset.range (uv.1 0 + uv.1 1 + ij.1 + 1),
                    PowerSeries.coeff b φ *
                      PowerSeries.coeff ij.1 (MvPowerSeries.coeff uv.1 (W ^ b))) =
                    ∑ b ∈ Finset.range (K_tot + 1),
                      PowerSeries.coeff b φ *
                        PowerSeries.coeff ij.1 (MvPowerSeries.coeff uv.1 (W ^ b)) := by
                  have hsub1 : Finset.range (uv.1 0 + uv.1 1 + ij.1 + 1) ⊆
                      Finset.range (K_tot + 1) :=
                    Finset.range_mono (by omega)
                  rw [Finset.sum_subset hsub1]
                  intro b _ hb
                  have hgt : uv.1 0 + uv.1 1 + ij.1 < b := by
                    have := Finset.mem_range.not.mp hb; omega
                  rw [hVan2D1D_pow hW_van b uv.1 ij.1 hgt, mul_zero]
                have hs2 : (∑ a ∈ Finset.range (uv.2 0 + uv.2 1 + ij.2 + 1),
                    PowerSeries.coeff a ψ *
                      PowerSeries.coeff ij.2 (MvPowerSeries.coeff uv.2 (W ^ a))) =
                    ∑ a ∈ Finset.range (K_tot + 1),
                      PowerSeries.coeff a ψ *
                        PowerSeries.coeff ij.2 (MvPowerSeries.coeff uv.2 (W ^ a)) := by
                  have hsub2 : Finset.range (uv.2 0 + uv.2 1 + ij.2 + 1) ⊆
                      Finset.range (K_tot + 1) :=
                    Finset.range_mono (by omega)
                  rw [Finset.sum_subset hsub2]
                  intro a _ ha
                  have hgt : uv.2 0 + uv.2 1 + ij.2 < a := by
                    have := Finset.mem_range.not.mp ha; omega
                  rw [hVan2D1D_pow hW_van a uv.2 ij.2 hgt, mul_zero]
                rw [hs1, hs2, Finset.sum_mul]
                apply Finset.sum_congr rfl
                intro b _
                rw [Finset.mul_sum]
                exact Finset.sum_congr rfl fun a _ => by ring
              rw [Finset.sum_congr rfl hij_ext, Finset.sum_comm]
              apply Finset.sum_congr rfl
              intro b _
              rw [Finset.sum_comm]
              apply Finset.sum_congr rfl
              intro a _
              rw [← Finset.mul_sum, ← PowerSeries.coeff_mul]
            rw [Finset.sum_congr rfl huv_ext, Finset.sum_comm]
            apply Finset.sum_congr rfl
            intro b _
            rw [Finset.sum_comm]
            apply Finset.sum_congr rfl
            intro a _
            rw [← Finset.mul_sum, ← map_sum, ← MvPowerSeries.coeff_mul, ← pow_add]
          rw [hlhs, hrhs]
      
      have hEdge_match : ∀ i : Fin k,
          paJetT2D1D p₁ (fun q => PowerSeries.C (ℓ₀ i q) *
            pointArcPolyComp pointArcPsSqrt1p (pointArcPolyEdgeRel (fun j => ℓ₀ j q) F g
              (fun r => x₀ r q) (fun l r => β l r q) i)) =
          MvPowerSeries.C (PowerSeries.C (ℓ_star i)) *
            pointArcCompConst2D1D pointArcPsSqrt1p
              (pointArcFormalEdgeRel2D1D ℓ_star x_star f_seq β_seq i) ∧
          paJetT2D1D p₁ (fun q => pointArcPolyInvEdgeLen (fun j => ℓ₀ j q) F g
            (fun r => x₀ r q) (fun l r => β l r q) i) =
          pointArcFormalInvEdgeLen2D1D ℓ_star x_star f_seq β_seq i := by
        intro i
        let P_edge : (ℂ × ℂ) → PowerSeries ℂ := fun q =>
          PowerSeries.C (ℓ₀ i q) * pointArcPolyComp pointArcPsSqrt1p
            (pointArcPolyEdgeRel (fun j => ℓ₀ j q) F g (fun r => x₀ r q) (fun l r => β l r q) i)
        let P_inv : (ℂ × ℂ) → PowerSeries ℂ := fun q =>
          pointArcPolyInvEdgeLen (fun j => ℓ₀ j q) F g (fun r => x₀ r q) (fun l r => β l r q) i
        let M_i := paJetT2D1D p₁ P_edge
        let N_i := paJetT2D1D p₁ P_inv
        let Q_i := pointArcFormalEdgeSq2D1D x_star f_seq β_seq i
        let W_i := pointArcFormalEdgeRel2D1D ℓ_star x_star f_seq β_seq i
        let S_i := MvPowerSeries.C (PowerSeries.C (ℓ_star i)) *
          pointArcCompConst2D1D pointArcPsSqrt1p W_i
        let I_i := pointArcFormalInvEdgeLen2D1D ℓ_star x_star f_seq β_seq i
        have hU_c0 : ∀ q ∈ V, PowerSeries.coeff 0
            (pointArcPolyEdgeRel (fun j => ℓ₀ j q) F g
              (fun r => x₀ r q) (fun l r => β l r q) i) = 0 := by
          intro q hq
          have hgr0_q : ∀ v : Fin (k + 1),
              PowerSeries.coeff 0 (pointArcPolyGraph F g (fun r => x₀ r q)
                (fun l r => β l r q) v) = F (x₀ v q) := by
            intro v
            have hs0 : (∑ l : Fin (J + 1), PowerSeries.coeff 0
                (PowerSeries.X ^ (l : ℕ) * pointArcPolyComp
                  (pointArcHoloTaylor1D (g v l) (x₀ v q)) (S_v v q))) = 0 := by
              apply Finset.sum_eq_zero
              intro l _
              rw [PowerSeries.coeff_X_pow_mul']
              split_ifs with hl
              · have hl0 : l = 0 := Fin.ext (Nat.le_zero.mp hl)
                subst hl0
                simp [pointArcPolyComp, pointArcHoloTaylor1D, holoTaylor1D, hg0 v (x₀ v q)]
              · rfl
            rw [pointArcPolyGraph, map_add, map_sum, hs0, add_zero]
            simp [pointArcPolyComp, pointArcHoloTaylor1D, holoTaylor1D]
          have hdx0_q : PowerSeries.coeff 0
              (pointArcPolyDx (fun r => x₀ r q) (fun l r => β l r q) i) =
              x₀ i.succ q - x₀ i.castSucc q := by
            rw [pointArcPolyDx, map_add (PowerSeries.coeff 0), map_sub (PowerSeries.coeff 0),
              hSv_c0 i.succ q, hSv_c0 i.castSucc q, sub_zero, add_zero]
            simp [PowerSeries.coeff_C]
          have hdy0_q : PowerSeries.coeff 0
              (pointArcPolyDy F g (fun r => x₀ r q) (fun l r => β l r q) i) =
              F (x₀ i.succ q) - F (x₀ i.castSucc q) := by
            rw [pointArcPolyDy, map_sub, hgr0_q i.succ, hgr0_q i.castSucc]
          have hsq0_q : PowerSeries.coeff 0
              (pointArcPolyEdgeSq F g (fun r => x₀ r q) (fun l r => β l r q) i) =
              (ℓ₀ i q) ^ 2 := by
            rw [pointArcPolyEdgeSq, map_add, PowerSeries.coeff_zero_eq_constantCoeff,
              map_pow, map_pow, ← PowerSeries.coeff_zero_eq_constantCoeff,
              hdx0_q, hdy0_q, hℓ_sq q hq i, pointEdgeSq]
          rw [pointArcPolyEdgeRel, PowerSeries.coeff_zero_eq_constantCoeff, map_mul, map_sub,
            ← PowerSeries.coeff_zero_eq_constantCoeff, hsq0_q]
          simp
        have hP_laws : ∀ q ∈ V,
            (P_edge q) ^ 2 =
              pointArcPolyEdgeSq F g (fun r => x₀ r q) (fun l r => β l r q) i ∧
            P_edge q * P_inv q = 1 := by
          intro q hq
          have hhom := hPolyComp_hom (hU_c0 q hq)
          let U_q := pointArcPolyEdgeRel (fun j => ℓ₀ j q) F g
            (fun r => x₀ r q) (fun l r => β l r q) i
          have hne_q : ℓ₀ i q ≠ 0 := hℓ_ne q hq i
          have hne_sq : (ℓ₀ i q) ^ 2 ≠ 0 := pow_ne_zero 2 hne_q
          refine ⟨?_, ?_⟩
          · have hsq_ps : (pointArcPolyComp pointArcPsSqrt1p U_q) ^ 2 = 1 + U_q := by
              rw [sq, ← hhom.2.2.2, ← sq, hPsLaws.2.2.1, hhom.2.2.1, hhom.1, hhom.2.1]
            calc (P_edge q) ^ 2
                = PowerSeries.C ((ℓ₀ i q) ^ 2) * (pointArcPolyComp pointArcPsSqrt1p U_q) ^ 2 := by
                    dsimp only [P_edge]; rw [mul_pow, ← map_pow]
              _ = PowerSeries.C ((ℓ₀ i q) ^ 2) * (1 + U_q) := by rw [hsq_ps]
              _ = PowerSeries.C ((ℓ₀ i q) ^ 2) +
                    (pointArcPolyEdgeSq F g (fun r => x₀ r q) (fun l r => β l r q) i -
                      PowerSeries.C ((ℓ₀ i q) ^ 2)) *
                    PowerSeries.C (((ℓ₀ i q) ^ 2)⁻¹ * (ℓ₀ i q) ^ 2) := by
                    dsimp only [U_q, pointArcPolyEdgeRel]
                    rw [map_mul]
                    ring
              _ = pointArcPolyEdgeSq F g (fun r => x₀ r q) (fun l r => β l r q) i := by
                    rw [inv_mul_cancel₀ hne_sq, map_one, mul_one]; ring
          · have hpr_ps : pointArcPolyComp pointArcPsSqrt1p U_q *
                pointArcPolyComp pointArcPsInvSqrt1p U_q = 1 := by
              rw [← hhom.2.2.2, hPsLaws.2.2.2, hhom.1]
            calc P_edge q * P_inv q
                = PowerSeries.C (ℓ₀ i q * (ℓ₀ i q)⁻¹) *
                    (pointArcPolyComp pointArcPsSqrt1p U_q *
                      pointArcPolyComp pointArcPsInvSqrt1p U_q) := by
                    dsimp only [P_edge, P_inv, pointArcPolyInvEdgeLen]
                    rw [map_mul]
                    ring
              _ = 1 := by rw [mul_inv_cancel₀ hne_q, map_one, hpr_ps, mul_one]
        have hM_sq : M_i ^ 2 = Q_i := by
          dsimp only [M_i, Q_i]
          rw [← hT_pow (hph.2.2.2.2.2.2.1 i) 2, hT_congr fun q hq => (hP_laws q hq).1, hT_esq i]
        have hM_inv : M_i * N_i = 1 := by
          dsimp only [M_i, N_i]
          rw [← hT_mul (hph.2.2.2.2.2.2.1 i) (hph.2.2.2.2.2.2.2.1 i),
            hT_congr fun q hq => (hP_laws q hq).2, hT_const_ps 1, map_one]
        have hM_c00 : PowerSeries.coeff 0 (MvPowerSeries.coeff 0 M_i) = ℓ_star i := by
          have hP0 : ∀ q : ℂ × ℂ, PowerSeries.coeff 0 (P_edge q) = ℓ₀ i q := by
            intro q
            dsimp only [P_edge]
            rw [PowerSeries.coeff_C_mul]
            simp [pointArcPolyComp, PowerSeries.coeff_zero_eq_constantCoeff, hPsLaws.1]
          rw [hT_coeff, MvPowerSeries.coeff_apply]
          simp [hP0, taylor2D, iterDerivYT, iterDerivY, ℓ_star]
        
        have hQi_c00 : PowerSeries.coeff 0 (MvPowerSeries.coeff 0 Q_i) = (ℓ_star i) ^ 2 := by
          rw [← hM_sq, MvPowerSeries.coeff_zero_eq_constantCoeff, map_pow,
            PowerSeries.coeff_zero_eq_constantCoeff, map_pow,
            ← PowerSeries.coeff_zero_eq_constantCoeff,
            ← MvPowerSeries.coeff_zero_eq_constantCoeff, hM_c00]
        have hWi_van : paJetVanish2D1D 1 W_i := by
          apply hVan2D1D_one_iff
          dsimp only [W_i, pointArcFormalEdgeRel2D1D]
          rw [MvPowerSeries.coeff_zero_eq_constantCoeff, map_mul, map_sub,
            PowerSeries.coeff_zero_eq_constantCoeff, map_mul, map_sub,
            ← PowerSeries.coeff_zero_eq_constantCoeff,
            ← MvPowerSeries.coeff_zero_eq_constantCoeff, hQi_c00]
          simp
        have hWhom := hCompConst2D1D_hom hWi_van
        have hne_star : ℓ_star i ≠ 0 := hℓ_ne p₁ hp₁ i
        have hne_star_sq : (ℓ_star i) ^ 2 ≠ 0 := pow_ne_zero 2 hne_star
        have hS_sq : S_i ^ 2 = Q_i := by
          have hsq_w : (pointArcCompConst2D1D pointArcPsSqrt1p W_i) ^ 2 = 1 + W_i := by
            rw [sq, ← hWhom.2.2.2, ← sq, hPsLaws.2.2.1, hWhom.2.2.1, hWhom.1, hWhom.2.1]
          calc S_i ^ 2
              = MvPowerSeries.C (PowerSeries.C ((ℓ_star i) ^ 2)) *
                  (pointArcCompConst2D1D pointArcPsSqrt1p W_i) ^ 2 := by
                  dsimp only [S_i]; rw [mul_pow, ← map_pow, ← map_pow]
            _ = MvPowerSeries.C (PowerSeries.C ((ℓ_star i) ^ 2)) * (1 + W_i) := by rw [hsq_w]
            _ = MvPowerSeries.C (PowerSeries.C ((ℓ_star i) ^ 2)) +
                  (Q_i - MvPowerSeries.C (PowerSeries.C ((ℓ_star i) ^ 2))) *
                  MvPowerSeries.C (PowerSeries.C (((ℓ_star i) ^ 2)⁻¹ * (ℓ_star i) ^ 2)) := by
                  dsimp only [W_i, pointArcFormalEdgeRel2D1D]
                  rw [mul_add, mul_one, mul_comm (MvPowerSeries.C _), mul_assoc,
                    ← map_mul, ← map_mul]
            _ = Q_i := by
                  rw [inv_mul_cancel₀ hne_star_sq, map_one, map_one, mul_one, add_sub_cancel]
        have hS_inv : S_i * I_i = 1 := by
          have hpr_w : pointArcCompConst2D1D pointArcPsSqrt1p W_i *
              pointArcCompConst2D1D pointArcPsInvSqrt1p W_i = 1 := by
            rw [← hWhom.2.2.2, hPsLaws.2.2.2, hWhom.1]
          calc S_i * I_i
              = MvPowerSeries.C (PowerSeries.C (ℓ_star i * (ℓ_star i)⁻¹)) *
                  (pointArcCompConst2D1D pointArcPsSqrt1p W_i *
                    pointArcCompConst2D1D pointArcPsInvSqrt1p W_i) := by
                  dsimp only [S_i, I_i, pointArcFormalInvEdgeLen2D1D]
                  rw [mul_mul_mul_comm, ← map_mul, ← map_mul]
            _ = 1 := by rw [mul_inv_cancel₀ hne_star, map_one, map_one, hpr_w, mul_one]
        have hS_c00 : PowerSeries.coeff 0 (MvPowerSeries.coeff 0 S_i) = ℓ_star i := by
          dsimp only [S_i]
          rw [MvPowerSeries.coeff_C_mul, PowerSeries.coeff_C_mul,
            pointArcCompConst2D1D, hComp2D1D_coeff]
          have h00 : (0 : Fin 2 →₀ ℕ) 0 + (0 : Fin 2 →₀ ℕ) 1 + 0 + 1 = 1 := rfl
          rw [h00, Finset.range_one, Finset.sum_singleton, pow_zero, mul_one,
            MvPowerSeries.coeff_C, if_pos rfl, PowerSeries.coeff_mk, if_pos rfl,
            PowerSeries.coeff_zero_eq_constantCoeff, hPsLaws.1, mul_one]
        have hprod_zero : (M_i - S_i) * (M_i + S_i) = 0 := by
          calc (M_i - S_i) * (M_i + S_i)
              = M_i ^ 2 - S_i ^ 2 := by rw [mul_comm, ← sq_sub_sq]
            _ = Q_i - Q_i := by rw [hM_sq, hS_sq]
            _ = 0 := sub_self Q_i
        have hUnit_sum : IsUnit (M_i + S_i) := by
          rw [@MvPowerSeries.isUnit_iff_constantCoeff (Fin 2) (PowerSeries ℂ) _,
            PowerSeries.isUnit_iff_constantCoeff, isUnit_iff_ne_zero,
            ← MvPowerSeries.coeff_zero_eq_constantCoeff,
            ← PowerSeries.coeff_zero_eq_constantCoeff,
            map_add, map_add, hM_c00, hS_c00]
          have h2 : ℓ_star i + ℓ_star i = 2 * ℓ_star i := by ring
          rw [h2]
          exact mul_ne_zero two_ne_zero hne_star
        have hMS : M_i = S_i := sub_eq_zero.mp (hUnit_sum.mul_left_eq_zero.mp hprod_zero)
        have hNI : N_i = I_i := by
          calc N_i = N_i * 1 := (mul_one N_i).symm
            _ = N_i * (S_i * I_i) := by rw [← hS_inv]
            _ = (M_i * N_i) * I_i := by rw [← hMS, ← mul_assoc, mul_comm N_i M_i]
            _ = 1 * I_i := by rw [hM_inv]
            _ = I_i := one_mul I_i
        exact ⟨hMS, hNI⟩
      
      refine ⟨?_, ?_⟩
      · have hcongr : taylor2D
            (fun q => pointArcEpsJet m
              (fun ε => pointRelChainLen (fun i => ℓ₀ i q) (pointArcPertGraph F g ε)
                (pointArcPertAbscissa (fun r => x₀ r q) (fun l r => β l r q) ε))) p₁ =
            taylor2D
              (fun q => PowerSeries.coeff m
                (pointArcPolyLen (fun i => ℓ₀ i q) F g
                  (fun r => x₀ r q) (fun l r => β l r q))) p₁ :=
          hLC.taylor2D_congr hV hp₁ fun q hq =>
            (hEval_poly m hW hF hg hg0 (hℓ_ne q hq) (hx_maps q hq) (hℓ_sq q hq)
              fun s => hβ0 s q).1
        rw [hcongr, ← hT_slice]
        refine congr_arg (pointArcSlice2D1D m) ?_
        dsimp only [pointArcPolyLen, pointArcFormalLen2D1D]
        rw [hT_sum (Finset.univ : Finset (Fin k))
          (fun i q => PowerSeries.C (ℓ₀ i q) *
            pointArcPolyComp pointArcPsSqrt1p (pointArcPolyEdgeRel (fun j => ℓ₀ j q) F g
              (fun r => x₀ r q) (fun l r => β l r q) i))
          fun i _ => hph.2.2.2.2.2.2.1 i]
        exact Finset.sum_congr rfl fun i _ => (hEdge_match i).1
      · intro r
        have hcongr : taylor2D
            (fun q => pointArcEpsJet m
              (fun ε => pointRelInteriorGrad (fun i => ℓ₀ i q) (pointArcPertGraph F g ε)
                (pointArcPertGraphDeriv F g ε)
                (pointArcPertAbscissa (fun r => x₀ r q) (fun l r => β l r q) ε) r)) p₁ =
            taylor2D
              (fun q => PowerSeries.coeff m
                (pointArcPolyGrad (fun i => ℓ₀ i q) F g
                  (fun r => x₀ r q) (fun l r => β l r q) r)) p₁ :=
          hLC.taylor2D_congr hV hp₁ fun q hq =>
            (hEval_poly m hW hF hg hg0 (hℓ_ne q hq) (hx_maps q hq) (hℓ_sq q hq)
              fun s => hβ0 s q).2 r
        rw [hcongr, ← hT_slice]
        refine congr_arg (pointArcSlice2D1D m) ?_
        let i_L : Fin k := ⟨r.1, by have := r.2; omega⟩
        let i_R : Fin k := ⟨r.1 + 1, by have := r.2; omega⟩
        dsimp only [pointArcPolyGrad, pointArcFormalGrad2D1D, i_L, i_R]
        rw [hT_sub
            (hPsHolo_mul (hPsHolo_add (hph.2.2.1 i_L) (hPsHolo_mul (hph.2.2.2.1 i_L) (hph.2.1 i_L.succ)))
              (hph.2.2.2.2.2.2.2.1 i_L))
            (hPsHolo_mul (hPsHolo_add (hph.2.2.1 i_R) (hPsHolo_mul (hph.2.2.2.1 i_R) (hph.2.1 i_R.castSucc)))
              (hph.2.2.2.2.2.2.2.1 i_R)),
          hT_mul (hPsHolo_add (hph.2.2.1 i_L) (hPsHolo_mul (hph.2.2.2.1 i_L) (hph.2.1 i_L.succ)))
            (hph.2.2.2.2.2.2.2.1 i_L),
          hT_mul (hPsHolo_add (hph.2.2.1 i_R) (hPsHolo_mul (hph.2.2.2.1 i_R) (hph.2.1 i_R.castSucc)))
            (hph.2.2.2.2.2.2.2.1 i_R),
          hT_add (hph.2.2.1 i_L) (hPsHolo_mul (hph.2.2.2.1 i_L) (hph.2.1 i_L.succ)),
          hT_add (hph.2.2.1 i_R) (hPsHolo_mul (hph.2.2.2.1 i_R) (hph.2.1 i_R.castSucc)),
          hT_mul (hph.2.2.2.1 i_L) (hph.2.1 i_L.succ),
          hT_mul (hph.2.2.2.1 i_R) (hph.2.1 i_R.castSucc),
          hT_dx i_L, hT_dx i_R, hT_dy i_L, hT_dy i_R,
          hT_graphDeriv i_L.succ, hT_graphDeriv i_R.castSucc,
          (hEdge_match i_L).2, (hEdge_match i_R).2]
  }

theorem point_arc_formal_recentered_system (Ω : Set Plane)
    (C : AnalyticGlancingCollar Ω)
    (B : BaseCollarAndCramerData C)
    (k : ℕ) (hk : 2 ≤ k)
    (G : PointGlancingChartData C B k)
    (a₁ δ₁ : ℝ)
    (ha₁ : a₁ ∈ Set.Ioo (G.a₀ - G.R / 4) (G.a₀ + G.R / 4))
    (hδ₁ : δ₁ ∈ Set.Ioo 0 G.δ_star)
    (E : PointCoreEliminationData C B k G a₁ δ₁)
    (hAlg : AlgebraicLiftingToolkit)
    (hJet : PointArcJetAndTaylorToolkit)
    (hNonAlg : ∃ r : Fin E.N_core, ¬ IsAlgebraic (↥(pointBaseField C k G.Ψ a₁ δ₁)) (E.coreTuple r)) :
    Nonempty (PointArcFormalDeformationData C B k G a₁ δ₁) :=
by
  have hLaws : PointRecPsSqrtLawsProp := hJet.psSqrt1p_laws
  have hSqrt : PointRecSqrtSplitToolkit := by
    clear Ω C B k hk G a₁ δ₁ ha₁ hδ₁ E hAlg hJet hNonAlg
    rcases hLaws with ⟨hS0, hI0, hS_sq, hSI⟩
    let S := pointArcPsSqrt1p
    let I := pointArcPsInvSqrt1p
    have hIS : I * S = 1 := mul_comm S I ▸ hSI
    have hd_pair : PowerSeries.derivative S = PowerSeries.C (1 / 2 : ℂ) * I ∧
        PowerSeries.derivative I = PowerSeries.C (-1 / 2 : ℂ) * I ^ 3 := by
      have hSS : S * S = 1 + PowerSeries.X := by simpa [S, sq] using hS_sq
      have hdSS := congr_arg (fun f : PowerSeries ℂ => PowerSeries.derivative f) hSS
      rw [Derivation.leibniz, map_add, PowerSeries.derivative_one, PowerSeries.derivative_X,
        zero_add] at hdSS
      simp only [smul_eq_mul] at hdSS
      have hc2 : PowerSeries.C (1 / 2 : ℂ) + PowerSeries.C (1 / 2 : ℂ) = 1 := by
        rw [← map_add]; norm_num
      have hdS : PowerSeries.derivative S = PowerSeries.C (1 / 2 : ℂ) * I := by
        calc PowerSeries.derivative S
            = (PowerSeries.C (1 / 2 : ℂ) + PowerSeries.C (1 / 2 : ℂ)) *
                (I * S) * PowerSeries.derivative S := by
                rw [hc2, hIS, one_mul, one_mul]
          _ = PowerSeries.C (1 / 2 : ℂ) * I *
                (S * PowerSeries.derivative S + S * PowerSeries.derivative S) := by ring
          _ = PowerSeries.C (1 / 2 : ℂ) * I * 1 := by rw [hdSS]
          _ = PowerSeries.C (1 / 2 : ℂ) * I := mul_one _
      have hdSI : PowerSeries.derivative (S * I) = PowerSeries.derivative (1 : PowerSeries ℂ) :=
        congr_arg (fun f : PowerSeries ℂ => PowerSeries.derivative f) hSI
      rw [Derivation.leibniz, PowerSeries.derivative_one] at hdSI
      simp only [smul_eq_mul] at hdSI
      have hc_neg : -PowerSeries.C (1 / 2 : ℂ) = PowerSeries.C (-1 / 2 : ℂ) := by
        rw [← map_neg]; norm_num
      have hdI : PowerSeries.derivative I = PowerSeries.C (-1 / 2 : ℂ) * I ^ 3 := by
        calc PowerSeries.derivative I
            = (I * S) * PowerSeries.derivative I := by rw [hIS, one_mul]
          _ = I * (S * PowerSeries.derivative I + I * PowerSeries.derivative S) -
                I ^ 2 * PowerSeries.derivative S := by ring
          _ = I * 0 - I ^ 2 * (PowerSeries.C (1 / 2 : ℂ) * I) := by rw [hdSI, hdS]
          _ = (-PowerSeries.C (1 / 2 : ℂ)) * I ^ 3 := by ring
          _ = PowerSeries.C (-1 / 2 : ℂ) * I ^ 3 := by rw [hc_neg]
      exact ⟨hdS, hdI⟩
    let VanishesBelow : ℕ → MvPowerSeries (Fin 2) (PowerSeries ℂ) → Prop :=
      fun k Z => ∀ (d : Fin 2 →₀ ℕ) (m : ℕ), d 0 + d 1 + m < k →
        PowerSeries.coeff m (MvPowerSeries.coeff d Z) = 0
    have hVB_one : ∀ {Z : MvPowerSeries (Fin 2) (PowerSeries ℂ)},
        PowerSeries.coeff 0 (MvPowerSeries.coeff 0 Z) = 0 → VanishesBelow 1 Z := by
      intro Z hZ0 d m hlt
      have hd0 : d 0 = 0 := by omega
      have hd1 : d 1 = 0 := by omega
      have hm0 : m = 0 := by omega
      have hd_eq : d = 0 := by
        ext i
        fin_cases i
        · exact hd0
        · exact hd1
      subst hd_eq hm0
      exact hZ0
    have hVB_mul : ∀ {a b : ℕ} {X Y : MvPowerSeries (Fin 2) (PowerSeries ℂ)},
        VanishesBelow a X → VanishesBelow b Y → VanishesBelow (a + b) (X * Y) := by
      intro a b X Y hX hY d m hlt
      rw [MvPowerSeries.coeff_mul, map_sum]
      apply Finset.sum_eq_zero
      intro p hp
      have hp_eq : p.1 + p.2 = d := Finset.HasAntidiagonal.mem_antidiagonal.mp hp
      have hp0 : p.1 0 + p.2 0 = d 0 := by rw [← Finsupp.add_apply, hp_eq]
      have hp1 : p.1 1 + p.2 1 = d 1 := by rw [← Finsupp.add_apply, hp_eq]
      rw [PowerSeries.coeff_mul]
      apply Finset.sum_eq_zero
      intro q hq
      have hq_eq : q.1 + q.2 = m := Finset.HasAntidiagonal.mem_antidiagonal.mp hq
      by_cases h1 : p.1 0 + p.1 1 + q.1 < a
      · rw [hX p.1 q.1 h1, zero_mul]
      · have h2 : p.2 0 + p.2 1 + q.2 < b := by omega
        rw [hY p.2 q.2 h2, mul_zero]
    have hVB_pow : ∀ {Z : MvPowerSeries (Fin 2) (PowerSeries ℂ)},
        VanishesBelow 1 Z → ∀ n : ℕ, VanishesBelow n (Z ^ n) := by
      intro Z hZ n
      induction n with
      | zero => intro d m hlt; omega
      | succ n ih =>
          rw [pow_succ]
          exact hVB_mul ih hZ
    have hmk_const : ∀ (φ : PowerSeries ℂ) (n : ℕ),
        PowerSeries.mk (fun l => PowerSeries.coeff n (if l = 0 then φ else 0)) =
          PowerSeries.C (PowerSeries.coeff n φ) := by
      intro φ n
      ext l
      rw [PowerSeries.coeff_mk, PowerSeries.coeff_C]
      split_ifs <;> simp
    have hComp_trunc : ∀ (φ : PowerSeries ℂ) {Z : MvPowerSeries (Fin 2) (PowerSeries ℂ)},
        VanishesBelow 1 Z → ∀ (d : Fin 2 →₀ ℕ) (m M : ℕ), d 0 + d 1 + m ≤ M →
        PowerSeries.coeff m (MvPowerSeries.coeff d (pointArcCompConst2D1D φ Z)) =
          PowerSeries.coeff m (MvPowerSeries.coeff d
            (∑ n ∈ Finset.range (M + 1),
              MvPowerSeries.C (PowerSeries.C (PowerSeries.coeff n φ)) * Z ^ n)) := by
      intro φ Z hZ d m M hle
      have hdef : MvPowerSeries.coeff d (pointArcCompConst2D1D φ Z) =
          PowerSeries.mk (fun m' =>
            PowerSeries.coeff m'
              (MvPowerSeries.coeff d
                (∑ n ∈ Finset.range (d 0 + d 1 + m' + 1),
                  MvPowerSeries.C (PowerSeries.mk (fun l =>
                    PowerSeries.coeff n (if l = 0 then φ else 0))) * Z ^ n))) := rfl
      rw [hdef, PowerSeries.coeff_mk]
      simp_rw [hmk_const]
      rw [map_sum, map_sum, map_sum, map_sum]
      refine Finset.sum_subset (Finset.range_mono (by omega)) ?_
      intro n hnM hndm
      rw [Finset.mem_range] at hndm
      have hlt : d 0 + d 1 + m < n := by omega
      rw [MvPowerSeries.coeff_C_mul, PowerSeries.coeff_C_mul, hVB_pow hZ n d m hlt, mul_zero]
    have hComp_C : ∀ (c : ℂ) {Z : MvPowerSeries (Fin 2) (PowerSeries ℂ)},
        VanishesBelow 1 Z →
        pointArcCompConst2D1D (PowerSeries.C c) Z = MvPowerSeries.C (PowerSeries.C c) := by
      intro c Z hZ
      ext d m
      rw [hComp_trunc (PowerSeries.C c) hZ d m (d 0 + d 1 + m) le_rfl, map_sum, map_sum]
      rw [Finset.sum_eq_single 0]
      · simp [MvPowerSeries.coeff_C]
      · intro n _ hn0
        rw [PowerSeries.coeff_C, ite_eq_right_iff.mpr (fun h => False.elim (hn0 h)),
          map_zero, map_zero, zero_mul, map_zero, map_zero]
      · intro h0
        exact False.elim (h0 (Finset.mem_range.mpr (by omega)))
    have hComp_X : ∀ {Z : MvPowerSeries (Fin 2) (PowerSeries ℂ)},
        VanishesBelow 1 Z → pointArcCompConst2D1D PowerSeries.X Z = Z := by
      intro Z hZ
      ext d m
      rw [hComp_trunc PowerSeries.X hZ d m (d 0 + d 1 + m + 1) (by omega), map_sum, map_sum]
      rw [Finset.sum_eq_single 1]
      · simp
      · intro n _ hn1
        rw [PowerSeries.coeff_X, ite_eq_right_iff.mpr (fun h => False.elim (hn1 h)),
          map_zero, map_zero, zero_mul, map_zero, map_zero]
      · intro h1
        exact False.elim (h1 (Finset.mem_range.mpr (by omega)))
    have hComp_add : ∀ (φ₁ φ₂ : PowerSeries ℂ) {Z : MvPowerSeries (Fin 2) (PowerSeries ℂ)},
        VanishesBelow 1 Z →
        pointArcCompConst2D1D (φ₁ + φ₂) Z =
          pointArcCompConst2D1D φ₁ Z + pointArcCompConst2D1D φ₂ Z := by
      intro φ₁ φ₂ Z hZ
      ext d m
      rw [map_add, map_add,
        hComp_trunc (φ₁ + φ₂) hZ d m (d 0 + d 1 + m) le_rfl,
        hComp_trunc φ₁ hZ d m (d 0 + d 1 + m) le_rfl,
        hComp_trunc φ₂ hZ d m (d 0 + d 1 + m) le_rfl,
        ← map_add (PowerSeries.coeff m), ← map_add (MvPowerSeries.coeff d),
        ← Finset.sum_add_distrib]
      apply congr_arg (PowerSeries.coeff m)
      apply congr_arg (MvPowerSeries.coeff d)
      apply Finset.sum_congr rfl
      intro n _
      rw [map_add, map_add, map_add, add_mul]
    have hComp_mul : ∀ (φ₁ φ₂ : PowerSeries ℂ) {Z : MvPowerSeries (Fin 2) (PowerSeries ℂ)},
        VanishesBelow 1 Z →
        pointArcCompConst2D1D (φ₁ * φ₂) Z =
          pointArcCompConst2D1D φ₁ Z * pointArcCompConst2D1D φ₂ Z := by
      intro φ₁ φ₂ Z hZ
      ext d m
      let N := d 0 + d 1 + m
      let P : PowerSeries ℂ → MvPowerSeries (Fin 2) (PowerSeries ℂ) := fun φ =>
        ∑ n ∈ Finset.range (N + 1), MvPowerSeries.C (PowerSeries.C (PowerSeries.coeff n φ)) * Z ^ n
      have hmul_eq : PowerSeries.coeff m (MvPowerSeries.coeff d
          (pointArcCompConst2D1D φ₁ Z * pointArcCompConst2D1D φ₂ Z)) =
          PowerSeries.coeff m (MvPowerSeries.coeff d (P φ₁ * P φ₂)) := by
        rw [MvPowerSeries.coeff_mul, MvPowerSeries.coeff_mul, map_sum, map_sum]
        apply Finset.sum_congr rfl
        intro p hp
        have hp_eq : p.1 + p.2 = d := Finset.HasAntidiagonal.mem_antidiagonal.mp hp
        have hp0 : p.1 0 + p.2 0 = d 0 := by rw [← Finsupp.add_apply, hp_eq]
        have hp1 : p.1 1 + p.2 1 = d 1 := by rw [← Finsupp.add_apply, hp_eq]
        rw [PowerSeries.coeff_mul, PowerSeries.coeff_mul]
        apply Finset.sum_congr rfl
        intro q hq
        have hq_eq : q.1 + q.2 = m := Finset.HasAntidiagonal.mem_antidiagonal.mp hq
        rw [hComp_trunc φ₁ hZ p.1 q.1 N (by omega), hComp_trunc φ₂ hZ p.2 q.2 N (by omega)]
      rw [hmul_eq, hComp_trunc (φ₁ * φ₂) hZ d m N le_rfl]
      dsimp only [P]
      rw [Finset.sum_mul]
      simp only [Finset.mul_sum]
      let term : ℕ → ℕ → ℂ := fun a b =>
        PowerSeries.coeff m (MvPowerSeries.coeff d
          (MvPowerSeries.C (PowerSeries.C (PowerSeries.coeff a φ₁ * PowerSeries.coeff b φ₂)) *
            Z ^ (a + b)))
      have hprod_term : ∀ a b : ℕ,
          (MvPowerSeries.C (PowerSeries.C (PowerSeries.coeff a φ₁)) * Z ^ a) *
            (MvPowerSeries.C (PowerSeries.C (PowerSeries.coeff b φ₂)) * Z ^ b) =
          MvPowerSeries.C (PowerSeries.C (PowerSeries.coeff a φ₁ * PowerSeries.coeff b φ₂)) *
            Z ^ (a + b) := by
        intro a b
        rw [pow_add, map_mul, map_mul]
        ring
      simp_rw [hprod_term]
      rw [map_sum, map_sum, map_sum, map_sum]
      simp_rw [map_sum]
      change (∑ n ∈ Finset.range (N + 1),
          PowerSeries.coeff m (MvPowerSeries.coeff d
            (MvPowerSeries.C (PowerSeries.C (PowerSeries.coeff n (φ₁ * φ₂))) * Z ^ n))) =
        ∑ a ∈ Finset.range (N + 1), ∑ b ∈ Finset.range (N + 1), term a b
      have hkill_gt : ∀ a b : ℕ, N < a + b → term a b = 0 := by
        intro a b hgt
        dsimp only [term]
        rw [MvPowerSeries.coeff_C_mul, PowerSeries.coeff_C_mul,
          hVB_pow hZ (a + b) d m hgt, mul_zero]
      have hrhs : (∑ a ∈ Finset.range (N + 1), ∑ b ∈ Finset.range (N + 1), term a b) =
          ∑ n ∈ Finset.range (N + 1), ∑ a ∈ Finset.range (n + 1), term a (n - a) := by
        have h1 : ∀ a ∈ Finset.range (N + 1), ∀ b ∈ Finset.range (N + 1),
            term a b = ∑ n ∈ Finset.range (N + 1), if n = a + b then term a b else 0 := by
          intro a _ b _
          rw [Finset.sum_ite_eq']
          split_ifs with hmem
          · rfl
          · rw [Finset.mem_range] at hmem
            exact hkill_gt a b (by omega)
        calc (∑ a ∈ Finset.range (N + 1), ∑ b ∈ Finset.range (N + 1), term a b)
            = ∑ a ∈ Finset.range (N + 1), ∑ b ∈ Finset.range (N + 1),
                ∑ n ∈ Finset.range (N + 1), if n = a + b then term a b else 0 := by
              apply Finset.sum_congr rfl; intro a ha
              apply Finset.sum_congr rfl; intro b hb
              exact h1 a ha b hb
          _ = ∑ a ∈ Finset.range (N + 1), ∑ n ∈ Finset.range (N + 1),
                ∑ b ∈ Finset.range (N + 1), if n = a + b then term a b else 0 := by
              apply Finset.sum_congr rfl; intro a _
              exact Finset.sum_comm
          _ = ∑ n ∈ Finset.range (N + 1), ∑ a ∈ Finset.range (N + 1),
                ∑ b ∈ Finset.range (N + 1), if n = a + b then term a b else 0 := Finset.sum_comm
          _ = ∑ n ∈ Finset.range (N + 1), ∑ a ∈ Finset.range (n + 1), term a (n - a) := by
              apply Finset.sum_congr rfl
              intro n hn
              have hn_le : n ≤ N := Nat.lt_succ_iff.mp (Finset.mem_range.mp hn)
              have hinner : ∀ a ∈ Finset.range (N + 1),
                  (∑ b ∈ Finset.range (N + 1), if n = a + b then term a b else 0) =
                    if a ≤ n then term a (n - a) else 0 := by
                intro a _
                split_ifs with han
                · rw [Finset.sum_eq_single (n - a)]
                  · rw [ite_cond_eq_true _ _ (eq_true (by omega))]
                  · intro b _ hne
                    rw [ite_cond_eq_false _ _ (eq_false (by omega))]
                  · intro hnot
                    exact False.elim (hnot (Finset.mem_range.mpr (by omega)))
                · apply Finset.sum_eq_zero
                  intro b _
                  rw [ite_cond_eq_false _ _ (eq_false (by omega))]
              rw [Finset.sum_congr rfl hinner, ← Finset.sum_filter]
              have hfilt : (Finset.range (N + 1)).filter (fun a => a ≤ n) = Finset.range (n + 1) := by
                ext a
                simp only [Finset.mem_filter, Finset.mem_range]
                omega
              rw [hfilt]
      rw [hrhs]
      apply Finset.sum_congr rfl
      intro n _
      have hcoeff_mul_range :
          PowerSeries.coeff n (φ₁ * φ₂) =
            ∑ a ∈ Finset.range (n + 1),
              PowerSeries.coeff a φ₁ * PowerSeries.coeff (n - a) φ₂ := by
        rw [PowerSeries.coeff_mul]
        exact Finset.Nat.sum_antidiagonal_eq_sum_range_succ
          (fun a b => PowerSeries.coeff a φ₁ * PowerSeries.coeff b φ₂) n
      rw [hcoeff_mul_range, MvPowerSeries.coeff_C_mul, PowerSeries.coeff_C_mul, Finset.sum_mul]
      apply Finset.sum_congr rfl
      intro a ha
      have han : a + (n - a) = n := by
        have := Finset.mem_range.mp ha
        omega
      dsimp only [term]
      rw [han, MvPowerSeries.coeff_C_mul, PowerSeries.coeff_C_mul]
    have hUnit2D1D : ∀ (ℓ_star : ℂ) (Q L L_inv : MvPowerSeries (Fin 2) (PowerSeries ℂ)),
        ℓ_star ≠ 0 →
        L ^ 2 = Q →
        L_inv * L = 1 →
        PowerSeries.constantCoeff (MvPowerSeries.coeff 0 L) = ℓ_star →
        let U := (Q - MvPowerSeries.C (PowerSeries.C (ℓ_star ^ 2))) *
          MvPowerSeries.C (PowerSeries.C ((ℓ_star ^ 2)⁻¹))
        PowerSeries.coeff 0 (MvPowerSeries.coeff 0 U) = 0 ∧
        L = MvPowerSeries.C (PowerSeries.C ℓ_star) * pointArcCompConst2D1D S U ∧
        L_inv = MvPowerSeries.C (PowerSeries.C ℓ_star⁻¹) * pointArcCompConst2D1D I U := by
      intro ℓ_star Q L L_inv hℓ_ne hL_sq hL_inv hL0 U
      have hQ0 : PowerSeries.constantCoeff (MvPowerSeries.coeff 0 Q) = ℓ_star ^ 2 := by
        rw [← hL_sq, sq, MvPowerSeries.coeff_zero_eq_constantCoeff, map_mul, map_mul,
          ← MvPowerSeries.coeff_zero_eq_constantCoeff, hL0, sq]
      have hU0 : PowerSeries.coeff 0 (MvPowerSeries.coeff 0 U) = 0 := by
        dsimp only [U]
        rw [PowerSeries.coeff_zero_eq_constantCoeff, MvPowerSeries.coeff_zero_eq_constantCoeff,
          map_mul, map_sub, MvPowerSeries.constantCoeff_C, MvPowerSeries.constantCoeff_C,
          map_mul, map_sub, PowerSeries.constantCoeff_C, PowerSeries.constantCoeff_C,
          ← MvPowerSeries.coeff_zero_eq_constantCoeff, hQ0, sub_self, zero_mul]
      have hVB_U : VanishesBelow 1 U := hVB_one hU0
      let S_U := MvPowerSeries.C (PowerSeries.C ℓ_star) * pointArcCompConst2D1D S U
      let I_U := MvPowerSeries.C (PowerSeries.C ℓ_star⁻¹) * pointArcCompConst2D1D I U
      have hℓ2_ne : ℓ_star ^ 2 ≠ 0 := pow_ne_zero 2 hℓ_ne
      have h1_eq : (1 : PowerSeries ℂ) = PowerSeries.C 1 := (map_one PowerSeries.C).symm
      have hSU_sq : S_U ^ 2 = Q := by
        have hC_sq : (MvPowerSeries.C (PowerSeries.C ℓ_star) :
            MvPowerSeries (Fin 2) (PowerSeries ℂ)) * MvPowerSeries.C (PowerSeries.C ℓ_star) =
            MvPowerSeries.C (PowerSeries.C (ℓ_star ^ 2)) := by
          rw [← map_mul, ← map_mul, ← sq]
        calc S_U ^ 2
            = (MvPowerSeries.C (PowerSeries.C ℓ_star) * MvPowerSeries.C (PowerSeries.C ℓ_star)) *
                (pointArcCompConst2D1D S U * pointArcCompConst2D1D S U) := by
                dsimp only [S_U]; ring
          _ = MvPowerSeries.C (PowerSeries.C (ℓ_star ^ 2)) *
                pointArcCompConst2D1D (S ^ 2) U := by
                rw [hC_sq, ← hComp_mul S S hVB_U, ← sq]
          _ = MvPowerSeries.C (PowerSeries.C (ℓ_star ^ 2)) * (1 + U) := by
                rw [hS_sq, h1_eq, hComp_add _ _ hVB_U, hComp_C 1 hVB_U, hComp_X hVB_U,
                  map_one, map_one]
          _ = Q := by
                dsimp only [U]
                have h_inv_cancel :
                    (MvPowerSeries.C (PowerSeries.C (ℓ_star ^ 2)) :
                      MvPowerSeries (Fin 2) (PowerSeries ℂ)) *
                      MvPowerSeries.C (PowerSeries.C ((ℓ_star ^ 2)⁻¹)) = 1 := by
                  rw [← map_mul, ← map_mul, mul_inv_cancel₀ hℓ2_ne, map_one, map_one]
                calc MvPowerSeries.C (PowerSeries.C (ℓ_star ^ 2)) *
                      (1 + (Q - MvPowerSeries.C (PowerSeries.C (ℓ_star ^ 2))) *
                        MvPowerSeries.C (PowerSeries.C ((ℓ_star ^ 2)⁻¹)))
                    = MvPowerSeries.C (PowerSeries.C (ℓ_star ^ 2)) +
                        (Q - MvPowerSeries.C (PowerSeries.C (ℓ_star ^ 2))) *
                          (MvPowerSeries.C (PowerSeries.C (ℓ_star ^ 2)) *
                            MvPowerSeries.C (PowerSeries.C ((ℓ_star ^ 2)⁻¹))) := by ring
                  _ = Q := by rw [h_inv_cancel]; ring
      have hSUIU : S_U * I_U = 1 := by
        calc S_U * I_U
            = (MvPowerSeries.C (PowerSeries.C ℓ_star) *
                MvPowerSeries.C (PowerSeries.C ℓ_star⁻¹)) *
              (pointArcCompConst2D1D S U * pointArcCompConst2D1D I U) := by
                dsimp only [S_U, I_U]; ring
          _ = 1 * pointArcCompConst2D1D (S * I) U := by
                rw [← map_mul, ← map_mul, mul_inv_cancel₀ hℓ_ne, map_one, map_one,
                  ← hComp_mul S I hVB_U]
          _ = 1 := by
                rw [one_mul, hSI, h1_eq, hComp_C 1 hVB_U, map_one, map_one]
      have hSU_0 : PowerSeries.constantCoeff (MvPowerSeries.coeff 0 S_U) = ℓ_star := by
        dsimp only [S_U]
        rw [MvPowerSeries.coeff_C_mul, map_mul, PowerSeries.constantCoeff_C,
          ← PowerSeries.coeff_zero_eq_constantCoeff, hComp_trunc S hVB_U 0 0 0 (by simp),
          Finset.range_one, Finset.sum_singleton, pow_zero, mul_one,
          MvPowerSeries.coeff_C, ite_cond_eq_true _ _ (eq_true rfl),
          PowerSeries.coeff_C, ite_cond_eq_true _ _ (eq_true rfl),
          PowerSeries.coeff_zero_eq_constantCoeff, hS0, mul_one]
      have h_unit : IsUnit (L + S_U) := by
        rw [MvPowerSeries.isUnit_iff_constantCoeff, PowerSeries.isUnit_iff_constantCoeff,
          isUnit_iff_ne_zero, ← MvPowerSeries.coeff_zero_eq_constantCoeff,
          map_add, map_add, hL0, hSU_0]
        exact mul_ne_zero two_ne_zero hℓ_ne |> fun h => by simpa [two_mul] using h
      have h_diff_mul : (L - S_U) * (L + S_U) = 0 := by
        calc (L - S_U) * (L + S_U) = L ^ 2 - S_U ^ 2 := by ring
          _ = Q - Q := by rw [hL_sq, hSU_sq]
          _ = 0 := sub_self Q
      have hL_eq : L = S_U := sub_eq_zero.mp (h_unit.mul_left_eq_zero.mp h_diff_mul)
      have hLinv_eq : L_inv = I_U := by
        calc L_inv = L_inv * (S_U * I_U) := by rw [hSUIU, mul_one]
          _ = (L_inv * L) * I_U := by rw [← hL_eq, mul_assoc]
          _ = I_U := by rw [hL_inv, one_mul]
      exact ⟨hU0, hL_eq, hLinv_eq⟩
    have hUnit2D : ∀ (ℓ_star : ℂ) (Q₀ L₀ L₀_inv : MvPowerSeries (Fin 2) ℂ),
        ℓ_star ≠ 0 →
        L₀ ^ 2 = Q₀ →
        L₀_inv * L₀ = 1 →
        MvPowerSeries.coeff 0 L₀ = ℓ_star →
        let U₀ := (Q₀ - MvPowerSeries.C (ℓ_star ^ 2)) * MvPowerSeries.C ((ℓ_star ^ 2)⁻¹)
        MvPowerSeries.coeff 0 U₀ = 0 ∧
        L₀ = MvPowerSeries.C ℓ_star * compPowerSeries2D S U₀ ∧
        L₀_inv = MvPowerSeries.C ℓ_star⁻¹ * compPowerSeries2D I U₀ := by
