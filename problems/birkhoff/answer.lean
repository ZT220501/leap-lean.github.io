  have h_sin_int : MeasureTheory.Integrable Real.sin unifTwoPiMeasure :=
    MeasureTheory.Integrable.of_bound Real.continuous_sin.measurable.aestronglyMeasurable 1
      (Filter.Eventually.of_forall fun θ => by
