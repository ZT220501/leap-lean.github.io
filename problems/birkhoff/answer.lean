        rw [div_le_iff₀ hq_pos]
        linarith
      have h3 : (K₁ / (q : ℝ)) * D_w ≤ (1 / 2 : ℝ) * D_w :=
        mul_le_mul_of_nonneg_right hK_half hDw_nonneg
      have h4 : (1 / 2 : ℝ) * D_w ≤ (K₁ / (q : ℝ) ^ 2) * |x₂ - x₁| := by linarith
      have h5 := mul_le_mul_of_nonneg_left h4 (show (0 : ℝ) ≤ 2 * (q : ℝ) by positivity)
      have h5l : (2 * (q : ℝ)) * ((1 / 2 : ℝ) * D_w) = (q : ℝ) * D_w := by ring
      have h5r : (2 * (q : ℝ)) * ((K₁ / (q : ℝ) ^ 2) * |x₂ - x₁|) =
          ((2 * K₁) / (q : ℝ)) * |x₂ - x₁| := by field_simp [hq_ne]
      rw [h5l, h5r] at h5
      have h2K_le1 : (2 * K₁) / (q : ℝ) ≤ 1 := (div_le_iff₀ hq_pos).mpr (by linarith)
      exact le_trans h5 (by nlinarith [abs_nonneg (x₂ - x₁)])
    intro j hj
    linarith [hy_diff_le j hj]
  
  let S_gen : ℝ → ℝ → ℝ := fun θ₁ θ₂ => 2 * R.h ((θ₁ + θ₂) / 2) * Real.sin ((θ₂ - θ₁) / 2)
  let θ_orb : ℝ → ℕ → ℝ := fun x j => R.ϕ (y_orb x j)
  have h_crit_closed : ∀ x : ℝ,
      R.c * critAction_ℝ q u_tab x =
        (∑ j ∈ Finset.range q, S_gen (θ_orb x j) (θ_orb x (j + 1))) -
          ∫ η in (0 : ℝ)..(2 * Real.pi), R.h η := by
    intro x
    simp only [critAction_ℝ, Finset.mul_sum]
    have hcongr : ∑ j ∈ Finset.range q,
        R.c * normAction_ℝ u_tab (realMesh q u_tab x j) (realMesh q u_tab x (j + 1)) =
        ∑ j ∈ Finset.range q,
          (S_gen (θ_orb x j) (θ_orb x (j + 1)) - (H₀ (θ_orb x (j + 1)) - H₀ (θ_orb x j))) := by
      refine Finset.sum_congr rfl (fun j hj => ?_)
      have hjq : j < q := Finset.mem_range.mp hj
      rw [h_rm_eq_y x j (Nat.le_of_lt hjq), h_rm_eq_y x (j + 1) hjq, h_normAction_eq]
    rw [hcongr, Finset.sum_sub_distrib, Finset.sum_range_sub (fun j => H₀ (θ_orb x j)) q]
    have hθ0 : θ_orb x 0 = R.ϕ x := rfl
    have hθq : θ_orb x q = R.ϕ x + 2 * Real.pi := by
      simp only [θ_orb, y_orb, hF_per_q, R.ϕ_quasiperiodic]
    rw [hθ0, hθq]
    have hH_int : H₀ (R.ϕ x + 2 * Real.pi) - H₀ (R.ϕ x) =
        ∫ η in R.ϕ x..(R.ϕ x + 2 * Real.pi), R.h η := by
      symm
      exact intervalIntegral.integral_eq_sub_of_hasDerivAt
        (fun η _ => hH₀_deriv η) (R.h_smooth.continuous.intervalIntegrable _ _)
    have hper_int : (∫ η in R.ϕ x..(R.ϕ x + 2 * Real.pi), R.h η) =
        ∫ η in (0 : ℝ)..(2 * Real.pi), R.h η := by
      simpa using R.h_periodic.intervalIntegral_add_eq (R.ϕ x) 0
    rw [hH_int, hper_int]
  let K_quad : ℝ := (32 * (q : ℝ) * M_h * M_ϕ ^ 2) / R.c
  have h_crit_quad : ∀ x₁ x₂ : ℝ,
      |critAction_ℝ q u_tab x₂ - critAction_ℝ q u_tab x₁| ≤ K_quad * (x₂ - x₁) ^ 2 := by
    intro x₁ x₂
    let Δ : ℕ → ℝ := fun j => θ_orb x₂ j - θ_orb x₁ j
    have hΔ_bnd : ∀ j : ℕ, j ≤ q → |Δ j| ≤ 2 * M_ϕ * |x₂ - x₁| := by
      intro j hj
      calc |Δ j|
          = |R.ϕ (y_orb x₂ j) - R.ϕ (y_orb x₁ j)| := rfl
        _ ≤ M_ϕ * |y_orb x₂ j - y_orb x₁ j| := hϕ_lip _ _
        _ ≤ M_ϕ * (2 * |x₂ - x₁|) := by gcongr; exact hy_lip x₁ x₂ j hj
        _ = 2 * M_ϕ * |x₂ - x₁| := by ring
    have hΔ_per : Δ q = Δ 0 := by
      simp only [Δ, θ_orb, y_orb, hF_per_q, R.ϕ_quasiperiodic, Function.iterate_zero, id_eq]
      ring
    let A_lin : ℕ → ℝ := fun j => supportAction1_ℝ R.h (θ_orb x₁ j) (θ_orb x₁ (j + 1))
    let B_lin : ℕ → ℝ := fun j => supportAction2_ℝ R.h (θ_orb x₁ j) (θ_orb x₁ (j + 1))
    have hB_eq_negA : ∀ j : ℕ, B_lin j = -A_lin (j + 1) := by
      intro j
      have hst := R.F_col_stationary b_q hb_q (y_orb x₁ j)
      have hy1 : R.F_col b_q (y_orb x₁ j) = y_orb x₁ (j + 1) :=
        (Function.iterate_succ_apply' F j x₁).symm
      have hy2 : R.F_col b_q (y_orb x₁ (j + 1)) = y_orb x₁ (j + 2) :=
        (Function.iterate_succ_apply' F (j + 1) x₁).symm
      rw [hy1, hy2] at hst
      exact hst.symm
    have hA_per : A_lin q = A_lin 0 := by
      have hyq : y_orb x₁ q = x₁ + 2 * Real.pi := hb_q_per x₁
      have hyq1 : y_orb x₁ (q + 1) = y_orb x₁ 1 + 2 * Real.pi := by
        calc y_orb x₁ (q + 1)
            = F (y_orb x₁ q) := Function.iterate_succ_apply' F q x₁
          _ = F (x₁ + 2 * Real.pi) := by rw [hyq]
          _ = F x₁ + 2 * Real.pi := R.F_col_quasiperiodic b_q hb_q x₁
          _ = y_orb x₁ 1 + 2 * Real.pi := rfl
      have hθq : θ_orb x₁ q = θ_orb x₁ 0 + 2 * Real.pi := by
        simp [θ_orb, hyq, R.ϕ_quasiperiodic, y_orb]
      have hθq1 : θ_orb x₁ (q + 1) = θ_orb x₁ 1 + 2 * Real.pi := by
        simp [θ_orb, hyq1, R.ϕ_quasiperiodic]
      simp only [A_lin, supportAction1_ℝ, hθq, hθq1]
      have hm : (θ_orb x₁ 0 + 2 * Real.pi + (θ_orb x₁ 1 + 2 * Real.pi)) / 2 =
          (θ_orb x₁ 0 + θ_orb x₁ 1) / 2 + 2 * Real.pi := by ring
      have hd : (θ_orb x₁ 1 + 2 * Real.pi - (θ_orb x₁ 0 + 2 * Real.pi)) / 2 =
          (θ_orb x₁ 1 - θ_orb x₁ 0) / 2 := by ring
      rw [hm, hd, R.h_periodic _, hdh_per _]
    have h_lin_sum_zero : ∑ j ∈ Finset.range q, (A_lin j * Δ j + B_lin j * Δ (j + 1)) = 0 := by
      have h_rw : ∑ j ∈ Finset.range q, (A_lin j * Δ j + B_lin j * Δ (j + 1)) =
          -(∑ j ∈ Finset.range q, (A_lin (j + 1) * Δ (j + 1) - A_lin j * Δ j)) := by
        rw [← Finset.sum_neg_distrib]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        rw [hB_eq_negA j]
        ring
      rw [h_rw, Finset.sum_range_sub (fun j => A_lin j * Δ j) q, hA_per, hΔ_per, sub_self, neg_zero]
    have h_cell_quad : ∀ j : ℕ, j < q →
        |S_gen (θ_orb x₂ j) (θ_orb x₂ (j + 1)) - S_gen (θ_orb x₁ j) (θ_orb x₁ (j + 1)) -
          (A_lin j * Δ j + B_lin j * Δ (j + 1))| ≤
          32 * M_h * M_ϕ ^ 2 * (x₂ - x₁) ^ 2 := by
      intro j hj
      set a₀ := θ_orb x₁ j
      set b₀ := θ_orb x₁ (j + 1)
      set da := Δ j
      set db := Δ (j + 1)
      let γ : ℝ → ℝ := fun u => S_gen (a₀ + u * da) (b₀ + u * db) - u * (A_lin j * da + B_lin j * db)
      let γ' : ℝ → ℝ := fun u =>
        (supportAction1_ℝ R.h (a₀ + u * da) (b₀ + u * db) - A_lin j) * da +
          (supportAction2_ℝ R.h (a₀ + u * da) (b₀ + u * db) - B_lin j) * db
      have hdγ : ∀ u ∈ Set.uIcc (0 : ℝ) 1, HasDerivAt γ (γ' u) u := by
        intro u _
        have ha : HasDerivAt (fun v : ℝ => a₀ + v * da) da u :=
          (((hasDerivAt_id u).mul_const da).const_add a₀).congr_deriv (one_mul da)
        have hb : HasDerivAt (fun v : ℝ => b₀ + v * db) db u :=
          (((hasDerivAt_id u).mul_const db).const_add b₀).congr_deriv (one_mul db)
        have hm : HasDerivAt (fun v : ℝ => ((a₀ + v * da) + (b₀ + v * db)) / 2)
            ((da + db) / 2) u := (ha.add hb).div_const 2
        have hd : HasDerivAt (fun v : ℝ => ((b₀ + v * db) - (a₀ + v * da)) / 2)
            ((db - da) / 2) u := (hb.sub ha).div_const 2
        have hS : HasDerivAt (fun v : ℝ => S_gen (a₀ + v * da) (b₀ + v * db))
            (supportAction1_ℝ R.h (a₀ + u * da) (b₀ + u * db) * da +
              supportAction2_ℝ R.h (a₀ + u * da) (b₀ + u * db) * db) u := by
          have hh_m : HasDerivAt (fun v : ℝ => 2 * R.h (((a₀ + v * da) + (b₀ + v * db)) / 2))
              (2 * (deriv R.h (((a₀ + u * da) + (b₀ + u * db)) / 2) * ((da + db) / 2))) u :=
            ((hh_diff _).hasDerivAt.comp u hm).const_mul 2
          exact (hh_m.mul hd.sin).congr_deriv (by
            simp only [supportAction1_ℝ, supportAction2_ℝ]
            ring)
        have hlin : HasDerivAt (fun v : ℝ => v * (A_lin j * da + B_lin j * db))
            (A_lin j * da + B_lin j * db) u :=
          ((hasDerivAt_id u).mul_const (A_lin j * da + B_lin j * db)).congr_deriv (one_mul _)
        exact (hS.sub hlin).congr_deriv (by simp only [γ']; ring)
      have hiγ : IntervalIntegrable γ' MeasureTheory.volume (0 : ℝ) 1 := by
        have hm_c : Continuous (fun u : ℝ => ((a₀ + u * da) + (b₀ + u * db)) / 2) := by continuity
        have hd_c : Continuous (fun u : ℝ => ((b₀ + u * db) - (a₀ + u * da)) / 2) := by continuity
        have hs1_c : Continuous (fun u : ℝ => supportAction1_ℝ R.h (a₀ + u * da) (b₀ + u * db)) :=
          ((hdh_smooth.continuous.comp hm_c).mul (Real.continuous_sin.comp hd_c)).sub
            ((R.h_smooth.continuous.comp hm_c).mul (Real.continuous_cos.comp hd_c))
        have hs2_c : Continuous (fun u : ℝ => supportAction2_ℝ R.h (a₀ + u * da) (b₀ + u * db)) :=
          ((hdh_smooth.continuous.comp hm_c).mul (Real.continuous_sin.comp hd_c)).add
            ((R.h_smooth.continuous.comp hm_c).mul (Real.continuous_cos.comp hd_c))
        exact (((hs1_c.sub continuous_const).mul continuous_const).add
          ((hs2_c.sub continuous_const).mul continuous_const)).intervalIntegrable _ _
      have hint_γ := intervalIntegral.integral_eq_sub_of_hasDerivAt hdγ hiγ
      have hγ_end : γ 1 - γ 0 =
          S_gen (θ_orb x₂ j) (θ_orb x₂ (j + 1)) - S_gen (θ_orb x₁ j) (θ_orb x₁ (j + 1)) -
            (A_lin j * da + B_lin j * db) := by
        have ha1 : a₀ + 1 * da = θ_orb x₂ j := by simp [a₀, da, Δ]
        have hb1 : b₀ + 1 * db = θ_orb x₂ (j + 1) := by simp [b₀, db, Δ]
        have ha0 : a₀ + 0 * da = θ_orb x₁ j := by simp [a₀]
        have hb0 : b₀ + 0 * db = θ_orb x₁ (j + 1) := by simp [b₀]
        dsimp only [γ]
        rw [ha1, hb1, ha0, hb0]
        ring
      rw [← hγ_end, ← hint_γ, ← Real.norm_eq_abs]
      have hbnd_u : ∀ u ∈ Set.uIoc (0 : ℝ) 1,
          ‖γ' u‖ ≤ 32 * M_h * M_ϕ ^ 2 * (x₂ - x₁) ^ 2 := by
        intro u hu
        rw [Set.uIoc_of_le zero_le_one] at hu
        have hu0 : 0 ≤ u := le_of_lt hu.1
        have hu1 : u ≤ 1 := hu.2
        have hl1 : |supportAction1_ℝ R.h (a₀ + u * da) (b₀ + u * db) - A_lin j| ≤
            2 * M_h * (|da| + |db|) := by
          have := hS1_lip (a₀ + u * da) (b₀ + u * db) a₀ b₀
          have hda_u : |(a₀ + u * da) - a₀| ≤ |da| := by
            rw [add_sub_cancel_left, abs_mul, abs_of_nonneg hu0]
            nlinarith [abs_nonneg da]
          have hdb_u : |(b₀ + u * db) - b₀| ≤ |db| := by
            rw [add_sub_cancel_left, abs_mul, abs_of_nonneg hu0]
            nlinarith [abs_nonneg db]
          exact le_trans this (by gcongr)
        have hl2 : |supportAction2_ℝ R.h (a₀ + u * da) (b₀ + u * db) - B_lin j| ≤
            2 * M_h * (|da| + |db|) := by
          have := hS2_lip (a₀ + u * da) (b₀ + u * db) a₀ b₀
          have hda_u : |(a₀ + u * da) - a₀| ≤ |da| := by
            rw [add_sub_cancel_left, abs_mul, abs_of_nonneg hu0]
            nlinarith [abs_nonneg da]
          have hdb_u : |(b₀ + u * db) - b₀| ≤ |db| := by
            rw [add_sub_cancel_left, abs_mul, abs_of_nonneg hu0]
            nlinarith [abs_nonneg db]
          exact le_trans this (by gcongr)
        have hda_le : |da| ≤ 2 * M_ϕ * |x₂ - x₁| := hΔ_bnd j (Nat.le_of_lt hj)
        have hdb_le : |db| ≤ 2 * M_ϕ * |x₂ - x₁| := hΔ_bnd (j + 1) hj
        have hsum_d_le : |da| + |db| ≤ 4 * M_ϕ * |x₂ - x₁| := by linarith
        rw [Real.norm_eq_abs]
        have h1 : |(supportAction1_ℝ R.h (a₀ + u * da) (b₀ + u * db) - A_lin j) * da +
            (supportAction2_ℝ R.h (a₀ + u * da) (b₀ + u * db) - B_lin j) * db| ≤
            2 * M_h * (|da| + |db|) * |da| + 2 * M_h * (|da| + |db|) * |db| := by
          refine le_trans (abs_add_le _ _) ?_
          rw [abs_mul, abs_mul]
          exact add_le_add (by gcongr) (by gcongr)
        calc _ ≤ 2 * M_h * (|da| + |db|) ^ 2 := by linarith
          _ ≤ 2 * M_h * (4 * M_ϕ * |x₂ - x₁|) ^ 2 := by gcongr
          _ = 32 * M_h * M_ϕ ^ 2 * |x₂ - x₁| ^ 2 := by ring
          _ = 32 * M_h * M_ϕ ^ 2 * (x₂ - x₁) ^ 2 := by rw [sq_abs]
      have := intervalIntegral.norm_integral_le_of_norm_le_const hbnd_u
      simpa using this
    have h_diff_c :
        R.c * (critAction_ℝ q u_tab x₂ - critAction_ℝ q u_tab x₁) =
        ∑ j ∈ Finset.range q,
          (S_gen (θ_orb x₂ j) (θ_orb x₂ (j + 1)) - S_gen (θ_orb x₁ j) (θ_orb x₁ (j + 1)) -
            (A_lin j * Δ j + B_lin j * Δ (j + 1))) := by
      have hc2 := h_crit_closed x₂
      have hc1 := h_crit_closed x₁
      have hsub_sum :
          (∑ j ∈ Finset.range q, S_gen (θ_orb x₂ j) (θ_orb x₂ (j + 1))) -
            (∑ j ∈ Finset.range q, S_gen (θ_orb x₁ j) (θ_orb x₁ (j + 1))) =
          ∑ j ∈ Finset.range q,
            (S_gen (θ_orb x₂ j) (θ_orb x₂ (j + 1)) - S_gen (θ_orb x₁ j) (θ_orb x₁ (j + 1)) -
              (A_lin j * Δ j + B_lin j * Δ (j + 1))) := by
        rw [Finset.sum_sub_distrib, h_lin_sum_zero, sub_zero, Finset.sum_sub_distrib]
      linarith
    have hc_abs : R.c * |critAction_ℝ q u_tab x₂ - critAction_ℝ q u_tab x₁| ≤
        (q : ℝ) * (32 * M_h * M_ϕ ^ 2 * (x₂ - x₁) ^ 2) := by
      calc R.c * |critAction_ℝ q u_tab x₂ - critAction_ℝ q u_tab x₁|
          = |R.c * (critAction_ℝ q u_tab x₂ - critAction_ℝ q u_tab x₁)| := by
              rw [abs_mul, abs_of_pos R.c_pos]
        _ ≤ ∑ j ∈ Finset.range q,
              |S_gen (θ_orb x₂ j) (θ_orb x₂ (j + 1)) - S_gen (θ_orb x₁ j) (θ_orb x₁ (j + 1)) -
                (A_lin j * Δ j + B_lin j * Δ (j + 1))| := by
              rw [h_diff_c]; exact Finset.abs_sum_le_sum_abs _ _
        _ ≤ ∑ _j ∈ Finset.range q, (32 * M_h * M_ϕ ^ 2 * (x₂ - x₁) ^ 2) :=
              Finset.sum_le_sum (fun j hj => h_cell_quad j (Finset.mem_range.mp hj))
        _ = (q : ℝ) * (32 * M_h * M_ϕ ^ 2 * (x₂ - x₁) ^ 2) := by simp
    rw [show K_quad * (x₂ - x₁) ^ 2 =
        ((q : ℝ) * (32 * M_h * M_ϕ ^ 2 * (x₂ - x₁) ^ 2)) / R.c by
          simp only [K_quad]; ring]
    exact (le_div_iff₀ R.c_pos).mpr (by linarith)
  
  by_contra hne
  have hdiff_pos : 0 < |critAction_ℝ q u_tab x_target - critAction_ℝ q u_tab 0| :=
    abs_pos.mpr (sub_ne_zero.mpr hne)
  obtain ⟨M, hM⟩ := exists_nat_gt
    (max 1 ((K_quad * x_target ^ 2) / |critAction_ℝ q u_tab x_target - critAction_ℝ q u_tab 0|))
  have hM_gt1 : 1 < M := by exact_mod_cast (lt_of_le_of_lt (le_max_left _ _) hM)
  have hM_pos : (0 : ℝ) < (M : ℝ) := by exact_mod_cast (by omega : 0 < M)
  have hM_ne : (M : ℝ) ≠ 0 := ne_of_gt hM_pos
  let pt : ℕ → ℝ := fun m => ((m : ℝ) / (M : ℝ)) * x_target
  have h_subdiv : |critAction_ℝ q u_tab x_target - critAction_ℝ q u_tab 0| ≤
      (K_quad * x_target ^ 2) / (M : ℝ) := by
    have hpt0 : pt 0 = 0 := by simp [pt]
    have hptM : pt M = x_target := by simp [pt, div_self hM_ne]
    have htel := Finset.sum_range_sub (fun m => critAction_ℝ q u_tab (pt m)) M
    rw [hpt0, hptM] at htel
    rw [← htel]
    calc |∑ m ∈ Finset.range M,
            (critAction_ℝ q u_tab (pt (m + 1)) - critAction_ℝ q u_tab (pt m))|
        ≤ ∑ m ∈ Finset.range M,
            |critAction_ℝ q u_tab (pt (m + 1)) - critAction_ℝ q u_tab (pt m)| :=
          Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ _m ∈ Finset.range M, (K_quad * (x_target / (M : ℝ)) ^ 2) := by
          refine Finset.sum_le_sum (fun m _ => ?_)
          have hstep : pt (m + 1) - pt m = x_target / (M : ℝ) := by
            simp only [pt, Nat.cast_add, Nat.cast_one]; ring
          simpa only [hstep] using h_crit_quad (pt m) (pt (m + 1))
      _ = (M : ℝ) * (K_quad * (x_target / (M : ℝ)) ^ 2) := by simp
      _ = (K_quad * x_target ^ 2) / (M : ℝ) := by field_simp [hM_ne]
  have hM_gt : (K_quad * x_target ^ 2) /
      |critAction_ℝ q u_tab x_target - critAction_ℝ q u_tab 0| < (M : ℝ) :=
    lt_of_le_of_lt (le_max_right _ _) hM
  have h1 := (div_lt_iff₀ hdiff_pos).mp hM_gt
  have h2 := (le_div_iff₀ hM_pos).mp h_subdiv
  linarith

theorem real_primPhi_and_action_taylor (m : ℕ) (M₁ : ℝ)
    (hm : 2 ≤ m) (hM₁ : 0 < M₁) :
    Nonempty (RealActionTaylorData m M₁) :=
by
  have _ := hM₁
  have hPhi_deriv : ∀ (w : ℝ → ℝ),
      IsPeriodicSmoothBounded (m + 15) M₁ w →
      ∀ z : ℝ, HasDerivAt (primPhi_ℝ w) (Real.exp (w z)) z := by
    intro w hw z
    have hf : Continuous (fun ζ : ℝ => Real.exp (w ζ)) :=
      Real.continuous_exp.comp hw.2.1.continuous
    exact intervalIntegral.integral_hasDerivAt_right
      (hf.intervalIntegrable 0 z)
      (hf.stronglyMeasurableAtFilter MeasureTheory.volume (nhds z))
      hf.continuousAt

  have hPhi_strictMono : ∀ (w : ℝ → ℝ),
      IsPeriodicSmoothBounded (m + 15) M₁ w →
      StrictMono (primPhi_ℝ w) := by
    intro w hw
    apply strictMono_of_deriv_pos
    intro z
    rw [(hPhi_deriv w hw z).deriv]
    exact Real.exp_pos (w z)

  have hPhi_contDiff : ∀ (w : ℝ → ℝ),
      IsPeriodicSmoothBounded (m + 15) M₁ w →
      ContDiff ℝ ((m + 16 : ℕ) : WithTop ℕ∞) (primPhi_ℝ w) := by
    intro w hw
    have hcast : ((m + 16 : ℕ) : WithTop ℕ∞) = ((m + 15 : ℕ) : WithTop ℕ∞) + 1 := by norm_cast
    rw [hcast, contDiff_succ_iff_deriv]
    refine ⟨fun z => (hPhi_deriv w hw z).differentiableAt, by simp, ?_⟩
    have hderiv_eq : deriv (primPhi_ℝ w) = fun z => Real.exp (w z) :=
      funext fun z => (hPhi_deriv w hw z).deriv
    rw [hderiv_eq]
    exact Real.contDiff_exp.comp hw.2.1

  have hPhi_surj : ∀ (w : ℝ → ℝ),
      IsPeriodicSmoothBounded (m + 15) M₁ w →
      Function.Surjective (primPhi_ℝ w) := by
    intro w hw y
    have hf_cont : Continuous (fun ζ : ℝ => Real.exp (w ζ)) :=
      Real.continuous_exp.comp hw.2.1.continuous
    have hw_lower : ∀ ζ : ℝ, Real.exp (-M₁) ≤ Real.exp (w ζ) := by
      intro ζ
      have h0 := hw.2.2 0 (Nat.zero_le _) ζ
      rw [iteratedDeriv_zero] at h0
      exact Real.exp_le_exp.mpr (neg_le_of_abs_le h0)
    let R : ℝ := |y| * Real.exp M₁
    have hR_nonneg : 0 ≤ R := mul_nonneg (abs_nonneg y) (le_of_lt (Real.exp_pos M₁))
    have hR_prod : R * Real.exp (-M₁) = |y| := by
      dsimp [R]
      rw [mul_assoc, ← Real.exp_add, add_neg_cancel, Real.exp_zero, mul_one]
    have hUpper : |y| ≤ primPhi_ℝ w R := by
      have hmono_int : (∫ _ in (0 : ℝ)..R, Real.exp (-M₁)) ≤
          ∫ ζ in (0 : ℝ)..R, Real.exp (w ζ) :=
        intervalIntegral.integral_mono_on hR_nonneg intervalIntegrable_const
          (hf_cont.intervalIntegrable 0 R) (fun ζ _ => hw_lower ζ)
      simp only [intervalIntegral.integral_const, sub_zero, smul_eq_mul] at hmono_int
      rwa [hR_prod] at hmono_int
    have hLower : primPhi_ℝ w (-R) ≤ -|y| := by
      have hmono_int : (∫ _ in (-R)..(0 : ℝ), Real.exp (-M₁)) ≤
          ∫ ζ in (-R)..(0 : ℝ), Real.exp (w ζ) :=
        intervalIntegral.integral_mono_on (neg_nonpos.mpr hR_nonneg) intervalIntegrable_const
          (hf_cont.intervalIntegrable (-R) 0) (fun ζ _ => hw_lower ζ)
      simp only [intervalIntegral.integral_const, zero_sub, neg_neg, smul_eq_mul] at hmono_int
      rw [intervalIntegral.integral_symm 0 (-R)] at hmono_int
      change R * Real.exp (-M₁) ≤ -primPhi_ℝ w (-R) at hmono_int
      rw [hR_prod] at hmono_int
      linarith
    have hy_mem : y ∈ Set.Icc (primPhi_ℝ w (-R)) (primPhi_ℝ w R) :=
      ⟨le_trans hLower (neg_abs_le y), le_trans (le_abs_self y) hUpper⟩
    obtain ⟨x, _, hx⟩ := intermediate_value_Icc (by linarith : -R ≤ R)
      (hPhi_contDiff w hw).continuous.continuousOn hy_mem
    exact ⟨x, hx⟩

  have hPhi_rightInv : ∀ (w : ℝ → ℝ),
      IsPeriodicSmoothBounded (m + 15) M₁ w →
      ∀ y : ℝ, primPhi_ℝ w (Function.invFun (primPhi_ℝ w) y) = y :=
    fun w hw => Function.rightInverse_invFun (hPhi_surj w hw)

  have hMid_eq : ∀ (w : ℝ → ℝ),
      IsPeriodicSmoothBounded (m + 15) M₁ w →
      ∀ X Y : ℝ, primPhi_ℝ w (midpoint_ℝ w X Y) = (primPhi_ℝ w X + primPhi_ℝ w Y) / 2 :=
    fun w hw X Y => hPhi_rightInv w hw ((primPhi_ℝ w X + primPhi_ℝ w Y) / 2)

  have hInv_contDiff : ∀ (w : ℝ → ℝ),
      IsPeriodicSmoothBounded (m + 15) M₁ w →
      ContDiff ℝ ((m + 16 : ℕ) : WithTop ℕ∞) (Function.invFun (primPhi_ℝ w)) := by
    intro w hw
    let Φ_homeo : ℝ ≃ₜ ℝ :=
      ((hPhi_strictMono w hw).orderIsoOfSurjective (primPhi_ℝ w) (hPhi_surj w hw)).toHomeomorph
    have hInvEq : Function.invFun (primPhi_ℝ w) = Φ_homeo.symm := by
      funext y
      apply (hPhi_strictMono w hw).injective
      rw [hPhi_rightInv w hw y]
      exact (Φ_homeo.apply_symm_apply y).symm
    rw [hInvEq]
    exact Φ_homeo.contDiff_symm_deriv (fun x => Real.exp_ne_zero (w x))
      (hPhi_deriv w hw) (hPhi_contDiff w hw)

  have hInv_deriv : ∀ (w : ℝ → ℝ),
      IsPeriodicSmoothBounded (m + 15) M₁ w →
      ∀ y : ℝ, HasDerivAt (Function.invFun (primPhi_ℝ w))
        (Real.exp (-w (Function.invFun (primPhi_ℝ w) y))) y := by
    intro w hw y
    set ψ := Function.invFun (primPhi_ℝ w)
    have hψ_diff : Differentiable ℝ ψ :=
      (hInv_contDiff w hw).differentiable (by simp)
    have hd : HasDerivAt ψ (deriv ψ y) y := (hψ_diff y).hasDerivAt
    have hcomp : HasDerivAt (fun y' => primPhi_ℝ w (ψ y'))
        (Real.exp (w (ψ y)) * deriv ψ y) y :=
      (hPhi_deriv w hw (ψ y)).comp y hd
    have hid_eq : (fun y' => primPhi_ℝ w (ψ y')) = id := funext (hPhi_rightInv w hw)
    rw [hid_eq] at hcomp
    have hmul : Real.exp (w (ψ y)) * deriv ψ y = 1 := hcomp.unique (hasDerivAt_id y)
    have hval : deriv ψ y = Real.exp (-w (ψ y)) := by
      calc deriv ψ y
          = Real.exp (-w (ψ y)) * (Real.exp (w (ψ y)) * deriv ψ y) := by
              rw [← mul_assoc, ← Real.exp_add, neg_add_cancel, Real.exp_zero, one_mul]
        _ = Real.exp (-w (ψ y)) := by rw [hmul, mul_one]
    rwa [hval] at hd

  have hMid_diag_per : ∀ (w : ℝ → ℝ),
      IsPeriodicSmoothBounded (m + 15) M₁ w →
      ∀ X Y : ℝ, midpoint_ℝ w (X + 2 * Real.pi) (Y + 2 * Real.pi) =
        midpoint_ℝ w X Y + 2 * Real.pi := by
    intro w hw X Y
    have hPhi_quasi : ∀ z : ℝ,
        primPhi_ℝ w (z + 2 * Real.pi) = primPhi_ℝ w z + primPhi_ℝ w (2 * Real.pi) := by
      intro z
      have hd : ∀ t ∈ Set.uIcc (0 : ℝ) z,
          HasDerivAt (fun t' : ℝ => primPhi_ℝ w (t' + 2 * Real.pi) - primPhi_ℝ w t') 0 t := by
        intro t _
        have hlin : HasDerivAt (fun t' : ℝ => t' + 2 * Real.pi) 1 t :=
          (hasDerivAt_id t).add_const (2 * Real.pi)
        have hd1_raw := HasDerivAt.comp t (hPhi_deriv w hw (t + 2 * Real.pi)) hlin
        have hd1 : HasDerivAt (fun t' : ℝ => primPhi_ℝ w (t' + 2 * Real.pi))
            (Real.exp (w t)) t := by
          refine hd1_raw.congr_deriv ?_
          rw [mul_one, hw.1 t]
        exact (hd1.sub (hPhi_deriv w hw t)).congr_deriv (sub_self _)
      have hftc := intervalIntegral.integral_eq_sub_of_hasDerivAt hd
        (intervalIntegrable_const (c := (0 : ℝ)))
      have h0 : primPhi_ℝ w 0 = 0 := intervalIntegral.integral_same
      simp only [intervalIntegral.integral_const, smul_zero, zero_add, h0, sub_zero] at hftc
      linarith
    apply (hPhi_strictMono w hw).injective
    rw [hMid_eq w hw (X + 2 * Real.pi) (Y + 2 * Real.pi),
      hPhi_quasi X, hPhi_quasi Y, hPhi_quasi (midpoint_ℝ w X Y), hMid_eq w hw X Y]
    ring

  have hDiff_bound : ∀ (w₁ w₂ : ℝ → ℝ),
      IsPeriodicSmoothBounded (m + 15) M₁ w₁ →
      IsPeriodicSmoothBounded (m + 15) M₁ w₂ →
      0 ≤ realDiffSup (m + 15) w₁ w₂ ∧
      ∀ j : ℕ, j ≤ m + 15 → ∀ z : ℝ,
        |iteratedDeriv j (fun y => w₁ y - w₂ y) z| ≤ realDiffSup (m + 15) w₁ w₂ := by
    intro w₁ w₂ hw₁ hw₂
    refine ⟨?_, ?_⟩
    · apply Real.sSup_nonneg
      rintro r ⟨j, _, y, _, rfl⟩
      exact abs_nonneg _
    · intro j hj z
      have hBdd : BddAbove { r : ℝ | ∃ i ≤ m + 15, ∃ y ∈ Set.Icc (0 : ℝ) (2 * Real.pi),
          r = |iteratedDeriv i (w₁ - w₂) y| } := by
        refine ⟨2 * M₁, ?_⟩
        rintro r ⟨i, hi, y, _, rfl⟩
        have hc1 : ContDiffAt ℝ (i : WithTop ℕ∞) w₁ y :=
          (hw₁.2.1.of_le (by norm_cast)).contDiffAt
        have hc2 : ContDiffAt ℝ (i : WithTop ℕ∞) w₂ y :=
          (hw₂.2.1.of_le (by norm_cast)).contDiffAt
        change |iteratedDeriv i (fun x => w₁ x - w₂ x) y| ≤ 2 * M₁
        rw [iteratedDeriv_fun_sub hc1 hc2]
        calc |iteratedDeriv i w₁ y - iteratedDeriv i w₂ y|
            ≤ |iteratedDeriv i w₁ y| + |iteratedDeriv i w₂ y| := abs_sub _ _
          _ ≤ M₁ + M₁ := add_le_add (hw₁.2.2 i hi y) (hw₂.2.2 i hi y)
          _ = 2 * M₁ := by ring
      have hper_diff : (fun y => (w₁ - w₂) (y + 2 * Real.pi)) = w₁ - w₂ := by
        funext y
        simp [Pi.sub_apply, hw₁.1 y, hw₂.1 y]
      have hper_j : Function.Periodic (iteratedDeriv j (w₁ - w₂)) (2 * Real.pi) := by
        intro y
        have hcomp := congr_fun (iteratedDeriv_comp_add_const j (w₁ - w₂) (2 * Real.pi)) y
        rw [hper_diff] at hcomp
        exact hcomp.symm
      obtain ⟨y, hy, hzy⟩ := hper_j.exists_mem_Ico₀ Real.two_pi_pos z
      change |iteratedDeriv j (w₁ - w₂) z| ≤ realDiffSup (m + 15) w₁ w₂
      rw [hzy]
      exact le_csSup hBdd ⟨j, hj, y, Set.Ico_subset_Icc_self hy, rfl⟩

  have hUnitInt : ∀ (F F' : ℝ → ℝ → ℝ),
      Continuous (fun p : ℝ × ℝ => F p.1 p.2) →
      Continuous (fun p : ℝ × ℝ => F' p.1 p.2) →
      (∀ u s : ℝ, HasDerivAt (fun u' => F u' s) (F' u s) u) →
      Continuous (fun u => ∫ s in (0 : ℝ)..1, F u s) ∧
      ∀ u₀ : ℝ, HasDerivAt (fun u => ∫ s in (0 : ℝ)..1, F u s)
        (∫ s in (0 : ℝ)..1, F' u₀ s) u₀ := by
    intro F F' hF hF' hd
    refine ⟨intervalIntegral.continuous_parametric_intervalIntegral_of_continuous'
      (f := F) hF 0 1, ?_⟩
    intro u₀
    have hK : IsCompact (Metric.closedBall u₀ 1 ×ˢ Set.uIcc (0 : ℝ) 1) :=
      (isCompact_closedBall u₀ 1).prod isCompact_uIcc
    obtain ⟨B, hB⟩ := hK.exists_bound_of_continuousOn hF'.continuousOn
    exact (intervalIntegral.hasDerivAt_integral_of_dominated_loc_of_deriv_le
      (Metric.closedBall_mem_nhds u₀ zero_lt_one)
      (Filter.Eventually.of_forall fun u =>
        (hF.comp (continuous_const.prodMk continuous_id)).aestronglyMeasurable)
      ((hF.comp (continuous_const.prodMk continuous_id)).intervalIntegrable 0 1)
      (hF'.comp (continuous_const.prodMk continuous_id)).aestronglyMeasurable
      (Filter.Eventually.of_forall fun s hs u hu =>
        hB (u, s) ⟨hu, Set.uIoc_subset_uIcc hs⟩)
      (intervalIntegrable_const (c := B))
      (Filter.Eventually.of_forall fun s _ u _ => hd u s)).2

  have hSinc : ∀ z : ℝ, Real.sin z = z * ∫ r in (0 : ℝ)..1, Real.cos (r * z) := by
    intro z
    have hd : ∀ r ∈ Set.uIcc (0 : ℝ) 1,
        HasDerivAt (fun r' : ℝ => Real.sin (r' * z)) (z * Real.cos (r * z)) r := by
      intro r _
      exact (((hasDerivAt_id r).mul_const z).sin).congr_deriv (by dsimp; ring)
    have hcont : Continuous (fun r : ℝ => z * Real.cos (r * z)) := by fun_prop
    have hftc := intervalIntegral.integral_eq_sub_of_hasDerivAt hd
      (hcont.intervalIntegrable 0 1)
    rw [intervalIntegral.integral_const_mul, one_mul, zero_mul, Real.sin_zero, sub_zero] at hftc
    exact hftc.symm

  have hAction_factor : ∀ (w : ℝ → ℝ),
      IsPeriodicSmoothBounded (m + 15) M₁ w →
      ∀ X T : ℝ, normAction1_ℝ w X (X + T) =
        T ^ 2 * (1 / 8 + realJetA w X * T ^ 2 + T ^ 3 * realJetB w X T) := by
    intro w hw X T
    have hw_c4 : ContDiff ℝ (4 : WithTop ℕ∞) w := hw.2.1.of_le (by norm_cast; omega)
    have hw_c0 : Continuous w := hw.2.1.continuous
    have hw_c1 : Continuous (iteratedDeriv 1 w) := hw_c4.continuous_iteratedDeriv 1 (by norm_num)
    have hw_c2 : Continuous (iteratedDeriv 2 w) := hw_c4.continuous_iteratedDeriv 2 (by norm_num)
    have hw_c3 : Continuous (iteratedDeriv 3 w) := hw_c4.continuous_iteratedDeriv 3 (by norm_num)
    have hw_d0 : ∀ z : ℝ, HasDerivAt w (iteratedDeriv 1 w z) z := by
      intro z
      have h := (hw_c4.differentiable_iteratedDeriv 0 (by norm_num) z).hasDerivAt
      rwa [← iteratedDeriv_succ, iteratedDeriv_zero] at h
    have hw_d1 : ∀ z : ℝ, HasDerivAt (iteratedDeriv 1 w) (iteratedDeriv 2 w z) z := by
      intro z
      have h := (hw_c4.differentiable_iteratedDeriv 1 (by norm_num) z).hasDerivAt
      rwa [← iteratedDeriv_succ] at h
    have hw_d2 : ∀ z : ℝ, HasDerivAt (iteratedDeriv 2 w) (iteratedDeriv 3 w z) z := by
      intro z
      have h := (hw_c4.differentiable_iteratedDeriv 2 (by norm_num) z).hasDerivAt
      rwa [← iteratedDeriv_succ] at h

    
    let μ : ℝ → ℝ := fun u => midpoint_ℝ w X (X + u)
    have hμ0 : μ 0 = X := by
      apply (hPhi_strictMono w hw).injective
      dsimp [μ]
      rw [hMid_eq w hw X (X + 0), add_zero]
      ring
    have hμ_deriv : ∀ u : ℝ,
        HasDerivAt μ ((1 / 2 : ℝ) * Real.exp (w (X + u) - w (μ u))) u := by
      intro u
      let y_fn : ℝ → ℝ := fun u' => (primPhi_ℝ w X + primPhi_ℝ w (X + u')) / 2
      have hy : HasDerivAt y_fn ((1 / 2 : ℝ) * Real.exp (w (X + u))) u := by
        have h1 : HasDerivAt (fun u' => primPhi_ℝ w (X + u')) (Real.exp (w (X + u)) * 1) u :=
          (hPhi_deriv w hw (X + u)).comp u ((hasDerivAt_id u).const_add X)
        have h2 := ((hasDerivAt_const u (primPhi_ℝ w X)).add h1).div_const 2
        convert h2 using 1
        ring
      have hcomp := (hInv_deriv w hw (y_fn u)).comp u hy
      change HasDerivAt μ (Real.exp (-w (μ u)) * ((1 / 2 : ℝ) * Real.exp (w (X + u)))) u at hcomp
      convert hcomp using 1
      rw [sub_eq_add_neg, Real.exp_add]
      ring
    have hμ_cont : Continuous μ :=
      Differentiable.continuous fun u => (hμ_deriv u).differentiableAt

    
    let ψ₀ : ℝ → ℝ := fun u => (1 / 2 : ℝ) * u * Real.exp (w X) * realActG w X u 0
    have hPhi_diff : ∀ u : ℝ,
        primPhi_ℝ w (X + u) - primPhi_ℝ w X = u * Real.exp (w X) * realActG w X u 0 := by
      intro u
      have hd : ∀ s ∈ Set.uIcc (0 : ℝ) 1,
          HasDerivAt (fun s' : ℝ => primPhi_ℝ w (X + s' * u))
            ((u * Real.exp (w X)) * Real.exp (w (X + s * u) - w X)) s := by
        intro s _
        have h1 := (hPhi_deriv w hw (X + s * u)).comp s
          (((hasDerivAt_id s).mul_const u).const_add X)
        refine h1.congr_deriv ?_
        have hexp : Real.exp (w (X + s * u)) =
            Real.exp (w X) * Real.exp (w (X + s * u) - w X) := by
          rw [← Real.exp_add]
          congr 1
          ring
        rw [hexp]
        ring
      have hcont : Continuous (fun s : ℝ =>
          (u * Real.exp (w X)) * Real.exp (w (X + s * u) - w X)) := by fun_prop
      have hftc := intervalIntegral.integral_eq_sub_of_hasDerivAt hd
        (hcont.intervalIntegrable 0 1)
      rw [intervalIntegral.integral_const_mul, one_mul, zero_mul, add_zero] at hftc
      exact hftc.symm
    have hPsi_prim : ∀ u : ℝ, ψ₀ u = (1 / 2 : ℝ) * (primPhi_ℝ w (X + u) - primPhi_ℝ w X) := by
      intro u
      dsimp [ψ₀]
      rw [hPhi_diff u]
      ring
    have hPsi_mid : ∀ u : ℝ, primPhi_ℝ w (μ u) - primPhi_ℝ w X = ψ₀ u := by
      intro u
      dsimp [μ]
      rw [hMid_eq w hw X (X + u), hPsi_prim u]
      ring

    
    let g_act : ℝ → ℝ := fun u => normAction1_ℝ w X (X + u)
    have hg0 : g_act 0 = 0 := by
      change Real.exp (w X) * (∫ z in X..(μ 0),
        Real.sin (primPhi_ℝ w z - primPhi_ℝ w X) * Real.exp (-2 * w z)) = 0
      rw [hμ0, intervalIntegral.integral_same, mul_zero]
    have hg_deriv : ∀ u : ℝ, HasDerivAt g_act (u * realActionH0 w X u) u := by
      intro u
      let F_act : ℝ → ℝ := fun z =>
        Real.sin (primPhi_ℝ w z - primPhi_ℝ w X) * Real.exp (-2 * w z)
      have hF_cont : Continuous F_act := by
        have hPc := (hPhi_contDiff w hw).continuous
        fun_prop
      have hInt_d : HasDerivAt (fun z' => ∫ z in X..z', F_act z) (F_act (μ u)) (μ u) :=
        intervalIntegral.integral_hasDerivAt_right
          (hF_cont.intervalIntegrable X (μ u))
          (hF_cont.stronglyMeasurableAtFilter MeasureTheory.volume (nhds (μ u)))
          hF_cont.continuousAt
      have hcomp := (hInt_d.comp u (hμ_deriv u)).const_mul (Real.exp (w X))
      change HasDerivAt g_act
        (Real.exp (w X) * (F_act (μ u) * ((1 / 2 : ℝ) * Real.exp (w (X + u) - w (μ u))))) u
        at hcomp
      convert hcomp using 1
      dsimp [F_act, realActionH0, realActE, realActS]
      change u * ((1 / 4 : ℝ) * (Real.exp (2 * w X + w (X + u) - 3 * w (μ u)) *
          realActG w X u 0 * (∫ r in (0 : ℝ)..1, Real.cos (r * ψ₀ u)))) =
        Real.exp (w X) * ((Real.sin (primPhi_ℝ w (μ u) - primPhi_ℝ w X) *
          Real.exp (-2 * w (μ u))) * ((1 / 2 : ℝ) * Real.exp (w (X + u) - w (μ u))))
      rw [hPsi_mid u, hSinc (ψ₀ u)]
      dsimp [ψ₀]
      have hexp_comb : Real.exp (2 * w X + w (X + u) - 3 * w (μ u)) =
          Real.exp (w X) * Real.exp (w X) * Real.exp (-2 * w (μ u)) *
            Real.exp (w (X + u) - w (μ u)) := by
        simp only [← Real.exp_add]
        congr 1
        ring
      rw [hexp_comb]
      ring

    
    let μ₁ : ℝ → ℝ := fun u => (1 / 2 : ℝ) * Real.exp (w (X + u) - w (μ u))
    let μ₂ : ℝ → ℝ := fun u => μ₁ u * (iteratedDeriv 1 w (X + u) - iteratedDeriv 1 w (μ u) * μ₁ u)
    let μ₃ : ℝ → ℝ := fun u =>
      μ₂ u * (iteratedDeriv 1 w (X + u) - iteratedDeriv 1 w (μ u) * μ₁ u) +
        μ₁ u * (iteratedDeriv 2 w (X + u) - iteratedDeriv 2 w (μ u) * (μ₁ u) ^ 2 -
          iteratedDeriv 1 w (μ u) * μ₂ u)
    let L₀ : ℝ → ℝ := fun u => 2 * w X + w (X + u) - 3 * w (μ u)
    let L₁ : ℝ → ℝ := fun u => iteratedDeriv 1 w (X + u) - 3 * iteratedDeriv 1 w (μ u) * μ₁ u
    let L₂ : ℝ → ℝ := fun u =>
      iteratedDeriv 2 w (X + u) - 3 * iteratedDeriv 2 w (μ u) * (μ₁ u) ^ 2 -
        3 * iteratedDeriv 1 w (μ u) * μ₂ u
    let L₃ : ℝ → ℝ := fun u =>
      iteratedDeriv 3 w (X + u) - 3 * iteratedDeriv 3 w (μ u) * (μ₁ u) ^ 3 -
        9 * iteratedDeriv 2 w (μ u) * μ₁ u * μ₂ u - 3 * iteratedDeriv 1 w (μ u) * μ₃ u

    have hE_derivs : ∀ u : ℝ,
        HasDerivAt (fun u' => realActE w X u' 0) (realActE w X u 1) u ∧
        HasDerivAt (fun u' => realActE w X u' 1) (realActE w X u 2) u ∧
        HasDerivAt (fun u' => realActE w X u' 2) (realActE w X u 3) u := by
      intro u
      have hw0_u : HasDerivAt (fun u' => w (X + u')) (iteratedDeriv 1 w (X + u)) u :=
        ((hw_d0 (X + u)).comp u ((hasDerivAt_id u).const_add X)).congr_deriv (mul_one _)
      have hw1_u : HasDerivAt (fun u' => iteratedDeriv 1 w (X + u'))
          (iteratedDeriv 2 w (X + u)) u :=
        ((hw_d1 (X + u)).comp u ((hasDerivAt_id u).const_add X)).congr_deriv (mul_one _)
      have hw2_u : HasDerivAt (fun u' => iteratedDeriv 2 w (X + u'))
          (iteratedDeriv 3 w (X + u)) u :=
        ((hw_d2 (X + u)).comp u ((hasDerivAt_id u).const_add X)).congr_deriv (mul_one _)
      have hw0_μ : HasDerivAt (fun u' => w (μ u')) (iteratedDeriv 1 w (μ u) * μ₁ u) u :=
        (hw_d0 (μ u)).comp u (hμ_deriv u)
      have hw1_μ : HasDerivAt (fun u' => iteratedDeriv 1 w (μ u'))
          (iteratedDeriv 2 w (μ u) * μ₁ u) u :=
        (hw_d1 (μ u)).comp u (hμ_deriv u)
      have hw2_μ : HasDerivAt (fun u' => iteratedDeriv 2 w (μ u'))
          (iteratedDeriv 3 w (μ u) * μ₁ u) u :=
        (hw_d2 (μ u)).comp u (hμ_deriv u)
      have hμ₁_d : HasDerivAt μ₁ (μ₂ u) u :=
        ((hw0_u.sub hw0_μ).exp.const_mul (1 / 2 : ℝ)).congr_deriv (by dsimp [μ₁, μ₂]; ring)
      have hμ₂_d : HasDerivAt μ₂ (μ₃ u) u :=
        (hμ₁_d.mul (hw1_u.sub (hw1_μ.mul hμ₁_d))).congr_deriv (by dsimp [μ₂, μ₃]; ring)
      have hL₀_d : HasDerivAt L₀ (L₁ u) u :=
        (((hasDerivAt_const u (2 * w X)).add hw0_u).sub (hw0_μ.const_mul 3)).congr_deriv
          (by dsimp [L₁]; ring)
      have hL₁_d : HasDerivAt L₁ (L₂ u) u :=
        (hw1_u.sub ((hw1_μ.const_mul 3).mul hμ₁_d)).congr_deriv (by dsimp [L₂]; ring)
      have hL₂_d : HasDerivAt L₂ (L₃ u) u := by
        have hμ₁_sq : HasDerivAt (fun u' => (μ₁ u') ^ 2) (2 * μ₁ u * μ₂ u) u :=
          (hμ₁_d.pow 2).congr_deriv (by dsimp; ring)
        exact ((hw2_u.sub ((hw2_μ.const_mul 3).mul hμ₁_sq)).sub
          ((hw1_μ.const_mul 3).mul hμ₂_d)).congr_deriv (by dsimp [L₃]; ring)
      have hE0_d : HasDerivAt (fun u' => realActE w X u' 0) (realActE w X u 1) u := by
        change HasDerivAt (fun u' => Real.exp (L₀ u')) (L₁ u * Real.exp (L₀ u)) u
        exact hL₀_d.exp.congr_deriv (by ring)
      have hE1_d : HasDerivAt (fun u' => realActE w X u' 1) (realActE w X u 2) u := by
        change HasDerivAt (fun u' => L₁ u' * Real.exp (L₀ u'))
          ((L₂ u + (L₁ u) ^ 2) * Real.exp (L₀ u)) u
        exact (hL₁_d.mul hL₀_d.exp).congr_deriv (by ring)
      have hE2_d : HasDerivAt (fun u' => realActE w X u' 2) (realActE w X u 3) u := by
        change HasDerivAt (fun u' => (L₂ u' + (L₁ u') ^ 2) * Real.exp (L₀ u'))
          ((L₃ u + 3 * L₁ u * L₂ u + (L₁ u) ^ 3) * Real.exp (L₀ u)) u
        have hL₁_sq : HasDerivAt (fun u' => (L₁ u') ^ 2) (2 * L₁ u * L₂ u) u :=
          (hL₁_d.pow 2).congr_deriv (by dsimp; ring)
        exact ((hL₂_d.add hL₁_sq).mul hL₀_d.exp).congr_deriv (by dsimp; ring)
      exact ⟨hE0_d, hE1_d, hE2_d⟩

    have hE0_cont : Continuous (fun u => realActE w X u 0) :=
      Differentiable.continuous fun u => (hE_derivs u).1.differentiableAt
    have hE3_cont : Continuous (fun u => realActE w X u 3) := by
      change Continuous (fun u => (L₃ u + 3 * L₁ u * L₂ u + (L₁ u) ^ 3) * Real.exp (L₀ u))
      dsimp [L₀, L₁, L₂, L₃, μ₃, μ₂, μ₁]
      fun_prop

    
    let gI₀ : ℝ → ℝ → ℝ := fun u s => Real.exp (w (X + s * u) - w X)
    let gI₁ : ℝ → ℝ → ℝ := fun u s =>
      s * (iteratedDeriv 1 w (X + s * u) * Real.exp (w (X + s * u) - w X))
    let gI₂ : ℝ → ℝ → ℝ := fun u s =>
      s ^ 2 * ((iteratedDeriv 2 w (X + s * u) + (iteratedDeriv 1 w (X + s * u)) ^ 2) *
        Real.exp (w (X + s * u) - w X))
    let gI₃ : ℝ → ℝ → ℝ := fun u s =>
      s ^ 3 * ((iteratedDeriv 3 w (X + s * u) +
        3 * iteratedDeriv 1 w (X + s * u) * iteratedDeriv 2 w (X + s * u) +
        (iteratedDeriv 1 w (X + s * u)) ^ 3) * Real.exp (w (X + s * u) - w X))

    have hgI0_cont : Continuous (fun p : ℝ × ℝ => gI₀ p.1 p.2) := by dsimp [gI₀]; fun_prop
    have hgI1_cont : Continuous (fun p : ℝ × ℝ => gI₁ p.1 p.2) := by dsimp [gI₁]; fun_prop
    have hgI2_cont : Continuous (fun p : ℝ × ℝ => gI₂ p.1 p.2) := by dsimp [gI₂]; fun_prop
    have hgI3_cont : Continuous (fun p : ℝ × ℝ => gI₃ p.1 p.2) := by dsimp [gI₃]; fun_prop

    have hG0_pack := hUnitInt gI₀ gI₁ hgI0_cont hgI1_cont (by
      intro u s
      have hlin : HasDerivAt (fun u' => X + s * u') s u :=
        (((hasDerivAt_id u).const_mul s).const_add X).congr_deriv (mul_one _)
      have hw0 := ((hw_d0 (X + s * u)).comp u hlin).sub_const (w X)
      exact hw0.exp.congr_deriv (by dsimp [gI₁]; ring))
    have hG1_pack := hUnitInt gI₁ gI₂ hgI1_cont hgI2_cont (by
      intro u s
      have hlin : HasDerivAt (fun u' => X + s * u') s u :=
        (((hasDerivAt_id u).const_mul s).const_add X).congr_deriv (mul_one _)
      have hw0 := ((hw_d0 (X + s * u)).comp u hlin).sub_const (w X)
      have hw1 := (hw_d1 (X + s * u)).comp u hlin
      exact ((hw1.mul hw0.exp).const_mul s).congr_deriv (by dsimp [gI₂]; ring))
    have hG2_pack := hUnitInt gI₂ gI₃ hgI2_cont hgI3_cont (by
      intro u s
      have hlin : HasDerivAt (fun u' => X + s * u') s u :=
        (((hasDerivAt_id u).const_mul s).const_add X).congr_deriv (mul_one _)
      have hw0 := ((hw_d0 (X + s * u)).comp u hlin).sub_const (w X)
      have hw1 := (hw_d1 (X + s * u)).comp u hlin
      have hw2 := (hw_d2 (X + s * u)).comp u hlin
      have hw1_sq : HasDerivAt (fun u' => (iteratedDeriv 1 w (X + s * u')) ^ 2)
          (2 * iteratedDeriv 1 w (X + s * u) * (iteratedDeriv 2 w (X + s * u) * s)) u :=
        (hw1.pow 2).congr_deriv (by dsimp; ring)
      exact (((hw2.add hw1_sq).mul hw0.exp).const_mul (s ^ 2)).congr_deriv
        (by dsimp [gI₃]; ring))
    have hG0_cont : Continuous (fun u => realActG w X u 0) := hG0_pack.1
    have hG3_cont : Continuous (fun u => realActG w X u 3) :=
      intervalIntegral.continuous_parametric_intervalIntegral_of_continuous'
        (f := gI₃) hgI3_cont 0 1

    
    let sI₀ : ℝ → ℝ → ℝ := fun z r => Real.cos (r * z)
    let sI₁ : ℝ → ℝ → ℝ := fun z r => -(r * Real.sin (r * z))
    let sI₂ : ℝ → ℝ → ℝ := fun z r => -(r ^ 2 * Real.cos (r * z))
    let sI₃ : ℝ → ℝ → ℝ := fun z r => r ^ 3 * Real.sin (r * z)
    have hsI0_cont : Continuous (fun p : ℝ × ℝ => sI₀ p.1 p.2) := by dsimp [sI₀]; fun_prop
    have hsI1_cont : Continuous (fun p : ℝ × ℝ => sI₁ p.1 p.2) := by dsimp [sI₁]; fun_prop
    have hsI2_cont : Continuous (fun p : ℝ × ℝ => sI₂ p.1 p.2) := by dsimp [sI₂]; fun_prop
    have hsI3_cont : Continuous (fun p : ℝ × ℝ => sI₃ p.1 p.2) := by dsimp [sI₃]; fun_prop

    have hsc0_pack := hUnitInt sI₀ sI₁ hsI0_cont hsI1_cont (by
      intro z r
      have hlin : HasDerivAt (fun z' => r * z') r z :=
        ((hasDerivAt_id z).const_mul r).congr_deriv (mul_one _)
      exact hlin.cos.congr_deriv (by dsimp [sI₁]; ring))
    have hsc1_pack := hUnitInt sI₁ sI₂ hsI1_cont hsI2_cont (by
      intro z r
      have hlin : HasDerivAt (fun z' => r * z') r z :=
        ((hasDerivAt_id z).const_mul r).congr_deriv (mul_one _)
      exact ((hlin.sin.const_mul r).neg).congr_deriv (by dsimp [sI₂]; ring))
    have hsc2_pack := hUnitInt sI₂ sI₃ hsI2_cont hsI3_cont (by
      intro z r
      have hlin : HasDerivAt (fun z' => r * z') r z :=
        ((hasDerivAt_id z).const_mul r).congr_deriv (mul_one _)
      exact ((hlin.cos.const_mul (r ^ 2)).neg).congr_deriv (by dsimp [sI₃]; ring))
    let sc₀ : ℝ → ℝ := fun z => ∫ r in (0 : ℝ)..1, sI₀ z r
    let sc₁ : ℝ → ℝ := fun z => ∫ r in (0 : ℝ)..1, sI₁ z r
    let sc₂ : ℝ → ℝ := fun z => ∫ r in (0 : ℝ)..1, sI₂ z r
    let sc₃ : ℝ → ℝ := fun z => ∫ r in (0 : ℝ)..1, sI₃ z r
    have hsc3_cont : Continuous sc₃ :=
      intervalIntegral.continuous_parametric_intervalIntegral_of_continuous'
        (f := sI₃) hsI3_cont 0 1

    let ψ₁ : ℝ → ℝ := fun u => (1 / 2 : ℝ) * Real.exp (w (X + u))
    let ψ₂ : ℝ → ℝ := fun u => (1 / 2 : ℝ) * iteratedDeriv 1 w (X + u) * Real.exp (w (X + u))
    let ψ₃ : ℝ → ℝ := fun u =>
      (1 / 2 : ℝ) * (iteratedDeriv 2 w (X + u) + (iteratedDeriv 1 w (X + u)) ^ 2) *
        Real.exp (w (X + u))

    have hS_derivs : ∀ u : ℝ,
        HasDerivAt (fun u' => realActS w X u' 0) (realActS w X u 1) u ∧
        HasDerivAt (fun u' => realActS w X u' 1) (realActS w X u 2) u ∧
        HasDerivAt (fun u' => realActS w X u' 2) (realActS w X u 3) u := by
      intro u
      have hw0_u : HasDerivAt (fun u' => w (X + u')) (iteratedDeriv 1 w (X + u)) u :=
        ((hw_d0 (X + u)).comp u ((hasDerivAt_id u).const_add X)).congr_deriv (mul_one _)
      have hw1_u : HasDerivAt (fun u' => iteratedDeriv 1 w (X + u'))
          (iteratedDeriv 2 w (X + u)) u :=
        ((hw_d1 (X + u)).comp u ((hasDerivAt_id u).const_add X)).congr_deriv (mul_one _)
      have hψ₀_d : HasDerivAt ψ₀ (ψ₁ u) u := by
        have hprim_eq : ψ₀ = fun u' => (1 / 2 : ℝ) * (primPhi_ℝ w (X + u') - primPhi_ℝ w X) :=
          funext hPsi_prim
        rw [hprim_eq]
        have hp : HasDerivAt (fun u' => primPhi_ℝ w (X + u')) (Real.exp (w (X + u))) u :=
          ((hPhi_deriv w hw (X + u)).comp u ((hasDerivAt_id u).const_add X)).congr_deriv (mul_one _)
        exact (hp.sub_const (primPhi_ℝ w X)).const_mul (1 / 2 : ℝ)
      have hψ₁_d : HasDerivAt ψ₁ (ψ₂ u) u :=
        (hw0_u.exp.const_mul (1 / 2 : ℝ)).congr_deriv (by dsimp [ψ₂]; ring)
      have hψ₂_d : HasDerivAt ψ₂ (ψ₃ u) u :=
        (((hw1_u.const_mul (1 / 2 : ℝ)).mul hw0_u.exp)).congr_deriv (by dsimp [ψ₃]; ring)
      have hS0_d : HasDerivAt (fun u' => realActS w X u' 0) (realActS w X u 1) u :=
        (hsc0_pack.2 (ψ₀ u)).comp u hψ₀_d
      have hS1_d : HasDerivAt (fun u' => realActS w X u' 1) (realActS w X u 2) u := by
        change HasDerivAt (fun u' => sc₁ (ψ₀ u') * ψ₁ u')
          (sc₂ (ψ₀ u) * (ψ₁ u) ^ 2 + sc₁ (ψ₀ u) * ψ₂ u) u
        exact (((hsc1_pack.2 (ψ₀ u)).comp u hψ₀_d).mul hψ₁_d).congr_deriv
          (by dsimp [sc₁, sc₂]; ring)
      have hS2_d : HasDerivAt (fun u' => realActS w X u' 2) (realActS w X u 3) u := by
        change HasDerivAt (fun u' => sc₂ (ψ₀ u') * (ψ₁ u') ^ 2 + sc₁ (ψ₀ u') * ψ₂ u')
          (sc₃ (ψ₀ u) * (ψ₁ u) ^ 3 + 3 * sc₂ (ψ₀ u) * ψ₁ u * ψ₂ u + sc₁ (ψ₀ u) * ψ₃ u) u
        have hψ₁_sq : HasDerivAt (fun u' => (ψ₁ u') ^ 2) (2 * ψ₁ u * ψ₂ u) u :=
          (hψ₁_d.pow 2).congr_deriv (by dsimp; ring)
        exact ((((hsc2_pack.2 (ψ₀ u)).comp u hψ₀_d).mul hψ₁_sq).add
          (((hsc1_pack.2 (ψ₀ u)).comp u hψ₀_d).mul hψ₂_d)).congr_deriv
          (by dsimp [sc₁, sc₂, sc₃]; ring)
      exact ⟨hS0_d, hS1_d, hS2_d⟩

    have hS0_cont : Continuous (fun u => realActS w X u 0) :=
      Differentiable.continuous fun u => (hS_derivs u).1.differentiableAt
    have hS3_cont : Continuous (fun u => realActS w X u 3) := by
      have hψ₀_cont : Continuous ψ₀ := by dsimp [ψ₀]; fun_prop
      have hsc1_c : Continuous sc₁ := hsc1_pack.1
      have hsc2_c : Continuous sc₂ := hsc2_pack.1
      change Continuous (fun u =>
        sc₃ (ψ₀ u) * (ψ₁ u) ^ 3 + 3 * sc₂ (ψ₀ u) * ψ₁ u * ψ₂ u + sc₁ (ψ₀ u) * ψ₃ u)
      dsimp [ψ₁, ψ₂, ψ₃]
      fun_prop

    
    have hE0_0 : realActE w X 0 0 = 1 := by
      change Real.exp (2 * w X + w (X + 0) - 3 * w (μ 0)) = 1
      rw [add_zero, hμ0]
      have hz : 2 * w X + w X - 3 * w X = 0 := by ring
      rw [hz, Real.exp_zero]
    have hE1_0 : realActE w X 0 1 = -(1 / 2 : ℝ) * iteratedDeriv 1 w X := by
      change L₁ 0 * Real.exp (L₀ 0) = -(1 / 2 : ℝ) * iteratedDeriv 1 w X
      dsimp [L₀, L₁, μ₁]
      rw [add_zero, hμ0, sub_self, Real.exp_zero]
      have hz : 2 * w X + w X - 3 * w X = 0 := by ring
      rw [hz, Real.exp_zero]
      ring
    have hE2_0 : realActE w X 0 2 =
        (1 / 4 : ℝ) * iteratedDeriv 2 w X - (1 / 2 : ℝ) * (iteratedDeriv 1 w X) ^ 2 := by
      change (L₂ 0 + (L₁ 0) ^ 2) * Real.exp (L₀ 0) =
        (1 / 4 : ℝ) * iteratedDeriv 2 w X - (1 / 2 : ℝ) * (iteratedDeriv 1 w X) ^ 2
      dsimp [L₀, L₁, L₂, μ₂, μ₁]
      rw [add_zero, hμ0, sub_self, Real.exp_zero]
      have hz : 2 * w X + w X - 3 * w X = 0 := by ring
      rw [hz, Real.exp_zero]
      ring
    have hG0_0 : realActG w X 0 0 = 1 := by
      dsimp [realActG]
      simp
    have hG1_0 : realActG w X 0 1 = (1 / 2 : ℝ) * iteratedDeriv 1 w X := by
      dsimp [realActG]
      have heq : (fun s : ℝ =>
          s * (iteratedDeriv 1 w (X + s * 0) * Real.exp (w (X + s * 0) - w X))) =
          fun s : ℝ => iteratedDeriv 1 w X * s ^ 1 := by
        funext s
        simp [mul_comm]
      rw [heq, intervalIntegral.integral_const_mul, integral_pow]
      ring
    have hG2_0 : realActG w X 0 2 =
        (1 / 3 : ℝ) * (iteratedDeriv 2 w X + (iteratedDeriv 1 w X) ^ 2) := by
      dsimp [realActG]
      have heq : (fun s : ℝ =>
          s ^ 2 * ((iteratedDeriv 2 w (X + s * 0) + (iteratedDeriv 1 w (X + s * 0)) ^ 2) *
            Real.exp (w (X + s * 0) - w X))) =
          fun s : ℝ => (iteratedDeriv 2 w X + (iteratedDeriv 1 w X) ^ 2) * s ^ 2 := by
        funext s
        simp [mul_comm]
      rw [heq, intervalIntegral.integral_const_mul, integral_pow]
      ring
    have hψ₀_0 : ψ₀ 0 = 0 := by
      dsimp [ψ₀]
      ring
    have hS0_0 : realActS w X 0 0 = 1 := by
      change sc₀ (ψ₀ 0) = 1
      rw [hψ₀_0]
      dsimp [sc₀, sI₀]
      simp
    have hS1_0 : realActS w X 0 1 = 0 := by
      change sc₁ (ψ₀ 0) * ψ₁ 0 = 0
      rw [hψ₀_0]
      dsimp [sc₁, sI₁]
      simp
    have hS2_0 : realActS w X 0 2 = -(1 / 12 : ℝ) * Real.exp (2 * w X) := by
      change sc₂ (ψ₀ 0) * (ψ₁ 0) ^ 2 + sc₁ (ψ₀ 0) * ψ₂ 0 = -(1 / 12 : ℝ) * Real.exp (2 * w X)
      rw [hψ₀_0]
      have hsc1_0 : sc₁ 0 = 0 := by dsimp [sc₁, sI₁]; simp
      have hsc2_0 : sc₂ 0 = -(1 / 3 : ℝ) := by
        dsimp [sc₂, sI₂]
        have heq : (fun r : ℝ => -(r ^ 2 * Real.cos (r * 0))) = fun r : ℝ => (-1 : ℝ) * r ^ 2 := by
          funext r
          simp
        rw [heq, intervalIntegral.integral_const_mul, integral_pow]
        norm_num
      have hψ1_sq0 : (ψ₁ 0) ^ 2 = (1 / 4 : ℝ) * Real.exp (2 * w X) := by
        dsimp [ψ₁]
        rw [add_zero, mul_pow, sq (Real.exp (w X)), ← Real.exp_add, ← two_mul]
        ring
      rw [hsc1_0, hsc2_0, hψ1_sq0]
      ring

    
    let H₀ : ℝ → ℝ := fun u => realActionH0 w X u
    let H₁ : ℝ → ℝ := fun u =>
      (1 / 4 : ℝ) * (realActE w X u 1 * realActG w X u 0 * realActS w X u 0 +
        realActE w X u 0 * realActG w X u 1 * realActS w X u 0 +
        realActE w X u 0 * realActG w X u 0 * realActS w X u 1)
    let H₂ : ℝ → ℝ := fun u =>
      (1 / 4 : ℝ) * (realActE w X u 2 * realActG w X u 0 * realActS w X u 0 +
        realActE w X u 0 * realActG w X u 2 * realActS w X u 0 +
        realActE w X u 0 * realActG w X u 0 * realActS w X u 2 +
        2 * (realActE w X u 1 * realActG w X u 1 * realActS w X u 0 +
          realActE w X u 1 * realActG w X u 0 * realActS w X u 1 +
          realActE w X u 0 * realActG w X u 1 * realActS w X u 1))
    let H₃ : ℝ → ℝ := fun u => realActionH3 w X u

    have hH_derivs : ∀ u : ℝ,
        HasDerivAt H₀ (H₁ u) u ∧
        HasDerivAt H₁ (H₂ u) u ∧
        HasDerivAt H₂ (H₃ u) u := by
      intro u
      obtain ⟨hE0, hE1, hE2⟩ := hE_derivs u
      have hG0 : HasDerivAt (fun u' => realActG w X u' 0) (realActG w X u 1) u := hG0_pack.2 u
      have hG1 : HasDerivAt (fun u' => realActG w X u' 1) (realActG w X u 2) u := hG1_pack.2 u
      have hG2 : HasDerivAt (fun u' => realActG w X u' 2) (realActG w X u 3) u := hG2_pack.2 u
      obtain ⟨hS0, hS1, hS2⟩ := hS_derivs u
      have hd0 : HasDerivAt H₀ (H₁ u) u :=
        (((hE0.mul hG0).mul hS0).const_mul (1 / 4 : ℝ)).congr_deriv (by dsimp [H₁]; ring)
      have hd1 : HasDerivAt H₁ (H₂ u) u := by
        have t1 := (hE1.mul hG0).mul hS0
        have t2 := (hE0.mul hG1).mul hS0
        have t3 := (hE0.mul hG0).mul hS1
        exact (((t1.add t2).add t3).const_mul (1 / 4 : ℝ)).congr_deriv (by dsimp [H₂]; ring)
      have hd2 : HasDerivAt H₂ (H₃ u) u := by
        have t1 := (hE2.mul hG0).mul hS0
        have t2 := (hE0.mul hG2).mul hS0
        have t3 := (hE0.mul hG0).mul hS2
        have t4 := (hE1.mul hG1).mul hS0
        have t5 := (hE1.mul hG0).mul hS1
        have t6 := (hE0.mul hG1).mul hS1
        exact ((((t1.add t2).add t3).add (((t4.add t5).add t6).const_mul 2)).const_mul
          (1 / 4 : ℝ)).congr_deriv (by dsimp [H₃, realActionH3]; ring)
      exact ⟨hd0, hd1, hd2⟩

    have hH0_cont : Continuous H₀ := by dsimp [H₀, realActionH0]; fun_prop
    have hH3_cont : Continuous H₃ := by
      have hE1_c : Continuous (fun u => realActE w X u 1) :=
        Differentiable.continuous fun u => (hE_derivs u).2.1.differentiableAt
      have hE2_c : Continuous (fun u => realActE w X u 2) :=
        Differentiable.continuous fun u => (hE_derivs u).2.2.differentiableAt
      have hG1_c : Continuous (fun u => realActG w X u 1) := hG1_pack.1
      have hG2_c : Continuous (fun u => realActG w X u 2) := hG2_pack.1
      have hS1_c : Continuous (fun u => realActS w X u 1) :=
        Differentiable.continuous fun u => (hS_derivs u).2.1.differentiableAt
      have hS2_c : Continuous (fun u => realActS w X u 2) :=
        Differentiable.continuous fun u => (hS_derivs u).2.2.differentiableAt
      dsimp [H₃, realActionH3]
      fun_prop

    have hH0_0 : H₀ 0 = 1 / 4 := by
      dsimp [H₀, realActionH0]
      rw [hE0_0, hG0_0, hS0_0]
      ring
    have hH1_0 : H₁ 0 = 0 := by
      dsimp [H₁]
      rw [hE0_0, hE1_0, hG0_0, hG1_0, hS0_0, hS1_0]
      ring
    have hH2_0 : H₂ 0 = 8 * realJetA w X := by
      dsimp [H₂, realJetA]
      rw [hE0_0, hE1_0, hE2_0, hG0_0, hG1_0, hG2_0, hS0_0, hS1_0, hS2_0]
      ring

    
    have hH0_taylor : ∀ y : ℝ,
        H₀ y = 1 / 4 + 4 * realJetA w X * y ^ 2 +
          (1 / 2 : ℝ) * y ^ 3 * ∫ τ in (0 : ℝ)..1, (1 - τ) ^ 2 * H₃ (τ * y) := by
      intro y
      let T_fn : ℝ → ℝ := fun τ =>
        H₀ (τ * y) + (1 - τ) * y * H₁ (τ * y) + (1 / 2 : ℝ) * (1 - τ) ^ 2 * y ^ 2 * H₂ (τ * y)
      have hT_deriv : ∀ τ ∈ Set.uIcc (0 : ℝ) 1,
          HasDerivAt T_fn ((1 / 2 : ℝ) * y ^ 3 * ((1 - τ) ^ 2 * H₃ (τ * y))) τ := by
        intro τ _
        have hlin : HasDerivAt (fun τ' => τ' * y) y τ :=
          ((hasDerivAt_id τ).mul_const y).congr_deriv (one_mul _)
        obtain ⟨hd0, hd1, hd2⟩ := hH_derivs (τ * y)
        have h1_raw := HasDerivAt.comp τ hd0 hlin
        have h1 : HasDerivAt (fun τ' => H₀ (τ' * y)) (H₁ (τ * y) * y) τ := h1_raw
        have hc1 : HasDerivAt (fun τ' => (1 - τ') * y) (-y) τ :=
          (((hasDerivAt_const τ (1 : ℝ)).sub (hasDerivAt_id τ)).mul_const y).congr_deriv
            (by ring)
        have h2_raw := hc1.mul (HasDerivAt.comp τ hd1 hlin)
        have h2 : HasDerivAt (fun τ' => (1 - τ') * y * H₁ (τ' * y))
            (-y * H₁ (τ * y) + (1 - τ) * y * (H₂ (τ * y) * y)) τ := h2_raw
        have hc2 : HasDerivAt (fun τ' => (1 / 2 : ℝ) * (1 - τ') ^ 2 * y ^ 2)
            (-(1 - τ) * y ^ 2) τ :=
          (((((hasDerivAt_const τ (1 : ℝ)).sub (hasDerivAt_id τ)).pow 2).const_mul
            (1 / 2 : ℝ)).mul_const (y ^ 2)).congr_deriv (by dsimp; ring)
        have h3_raw := hc2.mul (HasDerivAt.comp τ hd2 hlin)
        have h3 : HasDerivAt (fun τ' => (1 / 2 : ℝ) * (1 - τ') ^ 2 * y ^ 2 * H₂ (τ' * y))
            (-(1 - τ) * y ^ 2 * H₂ (τ * y) + (1 / 2 : ℝ) * (1 - τ) ^ 2 * y ^ 2 * (H₃ (τ * y) * y)) τ := h3_raw
        exact ((h1.add h2).add h3).congr_deriv (by ring)
      have hrem_cont : Continuous (fun τ : ℝ =>
          (1 / 2 : ℝ) * y ^ 3 * ((1 - τ) ^ 2 * H₃ (τ * y))) := by fun_prop
      have hftc := intervalIntegral.integral_eq_sub_of_hasDerivAt hT_deriv
        (hrem_cont.intervalIntegrable 0 1)
      rw [intervalIntegral.integral_const_mul] at hftc
      have hT1 : T_fn 1 = H₀ y := by
        dsimp [T_fn]
        rw [one_mul]
        ring
      have hT0 : T_fn 0 = 1 / 4 + 4 * realJetA w X * y ^ 2 := by
        dsimp [T_fn]
        rw [zero_mul, hH0_0, hH1_0, hH2_0]
        ring
      linarith

    
    have hg_rescaled : normAction1_ℝ w X (X + T) =
        T ^ 2 * ∫ r in (0 : ℝ)..1, r * H₀ (r * T) := by
      have hd : ∀ r ∈ Set.uIcc (0 : ℝ) 1,
          HasDerivAt (fun r' : ℝ => g_act (r' * T)) (T ^ 2 * (r * H₀ (r * T))) r := by
        intro r _
        have hlin : HasDerivAt (fun r' => r' * T) T r :=
          ((hasDerivAt_id r).mul_const T).congr_deriv (one_mul _)
        have hc_raw := HasDerivAt.comp r (hg_deriv (r * T)) hlin
        have hc : HasDerivAt (fun r' : ℝ => g_act (r' * T))
            ((r * T * realActionH0 w X (r * T)) * T) r := hc_raw
        exact hc.congr_deriv (by change _ = T ^ 2 * (r * realActionH0 w X (r * T)); ring)
      have hcont : Continuous (fun r : ℝ => T ^ 2 * (r * H₀ (r * T))) := by fun_prop
      have hftc := intervalIntegral.integral_eq_sub_of_hasDerivAt hd
        (hcont.intervalIntegrable 0 1)
      rw [intervalIntegral.integral_const_mul, one_mul, zero_mul, hg0, sub_zero] at hftc
      exact hftc.symm

    
    let rem_r : ℝ → ℝ := fun r =>
      r ^ 4 * ∫ τ in (0 : ℝ)..1, (1 - τ) ^ 2 * H₃ (τ * r * T)
    have hrem_r_cont : Continuous rem_r := by
      have hinner : Continuous (fun r : ℝ =>
          ∫ τ in (0 : ℝ)..1, (1 - τ) ^ 2 * H₃ (τ * r * T)) :=
        intervalIntegral.continuous_parametric_intervalIntegral_of_continuous'
          (f := fun r τ => (1 - τ) ^ 2 * H₃ (τ * r * T)) (by fun_prop) 0 1
      dsimp [rem_r]
      fun_prop
    have hint_eq : (fun r : ℝ => r * H₀ (r * T)) = fun r : ℝ =>
        ((1 / 4 : ℝ) * r ^ 1 + (4 * realJetA w X * T ^ 2) * r ^ 3) +
          ((1 / 2 : ℝ) * T ^ 3) * rem_r r := by
      funext r
      rw [hH0_taylor (r * T)]
      have hassoc : (∫ τ in (0 : ℝ)..1, (1 - τ) ^ 2 * H₃ (τ * (r * T))) =
          ∫ τ in (0 : ℝ)..1, (1 - τ) ^ 2 * H₃ (τ * r * T) := by
        congr 1
        funext τ
        rw [mul_assoc]
      rw [hassoc]
      dsimp [rem_r]
      ring
    have h12_cont : Continuous (fun r : ℝ =>
        (1 / 4 : ℝ) * r ^ 1 + (4 * realJetA w X * T ^ 2) * r ^ 3) := by fun_prop
    have h3_cont : Continuous (fun r : ℝ => ((1 / 2 : ℝ) * T ^ 3) * rem_r r) := by fun_prop
    have h1_cont : Continuous (fun r : ℝ => (1 / 4 : ℝ) * r ^ 1) := by fun_prop
    have h2_cont : Continuous (fun r : ℝ => (4 * realJetA w X * T ^ 2) * r ^ 3) := by fun_prop
    rw [hg_rescaled, hint_eq]
    rw [intervalIntegral.integral_add (h12_cont.intervalIntegrable 0 1)
      (h3_cont.intervalIntegrable 0 1)]
    rw [intervalIntegral.integral_add (h1_cont.intervalIntegrable 0 1)
      (h2_cont.intervalIntegrable 0 1)]
    rw [intervalIntegral.integral_const_mul, intervalIntegral.integral_const_mul,
      intervalIntegral.integral_const_mul]
    rw [integral_pow, integral_pow]
    dsimp [realJetB, rem_r, H₃]
    ring

  exact ⟨{
    primPhi_hasDerivAt := hPhi_deriv
    primPhi_strictMono := hPhi_strictMono
    primPhi_contDiff := hPhi_contDiff
    invPrimPhi_contDiff := hInv_contDiff
    invPrimPhi_hasDerivAt := hInv_deriv
    midpoint_eq := hMid_eq
    midpoint_diag_periodic := hMid_diag_per
    action_factor := hAction_factor
    diff_global_bound := hDiff_bound
  }⟩

theorem real_midpoint_disp_jet_bounds (m : ℕ) (M₁ : ℝ)
    (hm : 2 ≤ m) (hM₁ : 0 < M₁)
    (H_base : RealActionTaylorData m M₁) :
    Nonempty (RealMidpointDispData m M₁) :=
by
  have h_compConst_ge_one : ∀ (k : ℕ) (B : ℝ), 1 ≤ rmdCompConst k B := by
    intro k B
    induction k with
    | zero => simp [rmdCompConst]
    | succ k ih =>
      simp only [rmdCompConst]
      have h1 : (1 : ℝ) ≤ max 1 ((2 : ℝ) ^ k * B) := le_max_left _ _
      nlinarith

  have h_iter_add : ∀ (d j : ℕ) (g : ℝ → ℝ),
      iteratedDeriv j (iteratedDeriv d g) = iteratedDeriv (j + d) g := by
    intro d j g
    induction j with
    | zero => simp [iteratedDeriv_zero]
    | succ j ih =>
      rw [iteratedDeriv_succ, ih, Nat.succ_add, iteratedDeriv_succ]

  have h_contDiff_iter : ∀ (d n : ℕ) (g : ℝ → ℝ),
      ContDiff ℝ ((n + d : ℕ) : WithTop ℕ∞) g →
      ContDiff ℝ (n : WithTop ℕ∞) (iteratedDeriv d g) := by
    intro d
    induction d with
    | zero =>
      intro n g hg
      simpa [iteratedDeriv_zero] using hg
    | succ d ih =>
      intro n g hg
      have hg' : ContDiff ℝ ((n + 1 + d : ℕ) : WithTop ℕ∞) g := by
        convert hg using 2
        omega
      have hd : ContDiff ℝ (((n : WithTop ℕ∞) + 1)) (iteratedDeriv d g) :=
        ih (n + 1) g hg'
      rw [iteratedDeriv_succ]
      exact (contDiff_succ_iff_deriv.mp hd).2.2

  have h_slice_contDiff : ∀ (k n : ℕ) (F : ℝ × ℝ → ℝ),
      k ≤ n → ContDiff ℝ (n : WithTop ℕ∞) F →
      ContDiff ℝ ((n - k : ℕ) : WithTop ℕ∞)
        (fun q : ℝ × ℝ => iteratedDeriv k (fun y => F (q.1, y)) q.2) := by
    intro k
    induction k with
    | zero =>
      intro n F _ hF
      simpa [iteratedDeriv_zero] using hF
    | succ k ih =>
      intro n F hk hF
      let f : (ℝ × ℝ) → ℝ → ℝ := fun q y => F (q.1, y)
      have h_uncurry : ContDiff ℝ (n : WithTop ℕ∞) (Function.uncurry f) :=
        hF.comp ((contDiff_fst.comp contDiff_fst).prodMk contDiff_snd)
      have h_fderiv : ContDiff ℝ ((n - 1 : ℕ) : WithTop ℕ∞)
          (fun q : ℝ × ℝ => (fderiv ℝ (f q) q.2) (1 : ℝ)) :=
        h_uncurry.fderiv_apply contDiff_snd contDiff_const (by norm_cast; omega)
      let F₁ : ℝ × ℝ → ℝ := fun q => deriv (fun y => F (q.1, y)) q.2
      have hF₁ : ContDiff ℝ ((n - 1 : ℕ) : WithTop ℕ∞) F₁ := by
        have hEq : F₁ = fun q : ℝ × ℝ => (fderiv ℝ (f q) q.2) (1 : ℝ) := by
          funext q
          exact (fderiv_apply_one_eq_deriv (f := f q) (x := q.2)).symm
        rwa [hEq]
      have h_step := ih (n - 1) F₁ (by omega) hF₁
      have hEq2 : (fun q : ℝ × ℝ => iteratedDeriv (k + 1) (fun y => F (q.1, y)) q.2) =
          (fun q : ℝ × ℝ => iteratedDeriv k (fun y => F₁ (q.1, y)) q.2) := by
        funext q
        rw [iteratedDeriv_succ']
      rw [hEq2]
      convert h_step using 2
      omega

  have h_jet_const : ∀ (k : ℕ) (c : ℝ), rmdJetBnd k |c| (fun _ => c) := by
    intro k c
    refine ⟨contDiff_const, abs_nonneg c, ?_⟩
    intro j _ x
    rw [iteratedDeriv_const]
    split_ifs <;> simp [abs_nonneg]

  have h_jet_mono : ∀ {k' k : ℕ} {B₁ B₂ : ℝ} {f : ℝ → ℝ},
      k' ≤ k → B₁ ≤ B₂ → rmdJetBnd k B₁ f → rmdJetBnd k' B₂ f := by
    intro k' k B₁ B₂ f hk hB ⟨hf, hB₁, hbnd⟩
    refine ⟨hf.of_le (by norm_cast), le_trans hB₁ hB, ?_⟩
    intro j hj x
    exact le_trans (hbnd j (le_trans hj hk) x) hB

  have h_deriv_of_jet : ∀ {k : ℕ} {B : ℝ} {f : ℝ → ℝ},
      rmdJetBnd k B f → rmdDerivBnd k B f := by
    intro k B f ⟨hf, hB, hbnd⟩
    exact ⟨hf, hB, fun j _ hj x => hbnd j hj x⟩

  have h_deriv_mono : ∀ {k' k : ℕ} {B₁ B₂ : ℝ} {f : ℝ → ℝ},
      k' ≤ k → B₁ ≤ B₂ → rmdDerivBnd k B₁ f → rmdDerivBnd k' B₂ f := by
    intro k' k B₁ B₂ f hk hB ⟨hf, hB₁, hbnd⟩
    refine ⟨hf.of_le (by norm_cast), le_trans hB₁ hB, ?_⟩
    intro j hj1 hj x
    exact le_trans (hbnd j hj1 (le_trans hj hk) x) hB

  have h_deriv_add : ∀ {k : ℕ} {B₁ B₂ : ℝ} {f g : ℝ → ℝ},
      rmdDerivBnd k B₁ f → rmdDerivBnd k B₂ g →
      rmdDerivBnd k (B₁ + B₂) (fun x => f x + g x) := by
    intro k B₁ B₂ f g ⟨hf, hB₁, hbf⟩ ⟨hg, hB₂, hbg⟩
    refine ⟨hf.add hg, add_nonneg hB₁ hB₂, ?_⟩
    intro j hj1 hj x
    rw [iteratedDeriv_fun_add ((hf.of_le (by norm_cast)).contDiffAt)
      ((hg.of_le (by norm_cast)).contDiffAt)]
    exact le_trans (abs_add_le _ _) (add_le_add (hbf j hj1 hj x) (hbg j hj1 hj x))

  have h_deriv_const_mul : ∀ {k : ℕ} {B : ℝ} (c : ℝ) {f : ℝ → ℝ},
      rmdDerivBnd k B f → rmdDerivBnd k (|c| * B) (fun x => c * f x) := by
    intro k B c f ⟨hf, hB, hbf⟩
    refine ⟨contDiff_const.mul hf, mul_nonneg (abs_nonneg c) hB, ?_⟩
    intro j hj1 hj x
    rw [iteratedDeriv_const_mul c ((hf.of_le (by norm_cast)).contDiffAt), abs_mul]
    exact mul_le_mul_of_nonneg_left (hbf j hj1 hj x) (abs_nonneg c)

  have h_jet_of_deriv : ∀ {k : ℕ} {B : ℝ} {f : ℝ → ℝ},
      rmdDerivBnd (k + 1) B f → rmdJetBnd k B (deriv f) := by
    intro k B f ⟨hf, hB, hbnd⟩
    have hf' : ContDiff ℝ (((k : WithTop ℕ∞) + 1)) f := hf
    refine ⟨(contDiff_succ_iff_deriv.mp hf').2.2, hB, ?_⟩
    intro j hj x
    rw [← iteratedDeriv_succ']
    exact hbnd (j + 1) (by omega) (by omega) x

  have h_jet_add : ∀ {k : ℕ} {B₁ B₂ : ℝ} {f g : ℝ → ℝ},
      rmdJetBnd k B₁ f → rmdJetBnd k B₂ g →
      rmdJetBnd k (B₁ + B₂) (fun x => f x + g x) := by
    intro k B₁ B₂ f g ⟨hf, hB₁, hbf⟩ ⟨hg, hB₂, hbg⟩
    refine ⟨hf.add hg, add_nonneg hB₁ hB₂, ?_⟩
    intro j hj x
    rw [iteratedDeriv_fun_add ((hf.of_le (by norm_cast)).contDiffAt)
      ((hg.of_le (by norm_cast)).contDiffAt)]
    exact le_trans (abs_add_le _ _) (add_le_add (hbf j hj x) (hbg j hj x))

  have h_jet_sub : ∀ {k : ℕ} {B₁ B₂ : ℝ} {f g : ℝ → ℝ},
      rmdJetBnd k B₁ f → rmdJetBnd k B₂ g →
      rmdJetBnd k (B₁ + B₂) (fun x => f x - g x) := by
    intro k B₁ B₂ f g ⟨hf, hB₁, hbf⟩ ⟨hg, hB₂, hbg⟩
    refine ⟨hf.sub hg, add_nonneg hB₁ hB₂, ?_⟩
    intro j hj x
    rw [iteratedDeriv_fun_sub ((hf.of_le (by norm_cast)).contDiffAt)
      ((hg.of_le (by norm_cast)).contDiffAt)]
    exact le_trans (abs_sub _ _) (add_le_add (hbf j hj x) (hbg j hj x))

  have h_jet_const_mul : ∀ {k : ℕ} {B : ℝ} (c : ℝ) {f : ℝ → ℝ},
      rmdJetBnd k B f → rmdJetBnd k (|c| * B) (fun x => c * f x) := by
    intro k B c f ⟨hf, hB, hbf⟩
    refine ⟨contDiff_const.mul hf, mul_nonneg (abs_nonneg c) hB, ?_⟩
    intro j hj x
    rw [iteratedDeriv_const_mul c ((hf.of_le (by norm_cast)).contDiffAt), abs_mul]
    exact mul_le_mul_of_nonneg_left (hbf j hj x) (abs_nonneg c)

  have h_jet_mul : ∀ {k : ℕ} {B₁ B₂ : ℝ} {f g : ℝ → ℝ},
      rmdJetBnd k B₁ f → rmdJetBnd k B₂ g →
      rmdJetBnd k ((2 : ℝ) ^ k * B₁ * B₂) (fun x => f x * g x) := by
    intro k B₁ B₂ f g ⟨hf, hB₁, hbf⟩ ⟨hg, hB₂, hbg⟩
    refine ⟨hf.mul hg, by positivity, ?_⟩
    intro j hj x
    rw [iteratedDeriv_fun_mul ((hf.of_le (by norm_cast)).contDiffAt)
      ((hg.of_le (by norm_cast)).contDiffAt)]
    calc
      |∑ i ∈ Finset.range (j + 1), (j.choose i : ℝ) * iteratedDeriv i f x * iteratedDeriv (j - i) g x|
          ≤ ∑ i ∈ Finset.range (j + 1), |(j.choose i : ℝ) * iteratedDeriv i f x * iteratedDeriv (j - i) g x| :=
        Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ i ∈ Finset.range (j + 1), (j.choose i : ℝ) * B₁ * B₂ := by
        apply Finset.sum_le_sum
        intro i hi
        have hi_le : i ≤ j := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
        rw [abs_mul, abs_mul, abs_of_nonneg (Nat.cast_nonneg _)]
        have h1 := hbf i (le_trans hi_le hj) x
        have h2 := hbg (j - i) (le_trans (Nat.sub_le j i) hj) x
        have h12 : |iteratedDeriv i f x| * |iteratedDeriv (j - i) g x| ≤ B₁ * B₂ :=
          mul_le_mul h1 h2 (abs_nonneg _) hB₁
        calc
          (j.choose i : ℝ) * |iteratedDeriv i f x| * |iteratedDeriv (j - i) g x|
              = (j.choose i : ℝ) * (|iteratedDeriv i f x| * |iteratedDeriv (j - i) g x|) := by ring
          _ ≤ (j.choose i : ℝ) * (B₁ * B₂) :=
              mul_le_mul_of_nonneg_left h12 (Nat.cast_nonneg _)
          _ = (j.choose i : ℝ) * B₁ * B₂ := by ring
      _ = (∑ i ∈ Finset.range (j + 1), (j.choose i : ℝ)) * B₁ * B₂ := by
        rw [← Finset.sum_mul, ← Finset.sum_mul]
      _ = (2 : ℝ) ^ j * B₁ * B₂ := by
        have hsum : (∑ i ∈ Finset.range (j + 1), (j.choose i : ℝ)) = (2 : ℝ) ^ j := by
          exact_mod_cast Nat.sum_range_choose j
        rw [hsum]
      _ ≤ (2 : ℝ) ^ k * B₁ * B₂ := by
        have hpow : (2 : ℝ) ^ j ≤ (2 : ℝ) ^ k :=
          pow_le_pow_right₀ (by norm_num) hj
        exact mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hpow hB₁) hB₂

  have h_jet_mul_diff : ∀ {k : ℕ} {M_f M_g L_f L_g : ℝ} {f₁ f₂ g₁ g₂ : ℝ → ℝ},
      rmdJetBnd k M_f f₂ → rmdJetBnd k M_g g₁ →
      rmdJetBnd k L_f (fun x => f₁ x - f₂ x) →
      rmdJetBnd k L_g (fun x => g₁ x - g₂ x) →
      rmdJetBnd k ((2 : ℝ) ^ k * (L_f * M_g + M_f * L_g))
        (fun x => f₁ x * g₁ x - f₂ x * g₂ x) := by
    intro k M_f M_g L_f L_g f₁ f₂ g₁ g₂ hf₂ hg₁ hdf hdg
    have hEq : (fun x => f₁ x * g₁ x - f₂ x * g₂ x) =
        (fun x => (f₁ x - f₂ x) * g₁ x + f₂ x * (g₁ x - g₂ x)) := by
      funext x; ring
    rw [hEq]
    have h1 := h_jet_mul hdf hg₁
    have h2 := h_jet_mul hf₂ hdg
    have h12 := h_jet_add h1 h2
    exact h_jet_mono le_rfl (by linarith) h12

  have h_unit_int_raw : ∀ (k : ℕ) (G : ℝ × ℝ → ℝ),
      ContDiff ℝ (k : WithTop ℕ∞) G →
      ContDiff ℝ (k : WithTop ℕ∞) (fun x : ℝ => ∫ s in (0 : ℝ)..1, G (s, x)) ∧
      ∀ j : ℕ, j ≤ k → ∀ x : ℝ,
        iteratedDeriv j (fun y : ℝ => ∫ s in (0 : ℝ)..1, G (s, y)) x =
          ∫ s in (0 : ℝ)..1, iteratedDeriv j (fun y => G (s, y)) x := by
    intro k
    induction k with
    | zero =>
      intro G hG
      have hswap : Continuous (Function.uncurry (fun (x s : ℝ) => G (s, x))) :=
        hG.continuous.comp continuous_swap
      have hcont : Continuous (fun x : ℝ => ∫ s in (0 : ℝ)..1, G (s, x)) :=
        intervalIntegral.continuous_parametric_intervalIntegral_of_continuous' hswap 0 1
      refine ⟨contDiff_zero.mpr hcont, ?_⟩
      intro j hj x
      have hj0 : j = 0 := Nat.eq_zero_of_le_zero hj
      subst hj0
      simp [iteratedDeriv_zero]
    | succ k ih =>
      intro G hG
      let G₁ : ℝ × ℝ → ℝ := fun q => deriv (fun y => G (q.1, y)) q.2
      have hG₁ : ContDiff ℝ (k : WithTop ℕ∞) G₁ := by
        simpa [Nat.add_sub_cancel] using h_slice_contDiff 1 (k + 1) G (by omega) hG
      have h_hasDeriv : ∀ x₀ : ℝ,
          HasDerivAt (fun x : ℝ => ∫ s in (0 : ℝ)..1, G (s, x))
            (∫ s in (0 : ℝ)..1, G₁ (s, x₀)) x₀ := by
        intro x₀
        have hK : IsCompact (Set.Icc (0 : ℝ) 1 ×ˢ Metric.closedBall x₀ 1) :=
          isCompact_Icc.prod (isCompact_closedBall x₀ 1)
        obtain ⟨B_loc, hB_loc⟩ :=
          hK.exists_bound_of_continuousOn hG₁.continuous.continuousOn
        have hsub_s : Set.uIoc (0 : ℝ) 1 ⊆ Set.Icc (0 : ℝ) 1 := by
          rw [Set.uIoc_of_le zero_le_one]
          exact Set.Ioc_subset_Icc_self
        have h_ne0 : ((k + 1 : ℕ) : WithTop ℕ∞) ≠ 0 := by simp
        have h_res :=
          (intervalIntegral.hasDerivAt_integral_of_dominated_loc_of_deriv_le
            (𝕜 := ℝ) (μ := MeasureTheory.volume) (a := 0) (b := 1)
            (F := fun x s => G (s, x)) (F' := fun x s => G₁ (s, x))
            (x₀ := x₀) (s := Metric.ball x₀ 1) (bound := fun _ => B_loc)
            (Metric.ball_mem_nhds x₀ zero_lt_one)
            (Filter.Eventually.of_forall fun x =>
              (hG.continuous.comp (continuous_id.prodMk continuous_const)).aestronglyMeasurable)
            ((hG.continuous.comp (continuous_id.prodMk continuous_const)).intervalIntegrable 0 1)
            (hG₁.continuous.comp (continuous_id.prodMk continuous_const)).aestronglyMeasurable
            (Filter.Eventually.of_forall fun s hs x hx =>
              hB_loc (s, x) ⟨hsub_s hs, Metric.ball_subset_closedBall hx⟩)
            (intervalIntegrable_const)
            (Filter.Eventually.of_forall fun s _ x _ => by
              have h_slice : ContDiff ℝ ((k + 1 : ℕ) : WithTop ℕ∞) (fun y => G (s, y)) :=
                hG.comp (contDiff_const.prodMk contDiff_id)
              exact (h_slice.differentiable h_ne0).differentiableAt.hasDerivAt)).2
        exact h_res
      have h_deriv_eq : deriv (fun x : ℝ => ∫ s in (0 : ℝ)..1, G (s, x)) =
          (fun x : ℝ => ∫ s in (0 : ℝ)..1, G₁ (s, x)) := by
        funext x₀
        exact (h_hasDeriv x₀).deriv
      obtain ⟨h_cd_G₁, h_iter_G₁⟩ := ih G₁ hG₁
      have h_diff : Differentiable ℝ (fun x : ℝ => ∫ s in (0 : ℝ)..1, G (s, x)) :=
        fun x₀ => (h_hasDeriv x₀).differentiableAt
      have h_cd : ContDiff ℝ (((k : WithTop ℕ∞) + 1))
          (fun x : ℝ => ∫ s in (0 : ℝ)..1, G (s, x)) := by
        rw [contDiff_succ_iff_deriv]
        refine ⟨h_diff, by simp, ?_⟩
        rwa [h_deriv_eq]
      refine ⟨h_cd, ?_⟩
      intro j hj x
      cases j with
      | zero => simp [iteratedDeriv_zero]
      | succ j' =>
        rw [iteratedDeriv_succ', h_deriv_eq, h_iter_G₁ j' (by omega) x]
        congr 1
        funext s
        rw [iteratedDeriv_succ']

  have h_jet_unit_int : ∀ {k : ℕ} {M : ℝ} {G : ℝ × ℝ → ℝ},
      ContDiff ℝ (k : WithTop ℕ∞) G →
      0 ≤ M →
      (∀ s ∈ Set.Icc (0 : ℝ) 1, rmdJetBnd k M (fun x => G (s, x))) →
      rmdJetBnd k M (fun x : ℝ => ∫ s in (0 : ℝ)..1, G (s, x)) := by
    intro k M G hG hM hGs
    obtain ⟨hcd, hiter⟩ := h_unit_int_raw k G hG
    refine ⟨hcd, hM, ?_⟩
    intro j hj x
    rw [hiter j hj x]
    have hsub : Set.uIoc (0 : ℝ) 1 ⊆ Set.Icc (0 : ℝ) 1 := by
      rw [Set.uIoc_of_le zero_le_one]
      exact Set.Ioc_subset_Icc_self
    have hbnd : ‖∫ s in (0 : ℝ)..1, iteratedDeriv j (fun y => G (s, y)) x‖ ≤ M * |(1 : ℝ) - 0| :=
      intervalIntegral.norm_integral_le_of_norm_le_const fun s hs =>
        (hGs s (hsub hs)).2.2 j hj x
    simpa using hbnd

  have h_jet_comp_on : ∀ (k : ℕ) (S : Set ℝ) (M_g B : ℝ) (g f : ℝ → ℝ),
      ContDiff ℝ (k : WithTop ℕ∞) g →
      0 ≤ M_g →
      (∀ j : ℕ, j ≤ k → ∀ z ∈ S, |iteratedDeriv j g z| ≤ M_g) →
      rmdDerivBnd k B f →
      (∀ x : ℝ, f x ∈ S) →
      rmdJetBnd k (M_g * rmdCompConst k B) (fun x => g (f x)) := by
    intro k
    induction k with
    | zero =>
      intro S M_g B g f hg hMg hgbnd hf hfS
      refine ⟨hg.comp hf.1, by simp [rmdCompConst]; exact hMg, ?_⟩
      intro j hj x
      have hj0 : j = 0 := Nat.eq_zero_of_le_zero hj
      subst hj0
      simpa [rmdCompConst, iteratedDeriv_zero] using hgbnd 0 le_rfl (f x) (hfS x)
    | succ k ih =>
      intro S M_g B g f hg hMg hgbnd hf hfS
      have hB : 0 ≤ B := hf.2.1
      have hC_ge : 1 ≤ rmdCompConst (k + 1) B := h_compConst_ge_one (k + 1) B
      refine ⟨hg.comp hf.1, mul_nonneg hMg (le_trans zero_le_one hC_ge), ?_⟩
      intro j hj x
      cases j with
      | zero =>
        simp only [iteratedDeriv_zero]
        calc
          |g (f x)| ≤ M_g := by simpa [iteratedDeriv_zero] using hgbnd 0 (by omega) (f x) (hfS x)
          _ = M_g * 1 := by ring
          _ ≤ M_g * rmdCompConst (k + 1) B := mul_le_mul_of_nonneg_left hC_ge hMg
      | succ j' =>
        have h_ne0 : ((k + 1 : ℕ) : WithTop ℕ∞) ≠ 0 := by simp
        have hg_diff : Differentiable ℝ g := hg.differentiable h_ne0
        have hf_diff : Differentiable ℝ f := hf.1.differentiable h_ne0
        have h_deriv_comp : deriv (fun y => g (f y)) = fun y => deriv g (f y) * deriv f y := by
          funext y
          exact deriv_comp y hg_diff.differentiableAt hf_diff.differentiableAt
        have hg' : ContDiff ℝ (k : WithTop ℕ∞) (deriv g) :=
          (contDiff_succ_iff_deriv.mp (hg : ContDiff ℝ (((k : WithTop ℕ∞) + 1)) g)).2.2
        have hgbnd' : ∀ r : ℕ, r ≤ k → ∀ z ∈ S, |iteratedDeriv r (deriv g) z| ≤ M_g := by
          intro r hr z hz
          rw [← iteratedDeriv_succ']
          exact hgbnd (r + 1) (by omega) z hz
        have h_gf' := ih S M_g B (deriv g) f hg' hMg hgbnd'
          (h_deriv_mono (by omega) le_rfl hf) hfS
        have h_f' : rmdJetBnd k B (deriv f) := h_jet_of_deriv hf
        have h_prod := h_jet_mul h_gf' h_f'
        rw [iteratedDeriv_succ', h_deriv_comp]
        calc
          |iteratedDeriv j' (fun y => deriv g (f y) * deriv f y) x|
              ≤ (2 : ℝ) ^ k * (M_g * rmdCompConst k B) * B := h_prod.2.2 j' (by omega) x
          _ = M_g * (((2 : ℝ) ^ k * B) * rmdCompConst k B) := by ring
          _ ≤ M_g * (max 1 ((2 : ℝ) ^ k * B) * rmdCompConst k B) := by
              apply mul_le_mul_of_nonneg_left _ hMg
              exact mul_le_mul_of_nonneg_right (le_max_right _ _)
                (le_trans zero_le_one (h_compConst_ge_one k B))
          _ = M_g * rmdCompConst (k + 1) B := by simp [rmdCompConst]

  have h_jet_comp_diff_on : ∀ (k : ℕ) (S : Set ℝ) (L_g B Δ_f : ℝ) (g f₁ f₂ : ℝ → ℝ),
      Convex ℝ S →
      ContDiff ℝ ((k + 1 : ℕ) : WithTop ℕ∞) g →
      0 ≤ L_g →
      (∀ r : ℕ, r ≤ k → ∀ z ∈ S, |iteratedDeriv (r + 1) g z| ≤ L_g) →
      rmdDerivBnd k B f₁ →
      rmdDerivBnd k B f₂ →
      (∀ x : ℝ, f₁ x ∈ S ∧ f₂ x ∈ S) →
      rmdJetBnd k Δ_f (fun x => f₁ x - f₂ x) →
      rmdJetBnd k ((2 : ℝ) ^ k * L_g * rmdCompConst k B * Δ_f)
        (fun x => g (f₁ x) - g (f₂ x)) := by
    intro k S L_g B Δ_f g f₁ f₂ hS hg hLg hgbnd hf₁ hf₂ hfS hdf
    have hB : 0 ≤ B := hf₁.2.1
    have h_ne0 : ((k + 1 : ℕ) : WithTop ℕ∞) ≠ 0 := by simp
    have hg_diff : Differentiable ℝ g := hg.differentiable h_ne0
    have hg' : ContDiff ℝ (k : WithTop ℕ∞) (deriv g) :=
      (contDiff_succ_iff_deriv.mp (hg : ContDiff ℝ (((k : WithTop ℕ∞) + 1)) g)).2.2
    have hEq : (fun x => g (f₁ x) - g (f₂ x)) =
        (fun x => (f₁ x - f₂ x) * ∫ s in (0 : ℝ)..1, deriv g (f₂ x + s * (f₁ x - f₂ x))) := by
      funext x
      have h_ftc := intervalIntegral.integral_unitInterval_deriv_eq_sub
        (𝕜 := ℝ) (f := g) (f' := deriv g) (z₀ := f₂ x) (z₁ := f₁ x - f₂ x)
        ((hg'.continuous.comp (continuous_const.add (continuous_id.mul continuous_const))).continuousOn)
        (fun s _ => (hg_diff (f₂ x + s • (f₁ x - f₂ x))).hasDerivAt)
      simp only [smul_eq_mul, add_sub_cancel] at h_ftc
      exact h_ftc.symm
    rw [hEq]
    let G : ℝ × ℝ → ℝ := fun q => deriv g (f₂ q.2 + q.1 * (f₁ q.2 - f₂ q.2))
    have hG_cd : ContDiff ℝ (k : WithTop ℕ∞) G :=
      hg'.comp ((hf₂.1.comp contDiff_snd).add
        (contDiff_fst.mul ((hf₁.1.sub hf₂.1).comp contDiff_snd)))
    have hGs : ∀ s ∈ Set.Icc (0 : ℝ) 1,
        rmdJetBnd k (L_g * rmdCompConst k B) (fun x => G (s, x)) := by
      intro s hs
      have hs0 : 0 ≤ s := hs.1
      have hs1 : 0 ≤ 1 - s := sub_nonneg.mpr hs.2
      let γ : ℝ → ℝ := fun x => f₂ x + s * (f₁ x - f₂ x)
      have hγ_eq : ∀ x : ℝ, γ x = (1 - s) * f₂ x + s * f₁ x := fun x => by ring
      have hγ_S : ∀ x : ℝ, γ x ∈ S := by
        intro x
        rw [hγ_eq x]
        exact hS (hfS x).2 (hfS x).1 hs1 hs0 (by ring)
      have hγ_bnd : rmdDerivBnd k B γ := by
        refine ⟨hf₂.1.add (contDiff_const.mul (hf₁.1.sub hf₂.1)), hB, ?_⟩
        intro j hj1 hj x
        have hEqγ : γ = fun y => (1 - s) * f₂ y + s * f₁ y := funext hγ_eq
        rw [hEqγ, iteratedDeriv_fun_add
          (((contDiff_const.mul hf₂.1).of_le (by norm_cast)).contDiffAt)
          (((contDiff_const.mul hf₁.1).of_le (by norm_cast)).contDiffAt),
          iteratedDeriv_const_mul (1 - s) ((hf₂.1.of_le (by norm_cast)).contDiffAt),
          iteratedDeriv_const_mul s ((hf₁.1.of_le (by norm_cast)).contDiffAt)]
        calc
          |(1 - s) * iteratedDeriv j f₂ x + s * iteratedDeriv j f₁ x|
              ≤ |(1 - s) * iteratedDeriv j f₂ x| + |s * iteratedDeriv j f₁ x| := abs_add_le _ _
          _ = (1 - s) * |iteratedDeriv j f₂ x| + s * |iteratedDeriv j f₁ x| := by
              rw [abs_mul, abs_mul, abs_of_nonneg hs1, abs_of_nonneg hs0]
          _ ≤ (1 - s) * B + s * B :=
              add_le_add (mul_le_mul_of_nonneg_left (hf₂.2.2 j hj1 hj x) hs1)
                (mul_le_mul_of_nonneg_left (hf₁.2.2 j hj1 hj x) hs0)
          _ = B := by ring
      have hgbnd' : ∀ r : ℕ, r ≤ k → ∀ z ∈ S, |iteratedDeriv r (deriv g) z| ≤ L_g := by
        intro r hr z hz
        rw [← iteratedDeriv_succ']
        exact hgbnd r hr z hz
      exact h_jet_comp_on k S L_g B (deriv g) γ hg' hLg hgbnd' hγ_bnd hγ_S
    have h_int := h_jet_unit_int hG_cd
      (mul_nonneg hLg (le_trans zero_le_one (h_compConst_ge_one k B))) hGs
    have h_prod := h_jet_mul hdf h_int
    exact h_jet_mono le_rfl (by linarith) h_prod

  have h_ftc_unit1 : ∀ (g g' : ℝ → ℝ),
      Continuous g' → (∀ s : ℝ, HasDerivAt g (g' s) s) →
      g 1 - g 0 = ∫ s in (0 : ℝ)..1, g' s := by
    intro g g' hg' hd
    exact (intervalIntegral.integral_eq_sub_of_hasDerivAt (fun s _ => hd s)
      (hg'.intervalIntegrable 0 1)).symm

  have h_symm_taylor2 : ∀ (F F₁ F₂ : ℝ → ℝ) (h : ℝ),
      Continuous F₂ →
      (∀ ξ : ℝ, HasDerivAt F (F₁ ξ) ξ) →
      (∀ ξ : ℝ, HasDerivAt F₁ (F₂ ξ) ξ) →
      F h + F (-h) - 2 * F 0 =
        h ^ 2 * ∫ s in (0 : ℝ)..1, (1 - s) * (F₂ (s * h) + F₂ (-(s * h))) := by
    intro F F₁ F₂ h hF₂_cont hF₁ hF₂
    let ψ : ℝ → ℝ := fun s =>
      F (s * h) + F (-(s * h)) + (1 - s) * h * (F₁ (s * h) - F₁ (-(s * h)))
    let ψ' : ℝ → ℝ := fun s =>
      h ^ 2 * ((1 - s) * (F₂ (s * h) + F₂ (-(s * h))))
    have hψ_deriv : ∀ s : ℝ, HasDerivAt ψ (ψ' s) s := by
      intro s
      have hs_pos : HasDerivAt (fun t : ℝ => t * h) h s := by
        simpa using (hasDerivAt_id s).mul_const h
      have hs_neg : HasDerivAt (fun t : ℝ => -(t * h)) (-h) s := hs_pos.neg
      have hd1 : HasDerivAt (fun t : ℝ => F (t * h)) (F₁ (s * h) * h) s :=
        (hF₁ (s * h)).comp s hs_pos
      have hd2 : HasDerivAt (fun t : ℝ => F (-(t * h))) (F₁ (-(s * h)) * (-h)) s :=
        (hF₁ (-(s * h))).comp s hs_neg
      have hd3 : HasDerivAt (fun t : ℝ => (1 - t) * h) ((0 - 1) * h) s :=
        ((hasDerivAt_const s (1 : ℝ)).sub (hasDerivAt_id s)).mul_const h
      have hd4a : HasDerivAt (fun t : ℝ => F₁ (t * h)) (F₂ (s * h) * h) s :=
        (hF₂ (s * h)).comp s hs_pos
      have hd4b : HasDerivAt (fun t : ℝ => F₁ (-(t * h))) (F₂ (-(s * h)) * (-h)) s :=
        (hF₂ (-(s * h))).comp s hs_neg
      have htot := (hd1.add hd2).add (hd3.mul (hd4a.sub hd4b))
      convert htot using 1
      dsimp [ψ']
      ring
    have hψ'_cont : Continuous ψ' :=
      continuous_const.mul ((continuous_const.sub continuous_id).mul
        ((hF₂_cont.comp (continuous_id.mul continuous_const)).add
          (hF₂_cont.comp (continuous_id.mul continuous_const).neg)))
    have h_int := h_ftc_unit1 ψ ψ' hψ'_cont hψ_deriv
    have h_eval : ψ 1 - ψ 0 = F h + F (-h) - 2 * F 0 := by
      dsimp [ψ]
      simp only [one_mul, zero_mul, neg_zero, sub_self, mul_zero, add_zero]
      ring
    rw [← h_eval, h_int]
    dsimp [ψ']
    exact intervalIntegral.integral_const_mul (h ^ 2) _

  have hw_deriv_props : ∀ (w : ℝ → ℝ), IsPeriodicSmoothBounded (m + 15) M₁ w →
      Continuous w ∧ Continuous (deriv w) ∧ Continuous (iteratedDeriv 2 w) ∧
      (∀ z : ℝ, HasDerivAt w (deriv w z) z) ∧
      (∀ z : ℝ, HasDerivAt (deriv w) (iteratedDeriv 2 w z) z) ∧
      (∀ z : ℝ, |w z| ≤ M₁ ∧ |deriv w z| ≤ M₁ ∧ |iteratedDeriv 2 w z| ≤ M₁) := by
    intro w hw
    have hd0_cd : ContDiff ℝ (2 : WithTop ℕ∞) w :=
      hw.2.1.of_le (by norm_cast; omega)
    have hd1_cd : ContDiff ℝ (1 : WithTop ℕ∞) (deriv w) := by
      simpa [iteratedDeriv_one] using h_contDiff_iter 1 1 w (hw.2.1.of_le (by norm_cast; omega))
    have hd2_cd : ContDiff ℝ (0 : WithTop ℕ∞) (iteratedDeriv 2 w) :=
      h_contDiff_iter 2 0 w (hw.2.1.of_le (by norm_cast; omega))
    have hd2_eq : deriv (deriv w) = iteratedDeriv 2 w := by
      rw [iteratedDeriv_succ, iteratedDeriv_one]
    refine ⟨hd0_cd.continuous, hd1_cd.continuous, hd2_cd.continuous, ?_, ?_, ?_⟩
    · intro z
      exact (hd0_cd.differentiable (by decide)).differentiableAt.hasDerivAt
    · intro z
      rw [← hd2_eq]
      exact (hd1_cd.differentiable (by decide)).differentiableAt.hasDerivAt
    · intro z
      refine ⟨?_, ?_, hw.2.2 2 (by omega) z⟩
      · simpa [iteratedDeriv_zero] using hw.2.2 0 (by omega) z
      · simpa [iteratedDeriv_one] using hw.2.2 1 (by omega) z

  have h_primPhi_shift_eq : ∀ (w : ℝ → ℝ), IsPeriodicSmoothBounded (m + 15) M₁ w →
      ∀ (M₀ ξ : ℝ),
        Real.exp (-w M₀) * (primPhi_ℝ w (M₀ + ξ) - primPhi_ℝ w M₀) =
          ξ * rmdK0 w M₀ ξ := by
    intro w hw M₀ ξ
    obtain ⟨hw_cont, _, _, _, _, _⟩ := hw_deriv_props w hw
    let g : ℝ → ℝ := fun s => Real.exp (-w M₀) * primPhi_ℝ w (M₀ + s * ξ)
    let g' : ℝ → ℝ := fun s => ξ * Real.exp (w (M₀ + s * ξ) - w M₀)
    have hg_deriv : ∀ s : ℝ, HasDerivAt g (g' s) s := by
      intro s
      have hs : HasDerivAt (fun t : ℝ => M₀ + t * ξ) (0 + 1 * ξ) s :=
        (hasDerivAt_const s M₀).add ((hasDerivAt_id s).mul_const ξ)
      have hcomp := ((H_base.primPhi_hasDerivAt w hw (M₀ + s * ξ)).comp s hs).const_mul
        (Real.exp (-w M₀))
      convert hcomp using 1
      dsimp [g']
      have hexp : Real.exp (-w M₀) * Real.exp (w (M₀ + s * ξ)) =
          Real.exp (w (M₀ + s * ξ) - w M₀) := by
        rw [← Real.exp_add]; congr 1; ring
      calc
        ξ * Real.exp (w (M₀ + s * ξ) - w M₀)
            = (Real.exp (-w M₀) * Real.exp (w (M₀ + s * ξ))) * ξ := by rw [hexp]; ring
        _ = Real.exp (-w M₀) * (Real.exp (w (M₀ + s * ξ)) * (0 + 1 * ξ)) := by ring
    have hg'_cont : Continuous g' :=
      continuous_const.mul (Real.continuous_exp.comp
        ((hw_cont.comp (continuous_const.add (continuous_id.mul continuous_const))).sub
          continuous_const))
    have hint := h_ftc_unit1 g g' hg'_cont hg_deriv
    have heval : g 1 - g 0 = Real.exp (-w M₀) * (primPhi_ℝ w (M₀ + ξ) - primPhi_ℝ w M₀) := by
      dsimp [g]; simp only [one_mul, zero_mul, add_zero]; ring
    rw [← heval, hint]
    dsimp [g', rmdK0]
    exact intervalIntegral.integral_const_mul ξ _

  have h_c0_identity : ∀ (w : ℝ → ℝ), IsPeriodicSmoothBounded (m + 15) M₁ w →
      ∀ (M₀ h d : ℝ),
        primPhi_ℝ w (M₀ + d) = (primPhi_ℝ w (M₀ - h) + primPhi_ℝ w (M₀ + h)) / 2 →
        d * rmdK0 w M₀ d = h ^ 2 * rmdKsym w M₀ h := by
    intro w hw M₀ h d hmid
    obtain ⟨hw_cont, hw1_cont, _, hw_hd, _, _⟩ := hw_deriv_props w hw
    let F : ℝ → ℝ := fun ξ => Real.exp (-w M₀) * primPhi_ℝ w (M₀ + ξ)
    let F₁ : ℝ → ℝ := fun ξ => Real.exp (w (M₀ + ξ) - w M₀)
    let F₂ : ℝ → ℝ := fun ξ => deriv w (M₀ + ξ) * Real.exp (w (M₀ + ξ) - w M₀)
    have hF₁_hd : ∀ ξ : ℝ, HasDerivAt F (F₁ ξ) ξ := by
      intro ξ
      have hsh : HasDerivAt (fun t : ℝ => M₀ + t) (0 + 1) ξ :=
        (hasDerivAt_const ξ M₀).add (hasDerivAt_id ξ)
      have hc := ((H_base.primPhi_hasDerivAt w hw (M₀ + ξ)).comp ξ hsh).const_mul
        (Real.exp (-w M₀))
      convert hc using 1
      dsimp [F₁]
      have hexp : Real.exp (-w M₀) * Real.exp (w (M₀ + ξ)) = Real.exp (w (M₀ + ξ) - w M₀) := by
        rw [← Real.exp_add]; congr 1; ring
      linarith
    have hF₂_hd : ∀ ξ : ℝ, HasDerivAt F₁ (F₂ ξ) ξ := by
      intro ξ
      have hsh : HasDerivAt (fun t : ℝ => M₀ + t) (0 + 1) ξ :=
        (hasDerivAt_const ξ M₀).add (hasDerivAt_id ξ)
      have hsub : HasDerivAt (fun t : ℝ => w (M₀ + t) - w M₀) (deriv w (M₀ + ξ) * (0 + 1) - 0) ξ :=
        ((hw_hd (M₀ + ξ)).comp ξ hsh).sub (hasDerivAt_const ξ (w M₀))
      convert hsub.exp using 1
      dsimp [F₂]
      ring
    have hF₂_cont : Continuous F₂ :=
      (hw1_cont.comp (continuous_const.add continuous_id)).mul
        (Real.continuous_exp.comp
          ((hw_cont.comp (continuous_const.add continuous_id)).sub continuous_const))
    have hsym := h_symm_taylor2 F F₁ F₂ h hF₂_cont hF₁_hd hF₂_hd
    have h_lhs : d * rmdK0 w M₀ d = (F h + F (-h) - 2 * F 0) / 2 := by
      rw [← h_primPhi_shift_eq w hw M₀ d]
      dsimp [F]
      have hsub_eq : M₀ + -h = M₀ - h := by ring
      rw [hmid, hsub_eq, add_zero]
      ring
    rw [h_lhs, hsym]
    dsimp [rmdKsym, F₂]
    have h_int_eq :
        (∫ s in (0 : ℝ)..1, (1 - s) *
          (deriv w (M₀ + s * h) * Real.exp (w (M₀ + s * h) - w M₀) +
           deriv w (M₀ + -(s * h)) * Real.exp (w (M₀ + -(s * h)) - w M₀))) =
        (∫ s in (0 : ℝ)..1, (1 - s) *
          (deriv w (M₀ + s * h) * Real.exp (w (M₀ + s * h) - w M₀) +
           deriv w (M₀ - s * h) * Real.exp (w (M₀ - s * h) - w M₀))) := rfl
    rw [h_int_eq]
    ring

  have h_qual_and_ode : ∀ (q : ℕ) (ρ c_T : ℝ) (w e_X τ_T : ℝ → ℝ),
      IsPeriodicSmoothBounded (m + 15) M₁ w →
      IsRealJetPerturb (m + 2) ((4 * (q : ℝ))⁻¹) e_X →
      IsRealJetPerturb (m + 2) ((4 * (q : ℝ))⁻¹) τ_T →
      let X : ℝ → ℝ := fun x => x + ρ + e_X x
      let T : ℝ → ℝ := fun x => c_T + τ_T x
      ContDiff ℝ ((m + 2 : ℕ) : WithTop ℕ∞)
        (fun p : ℝ × ℝ => realMidpointDispU w X T p.1 p.2) ∧
      (∀ u_param : ℝ, Function.Periodic (realMidpointDispU w X T u_param) (2 * Real.pi)) ∧
      (∀ u_param x : ℝ,
        deriv (realMidpointDispU w X T u_param) x =
          rmdOdeRhs w (X x + u_param * T x / 2) (u_param * T x / 2)
            (realMidpointDispU w X T u_param x)
            (deriv (fun y => X y + u_param * T y / 2) x)
            (deriv (fun y => u_param * T y / 2) x)) := by
    intro q ρ c_T w e_X τ_T hw he_X hτ_T X T
    have hΦ_cd : ContDiff ℝ ((m + 2 : ℕ) : WithTop ℕ∞) (primPhi_ℝ w) :=
      (H_base.primPhi_contDiff w hw).of_le (by norm_cast; omega)
    have hΨ_cd : ContDiff ℝ ((m + 2 : ℕ) : WithTop ℕ∞) (Function.invFun (primPhi_ℝ w)) :=
      (H_base.invPrimPhi_contDiff w hw).of_le (by norm_cast; omega)
    have hX_cd : ContDiff ℝ ((m + 2 : ℕ) : WithTop ℕ∞) X :=
      (contDiff_id.add contDiff_const).add he_X.2.1
    have hT_cd : ContDiff ℝ ((m + 2 : ℕ) : WithTop ℕ∞) T :=
      contDiff_const.add hτ_T.2.1
    have hX_2d : ContDiff ℝ ((m + 2 : ℕ) : WithTop ℕ∞) (fun p : ℝ × ℝ => X p.2) :=
      hX_cd.comp contDiff_snd
    have hT_2d : ContDiff ℝ ((m + 2 : ℕ) : WithTop ℕ∞) (fun p : ℝ × ℝ => T p.2) :=
      hT_cd.comp contDiff_snd
    have hJoint : ContDiff ℝ ((m + 2 : ℕ) : WithTop ℕ∞)
        (fun p : ℝ × ℝ => realMidpointDispU w X T p.1 p.2) := by
      have h_avg : ContDiff ℝ ((m + 2 : ℕ) : WithTop ℕ∞)
          (fun p : ℝ × ℝ =>
            (primPhi_ℝ w (X p.2) + primPhi_ℝ w (X p.2 + p.1 * T p.2)) / 2) :=
        ((hΦ_cd.comp hX_2d).add (hΦ_cd.comp (hX_2d.add (contDiff_fst.mul hT_2d)))).div_const 2
      have h_lin : ContDiff ℝ ((m + 2 : ℕ) : WithTop ℕ∞)
          (fun p : ℝ × ℝ => X p.2 + p.1 * T p.2 / 2) :=
        hX_2d.add ((contDiff_fst.mul hT_2d).div_const 2)
      exact (hΨ_cd.comp h_avg).sub h_lin
    refine ⟨hJoint, ?_, ?_⟩
    · intro u_param x
      simp only [realMidpointDispU]
      have hXp : X (x + 2 * Real.pi) = X x + 2 * Real.pi := by
        dsimp [X]; rw [he_X.1 x]; ring
      have hTp : T (x + 2 * Real.pi) = T x := by
        dsimp [T]; rw [hτ_T.1 x]
      have hYp : X (x + 2 * Real.pi) + u_param * T (x + 2 * Real.pi) =
          (X x + u_param * T x) + 2 * Real.pi := by
        rw [hXp, hTp]; ring
      rw [hYp, hXp, hTp, H_base.midpoint_diag_periodic w hw (X x) (X x + u_param * T x)]
      ring
    · intro u_param x
      obtain ⟨hw_cont, hw1_cont, hw2_cont, hw_hd, hw1_hd, _⟩ := hw_deriv_props w hw
      let h_fn : ℝ → ℝ := fun y => u_param * T y / 2
      let M₀_fn : ℝ → ℝ := fun y => X y + u_param * T y / 2
      let d_fn : ℝ → ℝ := realMidpointDispU w X T u_param
      have h_ne0 : ((m + 2 : ℕ) : WithTop ℕ∞) ≠ 0 := by simp
      have hh_cd : ContDiff ℝ ((m + 2 : ℕ) : WithTop ℕ∞) h_fn :=
        (contDiff_const.mul hT_cd).div_const 2
      have hM₀_cd : ContDiff ℝ ((m + 2 : ℕ) : WithTop ℕ∞) M₀_fn :=
        hX_cd.add hh_cd
      have hd_cd : ContDiff ℝ ((m + 2 : ℕ) : WithTop ℕ∞) d_fn :=
        hJoint.comp (contDiff_const.prodMk contDiff_id)
      have hh_hd : HasDerivAt h_fn (deriv h_fn x) x :=
        (hh_cd.differentiable h_ne0).differentiableAt.hasDerivAt
      have hM₀_hd : HasDerivAt M₀_fn (deriv M₀_fn x) x :=
        (hM₀_cd.differentiable h_ne0).differentiableAt.hasDerivAt
      have hd_hd : HasDerivAt d_fn (deriv d_fn x) x :=
        (hd_cd.differentiable h_ne0).differentiableAt.hasDerivAt
      have h_sum_hd : HasDerivAt (fun y => M₀_fn y + d_fn y) (deriv M₀_fn x + deriv d_fn x) x :=
        hM₀_hd.add hd_hd
      have h_sub_hd : HasDerivAt (fun y => M₀_fn y - h_fn y) (deriv M₀_fn x - deriv h_fn x) x :=
        hM₀_hd.sub hh_hd
      have h_add_hd : HasDerivAt (fun y => M₀_fn y + h_fn y) (deriv M₀_fn x + deriv h_fn x) x :=
        hM₀_hd.add hh_hd
      have h_lhs_hd : HasDerivAt (fun y => primPhi_ℝ w (M₀_fn y + d_fn y))
          (Real.exp (w (M₀_fn x + d_fn x)) * (deriv M₀_fn x + deriv d_fn x)) x :=
        HasDerivAt.comp (h₂ := primPhi_ℝ w) x
          (H_base.primPhi_hasDerivAt w hw (M₀_fn x + d_fn x)) h_sum_hd
      have h_rhs_hd : HasDerivAt
          (fun y => (primPhi_ℝ w (M₀_fn y - h_fn y) + primPhi_ℝ w (M₀_fn y + h_fn y)) * (1 / 2 : ℝ))
          ((Real.exp (w (M₀_fn x - h_fn x)) * (deriv M₀_fn x - deriv h_fn x) +
            Real.exp (w (M₀_fn x + h_fn x)) * (deriv M₀_fn x + deriv h_fn x)) * (1 / 2 : ℝ)) x :=
        ((HasDerivAt.comp (h₂ := primPhi_ℝ w) x
            (H_base.primPhi_hasDerivAt w hw (M₀_fn x - h_fn x)) h_sub_hd).add
          (HasDerivAt.comp (h₂ := primPhi_ℝ w) x
            (H_base.primPhi_hasDerivAt w hw (M₀_fn x + h_fn x)) h_add_hd)).mul_const
          (1 / 2 : ℝ)
      have h_fn_eq : (fun y => primPhi_ℝ w (M₀_fn y + d_fn y)) =
          (fun y => (primPhi_ℝ w (M₀_fn y - h_fn y) + primPhi_ℝ w (M₀_fn y + h_fn y)) * (1 / 2 : ℝ)) := by
        funext y
        have h1 : M₀_fn y + d_fn y = midpoint_ℝ w (X y) (X y + u_param * T y) := by
          dsimp [M₀_fn, d_fn, realMidpointDispU]; ring
        have h2 : M₀_fn y - h_fn y = X y := by dsimp [M₀_fn, h_fn]; ring
        have h3 : M₀_fn y + h_fn y = X y + u_param * T y := by dsimp [M₀_fn, h_fn]; ring
        rw [h1, h2, h3, H_base.midpoint_eq w hw (X y) (X y + u_param * T y)]
        ring
      rw [h_fn_eq] at h_lhs_hd
      have h_eq_deriv := h_lhs_hd.unique h_rhs_hd
      set M₀ := M₀_fn x
      set h := h_fn x
      set d := d_fn x
      set M₀' := deriv M₀_fn x
      set h' := deriv h_fn x
      set Ed := Real.exp (w M₀ - w (M₀ + d))
      have h_mul_exp : M₀' + deriv d_fn x =
          Ed * ((Real.exp (w (M₀ + h) - w M₀) + Real.exp (w (M₀ - h) - w M₀)) / 2 * M₀' +
            (Real.exp (w (M₀ + h) - w M₀) - Real.exp (w (M₀ - h) - w M₀)) / 2 * h') := by
        have hexp_inv : Real.exp (-w (M₀ + d)) * Real.exp (w (M₀ + d)) = 1 := by
          rw [← Real.exp_add, neg_add_cancel, Real.exp_zero]
        have hexp_p : Real.exp (-w (M₀ + d)) * Real.exp (w (M₀ + h)) =
            Ed * Real.exp (w (M₀ + h) - w M₀) := by
          dsimp [Ed]; rw [← Real.exp_add, ← Real.exp_add]; congr 1; ring
        have hexp_m : Real.exp (-w (M₀ + d)) * Real.exp (w (M₀ - h)) =
            Ed * Real.exp (w (M₀ - h) - w M₀) := by
          dsimp [Ed]; rw [← Real.exp_add, ← Real.exp_add]; congr 1; ring
        have hmul := congrArg (fun v => Real.exp (-w (M₀ + d)) * v) h_eq_deriv
        calc
          M₀' + deriv d_fn x
              = (Real.exp (-w (M₀ + d)) * Real.exp (w (M₀ + d))) * (M₀' + deriv d_fn x) := by
                rw [hexp_inv, one_mul]
          _ = Real.exp (-w (M₀ + d)) * (Real.exp (w (M₀ + d)) * (M₀' + deriv d_fn x)) := by ring
          _ = Real.exp (-w (M₀ + d)) *
                ((Real.exp (w (M₀ - h)) * (M₀' - h') +
                  Real.exp (w (M₀ + h)) * (M₀' + h')) * (1 / 2 : ℝ)) := hmul
          _ = ((Real.exp (-w (M₀ + d)) * Real.exp (w (M₀ - h))) * (M₀' - h') +
                (Real.exp (-w (M₀ + d)) * Real.exp (w (M₀ + h))) * (M₀' + h')) / 2 := by ring
          _ = Ed * ((Real.exp (w (M₀ + h) - w M₀) + Real.exp (w (M₀ - h) - w M₀)) / 2 * M₀' +
                (Real.exp (w (M₀ + h) - w M₀) - Real.exp (w (M₀ - h) - w M₀)) / 2 * h') := by
                rw [hexp_m, hexp_p]; ring
      have h_piece2 : (Real.exp (w (M₀ + h) - w M₀) + Real.exp (w (M₀ - h) - w M₀) - 2) / 2 =
          h ^ 2 * rmdK2 w M₀ h := by
        let G : ℝ → ℝ := fun ξ => Real.exp (w (M₀ + ξ) - w M₀)
        let G₁ : ℝ → ℝ := fun ξ => deriv w (M₀ + ξ) * Real.exp (w (M₀ + ξ) - w M₀)
        let G₂ : ℝ → ℝ := fun ξ =>
          (iteratedDeriv 2 w (M₀ + ξ) + (deriv w (M₀ + ξ)) ^ 2) * Real.exp (w (M₀ + ξ) - w M₀)
        have hG₁_hd : ∀ ξ : ℝ, HasDerivAt G (G₁ ξ) ξ := by
          intro ξ
          have hsh : HasDerivAt (fun t : ℝ => M₀ + t) (0 + 1) ξ :=
            (hasDerivAt_const ξ M₀).add (hasDerivAt_id ξ)
          have hsub : HasDerivAt (fun t : ℝ => w (M₀ + t) - w M₀)
              (deriv w (M₀ + ξ) * (0 + 1) - 0) ξ :=
            ((hw_hd (M₀ + ξ)).comp ξ hsh).sub (hasDerivAt_const ξ (w M₀))
          convert hsub.exp using 1; dsimp [G₁]; ring
        have hG₂_hd : ∀ ξ : ℝ, HasDerivAt G₁ (G₂ ξ) ξ := by
          intro ξ
          have hsh : HasDerivAt (fun t : ℝ => M₀ + t) (0 + 1) ξ :=
            (hasDerivAt_const ξ M₀).add (hasDerivAt_id ξ)
          have hd_w1 : HasDerivAt (fun t : ℝ => deriv w (M₀ + t))
              (iteratedDeriv 2 w (M₀ + ξ) * (0 + 1)) ξ :=
            (hw1_hd (M₀ + ξ)).comp ξ hsh
          have hprod := hd_w1.mul (hG₁_hd ξ)
          convert hprod using 1; dsimp [G, G₁, G₂]; ring
        have hG₂_cont : Continuous G₂ :=
          (((hw2_cont.comp (continuous_const.add continuous_id)).add
            ((hw1_cont.comp (continuous_const.add continuous_id)).pow 2)).mul
            (Real.continuous_exp.comp
              ((hw_cont.comp (continuous_const.add continuous_id)).sub continuous_const)))
        have hsym := h_symm_taylor2 G G₁ G₂ h hG₂_cont hG₁_hd hG₂_hd
        have hG0 : G 0 = 1 := by dsimp [G]; simp
        have hGm : G (-h) = Real.exp (w (M₀ - h) - w M₀) := rfl
        rw [hG0, hGm] at hsym
        have h_int_eq :
            (∫ s in (0 : ℝ)..1, (1 - s) * (G₂ (s * h) + G₂ (-(s * h)))) =
            (∫ s in (0 : ℝ)..1, (1 - s) *
              ((iteratedDeriv 2 w (M₀ + s * h) + (deriv w (M₀ + s * h)) ^ 2) *
                 Real.exp (w (M₀ + s * h) - w M₀) +
               (iteratedDeriv 2 w (M₀ - s * h) + (deriv w (M₀ - s * h)) ^ 2) *
                 Real.exp (w (M₀ - s * h) - w M₀))) := rfl
        rw [h_int_eq] at hsym
        dsimp [rmdK2]
        linarith
      have h_piece_lin : Ed - 1 = d * rmdKlin w M₀ d := by
        let g : ℝ → ℝ := fun s => Real.exp (w M₀ - w (M₀ + s * d))
        let g' : ℝ → ℝ := fun s => (-d) * (deriv w (M₀ + s * d) * Real.exp (w M₀ - w (M₀ + s * d)))
        have hg_hd : ∀ s : ℝ, HasDerivAt g (g' s) s := by
          intro s
          have hsh : HasDerivAt (fun t : ℝ => M₀ + t * d) (0 + 1 * d) s :=
            (hasDerivAt_const s M₀).add ((hasDerivAt_id s).mul_const d)
          have hsub : HasDerivAt (fun t : ℝ => w M₀ - w (M₀ + t * d))
              (0 - deriv w (M₀ + s * d) * (0 + 1 * d)) s :=
            (hasDerivAt_const s (w M₀)).sub ((hw_hd (M₀ + s * d)).comp s hsh)
          convert hsub.exp using 1; dsimp [g']; ring
        have hg'_cont : Continuous g' :=
          continuous_const.mul
            ((hw1_cont.comp (continuous_const.add (continuous_id.mul continuous_const))).mul
              (Real.continuous_exp.comp
                (continuous_const.sub
                  (hw_cont.comp (continuous_const.add (continuous_id.mul continuous_const))))))
        have hint := h_ftc_unit1 g g' hg'_cont hg_hd
        have heval : g 1 - g 0 = Ed - 1 := by
          dsimp [g, Ed]; simp only [one_mul, zero_mul, add_zero, sub_self, Real.exp_zero]
        rw [← heval, hint]
        dsimp [g', rmdKlin]
        rw [intervalIntegral.integral_const_mul (-d)]
        ring
      have h_piece1 : (Real.exp (w (M₀ + h) - w M₀) - Real.exp (w (M₀ - h) - w M₀)) / 2 =
          h * rmdK1 w M₀ h := by
        let g : ℝ → ℝ := fun s =>
          (1 / 2 : ℝ) * (Real.exp (w (M₀ + s * h) - w M₀) - Real.exp (w (M₀ - s * h) - w M₀))
        let g' : ℝ → ℝ := fun s =>
          (h / 2) * (deriv w (M₀ + s * h) * Real.exp (w (M₀ + s * h) - w M₀) +
            deriv w (M₀ - s * h) * Real.exp (w (M₀ - s * h) - w M₀))
        have hg_hd : ∀ s : ℝ, HasDerivAt g (g' s) s := by
          intro s
          have hsh_p : HasDerivAt (fun t : ℝ => M₀ + t * h) (0 + 1 * h) s :=
            (hasDerivAt_const s M₀).add ((hasDerivAt_id s).mul_const h)
          have hsh_m : HasDerivAt (fun t : ℝ => M₀ - t * h) (0 - 1 * h) s :=
            (hasDerivAt_const s M₀).sub ((hasDerivAt_id s).mul_const h)
          have hsub_p : HasDerivAt (fun t : ℝ => w (M₀ + t * h) - w M₀)
              (deriv w (M₀ + s * h) * (0 + 1 * h) - 0) s :=
            ((hw_hd (M₀ + s * h)).comp s hsh_p).sub (hasDerivAt_const s (w M₀))
          have hsub_m : HasDerivAt (fun t : ℝ => w (M₀ - t * h) - w M₀)
              (deriv w (M₀ - s * h) * (0 - 1 * h) - 0) s :=
            ((hw_hd (M₀ - s * h)).comp s hsh_m).sub (hasDerivAt_const s (w M₀))
          convert (hsub_p.exp.sub hsub_m.exp).const_mul (1 / 2 : ℝ) using 1
          dsimp [g']; ring
        have hg'_cont : Continuous g' :=
          continuous_const.mul
            (((hw1_cont.comp (continuous_const.add (continuous_id.mul continuous_const))).mul
              (Real.continuous_exp.comp
                ((hw_cont.comp (continuous_const.add (continuous_id.mul continuous_const))).sub
                  continuous_const))).add
            ((hw1_cont.comp (continuous_const.sub (continuous_id.mul continuous_const))).mul
              (Real.continuous_exp.comp
                ((hw_cont.comp (continuous_const.sub (continuous_id.mul continuous_const))).sub
                  continuous_const))))
        have hint := h_ftc_unit1 g g' hg'_cont hg_hd
        have heval : g 1 - g 0 =
            (Real.exp (w (M₀ + h) - w M₀) - Real.exp (w (M₀ - h) - w M₀)) / 2 := by
          dsimp [g]; simp only [one_mul, zero_mul, add_zero, sub_zero, sub_self]; ring
        rw [← heval, hint]
        dsimp [g', rmdK1]
        rw [intervalIntegral.integral_const_mul (h / 2)]
        ring
      dsimp [rmdOdeRhs]
      have h_rearr : deriv d_fn x =
          (Ed * ((Real.exp (w (M₀ + h) - w M₀) + Real.exp (w (M₀ - h) - w M₀) - 2) / 2) +
            (Ed - 1)) * M₀' +
          Ed * ((Real.exp (w (M₀ + h) - w M₀) - Real.exp (w (M₀ - h) - w M₀)) / 2) * h' := by
        linarith [h_mul_exp]
      rw [h_rearr, h_piece2, h_piece_lin, h_piece1]
      ring

  let C₀_mid : ℝ := 21 * M₁ * Real.exp (4 * M₁)
  have hC₀_pos : 0 < C₀_mid := by positivity

  have h_rmdK0_lower : ∀ (w : ℝ → ℝ), IsPeriodicSmoothBounded (m + 15) M₁ w →
      ∀ (M₀ d : ℝ), Real.exp (-2 * M₁) ≤ rmdK0 w M₀ d := by
    intro w hw M₀ d
    obtain ⟨hw_cont, _, _, _, _, hw_bnd⟩ := hw_deriv_props w hw
    have h_const_int : (∫ _s in (0 : ℝ)..1, Real.exp (-2 * M₁)) = Real.exp (-2 * M₁) := by simp
    rw [← h_const_int]
    apply intervalIntegral.integral_mono_on zero_le_one intervalIntegrable_const
    · exact (Real.continuous_exp.comp
        ((hw_cont.comp (continuous_const.add (continuous_id.mul continuous_const))).sub
          continuous_const)).intervalIntegrable 0 1
    · intro s _
      apply Real.exp_le_exp.mpr
      have h1 := (hw_bnd (M₀ + s * d)).1; have h2 := (hw_bnd M₀).1
      rw [abs_le] at h1 h2; linarith

  have h_rmdKsym_upper : ∀ (w : ℝ → ℝ), IsPeriodicSmoothBounded (m + 15) M₁ w →
      ∀ (M₀ h : ℝ), |rmdKsym w M₀ h| ≤ M₁ * Real.exp (2 * M₁) := by
    intro w hw M₀ h
    obtain ⟨_, _, _, _, _, hw_bnd⟩ := hw_deriv_props w hw
    dsimp [rmdKsym]
    rw [abs_mul, abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 1 / 2)]
    have hsub : Set.uIoc (0 : ℝ) 1 ⊆ Set.Icc (0 : ℝ) 1 := by
      rw [Set.uIoc_of_le zero_le_one]; exact Set.Ioc_subset_Icc_self
    have hbnd : ‖∫ s in (0 : ℝ)..1, (1 - s) *
        (deriv w (M₀ + s * h) * Real.exp (w (M₀ + s * h) - w M₀) +
         deriv w (M₀ - s * h) * Real.exp (w (M₀ - s * h) - w M₀))‖ ≤
        (2 * M₁ * Real.exp (2 * M₁)) * |(1 : ℝ) - 0| := by
      apply intervalIntegral.norm_integral_le_of_norm_le_const
      intro s hs
      obtain ⟨hs0, hs1⟩ := hsub hs
      rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (by linarith : 0 ≤ 1 - s)]
      have h_term : ∀ ξ : ℝ,
          |deriv w (M₀ + ξ) * Real.exp (w (M₀ + ξ) - w M₀)| ≤ M₁ * Real.exp (2 * M₁) := by
        intro ξ
        rw [abs_mul, abs_of_pos (Real.exp_pos _)]
        have hw1 := (hw_bnd (M₀ + ξ)).2.1
        have hw0a := (hw_bnd (M₀ + ξ)).1; have hw0b := (hw_bnd M₀).1
        rw [abs_le] at hw0a hw0b
        have hexp : Real.exp (w (M₀ + ξ) - w M₀) ≤ Real.exp (2 * M₁) :=
          Real.exp_le_exp.mpr (by linarith)
        exact mul_le_mul hw1 hexp (le_of_lt (Real.exp_pos _)) (le_of_lt hM₁)
      have hp := h_term (s * h)
      have hm_eq : M₀ - s * h = M₀ + -(s * h) := by ring
      have hm := h_term (-(s * h))
      rw [← hm_eq] at hm
      have hsum : |deriv w (M₀ + s * h) * Real.exp (w (M₀ + s * h) - w M₀) +
          deriv w (M₀ - s * h) * Real.exp (w (M₀ - s * h) - w M₀)| ≤
          2 * M₁ * Real.exp (2 * M₁) :=
        le_trans (abs_add_le _ _) (by linarith)
      have h1s : 1 - s ≤ 1 := by linarith
      calc
        (1 - s) * |deriv w (M₀ + s * h) * Real.exp (w (M₀ + s * h) - w M₀) +
            deriv w (M₀ - s * h) * Real.exp (w (M₀ - s * h) - w M₀)|
            ≤ 1 * (2 * M₁ * Real.exp (2 * M₁)) :=
          mul_le_mul h1s hsum (abs_nonneg _) zero_le_one
        _ = 2 * M₁ * Real.exp (2 * M₁) := one_mul _
    rw [Real.norm_eq_abs] at hbnd
    have hbnd' : |∫ s in (0 : ℝ)..1, (1 - s) *
        (deriv w (M₀ + s * h) * Real.exp (w (M₀ + s * h) - w M₀) +
         deriv w (M₀ - s * h) * Real.exp (w (M₀ - s * h) - w M₀))| ≤
        2 * M₁ * Real.exp (2 * M₁) := by simpa using hbnd
    linarith

  have h_step_h_bounds : ∀ (q : ℕ) (c_T u_param : ℝ) (τ_T : ℝ → ℝ),
      4 ≤ q → |c_T| ≤ 2 * Real.pi / (q : ℝ) → u_param ∈ Set.Icc (0 : ℝ) 1 →
      IsRealJetPerturb (m + 2) ((4 * (q : ℝ))⁻¹) τ_T →
      ∀ x : ℝ,
        |u_param * (c_T + τ_T x) / 2| ≤ 9 / (2 * (q : ℝ)) ∧
        (u_param * (c_T + τ_T x) / 2) ^ 2 ≤ 21 / (q : ℝ) ^ 2 := by
    intro q c_T u_param τ_T hq hc_T hu hτ_T x
    have hq_pos : (0 : ℝ) < (q : ℝ) := by exact_mod_cast (by omega : 0 < q)
    have hpi : Real.pi < 4 := Real.pi_lt_four
    have hτ0 : |τ_T x| ≤ (4 * (q : ℝ))⁻¹ := by
      simpa [iteratedDeriv_zero] using hτ_T.2.2 0 (by omega) x
    have hτ0' : |τ_T x| ≤ (1 / 4 : ℝ) / (q : ℝ) := by
      calc
        |τ_T x| ≤ (4 * (q : ℝ))⁻¹ := hτ0
        _ = (1 / 4 : ℝ) / (q : ℝ) := by field_simp
    have hT_abs : |c_T + τ_T x| ≤ 9 / (q : ℝ) := by
      calc
        |c_T + τ_T x| ≤ |c_T| + |τ_T x| := abs_add_le _ _
        _ ≤ 2 * Real.pi / (q : ℝ) + (1 / 4 : ℝ) / (q : ℝ) := add_le_add hc_T hτ0'
        _ = (2 * Real.pi + 1 / 4) / (q : ℝ) := by ring
        _ ≤ 9 / (q : ℝ) := div_le_div_of_nonneg_right (by linarith) (le_of_lt hq_pos)
    have hu_abs : |u_param| ≤ 1 := by rw [abs_of_nonneg hu.1]; exact hu.2
    have hh_abs : |u_param * (c_T + τ_T x) / 2| ≤ 9 / (2 * (q : ℝ)) := by
      rw [abs_div, abs_mul, abs_of_pos (by norm_num : (0 : ℝ) < 2)]
      calc
        |u_param| * |c_T + τ_T x| / 2 ≤ 1 * (9 / (q : ℝ)) / 2 := by
          apply div_le_div_of_nonneg_right _ (by norm_num)
          exact mul_le_mul hu_abs hT_abs (abs_nonneg _) zero_le_one
        _ = 9 / (2 * (q : ℝ)) := by ring
    refine ⟨hh_abs, ?_⟩
    have hsq : (u_param * (c_T + τ_T x) / 2) ^ 2 ≤ (9 / (2 * (q : ℝ))) ^ 2 := by
      rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) hh_abs 2
    calc
      (u_param * (c_T + τ_T x) / 2) ^ 2 ≤ (9 / (2 * (q : ℝ))) ^ 2 := hsq
      _ = (81 / 4 : ℝ) / (q : ℝ) ^ 2 := by ring
      _ ≤ 21 / (q : ℝ) ^ 2 := div_le_div_of_nonneg_right (by norm_num) (sq_nonneg _)

  have h_c0_single : ∀ (q : ℕ) (ρ c_T u_param : ℝ) (w e_X τ_T : ℝ → ℝ),
      4 ≤ q → |c_T| ≤ 2 * Real.pi / (q : ℝ) → u_param ∈ Set.Icc (0 : ℝ) 1 →
      IsPeriodicSmoothBounded (m + 15) M₁ w →
      IsRealJetPerturb (m + 2) ((4 * (q : ℝ))⁻¹) e_X →
      IsRealJetPerturb (m + 2) ((4 * (q : ℝ))⁻¹) τ_T →
      ∀ x : ℝ,
        (q : ℝ) ^ 2 *
          |realMidpointDispU w (fun y => y + ρ + e_X y) (fun y => c_T + τ_T y) u_param x| ≤
          C₀_mid := by
    intro q ρ c_T u_param w e_X τ_T hq hc_T hu hw _he_X hτ_T x
    set X_x := x + ρ + e_X x
    set T_x := c_T + τ_T x
    set h := u_param * T_x / 2
    set M₀ := X_x + h
    set d := realMidpointDispU w (fun y => y + ρ + e_X y) (fun y => c_T + τ_T y) u_param x
    have hmid : primPhi_ℝ w (M₀ + d) = (primPhi_ℝ w (M₀ - h) + primPhi_ℝ w (M₀ + h)) / 2 := by
      have h1 : M₀ + d = midpoint_ℝ w X_x (X_x + u_param * T_x) := by
        dsimp [M₀, h, d, realMidpointDispU]; ring
      have h2 : M₀ - h = X_x := by dsimp [M₀, h]; ring
      have h3 : M₀ + h = X_x + u_param * T_x := by dsimp [M₀, h]; ring
      rw [h1, h2, h3]; exact H_base.midpoint_eq w hw X_x (X_x + u_param * T_x)
    have hid := h_c0_identity w hw M₀ h d hmid
    have hK0_ge := h_rmdK0_lower w hw M₀ d
    have hK0_pos : 0 < rmdK0 w M₀ d := lt_of_lt_of_le (Real.exp_pos _) hK0_ge
    have hKsym_le := h_rmdKsym_upper w hw M₀ h
    have hh2_le := (h_step_h_bounds q c_T u_param τ_T hq hc_T hu hτ_T x).2
    have h_abs_id : |d| * rmdK0 w M₀ d = h ^ 2 * |rmdKsym w M₀ h| := by
      have := congrArg _root_.abs hid
      rwa [abs_mul, abs_mul, abs_of_pos hK0_pos, abs_of_nonneg (sq_nonneg h)] at this
    have h_d_exp : |d| * Real.exp (-2 * M₁) ≤ (21 / (q : ℝ) ^ 2) * (M₁ * Real.exp (2 * M₁)) := by
      calc
        |d| * Real.exp (-2 * M₁) ≤ |d| * rmdK0 w M₀ d :=
          mul_le_mul_of_nonneg_left hK0_ge (abs_nonneg d)
        _ = h ^ 2 * |rmdKsym w M₀ h| := h_abs_id
        _ ≤ (21 / (q : ℝ) ^ 2) * (M₁ * Real.exp (2 * M₁)) :=
          mul_le_mul hh2_le hKsym_le (abs_nonneg _) (by positivity)
    have hq2_pos : (0 : ℝ) < (q : ℝ) ^ 2 := by
      have : (0 : ℝ) < (q : ℝ) := by exact_mod_cast (by omega : 0 < q)
      positivity
    have hexp_cancel : Real.exp (-2 * M₁) * Real.exp (2 * M₁) = 1 := by
      have h0 : -2 * M₁ + 2 * M₁ = 0 := by ring
      rw [← Real.exp_add, h0, Real.exp_zero]
    have hexp_4 : Real.exp (2 * M₁) * Real.exp (2 * M₁) = Real.exp (4 * M₁) := by
      rw [← Real.exp_add]; congr 1; ring
    calc
      (q : ℝ) ^ 2 * |d|
          = ((q : ℝ) ^ 2 * Real.exp (2 * M₁)) * (|d| * Real.exp (-2 * M₁)) := by
            calc
              (q : ℝ) ^ 2 * |d| = (q : ℝ) ^ 2 * |d| * (Real.exp (-2 * M₁) * Real.exp (2 * M₁)) := by
                rw [hexp_cancel, mul_one]
              _ = ((q : ℝ) ^ 2 * Real.exp (2 * M₁)) * (|d| * Real.exp (-2 * M₁)) := by ring
      _ ≤ ((q : ℝ) ^ 2 * Real.exp (2 * M₁)) * ((21 / (q : ℝ) ^ 2) * (M₁ * Real.exp (2 * M₁))) :=
          mul_le_mul_of_nonneg_left h_d_exp (by positivity)
      _ = 21 * M₁ * (Real.exp (2 * M₁) * Real.exp (2 * M₁)) * ((q : ℝ) ^ 2 / (q : ℝ) ^ 2) := by
          ring
      _ = C₀_mid := by
          rw [hexp_4, div_self (ne_of_gt hq2_pos), mul_one]

  let L₀_mid : ℝ :=
    Real.exp (4 * M₁) * (5 * M₁ + 21 * (2 * M₁ ^ 2 + 3 * M₁ + 1) + 2 * (M₁ + 1) * C₀_mid)
  have hL₀_pos : 0 < L₀_mid := by positivity

  have h_c0_lip : ∀ (q : ℕ) (ρ c_T Δe Δτ u_param : ℝ) (w₁ w₂ : ℝ → ℝ)
      (e_X₁ τ_T₁ e_X₂ τ_T₂ : ℝ → ℝ),
      4 ≤ q → |c_T| ≤ 2 * Real.pi / (q : ℝ) → u_param ∈ Set.Icc (0 : ℝ) 1 →
      0 ≤ Δe → 0 ≤ Δτ →
      IsPeriodicSmoothBounded (m + 15) M₁ w₁ →
      IsPeriodicSmoothBounded (m + 15) M₁ w₂ →
      IsRealJetPerturb (m + 2) ((4 * (q : ℝ))⁻¹) e_X₁ →
      IsRealJetPerturb (m + 2) ((4 * (q : ℝ))⁻¹) τ_T₁ →
      IsRealJetPerturb (m + 2) ((4 * (q : ℝ))⁻¹) e_X₂ →
      IsRealJetPerturb (m + 2) ((4 * (q : ℝ))⁻¹) τ_T₂ →
      (∀ k : ℕ, k ≤ m + 2 → ∀ y : ℝ, |iteratedDeriv k (fun z => e_X₁ z - e_X₂ z) y| ≤ Δe) →
      (∀ k : ℕ, k ≤ m + 2 → ∀ y : ℝ, |iteratedDeriv k (fun z => τ_T₁ z - τ_T₂ z) y| ≤ Δτ) →
      ∀ x : ℝ,
        (q : ℝ) ^ 2 *
          |realMidpointDispU w₁ (fun y => y + ρ + e_X₁ y) (fun y => c_T + τ_T₁ y) u_param x -
           realMidpointDispU w₂ (fun y => y + ρ + e_X₂ y) (fun y => c_T + τ_T₂ y) u_param x| ≤
          L₀_mid * (Δe + (q : ℝ) * Δτ + realDiffSup (m + 15) w₁ w₂) := by
    intro q ρ c_T Δe Δτ u_param w₁ w₂ e_X₁ τ_T₁ e_X₂ τ_T₂
      hq hc_T hu hΔe hΔτ hw₁ hw₂ he_X₁ hτ_T₁ he_X₂ hτ_T₂ hde hdτ x
    obtain ⟨hw₁_cont, _, _, hw₁_hd, hw₁_1_hd, hw₁_bnd⟩ := hw_deriv_props w₁ hw₁
    obtain ⟨_, _, _, _, _, hw₂_bnd⟩ := hw_deriv_props w₂ hw₂
    obtain ⟨hDw_nonneg, hDw_bnd⟩ := H_base.diff_global_bound w₁ w₂ hw₁ hw₂
    set Δw := realDiffSup (m + 15) w₁ w₂
    set Λ := Δe + (q : ℝ) * Δτ + Δw
    have hq_ge4 : (4 : ℝ) ≤ (q : ℝ) := by exact_mod_cast hq
    have hq_pos : (0 : ℝ) < (q : ℝ) := by linarith
    have hq2_pos : (0 : ℝ) < (q : ℝ) ^ 2 := by positivity
    have hΛ_nonneg : 0 ≤ Λ := by positivity
    have hw_pt_lip : ∀ z₁ z₂ : ℝ, |w₁ z₁ - w₂ z₂| ≤ M₁ * |z₁ - z₂| + Δw := by
      intro z₁ z₂
      have h1 : |w₁ z₁ - w₁ z₂| ≤ M₁ * |z₁ - z₂| := by
        simpa [Real.norm_eq_abs] using
          Convex.norm_image_sub_le_of_norm_deriv_le
            (𝕜 := ℝ) (s := Set.univ) (f := w₁) (C := M₁)
            (fun z _ => (hw₁_hd z).differentiableAt)
            (fun z _ => by simpa [Real.norm_eq_abs] using (hw₁_bnd z).2.1)
            convex_univ trivial trivial
      have h2 : |w₁ z₂ - w₂ z₂| ≤ Δw := by
        simpa [iteratedDeriv_zero] using hDw_bnd 0 (by omega) z₂
      calc
        |w₁ z₁ - w₂ z₂| = |(w₁ z₁ - w₁ z₂) + (w₁ z₂ - w₂ z₂)| := by ring_nf
        _ ≤ |w₁ z₁ - w₁ z₂| + |w₁ z₂ - w₂ z₂| := abs_add_le _ _
        _ ≤ M₁ * |z₁ - z₂| + Δw := add_le_add h1 h2
    have hw1_pt_lip : ∀ z₁ z₂ : ℝ, |deriv w₁ z₁ - deriv w₂ z₂| ≤ M₁ * |z₁ - z₂| + Δw := by
      intro z₁ z₂
      have hd2_eq : deriv (deriv w₁) = iteratedDeriv 2 w₁ := by
        rw [iteratedDeriv_succ, iteratedDeriv_one]
      have h1 : |deriv w₁ z₁ - deriv w₁ z₂| ≤ M₁ * |z₁ - z₂| := by
        simpa [Real.norm_eq_abs] using
          Convex.norm_image_sub_le_of_norm_deriv_le
            (𝕜 := ℝ) (s := Set.univ) (f := deriv w₁) (C := M₁)
            (fun z _ => (hw₁_1_hd z).differentiableAt)
            (fun z _ => by rw [Real.norm_eq_abs, hd2_eq]; exact (hw₁_bnd z).2.2)
            convex_univ trivial trivial
      have h2 : |deriv w₁ z₂ - deriv w₂ z₂| ≤ Δw := by
        have hsub : deriv (fun y => w₁ y - w₂ y) z₂ = deriv w₁ z₂ - deriv w₂ z₂ := by
          have hw2_hd := (hw_deriv_props w₂ hw₂).2.2.2.1 z₂
          exact ((hw₁_hd z₂).sub hw2_hd).deriv
        have hb := hDw_bnd 1 (by omega) z₂
        rwa [iteratedDeriv_one, hsub] at hb
      calc
        |deriv w₁ z₁ - deriv w₂ z₂|
            = |(deriv w₁ z₁ - deriv w₁ z₂) + (deriv w₁ z₂ - deriv w₂ z₂)| := by ring_nf
        _ ≤ |deriv w₁ z₁ - deriv w₁ z₂| + |deriv w₁ z₂ - deriv w₂ z₂| := abs_add_le _ _
        _ ≤ M₁ * |z₁ - z₂| + Δw := add_le_add h1 h2
    have hexp_pt_lip : ∀ u₁ u₂ : ℝ,
        u₁ ∈ Set.Icc (-2 * M₁) (2 * M₁) →
        u₂ ∈ Set.Icc (-2 * M₁) (2 * M₁) →
        |Real.exp u₁ - Real.exp u₂| ≤ Real.exp (2 * M₁) * |u₁ - u₂| := by
      intro u₁ u₂ hu₁ hu₂
      simpa [Real.norm_eq_abs] using
        Convex.norm_image_sub_le_of_norm_deriv_le
          (𝕜 := ℝ) (s := Set.Icc (-2 * M₁) (2 * M₁)) (f := Real.exp) (C := Real.exp (2 * M₁))
          (fun u _ => Real.differentiableAt_exp)
          (fun u hu => by
            rw [Real.deriv_exp, Real.norm_eq_abs, abs_of_pos (Real.exp_pos u)]
            exact Real.exp_le_exp.mpr hu.2)
          (convex_Icc _ _) hu₂ hu₁

    set X₁_x := x + ρ + e_X₁ x
    set T₁_x := c_T + τ_T₁ x
    set h₁ := u_param * T₁_x / 2
    set M₀₁ := X₁_x + h₁
    set d₁ := realMidpointDispU w₁ (fun y => y + ρ + e_X₁ y) (fun y => c_T + τ_T₁ y) u_param x
    set X₂_x := x + ρ + e_X₂ x
    set T₂_x := c_T + τ_T₂ x
    set h₂ := u_param * T₂_x / 2
    set M₀₂ := X₂_x + h₂
    set d₂ := realMidpointDispU w₂ (fun y => y + ρ + e_X₂ y) (fun y => c_T + τ_T₂ y) u_param x

    have hid₁ : d₁ * rmdK0 w₁ M₀₁ d₁ = h₁ ^ 2 * rmdKsym w₁ M₀₁ h₁ := by
      apply h_c0_identity w₁ hw₁ M₀₁ h₁ d₁
      have ha : M₀₁ + d₁ = midpoint_ℝ w₁ X₁_x (X₁_x + u_param * T₁_x) := by
        dsimp [M₀₁, h₁, d₁, realMidpointDispU]; ring
      have hb : M₀₁ - h₁ = X₁_x := by dsimp [M₀₁, h₁]; ring
      have hc : M₀₁ + h₁ = X₁_x + u_param * T₁_x := by dsimp [M₀₁, h₁]; ring
      rw [ha, hb, hc]; exact H_base.midpoint_eq w₁ hw₁ _ _
    have hid₂ : d₂ * rmdK0 w₂ M₀₂ d₂ = h₂ ^ 2 * rmdKsym w₂ M₀₂ h₂ := by
      apply h_c0_identity w₂ hw₂ M₀₂ h₂ d₂
      have ha : M₀₂ + d₂ = midpoint_ℝ w₂ X₂_x (X₂_x + u_param * T₂_x) := by
        dsimp [M₀₂, h₂, d₂, realMidpointDispU]; ring
      have hb : M₀₂ - h₂ = X₂_x := by dsimp [M₀₂, h₂]; ring
      have hc : M₀₂ + h₂ = X₂_x + u_param * T₂_x := by dsimp [M₀₂, h₂]; ring
      rw [ha, hb, hc]; exact H_base.midpoint_eq w₂ hw₂ _ _
    let K_seg : ℝ := ∫ s in (0 : ℝ)..1, Real.exp (w₁ (M₀₁ + d₂ + s * (d₁ - d₂)) - w₁ M₀₁)
    have h_seg_eq : (d₁ - d₂) * K_seg =
        (h₁ ^ 2 * rmdKsym w₁ M₀₁ h₁ - h₂ ^ 2 * rmdKsym w₂ M₀₂ h₂) -
          d₂ * (rmdK0 w₁ M₀₁ d₂ - rmdK0 w₂ M₀₂ d₂) := by
      have h_ftc_seg :
          Real.exp (-w₁ M₀₁) * (primPhi_ℝ w₁ (M₀₁ + d₁) - primPhi_ℝ w₁ (M₀₁ + d₂)) =
            (d₁ - d₂) * K_seg := by
        let g : ℝ → ℝ := fun s => Real.exp (-w₁ M₀₁) * primPhi_ℝ w₁ (M₀₁ + d₂ + s * (d₁ - d₂))
        let g' : ℝ → ℝ := fun s => (d₁ - d₂) * Real.exp (w₁ (M₀₁ + d₂ + s * (d₁ - d₂)) - w₁ M₀₁)
        have hg_hd : ∀ s : ℝ, HasDerivAt g (g' s) s := by
          intro s
          have hs : HasDerivAt (fun t : ℝ => M₀₁ + d₂ + t * (d₁ - d₂)) (0 + 1 * (d₁ - d₂)) s :=
            (hasDerivAt_const s (M₀₁ + d₂)).add ((hasDerivAt_id s).mul_const (d₁ - d₂))
          have hc := ((H_base.primPhi_hasDerivAt w₁ hw₁ _).comp s hs).const_mul (Real.exp (-w₁ M₀₁))
          convert hc using 1; dsimp [g']
          have hexp : Real.exp (-w₁ M₀₁) * Real.exp (w₁ (M₀₁ + d₂ + s * (d₁ - d₂))) =
              Real.exp (w₁ (M₀₁ + d₂ + s * (d₁ - d₂)) - w₁ M₀₁) := by
            rw [← Real.exp_add]; congr 1; ring
          calc
            (d₁ - d₂) * Real.exp (w₁ (M₀₁ + d₂ + s * (d₁ - d₂)) - w₁ M₀₁)
                = (Real.exp (-w₁ M₀₁) * Real.exp (w₁ (M₀₁ + d₂ + s * (d₁ - d₂)))) * (d₁ - d₂) := by
                  rw [hexp]; ring
            _ = Real.exp (-w₁ M₀₁) * (Real.exp (w₁ (M₀₁ + d₂ + s * (d₁ - d₂))) * (0 + 1 * (d₁ - d₂))) := by
                  ring
        have hg'_cont : Continuous g' :=
          continuous_const.mul (Real.continuous_exp.comp
            ((hw₁_cont.comp (continuous_const.add (continuous_id.mul continuous_const))).sub
              continuous_const))
        have hint := h_ftc_unit1 g g' hg'_cont hg_hd
        have heval : g 1 - g 0 =
            Real.exp (-w₁ M₀₁) * (primPhi_ℝ w₁ (M₀₁ + d₁) - primPhi_ℝ w₁ (M₀₁ + d₂)) := by
          dsimp [g]
          have h1 : M₀₁ + d₂ + 1 * (d₁ - d₂) = M₀₁ + d₁ := by ring
          have h0 : M₀₁ + d₂ + 0 * (d₁ - d₂) = M₀₁ + d₂ := by ring
          rw [h1, h0]; ring
        rw [← heval, hint]
        dsimp [g', K_seg]
        exact intervalIntegral.integral_const_mul (d₁ - d₂) _
      have h_split_phi :
          Real.exp (-w₁ M₀₁) * (primPhi_ℝ w₁ (M₀₁ + d₁) - primPhi_ℝ w₁ (M₀₁ + d₂)) =
            Real.exp (-w₁ M₀₁) * (primPhi_ℝ w₁ (M₀₁ + d₁) - primPhi_ℝ w₁ M₀₁) -
              Real.exp (-w₁ M₀₁) * (primPhi_ℝ w₁ (M₀₁ + d₂) - primPhi_ℝ w₁ M₀₁) := by ring
      rw [← h_ftc_seg, h_split_phi, h_primPhi_shift_eq w₁ hw₁ M₀₁ d₁,
        h_primPhi_shift_eq w₁ hw₁ M₀₁ d₂, hid₁]
      linarith [hid₂]

    have hKseg_ge : Real.exp (-2 * M₁) ≤ K_seg := by
      have h_const_int : (∫ _s in (0 : ℝ)..1, Real.exp (-2 * M₁)) = Real.exp (-2 * M₁) := by simp
      rw [← h_const_int]
      apply intervalIntegral.integral_mono_on zero_le_one intervalIntegrable_const
      · exact (Real.continuous_exp.comp
          ((hw₁_cont.comp (continuous_const.add (continuous_id.mul continuous_const))).sub
            continuous_const)).intervalIntegrable 0 1
      · intro s _
        apply Real.exp_le_exp.mpr
        have h1 := (hw₁_bnd (M₀₁ + d₂ + s * (d₁ - d₂))).1
        have h2 := (hw₁_bnd M₀₁).1
        rw [abs_le] at h1 h2; linarith
    have hKseg_pos : 0 < K_seg := lt_of_lt_of_le (Real.exp_pos _) hKseg_ge

    have hde0 : |e_X₁ x - e_X₂ x| ≤ Δe := by
      simpa [iteratedDeriv_zero] using hde 0 (by omega) x
    have hdτ0 : |τ_T₁ x - τ_T₂ x| ≤ Δτ := by
      simpa [iteratedDeriv_zero] using hdτ 0 (by omega) x
    have hu_abs : |u_param| ≤ 1 := by rw [abs_of_nonneg hu.1]; exact hu.2
    have hh_diff : |h₁ - h₂| ≤ Δτ / 2 := by
      have hEq : h₁ - h₂ = u_param * (τ_T₁ x - τ_T₂ x) / 2 := by dsimp [h₁, h₂, T₁_x, T₂_x]; ring
      rw [hEq, abs_div, abs_mul, abs_of_pos (by norm_num : (0 : ℝ) < 2)]
      calc
        |u_param| * |τ_T₁ x - τ_T₂ x| / 2 ≤ 1 * Δτ / 2 := by
          apply div_le_div_of_nonneg_right _ (by norm_num)
          exact mul_le_mul hu_abs hdτ0 (abs_nonneg _) zero_le_one
        _ = Δτ / 2 := by ring
    have hM₀_diff : |M₀₁ - M₀₂| ≤ Δe + Δτ / 2 := by
      have hEq : M₀₁ - M₀₂ = (e_X₁ x - e_X₂ x) + (h₁ - h₂) := by dsimp [M₀₁, M₀₂, X₁_x, X₂_x]; ring
      rw [hEq]
      exact le_trans (abs_add_le _ _) (add_le_add hde0 hh_diff)
    have h_q_dtau : Δτ ≤ (q : ℝ) * Δτ := by nlinarith
    have hM₀_le_Λ : |M₀₁ - M₀₂| ≤ Λ := by dsimp [Λ]; linarith
    have h_M₀_sh_le_Λ : ∀ (s : ℝ), s ∈ Set.Icc (0 : ℝ) 1 →
        |(M₀₁ + s * h₁) - (M₀₂ + s * h₂)| ≤ Λ ∧
        |(M₀₁ - s * h₁) - (M₀₂ - s * h₂)| ≤ Λ := by
      intro s hs
      have hs_abs : |s| ≤ 1 := by rw [abs_of_nonneg hs.1]; exact hs.2
      have hsh : |s * (h₁ - h₂)| ≤ Δτ / 2 := by
        rw [abs_mul]
        calc
          |s| * |h₁ - h₂| ≤ 1 * (Δτ / 2) := mul_le_mul hs_abs hh_diff (abs_nonneg _) zero_le_one
          _ = Δτ / 2 := one_mul _
      refine ⟨?_, ?_⟩
      · have hEq : (M₀₁ + s * h₁) - (M₀₂ + s * h₂) = (M₀₁ - M₀₂) + s * (h₁ - h₂) := by ring
        rw [hEq]
        have := le_trans (abs_add_le _ _) (add_le_add hM₀_diff hsh)
        dsimp [Λ]; linarith
      · have hEq : (M₀₁ - s * h₁) - (M₀₂ - s * h₂) = (M₀₁ - M₀₂) - s * (h₁ - h₂) := by ring
        rw [hEq]
        have := le_trans (abs_sub _ _) (add_le_add hM₀_diff hsh)
        dsimp [Λ]; linarith
    obtain ⟨hh₁_abs, _⟩ := h_step_h_bounds q c_T u_param τ_T₁ hq hc_T hu hτ_T₁ x
    obtain ⟨hh₂_abs, hh₂_sq⟩ := h_step_h_bounds q c_T u_param τ_T₂ hq hc_T hu hτ_T₂ x
    have hh_sq_diff : |h₁ ^ 2 - h₂ ^ 2| ≤ (5 / (q : ℝ) ^ 2) * Λ := by
      have hEq : h₁ ^ 2 - h₂ ^ 2 = (h₁ - h₂) * (h₁ + h₂) := by ring
      have hsum : |h₁ + h₂| ≤ 9 / (q : ℝ) := by
        calc
          |h₁ + h₂| ≤ |h₁| + |h₂| := abs_add_le _ _
          _ ≤ 9 / (2 * (q : ℝ)) + 9 / (2 * (q : ℝ)) := add_le_add hh₁_abs hh₂_abs
          _ = 9 / (q : ℝ) := by ring
      rw [hEq, abs_mul]
      calc
        |h₁ - h₂| * |h₁ + h₂| ≤ (Δτ / 2) * (9 / (q : ℝ)) :=
          mul_le_mul hh_diff hsum (abs_nonneg _) (by positivity)
        _ = (9 / 2 / (q : ℝ) ^ 2) * ((q : ℝ) * Δτ) := by field_simp
        _ ≤ (5 / (q : ℝ) ^ 2) * ((q : ℝ) * Δτ) := by
          apply mul_le_mul_of_nonneg_right _ (by positivity)
          exact div_le_div_of_nonneg_right (by norm_num) (sq_nonneg _)
        _ ≤ (5 / (q : ℝ) ^ 2) * Λ := by
          apply mul_le_mul_of_nonneg_left _ (by positivity)
          dsimp [Λ]; linarith

    have hK0_diff : |rmdK0 w₁ M₀₁ d₂ - rmdK0 w₂ M₀₂ d₂| ≤
        2 * (M₁ + 1) * Real.exp (2 * M₁) * Λ := by
      dsimp [rmdK0]
      have hi1 : IntervalIntegrable (fun s => Real.exp (w₁ (M₀₁ + s * d₂) - w₁ M₀₁))
          MeasureTheory.volume 0 1 :=
        (Real.continuous_exp.comp
          ((hw₁_cont.comp (continuous_const.add (continuous_id.mul continuous_const))).sub
            continuous_const)).intervalIntegrable 0 1
      have hw₂_cont := (hw_deriv_props w₂ hw₂).1
      have hi2 : IntervalIntegrable (fun s => Real.exp (w₂ (M₀₂ + s * d₂) - w₂ M₀₂))
          MeasureTheory.volume 0 1 :=
        (Real.continuous_exp.comp
          ((hw₂_cont.comp (continuous_const.add (continuous_id.mul continuous_const))).sub
            continuous_const)).intervalIntegrable 0 1
      rw [← intervalIntegral.integral_sub hi1 hi2, ← Real.norm_eq_abs]
      have hb := intervalIntegral.norm_integral_le_of_norm_le_const
        (a := 0) (b := 1) (C := 2 * (M₁ + 1) * Real.exp (2 * M₁) * Λ)
        (f := fun s => Real.exp (w₁ (M₀₁ + s * d₂) - w₁ M₀₁) -
          Real.exp (w₂ (M₀₂ + s * d₂) - w₂ M₀₂))
        (fun s _ => by
          rw [Real.norm_eq_abs]
          have hu₁ : w₁ (M₀₁ + s * d₂) - w₁ M₀₁ ∈ Set.Icc (-2 * M₁) (2 * M₁) := by
            have ha := (hw₁_bnd (M₀₁ + s * d₂)).1; have hb := (hw₁_bnd M₀₁).1
            rw [abs_le] at ha hb; exact ⟨by linarith, by linarith⟩
          have hu₂ : w₂ (M₀₂ + s * d₂) - w₂ M₀₂ ∈ Set.Icc (-2 * M₁) (2 * M₁) := by
            have ha := (hw₂_bnd (M₀₂ + s * d₂)).1; have hb := (hw₂_bnd M₀₂).1
            rw [abs_le] at ha hb; exact ⟨by linarith, by linarith⟩
          have h_arg : |(w₁ (M₀₁ + s * d₂) - w₁ M₀₁) - (w₂ (M₀₂ + s * d₂) - w₂ M₀₂)| ≤
              2 * (M₁ + 1) * Λ := by
            have hEq : (w₁ (M₀₁ + s * d₂) - w₁ M₀₁) - (w₂ (M₀₂ + s * d₂) - w₂ M₀₂) =
                (w₁ (M₀₁ + s * d₂) - w₂ (M₀₂ + s * d₂)) - (w₁ M₀₁ - w₂ M₀₂) := by ring
            have h1 := hw_pt_lip (M₀₁ + s * d₂) (M₀₂ + s * d₂)
            have h1_eq : (M₀₁ + s * d₂) - (M₀₂ + s * d₂) = M₀₁ - M₀₂ := by ring
            rw [h1_eq] at h1
            have h2 := hw_pt_lip M₀₁ M₀₂
            have hΔw_le : Δw ≤ Λ := by dsimp [Λ]; linarith
            rw [hEq]
            calc
              |(w₁ (M₀₁ + s * d₂) - w₂ (M₀₂ + s * d₂)) - (w₁ M₀₁ - w₂ M₀₂)|
                  ≤ |w₁ (M₀₁ + s * d₂) - w₂ (M₀₂ + s * d₂)| + |w₁ M₀₁ - w₂ M₀₂| := abs_sub _ _
              _ ≤ (M₁ * |M₀₁ - M₀₂| + Δw) + (M₁ * |M₀₁ - M₀₂| + Δw) := add_le_add h1 h2
              _ ≤ (M₁ * Λ + Λ) + (M₁ * Λ + Λ) := by nlinarith
              _ = 2 * (M₁ + 1) * Λ := by ring
          calc
            |Real.exp (w₁ (M₀₁ + s * d₂) - w₁ M₀₁) - Real.exp (w₂ (M₀₂ + s * d₂) - w₂ M₀₂)|
                ≤ Real.exp (2 * M₁) *
                    |(w₁ (M₀₁ + s * d₂) - w₁ M₀₁) - (w₂ (M₀₂ + s * d₂) - w₂ M₀₂)| :=
              hexp_pt_lip _ _ hu₁ hu₂
            _ ≤ Real.exp (2 * M₁) * (2 * (M₁ + 1) * Λ) :=
              mul_le_mul_of_nonneg_left h_arg (le_of_lt (Real.exp_pos _))
            _ = 2 * (M₁ + 1) * Real.exp (2 * M₁) * Λ := by ring)
      simpa using hb

    have hKsym_diff : |rmdKsym w₁ M₀₁ h₁ - rmdKsym w₂ M₀₂ h₂| ≤
        (2 * M₁ ^ 2 + 3 * M₁ + 1) * Real.exp (2 * M₁) * Λ := by
      obtain ⟨_, hw₁_1_cont, _, _, _, _⟩ := hw_deriv_props w₁ hw₁
      obtain ⟨hw₂_cont, hw₂_1_cont, _, _, _, _⟩ := hw_deriv_props w₂ hw₂
      dsimp [rmdKsym]
      rw [← mul_sub, abs_mul, abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 1 / 2)]
      let f₁_int : ℝ → ℝ := fun s => (1 - s) *
        (deriv w₁ (M₀₁ + s * h₁) * Real.exp (w₁ (M₀₁ + s * h₁) - w₁ M₀₁) +
         deriv w₁ (M₀₁ - s * h₁) * Real.exp (w₁ (M₀₁ - s * h₁) - w₁ M₀₁))
      let f₂_int : ℝ → ℝ := fun s => (1 - s) *
        (deriv w₂ (M₀₂ + s * h₂) * Real.exp (w₂ (M₀₂ + s * h₂) - w₂ M₀₂) +
         deriv w₂ (M₀₂ - s * h₂) * Real.exp (w₂ (M₀₂ - s * h₂) - w₂ M₀₂))
      have hf₁_cont : Continuous f₁_int :=
        (continuous_const.sub continuous_id).mul
          (((hw₁_1_cont.comp (continuous_const.add (continuous_id.mul continuous_const))).mul
            (Real.continuous_exp.comp
              ((hw₁_cont.comp (continuous_const.add (continuous_id.mul continuous_const))).sub
                continuous_const))).add
          ((hw₁_1_cont.comp (continuous_const.sub (continuous_id.mul continuous_const))).mul
            (Real.continuous_exp.comp
              ((hw₁_cont.comp (continuous_const.sub (continuous_id.mul continuous_const))).sub
                continuous_const))))
      have hf₂_cont : Continuous f₂_int :=
        (continuous_const.sub continuous_id).mul
          (((hw₂_1_cont.comp (continuous_const.add (continuous_id.mul continuous_const))).mul
            (Real.continuous_exp.comp
              ((hw₂_cont.comp (continuous_const.add (continuous_id.mul continuous_const))).sub
                continuous_const))).add
          ((hw₂_1_cont.comp (continuous_const.sub (continuous_id.mul continuous_const))).mul
            (Real.continuous_exp.comp
              ((hw₂_cont.comp (continuous_const.sub (continuous_id.mul continuous_const))).sub
                continuous_const))))
      change (1 / 2 : ℝ) * |(∫ s in (0 : ℝ)..1, f₁_int s) - (∫ s in (0 : ℝ)..1, f₂_int s)| ≤ _
      rw [← intervalIntegral.integral_sub (hf₁_cont.intervalIntegrable 0 1)
        (hf₂_cont.intervalIntegrable 0 1), ← Real.norm_eq_abs]
      have h_pt_branch : ∀ (y₁ y₂ : ℝ), |y₁ - y₂| ≤ Λ →
          |deriv w₁ y₁ * Real.exp (w₁ y₁ - w₁ M₀₁) -
            deriv w₂ y₂ * Real.exp (w₂ y₂ - w₂ M₀₂)| ≤
          (2 * M₁ ^ 2 + 3 * M₁ + 1) * Real.exp (2 * M₁) * Λ := by
        intro y₁ y₂ hy
        have hΔw_le : Δw ≤ Λ := by dsimp [Λ]; linarith
        have h_dw : |deriv w₁ y₁ - deriv w₂ y₂| ≤ (M₁ + 1) * Λ := by
          have h1 := hw1_pt_lip y₁ y₂; nlinarith
        have hu₁ : w₁ y₁ - w₁ M₀₁ ∈ Set.Icc (-2 * M₁) (2 * M₁) := by
          have ha := (hw₁_bnd y₁).1; have hb := (hw₁_bnd M₀₁).1
          rw [abs_le] at ha hb; exact ⟨by linarith, by linarith⟩
        have hu₂ : w₂ y₂ - w₂ M₀₂ ∈ Set.Icc (-2 * M₁) (2 * M₁) := by
          have ha := (hw₂_bnd y₂).1; have hb := (hw₂_bnd M₀₂).1
          rw [abs_le] at ha hb; exact ⟨by linarith, by linarith⟩
        have h_exp : |Real.exp (w₁ y₁ - w₁ M₀₁) - Real.exp (w₂ y₂ - w₂ M₀₂)| ≤
            2 * (M₁ + 1) * Real.exp (2 * M₁) * Λ := by
          have hEq : (w₁ y₁ - w₁ M₀₁) - (w₂ y₂ - w₂ M₀₂) =
              (w₁ y₁ - w₂ y₂) - (w₁ M₀₁ - w₂ M₀₂) := by ring
          have h1 := hw_pt_lip y₁ y₂
          have h2 := hw_pt_lip M₀₁ M₀₂
          have h_arg : |(w₁ y₁ - w₁ M₀₁) - (w₂ y₂ - w₂ M₀₂)| ≤ 2 * (M₁ + 1) * Λ := by
            rw [hEq]
            calc
              |(w₁ y₁ - w₂ y₂) - (w₁ M₀₁ - w₂ M₀₂)|
                  ≤ |w₁ y₁ - w₂ y₂| + |w₁ M₀₁ - w₂ M₀₂| := abs_sub _ _
              _ ≤ (M₁ * |y₁ - y₂| + Δw) + (M₁ * |M₀₁ - M₀₂| + Δw) := add_le_add h1 h2
              _ ≤ 2 * (M₁ + 1) * Λ := by nlinarith
          calc
            |Real.exp (w₁ y₁ - w₁ M₀₁) - Real.exp (w₂ y₂ - w₂ M₀₂)|
                ≤ Real.exp (2 * M₁) * |(w₁ y₁ - w₁ M₀₁) - (w₂ y₂ - w₂ M₀₂)| :=
              hexp_pt_lip _ _ hu₁ hu₂
            _ ≤ Real.exp (2 * M₁) * (2 * (M₁ + 1) * Λ) :=
              mul_le_mul_of_nonneg_left h_arg (le_of_lt (Real.exp_pos _))
            _ = 2 * (M₁ + 1) * Real.exp (2 * M₁) * Λ := by ring
        have h_split : deriv w₁ y₁ * Real.exp (w₁ y₁ - w₁ M₀₁) -
            deriv w₂ y₂ * Real.exp (w₂ y₂ - w₂ M₀₂) =
            (deriv w₁ y₁ - deriv w₂ y₂) * Real.exp (w₁ y₁ - w₁ M₀₁) +
              deriv w₂ y₂ * (Real.exp (w₁ y₁ - w₁ M₀₁) - Real.exp (w₂ y₂ - w₂ M₀₂)) := by ring
        have hexp1_le : |Real.exp (w₁ y₁ - w₁ M₀₁)| ≤ Real.exp (2 * M₁) := by
          rw [abs_of_pos (Real.exp_pos _)]; exact Real.exp_le_exp.mpr hu₁.2
        have hdw2_le : |deriv w₂ y₂| ≤ M₁ := (hw₂_bnd y₂).2.1
        rw [h_split]
        calc
          |(deriv w₁ y₁ - deriv w₂ y₂) * Real.exp (w₁ y₁ - w₁ M₀₁) +
              deriv w₂ y₂ * (Real.exp (w₁ y₁ - w₁ M₀₁) - Real.exp (w₂ y₂ - w₂ M₀₂))|
              ≤ |(deriv w₁ y₁ - deriv w₂ y₂) * Real.exp (w₁ y₁ - w₁ M₀₁)| +
                |deriv w₂ y₂ * (Real.exp (w₁ y₁ - w₁ M₀₁) - Real.exp (w₂ y₂ - w₂ M₀₂))| :=
            abs_add_le _ _
          _ = |deriv w₁ y₁ - deriv w₂ y₂| * |Real.exp (w₁ y₁ - w₁ M₀₁)| +
                |deriv w₂ y₂| * |Real.exp (w₁ y₁ - w₁ M₀₁) - Real.exp (w₂ y₂ - w₂ M₀₂)| := by
            rw [abs_mul, abs_mul]
          _ ≤ ((M₁ + 1) * Λ) * Real.exp (2 * M₁) +
                M₁ * (2 * (M₁ + 1) * Real.exp (2 * M₁) * Λ) :=
            add_le_add (mul_le_mul h_dw hexp1_le (abs_nonneg _) (by positivity))
              (mul_le_mul hdw2_le h_exp (abs_nonneg _) (le_of_lt hM₁))
          _ = (2 * M₁ ^ 2 + 3 * M₁ + 1) * Real.exp (2 * M₁) * Λ := by ring
      have hsub : Set.uIoc (0 : ℝ) 1 ⊆ Set.Icc (0 : ℝ) 1 := by
        rw [Set.uIoc_of_le zero_le_one]; exact Set.Ioc_subset_Icc_self
      have hb := intervalIntegral.norm_integral_le_of_norm_le_const
        (a := 0) (b := 1) (C := 2 * ((2 * M₁ ^ 2 + 3 * M₁ + 1) * Real.exp (2 * M₁) * Λ))
        (f := fun s => f₁_int s - f₂_int s)
        (fun s hs => by
          have hsI := hsub hs
          obtain ⟨hsh_p, hsh_m⟩ := h_M₀_sh_le_Λ s hsI
          have hp := h_pt_branch (M₀₁ + s * h₁) (M₀₂ + s * h₂) hsh_p
          have hm := h_pt_branch (M₀₁ - s * h₁) (M₀₂ - s * h₂) hsh_m
          have hEq : f₁_int s - f₂_int s = (1 - s) *
              ((deriv w₁ (M₀₁ + s * h₁) * Real.exp (w₁ (M₀₁ + s * h₁) - w₁ M₀₁) -
                deriv w₂ (M₀₂ + s * h₂) * Real.exp (w₂ (M₀₂ + s * h₂) - w₂ M₀₂)) +
               (deriv w₁ (M₀₁ - s * h₁) * Real.exp (w₁ (M₀₁ - s * h₁) - w₁ M₀₁) -
                deriv w₂ (M₀₂ - s * h₂) * Real.exp (w₂ (M₀₂ - s * h₂) - w₂ M₀₂))) := by
            dsimp [f₁_int, f₂_int]; ring
          rw [Real.norm_eq_abs, hEq, abs_mul, abs_of_nonneg (by linarith [hsI.2] : 0 ≤ 1 - s)]
          have h1s : 1 - s ≤ 1 := by linarith [hsI.1]
          have hsum := le_trans (abs_add_le _ _) (add_le_add hp hm)
          calc
            (1 - s) * |_ + _| ≤ 1 * (2 * ((2 * M₁ ^ 2 + 3 * M₁ + 1) * Real.exp (2 * M₁) * Λ)) := by
              apply mul_le_mul h1s _ (abs_nonneg _) zero_le_one
              linarith
            _ = 2 * ((2 * M₁ ^ 2 + 3 * M₁ + 1) * Real.exp (2 * M₁) * Λ) := one_mul _)
      have hb' : ‖∫ s in (0 : ℝ)..1, f₁_int s - f₂_int s‖ ≤
          2 * ((2 * M₁ ^ 2 + 3 * M₁ + 1) * Real.exp (2 * M₁) * Λ) := by simpa using hb
      linarith

    have hd₂_le : |d₂| ≤ C₀_mid / (q : ℝ) ^ 2 := by
      have hc0 := h_c0_single q ρ c_T u_param w₂ e_X₂ τ_T₂ hq hc_T hu hw₂ he_X₂ hτ_T₂ x
      exact (le_div_iff₀' hq2_pos).mpr hc0
    have hKsym₁_le := h_rmdKsym_upper w₁ hw₁ M₀₁ h₁
    have h_rhs_le :
        |(h₁ ^ 2 * rmdKsym w₁ M₀₁ h₁ - h₂ ^ 2 * rmdKsym w₂ M₀₂ h₂) -
          d₂ * (rmdK0 w₁ M₀₁ d₂ - rmdK0 w₂ M₀₂ d₂)| ≤
        ((5 * M₁ + 21 * (2 * M₁ ^ 2 + 3 * M₁ + 1) + 2 * (M₁ + 1) * C₀_mid) *
          Real.exp (2 * M₁) * Λ) / (q : ℝ) ^ 2 := by
      have h_part1 : |h₁ ^ 2 * rmdKsym w₁ M₀₁ h₁ - h₂ ^ 2 * rmdKsym w₂ M₀₂ h₂| ≤
          ((5 * M₁ + 21 * (2 * M₁ ^ 2 + 3 * M₁ + 1)) * Real.exp (2 * M₁) * Λ) / (q : ℝ) ^ 2 := by
        have hEq : h₁ ^ 2 * rmdKsym w₁ M₀₁ h₁ - h₂ ^ 2 * rmdKsym w₂ M₀₂ h₂ =
            (h₁ ^ 2 - h₂ ^ 2) * rmdKsym w₁ M₀₁ h₁ +
              h₂ ^ 2 * (rmdKsym w₁ M₀₁ h₁ - rmdKsym w₂ M₀₂ h₂) := by ring
        rw [hEq]
        calc
          |(h₁ ^ 2 - h₂ ^ 2) * rmdKsym w₁ M₀₁ h₁ +
              h₂ ^ 2 * (rmdKsym w₁ M₀₁ h₁ - rmdKsym w₂ M₀₂ h₂)|
              ≤ |(h₁ ^ 2 - h₂ ^ 2) * rmdKsym w₁ M₀₁ h₁| +
                |h₂ ^ 2 * (rmdKsym w₁ M₀₁ h₁ - rmdKsym w₂ M₀₂ h₂)| := abs_add_le _ _
          _ = |h₁ ^ 2 - h₂ ^ 2| * |rmdKsym w₁ M₀₁ h₁| +
                h₂ ^ 2 * |rmdKsym w₁ M₀₁ h₁ - rmdKsym w₂ M₀₂ h₂| := by
            rw [abs_mul, abs_mul, abs_of_nonneg (sq_nonneg h₂)]
          _ ≤ ((5 / (q : ℝ) ^ 2) * Λ) * (M₁ * Real.exp (2 * M₁)) +
                (21 / (q : ℝ) ^ 2) * ((2 * M₁ ^ 2 + 3 * M₁ + 1) * Real.exp (2 * M₁) * Λ) :=
            add_le_add (mul_le_mul hh_sq_diff hKsym₁_le (abs_nonneg _) (by positivity))
              (mul_le_mul hh₂_sq hKsym_diff (abs_nonneg _) (by positivity))
          _ = ((5 * M₁ + 21 * (2 * M₁ ^ 2 + 3 * M₁ + 1)) * Real.exp (2 * M₁) * Λ) /
                (q : ℝ) ^ 2 := by ring
      have h_part2 : |d₂ * (rmdK0 w₁ M₀₁ d₂ - rmdK0 w₂ M₀₂ d₂)| ≤
          (2 * (M₁ + 1) * C₀_mid * Real.exp (2 * M₁) * Λ) / (q : ℝ) ^ 2 := by
        rw [abs_mul]
        calc
          |d₂| * |rmdK0 w₁ M₀₁ d₂ - rmdK0 w₂ M₀₂ d₂|
              ≤ (C₀_mid / (q : ℝ) ^ 2) * (2 * (M₁ + 1) * Real.exp (2 * M₁) * Λ) :=
            mul_le_mul hd₂_le hK0_diff (abs_nonneg _) (by positivity)
          _ = (2 * (M₁ + 1) * C₀_mid * Real.exp (2 * M₁) * Λ) / (q : ℝ) ^ 2 := by ring
      calc
        |(h₁ ^ 2 * rmdKsym w₁ M₀₁ h₁ - h₂ ^ 2 * rmdKsym w₂ M₀₂ h₂) -
            d₂ * (rmdK0 w₁ M₀₁ d₂ - rmdK0 w₂ M₀₂ d₂)|
            ≤ |h₁ ^ 2 * rmdKsym w₁ M₀₁ h₁ - h₂ ^ 2 * rmdKsym w₂ M₀₂ h₂| +
              |d₂ * (rmdK0 w₁ M₀₁ d₂ - rmdK0 w₂ M₀₂ d₂)| := abs_sub _ _
        _ ≤ ((5 * M₁ + 21 * (2 * M₁ ^ 2 + 3 * M₁ + 1)) * Real.exp (2 * M₁) * Λ) / (q : ℝ) ^ 2 +
              (2 * (M₁ + 1) * C₀_mid * Real.exp (2 * M₁) * Λ) / (q : ℝ) ^ 2 :=
          add_le_add h_part1 h_part2
        _ = ((5 * M₁ + 21 * (2 * M₁ ^ 2 + 3 * M₁ + 1) + 2 * (M₁ + 1) * C₀_mid) *
              Real.exp (2 * M₁) * Λ) / (q : ℝ) ^ 2 := by ring
    have h_abs_seg : |d₁ - d₂| * K_seg =
        |(h₁ ^ 2 * rmdKsym w₁ M₀₁ h₁ - h₂ ^ 2 * rmdKsym w₂ M₀₂ h₂) -
          d₂ * (rmdK0 w₁ M₀₁ d₂ - rmdK0 w₂ M₀₂ d₂)| := by
      have := congrArg _root_.abs h_seg_eq
      rwa [abs_mul, abs_of_pos hKseg_pos] at this
    have h_d_diff_exp : |d₁ - d₂| * Real.exp (-2 * M₁) ≤
        ((5 * M₁ + 21 * (2 * M₁ ^ 2 + 3 * M₁ + 1) + 2 * (M₁ + 1) * C₀_mid) *
          Real.exp (2 * M₁) * Λ) / (q : ℝ) ^ 2 := by
      calc
        |d₁ - d₂| * Real.exp (-2 * M₁) ≤ |d₁ - d₂| * K_seg :=
          mul_le_mul_of_nonneg_left hKseg_ge (abs_nonneg _)
        _ ≤ _ := by rw [h_abs_seg]; exact h_rhs_le
    have hexp_cancel : Real.exp (-2 * M₁) * Real.exp (2 * M₁) = 1 := by
      have h0 : -2 * M₁ + 2 * M₁ = 0 := by ring
      rw [← Real.exp_add, h0, Real.exp_zero]
    have hexp_4 : Real.exp (2 * M₁) * Real.exp (2 * M₁) = Real.exp (4 * M₁) := by
      rw [← Real.exp_add]; congr 1; ring
    calc
      (q : ℝ) ^ 2 * |d₁ - d₂|
          = ((q : ℝ) ^ 2 * Real.exp (2 * M₁)) * (|d₁ - d₂| * Real.exp (-2 * M₁)) := by
            calc
              (q : ℝ) ^ 2 * |d₁ - d₂|
                  = (q : ℝ) ^ 2 * |d₁ - d₂| * (Real.exp (-2 * M₁) * Real.exp (2 * M₁)) := by
                rw [hexp_cancel, mul_one]
              _ = ((q : ℝ) ^ 2 * Real.exp (2 * M₁)) * (|d₁ - d₂| * Real.exp (-2 * M₁)) := by ring
      _ ≤ ((q : ℝ) ^ 2 * Real.exp (2 * M₁)) *
            (((5 * M₁ + 21 * (2 * M₁ ^ 2 + 3 * M₁ + 1) + 2 * (M₁ + 1) * C₀_mid) *
              Real.exp (2 * M₁) * Λ) / (q : ℝ) ^ 2) :=
          mul_le_mul_of_nonneg_left h_d_diff_exp (by positivity)
      _ = (Real.exp (2 * M₁) * Real.exp (2 * M₁)) *
            (5 * M₁ + 21 * (2 * M₁ ^ 2 + 3 * M₁ + 1) + 2 * (M₁ + 1) * C₀_mid) * Λ *
            ((q : ℝ) ^ 2 / (q : ℝ) ^ 2) := by ring
      _ = L₀_mid * Λ := by
          rw [hexp_4, div_self (ne_of_gt hq2_pos), mul_one]

  have h_w_single : ∀ {r d_obs : ℕ} {B_Y : ℝ} {w Y : ℝ → ℝ},
      r ≤ m + 1 → d_obs ≤ 2 →
      IsPeriodicSmoothBounded (m + 15) M₁ w →
      rmdDerivBnd r B_Y Y →
      rmdJetBnd r (M₁ * rmdCompConst r B_Y) (fun y => iteratedDeriv d_obs w (Y y)) := by
    intro r d_obs B_Y w Y hr hd_obs hw hY
    have hg_cd : ContDiff ℝ (r : WithTop ℕ∞) (iteratedDeriv d_obs w) :=
      h_contDiff_iter d_obs r w (hw.2.1.of_le (by norm_cast; omega))
    have hg_bnd : ∀ j : ℕ, j ≤ r → ∀ z ∈ (Set.univ : Set ℝ),
        |iteratedDeriv j (iteratedDeriv d_obs w) z| ≤ M₁ := by
      intro j hj z _
      rw [h_iter_add d_obs j w]
      exact hw.2.2 (j + d_obs) (by omega) z
    exact h_jet_comp_on r Set.univ M₁ B_Y (iteratedDeriv d_obs w) Y
      hg_cd (le_of_lt hM₁) hg_bnd hY (fun _ => trivial)

  have h_iter_exp : ∀ j : ℕ, iteratedDeriv j Real.exp = Real.exp := by
    intro j
    induction j with
    | zero => simp [iteratedDeriv_zero]
    | succ j ih => rw [iteratedDeriv_succ, ih, Real.deriv_exp]

  have h_exp_w_single : ∀ {r : ℕ} {B_Y : ℝ} {w A B : ℝ → ℝ},
      r ≤ m + 1 →
      IsPeriodicSmoothBounded (m + 15) M₁ w →
      rmdDerivBnd r B_Y A →
      rmdDerivBnd r B_Y B →
      rmdJetBnd r
        (Real.exp (2 * M₁) * rmdCompConst r (2 * M₁ * rmdCompConst r B_Y))
        (fun y => Real.exp (w (A y) - w (B y))) := by
    intro r B_Y w A B hr hw hA hB
    have hwA : rmdJetBnd r (M₁ * rmdCompConst r B_Y) (fun y => w (A y)) := by
      simpa [iteratedDeriv_zero] using h_w_single hr (by omega : 0 ≤ 2) hw hA
    have hwB : rmdJetBnd r (M₁ * rmdCompConst r B_Y) (fun y => w (B y)) := by
      simpa [iteratedDeriv_zero] using h_w_single hr (by omega : 0 ≤ 2) hw hB
    have hU : rmdJetBnd r (2 * M₁ * rmdCompConst r B_Y) (fun y => w (A y) - w (B y)) :=
      h_jet_mono le_rfl (by linarith) (h_jet_sub hwA hwB)
    have hU_mem : ∀ y : ℝ, w (A y) - w (B y) ∈ Set.Icc (-2 * M₁) (2 * M₁) := by
      intro y
      have h1 : |w (A y)| ≤ M₁ := by simpa [iteratedDeriv_zero] using hw.2.2 0 (by omega) (A y)
      have h2 : |w (B y)| ≤ M₁ := by simpa [iteratedDeriv_zero] using hw.2.2 0 (by omega) (B y)
      rw [abs_le] at h1 h2
      exact ⟨by linarith, by linarith⟩
    have hexp_bnd : ∀ j : ℕ, j ≤ r → ∀ z ∈ Set.Icc (-2 * M₁) (2 * M₁),
        |iteratedDeriv j Real.exp z| ≤ Real.exp (2 * M₁) := by
      intro j _ z hz
      rw [h_iter_exp j, abs_of_pos (Real.exp_pos z)]
      exact Real.exp_le_exp.mpr hz.2
    exact h_jet_comp_on r (Set.Icc (-2 * M₁) (2 * M₁)) (Real.exp (2 * M₁))
      (2 * M₁ * rmdCompConst r B_Y) Real.exp (fun y => w (A y) - w (B y))
      (Real.contDiff_exp) (le_of_lt (Real.exp_pos _)) hexp_bnd (h_deriv_of_jet hU) hU_mem

  have h_M₀_h_jets : ∀ (q : ℕ) (ρ c_T u_param : ℝ) (e_X τ_T : ℝ → ℝ),
      4 ≤ q → |c_T| ≤ 2 * Real.pi / (q : ℝ) → u_param ∈ Set.Icc (0 : ℝ) 1 →
      IsRealJetPerturb (m + 2) ((4 * (q : ℝ))⁻¹) e_X →
      IsRealJetPerturb (m + 2) ((4 * (q : ℝ))⁻¹) τ_T →
      let X : ℝ → ℝ := fun y => y + ρ + e_X y
      let T : ℝ → ℝ := fun y => c_T + τ_T y
      let h_fn : ℝ → ℝ := fun y => u_param * T y / 2
      let M₀_fn : ℝ → ℝ := fun y => X y + u_param * T y / 2
      rmdDerivBnd (m + 2) 2 M₀_fn ∧
      rmdJetBnd (m + 1) 2 (deriv M₀_fn) ∧
      rmdJetBnd (m + 2) (9 / (2 * (q : ℝ))) h_fn ∧
      rmdDerivBnd (m + 2) (1 / (8 * (q : ℝ))) h_fn ∧
      rmdJetBnd (m + 1) (1 / (8 * (q : ℝ))) (deriv h_fn) := by
    intro q ρ c_T u_param e_X τ_T hq hc_T hu he_X hτ_T X T h_fn M₀_fn
    have hq_ge4 : (4 : ℝ) ≤ (q : ℝ) := by exact_mod_cast hq
    have hq_pos : (0 : ℝ) < (q : ℝ) := by linarith
    have h4q_le1 : (4 * (q : ℝ))⁻¹ ≤ 1 / 16 := by
      rw [inv_le_comm₀ (by positivity) (by norm_num)]
      linarith
    have hu_abs : |u_param| ≤ 1 := by rw [abs_of_nonneg hu.1]; exact hu.2
    have he_jet : rmdJetBnd (m + 2) ((4 * (q : ℝ))⁻¹) e_X :=
      ⟨he_X.2.1, by positivity, he_X.2.2⟩
    have hτ_jet : rmdJetBnd (m + 2) ((4 * (q : ℝ))⁻¹) τ_T :=
      ⟨hτ_T.2.1, by positivity, hτ_T.2.2⟩
    have hh_cd : ContDiff ℝ ((m + 2 : ℕ) : WithTop ℕ∞) h_fn :=
      (contDiff_const.mul (contDiff_const.add hτ_T.2.1)).div_const 2
    have hh_deriv_bnd : rmdDerivBnd (m + 2) (1 / (8 * (q : ℝ))) h_fn := by
      have hEq : h_fn = fun y => (u_param * c_T / 2) + (u_param / 2) * τ_T y := by
        funext y; dsimp [h_fn, T]; ring
      refine ⟨hh_cd, by positivity, ?_⟩
      intro j hj1 hj y
      have h_lin := h_jet_const_mul (u_param / 2) hτ_jet
      rw [hEq, iteratedDeriv_fun_add contDiffAt_const ((h_lin.1.of_le (by norm_cast)).contDiffAt),
        iteratedDeriv_const]
      have hj_ne0 : j ≠ 0 := by omega
      simp only [hj_ne0, ↓reduceIte, zero_add]
      calc
        |iteratedDeriv j (fun z => (u_param / 2) * τ_T z) y|
            ≤ |u_param / 2| * (4 * (q : ℝ))⁻¹ := h_lin.2.2 j hj y
        _ ≤ (1 / 2) * (4 * (q : ℝ))⁻¹ := by
          apply mul_le_mul_of_nonneg_right _ (by positivity)
          rw [abs_div, abs_of_pos (by norm_num : (0 : ℝ) < 2)]
          linarith
        _ = 1 / (8 * (q : ℝ)) := by field_simp; ring
    have hh_jet : rmdJetBnd (m + 2) (9 / (2 * (q : ℝ))) h_fn := by
      refine ⟨hh_cd, by positivity, ?_⟩
      intro j hj y
      cases j with
      | zero =>
        simpa [iteratedDeriv_zero] using (h_step_h_bounds q c_T u_param τ_T hq hc_T hu hτ_T y).1
      | succ j' =>
        have h1 := hh_deriv_bnd.2.2 (j' + 1) (by omega) hj y
        have h_le : 1 / (8 * (q : ℝ)) ≤ 9 / (2 * (q : ℝ)) := by
          rw [div_le_div_iff₀ (by positivity) (by positivity)]
          linarith
        exact le_trans h1 h_le
    have h_id_deriv : rmdDerivBnd (m + 2) 1 (fun y : ℝ => y + ρ) := by
      refine ⟨contDiff_id.add contDiff_const, zero_le_one, ?_⟩
      intro j hj1 _ y
      cases j with
      | zero => omega
      | succ j' =>
        rw [iteratedDeriv_succ']
        have hd_eq : deriv (fun z : ℝ => z + ρ) = fun _ => (1 : ℝ) := by
          funext z
          have hd_z : HasDerivAt (fun y : ℝ => y + ρ) (1 + 0) z :=
            (hasDerivAt_id z).add (hasDerivAt_const z ρ)
          simpa only [add_zero] using hd_z.deriv
        rw [hd_eq, iteratedDeriv_const]
        split_ifs <;> norm_num
    have hM₀_deriv : rmdDerivBnd (m + 2) 2 M₀_fn := by
      have hEq : M₀_fn = fun y => ((y + ρ) + e_X y) + h_fn y := by
        funext y; dsimp [M₀_fn, X, h_fn]
      rw [hEq]
      have hsum := h_deriv_add (h_deriv_add h_id_deriv (h_deriv_of_jet he_jet)) hh_deriv_bnd
      have h8q_le : 1 / (8 * (q : ℝ)) ≤ 1 / 32 := by
        rw [div_le_div_iff₀ (by positivity) (by norm_num)]
        linarith
      exact h_deriv_mono le_rfl (by linarith) hsum
    exact ⟨hM₀_deriv, h_jet_of_deriv hM₀_deriv, hh_jet, hh_deriv_bnd, h_jet_of_deriv hh_deriv_bnd⟩

  have h_single_kernels : ∀ (r : ℕ) (C_r : ℝ) (q : ℕ) (ρ c_T u_param : ℝ) (w e_X τ_T : ℝ → ℝ),
      r ≤ m + 1 → 0 < C_r → 4 ≤ q → |c_T| ≤ 2 * Real.pi / (q : ℝ) →
      u_param ∈ Set.Icc (0 : ℝ) 1 →
      IsPeriodicSmoothBounded (m + 15) M₁ w →
      IsRealJetPerturb (m + 2) ((4 * (q : ℝ))⁻¹) e_X →
      IsRealJetPerturb (m + 2) ((4 * (q : ℝ))⁻¹) τ_T →
      let X : ℝ → ℝ := fun y => y + ρ + e_X y
      let T : ℝ → ℝ := fun y => c_T + τ_T y
      let h_fn : ℝ → ℝ := fun y => u_param * T y / 2
      let M₀_fn : ℝ → ℝ := fun y => X y + u_param * T y / 2
      let d_fn : ℝ → ℝ := realMidpointDispU w X T u_param
      let B_r := 3 + C_r / 16
      let K_c := rmdCompConst r B_r
      let M_E := Real.exp (2 * M₁) * rmdCompConst r (2 * M₁ * K_c)
      let M_K1 := (2 : ℝ) ^ r * (M₁ * K_c) * M_E
      let M_K2 := (2 : ℝ) ^ r * (M₁ * K_c + (2 : ℝ) ^ r * (M₁ * K_c) * (M₁ * K_c)) * M_E
      rmdJetBnd r (C_r / (q : ℝ) ^ 2) d_fn →
      rmdJetBnd r M_E (fun y => Real.exp (w (M₀_fn y) - w (M₀_fn y + d_fn y))) ∧
      rmdJetBnd r M_K1 (fun y => rmdKlin w (M₀_fn y) (d_fn y)) ∧
      rmdJetBnd r M_K1 (fun y => rmdK1 w (M₀_fn y) (h_fn y)) ∧
      rmdJetBnd r M_K2 (fun y => rmdK2 w (M₀_fn y) (h_fn y)) := by
    intro r C_r q ρ c_T u_param w e_X τ_T hr hCr hq hc_T hu hw he_X hτ_T
      X T h_fn M₀_fn d_fn B_r K_c M_E M_K1 M_K2 hd_r
    obtain ⟨hM₀_d, _, _, hh_d, _⟩ := h_M₀_h_jets q ρ c_T u_param e_X τ_T hq hc_T hu he_X hτ_T
    have hq_ge4 : (4 : ℝ) ≤ (q : ℝ) := by exact_mod_cast hq
    have hq2_ge16 : (16 : ℝ) ≤ (q : ℝ) ^ 2 := by nlinarith
    have hh_d1 : rmdDerivBnd r 1 h_fn := by
      have h8q_le1 : 1 / (8 * (q : ℝ)) ≤ 1 := by
        rw [div_le_one (by positivity)]; linarith
      exact h_deriv_mono (by omega) h8q_le1 hh_d
    have hd_d_sub : rmdDerivBnd r (C_r / 16) d_fn := by
      have h_le : C_r / (q : ℝ) ^ 2 ≤ C_r / 16 :=
        div_le_div_of_nonneg_left (le_of_lt hCr) (by norm_num) hq2_ge16
      exact h_deriv_mono le_rfl h_le (h_deriv_of_jet hd_r)
    have hM₀_B : rmdDerivBnd r B_r M₀_fn :=
      h_deriv_mono (by omega) (by dsimp [B_r]; linarith) hM₀_d
    have hM₀_sd_B : ∀ s ∈ Set.Icc (0 : ℝ) 1, rmdDerivBnd r B_r (fun y => M₀_fn y + s * d_fn y) := by
      intro s hs
      have hs_abs : |s| ≤ 1 := by rw [abs_of_nonneg hs.1]; exact hs.2
      have hsd := h_deriv_const_mul s hd_d_sub
      have hsum := h_deriv_add (h_deriv_mono (by omega) le_rfl hM₀_d) hsd
      exact h_deriv_mono le_rfl (by dsimp [B_r]; nlinarith) hsum
    have hM₀_sh_B : ∀ s ∈ Set.Icc (0 : ℝ) 1,
        rmdDerivBnd r B_r (fun y => M₀_fn y + s * h_fn y) ∧
        rmdDerivBnd r B_r (fun y => M₀_fn y - s * h_fn y) := by
      intro s hs
      have hs_abs : |s| ≤ 1 := by rw [abs_of_nonneg hs.1]; exact hs.2
      refine ⟨?_, ?_⟩
      · have hsh := h_deriv_const_mul s hh_d1
        have hsum := h_deriv_add (h_deriv_mono (by omega) le_rfl hM₀_d) hsh
        exact h_deriv_mono le_rfl (by dsimp [B_r]; nlinarith) hsum
      · have hEq : (fun y => M₀_fn y - s * h_fn y) = fun y => M₀_fn y + (-s) * h_fn y := by
          funext y; ring
        rw [hEq]
        have hsh := h_deriv_const_mul (-s) hh_d1
        have hsum := h_deriv_add (h_deriv_mono (by omega) le_rfl hM₀_d) hsh
        rw [abs_neg] at hsum
        exact h_deriv_mono le_rfl (by dsimp [B_r]; nlinarith) hsum
    have hw0_cd : ContDiff ℝ (r : WithTop ℕ∞) w := hw.2.1.of_le (by norm_cast; omega)
    have hw1_cd : ContDiff ℝ (r : WithTop ℕ∞) (deriv w) := by
      simpa [iteratedDeriv_one] using
        h_contDiff_iter 1 r w (hw.2.1.of_le (by norm_cast; omega))
    have hw2_cd : ContDiff ℝ (r : WithTop ℕ∞) (iteratedDeriv 2 w) :=
      h_contDiff_iter 2 r w (hw.2.1.of_le (by norm_cast; omega))
    have hM₀_2d : ContDiff ℝ (r : WithTop ℕ∞) (fun p : ℝ × ℝ => M₀_fn p.2) :=
      (hM₀_B.1).comp contDiff_snd
    have hh_2d : ContDiff ℝ (r : WithTop ℕ∞) (fun p : ℝ × ℝ => h_fn p.2) :=
      (hh_d1.1).comp contDiff_snd
    have hd_2d : ContDiff ℝ (r : WithTop ℕ∞) (fun p : ℝ × ℝ => d_fn p.2) :=
      (hd_r.1).comp contDiff_snd
    have hKc_pos : 0 ≤ K_c := le_trans zero_le_one (h_compConst_ge_one r B_r)
    have hME_pos : 0 ≤ M_E :=
      mul_nonneg (le_of_lt (Real.exp_pos _))
        (le_trans zero_le_one (h_compConst_ge_one r (2 * M₁ * K_c)))
    have hEd : rmdJetBnd r M_E (fun y => Real.exp (w (M₀_fn y) - w (M₀_fn y + d_fn y))) := by
      have hd1 : rmdDerivBnd r B_r (fun y => M₀_fn y + d_fn y) := by
        simpa using hM₀_sd_B 1 ⟨zero_le_one, le_rfl⟩
      exact h_exp_w_single hr hw hM₀_B hd1
    have hKlin : rmdJetBnd r M_K1 (fun y => rmdKlin w (M₀_fn y) (d_fn y)) := by
      let G_lin : ℝ × ℝ → ℝ := fun p =>
        deriv w (M₀_fn p.2 + p.1 * d_fn p.2) *
          Real.exp (w (M₀_fn p.2) - w (M₀_fn p.2 + p.1 * d_fn p.2))
      have hG_cd : ContDiff ℝ (r : WithTop ℕ∞) G_lin :=
        (hw1_cd.comp (hM₀_2d.add (contDiff_fst.mul hd_2d))).mul
          ((hw0_cd.comp hM₀_2d).sub (hw0_cd.comp (hM₀_2d.add (contDiff_fst.mul hd_2d)))).exp
      have hGs : ∀ s ∈ Set.Icc (0 : ℝ) 1, rmdJetBnd r M_K1 (fun y => G_lin (s, y)) := by
        intro s hs
        have h_dw : rmdJetBnd r (M₁ * K_c) (fun y => deriv w (M₀_fn y + s * d_fn y)) := by
          simpa [iteratedDeriv_one] using h_w_single hr (by omega : 1 ≤ 2) hw (hM₀_sd_B s hs)
        have h_ex := h_exp_w_single hr hw hM₀_B (hM₀_sd_B s hs)
        exact h_jet_mul h_dw h_ex
      have h_int := h_jet_unit_int hG_cd (by dsimp [M_K1]; positivity) hGs
      have hEq : (fun y => rmdKlin w (M₀_fn y) (d_fn y)) =
          fun y => (-1 : ℝ) * ∫ s in (0 : ℝ)..1, G_lin (s, y) := by
        funext y; dsimp [rmdKlin, G_lin]; ring
      rw [hEq]
      exact h_jet_mono le_rfl (by simp) (h_jet_const_mul (-1 : ℝ) h_int)
    have hK1 : rmdJetBnd r M_K1 (fun y => rmdK1 w (M₀_fn y) (h_fn y)) := by
      let G_k1 : ℝ × ℝ → ℝ := fun p =>
        deriv w (M₀_fn p.2 + p.1 * h_fn p.2) *
          Real.exp (w (M₀_fn p.2 + p.1 * h_fn p.2) - w (M₀_fn p.2)) +
        deriv w (M₀_fn p.2 - p.1 * h_fn p.2) *
          Real.exp (w (M₀_fn p.2 - p.1 * h_fn p.2) - w (M₀_fn p.2))
      have hG_cd : ContDiff ℝ (r : WithTop ℕ∞) G_k1 :=
        ((hw1_cd.comp (hM₀_2d.add (contDiff_fst.mul hh_2d))).mul
          ((hw0_cd.comp (hM₀_2d.add (contDiff_fst.mul hh_2d))).sub (hw0_cd.comp hM₀_2d)).exp).add
        ((hw1_cd.comp (hM₀_2d.sub (contDiff_fst.mul hh_2d))).mul
          ((hw0_cd.comp (hM₀_2d.sub (contDiff_fst.mul hh_2d))).sub (hw0_cd.comp hM₀_2d)).exp)
      have hGs : ∀ s ∈ Set.Icc (0 : ℝ) 1, rmdJetBnd r (2 * M_K1) (fun y => G_k1 (s, y)) := by
        intro s hs
        obtain ⟨hsh_p, hsh_m⟩ := hM₀_sh_B s hs
        have h_p := h_jet_mul
          (by simpa [iteratedDeriv_one] using h_w_single hr (by omega : 1 ≤ 2) hw hsh_p)
          (h_exp_w_single hr hw hsh_p hM₀_B)
        have h_m := h_jet_mul
          (by simpa [iteratedDeriv_one] using h_w_single hr (by omega : 1 ≤ 2) hw hsh_m)
          (h_exp_w_single hr hw hsh_m hM₀_B)
        exact h_jet_mono le_rfl (by dsimp [M_K1]; linarith) (h_jet_add h_p h_m)
      have h_int := h_jet_unit_int hG_cd (by dsimp [M_K1]; positivity) hGs
      exact h_jet_mono le_rfl (by norm_num; linarith) (h_jet_const_mul (1 / 2 : ℝ) h_int)
    have hK2 : rmdJetBnd r M_K2 (fun y => rmdK2 w (M₀_fn y) (h_fn y)) := by
      let G_k2 : ℝ × ℝ → ℝ := fun p => (1 - p.1) *
        (((iteratedDeriv 2 w (M₀_fn p.2 + p.1 * h_fn p.2) +
            (deriv w (M₀_fn p.2 + p.1 * h_fn p.2)) ^ 2) *
           Real.exp (w (M₀_fn p.2 + p.1 * h_fn p.2) - w (M₀_fn p.2))) +
         ((iteratedDeriv 2 w (M₀_fn p.2 - p.1 * h_fn p.2) +
            (deriv w (M₀_fn p.2 - p.1 * h_fn p.2)) ^ 2) *
           Real.exp (w (M₀_fn p.2 - p.1 * h_fn p.2) - w (M₀_fn p.2))))
      have h_branch_cd : ∀ (Y_2d : ℝ × ℝ → ℝ), ContDiff ℝ (r : WithTop ℕ∞) Y_2d →
          ContDiff ℝ (r : WithTop ℕ∞) (fun p : ℝ × ℝ =>
            (iteratedDeriv 2 w (Y_2d p) + (deriv w (Y_2d p)) ^ 2) *
              Real.exp (w (Y_2d p) - w (M₀_fn p.2))) := by
        intro Y_2d hY
        exact ((hw2_cd.comp hY).add ((hw1_cd.comp hY).pow 2)).mul
          ((hw0_cd.comp hY).sub (hw0_cd.comp hM₀_2d)).exp
      have hG_cd : ContDiff ℝ (r : WithTop ℕ∞) G_k2 :=
        (contDiff_const.sub contDiff_fst).mul
          ((h_branch_cd _ (hM₀_2d.add (contDiff_fst.mul hh_2d))).add
            (h_branch_cd _ (hM₀_2d.sub (contDiff_fst.mul hh_2d))))
      have hGs : ∀ s ∈ Set.Icc (0 : ℝ) 1, rmdJetBnd r (2 * M_K2) (fun y => G_k2 (s, y)) := by
        intro s hs
        obtain ⟨hsh_p, hsh_m⟩ := hM₀_sh_B s hs
        have h_br : ∀ {Y : ℝ → ℝ}, rmdDerivBnd r B_r Y →
            rmdJetBnd r M_K2 (fun y =>
              (iteratedDeriv 2 w (Y y) + (deriv w (Y y)) ^ 2) * Real.exp (w (Y y) - w (M₀_fn y))) := by
          intro Y hY
          have hw2Y := h_w_single hr (le_rfl : 2 ≤ 2) hw hY
          have hw1Y : rmdJetBnd r (M₁ * K_c) (fun y => deriv w (Y y)) := by
            simpa [iteratedDeriv_one] using h_w_single hr (by omega : 1 ≤ 2) hw hY
          have hw1_sq : rmdJetBnd r ((2 : ℝ) ^ r * (M₁ * K_c) * (M₁ * K_c))
              (fun y => (deriv w (Y y)) ^ 2) := by
            have hsq_eq : (fun y => (deriv w (Y y)) ^ 2) = fun y => deriv w (Y y) * deriv w (Y y) := by
              funext y; ring
            rw [hsq_eq]; exact h_jet_mul hw1Y hw1Y
          exact h_jet_mul (h_jet_add hw2Y hw1_sq) (h_exp_w_single hr hw hY hM₀_B)
        have hsum := h_jet_add (h_br hsh_p) (h_br hsh_m)
        have h1s : |1 - s| ≤ 1 := by
          rw [abs_of_nonneg (by linarith [hs.2])]; linarith [hs.1]
        have hM_K2_nonneg : 0 ≤ M_K2 := by dsimp [M_K2]; positivity
        exact h_jet_mono le_rfl (by nlinarith) (h_jet_const_mul (1 - s) hsum)
      have h_int := h_jet_unit_int hG_cd (by dsimp [M_K2]; positivity) hGs
      exact h_jet_mono le_rfl (by norm_num; linarith) (h_jet_const_mul (1 / 2 : ℝ) h_int)
    exact ⟨hEd, hKlin, hK1, hK2⟩

  have h_single_seq_pos : ∀ r : ℕ, 0 < rmdSingleSeq M₁ C₀_mid r := by
    intro r
    induction r with
    | zero => exact hC₀_pos
    | succ r ih => exact lt_of_lt_of_le ih (le_max_left _ _)

  have h_single_ind : ∀ (r : ℕ), r ≤ m + 2 →
      ∀ (q : ℕ) (ρ c_T u_param : ℝ) (w e_X τ_T : ℝ → ℝ),
        4 ≤ q → |c_T| ≤ 2 * Real.pi / (q : ℝ) → u_param ∈ Set.Icc (0 : ℝ) 1 →
        IsPeriodicSmoothBounded (m + 15) M₁ w →
        IsRealJetPerturb (m + 2) ((4 * (q : ℝ))⁻¹) e_X →
        IsRealJetPerturb (m + 2) ((4 * (q : ℝ))⁻¹) τ_T →
        rmdJetBnd r (rmdSingleSeq M₁ C₀_mid r / (q : ℝ) ^ 2)
          (realMidpointDispU w (fun y => y + ρ + e_X y) (fun y => c_T + τ_T y) u_param) := by
    intro r
    induction r with
    | zero =>
      intro _ q ρ c_T u_param w e_X τ_T hq hc_T hu hw he_X hτ_T
      have hq2_pos : (0 : ℝ) < (q : ℝ) ^ 2 := by
        have : (0 : ℝ) < (q : ℝ) := by exact_mod_cast (by omega : 0 < q)
        positivity
      obtain ⟨hJoint, _, _⟩ := h_qual_and_ode q ρ c_T w e_X τ_T hw he_X hτ_T
      have hd_cd : ContDiff ℝ (0 : WithTop ℕ∞)
          (realMidpointDispU w (fun y => y + ρ + e_X y) (fun y => c_T + τ_T y) u_param) :=
        (hJoint.comp (contDiff_const.prodMk contDiff_id)).of_le (by norm_cast)
      refine ⟨hd_cd, by simp [rmdSingleSeq]; positivity, ?_⟩
      intro j hj x
      have hj0 : j = 0 := Nat.eq_zero_of_le_zero hj
      subst hj0
      simp only [iteratedDeriv_zero, rmdSingleSeq]
      exact (le_div_iff₀' hq2_pos).mpr
        (h_c0_single q ρ c_T u_param w e_X τ_T hq hc_T hu hw he_X hτ_T x)
    | succ r ih =>
      intro hr1 q ρ c_T u_param w e_X τ_T hq hc_T hu hw he_X hτ_T
      have hr : r ≤ m + 1 := by omega
      have hq2_pos : (0 : ℝ) < (q : ℝ) ^ 2 := by
        have : (0 : ℝ) < (q : ℝ) := by exact_mod_cast (by omega : 0 < q)
        positivity
      set X : ℝ → ℝ := fun y => y + ρ + e_X y
      set T : ℝ → ℝ := fun y => c_T + τ_T y
      set h_fn : ℝ → ℝ := fun y => u_param * T y / 2
      set M₀_fn : ℝ → ℝ := fun y => X y + u_param * T y / 2
      set d_fn : ℝ → ℝ := realMidpointDispU w X T u_param
      set C_r := rmdSingleSeq M₁ C₀_mid r
      have hCr_pos : 0 < C_r := h_single_seq_pos r
      have hd_r : rmdJetBnd r (C_r / (q : ℝ) ^ 2) d_fn :=
        ih (by omega) q ρ c_T u_param w e_X τ_T hq hc_T hu hw he_X hτ_T
      obtain ⟨hJoint, _, hOde⟩ := h_qual_and_ode q ρ c_T w e_X τ_T hw he_X hτ_T
      have hd_cd : ContDiff ℝ ((r + 1 : ℕ) : WithTop ℕ∞) d_fn :=
        (hJoint.comp (contDiff_const.prodMk contDiff_id)).of_le (by norm_cast)
      obtain ⟨hEd, hKlin, hK1, hK2⟩ :=
        h_single_kernels r C_r q ρ c_T u_param w e_X τ_T hr hCr_pos hq hc_T hu hw he_X hτ_T hd_r
      obtain ⟨_, hM₀'_m1, hh_m2, _, hh'_m1⟩ :=
        h_M₀_h_jets q ρ c_T u_param e_X τ_T hq hc_T hu he_X hτ_T
      have hM₀'_r : rmdJetBnd r 2 (deriv M₀_fn) := h_jet_mono hr le_rfl hM₀'_m1
      have hh_r : rmdJetBnd r (9 / (2 * (q : ℝ))) h_fn := h_jet_mono (by omega) le_rfl hh_m2
      have hh'_r : rmdJetBnd r (1 / (8 * (q : ℝ))) (deriv h_fn) := h_jet_mono hr le_rfl hh'_m1
      have hh2_r : rmdJetBnd r (21 * (2 : ℝ) ^ r / (q : ℝ) ^ 2) (fun y => h_fn y ^ 2) := by
        have hsq_eq : (fun y => h_fn y ^ 2) = fun y => h_fn y * h_fn y := by funext y; ring
        rw [hsq_eq]
        have hm := h_jet_mul hh_r hh_r
        have hle : (2 : ℝ) ^ r * (9 / (2 * (q : ℝ))) * (9 / (2 * (q : ℝ))) ≤
            21 * (2 : ℝ) ^ r / (q : ℝ) ^ 2 := by
          have : (2 : ℝ) ^ r * (9 / (2 * (q : ℝ))) * (9 / (2 * (q : ℝ))) =
              ((81 / 4 : ℝ) * (2 : ℝ) ^ r) / (q : ℝ) ^ 2 := by ring
          rw [this]
          apply div_le_div_of_nonneg_right _ (sq_nonneg _)
          have hp : (0 : ℝ) ≤ (2 : ℝ) ^ r := by positivity
          linarith
        exact h_jet_mono le_rfl hle hm
      have hhh'_r : rmdJetBnd r ((2 : ℝ) ^ r / (q : ℝ) ^ 2) (fun y => h_fn y * deriv h_fn y) := by
        have hm := h_jet_mul hh_r hh'_r
        have hle : (2 : ℝ) ^ r * (9 / (2 * (q : ℝ))) * (1 / (8 * (q : ℝ))) ≤
            (2 : ℝ) ^ r / (q : ℝ) ^ 2 := by
          have : (2 : ℝ) ^ r * (9 / (2 * (q : ℝ))) * (1 / (8 * (q : ℝ))) =
              ((9 / 16 : ℝ) * (2 : ℝ) ^ r) / (q : ℝ) ^ 2 := by ring
          rw [this]
          apply div_le_div_of_nonneg_right _ (sq_nonneg _)
          have hp : (0 : ℝ) ≤ (2 : ℝ) ^ r := by positivity
          linarith
        exact h_jet_mono le_rfl hle hm
      have h_EdK2 := h_jet_mul hEd hK2
      have h_EdK1 := h_jet_mul hEd hK1
      have h_term1a := h_jet_mul hh2_r h_EdK2
      have h_term1b := h_jet_mul hd_r hKlin
      have h_term1 := h_jet_mul (h_jet_add h_term1a h_term1b) hM₀'_r
      have h_term2 := h_jet_mul hhh'_r h_EdK1
      have h_rhs := h_jet_add h_term1 h_term2
      have h_deriv_eq : deriv d_fn = fun y =>
          rmdOdeRhs w (M₀_fn y) (h_fn y) (d_fn y) (deriv M₀_fn y) (deriv h_fn y) :=
        funext (hOde u_param)
      have hC1_pos : 0 < rmdSingleSeq M₁ C₀_mid (r + 1) := h_single_seq_pos (r + 1)
      refine ⟨hd_cd, by positivity, ?_⟩
      intro j hj x
      by_cases hj_le : j ≤ r
      · have h1 := hd_r.2.2 j hj_le x
        have h_mono : C_r / (q : ℝ) ^ 2 ≤ rmdSingleSeq M₁ C₀_mid (r + 1) / (q : ℝ) ^ 2 :=
          div_le_div_of_nonneg_right (le_max_left _ _) (sq_nonneg _)
        exact le_trans h1 h_mono
      · have hj_eq : j = r + 1 := by omega
        subst hj_eq
        rw [iteratedDeriv_succ', h_deriv_eq]
        have hb := h_rhs.2.2 r le_rfl x
        let B_r := 3 + C_r / 16
        let K_c := rmdCompConst r B_r
        let M_E := Real.exp (2 * M₁) * rmdCompConst r (2 * M₁ * K_c)
        let M_K1 := (2 : ℝ) ^ r * (M₁ * K_c) * M_E
        let M_K2 := (2 : ℝ) ^ r * (M₁ * K_c + (2 : ℝ) ^ r * (M₁ * K_c) * (M₁ * K_c)) * M_E
        let M_EdK2 := (2 : ℝ) ^ r * M_E * M_K2
        let M_EdK1 := (2 : ℝ) ^ r * M_E * M_K1
        let C_step :=
          (2 : ℝ) ^ r *
            ((2 : ℝ) ^ r * (21 * (2 : ℝ) ^ r) * M_EdK2 + (2 : ℝ) ^ r * C_r * M_K1) * 2 +
          (2 : ℝ) ^ r * (2 : ℝ) ^ r * M_EdK1
        have h_bnd_eq :
            (2 : ℝ) ^ r *
              ((2 : ℝ) ^ r * (21 * (2 : ℝ) ^ r / (q : ℝ) ^ 2) * M_EdK2 +
                (2 : ℝ) ^ r * (C_r / (q : ℝ) ^ 2) * M_K1) * 2 +
              (2 : ℝ) ^ r * ((2 : ℝ) ^ r / (q : ℝ) ^ 2) * M_EdK1 =
            C_step / (q : ℝ) ^ 2 := by
          dsimp [C_step]; ring
        have h_step_le : C_step / (q : ℝ) ^ 2 ≤ rmdSingleSeq M₁ C₀_mid (r + 1) / (q : ℝ) ^ 2 := by
          simp only [rmdSingleSeq]
          exact div_le_div_of_nonneg_right (le_max_right C_r C_step) (sq_nonneg _)
        exact le_trans hb (h_bnd_eq.le.trans h_step_le)

  let C_single : ℝ := rmdSingleSeq M₁ C₀_mid (m + 2)
  have hC_single_pos : 0 < C_single := h_single_seq_pos (m + 2)

  have h_jet_unit_int_sub : ∀ {k : ℕ} {M : ℝ} {G₁ G₂ : ℝ × ℝ → ℝ},
      ContDiff ℝ (k : WithTop ℕ∞) G₁ →
      ContDiff ℝ (k : WithTop ℕ∞) G₂ →
      0 ≤ M →
      (∀ s ∈ Set.Icc (0 : ℝ) 1, rmdJetBnd k M (fun x => G₁ (s, x) - G₂ (s, x))) →
      rmdJetBnd k M
        (fun x : ℝ => (∫ s in (0 : ℝ)..1, G₁ (s, x)) - (∫ s in (0 : ℝ)..1, G₂ (s, x))) := by
    intro k M G₁ G₂ hG₁ hG₂ hM hGs
    have hEq : (fun x : ℝ => (∫ s in (0 : ℝ)..1, G₁ (s, x)) - (∫ s in (0 : ℝ)..1, G₂ (s, x))) =
        (fun x : ℝ => ∫ s in (0 : ℝ)..1, (G₁ (s, x) - G₂ (s, x))) := by
      funext x
      exact (intervalIntegral.integral_sub
        ((hG₁.continuous.comp (continuous_id.prodMk continuous_const)).intervalIntegrable 0 1)
        ((hG₂.continuous.comp (continuous_id.prodMk continuous_const)).intervalIntegrable 0 1)).symm
    rw [hEq]
    exact h_jet_unit_int (hG₁.sub hG₂) hM hGs

  have h_w_diff : ∀ {r d_obs : ℕ} {B_Y κ Λ : ℝ} {w₁ w₂ Y₁ Y₂ : ℝ → ℝ},
      r ≤ m + 1 → d_obs ≤ 2 → 0 ≤ Λ →
      IsPeriodicSmoothBounded (m + 15) M₁ w₁ →
      IsPeriodicSmoothBounded (m + 15) M₁ w₂ →
      realDiffSup (m + 15) w₁ w₂ ≤ Λ →
      rmdDerivBnd r B_Y Y₁ →
      rmdDerivBnd r B_Y Y₂ →
      rmdJetBnd r (κ * Λ) (fun y => Y₁ y - Y₂ y) →
      rmdJetBnd r (((2 : ℝ) ^ r * M₁ * rmdCompConst r B_Y * κ + rmdCompConst r B_Y) * Λ)
        (fun y => iteratedDeriv d_obs w₁ (Y₁ y) - iteratedDeriv d_obs w₂ (Y₂ y)) := by
    intro r d_obs B_Y κ Λ w₁ w₂ Y₁ Y₂ hr hd_obs hΛ hw₁ hw₂ hΔw_le hY₁ hY₂ hdY
    have hg₁_cd : ContDiff ℝ ((r + 1 : ℕ) : WithTop ℕ∞) (iteratedDeriv d_obs w₁) :=
      h_contDiff_iter d_obs (r + 1) w₁ (hw₁.2.1.of_le (by norm_cast; omega))
    have hg₁_bnd : ∀ j : ℕ, j ≤ r → ∀ z ∈ (Set.univ : Set ℝ),
        |iteratedDeriv (j + 1) (iteratedDeriv d_obs w₁) z| ≤ M₁ := by
      intro j hj z _
      rw [h_iter_add d_obs (j + 1) w₁]
      exact hw₁.2.2 (j + 1 + d_obs) (by omega) z
    have h_term1 := h_jet_comp_diff_on r Set.univ M₁ B_Y (κ * Λ)
      (iteratedDeriv d_obs w₁) Y₁ Y₂ convex_univ hg₁_cd (le_of_lt hM₁) hg₁_bnd
      hY₁ hY₂ (fun _ => ⟨trivial, trivial⟩) hdY
    let w_sub : ℝ → ℝ := fun z => w₁ z - w₂ z
    have hw_sub_cd : ContDiff ℝ ((m + 15 : ℕ) : WithTop ℕ∞) w_sub := hw₁.2.1.sub hw₂.2.1
    have hg_diff_cd : ContDiff ℝ (r : WithTop ℕ∞) (iteratedDeriv d_obs w_sub) :=
      h_contDiff_iter d_obs r w_sub (hw_sub_cd.of_le (by norm_cast; omega))
    have hg_diff_bnd : ∀ j : ℕ, j ≤ r → ∀ z ∈ (Set.univ : Set ℝ),
        |iteratedDeriv j (iteratedDeriv d_obs w_sub) z| ≤ Λ := by
      intro j hj z _
      rw [h_iter_add d_obs j w_sub]
      exact le_trans ((H_base.diff_global_bound w₁ w₂ hw₁ hw₂).2 (j + d_obs) (by omega) z) hΔw_le
    have h_term2_raw := h_jet_comp_on r Set.univ Λ B_Y (iteratedDeriv d_obs w_sub) Y₂
      hg_diff_cd hΛ hg_diff_bnd hY₂ (fun _ => trivial)
    have h_sub_eq : (fun y => iteratedDeriv d_obs w₁ (Y₂ y) - iteratedDeriv d_obs w₂ (Y₂ y)) =
        (fun y => iteratedDeriv d_obs w_sub (Y₂ y)) := by
      funext y
      exact (iteratedDeriv_fun_sub
        ((hw₁.2.1.of_le (by norm_cast; omega)).contDiffAt)
        ((hw₂.2.1.of_le (by norm_cast; omega)).contDiffAt)).symm
    have h_split : (fun y => iteratedDeriv d_obs w₁ (Y₁ y) - iteratedDeriv d_obs w₂ (Y₂ y)) =
        (fun y => (iteratedDeriv d_obs w₁ (Y₁ y) - iteratedDeriv d_obs w₁ (Y₂ y)) +
          iteratedDeriv d_obs w_sub (Y₂ y)) := by
      funext y
      rw [← congrFun h_sub_eq y]; ring
    rw [h_split]
    exact h_jet_mono le_rfl (by linarith) (h_jet_add h_term1 h_term2_raw)

  have h_exp_w_diff : ∀ {r : ℕ} {B_Y κ Λ : ℝ} {w₁ w₂ A₁ B₁ A₂ B₂ : ℝ → ℝ},
      r ≤ m + 1 → 0 ≤ Λ →
      IsPeriodicSmoothBounded (m + 15) M₁ w₁ →
      IsPeriodicSmoothBounded (m + 15) M₁ w₂ →
      realDiffSup (m + 15) w₁ w₂ ≤ Λ →
      rmdDerivBnd r B_Y A₁ → rmdDerivBnd r B_Y B₁ →
      rmdDerivBnd r B_Y A₂ → rmdDerivBnd r B_Y B₂ →
      rmdJetBnd r (κ * Λ) (fun y => A₁ y - A₂ y) →
      rmdJetBnd r (κ * Λ) (fun y => B₁ y - B₂ y) →
      let K_c := rmdCompConst r B_Y
      let D_w := (2 : ℝ) ^ r * M₁ * K_c * κ + K_c
      rmdJetBnd r
        (((2 : ℝ) ^ r * Real.exp (2 * M₁) * rmdCompConst r (2 * M₁ * K_c) * (2 * D_w)) * Λ)
        (fun y => Real.exp (w₁ (A₁ y) - w₁ (B₁ y)) - Real.exp (w₂ (A₂ y) - w₂ (B₂ y))) := by
    intro r B_Y κ Λ w₁ w₂ A₁ B₁ A₂ B₂ hr hΛ hw₁ hw₂ hΔw_le hA₁ hB₁ hA₂ hB₂ hdA hdB K_c D_w
    let U₁ : ℝ → ℝ := fun y => w₁ (A₁ y) - w₁ (B₁ y)
    let U₂ : ℝ → ℝ := fun y => w₂ (A₂ y) - w₂ (B₂ y)
    have hU₁ : rmdDerivBnd r (2 * M₁ * K_c) U₁ := by
      have ha : rmdJetBnd r (M₁ * K_c) (fun y => w₁ (A₁ y)) := by
        simpa [iteratedDeriv_zero] using h_w_single hr (by omega : 0 ≤ 2) hw₁ hA₁
      have hb : rmdJetBnd r (M₁ * K_c) (fun y => w₁ (B₁ y)) := by
        simpa [iteratedDeriv_zero] using h_w_single hr (by omega : 0 ≤ 2) hw₁ hB₁
      exact h_deriv_of_jet (h_jet_mono le_rfl (by linarith) (h_jet_sub ha hb))
    have hU₂ : rmdDerivBnd r (2 * M₁ * K_c) U₂ := by
      have ha : rmdJetBnd r (M₁ * K_c) (fun y => w₂ (A₂ y)) := by
        simpa [iteratedDeriv_zero] using h_w_single hr (by omega : 0 ≤ 2) hw₂ hA₂
      have hb : rmdJetBnd r (M₁ * K_c) (fun y => w₂ (B₂ y)) := by
        simpa [iteratedDeriv_zero] using h_w_single hr (by omega : 0 ≤ 2) hw₂ hB₂
      exact h_deriv_of_jet (h_jet_mono le_rfl (by linarith) (h_jet_sub ha hb))
    have hU_mem : ∀ y : ℝ, U₁ y ∈ Set.Icc (-2 * M₁) (2 * M₁) ∧
        U₂ y ∈ Set.Icc (-2 * M₁) (2 * M₁) := by
      intro y
      have h1a : |w₁ (A₁ y)| ≤ M₁ := by simpa [iteratedDeriv_zero] using hw₁.2.2 0 (by omega) (A₁ y)
      have h1b : |w₁ (B₁ y)| ≤ M₁ := by simpa [iteratedDeriv_zero] using hw₁.2.2 0 (by omega) (B₁ y)
      have h2a : |w₂ (A₂ y)| ≤ M₁ := by simpa [iteratedDeriv_zero] using hw₂.2.2 0 (by omega) (A₂ y)
      have h2b : |w₂ (B₂ y)| ≤ M₁ := by simpa [iteratedDeriv_zero] using hw₂.2.2 0 (by omega) (B₂ y)
      rw [abs_le] at h1a h1b h2a h2b
      exact ⟨⟨by linarith, by linarith⟩, ⟨by linarith, by linarith⟩⟩
    have hdU : rmdJetBnd r ((2 * D_w) * Λ) (fun y => U₁ y - U₂ y) := by
      have hdA_w : rmdJetBnd r (D_w * Λ) (fun y => w₁ (A₁ y) - w₂ (A₂ y)) := by
        simpa [iteratedDeriv_zero] using
          h_w_diff hr (by omega : 0 ≤ 2) hΛ hw₁ hw₂ hΔw_le hA₁ hA₂ hdA
      have hdB_w : rmdJetBnd r (D_w * Λ) (fun y => w₁ (B₁ y) - w₂ (B₂ y)) := by
        simpa [iteratedDeriv_zero] using
          h_w_diff hr (by omega : 0 ≤ 2) hΛ hw₁ hw₂ hΔw_le hB₁ hB₂ hdB
      have hEq : (fun y => U₁ y - U₂ y) =
          fun y => (w₁ (A₁ y) - w₂ (A₂ y)) - (w₁ (B₁ y) - w₂ (B₂ y)) := by
        funext y; dsimp [U₁, U₂]; ring
      rw [hEq]
      exact h_jet_mono le_rfl (by linarith) (h_jet_sub hdA_w hdB_w)
    have hexp_bnd : ∀ j : ℕ, j ≤ r → ∀ z ∈ Set.Icc (-2 * M₁) (2 * M₁),
        |iteratedDeriv (j + 1) Real.exp z| ≤ Real.exp (2 * M₁) := by
      intro j _ z hz
      rw [h_iter_exp (j + 1), abs_of_pos (Real.exp_pos z)]
      exact Real.exp_le_exp.mpr hz.2
    have hres := h_jet_comp_diff_on r (Set.Icc (-2 * M₁) (2 * M₁)) (Real.exp (2 * M₁))
      (2 * M₁ * K_c) ((2 * D_w) * Λ) Real.exp U₁ U₂ (convex_Icc _ _)
      Real.contDiff_exp (le_of_lt (Real.exp_pos _)) hexp_bnd hU₁ hU₂ hU_mem hdU
    exact h_jet_mono le_rfl (by linarith) hres

  have h_lip_seq_pos : ∀ r : ℕ, 0 < rmdLipSeq M₁ C_single L₀_mid r := by
    intro r
    induction r with
    | zero => exact hL₀_pos
    | succ r ih => exact lt_of_lt_of_le ih (le_max_left _ _)

  have h_lip_ind : ∀ (r : ℕ), r ≤ m + 2 →
      ∀ (q : ℕ) (ρ c_T Δe Δτ u_param : ℝ) (w₁ w₂ : ℝ → ℝ)
        (e_X₁ τ_T₁ e_X₂ τ_T₂ : ℝ → ℝ),
        4 ≤ q → |c_T| ≤ 2 * Real.pi / (q : ℝ) → u_param ∈ Set.Icc (0 : ℝ) 1 →
        0 ≤ Δe → 0 ≤ Δτ →
        IsPeriodicSmoothBounded (m + 15) M₁ w₁ →
        IsPeriodicSmoothBounded (m + 15) M₁ w₂ →
        IsRealJetPerturb (m + 2) ((4 * (q : ℝ))⁻¹) e_X₁ →
        IsRealJetPerturb (m + 2) ((4 * (q : ℝ))⁻¹) τ_T₁ →
        IsRealJetPerturb (m + 2) ((4 * (q : ℝ))⁻¹) e_X₂ →
        IsRealJetPerturb (m + 2) ((4 * (q : ℝ))⁻¹) τ_T₂ →
        (∀ k : ℕ, k ≤ m + 2 → ∀ y : ℝ, |iteratedDeriv k (fun z => e_X₁ z - e_X₂ z) y| ≤ Δe) →
        (∀ k : ℕ, k ≤ m + 2 → ∀ y : ℝ, |iteratedDeriv k (fun z => τ_T₁ z - τ_T₂ z) y| ≤ Δτ) →
        let X₁ : ℝ → ℝ := fun y => y + ρ + e_X₁ y
        let T₁ : ℝ → ℝ := fun y => c_T + τ_T₁ y
        let X₂ : ℝ → ℝ := fun y => y + ρ + e_X₂ y
        let T₂ : ℝ → ℝ := fun y => c_T + τ_T₂ y
        let Λ := Δe + (q : ℝ) * Δτ + realDiffSup (m + 15) w₁ w₂
        rmdJetBnd r (rmdLipSeq M₁ C_single L₀_mid r * Λ / (q : ℝ) ^ 2)
          (fun y => realMidpointDispU w₁ X₁ T₁ u_param y -
            realMidpointDispU w₂ X₂ T₂ u_param y) := by
    intro r
    induction r with
    | zero =>
      intro _ q ρ c_T Δe Δτ u_param w₁ w₂ e_X₁ τ_T₁ e_X₂ τ_T₂
        hq hc_T hu hΔe hΔτ hw₁ hw₂ he_X₁ hτ_T₁ he_X₂ hτ_T₂ hde hdτ X₁ T₁ X₂ T₂ Λ
      have hq2_pos : (0 : ℝ) < (q : ℝ) ^ 2 := by
        have : (0 : ℝ) < (q : ℝ) := by exact_mod_cast (by omega : 0 < q)
        positivity
      have hDw_nonneg := (H_base.diff_global_bound w₁ w₂ hw₁ hw₂).1
      have hΛ_nonneg : 0 ≤ Λ := by dsimp [Λ]; positivity
      obtain ⟨hJoint₁, _, _⟩ := h_qual_and_ode q ρ c_T w₁ e_X₁ τ_T₁ hw₁ he_X₁ hτ_T₁
      obtain ⟨hJoint₂, _, _⟩ := h_qual_and_ode q ρ c_T w₂ e_X₂ τ_T₂ hw₂ he_X₂ hτ_T₂
      have hd₁_cd : ContDiff ℝ (0 : WithTop ℕ∞) (realMidpointDispU w₁ X₁ T₁ u_param) :=
        (hJoint₁.comp (contDiff_const.prodMk contDiff_id)).of_le (by norm_cast)
      have hd₂_cd : ContDiff ℝ (0 : WithTop ℕ∞) (realMidpointDispU w₂ X₂ T₂ u_param) :=
        (hJoint₂.comp (contDiff_const.prodMk contDiff_id)).of_le (by norm_cast)
      refine ⟨hd₁_cd.sub hd₂_cd, by simp [rmdLipSeq]; positivity, ?_⟩
      intro j hj x
      have hj0 : j = 0 := Nat.eq_zero_of_le_zero hj
      subst hj0
      simp only [iteratedDeriv_zero, rmdLipSeq]
      exact (le_div_iff₀' hq2_pos).mpr
        (h_c0_lip q ρ c_T Δe Δτ u_param w₁ w₂ e_X₁ τ_T₁ e_X₂ τ_T₂
          hq hc_T hu hΔe hΔτ hw₁ hw₂ he_X₁ hτ_T₁ he_X₂ hτ_T₂ hde hdτ x)
    | succ r ih =>
      intro hr1 q ρ c_T Δe Δτ u_param w₁ w₂ e_X₁ τ_T₁ e_X₂ τ_T₂
        hq hc_T hu hΔe hΔτ hw₁ hw₂ he_X₁ hτ_T₁ he_X₂ hτ_T₂ hde hdτ X₁ T₁ X₂ T₂ Λ
      have hr : r ≤ m + 1 := by omega
      have hq_ge4 : (4 : ℝ) ≤ (q : ℝ) := by exact_mod_cast hq
      have hq_pos : (0 : ℝ) < (q : ℝ) := by linarith
      have hq2_pos : (0 : ℝ) < (q : ℝ) ^ 2 := by positivity
      have hq2_ge16 : (16 : ℝ) ≤ (q : ℝ) ^ 2 := by nlinarith
      have hDw_nonneg := (H_base.diff_global_bound w₁ w₂ hw₁ hw₂).1
      have hΛ_nonneg : 0 ≤ Λ := by dsimp [Λ]; positivity
      have hΔw_le_Λ : realDiffSup (m + 15) w₁ w₂ ≤ Λ := by
        have hqdt : 0 ≤ (q : ℝ) * Δτ := by positivity
        dsimp [Λ]; linarith
      set h₁_fn : ℝ → ℝ := fun y => u_param * T₁ y / 2
      set M₀₁_fn : ℝ → ℝ := fun y => X₁ y + u_param * T₁ y / 2
      set d₁_fn : ℝ → ℝ := realMidpointDispU w₁ X₁ T₁ u_param
      set h₂_fn : ℝ → ℝ := fun y => u_param * T₂ y / 2
      set M₀₂_fn : ℝ → ℝ := fun y => X₂ y + u_param * T₂ y / 2
      set d₂_fn : ℝ → ℝ := realMidpointDispU w₂ X₂ T₂ u_param
      set L_r := rmdLipSeq M₁ C_single L₀_mid r
      have hLr_pos : 0 < L_r := h_lip_seq_pos r
      have hd_diff_r : rmdJetBnd r (L_r * Λ / (q : ℝ) ^ 2) (fun y => d₁_fn y - d₂_fn y) :=
        ih (by omega) q ρ c_T Δe Δτ u_param w₁ w₂ e_X₁ τ_T₁ e_X₂ τ_T₂
          hq hc_T hu hΔe hΔτ hw₁ hw₂ he_X₁ hτ_T₁ he_X₂ hτ_T₂ hde hdτ
      obtain ⟨hJoint₁, _, hOde₁⟩ := h_qual_and_ode q ρ c_T w₁ e_X₁ τ_T₁ hw₁ he_X₁ hτ_T₁
      obtain ⟨hJoint₂, _, hOde₂⟩ := h_qual_and_ode q ρ c_T w₂ e_X₂ τ_T₂ hw₂ he_X₂ hτ_T₂
      have hd₁_cd : ContDiff ℝ ((m + 2 : ℕ) : WithTop ℕ∞) d₁_fn :=
        hJoint₁.comp (contDiff_const.prodMk contDiff_id)
      have hd₂_cd : ContDiff ℝ ((m + 2 : ℕ) : WithTop ℕ∞) d₂_fn :=
        hJoint₂.comp (contDiff_const.prodMk contDiff_id)

      have hd₁_single : rmdJetBnd r (C_single / (q : ℝ) ^ 2) d₁_fn :=
        h_jet_mono (by omega) le_rfl
          (h_single_ind (m + 2) le_rfl q ρ c_T u_param w₁ e_X₁ τ_T₁ hq hc_T hu hw₁ he_X₁ hτ_T₁)
      have hd₂_single : rmdJetBnd r (C_single / (q : ℝ) ^ 2) d₂_fn :=
        h_jet_mono (by omega) le_rfl
          (h_single_ind (m + 2) le_rfl q ρ c_T u_param w₂ e_X₂ τ_T₂ hq hc_T hu hw₂ he_X₂ hτ_T₂)
      obtain ⟨hEd₁, hKlin₁, hK1₁, hK2₁⟩ :=
        h_single_kernels r C_single q ρ c_T u_param w₁ e_X₁ τ_T₁
          hr hC_single_pos hq hc_T hu hw₁ he_X₁ hτ_T₁ hd₁_single
      obtain ⟨hEd₂, hKlin₂, hK1₂, hK2₂⟩ :=
        h_single_kernels r C_single q ρ c_T u_param w₂ e_X₂ τ_T₂
          hr hC_single_pos hq hc_T hu hw₂ he_X₂ hτ_T₂ hd₂_single
      obtain ⟨hM₀₁_d, hM₀₁'_m1, hh₁_m2, hh₁_d, hh₁'_m1⟩ :=
        h_M₀_h_jets q ρ c_T u_param e_X₁ τ_T₁ hq hc_T hu he_X₁ hτ_T₁
      obtain ⟨hM₀₂_d, hM₀₂'_m1, hh₂_m2, hh₂_d, hh₂'_m1⟩ :=
        h_M₀_h_jets q ρ c_T u_param e_X₂ τ_T₂ hq hc_T hu he_X₂ hτ_T₂

      let B_star := 3 + C_single / 16
      let K_c := rmdCompConst r B_star
      let M_E := Real.exp (2 * M₁) * rmdCompConst r (2 * M₁ * K_c)
      let M_K1 := (2 : ℝ) ^ r * (M₁ * K_c) * M_E
      let M_K2 := (2 : ℝ) ^ r * (M₁ * K_c + (2 : ℝ) ^ r * (M₁ * K_c) * (M₁ * K_c)) * M_E
      let M_EdK2 := (2 : ℝ) ^ r * M_E * M_K2
      let M_EdK1 := (2 : ℝ) ^ r * M_E * M_K1
      let M_P12 := (2 : ℝ) ^ r * (21 * (2 : ℝ) ^ r) * M_EdK2 + (2 : ℝ) ^ r * C_single * M_K1
      let κ_r := 1 + L_r / 16
      let D_w := (2 : ℝ) ^ r * M₁ * K_c * κ_r + K_c
      let D_E := (2 : ℝ) ^ r * Real.exp (2 * M₁) * rmdCompConst r (2 * M₁ * K_c) * (2 * D_w)
      let D_K1 := (2 : ℝ) ^ r * (D_w * M_E + (M₁ * K_c) * D_E)
      let D_w2 := D_w + (2 : ℝ) ^ r * (D_w * (M₁ * K_c) + (M₁ * K_c) * D_w)
      let D_K2 :=
        (2 : ℝ) ^ r * (D_w2 * M_E + (M₁ * K_c + (2 : ℝ) ^ r * (M₁ * K_c) * (M₁ * K_c)) * D_E)
      let D_EdK2 := (2 : ℝ) ^ r * (D_E * M_K2 + M_E * D_K2)
      let D_EdK1 := (2 : ℝ) ^ r * (D_E * M_K1 + M_E * D_K1)
      let D_P12 :=
        (2 : ℝ) ^ r * (5 * (2 : ℝ) ^ r * M_EdK2 + 21 * (2 : ℝ) ^ r * D_EdK2) +
        (2 : ℝ) ^ r * (L_r * M_K1 + C_single * D_K1)
      let L_step :=
        (2 : ℝ) ^ r * (D_P12 * 2 + M_P12 * 1) +
        (2 : ℝ) ^ r * (3 * (2 : ℝ) ^ r * M_EdK1 + (2 : ℝ) ^ r * D_EdK1)

      have h_curve_B : ∀ {w_i e_Xi τ_Ti : ℝ → ℝ},
          rmdDerivBnd (m + 2) 2 (fun y => (y + ρ + e_Xi y) + u_param * (c_T + τ_Ti y) / 2) →
          rmdDerivBnd (m + 2) (1 / (8 * (q : ℝ))) (fun y => u_param * (c_T + τ_Ti y) / 2) →
          rmdJetBnd r (C_single / (q : ℝ) ^ 2)
            (realMidpointDispU w_i (fun y => y + ρ + e_Xi y) (fun y => c_T + τ_Ti y) u_param) →
          let h_i := fun y => u_param * (c_T + τ_Ti y) / 2
          let M₀_i := fun y => (y + ρ + e_Xi y) + u_param * (c_T + τ_Ti y) / 2
          let d_i := realMidpointDispU w_i (fun y => y + ρ + e_Xi y) (fun y => c_T + τ_Ti y) u_param
          rmdDerivBnd r B_star M₀_i ∧
          (∀ s ∈ Set.Icc (0 : ℝ) 1,
            rmdDerivBnd r B_star (fun y => M₀_i y + s * d_i y) ∧
            rmdDerivBnd r B_star (fun y => M₀_i y + s * h_i y) ∧
            rmdDerivBnd r B_star (fun y => M₀_i y - s * h_i y)) := by
        intro w_i e_Xi τ_Ti hM₀_i hh_i hd_i h_i M₀_i d_i
        have hh_i1 : rmdDerivBnd r 1 h_i := by
          have h8q : 1 / (8 * (q : ℝ)) ≤ 1 := by rw [div_le_one (by positivity)]; linarith
          exact h_deriv_mono (by omega) h8q hh_i
        have hd_i16 : rmdDerivBnd r (C_single / 16) d_i := by
          have hle : C_single / (q : ℝ) ^ 2 ≤ C_single / 16 :=
            div_le_div_of_nonneg_left (le_of_lt hC_single_pos) (by norm_num) hq2_ge16
          exact h_deriv_mono le_rfl hle (h_deriv_of_jet hd_i)
        refine ⟨h_deriv_mono (by omega) (by dsimp [B_star]; linarith) hM₀_i, ?_⟩
        intro s hs
        have hs_abs : |s| ≤ 1 := by rw [abs_of_nonneg hs.1]; exact hs.2
        refine ⟨?_, ?_, ?_⟩
        · have hsum := h_deriv_add (h_deriv_mono (by omega) le_rfl hM₀_i)
            (h_deriv_const_mul s hd_i16)
          exact h_deriv_mono le_rfl (by dsimp [B_star]; nlinarith) hsum
        · have hsum := h_deriv_add (h_deriv_mono (by omega) le_rfl hM₀_i)
            (h_deriv_const_mul s hh_i1)
          exact h_deriv_mono le_rfl (by dsimp [B_star]; nlinarith) hsum
        · have hEq : (fun y => M₀_i y - s * h_i y) = fun y => M₀_i y + (-s) * h_i y := by
            funext y; ring
          rw [hEq]
          have hsum := h_deriv_add (h_deriv_mono (by omega) le_rfl hM₀_i)
            (h_deriv_const_mul (-s) hh_i1)
          rw [abs_neg] at hsum
          exact h_deriv_mono le_rfl (by dsimp [B_star]; nlinarith) hsum

      obtain ⟨hM₀₁_B, h_curves₁⟩ := h_curve_B hM₀₁_d hh₁_d hd₁_single
      obtain ⟨hM₀₂_B, h_curves₂⟩ := h_curve_B hM₀₂_d hh₂_d hd₂_single

      have hde_m2 : rmdJetBnd (m + 2) Δe (fun y => e_X₁ y - e_X₂ y) :=
        ⟨he_X₁.2.1.sub he_X₂.2.1, hΔe, hde⟩
      have hdτ_m2 : rmdJetBnd (m + 2) Δτ (fun y => τ_T₁ y - τ_T₂ y) :=
        ⟨hτ_T₁.2.1.sub hτ_T₂.2.1, hΔτ, hdτ⟩
      have hu_abs : |u_param| ≤ 1 := by rw [abs_of_nonneg hu.1]; exact hu.2
      have hh_diff_m2 : rmdJetBnd (m + 2) (Δτ / 2) (fun y => h₁_fn y - h₂_fn y) := by
        have hEq : (fun y => h₁_fn y - h₂_fn y) =
            fun y => (u_param / 2) * (τ_T₁ y - τ_T₂ y) := by
          funext y; dsimp [h₁_fn, h₂_fn, T₁, T₂]; ring
        rw [hEq]
        have hm := h_jet_const_mul (u_param / 2) hdτ_m2
        have hle : |u_param / 2| * Δτ ≤ Δτ / 2 := by
          rw [abs_div, abs_of_pos (by norm_num : (0 : ℝ) < 2)]
          nlinarith
        exact h_jet_mono le_rfl hle hm
      have hM₀_diff_m2 : rmdJetBnd (m + 2) (Δe + Δτ / 2) (fun y => M₀₁_fn y - M₀₂_fn y) := by
        have hEq : (fun y => M₀₁_fn y - M₀₂_fn y) =
            fun y => (e_X₁ y - e_X₂ y) + (h₁_fn y - h₂_fn y) := by
          funext y; dsimp [M₀₁_fn, M₀₂_fn, X₁, X₂]; ring
        rw [hEq]
        exact h_jet_add hde_m2 hh_diff_m2
      have h_q_dtau : Δτ ≤ (q : ℝ) * Δτ := by nlinarith
      have hM₀'_diff_r : rmdJetBnd r (1 * Λ) (fun y => deriv M₀₁_fn y - deriv M₀₂_fn y) := by
        have hd_sub : (fun y => deriv M₀₁_fn y - deriv M₀₂_fn y) =
            deriv (fun y => M₀₁_fn y - M₀₂_fn y) := by
          funext y
          have h_ne0 : ((m + 2 : ℕ) : WithTop ℕ∞) ≠ 0 := by simp
          have hd1 := (hM₀₁_d.1.differentiable h_ne0).differentiableAt.hasDerivAt (x := y)
          have hd2 := (hM₀₂_d.1.differentiable h_ne0).differentiableAt.hasDerivAt (x := y)
          exact (hd1.sub hd2).deriv.symm
        rw [hd_sub]
        have hm1 := h_jet_of_deriv (h_deriv_of_jet hM₀_diff_m2)
        exact h_jet_mono hr (by dsimp [Λ]; linarith) hm1
      have hh'_diff_r : rmdJetBnd r (Δτ / 2) (fun y => deriv h₁_fn y - deriv h₂_fn y) := by
        have hd_sub : (fun y => deriv h₁_fn y - deriv h₂_fn y) =
            deriv (fun y => h₁_fn y - h₂_fn y) := by
          funext y
          have h_ne0 : ((m + 2 : ℕ) : WithTop ℕ∞) ≠ 0 := by simp
          have hd1 := (hh₁_m2.1.differentiable h_ne0).differentiableAt.hasDerivAt (x := y)
          have hd2 := (hh₂_m2.1.differentiable h_ne0).differentiableAt.hasDerivAt (x := y)
          exact (hd1.sub hd2).deriv.symm
        rw [hd_sub]
        exact h_jet_mono hr le_rfl (h_jet_of_deriv (h_deriv_of_jet hh_diff_m2))

      have hM₀_diff_κ : rmdJetBnd r (κ_r * Λ) (fun y => M₀₁_fn y - M₀₂_fn y) := by
        have hle : Δe + Δτ / 2 ≤ κ_r * Λ := by
          have : 1 * Λ ≤ κ_r * Λ :=
            mul_le_mul_of_nonneg_right (by dsimp [κ_r]; linarith) hΛ_nonneg
          have : Δe + Δτ / 2 ≤ 1 * Λ := by dsimp [Λ]; linarith
          linarith
        exact h_jet_mono (by omega) hle hM₀_diff_m2
      have hd_diff_16 : rmdJetBnd r ((L_r / 16) * Λ) (fun y => d₁_fn y - d₂_fn y) := by
        have hle : L_r * Λ / (q : ℝ) ^ 2 ≤ (L_r / 16) * Λ := by
          have h1 : L_r * Λ / (q : ℝ) ^ 2 ≤ L_r * Λ / 16 :=
            div_le_div_of_nonneg_left (by positivity) (by norm_num) hq2_ge16
          linarith
        exact h_jet_mono le_rfl hle hd_diff_r
      have hM₀_sd_diff_κ : ∀ s ∈ Set.Icc (0 : ℝ) 1,
          rmdJetBnd r (κ_r * Λ) (fun y => (M₀₁_fn y + s * d₁_fn y) - (M₀₂_fn y + s * d₂_fn y)) := by
        intro s hs
        have hs_abs : |s| ≤ 1 := by rw [abs_of_nonneg hs.1]; exact hs.2
        have hEq : (fun y => (M₀₁_fn y + s * d₁_fn y) - (M₀₂_fn y + s * d₂_fn y)) =
            fun y => (M₀₁_fn y - M₀₂_fn y) + s * (d₁_fn y - d₂_fn y) := by funext y; ring
        rw [hEq]
        have hsum := h_jet_add (h_jet_mono (by omega) (by dsimp [Λ]; linarith : Δe + Δτ / 2 ≤ Λ) hM₀_diff_m2)
          (h_jet_const_mul s hd_diff_16)
        have hle : Λ + |s| * ((L_r / 16) * Λ) ≤ κ_r * Λ := by
          have : |s| * ((L_r / 16) * Λ) ≤ 1 * ((L_r / 16) * Λ) :=
            mul_le_mul_of_nonneg_right hs_abs (by positivity)
          dsimp [κ_r]; linarith
        exact h_jet_mono le_rfl hle hsum
      have hM₀_sh_diff_κ : ∀ s ∈ Set.Icc (0 : ℝ) 1,
          rmdJetBnd r (κ_r * Λ) (fun y => (M₀₁_fn y + s * h₁_fn y) - (M₀₂_fn y + s * h₂_fn y)) ∧
          rmdJetBnd r (κ_r * Λ) (fun y => (M₀₁_fn y - s * h₁_fn y) - (M₀₂_fn y - s * h₂_fn y)) := by
        intro s hs
        have hs_abs : |s| ≤ 1 := by rw [abs_of_nonneg hs.1]; exact hs.2
        have h_one_le_κ : Λ ≤ κ_r * Λ := by
          have : 1 * Λ ≤ κ_r * Λ :=
            mul_le_mul_of_nonneg_right (by dsimp [κ_r]; linarith) hΛ_nonneg
          linarith
        refine ⟨?_, ?_⟩
        · have hEq : (fun y => (M₀₁_fn y + s * h₁_fn y) - (M₀₂_fn y + s * h₂_fn y)) =
              fun y => (M₀₁_fn y - M₀₂_fn y) + s * (h₁_fn y - h₂_fn y) := by funext y; ring
          rw [hEq]
          have hsum := h_jet_add (h_jet_mono (k' := r) (by omega) le_rfl hM₀_diff_m2)
            (h_jet_const_mul s (h_jet_mono (k' := r) (by omega) le_rfl hh_diff_m2))
          have hle : (Δe + Δτ / 2) + |s| * (Δτ / 2) ≤ κ_r * Λ := by
            have : |s| * (Δτ / 2) ≤ 1 * (Δτ / 2) :=
              mul_le_mul_of_nonneg_right hs_abs (by positivity)
            have : Δe + Δτ ≤ Λ := by dsimp [Λ]; linarith
            linarith
          exact h_jet_mono le_rfl hle hsum
        · have hEq : (fun y => (M₀₁_fn y - s * h₁_fn y) - (M₀₂_fn y - s * h₂_fn y)) =
              fun y => (M₀₁_fn y - M₀₂_fn y) - s * (h₁_fn y - h₂_fn y) := by funext y; ring
          rw [hEq]
          have hsum := h_jet_sub (h_jet_mono (k' := r) (by omega) le_rfl hM₀_diff_m2)
            (h_jet_const_mul s (h_jet_mono (k' := r) (by omega) le_rfl hh_diff_m2))
          have hle : (Δe + Δτ / 2) + |s| * (Δτ / 2) ≤ κ_r * Λ := by
            have : |s| * (Δτ / 2) ≤ 1 * (Δτ / 2) :=
              mul_le_mul_of_nonneg_right hs_abs (by positivity)
            have : Δe + Δτ ≤ Λ := by dsimp [Λ]; linarith
            linarith
          exact h_jet_mono le_rfl hle hsum

      have hw₁_0_cd : ContDiff ℝ (r : WithTop ℕ∞) w₁ := hw₁.2.1.of_le (by norm_cast; omega)
      have hw₁_1_cd : ContDiff ℝ (r : WithTop ℕ∞) (deriv w₁) := by
        simpa [iteratedDeriv_one] using h_contDiff_iter 1 r w₁ (hw₁.2.1.of_le (by norm_cast; omega))
      have hw₁_2_cd : ContDiff ℝ (r : WithTop ℕ∞) (iteratedDeriv 2 w₁) :=
        h_contDiff_iter 2 r w₁ (hw₁.2.1.of_le (by norm_cast; omega))
      have hw₂_0_cd : ContDiff ℝ (r : WithTop ℕ∞) w₂ := hw₂.2.1.of_le (by norm_cast; omega)
      have hw₂_1_cd : ContDiff ℝ (r : WithTop ℕ∞) (deriv w₂) := by
        simpa [iteratedDeriv_one] using h_contDiff_iter 1 r w₂ (hw₂.2.1.of_le (by norm_cast; omega))
      have hw₂_2_cd : ContDiff ℝ (r : WithTop ℕ∞) (iteratedDeriv 2 w₂) :=
        h_contDiff_iter 2 r w₂ (hw₂.2.1.of_le (by norm_cast; omega))
      have hM₀₁_2d : ContDiff ℝ (r : WithTop ℕ∞) (fun p : ℝ × ℝ => M₀₁_fn p.2) :=
        hM₀₁_B.1.comp contDiff_snd
      have hh₁_2d : ContDiff ℝ (r : WithTop ℕ∞) (fun p : ℝ × ℝ => h₁_fn p.2) :=
        (hh₁_m2.1.of_le (by norm_cast; omega)).comp contDiff_snd
      have hd₁_2d : ContDiff ℝ (r : WithTop ℕ∞) (fun p : ℝ × ℝ => d₁_fn p.2) :=
        hd₁_single.1.comp contDiff_snd
      have hM₀₂_2d : ContDiff ℝ (r : WithTop ℕ∞) (fun p : ℝ × ℝ => M₀₂_fn p.2) :=
        hM₀₂_B.1.comp contDiff_snd
      have hh₂_2d : ContDiff ℝ (r : WithTop ℕ∞) (fun p : ℝ × ℝ => h₂_fn p.2) :=
        (hh₂_m2.1.of_le (by norm_cast; omega)).comp contDiff_snd
      have hd₂_2d : ContDiff ℝ (r : WithTop ℕ∞) (fun p : ℝ × ℝ => d₂_fn p.2) :=
        hd₂_single.1.comp contDiff_snd

      have hKc_pos : 0 ≤ K_c := le_trans zero_le_one (h_compConst_ge_one r B_star)
      have hME_pos : 0 ≤ M_E :=
        mul_nonneg (le_of_lt (Real.exp_pos _))
          (le_trans zero_le_one (h_compConst_ge_one r (2 * M₁ * K_c)))
      have hDw_pos : 0 ≤ D_w := by dsimp [D_w, κ_r]; positivity
      have hDE_pos : 0 ≤ D_E := by
        have := h_compConst_ge_one r (2 * M₁ * K_c)
        dsimp [D_E]; positivity
      have hDK1_pos : 0 ≤ D_K1 := by dsimp [D_K1]; positivity
      have hDK2_pos : 0 ≤ D_K2 := by dsimp [D_K2, D_w2]; positivity

      have hEd_diff : rmdJetBnd r (D_E * Λ)
          (fun y => Real.exp (w₁ (M₀₁_fn y) - w₁ (M₀₁_fn y + d₁_fn y)) -
            Real.exp (w₂ (M₀₂_fn y) - w₂ (M₀₂_fn y + d₂_fn y))) := by
        have hd1_B : rmdDerivBnd r B_star (fun y => M₀₁_fn y + d₁_fn y) := by
          simpa using (h_curves₁ 1 ⟨zero_le_one, le_rfl⟩).1
        have hd2_B : rmdDerivBnd r B_star (fun y => M₀₂_fn y + d₂_fn y) := by
          simpa using (h_curves₂ 1 ⟨zero_le_one, le_rfl⟩).1
        have hd12_diff : rmdJetBnd r (κ_r * Λ)
            (fun y => (M₀₁_fn y + d₁_fn y) - (M₀₂_fn y + d₂_fn y)) := by
          simpa using hM₀_sd_diff_κ 1 ⟨zero_le_one, le_rfl⟩
        exact h_exp_w_diff hr hΛ_nonneg hw₁ hw₂ hΔw_le_Λ
          hM₀₁_B hd1_B hM₀₂_B hd2_B hM₀_diff_κ hd12_diff

      have hKlin_diff : rmdJetBnd r (D_K1 * Λ)
          (fun y => rmdKlin w₁ (M₀₁_fn y) (d₁_fn y) - rmdKlin w₂ (M₀₂_fn y) (d₂_fn y)) := by
        let G₁ : ℝ × ℝ → ℝ := fun p =>
          deriv w₁ (M₀₁_fn p.2 + p.1 * d₁_fn p.2) *
            Real.exp (w₁ (M₀₁_fn p.2) - w₁ (M₀₁_fn p.2 + p.1 * d₁_fn p.2))
        let G₂ : ℝ × ℝ → ℝ := fun p =>
          deriv w₂ (M₀₂_fn p.2 + p.1 * d₂_fn p.2) *
            Real.exp (w₂ (M₀₂_fn p.2) - w₂ (M₀₂_fn p.2 + p.1 * d₂_fn p.2))
        have hG₁_cd : ContDiff ℝ (r : WithTop ℕ∞) G₁ :=
          (hw₁_1_cd.comp (hM₀₁_2d.add (contDiff_fst.mul hd₁_2d))).mul
            ((hw₁_0_cd.comp hM₀₁_2d).sub (hw₁_0_cd.comp (hM₀₁_2d.add (contDiff_fst.mul hd₁_2d)))).exp
        have hG₂_cd : ContDiff ℝ (r : WithTop ℕ∞) G₂ :=
          (hw₂_1_cd.comp (hM₀₂_2d.add (contDiff_fst.mul hd₂_2d))).mul
            ((hw₂_0_cd.comp hM₀₂_2d).sub (hw₂_0_cd.comp (hM₀₂_2d.add (contDiff_fst.mul hd₂_2d)))).exp
        have hGs : ∀ s ∈ Set.Icc (0 : ℝ) 1,
            rmdJetBnd r (D_K1 * Λ) (fun y => G₁ (s, y) - G₂ (s, y)) := by
          intro s hs
          have hc₁ := (h_curves₁ s hs).1
          have hc₂ := (h_curves₂ s hs).1
          have hdw₂ : rmdJetBnd r (M₁ * K_c) (fun y => deriv w₂ (M₀₂_fn y + s * d₂_fn y)) := by
            simpa [iteratedDeriv_one] using h_w_single hr (by omega : 1 ≤ 2) hw₂ hc₂
          have hex₁ := h_exp_w_single hr hw₁ hM₀₁_B hc₁
          have hdw_d : rmdJetBnd r (D_w * Λ)
              (fun y => deriv w₁ (M₀₁_fn y + s * d₁_fn y) - deriv w₂ (M₀₂_fn y + s * d₂_fn y)) := by
            simpa [iteratedDeriv_one] using
              h_w_diff hr (by omega : 1 ≤ 2) hΛ_nonneg hw₁ hw₂ hΔw_le_Λ hc₁ hc₂ (hM₀_sd_diff_κ s hs)
          have hex_d := h_exp_w_diff hr hΛ_nonneg hw₁ hw₂ hΔw_le_Λ
            hM₀₁_B hc₁ hM₀₂_B hc₂ hM₀_diff_κ (hM₀_sd_diff_κ s hs)
          exact h_jet_mono le_rfl (by dsimp [D_K1]; linarith)
            (h_jet_mul_diff hdw₂ hex₁ hdw_d hex_d)
        have h_int := h_jet_unit_int_sub hG₁_cd hG₂_cd (mul_nonneg hDK1_pos hΛ_nonneg) hGs
        have hEq : (fun y => rmdKlin w₁ (M₀₁_fn y) (d₁_fn y) - rmdKlin w₂ (M₀₂_fn y) (d₂_fn y)) =
            fun y => (-1 : ℝ) * ((∫ s in (0 : ℝ)..1, G₁ (s, y)) - (∫ s in (0 : ℝ)..1, G₂ (s, y))) := by
          funext y; dsimp [rmdKlin, G₁, G₂]; ring
        rw [hEq]
        exact h_jet_mono le_rfl (by simp) (h_jet_const_mul (-1 : ℝ) h_int)

      have hK1_diff : rmdJetBnd r (D_K1 * Λ)
          (fun y => rmdK1 w₁ (M₀₁_fn y) (h₁_fn y) - rmdK1 w₂ (M₀₂_fn y) (h₂_fn y)) := by
        let G₁ : ℝ × ℝ → ℝ := fun p =>
          deriv w₁ (M₀₁_fn p.2 + p.1 * h₁_fn p.2) *
            Real.exp (w₁ (M₀₁_fn p.2 + p.1 * h₁_fn p.2) - w₁ (M₀₁_fn p.2)) +
          deriv w₁ (M₀₁_fn p.2 - p.1 * h₁_fn p.2) *
            Real.exp (w₁ (M₀₁_fn p.2 - p.1 * h₁_fn p.2) - w₁ (M₀₁_fn p.2))
        let G₂ : ℝ × ℝ → ℝ := fun p =>
          deriv w₂ (M₀₂_fn p.2 + p.1 * h₂_fn p.2) *
            Real.exp (w₂ (M₀₂_fn p.2 + p.1 * h₂_fn p.2) - w₂ (M₀₂_fn p.2)) +
          deriv w₂ (M₀₂_fn p.2 - p.1 * h₂_fn p.2) *
            Real.exp (w₂ (M₀₂_fn p.2 - p.1 * h₂_fn p.2) - w₂ (M₀₂_fn p.2))
        have hG₁_cd : ContDiff ℝ (r : WithTop ℕ∞) G₁ :=
          ((hw₁_1_cd.comp (hM₀₁_2d.add (contDiff_fst.mul hh₁_2d))).mul
            ((hw₁_0_cd.comp (hM₀₁_2d.add (contDiff_fst.mul hh₁_2d))).sub
              (hw₁_0_cd.comp hM₀₁_2d)).exp).add
          ((hw₁_1_cd.comp (hM₀₁_2d.sub (contDiff_fst.mul hh₁_2d))).mul
            ((hw₁_0_cd.comp (hM₀₁_2d.sub (contDiff_fst.mul hh₁_2d))).sub
              (hw₁_0_cd.comp hM₀₁_2d)).exp)
        have hG₂_cd : ContDiff ℝ (r : WithTop ℕ∞) G₂ :=
          ((hw₂_1_cd.comp (hM₀₂_2d.add (contDiff_fst.mul hh₂_2d))).mul
            ((hw₂_0_cd.comp (hM₀₂_2d.add (contDiff_fst.mul hh₂_2d))).sub
              (hw₂_0_cd.comp hM₀₂_2d)).exp).add
          ((hw₂_1_cd.comp (hM₀₂_2d.sub (contDiff_fst.mul hh₂_2d))).mul
            ((hw₂_0_cd.comp (hM₀₂_2d.sub (contDiff_fst.mul hh₂_2d))).sub
              (hw₂_0_cd.comp hM₀₂_2d)).exp)
        have hGs : ∀ s ∈ Set.Icc (0 : ℝ) 1,
            rmdJetBnd r (2 * (D_K1 * Λ)) (fun y => G₁ (s, y) - G₂ (s, y)) := by
          intro s hs
          have h_br : ∀ {Y₁ Y₂ : ℝ → ℝ},
              rmdDerivBnd r B_star Y₁ → rmdDerivBnd r B_star Y₂ →
              rmdJetBnd r (κ_r * Λ) (fun y => Y₁ y - Y₂ y) →
              rmdJetBnd r (D_K1 * Λ)
                (fun y => deriv w₁ (Y₁ y) * Real.exp (w₁ (Y₁ y) - w₁ (M₀₁_fn y)) -
                  deriv w₂ (Y₂ y) * Real.exp (w₂ (Y₂ y) - w₂ (M₀₂_fn y))) := by
            intro Y₁ Y₂ hY₁ hY₂ hdY
            have hdw₂ : rmdJetBnd r (M₁ * K_c) (fun y => deriv w₂ (Y₂ y)) := by
              simpa [iteratedDeriv_one] using h_w_single hr (by omega : 1 ≤ 2) hw₂ hY₂
            have hex₁ := h_exp_w_single hr hw₁ hY₁ hM₀₁_B
            have hdw_d : rmdJetBnd r (D_w * Λ) (fun y => deriv w₁ (Y₁ y) - deriv w₂ (Y₂ y)) := by
              simpa [iteratedDeriv_one] using
                h_w_diff hr (by omega : 1 ≤ 2) hΛ_nonneg hw₁ hw₂ hΔw_le_Λ hY₁ hY₂ hdY
            have hex_d := h_exp_w_diff hr hΛ_nonneg hw₁ hw₂ hΔw_le_Λ
              hY₁ hM₀₁_B hY₂ hM₀₂_B hdY hM₀_diff_κ
            exact h_jet_mono le_rfl (by dsimp [D_K1]; linarith)
              (h_jet_mul_diff hdw₂ hex₁ hdw_d hex_d)
          have hp := h_br (h_curves₁ s hs).2.1 (h_curves₂ s hs).2.1 (hM₀_sh_diff_κ s hs).1
          have hm := h_br (h_curves₁ s hs).2.2 (h_curves₂ s hs).2.2 (hM₀_sh_diff_κ s hs).2
          have hEq : (fun y => G₁ (s, y) - G₂ (s, y)) =
              fun y =>
                (deriv w₁ (M₀₁_fn y + s * h₁_fn y) * Real.exp (w₁ (M₀₁_fn y + s * h₁_fn y) - w₁ (M₀₁_fn y)) -
                 deriv w₂ (M₀₂_fn y + s * h₂_fn y) * Real.exp (w₂ (M₀₂_fn y + s * h₂_fn y) - w₂ (M₀₂_fn y))) +
                (deriv w₁ (M₀₁_fn y - s * h₁_fn y) * Real.exp (w₁ (M₀₁_fn y - s * h₁_fn y) - w₁ (M₀₁_fn y)) -
                 deriv w₂ (M₀₂_fn y - s * h₂_fn y) * Real.exp (w₂ (M₀₂_fn y - s * h₂_fn y) - w₂ (M₀₂_fn y))) := by
            funext y; dsimp [G₁, G₂]; ring
          rw [hEq]
          exact h_jet_mono le_rfl (by linarith) (h_jet_add hp hm)
        have h_int := h_jet_unit_int_sub hG₁_cd hG₂_cd (by positivity) hGs
        have hEq : (fun y => rmdK1 w₁ (M₀₁_fn y) (h₁_fn y) - rmdK1 w₂ (M₀₂_fn y) (h₂_fn y)) =
            fun y => (1 / 2 : ℝ) * ((∫ s in (0 : ℝ)..1, G₁ (s, y)) - (∫ s in (0 : ℝ)..1, G₂ (s, y))) := by
          funext y; dsimp [rmdK1, G₁, G₂]; ring
        rw [hEq]
        exact h_jet_mono le_rfl (by norm_num; linarith) (h_jet_const_mul (1 / 2 : ℝ) h_int)

      have hK2_diff : rmdJetBnd r (D_K2 * Λ)
          (fun y => rmdK2 w₁ (M₀₁_fn y) (h₁_fn y) - rmdK2 w₂ (M₀₂_fn y) (h₂_fn y)) := by
        let G₁ : ℝ × ℝ → ℝ := fun p => (1 - p.1) *
          (((iteratedDeriv 2 w₁ (M₀₁_fn p.2 + p.1 * h₁_fn p.2) +
              (deriv w₁ (M₀₁_fn p.2 + p.1 * h₁_fn p.2)) ^ 2) *
             Real.exp (w₁ (M₀₁_fn p.2 + p.1 * h₁_fn p.2) - w₁ (M₀₁_fn p.2))) +
           ((iteratedDeriv 2 w₁ (M₀₁_fn p.2 - p.1 * h₁_fn p.2) +
              (deriv w₁ (M₀₁_fn p.2 - p.1 * h₁_fn p.2)) ^ 2) *
             Real.exp (w₁ (M₀₁_fn p.2 - p.1 * h₁_fn p.2) - w₁ (M₀₁_fn p.2))))
        let G₂ : ℝ × ℝ → ℝ := fun p => (1 - p.1) *
          (((iteratedDeriv 2 w₂ (M₀₂_fn p.2 + p.1 * h₂_fn p.2) +
              (deriv w₂ (M₀₂_fn p.2 + p.1 * h₂_fn p.2)) ^ 2) *
             Real.exp (w₂ (M₀₂_fn p.2 + p.1 * h₂_fn p.2) - w₂ (M₀₂_fn p.2))) +
           ((iteratedDeriv 2 w₂ (M₀₂_fn p.2 - p.1 * h₂_fn p.2) +
              (deriv w₂ (M₀₂_fn p.2 - p.1 * h₂_fn p.2)) ^ 2) *
             Real.exp (w₂ (M₀₂_fn p.2 - p.1 * h₂_fn p.2) - w₂ (M₀₂_fn p.2))))
        have hG₁_cd : ContDiff ℝ (r : WithTop ℕ∞) G₁ :=
          (contDiff_const.sub contDiff_fst).mul
            ((((hw₁_2_cd.comp (hM₀₁_2d.add (contDiff_fst.mul hh₁_2d))).add
              ((hw₁_1_cd.comp (hM₀₁_2d.add (contDiff_fst.mul hh₁_2d))).pow 2)).mul
              ((hw₁_0_cd.comp (hM₀₁_2d.add (contDiff_fst.mul hh₁_2d))).sub
                (hw₁_0_cd.comp hM₀₁_2d)).exp).add
             (((hw₁_2_cd.comp (hM₀₁_2d.sub (contDiff_fst.mul hh₁_2d))).add
              ((hw₁_1_cd.comp (hM₀₁_2d.sub (contDiff_fst.mul hh₁_2d))).pow 2)).mul
              ((hw₁_0_cd.comp (hM₀₁_2d.sub (contDiff_fst.mul hh₁_2d))).sub
                (hw₁_0_cd.comp hM₀₁_2d)).exp))
        have hG₂_cd : ContDiff ℝ (r : WithTop ℕ∞) G₂ :=
          (contDiff_const.sub contDiff_fst).mul
            ((((hw₂_2_cd.comp (hM₀₂_2d.add (contDiff_fst.mul hh₂_2d))).add
              ((hw₂_1_cd.comp (hM₀₂_2d.add (contDiff_fst.mul hh₂_2d))).pow 2)).mul
              ((hw₂_0_cd.comp (hM₀₂_2d.add (contDiff_fst.mul hh₂_2d))).sub
                (hw₂_0_cd.comp hM₀₂_2d)).exp).add
             (((hw₂_2_cd.comp (hM₀₂_2d.sub (contDiff_fst.mul hh₂_2d))).add
              ((hw₂_1_cd.comp (hM₀₂_2d.sub (contDiff_fst.mul hh₂_2d))).pow 2)).mul
              ((hw₂_0_cd.comp (hM₀₂_2d.sub (contDiff_fst.mul hh₂_2d))).sub
                (hw₂_0_cd.comp hM₀₂_2d)).exp))
        have hGs : ∀ s ∈ Set.Icc (0 : ℝ) 1,
            rmdJetBnd r (2 * (D_K2 * Λ)) (fun y => G₁ (s, y) - G₂ (s, y)) := by
          intro s hs
          have h_br : ∀ {Y₁ Y₂ : ℝ → ℝ},
              rmdDerivBnd r B_star Y₁ → rmdDerivBnd r B_star Y₂ →
              rmdJetBnd r (κ_r * Λ) (fun y => Y₁ y - Y₂ y) →
              rmdJetBnd r (D_K2 * Λ)
                (fun y =>
                  (iteratedDeriv 2 w₁ (Y₁ y) + (deriv w₁ (Y₁ y)) ^ 2) *
                    Real.exp (w₁ (Y₁ y) - w₁ (M₀₁_fn y)) -
                  (iteratedDeriv 2 w₂ (Y₂ y) + (deriv w₂ (Y₂ y)) ^ 2) *
                    Real.exp (w₂ (Y₂ y) - w₂ (M₀₂_fn y))) := by
            intro Y₁ Y₂ hY₁ hY₂ hdY
            have hw1_1 : rmdJetBnd r (M₁ * K_c) (fun y => deriv w₁ (Y₁ y)) := by
              simpa [iteratedDeriv_one] using h_w_single hr (by omega : 1 ≤ 2) hw₁ hY₁
            have hw1_2 : rmdJetBnd r (M₁ * K_c) (fun y => deriv w₂ (Y₂ y)) := by
              simpa [iteratedDeriv_one] using h_w_single hr (by omega : 1 ≤ 2) hw₂ hY₂
            have hw2_2 := h_w_single hr (le_rfl : 2 ≤ 2) hw₂ hY₂
            have hw1_sq2 : rmdJetBnd r ((2 : ℝ) ^ r * (M₁ * K_c) * (M₁ * K_c))
                (fun y => (deriv w₂ (Y₂ y)) ^ 2) := by
              have hsq : (fun y => (deriv w₂ (Y₂ y)) ^ 2) =
                  fun y => deriv w₂ (Y₂ y) * deriv w₂ (Y₂ y) := by funext y; ring
              rw [hsq]; exact h_jet_mul hw1_2 hw1_2
            have h_f2 := h_jet_add hw2_2 hw1_sq2
            have hex₁ := h_exp_w_single hr hw₁ hY₁ hM₀₁_B
            have hdw1_d : rmdJetBnd r (D_w * Λ) (fun y => deriv w₁ (Y₁ y) - deriv w₂ (Y₂ y)) := by
              simpa [iteratedDeriv_one] using
                h_w_diff hr (by omega : 1 ≤ 2) hΛ_nonneg hw₁ hw₂ hΔw_le_Λ hY₁ hY₂ hdY
            have hdw2_d := h_w_diff hr (le_rfl : 2 ≤ 2) hΛ_nonneg hw₁ hw₂ hΔw_le_Λ hY₁ hY₂ hdY
            have hsq_d : rmdJetBnd r
                ((2 : ℝ) ^ r * ((D_w * Λ) * (M₁ * K_c) + (M₁ * K_c) * (D_w * Λ)))
                (fun y => (deriv w₁ (Y₁ y)) ^ 2 - (deriv w₂ (Y₂ y)) ^ 2) := by
              have hsq : (fun y => (deriv w₁ (Y₁ y)) ^ 2 - (deriv w₂ (Y₂ y)) ^ 2) =
                  fun y => deriv w₁ (Y₁ y) * deriv w₁ (Y₁ y) - deriv w₂ (Y₂ y) * deriv w₂ (Y₂ y) := by
                funext y; ring
              rw [hsq]; exact h_jet_mul_diff hw1_2 hw1_1 hdw1_d hdw1_d
            have h_df : rmdJetBnd r (D_w2 * Λ)
                (fun y => (iteratedDeriv 2 w₁ (Y₁ y) + (deriv w₁ (Y₁ y)) ^ 2) -
                  (iteratedDeriv 2 w₂ (Y₂ y) + (deriv w₂ (Y₂ y)) ^ 2)) := by
              have hEq : (fun y => (iteratedDeriv 2 w₁ (Y₁ y) + (deriv w₁ (Y₁ y)) ^ 2) -
                  (iteratedDeriv 2 w₂ (Y₂ y) + (deriv w₂ (Y₂ y)) ^ 2)) =
                  fun y => (iteratedDeriv 2 w₁ (Y₁ y) - iteratedDeriv 2 w₂ (Y₂ y)) +
                    ((deriv w₁ (Y₁ y)) ^ 2 - (deriv w₂ (Y₂ y)) ^ 2) := by funext y; ring
              rw [hEq]
              exact h_jet_mono le_rfl (by dsimp [D_w2]; linarith) (h_jet_add hdw2_d hsq_d)
            have hex_d := h_exp_w_diff hr hΛ_nonneg hw₁ hw₂ hΔw_le_Λ
              hY₁ hM₀₁_B hY₂ hM₀₂_B hdY hM₀_diff_κ
            exact h_jet_mono le_rfl (by dsimp [D_K2]; linarith)
              (h_jet_mul_diff h_f2 hex₁ h_df hex_d)
          have hp := h_br (h_curves₁ s hs).2.1 (h_curves₂ s hs).2.1 (hM₀_sh_diff_κ s hs).1
          have hm := h_br (h_curves₁ s hs).2.2 (h_curves₂ s hs).2.2 (hM₀_sh_diff_κ s hs).2
          have hsum := h_jet_add hp hm
          have h1s : |1 - s| ≤ 1 := by
            rw [abs_of_nonneg (by linarith [hs.2])]; linarith [hs.1]
          have hEq : (fun y => G₁ (s, y) - G₂ (s, y)) =
              fun y => (1 - s) *
                (((iteratedDeriv 2 w₁ (M₀₁_fn y + s * h₁_fn y) + (deriv w₁ (M₀₁_fn y + s * h₁_fn y)) ^ 2) *
                   Real.exp (w₁ (M₀₁_fn y + s * h₁_fn y) - w₁ (M₀₁_fn y)) -
                  (iteratedDeriv 2 w₂ (M₀₂_fn y + s * h₂_fn y) + (deriv w₂ (M₀₂_fn y + s * h₂_fn y)) ^ 2) *
                   Real.exp (w₂ (M₀₂_fn y + s * h₂_fn y) - w₂ (M₀₂_fn y))) +
                 ((iteratedDeriv 2 w₁ (M₀₁_fn y - s * h₁_fn y) + (deriv w₁ (M₀₁_fn y - s * h₁_fn y)) ^ 2) *
                   Real.exp (w₁ (M₀₁_fn y - s * h₁_fn y) - w₁ (M₀₁_fn y)) -
                  (iteratedDeriv 2 w₂ (M₀₂_fn y - s * h₂_fn y) + (deriv w₂ (M₀₂_fn y - s * h₂_fn y)) ^ 2) *
                   Real.exp (w₂ (M₀₂_fn y - s * h₂_fn y) - w₂ (M₀₂_fn y)))) := by
            funext y; dsimp [G₁, G₂]; ring
          rw [hEq]
          have hDK2Λ : 0 ≤ D_K2 * Λ := mul_nonneg hDK2_pos hΛ_nonneg
          exact h_jet_mono le_rfl (by nlinarith) (h_jet_const_mul (1 - s) hsum)
        have h_int := h_jet_unit_int_sub hG₁_cd hG₂_cd (by positivity) hGs
        have hEq : (fun y => rmdK2 w₁ (M₀₁_fn y) (h₁_fn y) - rmdK2 w₂ (M₀₂_fn y) (h₂_fn y)) =
            fun y => (1 / 2 : ℝ) * ((∫ s in (0 : ℝ)..1, G₁ (s, y)) - (∫ s in (0 : ℝ)..1, G₂ (s, y))) := by
          funext y; dsimp [rmdK2, G₁, G₂]; ring
        rw [hEq]
        exact h_jet_mono le_rfl (by norm_num; linarith) (h_jet_const_mul (1 / 2 : ℝ) h_int)

      have hh₁_r : rmdJetBnd r (9 / (2 * (q : ℝ))) h₁_fn := h_jet_mono (by omega) le_rfl hh₁_m2
      have hh₂_r : rmdJetBnd r (9 / (2 * (q : ℝ))) h₂_fn := h_jet_mono (by omega) le_rfl hh₂_m2
      have hh₁'_r : rmdJetBnd r (1 / (8 * (q : ℝ))) (deriv h₁_fn) := h_jet_mono hr le_rfl hh₁'_m1
      have hh₂'_r : rmdJetBnd r (1 / (8 * (q : ℝ))) (deriv h₂_fn) := h_jet_mono hr le_rfl hh₂'_m1
      have hh₂_sq_r : rmdJetBnd r (21 * (2 : ℝ) ^ r / (q : ℝ) ^ 2) (fun y => h₂_fn y ^ 2) := by
        have hsq : (fun y => h₂_fn y ^ 2) = fun y => h₂_fn y * h₂_fn y := by funext y; ring
        rw [hsq]
        have hle : (2 : ℝ) ^ r * (9 / (2 * (q : ℝ))) * (9 / (2 * (q : ℝ))) ≤
            21 * (2 : ℝ) ^ r / (q : ℝ) ^ 2 := by
          have : (2 : ℝ) ^ r * (9 / (2 * (q : ℝ))) * (9 / (2 * (q : ℝ))) =
              ((81 / 4 : ℝ) * (2 : ℝ) ^ r) / (q : ℝ) ^ 2 := by ring
          rw [this]
          apply div_le_div_of_nonneg_right _ (sq_nonneg _)
          have hp : (0 : ℝ) ≤ (2 : ℝ) ^ r := by positivity
          linarith
        exact h_jet_mono le_rfl hle (h_jet_mul hh₂_r hh₂_r)
      have hh₂h₂'_r : rmdJetBnd r ((2 : ℝ) ^ r / (q : ℝ) ^ 2) (fun y => h₂_fn y * deriv h₂_fn y) := by
        have hle : (2 : ℝ) ^ r * (9 / (2 * (q : ℝ))) * (1 / (8 * (q : ℝ))) ≤
            (2 : ℝ) ^ r / (q : ℝ) ^ 2 := by
          have : (2 : ℝ) ^ r * (9 / (2 * (q : ℝ))) * (1 / (8 * (q : ℝ))) =
              ((9 / 16 : ℝ) * (2 : ℝ) ^ r) / (q : ℝ) ^ 2 := by ring
          rw [this]
          apply div_le_div_of_nonneg_right _ (sq_nonneg _)
          have hp : (0 : ℝ) ≤ (2 : ℝ) ^ r := by positivity
          linarith
        exact h_jet_mono le_rfl hle (h_jet_mul hh₂_r hh₂'_r)
      have hh_sq_diff_r : rmdJetBnd r ((5 * (2 : ℝ) ^ r / (q : ℝ) ^ 2) * Λ)
          (fun y => h₁_fn y ^ 2 - h₂_fn y ^ 2) := by
        have hEq : (fun y => h₁_fn y ^ 2 - h₂_fn y ^ 2) =
            fun y => (h₁_fn y - h₂_fn y) * (h₁_fn y + h₂_fn y) := by funext y; ring
        rw [hEq]
        have hsum_h : rmdJetBnd r (9 / (q : ℝ)) (fun y => h₁_fn y + h₂_fn y) :=
          h_jet_mono le_rfl (by ring_nf; rfl) (h_jet_add hh₁_r hh₂_r)
        have hm := h_jet_mul (h_jet_mono (by omega) le_rfl hh_diff_m2) hsum_h
        have hle : (2 : ℝ) ^ r * (Δτ / 2) * (9 / (q : ℝ)) ≤
            (5 * (2 : ℝ) ^ r / (q : ℝ) ^ 2) * Λ := by
          have h1 : (2 : ℝ) ^ r * (Δτ / 2) * (9 / (q : ℝ)) =
              (((9 / 2 : ℝ) * (2 : ℝ) ^ r) / (q : ℝ) ^ 2) * ((q : ℝ) * Δτ) := by field_simp
          rw [h1]
          have h2 : (((9 / 2 : ℝ) * (2 : ℝ) ^ r) / (q : ℝ) ^ 2) ≤
              (5 * (2 : ℝ) ^ r) / (q : ℝ) ^ 2 := by
            apply div_le_div_of_nonneg_right _ (sq_nonneg _)
            have hp : (0 : ℝ) ≤ (2 : ℝ) ^ r := by positivity
            linarith
          have h3 : ((q : ℝ) * Δτ) ≤ Λ := by dsimp [Λ]; linarith
          exact mul_le_mul h2 h3 (by positivity) (by positivity)
        exact h_jet_mono le_rfl hle hm
      have hhh'_diff_r : rmdJetBnd r ((3 * (2 : ℝ) ^ r / (q : ℝ) ^ 2) * Λ)
          (fun y => h₁_fn y * deriv h₁_fn y - h₂_fn y * deriv h₂_fn y) := by
        have hm := h_jet_mul_diff hh₂_r hh₁'_r
          (h_jet_mono (by omega) le_rfl hh_diff_m2) hh'_diff_r
        have hle : (2 : ℝ) ^ r * ((Δτ / 2) * (1 / (8 * (q : ℝ))) + (9 / (2 * (q : ℝ))) * (Δτ / 2)) ≤
            (3 * (2 : ℝ) ^ r / (q : ℝ) ^ 2) * Λ := by
          have h1 : (2 : ℝ) ^ r * ((Δτ / 2) * (1 / (8 * (q : ℝ))) + (9 / (2 * (q : ℝ))) * (Δτ / 2)) =
              (((37 / 16 : ℝ) * (2 : ℝ) ^ r) / (q : ℝ) ^ 2) * ((q : ℝ) * Δτ) := by field_simp; ring
          rw [h1]
          have h2 : (((37 / 16 : ℝ) * (2 : ℝ) ^ r) / (q : ℝ) ^ 2) ≤
              (3 * (2 : ℝ) ^ r) / (q : ℝ) ^ 2 := by
            apply div_le_div_of_nonneg_right _ (sq_nonneg _)
            have hp : (0 : ℝ) ≤ (2 : ℝ) ^ r := by positivity
            linarith
          have h3 : ((q : ℝ) * Δτ) ≤ Λ := by dsimp [Λ]; linarith
          exact mul_le_mul h2 h3 (by positivity) (by positivity)
        exact h_jet_mono le_rfl hle hm

      have h_EdK2_1 : rmdJetBnd r M_EdK2
          (fun y => Real.exp (w₁ (M₀₁_fn y) - w₁ (M₀₁_fn y + d₁_fn y)) *
            rmdK2 w₁ (M₀₁_fn y) (h₁_fn y)) := h_jet_mul hEd₁ hK2₁
      have h_EdK2_2 : rmdJetBnd r M_EdK2
          (fun y => Real.exp (w₂ (M₀₂_fn y) - w₂ (M₀₂_fn y + d₂_fn y)) *
            rmdK2 w₂ (M₀₂_fn y) (h₂_fn y)) := h_jet_mul hEd₂ hK2₂
      have h_EdK1_1 : rmdJetBnd r M_EdK1
          (fun y => Real.exp (w₁ (M₀₁_fn y) - w₁ (M₀₁_fn y + d₁_fn y)) *
            rmdK1 w₁ (M₀₁_fn y) (h₁_fn y)) := h_jet_mul hEd₁ hK1₁
      have h_EdK2_diff : rmdJetBnd r (D_EdK2 * Λ)
          (fun y => Real.exp (w₁ (M₀₁_fn y) - w₁ (M₀₁_fn y + d₁_fn y)) * rmdK2 w₁ (M₀₁_fn y) (h₁_fn y) -
            Real.exp (w₂ (M₀₂_fn y) - w₂ (M₀₂_fn y + d₂_fn y)) * rmdK2 w₂ (M₀₂_fn y) (h₂_fn y)) :=
        h_jet_mono le_rfl (by dsimp [D_EdK2]; linarith)
          (h_jet_mul_diff hEd₂ hK2₁ hEd_diff hK2_diff)
      have h_EdK1_diff : rmdJetBnd r (D_EdK1 * Λ)
          (fun y => Real.exp (w₁ (M₀₁_fn y) - w₁ (M₀₁_fn y + d₁_fn y)) * rmdK1 w₁ (M₀₁_fn y) (h₁_fn y) -
            Real.exp (w₂ (M₀₂_fn y) - w₂ (M₀₂_fn y + d₂_fn y)) * rmdK1 w₂ (M₀₂_fn y) (h₂_fn y)) :=
        h_jet_mono le_rfl (by dsimp [D_EdK1]; linarith)
          (h_jet_mul_diff hEd₂ hK1₁ hEd_diff hK1_diff)

      have h_t1a_diff := h_jet_mul_diff hh₂_sq_r h_EdK2_1 hh_sq_diff_r h_EdK2_diff
      have h_t1b_diff := h_jet_mul_diff hd₂_single hKlin₁ hd_diff_r hKlin_diff
      let P₁ : ℝ → ℝ := fun y =>
        h₁_fn y ^ 2 * (Real.exp (w₁ (M₀₁_fn y) - w₁ (M₀₁_fn y + d₁_fn y)) * rmdK2 w₁ (M₀₁_fn y) (h₁_fn y)) +
        d₁_fn y * rmdKlin w₁ (M₀₁_fn y) (d₁_fn y)
      let P₂ : ℝ → ℝ := fun y =>
        h₂_fn y ^ 2 * (Real.exp (w₂ (M₀₂_fn y) - w₂ (M₀₂_fn y + d₂_fn y)) * rmdK2 w₂ (M₀₂_fn y) (h₂_fn y)) +
        d₂_fn y * rmdKlin w₂ (M₀₂_fn y) (d₂_fn y)
      have hP₂_bnd : rmdJetBnd r (M_P12 / (q : ℝ) ^ 2) P₂ := by
        have hp2 := h_jet_add (h_jet_mul hh₂_sq_r h_EdK2_2) (h_jet_mul hd₂_single hKlin₂)
        have hEq_b : (2 : ℝ) ^ r * (21 * (2 : ℝ) ^ r / (q : ℝ) ^ 2) * M_EdK2 +
            (2 : ℝ) ^ r * (C_single / (q : ℝ) ^ 2) * M_K1 = M_P12 / (q : ℝ) ^ 2 := by
          dsimp [M_P12]; ring
        exact h_jet_mono le_rfl hEq_b.le hp2
      have hP_diff : rmdJetBnd r (D_P12 * Λ / (q : ℝ) ^ 2) (fun y => P₁ y - P₂ y) := by
        have hEq_fn : (fun y => P₁ y - P₂ y) = fun y =>
            (h₁_fn y ^ 2 * (Real.exp (w₁ (M₀₁_fn y) - w₁ (M₀₁_fn y + d₁_fn y)) * rmdK2 w₁ (M₀₁_fn y) (h₁_fn y)) -
             h₂_fn y ^ 2 * (Real.exp (w₂ (M₀₂_fn y) - w₂ (M₀₂_fn y + d₂_fn y)) * rmdK2 w₂ (M₀₂_fn y) (h₂_fn y))) +
            (d₁_fn y * rmdKlin w₁ (M₀₁_fn y) (d₁_fn y) - d₂_fn y * rmdKlin w₂ (M₀₂_fn y) (d₂_fn y)) := by
          funext y; dsimp [P₁, P₂]; ring
        rw [hEq_fn]
        have hsum := h_jet_add h_t1a_diff h_t1b_diff
        have hEq_b :
            (2 : ℝ) ^ r * (((5 * (2 : ℝ) ^ r / (q : ℝ) ^ 2) * Λ) * M_EdK2 +
              (21 * (2 : ℝ) ^ r / (q : ℝ) ^ 2) * (D_EdK2 * Λ)) +
            (2 : ℝ) ^ r * ((L_r * Λ / (q : ℝ) ^ 2) * M_K1 +
              (C_single / (q : ℝ) ^ 2) * (D_K1 * Λ)) =
            D_P12 * Λ / (q : ℝ) ^ 2 := by
          dsimp [D_P12]; ring
        exact h_jet_mono le_rfl hEq_b.le hsum

      have hM₀₁'_r : rmdJetBnd r 2 (deriv M₀₁_fn) := h_jet_mono hr le_rfl hM₀₁'_m1
      have h_main1 := h_jet_mul_diff hP₂_bnd hM₀₁'_r hP_diff hM₀'_diff_r
      have h_main2 := h_jet_mul_diff hh₂h₂'_r h_EdK1_1 hhh'_diff_r h_EdK1_diff
      have h_ode_diff_raw := h_jet_add h_main1 h_main2
      have h_ode_eq_fn :
          (fun y =>
            (P₁ y * deriv M₀₁_fn y - P₂ y * deriv M₀₂_fn y) +
            ((h₁_fn y * deriv h₁_fn y) *
               (Real.exp (w₁ (M₀₁_fn y) - w₁ (M₀₁_fn y + d₁_fn y)) * rmdK1 w₁ (M₀₁_fn y) (h₁_fn y)) -
             (h₂_fn y * deriv h₂_fn y) *
               (Real.exp (w₂ (M₀₂_fn y) - w₂ (M₀₂_fn y + d₂_fn y)) * rmdK1 w₂ (M₀₂_fn y) (h₂_fn y)))) =
          deriv (fun y => d₁_fn y - d₂_fn y) := by
        funext y
        have h_ne0 : ((m + 2 : ℕ) : WithTop ℕ∞) ≠ 0 := by simp
        have hd1 := (hd₁_cd.differentiable h_ne0).differentiableAt.hasDerivAt (x := y)
        have hd2 := (hd₂_cd.differentiable h_ne0).differentiableAt.hasDerivAt (x := y)
        have hd_sub : deriv (fun z => d₁_fn z - d₂_fn z) y = deriv d₁_fn y - deriv d₂_fn y :=
          (hd1.sub hd2).deriv
        rw [hd_sub, hOde₁ u_param y, hOde₂ u_param y]
        dsimp [rmdOdeRhs, P₁, P₂]
        ring
      rw [h_ode_eq_fn] at h_ode_diff_raw

      have hL1_pos : 0 < rmdLipSeq M₁ C_single L₀_mid (r + 1) := h_lip_seq_pos (r + 1)
      refine ⟨(hd₁_cd.sub hd₂_cd).of_le (by norm_cast), by positivity, ?_⟩
      intro j hj x
      by_cases hj_le : j ≤ r
      · have h1 := hd_diff_r.2.2 j hj_le x
        have h_mono : L_r * Λ / (q : ℝ) ^ 2 ≤
            rmdLipSeq M₁ C_single L₀_mid (r + 1) * Λ / (q : ℝ) ^ 2 := by
          apply div_le_div_of_nonneg_right _ (sq_nonneg _)
          exact mul_le_mul_of_nonneg_right (le_max_left _ _) hΛ_nonneg
        exact le_trans h1 h_mono
      · have hj_eq : j = r + 1 := by omega
        subst hj_eq
        rw [iteratedDeriv_succ']
        have hb := h_ode_diff_raw.2.2 r le_rfl x
        have h_bnd_eq :
            (2 : ℝ) ^ r * ((D_P12 * Λ / (q : ℝ) ^ 2) * 2 + (M_P12 / (q : ℝ) ^ 2) * (1 * Λ)) +
            (2 : ℝ) ^ r * (((3 * (2 : ℝ) ^ r / (q : ℝ) ^ 2) * Λ) * M_EdK1 +
              ((2 : ℝ) ^ r / (q : ℝ) ^ 2) * (D_EdK1 * Λ)) =
            L_step * Λ / (q : ℝ) ^ 2 := by
          dsimp [L_step]; ring
        have h_step_le : L_step * Λ / (q : ℝ) ^ 2 ≤
            rmdLipSeq M₁ C_single L₀_mid (r + 1) * Λ / (q : ℝ) ^ 2 := by
          simp only [rmdLipSeq]
          apply div_le_div_of_nonneg_right _ (sq_nonneg _)
          exact mul_le_mul_of_nonneg_right (le_max_right L_r L_step) hΛ_nonneg
        exact le_trans hb (h_bnd_eq.le.trans h_step_le)

  let C_lip : ℝ := rmdLipSeq M₁ C_single L₀_mid (m + 2)
  have hC_lip_pos : 0 < C_lip := h_lip_seq_pos (m + 2)
  let C_mid_R : ℝ := max C_single C_lip
  refine ⟨{
    C_mid_R := C_mid_R
    N_mid := 4
    C_mid_R_pos := lt_max_of_lt_left hC_single_pos
    N_mid_ge_four := le_rfl
    midpoint_u_props := ?_
    midpoint_u_lip := ?_
  }⟩
  · intro q ρ c_T w e_X τ_T hq hc_T hw he_X hτ_T
    obtain ⟨hJoint, hPer, _⟩ := h_qual_and_ode q ρ c_T w e_X τ_T hw he_X hτ_T
    refine ⟨?_, ?_⟩
    · intro k hk
      exact (h_slice_contDiff k (m + 2)
        (fun p : ℝ × ℝ =>
          realMidpointDispU w (fun x => x + ρ + e_X x) (fun x => c_T + τ_T x) p.1 p.2)
        hk hJoint).continuous
    · intro u_param hu
      have hd_m2 := h_single_ind (m + 2) le_rfl q ρ c_T u_param w e_X τ_T hq hc_T hu hw he_X hτ_T
      refine ⟨hPer u_param, hd_m2.1, ?_⟩
      intro k hk x
      have hq2_pos : (0 : ℝ) < (q : ℝ) ^ 2 := by
        have : (0 : ℝ) < (q : ℝ) := by exact_mod_cast (by omega : 0 < q)
        positivity
      have h1 : (q : ℝ) ^ 2 *
          |iteratedDeriv k
            (realMidpointDispU w (fun x => x + ρ + e_X x) (fun x => c_T + τ_T x) u_param) x| ≤
          C_single :=
        (le_div_iff₀' hq2_pos).mp (hd_m2.2.2 k hk x)
      exact le_trans h1 (le_max_left C_single C_lip)
  · intro q ρ c_T Δe Δτ u_param w₁ w₂ e_X₁ τ_T₁ e_X₂ τ_T₂
      hq hc_T hu hΔe hΔτ hw₁ hw₂ he_X₁ hτ_T₁ he_X₂ hτ_T₂ hde hdτ
    dsimp only
    intro k hk x
    have hq2_pos : (0 : ℝ) < (q : ℝ) ^ 2 := by
      have : (0 : ℝ) < (q : ℝ) := by exact_mod_cast (by omega : 0 < q)
      positivity
    have hDw_nonneg := (H_base.diff_global_bound w₁ w₂ hw₁ hw₂).1
    have hΛ_nonneg : 0 ≤ Δe + (q : ℝ) * Δτ + realDiffSup (m + 15) w₁ w₂ := by positivity
    have hlip_m2 := h_lip_ind (m + 2) le_rfl q ρ c_T Δe Δτ u_param w₁ w₂
      e_X₁ τ_T₁ e_X₂ τ_T₂ hq hc_T hu hΔe hΔτ hw₁ hw₂ he_X₁ hτ_T₁ he_X₂ hτ_T₂ hde hdτ
    have h1 := (le_div_iff₀' hq2_pos).mp (hlip_m2.2.2 k hk x)
    exact le_trans h1 (mul_le_mul_of_nonneg_right (le_max_right C_single C_lip) hΛ_nonneg)

theorem real_action_jet_comp_bounds (m : ℕ) (M₁ : ℝ)
    (hm : 2 ≤ m) (hM₁ : 0 < M₁)
    (H_base : RealActionTaylorData m M₁)
    (H_mid : RealMidpointDispData m M₁) :
    Nonempty (RealActionJetCompData m M₁) :=
by
  
  
  
  have hTK : RjCalcToolkit_rajcb := by
    have h_compConst_ge_one : ∀ (p : ℕ) (B : ℝ), 1 ≤ rjCompConst_rajcb p B := by
      intro p B
      induction p with
      | zero => exact le_rfl
      | succ n ih =>
        simp only [rjCompConst_rajcb]
        exact one_le_mul_of_one_le_of_one_le (le_max_left _ _) ih
    have h_compConst_max_zero : ∀ (p : ℕ) (B : ℝ),
        rjCompConst_rajcb p (max B 0) = rjCompConst_rajcb p B := by
      intro p B
      induction p with
      | zero => rfl
      | succ n ih =>
        simp only [rjCompConst_rajcb, max_assoc, max_self, ih]
    have h_congr : ∀ {α : Type} [TopologicalSpace α] {S : Set α} {p : ℕ} {B : ℝ}
        {F₁ F₂ : α → ℝ → ℝ},
        (∀ a ∈ S, ∀ x : ℝ, F₁ a x = F₂ a x) →
        IsParamJetBounded_rajcb S p B F₁ → IsParamJetBounded_rajcb S p B F₂ := by
      intro α _ S p B F₁ F₂ hEq hF
      have hFun : ∀ a ∈ S, F₂ a = F₁ a := fun a ha => funext fun x => (hEq a ha x).symm
      refine ⟨fun a ha => hFun a ha ▸ hF.1 a ha, ?_, ?_⟩
      · intro k hk
        refine (hF.2.1 k hk).congr ?_
        intro q hq
        dsimp only
        rw [hFun q.1 hq.1]
      · intro a ha k hk x
        rw [hFun a ha]
        exact hF.2.2 a ha k hk x
    have h_congr_inner : ∀ {α : Type} [TopologicalSpace α] {S : Set α} {p : ℕ} {B : ℝ}
        {Φ₁ Φ₂ : α → ℝ → ℝ},
        (∀ a ∈ S, ∀ x : ℝ, Φ₁ a x = Φ₂ a x) →
        IsParamUnboundedInner_rajcb S p B Φ₁ → IsParamUnboundedInner_rajcb S p B Φ₂ := by
      intro α _ S p B Φ₁ Φ₂ hEq hΦ
      have hFun : ∀ a ∈ S, Φ₂ a = Φ₁ a := fun a ha => funext fun x => (hEq a ha x).symm
      refine ⟨fun a ha => hFun a ha ▸ hΦ.1 a ha, ?_, ?_⟩
      · intro k hk
        refine (hΦ.2.1 k hk).congr ?_
        intro q hq
        dsimp only
        rw [hFun q.1 hq.1]
      · intro a ha j hj1 hjp x
        rw [hFun a ha]
        exact hΦ.2.2 a ha j hj1 hjp x
    have h_mono : ∀ {α : Type} [TopologicalSpace α] {S : Set α} {p : ℕ} {B₁ B₂ : ℝ}
        {F : α → ℝ → ℝ},
        B₁ ≤ B₂ → IsParamJetBounded_rajcb S p B₁ F → IsParamJetBounded_rajcb S p B₂ F := by
      intro α _ S p B₁ B₂ F hB hF
      exact ⟨hF.1, hF.2.1, fun a ha k hk x => le_trans (hF.2.2 a ha k hk x) hB⟩
    have h_param_const : ∀ {α : Type} [TopologicalSpace α] {S : Set α} (p : ℕ) {B : ℝ}
        {c : α → ℝ},
        0 ≤ B → ContinuousOn c S → (∀ a ∈ S, |c a| ≤ B) →
        IsParamJetBounded_rajcb S p B (fun a _ => c a) := by
      intro α _ S p B c hB hc hcb
      refine ⟨fun _ _ => contDiff_const, ?_, ?_⟩
      · intro k _
        cases k with
        | zero =>
          have h0 : ContinuousOn (fun q : α × ℝ => c q.1) (S ×ˢ Set.univ) :=
            hc.comp continuous_fst.continuousOn (fun q hq => hq.1)
          exact h0.congr (fun q _ => by simp)
        | succ n =>
          exact (continuousOn_const (c := (0 : ℝ))).congr
            (fun q _ => by simp [iteratedDeriv_const])
      · intro a ha k _ x
        cases k with
        | zero => simpa using hcb a ha
        | succ n => simp [iteratedDeriv_const, hB]
    have h_add : ∀ {α : Type} [TopologicalSpace α] {S : Set α} {p : ℕ} {B₁ B₂ : ℝ}
        {F₁ F₂ : α → ℝ → ℝ},
        IsParamJetBounded_rajcb S p B₁ F₁ → IsParamJetBounded_rajcb S p B₂ F₂ →
        IsParamJetBounded_rajcb S p (B₁ + B₂) (fun a x => F₁ a x + F₂ a x) := by
      intro α _ S p B₁ B₂ F₁ F₂ hF₁ hF₂
      have hId : ∀ a ∈ S, ∀ k ≤ p, ∀ x : ℝ,
          iteratedDeriv k (fun y => F₁ a y + F₂ a y) x =
            iteratedDeriv k (F₁ a) x + iteratedDeriv k (F₂ a) x := by
        intro a ha k hk x
        exact iteratedDeriv_fun_add
          ((hF₁.1 a ha).contDiffAt.of_le (by exact_mod_cast hk))
          ((hF₂.1 a ha).contDiffAt.of_le (by exact_mod_cast hk))
      refine ⟨fun a ha => (hF₁.1 a ha).add (hF₂.1 a ha), ?_, ?_⟩
      · intro k hk
        exact ((hF₁.2.1 k hk).add (hF₂.2.1 k hk)).congr (fun q hq => hId q.1 hq.1 k hk q.2)
      · intro a ha k hk x
        rw [hId a ha k hk x]
        exact le_trans (abs_add_le _ _) (add_le_add (hF₁.2.2 a ha k hk x) (hF₂.2.2 a ha k hk x))
    have h_sub : ∀ {α : Type} [TopologicalSpace α] {S : Set α} {p : ℕ} {B₁ B₂ : ℝ}
        {F₁ F₂ : α → ℝ → ℝ},
        IsParamJetBounded_rajcb S p B₁ F₁ → IsParamJetBounded_rajcb S p B₂ F₂ →
        IsParamJetBounded_rajcb S p (B₁ + B₂) (fun a x => F₁ a x - F₂ a x) := by
      intro α _ S p B₁ B₂ F₁ F₂ hF₁ hF₂
      have hId : ∀ a ∈ S, ∀ k ≤ p, ∀ x : ℝ,
          iteratedDeriv k (fun y => F₁ a y - F₂ a y) x =
            iteratedDeriv k (F₁ a) x - iteratedDeriv k (F₂ a) x := by
        intro a ha k hk x
        exact iteratedDeriv_fun_sub
          ((hF₁.1 a ha).contDiffAt.of_le (by exact_mod_cast hk))
          ((hF₂.1 a ha).contDiffAt.of_le (by exact_mod_cast hk))
      refine ⟨fun a ha => (hF₁.1 a ha).sub (hF₂.1 a ha), ?_, ?_⟩
      · intro k hk
        exact ((hF₁.2.1 k hk).sub (hF₂.2.1 k hk)).congr (fun q hq => hId q.1 hq.1 k hk q.2)
      · intro a ha k hk x
        rw [hId a ha k hk x]
        exact le_trans (abs_sub _ _) (add_le_add (hF₁.2.2 a ha k hk x) (hF₂.2.2 a ha k hk x))
    have h_neg : ∀ {α : Type} [TopologicalSpace α] {S : Set α} {p : ℕ} {B : ℝ}
        {F : α → ℝ → ℝ},
        IsParamJetBounded_rajcb S p B F → IsParamJetBounded_rajcb S p B (fun a x => -F a x) := by
      intro α _ S p B F hF
      refine ⟨fun a ha => (hF.1 a ha).neg, ?_, ?_⟩
      · intro k hk
        exact (hF.2.1 k hk).neg.congr (fun q _ => iteratedDeriv_fun_neg k (F q.1) q.2)
      · intro a ha k hk x
        rw [iteratedDeriv_fun_neg, abs_neg]
        exact hF.2.2 a ha k hk x
    have h_param_mul : ∀ {α : Type} [TopologicalSpace α] {S : Set α} {p : ℕ} {C B : ℝ}
        {c : α → ℝ} {F : α → ℝ → ℝ},
        0 ≤ C → 0 ≤ B → ContinuousOn c S → (∀ a ∈ S, |c a| ≤ C) →
        IsParamJetBounded_rajcb S p B F →
        IsParamJetBounded_rajcb S p (C * B) (fun a x => c a * F a x) := by
      intro α _ S p C B c F hC _ hc hcb hF
      have hId : ∀ a ∈ S, ∀ k ≤ p, ∀ x : ℝ,
          iteratedDeriv k (fun y => c a * F a y) x = c a * iteratedDeriv k (F a) x := by
        intro a ha k hk x
        exact iteratedDeriv_const_mul (c a) ((hF.1 a ha).contDiffAt.of_le (by exact_mod_cast hk))
      refine ⟨fun a ha => contDiff_const.mul (hF.1 a ha), ?_, ?_⟩
      · intro k hk
        have hc' : ContinuousOn (fun q : α × ℝ => c q.1) (S ×ˢ Set.univ) :=
          hc.comp continuous_fst.continuousOn (fun q hq => hq.1)
        exact (hc'.mul (hF.2.1 k hk)).congr (fun q hq => hId q.1 hq.1 k hk q.2)
      · intro a ha k hk x
        rw [hId a ha k hk x, abs_mul]
        exact mul_le_mul (hcb a ha) (hF.2.2 a ha k hk x) (abs_nonneg _) hC
    have h_mul : ∀ {α : Type} [TopologicalSpace α] {S : Set α} {p : ℕ} {B₁ B₂ : ℝ}
        {F₁ F₂ : α → ℝ → ℝ},
        0 ≤ B₁ → 0 ≤ B₂ →
        IsParamJetBounded_rajcb S p B₁ F₁ → IsParamJetBounded_rajcb S p B₂ F₂ →
        IsParamJetBounded_rajcb S p ((2 : ℝ) ^ p * B₁ * B₂) (fun a x => F₁ a x * F₂ a x) := by
      intro α _ S p B₁ B₂ F₁ F₂ hB₁ hB₂ hF₁ hF₂
      have hId : ∀ a ∈ S, ∀ k ≤ p, ∀ x : ℝ,
          iteratedDeriv k (fun y => F₁ a y * F₂ a y) x =
            ∑ i ∈ Finset.range (k + 1),
              (k.choose i : ℝ) * iteratedDeriv i (F₁ a) x * iteratedDeriv (k - i) (F₂ a) x := by
        intro a ha k hk x
        exact iteratedDeriv_fun_mul
          ((hF₁.1 a ha).contDiffAt.of_le (by exact_mod_cast hk))
          ((hF₂.1 a ha).contDiffAt.of_le (by exact_mod_cast hk))
      refine ⟨fun a ha => (hF₁.1 a ha).mul (hF₂.1 a ha), ?_, ?_⟩
      · intro k hk
        have hSumCont : ContinuousOn
            (fun q : α × ℝ => ∑ i ∈ Finset.range (k + 1),
              (k.choose i : ℝ) * iteratedDeriv i (F₁ q.1) q.2 *
                iteratedDeriv (k - i) (F₂ q.1) q.2)
            (S ×ˢ Set.univ) := by
          apply continuousOn_finsetSum
          intro i hi
          have hi_le : i ≤ p := le_trans (Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)) hk
          have hki_le : k - i ≤ p := le_trans (Nat.sub_le k i) hk
          exact (continuousOn_const.mul (hF₁.2.1 i hi_le)).mul (hF₂.2.1 (k - i) hki_le)
        exact hSumCont.congr (fun q hq => hId q.1 hq.1 k hk q.2)
      · intro a ha k hk x
        rw [hId a ha k hk x]
        calc |∑ i ∈ Finset.range (k + 1),
                (k.choose i : ℝ) * iteratedDeriv i (F₁ a) x * iteratedDeriv (k - i) (F₂ a) x|
            ≤ ∑ i ∈ Finset.range (k + 1),
                |(k.choose i : ℝ) * iteratedDeriv i (F₁ a) x * iteratedDeriv (k - i) (F₂ a) x| :=
              Finset.abs_sum_le_sum_abs _ _
          _ ≤ ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * (B₁ * B₂) := by
              apply Finset.sum_le_sum
              intro i hi
              have hi_le : i ≤ p := le_trans (Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)) hk
              have hki_le : k - i ≤ p := le_trans (Nat.sub_le k i) hk
              rw [abs_mul, abs_mul, abs_of_nonneg (Nat.cast_nonneg _), mul_assoc]
              exact mul_le_mul_of_nonneg_left
                (mul_le_mul (hF₁.2.2 a ha i hi_le x) (hF₂.2.2 a ha (k - i) hki_le x)
                  (abs_nonneg _) hB₁)
                (Nat.cast_nonneg _)
          _ = (∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ)) * (B₁ * B₂) := by
              rw [← Finset.sum_mul]
          _ = (2 : ℝ) ^ k * B₁ * B₂ := by
              have hchoose : (∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ)) = (2 : ℝ) ^ k := by
                exact_mod_cast Nat.sum_range_choose k
              rw [hchoose, mul_assoc]
          _ ≤ (2 : ℝ) ^ p * B₁ * B₂ := by
              have hpow : (2 : ℝ) ^ k ≤ (2 : ℝ) ^ p :=
                pow_le_pow_right₀ (by norm_num) hk
              have hBB : 0 ≤ B₁ * B₂ := mul_nonneg hB₁ hB₂
              nlinarith
    have h_pullback : ∀ {α β : Type} [TopologicalSpace α] [TopologicalSpace β]
        {S : Set α} {T : Set β} {p : ℕ} {B : ℝ} {φ : β → α} {F : α → ℝ → ℝ},
        ContinuousOn φ T → Set.MapsTo φ T S →
        IsParamJetBounded_rajcb S p B F →
        IsParamJetBounded_rajcb T p B (fun b x => F (φ b) x) := by
      intro α β _ _ S T p B φ F hφ hMaps hF
      refine ⟨fun b hb => hF.1 (φ b) (hMaps hb), ?_,
        fun b hb k hk x => hF.2.2 (φ b) (hMaps hb) k hk x⟩
      intro k hk
      exact (hF.2.1 k hk).comp (hφ.prodMap continuousOn_id) (fun q hq => ⟨hMaps hq.1, trivial⟩)
    have h_pullback_inner : ∀ {α β : Type} [TopologicalSpace α] [TopologicalSpace β]
        {S : Set α} {T : Set β} {p : ℕ} {B : ℝ} {φ : β → α} {Φ : α → ℝ → ℝ},
        ContinuousOn φ T → Set.MapsTo φ T S →
        IsParamUnboundedInner_rajcb S p B Φ →
        IsParamUnboundedInner_rajcb T p B (fun b x => Φ (φ b) x) := by
      intro α β _ _ S T p B φ Φ hφ hMaps hΦ
      refine ⟨fun b hb => hΦ.1 (φ b) (hMaps hb), ?_,
        fun b hb j hj1 hjp x => hΦ.2.2 (φ b) (hMaps hb) j hj1 hjp x⟩
      intro k hk
      exact (hΦ.2.1 k hk).comp (hφ.prodMap continuousOn_id) (fun q hq => ⟨hMaps hq.1, trivial⟩)
    have h_inner_of_bounded : ∀ {α : Type} [TopologicalSpace α] {S : Set α} {p : ℕ} {B : ℝ}
        {F : α → ℝ → ℝ},
        IsParamJetBounded_rajcb S p B F → IsParamUnboundedInner_rajcb S p B F := by
      intro α _ S p B F hF
      exact ⟨hF.1, hF.2.1, fun a ha j _ hjp x => hF.2.2 a ha j hjp x⟩
    have h_inner_add : ∀ {α : Type} [TopologicalSpace α] {S : Set α} {p : ℕ} {B₁ B₂ : ℝ}
        {Φ₁ Φ₂ : α → ℝ → ℝ},
        IsParamUnboundedInner_rajcb S p B₁ Φ₁ → IsParamUnboundedInner_rajcb S p B₂ Φ₂ →
        IsParamUnboundedInner_rajcb S p (B₁ + B₂) (fun a x => Φ₁ a x + Φ₂ a x) := by
      intro α _ S p B₁ B₂ Φ₁ Φ₂ hΦ₁ hΦ₂
      have hId : ∀ a ∈ S, ∀ k ≤ p, ∀ x : ℝ,
          iteratedDeriv k (fun y => Φ₁ a y + Φ₂ a y) x =
            iteratedDeriv k (Φ₁ a) x + iteratedDeriv k (Φ₂ a) x := by
        intro a ha k hk x
        exact iteratedDeriv_fun_add
          ((hΦ₁.1 a ha).contDiffAt.of_le (by exact_mod_cast hk))
          ((hΦ₂.1 a ha).contDiffAt.of_le (by exact_mod_cast hk))
      refine ⟨fun a ha => (hΦ₁.1 a ha).add (hΦ₂.1 a ha), ?_, ?_⟩
      · intro k hk
        exact ((hΦ₁.2.1 k hk).add (hΦ₂.2.1 k hk)).congr (fun q hq => hId q.1 hq.1 k hk q.2)
      · intro a ha j hj1 hjp x
        rw [hId a ha j hjp x]
        exact le_trans (abs_add_le _ _)
          (add_le_add (hΦ₁.2.2 a ha j hj1 hjp x) (hΦ₂.2.2 a ha j hj1 hjp x))
    have h_comp_bound : ∀ (p : ℕ) {α : Type} [TopologicalSpace α] {S : Set α} {M_g B : ℝ}
        {g : ℝ → ℝ} {Φ : α → ℝ → ℝ},
        ContDiff ℝ (p : WithTop ℕ∞) g →
        IsParamUnboundedInner_rajcb S p B Φ →
        0 ≤ M_g →
        (∀ j : ℕ, j ≤ p → ∀ a ∈ S, ∀ x : ℝ, |iteratedDeriv j g (Φ a x)| ≤ M_g) →
        IsParamJetBounded_rajcb S p (M_g * rjCompConst_rajcb p B) (fun a x => g (Φ a x)) := by
      intro p
      induction p with
      | zero =>
        intro α _ S M_g B g Φ hg hΦ _ hMg
        refine ⟨fun a ha => hg.comp (hΦ.1 a ha), ?_, ?_⟩
        · intro k hk
          have hk0 : k = 0 := Nat.le_zero.mp hk
          subst hk0
          exact (hg.continuous.comp_continuousOn (hΦ.2.1 0 le_rfl)).congr (fun _ _ => rfl)
        · intro a ha k hk x
          have hk0 : k = 0 := Nat.le_zero.mp hk
          subst hk0
          simpa [rjCompConst_rajcb] using hMg 0 le_rfl a ha x
      | succ n ih =>
        intro α _ S M_g B g Φ hg hΦ hMg_nn hMg
        have hg_diff : Differentiable ℝ g := hg.differentiable (by simp)
        have hdg : ContDiff ℝ (n : WithTop ℕ∞) (deriv g) :=
          (contDiff_succ_iff_deriv.mp hg).2.2
        have hΦ_n : IsParamUnboundedInner_rajcb S n B Φ :=
          ⟨fun a ha => (hΦ.1 a ha).of_le (by norm_cast; omega),
           fun k hk => hΦ.2.1 k (Nat.le_succ_of_le hk),
           fun a ha j hj1 hjn x => hΦ.2.2 a ha j hj1 (Nat.le_succ_of_le hjn) x⟩
        have hMg_dg : ∀ j : ℕ, j ≤ n → ∀ a ∈ S, ∀ x : ℝ,
            |iteratedDeriv j (deriv g) (Φ a x)| ≤ M_g := by
          intro j hj a ha x
          rw [← iteratedDeriv_succ']
          exact hMg (j + 1) (Nat.succ_le_succ hj) a ha x
        have hIH := ih hdg hΦ_n hMg_nn hMg_dg
        have hΨ : IsParamJetBounded_rajcb S n (max B 0) (fun a x => deriv (Φ a) x) := by
          refine ⟨fun a ha => (contDiff_succ_iff_deriv.mp (hΦ.1 a ha)).2.2, ?_, ?_⟩
          · intro i hi
            refine (hΦ.2.1 (i + 1) (Nat.succ_le_succ hi)).congr ?_
            intro q _
            dsimp only
            rw [← iteratedDeriv_succ']
          · intro a ha i hi x
            rw [← iteratedDeriv_succ']
            exact le_trans (hΦ.2.2 a ha (i + 1) (Nat.succ_le_succ (Nat.zero_le _))
              (Nat.succ_le_succ hi) x) (le_max_left _ _)
        have hMul := h_mul
          (mul_nonneg hMg_nn (le_trans zero_le_one (h_compConst_ge_one n B)))
          (le_max_right B 0) hIH hΨ
        have hDerivEq : ∀ a ∈ S, deriv (fun y => g (Φ a y)) =
            fun y => deriv g (Φ a y) * deriv (Φ a) y := by
          intro a ha
          ext y
          exact deriv_comp y hg_diff.differentiableAt
            ((hΦ.1 a ha).differentiable (by simp)).differentiableAt
        have hDerivJet : IsParamJetBounded_rajcb S n
            ((2 : ℝ) ^ n * (M_g * rjCompConst_rajcb n B) * max B 0)
            (fun a x => deriv (fun y => g (Φ a y)) x) :=
          h_congr (fun a ha x => (congrFun (hDerivEq a ha) x).symm) hMul
        refine ⟨fun a ha => hg.comp (hΦ.1 a ha), ?_, ?_⟩
        · intro k hk
          cases k with
          | zero =>
            exact (hg.continuous.comp_continuousOn (hΦ.2.1 0 (Nat.zero_le _))).congr (fun _ _ => rfl)
          | succ i =>
            have hi : i ≤ n := Nat.le_of_succ_le_succ hk
            refine (hDerivJet.2.1 i hi).congr ?_
            intro q _
            dsimp only
            rw [iteratedDeriv_succ']
        · intro a ha k hk x
          cases k with
          | zero =>
            have h0 := hMg 0 (Nat.zero_le _) a ha x
            have hge1 := h_compConst_ge_one (n + 1) B
            calc |iteratedDeriv 0 (fun y => g (Φ a y)) x|
                ≤ M_g := h0
              _ = M_g * 1 := (mul_one _).symm
              _ ≤ M_g * rjCompConst_rajcb (n + 1) B :=
                  mul_le_mul_of_nonneg_left hge1 hMg_nn
          | succ i =>
            have hi : i ≤ n := Nat.le_of_succ_le_succ hk
            rw [iteratedDeriv_succ']
            have hb := hDerivJet.2.2 a ha i hi x
            have hle_fac : (2 : ℝ) ^ n * max B 0 ≤
                max 1 ((2 : ℝ) ^ n * (max B 0 + 1)) := by
              apply le_trans _ (le_max_right 1 _)
              have h2n : (0 : ℝ) ≤ (2 : ℝ) ^ n := by positivity
              exact mul_le_mul_of_nonneg_left (by linarith) h2n
            have hC_nn : 0 ≤ rjCompConst_rajcb n B :=
              le_trans zero_le_one (h_compConst_ge_one n B)
            calc |iteratedDeriv i (deriv (fun y => g (Φ a y))) x|
                ≤ (2 : ℝ) ^ n * (M_g * rjCompConst_rajcb n B) * max B 0 := hb
              _ = M_g * (((2 : ℝ) ^ n * max B 0) * rjCompConst_rajcb n B) := by ring
              _ ≤ M_g * (max 1 ((2 : ℝ) ^ n * (max B 0 + 1)) * rjCompConst_rajcb n B) :=
                  mul_le_mul_of_nonneg_left
                    (mul_le_mul_of_nonneg_right hle_fac hC_nn) hMg_nn
              _ = M_g * rjCompConst_rajcb (n + 1) B := rfl
    have h_clamp_cont : ∀ {α : Type} [TopologicalSpace α] {S : Set α}
        {G : (α × ℝ) × ℝ → ℝ},
        ContinuousOn G ((S ×ˢ Set.Icc (0 : ℝ) 1) ×ˢ Set.univ) →
        ContinuousOn (fun q : α × ℝ => ∫ t in (0 : ℝ)..1, G ((q.1, t), q.2)) (S ×ˢ Set.univ) := by
      intro α _ S G hG
      let clamp : ℝ → ℝ := fun t => max 0 (min 1 t)
      have hclamp_cont : Continuous clamp :=
        continuous_const.max (continuous_const.min continuous_id)
      have hclamp_mem : ∀ t : ℝ, clamp t ∈ Set.Icc (0 : ℝ) 1 := fun t =>
