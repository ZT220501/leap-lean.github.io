      IsStripBounded p σ' (‖c‖ * M) (fun z => c * f z) := by
    intro p σ' M c f _hM hf
    refine ⟨hf.1.const_mul c, ?_⟩
    intro k hk z hz
    rw [iteratedDeriv_const_mul c (hContDiffAt hf.1 hz k), norm_mul]
