        c ∈ Set.Icc (-τ) (1 - τ) → η ∈ Set.Icc (0 : ℝ) 1 →
        η * c ∈ Set.Icc (-τ) (1 - τ) := by
      intro c η hc hη
      refine ⟨?_, ?_⟩
      · nlinarith [hτ.1, hc.1, hη.1, hη.2]
      · nlinarith [hτ.2, hc.2, hη.1, hη.2]
    have hSlopeCont : ContinuousOn (fun c : ℝ => skrSlopeW W z c H) (Set.Icc (-τ) (1 - τ)) := by
      unfold skrSlopeW
      refine Complex.continuous_ofReal.continuousOn.mul ?_
      refine hContOn_int01 ?_
      have hMapCont : Continuous (fun p : ℝ × ℝ => z + ((p.2 * p.1 : ℝ) : ℂ) * H) :=
        continuous_const.add
          ((Complex.continuous_ofReal.comp (continuous_snd.mul continuous_fst)).mul continuous_const)
      refine hDerivCont.comp hMapCont.continuousOn ?_
      rintro ⟨c, η⟩ ⟨hc, hη⟩
      exact hStripTauSeg σ τ (η * c) (hMulSeg hc hη) hX hμ
    have hSlopeFTC : ∀ {c : ℝ}, c ∈ Set.Icc (-τ) (1 - τ) →
        W (z + (c : ℂ) * H) - W z = H * skrSlopeW W z c H := by
      intro c hc
      let γ_c : ℝ → ℂ := fun η => z + ((η * c : ℝ) : ℂ) * H
      have hDeriv : ∀ η ∈ Set.uIcc (0 : ℝ) 1,
          HasDerivAt (fun s : ℝ => W (γ_c s)) (deriv W (γ_c η) * ((c : ℂ) * H)) η := by
        intro η hη
        rw [huIcc01] at hη
        have hmem : γ_c η ∈ horizStrip σ :=
          hStripTauSeg σ τ (η * c) (hMulSeg hc hη) hX hμ
        have hW_at : HasDerivAt W (deriv W (γ_c η)) (γ_c η) :=
          (hW.differentiableAt (hOpen.mem_nhds hmem)).hasDerivAt
        have hγ_at : HasDerivAt γ_c ((c : ℂ) * H) η := by
          have h1 : HasDerivAt (fun s : ℝ => s * c) c η := by
            simpa using (hasDerivAt_id η).mul_const c
          simpa [γ_c] using (h1.ofReal_comp.mul_const H).const_add z
        exact hW_at.comp η hγ_at
      have hContInt : ContinuousOn (fun η : ℝ => deriv W (γ_c η) * ((c : ℂ) * H))
          (Set.uIcc (0 : ℝ) 1) := by
        rw [huIcc01]
        have hγ_cont : Continuous γ_c :=
          continuous_const.add
            ((Complex.continuous_ofReal.comp (continuous_id.mul continuous_const)).mul
              continuous_const)
        refine (hDerivCont.comp hγ_cont.continuousOn ?_).mul continuousOn_const
        intro η hη
        exact hStripTauSeg σ τ (η * c) (hMulSeg hc hη) hX hμ
      have hFTC := intervalIntegral.integral_eq_sub_of_hasDerivAt hDeriv hContInt.intervalIntegrable
      rw [intervalIntegral.integral_mul_const] at hFTC
      have h1 : γ_c 1 = z + (c : ℂ) * H := by simp [γ_c]
      have h0 : γ_c 0 = z := by simp [γ_c]
      rw [h1, h0] at hFTC
      unfold skrSlopeW
      linear_combination -hFTC
    have hExpSlope : ∀ {c : ℝ} (m_s : ℂ), c ∈ Set.Icc (-τ) (1 - τ) →
        Complex.exp (m_s * W (z + (c : ℂ) * H)) =
          Complex.exp (m_s * W z) *
            (1 + H * ((m_s * skrSlopeW W z c H) * skrExp1 (H * (m_s * skrSlopeW W z c H)))) := by
      intro c m_s hc
      have hsplit : m_s * W (z + (c : ℂ) * H) =
          m_s * W z + H * (m_s * skrSlopeW W z c H) := by
        linear_combination m_s * hSlopeFTC hc
      rw [hsplit, Complex.exp_add, hTay_exp (H * (m_s * skrSlopeW W z c H))]
      ring
    set X_pt : ℂ := z - (τ : ℂ) * H
    set μ_pt : ℂ := z + ((1 - τ : ℝ) : ℂ) * H
    set ew : ℂ := Complex.exp (W z)
    set ew_inv : ℂ := Complex.exp (-W z)
    have hew_mul : ew * ew_inv = 1 := by
      dsimp only [ew, ew_inv]
      rw [← Complex.exp_add, add_neg_cancel, Complex.exp_zero]
    have hew_sq : Complex.exp (2 * W z) = ew ^ 2 := by
      dsimp only [ew]
      rw [sq, ← Complex.exp_add, two_mul]
    have hew_inv_sq : Complex.exp (-2 * W z) = ew_inv ^ 2 := by
      dsimp only [ew_inv]
      rw [sq, ← Complex.exp_add]
      congr 1
      ring
    
    let sw₁ : ℝ → ℂ := fun θ => skrSlopeW W z ((θ - 1) * τ) H
    let rI₁ : ℂ := ∫ θ in (0 : ℝ)..1, sw₁ θ * skrExp1 (H * sw₁ θ)
    let I₁ : ℂ := 1 + H * rI₁
    let u₁ : ℂ := (τ : ℂ) * H * ew * I₁
    have hc₁_mem : ∀ {θ : ℝ}, θ ∈ Set.Icc (0 : ℝ) 1 → (θ - 1) * τ ∈ Set.Icc (-τ) (1 - τ) := by
      intro θ hθ
      refine ⟨by nlinarith [hτ.1, hθ.1], by nlinarith [hτ.1, hτ.2, hθ.2]⟩
    have hsw₁_cont : ContinuousOn sw₁ (Set.Icc (0 : ℝ) 1) :=
      hSlopeCont.comp ((continuous_id.sub continuous_const).mul continuous_const).continuousOn
        (fun _ hθ => hc₁_mem hθ)
    have hg₁_cont : ContinuousOn (fun θ : ℝ => sw₁ θ * skrExp1 (H * sw₁ θ))
        (Set.uIcc (0 : ℝ) 1) := by
      rw [huIcc01]
      exact hsw₁_cont.mul (hCont_skrExp1.comp_continuousOn (continuousOn_const.mul hsw₁_cont))
    have hDelta1 : deltaPhi_ℂ W X_pt z = u₁ := by
      unfold deltaPhi_ℂ
      have hdiff : z - X_pt = (τ : ℂ) * H := by dsimp only [X_pt]; ring
      rw [hdiff]
      have hInt :
          (∫ θ in (0 : ℝ)..1, Complex.exp (W (X_pt + (θ : ℂ) * ((τ : ℂ) * H)))) = ew * I₁ := by
        have hCongr :
            (∫ θ in (0 : ℝ)..1, Complex.exp (W (X_pt + (θ : ℂ) * ((τ : ℂ) * H)))) =
              ∫ θ in (0 : ℝ)..1, ew * (1 + H * (sw₁ θ * skrExp1 (H * sw₁ θ))) := by
          refine intervalIntegral.integral_congr (fun θ hθ => ?_)
          rw [huIcc01] at hθ
          have hpt : X_pt + (θ : ℂ) * ((τ : ℂ) * H) = z + (((θ - 1) * τ : ℝ) : ℂ) * H := by
            dsimp only [X_pt]; push_cast; ring
          dsimp only [sw₁]
          have hexp1 := hExpSlope (1 : ℂ) (hc₁_mem hθ)
          simp only [one_mul] at hexp1
          rw [hpt, hexp1]
        rw [hCongr, intervalIntegral.integral_const_mul,
          intervalIntegral.integral_add intervalIntegrable_const
            (hg₁_cont.const_mul H).intervalIntegrable,
          intervalIntegral.integral_const, intervalIntegral.integral_const_mul]
        simp only [sub_zero, one_smul]
        rfl
      rw [hInt]
      dsimp only [u₁]
      ring
    have hTerm1 :
        2 * (1 - Complex.cos (deltaPhi_ℂ W X_pt z)) * Complex.exp (-2 * W z) =
          (τ : ℂ) ^ 2 * H ^ 2 + H ^ 3 * skrKerRem1 W τ H z := by
      rw [hDelta1, hTay_cos u₁, hTay_skrCos2 u₁, hew_inv_sq]
      change 2 * (u₁ ^ 2 * (1 / 2 + u₁ ^ 2 * skrRCos2 u₁)) * ew_inv ^ 2 =
        (τ : ℂ) ^ 2 * H ^ 2 +
          H ^ 3 * ((τ : ℂ) ^ 2 *
            (2 * H * (τ : ℂ) ^ 2 * Complex.exp (2 * W z) * I₁ ^ 4 * skrRCos2 u₁ +
              (I₁ + 1) * rI₁))
      rw [hew_sq]
      calc 2 * (u₁ ^ 2 * (1 / 2 + u₁ ^ 2 * skrRCos2 u₁)) * ew_inv ^ 2
          = (ew * ew_inv) ^ 2 * ((τ : ℂ) ^ 2 * H ^ 2 * (1 + H * rI₁) ^ 2 +
              2 * H ^ 4 * (τ : ℂ) ^ 4 * ew ^ 2 * I₁ ^ 4 * skrRCos2 u₁) := by
                dsimp only [u₁, I₁]; ring
        _ = (τ : ℂ) ^ 2 * H ^ 2 +
              H ^ 3 * ((τ : ℂ) ^ 2 *
                (2 * H * (τ : ℂ) ^ 2 * ew ^ 2 * I₁ ^ 4 * skrRCos2 u₁ + (I₁ + 1) * rI₁)) := by
                rw [hew_mul]; dsimp only [I₁]; ring
    
    let γ_fn : ℝ → ℝ := fun β => τ + β * (1 - τ)
    let sw₂ : ℝ → ℝ → ℂ := fun β θ => skrSlopeW W z (θ * γ_fn β - τ) H
    let rI₂ : ℝ → ℂ := fun β => ∫ θ in (0 : ℝ)..1, sw₂ β θ * skrExp1 (H * sw₂ β θ)
    have hc₂_mem : ∀ {β θ : ℝ},
        β ∈ Set.Icc (0 : ℝ) 1 → θ ∈ Set.Icc (0 : ℝ) 1 →
        θ * γ_fn β - τ ∈ Set.Icc (-τ) (1 - τ) := by
      intro β θ hβ hθ
      have hγ0 : 0 ≤ γ_fn β := by dsimp only [γ_fn]; nlinarith [hτ.1, hτ.2, hβ.1]
      have hγ1 : γ_fn β ≤ 1 := by dsimp only [γ_fn]; nlinarith [hτ.2, hβ.2]
      refine ⟨by nlinarith [hθ.1, hγ0], by nlinarith [hθ.2, hγ0, hγ1]⟩
    have hc_b_mem : ∀ {β : ℝ},
        β ∈ Set.Icc (0 : ℝ) 1 → β * (1 - τ) ∈ Set.Icc (-τ) (1 - τ) := by
      intro β hβ
      refine ⟨by nlinarith [hτ.1, hτ.2, hβ.1], by nlinarith [hτ.2, hβ.2]⟩
    have hsw₂_uncurry_cont :
        ContinuousOn (fun p : ℝ × ℝ => sw₂ p.1 p.2 * skrExp1 (H * sw₂ p.1 p.2))
          (Set.Icc (0 : ℝ) 1 ×ˢ Set.Icc (0 : ℝ) 1) := by
      have hsw₂_c : ContinuousOn (fun p : ℝ × ℝ => sw₂ p.1 p.2)
          (Set.Icc (0 : ℝ) 1 ×ˢ Set.Icc (0 : ℝ) 1) := by
        have hAff : Continuous (fun p : ℝ × ℝ => p.2 * (τ + p.1 * (1 - τ)) - τ) :=
          (continuous_snd.mul (continuous_const.add (continuous_fst.mul continuous_const))).sub
            continuous_const
        exact hSlopeCont.comp hAff.continuousOn (fun p hp => hc₂_mem hp.1 hp.2)
      exact hsw₂_c.mul (hCont_skrExp1.comp_continuousOn (continuousOn_const.mul hsw₂_c))
    have hrI₂_cont : ContinuousOn rI₂ (Set.Icc (0 : ℝ) 1) :=
      hContOn_int01 hsw₂_uncurry_cont
    have hRem2_cont : ContinuousOn (fun β : ℝ => skrKerRem2Integrand W τ β H z)
        (Set.Icc (0 : ℝ) 1) := by
      have hγ_c : ContinuousOn (fun β : ℝ => (γ_fn β : ℂ)) (Set.Icc (0 : ℝ) 1) :=
        (Complex.continuous_ofReal.comp
          (continuous_const.add (continuous_id.mul continuous_const))).continuousOn
      have hI₂_c : ContinuousOn (fun β : ℝ => 1 + H * rI₂ β) (Set.Icc (0 : ℝ) 1) :=
        continuousOn_const.add (continuousOn_const.mul hrI₂_cont)
      have hu₂_c : ContinuousOn (fun β : ℝ => (γ_fn β : ℂ) * H * ew * (1 + H * rI₂ β))
          (Set.Icc (0 : ℝ) 1) :=
        ((hγ_c.mul continuousOn_const).mul continuousOn_const).mul hI₂_c
      have hrs_c : ContinuousOn
          (fun β : ℝ => ((γ_fn β : ℂ) * ew * (1 + H * rI₂ β)) ^ 2 *
            skrRSinc ((γ_fn β : ℂ) * H * ew * (1 + H * rI₂ β)))
          (Set.Icc (0 : ℝ) 1) :=
        (((hγ_c.mul continuousOn_const).mul hI₂_c).pow 2).mul
          (hCont_skrRSinc.comp_continuousOn hu₂_c)
      have hS₂_c : ContinuousOn
          (fun β : ℝ => 1 + H ^ 2 * (((γ_fn β : ℂ) * ew * (1 + H * rI₂ β)) ^ 2 *
            skrRSinc ((γ_fn β : ℂ) * H * ew * (1 + H * rI₂ β))))
          (Set.Icc (0 : ℝ) 1) :=
        continuousOn_const.add (continuousOn_const.mul hrs_c)
      have hswb_c : ContinuousOn (fun β : ℝ => -2 * skrSlopeW W z (β * (1 - τ)) H)
          (Set.Icc (0 : ℝ) 1) :=
        continuousOn_const.mul
          (hSlopeCont.comp (continuous_id.mul continuous_const).continuousOn
            (fun _ hβ => hc_b_mem hβ))
      have hrE₂_c : ContinuousOn
          (fun β : ℝ => (-2 * skrSlopeW W z (β * (1 - τ)) H) *
            skrExp1 (H * (-2 * skrSlopeW W z (β * (1 - τ)) H)))
          (Set.Icc (0 : ℝ) 1) :=
        hswb_c.mul (hCont_skrExp1.comp_continuousOn (continuousOn_const.mul hswb_c))
      have hE₂_c : ContinuousOn
          (fun β : ℝ => 1 + H * ((-2 * skrSlopeW W z (β * (1 - τ)) H) *
            skrExp1 (H * (-2 * skrSlopeW W z (β * (1 - τ)) H))))
          (Set.Icc (0 : ℝ) 1) :=
        continuousOn_const.add (continuousOn_const.mul hrE₂_c)
      have hH_rs_c : ContinuousOn
          (fun β : ℝ => H * (((γ_fn β : ℂ) * ew * (1 + H * rI₂ β)) ^ 2 *
            skrRSinc ((γ_fn β : ℂ) * H * ew * (1 + H * rI₂ β))))
          (Set.Icc (0 : ℝ) 1) :=
        continuousOn_const.mul hrs_c
      exact hγ_c.mul
        ((((hrI₂_cont.mul hS₂_c).mul hE₂_c).add (hH_rs_c.mul hE₂_c)).add hrE₂_c)
    have hBetaIntegrand : ∀ {β : ℝ}, β ∈ Set.Icc (0 : ℝ) 1 →
        Complex.sin (deltaPhi_ℂ W X_pt (z + (β : ℂ) * (μ_pt - z))) *
          Complex.exp (-2 * W (z + (β : ℂ) * (μ_pt - z))) =
          H * ew * ew_inv ^ 2 * ((γ_fn β : ℂ) + H * skrKerRem2Integrand W τ β H z) := by
      intro β hβ
      set w_β : ℂ := z + (β : ℂ) * (μ_pt - z)
      have hw_β_eq : w_β = z + ((β * (1 - τ) : ℝ) : ℂ) * H := by
        dsimp only [w_β, μ_pt]; push_cast; ring
      have hDelta2 : deltaPhi_ℂ W X_pt w_β = (γ_fn β : ℂ) * H * ew * (1 + H * rI₂ β) := by
        unfold deltaPhi_ℂ
        have hdiff : w_β - X_pt = (γ_fn β : ℂ) * H := by
          rw [hw_β_eq]; dsimp only [X_pt, γ_fn]; push_cast; ring
        rw [hdiff]
        have hg₂_cont : ContinuousOn (fun θ : ℝ => sw₂ β θ * skrExp1 (H * sw₂ β θ))
            (Set.uIcc (0 : ℝ) 1) := by
          rw [huIcc01]
          exact hsw₂_uncurry_cont.comp (continuous_const.prodMk continuous_id).continuousOn
            (fun _ hθ => ⟨hβ, hθ⟩)
        have hInt :
            (∫ θ in (0 : ℝ)..1, Complex.exp (W (X_pt + (θ : ℂ) * ((γ_fn β : ℂ) * H)))) =
              ew * (1 + H * rI₂ β) := by
          have hCongr :
              (∫ θ in (0 : ℝ)..1, Complex.exp (W (X_pt + (θ : ℂ) * ((γ_fn β : ℂ) * H)))) =
                ∫ θ in (0 : ℝ)..1, ew * (1 + H * (sw₂ β θ * skrExp1 (H * sw₂ β θ))) := by
            refine intervalIntegral.integral_congr (fun θ hθ => ?_)
            rw [huIcc01] at hθ
            have hpt : X_pt + (θ : ℂ) * ((γ_fn β : ℂ) * H) =
                z + ((θ * γ_fn β - τ : ℝ) : ℂ) * H := by
              dsimp only [X_pt]; push_cast; ring
            dsimp only [sw₂]
            have hexp1 := hExpSlope (1 : ℂ) (hc₂_mem hβ hθ)
            simp only [one_mul] at hexp1
            rw [hpt, hexp1]
          rw [hCongr, intervalIntegral.integral_const_mul,
            intervalIntegral.integral_add intervalIntegrable_const
              (hg₂_cont.const_mul H).intervalIntegrable,
            intervalIntegral.integral_const, intervalIntegral.integral_const_mul]
          simp only [sub_zero, one_smul]
          rfl
        rw [hInt]
        ring
      let I₂ : ℂ := 1 + H * rI₂ β
      let u₂ : ℂ := (γ_fn β : ℂ) * H * ew * I₂
      let rs : ℂ := ((γ_fn β : ℂ) * ew * I₂) ^ 2 * skrRSinc u₂
      let S₂ : ℂ := 1 + H ^ 2 * rs
      let sw_b : ℂ := -2 * skrSlopeW W z (β * (1 - τ)) H
      let rE₂ : ℂ := sw_b * skrExp1 (H * sw_b)
      let E₂ : ℂ := 1 + H * rE₂
      have hSin2 : Complex.sin (deltaPhi_ℂ W X_pt w_β) = (γ_fn β : ℂ) * H * ew * I₂ * S₂ := by
        rw [hDelta2]
        change Complex.sin u₂ = (γ_fn β : ℂ) * H * ew * I₂ * S₂
        rw [hTay_sin u₂, hTay_skrSinc u₂]
        dsimp only [u₂, S₂, rs]
        ring
      have hExp2 : Complex.exp (-2 * W w_β) = ew_inv ^ 2 * E₂ := by
        rw [hw_β_eq, hExpSlope (-2 : ℂ) (hc_b_mem hβ), hew_inv_sq]
      rw [hSin2, hExp2]
      change ((γ_fn β : ℂ) * H * ew * I₂ * S₂) * (ew_inv ^ 2 * E₂) =
        H * ew * ew_inv ^ 2 *
          ((γ_fn β : ℂ) + H * ((γ_fn β : ℂ) * (rI₂ β * S₂ * E₂ + H * rs * E₂ + rE₂)))
      dsimp only [I₂, S₂, E₂]
      ring
    have hInt_γ : (∫ β in (0 : ℝ)..1, (γ_fn β : ℂ)) = (((1 + τ) / 2 : ℝ) : ℂ) := by
      rw [intervalIntegral.integral_ofReal]
      have hDeriv : ∀ β ∈ Set.uIcc (0 : ℝ) 1,
          HasDerivAt (fun s : ℝ => τ * s + (1 - τ) * (s ^ 2 / 2)) (γ_fn β) β := by
        intro β _
        have h1 : HasDerivAt (fun s : ℝ => τ * s) (τ * 1) β := (hasDerivAt_id β).const_mul τ
        have h2 : HasDerivAt (fun s : ℝ => (1 - τ) * (s ^ 2 / 2))
            ((1 - τ) * (((2 : ℝ) * β ^ (2 - 1)) / 2)) β :=
          ((hasDerivAt_pow 2 β).div_const 2).const_mul (1 - τ)
        convert h1.add h2 using 1
        dsimp only [γ_fn]
        ring
      have hCont : Continuous γ_fn :=
        continuous_const.add (continuous_id.mul continuous_const)
      have hFTC := intervalIntegral.integral_eq_sub_of_hasDerivAt hDeriv (hCont.intervalIntegrable 0 1)
      rw [hFTC]
      push_cast
      ring
    have hTerm2 :
        Complex.exp (W z) * (μ_pt - z) *
          (∫ β in (0 : ℝ)..1,
            Complex.sin (deltaPhi_ℂ W X_pt (z + (β : ℂ) * (μ_pt - z))) *
              Complex.exp (-2 * W (z + (β : ℂ) * (μ_pt - z)))) =
          (((1 - τ) * ((1 + τ) / 2) : ℝ) : ℂ) * H ^ 2 +
            H ^ 3 * (((1 - τ : ℝ) : ℂ) * ∫ β in (0 : ℝ)..1, skrKerRem2Integrand W τ β H z) := by
      have hCongr :
          (∫ β in (0 : ℝ)..1,
              Complex.sin (deltaPhi_ℂ W X_pt (z + (β : ℂ) * (μ_pt - z))) *
                Complex.exp (-2 * W (z + (β : ℂ) * (μ_pt - z)))) =
            ∫ β in (0 : ℝ)..1,
              H * ew * ew_inv ^ 2 * ((γ_fn β : ℂ) + H * skrKerRem2Integrand W τ β H z) := by
        refine intervalIntegral.integral_congr (fun β hβ => ?_)
        rw [huIcc01] at hβ
        exact hBetaIntegrand hβ
      have hγ_int : IntervalIntegrable (fun β : ℝ => (γ_fn β : ℂ)) MeasureTheory.volume 0 1 :=
        (Complex.continuous_ofReal.comp
          (continuous_const.add (continuous_id.mul continuous_const))).intervalIntegrable 0 1
      have hRem2_int : IntervalIntegrable
          (fun β : ℝ => H * skrKerRem2Integrand W τ β H z) MeasureTheory.volume 0 1 := by
        refine ContinuousOn.intervalIntegrable ?_
        rw [huIcc01]
        exact continuousOn_const.mul hRem2_cont
      rw [hCongr, intervalIntegral.integral_const_mul,
        intervalIntegral.integral_add hγ_int hRem2_int,
        intervalIntegral.integral_const_mul, hInt_γ]
      have hμ_diff : μ_pt - z = ((1 - τ : ℝ) : ℂ) * H := by dsimp only [μ_pt]; ring
      rw [hμ_diff]
      change ew * (((1 - τ : ℝ) : ℂ) * H) *
        (H * ew * ew_inv ^ 2 *
          ((((1 + τ) / 2 : ℝ) : ℂ) + H * ∫ β in (0 : ℝ)..1, skrKerRem2Integrand W τ β H z)) = _
      set J₂ : ℂ := ∫ β in (0 : ℝ)..1, skrKerRem2Integrand W τ β H z
      calc ew * (((1 - τ : ℝ) : ℂ) * H) *
            (H * ew * ew_inv ^ 2 * ((((1 + τ) / 2 : ℝ) : ℂ) + H * J₂))
          = (ew * ew_inv) ^ 2 *
              ((((1 - τ) * ((1 + τ) / 2) : ℝ) : ℂ) * H ^ 2 +
                H ^ 3 * (((1 - τ : ℝ) : ℂ) * J₂)) := by
                push_cast; ring
        _ = (((1 - τ) * ((1 + τ) / 2) : ℝ) : ℂ) * H ^ 2 +
              H ^ 3 * (((1 - τ : ℝ) : ℂ) * J₂) := by
                rw [hew_mul]; ring
    change 2 * (1 - Complex.cos (deltaPhi_ℂ W X_pt z)) * Complex.exp (-2 * W z) -
        Complex.exp (W z) * (μ_pt - z) *
          (∫ β in (0 : ℝ)..1,
            Complex.sin (deltaPhi_ℂ W X_pt (z + (β : ℂ) * (μ_pt - z))) *
              Complex.exp (-2 * W (z + (β : ℂ) * (μ_pt - z)))) = _
    rw [hTerm1, hTerm2]
    unfold skrKerRem
    push_cast
    ring
  exact ⟨hPlusEqMinus, hRealEq, hDiagPeriodic, hFactorEq⟩

theorem strip_half_step_comp_system (m : ℕ) (M : ℝ)
    (hm : 2 ≤ m) (hM : 0 < M) (S : StationaryMeshSystem m (M + 1))
    (H_inv : StripHalfCellInvSystem m M S)
    (hCalc : SkrCalcToolkit) :
    Nonempty (SkrHalfStepSystem m M S H_inv) :=
by
  let N_step : ℕ := max H_inv.N_inv (Nat.ceil H_inv.C_inv + 4)
  let C_step : ℝ :=
    skrCompConst m 2 * (2 * S.R_mesh) * (1 + (2 : ℝ) ^ m * H_inv.C_inv) + 1
  have hComp_ge_one : 1 ≤ skrCompConst m 2 := by
    cases m with
    | zero => exact le_rfl
    | succ p => exact le_max_left _ _
  have hComp_pos : 0 < skrCompConst m 2 := lt_of_lt_of_le zero_lt_one hComp_ge_one
  have hR_pos : 0 < S.R_mesh := S.R_mesh_pos
  have hCinv_pos : 0 < H_inv.C_inv := H_inv.C_inv_pos
  have h2m_pos : 0 < (2 : ℝ) ^ m := pow_pos (by norm_num) m
  have hFactor_ge_one : 1 ≤ 1 + (2 : ℝ) ^ m * H_inv.C_inv := by
    have hmul : 0 ≤ (2 : ℝ) ^ m * H_inv.C_inv :=
      mul_nonneg (le_of_lt h2m_pos) (le_of_lt hCinv_pos)
    linarith
  have hProd_pos :
      0 < skrCompConst m 2 * (2 * S.R_mesh) * (1 + (2 : ℝ) ^ m * H_inv.C_inv) :=
    mul_pos (mul_pos hComp_pos (by linarith)) (lt_of_lt_of_le zero_lt_one hFactor_ge_one)
  have hC_step_pos : 0 < C_step := by
    dsimp [C_step]
    linarith
  have hSingle_le_C_step : (2 * S.R_mesh) * skrCompConst m 2 ≤ C_step := by
    have h1 :
        (2 * S.R_mesh) * skrCompConst m 2 ≤
          skrCompConst m 2 * (2 * S.R_mesh) * (1 + (2 : ℝ) ^ m * H_inv.C_inv) := by
      have hcomm :
          (2 * S.R_mesh) * skrCompConst m 2 = skrCompConst m 2 * (2 * S.R_mesh) * 1 := by
        ring
      rw [hcomm]
      exact mul_le_mul_of_nonneg_left hFactor_ge_one
        (mul_nonneg (le_of_lt hComp_pos) (by linarith))
    dsimp [C_step]
    linarith
  have hNormHalf : ‖(1 / 2 : ℂ)‖ = (1 / 2 : ℝ) := by
    rw [norm_div, norm_one, Complex.norm_ofNat]
  have hOuterSingle :
      ∀ (σ : ℝ) (q : ℕ) (w : ℝ → ℝ) (W : ℂ → ℂ) (X_ℂ μ_ℂ : ℕ → ℂ → ℂ),
        1 ≤ (q : ℝ) →
        IsStripMeshExt m (M + 1) S σ q w W X_ℂ μ_ℂ →
        ∀ j : ℕ, j < q →
          let σ_mesh := (1 - S.K_mesh / (q : ℝ) ^ 2) * σ
          IsSkrStripBnd (m + 2) σ_mesh (2 * S.R_mesh / (q : ℝ) ^ 2)
            (fun ξ => (μ_ℂ j ξ - X_ℂ j ξ) - ((Real.pi / (q : ℝ) : ℝ) : ℂ)) ∧
          IsSkrStripBnd (m + 2) σ_mesh (2 * S.R_mesh / (q : ℝ) ^ 2)
            (fun ξ => (X_ℂ (j + 1) ξ - μ_ℂ j ξ) - ((Real.pi / (q : ℝ) : ℝ) : ℂ)) := by
    intro σ q w W X_ℂ μ_ℂ hq_ge_one hMesh j hj
    dsimp only
    let σ_mesh : ℝ := (1 - S.K_mesh / (q : ℝ) ^ 2) * σ
    have hq_pos : 0 < (q : ℝ) := lt_of_lt_of_le zero_lt_one hq_ge_one
    have hq_sq_pos : 0 < (q : ℝ) ^ 2 := sq_pos_of_pos hq_pos
    have hq2_le_q3 : (q : ℝ) ^ 2 ≤ (q : ℝ) ^ 3 := by
      calc (q : ℝ) ^ 2 = (q : ℝ) ^ 2 * 1 := by ring
        _ ≤ (q : ℝ) ^ 2 * (q : ℝ) := mul_le_mul_of_nonneg_left hq_ge_one (sq_nonneg _)
        _ = (q : ℝ) ^ 3 := by ring
    have hXj_holo : DifferentiableOn ℂ (X_ℂ j) (horizStrip σ_mesh) :=
      (hMesh.2.1 j (Nat.le_of_lt hj)).1
    have hXj1_holo : DifferentiableOn ℂ (X_ℂ (j + 1)) (horizStrip σ_mesh) :=
      (hMesh.2.1 (j + 1) hj).1
    have hμj_holo : DifferentiableOn ℂ (μ_ℂ j) (horizStrip σ_mesh) :=
      (hMesh.2.2 j hj).1
    let Δu : ℂ → ℂ := fun ξ =>
      (X_ℂ (j + 1) ξ - X_ℂ j ξ) - ((2 * Real.pi / (q : ℝ) : ℝ) : ℂ)
    let m_disp : ℂ → ℂ := fun ξ =>
      μ_ℂ j ξ - (X_ℂ j ξ + (X_ℂ (j + 1) ξ - X_ℂ j ξ) / 2)
    let B₀ : ℝ := S.R_mesh / (q : ℝ) ^ 2
    have hB₀_nonneg : 0 ≤ B₀ := div_nonneg (le_of_lt hR_pos) (sq_nonneg _)
    have hΔu_bnd : IsSkrStripBnd (m + 2) σ_mesh B₀ Δu := by
      refine ⟨(hXj1_holo.sub hXj_holo).sub_const _, ?_⟩
      intro k hk z hz
      rw [le_div_iff₀ hq_sq_pos, mul_comm]
      exact le_trans
        (mul_le_mul_of_nonneg_right hq2_le_q3 (norm_nonneg _))
        ((hMesh.2.2 j hj).2.2.2.2.2.1 k hk z hz)
    have hm_bnd : IsSkrStripBnd (m + 2) σ_mesh B₀ m_disp := by
      refine ⟨hμj_holo.sub (hXj_holo.add ((hXj1_holo.sub hXj_holo).div_const (2 : ℂ))), ?_⟩
      intro k hk z hz
      rw [le_div_iff₀ hq_sq_pos, mul_comm]
      exact (hMesh.2.2 j hj).2.2.2.2.2.2 k hk z hz
    have hHalf_Δu : IsSkrStripBnd (m + 2) σ_mesh (‖(1 / 2 : ℂ)‖ * B₀)
        (fun ξ => (1 / 2 : ℂ) * Δu ξ) :=
      hCalc.bnd_const_mul (1 / 2 : ℂ) hB₀_nonneg hΔu_bnd
    have hB_le : ‖(1 / 2 : ℂ)‖ * B₀ + B₀ ≤ 2 * S.R_mesh / (q : ℝ) ^ 2 := by
      rw [hNormHalf]
      have h2B₀ : 2 * S.R_mesh / (q : ℝ) ^ 2 = 2 * B₀ := by
        dsimp [B₀]
        ring
      rw [h2B₀]
      linarith
    have hEq_m :
        (fun ξ : ℂ => (μ_ℂ j ξ - X_ℂ j ξ) - ((Real.pi / (q : ℝ) : ℝ) : ℂ)) =
          (fun ξ : ℂ => (1 / 2 : ℂ) * Δu ξ + m_disp ξ) := by
      ext ξ
      dsimp [Δu, m_disp]
      push_cast
      ring
    have hEq_p :
        (fun ξ : ℂ => (X_ℂ (j + 1) ξ - μ_ℂ j ξ) - ((Real.pi / (q : ℝ) : ℝ) : ℂ)) =
          (fun ξ : ℂ => (1 / 2 : ℂ) * Δu ξ - m_disp ξ) := by
      ext ξ
      dsimp [Δu, m_disp]
      push_cast
      ring
    rw [hEq_m, hEq_p]
    exact ⟨hCalc.bnd_mono hB_le (hCalc.bnd_add hHalf_Δu hm_bnd),
      hCalc.bnd_mono hB_le (hCalc.bnd_sub hHalf_Δu hm_bnd)⟩
  have hInnerDerivBnd :
      ∀ (σ' : ℝ) (q : ℕ) (f : ℂ → ℂ) (c : ℂ),
        0 < (q : ℝ) ^ 2 →
        H_inv.C_inv / (q : ℝ) ^ 2 ≤ 1 →
        DifferentiableOn ℂ f (horizStrip σ') →
        (∀ k : ℕ, k ≤ m + 1 → ∀ z ∈ horizStrip σ',
          (q : ℝ) ^ 2 * ‖iteratedDeriv k (fun ζ : ℂ => f ζ - (ζ - c)) z‖ ≤ H_inv.C_inv) →
        ∀ r : ℕ, 1 ≤ r → r ≤ m + 1 → ∀ z ∈ horizStrip σ',
          ‖iteratedDeriv r f z‖ ≤ 2 := by
    intro σ' q f c hq_sq_pos hCinv_div_le hf hψ_scaled r hr1 hrm z hz
    have hOpen : IsOpen (horizStrip σ') := (hCalc.horizStrip_open_convex σ').1
    let ψ : ℂ → ℂ := fun ζ => f ζ - (ζ - c)
    have hψ_holo : DifferentiableOn ℂ ψ (horizStrip σ') :=
      hf.sub (differentiableOn_id.sub_const c)
    have hψ_bnd : ∀ k : ℕ, k ≤ m + 1 → ∀ w ∈ horizStrip σ', ‖iteratedDeriv k ψ w‖ ≤ 1 := by
      intro k hk w hw
      have h1 : ‖iteratedDeriv k ψ w‖ ≤ H_inv.C_inv / (q : ℝ) ^ 2 := by
        rw [le_div_iff₀ hq_sq_pos, mul_comm]
        exact hψ_scaled k hk w hw
      exact le_trans h1 hCinv_div_le
    have hf_eq : f = fun w : ℂ => (ψ w + w) - c := by
      ext w
      dsimp [ψ]
      ring
    have hDerivEqOn : Set.EqOn (deriv f) (fun ζ : ℂ => deriv ψ ζ + 1) (horizStrip σ') := by
      intro ζ hζ
      have hψ_at : DifferentiableAt ℂ ψ ζ :=
        hψ_holo.differentiableAt (hOpen.mem_nhds hζ)
      rw [hf_eq, deriv_sub_const c]
      change deriv (ψ + id) ζ = deriv ψ ζ + 1
      rw [deriv_add hψ_at differentiableAt_id]
      change deriv ψ ζ + (deriv fun x : ℂ => x) ζ = deriv ψ ζ + 1
      rw [deriv_id'']
    obtain ⟨r', rfl⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : r ≠ 0)
    rw [iteratedDeriv_succ',
      (hDerivEqOn.eventuallyEq_of_mem (hOpen.mem_nhds hz)).iteratedDeriv_eq r']
    cases r' with
    | zero =>
        rw [iteratedDeriv_zero, ← iteratedDeriv_one]
        have hb1 : ‖iteratedDeriv 1 ψ z‖ ≤ 1 := hψ_bnd 1 (by omega) z hz
        calc ‖iteratedDeriv 1 ψ z + 1‖
            ≤ ‖iteratedDeriv 1 ψ z‖ + ‖(1 : ℂ)‖ := norm_add_le _ _
          _ ≤ 1 + 1 := by rw [norm_one]; linarith
          _ = 2 := by norm_num
    | succ r'' =>
        rw [iteratedDeriv_succ', deriv_add_const' (1 : ℂ), ← iteratedDeriv_succ',
          ← iteratedDeriv_succ']
        exact le_trans (hψ_bnd (r'' + 2) (by omega) z hz) (by norm_num)
  refine ⟨{
    C_step := C_step
    N_step := N_step
    C_step_pos := hC_step_pos
    N_inv_le := le_max_left _ _
    step_props := ?_
    step_lip := ?_
  }⟩
  · intro σ q w W X_ℂ μ_ℂ xInvMinus xInvPlus hσ hq hKinv_lt hAdm
    dsimp only
    intro j hj
    obtain ⟨hw, hW, hMesh, hInv⟩ := hAdm
    have hCeil_le_q : Nat.ceil H_inv.C_inv + 4 ≤ q := le_trans (le_max_right _ _) hq
    have hq_ge_one : 1 ≤ (q : ℝ) := by exact_mod_cast (show 1 ≤ q by omega)
    have hq_pos : 0 < (q : ℝ) := lt_of_lt_of_le zero_lt_one hq_ge_one
    have hq_sq_pos : 0 < (q : ℝ) ^ 2 := sq_pos_of_pos hq_pos
    have hq_le_q2 : (q : ℝ) ≤ (q : ℝ) ^ 2 := by
      calc (q : ℝ) = 1 * (q : ℝ) := by ring
        _ ≤ (q : ℝ) * (q : ℝ) := mul_le_mul_of_nonneg_right hq_ge_one (le_of_lt hq_pos)
        _ = (q : ℝ) ^ 2 := by ring
    have hCinv_div_le : H_inv.C_inv / (q : ℝ) ^ 2 ≤ 1 := by
      rw [div_le_one hq_sq_pos]
      have h1 : H_inv.C_inv ≤ (Nat.ceil H_inv.C_inv : ℝ) := Nat.le_ceil H_inv.C_inv
      have h2 : (Nat.ceil H_inv.C_inv : ℝ) ≤ (q : ℝ) := by
        exact_mod_cast (show Nat.ceil H_inv.C_inv ≤ q by omega)
      linarith
    have hKinv_pos : 0 < H_inv.K_inv := lt_trans S.K_mesh_pos H_inv.K_mesh_lt
    have hKinv_div_nonneg : 0 ≤ H_inv.K_inv / (q : ℝ) ^ 2 :=
      div_nonneg (le_of_lt hKinv_pos) (sq_nonneg _)
    let σ_mesh : ℝ := (1 - S.K_mesh / (q : ℝ) ^ 2) * σ
    let σ_inv : ℝ := (1 - H_inv.K_inv / (q : ℝ) ^ 2) * σ
    have hσ_inv_pos : 0 < σ_inv := mul_pos (by linarith) hσ.1
    have hσ_inv_le : σ_inv ≤ σ := by
      dsimp [σ_inv]
      nlinarith [hσ.1]
    have hOpen_mesh : IsOpen (horizStrip σ_mesh) :=
      (hCalc.horizStrip_open_convex σ_mesh).1
    obtain ⟨hgm_bnd, hgp_bnd⟩ := hOuterSingle σ q w W X_ℂ μ_ℂ hq_ge_one hMesh j hj
    let M_G : ℝ := 2 * S.R_mesh / (q : ℝ) ^ 2
    have hMG_nonneg : 0 ≤ M_G := div_nonneg (by linarith) (sq_nonneg _)
    let h_m : ℝ → ℂ → ℂ := fun α ζ =>
      μ_ℂ j (xInvMinus j α ζ) - X_ℂ j (xInvMinus j α ζ)
    let h_p : ℝ → ℂ → ℂ := fun α ζ =>
      X_ℂ (j + 1) (xInvPlus j α ζ) - μ_ℂ j (xInvPlus j α ζ)
    refine ⟨?_, ?_⟩
    · intro α hα
      obtain ⟨hxm_holo, hxp_holo, hMaps, hRightInv, _, _, hInvBnd⟩ := (hInv j hj).1 α hα
      have hxm_deriv :
          ∀ r : ℕ, 1 ≤ r → r ≤ m → ∀ z ∈ horizStrip σ_inv,
            ‖iteratedDeriv r (xInvMinus j α) z‖ ≤ 2 := by
        intro r hr1 hrm z hz
        exact hInnerDerivBnd σ_inv q (xInvMinus j α) _ hq_sq_pos hCinv_div_le hxm_holo
          (fun k hk w' hw' => (hInvBnd k hk w' hw').1) r hr1 (by omega) z hz
      have hxp_deriv :
          ∀ r : ℕ, 1 ≤ r → r ≤ m → ∀ z ∈ horizStrip σ_inv,
            ‖iteratedDeriv r (xInvPlus j α) z‖ ≤ 2 := by
        intro r hr1 hrm z hz
        exact hInnerDerivBnd σ_inv q (xInvPlus j α) _ hq_sq_pos hCinv_div_le hxp_holo
          (fun k hk w' hw' => (hInvBnd k hk w' hw').2) r hr1 (by omega) z hz
      have hComp_m := hCalc.comp_bnd m σ_inv M_G 2 (horizStrip σ_mesh)
        (fun ξ => (μ_ℂ j ξ - X_ℂ j ξ) - ((Real.pi / (q : ℝ) : ℝ) : ℂ))
        (xInvMinus j α)
        hOpen_mesh hMG_nonneg (by norm_num) hgm_bnd.1
        (fun r hr w' hw' => hgm_bnd.2 r (by omega) w' hw')
        hxm_holo (fun z hz => (hMaps z hz).1) hxm_deriv
      have hComp_p := hCalc.comp_bnd m σ_inv M_G 2 (horizStrip σ_mesh)
        (fun ξ => (X_ℂ (j + 1) ξ - μ_ℂ j ξ) - ((Real.pi / (q : ℝ) : ℝ) : ℂ))
        (xInvPlus j α)
        hOpen_mesh hMG_nonneg (by norm_num) hgp_bnd.1
        (fun r hr w' hw' => hgp_bnd.2 r (by omega) w' hw')
        hxp_holo (fun z hz => (hMaps z hz).2) hxp_deriv
      have hhm_holo : DifferentiableOn ℂ (h_m α) (horizStrip σ_inv) := by
        have h1 := hComp_m.1.add_const (((Real.pi / (q : ℝ) : ℝ) : ℂ))
        have hfn :
            (fun y : ℂ =>
              ((μ_ℂ j (xInvMinus j α y) - X_ℂ j (xInvMinus j α y)) -
                ((Real.pi / (q : ℝ) : ℝ) : ℂ)) +
                ((Real.pi / (q : ℝ) : ℝ) : ℂ)) = h_m α := by
          ext y
          dsimp [h_m]
          ring
        rwa [hfn] at h1
      have hhp_holo : DifferentiableOn ℂ (h_p α) (horizStrip σ_inv) := by
        have h1 := hComp_p.1.add_const (((Real.pi / (q : ℝ) : ℝ) : ℂ))
        have hfn :
            (fun y : ℂ =>
              ((X_ℂ (j + 1) (xInvPlus j α y) - μ_ℂ j (xInvPlus j α y)) -
                ((Real.pi / (q : ℝ) : ℝ) : ℂ)) +
                ((Real.pi / (q : ℝ) : ℝ) : ℂ)) = h_p α := by
          ext y
          dsimp [h_p]
          ring
        rwa [hfn] at h1
      refine ⟨hhm_holo, hhp_holo, ?_, ?_⟩
      · intro ζ hζ
        have hζ_σ : ζ ∈ horizStrip σ := by
          change |ζ.im| < σ_inv at hζ
          change |ζ.im| < σ
          exact lt_of_lt_of_le hζ hσ_inv_le
        obtain ⟨hRm, hRp⟩ := hRightInv ζ hζ
        obtain ⟨hMap_m, hMap_p⟩ := hMaps ζ hζ
        refine ⟨hζ_σ, ?_, ?_, ?_, ?_,
          (hMesh.2.1 j (Nat.le_of_lt hj)).2.2.2.2.1 _ hMap_m,
          (hMesh.2.2 j hj).2.2.2.2.1 _ hMap_m,
          (hMesh.2.1 (j + 1) hj).2.2.2.2.1 _ hMap_p,
          (hMesh.2.2 j hj).2.2.2.2.1 _ hMap_p⟩
        · calc X_ℂ j (xInvMinus j α ζ)
              = (X_ℂ j (xInvMinus j α ζ) +
                  (α : ℂ) * (μ_ℂ j (xInvMinus j α ζ) - X_ℂ j (xInvMinus j α ζ))) -
                  (α : ℂ) * (μ_ℂ j (xInvMinus j α ζ) - X_ℂ j (xInvMinus j α ζ)) := by ring
            _ = ζ - (α : ℂ) * (μ_ℂ j (xInvMinus j α ζ) - X_ℂ j (xInvMinus j α ζ)) := by
                  rw [hRm]
        · calc μ_ℂ j (xInvMinus j α ζ)
              = (X_ℂ j (xInvMinus j α ζ) +
                  (α : ℂ) * (μ_ℂ j (xInvMinus j α ζ) - X_ℂ j (xInvMinus j α ζ))) +
                  (1 - (α : ℂ)) * (μ_ℂ j (xInvMinus j α ζ) - X_ℂ j (xInvMinus j α ζ)) := by ring
            _ = ζ + ((1 - α : ℝ) : ℂ) *
                  (μ_ℂ j (xInvMinus j α ζ) - X_ℂ j (xInvMinus j α ζ)) := by
                  rw [hRm]; push_cast; ring
        · calc X_ℂ (j + 1) (xInvPlus j α ζ)
              = (μ_ℂ j (xInvPlus j α ζ) +
                  (α : ℂ) * (X_ℂ (j + 1) (xInvPlus j α ζ) - μ_ℂ j (xInvPlus j α ζ))) -
                  (1 - (α : ℂ)) *
                    (-(X_ℂ (j + 1) (xInvPlus j α ζ) - μ_ℂ j (xInvPlus j α ζ))) := by ring
            _ = ζ - ((1 - α : ℝ) : ℂ) *
                  (-(X_ℂ (j + 1) (xInvPlus j α ζ) - μ_ℂ j (xInvPlus j α ζ))) := by
                  rw [hRp]; push_cast; ring
        · calc μ_ℂ j (xInvPlus j α ζ)
              = (μ_ℂ j (xInvPlus j α ζ) +
                  (α : ℂ) * (X_ℂ (j + 1) (xInvPlus j α ζ) - μ_ℂ j (xInvPlus j α ζ))) +
                  (α : ℂ) *
                    (-(X_ℂ (j + 1) (xInvPlus j α ζ) - μ_ℂ j (xInvPlus j α ζ))) := by ring
            _ = ζ + (α : ℂ) *
                  (-(X_ℂ (j + 1) (xInvPlus j α ζ) - μ_ℂ j (xInvPlus j α ζ))) := by
                  rw [hRp]
      · intro k hk z hz
        have hScale :
            (q : ℝ) ^ 2 * (M_G * skrCompConst m 2) = (2 * S.R_mesh) * skrCompConst m 2 := by
          dsimp [M_G]
          calc (q : ℝ) ^ 2 * ((2 * S.R_mesh / (q : ℝ) ^ 2) * skrCompConst m 2)
              = ((2 * S.R_mesh / (q : ℝ) ^ 2) * (q : ℝ) ^ 2) * skrCompConst m 2 := by ring
            _ = (2 * S.R_mesh) * skrCompConst m 2 := by
                rw [div_mul_cancel₀ _ (ne_of_gt hq_sq_pos)]
        refine ⟨?_, ?_⟩
        · exact le_trans
            (mul_le_mul_of_nonneg_left (hComp_m.2 k hk z hz) (sq_nonneg _))
            (by rw [hScale]; exact hSingle_le_C_step)
        · exact le_trans
            (mul_le_mul_of_nonneg_left (hComp_p.2 k hk z hz) (sq_nonneg _))
            (by rw [hScale]; exact hSingle_le_C_step)
    · intro k hk z hz
      have hGm_holo : DifferentiableOn ℂ (fun w' => μ_ℂ j w' - X_ℂ j w') (horizStrip σ_mesh) :=
        (hMesh.2.2 j hj).1.sub (hMesh.2.1 j (Nat.le_of_lt hj)).1
      have hGp_holo :
          DifferentiableOn ℂ (fun w' => X_ℂ (j + 1) w' - μ_ℂ j w') (horizStrip σ_mesh) :=
        (hMesh.2.1 (j + 1) hj).1.sub (hMesh.2.2 j hj).1
      refine ⟨?_, ?_⟩
      · exact hCalc.comp_param_cont m σ_inv (horizStrip σ_mesh)
          (fun w' => μ_ℂ j w' - X_ℂ j w') (xInvMinus j)
          hOpen_mesh hσ_inv_pos hGm_holo
          (fun α hα => ⟨((hInv j hj).1 α hα).1, fun ζ hζ => (((hInv j hj).1 α hα).2.2.1 ζ hζ).1⟩)
          (fun r hr ζ hζ => ((hInv j hj).2 r (by omega) ζ hζ).1)
          k hk z hz
      · exact hCalc.comp_param_cont m σ_inv (horizStrip σ_mesh)
          (fun w' => X_ℂ (j + 1) w' - μ_ℂ j w') (xInvPlus j)
          hOpen_mesh hσ_inv_pos hGp_holo
          (fun α hα =>
            ⟨((hInv j hj).1 α hα).2.1, fun ζ hζ => (((hInv j hj).1 α hα).2.2.1 ζ hζ).2⟩)
          (fun r hr ζ hζ => ((hInv j hj).2 r (by omega) ζ hζ).2)
          k hk z hz
  · intro σ q w₁ w₂ W₁ W₂ X_ℂ₁ μ_ℂ₁ X_ℂ₂ μ_ℂ₂ xInvMinus₁ xInvPlus₁ xInvMinus₂ xInvPlus₂
      hσ hq hKinv_lt hAdm₁ hAdm₂
    dsimp only
    intro j hj α hα
    obtain ⟨hw₁, hW₁, hMesh₁, hInv₁⟩ := hAdm₁
    obtain ⟨hw₂, hW₂, hMesh₂, hInv₂⟩ := hAdm₂
    have hNinv_le_q : H_inv.N_inv ≤ q := le_trans (le_max_left _ _) hq
    have hNmesh_le_q : S.N_mesh ≤ q := le_trans H_inv.N_mesh_le hNinv_le_q
    have hCeil_le_q : Nat.ceil H_inv.C_inv + 4 ≤ q := le_trans (le_max_right _ _) hq
    have hq_ge_one : 1 ≤ (q : ℝ) := by exact_mod_cast (show 1 ≤ q by omega)
    have hq_pos : 0 < (q : ℝ) := lt_of_lt_of_le zero_lt_one hq_ge_one
    have hq_sq_pos : 0 < (q : ℝ) ^ 2 := sq_pos_of_pos hq_pos
    have hq_sq_ge_one : 1 ≤ (q : ℝ) ^ 2 := by nlinarith
    have hq_le_q2 : (q : ℝ) ≤ (q : ℝ) ^ 2 := by
      calc (q : ℝ) = 1 * (q : ℝ) := by ring
        _ ≤ (q : ℝ) * (q : ℝ) := mul_le_mul_of_nonneg_right hq_ge_one (le_of_lt hq_pos)
        _ = (q : ℝ) ^ 2 := by ring
    have hq2_le_q3 : (q : ℝ) ^ 2 ≤ (q : ℝ) ^ 3 := by
      calc (q : ℝ) ^ 2 = (q : ℝ) ^ 2 * 1 := by ring
        _ ≤ (q : ℝ) ^ 2 * (q : ℝ) := mul_le_mul_of_nonneg_left hq_ge_one (sq_nonneg _)
        _ = (q : ℝ) ^ 3 := by ring
    have hCinv_div_le : H_inv.C_inv / (q : ℝ) ^ 2 ≤ 1 := by
      rw [div_le_one hq_sq_pos]
      have h1 : H_inv.C_inv ≤ (Nat.ceil H_inv.C_inv : ℝ) := Nat.le_ceil H_inv.C_inv
      have h2 : (Nat.ceil H_inv.C_inv : ℝ) ≤ (q : ℝ) := by
        exact_mod_cast (show Nat.ceil H_inv.C_inv ≤ q by omega)
      linarith
    have hKmesh_lt : S.K_mesh / (q : ℝ) ^ 2 < 1 :=
      lt_of_le_of_lt
        (div_le_div_of_nonneg_right (le_of_lt H_inv.K_mesh_lt) (sq_nonneg _))
        hKinv_lt
    let σ_mesh : ℝ := (1 - S.K_mesh / (q : ℝ) ^ 2) * σ
    let σ_inv : ℝ := (1 - H_inv.K_inv / (q : ℝ) ^ 2) * σ
    have hOpen_mesh : IsOpen (horizStrip σ_mesh) :=
      (hCalc.horizStrip_open_convex σ_mesh).1
    have hConv_mesh : Convex ℝ (horizStrip σ_mesh) :=
      (hCalc.horizStrip_open_convex σ_mesh).2
    let ΔW : ℝ := stripDiffSup (m + 15) σ W₁ W₂
    have hΔW_nonneg : 0 ≤ ΔW :=
      (hCalc.stripDiffSup_nonneg_and_le (m + 15) σ M w₁ w₂ W₁ W₂ hσ.1 hW₁ hW₂).1
    have hw₁_M1 : IsPeriodicSmoothBounded (m + 15) (M + 1) w₁ :=
      ⟨hw₁.1, hw₁.2.1, fun k hk x => le_trans (hw₁.2.2 k hk x) (by linarith)⟩
    have hw₂_M1 : IsPeriodicSmoothBounded (m + 15) (M + 1) w₂ :=
      ⟨hw₂.1, hw₂.2.1, fun k hk x => le_trans (hw₂.2.2 k hk x) (by linarith)⟩
    have hW₁_M1 : IsBoundedStripExt (m + 15) σ (M + 1) w₁ W₁ :=
      ⟨hW₁.1, hW₁.2.1, hW₁.2.2.1, hW₁.2.2.2.1,
        fun k hk z hz => le_trans (hW₁.2.2.2.2 k hk z hz) (by linarith)⟩
    have hW₂_M1 : IsBoundedStripExt (m + 15) σ (M + 1) w₂ W₂ :=
      ⟨hW₂.1, hW₂.2.1, hW₂.2.2.1, hW₂.2.2.2.1,
        fun k hk z hz => le_trans (hW₂.2.2.2.2 k hk z hz) (by linarith)⟩
    have hMeshLip := S.strip_mesh_lip σ q w₁ w₂ W₁ W₂ X_ℂ₁ μ_ℂ₁ X_ℂ₂ μ_ℂ₂
      hσ hNmesh_le_q hKmesh_lt hw₁_M1 hw₂_M1 hW₁_M1 hW₂_M1
      (fun r hr => ⟨(hMesh₁.2.1 r hr).1, (hMesh₂.2.1 r hr).1,
        (hMesh₁.2.1 r hr).2.1, (hMesh₂.2.1 r hr).2.1⟩)
      (fun r hr => ⟨(hMesh₁.2.2 r hr).1, (hMesh₂.2.2 r hr).1,
        (hMesh₁.2.2 r hr).2.1, (hMesh₂.2.2 r hr).2.1⟩)
    let Δu_diff : ℂ → ℂ := fun ξ =>
      (X_ℂ₁ (j + 1) ξ - X_ℂ₁ j ξ) - (X_ℂ₂ (j + 1) ξ - X_ℂ₂ j ξ)
    let m_diff : ℂ → ℂ := fun ξ =>
      (μ_ℂ₁ j ξ - (X_ℂ₁ j ξ + (X_ℂ₁ (j + 1) ξ - X_ℂ₁ j ξ) / 2)) -
        (μ_ℂ₂ j ξ - (X_ℂ₂ j ξ + (X_ℂ₂ (j + 1) ξ - X_ℂ₂ j ξ) / 2))
    let B_Δ : ℝ := S.R_mesh * ΔW / (q : ℝ) ^ 2
    have hB_Δ_nonneg : 0 ≤ B_Δ :=
      div_nonneg (mul_nonneg (le_of_lt hR_pos) hΔW_nonneg) (sq_nonneg _)
    have hXj₁_holo : DifferentiableOn ℂ (X_ℂ₁ j) (horizStrip σ_mesh) :=
      (hMesh₁.2.1 j (Nat.le_of_lt hj)).1
    have hXj1₁_holo : DifferentiableOn ℂ (X_ℂ₁ (j + 1)) (horizStrip σ_mesh) :=
      (hMesh₁.2.1 (j + 1) hj).1
    have hμj₁_holo : DifferentiableOn ℂ (μ_ℂ₁ j) (horizStrip σ_mesh) :=
      (hMesh₁.2.2 j hj).1
    have hXj₂_holo : DifferentiableOn ℂ (X_ℂ₂ j) (horizStrip σ_mesh) :=
      (hMesh₂.2.1 j (Nat.le_of_lt hj)).1
    have hXj1₂_holo : DifferentiableOn ℂ (X_ℂ₂ (j + 1)) (horizStrip σ_mesh) :=
      (hMesh₂.2.1 (j + 1) hj).1
    have hμj₂_holo : DifferentiableOn ℂ (μ_ℂ₂ j) (horizStrip σ_mesh) :=
      (hMesh₂.2.2 j hj).1
    have hΔu_diff_bnd : IsSkrStripBnd (m + 2) σ_mesh B_Δ Δu_diff := by
      refine ⟨(hXj1₁_holo.sub hXj₁_holo).sub (hXj1₂_holo.sub hXj₂_holo), ?_⟩
      intro r hr w' hw'
      rw [le_div_iff₀ hq_sq_pos, mul_comm]
      exact le_trans
        (mul_le_mul_of_nonneg_right hq2_le_q3 (norm_nonneg _))
        (hMeshLip.2.1 j hj r hr w' hw')
    have hm_diff_bnd : IsSkrStripBnd (m + 2) σ_mesh B_Δ m_diff := by
      refine ⟨(hμj₁_holo.sub (hXj₁_holo.add ((hXj1₁_holo.sub hXj₁_holo).div_const (2 : ℂ)))).sub
        (hμj₂_holo.sub (hXj₂_holo.add ((hXj1₂_holo.sub hXj₂_holo).div_const (2 : ℂ)))), ?_⟩
      intro r hr w' hw'
      rw [le_div_iff₀ hq_sq_pos, mul_comm]
      exact hMeshLip.2.2 j hj r hr w' hw'
    have hHalf_Δu_diff : IsSkrStripBnd (m + 2) σ_mesh (‖(1 / 2 : ℂ)‖ * B_Δ)
        (fun ξ => (1 / 2 : ℂ) * Δu_diff ξ) :=
      hCalc.bnd_const_mul (1 / 2 : ℂ) hB_Δ_nonneg hΔu_diff_bnd
    let ΔG : ℝ := 2 * S.R_mesh * ΔW / (q : ℝ) ^ 2
    have hΔG_nonneg : 0 ≤ ΔG :=
      div_nonneg (mul_nonneg (by linarith) hΔW_nonneg) (sq_nonneg _)
    have hB_Δ_le : ‖(1 / 2 : ℂ)‖ * B_Δ + B_Δ ≤ ΔG := by
      rw [hNormHalf]
      have h2B : ΔG = 2 * B_Δ := by
        dsimp [ΔG, B_Δ]
        ring
      rw [h2B]
      linarith
    let g_m₁ : ℂ → ℂ := fun ξ => (μ_ℂ₁ j ξ - X_ℂ₁ j ξ) - ((Real.pi / (q : ℝ) : ℝ) : ℂ)
    let g_m₂ : ℂ → ℂ := fun ξ => (μ_ℂ₂ j ξ - X_ℂ₂ j ξ) - ((Real.pi / (q : ℝ) : ℝ) : ℂ)
    let g_p₁ : ℂ → ℂ := fun ξ => (X_ℂ₁ (j + 1) ξ - μ_ℂ₁ j ξ) - ((Real.pi / (q : ℝ) : ℝ) : ℂ)
    let g_p₂ : ℂ → ℂ := fun ξ => (X_ℂ₂ (j + 1) ξ - μ_ℂ₂ j ξ) - ((Real.pi / (q : ℝ) : ℝ) : ℂ)
    have hEq_gm_diff :
        (fun ξ : ℂ => g_m₁ ξ - g_m₂ ξ) =
          (fun ξ : ℂ => (1 / 2 : ℂ) * Δu_diff ξ + m_diff ξ) := by
      ext ξ
      dsimp [g_m₁, g_m₂, Δu_diff, m_diff]
      ring
    have hEq_gp_diff :
        (fun ξ : ℂ => g_p₁ ξ - g_p₂ ξ) =
          (fun ξ : ℂ => (1 / 2 : ℂ) * Δu_diff ξ - m_diff ξ) := by
      ext ξ
      dsimp [g_p₁, g_p₂, Δu_diff, m_diff]
      ring
    have hgm_diff_bnd : IsSkrStripBnd (m + 2) σ_mesh ΔG (fun ξ => g_m₁ ξ - g_m₂ ξ) := by
      rw [hEq_gm_diff]
      exact hCalc.bnd_mono hB_Δ_le (hCalc.bnd_add hHalf_Δu_diff hm_diff_bnd)
    have hgp_diff_bnd : IsSkrStripBnd (m + 2) σ_mesh ΔG (fun ξ => g_p₁ ξ - g_p₂ ξ) := by
      rw [hEq_gp_diff]
      exact hCalc.bnd_mono hB_Δ_le (hCalc.bnd_sub hHalf_Δu_diff hm_diff_bnd)
    obtain ⟨hgm₁_bnd, hgp₁_bnd⟩ := hOuterSingle σ q w₁ W₁ X_ℂ₁ μ_ℂ₁ hq_ge_one hMesh₁ j hj
    obtain ⟨hgm₂_bnd, hgp₂_bnd⟩ := hOuterSingle σ q w₂ W₂ X_ℂ₂ μ_ℂ₂ hq_ge_one hMesh₂ j hj
    obtain ⟨hxm₁_holo, hxp₁_holo, hMaps₁, _, _, _, hInvBnd₁⟩ := (hInv₁ j hj).1 α hα
    obtain ⟨hxm₂_holo, hxp₂_holo, hMaps₂, _, _, _, hInvBnd₂⟩ := (hInv₂ j hj).1 α hα
    have hxm₁_deriv :
        ∀ r : ℕ, 1 ≤ r → r ≤ m → ∀ z ∈ horizStrip σ_inv,
          ‖iteratedDeriv r (xInvMinus₁ j α) z‖ ≤ 2 := by
      intro r hr1 hrm z hz
      exact hInnerDerivBnd σ_inv q (xInvMinus₁ j α) _ hq_sq_pos hCinv_div_le hxm₁_holo
        (fun r' hr' w' hw' => (hInvBnd₁ r' hr' w' hw').1) r hr1 (by omega) z hz
    have hxm₂_deriv :
        ∀ r : ℕ, 1 ≤ r → r ≤ m → ∀ z ∈ horizStrip σ_inv,
          ‖iteratedDeriv r (xInvMinus₂ j α) z‖ ≤ 2 := by
      intro r hr1 hrm z hz
      exact hInnerDerivBnd σ_inv q (xInvMinus₂ j α) _ hq_sq_pos hCinv_div_le hxm₂_holo
        (fun r' hr' w' hw' => (hInvBnd₂ r' hr' w' hw').1) r hr1 (by omega) z hz
    have hxp₁_deriv :
        ∀ r : ℕ, 1 ≤ r → r ≤ m → ∀ z ∈ horizStrip σ_inv,
          ‖iteratedDeriv r (xInvPlus₁ j α) z‖ ≤ 2 := by
      intro r hr1 hrm z hz
      exact hInnerDerivBnd σ_inv q (xInvPlus₁ j α) _ hq_sq_pos hCinv_div_le hxp₁_holo
        (fun r' hr' w' hw' => (hInvBnd₁ r' hr' w' hw').2) r hr1 (by omega) z hz
    have hxp₂_deriv :
        ∀ r : ℕ, 1 ≤ r → r ≤ m → ∀ z ∈ horizStrip σ_inv,
          ‖iteratedDeriv r (xInvPlus₂ j α) z‖ ≤ 2 := by
      intro r hr1 hrm z hz
      exact hInnerDerivBnd σ_inv q (xInvPlus₂ j α) _ hq_sq_pos hCinv_div_le hxp₂_holo
        (fun r' hr' w' hw' => (hInvBnd₂ r' hr' w' hw').2) r hr1 (by omega) z hz
    have hInvLip := H_inv.inv_lip σ q w₁ w₂ W₁ W₂ X_ℂ₁ μ_ℂ₁ X_ℂ₂ μ_ℂ₂
      xInvMinus₁ xInvPlus₁ xInvMinus₂ xInvPlus₂ hσ hNinv_le_q hKinv_lt
      ⟨hw₁, hW₁, hMesh₁, hInv₁⟩ ⟨hw₂, hW₂, hMesh₂, hInv₂⟩ j hj α hα
    let Δf : ℝ := H_inv.C_inv * ΔW / (q : ℝ) ^ 2
    have hΔf_nonneg : 0 ≤ Δf :=
      div_nonneg (mul_nonneg (le_of_lt hCinv_pos) hΔW_nonneg) (sq_nonneg _)
    have hxm_diff_bnd : IsSkrStripBnd m σ_inv Δf
        (fun z => xInvMinus₁ j α z - xInvMinus₂ j α z) := by
      refine ⟨hxm₁_holo.sub hxm₂_holo, ?_⟩
      intro r hr z hz
      rw [le_div_iff₀ hq_sq_pos, mul_comm]
      exact (hInvLip r (by omega) z hz).1
    have hxp_diff_bnd : IsSkrStripBnd m σ_inv Δf
        (fun z => xInvPlus₁ j α z - xInvPlus₂ j α z) := by
      refine ⟨hxp₁_holo.sub hxp₂_holo, ?_⟩
      intro r hr z hz
      rw [le_div_iff₀ hq_sq_pos, mul_comm]
      exact (hInvLip r (by omega) z hz).2
    let M_G : ℝ := 2 * S.R_mesh / (q : ℝ) ^ 2
    have hMG_nonneg : 0 ≤ M_G := div_nonneg (by linarith) (sq_nonneg _)
    have hCompDiff_m := hCalc.comp_diff_bnd m σ_inv M_G ΔG 2 Δf (horizStrip σ_mesh)
      g_m₁ g_m₂ (xInvMinus₁ j α) (xInvMinus₂ j α)
      hOpen_mesh hConv_mesh hMG_nonneg hΔG_nonneg (by norm_num) hΔf_nonneg
      hgm₁_bnd.1 hgm₂_bnd.1
      (fun r hr w' hw' => hgm_diff_bnd.2 r (by omega) w' hw')
      (fun r hr w' hw' => hgm₂_bnd.2 r (by omega) w' hw')
      hxm₁_holo hxm₂_holo
      (fun z hz => (hMaps₁ z hz).1) (fun z hz => (hMaps₂ z hz).1)
      hxm₁_deriv hxm₂_deriv hxm_diff_bnd
    have hCompDiff_p := hCalc.comp_diff_bnd m σ_inv M_G ΔG 2 Δf (horizStrip σ_mesh)
      g_p₁ g_p₂ (xInvPlus₁ j α) (xInvPlus₂ j α)
      hOpen_mesh hConv_mesh hMG_nonneg hΔG_nonneg (by norm_num) hΔf_nonneg
      hgp₁_bnd.1 hgp₂_bnd.1
      (fun r hr w' hw' => hgp_diff_bnd.2 r (by omega) w' hw')
      (fun r hr w' hw' => hgp₂_bnd.2 r (by omega) w' hw')
      hxp₁_holo hxp₂_holo
      (fun z hz => (hMaps₁ z hz).2) (fun z hz => (hMaps₂ z hz).2)
      hxp₁_deriv hxp₂_deriv hxp_diff_bnd
    have hΔf_le : Δf ≤ H_inv.C_inv * ΔW :=
      div_le_self (mul_nonneg (le_of_lt hCinv_pos) hΔW_nonneg) hq_sq_ge_one
    have hLipScale :
        (q : ℝ) ^ 2 * (skrCompConst m 2 * (ΔG + (2 : ℝ) ^ m * M_G * Δf)) ≤ C_step * ΔW := by
      have hqΔG : (q : ℝ) ^ 2 * ΔG = 2 * S.R_mesh * ΔW := by
        dsimp [ΔG]
        rw [mul_comm, div_mul_cancel₀ _ (ne_of_gt hq_sq_pos)]
      have hqMG : (q : ℝ) ^ 2 * M_G = 2 * S.R_mesh := by
        dsimp [M_G]
        rw [mul_comm, div_mul_cancel₀ _ (ne_of_gt hq_sq_pos)]
      have hExpand :
          (q : ℝ) ^ 2 * (skrCompConst m 2 * (ΔG + (2 : ℝ) ^ m * M_G * Δf)) =
            skrCompConst m 2 *
              (2 * S.R_mesh * ΔW + (2 : ℝ) ^ m * (2 * S.R_mesh) * Δf) := by
        calc (q : ℝ) ^ 2 * (skrCompConst m 2 * (ΔG + (2 : ℝ) ^ m * M_G * Δf))
            = skrCompConst m 2 *
                ((q : ℝ) ^ 2 * ΔG + (2 : ℝ) ^ m * ((q : ℝ) ^ 2 * M_G) * Δf) := by ring
          _ = skrCompConst m 2 *
                (2 * S.R_mesh * ΔW + (2 : ℝ) ^ m * (2 * S.R_mesh) * Δf) := by
                rw [hqΔG, hqMG]
      rw [hExpand]
      have hStep1 :
          skrCompConst m 2 * (2 * S.R_mesh * ΔW + (2 : ℝ) ^ m * (2 * S.R_mesh) * Δf) ≤
            skrCompConst m 2 *
              (2 * S.R_mesh * ΔW + (2 : ℝ) ^ m * (2 * S.R_mesh) * (H_inv.C_inv * ΔW)) := by
        apply mul_le_mul_of_nonneg_left _ (le_of_lt hComp_pos)
        have hmul :
            (2 : ℝ) ^ m * (2 * S.R_mesh) * Δf ≤
              (2 : ℝ) ^ m * (2 * S.R_mesh) * (H_inv.C_inv * ΔW) :=
          mul_le_mul_of_nonneg_left hΔf_le
            (mul_nonneg (le_of_lt h2m_pos) (by linarith))
        linarith
      have hStep2 :
          skrCompConst m 2 *
              (2 * S.R_mesh * ΔW + (2 : ℝ) ^ m * (2 * S.R_mesh) * (H_inv.C_inv * ΔW)) =
            (skrCompConst m 2 * (2 * S.R_mesh) * (1 + (2 : ℝ) ^ m * H_inv.C_inv)) * ΔW := by
        ring
      have hStep3 :
          (skrCompConst m 2 * (2 * S.R_mesh) * (1 + (2 : ℝ) ^ m * H_inv.C_inv)) * ΔW ≤
            C_step * ΔW := by
        apply mul_le_mul_of_nonneg_right _ hΔW_nonneg
        dsimp [C_step]
        linarith
      exact le_trans hStep1 (by rw [hStep2]; exact hStep3)
    intro k hk z hz
    have hfn_m :
        (fun ζ : ℂ =>
          (μ_ℂ₁ j (xInvMinus₁ j α ζ) - X_ℂ₁ j (xInvMinus₁ j α ζ)) -
            (μ_ℂ₂ j (xInvMinus₂ j α ζ) - X_ℂ₂ j (xInvMinus₂ j α ζ))) =
          (fun ζ : ℂ => g_m₁ (xInvMinus₁ j α ζ) - g_m₂ (xInvMinus₂ j α ζ)) := by
      ext ζ
      dsimp [g_m₁, g_m₂]
      ring
    have hfn_p :
        (fun ζ : ℂ =>
          (X_ℂ₁ (j + 1) (xInvPlus₁ j α ζ) - μ_ℂ₁ j (xInvPlus₁ j α ζ)) -
            (X_ℂ₂ (j + 1) (xInvPlus₂ j α ζ) - μ_ℂ₂ j (xInvPlus₂ j α ζ))) =
          (fun ζ : ℂ => g_p₁ (xInvPlus₁ j α ζ) - g_p₂ (xInvPlus₂ j α ζ)) := by
      ext ζ
      dsimp [g_p₁, g_p₂]
      ring
    refine ⟨?_, ?_⟩
    · rw [hfn_m]
      exact le_trans
        (mul_le_mul_of_nonneg_left (hCompDiff_m.2 k hk z hz) (sq_nonneg _))
        hLipScale
    · rw [hfn_p]
      exact le_trans
        (mul_le_mul_of_nonneg_left (hCompDiff_p.2 k hk z hz) (sq_nonneg _))
        hLipScale

theorem reduced_kernel_asymptotics_and_lipschitz (m : ℕ) (M B_H : ℝ)
    (hm : 2 ≤ m) (hM : 0 < M) (hBH : 0 < B_H)
    (hCalc : SkrCalcToolkit) (hPt : SkrPointwiseProp) :
    Nonempty (SkrReducedKernelSystem m M B_H) :=
by
  
  
  
  have hStripSub : ∀ {σ' σ : ℝ}, σ' ≤ σ → horizStrip σ' ⊆ horizStrip σ := by
    intro σ' σ hle z hz
    exact lt_of_lt_of_le hz hle
  have hZeroMem : ∀ {σ' : ℝ}, 0 < σ' → (0 : ℂ) ∈ horizStrip σ' := by
    intro σ' hσ'
    change |(0 : ℂ).im| < σ'
    simpa using hσ'
  have hBndPt : ∀ {p : ℕ} {σ' B : ℝ} {f : ℂ → ℂ},
      IsSkrStripBnd p σ' B f → ∀ z ∈ horizStrip σ', ‖f z‖ ≤ B := by
    intro p σ' B f hf z hz
    simpa [iteratedDeriv_zero] using hf.2 0 (Nat.zero_le p) z hz
  have hBndCongr : ∀ {p : ℕ} {σ' B : ℝ} {f g : ℂ → ℂ},
      Set.EqOn f g (horizStrip σ') → IsSkrStripBnd p σ' B f → IsSkrStripBnd p σ' B g := by
    intro p σ' B f g hEq hf
    have hOpen : IsOpen (horizStrip σ') := (hCalc.horizStrip_open_convex σ').1
    refine ⟨hf.1.congr (fun z hz => (hEq hz).symm), ?_⟩
    intro k hk z hz
    have hEv : g =ᶠ[nhds z] f := hEq.symm.eventuallyEq_of_mem (hOpen.mem_nhds hz)
    rw [hEv.iteratedDeriv_eq k]
    exact hf.2 k hk z hz
  have hCompConstGeOne : ∀ (p : ℕ) (B : ℝ), 1 ≤ skrCompConst p B := by
    intro p B
    cases p with
    | zero => simp [skrCompConst]
    | succ p' => exact le_max_left _ _
  have hCompConstNonneg : ∀ (p : ℕ) (B : ℝ), 0 ≤ skrCompConst p B :=
    fun p B => le_trans zero_le_one (hCompConstGeOne p B)
  have hIdDerivLe : ∀ (j : ℕ) (z : ℂ), 1 ≤ j → ‖iteratedDeriv j (fun ζ : ℂ => ζ) z‖ ≤ 1 := by
    intro j z hj
    obtain ⟨j', rfl⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : j ≠ 0)
    rw [iteratedDeriv_succ', deriv_id'', iteratedDeriv_const]
    split_ifs <;> simp
  have hShiftDerivLe : ∀ {σ' a : ℝ} {H : ℂ → ℂ},
      |a| ≤ 1 → IsSkrStripBnd m σ' 1 H →
      DifferentiableOn ℂ (fun ζ => ζ + (a : ℂ) * H ζ) (horizStrip σ') ∧
      ∀ j : ℕ, 1 ≤ j → j ≤ m → ∀ z ∈ horizStrip σ',
        ‖iteratedDeriv j (fun ζ => ζ + (a : ℂ) * H ζ) z‖ ≤ 2 := by
    intro σ' a H ha hH
    have hOpen : IsOpen (horizStrip σ') := (hCalc.horizStrip_open_convex σ').1
    refine ⟨differentiableOn_id.add ((differentiableOn_const (a : ℂ)).mul hH.1), ?_⟩
    intro j hj1 hjm z hz
    have hcdId : ContDiffAt ℂ (j : WithTop ℕ∞) (fun ζ : ℂ => ζ) z := contDiffAt_id
    have hcdH : ContDiffAt ℂ (j : WithTop ℕ∞) H z :=
      (hH.1.contDiffOn hOpen).contDiffAt (hOpen.mem_nhds hz)
    have hcdMul : ContDiffAt ℂ (j : WithTop ℕ∞) (fun ζ => (a : ℂ) * H ζ) z :=
      contDiffAt_const.mul hcdH
    rw [iteratedDeriv_fun_add hcdId hcdMul, iteratedDeriv_const_mul (a : ℂ) hcdH]
    have h1 := hIdDerivLe j z hj1
    have h2 := hH.2 j hjm z hz
    have ha_norm : ‖(a : ℂ)‖ ≤ 1 := by simpa [Complex.norm_real, Real.norm_eq_abs] using ha
    calc ‖iteratedDeriv j (fun ζ : ℂ => ζ) z + (a : ℂ) * iteratedDeriv j H z‖
        ≤ ‖iteratedDeriv j (fun ζ : ℂ => ζ) z‖ + ‖(a : ℂ) * iteratedDeriv j H z‖ := norm_add_le _ _
      _ = ‖iteratedDeriv j (fun ζ : ℂ => ζ) z‖ + ‖(a : ℂ)‖ * ‖iteratedDeriv j H z‖ := by rw [norm_mul]
      _ ≤ 1 + 1 * 1 := by nlinarith [norm_nonneg (iteratedDeriv j H z)]
      _ = 2 := by norm_num
  have hTauSeg : ∀ {τ c η : ℝ},
      τ ∈ Set.Icc (0 : ℝ) 1 → c ∈ Set.Icc (-τ) (1 - τ) → η ∈ Set.Icc (0 : ℝ) 1 →
      |c| ≤ 1 ∧ η * c ∈ Set.Icc (-τ) (1 - τ) ∧ |η * c| ≤ 1 := by
    intro τ c η hτ hc hη
    have hc_abs : |c| ≤ 1 := abs_le.mpr ⟨by linarith [hτ.2, hc.1], by linarith [hτ.1, hc.2]⟩
    have hηc_mem : η * c ∈ Set.Icc (-τ) (1 - τ) := by
      rcases le_or_gt 0 c with hc0 | hc0
      · exact ⟨by nlinarith [hτ.1, hη.1], by nlinarith [hη.2, hc.2]⟩
      · exact ⟨by nlinarith [hc.1, hη.2], by nlinarith [hη.1, hτ.2]⟩
    have hηc_abs : |η * c| ≤ 1 :=
      abs_le.mpr ⟨by linarith [hτ.2, hηc_mem.1], by linarith [hτ.1, hηc_mem.2]⟩
    exact ⟨hc_abs, hηc_mem, hηc_abs⟩
  have hNormInt01 : ∀ {C : ℝ} {f : ℝ → ℂ},
      (∀ t ∈ Set.Icc (0 : ℝ) 1, ‖f t‖ ≤ C) → ‖∫ t in (0 : ℝ)..1, f t‖ ≤ C := by
    intro C f hf
    have h := intervalIntegral.norm_integral_le_of_norm_le_const (a := (0 : ℝ)) (b := 1) (C := C)
      (f := f) (fun t ht => by
        rw [Set.uIoc_of_le zero_le_one] at ht
        exact hf t ⟨le_of_lt ht.1, ht.2⟩)
    simpa using h
  have hParamIntSub : ∀ {σ' L : ℝ} {F₁ F₂ : ℝ → ℂ → ℂ},
      0 < σ' → 0 ≤ L →
      (∀ z ∈ horizStrip σ',
        ContinuousOn (fun t => F₁ t z) (Set.Icc (0 : ℝ) 1) ∧
        ContinuousOn (fun t => F₂ t z) (Set.Icc (0 : ℝ) 1)) →
      (∀ t ∈ Set.Icc (0 : ℝ) 1, IsSkrStripBnd m σ' L (fun z => F₁ t z - F₂ t z)) →
      IsSkrStripBnd m σ' L
        (fun z => (∫ t in (0 : ℝ)..1, F₁ t z) - (∫ t in (0 : ℝ)..1, F₂ t z)) := by
    intro σ' L F₁ F₂ hσ' hL hCont hDiff
    have hInt := (hCalc.param_int_bnd m σ' L (fun t z => F₁ t z - F₂ t z) hσ' hL
      (fun z hz => (hCont z hz).1.sub (hCont z hz).2) hDiff).1
    refine hBndCongr (fun z hz => ?_) hInt
    have hi1 : IntervalIntegrable (fun t => F₁ t z) MeasureTheory.volume 0 1 :=
      (hCont z hz).1.intervalIntegrable_of_Icc zero_le_one
    have hi2 : IntervalIntegrable (fun t => F₂ t z) MeasureTheory.volume 0 1 :=
      (hCont z hz).2.intervalIntegrable_of_Icc zero_le_one
    exact intervalIntegral.integral_sub hi1 hi2

  
  
  
  let PairBnd (σ' Δ B L : ℝ) (f₁ f₂ : ℂ → ℂ) : Prop :=
    IsSkrStripBnd m σ' B f₁ ∧
    IsSkrStripBnd m σ' B f₂ ∧
    IsSkrStripBnd m σ' (L * Δ) (fun z => f₁ z - f₂ z)
  have hPairCongr : ∀ {σ' Δ B L : ℝ} {f₁ f₂ g₁ g₂ : ℂ → ℂ},
      Set.EqOn f₁ g₁ (horizStrip σ') → Set.EqOn f₂ g₂ (horizStrip σ') →
      PairBnd σ' Δ B L f₁ f₂ → PairBnd σ' Δ B L g₁ g₂ := by
    intro σ' Δ B L f₁ f₂ g₁ g₂ hEq1 hEq2 hP
    exact ⟨hBndCongr hEq1 hP.1, hBndCongr hEq2 hP.2.1,
      hBndCongr (fun z hz => by simp [hEq1 hz, hEq2 hz]) hP.2.2⟩
  have hPairConst : ∀ {σ' Δ : ℝ} (c : ℂ),
      PairBnd σ' Δ ‖c‖ 0 (fun _ => c) (fun _ => c) := by
    intro σ' Δ c
    refine ⟨hCalc.bnd_const m σ' c, hCalc.bnd_const m σ' c, ?_⟩
    have h0 : IsSkrStripBnd m σ' ‖(0 : ℂ)‖ (fun _ => (0 : ℂ)) := hCalc.bnd_const m σ' 0
    rw [norm_zero, ← zero_mul Δ] at h0
    exact hBndCongr (fun _ _ => by simp) h0
  have hPairConstMul : ∀ {σ' Δ C B L : ℝ} {c₁ c₂ : ℂ} {f₁ f₂ : ℂ → ℂ},
      c₁ = c₂ → 0 ≤ C → 0 ≤ B → 0 ≤ L → 0 ≤ Δ → ‖c₁‖ ≤ C →
      PairBnd σ' Δ B L f₁ f₂ →
      PairBnd σ' Δ (C * B) (C * L) (fun z => c₁ * f₁ z) (fun z => c₂ * f₂ z) := by
    intro σ' Δ C B L c₁ c₂ f₁ f₂ hc_eq hC hB hL hΔ hc_le hP
    subst hc_eq
    refine ⟨hCalc.bnd_mono (mul_le_mul_of_nonneg_right hc_le hB) (hCalc.bnd_const_mul c₁ hB hP.1),
      hCalc.bnd_mono (mul_le_mul_of_nonneg_right hc_le hB) (hCalc.bnd_const_mul c₁ hB hP.2.1), ?_⟩
    have h1 := hCalc.bnd_const_mul c₁ (mul_nonneg hL hΔ) hP.2.2
    have h2 : ‖c₁‖ * (L * Δ) ≤ (C * L) * Δ := by
      calc ‖c₁‖ * (L * Δ) ≤ C * (L * Δ) := mul_le_mul_of_nonneg_right hc_le (mul_nonneg hL hΔ)
        _ = (C * L) * Δ := (mul_assoc C L Δ).symm
    exact hBndCongr (fun _ _ => by dsimp only; ring) (hCalc.bnd_mono h2 h1)
  have hPairNeg : ∀ {σ' Δ B L : ℝ} {f₁ f₂ : ℂ → ℂ},
      PairBnd σ' Δ B L f₁ f₂ → PairBnd σ' Δ B L (fun z => -f₁ z) (fun z => -f₂ z) := by
    intro σ' Δ B L f₁ f₂ hP
    refine ⟨hCalc.bnd_neg hP.1, hCalc.bnd_neg hP.2.1, ?_⟩
    exact hBndCongr (fun _ _ => by ring) (hCalc.bnd_neg hP.2.2)
  have hPairAdd : ∀ {σ' Δ B₁ L₁ B₂ L₂ : ℝ} {f₁ f₂ g₁ g₂ : ℂ → ℂ},
      PairBnd σ' Δ B₁ L₁ f₁ f₂ → PairBnd σ' Δ B₂ L₂ g₁ g₂ →
      PairBnd σ' Δ (B₁ + B₂) (L₁ + L₂) (fun z => f₁ z + g₁ z) (fun z => f₂ z + g₂ z) := by
    intro σ' Δ B₁ L₁ B₂ L₂ f₁ f₂ g₁ g₂ hPf hPg
    refine ⟨hCalc.bnd_add hPf.1 hPg.1, hCalc.bnd_add hPf.2.1 hPg.2.1, ?_⟩
    have h1 := hCalc.bnd_add hPf.2.2 hPg.2.2
    rw [← add_mul] at h1
    exact hBndCongr (fun _ _ => by ring) h1
  have hPairSub : ∀ {σ' Δ B₁ L₁ B₂ L₂ : ℝ} {f₁ f₂ g₁ g₂ : ℂ → ℂ},
      PairBnd σ' Δ B₁ L₁ f₁ f₂ → PairBnd σ' Δ B₂ L₂ g₁ g₂ →
      PairBnd σ' Δ (B₁ + B₂) (L₁ + L₂) (fun z => f₁ z - g₁ z) (fun z => f₂ z - g₂ z) := by
    intro σ' Δ B₁ L₁ B₂ L₂ f₁ f₂ g₁ g₂ hPf hPg
    refine ⟨hCalc.bnd_sub hPf.1 hPg.1, hCalc.bnd_sub hPf.2.1 hPg.2.1, ?_⟩
    have h1 := hCalc.bnd_sub hPf.2.2 hPg.2.2
    rw [← add_mul] at h1
    exact hBndCongr (fun _ _ => by ring) h1
  have hPairMul : ∀ {σ' Δ B₁ L₁ B₂ L₂ : ℝ} {f₁ f₂ g₁ g₂ : ℂ → ℂ},
      PairBnd σ' Δ B₁ L₁ f₁ f₂ → PairBnd σ' Δ B₂ L₂ g₁ g₂ →
      PairBnd σ' Δ ((2 : ℝ) ^ m * B₁ * B₂) ((2 : ℝ) ^ m * (B₁ * L₂ + L₁ * B₂))
        (fun z => f₁ z * g₁ z) (fun z => f₂ z * g₂ z) := by
    intro σ' Δ B₁ L₁ B₂ L₂ f₁ f₂ g₁ g₂ hPf hPg
    refine ⟨hCalc.bnd_mul hPf.1 hPg.1, hCalc.bnd_mul hPf.2.1 hPg.2.1, ?_⟩
    have h1 := hCalc.bnd_mul_diff hPf.1 hPg.2.1 hPf.2.2 hPg.2.2
    have hEq : (2 : ℝ) ^ m * (B₁ * (L₂ * Δ) + (L₁ * Δ) * B₂) =
        ((2 : ℝ) ^ m * (B₁ * L₂ + L₁ * B₂)) * Δ := by ring
    rwa [hEq] at h1
  have hPairSq : ∀ {σ' Δ B L : ℝ} {f₁ f₂ : ℂ → ℂ},
      PairBnd σ' Δ B L f₁ f₂ →
      PairBnd σ' Δ ((2 : ℝ) ^ m * B * B) ((2 : ℝ) ^ m * (B * L + L * B))
        (fun z => f₁ z ^ 2) (fun z => f₂ z ^ 2) := by
    intro σ' Δ B L f₁ f₂ hP
    exact hPairCongr (fun _ _ => (sq _).symm) (fun _ _ => (sq _).symm) (hPairMul hP hP)
  have hPairPow4 : ∀ {σ' Δ B L : ℝ} {f₁ f₂ : ℂ → ℂ},
      PairBnd σ' Δ B L f₁ f₂ →
      let B2 := (2 : ℝ) ^ m * B * B
      let L2 := (2 : ℝ) ^ m * (B * L + L * B)
      PairBnd σ' Δ ((2 : ℝ) ^ m * B2 * B2) ((2 : ℝ) ^ m * (B2 * L2 + L2 * B2))
        (fun z => f₁ z ^ 4) (fun z => f₂ z ^ 4) := by
    intro σ' Δ B L f₁ f₂ hP
    exact hPairCongr (fun _ _ => by ring) (fun _ _ => by ring)
      (hPairSq (hPairSq hP))
  have hPairInt : ∀ {σ' Δ B L : ℝ} {F₁ F₂ : ℝ → ℂ → ℂ},
      0 < σ' → 0 ≤ B → 0 ≤ L → 0 ≤ Δ →
      (∀ z ∈ horizStrip σ',
        ContinuousOn (fun t => F₁ t z) (Set.Icc (0 : ℝ) 1) ∧
        ContinuousOn (fun t => F₂ t z) (Set.Icc (0 : ℝ) 1)) →
      (∀ t ∈ Set.Icc (0 : ℝ) 1, PairBnd σ' Δ B L (F₁ t) (F₂ t)) →
      PairBnd σ' Δ B L
        (fun z => ∫ t in (0 : ℝ)..1, F₁ t z)
        (fun z => ∫ t in (0 : ℝ)..1, F₂ t z) := by
    intro σ' Δ B L F₁ F₂ hσ' hB hL hΔ hCont hF
    exact ⟨(hCalc.param_int_bnd m σ' B F₁ hσ' hB (fun z hz => (hCont z hz).1)
        (fun t ht => (hF t ht).1)).1,
      (hCalc.param_int_bnd m σ' B F₂ hσ' hB (fun z hz => (hCont z hz).2)
        (fun t ht => (hF t ht).2.1)).1,
      hParamIntSub hσ' (mul_nonneg hL hΔ) hCont (fun t ht => (hF t ht).2.2)⟩

  
  have hExp1Cos2BndAndCont : ∀ (R₀ : ℝ) (v_fn : ℝ → ℂ),
      0 ≤ R₀ → ContinuousOn v_fn (Set.Icc (0 : ℝ) 1) →
      (∀ x ∈ Set.Icc (0 : ℝ) 1, ‖v_fn x‖ ≤ R₀) →
      (∀ x ∈ Set.Icc (0 : ℝ) 1,
        ‖skrExp1 (v_fn x)‖ ≤ Real.exp (R₀ + 1) ∧
        ‖skrCos2 (v_fn x)‖ ≤ Real.exp (R₀ + 1)) ∧
      ContinuousOn (fun x => skrExp1 (v_fn x)) (Set.Icc (0 : ℝ) 1) ∧
      ContinuousOn (fun x => skrCos2 (v_fn x)) (Set.Icc (0 : ℝ) 1) := by
    intro R₀ v_fn hR₀ hv_cont hv_bnd
    let R : ℝ := R₀ + 1
    have hR_pos : 0 < R := by linarith
    have hExpBall := hCalc.exp_ball_bnd R hR_pos
    have hCosBall := hCalc.cos_ball_bnd R hR_pos
    have hInBall : ∀ x ∈ Set.Icc (0 : ℝ) 1, ∀ t ∈ Set.Icc (0 : ℝ) 1,
        (t : ℂ) * v_fn x ∈ Metric.ball (0 : ℂ) R := by
      intro x hx t ht
      rw [Metric.mem_ball, dist_zero_right, norm_mul, Complex.norm_real, Real.norm_eq_abs,
        abs_of_nonneg ht.1]
      have h1 : t * ‖v_fn x‖ ≤ 1 * R₀ := by
        nlinarith [ht.1, ht.2, hv_bnd x hx, norm_nonneg (v_fn x)]
      linarith
    have hPtExp : ∀ x ∈ Set.Icc (0 : ℝ) 1, ∀ t ∈ Set.Icc (0 : ℝ) 1,
        ‖Complex.exp ((t : ℂ) * v_fn x)‖ ≤ Real.exp R := by
      intro x hx t ht
      simpa [iteratedDeriv_zero] using hExpBall.2 0 _ (hInBall x hx t ht)
    have hPtCos : ∀ x ∈ Set.Icc (0 : ℝ) 1, ∀ t ∈ Set.Icc (0 : ℝ) 1,
        ‖((1 - t : ℝ) : ℂ) * Complex.cos ((t : ℂ) * v_fn x)‖ ≤ Real.exp R := by
      intro x hx t ht
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (by linarith [ht.2])]
      have hc : ‖Complex.cos ((t : ℂ) * v_fn x)‖ ≤ Real.exp R := by
        simpa [iteratedDeriv_zero] using hCosBall.2 0 _ (hInBall x hx t ht)
      nlinarith [ht.1, ht.2, hc, norm_nonneg (Complex.cos ((t : ℂ) * v_fn x))]
    refine ⟨fun x hx => ⟨hNormInt01 (hPtExp x hx), hNormInt01 (hPtCos x hx)⟩, ?_, ?_⟩
    · exact hCalc.param_int_cont (Real.exp R) (fun x s => Complex.exp ((s : ℂ) * v_fn x))
        (Real.exp_nonneg R)
        (fun x _ => Complex.continuous_exp.comp_continuousOn
          (Complex.continuous_ofReal.continuousOn.mul continuousOn_const))
        (fun s _ => Complex.continuous_exp.comp_continuousOn (continuousOn_const.mul hv_cont))
        hPtExp
    · exact hCalc.param_int_cont (Real.exp R)
        (fun x t => ((1 - t : ℝ) : ℂ) * Complex.cos ((t : ℂ) * v_fn x))
        (Real.exp_nonneg R)
        (fun x _ => (Complex.continuous_ofReal.comp (continuous_const.sub continuous_id)).continuousOn.mul
          (Complex.continuous_cos.comp_continuousOn
            (Complex.continuous_ofReal.continuousOn.mul continuousOn_const)))
        (fun t _ => continuousOn_const.mul
          (Complex.continuous_cos.comp_continuousOn (continuousOn_const.mul hv_cont)))
        hPtCos
  have hRSincCont : ∀ (R₀ : ℝ) (u_fn : ℝ → ℂ),
      0 ≤ R₀ → ContinuousOn u_fn (Set.Icc (0 : ℝ) 1) →
      (∀ x ∈ Set.Icc (0 : ℝ) 1, ‖u_fn x‖ ≤ R₀) →
      ContinuousOn (fun x => skrRSinc (u_fn x)) (Set.Icc (0 : ℝ) 1) := by
    intro R₀ u_fn hR₀ hu_cont hu_bnd
    refine ContinuousOn.neg ?_
    refine hCalc.param_int_cont (Real.exp (R₀ + 1))
      (fun x t => (t : ℂ) ^ 2 * skrCos2 ((t : ℂ) * u_fn x))
      (Real.exp_nonneg _) ?_ ?_ ?_
    · intro x hx
      have hc := (hExp1Cos2BndAndCont R₀ (fun t => (t : ℂ) * u_fn x) hR₀
        (Complex.continuous_ofReal.continuousOn.mul continuousOn_const)
        (fun t ht => by
          rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg ht.1]
          nlinarith [ht.1, ht.2, hu_bnd x hx, norm_nonneg (u_fn x)])).2.2
      exact (Complex.continuous_ofReal.continuousOn.pow 2).mul hc
    · intro t ht
      have hc := (hExp1Cos2BndAndCont R₀ (fun x => (t : ℂ) * u_fn x) hR₀
        (continuousOn_const.mul hu_cont)
        (fun x hx => by
          rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg ht.1]
          nlinarith [ht.1, ht.2, hu_bnd x hx, norm_nonneg (u_fn x)])).2.2
      exact continuousOn_const.mul hc
    · intro x hx t ht
      have hb := ((hExp1Cos2BndAndCont R₀ (fun _ => (t : ℂ) * u_fn x) hR₀ continuousOn_const
        (fun _ _ => by
          rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg ht.1]
          nlinarith [ht.1, ht.2, hu_bnd x hx, norm_nonneg (u_fn x)])).1 0
        ⟨le_rfl, zero_le_one⟩).2
      rw [norm_mul, norm_pow, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg ht.1]
      have ht2 : t ^ 2 ≤ 1 := by nlinarith [ht.1, ht.2]
      nlinarith [Real.exp_pos (R₀ + 1), norm_nonneg (skrCos2 ((t : ℂ) * u_fn x))]

  
  have hEntPair : ∀ (B L : ℝ), 0 ≤ B → 0 ≤ L →
      ∃ (B_ent L_ent : ℝ), 0 ≤ B_ent ∧ 0 ≤ L_ent ∧
        ∀ (σ' Δ : ℝ) (u₁ u₂ : ℂ → ℂ),
          0 < σ' → 0 ≤ Δ → PairBnd σ' Δ B L u₁ u₂ →
          PairBnd σ' Δ B_ent L_ent (fun z => skrExp1 (u₁ z)) (fun z => skrExp1 (u₂ z)) ∧
          PairBnd σ' Δ B_ent L_ent (fun z => skrRCos2 (u₁ z)) (fun z => skrRCos2 (u₂ z)) ∧
          PairBnd σ' Δ B_ent L_ent (fun z => skrRSinc (u₁ z)) (fun z => skrRSinc (u₂ z)) := by
    intro B L hB hL
    let R : ℝ := B + 1
    have hR_pos : 0 < R := by linarith
    let B_ent : ℝ := Real.exp R * skrCompConst m B
    let L_ent : ℝ := skrCompConst m B * ((2 : ℝ) ^ m * Real.exp R * L)
    have hBent_nn : 0 ≤ B_ent := mul_nonneg (Real.exp_nonneg R) (hCompConstNonneg m B)
    have hLent_nn : 0 ≤ L_ent := by
      refine mul_nonneg (hCompConstNonneg m B) ?_
      exact mul_nonneg (mul_nonneg (by positivity) (Real.exp_nonneg R)) hL
    refine ⟨B_ent, L_ent, hBent_nn, hLent_nn, ?_⟩
    intro σ' Δ u₁ u₂ hσ' hΔ hPu
    let V : Set ℂ := Metric.ball (0 : ℂ) R
    have hV_open : IsOpen V := Metric.isOpen_ball
    have hV_conv : Convex ℝ V := convex_ball (0 : ℂ) R
    have hScalePair : ∀ {t : ℝ}, t ∈ Set.Icc (0 : ℝ) 1 →
        PairBnd σ' Δ B L (fun z => (t : ℂ) * u₁ z) (fun z => (t : ℂ) * u₂ z) ∧
        (∀ z ∈ horizStrip σ', (t : ℂ) * u₁ z ∈ V ∧ (t : ℂ) * u₂ z ∈ V) := by
      intro t ht
      have ht_norm : ‖(t : ℂ)‖ ≤ 1 := by
        rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg ht.1]
        exact ht.2
      have hP_t := hPairConstMul (C := 1) rfl zero_le_one hB hL hΔ ht_norm hPu
      rw [one_mul, one_mul] at hP_t
      refine ⟨hP_t, fun z hz => ?_⟩
      have hu1 := hBndPt hP_t.1 z hz
      have hu2 := hBndPt hP_t.2.1 z hz
      exact ⟨Metric.mem_ball.mpr (by rw [dist_zero_right]; linarith),
