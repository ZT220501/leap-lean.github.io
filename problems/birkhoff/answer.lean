      have hRB_vb : lineCoreVanishesBelow (2 * (M - 1)) (B_s - B0 - B1 * Δd) := by
        have h := hSub.vanishesBelow_comp1D_taylor (by omega : 1 ≤ M - 1) (S_ser i)
          (h_step_tr_c0 i) hΔd_vb
        simpa only [hS_deriv i] using h
      have hDA_vb : lineCoreVanishesBelow (M - 1) (A - A0) :=
        h_vb_comp_sub (M - 1) (h_low i) (ψ0 + Δψ) ψ0 (by simpa using hΔψ_vb)
      have hDB_vb : lineCoreVanishesBelow (M - 1) (B_s - B0) :=
        h_vb_comp_sub (M - 1) (S_ser i) (d0 + Δd) d0 (by simpa using hΔd_vb)
      have hProd_vb : lineCoreVanishesBelow (2 * (M - 1)) ((A - A0) * (B_s - B0)) := by
        have h := hSub.vanishesBelow_mul hDA_vb hDB_vb
        simpa [two_mul] using h
      have hRA_B0 : lineCoreVanishesBelow (2 * (M - 1)) ((A - A0 - A1 * Δψ) * B0) := by
