    let e₁ : ℂ := Complex.exp (-((ϕ₁ : ℂ) * Complex.I))
    let e₂ : ℂ := Complex.exp (-((ϕ₂ : ℂ) * Complex.I))
    let g : ℂ → ℂ := fun ζ =>
      -2 * Complex.I * (A_amp : ℂ) * (Q_N (ζ * e₁) + Q_N (ζ * e₂))
    have hQ_diff : Differentiable ℂ Q_N := by
      intro w
