                stripMeshStep_ℂ J_C q W₁ d₁ j ζ - stripMeshStep_ℂ J_C q W₂ d₂ j ζ) z‖ ≤
            (1 / 4 : ℝ) * Δ_star + 2 * F_bd.C_force_lip * stripDiffSup (m + 15) σ W₁ W₂) ∧
        (∀ j : ℕ, j < q → ∀ k : ℕ, k ≤ m + 2 → ∀ z ∈ horizStrip σ_mesh,
          (q : ℝ) ^ 3 *
            ‖iteratedDeriv k
              (fun ζ =>
                (stripMeshStep_ℂ J_C q W₁ d₁ (j + 1) ζ - stripMeshStep_ℂ J_C q W₁ d₁ j ζ) -
                  (stripMeshStep_ℂ J_C q W₂ d₂ (j + 1) ζ - stripMeshStep_ℂ J_C q W₂ d₂ j ζ)) z‖ ≤
            (1 / 4 : ℝ) * Δ_star + 2 * F_bd.C_force_lip * stripDiffSup (m + 15) σ W₁ W₂) := by
    intro w₁ w₂ W₁ W₂ hw₁ hw₂ hW₁ hW₂ d₁ d₂ Δ_star hd₁ hd₂ hΔ_nonneg hΔ_d hΔ_step
    let Δ_W : ℝ := stripDiffSup (m + 15) σ W₁ W₂
    let M_f : ℝ := F_bd.C_force_lip * (Δ_star / (q : ℝ) ^ 6 + Δ_W / (q : ℝ) ^ 4)
    let f_diff : ℕ → ℂ → ℂ := fun i ζ =>
