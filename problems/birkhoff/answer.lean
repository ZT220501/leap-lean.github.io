        MvPowerSeries.coeff u (lcJetTruncAngles N₀ α_ser r) =
          if r.1 = 0 ∨ r.1 = k then MvPowerSeries.coeff u (α_ser r)
          else if u 0 + u 1 < N₀ then MvPowerSeries.coeff u (α_ser r)
          else 0 :=
      fun r u => MvPowerSeries.coeff_apply (lcJetTruncAngles N₀ α_ser r) u
    refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
    · intro r
      rw [h_tr_coeff]
      split_ifs <;> simp [hα_c0 r]
    · intro r u
      rw [h_tr_coeff]
      split_ifs with hr hu
      · rcases hr with hr0 | hrk
        · have h_eq : r = 0 := Fin.ext hr0
          rw [h_eq, hα_zero]
          exact hSub.X_mem F_val 0 u
        · have h_eq : r = Fin.last k := Fin.ext hrk
          rw [h_eq, hα_last]
          exact hSub.add_mem F_val (hSub.X_mem F_val 0) (hSub.X_mem F_val 1) u
      · exact hLow r u hu
      · exact F_val.zero_mem
    · ext u
      rw [map_sub, map_zero, h_tr_coeff]
      simp
    · ext u
      rw [map_sub, map_zero, h_tr_coeff]
      simp [Fin.last]
    · intro r u hu
      rw [map_sub, h_tr_coeff]
      split_ifs with hr
      · exact sub_self _
      · exact sub_self _
    · intro s d hd
      let r_int : Fin (k + 1) := ⟨s.1 + 1, by have := s.2; omega⟩
      have hr_not : ¬ (r_int.1 = 0 ∨ r_int.1 = k) := by
        dsimp only [r_int]; have := s.2; omega
      have hd_not : ¬ (d 0 + d 1 < N₀) := by omega
      change MvPowerSeries.coeff d (α_ser r_int - lcJetTruncAngles N₀ α_ser r_int) = _
      rw [map_sub, h_tr_coeff]
      simp only [hr_not, hd_not, ↓reduceIte, sub_zero]
      rfl
  
  have hStatRec : ∀ (N : ℕ),
      (∀ (i : Fin k) (m : ℕ), m ≤ max 2 (N + 1) → PowerSeries.coeff m (h_ser i) ∈ F_val) →
      ∀ (r : Fin (k + 1)) (d : Fin 2 →₀ ℕ), d 0 + d 1 ≤ N →
        MvPowerSeries.coeff d (α_ser r) ∈ F_val := by
    intro N
    induction N with
    | zero =>
        intro _ r d hd
        have hd0 : d = 0 := by
          ext j
          fin_cases j <;> simp <;> omega
        rw [hd0, hα_c0 r]
        exact F_val.zero_mem
    | succ N ih =>
        intro hJets
        let n : ℕ := N + 1
        have hn1 : 1 ≤ n := by omega
        have hIH : ∀ (r : Fin (k + 1)) (u : Fin 2 →₀ ℕ), u 0 + u 1 < n →
