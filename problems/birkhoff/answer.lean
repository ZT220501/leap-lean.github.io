        have h3 : (972 * B₀) / (q : ℝ) ^ 2 ≤ 972 * B₀ :=
          div_le_self (by positivity) hq2_ge1
        have h4 : ((972 * B₀) / (q : ℝ) ^ 2) * M ≤ 972 * B₀ * M :=
          mul_le_mul_of_nonneg_right h3 hM_nonneg
        linarith
      have h_d3 : |P₁ * (a₁ - a₂)| ≤ 2916 * L₀ * M := by
        rw [abs_mul, abs_of_nonneg hP₁_0]
        have h1 : P₁ * |a₁ - a₂| ≤ (2916 / (q : ℝ) ^ 3) * (L₀ * ((q : ℝ) * M)) :=
          mul_le_mul hP₁_hi ha_diff (abs_nonneg _) (by positivity)
        have h2 : (2916 / (q : ℝ) ^ 3) * (L₀ * ((q : ℝ) * M)) =
            ((2916 * L₀) / (q : ℝ) ^ 2) * M := by
          field_simp [hq_nz]
        have h3 : (2916 * L₀) / (q : ℝ) ^ 2 ≤ 2916 * L₀ :=
