            (hKit.mvDeriv_rules.2 hU_inter hp₁ (hCA_holo i α' k)).1,
            (hchain i hp₁.1 g k).1, ← mul_assoc,
            ← ((hKit.taylor2D_algebra hU_inter hp₁).2 (hCA_holo i α' k) (hA_inter i)).2.2]
        rw [hlhs]
        symm
        calc
          ∑ k ∈ Finset.range (α' + 2),
              taylor2D (webDiffCoeffA (pderivA (ψ i)) (w i) (α' + 1) k) p₁ * F k
              = (∑ k ∈ Finset.range (α' + 1),
                  taylor2D (webDiffCoeffA (pderivA (ψ i)) (w i) (α' + 1) (k + 1)) p₁ *
                    F (k + 1)) +
                taylor2D (webDiffCoeffA (pderivA (ψ i)) (w i) (α' + 1) 0) p₁ * F 0 :=
                Finset.sum_range_succ' _ (α' + 1)
          _ = (∑ k ∈ Finset.range (α' + 1),
                  (taylor2D (pderivA (webDiffCoeffA (pderivA (ψ i)) (w i) α' (k + 1))) p₁ *
                      F (k + 1) +
                    taylor2D (fun p => webDiffCoeffA (pderivA (ψ i)) (w i) α' k p *
                      pderivA (ψ i) p) p₁ * F (k + 1))) +
                taylor2D (pderivA (webDiffCoeffA (pderivA (ψ i)) (w i) α' 0)) p₁ * F 0 := by
                congr 1
                refine Finset.sum_congr rfl fun k _ => ?_
                have hmul_holo : DifferentiableOn ℂ
                    (fun p => webDiffCoeffA (pderivA (ψ i)) (w i) α' k p * pderivA (ψ i) p)
                    U_inter :=
                  (hCA_holo i α' k).mul (hA_inter i)
                have hadd := ((hKit.taylor2D_algebra hU_inter hp₁).2
                  ((hKit.pderiv_holo hU_inter (hCA_holo i α' (k + 1))).1) hmul_holo).1
                change taylor2D (fun p =>
                    pderivA (webDiffCoeffA (pderivA (ψ i)) (w i) α' (k + 1)) p +
                      webDiffCoeffA (pderivA (ψ i)) (w i) α' k p * pderivA (ψ i) p) p₁ *
                  F (k + 1) = _
                rw [hadd, add_mul]
          _ = ((∑ k ∈ Finset.range (α' + 1),
                  taylor2D (pderivA (webDiffCoeffA (pderivA (ψ i)) (w i) α' (k + 1))) p₁ *
                    F (k + 1)) +
                taylor2D (pderivA (webDiffCoeffA (pderivA (ψ i)) (w i) α' 0)) p₁ * F 0) +
              (∑ k ∈ Finset.range (α' + 1),
                taylor2D (fun p => webDiffCoeffA (pderivA (ψ i)) (w i) α' k p *
                  pderivA (ψ i) p) p₁ * F (k + 1)) := by
                rw [Finset.sum_add_distrib]
                abel
          _ = (∑ k ∈ Finset.range (α' + 2),
                taylor2D (pderivA (webDiffCoeffA (pderivA (ψ i)) (w i) α' k)) p₁ * F k) +
              (∑ k ∈ Finset.range (α' + 1),
                taylor2D (fun p => webDiffCoeffA (pderivA (ψ i)) (w i) α' k p *
                  pderivA (ψ i) p) p₁ * F (k + 1)) := by
                rw [← Finset.sum_range_succ'
                  (fun k => taylor2D (pderivA (webDiffCoeffA (pderivA (ψ i)) (w i) α' k)) p₁ * F k)
                  (α' + 1)]
          _ = (∑ k ∈ Finset.range (α' + 1),
                taylor2D (pderivA (webDiffCoeffA (pderivA (ψ i)) (w i) α' k)) p₁ * F k) +
              (∑ k ∈ Finset.range (α' + 1),
                taylor2D (fun p => webDiffCoeffA (pderivA (ψ i)) (w i) α' k p *
                  pderivA (ψ i) p) p₁ * F (k + 1)) := by
                congr 1
                rw [Finset.sum_range_succ, hCA_vanish i α' (α' + 1) (by omega), hpderivA_zero,
