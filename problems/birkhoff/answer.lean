      ∃ N₁ : ℕ, ∀ n ≥ N₁, ∀ p ∈ K, ‖P.S_seq n p - M.S_lim p‖ < ε := by
    intro hPt
    by_contra h_not
    have h_ex : ∀ N : ℕ, ∃ n ≥ N, ∃ p ∈ K, ε ≤ ‖P.S_seq n p - M.S_lim p‖ := by
      intro N
      by_contra! h_all
      exact h_not ⟨N, h_all⟩
    classical
    let stepN : ℕ → { n : ℕ // ∃ p ∈ K, ε ≤ ‖P.S_seq n p - M.S_lim p‖ } :=
      fun N => ⟨Classical.choose (h_ex N), (Classical.choose_spec (h_ex N)).2⟩
    have h_stepN_ge : ∀ N : ℕ, N ≤ (stepN N).1 :=
      fun N => (Classical.choose_spec (h_ex N)).1
    let φ₀ : ℕ → ℕ := fun k => Nat.recOn k (stepN 0).1 (fun _ prev => (stepN (prev + 1)).1)
    have hφ₀_mono : StrictMono φ₀ :=
      strictMono_nat_of_lt_succ fun k => Nat.lt_of_succ_le (h_stepN_ge (φ₀ k + 1))
    have hφ₀_bad : ∀ k : ℕ, ∃ p ∈ K, ε ≤ ‖P.S_seq (φ₀ k) p - M.S_lim p‖ := by
      intro k
      cases k with
      | zero => exact (stepN 0).2
      | succ k => exact (stepN (φ₀ k + 1)).2
    let p_seq_K : ℕ → ℂ × ℂ := fun k => Classical.choose (hφ₀_bad k)
    have hp_mem : ∀ k : ℕ, p_seq_K k ∈ K := fun k => (Classical.choose_spec (hφ₀_bad k)).1
    have hp_ge : ∀ k : ℕ, ε ≤ ‖P.S_seq (φ₀ k) (p_seq_K k) - M.S_lim (p_seq_K k)‖ :=
      fun k => (Classical.choose_spec (hφ₀_bad k)).2
    obtain ⟨p_star, hp_star_K, ψ₁, hψ₁_mono, hq_tend⟩ := hK_comp.tendsto_subseq hp_mem
    let T_star : ℂ := p_star.1
    let Y_star : ℂ := p_star.2
    let φ₁ : ℕ → ℕ := φ₀ ∘ ψ₁
    let q_k : ℕ → ℂ × ℂ := p_seq_K ∘ ψ₁
    have hφ₁_mono : StrictMono φ₁ := hφ₀_mono.comp hψ₁_mono
    have hp_star_cone := hK_sub hp_star_K
    have hT_star : ‖T_star‖ < T₀ := hp_star_cone.1
    have hY_star_im : D₀ < -Y_star.im := hp_star_cone.2.1
    have hY_star_re : |Y_star.re| < A₀ * (-Y_star.im) := hp_star_cone.2.2
    let ρ_T : ℝ := T₀ / 8
    let δ₀ : ℝ := min (D₀ / (4 * (A₀ + 4))) 1
    let R_top : ℝ := -Y_star.im + 10
    have hρ_pos : 0 < ρ_T := by dsimp [ρ_T]; positivity
    have hδ₀_pos : 0 < δ₀ := lt_min (by positivity) zero_lt_one
    have hδ₀_le_one : δ₀ ≤ 1 := min_le_right _ _
    have hδ₀_le_frac : δ₀ ≤ D₀ / (4 * (A₀ + 4)) := min_le_left _ _
    have hδ₀_prod : (A₀ + 4) * (2 * δ₀) ≤ D₀ / 2 := by
      have h4pos : (0 : ℝ) < 4 * (A₀ + 4) := by positivity
      have := (le_div_iff₀ h4pos).mp hδ₀_le_frac
      nlinarith
    have h2δ₀_le_D8 : 2 * δ₀ ≤ D₀ / 8 := by nlinarith
    have hR_top_gt : P.D_pass < R_top := by dsimp [R_top]; linarith
    obtain ⟨N_cone, hN_cone⟩ := P.trunc_passages R_top hR_top_gt
    let W_trunc : Set (ℂ × ℂ) :=
      { p : ℂ × ℂ |
        ‖p.1‖ < (3 / 2 : ℝ) * T₀ ∧
        P.D_pass / 2 < -p.2.im ∧ -p.2.im < R_top ∧
        |p.2.re| < (A₀ + 3) * (-p.2.im) }
    have h_poly_in : ∀ T Y : ℂ,
        T ∈ Metric.closedBall T_star (2 * ρ_T) →
        Y ∈ Metric.closedBall Y_star (2 * δ₀) →
        (T, Y) ∈ W_trunc ∧ 1 ≤ -Y.im := by
      intro T Y hT_cb hY_cb
      rw [Metric.mem_closedBall, dist_eq_norm] at hT_cb hY_cb
      have hT_norm : ‖T‖ < (3 / 2 : ℝ) * T₀ := by
        have h1 : ‖T‖ ≤ ‖T - T_star‖ + ‖T_star‖ := norm_le_norm_sub_add T T_star
        dsimp [ρ_T] at hT_cb
        linarith
      have him_diff : |Y.im - Y_star.im| ≤ 2 * δ₀ :=
        le_trans (Complex.abs_im_le_norm (Y - Y_star)) hY_cb
      have hre_diff : |Y.re - Y_star.re| ≤ 2 * δ₀ :=
        le_trans (Complex.abs_re_le_norm (Y - Y_star)) hY_cb
      rw [abs_le] at him_diff hre_diff
      have hY_im_lo : P.D_pass / 2 < -Y.im := by linarith
      have hY_im_ge1 : 1 ≤ -Y.im := by linarith
      have hY_im_hi : -Y.im < R_top := by dsimp [R_top]; linarith
      have hY_re : |Y.re| < (A₀ + 3) * (-Y.im) := by
        have hre1 : |Y.re| ≤ |Y_star.re| + 2 * δ₀ := by
          rw [abs_le]
          constructor <;> linarith [le_abs_self Y_star.re, neg_abs_le Y_star.re]
        have h_rhs : (A₀ + 3) * (-Y_star.im - 2 * δ₀) ≤ (A₀ + 3) * (-Y.im) := by nlinarith
        nlinarith
      exact ⟨⟨hT_norm, hY_im_lo, hY_im_hi, hY_re⟩, hY_im_ge1⟩
    let M_star : ℝ := P.C_pass * ((3 / 2 : ℝ) * T₀) ^ 2
    have hC_pass_pos : 0 < P.C_pass := P.C_pass_pos
    have hM_star_pos : 0 < M_star := by dsimp [M_star]; positivity
    have h_lip_slice : ∀ n ≥ N_cone, ∀ T Y : ℂ,
        T ∈ Metric.ball T_star ρ_T → Y ∈ Metric.ball Y_star δ₀ →
        ‖P.S_seq n (T, Y) - P.S_seq n (T_star, Y_star)‖ ≤
          (M_star / ρ_T) * ‖T - T_star‖ + (M_star / δ₀ + 1) * ‖Y - Y_star‖ := by
      intro n hn T Y hT_b hY_b
      obtain ⟨hS_holo, hS_bnd, _⟩ := hN_cone n hn
      have hY_cb2 : Y ∈ Metric.closedBall Y_star (2 * δ₀) :=
        Metric.ball_subset_closedBall (Metric.ball_subset_ball (by linarith) hY_b)
      have hT_star_cb2 : T_star ∈ Metric.closedBall T_star (2 * ρ_T) :=
        Metric.mem_closedBall_self (by positivity)
      let g₁ : ℂ → ℂ := fun T' => P.S_seq n (T', Y) - Y
      have hg₁_holo : DifferentiableOn ℂ g₁ (Metric.closedBall T_star (2 * ρ_T)) := by
        refine DifferentiableOn.sub ?_ (differentiableOn_const Y)
        exact hS_holo.comp (differentiable_id.prodMk (differentiable_const Y)).differentiableOn
          (fun T' hT' => (h_poly_in T' Y hT' hY_cb2).1)
      have hg₁_bnd : ∀ T' ∈ Metric.closedBall T_star (2 * ρ_T), ‖g₁ T'‖ ≤ M_star := by
        intro T' hT'
        obtain ⟨h_in, h_im1⟩ := h_poly_in T' Y hT' hY_cb2
        have hb := (hS_bnd T' Y h_in.1 h_in.2.1 h_in.2.2.1 h_in.2.2.2).2
        have hrpow : (-Y.im) ^ (1 - 2 * α) ≤ 1 :=
          Real.rpow_le_one_of_one_le_of_nonpos h_im1 (by linarith)
        have hsq : ‖T'‖ ^ 2 ≤ ((3 / 2 : ℝ) * T₀) ^ 2 :=
          pow_le_pow_left₀ (norm_nonneg T') h_in.1.le 2
        calc ‖g₁ T'‖ ≤ P.C_pass * ‖T'‖ ^ 2 * (-Y.im) ^ (1 - 2 * α) := hb
          _ ≤ P.C_pass * ((3 / 2 : ℝ) * T₀) ^ 2 * 1 := by gcongr
          _ = M_star := mul_one _
      have hg₁_deriv : ∀ T' ∈ Metric.ball T_star ρ_T, ‖deriv g₁ T'‖ ≤ M_star / ρ_T := by
        intro T' hT'
        have hsub : Metric.closedBall T' ρ_T ⊆ Metric.closedBall T_star (2 * ρ_T) := by
          intro w hw
          rw [Metric.mem_closedBall] at hw ⊢
          calc dist w T_star ≤ dist w T' + dist T' T_star := dist_triangle _ _ _
            _ ≤ ρ_T + ρ_T := add_le_add hw (Metric.mem_ball.mp hT').le
            _ = 2 * ρ_T := by ring
        exact Complex.norm_deriv_le_of_forall_mem_sphere_norm_le hρ_pos
          ((hg₁_holo.mono hsub).diffContOnCl_ball Set.Subset.rfl)
          (fun w hw => hg₁_bnd w (hsub (Metric.sphere_subset_closedBall hw)))
      have hg₁_lip : ‖g₁ T - g₁ T_star‖ ≤ (M_star / ρ_T) * ‖T - T_star‖ :=
        (convex_ball T_star ρ_T).norm_image_sub_le_of_norm_deriv_le
          (fun _ hT' => (hg₁_holo.mono Metric.ball_subset_closedBall |>.mono
            (Metric.ball_subset_ball (by linarith))).differentiableAt (Metric.isOpen_ball.mem_nhds hT'))
          hg₁_deriv (Metric.mem_ball_self hρ_pos) hT_b
      let g₂ : ℂ → ℂ := fun Y' => P.S_seq n (T_star, Y') - Y'
      have hg₂_holo : DifferentiableOn ℂ g₂ (Metric.closedBall Y_star (2 * δ₀)) := by
        refine DifferentiableOn.sub ?_ differentiableOn_id
        exact hS_holo.comp ((differentiable_const T_star).prodMk differentiable_id).differentiableOn
          (fun Y' hY' => (h_poly_in T_star Y' hT_star_cb2 hY').1)
      have hg₂_bnd : ∀ Y' ∈ Metric.closedBall Y_star (2 * δ₀), ‖g₂ Y'‖ ≤ M_star := by
        intro Y' hY'
        obtain ⟨h_in, h_im1⟩ := h_poly_in T_star Y' hT_star_cb2 hY'
        have hb := (hS_bnd T_star Y' h_in.1 h_in.2.1 h_in.2.2.1 h_in.2.2.2).2
        have hrpow : (-Y'.im) ^ (1 - 2 * α) ≤ 1 :=
          Real.rpow_le_one_of_one_le_of_nonpos h_im1 (by linarith)
        have hsq : ‖T_star‖ ^ 2 ≤ ((3 / 2 : ℝ) * T₀) ^ 2 :=
          pow_le_pow_left₀ (norm_nonneg T_star) h_in.1.le 2
        calc ‖g₂ Y'‖ ≤ P.C_pass * ‖T_star‖ ^ 2 * (-Y'.im) ^ (1 - 2 * α) := hb
          _ ≤ P.C_pass * ((3 / 2 : ℝ) * T₀) ^ 2 * 1 := by gcongr
          _ = M_star := mul_one _
      have hg₂_deriv : ∀ Y' ∈ Metric.ball Y_star δ₀, ‖deriv g₂ Y'‖ ≤ M_star / δ₀ := by
        intro Y' hY'
        have hsub : Metric.closedBall Y' δ₀ ⊆ Metric.closedBall Y_star (2 * δ₀) := by
          intro w hw
          rw [Metric.mem_closedBall] at hw ⊢
          calc dist w Y_star ≤ dist w Y' + dist Y' Y_star := dist_triangle _ _ _
            _ ≤ δ₀ + δ₀ := add_le_add hw (Metric.mem_ball.mp hY').le
            _ = 2 * δ₀ := by ring
        exact Complex.norm_deriv_le_of_forall_mem_sphere_norm_le hδ₀_pos
          ((hg₂_holo.mono hsub).diffContOnCl_ball Set.Subset.rfl)
          (fun w hw => hg₂_bnd w (hsub (Metric.sphere_subset_closedBall hw)))
      have hg₂_lip : ‖g₂ Y - g₂ Y_star‖ ≤ (M_star / δ₀) * ‖Y - Y_star‖ :=
        (convex_ball Y_star δ₀).norm_image_sub_le_of_norm_deriv_le
          (fun _ hY' => (hg₂_holo.mono Metric.ball_subset_closedBall |>.mono
            (Metric.ball_subset_ball (by linarith))).differentiableAt (Metric.isOpen_ball.mem_nhds hY'))
          hg₂_deriv (Metric.mem_ball_self hδ₀_pos) hY_b
      have h_decomp : P.S_seq n (T, Y) - P.S_seq n (T_star, Y_star) =
          (g₁ T - g₁ T_star) + (g₂ Y - g₂ Y_star) + (Y - Y_star) := by
        dsimp [g₁, g₂]
        ring
      rw [h_decomp]
      calc ‖(g₁ T - g₁ T_star) + (g₂ Y - g₂ Y_star) + (Y - Y_star)‖
          ≤ ‖g₁ T - g₁ T_star‖ + ‖g₂ Y - g₂ Y_star‖ + ‖Y - Y_star‖ := norm_add₃_le
        _ ≤ (M_star / ρ_T) * ‖T - T_star‖ + (M_star / δ₀) * ‖Y - Y_star‖ + ‖Y - Y_star‖ :=
            add_le_add (add_le_add hg₁_lip hg₂_lip) le_rfl
        _ = (M_star / ρ_T) * ‖T - T_star‖ + (M_star / δ₀ + 1) * ‖Y - Y_star‖ := by ring
    have h_pt_conv : Filter.Tendsto (fun n => P.S_seq n p_star) Filter.atTop
        (nhds (M.S_lim p_star)) := by
      by_cases hT0 : T_star = 0
      · have hS_lim0 : M.S_lim p_star = Y_star := by
          change M.S_lim (T_star, Y_star) = Y_star
          rw [hT0]
          exact M.S_lim_zero Y_star (lt_of_le_of_lt hD₀_mod hY_star_im) hY_star_re
        rw [hS_lim0]
        refine tendsto_const_nhds.congr' ?_
        filter_upwards [Filter.eventually_ge_atTop N_cone] with n hn
        obtain ⟨_, _, hS0⟩ := hN_cone n hn
        obtain ⟨h_in, _⟩ := h_poly_in T_star Y_star
          (Metric.mem_closedBall_self (by positivity))
          (Metric.mem_closedBall_self (by positivity))
        change Y_star = P.S_seq n (T_star, Y_star)
        rw [hT0]
        exact (hS0 Y_star h_in.2.1 h_in.2.2.1 h_in.2.2.2).symm
      · exact hPt T_star Y_star hT_star hT0 hY_star_im hY_star_re
    have h_sub_pt : Filter.Tendsto (fun k => P.S_seq (φ₁ k) p_star) Filter.atTop
        (nhds (M.S_lim p_star)) := h_pt_conv.comp hφ₁_mono.tendsto_atTop
    have hΩ_mod_open : IsOpen
        { p : ℂ × ℂ | ‖p.1‖ < T₀ ∧ M.D_mod < -p.2.im ∧ |p.2.re| < A₀ * (-p.2.im) } := by
      simp only [Set.ofPred_and]
      refine IsOpen.inter (by apply isOpen_lt <;> fun_prop) ?_
      exact IsOpen.inter (by apply isOpen_lt <;> fun_prop) (by apply isOpen_lt <;> fun_prop)
    have hM_cont : Filter.Tendsto (fun k => M.S_lim (q_k k)) Filter.atTop
        (nhds (M.S_lim p_star)) := by
      have hp_mod : p_star ∈
          { p : ℂ × ℂ | ‖p.1‖ < T₀ ∧ M.D_mod < -p.2.im ∧ |p.2.re| < A₀ * (-p.2.im) } :=
        ⟨hT_star, lt_of_le_of_lt hD₀_mod hY_star_im, hY_star_re⟩
      exact (M.S_lim_holo.continuousOn.continuousAt (hΩ_mod_open.mem_nhds hp_mod)).tendsto.comp
        hq_tend
    have hq1_tend : Filter.Tendsto (fun k => ‖(q_k k).1 - T_star‖) Filter.atTop (nhds 0) :=
      tendsto_iff_norm_sub_tendsto_zero.mp (continuous_fst.continuousAt.tendsto.comp hq_tend)
    have hq2_tend : Filter.Tendsto (fun k => ‖(q_k k).2 - Y_star‖) Filter.atTop (nhds 0) :=
      tendsto_iff_norm_sub_tendsto_zero.mp (continuous_snd.continuousAt.tendsto.comp hq_tend)
    have h_diff_S : Filter.Tendsto
        (fun k => ‖P.S_seq (φ₁ k) (q_k k) - P.S_seq (φ₁ k) p_star‖) Filter.atTop (nhds 0) := by
      have h_upper_tend : Filter.Tendsto
          (fun k => (M_star / ρ_T) * ‖(q_k k).1 - T_star‖ +
            (M_star / δ₀ + 1) * ‖(q_k k).2 - Y_star‖)
          Filter.atTop (nhds 0) := by
        simpa using (hq1_tend.const_mul (M_star / ρ_T)).add (hq2_tend.const_mul (M_star / δ₀ + 1))
      refine squeeze_zero' (Filter.Eventually.of_forall fun _ => norm_nonneg _) ?_ h_upper_tend
      have ev_N : ∀ᶠ k in Filter.atTop, N_cone ≤ φ₁ k :=
        hφ₁_mono.tendsto_atTop.eventually (Filter.eventually_ge_atTop N_cone)
      have ev_T : ∀ᶠ k in Filter.atTop, (q_k k).1 ∈ Metric.ball T_star ρ_T :=
        (continuous_fst.continuousAt.tendsto.comp hq_tend).eventually (Metric.ball_mem_nhds T_star hρ_pos)
      have ev_Y : ∀ᶠ k in Filter.atTop, (q_k k).2 ∈ Metric.ball Y_star δ₀ :=
        (continuous_snd.continuousAt.tendsto.comp hq_tend).eventually (Metric.ball_mem_nhds Y_star hδ₀_pos)
      filter_upwards [ev_N, ev_T, ev_Y] with k hkN hkT hkY
      exact h_lip_slice (φ₁ k) hkN (q_k k).1 (q_k k).2 hkT hkY
    have h_total_zero : Filter.Tendsto
        (fun k => ‖P.S_seq (φ₁ k) (q_k k) - M.S_lim (q_k k)‖) Filter.atTop (nhds 0) := by
      have h2 : Filter.Tendsto (fun k => ‖P.S_seq (φ₁ k) p_star - M.S_lim p_star‖)
          Filter.atTop (nhds 0) := tendsto_iff_norm_sub_tendsto_zero.mp h_sub_pt
      have h3 : Filter.Tendsto (fun k => ‖M.S_lim p_star - M.S_lim (q_k k)‖)
          Filter.atTop (nhds 0) := by
        simpa [norm_sub_rev] using tendsto_iff_norm_sub_tendsto_zero.mp hM_cont
      refine squeeze_zero' (Filter.Eventually.of_forall fun _ => norm_nonneg _) ?_
        (by simpa using (h_diff_S.add h2).add h3)
      refine Filter.Eventually.of_forall fun k => ?_
      have h_eq : P.S_seq (φ₁ k) (q_k k) - M.S_lim (q_k k) =
          (P.S_seq (φ₁ k) (q_k k) - P.S_seq (φ₁ k) p_star) +
          (P.S_seq (φ₁ k) p_star - M.S_lim p_star) +
          (M.S_lim p_star - M.S_lim (q_k k)) := by ring
      rw [h_eq]
      exact norm_add₃_le
    obtain ⟨k₀, hk₀⟩ := (h_total_zero.eventually (gt_mem_nhds hε)).exists
    exact absurd hk₀ (not_lt_of_ge (hp_ge (ψ₁ k₀)))
  
  have h_s2 : ∀ (T_star : ℂ), ‖T_star‖ < T₀ → ∀ (φ₁ : ℕ → ℕ), StrictMono φ₁ →
      ∃ (ψ : ℕ → ℕ) (S_star : ℂ → ℂ),
        StrictMono ψ ∧
        DifferentiableOn ℂ S_star { Y : ℂ | D₀ < -Y.im ∧ |Y.re| < (A₀ + 2) * (-Y.im) } ∧
        TendstoLocallyUniformlyOn (fun k Y => P.S_seq (φ₁ (ψ k)) (T_star, Y)) S_star
          Filter.atTop { Y : ℂ | D₀ < -Y.im ∧ |Y.re| < (A₀ + 2) * (-Y.im) } ∧
        TendstoLocallyUniformlyOn
          (fun k Y => deriv (fun Y' => P.S_seq (φ₁ (ψ k)) (T_star, Y')) Y) (deriv S_star)
          Filter.atTop { Y : ℂ | D₀ < -Y.im ∧ |Y.re| < (A₀ + 2) * (-Y.im) } ∧
        (∀ Y : ℂ, D₀ < -Y.im → |Y.re| < (A₀ + 2) * (-Y.im) →
          ‖S_star Y - Y‖ ≤ (P.C_pass * T₀ ^ 2 + 1) * (-Y.im) ^ (1 - 2 * α)) := by
    intro T_star hT_star φ₁ hφ₁
    classical
    have hC_pass_pos : 0 < P.C_pass := P.C_pass_pos
    let C₂ : Set ℂ := { Y : ℂ | D₀ < -Y.im ∧ |Y.re| < (A₀ + 2) * (-Y.im) }
    let U_m : ℕ → Set ℂ := fun m =>
      { Y : ℂ | D₀ < -Y.im ∧ -Y.im < D₀ + (m : ℝ) + 2 ∧ |Y.re| < (A₀ + 2) * (-Y.im) }
    let K_m : ℕ → Set ℂ := fun m =>
      { Y : ℂ |
        D₀ + 1 / ((m : ℝ) + 1) ≤ -Y.im ∧
        -Y.im ≤ D₀ + (m : ℝ) + 1 ∧
        |Y.re| ≤ (A₀ + 2 - 1 / ((m : ℝ) + 1)) * (-Y.im) }
    have hUm_open : ∀ m : ℕ, IsOpen (U_m m) := by
      intro m
      dsimp [U_m]
      simp only [Set.ofPred_and]
      refine IsOpen.inter (by apply isOpen_lt <;> fun_prop) ?_
      exact IsOpen.inter (by apply isOpen_lt <;> fun_prop) (by apply isOpen_lt <;> fun_prop)
    have hUm_sub : ∀ m : ℕ, U_m m ⊆ C₂ := fun _ _ hz => ⟨hz.1, hz.2.2⟩
    have hUm_conv : ∀ m : ℕ, Convex ℝ (U_m m) := by
      intro m
      rw [convex_iff_forall_pos]
      intro x hx y hy a b ha hb _
      have him : -(a • x + b • y).im = a * (-x.im) + b * (-y.im) := by
        simp [Complex.add_im, Complex.real_smul]; ring
      have hre : (a • x + b • y).re = a * x.re + b * y.re := by
        simp [Complex.add_re, Complex.real_smul]
      refine ⟨?_, ?_, ?_⟩
      · rw [him]; nlinarith [hx.1, hy.1]
      · rw [him]; nlinarith [hx.2.1, hy.2.1]
      · rw [hre, him]
        calc |a * x.re + b * y.re| ≤ |a * x.re| + |b * y.re| := abs_add_le _ _
          _ = a * |x.re| + b * |y.re| := by rw [abs_mul, abs_mul, abs_of_pos ha, abs_of_pos hb]
          _ < a * ((A₀ + 2) * (-x.im)) + b * ((A₀ + 2) * (-y.im)) :=
              add_lt_add (mul_lt_mul_of_pos_left hx.2.2 ha) (mul_lt_mul_of_pos_left hy.2.2 hb)
          _ = (A₀ + 2) * (a * (-x.im) + b * (-y.im)) := by ring
    have hKm_comp : ∀ m : ℕ, IsCompact (K_m m) := by
      intro m
      refine Metric.isCompact_of_isClosed_isBounded ?_ ?_
      · dsimp [K_m]
        simp only [Set.ofPred_and]
        refine IsClosed.inter (by apply isClosed_le <;> fun_prop) ?_
        exact IsClosed.inter (by apply isClosed_le <;> fun_prop) (by apply isClosed_le <;> fun_prop)
      · rw [isBounded_iff_forall_norm_le]
        refine ⟨(A₀ + 3) * (D₀ + (m : ℝ) + 1), ?_⟩
        intro Y hY
        have h1_pos : (0 : ℝ) < 1 / ((m : ℝ) + 1) := by positivity
        have him_pos : 0 < -Y.im := lt_of_lt_of_le (by linarith) hY.1
        have habs_im : |Y.im| = -Y.im := by rw [abs_of_neg (by linarith)]
        have hre_le : |Y.re| ≤ (A₀ + 2) * (D₀ + (m : ℝ) + 1) := by
          calc |Y.re| ≤ (A₀ + 2 - 1 / ((m : ℝ) + 1)) * (-Y.im) := hY.2.2
            _ ≤ (A₀ + 2) * (-Y.im) := by nlinarith
            _ ≤ (A₀ + 2) * (D₀ + (m : ℝ) + 1) :=
                mul_le_mul_of_nonneg_left hY.2.1 (by positivity)
        have hnorm : ‖Y‖ ≤ |Y.re| + |Y.im| := Complex.norm_le_abs_re_add_abs_im Y
        linarith [hY.2.1]
    have hKm_sub_Um : ∀ m : ℕ, K_m m ⊆ U_m m := by
      intro m Y hY
      have h1_pos : (0 : ℝ) < 1 / ((m : ℝ) + 1) := by positivity
      have him_gt : D₀ < -Y.im := lt_of_lt_of_le (by linarith) hY.1
      have him_pos : 0 < -Y.im := by linarith
      refine ⟨him_gt, by linarith [hY.2.1], ?_⟩
      exact lt_of_le_of_lt hY.2.2 (by nlinarith)
    have hKm_nhds : ∀ Y ∈ C₂, ∃ m : ℕ, K_m m ∈ nhdsWithin Y C₂ := by
      intro Y hY
      let gap1 : ℝ := -Y.im - D₀
      let gap2 : ℝ := (A₀ + 2) * (-Y.im) - |Y.re|
      have hgap1 : 0 < gap1 := by dsimp [gap1]; linarith [hY.1]
      have hgap2 : 0 < gap2 := by dsimp [gap2]; linarith [hY.2]
      have him_pos : 0 < -Y.im := by linarith [hY.1]
      obtain ⟨m, hm⟩ := exists_nat_gt (max (1 / gap1) (max gap1 ((-Y.im) / gap2)))
      refine ⟨m, ?_⟩
      let O_m : Set ℂ :=
        { Z : ℂ |
          D₀ + 1 / ((m : ℝ) + 1) < -Z.im ∧
          -Z.im < D₀ + (m : ℝ) + 1 ∧
          |Z.re| < (A₀ + 2 - 1 / ((m : ℝ) + 1)) * (-Z.im) }
      have hOm_open : IsOpen O_m := by
        dsimp [O_m]
        simp only [Set.ofPred_and]
        refine IsOpen.inter (by apply isOpen_lt <;> fun_prop) ?_
