      rwa [hΦ_p₀] at h
    have hy_hit_0 : y_hit 0 = s₀ := by simp [y_hit, hΨ_0]
    have hΨ_fderiv : HasFDerivAt Ψ (ContinuousLinearMap.id ℂ (ℂ × ℂ)) (s₀, 0) := by
      have h := hStrictΦ.to_localInverse.hasFDerivAt
