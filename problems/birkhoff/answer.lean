                _ ≤ C_base * (δ_ceil ^ (2 * α) * B ^ 2 * ‖t‖ ^ 2 * (D (j + 2)) ^ (-2 * α)) :=
                    mul_le_mul_of_nonneg_left h1 hC_base_pos.le
                _ = C_base * δ_ceil ^ (2 * α) * B ^ 2 * ‖t‖ ^ 2 * (D (j + 2)) ^ (-2 * α) := by
                    ring
            let gJ : ℕ → ℝ := fun i =>
              (D (j + 2) + (((i + 1 : ℕ) : ℝ)) * t.im) ^ (-(2 * α + 1))
            have h_refl_J : ∑ m ∈ Finset.range (j + 1), (D (m + 1)) ^ (-2 * α - 1) =
                ∑ i ∈ Finset.range (j + 1), gJ i := by
              rw [← Finset.sum_range_reflect gJ (j + 1)]
              refine Finset.sum_congr rfl ?_
              intro m hm
              have hm_lt : m < j + 1 := Finset.mem_range.mp hm
