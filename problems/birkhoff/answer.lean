      · simpa [w_seed] using hlog_half_lt_58
      · simpa [w_seed] using hlog_58_lt_1316
      · simp [w_seed]; linarith
      · simp [w_seed]; linarith
    filter_upwards [(hR_seed_open.prod Metric.isOpen_ball).mem_nhds hw_seed_mem] with q hq
    let w' := q.1
    let t := q.2
    have hw'_lo : ρ₀ / 2 < ‖Complex.exp w'‖ := by
