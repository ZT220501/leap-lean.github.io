        _ ≤ ‖h_y z‖ + ‖z ^ 2 * V₀‖ := norm_sub_le _ _
        _ = ‖h_y z‖ + R₀ ^ 2 * ‖V₀‖ := by rw [norm_mul, norm_pow, hz_norm]
        _ ≤ M_err + M_err := add_le_add (hh_bound z (le_of_eq hz_norm)) hV₀_bound
        _ = 2 * M_err := by ring
    exact (le_div_iff₀ (pow_pos hR₀_pos 4)).mpr (by linarith)

  
  let z_par : ℝ := |t| * N k / Real.exp (-k)
  have hz_pos : 0 < z_par := div_pos (mul_pos ht_pos hNk_pos) hexp_pos
  have ht_le_half_r : |t| ≤ r / 2 := by
    have ht_eq : |t| = (z_par * b / c₀) * r := by
      dsimp [z_par, r, B]
      field_simp [hNk_pos.ne', hexp_pos.ne', hc₀_pos.ne', hb_pos.ne']
    have hcoef : z_par * b / c₀ ≤ 1 / 2 := by
      rw [div_le_iff₀ hc₀_pos]
      dsimp [c_tay] at hzb
      linarith
    rw [ht_eq]
    have h1 := mul_le_mul_of_nonneg_right hcoef hr_pos.le
    linarith
  have ht_le_R₀ : |t| ≤ R₀ := by dsimp [R₀]; linarith
  have ht_lt_r : |t| < r := lt_of_le_of_lt ht_le_R₀ hR₀_lt
  have ht_norm : ‖(t : ℂ)‖ = |t| := Complex.norm_real t
  have ht_cl : (t : ℂ) ∈ closure (Metric.ball (0 : ℂ) R₀) := by
    rw [closure_ball (0 : ℂ) hR₀_pos.ne', Metric.mem_closedBall, dist_zero_right, ht_norm]
    exact ht_le_R₀
  have hG₄_t : ‖G₄ (t : ℂ)‖ ≤ 2 * M_err / R₀ ^ 4 :=
    Complex.norm_le_of_forall_mem_frontier_norm_le Metric.isBounded_ball hG₄_dc hG₄_front ht_cl
  have hG₀_t_bound : ‖G₀ (t : ℂ)‖ ≤
      (512 * C_cp / (9 * c₀ ^ 2)) * Real.exp (-k) * z_par ^ 4 * b ^ 4 := by
    have h1 : ‖G₀ (t : ℂ)‖ ≤ 2 * M_err * (|t| / R₀) ^ 4 := by
      calc
        ‖G₀ (t : ℂ)‖ = ‖(t : ℂ) ^ 4 * G₄ (t : ℂ)‖ := by rw [hG₀_eq_quart (t : ℂ)]
        _ = |t| ^ 4 * ‖G₄ (t : ℂ)‖ := by rw [norm_mul, norm_pow, ht_norm]
        _ ≤ |t| ^ 4 * (2 * M_err / R₀ ^ 4) :=
            mul_le_mul_of_nonneg_left hG₄_t (pow_nonneg (abs_nonneg t) 4)
        _ = 2 * M_err * (|t| / R₀) ^ 4 := by ring
    have h2 : 2 * M_err * (|t| / R₀) ^ 4 =
        (512 * C_cp / (9 * c₀ ^ 2)) * Real.exp (-k) * z_par ^ 4 * b ^ 4 := by
      have hrat : |t| / R₀ = 4 * z_par * b / (3 * c₀) := by
        dsimp [z_par, R₀, r, B]
        field_simp [hNk_pos.ne', hexp_pos.ne', hc₀_pos.ne', hb_pos.ne']
      rw [hrat]
      dsimp [M_err]
      field_simp [hc₀_pos.ne']
      ring
    linarith
  have ht_ball_rstar : (t : ℂ) ∈ Metric.ball (0 : ℂ) S.r_star := by
    rw [Metric.mem_ball, dist_zero_right, ht_norm]
    exact ht_lt
  have hhX_t_bounds := S.h_X_bounds (t : ℂ) ht_ball_rstar
  have hy_im_lt_hX : y.im < S.h_X (t : ℂ) := by
    rw [hy_im]
    linarith [hΔ, hexp_pos]
  have hyt_tube : (y, (t : ℂ)) ∈ finiteWallTube S.r_star S.h_X := by
    refine ⟨?_, ?_, hy_im_lt_hX⟩
    · rw [ht_norm]; exact ht_lt
    · rw [Complex.conj_ofReal]
      linarith [hhX_t_bounds.1, S.s_star_pos, hy_im_pos]
  have ht_ball_r : (t : ℂ) ∈ Metric.ball (0 : ℂ) r := by
    rw [Metric.mem_ball, dist_zero_right, ht_norm]
    exact ht_lt_r
  have hhy_t_eq : h_y (t : ℂ) = S.𝔰 (y, (t : ℂ)) - y := by
    obtain ⟨hc1, hc2, hc3, hc4⟩ := hy_cone_mem (t : ℂ) ht_ball_r
    have heq := (hs_props (y, (t : ℂ)) hc1 hc2 hc3 hc4).2.2.2.2 hyt_tube
    dsimp [h_y]
    rw [heq]
  have hstrip_at_t : (S.𝔰 (y, (t : ℂ)) - y).im ≤ S.H - S.h_X (t : ℂ) :=
    hStrip t ht_lt y hy_im_pos hy_im_lt_hX
  have ht2_V_im : t ^ 2 * (S.V y).im ≤
      (S.H - S.h_X (t : ℂ)) +
        (512 * C_cp / (9 * c₀ ^ 2)) * Real.exp (-k) * z_par ^ 4 * b ^ 4 := by
    have hG₀_im : (G₀ (t : ℂ)).im = (S.𝔰 (y, (t : ℂ)) - y).im - t ^ 2 * (S.V y).im := by
      dsimp [G₀, V₀]
      rw [hhy_t_eq, Complex.sub_im, ← Complex.ofReal_pow t 2, Complex.im_ofReal_mul]
    have hneg_im : -(G₀ (t : ℂ)).im ≤ ‖G₀ (t : ℂ)‖ :=
      le_trans (neg_le_abs _) (Complex.abs_im_le_norm _)
    linarith
  have ht2_pos : 0 < t ^ 2 := by
    rw [← sq_abs]
    exact pow_pos ht_pos 2
  have hΔ_nonneg : 0 ≤ S.H - S.h_X (t : ℂ) := by linarith [hhX_t_bounds.2]
  let R_num : ℝ := (S.H - S.h_X (t : ℂ)) +
    (512 * C_cp / (9 * c₀ ^ 2)) * Real.exp (-k) * z_par ^ 4 * b ^ 4
  have hR_num_nn : 0 ≤ R_num := by
    dsimp [R_num]
    positivity
  have hmax_V_le : max ((S.V y).im) 0 ≤ R_num / t ^ 2 := by
    refine max_le ?_ (div_nonneg hR_num_nn ht2_pos.le)
    rw [le_div_iff₀ ht2_pos]
    dsimp [R_num]
    linarith [ht2_V_im]
  have hscale_V : Real.exp (-k) * max ((S.V y).im) 0 / (N k) ^ 2 ≤
      (Real.exp (-k) / (N k) ^ 2) * (R_num / t ^ 2) := by
    have h1 := mul_le_mul_of_nonneg_left hmax_V_le (div_nonneg hexp_pos.le (sq_nonneg (N k)))
    calc
      Real.exp (-k) * max ((S.V y).im) 0 / (N k) ^ 2 =
          (Real.exp (-k) / (N k) ^ 2) * max ((S.V y).im) 0 := by ring
      _ ≤ (Real.exp (-k) / (N k) ^ 2) * (R_num / t ^ 2) := h1
  have halg_split : (Real.exp (-k) / (N k) ^ 2) * (R_num / t ^ 2) =
      ((S.H - S.h_X (t : ℂ)) / Real.exp (-k)) / z_par ^ 2 +
        (512 * C_cp / (9 * c₀ ^ 2)) * (z_par ^ 2 * b ^ 4) := by
    have hz2_eq : z_par ^ 2 = t ^ 2 * (N k) ^ 2 / (Real.exp (-k)) ^ 2 := by
      dsimp [z_par]
      rw [div_pow, mul_pow, sq_abs]
    have hz4_eq : z_par ^ 4 = z_par ^ 2 * z_par ^ 2 := by ring
    dsimp [R_num]
    rw [hz4_eq, hz2_eq]
    field_simp [hexp_pos.ne', hNk_pos.ne', ht2_pos.ne']
  have hterm1_nn : 0 ≤ ((S.H - S.h_X (t : ℂ)) / Real.exp (-k)) / z_par ^ 2 :=
    div_nonneg (div_nonneg hΔ_nonneg hexp_pos.le) (sq_nonneg z_par)
  have hterm2_nn : 0 ≤ z_par ^ 2 * b ^ 4 := by positivity
  calc
    Real.exp (-k) * max ((S.V (bootRowPt S k x)).im) 0 / (N k) ^ 2
        ≤ ((S.H - S.h_X (t : ℂ)) / Real.exp (-k)) / z_par ^ 2 +
            (512 * C_cp / (9 * c₀ ^ 2)) * (z_par ^ 2 * b ^ 4) := by
          dsimp [y] at hscale_V
          linarith [hscale_V, halg_split]
    _ ≤ C_tay * (((S.H - S.h_X (t : ℂ)) / Real.exp (-k)) / z_par ^ 2) +
          C_tay * (z_par ^ 2 * b ^ 4) := by
          refine add_le_add ?_ (mul_le_mul_of_nonneg_right hCtay_ge_coeff hterm2_nn)
          calc
            ((S.H - S.h_X (t : ℂ)) / Real.exp (-k)) / z_par ^ 2
                = 1 * (((S.H - S.h_X (t : ℂ)) / Real.exp (-k)) / z_par ^ 2) := (one_mul _).symm
            _ ≤ C_tay * (((S.H - S.h_X (t : ℂ)) / Real.exp (-k)) / z_par ^ 2) :=
                mul_le_mul_of_nonneg_right hCtay_ge_one hterm1_nn
    _ = C_tay * (((S.H - S.h_X (t : ℂ)) / Real.exp (-k)) / z_par ^ 2 + z_par ^ 2 * b ^ 4) := by
          ring

theorem cone_width_holder_and_subquad_balancing (S : FiniteWallNonisotropicStrip)
    (β a C_N C₁ δ_b L β₁ L_tr δ_star_tr C_b1 K_tay c_tay C_tay : ℝ)
    (hβ : 0 ≤ β) (hββ₁ : β < β₁) (hβ₁ : β₁ < 1 / 2) (ha : 0 < a) (hCN : 1 ≤ C_N) (hC₁ : 0 < C₁)
    (hδb_pos : 0 < δ_b) (hδb_lt : δ_b < S.H / 2)
    (hLtr_pos : 0 < L_tr) (hLtr_le : L_tr ≤ L)
    (hδtr_pos : 0 < δ_star_tr) (hδtr_lt : δ_star_tr < δ_b)
    (hCb1_pos : 0 < C_b1)
    (hKtay : criticalDepthThreshold S ≤ K_tay)
    (hctay_pos : 0 < c_tay) (hctay_lt : c_tay < S.r_star / 2)
    (hCtay_pos : 0 < C_tay)
    (hTransAt : ∀ K : ℝ, 0 < K → ∃ ε₀ d₀ : ℝ, 0 < ε₀ ∧ 0 < d₀ ∧
      ∀ d x₀ r ε : ℝ, 0 < d → d < min d₀ (δ_star_tr / 4) →
        0 < r → r ≤ K * d → 0 < ε → ε ≤ ε₀ →
        (∀ s : ℂ, d / 10 ≤ wallDepth S s → wallDepth S s ≤ δ_b →
          |s.re - x₀| ≤ L_tr * wallDepth S s →
          r * shapeModulus S s ≤ ε * (d / wallDepth S s) ^ (1 - β₁)) →
        ∀ t : ℝ, |t| < S.r_star → |t| ≤ r / 2 →
          S.H - S.h_X (t : ℂ) ≤ 2 * d)
    (hConeProps : ∀ N : ℝ → ℝ, IsCriticalEnvelope S β a C_N C₁ N →
      ∀ k : ℝ, criticalDepthThreshold S ≤ k →
        Continuous (bootConeCost S δ_b L β₁ N k) ∧
        Function.Periodic (bootConeCost S δ_b L β₁ N k) (2 * Real.pi) ∧
        ∀ x : ℝ, 1 ≤ bootConeCost S δ_b L β₁ N k x)
    (hConeL1 : ∀ N : ℝ → ℝ, IsCriticalEnvelope S β a C_N C₁ N →
      ∀ k : ℝ, criticalDepthThreshold S ≤ k →
        (2 * Real.pi)⁻¹ *
          (∫ x in (0 : ℝ)..(2 * Real.pi), bootConeCost S δ_b L β₁ N k x) ≤ C_b1)
    (hTay : ∀ N : ℝ → ℝ, IsCriticalEnvelope S β a C_N C₁ N →
      ∀ k x t : ℝ, K_tay ≤ k → 0 < |t| → |t| < S.r_star →
        (|t| * N k / Real.exp (-k)) * bootConeCost S δ_b L β₁ N k x ≤ c_tay →
        S.H - S.h_X (t : ℂ) ≤ Real.exp (-k) / 2 →
        Real.exp (-k) * max ((S.V (bootRowPt S k x)).im) 0 / (N k) ^ 2 ≤
          C_tay * (((S.H - S.h_X (t : ℂ)) / Real.exp (-k)) /
            (|t| * N k / Real.exp (-k)) ^ 2 +
            (|t| * N k / Real.exp (-k)) ^ 2 * (bootConeCost S δ_b L β₁ N k x) ^ 4)) :
    ∃ c_w z₀ C_w C_neg : ℝ,
      0 < c_w ∧ c_w < S.r_star / 2 ∧
      0 < z₀ ∧ 0 < C_w ∧ 0 < C_neg ∧
      (∀ N : ℝ → ℝ, IsCriticalEnvelope S β a C_N C₁ N →
        ∀ k t : ℝ, criticalDepthThreshold S ≤ k →
          |t| ≤ c_w * Real.exp (-k) / N k →
          S.H - S.h_X (t : ℂ) ≤ Real.exp (-k)) ∧
      (∀ N : ℝ → ℝ, IsCriticalEnvelope S β a C_N C₁ N →
        ∀ k t : ℝ, criticalDepthThreshold S ≤ k →
          |t| < S.r_star →
          |t| * N k / Real.exp (-k) ≤ z₀ →
          S.H - S.h_X (t : ℂ) ≤
            C_w * Real.exp (-k) * (|t| * N k / Real.exp (-k)) ^ (1 / (1 + a))) ∧
      (∀ N : ℝ → ℝ, IsCriticalEnvelope S β a C_N C₁ N →
        ∀ k x : ℝ, criticalDepthThreshold S ≤ k →
          Real.exp (-k) * max ((S.V (bootRowPt S k x)).im) 0 / (N k) ^ 2 ≤
            C_neg * (bootConeCost S δ_b L β₁ N k x) ^
              (4 * (2 - 1 / (1 + a)) / (4 - 1 / (1 + a)))) :=
by
  
  
  
  let k₀ : ℝ := criticalDepthThreshold S
  have hk₀_ge_one : 1 ≤ k₀ := le_max_left 1 (-Real.log (S.H / 20))
  have hk₀_ge_log : -Real.log (S.H / 20) ≤ k₀ := le_max_right 1 (-Real.log (S.H / 20))
  obtain ⟨ε₀, d₀, hε₀_pos, hd₀_pos, hTr⟩ := hTransAt 1 zero_lt_one
  let d_lim : ℝ := min d₀ (δ_star_tr / 4)
  have hd_lim_pos : 0 < d_lim := lt_min hd₀_pos (by linarith)
  let K_w : ℝ := max k₀ (-Real.log d_lim) + 1
  have h0_ball : (0 : ℂ) ∈ Metric.ball (0 : ℂ) S.r_star := Metric.mem_ball_self S.r_star_pos
  have hKw_lt_hX0 : S.H - Real.exp (-K_w) < S.h_X 0 := by
    rw [S.h_X_zero]; linarith [Real.exp_pos (-K_w)]
  have hlsc_nhds :
      {z : ℂ | S.H - Real.exp (-K_w) < S.h_X z} ∈
        nhdsWithin (0 : ℂ) (Metric.ball (0 : ℂ) S.r_star) :=
    S.h_X_lsc 0 h0_ball (S.H - Real.exp (-K_w)) hKw_lt_hX0
  obtain ⟨δ_lsc, hδ_lsc_pos, hδ_lsc⟩ := Metric.mem_nhdsWithin_iff.mp hlsc_nhds
  let ε_tr : ℝ := min ε₀ 1
  have hε_tr_pos : 0 < ε_tr := lt_min hε₀_pos zero_lt_one
  have hε_tr_le_ε₀ : ε_tr ≤ ε₀ := min_le_left _ _
  have hε_tr_le_one : ε_tr ≤ 1 := min_le_right _ _
  let M_b1 : ℝ := max C_b1 1
  have hCb1_le_Mb1 : C_b1 ≤ M_b1 := le_max_left _ _
  have hMb1_ge_one : 1 ≤ M_b1 := le_max_right _ _
  have hMb1_pos : 0 < M_b1 := lt_of_lt_of_le zero_lt_one hMb1_ge_one
  let c_w : ℝ := (1 / 2 : ℝ) * min (S.r_star / 2) (min δ_lsc (ε_tr / (4 * M_b1)))
  have hcw_pos : 0 < c_w := by
    have h1 : 0 < S.r_star / 2 := half_pos S.r_star_pos
    have h2 : 0 < ε_tr / (4 * M_b1) := by positivity
    have h3 : 0 < min (S.r_star / 2) (min δ_lsc (ε_tr / (4 * M_b1))) :=
      lt_min h1 (lt_min hδ_lsc_pos h2)
    dsimp [c_w]; linarith
  have hcw_lt_half_r : c_w < S.r_star / 2 := by
    have h : min (S.r_star / 2) (min δ_lsc (ε_tr / (4 * M_b1))) ≤ S.r_star / 2 := min_le_left _ _
    dsimp [c_w]; linarith [S.r_star_pos]
  have hcw_lt_lsc : c_w < δ_lsc := by
    have h1 : min (S.r_star / 2) (min δ_lsc (ε_tr / (4 * M_b1))) ≤ min δ_lsc (ε_tr / (4 * M_b1)) :=
      min_le_right _ _
    have h2 : min δ_lsc (ε_tr / (4 * M_b1)) ≤ δ_lsc := min_le_left _ _
    dsimp [c_w]; linarith
  have hcw_le_tr : c_w ≤ ε_tr / (4 * M_b1) := by
    have h1 : min (S.r_star / 2) (min δ_lsc (ε_tr / (4 * M_b1))) ≤ min δ_lsc (ε_tr / (4 * M_b1)) :=
      min_le_right _ _
    have h2 : min δ_lsc (ε_tr / (4 * M_b1)) ≤ ε_tr / (4 * M_b1) := min_le_right _ _
    have h3 : 0 < ε_tr / (4 * M_b1) := by positivity
    dsimp [c_w]; linarith
  let φ : ℝ × ℝ → ℂ := fun p => (p.1 : ℂ) + (p.2 : ℂ) * Complex.I
  have hφ_cont : Continuous φ :=
    (Complex.continuous_ofReal.comp continuous_fst).add
      ((Complex.continuous_ofReal.comp continuous_snd).mul continuous_const)
  have hL_pos : 0 < L := lt_of_lt_of_le hLtr_pos hLtr_le
  have hβ₁_nonneg : 0 ≤ β₁ := le_of_lt (lt_of_le_of_lt hβ hββ₁)
  have h2pi_pos : 0 < 2 * Real.pi := by positivity
  have hWidthLevel : ∀ N : ℝ → ℝ, IsCriticalEnvelope S β a C_N C₁ N →
      ∀ k t : ℝ, criticalDepthThreshold S ≤ k →
        |t| ≤ c_w * Real.exp (-k) / N k →
        S.H - S.h_X (t : ℂ) ≤ Real.exp (-k) := by
    intro N hN k t hk ht
    have hk_ge_one : 1 ≤ k := le_trans hk₀_ge_one hk
    have hexp_pos : 0 < Real.exp (-k) := Real.exp_pos (-k)
    have hexp_le_one : Real.exp (-k) ≤ 1 := by
      simpa using Real.exp_le_exp.mpr (by linarith : -k ≤ 0)
    have hNk_ge_one : 1 ≤ N k := hN.one_le k hk
    have hNk_pos : 0 < N k := lt_of_lt_of_le zero_lt_one hNk_ge_one
    have ht_le_cw : |t| ≤ c_w := by
      refine le_trans ht ((div_le_iff₀ hNk_pos).mpr ?_)
      have h1 : c_w * Real.exp (-k) ≤ c_w * 1 :=
        mul_le_mul_of_nonneg_left hexp_le_one (le_of_lt hcw_pos)
      have h2 : c_w * 1 ≤ c_w * N k :=
        mul_le_mul_of_nonneg_left hNk_ge_one (le_of_lt hcw_pos)
      linarith
    have ht_lt_rstar : |t| < S.r_star := by linarith [S.r_star_pos]
    rcases le_or_gt k K_w with hk_shal | hk_deep
    · 
      have ht_ball1 : (t : ℂ) ∈ Metric.ball (0 : ℂ) δ_lsc := by
        rw [Metric.mem_ball, dist_zero_right, Complex.norm_real, Real.norm_eq_abs]
        exact lt_of_le_of_lt ht_le_cw hcw_lt_lsc
      have ht_ball2 : (t : ℂ) ∈ Metric.ball (0 : ℂ) S.r_star := by
        rw [Metric.mem_ball, dist_zero_right, Complex.norm_real, Real.norm_eq_abs]
        exact ht_lt_rstar
      have h_hx_gt : S.H - Real.exp (-K_w) < S.h_X (t : ℂ) :=
        hδ_lsc ⟨ht_ball1, ht_ball2⟩
      have hexp_Kw : Real.exp (-K_w) ≤ Real.exp (-k) :=
        Real.exp_le_exp.mpr (by linarith)
      linarith
    · 
      let d : ℝ := Real.exp (-k) / 2
      have hd_pos : 0 < d := half_pos hexp_pos
      have h_neg_log_lt : -Real.log d_lim < k := by
        have hle : -Real.log d_lim ≤ max k₀ (-Real.log d_lim) := le_max_right _ _
        dsimp [K_w] at hk_deep
        linarith
      have hexp_lt_dlim : Real.exp (-k) < d_lim := by
        rw [← Real.exp_log hd_lim_pos]
        exact Real.exp_lt_exp.mpr (by linarith)
      have hd_lt_dlim : d < min d₀ (δ_star_tr / 4) := by
        change Real.exp (-k) / 2 < d_lim
        linarith
      have hb_cont : Continuous (bootConeCost S δ_b L β₁ N k) := (hConeProps N hN k hk).1
      obtain ⟨x₀, _, hx₀_min⟩ :=
        isCompact_Icc.exists_isMinOn (Set.nonempty_Icc.mpr (le_of_lt h2pi_pos)) hb_cont.continuousOn
      have h_int_mono :
          (∫ _ in (0 : ℝ)..(2 * Real.pi), bootConeCost S δ_b L β₁ N k x₀) ≤
            ∫ x in (0 : ℝ)..(2 * Real.pi), bootConeCost S δ_b L β₁ N k x :=
        intervalIntegral.integral_mono_on (le_of_lt h2pi_pos) intervalIntegrable_const
          (hb_cont.intervalIntegrable _ _) (fun x hx => isMinOn_iff.mp hx₀_min x hx)
      rw [intervalIntegral.integral_const, sub_zero, smul_eq_mul] at h_int_mono
      have h_L1 := hConeL1 N hN k hk
      have hbx₀_le_Mb1 : bootConeCost S δ_b L β₁ N k x₀ ≤ M_b1 := by
        have hmul := mul_le_mul_of_nonneg_left h_int_mono (inv_nonneg.mpr (le_of_lt h2pi_pos))
        have hcancel :
            (2 * Real.pi)⁻¹ * (2 * Real.pi * bootConeCost S δ_b L β₁ N k x₀) =
              bootConeCost S δ_b L β₁ N k x₀ := by
          field_simp
        linarith
      
      let E : Set ℝ := { v : ℝ | ∃ s : ℂ,
        Real.exp (-k) / 20 ≤ wallDepth S s ∧
        wallDepth S s ≤ δ_b ∧
        |s.re - x₀| ≤ L * wallDepth S s ∧
        v = (wallDepth S s * shapeModulus S s) /
          (N k * (wallDepth S s / Real.exp (-k)) ^ β₁) }
      let R_rect : Set (ℝ × ℝ) :=
        Set.Icc (x₀ - L * δ_b) (x₀ + L * δ_b) ×ˢ
          Set.Icc (S.H - δ_b) (S.H - Real.exp (-k) / 20)
      let K_rect : Set ℂ := φ '' R_rect
      have hK_compact : IsCompact K_rect := (isCompact_Icc.prod isCompact_Icc).image hφ_cont
      have hK_sub : K_rect ⊆ horizStrip S.H := by
