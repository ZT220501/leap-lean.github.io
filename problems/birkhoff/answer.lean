        have h_not : ¬ (k.val < m) := hkm
        have hP_eq : P k.succ = q_end := by
          simp [P, Fin.val_succ, h_not]
        rw [hP_eq, hk_eq]
        refine ⟨h_sq_mono (c k_last) (ρ k_last) (9 * ρ k_last) (by linarith [hρ k_last]) hq_end_sq, ?_⟩
