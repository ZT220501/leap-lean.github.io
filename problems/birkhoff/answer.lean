    let T₂ : ℝ → ℝ := fun x => sgn * (2 * Real.pi / (q : ℝ)) + τ_T₂ x
    (∀ k : ℕ, k ≤ m + 2 → ∀ x : ℝ,
      |iteratedDeriv k (fun y => a_R w₁ (X₁ y) - a_R w₂ (X₂ y)) x| ≤
