      intro K F Φ hKF hΦ_K H_star Δ Ψ hH hΔ0 hΨ0 hΨF
      let A : ℕ → PowerSeries ℂ := fun m => pointRecLiftArcFn F Φ (H_star m)
      let Ψ_lift := pointRecLiftMv2D F Φ Ψ
      let Z := MvPowerSeries.C Δ + Ψ_lift
      have hΨ_lift0 : MvPowerSeries.coeff 0 Ψ_lift = 0 := by
        change pointRecLiftArcFn F Φ (MvPowerSeries.coeff 0 Ψ) = 0
        rw [hΨ0, h_lift_zero]
      let VanishesBelow : ℕ → MvPowerSeries (Fin 2) (PowerSeries ℂ) → Prop :=
