        by_cases hm1 : m = 1
        · subst hm1; simp
        · have hne : Finsupp.single i m ≠ Finsupp.single i 1 := by
            intro h
            exact hm1 (by simpa using Finsupp.ext_iff.mp h i)
          simp [hm1, hne]
