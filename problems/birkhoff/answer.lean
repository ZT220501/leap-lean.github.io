        have h2 : ‖ℱ p θ‖ ≤ M :=
          hG_le_M _ ⟨hp_cb, circleMap_mem_sphere 0 zero_le_one θ⟩
        exact le_trans (norm_sub_le _ _) (by linarith)
      have hfderiv_eq : fderiv ℂ (fun q => ℱ q θ) p = ℱ' p θ :=
