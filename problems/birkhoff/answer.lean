  have h_s2 :
      (∀ i : Fin 2, DifferentiableOn ℂ (fun q : ℂ × ℂ => glancingImpact C q.1 q.2 i) (collarBaseBox M)) ∧
      (∀ i : Fin 2, ∀ q ∈ collarBaseBox M, glancingImpact C q.1 (-q.2) i = glancingImpact C q.1 q.2 i) ∧
      (∀ q ∈ collarBaseBox M, SatisfiesRankOneAt (fun i w => glancingImpact C w.1 w.2 i) q) ∧
      (∀ q ∈ collarHalfBaseBox M, SatisfiesIsoReflectAt (fun i w => glancingImpact C w.1 w.2 i) q) := by
    have hs_pos : 0 < M.s_base := M.s_base_pos
    have hr_pos : 0 < M.r_base := M.r_base_pos
    have hs_le_s1 : M.s_base ≤ C.s₁ / 4 := M.s_base_le_s₁
    have hr_lt_s4 : M.r_base < M.s_base / 4 := M.r_base_lt_s_base
    have hr_lt_r1 : M.r_base < C.r₁ / 2 := M.r_base_lt_r₁
    have hr1_pos : 0 < C.r₁ := C.r₁_pos
    have hr1_lt_s1 : C.r₁ < C.s₁ := C.r₁_lt_s₁
    have hBase_open : IsOpen (collarBaseBox M) :=
