        · have hnot_ball : (Complex.polarCoord.symm p : ℂ) ∉ Metric.ball (0 : ℂ) R := by
            rw [Metric.mem_ball, dist_zero_right, h_norm_symm]
            exact hpR
          have hnot_prod : p ∉ Set.Ioo (0 : ℝ) R ×ˢ Set.Ioo (-Real.pi) Real.pi := by
            intro hm
            exact hpR hm.1.2
          change p.1 * (Metric.ball (0 : ℂ) R).indicator (fun w => g (z₀ + w))
              (Complex.polarCoord.symm p) =
            (Set.Ioo (0 : ℝ) R ×ˢ Set.Ioo (-Real.pi) Real.pi).indicator
              (fun q : ℝ × ℝ => q.1 * g (circleMap z₀ q.1 q.2)) p
          rw [Set.indicator_of_notMem hnot_ball, Set.indicator_of_notMem hnot_prod, mul_zero]
      rw [MeasureTheory.setIntegral_congr_fun (measurableSet_Ioi.prod measurableSet_Ioo) hind_eq]
      rw [MeasureTheory.setIntegral_indicator (measurableSet_Ioo.prod measurableSet_Ioo)]
      have hinter_eq : (Set.Ioi (0 : ℝ) ×ˢ Set.Ioo (-Real.pi) Real.pi) ∩
