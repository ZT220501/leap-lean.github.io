      intro F_shal_any F_ann_any hF_shal_any_nd hF_ann_any_sh
      have hEq_sh_any : MeroEqOn F_shal_1 F_shal_any (Metric.ball (0 : ℂ) d_w ×ˢ A_shal) :=
        meroEqOn_of_num_den_eq F_shal_1 F_shal_any (Metric.ball (0 : ℂ) d_w ×ˢ A_shal)
          (fun _ hp => ⟨hp, hp⟩)
          (fun p _ q => by
            rw [(hF_shal_1_nd p q).1, (hF_shal_any_nd p q).1,
                (hF_shal_1_nd p q).2, (hF_shal_any_nd p q).2]
            exact ⟨rfl, rfl⟩)
      have hEq_ann_sh : MeroEqOn F_ann_1 F_ann_any (Metric.ball (0 : ℂ) d_w ×ˢ A_shal) :=
        meroEqOn_trans hF_ann_1_sh (meroEqOn_trans hEq_sh_any (meroEqOn_symm hF_ann_any_sh))
      have hEq_ann : MeroEqOn F_ann_1 F_ann_any (Metric.ball (0 : ℂ) d_w ×ˢ A) :=
        meroEqOn_of_preconnected F_ann_1 F_ann_any
          (Metric.isOpen_ball.prod isOpen_A)
          ((convex_ball (0 : ℂ) d_w).isPreconnected.prod isPreconn_A)
          (fun _ hp => ⟨hp, hp⟩)
          (⟨((0 : ℂ), (1 : ℂ)), ⟨Metric.mem_ball_self hd_w_pos, h1_mem_shal⟩⟩ :
            (Metric.ball (0 : ℂ) d_w ×ˢ A_shal).Nonempty)
          (Set.prod_mono Set.Subset.rfl Set.inter_subset_left)
          hEq_ann_sh
      exact meroEqOn_trans hNext_ann1 hEq_ann

  
  have hσ64 : σ_fn 64 = H₀ := by
    dsimp only [σ_fn, Δσ, d_w]
    ring

  let ε_patch : ℝ :=
    (1 / 2 : ℝ) * min W.s_base (min (d_w / 2) (min (r_0 * δ₀) (r_0 ^ 2 / (8 * η))))
  have h_r02_8η_pos : 0 < r_0 ^ 2 / (8 * η) :=
    div_pos (pow_pos hr_0_pos 2) (by linarith)
  have hε_patch_pos : 0 < ε_patch :=
    mul_pos (by norm_num) (lt_min W.s_base_pos
      (lt_min (by linarith) (lt_min (mul_pos hr_0_pos hδ₀_pos) h_r02_8η_pos)))
  have hε_patch_lt : ε_patch < W.s_base := by
    have hm : min W.s_base (min (d_w / 2) (min (r_0 * δ₀) (r_0 ^ 2 / (8 * η)))) ≤ W.s_base :=
      min_le_left _ _
    dsimp only [ε_patch]
    linarith [W.s_base_pos]
  have hε_le_dw : ε_patch ≤ (1 / 4 : ℝ) * d_w := by
    have hm : min W.s_base (min (d_w / 2) (min (r_0 * δ₀) (r_0 ^ 2 / (8 * η)))) ≤ d_w / 2 :=
      le_trans (min_le_right _ _) (min_le_left _ _)
    dsimp only [ε_patch]
    linarith
  have hε_le_r0δ0 : ε_patch ≤ (1 / 2 : ℝ) * (r_0 * δ₀) := by
    have hm : min W.s_base (min (d_w / 2) (min (r_0 * δ₀) (r_0 ^ 2 / (8 * η)))) ≤ r_0 * δ₀ :=
      le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_left _ _))
    dsimp only [ε_patch]
    linarith
  have hε_quad_le : (η / r_0 ^ 2) * ε_patch ^ 2 ≤ (1 / 16 : ℝ) * ε_patch := by
    have hm : min W.s_base (min (d_w / 2) (min (r_0 * δ₀) (r_0 ^ 2 / (8 * η)))) ≤
        r_0 ^ 2 / (8 * η) :=
      le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_right _ _))
    have hε_le_frac : ε_patch ≤ (1 / 2 : ℝ) * (r_0 ^ 2 / (8 * η)) := by
      dsimp only [ε_patch]; linarith
    have hr0_sq_pos : 0 < r_0 ^ 2 := pow_pos hr_0_pos 2
    have hr0_sq_ne : r_0 ^ 2 ≠ 0 := ne_of_gt hr0_sq_pos
    have h8η_ne : 8 * η ≠ 0 := ne_of_gt (by linarith)
    have h16 : 16 * η * ε_patch ≤ r_0 ^ 2 := by
      have hmul := mul_le_mul_of_nonneg_left hε_le_frac (by linarith : (0 : ℝ) ≤ 16 * η)
      have hrhs : (16 * η) * ((1 / 2 : ℝ) * (r_0 ^ 2 / (8 * η))) = r_0 ^ 2 := by
        field_simp [h8η_ne]; ring
      linarith
    have hdiv : (η / r_0 ^ 2) * ε_patch ≤ 1 / 16 := by
      have hmul2 := mul_le_mul_of_nonneg_right h16 (le_of_lt (inv_pos.mpr hr0_sq_pos))
      have hlhs : 16 * η * ε_patch * (r_0 ^ 2)⁻¹ = 16 * ((η / r_0 ^ 2) * ε_patch) := by
        rw [div_eq_mul_inv]; ring
      rw [hlhs, mul_inv_cancel₀ hr0_sq_ne] at hmul2
      linarith
    nlinarith [hε_patch_pos]

  obtain ⟨r_seed, hr_seed_pos, hr_seed_le, h_seed_lsc⟩ :=
    exists_lsc_radius (H₀ - ε_patch / 16) (by linarith)
  let δ_seed : ℝ := (1 / 2 : ℝ) * min δ₀ (min (r_seed / r_0) (ε_patch / (16 * η)))
  have hδ_seed_pos : 0 < δ_seed :=
    mul_pos (by norm_num) (lt_min hδ₀_pos
      (lt_min (div_pos hr_seed_pos hr_0_pos) (div_pos hε_patch_pos (by linarith))))
  have hδ_seed_lt_δ₀ : δ_seed < δ₀ := by
    have hm : min δ₀ (min (r_seed / r_0) (ε_patch / (16 * η))) ≤ δ₀ := min_le_left _ _
    dsimp only [δ_seed]
    linarith [hδ₀_pos]
  have hδ_seed_sq : δ_seed ^ 2 < δ_seed := by
    have h1 : δ_seed < 1 := lt_trans hδ_seed_lt_δ₀ (by norm_num [δ₀])
    nlinarith [hδ_seed_pos]
  have hr0_δseed_lt : r_0 * δ_seed < r_seed := by
    have hm : min δ₀ (min (r_seed / r_0) (ε_patch / (16 * η))) ≤ r_seed / r_0 :=
      le_trans (min_le_right _ _) (min_le_left _ _)
    have hlt : δ_seed < r_seed / r_0 := by
      dsimp only [δ_seed]
      linarith [div_pos hr_seed_pos hr_0_pos]
    have hmul := mul_lt_mul_of_pos_left hlt hr_0_pos
    rwa [mul_div_cancel₀ r_seed (ne_of_gt hr_0_pos)] at hmul
  have hη_δseed_sq_lt : η * δ_seed ^ 2 < ε_patch / 16 := by
    have hm : min δ₀ (min (r_seed / r_0) (ε_patch / (16 * η))) ≤ ε_patch / (16 * η) :=
      le_trans (min_le_right _ _) (min_le_right _ _)
    have hlt : δ_seed < ε_patch / (16 * η) := by
      dsimp only [δ_seed]
      linarith [div_pos hε_patch_pos (by linarith : (0 : ℝ) < 16 * η)]
    have hmul := mul_lt_mul_of_pos_left hlt hη_pos
    have hrhs : η * (ε_patch / (16 * η)) = ε_patch / 16 := by
      field_simp [ne_of_gt hη_pos]
    rw [hrhs] at hmul
    nlinarith [hδ_seed_sq, hη_pos]

  let V_seed : Set (ℂ × ℂ) :=
    (Metric.ball (0 : ℂ) d_w ∩ { w : ℂ | w.im < -ε_patch / 8 }) ×ˢ Metric.ball (0 : ℂ) δ_seed
  have isOpen_Vseed : IsOpen V_seed :=
    (Metric.isOpen_ball.inter (isOpen_lt Complex.continuous_im continuous_const)).prod
      Metric.isOpen_ball
  have isPreconn_Vseed : IsPreconnected V_seed :=
    (((convex_ball (0 : ℂ) d_w).inter
      ((convex_Iio (-ε_patch / 8)).linear_preimage Complex.imCLM.toLinearMap)).prod
      (convex_ball (0 : ℂ) δ_seed)).isPreconnected
  have hVseed_maps_tube : Set.MapsTo (Φ H₀) V_seed (meroTubeENNR W.r_base W.h_L) := by
    intro p ⟨⟨hpw, hpw_im⟩, hpζ⟩
    have hw_norm : ‖p.1‖ < d_w := by simpa [Metric.mem_ball, dist_zero_right] using hpw
    have hw_lo : -d_w < p.1.im := (abs_lt.mp (lt_of_le_of_lt (Complex.abs_im_le_norm p.1) hw_norm)).1
    have hζ_norm : ‖p.2‖ < δ_seed := by simpa [Metric.mem_ball, dist_zero_right] using hpζ
    have hζ_sq : ‖p.2‖ ^ 2 < δ_seed ^ 2 := by
      have h0 : 0 ≤ ‖p.2‖ := norm_nonneg p.2
      nlinarith
    have hre_abs := h_abs_sq_re p.2
    have hre_lo : -‖p.2‖ ^ 2 ≤ (p.2 ^ 2).re := le_trans (neg_le_neg hre_abs) (neg_abs_le _)
    have hre_hi : (p.2 ^ 2).re ≤ ‖p.2‖ ^ 2 := le_trans (le_abs_self _) hre_abs
    have him_hi : (Φ H₀ p).1.im < H₀ - ε_patch / 16 := by
      rw [hΦ1_im]
      change p.1.im < -ε_patch / 8 at hpw_im
      nlinarith
    have him_pos : 0 < (Φ H₀ p).1.im := by
      rw [hΦ1_im]
      dsimp only [d_w] at hw_lo hε_le_dw
      nlinarith [h1024η_lt, hε_patch_pos]
    have ht_seed : ‖(Φ H₀ p).2‖ < r_seed := by
      rw [hΦ2_norm]
      have : r_0 * ‖p.2‖ < r_0 * δ_seed := mul_lt_mul_of_pos_left hζ_norm hr_0_pos
      linarith [hr0_δseed_lt]
    exact mem_meroTube_L (Φ H₀ p) (H₀ - ε_patch / 16)
      (lt_of_lt_of_le ht_seed hr_seed_le) him_pos him_hi (h_seed_lsc (Φ H₀ p).2 ht_seed)

  have hp_star_U64_Vseed : p_star ∈ U_box 64 ∩ V_seed := by
    have hpos_34 : 0 < (3 / 4 : ℝ) * d_w := by linarith
    have hp_norm : ‖p_star.1‖ = (3 / 4 : ℝ) * d_w := by
      dsimp only [p_star]
      rw [norm_mul, norm_neg, Complex.norm_real, Complex.norm_I, mul_one,
        Real.norm_eq_abs, abs_of_pos hpos_34]
    have hp_im : p_star.1.im = -(3 / 4 : ℝ) * d_w := by
      dsimp only [p_star]
      simp only [Complex.neg_im, Complex.neg_re, Complex.mul_im, Complex.ofReal_re,
        Complex.ofReal_im, Complex.I_re, Complex.I_im, mul_one, zero_mul, add_zero]
      ring
    refine ⟨⟨⟨?_, ?_⟩, Metric.mem_ball_self hδ₀_pos⟩, ⟨⟨?_, ?_⟩, Metric.mem_ball_self hδ_seed_pos⟩⟩
    · rw [Metric.mem_ball, dist_zero_right, hp_norm]; linarith
    · change p_star.1.im < H₀ - d_w / 4 - σ_fn 64
      rw [hp_im, hσ64]; linarith
    · rw [Metric.mem_ball, dist_zero_right, hp_norm]; linarith
    · change p_star.1.im < -ε_patch / 8
      rw [hp_im]; linarith [hε_le_dw]

  let s_edge : ℂ := (x_edge : ℂ) + (H₀ : ℂ) * Complex.I
  let W_patch : Set (ℂ × ℂ) :=
    { p : ℂ × ℂ | ‖p.1 - s_edge‖ < ε_patch ∧ ‖p.2 - ((0 : ℝ) : ℂ)‖ < ε_patch }
  have isOpen_Wpatch : IsOpen W_patch :=
    (isOpen_lt (continuous_norm.comp (continuous_fst.sub continuous_const))
      continuous_const).inter
      (isOpen_lt (continuous_norm.comp (continuous_snd.sub continuous_const)) continuous_const)

  have hΨ_Wpatch_maps : Set.MapsTo (Ψ H₀) W_patch
      (Metric.ball (0 : ℂ) d_w ×ˢ Metric.ball (0 : ℂ) R) := by
    intro p ⟨hp1, hp2⟩
    have hp2' : ‖p.2‖ < ε_patch := by simpa [Complex.ofReal_zero, sub_zero] using hp2
    have h_coeff_pos : 0 < η / r_0 ^ 2 := div_pos hη_pos (pow_pos hr_0_pos 2)
    refine ⟨?_, ?_⟩
    · rw [Metric.mem_ball, dist_zero_right]
      dsimp only [Ψ]
      have htri : ‖p.1 - s_edge + ((η / r_0 ^ 2 : ℝ) : ℂ) * Complex.I * (p.2 ^ 2)‖ ≤
          ‖p.1 - s_edge‖ + (η / r_0 ^ 2) * ‖p.2‖ ^ 2 := by
        have h1 := norm_add_le (p.1 - s_edge) (((η / r_0 ^ 2 : ℝ) : ℂ) * Complex.I * (p.2 ^ 2))
        have h2 : ‖((η / r_0 ^ 2 : ℝ) : ℂ) * Complex.I * (p.2 ^ 2)‖ =
            (η / r_0 ^ 2) * ‖p.2‖ ^ 2 := by
          rw [norm_mul, norm_mul, norm_pow, Complex.norm_real, Complex.norm_I, mul_one,
            Real.norm_eq_abs, abs_of_pos h_coeff_pos]
        linarith
      have hp2_sq : ‖p.2‖ ^ 2 < ε_patch ^ 2 := by
        have h0 : 0 ≤ ‖p.2‖ := norm_nonneg p.2
        nlinarith
      nlinarith [hε_quad_le, hε_le_dw]
    · rw [Metric.mem_ball, dist_zero_right]
      dsimp only [Ψ]
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hr_0_pos)]
      have hlt : r_0⁻¹ * ‖p.2‖ < r_0⁻¹ * ε_patch :=
        mul_lt_mul_of_pos_left hp2' (inv_pos.mpr hr_0_pos)
      have hle : r_0⁻¹ * ε_patch ≤ (1 / 2 : ℝ) * δ₀ := by
        have hm := mul_le_mul_of_nonneg_left hε_le_r0δ0 (le_of_lt (inv_pos.mpr hr_0_pos))
        have hrhs : r_0⁻¹ * ((1 / 2 : ℝ) * (r_0 * δ₀)) = (1 / 2 : ℝ) * δ₀ := by
          field_simp [ne_of_gt hr_0_pos]
        linarith
      dsimp only [δ₀, R] at hle ⊢
      linarith

  let δ : ℝ := min (ε_patch / 4) ((1 / 2 : ℝ) * (r_0 * δ_seed))
  have hδ_pos : 0 < δ :=
    lt_min (by linarith) (mul_pos (by norm_num) (mul_pos hr_0_pos hδ_seed_pos))
  have hδ_le : δ ≤ ε_patch := le_trans (min_le_left _ _) (by linarith)
  let O_δ : Set (ℂ × ℂ) :=
    { p : ℂ × ℂ |
      |p.1.re - x_edge| < ε_patch / 4 ∧
      |p.1.im - (H₀ - ε_patch / 2)| < ε_patch / 4 ∧
      ‖p.2 - ((0 : ℝ) : ℂ)‖ < δ }

  have hOδ_sub_Wpatch : O_δ ⊆ W_patch := by
    intro p ⟨hre, him, ht⟩
    refine ⟨?_, lt_of_lt_of_le ht hδ_le⟩
    have hdecomp : p.1 - s_edge =
        ((p.1.re - x_edge : ℝ) : ℂ) + ((p.1.im - H₀ : ℝ) : ℂ) * Complex.I := by
      dsimp only [s_edge]
      apply Complex.ext <;> simp
    rw [hdecomp]
    have htri : ‖((p.1.re - x_edge : ℝ) : ℂ) + ((p.1.im - H₀ : ℝ) : ℂ) * Complex.I‖ ≤
        |p.1.re - x_edge| + |p.1.im - H₀| := by
      refine le_trans (norm_add_le _ _) ?_
      rw [Complex.norm_real, norm_mul, Complex.norm_real, Complex.norm_I, mul_one,
        Real.norm_eq_abs, Real.norm_eq_abs]
    have him_bounds := abs_lt.mp him
    have him_abs : |p.1.im - H₀| < (3 / 4 : ℝ) * ε_patch :=
      abs_lt.mpr ⟨by linarith, by linarith⟩
    linarith

  have hΨ_Oδ_maps_Vseed : Set.MapsTo (Ψ H₀) O_δ V_seed := by
    intro p hp
    have hpW : p ∈ W_patch := hOδ_sub_Wpatch hp
    obtain ⟨hre, him, ht⟩ := hp
    have ht' : ‖p.2‖ < δ := by simpa [Complex.ofReal_zero, sub_zero] using ht
    refine ⟨⟨(hΨ_Wpatch_maps hpW).1, ?_⟩, ?_⟩
    · change ((Ψ H₀ p).1).im < -ε_patch / 8
      have hΨ1_im : ((Ψ H₀ p).1).im = (p.1.im - H₀) + (η / r_0 ^ 2) * (p.2 ^ 2).re := by
        dsimp only [Ψ]
        simp only [Complex.add_im, Complex.sub_im, Complex.mul_im, Complex.mul_re,
          Complex.ofReal_re, Complex.ofReal_im, Complex.I_re, Complex.I_im]
        ring
      rw [hΨ1_im]
      have him_hi : p.1.im - H₀ < -ε_patch / 4 := by linarith [(abs_lt.mp him).2]
      have ht_eps : ‖p.2‖ < ε_patch := lt_of_lt_of_le ht' hδ_le
      have hp2_re : (p.2 ^ 2).re ≤ ε_patch ^ 2 := by
        have h1 : (p.2 ^ 2).re ≤ ‖p.2‖ ^ 2 := le_trans (le_abs_self _) (h_abs_sq_re p.2)
        have h0 : 0 ≤ ‖p.2‖ := norm_nonneg p.2
        nlinarith
      have h_coeff_pos : 0 < η / r_0 ^ 2 := div_pos hη_pos (pow_pos hr_0_pos 2)
      nlinarith [hε_quad_le]
    · rw [Metric.mem_ball, dist_zero_right]
      dsimp only [Ψ]
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hr_0_pos)]
      have hlt : r_0⁻¹ * ‖p.2‖ < r_0⁻¹ * δ :=
        mul_lt_mul_of_pos_left ht' (inv_pos.mpr hr_0_pos)
      have hδ_r0 : δ ≤ (1 / 2 : ℝ) * (r_0 * δ_seed) := min_le_right _ _
      have hle : r_0⁻¹ * δ ≤ (1 / 2 : ℝ) * δ_seed := by
        have hm := mul_le_mul_of_nonneg_left hδ_r0 (le_of_lt (inv_pos.mpr hr_0_pos))
        have hrhs : r_0⁻¹ * ((1 / 2 : ℝ) * (r_0 * δ_seed)) = (1 / 2 : ℝ) * δ_seed := by
          field_simp [ne_of_gt hr_0_pos]
        linarith
      linarith [hδ_seed_pos]

  have hPatch_comp : ∀ i : Fin 2,
      ∃ g_i : MeroOn2D W_patch, MeroEqOn g_i (W.L_mero i) O_δ := by
    intro i
    obtain ⟨F_top, L_U64, hL_U64_nd, _, hTop_U64⟩ := hAscent i 64 le_rfl
    obtain ⟨L_Vseed, hL_Vseed_nd⟩ := mkPullbackMero (W.L_mero i) V_seed isOpen_Vseed
      (Φ H₀) (Ψ H₀) (hΦ_diff H₀) (hΨ_diff H₀) (hΨΦ H₀) (hΦΨ H₀) hVseed_maps_tube
    have hEq_L64_seed : MeroEqOn L_U64 L_Vseed (U_box 64 ∩ V_seed) :=
      meroEqOn_of_num_den_eq L_U64 L_Vseed (U_box 64 ∩ V_seed)
        (fun _ hp => hp)
        (fun p _ q => by
          rw [(hL_U64_nd p q).1, hσ64, (hL_Vseed_nd p q).1,
              (hL_U64_nd p q).2, hσ64, (hL_Vseed_nd p q).2]
          exact ⟨rfl, rfl⟩)
    have hTop_inter : MeroEqOn F_top L_Vseed (U_box 64 ∩ V_seed) :=
      meroEqOn_trans (meroEqOn_mono Set.inter_subset_left hTop_U64) hEq_L64_seed
    have hTop_seed : MeroEqOn F_top L_Vseed V_seed :=
      meroEqOn_of_preconnected F_top L_Vseed
        isOpen_Vseed isPreconn_Vseed
        (fun p hp =>
          ⟨⟨hp.1.1, Metric.ball_subset_ball
              (le_trans (le_of_lt hδ_seed_lt_δ₀) (by norm_num [δ₀, R])) hp.2⟩, hp⟩)
        ⟨p_star, hp_star_U64_Vseed⟩
        Set.inter_subset_right
        hTop_inter
    obtain ⟨g_i, hg_i_nd⟩ := mkPullbackMero F_top W_patch isOpen_Wpatch
      (Ψ H₀) (Φ H₀) (hΨ_diff H₀) (hΦ_diff H₀) (hΦΨ H₀) (hΨΦ H₀) hΨ_Wpatch_maps
    obtain ⟨L_inv, hL_inv_nd⟩ := mkPullbackMero L_Vseed O_δ
      ((isOpen_lt (continuous_abs.comp ((Complex.continuous_re.comp continuous_fst).sub continuous_const))
          continuous_const).inter
        ((isOpen_lt (continuous_abs.comp ((Complex.continuous_im.comp continuous_fst).sub continuous_const))
          continuous_const).inter
          (isOpen_lt (continuous_norm.comp (continuous_snd.sub continuous_const)) continuous_const)))
      (Ψ H₀) (Φ H₀) (hΨ_diff H₀) (hΦ_diff H₀) (hΦΨ H₀) (hΨΦ H₀) hΨ_Oδ_maps_Vseed
    have hEq_g_Linv : MeroEqOn g_i L_inv O_δ :=
      eqOn_of_pullback (hΨ_diff H₀).continuous
        (fun p hp => ⟨hOδ_sub_Wpatch hp, hp⟩)
        hΨ_Oδ_maps_Vseed hg_i_nd hL_inv_nd hTop_seed
    have hEq_Linv_L : MeroEqOn L_inv (W.L_mero i) O_δ :=
      meroEqOn_of_num_den_eq L_inv (W.L_mero i) O_δ
        (fun p hp =>
          ⟨hp, by simpa only [hΦΨ H₀ p] using hVseed_maps_tube (hΨ_Oδ_maps_Vseed hp)⟩)
        (fun p _ q => by
          rw [(hL_inv_nd p q).1, (hL_Vseed_nd (Ψ H₀ p) (Ψ H₀ q)).1, hΦΨ H₀ p, hΦΨ H₀ q,
              (hL_inv_nd p q).2, (hL_Vseed_nd (Ψ H₀ p) (Ψ H₀ q)).2, hΦΨ H₀ p, hΦΨ H₀ q]
          exact ⟨rfl, rfl⟩)
    exact ⟨g_i, meroEqOn_trans hEq_g_Linv hEq_Linv_L⟩

  let g_patch : Fin 2 → MeroOn2D W_patch := fun i => Classical.choose (hPatch_comp i)
  have hg_patch_eq : ∀ i : Fin 2, MeroEqOn (g_patch i) (W.L_mero i) O_δ :=
    fun i => Classical.choose_spec (hPatch_comp i)
  exact hNoPatch.2 0 x_edge H₀ ε_patch
    (by simpa only [abs_zero] using W.r_base_pos)
    (by simpa only [Complex.ofReal_zero] using hHL0)
    hε_patch_pos hε_patch_lt
    ⟨g_patch, δ, hδ_pos, hδ_le, hg_patch_eq⟩

theorem zero_slice_and_natural_boundary (Ω : Set Plane)
    (C : AnalyticGlancingCollar Ω)
    (hDet : EndpointDeterminationData C)
    (W : CollarWidthTubeData C hDet)
    (hDisk : MeroDiskContinuationProp)
    (hNoPatch : NoPatchAtRealProp W) :
    Nonempty (ZeroSliceCollarData W) :=
by
  obtain ⟨Z₀⟩ := zero_slice_extraction_and_regularity Ω C hDet W
  refine ⟨{
    Γ_slice := Z₀.Γ_slice
    a_mero := Z₀.a_mero
    f_mero := Z₀.f_mero
    E_disc := Z₀.E_disc
    E_disc_sub := Z₀.E_disc_sub
    E_disc_base_disjoint := Z₀.E_disc_base_disjoint
    E_disc_isolated := Z₀.E_disc_isolated
    Γ_mero := Z₀.Γ_mero
    a_mero_mero := Z₀.a_mero_mero
    f_mero_mero := Z₀.f_mero_mero
    slice_base_eq := Z₀.slice_base_eq
    slice_reg := Z₀.slice_reg
    no_1d_patch_Γ := fun H₀ x_star sgn ε hHX hsgn hε hPatch => by
      rcases hPatch with ⟨g, hg0, hg1, V_overlap, hVopen, hVne, hVsub, hg_eq⟩
      obtain ⟨P⟩ :=
        patch_local_recurrence_and_slab Ω C hDet W H₀ hHX Z₀ x_star sgn ε hsgn hε
          g hg0 hg1 V_overlap hVopen hVne hVsub hg_eq
      obtain ⟨S⟩ := steep_sector_dual_line_propagation Ω C hDet W H₀ hHX P
      exact quadratic_disk_wall_contradiction Ω C hDet W H₀
        P.x_edge P.R_0 P.y_row P.δ_slab hHX hDisk hNoPatch S
  }⟩

theorem meromorphic_wall_and_no_patch (Ω : Set Plane)
    (C : AnalyticGlancingCollar Ω)
    (hDet : EndpointDeterminationData C) :
    Nonempty (MeromorphicCollarData C) :=
by
  have hDisk : MeroDiskContinuationProp := mero_product_disk_continuation
  obtain ⟨W⟩ := collar_widths_and_superharmonicity Ω C hDet hDisk
  have hNoPatch : NoPatchAtRealProp W := real_wall_no_patch Ω C hDet W
  obtain ⟨Z⟩ := zero_slice_and_natural_boundary Ω C hDet W hDisk hNoPatch
  have hBaseOpen : IsOpen { p : ℂ × ℂ | |p.1.im| < W.s_base ∧ ‖p.2‖ < W.r_base } :=
    (isOpen_lt (continuous_abs.comp (Complex.continuous_im.comp continuous_fst))
      continuous_const).inter
      (isOpen_lt (continuous_norm.comp continuous_snd) continuous_const)
  have hBaseSubTwo : { p : ℂ × ℂ | |p.1.im| < W.s_base ∧ ‖p.2‖ < W.r_base } ⊆
      { p : ℂ × ℂ | |p.1.im| < 2 * W.s_base ∧ ‖p.2‖ < W.r_base } := by
    intro p hp
    exact ⟨by linarith [hp.1, W.s_base_pos], hp.2⟩
  refine ⟨{
    s_base := W.s_base
    r_base := W.r_base
    s_base_pos := W.s_base_pos
    s_base_le_s₁ := W.s_base_le_s₁
    s_base_le_s₀ := W.s_base_le_s₀
    r_base_pos := W.r_base_pos
    r_base_lt_s_base := W.r_base_lt_s_base
    r_base_lt_r₁ := W.r_base_lt_r₁
    r_base_lt_pi := W.r_base_lt_pi
    offset_ne_zero := W.offset_ne_zero
    h_X := W.h_X
    h_L := W.h_L
    h_X_ge := fun t ht =>
      le_trans (ENNReal.ofReal_le_ofReal (by linarith [W.s_base_pos])) (W.h_X_ge_two t ht)
    h_L_eq := W.h_L_eq
    h_X_even := W.h_X_even
    h_L_even := W.h_L_even
    h_X_lsc := W.h_X_lsc
    h_L_lsc := W.h_L_lsc
    h_X_supermean := W.h_X_supermean
    L_mero := W.L_mero
    X_mero := W.X_mero
    L_agrees := fun i => by
      obtain ⟨hSubW, hLocal⟩ := W.L_agrees_two i
      refine ⟨Set.Subset.trans hBaseSubTwo hSubW, fun p hp => ?_⟩
      obtain ⟨r₁, hr₁_pos, hr₁_sub⟩ := Metric.isOpen_iff.mp hBaseOpen p hp
      obtain ⟨r₂, hr₂_pos, hr₂_le, _, hr₂_eq⟩ := hLocal p (hBaseSubTwo hp)
      refine ⟨min r₁ r₂, lt_min hr₁_pos hr₂_pos, le_trans (min_le_right r₁ r₂) hr₂_le,
        Set.Subset.trans (Metric.ball_subset_ball (min_le_left r₁ r₂)) hr₁_sub,
        fun q hq => hr₂_eq q (Metric.ball_subset_ball (min_le_right r₁ r₂) hq)⟩
    X_agrees := fun i => by
      obtain ⟨hSubW, hLocal⟩ := W.X_agrees_two i
      refine ⟨Set.Subset.trans hBaseSubTwo hSubW, fun p hp => ?_⟩
      obtain ⟨r₁, hr₁_pos, hr₁_sub⟩ := Metric.isOpen_iff.mp hBaseOpen p hp
      obtain ⟨r₂, hr₂_pos, hr₂_le, _, hr₂_eq⟩ := hLocal p (hBaseSubTwo hp)
      refine ⟨min r₁ r₂, lt_min hr₁_pos hr₂_pos, le_trans (min_le_right r₁ r₂) hr₂_le,
        Set.Subset.trans (Metric.ball_subset_ball (min_le_left r₁ r₂)) hr₁_sub,
        fun q hq => hr₂_eq q (Metric.ball_subset_ball (min_le_right r₁ r₂) hq)⟩
    no_patch_X_at_real := hNoPatch.1
    no_patch_L_at_real := hNoPatch.2
    mero_disk_continuation := hDisk
    Γ_slice := Z.Γ_slice
    a_mero := Z.a_mero
    f_mero := Z.f_mero
    E_disc := Z.E_disc
    E_disc_sub := Z.E_disc_sub
    E_disc_base_disjoint := Z.E_disc_base_disjoint
    E_disc_isolated := Z.E_disc_isolated
    Γ_mero := Z.Γ_mero
    a_mero_mero := Z.a_mero_mero
    f_mero_mero := Z.f_mero_mero
    slice_base_eq := Z.slice_base_eq
    slice_reg := Z.slice_reg
    no_1d_patch_Γ := Z.no_1d_patch_Γ
  }⟩

theorem collar_isotropic_germ_and_symmetries (Ω : Set Plane)
    (C : AnalyticGlancingCollar Ω)
    (M : MeromorphicCollarData C) :
    Nonempty (CollarIsotropicBridge C M) :=
by
  have h_s4 :
      IsOpen (meroTubeENNR M.r_base M.h_X) ∧
      IsPreconnected (meroTubeENNR M.r_base M.h_X) ∧
      (∀ q ∈ meroTubeENNR M.r_base M.h_X, (q.1, -q.2) ∈ meroTubeENNR M.r_base M.h_X) ∧
      IsOpen (meroTubeShift (meroTubeENNR M.r_base M.h_X)) ∧
      IsPreconnected (meroTubeShift (meroTubeENNR M.r_base M.h_X)) ∧
      IsOpen (collarBaseBox M) ∧
      (collarBaseBox M).Nonempty ∧
      collarBaseBox M ⊆ meroTubeENNR M.r_base M.h_X ∧
      (∀ q ∈ collarBaseBox M, (q.1, -q.2) ∈ collarBaseBox M) ∧
      IsOpen (collarHalfBaseBox M) ∧
      (collarHalfBaseBox M).Nonempty ∧
      collarHalfBaseBox M ⊆ meroTubeShift (collarBaseBox M) ∧
      (∀ p ∈ horizStripENNR (M.h_X 0),
        (p, (0 : ℂ)) ∈ meroTubeShift (meroTubeENNR M.r_base M.h_X)) := by
    have hs_pos : 0 < M.s_base := M.s_base_pos
    have hr_pos : 0 < M.r_base := M.r_base_pos
    have hr_lt_s4 : M.r_base < M.s_base / 4 := M.r_base_lt_s_base
    have h_ennr_sep : ∀ (a : ℝ) (w : ENNReal),
        ENNReal.ofReal M.s_base ≤ w → ENNReal.ofReal a < w →
        ∃ b : ℝ, a < b ∧ ENNReal.ofReal b < w := by
      intro a w hw_ge ha_lt
      by_cases hw_top : w = ⊤
      · refine ⟨a + 1, by linarith, ?_⟩
        rw [hw_top]
        exact ENNReal.ofReal_lt_top
      · let H := w.toReal
        have hw_eq : ENNReal.ofReal H = w := ENNReal.ofReal_toReal hw_top
        have hH_ge : M.s_base ≤ H := by
          rw [← hw_eq] at hw_ge
          exact (ENNReal.ofReal_le_ofReal_iff (ENNReal.toReal_nonneg)).mp hw_ge
        have hH_pos : 0 < H := lt_of_lt_of_le hs_pos hH_ge
        have ha_lt_H : a < H := by
          rw [← hw_eq] at ha_lt
          exact (ENNReal.ofReal_lt_ofReal_iff hH_pos).mp ha_lt
        refine ⟨(a + H) / 2, by linarith, ?_⟩
        rw [← hw_eq, ENNReal.ofReal_lt_ofReal_iff hH_pos]
        linarith
    have hT_open : IsOpen (meroTubeENNR M.r_base M.h_X) := by
      rw [isOpen_iff_mem_nhds]
      rintro ⟨y₀, t₀⟩ ⟨ht₀_norm, h_lo₀, h_up₀⟩
      have ht₀_ball : t₀ ∈ Metric.ball (0 : ℂ) M.r_base := by simpa using ht₀_norm
      have ht₀c_ball : starRingEnd ℂ t₀ ∈ Metric.ball (0 : ℂ) M.r_base := by
        simpa [Complex.norm_conj] using ht₀_norm
      obtain ⟨b_up, hb_up_gt, hb_up_lt⟩ :=
        h_ennr_sep y₀.im (M.h_X t₀) (M.h_X_ge t₀ ht₀_ball) h_up₀
      obtain ⟨b_lo, hb_lo_gt, hb_lo_lt⟩ :=
        h_ennr_sep (-y₀.im) (M.h_X (starRingEnd ℂ t₀)) (M.h_X_ge _ ht₀c_ball) h_lo₀
      have h_lsc_up : ∀ᶠ t in nhds t₀, ENNReal.ofReal b_up < M.h_X t := by
        simpa [nhdsWithin_eq_nhds.mpr (isOpen_ball.mem_nhds ht₀_ball)] using
          M.h_X_lsc t₀ ht₀_ball (ENNReal.ofReal b_up) hb_up_lt
      have h_lsc_lo_c : ∀ᶠ w in nhds (starRingEnd ℂ t₀), ENNReal.ofReal b_lo < M.h_X w := by
        simpa [nhdsWithin_eq_nhds.mpr (isOpen_ball.mem_nhds ht₀c_ball)] using
          M.h_X_lsc (starRingEnd ℂ t₀) ht₀c_ball (ENNReal.ofReal b_lo) hb_lo_lt
      have h_lsc_lo : ∀ᶠ t in nhds t₀, ENNReal.ofReal b_lo < M.h_X (starRingEnd ℂ t) := by
        exact Complex.continuous_conj.continuousAt.eventually h_lsc_lo_c
      have hUy : {y : ℂ | -b_lo < y.im ∧ y.im < b_up} ∈ nhds y₀ := by
        refine IsOpen.mem_nhds ?_ ⟨by linarith, hb_up_gt⟩
        exact (isOpen_lt continuous_const Complex.continuous_im).inter
          (isOpen_lt Complex.continuous_im continuous_const)
      have hVt : (Metric.ball (0 : ℂ) M.r_base ∩
          {t : ℂ | ENNReal.ofReal b_up < M.h_X t} ∩
          {t : ℂ | ENNReal.ofReal b_lo < M.h_X (starRingEnd ℂ t)}) ∈ nhds t₀ :=
        Filter.inter_mem (Filter.inter_mem (isOpen_ball.mem_nhds ht₀_ball) h_lsc_up) h_lsc_lo
      filter_upwards [prod_mem_nhds hUy hVt] with ⟨y, t⟩ ⟨⟨hy_lo, hy_up⟩, ⟨⟨ht_b, ht_up⟩, ht_lo⟩⟩
      refine ⟨by simpa using ht_b, ?_, ?_⟩
      · exact lt_of_le_of_lt (ENNReal.ofReal_le_ofReal (by linarith)) ht_lo
      · exact lt_of_le_of_lt (ENNReal.ofReal_le_ofReal (le_of_lt hy_up)) ht_up
    have hT_even : ∀ q ∈ meroTubeENNR M.r_base M.h_X, (q.1, -q.2) ∈ meroTubeENNR M.r_base M.h_X := by
      rintro ⟨y, t⟩ ⟨ht, h_lo, h_up⟩
      have ht_b : t ∈ Metric.ball (0 : ℂ) M.r_base := by simpa using ht
      have htc_b : starRingEnd ℂ t ∈ Metric.ball (0 : ℂ) M.r_base := by
        simpa [Complex.norm_conj] using ht
      refine ⟨by simpa using ht, ?_, ?_⟩
      · simpa [map_neg, M.h_X_even (starRingEnd ℂ t) htc_b] using h_lo
      · simpa [M.h_X_even t ht_b] using h_up
    have hTsh_open : IsOpen (meroTubeShift (meroTubeENNR M.r_base M.h_X)) := by
      have h1 : Continuous (fun q : ℂ × ℂ => (q.1 - q.2, q.2)) :=
        (continuous_fst.sub continuous_snd).prodMk continuous_snd
      have h2 : Continuous (fun q : ℂ × ℂ => (q.1 + q.2, q.2)) :=
        (continuous_fst.add continuous_snd).prodMk continuous_snd
      exact hT_open.inter ((hT_open.preimage h1).inter (hT_open.preimage h2))
    have hBase_open : IsOpen (collarBaseBox M) :=
      (isOpen_lt (continuous_abs.comp (Complex.continuous_im.comp continuous_fst))
        continuous_const).inter
        (isOpen_lt (continuous_norm.comp continuous_snd) continuous_const)
    have hHalf_open : IsOpen (collarHalfBaseBox M) :=
      (isOpen_lt (continuous_abs.comp (Complex.continuous_im.comp continuous_fst))
        continuous_const).inter
        (isOpen_lt (continuous_norm.comp continuous_snd) continuous_const)
    have h0_half : ((0 : ℂ), (0 : ℂ)) ∈ collarHalfBaseBox M := by
      refine ⟨?_, ?_⟩ <;> simp [hs_pos, hr_pos]
    have hHalf_sub_shBase : collarHalfBaseBox M ⊆ meroTubeShift (collarBaseBox M) := by
      rintro ⟨y, t⟩ ⟨hy, ht⟩
      have ht_im : |t.im| ≤ ‖t‖ := Complex.abs_im_le_norm t
      refine ⟨⟨by linarith, by linarith⟩, ⟨?_, by linarith⟩, ⟨?_, by linarith⟩⟩
      · have : |(y - t).im| ≤ |y.im| + |t.im| := by
          simpa [Complex.sub_im, sub_eq_add_neg] using abs_add_le y.im (-t.im)
        linarith
      · have : |(y + t).im| ≤ |y.im| + |t.im| := by
          simpa [Complex.add_im] using abs_add_le y.im t.im
        linarith
    have hBase_sub_T : collarBaseBox M ⊆ meroTubeENNR M.r_base M.h_X := by
      rintro ⟨y, t⟩ ⟨hy, ht⟩
      have ht_b : t ∈ Metric.ball (0 : ℂ) M.r_base := by simpa using ht
      have htc_b : starRingEnd ℂ t ∈ Metric.ball (0 : ℂ) M.r_base := by
        simpa [Complex.norm_conj] using ht
      have hy1 : -y.im < M.s_base := (abs_lt.mp hy).1 |> neg_lt.mp
      have hy2 : y.im < M.s_base := (abs_lt.mp hy).2
      refine ⟨ht, ?_, ?_⟩
      · exact lt_of_lt_of_le ((ENNReal.ofReal_lt_ofReal_iff hs_pos).mpr hy1) (M.h_X_ge _ htc_b)
      · exact lt_of_lt_of_le ((ENNReal.ofReal_lt_ofReal_iff hs_pos).mpr hy2) (M.h_X_ge _ ht_b)
    have h0_base : ((0 : ℂ), (0 : ℂ)) ∈ collarBaseBox M := (hHalf_sub_shBase h0_half).1
    have hBase_even : ∀ q ∈ collarBaseBox M, (q.1, -q.2) ∈ collarBaseBox M := by
      rintro ⟨y, t⟩ ⟨hy, ht⟩
      exact ⟨hy, by simpa using ht⟩
    have hSlice_mem : ∀ p ∈ horizStripENNR (M.h_X 0),
        (p, (0 : ℂ)) ∈ meroTubeShift (meroTubeENNR M.r_base M.h_X) := by
      intro p hp
      have hp_T : (p, (0 : ℂ)) ∈ meroTubeENNR M.r_base M.h_X := by
        refine ⟨by simpa using hr_pos, ?_, ?_⟩
        · simpa using lt_of_le_of_lt (ENNReal.ofReal_le_ofReal (neg_le_abs p.im)) hp
        · exact lt_of_le_of_lt (ENNReal.ofReal_le_ofReal (le_abs_self p.im)) hp
      simpa [meroTubeShift] using hp_T
    have h_preconn_of_join : ∀ (S : Set (ℂ × ℂ)),
        (∀ q ∈ S, ∃ K : Set (ℂ × ℂ), IsPreconnected K ∧ K ⊆ S ∧ ((0 : ℂ), (0 : ℂ)) ∈ K ∧ q ∈ K) →
        IsPreconnected S := by
      intro S hjoin u v hu hv hSuv ⟨qu, hqu_S, hqu_u⟩ ⟨qv, hqv_S, hqv_v⟩
      obtain ⟨Ku, hKu_pre, hKu_sub, hKu_0, hKu_q⟩ := hjoin qu hqu_S
      obtain ⟨Kv, hKv_pre, hKv_sub, hKv_0, hKv_q⟩ := hjoin qv hqv_S
      have hKuv_pre : IsPreconnected (Ku ∪ Kv) := hKu_pre.union' ⟨(0, 0), hKu_0, hKv_0⟩ hKv_pre
      have hKuv_sub : Ku ∪ Kv ⊆ S := Set.union_subset hKu_sub hKv_sub
      obtain ⟨w, hw_K, hw_uv⟩ := hKuv_pre u v hu hv (hKuv_sub.trans hSuv)
        ⟨qu, Or.inl hKu_q, hqu_u⟩ ⟨qv, Or.inr hKv_q, hqv_v⟩
      exact ⟨w, hKuv_sub hw_K, hw_uv⟩
    have h_vert_step : ∀ (y t : ℂ) (c η : ℝ),
        |c| ≤ 1 → 0 ≤ η → η ≤ 1 →
        (y + (c : ℂ) * t, t) ∈ meroTubeENNR M.r_base M.h_X →
        ((y.re : ℂ) + ((η * y.im : ℝ) : ℂ) * Complex.I + (c : ℂ) * t, t) ∈
          meroTubeENNR M.r_base M.h_X := by
      intro y t c η hc hη0 hη1 ⟨ht_norm, h_lo, h_up⟩
      have ht_b : t ∈ Metric.ball (0 : ℂ) M.r_base := by simpa using ht_norm
      have htc_b : starRingEnd ℂ t ∈ Metric.ball (0 : ℂ) M.r_base := by
        simpa [Complex.norm_conj] using ht_norm
      have hct_im : |c * t.im| < M.s_base := by
        have h1 : |c * t.im| ≤ 1 * |t.im| := by
          rw [abs_mul]
          exact mul_le_mul_of_nonneg_right hc (abs_nonneg _)
        have h2 : |t.im| ≤ ‖t‖ := Complex.abs_im_le_norm t
        linarith
      have h_im_eq : ((y.re : ℂ) + ((η * y.im : ℝ) : ℂ) * Complex.I + (c : ℂ) * t).im =
          η * y.im + c * t.im := by simp
      have h_orig_im : (y + (c : ℂ) * t).im = y.im + c * t.im := by simp
      refine ⟨ht_norm, ?_, ?_⟩
      · rw [h_im_eq]
        rcases le_or_gt 0 y.im with hy_nn | hy_neg
        · have h_le : -(η * y.im + c * t.im) < M.s_base := by
            have : 0 ≤ η * y.im := mul_nonneg hη0 hy_nn
            have : -c * t.im ≤ |c * t.im| := by simpa using neg_le_abs (c * t.im)
            linarith
          exact lt_of_lt_of_le ((ENNReal.ofReal_lt_ofReal_iff hs_pos).mpr h_le) (M.h_X_ge _ htc_b)
        · have h_le : -(η * y.im + c * t.im) ≤ -(y + (c : ℂ) * t).im := by
            rw [h_orig_im]
            nlinarith
          exact lt_of_le_of_lt (ENNReal.ofReal_le_ofReal h_le) h_lo
      · rw [h_im_eq]
        rcases le_or_gt 0 y.im with hy_nn | hy_neg
        · have h_le : η * y.im + c * t.im ≤ (y + (c : ℂ) * t).im := by
            rw [h_orig_im]
            nlinarith
          exact lt_of_le_of_lt (ENNReal.ofReal_le_ofReal h_le) h_up
        · have h_le : η * y.im + c * t.im < M.s_base := by
            have : η * y.im ≤ 0 := mul_nonpos_of_nonneg_of_nonpos hη0 (le_of_lt hy_neg)
            have : c * t.im ≤ |c * t.im| := le_abs_self _
            linarith
          exact lt_of_lt_of_le ((ENNReal.ofReal_lt_ofReal_iff hs_pos).mpr h_le) (M.h_X_ge _ ht_b)
    have h_rad_step : ∀ (x : ℝ) (t : ℂ) (c μ : ℝ),
        ‖t‖ < M.r_base → |c| ≤ 1 → 0 ≤ μ → μ ≤ 1 →
        ((μ : ℂ) * (x : ℂ) + (c : ℂ) * ((μ : ℂ) * t), (μ : ℂ) * t) ∈
          meroTubeENNR M.r_base M.h_X := by
      intro x t c μ ht hc hμ0 hμ1
      apply hBase_sub_T
      refine ⟨?_, ?_⟩
      · have h_im : ((μ : ℂ) * (x : ℂ) + (c : ℂ) * ((μ : ℂ) * t)).im = c * (μ * t.im) := by
          simp [mul_assoc]
        rw [h_im, abs_mul, abs_mul, abs_of_nonneg hμ0]
        have h1 : |c| * (μ * |t.im|) ≤ 1 * (1 * ‖t‖) := by
          refine mul_le_mul hc ?_ (mul_nonneg hμ0 (abs_nonneg _)) zero_le_one
          exact mul_le_mul hμ1 (Complex.abs_im_le_norm t) (abs_nonneg _) zero_le_one
        linarith
      · rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg hμ0]
        exact lt_of_le_of_lt (mul_le_of_le_one_left (norm_nonneg t) hμ1) ht
    have hT_preconn : IsPreconnected (meroTubeENNR M.r_base M.h_X) := by
      apply h_preconn_of_join
      rintro ⟨y, t⟩ hq
      let γ₁ : ℝ → ℂ × ℂ := fun η => ((y.re : ℂ) + ((η * y.im : ℝ) : ℂ) * Complex.I, t)
      let γ₂ : ℝ → ℂ × ℂ := fun μ => ((μ : ℂ) * (y.re : ℂ), (μ : ℂ) * t)
      have hγ₁_cont : Continuous γ₁ := by fun_prop
      have hγ₂_cont : Continuous γ₂ := by fun_prop
      have hIcc : IsPreconnected (Set.Icc (0 : ℝ) 1) := isPreconnected_Icc
      have h01 : (0 : ℝ) ∈ Set.Icc (0 : ℝ) 1 := ⟨le_rfl, zero_le_one⟩
      have h11 : (1 : ℝ) ∈ Set.Icc (0 : ℝ) 1 := ⟨zero_le_one, le_rfl⟩
      have h_mid : γ₂ 1 = γ₁ 0 := by simp [γ₁, γ₂]
      refine ⟨(γ₂ '' Set.Icc 0 1) ∪ (γ₁ '' Set.Icc 0 1), ?_, ?_, ?_, ?_⟩
      · exact (hIcc.image γ₂ hγ₂_cont.continuousOn).union'
          ⟨γ₂ 1, ⟨1, h11, rfl⟩, h_mid ▸ ⟨0, h01, rfl⟩⟩
