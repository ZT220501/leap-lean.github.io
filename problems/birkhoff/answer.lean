    rcases h_not_all with ⟨m, hm_ge, hm_le, j, h_bad⟩
    change τ₀ ≤ m at hm_ge
    change m ≤ τ_M at hm_le
    simp only [Set.mem_iUnion, Set.mem_union]
    refine ⟨j, Finset.mem_univ j, ?_⟩
    have h_ang_sum :
        ∑ n ∈ Finset.range m,
          w_ang n om *
            (sliceAngleSeq S P.N j.val (walkPos ρ om (n + 1)) -
              sliceAngleSeq S P.N j.val (walkPos ρ om n)) =
        sliceAngleSeq S P.N j.val (walkPos ρ om m) -
          sliceAngleSeq S P.N j.val (walkPos ρ om τ₀) := by
      rw [← Finset.sum_range_add_sum_Ico _ hm_ge]
      have h_z : ∑ n ∈ Finset.range τ₀,
          w_ang n om *
            (sliceAngleSeq S P.N j.val (walkPos ρ om (n + 1)) -
              sliceAngleSeq S P.N j.val (walkPos ρ om n)) = 0 := by
        refine Finset.sum_eq_zero fun n hn => ?_
        have hn_not := h_act_before n (Finset.mem_range.mp hn)
        simp [w_ang, hn_not]
      have h_ico : ∑ n ∈ Finset.Ico τ₀ m,
          w_ang n om *
            (sliceAngleSeq S P.N j.val (walkPos ρ om (n + 1)) -
              sliceAngleSeq S P.N j.val (walkPos ρ om n)) =
          ∑ n ∈ Finset.Ico τ₀ m,
            (sliceAngleSeq S P.N j.val (walkPos ρ om (n + 1)) -
              sliceAngleSeq S P.N j.val (walkPos ρ om n)) := by
        refine Finset.sum_congr rfl fun n hn => ?_
        rcases Finset.mem_Ico.mp hn with ⟨hn1, hn2⟩
        have hn_act := h_act_on n hn1 (lt_of_lt_of_le hn2 hm_le)
        simp [w_ang, hn_act]
      rw [h_z, zero_add, h_ico]
      exact Finset.sum_Ico_sub (fun k => sliceAngleSeq S P.N j.val (walkPos ρ om k)) hm_ge
    have h_sup_sum :
        ∑ n ∈ Finset.range m,
          w_sup n om *
            (sliceSupportSeq S P.N j.val (walkPos ρ om (n + 1)) -
              sliceSupportSeq S P.N j.val (walkPos ρ om n)) =
        ∑ n ∈ Finset.Ico τ₀ m,
          ((bootRunningPosMax S P (walkPos ρ om) n : ℂ)⁻¹ *
            (sliceSupportSeq S P.N j.val (walkPos ρ om (n + 1)) -
              sliceSupportSeq S P.N j.val (walkPos ρ om n))) := by
      rw [← Finset.sum_range_add_sum_Ico _ hm_ge]
      have h_z : ∑ n ∈ Finset.range τ₀,
          w_sup n om *
            (sliceSupportSeq S P.N j.val (walkPos ρ om (n + 1)) -
              sliceSupportSeq S P.N j.val (walkPos ρ om n)) = 0 := by
        refine Finset.sum_eq_zero fun n hn => ?_
        have hn_not := h_act_before n (Finset.mem_range.mp hn)
        simp [w_sup, hn_not]
      have h_ico : ∑ n ∈ Finset.Ico τ₀ m,
          w_sup n om *
            (sliceSupportSeq S P.N j.val (walkPos ρ om (n + 1)) -
              sliceSupportSeq S P.N j.val (walkPos ρ om n)) =
          ∑ n ∈ Finset.Ico τ₀ m,
            ((bootRunningPosMax S P (walkPos ρ om) n : ℂ)⁻¹ *
              (sliceSupportSeq S P.N j.val (walkPos ρ om (n + 1)) -
                sliceSupportSeq S P.N j.val (walkPos ρ om n))) := by
        refine Finset.sum_congr rfl fun n hn => ?_
        rcases Finset.mem_Ico.mp hn with ⟨hn1, hn2⟩
        have hn_act := h_act_on n hn1 (lt_of_lt_of_le hn2 hm_le)
        simp [w_sup, hn_act]
      rw [h_z, zero_add, h_ico]
    by_cases h_ang_ok :
        ‖sliceAngleSeq S P.N j.val (walkPos ρ om m) -
          sliceAngleSeq S P.N j.val (walkPos ρ om τ₀)‖ ≤ lam
    · right
      exact ⟨m, by rw [h_sup_sum]; exact h_bad h_ang_ok⟩
    · left
      exact ⟨m, by rw [h_ang_sum]; exact lt_of_not_ge h_ang_ok⟩
  have h_union_le :
      walkMeasure.real E_target ≤
        (P.N : ℝ) * (Q_ang / lam ^ 2 + Q_sup / lam ^ 2) := by
    calc
      walkMeasure.real E_target
        ≤ walkMeasure.real (⋃ j ∈ (Finset.univ : Finset (Fin P.N)), (E_ang j ∪ E_sup j)) :=
          MeasureTheory.measureReal_mono h_sub_union (MeasureTheory.measure_ne_top walkMeasure _)
      _ ≤ ∑ j ∈ (Finset.univ : Finset (Fin P.N)), walkMeasure.real (E_ang j ∪ E_sup j) :=
          MeasureTheory.measureReal_biUnion_finset_le Finset.univ (fun j => E_ang j ∪ E_sup j)
      _ ≤ ∑ j ∈ (Finset.univ : Finset (Fin P.N)),
            (walkMeasure.real (E_ang j) + walkMeasure.real (E_sup j)) :=
          Finset.sum_le_sum fun j _ => MeasureTheory.measureReal_union_le (E_ang j) (E_sup j)
      _ ≤ ∑ _j ∈ (Finset.univ : Finset (Fin P.N)), (Q_ang / lam ^ 2 + Q_sup / lam ^ 2) :=
          Finset.sum_le_sum fun j _ => add_le_add (h_meas_ang j) (h_meas_sup j)
      _ = (P.N : ℝ) * (Q_ang / lam ^ 2 + Q_sup / lam ^ 2) := by
          rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
  refine le_trans h_union_le ?_
  have h_sum_Q :
      (P.N : ℝ) * (Q_ang / lam ^ 2 + Q_sup / lam ^ 2) =
        ((2 + 8 * Real.exp (2 * B_geom)) * η_ang ^ 2 + Real.exp (-2 * M ^ 3)) *
          ((P.N : ℝ) * B_clk / lam ^ 2) := by
    dsimp only [Q_ang, Q_sup, C_ang, C_sup]
    ring
  have h_rhs_eq :
      8 * (P.N : ℝ) * ((1 + 4 * Real.exp (2 * B_geom)) * η_ang ^ 2 +
          Real.exp (-2 * M ^ 3)) * B_clk / lam ^ 2 =
        (8 * (1 + 4 * Real.exp (2 * B_geom)) * η_ang ^ 2 + 8 * Real.exp (-2 * M ^ 3)) *
          ((P.N : ℝ) * B_clk / lam ^ 2) := by
    ring
  rw [h_sum_Q, h_rhs_eq]
  refine mul_le_mul_of_nonneg_right ?_ (by positivity)
  have he1 : 0 < Real.exp (2 * B_geom) := Real.exp_pos _
  have he2 : 0 < Real.exp (-2 * M ^ 3) := Real.exp_pos _
  have hη2 : 0 < η_ang ^ 2 := sq_pos_of_pos hη
  nlinarith

theorem slice_cofactor_impact_deriv_cap (S : FiniteWallNonisotropicStrip)
    (hBudget : CriticalAngleBudgetData S) (P : OddPeriodicSliceData S) :
    ∃ C₁ : ℝ, 1 ≤ C₁ ∧
      ∀ M : ℝ, 2 ≤ M →
        ∀ y ∈ horizStrip (sliceHeight S P.N) \ P.Z_all,
          sliceGeomCost S P y ≤ 2 * M →
          (∀ i : Fin P.N, sliceLogDepth S P i y ≤ 2 * M) →
          ∀ j : Fin P.N,
            ‖deriv (sliceImpactSeq S P.N j.val) y‖ ≤ Real.exp (C₁ * M) :=
by
  have h_speed_cap : ∃ C_f : ℝ, 1 ≤ C_f ∧ ∀ s ∈ horizStrip S.H,
      ‖S.f s‖ ≤ Real.exp (C_f * (1 + max (-Real.log (S.H - |s.im|)) 0)) := by
    let k₀ : ℝ := hBudget.k₀
    have hk₀_ge_one : 1 ≤ k₀ := hBudget.k₀_ge_one
    have hexp_k₀_pos : 0 < Real.exp (-k₀) := Real.exp_pos (-k₀)
    have hexp_k₀_lt_H : Real.exp (-k₀) < S.H := by
      have h1 := hBudget.exp_neg_k₀_lt
      have h2 := S.H_pos
      linarith
    let H_int : ℝ := S.H - Real.exp (-k₀)
    have hH_int_pos : 0 < H_int := by dsimp only [H_int]; linarith
    have hH_int_lt_H : H_int < S.H := by dsimp only [H_int]; linarith
    let Φ_rect : ℝ × ℝ → ℂ := fun p => (p.1 : ℂ) + (p.2 : ℂ) * Complex.I
    have hΦ_cont : Continuous Φ_rect := by
      refine Continuous.add (Complex.continuous_ofReal.comp continuous_fst) ?_
      exact Continuous.mul (Complex.continuous_ofReal.comp continuous_snd) continuous_const
    let K_rect : Set ℂ :=
      Φ_rect '' (Set.Icc (0 : ℝ) (2 * Real.pi) ×ˢ Set.Icc (-H_int) H_int)
    have hK_compact : IsCompact K_rect :=
      (isCompact_Icc.prod isCompact_Icc).image hΦ_cont
    have hK_sub : K_rect ⊆ horizStrip S.H := by
      rintro z ⟨⟨x, v⟩, ⟨_, hv⟩, rfl⟩
      simp only [horizStrip, Set.mem_setOf_eq, Φ_rect, Complex.add_im, Complex.ofReal_im,
        Complex.mul_im, Complex.I_re, Complex.I_im, Complex.ofReal_re, mul_one, mul_zero,
        add_zero, zero_add]
      exact lt_of_le_of_lt (abs_le.mpr hv) hH_int_lt_H
    obtain ⟨M_int, hM_int⟩ :=
      hK_compact.exists_bound_of_continuousOn (S.f_holo.continuousOn.mono hK_sub)
    have h_real_shift_mem : ∀ z ∈ horizStrip S.H, ∀ x : ℝ,
        z + (x : ℂ) ∈ horizStrip S.H := by
      intro z hz x
      simp only [horizStrip, Set.mem_setOf_eq, Complex.add_im, Complex.ofReal_im, add_zero] at hz ⊢
      exact hz
    have hf_per_nat : ∀ (n : ℕ), ∀ z ∈ horizStrip S.H,
        S.f (z + (n : ℂ) * (2 * (Real.pi : ℂ))) = S.f z := by
      intro n
      induction n with
      | zero =>
          intro z _
          simp
      | succ n ih =>
          intro z hz
          have hz_n : z + (n : ℂ) * (2 * (Real.pi : ℂ)) ∈ horizStrip S.H := by
            have h_eq : z + (n : ℂ) * (2 * (Real.pi : ℂ)) =
                z + (((n : ℝ) * (2 * Real.pi) : ℝ) : ℂ) := by
              push_cast
              ring
            rw [h_eq]
            exact h_real_shift_mem z hz _
          have h_split : z + ((n + 1 : ℕ) : ℂ) * (2 * (Real.pi : ℂ)) =
              (z + (n : ℂ) * (2 * (Real.pi : ℂ))) + 2 * (Real.pi : ℂ) := by
            push_cast
            ring
          rw [h_split, S.f_periodic _ hz_n, ih z hz]
    have hf_per_int : ∀ (m : ℤ), ∀ z ∈ horizStrip S.H,
        S.f (z + (m : ℂ) * (2 * (Real.pi : ℂ))) = S.f z := by
      intro m z hz
      cases m with
      | ofNat n =>
          simpa using hf_per_nat n z hz
      | negSucc n =>
          let w : ℂ := z + (Int.negSucc n : ℂ) * (2 * (Real.pi : ℂ))
          have hw_mem : w ∈ horizStrip S.H := by
            have h_eq : w = z + (((Int.negSucc n : ℝ) * (2 * Real.pi) : ℝ) : ℂ) := by
              dsimp only [w]
              push_cast
              ring
            rw [h_eq]
            exact h_real_shift_mem z hz _
          have hw_back : w + ((n + 1 : ℕ) : ℂ) * (2 * (Real.pi : ℂ)) = z := by
            dsimp only [w]
            rw [Int.negSucc_eq]
            push_cast
            ring
          have h1 := hf_per_nat (n + 1) w hw_mem
          rw [hw_back] at h1
          exact h1.symm
    let C₀ : ℝ := max hBudget.C_env 1
    let A₀ : ℝ := max M_int 0 + 1
    let C_f : ℝ := max (C₀ + 3) A₀
    have hC₀_ge_one : 1 ≤ C₀ := le_max_right _ _
    have hC_f_ge_one : 1 ≤ C_f :=
      le_trans (by linarith : 1 ≤ C₀ + 3) (le_max_left _ _)
    refine ⟨C_f, hC_f_ge_one, ?_⟩
    intro s hs
    have hs_im : |s.im| < S.H := hs
    let δ : ℝ := S.H - |s.im|
    have hδ_pos : 0 < δ := by dsimp only [δ]; linarith
    let K_pos : ℝ := max (-Real.log δ) 0
    have hK_pos_nn : 0 ≤ K_pos := le_max_right _ _
    by_cases h_slab : |s.im| ≤ H_int
    · let u : ℝ := s.re / (2 * Real.pi)
      let m : ℤ := ⌊u⌋
      let x₀ : ℝ := 2 * Real.pi * Int.fract u
      have h2pi_pos : 0 < 2 * Real.pi := Real.two_pi_pos
      have hx₀_nonneg : 0 ≤ x₀ := mul_nonneg h2pi_pos.le (Int.fract_nonneg u)
      have hx₀_le : x₀ ≤ 2 * Real.pi := by
        have hlt : Int.fract u ≤ 1 := (Int.fract_lt_one u).le
        nlinarith
      have hs₀_mem_K : Φ_rect (x₀, s.im) ∈ K_rect :=
        ⟨(x₀, s.im), ⟨⟨hx₀_nonneg, hx₀_le⟩, abs_le.mp h_slab⟩, rfl⟩
      have hs₀_strip : Φ_rect (x₀, s.im) ∈ horizStrip S.H := hK_sub hs₀_mem_K
      have hs_decomp : s = Φ_rect (x₀, s.im) + (m : ℂ) * (2 * (Real.pi : ℂ)) := by
        have hre : s.re = x₀ + (m : ℝ) * (2 * Real.pi) := by
          have hfr : Int.fract u + (m : ℝ) = u := Int.fract_add_floor u
          have hu : 2 * Real.pi * u = s.re := mul_div_cancel₀ s.re h2pi_pos.ne'
          calc
            s.re = 2 * Real.pi * u := hu.symm
            _ = 2 * Real.pi * (Int.fract u + (m : ℝ)) := by rw [hfr]
            _ = x₀ + (m : ℝ) * (2 * Real.pi) := by dsimp only [x₀]; ring
        conv_lhs => rw [← Complex.re_add_im s, hre]
        dsimp only [Φ_rect]
        push_cast
        ring
      have h_norm_eq : ‖S.f s‖ = ‖S.f (Φ_rect (x₀, s.im))‖ := by
        conv_lhs => rw [hs_decomp]
        rw [hf_per_int m (Φ_rect (x₀, s.im)) hs₀_strip]
      have h_le_M : ‖S.f s‖ ≤ M_int := by
        rw [h_norm_eq]
        exact hM_int _ hs₀_mem_K
      have hA₀_le_exp : A₀ ≤ Real.exp A₀ :=
        le_trans (by linarith) (Real.add_one_le_exp A₀)
      have hA₀_le_Cf : A₀ ≤ C_f * (1 + K_pos) := by
        have h1 : A₀ ≤ C_f := le_max_right _ _
        nlinarith
      calc
        ‖S.f s‖ ≤ M_int := h_le_M
        _ ≤ A₀ := by dsimp only [A₀]; linarith [le_max_left M_int 0]
        _ ≤ Real.exp A₀ := hA₀_le_exp
        _ ≤ Real.exp (C_f * (1 + K_pos)) := Real.exp_le_exp.mpr hA₀_le_Cf
    · have h_gt : H_int < |s.im| := lt_of_not_ge h_slab
      have hδ_lt : δ < Real.exp (-k₀) := by dsimp only [δ, H_int] at h_gt ⊢; linarith
      let k : ℝ := -Real.log δ
      have hk₀_lt_k : k₀ < k := by
        have hlog := Real.log_lt_log hδ_pos hδ_lt
        rw [Real.log_exp] at hlog
        dsimp only [k]
        linarith
      have hk₀_le_k : hBudget.k₀ ≤ k := le_of_lt hk₀_lt_k
      have hk_nn : 0 ≤ k := by linarith
      have hK_pos_eq : K_pos = k := max_eq_left hk_nn
      have hexp_neg_k : Real.exp (-k) = δ := by
        dsimp only [k]
        rw [neg_neg, Real.exp_log hδ_pos]
      have habs_im : |s.im| = S.H - Real.exp (-k) := by
        rw [hexp_neg_k]
        dsimp only [δ]
        ring
      let s_up : ℂ := (s.re : ℂ) + ((S.H - Real.exp (-k) : ℝ) : ℂ) * Complex.I
      have h_norm_up : ‖S.f s‖ = ‖S.f s_up‖ := by
        by_cases him : 0 ≤ s.im
        · have hs_eq : s = s_up := by
            have him_eq : s.im = S.H - Real.exp (-k) := by
              rw [← habs_im, abs_of_nonneg him]
            dsimp only [s_up]
            rw [← him_eq, Complex.re_add_im]
          rw [hs_eq]
        · have him_neg : s.im < 0 := lt_of_not_ge him
          have hconj_eq : starRingEnd ℂ s = s_up := by
            have him_eq : (starRingEnd ℂ s).im = S.H - Real.exp (-k) := by
              rw [Complex.conj_im, ← habs_im, abs_of_neg him_neg]
            dsimp only [s_up]
            rw [← him_eq, ← Complex.conj_re s, Complex.re_add_im]
          have h_fconj : S.f s_up = starRingEnd ℂ (S.f s) := by
            rw [← hconj_eq]
            exact S.f_conj s hs
          rw [h_fconj, Complex.norm_conj]
      have h_row := hBudget.row_sup_poly_bound k hk₀_le_k s.re
      have hq_nn : 0 ≤ Real.sqrt ‖S.q s_up‖ := Real.sqrt_nonneg _
      have h_exp_f : Real.exp (-k) * ‖S.f s_up‖ ≤ hBudget.C_env * (1 + k) ^ 2 := by
        have h1 : Real.exp (-k) * ‖S.f s_up‖ ≤
            Real.exp (-k) * (‖S.f s_up‖ + Real.sqrt ‖S.q s_up‖) :=
          mul_le_mul_of_nonneg_left (by linarith) (Real.exp_nonneg _)
        exact le_trans h1 h_row
      have h_f_bound : ‖S.f s‖ ≤ hBudget.C_env * (1 + k) ^ 2 * Real.exp k := by
        rw [h_norm_up]
        have h_mul := mul_le_mul_of_nonneg_right h_exp_f (Real.exp_nonneg k)
        have h_lhs : Real.exp (-k) * ‖S.f s_up‖ * Real.exp k = ‖S.f s_up‖ := by
          calc
            Real.exp (-k) * ‖S.f s_up‖ * Real.exp k =
                ‖S.f s_up‖ * (Real.exp (-k) * Real.exp k) := by ring
            _ = ‖S.f s_up‖ * 1 := by rw [← Real.exp_add, neg_add_cancel, Real.exp_zero]
            _ = ‖S.f s_up‖ := mul_one _
        rw [h_lhs] at h_mul
        exact h_mul
      have hC_le_exp : hBudget.C_env ≤ Real.exp C₀ := by
        calc
          hBudget.C_env ≤ C₀ := le_max_left _ _
          _ ≤ C₀ + 1 := by linarith
          _ ≤ Real.exp C₀ := Real.add_one_le_exp C₀
      have h_poly_le_exp : (1 + k) ^ 2 ≤ Real.exp (2 * k) := by
        have h1 : 1 + k ≤ Real.exp k := by linarith [Real.add_one_le_exp k]
        calc
          (1 + k) ^ 2 ≤ (Real.exp k) ^ 2 := pow_le_pow_left₀ (by linarith) h1 2
          _ = Real.exp ((2 : ℕ) * k) := (Real.exp_nat_mul k 2).symm
          _ = Real.exp (2 * k) := by norm_num
      have h_prod_le : hBudget.C_env * (1 + k) ^ 2 * Real.exp k ≤ Real.exp (C₀ + 3 * k) := by
        calc
          hBudget.C_env * (1 + k) ^ 2 * Real.exp k
            ≤ Real.exp C₀ * Real.exp (2 * k) * Real.exp k := by
              refine mul_le_mul_of_nonneg_right ?_ (Real.exp_nonneg k)
              exact mul_le_mul hC_le_exp h_poly_le_exp (by positivity) (Real.exp_nonneg C₀)
          _ = Real.exp (C₀ + 3 * k) := by
              rw [← Real.exp_add, ← Real.exp_add]
              exact congrArg Real.exp (by ring)
      have h_exp_arg : C₀ + 3 * k ≤ C_f * (1 + K_pos) := by
        rw [hK_pos_eq]
        have hCf_ge : C₀ + 3 ≤ C_f := le_max_left _ _
        nlinarith
      exact le_trans h_f_bound (le_trans h_prod_le (Real.exp_le_exp.mpr h_exp_arg))
  obtain ⟨C_f, hC_f_ge, hf_cap⟩ := h_speed_cap
  have hN_ge_three : (3 : ℝ) ≤ (P.N : ℝ) := by exact_mod_cast P.N_ge_three
  have hN_pos : 0 < (P.N : ℝ) := by linarith
  have hc_pos : 0 < S.c := S.c_pos
  let K_pre : ℝ :=
    max 1 (‖S.A (sliceParamT0 P.N : ℂ) / (P.N : ℂ)‖ * (P.N.factorial : ℝ) *
      (4 + 2 / S.c) ^ P.N)
  have hK_pre_ge : 1 ≤ K_pre := le_max_left _ _
  have hK_pre_pos : 0 < K_pre := by linarith
  have hlog_Kpre_nn : 0 ≤ Real.log K_pre := Real.log_nonneg hK_pre_ge
  let C_w : ℝ := Real.log K_pre + (P.N : ℝ) * (9 * C_f + 4)
  have hC_w_pos : 0 < C_w := by dsimp only [C_w]; nlinarith
  let K_c : ℝ := max 1 (S.c)⁻¹
  have hK_c_ge : 1 ≤ K_c := le_max_left _ _
  have hK_c_pos : 0 < K_c := by linarith
  have hlog_Kc_nn : 0 ≤ Real.log K_c := Real.log_nonneg hK_c_ge
  let C₁ : ℝ := Real.log K_c + 6 * C_f + 2 + C_w
  have hC₁_ge : 1 ≤ C₁ := by dsimp only [C₁]; linarith
  refine ⟨C₁, hC₁_ge, ?_⟩
  intro M hM y hy hGeom hDepth j
  have hM_ge_one : 1 ≤ M := by linarith
  have hM_pos : 0 < M := by linarith
  have ht₀_pos : 0 < sliceParamT0 P.N := by
    unfold sliceParamT0
    exact div_pos Real.two_pi_pos hN_pos
  have ht₀_norm : ‖(sliceParamT0 P.N : ℂ)‖ < S.r_star := by
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos ht₀_pos]
    exact P.t₀_lt_r_star
  have hy_im : -sliceHeight S P.N < y.im ∧ y.im < sliceHeight S P.N :=
    abs_lt.mp hy.1
  have h_tube : ∀ i : Fin P.N, sliceImpactSeq S P.N i.val y ∈ horizStrip S.H := by
    intro i
    apply S.𝔰_maps_to
    simp only [finiteWallTube, Set.mem_setOf_eq, Complex.conj_ofReal, Complex.add_im,
      Complex.mul_im, Complex.intCast_im, Complex.ofReal_im, mul_zero, zero_mul, add_zero]
    exact ⟨ht₀_norm, hy_im.1, hy_im.2⟩
  have h_log_mod : ∀ {z : ℂ}, z ≠ 0 → |Real.log ‖z‖| ≤ 2 * M →
      ‖z‖ ≤ Real.exp (2 * M) ∧ ‖z⁻¹‖ ≤ Real.exp (2 * M) := by
    intro z hz habs
    have hz_pos : 0 < ‖z‖ := norm_pos_iff.mpr hz
    rcases abs_le.mp habs with ⟨h_low, h_up⟩
    constructor
    · rw [← Real.exp_log hz_pos]
      exact Real.exp_le_exp.mpr h_up
    · rw [norm_inv, ← Real.exp_log hz_pos, ← Real.exp_neg]
      exact Real.exp_le_exp.mpr (by linarith)
  have h_geom_i : ∀ i : Fin P.N,
      ‖P.ℓ_slice i y‖ ≤ Real.exp (2 * M) ∧
      ‖(P.ℓ_slice i y)⁻¹‖ ≤ Real.exp (2 * M) ∧
      ‖(Complex.sin (P.d0 i y))⁻¹‖ ≤ Real.exp (2 * M) := by
    intro i
    have h_sup_i :
        ‖sliceAngleSeq S P.N i.val y‖ +
          Real.log (1 + ‖slicePosSeq S P.N i.val y‖) +
          |Real.log ‖Complex.sin (P.d0 i y)‖| +
          |Real.log ‖P.ℓ_slice i y‖| ≤ 2 * M := by
      refine le_trans ?_ hGeom
      unfold sliceGeomCost
      exact Finset.le_sup'
        (fun k : Fin P.N =>
          ‖sliceAngleSeq S P.N k.val y‖ +
            Real.log (1 + ‖slicePosSeq S P.N k.val y‖) +
            |Real.log ‖Complex.sin (P.d0 k y)‖| +
            |Real.log ‖P.ℓ_slice k y‖|)
        (Finset.mem_univ i)
    have h_ang_nn : 0 ≤ ‖sliceAngleSeq S P.N i.val y‖ := norm_nonneg _
    have h_pos_nn : 0 ≤ Real.log (1 + ‖slicePosSeq S P.N i.val y‖) :=
      Real.log_nonneg (by linarith [norm_nonneg (slicePosSeq S P.N i.val y)])
    have h_sin_nn : 0 ≤ |Real.log ‖Complex.sin (P.d0 i y)‖| := abs_nonneg _
    have h_ℓ_nn : 0 ≤ |Real.log ‖P.ℓ_slice i y‖| := abs_nonneg _
    have h_ℓ_abs : |Real.log ‖P.ℓ_slice i y‖| ≤ 2 * M := by linarith
    have h_sin_abs : |Real.log ‖Complex.sin (P.d0 i y)‖| ≤ 2 * M := by linarith
    have hℓ_pair := h_log_mod (P.reg_chord_ne_zero y hy i) h_ℓ_abs
    have hsin_pair := h_log_mod (P.reg_sin_d0_ne_zero y hy i) h_sin_abs
    exact ⟨hℓ_pair.1, hℓ_pair.2, hsin_pair.2⟩
  let B_f : ℝ := Real.exp (3 * C_f * M)
  let B_e : ℝ := Real.exp (2 * M)
  have hBf_ge : 1 ≤ B_f := Real.one_le_exp (by nlinarith)
  have hBe_ge : 1 ≤ B_e := Real.one_le_exp (by linarith)
  have hf_seq : ∀ i : Fin P.N, ‖sliceSpeedSeq S P.N i.val y‖ ≤ B_f := by
    intro i
    have h1 := hf_cap (sliceImpactSeq S P.N i.val y) (h_tube i)
    have h_max_le : max (sliceLogDepth S P i y) 0 ≤ 2 * M :=
      max_le (hDepth i) (by linarith)
    have h_arg : C_f * (1 + max (-Real.log (S.H - |(sliceImpactSeq S P.N i.val y).im|)) 0) ≤
        3 * C_f * M := by
      change C_f * (1 + max (sliceLogDepth S P i y) 0) ≤ 3 * C_f * M
      nlinarith
    exact le_trans h1 (Real.exp_le_exp.mpr h_arg)
  let A_entry : ℝ := 4 * B_e + (2 / S.c) * B_f ^ 3 * B_e
  have hA_ge_one : 1 ≤ A_entry := by
    have h_term_nn : 0 ≤ (2 / S.c) * B_f ^ 3 * B_e := by positivity
    dsimp only [A_entry]
    linarith
  let B_mat : Matrix (Fin P.N) (Fin P.N) ℂ := P.B_mat (Finset.univ.erase j) ∅ y
  have hB_entry : ∀ r k : Fin P.N, ‖B_mat r k‖ ≤ A_entry := by
    intro r k
    simp only [B_mat, OddPeriodicSliceData.B_mat, modifiedJacobiB, Matrix.of_apply]
    by_cases h_in : r ∈ Finset.univ.erase j ∪ ∅ ∧ k ∈ Finset.univ.erase j ∪ ∅
    · rw [if_pos h_in]
      have hM0_rk : ‖jacobiM0 P.N (fun i => P.ℓ_slice i y) r k‖ ≤ 4 * B_e := by
        simp only [jacobiM0, Matrix.of_apply]
        have h1 : ‖if r = k then (P.ℓ_slice (cycPrev P.N r) y)⁻¹ + (P.ℓ_slice r y)⁻¹ else 0‖ ≤
            2 * B_e := by
          split_ifs
          · exact le_trans (norm_add_le _ _)
              (by linarith [(h_geom_i (cycPrev P.N r)).2.1, (h_geom_i r).2.1])
          · simp only [norm_zero]; positivity
        have h2 : ‖if k = cycNext P.N r then (P.ℓ_slice r y)⁻¹ else 0‖ ≤ B_e := by
          split_ifs
          · exact (h_geom_i r).2.1
          · simp only [norm_zero]; positivity
        have h3 : ‖if r = cycNext P.N k then (P.ℓ_slice k y)⁻¹ else 0‖ ≤ B_e := by
          split_ifs
          · exact (h_geom_i k).2.1
          · simp only [norm_zero]; positivity
        have h12 := norm_add_le
          (if r = k then (P.ℓ_slice (cycPrev P.N r) y)⁻¹ + (P.ℓ_slice r y)⁻¹ else 0)
          (if k = cycNext P.N r then (P.ℓ_slice r y)⁻¹ else 0)
        refine le_trans (norm_add_le _ _) ?_
        linarith
      have hV_rk :
          ‖if r = k ∧ r ∈ Finset.univ.erase j then
              jacobiVDiag P.N S.c (fun i => sliceSpeedSeq S P.N i.val y) (fun i => P.d0 i y) r
            else 0‖ ≤ (2 / S.c) * B_f ^ 3 * B_e := by
        split_ifs with hr
        · dsimp only [jacobiVDiag]
          have h2_norm : ‖(2 : ℂ)‖ = 2 := by norm_num
          rw [div_eq_mul_inv, mul_inv, norm_mul, norm_mul, h2_norm, norm_pow,
            norm_mul, norm_inv, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hc_pos]
          calc
            2 * ‖sliceSpeedSeq S P.N r.val y‖ ^ 3 *
                ((S.c)⁻¹ * ‖(Complex.sin (P.d0 r y))⁻¹‖)
              = (2 / S.c) *
                  (‖sliceSpeedSeq S P.N r.val y‖ ^ 3 * ‖(Complex.sin (P.d0 r y))⁻¹‖) := by ring
            _ ≤ (2 / S.c) * (B_f ^ 3 * B_e) := by
              refine mul_le_mul_of_nonneg_left ?_ (by positivity)
              exact mul_le_mul (pow_le_pow_left₀ (norm_nonneg _) (hf_seq r) 3)
                (h_geom_i r).2.2 (norm_nonneg _) (by positivity)
            _ = (2 / S.c) * B_f ^ 3 * B_e := by ring
        · simp only [norm_zero]; positivity
      exact le_trans (norm_sub_le _ _) (by dsimp only [A_entry]; linarith)
    · rw [if_neg h_in]
      split_ifs
      · simp only [norm_one]
        exact hA_ge_one
      · simp only [norm_zero]
        linarith
  have h_det_raw : ‖B_mat.det‖ ≤ (P.N.factorial : ℝ) * A_entry ^ P.N := by
    rw [Matrix.det_apply']
    refine le_trans (norm_sum_le _ _) ?_
    have h_term : ∀ σ : Equiv.Perm (Fin P.N),
        ‖((Equiv.Perm.sign σ : ℤ) : ℂ) * ∏ i : Fin P.N, B_mat (σ i) i‖ ≤ A_entry ^ P.N := by
      intro σ
      have h_sgn : ‖((Equiv.Perm.sign σ : ℤ) : ℂ)‖ = 1 := by
        rcases Int.units_eq_one_or (Equiv.Perm.sign σ) with hσ | hσ <;> simp [hσ]
      rw [norm_mul, h_sgn, one_mul, Complex.norm_prod]
      calc
        ∏ i : Fin P.N, ‖B_mat (σ i) i‖ ≤ ∏ _i : Fin P.N, A_entry := by
          gcongr with i
          exact hB_entry (σ i) i
        _ = A_entry ^ P.N := by
          rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
    calc
      ∑ σ : Equiv.Perm (Fin P.N),
          ‖((Equiv.Perm.sign σ : ℤ) : ℂ) * ∏ i : Fin P.N, B_mat (σ i) i‖
        ≤ ∑ _σ : Equiv.Perm (Fin P.N), A_entry ^ P.N :=
          Finset.sum_le_sum fun σ _ => h_term σ
      _ = (P.N.factorial : ℝ) * A_entry ^ P.N := by
          rw [Finset.sum_const, Finset.card_univ, Fintype.card_perm, Fintype.card_fin, nsmul_eq_mul]
  have hA_le : A_entry ≤ (4 + 2 / S.c) * Real.exp ((9 * C_f + 2) * M) := by
    have h_prod_exp : B_f ^ 3 * B_e = Real.exp ((9 * C_f + 2) * M) := by
      dsimp only [B_f, B_e]
      rw [← Real.exp_nat_mul, ← Real.exp_add]
      exact congrArg Real.exp (by push_cast; ring)
    have h_Be_le : B_e ≤ Real.exp ((9 * C_f + 2) * M) :=
      Real.exp_le_exp.mpr (by nlinarith)
    calc
      A_entry = 4 * B_e + (2 / S.c) * (B_f ^ 3 * B_e) := by dsimp only [A_entry]; ring
      _ = 4 * B_e + (2 / S.c) * Real.exp ((9 * C_f + 2) * M) := by rw [h_prod_exp]
      _ ≤ 4 * Real.exp ((9 * C_f + 2) * M) + (2 / S.c) * Real.exp ((9 * C_f + 2) * M) := by
        linarith
      _ = (4 + 2 / S.c) * Real.exp ((9 * C_f + 2) * M) := by ring
  have h_det_exp : ‖B_mat.det‖ ≤
      (P.N.factorial : ℝ) * (4 + 2 / S.c) ^ P.N *
        Real.exp ((P.N : ℝ) * (9 * C_f + 2) * M) := by
    have h_pow : A_entry ^ P.N ≤
        (4 + 2 / S.c) ^ P.N * Real.exp ((P.N : ℝ) * (9 * C_f + 2) * M) := by
      calc
        A_entry ^ P.N ≤ ((4 + 2 / S.c) * Real.exp ((9 * C_f + 2) * M)) ^ P.N :=
          pow_le_pow_left₀ (by linarith) hA_le P.N
        _ = (4 + 2 / S.c) ^ P.N * (Real.exp ((9 * C_f + 2) * M)) ^ P.N := mul_pow _ _ _
        _ = (4 + 2 / S.c) ^ P.N * Real.exp ((P.N : ℝ) * ((9 * C_f + 2) * M)) := by
          rw [← Real.exp_nat_mul]
        _ = (4 + 2 / S.c) ^ P.N * Real.exp ((P.N : ℝ) * (9 * C_f + 2) * M) := by
          rw [mul_assoc]
    calc
      ‖B_mat.det‖ ≤ (P.N.factorial : ℝ) * A_entry ^ P.N := h_det_raw
      _ ≤ (P.N.factorial : ℝ) *
            ((4 + 2 / S.c) ^ P.N * Real.exp ((P.N : ℝ) * (9 * C_f + 2) * M)) :=
          mul_le_mul_of_nonneg_left h_pow (by positivity)
      _ = (P.N.factorial : ℝ) * (4 + 2 / S.c) ^ P.N *
            Real.exp ((P.N : ℝ) * (9 * C_f + 2) * M) := by ring
  have h_chord_prod : ‖∏ i : Fin P.N, P.ℓ_slice i y‖ ≤
      Real.exp ((P.N : ℝ) * 2 * M) := by
    rw [Complex.norm_prod]
    calc
      ∏ i : Fin P.N, ‖P.ℓ_slice i y‖ ≤ ∏ _i : Fin P.N, Real.exp (2 * M) := by
        gcongr with i
        exact (h_geom_i i).1
      _ = (Real.exp (2 * M)) ^ P.N := by
        rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
      _ = Real.exp ((P.N : ℝ) * (2 * M)) := (Real.exp_nat_mul (2 * M) P.N).symm
      _ = Real.exp ((P.N : ℝ) * 2 * M) := by rw [mul_assoc]
  have hcof_eq : (P.w_vec y j) ^ 2 =
      (-1 : ℂ) ^ (P.N - 1) * (S.A (sliceParamT0 P.N : ℂ) / (P.N : ℂ)) *
        (∏ i : Fin P.N, P.ℓ_slice i y) * B_mat.det :=
    P.cofactor_norm y hy j
  have hw_sq_eq : ‖P.w_vec y j‖ ^ 2 =
      ‖S.A (sliceParamT0 P.N : ℂ) / (P.N : ℂ)‖ *
        ‖∏ i : Fin P.N, P.ℓ_slice i y‖ * ‖B_mat.det‖ := by
    have h1 := congrArg norm hcof_eq
    rw [norm_pow, norm_mul, norm_mul, norm_mul, norm_pow, norm_neg, norm_one, one_pow, one_mul] at h1
    exact h1
  have hw_sq_le : ‖P.w_vec y j‖ ^ 2 ≤ (Real.exp (C_w * M)) ^ 2 := by
    have h_prod_bound :
        ‖∏ i : Fin P.N, P.ℓ_slice i y‖ * ‖B_mat.det‖ ≤
          (P.N.factorial : ℝ) * (4 + 2 / S.c) ^ P.N *
            Real.exp ((P.N : ℝ) * (9 * C_f + 4) * M) := by
      calc
        ‖∏ i : Fin P.N, P.ℓ_slice i y‖ * ‖B_mat.det‖
          ≤ Real.exp ((P.N : ℝ) * 2 * M) *
              ((P.N.factorial : ℝ) * (4 + 2 / S.c) ^ P.N *
                Real.exp ((P.N : ℝ) * (9 * C_f + 2) * M)) :=
            mul_le_mul h_chord_prod h_det_exp (norm_nonneg _) (Real.exp_nonneg _)
        _ = (P.N.factorial : ℝ) * (4 + 2 / S.c) ^ P.N *
              (Real.exp ((P.N : ℝ) * 2 * M) *
                Real.exp ((P.N : ℝ) * (9 * C_f + 2) * M)) := by ring
        _ = (P.N.factorial : ℝ) * (4 + 2 / S.c) ^ P.N *
              Real.exp ((P.N : ℝ) * (9 * C_f + 4) * M) := by
            rw [← Real.exp_add]
            exact congrArg _ (congrArg Real.exp (by ring))
    have h_pre_le :
        ‖S.A (sliceParamT0 P.N : ℂ) / (P.N : ℂ)‖ *
            ((P.N.factorial : ℝ) * (4 + 2 / S.c) ^ P.N) ≤ K_pre := by
      have h_eq :
          ‖S.A (sliceParamT0 P.N : ℂ) / (P.N : ℂ)‖ *
              ((P.N.factorial : ℝ) * (4 + 2 / S.c) ^ P.N) =
            ‖S.A (sliceParamT0 P.N : ℂ) / (P.N : ℂ)‖ * (P.N.factorial : ℝ) *
              (4 + 2 / S.c) ^ P.N := by ring
      rw [h_eq]
      exact le_max_right _ _
    have h_arg_le : Real.log K_pre + (P.N : ℝ) * (9 * C_f + 4) * M ≤ 2 * (C_w * M) := by
      dsimp only [C_w]
      nlinarith
    calc
      ‖P.w_vec y j‖ ^ 2
        = ‖S.A (sliceParamT0 P.N : ℂ) / (P.N : ℂ)‖ *
            (‖∏ i : Fin P.N, P.ℓ_slice i y‖ * ‖B_mat.det‖) := by
          rw [hw_sq_eq, mul_assoc]
      _ ≤ ‖S.A (sliceParamT0 P.N : ℂ) / (P.N : ℂ)‖ *
            ((P.N.factorial : ℝ) * (4 + 2 / S.c) ^ P.N *
              Real.exp ((P.N : ℝ) * (9 * C_f + 4) * M)) :=
          mul_le_mul_of_nonneg_left h_prod_bound (norm_nonneg _)
      _ = (‖S.A (sliceParamT0 P.N : ℂ) / (P.N : ℂ)‖ *
            ((P.N.factorial : ℝ) * (4 + 2 / S.c) ^ P.N)) *
            Real.exp ((P.N : ℝ) * (9 * C_f + 4) * M) := by ring
      _ ≤ K_pre * Real.exp ((P.N : ℝ) * (9 * C_f + 4) * M) :=
          mul_le_mul_of_nonneg_right h_pre_le (Real.exp_nonneg _)
      _ = Real.exp (Real.log K_pre) * Real.exp ((P.N : ℝ) * (9 * C_f + 4) * M) := by
          rw [Real.exp_log hK_pre_pos]
      _ = Real.exp (Real.log K_pre + (P.N : ℝ) * (9 * C_f + 4) * M) :=
          (Real.exp_add _ _).symm
      _ ≤ Real.exp (2 * (C_w * M)) := Real.exp_le_exp.mpr h_arg_le
      _ = (Real.exp (C_w * M)) ^ 2 := by
          rw [← Real.exp_nat_mul]
          exact congrArg Real.exp (by push_cast; ring)
  have hw_le : ‖P.w_vec y j‖ ≤ Real.exp (C_w * M) :=
    (sq_le_sq₀ (norm_nonneg _) (Real.exp_nonneg _)).mp hw_sq_le
  have hc_ne : (S.c : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hc_pos.ne'
  have hsin_ne : Complex.sin (P.d0 j y) ≠ 0 := P.reg_sin_d0_ne_zero y hy j
  have hf_ne : sliceSpeedSeq S P.N j.val y ≠ 0 := P.reg_speed_ne_zero y hy j
  have hf2_ne : (sliceSpeedSeq S P.N j.val y) ^ 2 ≠ 0 := pow_ne_zero 2 hf_ne
  have h_inv_w : deriv (sliceImpactSeq S P.N j.val) y =
      (S.c : ℂ)⁻¹ * (Complex.sin (P.d0 j y))⁻¹ *
        (sliceSpeedSeq S P.N j.val y) ^ 2 * P.w_vec y j := by
    dsimp only [OddPeriodicSliceData.w_vec, jacobiNullVec]
    rw [inv_pow]
    calc
      deriv (sliceImpactSeq S P.N j.val) y
        = ((S.c : ℂ)⁻¹ * (S.c : ℂ)) *
            ((Complex.sin (P.d0 j y))⁻¹ * Complex.sin (P.d0 j y)) *
            ((sliceSpeedSeq S P.N j.val y) ^ 2 * ((sliceSpeedSeq S P.N j.val y) ^ 2)⁻¹) *
            deriv (sliceImpactSeq S P.N j.val) y := by
          rw [inv_mul_cancel₀ hc_ne, inv_mul_cancel₀ hsin_ne, mul_inv_cancel₀ hf2_ne]
          ring
      _ = (S.c : ℂ)⁻¹ * (Complex.sin (P.d0 j y))⁻¹ *
            (sliceSpeedSeq S P.N j.val y) ^ 2 *
            ((S.c : ℂ) * Complex.sin (P.d0 j y) * ((sliceSpeedSeq S P.N j.val y) ^ 2)⁻¹ *
              deriv (sliceImpactSeq S P.N j.val) y) := by ring
  have hc_inv_le : ‖(S.c : ℂ)⁻¹‖ ≤ Real.exp (Real.log K_c * M) := by
    rw [norm_inv, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hc_pos]
    calc
      (S.c)⁻¹ ≤ K_c := le_max_right _ _
      _ = Real.exp (Real.log K_c) := (Real.exp_log hK_c_pos).symm
      _ ≤ Real.exp (Real.log K_c * M) := Real.exp_le_exp.mpr (by nlinarith)
  have hf2_le : ‖sliceSpeedSeq S P.N j.val y‖ ^ 2 ≤ Real.exp (6 * C_f * M) := by
    calc
      ‖sliceSpeedSeq S P.N j.val y‖ ^ 2 ≤ B_f ^ 2 :=
        pow_le_pow_left₀ (norm_nonneg _) (hf_seq j) 2
      _ = Real.exp ((2 : ℕ) * (3 * C_f * M)) := (Real.exp_nat_mul _ 2).symm
      _ = Real.exp (6 * C_f * M) := congrArg Real.exp (by push_cast; ring)
  rw [h_inv_w, norm_mul, norm_mul, norm_mul, norm_pow]
  calc
    ‖(S.c : ℂ)⁻¹‖ * ‖(Complex.sin (P.d0 j y))⁻¹‖ *
        ‖sliceSpeedSeq S P.N j.val y‖ ^ 2 * ‖P.w_vec y j‖
      ≤ Real.exp (Real.log K_c * M) * Real.exp (2 * M) *
          Real.exp (6 * C_f * M) * Real.exp (C_w * M) := by
        refine mul_le_mul ?_ hw_le (norm_nonneg _) (by positivity)
        refine mul_le_mul ?_ hf2_le (by positivity) (by positivity)
        exact mul_le_mul hc_inv_le (h_geom_i j).2.2 (norm_nonneg _) (Real.exp_nonneg _)
    _ = Real.exp (C₁ * M) := by
        dsimp only [C₁]
        rw [← Real.exp_add, ← Real.exp_add, ← Real.exp_add]
        exact congrArg Real.exp (by ring)

theorem walk_step_expectation_toolkit (S : FiniteWallNonisotropicStrip)
    (P : OddPeriodicSliceData S) (C_clk M_adm : ℝ)
    (hBase : WalkBaseAndStopProp S P C_clk)
    (ρ : ℂ → ℝ) (hAdm : IsScaleAdmissibleStep S P M_adm ρ) :
    PhClkStepToolkitProp S P ρ :=
by
  haveI hProbUnif : MeasureTheory.IsProbabilityMeasure unifTwoPiMeasure := by
    refine ⟨?_⟩
    simp only [unifTwoPiMeasure, MeasureTheory.Measure.smul_apply,
      MeasureTheory.Measure.restrict_apply_univ, smul_eq_mul, Real.volume_Ico, sub_zero]
    exact ENNReal.inv_mul_cancel
      (ENNReal.ofReal_pos.mpr Real.two_pi_pos).ne' ENNReal.ofReal_ne_top
  haveI hProbWalk : MeasureTheory.IsProbabilityMeasure walkMeasure := by
    dsimp only [walkMeasure]
    infer_instance
  let h : ℝ := sliceHeight S P.N
  let Ω_reg : Set ℂ := horizStrip h \ P.Z_all
  have hN_pos : 0 < (P.N : ℝ) := by
    exact_mod_cast lt_of_lt_of_le (by decide : 0 < 3) P.N_ge_three
  have ht₀_pos : 0 < sliceParamT0 P.N := by
    unfold sliceParamT0
    exact div_pos Real.two_pi_pos hN_pos
  have ht₀_mem : (sliceParamT0 P.N : ℂ) ∈ Metric.ball (0 : ℂ) S.r_star := by
    rw [Metric.mem_ball, dist_zero_right, Complex.norm_real, Real.norm_eq_abs,
      abs_of_pos ht₀_pos]
    exact P.t₀_lt_r_star
  have hh_pos : 0 < h := by
    dsimp only [h]
    unfold sliceHeight
    exact lt_of_lt_of_le S.s_star_pos (S.h_X_bounds _ ht₀_mem).1
  have h_walk_in_reg : ∀ om : WalkSpace, ∀ n : ℕ, walkPos ρ om n ∈ Ω_reg :=
    fun om n => (hBase.walk_in_reg M_adm ρ hAdm om n).1
  have h_rho_nn : ∀ y : ℂ, 0 ≤ ρ y := hAdm.nonneg
  have h_rho_le_cent : ∀ y : ℂ, ρ y ≤ 1 / 100 := by
    intro y
    have h1 := hAdm.le_sing_dist y
    have h2 : min 1 (sliceSingDist S P y) ≤ 1 := min_le_left 1 _
    linarith
  have h_rho_le_one : ∀ y : ℂ, ρ y ≤ 1 := fun y => le_trans (h_rho_le_cent y) (by norm_num)
  have h_reg_phase_depth : ∀ y ∈ Ω_reg,
      0 < slicePhaseDepth S P y ∧ ρ y ≤ (1 / 100 : ℝ) * slicePhaseDepth S P y := by
    intro y hy
    have hy_im : |y.im| < h := hy.1
    have hy_bounds := abs_lt.mp hy_im
    have h_depth_eq : slicePhaseDepth S P y = h - |y.im| := rfl
    have h_depth_pos : 0 < slicePhaseDepth S P y := by
      rw [h_depth_eq]
      linarith
    refine ⟨h_depth_pos, ?_⟩
    let p : ℂ := (y.re : ℂ) + ((if 0 ≤ y.im then h else -h : ℝ) : ℂ) * Complex.I
    have hp_im : p.im = if 0 ≤ y.im then h else -h := by
      simp [p]
    have hp_abs_im : |p.im| = h := by
      rw [hp_im]
      split_ifs
      · exact abs_of_pos hh_pos
      · rw [abs_neg, abs_of_pos hh_pos]
    have hp_not_strip : p ∉ horizStrip h := by
      intro hp_in
      have hp_lt : |p.im| < h := hp_in
      linarith
    have hp_comp : p ∈ sliceRegClosedComp S P := by
      intro hp_reg
      exact hp_not_strip hp_reg.1
    have h_dist_eq : dist y p = slicePhaseDepth S P y := by
      rw [dist_eq_norm, h_depth_eq]
      by_cases hy0 : 0 ≤ y.im
      · have h_sub : y - p = ((y.im - h : ℝ) : ℂ) * Complex.I := by
          apply Complex.ext <;> simp [p, hy0]
        rw [h_sub, norm_mul, Complex.norm_real, Complex.norm_I, mul_one,
          Real.norm_eq_abs, abs_of_nonneg hy0, abs_sub_comm,
          abs_of_pos (by linarith : 0 < h - y.im)]
      · have hy_neg : y.im < 0 := lt_of_not_ge hy0
        have h_sub : y - p = ((y.im + h : ℝ) : ℂ) * Complex.I := by
          apply Complex.ext <;> simp [p, hy0]
        have h_abs_y : |y.im| = -y.im := abs_of_neg hy_neg
        have h_pos_add : 0 < y.im + h := by linarith
        rw [h_sub, norm_mul, Complex.norm_real, Complex.norm_I, mul_one,
          Real.norm_eq_abs, h_abs_y, abs_of_pos h_pos_add]
        ring
    have h_sing_le : sliceSingDist S P y ≤ slicePhaseDepth S P y := by
      rw [← h_dist_eq]
      exact Metric.infDist_le_dist_of_mem hp_comp
    have h1 := hAdm.le_sing_dist y
    have h2 : min 1 (sliceSingDist S P y) ≤ sliceSingDist S P y := min_le_right 1 _
    linarith
  have h_adm_cball_sub : ∀ y ∈ Ω_reg, Metric.closedBall y (ρ y) ⊆ Ω_reg := by
    intro y hy ζ hζ
    have hρ_pos : 0 < ρ y := (hAdm.pos_iff y).mpr hy
    have h1 := hAdm.le_sing_dist y
    have h2 : min 1 (sliceSingDist S P y) ≤ sliceSingDist S P y := min_le_right 1 _
    have hρ_lt_sing : ρ y < sliceSingDist S P y := by linarith
    have h_dist_le : dist y ζ ≤ ρ y := by
      rw [dist_comm]
      exact Metric.mem_closedBall.mp hζ
    by_contra hζ_not_reg
    have hζ_comp : ζ ∈ sliceRegClosedComp S P := hζ_not_reg
    have h_sing_le : sliceSingDist S P y ≤ dist y ζ :=
      Metric.infDist_le_dist_of_mem hζ_comp
    linarith
  have h_walkPos_depends : ∀ (k : ℕ) (om₁ om₂ : WalkSpace),
      (∀ l ≤ k, om₁ l = om₂ l) → walkPos ρ om₁ k = walkPos ρ om₂ k := by
    intro k
    induction k with
    | zero =>
        intro om₁ om₂ h_eq
        simp [walkPos, h_eq 0 le_rfl]
    | succ k ih =>
        intro om₁ om₂ h_eq
        have hk := ih om₁ om₂ (fun l hl => h_eq l (Nat.le_succ_of_le hl))
        have hk1 := h_eq (k + 1) le_rfl
        simp [walkPos, hk, hk1]
  have h_walk_meas : ∀ k : ℕ, Measurable (fun om : WalkSpace => walkPos ρ om k) := by
    intro k
    induction k with
    | zero =>
        dsimp only [walkPos]
        exact Complex.measurable_ofReal.comp (measurable_pi_apply 0)
    | succ k ih =>
        have h_rho_k : Measurable (fun om : WalkSpace => (ρ (walkPos ρ om k) : ℂ)) :=
          Complex.measurable_ofReal.comp (hAdm.measurable.comp ih)
        have h_exp_k : Measurable (fun om : WalkSpace =>
            Complex.exp ((om (k + 1) : ℂ) * Complex.I)) :=
          Complex.continuous_exp.measurable.comp
            ((Complex.measurable_ofReal.comp (measurable_pi_apply (k + 1))).mul measurable_const)
        dsimp only [walkPos]
        exact ih.add (h_rho_k.mul h_exp_k)
  have h_meas_im : ∀ k : ℕ, Measurable (fun om : WalkSpace => (walkPos ρ om k).im) :=
    fun k => Complex.continuous_im.measurable.comp (h_walk_meas k)
  have h_meas_rho : ∀ k : ℕ, Measurable (fun om : WalkSpace => ρ (walkPos ρ om k)) :=
    fun k => hAdm.measurable.comp (h_walk_meas k)
  have h_reg_comp_meas :
      ∀ {X : Type} [TopologicalSpace X] [MeasurableSpace X] [BorelSpace X]
        {α : Type} [MeasurableSpace α] {g : α → ℂ} (hg : Measurable g)
        (h_mem : ∀ a, g a ∈ Ω_reg) {F : ℂ → X} (hF : ContinuousOn F Ω_reg),
        Measurable (fun a => F (g a)) := by
    intro X _ _ _ α _ g hg h_mem F hF
    have hg_sub : Measurable (fun a => (⟨g a, h_mem a⟩ : ↥Ω_reg)) := hg.subtype_mk
    exact (hF.domRestrict).measurable.comp hg_sub
  have h_horiz_open : IsOpen (horizStrip h) :=
    isOpen_Iio.preimage (continuous_abs.comp Complex.continuous_im)
  have h_impact_holo_maps : ∀ m : ℤ,
      DifferentiableOn ℂ (sliceImpactSeq S P.N m) (horizStrip h) ∧
      ∀ z ∈ horizStrip h, sliceImpactSeq S P.N m z ∈ horizStrip S.H := by
    intro m
    let φ : ℂ → ℂ × ℂ := fun z => (z + (m : ℂ) * (sliceParamT0 P.N : ℂ), (sliceParamT0 P.N : ℂ))
    have hφ_diff : DifferentiableOn ℂ φ (horizStrip h) :=
      ((differentiable_id.add (differentiable_const _)).prodMk
        (differentiable_const _)).differentiableOn
    have hφ_maps : Set.MapsTo φ (horizStrip h) (finiteWallTube S.r_star S.h_X) := by
      intro z hz
      have hz_im : |z.im| < h := hz
      have hz_bounds := abs_lt.mp hz_im
      have h_norm_t0 : ‖(sliceParamT0 P.N : ℂ)‖ < S.r_star := by
        rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos ht₀_pos]
        exact P.t₀_lt_r_star
      have h_conj_t0 : starRingEnd ℂ (sliceParamT0 P.N : ℂ) = (sliceParamT0 P.N : ℂ) :=
        Complex.conj_ofReal _
      have h_im_shift : (z + (m : ℂ) * (sliceParamT0 P.N : ℂ)).im = z.im := by
        simp
      refine ⟨h_norm_t0, ?_, ?_⟩
      · dsimp only [φ]
        rw [h_conj_t0, h_im_shift]
        exact hz_bounds.1
      · dsimp only [φ]
        rw [h_im_shift]
        exact hz_bounds.2
    exact ⟨S.𝔰_holo.comp hφ_diff hφ_maps, fun z hz => S.𝔰_maps_to (φ z) (hφ_maps hz)⟩
  have h_impact_holo : ∀ m : ℤ, DifferentiableOn ℂ (sliceImpactSeq S P.N m) (horizStrip h) :=
    fun m => (h_impact_holo_maps m).1
  have h_impact_maps : ∀ m : ℤ, ∀ z ∈ horizStrip h, sliceImpactSeq S P.N m z ∈ horizStrip S.H :=
    fun m => (h_impact_holo_maps m).2
  have h_meas_logDepth : ∀ (k : ℕ) (j : Fin P.N),
      Measurable (fun om : WalkSpace => sliceLogDepth S P j (walkPos ρ om k)) := by
    intro k j
    have h_sj_cont : ContinuousOn (sliceImpactSeq S P.N j.val) Ω_reg :=
      (h_impact_holo j.val).continuousOn.mono Set.sdiff_subset
    have h_depth_cont : ContinuousOn (sliceShapeDepth S P j) Ω_reg :=
      continuousOn_const.sub (continuous_abs.comp_continuousOn
        (Complex.continuous_im.comp_continuousOn h_sj_cont))
    have h_depth_ne : ∀ y ∈ Ω_reg, sliceShapeDepth S P j y ≠ 0 := by
      intro y hy
      have hs_in : |(sliceImpactSeq S P.N j.val y).im| < S.H :=
        h_impact_maps j.val y hy.1
      unfold sliceShapeDepth
      linarith
    have h_log_cont : ContinuousOn (sliceLogDepth S P j) Ω_reg :=
      (h_depth_cont.log h_depth_ne).neg
    exact h_reg_comp_meas (h_walk_meas k) (fun om => h_walk_in_reg om k) h_log_cont
  have h_meas_geomCost : ∀ k : ℕ,
      Measurable (fun om : WalkSpace => sliceGeomCost S P (walkPos ρ om k)) := by
    intro k
    have h_term_cont : ∀ j : Fin P.N, ContinuousOn (fun y : ℂ =>
        ‖sliceAngleSeq S P.N j.val y‖ +
          Real.log (1 + ‖slicePosSeq S P.N j.val y‖) +
          |Real.log ‖Complex.sin (P.d0 j y)‖| +
          |Real.log ‖P.ℓ_slice j y‖|) Ω_reg := by
      intro j
      have h_ang_holo : DifferentiableOn ℂ (sliceAngleSeq S P.N j.val) (horizStrip h) :=
        S.ϕ_holo.comp (h_impact_holo j.val) (h_impact_maps j.val)
      have h_ang_cont : ContinuousOn (sliceAngleSeq S P.N j.val) Ω_reg :=
        h_ang_holo.continuousOn.mono Set.sdiff_subset
      have h1 : ContinuousOn (fun y => ‖sliceAngleSeq S P.N j.val y‖) Ω_reg :=
        h_ang_cont.norm
      have h_pos_cont : ContinuousOn (slicePosSeq S P.N j.val) Ω_reg := by
        refine continuousOn_of_forall_continuousAt fun y hy => ?_
        have hs_in : sliceImpactSeq S P.N j.val y ∈ horizStrip S.H :=
          h_impact_maps j.val y hy.1
        have hf_ne : S.f (sliceImpactSeq S P.N j.val y) ≠ 0 :=
          P.reg_speed_ne_zero y hy j
        have hΓ := S.Γ_reg_holo _ hs_in hf_ne
        have hs_contAt : ContinuousAt (sliceImpactSeq S P.N j.val) y :=
          (h_impact_holo j.val).continuousOn.continuousAt (h_horiz_open.mem_nhds hy.1)
        refine continuousAt_pi.mpr (Fin.forall_fin_two.mpr ⟨?_, ?_⟩)
        · exact hΓ.1.continuousAt.comp hs_contAt
        · exact hΓ.2.continuousAt.comp hs_contAt
      have h2 : ContinuousOn (fun y => Real.log (1 + ‖slicePosSeq S P.N j.val y‖)) Ω_reg :=
        (continuousOn_const.add h_pos_cont.norm).log fun y _ =>
          ne_of_gt (lt_of_lt_of_le zero_lt_one (le_add_of_nonneg_right (norm_nonneg _)))
      have h_d0_cont : ContinuousOn (P.d0 j) Ω_reg :=
        ((P.θ_holo j.val).continuousOn.mono Set.sdiff_subset).sub h_ang_cont
      have h3 : ContinuousOn (fun y => |Real.log ‖Complex.sin (P.d0 j y)‖|) Ω_reg :=
        (((Complex.continuous_sin.comp_continuousOn h_d0_cont).norm).log fun y hy =>
          norm_ne_zero_iff.mpr (P.reg_sin_d0_ne_zero y hy j)).abs
      have h_f_j : ContinuousOn (sliceSpeedSeq S P.N j.val) Ω_reg :=
        (S.f_holo.comp (h_impact_holo j.val) (h_impact_maps j.val)).continuousOn.mono
          Set.sdiff_subset
      have h_f_j1 : ContinuousOn (sliceSpeedSeq S P.N ((j.val : ℤ) + 1)) Ω_reg :=
        (S.f_holo.comp (h_impact_holo ((j.val : ℤ) + 1))
          (h_impact_maps ((j.val : ℤ) + 1))).continuousOn.mono Set.sdiff_subset
      have h_num_cont : ContinuousOn (P.ℓ_num j) Ω_reg :=
        (P.ℓ_num_holo j).continuousOn.mono Set.sdiff_subset
      have h_den_ne : ∀ y ∈ Ω_reg,
          sliceSpeedSeq S P.N j.val y * sliceSpeedSeq S P.N ((j.val : ℤ) + 1) y ≠ 0 := by
        intro y hy h_zero
        have h_ell_ne : P.ℓ_slice j y ≠ 0 := P.reg_chord_ne_zero y hy j
        unfold OddPeriodicSliceData.ℓ_slice at h_ell_ne
        rw [h_zero, div_zero] at h_ell_ne
        exact h_ell_ne rfl
      have h_ell_cont : ContinuousOn (P.ℓ_slice j) Ω_reg :=
        h_num_cont.div (h_f_j.mul h_f_j1) h_den_ne
      have h4 : ContinuousOn (fun y => |Real.log ‖P.ℓ_slice j y‖|) Ω_reg :=
        ((h_ell_cont.norm).log fun y hy =>
          norm_ne_zero_iff.mpr (P.reg_chord_ne_zero y hy j)).abs
      exact ((h1.add h2).add h3).add h4
    have h_cost_cont : ContinuousOn (sliceGeomCost S P) Ω_reg :=
      ContinuousOn.finset_sup'_apply Finset.univ_nonempty fun j _ => h_term_cont j
    exact h_reg_comp_meas (h_walk_meas k) (fun om => h_walk_in_reg om k) h_cost_cont
  let X_pref : ∀ n : ℕ, WalkSpace → (Finset.range (n + 1) → ℝ) :=
    fun n => (Finset.range (n + 1)).restrict
  let X_next : ℕ → WalkSpace → ℝ :=
    fun n om => om (n + 1)
  let padPrefix : ∀ n : ℕ, (Finset.range (n + 1) → ℝ) → WalkSpace :=
    fun n p k => if hk : k ∈ Finset.range (n + 1) then p ⟨k, hk⟩ else 0
  have hX_pref_meas : ∀ n : ℕ, Measurable (X_pref n) :=
    fun _ => measurable_pi_iff.mpr fun i => measurable_pi_apply i.1
  have hX_next_meas : ∀ n : ℕ, Measurable (X_next n) :=
    fun n => measurable_pi_apply (n + 1)
  have h_pad_meas : ∀ n : ℕ, Measurable (padPrefix n) := by
    intro n
    refine measurable_pi_iff.mpr fun k => ?_
    dsimp only [padPrefix]
    split_ifs with hk
    · exact measurable_pi_apply (⟨k, hk⟩ : Finset.range (n + 1))
    · exact measurable_const
  have h_pad_restrict_eq : ∀ (n : ℕ) (om : WalkSpace) {l : ℕ}, l ≤ n →
      padPrefix n (X_pref n om) l = om l := by
    intro n om l hl
    have hl_mem : l ∈ Finset.range (n + 1) := Finset.mem_range.mpr (Nat.lt_succ_of_le hl)
    simp only [padPrefix, X_pref, hl_mem, ↓reduceDIte]
    rfl
  have h_walk_pad : ∀ (n : ℕ) (om : WalkSpace) {k : ℕ}, k ≤ n →
      walkPos ρ (padPrefix n (X_pref n om)) k = walkPos ρ om k := by
    intro n om k hk
    exact h_walkPos_depends k _ _ fun l hl => h_pad_restrict_eq n om (le_trans hl hk)
  have h_prod_step : ∀ n : ℕ,
      walkMeasure.map (fun om => (X_pref n om, X_next n om)) =
        (walkMeasure.map (X_pref n)).prod unifTwoPiMeasure := by
    intro n
    have h_iindep :=
      ProbabilityTheory.iIndepFun_infinitePi (P := fun _ : ℕ => unifTwoPiMeasure)
        (X := fun _ (x : ℝ) => x) (fun _ => measurable_id)
    have h_disj : Disjoint (Finset.range (n + 1)) ({n + 1} : Finset ℕ) := by simp
    have h_fin := h_iindep.indepFun_finset (Finset.range (n + 1)) {n + 1} h_disj
      (fun i => measurable_pi_apply i)
    have h_eval_meas : Measurable (fun f : ({n + 1} : Finset ℕ) → ℝ =>
        f ⟨n + 1, Finset.mem_singleton_self (n + 1)⟩) :=
      measurable_pi_apply _
    have h_indep : ProbabilityTheory.IndepFun (X_pref n) (X_next n) walkMeasure :=
      h_fin.comp measurable_id h_eval_meas
    rw [(ProbabilityTheory.indepFun_iff_map_prod_eq_prod_map_map
      (hX_pref_meas n).aemeasurable (hX_next_meas n).aemeasurable).mp h_indep]
    congr 1
    exact MeasureTheory.Measure.infinitePi_map_eval (fun _ : ℕ => unifTwoPiMeasure) (n + 1)
  have h_step_fubini : ∀ (n : ℕ)
      (G : (Finset.range (n + 1) → ℝ) × ℝ → ℝ) (B : ℝ),
      Measurable G → (∀ q, ‖G q‖ ≤ B) →
      MeasureTheory.Integrable (fun om : WalkSpace => G (X_pref n om, X_next n om)) walkMeasure ∧
      (∫ om, G (X_pref n om, X_next n om) ∂walkMeasure) =
        ∫ p, (∫ θ, G (p, θ) ∂unifTwoPiMeasure) ∂(walkMeasure.map (X_pref n)) := by
    intro n G B hG_meas hG_bound
    let pairMap : WalkSpace → (Finset.range (n + 1) → ℝ) × ℝ :=
      fun om => (X_pref n om, X_next n om)
    have h_pair_meas : Measurable pairMap := (hX_pref_meas n).prodMk (hX_next_meas n)
    have h_int_walk : MeasureTheory.Integrable (fun om => G (pairMap om)) walkMeasure :=
      MeasureTheory.Integrable.of_bound (hG_meas.comp h_pair_meas).aestronglyMeasurable B
        (Filter.Eventually.of_forall fun om => hG_bound (pairMap om))
    haveI hProbPref : MeasureTheory.IsProbabilityMeasure (walkMeasure.map (X_pref n)) := by
      refine ⟨?_⟩
      rw [MeasureTheory.Measure.map_apply (hX_pref_meas n) MeasurableSet.univ,
        Set.preimage_univ, MeasureTheory.measure_univ]
    have h_int_prod : MeasureTheory.Integrable G
        ((walkMeasure.map (X_pref n)).prod unifTwoPiMeasure) :=
      MeasureTheory.Integrable.of_bound hG_meas.aestronglyMeasurable B
        (Filter.Eventually.of_forall hG_bound)
    refine ⟨h_int_walk, ?_⟩
    calc
      (∫ om, G (pairMap om) ∂walkMeasure)
        = ∫ q, G q ∂(walkMeasure.map pairMap) :=
            (MeasureTheory.integral_map h_pair_meas.aemeasurable hG_meas.aestronglyMeasurable).symm
      _ = ∫ q, G q ∂((walkMeasure.map (X_pref n)).prod unifTwoPiMeasure) := by
            rw [h_prod_step n]
      _ = ∫ p, (∫ θ, G (p, θ) ∂unifTwoPiMeasure) ∂(walkMeasure.map (X_pref n)) :=
            MeasureTheory.integral_prod G h_int_prod
  have h_step_zero : ∀ (n : ℕ)
      (G : (Finset.range (n + 1) → ℝ) × ℝ → ℝ) (B : ℝ),
      Measurable G → (∀ q, ‖G q‖ ≤ B) →
      (∀ p, (∫ θ, G (p, θ) ∂unifTwoPiMeasure) = 0) →
      MeasureTheory.Integrable (fun om : WalkSpace => G (X_pref n om, X_next n om)) walkMeasure ∧
      (∫ om, G (X_pref n om, X_next n om) ∂walkMeasure) = 0 := by
    intro n G B hG_meas hG_bound hG_zero
    rcases h_step_fubini n G B hG_meas hG_bound with ⟨h_int, h_eq⟩
    refine ⟨h_int, ?_⟩
    rw [h_eq]
    simp [hG_zero]
  have h_step_nonneg : ∀ (n : ℕ)
      (G : (Finset.range (n + 1) → ℝ) × ℝ → ℝ) (B : ℝ),
