        (by simp only [Complex.sub_im]; linarith [(hγ_im q_L hqL_mem).2, hσ_last])
        (by simp only [Complex.sub_re]; linarith [hγ_last, hz_end_re.2])
        (by simp only [Complex.sub_im]; linarith [(hγ_im q_R hqR_mem).2, hσ_last])
        (by simp only [Complex.sub_re, hpTR_re]; linarith [hγ_last, hz_end_re.2])
        (by simp only [Complex.sub_im, hpTR_im]; linarith)
        (by simp only [Complex.sub_re, hpTL_re]; linarith [hγ_head, hz_end_re.1])
        (by simp only [Complex.sub_im, hpTL_im]; linarith)
    rw [hI_start_zero, hI_end_two_pi] at h_eq_start_end
    have h_im := congr_arg Complex.im h_eq_start_end
    simp only [Complex.zero_im, Complex.mul_im, Complex.I_re, mul_zero, Complex.I_im, mul_one,
