        (h_tlu.tendstoLocallyUniformlyOn).differentiableOn h_ev_diff isOpen_ball
      exact (h_diff_V z hz_V).differentiableAt (isOpen_ball.mem_nhds hz_V)
    have hF_zero_norm : ‖F_lim 0‖ = 1 := by
      have h_const_one : ∀ k : ℕ, ‖F (σ k) 0‖ = 1 := by
        intro k
        have hm : 0 < m_seq (σ k) := (h_pos (σ k)).2
        have hψ0 : ψ (σ k) 0 = (x_seq (σ k) : ℂ) + (h_seq (σ k) : ℂ) * Complex.I := by
          simp [ψ]
        dsimp [F]
        rw [norm_mul, norm_inv, Complex.norm_of_nonneg hm.le, hψ0,
          (h_anchor (σ k)).2, inv_mul_cancel₀ hm.ne']
      have h_tend_norm : Filter.Tendsto (fun k => ‖F (σ k) 0‖) Filter.atTop (nhds ‖F_lim 0‖) :=
        continuous_norm.continuousAt.tendsto.comp (hF_pt 0)
      simp_rw [h_const_one] at h_tend_norm
      exact tendsto_nhds_unique h_tend_norm tendsto_const_nhds
    have hF_global_bound : ∀ Z : ℂ, ‖F_lim Z‖ ≤ Real.exp Z.im := by
      intro Z
      have h_eta : ∀ η : ℝ, 0 < η → ‖F_lim Z‖ ≤ Real.exp (Z.im + η) := by
        intro η hη
        obtain ⟨N₀, hN₀⟩ := h_bound (‖Z‖ + 1) η (by positivity) hη
        have h_ev_le : ∀ᶠ k in Filter.atTop, ‖F (σ k) Z‖ ≤ Real.exp (Z.im + η) := by
          rw [Filter.eventually_atTop]
          refine ⟨N₀, fun k hk => ?_⟩
          exact hF_norm_le (σ k) Z η
            (hN₀ (σ k) (le_trans hk (hσ_mono.id_le k)) Z (by linarith)).2
        exact le_of_tendsto (continuous_norm.continuousAt.tendsto.comp (hF_pt Z)) h_ev_le
      have h_inv_zero : Filter.Tendsto (fun j : ℕ => ((j : ℝ) + 1)⁻¹) Filter.atTop (nhds 0) :=
        tendsto_one_div_add_atTop_nhds_zero_nat.congr (fun j => one_div ((j : ℝ) + 1))
      have h_exp_tend : Filter.Tendsto (fun j : ℕ => Real.exp (Z.im + ((j : ℝ) + 1)⁻¹))
          Filter.atTop (nhds (Real.exp Z.im)) := by
        have h1 : Filter.Tendsto (Real.exp ∘ fun j : ℕ => Z.im + ((j : ℝ) + 1)⁻¹)
            Filter.atTop (nhds (Real.exp (Z.im + 0))) :=
          (Real.continuous_exp.continuousAt (x := Z.im + 0)).tendsto.comp
            (tendsto_const_nhds.add h_inv_zero)
        rwa [add_zero] at h1
      exact ge_of_tendsto' h_exp_tend
        (fun j : ℕ => h_eta (((j : ℝ) + 1)⁻¹) (inv_pos.mpr (Nat.cast_add_one_pos j)))
    let G : ℂ → ℂ := fun Z => Complex.exp (Complex.I * Z) * F_lim Z
    have hG_diff : Differentiable ℂ G :=
      ((differentiable_id.const_mul Complex.I).cexp).mul hF_entire
    have hG_bdd : Bornology.IsBounded (Set.range G) := by
      rw [isBounded_iff_forall_norm_le]
      refine ⟨1, ?_⟩
      rintro _ ⟨Z, rfl⟩
      dsimp [G]
      rw [norm_mul, Complex.norm_exp]
      have hre : (Complex.I * Z).re = -Z.im := by simp
      rw [hre]
      calc Real.exp (-Z.im) * ‖F_lim Z‖
          ≤ Real.exp (-Z.im) * Real.exp Z.im :=
            mul_le_mul_of_nonneg_left (hF_global_bound Z) (Real.exp_nonneg _)
        _ = Real.exp (-Z.im + Z.im) := (Real.exp_add _ _).symm
        _ = 1 := by simp
    obtain ⟨c₀, hc₀⟩ := hG_diff.exists_const_forall_eq_of_bounded hG_bdd
    have hc₀_zero : F_lim 0 = c₀ := by
      have h0 := hc₀ 0
      simpa [G] using h0
    have hc₀_ne : c₀ ≠ 0 := by
      apply norm_ne_zero_iff.mp
      rw [← hc₀_zero, hF_zero_norm]
      exact one_ne_zero
    have hF_eq : F_lim = fun Z => c₀ * Complex.exp (-Complex.I * Z) := by
      ext Z
      calc F_lim Z
          = Complex.exp (-Complex.I * Z) * G Z := by
            dsimp [G]
            rw [← mul_assoc, ← Complex.exp_add]
            have : -Complex.I * Z + Complex.I * Z = 0 := by ring
            rw [this, Complex.exp_zero, one_mul]
        _ = Complex.exp (-Complex.I * Z) * c₀ := by rw [hc₀ Z]
        _ = c₀ * Complex.exp (-Complex.I * Z) := mul_comm _ _
    rw [hF_eq] at h_tlu
    exact ⟨σ, c₀, hσ_mono, hc₀_ne, h_tlu⟩

theorem log_deficit_and_infinite_growth_exclusion : (∀ E : EntireNonisotropicStrip, EntireExpProfileObstructionProp E → False) ∧
      (∀ S : FiniteWallNonisotropicStrip,
        ExpProfileObstructionProp S →
          LogDeficitBoundProp S ∧ HasFiniteUpperGrowthOrder S) :=
by
  have hUniv : UniversalDiskLogDeficitProp := universal_disk_log_deficit
  obtain ⟨C_def, hC_def_pos, hDisk⟩ := universal_disk_log_deficit
  obtain ⟨hScaleEnt, hScaleFin⟩ := convex_growth_profile_scales
  obtain ⟨hRowProps, hFourierLin, hMontel⟩ := row_log_sup_and_exp_limit_extraction
  have h_open_strip : ∀ H : ℝ, IsOpen (horizStrip H) :=
    fun H => isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const
  have h_even_conv_mono : ∀ (I : Set ℝ) (ρ : ℝ → ℝ),
      (∀ y ∈ I, -y ∈ I) →
      (∀ y ∈ I, ρ (-y) = ρ y) →
      ConvexOn ℝ I ρ →
      ∀ y₁ y₂ : ℝ, 0 ≤ y₁ → y₁ ≤ y₂ → y₂ ∈ I → ρ y₁ ≤ ρ y₂ := by
    intro I ρ hI_symm hρ_even hρ_conv y₁ y₂ hy₁ hy₁₂ hy₂I
    rcases eq_or_lt_of_le (le_trans hy₁ hy₁₂) with hy₂_zero | hy₂_pos
    · have hy₁_eq : y₁ = y₂ := by linarith
      rw [hy₁_eq]
    · let a : ℝ := (y₂ - y₁) / (2 * y₂)
      let b : ℝ := (y₂ + y₁) / (2 * y₂)
      have ha : 0 ≤ a := div_nonneg (by linarith) (by positivity)
      have hb : 0 ≤ b := div_nonneg (by linarith) (by positivity)
      have hab : a + b = 1 := by
        dsimp [a, b]
        field_simp [hy₂_pos.ne']
        ring
      have hcomb : a • (-y₂) + b • y₂ = y₁ := by
        simp only [smul_eq_mul]
        dsimp [a, b]
        field_simp [hy₂_pos.ne']
        ring
      have h_ineq := hρ_conv.2 (hI_symm y₂ hy₂I) hy₂I ha hb hab
      simp only [smul_eq_mul] at h_ineq hcomb
      rw [hcomb, hρ_even y₂ hy₂I] at h_ineq
      calc ρ y₁ ≤ a * ρ y₂ + b * ρ y₂ := h_ineq
        _ = (a + b) * ρ y₂ := by ring
        _ = ρ y₂ := by rw [hab, one_mul]
  have h_ell_inv_bound : ∀ ℓ v : ℝ, 0 < ℓ → 1 ≤ v → |Real.log ℓ| / v < 1 / 8 →
      Real.exp (-(1 / 8) * v) ≤ ℓ ∧
      (ℓ / 2)⁻¹ * (1 + (ℓ / 2)⁻¹) ≤ 6 * Real.exp ((1 / 4) * v) := by
    intro ℓ v hℓ_pos hv_ge h_rat
    have hv_pos : 0 < v := lt_of_lt_of_le zero_lt_one hv_ge
    have habs_lt : |Real.log ℓ| < (1 / 8) * v := (div_lt_iff₀ hv_pos).mp h_rat
    have hlog_gt : -(1 / 8) * v < Real.log ℓ := by
      have := (abs_lt.mp habs_lt).1
      linarith
    have hexp_le : Real.exp (-(1 / 8) * v) ≤ ℓ := by
      calc Real.exp (-(1 / 8) * v) ≤ Real.exp (Real.log ℓ) := Real.exp_le_exp.mpr hlog_gt.le
        _ = ℓ := Real.exp_log hℓ_pos
    have hinv_le : ℓ⁻¹ ≤ Real.exp ((1 / 8) * v) := by
      have h1 := inv_anti₀ (Real.exp_pos _) hexp_le
      rw [← Real.exp_neg] at h1
      have hneg : -(-(1 / 8) * v) = (1 / 8) * v := by ring
      rwa [hneg] at h1
    have h_half_inv : (ℓ / 2)⁻¹ ≤ 2 * Real.exp ((1 / 8) * v) := by
      have h_eq : (ℓ / 2)⁻¹ = 2 * ℓ⁻¹ := by
        field_simp [hℓ_pos.ne']
      rw [h_eq]
      linarith
    have h_one_le : 1 ≤ Real.exp ((1 / 8) * v) := by
      have : (0 : ℝ) ≤ (1 / 8) * v := by positivity
      calc (1 : ℝ) = Real.exp 0 := Real.exp_zero.symm
        _ ≤ Real.exp ((1 / 8) * v) := Real.exp_le_exp.mpr this
    have h_prod : (ℓ / 2)⁻¹ * (1 + (ℓ / 2)⁻¹) ≤ 6 * Real.exp ((1 / 4) * v) := by
      have h_add : 1 + (ℓ / 2)⁻¹ ≤ 3 * Real.exp ((1 / 8) * v) := by linarith
      calc (ℓ / 2)⁻¹ * (1 + (ℓ / 2)⁻¹)
          ≤ (2 * Real.exp ((1 / 8) * v)) * (3 * Real.exp ((1 / 8) * v)) :=
            mul_le_mul h_half_inv h_add (by positivity) (by positivity)
        _ = 6 * (Real.exp ((1 / 8) * v) * Real.exp ((1 / 8) * v)) := by ring
        _ = 6 * Real.exp ((1 / 8) * v + (1 / 8) * v) := by rw [← Real.exp_add]
        _ = 6 * Real.exp ((1 / 4) * v) := by ring_nf
    exact ⟨hexp_le, h_prod⟩
  have h_tlu_subseq : ∀ (G : ℕ → ℂ → ℂ) (g : ℂ → ℂ) (σ : ℕ → ℕ),
      StrictMono σ →
      TendstoLocallyUniformly G g Filter.atTop →
      TendstoLocallyUniformly (fun k Z => G (σ k) Z) g Filter.atTop := by
    intro G g σ hσ hG
    rw [tendstoLocallyUniformly_iff_forall_isCompact] at hG ⊢
    intro K hK
    rw [Metric.tendstoUniformlyOn_iff]
    intro ε hε
    exact hσ.tendsto_atTop.eventually ((Metric.tendstoUniformlyOn_iff.mp (hG K hK)) ε hε)
  have h_q_tlu_zero : ∀ (U : Set ℂ) (f q : ℂ → ℂ) (ρ : ℝ → ℝ) (C_strip : ℝ)
      (x_seq h_seq ℓ_seq m_seq : ℕ → ℝ),
      0 < C_strip →
      (∀ z : ℂ, (z.im : ℂ) * Complex.I ∈ U → z ∈ U) →
      (∀ y : ℝ, (y : ℂ) * Complex.I ∈ U → ∀ x : ℝ,
        ‖f ((x : ℂ) + (y : ℂ) * Complex.I)‖ ≤ Real.exp (ρ y)) →
      (∀ (z₀ : ℂ) (Δ K : ℝ), 0 < Δ →
        Metric.closedBall z₀ Δ ⊆ U →
        (∀ x : ℝ, ∀ y ∈ Set.Icc (z₀.im - Δ) (z₀.im + Δ),
          ‖f ((x : ℂ) + (y : ℂ) * Complex.I)‖ ≤ Real.exp K) →
        Real.sqrt ‖q z₀‖ ≤ C_strip * Δ⁻¹ * (1 + Δ⁻¹) * (1 + max K 0)) →
      (∀ n : ℕ, 0 < ℓ_seq n ∧ 0 < m_seq n ∧
        m_seq n = Real.exp (ρ (h_seq n)) ∧ 1 ≤ ρ (h_seq n)) →
      Filter.Tendsto (fun n => ρ (h_seq n)) Filter.atTop Filter.atTop →
      Filter.Tendsto (fun n => |Real.log (ℓ_seq n)| / ρ (h_seq n)) Filter.atTop (nhds 0) →
      (∀ M_u η : ℝ, 0 < M_u → 0 < η → ∃ N₀ : ℕ, ∀ n ≥ N₀, ∀ u : ℝ, |u| ≤ M_u →
        ((h_seq n + ℓ_seq n * u : ℝ) : ℂ) * Complex.I ∈ U ∧
        ρ (h_seq n + ℓ_seq n * u) ≤ ρ (h_seq n) + u + η) →
      TendstoLocallyUniformly
        (fun n Z =>
          (((m_seq n) ^ 2)⁻¹ : ℂ) *
            q ((x_seq n : ℂ) + (h_seq n : ℂ) * Complex.I + (ℓ_seq n : ℂ) * Z))
        (fun _ => 0) Filter.atTop := by
    intro U f q ρ C_strip x_seq h_seq ℓ_seq m_seq hC_strip hU_im hf_row hQ_strip
      h_basic hv_top hlog_zero h_loc
    rw [tendstoLocallyUniformly_iff_forall_isCompact]
    intro K_comp hK_comp
    rw [Metric.tendstoUniformlyOn_iff]
    intro ε hε
    obtain ⟨R_bdd, hR_bdd⟩ := hK_comp.isBounded.subset_closedBall (0 : ℂ)
    let M_u : ℝ := max R_bdd 1
    have hM_u_pos : 0 < M_u := lt_of_lt_of_le zero_lt_one (le_max_right _ _)
    obtain ⟨N_loc, hN_loc⟩ := h_loc (M_u + 1) 1 (by positivity) zero_lt_one
    have h_ev_log := hlog_zero.eventually (gt_mem_nhds (by norm_num : (0 : ℝ) < 1 / 8))
    rw [Filter.eventually_atTop] at h_ev_log
    obtain ⟨N_log, hN_log⟩ := h_ev_log
    let V_thr : ℝ := max (M_u + 3) (2 * Real.log (48 * C_strip / Real.sqrt ε + 1) + 1)
    have h_ev_v := hv_top.eventually_ge_atTop V_thr
    rw [Filter.eventually_atTop] at h_ev_v
    obtain ⟨N_v, hN_v⟩ := h_ev_v
    rw [Filter.eventually_atTop]
    refine ⟨max (max N_loc N_log) N_v, ?_⟩
    intro n hn Z hZ_mem
    have hn_loc : N_loc ≤ n := le_trans (le_trans (le_max_left _ _) (le_max_left _ _)) hn
    have hn_log : N_log ≤ n := le_trans (le_trans (le_max_right _ _) (le_max_left _ _)) hn
    have hn_v : N_v ≤ n := le_trans (le_max_right _ _) hn
    obtain ⟨hℓ_pos, hm_pos, hm_eq, hv_ge_one⟩ := h_basic n
    let v : ℝ := ρ (h_seq n)
    have hv_thr : V_thr ≤ v := hN_v n hn_v
    have hv_ge_M : M_u + 3 ≤ v := le_trans (le_max_left _ _) hv_thr
    have hv_gt_log : 2 * Real.log (48 * C_strip / Real.sqrt ε + 1) < v := by
      have : 2 * Real.log (48 * C_strip / Real.sqrt ε + 1) + 1 ≤ v :=
        le_trans (le_max_right _ _) hv_thr
      linarith
    have hZ_norm : ‖Z‖ ≤ M_u := by
      have h1 : Z ∈ Metric.closedBall (0 : ℂ) R_bdd := hR_bdd hZ_mem
      rw [Metric.mem_closedBall, dist_zero_right] at h1
      exact le_trans h1 (le_max_left _ _)
    have hZ_im_abs : |Z.im| ≤ M_u := le_trans (Complex.abs_im_le_norm Z) hZ_norm
    let z₀ : ℂ := (x_seq n : ℂ) + (h_seq n : ℂ) * Complex.I + (ℓ_seq n : ℂ) * Z
    have hz₀_im : z₀.im = h_seq n + ℓ_seq n * Z.im := by simp [z₀]
    let Δ : ℝ := ℓ_seq n / 2
    have hΔ_pos : 0 < Δ := by dsimp [Δ]; positivity
    have h_band : ∀ y ∈ Set.Icc (z₀.im - Δ) (z₀.im + Δ),
        (y : ℂ) * Complex.I ∈ U ∧ ρ y ≤ v + M_u + 2 := by
      intro y hy
      let u : ℝ := Z.im + (y - z₀.im) / ℓ_seq n
      have hy_eq : h_seq n + ℓ_seq n * u = y := by
        dsimp [u]
        rw [hz₀_im]
        field_simp [hℓ_pos.ne']
        ring
      have hy_diff : |y - z₀.im| ≤ Δ := by
        rw [abs_le]
        exact ⟨by linarith [hy.1], by linarith [hy.2]⟩
      have hu_div : |y - z₀.im| / ℓ_seq n ≤ 1 / 2 := by
        have h1 : |y - z₀.im| / ℓ_seq n ≤ Δ / ℓ_seq n :=
          div_le_div_of_nonneg_right hy_diff hℓ_pos.le
        have h2 : Δ / ℓ_seq n = 1 / 2 := by
          dsimp [Δ]
          field_simp [hℓ_pos.ne']
        rwa [h2] at h1
      have hu_abs : |u| ≤ M_u + 1 := by
        calc |u| ≤ |Z.im| + |(y - z₀.im) / ℓ_seq n| := abs_add_le _ _
          _ = |Z.im| + |y - z₀.im| / ℓ_seq n := by rw [abs_div, abs_of_pos hℓ_pos]
          _ ≤ M_u + 1 / 2 := add_le_add hZ_im_abs hu_div
          _ ≤ M_u + 1 := by linarith
      obtain ⟨hu_U, hu_ρ⟩ := hN_loc n hn_loc u hu_abs
      rw [hy_eq] at hu_U hu_ρ
      have hu_le : u ≤ M_u + 1 := (abs_le.mp hu_abs).2
      exact ⟨hu_U, by dsimp [v]; linarith⟩
    have h_sub_U : Metric.closedBall z₀ Δ ⊆ U := by
      intro z hz
      rw [Metric.mem_closedBall, dist_eq_norm] at hz
      have him_le : |z.im - z₀.im| ≤ Δ := by
        have h1 : |(z - z₀).im| ≤ ‖z - z₀‖ := Complex.abs_im_le_norm (z - z₀)
        simpa using le_trans h1 hz
      have hz_im_mem : z.im ∈ Set.Icc (z₀.im - Δ) (z₀.im + Δ) := by
        rw [abs_le] at him_le
        exact ⟨by linarith, by linarith⟩
      exact hU_im z (h_band z.im hz_im_mem).1
    have h_f_bound : ∀ x : ℝ, ∀ y ∈ Set.Icc (z₀.im - Δ) (z₀.im + Δ),
        ‖f ((x : ℂ) + (y : ℂ) * Complex.I)‖ ≤ Real.exp (v + M_u + 2) := by
      intro x y hy
      obtain ⟨hy_U, hy_ρ⟩ := h_band y hy
      exact le_trans (hf_row y hy_U x) (Real.exp_le_exp.mpr hy_ρ)
    have hq_raw := hQ_strip z₀ Δ (v + M_u + 2) hΔ_pos h_sub_U h_f_bound
    obtain ⟨_, hΔ_inv⟩ := h_ell_inv_bound (ℓ_seq n) v hℓ_pos hv_ge_one (hN_log n hn_log)
    have hK_pos : 0 ≤ v + M_u + 2 := by linarith
    have hmax_eq : max (v + M_u + 2) 0 = v + M_u + 2 := max_eq_left hK_pos
    rw [hmax_eq] at hq_raw
    have hv_le_exp4 : v ≤ 4 * Real.exp ((1 / 4) * v) := by
      have := Real.add_one_le_exp ((1 / 4) * v)
      linarith
    have h_lin_bound : 1 + (v + M_u + 2) ≤ 8 * Real.exp ((1 / 4) * v) := by
      calc 1 + (v + M_u + 2) = v + (M_u + 3) := by ring
        _ ≤ 2 * v := by linarith
        _ ≤ 8 * Real.exp ((1 / 4) * v) := by linarith
    have hq_sqrt_le : Real.sqrt ‖q z₀‖ ≤ 48 * C_strip * Real.exp ((1 / 2) * v) := by
      have h1 : Δ⁻¹ * (1 + Δ⁻¹) * (1 + (v + M_u + 2)) ≤
          (6 * Real.exp ((1 / 4) * v)) * (8 * Real.exp ((1 / 4) * v)) :=
        mul_le_mul hΔ_inv h_lin_bound (by positivity) (by positivity)
      have h2 : (6 * Real.exp ((1 / 4) * v)) * (8 * Real.exp ((1 / 4) * v)) =
          48 * Real.exp ((1 / 2) * v) := by
        calc (6 * Real.exp ((1 / 4) * v)) * (8 * Real.exp ((1 / 4) * v))
            = 48 * (Real.exp ((1 / 4) * v) * Real.exp ((1 / 4) * v)) := by ring
          _ = 48 * Real.exp ((1 / 4) * v + (1 / 4) * v) := by rw [← Real.exp_add]
          _ = 48 * Real.exp ((1 / 2) * v) := by ring_nf
      rw [h2] at h1
      have h3 := mul_le_mul_of_nonneg_left h1 hC_strip.le
      exact le_trans hq_raw (by linarith)
    have h_prod_lt_sqrt : (m_seq n)⁻¹ * Real.sqrt ‖q z₀‖ < Real.sqrt ε := by
      have hm_inv : (m_seq n)⁻¹ = Real.exp (-v) := by
        rw [hm_eq, ← Real.exp_neg]
      have h1 : (m_seq n)⁻¹ * Real.sqrt ‖q z₀‖ ≤ 48 * C_strip * Real.exp (-(1 / 2) * v) := by
        rw [hm_inv]
        calc Real.exp (-v) * Real.sqrt ‖q z₀‖
            ≤ Real.exp (-v) * (48 * C_strip * Real.exp ((1 / 2) * v)) :=
              mul_le_mul_of_nonneg_left hq_sqrt_le (by positivity)
          _ = 48 * C_strip * (Real.exp (-v) * Real.exp ((1 / 2) * v)) := by ring
          _ = 48 * C_strip * Real.exp (-v + (1 / 2) * v) := by rw [← Real.exp_add]
          _ = 48 * C_strip * Real.exp (-(1 / 2) * v) := by ring_nf
      have h_arg_pos : 0 < 48 * C_strip / Real.sqrt ε + 1 := by positivity
      have hexp_lt : Real.exp (-(1 / 2) * v) < (48 * C_strip / Real.sqrt ε + 1)⁻¹ := by
        have h_lt : -(1 / 2) * v < -Real.log (48 * C_strip / Real.sqrt ε + 1) := by linarith
        have h2 := Real.exp_lt_exp.mpr h_lt
        rwa [Real.exp_neg, Real.exp_log h_arg_pos] at h2
      have h3 : 48 * C_strip * Real.exp (-(1 / 2) * v) <
          48 * C_strip * (48 * C_strip / Real.sqrt ε + 1)⁻¹ :=
        mul_lt_mul_of_pos_left hexp_lt (by positivity)
      have h_sqrt_pos : 0 < Real.sqrt ε := Real.sqrt_pos.mpr hε
      have h4 : 48 * C_strip * (48 * C_strip / Real.sqrt ε + 1)⁻¹ < Real.sqrt ε := by
        rw [← div_eq_mul_inv, div_lt_iff₀ h_arg_pos]
        have : (48 * C_strip / Real.sqrt ε) * Real.sqrt ε = 48 * C_strip :=
          div_mul_cancel₀ _ h_sqrt_pos.ne'
        linarith
      exact lt_of_le_of_lt h1 (lt_trans h3 h4)
    have h_sq_lt : ((m_seq n)⁻¹ * Real.sqrt ‖q z₀‖) ^ 2 < ε := by
      have h_nonneg : 0 ≤ (m_seq n)⁻¹ * Real.sqrt ‖q z₀‖ := by positivity
      have h1 : ((m_seq n)⁻¹ * Real.sqrt ‖q z₀‖) ^ 2 < (Real.sqrt ε) ^ 2 :=
        pow_lt_pow_left₀ h_prod_lt_sqrt h_nonneg (by norm_num)
