        set w₀ : ℂ := (r_b : ℂ) * Complex.exp ((θ₀ : ℂ) * Complex.I)
        set w₁ : ℂ := (r_b : ℂ) * Complex.exp ((θ₁ : ℂ) * Complex.I)
        have hw₀ : ‖w₀‖ = r_b := by
          simp [w₀, Complex.norm_exp_ofReal_mul_I, abs_of_pos hrb_pos]
        have hw₁ : ‖w₁‖ = r_b := by
