    intro hsub
    have hmul : p.2 * z = 1 := (sub_eq_zero.mp hsub).symm
    have hzn : ‖z‖ = 1 := mem_sphere_zero_iff_norm.mp hz
    have hpn : ‖p.2‖ < 1 := by simpa [Metric.mem_ball, dist_zero_right] using hp.2
    have h1 : ‖p.2 * z‖ = 1 := by rw [hmul, norm_one]
