        _ ≤ B * d ^ α₁ := mul_le_mul_of_nonneg_right hB_ge (Real.rpow_nonneg hd_pos.le α₁)
    have hterm_pos : 0 ≤ (ε / r) * d ^ α₁ := le_trans zero_le_one hone_le_term
    have hsq_factor : (1 + (ε / r) * d ^ α₁) ^ 2 * ‖w‖ ^ 2 ≤
