        exact Complex.norm_fderiv_le_div_of_mapsTo_ball hholo_ball hmaps hr
      have hF_meas : ∀ᶠ p in nhds p₀, MeasureTheory.AEStronglyMeasurable (fun μ => Φ μ p) μ₀ := by
        filter_upwards [hs_nhds] with p hp
        have hp_out : p ∈ W_out := hball2_sub (hble p hp (Metric.mem_ball_self hr))
        have hc_p : ContinuousOn (fun μ : ℝ => Φ μ p) I_cc :=
          hΦ_cont.comp (continuous_id.prodMk continuous_const).continuousOn
            (fun μ hμ => ⟨hμ, hp_out⟩)
        exact (hc_p.aestronglyMeasurable measurableSet_uIcc).mono_measure hμ_le
      have hF_int : IntervalIntegrable (fun μ => Φ μ p₀)
          MeasureTheory.volume (-1 / 2 : ℝ) (1 / 2 : ℝ) := by
        have hc_p₀ : ContinuousOn (fun μ : ℝ => Φ μ p₀) I_cc :=
          hΦ_cont.comp (continuous_id.prodMk continuous_const).continuousOn
            (fun μ hμ => ⟨hμ, hp₀⟩)
        exact hc_p₀.intervalIntegrable
      let h_seq : ℕ → ℂ := fun n => (((1 : ℝ) / ((n : ℝ) + 1)) * (r / 2) : ℝ)
      have hh_ne : ∀ n : ℕ, h_seq n ≠ 0 := by
        intro n
        dsimp [h_seq]
        exact Complex.ofReal_ne_zero.mpr (by positivity)
      have hh_norm : ∀ n : ℕ, ‖h_seq n‖ < 2 * r := by
        intro n
        dsimp [h_seq]
        rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos (by positivity)]
        have h1 : (1 : ℝ) / ((n : ℝ) + 1) ≤ 1 := by
          rw [div_le_one (by positivity)]
