  let HasJet : ℕ → (ℂ → ℂ) → (ℂ → ℂ) → Prop := fun N F P =>
    ∃ C_j δ_j : ℝ, 0 < δ_j ∧ 0 ≤ C_j ∧ ∀ h : ℂ, ‖h‖ < δ_j → ‖F h - P h‖ ≤ C_j * ‖h‖ ^ N
  have hasDerivAt_poly5 : ∀ (a₀ a₁ a₂ a₃ a₄ a₅ w : ℂ),
      HasDerivAt (fun z : ℂ => a₀ + a₁ * z + a₂ * z ^ 2 + a₃ * z ^ 3 + a₄ * z ^ 4 + a₅ * z ^ 5)
        (a₁ + 2 * a₂ * w + 3 * a₃ * w ^ 2 + 4 * a₄ * w ^ 3 + 5 * a₅ * w ^ 4) w := by
    intro a₀ a₁ a₂ a₃ a₄ a₅ w
    have h0 := hasDerivAt_const w a₀
    have h1 := (hasDerivAt_id w).const_mul a₁
    have h2 := ((hasDerivAt_id w).pow 2).const_mul a₂
    have h3 := ((hasDerivAt_id w).pow 3).const_mul a₃
    have h4 := ((hasDerivAt_id w).pow 4).const_mul a₄
    have h5 := ((hasDerivAt_id w).pow 5).const_mul a₅
    convert (((((h0.add h1).add h2).add h3).add h4).add h5) using 1
    · ext z; simp [Pi.add_apply, Pi.pow_apply]
    · simp; ring
  have hJet_refl : ∀ (N : ℕ) (F : ℂ → ℂ), HasJet N F F :=
    fun _ _ => ⟨0, 1, zero_lt_one, le_rfl, fun _ _ => by simp⟩
  have hJet_cont0 : ∀ {F : ℂ → ℂ}, ContinuousAt F 0 → HasJet 0 F (fun _ => 0) := by
    intro F hF
    have h1 : ∀ᶠ z in nhds (0 : ℂ), dist (F z) (F 0) < 1 :=
      hF (Metric.ball_mem_nhds (F 0) zero_lt_one)
    rcases Metric.eventually_nhds_iff.mp h1 with ⟨δ, hδ, hb⟩
    refine ⟨‖F 0‖ + 1, δ, hδ, by positivity, fun z hz => ?_⟩
    have hd : ‖F z - F 0‖ < 1 := by simpa [dist_eq_norm] using hb (by simpa using hz)
    have hnorm : ‖F z‖ ≤ ‖F 0‖ + 1 := by
      calc ‖F z‖ = ‖F 0 + (F z - F 0)‖ := by ring_nf
        _ ≤ ‖F 0‖ + ‖F z - F 0‖ := norm_add_le _ _
        _ ≤ ‖F 0‖ + 1 := by linarith
    simpa using hnorm
  have hJet_trans : ∀ {N : ℕ} {F G P : ℂ → ℂ},
      HasJet N F G → HasJet N G P → HasJet N F P := by
    intro N F G P ⟨C₁, δ₁, hδ₁, hC₁, hb₁⟩ ⟨C₂, δ₂, hδ₂, hC₂, hb₂⟩
    refine ⟨C₁ + C₂, min δ₁ δ₂, lt_min hδ₁ hδ₂, add_nonneg hC₁ hC₂, fun h hh => ?_⟩
    calc ‖F h - P h‖ = ‖(F h - G h) + (G h - P h)‖ := by ring_nf
      _ ≤ ‖F h - G h‖ + ‖G h - P h‖ := norm_add_le _ _
      _ ≤ C₁ * ‖h‖ ^ N + C₂ * ‖h‖ ^ N :=
        add_le_add (hb₁ h (lt_of_lt_of_le hh (min_le_left _ _)))
          (hb₂ h (lt_of_lt_of_le hh (min_le_right _ _)))
      _ = (C₁ + C₂) * ‖h‖ ^ N := by ring
  have hJet_weaken : ∀ {M_n N : ℕ}, M_n ≤ N → ∀ {F P : ℂ → ℂ},
      HasJet N F P → HasJet M_n F P := by
    intro M_n N hMN F P ⟨C_j, δ_j, hδ, hC, hb⟩
    refine ⟨C_j, min δ_j 1, lt_min hδ zero_lt_one, hC, fun z hz => ?_⟩
    have hz1 : ‖z‖ ≤ 1 := (lt_of_lt_of_le hz (min_le_right _ _)).le
    calc ‖F z - P z‖ ≤ C_j * ‖z‖ ^ N := hb z (lt_of_lt_of_le hz (min_le_left _ _))
      _ ≤ C_j * ‖z‖ ^ M_n :=
        mul_le_mul_of_nonneg_left (pow_le_pow_of_le_one (norm_nonneg z) hz1 hMN) hC
  have hJet_add : ∀ {N : ℕ} {F₁ P₁ F₂ P₂ : ℂ → ℂ},
      HasJet N F₁ P₁ → HasJet N F₂ P₂ →
      HasJet N (fun z => F₁ z + F₂ z) (fun z => P₁ z + P₂ z) := by
    intro N F₁ P₁ F₂ P₂ ⟨C₁, δ₁, hδ₁, hC₁, hb₁⟩ ⟨C₂, δ₂, hδ₂, hC₂, hb₂⟩
    refine ⟨C₁ + C₂, min δ₁ δ₂, lt_min hδ₁ hδ₂, add_nonneg hC₁ hC₂, fun z hz => ?_⟩
    calc ‖(F₁ z + F₂ z) - (P₁ z + P₂ z)‖ = ‖(F₁ z - P₁ z) + (F₂ z - P₂ z)‖ := by ring_nf
      _ ≤ ‖F₁ z - P₁ z‖ + ‖F₂ z - P₂ z‖ := norm_add_le _ _
      _ ≤ C₁ * ‖z‖ ^ N + C₂ * ‖z‖ ^ N :=
        add_le_add (hb₁ z (lt_of_lt_of_le hz (min_le_left _ _)))
