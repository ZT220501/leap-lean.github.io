            symJetEnv C q_idx M p (neg_idx v.1, v.2.1, v.2.2.1, v.2.2.2) := by
    intro N_idx q_idx neg_idx M p hneg ht hsh v
    let U_a : Set (ℂ × ℂ) :=
      { r : ℂ × ℂ | ‖r.2‖ < 2 * hDet.r_det ∧
          |(r.1 - (q_idx v.1 : ℂ) * r.2).im| < 2 * hDet.s_det }
