            dsimp only [H_mat, lcJetFormalHess]
            have h0L := hCoreJets ⟨r.1, by have := r.2; omega⟩ 0 (by omega)
            have h1L := hCoreJets ⟨r.1, by have := r.2; omega⟩ 1 (by omega)
            have h2L := F_val.mul_mem h2_mem
              (hCoreJets ⟨r.1, by have := r.2; omega⟩ 2 (by omega))
            have h0R := hCoreJets ⟨r.1 + 1, by have := r.2; omega⟩ 0 (by omega)
            have h1R := hCoreJets ⟨r.1 + 1, by have := r.2; omega⟩ 1 (by omega)
            have h2R := F_val.mul_mem h2_mem
              (hCoreJets ⟨r.1 + 1, by have := r.2; omega⟩ 2 (by omega))
            have hsL := (h_sd_mem ⟨r.1, by have := r.2; omega⟩).1
            have hcL := (h_sd_mem ⟨r.1, by have := r.2; omega⟩).2
            have hsR := (h_sd_mem ⟨r.1 + 1, by have := r.2; omega⟩).1
            have hcR := (h_sd_mem ⟨r.1 + 1, by have := r.2; omega⟩).2
            split_ifs
            · exact F_val.add_mem
                (F_val.add_mem
                  (F_val.mul_mem (F_val.div_mem (F_val.sub_mem h2L h0L) h2_mem) hsL)
                  (F_val.mul_mem h1L hcL))
                (F_val.sub_mem
                  (F_val.mul_mem (F_val.div_mem (F_val.sub_mem h2R h0R) h2_mem) hsR)
                  (F_val.mul_mem h1R hcR))
            · exact F_val.mul_mem (F_val.div_mem (F_val.add_mem h0R h2R) h2_mem) hsR
            · exact F_val.mul_mem (F_val.div_mem (F_val.add_mem h0L h2L) h2_mem) hsL
            · exact F_val.zero_mem
          have hb_mem : ∀ r : Fin (k - 1), b_vec r ∈ F_val :=
            fun r => F_val.neg_mem (h_grad_ref_mem r)
          have hHx_eq : H_mat.mulVec x_vec = b_vec := by
            ext r
            let i_L : Fin k := ⟨r.1, by have := r.2; omega⟩
            let i_R : Fin k := ⟨r.1 + 1, by have := r.2; omega⟩
            let D_val : ℂ :=
              ((2 * PowerSeries.coeff 2 (h_ser i_L) - PowerSeries.coeff 0 (h_ser i_L)) / 2 *
                  s_d i_L +
                PowerSeries.coeff 1 (h_ser i_L) * c_d i_L) +
              ((2 * PowerSeries.coeff 2 (h_ser i_R) - PowerSeries.coeff 0 (h_ser i_R)) / 2 *
                  s_d i_R -
                PowerSeries.coeff 1 (h_ser i_R) * c_d i_R)
            let U_val : ℂ :=
              (PowerSeries.coeff 0 (h_ser i_R) + 2 * PowerSeries.coeff 2 (h_ser i_R)) / 2 * s_d i_R
            let L_val : ℂ :=
              (PowerSeries.coeff 0 (h_ser i_L) + 2 * PowerSeries.coeff 2 (h_ser i_L)) / 2 * s_d i_L
            have h_entry_split : ∀ s : Fin (k - 1),
                H_mat r s * x_vec s =
                  (if s = r then D_val * x_vec s else 0) +
                  (if s.1 = r.1 + 1 then U_val * x_vec s else 0) +
                  (if r.1 = s.1 + 1 then L_val * x_vec s else 0) := by
              intro s
              dsimp only [H_mat, lcJetFormalHess, D_val, U_val, L_val, i_L, i_R]
              have h_iff : (s = r) ↔ (r.1 = s.1) :=
                ⟨fun h => (congr_arg Fin.val h).symm, fun h => Fin.ext h.symm⟩
              simp only [h_iff]
              split_ifs <;> first | omega | ring
            have h_sum_D : (∑ s : Fin (k - 1), if s = r then D_val * x_vec s else 0) =
                D_val * MvPowerSeries.coeff d (η ⟨r.1 + 1, by have := r.2; omega⟩) := by
              simp [x_vec]
            have h_sum_U : (∑ s : Fin (k - 1), if s.1 = r.1 + 1 then U_val * x_vec s else 0) =
                U_val * MvPowerSeries.coeff d (η ⟨r.1 + 2, by have := r.2; omega⟩) := by
              by_cases hr_top : r.1 + 1 < k - 1
              · let s_next : Fin (k - 1) := ⟨r.1 + 1, hr_top⟩
                have h_iff : ∀ s : Fin (k - 1), (s.1 = r.1 + 1) ↔ s = s_next :=
                  fun s => ⟨fun h => Fin.ext h, fun h => congr_arg Fin.val h⟩
