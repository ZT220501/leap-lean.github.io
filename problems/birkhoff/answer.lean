    rintro ζ ⟨hζ_cb, hζ_nb⟩
    have hle : ‖ζ‖ ≤ r := mem_closedBall_zero_iff.mp hζ_cb
    have hge : r₁ ≤ ‖ζ‖ := not_lt.mp (by simpa [mem_ball_zero_iff] using hζ_nb)
    exact ⟨by linarith [hr₁_def], by linarith⟩
  have hann_open_sub : Metric.ball (0 : ℂ) r \ Metric.closedBall (0 : ℂ) r₁ ⊆ U_ann := by
    rintro ζ ⟨hζ_b, hζ_ncb⟩
    exact hann_sub ⟨Metric.ball_subset_closedBall hζ_b,
      fun h_in => hζ_ncb (Metric.ball_subset_closedBall h_in)⟩
  have hsphere_r₁_sub : Metric.sphere (0 : ℂ) r₁ ⊆ U_ann := by
    intro ζ hζ
    have hnorm : ‖ζ‖ = r₁ := mem_sphere_zero_iff_norm.mp hζ
    exact ⟨by linarith [hr₁_def], by linarith [hr₁_def]⟩
  have hMom_r₁ : ∀ i : ℕ, (∮ ζ in C((0 : ℂ), r₁), h ζ * ζ ^ i) = 0 := by
    intro i
    have hfi : DifferentiableOn ℂ (fun ζ => h ζ * ζ ^ i) U_ann :=
      hHoloh.mul (differentiableOn_id.pow i)
    have hshift := Complex.circleIntegral_eq_of_differentiable_on_annulus_off_countable
      (c := (0 : ℂ)) hr₁_pos hr₁_le_r Set.countable_empty
      (hfi.continuousOn.mono hann_sub)
      (fun ζ hζ => hfi.differentiableAt (hOpen_ann.mem_nhds (hann_open_sub hζ.1)))
    rw [← hshift]
    exact hMom_r i
  have hz_ann : z ∈ U_ann := ⟨by linarith, by linarith⟩
  have hdslope_holo : DifferentiableOn ℂ (dslope h z) U_ann :=
    (Complex.differentiableOn_dslope (hOpen_ann.mem_nhds hz_ann)).mpr hHoloh
  have hdslope_shift :
      (∮ ζ in C((0 : ℂ), r), dslope h z ζ) = (∮ ζ in C((0 : ℂ), r₁), dslope h z ζ) :=
    Complex.circleIntegral_eq_of_differentiable_on_annulus_off_countable
      (c := (0 : ℂ)) hr₁_pos hr₁_le_r Set.countable_empty
      (hdslope_holo.continuousOn.mono hann_sub)
      (fun ζ hζ => hdslope_holo.differentiableAt (hOpen_ann.mem_nhds (hann_open_sub hζ.1)))
  
  have h_outer : (∮ ζ in C((0 : ℂ), r), dslope h z ζ) =
      (∮ ζ in C((0 : ℂ), r), (ζ - z)⁻¹ * h ζ) - h z * (2 * (Real.pi : ℂ) * Complex.I) := by
    have heq_r : Set.EqOn (dslope h z) (fun ζ => (ζ - z)⁻¹ * h ζ - h z * (ζ - z)⁻¹)
        (Metric.sphere (0 : ℂ) r) := by
      intro ζ hζ
      have hζ_norm : ‖ζ‖ = r := mem_sphere_zero_iff_norm.mp hζ
      have hne : ζ ≠ z := fun h_eq => by rw [h_eq] at hζ_norm; linarith
      rw [dslope_of_ne h hne, slope_def_field]
      ring
    have hinv_cont_r : ContinuousOn (fun ζ => (ζ - z)⁻¹) (Metric.sphere (0 : ℂ) r) := by
      refine ContinuousOn.inv₀ (continuousOn_id.sub continuousOn_const) fun ζ hζ => ?_
      have hζ_norm : ‖ζ‖ = r := mem_sphere_zero_iff_norm.mp hζ
      exact sub_ne_zero.mpr fun h_eq => by rw [h_eq] at hζ_norm; linarith
    have hh_cont_r : ContinuousOn h (Metric.sphere (0 : ℂ) r) :=
      hHoloh.continuousOn.mono hsphere_r_sub
    have hint1_r : CircleIntegrable (fun ζ => (ζ - z)⁻¹ * h ζ) (0 : ℂ) r :=
      (hinv_cont_r.mul hh_cont_r).circleIntegrable (le_of_lt hr_pos)
    have hint2_r : CircleIntegrable (fun ζ => h z * (ζ - z)⁻¹) (0 : ℂ) r :=
      (continuousOn_const.mul hinv_cont_r).circleIntegrable (le_of_lt hr_pos)
    rw [circleIntegral.integral_congr (le_of_lt hr_pos) heq_r,
      circleIntegral.integral_sub hint1_r hint2_r,
      circleIntegral.integral_const_mul,
      circleIntegral.integral_sub_inv_of_mem_ball (mem_ball_zero_iff.mpr hz₂)]
  
  have h_inner_inv : (∮ ζ in C((0 : ℂ), r₁), (ζ - z)⁻¹) = 0 := by
    have hinv_ball : DifferentiableOn ℂ (fun ζ => (ζ - z)⁻¹) (Metric.ball (0 : ℂ) ‖z‖) := by
      intro ζ hζ
      have hlt : ‖ζ‖ < ‖z‖ := mem_ball_zero_iff.mp hζ
      have hne : ζ - z ≠ 0 := sub_ne_zero.mpr fun h_eq => by rw [h_eq] at hlt; linarith
      exact ((differentiableAt_id.sub (differentiableAt_const z)).inv hne).differentiableWithinAt
    have hcb_sub : Metric.closedBall (0 : ℂ) r₁ ⊆ Metric.ball (0 : ℂ) ‖z‖ :=
      Metric.closedBall_subset_ball hr₁_lt_z
    exact Complex.circleIntegral_eq_zero_of_differentiable_on_off_countable
      (le_of_lt hr₁_pos) Set.countable_empty
      (hinv_ball.continuousOn.mono hcb_sub)
      (fun ζ hζ => hinv_ball.differentiableAt
        (Metric.isOpen_ball.mem_nhds (hcb_sub (Metric.ball_subset_closedBall hζ.1))))
  have h_inner_h : (∮ ζ in C((0 : ℂ), r₁), (ζ - z)⁻¹ * h ζ) = 0 := by
    let I₁ : ℂ := ∮ ζ in C((0 : ℂ), r₁), (ζ - z)⁻¹ * h ζ
    have hh_cont_r₁ : ContinuousOn h (Metric.sphere (0 : ℂ) r₁) :=
      hHoloh.continuousOn.mono hsphere_r₁_sub
    have hinv_cont_r₁ : ContinuousOn (fun ζ => (ζ - z)⁻¹) (Metric.sphere (0 : ℂ) r₁) := by
      refine ContinuousOn.inv₀ (continuousOn_id.sub continuousOn_const) fun ζ hζ => ?_
      have hζ_norm : ‖ζ‖ = r₁ := mem_sphere_zero_iff_norm.mp hζ
      exact sub_ne_zero.mpr fun h_eq => by rw [h_eq] at hζ_norm; linarith
    obtain ⟨M₀_h, hM₀_h⟩ := (isCompact_sphere (0 : ℂ) r₁).bddAbove_image
      (continuous_norm.comp_continuousOn hh_cont_r₁)
    let M_h : ℝ := max 0 M₀_h
    have hM_h_nonneg : 0 ≤ M_h := le_max_left 0 M₀_h
    have hM_h_bound : ∀ ζ ∈ Metric.sphere (0 : ℂ) r₁, ‖h ζ‖ ≤ M_h :=
      fun ζ hζ => le_trans (hM₀_h (Set.mem_image_of_mem _ hζ)) (le_max_right 0 M₀_h)
    have hI₁_eq : ∀ N : ℕ,
        I₁ = ∮ ζ in C((0 : ℂ), r₁), z⁻¹ ^ N * ((ζ - z)⁻¹ * h ζ * ζ ^ N) := by
      intro N
      have hgeom_eq : Set.EqOn (fun ζ => (ζ - z)⁻¹ * h ζ)
          (fun ζ => (∑ i ∈ Finset.range N, (-z⁻¹ ^ (i + 1)) * (h ζ * ζ ^ i)) +
            z⁻¹ ^ N * ((ζ - z)⁻¹ * h ζ * ζ ^ N))
          (Metric.sphere (0 : ℂ) r₁) := by
        intro ζ hζ
        have hζ_norm : ‖ζ‖ = r₁ := mem_sphere_zero_iff_norm.mp hζ
        have hζz_ne : ζ - z ≠ 0 := sub_ne_zero.mpr fun h_eq => by rw [h_eq] at hζ_norm; linarith
        have h_scalar : (ζ - z)⁻¹ =
            (∑ i ∈ Finset.range N, (-z⁻¹ ^ (i + 1)) * ζ ^ i) +
              z⁻¹ ^ N * ((ζ - z)⁻¹ * ζ ^ N) := by
          apply mul_left_cancel₀ hζz_ne
          rw [mul_inv_cancel₀ hζz_ne, mul_add, Finset.mul_sum]
          have h_term2 : (ζ - z) * (z⁻¹ ^ N * ((ζ - z)⁻¹ * ζ ^ N)) = (ζ * z⁻¹) ^ N := by
            rw [mul_pow]
            calc (ζ - z) * (z⁻¹ ^ N * ((ζ - z)⁻¹ * ζ ^ N))
                = ((ζ - z) * (ζ - z)⁻¹) * (ζ ^ N * z⁻¹ ^ N) := by ring
              _ = 1 * (ζ ^ N * z⁻¹ ^ N) := by rw [mul_inv_cancel₀ hζz_ne]
              _ = ζ ^ N * z⁻¹ ^ N := one_mul _
          have h_term1 : (∑ i ∈ Finset.range N, (ζ - z) * (-z⁻¹ ^ (i + 1) * ζ ^ i)) =
              1 - (ζ * z⁻¹) ^ N := by
            have h_each : ∀ i : ℕ, (ζ - z) * (-z⁻¹ ^ (i + 1) * ζ ^ i) =
                -((ζ * z⁻¹) ^ i * (ζ * z⁻¹ - 1)) := by
              intro i
              rw [mul_pow, pow_succ]
              have hzz : z * z⁻¹ = 1 := mul_inv_cancel₀ hz_ne_zero
              calc (ζ - z) * (-(z⁻¹ ^ i * z⁻¹) * ζ ^ i)
                  = -(ζ ^ i * z⁻¹ ^ i * (ζ * z⁻¹ - z * z⁻¹)) := by ring
                _ = -(ζ ^ i * z⁻¹ ^ i * (ζ * z⁻¹ - 1)) := by rw [hzz]
            simp_rw [h_each, Finset.sum_neg_distrib, ← Finset.sum_mul,
              geom_sum_mul (ζ * z⁻¹) N]
            ring
          rw [h_term1, h_term2]
          ring
        calc (ζ - z)⁻¹ * h ζ
            = ((∑ i ∈ Finset.range N, (-z⁻¹ ^ (i + 1)) * ζ ^ i) +
                z⁻¹ ^ N * ((ζ - z)⁻¹ * ζ ^ N)) * h ζ := by rw [← h_scalar]
          _ = (∑ i ∈ Finset.range N, (-z⁻¹ ^ (i + 1)) * (h ζ * ζ ^ i)) +
                z⁻¹ ^ N * ((ζ - z)⁻¹ * h ζ * ζ ^ N) := by
              rw [add_mul, Finset.sum_mul]
              congr 1
              · refine Finset.sum_congr rfl fun i _ => by ring
              · ring
      have hint_each : ∀ i ∈ Finset.range N,
          CircleIntegrable (fun ζ => (-z⁻¹ ^ (i + 1)) * (h ζ * ζ ^ i)) (0 : ℂ) r₁ := by
        intro i _
        exact (continuousOn_const.mul (hh_cont_r₁.mul
          (continuousOn_id.pow i))).circleIntegrable (le_of_lt hr₁_pos)
      have hint_sum : CircleIntegrable
          (fun ζ => ∑ i ∈ Finset.range N, (-z⁻¹ ^ (i + 1)) * (h ζ * ζ ^ i)) (0 : ℂ) r₁ := by
        refine ContinuousOn.circleIntegrable (le_of_lt hr₁_pos) ?_
        exact continuousOn_finsetSum _ fun i _ =>
          continuousOn_const.mul (hh_cont_r₁.mul (continuousOn_id.pow i))
      have hint_rem : CircleIntegrable
          (fun ζ => z⁻¹ ^ N * ((ζ - z)⁻¹ * h ζ * ζ ^ N)) (0 : ℂ) r₁ :=
        (continuousOn_const.mul ((hinv_cont_r₁.mul hh_cont_r₁).mul
          (continuousOn_id.pow N))).circleIntegrable (le_of_lt hr₁_pos)
      dsimp only [I₁]
      rw [circleIntegral.integral_congr (le_of_lt hr₁_pos) hgeom_eq,
        circleIntegral.integral_add hint_sum hint_rem,
        circleIntegral.integral_fun_sum hint_each]
      have hsum_zero : (∑ i ∈ Finset.range N,
          ∮ ζ in C((0 : ℂ), r₁), (-z⁻¹ ^ (i + 1)) * (h ζ * ζ ^ i)) = 0 := by
        refine Finset.sum_eq_zero fun i _ => ?_
        rw [circleIntegral.integral_const_mul, hMom_r₁ i, mul_zero]
      rw [hsum_zero, zero_add]
    have h_diff_pos : 0 < ‖z‖ - r₁ := sub_pos.mpr hr₁_lt_z
    have h_norm_I₁ : ∀ N : ℕ,
        ‖I₁‖ ≤ 2 * Real.pi * r₁ * (M_h / (‖z‖ - r₁)) * (r₁ / ‖z‖) ^ N := by
      intro N
      rw [hI₁_eq N]
      have h_pt : ∀ ζ ∈ Metric.sphere (0 : ℂ) r₁,
          ‖z⁻¹ ^ N * ((ζ - z)⁻¹ * h ζ * ζ ^ N)‖ ≤ (M_h / (‖z‖ - r₁)) * (r₁ / ‖z‖) ^ N := by
        intro ζ hζ
        have hζ_norm : ‖ζ‖ = r₁ := mem_sphere_zero_iff_norm.mp hζ
        have hsub_ge : ‖z‖ - r₁ ≤ ‖ζ - z‖ := by
          have htri : ‖z‖ ≤ ‖z - ζ‖ + ‖ζ‖ := by simpa using norm_add_le (z - ζ) ζ
          rw [norm_sub_rev] at htri
          linarith
        have hinv_le : ‖(ζ - z)⁻¹‖ ≤ (‖z‖ - r₁)⁻¹ := by
          rw [norm_inv]
          exact inv_anti₀ h_diff_pos hsub_ge
        have hh_le : ‖h ζ‖ ≤ M_h := hM_h_bound ζ hζ
        rw [norm_mul, norm_pow, norm_inv, norm_mul, norm_mul, norm_pow, hζ_norm]
        have hz_pos : 0 < ‖z‖ := lt_trans hr₁_pos hr₁_lt_z
        calc ‖z‖⁻¹ ^ N * (‖(ζ - z)⁻¹‖ * ‖h ζ‖ * r₁ ^ N)
            ≤ ‖z‖⁻¹ ^ N * ((‖z‖ - r₁)⁻¹ * M_h * r₁ ^ N) := by gcongr
          _ = (M_h / (‖z‖ - r₁)) * (r₁ / ‖z‖) ^ N := by
              rw [div_pow, div_eq_mul_inv, inv_pow]
              field_simp [ne_of_gt hz_pos, ne_of_gt h_diff_pos]
      calc ‖∮ ζ in C((0 : ℂ), r₁), z⁻¹ ^ N * ((ζ - z)⁻¹ * h ζ * ζ ^ N)‖
          ≤ 2 * Real.pi * r₁ * ((M_h / (‖z‖ - r₁)) * (r₁ / ‖z‖) ^ N) :=
            circleIntegral.norm_integral_le_of_norm_le_const (le_of_lt hr₁_pos) h_pt
        _ = 2 * Real.pi * r₁ * (M_h / (‖z‖ - r₁)) * (r₁ / ‖z‖) ^ N := by ring
    have hr_div_nonneg : 0 ≤ r₁ / ‖z‖ := by
      have hz_pos : 0 < ‖z‖ := lt_trans hr₁_pos hr₁_lt_z
      positivity
    have hr_div_lt : r₁ / ‖z‖ < 1 := by
      have hz_pos : 0 < ‖z‖ := lt_trans hr₁_pos hr₁_lt_z
      exact (div_lt_one hz_pos).mpr hr₁_lt_z
    have h_tendsto_zero : Filter.Tendsto
        (fun N : ℕ => 2 * Real.pi * r₁ * (M_h / (‖z‖ - r₁)) * (r₁ / ‖z‖) ^ N)
        Filter.atTop (nhds 0) := by
      simpa using (tendsto_pow_atTop_nhds_zero_of_lt_one hr_div_nonneg hr_div_lt).const_mul
        (2 * Real.pi * r₁ * (M_h / (‖z‖ - r₁)))
    have hI₁_le_zero : ‖I₁‖ ≤ 0 :=
      ge_of_tendsto' h_tendsto_zero h_norm_I₁
    exact norm_le_zero_iff.mp hI₁_le_zero
  have h_inner : (∮ ζ in C((0 : ℂ), r₁), dslope h z ζ) = 0 := by
    have heq_r₁ : Set.EqOn (dslope h z) (fun ζ => (ζ - z)⁻¹ * h ζ - h z * (ζ - z)⁻¹)
        (Metric.sphere (0 : ℂ) r₁) := by
      intro ζ hζ
      have hζ_norm : ‖ζ‖ = r₁ := mem_sphere_zero_iff_norm.mp hζ
      have hne : ζ ≠ z := fun h_eq => by rw [h_eq] at hζ_norm; linarith
      rw [dslope_of_ne h hne, slope_def_field]
      ring
    have hinv_cont_r₁ : ContinuousOn (fun ζ => (ζ - z)⁻¹) (Metric.sphere (0 : ℂ) r₁) := by
      refine ContinuousOn.inv₀ (continuousOn_id.sub continuousOn_const) fun ζ hζ => ?_
      have hζ_norm : ‖ζ‖ = r₁ := mem_sphere_zero_iff_norm.mp hζ
      exact sub_ne_zero.mpr fun h_eq => by rw [h_eq] at hζ_norm; linarith
    have hh_cont_r₁ : ContinuousOn h (Metric.sphere (0 : ℂ) r₁) :=
      hHoloh.continuousOn.mono hsphere_r₁_sub
    have hint1_r₁ : CircleIntegrable (fun ζ => (ζ - z)⁻¹ * h ζ) (0 : ℂ) r₁ :=
      (hinv_cont_r₁.mul hh_cont_r₁).circleIntegrable (le_of_lt hr₁_pos)
    have hint2_r₁ : CircleIntegrable (fun ζ => h z * (ζ - z)⁻¹) (0 : ℂ) r₁ :=
      (continuousOn_const.mul hinv_cont_r₁).circleIntegrable (le_of_lt hr₁_pos)
    rw [circleIntegral.integral_congr (le_of_lt hr₁_pos) heq_r₁,
      circleIntegral.integral_sub hint1_r₁ hint2_r₁,
      circleIntegral.integral_const_mul, h_inner_h, h_inner_inv, mul_zero, sub_zero]
  have h_int_eq : (∮ ζ in C((0 : ℂ), r), (ζ - z)⁻¹ * h ζ) =
      h z * (2 * (Real.pi : ℂ) * Complex.I) := by
    have h_sub_zero :
        (∮ ζ in C((0 : ℂ), r), (ζ - z)⁻¹ * h ζ) - h z * (2 * (Real.pi : ℂ) * Complex.I) = 0 := by
      rw [← h_outer, hdslope_shift, h_inner]
    exact sub_eq_zero.mp h_sub_zero
  have h2pi_ne : (2 : ℂ) * (Real.pi : ℂ) * Complex.I ≠ 0 :=
    mul_ne_zero (mul_ne_zero two_ne_zero (Complex.ofReal_ne_zero.mpr Real.pi_ne_zero))
      Complex.I_ne_zero
  dsimp only [N_tilde]
  change (2 * (Real.pi : ℂ) * Complex.I)⁻¹ * (∮ ζ in C((0 : ℂ), r), (ζ - z)⁻¹ * h ζ) = Q (w, z) * G (w, z)
  rw [h_int_eq]
  dsimp only [h, H]
  calc (2 * (Real.pi : ℂ) * Complex.I)⁻¹ * (Q (w, z) * G (w, z) * (2 * (Real.pi : ℂ) * Complex.I))
      = ((2 * (Real.pi : ℂ) * Complex.I)⁻¹ * (2 * (Real.pi : ℂ) * Complex.I)) *
          (Q (w, z) * G (w, z)) := by ring
    _ = 1 * (Q (w, z) * G (w, z)) := by rw [inv_mul_cancel₀ h2pi_ne]
    _ = Q (w, z) * G (w, z) := one_mul _

theorem mero_product_disk_continuation : MeroDiskContinuationProp :=
by
  obtain ⟨hRestrict, hTransfer, hGlueLoc, hGlueGlob⟩ := mero2d_sheaf_and_gluing_toolkit
  intro r_w ρ R w₀ r₀ hr_w hρ hρR hr₀ hsub₀ F F₀ hEq₀
  let A : Set ℂ := { ζ : ℂ | ρ < ‖ζ‖ ∧ ‖ζ‖ < R }
  have hEq₀_symm : MeroEqOn F₀ F (Metric.ball w₀ r₀ ×ˢ A) := by
    refine ⟨?_, ?_⟩
    · rw [Set.inter_comm]
      exact hEq₀.1
    · intro p hp q hq
      rw [min_comm] at hq
      exact (hEq₀.2 p hp q hq).symm
  let S : Set ℂ :=
    { w : ℂ | ∃ δ : ℝ, 0 < δ ∧
      Metric.ball w δ ⊆ Metric.ball (0 : ℂ) r_w ∧
      ∃ G : MeroOn2D (Metric.ball w δ ×ˢ Metric.ball (0 : ℂ) R),
        MeroEqOn G F (Metric.ball w δ ×ˢ A) }
  have hS_open : IsOpen S := by
    rw [Metric.isOpen_iff]
    rintro w ⟨δ, hδ, hsub, G, hEq⟩
    refine ⟨δ, hδ, fun w' hw' => ?_⟩
    have hdist : dist w' w < δ := Metric.mem_ball.mp hw'
    have hδ' : 0 < δ - dist w' w := sub_pos.mpr hdist
    have hsub' : Metric.ball w' (δ - dist w' w) ⊆ Metric.ball w δ :=
      Metric.ball_subset_ball' (by linarith)
    obtain ⟨G', hEq'⟩ := hRestrict w w' δ (δ - dist w' w) ρ R _ F G hδ' hρ hρR hsub' hEq
    exact ⟨δ - dist w' w, hδ', Set.Subset.trans hsub' hsub, G', hEq'⟩
  have hS_nonempty : (Metric.ball (0 : ℂ) r_w ∩ S).Nonempty :=
    ⟨w₀, hsub₀ (Metric.mem_ball_self hr₀), r₀, hr₀, hsub₀, F₀, hEq₀_symm⟩
  have hS_closed : closure S ∩ Metric.ball (0 : ℂ) r_w ⊆ S := by
    rintro w₁ ⟨hw₁_cl, hw₁_mem⟩
    obtain ⟨r, ε_r, δ₀, m, G, hδ₀, hε_r, hρ_lt, hr_lt, hδ₀_sub, hClF⟩ :=
      slice_pole_clearing_on_circle r_w ρ R w₁ hr_w hρ hρR hw₁_mem F
    have hr_gt : ε_r < r := by linarith
    obtain ⟨w₂, hw₂_S, hdist₁₂⟩ := Metric.mem_closure_iff.mp hw₁_cl δ₀ hδ₀
    obtain ⟨δ_S, hδ_S, _, G_S, hEq_S⟩ := hw₂_S
    have hdist₂₁ : dist w₂ w₁ < δ₀ := by rw [dist_comm]; exact hdist₁₂
    let δ₂ : ℝ := min δ_S (δ₀ - dist w₂ w₁)
    have hδ₂ : 0 < δ₂ := lt_min hδ_S (sub_pos.mpr hdist₂₁)
    have hδ₂_le : δ₂ ≤ δ₀ - dist w₂ w₁ := min_le_right _ _
    have hsub₂_S : Metric.ball w₂ δ₂ ⊆ Metric.ball w₂ δ_S :=
      Metric.ball_subset_ball (min_le_left _ _)
    have hsub₂_₀ : Metric.ball w₂ δ₂ ⊆ Metric.ball w₁ δ₀ :=
      Metric.ball_subset_ball' (by linarith)
    obtain ⟨G₂, hEq₂⟩ := hRestrict w₂ w₂ δ_S δ₂ ρ R _ F G_S hδ₂ hρ hρR hsub₂_S hEq_S
    have hClG₂ : IsSliceClearedOnCollar G₂ (Metric.ball w₂ δ₂) w₁ r ε_r m G :=
      hTransfer r_w ρ R r ε_r δ₀ δ₂ w₁ w₂ m G F G₂ hδ₂ hε_r hρ_lt hr_lt hsub₂_₀ hClF hEq₂
    obtain ⟨hHoloL, d₀, hDetZero⟩ :=
      uniform_hankel_rank_from_subdisk w₁ w₂ δ₀ δ₂ r ε_r R m G G₂
        hδ₀ hδ₂ hε_r hr_gt hr_lt hsub₂_₀ hClF.2.1 hClG₂
    obtain ⟨N_tilde, Q, hHoloN, hHoloQ, hNZ, hColEq⟩ :=
      cramer_annihilator_and_cauchy_interior w₁ δ₀ r ε_r d₀ G
        hδ₀ hε_r hr_gt hClF.2.1 hHoloL hDetZero
    obtain ⟨G_loc, hEq_loc⟩ :=
      hGlueLoc r_w ρ R r ε_r δ₀ w₁ m G N_tilde Q F
        hr_w hρ hδ₀ hε_r hρ_lt hr_lt hδ₀_sub hClF hHoloN hHoloQ hNZ hColEq
    exact ⟨δ₀, hδ₀, hδ₀_sub, G_loc, hEq_loc⟩
  have hSubS : Metric.ball (0 : ℂ) r_w ⊆ S :=
    (convex_ball (0 : ℂ) r_w).isPreconnected.subset_of_closure_inter_subset
      hS_open hS_nonempty hS_closed
  exact hGlueGlob r_w ρ R F hr_w hρ hρR (fun w hw => hSubS hw)

theorem collar_glued_tubes_and_symmetries (Ω : Set Plane)
    (C : AnalyticGlancingCollar Ω)
    (hDet : EndpointDeterminationData C) :
    (∀ t ∈ Metric.ball (0 : ℂ) (collarBaseR hDet),
      ENNReal.ofReal (2 * collarBaseS hDet) ≤ collarWidthX C hDet t) ∧
    (∀ t ∈ Metric.ball (0 : ℂ) (collarBaseR hDet),
      ENNReal.ofReal (2 * collarBaseS hDet) ≤ collarWidthL C hDet t) ∧
    (∀ t ∈ Metric.ball (0 : ℂ) (collarBaseR hDet),
      collarWidthX C hDet (-t) = collarWidthX C hDet t) ∧
    (∀ t ∈ Metric.ball (0 : ℂ) (collarBaseR hDet),
      collarWidthL C hDet (-t) = collarWidthL C hDet t) ∧
    LowerSemicontinuousOn (collarWidthX C hDet) (Metric.ball (0 : ℂ) (collarBaseR hDet)) ∧
    LowerSemicontinuousOn (collarWidthL C hDet) (Metric.ball (0 : ℂ) (collarBaseR hDet)) ∧
    ∃ (L_mero : Fin 2 → MeroOn2D (meroTubeENNR (collarBaseR hDet) (collarWidthL C hDet)))
      (X_mero : Fin 2 → MeroOn2D (meroTubeENNR (collarBaseR hDet) (collarWidthX C hDet))),
      (∀ i : Fin 2,
        MeroAgreesHolo (L_mero i) (fun p => glancingDualLine C p.1 p.2 i)
          { p : ℂ × ℂ | |p.1.im| < 2 * collarBaseS hDet ∧ ‖p.2‖ < collarBaseR hDet }) ∧
      (∀ i : Fin 2,
        MeroAgreesHolo (X_mero i) (fun p => glancingImpact C p.1 p.2 i)
          { p : ℂ × ℂ | |p.1.im| < 2 * collarBaseS hDet ∧ ‖p.2‖ < collarBaseR hDet }) :=
by
  classical
  
  have hDerivConjStrip : ∀ (σ : ℝ) (f : ℂ → ℂ),
      DifferentiableOn ℂ f (horizStrip σ) →
      (∀ z ∈ horizStrip σ, f (starRingEnd ℂ z) = starRingEnd ℂ (f z)) →
      ∀ z ∈ horizStrip σ, deriv f (starRingEnd ℂ z) = starRingEnd ℂ (deriv f z) := by
    intro σ f hf hconj
    have hOpen : IsOpen (horizStrip σ) :=
      isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const
    have hConjMem : ∀ w ∈ horizStrip σ, starRingEnd ℂ w ∈ horizStrip σ := by
      intro w hw
      change |(starRingEnd ℂ w).im| < σ
      rw [Complex.conj_im, abs_neg]
      exact hw
    intro z hz
    have hd : HasDerivAt f (deriv f z) z :=
      (hf.differentiableAt (hOpen.mem_nhds hz)).hasDerivAt
    have hd_conj : HasDerivAt (starRingEnd ℂ ∘ f ∘ starRingEnd ℂ)
        (starRingEnd ℂ (deriv f z)) (starRingEnd ℂ z) :=
      hd.conj_conj
    have hev : f =ᶠ[nhds (starRingEnd ℂ z)] (starRingEnd ℂ ∘ f ∘ starRingEnd ℂ) := by
      filter_upwards [hOpen.mem_nhds (hConjMem z hz)] with w hw
      simp only [Function.comp_apply]
      rw [hconj w hw, Complex.conj_conj]
    exact (hd_conj.congr_of_eventuallyEq hev).deriv

  have hEqZeroConv2D : ∀ {W V : Set (ℂ × ℂ)},
      IsOpen W → Convex ℝ W → IsOpen V → V.Nonempty → V ⊆ W →
      ∀ {f : ℂ × ℂ → ℂ}, DifferentiableOn ℂ f W → (∀ p ∈ V, f p = 0) →
      ∀ q ∈ W, f q = 0 := by
    intro W V hW hW_conv hV ⟨p₀, hp₀V⟩ hVW f hf hfV q hqW
    let Φ : ℂ → ℂ × ℂ := fun lam => p₀ + lam • (q - p₀)
    have hΦ_diff : Differentiable ℂ Φ :=
      (differentiable_const p₀).add (differentiable_id.smul_const (q - p₀))
    have hU_open : IsOpen (Φ ⁻¹' W) := hW.preimage hΦ_diff.continuous
    have hU_conv : Convex ℝ (Φ ⁻¹' W) := by
      intro lam₁ hlam₁ lam₂ hlam₂ a b ha hb hab
      have hmem : a • Φ lam₁ + b • Φ lam₂ ∈ W := hW_conv hlam₁ hlam₂ ha hb hab
      have hab_C : (a : ℂ) + (b : ℂ) = 1 := by exact_mod_cast hab
      have heq : Φ (a • lam₁ + b • lam₂) = a • Φ lam₁ + b • Φ lam₂ := by
        ext <;> simp only [Φ, Prod.fst_add, Prod.snd_add, Prod.smul_fst, Prod.smul_snd,
          Prod.fst_sub, Prod.snd_sub, Complex.real_smul, smul_eq_mul]
        · linear_combination -p₀.1 * hab_C
        · linear_combination -p₀.2 * hab_C
      change Φ (a • lam₁ + b • lam₂) ∈ W
      rwa [heq]
    have h0 : (0 : ℂ) ∈ Φ ⁻¹' W := by
      change Φ 0 ∈ W
      simpa [Φ] using hVW hp₀V
    have h1 : (1 : ℂ) ∈ Φ ⁻¹' W := by
      change Φ 1 ∈ W
      simpa [Φ] using hqW
    have hg_ana : AnalyticOnNhd ℂ (f ∘ Φ) (Φ ⁻¹' W) :=
      (hf.comp hΦ_diff.differentiableOn (fun _ h => h)).analyticOnNhd hU_open
    have hg_ev : (f ∘ Φ) =ᶠ[nhds (0 : ℂ)] 0 := by
      have hpre : Φ ⁻¹' V ∈ nhds (0 : ℂ) :=
        hΦ_diff.continuous.continuousAt.preimage_mem_nhds (by simpa [Φ] using hV.mem_nhds hp₀V)
      filter_upwards [hpre] with lam hlam
      exact hfV (Φ lam) hlam
    have hres :=
      hg_ana.eqOn_zero_of_preconnected_of_eventuallyEq_zero hU_conv.isPreconnected h0 hg_ev h1
    simpa [Φ] using hres

  have hHoloStarStar : ∀ {U : Set (ℂ × ℂ)}, IsOpen U → ∀ {g : ℂ × ℂ → ℂ},
      DifferentiableOn ℂ g U →
      DifferentiableOn ℂ (fun q => star (g (star q))) (star ⁻¹' U) := by
    intro U hU g hg p hp
    have hd : HasFDerivAt g (fderiv ℂ g (star p)) (star p) :=
      (hg.differentiableAt (hU.mem_nhds hp)).hasFDerivAt
    have hss := hd.star_star
    rw [star_star] at hss
    exact hss.differentiableAt.differentiableWithinAt

  
  let holoToMero2D : ∀ {W : Set (ℂ × ℂ)} (hW : IsOpen W) {f : ℂ × ℂ → ℂ}
      (hf : DifferentiableOn ℂ f W), MeroOn2D W :=
    fun {W} hW {f} hf =>
      let rad_fn : ℂ × ℂ → ℝ :=
        fun p => if hp : p ∈ W then Classical.choose (Metric.isOpen_iff.mp hW p hp) else 1
      have hrad_pos : ∀ p ∈ W, 0 < rad_fn p := by
        intro p hp
        dsimp only [rad_fn]
        rw [dif_pos hp]
        exact (Classical.choose_spec (Metric.isOpen_iff.mp hW p hp)).1
      have hball_sub : ∀ p ∈ W, Metric.ball p (rad_fn p) ⊆ W := by
        intro p hp
        dsimp only [rad_fn]
        rw [dif_pos hp]
        exact (Classical.choose_spec (Metric.isOpen_iff.mp hW p hp)).2
      { rad := rad_fn
        num := fun _ => f
        den := fun _ _ => 1
        rad_pos := hrad_pos
        ball_sub := hball_sub
        num_holo := fun p hp => hf.mono (hball_sub p hp)
        den_holo := fun _ _ => differentiableOn_const (1 : ℂ)
        den_ne_zero := fun p hp => ⟨p, Metric.mem_ball_self (hrad_pos p hp), one_ne_zero⟩
        compat := fun _ _ _ _ _ _ => rfl }

  have holoToMero2D_agrees : ∀ {W U : Set (ℂ × ℂ)} (hW : IsOpen W) (hU : IsOpen U)
      (hUW : U ⊆ W) {f : ℂ × ℂ → ℂ} (hf : DifferentiableOn ℂ f W),
      MeroAgreesHolo (holoToMero2D hW hf) f U := by
    intro W U hW hU hUW f hf
    refine ⟨hUW, fun p hp => ?_⟩
    obtain ⟨r_U, hr_U, hball_U⟩ := Metric.isOpen_iff.mp hU p hp
    have hrad_p : 0 < (holoToMero2D hW hf).rad p :=
      (holoToMero2D hW hf).rad_pos p (hUW hp)
    refine ⟨min r_U ((holoToMero2D hW hf).rad p), lt_min hr_U hrad_p,
      min_le_right _ _,
      (Metric.ball_subset_ball (min_le_left _ _)).trans hball_U,
      fun q _ => (mul_one (f q)).symm⟩

  have meroAgreesHolo_mono : ∀ {W U U' : Set (ℂ × ℂ)} {M : MeroOn2D W} {f : ℂ × ℂ → ℂ},
      MeroAgreesHolo M f U → IsOpen U' → U' ⊆ U → MeroAgreesHolo M f U' := by
    intro W U U' M f ⟨hUW, hloc⟩ hU' hsub
    refine ⟨hsub.trans hUW, fun p hp => ?_⟩
    obtain ⟨r₁, hr₁, hr₁_le, _, hr₁_eq⟩ := hloc p (hsub hp)
    obtain ⟨r₂, hr₂, hr₂_sub⟩ := Metric.isOpen_iff.mp hU' p hp
    refine ⟨min r₁ r₂, lt_min hr₁ hr₂, (min_le_left _ _).trans hr₁_le,
      (Metric.ball_subset_ball (min_le_right _ _)).trans hr₂_sub,
      fun q hq => hr₁_eq q (Metric.ball_subset_ball (min_le_left _ _) hq)⟩

  let meroRestrict : ∀ {W W' : Set (ℂ × ℂ)} (M : MeroOn2D W) (hW' : IsOpen W')
      (hsub : W' ⊆ W), MeroOn2D W' :=
    fun {W W'} M hW' hsub =>
      let rad' : ℂ × ℂ → ℝ :=
        fun p => if hp : p ∈ W' then
          min (M.rad p) (Classical.choose (Metric.isOpen_iff.mp hW' p hp))
        else 1
      have hrad'_pos : ∀ p ∈ W', 0 < rad' p := by
        intro p hp
        dsimp only [rad']
        rw [dif_pos hp]
        exact lt_min (M.rad_pos p (hsub hp))
          (Classical.choose_spec (Metric.isOpen_iff.mp hW' p hp)).1
      have hrad'_le : ∀ p ∈ W', rad' p ≤ M.rad p := by
        intro p hp
        dsimp only [rad']
        rw [dif_pos hp]
        exact min_le_left _ _
      have hball'_sub : ∀ p ∈ W', Metric.ball p (rad' p) ⊆ W' := by
        intro p hp
        dsimp only [rad']
        rw [dif_pos hp]
        exact (Metric.ball_subset_ball (min_le_right _ _)).trans
          (Classical.choose_spec (Metric.isOpen_iff.mp hW' p hp)).2
      { rad := rad'
        num := M.num
        den := M.den
        rad_pos := hrad'_pos
        ball_sub := hball'_sub
        num_holo := fun p hp =>
          (M.num_holo p (hsub hp)).mono (Metric.ball_subset_ball (hrad'_le p hp))
        den_holo := fun p hp =>
          (M.den_holo p (hsub hp)).mono (Metric.ball_subset_ball (hrad'_le p hp))
        den_ne_zero := by
          intro p hp
          by_contra h_all
          push_neg at h_all
          have hzero : ∀ q ∈ Metric.ball p (M.rad p), M.den p q = 0 :=
            hEqZeroConv2D Metric.isOpen_ball (convex_ball p (M.rad p))
              Metric.isOpen_ball ⟨p, Metric.mem_ball_self (hrad'_pos p hp)⟩
              (Metric.ball_subset_ball (hrad'_le p hp))
              (M.den_holo p (hsub hp)) h_all
          obtain ⟨q₀, hq₀, hne⟩ := M.den_ne_zero p (hsub hp)
          exact hne (hzero q₀ hq₀)
        compat := fun p₁ hp₁ p₂ hp₂ q hq =>
          M.compat p₁ (hsub hp₁) p₂ (hsub hp₂) q
            ⟨Metric.ball_subset_ball (hrad'_le p₁ hp₁) hq.1,
             Metric.ball_subset_ball (hrad'_le p₂ hp₂) hq.2⟩ }

  have meroRestrict_agrees : ∀ {W W' U U' : Set (ℂ × ℂ)} (M : MeroOn2D W)
      (hW' : IsOpen W') (hsub : W' ⊆ W) {f : ℂ × ℂ → ℂ},
      MeroAgreesHolo M f U → IsOpen U' → U' ⊆ U → U' ⊆ W' →
      MeroAgreesHolo (meroRestrict M hW' hsub) f U' := by
    intro W W' U U' M hW' hsub f ⟨_, hloc⟩ hU' hsubU hsubW'
    refine ⟨hsubW', fun p hp => ?_⟩
    obtain ⟨r₁, hr₁, _, _, hr₁_eq⟩ := hloc p (hsubU hp)
    obtain ⟨r₂, hr₂, hr₂_sub⟩ := Metric.isOpen_iff.mp hU' p hp
    have hrad' : 0 < (meroRestrict M hW' hsub).rad p :=
      (meroRestrict M hW' hsub).rad_pos p (hsubW' hp)
    refine ⟨min r₁ (min r₂ ((meroRestrict M hW' hsub).rad p)),
      lt_min hr₁ (lt_min hr₂ hrad'),
      (min_le_right _ _).trans (min_le_right _ _),
      (Metric.ball_subset_ball ((min_le_right _ _).trans (min_le_left _ _))).trans hr₂_sub,
      fun q hq => hr₁_eq q (Metric.ball_subset_ball (min_le_left _ _) hq)⟩

  have hCancelDen : ∀ {W O : Set (ℂ × ℂ)} (F : MeroOn2D W) {p : ℂ × ℂ} (hp : p ∈ W),
      IsOpen O → O ⊆ Metric.ball p (F.rad p) →
      ∀ {h : ℂ × ℂ → ℂ}, ContinuousOn h O →
      (∀ z ∈ O, h z * F.den p z = 0) → ∀ z ∈ O, h z = 0 := by
    intro W O F p hp hO hO_sub h hh_cont hmul z₀ hz₀
    by_contra hz₀_ne
    have hh_at : ContinuousAt h z₀ := hh_cont.continuousAt (hO.mem_nhds hz₀)
    have hpos : 0 < ‖h z₀‖ := norm_pos_iff.mpr hz₀_ne
    obtain ⟨δ₁, hδ₁, hclose⟩ := Metric.continuousAt_iff.mp hh_at ‖h z₀‖ hpos
    obtain ⟨δ₂, hδ₂, hballO⟩ := Metric.isOpen_iff.mp hO z₀ hz₀
    let r₀ : ℝ := min δ₁ δ₂
    have hr₀ : 0 < r₀ := lt_min hδ₁ hδ₂
    have hr₀_sub_O : Metric.ball z₀ r₀ ⊆ O :=
      (Metric.ball_subset_ball (min_le_right _ _)).trans hballO
    have hden_zero_r₀ : ∀ z ∈ Metric.ball z₀ r₀, F.den p z = 0 := by
      intro z hz
      have hz_ne : h z ≠ 0 := by
        intro hzz
        have hlt := hclose (lt_of_lt_of_le (Metric.mem_ball.mp hz) (min_le_left _ _))
        rw [hzz, dist_eq_norm, zero_sub, norm_neg] at hlt
        exact lt_irrefl _ hlt
      exact (mul_eq_zero.mp (hmul z (hr₀_sub_O hz))).resolve_left hz_ne
    have hden_all : ∀ z ∈ Metric.ball p (F.rad p), F.den p z = 0 :=
      hEqZeroConv2D Metric.isOpen_ball (convex_ball p (F.rad p))
        Metric.isOpen_ball ⟨z₀, Metric.mem_ball_self hr₀⟩
        (hr₀_sub_O.trans hO_sub) (F.den_holo p hp) hden_zero_r₀
    obtain ⟨q₀, hq₀, hne⟩ := F.den_ne_zero p hp
    exact hne (hden_all q₀ hq₀)

  have hMeroEqOfHolo : ∀ {W₁ W₂ V₀ : Set (ℂ × ℂ)} (F₁ : MeroOn2D W₁) (F₂ : MeroOn2D W₂)
      {f : ℂ × ℂ → ℂ},
      IsOpen V₀ → MeroAgreesHolo F₁ f V₀ → MeroAgreesHolo F₂ f V₀ →
      MeroEqOn F₁ F₂ V₀ := by
    intro W₁ W₂ V₀ F₁ F₂ f _ ⟨hsub₁, hloc₁⟩ ⟨hsub₂, hloc₂⟩
    refine ⟨Set.subset_inter hsub₁ hsub₂, fun p hp q hq => ?_⟩
    obtain ⟨r₁, hr₁, hr₁_le, _, heq₁⟩ := hloc₁ p hp
    obtain ⟨r₂, hr₂, hr₂_le, _, heq₂⟩ := hloc₂ p hp
    let R : ℝ := min (F₁.rad p) (F₂.rad p)
    let r₀ : ℝ := min r₁ r₂
    have hr₀ : 0 < r₀ := lt_min hr₁ hr₂
    have hr₀_le : r₀ ≤ R := min_le_min hr₁_le hr₂_le
    let Δ : ℂ × ℂ → ℂ := fun z => F₁.num p z * F₂.den p z - F₂.num p z * F₁.den p z
    have hΔ_holo : DifferentiableOn ℂ Δ (Metric.ball p R) :=
      (((F₁.num_holo p (hsub₁ hp)).mono (Metric.ball_subset_ball (min_le_left _ _))).mul
        ((F₂.den_holo p (hsub₂ hp)).mono (Metric.ball_subset_ball (min_le_right _ _)))).sub
      (((F₂.num_holo p (hsub₂ hp)).mono (Metric.ball_subset_ball (min_le_right _ _))).mul
        ((F₁.den_holo p (hsub₁ hp)).mono (Metric.ball_subset_ball (min_le_left _ _))))
    have hΔ_r₀ : ∀ z ∈ Metric.ball p r₀, Δ z = 0 := by
      intro z hz
      have h1 := heq₁ z (Metric.ball_subset_ball (min_le_left _ _) hz)
      have h2 := heq₂ z (Metric.ball_subset_ball (min_le_right _ _) hz)
      dsimp only [Δ]
      rw [h1, h2]
      ring
    have hΔ_R : Δ q = 0 :=
      hEqZeroConv2D Metric.isOpen_ball (convex_ball p R)
        Metric.isOpen_ball ⟨p, Metric.mem_ball_self hr₀⟩
        (Metric.ball_subset_ball hr₀_le) hΔ_holo hΔ_r₀ q hq
    exact sub_eq_zero.mp hΔ_R

  have hMeroEqConn : ∀ {W₁ W₂ V V₀ : Set (ℂ × ℂ)} (F₁ : MeroOn2D W₁) (F₂ : MeroOn2D W₂),
      V ⊆ W₁ ∩ W₂ → IsOpen V → IsPreconnected V →
      IsOpen V₀ → V₀.Nonempty → V₀ ⊆ V →
      MeroEqOn F₁ F₂ V₀ → MeroEqOn F₁ F₂ V := by
    intro W₁ W₂ V V₀ F₁ F₂ hVW hV_open hV_conn _ hV₀_ne hV₀_sub hEq₀
    refine ⟨hVW, ?_⟩
    let R : ℂ × ℂ → ℝ := fun p => min (F₁.rad p) (F₂.rad p)
    let Δ : ℂ × ℂ → ℂ × ℂ → ℂ :=
      fun p z => F₁.num p z * F₂.den p z - F₂.num p z * F₁.den p z
    have hR_pos : ∀ p ∈ V, 0 < R p := fun p hp =>
      lt_min (F₁.rad_pos p (hVW hp).1) (F₂.rad_pos p (hVW hp).2)
    have hΔ_holo : ∀ p ∈ V, DifferentiableOn ℂ (Δ p) (Metric.ball p (R p)) := fun p hp =>
      (((F₁.num_holo p (hVW hp).1).mono (Metric.ball_subset_ball (min_le_left _ _))).mul
        ((F₂.den_holo p (hVW hp).2).mono (Metric.ball_subset_ball (min_le_right _ _)))).sub
      (((F₂.num_holo p (hVW hp).2).mono (Metric.ball_subset_ball (min_le_right _ _))).mul
        ((F₁.den_holo p (hVW hp).1).mono (Metric.ball_subset_ball (min_le_left _ _))))
    let A₀ : Set (ℂ × ℂ) := { p ∈ V | ∀ z ∈ Metric.ball p (R p), Δ p z = 0 }
    let A₁ : Set (ℂ × ℂ) := V \ A₀
    have hTransfer : ∀ {p p' : ℂ × ℂ}, p ∈ A₀ → p' ∈ V →
        (Metric.ball p (R p) ∩ Metric.ball p' (R p')).Nonempty → p' ∈ A₀ := by
      intro p p' ⟨hpV, hp0⟩ hp'V hne
      refine ⟨hp'V, ?_⟩
      let O : Set (ℂ × ℂ) := Metric.ball p (R p) ∩ Metric.ball p' (R p')
      have hO_open : IsOpen O := Metric.isOpen_ball.inter Metric.isOpen_ball
      have hO_sub1 : O ⊆ Metric.ball p (F₁.rad p) :=
        Set.inter_subset_left.trans (Metric.ball_subset_ball (min_le_left _ _))
      have hO_sub2 : O ⊆ Metric.ball p (F₂.rad p) :=
        Set.inter_subset_left.trans (Metric.ball_subset_ball (min_le_right _ _))
      have hmul_eq : ∀ z ∈ O, (Δ p' z * F₁.den p z) * F₂.den p z = 0 := by
        intro z hz
        have hc1 : F₁.num p z * F₁.den p' z = F₁.num p' z * F₁.den p z :=
          F₁.compat p (hVW hpV).1 p' (hVW hp'V).1 z
            ⟨Metric.ball_subset_ball (min_le_left _ _) hz.1,
             Metric.ball_subset_ball (min_le_left _ _) hz.2⟩
        have hc2 : F₂.num p z * F₂.den p' z = F₂.num p' z * F₂.den p z :=
          F₂.compat p (hVW hpV).2 p' (hVW hp'V).2 z
            ⟨Metric.ball_subset_ball (min_le_right _ _) hz.1,
             Metric.ball_subset_ball (min_le_right _ _) hz.2⟩
        have hd0 : Δ p z = 0 := hp0 z hz.1
        dsimp only [Δ] at hd0 ⊢
        linear_combination -F₂.den p' z * F₂.den p z * hc1 +
          F₁.den p' z * F₁.den p z * hc2 +
          F₁.den p' z * F₂.den p' z * hd0
      have hcont1 : ContinuousOn (fun z => Δ p' z * F₁.den p z) O :=
        (((hΔ_holo p' hp'V).mono Set.inter_subset_right).mul
          ((F₁.den_holo p (hVW hpV).1).mono hO_sub1)).continuousOn
      have hstep1 : ∀ z ∈ O, Δ p' z * F₁.den p z = 0 :=
        hCancelDen F₂ (hVW hpV).2 hO_open hO_sub2 hcont1 hmul_eq
      have hcont2 : ContinuousOn (Δ p') O :=
        ((hΔ_holo p' hp'V).mono Set.inter_subset_right).continuousOn
      have hstep2 : ∀ z ∈ O, Δ p' z = 0 :=
        hCancelDen F₁ (hVW hpV).1 hO_open hO_sub1 hcont2 hstep1
      exact hEqZeroConv2D Metric.isOpen_ball (convex_ball p' (R p'))
        hO_open hne Set.inter_subset_right (hΔ_holo p' hp'V) hstep2
    have hA₀_open : IsOpen A₀ := by
      rw [Metric.isOpen_iff]
      intro p hp
      obtain ⟨r_V, hr_V, hball_V⟩ := Metric.isOpen_iff.mp hV_open p hp.1
      refine ⟨min r_V (R p), lt_min hr_V (hR_pos p hp.1), fun p' hp' => ?_⟩
      have hp'V : p' ∈ V := hball_V (Metric.ball_subset_ball (min_le_left _ _) hp')
      have hp'_in : p' ∈ Metric.ball p (R p) ∩ Metric.ball p' (R p') :=
        ⟨Metric.ball_subset_ball (min_le_right _ _) hp', Metric.mem_ball_self (hR_pos p' hp'V)⟩
      exact hTransfer hp hp'V ⟨p', hp'_in⟩
    have hA₁_open : IsOpen A₁ := by
      rw [Metric.isOpen_iff]
      intro p ⟨hpV, hp_not⟩
      obtain ⟨r_V, hr_V, hball_V⟩ := Metric.isOpen_iff.mp hV_open p hpV
      refine ⟨min r_V (R p), lt_min hr_V (hR_pos p hpV), fun p' hp' => ?_⟩
      have hp'V : p' ∈ V := hball_V (Metric.ball_subset_ball (min_le_left _ _) hp')
      refine ⟨hp'V, fun hp'0 => hp_not ?_⟩
      have hp'_in : p' ∈ Metric.ball p' (R p') ∩ Metric.ball p (R p) :=
        ⟨Metric.mem_ball_self (hR_pos p' hp'V), Metric.ball_subset_ball (min_le_right _ _) hp'⟩
      exact hTransfer hp'0 hpV ⟨p', hp'_in⟩
    have hdisj : Disjoint A₀ A₁ := Set.disjoint_left.mpr (fun _ h0 h1 => h1.2 h0)
    have hcov : V ⊆ A₀ ∪ A₁ := fun p hp => by
      by_cases h0 : p ∈ A₀
      · exact Or.inl h0
      · exact Or.inr ⟨hp, h0⟩
    have hV₀_A₀ : V₀ ⊆ A₀ :=
      fun p hp => ⟨hV₀_sub hp, fun z hz => sub_eq_zero.mpr (hEq₀.2 p hp z hz)⟩
    rcases hV_conn.subset_or_subset hA₀_open hA₁_open hdisj hcov with hsub0 | hsub1
    · intro p hp z hz
      exact sub_eq_zero.mp ((hsub0 hp).2 z hz)
    · obtain ⟨v₀, hv₀⟩ := hV₀_ne
      exact False.elim ((hsub1 (hV₀_sub hv₀)).2 (hV₀_A₀ hv₀))

  have hCompatOfEq : ∀ {W₁ W₂ : Set (ℂ × ℂ)} (F₁ : MeroOn2D W₁) (F₂ : MeroOn2D W₂),
      MeroEqOn F₁ F₂ (W₁ ∩ W₂) →
      ∀ {p₁ p₂ q : ℂ × ℂ}, p₁ ∈ W₁ → p₂ ∈ W₂ →
      q ∈ Metric.ball p₁ (F₁.rad p₁) ∩ Metric.ball p₂ (F₂.rad p₂) →
      F₁.num p₁ q * F₂.den p₂ q = F₂.num p₂ q * F₁.den p₁ q := by
    intro W₁ W₂ F₁ F₂ hEq p₁ p₂ q hp₁ hp₂ hq
    have hqW : q ∈ W₁ ∩ W₂ := ⟨F₁.ball_sub p₁ hp₁ hq.1, F₂.ball_sub p₂ hp₂ hq.2⟩
    let Rq : ℝ := min (F₁.rad q) (F₂.rad q)
    have hRq_pos : 0 < Rq := lt_min (F₁.rad_pos q hqW.1) (F₂.rad_pos q hqW.2)
    let Oq : Set (ℂ × ℂ) :=
      (Metric.ball p₁ (F₁.rad p₁) ∩ Metric.ball p₂ (F₂.rad p₂)) ∩ Metric.ball q Rq
    have hOq_open : IsOpen Oq :=
      (Metric.isOpen_ball.inter Metric.isOpen_ball).inter Metric.isOpen_ball
    have hq_mem : q ∈ Oq := ⟨hq, Metric.mem_ball_self hRq_pos⟩
    have hOq_sub1 : Oq ⊆ Metric.ball q (F₁.rad q) :=
      Set.inter_subset_right.trans (Metric.ball_subset_ball (min_le_left _ _))
    have hOq_sub2 : Oq ⊆ Metric.ball q (F₂.rad q) :=
      Set.inter_subset_right.trans (Metric.ball_subset_ball (min_le_right _ _))
    let h_diff : ℂ × ℂ → ℂ :=
      fun z => F₁.num p₁ z * F₂.den p₂ z - F₂.num p₂ z * F₁.den p₁ z
    have hh_holo : DifferentiableOn ℂ h_diff Oq :=
      (((F₁.num_holo p₁ hp₁).mono (Set.inter_subset_left.trans Set.inter_subset_left)).mul
        ((F₂.den_holo p₂ hp₂).mono (Set.inter_subset_left.trans Set.inter_subset_right))).sub
      (((F₂.num_holo p₂ hp₂).mono (Set.inter_subset_left.trans Set.inter_subset_right)).mul
        ((F₁.den_holo p₁ hp₁).mono (Set.inter_subset_left.trans Set.inter_subset_left)))
    have hmul_eq : ∀ z ∈ Oq, (h_diff z * F₁.den q z) * F₂.den q z = 0 := by
      intro z hz
      have hc1 : F₁.num p₁ z * F₁.den q z = F₁.num q z * F₁.den p₁ z :=
        F₁.compat p₁ hp₁ q hqW.1 z ⟨hz.1.1, hOq_sub1 hz⟩
      have hc2 : F₂.num p₂ z * F₂.den q z = F₂.num q z * F₂.den p₂ z :=
        F₂.compat p₂ hp₂ q hqW.2 z ⟨hz.1.2, hOq_sub2 hz⟩
      have hc0 : F₁.num q z * F₂.den q z = F₂.num q z * F₁.den q z :=
        hEq.2 q hqW z hz.2
      dsimp only [h_diff]
      linear_combination F₂.den p₂ z * F₂.den q z * hc1 -
        F₁.den p₁ z * F₁.den q z * hc2 +
        F₁.den p₁ z * F₂.den p₂ z * hc0
    have hcont1 : ContinuousOn (fun z => h_diff z * F₁.den q z) Oq :=
      (hh_holo.mul ((F₁.den_holo q hqW.1).mono hOq_sub1)).continuousOn
    have hstep1 : ∀ z ∈ Oq, h_diff z * F₁.den q z = 0 :=
      hCancelDen F₂ hqW.2 hOq_open hOq_sub2 hcont1 hmul_eq
    have hstep2 : ∀ z ∈ Oq, h_diff z = 0 :=
      hCancelDen F₁ hqW.1 hOq_open hOq_sub1 hh_holo.continuousOn hstep1
    exact sub_eq_zero.mp (hstep2 q hq_mem)

  
  let s_base : ℝ := collarBaseS hDet
  let r_base : ℝ := collarBaseR hDet
  let B : Set ℂ := Metric.ball (0 : ℂ) r_base
  let U_base2 : Set (ℂ × ℂ) := { p : ℂ × ℂ | |p.1.im| < 2 * s_base ∧ ‖p.2‖ < r_base }

  have hs_pos : 0 < s_base := hDet.s_det_pos
  have hr_pos : 0 < r_base := lt_min hDet.r_det_pos (half_pos Real.pi_pos)
  have hr_le_det : r_base ≤ hDet.r_det := min_le_left _ _
  have hs_le_s₁ : s_base ≤ C.s₁ / 4 := hDet.s_det_le_s₁
  have hr_lt_s4 : r_base < s_base / 4 := lt_of_le_of_lt hr_le_det hDet.r_det_lt_s_det
  have hr_lt_r₁_half : r_base < C.r₁ / 2 := lt_of_le_of_lt hr_le_det hDet.r_det_lt_r₁
  have hr₁_pos : 0 < C.r₁ := C.r₁_pos
  have hs₁_pos : 0 < C.s₁ := lt_trans C.r₁_pos C.r₁_lt_s₁

  have hU_base2_open : IsOpen U_base2 :=
    (isOpen_lt (continuous_abs.comp (Complex.continuous_im.comp continuous_fst))
      continuous_const).inter
      (isOpen_lt (continuous_norm.comp continuous_snd) continuous_const)

  have hBaseSubDet : U_base2 ⊆
      { p : ℂ × ℂ | |p.1.im| < 2 * hDet.s_det ∧ ‖p.2‖ < 2 * hDet.r_det } := by
    intro p hp
    exact ⟨hp.1, by linarith [hp.2, hr_le_det, hDet.r_det_pos]⟩

  let F_L : Fin 2 → ℂ × ℂ → ℂ := fun i p => glancingDualLine C p.1 p.2 i
  let F_X : Fin 2 → ℂ × ℂ → ℂ := fun i p => glancingImpact C p.1 p.2 i

  have hFL_holo : ∀ i : Fin 2, DifferentiableOn ℂ (F_L i) U_base2 :=
    fun i => (hDet.dualLine_holo i).mono hBaseSubDet
  have hFX_holo : ∀ i : Fin 2, DifferentiableOn ℂ (F_X i) U_base2 :=
    fun i => (hDet.impact_holo i).mono hBaseSubDet

  have hShiftTheta : ∀ {y t c : ℂ}, |y.im| < 2 * s_base → ‖t‖ < r_base → ‖c‖ ≤ ‖t‖ →
      glancingTheta C (y + c) (-t) = glancingTheta C (y + c) t ∧
      glancingTheta C (y + c) t ∈ horizStrip (2 * C.s_h) ∧
      glancingTheta C (starRingEnd ℂ (y + c)) (starRingEnd ℂ t) =
        starRingEnd ℂ (glancingTheta C (y + c) t) := by
    intro y t c hy ht hc
    have him_c : |c.im| ≤ ‖t‖ := (Complex.abs_im_le_norm c).trans hc
    have him_yc : |(y + c).im| < C.s₁ := by
      rw [Complex.add_im]
      linarith [abs_add_le y.im c.im]
    have ht_r₁ : ‖t‖ < C.r₁ := by linarith
    have hU_mem : C.U (y + c, t) ∈ horizStrip (2 * C.s₀) :=
      C.U_maps_to (y + c) t (by linarith) ht_r₁
    refine ⟨?_, C.ϕ_ℂ_maps_to (C.U (y + c, t)) hU_mem, ?_⟩
    · unfold glancingTheta
      rw [C.U_even (y + c) t (by linarith) ht_r₁]
    · unfold glancingTheta
      rw [C.U_conj (y + c) t (by linarith) ht_r₁, C.ϕ_ℂ_conj (C.U (y + c, t)) hU_mem]

  have hMidStrip : ∀ {z₁ z₂ : ℂ},
      z₁ ∈ horizStrip (2 * C.s_h) → z₂ ∈ horizStrip (2 * C.s_h) →
      (z₁ + z₂) / 2 ∈ horizStrip (2 * C.s_h) := by
    intro z₁ z₂ hz₁ hz₂
    change |((z₁ + z₂) / 2).im| < 2 * C.s_h
    have him : ((z₁ + z₂) / 2).im = (z₁.im + z₂.im) / 2 := by simp [Complex.add_im]
    rw [him, abs_div, abs_of_pos (by norm_num : (0 : ℝ) < 2)]
    have h1 : |z₁.im| < 2 * C.s_h := hz₁
    have h2 : |z₂.im| < 2 * C.s_h := hz₂
    linarith [abs_add_le z₁.im z₂.im]

  have hDerivHConj : ∀ μ ∈ horizStrip (2 * C.s_h),
      deriv C.h_ℂ (starRingEnd ℂ μ) = starRingEnd ℂ (deriv C.h_ℂ μ) :=
    hDerivConjStrip (2 * C.s_h) C.h_ℂ C.h_ℂ_holo C.h_ℂ_conj

  have hFX_even : ∀ i : Fin 2, ∀ p ∈ U_base2, F_X i (p.1, -p.2) = F_X i p := by
    intro i ⟨y, t⟩ ⟨hy, ht⟩
    have hhalf : ‖t / 2‖ ≤ ‖t‖ := by
      rw [norm_div, Complex.norm_ofNat]
      linarith [norm_nonneg t]
    have h_m : glancingTheta C (y + -(t / 2)) (-t) = glancingTheta C (y + -(t / 2)) t :=
      (hShiftTheta hy ht (by rwa [norm_neg] : ‖-(t / 2)‖ ≤ ‖t‖)).1
    have h_p : glancingTheta C (y + (t / 2)) (-t) = glancingTheta C (y + (t / 2)) t :=
      (hShiftTheta hy ht hhalf).1
    have hmid : glancingMidAngle C y (-t) = glancingMidAngle C y t := by
      unfold glancingMidAngle
      have ha : y - (-t) / 2 = y + (t / 2) := by ring
      have hb : y + (-t) / 2 = y + -(t / 2) := by ring
      have hc : y - t / 2 = y + -(t / 2) := by ring
      rw [ha, hb, hc, h_p, h_m, add_comm]
    dsimp only [F_X, glancingImpact]
    rw [hmid]

  have hFL_even : ∀ i : Fin 2, ∀ p ∈ U_base2, F_L i (p.1, -p.2) = F_L i p := by
    intro i ⟨y, t⟩ ⟨hy, ht⟩
    have h0 : glancingTheta C y (-t) = glancingTheta C y t := by
      simpa using (hShiftTheta hy ht (by simp : ‖(0 : ℂ)‖ ≤ ‖t‖)).1
    have hm : glancingTheta C (y - t) (-t) = glancingTheta C (y - t) t := by
      simpa [sub_eq_add_neg] using (hShiftTheta hy ht (by rw [norm_neg])).1
    have hoff : glancingOffset C y (-t) = glancingOffset C y t := by
      have hstat := C.glancing_stationary y t (by linarith) (by linarith)
      unfold glancingOffset
      have h_yn : y + -t = y - t := by ring
      rw [h_yn, h0, hm]
      set θ_m : ℂ := glancingTheta C (y - t) t
      set θ_0 : ℂ := glancingTheta C y t
      set θ_p : ℂ := glancingTheta C (y + t) t
      have hact : -supportAction1_ℂ C.h_ℂ θ_0 θ_m = supportAction2_ℂ C.h_ℂ θ_m θ_0 := by
        unfold supportAction1_ℂ supportAction2_ℂ
        have h1 : (θ_0 + θ_m) / 2 = (θ_m + θ_0) / 2 := by ring
        have h2 : (θ_m - θ_0) / 2 = -((θ_0 - θ_m) / 2) := by ring
        rw [h1, h2, Complex.sin_neg, Complex.cos_neg]
        ring
      rw [hact]
      exact hstat.symm
    dsimp only [F_L, glancingDualLine]
    rw [h0, hoff]

  have hFX_conj : ∀ i : Fin 2, ∀ p ∈ U_base2,
      F_X i (starRingEnd ℂ p.1, starRingEnd ℂ p.2) = starRingEnd ℂ (F_X i p) := by
    intro i ⟨y, t⟩ ⟨hy, ht⟩
    have hhalf : ‖t / 2‖ ≤ ‖t‖ := by
      rw [norm_div, Complex.norm_ofNat]
      linarith [norm_nonneg t]
    obtain ⟨_, hm_strip, hm_conj⟩ := hShiftTheta hy ht (by rwa [norm_neg] : ‖-(t / 2)‖ ≤ ‖t‖)
    obtain ⟨_, hp_strip, hp_conj⟩ := hShiftTheta hy ht hhalf
    have hμ_strip : glancingMidAngle C y t ∈ horizStrip (2 * C.s_h) := by
      unfold glancingMidAngle
      have hc : y - t / 2 = y + -(t / 2) := by ring
      rw [hc]
      exact hMidStrip hm_strip hp_strip
    have hμ_conj : glancingMidAngle C (starRingEnd ℂ y) (starRingEnd ℂ t) =
        starRingEnd ℂ (glancingMidAngle C y t) := by
      unfold glancingMidAngle
      have ha : starRingEnd ℂ y - starRingEnd ℂ t / 2 = starRingEnd ℂ (y + -(t / 2)) := by
        simp [sub_eq_add_neg, map_ofNat]
      have hb : starRingEnd ℂ y + starRingEnd ℂ t / 2 = starRingEnd ℂ (y + t / 2) := by
        simp [map_ofNat]
      have hc : y - t / 2 = y + -(t / 2) := by ring
      rw [ha, hb, hc, hm_conj, hp_conj]
      simp [map_ofNat]
    revert i
    refine Fin.forall_fin_two.mpr ⟨?_, ?_⟩ <;>
    · dsimp only [F_X, glancingImpact]
      simp only [Matrix.cons_val_zero, Matrix.cons_val_one, hμ_conj,
        C.h_ℂ_conj _ hμ_strip, hDerivHConj _ hμ_strip,
        Complex.cos_conj, Complex.sin_conj, map_sub, map_add, map_mul]

  have hFL_conj : ∀ i : Fin 2, ∀ p ∈ U_base2,
      F_L i (starRingEnd ℂ p.1, starRingEnd ℂ p.2) = starRingEnd ℂ (F_L i p) := by
    intro i ⟨y, t⟩ ⟨hy, ht⟩
    obtain ⟨_, h0_strip, h0_conj⟩ := hShiftTheta hy ht (by simp : ‖(0 : ℂ)‖ ≤ ‖t‖)
    obtain ⟨_, hp_strip, hp_conj⟩ := hShiftTheta hy ht (le_rfl : ‖t‖ ≤ ‖t‖)
    simp only [add_zero] at h0_strip h0_conj
    set θ_0 : ℂ := glancingTheta C y t
    set θ_p : ℂ := glancingTheta C (y + t) t
    have hμ_strip : (θ_0 + θ_p) / 2 ∈ horizStrip (2 * C.s_h) := hMidStrip h0_strip hp_strip
    have hoff_conj : glancingOffset C (starRingEnd ℂ y) (starRingEnd ℂ t) =
        starRingEnd ℂ (glancingOffset C y t) := by
      unfold glancingOffset supportAction1_ℂ
      have hy_add : starRingEnd ℂ y + starRingEnd ℂ t = starRingEnd ℂ (y + t) := by simp
      rw [hy_add, h0_conj, hp_conj]
      have hm : (starRingEnd ℂ θ_0 + starRingEnd ℂ θ_p) / 2 =
          starRingEnd ℂ ((θ_0 + θ_p) / 2) := by simp [map_ofNat]
      have hd : (starRingEnd ℂ θ_p - starRingEnd ℂ θ_0) / 2 =
          starRingEnd ℂ ((θ_p - θ_0) / 2) := by simp [map_ofNat]
      rw [hm, hd, C.h_ℂ_conj _ hμ_strip, hDerivHConj _ hμ_strip,
        Complex.sin_conj, Complex.cos_conj]
      simp [θ_0, θ_p]
    revert i
    refine Fin.forall_fin_two.mpr ⟨?_, ?_⟩ <;>
    · dsimp only [F_L, glancingDualLine]
      simp only [Matrix.cons_val_zero, Matrix.cons_val_one, h0_conj, hoff_conj,
        Complex.cos_conj, Complex.sin_conj, map_div₀, θ_0]

  
  let cyl (a c : ℝ) (t_c : ℂ) (δ : ℝ) : Set (ℂ × ℂ) :=
    { y' : ℂ | a < y'.im ∧ y'.im < c } ×ˢ Metric.ball t_c δ
  have hCylOpen : ∀ a c : ℝ, ∀ t_c : ℂ, ∀ δ : ℝ, IsOpen (cyl a c t_c δ) :=
    fun a c t_c δ =>
      ((isOpen_lt continuous_const Complex.continuous_im).inter
        (isOpen_lt Complex.continuous_im continuous_const)).prod Metric.isOpen_ball
  have hBaseCylEq : ∀ (t_c : ℂ) (δ : ℝ),
      ({ y' : ℂ | |y'.im| < s_base } ×ˢ Metric.ball t_c δ) = cyl (-s_base) s_base t_c δ := by
    intro t_c δ
    ext ⟨y', t'⟩
    simp [cyl, abs_lt]
  have hU_base2_eq : U_base2 = cyl (-2 * s_base) (2 * s_base) 0 r_base := by
    ext ⟨y', t'⟩
    simp only [U_base2, cyl, Set.mem_setOf_eq, Set.mem_prod, Metric.mem_ball, dist_zero_right]
    constructor
    · rintro ⟨hy, ht⟩
      have habs := abs_lt.mp hy
      exact ⟨⟨by linarith [habs.1], habs.2⟩, ht⟩
    · rintro ⟨⟨h1, h2⟩, ht⟩
      exact ⟨abs_lt.mpr ⟨by linarith, h2⟩, ht⟩

  have hEngine : ∀ (F_init : Fin 2 → ℂ × ℂ → ℂ),
      (∀ i : Fin 2, DifferentiableOn ℂ (F_init i) U_base2) →
      (∀ i : Fin 2, ∀ p ∈ U_base2, F_init i (p.1, -p.2) = F_init i p) →
      (∀ i : Fin 2, ∀ p ∈ U_base2,
        F_init i (starRingEnd ℂ p.1, starRingEnd ℂ p.2) = starRingEnd ℂ (F_init i p)) →
      let h_F := meroStripWidth s_base r_base F_init
      (∀ t ∈ B, ENNReal.ofReal (2 * s_base) ≤ h_F t) ∧
      (∀ t ∈ B, h_F (-t) = h_F t) ∧
      LowerSemicontinuousOn h_F B ∧
      ∃ M_F : Fin 2 → MeroOn2D (meroTubeENNR r_base h_F),
        ∀ i : Fin 2, MeroAgreesHolo (M_F i) (F_init i) U_base2 := by
    intro F_init hF_holo hF_even hF_conj
    let h_F : ℂ → ENNReal := meroStripWidth s_base r_base F_init

    
    have hWitnessBall : ∀ {t₀ : ℂ} {b δ : ℝ},
        s_base < b → 0 < δ → Metric.ball t₀ δ ⊆ B →
        ∀ (G : Fin 2 → MeroOn2D (cyl (-s_base) b t₀ δ)),
        (∀ i : Fin 2, MeroAgreesHolo (G i) (F_init i)
          ({ y : ℂ | |y.im| < s_base } ×ˢ Metric.ball t₀ δ)) →
        ∀ t' ∈ Metric.ball t₀ δ, ENNReal.ofReal b ≤ h_F t' := by
      intro t₀ b δ hb hδ hballB G hG t' ht'
      let δ' : ℝ := δ - dist t' t₀
      have hδ' : 0 < δ' := sub_pos.mpr (Metric.mem_ball.mp ht')
      have hsub_ball : Metric.ball t' δ' ⊆ Metric.ball t₀ δ := by
        intro w hw
        rw [Metric.mem_ball] at hw ⊢
        linarith [dist_triangle w t' t₀]
      have hsub_cyl : cyl (-s_base) b t' δ' ⊆ cyl (-s_base) b t₀ δ :=
        fun p hp => ⟨hp.1, hsub_ball hp.2⟩
      let G' : Fin 2 → MeroOn2D (cyl (-s_base) b t' δ') :=
        fun i => meroRestrict (G i) (hCylOpen (-s_base) b t' δ') hsub_cyl
      have hG'_agrees : ∀ i : Fin 2, MeroAgreesHolo (G' i) (F_init i)
          ({ y : ℂ | |y.im| < s_base } ×ˢ Metric.ball t' δ') := by
        intro i
        have hOpen_base : IsOpen ({ y : ℂ | |y.im| < s_base } ×ˢ Metric.ball t' δ') := by
          rw [hBaseCylEq]
          exact hCylOpen (-s_base) s_base t' δ'
        refine meroRestrict_agrees (G i) (hCylOpen (-s_base) b t' δ') hsub_cyl (hG i)
          hOpen_base (fun p hp => ⟨hp.1, hsub_ball hp.2⟩) ?_
        intro p hp
        have habs := abs_lt.mp (show |p.1.im| < s_base from hp.1)
        exact ⟨⟨habs.1, lt_trans habs.2 hb⟩, hp.2⟩
      have hwit : IsCollarHeightWitness s_base r_base F_init t' b :=
        ⟨hb, δ', hδ', hsub_ball.trans hballB, G', hG'_agrees⟩
      exact le_sSup ⟨b, hwit, rfl⟩

    
    have h_ge_two : ∀ t ∈ B, ENNReal.ofReal (2 * s_base) ≤ h_F t := by
      intro t ht
      have ht_norm : ‖t‖ < r_base := by simpa [B, Metric.mem_ball, dist_zero_right] using ht
      let δ : ℝ := r_base - ‖t‖
      have hδ : 0 < δ := sub_pos.mpr ht_norm
      have hballB : Metric.ball t δ ⊆ B := by
        intro w hw
        rw [Metric.mem_ball, dist_zero_right]
        have hdist : ‖w - t‖ < δ := by simpa [Metric.mem_ball, dist_eq_norm] using hw
        calc ‖w‖ = ‖(w - t) + t‖ := by ring_nf
          _ ≤ ‖w - t‖ + ‖t‖ := norm_add_le _ _
          _ < δ + ‖t‖ := by linarith
          _ = r_base := sub_add_cancel _ _
      have hW₀_sub : cyl (-s_base) (2 * s_base) t δ ⊆ U_base2 := by
        intro p hp
        refine ⟨abs_lt.mpr ⟨by linarith [hp.1.1, hs_pos], hp.1.2⟩, ?_⟩
        simpa [B, Metric.mem_ball, dist_zero_right] using hballB hp.2
      let G₀ : Fin 2 → MeroOn2D (cyl (-s_base) (2 * s_base) t δ) :=
        fun i => holoToMero2D (hCylOpen (-s_base) (2 * s_base) t δ) ((hF_holo i).mono hW₀_sub)
      have hG₀_agrees : ∀ i : Fin 2, MeroAgreesHolo (G₀ i) (F_init i)
          ({ y : ℂ | |y.im| < s_base } ×ˢ Metric.ball t δ) := by
        intro i
        have hOpen_base : IsOpen ({ y : ℂ | |y.im| < s_base } ×ˢ Metric.ball t δ) := by
          rw [hBaseCylEq]
          exact hCylOpen (-s_base) s_base t δ
        refine holoToMero2D_agrees (hCylOpen (-s_base) (2 * s_base) t δ) hOpen_base ?_
          ((hF_holo i).mono hW₀_sub)
        intro p hp
        have habs := abs_lt.mp (show |p.1.im| < s_base from hp.1)
        exact ⟨⟨habs.1, by linarith [habs.2, hs_pos]⟩, hp.2⟩
      have hwit : IsCollarHeightWitness s_base r_base F_init t (2 * s_base) :=
        ⟨by linarith, δ, hδ, hballB, G₀, hG₀_agrees⟩
      exact le_sSup ⟨2 * s_base, hwit, rfl⟩

    
    have h_lsc : LowerSemicontinuousOn h_F B := by
      rw [lowerSemicontinuousOn_iff_preimage_Ioi]
      intro c_val
      let u : Set ℂ := B ∩ h_F ⁻¹' Set.Ioi c_val
      refine ⟨u, ?_, by ext z; simp [u]⟩
      rw [Metric.isOpen_iff]
      rintro t₀ ⟨_, hc_lt⟩
      rw [Set.mem_preimage, Set.mem_Ioi] at hc_lt
      obtain ⟨x, ⟨b, ⟨hb, δ, hδ, hballB, G, hG⟩, rfl⟩, hc_lt_b⟩ := lt_sSup_iff.mp hc_lt
      refine ⟨δ, hδ, fun t' ht' => ⟨hballB ht', ?_⟩⟩
      exact lt_of_lt_of_le hc_lt_b (hWitnessBall hb hδ hballB G hG t' ht')

    
    have h_even : ∀ t ∈ B, h_F (-t) = h_F t := by
      let ι : ℂ × ℂ → ℂ × ℂ := fun p => (p.1, -p.2)
      have hι_inv : ∀ p : ℂ × ℂ, ι (ι p) = p := fun p => by ext <;> simp [ι]
      have hι_diff : Differentiable ℂ ι := differentiable_fst.prodMk differentiable_snd.neg
      have hι_dist : ∀ p q : ℂ × ℂ, dist (ι p) (ι q) = dist p q := by
        intro p q
        simp [ι, Prod.dist_eq, dist_neg_neg]
      have hWitNeg : ∀ (t : ℂ) (b : ℝ),
          IsCollarHeightWitness s_base r_base F_init t b →
          IsCollarHeightWitness s_base r_base F_init (-t) b := by
        rintro t b ⟨hb, δ, hδ, hballB, G, hG⟩
        have hball_neg_iff : ∀ w : ℂ, w ∈ Metric.ball (-t) δ ↔ -w ∈ Metric.ball t δ := by
          intro w
          simp only [Metric.mem_ball]
          have hd : dist (-w) t = dist w (-t) := by simpa using dist_neg_neg w (-t)
          rw [hd]
        have hballB_neg : Metric.ball (-t) δ ⊆ B := by
          intro w hw
          have hnw : -w ∈ B := hballB ((hball_neg_iff w).mp hw)
          simpa [B, Metric.mem_ball, dist_zero_right] using hnw
        have hmem_cyl : ∀ p : ℂ × ℂ,
            p ∈ cyl (-s_base) b (-t) δ ↔ ι p ∈ cyl (-s_base) b t δ := by
          intro p
          simp only [cyl, ι, Set.mem_prod, hball_neg_iff]
        let G_neg : Fin 2 → MeroOn2D (cyl (-s_base) b (-t) δ) := fun i =>
          { rad := fun p => (G i).rad (ι p)
            num := fun p q => (G i).num (ι p) (ι q)
            den := fun p q => (G i).den (ι p) (ι q)
            rad_pos := fun p hp => (G i).rad_pos (ι p) ((hmem_cyl p).mp hp)
            ball_sub := fun p hp q hq => by
              have hιq : ι q ∈ Metric.ball (ι p) ((G i).rad (ι p)) := by
                rw [Metric.mem_ball, hι_dist]; exact hq
              exact (hmem_cyl q).mpr ((G i).ball_sub (ι p) ((hmem_cyl p).mp hp) hιq)
            num_holo := fun p hp =>
              ((G i).num_holo (ι p) ((hmem_cyl p).mp hp)).comp hι_diff.differentiableOn
                (fun q hq => by rw [Metric.mem_ball, hι_dist]; exact hq)
            den_holo := fun p hp =>
              ((G i).den_holo (ι p) ((hmem_cyl p).mp hp)).comp hι_diff.differentiableOn
                (fun q hq => by rw [Metric.mem_ball, hι_dist]; exact hq)
            den_ne_zero := fun p hp => by
              obtain ⟨q₀, hq₀, hne⟩ := (G i).den_ne_zero (ι p) ((hmem_cyl p).mp hp)
              refine ⟨ι q₀, ?_, ?_⟩
              · rw [Metric.mem_ball, ← hι_dist, hι_inv]
                exact hq₀
              · simpa [hι_inv] using hne
            compat := fun p₁ hp₁ p₂ hp₂ q hq =>
              (G i).compat (ι p₁) ((hmem_cyl p₁).mp hp₁) (ι p₂) ((hmem_cyl p₂).mp hp₂) (ι q)
                ⟨by rw [Metric.mem_ball, hι_dist]; exact hq.1,
                 by rw [Metric.mem_ball, hι_dist]; exact hq.2⟩ }
        refine ⟨hb, δ, hδ, hballB_neg, G_neg, fun i => ?_⟩
        refine ⟨fun p hp => ⟨⟨(abs_lt.mp hp.1).1, lt_trans (abs_lt.mp hp.1).2 hb⟩, hp.2⟩,
          fun p hp => ?_⟩
        have hιp_base : ι p ∈ { y : ℂ | |y.im| < s_base } ×ˢ Metric.ball t δ :=
          ⟨hp.1, (hball_neg_iff p.2).mp hp.2⟩
        obtain ⟨r, hr, hr_le, hr_sub, hr_eq⟩ := (hG i).2 (ι p) hιp_base
        refine ⟨r, hr, hr_le, fun q hq => ?_, fun q hq => ?_⟩
        · have hιq : ι q ∈ Metric.ball (ι p) r := by rw [Metric.mem_ball, hι_dist]; exact hq
          have hmem := hr_sub hιq
          exact ⟨hmem.1, (hball_neg_iff q.2).mpr hmem.2⟩
        · have hιq : ι q ∈ Metric.ball (ι p) r := by rw [Metric.mem_ball, hι_dist]; exact hq
          have hmem := hr_sub hιq
          have hq_base2 : q ∈ U_base2 := by
            have hq1_im : |q.1.im| < s_base := hmem.1
            refine ⟨by linarith [hq1_im, hs_pos], ?_⟩
            have hq2B : q.2 ∈ B := hballB_neg ((hball_neg_iff q.2).mpr hmem.2)
            simpa [B, Metric.mem_ball, dist_zero_right] using hq2B
          have heq := hr_eq (ι q) hιq
          have hF_eq : F_init i (ι q) = F_init i q := hF_even i q hq_base2
          rw [hF_eq] at heq
          exact heq
      intro t _
      have hset : { x : ENNReal | ∃ b : ℝ,
            IsCollarHeightWitness s_base r_base F_init (-t) b ∧ x = ENNReal.ofReal b } =
          { x : ENNReal | ∃ b : ℝ,
            IsCollarHeightWitness s_base r_base F_init t b ∧ x = ENNReal.ofReal b } := by
        ext x
        constructor
        · rintro ⟨b, hw, rfl⟩
          exact ⟨b, by simpa using hWitNeg (-t) b hw, rfl⟩
        · rintro ⟨b, hw, rfl⟩
          exact ⟨b, hWitNeg t b hw, rfl⟩
      dsimp only [h_F, meroStripWidth]
      rw [hset]

    
    let T_F : Set (ℂ × ℂ) := meroTubeENNR r_base h_F
    have hdist_star : ∀ p q : ℂ × ℂ, dist (star p) (star q) = dist p q := by
      intro p q
      rw [dist_eq_norm, dist_eq_norm, ← star_sub, norm_star]
    have hdist_conj_C : ∀ z w : ℂ,
        dist (starRingEnd ℂ z) (starRingEnd ℂ w) = dist z w := by
      intro z w
      simp only [← Complex.star_def, dist_eq_norm, ← star_sub, norm_star]
    have hF_star : ∀ i : Fin 2, ∀ q ∈ U_base2, F_init i (star q) = star (F_init i q) := by
      intro i q hq
      simp only [Prod.star_def, Complex.star_def]
      exact hF_conj i q hq

    have hU_base2_sub_TF : U_base2 ⊆ T_F := by
      rintro ⟨y, t⟩ ⟨hy, ht⟩
      have habs := abs_lt.mp hy
      have htB : t ∈ B := by simpa [B, Metric.mem_ball, dist_zero_right] using ht
      have hctB : starRingEnd ℂ t ∈ B := by
        simpa [B, Metric.mem_ball, dist_zero_right, Complex.norm_conj] using ht
      refine ⟨ht, ?_, ?_⟩
      · exact lt_of_lt_of_le
          ((ENNReal.ofReal_lt_ofReal_iff (by positivity)).mpr (by linarith [habs.1]))
          (h_ge_two (starRingEnd ℂ t) hctB)
      · exact lt_of_lt_of_le
          ((ENNReal.ofReal_lt_ofReal_iff (by positivity)).mpr habs.2)
          (h_ge_two t htB)

    let ChartPkg : Type := Σ (a : ℝ) (c : ℝ) (t_c : ℂ) (δ : ℝ), MeroOn2D (cyl a c t_c δ)

    have hChart : ∀ (i : Fin 2), ∀ p ∈ T_F, ∃ S : ChartPkg,
        S.1 ≤ -s_base ∧ s_base ≤ S.2.1 ∧ 0 < S.2.2.2.1 ∧
        p ∈ cyl S.1 S.2.1 S.2.2.1 S.2.2.2.1 ∧
        cyl S.1 S.2.1 S.2.2.1 S.2.2.2.1 ⊆ T_F ∧
        MeroAgreesHolo S.2.2.2.2 (F_init i) (cyl (-s_base) s_base S.2.2.1 S.2.2.2.1) ∧
        (|p.1.im| < 2 * s_base →
          Metric.ball p (S.2.2.2.2.rad p) ⊆ U_base2 ∧
          ∀ q ∈ Metric.ball p (S.2.2.2.2.rad p),
            S.2.2.2.2.num p q = F_init i q * S.2.2.2.2.den p q) := by
      intro i ⟨y, t⟩ ⟨ht_norm, h_low, h_high⟩
      by_cases h1 : |y.im| < 2 * s_base
      · 
        have hf_cyl : DifferentiableOn ℂ (F_init i) (cyl (-2 * s_base) (2 * s_base) 0 r_base) := by
          rw [← hU_base2_eq]; exact hF_holo i
        let M₀ : MeroOn2D (cyl (-2 * s_base) (2 * s_base) 0 r_base) :=
          holoToMero2D (hCylOpen (-2 * s_base) (2 * s_base) 0 r_base) hf_cyl
        have hp_cyl : (y, t) ∈ cyl (-2 * s_base) (2 * s_base) 0 r_base := by
          rw [← hU_base2_eq]; exact ⟨h1, ht_norm⟩
        refine ⟨⟨-2 * s_base, 2 * s_base, 0, r_base, M₀⟩,
          by linarith, by linarith, hr_pos, hp_cyl,
          by rw [← hU_base2_eq]; exact hU_base2_sub_TF,
          holoToMero2D_agrees (hCylOpen (-2 * s_base) (2 * s_base) 0 r_base)
            (hCylOpen (-s_base) s_base 0 r_base)
            (fun q hq => ⟨⟨by linarith [hq.1.1], by linarith [hq.1.2]⟩, hq.2⟩) hf_cyl,
          fun _ => ⟨by rw [hU_base2_eq]; exact M₀.ball_sub (y, t) hp_cyl,
            fun q _ => (mul_one (F_init i q)).symm⟩⟩
      · by_cases h2 : 0 ≤ y.im
        · 
          obtain ⟨x, ⟨b_p, ⟨hb_p, δ_p, hδ_p, hballB, G_p, hG_p⟩, rfl⟩, hy_lt_b⟩ :=
            lt_sSup_iff.mp h_high
          have hb_pos : 0 < b_p := lt_trans hs_pos hb_p
          have hy_lt : y.im < b_p := (ENNReal.ofReal_lt_ofReal_iff hb_pos).mp hy_lt_b
          refine ⟨⟨-s_base, b_p, t, δ_p, G_p i⟩,
            le_rfl, le_of_lt hb_p, hδ_p,
            ⟨⟨by linarith, hy_lt⟩, Metric.mem_ball_self hδ_p⟩,
            ?_, ?_, fun h => absurd h h1⟩
          · rintro ⟨y', t'⟩ ⟨⟨hy'1, hy'2⟩, ht'⟩
            have ht'B : t' ∈ B := hballB ht'
            have ht'_norm : ‖t'‖ < r_base := by
              simpa [B, Metric.mem_ball, dist_zero_right] using ht'B
            have hct'B : starRingEnd ℂ t' ∈ B := by
              simpa [B, Metric.mem_ball, dist_zero_right, Complex.norm_conj] using ht'_norm
            refine ⟨ht'_norm, ?_, ?_⟩
            · exact lt_of_lt_of_le
                ((ENNReal.ofReal_lt_ofReal_iff (by positivity)).mpr (by linarith))
                (h_ge_two (starRingEnd ℂ t') hct'B)
            · exact lt_of_lt_of_le
                ((ENNReal.ofReal_lt_ofReal_iff hb_pos).mpr hy'2)
                (hWitnessBall hb_p hδ_p hballB G_p hG_p t' ht')
          · rw [← hBaseCylEq]
            exact hG_p i
        · 
          have hy_neg : y.im < 0 := not_le.mp h2
          obtain ⟨x, ⟨b_p, ⟨hb_p, δ_p, hδ_p, hballB, G_p, hG_p⟩, rfl⟩, hny_lt_b⟩ :=
            lt_sSup_iff.mp h_low
          have hb_pos : 0 < b_p := lt_trans hs_pos hb_p
          have hny_lt : -y.im < b_p := (ENNReal.ofReal_lt_ofReal_iff hb_pos).mp hny_lt_b
          have hball_conj_iff : ∀ w : ℂ,
              w ∈ Metric.ball t δ_p ↔ starRingEnd ℂ w ∈ Metric.ball (starRingEnd ℂ t) δ_p := by
            intro w
            simp only [Metric.mem_ball, hdist_conj_C]
          have hmem_low : ∀ q : ℂ × ℂ,
              q ∈ cyl (-b_p) s_base t δ_p ↔ star q ∈ cyl (-s_base) b_p (starRingEnd ℂ t) δ_p := by
            rintro ⟨y', t'⟩
            simp only [cyl, Prod.star_def, Complex.star_def, Set.mem_prod, Set.mem_setOf_eq,
              Complex.conj_im, ← hball_conj_iff]
            constructor
            · rintro ⟨⟨h_a, h_b⟩, ht'⟩
              exact ⟨⟨by linarith, by linarith⟩, ht'⟩
            · rintro ⟨⟨h_a, h_b⟩, ht'⟩
              exact ⟨⟨by linarith, by linarith⟩, ht'⟩
          let G_low : MeroOn2D (cyl (-b_p) s_base t δ_p) :=
            { rad := fun q => (G_p i).rad (star q)
              num := fun q z => star ((G_p i).num (star q) (star z))
              den := fun q z => star ((G_p i).den (star q) (star z))
              rad_pos := fun q hq => (G_p i).rad_pos (star q) ((hmem_low q).mp hq)
              ball_sub := fun q hq z hz => by
                have hsz : star z ∈ Metric.ball (star q) ((G_p i).rad (star q)) := by
                  rw [Metric.mem_ball, hdist_star]; exact hz
                exact (hmem_low z).mpr ((G_p i).ball_sub (star q) ((hmem_low q).mp hq) hsz)
              num_holo := fun q hq =>
                (hHoloStarStar Metric.isOpen_ball
                  ((G_p i).num_holo (star q) ((hmem_low q).mp hq))).mono
                  (fun z hz => by change star z ∈ Metric.ball _ _; rw [Metric.mem_ball, hdist_star]; exact hz)
              den_holo := fun q hq =>
                (hHoloStarStar Metric.isOpen_ball
                  ((G_p i).den_holo (star q) ((hmem_low q).mp hq))).mono
                  (fun z hz => by change star z ∈ Metric.ball _ _; rw [Metric.mem_ball, hdist_star]; exact hz)
              den_ne_zero := fun q hq => by
                obtain ⟨z₀, hz₀, hne⟩ := (G_p i).den_ne_zero (star q) ((hmem_low q).mp hq)
                refine ⟨star z₀, ?_, ?_⟩
                · rw [Metric.mem_ball, ← hdist_star, star_star]
                  exact Metric.mem_ball.mp hz₀
                · rw [star_star]
                  exact star_ne_zero.mpr hne
              compat := fun q₁ hq₁ q₂ hq₂ z hz => by
                have hc := (G_p i).compat (star q₁) ((hmem_low q₁).mp hq₁)
                  (star q₂) ((hmem_low q₂).mp hq₂) (star z)
                  ⟨by rw [Metric.mem_ball, hdist_star]; exact hz.1,
                   by rw [Metric.mem_ball, hdist_star]; exact hz.2⟩
                have hsc := congr_arg star hc
                simpa only [star_mul, mul_comm] using hsc }
          refine ⟨⟨-b_p, s_base, t, δ_p, G_low⟩,
            by linarith, le_rfl, hδ_p,
            ⟨⟨by linarith, by linarith⟩, Metric.mem_ball_self hδ_p⟩,
            ?_, ?_, fun h => absurd h h1⟩
          · rintro ⟨y', t'⟩ ⟨⟨hy'1, hy'2⟩, ht'⟩
            have hct' : starRingEnd ℂ t' ∈ Metric.ball (starRingEnd ℂ t) δ_p :=
              (hball_conj_iff t').mp ht'
            have hct'B : starRingEnd ℂ t' ∈ B := hballB hct'
            have ht'_norm : ‖t'‖ < r_base := by
              simpa [B, Metric.mem_ball, dist_zero_right, Complex.norm_conj] using hct'B
            have ht'B : t' ∈ B := by simpa [B, Metric.mem_ball, dist_zero_right] using ht'_norm
            refine ⟨ht'_norm, ?_, ?_⟩
            · exact lt_of_lt_of_le
                ((ENNReal.ofReal_lt_ofReal_iff hb_pos).mpr (by linarith))
                (hWitnessBall hb_p hδ_p hballB G_p hG_p (starRingEnd ℂ t') hct')
            · exact lt_of_lt_of_le
                ((ENNReal.ofReal_lt_ofReal_iff (by positivity)).mpr (by linarith))
                (h_ge_two t' ht'B)
          · refine ⟨fun q hq => ⟨⟨lt_trans (neg_lt_neg hb_p) hq.1.1, hq.1.2⟩, hq.2⟩,
              fun q hq => ?_⟩
            have hsq_base : star q ∈ { y' : ℂ | |y'.im| < s_base } ×ˢ
                Metric.ball (starRingEnd ℂ t) δ_p := by
              refine ⟨?_, (hball_conj_iff q.2).mp hq.2⟩
              simp only [Prod.star_def, Complex.star_def, Set.mem_setOf_eq,
                Complex.conj_im, abs_neg]
              exact abs_lt.mpr hq.1
            obtain ⟨r, hr, hr_le, hr_sub, hr_eq⟩ := (hG_p i).2 (star q) hsq_base
            refine ⟨r, hr, hr_le, fun z hz => ?_, fun z hz => ?_⟩
            · have hsz : star z ∈ Metric.ball (star q) r := by
                rw [Metric.mem_ball, hdist_star]; exact hz
              have hmem := hr_sub hsz
              have habs : |z.1.im| < s_base := by
                simpa [Prod.star_def, Complex.star_def, Complex.conj_im, abs_neg] using hmem.1
              exact ⟨abs_lt.mp habs, (hball_conj_iff z.2).mpr hmem.2⟩
            · have hsz : star z ∈ Metric.ball (star q) r := by
                rw [Metric.mem_ball, hdist_star]; exact hz
              have hmem := hr_sub hsz
              have hz_im : |z.1.im| < s_base := by
                simpa [Prod.star_def, Complex.star_def, Complex.conj_im, abs_neg] using hmem.1
              have hz_base2 : z ∈ U_base2 := by
                refine ⟨by linarith, ?_⟩
                have hczB : starRingEnd ℂ z.2 ∈ B := hballB hmem.2
                simpa [B, Metric.mem_ball, dist_zero_right, Complex.norm_conj] using hczB
              have heq := congr_arg star (hr_eq (star z) hsz)
              rw [star_mul, mul_comm, hF_star i z hz_base2, star_star] at heq
              exact heq

    let pick (i : Fin 2) (p : ℂ × ℂ) (hp : p ∈ T_F) : ChartPkg :=
      Classical.choose (hChart i p hp)
    have pick_spec (i : Fin 2) (p : ℂ × ℂ) (hp : p ∈ T_F) :=
      Classical.choose_spec (hChart i p hp)

    let M_F : Fin 2 → MeroOn2D T_F := fun i =>
      let rad_i : ℂ × ℂ → ℝ :=
        fun p => if hp : p ∈ T_F then (pick i p hp).2.2.2.2.rad p else 1
      let num_i : (ℂ × ℂ) → (ℂ × ℂ → ℂ) :=
        fun p => if hp : p ∈ T_F then (pick i p hp).2.2.2.2.num p else fun _ => 0
      let den_i : (ℂ × ℂ) → (ℂ × ℂ → ℂ) :=
        fun p => if hp : p ∈ T_F then (pick i p hp).2.2.2.2.den p else fun _ => 1
      { rad := rad_i
        num := num_i
        den := den_i
        rad_pos := by
          intro p hp
          dsimp only [rad_i]
          rw [dif_pos hp]
          exact (pick i p hp).2.2.2.2.rad_pos p (pick_spec i p hp).2.2.2.1
        ball_sub := by
          intro p hp
          dsimp only [rad_i]
          rw [dif_pos hp]
          exact ((pick i p hp).2.2.2.2.ball_sub p (pick_spec i p hp).2.2.2.1).trans
            (pick_spec i p hp).2.2.2.2.1
        num_holo := by
          intro p hp
          dsimp only [rad_i, num_i]
          rw [dif_pos hp, dif_pos hp]
          exact (pick i p hp).2.2.2.2.num_holo p (pick_spec i p hp).2.2.2.1
        den_holo := by
          intro p hp
          dsimp only [rad_i, den_i]
          rw [dif_pos hp, dif_pos hp]
          exact (pick i p hp).2.2.2.2.den_holo p (pick_spec i p hp).2.2.2.1
        den_ne_zero := by
          intro p hp
          dsimp only [rad_i, den_i]
          rw [dif_pos hp, dif_pos hp]
          exact (pick i p hp).2.2.2.2.den_ne_zero p (pick_spec i p hp).2.2.2.1
        compat := by
          intro p₁ hp₁ p₂ hp₂ q hq
          simp only [rad_i, num_i, den_i, dif_pos hp₁, dif_pos hp₂] at hq ⊢
          set S₁ := pick i p₁ hp₁
          set S₂ := pick i p₂ hp₂
          obtain ⟨ha₁, hc₁, _, hp₁U, _, hAg₁, _⟩ := pick_spec i p₁ hp₁
          obtain ⟨ha₂, hc₂, _, hp₂U, _, hAg₂, _⟩ := pick_spec i p₂ hp₂
          let U₁ := cyl S₁.1 S₁.2.1 S₁.2.2.1 S₁.2.2.2.1
          let U₂ := cyl S₂.1 S₂.2.1 S₂.2.2.1 S₂.2.2.2.1
          let D₁₂ := Metric.ball S₁.2.2.1 S₁.2.2.2.1 ∩ Metric.ball S₂.2.2.1 S₂.2.2.2.1
          have hqU₁ : q ∈ U₁ := S₁.2.2.2.2.ball_sub p₁ hp₁U hq.1
          have hqU₂ : q ∈ U₂ := S₂.2.2.2.2.ball_sub p₂ hp₂U hq.2
          have hqD₁₂ : q.2 ∈ D₁₂ := ⟨hqU₁.2, hqU₂.2⟩
          have hV_eq : U₁ ∩ U₂ =
              { y' : ℂ | max S₁.1 S₂.1 < y'.im ∧ y'.im < min S₁.2.1 S₂.2.1 } ×ˢ D₁₂ := by
            ext ⟨y', t'⟩
            simp only [U₁, U₂, cyl, D₁₂, Set.mem_inter_iff, Set.mem_prod, Set.mem_setOf_eq,
              max_lt_iff, lt_min_iff]
            tauto
          have hV_open : IsOpen (U₁ ∩ U₂) :=
            (hCylOpen S₁.1 S₁.2.1 S₁.2.2.1 S₁.2.2.2.1).inter
              (hCylOpen S₂.1 S₂.2.1 S₂.2.2.1 S₂.2.2.2.1)
          have hV_conv : Convex ℝ (U₁ ∩ U₂) := by
            rw [hV_eq]
            have hpre : { y' : ℂ | max S₁.1 S₂.1 < y'.im ∧ y'.im < min S₁.2.1 S₂.2.1 } =
                Complex.imLm ⁻¹' Set.Ioo (max S₁.1 S₂.1) (min S₁.2.1 S₂.2.1) := rfl
            rw [hpre]
            exact ((convex_Ioo _ _).linear_preimage Complex.imLm).prod
              ((convex_ball _ _).inter (convex_ball _ _))
          let V₀ : Set (ℂ × ℂ) := { y' : ℂ | -s_base < y'.im ∧ y'.im < s_base } ×ˢ D₁₂
          have hV₀_open : IsOpen V₀ :=
            ((isOpen_lt continuous_const Complex.continuous_im).inter
              (isOpen_lt Complex.continuous_im continuous_const)).prod
              (Metric.isOpen_ball.inter Metric.isOpen_ball)
          have hV₀_ne : V₀.Nonempty :=
            ⟨((0 : ℂ), q.2), ⟨⟨by simp [hs_pos], by simp [hs_pos]⟩, hqD₁₂⟩⟩
          have hV₀_sub : V₀ ⊆ U₁ ∩ U₂ := by
            rw [hV_eq]
            rintro ⟨y', t'⟩ ⟨⟨h1, h2⟩, ht'⟩
            exact ⟨⟨lt_of_le_of_lt (max_le ha₁ ha₂) h1,
              lt_of_lt_of_le h2 (le_min hc₁ hc₂)⟩, ht'⟩
          have hAg₁_V₀ : MeroAgreesHolo S₁.2.2.2.2 (F_init i) V₀ :=
            meroAgreesHolo_mono hAg₁ hV₀_open (fun z hz => ⟨hz.1, hz.2.1⟩)
          have hAg₂_V₀ : MeroAgreesHolo S₂.2.2.2.2 (F_init i) V₀ :=
            meroAgreesHolo_mono hAg₂ hV₀_open (fun z hz => ⟨hz.1, hz.2.2⟩)
          have hEq_V₀ : MeroEqOn S₁.2.2.2.2 S₂.2.2.2.2 V₀ :=
            hMeroEqOfHolo S₁.2.2.2.2 S₂.2.2.2.2 hV₀_open hAg₁_V₀ hAg₂_V₀
          have hEq_V : MeroEqOn S₁.2.2.2.2 S₂.2.2.2.2 (U₁ ∩ U₂) :=
            hMeroEqConn S₁.2.2.2.2 S₂.2.2.2.2 Subset.rfl hV_open hV_conv.isPreconnected
              hV₀_open hV₀_ne hV₀_sub hEq_V₀
          exact hCompatOfEq S₁.2.2.2.2 S₂.2.2.2.2 hEq_V hp₁U hp₂U hq }

    refine ⟨h_ge_two, h_even, h_lsc, M_F, fun i => ⟨hU_base2_sub_TF, fun p hp => ?_⟩⟩
    have hpTF : p ∈ T_F := hU_base2_sub_TF hp
    obtain ⟨hball_U, heq_U⟩ := (pick_spec i p hpTF).2.2.2.2.2.2 hp.1
    have hrad_pos : 0 < (M_F i).rad p := (M_F i).rad_pos p hpTF
    have hrad_eq : (M_F i).rad p = (pick i p hpTF).2.2.2.2.rad p := by
      simp only [M_F, dif_pos hpTF]
    have hnum_eq : (M_F i).num p = (pick i p hpTF).2.2.2.2.num p := by
      simp only [M_F, dif_pos hpTF]
    have hden_eq : (M_F i).den p = (pick i p hpTF).2.2.2.2.den p := by
      simp only [M_F, dif_pos hpTF]
    refine ⟨(M_F i).rad p, hrad_pos, le_rfl, ?_, ?_⟩
    · rw [hrad_eq]; exact hball_U
    · intro q hq
      rw [hrad_eq] at hq
      rw [hnum_eq, hden_eq]
      exact heq_U q hq

  
  obtain ⟨hX_ge, hX_even, hX_lsc, X_mero, hX_agrees⟩ :=
    hEngine F_X hFX_holo hFX_even hFX_conj
  obtain ⟨hL_ge, hL_even, hL_lsc, L_mero, hL_agrees⟩ :=
    hEngine F_L hFL_holo hFL_even hFL_conj
  exact ⟨hX_ge, hL_ge, hX_even, hL_even, hX_lsc, hL_lsc, L_mero, X_mero, hL_agrees, hX_agrees⟩

theorem collar_width_cramer_reflection_duality (Ω : Set Plane)
    (C : AnalyticGlancingCollar Ω)
    (hDet : EndpointDeterminationData C)
    (h_X_ge_two : ∀ t ∈ Metric.ball (0 : ℂ) (collarBaseR hDet),
      ENNReal.ofReal (2 * collarBaseS hDet) ≤ collarWidthX C hDet t)
    (h_L_ge_two : ∀ t ∈ Metric.ball (0 : ℂ) (collarBaseR hDet),
      ENNReal.ofReal (2 * collarBaseS hDet) ≤ collarWidthL C hDet t)
    (h_X_even : ∀ t ∈ Metric.ball (0 : ℂ) (collarBaseR hDet),
      collarWidthX C hDet (-t) = collarWidthX C hDet t)
    (h_L_even : ∀ t ∈ Metric.ball (0 : ℂ) (collarBaseR hDet),
      collarWidthL C hDet (-t) = collarWidthL C hDet t) :
    ∀ t ∈ Metric.ball (0 : ℂ) (collarBaseR hDet),
      collarWidthL C hDet t = collarWidthX C hDet t + ENNReal.ofReal (|t.im| / 2) :=
by
  classical
  let s_base : ℝ := collarBaseS hDet
  let r_base : ℝ := collarBaseR hDet
  let B : Set ℂ := Metric.ball (0 : ℂ) r_base
  let S_base : Set (ℂ × ℂ) := { p : ℂ × ℂ | |p.1.im| < s_base ∧ ‖p.2‖ < r_base }
  let S_two : Set (ℂ × ℂ) := { p : ℂ × ℂ | |p.1.im| < 2 * s_base ∧ ‖p.2‖ < r_base }
  let F_L : Fin 2 → ℂ × ℂ → ℂ := fun c q => glancingDualLine C q.1 q.2 c
  let F_X : Fin 2 → ℂ × ℂ → ℂ := fun c q => glancingImpact C q.1 q.2 c
  let cramerDen (F : Fin 2 → ℂ × ℂ → ℂ) (p : ℂ × ℂ) : ℂ :=
    F 0 (p.1 + p.2 / 2, p.2) * F 1 (p.1 - p.2 / 2, p.2) -
      F 1 (p.1 + p.2 / 2, p.2) * F 0 (p.1 - p.2 / 2, p.2)
  let cramerNum (F : Fin 2 → ℂ × ℂ → ℂ) (i : Fin 2) (p : ℂ × ℂ) : ℂ :=
    if i = 0 then
      F 1 (p.1 - p.2 / 2, p.2) - F 1 (p.1 + p.2 / 2, p.2)
    else
      F 0 (p.1 + p.2 / 2, p.2) - F 0 (p.1 - p.2 / 2, p.2)
  let reflNum (F : Fin 2 → ℂ × ℂ → ℂ) (i : Fin 2) (p : ℂ × ℂ) : ℂ :=
    let pm0 := F 0 (p.1 - 3 * p.2 / 2, p.2)
    let pm1 := F 1 (p.1 - 3 * p.2 / 2, p.2)
    let p00 := F 0 (p.1 - p.2 / 2, p.2)
    let p01 := F 1 (p.1 - p.2 / 2, p.2)
    let w0 := p01 - pm1
    let w1 := pm0 - p00
    let n0 := iterDerivY 1 (fun q => F 1 (q.1 - q.2 / 2, q.2)) p
    let n1 := -iterDerivY 1 (fun q => F 0 (q.1 - q.2 / 2, q.2)) p
    let wn := w0 * n0 + w1 * n1
    let nn := n0 * n0 + n1 * n1
    if i = 0 then (wn + wn) * n0 - nn * w0 else (wn + wn) * n1 - nn * w1
  let reflDen (F : Fin 2 → ℂ × ℂ → ℂ) (p : ℂ × ℂ) : ℂ :=
    reflNum F 0 p * F 0 (p.1 - p.2 / 2, p.2) +
      reflNum F 1 p * F 1 (p.1 - p.2 / 2, p.2)

  
  have hPartialYHolo : ∀ {W : Set (ℂ × ℂ)}, IsOpen W → ∀ {f : ℂ × ℂ → ℂ},
      DifferentiableOn ℂ f W → DifferentiableOn ℂ (iterDerivY 1 f) W := by
    intro W hW f hf p₀ hp₀
    obtain ⟨R₀, hR₀_pos, hR₀_sub⟩ := Metric.isOpen_iff.mp hW p₀ hp₀
    let r : ℝ := R₀ / 4
    have hr : 0 < r := by positivity
    have hcb_sub : Metric.closedBall p₀ (3 * r) ⊆ W :=
      Set.Subset.trans (Metric.closedBall_subset_ball (by dsimp [r]; linarith)) hR₀_sub
    have hf_cont_cb : ContinuousOn f (Metric.closedBall p₀ (3 * r)) :=
      (hf.mono hcb_sub).continuousOn
    obtain ⟨M, hM_bound⟩ := (isCompact_closedBall p₀ (3 * r)).exists_bound_of_continuousOn hf_cont_cb
    let M' : ℝ := max M 0
    have hM'_nonneg : 0 ≤ M' := le_max_right _ _
    have hM'_le : ∀ q ∈ Metric.closedBall p₀ (3 * r), ‖f q‖ ≤ M' :=
      fun q hq => le_trans (hM_bound q hq) (le_max_left _ _)
    have hfderiv_bound : ∀ q ∈ Metric.closedBall p₀ (2 * r), ‖fderiv ℂ f q‖ ≤ 2 * M' / r := by
      intro q hq
      refine ContinuousLinearMap.opNorm_le_bound _ (by positivity) (fun v => ?_)
      by_cases hv : v = 0
      · simp [hv]
      · have hv_pos : 0 < ‖v‖ := norm_pos_iff.mpr hv
        let ρ : ℝ := (r / 2) / ‖v‖
        have hρ_pos : 0 < ρ := div_pos (half_pos hr) hv_pos
        let g : ℂ → ℂ := fun z => f (q + z • v)
        have hg_maps : ∀ z ∈ Metric.closedBall (0 : ℂ) ρ, q + z • v ∈ Metric.closedBall p₀ (3 * r) := by
          intro z hz
          rw [Metric.mem_closedBall, dist_zero_right] at hz
          rw [Metric.mem_closedBall] at hq ⊢
          have hzv : ‖z • v‖ ≤ r / 2 := by
            rw [norm_smul]
            calc ‖z‖ * ‖v‖ ≤ ρ * ‖v‖ := mul_le_mul_of_nonneg_right hz (le_of_lt hv_pos)
              _ = r / 2 := div_mul_cancel₀ (r / 2) (ne_of_gt hv_pos)
          calc dist (q + z • v) p₀ = ‖(q - p₀) + z • v‖ := by rw [dist_eq_norm]; ring_nf
            _ ≤ ‖q - p₀‖ + ‖z • v‖ := norm_add_le _ _
            _ = dist q p₀ + ‖z • v‖ := by rw [dist_eq_norm]
            _ ≤ 2 * r + r / 2 := by linarith
            _ ≤ 3 * r := by linarith
        have hg_diff : DifferentiableOn ℂ g (Metric.closedBall (0 : ℂ) ρ) := by
          intro z hz
          have hqzv : DifferentiableAt ℂ f (q + z • v) :=
            hf.differentiableAt (hW.mem_nhds (hcb_sub (hg_maps z hz)))
          have haff : DifferentiableAt ℂ (fun w : ℂ => q + w • v) z :=
            (differentiableAt_const q).add (differentiableAt_id.smul_const v)
          exact (hqzv.comp z haff).differentiableWithinAt
        have hg_deriv0 : deriv g 0 = (fderiv ℂ f q) v := by
          have hq_diff : DifferentiableAt ℂ f q :=
            hf.differentiableAt (hW.mem_nhds (hcb_sub (Metric.closedBall_subset_closedBall (by linarith) hq)))
          have haff : HasDerivAt (fun w : ℂ => q + w • v) v 0 := by
            simpa using ((hasDerivAt_id (0 : ℂ)).smul_const v).const_add q
          have hq_at0 : HasFDerivAt f (fderiv ℂ f q) (q + (0 : ℂ) • v) := by
            simpa using hq_diff.hasFDerivAt
          exact (hq_at0.comp_hasDerivAt 0 haff).deriv
        have h_est := Complex.norm_deriv_le_of_forall_mem_sphere_norm_le hρ_pos
          (hg_diff.mono Metric.closure_ball_subset_closedBall).diffContOnCl
          (fun z hz => hM'_le _ (hg_maps z (Metric.sphere_subset_closedBall hz)))
        rw [hg_deriv0] at h_est
        calc ‖(fderiv ℂ f q) v‖ ≤ M' / ρ := h_est
          _ = 2 * M' / r * ‖v‖ := by dsimp [ρ]; field_simp
    let w0 : ℝ → ℂ := circleMap 0 r
    let cwt : ℝ → ℂ := fun θ => deriv w0 θ * (w0 θ ^ 2)⁻¹
    have hw0_norm : ∀ θ : ℝ, ‖w0 θ‖ = r := fun θ => by
      simp [w0, circleMap, Complex.norm_real, Real.norm_of_nonneg (le_of_lt hr)]
    have hw0_ne : ∀ θ : ℝ, w0 θ ≠ 0 := fun θ h0 => by
      have := hw0_norm θ; rw [h0, norm_zero] at this; linarith
    have hcwt_cont : Continuous cwt := by
      have hd : deriv w0 = fun θ => circleMap 0 r θ * Complex.I := by
        ext θ; exact (hasDerivAt_circleMap 0 r θ).deriv
      dsimp [cwt]
      rw [hd]
      refine ((continuous_circleMap 0 r).mul continuous_const).mul ?_
      exact Continuous.inv₀ ((continuous_circleMap 0 r).pow 2) (fun θ => pow_ne_zero 2 (hw0_ne θ))
    have hcwt_norm : ∀ θ : ℝ, ‖cwt θ‖ = r⁻¹ := by
      intro θ
      have hd : deriv w0 θ = w0 θ * Complex.I := (hasDerivAt_circleMap 0 r θ).deriv
      dsimp [cwt]
      rw [hd, norm_mul, norm_mul, norm_inv, norm_pow, Complex.norm_I, mul_one, hw0_norm θ]
      field_simp
    let shiftPt : ℝ → ℂ × ℂ → ℂ × ℂ := fun θ p => (p.1 + w0 θ, p.2)
    have hshift_mem_cb2 : ∀ θ : ℝ, ∀ p ∈ Metric.ball p₀ (r / 2),
        shiftPt θ p ∈ Metric.closedBall p₀ (2 * r) := by
      intro θ p hp
      rw [Metric.mem_ball] at hp
      rw [Metric.mem_closedBall, Prod.dist_eq]
      have hp1 : dist p.1 p₀.1 < r / 2 := lt_of_le_of_lt (le_max_left _ _) hp
      have hp2 : dist p.2 p₀.2 < r / 2 := lt_of_le_of_lt (le_max_right _ _) hp
      refine max_le ?_ (by linarith)
      calc dist (p.1 + w0 θ) p₀.1 = ‖(p.1 - p₀.1) + w0 θ‖ := by rw [dist_eq_norm]; ring_nf
        _ ≤ ‖p.1 - p₀.1‖ + ‖w0 θ‖ := norm_add_le _ _
        _ = dist p.1 p₀.1 + r := by rw [dist_eq_norm, hw0_norm θ]
        _ ≤ 2 * r := by linarith
    let F : ℂ × ℂ → ℝ → ℂ := fun p θ => cwt θ * f (shiftPt θ p)
    have h_eq_int : ∀ p ∈ Metric.ball p₀ (r / 2),
        iterDerivY 1 f p = (2 * Real.pi * Complex.I)⁻¹ * ∫ θ in (0 : ℝ)..(2 * Real.pi), F p θ := by
      intro p hp
      have h_slice_open : DifferentiableOn ℂ (fun y' => f (y', p.2)) (Metric.ball p.1 (3 * r / 2)) := by
        intro y' hy'
        have hy'W : (y', p.2) ∈ W := by
          refine hcb_sub ?_
          rw [Metric.mem_ball] at hy' hp
          have hp1 : dist p.1 p₀.1 < r / 2 := lt_of_le_of_lt (le_max_left _ _) hp
          have hp2 : dist p.2 p₀.2 < r / 2 := lt_of_le_of_lt (le_max_right _ _) hp
          rw [Metric.mem_closedBall, Prod.dist_eq]
          refine max_le ?_ (by linarith)
          calc dist y' p₀.1 ≤ dist y' p.1 + dist p.1 p₀.1 := dist_triangle _ _ _
            _ ≤ 3 * r / 2 + r / 2 := by linarith
            _ ≤ 3 * r := by linarith
        exact ((hf.differentiableAt (hW.mem_nhds hy'W)).comp y'
          (differentiableAt_id.prodMk (differentiableAt_const p.2))).differentiableWithinAt
      have hcderiv := Complex.cderiv_eq_deriv Metric.isOpen_ball h_slice_open hr
        (Metric.closedBall_subset_ball (by linarith))
      change deriv (fun y' => f (y', p.2)) p.1 = _
      rw [← hcderiv]
      unfold Complex.cderiv circleIntegral
      simp only [circleMap_sub_center, smul_eq_mul]
      congr 1
      refine intervalIntegral.integral_congr (fun θ _ => ?_)
      have hd1 : deriv (circleMap p.1 r) θ = circleMap 0 r θ * Complex.I :=
        (hasDerivAt_circleMap p.1 r θ).deriv
      have hd0 : deriv w0 θ = circleMap 0 r θ * Complex.I :=
        (hasDerivAt_circleMap 0 r θ).deriv
      dsimp only [F, cwt, shiftPt]
      rw [hd1, hd0]
      dsimp only [w0, circleMap]
      simp only [zero_add]
      ring
    let F' : ℂ × ℂ → ℝ → ((ℂ × ℂ) →L[ℂ] ℂ) :=
      fun p θ => cwt θ • fderiv ℂ f (shiftPt θ p)
    have hF_hasFDeriv : ∀ p ∈ Metric.ball p₀ (r / 2), ∀ θ : ℝ,
        HasFDerivAt (fun q => F q θ) (F' p θ) p := by
      intro p hp θ
      have hmem : shiftPt θ p ∈ W :=
        hcb_sub (Metric.closedBall_subset_closedBall (by linarith) (hshift_mem_cb2 θ p hp))
      have hf_at : HasFDerivAt f (fderiv ℂ f (shiftPt θ p)) (shiftPt θ p) :=
        (hf.differentiableAt (hW.mem_nhds hmem)).hasFDerivAt
      have hsh_at : HasFDerivAt (shiftPt θ) (ContinuousLinearMap.id ℂ (ℂ × ℂ)) p := by
        have h1 : HasFDerivAt (fun q : ℂ × ℂ => q.1 + w0 θ) (ContinuousLinearMap.fst ℂ ℂ ℂ) p := by
          simpa using (ContinuousLinearMap.fst ℂ ℂ ℂ).hasFDerivAt.add_const (w0 θ)
        have h2 : HasFDerivAt (fun q : ℂ × ℂ => q.2) (ContinuousLinearMap.snd ℂ ℂ ℂ) p :=
          (ContinuousLinearMap.snd ℂ ℂ ℂ).hasFDerivAt
        exact h1.prodMk h2
      exact (hf_at.comp p hsh_at).const_smul (cwt θ)
    have hF_cont_θ : ∀ p ∈ Metric.ball p₀ (r / 2), Continuous (F p) := by
      intro p hp
      refine hcwt_cont.mul ?_
      have hsh_cont : Continuous (fun θ : ℝ => shiftPt θ p) :=
        (continuous_const.add (continuous_circleMap 0 r)).prodMk continuous_const
      exact hf_cont_cb.comp_continuous hsh_cont (fun θ =>
        Metric.closedBall_subset_closedBall (by linarith) (hshift_mem_cb2 θ p hp))
    have hF'_meas : MeasureTheory.AEStronglyMeasurable (F' p₀)
        (MeasureTheory.volume.restrict (Set.uIoc 0 (2 * Real.pi))) := by
      have h_decomp : F' p₀ = fun θ =>
          (cwt θ * (fderiv ℂ f (shiftPt θ p₀)) (1, 0)) • ContinuousLinearMap.fst ℂ ℂ ℂ +
          (cwt θ * (fderiv ℂ f (shiftPt θ p₀)) (0, 1)) • ContinuousLinearMap.snd ℂ ℂ ℂ := by
        funext θ
        refine ContinuousLinearMap.ext (fun q => ?_)
        rcases q with ⟨u, v⟩
        have huv : (u, v) = u • ((1 : ℂ), (0 : ℂ)) + v • ((0 : ℂ), (1 : ℂ)) := by ext <;> simp
        change cwt θ * (fderiv ℂ f (shiftPt θ p₀)) (u, v) =
          cwt θ * (fderiv ℂ f (shiftPt θ p₀)) (1, 0) * u +
          cwt θ * (fderiv ℂ f (shiftPt θ p₀)) (0, 1) * v
        rw [huv, map_add, map_smul, map_smul]
        simp only [smul_eq_mul]
        ring
      rw [h_decomp]
      have h_dir_meas : ∀ v : ℂ × ℂ, ‖v‖ = 1 →
          MeasureTheory.AEStronglyMeasurable
            (fun θ : ℝ => (fderiv ℂ f (shiftPt θ p₀)) v)
            (MeasureTheory.volume.restrict (Set.uIoc 0 (2 * Real.pi))) := by
        intro v hv1
        let stepℝ : ℕ → ℝ := fun n => (r / 4) / ((n : ℝ) + 1)
        let step : ℕ → ℂ := fun n => (stepℝ n : ℂ)
        have hstepℝ_tendsto : Filter.Tendsto stepℝ Filter.atTop (nhds 0) :=
          tendsto_const_nhds.div_atTop
            (Filter.tendsto_atTop_add_const_right _ 1 tendsto_natCast_atTop_atTop)
        have hstep_tendsto : Filter.Tendsto step Filter.atTop (nhds 0) :=
          Complex.continuous_ofReal.continuousAt.tendsto.comp hstepℝ_tendsto
        have hstep_ne : ∀ n : ℕ, step n ≠ 0 := by
          intro n
          exact Complex.ofReal_ne_zero.mpr (div_ne_zero (by positivity) (by positivity))
        have hstep_norm : ∀ n : ℕ, ‖step n‖ ≤ r / 4 := by
          intro n
          dsimp [step, stepℝ]
          rw [Complex.norm_real, Real.norm_of_nonneg (by positivity)]
          exact div_le_self (by positivity) (by linarith [Nat.cast_nonneg (α := ℝ) n])
        let g_seq : ℕ → ℝ → ℂ :=
          fun n θ => (step n)⁻¹ * (f (shiftPt θ p₀ + step n • v) - f (shiftPt θ p₀))
        have hg_cont : ∀ n : ℕ, Continuous (g_seq n) := by
          intro n
          refine continuous_const.mul (Continuous.sub ?_ ?_)
          · have h_in : ∀ θ : ℝ, shiftPt θ p₀ + step n • v ∈ Metric.closedBall p₀ (3 * r) := by
              intro θ
              have hbase := hshift_mem_cb2 θ p₀ (Metric.mem_ball_self (half_pos hr))
              rw [Metric.mem_closedBall] at hbase ⊢
              calc dist (shiftPt θ p₀ + step n • v) p₀
                  = ‖(shiftPt θ p₀ - p₀) + step n • v‖ := by rw [dist_eq_norm]; ring_nf
                _ ≤ ‖shiftPt θ p₀ - p₀‖ + ‖step n • v‖ := norm_add_le _ _
                _ = dist (shiftPt θ p₀) p₀ + ‖step n‖ * ‖v‖ := by rw [dist_eq_norm, norm_smul]
                _ ≤ 2 * r + (r / 4) * 1 := by rw [hv1]; linarith [hstep_norm n]
                _ ≤ 3 * r := by linarith
            have hc : Continuous (fun θ : ℝ => shiftPt θ p₀ + step n • v) :=
              ((continuous_const.add (continuous_circleMap 0 r)).prodMk continuous_const).add continuous_const
            exact hf_cont_cb.comp_continuous hc h_in
          · have h_in : ∀ θ : ℝ, shiftPt θ p₀ ∈ Metric.closedBall p₀ (3 * r) :=
              fun θ => Metric.closedBall_subset_closedBall (by linarith)
                (hshift_mem_cb2 θ p₀ (Metric.mem_ball_self (half_pos hr)))
            have hc : Continuous (fun θ : ℝ => shiftPt θ p₀) :=
              (continuous_const.add (continuous_circleMap 0 r)).prodMk continuous_const
            exact hf_cont_cb.comp_continuous hc h_in
        refine aestronglyMeasurable_of_tendsto_ae Filter.atTop
          (fun n => (hg_cont n).aestronglyMeasurable) (Filter.Eventually.of_forall fun θ => ?_)
        have hmem : shiftPt θ p₀ ∈ W :=
          hcb_sub (Metric.closedBall_subset_closedBall (by linarith)
            (hshift_mem_cb2 θ p₀ (Metric.mem_ball_self (half_pos hr))))
        have hd1 : HasDerivAt (fun z : ℂ => f (shiftPt θ p₀ + z • v))
            ((fderiv ℂ f (shiftPt θ p₀)) v) 0 := by
          have hf_at : HasFDerivAt f (fderiv ℂ f (shiftPt θ p₀)) (shiftPt θ p₀ + (0 : ℂ) • v) := by
            simpa using (hf.differentiableAt (hW.mem_nhds hmem)).hasFDerivAt
          have haff : HasDerivAt (fun z : ℂ => shiftPt θ p₀ + z • v) v 0 := by
            simpa using ((hasDerivAt_id (0 : ℂ)).smul_const v).const_add (shiftPt θ p₀)
          exact hf_at.comp_hasDerivAt 0 haff
        have htend := hd1.tendsto_slope_zero.comp
          (tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within _ hstep_tendsto
            (Filter.Eventually.of_forall fun n => hstep_ne n))
        simpa only [g_seq, Function.comp_def, slope_def_field, sub_zero, zero_add, zero_smul,
          add_zero, smul_eq_mul] using htend
      have hm1 := hcwt_cont.aestronglyMeasurable.mul (h_dir_meas (1, 0) (by simp))
      have hm2 := hcwt_cont.aestronglyMeasurable.mul (h_dir_meas (0, 1) (by simp))
      exact (hm1.smul_const _).add (hm2.smul_const _)
    have hF'_bound : ∀ᵐ θ ∂MeasureTheory.volume, θ ∈ Set.uIoc 0 (2 * Real.pi) →
        ∀ p ∈ Metric.ball p₀ (r / 2), ‖F' p θ‖ ≤ r⁻¹ * (2 * M' / r) := by
      refine Filter.Eventually.of_forall (fun θ _ p hp => ?_)
      dsimp [F']
      rw [norm_smul, hcwt_norm θ]
      exact mul_le_mul_of_nonneg_left (hfderiv_bound _ (hshift_mem_cb2 θ p hp)) (by positivity)
    have h_int_diff := intervalIntegral.hasFDerivAt_integral_of_dominated_of_fderiv_le
      (Metric.ball_mem_nhds p₀ (half_pos hr))
      (Filter.eventually_of_mem (Metric.ball_mem_nhds p₀ (half_pos hr))
        (fun p hp => (hF_cont_θ p hp).aestronglyMeasurable))
      ((hF_cont_θ p₀ (Metric.mem_ball_self (half_pos hr))).intervalIntegrable 0 (2 * Real.pi))
      hF'_meas
      hF'_bound
      intervalIntegrable_const
      (Filter.Eventually.of_forall (fun θ _ p hp => hF_hasFDeriv p hp θ))
    have h_diff_int : DifferentiableAt ℂ
        (fun p => (2 * Real.pi * Complex.I)⁻¹ * ∫ θ in (0 : ℝ)..(2 * Real.pi), F p θ) p₀ :=
      (differentiableAt_const _).mul h_int_diff.differentiableAt
    have h_ev_eq : iterDerivY 1 f =ᶠ[nhds p₀]
        (fun p => (2 * Real.pi * Complex.I)⁻¹ * ∫ θ in (0 : ℝ)..(2 * Real.pi), F p θ) :=
      Filter.eventually_of_mem (Metric.ball_mem_nhds p₀ (half_pos hr)) h_eq_int
    exact (h_diff_int.congr_of_eventuallyEq h_ev_eq).differentiableWithinAt

  
  have hs_eq_det : s_base = hDet.s_det := rfl
  have hs_pos : 0 < s_base := hDet.s_det_pos
  have hr_pos : 0 < r_base := lt_min hDet.r_det_pos (half_pos Real.pi_pos)
  have hr_le_det : r_base ≤ hDet.r_det := min_le_left _ _
  have hs_le_s₁ : s_base ≤ C.s₁ / 4 := hDet.s_det_le_s₁
  have hr_lt_s4 : r_base < s_base / 4 := lt_of_le_of_lt hr_le_det hDet.r_det_lt_s_det
  have hr_lt_r₁_half : r_base < C.r₁ / 2 := lt_of_le_of_lt hr_le_det hDet.r_det_lt_r₁
  have hr₁_pos : 0 < C.r₁ := C.r₁_pos
  have hs₁_pos : 0 < C.s₁ := lt_trans C.r₁_pos C.r₁_lt_s₁

  have hBaseSubDet : S_two ⊆
      { p : ℂ × ℂ | |p.1.im| < 2 * hDet.s_det ∧ ‖p.2‖ < 2 * hDet.r_det } :=
    fun _ hp => ⟨hp.1, by linarith [hp.2, hr_le_det, hDet.r_det_pos]⟩
  have hFL_holo : ∀ i : Fin 2, DifferentiableOn ℂ (F_L i) S_two :=
    fun i => (hDet.dualLine_holo i).mono hBaseSubDet
  have hFX_holo : ∀ i : Fin 2, DifferentiableOn ℂ (F_X i) S_two :=
    fun i => (hDet.impact_holo i).mono hBaseSubDet

  have hEdgeId : ∀ (y_c t : ℂ), |y_c.im| < 2 * s_base → ‖t‖ < r_base →
      let P_m := glancingImpact C (y_c - t / 2) t
      let P_p := glancingImpact C (y_c + t / 2) t
      let Λ := glancingDualLine C y_c t
      let Δ := P_m 0 * P_p 1 - P_m 1 * P_p 0
      (P_m 0 * Complex.cos (glancingTheta C y_c t) +
        P_m 1 * Complex.sin (glancingTheta C y_c t) = glancingOffset C y_c t) ∧
      (P_p 0 * Complex.cos (glancingTheta C y_c t) +
        P_p 1 * Complex.sin (glancingTheta C y_c t) = glancingOffset C y_c t) ∧
      (P_m 0 * Λ 0 + P_m 1 * Λ 1 = 1) ∧
      (P_p 0 * Λ 0 + P_p 1 * Λ 1 = 1) ∧
      (Δ * Λ 0 = P_p 1 - P_m 1) ∧
      (Δ * Λ 1 = P_m 0 - P_p 0) := by
    intro y_c t hy_c ht
    dsimp only
    have hy_s₁ : |y_c.im| < C.s₁ := by linarith
    have ht_r₁ : ‖t‖ < C.r₁ := by linarith
    have hp_nz : glancingOffset C y_c t ≠ 0 :=
      hDet.offset_ne_zero y_c t (by linarith [hs_eq_det]) (by linarith [hDet.r_det_pos])
    set θ_m : ℂ := glancingTheta C (y_c - t) t
    set θ_0 : ℂ := glancingTheta C y_c t
    set θ_p : ℂ := glancingTheta C (y_c + t) t
    have hproj_p : glancingImpact C (y_c + t / 2) t 0 * Complex.cos θ_0 +
        glancingImpact C (y_c + t / 2) t 1 * Complex.sin θ_0 = glancingOffset C y_c t := by
      have hmid_p : glancingMidAngle C (y_c + t / 2) t = (θ_0 + θ_p) / 2 := by
        unfold glancingMidAngle
        have h1 : y_c + t / 2 - t / 2 = y_c := by ring
        have h2 : y_c + t / 2 + t / 2 = y_c + t := by ring
        rw [h1, h2]
      simp only [glancingImpact, Matrix.cons_val_zero, Matrix.cons_val_one]
      rw [hmid_p]
      unfold glancingOffset supportAction1_ℂ
      have h_ang : (θ_0 + θ_p) / 2 - θ_0 = (θ_p - θ_0) / 2 := by ring
      have hc := Complex.cos_sub ((θ_0 + θ_p) / 2) θ_0
      have hs := Complex.sin_sub ((θ_0 + θ_p) / 2) θ_0
      rw [h_ang] at hc hs
      linear_combination C.h_ℂ ((θ_0 + θ_p) / 2) * hc.symm -
        deriv C.h_ℂ ((θ_0 + θ_p) / 2) * hs.symm
    have hproj_m : glancingImpact C (y_c - t / 2) t 0 * Complex.cos θ_0 +
        glancingImpact C (y_c - t / 2) t 1 * Complex.sin θ_0 = glancingOffset C y_c t := by
      have hmid_m : glancingMidAngle C (y_c - t / 2) t = (θ_m + θ_0) / 2 := by
        unfold glancingMidAngle
        have h1 : y_c - t / 2 - t / 2 = y_c - t := by ring
        have h2 : y_c - t / 2 + t / 2 = y_c := by ring
        rw [h1, h2]
      simp only [glancingImpact, Matrix.cons_val_zero, Matrix.cons_val_one]
      rw [hmid_m]
      have hstat : glancingOffset C y_c t = supportAction2_ℂ C.h_ℂ θ_m θ_0 :=
        C.glancing_stationary y_c t hy_s₁ ht_r₁
      rw [hstat]
      unfold supportAction2_ℂ
      have h_ang : (θ_m + θ_0) / 2 - θ_0 = -((θ_0 - θ_m) / 2) := by ring
      have hc := Complex.cos_sub ((θ_m + θ_0) / 2) θ_0
      have hs := Complex.sin_sub ((θ_m + θ_0) / 2) θ_0
      rw [h_ang, Complex.cos_neg] at hc
      rw [h_ang, Complex.sin_neg] at hs
      linear_combination C.h_ℂ ((θ_m + θ_0) / 2) * hc.symm -
        deriv C.h_ℂ ((θ_m + θ_0) / 2) * hs.symm
    have hinc_m : glancingImpact C (y_c - t / 2) t 0 * glancingDualLine C y_c t 0 +
        glancingImpact C (y_c - t / 2) t 1 * glancingDualLine C y_c t 1 = 1 := by
      simp only [glancingDualLine, Matrix.cons_val_zero, Matrix.cons_val_one]
      calc glancingImpact C (y_c - t / 2) t 0 * (Complex.cos θ_0 / glancingOffset C y_c t) +
            glancingImpact C (y_c - t / 2) t 1 * (Complex.sin θ_0 / glancingOffset C y_c t)
          = (glancingImpact C (y_c - t / 2) t 0 * Complex.cos θ_0 +
              glancingImpact C (y_c - t / 2) t 1 * Complex.sin θ_0) / glancingOffset C y_c t := by ring
        _ = glancingOffset C y_c t / glancingOffset C y_c t := by rw [hproj_m]
        _ = 1 := div_self hp_nz
    have hinc_p : glancingImpact C (y_c + t / 2) t 0 * glancingDualLine C y_c t 0 +
        glancingImpact C (y_c + t / 2) t 1 * glancingDualLine C y_c t 1 = 1 := by
      simp only [glancingDualLine, Matrix.cons_val_zero, Matrix.cons_val_one]
      calc glancingImpact C (y_c + t / 2) t 0 * (Complex.cos θ_0 / glancingOffset C y_c t) +
            glancingImpact C (y_c + t / 2) t 1 * (Complex.sin θ_0 / glancingOffset C y_c t)
          = (glancingImpact C (y_c + t / 2) t 0 * Complex.cos θ_0 +
              glancingImpact C (y_c + t / 2) t 1 * Complex.sin θ_0) / glancingOffset C y_c t := by ring
        _ = glancingOffset C y_c t / glancingOffset C y_c t := by rw [hproj_p]
        _ = 1 := div_self hp_nz
    refine ⟨hproj_m, hproj_p, hinc_m, hinc_p, ?_, ?_⟩
    · linear_combination glancingImpact C (y_c + t / 2) t 1 * hinc_m -
        glancingImpact C (y_c - t / 2) t 1 * hinc_p
    · linear_combination -glancingImpact C (y_c + t / 2) t 0 * hinc_m +
        glancingImpact C (y_c - t / 2) t 0 * hinc_p

  have hs1_eq : ∀ p ∈ S_base, ∀ i : Fin 2, cramerNum F_L i p = F_X i p * cramerDen F_L p := by
    rintro ⟨y, t⟩ ⟨hy, ht⟩
    have ht_im : |t.im| ≤ ‖t‖ := Complex.abs_im_le_norm t
    have hym_im : |(y - t / 2).im| < 2 * s_base := by
      have : (y - t / 2).im = y.im - t.im / 2 := by simp
      rw [this]
      linarith [abs_sub (y.im) (t.im / 2), abs_div (t.im) (2 : ℝ),
        abs_of_pos (by norm_num : (0 : ℝ) < 2)]
    have hyp_im : |(y + t / 2).im| < 2 * s_base := by
      have : (y + t / 2).im = y.im + t.im / 2 := by simp
      rw [this]
      linarith [abs_add_le (y.im) (t.im / 2), abs_div (t.im) (2 : ℝ),
        abs_of_pos (by norm_num : (0 : ℝ) < 2)]
    have h1 := (hEdgeId (y - t / 2) t hym_im ht).2.2.2.1
    have h2 := (hEdgeId (y + t / 2) t hyp_im ht).2.2.1
    have hy1 : y - t / 2 + t / 2 = y := by ring
    have hy2 : y + t / 2 - t / 2 = y := by ring
    rw [hy1] at h1
    rw [hy2] at h2
    refine Fin.forall_fin_two.mpr ⟨?_, ?_⟩
    · simp only [cramerNum, cramerDen, F_L, F_X, ↓reduceIte]
      linear_combination -glancingDualLine C (y - t / 2) t 1 * h2 +
        glancingDualLine C (y + t / 2) t 1 * h1
    · dsimp only [cramerNum, cramerDen, F_L, F_X]
      rw [if_neg (by decide : (1 : Fin 2) ≠ 0)]
      linear_combination -glancingDualLine C (y + t / 2) t 0 * h1 +
        glancingDualLine C (y - t / 2) t 0 * h2

  have hTheta_real : ∀ (x t : ℝ), |t| < C.r₁ →
      glancingTheta C (x : ℂ) (t : ℂ) = ((C.ϕ (C.U ((x : ℂ), (t : ℂ))).re : ℝ) : ℂ) := by
    intro x t ht
    have hconj := C.U_conj (x : ℂ) (t : ℂ) (by simp; linarith)
      (by simpa [Complex.norm_real] using ht)
    simp only [Complex.conj_ofReal] at hconj
    have him : (C.U ((x : ℂ), (t : ℂ))).im = 0 := Complex.conj_eq_iff_im.mp hconj.symm
    have hU_eq : C.U ((x : ℂ), (t : ℂ)) = (((C.U ((x : ℂ), (t : ℂ))).re : ℝ) : ℂ) := by
      apply Complex.ext <;> simp [him]
    unfold glancingTheta
    rw [hU_eq]
    exact C.ϕ_ℂ_real _

  have hOpen_sh : IsOpen (horizStrip (2 * C.s_h)) :=
    isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const
  have hderiv_h_holo : DifferentiableOn ℂ (deriv C.h_ℂ) (horizStrip (2 * C.s_h)) :=
    C.h_ℂ_holo.deriv hOpen_sh
  have hh_diff : Differentiable ℝ C.h := C.h_smooth.differentiable (by decide)
  have hh'_diff : Differentiable ℝ (deriv C.h) :=
    (C.h_smooth.of_le (m := ((1 : WithTop ℕ∞) + 1)) (by decide)).deriv'.differentiable_one

  have hderiv_h_real : ∀ θ : ℝ, deriv C.h_ℂ (θ : ℂ) = ((deriv C.h θ : ℝ) : ℂ) := by
    intro θ
    have hmem : (θ : ℂ) ∈ horizStrip (2 * C.s_h) := by
      change |(θ : ℂ).im| < 2 * C.s_h
      simp [C.s_h_pos]
    have hd1 : HasDerivAt (fun x : ℝ => C.h_ℂ (x : ℂ)) (deriv C.h_ℂ (θ : ℂ)) θ :=
      ((C.h_ℂ_holo.differentiableAt (hOpen_sh.mem_nhds hmem)).hasDerivAt).comp_ofReal
    have hd2 : HasDerivAt (fun x : ℝ => C.h_ℂ (x : ℂ)) ((deriv C.h θ : ℝ) : ℂ) θ := by
      have heq : (fun x : ℝ => C.h_ℂ (x : ℂ)) = (fun x : ℝ => ((C.h x : ℝ) : ℂ)) :=
        funext C.h_ℂ_real
      rw [heq]
      exact (hh_diff θ).hasDerivAt.ofReal_comp
    exact hd1.unique hd2

  have hderiv2_h_real : ∀ θ : ℝ, deriv (deriv C.h_ℂ) (θ : ℂ) = ((deriv (deriv C.h) θ : ℝ) : ℂ) := by
    intro θ
    have hmem : (θ : ℂ) ∈ horizStrip (2 * C.s_h) := by
      change |(θ : ℂ).im| < 2 * C.s_h
      simp [C.s_h_pos]
    have hd1 : HasDerivAt (fun x : ℝ => deriv C.h_ℂ (x : ℂ)) (deriv (deriv C.h_ℂ) (θ : ℂ)) θ :=
      ((hderiv_h_holo.differentiableAt (hOpen_sh.mem_nhds hmem)).hasDerivAt).comp_ofReal
    have hd2 : HasDerivAt (fun x : ℝ => deriv C.h_ℂ (x : ℂ)) ((deriv (deriv C.h) θ : ℝ) : ℂ) θ := by
      have heq : (fun x : ℝ => deriv C.h_ℂ (x : ℂ)) = (fun x : ℝ => ((deriv C.h x : ℝ) : ℂ)) :=
        funext hderiv_h_real
      rw [heq]
      exact (hh'_diff θ).hasDerivAt.ofReal_comp
    exact hd1.unique hd2

  let t₀ : ℝ := r_base / 2
  have ht₀_pos : 0 < t₀ := half_pos hr_pos
  have ht₀_lt_r : t₀ < r_base := half_lt_self hr_pos
  have ht₀_lt_r₁ : t₀ < C.r₁ := by linarith
  have ht₀_abs_r₁ : |t₀| < C.r₁ := by rw [abs_of_pos ht₀_pos]; exact ht₀_lt_r₁
  let p₀ : ℂ × ℂ := ((0 : ℂ), (t₀ : ℂ))
  have hp₀_mem : p₀ ∈ S_base := by
    refine ⟨by simp [p₀, hs_pos], ?_⟩
    simp only [p₀, Complex.norm_real, Real.norm_of_nonneg (le_of_lt ht₀_pos)]
    exact ht₀_lt_r

  have hs1_nz : ∃ q₀ ∈ S_base, cramerDen F_L q₀ ≠ 0 := by
    refine ⟨p₀, hp₀_mem, ?_⟩
    set off_p : ℂ := glancingOffset C ((t₀ : ℂ) / 2) (t₀ : ℂ)
    set off_m : ℂ := glancingOffset C (-(t₀ : ℂ) / 2) (t₀ : ℂ)
    have hp_pos_nz : off_p ≠ 0 :=
      hDet.offset_ne_zero ((t₀ : ℂ) / 2) (t₀ : ℂ) (by simp [hDet.s_det_pos])
        (by simp [Complex.norm_real, Real.norm_of_nonneg (le_of_lt ht₀_pos)]; linarith [hDet.r_det_pos])
    have hp_neg_nz : off_m ≠ 0 :=
      hDet.offset_ne_zero (-(t₀ : ℂ) / 2) (t₀ : ℂ) (by simp [hDet.s_det_pos])
        (by simp [Complex.norm_real, Real.norm_of_nonneg (le_of_lt ht₀_pos)]; linarith [hDet.r_det_pos])
    have h_th_p : glancingTheta C ((t₀ : ℂ) / 2) (t₀ : ℂ) =
        ((C.ϕ (C.U (((t₀ / 2 : ℝ) : ℂ), (t₀ : ℂ))).re : ℝ) : ℂ) := by
      have : (t₀ : ℂ) / 2 = ((t₀ / 2 : ℝ) : ℂ) := by push_cast; ring
      rw [this, hTheta_real (t₀ / 2) t₀ ht₀_abs_r₁]
    have h_th_m : glancingTheta C (-(t₀ : ℂ) / 2) (t₀ : ℂ) =
        ((C.ϕ (C.U (((-t₀ / 2 : ℝ) : ℂ), (t₀ : ℂ))).re : ℝ) : ℂ) := by
      have : -(t₀ : ℂ) / 2 = ((-t₀ / 2 : ℝ) : ℂ) := by push_cast; ring
      rw [this, hTheta_real (-t₀ / 2) t₀ ht₀_abs_r₁]
    set ϑ_p : ℝ := C.ϕ (C.U (((t₀ / 2 : ℝ) : ℂ), (t₀ : ℂ))).re
    set ϑ_m : ℝ := C.ϕ (C.U (((-t₀ / 2 : ℝ) : ℂ), (t₀ : ℂ))).re
    have hstep := C.U_real_step_pos (-t₀ / 2) t₀ ht₀_pos ht₀_lt_r₁
    have h_sum_t₀ : ((-t₀ / 2 : ℝ) : ℂ) + (t₀ : ℂ) = ((t₀ / 2 : ℝ) : ℂ) := by push_cast; ring
    rw [h_sum_t₀] at hstep
    have hdiff_pos : 0 < ϑ_p - ϑ_m := hstep.2.1
    have hdiff_lt_pi : ϑ_p - ϑ_m < Real.pi := hstep.2.2
    have hsin_pos : 0 < Real.sin (ϑ_p - ϑ_m) := Real.sin_pos_of_pos_of_lt_pi hdiff_pos hdiff_lt_pi
    intro hzero
    have hprod_zero : cramerDen F_L p₀ * (off_p * off_m) = 0 := by
      rw [hzero, zero_mul]
    have hprod_eq : cramerDen F_L p₀ * (off_p * off_m) =
        ((-Real.sin (ϑ_p - ϑ_m) : ℝ) : ℂ) := by
      have ha : p₀.1 + p₀.2 / 2 = (t₀ : ℂ) / 2 := by simp [p₀]
      have hb : p₀.1 - p₀.2 / 2 = -(t₀ : ℂ) / 2 := by simp [p₀]; ring
      have hp2 : p₀.2 = (t₀ : ℂ) := rfl
      dsimp only [cramerDen, F_L]
      rw [ha, hb, hp2]
      simp only [glancingDualLine, Matrix.cons_val_zero, Matrix.cons_val_one]
      change (Complex.cos (glancingTheta C ((t₀ : ℂ) / 2) (t₀ : ℂ)) / off_p *
          (Complex.sin (glancingTheta C (-(t₀ : ℂ) / 2) (t₀ : ℂ)) / off_m) -
        Complex.sin (glancingTheta C ((t₀ : ℂ) / 2) (t₀ : ℂ)) / off_p *
          (Complex.cos (glancingTheta C (-(t₀ : ℂ) / 2) (t₀ : ℂ)) / off_m)) *
        (off_p * off_m) = _
      rw [h_th_p, h_th_m, ← Complex.ofReal_cos, ← Complex.ofReal_sin,
        ← Complex.ofReal_cos, ← Complex.ofReal_sin]
      field_simp [hp_pos_nz, hp_neg_nz]
      rw [Real.sin_sub]
      push_cast
      ring
    rw [hprod_eq] at hprod_zero
    have hsin_zero : -Real.sin (ϑ_p - ϑ_m) = 0 := Complex.ofReal_eq_zero.mp hprod_zero
    linarith

  have hReflFormula : ∀ (y t : ℂ), (y, t) ∈ S_base →
      let ψ_fn : ℂ → ℂ := fun y' => glancingMidAngle C (y' - t / 2) t
      let ψ₀ : ℂ := ψ_fn y
      let D_P : ℂ := F_X 0 (y - 3 * t / 2, t) * F_X 1 (y - t / 2, t) -
        F_X 1 (y - 3 * t / 2, t) * F_X 0 (y - t / 2, t)
      let p_m1 : ℂ := glancingOffset C (y - t) t
      let p_0 : ℂ := glancingOffset C y t
      let κ : ℂ := (C.h_ℂ ψ₀ + deriv (deriv C.h_ℂ) ψ₀) * deriv ψ_fn y
      DifferentiableAt ℂ ψ_fn y ∧
      reflDen F_X (y, t) = (D_P / p_m1) * κ ^ 2 * p_0 ∧
      (∀ i : Fin 2, reflNum F_X i (y, t) = F_L i (y, t) * reflDen F_X (y, t)) := by
    intro y t hp_S
    have hy : |y.im| < s_base := hp_S.1
    have ht : ‖t‖ < r_base := hp_S.2
    dsimp only
    have ht_im : |t.im| ≤ ‖t‖ := Complex.abs_im_le_norm t
    have hy_sub_t : |(y - t).im| < 2 * s_base := by
      have : (y - t).im = y.im - t.im := by simp
      rw [this]
      linarith [abs_sub y.im t.im]
    have hEdge_m1 := hEdgeId (y - t) t hy_sub_t ht
    have h_arg1 : y - t - t / 2 = y - 3 * t / 2 := by ring
    have h_arg2 : y - t + t / 2 = y - t / 2 := by ring
    have hp_m1_nz : glancingOffset C (y - t) t ≠ 0 :=
      hDet.offset_ne_zero (y - t) t (by linarith [hs_eq_det]) (by linarith [hDet.r_det_pos])
    have hp_0_nz : glancingOffset C y t ≠ 0 :=
      hDet.offset_ne_zero y t (by linarith [hs_eq_det]) (by linarith [hDet.r_det_pos])
    let D_P : ℂ := F_X 0 (y - 3 * t / 2, t) * F_X 1 (y - t / 2, t) -
      F_X 1 (y - 3 * t / 2, t) * F_X 0 (y - t / 2, t)
    let p_m1 : ℂ := glancingOffset C (y - t) t
    let p_0 : ℂ := glancingOffset C y t
    let θ_m1 : ℂ := glancingTheta C (y - t) t
    let θ_0 : ℂ := glancingTheta C y t
    have hw0_eq : F_X 1 (y - t / 2, t) - F_X 1 (y - 3 * t / 2, t) =
        (D_P / p_m1) * Complex.cos θ_m1 := by
      have h := hEdge_m1.2.2.2.2.1
      simp only [glancingDualLine, Matrix.cons_val_zero] at h
      rw [h_arg1, h_arg2] at h
      change F_X 1 (y - t / 2, t) - F_X 1 (y - 3 * t / 2, t) = (D_P / p_m1) * Complex.cos θ_m1
      dsimp only [D_P, F_X, p_m1, θ_m1]
      rw [← h]; ring
    have hw1_eq : F_X 0 (y - 3 * t / 2, t) - F_X 0 (y - t / 2, t) =
        (D_P / p_m1) * Complex.sin θ_m1 := by
      have h := hEdge_m1.2.2.2.2.2
      simp only [glancingDualLine, Matrix.cons_val_one, Matrix.cons_val_zero] at h
      rw [h_arg1, h_arg2] at h
      change F_X 0 (y - 3 * t / 2, t) - F_X 0 (y - t / 2, t) = (D_P / p_m1) * Complex.sin θ_m1
      dsimp only [D_P, F_X, p_m1, θ_m1]
      rw [← h]; ring
    let ψ_fn : ℂ → ℂ := fun y' => glancingMidAngle C (y' - t / 2) t
    have hTh_diffAt : ∀ z : ℂ, |z.im| < C.s₁ → DifferentiableAt ℂ (fun y' => glancingTheta C y' t) z := by
      intro z hz
      have hU_open : IsOpen { p : ℂ × ℂ | |p.1.im| < 2 * C.s₁ ∧ ‖p.2‖ < C.r₁ } :=
        (isOpen_lt (continuous_abs.comp (Complex.continuous_im.comp continuous_fst))
          continuous_const).inter
          (isOpen_lt (continuous_norm.comp continuous_snd) continuous_const)
      have hU_at : DifferentiableAt ℂ (fun y' => C.U (y', t)) z :=
        (C.U_holo.differentiableAt (hU_open.mem_nhds ⟨by linarith, by linarith⟩)).comp z
          (differentiableAt_id.prodMk (differentiableAt_const t))
      have hU_strip : C.U (z, t) ∈ horizStrip (2 * C.s₀) :=
        C.U_maps_to z t (by linarith) (by linarith)
      have hOpen_s₀ : IsOpen (horizStrip (2 * C.s₀)) :=
        isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const
      exact (C.ϕ_ℂ_holo.differentiableAt (hOpen_s₀.mem_nhds hU_strip)).comp z hU_at
    have hψ_diff : DifferentiableAt ℂ ψ_fn y := by
      have h1 : DifferentiableAt ℂ (fun y' => glancingTheta C (y' - t / 2 - t / 2) t) y := by
        have hsub : |(y - t / 2 - t / 2).im| < C.s₁ := by
          have : y - t / 2 - t / 2 = y - t := by ring
          rw [this]; linarith
        have haff : DifferentiableAt ℂ (fun y' : ℂ => y' - t / 2 - t / 2) y :=
          (differentiableAt_id.sub (differentiableAt_const _)).sub (differentiableAt_const _)
        change DifferentiableAt ℂ ((fun y' => glancingTheta C y' t) ∘ (fun y' : ℂ => y' - t / 2 - t / 2)) y
        exact (hTh_diffAt _ hsub).comp y haff
      have h2 : DifferentiableAt ℂ (fun y' => glancingTheta C (y' - t / 2 + t / 2) t) y := by
        have hsub : |(y - t / 2 + t / 2).im| < C.s₁ := by
          have : y - t / 2 + t / 2 = y := by ring
          rw [this]; linarith
        have haff : DifferentiableAt ℂ (fun y' : ℂ => y' - t / 2 + t / 2) y :=
          (differentiableAt_id.sub (differentiableAt_const _)).add (differentiableAt_const _)
        change DifferentiableAt ℂ ((fun y' => glancingTheta C y' t) ∘ (fun y' : ℂ => y' - t / 2 + t / 2)) y
        exact (hTh_diffAt _ hsub).comp y haff
      exact (h1.add h2).div_const 2
    let ψ₀ : ℂ := ψ_fn y
    have hψ₀_eq : ψ₀ = (θ_m1 + θ_0) / 2 := by
      dsimp only [ψ₀, ψ_fn, glancingMidAngle, θ_m1, θ_0]
      have h1 : y - t / 2 - t / 2 = y - t := by ring
      have h2 : y - t / 2 + t / 2 = y := by ring
      rw [h1, h2]
    have hψ₀_strip : ψ₀ ∈ horizStrip (2 * C.s_h) := by
      have hm_strip : θ_m1 ∈ horizStrip (2 * C.s_h) :=
        C.ϕ_ℂ_maps_to _ (C.U_maps_to (y - t) t (by linarith) (by linarith))
      have h0_strip : θ_0 ∈ horizStrip (2 * C.s_h) :=
        C.ϕ_ℂ_maps_to _ (C.U_maps_to y t (by linarith) (by linarith))
      rw [hψ₀_eq]
      change |((θ_m1 + θ_0) / 2).im| < 2 * C.s_h
      have him : ((θ_m1 + θ_0) / 2).im = (θ_m1.im + θ_0.im) / 2 := by simp
      rw [him, abs_div, abs_of_pos (by norm_num : (0 : ℝ) < 2)]
      have h1 : |θ_m1.im| < 2 * C.s_h := hm_strip
      have h2 : |θ_0.im| < 2 * C.s_h := h0_strip
      linarith [abs_add_le θ_m1.im θ_0.im]
    let κ : ℂ := (C.h_ℂ ψ₀ + deriv (deriv C.h_ℂ) ψ₀) * deriv ψ_fn y
    have hd_h : HasDerivAt (fun y' => C.h_ℂ (ψ_fn y')) (deriv C.h_ℂ ψ₀ * deriv ψ_fn y) y := by
      simpa only [Function.comp_def] using
        (C.h_ℂ_holo.differentiableAt (hOpen_sh.mem_nhds hψ₀_strip)).hasDerivAt.comp y hψ_diff.hasDerivAt
    have hd_dh : HasDerivAt (fun y' => deriv C.h_ℂ (ψ_fn y'))
        (deriv (deriv C.h_ℂ) ψ₀ * deriv ψ_fn y) y := by
      simpa only [Function.comp_def] using
        (hderiv_h_holo.differentiableAt (hOpen_sh.mem_nhds hψ₀_strip)).hasDerivAt.comp y hψ_diff.hasDerivAt
    have hd_cos : HasDerivAt (fun y' => Complex.cos (ψ_fn y')) (-Complex.sin ψ₀ * deriv ψ_fn y) y := by
      simpa only [Function.comp_def] using (Complex.hasDerivAt_cos ψ₀).comp y hψ_diff.hasDerivAt
    have hd_sin : HasDerivAt (fun y' => Complex.sin (ψ_fn y')) (Complex.cos ψ₀ * deriv ψ_fn y) y := by
      simpa only [Function.comp_def] using (Complex.hasDerivAt_sin ψ₀).comp y hψ_diff.hasDerivAt
    have hn0_eq : iterDerivY 1 (fun q => F_X 1 (q.1 - q.2 / 2, q.2)) (y, t) =
        κ * Complex.cos ψ₀ := by
      have hd1 : HasDerivAt (fun y' =>
          C.h_ℂ (ψ_fn y') * Complex.sin (ψ_fn y') + deriv C.h_ℂ (ψ_fn y') * Complex.cos (ψ_fn y'))
          (κ * Complex.cos ψ₀) y := by
        convert (hd_h.mul hd_sin).add (hd_dh.mul hd_cos) using 1
        dsimp [κ, ψ₀]; ring
      have hfn_eq : (fun y' => F_X 1 (y' - t / 2, t)) = (fun y' =>
          C.h_ℂ (ψ_fn y') * Complex.sin (ψ_fn y') + deriv C.h_ℂ (ψ_fn y') * Complex.cos (ψ_fn y')) := by
        ext y'
        simp [F_X, glancingImpact, ψ_fn]
      change deriv (fun y' => F_X 1 (y' - t / 2, t)) y = _
      rw [hfn_eq]
      exact hd1.deriv
    have hn1_eq : -iterDerivY 1 (fun q => F_X 0 (q.1 - q.2 / 2, q.2)) (y, t) =
        κ * Complex.sin ψ₀ := by
      have hd0 : HasDerivAt (fun y' =>
          C.h_ℂ (ψ_fn y') * Complex.cos (ψ_fn y') - deriv C.h_ℂ (ψ_fn y') * Complex.sin (ψ_fn y'))
          (-(κ * Complex.sin ψ₀)) y := by
        convert (hd_h.mul hd_cos).sub (hd_dh.mul hd_sin) using 1
        dsimp [κ, ψ₀]; ring
      have hfn_eq : (fun y' => F_X 0 (y' - t / 2, t)) = (fun y' =>
          C.h_ℂ (ψ_fn y') * Complex.cos (ψ_fn y') - deriv C.h_ℂ (ψ_fn y') * Complex.sin (ψ_fn y')) := by
        ext y'
        simp [F_X, glancingImpact, ψ_fn]
      change -deriv (fun y' => F_X 0 (y' - t / 2, t)) y = _
      rw [hfn_eq, hd0.deriv, neg_neg]
    have hθ_rel : θ_0 = (ψ₀ + ψ₀) - θ_m1 := by rw [hψ₀_eq]; ring
    let c_w : ℂ := D_P / p_m1
    have hNum0 : reflNum F_X 0 (y, t) = c_w * κ ^ 2 * Complex.cos θ_0 := by
      change (let pm0 := F_X 0 (y - 3 * t / 2, t)
        let pm1 := F_X 1 (y - 3 * t / 2, t)
        let p00 := F_X 0 (y - t / 2, t)
        let p01 := F_X 1 (y - t / 2, t)
        let w0 := p01 - pm1
        let w1 := pm0 - p00
        let n0 := iterDerivY 1 (fun q => F_X 1 (q.1 - q.2 / 2, q.2)) (y, t)
        let n1 := -iterDerivY 1 (fun q => F_X 0 (q.1 - q.2 / 2, q.2)) (y, t)
        let wn := w0 * n0 + w1 * n1
        let nn := n0 * n0 + n1 * n1
        (wn + wn) * n0 - nn * w0) = c_w * κ ^ 2 * Complex.cos θ_0
      dsimp only
      rw [hw0_eq, hw1_eq, hn0_eq, hn1_eq, hθ_rel, Complex.cos_sub, Complex.cos_add, Complex.sin_add]
      ring
    have hNum1 : reflNum F_X 1 (y, t) = c_w * κ ^ 2 * Complex.sin θ_0 := by
      change (let pm0 := F_X 0 (y - 3 * t / 2, t)
        let pm1 := F_X 1 (y - 3 * t / 2, t)
        let p00 := F_X 0 (y - t / 2, t)
        let p01 := F_X 1 (y - t / 2, t)
        let w0 := p01 - pm1
        let w1 := pm0 - p00
        let n0 := iterDerivY 1 (fun q => F_X 1 (q.1 - q.2 / 2, q.2)) (y, t)
        let n1 := -iterDerivY 1 (fun q => F_X 0 (q.1 - q.2 / 2, q.2)) (y, t)
        let wn := w0 * n0 + w1 * n1
        let nn := n0 * n0 + n1 * n1
        (wn + wn) * n1 - nn * w1) = c_w * κ ^ 2 * Complex.sin θ_0
      dsimp only
      rw [hw0_eq, hw1_eq, hn0_eq, hn1_eq, hθ_rel, Complex.sin_sub, Complex.sin_add, Complex.cos_add]
      ring
    have hproj_0 : F_X 0 (y - t / 2, t) * Complex.cos θ_0 +
        F_X 1 (y - t / 2, t) * Complex.sin θ_0 = p_0 :=
      (hEdgeId y t (by linarith) ht).1
    have hDen : reflDen F_X (y, t) = c_w * κ ^ 2 * p_0 := by
      dsimp only [reflDen]
      rw [hNum0, hNum1]
      calc c_w * κ ^ 2 * Complex.cos θ_0 * F_X 0 (y - t / 2, t) +
            c_w * κ ^ 2 * Complex.sin θ_0 * F_X 1 (y - t / 2, t)
          = c_w * κ ^ 2 *
              (F_X 0 (y - t / 2, t) * Complex.cos θ_0 + F_X 1 (y - t / 2, t) * Complex.sin θ_0) := by ring
        _ = c_w * κ ^ 2 * p_0 := by rw [hproj_0]
    have hp0_ne : p_0 ≠ 0 := hp_0_nz
    refine ⟨hψ_diff, hDen, Fin.forall_fin_two.mpr ⟨?_, ?_⟩⟩
    · rw [hNum0, hDen]
      simp only [F_L, glancingDualLine, Matrix.cons_val_zero]
      change c_w * κ ^ 2 * Complex.cos θ_0 = (Complex.cos θ_0 / p_0) * (c_w * κ ^ 2 * p_0)
      symm
      calc (Complex.cos θ_0 / p_0) * (c_w * κ ^ 2 * p_0)
          = (c_w * κ ^ 2 * Complex.cos θ_0) * p_0 / p_0 := by ring
        _ = c_w * κ ^ 2 * Complex.cos θ_0 := mul_div_cancel_right₀ _ hp0_ne
    · rw [hNum1, hDen]
      simp only [F_L, glancingDualLine, Matrix.cons_val_one, Matrix.cons_val_zero]
      change c_w * κ ^ 2 * Complex.sin θ_0 = (Complex.sin θ_0 / p_0) * (c_w * κ ^ 2 * p_0)
      symm
      calc (Complex.sin θ_0 / p_0) * (c_w * κ ^ 2 * p_0)
          = (c_w * κ ^ 2 * Complex.sin θ_0) * p_0 / p_0 := by ring
        _ = c_w * κ ^ 2 * Complex.sin θ_0 := mul_div_cancel_right₀ _ hp0_ne

  have hs2_eq : ∀ p ∈ S_base, ∀ i : Fin 2, reflNum F_X i p = F_L i p * reflDen F_X p :=
    fun ⟨y, t⟩ hp i => (hReflFormula y t hp).2.2 i

  have hs2_nz : ∃ q₀ ∈ S_base, reflDen F_X q₀ ≠ 0 := by
    refine ⟨p₀, hp₀_mem, ?_⟩
    obtain ⟨hψ_diff0, hDen0, _⟩ := hReflFormula 0 (t₀ : ℂ) hp₀_mem
    change reflDen F_X (0, (t₀ : ℂ)) ≠ 0
    rw [hDen0]
    have hp_m1_nz : glancingOffset C ((0 : ℂ) - (t₀ : ℂ)) (t₀ : ℂ) ≠ 0 :=
      hDet.offset_ne_zero ((0 : ℂ) - (t₀ : ℂ)) (t₀ : ℂ) (by simp [hDet.s_det_pos])
        (by simp [Complex.norm_real, Real.norm_of_nonneg (le_of_lt ht₀_pos)]; linarith [hDet.r_det_pos])
    have hp_0_nz : glancingOffset C 0 (t₀ : ℂ) ≠ 0 :=
      hDet.offset_ne_zero 0 (t₀ : ℂ) (by simp [hDet.s_det_pos])
        (by simp [Complex.norm_real, Real.norm_of_nonneg (le_of_lt ht₀_pos)]; linarith [hDet.r_det_pos])
    have hDP_nz : F_X 0 ((0 : ℂ) - 3 * (t₀ : ℂ) / 2, (t₀ : ℂ)) *
        F_X 1 ((0 : ℂ) - (t₀ : ℂ) / 2, (t₀ : ℂ)) -
      F_X 1 ((0 : ℂ) - 3 * (t₀ : ℂ) / 2, (t₀ : ℂ)) *
        F_X 0 ((0 : ℂ) - (t₀ : ℂ) / 2, (t₀ : ℂ)) ≠ 0 := by
      set ϑ_m2 : ℝ := C.ϕ (C.U (((-2 * t₀ : ℝ) : ℂ), (t₀ : ℂ))).re
      set ϑ_m1 : ℝ := C.ϕ (C.U (((-t₀ : ℝ) : ℂ), (t₀ : ℂ))).re
      set ϑ_0 : ℝ := C.ϕ (C.U ((0 : ℂ), (t₀ : ℂ))).re
      set ψ_m : ℝ := (ϑ_m2 + ϑ_m1) / 2
      set ψ_p : ℝ := (ϑ_m1 + ϑ_0) / 2
      have hmid_m : glancingMidAngle C ((0 : ℂ) - 3 * (t₀ : ℂ) / 2) (t₀ : ℂ) = (ψ_m : ℂ) := by
        unfold glancingMidAngle
        have h1 : (0 : ℂ) - 3 * (t₀ : ℂ) / 2 - (t₀ : ℂ) / 2 = ((-2 * t₀ : ℝ) : ℂ) := by push_cast; ring
        have h2 : (0 : ℂ) - 3 * (t₀ : ℂ) / 2 + (t₀ : ℂ) / 2 = ((-t₀ : ℝ) : ℂ) := by push_cast; ring
        rw [h1, h2, hTheta_real (-2 * t₀) t₀ ht₀_abs_r₁, hTheta_real (-t₀) t₀ ht₀_abs_r₁]
        dsimp [ψ_m, ϑ_m2, ϑ_m1]; push_cast; ring
      have hmid_p : glancingMidAngle C ((0 : ℂ) - (t₀ : ℂ) / 2) (t₀ : ℂ) = (ψ_p : ℂ) := by
        unfold glancingMidAngle
        have h1 : (0 : ℂ) - (t₀ : ℂ) / 2 - (t₀ : ℂ) / 2 = ((-t₀ : ℝ) : ℂ) := by push_cast; ring
        have h2 : (0 : ℂ) - (t₀ : ℂ) / 2 + (t₀ : ℂ) / 2 = ((0 : ℝ) : ℂ) := by push_cast; ring
        rw [h1, h2, hTheta_real (-t₀) t₀ ht₀_abs_r₁, hTheta_real 0 t₀ ht₀_abs_r₁]
        simp only [Complex.ofReal_zero]
        dsimp [ψ_p, ϑ_m1, ϑ_0]; push_cast; ring
      let P_ℝ (ψ : ℝ) : Fin 2 → ℝ :=
        ![C.h ψ * Real.cos ψ - deriv C.h ψ * Real.sin ψ,
          C.h ψ * Real.sin ψ + deriv C.h ψ * Real.cos ψ]
      have hImp_m : ∀ i : Fin 2,
          F_X i ((0 : ℂ) - 3 * (t₀ : ℂ) / 2, (t₀ : ℂ)) = (P_ℝ ψ_m i : ℂ) := by
        refine Fin.forall_fin_two.mpr ⟨?_, ?_⟩ <;>
        · simp only [F_X, glancingImpact, P_ℝ, Matrix.cons_val_zero, Matrix.cons_val_one,
            hmid_m, C.h_ℂ_real, hderiv_h_real, ← Complex.ofReal_cos, ← Complex.ofReal_sin]
          push_cast; rfl
      have hImp_p : ∀ i : Fin 2,
          F_X i ((0 : ℂ) - (t₀ : ℂ) / 2, (t₀ : ℂ)) = (P_ℝ ψ_p i : ℂ) := by
        refine Fin.forall_fin_two.mpr ⟨?_, ?_⟩ <;>
        · simp only [F_X, glancingImpact, P_ℝ, Matrix.cons_val_zero, Matrix.cons_val_one,
            hmid_p, C.h_ℂ_real, hderiv_h_real, ← Complex.ofReal_cos, ← Complex.ofReal_sin]
          push_cast; rfl
      have hEdge_real := hEdgeId ((0 : ℂ) - (t₀ : ℂ)) (t₀ : ℂ) (by simp [hs_pos])
        (by simp [Complex.norm_real, Real.norm_of_nonneg (le_of_lt ht₀_pos)]; exact ht₀_lt_r)
      have ha1 : (0 : ℂ) - (t₀ : ℂ) - (t₀ : ℂ) / 2 = (0 : ℂ) - 3 * (t₀ : ℂ) / 2 := by ring
      have ha2 : (0 : ℂ) - (t₀ : ℂ) + (t₀ : ℂ) / 2 = (0 : ℂ) - (t₀ : ℂ) / 2 := by ring
      have ha3 : (0 : ℂ) - (t₀ : ℂ) = ((-t₀ : ℝ) : ℂ) := by push_cast; ring
      have hpm_proj := hEdge_real.1
      have hpp_proj := hEdge_real.2.1
      rw [ha1] at hpm_proj
      rw [ha2] at hpp_proj
      have hth_m1_eq : glancingTheta C ((0 : ℂ) - (t₀ : ℂ)) (t₀ : ℂ) = (ϑ_m1 : ℂ) := by
        rw [ha3, hTheta_real (-t₀) t₀ ht₀_abs_r₁]
      let p_real : ℝ := P_ℝ ψ_m 0 * Real.cos ϑ_m1 + P_ℝ ψ_m 1 * Real.sin ϑ_m1
      have hp_cast : (p_real : ℂ) = glancingOffset C ((0 : ℂ) - (t₀ : ℂ)) (t₀ : ℂ) := by
        rw [← hpm_proj, hth_m1_eq]
        change (p_real : ℂ) = F_X 0 ((0 : ℂ) - 3 * (t₀ : ℂ) / 2, (t₀ : ℂ)) * Complex.cos (ϑ_m1 : ℂ) +
          F_X 1 ((0 : ℂ) - 3 * (t₀ : ℂ) / 2, (t₀ : ℂ)) * Complex.sin (ϑ_m1 : ℂ)
        rw [hImp_m 0, hImp_m 1]
        simp only [p_real, Complex.ofReal_add, Complex.ofReal_mul, Complex.ofReal_cos, Complex.ofReal_sin]
      have hp_real_nz : p_real ≠ 0 := fun h0 => hp_m1_nz (by rw [← hp_cast, h0, Complex.ofReal_zero])
      have hpp_real : P_ℝ ψ_p 0 * Real.cos ϑ_m1 + P_ℝ ψ_p 1 * Real.sin ϑ_m1 = p_real := by
        apply Complex.ofReal_injective
        rw [hp_cast, ← hpp_proj, hth_m1_eq]
        change ↑(P_ℝ ψ_p 0 * Real.cos ϑ_m1 + P_ℝ ψ_p 1 * Real.sin ϑ_m1) =
          F_X 0 ((0 : ℂ) - (t₀ : ℂ) / 2, (t₀ : ℂ)) * Complex.cos (ϑ_m1 : ℂ) +
          F_X 1 ((0 : ℂ) - (t₀ : ℂ) / 2, (t₀ : ℂ)) * Complex.sin (ϑ_m1 : ℂ)
        rw [hImp_p 0, hImp_p 1]
        simp only [Complex.ofReal_add, Complex.ofReal_mul, Complex.ofReal_cos, Complex.ofReal_sin]
      let F_mono : ℝ → ℝ := fun ψ => C.h ψ * Real.sin (ψ - ϑ_m1) + deriv C.h ψ * Real.cos (ψ - ϑ_m1)
      have hF_proj : ∀ ψ : ℝ, -P_ℝ ψ 0 * Real.sin ϑ_m1 + P_ℝ ψ 1 * Real.cos ϑ_m1 = F_mono ψ := by
        intro ψ
        simp only [P_ℝ, F_mono, Matrix.cons_val_zero, Matrix.cons_val_one, Real.sin_sub, Real.cos_sub]
        ring
      have hΔ_factor : P_ℝ ψ_m 0 * P_ℝ ψ_p 1 - P_ℝ ψ_m 1 * P_ℝ ψ_p 0 =
          p_real * (F_mono ψ_p - F_mono ψ_m) := by
        rw [← hF_proj ψ_p, ← hF_proj ψ_m]
        have hcs_r : Real.cos ϑ_m1 ^ 2 + Real.sin ϑ_m1 ^ 2 = 1 := Real.cos_sq_add_sin_sq ϑ_m1
        have hm_r : P_ℝ ψ_m 0 * Real.cos ϑ_m1 + P_ℝ ψ_m 1 * Real.sin ϑ_m1 = p_real := rfl
        linear_combination -(P_ℝ ψ_m 0 * P_ℝ ψ_p 1 - P_ℝ ψ_m 1 * P_ℝ ψ_p 0) * hcs_r +
          (-P_ℝ ψ_p 0 * Real.sin ϑ_m1 + P_ℝ ψ_p 1 * Real.cos ϑ_m1) * hm_r -
          (-P_ℝ ψ_m 0 * Real.sin ϑ_m1 + P_ℝ ψ_m 1 * Real.cos ϑ_m1) * hpp_real
      have hF_deriv : ∀ ψ : ℝ,
          HasDerivAt F_mono ((C.h ψ + deriv (deriv C.h) ψ) * Real.cos (ψ - ϑ_m1)) ψ := by
        intro ψ
        have h1 := (hh_diff ψ).hasDerivAt
        have h2 : HasDerivAt (fun u : ℝ => Real.sin (u - ϑ_m1)) (Real.cos (ψ - ϑ_m1)) ψ := by
          simpa [Function.comp_def] using
            (Real.hasDerivAt_sin (ψ - ϑ_m1)).comp ψ ((hasDerivAt_id ψ).sub_const ϑ_m1)
        have h3 := (hh'_diff ψ).hasDerivAt
        have h4 : HasDerivAt (fun u : ℝ => Real.cos (u - ϑ_m1)) (-Real.sin (ψ - ϑ_m1)) ψ := by
          simpa [Function.comp_def] using
            (Real.hasDerivAt_cos (ψ - ϑ_m1)).comp ψ ((hasDerivAt_id ψ).sub_const ϑ_m1)
        convert (h1.mul h2).add (h3.mul h4) using 1
        ring
      have hF_cont : Continuous F_mono :=
        Differentiable.continuous (fun ψ => (hF_deriv ψ).differentiableAt)
      have hstep1 := C.U_real_step_pos (-2 * t₀) t₀ ht₀_pos ht₀_lt_r₁
      have hstep2 := C.U_real_step_pos (-t₀) t₀ ht₀_pos ht₀_lt_r₁
      have hs1_eq_pt : ((-2 * t₀ : ℝ) : ℂ) + (t₀ : ℂ) = ((-t₀ : ℝ) : ℂ) := by push_cast; ring
      have hs2_eq_pt : ((-t₀ : ℝ) : ℂ) + (t₀ : ℂ) = (0 : ℂ) := by push_cast; ring
      rw [hs1_eq_pt] at hstep1
      rw [hs2_eq_pt] at hstep2
      have h1_pos : 0 < ϑ_m1 - ϑ_m2 := hstep1.2.1
      have h1_lt : ϑ_m1 - ϑ_m2 < Real.pi := hstep1.2.2
      have h2_pos : 0 < ϑ_0 - ϑ_m1 := hstep2.2.1
      have h2_lt : ϑ_0 - ϑ_m1 < Real.pi := hstep2.2.2
      have hψm_lt_ψp : ψ_m < ψ_p := by dsimp [ψ_m, ψ_p]; linarith
      have hF_mono : StrictMonoOn F_mono (Set.Icc ψ_m ψ_p) :=
        strictMonoOn_of_deriv_pos (convex_Icc ψ_m ψ_p) hF_cont.continuousOn (fun ψ hψ => by
          have hψ_icc := interior_subset hψ
          rw [(hF_deriv ψ).deriv]
          refine mul_pos (C.r_pos ψ) (Real.cos_pos_of_mem_Ioo ⟨?_, ?_⟩)
          · dsimp [ψ_m] at hψ_icc; linarith [hψ_icc.1]
          · dsimp [ψ_p] at hψ_icc; linarith [hψ_icc.2])
      have hF_lt : F_mono ψ_m < F_mono ψ_p :=
        hF_mono ⟨le_rfl, hψm_lt_ψp.le⟩ ⟨hψm_lt_ψp.le, le_rfl⟩ hψm_lt_ψp
      rw [hImp_m 0, hImp_p 1, hImp_m 1, hImp_p 0]
      have hcast_eq : (P_ℝ ψ_m 0 : ℂ) * (P_ℝ ψ_p 1 : ℂ) - (P_ℝ ψ_m 1 : ℂ) * (P_ℝ ψ_p 0 : ℂ) =
          ((P_ℝ ψ_m 0 * P_ℝ ψ_p 1 - P_ℝ ψ_m 1 * P_ℝ ψ_p 0 : ℝ) : ℂ) := by push_cast; rfl
      rw [hcast_eq, hΔ_factor]
      exact Complex.ofReal_ne_zero.mpr (mul_ne_zero hp_real_nz (sub_ne_zero.mpr (ne_of_gt hF_lt)))
    let ψ_fn0 : ℂ → ℂ := fun y' => glancingMidAngle C (y' - (t₀ : ℂ) / 2) (t₀ : ℂ)
    let u_ℝ : ℝ → ℝ := fun x => (C.U ((x : ℂ), (t₀ : ℂ))).re
    let ψ_ℝ : ℝ → ℝ := fun x => (C.ϕ (u_ℝ (x - t₀)) + C.ϕ (u_ℝ x)) / 2
    have hψ_real_eq : ∀ x : ℝ, ψ_fn0 (x : ℂ) = (ψ_ℝ x : ℂ) := by
      intro x
      dsimp only [ψ_fn0, ψ_ℝ, u_ℝ, glancingMidAngle]
      have h1 : (x : ℂ) - (t₀ : ℂ) / 2 - (t₀ : ℂ) / 2 = ((x - t₀ : ℝ) : ℂ) := by push_cast; ring
      have h2 : (x : ℂ) - (t₀ : ℂ) / 2 + (t₀ : ℂ) / 2 = (x : ℂ) := by ring
      rw [h1, h2, hTheta_real (x - t₀) t₀ ht₀_abs_r₁, hTheta_real x t₀ ht₀_abs_r₁]
      push_cast; ring
    have hcurv_nz : C.h_ℂ (ψ_fn0 0) + deriv (deriv C.h_ℂ) (ψ_fn0 0) ≠ 0 := by
      have h0_eq : ψ_fn0 0 = (ψ_ℝ 0 : ℂ) := by simpa using hψ_real_eq 0
      rw [h0_eq, C.h_ℂ_real, hderiv2_h_real, ← Complex.ofReal_add]
      exact Complex.ofReal_ne_zero.mpr (ne_of_gt (C.r_pos (ψ_ℝ 0)))
    have hdψ_nz : deriv ψ_fn0 0 ≠ 0 := by
      have hu_deriv : ∀ z : ℝ, HasDerivAt u_ℝ (deriv u_ℝ z) z ∧ 0 < deriv u_ℝ z := by
        intro z
        have hpos := C.U_real_deriv_pos z t₀ ht₀_abs_r₁
        exact ⟨(differentiableAt_of_deriv_ne_zero (ne_of_gt hpos)).hasDerivAt, hpos⟩
      have hϕ_diff : Differentiable ℝ C.ϕ := C.ϕ_smooth.differentiable (by decide)
      have hu_sub : HasDerivAt (fun x : ℝ => u_ℝ (x - t₀)) (deriv u_ℝ (0 - t₀) * 1) 0 := by
        simpa only [Function.comp_def, id_eq] using
          (hu_deriv (0 - t₀)).1.comp 0 ((hasDerivAt_id (0 : ℝ)).sub_const t₀)
      have hd_sub : HasDerivAt (fun x : ℝ => C.ϕ (u_ℝ (x - t₀)))
          (deriv C.ϕ (u_ℝ (0 - t₀)) * (deriv u_ℝ (0 - t₀) * 1)) 0 := by
        simpa only [Function.comp_def] using (hϕ_diff _).hasDerivAt.comp 0 hu_sub
      have hd_id : HasDerivAt (fun x : ℝ => C.ϕ (u_ℝ x))
          (deriv C.ϕ (u_ℝ 0) * deriv u_ℝ 0) 0 := by
        simpa only [Function.comp_def] using (hϕ_diff _).hasDerivAt.comp 0 (hu_deriv 0).1
      have hd_ψℝ : HasDerivAt ψ_ℝ
          ((deriv C.ϕ (u_ℝ (0 - t₀)) * (deriv u_ℝ (0 - t₀) * 1) +
            deriv C.ϕ (u_ℝ 0) * deriv u_ℝ 0) / 2) 0 :=
        (hd_sub.add hd_id).div_const 2
      have hd_val_pos : 0 < (deriv C.ϕ (u_ℝ (0 - t₀)) * (deriv u_ℝ (0 - t₀) * 1) +
          deriv C.ϕ (u_ℝ 0) * deriv u_ℝ 0) / 2 := by
        have hp1 := C.ϕ_deriv_pos (u_ℝ (0 - t₀))
        have hp2 := (hu_deriv (0 - t₀)).2
        have hp3 := C.ϕ_deriv_pos (u_ℝ 0)
        have hp4 := (hu_deriv 0).2
        positivity
      have hd_c1 : HasDerivAt (fun x : ℝ => ψ_fn0 (x : ℂ)) (deriv ψ_fn0 0) 0 := by
        simpa using hψ_diff0.hasDerivAt.comp_ofReal
      have hd_c2 : HasDerivAt (fun x : ℝ => ψ_fn0 (x : ℂ))
          ((((deriv C.ϕ (u_ℝ (0 - t₀)) * (deriv u_ℝ (0 - t₀) * 1) +
            deriv C.ϕ (u_ℝ 0) * deriv u_ℝ 0) / 2 : ℝ) : ℂ)) 0 := by
        have heq : (fun x : ℝ => ψ_fn0 (x : ℂ)) = (fun x : ℝ => (ψ_ℝ x : ℂ)) :=
          funext hψ_real_eq
        rw [heq]
        exact hd_ψℝ.ofReal_comp
      rw [hd_c1.unique hd_c2]
      exact Complex.ofReal_ne_zero.mpr (ne_of_gt hd_val_pos)
    exact mul_ne_zero (mul_ne_zero (div_ne_zero hDP_nz hp_m1_nz)
      (pow_ne_zero 2 (mul_ne_zero hcurv_nz hdψ_nz))) hp_0_nz

  
  let cyl (a c : ℝ) (t_c : ℂ) (δ : ℝ) : Set (ℂ × ℂ) :=
    { y : ℂ | a < y.im ∧ y.im < c } ×ˢ Metric.ball t_c δ

  have hCylOpen : ∀ a c : ℝ, ∀ t_c : ℂ, ∀ δ : ℝ, IsOpen (cyl a c t_c δ) :=
    fun a c t_c δ =>
      ((isOpen_lt continuous_const Complex.continuous_im).inter
        (isOpen_lt Complex.continuous_im continuous_const)).prod Metric.isOpen_ball

  have hCylConv : ∀ a c : ℝ, ∀ t_c : ℂ, ∀ δ : ℝ, Convex ℝ (cyl a c t_c δ) :=
    fun a c t_c δ =>
      ((convex_Ioo a c).linear_preimage Complex.imLm).prod (convex_ball t_c δ)

  have hCylPreconn : ∀ a c : ℝ, ∀ t_c : ℂ, ∀ δ : ℝ, IsPreconnected (cyl a c t_c δ) :=
    fun a c t_c δ => (hCylConv a c t_c δ).isPreconnected

  have hCylNonempty : ∀ {a c : ℝ} {t_c : ℂ} {δ : ℝ}, a < c → 0 < δ → (cyl a c t_c δ).Nonempty := by
    intro a c t_c δ hac hδ
    refine ⟨((((a + c) / 2 : ℝ) : ℂ) * Complex.I, t_c), ?_, Metric.mem_ball_self hδ⟩
    simp only [Set.mem_setOf_eq, Complex.mul_im, Complex.ofReal_re, Complex.I_im, mul_one,
      Complex.ofReal_im, Complex.I_re, mul_zero, add_zero]
    exact ⟨by linarith, by linarith⟩

  have hBaseCylEq : ∀ (t_c : ℂ) (δ : ℝ),
      ({ y : ℂ | |y.im| < s_base } ×ˢ Metric.ball t_c δ) = cyl (-s_base) s_base t_c δ := by
    intro t_c δ; ext ⟨y, t'⟩; simp [cyl, abs_lt]

  have hS_base_eq : S_base = cyl (-s_base) s_base 0 r_base := by
    ext ⟨y, t'⟩
    simp [S_base, cyl, abs_lt, Metric.mem_ball, dist_zero_right]

  have hEqZeroConv2D : ∀ {W V : Set (ℂ × ℂ)},
      IsOpen W → Convex ℝ W → IsOpen V → V.Nonempty → V ⊆ W →
      ∀ {f : ℂ × ℂ → ℂ}, DifferentiableOn ℂ f W → (∀ p ∈ V, f p = 0) →
      ∀ q ∈ W, f q = 0 := by
    intro W V hW hW_conv hV ⟨q_base, hq_baseV⟩ hVW f hf hfV q hqW
    let Φ : ℂ → ℂ × ℂ := fun lam => q_base + lam • (q - q_base)
    have hΦ_diff : Differentiable ℂ Φ :=
      (differentiable_const q_base).add (differentiable_id.smul_const (q - q_base))
    have hU_open : IsOpen (Φ ⁻¹' W) := hW.preimage hΦ_diff.continuous
    have hU_conv : Convex ℝ (Φ ⁻¹' W) := by
      intro lam₁ hlam₁ lam₂ hlam₂ a b ha hb hab
      have hmem : a • Φ lam₁ + b • Φ lam₂ ∈ W := hW_conv hlam₁ hlam₂ ha hb hab
      have hab_C : (a : ℂ) + (b : ℂ) = 1 := by exact_mod_cast hab
      have heq : Φ (a • lam₁ + b • lam₂) = a • Φ lam₁ + b • Φ lam₂ := by
        ext <;> simp only [Φ, Prod.fst_add, Prod.snd_add, Prod.smul_fst, Prod.smul_snd,
          Prod.fst_sub, Prod.snd_sub, Complex.real_smul, smul_eq_mul]
        · linear_combination -q_base.1 * hab_C
        · linear_combination -q_base.2 * hab_C
      change Φ (a • lam₁ + b • lam₂) ∈ W
      rwa [heq]
    have h0 : (0 : ℂ) ∈ Φ ⁻¹' W := by change Φ 0 ∈ W; simpa [Φ] using hVW hq_baseV
    have h1 : (1 : ℂ) ∈ Φ ⁻¹' W := by change Φ 1 ∈ W; simpa [Φ] using hqW
    have hg_ana : AnalyticOnNhd ℂ (f ∘ Φ) (Φ ⁻¹' W) :=
      (hf.comp hΦ_diff.differentiableOn (fun _ h => h)).analyticOnNhd hU_open
    have hg_ev : (f ∘ Φ) =ᶠ[nhds (0 : ℂ)] 0 := by
      have hpre : Φ ⁻¹' V ∈ nhds (0 : ℂ) :=
        hΦ_diff.continuous.continuousAt.preimage_mem_nhds (by simpa [Φ] using hV.mem_nhds hq_baseV)
      filter_upwards [hpre] with lam hlam
      exact hfV (Φ lam) hlam
    have hres :=
      hg_ana.eqOn_zero_of_preconnected_of_eventuallyEq_zero hU_conv.isPreconnected h0 hg_ev h1
    simpa [Φ] using hres

  have hBallShrunkNZ : ∀ {p : ℂ × ℂ} {r r' : ℝ} {g : ℂ × ℂ → ℂ},
      0 < r' → r' ≤ r → DifferentiableOn ℂ g (Metric.ball p r) →
      (∃ q ∈ Metric.ball p r, g q ≠ 0) → ∃ q ∈ Metric.ball p r', g q ≠ 0 := by
    intro p r r' g hr' hr'_le hg ⟨q₀, hq₀, hnz⟩
    by_contra h_all
    push_neg at h_all
    exact hnz (hEqZeroConv2D Metric.isOpen_ball (convex_ball p r) Metric.isOpen_ball
      ⟨p, Metric.mem_ball_self hr'⟩ (Metric.ball_subset_ball hr'_le) hg h_all q₀ hq₀)

  have hBallMulNZ : ∀ {p : ℂ × ℂ} {r : ℝ} {g₁ g₂ : ℂ × ℂ → ℂ},
      0 < r → DifferentiableOn ℂ g₁ (Metric.ball p r) → DifferentiableOn ℂ g₂ (Metric.ball p r) →
      (∃ q ∈ Metric.ball p r, g₁ q ≠ 0) → (∃ q ∈ Metric.ball p r, g₂ q ≠ 0) →
      ∃ q ∈ Metric.ball p r, g₁ q * g₂ q ≠ 0 := by
    intro p r g₁ g₂ _ hg₁ hg₂ ⟨q₁, hq₁, hnz₁⟩ ⟨q₂, hq₂, hnz₂⟩
    have hcont : ContinuousAt g₁ q₁ :=
      hg₁.continuousOn.continuousAt (Metric.isOpen_ball.mem_nhds hq₁)
    obtain ⟨δ₁, hδ₁, hclose⟩ :=
      Metric.continuousAt_iff.mp hcont ‖g₁ q₁‖ (norm_pos_iff.mpr hnz₁)
    obtain ⟨δ₂, hδ₂, hsub_ball⟩ := Metric.isOpen_iff.mp Metric.isOpen_ball q₁ hq₁
    let δ : ℝ := min δ₁ δ₂
    have hδ : 0 < δ := lt_min hδ₁ hδ₂
    have hsub : Metric.ball q₁ δ ⊆ Metric.ball p r :=
      (Metric.ball_subset_ball (min_le_right _ _)).trans hsub_ball
    have hg₂_ex : ∃ q ∈ Metric.ball q₁ δ, g₂ q ≠ 0 := by
      by_contra h_all
      push_neg at h_all
      exact hnz₂ (hEqZeroConv2D Metric.isOpen_ball (convex_ball p r) Metric.isOpen_ball
        ⟨q₁, Metric.mem_ball_self hδ⟩ hsub hg₂ h_all q₂ hq₂)
    obtain ⟨q_star, hq_star, hnz_star⟩ := hg₂_ex
    refine ⟨q_star, hsub hq_star, mul_ne_zero ?_ hnz_star⟩
    intro hz1
    have hlt := hclose (lt_of_lt_of_le (Metric.mem_ball.mp hq_star) (min_le_left _ _))
    rw [hz1, dist_eq_norm, zero_sub, norm_neg] at hlt
    exact lt_irrefl _ hlt

  have hCancelDenOnBall : ∀ {p : ℂ × ℂ} {r : ℝ} {O : Set (ℂ × ℂ)} {g d : ℂ × ℂ → ℂ},
      IsOpen O → O.Nonempty → O ⊆ Metric.ball p r →
      DifferentiableOn ℂ g (Metric.ball p r) → DifferentiableOn ℂ d (Metric.ball p r) →
      (∃ z ∈ Metric.ball p r, d z ≠ 0) →
      (∀ z ∈ O, g z * d z = 0) → ∀ z ∈ Metric.ball p r, g z = 0 := by
    intro p r O g d hO hO_ne hO_sub hg hd ⟨z_d, hz_d, hd_nz⟩ hmul
    have hd_ex_O : ∃ z₀ ∈ O, d z₀ ≠ 0 := by
      by_contra h_all
      push_neg at h_all
      exact hd_nz (hEqZeroConv2D Metric.isOpen_ball (convex_ball p r) hO hO_ne hO_sub hd h_all z_d hz_d)
    obtain ⟨z₀, hz₀O, hdz₀⟩ := hd_ex_O
    have hd_cont : ContinuousAt d z₀ :=
      hd.continuousOn.continuousAt (Metric.isOpen_ball.mem_nhds (hO_sub hz₀O))
    obtain ⟨δ₁, hδ₁, hclose⟩ :=
      Metric.continuousAt_iff.mp hd_cont ‖d z₀‖ (norm_pos_iff.mpr hdz₀)
    obtain ⟨δ₂, hδ₂, hballO⟩ := Metric.isOpen_iff.mp hO z₀ hz₀O
    let δ : ℝ := min δ₁ δ₂
    have hδ : 0 < δ := lt_min hδ₁ hδ₂
    have hball_sub_O : Metric.ball z₀ δ ⊆ O :=
      (Metric.ball_subset_ball (min_le_right _ _)).trans hballO
    have hg_zero_ball : ∀ z ∈ Metric.ball z₀ δ, g z = 0 := by
      intro z hz
      have hdz_ne : d z ≠ 0 := by
        intro hzero
        have hlt := hclose (lt_of_lt_of_le (Metric.mem_ball.mp hz) (min_le_left _ _))
        rw [hzero, dist_eq_norm, zero_sub, norm_neg] at hlt
        exact lt_irrefl _ hlt
      exact (mul_eq_zero.mp (hmul z (hball_sub_O hz))).resolve_right hdz_ne
    exact hEqZeroConv2D Metric.isOpen_ball (convex_ball p r) Metric.isOpen_ball
      ⟨z₀, Metric.mem_ball_self hδ⟩ (hball_sub_O.trans hO_sub) hg hg_zero_ball

  let meroAdd : ∀ {W : Set (ℂ × ℂ)}, MeroOn2D W → MeroOn2D W → MeroOn2D W :=
    fun {W} M₁ M₂ =>
      { rad := fun p => min (M₁.rad p) (M₂.rad p)
        num := fun p q => M₁.num p q * M₂.den p q + M₂.num p q * M₁.den p q
        den := fun p q => M₁.den p q * M₂.den p q
        rad_pos := fun p hp => lt_min (M₁.rad_pos p hp) (M₂.rad_pos p hp)
        ball_sub := fun p hp =>
          (Metric.ball_subset_ball (min_le_left _ _)).trans (M₁.ball_sub p hp)
        num_holo := fun p hp =>
          (((M₁.num_holo p hp).mono (Metric.ball_subset_ball (min_le_left _ _))).mul
            ((M₂.den_holo p hp).mono (Metric.ball_subset_ball (min_le_right _ _)))).add
          (((M₂.num_holo p hp).mono (Metric.ball_subset_ball (min_le_right _ _))).mul
            ((M₁.den_holo p hp).mono (Metric.ball_subset_ball (min_le_left _ _))))
        den_holo := fun p hp =>
          ((M₁.den_holo p hp).mono (Metric.ball_subset_ball (min_le_left _ _))).mul
            ((M₂.den_holo p hp).mono (Metric.ball_subset_ball (min_le_right _ _)))
        den_ne_zero := fun p hp => by
          have hr_min : 0 < min (M₁.rad p) (M₂.rad p) := lt_min (M₁.rad_pos p hp) (M₂.rad_pos p hp)
          exact hBallMulNZ hr_min
            ((M₁.den_holo p hp).mono (Metric.ball_subset_ball (min_le_left _ _)))
            ((M₂.den_holo p hp).mono (Metric.ball_subset_ball (min_le_right _ _)))
            (hBallShrunkNZ hr_min (min_le_left _ _) (M₁.den_holo p hp) (M₁.den_ne_zero p hp))
            (hBallShrunkNZ hr_min (min_le_right _ _) (M₂.den_holo p hp) (M₂.den_ne_zero p hp))
        compat := fun p₁ hp₁ p₂ hp₂ q hq => by
          have h1 := M₁.compat p₁ hp₁ p₂ hp₂ q
            ⟨Metric.ball_subset_ball (min_le_left _ _) hq.1,
             Metric.ball_subset_ball (min_le_left _ _) hq.2⟩
          have h2 := M₂.compat p₁ hp₁ p₂ hp₂ q
            ⟨Metric.ball_subset_ball (min_le_right _ _) hq.1,
             Metric.ball_subset_ball (min_le_right _ _) hq.2⟩
          linear_combination M₂.den p₁ q * M₂.den p₂ q * h1 + M₁.den p₁ q * M₁.den p₂ q * h2 }

  have meroAdd_agrees : ∀ {W U : Set (ℂ × ℂ)} {M₁ M₂ : MeroOn2D W} {f₁ f₂ : ℂ × ℂ → ℂ},
      MeroAgreesHolo M₁ f₁ U → MeroAgreesHolo M₂ f₂ U →
      MeroAgreesHolo (meroAdd M₁ M₂) (fun q => f₁ q + f₂ q) U := by
    intro W U M₁ M₂ f₁ f₂ ⟨hUW, h₁⟩ ⟨_, h₂⟩
    refine ⟨hUW, fun p hp => ?_⟩
    obtain ⟨r₁, hr₁, hr₁_le, hr₁_sub, heq₁⟩ := h₁ p hp
    obtain ⟨r₂, hr₂, hr₂_le, _, heq₂⟩ := h₂ p hp
    refine ⟨min r₁ r₂, lt_min hr₁ hr₂, min_le_min hr₁_le hr₂_le,
      (Metric.ball_subset_ball (min_le_left _ _)).trans hr₁_sub, fun q hq => ?_⟩
    dsimp only [meroAdd]
    rw [heq₁ q (Metric.ball_subset_ball (min_le_left _ _) hq),
      heq₂ q (Metric.ball_subset_ball (min_le_right _ _) hq)]
    ring

  let meroNeg : ∀ {W : Set (ℂ × ℂ)}, MeroOn2D W → MeroOn2D W :=
    fun {W} M =>
      { rad := M.rad
        num := fun p q => -M.num p q
        den := M.den
        rad_pos := M.rad_pos
        ball_sub := M.ball_sub
        num_holo := fun p hp => (M.num_holo p hp).neg
        den_holo := M.den_holo
        den_ne_zero := M.den_ne_zero
        compat := fun p₁ hp₁ p₂ hp₂ q hq => by
          have h := M.compat p₁ hp₁ p₂ hp₂ q hq
          linear_combination -h }

  have meroNeg_agrees : ∀ {W U : Set (ℂ × ℂ)} {M : MeroOn2D W} {f : ℂ × ℂ → ℂ},
      MeroAgreesHolo M f U → MeroAgreesHolo (meroNeg M) (fun q => -f q) U := by
    intro W U M f ⟨hUW, hloc⟩
    refine ⟨hUW, fun p hp => ?_⟩
    obtain ⟨r, hr, hr_le, hr_sub, heq⟩ := hloc p hp
    refine ⟨r, hr, hr_le, hr_sub, fun q hq => ?_⟩
    dsimp only [meroNeg]
    rw [heq q hq]
    ring

  let meroSub : ∀ {W : Set (ℂ × ℂ)}, MeroOn2D W → MeroOn2D W → MeroOn2D W :=
    fun M₁ M₂ => meroAdd M₁ (meroNeg M₂)

  have meroSub_agrees : ∀ {W U : Set (ℂ × ℂ)} {M₁ M₂ : MeroOn2D W} {f₁ f₂ : ℂ × ℂ → ℂ},
      MeroAgreesHolo M₁ f₁ U → MeroAgreesHolo M₂ f₂ U →
      MeroAgreesHolo (meroSub M₁ M₂) (fun q => f₁ q - f₂ q) U := by
    intro W U M₁ M₂ f₁ f₂ h₁ h₂
    have h := meroAdd_agrees h₁ (meroNeg_agrees h₂)
    simpa only [sub_eq_add_neg] using h

  let meroMul : ∀ {W : Set (ℂ × ℂ)}, MeroOn2D W → MeroOn2D W → MeroOn2D W :=
    fun {W} M₁ M₂ =>
      { rad := fun p => min (M₁.rad p) (M₂.rad p)
        num := fun p q => M₁.num p q * M₂.num p q
        den := fun p q => M₁.den p q * M₂.den p q
        rad_pos := fun p hp => lt_min (M₁.rad_pos p hp) (M₂.rad_pos p hp)
        ball_sub := fun p hp =>
          (Metric.ball_subset_ball (min_le_left _ _)).trans (M₁.ball_sub p hp)
        num_holo := fun p hp =>
          ((M₁.num_holo p hp).mono (Metric.ball_subset_ball (min_le_left _ _))).mul
            ((M₂.num_holo p hp).mono (Metric.ball_subset_ball (min_le_right _ _)))
        den_holo := fun p hp =>
          ((M₁.den_holo p hp).mono (Metric.ball_subset_ball (min_le_left _ _))).mul
            ((M₂.den_holo p hp).mono (Metric.ball_subset_ball (min_le_right _ _)))
        den_ne_zero := fun p hp => by
          have hr_min : 0 < min (M₁.rad p) (M₂.rad p) := lt_min (M₁.rad_pos p hp) (M₂.rad_pos p hp)
          exact hBallMulNZ hr_min
            ((M₁.den_holo p hp).mono (Metric.ball_subset_ball (min_le_left _ _)))
            ((M₂.den_holo p hp).mono (Metric.ball_subset_ball (min_le_right _ _)))
            (hBallShrunkNZ hr_min (min_le_left _ _) (M₁.den_holo p hp) (M₁.den_ne_zero p hp))
            (hBallShrunkNZ hr_min (min_le_right _ _) (M₂.den_holo p hp) (M₂.den_ne_zero p hp))
        compat := fun p₁ hp₁ p₂ hp₂ q hq => by
          have h1 := M₁.compat p₁ hp₁ p₂ hp₂ q
            ⟨Metric.ball_subset_ball (min_le_left _ _) hq.1,
             Metric.ball_subset_ball (min_le_left _ _) hq.2⟩
          have h2 := M₂.compat p₁ hp₁ p₂ hp₂ q
            ⟨Metric.ball_subset_ball (min_le_right _ _) hq.1,
             Metric.ball_subset_ball (min_le_right _ _) hq.2⟩
          linear_combination M₂.num p₁ q * M₂.den p₂ q * h1 + M₁.num p₂ q * M₁.den p₁ q * h2 }

  have meroMul_agrees : ∀ {W U : Set (ℂ × ℂ)} {M₁ M₂ : MeroOn2D W} {f₁ f₂ : ℂ × ℂ → ℂ},
      MeroAgreesHolo M₁ f₁ U → MeroAgreesHolo M₂ f₂ U →
      MeroAgreesHolo (meroMul M₁ M₂) (fun q => f₁ q * f₂ q) U := by
    intro W U M₁ M₂ f₁ f₂ ⟨hUW, h₁⟩ ⟨_, h₂⟩
    refine ⟨hUW, fun p hp => ?_⟩
    obtain ⟨r₁, hr₁, hr₁_le, hr₁_sub, heq₁⟩ := h₁ p hp
    obtain ⟨r₂, hr₂, hr₂_le, _, heq₂⟩ := h₂ p hp
    refine ⟨min r₁ r₂, lt_min hr₁ hr₂, min_le_min hr₁_le hr₂_le,
      (Metric.ball_subset_ball (min_le_left _ _)).trans hr₁_sub, fun q hq => ?_⟩
    dsimp only [meroMul]
    rw [heq₁ q (Metric.ball_subset_ball (min_le_left _ _) hq),
      heq₂ q (Metric.ball_subset_ball (min_le_right _ _) hq)]
    ring

  let shiftMap (α : ℝ) (p : ℂ × ℂ) : ℂ × ℂ := (p.1 + (α : ℂ) * p.2, p.2)
  have hShiftDiff : ∀ α : ℝ, Differentiable ℂ (shiftMap α) := fun α =>
    (differentiable_fst.add ((differentiable_const (α : ℂ)).mul differentiable_snd)).prodMk
      differentiable_snd
  have hShiftInv : ∀ (α : ℝ) (p : ℂ × ℂ), shiftMap (-α) (shiftMap α p) = p := by
    intro α ⟨y, t'⟩
    apply Prod.ext <;> simp [shiftMap]

  let meroPullbackShift : ∀ {W W' : Set (ℂ × ℂ)} (α : ℝ), IsOpen W →
      (∀ p ∈ W, shiftMap α p ∈ W') → MeroOn2D W' → MeroOn2D W :=
    fun {W W'} α hW hMaps M =>
      let O_fn : ℂ × ℂ → Set (ℂ × ℂ) :=
        fun p => W ∩ (shiftMap α) ⁻¹' Metric.ball (shiftMap α p) (M.rad (shiftMap α p))
      have hO_mem : ∀ p ∈ W, IsOpen (O_fn p) ∧ p ∈ O_fn p := by
        intro p hp
        refine ⟨hW.inter (Metric.isOpen_ball.preimage (hShiftDiff α).continuous),
          hp, Metric.mem_ball_self (M.rad_pos _ (hMaps p hp))⟩
      let rad_fn : ℂ × ℂ → ℝ :=
        fun p => if hp : p ∈ W then
          Classical.choose (Metric.isOpen_iff.mp (hO_mem p hp).1 p (hO_mem p hp).2)
        else 1
      have hrad_spec : ∀ p ∈ W, 0 < rad_fn p ∧ Metric.ball p (rad_fn p) ⊆ O_fn p := by
        intro p hp
        dsimp only [rad_fn]
        rw [dif_pos hp]
        exact Classical.choose_spec (Metric.isOpen_iff.mp (hO_mem p hp).1 p (hO_mem p hp).2)
      { rad := rad_fn
        num := fun p q => M.num (shiftMap α p) (shiftMap α q)
        den := fun p q => M.den (shiftMap α p) (shiftMap α q)
        rad_pos := fun p hp => (hrad_spec p hp).1
        ball_sub := fun p hp q hq => ((hrad_spec p hp).2 hq).1
        num_holo := fun p hp =>
          (M.num_holo _ (hMaps p hp)).comp (hShiftDiff α).differentiableOn
            (fun q hq => ((hrad_spec p hp).2 hq).2)
        den_holo := fun p hp =>
          (M.den_holo _ (hMaps p hp)).comp (hShiftDiff α).differentiableOn
            (fun q hq => ((hrad_spec p hp).2 hq).2)
        den_ne_zero := fun p hp => by
          by_contra h_all
          push_neg at h_all
          let V_img : Set (ℂ × ℂ) := (shiftMap (-α)) ⁻¹' Metric.ball p (rad_fn p)
          have hV_open : IsOpen V_img :=
            Metric.isOpen_ball.preimage (hShiftDiff (-α)).continuous
          have hV_ne : V_img.Nonempty := by
            refine ⟨shiftMap α p, ?_⟩
            show shiftMap (-α) (shiftMap α p) ∈ Metric.ball p (rad_fn p)
            rw [hShiftInv]
            exact Metric.mem_ball_self (hrad_spec p hp).1
          have hV_sub : V_img ⊆ Metric.ball (shiftMap α p) (M.rad (shiftMap α p)) := by
            intro z hz
            have hinv : shiftMap α (shiftMap (-α) z) = z := by
              simpa using hShiftInv (-α) z
            rw [← hinv]
            exact ((hrad_spec p hp).2 hz).2
          have hV_zero : ∀ z ∈ V_img, M.den (shiftMap α p) z = 0 := by
            intro z hz
            have hinv : shiftMap α (shiftMap (-α) z) = z := by
              simpa using hShiftInv (-α) z
            rw [← hinv]
            exact h_all (shiftMap (-α) z) hz
          obtain ⟨q₀, hq₀, hnz⟩ := M.den_ne_zero (shiftMap α p) (hMaps p hp)
          exact hnz (hEqZeroConv2D Metric.isOpen_ball (convex_ball _ _) hV_open hV_ne hV_sub
            (M.den_holo _ (hMaps p hp)) hV_zero q₀ hq₀)
        compat := fun p₁ hp₁ p₂ hp₂ q hq =>
          M.compat (shiftMap α p₁) (hMaps p₁ hp₁) (shiftMap α p₂) (hMaps p₂ hp₂) (shiftMap α q)
            ⟨((hrad_spec p₁ hp₁).2 hq.1).2, ((hrad_spec p₂ hp₂).2 hq.2).2⟩ }

  have meroPullbackShift_agrees : ∀ {W W' U U' : Set (ℂ × ℂ)} (α : ℝ) (hW : IsOpen W)
      (hMaps : ∀ p ∈ W, shiftMap α p ∈ W') {M : MeroOn2D W'} {f : ℂ × ℂ → ℂ},
      MeroAgreesHolo M f U' → IsOpen U → U ⊆ W → (∀ p ∈ U, shiftMap α p ∈ U') →
      MeroAgreesHolo (meroPullbackShift α hW hMaps M) (fun q => f (shiftMap α q)) U := by
    intro W W' U U' α hW hMaps M f ⟨_, hloc⟩ hU hUW hUMaps
    refine ⟨hUW, fun p hp => ?_⟩
    obtain ⟨r', hr', _, _, heq'⟩ := hloc (shiftMap α p) (hUMaps p hp)
    have hO_open : IsOpen (U ∩ (shiftMap α) ⁻¹' Metric.ball (shiftMap α p) r') :=
      hU.inter (Metric.isOpen_ball.preimage (hShiftDiff α).continuous)
    obtain ⟨r₁, hr₁, hr₁_sub⟩ :=
      Metric.isOpen_iff.mp hO_open p ⟨hp, Metric.mem_ball_self hr'⟩
    let M_pb := meroPullbackShift α hW hMaps M
    have hrad_pos : 0 < M_pb.rad p := M_pb.rad_pos p (hUW hp)
    refine ⟨min r₁ (M_pb.rad p), lt_min hr₁ hrad_pos, min_le_right _ _,
      fun q hq => (hr₁_sub (Metric.ball_subset_ball (min_le_left _ _) hq)).1,
      fun q hq => heq' (shiftMap α q) (hr₁_sub (Metric.ball_subset_ball (min_le_left _ _) hq)).2⟩

  have hIterY_congr : ∀ {O : Set (ℂ × ℂ)} {g₁ g₂ : ℂ × ℂ → ℂ},
      IsOpen O → (∀ r ∈ O, g₁ r = g₂ r) → ∀ q ∈ O, iterDerivY 1 g₁ q = iterDerivY 1 g₂ q := by
    intro O g₁ g₂ hO heq ⟨y, t'⟩ hq
    have h_ev : (fun y' : ℂ => g₁ (y', t')) =ᶠ[nhds y] (fun y' : ℂ => g₂ (y', t')) := by
      have h_pre : (fun y' : ℂ => (y', t')) ⁻¹' O ∈ nhds y :=
        (continuous_id.prodMk continuous_const).continuousAt.preimage_mem_nhds (hO.mem_nhds hq)
      filter_upwards [h_pre] with y' hy'
      exact heq (y', t') hy'
    exact h_ev.deriv_eq

  have hIterY_mul : ∀ {O : Set (ℂ × ℂ)} {g₁ g₂ : ℂ × ℂ → ℂ},
      IsOpen O → DifferentiableOn ℂ g₁ O → DifferentiableOn ℂ g₂ O →
      ∀ q ∈ O, iterDerivY 1 (fun r => g₁ r * g₂ r) q =
        iterDerivY 1 g₁ q * g₂ q + g₁ q * iterDerivY 1 g₂ q := by
    intro O g₁ g₂ hO hg₁ hg₂ ⟨y, t'⟩ hq
    have hd₁ : HasDerivAt (fun y' : ℂ => g₁ (y', t')) (iterDerivY 1 g₁ (y, t')) y :=
      ((hg₁.differentiableAt (hO.mem_nhds hq)).comp y
        (differentiableAt_id.prodMk (differentiableAt_const t'))).hasDerivAt
    have hd₂ : HasDerivAt (fun y' : ℂ => g₂ (y', t')) (iterDerivY 1 g₂ (y, t')) y :=
      ((hg₂.differentiableAt (hO.mem_nhds hq)).comp y
        (differentiableAt_id.prodMk (differentiableAt_const t'))).hasDerivAt
    exact (hd₁.mul hd₂).deriv

  let meroDerivY : ∀ {W : Set (ℂ × ℂ)}, MeroOn2D W → MeroOn2D W :=
    fun {W} M =>
      { rad := M.rad
        num := fun p q => iterDerivY 1 (M.num p) q * M.den p q - M.num p q * iterDerivY 1 (M.den p) q
        den := fun p q => M.den p q * M.den p q
        rad_pos := M.rad_pos
        ball_sub := M.ball_sub
        num_holo := fun p hp =>
          ((hPartialYHolo Metric.isOpen_ball (M.num_holo p hp)).mul (M.den_holo p hp)).sub
            ((M.num_holo p hp).mul (hPartialYHolo Metric.isOpen_ball (M.den_holo p hp)))
        den_holo := fun p hp => (M.den_holo p hp).mul (M.den_holo p hp)
        den_ne_zero := fun p hp => by
          obtain ⟨q, hq, hnz⟩ := M.den_ne_zero p hp
          exact ⟨q, hq, mul_ne_zero hnz hnz⟩
        compat := fun p₁ hp₁ p₂ hp₂ q hq => by
          let O := Metric.ball p₁ (M.rad p₁) ∩ Metric.ball p₂ (M.rad p₂)
          have hO : IsOpen O := Metric.isOpen_ball.inter Metric.isOpen_ball
          have h_eq_all : ∀ r ∈ O, M.num p₁ r * M.den p₂ r = M.num p₂ r * M.den p₁ r :=
            fun r hr => M.compat p₁ hp₁ p₂ hp₂ r hr
          have h_eq : M.num p₁ q * M.den p₂ q = M.num p₂ q * M.den p₁ q := h_eq_all q hq
          have h_d := hIterY_congr hO h_eq_all q hq
          rw [hIterY_mul hO ((M.num_holo p₁ hp₁).mono Set.inter_subset_left)
              ((M.den_holo p₂ hp₂).mono Set.inter_subset_right) q hq,
            hIterY_mul hO ((M.num_holo p₂ hp₂).mono Set.inter_subset_right)
              ((M.den_holo p₁ hp₁).mono Set.inter_subset_left) q hq] at h_d
          linear_combination M.den p₁ q * M.den p₂ q * h_d -
            (iterDerivY 1 (M.den p₁) q * M.den p₂ q + M.den p₁ q * iterDerivY 1 (M.den p₂) q) * h_eq }

  have meroDerivY_agrees : ∀ {W U : Set (ℂ × ℂ)} {M : MeroOn2D W} {f : ℂ × ℂ → ℂ},
      MeroAgreesHolo M f U → IsOpen U → DifferentiableOn ℂ f U →
      MeroAgreesHolo (meroDerivY M) (iterDerivY 1 f) U := by
    intro W U M f ⟨hUW, hloc⟩ _ hf
    refine ⟨hUW, fun p hp => ?_⟩
    obtain ⟨r, hr, hr_le, hr_sub, heq⟩ := hloc p hp
    refine ⟨r, hr, hr_le, hr_sub, fun q hq => ?_⟩
    have h_d := hIterY_congr Metric.isOpen_ball heq q hq
    rw [hIterY_mul Metric.isOpen_ball (hf.mono hr_sub)
      ((M.den_holo p (hUW hp)).mono (Metric.ball_subset_ball hr_le)) q hq] at h_d
    dsimp only [meroDerivY]
    rw [h_d, heq q hq]
    ring

  have meroDiv_exists : ∀ {W U : Set (ℂ × ℂ)} (N D : MeroOn2D W)
      {n₀ d₀ f_target : ℂ × ℂ → ℂ},
      IsPreconnected W →
      MeroAgreesHolo N n₀ U → MeroAgreesHolo D d₀ U →
      DifferentiableOn ℂ d₀ U →
      (∃ q₀ ∈ U, d₀ q₀ ≠ 0) →
      (∀ q ∈ U, n₀ q = f_target q * d₀ q) →
      ∃ Q : MeroOn2D W, MeroAgreesHolo Q f_target U := by
    intro W U N D n₀ d₀ f_target hW_preconn hN_ag hD_ag hd₀_holo ⟨q₀, hq₀U, hd₀_nz⟩ hcross
    let Z_plus : Set (ℂ × ℂ) := { p ∈ W | ∃ q ∈ Metric.ball p (D.rad p), D.num p q ≠ 0 }
    let Z_zero : Set (ℂ × ℂ) := { p ∈ W | ∀ q ∈ Metric.ball p (D.rad p), D.num p q = 0 }
    let O_plus : Set (ℂ × ℂ) := ⋃ p ∈ Z_plus, Metric.ball p (D.rad p)
    let O_zero : Set (ℂ × ℂ) := ⋃ p ∈ Z_zero, Metric.ball p (D.rad p)
    have hO_plus_open : IsOpen O_plus := isOpen_biUnion (fun _ _ => Metric.isOpen_ball)
    have hO_zero_open : IsOpen O_zero := isOpen_biUnion (fun _ _ => Metric.isOpen_ball)
    have h_disj : Disjoint O_plus O_zero := by
      rw [Set.disjoint_left]
      intro x hx_plus hx_zero
      obtain ⟨p₁, ⟨hp₁W, q₁, hq₁, hnz₁⟩, hx₁⟩ := Set.mem_iUnion₂.mp hx_plus
      obtain ⟨p₂, ⟨hp₂W, hzero₂⟩, hx₂⟩ := Set.mem_iUnion₂.mp hx_zero
      let O_ov := Metric.ball p₁ (D.rad p₁) ∩ Metric.ball p₂ (D.rad p₂)
      have hmul : ∀ z ∈ O_ov, D.num p₁ z * D.den p₂ z = 0 := by
        intro z hz
        rw [D.compat p₁ hp₁W p₂ hp₂W z hz, hzero₂ z hz.2, zero_mul]
      have hd₂_ex : ∃ z₀ ∈ O_ov, D.den p₂ z₀ ≠ 0 := by
        by_contra h_all
        push_neg at h_all
        obtain ⟨z_d, hz_d, hdz_nz⟩ := D.den_ne_zero p₂ hp₂W
        exact hdz_nz (hEqZeroConv2D Metric.isOpen_ball (convex_ball _ _)
          (Metric.isOpen_ball.inter Metric.isOpen_ball) ⟨x, hx₁, hx₂⟩ Set.inter_subset_right
          (D.den_holo p₂ hp₂W) h_all z_d hz_d)
      obtain ⟨z₀, hz₀O, hdz₀⟩ := hd₂_ex
      have hd₂_cont : ContinuousAt (D.den p₂) z₀ :=
        (D.den_holo p₂ hp₂W).continuousOn.continuousAt (Metric.isOpen_ball.mem_nhds hz₀O.2)
      obtain ⟨δ₁, hδ₁, hclose⟩ :=
        Metric.continuousAt_iff.mp hd₂_cont ‖D.den p₂ z₀‖ (norm_pos_iff.mpr hdz₀)
      obtain ⟨δ₂, hδ₂, hballO⟩ :=
        Metric.isOpen_iff.mp (Metric.isOpen_ball.inter Metric.isOpen_ball) z₀ hz₀O
      let δ := min δ₁ δ₂
      have hδ : 0 < δ := lt_min hδ₁ hδ₂
      have hball_sub_O : Metric.ball z₀ δ ⊆ O_ov :=
        (Metric.ball_subset_ball (min_le_right _ _)).trans hballO
      have hnum₁_zero_ball : ∀ z ∈ Metric.ball z₀ δ, D.num p₁ z = 0 := by
        intro z hz
        have hdz_ne : D.den p₂ z ≠ 0 := by
          intro h0
          have hlt := hclose (lt_of_lt_of_le (Metric.mem_ball.mp hz) (min_le_left _ _))
          rw [h0, dist_eq_norm, zero_sub, norm_neg] at hlt
          exact lt_irrefl _ hlt
        exact (mul_eq_zero.mp (hmul z (hball_sub_O hz))).resolve_right hdz_ne
      exact hnz₁ (hEqZeroConv2D Metric.isOpen_ball (convex_ball _ _) Metric.isOpen_ball
        ⟨z₀, Metric.mem_ball_self hδ⟩ (hball_sub_O.trans Set.inter_subset_left)
        (D.num_holo p₁ hp₁W) hnum₁_zero_ball q₁ hq₁)
    have h_cov : W ⊆ O_plus ∪ O_zero := by
      intro p hpW
      by_cases hex : ∃ q ∈ Metric.ball p (D.rad p), D.num p q ≠ 0
      · exact Or.inl (Set.mem_iUnion₂.mpr ⟨p, ⟨hpW, hex⟩, Metric.mem_ball_self (D.rad_pos p hpW)⟩)
      · push_neg at hex
        exact Or.inr (Set.mem_iUnion₂.mpr ⟨p, ⟨hpW, hex⟩, Metric.mem_ball_self (D.rad_pos p hpW)⟩)
    have hq₀_plus : q₀ ∈ O_plus := by
      have hq₀W : q₀ ∈ W := hD_ag.1 hq₀U
      obtain ⟨r₀, hr₀, hr₀_le, hr₀_sub, heq₀⟩ := hD_ag.2 q₀ hq₀U
      have hprod_nz := hBallMulNZ hr₀ (hd₀_holo.mono hr₀_sub)
        ((D.den_holo q₀ hq₀W).mono (Metric.ball_subset_ball hr₀_le))
        ⟨q₀, Metric.mem_ball_self hr₀, hd₀_nz⟩
        (hBallShrunkNZ hr₀ hr₀_le (D.den_holo q₀ hq₀W) (D.den_ne_zero q₀ hq₀W))
      obtain ⟨q_nz, hq_nz, hmul_nz⟩ := hprod_nz
      have hnum_nz : D.num q₀ q_nz ≠ 0 := by rw [heq₀ q_nz hq_nz]; exact hmul_nz
      exact Set.mem_iUnion₂.mpr ⟨q₀, ⟨hq₀W, q_nz, Metric.ball_subset_ball hr₀_le hq_nz, hnum_nz⟩,
        Metric.mem_ball_self (D.rad_pos q₀ hq₀W)⟩
    have hW_sub_plus : W ⊆ O_plus := by
      rcases hW_preconn.subset_or_subset hO_plus_open hO_zero_open h_disj h_cov with h1 | h2
      · exact h1
      · exact False.elim (Set.disjoint_left.mp h_disj hq₀_plus (h2 (hD_ag.1 hq₀U)))
    have hD_num_nz : ∀ p ∈ W, ∃ q ∈ Metric.ball p (D.rad p), D.num p q ≠ 0 := by
      intro p hpW
      by_contra h_none
      push_neg at h_none
      have hp_zero : p ∈ O_zero :=
        Set.mem_iUnion₂.mpr ⟨p, ⟨hpW, h_none⟩, Metric.mem_ball_self (D.rad_pos p hpW)⟩
      exact Set.disjoint_left.mp h_disj (hW_sub_plus hpW) hp_zero
    let Q : MeroOn2D W :=
      { rad := fun p => min (N.rad p) (D.rad p)
        num := fun p q => N.num p q * D.den p q
        den := fun p q => N.den p q * D.num p q
        rad_pos := fun p hp => lt_min (N.rad_pos p hp) (D.rad_pos p hp)
        ball_sub := fun p hp =>
          (Metric.ball_subset_ball (min_le_left _ _)).trans (N.ball_sub p hp)
        num_holo := fun p hp =>
          ((N.num_holo p hp).mono (Metric.ball_subset_ball (min_le_left _ _))).mul
            ((D.den_holo p hp).mono (Metric.ball_subset_ball (min_le_right _ _)))
        den_holo := fun p hp =>
          ((N.den_holo p hp).mono (Metric.ball_subset_ball (min_le_left _ _))).mul
            ((D.num_holo p hp).mono (Metric.ball_subset_ball (min_le_right _ _)))
        den_ne_zero := fun p hp => by
          have hr_min : 0 < min (N.rad p) (D.rad p) := lt_min (N.rad_pos p hp) (D.rad_pos p hp)
          exact hBallMulNZ hr_min
            ((N.den_holo p hp).mono (Metric.ball_subset_ball (min_le_left _ _)))
            ((D.num_holo p hp).mono (Metric.ball_subset_ball (min_le_right _ _)))
            (hBallShrunkNZ hr_min (min_le_left _ _) (N.den_holo p hp) (N.den_ne_zero p hp))
            (hBallShrunkNZ hr_min (min_le_right _ _) (D.num_holo p hp) (hD_num_nz p hp))
        compat := fun p₁ hp₁ p₂ hp₂ q hq => by
          have hN := N.compat p₁ hp₁ p₂ hp₂ q
            ⟨Metric.ball_subset_ball (min_le_left _ _) hq.1,
             Metric.ball_subset_ball (min_le_left _ _) hq.2⟩
          have hD := D.compat p₁ hp₁ p₂ hp₂ q
            ⟨Metric.ball_subset_ball (min_le_right _ _) hq.1,
             Metric.ball_subset_ball (min_le_right _ _) hq.2⟩
          linear_combination D.den p₁ q * D.num p₂ q * hN - N.num p₂ q * N.den p₁ q * hD }
    refine ⟨Q, hN_ag.1, fun p hpU => ?_⟩
    obtain ⟨rN, hrN, hrN_le, hrN_sub, heqN⟩ := hN_ag.2 p hpU
    obtain ⟨rD, hrD, hrD_le, _, heqD⟩ := hD_ag.2 p hpU
    refine ⟨min rN rD, lt_min hrN hrD, min_le_min hrN_le hrD_le,
      (Metric.ball_subset_ball (min_le_left _ _)).trans hrN_sub, fun q hq => ?_⟩
    have hqU : q ∈ U := hrN_sub (Metric.ball_subset_ball (min_le_left _ _) hq)
    dsimp only [Q]
    rw [heqN q (Metric.ball_subset_ball (min_le_left _ _) hq),
      heqD q (Metric.ball_subset_ball (min_le_right _ _) hq), hcross q hqU]
    ring

  have hPropagateHolo : ∀ {W U V : Set (ℂ × ℂ)} (M : MeroOn2D W) {f : ℂ × ℂ → ℂ},
      IsOpen U → IsPreconnected U → U ⊆ W →
      V.Nonempty → V ⊆ U →
      DifferentiableOn ℂ f U → MeroAgreesHolo M f V →
      ∀ p ∈ W, ∀ q ∈ Metric.ball p (M.rad p) ∩ U, M.num p q = f q * M.den p q := by
    intro W U V M f hU_open hU_preconn hUW ⟨v₀, hv₀V⟩ hVU hf_holo hAgV
    let r_U : ℂ × ℂ → ℝ := fun p =>
      if hp : p ∈ U then
        min (M.rad p) (Classical.choose (Metric.isOpen_iff.mp hU_open p hp))
      else 1
    have hr_U_spec : ∀ p ∈ U, 0 < r_U p ∧ r_U p ≤ M.rad p ∧ Metric.ball p (r_U p) ⊆ U := by
      intro p hp
      dsimp only [r_U]
      rw [dif_pos hp]
      have hc := Classical.choose_spec (Metric.isOpen_iff.mp hU_open p hp)
      exact ⟨lt_min (M.rad_pos p (hUW hp)) hc.1, min_le_left _ _,
        (Metric.ball_subset_ball (min_le_right _ _)).trans hc.2⟩
    let E_eq : Set (ℂ × ℂ) :=
      { p ∈ U | ∀ q ∈ Metric.ball p (r_U p), M.num p q = f q * M.den p q }
    let E_ne : Set (ℂ × ℂ) :=
      { p ∈ U | ∃ q ∈ Metric.ball p (r_U p), M.num p q ≠ f q * M.den p q }
    let O_eq : Set (ℂ × ℂ) := ⋃ p ∈ E_eq, Metric.ball p (r_U p)
    let O_ne : Set (ℂ × ℂ) := ⋃ p ∈ E_ne, Metric.ball p (r_U p)
    have hO_eq_open : IsOpen O_eq := isOpen_biUnion (fun _ _ => Metric.isOpen_ball)
    have hO_ne_open : IsOpen O_ne := isOpen_biUnion (fun _ _ => Metric.isOpen_ball)
    have h_disj : Disjoint O_eq O_ne := by
      rw [Set.disjoint_left]
      intro x hx_eq hx_ne
      obtain ⟨p₁, ⟨hp₁U, heq₁⟩, hx₁⟩ := Set.mem_iUnion₂.mp hx_eq
      obtain ⟨p₂, ⟨hp₂U, q₂, hq₂, hne₂⟩, hx₂⟩ := Set.mem_iUnion₂.mp hx_ne
      let O_ov := Metric.ball p₁ (r_U p₁) ∩ Metric.ball p₂ (r_U p₂)
      have hmul : ∀ z ∈ O_ov, (M.num p₂ z - f z * M.den p₂ z) * M.den p₁ z = 0 := by
        intro z hz
        have hc := M.compat p₁ (hUW hp₁U) p₂ (hUW hp₂U) z
          ⟨Metric.ball_subset_ball (hr_U_spec p₁ hp₁U).2.1 hz.1,
           Metric.ball_subset_ball (hr_U_spec p₂ hp₂U).2.1 hz.2⟩
        have h1 := heq₁ z hz.1
        linear_combination -hc + M.den p₂ z * h1
      have hdiff_holo : DifferentiableOn ℂ (fun z => M.num p₂ z - f z * M.den p₂ z)
          (Metric.ball p₂ (r_U p₂)) :=
        ((M.num_holo p₂ (hUW hp₂U)).mono (Metric.ball_subset_ball (hr_U_spec p₂ hp₂U).2.1)).sub
          ((hf_holo.mono (hr_U_spec p₂ hp₂U).2.2).mul
            ((M.den_holo p₂ (hUW hp₂U)).mono (Metric.ball_subset_ball (hr_U_spec p₂ hp₂U).2.1)))
      have hd₁_ex : ∃ z₀ ∈ O_ov, M.den p₁ z₀ ≠ 0 := by
        by_contra h_all
        push_neg at h_all
        obtain ⟨z_d, hz_d, hdz_nz⟩ := M.den_ne_zero p₁ (hUW hp₁U)
        exact hdz_nz (hEqZeroConv2D Metric.isOpen_ball (convex_ball _ _)
          (Metric.isOpen_ball.inter Metric.isOpen_ball) ⟨x, hx₁, hx₂⟩
          (Set.inter_subset_left.trans (Metric.ball_subset_ball (hr_U_spec p₁ hp₁U).2.1))
          (M.den_holo p₁ (hUW hp₁U)) h_all z_d hz_d)
      obtain ⟨z₀, hz₀O, hdz₀⟩ := hd₁_ex
      have hd₁_cont : ContinuousAt (M.den p₁) z₀ :=
        (M.den_holo p₁ (hUW hp₁U)).continuousOn.continuousAt
          (Metric.isOpen_ball.mem_nhds (Metric.ball_subset_ball (hr_U_spec p₁ hp₁U).2.1 hz₀O.1))
      obtain ⟨δ₁, hδ₁, hclose⟩ :=
        Metric.continuousAt_iff.mp hd₁_cont ‖M.den p₁ z₀‖ (norm_pos_iff.mpr hdz₀)
      obtain ⟨δ₂, hδ₂, hballO⟩ :=
        Metric.isOpen_iff.mp (Metric.isOpen_ball.inter Metric.isOpen_ball) z₀ hz₀O
      let δ := min δ₁ δ₂
      have hδ : 0 < δ := lt_min hδ₁ hδ₂
      have hball_sub_O : Metric.ball z₀ δ ⊆ O_ov :=
        (Metric.ball_subset_ball (min_le_right _ _)).trans hballO
      have hzero_ball : ∀ z ∈ Metric.ball z₀ δ, M.num p₂ z - f z * M.den p₂ z = 0 := by
        intro z hz
        have hdz_ne : M.den p₁ z ≠ 0 := by
          intro h0
          have hlt := hclose (lt_of_lt_of_le (Metric.mem_ball.mp hz) (min_le_left _ _))
          rw [h0, dist_eq_norm, zero_sub, norm_neg] at hlt
          exact lt_irrefl _ hlt
        exact (mul_eq_zero.mp (hmul z (hball_sub_O hz))).resolve_right hdz_ne
      have hzero_all := hEqZeroConv2D Metric.isOpen_ball (convex_ball _ _) Metric.isOpen_ball
        ⟨z₀, Metric.mem_ball_self hδ⟩ (hball_sub_O.trans Set.inter_subset_right)
        hdiff_holo hzero_ball q₂ hq₂
      exact hne₂ (sub_eq_zero.mp hzero_all)
    have h_cov : U ⊆ O_eq ∪ O_ne := by
      intro p hpU
      by_cases hall : ∀ q ∈ Metric.ball p (r_U p), M.num p q = f q * M.den p q
      · exact Or.inl (Set.mem_iUnion₂.mpr ⟨p, ⟨hpU, hall⟩, Metric.mem_ball_self (hr_U_spec p hpU).1⟩)
      · push_neg at hall
        exact Or.inr (Set.mem_iUnion₂.mpr ⟨p, ⟨hpU, hall⟩, Metric.mem_ball_self (hr_U_spec p hpU).1⟩)
    have hv₀_eq : v₀ ∈ O_eq := by
      have hv₀U : v₀ ∈ U := hVU hv₀V
      obtain ⟨r_v, hr_v, _, _, heq_v⟩ := hAgV.2 v₀ hv₀V
      let r_min := min r_v (r_U v₀)
      have hr_min : 0 < r_min := lt_min hr_v (hr_U_spec v₀ hv₀U).1
      have hdiff_holo : DifferentiableOn ℂ (fun z => M.num v₀ z - f z * M.den v₀ z)
          (Metric.ball v₀ (r_U v₀)) :=
        ((M.num_holo v₀ (hUW hv₀U)).mono (Metric.ball_subset_ball (hr_U_spec v₀ hv₀U).2.1)).sub
          ((hf_holo.mono (hr_U_spec v₀ hv₀U).2.2).mul
            ((M.den_holo v₀ (hUW hv₀U)).mono (Metric.ball_subset_ball (hr_U_spec v₀ hv₀U).2.1)))
      have hzero_small : ∀ z ∈ Metric.ball v₀ r_min, M.num v₀ z - f z * M.den v₀ z = 0 :=
        fun z hz => sub_eq_zero.mpr (heq_v z (Metric.ball_subset_ball (min_le_left _ _) hz))
      have hall : ∀ q ∈ Metric.ball v₀ (r_U v₀), M.num v₀ q = f q * M.den v₀ q := fun q hq =>
        sub_eq_zero.mp (hEqZeroConv2D Metric.isOpen_ball (convex_ball _ _) Metric.isOpen_ball
          ⟨v₀, Metric.mem_ball_self hr_min⟩ (Metric.ball_subset_ball (min_le_right _ _))
          hdiff_holo hzero_small q hq)
      exact Set.mem_iUnion₂.mpr ⟨v₀, ⟨hv₀U, hall⟩, Metric.mem_ball_self (hr_U_spec v₀ hv₀U).1⟩
    have hU_sub_eq : U ⊆ O_eq := by
      rcases hU_preconn.subset_or_subset hO_eq_open hO_ne_open h_disj h_cov with h1 | h2
      · exact h1
      · exact False.elim (Set.disjoint_left.mp h_disj hv₀_eq (h2 (hVU hv₀V)))
    have hE_eq_all : ∀ p ∈ U, ∀ q ∈ Metric.ball p (r_U p), M.num p q = f q * M.den p q := by
      intro p hpU
      by_contra h_not
      push_neg at h_not
      have hp_ne : p ∈ O_ne :=
        Set.mem_iUnion₂.mpr ⟨p, ⟨hpU, h_not⟩, Metric.mem_ball_self (hr_U_spec p hpU).1⟩
      exact Set.disjoint_left.mp h_disj (hU_sub_eq hpU) hp_ne
    intro p hpW q ⟨hq_ball, hqU⟩
    let ρ_q := min (r_U q) (M.rad p - dist q p)
    have hρ_q : 0 < ρ_q := lt_min (hr_U_spec q hqU).1 (sub_pos.mpr (Metric.mem_ball.mp hq_ball))
    have hsub_p : Metric.ball q ρ_q ⊆ Metric.ball p (M.rad p) := by
      intro z hz
      rw [Metric.mem_ball] at hz ⊢
      have hz2 : dist z q < M.rad p - dist q p := lt_of_lt_of_le hz (min_le_right _ _)
      linarith [dist_triangle z q p]
    have hsub_q : Metric.ball q ρ_q ⊆ Metric.ball q (r_U q) :=
      Metric.ball_subset_ball (min_le_left _ _)
    have hmul : ∀ z ∈ Metric.ball q ρ_q, (M.num p z - f z * M.den p z) * M.den q z = 0 := by
      intro z hz
      have hc := M.compat p hpW q (hUW hqU) z
        ⟨hsub_p hz, Metric.ball_subset_ball (hr_U_spec q hqU).2.1 (hsub_q hz)⟩
      have hq_eq := hE_eq_all q hqU z (hsub_q hz)
      linear_combination hc + M.den p z * hq_eq
    have hdiff_holo : DifferentiableOn ℂ (fun z => M.num p z - f z * M.den p z)
        (Metric.ball q ρ_q) :=
      ((M.num_holo p hpW).mono hsub_p).sub
        ((hf_holo.mono (hsub_q.trans (hr_U_spec q hqU).2.2)).mul ((M.den_holo p hpW).mono hsub_p))
    have hdq_holo : DifferentiableOn ℂ (M.den q) (Metric.ball q ρ_q) :=
      (M.den_holo q (hUW hqU)).mono (hsub_q.trans (Metric.ball_subset_ball (hr_U_spec q hqU).2.1))
    have hdq_nz : ∃ z ∈ Metric.ball q ρ_q, M.den q z ≠ 0 :=
      hBallShrunkNZ hρ_q ((min_le_left _ _).trans (hr_U_spec q hqU).2.1)
        (M.den_holo q (hUW hqU)) (M.den_ne_zero q (hUW hqU))
    have hzero := hCancelDenOnBall Metric.isOpen_ball ⟨q, Metric.mem_ball_self hρ_q⟩
      Subset.rfl hdiff_holo hdq_holo hdq_nz hmul q (Metric.mem_ball_self hρ_q)
    exact sub_eq_zero.mp hzero

  have hGlueLower : ∀ (F_init : Fin 2 → ℂ × ℂ → ℂ) {t : ℂ} {b δ : ℝ},
      (∀ i : Fin 2, DifferentiableOn ℂ (F_init i) S_two) →
      s_base < b → 0 < δ → Metric.ball t δ ⊆ B →
      ∀ G : Fin 2 → MeroOn2D (cyl (-s_base) b t δ),
      (∀ i : Fin 2, MeroAgreesHolo (G i) (F_init i)
        ({ y : ℂ | |y.im| < s_base } ×ˢ Metric.ball t δ)) →
      ∃ G_ext : Fin 2 → MeroOn2D (cyl (-2 * s_base) b t δ),
        ∀ i : Fin 2, MeroAgreesHolo (G_ext i) (F_init i)
          (cyl (-2 * s_base) (min b (2 * s_base)) t δ) := by
    intro F_init t b δ hF_holo hb hδ hδ_sub G hG
    let b_h : ℝ := min b (2 * s_base)
    have hb_h_gt : s_base < b_h := lt_min hb (by linarith)
    let W_up := cyl (-s_base) b t δ
    let W_ext := cyl (-2 * s_base) b t δ
    let W_holo := cyl (-2 * s_base) b_h t δ
    let W_ov := cyl (-s_base) b_h t δ
    have hWholo_open : IsOpen W_holo := hCylOpen (-2 * s_base) b_h t δ
    have hWholo_sub_two : W_holo ⊆ S_two := by
      rintro ⟨y, t'⟩ ⟨⟨hy1, hy2⟩, ht'⟩
      have hb_h_le : b_h ≤ 2 * s_base := min_le_right _ _
      refine ⟨abs_lt.mpr ⟨by linarith, lt_of_lt_of_le hy2 hb_h_le⟩, ?_⟩
      simpa [B, Metric.mem_ball, dist_zero_right] using hδ_sub ht'
    have hWholo_sub_ext : W_holo ⊆ W_ext :=
      fun p hp => ⟨⟨hp.1.1, lt_of_lt_of_le hp.1.2 (min_le_left _ _)⟩, hp.2⟩
    have hExt_not_holo : ∀ p ∈ W_ext, p ∉ W_holo → p ∈ W_up := by
      rintro ⟨y, t'⟩ ⟨⟨hy1, hy2⟩, ht'⟩ hnot
      have hge : b_h ≤ y.im := by
        by_contra hlt
        exact hnot ⟨⟨hy1, not_le.mp hlt⟩, ht'⟩
      exact ⟨⟨by linarith [hb_h_gt, hs_pos], hy2⟩, ht'⟩
    have hOv_prop : ∀ i : Fin 2, ∀ p ∈ W_up,
        ∀ q ∈ Metric.ball p ((G i).rad p) ∩ W_holo,
          (G i).num p q = F_init i q * (G i).den p q := by
      intro i p hp q ⟨hq_ball, hq_holo⟩
      have hq_up : q ∈ W_up := (G i).ball_sub p hp hq_ball
      have hq_ov : q ∈ W_ov := ⟨⟨hq_up.1.1, hq_holo.1.2⟩, hq_up.2⟩
      have hG_cyl : MeroAgreesHolo (G i) (F_init i) (cyl (-s_base) s_base t δ) := by
        rw [← hBaseCylEq]; exact hG i
      exact hPropagateHolo (G i) (hCylOpen (-s_base) b_h t δ) (hCylPreconn (-s_base) b_h t δ)
        (fun r hr => ⟨⟨hr.1.1, lt_of_lt_of_le hr.1.2 (min_le_left _ _)⟩, hr.2⟩)
        (hCylNonempty (by linarith) hδ)
        (fun r hr => ⟨⟨hr.1.1, lt_trans hr.1.2 hb_h_gt⟩, hr.2⟩)
        ((hF_holo i).mono (fun r hr => hWholo_sub_two ⟨⟨by linarith [hr.1.1, hs_pos], hr.1.2⟩, hr.2⟩))
        hG_cyl p hp q ⟨hq_ball, hq_ov⟩
    let r_holo : ℂ × ℂ → ℝ := fun p =>
      if hp : p ∈ W_holo then Classical.choose (Metric.isOpen_iff.mp hWholo_open p hp) else 1
    have hr_holo_spec : ∀ p ∈ W_holo, 0 < r_holo p ∧ Metric.ball p (r_holo p) ⊆ W_holo := by
      intro p hp
      dsimp only [r_holo]
      rw [dif_pos hp]
      exact Classical.choose_spec (Metric.isOpen_iff.mp hWholo_open p hp)
    let G_ext : Fin 2 → MeroOn2D W_ext := fun i =>
      { rad := fun p => if p ∈ W_holo then r_holo p else (G i).rad p
        num := fun p => if p ∈ W_holo then F_init i else (G i).num p
        den := fun p => if p ∈ W_holo then (fun _ => 1) else (G i).den p
        rad_pos := fun p hp => by
          by_cases hph : p ∈ W_holo
          · simp only [if_pos hph]; exact (hr_holo_spec p hph).1
          · simp only [if_neg hph]; exact (G i).rad_pos p (hExt_not_holo p hp hph)
        ball_sub := fun p hp => by
          by_cases hph : p ∈ W_holo
          · simp only [if_pos hph]; exact ((hr_holo_spec p hph).2).trans hWholo_sub_ext
          · simp only [if_neg hph]
            exact ((G i).ball_sub p (hExt_not_holo p hp hph)).trans
              (fun q hq => ⟨⟨by linarith [hq.1.1, hs_pos], hq.1.2⟩, hq.2⟩)
        num_holo := fun p hp => by
          by_cases hph : p ∈ W_holo
          · simp only [if_pos hph]
            exact (hF_holo i).mono (((hr_holo_spec p hph).2).trans hWholo_sub_two)
          · simp only [if_neg hph]; exact (G i).num_holo p (hExt_not_holo p hp hph)
        den_holo := fun p hp => by
          by_cases hph : p ∈ W_holo
          · simp only [if_pos hph]; exact differentiableOn_const 1
          · simp only [if_neg hph]; exact (G i).den_holo p (hExt_not_holo p hp hph)
        den_ne_zero := fun p hp => by
          by_cases hph : p ∈ W_holo
          · simp only [if_pos hph]
            exact ⟨p, Metric.mem_ball_self (hr_holo_spec p hph).1, one_ne_zero⟩
          · simp only [if_neg hph]; exact (G i).den_ne_zero p (hExt_not_holo p hp hph)
        compat := fun p₁ hp₁ p₂ hp₂ q hq => by
          by_cases h1 : p₁ ∈ W_holo <;> by_cases h2 : p₂ ∈ W_holo
          · simp only [if_pos h1, if_pos h2]
          · simp only [if_pos h1, if_neg h2] at hq ⊢
            have hq_holo : q ∈ W_holo := (hr_holo_spec p₁ h1).2 hq.1
            rw [hOv_prop i p₂ (hExt_not_holo p₂ hp₂ h2) q ⟨hq.2, hq_holo⟩, mul_one]
          · simp only [if_neg h1, if_pos h2] at hq ⊢
            have hq_holo : q ∈ W_holo := (hr_holo_spec p₂ h2).2 hq.2
            rw [hOv_prop i p₁ (hExt_not_holo p₁ hp₁ h1) q ⟨hq.1, hq_holo⟩, mul_one]
          · simp only [if_neg h1, if_neg h2] at hq ⊢
            exact (G i).compat p₁ (hExt_not_holo p₁ hp₁ h1) p₂ (hExt_not_holo p₂ hp₂ h2) q hq }
    refine ⟨G_ext, fun i => ⟨hWholo_sub_ext, fun p hp => ?_⟩⟩
    have hp_holo : p ∈ W_holo := hp
    refine ⟨r_holo p, (hr_holo_spec p hp_holo).1, ?_, (hr_holo_spec p hp_holo).2, fun q _ => ?_⟩
    · simp only [G_ext, if_pos hp_holo, le_refl]
    · simp only [G_ext, if_pos hp_holo, mul_one]

  have hNonzeroOnSubCyl : ∀ {t : ℂ} {δ₁ : ℝ} {d₀ : ℂ × ℂ → ℂ},
      0 < δ₁ → Metric.ball t δ₁ ⊆ B →
      DifferentiableOn ℂ d₀ S_base → (∃ q_nz ∈ S_base, d₀ q_nz ≠ 0) →
      ∃ q₀ ∈ cyl (-s_base) s_base t δ₁, d₀ q₀ ≠ 0 := by
    intro t δ₁ d₀ hδ₁ hsub hd₀ ⟨q_nz, hq_nz, hnz⟩
    by_contra h_all
    push_neg at h_all
    have hS_open : IsOpen S_base := by rw [hS_base_eq]; exact hCylOpen (-s_base) s_base 0 r_base
    have hS_conv : Convex ℝ S_base := by rw [hS_base_eq]; exact hCylConv (-s_base) s_base 0 r_base
    have hU_sub : cyl (-s_base) s_base t δ₁ ⊆ S_base := by
      rw [hS_base_eq]; exact fun p hp => ⟨hp.1, hsub hp.2⟩
    exact hnz (hEqZeroConv2D hS_open hS_conv (hCylOpen (-s_base) s_base t δ₁)
      (hCylNonempty (by linarith) hδ₁) hU_sub hd₀ h_all q_nz hq_nz)

  have hShiftSBaseToTwo : ∀ (α : ℝ), |α| ≤ 3 / 2 → ∀ p ∈ S_base, shiftMap α p ∈ S_two := by
    rintro α hα ⟨y, t'⟩ ⟨hy, ht'⟩
    refine ⟨?_, ht'⟩
    change |(y + (α : ℂ) * t').im| < 2 * s_base
    have him : (y + (α : ℂ) * t').im = y.im + α * t'.im := by simp
    have ht'_im : |t'.im| < s_base / 4 := lt_of_le_of_lt (Complex.abs_im_le_norm t') (lt_trans ht' hr_lt_s4)
    have hmul : |α * t'.im| ≤ (3 / 2) * (s_base / 4) := by
      rw [abs_mul]
      exact mul_le_mul hα (le_of_lt ht'_im) (abs_nonneg _) (by norm_num)
    rw [him]
    linarith [abs_add_le y.im (α * t'.im)]

  let cramerDenL : ℂ × ℂ → ℂ := cramerDen F_L
  have hCramerDenHolo : DifferentiableOn ℂ cramerDenL S_base := by
    have h_p : ∀ i : Fin 2, DifferentiableOn ℂ (fun p : ℂ × ℂ => F_L i (p.1 + p.2 / 2, p.2)) S_base := by
      intro i
      have heq : (fun p : ℂ × ℂ => F_L i (p.1 + p.2 / 2, p.2)) =
          (fun p : ℂ × ℂ => F_L i (shiftMap (1 / 2) p)) := by
        ext p; congr 1; ext <;> simp [shiftMap]; ring
      rw [heq]
      exact (hFL_holo i).comp (hShiftDiff (1 / 2)).differentiableOn
        (hShiftSBaseToTwo (1 / 2) (by norm_num))
    have h_m : ∀ i : Fin 2, DifferentiableOn ℂ (fun p : ℂ × ℂ => F_L i (p.1 - p.2 / 2, p.2)) S_base := by
      intro i
      have heq : (fun p : ℂ × ℂ => F_L i (p.1 - p.2 / 2, p.2)) =
          (fun p : ℂ × ℂ => F_L i (shiftMap (-1 / 2) p)) := by
        ext p; congr 1; ext <;> simp [shiftMap]; ring
      rw [heq]
      exact (hFL_holo i).comp (hShiftDiff (-1 / 2)).differentiableOn
        (hShiftSBaseToTwo (-1 / 2) (by norm_num))
    exact ((h_p 0).mul (h_m 1)).sub ((h_p 1).mul (h_m 0))

  let reflNumX : Fin 2 → ℂ × ℂ → ℂ := reflNum F_X
  let reflDenX : ℂ × ℂ → ℂ := reflDen F_X
  have hReflDenHolo : DifferentiableOn ℂ reflDenX S_base := by
    have hS_open : IsOpen S_base := by rw [hS_base_eq]; exact hCylOpen (-s_base) s_base 0 r_base
    have h_m : ∀ i : Fin 2, DifferentiableOn ℂ (fun p : ℂ × ℂ => F_X i (p.1 - p.2 / 2, p.2)) S_base := by
      intro i
      have heq : (fun p : ℂ × ℂ => F_X i (p.1 - p.2 / 2, p.2)) =
          (fun p : ℂ × ℂ => F_X i (shiftMap (-1 / 2) p)) := by
        ext p; congr 1; ext <;> simp [shiftMap]; ring
      rw [heq]
      exact (hFX_holo i).comp (hShiftDiff (-1 / 2)).differentiableOn
        (hShiftSBaseToTwo (-1 / 2) (by norm_num))
    have h_m3 : ∀ i : Fin 2, DifferentiableOn ℂ (fun p : ℂ × ℂ => F_X i (p.1 - 3 * p.2 / 2, p.2)) S_base := by
      intro i
      have heq : (fun p : ℂ × ℂ => F_X i (p.1 - 3 * p.2 / 2, p.2)) =
          (fun p : ℂ × ℂ => F_X i (shiftMap (-3 / 2) p)) := by
        ext p; congr 1; ext <;> simp [shiftMap]; ring
      rw [heq]
      exact (hFX_holo i).comp (hShiftDiff (-3 / 2)).differentiableOn
        (hShiftSBaseToTwo (-3 / 2) (by norm_num))
    have hn0 : DifferentiableOn ℂ (fun p => iterDerivY 1 (fun q => F_X 1 (q.1 - q.2 / 2, q.2)) p) S_base :=
      hPartialYHolo hS_open (h_m 1)
    have hn1 : DifferentiableOn ℂ (fun p => -iterDerivY 1 (fun q => F_X 0 (q.1 - q.2 / 2, q.2)) p) S_base :=
      (hPartialYHolo hS_open (h_m 0)).neg
    have hw0 := (h_m 1).sub (h_m3 1)
    have hw1 := (h_m3 0).sub (h_m 0)
    have hwn := (hw0.mul hn0).add (hw1.mul hn1)
    have hnn := (hn0.mul hn0).add (hn1.mul hn1)
    have hnum0 : DifferentiableOn ℂ (reflNumX 0) S_base :=
      ((hwn.add hwn).mul hn0).sub (hnn.mul hw0)
    have hnum1 : DifferentiableOn ℂ (reflNumX 1) S_base :=
      ((hwn.add hwn).mul hn1).sub (hnn.mul hw1)
    exact (hnum0.mul (h_m 0)).add (hnum1.mul (h_m 1))

  
  have hL_to_X : ∀ t ∈ B, ∀ b b₁ : ℝ,
      IsCollarHeightWitness s_base r_base F_L t b →
      s_base < b₁ → b₁ < b - |t.im| / 2 →
      IsCollarHeightWitness s_base r_base F_X t b₁ := by
    rintro t _ b b₁ ⟨hb, δ, hδ, hδ_sub, G_L, hGL_ag⟩ hb₁_lo hb₁_hi
    obtain ⟨G_ext, hGext_ag⟩ := hGlueLower F_L hFL_holo hb hδ hδ_sub G_L hGL_ag
    let Δ : ℝ := b - |t.im| / 2 - b₁
    have hΔ : 0 < Δ := by dsimp [Δ]; linarith
    let δ₁ : ℝ := min δ Δ
    have hδ₁ : 0 < δ₁ := lt_min hδ hΔ
    have hδ₁_sub : Metric.ball t δ₁ ⊆ B :=
      (Metric.ball_subset_ball (min_le_left _ _)).trans hδ_sub
    let W₁ := cyl (-s_base) b₁ t δ₁
    let U₀ := cyl (-s_base) s_base t δ₁
    have hW₁_open : IsOpen W₁ := hCylOpen (-s_base) b₁ t δ₁
    have hU₀_open : IsOpen U₀ := hCylOpen (-s_base) s_base t δ₁
    have hU₀_sub_W₁ : U₀ ⊆ W₁ := fun p hp => ⟨⟨hp.1.1, lt_trans hp.1.2 hb₁_lo⟩, hp.2⟩
    have hU₀_sub_S : U₀ ⊆ S_base := by
      rw [hS_base_eq]; exact fun p hp => ⟨hp.1, hδ₁_sub hp.2⟩
    have hShiftW₁ : ∀ (α : ℝ), (α = 1 / 2 ∨ α = -1 / 2) →
        ∀ p ∈ W₁, shiftMap α p ∈ cyl (-2 * s_base) b t δ := by
      rintro α hα ⟨y, t'⟩ ⟨⟨hy1, hy2⟩, ht'⟩
      refine ⟨?_, Metric.ball_subset_ball (min_le_left _ _) ht'⟩
      have ht'B : ‖t'‖ < r_base := by
        simpa [B, Metric.mem_ball, dist_zero_right] using hδ₁_sub ht'
      have ht'_im_s : |t'.im| < s_base / 4 :=
        lt_of_le_of_lt (Complex.abs_im_le_norm t') (lt_trans ht'B hr_lt_s4)
      have ht'_s_bounds := abs_lt.mp ht'_im_s
      have hdiff_im : |t'.im - t.im| < Δ := by
        have h1 : |(t' - t).im| ≤ ‖t' - t‖ := Complex.abs_im_le_norm (t' - t)
        have h2 : ‖t' - t‖ < Δ := by
          have hd : dist t' t < δ₁ := Metric.mem_ball.mp ht'
          rw [dist_eq_norm] at hd
          exact lt_of_lt_of_le hd (min_le_right _ _)
        simpa using lt_of_le_of_lt h1 h2
      have hdiff_bounds := abs_lt.mp hdiff_im
      have ht_abs1 : -|t.im| ≤ t.im := neg_abs_le t.im
      have ht_abs2 : t.im ≤ |t.im| := le_abs_self t.im
      change -2 * s_base < (y + (α : ℂ) * t').im ∧ (y + (α : ℂ) * t').im < b
      have him : (y + (α : ℂ) * t').im = y.im + α * t'.im := by simp
      rw [him]
      rcases hα with rfl | rfl <;> exact ⟨by linarith, by dsimp [Δ] at hdiff_bounds; linarith⟩
    have hShiftU₀ : ∀ (α : ℝ), (α = 1 / 2 ∨ α = -1 / 2) →
        ∀ p ∈ U₀, shiftMap α p ∈ cyl (-2 * s_base) (min b (2 * s_base)) t δ := by
      rintro α hα p hp
      have hw := hShiftW₁ α hα p (hU₀_sub_W₁ hp)
      refine ⟨⟨hw.1.1, lt_min hw.1.2 ?_⟩, hw.2⟩
      have ht'B : ‖p.2‖ < r_base := by
        simpa [B, Metric.mem_ball, dist_zero_right] using hδ₁_sub hp.2
      have ht'_im_s := abs_lt.mp (lt_of_le_of_lt (Complex.abs_im_le_norm p.2) (lt_trans ht'B hr_lt_s4))
      have him : (shiftMap α p).1.im = p.1.im + α * p.2.im := by simp [shiftMap]
      rw [him]
      rcases hα with rfl | rfl <;> linarith [hp.1.2]
    let L_p : Fin 2 → MeroOn2D W₁ := fun c =>
      meroPullbackShift (1 / 2) hW₁_open (hShiftW₁ (1 / 2) (Or.inl rfl)) (G_ext c)
    let L_m : Fin 2 → MeroOn2D W₁ := fun c =>
      meroPullbackShift (-1 / 2) hW₁_open (hShiftW₁ (-1 / 2) (Or.inr rfl)) (G_ext c)
    have hLp_ag : ∀ c : Fin 2, MeroAgreesHolo (L_p c) (fun q => F_L c (q.1 + q.2 / 2, q.2)) U₀ := by
      intro c
      have h := meroPullbackShift_agrees (1 / 2) hW₁_open (hShiftW₁ (1 / 2) (Or.inl rfl))
        (hGext_ag c) hU₀_open hU₀_sub_W₁ (hShiftU₀ (1 / 2) (Or.inl rfl))
      have heq : (fun q : ℂ × ℂ => F_L c (shiftMap (1 / 2) q)) =
          (fun q : ℂ × ℂ => F_L c (q.1 + q.2 / 2, q.2)) := by
        ext q; congr 1; ext <;> simp [shiftMap]; ring
      rwa [heq] at h
    have hLm_ag : ∀ c : Fin 2, MeroAgreesHolo (L_m c) (fun q => F_L c (q.1 - q.2 / 2, q.2)) U₀ := by
      intro c
      have h := meroPullbackShift_agrees (-1 / 2) hW₁_open (hShiftW₁ (-1 / 2) (Or.inr rfl))
        (hGext_ag c) hU₀_open hU₀_sub_W₁ (hShiftU₀ (-1 / 2) (Or.inr rfl))
      have heq : (fun q : ℂ × ℂ => F_L c (shiftMap (-1 / 2) q)) =
          (fun q : ℂ × ℂ => F_L c (q.1 - q.2 / 2, q.2)) := by
        ext q; congr 1; ext <;> simp [shiftMap]; ring
      rwa [heq] at h
    let D_mero : MeroOn2D W₁ := meroSub (meroMul (L_p 0) (L_m 1)) (meroMul (L_p 1) (L_m 0))
    have hD_ag : MeroAgreesHolo D_mero cramerDenL U₀ :=
      meroSub_agrees (meroMul_agrees (hLp_ag 0) (hLm_ag 1)) (meroMul_agrees (hLp_ag 1) (hLm_ag 0))
    let N_mero : Fin 2 → MeroOn2D W₁ :=
      ![meroSub (L_m 1) (L_p 1), meroSub (L_p 0) (L_m 0)]
    have hCr_nz_U₀ : ∃ q₀ ∈ U₀, cramerDenL q₀ ≠ 0 :=
      hNonzeroOnSubCyl hδ₁ hδ₁_sub hCramerDenHolo hs1_nz
    have hDiv_i : ∀ i : Fin 2, ∃ Q_i : MeroOn2D W₁, MeroAgreesHolo Q_i (F_X i) U₀ := by
      intro i
      fin_cases i
      · exact meroDiv_exists (N_mero 0) D_mero (hCylPreconn (-s_base) b₁ t δ₁)
          (meroSub_agrees (hLm_ag 1) (hLp_ag 1)) hD_ag (hCramerDenHolo.mono hU₀_sub_S) hCr_nz_U₀
          (fun q hq => by simpa [cramerNum, cramerDenL] using hs1_eq q (hU₀_sub_S hq) 0)
      · exact meroDiv_exists (N_mero 1) D_mero (hCylPreconn (-s_base) b₁ t δ₁)
          (meroSub_agrees (hLp_ag 0) (hLm_ag 0)) hD_ag (hCramerDenHolo.mono hU₀_sub_S) hCr_nz_U₀
          (fun q hq => by simpa [cramerNum, cramerDenL] using hs1_eq q (hU₀_sub_S hq) 1)
    refine ⟨hb₁_lo, δ₁, hδ₁, hδ₁_sub, fun i => Classical.choose (hDiv_i i), fun i => ?_⟩
    rw [hBaseCylEq]
    exact Classical.choose_spec (hDiv_i i)

  have hX_to_L_nonneg : ∀ t ∈ B, 0 ≤ t.im → ∀ b' b₁ : ℝ,
      IsCollarHeightWitness s_base r_base F_X t b' →
      s_base < b₁ → b₁ < b' + t.im / 2 →
      IsCollarHeightWitness s_base r_base F_L t b₁ := by
    rintro t _ ht_im b' b₁ ⟨hb', δ, hδ, hδ_sub, G_X, hGX_ag⟩ hb₁_lo hb₁_hi
    obtain ⟨G_ext, hGext_ag⟩ := hGlueLower F_X hFX_holo hb' hδ hδ_sub G_X hGX_ag
    let Δ : ℝ := b' + t.im / 2 - b₁
    have hΔ : 0 < Δ := by dsimp [Δ]; linarith
    let δ₁ : ℝ := min δ (Δ / 2)
    have hδ₁ : 0 < δ₁ := lt_min hδ (half_pos hΔ)
    have hδ₁_sub : Metric.ball t δ₁ ⊆ B :=
      (Metric.ball_subset_ball (min_le_left _ _)).trans hδ_sub
    let W₁ := cyl (-s_base) b₁ t δ₁
    let U₀ := cyl (-s_base) s_base t δ₁
    have hW₁_open : IsOpen W₁ := hCylOpen (-s_base) b₁ t δ₁
    have hU₀_open : IsOpen U₀ := hCylOpen (-s_base) s_base t δ₁
    have hU₀_sub_W₁ : U₀ ⊆ W₁ := fun p hp => ⟨⟨hp.1.1, lt_trans hp.1.2 hb₁_lo⟩, hp.2⟩
    have hU₀_sub_S : U₀ ⊆ S_base := by
      rw [hS_base_eq]; exact fun p hp => ⟨hp.1, hδ₁_sub hp.2⟩
    have hShiftW₁ : ∀ (α : ℝ), (α = -1 / 2 ∨ α = -3 / 2) →
        ∀ p ∈ W₁, shiftMap α p ∈ cyl (-2 * s_base) b' t δ := by
      rintro α hα ⟨y, t'⟩ ⟨⟨hy1, hy2⟩, ht'⟩
      refine ⟨?_, Metric.ball_subset_ball (min_le_left _ _) ht'⟩
      have ht'B : ‖t'‖ < r_base := by
        simpa [B, Metric.mem_ball, dist_zero_right] using hδ₁_sub ht'
      have ht'_s_bounds := abs_lt.mp (lt_of_le_of_lt (Complex.abs_im_le_norm t') (lt_trans ht'B hr_lt_s4))
      have hdiff_im : |t'.im - t.im| < Δ / 2 := by
        have h1 : |(t' - t).im| ≤ ‖t' - t‖ := Complex.abs_im_le_norm (t' - t)
        have h2 : ‖t' - t‖ < Δ / 2 := by
          have hd : dist t' t < δ₁ := Metric.mem_ball.mp ht'
          rw [dist_eq_norm] at hd
          exact lt_of_lt_of_le hd (min_le_right _ _)
        simpa using lt_of_le_of_lt h1 h2
      have hdiff_bounds := abs_lt.mp hdiff_im
      change -2 * s_base < (y + (α : ℂ) * t').im ∧ (y + (α : ℂ) * t').im < b'
      have him : (y + (α : ℂ) * t').im = y.im + α * t'.im := by simp
      rw [him]
      rcases hα with rfl | rfl <;> exact ⟨by linarith, by dsimp [Δ] at hdiff_bounds; linarith⟩
    have hShiftU₀ : ∀ (α : ℝ), (α = -1 / 2 ∨ α = -3 / 2) →
        ∀ p ∈ U₀, shiftMap α p ∈ cyl (-2 * s_base) (min b' (2 * s_base)) t δ := by
      rintro α hα p hp
      have hw := hShiftW₁ α hα p (hU₀_sub_W₁ hp)
      refine ⟨⟨hw.1.1, lt_min hw.1.2 ?_⟩, hw.2⟩
      have ht'B : ‖p.2‖ < r_base := by
        simpa [B, Metric.mem_ball, dist_zero_right] using hδ₁_sub hp.2
      have ht'_im_s := abs_lt.mp (lt_of_le_of_lt (Complex.abs_im_le_norm p.2) (lt_trans ht'B hr_lt_s4))
      have him : (shiftMap α p).1.im = p.1.im + α * p.2.im := by simp [shiftMap]
      rw [him]
      rcases hα with rfl | rfl <;> linarith [hp.1.2]
    let P_0 : Fin 2 → MeroOn2D W₁ := fun c =>
      meroPullbackShift (-1 / 2) hW₁_open (hShiftW₁ (-1 / 2) (Or.inl rfl)) (G_ext c)
    let P_m : Fin 2 → MeroOn2D W₁ := fun c =>
      meroPullbackShift (-3 / 2) hW₁_open (hShiftW₁ (-3 / 2) (Or.inr rfl)) (G_ext c)
    have hP0_ag : ∀ c : Fin 2, MeroAgreesHolo (P_0 c) (fun q => F_X c (q.1 - q.2 / 2, q.2)) U₀ := by
      intro c
      have h := meroPullbackShift_agrees (-1 / 2) hW₁_open (hShiftW₁ (-1 / 2) (Or.inl rfl))
        (hGext_ag c) hU₀_open hU₀_sub_W₁ (hShiftU₀ (-1 / 2) (Or.inl rfl))
      have heq : (fun q : ℂ × ℂ => F_X c (shiftMap (-1 / 2) q)) =
          (fun q : ℂ × ℂ => F_X c (q.1 - q.2 / 2, q.2)) := by
        ext q; congr 1; ext <;> simp [shiftMap]; ring
      rwa [heq] at h
    have hPm_ag : ∀ c : Fin 2, MeroAgreesHolo (P_m c) (fun q => F_X c (q.1 - 3 * q.2 / 2, q.2)) U₀ := by
      intro c
      have h := meroPullbackShift_agrees (-3 / 2) hW₁_open (hShiftW₁ (-3 / 2) (Or.inr rfl))
        (hGext_ag c) hU₀_open hU₀_sub_W₁ (hShiftU₀ (-3 / 2) (Or.inr rfl))
      have heq : (fun q : ℂ × ℂ => F_X c (shiftMap (-3 / 2) q)) =
          (fun q : ℂ × ℂ => F_X c (q.1 - 3 * q.2 / 2, q.2)) := by
        ext q; congr 1; ext <;> simp [shiftMap]; ring
      rwa [heq] at h
    have hP0_holo : ∀ c : Fin 2, DifferentiableOn ℂ (fun q : ℂ × ℂ => F_X c (q.1 - q.2 / 2, q.2)) U₀ := by
      intro c
      have heq : (fun q : ℂ × ℂ => F_X c (q.1 - q.2 / 2, q.2)) =
          (fun q : ℂ × ℂ => F_X c (shiftMap (-1 / 2) q)) := by
        ext q; congr 1; ext <;> simp [shiftMap]; ring
      rw [heq]
      exact (hFX_holo c).comp (hShiftDiff (-1 / 2)).differentiableOn
        (fun q hq => hShiftSBaseToTwo (-1 / 2) (by norm_num) q (hU₀_sub_S hq))
    let W0_m := meroSub (P_0 1) (P_m 1)
    let W1_m := meroSub (P_m 0) (P_0 0)
    let N0_m := meroDerivY (P_0 1)
    let N1_m := meroNeg (meroDerivY (P_0 0))
    let WN_m := meroAdd (meroMul W0_m N0_m) (meroMul W1_m N1_m)
    let NN_m := meroAdd (meroMul N0_m N0_m) (meroMul N1_m N1_m)
    let Num0_m := meroSub (meroMul (meroAdd WN_m WN_m) N0_m) (meroMul NN_m W0_m)
    let Num1_m := meroSub (meroMul (meroAdd WN_m WN_m) N1_m) (meroMul NN_m W1_m)
    let Den_m := meroAdd (meroMul Num0_m (P_0 0)) (meroMul Num1_m (P_0 1))
    have hW0_ag := meroSub_agrees (hP0_ag 1) (hPm_ag 1)
    have hW1_ag := meroSub_agrees (hPm_ag 0) (hP0_ag 0)
    have hN0_ag := meroDerivY_agrees (hP0_ag 1) hU₀_open (hP0_holo 1)
    have hN1_ag := meroNeg_agrees (meroDerivY_agrees (hP0_ag 0) hU₀_open (hP0_holo 0))
    have hWN_ag := meroAdd_agrees (meroMul_agrees hW0_ag hN0_ag) (meroMul_agrees hW1_ag hN1_ag)
    have hNN_ag := meroAdd_agrees (meroMul_agrees hN0_ag hN0_ag) (meroMul_agrees hN1_ag hN1_ag)
    have hNum0_ag : MeroAgreesHolo Num0_m (reflNumX 0) U₀ :=
      meroSub_agrees (meroMul_agrees (meroAdd_agrees hWN_ag hWN_ag) hN0_ag)
        (meroMul_agrees hNN_ag hW0_ag)
    have hNum1_ag : MeroAgreesHolo Num1_m (reflNumX 1) U₀ :=
      meroSub_agrees (meroMul_agrees (meroAdd_agrees hWN_ag hWN_ag) hN1_ag)
        (meroMul_agrees hNN_ag hW1_ag)
    have hDen_ag : MeroAgreesHolo Den_m reflDenX U₀ :=
      meroAdd_agrees (meroMul_agrees hNum0_ag (hP0_ag 0)) (meroMul_agrees hNum1_ag (hP0_ag 1))
    have hRefl_nz_U₀ : ∃ q₀ ∈ U₀, reflDenX q₀ ≠ 0 :=
      hNonzeroOnSubCyl hδ₁ hδ₁_sub hReflDenHolo hs2_nz
    have hDiv_i : ∀ i : Fin 2, ∃ Q_i : MeroOn2D W₁, MeroAgreesHolo Q_i (F_L i) U₀ := by
      intro i
      fin_cases i
      · exact meroDiv_exists Num0_m Den_m (hCylPreconn (-s_base) b₁ t δ₁)
          hNum0_ag hDen_ag (hReflDenHolo.mono hU₀_sub_S) hRefl_nz_U₀
          (fun q hq => hs2_eq q (hU₀_sub_S hq) 0)
      · exact meroDiv_exists Num1_m Den_m (hCylPreconn (-s_base) b₁ t δ₁)
          hNum1_ag hDen_ag (hReflDenHolo.mono hU₀_sub_S) hRefl_nz_U₀
          (fun q hq => hs2_eq q (hU₀_sub_S hq) 1)
    refine ⟨hb₁_lo, δ₁, hδ₁, hδ₁_sub, fun i => Classical.choose (hDiv_i i), fun i => ?_⟩
    rw [hBaseCylEq]
    exact Classical.choose_spec (hDiv_i i)

  
  have hFwd : ∀ t ∈ B,
      collarWidthL C hDet t ≤ collarWidthX C hDet t + ENNReal.ofReal (|t.im| / 2) := by
    intro t ht
    refine sSup_le ?_
    rintro _ ⟨b, hbwit, rfl⟩
    by_cases hlow : b - |t.im| / 2 ≤ 2 * s_base
    · calc ENNReal.ofReal b
          ≤ ENNReal.ofReal (2 * s_base + |t.im| / 2) :=
            ENNReal.ofReal_le_ofReal (by linarith)
        _ = ENNReal.ofReal (2 * s_base) + ENNReal.ofReal (|t.im| / 2) :=
            ENNReal.ofReal_add (by positivity) (by positivity)
        _ ≤ collarWidthX C hDet t + ENNReal.ofReal (|t.im| / 2) := by
            gcongr; exact h_X_ge_two t ht
    · push_neg at hlow
      refine ENNReal.le_of_forall_pos_le_add (fun ε hε _ => ?_)
      let ε' : ℝ := min (ε : ℝ) (b - |t.im| / 2 - 2 * s_base)
      have hε'_pos : 0 < ε' := lt_min (by exact_mod_cast hε) (by linarith)
      let b₁ : ℝ := b - |t.im| / 2 - ε'
      have hb₁_ge : 2 * s_base ≤ b₁ := by
        dsimp [b₁, ε']; linarith [min_le_right (ε : ℝ) (b - |t.im| / 2 - 2 * s_base)]
      have hb₁_lo : s_base < b₁ := by linarith
      have hb₁_hi : b₁ < b - |t.im| / 2 := by dsimp [b₁]; linarith
      have hwit₁ := hL_to_X t ht b b₁ hbwit hb₁_lo hb₁_hi
      have hle_X : ENNReal.ofReal b₁ ≤ collarWidthX C hDet t :=
        le_sSup ⟨b₁, hwit₁, rfl⟩
      have hb_le : b ≤ b₁ + |t.im| / 2 + (ε : ℝ) := by
        dsimp [b₁, ε']; linarith [min_le_left (ε : ℝ) (b - |t.im| / 2 - 2 * s_base)]
      have h_abs_nonneg : 0 ≤ |t.im| / 2 := by positivity
      calc ENNReal.ofReal b
          ≤ ENNReal.ofReal (b₁ + |t.im| / 2 + (ε : ℝ)) := ENNReal.ofReal_le_ofReal hb_le
        _ = ENNReal.ofReal b₁ + ENNReal.ofReal (|t.im| / 2) + (ε : ENNReal) := by
            rw [ENNReal.ofReal_add (by linarith) (NNReal.coe_nonneg ε),
              ENNReal.ofReal_add (by linarith) h_abs_nonneg, ENNReal.ofReal_coe_nnreal]
        _ ≤ collarWidthX C hDet t + ENNReal.ofReal (|t.im| / 2) + (ε : ENNReal) := by
            gcongr

  have hBack_nonneg : ∀ t ∈ B, 0 ≤ t.im →
      collarWidthX C hDet t + ENNReal.ofReal (t.im / 2) ≤ collarWidthL C hDet t := by
    intro t ht ht_im
    let S_set : Set ENNReal :=
      { x : ENNReal | ∃ b' : ℝ, IsCollarHeightWitness s_base r_base F_X t b' ∧ x = ENNReal.ofReal b' }
    have hS_ne : S_set.Nonempty := by
      by_contra hempty
      rw [Set.not_nonempty_iff_eq_empty] at hempty
      have h0 : collarWidthX C hDet t = 0 := by
        change sSup S_set = 0; rw [hempty, sSup_empty, ENNReal.bot_eq_zero]
      have hpos : (0 : ENNReal) < ENNReal.ofReal (2 * s_base) :=
        ENNReal.ofReal_pos.mpr (by positivity)
      have hle := h_X_ge_two t ht
      rw [h0] at hle
      exact not_lt_of_ge hle hpos
    change sSup S_set + ENNReal.ofReal (t.im / 2) ≤ collarWidthL C hDet t
    rw [ENNReal.sSup_add hS_ne]
    refine iSup₂_le ?_
    rintro _ ⟨b', hb'wit, rfl⟩
    have hb'_pos : 0 < b' := lt_trans hs_pos hb'wit.1
    rw [← ENNReal.ofReal_add (le_of_lt hb'_pos) (by positivity)]
    by_cases hlow : b' + t.im / 2 ≤ 2 * s_base
    · exact le_trans (ENNReal.ofReal_le_ofReal hlow) (h_L_ge_two t ht)
    · push_neg at hlow
      refine ENNReal.le_of_forall_pos_le_add (fun ε hε _ => ?_)
      let ε' : ℝ := min (ε : ℝ) (b' + t.im / 2 - 2 * s_base)
      have hε'_pos : 0 < ε' := lt_min (by exact_mod_cast hε) (by linarith)
      let b₁ : ℝ := b' + t.im / 2 - ε'
      have hb₁_ge : 2 * s_base ≤ b₁ := by
        dsimp [b₁, ε']; linarith [min_le_right (ε : ℝ) (b' + t.im / 2 - 2 * s_base)]
      have hb₁_lo : s_base < b₁ := by linarith
      have hb₁_hi : b₁ < b' + t.im / 2 := by dsimp [b₁]; linarith
      have hwit₁ := hX_to_L_nonneg t ht ht_im b' b₁ hb'wit hb₁_lo hb₁_hi
      have hle_L : ENNReal.ofReal b₁ ≤ collarWidthL C hDet t :=
        le_sSup ⟨b₁, hwit₁, rfl⟩
      have hb_le : b' + t.im / 2 ≤ b₁ + (ε : ℝ) := by
        dsimp [b₁, ε']; linarith [min_le_left (ε : ℝ) (b' + t.im / 2 - 2 * s_base)]
      calc ENNReal.ofReal (b' + t.im / 2)
          ≤ ENNReal.ofReal (b₁ + (ε : ℝ)) := ENNReal.ofReal_le_ofReal hb_le
        _ = ENNReal.ofReal b₁ + (ε : ENNReal) := by
            rw [ENNReal.ofReal_add (by linarith) (NNReal.coe_nonneg ε),
              ENNReal.ofReal_coe_nnreal]
        _ ≤ collarWidthL C hDet t + (ε : ENNReal) := by
            gcongr

  intro t ht
  refine le_antisymm (hFwd t ht) ?_
  by_cases ht_im : 0 ≤ t.im
  · rw [abs_of_nonneg ht_im]
    exact hBack_nonneg t ht ht_im
  · push_neg at ht_im
    have hnt_mem : -t ∈ B := by
      simpa [B, Metric.mem_ball, dist_zero_right] using ht
    have hnt_im : 0 ≤ (-t).im := by simp; linarith
    have habs : |t.im| = (-t).im := by rw [abs_of_neg ht_im, Complex.neg_im]
    rw [← h_X_even t ht, ← h_L_even t ht, habs]
    exact hBack_nonneg (-t) hnt_mem hnt_im

theorem fourier_holomorphic_majorant_poly (q : ℝ → ℝ) (η₀ : ℝ)
    (hq_cont : Continuous q)
    (hq_per : Function.Periodic q (2 * Real.pi))
    (hq_nonneg : ∀ θ : ℝ, 0 ≤ q θ)
    (hη₀ : 0 < η₀) :
    ∃ g : ℂ → ℂ,
      Differentiable ℂ g ∧
      (∀ θ : ℝ,
        0 < (g (Complex.exp ((θ : ℂ) * Complex.I))).im ∧
        (g (Complex.exp ((θ : ℂ) * Complex.I))).im < q θ + η₀) ∧
      (2 * Real.pi)⁻¹ * (∫ θ in (0 : ℝ)..(2 * Real.pi), q θ) ≤ (g 0).im :=
by
  let T : ℝ := 2 * Real.pi
  have hT_pos : 0 < T := by positivity
  have hT_ne : T ≠ 0 := ne_of_gt hT_pos
  have : Fact (0 < T) := ⟨hT_pos⟩
  let q_ℂ : ℝ → ℂ := fun θ => (q θ : ℂ)
  have hq_ℂ_cont : Continuous q_ℂ := Complex.continuous_ofReal.comp hq_cont
  have hq_ℂ_per : Function.Periodic q_ℂ T := hq_per.comp Complex.ofReal
  let q_lift : AddCircle T → ℂ := hq_ℂ_per.lift
  have hq_lift_coe : ∀ θ : ℝ, q_lift (θ : AddCircle T) = (q θ : ℂ) :=
    fun θ => hq_ℂ_per.lift_coe θ
  have hq_lift_cont : Continuous q_lift := by
    rw [Topology.IsQuotientMap.continuous_iff
      (QuotientAddGroup.isQuotientMap_mk (N := AddSubgroup.zmultiples T))]
    have hcomp : q_lift ∘ QuotientAddGroup.mk = q_ℂ := funext hq_lift_coe
    rw [hcomp]
    exact hq_ℂ_cont
  let Q_𝕋 : C(AddCircle T, ℂ) := ⟨q_lift, hq_lift_cont⟩
  let S_span : Submodule ℂ C(AddCircle T, ℂ) := Submodule.span ℂ (Set.range (@fourier T))
  have hQ_mem_cl : Q_𝕋 ∈ closure (S_span : Set C(AddCircle T, ℂ)) := by
    rw [← Submodule.topologicalClosure_coe]
    change Q_𝕋 ∈ S_span.topologicalClosure
    rw [span_fourier_closure_eq_top]
    trivial
  have hη4_pos : 0 < η₀ / 4 := by linarith
  obtain ⟨P_𝕋, hP_mem, hdist⟩ := Metric.mem_closure_iff.mp hQ_mem_cl (η₀ / 4) hη4_pos
  rw [dist_eq_norm] at hdist
  obtain ⟨c, hc_eq⟩ := Finsupp.mem_span_range_iff_exists_finsupp.mp hP_mem
  have hP_eval : ∀ θ : ℝ,
      P_𝕋 (θ : AddCircle T) =
        ∑ n ∈ c.support, c n * Complex.exp ((n : ℂ) * ((θ : ℂ) * Complex.I)) := by
    intro θ
    rw [← hc_eq]
    change (∑ n ∈ c.support, c n • @fourier T n) (θ : AddCircle T) = _
    rw [ContinuousMap.coe_sum, Finset.sum_apply]
    refine Finset.sum_congr rfl fun n _ => ?_
    rw [ContinuousMap.coe_smul, Pi.smul_apply, smul_eq_mul, fourier_coe_apply]
    congr 1
    congr 1
    have hpi_ne : (Real.pi : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr Real.pi_ne_zero
    have hT_ℂ : (T : ℂ) = 2 * (Real.pi : ℂ) := by simp [T]
    rw [hT_ℂ]
    field_simp [hpi_ne]
  have h_approx : ∀ θ : ℝ,
      |q θ - ∑ n ∈ c.support, (c n * Complex.exp ((n : ℂ) * ((θ : ℂ) * Complex.I))).re| <
        η₀ / 4 := by
    intro θ
    have h_pt_norm : ‖(Q_𝕋 - P_𝕋) (θ : AddCircle T)‖ < η₀ / 4 :=
      lt_of_le_of_lt (ContinuousMap.norm_coe_le_norm (Q_𝕋 - P_𝕋) (θ : AddCircle T)) hdist
    have h_re_le : |((Q_𝕋 - P_𝕋) (θ : AddCircle T)).re| ≤ ‖(Q_𝕋 - P_𝕋) (θ : AddCircle T)‖ :=
      Complex.abs_re_le_norm _
    have h_re_eq : ((Q_𝕋 - P_𝕋) (θ : AddCircle T)).re =
        q θ - ∑ n ∈ c.support, (c n * Complex.exp ((n : ℂ) * ((θ : ℂ) * Complex.I))).re := by
      rw [ContinuousMap.sub_apply]
      change (q_lift (θ : AddCircle T) - P_𝕋 (θ : AddCircle T)).re = _
      rw [hq_lift_coe θ, hP_eval θ, Complex.sub_re, Complex.ofReal_re, Complex.re_sum]
    rw [← h_re_eq]
    exact lt_of_le_of_lt h_re_le h_pt_norm
  let α : ℤ → ℂ := fun n =>
    if 0 ≤ n then Complex.I * c n else Complex.I * starRingEnd ℂ (c n)
  let g : ℂ → ℂ := fun ζ =>
    Complex.I * ((η₀ / 2 : ℝ) : ℂ) + ∑ n ∈ c.support, α n * ζ ^ n.natAbs
  have hg_holo : Differentiable ℂ g := by
    refine (differentiable_const _).add ?_
    refine Differentiable.fun_sum fun n _ => ?_
    exact (Differentiable.fun_pow differentiable_id n.natAbs).const_mul (α n)
  have hI_mul_im : ∀ z : ℂ, (Complex.I * z).im = z.re := by
    intro z
    simp [Complex.mul_im]
  have h_term_im : ∀ (θ : ℝ) (n : ℤ),
      (α n * (Complex.exp ((θ : ℂ) * Complex.I)) ^ n.natAbs).im =
        (c n * Complex.exp ((n : ℂ) * ((θ : ℂ) * Complex.I))).re := by
    intro θ n
    set ζ : ℂ := Complex.exp ((θ : ℂ) * Complex.I)
    set m : ℕ := n.natAbs
    by_cases hn : 0 ≤ n
    · have hα : α n = Complex.I * c n := by simp [α, hn]
      have hm_int : (m : ℤ) = n := Int.natAbs_of_nonneg hn
      have hm_cast : (m : ℂ) = (n : ℂ) := by
        rw [← hm_int, Int.cast_natCast]
      have hζm : ζ ^ m = Complex.exp ((n : ℂ) * ((θ : ℂ) * Complex.I)) := by
        rw [← Complex.exp_nat_mul, hm_cast]
      rw [hα, mul_assoc, hI_mul_im, hζm]
    · have hα : α n = Complex.I * starRingEnd ℂ (c n) := by simp [α, hn]
      have hn_le : n ≤ 0 := le_of_not_ge hn
      have hm_int : (m : ℤ) = -n := Int.ofNat_natAbs_of_nonpos hn_le
      have hn_int : n = -(m : ℤ) := by omega
      have hm_cast : (n : ℂ) = -(m : ℂ) := by
        rw [hn_int, Int.cast_neg, Int.cast_natCast]
      have hconj_ζm : starRingEnd ℂ (ζ ^ m) = Complex.exp ((n : ℂ) * ((θ : ℂ) * Complex.I)) := by
        rw [map_pow]
        have hconj_ζ : starRingEnd ℂ ζ = Complex.exp (-((θ : ℂ) * Complex.I)) := by
          dsimp [ζ]
          rw [← Complex.exp_conj, map_mul, Complex.conj_ofReal, Complex.conj_I, mul_neg]
        rw [hconj_ζ, ← Complex.exp_nat_mul, hm_cast]
        congr 1
        ring
      rw [hα, mul_assoc, hI_mul_im, ← Complex.conj_re (starRingEnd ℂ (c n) * ζ ^ m),
        map_mul, Complex.conj_conj, hconj_ζm]
  have hg_im_circle : ∀ θ : ℝ,
      (g (Complex.exp ((θ : ℂ) * Complex.I))).im =
        η₀ / 2 + ∑ n ∈ c.support, (c n * Complex.exp ((n : ℂ) * ((θ : ℂ) * Complex.I))).re := by
    intro θ
    dsimp [g]
    rw [hI_mul_im, Complex.ofReal_re, Complex.im_sum]
    congr 1
    exact Finset.sum_congr rfl fun n _ => h_term_im θ n
  have hg_bdry : ∀ θ : ℝ,
      0 < (g (Complex.exp ((θ : ℂ) * Complex.I))).im ∧
      (g (Complex.exp ((θ : ℂ) * Complex.I))).im < q θ + η₀ := by
    intro θ
    have h_abs := abs_lt.mp (h_approx θ)
    have hq0 := hq_nonneg θ
    rw [hg_im_circle θ]
    constructor <;> linarith
  have hq_le_im : ∀ θ : ℝ, q θ ≤ (g (Complex.exp ((θ : ℂ) * Complex.I))).im := by
    intro θ
    have h_abs := abs_lt.mp (h_approx θ)
    rw [hg_im_circle θ]
    linarith
  let γ : ℝ → ℂ := fun θ => Complex.exp ((θ : ℂ) * Complex.I)
  have hγ_cont : Continuous γ :=
    Complex.continuous_exp.comp (Complex.continuous_ofReal.mul continuous_const)
  have h_monom_int : ∀ m : ℕ,
      (∫ θ in (0 : ℝ)..T, (γ θ) ^ m) = (T : ℂ) * (0 : ℂ) ^ m := by
    intro m
    by_cases hm : m = 0
    · subst hm
      simp [T]
    · rw [zero_pow hm, mul_zero]
      have h_integrand : ∀ θ : ℝ, (γ θ) ^ m = Complex.exp (((m : ℂ) * Complex.I) * (θ : ℂ)) := by
        intro θ
        dsimp [γ]
        rw [← Complex.exp_nat_mul]
        congr 1
        ring
      simp_rw [h_integrand]
      have hwm_ne : (m : ℂ) * Complex.I ≠ 0 :=
        mul_ne_zero (Nat.cast_ne_zero.mpr hm) Complex.I_ne_zero
      rw [integral_exp_mul_complex]
      have hexp_T : Complex.exp (((m : ℂ) * Complex.I) * (T : ℂ)) = 1 := by
        have harg : ((m : ℂ) * Complex.I) * (T : ℂ) =
            (m : ℂ) * (2 * (Real.pi : ℂ) * Complex.I) := by
          simp [T]
          ring
        rw [harg, Complex.exp_nat_mul, Complex.exp_two_pi_mul_I, one_pow]
      rw [hexp_T, Complex.ofReal_zero, mul_zero, Complex.exp_zero, sub_self, zero_div]
      exact hwm_ne
  have hg_int : (∫ θ in (0 : ℝ)..T, g (γ θ)) = (T : ℂ) * g 0 := by
    dsimp [g]
    have hint_const : IntervalIntegrable (fun _ : ℝ => Complex.I * ((η₀ / 2 : ℝ) : ℂ))
        MeasureTheory.volume 0 T := continuous_const.intervalIntegrable 0 T
    have hint_term : ∀ n ∈ c.support,
        IntervalIntegrable (fun θ : ℝ => α n * (γ θ) ^ n.natAbs) MeasureTheory.volume 0 T :=
      fun n _ => (continuous_const.mul (hγ_cont.pow n.natAbs)).intervalIntegrable 0 T
    have hint_sum : IntervalIntegrable (fun θ : ℝ => ∑ n ∈ c.support, α n * (γ θ) ^ n.natAbs)
        MeasureTheory.volume 0 T :=
      (continuous_finsetSum c.support fun n _ =>
        continuous_const.mul (hγ_cont.pow n.natAbs)).intervalIntegrable 0 T
    rw [intervalIntegral.integral_add hint_const hint_sum]
    rw [intervalIntegral.integral_const, sub_zero, Complex.real_smul]
    rw [intervalIntegral.integral_finsetSum hint_term]
    have hsum_eq : (∑ n ∈ c.support, ∫ θ in (0 : ℝ)..T, α n * (γ θ) ^ n.natAbs) =
        (T : ℂ) * ∑ n ∈ c.support, α n * (0 : ℂ) ^ n.natAbs := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun n _ => ?_
      rw [intervalIntegral.integral_const_mul, h_monom_int n.natAbs]
      ring
    rw [hsum_eq, ← mul_add]
  have hg_im_int : (∫ θ in (0 : ℝ)..T, (g (γ θ)).im) = T * (g 0).im := by
    have hint_g : IntervalIntegrable (fun θ : ℝ => g (γ θ)) MeasureTheory.volume 0 T :=
      (hg_holo.continuous.comp hγ_cont).intervalIntegrable 0 T
    have hcomm := ContinuousLinearMap.intervalIntegral_comp_comm Complex.imCLM hint_g
    change (∫ θ in (0 : ℝ)..T, (g (γ θ)).im) = ((∫ θ in (0 : ℝ)..T, g (γ θ))).im at hcomm
    rw [hcomm, hg_int, Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im]
    ring
  have hg_mean : T⁻¹ * (∫ θ in (0 : ℝ)..T, q θ) ≤ (g 0).im := by
    have hint_q : IntervalIntegrable q MeasureTheory.volume 0 T :=
      hq_cont.intervalIntegrable 0 T
    have hint_im : IntervalIntegrable (fun θ : ℝ => (g (γ θ)).im) MeasureTheory.volume 0 T :=
      (Complex.continuous_im.comp (hg_holo.continuous.comp hγ_cont)).intervalIntegrable 0 T
    have hmono : (∫ θ in (0 : ℝ)..T, q θ) ≤ ∫ θ in (0 : ℝ)..T, (g (γ θ)).im :=
      intervalIntegral.integral_mono_on (le_of_lt hT_pos) hint_q hint_im
        (fun θ _ => hq_le_im θ)
    rw [hg_im_int] at hmono
    have hmul := mul_le_mul_of_nonneg_left hmono (inv_nonneg.mpr (le_of_lt hT_pos))
    rwa [inv_mul_cancel_left₀ hT_ne] at hmul
  exact ⟨g, hg_holo, hg_bdry, hg_mean⟩

theorem lsc_annular_collar_and_disk_inversion (s_base r_base R_Φ : ℝ)
    (hs : 0 < s_base) (hr : 0 < r_base) (hR_Φ : 1 < R_Φ)
    (h_F : ℂ → ENNReal)
    (h_ge_two : ∀ t ∈ Metric.ball (0 : ℂ) r_base,
      ENNReal.ofReal (2 * s_base) ≤ h_F t)
    (h_lsc : LowerSemicontinuousOn h_F (Metric.ball (0 : ℂ) r_base))
    (Φ : ℂ → ℂ)
    (hΦ_holo : DifferentiableOn ℂ Φ (Metric.ball (0 : ℂ) R_Φ))
    (hΦ_maps : ∀ ζ ∈ Metric.ball (0 : ℂ) R_Φ, Φ ζ ∈ Metric.ball (0 : ℂ) r_base)
    (hΦ_deriv : deriv Φ 0 ≠ 0)
    (q : ℝ → ℝ)
    (hq_cont : Continuous q)
    (hq_per : Function.Periodic q (2 * Real.pi))
    (hq_lt : ∀ θ : ℝ, 0 ≤ q θ ∧
      ENNReal.ofReal (q θ) < h_F (Φ (Complex.exp ((θ : ℂ) * Complex.I)))) :
    ∃ η₀ : ℝ, 0 < η₀ ∧
      ∀ g : ℂ → ℂ,
        Differentiable ℂ g →
        (∀ θ : ℝ,
          0 < (g (Complex.exp ((θ : ℂ) * Complex.I))).im ∧
          (g (Complex.exp ((θ : ℂ) * Complex.I))).im < q θ + η₀) →
        ∃ (d_w d_ζ δ_t : ℝ) (ψ : ℂ → ℂ),
          (0 < d_w ∧ d_w < s_base) ∧
          (0 < d_ζ ∧ d_ζ < 1 ∧ 1 + d_ζ < R_Φ) ∧
          (∀ (x₀ lam : ℝ), 0 ≤ lam → lam ≤ 1 →
            ∀ w ∈ Metric.ball (0 : ℂ) d_w,
            ∀ ζ : ℂ, 1 - d_ζ < ‖ζ‖ → ‖ζ‖ < 1 + d_ζ →
              ((x₀ : ℂ) + (lam : ℂ) * g ζ + w, Φ ζ) ∈ meroTubeENNR r_base h_F) ∧
          (0 < δ_t ∧ Metric.ball (Φ 0) δ_t ⊆ Metric.ball (0 : ℂ) r_base) ∧
          (DifferentiableOn ℂ ψ (Metric.ball (Φ 0) δ_t) ∧
            ψ (Φ 0) = 0 ∧ deriv ψ (Φ 0) ≠ 0) ∧
          (∀ t' ∈ Metric.ball (Φ 0) δ_t,
            ψ t' ∈ Metric.ball (0 : ℂ) (1 + d_ζ) ∧
            Φ (ψ t') = t' ∧
            ‖g (ψ t') - g 0‖ < d_w / 4) :=
by
  let _ := hr
  let B : Set ℂ := Metric.ball (0 : ℂ) r_base
  let B_Φ : Set ℂ := Metric.ball (0 : ℂ) R_Φ
  let I_per : Set ℝ := Set.Icc (0 : ℝ) (2 * Real.pi)
  let e : ℝ → ℂ := fun θ => Complex.exp ((θ : ℂ) * Complex.I)
  have hI_ne : I_per.Nonempty := ⟨0, le_refl 0, le_of_lt Real.two_pi_pos⟩
  obtain ⟨θ_max, _, hθ_max⟩ := isCompact_Icc.exists_isMaxOn hI_ne hq_cont.continuousOn
  let M_q : ℝ := q θ_max + 1
  have hM_q_pos : 0 < M_q := by
    have h0 : 0 ≤ q θ_max := (hq_lt θ_max).1
    linarith
  have hq_range : q '' I_per = Set.range q := by
    simpa [I_per, zero_add] using hq_per.image_Icc Real.two_pi_pos 0
  have hq_lt_M : ∀ θ : ℝ, q θ < M_q := by
    intro θ
    have hmem : q θ ∈ q '' I_per := by
      rw [hq_range]
      exact Set.mem_range_self θ
    obtain ⟨θ₀, hθ₀_mem, hθ₀_eq⟩ := hmem
    have hle : q θ₀ ≤ q θ_max := isMaxOn_iff.mp hθ_max θ₀ hθ₀_mem
    linarith
  have he_cont : Continuous e :=
    Complex.continuous_exp.comp (Complex.continuous_ofReal.mul continuous_const)
  have he_mem : ∀ θ : ℝ, e θ ∈ B_Φ := by
    intro θ
    rw [Metric.mem_ball, dist_zero_right]
    calc ‖e θ‖ = 1 := Complex.norm_exp_ofReal_mul_I θ
      _ < R_Φ := hR_Φ
  have he_per : Function.Periodic e (2 * Real.pi) := by
    intro θ
    dsimp [e]
    have h_arg : (((θ + 2 * Real.pi : ℝ) : ℂ) * Complex.I) =
        (θ : ℂ) * Complex.I + 2 * (Real.pi : ℂ) * Complex.I := by
      push_cast
      ring
    rw [h_arg]
    exact Complex.exp_periodic ((θ : ℂ) * Complex.I)
  let H_ennr : ℂ → ENNReal := fun z => min (ENNReal.ofReal M_q) (h_F (Φ z))
  let H_trunc : ℂ → ℝ := fun z => (H_ennr z).toReal
  have hH_ne_top : ∀ z : ℂ, H_ennr z ≠ ⊤ := by
    intro z
    exact ne_top_of_lt (lt_of_le_of_lt (min_le_left _ _) ENNReal.ofReal_lt_top)
  have hH_ofReal_le : ∀ z : ℂ, ENNReal.ofReal (H_trunc z) ≤ h_F (Φ z) := by
    intro z
    dsimp [H_trunc]
    rw [ENNReal.ofReal_toReal (hH_ne_top z)]
    exact min_le_right _ _
  have hΦ_mapsTo : Set.MapsTo Φ B_Φ B := fun ζ hζ => hΦ_maps ζ hζ
  have hH_ennr_lsc : LowerSemicontinuousOn H_ennr B_Φ :=
    lowerSemicontinuousOn_const.inf (h_lsc.comp hΦ_holo.continuousOn hΦ_mapsTo)
  have hH_trunc_lsc : LowerSemicontinuousOn H_trunc B_Φ := by
    rw [lowerSemicontinuousOn_iff_preimage_Ioi]
    intro c
    by_cases hc : 0 ≤ c
    · obtain ⟨u, hu_open, hu_eq⟩ :=
        lowerSemicontinuousOn_iff_preimage_Ioi.mp hH_ennr_lsc (ENNReal.ofReal c)
      have h_pre : H_trunc ⁻¹' Set.Ioi c = H_ennr ⁻¹' Set.Ioi (ENNReal.ofReal c) := by
        ext z
        simp only [Set.mem_preimage, Set.mem_Ioi, H_trunc]
        exact (ENNReal.ofReal_lt_iff_lt_toReal hc (hH_ne_top z)).symm
      exact ⟨u, hu_open, by rwa [h_pre]⟩
    · have h_pre : H_trunc ⁻¹' Set.Ioi c = Set.univ := by
        ext z
        simp only [Set.mem_preimage, Set.mem_Ioi, Set.mem_univ, iff_true, H_trunc]
        exact lt_of_lt_of_le (lt_of_not_ge hc) ENNReal.toReal_nonneg
      exact ⟨Set.univ, isOpen_univ, by rw [h_pre]⟩
  let Δ : ℝ → ℝ := fun θ => H_trunc (e θ) + (-q θ)
  have hH_e_lsc : LowerSemicontinuousOn (fun θ => H_trunc (e θ)) I_per :=
    hH_trunc_lsc.comp he_cont.continuousOn (fun θ _ => he_mem θ)
  have hq_neg_lsc : LowerSemicontinuousOn (fun θ => -q θ) I_per :=
    hq_cont.neg.lowerSemicontinuous.lowerSemicontinuousOn I_per
  have hΔ_lsc : LowerSemicontinuousOn Δ I_per := hH_e_lsc.add hq_neg_lsc
  have hΔ_pos : ∀ θ : ℝ, 0 < Δ θ := by
    intro θ
    have h1 : ENNReal.ofReal (q θ) < ENNReal.ofReal M_q :=
      (ENNReal.ofReal_lt_ofReal_iff hM_q_pos).mpr (hq_lt_M θ)
    have h2 : ENNReal.ofReal (q θ) < h_F (Φ (e θ)) := (hq_lt θ).2
    have h3 : ENNReal.ofReal (q θ) < H_ennr (e θ) := lt_min h1 h2
    have h4 : q θ < H_trunc (e θ) :=
      (ENNReal.ofReal_lt_iff_lt_toReal (hq_lt θ).1 (hH_ne_top (e θ))).mp h3
    dsimp [Δ]
    linarith
  obtain ⟨θ_min, _, hθ_min⟩ := hΔ_lsc.exists_isMinOn hI_ne isCompact_Icc
  have hΔ_per : Function.Periodic Δ (2 * Real.pi) := by
    intro θ
    dsimp [Δ]
    rw [he_per θ, hq_per θ]
  have hΔ_range : Δ '' I_per = Set.range Δ := by
    simpa [I_per, zero_add] using hΔ_per.image_Icc Real.two_pi_pos 0
  have hΔ_ge : ∀ θ : ℝ, Δ θ_min ≤ Δ θ := by
    intro θ
    have hmem : Δ θ ∈ Δ '' I_per := by
      rw [hΔ_range]
      exact Set.mem_range_self θ
    obtain ⟨θ₀, hθ₀_mem, hθ₀_eq⟩ := hmem
    have hle : Δ θ_min ≤ Δ θ₀ := isMinOn_iff.mp hθ_min θ₀ hθ₀_mem
    linarith
  let η₀ : ℝ := Δ θ_min / 2
  have hη₀ : 0 < η₀ := half_pos (hΔ_pos θ_min)
  have hq_two_η₀ : ∀ θ : ℝ, q θ + 2 * η₀ ≤ H_trunc (e θ) := by
    intro θ
    have h := hΔ_ge θ
    dsimp [Δ, η₀] at h ⊢
    linarith
  refine ⟨η₀, hη₀, ?_⟩
  intro g hg_holo hg_bdry
  let d_w : ℝ := min (s_base / 2) (η₀ / 2)
  have hd_w : 0 < d_w := lt_min (half_pos hs) (half_pos hη₀)
  have hd_w_lt : d_w < s_base := lt_of_le_of_lt (min_le_left _ _) (half_lt_self hs)
  have hd_w_le_η : d_w ≤ η₀ / 2 := min_le_right _ _
  have hg_im_cont : Continuous (fun ζ : ℂ => (g ζ).im) :=
    Complex.continuous_im.comp hg_holo.continuous
  let G_gap : ℂ → ℝ := fun ζ => H_trunc ζ + (-((g ζ).im + d_w))
  have hG_sub_cont : Continuous (fun ζ : ℂ => -((g ζ).im + d_w)) :=
    (hg_im_cont.add continuous_const).neg
  have hG_gap_lsc : LowerSemicontinuousOn G_gap B_Φ :=
    hH_trunc_lsc.add (hG_sub_cont.lowerSemicontinuous.lowerSemicontinuousOn B_Φ)
  obtain ⟨U_gap, hU_gap_open, hU_gap_eq⟩ :=
    lowerSemicontinuousOn_iff_preimage_Ioi.mp hG_gap_lsc 0
  let V_ann : Set ℂ :=
    (B_Φ ∩ {ζ : ℂ | 0 < (g ζ).im}) ∩ (B_Φ ∩ G_gap ⁻¹' Set.Ioi 0)
  have hV_ann_open : IsOpen V_ann := by
    have h1 : IsOpen (B_Φ ∩ {ζ : ℂ | 0 < (g ζ).im}) :=
      Metric.isOpen_ball.inter (isOpen_lt continuous_const hg_im_cont)
    have h2 : IsOpen (B_Φ ∩ G_gap ⁻¹' Set.Ioi 0) := by
      rw [hU_gap_eq]
      exact Metric.isOpen_ball.inter hU_gap_open
    exact h1.inter h2
  have hSphere_sub : Metric.sphere (0 : ℂ) 1 ⊆ V_ann := by
    intro ζ hζ
    have hζ_norm : ‖ζ‖ = 1 := by simpa using mem_sphere_iff_norm.mp hζ
    have hζ_mem : ζ ∈ B_Φ := by
      rw [Metric.mem_ball, dist_zero_right, hζ_norm]
      exact hR_Φ
    have he_arg_exp : Complex.exp ((ζ.arg : ℂ) * Complex.I) = ζ := by
      have h_polar := Complex.norm_mul_exp_arg_mul_I ζ
      rw [hζ_norm, Complex.ofReal_one, one_mul] at h_polar
      exact h_polar
    have he_arg : e ζ.arg = ζ := he_arg_exp
    have h_bd := hg_bdry ζ.arg
    have h_gap_arg := hq_two_η₀ ζ.arg
    rw [he_arg_exp] at h_bd
    rw [he_arg] at h_gap_arg
    have h_pos_gap : 0 < G_gap ζ := by
      dsimp [G_gap]
      linarith [h_bd.2, hd_w_le_η, hη₀, h_gap_arg]
    exact ⟨⟨hζ_mem, h_bd.1⟩, ⟨hζ_mem, h_pos_gap⟩⟩
  obtain ⟨δ_th, hδ_th_pos, hδ_th_sub⟩ :=
    (isCompact_sphere (0 : ℂ) 1).exists_thickening_subset_open hV_ann_open hSphere_sub
  let d_ζ : ℝ := min (δ_th / 2) (min (1 / 2) ((R_Φ - 1) / 2))
  have hd_ζ_pos : 0 < d_ζ :=
    lt_min (half_pos hδ_th_pos) (lt_min (by norm_num) (by linarith))
  have hd_ζ_le_half : d_ζ ≤ 1 / 2 := le_trans (min_le_right _ _) (min_le_left _ _)
  have hd_ζ_lt_one : d_ζ < 1 := by linarith
  have hd_ζ_le_R : d_ζ ≤ (R_Φ - 1) / 2 := le_trans (min_le_right _ _) (min_le_right _ _)
  have hd_ζ_lt_R : 1 + d_ζ < R_Φ := by linarith
  have hd_ζ_le_th : d_ζ ≤ δ_th / 2 := min_le_left _ _
  have hAnn_V : ∀ ζ : ℂ, 1 - d_ζ < ‖ζ‖ → ‖ζ‖ < 1 + d_ζ → ζ ∈ V_ann := by
    intro ζ h_lo h_hi
    have hζ_pos : 0 < ‖ζ‖ := by linarith
    let u : ℂ := (‖ζ‖⁻¹ : ℝ) • ζ
    have hu_norm : ‖u‖ = 1 := by
      change ‖(‖ζ‖⁻¹ : ℝ) • ζ‖ = 1
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hζ_pos),
        inv_mul_cancel₀ (ne_of_gt hζ_pos)]
    have hu_sphere : u ∈ Metric.sphere (0 : ℂ) 1 := by
      rw [mem_sphere_iff_norm, sub_zero]
      exact hu_norm
    have hζ_eq : (‖ζ‖ : ℝ) • u = ζ := by
      change (‖ζ‖ : ℝ) • (‖ζ‖⁻¹ : ℝ) • ζ = ζ
      rw [smul_smul, mul_inv_cancel₀ (ne_of_gt hζ_pos), one_smul]
    have hdist : dist ζ u < δ_th := by
      rw [dist_eq_norm]
      have hsub : ζ - u = ((‖ζ‖ - 1 : ℝ) • u) := by
        rw [sub_smul, one_smul, hζ_eq]
      rw [hsub, norm_smul, hu_norm, mul_one, Real.norm_eq_abs]
      have habs : |‖ζ‖ - 1| < d_ζ := abs_lt.mpr ⟨by linarith, by linarith⟩
      linarith
    exact hδ_th_sub (Metric.mem_thickening_iff.mpr ⟨u, hu_sphere, hdist⟩)
  have hAnn_maps : ∀ (x₀ lam : ℝ), 0 ≤ lam → lam ≤ 1 →
      ∀ w ∈ Metric.ball (0 : ℂ) d_w,
      ∀ ζ : ℂ, 1 - d_ζ < ‖ζ‖ → ‖ζ‖ < 1 + d_ζ →
        ((x₀ : ℂ) + (lam : ℂ) * g ζ + w, Φ ζ) ∈ meroTubeENNR r_base h_F := by
    intro x₀ lam hlam0 hlam1 w hw ζ h_lo h_hi
    have hζ_V := hAnn_V ζ h_lo h_hi
    have hζ_BΦ : ζ ∈ B_Φ := hζ_V.1.1
    have hg_im_pos : 0 < (g ζ).im := hζ_V.1.2
    have hg_gap_pos : 0 < G_gap ζ := hζ_V.2.2
    have hg_lt_H : (g ζ).im + d_w < H_trunc ζ := by
      dsimp [G_gap] at hg_gap_pos
      linarith
    have hw_norm : ‖w‖ < d_w := by simpa [Metric.mem_ball, dist_zero_right] using hw
    have hw_im_abs : |w.im| < d_w := lt_of_le_of_lt (Complex.abs_im_le_norm w) hw_norm
    obtain ⟨hw_im_lo, hw_im_hi⟩ := abs_lt.mp hw_im_abs
    let y : ℂ := (x₀ : ℂ) + (lam : ℂ) * g ζ + w
    have hy_im : y.im = lam * (g ζ).im + w.im := by
      simp [y, Complex.add_im, Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im]
    have hΦ_mem : Φ ζ ∈ B := hΦ_maps ζ hζ_BΦ
    have hΦ_norm : ‖Φ ζ‖ < r_base := by simpa [B, Metric.mem_ball, dist_zero_right] using hΦ_mem
    have hΦ_conj_mem : starRingEnd ℂ (Φ ζ) ∈ B := by
      rw [Metric.mem_ball, dist_zero_right, Complex.norm_conj]
      exact hΦ_norm
    have h_lam_nonneg : 0 ≤ lam * (g ζ).im := mul_nonneg hlam0 (le_of_lt hg_im_pos)
    have h_lower_real : -y.im < 2 * s_base := by linarith
    have h_lower : ENNReal.ofReal (-y.im) < h_F (starRingEnd ℂ (Φ ζ)) := by
      have h1 : ENNReal.ofReal (-y.im) < ENNReal.ofReal (2 * s_base) :=
        (ENNReal.ofReal_lt_ofReal_iff (by linarith)).mpr h_lower_real
      exact lt_of_lt_of_le h1 (h_ge_two (starRingEnd ℂ (Φ ζ)) hΦ_conj_mem)
    have h_lam_le : lam * (g ζ).im ≤ (g ζ).im :=
      mul_le_of_le_one_left (le_of_lt hg_im_pos) hlam1
    have h_upper_real : y.im < H_trunc ζ := by linarith
    have hH_pos : 0 < H_trunc ζ := by linarith
    have h_upper : ENNReal.ofReal y.im < h_F (Φ ζ) := by
      have h1 : ENNReal.ofReal y.im < ENNReal.ofReal (H_trunc ζ) :=
        (ENNReal.ofReal_lt_ofReal_iff hH_pos).mpr h_upper_real
      exact lt_of_lt_of_le h1 (hH_ofReal_le ζ)
    exact ⟨hΦ_norm, h_lower, h_upper⟩
  have h0_mem : (0 : ℂ) ∈ B_Φ := by
    rw [Metric.mem_ball, dist_zero_right, norm_zero]
    linarith
  have hΦ0_mem : Φ 0 ∈ B := hΦ_maps 0 h0_mem
  have hΦ_an : AnalyticAt ℂ Φ 0 :=
    hΦ_holo.analyticAt (Metric.isOpen_ball.mem_nhds h0_mem)
  let ψ : ℂ → ℂ :=
    HasStrictDerivAt.localInverse Φ (deriv Φ 0) 0 hΦ_an.hasStrictDerivAt hΦ_deriv
  have hψ_zero : ψ (Φ 0) = 0 :=
    (hΦ_an.hasStrictDerivAt.eventually_left_inverse hΦ_deriv).self_of_nhds
  have hψ_deriv_eq : deriv ψ (Φ 0) = (deriv Φ 0)⁻¹ :=
    (hΦ_an.hasStrictDerivAt.to_localInverse hΦ_deriv).hasDerivAt.deriv
  have hψ_deriv : deriv ψ (Φ 0) ≠ 0 := by
    rw [hψ_deriv_eq]
    exact inv_ne_zero hΦ_deriv
  have hψ_an : AnalyticAt ℂ ψ (Φ 0) :=
    hΦ_an.analyticAt_localInverse hΦ_deriv
  have hψ_cont : ContinuousAt ψ (Φ 0) := hψ_an.continuousAt
  have hE1 : {t' : ℂ | AnalyticAt ℂ ψ t'} ∈ nhds (Φ 0) :=
    hψ_an.eventually_analyticAt
  have hE2 : {t' : ℂ | Φ (ψ t') = t'} ∈ nhds (Φ 0) :=
    hΦ_an.hasStrictDerivAt.eventually_right_inverse hΦ_deriv
  have hE3 : B ∈ nhds (Φ 0) :=
    Metric.isOpen_ball.mem_nhds hΦ0_mem
  have h0_in_dζ : ψ (Φ 0) ∈ Metric.ball (0 : ℂ) (1 + d_ζ) := by
    rw [hψ_zero, Metric.mem_ball, dist_self]
    linarith
  have hE4 : ψ ⁻¹' Metric.ball (0 : ℂ) (1 + d_ζ) ∈ nhds (Φ 0) :=
    hψ_cont.preimage_mem_nhds (Metric.isOpen_ball.mem_nhds h0_in_dζ)
  have hgψ_cont : ContinuousAt (fun t' : ℂ => g (ψ t')) (Φ 0) :=
    hg_holo.continuous.continuousAt.comp hψ_cont
  have hg0_in_dw : g (ψ (Φ 0)) ∈ Metric.ball (g 0) (d_w / 4) := by
    rw [hψ_zero, Metric.mem_ball, dist_self]
    linarith
  have hE5 : (fun t' : ℂ => g (ψ t')) ⁻¹' Metric.ball (g 0) (d_w / 4) ∈ nhds (Φ 0) :=
    hgψ_cont.preimage_mem_nhds (Metric.isOpen_ball.mem_nhds hg0_in_dw)
  have hE_all :=
    Filter.inter_mem hE1 (Filter.inter_mem hE2 (Filter.inter_mem hE3 (Filter.inter_mem hE4 hE5)))
  obtain ⟨δ_t, hδ_t_pos, hδ_t_sub⟩ := Metric.mem_nhds_iff.mp hE_all
  refine ⟨d_w, d_ζ, δ_t, ψ, ⟨hd_w, hd_w_lt⟩, ⟨hd_ζ_pos, hd_ζ_lt_one, hd_ζ_lt_R⟩,
    hAnn_maps, ⟨hδ_t_pos, ?_⟩, ⟨?_, hψ_zero, hψ_deriv⟩, ?_⟩
  · intro t' ht'
    exact (hδ_t_sub ht').2.2.1
  · intro t' ht'
    have h_an : AnalyticAt ℂ ψ t' := (hδ_t_sub ht').1
    exact h_an.differentiableAt.differentiableWithinAt
  · intro t' ht'
    have hall := hδ_t_sub ht'
    have h_in_dζ : ψ t' ∈ Metric.ball (0 : ℂ) (1 + d_ζ) := hall.2.2.2.1
    have h_inv : Φ (ψ t') = t' := hall.2.1
    have h_g_ball : g (ψ t') ∈ Metric.ball (g 0) (d_w / 4) := hall.2.2.2.2
    rw [Metric.mem_ball, dist_eq_norm] at h_g_ball
    exact ⟨h_in_dζ, h_inv, h_g_ball⟩

theorem mero2d_sheaf_pullback_toolkit : Mero2DPullbackGluingToolkit :=
by
  have eqOn_zero_of_convex_2D :
      ∀ {C V : Set (ℂ × ℂ)} {f : ℂ × ℂ → ℂ},
        IsOpen C → Convex ℝ C → DifferentiableOn ℂ f C →
        IsOpen V → (V ∩ C).Nonempty →
        (∀ x ∈ V ∩ C, f x = 0) →
        ∀ q ∈ C, f q = 0 := by
    intro C V f hC_open hC_conv hf hV_open ⟨p₁, hp₁V, hp₁C⟩ hfV q hq
    let γ : ℂ → ℂ × ℂ := fun z => p₁ + z • (q - p₁)
    have hγ_diff : Differentiable ℂ γ :=
      (differentiable_const p₁).add (differentiable_id.smul_const (q - p₁))
    have hγ_cont : Continuous γ := hγ_diff.continuous
    let V_z : Set ℂ := γ ⁻¹' C
    have hVz_open : IsOpen V_z := hC_open.preimage hγ_cont
    have hVz_conv : Convex ℝ V_z := by
      intro z₁ hz₁ z₂ hz₂ a b ha hb hab
      show γ (a • z₁ + b • z₂) ∈ C
      have hγ_comb : γ (a • z₁ + b • z₂) = a • γ z₁ + b • γ z₂ := by
        dsimp [γ]
        calc
          p₁ + (a • z₁ + b • z₂) • (q - p₁)
              = (a + b) • p₁ + (a • z₁) • (q - p₁) + (b • z₂) • (q - p₁) := by
                  rw [hab, one_smul, add_smul, add_assoc]
          _ = a • p₁ + b • p₁ + a • (z₁ • (q - p₁)) + b • (z₂ • (q - p₁)) := by
                  rw [add_smul, smul_assoc, smul_assoc]
          _ = a • (p₁ + z₁ • (q - p₁)) + b • (p₁ + z₂ • (q - p₁)) := by
                  simp only [smul_add]
                  abel
      rw [hγ_comb]
      exact hC_conv hz₁ hz₂ ha hb hab
    have h0_mem : (0 : ℂ) ∈ V_z := by
      show γ 0 ∈ C
      simpa [γ] using hp₁C
    have h1_mem : (1 : ℂ) ∈ V_z := by
      show γ 1 ∈ C
      simpa [γ] using hq
    have hfg_ana : AnalyticOnNhd ℂ (f ∘ γ) V_z :=
      (hf.comp hγ_diff.differentiableOn (fun _ hz => hz)).analyticOnNhd hVz_open
    have hfg_ev : (f ∘ γ) =ᶠ[nhds (0 : ℂ)] 0 := by
      have h_nhds : γ ⁻¹' (V ∩ C) ∈ nhds (0 : ℂ) := by
        apply ((hV_open.inter hC_open).preimage hγ_cont).mem_nhds
        show γ 0 ∈ V ∩ C
        simpa [γ] using (⟨hp₁V, hp₁C⟩ : p₁ ∈ V ∩ C)
      exact Filter.eventually_of_mem h_nhds (fun z hz => hfV (γ z) hz)
    have h_eq := hfg_ana.eqOn_zero_of_preconnected_of_eventuallyEq_zero
      hVz_conv.isPreconnected h0_mem hfg_ev h1_mem
    simpa [Function.comp, γ] using h_eq

  have exists_ne_zero_of_convex_2D :
      ∀ {B V : Set (ℂ × ℂ)} {g : ℂ × ℂ → ℂ},
        IsOpen B → Convex ℝ B → DifferentiableOn ℂ g B →
        (∃ q₀ ∈ B, g q₀ ≠ 0) → IsOpen V → (V ∩ B).Nonempty →
        ∃ x₁ ∈ V ∩ B, g x₁ ≠ 0 := by
    intro B V g hB_open hB_conv hg ⟨q₀, hq₀B, hq₀_ne⟩ hV_open hVB_ne
    by_contra h_all
    have h_zero : ∀ x ∈ V ∩ B, g x = 0 :=
      fun x hx => Classical.not_not.mp (fun hne => h_all ⟨x, hx, hne⟩)
    exact hq₀_ne (eqOn_zero_of_convex_2D hB_open hB_conv hg hV_open hVB_ne h_zero q₀ hq₀B)

  have cancel_holo_of_convex_2D :
      ∀ {C B V : Set (ℂ × ℂ)} {h g : ℂ × ℂ → ℂ},
        IsOpen C → Convex ℝ C → DifferentiableOn ℂ h C →
        IsOpen B → Convex ℝ B → DifferentiableOn ℂ g B →
        (∃ q₀ ∈ B, g q₀ ≠ 0) →
        IsOpen V → ((V ∩ C) ∩ B).Nonempty →
        (∀ x ∈ (V ∩ C) ∩ B, h x * g x = 0) →
        ∀ q ∈ C, h q = 0 := by
    intro C B V h g hC_open hC_conv hh hB_open hB_conv hg hg_nz hV_open hVCB_ne hprod
    obtain ⟨x₁, ⟨⟨hx₁V, hx₁C⟩, hx₁B⟩, hx₁_ne⟩ :=
      exists_ne_zero_of_convex_2D hB_open hB_conv hg hg_nz (hV_open.inter hC_open) hVCB_ne
    have hcont : ContinuousAt g x₁ :=
      hg.continuousOn.continuousAt (hB_open.mem_nhds hx₁B)
    have h_nhds : (V ∩ B) ∩ g ⁻¹' {(0 : ℂ)}ᶜ ∈ nhds x₁ :=
      Filter.inter_mem ((hV_open.inter hB_open).mem_nhds ⟨hx₁V, hx₁B⟩)
        (hcont.preimage_mem_nhds (isOpen_compl_singleton.mem_nhds hx₁_ne))
    obtain ⟨η₁, hη₁, hη₁_sub⟩ := Metric.mem_nhds_iff.mp h_nhds
    have hh_sub : ∀ x ∈ Metric.ball x₁ η₁ ∩ C, h x = 0 := by
      rintro x ⟨hx_ball, hxC⟩
      have hx_mem := hη₁_sub hx_ball
      rcases mul_eq_zero.mp (hprod x ⟨⟨hx_mem.1.1, hxC⟩, hx_mem.1.2⟩) with hh0 | hg0
      · exact hh0
      · exact False.elim (hx_mem.2 hg0)
    exact eqOn_zero_of_convex_2D hC_open hC_conv hh Metric.isOpen_ball
      ⟨x₁, Metric.mem_ball_self hη₁, hx₁C⟩ hh_sub

  have triangular_holo :
      ∀ {W₁ : Set (ℂ × ℂ)} {Υ : ℂ × ℂ → ℂ × ℂ},
        IsTriangularHoloMap W₁ Υ → DifferentiableOn ℂ Υ W₁ := by
    rintro W₁ Υ ⟨_, U_v, h, φ, _, _, hΥ_eq, hh_holo, hφ_holo, _⟩
    have hfst_add : DifferentiableOn ℂ (fun p : ℂ × ℂ => p.1 + h p.2) W₁ :=
      differentiable_fst.differentiableOn.add
        (hh_holo.comp differentiable_snd.differentiableOn (fun p hp => (hΥ_eq p hp).1))
    have hsnd_φ : DifferentiableOn ℂ (fun p : ℂ × ℂ => φ p.2) W₁ :=
      hφ_holo.comp differentiable_snd.differentiableOn (fun p hp => (hΥ_eq p hp).1)
    exact (hfst_add.prodMk hsnd_φ).congr (fun p hp => (hΥ_eq p hp).2)

  have triangular_image_contains_ball :
      ∀ {W₁ : Set (ℂ × ℂ)} {Υ : ℂ × ℂ → ℂ × ℂ} {p : ℂ × ℂ} {r_p : ℝ},
        IsTriangularHoloMap W₁ Υ → p ∈ W₁ → 0 < r_p → Metric.ball p r_p ⊆ W₁ →
        ∃ p₁ ∈ Metric.ball p r_p, ∃ ε : ℝ, 0 < ε ∧
          Metric.ball (Υ p₁) ε ⊆ Υ '' Metric.ball p r_p := by
    rintro W₁ Υ p r_p ⟨_, U_v, h, φ, hUv_open, hUv_pre, hΥ_eq, hh_holo, hφ_holo,
      v₀, hv₀_mem, hv₀_deriv⟩ hp hr_p hBp
    have hslice_Uv : Metric.ball p.2 r_p ⊆ U_v := by
      intro v hv
      have hpair_ball : (p.1, v) ∈ Metric.ball p r_p := by
        rw [Metric.mem_ball, Prod.dist_eq]
        exact max_lt (by simpa using hr_p) (Metric.mem_ball.mp hv)
      exact (hΥ_eq (p.1, v) (hBp hpair_ball)).1
    have hex_v₁ : ∃ v₁ ∈ Metric.ball p.2 r_p, deriv φ v₁ ≠ 0 := by
      by_contra h_all
      have h_zero : ∀ v ∈ Metric.ball p.2 r_p, deriv φ v = 0 :=
        fun v hv => Classical.not_not.mp (fun hne => h_all ⟨v, hv, hne⟩)
      have hφ'_ana : AnalyticOnNhd ℂ (deriv φ) U_v :=
        (hφ_holo.deriv hUv_open).analyticOnNhd hUv_open
      have hφ'_ev : deriv φ =ᶠ[nhds p.2] 0 :=
        Filter.eventually_of_mem (Metric.ball_mem_nhds p.2 hr_p) h_zero
      exact hv₀_deriv (hφ'_ana.eqOn_zero_of_preconnected_of_eventuallyEq_zero
        hUv_pre (hΥ_eq p hp).1 hφ'_ev hv₀_mem)
    obtain ⟨v₁, hv₁_ball, hv₁_ne⟩ := hex_v₁
    have hv₁_Uv : v₁ ∈ U_v := hslice_Uv hv₁_ball
    have hcont_h : ContinuousAt h v₁ :=
      hh_holo.continuousOn.continuousAt (hUv_open.mem_nhds hv₁_Uv)
    have h_nhds_v₁ :
        Metric.ball p.2 r_p ∩ h ⁻¹' Metric.ball (h v₁) (r_p / 2) ∈ nhds v₁ :=
      Filter.inter_mem (Metric.isOpen_ball.mem_nhds hv₁_ball)
        (hcont_h.preimage_mem_nhds (Metric.ball_mem_nhds (h v₁) (half_pos hr_p)))
    obtain ⟨δ_v, hδ_v, hδ_v_sub⟩ := Metric.mem_nhds_iff.mp h_nhds_v₁
    have hφ_map_eq : Filter.map φ (nhds v₁) = nhds (φ v₁) :=
      ((hφ_holo.analyticAt (hUv_open.mem_nhds hv₁_Uv)).hasStrictDerivAt).map_nhds_eq hv₁_ne
    have h_img_nhds : φ '' Metric.ball v₁ δ_v ∈ nhds (φ v₁) := by
      rw [← hφ_map_eq]
      exact Filter.image_mem_map (Metric.ball_mem_nhds v₁ hδ_v)
    obtain ⟨ε_v, hε_v, hε_v_sub⟩ := Metric.mem_nhds_iff.mp h_img_nhds
    let p₁ : ℂ × ℂ := (p.1, v₁)
    have hp₁_ball : p₁ ∈ Metric.ball p r_p := by
      rw [Metric.mem_ball, Prod.dist_eq]
      exact max_lt (by simpa [p₁] using hr_p) (Metric.mem_ball.mp hv₁_ball)
    let ε : ℝ := min (r_p / 2) ε_v
    have hε_pos : 0 < ε := lt_min (half_pos hr_p) hε_v
    refine ⟨p₁, hp₁_ball, ε, hε_pos, ?_⟩
    rintro ⟨w, t⟩ hwt
    have hΥp₁ : Υ p₁ = (p.1 + h v₁, φ v₁) := (hΥ_eq p₁ (hBp hp₁_ball)).2
    rw [hΥp₁, Metric.mem_ball, Prod.dist_eq, max_lt_iff] at hwt
    have hw_dist : dist w (p.1 + h v₁) < r_p / 2 :=
      lt_of_lt_of_le hwt.1 (min_le_left _ _)
    have ht_ball : t ∈ Metric.ball (φ v₁) ε_v :=
      Metric.mem_ball.mpr (lt_of_lt_of_le hwt.2 (min_le_right _ _))
    obtain ⟨v, hv_δ, hφv⟩ := hε_v_sub ht_ball
    have hv_mem := hδ_v_sub hv_δ
    have hv_ball : v ∈ Metric.ball p.2 r_p := hv_mem.1
    have hhv_dist : dist (h v) (h v₁) < r_p / 2 := Metric.mem_ball.mp hv_mem.2
    let q : ℂ × ℂ := (w - h v, v)
    have hq_ball : q ∈ Metric.ball p r_p := by
      rw [Metric.mem_ball, Prod.dist_eq, max_lt_iff]
      refine ⟨?_, Metric.mem_ball.mp hv_ball⟩
      dsimp [q]
      rw [dist_eq_norm] at hw_dist hhv_dist ⊢
      have h_decomp : w - h v - p.1 = (w - (p.1 + h v₁)) + (h v₁ - h v) := by ring
      have hhv_norm : ‖h v₁ - h v‖ = ‖h v - h v₁‖ := norm_sub_rev (h v₁) (h v)
      calc
        ‖w - h v - p.1‖ = ‖(w - (p.1 + h v₁)) + (h v₁ - h v)‖ := by rw [h_decomp]
        _ ≤ ‖w - (p.1 + h v₁)‖ + ‖h v₁ - h v‖ := norm_add_le _ _
        _ = ‖w - (p.1 + h v₁)‖ + ‖h v - h v₁‖ := by rw [hhv_norm]
        _ < r_p := by linarith
    refine ⟨q, hq_ball, ?_⟩
    rw [(hΥ_eq q (hBp hq_ball)).2]
    dsimp [q]
    rw [sub_add_cancel, hφv]

  have triangular_pullback_ne_zero :
      ∀ {U : Set (ℂ × ℂ)} {Υ : ℂ × ℂ → ℂ × ℂ} {p q₀ : ℂ × ℂ} {r R₂ : ℝ}
        {D : ℂ × ℂ → ℂ},
        IsTriangularHoloMap U Υ → p ∈ U → 0 < r → Metric.ball p r ⊆ U →
        DifferentiableOn ℂ D (Metric.ball q₀ R₂) →
        (∃ z₀ ∈ Metric.ball q₀ R₂, D z₀ ≠ 0) →
        Set.MapsTo Υ (Metric.ball p r) (Metric.ball q₀ R₂) →
        ∃ q ∈ Metric.ball p r, D (Υ q) ≠ 0 := by
    intro U Υ p q₀ r R₂ D hTri hp hr hBr_U hD ⟨z₀, hz₀B, hz₀_ne⟩ hMaps
    by_contra h_all
    have h_zero : ∀ q ∈ Metric.ball p r, D (Υ q) = 0 :=
      fun q hq => Classical.not_not.mp (fun hne => h_all ⟨q, hq, hne⟩)
    obtain ⟨p₁, hp₁_ball, ε, hε_pos, hε_sub⟩ :=
      triangular_image_contains_ball hTri hp hr hBr_U
    have hD_ball_zero : ∀ y ∈ Metric.ball (Υ p₁) ε ∩ Metric.ball q₀ R₂, D y = 0 := by
      rintro y ⟨hy_ε, _⟩
      obtain ⟨q, hq_ball, rfl⟩ := hε_sub hy_ε
      exact h_zero q hq_ball
    have hΥp₁_mem : Υ p₁ ∈ Metric.ball (Υ p₁) ε ∩ Metric.ball q₀ R₂ :=
      ⟨Metric.mem_ball_self hε_pos, hMaps hp₁_ball⟩
    exact hz₀_ne (eqOn_zero_of_convex_2D Metric.isOpen_ball (convex_ball q₀ R₂) hD
      Metric.isOpen_ball ⟨Υ p₁, hΥp₁_mem⟩ hD_ball_zero z₀ hz₀B)

  have cancel_pullback_ball_2D :
      ∀ {U : Set (ℂ × ℂ)} {Υ : ℂ × ℂ → ℂ × ℂ} {p q₀ : ℂ × ℂ} {r R₁ R₂ : ℝ}
        {Δ D : ℂ × ℂ → ℂ},
        IsTriangularHoloMap U Υ → p ∈ U → 0 < r → r ≤ R₁ → Metric.ball p r ⊆ U →
        DifferentiableOn ℂ Δ (Metric.ball p R₁) →
        DifferentiableOn ℂ D (Metric.ball q₀ R₂) →
        (∃ z₀ ∈ Metric.ball q₀ R₂, D z₀ ≠ 0) →
        Set.MapsTo Υ (Metric.ball p r) (Metric.ball q₀ R₂) →
        (∀ q ∈ Metric.ball p r, Δ q * D (Υ q) = 0) →
        ∀ q ∈ Metric.ball p R₁, Δ q = 0 := by
    intro U Υ p q₀ r R₁ R₂ Δ D hTri hp hr hrR₁ hBr_U hΔ hD hD_nz hMaps hprod
    have hDΥ_holo : DifferentiableOn ℂ (fun q => D (Υ q)) (Metric.ball p r) :=
      hD.comp ((triangular_holo hTri).mono hBr_U) hMaps
    have hDΥ_nz : ∃ q₁ ∈ Metric.ball p r, D (Υ q₁) ≠ 0 :=
      triangular_pullback_ne_zero hTri hp hr hBr_U hD hD_nz hMaps
    have hp_R₁ : p ∈ Metric.ball p R₁ := Metric.mem_ball_self (lt_of_lt_of_le hr hrR₁)
    have hp_r : p ∈ Metric.ball p r := Metric.mem_ball_self hr
    exact cancel_holo_of_convex_2D
      Metric.isOpen_ball (convex_ball p R₁) hΔ
      Metric.isOpen_ball (convex_ball p r) hDΥ_holo hDΥ_nz
      Metric.isOpen_ball ⟨p, ⟨hp_r, hp_R₁⟩, hp_r⟩
      (fun q hq => hprod q hq.2)

  have fn_ofHolo : ∀ (U : Set (ℂ × ℂ)) (f : ℂ × ℂ → ℂ),
      IsOpen U → DifferentiableOn ℂ f U →
      ∃ H : MeroOn2D U, MeroAgreesHolo H f U ∧
        ∀ (W : Set (ℂ × ℂ)) (F : MeroOn2D W) (V : Set (ℂ × ℂ)),
          IsOpen V → V ⊆ U →
          (MeroAgreesHolo F f V ↔ MeroEqOn F H V) := by
    classical
    intro U f hU hf
    let r_U : ∀ p ∈ U, ℝ := fun p hp => Classical.choose (Metric.isOpen_iff.mp hU p hp)
    have hr_U : ∀ p (hp : p ∈ U), 0 < r_U p hp ∧ Metric.ball p (r_U p hp) ⊆ U :=
      fun p hp => Classical.choose_spec (Metric.isOpen_iff.mp hU p hp)
    let H : MeroOn2D U := {
      rad := fun p => if hp : p ∈ U then r_U p hp else 1
      num := fun _ => f
      den := fun _ _ => 1
      rad_pos := fun p hp => by
        simp only [hp, ↓reduceDIte]
        exact (hr_U p hp).1
      ball_sub := fun p hp => by
        simp only [hp, ↓reduceDIte]
        exact (hr_U p hp).2
      num_holo := fun p hp => by
        simp only [hp, ↓reduceDIte]
        exact hf.mono (hr_U p hp).2
      den_holo := fun p hp => by
        simp only [hp, ↓reduceDIte]
        exact differentiableOn_const 1
      den_ne_zero := fun p hp => by
        simp only [hp, ↓reduceDIte]
        exact ⟨p, Metric.mem_ball_self (hr_U p hp).1, one_ne_zero⟩
      compat := fun _ _ _ _ _ _ => rfl
    }
    refine ⟨H, ?_, ?_⟩
    · refine ⟨Set.Subset.rfl, fun p hp => ?_⟩
      refine ⟨r_U p hp, (hr_U p hp).1, ?_, (hr_U p hp).2, fun q _ => (mul_one (f q)).symm⟩
      simp only [H, hp, ↓reduceDIte, le_rfl]
    · intro W F V hV hVU
      constructor
      · intro hAg
        refine ⟨fun p hp => ⟨hAg.1 hp, hVU hp⟩, fun p hp => ?_⟩
        have hpW : p ∈ W := hAg.1 hp
        have hpU : p ∈ U := hVU hp
        obtain ⟨r₀, hr₀_pos, _, _, hr₀_eq⟩ := hAg.2 p hp
        let R : ℝ := min (F.rad p) (H.rad p)
        have hR_pos : 0 < R := lt_min (F.rad_pos p hpW) (H.rad_pos p hpU)
        let Δ : ℂ × ℂ → ℂ := fun q => F.num p q * H.den p q - H.num p q * F.den p q
        have hΔ_holo : DifferentiableOn ℂ Δ (Metric.ball p R) :=
          (((F.num_holo p hpW).mono (Metric.ball_subset_ball (min_le_left _ _))).mul
            ((H.den_holo p hpU).mono (Metric.ball_subset_ball (min_le_right _ _)))).sub
          (((H.num_holo p hpU).mono (Metric.ball_subset_ball (min_le_right _ _))).mul
            ((F.den_holo p hpW).mono (Metric.ball_subset_ball (min_le_left _ _))))
        have hΔ_sub : ∀ q ∈ Metric.ball p r₀ ∩ Metric.ball p R, Δ q = 0 := by
          rintro q ⟨hq₀, _⟩
          dsimp [Δ, H]
          rw [mul_one, hr₀_eq q hq₀, sub_self]
        intro q hq
        exact sub_eq_zero.mp (eqOn_zero_of_convex_2D Metric.isOpen_ball (convex_ball p R)
          hΔ_holo Metric.isOpen_ball
          ⟨p, Metric.mem_ball_self hr₀_pos, Metric.mem_ball_self hR_pos⟩ hΔ_sub q hq)
      · intro hEq
        refine ⟨fun p hp => (hEq.1 hp).1, fun p hp => ?_⟩
        have hpW : p ∈ W := (hEq.1 hp).1
        have hpU : p ∈ U := (hEq.1 hp).2
        obtain ⟨r_V, hr_V_pos, hr_V_sub⟩ := Metric.isOpen_iff.mp hV p hp
        let r : ℝ := min r_V (min (F.rad p) (H.rad p))
        have hr_pos : 0 < r :=
          lt_min hr_V_pos (lt_min (F.rad_pos p hpW) (H.rad_pos p hpU))
        refine ⟨r, hr_pos, le_trans (min_le_right _ _) (min_le_left _ _),
          Set.Subset.trans (Metric.ball_subset_ball (min_le_left _ _)) hr_V_sub, ?_⟩
        intro q hq
        have h_eq := hEq.2 p hp q (Metric.ball_subset_ball (min_le_right _ _) hq)
        simpa [H] using h_eq

  have fn_eqOn_symm :
      ∀ {W₁ W₂ : Set (ℂ × ℂ)} (F₁ : MeroOn2D W₁) (F₂ : MeroOn2D W₂)
        (U : Set (ℂ × ℂ)), MeroEqOn F₁ F₂ U → MeroEqOn F₂ F₁ U := by
    intro W₁ W₂ F₁ F₂ U h
    refine ⟨fun p hp => ⟨(h.1 hp).2, (h.1 hp).1⟩, fun p hp q hq => ?_⟩
    rw [min_comm] at hq
    exact (h.2 p hp q hq).symm

  have fn_eqOn_mono :
      ∀ {W₁ W₂ : Set (ℂ × ℂ)} (F₁ : MeroOn2D W₁) (F₂ : MeroOn2D W₂)
        {U V : Set (ℂ × ℂ)}, V ⊆ U → MeroEqOn F₁ F₂ U → MeroEqOn F₁ F₂ V := by
    intro W₁ W₂ F₁ F₂ U V hVU h
    exact ⟨Set.Subset.trans hVU h.1, fun p hp => h.2 p (hVU hp)⟩

  have fn_eqOn_trans :
      ∀ {W₁ W₂ W₃ : Set (ℂ × ℂ)}
        (F₁ : MeroOn2D W₁) (F₂ : MeroOn2D W₂) (F₃ : MeroOn2D W₃)
        (U : Set (ℂ × ℂ)),
        MeroEqOn F₁ F₂ U → MeroEqOn F₂ F₃ U → MeroEqOn F₁ F₃ U := by
    intro W₁ W₂ W₃ F₁ F₂ F₃ U h₁₂ h₂₃
    refine ⟨fun p hp => ⟨(h₁₂.1 hp).1, (h₂₃.1 hp).2⟩, fun p hp => ?_⟩
    have hp₁ : p ∈ W₁ := (h₁₂.1 hp).1
    have hp₂ : p ∈ W₂ := (h₁₂.1 hp).2
    have hp₃ : p ∈ W₃ := (h₂₃.1 hp).2
    let r₁₃ : ℝ := min (F₁.rad p) (F₃.rad p)
    let r₁₂₃ : ℝ := min r₁₃ (F₂.rad p)
    have hr₁₃ : 0 < r₁₃ := lt_min (F₁.rad_pos p hp₁) (F₃.rad_pos p hp₃)
    have hr₁₂₃ : 0 < r₁₂₃ := lt_min hr₁₃ (F₂.rad_pos p hp₂)
    let Δ : ℂ × ℂ → ℂ := fun q => F₁.num p q * F₃.den p q - F₃.num p q * F₁.den p q
    have hΔ_holo : DifferentiableOn ℂ Δ (Metric.ball p r₁₃) :=
      (((F₁.num_holo p hp₁).mono (Metric.ball_subset_ball (min_le_left _ _))).mul
        ((F₃.den_holo p hp₃).mono (Metric.ball_subset_ball (min_le_right _ _)))).sub
      (((F₃.num_holo p hp₃).mono (Metric.ball_subset_ball (min_le_right _ _))).mul
        ((F₁.den_holo p hp₁).mono (Metric.ball_subset_ball (min_le_left _ _))))
    have hprod_zero :
        ∀ q ∈ (Metric.ball p r₁₂₃ ∩ Metric.ball p r₁₃) ∩ Metric.ball p (F₂.rad p),
          Δ q * F₂.den p q = 0 := by
      rintro q ⟨⟨hq, _⟩, _⟩
      have hq₁₂ : q ∈ Metric.ball p (min (F₁.rad p) (F₂.rad p)) :=
        Metric.ball_subset_ball
          (le_min (le_trans (min_le_left _ _) (min_le_left _ _)) (min_le_right _ _)) hq
      have hq₂₃ : q ∈ Metric.ball p (min (F₂.rad p) (F₃.rad p)) :=
        Metric.ball_subset_ball
          (le_min (min_le_right _ _) (le_trans (min_le_left _ _) (min_le_right _ _))) hq
      have e₁₂ := h₁₂.2 p hp q hq₁₂
      have e₂₃ := h₂₃.2 p hp q hq₂₃
      dsimp [Δ]
      linear_combination F₃.den p q * e₁₂ + F₁.den p q * e₂₃
    intro q hq
    exact sub_eq_zero.mp (cancel_holo_of_convex_2D
      Metric.isOpen_ball (convex_ball p r₁₃) hΔ_holo
      Metric.isOpen_ball (convex_ball p (F₂.rad p)) (F₂.den_holo p hp₂) (F₂.den_ne_zero p hp₂)
      Metric.isOpen_ball
      ⟨p, ⟨Metric.mem_ball_self hr₁₂₃, Metric.mem_ball_self hr₁₃⟩,
        Metric.mem_ball_self (F₂.rad_pos p hp₂)⟩
      hprod_zero q hq)

  have meroEq_step :
      ∀ {W₁ W₂ : Set (ℂ × ℂ)} (F₁ : MeroOn2D W₁) (F₂ : MeroOn2D W₂)
        {p₀ p₁ : ℂ × ℂ},
        p₀ ∈ W₁ ∩ W₂ → p₁ ∈ W₁ ∩ W₂ →
        (Metric.ball p₀ (min (F₁.rad p₀) (F₂.rad p₀)) ∩
          Metric.ball p₁ (min (F₁.rad p₁) (F₂.rad p₁))).Nonempty →
        (∀ q ∈ Metric.ball p₀ (min (F₁.rad p₀) (F₂.rad p₀)),
          F₁.num p₀ q * F₂.den p₀ q = F₂.num p₀ q * F₁.den p₀ q) →
        ∀ q ∈ Metric.ball p₁ (min (F₁.rad p₁) (F₂.rad p₁)),
          F₁.num p₁ q * F₂.den p₁ q = F₂.num p₁ q * F₁.den p₁ q := by
    intro W₁ W₂ F₁ F₂ p₀ p₁ hp₀ hp₁ ⟨q_ov, hq_ov₀, hq_ov₁⟩ hEq₀
    let r₀ : ℝ := min (F₁.rad p₀) (F₂.rad p₀)
    let r₁ : ℝ := min (F₁.rad p₁) (F₂.rad p₁)
    let O : Set (ℂ × ℂ) := Metric.ball p₀ r₀ ∩ Metric.ball p₁ r₁
    have hO_open : IsOpen O := Metric.isOpen_ball.inter Metric.isOpen_ball
    have hO_conv : Convex ℝ O := (convex_ball p₀ r₀).inter (convex_ball p₁ r₁)
    have hq_ov_O : q_ov ∈ O := ⟨hq_ov₀, hq_ov₁⟩
    let Δ₁ : ℂ × ℂ → ℂ :=
      fun q => F₁.num p₁ q * F₂.den p₁ q - F₂.num p₁ q * F₁.den p₁ q
    have hΔ₁_holo_B₁ : DifferentiableOn ℂ Δ₁ (Metric.ball p₁ r₁) :=
      (((F₁.num_holo p₁ hp₁.1).mono (Metric.ball_subset_ball (min_le_left _ _))).mul
        ((F₂.den_holo p₁ hp₁.2).mono (Metric.ball_subset_ball (min_le_right _ _)))).sub
      (((F₂.num_holo p₁ hp₁.2).mono (Metric.ball_subset_ball (min_le_right _ _))).mul
        ((F₁.den_holo p₁ hp₁.1).mono (Metric.ball_subset_ball (min_le_left _ _))))
    have hΔ₁_mul_holo_O : DifferentiableOn ℂ (fun q => Δ₁ q * F₁.den p₀ q) O :=
      (hΔ₁_holo_B₁.mono Set.inter_subset_right).mul
        ((F₁.den_holo p₀ hp₀.1).mono
          (fun _ hq => Metric.ball_subset_ball (min_le_left _ _) hq.1))
    have hprod₂ : ∀ q ∈ (O ∩ O) ∩ Metric.ball p₀ (F₂.rad p₀),
        (Δ₁ q * F₁.den p₀ q) * F₂.den p₀ q = 0 := by
      rintro q ⟨⟨hqO, _⟩, _⟩
      have c₁ := F₁.compat p₁ hp₁.1 p₀ hp₀.1 q
        ⟨Metric.ball_subset_ball (min_le_left _ _) hqO.2,
          Metric.ball_subset_ball (min_le_left _ _) hqO.1⟩
      have c₂ := F₂.compat p₁ hp₁.2 p₀ hp₀.2 q
        ⟨Metric.ball_subset_ball (min_le_right _ _) hqO.2,
          Metric.ball_subset_ball (min_le_right _ _) hqO.1⟩
      have e₀ := hEq₀ q hqO.1
      dsimp [Δ₁]
      linear_combination
        F₂.den p₁ q * F₂.den p₀ q * c₁ -
        F₁.den p₁ q * F₁.den p₀ q * c₂ +
        F₁.den p₁ q * F₂.den p₁ q * e₀
    have hprod₁ : ∀ q ∈ O, Δ₁ q * F₁.den p₀ q = 0 :=
      cancel_holo_of_convex_2D hO_open hO_conv hΔ₁_mul_holo_O
        Metric.isOpen_ball (convex_ball p₀ (F₂.rad p₀))
        (F₂.den_holo p₀ hp₀.2) (F₂.den_ne_zero p₀ hp₀.2)
        hO_open ⟨q_ov, ⟨hq_ov_O, hq_ov_O⟩, Metric.ball_subset_ball (min_le_right _ _) hq_ov₀⟩
        hprod₂
    have hΔ₁_zero : ∀ q ∈ Metric.ball p₁ r₁, Δ₁ q = 0 :=
      cancel_holo_of_convex_2D Metric.isOpen_ball (convex_ball p₁ r₁) hΔ₁_holo_B₁
        Metric.isOpen_ball (convex_ball p₀ (F₁.rad p₀))
        (F₁.den_holo p₀ hp₀.1) (F₁.den_ne_zero p₀ hp₀.1)
        hO_open ⟨q_ov, ⟨hq_ov_O, hq_ov₁⟩, Metric.ball_subset_ball (min_le_left _ _) hq_ov₀⟩
        (fun q hq => hprod₁ q hq.1.1)
    intro q hq
    exact sub_eq_zero.mp (hΔ₁_zero q hq)

  have fn_eqOn_of_isPreconnected :
      ∀ {W₁ W₂ : Set (ℂ × ℂ)}
        (F₁ : MeroOn2D W₁) (F₂ : MeroOn2D W₂) (V V₀ : Set (ℂ × ℂ)),
        IsOpen V → IsPreconnected V → V ⊆ W₁ ∩ W₂ →
        IsOpen V₀ → V₀.Nonempty → V₀ ⊆ V →
        MeroEqOn F₁ F₂ V₀ → MeroEqOn F₁ F₂ V := by
    intro W₁ W₂ F₁ F₂ V V₀ _hV_open hV_pre hV_sub _hV₀_open ⟨p_init, hp_init⟩ hV₀_sub hEq₀
    let Ω_eq : Set (ℂ × ℂ) :=
      { p ∈ W₁ ∩ W₂ | ∀ q ∈ Metric.ball p (min (F₁.rad p) (F₂.rad p)),
          F₁.num p q * F₂.den p q = F₂.num p q * F₁.den p q }
    have hΩ_open : IsOpen Ω_eq := by
      rw [Metric.isOpen_iff]
      rintro p₀ ⟨hp₀_W, hp₀_eq⟩
      let r₀ : ℝ := min (F₁.rad p₀) (F₂.rad p₀)
      have hr₀ : 0 < r₀ := lt_min (F₁.rad_pos p₀ hp₀_W.1) (F₂.rad_pos p₀ hp₀_W.2)
      refine ⟨r₀, hr₀, ?_⟩
      intro p₁ hp₁_ball
      have hp₁_W : p₁ ∈ W₁ ∩ W₂ :=
        ⟨F₁.ball_sub p₀ hp₀_W.1 (Metric.ball_subset_ball (min_le_left _ _) hp₁_ball),
          F₂.ball_sub p₀ hp₀_W.2 (Metric.ball_subset_ball (min_le_right _ _) hp₁_ball)⟩
      have hr₁ : 0 < min (F₁.rad p₁) (F₂.rad p₁) :=
        lt_min (F₁.rad_pos p₁ hp₁_W.1) (F₂.rad_pos p₁ hp₁_W.2)
      exact ⟨hp₁_W, meroEq_step F₁ F₂ hp₀_W hp₁_W
        ⟨p₁, hp₁_ball, Metric.mem_ball_self hr₁⟩ hp₀_eq⟩
    have hΩ_ne : (V ∩ Ω_eq).Nonempty :=
      ⟨p_init, hV₀_sub hp_init, hV_sub (hV₀_sub hp_init), hEq₀.2 p_init hp_init⟩
    have hΩ_cl : closure Ω_eq ∩ V ⊆ Ω_eq := by
      rintro p₁ ⟨hp₁_cl, hp₁_V⟩
      have hp₁_W : p₁ ∈ W₁ ∩ W₂ := hV_sub hp₁_V
      let r₁ : ℝ := min (F₁.rad p₁) (F₂.rad p₁)
      have hr₁ : 0 < r₁ := lt_min (F₁.rad_pos p₁ hp₁_W.1) (F₂.rad_pos p₁ hp₁_W.2)
      obtain ⟨p₀, ⟨hp₀_W, hp₀_eq⟩, hdist⟩ := Metric.mem_closure_iff.mp hp₁_cl r₁ hr₁
      have hr₀ : 0 < min (F₁.rad p₀) (F₂.rad p₀) :=
        lt_min (F₁.rad_pos p₀ hp₀_W.1) (F₂.rad_pos p₀ hp₀_W.2)
      have hp₀_B₁ : p₀ ∈ Metric.ball p₁ r₁ := by
        rw [Metric.mem_ball, dist_comm]
        exact hdist
      exact ⟨hp₁_W, meroEq_step F₁ F₂ hp₀_W hp₁_W
        ⟨p₀, Metric.mem_ball_self hr₀, hp₀_B₁⟩ hp₀_eq⟩
    have hV_Ω : V ⊆ Ω_eq :=
      hV_pre.subset_of_closure_inter_subset hΩ_open hΩ_ne hΩ_cl
    exact ⟨hV_sub, fun p hp => (hV_Ω hp).2⟩

  have fn_restrictOpen :
      ∀ {W : Set (ℂ × ℂ)} (F : MeroOn2D W) (V : Set (ℂ × ℂ)),
        IsOpen V → V ⊆ W → ∃ G : MeroOn2D V, MeroEqOn G F V := by
    classical
    intro W F V hV hVW
    let r_V : ∀ p ∈ V, ℝ := fun p hp => Classical.choose (Metric.isOpen_iff.mp hV p hp)
    have hr_V : ∀ p (hp : p ∈ V), 0 < r_V p hp ∧ Metric.ball p (r_V p hp) ⊆ V :=
      fun p hp => Classical.choose_spec (Metric.isOpen_iff.mp hV p hp)
    let G : MeroOn2D V := {
      rad := fun p => if hp : p ∈ V then min (F.rad p) (r_V p hp) else 1
      num := F.num
      den := F.den
      rad_pos := fun p hp => by
        simp only [hp, ↓reduceDIte]
        exact lt_min (F.rad_pos p (hVW hp)) (hr_V p hp).1
      ball_sub := fun p hp => by
        simp only [hp, ↓reduceDIte]
        exact Set.Subset.trans (Metric.ball_subset_ball (min_le_right _ _)) (hr_V p hp).2
      num_holo := fun p hp => by
        simp only [hp, ↓reduceDIte]
        exact (F.num_holo p (hVW hp)).mono (Metric.ball_subset_ball (min_le_left _ _))
      den_holo := fun p hp => by
        simp only [hp, ↓reduceDIte]
        exact (F.den_holo p (hVW hp)).mono (Metric.ball_subset_ball (min_le_left _ _))
      den_ne_zero := fun p hp => by
        simp only [hp, ↓reduceDIte]
        have hr_clamp : 0 < min (F.rad p) (r_V p hp) :=
          lt_min (F.rad_pos p (hVW hp)) (hr_V p hp).1
        obtain ⟨x₁, ⟨hx₁_clamp, _⟩, hx₁_ne⟩ :=
          exists_ne_zero_of_convex_2D
            Metric.isOpen_ball (convex_ball p (F.rad p))
            (F.den_holo p (hVW hp)) (F.den_ne_zero p (hVW hp))
            Metric.isOpen_ball
            ⟨p, Metric.mem_ball_self hr_clamp, Metric.mem_ball_self (F.rad_pos p (hVW hp))⟩
        exact ⟨x₁, hx₁_clamp, hx₁_ne⟩
      compat := fun p₁ hp₁ p₂ hp₂ q hq => by
        simp only [hp₁, hp₂, ↓reduceDIte] at hq
        exact F.compat p₁ (hVW hp₁) p₂ (hVW hp₂) q
          ⟨Metric.ball_subset_ball (min_le_left _ _) hq.1,
            Metric.ball_subset_ball (min_le_left _ _) hq.2⟩
    }
    exact ⟨G, ⟨fun p hp => ⟨hp, hVW hp⟩, fun _ _ _ _ => rfl⟩⟩

  have fn_glueCover :
      ∀ {ι : Type} (U : ι → Set (ℂ × ℂ)) (W : Set (ℂ × ℂ))
        (G : ∀ α, MeroOn2D (U α)),
        (∀ α, IsOpen (U α)) → IsOpen W → W ⊆ (⋃ α, U α) →
        (∀ α β, MeroEqOn (G α) (G β) (U α ∩ U β)) →
        ∃ F : MeroOn2D W, ∀ α, MeroEqOn F (G α) (W ∩ U α) := by
    classical
    intro ι U W G _hU_open hW_open hW_cov hcompat
    let idx : ∀ p ∈ W, ι := fun p hp => Classical.choose (Set.mem_iUnion.mp (hW_cov hp))
    have hidx : ∀ p (hp : p ∈ W), p ∈ U (idx p hp) :=
      fun p hp => Classical.choose_spec (Set.mem_iUnion.mp (hW_cov hp))
    let r_W : ∀ p ∈ W, ℝ := fun p hp => Classical.choose (Metric.isOpen_iff.mp hW_open p hp)
    have hr_W : ∀ p (hp : p ∈ W), 0 < r_W p hp ∧ Metric.ball p (r_W p hp) ⊆ W :=
      fun p hp => Classical.choose_spec (Metric.isOpen_iff.mp hW_open p hp)
    let F : MeroOn2D W := {
      rad := fun p => if hp : p ∈ W then min ((G (idx p hp)).rad p) (r_W p hp) else 1
      num := fun p => if hp : p ∈ W then (G (idx p hp)).num p else fun _ => 0
      den := fun p => if hp : p ∈ W then (G (idx p hp)).den p else fun _ => 1
      rad_pos := fun p hp => by
        simp only [hp, ↓reduceDIte]
        exact lt_min ((G (idx p hp)).rad_pos p (hidx p hp)) (hr_W p hp).1
      ball_sub := fun p hp => by
        simp only [hp, ↓reduceDIte]
        exact Set.Subset.trans (Metric.ball_subset_ball (min_le_right _ _)) (hr_W p hp).2
      num_holo := fun p hp => by
        simp only [hp, ↓reduceDIte]
        exact ((G (idx p hp)).num_holo p (hidx p hp)).mono
          (Metric.ball_subset_ball (min_le_left _ _))
      den_holo := fun p hp => by
        simp only [hp, ↓reduceDIte]
        exact ((G (idx p hp)).den_holo p (hidx p hp)).mono
          (Metric.ball_subset_ball (min_le_left _ _))
      den_ne_zero := fun p hp => by
        simp only [hp, ↓reduceDIte]
        let α_p : ι := idx p hp
        let r_clamp : ℝ := min ((G α_p).rad p) (r_W p hp)
        have hr_clamp : 0 < r_clamp :=
          lt_min ((G α_p).rad_pos p (hidx p hp)) (hr_W p hp).1
        obtain ⟨x₁, ⟨hx₁_clamp, _⟩, hx₁_ne⟩ :=
          exists_ne_zero_of_convex_2D
            Metric.isOpen_ball (convex_ball p ((G α_p).rad p))
            ((G α_p).den_holo p (hidx p hp)) ((G α_p).den_ne_zero p (hidx p hp))
            Metric.isOpen_ball
            ⟨p, Metric.mem_ball_self hr_clamp,
              Metric.mem_ball_self ((G α_p).rad_pos p (hidx p hp))⟩
        exact ⟨x₁, hx₁_clamp, hx₁_ne⟩
      compat := fun p₁ hp₁ p₂ hp₂ q₀ hq₀ => by
        simp only [hp₁, hp₂, ↓reduceDIte] at hq₀ ⊢
        let α₁ : ι := idx p₁ hp₁
        let α₂ : ι := idx p₂ hp₂
        have hα₁ : p₁ ∈ U α₁ := hidx p₁ hp₁
        have hα₂ : p₂ ∈ U α₂ := hidx p₂ hp₂
        have hq₀_B₁ : q₀ ∈ Metric.ball p₁ ((G α₁).rad p₁) :=
          Metric.ball_subset_ball (min_le_left _ _) hq₀.1
        have hq₀_B₂ : q₀ ∈ Metric.ball p₂ ((G α₂).rad p₂) :=
          Metric.ball_subset_ball (min_le_left _ _) hq₀.2
        have hq₀_1 : q₀ ∈ U α₁ := (G α₁).ball_sub p₁ hα₁ hq₀_B₁
        have hq₀_2 : q₀ ∈ U α₂ := (G α₂).ball_sub p₂ hα₂ hq₀_B₂
        let r_q : ℝ := min ((G α₁).rad q₀) ((G α₂).rad q₀)
        have hr_q : 0 < r_q := lt_min ((G α₁).rad_pos q₀ hq₀_1) ((G α₂).rad_pos q₀ hq₀_2)
        let C : Set (ℂ × ℂ) :=
          (Metric.ball p₁ ((G α₁).rad p₁) ∩ Metric.ball p₂ ((G α₂).rad p₂)) ∩
            Metric.ball q₀ r_q
        have hC_open : IsOpen C :=
          (Metric.isOpen_ball.inter Metric.isOpen_ball).inter Metric.isOpen_ball
        have hC_conv : Convex ℝ C :=
          ((convex_ball p₁ ((G α₁).rad p₁)).inter (convex_ball p₂ ((G α₂).rad p₂))).inter
            (convex_ball q₀ r_q)
        have hq₀_C : q₀ ∈ C := ⟨⟨hq₀_B₁, hq₀_B₂⟩, Metric.mem_ball_self hr_q⟩
        let Δ : ℂ × ℂ → ℂ :=
          fun x => (G α₁).num p₁ x * (G α₂).den p₂ x - (G α₂).num p₂ x * (G α₁).den p₁ x
        have hΔ_holo : DifferentiableOn ℂ Δ C :=
          ((((G α₁).num_holo p₁ hα₁).mono (fun _ hx => hx.1.1)).mul
            (((G α₂).den_holo p₂ hα₂).mono (fun _ hx => hx.1.2))).sub
          ((((G α₂).num_holo p₂ hα₂).mono (fun _ hx => hx.1.2)).mul
            (((G α₁).den_holo p₁ hα₁).mono (fun _ hx => hx.1.1)))
        have hΔ_mul_holo : DifferentiableOn ℂ (fun x => Δ x * (G α₁).den q₀ x) C :=
          hΔ_holo.mul (((G α₁).den_holo q₀ hq₀_1).mono
            (fun _ hx => Metric.ball_subset_ball (min_le_left _ _) hx.2))
        have hprod₂ : ∀ x ∈ (C ∩ C) ∩ Metric.ball q₀ ((G α₂).rad q₀),
            (Δ x * (G α₁).den q₀ x) * (G α₂).den q₀ x = 0 := by
          rintro x ⟨⟨hx, _⟩, _⟩
          have c₁ := (G α₁).compat p₁ hα₁ q₀ hq₀_1 x
            ⟨hx.1.1, Metric.ball_subset_ball (min_le_left _ _) hx.2⟩
          have c₂ := (G α₂).compat p₂ hα₂ q₀ hq₀_2 x
            ⟨hx.1.2, Metric.ball_subset_ball (min_le_right _ _) hx.2⟩
          have e₁₂ := (hcompat α₁ α₂).2 q₀ ⟨hq₀_1, hq₀_2⟩ x hx.2
          dsimp [Δ]
          linear_combination
            (G α₂).den p₂ x * (G α₂).den q₀ x * c₁ -
            (G α₁).den p₁ x * (G α₁).den q₀ x * c₂ +
            (G α₁).den p₁ x * (G α₂).den p₂ x * e₁₂
        have hprod₁ : ∀ x ∈ C, Δ x * (G α₁).den q₀ x = 0 :=
          cancel_holo_of_convex_2D hC_open hC_conv hΔ_mul_holo
            Metric.isOpen_ball (convex_ball q₀ ((G α₂).rad q₀))
            ((G α₂).den_holo q₀ hq₀_2) ((G α₂).den_ne_zero q₀ hq₀_2)
            hC_open ⟨q₀, ⟨hq₀_C, hq₀_C⟩, Metric.mem_ball_self ((G α₂).rad_pos q₀ hq₀_2)⟩
            hprod₂
        have hΔ_zero : ∀ x ∈ C, Δ x = 0 :=
          cancel_holo_of_convex_2D hC_open hC_conv hΔ_holo
            Metric.isOpen_ball (convex_ball q₀ ((G α₁).rad q₀))
            ((G α₁).den_holo q₀ hq₀_1) ((G α₁).den_ne_zero q₀ hq₀_1)
            hC_open ⟨q₀, ⟨hq₀_C, hq₀_C⟩, Metric.mem_ball_self ((G α₁).rad_pos q₀ hq₀_1)⟩
            (fun x hx => hprod₁ x hx.1.1)
        exact sub_eq_zero.mp (hΔ_zero q₀ hq₀_C)
    }
    refine ⟨F, fun α => ⟨Set.Subset.rfl, fun p hp q hq => ?_⟩⟩
    have hpW : p ∈ W := hp.1
    simp only [F, hpW, ↓reduceDIte] at hq ⊢
    have hq_compat : q ∈ Metric.ball p (min ((G (idx p hpW)).rad p) ((G α).rad p)) :=
      Metric.ball_subset_ball
        (le_min (le_trans (min_le_left _ _) (min_le_left _ _)) (min_le_right _ _)) hq
    exact (hcompat (idx p hpW) α).2 p ⟨hidx p hpW, hp.2⟩ q hq_compat

  have fn_glueBinary :
      ∀ {U₁ U₂ W : Set (ℂ × ℂ)} (G₁ : MeroOn2D U₁) (G₂ : MeroOn2D U₂),
        IsOpen U₁ → IsOpen U₂ → IsOpen W → W ⊆ U₁ ∪ U₂ →
        MeroEqOn G₁ G₂ (U₁ ∩ U₂) →
        ∃ F : MeroOn2D W, MeroEqOn F G₁ (W ∩ U₁) ∧ MeroEqOn F G₂ (W ∩ U₂) := by
    intro U₁ U₂ W G₁ G₂ hU₁ hU₂ hW hcov hEq₁₂
    let U_fam : Bool → Set (ℂ × ℂ) := fun b => cond b U₁ U₂
    let G_fam : ∀ b : Bool, MeroOn2D (U_fam b)
      | true => G₁
      | false => G₂
    have hU_open : ∀ b : Bool, IsOpen (U_fam b) := fun b => by
      cases b
      · exact hU₂
      · exact hU₁
    have hW_cov : W ⊆ ⋃ b : Bool, U_fam b := by
      intro p hp
      rcases hcov hp with hp₁ | hp₂
      · exact Set.mem_iUnion.mpr ⟨true, hp₁⟩
      · exact Set.mem_iUnion.mpr ⟨false, hp₂⟩
    have hcompat : ∀ b₁ b₂ : Bool, MeroEqOn (G_fam b₁) (G_fam b₂) (U_fam b₁ ∩ U_fam b₂) := by
      intro b₁ b₂
      cases b₁ <;> cases b₂
      · exact ⟨fun _ hp => hp, fun _ _ _ _ => rfl⟩
      · simpa [U_fam, G_fam, Set.inter_comm] using fn_eqOn_symm G₁ G₂ (U₁ ∩ U₂) hEq₁₂
      · simpa [U_fam, G_fam] using hEq₁₂
      · exact ⟨fun _ hp => hp, fun _ _ _ _ => rfl⟩
    obtain ⟨F, hF⟩ := fn_glueCover U_fam W G_fam hU_open hW hW_cov hcompat
    exact ⟨F, hF true, hF false⟩

  have fn_triangular_mono :
      ∀ {W₁ U : Set (ℂ × ℂ)} (Υ : ℂ × ℂ → ℂ × ℂ),
        IsOpen U → U ⊆ W₁ → IsTriangularHoloMap W₁ Υ → IsTriangularHoloMap U Υ := by
    rintro W₁ U Υ hU hUW₁ ⟨_, U_v, h, φ, hUv_open, hUv_pre, hΥ_eq, hh_holo, hφ_holo, hv₀⟩
    exact ⟨hU, U_v, h, φ, hUv_open, hUv_pre, fun p hp => hΥ_eq p (hUW₁ hp),
      hh_holo, hφ_holo, hv₀⟩

  have fn_eqOn_iff_pullback_id :
      ∀ {W₁ W₂ : Set (ℂ × ℂ)} (F₁ : MeroOn2D W₁) (F₂ : MeroOn2D W₂)
        (U : Set (ℂ × ℂ)), MeroEqOn F₁ F₂ U ↔ MeroEqOnPullback F₁ F₂ id U := by
    intro W₁ W₂ F₁ F₂ U
    constructor
    · intro hEq
      refine ⟨fun p hp => (hEq.1 hp).1, fun p hp => (hEq.1 hp).2, fun p hp => ?_⟩
      have hp₁ : p ∈ W₁ := (hEq.1 hp).1
      have hp₂ : p ∈ W₂ := (hEq.1 hp).2
      refine ⟨min (F₁.rad p) (F₂.rad p),
        lt_min (F₁.rad_pos p hp₁) (F₂.rad_pos p hp₂),
        min_le_left _ _,
        fun q hq => Metric.ball_subset_ball (min_le_right _ _) hq,
        fun q hq => hEq.2 p hp q hq⟩
    · intro hPb
      refine ⟨fun p hp => ⟨hPb.1 hp, hPb.2.1 hp⟩, fun p hp => ?_⟩
      have hp₁ : p ∈ W₁ := hPb.1 hp
      have hp₂ : p ∈ W₂ := hPb.2.1 hp
      obtain ⟨r, hr_pos, _, _, hr_eq⟩ := hPb.2.2 p hp
      let R : ℝ := min (F₁.rad p) (F₂.rad p)
      have hR_pos : 0 < R := lt_min (F₁.rad_pos p hp₁) (F₂.rad_pos p hp₂)
      let Δ : ℂ × ℂ → ℂ := fun q => F₁.num p q * F₂.den p q - F₂.num p q * F₁.den p q
      have hΔ_holo : DifferentiableOn ℂ Δ (Metric.ball p R) :=
        (((F₁.num_holo p hp₁).mono (Metric.ball_subset_ball (min_le_left _ _))).mul
          ((F₂.den_holo p hp₂).mono (Metric.ball_subset_ball (min_le_right _ _)))).sub
        (((F₂.num_holo p hp₂).mono (Metric.ball_subset_ball (min_le_right _ _))).mul
          ((F₁.den_holo p hp₁).mono (Metric.ball_subset_ball (min_le_left _ _))))
      have hΔ_sub : ∀ q ∈ Metric.ball p r ∩ Metric.ball p R, Δ q = 0 := by
        rintro q ⟨hq_r, _⟩
        exact sub_eq_zero.mpr (hr_eq q hq_r)
      intro q hq
      exact sub_eq_zero.mp (eqOn_zero_of_convex_2D Metric.isOpen_ball (convex_ball p R)
        hΔ_holo Metric.isOpen_ball
        ⟨p, Metric.mem_ball_self hr_pos, Metric.mem_ball_self hR_pos⟩ hΔ_sub q hq)

  have fn_pullback_mono :
      ∀ {W₁ W₂ : Set (ℂ × ℂ)} (G : MeroOn2D W₁) (F : MeroOn2D W₂)
        (Υ : ℂ × ℂ → ℂ × ℂ) {U V : Set (ℂ × ℂ)},
        V ⊆ U → MeroEqOnPullback G F Υ U → MeroEqOnPullback G F Υ V := by
    intro W₁ W₂ G F Υ U V hVU hPb
    exact ⟨Set.Subset.trans hVU hPb.1, hPb.2.1.mono_left hVU, fun p hp => hPb.2.2 p (hVU hp)⟩

  have fn_eqOn_pullback_left :
      ∀ {W₁ W₁' W₂ : Set (ℂ × ℂ)}
        (G₁ : MeroOn2D W₁) (G₂ : MeroOn2D W₁') (F : MeroOn2D W₂)
        (Υ : ℂ × ℂ → ℂ × ℂ) (U : Set (ℂ × ℂ)),
        IsTriangularHoloMap U Υ →
        MeroEqOn G₁ G₂ U → MeroEqOnPullback G₂ F Υ U → MeroEqOnPullback G₁ F Υ U := by
    intro W₁ W₁' W₂ G₁ G₂ F Υ U hTri hEq hPb
    have hΥ_holo : DifferentiableOn ℂ Υ U := triangular_holo hTri
    refine ⟨fun p hp => (hEq.1 hp).1, hPb.2.1, fun p hp => ?_⟩
    have hpW₁ : p ∈ W₁ := (hEq.1 hp).1
    have hpW₁' : p ∈ W₁' := (hEq.1 hp).2
    have hΥp_W₂ : Υ p ∈ W₂ := hPb.2.1 hp
    obtain ⟨r₂, hr₂_pos, _, hr₂_maps, hr₂_eq⟩ := hPb.2.2 p hp
    obtain ⟨r_U, hr_U_pos, hr_U_sub⟩ := Metric.isOpen_iff.mp hTri.1 p hp
    let r : ℝ := min (min (G₁.rad p) (G₂.rad p)) (min r₂ r_U)
    have hr_pos : 0 < r :=
      lt_min (lt_min (G₁.rad_pos p hpW₁) (G₂.rad_pos p hpW₁')) (lt_min hr₂_pos hr_U_pos)
    have hr_le_G₁ : r ≤ G₁.rad p := le_trans (min_le_left _ _) (min_le_left _ _)
    have hr_le_G₂ : r ≤ G₂.rad p := le_trans (min_le_left _ _) (min_le_right _ _)
    have hr_le_r₂ : r ≤ r₂ := le_trans (min_le_right _ _) (min_le_left _ _)
    have hr_sub_U : Metric.ball p r ⊆ U :=
      Set.Subset.trans
        (Metric.ball_subset_ball (le_trans (min_le_right _ _) (min_le_right _ _))) hr_U_sub
    have hr_maps : Set.MapsTo Υ (Metric.ball p r) (Metric.ball (Υ p) (F.rad (Υ p))) :=
      hr₂_maps.mono_left (Metric.ball_subset_ball hr_le_r₂)
    refine ⟨r, hr_pos, hr_le_G₁, hr_maps, ?_⟩
    let Δ : ℂ × ℂ → ℂ :=
      fun q => G₁.num p q * F.den (Υ p) (Υ q) - F.num (Υ p) (Υ q) * G₁.den p q
    have hΔ_holo : DifferentiableOn ℂ Δ (Metric.ball p r) :=
      (((G₁.num_holo p hpW₁).mono (Metric.ball_subset_ball hr_le_G₁)).mul
        ((F.den_holo (Υ p) hΥp_W₂).comp (hΥ_holo.mono hr_sub_U) hr_maps)).sub
      (((F.num_holo (Υ p) hΥp_W₂).comp (hΥ_holo.mono hr_sub_U) hr_maps).mul
        ((G₁.den_holo p hpW₁).mono (Metric.ball_subset_ball hr_le_G₁)))
    have hprod_zero :
        ∀ q ∈ (Metric.ball p r ∩ Metric.ball p r) ∩ Metric.ball p (G₂.rad p),
          Δ q * G₂.den p q = 0 := by
      rintro q ⟨⟨hq, _⟩, _⟩
      have e₁₂ := hEq.2 p hp q (Metric.ball_subset_ball (min_le_left _ _) hq)
      have e₂F := hr₂_eq q (Metric.ball_subset_ball hr_le_r₂ hq)
      dsimp [Δ]
      linear_combination F.den (Υ p) (Υ q) * e₁₂ + G₁.den p q * e₂F
    intro q hq
    exact sub_eq_zero.mp (cancel_holo_of_convex_2D
      Metric.isOpen_ball (convex_ball p r) hΔ_holo
      Metric.isOpen_ball (convex_ball p (G₂.rad p))
      (G₂.den_holo p hpW₁') (G₂.den_ne_zero p hpW₁')
      Metric.isOpen_ball
      ⟨p, ⟨Metric.mem_ball_self hr_pos, Metric.mem_ball_self hr_pos⟩,
        Metric.mem_ball_self (G₂.rad_pos p hpW₁')⟩
      hprod_zero q hq)

  have fn_pullback_exists :
      ∀ {W₁ W₂ : Set (ℂ × ℂ)} (Υ : ℂ × ℂ → ℂ × ℂ) (F : MeroOn2D W₂),
        IsTriangularHoloMap W₁ Υ → Set.MapsTo Υ W₁ W₂ →
        ∃ G : MeroOn2D W₁, MeroEqOnPullback G F Υ W₁ := by
    classical
    intro W₁ W₂ Υ F hTri hMaps
    have hW₁_open : IsOpen W₁ := hTri.1
    have hΥ_holo : DifferentiableOn ℂ Υ W₁ := triangular_holo hTri
    have h_nhds_pb : ∀ p ∈ W₁,
        ∃ r : ℝ, 0 < r ∧ Metric.ball p r ⊆ W₁ ∩ Υ ⁻¹' Metric.ball (Υ p) (F.rad (Υ p)) := by
      intro p hp
      have hcont : ContinuousAt Υ p := hΥ_holo.continuousOn.continuousAt (hW₁_open.mem_nhds hp)
      have h_mem : W₁ ∩ Υ ⁻¹' Metric.ball (Υ p) (F.rad (Υ p)) ∈ nhds p :=
        Filter.inter_mem (hW₁_open.mem_nhds hp)
          (hcont.preimage_mem_nhds (Metric.ball_mem_nhds (Υ p) (F.rad_pos (Υ p) (hMaps hp))))
      exact Metric.mem_nhds_iff.mp h_mem
    let r_pb : ∀ p ∈ W₁, ℝ := fun p hp => Classical.choose (h_nhds_pb p hp)
    have hr_pb : ∀ p (hp : p ∈ W₁),
        0 < r_pb p hp ∧
          Metric.ball p (r_pb p hp) ⊆ W₁ ∩ Υ ⁻¹' Metric.ball (Υ p) (F.rad (Υ p)) :=
      fun p hp => Classical.choose_spec (h_nhds_pb p hp)
    let G : MeroOn2D W₁ := {
      rad := fun p => if hp : p ∈ W₁ then r_pb p hp else 1
      num := fun p q => F.num (Υ p) (Υ q)
      den := fun p q => F.den (Υ p) (Υ q)
      rad_pos := fun p hp => by
        simp only [hp, ↓reduceDIte]
        exact (hr_pb p hp).1
      ball_sub := fun p hp => by
        simp only [hp, ↓reduceDIte]
        exact fun q hq => ((hr_pb p hp).2 hq).1
      num_holo := fun p hp => by
        simp only [hp, ↓reduceDIte]
        exact (F.num_holo (Υ p) (hMaps hp)).comp
          (hΥ_holo.mono (fun q hq => ((hr_pb p hp).2 hq).1))
          (fun q hq => ((hr_pb p hp).2 hq).2)
      den_holo := fun p hp => by
        simp only [hp, ↓reduceDIte]
        exact (F.den_holo (Υ p) (hMaps hp)).comp
          (hΥ_holo.mono (fun q hq => ((hr_pb p hp).2 hq).1))
          (fun q hq => ((hr_pb p hp).2 hq).2)
      den_ne_zero := fun p hp => by
        simp only [hp, ↓reduceDIte]
        exact triangular_pullback_ne_zero hTri hp (hr_pb p hp).1
          (fun q hq => ((hr_pb p hp).2 hq).1)
          (F.den_holo (Υ p) (hMaps hp)) (F.den_ne_zero (Υ p) (hMaps hp))
          (fun q hq => ((hr_pb p hp).2 hq).2)
      compat := fun p₁ hp₁ p₂ hp₂ q hq => by
        simp only [hp₁, hp₂, ↓reduceDIte] at hq
        exact F.compat (Υ p₁) (hMaps hp₁) (Υ p₂) (hMaps hp₂) (Υ q)
          ⟨((hr_pb p₁ hp₁).2 hq.1).2, ((hr_pb p₂ hp₂).2 hq.2).2⟩
    }
    refine ⟨G, Set.Subset.rfl, hMaps, fun p hp => ?_⟩
    refine ⟨r_pb p hp, (hr_pb p hp).1, ?_, fun q hq => ((hr_pb p hp).2 hq).2, fun _ _ => rfl⟩
    simp only [G, hp, ↓reduceDIte, le_rfl]

  have fn_pullback_right_eqOn :
      ∀ {W₁ W₂ W₂' : Set (ℂ × ℂ)}
        (G : MeroOn2D W₁) (F₁ : MeroOn2D W₂) (F₂ : MeroOn2D W₂')
        (Υ : ℂ × ℂ → ℂ × ℂ) (U V₂ : Set (ℂ × ℂ)),
        IsTriangularHoloMap U Υ → Set.MapsTo Υ U V₂ →
        MeroEqOnPullback G F₁ Υ U → MeroEqOn F₁ F₂ V₂ → MeroEqOnPullback G F₂ Υ U := by
    intro W₁ W₂ W₂' G F₁ F₂ Υ U V₂ hTri hMapsV₂ hPb hEq
    have hU_open : IsOpen U := hTri.1
    have hΥ_holo : DifferentiableOn ℂ Υ U := triangular_holo hTri
    refine ⟨hPb.1, fun p hp => (hEq.1 (hMapsV₂ hp)).2, fun p hp => ?_⟩
    have hpW₁ : p ∈ W₁ := hPb.1 hp
    have hΥp_V₂ : Υ p ∈ V₂ := hMapsV₂ hp
    have hΥp_W₂ : Υ p ∈ W₂ := (hEq.1 hΥp_V₂).1
    have hΥp_W₂' : Υ p ∈ W₂' := (hEq.1 hΥp_V₂).2
    obtain ⟨r₁, hr₁_pos, hr₁_le, hr₁_maps, hr₁_eq⟩ := hPb.2.2 p hp
    let R₂ : ℝ := min (F₁.rad (Υ p)) (F₂.rad (Υ p))
    have hR₂_pos : 0 < R₂ := lt_min (F₁.rad_pos (Υ p) hΥp_W₂) (F₂.rad_pos (Υ p) hΥp_W₂')
    have hcont : ContinuousAt Υ p := hΥ_holo.continuousOn.continuousAt (hU_open.mem_nhds hp)
    have h_nhds : U ∩ Υ ⁻¹' Metric.ball (Υ p) R₂ ∈ nhds p :=
      Filter.inter_mem (hU_open.mem_nhds hp)
        (hcont.preimage_mem_nhds (Metric.ball_mem_nhds (Υ p) hR₂_pos))
    obtain ⟨r₀, hr₀_pos, hr₀_sub⟩ := Metric.mem_nhds_iff.mp h_nhds
    let r : ℝ := min r₁ r₀
    have hr_pos : 0 < r := lt_min hr₁_pos hr₀_pos
    have hr_le_G : r ≤ G.rad p := le_trans (min_le_left _ _) hr₁_le
    have hr_sub_U : Metric.ball p r ⊆ U :=
      fun q hq => (hr₀_sub (Metric.ball_subset_ball (min_le_right _ _) hq)).1
    have hr_maps_R₂ : Set.MapsTo Υ (Metric.ball p r) (Metric.ball (Υ p) R₂) :=
      fun q hq => (hr₀_sub (Metric.ball_subset_ball (min_le_right _ _) hq)).2
    have hr_maps_F₂ : Set.MapsTo Υ (Metric.ball p r) (Metric.ball (Υ p) (F₂.rad (Υ p))) :=
      hr_maps_R₂.mono_right (Metric.ball_subset_ball (min_le_right _ _))
    have hr_maps_F₁ : Set.MapsTo Υ (Metric.ball p r) (Metric.ball (Υ p) (F₁.rad (Υ p))) :=
      hr₁_maps.mono_left (Metric.ball_subset_ball (min_le_left _ _))
    refine ⟨r, hr_pos, hr_le_G, hr_maps_F₂, ?_⟩
    let Δ : ℂ × ℂ → ℂ :=
      fun q => G.num p q * F₂.den (Υ p) (Υ q) - F₂.num (Υ p) (Υ q) * G.den p q
    have hΔ_holo : DifferentiableOn ℂ Δ (Metric.ball p r) :=
      (((G.num_holo p hpW₁).mono (Metric.ball_subset_ball hr_le_G)).mul
        ((F₂.den_holo (Υ p) hΥp_W₂').comp (hΥ_holo.mono hr_sub_U) hr_maps_F₂)).sub
      (((F₂.num_holo (Υ p) hΥp_W₂').comp (hΥ_holo.mono hr_sub_U) hr_maps_F₂).mul
        ((G.den_holo p hpW₁).mono (Metric.ball_subset_ball hr_le_G)))
    have hprod_zero : ∀ q ∈ Metric.ball p r, Δ q * F₁.den (Υ p) (Υ q) = 0 := by
      intro q hq
      have e_G1 := hr₁_eq q (Metric.ball_subset_ball (min_le_left _ _) hq)
      have e_12 := hEq.2 (Υ p) hΥp_V₂ (Υ q) (hr_maps_R₂ hq)
      dsimp [Δ]
      linear_combination F₂.den (Υ p) (Υ q) * e_G1 + G.den p q * e_12
    intro q hq
    exact sub_eq_zero.mp (cancel_pullback_ball_2D hTri hp hr_pos le_rfl hr_sub_U
      hΔ_holo (F₁.den_holo (Υ p) hΥp_W₂) (F₁.den_ne_zero (Υ p) hΥp_W₂)
      hr_maps_F₁ hprod_zero q hq)

  have fn_pullback_comp :
      ∀ {W₁ W₂ W₃ : Set (ℂ × ℂ)}
        (G₁ : MeroOn2D W₁) (G₂ : MeroOn2D W₂) (F : MeroOn2D W₃)
        (Υ₁ Υ₂ : ℂ × ℂ → ℂ × ℂ) (U₁ U₂ : Set (ℂ × ℂ)),
        IsTriangularHoloMap U₁ Υ₁ → IsTriangularHoloMap U₂ Υ₂ →
        Set.MapsTo Υ₁ U₁ U₂ →
        MeroEqOnPullback G₁ G₂ Υ₁ U₁ → MeroEqOnPullback G₂ F Υ₂ U₂ →
        MeroEqOnPullback G₁ F (Υ₂ ∘ Υ₁) U₁ := by
    intro W₁ W₂ W₃ G₁ G₂ F Υ₁ Υ₂ U₁ U₂ hTri₁ hTri₂ hMaps₁₂ hPb₁ hPb₂
    have hU₁_open : IsOpen U₁ := hTri₁.1
    have hU₂_open : IsOpen U₂ := hTri₂.1
    have hΥ₁_holo : DifferentiableOn ℂ Υ₁ U₁ := triangular_holo hTri₁
    have hΥ₂_holo : DifferentiableOn ℂ Υ₂ U₂ := triangular_holo hTri₂
    refine ⟨hPb₁.1, hPb₂.2.1.comp hMaps₁₂, fun p hp => ?_⟩
    have hpW₁ : p ∈ W₁ := hPb₁.1 hp
    have hΥ₁p_U₂ : Υ₁ p ∈ U₂ := hMaps₁₂ hp
    have hΥ₁p_W₂ : Υ₁ p ∈ W₂ := hPb₁.2.1 hp
    have hΥ₂₁p_W₃ : Υ₂ (Υ₁ p) ∈ W₃ := hPb₂.2.1 hΥ₁p_U₂
    obtain ⟨r₁, hr₁_pos, hr₁_le, hr₁_maps, hr₁_eq⟩ := hPb₁.2.2 p hp
    obtain ⟨r₂, hr₂_pos, _, hr₂_maps, hr₂_eq⟩ := hPb₂.2.2 (Υ₁ p) hΥ₁p_U₂
    have hcont₁ : ContinuousAt Υ₁ p := hΥ₁_holo.continuousOn.continuousAt (hU₁_open.mem_nhds hp)
    have h_nhds :
        U₁ ∩ Υ₁ ⁻¹' (U₂ ∩ Metric.ball (Υ₁ p) r₂) ∈ nhds p :=
      Filter.inter_mem (hU₁_open.mem_nhds hp)
        (hcont₁.preimage_mem_nhds
          ((hU₂_open.inter Metric.isOpen_ball).mem_nhds
            ⟨hΥ₁p_U₂, Metric.mem_ball_self hr₂_pos⟩))
    obtain ⟨r₀, hr₀_pos, hr₀_sub⟩ := Metric.mem_nhds_iff.mp h_nhds
    let r : ℝ := min r₁ r₀
    have hr_pos : 0 < r := lt_min hr₁_pos hr₀_pos
    have hr_le_G₁ : r ≤ G₁.rad p := le_trans (min_le_left _ _) hr₁_le
    have hr_sub_U₁ : Metric.ball p r ⊆ U₁ :=
      fun q hq => (hr₀_sub (Metric.ball_subset_ball (min_le_right _ _) hq)).1
    have hr_maps_U₂ : Set.MapsTo Υ₁ (Metric.ball p r) U₂ :=
      fun q hq => (hr₀_sub (Metric.ball_subset_ball (min_le_right _ _) hq)).2.1
    have hr_maps_r₂ : Set.MapsTo Υ₁ (Metric.ball p r) (Metric.ball (Υ₁ p) r₂) :=
      fun q hq => (hr₀_sub (Metric.ball_subset_ball (min_le_right _ _) hq)).2.2
    have hr_maps_comp :
        Set.MapsTo (Υ₂ ∘ Υ₁) (Metric.ball p r)
          (Metric.ball (Υ₂ (Υ₁ p)) (F.rad (Υ₂ (Υ₁ p)))) :=
      hr₂_maps.comp hr_maps_r₂
    have hr_maps_G₂ :
        Set.MapsTo Υ₁ (Metric.ball p r) (Metric.ball (Υ₁ p) (G₂.rad (Υ₁ p))) :=
      hr₁_maps.mono_left (Metric.ball_subset_ball (min_le_left _ _))
    refine ⟨r, hr_pos, hr_le_G₁, hr_maps_comp, ?_⟩
    have hcomp_holo : DifferentiableOn ℂ (Υ₂ ∘ Υ₁) (Metric.ball p r) :=
      hΥ₂_holo.comp (hΥ₁_holo.mono hr_sub_U₁) hr_maps_U₂
    let Δ : ℂ × ℂ → ℂ :=
      fun q =>
        G₁.num p q * F.den (Υ₂ (Υ₁ p)) (Υ₂ (Υ₁ q)) -
          F.num (Υ₂ (Υ₁ p)) (Υ₂ (Υ₁ q)) * G₁.den p q
    have hΔ_holo : DifferentiableOn ℂ Δ (Metric.ball p r) :=
      (((G₁.num_holo p hpW₁).mono (Metric.ball_subset_ball hr_le_G₁)).mul
        ((F.den_holo (Υ₂ (Υ₁ p)) hΥ₂₁p_W₃).comp hcomp_holo hr_maps_comp)).sub
      (((F.num_holo (Υ₂ (Υ₁ p)) hΥ₂₁p_W₃).comp hcomp_holo hr_maps_comp).mul
        ((G₁.den_holo p hpW₁).mono (Metric.ball_subset_ball hr_le_G₁)))
    have hprod_zero : ∀ q ∈ Metric.ball p r, Δ q * G₂.den (Υ₁ p) (Υ₁ q) = 0 := by
      intro q hq
      have e₁ := hr₁_eq q (Metric.ball_subset_ball (min_le_left _ _) hq)
      have e₂ := hr₂_eq (Υ₁ q) (hr_maps_r₂ hq)
      dsimp [Δ]
      linear_combination F.den (Υ₂ (Υ₁ p)) (Υ₂ (Υ₁ q)) * e₁ + G₁.den p q * e₂
    intro q hq
    exact sub_eq_zero.mp (cancel_pullback_ball_2D hTri₁ hp hr_pos le_rfl hr_sub_U₁
      hΔ_holo (G₂.den_holo (Υ₁ p) hΥ₁p_W₂) (G₂.den_ne_zero (Υ₁ p) hΥ₁p_W₂)
      hr_maps_G₂ hprod_zero q hq)

  have fn_pullback_congr_eqOn :
      ∀ {W₁ W₁' W₂ W₂' : Set (ℂ × ℂ)}
        (G₁ : MeroOn2D W₁) (G₂ : MeroOn2D W₁') (F₁ : MeroOn2D W₂) (F₂ : MeroOn2D W₂')
        (Υ₁ Υ₂ : ℂ × ℂ → ℂ × ℂ) (U V₂ : Set (ℂ × ℂ)),
        IsTriangularHoloMap U Υ₁ → (∀ p ∈ U, Υ₁ p = Υ₂ p) → Set.MapsTo Υ₁ U V₂ →
        MeroEqOnPullback G₁ F₁ Υ₁ U → MeroEqOnPullback G₂ F₂ Υ₂ U →
        MeroEqOn F₁ F₂ V₂ → MeroEqOn G₁ G₂ U := by
    intro W₁ W₁' W₂ W₂' G₁ G₂ F₁ F₂ Υ₁ Υ₂ U V₂ hTri₁ hCongr hMapsV₂ hPb₁ hPb₂ hEqF
    have hPb₁' : MeroEqOnPullback G₁ F₂ Υ₁ U :=
      fn_pullback_right_eqOn G₁ F₁ F₂ Υ₁ U V₂ hTri₁ hMapsV₂ hPb₁ hEqF
    refine ⟨fun p hp => ⟨hPb₁.1 hp, hPb₂.1 hp⟩, fun p hp => ?_⟩
    have hpW₁ : p ∈ W₁ := hPb₁.1 hp
    have hpW₁' : p ∈ W₁' := hPb₂.1 hp
    have hΥ₁p_W₂' : Υ₁ p ∈ W₂' := hPb₁'.2.1 hp
    let R : ℝ := min (G₁.rad p) (G₂.rad p)
    have hR_pos : 0 < R := lt_min (G₁.rad_pos p hpW₁) (G₂.rad_pos p hpW₁')
    obtain ⟨r₁, hr₁_pos, _, hr₁_maps, hr₁_eq⟩ := hPb₁'.2.2 p hp
    obtain ⟨r₂, hr₂_pos, _, _, hr₂_eq⟩ := hPb₂.2.2 p hp
    obtain ⟨r_U, hr_U_pos, hr_U_sub⟩ := Metric.isOpen_iff.mp hTri₁.1 p hp
    let r : ℝ := min R (min r₁ (min r₂ r_U))
    have hr_pos : 0 < r :=
      lt_min hR_pos (lt_min hr₁_pos (lt_min hr₂_pos hr_U_pos))
    have hr_le_R : r ≤ R := min_le_left _ _
    have hr_le_r₁ : r ≤ r₁ := le_trans (min_le_right _ _) (min_le_left _ _)
    have hr_le_r₂ : r ≤ r₂ :=
      le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_left _ _))
    have hr_sub_U : Metric.ball p r ⊆ U :=
      Set.Subset.trans
        (Metric.ball_subset_ball
          (le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_right _ _))))
        hr_U_sub
    have hr_maps_F₂ :
        Set.MapsTo Υ₁ (Metric.ball p r) (Metric.ball (Υ₁ p) (F₂.rad (Υ₁ p))) :=
      hr₁_maps.mono_left (Metric.ball_subset_ball hr_le_r₁)
    let Δ : ℂ × ℂ → ℂ := fun q => G₁.num p q * G₂.den p q - G₂.num p q * G₁.den p q
    have hΔ_holo : DifferentiableOn ℂ Δ (Metric.ball p R) :=
      (((G₁.num_holo p hpW₁).mono (Metric.ball_subset_ball (min_le_left _ _))).mul
        ((G₂.den_holo p hpW₁').mono (Metric.ball_subset_ball (min_le_right _ _)))).sub
      (((G₂.num_holo p hpW₁').mono (Metric.ball_subset_ball (min_le_right _ _))).mul
        ((G₁.den_holo p hpW₁).mono (Metric.ball_subset_ball (min_le_left _ _))))
    have hprod_zero : ∀ q ∈ Metric.ball p r, Δ q * F₂.den (Υ₁ p) (Υ₁ q) = 0 := by
      intro q hq
      have e₁ := hr₁_eq q (Metric.ball_subset_ball hr_le_r₁ hq)
      have e₂_raw := hr₂_eq q (Metric.ball_subset_ball hr_le_r₂ hq)
      rw [← hCongr p hp, ← hCongr q (hr_sub_U hq)] at e₂_raw
      dsimp [Δ]
      linear_combination G₂.den p q * e₁ - G₁.den p q * e₂_raw
    intro q hq
    exact sub_eq_zero.mp (cancel_pullback_ball_2D hTri₁ hp hr_pos hr_le_R hr_sub_U
      hΔ_holo (F₂.den_holo (Υ₁ p) hΥ₁p_W₂') (F₂.den_ne_zero (Υ₁ p) hΥ₁p_W₂')
      hr_maps_F₂ hprod_zero q hq)

  exact {
    ofHolo := fn_ofHolo
    eqOn_symm := fn_eqOn_symm
    eqOn_mono := fn_eqOn_mono
    eqOn_trans := fn_eqOn_trans
    eqOn_of_isPreconnected := fn_eqOn_of_isPreconnected
    restrictOpen := fn_restrictOpen
    glueCover := fn_glueCover
    glueBinary := fn_glueBinary
    triangular_mono := fn_triangular_mono
    eqOn_iff_pullback_id := fn_eqOn_iff_pullback_id
    pullback_mono := fn_pullback_mono
    eqOn_pullback_left := fn_eqOn_pullback_left
    pullback_exists := fn_pullback_exists
    pullback_right_eqOn := fn_pullback_right_eqOn
    pullback_comp := fn_pullback_comp
    pullback_congr_eqOn := fn_pullback_congr_eqOn
  }

theorem multi_slab_disk_continuation_ascent (hKit : Mero2DPullbackGluingToolkit)
    (hDisk : MeroDiskContinuationProp)
    (s_base r_base R_Φ d_w d_ζ δ_t : ℝ)
    (hs : 0 < s_base)
    (hd_w : 0 < d_w) (hd_w_lt : d_w < s_base)
    (hd_ζ : 0 < d_ζ) (hd_ζ_lt_one : d_ζ < 1) (hd_ζ_lt_R : 1 + d_ζ < R_Φ)
    (hδ_t : 0 < δ_t)
    (F_init : Fin 2 → ℂ × ℂ → ℂ)
    (hF_holo : ∀ i : Fin 2,
      DifferentiableOn ℂ (F_init i)
        { p : ℂ × ℂ | |p.1.im| < 2 * s_base ∧ ‖p.2‖ < r_base })
    (W_tube : Set (ℂ × ℂ))
    (M_F : Fin 2 → MeroOn2D W_tube)
    (hM_agrees : ∀ i : Fin 2,
      MeroAgreesHolo (M_F i) (F_init i)
        { p : ℂ × ℂ | |p.1.im| < 2 * s_base ∧ ‖p.2‖ < r_base })
    (Φ ψ g : ℂ → ℂ)
    (hΦ_holo : DifferentiableOn ℂ Φ (Metric.ball (0 : ℂ) R_Φ))
    (hΦ_maps : ∀ ζ ∈ Metric.ball (0 : ℂ) R_Φ, Φ ζ ∈ Metric.ball (0 : ℂ) r_base)
    (hΦ_deriv : deriv Φ 0 ≠ 0)
    (hg_holo : Differentiable ℂ g)
    (hg0_gt : 2 * s_base < (g 0).im)
    (hAnn_maps : ∀ (x₀ lam : ℝ), 0 ≤ lam → lam ≤ 1 →
      ∀ w ∈ Metric.ball (0 : ℂ) d_w,
      ∀ ζ : ℂ, 1 - d_ζ < ‖ζ‖ → ‖ζ‖ < 1 + d_ζ →
        ((x₀ : ℂ) + (lam : ℂ) * g ζ + w, Φ ζ) ∈ W_tube)
    (hδ_t_sub : Metric.ball (Φ 0) δ_t ⊆ Metric.ball (0 : ℂ) r_base)
    (hψ_holo : DifferentiableOn ℂ ψ (Metric.ball (Φ 0) δ_t))
    (hψ_deriv : deriv ψ (Φ 0) ≠ 0)
    (hψ_props : ∀ t' ∈ Metric.ball (Φ 0) δ_t,
      ψ t' ∈ Metric.ball (0 : ℂ) (1 + d_ζ) ∧
      Φ (ψ t') = t' ∧
      ‖g (ψ t') - g 0‖ < d_w / 4) :
    IsCollarHeightWitness s_base r_base F_init (Φ 0) ((g 0).im + (3 / 4 : ℝ) * d_w) :=
by
  let _ := hs
  
  let a₀ : ℝ := (g 0).im
  have ha₀_pos : 0 < a₀ := by linarith
  let B_w : Set ℂ := Metric.ball (0 : ℂ) d_w
  let B_w2 : Set ℂ := Metric.ball (0 : ℂ) (d_w / 2)
  let D_ζ : Set ℂ := Metric.ball (0 : ℂ) (1 + d_ζ)
  let C_ζ : Set ℂ := Metric.closedBall (0 : ℂ) (1 + d_ζ)
  let A_ζ : Set ℂ := { ζ : ℂ | 1 - d_ζ < ‖ζ‖ ∧ ‖ζ‖ < 1 + d_ζ }
  let B_t : Set ℂ := Metric.ball (Φ 0) δ_t
  let U_base2 : Set (ℂ × ℂ) := { p : ℂ × ℂ | |p.1.im| < 2 * s_base ∧ ‖p.2‖ < r_base }

  have h0_mem_Dζ : (0 : ℂ) ∈ D_ζ := Metric.mem_ball_self (by linarith)
  have h0_mem_Cζ : (0 : ℂ) ∈ C_ζ := Metric.ball_subset_closedBall h0_mem_Dζ
  have h0_mem_RΦ : (0 : ℂ) ∈ Metric.ball (0 : ℂ) R_Φ := Metric.mem_ball_self (by linarith)
  have hDζ_sub_RΦ : D_ζ ⊆ Metric.ball (0 : ℂ) R_Φ := Metric.ball_subset_ball (le_of_lt hd_ζ_lt_R)
  have hAζ_sub_Dζ : A_ζ ⊆ D_ζ := fun ζ hζ => by
    rw [Metric.mem_ball, dist_zero_right]
    exact hζ.2
  have hBw2_sub_Bw : B_w2 ⊆ B_w := Metric.ball_subset_ball (by linarith)

  obtain ⟨ζ_max, _, hζ_max⟩ :=
    (isCompact_closedBall (0 : ℂ) (1 + d_ζ)).exists_isMaxOn ⟨0, h0_mem_Cζ⟩
      (continuous_norm.comp hg_holo.continuous).continuousOn
  let M_g : ℝ := ‖g ζ_max‖
  have hg_le : ∀ ζ ∈ C_ζ, ‖g ζ‖ ≤ M_g := isMaxOn_iff.mp hζ_max
  have hg0_le : a₀ ≤ M_g :=
    le_trans (le_trans (le_abs_self a₀) (Complex.abs_im_le_norm (g 0))) (hg_le 0 h0_mem_Cζ)
  have hMg_pos : 0 < M_g := lt_of_lt_of_le ha₀_pos hg0_le

  obtain ⟨K, hK_gt⟩ := exists_nat_gt (2 * M_g / d_w)
  have hK_real_pos : 0 < (K : ℝ) := lt_trans (div_pos (by linarith) hd_w) hK_gt
  have hK_ne : (K : ℝ) ≠ 0 := ne_of_gt hK_real_pos
  have hK_pos : 1 ≤ K := by
    have : 0 < K := Nat.cast_pos.mp hK_real_pos
    omega
  let Δ : ℝ := 1 / (K : ℝ)
  have hΔ_pos : 0 < Δ := one_div_pos.mpr hK_real_pos
  have hMg_step : Δ * M_g < d_w / 2 := by
    have h1 : 2 * M_g < (K : ℝ) * d_w := (div_lt_iff₀ hd_w).mp hK_gt
    have h2 : Δ * (2 * M_g) < Δ * ((K : ℝ) * d_w) := mul_lt_mul_of_pos_left h1 hΔ_pos
    have h3 : Δ * ((K : ℝ) * d_w) = d_w := by
      calc Δ * ((K : ℝ) * d_w) = (Δ * (K : ℝ)) * d_w := by ring
        _ = 1 * d_w := by rw [one_div_mul_cancel hK_ne]
        _ = d_w := one_mul d_w
    have h4 : Δ * (2 * M_g) = 2 * (Δ * M_g) := by ring
    linarith
  have hStep_lt : ∀ ζ ∈ D_ζ, ‖(Δ : ℂ) * g ζ‖ < d_w / 2 := by
    intro ζ hζ
    rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg (le_of_lt hΔ_pos)]
    exact lt_of_le_of_lt
      (mul_le_mul_of_nonneg_left (hg_le ζ (Metric.ball_subset_closedBall hζ)) (le_of_lt hΔ_pos))
      hMg_step
  have hstep_a₀ : Δ * a₀ < d_w / 2 :=
    lt_of_le_of_lt (mul_le_mul_of_nonneg_left hg0_le (le_of_lt hΔ_pos)) hMg_step
  have hstep_a₀_pos : 0 < Δ * a₀ := mul_pos hΔ_pos ha₀_pos

  
  let Ψ : ℝ → ℝ → ℂ × ℂ → ℂ × ℂ :=
    fun x₀ lam p => (p.1 + ((x₀ : ℂ) + (lam : ℂ) * g p.2), Φ p.2)
  let S_shift : ℝ → ℂ × ℂ → ℂ × ℂ :=
    fun c p => (p.1 + (c : ℂ) * g p.2, p.2)
  let T_horiz : ℝ → ℂ × ℂ → ℂ × ℂ :=
    fun c p => (p.1 + (c : ℂ), p.2)
  let Ω_map : ℝ → ℝ → ℂ × ℂ → ℂ × ℂ :=
    fun x₀ lam p => (p.1 - (x₀ : ℂ) - (lam : ℂ) * g (ψ p.2), ψ p.2)
  let U_chart : ℝ → ℝ → Set (ℂ × ℂ) :=
    fun x₀ lam => { p : ℂ × ℂ | p.2 ∈ B_t ∧ ‖p.1 - (x₀ : ℂ) - (lam : ℂ) * g (ψ p.2)‖ < d_w }
  let Hslab_slab : ℝ → Set (ℂ × ℂ) :=
    fun c => { y : ℂ | |y.im - c| < (3 / 4 : ℝ) * d_w } ×ˢ B_t
  let V_mid : ℝ → Set (ℂ × ℂ) :=
    fun c => { y : ℂ | |y.im - c| < (1 / 4 : ℝ) * d_w } ×ˢ B_t

  have meroEqOn_refl : ∀ {W : Set (ℂ × ℂ)} (F : MeroOn2D W) {U : Set (ℂ × ℂ)},
      U ⊆ W → MeroEqOn F F U := by
    intro W F U hU
    exact ⟨Set.subset_inter hU hU, fun _ _ _ _ => rfl⟩

  have meroEqOn_of_cover : ∀ {W₁ W₂ : Set (ℂ × ℂ)} (F₁ : MeroOn2D W₁) (F₂ : MeroOn2D W₂)
      {ι : Type} {V : ι → Set (ℂ × ℂ)} {U : Set (ℂ × ℂ)},
      (∀ p ∈ U, ∃ α, p ∈ V α) → (∀ α, MeroEqOn F₁ F₂ (V α)) → MeroEqOn F₁ F₂ U := by
    intro W₁ W₂ F₁ F₂ ι V U hcov hEq
    refine ⟨fun p hp => ?_, fun p hp q hq => ?_⟩
    · obtain ⟨α, hpα⟩ := hcov p hp
      exact (hEq α).1 hpα
    · obtain ⟨α, hpα⟩ := hcov p hp
      exact (hEq α).2 p hpα q hq

  have hOpen_Aζ : IsOpen A_ζ :=
    (isOpen_lt continuous_const continuous_norm).inter (isOpen_lt continuous_norm continuous_const)
  have h1_mem_Aζ : (1 : ℂ) ∈ A_ζ := by
    show 1 - d_ζ < ‖(1 : ℂ)‖ ∧ ‖(1 : ℂ)‖ < 1 + d_ζ
    rw [norm_one]
    exact ⟨by linarith, by linarith⟩
  have hOpen_base2 : IsOpen U_base2 :=
    (isOpen_lt (continuous_abs.comp (Complex.continuous_im.comp continuous_fst))
      continuous_const).inter
      (isOpen_lt (continuous_norm.comp continuous_snd) continuous_const)
  have hOpen_Hslab : ∀ c : ℝ, IsOpen (Hslab_slab c) := fun c =>
    (isOpen_lt (continuous_abs.comp (Complex.continuous_im.sub continuous_const))
      continuous_const).prod Metric.isOpen_ball
  have hOpen_Vmid : ∀ c : ℝ, IsOpen (V_mid c) := fun c =>
    (isOpen_lt (continuous_abs.comp (Complex.continuous_im.sub continuous_const))
      continuous_const).prod Metric.isOpen_ball

  have hOpen_chart_r : ∀ (x₀ lam r : ℝ),
      IsOpen { p : ℂ × ℂ | p.2 ∈ B_t ∧ ‖p.1 - (x₀ : ℂ) - (lam : ℂ) * g (ψ p.2)‖ < r } := by
    intro x₀ lam r
    let f : ℂ × ℂ → ℂ := fun p => p.1 - (x₀ : ℂ) - (lam : ℂ) * g (ψ p.2)
    have hf_cont : ContinuousOn f (Set.univ ×ˢ B_t) := by
      have hψ_comp : ContinuousOn (fun p : ℂ × ℂ => ψ p.2) (Set.univ ×ˢ B_t) :=
        hψ_holo.continuousOn.comp continuousOn_snd (fun _ hp => hp.2)
      have hg_comp : ContinuousOn (fun p : ℂ × ℂ => g (ψ p.2)) (Set.univ ×ˢ B_t) :=
        hg_holo.continuous.comp_continuousOn hψ_comp
      exact (continuousOn_fst.sub continuousOn_const).sub (continuousOn_const.mul hg_comp)
    have hOpen_inter : IsOpen ((Set.univ ×ˢ B_t) ∩ f ⁻¹' Metric.ball (0 : ℂ) r) :=
      hf_cont.isOpen_inter_preimage (isOpen_univ.prod Metric.isOpen_ball) Metric.isOpen_ball
    convert hOpen_inter using 1
    ext p
    simp [f, Metric.mem_ball, dist_zero_right]

  have hTri_Ψ : ∀ {U : Set (ℂ × ℂ)} (x₀ lam : ℝ),
      IsOpen U → (∀ p ∈ U, p.2 ∈ Metric.ball (0 : ℂ) R_Φ) →
      IsTriangularHoloMap U (Ψ x₀ lam) := by
    intro U x₀ lam hU hsub
    refine ⟨hU, Metric.ball (0 : ℂ) R_Φ, fun ζ => (x₀ : ℂ) + (lam : ℂ) * g ζ, Φ,
      Metric.isOpen_ball, (convex_ball (0 : ℂ) R_Φ).isPreconnected,
      fun p hp => ⟨hsub p hp, rfl⟩,
      (differentiableOn_const _).add ((hg_holo.const_mul _).differentiableOn),
      hΦ_holo, 0, h0_mem_RΦ, hΦ_deriv⟩

  have hTri_shift : ∀ {U : Set (ℂ × ℂ)} (c : ℝ),
      IsOpen U → IsTriangularHoloMap U (S_shift c) := by
    intro U c hU
    refine ⟨hU, Set.univ, fun ζ => (c : ℂ) * g ζ, id,
      isOpen_univ, isPreconnected_univ,
      fun p _ => ⟨trivial, rfl⟩,
      (hg_holo.const_mul _).differentiableOn,
      differentiableOn_id, 0, trivial, by simp⟩

  have hTri_horiz : ∀ {U : Set (ℂ × ℂ)} (c : ℝ),
      IsOpen U → IsTriangularHoloMap U (T_horiz c) := by
    intro U c hU
    refine ⟨hU, Set.univ, fun _ => (c : ℂ), id,
      isOpen_univ, isPreconnected_univ,
      fun p _ => ⟨trivial, rfl⟩,
      differentiableOn_const _,
      differentiableOn_id, 0, trivial, by simp⟩

  have hTri_id : ∀ {U : Set (ℂ × ℂ)}, IsOpen U → IsTriangularHoloMap U id := by
    intro U hU
    refine ⟨hU, Set.univ, fun _ => 0, id,
      isOpen_univ, isPreconnected_univ,
      fun p _ => ⟨trivial, Prod.ext (add_zero p.1).symm rfl⟩,
      differentiableOn_const _,
      differentiableOn_id, 0, trivial, by simp⟩

  have hTri_Ω : ∀ {U : Set (ℂ × ℂ)} (x₀ lam : ℝ),
      IsOpen U → (∀ p ∈ U, p.2 ∈ B_t) →
      IsTriangularHoloMap U (Ω_map x₀ lam) := by
    intro U x₀ lam hU hsub
    have hgψ_holo : DifferentiableOn ℂ (fun t' => g (ψ t')) B_t :=
      hg_holo.comp_differentiableOn hψ_holo
    refine ⟨hU, B_t, fun t' => -(x₀ : ℂ) - (lam : ℂ) * g (ψ t'), ψ,
      Metric.isOpen_ball, (convex_ball (Φ 0) δ_t).isPreconnected,
      fun p hp => ⟨hsub p hp, Prod.ext (by simp [Ω_map]; ring) rfl⟩,
      (differentiableOn_const _).sub (hgψ_holo.const_mul _),
      hψ_holo, Φ 0, Metric.mem_ball_self hδ_t, hψ_deriv⟩

  have hCover_helper : ∀ (lam r : ℝ), |lam| ≤ 1 → ∀ p : ℂ × ℂ,
      |p.1.im - lam * a₀| < r → p.2 ∈ B_t →
      ∃ x₀ : ℝ, ‖p.1 - (x₀ : ℂ) - (lam : ℂ) * g (ψ p.2)‖ < r + d_w / 4 := by
    intro lam r hlam p hp_im hp_t
    refine ⟨p.1.re - ((lam : ℂ) * g (ψ p.2)).re, ?_⟩
    set z : ℂ := p.1 - ((p.1.re - ((lam : ℂ) * g (ψ p.2)).re : ℝ) : ℂ) - (lam : ℂ) * g (ψ p.2)
    have hz_re : z.re = 0 := by simp [z]
    have hz_norm : ‖z‖ = |z.im| := (Complex.abs_im_eq_norm.mpr hz_re).symm
    have hz_im : z.im = (p.1.im - lam * a₀) - lam * (g (ψ p.2) - g 0).im := by
      simp [z, a₀]; ring
    have hdiff_lt : ‖g (ψ p.2) - g 0‖ < d_w / 4 := (hψ_props p.2 hp_t).2.2
    have him_le : |(g (ψ p.2) - g 0).im| ≤ ‖g (ψ p.2) - g 0‖ := Complex.abs_im_le_norm _
    have hmul_le : |lam * (g (ψ p.2) - g 0).im| ≤ |(g (ψ p.2) - g 0).im| := by
      rw [abs_mul]
      exact mul_le_of_le_one_left (abs_nonneg _) hlam
    have habs_le : |z.im| ≤ |p.1.im - lam * a₀| + |lam * (g (ψ p.2) - g 0).im| := by
      rw [hz_im]
      exact abs_sub _ _
    rw [hz_norm]
    linarith

  
  let W_final : Set (ℂ × ℂ) :=
    { y : ℂ | -s_base < y.im ∧ y.im < a₀ + (3 / 4 : ℝ) * d_w } ×ˢ B_t
  let W_base : Set (ℂ × ℂ) :=
    { y : ℂ | |y.im| < s_base } ×ˢ B_t

  have hComp : ∀ i : Fin 2,
      ∃ G_i : MeroOn2D W_final, MeroAgreesHolo G_i (F_init i) W_base := by
    intro i
    let f_init := F_init i
    let M := M_F i
    have hf_holo := hF_holo i
    have hM_ag := hM_agrees i
    have hBase_sub : U_base2 ⊆ W_tube := hM_ag.1

    
    have hAscent : ∀ x₀ : ℝ, ∀ n : ℕ, n ≤ K →
        ∃ G : ℕ → MeroOn2D (B_w ×ˢ D_ζ),
          MeroEqOnPullback (G 0) M (Ψ x₀ 0) (B_w ×ˢ D_ζ) ∧
          (∀ k : ℕ, k ≤ n →
            MeroEqOnPullback (G k) M (Ψ x₀ ((k : ℝ) / (K : ℝ))) (B_w ×ˢ A_ζ)) ∧
          (∀ k : ℕ, k < n →
            MeroEqOnPullback (G (k + 1)) (G k) (S_shift Δ) (B_w2 ×ˢ D_ζ)) := by
      intro x₀ n
      induction n with
      | zero =>
        intro _
        have hMaps0 : Set.MapsTo (Ψ x₀ 0) (B_w ×ˢ D_ζ) W_tube := by
          intro p hp
          apply hBase_sub
          refine ⟨?_, ?_⟩
          · have hw : ‖p.1‖ < d_w := by simpa [B_w, Metric.mem_ball, dist_zero_right] using hp.1
            have him : |(p.1 + ((x₀ : ℂ) + ((0 : ℝ) : ℂ) * g p.2)).im| = |p.1.im| := by simp
            rw [him]
            linarith [Complex.abs_im_le_norm p.1]
          · have hΦp : Φ p.2 ∈ Metric.ball (0 : ℂ) r_base := hΦ_maps p.2 (hDζ_sub_RΦ hp.2)
            simpa [Metric.mem_ball, dist_zero_right] using hΦp
        obtain ⟨G₀, hG₀⟩ := hKit.pullback_exists (Ψ x₀ 0) M
          (hTri_Ψ x₀ 0 (Metric.isOpen_ball.prod Metric.isOpen_ball) (fun p hp => hDζ_sub_RΦ hp.2))
          hMaps0
        refine ⟨fun _ => G₀, hG₀, ?_, fun k hk => by omega⟩
        intro k hk
        have hk0 : k = 0 := by omega
        subst hk0
        have h0_div : (((0 : ℕ) : ℝ) / (K : ℝ)) = 0 := by simp
        rw [h0_div]
        exact hKit.pullback_mono G₀ M (Ψ x₀ 0) (Set.prod_mono Subset.rfl hAζ_sub_Dζ) hG₀
      | succ n ih =>
        intro hn1
        obtain ⟨G_prev, hG0, hGann, hGstep⟩ := ih (Nat.le_of_succ_le hn1)
        let lam_n : ℝ := (n : ℝ) / (K : ℝ)
        let lam_n1 : ℝ := ((n + 1 : ℕ) : ℝ) / (K : ℝ)
        have hlam0 : 0 ≤ lam_n1 := div_nonneg (Nat.cast_nonneg _) (le_of_lt hK_real_pos)
        have hlam1 : lam_n1 ≤ 1 := (div_le_one hK_real_pos).mpr (by exact_mod_cast hn1)

        have hMaps_shift : Set.MapsTo (S_shift Δ) (B_w2 ×ˢ D_ζ) (B_w ×ˢ D_ζ) := by
          intro p hp
          refine ⟨?_, hp.2⟩
          rw [Metric.mem_ball, dist_zero_right]
          have hw : ‖p.1‖ < d_w / 2 := by simpa [B_w2, Metric.mem_ball, dist_zero_right] using hp.1
          calc ‖p.1 + (Δ : ℂ) * g p.2‖
              ≤ ‖p.1‖ + ‖(Δ : ℂ) * g p.2‖ := norm_add_le _ _
            _ < d_w / 2 + d_w / 2 := add_lt_add hw (hStep_lt p.2 hp.2)
            _ = d_w := by ring
        obtain ⟨F₀, hF₀⟩ := hKit.pullback_exists (S_shift Δ) (G_prev n)
          (hTri_shift Δ (Metric.isOpen_ball.prod Metric.isOpen_ball)) hMaps_shift

        have hMaps_col : Set.MapsTo (Ψ x₀ lam_n1) (B_w ×ˢ A_ζ) W_tube := by
          intro p hp
          have hcomm : p.1 + ((x₀ : ℂ) + (lam_n1 : ℂ) * g p.2) =
              (x₀ : ℂ) + (lam_n1 : ℂ) * g p.2 + p.1 := by ring
          show (p.1 + ((x₀ : ℂ) + (lam_n1 : ℂ) * g p.2), Φ p.2) ∈ W_tube
          rw [hcomm]
          exact hAnn_maps x₀ lam_n1 hlam0 hlam1 p.1 hp.1 p.2 hp.2.1 hp.2.2
        obtain ⟨F_col, hF_col⟩ := hKit.pullback_exists (Ψ x₀ lam_n1) M
          (hTri_Ψ x₀ lam_n1 (Metric.isOpen_ball.prod hOpen_Aζ)
            (fun p hp => hDζ_sub_RΦ (hAζ_sub_Dζ hp.2)))
          hMaps_col

        have hMaps_shift_A : Set.MapsTo (S_shift Δ) (B_w2 ×ˢ A_ζ) (B_w ×ˢ A_ζ) := by
          intro p hp
          exact ⟨(hMaps_shift ⟨hp.1, hAζ_sub_Dζ hp.2⟩).1, hp.2⟩
        have hF₀_comp : MeroEqOnPullback F₀ M (Ψ x₀ lam_n ∘ S_shift Δ) (B_w2 ×ˢ A_ζ) :=
          hKit.pullback_comp F₀ (G_prev n) M (S_shift Δ) (Ψ x₀ lam_n)
            (B_w2 ×ˢ A_ζ) (B_w ×ˢ A_ζ)
            (hTri_shift Δ (Metric.isOpen_ball.prod hOpen_Aζ))
            (hTri_Ψ x₀ lam_n (Metric.isOpen_ball.prod hOpen_Aζ)
              (fun p hp => hDζ_sub_RΦ (hAζ_sub_Dζ hp.2)))
            hMaps_shift_A
            (hKit.pullback_mono F₀ (G_prev n) (S_shift Δ)
              (Set.prod_mono Subset.rfl hAζ_sub_Dζ) hF₀)
            (hGann n (le_refl n))
        have hF_col_sub : MeroEqOnPullback F_col M (Ψ x₀ lam_n1) (B_w2 ×ˢ A_ζ) :=
          hKit.pullback_mono F_col M (Ψ x₀ lam_n1) (Set.prod_mono hBw2_sub_Bw Subset.rfl) hF_col
        have hΨ_eq : ∀ p ∈ B_w2 ×ˢ A_ζ, Ψ x₀ lam_n1 p = (Ψ x₀ lam_n ∘ S_shift Δ) p := by
          intro p _
          have hlam_add : lam_n1 = lam_n + Δ := by
            simp only [lam_n1, lam_n, Δ]
            push_cast
            ring
          ext
          · simp only [Ψ, S_shift, Function.comp_apply, hlam_add]
            push_cast
            ring
          · rfl
        have hEq_col_0 : MeroEqOn F_col F₀ (B_w2 ×ˢ A_ζ) :=
          hKit.pullback_congr_eqOn F_col F₀ M M (Ψ x₀ lam_n1) (Ψ x₀ lam_n ∘ S_shift Δ)
            (B_w2 ×ˢ A_ζ) W_tube
            (hTri_Ψ x₀ lam_n1 (Metric.isOpen_ball.prod hOpen_Aζ)
              (fun p hp => hDζ_sub_RΦ (hAζ_sub_Dζ hp.2)))
            hΨ_eq hF_col_sub.2.1 hF_col_sub hF₀_comp (meroEqOn_refl M Subset.rfl)

        obtain ⟨G_next, hG_next_col⟩ :=
          hDisk d_w (1 - d_ζ) (1 + d_ζ) 0 (d_w / 2)
            hd_w (by linarith) (by linarith) (half_pos hd_w) hBw2_sub_Bw F_col F₀ hEq_col_0

        have hG_next_ann : MeroEqOnPullback G_next M (Ψ x₀ lam_n1) (B_w ×ˢ A_ζ) :=
          hKit.eqOn_pullback_left G_next F_col M (Ψ x₀ lam_n1) (B_w ×ˢ A_ζ)
            (hTri_Ψ x₀ lam_n1 (Metric.isOpen_ball.prod hOpen_Aζ)
              (fun p hp => hDζ_sub_RΦ (hAζ_sub_Dζ hp.2)))
            hG_next_col hF_col

        have hG_next_F0_A : MeroEqOn G_next F₀ (B_w2 ×ˢ A_ζ) :=
          hKit.eqOn_trans G_next F_col F₀ (B_w2 ×ˢ A_ζ)
            (hKit.eqOn_mono G_next F_col (Set.prod_mono hBw2_sub_Bw Subset.rfl) hG_next_col)
            hEq_col_0
        have hG_next_F0 : MeroEqOn G_next F₀ (B_w2 ×ˢ D_ζ) :=
          hKit.eqOn_of_isPreconnected G_next F₀ (B_w2 ×ˢ D_ζ) (B_w2 ×ˢ A_ζ)
            (Metric.isOpen_ball.prod Metric.isOpen_ball)
            ((convex_ball (0 : ℂ) (d_w / 2)).prod (convex_ball (0 : ℂ) (1 + d_ζ))).isPreconnected
            (Set.subset_inter (Set.prod_mono hBw2_sub_Bw Subset.rfl) Subset.rfl)
            (Metric.isOpen_ball.prod hOpen_Aζ)
            ⟨((0 : ℂ), (1 : ℂ)), Metric.mem_ball_self (half_pos hd_w), h1_mem_Aζ⟩
            (Set.prod_mono Subset.rfl hAζ_sub_Dζ)
            hG_next_F0_A
        have hG_next_step : MeroEqOnPullback G_next (G_prev n) (S_shift Δ) (B_w2 ×ˢ D_ζ) :=
          hKit.eqOn_pullback_left G_next F₀ (G_prev n) (S_shift Δ) (B_w2 ×ˢ D_ζ)
            (hTri_shift Δ (Metric.isOpen_ball.prod Metric.isOpen_ball))
            hG_next_F0 hF₀

        refine ⟨fun k => if k ≤ n then G_prev k else G_next, ?_, ?_, ?_⟩
        · dsimp only
          split_ifs
          · exact hG0
          · omega
        · intro k hk
          dsimp only
          split_ifs with hkn
          · exact hGann k hkn
          · have hkeq : k = n + 1 := by omega
            rw [hkeq]
            exact hG_next_ann
        · intro k hk
          dsimp only
          split_ifs with h1 h2
          · exact hGstep k (by omega)
          · omega
          · have hkeq : k = n := by omega
            rw [hkeq]
            exact hG_next_step
          · omega

    let G_x : ℝ → ℕ → MeroOn2D (B_w ×ˢ D_ζ) :=
      fun x₀ => Classical.choose (hAscent x₀ K (le_refl K))
    have hGx_0 : ∀ x₀ : ℝ, MeroEqOnPullback (G_x x₀ 0) M (Ψ x₀ 0) (B_w ×ˢ D_ζ) :=
      fun x₀ => (Classical.choose_spec (hAscent x₀ K (le_refl K))).1
    have hGx_ann : ∀ (x₀ : ℝ) (k : ℕ), k ≤ K →
        MeroEqOnPullback (G_x x₀ k) M (Ψ x₀ ((k : ℝ) / (K : ℝ))) (B_w ×ˢ A_ζ) :=
      fun x₀ => (Classical.choose_spec (hAscent x₀ K (le_refl K))).2.1
    have hGx_step : ∀ (x₀ : ℝ) (k : ℕ), k < K →
        MeroEqOnPullback (G_x x₀ (k + 1)) (G_x x₀ k) (S_shift Δ) (B_w2 ×ˢ D_ζ) :=
      fun x₀ => (Classical.choose_spec (hAscent x₀ K (le_refl K))).2.2

    
    have hHoriz : ∀ (k : ℕ), k ≤ K →
        ∃ S_k : MeroOn2D (Hslab_slab (((k : ℝ) / (K : ℝ)) * a₀)),
          ∀ x₀ : ℝ, MeroEqOnPullback S_k (G_x x₀ k) (Ω_map x₀ ((k : ℝ) / (K : ℝ)))
            (Hslab_slab (((k : ℝ) / (K : ℝ)) * a₀) ∩ U_chart x₀ ((k : ℝ) / (K : ℝ))) := by
      intro k hk
      let lam : ℝ := (k : ℝ) / (K : ℝ)
      have hlam_nonneg : 0 ≤ lam := div_nonneg (Nat.cast_nonneg _) (le_of_lt hK_real_pos)
      have hlam_le_one : lam ≤ 1 := (div_le_one hK_real_pos).mpr (by exact_mod_cast hk)
      have hlam_abs : |lam| ≤ 1 := by rwa [abs_of_nonneg hlam_nonneg]

      have hChart_pb : ∀ x₀ : ℝ,
          ∃ H : MeroOn2D (U_chart x₀ lam),
            MeroEqOnPullback H (G_x x₀ k) (Ω_map x₀ lam) (U_chart x₀ lam) := by
        intro x₀
        refine hKit.pullback_exists (Ω_map x₀ lam) (G_x x₀ k)
          (hTri_Ω x₀ lam (hOpen_chart_r x₀ lam d_w) (fun _ hp => hp.1)) ?_
        intro p hp
        refine ⟨?_, (hψ_props p.2 hp.1).1⟩
        simpa [B_w, Metric.mem_ball, dist_zero_right] using hp.2
      let H_chart : ∀ x₀ : ℝ, MeroOn2D (U_chart x₀ lam) :=
        fun x₀ => Classical.choose (hChart_pb x₀)
      have hH_chart : ∀ x₀ : ℝ,
          MeroEqOnPullback (H_chart x₀) (G_x x₀ k) (Ω_map x₀ lam) (U_chart x₀ lam) :=
        fun x₀ => Classical.choose_spec (hChart_pb x₀)

      have hCompat : ∀ x₁ x₂ : ℝ,
          MeroEqOn (H_chart x₁) (H_chart x₂) (U_chart x₁ lam ∩ U_chart x₂ lam) := by
        intro x₁ x₂
        let U₁₂ := U_chart x₁ lam ∩ U_chart x₂ lam
        by_cases hne : U₁₂.Nonempty
        · obtain ⟨p_star, hp1, hp2⟩ := hne
          let B₁₂ : Set ℂ := B_w ∩ Metric.ball ((x₂ - x₁ : ℝ) : ℂ) d_w
          have hOpen_B12 : IsOpen B₁₂ := Metric.isOpen_ball.inter Metric.isOpen_ball
          have hConv_B12 : Convex ℝ B₁₂ := (convex_ball _ _).inter (convex_ball _ _)
          have hB12_sub_Bw : B₁₂ ⊆ B_w := Set.inter_subset_left

          let w_star : ℂ := p_star.1 - (x₁ : ℂ) - (lam : ℂ) * g (ψ p_star.2)
          have hw_star : w_star ∈ B₁₂ := by
            refine ⟨?_, ?_⟩
            · simpa [B_w, w_star, Metric.mem_ball, dist_zero_right] using hp1.2
            · rw [Metric.mem_ball, dist_eq_norm]
              have hrew : w_star - ((x₂ - x₁ : ℝ) : ℂ) =
                  p_star.1 - (x₂ : ℂ) - (lam : ℂ) * g (ψ p_star.2) := by
                simp only [w_star]
                push_cast
                ring
              rw [hrew]
              exact hp2.2

          have hMaps_T12_D : Set.MapsTo (T_horiz (x₁ - x₂)) (B₁₂ ×ˢ D_ζ) (B_w ×ˢ D_ζ) := by
            intro q hq
            refine ⟨?_, hq.2⟩
            rw [Metric.mem_ball, dist_zero_right]
            have hq_dist : ‖q.1 - ((x₂ - x₁ : ℝ) : ℂ)‖ < d_w := by
              simpa [Metric.mem_ball, dist_eq_norm] using hq.1.2
            have hrew : q.1 + ((x₁ - x₂ : ℝ) : ℂ) = q.1 - ((x₂ - x₁ : ℝ) : ℂ) := by
              push_cast
              ring
            dsimp only [T_horiz]
            rwa [hrew]
          have hMaps_T12_A : Set.MapsTo (T_horiz (x₁ - x₂)) (B₁₂ ×ˢ A_ζ) (B_w ×ˢ A_ζ) :=
            fun q hq => ⟨(hMaps_T12_D ⟨hq.1, hAζ_sub_Dζ hq.2⟩).1, hq.2⟩

          obtain ⟨G₁₂, hG₁₂⟩ := hKit.pullback_exists (T_horiz (x₁ - x₂)) (G_x x₂ k)
            (hTri_horiz (x₁ - x₂) (hOpen_B12.prod Metric.isOpen_ball)) hMaps_T12_D
          have hG12_comp : MeroEqOnPullback G₁₂ M (Ψ x₂ lam ∘ T_horiz (x₁ - x₂)) (B₁₂ ×ˢ A_ζ) :=
            hKit.pullback_comp G₁₂ (G_x x₂ k) M (T_horiz (x₁ - x₂)) (Ψ x₂ lam)
              (B₁₂ ×ˢ A_ζ) (B_w ×ˢ A_ζ)
              (hTri_horiz (x₁ - x₂) (hOpen_B12.prod hOpen_Aζ))
              (hTri_Ψ x₂ lam (Metric.isOpen_ball.prod hOpen_Aζ)
                (fun p hp => hDζ_sub_RΦ (hAζ_sub_Dζ hp.2)))
              hMaps_T12_A
              (hKit.pullback_mono G₁₂ (G_x x₂ k) (T_horiz (x₁ - x₂))
                (Set.prod_mono Subset.rfl hAζ_sub_Dζ) hG₁₂)
              (hGx_ann x₂ k hk)
          have hGx1_sub : MeroEqOnPullback (G_x x₁ k) M (Ψ x₁ lam) (B₁₂ ×ˢ A_ζ) :=
            hKit.pullback_mono (G_x x₁ k) M (Ψ x₁ lam)
              (Set.prod_mono hB12_sub_Bw Subset.rfl) (hGx_ann x₁ k hk)
          have hΨ_T12 : ∀ q ∈ B₁₂ ×ˢ A_ζ, Ψ x₁ lam q = (Ψ x₂ lam ∘ T_horiz (x₁ - x₂)) q := by
            intro q _
            ext
            · simp only [Ψ, T_horiz, Function.comp_apply]
              push_cast
              ring
            · rfl
          have hEq_B12_A : MeroEqOn (G_x x₁ k) G₁₂ (B₁₂ ×ˢ A_ζ) :=
            hKit.pullback_congr_eqOn (G_x x₁ k) G₁₂ M M
              (Ψ x₁ lam) (Ψ x₂ lam ∘ T_horiz (x₁ - x₂)) (B₁₂ ×ˢ A_ζ) W_tube
              (hTri_Ψ x₁ lam (hOpen_B12.prod hOpen_Aζ)
                (fun p hp => hDζ_sub_RΦ (hAζ_sub_Dζ hp.2)))
              hΨ_T12 hGx1_sub.2.1 hGx1_sub hG12_comp (meroEqOn_refl M Subset.rfl)
          have hEq_B12_D : MeroEqOn (G_x x₁ k) G₁₂ (B₁₂ ×ˢ D_ζ) :=
            hKit.eqOn_of_isPreconnected (G_x x₁ k) G₁₂ (B₁₂ ×ˢ D_ζ) (B₁₂ ×ˢ A_ζ)
              (hOpen_B12.prod Metric.isOpen_ball)
              (hConv_B12.prod (convex_ball (0 : ℂ) (1 + d_ζ))).isPreconnected
              (Set.subset_inter (Set.prod_mono hB12_sub_Bw Subset.rfl) Subset.rfl)
              (hOpen_B12.prod hOpen_Aζ)
              ⟨(w_star, (1 : ℂ)), hw_star, h1_mem_Aζ⟩
              (Set.prod_mono Subset.rfl hAζ_sub_Dζ)
              hEq_B12_A
          have hPb_12 : MeroEqOnPullback (G_x x₁ k) (G_x x₂ k) (T_horiz (x₁ - x₂)) (B₁₂ ×ˢ D_ζ) :=
            hKit.eqOn_pullback_left (G_x x₁ k) G₁₂ (G_x x₂ k) (T_horiz (x₁ - x₂)) (B₁₂ ×ˢ D_ζ)
              (hTri_horiz (x₁ - x₂) (hOpen_B12.prod Metric.isOpen_ball))
              hEq_B12_D hG₁₂

          have hOpen_U12 : IsOpen U₁₂ :=
            (hOpen_chart_r x₁ lam d_w).inter (hOpen_chart_r x₂ lam d_w)
          have hMaps_U12 : Set.MapsTo (Ω_map x₁ lam) U₁₂ (B₁₂ ×ˢ D_ζ) := by
            intro p hp
            refine ⟨⟨?_, ?_⟩, (hψ_props p.2 hp.1.1).1⟩
            · simpa [B_w, Ω_map, Metric.mem_ball, dist_zero_right] using hp.1.2
            · rw [Metric.mem_ball, dist_eq_norm]
              have hrew : (p.1 - (x₁ : ℂ) - (lam : ℂ) * g (ψ p.2)) - ((x₂ - x₁ : ℝ) : ℂ) =
                  p.1 - (x₂ : ℂ) - (lam : ℂ) * g (ψ p.2) := by
                push_cast
                ring
              dsimp only [Ω_map]
              rw [hrew]
              exact hp.2.2
          have hH1_comp : MeroEqOnPullback (H_chart x₁) (G_x x₂ k)
              (T_horiz (x₁ - x₂) ∘ Ω_map x₁ lam) U₁₂ :=
            hKit.pullback_comp (H_chart x₁) (G_x x₁ k) (G_x x₂ k)
              (Ω_map x₁ lam) (T_horiz (x₁ - x₂)) U₁₂ (B₁₂ ×ˢ D_ζ)
              (hTri_Ω x₁ lam hOpen_U12 (fun _ hp => hp.1.1))
              (hTri_horiz (x₁ - x₂) (hOpen_B12.prod Metric.isOpen_ball))
              hMaps_U12
              (hKit.pullback_mono (H_chart x₁) (G_x x₁ k) (Ω_map x₁ lam)
                Set.inter_subset_left (hH_chart x₁))
              hPb_12
          have hH2_sub : MeroEqOnPullback (H_chart x₂) (G_x x₂ k) (Ω_map x₂ lam) U₁₂ :=
            hKit.pullback_mono (H_chart x₂) (G_x x₂ k) (Ω_map x₂ lam)
              Set.inter_subset_right (hH_chart x₂)
          have hΩ_eq : ∀ p ∈ U₁₂, (T_horiz (x₁ - x₂) ∘ Ω_map x₁ lam) p = Ω_map x₂ lam p := by
            intro p _
            ext
            · simp only [T_horiz, Ω_map, Function.comp_apply]
              push_cast
              ring
            · rfl
          exact hKit.eqOn_symm (H_chart x₂) (H_chart x₁) U₁₂
            (hKit.pullback_congr_eqOn (H_chart x₂) (H_chart x₁) (G_x x₂ k) (G_x x₂ k)
              (Ω_map x₂ lam) (T_horiz (x₁ - x₂) ∘ Ω_map x₁ lam) U₁₂ (B_w ×ˢ D_ζ)
              (hTri_Ω x₂ lam hOpen_U12 (fun _ hp => hp.2.1))
              (fun p hp => (hΩ_eq p hp).symm)
              hH2_sub.2.1 hH2_sub hH1_comp (meroEqOn_refl (G_x x₂ k) Subset.rfl))
        · have hEmpty : U₁₂ = ∅ := Set.not_nonempty_iff_eq_empty.mp hne
          change MeroEqOn (H_chart x₁) (H_chart x₂) U₁₂
          rw [hEmpty]
          exact ⟨Set.empty_subset _, fun _ hp => False.elim hp⟩

      have hCover_Hslab : Hslab_slab (lam * a₀) ⊆ ⋃ x₀ : ℝ, U_chart x₀ lam := by
        intro p hp
        obtain ⟨x₀, hx₀⟩ := hCover_helper lam ((3 / 4 : ℝ) * d_w) hlam_abs p hp.1 hp.2
        exact Set.mem_iUnion.mpr ⟨x₀, hp.2, by linarith⟩

      obtain ⟨S_k, hS_k⟩ := hKit.glueCover (fun x₀ : ℝ => U_chart x₀ lam) (Hslab_slab (lam * a₀))
        H_chart (fun x₀ => hOpen_chart_r x₀ lam d_w) (hOpen_Hslab (lam * a₀)) hCover_Hslab hCompat
      refine ⟨S_k, fun x₀ => ?_⟩
      exact hKit.eqOn_pullback_left S_k (H_chart x₀) (G_x x₀ k) (Ω_map x₀ lam)
        (Hslab_slab (lam * a₀) ∩ U_chart x₀ lam)
        (hTri_Ω x₀ lam ((hOpen_Hslab (lam * a₀)).inter (hOpen_chart_r x₀ lam d_w))
          (fun _ hp => hp.2.1))
        (hS_k x₀)
        (hKit.pullback_mono (H_chart x₀) (G_x x₀ k) (Ω_map x₀ lam)
          Set.inter_subset_right (hH_chart x₀))

    let S_slab : ∀ (k : ℕ), k ≤ K → MeroOn2D (Hslab_slab (((k : ℝ) / (K : ℝ)) * a₀)) :=
      fun k hk => Classical.choose (hHoriz k hk)
    have hS_slab : ∀ (k : ℕ) (hk : k ≤ K) (x₀ : ℝ),
        MeroEqOnPullback (S_slab k hk) (G_x x₀ k) (Ω_map x₀ ((k : ℝ) / (K : ℝ)))
          (Hslab_slab (((k : ℝ) / (K : ℝ)) * a₀) ∩ U_chart x₀ ((k : ℝ) / (K : ℝ))) :=
      fun k hk => Classical.choose_spec (hHoriz k hk)

    
    have hBaseBridge : MeroAgreesHolo (S_slab 0 (Nat.zero_le K)) f_init
        (Hslab_slab ((((0 : ℕ) : ℝ) / (K : ℝ)) * a₀)) := by
      let lam₀ : ℝ := ((0 : ℕ) : ℝ) / (K : ℝ)
      have hlam₀ : lam₀ = 0 := by simp [lam₀]
      have hHslab0_sub : Hslab_slab (lam₀ * a₀) ⊆ U_base2 := by
        intro p hp
        refine ⟨?_, ?_⟩
        · have him : |p.1.im - lam₀ * a₀| < (3 / 4 : ℝ) * d_w := hp.1
          rw [hlam₀, zero_mul, sub_zero] at him
          linarith
        · have ht : p.2 ∈ Metric.ball (0 : ℂ) r_base := hδ_t_sub hp.2
          simpa [Metric.mem_ball, dist_zero_right] using ht
      obtain ⟨H_base2, _, hBase2_iff⟩ := hKit.ofHolo U_base2 f_init hOpen_base2 hf_holo
      have hH_eq_M : MeroEqOn H_base2 M U_base2 :=
        hKit.eqOn_symm M H_base2 U_base2
          ((hBase2_iff W_tube M U_base2 hOpen_base2 Subset.rfl).mp hM_ag)

      have hChart_eq : ∀ x₀ : ℝ,
          MeroEqOn H_base2 (S_slab 0 (Nat.zero_le K))
            (Hslab_slab (lam₀ * a₀) ∩ U_chart x₀ lam₀) := by
        intro x₀
        let W_x₀ := Hslab_slab (lam₀ * a₀) ∩ U_chart x₀ lam₀
        have hOpen_Wx : IsOpen W_x₀ :=
          (hOpen_Hslab (lam₀ * a₀)).inter (hOpen_chart_r x₀ lam₀ d_w)
        have hWx_sub : W_x₀ ⊆ U_base2 := Set.Subset.trans Set.inter_subset_left hHslab0_sub
        have hId_pb : MeroEqOnPullback H_base2 H_base2 id W_x₀ :=
          (hKit.eqOn_iff_pullback_id H_base2 H_base2 W_x₀).mp (meroEqOn_refl H_base2 hWx_sub)
        have hMaps_Ω : Set.MapsTo (Ω_map x₀ lam₀) W_x₀ (B_w ×ˢ D_ζ) := by
          intro p hp
          refine ⟨?_, (hψ_props p.2 hp.2.1).1⟩
          simpa [B_w, Ω_map, Metric.mem_ball, dist_zero_right] using hp.2.2
        have hS0_comp : MeroEqOnPullback (S_slab 0 (Nat.zero_le K)) M
            (Ψ x₀ 0 ∘ Ω_map x₀ lam₀) W_x₀ :=
          hKit.pullback_comp (S_slab 0 (Nat.zero_le K)) (G_x x₀ 0) M
            (Ω_map x₀ lam₀) (Ψ x₀ 0) W_x₀ (B_w ×ˢ D_ζ)
            (hTri_Ω x₀ lam₀ hOpen_Wx (fun _ hp => hp.2.1))
            (hTri_Ψ x₀ 0 (Metric.isOpen_ball.prod Metric.isOpen_ball)
              (fun _ hp => hDζ_sub_RΦ hp.2))
            hMaps_Ω
            (hS_slab 0 (Nat.zero_le K) x₀)
            (hGx_0 x₀)
        have hId_eq : ∀ p ∈ W_x₀, id p = (Ψ x₀ 0 ∘ Ω_map x₀ lam₀) p := by
          intro p hp
          ext
          · simp only [id, Ψ, Ω_map, Function.comp_apply, hlam₀]
            push_cast
            ring
          · simp only [id, Ψ, Ω_map, Function.comp_apply]
            exact ((hψ_props p.2 hp.2.1).2.1).symm
        exact hKit.pullback_congr_eqOn H_base2 (S_slab 0 (Nat.zero_le K)) H_base2 M
          id (Ψ x₀ 0 ∘ Ω_map x₀ lam₀) W_x₀ U_base2
          (hTri_id hOpen_Wx) hId_eq (fun _ hp => hWx_sub hp) hId_pb hS0_comp hH_eq_M

      have hCover_0 : ∀ p ∈ Hslab_slab (lam₀ * a₀), ∃ x₀ : ℝ, p ∈ Hslab_slab (lam₀ * a₀) ∩ U_chart x₀ lam₀ := by
        intro p hp
        have hlam0_abs : |lam₀| ≤ 1 := by rw [hlam₀]; norm_num
        obtain ⟨x₀, hx₀⟩ := hCover_helper lam₀ ((3 / 4 : ℝ) * d_w) hlam0_abs p hp.1 hp.2
        exact ⟨x₀, hp, hp.2, by linarith⟩
      have hEq_Hslab0 : MeroEqOn (S_slab 0 (Nat.zero_le K)) H_base2 (Hslab_slab (lam₀ * a₀)) :=
        hKit.eqOn_symm H_base2 (S_slab 0 (Nat.zero_le K)) (Hslab_slab (lam₀ * a₀))
          (meroEqOn_of_cover H_base2 (S_slab 0 (Nat.zero_le K)) hCover_0 hChart_eq)
      exact (hBase2_iff (Hslab_slab (lam₀ * a₀)) (S_slab 0 (Nat.zero_le K)) (Hslab_slab (lam₀ * a₀))
        (hOpen_Hslab (lam₀ * a₀)) hHslab0_sub).mpr hEq_Hslab0

    have hAdjBridge : ∀ (k : ℕ) (hk : k < K),
        MeroEqOn (S_slab k (Nat.le_of_lt hk)) (S_slab (k + 1) (Nat.succ_le_of_lt hk))
          (V_mid ((((k + 1 : ℕ) : ℝ) / (K : ℝ)) * a₀)) := by
      intro k hk
      let hk_le := Nat.le_of_lt hk
      let hk_succ := Nat.succ_le_of_lt hk
      let lam₁ : ℝ := (k : ℝ) / (K : ℝ)
      let lam₂ : ℝ := ((k + 1 : ℕ) : ℝ) / (K : ℝ)
      have hlam_add : lam₂ = lam₁ + Δ := by
        simp only [lam₁, lam₂, Δ]
        push_cast
        ring
      have hlam2_nonneg : 0 ≤ lam₂ := div_nonneg (Nat.cast_nonneg _) (le_of_lt hK_real_pos)
      have hlam2_le_one : lam₂ ≤ 1 := (div_le_one hK_real_pos).mpr (by exact_mod_cast hk_succ)
      have hlam2_abs : |lam₂| ≤ 1 := by rwa [abs_of_nonneg hlam2_nonneg]

      let V_chart : ℝ → Set (ℂ × ℂ) := fun x₀ =>
        V_mid (lam₂ * a₀) ∩
          { p : ℂ × ℂ | p.2 ∈ B_t ∧ ‖p.1 - (x₀ : ℂ) - (lam₂ : ℂ) * g (ψ p.2)‖ < d_w / 2 }

      have hV_eq : ∀ x₀ : ℝ,
          MeroEqOn (S_slab k hk_le) (S_slab (k + 1) hk_succ) (V_chart x₀) := by
        intro x₀
        have hOpen_Vx : IsOpen (V_chart x₀) :=
          (hOpen_Vmid (lam₂ * a₀)).inter (hOpen_chart_r x₀ lam₂ (d_w / 2))
        have hSub₂ : V_chart x₀ ⊆ Hslab_slab (lam₂ * a₀) ∩ U_chart x₀ lam₂ := by
          intro p hp
          have hp_im : |p.1.im - lam₂ * a₀| < (1 / 4 : ℝ) * d_w := hp.1.1
          exact ⟨⟨show |p.1.im - lam₂ * a₀| < (3 / 4 : ℝ) * d_w by linarith, hp.1.2⟩,
            hp.2.1, by linarith [hp.2.2]⟩
        have hSub₁ : V_chart x₀ ⊆ Hslab_slab (lam₁ * a₀) ∩ U_chart x₀ lam₁ := by
          intro p hp
          have hp_im : |p.1.im - lam₂ * a₀| < (1 / 4 : ℝ) * d_w := hp.1.1
          refine ⟨⟨?_, hp.1.2⟩, hp.2.1, ?_⟩
          · show |p.1.im - lam₁ * a₀| < (3 / 4 : ℝ) * d_w
            have hrew : p.1.im - lam₁ * a₀ = (p.1.im - lam₂ * a₀) + Δ * a₀ := by
              rw [hlam_add]; ring
            rw [hrew]
            have habs : |(p.1.im - lam₂ * a₀) + Δ * a₀| ≤ |p.1.im - lam₂ * a₀| + |Δ * a₀| :=
              abs_add_le _ _
            rw [abs_of_pos hstep_a₀_pos] at habs
            linarith
          · have hrew : p.1 - (x₀ : ℂ) - (lam₁ : ℂ) * g (ψ p.2) =
                (p.1 - (x₀ : ℂ) - (lam₂ : ℂ) * g (ψ p.2)) + (Δ : ℂ) * g (ψ p.2) := by
              rw [hlam_add]
              push_cast
              ring
            rw [hrew]
            calc ‖(p.1 - (x₀ : ℂ) - (lam₂ : ℂ) * g (ψ p.2)) + (Δ : ℂ) * g (ψ p.2)‖
                ≤ ‖p.1 - (x₀ : ℂ) - (lam₂ : ℂ) * g (ψ p.2)‖ + ‖(Δ : ℂ) * g (ψ p.2)‖ :=
                  norm_add_le _ _
              _ < d_w / 2 + d_w / 2 :=
                  add_lt_add hp.2.2 (hStep_lt (ψ p.2) (hψ_props p.2 hp.2.1).1)
              _ = d_w := by ring
        have hMaps_V : Set.MapsTo (Ω_map x₀ lam₂) (V_chart x₀) (B_w2 ×ˢ D_ζ) := by
          intro p hp
          refine ⟨?_, (hψ_props p.2 hp.2.1).1⟩
          simpa [B_w2, Ω_map, Metric.mem_ball, dist_zero_right] using hp.2.2
        have hS1_sub : MeroEqOnPullback (S_slab k hk_le) (G_x x₀ k) (Ω_map x₀ lam₁) (V_chart x₀) :=
          hKit.pullback_mono (S_slab k hk_le) (G_x x₀ k) (Ω_map x₀ lam₁)
            hSub₁ (hS_slab k hk_le x₀)
        have hS2_comp : MeroEqOnPullback (S_slab (k + 1) hk_succ) (G_x x₀ k)
            (S_shift Δ ∘ Ω_map x₀ lam₂) (V_chart x₀) :=
          hKit.pullback_comp (S_slab (k + 1) hk_succ) (G_x x₀ (k + 1)) (G_x x₀ k)
            (Ω_map x₀ lam₂) (S_shift Δ) (V_chart x₀) (B_w2 ×ˢ D_ζ)
            (hTri_Ω x₀ lam₂ hOpen_Vx (fun _ hp => hp.2.1))
            (hTri_shift Δ (Metric.isOpen_ball.prod Metric.isOpen_ball))
            hMaps_V
            (hKit.pullback_mono (S_slab (k + 1) hk_succ) (G_x x₀ (k + 1)) (Ω_map x₀ lam₂)
              hSub₂ (hS_slab (k + 1) hk_succ x₀))
            (hGx_step x₀ k hk)
        have hShift_Ω : ∀ p ∈ V_chart x₀, Ω_map x₀ lam₁ p = (S_shift Δ ∘ Ω_map x₀ lam₂) p := by
          intro p _
          ext
          · simp only [Ω_map, S_shift, Function.comp_apply, hlam_add]
            push_cast
            ring
          · rfl
        exact hKit.pullback_congr_eqOn (S_slab k hk_le) (S_slab (k + 1) hk_succ)
          (G_x x₀ k) (G_x x₀ k) (Ω_map x₀ lam₁) (S_shift Δ ∘ Ω_map x₀ lam₂)
          (V_chart x₀) (B_w ×ˢ D_ζ)
          (hTri_Ω x₀ lam₁ hOpen_Vx (fun _ hp => hp.2.1))
          hShift_Ω hS1_sub.2.1 hS1_sub hS2_comp
          (meroEqOn_refl (G_x x₀ k) Subset.rfl)

      have hCover_V : ∀ p ∈ V_mid (lam₂ * a₀), ∃ x₀ : ℝ, p ∈ V_chart x₀ := by
        intro p hp
        obtain ⟨x₀, hx₀⟩ := hCover_helper lam₂ ((1 / 4 : ℝ) * d_w) hlam2_abs p hp.1 hp.2
        exact ⟨x₀, hp, hp.2, by linarith⟩
      exact meroEqOn_of_cover (S_slab k hk_le) (S_slab (k + 1) hk_succ) hCover_V hV_eq

    
    let c_fn : ℕ → ℝ := fun k => ((k : ℝ) / (K : ℝ)) * a₀
    let W_strip : ℕ → Set (ℂ × ℂ) := fun k =>
      { y : ℂ | -s_base < y.im ∧ y.im < max s_base (c_fn k + (3 / 4 : ℝ) * d_w) } ×ˢ B_t

    have hOpen_strip : ∀ L U : ℝ, IsOpen ({ y : ℂ | L < y.im ∧ y.im < U } ×ˢ B_t) :=
      fun L U =>
        ((isOpen_lt continuous_const Complex.continuous_im).inter
          (isOpen_lt Complex.continuous_im continuous_const)).prod Metric.isOpen_ball
    have hConv_strip : ∀ L U : ℝ, Convex ℝ ({ y : ℂ | L < y.im ∧ y.im < U } ×ˢ B_t) :=
      fun L U =>
        ((convex_Ioo L U).linear_preimage Complex.imCLM.toLinearMap).prod
          (convex_ball (Φ 0) δ_t)
    have hConv_Hslab : ∀ c : ℝ, Convex ℝ (Hslab_slab c) := by
      intro c
      have hEq : Hslab_slab c =
          { y : ℂ | c - (3 / 4 : ℝ) * d_w < y.im ∧ y.im < c + (3 / 4 : ℝ) * d_w } ×ˢ B_t := by
        ext p
        change |p.1.im - c| < (3 / 4 : ℝ) * d_w ∧ p.2 ∈ B_t ↔
          (c - (3 / 4 : ℝ) * d_w < p.1.im ∧ p.1.im < c + (3 / 4 : ℝ) * d_w) ∧ p.2 ∈ B_t
        rw [abs_lt]
        constructor <;> intro ⟨h1, h2⟩ <;> exact ⟨⟨by linarith, by linarith⟩, h2⟩
      rw [hEq]
      exact hConv_strip _ _

    have hc_nonneg : ∀ m : ℕ, 0 ≤ c_fn m := fun m =>
      mul_nonneg (div_nonneg (Nat.cast_nonneg m) (le_of_lt hK_real_pos)) (le_of_lt ha₀_pos)
    have hHslab_sub_W : ∀ m : ℕ, Hslab_slab (c_fn m) ⊆ W_strip m := by
      intro m p hp
      have hp1 : |p.1.im - c_fn m| < (3 / 4 : ℝ) * d_w := hp.1
      obtain ⟨hlow, hhigh⟩ := abs_lt.mp hp1
      have hcm := hc_nonneg m
      refine ⟨⟨by linarith, lt_of_lt_of_le (by linarith) (le_max_right _ _)⟩, hp.2⟩
    have hW_mono : ∀ {m₁ m₂ : ℕ}, m₁ ≤ m₂ → W_strip m₁ ⊆ W_strip m₂ := by
      intro m₁ m₂ hm p hp
      have hcm : c_fn m₁ ≤ c_fn m₂ := by
        simp only [c_fn]
        exact mul_le_mul_of_nonneg_right
          (div_le_div_of_nonneg_right (by exact_mod_cast hm) (le_of_lt hK_real_pos))
          (le_of_lt ha₀_pos)
      refine ⟨⟨hp.1.1, lt_of_lt_of_le hp.1.2 (max_le_max_left s_base (by linarith))⟩, hp.2⟩

    have hW0_sub_base2 : W_strip 0 ⊆ U_base2 := by
      intro p hp
      have hc0 : c_fn 0 = 0 := by simp [c_fn]
      have hmax0 : max s_base (c_fn 0 + (3 / 4 : ℝ) * d_w) = s_base := by
        rw [hc0, zero_add]
        exact max_eq_left (by linarith)
      have him_lt : p.1.im < s_base := by simpa [W_strip, hmax0] using hp.1.2
      refine ⟨?_, ?_⟩
      · rw [abs_lt]
        exact ⟨by linarith [hp.1.1], by linarith⟩
      · have ht : p.2 ∈ Metric.ball (0 : ℂ) r_base := hδ_t_sub hp.2
        simpa [Metric.mem_ball, dist_zero_right] using ht

    obtain ⟨E₀, _, hE₀_iff⟩ :=
      hKit.ofHolo (W_strip 0) f_init (hOpen_strip _ _) (hf_holo.mono hW0_sub_base2)

    have hVert : ∀ k : ℕ, ∀ hk : k ≤ K,
        ∃ E_k : MeroOn2D (W_strip k),
          MeroEqOn E_k E₀ (W_strip 0) ∧
          MeroEqOn E_k (S_slab k hk) (Hslab_slab (c_fn k)) := by
      intro k
      induction k with
      | zero =>
        intro hk
        refine ⟨E₀, meroEqOn_refl E₀ Subset.rfl, ?_⟩
        exact hKit.eqOn_symm (S_slab 0 hk) E₀ (Hslab_slab (c_fn 0))
          ((hE₀_iff (Hslab_slab (c_fn 0)) (S_slab 0 hk) (Hslab_slab (c_fn 0))
            (hOpen_Hslab (c_fn 0)) (hHslab_sub_W 0)).mp hBaseBridge)
      | succ k ih =>
        intro hk1
        have hk_lt : k < K := Nat.lt_of_succ_le hk1
        have hk_le : k ≤ K := Nat.le_of_lt hk_lt
        obtain ⟨E_k, hEk_0, hEk_S⟩ := ih hk_le

        have hc_diff : c_fn (k + 1) - c_fn k = Δ * a₀ := by
          simp only [c_fn, Δ]
          push_cast
          ring

        have hUnion : W_strip (k + 1) ⊆ W_strip k ∪ Hslab_slab (c_fn (k + 1)) := by
          intro p hp
          by_cases hlt : p.1.im < max s_base (c_fn k + (3 / 4 : ℝ) * d_w)
          · exact Or.inl ⟨⟨hp.1.1, hlt⟩, hp.2⟩
          · right
            have hge : max s_base (c_fn k + (3 / 4 : ℝ) * d_w) ≤ p.1.im := not_lt.mp hlt
            obtain ⟨hs_le, hck_le⟩ := max_le_iff.mp hge
            have hupper : p.1.im < c_fn (k + 1) + (3 / 4 : ℝ) * d_w := by
              rcases lt_max_iff.mp hp.1.2 with h1 | h2
              · linarith
              · exact h2
            refine ⟨show |p.1.im - c_fn (k + 1)| < (3 / 4 : ℝ) * d_w from
              abs_lt.mpr ⟨by linarith, by linarith⟩, hp.2⟩

        have hV_sub_inter : V_mid (c_fn (k + 1)) ⊆ W_strip k ∩ Hslab_slab (c_fn (k + 1)) := by
          intro p hp
          have hp1 : |p.1.im - c_fn (k + 1)| < (1 / 4 : ℝ) * d_w := hp.1
          obtain ⟨h1, h2⟩ := abs_lt.mp hp1
          have hp_Hslabk1 : p ∈ Hslab_slab (c_fn (k + 1)) :=
            ⟨show |p.1.im - c_fn (k + 1)| < (3 / 4 : ℝ) * d_w from
              abs_lt.mpr ⟨by linarith, by linarith⟩, hp.2⟩
          have hp_Hslabk : p ∈ Hslab_slab (c_fn k) :=
            ⟨show |p.1.im - c_fn k| < (3 / 4 : ℝ) * d_w from
              abs_lt.mpr ⟨by linarith, by linarith⟩, hp.2⟩
          exact ⟨hHslab_sub_W k hp_Hslabk, hp_Hslabk1⟩

        have hV_nonempty : (V_mid (c_fn (k + 1))).Nonempty := by
          refine ⟨(((c_fn (k + 1) : ℝ) : ℂ) * Complex.I, Φ 0), ?_, Metric.mem_ball_self hδ_t⟩
          show |(((c_fn (k + 1) : ℝ) : ℂ) * Complex.I).im - c_fn (k + 1)| < (1 / 4 : ℝ) * d_w
          simp only [Complex.mul_im, Complex.ofReal_re, Complex.I_im,
            Complex.ofReal_im, Complex.I_re]
          norm_num
          linarith

        have hV_sub_Hslabk : V_mid (c_fn (k + 1)) ⊆ Hslab_slab (c_fn k) := by
          intro p hp
          have hp1 : |p.1.im - c_fn (k + 1)| < (1 / 4 : ℝ) * d_w := hp.1
          obtain ⟨h1, h2⟩ := abs_lt.mp hp1
          exact ⟨show |p.1.im - c_fn k| < (3 / 4 : ℝ) * d_w from
            abs_lt.mpr ⟨by linarith, by linarith⟩, hp.2⟩

        have hEq_V : MeroEqOn E_k (S_slab (k + 1) hk1) (V_mid (c_fn (k + 1))) :=
          hKit.eqOn_trans E_k (S_slab k hk_le) (S_slab (k + 1) hk1) (V_mid (c_fn (k + 1)))
            (hKit.eqOn_mono E_k (S_slab k hk_le) hV_sub_Hslabk hEk_S)
            (hAdjBridge k hk_lt)

        have hEq_inter : MeroEqOn E_k (S_slab (k + 1) hk1)
            (W_strip k ∩ Hslab_slab (c_fn (k + 1))) :=
          hKit.eqOn_of_isPreconnected E_k (S_slab (k + 1) hk1)
            (W_strip k ∩ Hslab_slab (c_fn (k + 1))) (V_mid (c_fn (k + 1)))
            ((hOpen_strip _ _).inter (hOpen_Hslab _))
            ((hConv_strip _ _).inter (hConv_Hslab _)).isPreconnected
            Subset.rfl
            (hOpen_Vmid _)
            hV_nonempty
            hV_sub_inter
            hEq_V

        obtain ⟨E_next, hEnext_W, hEnext_Hslab⟩ :=
          hKit.glueBinary E_k (S_slab (k + 1) hk1)
            (hOpen_strip _ _) (hOpen_Hslab _) (hOpen_strip _ _) hUnion hEq_inter

        refine ⟨E_next, ?_, ?_⟩
        · have h0_sub : W_strip 0 ⊆ W_strip (k + 1) ∩ W_strip k :=
            Set.subset_inter (hW_mono (Nat.zero_le _)) (hW_mono (Nat.zero_le _))
          exact hKit.eqOn_trans E_next E_k E₀ (W_strip 0)
            (hKit.eqOn_mono E_next E_k h0_sub hEnext_W) hEk_0
        · have hHslab_sub : Hslab_slab (c_fn (k + 1)) ⊆ W_strip (k + 1) ∩ Hslab_slab (c_fn (k + 1)) :=
            Set.subset_inter (hHslab_sub_W (k + 1)) Subset.rfl
          exact hKit.eqOn_mono E_next (S_slab (k + 1) hk1) hHslab_sub hEnext_Hslab

    obtain ⟨E_K, hEK_0, _⟩ := hVert K (le_refl K)
    have hcK : c_fn K = a₀ := by
      simp only [c_fn, div_self hK_ne, one_mul]
    have hWfinal_sub : W_final ⊆ W_strip K := by
      intro p hp
      refine ⟨⟨hp.1.1, lt_of_lt_of_le hp.1.2 ?_⟩, hp.2⟩
      rw [hcK]
      exact le_max_right _ _
    obtain ⟨G_final, hG_final⟩ := hKit.restrictOpen E_K W_final (hOpen_strip _ _) hWfinal_sub

    have hOpen_Wbase : IsOpen W_base :=
      (isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const).prod
        Metric.isOpen_ball
    have hWbase_sub_W0 : W_base ⊆ W_strip 0 := by
      intro p hp
      have hp1 : |p.1.im| < s_base := hp.1
      obtain ⟨h1, h2⟩ := abs_lt.mp hp1
      exact ⟨⟨h1, lt_of_lt_of_le h2 (le_max_left _ _)⟩, hp.2⟩
    have hWbase_sub_Wfinal : W_base ⊆ W_final := by
      intro p hp
      have hp1 : |p.1.im| < s_base := hp.1
      obtain ⟨h1, h2⟩ := abs_lt.mp hp1
      exact ⟨⟨h1, by linarith⟩, hp.2⟩

    have hGfinal_E0 : MeroEqOn G_final E₀ W_base :=
      hKit.eqOn_trans G_final E_K E₀ W_base
        (hKit.eqOn_mono G_final E_K hWbase_sub_Wfinal hG_final)
        (hKit.eqOn_mono E_K E₀ hWbase_sub_W0 hEK_0)

    exact ⟨G_final,
      (hE₀_iff W_final G_final W_base hOpen_Wbase hWbase_sub_W0).mpr hGfinal_E0⟩

  refine ⟨by linarith, δ_t, hδ_t, hδ_t_sub, fun i => Classical.choose (hComp i),
    fun i => Classical.choose_spec (hComp i)⟩

theorem holomorphic_disk_supermean (s_base r_base : ℝ)
    (hs : 0 < s_base) (hr : 0 < r_base)
    (F_init : Fin 2 → ℂ × ℂ → ℂ)
    (hF_holo : ∀ i : Fin 2,
      DifferentiableOn ℂ (F_init i)
        { p : ℂ × ℂ | |p.1.im| < 2 * s_base ∧ ‖p.2‖ < r_base })
    (h_ge_two : ∀ t ∈ Metric.ball (0 : ℂ) r_base,
      ENNReal.ofReal (2 * s_base) ≤ meroStripWidth s_base r_base F_init t)
    (h_lsc : LowerSemicontinuousOn (meroStripWidth s_base r_base F_init)
      (Metric.ball (0 : ℂ) r_base))
    (M_F : Fin 2 → MeroOn2D (meroTubeENNR r_base (meroStripWidth s_base r_base F_init)))
    (hM_agrees : ∀ i : Fin 2,
      MeroAgreesHolo (M_F i) (F_init i)
        { p : ℂ × ℂ | |p.1.im| < 2 * s_base ∧ ‖p.2‖ < r_base })
    (hDisk : MeroDiskContinuationProp) :
    HolomorphicDiskSupermeanProp r_base (meroStripWidth s_base r_base F_init) :=
by
  intro R_Φ Φ hR_Φ hΦ_holo hΦ_maps hΦ_deriv q hq_cont hq_per hq_lt
  let h_F : ℂ → ENNReal := meroStripWidth s_base r_base F_init
  let I_q : ℝ := (2 * Real.pi)⁻¹ * ∫ θ in (0 : ℝ)..(2 * Real.pi), q θ
  have h0_mem : (0 : ℂ) ∈ Metric.ball (0 : ℂ) R_Φ := by
    rw [Metric.mem_ball, dist_self]
    linarith
  have hΦ0_mem : Φ 0 ∈ Metric.ball (0 : ℂ) r_base := hΦ_maps 0 h0_mem
  by_cases hIq : I_q ≤ 2 * s_base
  · exact le_trans (ENNReal.ofReal_le_ofReal hIq) (h_ge_two (Φ 0) hΦ0_mem)
  · have hIq_gt : 2 * s_base < I_q := lt_of_not_ge hIq
    obtain ⟨η₀, hη₀, hCollar⟩ :=
      lsc_annular_collar_and_disk_inversion s_base r_base R_Φ hs hr hR_Φ
        h_F h_ge_two h_lsc Φ hΦ_holo hΦ_maps hΦ_deriv q hq_cont hq_per hq_lt
    obtain ⟨g, hg_holo, hg_bdry, hg_mean⟩ :=
      fourier_holomorphic_majorant_poly q η₀ hq_cont hq_per (fun θ => (hq_lt θ).1) hη₀
    have hg0_gt : 2 * s_base < (g 0).im := lt_of_lt_of_le hIq_gt hg_mean
    obtain ⟨d_w, d_ζ, δ_t, ψ, ⟨hd_w, hd_w_lt⟩, ⟨hd_ζ, hd_ζ_lt_one, hd_ζ_lt_R⟩,
      hAnn_maps, ⟨hδ_t, hδ_t_sub⟩, ⟨hψ_holo, _, hψ_deriv⟩, hψ_props⟩ :=
      hCollar g hg_holo hg_bdry
    have hWit : IsCollarHeightWitness s_base r_base F_init (Φ 0)
        ((g 0).im + (3 / 4 : ℝ) * d_w) :=
      multi_slab_disk_continuation_ascent
        mero2d_sheaf_pullback_toolkit hDisk
        s_base r_base R_Φ d_w d_ζ δ_t hs hd_w hd_w_lt hd_ζ hd_ζ_lt_one hd_ζ_lt_R hδ_t
        F_init hF_holo (meroTubeENNR r_base h_F) M_F hM_agrees
        Φ ψ g hΦ_holo hΦ_maps hΦ_deriv hg_holo hg0_gt hAnn_maps
        hδ_t_sub hψ_holo hψ_deriv hψ_props
    have hle_real : I_q ≤ (g 0).im + (3 / 4 : ℝ) * d_w := by linarith
    exact le_trans (ENNReal.ofReal_le_ofReal hle_real)
      (le_sSup ⟨(g 0).im + (3 / 4 : ℝ) * d_w, hWit, rfl⟩)

theorem half_disk_countable_superharmonic_transfer (s_base r_base : ℝ)
    (hs : 0 < s_base) (hr : 0 < r_base)
    (h_F : ℂ → ENNReal)
    (h_ge : ∀ t ∈ Metric.ball (0 : ℂ) r_base, ENNReal.ofReal (2 * s_base) ≤ h_F t)
    (h_lsc : LowerSemicontinuousOn h_F (Metric.ball (0 : ℂ) r_base))
    (h_disk_supermean : HolomorphicDiskSupermeanProp r_base h_F) :
    ∀ (t₀ δ_star M : ℝ) (E_cnt : Set ℝ),
      0 < δ_star → |t₀| + δ_star < r_base → E_cnt.Countable →
      (∀ t ∈ Set.Ioo (t₀ - δ_star) (t₀ + δ_star) \ E_cnt,
        ENNReal.ofReal M ≤ h_F (t : ℂ)) →
      ENNReal.ofReal M ≤ h_F (t₀ : ℂ) :=
by
  
  have h_conformal :
      ∀ (η_arc : ℝ), 0 < η_arc → η_arc < Real.pi / 2 →
        ∃ δ_z : ℝ, 0 < δ_z ∧
          ∀ z_star : ℂ, ‖z_star‖ < δ_z → 0 < z_star.im →
            ∃ Ψ : ℂ → ℂ,
              Ψ 0 = z_star ∧
              DifferentiableOn ℂ Ψ (Metric.ball (0 : ℂ) 1) ∧
              deriv Ψ 0 ≠ 0 ∧
              (∀ z ∈ Metric.ball (0 : ℂ) 1, ‖Ψ z‖ < 1) ∧
              ContinuousOn
                (fun p : ℝ × ℝ => Ψ ((p.1 : ℂ) * Complex.exp ((p.2 : ℂ) * Complex.I)))
                (Set.Icc (0 : ℝ) 1 ×ˢ Set.Icc η_arc (2 * Real.pi - η_arc)) ∧
              (∀ θ ∈ Set.Icc η_arc (2 * Real.pi - η_arc),
                (Ψ (Complex.exp ((θ : ℂ) * Complex.I))).im = 0 ∧
                |(Ψ (Complex.exp ((θ : ℂ) * Complex.I))).re| < 1) ∧
              Set.InjOn (fun θ : ℝ => (Ψ (Complex.exp ((θ : ℂ) * Complex.I))).re)
                (Set.Ioo η_arc (2 * Real.pi - η_arc)) := by
    clear hs hr h_F h_ge h_lsc h_disk_supermean s_base r_base
    have h_cayley_re : ∀ z : ℂ, ((1 + z) / (1 - z)).re = (1 - ‖z‖ ^ 2) / ‖1 - z‖ ^ 2 := by
      intro z
      rw [Complex.div_re, Complex.normSq_eq_norm_sq, ← add_div]
      have hnum : (1 + z).re * (1 - z).re + (1 + z).im * (1 - z).im = 1 - Complex.normSq z := by
        simp [Complex.normSq_apply]; ring
      rw [hnum, Complex.normSq_eq_norm_sq]
    have h_cayley_im : ∀ z : ℂ, ((1 + z) / (1 - z)).im = 2 * z.im / ‖1 - z‖ ^ 2 := by
      intro z
      rw [Complex.div_im, Complex.normSq_eq_norm_sq, ← sub_div]
      have hnum : (1 + z).im * (1 - z).re - (1 + z).re * (1 - z).im = 2 * z.im := by
        simp; ring
      rw [hnum]
    have h_mobius_lt_one : ∀ s : ℂ, 0 < s.re → s + 1 ≠ 0 ∧ ‖(s - 1) / (s + 1)‖ < 1 := by
      intro s hs_re
      have hs1_re : 0 < (s + 1).re := by simp; linarith
      have hs1_ne : s + 1 ≠ 0 := by
        intro h0; rw [h0] at hs1_re; norm_num at hs1_re
      refine ⟨hs1_ne, ?_⟩
      have hs1_pos : 0 < ‖s + 1‖ := norm_pos_iff.mpr hs1_ne
      rw [norm_div, div_lt_one hs1_pos]
      have hsq : ‖s - 1‖ ^ 2 < ‖s + 1‖ ^ 2 := by
        rw [← Complex.normSq_eq_norm_sq, ← Complex.normSq_eq_norm_sq]
        simp [Complex.normSq_apply]
        linarith
      nlinarith [norm_nonneg (s - 1), hs1_pos]
    let S_quad : ℂ → ℂ := fun w =>
      Complex.exp (((1 / 2 : ℝ) : ℂ) * Complex.log w + ((Real.pi / 4 : ℝ) : ℂ) * Complex.I)
    have h_squad_sq : ∀ w : ℂ, w ≠ 0 → (S_quad w) ^ 2 = Complex.I * w := by
      intro w hw
      dsimp [S_quad]
      rw [sq, ← Complex.exp_add]
      have harg :
          (((1 / 2 : ℝ) : ℂ) * Complex.log w + ((Real.pi / 4 : ℝ) : ℂ) * Complex.I) +
            (((1 / 2 : ℝ) : ℂ) * Complex.log w + ((Real.pi / 4 : ℝ) : ℂ) * Complex.I) =
            Complex.log w + ((Real.pi / 2 : ℝ) : ℂ) * Complex.I := by
        push_cast; ring
      rw [harg, Complex.exp_add, Complex.exp_log hw, Complex.exp_mul_I]
      rw [← Complex.ofReal_cos, ← Complex.ofReal_sin, Real.cos_pi_div_two, Real.sin_pi_div_two]
      simp [mul_comm]
    have h_squad_re_pos : ∀ w : ℂ, 0 < w.re → 0 < (S_quad w).re := by
      intro w hw_re
      have hw_arg : |w.arg| < Real.pi / 2 :=
        Complex.abs_arg_lt_pi_div_two_iff.mpr (Or.inl hw_re)
      rw [abs_lt] at hw_arg
      dsimp [S_quad]
      rw [Complex.exp_re]
      have him :
          (((1 / 2 : ℝ) : ℂ) * Complex.log w + ((Real.pi / 4 : ℝ) : ℂ) * Complex.I).im =
            (1 / 2 : ℝ) * w.arg + Real.pi / 4 := by
        simp [Complex.log_im]
      rw [him]
      exact mul_pos (Real.exp_pos _)
        (Real.cos_pos_of_mem_Ioo ⟨by linarith [Real.pi_pos], by linarith [Real.pi_pos]⟩)
    intro η_arc hη_pos hη_lt
    have hcos_pos : 0 < Real.cos η_arc :=
      Real.cos_pos_of_mem_Ioo ⟨by linarith [Real.pi_pos], hη_lt⟩
    have hcos_lt_one : Real.cos η_arc < 1 := by
      have h := Real.cos_lt_cos_of_nonneg_of_le_pi (le_refl (0 : ℝ))
        (by linarith [Real.pi_pos]) hη_pos
      simpa using h
    let c_η : ℝ := 1 - Real.cos η_arc
    have hc_pos : 0 < c_η := sub_pos.mpr hcos_lt_one
    have hc_lt_one : c_η < 1 := by dsimp [c_η]; linarith
    let δ_z : ℝ := min (1 / 4 : ℝ) (c_η ^ 2 / 128)
    have hδ_pos : 0 < δ_z := lt_min (by norm_num) (by positivity)
    refine ⟨δ_z, hδ_pos, ?_⟩
    intro z_star hz_norm hz_im
    have hz_lt_quarter : ‖z_star‖ < 1 / 4 := lt_of_lt_of_le hz_norm (min_le_left _ _)
    have hz_lt_c : ‖z_star‖ < c_η ^ 2 / 128 := lt_of_lt_of_le hz_norm (min_le_right _ _)
    have h1z_norm : 3 / 4 < ‖(1 : ℂ) - z_star‖ := by
      have htri := norm_sub_norm_le (1 : ℂ) z_star
      simp only [norm_one] at htri
      linarith
    have h1z_ne : (1 : ℂ) - z_star ≠ 0 := by
      intro h0; rw [h0, norm_zero] at h1z_norm; linarith
    let s_star : ℂ := (1 + z_star) / (1 - z_star)
    have hs_re : 0 < s_star.re := by
      dsimp [s_star]
      rw [h_cayley_re]
      have hz_sq : ‖z_star‖ ^ 2 < 1 := by nlinarith [norm_nonneg z_star]
      have hden_pos : 0 < ‖(1 : ℂ) - z_star‖ ^ 2 := by positivity
      exact div_pos (by linarith) hden_pos
    have hs_im : 0 < s_star.im := by
      dsimp [s_star]
      rw [h_cayley_im]
      have hden_pos : 0 < ‖(1 : ℂ) - z_star‖ ^ 2 := by positivity
      exact div_pos (by linarith) hden_pos
    let w_star : ℂ := -Complex.I * s_star ^ 2
    let α : ℝ := w_star.re
    let γ : ℝ := w_star.im
    have hα_eq : α = 2 * s_star.re * s_star.im := by
      dsimp [α, w_star]
      simp [sq]
      ring
    have hα_pos : 0 < α := by
      rw [hα_eq]; positivity
    have hw_diff : ‖w_star - (-Complex.I)‖ < c_η ^ 2 / 16 := by
      have hs_m1_eq : s_star - 1 = 2 * z_star / (1 - z_star) := by
        dsimp [s_star]; field_simp [h1z_ne]; ring
      have hs_m1_norm : ‖s_star - 1‖ ≤ (8 / 3 : ℝ) * ‖z_star‖ := by
        rw [hs_m1_eq, norm_div, norm_mul, Complex.norm_ofNat]
        rw [div_le_iff₀ (by linarith)]
        nlinarith [norm_nonneg z_star]
      have hs_p1_norm : ‖s_star + 1‖ ≤ 8 / 3 := by
        have htri : ‖s_star + 1‖ ≤ ‖s_star - 1‖ + ‖(2 : ℂ)‖ := by
          have heq : s_star + 1 = (s_star - 1) + (2 : ℂ) := by ring
          rw [heq]
          exact norm_add_le _ _
        rw [Complex.norm_ofNat] at htri
        linarith
      have hw_fac : w_star - (-Complex.I) = -Complex.I * ((s_star - 1) * (s_star + 1)) := by
        dsimp [w_star]; ring
      have hw_norm_eq : ‖w_star - (-Complex.I)‖ = ‖s_star - 1‖ * ‖s_star + 1‖ := by
        rw [hw_fac, norm_mul, norm_neg, Complex.norm_I, one_mul, norm_mul]
      calc ‖w_star - (-Complex.I)‖
          = ‖s_star - 1‖ * ‖s_star + 1‖ := hw_norm_eq
        _ ≤ ((8 / 3 : ℝ) * ‖z_star‖) * (8 / 3 : ℝ) := by
            gcongr
        _ ≤ 8 * ‖z_star‖ := by nlinarith [norm_nonneg z_star]
        _ < 8 * (c_η ^ 2 / 128) := by linarith
        _ = c_η ^ 2 / 16 := by ring
    have hc_sq_lt_one : c_η ^ 2 < 1 := by nlinarith
    have hα_lt : α < c_η ^ 2 / 16 := by
      have hre_le : (w_star - (-Complex.I)).re ≤ ‖w_star - (-Complex.I)‖ :=
        Complex.re_le_norm _
      have hre_eq : (w_star - (-Complex.I)).re = α := by dsimp [α]; simp
      linarith
    have hγ_lt : γ < -(3 / 4 : ℝ) := by
      have him_le : (w_star - (-Complex.I)).im ≤ ‖w_star - (-Complex.I)‖ :=
        Complex.im_le_norm _
      have him_eq : (w_star - (-Complex.I)).im = γ + 1 := by dsimp [γ]; simp
      linarith
    let W : ℂ → ℂ := fun z => (α : ℂ) * ((1 + z) / (1 - z)) + (γ : ℂ) * Complex.I
    let Ψ : ℂ → ℂ := fun z => (S_quad (W z) - 1) / (S_quad (W z) + 1)
    have hW0 : W 0 = w_star := by
      dsimp [W, α, γ]
      simp [Complex.re_add_im]
    have hw_star_ne : w_star ≠ 0 := by
      intro h0
      have : w_star.re = 0 := by rw [h0]; simp
      linarith [hα_pos]
    have hS_wstar : S_quad w_star = s_star := by
      have hsq : (S_quad w_star) ^ 2 = s_star ^ 2 := by
        rw [h_squad_sq w_star hw_star_ne]
        dsimp [w_star]
        calc Complex.I * (-Complex.I * s_star ^ 2)
            = -(Complex.I ^ 2) * s_star ^ 2 := by ring
          _ = s_star ^ 2 := by rw [Complex.I_sq]; ring
      have hmul : (S_quad w_star - s_star) * (S_quad w_star + s_star) = 0 := by
        linear_combination hsq
      have hsum_re : 0 < (S_quad w_star + s_star).re := by
        simp only [Complex.add_re]
        linarith [h_squad_re_pos w_star hα_pos, hs_re]
      have hsum_ne : S_quad w_star + s_star ≠ 0 := by
        intro h0; rw [h0] at hsum_re; norm_num at hsum_re
      exact sub_eq_zero.mp ((mul_eq_zero.mp hmul).resolve_right hsum_ne)
    have hΨ0 : Ψ 0 = z_star := by
      dsimp [Ψ]
      rw [hW0, hS_wstar]
      have hs1_ne : s_star + 1 ≠ 0 := (h_mobius_lt_one s_star hs_re).1
      dsimp [s_star] at hs1_ne ⊢
      field_simp [h1z_ne, hs1_ne]
      ring
    
    have hball_1z_ne : ∀ z ∈ Metric.ball (0 : ℂ) 1, 1 - z ≠ 0 := by
      intro z hz h0
      rw [Metric.mem_ball, dist_zero_right] at hz
      have h1 : (1 : ℂ) = z := sub_eq_zero.mp h0
      rw [← h1, norm_one] at hz
      linarith
    have hball_W_re : ∀ z ∈ Metric.ball (0 : ℂ) 1, 0 < (W z).re := by
      intro z hz
      have hz_lt : ‖z‖ < 1 := by simpa [Metric.mem_ball, dist_zero_right] using hz
      have h1z : 1 - z ≠ 0 := hball_1z_ne z hz
      have hre : (W z).re = α * ((1 + z) / (1 - z)).re := by dsimp [W]; simp
      rw [hre, h_cayley_re]
      have hz_sq : ‖z‖ ^ 2 < 1 := by nlinarith [norm_nonneg z]
      have hden_pos : 0 < ‖1 - z‖ ^ 2 := sq_pos_of_pos (norm_pos_iff.mpr h1z)
      exact mul_pos hα_pos (div_pos (by linarith) hden_pos)
