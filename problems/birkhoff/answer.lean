                pointArcPolyComp (pointArcHoloTaylor1D (g_ext v l) (x₀ v))
                  (pointArcPolyShift (fun q => β_zero_top q v))) := by
            intro n hn
            simp only [map_sum, PowerSeries.coeff_X_pow_mul']
            apply Finset.sum_congr rfl
            intro l _
            split_ifs with hln
            · by_cases hl0 : (l : ℕ) = 0
