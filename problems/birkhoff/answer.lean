              iteratedDeriv l (fun ε => ε ^ (l + 1) * Ψ ε) 0 :=
          iteratedDeriv_add (x := (0 : ℂ)) (n := l) hc_lin hc_rem
        have h3 : iteratedDeriv l (fun ε : ℂ => c * ε ^ l) 0 = (l.factorial : ℂ) * c := by
