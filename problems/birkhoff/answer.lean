        dsimp only at hv_t hXW_t
        exact (hXW_t.hasDerivAt.sub (hW_diff_at.hasDerivAt.comp t hv_t.hasDerivAt)).deriv
      have hrk_eq := (hr_rk z t (lt_of_lt_of_le hz hr₁_le_rk) (lt_of_lt_of_le ht hr₁_le_rk)).2
      change deriv (fun z' => X_Z (z', t)) z * deriv (fun t' => X_W (z, t')) t =
          deriv (fun t' => X_Z (z, t')) t * deriv (fun z' => X_W (z', t)) z at hrk_eq
      rw [hdXZ_z, hdXZ_t] at hrk_eq
      have hmul_zero : deriv G.Z_loc (v (z, t)) *
