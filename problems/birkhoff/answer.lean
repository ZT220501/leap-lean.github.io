    linarith
  have hz_all_raw := h_elim
    (fun i => sliceSpeedSeq S P.N i.val y)
    (fun i => P.d0 i y)
    (fun i => P.ℓ_slice i y)
    z I F B_inv
    (4 * Real.exp (M ^ σ)) (Real.exp (-H_star / 2)) (Real.exp (-H_star / 8))
    (Real.exp (C_inv * V_ν))
    hIF_disj (by positivity) (Real.exp_nonneg _) (Real.exp_nonneg _) (Real.exp_nonneg _)
    hz_null hB_left hM0_entry hV_on_F hDel_z hB_entry hContract_cond
  have hz_all : ∀ k : Fin P.N, ‖z k‖ ≤ Real.exp (-H_star / 16) := by
    intro k
