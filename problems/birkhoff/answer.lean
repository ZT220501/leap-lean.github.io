      have h3 : (3 : ℕ) * ((1 / 3 : ℂ) * Complex.log (PhiQ z)) = Complex.log (PhiQ z) := by ring
      rw [h3, Complex.exp_log hPhi_ne]
      norm_num
    have hlog_Phi : ‖Complex.log (PhiQ z)‖ ≤ 2 * ‖PhiQ z - 1‖ := by
      have heq : PhiQ z = 1 + (PhiQ z - 1) := by ring
      nth_rw 1 [heq]
