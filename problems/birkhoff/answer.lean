        (intervalIntegral.hasDerivAt_integral_of_dominated_loc_of_deriv_le
          (Metric.ball_mem_nhds t₀ hη_pos)
          (by filter_upwards [Metric.ball_mem_nhds t₀ hη_pos] with t ht
