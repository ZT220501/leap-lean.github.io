theorem real_chord_arc_minus_chord_identity (S : FiniteWallNonisotropicStrip)
    (hVolt : SfcaVolterraKernelProp)
    (hUniv : SfcaUniversalChordProp) :
    ∀ u v : ℝ, u < v →
      ((u : ℂ), ((v - u : ℝ) : ℂ)) ∈ smallChordDomain S sfcaEtaSL →
      ((S.c * (v - u) ^ 3 : ℝ) : ℂ) *
        sfcaStripPhi S ((u : ℂ), ((v - u : ℝ) : ℂ)) =
        (sgaRealArcMinusChord S u v : ℂ) :=
by
  intro u v huv hdom
  let h_r : ℝ := v - u
  have h_r_pos : 0 < h_r := sub_pos.mpr huv
  have h_r_ne : h_r ≠ 0 := h_r_pos.ne'
  let h : ℂ := (h_r : ℂ)
  have h_ne : h ≠ 0 := Complex.ofReal_ne_zero.mpr h_r_ne
  have hc_ne : (S.c : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr S.c_pos.ne'
  have hOpen_strip : IsOpen (horizStrip S.H) :=
    isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const
  have hf_deriv_holo : DifferentiableOn ℂ (deriv S.f) (horizStrip S.H) :=
    S.f_holo.deriv hOpen_strip
  have hreal_mem : ∀ x : ℝ, (x : ℂ) ∈ horizStrip S.H := by
    intro x
    change |(x : ℂ).im| < S.H
    simp [S.H_pos]
  have hf_re_pos : ∀ x : ℝ, 0 < (S.f (x : ℂ)).re := fun x => (S.f_real_pos x).1
  have hf_eq_re : ∀ x : ℝ, S.f (x : ℂ) = (((S.f (x : ℂ)).re : ℝ) : ℂ) := by
    intro x
    calc S.f (x : ℂ)
        = (((S.f (x : ℂ)).re : ℝ) : ℂ) + (((S.f (x : ℂ)).im : ℝ) : ℂ) * Complex.I :=
          (Complex.re_add_im (S.f (x : ℂ))).symm
      _ = (((S.f (x : ℂ)).re : ℝ) : ℂ) := by simp [(S.f_real_pos x).2]
  have hf_real_ne : ∀ x : ℝ, S.f (x : ℂ) ≠ 0 := by
    intro x
    rw [hf_eq_re x]
    exact Complex.ofReal_ne_zero.mpr (hf_re_pos x).ne'
  have hΓ_eq_re : ∀ (x : ℝ) (i : Fin 2), S.Γ (x : ℂ) i = (((S.Γ (x : ℂ) i).re : ℝ) : ℂ) := by
    intro x i
    have hconj : starRingEnd ℂ (S.Γ (x : ℂ) i) = S.Γ (x : ℂ) i := by
      have h1 := S.Γ_conj (x : ℂ) (hreal_mem x) (hf_real_ne x) i
      rw [Complex.conj_ofReal] at h1
      exact h1.symm
    have him : (S.Γ (x : ℂ) i).im = 0 := Complex.conj_eq_iff_im.mp hconj
    calc S.Γ (x : ℂ) i
        = (((S.Γ (x : ℂ) i).re : ℝ) : ℂ) + (((S.Γ (x : ℂ) i).im : ℝ) : ℂ) * Complex.I :=
          (Complex.re_add_im (S.Γ (x : ℂ) i)).symm
      _ = (((S.Γ (x : ℂ) i).re : ℝ) : ℂ) := by simp [him]
  let ξ : ℝ → ℝ := fun w => u + h_r * w
  let ζ : ℝ → ℂ := fun w => (u : ℂ) + (w : ℂ) * h
  have hζ_eq : ∀ w : ℝ, ζ w = ((ξ w : ℝ) : ℂ) := by
    intro w
    dsimp [ζ, ξ, h]
    push_cast
    ring
  have hξ_zero : ξ 0 = u := by dsimp [ξ]; ring
  have hξ_one : ξ 1 = v := by dsimp [ξ, h_r]; ring
  have hζ_zero : ζ 0 = (u : ℂ) := by rw [hζ_eq 0, hξ_zero]
  have hζ_one : ζ 1 = (v : ℂ) := by rw [hζ_eq 1, hξ_one]
  have hζ_mem : ∀ w : ℝ, ζ w ∈ horizStrip S.H := by
    intro w
    rw [hζ_eq w]
    exact hreal_mem (ξ w)
  have hζ_nhds : ∀ w : ℝ, horizStrip S.H ∈ nhds (ζ w) :=
    fun w => hOpen_strip.mem_nhds (hζ_mem w)
  have hζ_deriv : ∀ w : ℝ, HasDerivAt ζ h w := by
    intro w
    have hw : HasDerivAt (fun x : ℝ => (x : ℂ) * h) ((1 : ℂ) * h) w :=
      ((hasDerivAt_id w).ofReal_comp).mul_const h
    rw [one_mul] at hw
    exact hw.const_add (u : ℂ)
  have hζ_cont : Continuous ζ :=
    continuous_iff_continuousAt.mpr fun w => (hζ_deriv w).continuousAt
  let Q : ℝ → ℂ := sfcaStripPot S (u : ℂ) h
  have hQ_cont_all : Continuous Q :=
    continuous_const.mul (S.q_holo.continuousOn.comp_continuous hζ_cont hζ_mem)
  have hQ_cont : ContinuousOn Q (Set.Icc (0 : ℝ) 1) := hQ_cont_all.continuousOn
  let y : ℝ → ℂ := fun w => h * S.f (ζ w)
  let y' : ℝ → ℂ := fun w => h ^ 2 * deriv S.f (ζ w)
  let Φ : ℝ → ℂ := fun w => S.ϕ (ζ w) - S.ϕ (u : ℂ)
  have hΦ_zero : Φ 0 = 0 := by simp [Φ, hζ_zero]
  have hΦ_one : Φ 1 = S.ϕ (v : ℂ) - S.ϕ (u : ℂ) := by simp [Φ, hζ_one]
  have hΦ_deriv : ∀ w : ℝ, HasDerivAt Φ (y w) w := by
    intro w
    have hϕ_at : HasDerivAt S.ϕ (S.f (ζ w)) (ζ w) := by
      rw [← S.deriv_ϕ (ζ w) (hζ_mem w)]
      exact (S.ϕ_holo.differentiableAt (hζ_nhds w)).hasDerivAt
    have hcomp : HasDerivAt (fun x : ℝ => S.ϕ (ζ x)) (S.f (ζ w) * h) w :=
      HasDerivAt.comp w hϕ_at (hζ_deriv w)
    have hsub : HasDerivAt Φ (S.f (ζ w) * h - 0) w :=
      hcomp.sub (hasDerivAt_const w (S.ϕ (u : ℂ)))
    have hval : S.f (ζ w) * h - 0 = y w := by dsimp [y]; ring
    rwa [hval] at hsub
  have hy_deriv : ∀ w : ℝ, HasDerivAt y (y' w) w := by
    intro w
    have hf_at : HasDerivAt S.f (deriv S.f (ζ w)) (ζ w) :=
      (S.f_holo.differentiableAt (hζ_nhds w)).hasDerivAt
    have hcomp : HasDerivAt (fun x : ℝ => S.f (ζ x)) (deriv S.f (ζ w) * h) w :=
      HasDerivAt.comp w hf_at (hζ_deriv w)
    have hmul := hcomp.const_mul h
    have hval : h * (deriv S.f (ζ w) * h) = y' w := by dsimp [y']; ring
    rwa [hval] at hmul
  have hy'_deriv : ∀ w : ℝ, HasDerivAt y' (Q w * y w) w := by
    intro w
    have hf'_at : HasDerivAt (deriv S.f) (S.q (ζ w) * S.f (ζ w)) (ζ w) := by
      rw [← S.deriv2_f (ζ w) (hζ_mem w)]
      exact (hf_deriv_holo.differentiableAt (hζ_nhds w)).hasDerivAt
    have hcomp : HasDerivAt (fun x : ℝ => deriv S.f (ζ x)) ((S.q (ζ w) * S.f (ζ w)) * h) w :=
      HasDerivAt.comp w hf'_at (hζ_deriv w)
    have hmul := hcomp.const_mul (h ^ 2)
    have hval : h ^ 2 * ((S.q (ζ w) * S.f (ζ w)) * h) = Q w * y w := by
      dsimp [Q, sfcaStripPot, ζ, y]
      ring
    rwa [hval] at hmul
  have hy_cont : Continuous y :=
    continuous_iff_continuousAt.mpr fun w => (hy_deriv w).continuousAt
  have hy'_cont : Continuous y' :=
    continuous_iff_continuousAt.mpr fun w => (hy'_deriv w).continuousAt

  let a₀ : ℂ := h * S.f (u : ℂ)
  let a₁ : ℂ := h ^ 2 * deriv S.f (u : ℂ)
  let b₁ : ℂ := a₀ * sfcaVolterraC Q 1 + a₁ * sfcaVolterraK Q 1
  have hPhi_eq : sfcaStripPhi S ((u : ℂ), h) = sfcaDivH Q a₀ b₁ := rfl
  have ha₀_eta : ‖a₀‖ < sfcaEtaSL := hdom.2.2.1
  have ha₁_eta : ‖a₁‖ < sfcaEtaSL := hdom.2.2.2.1
  have hQ_eta : ∀ w ∈ Set.Icc (0 : ℝ) 1, ‖Q w‖ < sfcaEtaSL := hdom.2.2.2.2
  have ha₀_rho : ‖a₀‖ < sfcaRhoB := by
    have : sfcaEtaSL < sfcaRhoB := by norm_num [sfcaEtaSL, sfcaRhoB]
    exact lt_trans ha₀_eta this
  have hQ_rho : ∀ w ∈ Set.Icc (0 : ℝ) 1, ‖Q w‖ < sfcaRhoB := by
    intro w hw
    have : sfcaEtaSL < sfcaRhoB := by norm_num [sfcaEtaSL, sfcaRhoB]
    exact lt_trans (hQ_eta w hw) this
  have hQ_half : ∀ w ∈ Set.Icc (0 : ℝ) 1, ‖Q w‖ ≤ 1 / 2 := by
    intro w hw
    have : sfcaEtaSL ≤ 1 / 2 := by norm_num [sfcaEtaSL]
    exact le_trans (hQ_eta w hw).le this
  have hqb := hVolt.quant_bounds Q sfcaEtaSL hQ_cont (by norm_num [sfcaEtaSL])
    (by norm_num [sfcaEtaSL]) (fun w hw => (hQ_eta w hw).le)
  let k₀ : ℂ := sfcaVolterraK Q 1
  have hk₀_lb : 7 / 8 ≤ ‖k₀‖ := hqb.1
  have hk₀_ne : k₀ ≠ 0 := by
    intro h0
    rw [h0, norm_zero] at hk₀_lb
    norm_num at hk₀_lb
  have hone_mem : (1 : ℝ) ∈ Set.Icc (0 : ℝ) 1 := ⟨zero_le_one, le_rfl⟩
  have hC1_le : ‖sfcaVolterraC Q 1‖ ≤ 2 := by
    have h1 : ‖sfcaVolterraC Q 1 - 1‖ ≤ sfcaEtaSL := (hqb.2 1 hone_mem).1
    have h2 : ‖sfcaVolterraC Q 1‖ ≤ ‖sfcaVolterraC Q 1 - 1‖ + ‖(1 : ℂ)‖ := by
      calc ‖sfcaVolterraC Q 1‖ = ‖(sfcaVolterraC Q 1 - 1) + 1‖ := by ring_nf
        _ ≤ ‖sfcaVolterraC Q 1 - 1‖ + ‖(1 : ℂ)‖ := norm_add_le _ _
    rw [norm_one] at h2
    have h3 : sfcaEtaSL + 1 ≤ 2 := by norm_num [sfcaEtaSL]
    linarith
  have hK1_le : ‖k₀‖ ≤ 2 := by
    have h1 : ‖k₀ - ((1 : ℝ) : ℂ)‖ ≤ (1 / 4 : ℝ) * sfcaEtaSL := (hqb.2 1 hone_mem).2.1
    rw [Complex.ofReal_one] at h1
    have h2 : ‖k₀‖ ≤ ‖k₀ - 1‖ + ‖(1 : ℂ)‖ := by
      calc ‖k₀‖ = ‖(k₀ - 1) + 1‖ := by ring_nf
        _ ≤ ‖k₀ - 1‖ + ‖(1 : ℂ)‖ := norm_add_le _ _
    rw [norm_one] at h2
    have h3 : (1 / 4 : ℝ) * sfcaEtaSL + 1 ≤ 2 := by norm_num [sfcaEtaSL]
    linarith
  have hb₁_rho : ‖b₁‖ < sfcaRhoB := by
    calc ‖b₁‖
        ≤ ‖a₀ * sfcaVolterraC Q 1‖ + ‖a₁ * k₀‖ := norm_add_le _ _
      _ = ‖a₀‖ * ‖sfcaVolterraC Q 1‖ + ‖a₁‖ * ‖k₀‖ := by
          rw [norm_mul a₀, norm_mul a₁]
      _ ≤ sfcaEtaSL * 2 + sfcaEtaSL * 2 :=
          add_le_add
            (mul_le_mul ha₀_eta.le hC1_le (norm_nonneg _) (by norm_num [sfcaEtaSL]))
            (mul_le_mul ha₁_eta.le hK1_le (norm_nonneg _) (by norm_num [sfcaEtaSL]))
      _ < sfcaRhoB := by norm_num [sfcaEtaSL, sfcaRhoB]
  have hy_zero : y 0 = a₀ := by simp [y, hζ_zero, a₀]
  have hy'_zero : y' 0 = a₁ := by simp [y', hζ_zero, a₁]
  have hy_one : y 1 = h * S.f (v : ℂ) := by simp [y, hζ_one]
  have h_ode_y := hVolt.ode_unique Q y y' hQ_cont hQ_half hy_cont.continuousOn
    hy'_cont.continuousOn (fun w _ => ⟨hy_deriv w, hy'_deriv w⟩)
  have hb₁_eq_y1 : b₁ = y 1 := by
    have h1 := (h_ode_y 1 hone_mem).1
    rw [hy_zero, hy'_zero] at h1
    exact h1.symm
  have hb₁_eq : b₁ = h * S.f (v : ℂ) := hb₁_eq_y1.trans hy_one
  have hSlope_eq : sfcaSlopeA1 Q a₀ b₁ = a₁ := by
    dsimp [sfcaSlopeA1, b₁, k₀]
    have : a₀ * sfcaVolterraC Q 1 + a₁ * sfcaVolterraK Q 1 - a₀ * sfcaVolterraC Q 1 =
        a₁ * sfcaVolterraK Q 1 := by ring
    rw [this]
    exact mul_div_cancel_right₀ a₁ hk₀_ne
  have hFieldF_eq : ∀ w ∈ Set.Icc (0 : ℝ) 1, sfcaFieldF Q a₀ b₁ w = y w := by
    intro w hw
    have h1 := (h_ode_y w hw).1
    rw [hy_zero, hy'_zero] at h1
    dsimp [sfcaFieldF]
    rw [hSlope_eq, ← h1]
  have hFieldFDeriv_eq : ∀ w ∈ Set.Icc (0 : ℝ) 1, sfcaFieldFDeriv Q a₀ b₁ w = y' w := by
    intro w hw
    have h1 := (h_ode_y w hw).2
    rw [hy_zero, hy'_zero] at h1
    dsimp [sfcaFieldFDeriv]
    rw [hSlope_eq, ← h1]
  have ha₀_ne : a₀ ≠ 0 := mul_ne_zero h_ne (hf_real_ne u)
  have hb₁_ne : b₁ ≠ 0 := by
    rw [hb₁_eq]
    exact mul_ne_zero h_ne (hf_real_ne v)
  have ha₀b₁_ne : a₀ * b₁ ≠ 0 := mul_ne_zero ha₀_ne hb₁_ne
  have hy_ne : ∀ w : ℝ, y w ≠ 0 := by
    intro w
    dsimp [y]
    rw [hζ_eq w]
    exact mul_ne_zero h_ne (hf_real_ne (ξ w))

  have h_wronskian : ∀ (P g g' : ℝ → ℂ),
      ContinuousOn P (Set.Icc (0 : ℝ) 1) →
      ContinuousOn g (Set.Icc (0 : ℝ) 1) →
      ContinuousOn g' (Set.Icc (0 : ℝ) 1) →
      (∀ w ∈ Set.Icc (0 : ℝ) 1, g w ≠ 0) →
      (∀ w ∈ Set.Ioo (0 : ℝ) 1, HasDerivAt g (g' w) w ∧ HasDerivAt g' (P w * g w) w) →
      sfcaVolterraK P 1 = g 0 * g 1 * ∫ w in (0 : ℝ)..1, (g w)⁻¹ ^ 2 := by
    intro P g g' hP_c hg_c hg'_c hg_ne hg_ode
    obtain ⟨_, hk_c, _, hk'_c, _, _, _, hk_0, hk'_0, hP_ode⟩ := hVolt.ode_laws P hP_c
    let k : ℝ → ℂ := sfcaVolterraK P
    let k' : ℝ → ℂ := sfcaVolterraKDeriv P
    let W : ℝ → ℂ := fun w => g w * k' w - g' w * k w
    have hW_c : ContinuousOn W (Set.Icc (0 : ℝ) 1) :=
      (hg_c.mul hk'_c).sub (hg'_c.mul hk_c)
    have hW_0 : W 0 = g 0 := by
      dsimp [W, k, k']
      rw [hk_0, hk'_0]
      ring
    have hW_deriv : ∀ x ∈ Set.Ioo (0 : ℝ) 1, HasDerivAt W 0 x := by
      intro x hx
      have hd1 := (hg_ode x hx).1.mul (hP_ode x hx).2.2.2
      have hd2 := (hg_ode x hx).2.mul (hP_ode x hx).2.2.1
      have hd := hd1.sub hd2
      have hzero : (g' x * k' x + g x * (P x * k x)) - (P x * g x * k x + g' x * k' x) = 0 := by
        ring
      rwa [hzero] at hd
    have hW_const : ∀ w ∈ Set.Icc (0 : ℝ) 1, W w = g 0 := by
      intro w hw
      have hW_sub_c : ContinuousOn W (Set.Icc 0 w) :=
        hW_c.mono (Set.Icc_subset_Icc_right hw.2)
      have hW_sub_d : ∀ x ∈ Set.Ioo 0 w, HasDerivAt W 0 x :=
        fun x hx => hW_deriv x (Set.Ioo_subset_Ioo_right hw.2 hx)
      have hint := intervalIntegral.integral_eq_sub_of_hasDerivAt_of_le hw.1 hW_sub_c
        hW_sub_d intervalIntegrable_const
      rw [intervalIntegral.integral_zero] at hint
      exact (sub_eq_zero.mp hint.symm).trans hW_0
    let q_fn : ℝ → ℂ := fun w => k w / g w
    have hq_c : ContinuousOn q_fn (Set.Icc (0 : ℝ) 1) := hk_c.div hg_c hg_ne
    have hq_0 : q_fn 0 = 0 := by
      dsimp [q_fn, k]
      rw [hk_0, zero_div]
    let d_fn : ℝ → ℂ := fun w => g 0 * (g w)⁻¹ ^ 2
    have hd_c : ContinuousOn d_fn (Set.Icc (0 : ℝ) 1) :=
      continuousOn_const.mul ((hg_c.inv₀ hg_ne).pow 2)
    have hd_int : IntervalIntegrable d_fn MeasureTheory.volume 0 1 := by
      apply ContinuousOn.intervalIntegrable
      rwa [Set.uIcc_of_le zero_le_one]
    have hq_deriv : ∀ w ∈ Set.Ioo (0 : ℝ) 1, HasDerivAt q_fn (d_fn w) w := by
      intro w hw
      have hw_icc : w ∈ Set.Icc (0 : ℝ) 1 := Set.Ioo_subset_Icc_self hw
      have hgw_ne : g w ≠ 0 := hg_ne w hw_icc
      have hdiv := (hP_ode w hw).2.2.1.div (hg_ode w hw).1 hgw_ne
      have hval : (k' w * g w - k w * g' w) / g w ^ 2 = d_fn w := by
        have hWw : k' w * g w - k w * g' w = g 0 := by
          calc k' w * g w - k w * g' w = W w := by dsimp [W]; ring
            _ = g 0 := hW_const w hw_icc
        rw [hWw]
        dsimp [d_fn]
        rw [div_eq_mul_inv, inv_pow]
      rwa [hval] at hdiv
    have hint_q := intervalIntegral.integral_eq_sub_of_hasDerivAt_of_le zero_le_one hq_c
      hq_deriv hd_int
    rw [hq_0, sub_zero] at hint_q
    have hint_pull : (∫ w in (0 : ℝ)..1, d_fn w) = g 0 * ∫ w in (0 : ℝ)..1, (g w)⁻¹ ^ 2 := by
      dsimp [d_fn]
      exact intervalIntegral.integral_const_mul (g 0) _
    rw [hint_pull] at hint_q
    have hg1_ne : g 1 ≠ 0 := hg_ne 1 hone_mem
    calc sfcaVolterraK P 1
        = q_fn 1 * g 1 := (div_mul_cancel₀ (k 1) hg1_ne).symm
      _ = (g 0 * ∫ w in (0 : ℝ)..1, (g w)⁻¹ ^ 2) * g 1 := by rw [← hint_q]
      _ = g 0 * g 1 * ∫ w in (0 : ℝ)..1, (g w)⁻¹ ^ 2 := by ring

  let F_arc : ℝ → ℝ := fun ξ => S.c / (S.f (ξ : ℂ)).re ^ 2
  let A_arc : ℝ := ∫ ξ in u..v, F_arc ξ
  have hF_arc_cont : Continuous F_arc := by
    refine continuous_const.div ?_ ?_
    · exact (Complex.continuous_re.comp
        (S.f_holo.continuousOn.comp_continuous Complex.continuous_ofReal hreal_mem)).pow 2
    · intro ξ
      exact pow_ne_zero 2 (hf_re_pos ξ).ne'
  have hF_arc_pos : ∀ ξ : ℝ, 0 < F_arc ξ :=
    fun ξ => div_pos S.c_pos (pow_pos (hf_re_pos ξ) 2)
  have hA_arc_pos : 0 < A_arc :=
    intervalIntegral.intervalIntegral_pos_of_pos (hF_arc_cont.intervalIntegrable u v)
      hF_arc_pos huv
  have hA_arc_ne : (A_arc : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hA_arc_pos.ne'
  let C_scale : ℂ := a₀ * b₁ / ((S.c : ℂ) * h ^ 3)
  have hC_scale_ne : C_scale ≠ 0 :=
    div_ne_zero ha₀b₁_ne (mul_ne_zero hc_ne (pow_ne_zero 3 h_ne))
  have hk₀_eval : k₀ = C_scale * (A_arc : ℂ) := by
    have hk₀_wr := h_wronskian Q y y' hQ_cont hy_cont.continuousOn hy'_cont.continuousOn
      (fun w _ => hy_ne w) (fun w _ => ⟨hy_deriv w, hy'_deriv w⟩)
    have hy_inv_sq : ∀ w : ℝ,
        (y w)⁻¹ ^ 2 = (((S.c * h_r ^ 2)⁻¹ : ℝ) : ℂ) * ((F_arc (u + h_r * w) : ℝ) : ℂ) := by
      intro w
      set fw : ℝ := (S.f ((u + h_r * w : ℝ) : ℂ)).re
      have hfw_pos : 0 < fw := hf_re_pos (u + h_r * w)
      have hfw_c_ne : (fw : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hfw_pos.ne'
      have hyw : y w = (h_r : ℂ) * (fw : ℂ) := by
        calc y w
            = (h_r : ℂ) * S.f ((u + h_r * w : ℝ) : ℂ) := by
                dsimp [y, h]
                rw [hζ_eq w]
          _ = (h_r : ℂ) * (fw : ℂ) := by
                rw [hf_eq_re (u + h_r * w)]
      have hF : F_arc (u + h_r * w) = S.c / fw ^ 2 := rfl
      rw [hyw, hF]
      push_cast
      field_simp [hc_ne, h_ne, hfw_c_ne]
    have hint_y : (∫ w in (0 : ℝ)..1, (y w)⁻¹ ^ 2) =
        (((S.c * h_r ^ 2)⁻¹ : ℝ) : ℂ) * ((∫ w in (0 : ℝ)..1, F_arc (u + h_r * w) : ℝ) : ℂ) := by
      simp_rw [hy_inv_sq]
      rw [intervalIntegral.integral_const_mul, intervalIntegral.integral_ofReal]
    have h_rescale : h_r * (∫ w in (0 : ℝ)..1, F_arc (u + h_r * w)) = A_arc := by
      have hmul := intervalIntegral.mul_integral_comp_add_mul
        (f := F_arc) (a := (0 : ℝ)) (b := 1) h_r u
      have h0 : u + h_r * 0 = u := by ring
      have h1 : u + h_r * 1 = v := by dsimp [h_r]; ring
      rw [h0, h1] at hmul
      exact hmul
    have hint_real : (∫ w in (0 : ℝ)..1, F_arc (u + h_r * w)) = A_arc / h_r :=
      eq_div_of_mul_eq h_r_ne (by rw [mul_comm]; exact h_rescale)
    change sfcaVolterraK Q 1 = C_scale * (A_arc : ℂ)
    rw [hk₀_wr, hy_zero, ← hb₁_eq_y1, hint_y, hint_real]
    dsimp [C_scale, h]
    push_cast
    field_simp [hc_ne, h_ne]

  have h_gauge_eval : ∀ (ι : ℂ) (P : ℝ → ℂ),
      (ι = -Complex.I ∨ ι = Complex.I) →
      Set.EqOn P (fun w => Q w + (3 / 2 : ℂ) * ι * y' w - (1 / 4 : ℂ) * (y w) ^ 2)
        (Set.Icc (0 : ℝ) 1) →
      sfcaVolterraK P 1 =
        C_scale * Complex.exp ((ι / 2) * (S.ϕ (v : ℂ) + S.ϕ (u : ℂ))) *
          ((S.Γ (v : ℂ) 1 - S.Γ (u : ℂ) 1) + ι * (S.Γ (v : ℂ) 0 - S.Γ (u : ℂ) 0)) := by
    intro ι P hι_cases hP_eq
    have hι_sq : ι ^ 2 = -1 := by
      rcases hι_cases with rfl | rfl <;> simp [Complex.I_sq]
    have hι_trig : ∀ z : ℂ, Complex.cos z - ι * Complex.sin z = Complex.exp (-ι * z) := by
      intro z
      rcases hι_cases with rfl | rfl
      · have hexp := Complex.exp_mul_I z
        have harg : -(-Complex.I) * z = z * Complex.I := by ring
        rw [harg, hexp]
        ring
      · have hexp := Complex.exp_mul_I (-z)
        rw [Complex.cos_neg, Complex.sin_neg] at hexp
        have harg : -Complex.I * z = (-z) * Complex.I := by ring
        rw [harg, hexp]
        ring
    let E_ι : ℝ → ℂ := fun w => Complex.exp ((ι / 2) * Φ w)
    let g_ι : ℝ → ℂ := fun w => y w * E_ι w
    let g_ι' : ℝ → ℂ := fun w => (y' w + (ι / 2) * (y w) ^ 2) * E_ι w
    let P_exp : ℝ → ℂ := fun w => Q w + (3 / 2 : ℂ) * ι * y' w - (1 / 4 : ℂ) * (y w) ^ 2
    have hE_deriv : ∀ w : ℝ, HasDerivAt E_ι (E_ι w * ((ι / 2) * y w)) w :=
      fun w => HasDerivAt.comp w (Complex.hasDerivAt_exp ((ι / 2) * Φ w))
        ((hΦ_deriv w).const_mul (ι / 2))
    have hg_ι_deriv : ∀ w : ℝ, HasDerivAt g_ι (g_ι' w) w := by
      intro w
      have hd := (hy_deriv w).mul (hE_deriv w)
      have hval : y' w * E_ι w + y w * (E_ι w * ((ι / 2) * y w)) = g_ι' w := by
        dsimp [g_ι']
        ring
      rwa [hval] at hd
    have hg_ι'_deriv : ∀ w : ℝ, HasDerivAt g_ι' (P_exp w * g_ι w) w := by
      intro w
      have hd_sq : HasDerivAt (fun x : ℝ => (y x) ^ 2) (2 * y w ^ (2 - 1) * y' w) w :=
        (hy_deriv w).pow 2
      have hd_factor : HasDerivAt (fun x : ℝ => y' x + (ι / 2) * (y x) ^ 2)
          (Q w * y w + (ι / 2) * (2 * y w ^ (2 - 1) * y' w)) w :=
        (hy'_deriv w).add (hd_sq.const_mul (ι / 2))
      have hd := hd_factor.mul (hE_deriv w)
      have hval : (Q w * y w + (ι / 2) * (2 * y w ^ (2 - 1) * y' w)) * E_ι w +
          (y' w + (ι / 2) * (y w) ^ 2) * (E_ι w * ((ι / 2) * y w)) = P_exp w * g_ι w := by
        dsimp [P_exp, g_ι]
        calc (Q w * y w + (ι / 2) * (2 * y w ^ 1 * y' w)) * E_ι w +
              (y' w + (ι / 2) * (y w) ^ 2) * (E_ι w * ((ι / 2) * y w))
            = (Q w + (3 / 2 : ℂ) * ι * y' w + (1 / 4 : ℂ) * ι ^ 2 * (y w) ^ 2) *
                (y w * E_ι w) := by ring
          _ = (Q w + (3 / 2 : ℂ) * ι * y' w - (1 / 4 : ℂ) * (y w) ^ 2) * (y w * E_ι w) := by
              rw [hι_sq]; ring
      rwa [hval] at hd
    have hg_ι_cont : Continuous g_ι :=
      continuous_iff_continuousAt.mpr fun w => (hg_ι_deriv w).continuousAt
    have hg_ι'_cont : Continuous g_ι' :=
      continuous_iff_continuousAt.mpr fun w => (hg_ι'_deriv w).continuousAt
    have hP_exp_cont : Continuous P_exp :=
      (hQ_cont_all.add (continuous_const.mul hy'_cont)).sub (continuous_const.mul (hy_cont.pow 2))
    have hP_cont : ContinuousOn P (Set.Icc (0 : ℝ) 1) :=
      hP_exp_cont.continuousOn.congr hP_eq
    have hg_ι_ne : ∀ w : ℝ, g_ι w ≠ 0 :=
      fun w => mul_ne_zero (hy_ne w) (Complex.exp_ne_zero _)
    have hP_wr := h_wronskian P g_ι g_ι' hP_cont hg_ι_cont.continuousOn hg_ι'_cont.continuousOn
      (fun w _ => hg_ι_ne w) (fun w hw => by
        refine ⟨hg_ι_deriv w, ?_⟩
        have hEqw : P w = P_exp w := hP_eq (Set.Ioo_subset_Icc_self hw)
        rw [hEqw]
        exact hg_ι'_deriv w)
    let Z_ι : ℝ → ℂ := fun w => S.Γ (ζ w) 1 + ι * S.Γ (ζ w) 0
    let Prim_ι : ℝ → ℂ := fun w => (Complex.exp (ι * S.ϕ (u : ℂ)) / ((S.c : ℂ) * h ^ 3)) * Z_ι w
    have hPrim_deriv : ∀ w : ℝ, HasDerivAt Prim_ι ((g_ι w)⁻¹ ^ 2) w := by
      intro w
      have hfw_ne : S.f (ζ w) ≠ 0 := by
        rw [hζ_eq w]
        exact hf_real_ne (ξ w)
      have hEw_ne : E_ι w ≠ 0 := Complex.exp_ne_zero _
      have hΓ_reg := S.Γ_reg_holo (ζ w) (hζ_mem w) hfw_ne
      have hΓ0_at := hΓ_reg.1.hasDerivAt
      rw [S.Γ_deriv₀ (ζ w) (hζ_mem w) hfw_ne] at hΓ0_at
      have hΓ1_at := hΓ_reg.2.hasDerivAt
      rw [S.Γ_deriv₁ (ζ w) (hζ_mem w) hfw_ne] at hΓ1_at
      have hZ_d := (HasDerivAt.comp w hΓ1_at (hζ_deriv w)).add
        ((HasDerivAt.comp w hΓ0_at (hζ_deriv w)).const_mul ι)
      have hPrim_d := hZ_d.const_mul (Complex.exp (ι * S.ϕ (u : ℂ)) / ((S.c : ℂ) * h ^ 3))
      have htrig_eq :
          ((S.c : ℂ) * (S.f (ζ w))⁻¹ ^ 2 * Complex.cos (S.ϕ (ζ w))) * h +
            ι * ((-S.c * (S.f (ζ w))⁻¹ ^ 2 * Complex.sin (S.ϕ (ζ w))) * h) =
          h * (S.c : ℂ) * (S.f (ζ w))⁻¹ ^ 2 * Complex.exp (-ι * S.ϕ (ζ w)) := by
        rw [← hι_trig (S.ϕ (ζ w))]
        ring
      have hexp_prod :
          Complex.exp (ι * S.ϕ (u : ℂ)) * Complex.exp (-ι * S.ϕ (ζ w)) * (E_ι w) ^ 2 = 1 := by
        dsimp [E_ι, Φ]
        rw [sq, ← Complex.exp_add, ← Complex.exp_add, ← Complex.exp_add]
        have : ι * S.ϕ (u : ℂ) + -ι * S.ϕ (ζ w) +
            ((ι / 2) * (S.ϕ (ζ w) - S.ϕ (u : ℂ)) + (ι / 2) * (S.ϕ (ζ w) - S.ϕ (u : ℂ))) = 0 := by
          ring
        rw [this, Complex.exp_zero]
      have hE_inv_sq :
          (E_ι w)⁻¹ ^ 2 = Complex.exp (ι * S.ϕ (u : ℂ)) * Complex.exp (-ι * S.ϕ (ζ w)) := by
        apply mul_right_cancel₀ (pow_ne_zero 2 hEw_ne)
        rw [← mul_pow, inv_mul_cancel₀ hEw_ne, one_pow]
        exact hexp_prod.symm
      have hval : (Complex.exp (ι * S.ϕ (u : ℂ)) / ((S.c : ℂ) * h ^ 3)) *
          (((S.c : ℂ) * (S.f (ζ w))⁻¹ ^ 2 * Complex.cos (S.ϕ (ζ w))) * h +
            ι * ((-S.c * (S.f (ζ w))⁻¹ ^ 2 * Complex.sin (S.ϕ (ζ w))) * h)) =
          (g_ι w)⁻¹ ^ 2 := by
        rw [htrig_eq]
        dsimp [g_ι, y]
        rw [mul_inv, mul_pow, hE_inv_sq]
        field_simp [hc_ne, h_ne, hfw_ne]
      rw [hval] at hPrim_d
      exact hPrim_d
    have hg_ι_inv_int : IntervalIntegrable (fun w => (g_ι w)⁻¹ ^ 2) MeasureTheory.volume 0 1 := by
      apply ContinuousOn.intervalIntegrable
      rw [Set.uIcc_of_le zero_le_one]
      exact (hg_ι_cont.continuousOn.inv₀ (fun w _ => hg_ι_ne w)).pow 2
    have hint_g := intervalIntegral.integral_eq_sub_of_hasDerivAt
      (fun w _ => hPrim_deriv w) hg_ι_inv_int
    have hg0_eq : g_ι 0 = a₀ := by
      dsimp [g_ι, E_ι]
      rw [hy_zero, hΦ_zero, mul_zero, Complex.exp_zero, mul_one]
    have hg1_eq : g_ι 1 = b₁ * Complex.exp ((ι / 2) * (S.ϕ (v : ℂ) - S.ϕ (u : ℂ))) := by
      dsimp [g_ι, E_ι]
      rw [← hb₁_eq_y1, hΦ_one]
    have hPrim_diff : Prim_ι 1 - Prim_ι 0 =
        (Complex.exp (ι * S.ϕ (u : ℂ)) / ((S.c : ℂ) * h ^ 3)) *
          ((S.Γ (v : ℂ) 1 - S.Γ (u : ℂ) 1) + ι * (S.Γ (v : ℂ) 0 - S.Γ (u : ℂ) 0)) := by
      dsimp [Prim_ι, Z_ι]
      rw [hζ_one, hζ_zero]
      ring
    have hexp_merge :
        Complex.exp ((ι / 2) * (S.ϕ (v : ℂ) - S.ϕ (u : ℂ))) * Complex.exp (ι * S.ϕ (u : ℂ)) =
          Complex.exp ((ι / 2) * (S.ϕ (v : ℂ) + S.ϕ (u : ℂ))) := by
      rw [← Complex.exp_add]
      congr 1
      ring
    rw [hP_wr, hg0_eq, hg1_eq, hint_g, hPrim_diff]
    dsimp [C_scale]
    calc a₀ * (b₁ * Complex.exp ((ι / 2) * (S.ϕ (v : ℂ) - S.ϕ (u : ℂ)))) *
          ((Complex.exp (ι * S.ϕ (u : ℂ)) / ((S.c : ℂ) * h ^ 3)) *
            ((S.Γ (v : ℂ) 1 - S.Γ (u : ℂ) 1) + ι * (S.Γ (v : ℂ) 0 - S.Γ (u : ℂ) 0)))
        = (a₀ * b₁ / ((S.c : ℂ) * h ^ 3)) *
            (Complex.exp ((ι / 2) * (S.ϕ (v : ℂ) - S.ϕ (u : ℂ))) * Complex.exp (ι * S.ϕ (u : ℂ))) *
            ((S.Γ (v : ℂ) 1 - S.Γ (u : ℂ) 1) + ι * (S.Γ (v : ℂ) 0 - S.Γ (u : ℂ) 0)) := by ring
      _ = (a₀ * b₁ / ((S.c : ℂ) * h ^ 3)) *
            Complex.exp ((ι / 2) * (S.ϕ (v : ℂ) + S.ϕ (u : ℂ))) *
            ((S.Γ (v : ℂ) 1 - S.Γ (u : ℂ) 1) + ι * (S.Γ (v : ℂ) 0 - S.Γ (u : ℂ) 0)) := by
          rw [hexp_merge]

  let k_p : ℂ := sfcaVolterraK (sfcaPotPlus Q a₀ b₁) 1
  let k_m : ℂ := sfcaVolterraK (sfcaPotMinus Q a₀ b₁) 1
  have hk_p_eval : k_p =
      C_scale * Complex.exp ((-Complex.I / 2) * (S.ϕ (v : ℂ) + S.ϕ (u : ℂ))) *
        ((S.Γ (v : ℂ) 1 - S.Γ (u : ℂ) 1) + (-Complex.I) * (S.Γ (v : ℂ) 0 - S.Γ (u : ℂ) 0)) := by
    apply h_gauge_eval (-Complex.I) (sfcaPotPlus Q a₀ b₁) (Or.inl rfl)
    intro w hw
    dsimp [sfcaPotPlus]
    rw [hFieldF_eq w hw, hFieldFDeriv_eq w hw]
    ring
  have hk_m_eval : k_m =
      C_scale * Complex.exp ((Complex.I / 2) * (S.ϕ (v : ℂ) + S.ϕ (u : ℂ))) *
        ((S.Γ (v : ℂ) 1 - S.Γ (u : ℂ) 1) + Complex.I * (S.Γ (v : ℂ) 0 - S.Γ (u : ℂ) 0)) := by
    apply h_gauge_eval Complex.I (sfcaPotMinus Q a₀ b₁) (Or.inr rfl)
    intro w hw
    dsimp [sfcaPotMinus]
    rw [hFieldF_eq w hw, hFieldFDeriv_eq w hw]
  let ΔΓ₀ : ℝ := (S.Γ (v : ℂ) 0).re - (S.Γ (u : ℂ) 0).re
  let ΔΓ₁ : ℝ := (S.Γ (v : ℂ) 1).re - (S.Γ (u : ℂ) 1).re
  let L_chord : ℝ := Real.sqrt (ΔΓ₀ ^ 2 + ΔΓ₁ ^ 2)
  have hL_chord_nonneg : 0 ≤ L_chord := Real.sqrt_nonneg _
  have hL_chord_sq : L_chord ^ 2 = ΔΓ₀ ^ 2 + ΔΓ₁ ^ 2 :=
    Real.sq_sqrt (add_nonneg (sq_nonneg ΔΓ₀) (sq_nonneg ΔΓ₁))
  have hkp_km : k_p * k_m = C_scale ^ 2 * ((L_chord ^ 2 : ℝ) : ℂ) := by
    have hexp_cancel :
        Complex.exp ((-Complex.I / 2) * (S.ϕ (v : ℂ) + S.ϕ (u : ℂ))) *
          Complex.exp ((Complex.I / 2) * (S.ϕ (v : ℂ) + S.ϕ (u : ℂ))) = 1 := by
      rw [← Complex.exp_add]
      have : (-Complex.I / 2) * (S.ϕ (v : ℂ) + S.ϕ (u : ℂ)) +
          (Complex.I / 2) * (S.ϕ (v : ℂ) + S.ϕ (u : ℂ)) = 0 := by ring
      rw [this, Complex.exp_zero]
    have hΔ0 : S.Γ (v : ℂ) 0 - S.Γ (u : ℂ) 0 = (ΔΓ₀ : ℂ) :=
      (congr_arg₂ (· - ·) (hΓ_eq_re v 0) (hΓ_eq_re u 0)).trans (Complex.ofReal_sub _ _).symm
    have hΔ1 : S.Γ (v : ℂ) 1 - S.Γ (u : ℂ) 1 = (ΔΓ₁ : ℂ) :=
      (congr_arg₂ (· - ·) (hΓ_eq_re v 1) (hΓ_eq_re u 1)).trans (Complex.ofReal_sub _ _).symm
    have hnorm_sq :
        ((ΔΓ₁ : ℂ) + (-Complex.I) * (ΔΓ₀ : ℂ)) * ((ΔΓ₁ : ℂ) + Complex.I * (ΔΓ₀ : ℂ)) =
          ((L_chord ^ 2 : ℝ) : ℂ) := by
      calc ((ΔΓ₁ : ℂ) + (-Complex.I) * (ΔΓ₀ : ℂ)) * ((ΔΓ₁ : ℂ) + Complex.I * (ΔΓ₀ : ℂ))
          = (ΔΓ₁ : ℂ) ^ 2 - Complex.I ^ 2 * (ΔΓ₀ : ℂ) ^ 2 := by ring
        _ = (ΔΓ₀ : ℂ) ^ 2 + (ΔΓ₁ : ℂ) ^ 2 := by rw [Complex.I_sq]; ring
        _ = ((ΔΓ₀ ^ 2 + ΔΓ₁ ^ 2 : ℝ) : ℂ) := by norm_cast
        _ = ((L_chord ^ 2 : ℝ) : ℂ) := by rw [hL_chord_sq]
    rw [hk_p_eval, hk_m_eval, hΔ0, hΔ1]
    calc (C_scale * Complex.exp ((-Complex.I / 2) * (S.ϕ (v : ℂ) + S.ϕ (u : ℂ))) *
            ((ΔΓ₁ : ℂ) + (-Complex.I) * (ΔΓ₀ : ℂ))) *
          (C_scale * Complex.exp ((Complex.I / 2) * (S.ϕ (v : ℂ) + S.ϕ (u : ℂ))) *
            ((ΔΓ₁ : ℂ) + Complex.I * (ΔΓ₀ : ℂ)))
        = C_scale ^ 2 *
            (Complex.exp ((-Complex.I / 2) * (S.ϕ (v : ℂ) + S.ϕ (u : ℂ))) *
              Complex.exp ((Complex.I / 2) * (S.ϕ (v : ℂ) + S.ϕ (u : ℂ)))) *
            (((ΔΓ₁ : ℂ) + (-Complex.I) * (ΔΓ₀ : ℂ)) *
              ((ΔΓ₁ : ℂ) + Complex.I * (ΔΓ₀ : ℂ))) := by ring
      _ = C_scale ^ 2 * ((L_chord ^ 2 : ℝ) : ℂ) := by rw [hexp_cancel, hnorm_sq]; ring

  let r : ℝ := L_chord / A_arc
  have hr_nonneg : 0 ≤ r := div_nonneg hL_chord_nonneg hA_arc_pos.le
  have hratio_eq : k_p * k_m / k₀ ^ 2 = ((r ^ 2 : ℝ) : ℂ) := by
    rw [hkp_km, hk₀_eval]
    change C_scale ^ 2 * ((L_chord ^ 2 : ℝ) : ℂ) / (C_scale * (A_arc : ℂ)) ^ 2 =
      (((L_chord / A_arc) ^ 2 : ℝ) : ℂ)
    rw [Complex.ofReal_pow, Complex.ofReal_pow, Complex.ofReal_div]
    field_simp [hC_scale_ne, hA_arc_ne]
  have hUniv_q := (hUniv.div_and_slit Q hQ_cont hQ_rho).2 a₀ b₁ ha₀_rho hb₁_rho
  have hre_gt : 1 / 4 < (k_p * k_m / k₀ ^ 2).re := hUniv_q.1
  have hdiv_eq : a₀ * b₁ * sfcaDivH Q a₀ b₁ = sfcaNumN Q a₀ b₁ := hUniv_q.2.1
  have hr_sq_gt : 1 / 4 < r ^ 2 := by
    rw [hratio_eq, Complex.ofReal_re] at hre_gt
    exact hre_gt
  have hr_ne_zero : r ≠ 0 := by
    intro hr0
    rw [hr0] at hr_sq_gt
    norm_num at hr_sq_gt
  have hr_pos : 0 < r := lt_of_le_of_ne hr_nonneg (Ne.symm hr_ne_zero)
  have hsqrt_eval : Complex.exp ((1 / 2 : ℂ) * Complex.log (k_p * k_m / k₀ ^ 2)) = (r : ℂ) := by
    rw [hratio_eq, ← Complex.ofReal_log (sq_nonneg r)]
    have hhalf : (1 / 2 : ℂ) * ((Real.log (r ^ 2) : ℝ) : ℂ) = ((Real.log r : ℝ) : ℂ) := by
      rw [Real.log_pow]
      push_cast
      ring
    rw [hhalf, ← Complex.ofReal_exp, Real.exp_log hr_pos]
  have hNum_eval : sfcaNumN Q a₀ b₁ =
      C_scale * (sgaRealArcMinusChord S u v : ℂ) := by
    change k₀ * (1 - Complex.exp ((1 / 2 : ℂ) * Complex.log (k_p * k_m / k₀ ^ 2))) =
      C_scale * (sgaRealArcMinusChord S u v : ℂ)
    rw [hsqrt_eval, hk₀_eval]
    have hsga_eq : A_arc * (1 - r) = sgaRealArcMinusChord S u v := by
      have h1 : A_arc * (1 - L_chord / A_arc) = A_arc - L_chord := by
        field_simp [hA_arc_pos.ne']
      exact h1
    calc C_scale * (A_arc : ℂ) * (1 - (r : ℂ))
        = C_scale * ((A_arc : ℂ) * ((1 : ℂ) - (r : ℂ))) := by ring
      _ = C_scale * ((A_arc * (1 - r) : ℝ) : ℂ) := by
          rw [Complex.ofReal_mul, Complex.ofReal_sub, Complex.ofReal_one]
      _ = C_scale * (sgaRealArcMinusChord S u v : ℂ) := by rw [hsga_eq]
  have hsc_pow : ((S.c * (v - u) ^ 3 : ℝ) : ℂ) = (S.c : ℂ) * h ^ 3 := by
    dsimp [h, h_r]
    push_cast
    ring
  apply mul_left_cancel₀ ha₀b₁_ne
  calc a₀ * b₁ * (((S.c * (v - u) ^ 3 : ℝ) : ℂ) * sfcaStripPhi S ((u : ℂ), h))
      = ((S.c * (v - u) ^ 3 : ℝ) : ℂ) * (a₀ * b₁ * sfcaDivH Q a₀ b₁) := by
          rw [hPhi_eq]
          ring
    _ = ((S.c : ℂ) * h ^ 3) * (C_scale * (sgaRealArcMinusChord S u v : ℂ)) := by
          rw [hsc_pow, hdiv_eq, hNum_eval]
    _ = a₀ * b₁ * (sgaRealArcMinusChord S u v : ℂ) := by
          dsimp [C_scale]
          field_simp [hc_ne, h_ne]

theorem real_collar_stationary_action_recurrence (S : FiniteWallNonisotropicStrip)
    (hOpen : IsOpen (smallChordDomain S sfcaEtaSL))
    (hHolo : DifferentiableOn ℂ (sfcaStripPhi S) (smallChordDomain S sfcaEtaSL))
    (hGeom : ∀ u v : ℝ, u < v →
      ((u : ℂ), ((v - u : ℝ) : ℂ)) ∈ smallChordDomain S sfcaEtaSL →
      ((S.c * (v - u) ^ 3 : ℝ) : ℂ) *
        sfcaStripPhi S ((u : ℂ), ((v - u : ℝ) : ℂ)) =
        (sgaRealArcMinusChord S u v : ℂ)) :
    ∀ x t : ℝ, 0 < t → t < S.r_star →
      (S.𝔰 ((x : ℂ) - (t : ℂ), (t : ℂ)),
        S.𝔰 ((x : ℂ), (t : ℂ)) - S.𝔰 ((x : ℂ) - (t : ℂ), (t : ℂ))) ∈
          smallChordDomain S sfcaEtaSL →
      (S.𝔰 ((x : ℂ), (t : ℂ)),
        S.𝔰 ((x : ℂ) + (t : ℂ), (t : ℂ)) - S.𝔰 ((x : ℂ), (t : ℂ))) ∈
          smallChordDomain S sfcaEtaSL →
      let s_m := S.𝔰 ((x : ℂ) - (t : ℂ), (t : ℂ))
      let s_0 := S.𝔰 ((x : ℂ), (t : ℂ))
      let s_p := S.𝔰 ((x : ℂ) + (t : ℂ), (t : ℂ))
      let J_m := (s_0 - s_m) / (t : ℂ)
      let J_p := (s_p - s_0) / (t : ℂ)
      deriv (fun J' => smallChordActionP (sfcaStripPhi S) s_0 J' (t : ℂ)) J_p -
        (t : ℂ) * deriv (fun s' => smallChordActionP (sfcaStripPhi S) s' J_p (t : ℂ)) s_0 =
        deriv (fun J' => smallChordActionP (sfcaStripPhi S) s_m J' (t : ℂ)) J_m :=
by
  intro x t ht_pos ht_lt hdom_m hdom_p s_m s_0 s_p J_m J_p
  have ht_ne : t ≠ 0 := ht_pos.ne'
  have ht_ℂ_ne : (t : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr ht_ne
  
  have hξ_strip : ∀ ξ : ℝ, (ξ : ℂ) ∈ horizStrip S.H := by
    intro ξ
    simp [horizStrip, S.H_pos]
  have hf_re_pos : ∀ ξ : ℝ, 0 < (S.f (ξ : ℂ)).re :=
    fun ξ => (S.f_real_pos ξ).1
  have hf_real : ∀ ξ : ℝ, (((S.f (ξ : ℂ)).re : ℝ) : ℂ) = S.f (ξ : ℂ) := by
    intro ξ
    apply Complex.ext
    · simp
    · simp [(S.f_real_pos ξ).2]
  have hf_ne : ∀ ξ : ℝ, S.f (ξ : ℂ) ≠ 0 := by
    intro ξ h0
    have hpos := hf_re_pos ξ
    rw [h0] at hpos
    norm_num at hpos
  have hϕ_real : ∀ ξ : ℝ, (((S.ϕ (ξ : ℂ)).re : ℝ) : ℂ) = S.ϕ (ξ : ℂ) := by
    intro ξ
