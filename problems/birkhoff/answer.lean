      len_jet_split := by
        intro q _ l hl1
        rcases hln : (l : ℕ) with _ | m
        · omega
        · have hfn :
              (fun ε : ℂ =>
                pointRelChainLen (fun i => G.ℓ_fn i q)
                  (pointArcPertGraph (J := p₀) G.F (fun _ _ _ => 0) ε)
                  (pointArcPertAbscissa (J := p₀) (fun s => G.x_fn s q) (fun _ _ => 0) ε)) =
