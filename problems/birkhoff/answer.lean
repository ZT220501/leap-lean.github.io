    have hStripDisk_bound : ∀ (s s_mid d : ℝ) (F : ℂ × ℂ → ℂ),
        0 < s_mid → s_mid < s → 0 < d →
        DifferentiableOn ℂ F (glancingDomain 1 s d) →
        (∀ y t : ℂ, (y, t) ∈ glancingDomain 1 s d → F (y + 2 * Real.pi, t) = F (y, t)) →
        ∃ (r_t M_sup : ℝ),
          0 < r_t ∧ r_t ≤ d / 4 ∧ 2 * r_t < d ∧
          0 < M_sup ∧
          (∀ y : ℂ, |y.im| < s_mid → ∀ t : ℂ, ‖t‖ < 2 * r_t →
            (y, t) ∈ glancingDomain 1 s d ∧ ‖F (y, t)‖ ≤ M_sup) := by
      intro s s_mid d F hs_mid_pos hs_lt hd_pos hF_holo hF_per
      let r_t : ℝ := min (d / 4) ((s - s_mid) / 8)
      have hr_t_pos : 0 < r_t := lt_min (by positivity) (by linarith)
      have hr_t_le_d4 : r_t ≤ d / 4 := min_le_left _ _
      have hr_t_le_s8 : r_t ≤ (s - s_mid) / 8 := min_le_right _ _
      have h2r_lt_d : 2 * r_t < d := by linarith
      let K : Set (ℂ × ℂ) :=
        { p : ℂ × ℂ | p.1.re ∈ Set.Icc (0 : ℝ) (2 * Real.pi) ∧ |p.1.im| ≤ s_mid ∧ ‖p.2‖ ≤ 2 * r_t }
      have hK_closed : IsClosed K :=
        (isClosed_Icc.preimage (Complex.continuous_re.comp continuous_fst)).inter
          ((isClosed_le (continuous_abs.comp (Complex.continuous_im.comp continuous_fst)) continuous_const).inter
            (isClosed_le (continuous_norm.comp continuous_snd) continuous_const))
      have hK_bdd : Bornology.IsBounded K := by
        refine Bornology.IsBounded.subset (Metric.isBounded_closedBall (x := (0 : ℂ × ℂ))
          (r := 2 * Real.pi + s_mid + 2 * r_t)) ?_
        intro p hp
        rw [Metric.mem_closedBall, dist_zero_right, Prod.norm_def]
        refine max_le ?_ (by linarith [hp.2.2, Real.pi_pos, hs_mid_pos])
        have hre : |p.1.re| ≤ 2 * Real.pi := by rw [abs_of_nonneg hp.1.1]; exact hp.1.2
        have h1 := Complex.norm_le_abs_re_add_abs_im p.1
        linarith [hp.2.1, hr_t_pos]
      have hK_compact : IsCompact K := Metric.isCompact_of_isClosed_isBounded hK_closed hK_bdd
      have hK_sub : K ⊆ glancingDomain 1 s d := by
        intro p hp
        refine ⟨lt_of_le_of_lt hp.2.2 h2r_lt_d, ?_⟩
        have him2 : |p.2.im| ≤ 2 * r_t := (Complex.abs_im_le_norm p.2).trans hp.2.2
        linarith [hp.2.1]
      obtain ⟨p_max, -, hp_max⟩ := hK_compact.exists_isMaxOn
        ⟨(0, 0), ⟨⟨by norm_num, by positivity⟩, by simp [hs_mid_pos.le], by simp [hr_t_pos.le]⟩⟩
        (continuous_norm.comp_continuousOn (hF_holo.continuousOn.mono hK_sub))
      let M_sup : ℝ := 1 + ‖F p_max‖
      have hM_sup_pos : 0 < M_sup := by positivity
      refine ⟨r_t, M_sup, hr_t_pos, hr_t_le_d4, h2r_lt_d, hM_sup_pos, fun y hy t ht => ?_⟩
      have hmem : (y, t) ∈ glancingDomain 1 s d := by
        refine ⟨ht.trans h2r_lt_d, ?_⟩
        have him_t : |t.im| ≤ 2 * r_t := (Complex.abs_im_le_norm t).trans ht.le
        linarith
      refine ⟨hmem, ?_⟩
      have h2pi_pos : (0 : ℝ) < 2 * Real.pi := by positivity
      let k : ℤ := Int.floor (y.re / (2 * Real.pi))
      let y₀ : ℂ := y - (((k : ℝ) * (2 * Real.pi) : ℝ) : ℂ)
      have hy₀_im : y₀.im = y.im := by simp [y₀]
      have hy₀_re : y₀.re ∈ Set.Icc (0 : ℝ) (2 * Real.pi) := by
        have hre_eq : y₀.re = y.re - (k : ℝ) * (2 * Real.pi) := by simp [y₀]
        rw [hre_eq]
