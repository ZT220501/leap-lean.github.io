            unfold lcJetEdgePlus2D lcJetEdgeMinus2D
            rw [hψ_split, hd_split]
            change MvPowerSeries.coeff d ((P1 * Q1 + P2 * Q2) - (P1_0 * Q1_0 + P2_0 * Q2_0)) = _ ∧
              MvPowerSeries.coeff d ((P1 * Q1 - P2 * Q2) - (P1_0 * Q1_0 - P2_0 * Q2_0)) = _
            constructor
            · have h_lin : MvPowerSeries.coeff d ((P1 * Q1 + P2 * Q2) - (P1_0 * Q1_0 + P2_0 * Q2_0)) =
