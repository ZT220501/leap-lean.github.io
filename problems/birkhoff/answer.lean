        rw [hid]
        exact h_vb_C_mul _ (h_vb_add hR_DX2_vb hR_DY2_vb)
      have hηU_vb : pointCoreVanishesBelow N₀ η_U := by
        have hid : η_U = L_U + R_U := by dsimp only [R_U]; ring
        have hLU_vb : pointCoreVanishesBelow N₀ L_U := by
