          Polynomial.rootMultiplicity (z + c) A := by
      intro A c z hA
      apply (Polynomial.le_rootMultiplicity_iff hA).mpr
      obtain ⟨H, hH⟩ := Polynomial.pow_rootMultiplicity_dvd (A.comp (Polynomial.X + Polynomial.C c)) z
