        have h1 := congr_arg (π 1) hsum
        have h0 : π 1 0 = 0 := by ext m; simp [π]
        have hX01 : π 1 (MvPowerSeries.X 0 + MvPowerSeries.X 1) = PowerSeries.X := by
          rw [hπ_add, hπ1_X0, hπ_Xi 1, zero_add]
        rw [hπ_add, hπ1_U, hπ_comp_X 1 V _ hX01, zero_add, h0] at h1
        exact h1
      have hU_eq : U = 0 := by
        have hcomp_zero : compPowerSeries2D (0 : PowerSeries ℂ)
