  have hSqrt_sq_on : ∀ u ∈ B_half, (sqrt1p u) ^ 2 = 1 + u := by
    intro u hu
    calc (sqrt1p u) ^ 2
        = Complex.exp (Complex.log (1 + u) / 2) * Complex.exp (Complex.log (1 + u) / 2) := sq _
      _ = Complex.exp (Complex.log (1 + u) / 2 + Complex.log (1 + u) / 2) :=
