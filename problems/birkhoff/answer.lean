          split_ifs with h
          · exact he_top_holo
          · exact he_holo j (by omega)
        · intro j hj t ht
          dsimp only [e_next]
          split_ifs with h
          · subst h
            dsimp only [e_top]
            rw [hR_newton_rec (L_t t ht) N]
            congr 1
            refine Finset.sum_congr rfl ?_
            intro i hi
            rw [Finset.mem_range] at hi
            rw [he_eq i (by omega) t ht, hp_fn_eval (N + 1 - i) t ht]
          · exact he_eq j (by omega) t ht
