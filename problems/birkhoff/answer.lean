              skrExp1 (H₁ z * ((κ : ℂ) * skrSlopeW W₁ z c (H₁ z))))
            (fun z => ((κ : ℂ) * skrSlopeW W₂ z c (H₂ z)) *
              skrExp1 (H₂ z * ((κ : ℂ) * skrSlopeW W₂ z c (H₂ z)))) := by
    let B_sw : ℝ := 2 * B_sl
    let L_sw : ℝ := 2 * L_sl
