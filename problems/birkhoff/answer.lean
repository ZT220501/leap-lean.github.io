        rw [← hL_eq]
        exact (ht1.smul_const _).add (ht2.smul_const _)
      have hfderiv_meas : MeasureTheory.AEStronglyMeasurable (fun μ => fderiv ℂ (Φ μ) p₀) μ₀ := by
        refine aestronglyMeasurable_of_tendsto_ae Filter.atTop hg_meas ?_
        filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_uIoc] with μ hμ
