    have hu_pos : 0 < u := by dsimp [u]; linarith [B.ε_patch_lt_ν, B.ν'_pos]
    have hu_lt_ν : u < M.ν := by dsimp [u]; linarith [B.ε_patch_lt_ν, B.ν'_pos, B.ν'_lt]
    have hu_gt_neg4 : -4 * M.ν < u := by linarith [M.ν_pos]
    have hu_lt_2ν : u < 2 * M.ν := by linarith [M.ν_pos]
