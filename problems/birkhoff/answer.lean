            have hτ_tend : Filter.Tendsto τ_seq Filter.atTop (nhds 0) := by
              have hreal : Filter.Tendsto (fun n : ℕ => r_t / ((n : ℝ) + 2)) Filter.atTop (nhds 0) :=
                tendsto_const_nhds.div_atTop
                  (Filter.tendsto_atTop_add_const_right Filter.atTop 2 tendsto_natCast_atTop_atTop)
