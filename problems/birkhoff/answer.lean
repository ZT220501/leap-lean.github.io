    obtain ⟨_, ht₁_9, ht₁_0, ht₁_2, _, _⟩ := h_step_enc X₁ hX₁ (j + 1) hj
    obtain ⟨_, hs₁_9, hs₁_0, hs₁_2, _, _⟩ := h_step_enc X₁ hX₁ j hj0
