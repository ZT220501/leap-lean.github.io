          (∑ r ∈ Finset.range β, (β.choose r : ℂ) * term (r + 1)) +
          (∑ r ∈ Finset.range β, (β.choose (r + 1) : ℂ) * term (r + 1)) =
          ∑ r ∈ Finset.range β, ((β + 1).choose (r + 1) : ℂ) * term (r + 1) := by
        rw [← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl (fun r _ => ?_)
        rw [← add_mul]
        congr 1
        exact_mod_cast (Nat.choose_succ_succ β r).symm
      calc
        ((∑ r ∈ Finset.range β, (β.choose r : ℂ) * term (r + 1)) + (β.choose β : ℂ) * term (β + 1)) +
            ((∑ r ∈ Finset.range β, (β.choose (r + 1) : ℂ) * term (r + 1)) + (β.choose 0 : ℂ) * term 0)
            = ((∑ r ∈ Finset.range β, (β.choose r : ℂ) * term (r + 1)) +
                (∑ r ∈ Finset.range β, (β.choose (r + 1) : ℂ) * term (r + 1))) +
                (β.choose 0 : ℂ) * term 0 + (β.choose β : ℂ) * term (β + 1) := by ring
        _ = ((∑ r ∈ Finset.range β, ((β + 1).choose (r + 1) : ℂ) * term (r + 1)) +
              ((β + 1).choose 0 : ℂ) * term 0) +
              ((β + 1).choose (β + 1) : ℂ) * term (β + 1) := by
            rw [h_mid]
            simp
        _ = ∑ k ∈ Finset.range (β + 1 + 1), ((β + 1).choose k : ℂ) * term k := by
            rw [← Finset.sum_range_succ' (fun k => ((β + 1).choose k : ℂ) * term k) β,
              ← Finset.sum_range_succ (fun k => ((β + 1).choose k : ℂ) * term k) (β + 1)]
        _ = _ := Finset.sum_congr rfl (fun k _ => by dsimp only [term, g]; ring)
  let Ψ : ℤ → ∀ M : ℕ, LineJetVar M → MvPolynomial (LineJetVar (2 * M)) ℂ :=
    fun m M v =>
      ∑ r ∈ (Finset.range (v.2.2.2.1 + 1)).attach,
