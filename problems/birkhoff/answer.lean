      let c_j : ℂ → ℂ := fun y => glancingIterDslopeAtZero (2 * j) (fun τ => F (y, τ)) 0
      let B2j : ℝ := M_sup / R ^ (2 * j)
      have hB2j_pos : 0 < B2j := by positivity
      have hD2j_eq : ∀ y ∈ horizStrip s_mid, ∀ τ : ℂ,
