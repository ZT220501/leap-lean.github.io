    split_ifs with hex
    · have h_ch := Classical.choose_spec hex
      exact h_overlap_eq n hn (Classical.choose hex) c q.1 q.2 hq.1 h_ch.2 hq.2
    · exact False.elim (hex ⟨c, hq⟩)
  have hS₁_low_eq : ∀ n ≥ N_glue, ∀ q ∈ R_low ×ˢ U_T_open,
      S₁ n q = S_prev n q := by
    intro n hn q hq
    rcases Set.mem_iUnion.mp hq.2 with ⟨c, hqc⟩
    rw [hS₁_eq_Sc n hn c q ⟨hRlow_sub_R1 hq.1, hqc⟩]
    exact hSc_low_eq c n hn q ⟨hq.1, hqc⟩
  have hS₁_holo_open : ∀ n ≥ N_glue, DifferentiableOn ℂ (S₁ n) (R_1_full ×ˢ U_T_open) := by
    intro n hn q hq
    rcases Set.mem_iUnion.mp hq.2 with ⟨c, hqc⟩
    let V : Set (ℂ × ℂ) := R_1_full ×ˢ B_c c.1
    have hV_open : IsOpen V := hR1_open.prod Metric.isOpen_ball
    have hqV : q ∈ V := ⟨hq.1, hqc⟩
    have hSc_at : DifferentiableAt ℂ (S_c c n) q :=
      (hSc_holo c n (le_trans (hNc_le_glue c) hn)).differentiableAt (hV_open.mem_nhds hqV)
    have hev : S₁ n =ᶠ[nhds q] S_c c n :=
      Filter.eventuallyEq_of_mem (hV_open.mem_nhds hqV) (fun p hp => hS₁_eq_Sc n hn c p hp)
    exact (hSc_at.congr_of_eventuallyEq hev).differentiableWithinAt
  have hS₁_conv_open :
      TendstoUniformlyOn S₁ (expShearedInnerModel seq M) Filter.atTop
        (R_1_full ×ˢ U_T_open) := by
    rw [Metric.tendstoUniformlyOn_iff]
    intro ε hε
    have h_each : ∀ c : ↥t_fin, ∃ N_ε : ℕ, ∀ n ≥ N_ε, ∀ q ∈ R_1_full ×ˢ B_c c.1,
        dist (expShearedInnerModel seq M q) (S_c c n q) < ε := by
      intro c
      exact Filter.eventually_atTop.mp
        (Metric.tendstoUniformlyOn_iff.mp (hSc_conv c) ε hε)
    choose N_ε hN_ε using h_each
    refine Filter.eventually_atTop.mpr ⟨max N_glue (Finset.univ.sup N_ε), ?_⟩
    intro n hn q hq
    rcases Set.mem_iUnion.mp hq.2 with ⟨c, hqc⟩
    have hn_glue : N_glue ≤ n := le_trans (le_max_left _ _) hn
    have hn_c : N_ε c ≤ n :=
      le_trans (Finset.le_sup (Finset.mem_univ c)) (le_trans (le_max_right _ _) hn)
    rw [hS₁_eq_Sc n hn_glue c q ⟨hq.1, hqc⟩]
    exact hN_ε c n hn_c q ⟨hq.1, hqc⟩
  
  let δ_r : ℝ := ν' / 8
  have hδ_r_pos : 0 < δ_r := by dsimp [δ_r]; positivity
  obtain ⟨N₁, hN₁_ge_glue, hN₁_rec⟩ :=
    hRec (expShearedInnerDomain seq M) (expShearedInnerModel seq M)
      T_max U_T_open K_1
      (-X₁) X₁ H_1_bot H_1_top H_cut_0 δ_r
      N_glue S₁
      hBridge.inner_model_reg hT_max_pos hδ_r_pos
      hUT_open_isOpen (isCompact_closedBall _ _) hK1_sub_Uopen
      (by
        intro T hT
        rcases hBridge.shear_holo_bounds.2 T (hUopen_sub_Uall hT) with ⟨hT_ne, hT_norm, _, _⟩
        exact ⟨hT_ne, hT_norm⟩)
      (by dsimp [δ_r]; linarith)
      (by dsimp [δ_r, H_1_top]; linarith)
      (by dsimp [δ_r]; linarith)
      (by dsimp [H_1_top]; linarith)
      (by
        intro p hp
        have hT_dist : ‖p.2 - (T_star : ℂ)‖ < (15 / 32 : ℝ) * T_star := by
          simpa [U_T_all, Metric.mem_ball, dist_eq_norm] using hUopen_sub_Uall hp.2
        have hY_im : p.1.im < Real.log M.R := by
          have h1 : p.1.im < H_1_top := hp.1.2.2.2
          dsimp [H_1_top] at h1
          linarith
        exact hBridge.mem_inner_of_lt_log_R p.1 p.2 hT_dist hY_im)
      hS₁_holo_open
      (fun K _ hK_sub => hS₁_conv_open.mono hK_sub)
      (by
        intro n hn Y T hT hY hY_sub hY_add
        have hn_init : N_init ≤ n := le_trans hNinit_le_glue hn
        have hT_open : T ∈ U_T_open := hK1_sub_Uopen hT
        have hT_all : T ∈ U_T_all := hUopen_sub_Uall hT_open
        rcases hInit_n n hn_init with ⟨_, _, _, _, _, _, _, _, hSsh_rec⟩
        have h_base := hSsh_rec Y T hT_all (hRlow_sub_Rdeep hY)
          (hRlow_sub_Rdeep hY_sub) (hRlow_sub_Rdeep hY_add)
        have heq_prev :
            S₁ n (Y - T / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ), T) =
              shearedRescaledLift seq (s_tilde n) n
                (Y - T / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ), T) :=
          hS₁_low_eq n hn _ ⟨hY_sub, hT_open⟩
        have heq_curr :
            S₁ n (Y, T) = shearedRescaledLift seq (s_tilde n) n (Y, T) :=
          hS₁_low_eq n hn (Y, T) ⟨hY, hT_open⟩
        have heq_next :
            S₁ n (Y + T / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ), T) =
              shearedRescaledLift seq (s_tilde n) n
                (Y + T / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ), T) :=
          hS₁_low_eq n hn _ ⟨hY_add, hT_open⟩
        unfold SatisfiesScaledChordRecurrence at h_base ⊢
        dsimp only at h_base ⊢
        rw [heq_prev, heq_curr, heq_next]
        exact h_base)
  
  refine ⟨H_1_bot, H_cut_0, N₁, U_phys, s_tilde, δ_base, S₁,
    hH1_lt_55, hH1_lt_cut, hHcut_lt_50, ?_, ?_⟩
  · intro n hn
    have hn_glue : N_glue ≤ n := le_trans hN₁_ge_glue hn
    have hn_init : N_init ≤ n := le_trans hNinit_le_glue hn_glue
    rcases hInit_n n hn_init with
      ⟨hU_conv, hδ_pos, hs_holo, hs_strip, hs_base, h_toPhys, _, _, _⟩
    refine ⟨hU_conv, hδ_pos, hs_holo, hs_strip, hs_base, ?_, ?_, ?_, ?_⟩
    · intro q hq
      have hq_open : q.2 ∈ U_T_open := hUT1_sub_Uopen hq.2
      have hq_all : q.2 ∈ U_T_all := hUopen_sub_Uall hq_open
      refine ⟨h_toPhys q ⟨hRlow_sub_Rdeep hq.1, hq_all⟩, ?_⟩
      rw [hS₁_low_eq n hn_glue q ⟨hq.1, hq_open⟩]
      have hℓ_ne : (seq.ℓ_seq n : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (seq.ℓ_pos n).ne'
      change expBasePt seq n +
          (seq.ℓ_seq n : ℂ) *
            ((s_tilde n (shearedToPhys seq n q) - expBasePt seq n) / (seq.ℓ_seq n : ℂ)) =
          s_tilde n (shearedToPhys seq n q)
      rw [mul_div_cancel₀ _ hℓ_ne]
      ring
    · exact (hS₁_holo_open n hn_glue).mono (Set.prod_mono Set.Subset.rfl hUT1_sub_Uopen)
    · intro q hq
      rcases Set.mem_iUnion.mp (hUT1_sub_Uopen hq.2) with ⟨c, hqc⟩
      rw [hS₁_eq_Sc n hn_glue c q ⟨hq.1, hqc⟩]
      exact hSc_strip c n (le_trans (hNc_le_glue c) hn_glue) q ⟨hq.1, hqc⟩
    · intro Y T hT hY
      have hY' : Y ∈ complexRect (-X₁ + δ_r) (X₁ - δ_r) (H_1_bot + δ_r) (H_1_top - δ_r) :=
        hRect_mono le_rfl le_rfl le_rfl (by dsimp [H_1_top, δ_r]; linarith) hY
      exact hN₁_rec n hn T (hUT1_sub_K1 hT) Y hY'
  · exact hS₁_conv_open.mono (Set.prod_mono Set.Subset.rfl hUT1_sub_Uopen)

theorem stage_two_radial_patches_and_gluing (X : ExpStripData) (hX : IsExpObstructionStrip X)
    (P : ChordActionPackage X) (kind : ExpProfileKind)
    (seq : ExpSequenceData X kind)
    (M : BranchMonodromyPackage kind)
    (hDisk : DiskContinuationToolkitProp)
    (hBridge : ShearedModelAndDeepBridgeProp X P kind seq M)
    (hLift : ShearedDiskLiftProp X P kind seq)
    (hRec : VertRecurrenceProp X P kind seq)
    (hStage1 : StageOneShearedProp X P kind seq M) :
    Nonempty (RadialBypassPatchesData X P kind seq M) :=
by
  classical
  let _ := hX
  let T_star : ℝ := expParamStar seq
  have hT_star_pos : 0 < T_star := hBridge.T_star_pos
  let α_c : ℝ := expArgC0 seq
  let r₀ : ℝ := T_star / 32
  have hr₀_pos : 0 < r₀ := by positivity
  obtain ⟨δ_ϕ2, g₀, hδ_ϕ2_pos, hg₀_diff, hg₀_zero, hg₀_unit, hg₀_dip⟩ :=
    hDisk.binomial_dip_poly 0 Real.pi 5 1 (by norm_num) (by norm_num)
  let η₂ : ℝ := (r₀ / 8) * min 1 δ_ϕ2
  have hmin_pos : 0 < min (1 : ℝ) δ_ϕ2 := lt_min zero_lt_one hδ_ϕ2_pos
  have hmin_le_one : min (1 : ℝ) δ_ϕ2 ≤ 1 := min_le_left _ _
  have hη₂_pos : 0 < η₂ := by positivity
  have hη₂_le : η₂ ≤ r₀ / 8 := by
    dsimp [η₂]
    nlinarith
  let D_drift : ℝ := 40 + 20 * T_star / η₂ + 1
  have hD_drift_pos : 0 < D_drift := by positivity
  let ν' : ℝ := min (M.ν / 2) (M.δ_θ / (8 * D_drift))
  have hν'_pos : 0 < ν' := lt_min (by linarith [M.ν_pos]) (div_pos M.δ_θ_pos (by positivity))
  have hν'_le_half_ν : ν' ≤ M.ν / 2 := min_le_left _ _
  have hν'_lt : ν' < M.ν := by linarith [M.ν_pos]
  have hν'_lt_half : ν' < 1 / 2 := by linarith [M.ν_lt_one]
  have h_drift_sum : (40 + 20 * T_star / η₂) * ν' < M.δ_θ / 8 := by
    have h1 : ν' ≤ M.δ_θ / (8 * D_drift) := min_le_right _ _
    have h2 : ν' * (8 * D_drift) ≤ M.δ_θ := (le_div_iff₀ (by positivity)).mp h1
    dsimp [D_drift] at h2
    nlinarith
  have h_40ν_lt : 40 * ν' < M.δ_θ / 8 := by
    have : 0 < (20 * T_star / η₂) * ν' := by positivity
    linarith
  let ε_patch : ℝ := min (ν' / 24) (M.δ_θ / 24)
  have hε_patch_pos : 0 < ε_patch := lt_min (by positivity) (by linarith [M.δ_θ_pos])
  have hε_patch_le_ν : ε_patch ≤ ν' / 24 := min_le_left _ _
  have hε_patch_le_δ : ε_patch ≤ M.δ_θ / 24 := min_le_right _ _
  have hε_patch_lt_ν : ε_patch < ν' / 12 := by linarith
  have hε_patch_lt_δ : ε_patch < M.δ_θ / 12 := by linarith [M.δ_θ_pos]

  let X₁ : ℝ := |α_c| + M.θ + 10
  let U_T_all : Set ℂ := Metric.ball (T_star : ℂ) ((15 / 32 : ℝ) * T_star)
  let U_T_1 : Set ℂ := Metric.ball (T_star : ℂ) ((3 / 2 : ℝ) * r₀)
  let U_T_2 : Set ℂ := Metric.ball (T_star : ℂ) (η₂ / 2)
  let H_cut_1 : ℝ := Real.log M.R - (15 / 4 : ℝ) * ν'
  let Rect2 : ℝ → Set ℂ := fun sgn =>
    complexRect
      (α_c - sgn * M.θ - M.δ_θ / 4)
      (α_c - sgn * M.θ + M.δ_θ / 4)
      (Real.log M.R - (19 / 4 : ℝ) * ν')
      (Real.log M.R + (7 / 8 : ℝ) * ν')
  let TargetCenter : ℝ → ℂ := fun sgn =>
    ((α_c - sgn * M.θ : ℝ) : ℂ) + ((Real.log M.R + ν' / 2 : ℝ) : ℂ) * Complex.I

  have h_UT2_sub_UT1 : U_T_2 ⊆ U_T_1 :=
    Metric.ball_subset_ball (by linarith)
  have h_UT1_sub_all : U_T_1 ⊆ U_T_all :=
    Metric.ball_subset_ball (by dsimp [r₀]; linarith)
  have h_UT2_sub_all : U_T_2 ⊆ U_T_all := h_UT2_sub_UT1.trans h_UT1_sub_all

  have h_rect_open : ∀ a b c d : ℝ, IsOpen (complexRect a b c d) := by
    intro a b c d
    have h1 : IsOpen { z : ℂ | a < z.re } := isOpen_lt continuous_const Complex.continuous_re
    have h2 : IsOpen { z : ℂ | z.re < b } := isOpen_lt Complex.continuous_re continuous_const
    have h3 : IsOpen { z : ℂ | c < z.im } := isOpen_lt continuous_const Complex.continuous_im
    have h4 : IsOpen { z : ℂ | z.im < d } := isOpen_lt Complex.continuous_im continuous_const
    simpa only [complexRect, Set.inter_def, Set.mem_setOf_eq] using h1.inter (h2.inter (h3.inter h4))

  have h_rec_congr : ∀ (f₁ f₂ : ℂ → ℂ) (n : ℕ) (Y T : ℂ),
      f₁ (Y - T / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ)) =
        f₂ (Y - T / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ)) →
      f₁ Y = f₂ Y →
      f₁ (Y + T / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ)) =
        f₂ (Y + T / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ)) →
      SatisfiesScaledChordRecurrence P seq f₁ n Y T →
      SatisfiesScaledChordRecurrence P seq f₂ n Y T := by
    intro f₁ f₂ n Y T hprev hcurr hnext hrec
    dsimp only [SatisfiesScaledChordRecurrence] at hrec ⊢
    rwa [← hprev, ← hcurr, ← hnext]

  have h_x_bounds : ∀ sgn : ℝ, (sgn = 1 ∨ sgn = -1) →
      -X₁ + ν' / 8 < (α_c - sgn * M.θ) - M.δ_θ ∧
        (α_c - sgn * M.θ) + M.δ_θ < X₁ - ν' / 8 := by
    intro sgn hsgn
    have hpi : Real.pi < 4 := Real.pi_lt_four
    have hθ_lt_one : M.θ < 1 := by linarith [M.θ_lt]
    have hδ_lt : M.δ_θ < 1 / 2 := by linarith [M.δ_θ_lt]
    have hα_lo : -|α_c| ≤ α_c := neg_abs_le α_c
    have hα_hi : α_c ≤ |α_c| := le_abs_self α_c
    rcases hsgn with rfl | rfl <;> constructor <;> dsimp [X₁] <;>
      linarith [M.θ_pos, M.δ_θ_pos, hν'_pos, hν'_lt_half]

  obtain ⟨H_1_bot, H_cut_0, N₁, U_phys, s_tilde, δ_base, S₁,
    hH1_lt, hH1_cut, hHcut_lt, hS₁_props, hS₁_conv⟩ :=
    hStage1 ν' hν'_pos hν'_lt
  let R_1_full : Set ℂ := complexRect (-X₁) X₁ H_1_bot (Real.log M.R - ν')
  let R_1_rec : Set ℂ :=
    complexRect (-X₁ + ν' / 8) (X₁ - ν' / 8)
      (H_1_bot + ν' / 8) (Real.log M.R - (9 / 8 : ℝ) * ν')

  
  have h_sector_lift : ∀ sgn : ℝ, (sgn = 1 ∨ sgn = -1) →
      ∃ (N₂ : ℕ) (S₂ : ℕ → ℂ × ℂ → ℂ),
        N₁ ≤ N₂ ∧
        (∀ n ≥ N₂, DifferentiableOn ℂ (S₂ n) (Rect2 sgn ×ˢ U_T_2)) ∧
        (∀ n ≥ N₂, ∀ p ∈ Rect2 sgn ×ˢ U_T_2,
          expBasePt seq n + (seq.ℓ_seq n : ℂ) * S₂ n p ∈ X.D_strip) ∧
        (∀ n ≥ N₂, ∀ p ∈ Rect2 sgn ×ˢ U_T_2,
          p.1.im < Real.log M.R - (13 / 4 : ℝ) * ν' → S₂ n p = S₁ n p) ∧
        TendstoUniformlyOn S₂ (expShearedInnerModel seq M) Filter.atTop
          (Rect2 sgn ×ˢ U_T_2) := by
    intro sgn hsgn
    let x_ctr : ℝ := α_c - sgn * M.θ
    let K_T_prev : Set ℂ := Metric.closedBall (T_star : ℂ) ((5 / 4 : ℝ) * r₀)
    let g₂ : ℂ → ℂ := fun ζ => (ν' : ℂ) * g₀ ζ
    have hK_sub_UT1 : K_T_prev ⊆ U_T_1 :=
      Metric.closedBall_subset_ball (by linarith)
    have hUT1_sub_ball : U_T_1 ⊆ Metric.ball (0 : ℂ) (2 * T_star) := by
      intro T hT
      have hT_all : T ∈ U_T_all := h_UT1_sub_all hT
      simpa [Metric.mem_ball, dist_zero_right] using
        (hBridge.shear_holo_bounds.2 T hT_all).2.1
    have hg₂_diff : Differentiable ℂ g₂ := hg₀_diff.const_mul (ν' : ℂ)
    have hg₂_zero : g₂ 0 = 0 := by simp [g₂, hg₀_zero]
    have hg₂_unit : ∀ ζ : ℂ, ‖ζ‖ ≤ 1 → ‖g₂ ζ‖ ≤ 40 * ν' ∧ (g₂ ζ).im ≤ ν' := by
      intro ζ hζ
      obtain ⟨h1, h2⟩ := hg₀_unit ζ hζ
      refine ⟨?_, ?_⟩
      · calc ‖(ν' : ℂ) * g₀ ζ‖ = ‖(ν' : ℂ)‖ * ‖g₀ ζ‖ := norm_mul _ _
          _ = ν' * ‖g₀ ζ‖ := by rw [Complex.norm_of_nonneg hν'_pos.le]
          _ ≤ 40 * ν' := by nlinarith
      · have him : ((ν' : ℂ) * g₀ ζ).im = ν' * (g₀ ζ).im := by simp
        rw [him]
        nlinarith
    have h_disk_in_K : ∀ T_c ∈ U_T_2, ∀ ζ : ℂ, ‖ζ‖ ≤ 1 →
        T_c + (r₀ : ℂ) * ζ ∈ K_T_prev := by
      intro T_c hTc ζ hζ
      have hTc_lt : ‖T_c - (T_star : ℂ)‖ < η₂ / 2 := by
        simpa [U_T_2, Metric.mem_ball, dist_eq_norm] using hTc
      have hrζ : ‖(r₀ : ℂ) * ζ‖ ≤ r₀ := by
        rw [norm_mul, Complex.norm_of_nonneg hr₀_pos.le]
        nlinarith
      have h_tri : ‖T_c + (r₀ : ℂ) * ζ - (T_star : ℂ)‖ ≤
          ‖T_c - (T_star : ℂ)‖ + ‖(r₀ : ℂ) * ζ‖ := by
        have h_eq : T_c + (r₀ : ℂ) * ζ - (T_star : ℂ) =
            (T_c - (T_star : ℂ)) + (r₀ : ℂ) * ζ := by ring
        rw [h_eq]
        exact norm_add_le _ _
      simp only [K_T_prev, Metric.mem_closedBall, dist_eq_norm]
      linarith
    have h_circle_in_K : ∀ T_c ∈ U_T_2, ∀ ϕ : ℝ,
        T_c + (r₀ : ℂ) * Complex.exp ((ϕ : ℂ) * Complex.I) ∈ K_T_prev := by
      intro T_c hTc ϕ
      exact h_disk_in_K T_c hTc _ (Complex.norm_exp_ofReal_mul_I ϕ).le
    have h_cball_in_UT1 : ∀ T_c ∈ U_T_2, ∀ ζ ∈ Metric.closedBall (0 : ℂ) 1,
        T_c + (r₀ : ℂ) * ζ ∈ U_T_1 := by
      intro T_c hTc ζ hζ
      have hζ' : ‖ζ‖ ≤ 1 := by simpa [Metric.mem_closedBall, dist_zero_right] using hζ
      exact hK_sub_UT1 (h_disk_in_K T_c hTc ζ hζ')
    have h_dip : ∀ T_c ∈ U_T_2, ∀ ϕ : ℝ,
        |(T_c + (r₀ : ℂ) * Complex.exp ((ϕ : ℂ) * Complex.I)).im| ≤
          (3 / 2 : ℝ) * η₂ →
        (Real.log M.R + (7 / 8 : ℝ) * ν') +
          (g₂ (Complex.exp ((ϕ : ℂ) * Complex.I))).im ≤
          (Real.log M.R - 2 * ν') -
            (3 / 2 : ℝ) *
              (((Real.log M.R - 2 * ν') - (Real.log M.R - 3 * ν')) / 4) := by
      intro T_c hTc ϕ h_im_le
      have hTc_lt : ‖T_c - (T_star : ℂ)‖ < η₂ / 2 := by
        simpa [U_T_2, Metric.mem_ball, dist_eq_norm] using hTc
      have hTc_im : |T_c.im| < η₂ / 2 := by
        have h1 : |(T_c - (T_star : ℂ)).im| ≤ ‖T_c - (T_star : ℂ)‖ :=
          Complex.abs_im_le_norm _
        have h2 : (T_c - (T_star : ℂ)).im = T_c.im := by simp
        rw [h2] at h1
        linarith
      have hexp_im :
          (T_c + (r₀ : ℂ) * Complex.exp ((ϕ : ℂ) * Complex.I)).im =
            T_c.im + r₀ * Real.sin ϕ := by
        simp [Complex.exp_ofReal_mul_I_im]
      rw [hexp_im] at h_im_le
      have hr_sin : |r₀ * Real.sin ϕ| ≤ 2 * η₂ := by
        rw [abs_le] at h_im_le ⊢
        rw [abs_lt] at hTc_im
        constructor <;> linarith
      have hr_sin' : r₀ * |Real.sin ϕ| ≤ r₀ * ((1 / 4 : ℝ) * min 1 δ_ϕ2) := by
        rw [abs_mul, abs_of_pos hr₀_pos] at hr_sin
        have h2η : 2 * η₂ = r₀ * ((1 / 4 : ℝ) * min 1 δ_ϕ2) := by
          dsimp [η₂]
          ring
        linarith
      have hsin_le : |Real.sin ϕ - 0| ≤ (1 / 4 : ℝ) * min 1 δ_ϕ2 := by
        rw [sub_zero]
        exact le_of_mul_le_mul_left hr_sin' hr₀_pos
      have h_col :=
        hBridge.arcsin_collar 0 δ_ϕ2 (by constructor <;> norm_num) hδ_ϕ2_pos ϕ hsin_le
      have h_col' : ∃ k : ℤ,
          |ϕ - 0 - 2 * Real.pi * (k : ℝ)| ≤ δ_ϕ2 ∨
          |ϕ - Real.pi - 2 * Real.pi * (k : ℝ)| ≤ δ_ϕ2 := by
        obtain ⟨k, hk | hk⟩ := h_col
        · rw [Real.arcsin_zero] at hk
          exact ⟨k, Or.inl hk⟩
        · rw [Real.arcsin_zero, sub_zero] at hk
          exact ⟨k, Or.inr hk⟩
      have hg₀_im := hg₀_dip ϕ h_col'
      have hg₂_im : (g₂ (Complex.exp ((ϕ : ℂ) * Complex.I))).im ≤ -5 * ν' := by
        have him : (g₂ (Complex.exp ((ϕ : ℂ) * Complex.I))).im =
            ν' * (g₀ (Complex.exp ((ϕ : ℂ) * Complex.I))).im := by
          simp [g₂]
        rw [him]
        nlinarith
      linarith
    have hB_rec_mod :
        complexRect (x_ctr - M.δ_θ) (x_ctr + M.δ_θ)
          (Real.log M.R - 3 * ν') (Real.log M.R - 2 * ν') ×ˢ U_T_1 ⊆
          expShearedInnerDomain seq M := by
      intro p hp
      have hpT : ‖p.2 - (T_star : ℂ)‖ < (15 / 32 : ℝ) * T_star := by
        simpa [U_T_all, Metric.mem_ball, dist_eq_norm] using h_UT1_sub_all hp.2
      have hp_im : p.1.im < Real.log M.R := by linarith [hp.1.2.2.2]
      exact hBridge.mem_inner_of_lt_log_R p.1 p.2 hpT hp_im
    have hW_disk_mod :
        ∀ p ∈ Rect2 sgn ×ˢ U_T_2, ∀ ζ ∈ Metric.closedBall (0 : ℂ) 1,
          (p.1 + g₂ ζ, p.2 + (r₀ : ℂ) * ζ) ∈ expShearedInnerDomain seq M := by
      intro p hp ζ hζ
      have hζ_norm : ‖ζ‖ ≤ 1 := by
        simpa [Metric.mem_closedBall, dist_zero_right] using hζ
      obtain ⟨hg_norm, hg_im⟩ := hg₂_unit ζ hζ_norm
      have hg_re : |(g₂ ζ).re| ≤ 40 * ν' := le_trans (Complex.abs_re_le_norm _) hg_norm
      have hT_mem : p.2 + (r₀ : ℂ) * ζ ∈ U_T_all :=
        h_UT1_sub_all (h_cball_in_UT1 p.2 hp.2 ζ hζ)
      have hT_dist : ‖p.2 + (r₀ : ℂ) * ζ - (T_star : ℂ)‖ < (15 / 32 : ℝ) * T_star := by
        simpa [U_T_all, Metric.mem_ball, dist_eq_norm] using hT_mem
      have hY_im : (p.1 + g₂ ζ).im < Real.log M.R + 2 * M.ν := by
        have him : (p.1 + g₂ ζ).im = p.1.im + (g₂ ζ).im := by simp
        rw [him]
        linarith [hp.1.2.2.2, M.ν_pos]
      have hY_re : |(p.1 + g₂ ζ).re - (α_c - sgn * M.θ)| < 2 * M.δ_θ := by
        have hre : (p.1 + g₂ ζ).re = p.1.re + (g₂ ζ).re := by simp
        rw [hre, abs_lt]
        rw [abs_le] at hg_re
        constructor <;> linarith [hp.1.1, hp.1.2.1, M.δ_θ_pos]
      exact hBridge.mem_inner_of_sector sgn _ _ hsgn hT_dist hY_im hY_re
    have h_rays : ∀ (σ : ℝ), (σ = 1 ∨ σ = -1) →
        ∀ (Y' T' : ℂ),
          (x_ctr - M.δ_θ / 4) - 40 * ν' ≤ Y'.re →
          Y'.re ≤ (x_ctr + M.δ_θ / 4) + 40 * ν' →
          ((Real.log M.R - 3 * ν') + (Real.log M.R - 2 * ν')) / 2 ≤ Y'.im →
          Y'.im ≤ (Real.log M.R + (7 / 8 : ℝ) * ν') + ν' →
          T' ∈ K_T_prev →
          (3 / 2 : ℝ) * η₂ ≤ σ * T'.im →
          ∀ τ ∈ Set.Icc
            (((Real.log M.R - 3 * ν') + (Real.log M.R - 2 * ν')) / 2) Y'.im,
            let y_mid : ℝ := ((Real.log M.R - 3 * ν') + (Real.log M.R - 2 * ν')) / 2
            let Y_vert : ℂ := (Y'.re : ℂ) + (τ : ℂ) * Complex.I
            let s_end : ℝ := (τ - y_mid) / (σ * T'.im)
            (∀ s ∈ Set.Icc (0 : ℝ) s_end,
              (Y_vert - (s : ℂ) * (σ : ℂ) * T', T') ∈ expShearedInnerDomain seq M) ∧
            x_ctr - M.δ_θ < (Y_vert - (s_end : ℂ) * (σ : ℂ) * T').re ∧
            (Y_vert - (s_end : ℂ) * (σ : ℂ) * T').re < x_ctr + M.δ_θ := by
      intro σ hσ Y' T' hY_lo hY_hi hY_im_lo hY_im_hi hT'_K hT'_steep τ hτ
      let y_mid : ℝ := ((Real.log M.R - 3 * ν') + (Real.log M.R - 2 * ν')) / 2
      let Y_vert : ℂ := (Y'.re : ℂ) + (τ : ℂ) * Complex.I
      let s_end : ℝ := (τ - y_mid) / (σ * T'.im)
      have hT'_all : T' ∈ U_T_all := h_UT1_sub_all (hK_sub_UT1 hT'_K)
      have hT'_norm : ‖T'‖ < 2 * T_star := (hBridge.shear_holo_bounds.2 T' hT'_all).2.1
      have hT'_dist : ‖T' - (T_star : ℂ)‖ < (15 / 32 : ℝ) * T_star := by
        simpa [U_T_all, Metric.mem_ball, dist_eq_norm] using hT'_all
      have hσ_im_pos : 0 < σ * T'.im := by linarith
      have hτ_diff_nonneg : 0 ≤ τ - y_mid := by
        dsimp [y_mid] at hτ ⊢
        linarith [hτ.1]
      have hτ_diff_le : τ - y_mid ≤ (35 / 8 : ℝ) * ν' := by
        dsimp [y_mid] at hτ ⊢
        linarith [hτ.2]
      have hs_end_nonneg : 0 ≤ s_end := div_nonneg hτ_diff_nonneg hσ_im_pos.le
      have hs_end_le : s_end ≤ 10 * (ν' / η₂) := by
        have hmul1 : s_end * ((3 / 2 : ℝ) * η₂) ≤ s_end * (σ * T'.im) :=
          mul_le_mul_of_nonneg_left hT'_steep hs_end_nonneg
        have hmul2 : s_end * (σ * T'.im) = τ - y_mid :=
          div_mul_cancel₀ (τ - y_mid) hσ_im_pos.ne'
        have hmul3 : (10 * (ν' / η₂)) * ((3 / 2 : ℝ) * η₂) = 15 * ν' := by
          field_simp [hη₂_pos.ne']
          ring
        have hmul4 : s_end * ((3 / 2 : ℝ) * η₂) ≤
            (10 * (ν' / η₂)) * ((3 / 2 : ℝ) * η₂) := by
          linarith
        exact le_of_mul_le_mul_right hmul4 (by positivity)
      have hσ_norm : ‖(σ : ℂ)‖ = 1 := by rcases hσ with rfl | rfl <;> simp
      have h_ray_bounds : ∀ s ∈ Set.Icc (0 : ℝ) s_end,
          |(Y_vert - (s : ℂ) * (σ : ℂ) * T').re - x_ctr| < (3 / 8 : ℝ) * M.δ_θ ∧
          (Y_vert - (s : ℂ) * (σ : ℂ) * T').im < Real.log M.R + 2 * M.ν := by
        intro s hs
        have hs_le : s ≤ 10 * (ν' / η₂) := le_trans hs.2 hs_end_le
        have hshift_norm : ‖(s : ℂ) * (σ : ℂ) * T'‖ ≤ (20 * T_star / η₂) * ν' := by
          rw [norm_mul, norm_mul, Complex.norm_of_nonneg hs.1, hσ_norm, mul_one]
          have h1 : s * ‖T'‖ ≤ (10 * (ν' / η₂)) * (2 * T_star) :=
            mul_le_mul hs_le hT'_norm.le (norm_nonneg T') (by positivity)
          have h2 : (10 * (ν' / η₂)) * (2 * T_star) = (20 * T_star / η₂) * ν' := by ring
          linarith
        have hshift_re : |((s : ℂ) * (σ : ℂ) * T').re| ≤ (20 * T_star / η₂) * ν' :=
          le_trans (Complex.abs_re_le_norm _) hshift_norm
        refine ⟨?_, ?_⟩
        · have hre : (Y_vert - (s : ℂ) * (σ : ℂ) * T').re =
              Y'.re - ((s : ℂ) * (σ : ℂ) * T').re := by simp [Y_vert]
          rw [hre, abs_lt]
          rw [abs_le] at hshift_re
          constructor <;> linarith
        · have him : (Y_vert - (s : ℂ) * (σ : ℂ) * T').im = τ - s * (σ * T'.im) := by
            simp [Y_vert, mul_assoc]
          have hs_prod : 0 ≤ s * (σ * T'.im) := mul_nonneg hs.1 hσ_im_pos.le
          rw [him]
          linarith [hτ.2, M.ν_pos]
      refine ⟨?_, ?_⟩
      · intro s hs
        obtain ⟨hre, him⟩ := h_ray_bounds s hs
        exact hBridge.mem_inner_of_sector sgn _ _ hsgn hT'_dist him
          (lt_trans hre (by linarith [M.δ_θ_pos]))
      · obtain ⟨hre_end, _⟩ := h_ray_bounds s_end ⟨hs_end_nonneg, le_rfl⟩
        rw [abs_lt] at hre_end
        constructor <;> linarith [M.δ_θ_pos]
    obtain ⟨hx_lo_gt, hx_hi_lt⟩ := h_x_bounds sgn hsgn
    have hU_prev_sub :
        complexRect (x_ctr - M.δ_θ) (x_ctr + M.δ_θ)
          (H_1_bot + ν' / 8) (Real.log M.R - 2 * ν') ×ˢ U_T_1 ⊆
          R_1_full ×ˢ U_T_1 := by
      intro q hq
      exact ⟨⟨by linarith [hq.1.1], by linarith [hq.1.2.1],
        by linarith [hq.1.2.2.1], by linarith [hq.1.2.2.2]⟩, hq.2⟩
    have hB_rec_Y_sub :
        complexRect (x_ctr - M.δ_θ) (x_ctr + M.δ_θ)
          (Real.log M.R - 3 * ν') (Real.log M.R - 2 * ν') ⊆ R_1_rec := by
      intro Y hY
      exact ⟨by linarith [hY.1], by linarith [hY.2.1],
        by linarith [hY.2.2.1], by linarith [hY.2.2.2]⟩
    obtain ⟨N₂, S₂, hN₁_le, hS₂_holo, hS₂_strip, hS₂_eq, hS₂_conv⟩ :=
      hLift
        (expShearedInnerDomain seq M) (expShearedInnerModel seq M)
        (2 * T_star) r₀ η₂ (40 * ν') ν'
        U_T_1 K_T_prev U_T_2
        (x_ctr - M.δ_θ) (x_ctr - M.δ_θ / 4) (x_ctr + M.δ_θ / 4) (x_ctr + M.δ_θ)
        (H_1_bot + ν' / 8) (Real.log M.R - 3 * ν') (Real.log M.R - 2 * ν')
        (Real.log M.R - (19 / 4 : ℝ) * ν') (Real.log M.R + (7 / 8 : ℝ) * ν')
        g₂
        hBridge.inner_model_reg
        (by positivity) hr₀_pos hη₂_pos (by positivity) hν'_pos
        Metric.isOpen_ball (isCompact_closedBall _ _) hK_sub_UT1 hUT1_sub_ball
        Metric.isOpen_ball
        (by linarith [M.δ_θ_pos]) (by linarith [M.δ_θ_pos]) (by linarith [M.δ_θ_pos])
        (by linarith) (by linarith) (by linarith) (by linarith)
        (by linarith)
        hg₂_diff hg₂_zero hg₂_unit h_circle_in_K h_cball_in_UT1 h_dip
        hB_rec_mod hW_disk_mod h_rays
        N₁ S₁
        (fun n hn => (hS₁_props n hn).2.2.2.2.2.2.1.mono hU_prev_sub)
        (fun n hn p hp => (hS₁_props n hn).2.2.2.2.2.2.2.1 p (hU_prev_sub hp))
        (fun n hn Y T _ hYT _ _ =>
          (hS₁_props n hn).2.2.2.2.2.2.2.2 Y T hYT.2 (hB_rec_Y_sub hYT.1))
        (fun _ _ hK => hS₁_conv.mono (hK.trans hU_prev_sub))
    refine ⟨N₂, S₂, hN₁_le, hS₂_holo, hS₂_strip, ?_, hS₂_conv⟩
    intro n hn p hp hp_im
    exact hS₂_eq n hn p hp (by linarith)

  obtain ⟨N₂_plus, S₂_plus, hN₁_le_plus, hS₂_plus_holo, hS₂_plus_strip,
    hS₂_plus_eq, hS₂_plus_conv⟩ := h_sector_lift 1 (Or.inl rfl)
  obtain ⟨N₂_minus, S₂_minus, hN₁_le_minus, hS₂_minus_holo, hS₂_minus_strip,
    hS₂_minus_eq, hS₂_minus_conv⟩ := h_sector_lift (-1) (Or.inr rfl)

  
  let δ_r : ℝ := min (ν' / 8) (M.δ_θ / 8)
  have hδ_r_pos : 0 < δ_r := lt_min (by positivity) (by linarith [M.δ_θ_pos])
  have hδ_r_le_ν : δ_r ≤ ν' / 8 := min_le_left _ _
  have hδ_r_le_δ : δ_r ≤ M.δ_θ / 8 := min_le_right _ _
  have hT_star_mem_UT2 : (T_star : ℂ) ∈ U_T_2 :=
    Metric.mem_ball_self (by positivity)
  have hT_star_mem_UT1 : (T_star : ℂ) ∈ U_T_1 := h_UT2_sub_UT1 hT_star_mem_UT2

  have h_ball_in_shrunk : ∀ sgn : ℝ,
      Metric.ball (TargetCenter sgn) (3 * ε_patch) ⊆
        complexRect
          ((α_c - sgn * M.θ - M.δ_θ / 4) + δ_r)
          ((α_c - sgn * M.θ + M.δ_θ / 4) - δ_r)
          ((Real.log M.R - (19 / 4 : ℝ) * ν') + δ_r)
          ((Real.log M.R + (7 / 8 : ℝ) * ν') - δ_r) := by
    intro sgn Z hZ
    have hZ_norm : ‖Z - TargetCenter sgn‖ < 3 * ε_patch := by
      simpa [Metric.mem_ball, dist_eq_norm] using hZ
    have hZ_re : |Z.re - (α_c - sgn * M.θ)| < 3 * ε_patch := by
      have h1 := Complex.abs_re_le_norm (Z - TargetCenter sgn)
      have h2 : (Z - TargetCenter sgn).re = Z.re - (α_c - sgn * M.θ) := by
        simp [TargetCenter]
      rw [h2] at h1
      linarith
    have hZ_im : |Z.im - (Real.log M.R + ν' / 2)| < 3 * ε_patch := by
      have h1 := Complex.abs_im_le_norm (Z - TargetCenter sgn)
      have h2 : (Z - TargetCenter sgn).im = Z.im - (Real.log M.R + ν' / 2) := by
        simp [TargetCenter]
      rw [h2] at h1
      linarith
    rw [abs_lt] at hZ_re hZ_im
    exact ⟨by linarith, by linarith, by linarith, by linarith⟩

  have h_shrunk_sub_rect2 : ∀ sgn : ℝ,
      complexRect
        ((α_c - sgn * M.θ - M.δ_θ / 4) + δ_r)
        ((α_c - sgn * M.θ + M.δ_θ / 4) - δ_r)
        ((Real.log M.R - (19 / 4 : ℝ) * ν') + δ_r)
        ((Real.log M.R + (7 / 8 : ℝ) * ν') - δ_r) ⊆ Rect2 sgn := by
    intro sgn Z hZ
    exact ⟨by linarith [hZ.1], by linarith [hZ.2.1],
      by linarith [hZ.2.2.1], by linarith [hZ.2.2.2]⟩

  have h_ball_sub_rect2 : ∀ sgn : ℝ,
      Metric.ball (TargetCenter sgn) (3 * ε_patch) ⊆ Rect2 sgn :=
    fun sgn => (h_ball_in_shrunk sgn).trans (h_shrunk_sub_rect2 sgn)

  have h_model_slice_eq : ∀ Z : ℂ,
      expShearedInnerModel seq M (Z, (T_star : ℂ)) =
        Z + M.Δ_inner ((T_star : ℂ) * seq.c₀ * Complex.exp (-Complex.I * Z)) := by
    intro Z
    dsimp [expShearedInnerModel, expShearedModelW]
    rw [hBridge.shear_zero, add_zero]
    have h_exp_arg : -Complex.I * (Z - (α_c : ℂ)) =
        (α_c : ℂ) * Complex.I + (-Complex.I * Z) := by ring
    rw [h_exp_arg, Complex.exp_add, ← hBridge.unit_c₀]

  have h_slice_conv : ∀ (sgn : ℝ) (S₂ : ℕ → ℂ × ℂ → ℂ),
      TendstoUniformlyOn S₂ (expShearedInnerModel seq M) Filter.atTop
        (Rect2 sgn ×ˢ U_T_2) →
      TendstoUniformlyOn
        (fun n Z => S₂ n (Z, (T_star : ℂ)))
        (fun Z => Z + M.Δ_inner ((T_star : ℂ) * seq.c₀ * Complex.exp (-Complex.I * Z)))
        Filter.atTop
        (Metric.closedBall (TargetCenter sgn) (2 * ε_patch)) := by
    intro sgn S₂ hS₂_c
    let ι : ℂ → ℂ × ℂ := fun Z => (Z, (T_star : ℂ))
    have h_sub : Metric.closedBall (TargetCenter sgn) (2 * ε_patch) ⊆
        ι ⁻¹' (Rect2 sgn ×ˢ U_T_2) := by
      intro Z hZ
      have hZ_ball : Z ∈ Metric.ball (TargetCenter sgn) (3 * ε_patch) :=
        Metric.closedBall_subset_ball (by linarith) hZ
      exact ⟨h_ball_sub_rect2 sgn hZ_ball, hT_star_mem_UT2⟩
    have h1 := (hS₂_c.comp ι).mono h_sub
    exact h1.congr_right (fun Z _ => h_model_slice_eq Z)

  have h_rec_step : ∃ N_rec : ℕ, N₂_plus ≤ N_rec ∧
      ∀ n ≥ N_rec, ∀ Z ∈ Metric.ball (TargetCenter 1) (3 * ε_patch),
        SatisfiesScaledChordRecurrence P seq
          (fun W => S₂_plus n (W, (T_star : ℂ))) n Z (T_star : ℂ) := by
    have hUT2_bounds : U_T_2 ⊆ { T : ℂ | T ≠ 0 ∧ ‖T‖ < 2 * T_star } := by
      intro T hT
      have hT_all := h_UT2_sub_all hT
      exact ⟨(hBridge.shear_holo_bounds.2 T hT_all).1,
        (hBridge.shear_holo_bounds.2 T hT_all).2.1⟩
    have hRect2_mod : Rect2 1 ×ˢ U_T_2 ⊆ expShearedInnerDomain seq M := by
      intro q hq
      have hT_dist : ‖q.2 - (T_star : ℂ)‖ < (15 / 32 : ℝ) * T_star := by
        simpa [U_T_all, Metric.mem_ball, dist_eq_norm] using h_UT2_sub_all hq.2
      have hY_im : q.1.im < Real.log M.R + 2 * M.ν := by
        linarith [hq.1.2.2.2, M.ν_pos]
      have hY_re : |q.1.re - (α_c - 1 * M.θ)| < 2 * M.δ_θ := by
        rw [abs_lt]
        constructor <;> linarith [hq.1.1, hq.1.2.1, M.δ_θ_pos]
      exact hBridge.mem_inner_of_sector 1 q.1 q.2 (Or.inl rfl) hT_dist hY_im hY_re
    obtain ⟨hx1_lo, hx1_hi⟩ := h_x_bounds 1 (Or.inl rfl)
    have h_seed : ∀ n ≥ N₂_plus, ∀ Y T : ℂ, T ∈ ({(T_star : ℂ)} : Set ℂ) →
        Y ∈ complexRect (α_c - 1 * M.θ - M.δ_θ / 4) (α_c - 1 * M.θ + M.δ_θ / 4)
          (Real.log M.R - (19 / 4 : ℝ) * ν') H_cut_1 →
        Y - T / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ) ∈
          complexRect (α_c - 1 * M.θ - M.δ_θ / 4) (α_c - 1 * M.θ + M.δ_θ / 4)
            (Real.log M.R - (19 / 4 : ℝ) * ν') H_cut_1 →
        Y + T / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ) ∈
          complexRect (α_c - 1 * M.θ - M.δ_θ / 4) (α_c - 1 * M.θ + M.δ_θ / 4)
            (Real.log M.R - (19 / 4 : ℝ) * ν') H_cut_1 →
        SatisfiesScaledChordRecurrence P seq (fun Z => S₂_plus n (Z, T)) n Y T := by
      intro n hn Y T hT_mem hY hY_m hY_p
      have hT_eq : T = (T_star : ℂ) := Set.mem_singleton_iff.mp hT_mem
      subst hT_eq
      have hn₁ : N₁ ≤ n := le_trans hN₁_le_plus hn
      have h_eq_on_seed : ∀ W : ℂ,
          W ∈ complexRect (α_c - 1 * M.θ - M.δ_θ / 4) (α_c - 1 * M.θ + M.δ_θ / 4)
            (Real.log M.R - (19 / 4 : ℝ) * ν') H_cut_1 →
          S₁ n (W, (T_star : ℂ)) = S₂_plus n (W, (T_star : ℂ)) := by
        intro W hW
        have hW_rect2 : W ∈ Rect2 1 :=
          ⟨hW.1, hW.2.1, hW.2.2.1, by dsimp [H_cut_1] at hW; linarith [hW.2.2.2]⟩
        exact (hS₂_plus_eq n hn (W, (T_star : ℂ)) ⟨hW_rect2, hT_star_mem_UT2⟩
          (by dsimp [H_cut_1] at hW; linarith [hW.2.2.2])).symm
      have hY_R1rec : Y ∈ R_1_rec :=
        ⟨by linarith [hY.1], by linarith [hY.2.1],
          by linarith [hY.2.2.1], by dsimp [H_cut_1] at hY; linarith [hY.2.2.2]⟩
      exact h_rec_congr
        (fun Z => S₁ n (Z, (T_star : ℂ)))
        (fun Z => S₂_plus n (Z, (T_star : ℂ)))
        n Y (T_star : ℂ)
        (h_eq_on_seed _ hY_m) (h_eq_on_seed _ hY) (h_eq_on_seed _ hY_p)
        ((hS₁_props n hn₁).2.2.2.2.2.2.2.2 Y (T_star : ℂ) hT_star_mem_UT1 hY_R1rec)
    obtain ⟨N_rec, hN₂_le_rec, hRec_out⟩ :=
      hRec
        (expShearedInnerDomain seq M) (expShearedInnerModel seq M)
        (2 * T_star) U_T_2 ({(T_star : ℂ)} : Set ℂ)
        (α_c - 1 * M.θ - M.δ_θ / 4) (α_c - 1 * M.θ + M.δ_θ / 4)
        (Real.log M.R - (19 / 4 : ℝ) * ν') (Real.log M.R + (7 / 8 : ℝ) * ν')
        H_cut_1 δ_r N₂_plus S₂_plus
        hBridge.inner_model_reg (by positivity) hδ_r_pos
        Metric.isOpen_ball isCompact_singleton
        (Set.singleton_subset_iff.mpr hT_star_mem_UT2)
        hUT2_bounds
        (by linarith [M.δ_θ_pos]) (by linarith)
        (by dsimp [H_cut_1]; linarith) (by dsimp [H_cut_1]; linarith)
        hRect2_mod
        hS₂_plus_holo
        (fun _ _ hK => hS₂_plus_conv.mono hK)
        h_seed
    refine ⟨N_rec, hN₂_le_rec, ?_⟩
    intro n hn Z hZ
    exact hRec_out n hn (T_star : ℂ) (Set.mem_singleton _) Z (h_ball_in_shrunk 1 hZ)

  obtain ⟨N_rec, hN₂_le_rec, hS₂_plus_rec⟩ := h_rec_step

  
  obtain ⟨N_h, hN_h⟩ := Filter.eventually_atTop.mp
    (seq.h_div_ℓ_tendsto.eventually_gt_atTop (max (3 - H_cut_0) (|Real.log M.R| + 2)))
  let N_patch : ℕ := max (max N₁ N_h) (max N₂_plus (max N₂_minus N_rec))

  let Layer0 : ℕ → Set (ℂ × ℂ) := fun n =>
    { p : ℂ × ℂ |
      p ∈ U_phys n ∧
      (seq.m_seq n : ℂ) * p.2 ∈ U_T_2 ∧
      (physToSheared seq n p).1.im < H_cut_0 }
  let Layer1 : ℕ → Set (ℂ × ℂ) := fun n =>
    { p : ℂ × ℂ |
      (seq.m_seq n : ℂ) * p.2 ∈ U_T_2 ∧
      (physToSheared seq n p).1 ∈ complexRect (-X₁) X₁ H_1_bot H_cut_1 }
  let Layer2 : ℝ → ℕ → Set (ℂ × ℂ) := fun sgn n =>
    { p : ℂ × ℂ |
      (seq.m_seq n : ℂ) * p.2 ∈ U_T_2 ∧
      (physToSheared seq n p).1 ∈ Rect2 sgn }
  let GluedDom : ℝ → ℕ → Set (ℂ × ℂ) := fun sgn n =>
    Layer0 n ∪ Layer1 n ∪ Layer2 sgn n
  let GluedFn : ℝ → (ℕ → ℂ × ℂ → ℂ) → ℕ → ℂ × ℂ → ℂ := fun sgn S₂ n p =>
    if p ∈ Layer2 sgn n then
      expBasePt seq n + (seq.ℓ_seq n : ℂ) * S₂ n (physToSheared seq n p)
    else if p ∈ Layer1 n then
      expBasePt seq n + (seq.ℓ_seq n : ℂ) * S₁ n (physToSheared seq n p)
    else
      s_tilde n p
  let δ_zero : ℕ → ℝ := fun n =>
    min (min (δ_base n / 2) (seq.ℓ_seq n)) (η₂ / (6 * seq.m_seq n))

  have h_gluing : ∀ (sgn : ℝ) (S₂ : ℕ → ℂ × ℂ → ℂ) (N₂ : ℕ),
      (sgn = 1 ∨ sgn = -1) →
      (∀ n ≥ N₂, DifferentiableOn ℂ (S₂ n) (Rect2 sgn ×ˢ U_T_2)) →
      (∀ n ≥ N₂, ∀ p ∈ Rect2 sgn ×ˢ U_T_2,
        expBasePt seq n + (seq.ℓ_seq n : ℂ) * S₂ n p ∈ X.D_strip) →
      (∀ n ≥ N₂, ∀ p ∈ Rect2 sgn ×ˢ U_T_2,
        p.1.im < Real.log M.R - (13 / 4 : ℝ) * ν' → S₂ n p = S₁ n p) →
      ∀ n : ℕ, N₁ ≤ n → N₂ ≤ n → N_h ≤ n →
        let t₀_n : ℝ := T_star / seq.m_seq n
        let x₀_n : ℝ := seq.x_seq n + seq.ℓ_seq n * (α_c - sgn * M.θ)
        IsDownwardVertConvex (GluedDom sgn n) ∧
        0 < δ_zero n ∧
        DifferentiableOn ℂ (GluedFn sgn S₂ n) (GluedDom sgn n) ∧
        (∀ p ∈ GluedDom sgn n, GluedFn sgn S₂ n p ∈ X.D_strip) ∧
        (∀ y t : ℂ, ‖y - (x₀_n : ℂ)‖ < δ_zero n → ‖t - (t₀_n : ℂ)‖ < δ_zero n →
          (y, t) ∈ GluedDom sgn n ∧ GluedFn sgn S₂ n (y, t) = X.𝔰 (y, t)) ∧
        (∀ η : ℝ, 0 ≤ η →
          η ≤ seq.h_seq n + seq.ℓ_seq n * (Real.log M.R + 3 * ν' / 4) →
          ((x₀_n : ℂ) + (η : ℂ) * Complex.I, (t₀_n : ℂ)) ∈ GluedDom sgn n) ∧
        (∀ Z ∈ Rect2 sgn,
          (expBasePt seq n + (seq.ℓ_seq n : ℂ) * Z, (t₀_n : ℂ)) ∈ GluedDom sgn n ∧
          rescaledLift seq (GluedFn sgn S₂ n) n Z (T_star : ℂ) =
            S₂ n (Z, (T_star : ℂ))) := by
    intro sgn S₂ N₂ hsgn hS₂_holo hS₂_strip hS₂_eq n hn₁ hn₂ hnh
    let ℓ_n : ℝ := seq.ℓ_seq n
    let m_n : ℝ := seq.m_seq n
    have hℓ_pos : 0 < ℓ_n := seq.ℓ_pos n
    have hm_pos : 0 < m_n := seq.m_pos n
    have hℓ_ne : (ℓ_n : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hℓ_pos.ne'
    have hm_ne : (m_n : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hm_pos.ne'
    obtain ⟨hU0_dvc, hδ_base_pos, hs_tilde_holo, hs_tilde_strip,
      hs_tilde_base, hS₁_attach, hS₁_holo, hS₁_strip, _⟩ := hS₁_props n hn₁
    have hh_ratio : max (3 - H_cut_0) (|Real.log M.R| + 2) < seq.h_seq n / ℓ_n :=
      hN_h n hnh
    have hh_ratio_1 : 3 - H_cut_0 < seq.h_seq n / ℓ_n :=
      lt_of_le_of_lt (le_max_left _ _) hh_ratio
    have hh_ratio_2 : |Real.log M.R| + 2 < seq.h_seq n / ℓ_n :=
      lt_of_le_of_lt (le_max_right _ _) hh_ratio

    have h_inv : ∀ p : ℂ × ℂ, shearedToPhys seq n (physToSheared seq n p) = p := by
      intro p
      ext
      · dsimp [shearedToPhys, physToSheared]
        change expBasePt seq n +
            (ℓ_n : ℂ) *
              (((p.1 - expBasePt seq n) / (ℓ_n : ℂ) -
                expShearOffset T_star ((m_n : ℂ) * p.2)) +
                expShearOffset T_star ((m_n : ℂ) * p.2)) = p.1
        field_simp [hℓ_ne]
        ring
      · dsimp [shearedToPhys, physToSheared]
        change ((m_n : ℂ) * p.2) / (m_n : ℂ) = p.2
        field_simp [hm_ne]

    let Ω_T2 : Set (ℂ × ℂ) := { p : ℂ × ℂ | (m_n : ℂ) * p.2 ∈ U_T_2 }
    have hΩ_open : IsOpen Ω_T2 :=
      Metric.isOpen_ball.preimage (continuous_const.mul continuous_snd)
    have h_snd_diff : Differentiable ℂ (fun p : ℂ × ℂ => (m_n : ℂ) * p.2) :=
      (differentiable_snd : Differentiable ℂ (Prod.snd : ℂ × ℂ → ℂ)).const_mul (m_n : ℂ)
    have h_lin_diff : Differentiable ℂ
        (fun p : ℂ × ℂ => (p.1 - expBasePt seq n) / (ℓ_n : ℂ)) := by
      simpa only [div_eq_mul_inv] using
        ((differentiable_fst : Differentiable ℂ (Prod.fst : ℂ × ℂ → ℂ)).sub_const
          (expBasePt seq n)).mul_const (ℓ_n : ℂ)⁻¹
    have h_maps_Ω_all : Set.MapsTo (fun p : ℂ × ℂ => (m_n : ℂ) * p.2) Ω_T2 U_T_all :=
      fun _ hp => h_UT2_sub_all hp
    have h_shear_diff : DifferentiableOn ℂ
        (fun p : ℂ × ℂ => expShearOffset T_star ((m_n : ℂ) * p.2)) Ω_T2 :=
      hBridge.shear_holo_bounds.1.fun_comp h_snd_diff.differentiableOn h_maps_Ω_all
    have h_pts_diff : DifferentiableOn ℂ (physToSheared seq n) Ω_T2 :=
      (h_lin_diff.differentiableOn.sub h_shear_diff).prodMk h_snd_diff.differentiableOn
    have h_fst_pts_cont : ContinuousOn (fun p : ℂ × ℂ => (physToSheared seq n p).1) Ω_T2 :=
      continuous_fst.comp_continuousOn h_pts_diff.continuousOn

    have hL0_open : IsOpen (Layer0 n) := by
      have h_pre : IsOpen (Ω_T2 ∩ (fun p : ℂ × ℂ => (physToSheared seq n p).1) ⁻¹'
          { z : ℂ | z.im < H_cut_0 }) :=
        h_fst_pts_cont.isOpen_inter_preimage hΩ_open
          (isOpen_lt Complex.continuous_im continuous_const)
      have h_eq : Layer0 n = U_phys n ∩
          (Ω_T2 ∩ (fun p : ℂ × ℂ => (physToSheared seq n p).1) ⁻¹'
            { z : ℂ | z.im < H_cut_0 }) := by
        ext p
        exact ⟨fun h => ⟨h.1, h.2.1, h.2.2⟩, fun h => ⟨h.1, h.2.1, h.2.2⟩⟩
      rw [h_eq]
      exact hU0_dvc.1.inter h_pre
    have hL1_open : IsOpen (Layer1 n) :=
      h_fst_pts_cont.isOpen_inter_preimage hΩ_open (h_rect_open _ _ _ _)
    have hL2_open : IsOpen (Layer2 sgn n) :=
      h_fst_pts_cont.isOpen_inter_preimage hΩ_open (h_rect_open _ _ _ _)
    have hGlued_open : IsOpen (GluedDom sgn n) :=
      (hL0_open.union hL1_open).union hL2_open

    
    have h_disj_02 : ∀ p : ℂ × ℂ, p ∈ Layer0 n → p ∉ Layer2 sgn n := by
      intro p hp0 hp2
      have h1 : (physToSheared seq n p).1.im < H_cut_0 := hp0.2.2
      have h2 : Real.log M.R - (19 / 4 : ℝ) * ν' < (physToSheared seq n p).1.im :=
        hp2.2.2.2.1
      linarith
    have h_ov_10 : ∀ p : ℂ × ℂ, p ∈ Layer1 n →
        (physToSheared seq n p).1.im < H_cut_0 →
        p ∈ Layer0 n ∧
        expBasePt seq n + (ℓ_n : ℂ) * S₁ n (physToSheared seq n p) = s_tilde n p := by
      intro p hp1 hp_im
      have hq_mem : physToSheared seq n p ∈
          complexRect (-X₁) X₁ H_1_bot H_cut_0 ×ˢ U_T_1 :=
        ⟨⟨hp1.2.1, hp1.2.2.1, hp1.2.2.2.1, hp_im⟩, h_UT2_sub_UT1 hp1.1⟩
      obtain ⟨hp_phys, h_eq⟩ := hS₁_attach (physToSheared seq n p) hq_mem
      rw [h_inv p] at hp_phys h_eq
      exact ⟨⟨hp_phys, hp1.1, hp_im⟩, h_eq⟩
    obtain ⟨hx_sgn_lo, hx_sgn_hi⟩ := h_x_bounds sgn hsgn
    have h_ov_21 : ∀ p : ℂ × ℂ, p ∈ Layer2 sgn n →
        (physToSheared seq n p).1.im < H_cut_1 →
        p ∈ Layer1 n ∧
        S₂ n (physToSheared seq n p) = S₁ n (physToSheared seq n p) := by
      intro p hp2 hp_im
      have hp1 : p ∈ Layer1 n :=
        ⟨hp2.1, ⟨by linarith [hp2.2.1, M.δ_θ_pos],
          by linarith [hp2.2.2.1, M.δ_θ_pos],
          by linarith [hp2.2.2.2.1], hp_im⟩⟩
      have h_eq : S₂ n (physToSheared seq n p) = S₁ n (physToSheared seq n p) :=
        hS₂_eq n hn₂ (physToSheared seq n p) ⟨hp2.2, hp2.1⟩
          (by dsimp [H_cut_1] at hp_im; linarith)
      exact ⟨hp1, h_eq⟩

    have h_fn_on_L2 : ∀ p ∈ Layer2 sgn n,
        GluedFn sgn S₂ n p =
          expBasePt seq n + (ℓ_n : ℂ) * S₂ n (physToSheared seq n p) := by
      intro p hp2
      dsimp [GluedFn]
      rw [if_pos hp2]
    have h_fn_on_L1 : ∀ p ∈ Layer1 n,
        GluedFn sgn S₂ n p =
          expBasePt seq n + (ℓ_n : ℂ) * S₁ n (physToSheared seq n p) := by
      intro p hp1
      dsimp [GluedFn]
      by_cases hp2 : p ∈ Layer2 sgn n
      · rw [if_pos hp2, (h_ov_21 p hp2 hp1.2.2.2.2).2]
      · rw [if_neg hp2, if_pos hp1]
    have h_fn_on_L0 : ∀ p ∈ Layer0 n, GluedFn sgn S₂ n p = s_tilde n p := by
      intro p hp0
      have hp_not_2 : p ∉ Layer2 sgn n := h_disj_02 p hp0
      dsimp [GluedFn]
      rw [if_neg hp_not_2]
      by_cases hp1 : p ∈ Layer1 n
      · rw [if_pos hp1]
        exact (h_ov_10 p hp1 hp0.2.2).2
      · rw [if_neg hp1]

    have h_maps_L1 : Set.MapsTo (physToSheared seq n) (Layer1 n) (R_1_full ×ˢ U_T_1) := by
      intro p hp1
      have hp1_im : (physToSheared seq n p).1.im < H_cut_1 := hp1.2.2.2.2
      exact ⟨⟨hp1.2.1, hp1.2.2.1, hp1.2.2.2.1,
        by dsimp [H_cut_1] at hp1_im; linarith⟩, h_UT2_sub_UT1 hp1.1⟩
    have h_maps_L2 : Set.MapsTo (physToSheared seq n) (Layer2 sgn n)
        (Rect2 sgn ×ˢ U_T_2) :=
      fun _ hp2 => ⟨hp2.2, hp2.1⟩

    have h_holo_L0 : DifferentiableOn ℂ (GluedFn sgn S₂ n) (Layer0 n) :=
      (hs_tilde_holo.mono (fun _ hp0 => hp0.1)).congr h_fn_on_L0
    have h_holo_L1 : DifferentiableOn ℂ (GluedFn sgn S₂ n) (Layer1 n) := by
      have hc : DifferentiableOn ℂ (fun p => S₁ n (physToSheared seq n p)) (Layer1 n) :=
        hS₁_holo.fun_comp (h_pts_diff.mono (fun _ hp1 => hp1.1)) h_maps_L1
      exact (DifferentiableOn.const_add (expBasePt seq n)
        (hc.const_mul (ℓ_n : ℂ))).congr h_fn_on_L1
    have h_holo_L2 : DifferentiableOn ℂ (GluedFn sgn S₂ n) (Layer2 sgn n) := by
      have hc : DifferentiableOn ℂ (fun p => S₂ n (physToSheared seq n p)) (Layer2 sgn n) :=
        (hS₂_holo n hn₂).fun_comp (h_pts_diff.mono (fun _ hp2 => hp2.1)) h_maps_L2
      exact (DifferentiableOn.const_add (expBasePt seq n)
        (hc.const_mul (ℓ_n : ℂ))).congr h_fn_on_L2

    have hGlued_holo : DifferentiableOn ℂ (GluedFn sgn S₂ n) (GluedDom sgn n) := by
      intro p hp
      rcases hp with (hp0 | hp1) | hp2
      · exact (h_holo_L0.differentiableAt (hL0_open.mem_nhds hp0)).differentiableWithinAt
      · exact (h_holo_L1.differentiableAt (hL1_open.mem_nhds hp1)).differentiableWithinAt
      · exact (h_holo_L2.differentiableAt (hL2_open.mem_nhds hp2)).differentiableWithinAt

    have hGlued_strip : ∀ p ∈ GluedDom sgn n, GluedFn sgn S₂ n p ∈ X.D_strip := by
      intro p hp
      rcases hp with (hp0 | hp1) | hp2
      · rw [h_fn_on_L0 p hp0]
        exact hs_tilde_strip p hp0.1
      · rw [h_fn_on_L1 p hp1]
        exact hS₁_strip _ (h_maps_L1 hp1)
      · rw [h_fn_on_L2 p hp2]
        exact hS₂_strip n hn₂ _ (h_maps_L2 hp2)

    
    let y_shift : ℂ → ℝ → ℂ := fun y s => (y.re : ℂ) + (s : ℂ) * Complex.I
    have h_pts_vert : ∀ (y t : ℂ) (s : ℝ),
        (physToSheared seq n (y_shift y s, t)).1 =
          (physToSheared seq n (y, t)).1 + (((s - y.im) / ℓ_n : ℝ) : ℂ) * Complex.I ∧
        (physToSheared seq n (y_shift y s, t)).2 = (physToSheared seq n (y, t)).2 := by
      intro y t s
      refine ⟨?_, rfl⟩
      have hy_diff : y_shift y s - expBasePt seq n =
          (y - expBasePt seq n) + ((s - y.im : ℝ) : ℂ) * Complex.I := by
        apply Complex.ext <;> simp [y_shift]
      dsimp [physToSheared]
      change (y_shift y s - expBasePt seq n) / (ℓ_n : ℂ) -
          expShearOffset T_star ((m_n : ℂ) * t) =
        ((y - expBasePt seq n) / (ℓ_n : ℂ) -
          expShearOffset T_star ((m_n : ℂ) * t)) +
          (((s - y.im) / ℓ_n : ℝ) : ℂ) * Complex.I
      rw [hy_diff]
      push_cast
      ring

    have h_dvc_L0 : ∀ y t : ℂ, (y, t) ∈ Layer0 n → 0 ≤ y.im →
        ∀ τ : ℝ, 0 ≤ τ → τ ≤ y.im → (y_shift y τ, t) ∈ Layer0 n := by
      intro y t hyt hy_im τ hτ0 hτy
      have h_phys : (y_shift y τ, t) ∈ U_phys n := hU0_dvc.2 y t hyt.1 hy_im τ hτ0 hτy
      have h_div_nonpos : (τ - y.im) / ℓ_n ≤ 0 :=
        (div_le_iff₀ hℓ_pos).mpr (by linarith)
      have him_eq : (physToSheared seq n (y_shift y τ, t)).1.im =
          (physToSheared seq n (y, t)).1.im + (τ - y.im) / ℓ_n := by
        rw [(h_pts_vert y t τ).1]
        simp
      exact ⟨h_phys, hyt.2.1, by linarith [hyt.2.2]⟩

    have h_dvc_L1 : ∀ y t : ℂ, (y, t) ∈ Layer1 n → 0 ≤ y.im →
        ∀ τ : ℝ, 0 ≤ τ → τ ≤ y.im → (y_shift y τ, t) ∈ Layer0 n ∪ Layer1 n := by
      intro y t hyt hy_im τ hτ0 hτy
      let q_im : ℝ := (physToSheared seq n (y, t)).1.im
      have h_re_eq : (physToSheared seq n (y_shift y τ, t)).1.re =
          (physToSheared seq n (y, t)).1.re := by
        rw [(h_pts_vert y t τ).1]
        simp
      have h_im_eq : (physToSheared seq n (y_shift y τ, t)).1.im =
          q_im + (τ - y.im) / ℓ_n := by
        rw [(h_pts_vert y t τ).1]
        simp [q_im]
      have h_div_nonpos : (τ - y.im) / ℓ_n ≤ 0 :=
        (div_le_iff₀ hℓ_pos).mpr (by linarith)
      by_cases h_stay : H_1_bot < q_im + (τ - y.im) / ℓ_n
      · exact Or.inr ⟨hyt.1, by rw [h_re_eq]; exact hyt.2.1,
          by rw [h_re_eq]; exact hyt.2.2.1,
          by rw [h_im_eq]; exact h_stay,
          by rw [h_im_eq]; linarith [hyt.2.2.2.2]⟩
      · push Not at h_stay
        let h_target_0 : ℝ := (H_1_bot + min H_cut_0 q_im) / 2
        let τ_0 : ℝ := y.im + ℓ_n * (h_target_0 - q_im)
        have h_min_gt : H_1_bot < min H_cut_0 q_im :=
          lt_min (by linarith) hyt.2.2.2.1
        have h_t0_gt : H_1_bot < h_target_0 := by dsimp [h_target_0]; linarith
        have h_t0_lt_cut : h_target_0 < H_cut_0 := by
          have : min H_cut_0 q_im ≤ H_cut_0 := min_le_left _ _
          dsimp [h_target_0]
          linarith
        have h_t0_lt_q : h_target_0 < q_im := by
          have : min H_cut_0 q_im ≤ q_im := min_le_right _ _
          dsimp [h_target_0]
          linarith
        have hτ_lt_τ0 : τ < τ_0 := by
          have h1 : (τ - y.im) / ℓ_n < h_target_0 - q_im := by linarith
          have h2 : τ - y.im < (h_target_0 - q_im) * ℓ_n := (div_lt_iff₀ hℓ_pos).mp h1
          dsimp [τ_0]
          linarith
        have h_im_τ0 : (physToSheared seq n (y_shift y τ_0, t)).1.im = h_target_0 := by
          have h1 : (physToSheared seq n (y_shift y τ_0, t)).1.im =
              q_im + (τ_0 - y.im) / ℓ_n := by
            rw [(h_pts_vert y t τ_0).1]
            simp [q_im]
          have h2 : (τ_0 - y.im) / ℓ_n = h_target_0 - q_im := by
            dsimp [τ_0]
            field_simp [hℓ_pos.ne']
            ring
          linarith
        have h_re_τ0 : (physToSheared seq n (y_shift y τ_0, t)).1.re =
            (physToSheared seq n (y, t)).1.re := by
          rw [(h_pts_vert y t τ_0).1]
          simp
        have h_mem_L1_τ0 : (y_shift y τ_0, t) ∈ Layer1 n :=
          ⟨hyt.1, by rw [h_re_τ0]; exact hyt.2.1,
            by rw [h_re_τ0]; exact hyt.2.2.1,
            by rw [h_im_τ0]; exact h_t0_gt,
            by rw [h_im_τ0]; linarith [hyt.2.2.2.2]⟩
        have h_mem_L0_τ0 : (y_shift y τ_0, t) ∈ Layer0 n :=
          (h_ov_10 (y_shift y τ_0, t) h_mem_L1_τ0 (by rw [h_im_τ0]; exact h_t0_lt_cut)).1
        have hy_shift_idem : y_shift (y_shift y τ_0) τ = y_shift y τ := by
          apply Complex.ext <;> simp [y_shift]
        have hy_τ0_im : (y_shift y τ_0).im = τ_0 := by simp [y_shift]
        have h_step0 := h_dvc_L0 (y_shift y τ_0) t h_mem_L0_τ0
          (by rw [hy_τ0_im]; linarith) τ hτ0 (by rw [hy_τ0_im]; linarith)
        rw [hy_shift_idem] at h_step0
        exact Or.inl h_step0

    have h_dvc_L2 : ∀ y t : ℂ, (y, t) ∈ Layer2 sgn n → 0 ≤ y.im →
        ∀ τ : ℝ, 0 ≤ τ → τ ≤ y.im → (y_shift y τ, t) ∈ GluedDom sgn n := by
      intro y t hyt hy_im τ hτ0 hτy
      let H_2_bot : ℝ := Real.log M.R - (19 / 4 : ℝ) * ν'
      let q_im : ℝ := (physToSheared seq n (y, t)).1.im
      have h_re_eq : (physToSheared seq n (y_shift y τ, t)).1.re =
          (physToSheared seq n (y, t)).1.re := by
        rw [(h_pts_vert y t τ).1]
        simp
      have h_im_eq : (physToSheared seq n (y_shift y τ, t)).1.im =
          q_im + (τ - y.im) / ℓ_n := by
        rw [(h_pts_vert y t τ).1]
        simp [q_im]
      have h_div_nonpos : (τ - y.im) / ℓ_n ≤ 0 :=
        (div_le_iff₀ hℓ_pos).mpr (by linarith)
      by_cases h_stay : H_2_bot < q_im + (τ - y.im) / ℓ_n
      · exact Or.inr ⟨hyt.1, by rw [h_re_eq]; exact hyt.2.1,
          by rw [h_re_eq]; exact hyt.2.2.1,
          by rw [h_im_eq]; exact h_stay,
          by rw [h_im_eq]; linarith [hyt.2.2.2.2]⟩
      · push Not at h_stay
        let h_target_1 : ℝ := (H_2_bot + min H_cut_1 q_im) / 2
        let τ_1 : ℝ := y.im + ℓ_n * (h_target_1 - q_im)
        have h_min_gt : H_2_bot < min H_cut_1 q_im :=
          lt_min (by dsimp [H_2_bot, H_cut_1]; linarith) hyt.2.2.2.1
        have h_t1_gt : H_2_bot < h_target_1 := by dsimp [h_target_1]; linarith
        have h_t1_lt_cut : h_target_1 < H_cut_1 := by
          have : min H_cut_1 q_im ≤ H_cut_1 := min_le_left _ _
          dsimp [h_target_1]
          linarith
        have h_t1_lt_q : h_target_1 < q_im := by
          have : min H_cut_1 q_im ≤ q_im := min_le_right _ _
          dsimp [h_target_1]
          linarith
        have hτ_lt_τ1 : τ < τ_1 := by
          have h1 : (τ - y.im) / ℓ_n < h_target_1 - q_im := by linarith
          have h2 : τ - y.im < (h_target_1 - q_im) * ℓ_n := (div_lt_iff₀ hℓ_pos).mp h1
          dsimp [τ_1]
          linarith
        have h_im_τ1 : (physToSheared seq n (y_shift y τ_1, t)).1.im = h_target_1 := by
          have h1 : (physToSheared seq n (y_shift y τ_1, t)).1.im =
              q_im + (τ_1 - y.im) / ℓ_n := by
            rw [(h_pts_vert y t τ_1).1]
            simp [q_im]
          have h2 : (τ_1 - y.im) / ℓ_n = h_target_1 - q_im := by
            dsimp [τ_1]
            field_simp [hℓ_pos.ne']
            ring
          linarith
        have h_re_τ1 : (physToSheared seq n (y_shift y τ_1, t)).1.re =
            (physToSheared seq n (y, t)).1.re := by
          rw [(h_pts_vert y t τ_1).1]
          simp
        have h_mem_L2_τ1 : (y_shift y τ_1, t) ∈ Layer2 sgn n :=
          ⟨hyt.1, by rw [h_re_τ1]; exact hyt.2.1,
            by rw [h_re_τ1]; exact hyt.2.2.1,
            by rw [h_im_τ1]; exact h_t1_gt,
            by rw [h_im_τ1]; linarith [hyt.2.2.2.2]⟩
        have h_mem_L1_τ1 : (y_shift y τ_1, t) ∈ Layer1 n :=
          (h_ov_21 (y_shift y τ_1, t) h_mem_L2_τ1 (by rw [h_im_τ1]; exact h_t1_lt_cut)).1
        have hy_shift_idem : y_shift (y_shift y τ_1) τ = y_shift y τ := by
          apply Complex.ext <;> simp [y_shift]
        have hy_τ1_im : (y_shift y τ_1).im = τ_1 := by simp [y_shift]
        have h_step1 := h_dvc_L1 (y_shift y τ_1) t h_mem_L1_τ1
          (by rw [hy_τ1_im]; linarith) τ hτ0 (by rw [hy_τ1_im]; linarith)
        rw [hy_shift_idem] at h_step1
        exact Or.inl h_step1

    have hGlued_dvc : IsDownwardVertConvex (GluedDom sgn n) := by
      refine ⟨hGlued_open, ?_⟩
      intro y t hyt hy_im τ hτ0 hτy
      rcases hyt with (hp0 | hp1) | hp2
      · exact Or.inl (Or.inl (h_dvc_L0 y t hp0 hy_im τ hτ0 hτy))
      · exact Or.inl (h_dvc_L1 y t hp1 hy_im τ hτ0 hτy)
      · exact h_dvc_L2 y t hp2 hy_im τ hτ0 hτy

    
    let t₀_n : ℝ := T_star / m_n
    let x₀_n : ℝ := seq.x_seq n + ℓ_n * (α_c - sgn * M.θ)
    have hδ_zero_pos : 0 < δ_zero n :=
      lt_min (lt_min (by positivity) hℓ_pos) (by positivity)
    have hm_t₀ : (m_n : ℂ) * (t₀_n : ℂ) = (T_star : ℂ) := by
      dsimp [t₀_n]
      push_cast
      field_simp [hm_ne]

    have h_base_poly : ∀ y t : ℂ, ‖y - (x₀_n : ℂ)‖ < δ_zero n →
        ‖t - (t₀_n : ℂ)‖ < δ_zero n →
        (y, t) ∈ GluedDom sgn n ∧ GluedFn sgn S₂ n (y, t) = X.𝔰 (y, t) := by
      intro y t hy_ball ht_ball
      have hδz_le1 : δ_zero n ≤ δ_base n / 2 :=
        le_trans (min_le_left _ _) (min_le_left _ _)
      have hδz_le2 : δ_zero n ≤ ℓ_n :=
        le_trans (min_le_left _ _) (min_le_right _ _)
      have hδz_le3 : δ_zero n ≤ η₂ / (6 * m_n) := min_le_right _ _
      have hy_im_abs : |y.im| < δ_zero n := by
        have h1 := Complex.abs_im_le_norm (y - (x₀_n : ℂ))
        have h2 : (y - (x₀_n : ℂ)).im = y.im := by simp
        rw [h2] at h1
        linarith
      have hy_im_base : |y.im| < δ_base n := by linarith
      have hy_im_lt_ℓ : y.im < ℓ_n := by
        rw [abs_lt] at hy_im_abs
        linarith
      have hmt_dist : ‖(m_n : ℂ) * t - (T_star : ℂ)‖ < η₂ / 2 := by
        have h_eq : (m_n : ℂ) * t - (T_star : ℂ) = (m_n : ℂ) * (t - (t₀_n : ℂ)) := by
          rw [← hm_t₀]
          ring
        rw [h_eq, norm_mul, Complex.norm_of_nonneg hm_pos.le]
        have h1 : m_n * ‖t - (t₀_n : ℂ)‖ < m_n * (η₂ / (6 * m_n)) :=
          mul_lt_mul_of_pos_left (lt_of_lt_of_le ht_ball hδz_le3) hm_pos
        have h2 : m_n * (η₂ / (6 * m_n)) = η₂ / 6 := by
          field_simp [hm_pos.ne']
        linarith
      have hmt_UT2 : (m_n : ℂ) * t ∈ U_T_2 := by
        simpa [U_T_2, Metric.mem_ball, dist_eq_norm] using hmt_dist
      have hmt_all : (m_n : ℂ) * t ∈ U_T_all := h_UT2_sub_all hmt_UT2
      obtain ⟨_, hmt_norm, hβ_im, _⟩ := hBridge.shear_holo_bounds.2 ((m_n : ℂ) * t) hmt_all
      have ht_norm : ‖t‖ < 4 * T_star / m_n := by
        rw [norm_mul, Complex.norm_of_nonneg hm_pos.le] at hmt_norm
        exact (lt_div_iff₀ hm_pos).mpr (by linarith)
      obtain ⟨hyt_phys, hyt_𝔰⟩ := hs_tilde_base y t hy_im_base ht_norm
      have hq_im_lt : (physToSheared seq n (y, t)).1.im < H_cut_0 := by
        have h_lin_eq : (y - expBasePt seq n) / (ℓ_n : ℂ) =
            (((y.re - seq.x_seq n) / ℓ_n : ℝ) : ℂ) +
              (((y.im - seq.h_seq n) / ℓ_n : ℝ) : ℂ) * Complex.I := by
          have hy_sub : y - expBasePt seq n =
              ((y.re - seq.x_seq n : ℝ) : ℂ) +
                ((y.im - seq.h_seq n : ℝ) : ℂ) * Complex.I := by
            apply Complex.ext <;> simp [expBasePt]
          rw [hy_sub]
          push_cast
          ring
        have hq_im_eq : (physToSheared seq n (y, t)).1.im =
            y.im / ℓ_n - seq.h_seq n / ℓ_n -
              (expShearOffset T_star ((m_n : ℂ) * t)).im := by
          dsimp [physToSheared]
          change ((y - expBasePt seq n) / (ℓ_n : ℂ) -
              expShearOffset T_star ((m_n : ℂ) * t)).im = _
          rw [Complex.sub_im, h_lin_eq]
          simp [sub_div]
        have hy_div_lt : y.im / ℓ_n < 1 := (div_lt_one hℓ_pos).mpr hy_im_lt_ℓ
        rw [abs_lt] at hβ_im
        rw [hq_im_eq]
        linarith
      have hyt_L0 : (y, t) ∈ Layer0 n := ⟨hyt_phys, hmt_UT2, hq_im_lt⟩
      exact ⟨Or.inl (Or.inl hyt_L0), (h_fn_on_L0 (y, t) hyt_L0).trans hyt_𝔰⟩

    have h_slice_Z : ∀ Z ∈ Rect2 sgn,
        (expBasePt seq n + (ℓ_n : ℂ) * Z, (t₀_n : ℂ)) ∈ GluedDom sgn n ∧
        rescaledLift seq (GluedFn sgn S₂ n) n Z (T_star : ℂ) =
          S₂ n (Z, (T_star : ℂ)) := by
      intro Z hZ
      let pZ : ℂ × ℂ := (expBasePt seq n + (ℓ_n : ℂ) * Z, (t₀_n : ℂ))
      have h_pts_pZ : physToSheared seq n pZ = (Z, (T_star : ℂ)) := by
        ext
        · dsimp [physToSheared, pZ]
          change ((expBasePt seq n + (ℓ_n : ℂ) * Z - expBasePt seq n) / (ℓ_n : ℂ) -
              expShearOffset T_star ((m_n : ℂ) * (t₀_n : ℂ))) = Z
          rw [hm_t₀, hBridge.shear_zero, sub_zero]
          field_simp [hℓ_ne]
          ring
        · dsimp [physToSheared, pZ]
          exact hm_t₀
      have hpZ_L2 : pZ ∈ Layer2 sgn n := by
        refine ⟨?_, ?_⟩
        · change (m_n : ℂ) * (t₀_n : ℂ) ∈ U_T_2
          rw [hm_t₀]
          exact hT_star_mem_UT2
        · rw [h_pts_pZ]
          exact hZ
      refine ⟨Or.inr hpZ_L2, ?_⟩
      have ht₀_eq : (T_star : ℂ) / (m_n : ℂ) = (t₀_n : ℂ) := by
        dsimp [t₀_n]
        push_cast
        rfl
      dsimp [rescaledLift]
      change (GluedFn sgn S₂ n (expBasePt seq n + (ℓ_n : ℂ) * Z,
          (T_star : ℂ) / (m_n : ℂ)) - expBasePt seq n) / (ℓ_n : ℂ) = _
      rw [ht₀_eq]
      change (GluedFn sgn S₂ n pZ - expBasePt seq n) / (ℓ_n : ℂ) = _
      rw [h_fn_on_L2 pZ hpZ_L2, h_pts_pZ]
      field_simp [hℓ_ne]
      ring

    have h_vert_seg : ∀ η : ℝ, 0 ≤ η →
        η ≤ seq.h_seq n + ℓ_n * (Real.log M.R + 3 * ν' / 4) →
        ((x₀_n : ℂ) + (η : ℂ) * Complex.I, (t₀_n : ℂ)) ∈ GluedDom sgn n := by
      intro η hη0 hη_hi
      let b_n : ℝ := seq.h_seq n + ℓ_n * (Real.log M.R + 3 * ν' / 4)
      have hb_pos : 0 < b_n := by
        have h_abs : -|Real.log M.R| ≤ Real.log M.R := neg_abs_le _
        have h_gt : (|Real.log M.R| + 2) * ℓ_n < seq.h_seq n :=
          (lt_div_iff₀ hℓ_pos).mp hh_ratio_2
        dsimp [b_n]
        nlinarith
      let Z_top : ℂ :=
        ((α_c - sgn * M.θ : ℝ) : ℂ) +
          ((Real.log M.R + 3 * ν' / 4 : ℝ) : ℂ) * Complex.I
      have hZ_top_mem : Z_top ∈ Rect2 sgn := by
        refine ⟨?_, ?_, ?_, ?_⟩ <;> simp [Z_top] <;> linarith [M.δ_θ_pos]
      have hp_top_eq : expBasePt seq n + (ℓ_n : ℂ) * Z_top =
          (x₀_n : ℂ) + (b_n : ℂ) * Complex.I := by
        apply Complex.ext <;> simp [expBasePt, Z_top, x₀_n, b_n] <;> ring
      have hp_top_mem : ((x₀_n : ℂ) + (b_n : ℂ) * Complex.I, (t₀_n : ℂ)) ∈
          GluedDom sgn n := by
        rw [← hp_top_eq]
        exact (h_slice_Z Z_top hZ_top_mem).1
      have h_dvc_app := hGlued_dvc.2 ((x₀_n : ℂ) + (b_n : ℂ) * Complex.I) (t₀_n : ℂ)
        hp_top_mem (by simp; linarith) η hη0 (by simp; exact hη_hi)
      have h_re_simp : (((x₀_n : ℂ) + (b_n : ℂ) * Complex.I).re : ℂ) = (x₀_n : ℂ) := by
        simp
      rwa [h_re_simp] at h_dvc_app

    exact ⟨hGlued_dvc, hδ_zero_pos, hGlued_holo, hGlued_strip,
      h_base_poly, h_vert_seg, h_slice_Z⟩

  
  let U_plus : ℕ → Set (ℂ × ℂ) := GluedDom 1
  let U_minus : ℕ → Set (ℂ × ℂ) := GluedDom (-1)
  let s_plus : ℕ → ℂ × ℂ → ℂ := GluedFn 1 S₂_plus
  let s_minus : ℕ → ℂ × ℂ → ℂ := GluedFn (-1) S₂_minus

  have h_one_sub : α_c - (1 : ℝ) * M.θ = α_c - M.θ := by ring
  have h_neg_one_sub : α_c - (-1 : ℝ) * M.θ = α_c + M.θ := by ring
  have hY_plus_eq : TargetCenter 1 =
      ((α_c - M.θ : ℝ) : ℂ) + ((Real.log M.R + ν' / 2 : ℝ) : ℂ) * Complex.I := by
    simp [TargetCenter]
  have hY_minus_eq : TargetCenter (-1) =
      ((α_c + M.θ : ℝ) : ℂ) + ((Real.log M.R + ν' / 2 : ℝ) : ℂ) * Complex.I := by
    dsimp [TargetCenter]
    rw [h_neg_one_sub]

  refine ⟨{
    ν' := ν'
    ε_patch := ε_patch
    N_patch := N_patch
    U_plus := U_plus
    U_minus := U_minus
    s_plus := s_plus
    s_minus := s_minus
    δ_zero := δ_zero
    ν'_pos := hν'_pos
    ν'_lt := hν'_lt
    ε_patch_pos := hε_patch_pos
    ε_patch_lt_ν := hε_patch_lt_ν
    ε_patch_lt_δ := hε_patch_lt_δ
    patch_props := ?_
    conv_plus := ?_
    conv_minus := ?_
  }⟩
  · intro n hn
    have hn₁ : N₁ ≤ n := le_trans (le_trans (le_max_left _ _) (le_max_left _ _)) hn
    have hnh : N_h ≤ n := le_trans (le_trans (le_max_right _ _) (le_max_left _ _)) hn
    have hn₂_p : N₂_plus ≤ n := le_trans (le_trans (le_max_left _ _) (le_max_right _ _)) hn
    have hn₂_m : N₂_minus ≤ n :=
      le_trans (le_trans (le_max_left _ _) (le_trans (le_max_right _ _) (le_max_right _ _))) hn
    have hn_rec : N_rec ≤ n :=
      le_trans (le_trans (le_max_right _ _) (le_trans (le_max_right _ _) (le_max_right _ _))) hn
    obtain ⟨h_dvc_p, hδz_pos, h_holo_p, h_strip_p, h_base_p, h_vert_p, h_slice_p⟩ :=
      h_gluing 1 S₂_plus N₂_plus (Or.inl rfl)
        hS₂_plus_holo hS₂_plus_strip hS₂_plus_eq n hn₁ hn₂_p hnh
    obtain ⟨h_dvc_m, _, h_holo_m, h_strip_m, h_base_m, _, h_slice_m⟩ :=
      h_gluing (-1) S₂_minus N₂_minus (Or.inr rfl)
        hS₂_minus_holo hS₂_minus_strip hS₂_minus_eq n hn₁ hn₂_m hnh
    dsimp only [] at h_base_p h_vert_p h_base_m ⊢
    rw [h_one_sub] at h_base_p h_vert_p
    rw [h_neg_one_sub] at h_base_m
    refine ⟨h_dvc_p, h_dvc_m, hδz_pos, h_holo_p, h_strip_p, h_holo_m, h_strip_m,
      h_base_p, h_base_m, h_vert_p, ?_, ?_, ?_⟩
    · intro Z hZ
      have hZ' : Z ∈ Metric.ball (TargetCenter 1) (3 * ε_patch) := by
        rw [hY_plus_eq]
        exact hZ
      exact (h_slice_p Z (h_ball_sub_rect2 1 hZ')).1
    · intro Z hZ
      have hZ' : Z ∈ Metric.ball (TargetCenter (-1)) (3 * ε_patch) := by
        rw [hY_minus_eq]
        exact hZ
      exact (h_slice_m Z (h_ball_sub_rect2 (-1) hZ')).1
    · intro Z hZ hZ_m hZ_p
      have hZ_3 : Z ∈ Metric.ball (TargetCenter 1) (3 * ε_patch) := by
        rw [hY_plus_eq]
        exact Metric.ball_subset_ball (by linarith) hZ
      have hZ_m' :
          Z - (T_star : ℂ) / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ) ∈
            Metric.ball (TargetCenter 1) (3 * ε_patch) := by
        rw [hY_plus_eq]
        exact hZ_m
      have hZ_p' :
          Z + (T_star : ℂ) / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ) ∈
            Metric.ball (TargetCenter 1) (3 * ε_patch) := by
        rw [hY_plus_eq]
        exact hZ_p
      have h_eq_W : ∀ W ∈ Metric.ball (TargetCenter 1) (3 * ε_patch),
          S₂_plus n (W, (T_star : ℂ)) =
            rescaledLift seq (s_plus n) n W (T_star : ℂ) :=
        fun W hW => (h_slice_p W (h_ball_sub_rect2 1 hW)).2.symm
      exact h_rec_congr
        (fun W => S₂_plus n (W, (T_star : ℂ)))
        (fun W => rescaledLift seq (s_plus n) n W (T_star : ℂ))
        n Z (T_star : ℂ)
        (h_eq_W _ hZ_m') (h_eq_W _ hZ_3) (h_eq_W _ hZ_p')
        (hS₂_plus_rec n hn_rec Z hZ_3)
  · have hc := h_slice_conv 1 S₂_plus hS₂_plus_conv
    rw [hY_plus_eq] at hc
    refine hc.congr (Filter.eventually_atTop.mpr ⟨N_patch, fun n hn Z hZ => ?_⟩)
    have hn₁ : N₁ ≤ n := le_trans (le_trans (le_max_left _ _) (le_max_left _ _)) hn
    have hnh : N_h ≤ n := le_trans (le_trans (le_max_right _ _) (le_max_left _ _)) hn
    have hn₂_p : N₂_plus ≤ n := le_trans (le_trans (le_max_left _ _) (le_max_right _ _)) hn
    obtain ⟨_, _, _, _, _, _, h_slice_p⟩ :=
      h_gluing 1 S₂_plus N₂_plus (Or.inl rfl)
        hS₂_plus_holo hS₂_plus_strip hS₂_plus_eq n hn₁ hn₂_p hnh
    have hZ_ball : Z ∈ Metric.ball (TargetCenter 1) (3 * ε_patch) := by
      rw [hY_plus_eq]
      exact Metric.closedBall_subset_ball (by linarith) hZ
    exact (h_slice_p Z (h_ball_sub_rect2 1 hZ_ball)).2.symm
  · have hc := h_slice_conv (-1) S₂_minus hS₂_minus_conv
    rw [hY_minus_eq] at hc
    refine hc.congr (Filter.eventually_atTop.mpr ⟨N_patch, fun n hn Z hZ => ?_⟩)
    have hn₁ : N₁ ≤ n := le_trans (le_trans (le_max_left _ _) (le_max_left _ _)) hn
    have hnh : N_h ≤ n := le_trans (le_trans (le_max_right _ _) (le_max_left _ _)) hn
    have hn₂_m : N₂_minus ≤ n :=
      le_trans (le_trans (le_max_left _ _) (le_trans (le_max_right _ _) (le_max_right _ _))) hn
    obtain ⟨_, _, _, _, _, _, h_slice_m⟩ :=
      h_gluing (-1) S₂_minus N₂_minus (Or.inr rfl)
        hS₂_minus_holo hS₂_minus_strip hS₂_minus_eq n hn₁ hn₂_m hnh
    have hZ_ball : Z ∈ Metric.ball (TargetCenter (-1)) (3 * ε_patch) := by
      rw [hY_minus_eq]
      exact Metric.closedBall_subset_ball (by linarith) hZ
    exact (h_slice_m Z (h_ball_sub_rect2 (-1) hZ_ball)).2.symm

theorem logarithmic_disk_radial_bypass_patches (X : ExpStripData) (hX : IsExpObstructionStrip X)
    (P : ChordActionPackage X) (kind : ExpProfileKind)
    (seq : ExpSequenceData X kind)
    (hDeep : DeepInitializedModelData X P kind seq)
    (M : BranchMonodromyPackage kind)
    (hDisk : DiskContinuationToolkitProp)
    (hTrack : RegularCorridorTrackingProp X P kind seq) :
    Nonempty (RadialBypassPatchesData X P kind seq M) :=
by
  have hBridge := sheared_inner_model_and_deep_bridge X P kind seq hDeep M
  have hLift := sheared_disk_continuation_step X hX P kind seq hDisk hTrack
  have hRec := vertical_chord_recurrence_propagation X P kind seq hDisk
  have hStage1 := stage_one_sheared_ball_continuation X P kind seq M hDisk hBridge hLift hRec
  exact stage_two_radial_patches_and_gluing X hX P kind seq M hDisk hBridge hLift hRec hStage1

theorem horizontal_promotion_and_monodromy_contradiction (X : ExpStripData) (hX : IsExpObstructionStrip X)
    (P : ChordActionPackage X) (kind : ExpProfileKind)
    (seq : ExpSequenceData X kind)
    (M : BranchMonodromyPackage kind)
    (hDisk : DiskContinuationToolkitProp)
    (hTrack : RegularCorridorTrackingProp X P kind seq)
    (B : RadialBypassPatchesData X P kind seq M) :
    False :=
by
  let T_star : ℝ := (‖seq.c₀‖)⁻¹
  let α_c : ℝ := Complex.arg seq.c₀
  let Y_plus : ℂ :=
    ((α_c - M.θ : ℝ) : ℂ) + ((Real.log M.R + B.ν' / 2 : ℝ) : ℂ) * Complex.I
  let Y_minus : ℂ :=
    ((α_c + M.θ : ℝ) : ℂ) + ((Real.log M.R + B.ν' / 2 : ℝ) : ℂ) * Complex.I
  let S_true : ℕ → ℂ → ℂ := fun n Z => rescaledLift seq X.𝔰 n Z (T_star : ℂ)
  let w_map : ℂ × ℂ → ℂ := fun p => p.2 * seq.c₀ * Complex.exp (-Complex.I * p.1)
  let Ω_out : Set ℂ := branchOuterDomain M.R M.ν M.θ M.δ_θ
  let V_outer : Set (ℂ × ℂ) := { p : ℂ × ℂ | w_map p ∈ Ω_out }
  let S_outer : ℂ × ℂ → ℂ := fun p => p.1 + M.Δ_outer (w_map p)
  let F_inner : ℂ → ℂ := fun Z =>
    Z + M.Δ_inner ((T_star : ℂ) * seq.c₀ * Complex.exp (-Complex.I * Z))
  let H_band : Set ℂ :=
    { Z : ℂ | |Z.im - (Real.log M.R + B.ν' / 2)| < 3 * B.ε_patch }
  have hc₀_norm_pos : 0 < ‖seq.c₀‖ := norm_pos_iff.mpr seq.c₀_ne_zero
  have hT_pos : 0 < T_star := inv_pos.mpr hc₀_norm_pos
  have hT_c_ne : (T_star : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hT_pos.ne'
  have hε_pos : 0 < B.ε_patch := B.ε_patch_pos
  have h3ε_pos : 0 < 3 * B.ε_patch := by positivity

  
  obtain ⟨N₁, hN₁⟩ := (Filter.tendsto_atTop_atTop.mp seq.m_tendsto) (T_star / X.r_star + 1)
  obtain ⟨N₂, hN₂⟩ := (Filter.tendsto_atTop_atTop.mp seq.h_div_ℓ_tendsto) (|Real.log M.R| + 1)
  let N_prom : ℕ := max (max B.N_patch N₁) N₂
  have hN_prom_ge : B.N_patch ≤ N_prom := le_trans (le_max_left _ _) (le_max_left _ _)
  have hProm : ∀ n ≥ N_prom,
      DifferentiableOn ℂ (S_true n) H_band ∧
      (∀ Z ∈ Metric.ball Y_plus (3 * B.ε_patch),
        S_true n Z = rescaledLift seq (B.s_plus n) n Z (T_star : ℂ)) ∧
      (∀ Z ∈ Metric.ball Y_minus (3 * B.ε_patch),
        S_true n Z = rescaledLift seq (B.s_minus n) n Z (T_star : ℂ)) := by
    intro n hn
    have hn_patch : B.N_patch ≤ n := le_trans hN_prom_ge hn
    have hn₁ : N₁ ≤ n := le_trans (le_trans (le_max_right _ _) (le_max_left _ _)) hn
    have hn₂ : N₂ ≤ n := le_trans (le_max_right _ _) hn
    let ℓ_n : ℝ := seq.ℓ_seq n
    let h_n : ℝ := seq.h_seq n
    let m_n : ℝ := seq.m_seq n
    have hℓ_pos : 0 < ℓ_n := seq.ℓ_pos n
    have hm_pos : 0 < m_n := seq.m_pos n
    let t₀_n : ℝ := T_star / m_n
    let x₀_plus_n : ℝ := seq.x_seq n + ℓ_n * (α_c - M.θ)
    let x₀_minus_n : ℝ := seq.x_seq n + ℓ_n * (α_c + M.θ)
    let b_plus_n : ℝ := h_n + ℓ_n * (Real.log M.R + 3 * B.ν' / 4)
    have ht₀_pos : 0 < t₀_n := div_pos hT_pos hm_pos
    have ht₀_abs : |t₀_n| < X.r_star := by
      rw [abs_of_pos ht₀_pos]
      have hm_ge : T_star / X.r_star + 1 ≤ m_n := hN₁ n hn₁
      have h_mul : (T_star / X.r_star + 1) * X.r_star ≤ m_n * X.r_star :=
        mul_le_mul_of_nonneg_right hm_ge hX.r_star_pos.le
      have h_cancel : (T_star / X.r_star) * X.r_star = T_star :=
        div_mul_cancel₀ T_star hX.r_star_pos.ne'
      exact (div_lt_iff₀ hm_pos).mpr (by linarith [hX.r_star_pos])
    have hh_ge : (|Real.log M.R| + 1) * ℓ_n ≤ h_n :=
      (le_div_iff₀ hℓ_pos).mp (hN₂ n hn₂)
    have h_im_bounds : ∀ Z ∈ H_band,
        0 < (expBasePt seq n + (ℓ_n : ℂ) * Z).im ∧
        (expBasePt seq n + (ℓ_n : ℂ) * Z).im < b_plus_n := by
      intro Z hZ
      change |Z.im - (Real.log M.R + B.ν' / 2)| < 3 * B.ε_patch at hZ
      rw [abs_lt] at hZ
      have hZ_lo : Real.log M.R + B.ν' / 4 < Z.im := by
        linarith [hZ.1, B.ε_patch_lt_ν, B.ν'_pos]
      have hZ_hi : Z.im < Real.log M.R + 3 * B.ν' / 4 := by
        linarith [hZ.2, B.ε_patch_lt_ν, B.ν'_pos]
      have him_eq : (expBasePt seq n + (ℓ_n : ℂ) * Z).im = h_n + ℓ_n * Z.im := by
        simp [expBasePt, h_n, ℓ_n]
      rw [him_eq]
      have h_neg_log : -Real.log M.R ≤ |Real.log M.R| := neg_le_abs _
      have h_mul_lo : ℓ_n * (Real.log M.R + B.ν' / 4) < ℓ_n * Z.im :=
        mul_lt_mul_of_pos_left hZ_lo hℓ_pos
      have h_mul_hi : ℓ_n * Z.im < ℓ_n * (Real.log M.R + 3 * B.ν' / 4) :=
        mul_lt_mul_of_pos_left hZ_hi hℓ_pos
      constructor
      · nlinarith [B.ν'_pos]
      · dsimp [b_plus_n]
        linarith
    have hY_plus_H : Y_plus ∈ H_band := by
      change |Y_plus.im - (Real.log M.R + B.ν' / 2)| < 3 * B.ε_patch
      simp [Y_plus, h3ε_pos]
    have hb_pos : 0 < b_plus_n :=
      lt_trans (h_im_bounds Y_plus hY_plus_H).1 (h_im_bounds Y_plus hY_plus_H).2
    obtain ⟨hU_plus_dvc, hU_minus_dvc, hδ_zero_pos, hs_plus_holo, hs_plus_maps,
      hs_minus_holo, _, h_zero_plus, h_zero_minus, h_seg_plus,
      h_ball_plus, h_ball_minus, _⟩ := B.patch_props n hn_patch
    obtain ⟨δ_tube, hδ_tube_pos, hTube_sub⟩ :=
      hX.real_vertical_promotion t₀_n x₀_plus_n b_plus_n ht₀_abs hb_pos
        ⟨B.U_plus n, hU_plus_dvc.1, h_seg_plus, B.s_plus n, hs_plus_holo,
          hs_plus_maps, B.δ_zero n, hδ_zero_pos, h_zero_plus⟩
    let V_band : Set (ℂ × ℂ) :=
      { p : ℂ × ℂ | |p.1.im| < b_plus_n ∧ ‖p.2 - (t₀_n : ℂ)‖ < δ_tube }
    have hV_open : IsOpen V_band :=
      (isOpen_lt (continuous_abs.comp (Complex.continuous_im.comp continuous_fst))
        continuous_const).inter
        (isOpen_lt (continuous_norm.comp (continuous_snd.sub continuous_const))
          continuous_const)
    have hV_dvc : IsDownwardVertConvex V_band := by
      refine ⟨hV_open, fun y t hyt hy_im τ hτ0 hτ_le => ⟨?_, hyt.2⟩⟩
      have him : ((y.re : ℂ) + (τ : ℂ) * Complex.I).im = τ := by simp
      change |((y.re : ℂ) + (τ : ℂ) * Complex.I).im| < b_plus_n
      rw [him, abs_of_nonneg hτ0]
      exact lt_of_le_of_lt hτ_le (lt_of_le_of_lt (le_abs_self _) hyt.1)
    have h𝔰_V : DifferentiableOn ℂ X.𝔰 V_band :=
      hX.𝔰_holo.mono fun p hp => hTube_sub ⟨hp.1.le, hp.2⟩
    have ht_cast : (T_star : ℂ) / (m_n : ℂ) = (t₀_n : ℂ) :=
      (Complex.ofReal_div T_star m_n).symm
    let φ_phys : ℂ → ℂ × ℂ := fun Z =>
      (expBasePt seq n + (ℓ_n : ℂ) * Z, (T_star : ℂ) / (m_n : ℂ))
    have hφ_diff : Differentiable ℂ φ_phys := by fun_prop
    have hφ_maps : Set.MapsTo φ_phys H_band V_band := by
      intro Z hZ
      refine ⟨?_, ?_⟩
      · have hb := h_im_bounds Z hZ
        change |(expBasePt seq n + (ℓ_n : ℂ) * Z).im| < b_plus_n
        rw [abs_of_pos hb.1]
        exact hb.2
      · change ‖(T_star : ℂ) / (m_n : ℂ) - (t₀_n : ℂ)‖ < δ_tube
        rw [ht_cast, sub_self, norm_zero]
        exact hδ_tube_pos
    have hTrue_holo : DifferentiableOn ℂ (S_true n) H_band :=
      ((h𝔰_V.comp hφ_diff.differentiableOn hφ_maps).sub_const
        (expBasePt seq n)).div_const (ℓ_n : ℂ)
    have h_patch_id : ∀ (Y₀ : ℂ) (x₀_n : ℝ) (U_n : Set (ℂ × ℂ)) (s_n : ℂ × ℂ → ℂ),
        Y₀.im = Real.log M.R + B.ν' / 2 →
        x₀_n = seq.x_seq n + ℓ_n * Y₀.re →
        IsDownwardVertConvex U_n →
        DifferentiableOn ℂ s_n U_n →
        (∀ y t : ℂ, ‖y - (x₀_n : ℂ)‖ < B.δ_zero n → ‖t - (t₀_n : ℂ)‖ < B.δ_zero n →
          (y, t) ∈ U_n ∧ s_n (y, t) = X.𝔰 (y, t)) →
        (∀ Z ∈ Metric.ball Y₀ (3 * B.ε_patch),
          (expBasePt seq n + (ℓ_n : ℂ) * Z, (t₀_n : ℂ)) ∈ U_n) →
        ∀ Z ∈ Metric.ball Y₀ (3 * B.ε_patch),
          S_true n Z = rescaledLift seq s_n n Z (T_star : ℂ) := by
      intro Y₀ x₀_n U_n s_n hY₀_im hx₀_eq hU_dvc hs_n_holo h_zero h_ball
      let B₃ : Set ℂ := Metric.ball Y₀ (3 * B.ε_patch)
      have hB₃_sub : B₃ ⊆ H_band := by
        intro Z hZ
        have hZ_norm : ‖Z - Y₀‖ < 3 * B.ε_patch := by
          simpa [B₃, Metric.mem_ball, dist_eq_norm] using hZ
        change |Z.im - (Real.log M.R + B.ν' / 2)| < 3 * B.ε_patch
        calc |Z.im - (Real.log M.R + B.ν' / 2)|
            = |(Z - Y₀).im| := by simp [hY₀_im]
          _ ≤ ‖Z - Y₀‖ := Complex.abs_im_le_norm _
          _ < 3 * B.ε_patch := hZ_norm
      have hf₁_ana : AnalyticOnNhd ℂ (S_true n) B₃ :=
        (hTrue_holo.mono hB₃_sub).analyticOnNhd Metric.isOpen_ball
      have hφ_U : Set.MapsTo φ_phys B₃ U_n := by
        intro Z hZ
        dsimp [φ_phys]
        rw [ht_cast]
        exact h_ball Z hZ
      have hf₂_holo : DifferentiableOn ℂ (fun Z => rescaledLift seq s_n n Z (T_star : ℂ)) B₃ :=
        ((hs_n_holo.comp hφ_diff.differentiableOn hφ_U).sub_const
          (expBasePt seq n)).div_const (ℓ_n : ℂ)
      have hf₂_ana : AnalyticOnNhd ℂ (fun Z => rescaledLift seq s_n n Z (T_star : ℂ)) B₃ :=
        hf₂_holo.analyticOnNhd Metric.isOpen_ball
      let r_loc : ℝ := min (3 * B.ε_patch) (B.δ_zero n / (2 * ℓ_n))
      have hr_loc_pos : 0 < r_loc := lt_min h3ε_pos (by positivity)
      have h_loc_eq : ∀ Z ∈ Metric.ball Y₀ r_loc,
          S_true n Z = rescaledLift seq s_n n Z (T_star : ℂ) := by
        intro Z hZ_loc
        have hZ_norm : ‖Z - Y₀‖ < r_loc := by
          simpa [Metric.mem_ball, dist_eq_norm] using hZ_loc
        have hZ_B₃ : Z ∈ B₃ := by
          rw [Metric.mem_ball, dist_eq_norm]
          exact lt_of_lt_of_le hZ_norm (min_le_left _ _)
        let yZ : ℂ := expBasePt seq n + (ℓ_n : ℂ) * Z
        have hyZ_V : (yZ, (t₀_n : ℂ)) ∈ V_band := by
          have := hφ_maps (hB₃_sub hZ_B₃)
          simpa [φ_phys, yZ, ht_cast] using this
        have hyZ_U : (yZ, (t₀_n : ℂ)) ∈ U_n := h_ball Z hZ_B₃
        have hyZ_im_nonneg : 0 ≤ yZ.im := (h_im_bounds Z (hB₃_sub hZ_B₃)).1.le
        have h_re_diff : ‖(yZ.re : ℂ) - (x₀_n : ℂ)‖ < B.δ_zero n / 2 := by
          have hyZ_re : yZ.re - x₀_n = ℓ_n * (Z - Y₀).re := by
            simp [yZ, expBasePt, hx₀_eq]
            ring
          have h_norm_eq : ‖(yZ.re : ℂ) - (x₀_n : ℂ)‖ = ℓ_n * |(Z - Y₀).re| := by
            rw [← Complex.ofReal_sub, Complex.norm_real, Real.norm_eq_abs, hyZ_re,
              abs_mul, abs_of_pos hℓ_pos]
          have hZ_lt_δ : ‖Z - Y₀‖ < B.δ_zero n / (2 * ℓ_n) :=
            lt_of_lt_of_le hZ_norm (min_le_right _ _)
          have h_re_le : ℓ_n * |(Z - Y₀).re| ≤ ℓ_n * ‖Z - Y₀‖ :=
            mul_le_mul_of_nonneg_left (Complex.abs_re_le_norm _) hℓ_pos.le
          have h_mul_lt : ℓ_n * ‖Z - Y₀‖ < B.δ_zero n / 2 := by
            have := mul_lt_mul_of_pos_left hZ_lt_δ hℓ_pos
            have h_simp : ℓ_n * (B.δ_zero n / (2 * ℓ_n)) = B.δ_zero n / 2 := by
              field_simp [hℓ_pos.ne']
            rwa [h_simp] at this
          rw [h_norm_eq]
          exact lt_of_le_of_lt h_re_le h_mul_lt
        have hs_eq : X.𝔰 (yZ, (t₀_n : ℂ)) = s_n (yZ, (t₀_n : ℂ)) := by
          refine hDisk.vertical_tube_uniqueness V_band U_n X.𝔰 s_n yZ (t₀_n : ℂ)
            (B.δ_zero n / 2) hV_dvc hU_dvc h𝔰_V hs_n_holo ⟨hyZ_V, hyZ_U⟩
            hyZ_im_nonneg (half_pos hδ_zero_pos) (fun y' hy' => ?_)
          have hy'_x₀ : ‖y' - (x₀_n : ℂ)‖ < B.δ_zero n := by
            calc ‖y' - (x₀_n : ℂ)‖
                = ‖(y' - (yZ.re : ℂ)) + ((yZ.re : ℂ) - (x₀_n : ℂ))‖ := by ring_nf
              _ ≤ ‖y' - (yZ.re : ℂ)‖ + ‖(yZ.re : ℂ) - (x₀_n : ℂ)‖ := norm_add_le _ _
              _ < B.δ_zero n := by linarith
          have ht₀_zero : ‖(t₀_n : ℂ) - (t₀_n : ℂ)‖ < B.δ_zero n := by
            simp [hδ_zero_pos]
          exact (h_zero y' (t₀_n : ℂ) hy'_x₀ ht₀_zero).2.symm
        dsimp [S_true, rescaledLift, m_n, ℓ_n]
        rw [ht_cast, hs_eq]
      have hev_eq : S_true n =ᶠ[nhds Y₀] (fun Z => rescaledLift seq s_n n Z (T_star : ℂ)) :=
        Filter.eventually_of_mem (Metric.ball_mem_nhds Y₀ hr_loc_pos) h_loc_eq
      exact hf₁_ana.eqOn_of_preconnected_of_eventuallyEq hf₂_ana
        (convex_ball Y₀ (3 * B.ε_patch)).isPreconnected
        (Metric.mem_ball_self h3ε_pos) hev_eq
    refine ⟨hTrue_holo, ?_, ?_⟩
    · exact h_patch_id Y_plus x₀_plus_n (B.U_plus n) (B.s_plus n)
        (by simp [Y_plus]) (by simp [Y_plus, x₀_plus_n])
        hU_plus_dvc hs_plus_holo h_zero_plus h_ball_plus
    · exact h_patch_id Y_minus x₀_minus_n (B.U_minus n) (B.s_minus n)
        (by simp [Y_minus]) (by simp [Y_minus, x₀_minus_n])
        hU_minus_dvc hs_minus_holo h_zero_minus h_ball_minus

  
  have hΩ_out_open : IsOpen Ω_out := by
    rw [isOpen_iff_mem_nhds]
    intro w₀ hw₀
    rcases hw₀ with ⟨hw₀_re, hw₀_lo, hw₀_hi, hw₀_arg⟩
    have hw₀_slit : w₀ ∈ Complex.slitPlane :=
      Complex.mem_slitPlane_iff.mpr (Or.inl hw₀_re)
    have h1 : ∀ᶠ w in nhds w₀, 0 < w.re :=
      Complex.continuous_re.continuousAt.eventually (Ioi_mem_nhds hw₀_re)
    have h2 : ∀ᶠ w in nhds w₀, M.R < ‖w‖ :=
      continuous_norm.continuousAt.eventually (Ioi_mem_nhds hw₀_lo)
    have h3 : ∀ᶠ w in nhds w₀, ‖w‖ < M.R * Real.exp M.ν :=
      continuous_norm.continuousAt.eventually (Iio_mem_nhds hw₀_hi)
    have h4 : ∀ᶠ w in nhds w₀, |Complex.arg w| < M.θ + M.δ_θ :=
      (continuous_abs.continuousAt.comp (Complex.continuousAt_arg hw₀_slit)).eventually
        (Iio_mem_nhds hw₀_arg)
    exact ((h1.and h2).and (h3.and h4)).mono fun w hw =>
      ⟨hw.1.1, hw.1.2, hw.2.1, hw.2.2⟩
  have hw_map_diff : Differentiable ℂ w_map := by fun_prop
  have hV_out_open : IsOpen V_outer := hΩ_out_open.preimage hw_map_diff.continuous
  have hS_out_holo : DifferentiableOn ℂ S_outer V_outer :=
    differentiableOn_fst.add (M.Δ_outer_holo.comp hw_map_diff.differentiableOn fun _ hp => hp)
  have hMod_out : IsRegularFrozenModel seq V_outer S_outer := by
    refine ⟨hV_out_open, hS_out_holo, fun p hp => ?_⟩
    let w : ℂ := w_map p
    have hw_mem : w ∈ Ω_out := hp
    have hΔ_deriv : HasDerivAt M.Δ_outer (deriv M.Δ_outer w) w :=
      (M.Δ_outer_holo.differentiableAt (hΩ_out_open.mem_nhds hw_mem)).hasDerivAt
    have hg_deriv : HasDerivAt (fun Y' : ℂ => w_map (Y', p.2)) (-Complex.I * w) p.1 := by
      have h_lin : HasDerivAt (fun Y' : ℂ => -Complex.I * Y') (-Complex.I * 1) p.1 :=
        (hasDerivAt_id p.1).const_mul (-Complex.I)
      have h_exp : HasDerivAt (fun Y' : ℂ => Complex.exp (-Complex.I * Y'))
          (Complex.exp (-Complex.I * p.1) * (-Complex.I * 1)) p.1 :=
        (Complex.hasDerivAt_exp (-Complex.I * p.1)).comp p.1 h_lin
      have h_mul := h_exp.const_mul (p.2 * seq.c₀)
      convert h_mul using 1
      dsimp [w, w_map]
      ring
    have hS_deriv : deriv (fun Y' => S_outer (Y', p.2)) p.1 =
        1 - Complex.I * w * deriv M.Δ_outer w := by
      have h_sum := (hasDerivAt_id p.1).add (hΔ_deriv.comp p.1 hg_deriv)
      have hd := h_sum.deriv
      calc deriv (fun Y' => S_outer (Y', p.2)) p.1
          = 1 + deriv M.Δ_outer w * (-Complex.I * w) := hd
        _ = 1 - Complex.I * w * deriv M.Δ_outer w := by ring
    have h_lam : p.2 * seq.c₀ * Complex.exp (-Complex.I * S_outer p) =
        w * Complex.exp (-Complex.I * M.Δ_outer w) := by
      dsimp [S_outer, w, w_map]
      have hexp : -Complex.I * (p.1 + M.Δ_outer (p.2 * seq.c₀ * Complex.exp (-Complex.I * p.1))) =
          -Complex.I * p.1 +
            (-Complex.I * M.Δ_outer (p.2 * seq.c₀ * Complex.exp (-Complex.I * p.1))) := by ring
      rw [hexp, Complex.exp_add]
      ring
    dsimp only
    rw [h_lam, hS_deriv]
    exact M.outer_regular_energy w hw_mem
  have hTc₀ : (T_star : ℂ) * seq.c₀ = Complex.exp ((α_c : ℂ) * Complex.I) := by
    have h_polar_c₀ := Complex.norm_mul_exp_arg_mul_I seq.c₀
    have h_norm_ne : (‖seq.c₀‖ : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hc₀_norm_pos.ne'
    calc (T_star : ℂ) * seq.c₀
        = (‖seq.c₀‖ : ℂ)⁻¹ * ((‖seq.c₀‖ : ℂ) * Complex.exp ((α_c : ℂ) * Complex.I)) := by
            dsimp [T_star, α_c]
            rw [Complex.ofReal_inv]
            nth_rw 2 [← h_polar_c₀]
      _ = Complex.exp ((α_c : ℂ) * Complex.I) := inv_mul_cancel_left₀ h_norm_ne _
  have hw_exp : ∀ Z : ℂ,
      w_map (Z, (T_star : ℂ)) =
        (M.R : ℂ) * Complex.exp (((Z.im - Real.log M.R : ℝ) : ℂ) +
          ((α_c - Z.re : ℝ) : ℂ) * Complex.I) := by
    intro Z
    have hR_exp : (M.R : ℂ) = Complex.exp (Real.log M.R : ℂ) := by
      rw [← Complex.ofReal_exp, Real.exp_log M.R_pos]
    dsimp [w_map]
    rw [hTc₀, hR_exp, ← Complex.exp_add, ← Complex.exp_add]
    congr 1
    apply Complex.ext
    · simp
    · simp; ring
  have h_polar_props : ∀ Z : ℂ, |α_c - Z.re| < Real.pi / 2 →
