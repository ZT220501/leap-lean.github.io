      _ ≤ 8 * (hBudget.C_env * K ^ (2 * hBudget.ρ)) + 4 := by linarith
      _ = 8 * hBudget.C_env * K ^ (2 * hBudget.ρ) + 4 := by ring
  have hK_ge_one : 1 ≤ K := le_trans hk₀_ge_one hK
  have h_rpow_ge_one : 1 ≤ K ^ (2 * hBudget.ρ) :=
    Real.one_le_rpow hK_ge_one (by linarith [hBudget.ρ_pos])
  have h_total_eq :
      (2 * Real.pi)⁻¹ * (∫ x in (0 : ℝ)..(2 * Real.pi), Φ x H_K) =
        I₀ + (2 * Real.pi)⁻¹ * (∫ v in (0 : ℝ)..H₀, G_int v) +
