                  rw [h_tel_b]; exact norm_add_le _ _
              _ ≤ ‖b 0 - w 1‖ + ‖∑ m ∈ Finset.range j, t * (J_step (m + 1) - 1)‖ +
                    ‖t * (J_step (j + 1) - 1)‖ := by
                  linarith [norm_add_le (b 0 - w 1)
                    (∑ m ∈ Finset.range j, t * (J_step (m + 1) - 1))]
              _ ≤ ‖b 0 - w 1‖ + (∑ m ∈ Finset.range j, ‖t * (J_step (m + 1) - 1)‖) +
                    ‖t * (J_step (j + 1) - 1)‖ := by
