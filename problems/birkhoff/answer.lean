        refine ⟨Real.contDiff_cos.comp (contDiff_const.mul contDiff_id), zero_le_one, fun k _ u => ?_⟩
        have hc : ContDiff ℝ (k : WithTop ℕ∞) Real.cos := Real.contDiff_cos
        rw [congr_fun (iteratedDeriv_comp_const_mul hc s) u, abs_mul, abs_pow, abs_of_nonneg hs.1]
        calc s ^ k * |iteratedDeriv k Real.cos (s * u)|
            ≤ 1 ^ k * 1 := mul_le_mul (pow_le_pow_left₀ hs.1 hs.2 k) (hCosSinIter k (s * u)).1
                (abs_nonneg _) (pow_nonneg zero_le_one k)
