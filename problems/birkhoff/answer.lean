      rw [hLimSub, hSeqEq]
      exact (hd_star_tend (j + 1) hj1_le k z hz).sub (hd_star_tend j hj_le k z hz)
    have hd_star_ball : IsStripMeshDispBall (m + 2) q σ_mesh R_strip d_star := by
