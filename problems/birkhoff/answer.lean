                    sliceImpactSeq S P.N i.val (walkPos ρ om' t₀)‖ ≤ r_exit}) ∩
                {om' | (∑ l ∈ Finset.Ico t₀ (n + 1), q_fn (walkPos ρ om' l)) ≤ q_K}} := by
          ext om
          simp only [A_set, Set.mem_setOf_eq, Set.mem_inter_iff, Finset.mem_range]
          constructor
          · rintro ⟨hT, hη, hQ⟩
            refine ⟨T_pure N_cap om, Nat.lt_succ_of_le hT, ⟨⟨rfl, ?_⟩, hQ⟩⟩
            intro m hm
            rcases Finset.mem_Ico.mp hm with ⟨hm1, hm2⟩
            have hm_lt : m < η_pure N_cap om := lt_of_le_of_lt (Nat.lt_succ_iff.mp hm2) hη
            have hmin := @Nat.find_min (fun k => T_pure N_cap om ≤ k ∧ _)
