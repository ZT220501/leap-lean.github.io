          have h2 : Complex.imCLM (Complex.I * v x t) = (v x t).re := by simp
          rwa [h2] at h1
        have hS_d : HasDerivAt (fun t' => S x t') (S_y x t) t := by
          convert ((hz_re.pow 2).add (hz_im.pow 2)).add_const (ε ^ 2) using 1
