        obtain ⟨hCk_cont, hCk_holo, hCk_loc, hCk_eq⟩ := ih
        have hStepK := hParamStep hCk_cont hCk_holo hCk_loc
        refine ⟨?_, ?_, ?_, ?_⟩
        · intro z hz
          simpa only [iteratedDeriv_succ] using hStepK.1 z hz
        · intro t ht
          simpa only [iteratedDeriv_succ] using hStepK.2.1 t ht
        · intro z₀ hz₀
          simpa only [iteratedDeriv_succ] using hStepK.2.2.1 z₀ hz₀
        · intro z₀ hz₀
          have hEqOn : Set.EqOn
              (iteratedDeriv k (fun w => ∫ t in (0 : ℝ)..1, F t w))
