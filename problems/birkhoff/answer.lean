      have hterm_pert : ∀ m : ℕ,
          ModEq j
            (MvPowerSeries.C (PowerSeries.mk (fun l => PowerSeries.coeff (m + 1) (g_seq l))) *
              Z₁ ^ (m + 1))
            (MvPowerSeries.C (PowerSeries.mk (fun l => PowerSeries.coeff (m + 1) (g_seq l))) *
              Z₀ ^ (m + 1) +
              X_ε ^ j *
                ι₀ (MvPowerSeries.C (PowerSeries.coeff m (PowerSeries.derivative (g_seq 0))) *
                  Z₀₀ ^ m * δ)) := by
        intro m
        let F_m := PowerSeries.mk (fun l => PowerSeries.coeff (m + 1) (g_seq l))
        have h1 := hMod_mul (hMod_refl j (MvPowerSeries.C F_m)) (hpow_pert m)
        rw [mul_add] at h1
        refine hMod_trans h1 (hMod_add (hMod_refl j _) ?_)
        refine hMod_trans (hMod_mul_vanish (MvPowerSeries.C F_m) _ (hXj_VE _)) ?_
        have hslF : pointArcSlice2D1D 0 (MvPowerSeries.C F_m) =
            MvPowerSeries.C (PowerSeries.coeff (m + 1) (g_seq 0)) := by
          ext d
          change PowerSeries.coeff 0 (MvPowerSeries.coeff d (MvPowerSeries.C F_m)) = _
          rw [MvPowerSeries.coeff_C, MvPowerSeries.coeff_C]
          split_ifs
          · rw [PowerSeries.coeff_mk]
          · rw [map_zero]
        rw [hslF, ← mul_assoc, mul_comm (ι₀ _), mul_assoc, ← hι_mul,
          PowerSeries.coeff_derivative]
        have hderiv_alg :
            MvPowerSeries.C (PowerSeries.coeff (m + 1) (g_seq 0)) *
