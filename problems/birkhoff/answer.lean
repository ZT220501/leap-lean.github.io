            rw [abs_le]; constructor <;> linarith
          rw [him_eq, abs_mul, abs_neg, abs_of_pos hℓ_pos]
          calc ℓ_seq j * |v - (3 / 2 : ℝ) * ((2 : ℝ) ^ k)|
              ≤ ℓ_seq j * ((4 / 8 : ℝ) * ((2 : ℝ) ^ k)) := by gcongr
