    have hEv_mem : ∀ᶠ t in nhds (0 : ℂ), y_hit t ∈ horizStrip H' :=
      hy_hit_cont.eventually (by rw [hy_hit_0]; exact (hOpen_strip H').mem_nhds hs₀_H')
    have hEv_d10 : ∀ᶠ t in nhds (0 : ℂ), deriv (fun y => L.𝔰_raw (y, t)) (y_hit t) ≠ 0 := by
      have hCont_curve : ContinuousAt (fun t : ℂ => (y_hit t, t)) 0 :=
