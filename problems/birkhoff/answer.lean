  obtain ⟨A_ball, J_ball, hA_ball_pos, hBall⟩ : ∃ (A_ball : ℕ → ℝ) (J_ball : ℕ → ℕ → ℝ → ℝ),
      (∀ R : ℕ, 0 < A_ball R) ∧
      (∀ j R : ℕ, R ≤ j + 1 →
        Continuous (J_ball j R) ∧
        (∀ x : ℝ, 0 ≤ J_ball j R x) ∧
        (∀ (x : ℝ) (z : ℂ),
          z ∈ Metric.closedBall ((x : ℂ) + (h_seq j : ℂ) * Complex.I) (((R : ℝ) + 1) * ℓ_seq j) →
          Φ z / (m0_seq j) ^ 2 ≤ J_ball j R x) ∧
