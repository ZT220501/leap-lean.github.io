    0 < σ' →
    σ' ≤ (1 - 6 * α - K_eval / (q : ℝ) ^ 2) * σ →
    (sgn = 1 ∨ sgn = -1) →
    0 ≤ Δe →
    0 ≤ Δτ →
    IsPeriodicSmoothBounded (m + 15) M₁ w₁ →
    IsPeriodicSmoothBounded (m + 15) M₁ w₂ →
    IsBoundedStripExt (m + 15) σ M₁ w₁ W₁ →
    IsBoundedStripExt (m + 15) σ M₁ w₂ W₂ →
    IsStripJetPerturb (m + 2) σ' α ((4 * (q : ℝ))⁻¹) e_X₁ →
    IsStripJetPerturb (m + 2) σ' α ((4 * (q : ℝ))⁻¹) τ_T₁ →
    IsStripJetPerturb (m + 2) σ' α ((4 * (q : ℝ))⁻¹) e_X₂ →
    IsStripJetPerturb (m + 2) σ' α ((4 * (q : ℝ))⁻¹) τ_T₂ →
    (∀ k : ℕ, k ≤ m + 2 → ∀ z ∈ horizStrip σ',
      ‖iteratedDeriv k (fun ζ => e_X₁ ζ - e_X₂ ζ) z‖ ≤ Δe) →
    (∀ k : ℕ, k ≤ m + 2 → ∀ z ∈ horizStrip σ',
      ‖iteratedDeriv k (fun ζ => τ_T₁ ζ - τ_T₂ ζ) z‖ ≤ Δτ) →
    let X₁ : ℂ → ℂ := fun z => z + (ρ : ℂ) + e_X₁ z
    let X₂ : ℂ → ℂ := fun z => z + (ρ : ℂ) + e_X₂ z
    let b₁ : ℂ → ℂ := b_C W₁ ρ sgn q e_X₁ τ_T₁
    let b₂ : ℂ → ℂ := b_C W₂ ρ sgn q e_X₂ τ_T₂
    (∀ k : ℕ, k ≤ m + 2 → ∀ z ∈ horizStrip σ',
      ‖iteratedDeriv k (fun ζ => a_C W₁ (X₁ ζ) - a_C W₂ (X₂ ζ)) z‖ ≤
        C_jet_C * (Δe + stripDiffSup (m + 15) σ W₁ W₂)) ∧
    (∀ k : ℕ, k ≤ m + 2 → ∀ z ∈ horizStrip σ',
      ‖iteratedDeriv k (fun ζ => b₁ ζ - b₂ ζ) z‖ ≤
        C_jet_C * (Δe + Δτ + stripDiffSup (m + 15) σ W₁ W₂))

structure RealMeshSystemPart (m : ℕ) (M₁ : ℝ) where
  R_real : ℝ
  N_real : ℕ
  R_real_pos : 0 < R_real
  N_real_ge_four : 4 ≤ N_real
  real_mesh_props : ∀ (q : ℕ) (w : ℝ → ℝ),
    N_real ≤ q →
    IsPeriodicSmoothBounded (m + 15) M₁ w →
    HasUniqueGlobalMesh q w ∧
    realMeshDisp q w 0 = 0 ∧
    realMeshDisp q w q = 0 ∧
    (∀ j : ℕ, j ≤ q →
      Function.Periodic (realMeshDisp q w j) (2 * Real.pi) ∧
      ContDiff ℝ ((m + 2 : ℕ) : WithTop ℕ∞) (realMeshDisp q w j) ∧
      ∀ k : ℕ, k ≤ m + 2 → ∀ x : ℝ,
        (q : ℝ) ^ 2 * |iteratedDeriv k (realMeshDisp q w j) x| ≤ R_real) ∧
    (∀ j : ℕ, j < q →
      Function.Periodic (realMidpointDisp q w j) (2 * Real.pi) ∧
      ContDiff ℝ ((m + 2 : ℕ) : WithTop ℕ∞) (realMidpointDisp q w j) ∧
      (∀ k : ℕ, k ≤ m + 2 → ∀ x : ℝ,
        (q : ℝ) ^ 3 *
          |iteratedDeriv k (fun y : ℝ => realMeshDisp q w (j + 1) y - realMeshDisp q w j y) x| ≤
          R_real) ∧
      (∀ k : ℕ, k ≤ m + 2 → ∀ x : ℝ,
        (q : ℝ) ^ 2 * |iteratedDeriv k (realMidpointDisp q w j) x| ≤ R_real))
  real_mesh_lip : ∀ (q : ℕ) (w₁ w₂ : ℝ → ℝ),
    N_real ≤ q →
    IsPeriodicSmoothBounded (m + 15) M₁ w₁ →
    IsPeriodicSmoothBounded (m + 15) M₁ w₂ →
    (∀ j : ℕ, j ≤ q → ∀ k : ℕ, k ≤ m + 2 → ∀ x : ℝ,
      (q : ℝ) ^ 2 *
        |iteratedDeriv k (fun y : ℝ => realMeshDisp q w₁ j y - realMeshDisp q w₂ j y) x| ≤
        R_real * realDiffSup (m + 15) w₁ w₂) ∧
    (∀ j : ℕ, j < q → ∀ k : ℕ, k ≤ m + 2 → ∀ x : ℝ,
      (q : ℝ) ^ 3 *
        |iteratedDeriv k (fun y : ℝ =>
          (realMeshDisp q w₁ (j + 1) y - realMeshDisp q w₁ j y) -
            (realMeshDisp q w₂ (j + 1) y - realMeshDisp q w₂ j y)) x| ≤
        R_real * realDiffSup (m + 15) w₁ w₂) ∧
    (∀ j : ℕ, j < q → ∀ k : ℕ, k ≤ m + 2 → ∀ x : ℝ,
      (q : ℝ) ^ 2 *
        |iteratedDeriv k (fun y : ℝ => realMidpointDisp q w₁ j y - realMidpointDisp q w₂ j y) x| ≤
        R_real * realDiffSup (m + 15) w₁ w₂)

structure StripMeshSystemPart (m : ℕ) (M₁ : ℝ) where
  R_strip : ℝ
  K_strip : ℝ
  N_strip : ℕ
  R_strip_pos : 0 < R_strip
  K_strip_pos : 0 < K_strip
  N_strip_ge_four : 4 ≤ N_strip
  strip_mesh_ext : ∀ (σ : ℝ) (q : ℕ) (w : ℝ → ℝ) (W : ℂ → ℂ),
    σ ∈ Set.Ioc (0 : ℝ) 1 →
    N_strip ≤ q →
    K_strip / (q : ℝ) ^ 2 < 1 →
    IsPeriodicSmoothBounded (m + 15) M₁ w →
    IsBoundedStripExt (m + 15) σ M₁ w W →
    ∃ (X_ℂ μ_ℂ : ℕ → ℂ → ℂ),
      (∀ z ∈ horizStrip ((1 - K_strip / (q : ℝ) ^ 2) * σ),
        X_ℂ 0 z = z ∧ X_ℂ q z = z + ((2 * Real.pi : ℝ) : ℂ)) ∧
      (∀ j : ℕ, j ≤ q →
        DifferentiableOn ℂ (X_ℂ j) (horizStrip ((1 - K_strip / (q : ℝ) ^ 2) * σ)) ∧
        (∀ x : ℝ, X_ℂ j x = realMesh q w x j) ∧
        (∀ z ∈ horizStrip ((1 - K_strip / (q : ℝ) ^ 2) * σ),
          X_ℂ j (z + 2 * Real.pi) = X_ℂ j z + 2 * Real.pi) ∧
        (∀ z ∈ horizStrip ((1 - K_strip / (q : ℝ) ^ 2) * σ),
          X_ℂ j (starRingEnd ℂ z) = starRingEnd ℂ (X_ℂ j z)) ∧
        (∀ z ∈ horizStrip ((1 - K_strip / (q : ℝ) ^ 2) * σ),
          X_ℂ j z ∈ horizStrip σ) ∧
        (∀ k : ℕ, k ≤ m + 2 → ∀ z ∈ horizStrip ((1 - K_strip / (q : ℝ) ^ 2) * σ),
          (q : ℝ) ^ 2 *
            ‖iteratedDeriv k
              (fun ζ : ℂ => X_ℂ j ζ - (ζ + ((2 * Real.pi * (j : ℝ) / (q : ℝ) : ℝ) : ℂ))) z‖ ≤
            R_strip)) ∧
      (∀ j : ℕ, j < q →
        DifferentiableOn ℂ (μ_ℂ j) (horizStrip ((1 - K_strip / (q : ℝ) ^ 2) * σ)) ∧
        (∀ x : ℝ, μ_ℂ j x = midpoint_ℝ w (realMesh q w x j) (realMesh q w x (j + 1))) ∧
        (∀ z ∈ horizStrip ((1 - K_strip / (q : ℝ) ^ 2) * σ),
          μ_ℂ j (z + 2 * Real.pi) = μ_ℂ j z + 2 * Real.pi) ∧
        (∀ z ∈ horizStrip ((1 - K_strip / (q : ℝ) ^ 2) * σ),
          μ_ℂ j (starRingEnd ℂ z) = starRingEnd ℂ (μ_ℂ j z)) ∧
        (∀ z ∈ horizStrip ((1 - K_strip / (q : ℝ) ^ 2) * σ),
          μ_ℂ j z ∈ horizStrip σ) ∧
        (∀ k : ℕ, k ≤ m + 2 → ∀ z ∈ horizStrip ((1 - K_strip / (q : ℝ) ^ 2) * σ),
          (q : ℝ) ^ 3 *
            ‖iteratedDeriv k
              (fun ζ : ℂ =>
                (X_ℂ (j + 1) ζ - X_ℂ j ζ) - ((2 * Real.pi / (q : ℝ) : ℝ) : ℂ)) z‖ ≤
            R_strip) ∧
        (∀ k : ℕ, k ≤ m + 2 → ∀ z ∈ horizStrip ((1 - K_strip / (q : ℝ) ^ 2) * σ),
          (q : ℝ) ^ 2 *
            ‖iteratedDeriv k
              (fun ζ : ℂ => μ_ℂ j ζ - (X_ℂ j ζ + (X_ℂ (j + 1) ζ - X_ℂ j ζ) / 2)) z‖ ≤
            R_strip))
  strip_mesh_lip : ∀ (σ : ℝ) (q : ℕ) (w₁ w₂ : ℝ → ℝ) (W₁ W₂ : ℂ → ℂ)
      (X_ℂ₁ μ_ℂ₁ X_ℂ₂ μ_ℂ₂ : ℕ → ℂ → ℂ),
    σ ∈ Set.Ioc (0 : ℝ) 1 →
    N_strip ≤ q →
    K_strip / (q : ℝ) ^ 2 < 1 →
    IsPeriodicSmoothBounded (m + 15) M₁ w₁ →
    IsPeriodicSmoothBounded (m + 15) M₁ w₂ →
    IsBoundedStripExt (m + 15) σ M₁ w₁ W₁ →
    IsBoundedStripExt (m + 15) σ M₁ w₂ W₂ →
    (∀ j : ℕ, j ≤ q →
      DifferentiableOn ℂ (X_ℂ₁ j) (horizStrip ((1 - K_strip / (q : ℝ) ^ 2) * σ)) ∧
      DifferentiableOn ℂ (X_ℂ₂ j) (horizStrip ((1 - K_strip / (q : ℝ) ^ 2) * σ)) ∧
      (∀ x : ℝ, X_ℂ₁ j x = realMesh q w₁ x j) ∧
      (∀ x : ℝ, X_ℂ₂ j x = realMesh q w₂ x j)) →
    (∀ j : ℕ, j < q →
      DifferentiableOn ℂ (μ_ℂ₁ j) (horizStrip ((1 - K_strip / (q : ℝ) ^ 2) * σ)) ∧
      DifferentiableOn ℂ (μ_ℂ₂ j) (horizStrip ((1 - K_strip / (q : ℝ) ^ 2) * σ)) ∧
      (∀ x : ℝ, μ_ℂ₁ j x = midpoint_ℝ w₁ (realMesh q w₁ x j) (realMesh q w₁ x (j + 1))) ∧
      (∀ x : ℝ, μ_ℂ₂ j x = midpoint_ℝ w₂ (realMesh q w₂ x j) (realMesh q w₂ x (j + 1)))) →
    (∀ j : ℕ, j ≤ q → ∀ k : ℕ, k ≤ m + 2 →
      ∀ z ∈ horizStrip ((1 - K_strip / (q : ℝ) ^ 2) * σ),
        (q : ℝ) ^ 2 * ‖iteratedDeriv k (fun ζ : ℂ => X_ℂ₁ j ζ - X_ℂ₂ j ζ) z‖ ≤
          R_strip * stripDiffSup (m + 15) σ W₁ W₂) ∧
    (∀ j : ℕ, j < q → ∀ k : ℕ, k ≤ m + 2 →
      ∀ z ∈ horizStrip ((1 - K_strip / (q : ℝ) ^ 2) * σ),
        (q : ℝ) ^ 3 *
          ‖iteratedDeriv k (fun ζ : ℂ =>
            (X_ℂ₁ (j + 1) ζ - X_ℂ₁ j ζ) - (X_ℂ₂ (j + 1) ζ - X_ℂ₂ j ζ)) z‖ ≤
          R_strip * stripDiffSup (m + 15) σ W₁ W₂) ∧
    (∀ j : ℕ, j < q → ∀ k : ℕ, k ≤ m + 2 →
      ∀ z ∈ horizStrip ((1 - K_strip / (q : ℝ) ^ 2) * σ),
        (q : ℝ) ^ 2 *
          ‖iteratedDeriv k (fun ζ : ℂ =>
            (μ_ℂ₁ j ζ - (X_ℂ₁ j ζ + (X_ℂ₁ (j + 1) ζ - X_ℂ₁ j ζ) / 2)) -
              (μ_ℂ₂ j ζ - (X_ℂ₂ j ζ + (X_ℂ₂ (j + 1) ζ - X_ℂ₂ j ζ) / 2))) z‖ ≤
          R_strip * stripDiffSup (m + 15) σ W₁ W₂)
def IsSliceClearedOnCollar {W : Set (ℂ × ℂ)} (F : MeroOn2D W)
    (U_w : Set ℂ) (w₁ : ℂ) (r ε_r : ℝ) (m : ℕ) (G : ℂ × ℂ → ℂ) : Prop :=
  let U_col := U_w ×ˢ { ζ : ℂ | r - ε_r < ‖ζ‖ ∧ ‖ζ‖ < r + ε_r }
  U_col ⊆ W ∧
  DifferentiableOn ℂ G U_col ∧
  ∀ p ∈ U_col, ∃ η : ℝ, 0 < η ∧ η ≤ F.rad p ∧ Metric.ball p η ⊆ U_col ∧
    ∀ q ∈ Metric.ball p η,
      G q * F.den p q = (q.1 - w₁) ^ m * F.num p q

noncomputable def laurentMoment (G : ℂ × ℂ → ℂ) (r : ℝ) (n : ℕ) (w : ℂ) : ℂ :=
  ∮ ζ in C((0 : ℂ), r), G (w, ζ) * ζ ^ n

noncomputable def hankelSubmatrix (L : ℕ → ℂ → ℂ) (d : ℕ) (I : Fin d → ℕ) (w : ℂ) :
    Matrix (Fin d) (Fin d) ℂ :=
  fun a b => L (I a + (b : ℕ)) w

def Mero2DSheafGluingToolkit : Prop :=
  (∀ (w_a w_b : ℂ) (δ_a δ_b ρ R : ℝ) (W_F : Set (ℂ × ℂ))
     (F : MeroOn2D W_F)
     (G_a : MeroOn2D (Metric.ball w_a δ_a ×ˢ Metric.ball (0 : ℂ) R)),
     0 < δ_b → 0 < ρ → ρ < R →
     Metric.ball w_b δ_b ⊆ Metric.ball w_a δ_a →
     MeroEqOn G_a F (Metric.ball w_a δ_a ×ˢ { ζ : ℂ | ρ < ‖ζ‖ ∧ ‖ζ‖ < R }) →
     ∃ G_b : MeroOn2D (Metric.ball w_b δ_b ×ˢ Metric.ball (0 : ℂ) R),
       MeroEqOn G_b F (Metric.ball w_b δ_b ×ˢ { ζ : ℂ | ρ < ‖ζ‖ ∧ ‖ζ‖ < R })) ∧
  (∀ (r_w ρ R r ε_r δ₀ δ₂ : ℝ) (w₁ w₂ : ℂ) (m : ℕ) (G : ℂ × ℂ → ℂ)
     (F : MeroOn2D (Metric.ball (0 : ℂ) r_w ×ˢ { ζ : ℂ | ρ < ‖ζ‖ ∧ ‖ζ‖ < R }))
     (G₂ : MeroOn2D (Metric.ball w₂ δ₂ ×ˢ Metric.ball (0 : ℂ) R)),
     0 < δ₂ → 0 < ε_r → ρ < r - ε_r → r + ε_r < R →
     Metric.ball w₂ δ₂ ⊆ Metric.ball w₁ δ₀ →
     IsSliceClearedOnCollar F (Metric.ball w₁ δ₀) w₁ r ε_r m G →
     MeroEqOn G₂ F (Metric.ball w₂ δ₂ ×ˢ { ζ : ℂ | ρ < ‖ζ‖ ∧ ‖ζ‖ < R }) →
     IsSliceClearedOnCollar G₂ (Metric.ball w₂ δ₂) w₁ r ε_r m G) ∧
  (∀ (r_w ρ R r ε_r δ₀ : ℝ) (w₁ : ℂ) (m : ℕ) (G N_tilde Q : ℂ × ℂ → ℂ)
     (F : MeroOn2D (Metric.ball (0 : ℂ) r_w ×ˢ { ζ : ℂ | ρ < ‖ζ‖ ∧ ‖ζ‖ < R })),
     0 < r_w → 0 < ρ → 0 < δ₀ → 0 < ε_r → ρ < r - ε_r → r + ε_r < R →
     Metric.ball w₁ δ₀ ⊆ Metric.ball (0 : ℂ) r_w →
     IsSliceClearedOnCollar F (Metric.ball w₁ δ₀) w₁ r ε_r m G →
     DifferentiableOn ℂ N_tilde (Metric.ball w₁ δ₀ ×ˢ Metric.ball (0 : ℂ) r) →
     DifferentiableOn ℂ Q (Metric.ball w₁ δ₀ ×ˢ Metric.ball (0 : ℂ) r) →
     (∃ w_nz ∈ Metric.ball w₁ δ₀, w_nz ≠ w₁ ∧
       ∃ z_nz ∈ Metric.ball (0 : ℂ) r, Q (w_nz, z_nz) ≠ 0) →
     (∀ p ∈ Metric.ball w₁ δ₀ ×ˢ { z : ℂ | r - ε_r / 2 < ‖z‖ ∧ ‖z‖ < r },
       N_tilde p = Q p * G p) →
     ∃ G_loc : MeroOn2D (Metric.ball w₁ δ₀ ×ˢ Metric.ball (0 : ℂ) R),
       MeroEqOn G_loc F (Metric.ball w₁ δ₀ ×ˢ { ζ : ℂ | ρ < ‖ζ‖ ∧ ‖ζ‖ < R })) ∧
  (∀ (r_w ρ R : ℝ)
     (F : MeroOn2D (Metric.ball (0 : ℂ) r_w ×ˢ { ζ : ℂ | ρ < ‖ζ‖ ∧ ‖ζ‖ < R })),
     0 < r_w → 0 < ρ → ρ < R →
     (∀ w ∈ Metric.ball (0 : ℂ) r_w, ∃ δ : ℝ, 0 < δ ∧
       Metric.ball w δ ⊆ Metric.ball (0 : ℂ) r_w ∧
       ∃ G : MeroOn2D (Metric.ball w δ ×ˢ Metric.ball (0 : ℂ) R),
         MeroEqOn G F (Metric.ball w δ ×ˢ { ζ : ℂ | ρ < ‖ζ‖ ∧ ‖ζ‖ < R })) →
     ∃ F_ext : MeroOn2D (Metric.ball (0 : ℂ) r_w ×ˢ Metric.ball (0 : ℂ) R),
       MeroEqOn F_ext F (Metric.ball (0 : ℂ) r_w ×ˢ { ζ : ℂ | ρ < ‖ζ‖ ∧ ‖ζ‖ < R }))
noncomputable def k0Minus (α : ℝ) : ℝ :=
  (Real.pi ^ 2 / 2) * (3 * α ^ 2 - 1)

noncomputable def k0Plus (α : ℝ) : ℝ :=
  (Real.pi ^ 2 / 2) * (3 * (1 - α) ^ 2 - 1)

noncomputable def fwdKernelMinus (q : ℕ) (w : ℝ → ℝ) (j : ℕ) (α x : ℝ) : ℝ :=
  cellKernelMinus_ℝ w (realMesh q w x j) (realMesh q w x (j + 1))
    (halfCellMinus_ℝ q w j α x)

noncomputable def fwdKernelPlus (q : ℕ) (w : ℝ → ℝ) (j : ℕ) (α x : ℝ) : ℝ :=
  cellKernelPlus_ℝ w (realMesh q w x j) (realMesh q w x (j + 1))
    (halfCellPlus_ℝ q w j α x)

noncomputable def halfCellInvDispMinus (q : ℕ) (w : ℝ → ℝ) (j : ℕ) (α z : ℝ) : ℝ :=
  halfCellInvMinus_ℝ q w j α z - (z - 2 * Real.pi * ((j : ℝ) + α / 2) / (q : ℝ))

noncomputable def halfCellInvDispPlus (q : ℕ) (w : ℝ → ℝ) (j : ℕ) (α z : ℝ) : ℝ :=
  halfCellInvPlus_ℝ q w j α z - (z - 2 * Real.pi * ((j : ℝ) + (1 + α) / 2) / (q : ℝ))

def NormActionCalculusProp : Prop :=
  ∀ (w : ℝ → ℝ),
    Function.Periodic w (2 * Real.pi) →
    ContDiff ℝ (4 : WithTop ℕ∞) w →
    Continuous (fun p : ℝ × ℝ => midpoint_ℝ w p.1 p.2) ∧
    Continuous (fun p : ℝ × ℝ × ℝ => cellKernelMinus_ℝ w p.1 p.2.1 p.2.2) ∧
    Continuous (fun p : ℝ × ℝ × ℝ => cellKernelPlus_ℝ w p.1 p.2.1 p.2.2) ∧
    (∀ X Y z : ℝ,
      midpoint_ℝ w (X + 2 * Real.pi) (Y + 2 * Real.pi) = midpoint_ℝ w X Y + 2 * Real.pi ∧
      cellKernelMinus_ℝ w (X + 2 * Real.pi) (Y + 2 * Real.pi) (z + 2 * Real.pi) =
        cellKernelMinus_ℝ w X Y z ∧
      cellKernelPlus_ℝ w (X + 2 * Real.pi) (Y + 2 * Real.pi) (z + 2 * Real.pi) =
        cellKernelPlus_ℝ w X Y z) ∧
    (∀ X Y : ℝ,
      HasDerivAt (fun X' : ℝ => normAction_ℝ w X' Y) (normAction1_ℝ w X Y) X ∧
      HasDerivAt (fun Y' : ℝ => normAction_ℝ w X Y') (-normAction1_ℝ w Y X) Y) ∧
    (∀ (v : ℝ → ℝ),
      Function.Periodic v (2 * Real.pi) →
      ContDiff ℝ (4 : WithTop ℕ∞) v →
      ContDiff ℝ (2 : WithTop ℕ∞)
        (fun p : ℝ × ℝ × ℝ => normAction_ℝ (fun z => w z + p.2.2 * v z) p.1 p.2.1) ∧
      (∀ X Y : ℝ, X < Y →
        X < midpoint_ℝ w X Y ∧ midpoint_ℝ w X Y < Y ∧
        HasDerivAt (fun t : ℝ => normAction_ℝ (fun z => w z + t * v z) X Y)
          ((∫ z in X..(midpoint_ℝ w X Y), cellKernelMinus_ℝ w X Y z * v z) +
            (∫ z in (midpoint_ℝ w X Y)..Y, cellKernelPlus_ℝ w X Y z * v z))
          0))

structure HalfCellInverseSystem (m : ℕ) (M : ℝ) (S : StationaryMeshSystem m (M + 1)) where
  C_inv : ℝ
  N_inv : ℕ
  C_inv_pos : 0 < C_inv
  N_inv_ge : S.N_mesh ≤ N_inv
  inv_props : ∀ (q : ℕ) (w : ℝ → ℝ) (j : ℕ),
    N_inv ≤ q →
    IsPeriodicSmoothBounded (m + 15) M w →
    j < q →
    (∀ k : ℕ, k ≤ m + 1 →
      ContinuousOn (fun p : ℝ × ℝ => iteratedDeriv k (halfCellInvDispMinus q w j p.1) p.2)
        (Set.Icc (0 : ℝ) 1 ×ˢ Set.univ) ∧
      ContinuousOn (fun p : ℝ × ℝ => iteratedDeriv k (halfCellInvDispPlus q w j p.1) p.2)
        (Set.Icc (0 : ℝ) 1 ×ˢ Set.univ)) ∧
    (∀ α ∈ Set.Icc (0 : ℝ) 1,
      ContDiff ℝ ((m + 2 : ℕ) : WithTop ℕ∞) (halfCellMinus_ℝ q w j α) ∧
      ContDiff ℝ ((m + 2 : ℕ) : WithTop ℕ∞) (halfCellPlus_ℝ q w j α) ∧
      ContDiff ℝ ((m + 1 : ℕ) : WithTop ℕ∞) (halfCellInvDispMinus q w j α) ∧
      ContDiff ℝ ((m + 1 : ℕ) : WithTop ℕ∞) (halfCellInvDispPlus q w j α) ∧
      (∀ x : ℝ, halfCellMinus_ℝ q w j α (x + 2 * Real.pi) =
        halfCellMinus_ℝ q w j α x + 2 * Real.pi) ∧
      (∀ x : ℝ, halfCellPlus_ℝ q w j α (x + 2 * Real.pi) =
        halfCellPlus_ℝ q w j α x + 2 * Real.pi) ∧
      (∀ z : ℝ, halfCellInvMinus_ℝ q w j α (z + 2 * Real.pi) =
        halfCellInvMinus_ℝ q w j α z + 2 * Real.pi) ∧
      (∀ z : ℝ, halfCellInvPlus_ℝ q w j α (z + 2 * Real.pi) =
        halfCellInvPlus_ℝ q w j α z + 2 * Real.pi) ∧
      Function.LeftInverse (halfCellInvMinus_ℝ q w j α) (halfCellMinus_ℝ q w j α) ∧
      Function.RightInverse (halfCellInvMinus_ℝ q w j α) (halfCellMinus_ℝ q w j α) ∧
      Function.LeftInverse (halfCellInvPlus_ℝ q w j α) (halfCellPlus_ℝ q w j α) ∧
      Function.RightInverse (halfCellInvPlus_ℝ q w j α) (halfCellPlus_ℝ q w j α) ∧
      (∀ x : ℝ,
        deriv (halfCellInvMinus_ℝ q w j α) (halfCellMinus_ℝ q w j α x) *
          deriv (halfCellMinus_ℝ q w j α) x = 1) ∧
      (∀ x : ℝ,
        deriv (halfCellInvPlus_ℝ q w j α) (halfCellPlus_ℝ q w j α x) *
          deriv (halfCellPlus_ℝ q w j α) x = 1) ∧
      (∀ k : ℕ, k ≤ m + 1 → ∀ z : ℝ,
        |iteratedDeriv k (halfCellInvDispMinus q w j α) z| ≤ C_inv / (q : ℝ) ^ 2 ∧
        |iteratedDeriv k (halfCellInvDispPlus q w j α) z| ≤ C_inv / (q : ℝ) ^ 2))
  inv_lip : ∀ (q : ℕ) (w₁ w₂ : ℝ → ℝ) (j : ℕ) (α : ℝ),
    N_inv ≤ q →
    IsPeriodicSmoothBounded (m + 15) M w₁ →
    IsPeriodicSmoothBounded (m + 15) M w₂ →
    j < q →
    α ∈ Set.Icc (0 : ℝ) 1 →
    ∀ k : ℕ, k ≤ m + 1 → ∀ z : ℝ,
      |iteratedDeriv k (fun y : ℝ =>
          halfCellInvDispMinus q w₁ j α y - halfCellInvDispMinus q w₂ j α y) z| ≤
        (C_inv / (q : ℝ) ^ 2) * realDiffSup (m + 15) w₁ w₂ ∧
      |iteratedDeriv k (fun y : ℝ =>
          halfCellInvDispPlus q w₁ j α y - halfCellInvDispPlus q w₂ j α y) z| ≤
        (C_inv / (q : ℝ) ^ 2) * realDiffSup (m + 15) w₁ w₂

structure ForwardKernelSystem (m : ℕ) (M : ℝ) (S : StationaryMeshSystem m (M + 1)) where
  C_kern : ℝ
  N_kern : ℕ
  C_kern_pos : 0 < C_kern
  N_kern_ge : S.N_mesh ≤ N_kern
  kern_props : ∀ (q : ℕ) (w : ℝ → ℝ) (j : ℕ),
    N_kern ≤ q →
    IsPeriodicSmoothBounded (m + 15) M w →
    j < q →
    (∀ k : ℕ, k ≤ m + 2 →
      ContinuousOn (fun p : ℝ × ℝ => iteratedDeriv k (fwdKernelMinus q w j p.1) p.2)
        (Set.Icc (0 : ℝ) 1 ×ˢ Set.univ) ∧
      ContinuousOn (fun p : ℝ × ℝ => iteratedDeriv k (fwdKernelPlus q w j p.1) p.2)
        (Set.Icc (0 : ℝ) 1 ×ˢ Set.univ)) ∧
    (∀ α ∈ Set.Icc (0 : ℝ) 1,
      ContDiff ℝ ((m + 2 : ℕ) : WithTop ℕ∞) (fwdKernelMinus q w j α) ∧
      ContDiff ℝ ((m + 2 : ℕ) : WithTop ℕ∞) (fwdKernelPlus q w j α) ∧
      (∀ k : ℕ, k ≤ m + 2 → ∀ x : ℝ,
        |iteratedDeriv k (fun y : ℝ => fwdKernelMinus q w j α y - k0Minus α / (q : ℝ) ^ 2) x| ≤
          C_kern / (q : ℝ) ^ 3 ∧
        |iteratedDeriv k (fun y : ℝ => fwdKernelPlus q w j α y - k0Plus α / (q : ℝ) ^ 2) x| ≤
          C_kern / (q : ℝ) ^ 3))
  kern_lip : ∀ (q : ℕ) (w₁ w₂ : ℝ → ℝ) (j : ℕ) (α : ℝ),
    N_kern ≤ q →
    IsPeriodicSmoothBounded (m + 15) M w₁ →
    IsPeriodicSmoothBounded (m + 15) M w₂ →
    j < q →
    α ∈ Set.Icc (0 : ℝ) 1 →
    ∀ k : ℕ, k ≤ m + 2 → ∀ x : ℝ,
      |iteratedDeriv k (fun y : ℝ => fwdKernelMinus q w₁ j α y - fwdKernelMinus q w₂ j α y) x| ≤
        (C_kern / (q : ℝ) ^ 3) * realDiffSup (m + 15) w₁ w₂ ∧
      |iteratedDeriv k (fun y : ℝ => fwdKernelPlus q w₁ j α y - fwdKernelPlus q w₂ j α y) x| ≤
        (C_kern / (q : ℝ) ^ 3) * realDiffSup (m + 15) w₁ w₂
noncomputable def pairIsoZ (X : Fin 2 → ℂ × ℂ → ℂ) (q : ℂ × ℂ) : ℂ :=
  X 0 q + Complex.I * X 1 q

noncomputable def pairIsoW (X : Fin 2 → ℂ × ℂ → ℂ) (q : ℂ × ℂ) : ℂ :=
  X 0 q - Complex.I * X 1 q

def SatisfiesRankOneAt (X : Fin 2 → ℂ × ℂ → ℂ) (q : ℂ × ℂ) : Prop :=
  deriv (fun y' => pairIsoZ X (y', q.2)) q.1 *
    deriv (fun t' => pairIsoW X (q.1, t')) q.2 =
  deriv (fun t' => pairIsoZ X (q.1, t')) q.2 *
    deriv (fun y' => pairIsoW X (y', q.2)) q.1

def SatisfiesIsoReflectAt (X : Fin 2 → ℂ × ℂ → ℂ) (q : ℂ × ℂ) : Prop :=
  (pairIsoZ X q - pairIsoZ X (q.1 - q.2, q.2)) *
    (pairIsoZ X (q.1 + q.2, q.2) - pairIsoZ X q) *
    (deriv (fun y' => pairIsoW X (y', q.2)) q.1) ^ 2 =
  (pairIsoW X q - pairIsoW X (q.1 - q.2, q.2)) *
    (pairIsoW X (q.1 + q.2, q.2) - pairIsoW X q) *
    (deriv (fun y' => pairIsoZ X (y', q.2)) q.1) ^ 2

def meroTubeShift (W : Set (ℂ × ℂ)) : Set (ℂ × ℂ) :=
  { q : ℂ × ℂ | q ∈ W ∧ (q.1 - q.2, q.2) ∈ W ∧ (q.1 + q.2, q.2) ∈ W }

def collarBaseBox {Ω : Set Plane} {C : AnalyticGlancingCollar Ω}
    (M : MeromorphicCollarData C) : Set (ℂ × ℂ) :=
  { q : ℂ × ℂ | |q.1.im| < M.s_base ∧ ‖q.2‖ < M.r_base }

def collarHalfBaseBox {Ω : Set Plane} {C : AnalyticGlancingCollar Ω}
    (M : MeromorphicCollarData C) : Set (ℂ × ℂ) :=
  { q : ℂ × ℂ | |q.1.im| < M.s_base / 2 ∧ ‖q.2‖ < M.r_base / 2 }

structure SliceSymmetryWallData {Ω : Set Plane} (C : AnalyticGlancingCollar Ω)
    (M : MeromorphicCollarData C) : Prop where
  real_base : ∀ x : ℝ,
    (x : ℂ) ∈ horizStripENNR (M.h_X 0) ∧
    (x : ℂ) ∉ M.E_disc ∧
    M.a_mero x = Complex.exp (Complex.I * C.ϕ x)
  a_periodic_reg : ∀ s ∈ horizStripENNR (M.h_X 0),
    s ∉ M.E_disc →
    s + 2 * Real.pi ∈ horizStripENNR (M.h_X 0) →
    s + 2 * Real.pi ∉ M.E_disc →
    M.a_mero (s + 2 * Real.pi) = M.a_mero s
  a_conj_reg : ∀ s ∈ horizStripENNR (M.h_X 0),
    s ∉ M.E_disc →
    starRingEnd ℂ s ∈ horizStripENNR (M.h_X 0) →
    starRingEnd ℂ s ∉ M.E_disc →
    M.a_mero (starRingEnd ℂ s) * starRingEnd ℂ (M.a_mero s) = 1
  order_ne_top : ∀ q ∈ horizStripENNR (M.h_X 0),
    meromorphicOrderAt M.a_mero q ≠ ⊤
  center_im_ne_zero : ∀ p ∈ horizStripENNR (M.h_X 0),
    ∀ (n : ℤ) (u : ℂ → ℂ),
      n ≠ 0 → AnalyticAt ℂ u p → u p ≠ 0 →
      (∀ᶠ z in nhdsWithin p {p}ᶜ, M.a_mero z = (z - p) ^ n * u z) →
      p.im ≠ 0
  wall_top_and_global_odd : ∀ p ∈ horizStripENNR (M.h_X 0),
    p.im ≠ 0 →
    ∀ ε : ℝ, 0 < ε →
      (∀ z : ℂ, 0 < ‖z‖ → ‖z‖ < ε →
        (∀ i : Fin 2, M.Γ_slice (p - z) i = M.Γ_slice (p + z) i) ∧
        M.a_mero (p - z) = -M.a_mero (p + z)) →
      M.h_X 0 = ⊤ ∧
      ∀ s : ℂ, s ∉ M.E_disc → 2 * p - s ∉ M.E_disc → M.a_mero (2 * p - s) = -M.a_mero s

structure RawCenterFractionData (Γ_0 : Fin 2 → ℂ → ℂ) (p : ℂ) where
  δ : ℝ
  δ_pos : 0 < δ
  N : Fin 2 → ℂ × ℂ → ℂ
  D : Fin 2 → ℂ × ℂ → ℂ
  N_holo : ∀ i : Fin 2, DifferentiableOn ℂ (N i) (Metric.ball p δ ×ˢ Metric.ball (0 : ℂ) δ)
  D_holo : ∀ i : Fin 2, DifferentiableOn ℂ (D i) (Metric.ball p δ ×ˢ Metric.ball (0 : ℂ) δ)
  D_slice_ne_zero : ∀ i : Fin 2, ∀ y : ℂ, 0 < ‖y - p‖ → ‖y - p‖ < δ → D i (y, 0) ≠ 0
  slice_eq : ∀ i : Fin 2, ∀ y : ℂ, 0 < ‖y - p‖ → ‖y - p‖ < δ →
    N i (y, 0) = Γ_0 i y * D i (y, 0)
  even_eq : ∀ i : Fin 2, ∀ y t : ℂ, ‖y - p‖ < δ → ‖t‖ < δ →
    N i (y, -t) * D i (y, t) = N i (y, t) * D i (y, -t)
  rank_one_on_reg : ∀ q ∈ Metric.ball p δ ×ˢ Metric.ball (0 : ℂ) δ,
    (∀ i : Fin 2, D i q ≠ 0) →
    SatisfiesRankOneAt (fun i w => N i w / D i w) q
  iso_reflect_on_reg : ∀ q ∈ Metric.ball p δ ×ˢ Metric.ball (0 : ℂ) δ,
    (q.1 - q.2, q.2) ∈ Metric.ball p δ ×ˢ Metric.ball (0 : ℂ) δ →
    (q.1 + q.2, q.2) ∈ Metric.ball p δ ×ˢ Metric.ball (0 : ℂ) δ →
    (∀ i : Fin 2, D i q ≠ 0 ∧ D i (q.1 - q.2, q.2) ≠ 0 ∧ D i (q.1 + q.2, q.2) ≠ 0) →
    SatisfiesIsoReflectAt (fun i w => N i w / D i w) q
def IsStripMeshExt (m : ℕ) (M₁ : ℝ) (S : StationaryMeshSystem m M₁)
    (σ : ℝ) (q : ℕ) (w : ℝ → ℝ) (_W : ℂ → ℂ) (X_ℂ μ_ℂ : ℕ → ℂ → ℂ) : Prop :=
  let σ_mesh := (1 - S.K_mesh / (q : ℝ) ^ 2) * σ
  (∀ z ∈ horizStrip σ_mesh, X_ℂ 0 z = z ∧ X_ℂ q z = z + ((2 * Real.pi : ℝ) : ℂ)) ∧
  (∀ j : ℕ, j ≤ q →
    DifferentiableOn ℂ (X_ℂ j) (horizStrip σ_mesh) ∧
    (∀ x : ℝ, X_ℂ j x = realMesh q w x j) ∧
    (∀ z ∈ horizStrip σ_mesh, X_ℂ j (z + 2 * Real.pi) = X_ℂ j z + 2 * Real.pi) ∧
    (∀ z ∈ horizStrip σ_mesh, X_ℂ j (starRingEnd ℂ z) = starRingEnd ℂ (X_ℂ j z)) ∧
    (∀ z ∈ horizStrip σ_mesh, X_ℂ j z ∈ horizStrip σ) ∧
    (∀ k : ℕ, k ≤ m + 2 → ∀ z ∈ horizStrip σ_mesh,
      (q : ℝ) ^ 2 *
        ‖iteratedDeriv k
          (fun ζ : ℂ => X_ℂ j ζ - (ζ + ((2 * Real.pi * (j : ℝ) / (q : ℝ) : ℝ) : ℂ))) z‖ ≤
        S.R_mesh)) ∧
  (∀ j : ℕ, j < q →
    DifferentiableOn ℂ (μ_ℂ j) (horizStrip σ_mesh) ∧
    (∀ x : ℝ, μ_ℂ j x = midpoint_ℝ w (realMesh q w x j) (realMesh q w x (j + 1))) ∧
    (∀ z ∈ horizStrip σ_mesh, μ_ℂ j (z + 2 * Real.pi) = μ_ℂ j z + 2 * Real.pi) ∧
    (∀ z ∈ horizStrip σ_mesh, μ_ℂ j (starRingEnd ℂ z) = starRingEnd ℂ (μ_ℂ j z)) ∧
    (∀ z ∈ horizStrip σ_mesh, μ_ℂ j z ∈ horizStrip σ) ∧
    (∀ k : ℕ, k ≤ m + 2 → ∀ z ∈ horizStrip σ_mesh,
      (q : ℝ) ^ 3 *
        ‖iteratedDeriv k
          (fun ζ : ℂ =>
            (X_ℂ (j + 1) ζ - X_ℂ j ζ) - ((2 * Real.pi / (q : ℝ) : ℝ) : ℂ)) z‖ ≤
        S.R_mesh) ∧
    (∀ k : ℕ, k ≤ m + 2 → ∀ z ∈ horizStrip σ_mesh,
      (q : ℝ) ^ 2 *
        ‖iteratedDeriv k
          (fun ζ : ℂ => μ_ℂ j ζ - (X_ℂ j ζ + (X_ℂ (j + 1) ζ - X_ℂ j ζ) / 2)) z‖ ≤
        S.R_mesh))

noncomputable def deltaPhi_ℂ (W : ℂ → ℂ) (ζ₁ ζ₂ : ℂ) : ℂ :=
  (ζ₂ - ζ₁) * ∫ θ in (0 : ℝ)..1, Complex.exp (W (ζ₁ + (θ : ℂ) * (ζ₂ - ζ₁)))

noncomputable def cellKernelMinus_ℂ (W : ℂ → ℂ) (X μ z : ℂ) : ℂ :=
  2 * (1 - Complex.cos (deltaPhi_ℂ W X z)) * Complex.exp (-2 * W z) -
    Complex.exp (W z) * (μ - z) *
      ∫ β in (0 : ℝ)..1,
        Complex.sin (deltaPhi_ℂ W X (z + (β : ℂ) * (μ - z))) *
          Complex.exp (-2 * W (z + (β : ℂ) * (μ - z)))

noncomputable def cellKernelPlus_ℂ (W : ℂ → ℂ) (Y μ z : ℂ) : ℂ :=
  2 * (1 - Complex.cos (deltaPhi_ℂ W z Y)) * Complex.exp (-2 * W z) -
    Complex.exp (W z) * (z - μ) *
      ∫ β in (0 : ℝ)..1,
        Complex.sin (deltaPhi_ℂ W (μ + (β : ℂ) * (z - μ)) Y) *
          Complex.exp (-2 * W (μ + (β : ℂ) * (z - μ)))

noncomputable def stripCellIntegrand_ℂ (n : ℤ) (W : ℂ → ℂ)
    (X_ℂ μ_ℂ : ℕ → ℂ → ℂ) (xInvMinus xInvPlus : ℕ → ℝ → ℂ → ℂ)
    (j : ℕ) (z : ℂ) (α : ℝ) : ℂ :=
  let x_m := xInvMinus j α z
  let X_m := X_ℂ j x_m
  let μ_m := μ_ℂ j x_m
  let term_m : ℂ :=
    cellKernelMinus_ℂ W X_m μ_m z * (μ_m - X_m) *
      deriv (xInvMinus j α) z *
      Complex.exp (-Complex.I * (n : ℂ) * (x_m - z))
  let x_p := xInvPlus j α z
  let Y_p := X_ℂ (j + 1) x_p
  let μ_p := μ_ℂ j x_p
  let term_p : ℂ :=
    cellKernelPlus_ℂ W Y_p μ_p z * (Y_p - μ_p) *
      deriv (xInvPlus j α) z *
      Complex.exp (-Complex.I * (n : ℂ) * (x_p - z))
  term_m + term_p

noncomputable def stripB_canon (n : ℤ) (W : ℂ → ℂ)
    (X_ℂ μ_ℂ : ℕ → ℂ → ℂ) (xInvMinus xInvPlus : ℕ → ℝ → ℂ → ℂ) (z : ℂ) : ℂ :=
  -(((n.natAbs : ℝ) ^ 2 / (6 * Real.pi) : ℝ) : ℂ) *
    ∑ j ∈ Finset.range n.natAbs,
      ∫ α in (0 : ℝ)..1, stripCellIntegrand_ℂ n W X_ℂ μ_ℂ xInvMinus xInvPlus j z α

def IsHalfCellInvTuple (m : ℕ) (M : ℝ) (S : StationaryMeshSystem m (M + 1))
    (K_inv C_inv σ : ℝ) (q : ℕ) (w : ℝ → ℝ) (X_ℂ μ_ℂ : ℕ → ℂ → ℂ)
    (xInvMinus xInvPlus : ℕ → ℝ → ℂ → ℂ) : Prop :=
  let σ_mesh := (1 - S.K_mesh / (q : ℝ) ^ 2) * σ
  let σ_inv := (1 - K_inv / (q : ℝ) ^ 2) * σ
  ∀ j : ℕ, j < q →
    (∀ α ∈ Set.Icc (0 : ℝ) 1,
      DifferentiableOn ℂ (xInvMinus j α) (horizStrip σ_inv) ∧
      DifferentiableOn ℂ (xInvPlus j α) (horizStrip σ_inv) ∧
      (∀ z ∈ horizStrip σ_inv,
        xInvMinus j α z ∈ horizStrip σ_mesh ∧
        xInvPlus j α z ∈ horizStrip σ_mesh) ∧
      (∀ z ∈ horizStrip σ_inv,
        X_ℂ j (xInvMinus j α z) +
          (α : ℂ) * (μ_ℂ j (xInvMinus j α z) - X_ℂ j (xInvMinus j α z)) = z ∧
        μ_ℂ j (xInvPlus j α z) +
          (α : ℂ) * (X_ℂ (j + 1) (xInvPlus j α z) - μ_ℂ j (xInvPlus j α z)) = z) ∧
      (∀ z ∈ horizStrip σ_inv,
        xInvMinus j α (z + 2 * Real.pi) = xInvMinus j α z + 2 * Real.pi ∧
        xInvPlus j α (z + 2 * Real.pi) = xInvPlus j α z + 2 * Real.pi) ∧
      (∀ x : ℝ,
        xInvMinus j α x = halfCellInvMinus_ℝ q w j α x ∧
        deriv (xInvMinus j α) x = deriv (halfCellInvMinus_ℝ q w j α) x ∧
        xInvPlus j α x = halfCellInvPlus_ℝ q w j α x ∧
        deriv (xInvPlus j α) x = deriv (halfCellInvPlus_ℝ q w j α) x) ∧
      (∀ k : ℕ, k ≤ m + 1 → ∀ z ∈ horizStrip σ_inv,
        (q : ℝ) ^ 2 *
          ‖iteratedDeriv k
            (fun ζ : ℂ =>
              xInvMinus j α ζ -
                (ζ - ((((j : ℝ) + α / 2) * (2 * Real.pi / (q : ℝ)) : ℝ) : ℂ))) z‖ ≤
          C_inv ∧
        (q : ℝ) ^ 2 *
          ‖iteratedDeriv k
            (fun ζ : ℂ =>
              xInvPlus j α ζ -
                (ζ - ((((j : ℝ) + (1 + α) / 2) * (2 * Real.pi / (q : ℝ)) : ℝ) : ℂ))) z‖ ≤
          C_inv)) ∧
    (∀ k : ℕ, k ≤ m + 1 → ∀ z ∈ horizStrip σ_inv,
      ContinuousOn (fun α : ℝ => iteratedDeriv k (xInvMinus j α) z) (Set.Icc (0 : ℝ) 1) ∧
      ContinuousOn (fun α : ℝ => iteratedDeriv k (xInvPlus j α) z) (Set.Icc (0 : ℝ) 1))

def IsAdmissibleStripInvTuple (m : ℕ) (M : ℝ) (S : StationaryMeshSystem m (M + 1))
    (K_inv C_inv σ : ℝ) (q : ℕ) (w : ℝ → ℝ) (W : ℂ → ℂ)
    (X_ℂ μ_ℂ : ℕ → ℂ → ℂ) (xInvMinus xInvPlus : ℕ → ℝ → ℂ → ℂ) : Prop :=
  IsPeriodicSmoothBounded (m + 15) M w ∧
  IsBoundedStripExt (m + 15) σ M w W ∧
  IsStripMeshExt m (M + 1) S σ q w W X_ℂ μ_ℂ ∧
  IsHalfCellInvTuple m M S K_inv C_inv σ q w X_ℂ μ_ℂ xInvMinus xInvPlus

structure StripHalfCellInvSystem (m : ℕ) (M : ℝ) (S : StationaryMeshSystem m (M + 1)) where
  K_inv : ℝ
  C_inv : ℝ
  N_inv : ℕ
  K_mesh_lt : S.K_mesh < K_inv
  C_inv_pos : 0 < C_inv
  N_mesh_le : S.N_mesh ≤ N_inv
  inv_ext : ∀ (σ : ℝ) (q : ℕ) (w : ℝ → ℝ) (W : ℂ → ℂ) (X_ℂ μ_ℂ : ℕ → ℂ → ℂ),
    σ ∈ Set.Ioc (0 : ℝ) 1 →
    N_inv ≤ q →
    K_inv / (q : ℝ) ^ 2 < 1 →
    IsPeriodicSmoothBounded (m + 15) M w →
    IsBoundedStripExt (m + 15) σ M w W →
    IsStripMeshExt m (M + 1) S σ q w W X_ℂ μ_ℂ →
    ∃ (xInvMinus xInvPlus : ℕ → ℝ → ℂ → ℂ),
      IsHalfCellInvTuple m M S K_inv C_inv σ q w X_ℂ μ_ℂ xInvMinus xInvPlus
  inv_lip : ∀ (σ : ℝ) (q : ℕ)
      (w₁ w₂ : ℝ → ℝ) (W₁ W₂ : ℂ → ℂ)
      (X_ℂ₁ μ_ℂ₁ X_ℂ₂ μ_ℂ₂ : ℕ → ℂ → ℂ)
      (xInvMinus₁ xInvPlus₁ xInvMinus₂ xInvPlus₂ : ℕ → ℝ → ℂ → ℂ),
    σ ∈ Set.Ioc (0 : ℝ) 1 →
    N_inv ≤ q →
    K_inv / (q : ℝ) ^ 2 < 1 →
    IsAdmissibleStripInvTuple m M S K_inv C_inv σ q w₁ W₁ X_ℂ₁ μ_ℂ₁ xInvMinus₁ xInvPlus₁ →
    IsAdmissibleStripInvTuple m M S K_inv C_inv σ q w₂ W₂ X_ℂ₂ μ_ℂ₂ xInvMinus₂ xInvPlus₂ →
    ∀ j : ℕ, j < q → ∀ α ∈ Set.Icc (0 : ℝ) 1,
      ∀ k : ℕ, k ≤ m + 1 → ∀ z ∈ horizStrip ((1 - K_inv / (q : ℝ) ^ 2) * σ),
        (q : ℝ) ^ 2 *
          ‖iteratedDeriv k (fun ζ : ℂ => xInvMinus₁ j α ζ - xInvMinus₂ j α ζ) z‖ ≤
          C_inv * stripDiffSup (m + 15) σ W₁ W₂ ∧
        (q : ℝ) ^ 2 *
          ‖iteratedDeriv k (fun ζ : ℂ => xInvPlus₁ j α ζ - xInvPlus₂ j α ζ) z‖ ≤
          C_inv * stripDiffSup (m + 15) σ W₁ W₂

structure StripKernelSystem (m : ℕ) (M : ℝ) (S : StationaryMeshSystem m (M + 1))
    (H_inv : StripHalfCellInvSystem m M S) where
  C_ker : ℝ
  N_ker : ℕ
  C_ker_pos : 0 < C_ker
  N_inv_le : H_inv.N_inv ≤ N_ker
  real_eq : ∀ (σ : ℝ) (w : ℝ → ℝ) (W : ℂ → ℂ),
    σ ∈ Set.Ioc (0 : ℝ) 1 →
    IsPeriodicSmoothBounded (m + 15) M w →
    IsBoundedStripExt (m + 15) σ M w W →
    ∀ X Y z : ℝ,
      cellKernelMinus_ℂ W X (midpoint_ℝ w X Y) z = cellKernelMinus_ℝ w X Y z ∧
      cellKernelPlus_ℂ W Y (midpoint_ℝ w X Y) z = cellKernelPlus_ℝ w X Y z
  diag_periodic : ∀ (σ : ℝ) (w : ℝ → ℝ) (W : ℂ → ℂ),
    σ ∈ Set.Ioc (0 : ℝ) 1 →
    IsBoundedStripExt (m + 15) σ M w W →
    ∀ X Y μ z : ℂ,
      X ∈ horizStrip σ → Y ∈ horizStrip σ → μ ∈ horizStrip σ → z ∈ horizStrip σ →
      cellKernelMinus_ℂ W (X + 2 * Real.pi) (μ + 2 * Real.pi) (z + 2 * Real.pi) =
        cellKernelMinus_ℂ W X μ z ∧
      cellKernelPlus_ℂ W (Y + 2 * Real.pi) (μ + 2 * Real.pi) (z + 2 * Real.pi) =
        cellKernelPlus_ℂ W Y μ z
  composed_props : ∀ (σ : ℝ) (q : ℕ) (w : ℝ → ℝ) (W : ℂ → ℂ)
      (X_ℂ μ_ℂ : ℕ → ℂ → ℂ) (xInvMinus xInvPlus : ℕ → ℝ → ℂ → ℂ),
    σ ∈ Set.Ioc (0 : ℝ) 1 →
    N_ker ≤ q →
    H_inv.K_inv / (q : ℝ) ^ 2 < 1 →
    IsAdmissibleStripInvTuple m M S H_inv.K_inv H_inv.C_inv σ q w W
      X_ℂ μ_ℂ xInvMinus xInvPlus →
    let σ_inv := (1 - H_inv.K_inv / (q : ℝ) ^ 2) * σ
    ∀ j : ℕ, j < q →
      (∀ α ∈ Set.Icc (0 : ℝ) 1,
        let K_m : ℂ → ℂ := fun ζ =>
          cellKernelMinus_ℂ W (X_ℂ j (xInvMinus j α ζ)) (μ_ℂ j (xInvMinus j α ζ)) ζ
        let K_p : ℂ → ℂ := fun ζ =>
          cellKernelPlus_ℂ W (X_ℂ (j + 1) (xInvPlus j α ζ)) (μ_ℂ j (xInvPlus j α ζ)) ζ
        let h_m : ℂ → ℂ := fun ζ =>
          μ_ℂ j (xInvMinus j α ζ) - X_ℂ j (xInvMinus j α ζ)
        let h_p : ℂ → ℂ := fun ζ =>
          X_ℂ (j + 1) (xInvPlus j α ζ) - μ_ℂ j (xInvPlus j α ζ)
        DifferentiableOn ℂ K_m (horizStrip σ_inv) ∧
        DifferentiableOn ℂ K_p (horizStrip σ_inv) ∧
        DifferentiableOn ℂ h_m (horizStrip σ_inv) ∧
        DifferentiableOn ℂ h_p (horizStrip σ_inv) ∧
        (∀ k : ℕ, k ≤ m → ∀ z ∈ horizStrip σ_inv,
          (q : ℝ) ^ 3 *
            ‖iteratedDeriv k
              (fun ζ : ℂ =>
                K_m ζ -
                  (((Real.pi ^ 2 / (q : ℝ) ^ 2) *
                    ((3 / 2 : ℝ) * α ^ 2 - 1 / 2) : ℝ) : ℂ)) z‖ ≤ C_ker ∧
          (q : ℝ) ^ 3 *
            ‖iteratedDeriv k
              (fun ζ : ℂ =>
                K_p ζ -
                  (((Real.pi ^ 2 / (q : ℝ) ^ 2) *
                    ((3 / 2 : ℝ) * (1 - α) ^ 2 - 1 / 2) : ℝ) : ℂ)) z‖ ≤ C_ker ∧
          (q : ℝ) ^ 2 *
            ‖iteratedDeriv k
              (fun ζ : ℂ => h_m ζ - ((Real.pi / (q : ℝ) : ℝ) : ℂ)) z‖ ≤ C_ker ∧
          (q : ℝ) ^ 2 *
            ‖iteratedDeriv k
              (fun ζ : ℂ => h_p ζ - ((Real.pi / (q : ℝ) : ℝ) : ℂ)) z‖ ≤ C_ker)) ∧
      (∀ k : ℕ, k ≤ m → ∀ z ∈ horizStrip σ_inv,
        ContinuousOn
          (fun α : ℝ =>
            iteratedDeriv k
              (fun ζ : ℂ =>
                cellKernelMinus_ℂ W
                  (X_ℂ j (xInvMinus j α ζ)) (μ_ℂ j (xInvMinus j α ζ)) ζ) z)
          (Set.Icc (0 : ℝ) 1) ∧
        ContinuousOn
          (fun α : ℝ =>
            iteratedDeriv k
              (fun ζ : ℂ =>
                cellKernelPlus_ℂ W
                  (X_ℂ (j + 1) (xInvPlus j α ζ)) (μ_ℂ j (xInvPlus j α ζ)) ζ) z)
          (Set.Icc (0 : ℝ) 1) ∧
        ContinuousOn
          (fun α : ℝ =>
            iteratedDeriv k
              (fun ζ : ℂ =>
                μ_ℂ j (xInvMinus j α ζ) - X_ℂ j (xInvMinus j α ζ)) z)
          (Set.Icc (0 : ℝ) 1) ∧
        ContinuousOn
          (fun α : ℝ =>
            iteratedDeriv k
              (fun ζ : ℂ =>
                X_ℂ (j + 1) (xInvPlus j α ζ) - μ_ℂ j (xInvPlus j α ζ)) z)
          (Set.Icc (0 : ℝ) 1))
  composed_lip : ∀ (σ : ℝ) (q : ℕ)
      (w₁ w₂ : ℝ → ℝ) (W₁ W₂ : ℂ → ℂ)
      (X_ℂ₁ μ_ℂ₁ X_ℂ₂ μ_ℂ₂ : ℕ → ℂ → ℂ)
      (xInvMinus₁ xInvPlus₁ xInvMinus₂ xInvPlus₂ : ℕ → ℝ → ℂ → ℂ),
    σ ∈ Set.Ioc (0 : ℝ) 1 →
    N_ker ≤ q →
    H_inv.K_inv / (q : ℝ) ^ 2 < 1 →
    IsAdmissibleStripInvTuple m M S H_inv.K_inv H_inv.C_inv σ q w₁ W₁
      X_ℂ₁ μ_ℂ₁ xInvMinus₁ xInvPlus₁ →
    IsAdmissibleStripInvTuple m M S H_inv.K_inv H_inv.C_inv σ q w₂ W₂
      X_ℂ₂ μ_ℂ₂ xInvMinus₂ xInvPlus₂ →
    let σ_inv := (1 - H_inv.K_inv / (q : ℝ) ^ 2) * σ
    ∀ j : ℕ, j < q → ∀ α ∈ Set.Icc (0 : ℝ) 1,
      let K_m₁ : ℂ → ℂ := fun ζ =>
        cellKernelMinus_ℂ W₁ (X_ℂ₁ j (xInvMinus₁ j α ζ)) (μ_ℂ₁ j (xInvMinus₁ j α ζ)) ζ
      let K_m₂ : ℂ → ℂ := fun ζ =>
        cellKernelMinus_ℂ W₂ (X_ℂ₂ j (xInvMinus₂ j α ζ)) (μ_ℂ₂ j (xInvMinus₂ j α ζ)) ζ
      let K_p₁ : ℂ → ℂ := fun ζ =>
        cellKernelPlus_ℂ W₁ (X_ℂ₁ (j + 1) (xInvPlus₁ j α ζ)) (μ_ℂ₁ j (xInvPlus₁ j α ζ)) ζ
      let K_p₂ : ℂ → ℂ := fun ζ =>
        cellKernelPlus_ℂ W₂ (X_ℂ₂ (j + 1) (xInvPlus₂ j α ζ)) (μ_ℂ₂ j (xInvPlus₂ j α ζ)) ζ
      let h_m₁ : ℂ → ℂ := fun ζ =>
        μ_ℂ₁ j (xInvMinus₁ j α ζ) - X_ℂ₁ j (xInvMinus₁ j α ζ)
      let h_m₂ : ℂ → ℂ := fun ζ =>
        μ_ℂ₂ j (xInvMinus₂ j α ζ) - X_ℂ₂ j (xInvMinus₂ j α ζ)
      let h_p₁ : ℂ → ℂ := fun ζ =>
        X_ℂ₁ (j + 1) (xInvPlus₁ j α ζ) - μ_ℂ₁ j (xInvPlus₁ j α ζ)
      let h_p₂ : ℂ → ℂ := fun ζ =>
        X_ℂ₂ (j + 1) (xInvPlus₂ j α ζ) - μ_ℂ₂ j (xInvPlus₂ j α ζ)
      ∀ k : ℕ, k ≤ m → ∀ z ∈ horizStrip σ_inv,
        (q : ℝ) ^ 3 * ‖iteratedDeriv k (fun ζ : ℂ => K_m₁ ζ - K_m₂ ζ) z‖ ≤
          C_ker * stripDiffSup (m + 15) σ W₁ W₂ ∧
        (q : ℝ) ^ 3 * ‖iteratedDeriv k (fun ζ : ℂ => K_p₁ ζ - K_p₂ ζ) z‖ ≤
          C_ker * stripDiffSup (m + 15) σ W₁ W₂ ∧
        (q : ℝ) ^ 2 * ‖iteratedDeriv k (fun ζ : ℂ => h_m₁ ζ - h_m₂ ζ) z‖ ≤
          C_ker * stripDiffSup (m + 15) σ W₁ W₂ ∧
        (q : ℝ) ^ 2 * ‖iteratedDeriv k (fun ζ : ℂ => h_p₁ ζ - h_p₂ ζ) z‖ ≤
          C_ker * stripDiffSup (m + 15) σ W₁ W₂
structure ZeroSliceExtractedData {Ω : Set Plane} {C : AnalyticGlancingCollar Ω}
    {hDet : EndpointDeterminationData C} (W : CollarWidthTubeData C hDet) where
  Γ_slice : ℂ → (Fin 2 → ℂ)
  a_mero : ℂ → ℂ
  f_mero : ℂ → ℂ
  E_disc : Set ℂ
  E_disc_sub : E_disc ⊆ horizStripENNR (W.h_X 0)
  E_disc_base_disjoint : ∀ s ∈ horizStrip W.s_base, s ∉ E_disc
  E_disc_isolated : ∀ s ∈ horizStripENNR (W.h_X 0),
    ∃ r : ℝ, 0 < r ∧ Metric.ball s r ⊆ horizStripENNR (W.h_X 0) ∧
      ∀ z ∈ Metric.ball s r, z ≠ s → z ∉ E_disc
  Γ_nf : MeromorphicNFOn (fun s => Γ_slice s 0) (horizStripENNR (W.h_X 0)) ∧
    MeromorphicNFOn (fun s => Γ_slice s 1) (horizStripENNR (W.h_X 0))
  Γ_mero : MeromorphicOn (fun s => Γ_slice s 0) (horizStripENNR (W.h_X 0)) ∧
    MeromorphicOn (fun s => Γ_slice s 1) (horizStripENNR (W.h_X 0))
  a_mero_mero : MeromorphicOn a_mero (horizStripENNR (W.h_X 0))
  f_mero_mero : MeromorphicOn f_mero (horizStripENNR (W.h_X 0))
  slice_base_eq : ∀ s ∈ horizStrip W.s_base,
    Γ_slice s = glancingBoundaryCurve C s ∧
    a_mero s = Complex.exp (Complex.I * C.ϕ_ℂ s) ∧
    f_mero s = deriv C.ϕ_ℂ s
  slice_reg : ∀ s ∈ horizStripENNR (W.h_X 0), s ∉ E_disc →
    AnalyticAt ℂ (fun z => Γ_slice z 0) s ∧
    AnalyticAt ℂ (fun z => Γ_slice z 1) s ∧
    AnalyticAt ℂ a_mero s ∧
    AnalyticAt ℂ f_mero s ∧
    a_mero s ≠ 0 ∧
    f_mero s ≠ 0 ∧
    deriv (fun z => Γ_slice z 0) s + Complex.I * deriv (fun z => Γ_slice z 1) s =
      Complex.I * C.c * a_mero s / (f_mero s) ^ 2 ∧
    deriv (fun z => Γ_slice z 0) s - Complex.I * deriv (fun z => Γ_slice z 1) s =
      -Complex.I * C.c / (a_mero s * (f_mero s) ^ 2) ∧
    deriv a_mero s = Complex.I * f_mero s * a_mero s ∧
    ∃ (r_s : ℝ) (X_loc : Fin 2 → ℂ × ℂ → ℂ),
      0 < r_s ∧
      Metric.ball (s, (0 : ℂ)) r_s ⊆ meroTubeENNR W.r_base W.h_X ∧
      (∀ z ∈ Metric.ball s r_s, z ∈ horizStripENNR (W.h_X 0) ∧ z ∉ E_disc) ∧
      (∀ i : Fin 2, DifferentiableOn ℂ (X_loc i) (Metric.ball (s, (0 : ℂ)) r_s)) ∧
      (∀ i : Fin 2, MeroAgreesHolo (W.X_mero i) (X_loc i) (Metric.ball (s, (0 : ℂ)) r_s)) ∧
      (∀ i : Fin 2, ∀ z ∈ Metric.ball s r_s, X_loc i (z, 0) = Γ_slice z i)
  Γ_conj_nhdsNE : ∀ s ∈ horizStripENNR (W.h_X 0), ∀ i : Fin 2,
    ∀ᶠ z in nhdsWithin s {s}ᶜ,
      Γ_slice (starRingEnd ℂ z) i = starRingEnd ℂ (Γ_slice z i)
  L_slice_holo_isolated : ∀ s ∈ horizStripENNR (W.h_X 0),
    ∃ r : ℝ, 0 < r ∧ Metric.ball s r ⊆ horizStripENNR (W.h_X 0) ∧
      ∀ z ∈ Metric.ball s r, z ≠ s →
        ∃ (r_z : ℝ) (L_loc : Fin 2 → ℂ × ℂ → ℂ),
          0 < r_z ∧
          Metric.ball (z, (0 : ℂ)) r_z ⊆ meroTubeENNR W.r_base W.h_L ∧
          (∀ i : Fin 2, DifferentiableOn ℂ (L_loc i) (Metric.ball (z, (0 : ℂ)) r_z)) ∧
          (∀ i : Fin 2, MeroAgreesHolo (W.L_mero i) (L_loc i) (Metric.ball (z, (0 : ℂ)) r_z))

def slabBox (x_edge R_0 y_row δ_slab δ_t : ℝ) : Set (ℂ × ℂ) :=
  { p : ℂ × ℂ |
    |p.1.re - x_edge| < R_0 / 2 + 2 * δ_slab ∧
    |p.1.im - y_row| < 2 * δ_slab ∧
    ‖p.2‖ < 2 * δ_t }

structure LocalPatchSlabData {Ω : Set Plane} {C : AnalyticGlancingCollar Ω}
    {hDet : EndpointDeterminationData C} (W : CollarWidthTubeData C hDet) (H₀ : ℝ) where
  x_edge : ℝ
  R_0 : ℝ
  y_row : ℝ
  δ_slab : ℝ
  δ_t : ℝ
  δ_rec : ℝ
  C_rec : ℝ
  C_init : ℝ
  H₀_ge : 2 * W.s_base ≤ H₀
  R_0_pos : 0 < R_0
  R_0_lt : R_0 < W.s_base / 2
  y_row_bounds : H₀ - R_0 / 16 < y_row ∧ y_row < H₀ - R_0 / 32
  δ_slab_pos : 0 < δ_slab
  δ_slab_lt_R : δ_slab < R_0 / 64
  δ_slab_lt_gap : y_row + 2 * δ_slab < H₀ - R_0 / 64
  δ_t_pos : 0 < δ_t
  δ_rec_pos : 0 < δ_rec
  C_rec_pos : 0 < C_rec
  C_init_pos : 0 < C_init
  G_succ : ℂ × ℂ → ℂ
  L_line : Fin 2 → ℂ × ℂ → ℂ
  V_slab : ℂ × ℂ → ℂ
  G_succ_holo : DifferentiableOn ℂ G_succ
    (Metric.ball ((x_edge : ℂ) + (H₀ : ℂ) * Complex.I) R_0 ×ˢ Metric.ball (0 : ℂ) δ_rec)
  G_succ_cubic : ∀ V Δ : ℂ,
    V ∈ Metric.ball ((x_edge : ℂ) + (H₀ : ℂ) * Complex.I) R_0 →
    Δ ∈ Metric.ball (0 : ℂ) δ_rec →
    ‖G_succ (V, Δ) - Δ‖ ≤ C_rec * ‖Δ‖ ^ 3
  L_line_holo : ∀ i : Fin 2, DifferentiableOn ℂ (L_line i)
    (Metric.ball ((x_edge : ℂ) + (H₀ : ℂ) * Complex.I) R_0 ×ˢ Metric.ball (0 : ℂ) δ_rec)
  V_slab_holo : DifferentiableOn ℂ V_slab (slabBox x_edge R_0 y_row δ_slab δ_t)
  V_slab_quad : ∀ p ∈ slabBox x_edge R_0 y_row δ_slab δ_t,
    ‖V_slab p - p.1‖ ≤ C_init * ‖p.2‖ ^ 2
  slab_recurrence : ∀ y t : ℂ,
    (y - t, t) ∈ slabBox x_edge R_0 y_row δ_slab δ_t →
    (y, t) ∈ slabBox x_edge R_0 y_row δ_slab δ_t →
    (y + t, t) ∈ slabBox x_edge R_0 y_row δ_slab δ_t →
    V_slab (y, t) ∈ Metric.ball ((x_edge : ℂ) + (H₀ : ℂ) * Complex.I) R_0 ∧
    ‖V_slab (y, t) - V_slab (y - t, t)‖ < δ_rec ∧
    ‖V_slab (y + t, t) - V_slab (y, t)‖ < δ_rec ∧
    V_slab (y + t, t) - V_slab (y, t) =
      G_succ (V_slab (y, t), V_slab (y, t) - V_slab (y - t, t))
  slab_agrees_L : ∀ i : Fin 2,
    MeroAgreesHolo (W.L_mero i)
      (fun p => L_line i (V_slab p, V_slab (p.1 + p.2, p.2) - V_slab p))
      { p : ℂ × ℂ |
        |p.1.re - x_edge| < R_0 / 2 + δ_slab ∧
        |p.1.im - y_row| < δ_slab ∧
        ‖p.2‖ < δ_t }
  L_mero_even : ∀ i : Fin 2, ∀ p ∈ meroTubeENNR W.r_base W.h_L,
    (p.1, -p.2) ∈ meroTubeENNR W.r_base W.h_L ∧
    ∀ q ∈ Metric.ball p (min ((W.L_mero i).rad p) ((W.L_mero i).rad (p.1, -p.2))),
      (W.L_mero i).num p q * (W.L_mero i).den (p.1, -p.2) (q.1, -q.2) =
        (W.L_mero i).num (p.1, -p.2) (q.1, -q.2) * (W.L_mero i).den p q

def steepCorridorY (x_edge H₀ R_0 y_row δ_slab : ℝ) : Set ℂ :=
  { y : ℂ |
    |y.re - x_edge| < R_0 / 8 ∧
    y_row - δ_slab / 2 < y.im ∧ y.im < H₀ + R_0 / 32 }

def steepSectorT (r_steep : ℝ) : Set ℂ :=
  { t : ℂ | 0 < ‖t‖ ∧ ‖t‖ < r_steep ∧ ‖t‖ / 3 < |t.im| }

structure SteepCorridorDualLineData {Ω : Set Plane} {C : AnalyticGlancingCollar Ω}
    {hDet : EndpointDeterminationData C} (W : CollarWidthTubeData C hDet)
    (H₀ x_edge R_0 y_row δ_slab : ℝ) where
  H₀_ge : 2 * W.s_base ≤ H₀
  R_0_pos : 0 < R_0
  R_0_lt : R_0 < W.s_base / 2
  y_row_bounds : H₀ - R_0 / 16 < y_row ∧ y_row < H₀ - R_0 / 32
  δ_slab_pos : 0 < δ_slab
  r_steep : ℝ
  r_steep_pos : 0 < r_steep
  r_steep_le : r_steep ≤ W.r_base
  Λ_steep : Fin 2 → ℂ × ℂ → ℂ
  Λ_steep_holo : ∀ i : Fin 2,
    DifferentiableOn ℂ (Λ_steep i)
      (steepCorridorY x_edge H₀ R_0 y_row δ_slab ×ˢ steepSectorT r_steep)
  Λ_steep_agrees : ∀ μ : ℝ, 0 < μ → y_row < H₀ - μ →
    ∃ r_μ : ℝ, 0 < r_μ ∧ r_μ ≤ r_steep ∧
      ∀ i : Fin 2,
        MeroAgreesHolo (W.L_mero i) (Λ_steep i)
          ((steepCorridorY x_edge H₀ R_0 y_row δ_slab ∩ { y : ℂ | y.im < H₀ - μ }) ×ˢ
            (steepSectorT r_steep ∩ Metric.ball (0 : ℂ) r_μ))
noncomputable def divRoot_bfd (n j : ℤ) : ℝ :=
  (2 * Real.pi * (j : ℝ)) / (n : ℝ)

noncomputable def activeRootIdx_bfd (d δ : ℝ) (b N : ℕ) (n : ℤ) : Finset ℤ :=
  (Finset.Icc (-(N : ℤ)) (N : ℤ)).filter
    (fun j : ℤ => j ≠ 0 ∧ |divRoot_bfd n j| < d - (b : ℝ) * δ)

noncomputable def sincInterp1D_bfd (d δ : ℝ) (b N : ℕ) (n : ℤ) (f : ℂ → ℂ) (t : ℂ) : ℂ :=
  ∑ j ∈ activeRootIdx_bfd d δ b N n,
    f ((divRoot_bfd n j : ℝ) : ℂ) *
      sinc_ℂ ((n : ℂ) * (t - ((divRoot_bfd n j : ℝ) : ℂ)) / 2)

open Classical in
noncomputable def divMode1D_bfd (d δ : ℝ) (b N : ℕ) (n : ℤ) (f : ℂ → ℂ) (t : ℂ) : ℂ :=
  let G : ℂ → ℂ := fun z => f z - sincInterp1D_bfd d δ b N n f z
  if fourierDiffMult n t = 0 then deriv G t / deriv (fourierDiffMult n) t
  else G t / fourierDiffMult n t

def StripFourierAndDiffMultProp_bfd : Prop :=
  (∀ (σ M : ℝ) (G : ℂ → ℂ),
    0 < σ → 0 ≤ M → DifferentiableOn ℂ G (horizStrip σ) →
    (∀ z ∈ horizStrip σ, G (z + 2 * Real.pi) = G z ∧ ‖G z‖ ≤ M) →
    (∀ n : ℤ, ‖fourierCoeff_ℂ (fun p => G p.1) n 0‖ ≤ M * Real.exp (-|(n : ℝ)| * σ)) ∧
    (∀ y ∈ horizStrip σ,
      HasSum
        (fun n : ℤ =>
          fourierCoeff_ℂ (fun p => G p.1) n 0 * Complex.exp (Complex.I * (n : ℂ) * y))
        (G y))) ∧
  (∀ (σ : ℝ) (t : ℂ) (G : ℂ × ℂ → ℂ),
    |t.im| / 2 < σ →
    DifferentiableOn ℂ (fun y : ℂ => G (y, t)) (horizStrip σ) →
    (∀ y ∈ horizStrip σ, G (y + 2 * Real.pi, t) = G (y, t)) →
    ∀ n : ℤ,
      fourierCoeff_ℂ (glancingDiffOp G) n t = fourierDiffMult n t * fourierCoeff_ℂ G n t)

def SincDivisorCalculusProp_bfd : Prop :=
  Differentiable ℂ sinc_ℂ ∧
  sinc_ℂ 0 = 1 ∧
  (∀ z : ℂ, z * sinc_ℂ z = Complex.sin z) ∧
  (∀ z : ℂ, sinc_ℂ (-z) = sinc_ℂ z) ∧
  (∀ z : ℂ, sinc_ℂ (starRingEnd ℂ z) = starRingEnd ℂ (sinc_ℂ z)) ∧
  (∀ z : ℂ, ‖sinc_ℂ z‖ ≤ Real.exp |z.im| ∧ ‖deriv sinc_ℂ z‖ ≤ Real.exp |z.im|) ∧
  (∀ (n : ℤ) (t : ℂ),
    (∫ μ in (-1 / 2 : ℝ)..(1 / 2 : ℝ),
      Complex.exp (Complex.I * (n : ℂ) * (μ : ℂ) * t)) = sinc_ℂ ((n : ℂ) * t / 2)) ∧
  (∀ j : ℤ, j ≠ 0 → sinc_ℂ ((Real.pi : ℂ) * (j : ℂ)) = 0) ∧
  (∀ n : ℤ,
    Differentiable ℂ (fourierDiffMult n) ∧
    (∀ t : ℂ, fourierDiffMult n (-t) = fourierDiffMult n t) ∧
    (∀ t : ℂ, fourierDiffMult (-n) (starRingEnd ℂ t) = starRingEnd ℂ (fourierDiffMult n t))) ∧
  (∀ n : ℤ, n ≠ 0 →
    (∀ t : ℂ, fourierDiffMult n t = 0 ↔ ∃ j : ℤ, j ≠ 0 ∧ t = ((divRoot_bfd n j : ℝ) : ℂ)) ∧
    (∀ j : ℤ, j ≠ 0 → deriv (fourierDiffMult n) ((divRoot_bfd n j : ℝ) : ℂ) ≠ 0)) ∧
  (∀ (n : ℤ) (δ : ℝ) (t : ℂ),
    1 ≤ |n| → 0 < δ → δ < 1 / 100 → ‖t‖ < 1 →
    (∀ j : ℤ, j ≠ 0 → (1 / 4 : ℝ) * min |(n : ℝ)|⁻¹ δ ≤ ‖t - ((divRoot_bfd n j : ℝ) : ℂ)‖) →
    fourierDiffMult n t ≠ 0 ∧
    ‖fourierDiffMult n t‖⁻¹ ≤ 36 * δ⁻¹ * Real.exp (-|(n : ℝ)| * |t.im| / 2))

def SingleModeSincDivProp_bfd : Prop :=
  ∀ (s d δ ν M η : ℝ) (N j₀ a b : ℕ) (n : ℤ),
    0 < s → 0 < d → d < 1 → d < s / 2 → 0 < δ → δ < d / 100 →
    (ν = 1 / 2 ∨ ν = 1) → 1 ≤ N →
    j₀ ≤ a → j₀ + 1 ≤ b → b ≤ 20 →
    0 ≤ M → 0 ≤ η →
    1 ≤ |n| → |n| ≤ (N : ℤ) →
    (∀ (f : ℂ → ℂ),
      DifferentiableOn ℂ f (Metric.ball (0 : ℂ) (d - (j₀ : ℝ) * δ)) →
      (∀ t ∈ Metric.ball (0 : ℂ) (d - (j₀ : ℝ) * δ),
        ‖f t‖ ≤ M * Real.exp (-|(n : ℝ)| * (s - (j₀ : ℝ) * δ - ν * |t.im|))) →
      (∀ j : ℤ, j ≠ 0 → |divRoot_bfd n j| < d - (b : ℝ) * δ →
        ‖f ((divRoot_bfd n j : ℝ) : ℂ)‖ ≤ η * Real.exp (-|(n : ℝ)| * (s - (a : ℝ) * δ))) →
      let R_n := sincInterp1D_bfd d δ b N n f
      let H_n := divMode1D_bfd d δ b N n f
      let Q := 1 + (N : ℝ) + δ⁻¹
      Differentiable ℂ R_n ∧
      DifferentiableOn ℂ H_n (Metric.ball (0 : ℂ) (d - ((b + 1 : ℕ) : ℝ) * δ)) ∧
      (∀ t : ℂ,
        ‖R_n t‖ + ((N : ℝ))⁻¹ * ‖deriv R_n t‖ ≤
          3 * Q * η * Real.exp (-|(n : ℝ)| * (s - (a : ℝ) * δ - |t.im| / 2))) ∧
      (∀ t ∈ Metric.ball (0 : ℂ) (d - ((b + 1 : ℕ) : ℝ) * δ),
        fourierDiffMult n t * H_n t = f t - R_n t ∧
        ‖H_n t‖ ≤
          324 * Q ^ 2 * (M + η) *
            Real.exp (-|(n : ℝ)| * (s - (a : ℝ) * δ - (ν - 1 / 2) * |t.im|))) ∧
      ((∀ t ∈ Metric.ball (0 : ℂ) (d - (j₀ : ℝ) * δ), f (-t) = f t) →
        ∀ t ∈ Metric.ball (0 : ℂ) (d - ((b + 1 : ℕ) : ℝ) * δ), H_n (-t) = H_n t)) ∧
    (∀ (f_pos f_neg : ℂ → ℂ),
      DifferentiableOn ℂ f_pos (Metric.ball (0 : ℂ) (d - (j₀ : ℝ) * δ)) →
      DifferentiableOn ℂ f_neg (Metric.ball (0 : ℂ) (d - (j₀ : ℝ) * δ)) →
      (∀ t ∈ Metric.ball (0 : ℂ) (d - (j₀ : ℝ) * δ),
        f_neg (starRingEnd ℂ t) = starRingEnd ℂ (f_pos t)) →
      ∀ t ∈ Metric.ball (0 : ℂ) (d - ((b + 1 : ℕ) : ℝ) * δ),
        divMode1D_bfd d δ b N (-n) f_neg (starRingEnd ℂ t) =
          starRingEnd ℂ (divMode1D_bfd d δ b N n f_pos t))

def BufferedFourierDivMainProp_bfd : Prop :=
  ∃ (C_div : ℝ) (B_div : ℕ), 0 < C_div ∧
    ∀ (s d δ ν M η : ℝ) (N j₀ a b J : ℕ) (F : ℂ × ℂ → ℂ),
      0 < s → 0 < d → d < 1 → d < s / 2 → 0 < δ → δ < d / 100 →
      (ν = 1 / 2 ∨ ν = 1) → 1 ≤ N →
      j₀ ≤ a → j₀ + 1 ≤ b → max a (b + 1) + 1 ≤ J → J ≤ 20 →
      0 ≤ M → 0 ≤ η →
      DifferentiableOn ℂ F (glancingDomain ν (s - (j₀ : ℝ) * δ) (d - (j₀ : ℝ) * δ)) →
      (∀ y t : ℂ, (y, t) ∈ glancingDomain ν (s - (j₀ : ℝ) * δ) (d - (j₀ : ℝ) * δ) →
        F (y + 2 * Real.pi, t) = F (y, t) ∧
        F (y, -t) = F (y, t) ∧
        F (starRingEnd ℂ y, starRingEnd ℂ t) = starRingEnd ℂ (F (y, t)) ∧
        ‖F (y, t)‖ ≤ M) →
      (∀ t : ℂ, ‖t‖ < d - (j₀ : ℝ) * δ →
        (∫ x in (0 : ℝ)..(2 * Real.pi), F ((x : ℂ), t)) = 0) →
      (∀ (n : ℤ) (j : ℤ),
        1 ≤ |n| → |n| ≤ (N : ℤ) → j ≠ 0 →
        |(2 * Real.pi * (j : ℝ)) / (n : ℝ)| < d - (b : ℝ) * δ →
        ‖fourierCoeff_ℂ F n (((2 * Real.pi * (j : ℝ)) / (n : ℝ) : ℝ) : ℂ)‖ ≤
          η * Real.exp (-|(n : ℝ)| * (s - (a : ℝ) * δ))) →
      ∃ (H_mode R_mode : ℤ → ℂ → ℂ),
        (∀ n : ℤ, n = 0 ∨ (N : ℤ) < |n| → ∀ t : ℂ, H_mode n t = 0 ∧ R_mode n t = 0) ∧
        (∀ n : ℤ, 1 ≤ |n| → |n| ≤ (N : ℤ) →
          DifferentiableOn ℂ (H_mode n)
            (Metric.ball (0 : ℂ) (d - ((b + 1 : ℕ) : ℝ) * δ)) ∧
          Differentiable ℂ (R_mode n) ∧
          (∀ t ∈ Metric.ball (0 : ℂ) (d - ((b + 1 : ℕ) : ℝ) * δ),
            fourierDiffMult n t * H_mode n t = fourierCoeff_ℂ F n t - R_mode n t ∧
            ‖R_mode n t‖ + ((N : ℝ))⁻¹ * ‖deriv (R_mode n) t‖ ≤
              C_div * (1 + (N : ℝ) + δ⁻¹) ^ B_div * η *
                Real.exp (-|(n : ℝ)| * (s - (a : ℝ) * δ - |t.im| / 2)))) ∧
        (let H : ℂ × ℂ → ℂ :=
          fun p =>
            ∑ n ∈ Finset.Icc (-(N : ℤ)) (N : ℤ),
              H_mode n p.2 * Complex.exp (Complex.I * (n : ℂ) * p.1)
         let Q := 1 + (N : ℝ) + δ⁻¹
         DifferentiableOn ℂ H
           (glancingDomain 0 (s - (J : ℝ) * δ) (d - ((b + 1 : ℕ) : ℝ) * δ)) ∧
         (∀ y t : ℂ, ‖t‖ < d - ((b + 1 : ℕ) : ℝ) * δ →
           H (y + 2 * Real.pi, t) = H (y, t) ∧
           H (y, -t) = H (y, t) ∧
           H (starRingEnd ℂ y, starRingEnd ℂ t) = starRingEnd ℂ (H (y, t)) ∧
           (∫ x in (0 : ℝ)..(2 * Real.pi), H ((x : ℂ), t)) = 0) ∧
         (∀ p ∈ glancingDomain (ν - 1 / 2) (s - (J : ℝ) * δ) (d - (J : ℝ) * δ),
           ‖H p‖ ≤ C_div * Q ^ B_div * (M + η)) ∧
         (∀ p ∈ glancingDomain ν (s - (J : ℝ) * δ) (d - (J : ℝ) * δ),
           ‖glancingDiffOp H p - F p‖ ≤
             C_div * Q ^ B_div * (η + M * Real.exp (-(N : ℝ) * δ))))
noncomputable def steepContActionA (Phi : ℂ × ℂ → ℂ) (s J t : ℂ) : ℂ :=
  J ^ 3 * (Phi (s, t * J) - (1 / 24 : ℂ))

noncomputable def steepContActionDJ (Phi : ℂ × ℂ → ℂ) (s J t : ℂ) : ℂ :=
  deriv (fun J' : ℂ => steepContActionA Phi s J' t) J

noncomputable def steepContActionDS (Phi : ℂ × ℂ → ℂ) (s J t : ℂ) : ℂ :=
  deriv (fun s' : ℂ => steepContActionA Phi s' J t) s

noncomputable def steepContPerturbG (Phi : ℂ × ℂ → ℂ) (s_0 t J : ℂ) : ℂ :=
  steepContActionDJ Phi s_0 J t - t * steepContActionDS Phi s_0 J t

noncomputable def steepContResidual (Phi : ℂ × ℂ → ℂ) (s_m J_m s_0 t J : ℂ) : ℂ :=
  (1 / 8 : ℂ) * (J ^ 2 - J_m ^ 2) +
    steepContPerturbG Phi s_0 t J -
    steepContActionDJ Phi s_m J_m t

def steepContTripleDomain (S : FiniteWallNonisotropicStrip) (η_SL : ℝ) :
    Set (ℂ × ℂ × ℂ) :=
  { q : ℂ × ℂ × ℂ | (q.1, q.2.2 * q.2.1) ∈ smallChordDomain S η_SL }

noncomputable def steepContIterJ (Phi : ℂ × ℂ → ℂ) (s_m s_0 t : ℂ) : ℕ → ℂ
  | 0 => (s_0 - s_m) / t
  | n + 1 =>
      let u := steepContIterJ Phi s_m s_0 t n
      u - (4 : ℂ) * steepContResidual Phi s_m ((s_0 - s_m) / t) s_0 t u

noncomputable def steepContSolJ (Phi : ℂ × ℂ → ℂ) (s_m s_0 t : ℂ) : ℂ :=
  Filter.limUnder Filter.atTop (steepContIterJ Phi s_m s_0 t)

noncomputable def steepContChain (Phi : ℂ × ℂ → ℂ) (s_base : ℂ × ℂ → ℂ)
    (y_bot t : ℂ) : ℕ → ℂ × ℂ
  | 0 => (s_base (y_bot, t), s_base (y_bot + t, t))
  | j + 1 =>
      let prev := steepContChain Phi s_base y_bot t j
      (prev.2, prev.2 + t * steepContSolJ Phi prev.1 prev.2 t)

noncomputable def steepContPsi (Phi : ℂ × ℂ → ℂ) (s_base : ℂ × ℂ → ℂ)
    (N : ℕ) (y t : ℂ) : ℂ :=
  (steepContChain Phi s_base (y - ((N : ℂ) + 1) * t) t N).2

def SteepContJetProp (S : FiniteWallNonisotropicStrip)
    (A : SmallFieldChordActionData S) : Prop :=
  IsOpen (steepContTripleDomain S A.η_SL) ∧
  DifferentiableOn ℂ (fun q : ℂ × ℂ × ℂ => steepContActionDJ A.Phi q.1 q.2.1 q.2.2)
    (steepContTripleDomain S A.η_SL) ∧
  DifferentiableOn ℂ (fun q : ℂ × ℂ × ℂ => steepContActionDS A.Phi q.1 q.2.1 q.2.2)
    (steepContTripleDomain S A.η_SL) ∧
  (∀ s_m J_m s_0 t J : ℂ,
    (s_m, t * J_m) ∈ smallChordDomain S A.η_SL →
    (s_0, t * J) ∈ smallChordDomain S A.η_SL →
    steepContResidual A.Phi s_m J_m s_0 t J =
      (deriv (fun J' => smallChordActionP A.Phi s_0 J' t) J -
        t * deriv (fun s' => smallChordActionP A.Phi s' J t) s_0) -
      deriv (fun J' => smallChordActionP A.Phi s_m J' t) J_m) ∧
  (∀ s_m J_m s_0 t J : ℂ,
    (s_0, t * J) ∈ smallChordDomain S A.η_SL →
    HasDerivAt (fun J' => steepContResidual A.Phi s_m J_m s_0 t J')
      ((1 / 4 : ℂ) * J + deriv (steepContPerturbG A.Phi s_0 t) J) J) ∧
  (∀ s_m s_0 J_m t : ℂ, ∀ ρ_s ρ_J M_a : ℝ,
    0 < ρ_s → 0 < ρ_J → 0 ≤ M_a → ‖J_m - 1‖ ≤ ρ_J →
    (∀ θ ∈ Set.Icc (0 : ℝ) 1,
      ∀ s' ∈ Metric.closedBall ((1 - (θ : ℂ)) * s_m + (θ : ℂ) * s_0) ρ_s,
      ∀ J' ∈ Metric.closedBall (1 : ℂ) (3 * ρ_J),
        (s', t * J') ∈ smallChordDomain S A.η_SL ∧
        ‖steepContActionA A.Phi s' J' t‖ ≤ M_a) →
    (∀ J ∈ Metric.closedBall J_m ρ_J,
      ‖deriv (steepContPerturbG A.Phi s_0 t) J‖ ≤
        4 * M_a / ρ_J ^ 2 + 2 * ‖t‖ * M_a / (ρ_s * ρ_J)) ∧
    ‖steepContActionDS A.Phi s_0 J_m t‖ ≤ M_a / ρ_s ∧
    ‖steepContActionDJ A.Phi s_0 J_m t - steepContActionDJ A.Phi s_m J_m t‖ ≤
      (M_a / (ρ_s * ρ_J)) * ‖s_0 - s_m‖)

def IsSteepContContractivePt (S : FiniteWallNonisotropicStrip)
    (A : SmallFieldChordActionData S) (ρ_J : ℝ) (s_m s_0 t : ℂ) : Prop :=
  t ≠ 0 ∧ 0 < ρ_J ∧ ρ_J ≤ 1 / 32 ∧
  let J_m := (s_0 - s_m) / t
  ‖J_m - 1‖ ≤ ρ_J ∧
  (s_m, t * J_m) ∈ smallChordDomain S A.η_SL ∧
  (∀ J ∈ Metric.closedBall J_m ρ_J,
    (s_0, t * J) ∈ smallChordDomain S A.η_SL ∧
    ‖deriv (steepContPerturbG A.Phi s_0 t) J‖ ≤ 1 / 32) ∧
  ‖steepContResidual A.Phi s_m J_m s_0 t J_m‖ ≤ ρ_J / 8

def SteepContSolverProp (S : FiniteWallNonisotropicStrip)
    (A : SmallFieldChordActionData S) : Prop :=
  (∀ ρ_J : ℝ, ∀ s_m s_0 t : ℂ,
    IsSteepContContractivePt S A ρ_J s_m s_0 t →
    let J_m := (s_0 - s_m) / t
    let J_p := steepContSolJ A.Phi s_m s_0 t
    ‖J_p - J_m‖ ≤ 8 * ‖steepContResidual A.Phi s_m J_m s_0 t J_m‖ ∧
    deriv (fun J' => smallChordActionP A.Phi s_0 J' t) J_p -
      t * deriv (fun s' => smallChordActionP A.Phi s' J_p t) s_0 =
      deriv (fun J' => smallChordActionP A.Phi s_m J' t) J_m ∧
    (∀ J' ∈ Metric.closedBall J_m ρ_J,
      deriv (fun J'' => smallChordActionP A.Phi s_0 J'' t) J' -
        t * deriv (fun s' => smallChordActionP A.Phi s' J' t) s_0 =
        deriv (fun J'' => smallChordActionP A.Phi s_m J'' t) J_m →
      J' = J_p)) ∧
  (∀ (U : Set (ℂ × ℂ)) (ρ_J : ℝ) (s_m s_0 : ℂ × ℂ → ℂ),
    IsOpen U →
    DifferentiableOn ℂ s_m U →
    DifferentiableOn ℂ s_0 U →
    (∀ p ∈ U, IsSteepContContractivePt S A ρ_J (s_m p) (s_0 p) p.2) →
    DifferentiableOn ℂ (fun p : ℂ × ℂ => steepContSolJ A.Phi (s_m p) (s_0 p) p.2) U)

def SteepContBaseBoundsProp (S : FiniteWallNonisotropicStrip)
    (A : SmallFieldChordActionData S) : Prop :=
  ∀ δ_ceil : ℝ, 0 < δ_ceil → δ_ceil < S.H / 2 →
    ∃ r_base C_base : ℝ, 0 < r_base ∧ r_base < S.r_star ∧ 0 < C_base ∧
      ∀ y t : ℂ, |y.im| ≤ S.H - δ_ceil / 4 → ‖t‖ < r_base →
        (y, t) ∈ finiteWallTube S.r_star S.h_X ∧
        (y + t, t) ∈ finiteWallTube S.r_star S.h_X ∧
        (y - t, t) ∈ finiteWallTube S.r_star S.h_X ∧
        ‖S.𝔰 (y, t) - y‖ ≤ C_base * ‖t‖ ^ 2 ∧
        (t ≠ 0 →
          let s_m := S.𝔰 (y - t, t)
          let s_0 := S.𝔰 (y, t)
          let s_p := S.𝔰 (y + t, t)
          let J_m := (s_0 - s_m) / t
          let J_p := (s_p - s_0) / t
          ‖J_m - 1‖ ≤ C_base * ‖t‖ ^ 2 ∧
          ‖J_p - 1‖ ≤ C_base * ‖t‖ ^ 2 ∧
          (s_m, s_0 - s_m) ∈ smallChordDomain S A.η_SL ∧
          (s_0, s_p - s_0) ∈ smallChordDomain S A.η_SL ∧
          deriv (fun J' => smallChordActionP A.Phi s_0 J' t) J_p -
            t * deriv (fun s' => smallChordActionP A.Phi s' J_p t) s_0 =
            deriv (fun J' => smallChordActionP A.Phi s_m J' t) J_m)

def SteepContStepAdmProp (S : FiniteWallNonisotropicStrip)
    (A : SmallFieldChordActionData S) : Prop :=
  (∀ β x_start Δ : ℝ, ∀ M : ℕ,
    1 < β → 0 < x_start → 0 < Δ →
    Δ * (∑ j ∈ Finset.range M, (x_start + (((j + 1 : ℕ) : ℝ)) * Δ) ^ (-β)) ≤
      x_start ^ (1 - β) / (β - 1)) ∧
  (∀ α m_steep γ_steep δ_ceil δ_b K : ℝ,
    1 / 2 < α → α < 1 → 0 < m_steep → 0 < γ_steep → γ_steep < 1 / 4 →
    0 < δ_ceil → δ_ceil < δ_b → δ_b < S.H / 2 → 0 < K →
    let L := 2 * (m_steep + 1 / γ_steep + 1)
    let ρ_J := 1 / (400 * (1 + 20 * K))
    ∃ Θ_adm C_res : ℝ, 0 < Θ_adm ∧ 0 < C_res ∧
      ∀ d x₀ r ε : ℝ, 0 < d → 0 < r → r ≤ K * d → 0 < ε →
        10 * K * d ^ (1 - α) + 10 * ε ≤ Θ_adm →
        (∀ s : ℂ, d / 10 ≤ wallDepth S s → wallDepth S s ≤ δ_b →
          |s.re - x₀| ≤ L * wallDepth S s →
          r * shapeModulus S s ≤ ε * (d / wallDepth S s) ^ α) →
        ∀ z_0 t s_m s_0 : ℂ,
          γ_steep * ‖t‖ < t.im →
          d / 2 < wallDepth S (z_0 + t) →
          wallDepth S (z_0 - t) < (3 / 4 : ℝ) * δ_ceil →
          |(z_0 + t).re - x₀| ≤ (m_steep + 1 / γ_steep) * wallDepth S (z_0 + t) →
          ‖t‖ < 10 * r * (wallDepth S (z_0 + t) / d) ^ α →
          ‖s_m - (z_0 - t)‖ ≤ (1 / (100 * (1 + 20 * K) ^ 2)) * wallDepth S (z_0 - t) →
          ‖s_0 - z_0‖ ≤ (1 / (100 * (1 + 20 * K) ^ 2)) * wallDepth S z_0 →
          ‖(s_0 - s_m) / t - 1‖ ≤ ρ_J →
          IsSteepContContractivePt S A ρ_J s_m s_0 t ∧
          8 * ‖steepContResidual A.Phi s_m ((s_0 - s_m) / t) s_0 t ((s_0 - s_m) / t)‖ ≤
            C_res * ‖t‖ ^ 3 * (1 + (ε / r) * d ^ α) ^ 2 * (wallDepth S z_0) ^ (-2 * α - 1))

def SteepContUpwardProp (S : FiniteWallNonisotropicStrip) : Prop :=
  ∀ α m_steep γ_steep δ_ceil δ_b : ℝ,
    1 / 2 < α → α < 1 → 0 < m_steep → 0 < γ_steep → γ_steep < 1 / 4 →
    0 < δ_ceil → δ_ceil < δ_b → δ_b < S.H / 2 →
    let L := 2 * (m_steep + 1 / γ_steep + 1)
    ∀ K : ℝ, 0 < K → ∃ C_st ε_st d_st : ℝ, 0 < C_st ∧ 0 < ε_st ∧ 0 < d_st ∧
      ∀ d x₀ r ε : ℝ, 0 < d → d < d_st → 0 < r → r ≤ K * d → 0 < ε → ε ≤ ε_st →
        (∀ s : ℂ, d / 10 ≤ wallDepth S s → wallDepth S s ≤ δ_b →
          |s.re - x₀| ≤ L * wallDepth S s →
          r * shapeModulus S s ≤ ε * (d / wallDepth S s) ^ α) →
        ∃ s_up : ℂ × ℂ → ℂ,
          DifferentiableOn ℂ s_up
            { p : ℂ × ℂ |
              d / 2 < S.H - p.1.im ∧ S.H - p.1.im < δ_ceil ∧
              |p.1.re - x₀| < m_steep * (S.H - p.1.im) ∧
              ‖p.2‖ < 10 * r * ((S.H - p.1.im) / d) ^ α ∧
              γ_steep * ‖p.2‖ < p.2.im } ∧
          (∀ p : ℂ × ℂ,
            d / 2 < S.H - p.1.im → S.H - p.1.im < δ_ceil →
            |p.1.re - x₀| < m_steep * (S.H - p.1.im) →
            ‖p.2‖ < 10 * r * ((S.H - p.1.im) / d) ^ α →
            γ_steep * ‖p.2‖ < p.2.im →
            s_up p ∈ horizStrip S.H ∧
            ‖s_up p - p.1‖ ≤
              C_st * (1 + (ε / r) * d ^ α) ^ 2 * ‖p.2‖ ^ 2 * (S.H - p.1.im) ^ (1 - 2 * α) ∧
            (p ∈ finiteWallTube S.r_star S.h_X → s_up p = S.𝔰 p))
noncomputable def glancingIterDslopeAtZero : ℕ → (ℂ → ℂ) → (ℂ → ℂ)
  | 0, g => g
  | n + 1, g => dslope (glancingIterDslopeAtZero n g) 0

structure NormalizedGlancingData {Ω : Set Plane} (B : AnalyticBoundaryData Ω) where
  s₁ : ℝ
  r_in : ℝ
  s₁_pos : 0 < s₁
  s₁_le_s₀ : s₁ ≤ B.s₀
  r_in_pos : 0 < r_in
  r_in_lt_quarter_s₁ : r_in < s₁ / 4
  U : ℂ × ℂ → ℂ
  U_holo : DifferentiableOn ℂ U { p : ℂ × ℂ | |p.1.im| < 2 * s₁ ∧ ‖p.2‖ < r_in }
  U_quasiperiodic : ∀ y t : ℂ, |y.im| < 2 * s₁ → ‖t‖ < r_in →
    U (y + 2 * Real.pi, t) = U (y, t) + 2 * Real.pi
  U_even : ∀ y t : ℂ, |y.im| < 2 * s₁ → ‖t‖ < r_in → U (y, -t) = U (y, t)
  U_zero : ∀ y : ℂ, |y.im| < 2 * s₁ → U (y, 0) = y
  U_conj : ∀ y t : ℂ, |y.im| < 2 * s₁ → ‖t‖ < r_in →
    U (starRingEnd ℂ y, starRingEnd ℂ t) = starRingEnd ℂ (U (y, t))
  U_maps_to_wide : ∀ y t : ℂ, |y.im| < (7 / 4 : ℝ) * s₁ → ‖t‖ < r_in →
    U (y, t) ∈ horizStrip (2 * B.s₀)
  U_real_deriv_pos : ∀ x t : ℝ, |t| < r_in →
    0 < deriv (fun x' : ℝ => (U (x', t)).re) x
  U_real_step_pos : ∀ x t : ℝ, 0 < t → t < r_in →
    0 < (U (x + t, t)).re - (U (x, t)).re ∧
    0 < B.ϕ ((U (x + t, t)).re) - B.ϕ ((U (x, t)).re) ∧
    B.ϕ ((U (x + t, t)).re) - B.ϕ ((U (x, t)).re) < Real.pi
  glancing_stationary_wide : ∀ y t : ℂ, |y.im| < (3 / 2 : ℝ) * s₁ → ‖t‖ < r_in →
    -supportAction1_ℂ B.h_ℂ (B.ϕ_ℂ (U (y, t))) (B.ϕ_ℂ (U (y + t, t))) =
      supportAction2_ℂ B.h_ℂ (B.ϕ_ℂ (U (y - t, t))) (B.ϕ_ℂ (U (y, t)))
noncomputable def pderivA (f : ℂ × ℂ → ℂ) (p : ℂ × ℂ) : ℂ :=
  deriv (fun z : ℂ => f (z, p.2)) p.1

noncomputable def pderivD (f : ℂ × ℂ → ℂ) (p : ℂ × ℂ) : ℂ :=
  deriv (fun z : ℂ => f (p.1, z)) p.2

noncomputable def mvDerivA (Φ : MvPowerSeries (Fin 2) ℂ) : MvPowerSeries (Fin 2) ℂ :=
  fun d => ((d 0 + 1 : ℕ) : ℂ) * MvPowerSeries.coeff (d + Finsupp.single 0 1) Φ

noncomputable def mvDerivD (Φ : MvPowerSeries (Fin 2) ℂ) : MvPowerSeries (Fin 2) ℂ :=
  fun d => ((d 1 + 1 : ℕ) : ℂ) * MvPowerSeries.coeff (d + Finsupp.single 1 1) Φ

noncomputable def holoTaylor1D (g : ℂ → ℂ) (z₀ : ℂ) : PowerSeries ℂ :=
  PowerSeries.mk (fun n => iteratedDeriv n g z₀ / (n.factorial : ℂ))

structure Holo2DAndTaylorToolkit : Prop where
  pderiv_holo : ∀ {U : Set (ℂ × ℂ)}, IsOpen U → ∀ {f : ℂ × ℂ → ℂ},
    DifferentiableOn ℂ f U →
    DifferentiableOn ℂ (pderivA f) U ∧ DifferentiableOn ℂ (pderivD f) U
  pderiv_comm : ∀ {U : Set (ℂ × ℂ)}, IsOpen U → ∀ {f : ℂ × ℂ → ℂ},
    DifferentiableOn ℂ f U →
    ∀ p ∈ U, pderivA (pderivD f) p = pderivD (pderivA f) p
  iterDerivYT_holo : ∀ {U : Set (ℂ × ℂ)}, IsOpen U → ∀ {f : ℂ × ℂ → ℂ},
    DifferentiableOn ℂ f U → ∀ α β : ℕ, DifferentiableOn ℂ (iterDerivYT α β f) U
  iterDerivYT_step : ∀ {U : Set (ℂ × ℂ)}, IsOpen U → ∀ {f : ℂ × ℂ → ℂ},
    DifferentiableOn ℂ f U → ∀ (α β : ℕ), ∀ p ∈ U,
      iterDerivYT (α + 1) β f p = iterDerivYT α β (pderivA f) p ∧
      iterDerivYT α (β + 1) f p = iterDerivYT α β (pderivD f) p ∧
      pderivA (iterDerivYT α β f) p = iterDerivYT (α + 1) β f p ∧
      pderivD (iterDerivYT α β f) p = iterDerivYT α (β + 1) f p
  taylor2D_congr : ∀ {U : Set (ℂ × ℂ)}, IsOpen U → ∀ {p₀ : ℂ × ℂ}, p₀ ∈ U →
    ∀ {f₁ f₂ : ℂ × ℂ → ℂ}, (∀ p ∈ U, f₁ p = f₂ p) → taylor2D f₁ p₀ = taylor2D f₂ p₀
  eqOn_zero_of_preconnected_2D : ∀ {W V : Set (ℂ × ℂ)},
    IsOpen W → IsPreconnected W → IsOpen V → V.Nonempty → V ⊆ W →
    ∀ {f : ℂ × ℂ → ℂ}, DifferentiableOn ℂ f W → (∀ p ∈ V, f p = 0) → ∀ p ∈ W, f p = 0
  eqOn_zero_of_taylor2D_zero : ∀ {W : Set (ℂ × ℂ)},
    IsOpen W → IsPreconnected W → ∀ {p₀ : ℂ × ℂ}, p₀ ∈ W →
    ∀ {f : ℂ × ℂ → ℂ}, DifferentiableOn ℂ f W → taylor2D f p₀ = 0 → ∀ p ∈ W, f p = 0
  taylor2D_algebra : ∀ {U : Set (ℂ × ℂ)}, IsOpen U → ∀ {p₀ : ℂ × ℂ}, p₀ ∈ U →
    (∀ c : ℂ, taylor2D (fun _ => c) p₀ = MvPowerSeries.C c) ∧
    (∀ {f g : ℂ × ℂ → ℂ}, DifferentiableOn ℂ f U → DifferentiableOn ℂ g U →
      taylor2D (fun p => f p + g p) p₀ = taylor2D f p₀ + taylor2D g p₀ ∧
      taylor2D (fun p => f p - g p) p₀ = taylor2D f p₀ - taylor2D g p₀ ∧
      taylor2D (fun p => f p * g p) p₀ = taylor2D f p₀ * taylor2D g p₀)
  mvDeriv_rules :
    (∀ Φ Ψ : MvPowerSeries (Fin 2) ℂ,
      mvDerivA (Φ + Ψ) = mvDerivA Φ + mvDerivA Ψ ∧
      mvDerivD (Φ + Ψ) = mvDerivD Φ + mvDerivD Ψ ∧
      mvDerivA (Φ * Ψ) = mvDerivA Φ * Ψ + Φ * mvDerivA Ψ ∧
      mvDerivD (Φ * Ψ) = mvDerivD Φ * Ψ + Φ * mvDerivD Ψ) ∧
    (∀ {U : Set (ℂ × ℂ)}, IsOpen U → ∀ {p₀ : ℂ × ℂ}, p₀ ∈ U →
      ∀ {f : ℂ × ℂ → ℂ}, DifferentiableOn ℂ f U →
        mvDerivA (taylor2D f p₀) = taylor2D (pderivA f) p₀ ∧
        mvDerivD (taylor2D f p₀) = taylor2D (pderivD f) p₀)
  mvDeriv_compPowerSeries2D : ∀ (f : PowerSeries ℂ) (Ψ : MvPowerSeries (Fin 2) ℂ),
    MvPowerSeries.coeff 0 Ψ = 0 →
    mvDerivA (compPowerSeries2D f Ψ) =
      mvDerivA Ψ * compPowerSeries2D (PowerSeries.derivative f) Ψ ∧
    mvDerivD (compPowerSeries2D f Ψ) =
      mvDerivD Ψ * compPowerSeries2D (PowerSeries.derivative f) Ψ
  taylor2D_comp_1D : ∀ {U : Set (ℂ × ℂ)} {W_ψ : Set ℂ},
    IsOpen U → IsOpen W_ψ → ∀ {p₀ : ℂ × ℂ}, p₀ ∈ U →
    ∀ {ψ : ℂ × ℂ → ℂ} {g : ℂ → ℂ},
      DifferentiableOn ℂ ψ U → DifferentiableOn ℂ g W_ψ → (∀ p ∈ U, ψ p ∈ W_ψ) →
      taylor2D (fun p => g (ψ p)) p₀ =
        compPowerSeries2D (holoTaylor1D g (ψ p₀)) (centeredTaylor2D ψ p₀)
  compPowerSeries2D_inj : ∀ {U : Set (ℂ × ℂ)}, IsOpen U → ∀ {p₀ : ℂ × ℂ}, p₀ ∈ U →
    ∀ {ψ : ℂ × ℂ → ℂ}, DifferentiableOn ℂ ψ U → pderivA ψ p₀ ≠ 0 →
    ∀ (f₁ f₂ : PowerSeries ℂ),
      compPowerSeries2D f₁ (centeredTaylor2D ψ p₀) =
        compPowerSeries2D f₂ (centeredTaylor2D ψ p₀) →
      f₁ = f₂

noncomputable def webDiffCoeffA (A w : ℂ × ℂ → ℂ) : ℕ → ℕ → (ℂ × ℂ → ℂ)
  | 0, 0 => w
  | 0, _ + 1 => fun _ => 0
  | α + 1, 0 => pderivA (webDiffCoeffA A w α 0)
  | α + 1, k + 1 => fun p =>
      pderivA (webDiffCoeffA A w α (k + 1)) p + webDiffCoeffA A w α k p * A p

noncomputable def webDiffCoeff (A B_ψ w : ℂ × ℂ → ℂ) (α : ℕ) : ℕ → ℕ → (ℂ × ℂ → ℂ)
  | 0, k => webDiffCoeffA A w α k
  | β + 1, 0 => pderivD (webDiffCoeff A B_ψ w α β 0)
  | β + 1, k + 1 => fun p =>
      pderivD (webDiffCoeff A B_ψ w α β (k + 1)) p + webDiffCoeff A B_ψ w α β k p * B_ψ p

noncomputable def webVandermondeMat {m : ℕ} (ψ w : Fin m → ℂ × ℂ → ℂ) (p : ℂ × ℂ) :
    Matrix (Fin m) (Fin m) ℂ :=
  Matrix.of fun r i =>
    w i p * (pderivA (ψ i) p) ^ (m - r.val) * (pderivD (ψ i) p) ^ r.val

def webODEDomain {m : ℕ} (ψ w : Fin m → ℂ × ℂ → ℂ) (U₀ U_plus : Set (ℂ × ℂ)) :
    Set (ℂ × ℂ) :=
  { p ∈ U₀ ∩ U_plus | (webVandermondeMat ψ w p).det ≠ 0 }

structure WebPDESystem {m : ℕ} (hm : 1 ≤ m)
    (ψ w : Fin m → ℂ × ℂ → ℂ) (B : ℂ × ℂ → ℂ)
    (U₀ U_plus : Set (ℂ × ℂ)) where
  M_a : ℂ × ℂ → Matrix (Fin m × Fin m) (Fin m × Fin m) ℂ
  M_δ : ℂ × ℂ → Matrix (Fin m × Fin m) (Fin m × Fin m) ℂ
  c_a : ℂ × ℂ → (Fin m × Fin m → ℂ)
  c_δ : ℂ × ℂ → (Fin m × Fin m → ℂ)
  isOpen_ode : IsOpen (webODEDomain ψ w U₀ U_plus)
  ode_sub_U₀ : webODEDomain ψ w U₀ U_plus ⊆ U₀
  ode_sub_U_plus : webODEDomain ψ w U₀ U_plus ⊆ U_plus
  mem_ode_domain : ∀ p ∈ U₀ ∩ U_plus,
    (∀ i : Fin m, w i p ≠ 0) →
    (∀ i : Fin m, pderivA (ψ i) p ≠ 0) →
    Function.Injective (fun i : Fin m => pderivD (ψ i) p / pderivA (ψ i) p) →
    p ∈ webODEDomain ψ w U₀ U_plus
  M_a_holo : ∀ idx j : Fin m × Fin m,
    DifferentiableOn ℂ (fun p => M_a p idx j) (webODEDomain ψ w U₀ U_plus)
  M_δ_holo : ∀ idx j : Fin m × Fin m,
    DifferentiableOn ℂ (fun p => M_δ p idx j) (webODEDomain ψ w U₀ U_plus)
  c_a_holo : ∀ idx : Fin m × Fin m,
    DifferentiableOn ℂ (fun p => c_a p idx) (webODEDomain ψ w U₀ U_plus)
  c_δ_holo : ∀ idx : Fin m × Fin m,
    DifferentiableOn ℂ (fun p => c_δ p idx) (webODEDomain ψ w U₀ U_plus)
  cross_rel : ∀ p ∈ webODEDomain ψ w U₀ U_plus, ∀ V : Fin m × Fin m → ℂ, ∀ i : Fin m,
    pderivD (ψ i) p * ((M_a p).mulVec V + c_a p) (i, ⟨0, hm⟩) =
      pderivA (ψ i) p * ((M_δ p).mulVec V + c_δ p) (i, ⟨0, hm⟩)
  formal_ode : ∀ p₁ ∈ webODEDomain ψ w U₀ U_plus, ∀ f : Fin m → PowerSeries ℂ,
    (∑ i : Fin m,
      taylor2D (w i) p₁ * compPowerSeries2D (f i) (centeredTaylor2D (ψ i) p₁) =
      taylor2D B p₁) →
    ∃ V_formal : Fin m × Fin m → MvPowerSeries (Fin 2) ℂ,
      (∀ i : Fin m,
        V_formal (i, ⟨0, hm⟩) = compPowerSeries2D (f i) (centeredTaylor2D (ψ i) p₁)) ∧
      (∀ idx : Fin m × Fin m,
        mvDerivA (V_formal idx) =
          ∑ j : Fin m × Fin m, taylor2D (fun p => M_a p idx j) p₁ * V_formal j +
            taylor2D (fun p => c_a p idx) p₁ ∧
        mvDerivD (V_formal idx) =
          ∑ j : Fin m × Fin m, taylor2D (fun p => M_δ p idx j) p₁ * V_formal j +
            taylor2D (fun p => c_δ p idx) p₁)
noncomputable def collarBaseS {Ω : Set Plane} {C : AnalyticGlancingCollar Ω}
    (hDet : EndpointDeterminationData C) : ℝ :=
  hDet.s_det

noncomputable def collarBaseR {Ω : Set Plane} {C : AnalyticGlancingCollar Ω}
    (hDet : EndpointDeterminationData C) : ℝ :=
  min hDet.r_det (Real.pi / 2)

def IsCollarHeightWitness (s_base r_base : ℝ) (F_init : Fin 2 → ℂ × ℂ → ℂ)
    (t : ℂ) (b : ℝ) : Prop :=
  s_base < b ∧
  ∃ δ : ℝ, 0 < δ ∧ Metric.ball t δ ⊆ Metric.ball (0 : ℂ) r_base ∧
    ∃ G : Fin 2 → MeroOn2D ({ y : ℂ | -s_base < y.im ∧ y.im < b } ×ˢ Metric.ball t δ),
      ∀ i : Fin 2, MeroAgreesHolo (G i) (F_init i)
        ({ y : ℂ | |y.im| < s_base } ×ˢ Metric.ball t δ)

noncomputable def meroStripWidth (s_base r_base : ℝ) (F_init : Fin 2 → ℂ × ℂ → ℂ)
    (t : ℂ) : ENNReal :=
  sSup { x : ENNReal | ∃ b : ℝ, IsCollarHeightWitness s_base r_base F_init t b ∧
    x = ENNReal.ofReal b }

noncomputable def collarWidthX {Ω : Set Plane} (C : AnalyticGlancingCollar Ω)
    (hDet : EndpointDeterminationData C) : ℂ → ENNReal :=
  meroStripWidth (collarBaseS hDet) (collarBaseR hDet)
    (fun i p => glancingImpact C p.1 p.2 i)

noncomputable def collarWidthL {Ω : Set Plane} (C : AnalyticGlancingCollar Ω)
    (hDet : EndpointDeterminationData C) : ℂ → ENNReal :=
  meroStripWidth (collarBaseS hDet) (collarBaseR hDet)
    (fun i p => glancingDualLine C p.1 p.2 i)

def HolomorphicDiskSupermeanProp (r_base : ℝ) (h_F : ℂ → ENNReal) : Prop :=
  ∀ (R_Φ : ℝ) (Φ : ℂ → ℂ),
    1 < R_Φ →
    DifferentiableOn ℂ Φ (Metric.ball (0 : ℂ) R_Φ) →
    (∀ ζ ∈ Metric.ball (0 : ℂ) R_Φ, Φ ζ ∈ Metric.ball (0 : ℂ) r_base) →
    deriv Φ 0 ≠ 0 →
    ∀ q : ℝ → ℝ, Continuous q → Function.Periodic q (2 * Real.pi) →
      (∀ θ : ℝ, 0 ≤ q θ ∧
        ENNReal.ofReal (q θ) < h_F (Φ (Complex.exp ((θ : ℂ) * Complex.I)))) →
      ENNReal.ofReal ((2 * Real.pi)⁻¹ * ∫ θ in (0 : ℝ)..(2 * Real.pi), q θ) ≤ h_F (Φ 0)
def lineChainBox {Ω : Set Plane} (C : AnalyticGlancingCollar Ω)
    (B : BaseCollarAndCramerData C) (k : ℕ) : Set (ℂ × ℂ) :=
  { p : ℂ × ℂ | |p.1.im| < B.s_det ∧ ‖p.2‖ < B.r_det / (k : ℝ) }

abbrev LineJetAll : Type := Fin 2 × Fin 2 × ℕ × ℕ

def lineJetEmb (M : ℕ) (w : LineJetVar M) : LineJetAll :=
  (w.1, w.2.1, w.2.2.1.1, w.2.2.2.1)

noncomputable def lineJetFnAll {Ω : Set Plane} (C : AnalyticGlancingCollar Ω) (k : ℕ)
    (v : LineJetAll) (p : ℂ × ℂ) : ℂ :=
  if v.1 = 0 then
    iterDerivYT v.2.2.1 v.2.2.2 (fun q => glancingDualLine C q.1 q.2 v.2.1) p
  else
    iterDerivYT v.2.2.1 v.2.2.2 (fun q => glancingDualLine C (q.1 + (k : ℂ) * q.2) q.2 v.2.1) p

noncomputable def linePointField {Ω : Set Plane} (C : AnalyticGlancingCollar Ω) (k : ℕ)
    (Ψ : ℂ × ℂ → ℂ × ℂ) (a₁ δ₁ : ℝ) : Subfield ℂ :=
  Subfield.closure
    (((⊥ : Subfield ℂ) : Set ℂ) ∪
      Set.range (fun v : LineJetAll => lineJetFnAll C k v (Ψ ((a₁ : ℂ), (δ₁ : ℂ)))))

noncomputable def lineChainMid {k : ℕ} (α : Fin (k + 1) → ℂ) (i : Fin k) : ℂ :=
  (α i.castSucc + α i.succ) / 2

noncomputable def lineChainHalfStep {k : ℕ} (α : Fin (k + 1) → ℂ) (i : Fin k) : ℂ :=
  (α i.succ - α i.castSucc) / 2

noncomputable def lineChainAction {k : ℕ} (h_vec : Fin k → ℂ → ℂ)
    (α : Fin (k + 1) → ℂ) : ℂ :=
  ∑ i : Fin k, 2 * h_vec i (lineChainMid α i) * Complex.sin (lineChainHalfStep α i)

noncomputable def lineInteriorGrad {k : ℕ} (h_vec h'_vec : Fin k → ℂ → ℂ)
    (α : Fin (k + 1) → ℂ) (r : Fin (k - 1)) : ℂ :=
  let i_L : Fin k := ⟨r.1, by have := r.2; omega⟩
  let i_R : Fin k := ⟨r.1 + 1, by have := r.2; omega⟩
  h'_vec i_L (lineChainMid α i_L) * Complex.sin (lineChainHalfStep α i_L) +
    h_vec i_L (lineChainMid α i_L) * Complex.cos (lineChainHalfStep α i_L) +
    h'_vec i_R (lineChainMid α i_R) * Complex.sin (lineChainHalfStep α i_R) -
    h_vec i_R (lineChainMid α i_R) * Complex.cos (lineChainHalfStep α i_R)

noncomputable def lineInteriorHess {k : ℕ} (h_vec h'_vec h''_vec : Fin k → ℂ → ℂ)
    (α : Fin (k + 1) → ℂ) : Matrix (Fin (k - 1)) (Fin (k - 1)) ℂ :=
  fun r s =>
    let i_L : Fin k := ⟨r.1, by have := r.2; omega⟩
    let i_R : Fin k := ⟨r.1 + 1, by have := r.2; omega⟩
    let ψ_L := lineChainMid α i_L
    let d_L := lineChainHalfStep α i_L
    let ψ_R := lineChainMid α i_R
    let d_R := lineChainHalfStep α i_R
    if r.1 = s.1 then
      ((h''_vec i_L ψ_L - h_vec i_L ψ_L) / 2 * Complex.sin d_L +
        h'_vec i_L ψ_L * Complex.cos d_L) +
      ((h''_vec i_R ψ_R - h_vec i_R ψ_R) / 2 * Complex.sin d_R -
        h'_vec i_R ψ_R * Complex.cos d_R)
    else if s.1 = r.1 + 1 then
      (h_vec i_R ψ_R + h''_vec i_R ψ_R) / 2 * Complex.sin d_R
    else if r.1 = s.1 + 1 then
      (h_vec i_L ψ_L + h''_vec i_L ψ_L) / 2 * Complex.sin d_L
    else
      0

noncomputable def lineChartAlpha {Ω : Set Plane} (C : AnalyticGlancingCollar Ω) (k : ℕ)
    (Ψ : ℂ × ℂ → ℂ × ℂ) (r : Fin (k + 1)) (q : ℂ × ℂ) : ℂ :=
  glancingTheta C ((Ψ q).1 + ((r : ℕ) : ℂ) * (Ψ q).2) (Ψ q).2

noncomputable def lineChartPsi {Ω : Set Plane} (C : AnalyticGlancingCollar Ω) (k : ℕ)
    (Ψ : ℂ × ℂ → ℂ × ℂ) (i : Fin k) (q : ℂ × ℂ) : ℂ :=
  lineChainMid (fun r => lineChartAlpha C k Ψ r q) i

noncomputable def lineChartHalfStep {Ω : Set Plane} (C : AnalyticGlancingCollar Ω) (k : ℕ)
    (Ψ : ℂ × ℂ → ℂ × ℂ) (i : Fin k) (q : ℂ × ℂ) : ℂ :=
  lineChainHalfStep (fun r => lineChartAlpha C k Ψ r q) i

noncomputable def lineChartWeight {Ω : Set Plane} (C : AnalyticGlancingCollar Ω) (k : ℕ)
    (Ψ : ℂ × ℂ → ℂ × ℂ) (i : Fin k) (q : ℂ × ℂ) : ℂ :=
  2 * Complex.sin (lineChartHalfStep C k Ψ i q)

noncomputable def lineChartAction {Ω : Set Plane} (C : AnalyticGlancingCollar Ω) (k : ℕ)
    (Ψ : ℂ × ℂ → ℂ × ℂ) (q : ℂ × ℂ) : ℂ :=
  lineChainAction (fun _ => C.h_ℂ) (fun r => lineChartAlpha C k Ψ r q)

structure LineGlancingChartData {Ω : Set Plane} (C : AnalyticGlancingCollar Ω)
    (B : BaseCollarAndCramerData C) (k : ℕ) where
  a₀ : ℝ
  R : ℝ
  δ_star : ℝ
  C₀ : ℝ
  a₀_eq : a₀ = C.ϕ 0
  R_pos : 0 < R
  δ_star_pos : 0 < δ_star
  C₀_pos : 0 < C₀
  C₀_δ_star_lt : C₀ * δ_star < R / 2
  V_W : Set (ℂ × ℂ)
  Ψ : ℂ × ℂ → ℂ × ℂ
  V_W_open : IsOpen V_W
  V_W_nonempty : V_W.Nonempty
  V_W_sub : V_W ⊆ lineChainBox C B k
  Ψ_holo : DifferentiableOn ℂ Ψ (Metric.ball (a₀ : ℂ) (2 * R) ×ˢ Metric.ball (0 : ℂ) (2 * δ_star))
  Ψ_maps_V_W : ∀ q ∈ Metric.ball (a₀ : ℂ) (2 * R) ×ˢ Metric.ball (0 : ℂ) (2 * δ_star),
    Ψ q ∈ V_W
  Φ_left_inv : ∀ q ∈ Metric.ball (a₀ : ℂ) (2 * R) ×ˢ Metric.ball (0 : ℂ) (2 * δ_star),
    glancingTheta C (Ψ q).1 (Ψ q).2 = q.1 ∧
    glancingTheta C ((Ψ q).1 + (k : ℂ) * (Ψ q).2) (Ψ q).2 -
      glancingTheta C (Ψ q).1 (Ψ q).2 = q.2
  Φ_right_inv : ∀ p ∈ V_W,
    (glancingTheta C p.1 p.2,
      glancingTheta C (p.1 + (k : ℂ) * p.2) p.2 - glancingTheta C p.1 p.2) ∈
      Metric.ball (a₀ : ℂ) (2 * R) ×ˢ Metric.ball (0 : ℂ) (2 * δ_star) ∧
    Ψ (glancingTheta C p.1 p.2,
      glancingTheta C (p.1 + (k : ℂ) * p.2) p.2 - glancingTheta C p.1 p.2) = p
  α_endpoints : ∀ q ∈ Metric.ball (a₀ : ℂ) (2 * R) ×ˢ Metric.ball (0 : ℂ) (2 * δ_star),
    lineChartAlpha C k Ψ 0 q = q.1 ∧
    lineChartAlpha C k Ψ (Fin.last k) q = q.1 + q.2
  α_holo : ∀ r : Fin (k + 1),
    DifferentiableOn ℂ (lineChartAlpha C k Ψ r)
      (Metric.ball (a₀ : ℂ) (2 * R) ×ˢ Metric.ball (0 : ℂ) (2 * δ_star))
  ψ_maps_strip : ∀ i : Fin k,
    ∀ q ∈ Metric.ball (a₀ : ℂ) (2 * R) ×ˢ Metric.ball (0 : ℂ) (2 * δ_star),
      lineChartPsi C k Ψ i q ∈ horizStrip (2 * C.s_h)
  stationary_on_chart : ∀ q ∈ Metric.ball (a₀ : ℂ) (2 * R) ×ˢ Metric.ball (0 : ℂ) (2 * δ_star),
    ∀ r : Fin (k - 1),
      lineInteriorGrad (fun _ => C.h_ℂ) (fun _ => deriv C.h_ℂ)
        (fun s => lineChartAlpha C k Ψ s q) r = 0
  action_deriv_a : ∀ q ∈ Metric.ball (a₀ : ℂ) (2 * R) ×ˢ Metric.ball (0 : ℂ) (2 * δ_star),
    iterDerivYT 1 0 (lineChartAction C k Ψ) q =
      glancingOffset C ((Ψ q).1 + (k : ℂ) * (Ψ q).2) (Ψ q).2 -
        glancingOffset C (Ψ q).1 (Ψ q).2
  action_deriv_d : ∀ q ∈ Metric.ball (a₀ : ℂ) (2 * R) ×ˢ Metric.ball (0 : ℂ) (2 * δ_star),
    iterDerivYT 0 1 (lineChartAction C k Ψ) q =
      glancingOffset C ((Ψ q).1 + (k : ℂ) * (Ψ q).2) (Ψ q).2
  α_at_zero : ∀ r : Fin (k + 1), ∀ a : ℝ, |a - a₀| < R →
    lineChartAlpha C k Ψ r ((a : ℂ), 0) = (a : ℂ) ∧
    deriv (fun z : ℂ => lineChartAlpha C k Ψ r ((a : ℂ), z)) 0 = ((r : ℕ) : ℂ) / (k : ℂ)
  ψ_web_base : ∀ i : Fin k, ∀ q ∈ webBaseClosure a₀ R δ_star,
    (lineChartPsi C k Ψ i ((q.1 : ℂ), (q.2 : ℂ))).im = 0 ∧
    |(lineChartPsi C k Ψ i ((q.1 : ℂ), (q.2 : ℂ))).re - q.1| ≤ C₀ * q.2 ∧
    1 / 2 ≤ (deriv (fun z : ℂ => lineChartPsi C k Ψ i (z, (q.2 : ℂ))) (q.1 : ℂ)).re
  trapezoid_nondeg : ∀ q ∈ webTrapezoid a₀ R δ_star C₀,
    (∀ i : Fin k, lineChartWeight C k Ψ i ((q.1 : ℂ), (q.2 : ℂ)) ≠ 0) ∧
    Function.Injective (fun i : Fin k =>
      deriv (fun z : ℂ => lineChartPsi C k Ψ i ((q.1 : ℂ), z)) (q.2 : ℂ) /
        deriv (fun z : ℂ => lineChartPsi C k Ψ i (z, (q.2 : ℂ))) (q.1 : ℂ)) ∧
    (lineInteriorHess (fun _ => C.h_ℂ) (fun _ => deriv C.h_ℂ)
      (fun _ => deriv (deriv C.h_ℂ))
      (fun s => lineChartAlpha C k Ψ s ((q.1 : ℂ), (q.2 : ℂ)))).det ≠ 0

abbrev LineGlancingChartData.U_a {Ω : Set Plane} {C : AnalyticGlancingCollar Ω}
    {B : BaseCollarAndCramerData C} {k : ℕ} (G : LineGlancingChartData C B k) : Set ℂ :=
  Metric.ball (G.a₀ : ℂ) (2 * G.R)

abbrev LineGlancingChartData.U_d {Ω : Set Plane} {C : AnalyticGlancingCollar Ω}
    {B : BaseCollarAndCramerData C} {k : ℕ} (G : LineGlancingChartData C B k) : Set ℂ :=
  Metric.ball (0 : ℂ) (2 * G.δ_star)

noncomputable abbrev LineGlancingChartData.α_fn {Ω : Set Plane} {C : AnalyticGlancingCollar Ω}
    {B : BaseCollarAndCramerData C} {k : ℕ} (G : LineGlancingChartData C B k)
    (r : Fin (k + 1)) (q : ℂ × ℂ) : ℂ :=
  lineChartAlpha C k G.Ψ r q

noncomputable abbrev LineGlancingChartData.ψ_fn {Ω : Set Plane} {C : AnalyticGlancingCollar Ω}
    {B : BaseCollarAndCramerData C} {k : ℕ} (G : LineGlancingChartData C B k)
    (i : Fin k) (q : ℂ × ℂ) : ℂ :=
  lineChartPsi C k G.Ψ i q

noncomputable abbrev LineGlancingChartData.d_fn {Ω : Set Plane} {C : AnalyticGlancingCollar Ω}
    {B : BaseCollarAndCramerData C} {k : ℕ} (G : LineGlancingChartData C B k)
    (i : Fin k) (q : ℂ × ℂ) : ℂ :=
  lineChartHalfStep C k G.Ψ i q

noncomputable abbrev LineGlancingChartData.w_fn {Ω : Set Plane} {C : AnalyticGlancingCollar Ω}
    {B : BaseCollarAndCramerData C} {k : ℕ} (G : LineGlancingChartData C B k)
    (i : Fin k) (q : ℂ × ℂ) : ℂ :=
  lineChartWeight C k G.Ψ i q

noncomputable abbrev LineGlancingChartData.A_line {Ω : Set Plane} {C : AnalyticGlancingCollar Ω}
    {B : BaseCollarAndCramerData C} {k : ℕ} (G : LineGlancingChartData C B k)
    (q : ℂ × ℂ) : ℂ :=
  lineChartAction C k G.Ψ q

structure LineCoreEliminationData {Ω : Set Plane} (C : AnalyticGlancingCollar Ω)
    (B : BaseCollarAndCramerData C) (k : ℕ) (G : LineGlancingChartData C B k)
    (a₁ δ₁ : ℝ) where
  K_end : Subfield ℂ
  N_core : ℕ
  coreTuple : Fin N_core → ℂ
  K_end_alg_over_pt : ∀ z : ℂ,
    IsAlgebraic (↥K_end) z → IsAlgebraic (↥(linePointField C k G.Ψ a₁ δ₁)) z
  cos_half_zero_mem : Complex.cos ((a₁ : ℂ) / 2) ∈ K_end
  sin_half_zero_mem : Complex.sin ((a₁ : ℂ) / 2) ∈ K_end
  cos_half_last_mem : Complex.cos (((a₁ : ℂ) + (δ₁ : ℂ)) / 2) ∈ K_end
  sin_half_last_mem : Complex.sin (((a₁ : ℂ) + (δ₁ : ℂ)) / 2) ∈ K_end
  action_pos_taylor_mem : ∀ d : Fin 2 →₀ ℕ, d ≠ 0 →
    MvPowerSeries.coeff d (taylor2D G.A_line ((a₁ : ℂ), (δ₁ : ℂ))) ∈ K_end
  action_val_mem :
    G.A_line ((a₁ : ℂ), (δ₁ : ℂ)) ∈
      Subfield.closure ((K_end : Set ℂ) ∪ Set.range coreTuple)
  half_angles_mem : ∀ r : Fin (k + 1),
    Complex.cos (G.α_fn r ((a₁ : ℂ), (δ₁ : ℂ)) / 2) ∈
      Subfield.closure ((K_end : Set ℂ) ∪ Set.range coreTuple) ∧
    Complex.sin (G.α_fn r ((a₁ : ℂ), (δ₁ : ℂ)) / 2) ∈
      Subfield.closure ((K_end : Set ℂ) ∪ Set.range coreTuple)
  support_jets_mem : ∀ (i : Fin k) (m : ℕ),
    iteratedDeriv m C.h_ℂ (G.ψ_fn i ((a₁ : ℂ), (δ₁ : ℂ))) ∈
      Subfield.closure ((K_end : Set ℂ) ∪ Set.range coreTuple)
  angle_taylor_mem : ∀ (r : Fin (k + 1)) (d : Fin 2 →₀ ℕ),
    MvPowerSeries.coeff d (centeredTaylor2D (G.α_fn r) ((a₁ : ℂ), (δ₁ : ℂ))) ∈
      Subfield.closure ((K_end : Set ℂ) ∪ Set.range coreTuple)
  core_entries_subset :
    Set.range coreTuple ⊆
      { z : ℂ |
        (∃ r : Fin (k + 1),
          z = Complex.cos (G.α_fn r ((a₁ : ℂ), (δ₁ : ℂ)) / 2) ∨
          z = Complex.sin (G.α_fn r ((a₁ : ℂ), (δ₁ : ℂ)) / 2)) ∨
        (∃ (i : Fin k) (m : ℕ),
          z = iteratedDeriv m C.h_ℂ (G.ψ_fn i ((a₁ : ℂ), (δ₁ : ℂ)))) }
  dualLine_mem_F_val : ∀ j : ℕ, 0 < j → j < k → ∀ ι : Fin 2,
    glancingDualLine C
      ((G.Ψ ((a₁ : ℂ), (δ₁ : ℂ))).1 + (j : ℂ) * (G.Ψ ((a₁ : ℂ), (δ₁ : ℂ))).2)
      (G.Ψ ((a₁ : ℂ), (δ₁ : ℂ))).2 ι ∈
      Subfield.closure ((K_end : Set ℂ) ∪ Set.range coreTuple)

noncomputable abbrev LineCoreEliminationData.F_val {Ω : Set Plane}
    {C : AnalyticGlancingCollar Ω} {B : BaseCollarAndCramerData C} {k : ℕ}
    {G : LineGlancingChartData C B k} {a₁ δ₁ : ℝ}
    (E : LineCoreEliminationData C B k G a₁ δ₁) : Subfield ℂ :=
  Subfield.closure ((E.K_end : Set ℂ) ∪ Set.range E.coreTuple)

structure LineTruncatedCoalescingModel (k p J : ℕ) (a : ℝ) (h_ℂ : ℂ → ℂ)
    (f_p : Fin k → ℂ) where
  W_n : Set ℂ
  W_n_open : IsOpen W_n
  a_mem : (a : ℂ) ∈ W_n
  h_holo : DifferentiableOn ℂ h_ℂ W_n
  g : Fin k → Fin (J + 1) → ℂ → ℂ
  g_holo : ∀ (i : Fin k) (l : Fin (J + 1)), DifferentiableOn ℂ (g i l) W_n
  g_lt_p : ∀ (i : Fin k) (l : Fin (J + 1)), (l : ℕ) < p → ∀ z ∈ W_n, g i l z = 0
  g_at_p : ∀ (i : Fin k) (hpJ : p < J + 1), g i ⟨p, hpJ⟩ (a : ℂ) = f_p i
  K : Fin (J + 1) → ℂ
  δ₀ : ℝ
  δ₀_pos : 0 < δ₀
  α₀ : ℝ → Fin (k + 1) → ℂ
  β : Fin (J + 1) → ℝ → Fin (k + 1) → ℂ
  β_zero : ∀ (δ : ℝ) (r : Fin (k + 1)), β 0 δ r = 0
  α₀_endpoints : ∀ δ ∈ Set.Ioo (0 : ℝ) δ₀,
    α₀ δ 0 = (a : ℂ) ∧ α₀ δ (Fin.last k) = (a : ℂ) + (δ : ℂ)
  β_endpoints : ∀ (l : Fin (J + 1)) (δ : ℝ),
    β l δ 0 = 0 ∧ β l δ (Fin.last k) = 0
  α₀_tendsto : ∀ r : Fin (k + 1),
    Filter.Tendsto (fun δ : ℝ => (α₀ δ r - (a : ℂ)) / (δ : ℂ))
      (nhdsWithin (0 : ℝ) (Set.Ioi 0)) (nhds (((r : ℕ) : ℂ) / (k : ℂ)))
  α₀_maps_W_n : ∀ δ ∈ Set.Ioo (0 : ℝ) δ₀, ∀ i : Fin k, lineChainMid (α₀ δ) i ∈ W_n
  α₀_stat : ∀ δ ∈ Set.Ioo (0 : ℝ) δ₀, ∀ r : Fin (k - 1),
    lineInteriorGrad (fun _ => h_ℂ) (fun _ => deriv h_ℂ) (α₀ δ) r = 0
  grad_jet_zero : ∀ δ ∈ Set.Ioo (0 : ℝ) δ₀, ∀ r : Fin (k - 1), ∀ l : ℕ, 1 ≤ l → l ≤ J →
    iteratedDeriv l
      (fun ε : ℂ =>
        lineInteriorGrad
          (fun i z => h_ℂ z + ∑ m : Fin (J + 1), ε ^ (m : ℕ) * g i m z)
          (fun i z => deriv h_ℂ z + ∑ m : Fin (J + 1), ε ^ (m : ℕ) * deriv (g i m) z)
          (fun s => α₀ δ s + ∑ m : Fin (J + 1), ε ^ (m : ℕ) * β m δ s)
          r)
      0 = 0
  action_jet_const : ∀ δ ∈ Set.Ioo (0 : ℝ) δ₀, ∀ (l : Fin (J + 1)), 1 ≤ (l : ℕ) →
    iteratedDeriv (l : ℕ)
      (fun ε : ℂ =>
        lineChainAction
          (fun i z => h_ℂ z + ∑ m : Fin (J + 1), ε ^ (m : ℕ) * g i m z)
          (fun s => α₀ δ s + ∑ m : Fin (J + 1), ε ^ (m : ℕ) * β m δ s))
      0 / ((l : ℕ).factorial : ℂ) = K l

structure LineContinuedDeformationData {Ω : Set Plane} (C : AnalyticGlancingCollar Ω)
    (B : BaseCollarAndCramerData C) (k : ℕ) (G : LineGlancingChartData C B k)
    (a₁ δ₁ : ℝ) where
  p : ℕ
  p_pos : 1 ≤ p
  f_lead : Fin k → PowerSeries ℂ
  i₀ : Fin k
  f_lead_i₀_ne_zero : f_lead i₀ ≠ 0
  W_lead : Set ℂ
  W_lead_open : IsOpen W_lead
  W_lead_preconn : IsPreconnected W_lead
  real_mem_W_lead : ∀ x : ℝ, |x - G.a₀| < G.R → (x : ℂ) ∈ W_lead
  g_lead : Fin k → ℂ → ℂ
  g_lead_holo : ∀ i : Fin k, DifferentiableOn ℂ (g_lead i) W_lead
  g_lead_taylor : ∀ i : Fin k,
    G.ψ_fn i ((a₁ : ℂ), (δ₁ : ℂ)) ∈ W_lead ∧
    ∀ n : ℕ,
      iteratedDeriv n (g_lead i) (G.ψ_fn i ((a₁ : ℂ), (δ₁ : ℂ))) / (n.factorial : ℂ) =
        PowerSeries.coeff n (f_lead i)
  trunc_models : ∀ J : ℕ, p ≤ J → ∀ a ∈ Set.Ioo (G.a₀ - G.R) (G.a₀ + G.R),
    Nonempty (LineTruncatedCoalescingModel k p J a C.h_ℂ (fun i => g_lead i (a : ℂ)))
noncomputable def normDiffQuot (F : ℂ → ℂ) (s h : ℂ) : ℂ :=
  dslope F s (s + h) / deriv F s

noncomputable def diffQuotCoeff (F : ℂ → ℂ) (k : ℕ) (s : ℂ) : ℂ :=
  iteratedDeriv (k + 1) F s / (((k + 1).factorial : ℂ) * deriv F s)

noncomputable def reflDiffCoeff {n : ℕ} (G : LocalPositiveCenterGerm n)
    (k₁ k₂ : ℕ) (s : ℂ) : ℂ :=
  (-1 : ℂ) ^ k₁ *
    (diffQuotCoeff G.Z_loc k₁ s * diffQuotCoeff G.Z_loc k₂ s -
     diffQuotCoeff G.W_loc k₁ s * diffQuotCoeff G.W_loc k₂ s)

structure ZeroSliceCenterData {n : ℕ} (G : LocalPositiveCenterGerm n) where
  ne_three : n ≠ 3
  Z₀ : ℂ
  W₀ : ℂ
  u_Z : ℂ → ℂ
  u_W : ℂ → ℂ
  f_tilde : ℂ → ℂ
  δ₁ : ℝ
  δ₁_pos : 0 < δ₁
  δ₁_le : δ₁ ≤ G.δ₀
  u_Z_ball : ∀ z : ℂ, ‖z‖ < δ₁ → AnalyticAt ℂ u_Z z ∧ u_Z z ≠ 0
  u_W_ball : ∀ z : ℂ, ‖z‖ < δ₁ → AnalyticAt ℂ u_W z ∧ u_W z ≠ 0
  f_tilde_ball : ∀ z : ℂ, ‖z‖ < δ₁ → AnalyticAt ℂ f_tilde z ∧ f_tilde z ≠ 0
  f_tilde_zero : f_tilde 0 = -Complex.I * (n : ℂ)
  f_expansion : ∀ z : ℂ, 0 < ‖z‖ → ‖z‖ < δ₁ → G.f_loc z = z⁻¹ * f_tilde z
  Z_expansion : ∀ z : ℂ, 0 < ‖z‖ → ‖z‖ < δ₁ → G.Z_loc z - Z₀ = z ^ (n + 3) * u_Z z
  W_expansion : ∀ z : ℂ, 0 < ‖z‖ → ‖z‖ < δ₁ →
    G.W_loc z - W₀ = z ^ ((3 : ℤ) - (n : ℤ)) * u_W z
  deriv_Z_ne_zero : ∀ z : ℂ, 0 < ‖z‖ → ‖z‖ < δ₁ → deriv G.Z_loc z ≠ 0
  deriv_W_ne_zero : ∀ z : ℂ, 0 < ‖z‖ → ‖z‖ < δ₁ → deriv G.W_loc z ≠ 0
  refl_coeff_analytic : ∀ k₁ k₂ : ℕ, ∀ z : ℂ, 0 < ‖z‖ → ‖z‖ < δ₁ →
    AnalyticAt ℂ (reflDiffCoeff G k₁ k₂) z
  refl_coeff_mero_order : ∀ k₁ k₂ m : ℕ,
    MeromorphicAt (iteratedDeriv m (reflDiffCoeff G k₁ k₂)) 0 ∧
    ((-(k₁ : ℤ) - (k₂ : ℤ) - (m : ℤ) : ℤ) : WithTop ℤ) ≤
      meromorphicOrderAt (iteratedDeriv m (reflDiffCoeff G k₁ k₂)) 0
  refl_deg0 : ∀ z : ℂ, 0 < ‖z‖ → ‖z‖ < δ₁ → reflDiffCoeff G 0 0 z = 0
  refl_deg1 : ∀ z h_minus h_plus : ℂ, 0 < ‖z‖ → ‖z‖ < δ₁ →
    reflDiffCoeff G 1 0 z * h_minus + reflDiffCoeff G 0 1 z * h_plus =
      Complex.I * G.f_loc z * (h_plus - h_minus)
  refl_deg2 : ∀ z h_minus h_plus : ℂ, 0 < ‖z‖ → ‖z‖ < δ₁ →
    reflDiffCoeff G 2 0 z * h_minus ^ 2 +
      reflDiffCoeff G 1 1 z * h_minus * h_plus +
      reflDiffCoeff G 0 2 z * h_plus ^ 2 =
      -Complex.I * deriv G.f_loc z * (h_plus - h_minus) ^ 2
  refl_deg3 : ∀ z h_minus h_plus : ℂ, 0 < ‖z‖ → ‖z‖ < δ₁ →
    reflDiffCoeff G 3 0 z * h_minus ^ 3 +
      reflDiffCoeff G 2 1 z * h_minus ^ 2 * h_plus +
      reflDiffCoeff G 1 2 z * h_minus * h_plus ^ 2 +
      reflDiffCoeff G 0 3 z * h_plus ^ 3 =
      (h_plus - h_minus) *
        (reflDiffCoeff G 0 3 z * (h_plus ^ 2 + h_plus * h_minus + h_minus ^ 2) +
          reflDiffCoeff G 1 2 z * h_minus * h_plus)

structure PuncturedLiftData {n : ℕ} (G : LocalPositiveCenterGerm n)
    (S : ZeroSliceCenterData G) where
  v_jet : ℕ → ℂ → ℂ
  v_jet_zero : ∀ z : ℂ, v_jet 0 z = 0
  v_jet_analytic : ∀ j : ℕ, ∀ z : ℂ, 0 < ‖z‖ → ‖z‖ < S.δ₁ → AnalyticAt ℂ (v_jet j) z
  v_jet_mero : ∀ j : ℕ, MeromorphicAt (v_jet j) 0
  local_lift : ∀ z₀ : ℂ, 0 < ‖z₀‖ → ‖z₀‖ < S.δ₁ →
    ∃ (r : ℝ) (v : ℂ × ℂ → ℂ),
      0 < r ∧
      (∀ z : ℂ, ‖z - z₀‖ < 2 * r → 0 < ‖z‖ ∧ ‖z‖ < S.δ₁) ∧
      2 * r < G.δ₀ ∧
      DifferentiableOn ℂ v (Metric.ball z₀ (2 * r) ×ˢ Metric.ball (0 : ℂ) (2 * r)) ∧
      (∀ z t : ℂ, ‖z - z₀‖ < 2 * r → ‖t‖ < 2 * r →
        0 < ‖v (z, t)‖ ∧ ‖v (z, t)‖ < S.δ₁ ∧
        G.D_ZW (z, t) ≠ 0 ∧
        v (z, -t) = v (z, t) ∧
        G.N_Z (z, t) / G.D_ZW (z, t) = G.Z_loc (v (z, t)) ∧
        G.N_W (z, t) / G.D_ZW (z, t) = G.W_loc (v (z, t))) ∧
      (∀ z : ℂ, ‖z - z₀‖ < 2 * r → v (z, 0) = z) ∧
      (∀ z : ℂ, ‖z - z₀‖ < 2 * r → ∀ k : ℕ,
        iteratedDeriv k (fun t => v (z, t) - z) 0 / (k.factorial : ℂ) =
          if Even k then v_jet (k / 2) z else 0) ∧
      (∀ z t : ℂ, ‖z - z₀‖ < r → ‖t‖ < r →
        normDiffQuot G.Z_loc (v (z, t)) (-(v (z, t) - v (z - t, t))) *
          normDiffQuot G.Z_loc (v (z, t)) (v (z + t, t) - v (z, t)) -
        normDiffQuot G.W_loc (v (z, t)) (-(v (z, t) - v (z - t, t))) *
          normDiffQuot G.W_loc (v (z, t)) (v (z + t, t) - v (z, t)) = 0)

structure PoleBoundedLiftData {n : ℕ} {G : LocalPositiveCenterGerm n}
    (S : ZeroSliceCenterData G) (L : PuncturedLiftData G S) where
  w_jet : ℕ → ℂ → ℂ
  w_jet_zero : ∀ z : ℂ, w_jet 0 z = 0
  w_jet_analytic : ∀ j : ℕ, AnalyticAt ℂ (w_jet j) 0
  v_jet_eq : ∀ j : ℕ, 1 ≤ j →
    ∀ᶠ z in nhdsWithin (0 : ℂ) {(0 : ℂ)}ᶜ,
      L.v_jet j z = z ^ ((1 : ℤ) - 2 * (j : ℤ)) * w_jet j z
def HasRealWallPatch {Ω : Set Plane} {C : AnalyticGlancingCollar Ω}
    {hDet : EndpointDeterminationData C} (W : CollarWidthTubeData C hDet)
    (t₀ x₀ H₁ ε δ : ℝ) : Prop :=
  (∃ g : Fin 2 → MeroOn2D
      { p : ℂ × ℂ |
        ‖p.1 - ((x₀ : ℂ) + (H₁ : ℂ) * Complex.I)‖ < ε ∧
        ‖p.2 - (t₀ : ℂ)‖ < ε },
    ∀ i : Fin 2, MeroEqOn (g i) (W.X_mero i)
      { p : ℂ × ℂ |
        |p.1.re - x₀| < ε / 4 ∧
        |p.1.im - (H₁ - ε / 2)| < ε / 4 ∧
        ‖p.2 - (t₀ : ℂ)‖ < δ }) ∨
  (∃ g : Fin 2 → MeroOn2D
      { p : ℂ × ℂ |
        ‖p.1 - ((x₀ : ℂ) + (H₁ : ℂ) * Complex.I)‖ < ε ∧
        ‖p.2 - (t₀ : ℂ)‖ < ε },
    ∀ i : Fin 2, MeroEqOn (g i) (W.L_mero i)
      { p : ℂ × ℂ |
        |p.1.re - x₀| < ε / 4 ∧
        |p.1.im - (H₁ - ε / 2)| < ε / 4 ∧
        ‖p.2 - (t₀ : ℂ)‖ < δ })

structure FullBandPolyData {Ω : Set Plane} {C : AnalyticGlancingCollar Ω}
    {hDet : EndpointDeterminationData C} (W : CollarWidthTubeData C hDet)
    (H₁ η t₁ : ℝ) where
  r₁ : ℝ
  r₁_pos : 0 < r₁
  ball_sub_base : Metric.ball (t₁ : ℂ) r₁ ⊆ Metric.ball (0 : ℂ) W.r_base
  h_L_lower : ∀ t ∈ Metric.ball (t₁ : ℂ) r₁, ENNReal.ofReal (H₁ - η) < W.h_L t
  N_cov : ℕ
  y_c : Fin N_cov → ℂ
  τ_c : Fin N_cov → ℂ
  ρ_y : Fin N_cov → ℝ
  ρ_t : Fin N_cov → ℝ
  ρ_pos : ∀ β : Fin N_cov, 0 < ρ_y β ∧ 0 < ρ_t β ∧
    Metric.ball (τ_c β) (ρ_t β) ⊆ Metric.ball (t₁ : ℂ) r₁
  covers_band : ∀ (x y_im : ℝ) (t : ℂ),
    x ∈ Set.Icc (0 : ℝ) (2 * Real.pi) →
    y_im ∈ Set.Icc (H₁ - η) (H₁ + η) →
    t ∈ Metric.closedBall (t₁ : ℂ) (r₁ / 2) →
    ∃ β : Fin N_cov,
      ((x : ℂ) + (y_im : ℂ) * Complex.I) ∈ Metric.ball (y_c β) (3 * ρ_y β / 4) ∧
      t ∈ Metric.ball (τ_c β) (3 * ρ_t β / 4)
  deg : Fin N_cov → Fin 2 → ℕ
  deg_pos : ∀ β ι, 1 ≤ deg β ι
  C_coeff : ∀ (β : Fin N_cov) (ι : Fin 2), Fin (deg β ι + 1) → ℂ × ℂ → ℂ
  H_exc : Fin N_cov → ℂ × ℂ → ℂ
  coeff_holo : ∀ β ι d,
    DifferentiableOn ℂ (C_coeff β ι d)
      (Metric.ball (y_c β) (ρ_y β) ×ˢ Metric.ball (τ_c β) (ρ_t β))
  exc_holo : ∀ β,
    DifferentiableOn ℂ (H_exc β)
      (Metric.ball (y_c β) (ρ_y β) ×ˢ Metric.ball (τ_c β) (ρ_t β))
  exc_ne_zero : ∀ β,
    ∃ p ∈ Metric.ball (y_c β) (ρ_y β) ×ˢ Metric.ball (τ_c β) (ρ_t β), H_exc β p ≠ 0
  lead_dvd_exc : ∀ β ι, ∃ G_div : ℂ × ℂ → ℂ,
    DifferentiableOn ℂ G_div
      (Metric.ball (y_c β) (ρ_y β) ×ˢ Metric.ball (τ_c β) (ρ_t β)) ∧
    ∀ q ∈ Metric.ball (y_c β) (ρ_y β) ×ˢ Metric.ball (τ_c β) (ρ_t β),
      H_exc β q = C_coeff β ι (Fin.last (deg β ι)) q * G_div q
  separable_at : ∀ β ι,
    ∀ q ∈ Metric.ball (y_c β) (ρ_y β) ×ˢ Metric.ball (τ_c β) (ρ_t β),
      H_exc β q ≠ 0 →
      C_coeff β ι (Fin.last (deg β ι)) q ≠ 0 ∧
      ∀ z : ℂ,
        ∑ d : Fin (deg β ι + 1), C_coeff β ι d q * z ^ (d : ℕ) = 0 →
        ∑ d : Fin (deg β ι),
          (((d : ℕ) + 1 : ℕ) : ℂ) * C_coeff β ι d.succ q * z ^ (d : ℕ) ≠ 0
  primary_solves : ∀ β ι,
    ∀ p ∈ (Metric.ball (y_c β) (ρ_y β) ×ˢ Metric.ball (τ_c β) (ρ_t β)) ∩
        meroTubeENNR W.r_base W.h_L,
      ∃ r_p : ℝ, 0 < r_p ∧ r_p ≤ (W.L_mero ι).rad p ∧
        Metric.ball p r_p ⊆
          Metric.ball (y_c β) (ρ_y β) ×ˢ Metric.ball (τ_c β) (ρ_t β) ∧
        ∀ q ∈ Metric.ball p r_p,
          ∑ d : Fin (deg β ι + 1),
            C_coeff β ι d q *
              ((W.L_mero ι).num p q) ^ (d : ℕ) *
              ((W.L_mero ι).den p q) ^ (deg β ι - (d : ℕ)) = 0

def WallRegAt {Ω : Set Plane} {C : AnalyticGlancingCollar Ω}
    {hDet : EndpointDeterminationData C} (W : CollarWidthTubeData C hDet)
    (t₂ H₂ x : ℝ) : Prop :=
  ∃ (δ_x δ_t : ℝ)
    (G : Fin 2 → MeroOn2D
      (Metric.ball ((x : ℂ) + (H₂ : ℂ) * Complex.I) δ_x ×ˢ Metric.ball (t₂ : ℂ) δ_t)),
    0 < δ_x ∧ 0 < δ_t ∧
    Metric.ball (t₂ : ℂ) δ_t ⊆ Metric.ball (0 : ℂ) W.r_base ∧
    ∀ i : Fin 2, MeroEqOn (G i) (W.L_mero i)
      ({ y : ℂ | y ∈ Metric.ball ((x : ℂ) + (H₂ : ℂ) * Complex.I) δ_x ∧
          y.im < H₂ - δ_x / 2 } ×ˢ Metric.ball (t₂ : ℂ) δ_t)

structure AlignedWallDefectData {Ω : Set Plane} {C : AnalyticGlancingCollar Ω}
    {hDet : EndpointDeterminationData C} (W : CollarWidthTubeData C hDet) (t₂ : ℝ) where
  t₂_mem : |t₂| < W.r_base
  t₂_irr : Irrational (t₂ / (2 * Real.pi))
  H₂ : ℝ
  h_L_eq_H₂ : W.h_L (t₂ : ℂ) = ENNReal.ofReal H₂
  H₂_ge : 2 * W.s_base ≤ H₂
  x_star : ℝ
  K : ℕ
  unaligned_wall_reg : ∀ q : ℤ, (q ≤ 0 ∨ K < q.natAbs) →
    WallRegAt W t₂ H₂ (x_star + (q : ℝ) * t₂)
  ρ₀ : ℝ
  ρ₀_pos : 0 < ρ₀
  ρ₀_lt : ρ₀ < W.s_base / 2
  loop_branch_one : ∀ ρ : ℝ, 0 < ρ → ρ < ρ₀ →
    ∃ (δ_w δ_loop : ℝ) (Λ_loop : Fin 2 → ℂ × ℂ → ℂ),
      0 < δ_w ∧ δ_w ≤ 1 / 8 ∧ 0 < δ_loop ∧
      Metric.ball (t₂ : ℂ) δ_loop ⊆ Metric.ball (0 : ℂ) W.r_base ∧
      let y_star : ℂ := (x_star : ℂ) + (H₂ : ℂ) * Complex.I
      let w_start : ℂ := (Real.log ρ : ℂ) - ((Real.pi / 2 : ℝ) : ℂ) * Complex.I
      let p₀ : ℂ × ℂ := (y_star - (ρ : ℂ) * Complex.I + (t₂ : ℂ), (t₂ : ℂ))
      let LoopStrip : Set (ℂ × ℂ) :=
        { w : ℂ | |w.re - Real.log ρ| < δ_w ∧
            w.im ∈ Set.Ioo (-Real.pi / 2 - 1 / 8) (3 * Real.pi / 2 + 1 / 8) } ×ˢ
          Metric.ball (t₂ : ℂ) δ_loop
      p₀ ∈ meroTubeENNR W.r_base W.h_L ∧
      (∀ ι : Fin 2, DifferentiableOn ℂ (Λ_loop ι) LoopStrip) ∧
      (∃ r_att : ℝ, 0 < r_att ∧
        ∀ w t : ℂ, ‖w - w_start‖ < r_att → ‖t - (t₂ : ℂ)‖ < r_att →
          (w, t) ∈ LoopStrip ∧
          ∀ ι : Fin 2,
            (y_star + Complex.exp w + t, t) ∈ Metric.ball p₀ ((W.L_mero ι).rad p₀) ∧
            (W.L_mero ι).num p₀ (y_star + Complex.exp w + t, t) =
              Λ_loop ι (w, t) * (W.L_mero ι).den p₀ (y_star + Complex.exp w + t, t)) ∧
      (∃ ι : Fin 2,
        ¬ ∀ᶠ p in nhds (w_start, (t₂ : ℂ)),
            Λ_loop ι (p.1 + 2 * Real.pi * Complex.I, p.2) = Λ_loop ι p)

abbrev SymJetVar (N_idx M : ℕ) : Type :=
  Fin N_idx × Fin 2 × Fin (M + 1) × Fin (M + 1)

noncomputable def symJetEnv {Ω : Set Plane} (C : AnalyticGlancingCollar Ω)
    {N_idx : ℕ} (q_idx : Fin N_idx → ℤ) (M : ℕ) (p : ℂ × ℂ) :
    SymJetVar N_idx M → ℂ :=
  fun v =>
    iterDerivYT v.2.2.1.1 v.2.2.2.1
      (fun r : ℂ × ℂ => glancingDualLine C (r.1 + (q_idx v.1 : ℂ) * r.2) r.2 v.2.1) p

def PolyReflectionProp {Ω : Set Plane} (C : AnalyticGlancingCollar Ω)
    (s_b r_b : ℝ) (K : ℕ) : Prop :=
  ∀ (N_idx M D : ℕ) (q_idx : Fin N_idx → ℤ) (ι_star : Fin 2)
    (Q : Fin (D + 1) → MvPolynomial (SymJetVar N_idx M) ℂ),
    (∀ a : Fin N_idx, (q_idx a ≤ 0 ∨ K < (q_idx a).natAbs) ∧
      ∃ b : Fin N_idx, q_idx b = -q_idx a) →
    let J_bound : ℝ := ((Finset.univ.sup fun a : Fin N_idx => (q_idx a).natAbs : ℕ) : ℝ) + 2
    let V_dom : Set (ℂ × ℂ) :=
      { p : ℂ × ℂ | |p.1.im| < s_b / 2 ∧ ‖p.2‖ < r_b ∧ |p.2.im| < s_b / (2 * J_bound) }
    (∀ p ∈ V_dom,
      ∑ d : Fin (D + 1),
        MvPolynomial.eval (symJetEnv C q_idx M p) (Q d) *
          (glancingDualLine C (p.1 + p.2) p.2 ι_star) ^ (d : ℕ) = 0) →
    (∀ p ∈ V_dom,
      ∑ d : Fin (D + 1),
        MvPolynomial.eval (symJetEnv C q_idx M p) (Q d) *
          (glancingDualLine C (p.1 - p.2) p.2 ι_star) ^ (d : ℕ) = 0)
noncomputable def expSlope_C (W : ℂ → ℂ) (X y : ℂ) : ℂ :=
  ∫ s in (0 : ℝ)..1,
    deriv W (X + (s : ℂ) * y) * Complex.exp (W (X + (s : ℂ) * y) - W X)

noncomputable def midStepOp_C (W : ℂ → ℂ) (X T ζ : ℂ) : ℂ :=
  T *
    ((1 / 2 : ℂ) * (∫ v in (0 : ℝ)..1, (v : ℂ) * expSlope_C W X ((v : ℂ) * T)) -
      ((1 / 2 : ℂ) + ζ) ^ 2 *
        (∫ θ in (0 : ℝ)..1, (θ : ℂ) * expSlope_C W X ((θ : ℂ) * T * ((1 / 2 : ℂ) + ζ))))

noncomputable def zetaSeq_C (W X T : ℂ → ℂ) : ℕ → ℂ → ℂ
  | 0, _ => 0
  | n + 1, z => midStepOp_C W (X z) (T z) (zetaSeq_C W X T n z)

noncomputable def zetaLim_C (W X T : ℂ → ℂ) (z : ℂ) : ℂ :=
  Filter.limUnder Filter.atTop (fun n => zetaSeq_C W X T n z)

noncomputable def zMid_C (W X T : ℂ → ℂ) (z : ℂ) : ℂ :=
  (1 / 2 : ℂ) + zetaLim_C W X T z

noncomputable def midCanon_C (W : ℂ → ℂ) (ρ : ℝ) (q : ℕ) (e_X τ_T : ℂ → ℂ) (z : ℂ) : ℂ :=
  let X : ℂ → ℂ := fun ζ => ζ + (ρ : ℂ) + e_X ζ
  let T : ℂ → ℂ := fun ζ => ((2 * Real.pi / (q : ℝ) : ℝ) : ℂ) + τ_T ζ
  X z + T z * zMid_C W X T z

noncomputable def aCanon_C (W : ℂ → ℂ) (Z : ℂ) : ℂ :=
  (7 * iteratedDeriv 2 W Z - 8 * (iteratedDeriv 1 W Z) ^ 2 - Complex.exp (2 * W Z)) / 384

noncomputable def rG_C (W : ℂ → ℂ) (X₀ y : ℂ) : ℂ :=
  (1 / 2 : ℂ) * ∫ s in (0 : ℝ)..1,
    ((1 - s : ℝ) : ℂ) ^ 2 *
      ((iteratedDeriv 3 W (X₀ + (s : ℂ) * y) +
          3 * iteratedDeriv 1 W (X₀ + (s : ℂ) * y) * iteratedDeriv 2 W (X₀ + (s : ℂ) * y) +
          (iteratedDeriv 1 W (X₀ + (s : ℂ) * y)) ^ 3) *
        Complex.exp (W (X₀ + (s : ℂ) * y) - W X₀))

noncomputable def rH_C (W : ℂ → ℂ) (X₀ y : ℂ) : ℂ :=
  (1 / 2 : ℂ) * ∫ s in (0 : ℝ)..1,
    ((1 - s : ℝ) : ℂ) ^ 2 *
      ((-2 * iteratedDeriv 3 W (X₀ + (s : ℂ) * y) +
          12 * iteratedDeriv 1 W (X₀ + (s : ℂ) * y) * iteratedDeriv 2 W (X₀ + (s : ℂ) * y) -
          8 * (iteratedDeriv 1 W (X₀ + (s : ℂ) * y)) ^ 3) *
        Complex.exp (-2 * (W (X₀ + (s : ℂ) * y) - W X₀)))

noncomputable def rSinc_C (u : ℂ) : ℂ :=
  (1 / 2 : ℂ) * ∫ r in (0 : ℝ)..1,
    (r : ℂ) ^ 3 *
      (∫ s in (0 : ℝ)..1, ((1 - s : ℝ) : ℂ) ^ 2 * Complex.sin (((s * r : ℝ) : ℂ) * u))

noncomputable def mFactor_C (W : ℂ → ℂ) (X₀ T₀ z₀ : ℂ) : ℂ :=
  let α₀ := iteratedDeriv 1 W X₀
  let β₀ := iteratedDeriv 2 W X₀
  let z_jet := (1 / 2 : ℂ) + (α₀ / 8) * T₀ + (β₀ / 16) * T₀ ^ 2
  1 + (α₀ / 2) * T₀ * (z₀ + z_jet) +
    ((β₀ + α₀ ^ 2) / 6) * T₀ ^ 2 * (z₀ ^ 2 + z₀ * z_jet + z_jet ^ 2)

noncomputable def rZ_C (W : ℂ → ℂ) (X₀ T₀ z₀ : ℂ) : ℂ :=
  let α₀ := iteratedDeriv 1 W X₀
  let β₀ := iteratedDeriv 2 W X₀
  let u_z := α₀ / 8 + (β₀ / 16) * T₀
  let Q_jet :=
    α₀ * β₀ / 32 + (α₀ / 2) * u_z ^ 2 +
      ((β₀ + α₀ ^ 2) / 6) *
        ((3 / 4 : ℂ) * u_z + (3 / 2 : ℂ) * T₀ * u_z ^ 2 + T₀ ^ 2 * u_z ^ 3)
  let R_L := ∫ θ in (0 : ℝ)..1, (θ : ℂ) ^ 3 * rG_C W X₀ ((θ : ℂ) * T₀ * z₀)
  let R_R := (1 / 2 : ℂ) * ∫ v in (0 : ℝ)..1, (v : ℂ) ^ 3 * rG_C W X₀ ((v : ℂ) * T₀)
  (R_R - z₀ ^ 4 * R_L - Q_jet) / mFactor_C W X₀ T₀ z₀

noncomputable def rK_C (W : ℂ → ℂ) (X₀ y : ℂ) : ℂ :=
  let α₀ := iteratedDeriv 1 W X₀
  let β₀ := iteratedDeriv 2 W X₀
  let A₀ := Complex.exp (W X₀)
  let p₁ := α₀ / 2
  let p₂ := (β₀ + α₀ ^ 2) / 6
  let R₁ := ∫ s in (0 : ℝ)..1, (s : ℂ) ^ 3 * rG_C W X₀ ((s : ℂ) * y)
  let G₁ := 1 + p₁ * y + p₂ * y ^ 2 + y ^ 3 * R₁
  let q₂ := -(A₀ ^ 2) / 6
  let R₂ :=
    q₂ * (p₁ + p₂ * y + y ^ 2 * R₁) * (G₁ + 1) +
      A₀ ^ 3 * G₁ ^ 3 * rSinc_C (A₀ * y * G₁)
  let h₁ := -2 * α₀
  let h₂ := 2 * α₀ ^ 2 - β₀
  let m₁ := p₁
  let m₂ := p₂ + q₂
  let R_m := p₁ * q₂ + p₂ * q₂ * y + R₂ * G₁ + R₁ * (1 + q₂ * y ^ 2)
  let M_val := 1 + m₁ * y + m₂ * y ^ 2 + y ^ 3 * R_m
  m₁ * h₂ + m₂ * h₁ + m₂ * h₂ * y +
    rH_C W X₀ y * M_val + R_m * (1 + h₁ * y + h₂ * y ^ 2)

noncomputable def rI_C (W : ℂ → ℂ) (X₀ H : ℂ) : ℂ :=
  ∫ τ in (0 : ℝ)..1, (τ : ℂ) ^ 4 * rK_C W X₀ ((τ : ℂ) * H)

noncomputable def bPoint_C (W : ℂ → ℂ) (X₀ T₀ z₀ : ℂ) : ℂ :=
  let α₀ := iteratedDeriv 1 W X₀
  let β₀ := iteratedDeriv 2 W X₀
  let A₀ := Complex.exp (W X₀)
  let r_z := rZ_C W X₀ T₀ z₀
  let c₂ := (7 * α₀ ^ 2 - 5 * β₀ - A₀ ^ 2) / 24
  let v_z := β₀ / 16 + T₀ * r_z
  let w_z := α₀ / 8 + T₀ * v_z
  ((1 / 2 : ℂ) * r_z + (α₀ / 8) * v_z + (1 / 2 : ℂ) * T₀ * v_z ^ 2) -
    ((3 * α₀ / 8) * v_z + (3 * α₀ / 4) * w_z ^ 2 + (α₀ / 2) * T₀ * w_z ^ 3) +
    c₂ *
      ((1 / 2 : ℂ) * w_z + (3 / 2 : ℂ) * T₀ * w_z ^ 2 +
        2 * T₀ ^ 2 * w_z ^ 3 + T₀ ^ 3 * w_z ^ 4) +
    z₀ ^ 5 * rI_C W X₀ (T₀ * z₀)

noncomputable def bCanon_C (W : ℂ → ℂ) (ρ sgn : ℝ) (q : ℕ) (e_X τ_T : ℂ → ℂ) (z : ℂ) : ℂ :=
  let X : ℂ → ℂ := fun ζ => ζ + (ρ : ℂ) + e_X ζ
  let T : ℂ → ℂ := fun ζ => ((sgn * (2 * Real.pi / (q : ℝ)) : ℝ) : ℂ) + τ_T ζ
  bPoint_C W (X z) (T z) (zMid_C W X T z)

noncomputable def shjCompConst : ℕ → ℝ → ℝ
  | 0, _ => 1
  | p + 1, B => max 1 ((2 : ℝ) ^ p * max B 0 * shjCompConst p B)

def IsStripBounded (p : ℕ) (σ' M : ℝ) (f : ℂ → ℂ) : Prop :=
  DifferentiableOn ℂ f (horizStrip σ') ∧
  ∀ k : ℕ, k ≤ p → ∀ z ∈ horizStrip σ', ‖iteratedDeriv k f z‖ ≤ M

def IsStripHoloSymBounded (p : ℕ) (σ' M : ℝ) (f : ℂ → ℂ) : Prop :=
  IsStripBounded p σ' M f ∧
  (∀ z ∈ horizStrip σ', f (z + 2 * Real.pi) = f z) ∧
  (∀ z ∈ horizStrip σ', f (starRingEnd ℂ z) = starRingEnd ℂ (f z))

structure StripCalculusToolkit : Prop where
  vert_strip_maps_to : ∀ (σ σ' α ρ : ℝ) (e : ℂ → ℂ),
    0 < σ →
    0 < σ' →
    0 ≤ α →
    σ' ≤ (1 - 2 * α) * σ →
    DifferentiableOn ℂ e (horizStrip σ') →
    (∀ z ∈ horizStrip σ', e (starRingEnd ℂ z) = starRingEnd ℂ (e z)) →
    (∀ z ∈ horizStrip σ', ‖deriv e z‖ ≤ α) →
    ∀ z ∈ horizStrip σ', z + (ρ : ℂ) + e z ∈ horizStrip σ
  stripExt_iteratedDeriv_props : ∀ (r₀ d : ℕ) (σ M₁ : ℝ) (w : ℝ → ℝ) (W : ℂ → ℂ),
    IsBoundedStripExt r₀ σ M₁ w W →
    d ≤ r₀ →
    DifferentiableOn ℂ (iteratedDeriv d W) (horizStrip σ) ∧
    (∀ ζ ∈ horizStrip σ, iteratedDeriv d W (ζ + 2 * Real.pi) = iteratedDeriv d W ζ) ∧
    (∀ ζ ∈ horizStrip σ,
      iteratedDeriv d W (starRingEnd ℂ ζ) = starRingEnd ℂ (iteratedDeriv d W ζ)) ∧
    (∀ j : ℕ, j + d ≤ r₀ → ∀ ζ ∈ horizStrip σ,
      ‖iteratedDeriv j (iteratedDeriv d W) ζ‖ ≤ M₁)
  stripDiffSup_nonneg_and_le : ∀ (r₀ : ℕ) (σ M₁ : ℝ) (w₁ w₂ : ℝ → ℝ) (W₁ W₂ : ℂ → ℂ),
    0 < σ →
    IsBoundedStripExt r₀ σ M₁ w₁ W₁ →
    IsBoundedStripExt r₀ σ M₁ w₂ W₂ →
    0 ≤ stripDiffSup r₀ σ W₁ W₂ ∧
    ∀ (j d : ℕ), j + d ≤ r₀ → ∀ ζ ∈ horizStrip σ,
      ‖iteratedDeriv j (fun z => iteratedDeriv d W₁ z - iteratedDeriv d W₂ z) ζ‖ ≤
        stripDiffSup r₀ σ W₁ W₂
  real_iteratedDeriv_eq : ∀ (r₀ : ℕ) (σ M₁ : ℝ) (w : ℝ → ℝ) (W : ℂ → ℂ),
    0 < σ →
    IsPeriodicSmoothBounded r₀ M₁ w →
    IsBoundedStripExt r₀ σ M₁ w W →
    ∀ k : ℕ, k ≤ r₀ → ∀ r : ℝ, iteratedDeriv k W (r : ℂ) = ((iteratedDeriv k w r : ℝ) : ℂ)
  bounded_const : ∀ (p : ℕ) (σ' : ℝ) (c : ℂ),
    IsStripBounded p σ' ‖c‖ (fun _ => c)
  holo_const_real : ∀ (p : ℕ) (σ' c : ℝ),
    IsStripHoloSymBounded p σ' |c| (fun _ => (c : ℂ))
  bounded_mono : ∀ {p : ℕ} {σ' M₁ M₂ : ℝ} {f : ℂ → ℂ},
    M₁ ≤ M₂ → IsStripBounded p σ' M₁ f → IsStripBounded p σ' M₂ f
  holo_mono : ∀ {p : ℕ} {σ' M₁ M₂ : ℝ} {f : ℂ → ℂ},
    M₁ ≤ M₂ → IsStripHoloSymBounded p σ' M₁ f → IsStripHoloSymBounded p σ' M₂ f
  bounded_add : ∀ {p : ℕ} {σ' M₁ M₂ : ℝ} {f g : ℂ → ℂ},
    IsStripBounded p σ' M₁ f → IsStripBounded p σ' M₂ g →
    IsStripBounded p σ' (M₁ + M₂) (fun z => f z + g z)
  holo_add : ∀ {p : ℕ} {σ' M₁ M₂ : ℝ} {f g : ℂ → ℂ},
    IsStripHoloSymBounded p σ' M₁ f → IsStripHoloSymBounded p σ' M₂ g →
    IsStripHoloSymBounded p σ' (M₁ + M₂) (fun z => f z + g z)
  bounded_sub : ∀ {p : ℕ} {σ' M₁ M₂ : ℝ} {f g : ℂ → ℂ},
    IsStripBounded p σ' M₁ f → IsStripBounded p σ' M₂ g →
    IsStripBounded p σ' (M₁ + M₂) (fun z => f z - g z)
  holo_sub : ∀ {p : ℕ} {σ' M₁ M₂ : ℝ} {f g : ℂ → ℂ},
    IsStripHoloSymBounded p σ' M₁ f → IsStripHoloSymBounded p σ' M₂ g →
    IsStripHoloSymBounded p σ' (M₁ + M₂) (fun z => f z - g z)
  bounded_neg : ∀ {p : ℕ} {σ' M : ℝ} {f : ℂ → ℂ},
    IsStripBounded p σ' M f → IsStripBounded p σ' M (fun z => -f z)
  holo_neg : ∀ {p : ℕ} {σ' M : ℝ} {f : ℂ → ℂ},
    IsStripHoloSymBounded p σ' M f → IsStripHoloSymBounded p σ' M (fun z => -f z)
  bounded_const_mul : ∀ {p : ℕ} {σ' M : ℝ} (c : ℂ) {f : ℂ → ℂ},
    0 ≤ M → IsStripBounded p σ' M f →
    IsStripBounded p σ' (‖c‖ * M) (fun z => c * f z)
  holo_real_mul : ∀ {p : ℕ} {σ' M : ℝ} (c : ℝ) {f : ℂ → ℂ},
    0 ≤ M → IsStripHoloSymBounded p σ' M f →
    IsStripHoloSymBounded p σ' (|c| * M) (fun z => (c : ℂ) * f z)
  bounded_mul : ∀ {p : ℕ} {σ' M₁ M₂ : ℝ} {f g : ℂ → ℂ},
    IsStripBounded p σ' M₁ f → IsStripBounded p σ' M₂ g →
    IsStripBounded p σ' ((2 : ℝ) ^ p * M₁ * M₂) (fun z => f z * g z)
  holo_mul : ∀ {p : ℕ} {σ' M₁ M₂ : ℝ} {f g : ℂ → ℂ},
    IsStripHoloSymBounded p σ' M₁ f → IsStripHoloSymBounded p σ' M₂ g →
    IsStripHoloSymBounded p σ' ((2 : ℝ) ^ p * M₁ * M₂) (fun z => f z * g z)
  bounded_mul_diff : ∀ {p : ℕ} {σ' M_f M_g Δf Δg : ℝ} {f₁ f₂ g₁ g₂ : ℂ → ℂ},
    IsStripBounded p σ' M_f f₁ →
    IsStripBounded p σ' M_g g₂ →
    IsStripBounded p σ' Δf (fun z => f₁ z - f₂ z) →
    IsStripBounded p σ' Δg (fun z => g₁ z - g₂ z) →
    IsStripBounded p σ' ((2 : ℝ) ^ p * (M_f * Δg + Δf * M_g))
      (fun z => f₁ z * g₁ z - f₂ z * g₂ z)
  holo_inv : ∀ {p : ℕ} {σ' M_g : ℝ} {g : ℂ → ℂ},
    0 ≤ M_g →
    IsStripHoloSymBounded p σ' M_g g →
    (∀ z ∈ horizStrip σ', ‖g z - 1‖ ≤ 1 / 2) →
    IsStripHoloSymBounded p σ'
      ((((p + 1).factorial : ℝ) * (4 : ℝ) ^ (p + 2)) * shjCompConst p M_g)
      (fun z => (g z)⁻¹)
  bounded_inv_diff : ∀ {p : ℕ} {σ' M_g Δg : ℝ} {g₁ g₂ : ℂ → ℂ},
    0 ≤ M_g →
    0 ≤ Δg →
    IsStripBounded p σ' M_g g₁ →
    IsStripBounded p σ' M_g g₂ →
    (∀ z ∈ horizStrip σ', ‖g₁ z - 1‖ ≤ 1 / 2) →
    (∀ z ∈ horizStrip σ', ‖g₂ z - 1‖ ≤ 1 / 2) →
    IsStripBounded p σ' Δg (fun z => g₁ z - g₂ z) →
    IsStripBounded p σ'
      ((2 : ℝ) ^ p * (((p + 1).factorial : ℝ) * (4 : ℝ) ^ (p + 2)) * shjCompConst p M_g * Δg)
      (fun z => (g₁ z)⁻¹ - (g₂ z)⁻¹)
  exp_ball_bound : ∀ (R : ℝ),
    0 < R →
    DifferentiableOn ℂ Complex.exp (Metric.ball (0 : ℂ) R) ∧
    (∀ w : ℂ, Complex.exp (starRingEnd ℂ w) = starRingEnd ℂ (Complex.exp w)) ∧
    (∀ j : ℕ, ∀ w ∈ Metric.ball (0 : ℂ) R, ‖iteratedDeriv j Complex.exp w‖ ≤ Real.exp R)
  sin_ball_bound : ∀ (R : ℝ),
    0 < R →
    DifferentiableOn ℂ Complex.sin (Metric.ball (0 : ℂ) R) ∧
    (∀ w : ℂ, Complex.sin (starRingEnd ℂ w) = starRingEnd ℂ (Complex.sin w)) ∧
    (∀ j : ℕ, ∀ w ∈ Metric.ball (0 : ℂ) R, ‖iteratedDeriv j Complex.sin w‖ ≤ Real.exp R)
  comp_bound : ∀ (p : ℕ) (σ' M_G B : ℝ) (V : Set ℂ) (G f : ℂ → ℂ),
    IsOpen V →
    0 ≤ M_G →
    0 ≤ B →
    DifferentiableOn ℂ G V →
    (∀ j : ℕ, j ≤ p → ∀ w ∈ V, ‖iteratedDeriv j G w‖ ≤ M_G) →
    DifferentiableOn ℂ f (horizStrip σ') →
    (∀ z ∈ horizStrip σ', f z ∈ V) →
    (∀ j : ℕ, 1 ≤ j → j ≤ p → ∀ z ∈ horizStrip σ', ‖iteratedDeriv j f z‖ ≤ B) →
    IsStripBounded p σ' (M_G * shjCompConst p B) (fun z => G (f z))
  comp_diff_bound : ∀ (p : ℕ) (σ' M_G ΔG B Δf : ℝ) (V : Set ℂ) (G₁ G₂ f₁ f₂ : ℂ → ℂ),
    IsOpen V →
    Convex ℝ V →
    0 ≤ M_G →
    0 ≤ ΔG →
    0 ≤ B →
    0 ≤ Δf →
    DifferentiableOn ℂ G₁ V →
    DifferentiableOn ℂ G₂ V →
    (∀ j : ℕ, j ≤ p → ∀ w ∈ V, ‖iteratedDeriv j (fun ζ => G₁ ζ - G₂ ζ) w‖ ≤ ΔG) →
    (∀ j : ℕ, j ≤ p + 1 → ∀ w ∈ V, ‖iteratedDeriv j G₂ w‖ ≤ M_G) →
    DifferentiableOn ℂ f₁ (horizStrip σ') →
    DifferentiableOn ℂ f₂ (horizStrip σ') →
    (∀ z ∈ horizStrip σ', f₁ z ∈ V) →
    (∀ z ∈ horizStrip σ', f₂ z ∈ V) →
    (∀ j : ℕ, 1 ≤ j → j ≤ p → ∀ z ∈ horizStrip σ', ‖iteratedDeriv j f₁ z‖ ≤ B) →
    (∀ j : ℕ, 1 ≤ j → j ≤ p → ∀ z ∈ horizStrip σ', ‖iteratedDeriv j f₂ z‖ ≤ B) →
    IsStripBounded p σ' Δf (fun z => f₁ z - f₂ z) →
    IsStripBounded p σ' (shjCompConst p B * (ΔG + (2 : ℝ) ^ p * M_G * Δf))
      (fun z => G₁ (f₁ z) - G₂ (f₂ z))
  continuousOn_param_int : ∀ (M : ℝ) (g : ℝ → ℝ → ℂ),
    0 ≤ M →
    (∀ u ∈ Set.Icc (0 : ℝ) 1, ContinuousOn (g u) (Set.Icc (0 : ℝ) 1)) →
    (∀ t ∈ Set.Icc (0 : ℝ) 1, ContinuousOn (fun u => g u t) (Set.Icc (0 : ℝ) 1)) →
    (∀ u ∈ Set.Icc (0 : ℝ) 1, ∀ t ∈ Set.Icc (0 : ℝ) 1, ‖g u t‖ ≤ M) →
    ContinuousOn (fun u => ∫ t in (0 : ℝ)..1, g u t) (Set.Icc (0 : ℝ) 1)
  param_int_bound : ∀ (p : ℕ) (σ' M : ℝ) (F : ℝ → ℂ → ℂ),
    0 ≤ M →
    (∀ z ∈ horizStrip σ', ContinuousOn (fun t => F t z) (Set.Icc (0 : ℝ) 1)) →
    (∀ t ∈ Set.Icc (0 : ℝ) 1, IsStripBounded p σ' M (F t)) →
    IsStripBounded p σ' M (fun z => ∫ t in (0 : ℝ)..1, F t z) ∧
    ∀ k : ℕ, k ≤ p → ∀ z ∈ horizStrip σ',
      iteratedDeriv k (fun w => ∫ t in (0 : ℝ)..1, F t w) z =
        ∫ t in (0 : ℝ)..1, iteratedDeriv k (F t) z
  param_int_holo : ∀ (p : ℕ) (σ' M : ℝ) (F : ℝ → ℂ → ℂ),
    0 ≤ M →
    (∀ z ∈ horizStrip σ', ContinuousOn (fun t => F t z) (Set.Icc (0 : ℝ) 1)) →
    (∀ t ∈ Set.Icc (0 : ℝ) 1, IsStripHoloSymBounded p σ' M (F t)) →
    IsStripHoloSymBounded p σ' M (fun z => ∫ t in (0 : ℝ)..1, F t z)

structure PointwiseTaylorAndRealActionProp : Prop where
  midStepOp_C_fixed_iff : ∀ (σ : ℝ) (W : ℂ → ℂ) (X₀ T₀ z₀ : ℂ),
    0 < σ →
    DifferentiableOn ℂ W (horizStrip σ) →
    X₀ ∈ horizStrip σ →
    X₀ + T₀ ∈ horizStrip σ →
    X₀ + T₀ * z₀ ∈ horizStrip σ →
    (z₀ - (1 / 2 : ℂ) = midStepOp_C W X₀ T₀ (z₀ - (1 / 2 : ℂ)) ↔
      z₀ * (∫ θ in (0 : ℝ)..1, Complex.exp (W (X₀ + (θ : ℂ) * T₀ * z₀) - W X₀)) =
        (1 / 2 : ℂ) * (∫ v in (0 : ℝ)..1, Complex.exp (W (X₀ + (v : ℂ) * T₀) - W X₀)))
  real_midpoint_and_action_eq : ∀ (σ : ℝ) (w : ℝ → ℝ) (W : ℂ → ℂ) (X_r T_r z_r : ℝ),
    0 < σ →
    ContDiff ℝ (3 : WithTop ℕ∞) w →
    DifferentiableOn ℂ W (horizStrip σ) →
    (∀ k : ℕ, k ≤ 3 → ∀ r : ℝ, iteratedDeriv k W (r : ℂ) = ((iteratedDeriv k w r : ℝ) : ℂ)) →
    (z_r : ℂ) - (1 / 2 : ℂ) = midStepOp_C W (X_r : ℂ) (T_r : ℂ) ((z_r : ℂ) - (1 / 2 : ℂ)) →
    midpoint_ℝ w X_r (X_r + T_r) = X_r + T_r * z_r ∧
    (mFactor_C W (X_r : ℂ) (T_r : ℂ) (z_r : ℂ) ≠ 0 →
      ((normAction1_ℝ w X_r (X_r + T_r) : ℝ) : ℂ) =
        (T_r : ℂ) ^ 2 *
          ((1 / 8 : ℂ) + aCanon_C W (X_r : ℂ) * (T_r : ℂ) ^ 2 +
            (T_r : ℂ) ^ 3 * bPoint_C W (X_r : ℂ) (T_r : ℂ) (z_r : ℂ)))

structure StripMidpointSystem (m : ℕ) (M₁ : ℝ) where
  C_mid_C : ℝ
  C_zeta : ℝ
  K_mid : ℝ
  N_mid : ℕ
  C_mid_C_pos : 0 < C_mid_C
  C_zeta_pos : 0 < C_zeta
  K_mid_pos : 0 < K_mid
  N_mid_ge_four : 4 ≤ N_mid
  midpoint_props : ∀ (σ σ' α ρ : ℝ) (q : ℕ) (w : ℝ → ℝ) (W e_X τ_T : ℂ → ℂ),
    σ ∈ Set.Ioc (0 : ℝ) 1 →
    N_mid ≤ q →
    α ∈ Set.Icc (0 : ℝ) (1 / 16) →
    0 < σ' →
    σ' ≤ (1 - 6 * α - K_mid / (q : ℝ) ^ 2) * σ →
    IsPeriodicSmoothBounded (m + 15) M₁ w →
    IsBoundedStripExt (m + 15) σ M₁ w W →
    IsStripJetPerturb (m + 2) σ' α ((4 * (q : ℝ))⁻¹) e_X →
    IsStripJetPerturb (m + 2) σ' α ((4 * (q : ℝ))⁻¹) τ_T →
    let X : ℂ → ℂ := fun z => z + (ρ : ℂ) + e_X z
    let T : ℂ → ℂ := fun z => ((2 * Real.pi / (q : ℝ) : ℝ) : ℂ) + τ_T z
    let μ : ℂ → ℂ := midCanon_C W ρ q e_X τ_T
    DifferentiableOn ℂ μ (horizStrip σ') ∧
    (∀ z ∈ horizStrip σ', μ z ∈ horizStrip σ) ∧
    (∀ z ∈ horizStrip σ', μ (z + 2 * Real.pi) = μ z + 2 * Real.pi) ∧
    (∀ z ∈ horizStrip σ', μ (starRingEnd ℂ z) = starRingEnd ℂ (μ z)) ∧
    (∀ x : ℝ, μ x = (midpoint_ℝ w (X x).re ((X x).re + (T x).re) : ℂ)) ∧
    (∀ k : ℕ, k ≤ m + 2 → ∀ z ∈ horizStrip σ',
      (q : ℝ) ^ 2 * ‖iteratedDeriv k (fun ζ => μ ζ - (X ζ + T ζ / 2)) z‖ ≤ C_mid_C)
  midpoint_lip : ∀ (σ σ' α ρ Δe Δτ : ℝ) (q : ℕ) (w₁ w₂ : ℝ → ℝ)
      (W₁ W₂ e_X₁ τ_T₁ e_X₂ τ_T₂ : ℂ → ℂ),
    σ ∈ Set.Ioc (0 : ℝ) 1 →
    N_mid ≤ q →
    α ∈ Set.Icc (0 : ℝ) (1 / 16) →
    0 < σ' →
    σ' ≤ (1 - 6 * α - K_mid / (q : ℝ) ^ 2) * σ →
    0 ≤ Δe →
    0 ≤ Δτ →
    IsPeriodicSmoothBounded (m + 15) M₁ w₁ →
    IsPeriodicSmoothBounded (m + 15) M₁ w₂ →
    IsBoundedStripExt (m + 15) σ M₁ w₁ W₁ →
    IsBoundedStripExt (m + 15) σ M₁ w₂ W₂ →
    IsStripJetPerturb (m + 2) σ' α ((4 * (q : ℝ))⁻¹) e_X₁ →
    IsStripJetPerturb (m + 2) σ' α ((4 * (q : ℝ))⁻¹) τ_T₁ →
    IsStripJetPerturb (m + 2) σ' α ((4 * (q : ℝ))⁻¹) e_X₂ →
    IsStripJetPerturb (m + 2) σ' α ((4 * (q : ℝ))⁻¹) τ_T₂ →
    (∀ k : ℕ, k ≤ m + 2 → ∀ z ∈ horizStrip σ',
      ‖iteratedDeriv k (fun ζ => e_X₁ ζ - e_X₂ ζ) z‖ ≤ Δe) →
    (∀ k : ℕ, k ≤ m + 2 → ∀ z ∈ horizStrip σ',
      ‖iteratedDeriv k (fun ζ => τ_T₁ ζ - τ_T₂ ζ) z‖ ≤ Δτ) →
    let X₁ : ℂ → ℂ := fun z => z + (ρ : ℂ) + e_X₁ z
    let T₁ : ℂ → ℂ := fun z => ((2 * Real.pi / (q : ℝ) : ℝ) : ℂ) + τ_T₁ z
    let μ₁ : ℂ → ℂ := midCanon_C W₁ ρ q e_X₁ τ_T₁
    let X₂ : ℂ → ℂ := fun z => z + (ρ : ℂ) + e_X₂ z
    let T₂ : ℂ → ℂ := fun z => ((2 * Real.pi / (q : ℝ) : ℝ) : ℂ) + τ_T₂ z
    let μ₂ : ℂ → ℂ := midCanon_C W₂ ρ q e_X₂ τ_T₂
    ∀ k : ℕ, k ≤ m + 2 → ∀ z ∈ horizStrip σ',
      (q : ℝ) ^ 2 *
        ‖iteratedDeriv k
          (fun ζ => (μ₁ ζ - (X₁ ζ + T₁ ζ / 2)) - (μ₂ ζ - (X₂ ζ + T₂ ζ / 2))) z‖ ≤
        C_mid_C * (Δe + (q : ℝ) * Δτ + stripDiffSup (m + 15) σ W₁ W₂)
  zeta_props : ∀ (σ σ' α ρ c_T : ℝ) (q : ℕ) (w : ℝ → ℝ) (W e_X τ_T : ℂ → ℂ),
    σ ∈ Set.Ioc (0 : ℝ) 1 →
    N_mid ≤ q →
    α ∈ Set.Icc (0 : ℝ) (1 / 16) →
    0 < σ' →
    σ' ≤ (1 - 6 * α - K_mid / (q : ℝ) ^ 2) * σ →
    |c_T| ≤ 2 * Real.pi / (q : ℝ) →
    IsPeriodicSmoothBounded (m + 15) M₁ w →
    IsBoundedStripExt (m + 15) σ M₁ w W →
    IsStripJetPerturb (m + 2) σ' α ((4 * (q : ℝ))⁻¹) e_X →
    IsStripJetPerturb (m + 2) σ' α ((4 * (q : ℝ))⁻¹) τ_T →
    let X : ℂ → ℂ := fun z => z + (ρ : ℂ) + e_X z
    let T : ℂ → ℂ := fun z => (c_T : ℂ) + τ_T z
    IsStripHoloSymBounded (m + 2) σ' (C_zeta / (q : ℝ)) (zetaLim_C W X T) ∧
    ∀ z ∈ horizStrip σ', zetaLim_C W X T z = midStepOp_C W (X z) (T z) (zetaLim_C W X T z)
  zeta_lip : ∀ (σ σ' α ρ c_T Δe Δτ : ℝ) (q : ℕ) (w₁ w₂ : ℝ → ℝ)
      (W₁ W₂ e_X₁ τ_T₁ e_X₂ τ_T₂ : ℂ → ℂ),
    σ ∈ Set.Ioc (0 : ℝ) 1 →
    N_mid ≤ q →
    α ∈ Set.Icc (0 : ℝ) (1 / 16) →
    0 < σ' →
    σ' ≤ (1 - 6 * α - K_mid / (q : ℝ) ^ 2) * σ →
    |c_T| ≤ 2 * Real.pi / (q : ℝ) →
    0 ≤ Δe →
    0 ≤ Δτ →
    IsPeriodicSmoothBounded (m + 15) M₁ w₁ →
    IsPeriodicSmoothBounded (m + 15) M₁ w₂ →
    IsBoundedStripExt (m + 15) σ M₁ w₁ W₁ →
    IsBoundedStripExt (m + 15) σ M₁ w₂ W₂ →
    IsStripJetPerturb (m + 2) σ' α ((4 * (q : ℝ))⁻¹) e_X₁ →
    IsStripJetPerturb (m + 2) σ' α ((4 * (q : ℝ))⁻¹) τ_T₁ →
    IsStripJetPerturb (m + 2) σ' α ((4 * (q : ℝ))⁻¹) e_X₂ →
    IsStripJetPerturb (m + 2) σ' α ((4 * (q : ℝ))⁻¹) τ_T₂ →
    (∀ k : ℕ, k ≤ m + 2 → ∀ z ∈ horizStrip σ',
      ‖iteratedDeriv k (fun ζ => e_X₁ ζ - e_X₂ ζ) z‖ ≤ Δe) →
    (∀ k : ℕ, k ≤ m + 2 → ∀ z ∈ horizStrip σ',
      ‖iteratedDeriv k (fun ζ => τ_T₁ ζ - τ_T₂ ζ) z‖ ≤ Δτ) →
    let X₁ : ℂ → ℂ := fun z => z + (ρ : ℂ) + e_X₁ z
    let T₁ : ℂ → ℂ := fun z => (c_T : ℂ) + τ_T₁ z
    let X₂ : ℂ → ℂ := fun z => z + (ρ : ℂ) + e_X₂ z
    let T₂ : ℂ → ℂ := fun z => (c_T : ℂ) + τ_T₂ z
    IsStripBounded (m + 2) σ'
      (C_zeta * (Δe + Δτ + stripDiffSup (m + 15) σ W₁ W₂))
      (fun z => zetaLim_C W₁ X₁ T₁ z - zetaLim_C W₂ X₂ T₂ z)

structure StripJetCompSystem (m : ℕ) (M₁ C_zeta : ℝ) where
  C_jet_raw : ℝ
  K_jet : ℝ
  N_jet : ℕ
  C_jet_raw_pos : 0 < C_jet_raw
  K_jet_pos : 0 < K_jet
  N_jet_ge_four : 4 ≤ N_jet
  jet_comp_props : ∀ (σ σ' α ρ c_T : ℝ) (q : ℕ) (w : ℝ → ℝ) (W e_X τ_T ζ : ℂ → ℂ),
    σ ∈ Set.Ioc (0 : ℝ) 1 →
    N_jet ≤ q →
    α ∈ Set.Icc (0 : ℝ) (1 / 16) →
    0 < σ' →
    σ' ≤ (1 - 6 * α - K_jet / (q : ℝ) ^ 2) * σ →
    |c_T| ≤ 2 * Real.pi / (q : ℝ) →
    IsPeriodicSmoothBounded (m + 15) M₁ w →
    IsBoundedStripExt (m + 15) σ M₁ w W →
    IsStripJetPerturb (m + 2) σ' α ((4 * (q : ℝ))⁻¹) e_X →
    IsStripJetPerturb (m + 2) σ' α ((4 * (q : ℝ))⁻¹) τ_T →
    IsStripHoloSymBounded (m + 2) σ' (C_zeta / (q : ℝ)) ζ →
    let X : ℂ → ℂ := fun z => z + (ρ : ℂ) + e_X z
    let T : ℂ → ℂ := fun z => (c_T : ℂ) + τ_T z
    (∀ z ∈ horizStrip σ', mFactor_C W (X z) (T z) ((1 / 2 : ℂ) + ζ z) ≠ 0) ∧
    IsStripHoloSymBounded (m + 2) σ' C_jet_raw (fun z => aCanon_C W (X z)) ∧
    IsStripHoloSymBounded (m + 2) σ' C_jet_raw
      (fun z => bPoint_C W (X z) (T z) ((1 / 2 : ℂ) + ζ z))
  jet_comp_lip : ∀ (σ σ' α ρ c_T Δe Δτ Δζ : ℝ) (q : ℕ) (w₁ w₂ : ℝ → ℝ)
      (W₁ W₂ e_X₁ τ_T₁ ζ₁ e_X₂ τ_T₂ ζ₂ : ℂ → ℂ),
    σ ∈ Set.Ioc (0 : ℝ) 1 →
    N_jet ≤ q →
    α ∈ Set.Icc (0 : ℝ) (1 / 16) →
    0 < σ' →
    σ' ≤ (1 - 6 * α - K_jet / (q : ℝ) ^ 2) * σ →
    |c_T| ≤ 2 * Real.pi / (q : ℝ) →
    0 ≤ Δe →
    0 ≤ Δτ →
    0 ≤ Δζ →
    IsPeriodicSmoothBounded (m + 15) M₁ w₁ →
    IsPeriodicSmoothBounded (m + 15) M₁ w₂ →
    IsBoundedStripExt (m + 15) σ M₁ w₁ W₁ →
    IsBoundedStripExt (m + 15) σ M₁ w₂ W₂ →
    IsStripJetPerturb (m + 2) σ' α ((4 * (q : ℝ))⁻¹) e_X₁ →
    IsStripJetPerturb (m + 2) σ' α ((4 * (q : ℝ))⁻¹) τ_T₁ →
    IsStripJetPerturb (m + 2) σ' α ((4 * (q : ℝ))⁻¹) e_X₂ →
    IsStripJetPerturb (m + 2) σ' α ((4 * (q : ℝ))⁻¹) τ_T₂ →
    IsStripHoloSymBounded (m + 2) σ' (C_zeta / (q : ℝ)) ζ₁ →
    IsStripHoloSymBounded (m + 2) σ' (C_zeta / (q : ℝ)) ζ₂ →
    (∀ k : ℕ, k ≤ m + 2 → ∀ z ∈ horizStrip σ',
      ‖iteratedDeriv k (fun w => e_X₁ w - e_X₂ w) z‖ ≤ Δe) →
    (∀ k : ℕ, k ≤ m + 2 → ∀ z ∈ horizStrip σ',
      ‖iteratedDeriv k (fun w => τ_T₁ w - τ_T₂ w) z‖ ≤ Δτ) →
    IsStripBounded (m + 2) σ' Δζ (fun w => ζ₁ w - ζ₂ w) →
    let X₁ : ℂ → ℂ := fun z => z + (ρ : ℂ) + e_X₁ z
    let T₁ : ℂ → ℂ := fun z => (c_T : ℂ) + τ_T₁ z
    let X₂ : ℂ → ℂ := fun z => z + (ρ : ℂ) + e_X₂ z
    let T₂ : ℂ → ℂ := fun z => (c_T : ℂ) + τ_T₂ z
    (∀ k : ℕ, k ≤ m + 2 → ∀ z ∈ horizStrip σ',
      ‖iteratedDeriv k (fun w => aCanon_C W₁ (X₁ w) - aCanon_C W₂ (X₂ w)) z‖ ≤
        C_jet_raw * (Δe + stripDiffSup (m + 15) σ W₁ W₂)) ∧
    (∀ k : ℕ, k ≤ m + 2 → ∀ z ∈ horizStrip σ',
      ‖iteratedDeriv k
        (fun w =>
          bPoint_C W₁ (X₁ w) (T₁ w) ((1 / 2 : ℂ) + ζ₁ w) -
            bPoint_C W₂ (X₂ w) (T₂ w) ((1 / 2 : ℂ) + ζ₂ w)) z‖ ≤
        C_jet_raw * (Δe + Δτ + Δζ + stripDiffSup (m + 15) σ W₁ W₂))
noncomputable def realJetA (w : ℝ → ℝ) (X : ℝ) : ℝ :=
  (7 * iteratedDeriv 2 w X - 8 * (iteratedDeriv 1 w X) ^ 2 - Real.exp (2 * w X)) / 384

noncomputable def realActE (w : ℝ → ℝ) (X u : ℝ) : ℕ → ℝ
  | 0 =>
      let μ := midpoint_ℝ w X (X + u)
      Real.exp (2 * w X + w (X + u) - 3 * w μ)
  | 1 =>
      let μ := midpoint_ℝ w X (X + u)
      let μ₁ := (1 / 2 : ℝ) * Real.exp (w (X + u) - w μ)
      let L₀ := 2 * w X + w (X + u) - 3 * w μ
      let L₁ := iteratedDeriv 1 w (X + u) - 3 * iteratedDeriv 1 w μ * μ₁
      L₁ * Real.exp L₀
  | 2 =>
      let μ := midpoint_ℝ w X (X + u)
      let μ₁ := (1 / 2 : ℝ) * Real.exp (w (X + u) - w μ)
      let w₁_u := iteratedDeriv 1 w (X + u)
      let w₁_μ := iteratedDeriv 1 w μ
      let μ₂ := μ₁ * (w₁_u - w₁_μ * μ₁)
      let L₀ := 2 * w X + w (X + u) - 3 * w μ
      let L₁ := w₁_u - 3 * w₁_μ * μ₁
      let L₂ := iteratedDeriv 2 w (X + u) - 3 * iteratedDeriv 2 w μ * μ₁ ^ 2 - 3 * w₁_μ * μ₂
      (L₂ + L₁ ^ 2) * Real.exp L₀
  | 3 =>
      let μ := midpoint_ℝ w X (X + u)
      let μ₁ := (1 / 2 : ℝ) * Real.exp (w (X + u) - w μ)
      let w₁_u := iteratedDeriv 1 w (X + u)
      let w₂_u := iteratedDeriv 2 w (X + u)
      let w₃_u := iteratedDeriv 3 w (X + u)
      let w₁_μ := iteratedDeriv 1 w μ
      let w₂_μ := iteratedDeriv 2 w μ
      let w₃_μ := iteratedDeriv 3 w μ
      let μ₂ := μ₁ * (w₁_u - w₁_μ * μ₁)
      let μ₃ := μ₂ * (w₁_u - w₁_μ * μ₁) + μ₁ * (w₂_u - w₂_μ * μ₁ ^ 2 - w₁_μ * μ₂)
      let L₀ := 2 * w X + w (X + u) - 3 * w μ
      let L₁ := w₁_u - 3 * w₁_μ * μ₁
      let L₂ := w₂_u - 3 * w₂_μ * μ₁ ^ 2 - 3 * w₁_μ * μ₂
      let L₃ := w₃_u - 3 * w₃_μ * μ₁ ^ 3 - 9 * w₂_μ * μ₁ * μ₂ - 3 * w₁_μ * μ₃
      (L₃ + 3 * L₁ * L₂ + L₁ ^ 3) * Real.exp L₀
  | _ + 4 => 0

noncomputable def realActG (w : ℝ → ℝ) (X u : ℝ) : ℕ → ℝ
  | 0 => ∫ s in (0 : ℝ)..1, Real.exp (w (X + s * u) - w X)
  | 1 => ∫ s in (0 : ℝ)..1,
      s * (iteratedDeriv 1 w (X + s * u) * Real.exp (w (X + s * u) - w X))
  | 2 => ∫ s in (0 : ℝ)..1,
      s ^ 2 * ((iteratedDeriv 2 w (X + s * u) + (iteratedDeriv 1 w (X + s * u)) ^ 2) *
        Real.exp (w (X + s * u) - w X))
  | 3 => ∫ s in (0 : ℝ)..1,
      s ^ 3 * ((iteratedDeriv 3 w (X + s * u) +
        3 * iteratedDeriv 1 w (X + s * u) * iteratedDeriv 2 w (X + s * u) +
        (iteratedDeriv 1 w (X + s * u)) ^ 3) * Real.exp (w (X + s * u) - w X))
  | _ + 4 => 0

noncomputable def realActS (w : ℝ → ℝ) (X u : ℝ) : ℕ → ℝ
  | 0 =>
      let ψ₀ := (1 / 2 : ℝ) * u * Real.exp (w X) * realActG w X u 0
      ∫ r in (0 : ℝ)..1, Real.cos (r * ψ₀)
  | 1 =>
      let ψ₀ := (1 / 2 : ℝ) * u * Real.exp (w X) * realActG w X u 0
      let ψ₁ := (1 / 2 : ℝ) * Real.exp (w (X + u))
      let sc₁ := ∫ r in (0 : ℝ)..1, -(r * Real.sin (r * ψ₀))
      sc₁ * ψ₁
  | 2 =>
      let ψ₀ := (1 / 2 : ℝ) * u * Real.exp (w X) * realActG w X u 0
      let e_u := Real.exp (w (X + u))
      let ψ₁ := (1 / 2 : ℝ) * e_u
      let ψ₂ := (1 / 2 : ℝ) * iteratedDeriv 1 w (X + u) * e_u
      let sc₁ := ∫ r in (0 : ℝ)..1, -(r * Real.sin (r * ψ₀))
      let sc₂ := ∫ r in (0 : ℝ)..1, -(r ^ 2 * Real.cos (r * ψ₀))
      sc₂ * ψ₁ ^ 2 + sc₁ * ψ₂
  | 3 =>
      let ψ₀ := (1 / 2 : ℝ) * u * Real.exp (w X) * realActG w X u 0
      let e_u := Real.exp (w (X + u))
      let w₁_u := iteratedDeriv 1 w (X + u)
      let w₂_u := iteratedDeriv 2 w (X + u)
      let ψ₁ := (1 / 2 : ℝ) * e_u
      let ψ₂ := (1 / 2 : ℝ) * w₁_u * e_u
      let ψ₃ := (1 / 2 : ℝ) * (w₂_u + w₁_u ^ 2) * e_u
      let sc₁ := ∫ r in (0 : ℝ)..1, -(r * Real.sin (r * ψ₀))
      let sc₂ := ∫ r in (0 : ℝ)..1, -(r ^ 2 * Real.cos (r * ψ₀))
      let sc₃ := ∫ r in (0 : ℝ)..1, r ^ 3 * Real.sin (r * ψ₀)
      sc₃ * ψ₁ ^ 3 + 3 * sc₂ * ψ₁ * ψ₂ + sc₁ * ψ₃
  | _ + 4 => 0

noncomputable def realActionH0 (w : ℝ → ℝ) (X u : ℝ) : ℝ :=
  (1 / 4 : ℝ) * (realActE w X u 0 * realActG w X u 0 * realActS w X u 0)

noncomputable def realActionH3 (w : ℝ → ℝ) (X u : ℝ) : ℝ :=
  let E := realActE w X u
  let G := realActG w X u
  let S := realActS w X u
  (1 / 4 : ℝ) *
    (E 3 * G 0 * S 0 + E 0 * G 3 * S 0 + E 0 * G 0 * S 3 +
      3 * (E 2 * G 1 * S 0 + E 2 * G 0 * S 1 + E 1 * G 2 * S 0 +
        E 0 * G 2 * S 1 + E 1 * G 0 * S 2 + E 0 * G 1 * S 2) +
      6 * (E 1 * G 1 * S 1))

noncomputable def realJetB (w : ℝ → ℝ) (X T : ℝ) : ℝ :=
  (1 / 2 : ℝ) * ∫ r in (0 : ℝ)..1, r ^ 4 *
    (∫ τ in (0 : ℝ)..1, (1 - τ) ^ 2 * realActionH3 w X (τ * r * T))

noncomputable def realMidpointDispU (w : ℝ → ℝ) (X T : ℝ → ℝ) (u_param x : ℝ) : ℝ :=
  midpoint_ℝ w (X x) (X x + u_param * T x) - (X x + u_param * T x / 2)

structure RealActionTaylorData (m : ℕ) (M₁ : ℝ) where
  primPhi_hasDerivAt : ∀ (w : ℝ → ℝ),
    IsPeriodicSmoothBounded (m + 15) M₁ w →
    ∀ z : ℝ, HasDerivAt (primPhi_ℝ w) (Real.exp (w z)) z
  primPhi_strictMono : ∀ (w : ℝ → ℝ),
    IsPeriodicSmoothBounded (m + 15) M₁ w →
    StrictMono (primPhi_ℝ w)
  primPhi_contDiff : ∀ (w : ℝ → ℝ),
    IsPeriodicSmoothBounded (m + 15) M₁ w →
    ContDiff ℝ ((m + 16 : ℕ) : WithTop ℕ∞) (primPhi_ℝ w)
  invPrimPhi_contDiff : ∀ (w : ℝ → ℝ),
    IsPeriodicSmoothBounded (m + 15) M₁ w →
    ContDiff ℝ ((m + 16 : ℕ) : WithTop ℕ∞) (Function.invFun (primPhi_ℝ w))
  invPrimPhi_hasDerivAt : ∀ (w : ℝ → ℝ),
    IsPeriodicSmoothBounded (m + 15) M₁ w →
    ∀ y : ℝ, HasDerivAt (Function.invFun (primPhi_ℝ w))
      (Real.exp (-w (Function.invFun (primPhi_ℝ w) y))) y
  midpoint_eq : ∀ (w : ℝ → ℝ),
    IsPeriodicSmoothBounded (m + 15) M₁ w →
    ∀ X Y : ℝ, primPhi_ℝ w (midpoint_ℝ w X Y) = (primPhi_ℝ w X + primPhi_ℝ w Y) / 2
  midpoint_diag_periodic : ∀ (w : ℝ → ℝ),
    IsPeriodicSmoothBounded (m + 15) M₁ w →
    ∀ X Y : ℝ, midpoint_ℝ w (X + 2 * Real.pi) (Y + 2 * Real.pi) =
      midpoint_ℝ w X Y + 2 * Real.pi
  action_factor : ∀ (w : ℝ → ℝ),
    IsPeriodicSmoothBounded (m + 15) M₁ w →
    ∀ X T : ℝ, normAction1_ℝ w X (X + T) =
      T ^ 2 * (1 / 8 + realJetA w X * T ^ 2 + T ^ 3 * realJetB w X T)
  diff_global_bound : ∀ (w₁ w₂ : ℝ → ℝ),
    IsPeriodicSmoothBounded (m + 15) M₁ w₁ →
    IsPeriodicSmoothBounded (m + 15) M₁ w₂ →
    0 ≤ realDiffSup (m + 15) w₁ w₂ ∧
    ∀ j : ℕ, j ≤ m + 15 → ∀ z : ℝ,
      |iteratedDeriv j (fun y => w₁ y - w₂ y) z| ≤ realDiffSup (m + 15) w₁ w₂

structure RealMidpointDispData (m : ℕ) (M₁ : ℝ) where
  C_mid_R : ℝ
  N_mid : ℕ
  C_mid_R_pos : 0 < C_mid_R
  N_mid_ge_four : 4 ≤ N_mid
  midpoint_u_props : ∀ (q : ℕ) (ρ c_T : ℝ) (w e_X τ_T : ℝ → ℝ),
    N_mid ≤ q →
    |c_T| ≤ 2 * Real.pi / (q : ℝ) →
    IsPeriodicSmoothBounded (m + 15) M₁ w →
    IsRealJetPerturb (m + 2) ((4 * (q : ℝ))⁻¹) e_X →
    IsRealJetPerturb (m + 2) ((4 * (q : ℝ))⁻¹) τ_T →
    let X : ℝ → ℝ := fun x => x + ρ + e_X x
    let T : ℝ → ℝ := fun x => c_T + τ_T x
    (∀ k : ℕ, k ≤ m + 2 →
      Continuous (fun p : ℝ × ℝ => iteratedDeriv k (realMidpointDispU w X T p.1) p.2)) ∧
    ∀ u_param ∈ Set.Icc (0 : ℝ) 1,
      Function.Periodic (realMidpointDispU w X T u_param) (2 * Real.pi) ∧
      ContDiff ℝ ((m + 2 : ℕ) : WithTop ℕ∞) (realMidpointDispU w X T u_param) ∧
      ∀ k : ℕ, k ≤ m + 2 → ∀ x : ℝ,
        (q : ℝ) ^ 2 * |iteratedDeriv k (realMidpointDispU w X T u_param) x| ≤ C_mid_R
  midpoint_u_lip : ∀ (q : ℕ) (ρ c_T Δe Δτ u_param : ℝ) (w₁ w₂ : ℝ → ℝ)
      (e_X₁ τ_T₁ e_X₂ τ_T₂ : ℝ → ℝ),
    N_mid ≤ q →
    |c_T| ≤ 2 * Real.pi / (q : ℝ) →
    u_param ∈ Set.Icc (0 : ℝ) 1 →
    0 ≤ Δe →
    0 ≤ Δτ →
    IsPeriodicSmoothBounded (m + 15) M₁ w₁ →
    IsPeriodicSmoothBounded (m + 15) M₁ w₂ →
    IsRealJetPerturb (m + 2) ((4 * (q : ℝ))⁻¹) e_X₁ →
    IsRealJetPerturb (m + 2) ((4 * (q : ℝ))⁻¹) τ_T₁ →
    IsRealJetPerturb (m + 2) ((4 * (q : ℝ))⁻¹) e_X₂ →
    IsRealJetPerturb (m + 2) ((4 * (q : ℝ))⁻¹) τ_T₂ →
    (∀ k : ℕ, k ≤ m + 2 → ∀ x : ℝ, |iteratedDeriv k (fun y => e_X₁ y - e_X₂ y) x| ≤ Δe) →
    (∀ k : ℕ, k ≤ m + 2 → ∀ x : ℝ, |iteratedDeriv k (fun y => τ_T₁ y - τ_T₂ y) x| ≤ Δτ) →
    let X₁ : ℝ → ℝ := fun x => x + ρ + e_X₁ x
    let T₁ : ℝ → ℝ := fun x => c_T + τ_T₁ x
    let X₂ : ℝ → ℝ := fun x => x + ρ + e_X₂ x
    let T₂ : ℝ → ℝ := fun x => c_T + τ_T₂ x
    ∀ k : ℕ, k ≤ m + 2 → ∀ x : ℝ,
      (q : ℝ) ^ 2 *
        |iteratedDeriv k
          (fun y =>
            realMidpointDispU w₁ X₁ T₁ u_param y -
              realMidpointDispU w₂ X₂ T₂ u_param y) x| ≤
        C_mid_R * (Δe + (q : ℝ) * Δτ + realDiffSup (m + 15) w₁ w₂)

structure RealActionJetCompData (m : ℕ) (M₁ : ℝ) where
  C_jet_R : ℝ
  B₀_jet : ℝ
  L₀_jet : ℝ
  N_jet : ℕ
  C_jet_R_pos : 0 < C_jet_R
  B₀_jet_pos : 0 < B₀_jet
  L₀_jet_pos : 0 < L₀_jet
  N_jet_ge_four : 4 ≤ N_jet
  jet_pt_bounds : ∀ (w : ℝ → ℝ),
    IsPeriodicSmoothBounded (m + 15) M₁ w →
    ∀ X₁ X₂ T₁ T₂ : ℝ, |T₁| ≤ 2 → |T₂| ≤ 2 →
      |realJetA w X₁| ≤ B₀_jet ∧
      |realJetB w X₁ T₁| ≤ B₀_jet ∧
      |realJetA w X₁ - realJetA w X₂| ≤ L₀_jet * |X₁ - X₂| ∧
      |realJetB w X₁ T₁ - realJetB w X₂ T₂| ≤ L₀_jet * (|X₁ - X₂| + |T₁ - T₂|)
  jet_props : ∀ (q : ℕ) (ρ sgn : ℝ) (w : ℝ → ℝ) (e_X τ_T : ℝ → ℝ),
    N_jet ≤ q →
    (sgn = 1 ∨ sgn = -1) →
    IsPeriodicSmoothBounded (m + 15) M₁ w →
    IsRealJetPerturb (m + 2) ((4 * (q : ℝ))⁻¹) e_X →
    IsRealJetPerturb (m + 2) ((4 * (q : ℝ))⁻¹) τ_T →
    let X : ℝ → ℝ := fun x => x + ρ + e_X x
    let T : ℝ → ℝ := fun x => sgn * (2 * Real.pi / (q : ℝ)) + τ_T x
    IsRealJetPerturb (m + 2) C_jet_R (fun x => realJetA w (X x)) ∧
    IsRealJetPerturb (m + 2) C_jet_R (fun x => realJetB w (X x) (T x))
  jet_lip : ∀ (q : ℕ) (ρ sgn Δe Δτ : ℝ) (w₁ w₂ : ℝ → ℝ)
      (e_X₁ τ_T₁ e_X₂ τ_T₂ : ℝ → ℝ),
    N_jet ≤ q →
    (sgn = 1 ∨ sgn = -1) →
    0 ≤ Δe →
    0 ≤ Δτ →
    IsPeriodicSmoothBounded (m + 15) M₁ w₁ →
    IsPeriodicSmoothBounded (m + 15) M₁ w₂ →
    IsRealJetPerturb (m + 2) ((4 * (q : ℝ))⁻¹) e_X₁ →
    IsRealJetPerturb (m + 2) ((4 * (q : ℝ))⁻¹) τ_T₁ →
    IsRealJetPerturb (m + 2) ((4 * (q : ℝ))⁻¹) e_X₂ →
    IsRealJetPerturb (m + 2) ((4 * (q : ℝ))⁻¹) τ_T₂ →
    (∀ k : ℕ, k ≤ m + 2 → ∀ x : ℝ, |iteratedDeriv k (fun y => e_X₁ y - e_X₂ y) x| ≤ Δe) →
    (∀ k : ℕ, k ≤ m + 2 → ∀ x : ℝ, |iteratedDeriv k (fun y => τ_T₁ y - τ_T₂ y) x| ≤ Δτ) →
    let X₁ : ℝ → ℝ := fun x => x + ρ + e_X₁ x
    let T₁ : ℝ → ℝ := fun x => sgn * (2 * Real.pi / (q : ℝ)) + τ_T₁ x
    let X₂ : ℝ → ℝ := fun x => x + ρ + e_X₂ x
    let T₂ : ℝ → ℝ := fun x => sgn * (2 * Real.pi / (q : ℝ)) + τ_T₂ x
    (∀ k : ℕ, k ≤ m + 2 → ∀ x : ℝ,
      |iteratedDeriv k (fun y => realJetA w₁ (X₁ y) - realJetA w₂ (X₂ y)) x| ≤
        C_jet_R * (Δe + realDiffSup (m + 15) w₁ w₂)) ∧
    (∀ k : ℕ, k ≤ m + 2 → ∀ x : ℝ,
      |iteratedDeriv k (fun y => realJetB w₁ (X₁ y) (T₁ y) - realJetB w₂ (X₂ y) (T₂ y)) x| ≤
        C_jet_R * (Δe + Δτ + realDiffSup (m + 15) w₁ w₂))
def pointChainBox {Ω : Set Plane} (C : AnalyticGlancingCollar Ω)
    (B : BaseCollarAndCramerData C) (k : ℕ) : Set (ℂ × ℂ) :=
  { p : ℂ × ℂ | |p.1.im| < B.s_det ∧ ‖p.2‖ < B.r_det / ((k : ℝ) + 1) }

abbrev PointJetAll : Type := Sum (Fin 2 × Fin 2 × ℕ × ℕ) ℕ

def pointJetEmb (M : ℕ) : PointJetVar M → PointJetAll
  | Sum.inl v => Sum.inl (v.1, v.2.1, v.2.2.1.1, v.2.2.2.1)
  | Sum.inr β => Sum.inr β.1

noncomputable def pointJetFnAll {Ω : Set Plane} (C : AnalyticGlancingCollar Ω) (k : ℕ) :
    PointJetAll → ℂ × ℂ → ℂ
  | Sum.inl v =>
      if v.1 = 0 then
        iterDerivYT v.2.2.1 v.2.2.2 (fun q => glancingImpact C q.1 q.2 v.2.1)
      else
        iterDerivYT v.2.2.1 v.2.2.2 (fun q => glancingImpact C (q.1 + (k : ℂ) * q.2) q.2 v.2.1)
  | Sum.inr β =>
      fun p => iterDeriv1D β C.A p.2

noncomputable def pointBaseField {Ω : Set Plane} (C : AnalyticGlancingCollar Ω) (k : ℕ)
    (Ψ : ℂ × ℂ → ℂ × ℂ) (a₁ δ₁ : ℝ) : Subfield ℂ :=
  Subfield.closure
    (((⊥ : Subfield ℂ) : Set ℂ) ∪
      Set.range (fun v : PointJetAll => pointJetFnAll C k v (Ψ ((a₁ : ℂ), (δ₁ : ℂ)))))

def rotCoordX (rotIdx : Fin 4) (P : Fin 2 → ℂ) : ℂ :=
  match rotIdx with
  | ⟨0, _⟩ => P 0
  | ⟨1, _⟩ => -P 0
  | ⟨2, _⟩ => P 1
  | ⟨3, _⟩ => -P 1

def rotCoordY (rotIdx : Fin 4) (P : Fin 2 → ℂ) : ℂ :=
  match rotIdx with
  | ⟨0, _⟩ => P 1
  | ⟨1, _⟩ => -P 1
  | ⟨2, _⟩ => -P 0
  | ⟨3, _⟩ => P 0

def unrotPoint (rotIdx : Fin 4) (x Y : ℂ) : Fin 2 → ℂ :=
  match rotIdx with
  | ⟨0, _⟩ => ![x, Y]
  | ⟨1, _⟩ => ![-x, -Y]
  | ⟨2, _⟩ => ![-Y, x]
  | ⟨3, _⟩ => ![Y, -x]

noncomputable def sqrt1p (u : ℂ) : ℂ :=
  Complex.exp (Complex.log (1 + u) / 2)

noncomputable def pointEdgeSq {k : ℕ} (F_vec : Fin (k + 1) → ℂ → ℂ)
    (x_vec : Fin (k + 1) → ℂ) (i : Fin k) : ℂ :=
  (x_vec i.succ - x_vec i.castSucc) ^ 2 +
    (F_vec i.succ (x_vec i.succ) - F_vec i.castSucc (x_vec i.castSucc)) ^ 2

noncomputable def pointRelEdgeLen {k : ℕ} (ℓ_base : Fin k → ℂ)
    (F_vec : Fin (k + 1) → ℂ → ℂ) (x_vec : Fin (k + 1) → ℂ) (i : Fin k) : ℂ :=
  ℓ_base i * sqrt1p ((pointEdgeSq F_vec x_vec i - (ℓ_base i) ^ 2) / (ℓ_base i) ^ 2)

noncomputable def pointRelChainLen {k : ℕ} (ℓ_base : Fin k → ℂ)
    (F_vec : Fin (k + 1) → ℂ → ℂ) (x_vec : Fin (k + 1) → ℂ) : ℂ :=
  ∑ i : Fin k, pointRelEdgeLen ℓ_base F_vec x_vec i

noncomputable def pointRelInteriorGrad {k : ℕ} (ℓ_base : Fin k → ℂ)
    (F_vec F'_vec : Fin (k + 1) → ℂ → ℂ) (x_vec : Fin (k + 1) → ℂ)
    (r : Fin (k - 1)) : ℂ :=
  let i_L : Fin k := ⟨r.1, by have := r.2; omega⟩
  let i_R : Fin k := ⟨r.1 + 1, by have := r.2; omega⟩
  let L_L := pointRelEdgeLen ℓ_base F_vec x_vec i_L
  let L_R := pointRelEdgeLen ℓ_base F_vec x_vec i_R
  ((x_vec i_L.succ - x_vec i_L.castSucc) +
      (F_vec i_L.succ (x_vec i_L.succ) - F_vec i_L.castSucc (x_vec i_L.castSucc)) *
        F'_vec i_L.succ (x_vec i_L.succ)) / L_L -
    ((x_vec i_R.succ - x_vec i_R.castSucc) +
      (F_vec i_R.succ (x_vec i_R.succ) - F_vec i_R.castSucc (x_vec i_R.castSucc)) *
        F'_vec i_R.castSucc (x_vec i_R.castSucc)) / L_R

noncomputable def pointInteriorHess {k : ℕ} (ℓ_base : Fin k → ℂ)
    (F F' F'' : ℂ → ℂ) (x_vec : Fin (k + 1) → ℂ) :
    Matrix (Fin (k - 1)) (Fin (k - 1)) ℂ :=
  fun r s =>
    let i_L : Fin k := ⟨r.1, by have := r.2; omega⟩
    let i_R : Fin k := ⟨r.1 + 1, by have := r.2; omega⟩
    let Δx_L := x_vec i_L.succ - x_vec i_L.castSucc
    let ΔY_L := F (x_vec i_L.succ) - F (x_vec i_L.castSucc)
    let L_L := ℓ_base i_L
    let n_L_succ := Δx_L + ΔY_L * F' (x_vec i_L.succ)
    let n_L_cast := Δx_L + ΔY_L * F' (x_vec i_L.castSucc)
    let Δx_R := x_vec i_R.succ - x_vec i_R.castSucc
    let ΔY_R := F (x_vec i_R.succ) - F (x_vec i_R.castSucc)
    let L_R := ℓ_base i_R
    let n_R_cast := Δx_R + ΔY_R * F' (x_vec i_R.castSucc)
    let n_R_succ := Δx_R + ΔY_R * F' (x_vec i_R.succ)
    if r.1 = s.1 then
      (((1 + F' (x_vec i_L.succ) ^ 2 + ΔY_L * F'' (x_vec i_L.succ)) * L_L ^ 2 -
          n_L_succ ^ 2) / L_L ^ 3) +
      (((1 + F' (x_vec i_R.castSucc) ^ 2 - ΔY_R * F'' (x_vec i_R.castSucc)) * L_R ^ 2 -
          n_R_cast ^ 2) / L_R ^ 3)
    else if s.1 = r.1 + 1 then
      ((-1 - F' (x_vec i_R.succ) * F' (x_vec i_R.castSucc)) * L_R ^ 2 +
        n_R_cast * n_R_succ) / L_R ^ 3
    else if r.1 = s.1 + 1 then
      ((-1 - F' (x_vec i_L.castSucc) * F' (x_vec i_L.succ)) * L_L ^ 2 +
        n_L_succ * n_L_cast) / L_L ^ 3
    else
      0

noncomputable def pointChartACoord {Ω : Set Plane} (C : AnalyticGlancingCollar Ω)
    (rotIdx : Fin 4) (p : ℂ × ℂ) : ℂ :=
  rotCoordX rotIdx (glancingImpact C p.1 p.2)

noncomputable def pointChartBCoord {Ω : Set Plane} (C : AnalyticGlancingCollar Ω) (k : ℕ)
    (rotIdx : Fin 4) (p : ℂ × ℂ) : ℂ :=
  rotCoordX rotIdx (glancingImpact C (p.1 + (k : ℂ) * p.2) p.2)

noncomputable def pointChartDetAB {Ω : Set Plane} (C : AnalyticGlancingCollar Ω) (k : ℕ)
    (rotIdx : Fin 4) (p : ℂ × ℂ) : ℂ :=
  iterDerivYT 1 0 (pointChartACoord C rotIdx) p *
      iterDerivYT 0 1 (pointChartBCoord C k rotIdx) p -
    iterDerivYT 0 1 (pointChartACoord C rotIdx) p *
      iterDerivYT 1 0 (pointChartBCoord C k rotIdx) p

noncomputable def pointChartX {Ω : Set Plane} (C : AnalyticGlancingCollar Ω) (k : ℕ)
    (rotIdx : Fin 4) (Ψ : ℂ × ℂ → ℂ × ℂ) (r : Fin (k + 1)) (q : ℂ × ℂ) : ℂ :=
  rotCoordX rotIdx (glancingImpact C ((Ψ q).1 + ((r : ℕ) : ℂ) * (Ψ q).2) (Ψ q).2)

noncomputable def pointChartAction {k : ℕ} (ℓ_fn : Fin k → ℂ × ℂ → ℂ) (q : ℂ × ℂ) : ℂ :=
  ∑ i : Fin k, ℓ_fn i q

noncomputable def pointChartActionAB {k : ℕ} (ℓ_fn : Fin k → ℂ × ℂ → ℂ) (q_ab : ℂ × ℂ) : ℂ :=
  pointChartAction ℓ_fn (q_ab.1, q_ab.2 - q_ab.1)

noncomputable def pointChartPsiWeb {Ω : Set Plane} (C : AnalyticGlancingCollar Ω) (k : ℕ)
    (rotIdx : Fin 4) (Ψ : ℂ × ℂ → ℂ × ℂ) (r : Fin (k + 1)) (q : ℂ × ℂ) : ℂ :=
  if h : r.1 < k - 1 then
    pointChartX C k rotIdx Ψ ⟨r.1 + 1, by omega⟩ q
  else if r.1 = k - 1 then
    q.1
  else
    q.1 + q.2

noncomputable def pointChartWWeb {Ω : Set Plane} (C : AnalyticGlancingCollar Ω) (k : ℕ)
    (rotIdx : Fin 4) (F : ℂ → ℂ) (Ψ : ℂ × ℂ → ℂ × ℂ) (ℓ_fn : Fin k → ℂ × ℂ → ℂ)
    (r : Fin (k + 1)) (q : ℂ × ℂ) : ℂ :=
  if h : r.1 < k - 1 then
    (F (pointChartX C k rotIdx Ψ ⟨r.1 + 1, by omega⟩ q) -
        F (pointChartX C k rotIdx Ψ ⟨r.1, by omega⟩ q)) /
      ℓ_fn ⟨r.1, by omega⟩ q -
    (F (pointChartX C k rotIdx Ψ ⟨r.1 + 2, by omega⟩ q) -
        F (pointChartX C k rotIdx Ψ ⟨r.1 + 1, by omega⟩ q)) /
      ℓ_fn ⟨r.1 + 1, by omega⟩ q
  else
    -1

structure PointGlancingChartData {Ω : Set Plane} (C : AnalyticGlancingCollar Ω)
    (B : BaseCollarAndCramerData C) (k : ℕ) where
  rotIdx : Fin 4
  a₀ : ℝ
  R : ℝ
  δ_star : ℝ
  C₀ : ℝ
  R_pos : 0 < R
  δ_star_pos : 0 < δ_star
  C₀_pos : 0 < C₀
  C₀_δ_star_lt : C₀ * δ_star < R / 2
  W_F : Set ℂ
  F : ℂ → ℂ
  W_F_open : IsOpen W_F
  W_F_preconn : IsPreconnected W_F
  F_holo : DifferentiableOn ℂ F W_F
  F_real : ∀ x : ℝ, |x - a₀| < R + 2 * δ_star →
    (x : ℂ) ∈ W_F ∧ (F (x : ℂ)).im = 0
  F_curv_real : ∀ x : ℝ, |x - a₀| < R →
    deriv (deriv F) (x : ℂ) ≠ 0 ∧ ∃ v_x : ℝ, deriv F (x : ℂ) = (v_x : ℂ)
  V_W : Set (ℂ × ℂ)
  Ψ : ℂ × ℂ → ℂ × ℂ
  ℓ_fn : Fin k → ℂ × ℂ → ℂ
  V_W_open : IsOpen V_W
  V_W_nonempty : V_W.Nonempty
  V_W_sub : V_W ⊆ pointChainBox C B k
  Ψ_holo : DifferentiableOn ℂ Ψ
    (Metric.ball (a₀ : ℂ) (2 * R) ×ˢ Metric.ball (0 : ℂ) (2 * δ_star))
  Ψ_maps_V_W : ∀ q ∈ Metric.ball (a₀ : ℂ) (2 * R) ×ˢ Metric.ball (0 : ℂ) (2 * δ_star),
    Ψ q ∈ V_W
  Φ_left_inv : ∀ q ∈ Metric.ball (a₀ : ℂ) (2 * R) ×ˢ Metric.ball (0 : ℂ) (2 * δ_star),
    pointChartACoord C rotIdx (Ψ q) = q.1 ∧
    pointChartBCoord C k rotIdx (Ψ q) - pointChartACoord C rotIdx (Ψ q) = q.2
  Φ_right_inv : ∀ p ∈ V_W,
    (pointChartACoord C rotIdx p,
      pointChartBCoord C k rotIdx p - pointChartACoord C rotIdx p) ∈
      Metric.ball (a₀ : ℂ) (2 * R) ×ˢ Metric.ball (0 : ℂ) (2 * δ_star) ∧
    Ψ (pointChartACoord C rotIdx p,
      pointChartBCoord C k rotIdx p - pointChartACoord C rotIdx p) = p
  det_ab_ne_zero : ∀ p ∈ V_W, pointChartDetAB C k rotIdx p ≠ 0
  x_endpoints : ∀ q ∈ Metric.ball (a₀ : ℂ) (2 * R) ×ˢ Metric.ball (0 : ℂ) (2 * δ_star),
    pointChartX C k rotIdx Ψ 0 q = q.1 ∧
    pointChartX C k rotIdx Ψ (Fin.last k) q = q.1 + q.2
  x_holo_maps : ∀ r : Fin (k + 1),
    DifferentiableOn ℂ (pointChartX C k rotIdx Ψ r)
      (Metric.ball (a₀ : ℂ) (2 * R) ×ˢ Metric.ball (0 : ℂ) (2 * δ_star)) ∧
    ∀ q ∈ Metric.ball (a₀ : ℂ) (2 * R) ×ˢ Metric.ball (0 : ℂ) (2 * δ_star),
      pointChartX C k rotIdx Ψ r q ∈ W_F ∧
      rotCoordY rotIdx (glancingImpact C ((Ψ q).1 + ((r : ℕ) : ℂ) * (Ψ q).2) (Ψ q).2) =
        F (pointChartX C k rotIdx Ψ r q)
  ℓ_holo_sq : ∀ i : Fin k,
    DifferentiableOn ℂ (ℓ_fn i)
      (Metric.ball (a₀ : ℂ) (2 * R) ×ˢ Metric.ball (0 : ℂ) (2 * δ_star)) ∧
    ∀ q ∈ Metric.ball (a₀ : ℂ) (2 * R) ×ˢ Metric.ball (0 : ℂ) (2 * δ_star),
      (ℓ_fn i q) ^ 2 = pointEdgeSq (fun _ => F) (fun r => pointChartX C k rotIdx Ψ r q) i
  symplectic_mixed_deriv : ∀ q_ab : ℂ × ℂ,
    (q_ab.1, q_ab.2 - q_ab.1) ∈
      Metric.ball (a₀ : ℂ) (2 * R) ×ˢ Metric.ball (0 : ℂ) (2 * δ_star) →
    iterDerivYT 1 1 (pointChartActionAB ℓ_fn) q_ab =
      C.A (Ψ (q_ab.1, q_ab.2 - q_ab.1)).2 /
        pointChartDetAB C k rotIdx (Ψ (q_ab.1, q_ab.2 - q_ab.1))
  stationary_on_nondeg :
    ∀ q ∈ Metric.ball (a₀ : ℂ) (2 * R) ×ˢ Metric.ball (0 : ℂ) (2 * δ_star),
      (∀ i : Fin k, ℓ_fn i q ≠ 0) →
      ∀ r : Fin (k - 1),
        pointRelInteriorGrad (fun i => ℓ_fn i q) (fun _ => F) (fun _ => deriv F)
          (fun s => pointChartX C k rotIdx Ψ s q) r = 0
  x_at_zero : ∀ r : Fin (k + 1), ∀ a : ℝ, |a - a₀| < R →
    pointChartX C k rotIdx Ψ r ((a : ℂ), 0) = (a : ℂ) ∧
    deriv (fun z : ℂ => pointChartX C k rotIdx Ψ r ((a : ℂ), z)) 0 = ((r : ℕ) : ℂ) / (k : ℂ)
  ψ_web_base : ∀ r : Fin (k + 1), ∀ q ∈ webBaseClosure a₀ R δ_star,
    (pointChartPsiWeb C k rotIdx Ψ r ((q.1 : ℂ), (q.2 : ℂ))).im = 0 ∧
    |(pointChartPsiWeb C k rotIdx Ψ r ((q.1 : ℂ), (q.2 : ℂ))).re - q.1| ≤ C₀ * q.2 ∧
    1 / 2 ≤
      (deriv (fun z : ℂ => pointChartPsiWeb C k rotIdx Ψ r (z, (q.2 : ℂ))) (q.1 : ℂ)).re
  trapezoid_nondeg : ∀ q ∈ webTrapezoid a₀ R δ_star C₀,
    (Ψ ((q.1 : ℂ), (q.2 : ℂ))).1.im = 0 ∧
    (Ψ ((q.1 : ℂ), (q.2 : ℂ))).2.im = 0 ∧
    0 < (Ψ ((q.1 : ℂ), (q.2 : ℂ))).2.re ∧
    (Ψ ((q.1 : ℂ), (q.2 : ℂ))).2.re < B.r_det / ((k : ℝ) + 1) ∧
    (∀ r : Fin (k + 1), (pointChartX C k rotIdx Ψ r ((q.1 : ℂ), (q.2 : ℂ))).im = 0) ∧
    (∀ i : Fin k,
      0 < (ℓ_fn i ((q.1 : ℂ), (q.2 : ℂ))).re ∧
      (ℓ_fn i ((q.1 : ℂ), (q.2 : ℂ))).im = 0) ∧
    (∀ r : Fin (k + 1),
      pointChartWWeb C k rotIdx F Ψ ℓ_fn r ((q.1 : ℂ), (q.2 : ℂ)) ≠ 0) ∧
    Function.Injective (fun r : Fin (k + 1) =>
      deriv (fun z : ℂ => pointChartPsiWeb C k rotIdx Ψ r ((q.1 : ℂ), z)) (q.2 : ℂ) /
        deriv (fun z : ℂ => pointChartPsiWeb C k rotIdx Ψ r (z, (q.2 : ℂ))) (q.1 : ℂ)) ∧
    (pointInteriorHess (fun i => ℓ_fn i ((q.1 : ℂ), (q.2 : ℂ))) F (deriv F)
      (deriv (deriv F))
      (fun s => pointChartX C k rotIdx Ψ s ((q.1 : ℂ), (q.2 : ℂ)))).det ≠ 0

abbrev PointGlancingChartData.U_a {Ω : Set Plane} {C : AnalyticGlancingCollar Ω}
    {B : BaseCollarAndCramerData C} {k : ℕ} (G : PointGlancingChartData C B k) : Set ℂ :=
  Metric.ball (G.a₀ : ℂ) (2 * G.R)

abbrev PointGlancingChartData.U_d {Ω : Set Plane} {C : AnalyticGlancingCollar Ω}
    {B : BaseCollarAndCramerData C} {k : ℕ} (G : PointGlancingChartData C B k) : Set ℂ :=
  Metric.ball (0 : ℂ) (2 * G.δ_star)

noncomputable abbrev PointGlancingChartData.a_coord {Ω : Set Plane} {C : AnalyticGlancingCollar Ω}
    {B : BaseCollarAndCramerData C} {k : ℕ} (G : PointGlancingChartData C B k)
    (p : ℂ × ℂ) : ℂ :=
  pointChartACoord C G.rotIdx p

noncomputable abbrev PointGlancingChartData.b_coord {Ω : Set Plane} {C : AnalyticGlancingCollar Ω}
    {B : BaseCollarAndCramerData C} {k : ℕ} (G : PointGlancingChartData C B k)
    (p : ℂ × ℂ) : ℂ :=
  pointChartBCoord C k G.rotIdx p

noncomputable abbrev PointGlancingChartData.det_ab {Ω : Set Plane} {C : AnalyticGlancingCollar Ω}
    {B : BaseCollarAndCramerData C} {k : ℕ} (G : PointGlancingChartData C B k)
    (p : ℂ × ℂ) : ℂ :=
  pointChartDetAB C k G.rotIdx p

noncomputable abbrev PointGlancingChartData.x_fn {Ω : Set Plane} {C : AnalyticGlancingCollar Ω}
    {B : BaseCollarAndCramerData C} {k : ℕ} (G : PointGlancingChartData C B k)
    (r : Fin (k + 1)) (q : ℂ × ℂ) : ℂ :=
  pointChartX C k G.rotIdx G.Ψ r q

noncomputable abbrev PointGlancingChartData.A_point {Ω : Set Plane} {C : AnalyticGlancingCollar Ω}
    {B : BaseCollarAndCramerData C} {k : ℕ} (G : PointGlancingChartData C B k)
    (q : ℂ × ℂ) : ℂ :=
  pointChartAction G.ℓ_fn q

noncomputable abbrev PointGlancingChartData.A_point_ab {Ω : Set Plane}
    {C : AnalyticGlancingCollar Ω} {B : BaseCollarAndCramerData C} {k : ℕ}
    (G : PointGlancingChartData C B k) (q_ab : ℂ × ℂ) : ℂ :=
  pointChartActionAB G.ℓ_fn q_ab

noncomputable abbrev PointGlancingChartData.ψ_web {Ω : Set Plane} {C : AnalyticGlancingCollar Ω}
    {B : BaseCollarAndCramerData C} {k : ℕ} (G : PointGlancingChartData C B k)
    (r : Fin (k + 1)) (q : ℂ × ℂ) : ℂ :=
  pointChartPsiWeb C k G.rotIdx G.Ψ r q

noncomputable abbrev PointGlancingChartData.w_web {Ω : Set Plane} {C : AnalyticGlancingCollar Ω}
    {B : BaseCollarAndCramerData C} {k : ℕ} (G : PointGlancingChartData C B k)
    (r : Fin (k + 1)) (q : ℂ × ℂ) : ℂ :=
  pointChartWWeb C k G.rotIdx G.F G.Ψ G.ℓ_fn r q

structure PointCoreEliminationData {Ω : Set Plane} (C : AnalyticGlancingCollar Ω)
    (B : BaseCollarAndCramerData C) (k : ℕ) (G : PointGlancingChartData C B k)
    (a₁ δ₁ : ℝ) where
  N_core : ℕ
  coreTuple : Fin N_core → ℂ
  endpoint_graph_jets_mem_K_pt : ∀ m : ℕ,
    iteratedDeriv m G.F (a₁ : ℂ) ∈ pointBaseField C k G.Ψ a₁ δ₁ ∧
    iteratedDeriv m G.F ((a₁ : ℂ) + (δ₁ : ℂ)) ∈ pointBaseField C k G.Ψ a₁ δ₁
  action_mixed_ab_mem_K_pt : ∀ d : Fin 2 →₀ ℕ, 1 ≤ d 0 → 1 ≤ d 1 →
    MvPowerSeries.coeff d (taylor2D G.A_point_ab ((a₁ : ℂ), (a₁ : ℂ) + (δ₁ : ℂ))) ∈
      pointBaseField C k G.Ψ a₁ δ₁
  abscissa_mem_F_val : ∀ r : Fin (k + 1),
    G.x_fn r ((a₁ : ℂ), (δ₁ : ℂ)) ∈
      Subfield.closure
        (((pointBaseField C k G.Ψ a₁ δ₁ : Subfield ℂ) : Set ℂ) ∪ Set.range coreTuple)
  chord_len_mem_F_val : ∀ i : Fin k,
    G.ℓ_fn i ((a₁ : ℂ), (δ₁ : ℂ)) ∈
      Subfield.closure
        (((pointBaseField C k G.Ψ a₁ δ₁ : Subfield ℂ) : Set ℂ) ∪ Set.range coreTuple)
  graph_jets_mem_F_val : ∀ (r : Fin (k + 1)) (m : ℕ),
    iteratedDeriv m G.F (G.x_fn r ((a₁ : ℂ), (δ₁ : ℂ))) ∈
      Subfield.closure
        (((pointBaseField C k G.Ψ a₁ δ₁ : Subfield ℂ) : Set ℂ) ∪ Set.range coreTuple)
  abscissa_ab_taylor_mem_F_val : ∀ (r : Fin (k + 1)) (d : Fin 2 →₀ ℕ),
    MvPowerSeries.coeff d
      (centeredTaylor2D (fun q_ab => G.x_fn r (q_ab.1, q_ab.2 - q_ab.1))
        ((a₁ : ℂ), (a₁ : ℂ) + (δ₁ : ℂ))) ∈
      Subfield.closure
        (((pointBaseField C k G.Ψ a₁ δ₁ : Subfield ℂ) : Set ℂ) ∪ Set.range coreTuple)
  action_ab_taylor_mem_F_val : ∀ d : Fin 2 →₀ ℕ,
    MvPowerSeries.coeff d (taylor2D G.A_point_ab ((a₁ : ℂ), (a₁ : ℂ) + (δ₁ : ℂ))) ∈
      Subfield.closure
        (((pointBaseField C k G.Ψ a₁ δ₁ : Subfield ℂ) : Set ℂ) ∪ Set.range coreTuple)
  core_entries_subset :
    Set.range coreTuple ⊆
      { z : ℂ |
        (∃ r : Fin (k + 1), z = G.x_fn r ((a₁ : ℂ), (δ₁ : ℂ))) ∨
        (∃ i : Fin k, z = G.ℓ_fn i ((a₁ : ℂ), (δ₁ : ℂ))) ∨
        (∃ (r : Fin (k + 1)) (m : ℕ),
          z = iteratedDeriv m G.F (G.x_fn r ((a₁ : ℂ), (δ₁ : ℂ)))) }
  dualLine_mem_F_val : ∀ j : ℕ, 0 < j → j ≤ k → ∀ ι : Fin 2,
    glancingDualLine C
      ((G.Ψ ((a₁ : ℂ), (δ₁ : ℂ))).1 + ((j : ℂ) - 1 / 2) * (G.Ψ ((a₁ : ℂ), (δ₁ : ℂ))).2)
      (G.Ψ ((a₁ : ℂ), (δ₁ : ℂ))).2 ι ∈
      Subfield.closure
        (((pointBaseField C k G.Ψ a₁ δ₁ : Subfield ℂ) : Set ℂ) ∪ Set.range coreTuple)

noncomputable abbrev PointCoreEliminationData.K_pt {Ω : Set Plane}
    {C : AnalyticGlancingCollar Ω} {B : BaseCollarAndCramerData C} {k : ℕ}
    {G : PointGlancingChartData C B k} {a₁ δ₁ : ℝ}
    (_E : PointCoreEliminationData C B k G a₁ δ₁) : Subfield ℂ :=
  pointBaseField C k G.Ψ a₁ δ₁

noncomputable abbrev PointCoreEliminationData.F_val {Ω : Set Plane}
    {C : AnalyticGlancingCollar Ω} {B : BaseCollarAndCramerData C} {k : ℕ}
    {G : PointGlancingChartData C B k} {a₁ δ₁ : ℝ}
    (E : PointCoreEliminationData C B k G a₁ δ₁) : Subfield ℂ :=
  Subfield.closure
    (((pointBaseField C k G.Ψ a₁ δ₁ : Subfield ℂ) : Set ℂ) ∪ Set.range E.coreTuple)

structure PointTruncatedCoalescingModel (k p J : ℕ) (a : ℝ) (F : ℂ → ℂ)
    (f_p : Fin (k + 1) → ℂ) where
  W_n : Set ℂ
  W_n_open : IsOpen W_n
  a_mem : (a : ℂ) ∈ W_n
  F_holo : DifferentiableOn ℂ F W_n
  g : Fin (k + 1) → Fin (J + 1) → ℂ → ℂ
  g_holo : ∀ (r : Fin (k + 1)) (l : Fin (J + 1)), DifferentiableOn ℂ (g r l) W_n
  g_endpoints : ∀ (l : Fin (J + 1)) (z : ℂ), g 0 l z = 0 ∧ g (Fin.last k) l z = 0
  g_lt_p : ∀ (r : Fin (k + 1)) (l : Fin (J + 1)), (l : ℕ) < p → ∀ z ∈ W_n, g r l z = 0
  g_at_p : ∀ (r : Fin (k + 1)) (hpJ : p < J + 1), g r ⟨p, hpJ⟩ (a : ℂ) = f_p r
  U_split : Fin (J + 1) → ℂ → ℂ
  V_split : Fin (J + 1) → ℂ → ℂ
  UV_holo : ∀ l : Fin (J + 1),
    DifferentiableOn ℂ (U_split l) W_n ∧ DifferentiableOn ℂ (V_split l) W_n
  δ₀ : ℝ
  δ₀_pos : 0 < δ₀
  x₀ : ℝ → Fin (k + 1) → ℂ
  ℓ₀ : ℝ → Fin k → ℂ
  β : Fin (J + 1) → ℝ → Fin (k + 1) → ℂ
  β_zero : ∀ (δ : ℝ) (r : Fin (k + 1)), β 0 δ r = 0
  x₀_endpoints : ∀ δ ∈ Set.Ioo (0 : ℝ) δ₀,
    x₀ δ 0 = (a : ℂ) ∧ x₀ δ (Fin.last k) = (a : ℂ) + (δ : ℂ)
  β_endpoints : ∀ (l : Fin (J + 1)) (δ : ℝ),
    β l δ 0 = 0 ∧ β l δ (Fin.last k) = 0
  x₀_real : ∀ δ ∈ Set.Ioo (0 : ℝ) δ₀, ∀ r : Fin (k + 1), (x₀ δ r).im = 0
  x₀_tendsto : ∀ r : Fin (k + 1),
    Filter.Tendsto (fun δ : ℝ => (x₀ δ r - (a : ℂ)) / (δ : ℂ))
      (nhdsWithin (0 : ℝ) (Set.Ioi 0)) (nhds (((r : ℕ) : ℂ) / (k : ℂ)))
  x₀_maps_W_n : ∀ δ ∈ Set.Ioo (0 : ℝ) δ₀,
    (a : ℂ) + (δ : ℂ) ∈ W_n ∧ ∀ r : Fin (k + 1), x₀ δ r ∈ W_n
  ℓ₀_pos : ∀ δ ∈ Set.Ioo (0 : ℝ) δ₀, ∀ i : Fin k,
    0 < (ℓ₀ δ i).re ∧ (ℓ₀ δ i).im = 0 ∧ (ℓ₀ δ i) ^ 2 = pointEdgeSq (fun _ => F) (x₀ δ) i
  x₀_stat : ∀ δ ∈ Set.Ioo (0 : ℝ) δ₀, ∀ r : Fin (k - 1),
    pointRelInteriorGrad (ℓ₀ δ) (fun _ => F) (fun _ => deriv F) (x₀ δ) r = 0
  grad_jet_zero : ∀ δ ∈ Set.Ioo (0 : ℝ) δ₀, ∀ r : Fin (k - 1), ∀ l : ℕ, 1 ≤ l → l ≤ J →
    iteratedDeriv l
      (fun ε : ℂ =>
        pointRelInteriorGrad (ℓ₀ δ)
          (fun m z => F z + ∑ q : Fin (J + 1), ε ^ (q : ℕ) * g m q z)
          (fun m z => deriv F z + ∑ q : Fin (J + 1), ε ^ (q : ℕ) * deriv (g m q) z)
          (fun m => x₀ δ m + ∑ q : Fin (J + 1), ε ^ (q : ℕ) * β q δ m)
          r)
      0 = 0
  len_jet_split : ∀ δ ∈ Set.Ioo (0 : ℝ) δ₀, ∀ (l : Fin (J + 1)), 1 ≤ (l : ℕ) →
    iteratedDeriv (l : ℕ)
      (fun ε : ℂ =>
        pointRelChainLen (ℓ₀ δ)
          (fun m z => F z + ∑ q : Fin (J + 1), ε ^ (q : ℕ) * g m q z)
          (fun m => x₀ δ m + ∑ q : Fin (J + 1), ε ^ (q : ℕ) * β q δ m))
      0 / ((l : ℕ).factorial : ℂ) =
      U_split l (a : ℂ) + V_split l ((a : ℂ) + (δ : ℂ))

structure PointContinuedDeformationData {Ω : Set Plane} (C : AnalyticGlancingCollar Ω)
    (B : BaseCollarAndCramerData C) (k : ℕ) (G : PointGlancingChartData C B k)
    (a₁ δ₁ : ℝ) where
  p : ℕ
  p_pos : 1 ≤ p
  f_lead : Fin (k + 1) → PowerSeries ℂ
  r₀ : Fin (k - 1)
  f_lead_r₀_ne_zero : f_lead ⟨r₀.1 + 1, by have := r₀.2; omega⟩ ≠ 0
  W_lead : Set ℂ
  W_lead_open : IsOpen W_lead
  W_lead_preconn : IsPreconnected W_lead
  real_mem_W_lead : ∀ x : ℝ, |x - G.a₀| < G.R → (x : ℂ) ∈ W_lead
  g_lead : Fin (k + 1) → ℂ → ℂ
  g_lead_endpoints : ∀ z : ℂ, g_lead 0 z = 0 ∧ g_lead (Fin.last k) z = 0
  g_lead_holo : ∀ r : Fin (k + 1), DifferentiableOn ℂ (g_lead r) W_lead
  g_lead_taylor : ∀ r : Fin (k - 1),
    G.x_fn ⟨r.1 + 1, by have := r.2; omega⟩ ((a₁ : ℂ), (δ₁ : ℂ)) ∈ W_lead ∧
    ∀ n : ℕ,
      iteratedDeriv n (g_lead ⟨r.1 + 1, by have := r.2; omega⟩)
        (G.x_fn ⟨r.1 + 1, by have := r.2; omega⟩ ((a₁ : ℂ), (δ₁ : ℂ))) / (n.factorial : ℂ) =
        PowerSeries.coeff n (f_lead ⟨r.1 + 1, by have := r.2; omega⟩)
  trunc_models : ∀ J : ℕ, p ≤ J → ∀ a ∈ Set.Ioo (G.a₀ - G.R) (G.a₀ + G.R),
    Nonempty (PointTruncatedCoalescingModel k p J a G.F (fun r => g_lead r (a : ℂ)))
noncomputable def hcShiftPerturb (ρ : ℝ) (e : ℝ → ℝ) (x : ℝ) : ℝ :=
  x + ρ + e x

noncomputable def hcShiftInv (ρ : ℝ) (e : ℝ → ℝ) (z : ℝ) : ℝ :=
  Function.invFun (hcShiftPerturb ρ e) z

noncomputable def hcShiftInvDisp (ρ : ℝ) (e : ℝ → ℝ) (z : ℝ) : ℝ :=
  hcShiftInv ρ e z - (z - ρ)

def IsHcBoundedPeriodicPair (p : ℕ) (ε : ℝ) (A B : ℝ → ℝ) : Prop :=
  Function.Periodic A (2 * Real.pi) ∧
  Function.Periodic B (2 * Real.pi) ∧
  ContDiff ℝ ((p : ℕ) : WithTop ℕ∞) A ∧
  ContDiff ℝ ((p : ℕ) : WithTop ℕ∞) B ∧
  ∀ k : ℕ, k ≤ p → ∀ x : ℝ, |iteratedDeriv k A x| ≤ ε ∧ |iteratedDeriv k B x| ≤ ε
def rdmc_IsBoundedDispTuple (p q : ℕ) (B : ℝ) (d : ℕ → ℝ → ℝ) : Prop :=
  d 0 = 0 ∧
  d q = 0 ∧
  (∀ j : ℕ, q < j → d j = 0) ∧
  (∀ j : ℕ, j ≤ q → IsRealJetPerturb p (B / (q : ℝ) ^ 2) (d j)) ∧
  (∀ j : ℕ, j < q →
    IsRealJetPerturb p (B / (q : ℝ) ^ 3) (fun x : ℝ => d (j + 1) x - d j x))

noncomputable def rdmc_dirichletPrefix (f : ℕ → ℝ → ℝ) (r : ℕ) (x : ℝ) : ℝ :=
  ∑ i ∈ Finset.range r, f (i + 1) x

noncomputable def rdmc_dirichletSlope0 (q : ℕ) (f : ℕ → ℝ → ℝ) (x : ℝ) : ℝ :=
  -(q : ℝ)⁻¹ * ∑ r ∈ Finset.range q, rdmc_dirichletPrefix f r x

noncomputable def rdmc_dirichletInv (q : ℕ) (f : ℕ → ℝ → ℝ) (j : ℕ) (x : ℝ) : ℝ :=
  if j ≤ q then
    ∑ r ∈ Finset.range j, (rdmc_dirichletSlope0 q f x + rdmc_dirichletPrefix f r x)
  else 0

noncomputable def rdmc_elForcing {m : ℕ} {M₁ : ℝ}
    (J_R : RealJetAndUniquenessData m M₁) (q : ℕ) (w : ℝ → ℝ) (d : ℕ → ℝ → ℝ)
    (i : ℕ) (x : ℝ) : ℝ :=
  match i with
  | 0 => 0
  | j + 1 =>
    if j + 1 < q then
      let X : ℝ := x + 2 * Real.pi * ((j + 1 : ℕ) : ℝ) / (q : ℝ) + d (j + 1) x;
      let τ_t : ℝ := d (j + 2) x - d (j + 1) x;
      let τ_s : ℝ := d (j + 1) x - d j x;
      let t : ℝ := 2 * Real.pi / (q : ℝ) + τ_t;
      let s : ℝ := 2 * Real.pi / (q : ℝ) + τ_s;
      let g₁ : ℝ := ((q : ℝ) / (4 * Real.pi)) * (τ_t + τ_s);
      let g₂ : ℝ := 8 * (t ^ 2 + s ^ 2) * J_R.a_R w X;
      (-(2 * (q : ℝ) / Real.pi)) *
        ((t ^ 5 * J_R.b_R w X t + s ^ 5 * J_R.b_R w X (-s)) *
          ((1 + g₁)⁻¹ * (1 + g₂)⁻¹))
    else 0
def IsStripCJetBounded (p : ℕ) (σ' B : ℝ) (f : ℂ → ℂ) : Prop :=
  DifferentiableOn ℂ f (horizStrip σ') ∧
  (∀ z ∈ horizStrip σ', f (z + 2 * Real.pi) = f z) ∧
  (∀ z ∈ horizStrip σ', f (starRingEnd ℂ z) = starRingEnd ℂ (f z)) ∧
  (∀ k : ℕ, k ≤ p → ∀ z ∈ horizStrip σ', ‖iteratedDeriv k f z‖ ≤ B)

def IsStripMeshDispBall (p q : ℕ) (σ' R : ℝ) (d : ℕ → ℂ → ℂ) : Prop :=
  (∀ z : ℂ, d 0 z = 0 ∧ d q z = 0) ∧
  (∀ j : ℕ, q < j → ∀ z : ℂ, d j z = 0) ∧
  (∀ j : ℕ, j ≤ q →
    DifferentiableOn ℂ (d j) (horizStrip σ') ∧
    (∀ z ∈ horizStrip σ', d j (z + 2 * Real.pi) = d j z) ∧
    (∀ z ∈ horizStrip σ', d j (starRingEnd ℂ z) = starRingEnd ℂ (d j z)) ∧
    (∀ k : ℕ, k ≤ p → ∀ z ∈ horizStrip σ',
      (q : ℝ) ^ 2 * ‖iteratedDeriv k (d j) z‖ ≤ R)) ∧
  (∀ j : ℕ, j < q → ∀ k : ℕ, k ≤ p → ∀ z ∈ horizStrip σ',
    (q : ℝ) ^ 3 * ‖iteratedDeriv k (fun ζ => d (j + 1) ζ - d j ζ) z‖ ≤ R)

noncomputable def dirichletPartSum_ℂ (f : ℕ → ℂ → ℂ) (r : ℕ) (z : ℂ) : ℂ :=
  ∑ i ∈ Finset.range r, f (i + 1) z

noncomputable def dirichletSlope0_ℂ (q : ℕ) (f : ℕ → ℂ → ℂ) (z : ℂ) : ℂ :=
  -((q : ℂ)⁻¹) * ∑ r ∈ Finset.range q, dirichletPartSum_ℂ f r z

noncomputable def dirichletSlope_ℂ (q : ℕ) (f : ℕ → ℂ → ℂ) (r : ℕ) (z : ℂ) : ℂ :=
  dirichletSlope0_ℂ q f z + dirichletPartSum_ℂ f r z

noncomputable def dirichletInv_ℂ (q : ℕ) (f : ℕ → ℂ → ℂ) (j : ℕ) (z : ℂ) : ℂ :=
  if j ≤ q then ∑ r ∈ Finset.range j, dirichletSlope_ℂ q f r z else 0

noncomputable def stripForcingAt_ℂ {m : ℕ} {M₁ : ℝ}
    (J_C : StripHolomorphicJetData m M₁) (q : ℕ) (W : ℂ → ℂ)
    (d : ℕ → ℂ → ℂ) (j : ℕ) (z : ℂ) : ℂ :=
  let ρ : ℝ := 2 * Real.pi * ((j + 1 : ℕ) : ℝ) / (q : ℝ)
  let X : ℂ := z + (ρ : ℂ) + d (j + 1) z
  let τ_plus : ℂ → ℂ := fun ζ => d (j + 2) ζ - d (j + 1) ζ
  let τ_minus : ℂ → ℂ := fun ζ => d j ζ - d (j + 1) ζ
  let t : ℂ := ((2 * Real.pi / (q : ℝ) : ℝ) : ℂ) + τ_plus z
  let s : ℂ := ((2 * Real.pi / (q : ℝ) : ℝ) : ℂ) + (d (j + 1) z - d j z)
  let a_val : ℂ := J_C.a_C W X
  let b_plus : ℂ := J_C.b_C W ρ 1 q (d (j + 1)) τ_plus z
  let b_minus : ℂ := J_C.b_C W ρ (-1) q (d (j + 1)) τ_minus z
  (-(t ^ 5 * b_plus + s ^ 5 * b_minus)) /
    ((t + s) * (1 / 8 + (t ^ 2 + s ^ 2) * a_val))

noncomputable def stripMeshForcing_ℂ {m : ℕ} {M₁ : ℝ}
    (J_C : StripHolomorphicJetData m M₁) (q : ℕ) (W : ℂ → ℂ)
    (d : ℕ → ℂ → ℂ) : ℕ → ℂ → ℂ
  | 0 => 0
  | j + 1 => if j + 1 < q then stripForcingAt_ℂ J_C q W d j else 0

noncomputable def stripMeshStep_ℂ {m : ℕ} {M₁ : ℝ}
    (J_C : StripHolomorphicJetData m M₁) (q : ℕ) (W : ℂ → ℂ)
    (d : ℕ → ℂ → ℂ) : ℕ → ℂ → ℂ :=
  dirichletInv_ℂ q (stripMeshForcing_ℂ J_C q W d)

noncomputable def stripMeshIter_ℂ {m : ℕ} {M₁ : ℝ}
    (J_C : StripHolomorphicJetData m M₁) (q : ℕ) (W : ℂ → ℂ) :
    ℕ → (ℕ → ℂ → ℂ)
  | 0 => fun _ _ => 0
  | n + 1 => stripMeshStep_ℂ J_C q W (stripMeshIter_ℂ J_C q W n)

noncomputable def stripCanonDisp_ℂ {m : ℕ} {M₁ : ℝ}
    (J_C : StripHolomorphicJetData m M₁) (q : ℕ) (W : ℂ → ℂ)
    (j : ℕ) (z : ℂ) : ℂ :=
  if j ≤ q then Filter.limUnder Filter.atTop (fun n => stripMeshIter_ℂ J_C q W n j z) else 0

noncomputable def stripCanonX_ℂ {m : ℕ} {M₁ : ℝ}
    (J_C : StripHolomorphicJetData m M₁) (q : ℕ) (W : ℂ → ℂ)
    (j : ℕ) (z : ℂ) : ℂ :=
  if j ≤ q then
    z + ((2 * Real.pi * (j : ℝ) / (q : ℝ) : ℝ) : ℂ) + stripCanonDisp_ℂ J_C q W j z
  else 0

noncomputable def stripCanonMu_ℂ {m : ℕ} {M₁ : ℝ}
    (J_C : StripHolomorphicJetData m M₁) (q : ℕ) (W : ℂ → ℂ)
    (j : ℕ) (z : ℂ) : ℂ :=
  if j < q then
    J_C.mid_C W (2 * Real.pi * (j : ℝ) / (q : ℝ)) q
      (stripCanonDisp_ℂ J_C q W j)
      (fun ζ => stripCanonDisp_ℂ J_C q W (j + 1) ζ - stripCanonDisp_ℂ J_C q W j ζ) z
  else 0

structure StripDirichletInvProp : Prop where
  boundary_and_outside : ∀ (q : ℕ) (f : ℕ → ℂ → ℂ),
    1 ≤ q →
    (∀ z : ℂ, dirichletInv_ℂ q f 0 z = 0 ∧ dirichletInv_ℂ q f q z = 0) ∧
    (∀ j : ℕ, q < j → ∀ z : ℂ, dirichletInv_ℂ q f j z = 0)
  diff_identities : ∀ (q : ℕ) (f : ℕ → ℂ → ℂ),
    1 ≤ q →
    (∀ j : ℕ, j < q → ∀ z : ℂ,
      dirichletInv_ℂ q f (j + 1) z - dirichletInv_ℂ q f j z = dirichletSlope_ℂ q f j z) ∧
    (∀ j : ℕ, j + 1 < q → ∀ z : ℂ,
      dirichletInv_ℂ q f (j + 2) z - 2 * dirichletInv_ℂ q f (j + 1) z +
        dirichletInv_ℂ q f j z = f (j + 1) z)
  sub_eq : ∀ (q : ℕ) (f₁ f₂ : ℕ → ℂ → ℂ) (j : ℕ) (z : ℂ),
    dirichletInv_ℂ q f₁ j z - dirichletInv_ℂ q f₂ j z =
      dirichletInv_ℂ q (fun i ζ => f₁ i ζ - f₂ i ζ) j z
  maps_to_ball : ∀ (p q : ℕ) (σ' M_f : ℝ) (f : ℕ → ℂ → ℂ),
    1 ≤ q →
    0 < σ' →
    0 ≤ M_f →
    (∀ j : ℕ, j + 1 < q → IsStripCJetBounded p σ' M_f (f (j + 1))) →
    IsStripMeshDispBall p q σ' (2 * (q : ℝ) ^ 4 * M_f) (dirichletInv_ℂ q f)

structure StripForcingBoundData (m : ℕ) (M₁ : ℝ)
    (J_C : StripHolomorphicJetData m M₁) where
  C_force : ℝ
  C_force_lip : ℝ
  N_force : ℕ
  C_force_pos : 0 < C_force
  C_force_lip_pos : 0 < C_force_lip
  N_force_ge_four : 4 ≤ N_force
  N_jet_le_N_force : J_C.N_jet_C ≤ N_force
  forcing_props : ∀ (σ σ' R : ℝ) (q : ℕ) (w : ℝ → ℝ) (W : ℂ → ℂ) (d : ℕ → ℂ → ℂ),
    σ ∈ Set.Ioc (0 : ℝ) 1 →
    0 < R →
    N_force ≤ q →
    16 * R ≤ (q : ℝ) →
    0 < σ' →
    σ' ≤ (1 - (6 * R + J_C.K_eval) / (q : ℝ) ^ 2) * σ →
    IsPeriodicSmoothBounded (m + 15) M₁ w →
    IsBoundedStripExt (m + 15) σ M₁ w W →
    IsStripMeshDispBall (m + 2) q σ' R d →
    ∀ j : ℕ, j + 1 < q →
      IsStripCJetBounded (m + 2) σ' (C_force / (q : ℝ) ^ 4)
        (stripForcingAt_ℂ J_C q W d j)
  real_stationary_of_sec_diff :
    ∀ (σ σ' R : ℝ) (q : ℕ) (w : ℝ → ℝ) (W : ℂ → ℂ) (d : ℕ → ℂ → ℂ),
      σ ∈ Set.Ioc (0 : ℝ) 1 →
      0 < R →
      N_force ≤ q →
      16 * R ≤ (q : ℝ) →
      0 < σ' →
      σ' ≤ (1 - (6 * R + J_C.K_eval) / (q : ℝ) ^ 2) * σ →
      IsPeriodicSmoothBounded (m + 15) M₁ w →
      IsBoundedStripExt (m + 15) σ M₁ w W →
      IsStripMeshDispBall (m + 2) q σ' R d →
      ∀ (j : ℕ) (x : ℝ), j + 1 < q →
        d (j + 2) x - 2 * d (j + 1) x + d j x = stripForcingAt_ℂ J_C q W d j x →
        let X_r : ℕ → ℝ := fun r => x + 2 * Real.pi * (r : ℝ) / (q : ℝ) + (d r x).re
        normAction1_ℝ w (X_r (j + 1)) (X_r (j + 2)) -
          normAction1_ℝ w (X_r (j + 1)) (X_r j) = 0
  forcing_lip :
    ∀ (σ σ' R Δ_star : ℝ) (q : ℕ) (w₁ w₂ : ℝ → ℝ) (W₁ W₂ : ℂ → ℂ)
      (d₁ d₂ : ℕ → ℂ → ℂ),
      σ ∈ Set.Ioc (0 : ℝ) 1 →
      0 < R →
      0 ≤ Δ_star →
      N_force ≤ q →
      16 * R ≤ (q : ℝ) →
      0 < σ' →
      σ' ≤ (1 - (6 * R + J_C.K_eval) / (q : ℝ) ^ 2) * σ →
      IsPeriodicSmoothBounded (m + 15) M₁ w₁ →
      IsPeriodicSmoothBounded (m + 15) M₁ w₂ →
      IsBoundedStripExt (m + 15) σ M₁ w₁ W₁ →
      IsBoundedStripExt (m + 15) σ M₁ w₂ W₂ →
      IsStripMeshDispBall (m + 2) q σ' R d₁ →
      IsStripMeshDispBall (m + 2) q σ' R d₂ →
      (∀ r : ℕ, r ≤ q → ∀ k : ℕ, k ≤ m + 2 → ∀ z ∈ horizStrip σ',
        (q : ℝ) ^ 2 * ‖iteratedDeriv k (fun ζ => d₁ r ζ - d₂ r ζ) z‖ ≤ Δ_star) →
      (∀ r : ℕ, r < q → ∀ k : ℕ, k ≤ m + 2 → ∀ z ∈ horizStrip σ',
        (q : ℝ) ^ 3 *
          ‖iteratedDeriv k
            (fun ζ => (d₁ (r + 1) ζ - d₁ r ζ) - (d₂ (r + 1) ζ - d₂ r ζ)) z‖ ≤ Δ_star) →
      ∀ j : ℕ, j + 1 < q → ∀ k : ℕ, k ≤ m + 2 → ∀ z ∈ horizStrip σ',
        ‖iteratedDeriv k
          (fun ζ =>
            stripForcingAt_ℂ J_C q W₁ d₁ j ζ - stripForcingAt_ℂ J_C q W₂ d₂ j ζ) z‖ ≤
          C_force_lip *
            (Δ_star / (q : ℝ) ^ 6 + stripDiffSup (m + 15) σ W₁ W₂ / (q : ℝ) ^ 4)
noncomputable def lineCoreIdx2D (a b : ℕ) : Fin 2 →₀ ℕ :=
  Finsupp.equivFunOnFinite.symm ![a, b]

noncomputable def lineCoreDerivA (S : MvPowerSeries (Fin 2) ℂ) : MvPowerSeries (Fin 2) ℂ :=
  fun d => ((d 0 + 1 : ℕ) : ℂ) * MvPowerSeries.coeff (d + lineCoreIdx2D 1 0) S

noncomputable def lineCoreDerivD (S : MvPowerSeries (Fin 2) ℂ) : MvPowerSeries (Fin 2) ℂ :=
  fun d => ((d 1 + 1 : ℕ) : ℂ) * MvPowerSeries.coeff (d + lineCoreIdx2D 0 1) S

noncomputable def lineCoreHoloTaylor1D (g : ℂ → ℂ) (z₀ : ℂ) : PowerSeries ℂ :=
  PowerSeries.mk fun n => iteratedDeriv n g z₀ / (n.factorial : ℂ)

noncomputable def lineCoreComp2D (F U₁ U₂ : MvPowerSeries (Fin 2) ℂ) :
    MvPowerSeries (Fin 2) ℂ :=
  fun d =>
    ∑ a ∈ Finset.range (d 0 + d 1 + 1),
      ∑ b ∈ Finset.range (d 0 + d 1 + 1),
        MvPowerSeries.coeff (lineCoreIdx2D a b) F *
          MvPowerSeries.coeff d (U₁ ^ a * U₂ ^ b)

def lineCoreCoeffsIn (L : Subfield ℂ) (S : MvPowerSeries (Fin 2) ℂ) : Prop :=
  ∀ d : Fin 2 →₀ ℕ, MvPowerSeries.coeff d S ∈ L

def lineCoreVanishesBelow (N : ℕ) (S : MvPowerSeries (Fin 2) ℂ) : Prop :=
  ∀ d : Fin 2 →₀ ℕ, d 0 + d 1 < N → MvPowerSeries.coeff d S = 0

structure LineCoreTaylor2DToolkit : Prop where
  iterDerivYT_holo : ∀ {U : Set (ℂ × ℂ)}, IsOpen U → ∀ {f : ℂ × ℂ → ℂ},
    DifferentiableOn ℂ f U → ∀ α β : ℕ, DifferentiableOn ℂ (iterDerivYT α β f) U
  taylor2D_congr : ∀ {U : Set (ℂ × ℂ)}, IsOpen U → ∀ {p₀ : ℂ × ℂ}, p₀ ∈ U →
    ∀ {f₁ f₂ : ℂ × ℂ → ℂ}, (∀ p ∈ U, f₁ p = f₂ p) → taylor2D f₁ p₀ = taylor2D f₂ p₀
  taylor2D_const : ∀ (p₀ : ℂ × ℂ) (c : ℂ), taylor2D (fun _ => c) p₀ = MvPowerSeries.C c
  centeredTaylor2D_fst : ∀ p₀ : ℂ × ℂ, centeredTaylor2D Prod.fst p₀ = MvPowerSeries.X 0
  centeredTaylor2D_snd : ∀ p₀ : ℂ × ℂ, centeredTaylor2D Prod.snd p₀ = MvPowerSeries.X 1
  taylor2D_ring : ∀ {U : Set (ℂ × ℂ)}, IsOpen U → ∀ {p₀ : ℂ × ℂ}, p₀ ∈ U →
    ∀ {f g : ℂ × ℂ → ℂ}, DifferentiableOn ℂ f U → DifferentiableOn ℂ g U →
      taylor2D (fun p => f p + g p) p₀ = taylor2D f p₀ + taylor2D g p₀ ∧
      taylor2D (fun p => f p - g p) p₀ = taylor2D f p₀ - taylor2D g p₀ ∧
      taylor2D (fun p => f p * g p) p₀ = taylor2D f p₀ * taylor2D g p₀
  deriv_taylor2D : ∀ {U : Set (ℂ × ℂ)}, IsOpen U → ∀ {p₀ : ℂ × ℂ}, p₀ ∈ U →
    ∀ {f : ℂ × ℂ → ℂ}, DifferentiableOn ℂ f U →
      lineCoreDerivA (taylor2D f p₀) = taylor2D (iterDerivYT 1 0 f) p₀ ∧
      lineCoreDerivD (taylor2D f p₀) = taylor2D (iterDerivYT 0 1 f) p₀
  taylor2D_comp_1D : ∀ {U : Set (ℂ × ℂ)} {W_ψ : Set ℂ},
    IsOpen U → IsOpen W_ψ → ∀ {p₀ : ℂ × ℂ}, p₀ ∈ U →
    ∀ {ψ : ℂ × ℂ → ℂ} {g : ℂ → ℂ},
      DifferentiableOn ℂ ψ U → DifferentiableOn ℂ g W_ψ → (∀ p ∈ U, ψ p ∈ W_ψ) →
      taylor2D (fun p => g (ψ p)) p₀ =
        compPowerSeries2D (lineCoreHoloTaylor1D g (ψ p₀)) (centeredTaylor2D ψ p₀)
  taylor2D_comp_2D : ∀ {U V : Set (ℂ × ℂ)},
    IsOpen U → IsOpen V → ∀ {p₀ : ℂ × ℂ}, p₀ ∈ U →
    ∀ {Ψ : ℂ × ℂ → ℂ × ℂ} {f : ℂ × ℂ → ℂ},
      DifferentiableOn ℂ Ψ U → DifferentiableOn ℂ f V → (∀ p ∈ U, Ψ p ∈ V) →
      taylor2D (fun p => f (Ψ p)) p₀ =
        lineCoreComp2D (taylor2D f (Ψ p₀))
          (centeredTaylor2D (fun p => (Ψ p).1) p₀)
          (centeredTaylor2D (fun p => (Ψ p).2) p₀)

structure LineCoreSubfieldSeriesToolkit : Prop where
  C_mem : ∀ (L : Subfield ℂ) {c : ℂ}, c ∈ L → lineCoreCoeffsIn L (MvPowerSeries.C c)
  X_mem : ∀ (L : Subfield ℂ) (s : Fin 2), lineCoreCoeffsIn L (MvPowerSeries.X s)
  add_mem : ∀ (L : Subfield ℂ) {S T : MvPowerSeries (Fin 2) ℂ},
    lineCoreCoeffsIn L S → lineCoreCoeffsIn L T → lineCoreCoeffsIn L (S + T)
  sub_mem : ∀ (L : Subfield ℂ) {S T : MvPowerSeries (Fin 2) ℂ},
    lineCoreCoeffsIn L S → lineCoreCoeffsIn L T → lineCoreCoeffsIn L (S - T)
  mul_mem : ∀ (L : Subfield ℂ) {S T : MvPowerSeries (Fin 2) ℂ},
    lineCoreCoeffsIn L S → lineCoreCoeffsIn L T → lineCoreCoeffsIn L (S * T)
  derivA_mem : ∀ (L : Subfield ℂ) {S : MvPowerSeries (Fin 2) ℂ},
    lineCoreCoeffsIn L S → lineCoreCoeffsIn L (lineCoreDerivA S)
  derivD_mem : ∀ (L : Subfield ℂ) {S : MvPowerSeries (Fin 2) ℂ},
    lineCoreCoeffsIn L S → lineCoreCoeffsIn L (lineCoreDerivD S)
  comp1D_mem : ∀ (L : Subfield ℂ) {f : PowerSeries ℂ} {U : MvPowerSeries (Fin 2) ℂ},
    (∀ n : ℕ, PowerSeries.coeff n f ∈ L) → MvPowerSeries.coeff 0 U = 0 →
    lineCoreCoeffsIn L U → lineCoreCoeffsIn L (compPowerSeries2D f U)
  comp2D_mem : ∀ (L : Subfield ℂ) {F U₁ U₂ : MvPowerSeries (Fin 2) ℂ},
    lineCoreCoeffsIn L F → MvPowerSeries.coeff 0 U₁ = 0 → MvPowerSeries.coeff 0 U₂ = 0 →
    lineCoreCoeffsIn L U₁ → lineCoreCoeffsIn L U₂ →
    lineCoreCoeffsIn L (lineCoreComp2D F U₁ U₂)
  pos_of_deriv_mem : ∀ (L : Subfield ℂ) {S : MvPowerSeries (Fin 2) ℂ},
    lineCoreCoeffsIn L (lineCoreDerivA S) → lineCoreCoeffsIn L (lineCoreDerivD S) →
    ∀ d : Fin 2 →₀ ℕ, d ≠ 0 → MvPowerSeries.coeff d S ∈ L
  inv_mem : ∀ (L : Subfield ℂ) {S T : MvPowerSeries (Fin 2) ℂ},
    S * T = 1 → lineCoreCoeffsIn L T → lineCoreCoeffsIn L S
  sqrt_mem : ∀ (L : Subfield ℂ) {S T : MvPowerSeries (Fin 2) ℂ},
    S ^ 2 = T → lineCoreCoeffsIn L T → MvPowerSeries.coeff 0 S ∈ L →
    MvPowerSeries.coeff 0 S ≠ 0 → lineCoreCoeffsIn L S
  mulVec_mem : ∀ (L : Subfield ℂ) {ι : Type} [Fintype ι] [DecidableEq ι]
    {A : Matrix ι ι ℂ} {x b : ι → ℂ},
    (∀ r s : ι, A r s ∈ L) → A.det ≠ 0 → (∀ r : ι, b r ∈ L) → A.mulVec x = b →
    ∀ r : ι, x r ∈ L
  inv2D_mem : ∀ (L : Subfield ℂ) {Φ₁ Φ₂ Ψ₁ Ψ₂ : MvPowerSeries (Fin 2) ℂ},
    MvPowerSeries.coeff 0 Φ₁ = 0 → MvPowerSeries.coeff 0 Φ₂ = 0 →
    MvPowerSeries.coeff 0 Ψ₁ = 0 → MvPowerSeries.coeff 0 Ψ₂ = 0 →
    lineCoreCoeffsIn L Φ₁ → lineCoreCoeffsIn L Φ₂ →
    lineCoreComp2D Φ₁ Ψ₁ Ψ₂ = MvPowerSeries.X 0 →
    lineCoreComp2D Φ₂ Ψ₁ Ψ₂ = MvPowerSeries.X 1 →
    lineCoreCoeffsIn L Ψ₁ ∧ lineCoreCoeffsIn L Ψ₂
  coeff_comp1D_pert : ∀ {n : ℕ}, 1 ≤ n → ∀ (f : PowerSeries ℂ)
    {U₀ η : MvPowerSeries (Fin 2) ℂ} {d : Fin 2 →₀ ℕ},
    d 0 + d 1 = n → MvPowerSeries.coeff 0 U₀ = 0 → lineCoreVanishesBelow n η →
    MvPowerSeries.coeff d (compPowerSeries2D f (U₀ + η)) =
      MvPowerSeries.coeff d (compPowerSeries2D f U₀) +
        PowerSeries.coeff 1 f * MvPowerSeries.coeff d η
  coeff_mul_pert : ∀ {n : ℕ}, 1 ≤ n → ∀ {P P₀ Q Q₀ : MvPowerSeries (Fin 2) ℂ}
    {d : Fin 2 →₀ ℕ},
    d 0 + d 1 = n → lineCoreVanishesBelow n (P - P₀) → lineCoreVanishesBelow n (Q - Q₀) →
    MvPowerSeries.coeff d (P * Q) - MvPowerSeries.coeff d (P₀ * Q₀) =
      MvPowerSeries.coeff 0 Q₀ * MvPowerSeries.coeff d (P - P₀) +
        MvPowerSeries.coeff 0 P₀ * MvPowerSeries.coeff d (Q - Q₀)
  vanishesBelow_mul : ∀ {N₁ N₂ : ℕ} {A B : MvPowerSeries (Fin 2) ℂ},
    lineCoreVanishesBelow N₁ A → lineCoreVanishesBelow N₂ B →
    lineCoreVanishesBelow (N₁ + N₂) (A * B)
  vanishesBelow_comp1D_taylor : ∀ {N₀ : ℕ}, 1 ≤ N₀ → ∀ (f : PowerSeries ℂ)
    {U₀ η : MvPowerSeries (Fin 2) ℂ},
    MvPowerSeries.coeff 0 U₀ = 0 → lineCoreVanishesBelow N₀ η →
    lineCoreVanishesBelow (2 * N₀)
      (compPowerSeries2D f (U₀ + η) - compPowerSeries2D f U₀ -
        compPowerSeries2D (PowerSeries.derivative f) U₀ * η)
  coeff_pow_linear : ∀ {M ν : ℕ}, 1 ≤ M → ν ≤ M → ∀ {U : MvPowerSeries (Fin 2) ℂ},
    MvPowerSeries.coeff 0 U = 0 →
    MvPowerSeries.coeff (lineCoreIdx2D (M - ν) ν) (U ^ M) =
      (M.choose ν : ℂ) * (MvPowerSeries.coeff (lineCoreIdx2D 1 0) U) ^ (M - ν) *
        (MvPowerSeries.coeff (lineCoreIdx2D 0 1) U) ^ ν

noncomputable def lineCoreRadicals {Ω : Set Plane} (C : AnalyticGlancingCollar Ω) (k : ℕ)
    (Ψ : ℂ × ℂ → ℂ × ℂ) (a₁ δ₁ : ℝ) : Fin 6 → ℂ :=
  let q₁ := Ψ ((a₁ : ℂ), (δ₁ : ℂ))
  ![glancingOffset C q₁.1 q₁.2,
    glancingOffset C (q₁.1 + (k : ℂ) * q₁.2) q₁.2,
    Complex.cos ((a₁ : ℂ) / 2),
    Complex.sin ((a₁ : ℂ) / 2),
    Complex.cos (((a₁ : ℂ) + (δ₁ : ℂ)) / 2),
    Complex.sin (((a₁ : ℂ) + (δ₁ : ℂ)) / 2)]

noncomputable def lineCoreEndpointField {Ω : Set Plane} (C : AnalyticGlancingCollar Ω) (k : ℕ)
    (Ψ : ℂ × ℂ → ℂ × ℂ) (a₁ δ₁ : ℝ) : Subfield ℂ :=
  Subfield.closure
    ((linePointField C k Ψ a₁ δ₁ : Set ℂ) ∪
      Set.range (lineCoreRadicals C k Ψ a₁ δ₁))

abbrev LineCoreIdx (k : ℕ) : Type :=
  Sum (Fin (k + 1) × Bool) (Fin k × Fin (max 2 k + 1))

noncomputable def lineCoreCard (k : ℕ) : ℕ :=
  Fintype.card (LineCoreIdx k)

noncomputable def lineCoreTuple {Ω : Set Plane} (C : AnalyticGlancingCollar Ω)
    (B : BaseCollarAndCramerData C) (k : ℕ) (G : LineGlancingChartData C B k)
    (a₁ δ₁ : ℝ) : Fin (lineCoreCard k) → ℂ :=
  fun idx =>
    match (Fintype.equivFin (LineCoreIdx k)).symm idx with
    | Sum.inl (r, false) => Complex.cos (G.α_fn r ((a₁ : ℂ), (δ₁ : ℂ)) / 2)
    | Sum.inl (r, true) => Complex.sin (G.α_fn r ((a₁ : ℂ), (δ₁ : ℂ)) / 2)
    | Sum.inr (i, m) => iteratedDeriv (m : ℕ) C.h_ℂ (G.ψ_fn i ((a₁ : ℂ), (δ₁ : ℂ)))
noncomputable def skrCos2 (u : ℂ) : ℂ :=
  ∫ t in (0 : ℝ)..1, ((1 - t : ℝ) : ℂ) * Complex.cos ((t : ℂ) * u)

noncomputable def skrSinc (u : ℂ) : ℂ :=
  ∫ t in (0 : ℝ)..1, Complex.cos ((t : ℂ) * u)

noncomputable def skrRCos2 (u : ℂ) : ℂ :=
  -∫ t in (0 : ℝ)..1, ((1 - t : ℝ) : ℂ) * (t : ℂ) ^ 2 * skrCos2 ((t : ℂ) * u)

noncomputable def skrRSinc (u : ℂ) : ℂ :=
  -∫ t in (0 : ℝ)..1, (t : ℂ) ^ 2 * skrCos2 ((t : ℂ) * u)

noncomputable def skrExp1 (v : ℂ) : ℂ :=
  ∫ s in (0 : ℝ)..1, Complex.exp ((s : ℂ) * v)

noncomputable def skrSlopeW (W : ℂ → ℂ) (z : ℂ) (c : ℝ) (H : ℂ) : ℂ :=
  (c : ℂ) * ∫ η in (0 : ℝ)..1, deriv W (z + ((η * c : ℝ) : ℂ) * H)

noncomputable def skrKerRem1 (W : ℂ → ℂ) (τ : ℝ) (H z : ℂ) : ℂ :=
  let rI₁ : ℂ :=
    ∫ θ in (0 : ℝ)..1,
      let sw := skrSlopeW W z ((θ - 1) * τ) H
      sw * skrExp1 (H * sw)
  let I₁ : ℂ := 1 + H * rI₁
  let u₁ : ℂ := (τ : ℂ) * H * Complex.exp (W z) * I₁
  (τ : ℂ) ^ 2 *
    (2 * H * (τ : ℂ) ^ 2 * Complex.exp (2 * W z) * I₁ ^ 4 * skrRCos2 u₁ +
      (I₁ + 1) * rI₁)

noncomputable def skrKerRem2Integrand (W : ℂ → ℂ) (τ β : ℝ) (H z : ℂ) : ℂ :=
  let γ : ℝ := τ + β * (1 - τ)
  let rI₂ : ℂ :=
    ∫ θ in (0 : ℝ)..1,
      let sw := skrSlopeW W z (θ * γ - τ) H
      sw * skrExp1 (H * sw)
  let I₂ : ℂ := 1 + H * rI₂
  let u₂ : ℂ := (γ : ℂ) * H * Complex.exp (W z) * I₂
  let rs : ℂ := ((γ : ℂ) * Complex.exp (W z) * I₂) ^ 2 * skrRSinc u₂
  let S₂ : ℂ := 1 + H ^ 2 * rs
  let sw_b : ℂ := -2 * skrSlopeW W z (β * (1 - τ)) H
  let rE₂ : ℂ := sw_b * skrExp1 (H * sw_b)
  let E₂ : ℂ := 1 + H * rE₂
  (γ : ℂ) * (rI₂ * S₂ * E₂ + H * rs * E₂ + rE₂)

noncomputable def skrKerRem (W : ℂ → ℂ) (τ : ℝ) (H z : ℂ) : ℂ :=
  skrKerRem1 W τ H z -
    ((1 - τ : ℝ) : ℂ) * ∫ β in (0 : ℝ)..1, skrKerRem2Integrand W τ β H z

noncomputable def skrCompConst : ℕ → ℝ → ℝ
  | 0, _ => 1
  | p + 1, B => max 1 ((2 : ℝ) ^ p * max B 0 * skrCompConst p B)

def IsSkrStripBnd (p : ℕ) (σ' B : ℝ) (f : ℂ → ℂ) : Prop :=
  DifferentiableOn ℂ f (horizStrip σ') ∧
  ∀ k : ℕ, k ≤ p → ∀ z ∈ horizStrip σ', ‖iteratedDeriv k f z‖ ≤ B

structure SkrCalcToolkit : Prop where
  horizStrip_open_convex : ∀ H : ℝ, IsOpen (horizStrip H) ∧ Convex ℝ (horizStrip H)
  mem_horizStrip_of_tau_seg : ∀ (σ τ c : ℝ) (z H : ℂ),
    τ ∈ Set.Icc (0 : ℝ) 1 →
    c ∈ Set.Icc (-τ) (1 - τ) →
    z - (τ : ℂ) * H ∈ horizStrip σ →
    z + ((1 - τ : ℝ) : ℂ) * H ∈ horizStrip σ →
    z + (c : ℂ) * H ∈ horizStrip σ
  stripExt_deriv_props : ∀ (r₀ d : ℕ) (σ M₁ : ℝ) (w : ℝ → ℝ) (W : ℂ → ℂ),
    0 < σ →
    IsBoundedStripExt r₀ σ M₁ w W →
    d ≤ r₀ →
    DifferentiableOn ℂ (iteratedDeriv d W) (horizStrip σ) ∧
    ∀ j : ℕ, j + d ≤ r₀ → ∀ ζ ∈ horizStrip σ,
      ‖iteratedDeriv j (iteratedDeriv d W) ζ‖ ≤ M₁
  stripDiffSup_nonneg_and_le : ∀ (r₀ : ℕ) (σ M₁ : ℝ) (w₁ w₂ : ℝ → ℝ) (W₁ W₂ : ℂ → ℂ),
    0 < σ →
    IsBoundedStripExt r₀ σ M₁ w₁ W₁ →
    IsBoundedStripExt r₀ σ M₁ w₂ W₂ →
    0 ≤ stripDiffSup r₀ σ W₁ W₂ ∧
    ∀ (j d : ℕ), j + d ≤ r₀ → ∀ ζ ∈ horizStrip σ,
      ‖iteratedDeriv j (fun z => iteratedDeriv d W₁ z - iteratedDeriv d W₂ z) ζ‖ ≤
        stripDiffSup r₀ σ W₁ W₂
  bnd_const : ∀ (p : ℕ) (σ' : ℝ) (c : ℂ),
    IsSkrStripBnd p σ' ‖c‖ (fun _ => c)
  bnd_mono : ∀ {p : ℕ} {σ' B₁ B₂ : ℝ} {f : ℂ → ℂ},
    B₁ ≤ B₂ → IsSkrStripBnd p σ' B₁ f → IsSkrStripBnd p σ' B₂ f
  bnd_add : ∀ {p : ℕ} {σ' B₁ B₂ : ℝ} {f g : ℂ → ℂ},
    IsSkrStripBnd p σ' B₁ f → IsSkrStripBnd p σ' B₂ g →
    IsSkrStripBnd p σ' (B₁ + B₂) (fun z => f z + g z)
  bnd_sub : ∀ {p : ℕ} {σ' B₁ B₂ : ℝ} {f g : ℂ → ℂ},
    IsSkrStripBnd p σ' B₁ f → IsSkrStripBnd p σ' B₂ g →
    IsSkrStripBnd p σ' (B₁ + B₂) (fun z => f z - g z)
  bnd_neg : ∀ {p : ℕ} {σ' B : ℝ} {f : ℂ → ℂ},
    IsSkrStripBnd p σ' B f → IsSkrStripBnd p σ' B (fun z => -f z)
  bnd_const_mul : ∀ {p : ℕ} {σ' B : ℝ} (c : ℂ) {f : ℂ → ℂ},
    0 ≤ B → IsSkrStripBnd p σ' B f →
    IsSkrStripBnd p σ' (‖c‖ * B) (fun z => c * f z)
  bnd_mul : ∀ {p : ℕ} {σ' B₁ B₂ : ℝ} {f g : ℂ → ℂ},
    IsSkrStripBnd p σ' B₁ f → IsSkrStripBnd p σ' B₂ g →
    IsSkrStripBnd p σ' ((2 : ℝ) ^ p * B₁ * B₂) (fun z => f z * g z)
  bnd_mul_diff : ∀ {p : ℕ} {σ' M_f M_g Δf Δg : ℝ} {f₁ f₂ g₁ g₂ : ℂ → ℂ},
    IsSkrStripBnd p σ' M_f f₁ →
    IsSkrStripBnd p σ' M_g g₂ →
    IsSkrStripBnd p σ' Δf (fun z => f₁ z - f₂ z) →
    IsSkrStripBnd p σ' Δg (fun z => g₁ z - g₂ z) →
    IsSkrStripBnd p σ' ((2 : ℝ) ^ p * (M_f * Δg + Δf * M_g))
      (fun z => f₁ z * g₁ z - f₂ z * g₂ z)
  exp_ball_bnd : ∀ (R : ℝ),
    0 < R →
    DifferentiableOn ℂ Complex.exp (Metric.ball (0 : ℂ) R) ∧
    ∀ j : ℕ, ∀ w ∈ Metric.ball (0 : ℂ) R, ‖iteratedDeriv j Complex.exp w‖ ≤ Real.exp R
  cos_ball_bnd : ∀ (R : ℝ),
    0 < R →
    DifferentiableOn ℂ Complex.cos (Metric.ball (0 : ℂ) R) ∧
    ∀ j : ℕ, ∀ w ∈ Metric.ball (0 : ℂ) R, ‖iteratedDeriv j Complex.cos w‖ ≤ Real.exp R
  sin_ball_bnd : ∀ (R : ℝ),
    0 < R →
    DifferentiableOn ℂ Complex.sin (Metric.ball (0 : ℂ) R) ∧
    ∀ j : ℕ, ∀ w ∈ Metric.ball (0 : ℂ) R, ‖iteratedDeriv j Complex.sin w‖ ≤ Real.exp R
  comp_bnd : ∀ (p : ℕ) (σ' M_G B : ℝ) (V : Set ℂ) (G f : ℂ → ℂ),
    IsOpen V →
    0 ≤ M_G →
    0 ≤ B →
    DifferentiableOn ℂ G V →
    (∀ j : ℕ, j ≤ p → ∀ w ∈ V, ‖iteratedDeriv j G w‖ ≤ M_G) →
    DifferentiableOn ℂ f (horizStrip σ') →
    (∀ z ∈ horizStrip σ', f z ∈ V) →
    (∀ j : ℕ, 1 ≤ j → j ≤ p → ∀ z ∈ horizStrip σ', ‖iteratedDeriv j f z‖ ≤ B) →
    IsSkrStripBnd p σ' (M_G * skrCompConst p B) (fun z => G (f z))
  comp_diff_bnd : ∀ (p : ℕ) (σ' M_G ΔG B Δf : ℝ) (V : Set ℂ) (G₁ G₂ f₁ f₂ : ℂ → ℂ),
    IsOpen V →
    Convex ℝ V →
    0 ≤ M_G →
    0 ≤ ΔG →
    0 ≤ B →
    0 ≤ Δf →
    DifferentiableOn ℂ G₁ V →
    DifferentiableOn ℂ G₂ V →
    (∀ j : ℕ, j ≤ p → ∀ w ∈ V, ‖iteratedDeriv j (fun ζ => G₁ ζ - G₂ ζ) w‖ ≤ ΔG) →
    (∀ j : ℕ, j ≤ p + 1 → ∀ w ∈ V, ‖iteratedDeriv j G₂ w‖ ≤ M_G) →
    DifferentiableOn ℂ f₁ (horizStrip σ') →
    DifferentiableOn ℂ f₂ (horizStrip σ') →
    (∀ z ∈ horizStrip σ', f₁ z ∈ V) →
    (∀ z ∈ horizStrip σ', f₂ z ∈ V) →
    (∀ j : ℕ, 1 ≤ j → j ≤ p → ∀ z ∈ horizStrip σ', ‖iteratedDeriv j f₁ z‖ ≤ B) →
    (∀ j : ℕ, 1 ≤ j → j ≤ p → ∀ z ∈ horizStrip σ', ‖iteratedDeriv j f₂ z‖ ≤ B) →
    IsSkrStripBnd p σ' Δf (fun z => f₁ z - f₂ z) →
    IsSkrStripBnd p σ' (skrCompConst p B * (ΔG + (2 : ℝ) ^ p * M_G * Δf))
      (fun z => G₁ (f₁ z) - G₂ (f₂ z))
  comp_param_cont : ∀ (p : ℕ) (σ' : ℝ) (V : Set ℂ) (G : ℂ → ℂ) (f : ℝ → ℂ → ℂ),
    IsOpen V →
    0 < σ' →
    DifferentiableOn ℂ G V →
    (∀ α ∈ Set.Icc (0 : ℝ) 1,
      DifferentiableOn ℂ (f α) (horizStrip σ') ∧ ∀ z ∈ horizStrip σ', f α z ∈ V) →
    (∀ r : ℕ, r ≤ p → ∀ z ∈ horizStrip σ',
      ContinuousOn (fun α => iteratedDeriv r (f α) z) (Set.Icc (0 : ℝ) 1)) →
    ∀ k : ℕ, k ≤ p → ∀ z ∈ horizStrip σ',
      ContinuousOn (fun α => iteratedDeriv k (fun ζ => G (f α ζ)) z) (Set.Icc (0 : ℝ) 1)
  param_int_bnd : ∀ (p : ℕ) (σ' B : ℝ) (F : ℝ → ℂ → ℂ),
    0 < σ' →
    0 ≤ B →
    (∀ z ∈ horizStrip σ', ContinuousOn (fun t => F t z) (Set.Icc (0 : ℝ) 1)) →
    (∀ t ∈ Set.Icc (0 : ℝ) 1, IsSkrStripBnd p σ' B (F t)) →
    IsSkrStripBnd p σ' B (fun z => ∫ t in (0 : ℝ)..1, F t z) ∧
    ∀ k : ℕ, k ≤ p → ∀ z ∈ horizStrip σ',
      iteratedDeriv k (fun w => ∫ t in (0 : ℝ)..1, F t w) z =
        (∫ t in (0 : ℝ)..1, iteratedDeriv k (F t) z) ∧
      ContinuousOn (fun t => iteratedDeriv k (F t) z) (Set.Icc (0 : ℝ) 1)
  param_int_cont : ∀ (B : ℝ) (g : ℝ → ℝ → ℂ),
    0 ≤ B →
    (∀ u ∈ Set.Icc (0 : ℝ) 1, ContinuousOn (g u) (Set.Icc (0 : ℝ) 1)) →
    (∀ t ∈ Set.Icc (0 : ℝ) 1, ContinuousOn (fun u => g u t) (Set.Icc (0 : ℝ) 1)) →
    (∀ u ∈ Set.Icc (0 : ℝ) 1, ∀ t ∈ Set.Icc (0 : ℝ) 1, ‖g u t‖ ≤ B) →
    ContinuousOn (fun u => ∫ t in (0 : ℝ)..1, g u t) (Set.Icc (0 : ℝ) 1)

structure SkrPointwiseProp : Prop where
  plus_eq_minus : ∀ (W : ℂ → ℂ) (Y μ z : ℂ),
    cellKernelPlus_ℂ W Y μ z = cellKernelMinus_ℂ W Y μ z
  real_eq : ∀ (σ : ℝ) (w : ℝ → ℝ) (W : ℂ → ℂ),
    0 < σ →
    ContDiff ℝ (1 : WithTop ℕ∞) w →
    DifferentiableOn ℂ W (horizStrip σ) →
    (∀ x : ℝ, W x = w x) →
    ∀ X Y z : ℝ,
      cellKernelMinus_ℂ W X (midpoint_ℝ w X Y) z = cellKernelMinus_ℝ w X Y z ∧
      cellKernelPlus_ℂ W Y (midpoint_ℝ w X Y) z = cellKernelPlus_ℝ w X Y z
  diag_periodic : ∀ (σ : ℝ) (W : ℂ → ℂ),
    0 < σ →
    (∀ z ∈ horizStrip σ, W (z + 2 * Real.pi) = W z) →
    ∀ X Y μ z : ℂ,
      X ∈ horizStrip σ → Y ∈ horizStrip σ → μ ∈ horizStrip σ → z ∈ horizStrip σ →
      cellKernelMinus_ℂ W (X + 2 * Real.pi) (μ + 2 * Real.pi) (z + 2 * Real.pi) =
        cellKernelMinus_ℂ W X μ z ∧
      cellKernelPlus_ℂ W (Y + 2 * Real.pi) (μ + 2 * Real.pi) (z + 2 * Real.pi) =
        cellKernelPlus_ℂ W Y μ z
  factor_eq : ∀ (σ τ : ℝ) (W : ℂ → ℂ) (H z : ℂ),
    0 < σ →
    DifferentiableOn ℂ W (horizStrip σ) →
    τ ∈ Set.Icc (0 : ℝ) 1 →
    z ∈ horizStrip σ →
    z - (τ : ℂ) * H ∈ horizStrip σ →
    z + ((1 - τ : ℝ) : ℂ) * H ∈ horizStrip σ →
    cellKernelMinus_ℂ W (z - (τ : ℂ) * H) (z + ((1 - τ : ℝ) : ℂ) * H) z =
      (((3 / 2 : ℝ) * τ ^ 2 - 1 / 2 : ℝ) : ℂ) * H ^ 2 + H ^ 3 * skrKerRem W τ H z

structure SkrHalfStepSystem (m : ℕ) (M : ℝ) (S : StationaryMeshSystem m (M + 1))
    (H_inv : StripHalfCellInvSystem m M S) where
  C_step : ℝ
  N_step : ℕ
  C_step_pos : 0 < C_step
  N_inv_le : H_inv.N_inv ≤ N_step
  step_props : ∀ (σ : ℝ) (q : ℕ) (w : ℝ → ℝ) (W : ℂ → ℂ)
      (X_ℂ μ_ℂ : ℕ → ℂ → ℂ) (xInvMinus xInvPlus : ℕ → ℝ → ℂ → ℂ),
    σ ∈ Set.Ioc (0 : ℝ) 1 →
    N_step ≤ q →
    H_inv.K_inv / (q : ℝ) ^ 2 < 1 →
    IsAdmissibleStripInvTuple m M S H_inv.K_inv H_inv.C_inv σ q w W
      X_ℂ μ_ℂ xInvMinus xInvPlus →
    let σ_inv := (1 - H_inv.K_inv / (q : ℝ) ^ 2) * σ
    ∀ j : ℕ, j < q →
      let h_m : ℝ → ℂ → ℂ := fun α ζ =>
        μ_ℂ j (xInvMinus j α ζ) - X_ℂ j (xInvMinus j α ζ)
      let h_p : ℝ → ℂ → ℂ := fun α ζ =>
        X_ℂ (j + 1) (xInvPlus j α ζ) - μ_ℂ j (xInvPlus j α ζ)
      (∀ α ∈ Set.Icc (0 : ℝ) 1,
        DifferentiableOn ℂ (h_m α) (horizStrip σ_inv) ∧
        DifferentiableOn ℂ (h_p α) (horizStrip σ_inv) ∧
        (∀ ζ ∈ horizStrip σ_inv,
          ζ ∈ horizStrip σ ∧
          X_ℂ j (xInvMinus j α ζ) = ζ - (α : ℂ) * h_m α ζ ∧
          μ_ℂ j (xInvMinus j α ζ) = ζ + ((1 - α : ℝ) : ℂ) * h_m α ζ ∧
          X_ℂ (j + 1) (xInvPlus j α ζ) = ζ - ((1 - α : ℝ) : ℂ) * (-h_p α ζ) ∧
          μ_ℂ j (xInvPlus j α ζ) = ζ + (α : ℂ) * (-h_p α ζ) ∧
          X_ℂ j (xInvMinus j α ζ) ∈ horizStrip σ ∧
          μ_ℂ j (xInvMinus j α ζ) ∈ horizStrip σ ∧
          X_ℂ (j + 1) (xInvPlus j α ζ) ∈ horizStrip σ ∧
          μ_ℂ j (xInvPlus j α ζ) ∈ horizStrip σ) ∧
        (∀ k : ℕ, k ≤ m → ∀ z ∈ horizStrip σ_inv,
          (q : ℝ) ^ 2 *
            ‖iteratedDeriv k (fun ζ => h_m α ζ - ((Real.pi / (q : ℝ) : ℝ) : ℂ)) z‖ ≤
              C_step ∧
          (q : ℝ) ^ 2 *
            ‖iteratedDeriv k (fun ζ => h_p α ζ - ((Real.pi / (q : ℝ) : ℝ) : ℂ)) z‖ ≤
              C_step)) ∧
      (∀ k : ℕ, k ≤ m → ∀ z ∈ horizStrip σ_inv,
        ContinuousOn (fun α : ℝ => iteratedDeriv k (h_m α) z) (Set.Icc (0 : ℝ) 1) ∧
        ContinuousOn (fun α : ℝ => iteratedDeriv k (h_p α) z) (Set.Icc (0 : ℝ) 1))
  step_lip : ∀ (σ : ℝ) (q : ℕ)
      (w₁ w₂ : ℝ → ℝ) (W₁ W₂ : ℂ → ℂ)
      (X_ℂ₁ μ_ℂ₁ X_ℂ₂ μ_ℂ₂ : ℕ → ℂ → ℂ)
      (xInvMinus₁ xInvPlus₁ xInvMinus₂ xInvPlus₂ : ℕ → ℝ → ℂ → ℂ),
    σ ∈ Set.Ioc (0 : ℝ) 1 →
    N_step ≤ q →
    H_inv.K_inv / (q : ℝ) ^ 2 < 1 →
    IsAdmissibleStripInvTuple m M S H_inv.K_inv H_inv.C_inv σ q w₁ W₁
      X_ℂ₁ μ_ℂ₁ xInvMinus₁ xInvPlus₁ →
    IsAdmissibleStripInvTuple m M S H_inv.K_inv H_inv.C_inv σ q w₂ W₂
      X_ℂ₂ μ_ℂ₂ xInvMinus₂ xInvPlus₂ →
    let σ_inv := (1 - H_inv.K_inv / (q : ℝ) ^ 2) * σ
    ∀ j : ℕ, j < q → ∀ α ∈ Set.Icc (0 : ℝ) 1,
      let h_m₁ : ℂ → ℂ := fun ζ =>
        μ_ℂ₁ j (xInvMinus₁ j α ζ) - X_ℂ₁ j (xInvMinus₁ j α ζ)
      let h_m₂ : ℂ → ℂ := fun ζ =>
        μ_ℂ₂ j (xInvMinus₂ j α ζ) - X_ℂ₂ j (xInvMinus₂ j α ζ)
      let h_p₁ : ℂ → ℂ := fun ζ =>
        X_ℂ₁ (j + 1) (xInvPlus₁ j α ζ) - μ_ℂ₁ j (xInvPlus₁ j α ζ)
      let h_p₂ : ℂ → ℂ := fun ζ =>
        X_ℂ₂ (j + 1) (xInvPlus₂ j α ζ) - μ_ℂ₂ j (xInvPlus₂ j α ζ)
      ∀ k : ℕ, k ≤ m → ∀ z ∈ horizStrip σ_inv,
        (q : ℝ) ^ 2 * ‖iteratedDeriv k (fun ζ => h_m₁ ζ - h_m₂ ζ) z‖ ≤
          C_step * stripDiffSup (m + 15) σ W₁ W₂ ∧
        (q : ℝ) ^ 2 * ‖iteratedDeriv k (fun ζ => h_p₁ ζ - h_p₂ ζ) z‖ ≤
          C_step * stripDiffSup (m + 15) σ W₁ W₂

structure SkrReducedKernelSystem (m : ℕ) (M B_H : ℝ) where
  C_red : ℝ
  N_red : ℕ
  C_red_pos : 0 < C_red
  N_red_ge_four : 4 ≤ N_red
  reduced_props : ∀ (σ σ' sgn τ : ℝ) (q : ℕ) (w : ℝ → ℝ) (W H : ℂ → ℂ),
    σ ∈ Set.Ioc (0 : ℝ) 1 →
    0 < σ' →
    σ' ≤ σ →
    N_red ≤ q →
    (sgn = 1 ∨ sgn = -1) →
    IsPeriodicSmoothBounded (m + 15) M w →
    IsBoundedStripExt (m + 15) σ M w W →
    τ ∈ Set.Icc (0 : ℝ) 1 →
    DifferentiableOn ℂ H (horizStrip σ') →
    (∀ ζ ∈ horizStrip σ',
      ζ - (τ : ℂ) * H ζ ∈ horizStrip σ ∧
      ζ + ((1 - τ : ℝ) : ℂ) * H ζ ∈ horizStrip σ) →
    (∀ k : ℕ, k ≤ m → ∀ z ∈ horizStrip σ',
      (q : ℝ) ^ 2 *
        ‖iteratedDeriv k
          (fun ζ => H ζ - ((sgn * (Real.pi / (q : ℝ)) : ℝ) : ℂ)) z‖ ≤ B_H) →
    let G : ℂ → ℂ := fun ζ =>
      cellKernelMinus_ℂ W (ζ - (τ : ℂ) * H ζ) (ζ + ((1 - τ : ℝ) : ℂ) * H ζ) ζ
    DifferentiableOn ℂ G (horizStrip σ') ∧
    ∀ k : ℕ, k ≤ m → ∀ z ∈ horizStrip σ',
      (q : ℝ) ^ 3 *
        ‖iteratedDeriv k
          (fun ζ =>
            G ζ -
              (((Real.pi ^ 2 / (q : ℝ) ^ 2) *
                ((3 / 2 : ℝ) * τ ^ 2 - 1 / 2) : ℝ) : ℂ)) z‖ ≤ C_red
  reduced_param_cont : ∀ (σ σ' sgn : ℝ) (q : ℕ) (w : ℝ → ℝ) (W : ℂ → ℂ)
      (τ_fn : ℝ → ℝ) (H_fam : ℝ → ℂ → ℂ),
    σ ∈ Set.Ioc (0 : ℝ) 1 →
    0 < σ' →
    σ' ≤ σ →
    N_red ≤ q →
    (sgn = 1 ∨ sgn = -1) →
    IsPeriodicSmoothBounded (m + 15) M w →
    IsBoundedStripExt (m + 15) σ M w W →
    ContinuousOn τ_fn (Set.Icc (0 : ℝ) 1) →
    (∀ α ∈ Set.Icc (0 : ℝ) 1,
      τ_fn α ∈ Set.Icc (0 : ℝ) 1 ∧
      DifferentiableOn ℂ (H_fam α) (horizStrip σ') ∧
      (∀ ζ ∈ horizStrip σ',
        ζ - (τ_fn α : ℂ) * H_fam α ζ ∈ horizStrip σ ∧
        ζ + ((1 - τ_fn α : ℝ) : ℂ) * H_fam α ζ ∈ horizStrip σ) ∧
      (∀ k : ℕ, k ≤ m → ∀ z ∈ horizStrip σ',
        (q : ℝ) ^ 2 *
          ‖iteratedDeriv k
            (fun ζ => H_fam α ζ - ((sgn * (Real.pi / (q : ℝ)) : ℝ) : ℂ)) z‖ ≤ B_H)) →
    (∀ r : ℕ, r ≤ m → ∀ z ∈ horizStrip σ',
      ContinuousOn (fun α : ℝ => iteratedDeriv r (H_fam α) z) (Set.Icc (0 : ℝ) 1)) →
    ∀ k : ℕ, k ≤ m → ∀ z ∈ horizStrip σ',
      ContinuousOn
        (fun α : ℝ =>
          iteratedDeriv k
            (fun ζ =>
              cellKernelMinus_ℂ W
                (ζ - (τ_fn α : ℂ) * H_fam α ζ)
                (ζ + ((1 - τ_fn α : ℝ) : ℂ) * H_fam α ζ) ζ) z)
        (Set.Icc (0 : ℝ) 1)
  reduced_lip : ∀ (σ σ' sgn τ ΔH_scaled : ℝ) (q : ℕ)
      (w₁ w₂ : ℝ → ℝ) (W₁ W₂ H₁ H₂ : ℂ → ℂ),
    σ ∈ Set.Ioc (0 : ℝ) 1 →
    0 < σ' →
    σ' ≤ σ →
    N_red ≤ q →
    (sgn = 1 ∨ sgn = -1) →
    0 ≤ ΔH_scaled →
    IsPeriodicSmoothBounded (m + 15) M w₁ →
    IsPeriodicSmoothBounded (m + 15) M w₂ →
    IsBoundedStripExt (m + 15) σ M w₁ W₁ →
    IsBoundedStripExt (m + 15) σ M w₂ W₂ →
    τ ∈ Set.Icc (0 : ℝ) 1 →
    DifferentiableOn ℂ H₁ (horizStrip σ') →
    DifferentiableOn ℂ H₂ (horizStrip σ') →
    (∀ ζ ∈ horizStrip σ',
      ζ - (τ : ℂ) * H₁ ζ ∈ horizStrip σ ∧
      ζ + ((1 - τ : ℝ) : ℂ) * H₁ ζ ∈ horizStrip σ ∧
      ζ - (τ : ℂ) * H₂ ζ ∈ horizStrip σ ∧
      ζ + ((1 - τ : ℝ) : ℂ) * H₂ ζ ∈ horizStrip σ) →
    (∀ k : ℕ, k ≤ m → ∀ z ∈ horizStrip σ',
      (q : ℝ) ^ 2 *
        ‖iteratedDeriv k
          (fun ζ => H₁ ζ - ((sgn * (Real.pi / (q : ℝ)) : ℝ) : ℂ)) z‖ ≤ B_H ∧
      (q : ℝ) ^ 2 *
        ‖iteratedDeriv k
          (fun ζ => H₂ ζ - ((sgn * (Real.pi / (q : ℝ)) : ℝ) : ℂ)) z‖ ≤ B_H) →
    (∀ k : ℕ, k ≤ m → ∀ z ∈ horizStrip σ',
      (q : ℝ) ^ 2 * ‖iteratedDeriv k (fun ζ => H₁ ζ - H₂ ζ) z‖ ≤ ΔH_scaled) →
    let G₁ : ℂ → ℂ := fun ζ =>
      cellKernelMinus_ℂ W₁ (ζ - (τ : ℂ) * H₁ ζ) (ζ + ((1 - τ : ℝ) : ℂ) * H₁ ζ) ζ
    let G₂ : ℂ → ℂ := fun ζ =>
      cellKernelMinus_ℂ W₂ (ζ - (τ : ℂ) * H₂ ζ) (ζ + ((1 - τ : ℝ) : ℂ) * H₂ ζ) ζ
    ∀ k : ℕ, k ≤ m → ∀ z ∈ horizStrip σ',
      (q : ℝ) ^ 3 * ‖iteratedDeriv k (fun ζ => G₁ ζ - G₂ ζ) z‖ ≤
        C_red * (ΔH_scaled + stripDiffSup (m + 15) σ W₁ W₂)
def HasCJetBound_fcks (p : ℕ) (B : ℝ) (f : ℝ → ℝ) : Prop :=
  ContDiff ℝ (p : WithTop ℕ∞) f ∧
  0 ≤ B ∧
  ∀ k : ℕ, k ≤ p → ∀ x : ℝ, |iteratedDeriv k f x| ≤ B

def HasDerivJetBound_fcks (p : ℕ) (B : ℝ) (f : ℝ → ℝ) : Prop :=
  ContDiff ℝ (p : WithTop ℕ∞) f ∧
  0 ≤ B ∧
  ∀ k : ℕ, 1 ≤ k → k ≤ p → ∀ x : ℝ, |iteratedDeriv k f x| ≤ B

def compJetFactor_fcks : ℕ → ℝ → ℝ
  | 0, _ => 1
  | p + 1, B => 1 + (2 : ℝ) ^ p * B * compJetFactor_fcks p B

structure RealCJetToolkitProp_fcks : Prop where
  jet_const : ∀ (p : ℕ) (c : ℝ), HasCJetBound_fcks p |c| (fun _ => c)
  jet_mono : ∀ {p' p : ℕ} {B₁ B₂ : ℝ} {f : ℝ → ℝ},
    p' ≤ p → B₁ ≤ B₂ → HasCJetBound_fcks p B₁ f → HasCJetBound_fcks p' B₂ f
  jet_add : ∀ {p : ℕ} {B₁ B₂ : ℝ} {f g : ℝ → ℝ},
    HasCJetBound_fcks p B₁ f → HasCJetBound_fcks p B₂ g →
    HasCJetBound_fcks p (B₁ + B₂) (fun x => f x + g x)
  jet_sub : ∀ {p : ℕ} {B₁ B₂ : ℝ} {f g : ℝ → ℝ},
    HasCJetBound_fcks p B₁ f → HasCJetBound_fcks p B₂ g →
    HasCJetBound_fcks p (B₁ + B₂) (fun x => f x - g x)
  jet_const_mul : ∀ {p : ℕ} {B : ℝ} (c : ℝ) {f : ℝ → ℝ},
    HasCJetBound_fcks p B f → HasCJetBound_fcks p (|c| * B) (fun x => c * f x)
  jet_mul : ∀ {p : ℕ} {B₁ B₂ : ℝ} {f g : ℝ → ℝ},
    HasCJetBound_fcks p B₁ f → HasCJetBound_fcks p B₂ g →
    HasCJetBound_fcks p ((2 : ℝ) ^ p * B₁ * B₂) (fun x => f x * g x)
  jet_mul_diff : ∀ {p : ℕ} {M_f M_g L_f L_g : ℝ} {f₁ f₂ g₁ g₂ : ℝ → ℝ},
    HasCJetBound_fcks p M_f f₁ → HasCJetBound_fcks p M_f f₂ →
    HasCJetBound_fcks p M_g g₁ → HasCJetBound_fcks p M_g g₂ →
    HasCJetBound_fcks p L_f (fun x => f₁ x - f₂ x) →
    HasCJetBound_fcks p L_g (fun x => g₁ x - g₂ x) →
    HasCJetBound_fcks p ((2 : ℝ) ^ p * (L_f * M_g + M_f * L_g))
      (fun x => f₁ x * g₁ x - f₂ x * g₂ x)
  jet_comp_on : ∀ (p : ℕ) (S : Set ℝ) (M_g B_f : ℝ) (g f : ℝ → ℝ),
    ContDiff ℝ (p : WithTop ℕ∞) g →
    0 ≤ M_g →
    (∀ k : ℕ, k ≤ p → ∀ y ∈ S, |iteratedDeriv k g y| ≤ M_g) →
    HasDerivJetBound_fcks p B_f f →
    (∀ x : ℝ, f x ∈ S) →
    HasCJetBound_fcks p (M_g * compJetFactor_fcks p B_f) (fun x => g (f x))
  jet_comp_diff_on : ∀ (p : ℕ) (S : Set ℝ) (M_g L_g B_f L_f : ℝ) (g₁ g₂ f₁ f₂ : ℝ → ℝ),
    Convex ℝ S →
    ContDiff ℝ ((p + 1 : ℕ) : WithTop ℕ∞) g₁ →
    ContDiff ℝ ((p + 1 : ℕ) : WithTop ℕ∞) g₂ →
    0 ≤ M_g → 0 ≤ L_g →
    (∀ k : ℕ, k ≤ p + 1 → ∀ y ∈ S, |iteratedDeriv k g₂ y| ≤ M_g) →
    (∀ k : ℕ, k ≤ p → ∀ y ∈ S, |iteratedDeriv k (fun z => g₁ z - g₂ z) y| ≤ L_g) →
    HasDerivJetBound_fcks p B_f f₁ →
    HasDerivJetBound_fcks p B_f f₂ →
    (∀ x : ℝ, f₁ x ∈ S ∧ f₂ x ∈ S) →
    HasCJetBound_fcks p L_f (fun x => f₁ x - f₂ x) →
    HasCJetBound_fcks p
      (L_g * compJetFactor_fcks p B_f + (2 : ℝ) ^ p * L_f * (M_g * compJetFactor_fcks p B_f))
      (fun x => g₁ (f₁ x) - g₂ (f₂ x))
  jet_unit_integral : ∀ (p : ℕ) (B : ℝ) (G : ℝ → ℝ → ℝ),
    ContDiff ℝ (p : WithTop ℕ∞) (Function.uncurry G) →
    0 ≤ B →
    (∀ t ∈ Set.Icc (0 : ℝ) 1, HasCJetBound_fcks p B (G t)) →
    HasCJetBound_fcks p B (fun x : ℝ => ∫ t in (0 : ℝ)..1, G t x)
  contDiff_unit_integral_2d : ∀ (p : ℕ) (G : ℝ → ℝ × ℝ → ℝ),
    ContDiff ℝ (p : WithTop ℕ∞) (fun q : ℝ × (ℝ × ℝ) => G q.1 q.2) →
    ContDiff ℝ (p : WithTop ℕ∞) (fun z : ℝ × ℝ => ∫ t in (0 : ℝ)..1, G t z)
  contDiff_iteratedDeriv_snd : ∀ (p : ℕ) (F : ℝ → ℝ → ℝ),
    ContDiff ℝ (p : WithTop ℕ∞) (Function.uncurry F) →
    ∀ k : ℕ, k ≤ p →
      Continuous (fun q : ℝ × ℝ => iteratedDeriv k (F q.1) q.2)
  periodic_diff_jet : ∀ (r₀ : ℕ) (w₁ w₂ : ℝ → ℝ),
    Function.Periodic w₁ (2 * Real.pi) →
    Function.Periodic w₂ (2 * Real.pi) →
    ContDiff ℝ (r₀ : WithTop ℕ∞) w₁ →
    ContDiff ℝ (r₀ : WithTop ℕ∞) w₂ →
    HasCJetBound_fcks r₀ (realDiffSup r₀ w₁ w₂) (fun x => w₁ x - w₂ x)

noncomputable def realSinc_fcks (u : ℝ) : ℝ :=
  ∫ s in (0 : ℝ)..1, Real.cos (s * u)

noncomputable def realCos2_fcks (u : ℝ) : ℝ :=
  ∫ s in (0 : ℝ)..1, (1 - s) * Real.cos (s * u)

def cellDeltaW_fcks (w B H : ℝ → ℝ) (c x : ℝ) : ℝ :=
  w (B x + c * H x) - w (B x)

noncomputable def cellExpAvgJ_fcks (w B H : ℝ → ℝ) (c x : ℝ) : ℝ :=
  ∫ θ in (0 : ℝ)..1, Real.exp (w (B x + (θ * c) * H x) - w (B x))

noncomputable def cellDeltaPhi_fcks (w B H : ℝ → ℝ) (c x : ℝ) : ℝ :=
  c * H x * Real.exp (w (B x)) * cellExpAvgJ_fcks w B H c x

noncomputable def rescaledCellKernel_fcks (w B H : ℝ → ℝ) (β x : ℝ) : ℝ :=
  H x ^ 2 *
    (2 * β ^ 2 * (cellExpAvgJ_fcks w B H β x) ^ 2 *
        realCos2_fcks (cellDeltaPhi_fcks w B H β x) *
        Real.exp (-2 * cellDeltaW_fcks w B H β x) -
      (1 - β) * ∫ τ in (0 : ℝ)..1,
        (let γ := β + (1 - β) * τ
         γ * cellExpAvgJ_fcks w B H γ x *
           realSinc_fcks (cellDeltaPhi_fcks w B H γ x) *
           Real.exp (cellDeltaW_fcks w B H β x - 2 * cellDeltaW_fcks w B H γ x)))

def IsCellBaseStepPair_fcks (p : ℕ) (R₀ : ℝ) (q : ℕ) (σ_sgn : ℝ) (B H : ℝ → ℝ) : Prop :=
  (σ_sgn = 1 ∨ σ_sgn = -1) ∧
  (∃ (ρ : ℝ) (d : ℝ → ℝ),
    (∀ x : ℝ, B x = x + ρ + d x) ∧
    HasCJetBound_fcks p (R₀ / (q : ℝ) ^ 2) d) ∧
  HasCJetBound_fcks p (2 * R₀ / (q : ℝ) ^ 2) (fun x => H x - σ_sgn * Real.pi / (q : ℝ))

def IsCellBaseStepDiff_fcks (p : ℕ) (R₀ : ℝ) (q : ℕ) (Δ : ℝ)
    (B₁ H₁ B₂ H₂ : ℝ → ℝ) : Prop :=
  0 ≤ Δ ∧
  HasCJetBound_fcks p ((R₀ / (q : ℝ) ^ 2) * Δ) (fun x => B₁ x - B₂ x) ∧
  HasCJetBound_fcks p ((2 * R₀ / (q : ℝ) ^ 2) * Δ) (fun x => H₁ x - H₂ x)

noncomputable def cellBaseMinus_fcks (q : ℕ) (w : ℝ → ℝ) (j : ℕ) (x : ℝ) : ℝ :=
  realMesh q w x j

noncomputable def cellStepMinus_fcks (q : ℕ) (w : ℝ → ℝ) (j : ℕ) (x : ℝ) : ℝ :=
  midpoint_ℝ w (realMesh q w x j) (realMesh q w x (j + 1)) - realMesh q w x j

noncomputable def cellBasePlus_fcks (q : ℕ) (w : ℝ → ℝ) (j : ℕ) (x : ℝ) : ℝ :=
  realMesh q w x (j + 1)

noncomputable def cellStepPlus_fcks (q : ℕ) (w : ℝ → ℝ) (j : ℕ) (x : ℝ) : ℝ :=
  midpoint_ℝ w (realMesh q w x j) (realMesh q w x (j + 1)) - realMesh q w x (j + 1)
noncomputable abbrev lineArcHoloTaylor1D : (ℂ → ℂ) → ℂ → PowerSeries ℂ :=
  holoTaylor1D

noncomputable def lineArcEpsJet (m : ℕ) (F : ℂ → ℂ) : ℂ :=
  iteratedDeriv m F 0 / (m.factorial : ℂ)

noncomputable def lineArcPertSupport {k J : ℕ} (h_ℂ : ℂ → ℂ)
    (g : Fin k → Fin (J + 1) → ℂ → ℂ) (ε : ℂ) (i : Fin k) (z : ℂ) : ℂ :=
  h_ℂ z + ∑ m : Fin (J + 1), ε ^ (m : ℕ) * g i m z

noncomputable def lineArcPertSupportDeriv {k J : ℕ} (h_ℂ : ℂ → ℂ)
    (g : Fin k → Fin (J + 1) → ℂ → ℂ) (ε : ℂ) (i : Fin k) (z : ℂ) : ℂ :=
  deriv h_ℂ z + ∑ m : Fin (J + 1), ε ^ (m : ℕ) * deriv (g i m) z

noncomputable def lineArcPertAngles {k J : ℕ} (α₀ : Fin (k + 1) → ℂ)
    (β : Fin (J + 1) → Fin (k + 1) → ℂ) (ε : ℂ) (s : Fin (k + 1)) : ℂ :=
  α₀ s + ∑ m : Fin (J + 1), ε ^ (m : ℕ) * β m s

noncomputable def lineArcPack2D1D (F : ℕ → MvPowerSeries (Fin 2) ℂ) :
    MvPowerSeries (Fin 2) (PowerSeries ℂ) :=
  fun d => PowerSeries.mk (fun l => MvPowerSeries.coeff d (F l))

noncomputable def lineArcSlice2D1D (l : ℕ) (S : MvPowerSeries (Fin 2) (PowerSeries ℂ)) :
    MvPowerSeries (Fin 2) ℂ :=
  fun d => PowerSeries.coeff l (MvPowerSeries.coeff d S)

noncomputable def lineArcComp2D1D (g_seq : ℕ → PowerSeries ℂ)
    (Z : MvPowerSeries (Fin 2) (PowerSeries ℂ)) :
    MvPowerSeries (Fin 2) (PowerSeries ℂ) :=
  fun d =>
    PowerSeries.mk (fun m =>
      PowerSeries.coeff m
        (MvPowerSeries.coeff d
          (∑ n ∈ Finset.range (d 0 + d 1 + m + 1),
            MvPowerSeries.C (PowerSeries.mk (fun l => PowerSeries.coeff n (g_seq l))) * Z ^ n)))

noncomputable def lineArcPsSin0 : PowerSeries ℂ :=
  lineArcHoloTaylor1D Complex.sin 0

noncomputable def lineArcPsCos0 : PowerSeries ℂ :=
  lineArcHoloTaylor1D Complex.cos 0

noncomputable def lineArcCompConst2D1D (φ : PowerSeries ℂ)
    (Z : MvPowerSeries (Fin 2) (PowerSeries ℂ)) :
    MvPowerSeries (Fin 2) (PowerSeries ℂ) :=
  lineArcComp2D1D (fun l => if l = 0 then φ else 0) Z

noncomputable def lineArcFormalMid2D1D {k : ℕ}
    (β_seq : ℕ → Fin (k + 1) → MvPowerSeries (Fin 2) ℂ) (i : Fin k) :
    MvPowerSeries (Fin 2) (PowerSeries ℂ) :=
  lineArcPack2D1D (fun l => (β_seq l i.castSucc + β_seq l i.succ) * MvPowerSeries.C (1 / 2 : ℂ))

noncomputable def lineArcFormalHalfStep2D1D {k : ℕ}
    (β_seq : ℕ → Fin (k + 1) → MvPowerSeries (Fin 2) ℂ) (i : Fin k) :
    MvPowerSeries (Fin 2) (PowerSeries ℂ) :=
  lineArcPack2D1D (fun l => (β_seq l i.succ - β_seq l i.castSucc) * MvPowerSeries.C (1 / 2 : ℂ))

noncomputable def lineArcFormalSin2D1D {k : ℕ} (sin_d0 cos_d0 : Fin k → ℂ)
    (β_seq : ℕ → Fin (k + 1) → MvPowerSeries (Fin 2) ℂ) (i : Fin k) :
    MvPowerSeries (Fin 2) (PowerSeries ℂ) :=
  MvPowerSeries.C (PowerSeries.C (sin_d0 i)) *
      lineArcCompConst2D1D lineArcPsCos0 (lineArcFormalHalfStep2D1D β_seq i) +
    MvPowerSeries.C (PowerSeries.C (cos_d0 i)) *
      lineArcCompConst2D1D lineArcPsSin0 (lineArcFormalHalfStep2D1D β_seq i)

noncomputable def lineArcFormalCos2D1D {k : ℕ} (sin_d0 cos_d0 : Fin k → ℂ)
    (β_seq : ℕ → Fin (k + 1) → MvPowerSeries (Fin 2) ℂ) (i : Fin k) :
    MvPowerSeries (Fin 2) (PowerSeries ℂ) :=
  MvPowerSeries.C (PowerSeries.C (cos_d0 i)) *
      lineArcCompConst2D1D lineArcPsCos0 (lineArcFormalHalfStep2D1D β_seq i) -
    MvPowerSeries.C (PowerSeries.C (sin_d0 i)) *
      lineArcCompConst2D1D lineArcPsSin0 (lineArcFormalHalfStep2D1D β_seq i)

noncomputable def lineArcFormalAction2D1D {k : ℕ} (sin_d0 cos_d0 : Fin k → ℂ)
    (f_seq : Fin k → ℕ → PowerSeries ℂ)
    (β_seq : ℕ → Fin (k + 1) → MvPowerSeries (Fin 2) ℂ) :
    MvPowerSeries (Fin 2) (PowerSeries ℂ) :=
  ∑ i : Fin k,
    2 * lineArcComp2D1D (f_seq i) (lineArcFormalMid2D1D β_seq i) *
      lineArcFormalSin2D1D sin_d0 cos_d0 β_seq i

noncomputable def lineArcFormalGrad2D1D {k : ℕ} (sin_d0 cos_d0 : Fin k → ℂ)
    (f_seq : Fin k → ℕ → PowerSeries ℂ)
    (β_seq : ℕ → Fin (k + 1) → MvPowerSeries (Fin 2) ℂ)
    (r : Fin (k - 1)) :
    MvPowerSeries (Fin 2) (PowerSeries ℂ) :=
  let i_L : Fin k := ⟨r.1, by have := r.2; omega⟩
  let i_R : Fin k := ⟨r.1 + 1, by have := r.2; omega⟩
  lineArcComp2D1D (fun l => PowerSeries.derivative (f_seq i_L l))
      (lineArcFormalMid2D1D β_seq i_L) *
      lineArcFormalSin2D1D sin_d0 cos_d0 β_seq i_L +
    lineArcComp2D1D (f_seq i_L) (lineArcFormalMid2D1D β_seq i_L) *
      lineArcFormalCos2D1D sin_d0 cos_d0 β_seq i_L +
    lineArcComp2D1D (fun l => PowerSeries.derivative (f_seq i_R l))
      (lineArcFormalMid2D1D β_seq i_R) *
      lineArcFormalSin2D1D sin_d0 cos_d0 β_seq i_R -
    lineArcComp2D1D (f_seq i_R) (lineArcFormalMid2D1D β_seq i_R) *
      lineArcFormalCos2D1D sin_d0 cos_d0 β_seq i_R

noncomputable def lineArcTruncSupport {k : ℕ} (J : ℕ)
    (f_full : Fin k → ℕ → PowerSeries ℂ) : Fin k → ℕ → PowerSeries ℂ :=
  fun i l => if l ≤ J then f_full i l else 0

noncomputable def lineArcTruncBeta {k : ℕ} (J : ℕ)
    (β_full : ℕ → Fin (k + 1) → MvPowerSeries (Fin 2) ℂ) :
    ℕ → Fin (k + 1) → MvPowerSeries (Fin 2) ℂ :=
  fun l r => if l ≤ J then β_full l r else 0

structure LineArcJetAndTaylorToolkit : Prop where
  taylor2D_const : ∀ (p₀ : ℂ × ℂ) (c : ℂ), taylor2D (fun _ => c) p₀ = MvPowerSeries.C c
  taylor2D_linear_coords : ∀ (p₀ : ℂ × ℂ),
    centeredTaylor2D Prod.fst p₀ = MvPowerSeries.X 0 ∧
    centeredTaylor2D Prod.snd p₀ = MvPowerSeries.X 1
  taylor2D_congr : ∀ {U : Set (ℂ × ℂ)}, IsOpen U → ∀ {p₀ : ℂ × ℂ}, p₀ ∈ U →
    ∀ {f₁ f₂ : ℂ × ℂ → ℂ}, (∀ p ∈ U, f₁ p = f₂ p) → taylor2D f₁ p₀ = taylor2D f₂ p₀
  taylor2D_ring : ∀ {U : Set (ℂ × ℂ)}, IsOpen U → ∀ {p₀ : ℂ × ℂ}, p₀ ∈ U →
    ∀ {f g : ℂ × ℂ → ℂ}, DifferentiableOn ℂ f U → DifferentiableOn ℂ g U →
      taylor2D (fun p => f p + g p) p₀ = taylor2D f p₀ + taylor2D g p₀ ∧
      taylor2D (fun p => f p - g p) p₀ = taylor2D f p₀ - taylor2D g p₀ ∧
      taylor2D (fun p => f p * g p) p₀ = taylor2D f p₀ * taylor2D g p₀
  taylor2D_comp_1D : ∀ {U : Set (ℂ × ℂ)} {W : Set ℂ}, IsOpen U → IsOpen W →
    ∀ {p₀ : ℂ × ℂ}, p₀ ∈ U → ∀ {ψ : ℂ × ℂ → ℂ} {g : ℂ → ℂ},
      DifferentiableOn ℂ ψ U → DifferentiableOn ℂ g W → (∀ p ∈ U, ψ p ∈ W) →
      taylor2D (fun p => g (ψ p)) p₀ =
        compPowerSeries2D (lineArcHoloTaylor1D g (ψ p₀)) (centeredTaylor2D ψ p₀)
  epsJet_trunc_eq : ∀ {k J₁ J₂ l : ℕ} (_hJ : J₁ ≤ J₂) (_hl1 : 1 ≤ l) (_hlJ : l ≤ J₁)
    {W_ψ : Set ℂ} (_hW : IsOpen W_ψ) {h_ℂ : ℂ → ℂ} (_hh : DifferentiableOn ℂ h_ℂ W_ψ)
    {g₁ : Fin k → Fin (J₁ + 1) → ℂ → ℂ} {g₂ : Fin k → Fin (J₂ + 1) → ℂ → ℂ}
    (_hg₁ : ∀ i m, DifferentiableOn ℂ (g₁ i m) W_ψ)
    (_hg₂ : ∀ i m, DifferentiableOn ℂ (g₂ i m) W_ψ)
    (_hg₁0 : ∀ i z, g₁ i 0 z = 0) (_hg₂0 : ∀ i z, g₂ i 0 z = 0)
    (_hg_eq : ∀ i (m : Fin (J₁ + 1)), ∀ z ∈ W_ψ, g₂ i ⟨m.1, by omega⟩ z = g₁ i m z)
    {α₀ : Fin (k + 1) → ℂ} (_hmid : ∀ i : Fin k, lineChainMid α₀ i ∈ W_ψ)
    {β₁ : Fin (J₁ + 1) → Fin (k + 1) → ℂ} {β₂ : Fin (J₂ + 1) → Fin (k + 1) → ℂ}
    (_hβ₁0 : ∀ s, β₁ 0 s = 0) (_hβ₂0 : ∀ s, β₂ 0 s = 0)
    (_hβ_eq : ∀ (m : Fin (J₁ + 1)) s, β₂ ⟨m.1, by omega⟩ s = β₁ m s),
    lineArcEpsJet l
        (fun ε => lineChainAction (lineArcPertSupport h_ℂ g₂ ε) (lineArcPertAngles α₀ β₂ ε)) =
      lineArcEpsJet l
        (fun ε => lineChainAction (lineArcPertSupport h_ℂ g₁ ε) (lineArcPertAngles α₀ β₁ ε)) ∧
    ∀ r : Fin (k - 1),
      lineArcEpsJet l
          (fun ε =>
            lineInteriorGrad (lineArcPertSupport h_ℂ g₂ ε)
              (lineArcPertSupportDeriv h_ℂ g₂ ε) (lineArcPertAngles α₀ β₂ ε) r) =
        lineArcEpsJet l
          (fun ε =>
            lineInteriorGrad (lineArcPertSupport h_ℂ g₁ ε)
              (lineArcPertSupportDeriv h_ℂ g₁ ε) (lineArcPertAngles α₀ β₁ ε) r)
  epsJet_holo : ∀ {k J : ℕ} (m : ℕ) {W_ψ : Set ℂ} {V : Set (ℂ × ℂ)}
    (_hW : IsOpen W_ψ) (_hV : IsOpen V) {h_ℂ : ℂ → ℂ} (_hh : DifferentiableOn ℂ h_ℂ W_ψ)
    {g : Fin k → Fin (J + 1) → ℂ → ℂ} (_hg : ∀ i l, DifferentiableOn ℂ (g i l) W_ψ)
    (_hg0 : ∀ i z, g i 0 z = 0) {α₀ : Fin (k + 1) → ℂ × ℂ → ℂ}
    (_hα₀ : ∀ s, DifferentiableOn ℂ (α₀ s) V)
    (_hmid : ∀ q ∈ V, ∀ i : Fin k, lineChainMid (fun s => α₀ s q) i ∈ W_ψ)
    {β : Fin (J + 1) → Fin (k + 1) → ℂ × ℂ → ℂ}
    (_hβ : ∀ l s, DifferentiableOn ℂ (β l s) V) (_hβ0 : ∀ s q, β 0 s q = 0),
    DifferentiableOn ℂ
      (fun q =>
        lineArcEpsJet m
          (fun ε =>
            lineChainAction (lineArcPertSupport h_ℂ g ε)
              (lineArcPertAngles (fun s => α₀ s q) (fun l s => β l s q) ε)))
      V ∧
    ∀ r : Fin (k - 1),
      DifferentiableOn ℂ
        (fun q =>
          lineArcEpsJet m
            (fun ε =>
              lineInteriorGrad (lineArcPertSupport h_ℂ g ε)
                (lineArcPertSupportDeriv h_ℂ g ε)
                (lineArcPertAngles (fun s => α₀ s q) (fun l s => β l s q) ε) r))
        V
  epsJet_succ_split : ∀ {k J : ℕ} (_hk : 2 ≤ k) {W_ψ : Set ℂ} (_hW : IsOpen W_ψ)
    {h_ℂ : ℂ → ℂ} (_hh : DifferentiableOn ℂ h_ℂ W_ψ)
    {g : Fin k → Fin (J + 1) → ℂ → ℂ} {g_top : Fin k → ℂ → ℂ}
    (_hg : ∀ i l, DifferentiableOn ℂ (g i l) W_ψ)
    (_hg_top : ∀ i, DifferentiableOn ℂ (g_top i) W_ψ)
    (_hg0 : ∀ i z, g i 0 z = 0) {α₀ : Fin (k + 1) → ℂ}
    (_hmid : ∀ i : Fin k, lineChainMid α₀ i ∈ W_ψ)
    {β : Fin (J + 1) → Fin (k + 1) → ℂ} {β_top : Fin (k + 1) → ℂ}
    (_hβ0 : ∀ s, β 0 s = 0) (_hβ_top_end : β_top 0 = 0 ∧ β_top (Fin.last k) = 0),
    let g_ext : Fin k → Fin (J + 1 + 1) → ℂ → ℂ := fun i => Fin.snoc (g i) (g_top i)
    let β_ext : Fin (J + 1 + 1) → Fin (k + 1) → ℂ := Fin.snoc β β_top
    let β_zero_top : Fin (J + 1 + 1) → Fin (k + 1) → ℂ := Fin.snoc β (fun _ => 0)
    lineArcEpsJet (J + 1)
        (fun ε => lineChainAction (lineArcPertSupport h_ℂ g_ext ε) (lineArcPertAngles α₀ β_ext ε)) =
      lineArcEpsJet (J + 1)
        (fun ε => lineChainAction (lineArcPertSupport h_ℂ g ε) (lineArcPertAngles α₀ β ε)) +
      (∑ i : Fin k, 2 * Complex.sin (lineChainHalfStep α₀ i) * g_top i (lineChainMid α₀ i)) +
      (∑ r : Fin (k - 1),
        lineInteriorGrad (fun _ => h_ℂ) (fun _ => deriv h_ℂ) α₀ r *
          β_top ⟨r.1 + 1, by have := r.2; omega⟩) ∧
    ∀ r : Fin (k - 1),
      lineArcEpsJet (J + 1)
          (fun ε =>
            lineInteriorGrad (lineArcPertSupport h_ℂ g_ext ε)
              (lineArcPertSupportDeriv h_ℂ g_ext ε) (lineArcPertAngles α₀ β_ext ε) r) =
        lineArcEpsJet (J + 1)
          (fun ε =>
            lineInteriorGrad (lineArcPertSupport h_ℂ g_ext ε)
              (lineArcPertSupportDeriv h_ℂ g_ext ε) (lineArcPertAngles α₀ β_zero_top ε) r) +
        ∑ s : Fin (k - 1),
          lineInteriorHess (fun _ => h_ℂ) (fun _ => deriv h_ℂ) (fun _ => deriv (deriv h_ℂ))
            α₀ r s * β_top ⟨s.1 + 1, by have := s.2; omega⟩
  taylor2D_epsJet_eq : ∀ {k J : ℕ} (m : ℕ) {W_ψ : Set ℂ} {V : Set (ℂ × ℂ)} {p₁ : ℂ × ℂ}
    (_hW : IsOpen W_ψ) (_hV : IsOpen V) (_hp₁ : p₁ ∈ V)
    {h_ℂ : ℂ → ℂ} (_hh : DifferentiableOn ℂ h_ℂ W_ψ)
    {g : Fin k → Fin (J + 1) → ℂ → ℂ} (_hg : ∀ i l, DifferentiableOn ℂ (g i l) W_ψ)
    (_hg0 : ∀ i z, g i 0 z = 0) {α₀ : Fin (k + 1) → ℂ × ℂ → ℂ}
    (_hα₀ : ∀ s, DifferentiableOn ℂ (α₀ s) V)
    (_hmid : ∀ q ∈ V, ∀ i : Fin k, lineChainMid (fun s => α₀ s q) i ∈ W_ψ)
    {β : Fin (J + 1) → Fin (k + 1) → ℂ × ℂ → ℂ}
    (_hβ : ∀ l s, DifferentiableOn ℂ (β l s) V) (_hβ0 : ∀ s q, β 0 s q = 0),
    let sin_d0 := fun i => Complex.sin (lineChainHalfStep (fun s => α₀ s p₁) i)
    let cos_d0 := fun i => Complex.cos (lineChainHalfStep (fun s => α₀ s p₁) i)
    let f_seq : Fin k → ℕ → PowerSeries ℂ := fun i l =>
      if l = 0 then lineArcHoloTaylor1D h_ℂ (lineChainMid (fun s => α₀ s p₁) i)
      else if hl : l < J + 1 then lineArcHoloTaylor1D (g i ⟨l, hl⟩) (lineChainMid (fun s => α₀ s p₁) i)
      else 0
    let β_seq : ℕ → Fin (k + 1) → MvPowerSeries (Fin 2) ℂ := fun l s =>
      if l = 0 then centeredTaylor2D (α₀ s) p₁
      else if hl : l < J + 1 then taylor2D (β ⟨l, hl⟩ s) p₁
      else 0
    taylor2D
        (fun q =>
          lineArcEpsJet m
            (fun ε =>
              lineChainAction (lineArcPertSupport h_ℂ g ε)
                (lineArcPertAngles (fun s => α₀ s q) (fun l s => β l s q) ε)))
        p₁ =
      lineArcSlice2D1D m (lineArcFormalAction2D1D sin_d0 cos_d0 f_seq β_seq) ∧
    ∀ r : Fin (k - 1),
      taylor2D
          (fun q =>
            lineArcEpsJet m
              (fun ε =>
                lineInteriorGrad (lineArcPertSupport h_ℂ g ε)
                  (lineArcPertSupportDeriv h_ℂ g ε)
                  (lineArcPertAngles (fun s => α₀ s q) (fun l s => β l s q) ε) r))
          p₁ =
        lineArcSlice2D1D m (lineArcFormalGrad2D1D sin_d0 cos_d0 f_seq β_seq r)

structure LineArcFormalDeformationData {Ω : Set Plane} (C : AnalyticGlancingCollar Ω)
    (B : BaseCollarAndCramerData C) (k : ℕ) (G : LineGlancingChartData C B k)
    (a₁ δ₁ : ℝ) where
  p : ℕ
  p_pos : 1 ≤ p
  i₀ : Fin k
  f_full : Fin k → ℕ → PowerSeries ℂ
  β_full : ℕ → Fin (k + 1) → MvPowerSeries (Fin 2) ℂ
  K_seq : ℕ → ℂ
  f_zero : ∀ i : Fin k, f_full i 0 = lineArcHoloTaylor1D C.h_ℂ (G.ψ_fn i ((a₁ : ℂ), (δ₁ : ℂ)))
  β_zero : ∀ r : Fin (k + 1), β_full 0 r = centeredTaylor2D (G.α_fn r) ((a₁ : ℂ), (δ₁ : ℂ))
  β_endpoints : ∀ l : ℕ, 1 ≤ l → β_full l 0 = 0 ∧ β_full l (Fin.last k) = 0
  f_lead_ne_zero : f_full i₀ p ≠ 0
  vanish_lt_p : ∀ l : ℕ, 1 ≤ l → l < p →
    (∀ i : Fin k, f_full i l = 0) ∧ (∀ r : Fin (k + 1), β_full l r = 0) ∧ K_seq l = 0
  formal_web_step : ∀ J : ℕ,
    lineArcSlice2D1D (J + 1)
        (lineArcFormalAction2D1D
          (fun i => Complex.sin (G.d_fn i ((a₁ : ℂ), (δ₁ : ℂ))))
          (fun i => Complex.cos (G.d_fn i ((a₁ : ℂ), (δ₁ : ℂ))))
          (lineArcTruncSupport J f_full)
          (lineArcTruncBeta J β_full)) +
      ∑ i : Fin k,
        taylor2D (G.w_fn i) ((a₁ : ℂ), (δ₁ : ℂ)) *
          compPowerSeries2D (f_full i (J + 1))
            (centeredTaylor2D (G.ψ_fn i) ((a₁ : ℂ), (δ₁ : ℂ))) =
      MvPowerSeries.C (K_seq (J + 1))
  formal_hess_step : ∀ J : ℕ, ∀ r : Fin (k - 1),
    lineArcSlice2D1D (J + 1)
        (lineArcFormalGrad2D1D
          (fun i => Complex.sin (G.d_fn i ((a₁ : ℂ), (δ₁ : ℂ))))
          (fun i => Complex.cos (G.d_fn i ((a₁ : ℂ), (δ₁ : ℂ))))
          (lineArcTruncSupport (J + 1) f_full)
          (lineArcTruncBeta J β_full)
          r) +
      ∑ s : Fin (k - 1),
        taylor2D
          (fun q =>
            lineInteriorHess (fun _ => C.h_ℂ) (fun _ => deriv C.h_ℂ)
              (fun _ => deriv (deriv C.h_ℂ)) (fun u => G.α_fn u q) r s)
          ((a₁ : ℂ), (δ₁ : ℂ)) *
        β_full (J + 1) ⟨s.1 + 1, by have := s.2; omega⟩ = 0

structure LineArcStepAnalyticData {Ω : Set Plane} (C : AnalyticGlancingCollar Ω)
    (B : BaseCollarAndCramerData C) (k : ℕ) (G : LineGlancingChartData C B k)
    (a₁ δ₁ : ℝ) (D_form : LineArcFormalDeformationData C B k G a₁ δ₁) (J : ℕ) where
  W_ψ : Set ℂ
  V_plus : Set (ℂ × ℂ)
  g : Fin k → Fin (J + 1) → ℂ → ℂ
  β : Fin (J + 1) → Fin (k + 1) → ℂ × ℂ → ℂ
  W_ψ_open : IsOpen W_ψ
  W_ψ_preconn : IsPreconnected W_ψ
  W_ψ_sub_strip : W_ψ ⊆ horizStrip (2 * C.s_h)
  real_mem_W_ψ : ∀ x : ℝ, |x - G.a₀| < G.R → (x : ℂ) ∈ W_ψ
  base_ψ_mem : ∀ i : Fin k, G.ψ_fn i ((a₁ : ℂ), (δ₁ : ℂ)) ∈ W_ψ
  V_plus_open : IsOpen V_plus
  V_plus_preconn : IsPreconnected V_plus
  V_plus_sub : V_plus ⊆ G.U_a ×ˢ G.U_d
  trapezoid_mem_V_plus : ∀ q ∈ webTrapezoid G.a₀ G.R G.δ_star G.C₀,
    ((q.1 : ℂ), (q.2 : ℂ)) ∈ V_plus
  ψ_maps_W_ψ : ∀ q ∈ V_plus, ∀ i : Fin k, G.ψ_fn i q ∈ W_ψ
  hess_det_ne_zero : ∀ q ∈ V_plus,
    (lineInteriorHess (fun _ => C.h_ℂ) (fun _ => deriv C.h_ℂ)
      (fun _ => deriv (deriv C.h_ℂ)) (fun s => G.α_fn s q)).det ≠ 0
  g_holo : ∀ (i : Fin k) (l : Fin (J + 1)), DifferentiableOn ℂ (g i l) W_ψ
  g_lt_p : ∀ (i : Fin k) (l : Fin (J + 1)), (l : ℕ) < D_form.p → ∀ z : ℂ, g i l z = 0
  g_taylor : ∀ (i : Fin k) (l : Fin (J + 1)), 1 ≤ (l : ℕ) →
    lineArcHoloTaylor1D (g i l) (G.ψ_fn i ((a₁ : ℂ), (δ₁ : ℂ))) = D_form.f_full i (l : ℕ)
  β_holo : ∀ (l : Fin (J + 1)) (r : Fin (k + 1)), DifferentiableOn ℂ (β l r) V_plus
  β_zero : ∀ (r : Fin (k + 1)) (q : ℂ × ℂ), β 0 r q = 0
  β_endpoints : ∀ (l : Fin (J + 1)) (q : ℂ × ℂ), β l 0 q = 0 ∧ β l (Fin.last k) q = 0
  β_taylor : ∀ (l : Fin (J + 1)) (r : Fin (k + 1)), 1 ≤ (l : ℕ) →
    taylor2D (β l r) ((a₁ : ℂ), (δ₁ : ℂ)) = D_form.β_full (l : ℕ) r
  grad_jet_zero : ∀ q ∈ V_plus, ∀ r : Fin (k - 1), ∀ l : ℕ, 1 ≤ l → l ≤ J →
    lineArcEpsJet l
      (fun ε =>
        lineInteriorGrad (lineArcPertSupport C.h_ℂ g ε)
          (lineArcPertSupportDeriv C.h_ℂ g ε)
          (lineArcPertAngles (fun s => G.α_fn s q) (fun m s => β m s q) ε) r) = 0
  action_jet_const : ∀ q ∈ V_plus, ∀ (l : Fin (J + 1)), 1 ≤ (l : ℕ) →
    lineArcEpsJet (l : ℕ)
      (fun ε =>
        lineChainAction (lineArcPertSupport C.h_ℂ g ε)
          (lineArcPertAngles (fun s => G.α_fn s q) (fun m s => β m s q) ε)) =
      D_form.K_seq (l : ℕ)
noncomputable def shciShiftMinus (q j : ℕ) (α : ℝ) : ℝ :=
  ((j : ℝ) + α / 2) * (2 * Real.pi / (q : ℝ))

noncomputable def shciShiftPlus (q j : ℕ) (α : ℝ) : ℝ :=
  ((j : ℝ) + (1 + α) / 2) * (2 * Real.pi / (q : ℝ))

noncomputable def shciPerturbMinus (q : ℕ) (X_ℂ μ_ℂ : ℕ → ℂ → ℂ)
    (j : ℕ) (α : ℝ) (ζ : ℂ) : ℂ :=
  (X_ℂ j ζ + (α : ℂ) * (μ_ℂ j ζ - X_ℂ j ζ)) - (ζ + (shciShiftMinus q j α : ℂ))

noncomputable def shciPerturbPlus (q : ℕ) (X_ℂ μ_ℂ : ℕ → ℂ → ℂ)
    (j : ℕ) (α : ℝ) (ζ : ℂ) : ℂ :=
  (μ_ℂ j ζ + (α : ℂ) * (X_ℂ (j + 1) ζ - μ_ℂ j ζ)) - (ζ + (shciShiftPlus q j α : ℂ))

def IsShciShiftPerturb (r_max : ℕ) (σ₁ δ_e ρ : ℝ) (g_ℝ : ℝ → ℝ) (e : ℂ → ℂ) : Prop :=
  DifferentiableOn ℂ e (horizStrip σ₁) ∧
  (∀ ζ ∈ horizStrip σ₁, e (ζ + 2 * Real.pi) = e ζ) ∧
  (∀ ζ ∈ horizStrip σ₁, e (starRingEnd ℂ ζ) = starRingEnd ℂ (e ζ)) ∧
  (∀ x : ℝ, (x : ℂ) + (ρ : ℂ) + e x = (g_ℝ x : ℂ)) ∧
  (∀ r : ℕ, r ≤ r_max → ∀ ζ ∈ horizStrip σ₁, ‖iteratedDeriv r e ζ‖ ≤ δ_e)

def IsShciShiftRightInv (σ₁ σ₂ ρ : ℝ) (e x_inv : ℂ → ℂ) : Prop :=
  DifferentiableOn ℂ x_inv (horizStrip σ₂) ∧
  (∀ z ∈ horizStrip σ₂, x_inv z ∈ horizStrip σ₁) ∧
  (∀ z ∈ horizStrip σ₂, x_inv z + (ρ : ℂ) + e (x_inv z) = z)

noncomputable def shciPicardSeq (ρ : ℝ) (e : ℂ → ℂ) : ℕ → ℂ → ℂ
  | 0, _ => 0
  | n + 1, z => -e (z - (ρ : ℂ) + shciPicardSeq ρ e n z)

noncomputable def shciShiftInv (ρ : ℝ) (e : ℂ → ℂ) (z : ℂ) : ℂ :=
  z - (ρ : ℂ) + Filter.limUnder Filter.atTop (fun n => shciPicardSeq ρ e n z)

noncomputable def shciInvOneAdd (w : ℂ) : ℂ :=
  (1 + w)⁻¹

noncomputable def shciCompConst : ℕ → ℝ → ℝ
  | 0, _ => 1
  | s + 1, B => (2 : ℝ) ^ s * B * shciCompConst s B

noncomputable def shciCompDiffConst : ℕ → ℝ → ℝ
  | 0, _ => 1
  | s + 1, B => (2 : ℝ) ^ s * (B * shciCompDiffConst s B + shciCompConst s B)

noncomputable def shciJetB : ℕ → ℝ
  | 0 => 2
  | k + 1 =>
      let B := shciJetB k
      let G := shciCompConst k B
      max B ((2 : ℝ) ^ k * ((k.factorial : ℝ) * (2 : ℝ) ^ (k + 1)) * G * shciCompConst k G)

noncomputable def shciJetL : ℕ → ℝ
  | 0 => 2
  | k + 1 =>
      let B := shciJetB k
      let G := shciCompConst k B
      let L := shciJetL k
      let D := L * shciCompDiffConst k B + shciCompConst k B
      max L ((((k + 1).factorial : ℝ) * (2 : ℝ) ^ (k + 2)) * D * shciCompDiffConst k G)
noncomputable def trapPDE_seg (z₀ z : ℂ) (s : ℝ) : ℂ :=
  (1 - s) • z₀ + s • z

noncomputable def trapPDE_picardIter {ι : Type} [Fintype ι]
    (z₀ : ℂ) (M : ℂ × ℂ → Matrix ι ι ℂ) (c : ℂ × ℂ → (ι → ℂ)) (v₀ : ℂ → (ι → ℂ)) :
    ℕ → ℂ × ℂ → (ι → ℂ)
  | 0, p => v₀ p.1
  | n + 1, p => fun idx =>
      v₀ p.1 idx +
        ∫ s in (0 : ℝ)..1,
          (p.2 - z₀) *
            (((M (p.1, trapPDE_seg z₀ p.2 s)).mulVec
                (trapPDE_picardIter z₀ M c v₀ n (p.1, trapPDE_seg z₀ p.2 s)) +
              c (p.1, trapPDE_seg z₀ p.2 s)) idx)

noncomputable def trapPDE_picardSol {ι : Type} [Fintype ι]
    (z₀ : ℂ) (M : ℂ × ℂ → Matrix ι ι ℂ) (c : ℂ × ℂ → (ι → ℂ)) (v₀ : ℂ → (ι → ℂ))
    (p : ℂ × ℂ) (idx : ι) : ℂ :=
  v₀ p.1 idx +
    ∑' n : ℕ,
      (trapPDE_picardIter z₀ M c v₀ (n + 1) p idx -
        trapPDE_picardIter z₀ M c v₀ n p idx)

structure TrapPDE_ODEKit : Prop where
  solve_param_D :
    ∀ (ι : Type) [Fintype ι] [DecidableEq ι]
      (Ω_par Ω_z : Set ℂ),
      IsOpen Ω_par → IsOpen Ω_z → Convex ℝ Ω_z →
      ∀ (z₀ : ℂ), z₀ ∈ Ω_z →
      ∀ (M : ℂ × ℂ → Matrix ι ι ℂ) (c : ℂ × ℂ → (ι → ℂ)) (v₀ : ℂ → (ι → ℂ)),
        (∀ idx j : ι, DifferentiableOn ℂ (fun p => M p idx j) (Ω_par ×ˢ Ω_z)) →
        (∀ idx : ι, DifferentiableOn ℂ (fun p => c p idx) (Ω_par ×ˢ Ω_z)) →
        (∀ idx : ι, DifferentiableOn ℂ (fun w => v₀ w idx) Ω_par) →
        ∃ u : ℂ × ℂ → (ι → ℂ),
          (∀ idx : ι, DifferentiableOn ℂ (fun p => u p idx) (Ω_par ×ˢ Ω_z)) ∧
          (∀ w ∈ Ω_par, u (w, z₀) = v₀ w) ∧
          (∀ w ∈ Ω_par, ∀ z ∈ Ω_z, ∀ idx : ι,
            pderivD (fun q => u q idx) (w, z) =
              ((M (w, z)).mulVec (u (w, z)) + c (w, z)) idx)
  solve_param_A :
    ∀ (ι : Type) [Fintype ι] [DecidableEq ι]
      (Ω_z Ω_par : Set ℂ),
      IsOpen Ω_z → Convex ℝ Ω_z → IsOpen Ω_par →
      ∀ (z₀ : ℂ), z₀ ∈ Ω_z →
      ∀ (M : ℂ × ℂ → Matrix ι ι ℂ) (c : ℂ × ℂ → (ι → ℂ)) (v₀ : ℂ → (ι → ℂ)),
        (∀ idx j : ι, DifferentiableOn ℂ (fun p => M p idx j) (Ω_z ×ˢ Ω_par)) →
        (∀ idx : ι, DifferentiableOn ℂ (fun p => c p idx) (Ω_z ×ˢ Ω_par)) →
        (∀ idx : ι, DifferentiableOn ℂ (fun w => v₀ w idx) Ω_par) →
        ∃ u : ℂ × ℂ → (ι → ℂ),
          (∀ idx : ι, DifferentiableOn ℂ (fun p => u p idx) (Ω_z ×ˢ Ω_par)) ∧
          (∀ w ∈ Ω_par, u (z₀, w) = v₀ w) ∧
          (∀ z ∈ Ω_z, ∀ w ∈ Ω_par, ∀ idx : ι,
            pderivA (fun q => u q idx) (z, w) =
              ((M (z, w)).mulVec (u (z, w)) + c (z, w)) idx)
  unique_1D :
    ∀ (ι : Type) [Fintype ι] [DecidableEq ι]
      (Ω_z : Set ℂ), IsOpen Ω_z → Convex ℝ Ω_z →
      ∀ (z₀ : ℂ), z₀ ∈ Ω_z →
      ∀ (M_z : ℂ → Matrix ι ι ℂ) (c_z : ℂ → (ι → ℂ)) (u₁ u₂ : ℂ → (ι → ℂ)),
        (∀ idx j : ι, ContinuousOn (fun z => M_z z idx j) Ω_z) →
        (∀ idx : ι, DifferentiableOn ℂ (fun z => u₁ z idx) Ω_z) →
        (∀ idx : ι, DifferentiableOn ℂ (fun z => u₂ z idx) Ω_z) →
        u₁ z₀ = u₂ z₀ →
        (∀ z ∈ Ω_z, ∀ idx : ι,
          deriv (fun ζ => u₁ ζ idx) z = ((M_z z).mulVec (u₁ z) + c_z z) idx) →
        (∀ z ∈ Ω_z, ∀ idx : ι,
          deriv (fun ζ => u₂ ζ idx) z = ((M_z z).mulVec (u₂ z) + c_z z) idx) →
        ∀ z ∈ Ω_z, u₁ z = u₂ z

def trapCrect (x_lo x_hi η : ℝ) : Set ℂ :=
  { z : ℂ | x_lo - η < z.re ∧ z.re < x_hi + η ∧ |z.im| < η }

structure TrapPDE_AnchoredChart {ι : Type} [Fintype ι]
    (a₁ δ₁ : ℝ) (U_ode : Set (ℂ × ℂ))
    (M_a M_δ : ℂ × ℂ → Matrix ι ι ℂ)
    (c_a c_δ : ℂ × ℂ → (ι → ℂ))
    (v_init : ι → ℂ) where
  R_a : Set ℂ
  R_δ : Set ℂ
  R_δ_spine : Set ℂ
  γ : ℂ → (ι → ℂ)
  W : ℂ × ℂ → (ι → ℂ)
  hRa_open : IsOpen R_a
  hRa_conv : Convex ℝ R_a
  hRδ_open : IsOpen R_δ
  hRδ_conv : Convex ℝ R_δ
  hRδ_sp_open : IsOpen R_δ_spine
  hRδ_sp_conv : Convex ℝ R_δ_spine
  ha₁_mem : (a₁ : ℂ) ∈ R_a
  hδ₁_mem : (δ₁ : ℂ) ∈ R_δ_spine
  hRδ_sub_sp : R_δ ⊆ R_δ_spine
  hsp_sub_U : ∀ δ ∈ R_δ_spine, ((a₁ : ℂ), δ) ∈ U_ode
  hrect_sub_U : R_a ×ˢ R_δ ⊆ U_ode
  hγ_holo : ∀ idx : ι, DifferentiableOn ℂ (fun δ => γ δ idx) R_δ_spine
  hγ_init : γ (δ₁ : ℂ) = v_init
  hγ_ode : ∀ δ ∈ R_δ_spine, ∀ idx : ι,
    deriv (fun ζ => γ ζ idx) δ =
      ((M_δ ((a₁ : ℂ), δ)).mulVec (γ δ) + c_δ ((a₁ : ℂ), δ)) idx
  hW_holo : ∀ idx : ι, DifferentiableOn ℂ (fun p => W p idx) (R_a ×ˢ R_δ)
  hW_spine : ∀ δ ∈ R_δ, W ((a₁ : ℂ), δ) = γ δ
  hW_pde_a : ∀ p ∈ R_a ×ˢ R_δ, ∀ idx : ι,
    pderivA (fun q => W q idx) p = ((M_a p).mulVec (W p) + c_a p) idx
  hW_pde_δ : ∀ p ∈ R_a ×ˢ R_δ, ∀ idx : ι,
    pderivD (fun q => W q idx) p = ((M_δ p).mulVec (W p) + c_δ p) idx
noncomputable def pointCoreIdx2D (a b : ℕ) : Fin 2 →₀ ℕ :=
  Finsupp.equivFunOnFinite.symm ![a, b]

noncomputable def pointCoreComp2D (F U₁ U₂ : MvPowerSeries (Fin 2) ℂ) :
    MvPowerSeries (Fin 2) ℂ :=
  fun d =>
    ∑ a ∈ Finset.range (d 0 + d 1 + 1),
      ∑ b ∈ Finset.range (d 0 + d 1 + 1),
        MvPowerSeries.coeff (pointCoreIdx2D a b) F *
          MvPowerSeries.coeff d (U₁ ^ a * U₂ ^ b)

def pointCoreCoeffsIn (L : Subfield ℂ) (S : MvPowerSeries (Fin 2) ℂ) : Prop :=
  ∀ d : Fin 2 →₀ ℕ, MvPowerSeries.coeff d S ∈ L

def pointCoreVanishesBelow (N : ℕ) (S : MvPowerSeries (Fin 2) ℂ) : Prop :=
  ∀ d : Fin 2 →₀ ℕ, d 0 + d 1 < N → MvPowerSeries.coeff d S = 0

noncomputable def pointCoreInvSqrt1p (u : ℂ) : ℂ :=
  (sqrt1p u)⁻¹

abbrev PointCoreIdx (k : ℕ) : Type :=
  Sum (Fin (k + 1)) (Sum (Fin k) (Fin (k + 1) × Fin (max 2 k + 1)))

noncomputable def pointCoreCard (k : ℕ) : ℕ :=
  Fintype.card (PointCoreIdx k)

noncomputable def pointCoreTuple {Ω : Set Plane} (C : AnalyticGlancingCollar Ω)
    (B : BaseCollarAndCramerData C) (k : ℕ) (G : PointGlancingChartData C B k)
    (a₁ δ₁ : ℝ) : Fin (pointCoreCard k) → ℂ :=
  fun idx =>
    match (Fintype.equivFin (PointCoreIdx k)).symm idx with
    | Sum.inl r => G.x_fn r ((a₁ : ℂ), (δ₁ : ℂ))
    | Sum.inr (Sum.inl i) => G.ℓ_fn i ((a₁ : ℂ), (δ₁ : ℂ))
    | Sum.inr (Sum.inr (r, m)) =>
        iteratedDeriv (m : ℕ) G.F (G.x_fn r ((a₁ : ℂ), (δ₁ : ℂ)))

structure PointCoreSeriesToolkit : Prop where
  centeredTaylor2D_fst : ∀ p₀ : ℂ × ℂ, centeredTaylor2D Prod.fst p₀ = MvPowerSeries.X 0
  centeredTaylor2D_snd : ∀ p₀ : ℂ × ℂ, centeredTaylor2D Prod.snd p₀ = MvPowerSeries.X 1
  taylor2D_comp_2D : ∀ {U V : Set (ℂ × ℂ)},
    IsOpen U → IsOpen V → ∀ {p₀ : ℂ × ℂ}, p₀ ∈ U →
    ∀ {Ψ : ℂ × ℂ → ℂ × ℂ} {f : ℂ × ℂ → ℂ},
      DifferentiableOn ℂ Ψ U → DifferentiableOn ℂ f V → (∀ p ∈ U, Ψ p ∈ V) →
      taylor2D (fun p => f (Ψ p)) p₀ =
        pointCoreComp2D (taylor2D f (Ψ p₀))
          (centeredTaylor2D (fun p => (Ψ p).1) p₀)
          (centeredTaylor2D (fun p => (Ψ p).2) p₀)
  C_mem : ∀ (L : Subfield ℂ) {c : ℂ}, c ∈ L → pointCoreCoeffsIn L (MvPowerSeries.C c)
  X_mem : ∀ (L : Subfield ℂ) (s : Fin 2), pointCoreCoeffsIn L (MvPowerSeries.X s)
  add_mem : ∀ (L : Subfield ℂ) {S T : MvPowerSeries (Fin 2) ℂ},
    pointCoreCoeffsIn L S → pointCoreCoeffsIn L T → pointCoreCoeffsIn L (S + T)
  sub_mem : ∀ (L : Subfield ℂ) {S T : MvPowerSeries (Fin 2) ℂ},
    pointCoreCoeffsIn L S → pointCoreCoeffsIn L T → pointCoreCoeffsIn L (S - T)
  mul_mem : ∀ (L : Subfield ℂ) {S T : MvPowerSeries (Fin 2) ℂ},
    pointCoreCoeffsIn L S → pointCoreCoeffsIn L T → pointCoreCoeffsIn L (S * T)
  mvDerivA_mem : ∀ (L : Subfield ℂ) {S : MvPowerSeries (Fin 2) ℂ},
    pointCoreCoeffsIn L S → pointCoreCoeffsIn L (mvDerivA S)
  mvDerivD_mem : ∀ (L : Subfield ℂ) {S : MvPowerSeries (Fin 2) ℂ},
    pointCoreCoeffsIn L S → pointCoreCoeffsIn L (mvDerivD S)
  comp1D_mem : ∀ (L : Subfield ℂ) {f : PowerSeries ℂ} {U : MvPowerSeries (Fin 2) ℂ},
    (∀ n : ℕ, PowerSeries.coeff n f ∈ L) → MvPowerSeries.coeff 0 U = 0 →
    pointCoreCoeffsIn L U → pointCoreCoeffsIn L (compPowerSeries2D f U)
  comp2D_mem : ∀ (L : Subfield ℂ) {F U₁ U₂ : MvPowerSeries (Fin 2) ℂ},
    pointCoreCoeffsIn L F → MvPowerSeries.coeff 0 U₁ = 0 → MvPowerSeries.coeff 0 U₂ = 0 →
    pointCoreCoeffsIn L U₁ → pointCoreCoeffsIn L U₂ →
    pointCoreCoeffsIn L (pointCoreComp2D F U₁ U₂)
  mixed_of_derivAD_mem : ∀ (L : Subfield ℂ) {S : MvPowerSeries (Fin 2) ℂ},
    pointCoreCoeffsIn L (mvDerivD (mvDerivA S)) →
    ∀ d : Fin 2 →₀ ℕ, 1 ≤ d 0 → 1 ≤ d 1 → MvPowerSeries.coeff d S ∈ L
  inv_mem : ∀ (L : Subfield ℂ) {S T : MvPowerSeries (Fin 2) ℂ},
    S * T = 1 → pointCoreCoeffsIn L T → pointCoreCoeffsIn L S
  sqrt_mem : ∀ (L : Subfield ℂ) {S T : MvPowerSeries (Fin 2) ℂ},
    S ^ 2 = T → pointCoreCoeffsIn L T → MvPowerSeries.coeff 0 S ∈ L →
    MvPowerSeries.coeff 0 S ≠ 0 → pointCoreCoeffsIn L S
  mulVec_mem : ∀ (L : Subfield ℂ) {ι : Type} [Fintype ι] [DecidableEq ι]
    {A : Matrix ι ι ℂ} {x b : ι → ℂ},
    (∀ r s : ι, A r s ∈ L) → A.det ≠ 0 → (∀ r : ι, b r ∈ L) → A.mulVec x = b →
    ∀ r : ι, x r ∈ L
  inv2D_mem : ∀ (L : Subfield ℂ) {Φ₁ Φ₂ Ψ₁ Ψ₂ : MvPowerSeries (Fin 2) ℂ},
    MvPowerSeries.coeff 0 Φ₁ = 0 → MvPowerSeries.coeff 0 Φ₂ = 0 →
    MvPowerSeries.coeff 0 Ψ₁ = 0 → MvPowerSeries.coeff 0 Ψ₂ = 0 →
    pointCoreCoeffsIn L Φ₁ → pointCoreCoeffsIn L Φ₂ →
    pointCoreComp2D Φ₁ Ψ₁ Ψ₂ = MvPowerSeries.X 0 →
    pointCoreComp2D Φ₂ Ψ₁ Ψ₂ = MvPowerSeries.X 1 →
    pointCoreCoeffsIn L Ψ₁ ∧ pointCoreCoeffsIn L Ψ₂
  coeff_comp1D_pert : ∀ {n : ℕ}, 1 ≤ n → ∀ (f : PowerSeries ℂ)
    {U₀ η : MvPowerSeries (Fin 2) ℂ} {d : Fin 2 →₀ ℕ},
    d 0 + d 1 = n → MvPowerSeries.coeff 0 U₀ = 0 → pointCoreVanishesBelow n η →
    MvPowerSeries.coeff d (compPowerSeries2D f (U₀ + η)) =
      MvPowerSeries.coeff d (compPowerSeries2D f U₀) +
        PowerSeries.coeff 1 f * MvPowerSeries.coeff d η
  coeff_mul_pert : ∀ {n : ℕ}, 1 ≤ n → ∀ {P P₀ Q Q₀ : MvPowerSeries (Fin 2) ℂ}
    {d : Fin 2 →₀ ℕ},
    d 0 + d 1 = n → pointCoreVanishesBelow n (P - P₀) → pointCoreVanishesBelow n (Q - Q₀) →
    MvPowerSeries.coeff d (P * Q) - MvPowerSeries.coeff d (P₀ * Q₀) =
      MvPowerSeries.coeff 0 Q₀ * MvPowerSeries.coeff d (P - P₀) +
        MvPowerSeries.coeff 0 P₀ * MvPowerSeries.coeff d (Q - Q₀)
  vanishesBelow_mul : ∀ {N₁ N₂ : ℕ} {A B : MvPowerSeries (Fin 2) ℂ},
    pointCoreVanishesBelow N₁ A → pointCoreVanishesBelow N₂ B →
    pointCoreVanishesBelow (N₁ + N₂) (A * B)
  vanishesBelow_comp1D_taylor : ∀ {N₀ : ℕ}, 1 ≤ N₀ → ∀ (f : PowerSeries ℂ)
    {U₀ η : MvPowerSeries (Fin 2) ℂ},
    MvPowerSeries.coeff 0 U₀ = 0 → pointCoreVanishesBelow N₀ η →
    pointCoreVanishesBelow (2 * N₀)
      (compPowerSeries2D f (U₀ + η) - compPowerSeries2D f U₀ -
        compPowerSeries2D (PowerSeries.derivative f) U₀ * η)
  coeff_pow_linear : ∀ {M ν : ℕ}, 1 ≤ M → ν ≤ M → ∀ {U : MvPowerSeries (Fin 2) ℂ},
    MvPowerSeries.coeff 0 U = 0 →
    MvPowerSeries.coeff (pointCoreIdx2D (M - ν) ν) (U ^ M) =
      (M.choose ν : ℂ) * (MvPowerSeries.coeff (pointCoreIdx2D 1 0) U) ^ (M - ν) *
        (MvPowerSeries.coeff (pointCoreIdx2D 0 1) U) ^ ν
def c1_moab : ℕ → ℝ → ℝ
  | 0, _ => 1
  | p + 1, B => (1 + (2 : ℝ) ^ p * max 1 B) * c1_moab p B

def c2_moab : ℕ → ℝ → ℝ
  | 0, _ => 1
  | p + 1, B => 1 + (2 : ℝ) ^ p * (c1_moab p B + max 1 B * c2_moab p B)

def cCalc_moab (p : ℕ) (B : ℝ) : ℝ :=
  max (c1_moab p B) (c2_moab p B)

def HasCJetℂ_moab (p : ℕ) (B : ℝ) (F : ℝ → ℂ) : Prop :=
  ContDiff ℝ (p : WithTop ℕ∞) F ∧
  0 ≤ B ∧
  ∀ k : ℕ, k ≤ p → ∀ z : ℝ, ‖iteratedDeriv k F z‖ ≤ B

noncomputable def rawCellIntegrand_moab (n : ℤ) (w : ℝ → ℝ) (j : ℕ) (α z : ℝ) : ℂ :=
  let q := n.natAbs
  let x_m := halfCellInvMinus_ℝ q w j α z
  let X_m := realMesh q w x_m j
  let Y_m := realMesh q w x_m (j + 1)
  let μ_m := midpoint_ℝ w X_m Y_m
  let term_m : ℂ :=
    ((cellKernelMinus_ℝ w X_m Y_m z * (μ_m - X_m) *
      deriv (halfCellInvMinus_ℝ q w j α) z : ℝ) : ℂ) *
      Complex.exp (-Complex.I * (n : ℂ) * ((x_m - z : ℝ) : ℂ))
  let x_p := halfCellInvPlus_ℝ q w j α z
  let X_p := realMesh q w x_p j
  let Y_p := realMesh q w x_p (j + 1)
  let μ_p := midpoint_ℝ w X_p Y_p
  let term_p : ℂ :=
    ((cellKernelPlus_ℝ w X_p Y_p z * (Y_p - μ_p) *
      deriv (halfCellInvPlus_ℝ q w j α) z : ℝ) : ℂ) *
      Complex.exp (-Complex.I * (n : ℂ) * ((x_p - z : ℝ) : ℂ))
  term_m + term_p

noncomputable def leadCellIntegrand_moab (n : ℤ) (α : ℝ) : ℂ :=
  let q : ℝ := (n.natAbs : ℝ)
  let σ_n : ℝ := (n : ℝ) / q
  ((Real.pi / q ^ 3 : ℝ) : ℂ) *
    ((k0Minus α : ℂ) * Complex.exp (Complex.I * ((Real.pi * σ_n * α : ℝ) : ℂ)) +
     (k0Plus α : ℂ) * Complex.exp (Complex.I * ((Real.pi * σ_n * (1 + α) : ℝ) : ℂ)))
noncomputable def sqmcFluxOp (t₀ : ℝ) (a ξ : ℕ → ℂ) : ℕ → ℂ
  | 0 => 0
  | j + 1 =>
      ((t₀ : ℂ)⁻¹) ^ 2 *
        (a (j + 1) * (ξ (j + 2) - ξ (j + 1)) - a j * (ξ (j + 1) - ξ j))

noncomputable def sqmcFluxCumSum (t₀ : ℝ) (F : ℕ → ℂ) (j : ℕ) : ℂ :=
  (t₀ : ℂ) ^ 2 * ∑ i ∈ Finset.range j, F (i + 1)

noncomputable def sqmcFluxInit (q : ℕ) (t₀ : ℝ) (a F : ℕ → ℂ) : ℂ :=
  -(∑ j ∈ Finset.range q, (a j)⁻¹ * sqmcFluxCumSum t₀ F j) /
    (∑ j ∈ Finset.range q, (a j)⁻¹)

noncomputable def sqmcFluxInv (q : ℕ) (t₀ : ℝ) (a F : ℕ → ℂ) (k : ℕ) : ℂ :=
  if k ≤ q then
    ∑ j ∈ Finset.range k,
      (a j)⁻¹ * (sqmcFluxInit q t₀ a F + sqmcFluxCumSum t₀ F j)
  else 0

def SqmcFluxInvProp : Prop :=
  ∀ (q : ℕ) (t₀ : ℝ), 2 ≤ q → t₀ ≠ 0 →
    (∀ (a F : ℕ → ℂ),
      (∀ j : ℕ, j < q → ‖4 * a j - 1‖ ≤ 1 / 4) →
      (sqmcFluxInv q t₀ a F 0 = 0 ∧
       sqmcFluxInv q t₀ a F q = 0 ∧
       (∀ k : ℕ, q < k → sqmcFluxInv q t₀ a F k = 0)) ∧
      (∀ j : ℕ, j + 1 < q →
        sqmcFluxOp t₀ a (sqmcFluxInv q t₀ a F) (j + 1) = F (j + 1)) ∧
      (∀ k : ℕ,
        sqmcFluxInv q t₀
          (fun j => starRingEnd ℂ (a j))
          (fun i => starRingEnd ℂ (F i)) k =
          starRingEnd ℂ (sqmcFluxInv q t₀ a F k))) ∧
    (∀ (a ξ : ℕ → ℂ),
      (∀ j : ℕ, j < q → ‖4 * a j - 1‖ ≤ 1 / 4) →
      ξ 0 = 0 → ξ q = 0 → (∀ k : ℕ, q < k → ξ k = 0) →
      ∀ k : ℕ, sqmcFluxInv q t₀ a (sqmcFluxOp t₀ a ξ) k = ξ k) ∧
    (∀ (a F₁ F₂ : ℕ → ℂ) (k : ℕ),
      sqmcFluxInv q t₀ a (fun i => F₁ i - F₂ i) k =
        sqmcFluxInv q t₀ a F₁ k - sqmcFluxInv q t₀ a F₂ k) ∧
    (∀ (a F : ℕ → ℂ) (M_F : ℝ),
      (∀ j : ℕ, j < q → ‖4 * a j - 1‖ ≤ 1 / 4) →
      0 ≤ M_F →
      (∀ j : ℕ, j + 1 < q → ‖F (j + 1)‖ ≤ M_F) →
      ∀ k : ℕ, ‖sqmcFluxInv q t₀ a F k‖ ≤ 24 * (q : ℝ) ^ 2 * t₀ ^ 2 * M_F) ∧
    (∀ (W : Set ℂ) (a_y F_y : ℂ → ℕ → ℂ),
      (∀ j : ℕ, j < q → DifferentiableOn ℂ (fun y => a_y y j) W) →
      (∀ y ∈ W, ∀ j : ℕ, j < q → ‖4 * a_y y j - 1‖ ≤ 1 / 4) →
      (∀ j : ℕ, j + 1 < q → DifferentiableOn ℂ (fun y => F_y y (j + 1)) W) →
      ∀ k : ℕ, DifferentiableOn ℂ (fun y => sqmcFluxInv q t₀ (a_y y) (F_y y) k) W)

noncomputable def sqmcMeshPt (u : ℂ → ℂ) (z w : ℂ) : ℂ :=
  u z + deriv u z * w

noncomputable def sqmcStencil {Ω : Set Plane} (B : AnalyticBoundaryData Ω)
    (u : ℂ → ℂ) (t₀ : ℝ) (z w_m w_0 w_p : ℂ) : ℂ :=
  ((t₀ : ℂ)⁻¹) ^ 3 * deriv u z *
    (normAction1_ℂ B (sqmcMeshPt u z w_0) (sqmcMeshPt u (z + (t₀ : ℂ)) w_p) +
     normAction2_ℂ B (sqmcMeshPt u (z - (t₀ : ℂ)) w_m) (sqmcMeshPt u z w_0))

noncomputable def sqmcPotential {Ω : Set Plane} (B : AnalyticBoundaryData Ω)
    (U : ℂ × ℂ → ℂ) (t₀ : ℝ) (z : ℂ) : ℂ :=
  let u : ℂ → ℂ := fun w => U (w, (t₀ : ℂ))
  deriv (fun w : ℂ => glancingResidualOp B U (w, (t₀ : ℂ))) z -
    (deriv (deriv u) z / deriv u z) * glancingResidualOp B U (z, (t₀ : ℂ))

noncomputable def sqmcLinear {Ω : Set Plane} (B : AnalyticBoundaryData Ω)
    (U : ℂ × ℂ → ℂ) (t₀ : ℝ) (z w_m w_0 w_p : ℂ) : ℂ :=
  ((t₀ : ℂ)⁻¹) ^ 2 *
    (glancingLinCoeff B U (z + (t₀ : ℂ) / 2, (t₀ : ℂ)) * (w_p - w_0) -
     glancingLinCoeff B U (z - (t₀ : ℂ) / 2, (t₀ : ℂ)) * (w_0 - w_m)) +
  sqmcPotential B U t₀ z * w_0

noncomputable def sqmcRem {Ω : Set Plane} (B : AnalyticBoundaryData Ω)
    (U : ℂ × ℂ → ℂ) (t₀ : ℝ) (z w_m w_0 w_p : ℂ) : ℂ :=
  let u : ℂ → ℂ := fun w => U (w, (t₀ : ℂ))
  sqmcStencil B u t₀ z w_m w_0 w_p -
    sqmcStencil B u t₀ z 0 0 0 -
    sqmcLinear B U t₀ z w_m w_0 w_p

noncomputable def sqmcForcing {Ω : Set Plane} (B : AnalyticBoundaryData Ω)
    (q : ℕ) (u : ℂ → ℂ) (t₀ : ℝ) (y : ℂ) (ξ : ℕ → ℂ) : ℕ → ℂ
  | 0 => 0
  | j + 1 =>
      if j + 1 < q then
        sqmcStencil B u t₀ (y + ((j + 1 : ℕ) : ℂ) * (t₀ : ℂ))
          (ξ j) (ξ (j + 1)) (ξ (j + 2))
      else 0

def SqmcStencilProp {Ω : Set Plane} (B : AnalyticBoundaryData Ω)
    (S : GlancingScalePackage B) : Prop :=
  ∀ (s d δ ε t₀ : ℝ) (U : ℂ × ℂ → ℂ),
    0 < s → s ≤ S.s_act → 0 < d → d ≤ S.d_act → d < s / 2 →
    0 < δ → δ < d / 100 → 0 < ε → 0 < t₀ → t₀ < d →
    IsAdmissibleGlancingCand s d (3 * S.η_adm / 4) U →
    (∀ p ∈ glancingDomain 1 s d, ‖glancingResidualOp B U p‖ ≤ ε) →
    let u : ℂ → ℂ := fun w => U (w, (t₀ : ℂ))
    let R₀ : ℝ := B.s₀ / 4
    let C_hess : ℝ := 40 * S.M_act / R₀ ^ 2
    DifferentiableOn ℂ u (horizStrip s) ∧
    DifferentiableOn ℂ (deriv u) (horizStrip s) ∧
    (∀ w ∈ horizStrip s,
      3 / 4 ≤ ‖deriv u w‖ ∧
      ‖deriv u w‖ ≤ 5 / 4 ∧
      u (w + 2 * Real.pi) = u w + 2 * Real.pi ∧
      deriv u (w + 2 * Real.pi) = deriv u w ∧
      u (starRingEnd ℂ w) = starRingEnd ℂ (u w) ∧
      deriv u (starRingEnd ℂ w) = starRingEnd ℂ (deriv u w)) ∧
    DifferentiableOn ℂ
      (fun w : ℂ => glancingLinCoeff B U (w, (t₀ : ℂ))) (horizStrip s) ∧
    (∀ w ∈ horizStrip s,
      glancingLinCoeff B U (w + 2 * Real.pi, (t₀ : ℂ)) =
        glancingLinCoeff B U (w, (t₀ : ℂ)) ∧
      glancingLinCoeff B U (starRingEnd ℂ w, (t₀ : ℂ)) =
        starRingEnd ℂ (glancingLinCoeff B U (w, (t₀ : ℂ))) ∧
      ‖4 * glancingLinCoeff B U (w, (t₀ : ℂ)) - 1‖ ≤ 1 / 4) ∧
    (∀ (σ' : ℝ) (w_m w_0 w_p : ℂ → ℂ),
      0 < σ' → σ' ≤ s →
      DifferentiableOn ℂ w_m (horizStrip σ') →
      DifferentiableOn ℂ w_0 (horizStrip σ') →
      DifferentiableOn ℂ w_p (horizStrip σ') →
      (∀ z ∈ horizStrip σ', ‖w_m z‖ ≤ R₀ ∧ ‖w_0 z‖ ≤ R₀ ∧ ‖w_p z‖ ≤ R₀) →
      DifferentiableOn ℂ
        (fun z => sqmcStencil B u t₀ z (w_m z) (w_0 z) (w_p z))
        (horizStrip σ')) ∧
    (∀ z ∈ horizStrip s, ∀ wm w0 wp : ℂ,
      ‖wm‖ ≤ R₀ → ‖w0‖ ≤ R₀ → ‖wp‖ ≤ R₀ →
      sqmcStencil B u t₀ (z + 2 * Real.pi) wm w0 wp =
        sqmcStencil B u t₀ z wm w0 wp ∧
      sqmcStencil B u t₀ (starRingEnd ℂ z)
        (starRingEnd ℂ wm) (starRingEnd ℂ w0) (starRingEnd ℂ wp) =
        starRingEnd ℂ (sqmcStencil B u t₀ z wm w0 wp)) ∧
    (∀ z ∈ horizStrip (s - δ),
      sqmcStencil B u t₀ z 0 0 0 = glancingResidualOp B U (z, (t₀ : ℂ)) ∧
      ‖sqmcStencil B u t₀ z 0 0 0‖ ≤ ε ∧
      ‖sqmcPotential B U t₀ z‖ ≤ (2 * δ⁻¹ + 1) * ε ∧
      sqmcRem B U t₀ z 0 0 0 = 0) ∧
    (∀ z ∈ horizStrip (s - δ), ∀ (r M_Δ : ℝ) (w_m w_0 w_p w_m' w_0' w_p' : ℂ),
      0 ≤ r → r ≤ R₀ / 4 → 0 ≤ M_Δ →
      ‖w_m‖ ≤ r → ‖w_0‖ ≤ r → ‖w_p‖ ≤ r →
      ‖w_m'‖ ≤ r → ‖w_0'‖ ≤ r → ‖w_p'‖ ≤ r →
      ‖w_m' - w_m‖ ≤ M_Δ → ‖w_0' - w_0‖ ≤ M_Δ → ‖w_p' - w_p‖ ≤ M_Δ →
      ‖sqmcRem B U t₀ z w_m' w_0' w_p' -
         sqmcRem B U t₀ z w_m w_0 w_p‖ ≤
        C_hess * (t₀⁻¹) ^ 3 * r * M_Δ)

def IsSqmcPinned (q : ℕ) (r : ℝ) (ξ : ℕ → ℂ) : Prop :=
  ξ 0 = 0 ∧ ξ q = 0 ∧ (∀ k : ℕ, q < k → ξ k = 0) ∧ (∀ k : ℕ, k ≤ q → ‖ξ k‖ ≤ r)

noncomputable def sqmcPicardIter (q : ℕ) (Φ : ℂ → (ℕ → ℂ) → (ℕ → ℂ)) :
    ℕ → ℂ → ℕ → ℂ
  | 0, _, _ => 0
  | n + 1, y, k => if k ≤ q then Φ y (sqmcPicardIter q Φ n y) k else 0

def SqmcContractionProp : Prop :=
  ∀ (σ r M₀ : ℝ) (q : ℕ) (Φ : ℂ → (ℕ → ℂ) → (ℕ → ℂ)),
    0 < σ → 0 ≤ M₀ → 2 * M₀ ≤ r →
    (∀ y ∈ horizStrip σ, ∀ ξ : ℕ → ℂ, IsSqmcPinned q r ξ →
      Φ y ξ 0 = 0 ∧ Φ y ξ q = 0 ∧ ∀ k : ℕ, q < k → Φ y ξ k = 0) →
    (∀ y ∈ horizStrip σ, ∀ k : ℕ, k ≤ q → ‖Φ y (fun _ => 0) k‖ ≤ M₀) →
    (∀ y ∈ horizStrip σ, ∀ (ξ₁ ξ₂ : ℕ → ℂ) (M_Δ : ℝ),
      IsSqmcPinned q r ξ₁ → IsSqmcPinned q r ξ₂ → 0 ≤ M_Δ →
      (∀ m : ℕ, m ≤ q → ‖ξ₁ m - ξ₂ m‖ ≤ M_Δ) →
      ∀ k : ℕ, k ≤ q → ‖Φ y ξ₁ k - Φ y ξ₂ k‖ ≤ (1 / 2) * M_Δ) →
    (∀ ξ_fn : ℂ → ℕ → ℂ,
      (∀ y ∈ horizStrip σ, IsSqmcPinned q r (ξ_fn y)) →
      (∀ k : ℕ, k ≤ q → DifferentiableOn ℂ (fun y => ξ_fn y k) (horizStrip σ)) →
      ∀ k : ℕ, k ≤ q → DifferentiableOn ℂ (fun y => Φ y (ξ_fn y) k) (horizStrip σ)) →
    (∀ ξ_fn : ℂ → ℕ → ℂ,
      (∀ y ∈ horizStrip σ, IsSqmcPinned q r (ξ_fn y)) →
      (∀ y ∈ horizStrip σ, ∀ k : ℕ, k ≤ q →
        ξ_fn (y + 2 * Real.pi) k = ξ_fn y k ∧
        ξ_fn (starRingEnd ℂ y) k = starRingEnd ℂ (ξ_fn y k)) →
      ∀ y ∈ horizStrip σ, ∀ k : ℕ, k ≤ q →
        Φ (y + 2 * Real.pi) (ξ_fn (y + 2 * Real.pi)) k = Φ y (ξ_fn y) k ∧
        Φ (starRingEnd ℂ y) (ξ_fn (starRingEnd ℂ y)) k = starRingEnd ℂ (Φ y (ξ_fn y) k)) →
    ∃ ξ_lim : ℂ → ℕ → ℂ,
      (∀ y ∈ horizStrip σ, IsSqmcPinned q r (ξ_lim y)) ∧
      (∀ k : ℕ, DifferentiableOn ℂ (fun y => ξ_lim y k) (horizStrip σ)) ∧
      (∀ y ∈ horizStrip σ, ∀ k : ℕ,
        ξ_lim (y + 2 * Real.pi) k = ξ_lim y k ∧
        ξ_lim (starRingEnd ℂ y) k = starRingEnd ℂ (ξ_lim y k)) ∧
      (∀ y ∈ horizStrip σ, ∀ k : ℕ, Φ y (ξ_lim y) k = ξ_lim y k)
def PointArcIterHoloProp : Prop :=
  ∀ {W : Set (ℂ × ℂ)}, IsOpen W → ∀ {f : ℂ × ℂ → ℂ},
    DifferentiableOn ℂ f W → ∀ α β : ℕ, DifferentiableOn ℂ (iterDerivYT α β f) W

noncomputable abbrev pointArcHoloTaylor1D : (ℂ → ℂ) → ℂ → PowerSeries ℂ :=
  holoTaylor1D

noncomputable def pointArcEpsJet (m : ℕ) (F : ℂ → ℂ) : ℂ :=
  iteratedDeriv m F 0 / (m.factorial : ℂ)

noncomputable def pointArcInvSqrt1p (u : ℂ) : ℂ :=
  Complex.exp (-Complex.log (1 + u) / 2)

noncomputable def pointArcPertGraph {k J : ℕ} (F : ℂ → ℂ)
    (g : Fin (k + 1) → Fin (J + 1) → ℂ → ℂ) (ε : ℂ) (r : Fin (k + 1)) (z : ℂ) : ℂ :=
  F z + ∑ q : Fin (J + 1), ε ^ (q : ℕ) * g r q z

noncomputable def pointArcPertGraphDeriv {k J : ℕ} (F : ℂ → ℂ)
    (g : Fin (k + 1) → Fin (J + 1) → ℂ → ℂ) (ε : ℂ) (r : Fin (k + 1)) (z : ℂ) : ℂ :=
  deriv F z + ∑ q : Fin (J + 1), ε ^ (q : ℕ) * deriv (g r q) z

noncomputable def pointArcPertAbscissa {k J : ℕ} (x₀ : Fin (k + 1) → ℂ)
    (β : Fin (J + 1) → Fin (k + 1) → ℂ) (ε : ℂ) (r : Fin (k + 1)) : ℂ :=
  x₀ r + ∑ q : Fin (J + 1), ε ^ (q : ℕ) * β q r

noncomputable def pointArcComp2D (S Φ₀ Φ₁ : MvPowerSeries (Fin 2) ℂ) :
    MvPowerSeries (Fin 2) ℂ :=
  fun d =>
    ∑ a ∈ Finset.range (d 0 + d 1 + 1),
      ∑ b ∈ Finset.range (d 0 + d 1 + 1),
        MvPowerSeries.coeff (Finsupp.single 0 a + Finsupp.single 1 b) S *
          MvPowerSeries.coeff d (Φ₀ ^ a * Φ₁ ^ b)

noncomputable def pointArcPack2D1D (F : ℕ → MvPowerSeries (Fin 2) ℂ) :
    MvPowerSeries (Fin 2) (PowerSeries ℂ) :=
  fun d => PowerSeries.mk (fun l => MvPowerSeries.coeff d (F l))

noncomputable def pointArcSlice2D1D (l : ℕ) (S : MvPowerSeries (Fin 2) (PowerSeries ℂ)) :
    MvPowerSeries (Fin 2) ℂ :=
  fun d => PowerSeries.coeff l (MvPowerSeries.coeff d S)

noncomputable def pointArcComp2D1D (g_seq : ℕ → PowerSeries ℂ)
    (Z : MvPowerSeries (Fin 2) (PowerSeries ℂ)) :
    MvPowerSeries (Fin 2) (PowerSeries ℂ) :=
  fun d =>
    PowerSeries.mk (fun m =>
      PowerSeries.coeff m
        (MvPowerSeries.coeff d
          (∑ n ∈ Finset.range (d 0 + d 1 + m + 1),
            MvPowerSeries.C (PowerSeries.mk (fun l => PowerSeries.coeff n (g_seq l))) * Z ^ n)))

noncomputable def pointArcCompConst2D1D (φ : PowerSeries ℂ)
    (Z : MvPowerSeries (Fin 2) (PowerSeries ℂ)) :
    MvPowerSeries (Fin 2) (PowerSeries ℂ) :=
  pointArcComp2D1D (fun l => if l = 0 then φ else 0) Z

noncomputable def pointArcPsSqrt1p : PowerSeries ℂ :=
  pointArcHoloTaylor1D sqrt1p 0

noncomputable def pointArcPsInvSqrt1p : PowerSeries ℂ :=
  pointArcHoloTaylor1D pointArcInvSqrt1p 0

noncomputable def pointArcFormalAbscissa2D1D {k : ℕ}
    (β_seq : ℕ → Fin (k + 1) → MvPowerSeries (Fin 2) ℂ) (r : Fin (k + 1)) :
    MvPowerSeries (Fin 2) (PowerSeries ℂ) :=
  pointArcPack2D1D (fun l => β_seq l r)

noncomputable def pointArcFormalDx2D1D {k : ℕ} (x_star : Fin (k + 1) → ℂ)
    (β_seq : ℕ → Fin (k + 1) → MvPowerSeries (Fin 2) ℂ) (i : Fin k) :
    MvPowerSeries (Fin 2) (PowerSeries ℂ) :=
  MvPowerSeries.C (PowerSeries.C (x_star i.succ - x_star i.castSucc)) +
    (pointArcFormalAbscissa2D1D β_seq i.succ - pointArcFormalAbscissa2D1D β_seq i.castSucc)

noncomputable def pointArcFormalDy2D1D {k : ℕ}
    (f_seq : Fin (k + 1) → ℕ → PowerSeries ℂ)
    (β_seq : ℕ → Fin (k + 1) → MvPowerSeries (Fin 2) ℂ) (i : Fin k) :
    MvPowerSeries (Fin 2) (PowerSeries ℂ) :=
  pointArcComp2D1D (f_seq i.succ) (pointArcFormalAbscissa2D1D β_seq i.succ) -
    pointArcComp2D1D (f_seq i.castSucc) (pointArcFormalAbscissa2D1D β_seq i.castSucc)

noncomputable def pointArcFormalEdgeSq2D1D {k : ℕ} (x_star : Fin (k + 1) → ℂ)
    (f_seq : Fin (k + 1) → ℕ → PowerSeries ℂ)
    (β_seq : ℕ → Fin (k + 1) → MvPowerSeries (Fin 2) ℂ) (i : Fin k) :
    MvPowerSeries (Fin 2) (PowerSeries ℂ) :=
  (pointArcFormalDx2D1D x_star β_seq i) ^ 2 + (pointArcFormalDy2D1D f_seq β_seq i) ^ 2

noncomputable def pointArcFormalEdgeRel2D1D {k : ℕ} (ℓ_star : Fin k → ℂ)
    (x_star : Fin (k + 1) → ℂ)
    (f_seq : Fin (k + 1) → ℕ → PowerSeries ℂ)
    (β_seq : ℕ → Fin (k + 1) → MvPowerSeries (Fin 2) ℂ) (i : Fin k) :
    MvPowerSeries (Fin 2) (PowerSeries ℂ) :=
  (pointArcFormalEdgeSq2D1D x_star f_seq β_seq i -
      MvPowerSeries.C (PowerSeries.C ((ℓ_star i) ^ 2))) *
    MvPowerSeries.C (PowerSeries.C (((ℓ_star i) ^ 2)⁻¹))

noncomputable def pointArcFormalLen2D1D {k : ℕ} (ℓ_star : Fin k → ℂ)
    (x_star : Fin (k + 1) → ℂ)
    (f_seq : Fin (k + 1) → ℕ → PowerSeries ℂ)
    (β_seq : ℕ → Fin (k + 1) → MvPowerSeries (Fin 2) ℂ) :
    MvPowerSeries (Fin 2) (PowerSeries ℂ) :=
  ∑ i : Fin k,
    MvPowerSeries.C (PowerSeries.C (ℓ_star i)) *
      pointArcCompConst2D1D pointArcPsSqrt1p
        (pointArcFormalEdgeRel2D1D ℓ_star x_star f_seq β_seq i)

noncomputable def pointArcFormalInvEdgeLen2D1D {k : ℕ} (ℓ_star : Fin k → ℂ)
    (x_star : Fin (k + 1) → ℂ)
    (f_seq : Fin (k + 1) → ℕ → PowerSeries ℂ)
    (β_seq : ℕ → Fin (k + 1) → MvPowerSeries (Fin 2) ℂ) (i : Fin k) :
    MvPowerSeries (Fin 2) (PowerSeries ℂ) :=
  MvPowerSeries.C (PowerSeries.C ((ℓ_star i)⁻¹)) *
    pointArcCompConst2D1D pointArcPsInvSqrt1p
      (pointArcFormalEdgeRel2D1D ℓ_star x_star f_seq β_seq i)

noncomputable def pointArcFormalGrad2D1D {k : ℕ} (ℓ_star : Fin k → ℂ)
    (x_star : Fin (k + 1) → ℂ)
    (f_seq : Fin (k + 1) → ℕ → PowerSeries ℂ)
    (β_seq : ℕ → Fin (k + 1) → MvPowerSeries (Fin 2) ℂ)
    (r : Fin (k - 1)) :
    MvPowerSeries (Fin 2) (PowerSeries ℂ) :=
  let i_L : Fin k := ⟨r.1, by have := r.2; omega⟩
  let i_R : Fin k := ⟨r.1 + 1, by have := r.2; omega⟩
  (pointArcFormalDx2D1D x_star β_seq i_L +
      pointArcFormalDy2D1D f_seq β_seq i_L *
        pointArcComp2D1D (fun l => PowerSeries.derivative (f_seq i_L.succ l))
          (pointArcFormalAbscissa2D1D β_seq i_L.succ)) *
      pointArcFormalInvEdgeLen2D1D ℓ_star x_star f_seq β_seq i_L -
    (pointArcFormalDx2D1D x_star β_seq i_R +
      pointArcFormalDy2D1D f_seq β_seq i_R *
        pointArcComp2D1D (fun l => PowerSeries.derivative (f_seq i_R.castSucc l))
          (pointArcFormalAbscissa2D1D β_seq i_R.castSucc)) *
      pointArcFormalInvEdgeLen2D1D ℓ_star x_star f_seq β_seq i_R

noncomputable def pointArcTruncGraph {k : ℕ} (J : ℕ)
    (f_full : Fin (k + 1) → ℕ → PowerSeries ℂ) : Fin (k + 1) → ℕ → PowerSeries ℂ :=
  fun r l => if l ≤ J then f_full r l else 0

noncomputable def pointArcTruncBeta {k : ℕ} (J : ℕ)
    (β_full : ℕ → Fin (k + 1) → MvPowerSeries (Fin 2) ℂ) :
    ℕ → Fin (k + 1) → MvPowerSeries (Fin 2) ℂ :=
  fun l r => if l ≤ J then β_full l r else 0

structure PointArcJetAndTaylorToolkit : Prop where
  taylor2D_const : ∀ (p₀ : ℂ × ℂ) (c : ℂ), taylor2D (fun _ => c) p₀ = MvPowerSeries.C c
  taylor2D_linear_coords : ∀ (p₀ : ℂ × ℂ),
    centeredTaylor2D Prod.fst p₀ = MvPowerSeries.X 0 ∧
    centeredTaylor2D Prod.snd p₀ = MvPowerSeries.X 1
  taylor2D_congr : ∀ {U : Set (ℂ × ℂ)}, IsOpen U → ∀ {p₀ : ℂ × ℂ}, p₀ ∈ U →
    ∀ {f₁ f₂ : ℂ × ℂ → ℂ}, (∀ p ∈ U, f₁ p = f₂ p) → taylor2D f₁ p₀ = taylor2D f₂ p₀
  taylor2D_ring : ∀ {U : Set (ℂ × ℂ)}, IsOpen U → ∀ {p₀ : ℂ × ℂ}, p₀ ∈ U →
    ∀ {f g : ℂ × ℂ → ℂ}, DifferentiableOn ℂ f U → DifferentiableOn ℂ g U →
      taylor2D (fun p => f p + g p) p₀ = taylor2D f p₀ + taylor2D g p₀ ∧
      taylor2D (fun p => f p - g p) p₀ = taylor2D f p₀ - taylor2D g p₀ ∧
      taylor2D (fun p => f p * g p) p₀ = taylor2D f p₀ * taylor2D g p₀
  taylor2D_comp_1D : ∀ {U : Set (ℂ × ℂ)} {W : Set ℂ}, IsOpen U → IsOpen W →
    ∀ {p₀ : ℂ × ℂ}, p₀ ∈ U → ∀ {ψ : ℂ × ℂ → ℂ} {g : ℂ → ℂ},
      DifferentiableOn ℂ ψ U → DifferentiableOn ℂ g W → (∀ p ∈ U, ψ p ∈ W) →
      taylor2D (fun p => g (ψ p)) p₀ =
        compPowerSeries2D (pointArcHoloTaylor1D g (ψ p₀)) (centeredTaylor2D ψ p₀)
  taylor2D_comp_2D : ∀ {U U' : Set (ℂ × ℂ)}, IsOpen U → IsOpen U' →
    ∀ {p₀ : ℂ × ℂ}, p₀ ∈ U → ∀ {φ₀ φ₁ F : ℂ × ℂ → ℂ},
      DifferentiableOn ℂ φ₀ U → DifferentiableOn ℂ φ₁ U → DifferentiableOn ℂ F U' →
      (∀ p ∈ U, (φ₀ p, φ₁ p) ∈ U') →
      taylor2D (fun p => F (φ₀ p, φ₁ p)) p₀ =
        pointArcComp2D (taylor2D F (φ₀ p₀, φ₁ p₀))
          (centeredTaylor2D φ₀ p₀) (centeredTaylor2D φ₁ p₀)
  psSqrt1p_laws :
    PowerSeries.constantCoeff pointArcPsSqrt1p = 1 ∧
    PowerSeries.constantCoeff pointArcPsInvSqrt1p = 1 ∧
    pointArcPsSqrt1p ^ 2 = 1 + PowerSeries.X ∧
    pointArcPsSqrt1p * pointArcPsInvSqrt1p = 1
  epsJet_trunc_eq : ∀ {k J₁ J₂ l : ℕ} (_hJ : J₁ ≤ J₂) (_hl1 : 1 ≤ l) (_hlJ : l ≤ J₁)
    {W_ψ : Set ℂ} (_hW : IsOpen W_ψ) {F : ℂ → ℂ} (_hF : DifferentiableOn ℂ F W_ψ)
    {g₁ : Fin (k + 1) → Fin (J₁ + 1) → ℂ → ℂ}
    {g₂ : Fin (k + 1) → Fin (J₂ + 1) → ℂ → ℂ}
    (_hg₁ : ∀ r m, DifferentiableOn ℂ (g₁ r m) W_ψ)
    (_hg₂ : ∀ r m, DifferentiableOn ℂ (g₂ r m) W_ψ)
    (_hg₁0 : ∀ r z, g₁ r 0 z = 0) (_hg₂0 : ∀ r z, g₂ r 0 z = 0)
    (_hg_eq : ∀ r (m : Fin (J₁ + 1)), ∀ z ∈ W_ψ, g₂ r ⟨m.1, by omega⟩ z = g₁ r m z)
    {ℓ₀ : Fin k → ℂ} (_hℓ_ne : ∀ i, ℓ₀ i ≠ 0)
    {x₀ : Fin (k + 1) → ℂ} (_hx₀ : ∀ r, x₀ r ∈ W_ψ)
    (_hℓ_sq : ∀ i, (ℓ₀ i) ^ 2 = pointEdgeSq (fun _ => F) x₀ i)
    {β₁ : Fin (J₁ + 1) → Fin (k + 1) → ℂ} {β₂ : Fin (J₂ + 1) → Fin (k + 1) → ℂ}
    (_hβ₁0 : ∀ s, β₁ 0 s = 0) (_hβ₂0 : ∀ s, β₂ 0 s = 0)
    (_hβ_eq : ∀ (m : Fin (J₁ + 1)) s, β₂ ⟨m.1, by omega⟩ s = β₁ m s),
    pointArcEpsJet l
        (fun ε =>
          pointRelChainLen ℓ₀ (pointArcPertGraph F g₂ ε) (pointArcPertAbscissa x₀ β₂ ε)) =
      pointArcEpsJet l
        (fun ε =>
          pointRelChainLen ℓ₀ (pointArcPertGraph F g₁ ε) (pointArcPertAbscissa x₀ β₁ ε)) ∧
    ∀ r : Fin (k - 1),
      pointArcEpsJet l
          (fun ε =>
            pointRelInteriorGrad ℓ₀ (pointArcPertGraph F g₂ ε)
              (pointArcPertGraphDeriv F g₂ ε) (pointArcPertAbscissa x₀ β₂ ε) r) =
        pointArcEpsJet l
          (fun ε =>
            pointRelInteriorGrad ℓ₀ (pointArcPertGraph F g₁ ε)
              (pointArcPertGraphDeriv F g₁ ε) (pointArcPertAbscissa x₀ β₁ ε) r)
  epsJet_holo : ∀ {k J : ℕ} (m : ℕ) {W_ψ : Set ℂ} {V : Set (ℂ × ℂ)}
    (_hW : IsOpen W_ψ) (_hV : IsOpen V) {F : ℂ → ℂ} (_hF : DifferentiableOn ℂ F W_ψ)
    {g : Fin (k + 1) → Fin (J + 1) → ℂ → ℂ} (_hg : ∀ r l, DifferentiableOn ℂ (g r l) W_ψ)
    (_hg0 : ∀ r z, g r 0 z = 0) {ℓ₀ : Fin k → ℂ × ℂ → ℂ}
    (_hℓ₀ : ∀ i, DifferentiableOn ℂ (ℓ₀ i) V) (_hℓ_ne : ∀ q ∈ V, ∀ i, ℓ₀ i q ≠ 0)
    {x₀ : Fin (k + 1) → ℂ × ℂ → ℂ} (_hx₀ : ∀ r, DifferentiableOn ℂ (x₀ r) V)
    (_hx_maps : ∀ q ∈ V, ∀ r, x₀ r q ∈ W_ψ)
    (_hℓ_sq : ∀ q ∈ V, ∀ i, (ℓ₀ i q) ^ 2 = pointEdgeSq (fun _ => F) (fun r => x₀ r q) i)
    {β : Fin (J + 1) → Fin (k + 1) → ℂ × ℂ → ℂ}
    (_hβ : ∀ l r, DifferentiableOn ℂ (β l r) V) (_hβ0 : ∀ r q, β 0 r q = 0),
    DifferentiableOn ℂ
      (fun q =>
        pointArcEpsJet m
          (fun ε =>
            pointRelChainLen (fun i => ℓ₀ i q) (pointArcPertGraph F g ε)
              (pointArcPertAbscissa (fun r => x₀ r q) (fun l r => β l r q) ε)))
      V ∧
    ∀ r : Fin (k - 1),
      DifferentiableOn ℂ
        (fun q =>
          pointArcEpsJet m
            (fun ε =>
              pointRelInteriorGrad (fun i => ℓ₀ i q) (pointArcPertGraph F g ε)
                (pointArcPertGraphDeriv F g ε)
                (pointArcPertAbscissa (fun r => x₀ r q) (fun l r => β l r q) ε) r))
        V
  epsJet_succ_split : ∀ {k J : ℕ} (_hk : 2 ≤ k) {W_ψ : Set ℂ} (_hW : IsOpen W_ψ)
    {F : ℂ → ℂ} (_hF : DifferentiableOn ℂ F W_ψ)
    {g : Fin (k + 1) → Fin (J + 1) → ℂ → ℂ} {g_top : Fin (k + 1) → ℂ → ℂ}
    (_hg : ∀ r l, DifferentiableOn ℂ (g r l) W_ψ)
    (_hg_top : ∀ r, DifferentiableOn ℂ (g_top r) W_ψ)
    (_hg0 : ∀ r z, g r 0 z = 0)
    (_hg_top_end : ∀ z, g_top 0 z = 0 ∧ g_top (Fin.last k) z = 0)
    {ℓ₀ : Fin k → ℂ} (_hℓ_ne : ∀ i, ℓ₀ i ≠ 0)
    {x₀ : Fin (k + 1) → ℂ} (_hx₀ : ∀ r, x₀ r ∈ W_ψ)
    (_hℓ_sq : ∀ i, (ℓ₀ i) ^ 2 = pointEdgeSq (fun _ => F) x₀ i)
    {β : Fin (J + 1) → Fin (k + 1) → ℂ} {β_top : Fin (k + 1) → ℂ}
    (_hβ0 : ∀ s, β 0 s = 0) (_hβ_top_end : β_top 0 = 0 ∧ β_top (Fin.last k) = 0),
    let g_ext : Fin (k + 1) → Fin (J + 1 + 1) → ℂ → ℂ := fun r => Fin.snoc (g r) (g_top r)
    let β_ext : Fin (J + 1 + 1) → Fin (k + 1) → ℂ := Fin.snoc β β_top
    let β_zero_top : Fin (J + 1 + 1) → Fin (k + 1) → ℂ := Fin.snoc β (fun _ => 0)
    pointArcEpsJet (J + 1)
        (fun ε =>
          pointRelChainLen ℓ₀ (pointArcPertGraph F g_ext ε)
            (pointArcPertAbscissa x₀ β_ext ε)) =
      pointArcEpsJet (J + 1)
        (fun ε =>
          pointRelChainLen ℓ₀ (pointArcPertGraph F g ε)
            (pointArcPertAbscissa x₀ β ε)) +
      (∑ r : Fin (k - 1),
        ((F (x₀ ⟨r.1 + 1, by have := r.2; omega⟩) - F (x₀ ⟨r.1, by have := r.2; omega⟩)) /
            ℓ₀ ⟨r.1, by have := r.2; omega⟩ -
          (F (x₀ ⟨r.1 + 2, by have := r.2; omega⟩) - F (x₀ ⟨r.1 + 1, by have := r.2; omega⟩)) /
            ℓ₀ ⟨r.1 + 1, by have := r.2; omega⟩) *
          g_top ⟨r.1 + 1, by have := r.2; omega⟩ (x₀ ⟨r.1 + 1, by have := r.2; omega⟩)) +
      (∑ r : Fin (k - 1),
        pointRelInteriorGrad ℓ₀ (fun _ => F) (fun _ => deriv F) x₀ r *
          β_top ⟨r.1 + 1, by have := r.2; omega⟩) ∧
    ∀ r : Fin (k - 1),
      pointArcEpsJet (J + 1)
          (fun ε =>
            pointRelInteriorGrad ℓ₀ (pointArcPertGraph F g_ext ε)
              (pointArcPertGraphDeriv F g_ext ε) (pointArcPertAbscissa x₀ β_ext ε) r) =
        pointArcEpsJet (J + 1)
          (fun ε =>
            pointRelInteriorGrad ℓ₀ (pointArcPertGraph F g_ext ε)
              (pointArcPertGraphDeriv F g_ext ε) (pointArcPertAbscissa x₀ β_zero_top ε) r) +
        ∑ s : Fin (k - 1),
          pointInteriorHess ℓ₀ F (deriv F) (deriv (deriv F)) x₀ r s *
            β_top ⟨s.1 + 1, by have := s.2; omega⟩
  taylor2D_epsJet_eq : ∀ {k J : ℕ} (m : ℕ) {W_ψ : Set ℂ} {V : Set (ℂ × ℂ)} {p₁ : ℂ × ℂ}
    (_hW : IsOpen W_ψ) (_hV : IsOpen V) (_hp₁ : p₁ ∈ V)
    {F : ℂ → ℂ} (_hF : DifferentiableOn ℂ F W_ψ)
    {g : Fin (k + 1) → Fin (J + 1) → ℂ → ℂ} (_hg : ∀ r l, DifferentiableOn ℂ (g r l) W_ψ)
    (_hg0 : ∀ r z, g r 0 z = 0) {ℓ₀ : Fin k → ℂ × ℂ → ℂ}
    (_hℓ₀ : ∀ i, DifferentiableOn ℂ (ℓ₀ i) V) (_hℓ_ne : ∀ q ∈ V, ∀ i, ℓ₀ i q ≠ 0)
    {x₀ : Fin (k + 1) → ℂ × ℂ → ℂ} (_hx₀ : ∀ r, DifferentiableOn ℂ (x₀ r) V)
    (_hx_maps : ∀ q ∈ V, ∀ r, x₀ r q ∈ W_ψ)
    (_hℓ_sq : ∀ q ∈ V, ∀ i, (ℓ₀ i q) ^ 2 = pointEdgeSq (fun _ => F) (fun r => x₀ r q) i)
    {β : Fin (J + 1) → Fin (k + 1) → ℂ × ℂ → ℂ}
    (_hβ : ∀ l r, DifferentiableOn ℂ (β l r) V) (_hβ0 : ∀ r q, β 0 r q = 0),
    let ℓ_star := fun i => ℓ₀ i p₁
    let x_star := fun r => x₀ r p₁
    let f_seq : Fin (k + 1) → ℕ → PowerSeries ℂ := fun r l =>
      if l = 0 then pointArcHoloTaylor1D F (x_star r)
      else if hl : l < J + 1 then pointArcHoloTaylor1D (g r ⟨l, hl⟩) (x_star r)
      else 0
    let β_seq : ℕ → Fin (k + 1) → MvPowerSeries (Fin 2) ℂ := fun l r =>
      if l = 0 then centeredTaylor2D (x₀ r) p₁
      else if hl : l < J + 1 then taylor2D (β ⟨l, hl⟩ r) p₁
      else 0
    taylor2D
        (fun q =>
          pointArcEpsJet m
            (fun ε =>
              pointRelChainLen (fun i => ℓ₀ i q) (pointArcPertGraph F g ε)
                (pointArcPertAbscissa (fun r => x₀ r q) (fun l r => β l r q) ε)))
        p₁ =
      pointArcSlice2D1D m (pointArcFormalLen2D1D ℓ_star x_star f_seq β_seq) ∧
    ∀ r : Fin (k - 1),
      taylor2D
          (fun q =>
            pointArcEpsJet m
              (fun ε =>
                pointRelInteriorGrad (fun i => ℓ₀ i q) (pointArcPertGraph F g ε)
                  (pointArcPertGraphDeriv F g ε)
                  (pointArcPertAbscissa (fun r => x₀ r q) (fun l r => β l r q) ε) r))
          p₁ =
        pointArcSlice2D1D m (pointArcFormalGrad2D1D ℓ_star x_star f_seq β_seq r)

structure PointArcFormalDeformationData {Ω : Set Plane} (C : AnalyticGlancingCollar Ω)
    (B : BaseCollarAndCramerData C) (k : ℕ) (G : PointGlancingChartData C B k)
    (a₁ δ₁ : ℝ) where
  p : ℕ
  p_pos : 1 ≤ p
  r₀ : Fin (k - 1)
  f_full : Fin (k + 1) → ℕ → PowerSeries ℂ
  U_formal : ℕ → PowerSeries ℂ
  V_formal : ℕ → PowerSeries ℂ
  β_full : ℕ → Fin (k + 1) → MvPowerSeries (Fin 2) ℂ
  f_zero : ∀ r : Fin (k + 1),
    f_full r 0 = pointArcHoloTaylor1D G.F (G.x_fn r ((a₁ : ℂ), (δ₁ : ℂ)))
  f_endpoints : ∀ l : ℕ, 1 ≤ l → f_full 0 l = 0 ∧ f_full (Fin.last k) l = 0
  β_zero : ∀ r : Fin (k + 1), β_full 0 r = centeredTaylor2D (G.x_fn r) ((a₁ : ℂ), (δ₁ : ℂ))
  β_endpoints : ∀ l : ℕ, 1 ≤ l → β_full l 0 = 0 ∧ β_full l (Fin.last k) = 0
  f_lead_ne_zero : f_full ⟨r₀.1 + 1, by have := r₀.2; omega⟩ p ≠ 0
  vanish_lt_p : ∀ l : ℕ, 1 ≤ l → l < p →
    (∀ r : Fin (k + 1), f_full r l = 0) ∧
    (∀ r : Fin (k + 1), β_full l r = 0) ∧
    U_formal l = 0 ∧ V_formal l = 0
  formal_web_step : ∀ J : ℕ,
    ∑ r : Fin (k + 1),
      taylor2D (G.w_web r) ((a₁ : ℂ), (δ₁ : ℂ)) *
        compPowerSeries2D
          (if h : r.1 < k - 1 then f_full ⟨r.1 + 1, by omega⟩ (J + 1)
           else if r.1 = k - 1 then U_formal (J + 1)
           else V_formal (J + 1))
          (centeredTaylor2D (G.ψ_web r) ((a₁ : ℂ), (δ₁ : ℂ))) =
      -pointArcSlice2D1D (J + 1)
        (pointArcFormalLen2D1D
          (fun i => G.ℓ_fn i ((a₁ : ℂ), (δ₁ : ℂ)))
          (fun r => G.x_fn r ((a₁ : ℂ), (δ₁ : ℂ)))
          (pointArcTruncGraph J f_full)
          (pointArcTruncBeta J β_full))
  formal_hess_step : ∀ J : ℕ, ∀ r : Fin (k - 1),
    pointArcSlice2D1D (J + 1)
        (pointArcFormalGrad2D1D
          (fun i => G.ℓ_fn i ((a₁ : ℂ), (δ₁ : ℂ)))
          (fun u => G.x_fn u ((a₁ : ℂ), (δ₁ : ℂ)))
          (pointArcTruncGraph (J + 1) f_full)
          (pointArcTruncBeta J β_full)
          r) +
      ∑ s : Fin (k - 1),
        taylor2D
          (fun q =>
            pointInteriorHess (fun i => G.ℓ_fn i q) G.F (deriv G.F) (deriv (deriv G.F))
              (fun u => G.x_fn u q) r s)
          ((a₁ : ℂ), (δ₁ : ℂ)) *
        β_full (J + 1) ⟨s.1 + 1, by have := s.2; omega⟩ = 0

structure PointArcStepAnalyticData {Ω : Set Plane} (C : AnalyticGlancingCollar Ω)
    (B : BaseCollarAndCramerData C) (k : ℕ) (G : PointGlancingChartData C B k)
    (a₁ δ₁ : ℝ) (D_form : PointArcFormalDeformationData C B k G a₁ δ₁) (J : ℕ) where
  W_ψ : Set ℂ
  V_plus : Set (ℂ × ℂ)
  g : Fin (k + 1) → Fin (J + 1) → ℂ → ℂ
  U_split : Fin (J + 1) → ℂ → ℂ
  V_split : Fin (J + 1) → ℂ → ℂ
  β : Fin (J + 1) → Fin (k + 1) → ℂ × ℂ → ℂ
  W_ψ_open : IsOpen W_ψ
  W_ψ_preconn : IsPreconnected W_ψ
  W_ψ_sub_W_F : W_ψ ⊆ G.W_F
  real_mem_W_ψ : ∀ x : ℝ, |x - G.a₀| < G.R → (x : ℂ) ∈ W_ψ
  V_plus_open : IsOpen V_plus
  V_plus_preconn : IsPreconnected V_plus
  V_plus_sub : V_plus ⊆ G.U_a ×ˢ G.U_d
  trapezoid_mem_V_plus : ∀ q ∈ webTrapezoid G.a₀ G.R G.δ_star G.C₀,
    ((q.1 : ℂ), (q.2 : ℂ)) ∈ V_plus
  ψ_maps_W_ψ : ∀ q ∈ V_plus, ∀ r : Fin (k + 1), G.ψ_web r q ∈ W_ψ
  chord_ne_zero : ∀ q ∈ V_plus, ∀ i : Fin k, G.ℓ_fn i q ≠ 0
  hess_det_ne_zero : ∀ q ∈ V_plus,
    (pointInteriorHess (fun i => G.ℓ_fn i q) G.F (deriv G.F) (deriv (deriv G.F))
      (fun s => G.x_fn s q)).det ≠ 0
  g_holo : ∀ (r : Fin (k + 1)) (l : Fin (J + 1)), DifferentiableOn ℂ (g r l) W_ψ
  g_endpoints : ∀ (l : Fin (J + 1)) (z : ℂ), g 0 l z = 0 ∧ g (Fin.last k) l z = 0
  g_lt_p : ∀ (r : Fin (k + 1)) (l : Fin (J + 1)), (l : ℕ) < D_form.p → ∀ z : ℂ, g r l z = 0
  g_taylor : ∀ (r : Fin (k + 1)) (l : Fin (J + 1)), 1 ≤ (l : ℕ) →
    pointArcHoloTaylor1D (g r l) (G.x_fn r ((a₁ : ℂ), (δ₁ : ℂ))) = D_form.f_full r (l : ℕ)
  UV_holo : ∀ l : Fin (J + 1),
    DifferentiableOn ℂ (U_split l) W_ψ ∧ DifferentiableOn ℂ (V_split l) W_ψ
  UV_lt_p : ∀ l : Fin (J + 1), (l : ℕ) < D_form.p → ∀ z : ℂ, U_split l z = 0 ∧ V_split l z = 0
  UV_taylor : ∀ l : Fin (J + 1), 1 ≤ (l : ℕ) →
    pointArcHoloTaylor1D (U_split l) (a₁ : ℂ) = D_form.U_formal (l : ℕ) ∧
    pointArcHoloTaylor1D (V_split l) ((a₁ : ℂ) + (δ₁ : ℂ)) = D_form.V_formal (l : ℕ)
  β_holo : ∀ (l : Fin (J + 1)) (r : Fin (k + 1)), DifferentiableOn ℂ (β l r) V_plus
  β_zero : ∀ (r : Fin (k + 1)) (q : ℂ × ℂ), β 0 r q = 0
  β_endpoints : ∀ (l : Fin (J + 1)) (q : ℂ × ℂ), β l 0 q = 0 ∧ β l (Fin.last k) q = 0
  β_taylor : ∀ (l : Fin (J + 1)) (r : Fin (k + 1)), 1 ≤ (l : ℕ) →
    taylor2D (β l r) ((a₁ : ℂ), (δ₁ : ℂ)) = D_form.β_full (l : ℕ) r
  grad_jet_zero : ∀ q ∈ V_plus, ∀ r : Fin (k - 1), ∀ l : ℕ, 1 ≤ l → l ≤ J →
    pointArcEpsJet l
      (fun ε =>
        pointRelInteriorGrad (fun i => G.ℓ_fn i q) (pointArcPertGraph G.F g ε)
          (pointArcPertGraphDeriv G.F g ε)
          (pointArcPertAbscissa (fun s => G.x_fn s q) (fun m s => β m s q) ε) r) = 0
  len_jet_split : ∀ q ∈ V_plus, ∀ (l : Fin (J + 1)), 1 ≤ (l : ℕ) →
    pointArcEpsJet (l : ℕ)
      (fun ε =>
        pointRelChainLen (fun i => G.ℓ_fn i q) (pointArcPertGraph G.F g ε)
          (pointArcPertAbscissa (fun s => G.x_fn s q) (fun m s => β m s q) ε)) =
      U_split l q.1 + V_split l (q.1 + q.2)
def IsTriangularHoloMap (W₁ : Set (ℂ × ℂ)) (Υ : ℂ × ℂ → ℂ × ℂ) : Prop :=
  IsOpen W₁ ∧
  ∃ (U_v : Set ℂ) (h φ : ℂ → ℂ),
    IsOpen U_v ∧ IsPreconnected U_v ∧
    (∀ p ∈ W₁, p.2 ∈ U_v ∧ Υ p = (p.1 + h p.2, φ p.2)) ∧
    DifferentiableOn ℂ h U_v ∧
    DifferentiableOn ℂ φ U_v ∧
    ∃ v₀ ∈ U_v, deriv φ v₀ ≠ 0

structure Mero2DPullbackGluingToolkit : Prop where
  ofHolo : ∀ (U : Set (ℂ × ℂ)) (f : ℂ × ℂ → ℂ),
    IsOpen U → DifferentiableOn ℂ f U →
    ∃ H : MeroOn2D U, MeroAgreesHolo H f U ∧
      ∀ (W : Set (ℂ × ℂ)) (F : MeroOn2D W) (V : Set (ℂ × ℂ)),
        IsOpen V → V ⊆ U →
        (MeroAgreesHolo F f V ↔ MeroEqOn F H V)
  eqOn_symm : ∀ {W₁ W₂ : Set (ℂ × ℂ)} (F₁ : MeroOn2D W₁) (F₂ : MeroOn2D W₂)
    (U : Set (ℂ × ℂ)), MeroEqOn F₁ F₂ U → MeroEqOn F₂ F₁ U
  eqOn_mono : ∀ {W₁ W₂ : Set (ℂ × ℂ)} (F₁ : MeroOn2D W₁) (F₂ : MeroOn2D W₂)
    {U V : Set (ℂ × ℂ)}, V ⊆ U → MeroEqOn F₁ F₂ U → MeroEqOn F₁ F₂ V
  eqOn_trans : ∀ {W₁ W₂ W₃ : Set (ℂ × ℂ)}
    (F₁ : MeroOn2D W₁) (F₂ : MeroOn2D W₂) (F₃ : MeroOn2D W₃)
    (U : Set (ℂ × ℂ)),
    MeroEqOn F₁ F₂ U → MeroEqOn F₂ F₃ U → MeroEqOn F₁ F₃ U
  eqOn_of_isPreconnected : ∀ {W₁ W₂ : Set (ℂ × ℂ)}
    (F₁ : MeroOn2D W₁) (F₂ : MeroOn2D W₂) (V V₀ : Set (ℂ × ℂ)),
    IsOpen V → IsPreconnected V → V ⊆ W₁ ∩ W₂ →
    IsOpen V₀ → V₀.Nonempty → V₀ ⊆ V →
    MeroEqOn F₁ F₂ V₀ → MeroEqOn F₁ F₂ V
  restrictOpen : ∀ {W : Set (ℂ × ℂ)} (F : MeroOn2D W) (V : Set (ℂ × ℂ)),
    IsOpen V → V ⊆ W → ∃ G : MeroOn2D V, MeroEqOn G F V
  glueCover : ∀ {ι : Type} (U : ι → Set (ℂ × ℂ)) (W : Set (ℂ × ℂ))
    (G : ∀ α, MeroOn2D (U α)),
    (∀ α, IsOpen (U α)) → IsOpen W → W ⊆ (⋃ α, U α) →
    (∀ α β, MeroEqOn (G α) (G β) (U α ∩ U β)) →
    ∃ F : MeroOn2D W, ∀ α, MeroEqOn F (G α) (W ∩ U α)
  glueBinary : ∀ {U₁ U₂ W : Set (ℂ × ℂ)} (G₁ : MeroOn2D U₁) (G₂ : MeroOn2D U₂),
    IsOpen U₁ → IsOpen U₂ → IsOpen W → W ⊆ U₁ ∪ U₂ →
    MeroEqOn G₁ G₂ (U₁ ∩ U₂) →
    ∃ F : MeroOn2D W, MeroEqOn F G₁ (W ∩ U₁) ∧ MeroEqOn F G₂ (W ∩ U₂)
  triangular_mono : ∀ {W₁ U : Set (ℂ × ℂ)} (Υ : ℂ × ℂ → ℂ × ℂ),
    IsOpen U → U ⊆ W₁ → IsTriangularHoloMap W₁ Υ → IsTriangularHoloMap U Υ
  eqOn_iff_pullback_id : ∀ {W₁ W₂ : Set (ℂ × ℂ)} (F₁ : MeroOn2D W₁) (F₂ : MeroOn2D W₂)
    (U : Set (ℂ × ℂ)), MeroEqOn F₁ F₂ U ↔ MeroEqOnPullback F₁ F₂ id U
  pullback_mono : ∀ {W₁ W₂ : Set (ℂ × ℂ)} (G : MeroOn2D W₁) (F : MeroOn2D W₂)
    (Υ : ℂ × ℂ → ℂ × ℂ) {U V : Set (ℂ × ℂ)},
    V ⊆ U → MeroEqOnPullback G F Υ U → MeroEqOnPullback G F Υ V
  eqOn_pullback_left : ∀ {W₁ W₁' W₂ : Set (ℂ × ℂ)}
    (G₁ : MeroOn2D W₁) (G₂ : MeroOn2D W₁') (F : MeroOn2D W₂)
    (Υ : ℂ × ℂ → ℂ × ℂ) (U : Set (ℂ × ℂ)),
    IsTriangularHoloMap U Υ →
    MeroEqOn G₁ G₂ U → MeroEqOnPullback G₂ F Υ U → MeroEqOnPullback G₁ F Υ U
  pullback_exists : ∀ {W₁ W₂ : Set (ℂ × ℂ)} (Υ : ℂ × ℂ → ℂ × ℂ) (F : MeroOn2D W₂),
    IsTriangularHoloMap W₁ Υ → Set.MapsTo Υ W₁ W₂ →
    ∃ G : MeroOn2D W₁, MeroEqOnPullback G F Υ W₁
  pullback_right_eqOn : ∀ {W₁ W₂ W₂' : Set (ℂ × ℂ)}
    (G : MeroOn2D W₁) (F₁ : MeroOn2D W₂) (F₂ : MeroOn2D W₂')
    (Υ : ℂ × ℂ → ℂ × ℂ) (U V₂ : Set (ℂ × ℂ)),
    IsTriangularHoloMap U Υ → Set.MapsTo Υ U V₂ →
    MeroEqOnPullback G F₁ Υ U → MeroEqOn F₁ F₂ V₂ → MeroEqOnPullback G F₂ Υ U
  pullback_comp : ∀ {W₁ W₂ W₃ : Set (ℂ × ℂ)}
    (G₁ : MeroOn2D W₁) (G₂ : MeroOn2D W₂) (F : MeroOn2D W₃)
    (Υ₁ Υ₂ : ℂ × ℂ → ℂ × ℂ) (U₁ U₂ : Set (ℂ × ℂ)),
    IsTriangularHoloMap U₁ Υ₁ → IsTriangularHoloMap U₂ Υ₂ →
    Set.MapsTo Υ₁ U₁ U₂ →
    MeroEqOnPullback G₁ G₂ Υ₁ U₁ → MeroEqOnPullback G₂ F Υ₂ U₂ →
    MeroEqOnPullback G₁ F (Υ₂ ∘ Υ₁) U₁
  pullback_congr_eqOn : ∀ {W₁ W₁' W₂ W₂' : Set (ℂ × ℂ)}
    (G₁ : MeroOn2D W₁) (G₂ : MeroOn2D W₁') (F₁ : MeroOn2D W₂) (F₂ : MeroOn2D W₂')
    (Υ₁ Υ₂ : ℂ × ℂ → ℂ × ℂ) (U V₂ : Set (ℂ × ℂ)),
    IsTriangularHoloMap U Υ₁ → (∀ p ∈ U, Υ₁ p = Υ₂ p) → Set.MapsTo Υ₁ U V₂ →
    MeroEqOnPullback G₁ F₁ Υ₁ U → MeroEqOnPullback G₂ F₂ Υ₂ U →
    MeroEqOn F₁ F₂ V₂ → MeroEqOn G₁ G₂ U
noncomputable def rjCompConst_rajcb : ℕ → ℝ → ℝ
  | 0, _ => 1
  | n + 1, B => max 1 ((2 : ℝ) ^ n * (max B 0 + 1)) * rjCompConst_rajcb n B

def IsParamJetBounded_rajcb {α : Type} [TopologicalSpace α] (S : Set α) (p : ℕ) (B : ℝ)
    (F : α → ℝ → ℝ) : Prop :=
  (∀ a ∈ S, ContDiff ℝ (p : WithTop ℕ∞) (F a)) ∧
  (∀ k : ℕ, k ≤ p →
    ContinuousOn (fun q : α × ℝ => iteratedDeriv k (F q.1) q.2) (S ×ˢ Set.univ)) ∧
  (∀ a ∈ S, ∀ k : ℕ, k ≤ p → ∀ x : ℝ, |iteratedDeriv k (F a) x| ≤ B)

def IsParamUnboundedInner_rajcb {α : Type} [TopologicalSpace α] (S : Set α) (p : ℕ) (B : ℝ)
    (Φ : α → ℝ → ℝ) : Prop :=
  (∀ a ∈ S, ContDiff ℝ (p : WithTop ℕ∞) (Φ a)) ∧
  (∀ k : ℕ, k ≤ p →
    ContinuousOn (fun q : α × ℝ => iteratedDeriv k (Φ q.1) q.2) (S ×ˢ Set.univ)) ∧
  (∀ a ∈ S, ∀ j : ℕ, 1 ≤ j → j ≤ p → ∀ x : ℝ, |iteratedDeriv j (Φ a) x| ≤ B)

def IsParamJetPair_rajcb {α : Type} [TopologicalSpace α] (S : Set α) (p : ℕ)
    (Δ B L : ℝ) (F₁ F₂ : α → ℝ → ℝ) : Prop :=
  0 ≤ B ∧ 0 ≤ L ∧
  IsParamJetBounded_rajcb S p B F₁ ∧
  IsParamJetBounded_rajcb S p B F₂ ∧
  IsParamJetBounded_rajcb S p (L * Δ) (fun a x => F₁ a x - F₂ a x)

def IsParamInnerPair_rajcb {α : Type} [TopologicalSpace α] (S : Set α) (p : ℕ)
    (Δ B L : ℝ) (Φ₁ Φ₂ : α → ℝ → ℝ) : Prop :=
  0 ≤ B ∧ 0 ≤ L ∧
  IsParamUnboundedInner_rajcb S p B Φ₁ ∧
  IsParamUnboundedInner_rajcb S p B Φ₂ ∧
  IsParamJetBounded_rajcb S p (L * Δ) (fun a x => Φ₁ a x - Φ₂ a x)

structure JetTwoInput_rajcb (m : ℕ) (M₁ : ℝ) (N₀ : ℕ) where
  q : ℕ
  ρ : ℝ
  sgn : ℝ
  Δe : ℝ
  Δτ : ℝ
  w₁ : ℝ → ℝ
  w₂ : ℝ → ℝ
  e_X₁ : ℝ → ℝ
  τ_T₁ : ℝ → ℝ
  e_X₂ : ℝ → ℝ
  τ_T₂ : ℝ → ℝ
  hq : N₀ ≤ q
  hsgn : sgn = 1 ∨ sgn = -1
  hΔe : 0 ≤ Δe
  hΔτ : 0 ≤ Δτ
  hw₁ : IsPeriodicSmoothBounded (m + 15) M₁ w₁
  hw₂ : IsPeriodicSmoothBounded (m + 15) M₁ w₂
  he₁ : IsRealJetPerturb (m + 2) ((4 * (q : ℝ))⁻¹) e_X₁
  hτ₁ : IsRealJetPerturb (m + 2) ((4 * (q : ℝ))⁻¹) τ_T₁
  he₂ : IsRealJetPerturb (m + 2) ((4 * (q : ℝ))⁻¹) e_X₂
  hτ₂ : IsRealJetPerturb (m + 2) ((4 * (q : ℝ))⁻¹) τ_T₂
  hde : ∀ k : ℕ, k ≤ m + 2 → ∀ x : ℝ, |iteratedDeriv k (fun y => e_X₁ y - e_X₂ y) x| ≤ Δe
  hdτ : ∀ k : ℕ, k ≤ m + 2 → ∀ x : ℝ, |iteratedDeriv k (fun y => τ_T₁ y - τ_T₂ y) x| ≤ Δτ

noncomputable def JetTwoInput_rajcb.X₁ {m : ℕ} {M₁ : ℝ} {N₀ : ℕ}
    (J : JetTwoInput_rajcb m M₁ N₀) (x : ℝ) : ℝ :=
  x + J.ρ + J.e_X₁ x

noncomputable def JetTwoInput_rajcb.X₂ {m : ℕ} {M₁ : ℝ} {N₀ : ℕ}
    (J : JetTwoInput_rajcb m M₁ N₀) (x : ℝ) : ℝ :=
  x + J.ρ + J.e_X₂ x

noncomputable def JetTwoInput_rajcb.T₁ {m : ℕ} {M₁ : ℝ} {N₀ : ℕ}
    (J : JetTwoInput_rajcb m M₁ N₀) (x : ℝ) : ℝ :=
  J.sgn * (2 * Real.pi / (J.q : ℝ)) + J.τ_T₁ x

noncomputable def JetTwoInput_rajcb.T₂ {m : ℕ} {M₁ : ℝ} {N₀ : ℕ}
    (J : JetTwoInput_rajcb m M₁ N₀) (x : ℝ) : ℝ :=
  J.sgn * (2 * Real.pi / (J.q : ℝ)) + J.τ_T₂ x

def HasUniformJetPair_rajcb (m : ℕ) (M₁ : ℝ) (N₀ : ℕ)
    {α : Type} [TopologicalSpace α] (S : Set α)
    (Δ_fn : JetTwoInput_rajcb m M₁ N₀ → ℝ)
    (F₁ F₂ : JetTwoInput_rajcb m M₁ N₀ → α → ℝ → ℝ) : Prop :=
  ∃ B L : ℝ, 0 ≤ B ∧ 0 ≤ L ∧
    ∀ J : JetTwoInput_rajcb m M₁ N₀,
      IsParamJetPair_rajcb S (m + 2) (Δ_fn J) B L (F₁ J) (F₂ J)

def HasUniformInnerPair_rajcb (m : ℕ) (M₁ : ℝ) (N₀ : ℕ)
    {α : Type} [TopologicalSpace α] (S : Set α)
    (Δ_fn : JetTwoInput_rajcb m M₁ N₀ → ℝ)
    (Φ₁ Φ₂ : JetTwoInput_rajcb m M₁ N₀ → α → ℝ → ℝ) : Prop :=
  ∃ B L : ℝ, 0 ≤ B ∧ 0 ≤ L ∧
    ∀ J : JetTwoInput_rajcb m M₁ N₀,
      IsParamInnerPair_rajcb S (m + 2) (Δ_fn J) B L (Φ₁ J) (Φ₂ J)

structure RjCalcToolkit_rajcb : Prop where
  compConst_ge_one : ∀ (p : ℕ) (B : ℝ), 1 ≤ rjCompConst_rajcb p B
  compConst_max_zero : ∀ (p : ℕ) (B : ℝ), rjCompConst_rajcb p (max B 0) = rjCompConst_rajcb p B
  congr : ∀ {α : Type} [TopologicalSpace α] {S : Set α} {p : ℕ} {B : ℝ}
      {F₁ F₂ : α → ℝ → ℝ},
    (∀ a ∈ S, ∀ x : ℝ, F₁ a x = F₂ a x) →
    IsParamJetBounded_rajcb S p B F₁ → IsParamJetBounded_rajcb S p B F₂
  congr_inner : ∀ {α : Type} [TopologicalSpace α] {S : Set α} {p : ℕ} {B : ℝ}
      {Φ₁ Φ₂ : α → ℝ → ℝ},
    (∀ a ∈ S, ∀ x : ℝ, Φ₁ a x = Φ₂ a x) →
    IsParamUnboundedInner_rajcb S p B Φ₁ → IsParamUnboundedInner_rajcb S p B Φ₂
  mono : ∀ {α : Type} [TopologicalSpace α] {S : Set α} {p : ℕ} {B₁ B₂ : ℝ}
      {F : α → ℝ → ℝ},
    B₁ ≤ B₂ → IsParamJetBounded_rajcb S p B₁ F → IsParamJetBounded_rajcb S p B₂ F
  param_const : ∀ {α : Type} [TopologicalSpace α] {S : Set α} (p : ℕ) {B : ℝ}
      {c : α → ℝ},
    0 ≤ B → ContinuousOn c S → (∀ a ∈ S, |c a| ≤ B) →
    IsParamJetBounded_rajcb S p B (fun a _ => c a)
  add : ∀ {α : Type} [TopologicalSpace α] {S : Set α} {p : ℕ} {B₁ B₂ : ℝ}
      {F₁ F₂ : α → ℝ → ℝ},
    IsParamJetBounded_rajcb S p B₁ F₁ → IsParamJetBounded_rajcb S p B₂ F₂ →
    IsParamJetBounded_rajcb S p (B₁ + B₂) (fun a x => F₁ a x + F₂ a x)
  sub : ∀ {α : Type} [TopologicalSpace α] {S : Set α} {p : ℕ} {B₁ B₂ : ℝ}
      {F₁ F₂ : α → ℝ → ℝ},
    IsParamJetBounded_rajcb S p B₁ F₁ → IsParamJetBounded_rajcb S p B₂ F₂ →
    IsParamJetBounded_rajcb S p (B₁ + B₂) (fun a x => F₁ a x - F₂ a x)
  neg : ∀ {α : Type} [TopologicalSpace α] {S : Set α} {p : ℕ} {B : ℝ}
      {F : α → ℝ → ℝ},
    IsParamJetBounded_rajcb S p B F → IsParamJetBounded_rajcb S p B (fun a x => -F a x)
  param_mul : ∀ {α : Type} [TopologicalSpace α] {S : Set α} {p : ℕ} {C B : ℝ}
      {c : α → ℝ} {F : α → ℝ → ℝ},
    0 ≤ C → 0 ≤ B → ContinuousOn c S → (∀ a ∈ S, |c a| ≤ C) →
    IsParamJetBounded_rajcb S p B F →
    IsParamJetBounded_rajcb S p (C * B) (fun a x => c a * F a x)
  mul : ∀ {α : Type} [TopologicalSpace α] {S : Set α} {p : ℕ} {B₁ B₂ : ℝ}
      {F₁ F₂ : α → ℝ → ℝ},
    0 ≤ B₁ → 0 ≤ B₂ →
    IsParamJetBounded_rajcb S p B₁ F₁ → IsParamJetBounded_rajcb S p B₂ F₂ →
    IsParamJetBounded_rajcb S p ((2 : ℝ) ^ p * B₁ * B₂) (fun a x => F₁ a x * F₂ a x)
  pullback : ∀ {α β : Type} [TopologicalSpace α] [TopologicalSpace β]
      {S : Set α} {T : Set β} {p : ℕ} {B : ℝ} {φ : β → α} {F : α → ℝ → ℝ},
    ContinuousOn φ T → Set.MapsTo φ T S →
    IsParamJetBounded_rajcb S p B F →
    IsParamJetBounded_rajcb T p B (fun b x => F (φ b) x)
  pullback_inner : ∀ {α β : Type} [TopologicalSpace α] [TopologicalSpace β]
      {S : Set α} {T : Set β} {p : ℕ} {B : ℝ} {φ : β → α} {Φ : α → ℝ → ℝ},
    ContinuousOn φ T → Set.MapsTo φ T S →
    IsParamUnboundedInner_rajcb S p B Φ →
    IsParamUnboundedInner_rajcb T p B (fun b x => Φ (φ b) x)
  inner_of_bounded : ∀ {α : Type} [TopologicalSpace α] {S : Set α} {p : ℕ} {B : ℝ}
      {F : α → ℝ → ℝ},
    IsParamJetBounded_rajcb S p B F → IsParamUnboundedInner_rajcb S p B F
  inner_add : ∀ {α : Type} [TopologicalSpace α] {S : Set α} {p : ℕ} {B₁ B₂ : ℝ}
      {Φ₁ Φ₂ : α → ℝ → ℝ},
    IsParamUnboundedInner_rajcb S p B₁ Φ₁ → IsParamUnboundedInner_rajcb S p B₂ Φ₂ →
    IsParamUnboundedInner_rajcb S p (B₁ + B₂) (fun a x => Φ₁ a x + Φ₂ a x)
  comp_bound : ∀ {α : Type} [TopologicalSpace α] {S : Set α} (p : ℕ) {M_g B : ℝ}
      {g : ℝ → ℝ} {Φ : α → ℝ → ℝ},
    ContDiff ℝ (p : WithTop ℕ∞) g →
    IsParamUnboundedInner_rajcb S p B Φ →
    0 ≤ M_g →
    (∀ j : ℕ, j ≤ p → ∀ a ∈ S, ∀ x : ℝ, |iteratedDeriv j g (Φ a x)| ≤ M_g) →
    IsParamJetBounded_rajcb S p (M_g * rjCompConst_rajcb p B) (fun a x => g (Φ a x))
  param_integral : ∀ {α : Type} [TopologicalSpace α] {S : Set α} {p : ℕ} {B : ℝ}
      {F : (α × ℝ) → ℝ → ℝ},
    0 ≤ B →
    IsParamJetBounded_rajcb (S ×ˢ Set.Icc (0 : ℝ) 1) p B F →
    IsParamJetBounded_rajcb S p B (fun a x => ∫ t in (0 : ℝ)..1, F (a, t) x)
  comp_diff_bound : ∀ {α : Type} [TopologicalSpace α] {S : Set α} (p : ℕ) {M_g Δg B ΔΦ : ℝ}
      {g₁ g₂ : ℝ → ℝ} {Φ₁ Φ₂ : α → ℝ → ℝ},
    ContDiff ℝ ((p + 1 : ℕ) : WithTop ℕ∞) g₁ →
    ContDiff ℝ (p : WithTop ℕ∞) g₂ →
    IsParamUnboundedInner_rajcb S p B Φ₁ →
    IsParamUnboundedInner_rajcb S p B Φ₂ →
    IsParamJetBounded_rajcb S p ΔΦ (fun a x => Φ₁ a x - Φ₂ a x) →
    0 ≤ M_g → 0 ≤ Δg → 0 ≤ ΔΦ →
    (∀ j : ℕ, 1 ≤ j → j ≤ p + 1 → ∀ a ∈ S, ∀ s ∈ Set.Icc (0 : ℝ) 1, ∀ x : ℝ,
      |iteratedDeriv j g₁ (Φ₂ a x + s * (Φ₁ a x - Φ₂ a x))| ≤ M_g) →
    (∀ j : ℕ, j ≤ p → ∀ a ∈ S, ∀ x : ℝ,
      |iteratedDeriv j (fun y => g₁ y - g₂ y) (Φ₂ a x)| ≤ Δg) →
    IsParamJetBounded_rajcb S p
      ((2 : ℝ) ^ p * (M_g * rjCompConst_rajcb p B) * ΔΦ + Δg * rjCompConst_rajcb p B)
      (fun a x => g₁ (Φ₁ a x) - g₂ (Φ₂ a x))

structure PtTwoInput_rajcb (m : ℕ) (M₁ : ℝ) where
  w : ℝ → ℝ
  X₁ : ℝ
  X₂ : ℝ
  T₁ : ℝ
  T₂ : ℝ
  hw : IsPeriodicSmoothBounded (m + 15) M₁ w
  hT₁ : |T₁| ≤ 2
  hT₂ : |T₂| ≤ 2

def IsParamScalarPair_rajcb {α : Type} [TopologicalSpace α] (S : Set α)
    (δ B L : ℝ) (f₁ f₂ : α → ℝ) : Prop :=
  0 ≤ B ∧ 0 ≤ L ∧
  ContinuousOn f₁ S ∧
  ContinuousOn f₂ S ∧
  ∀ a ∈ S, |f₁ a| ≤ B ∧ |f₂ a| ≤ B ∧ |f₁ a - f₂ a| ≤ L * δ

def IsParamScalarInner_rajcb {α : Type} [TopologicalSpace α] (S : Set α)
    (δ L : ℝ) (φ₁ φ₂ : α → ℝ) : Prop :=
  0 ≤ L ∧
  ContinuousOn φ₁ S ∧
  ContinuousOn φ₂ S ∧
  ∀ a ∈ S, |φ₁ a - φ₂ a| ≤ L * δ

def HasUniformScalarPair_rajcb (m : ℕ) (M₁ : ℝ)
    {α : Type} [TopologicalSpace α] (S : Set α)
    (δ_fn : PtTwoInput_rajcb m M₁ → ℝ)
    (f₁ f₂ : PtTwoInput_rajcb m M₁ → α → ℝ) : Prop :=
  ∃ B L : ℝ, 0 ≤ B ∧ 0 ≤ L ∧
    ∀ P : PtTwoInput_rajcb m M₁,
      IsParamScalarPair_rajcb S (δ_fn P) B L (f₁ P) (f₂ P)

def HasUniformScalarInner_rajcb (m : ℕ) (M₁ : ℝ)
    {α : Type} [TopologicalSpace α] (S : Set α)
    (δ_fn : PtTwoInput_rajcb m M₁ → ℝ)
    (φ₁ φ₂ : PtTwoInput_rajcb m M₁ → α → ℝ) : Prop :=
  ∃ L : ℝ, 0 ≤ L ∧
    ∀ P : PtTwoInput_rajcb m M₁,
      IsParamScalarInner_rajcb S (δ_fn P) L (φ₁ P) (φ₂ P)
def lineCoalescingTridiag (m : ℕ) : Matrix (Fin m) (Fin m) ℂ :=
  fun r s =>
    if r.1 = s.1 then 2
    else if s.1 = r.1 + 1 ∨ r.1 = s.1 + 1 then -1
    else 0

def lineCoalescingIntVtx {k : ℕ} (s : Fin (k - 1)) : Fin (k + 1) :=
  ⟨s.1 + 1, Nat.add_lt_add_right (lt_of_lt_of_le s.2 (Nat.sub_le k 1)) 1⟩

noncomputable def lineCoalescingDslopeIter (F : ℂ → ℂ) (z₀ : ℂ) : ℕ → ℂ → ℂ
  | 0 => F
  | n + 1 => dslope (lineCoalescingDslopeIter F z₀ n) z₀

noncomputable def lineCoalescingFormalSeq (k : ℕ) (r_a : ℂ) (f_p : Fin k → ℂ) :
    ℕ → Fin (k + 1) → ℂ
  | 0 => fun s => ((s.1 : ℕ) : ℂ) / (k : ℂ)
  | q + 1 =>
      let prev : Fin (q + 1) → Fin (k + 1) → ℂ :=
        fun m =>
          have _ := m.2
          lineCoalescingFormalSeq k r_a f_p m.1
      let Δ : Fin (q + 1) → Fin k → ℂ :=
        fun m i => prev m i.succ - prev m i.castSucc
      let quad : Fin k → ℂ :=
        fun i =>
          ∑ a ∈ (Finset.Ico 1 (q + 1)).attach,
            Δ ⟨a.1, (Finset.mem_Ico.mp a.2).2⟩ i *
              Δ ⟨q + 1 - a.1, by have := Finset.mem_Ico.mp a.2; omega⟩ i
      let rhs : Fin (k - 1) → ℂ :=
        fun r =>
          if hk : 2 ≤ k then
            -(r_a / 8) *
                (quad ⟨r.1, by have := r.2; omega⟩ -
                  quad ⟨r.1 + 1, by have := r.2; omega⟩) +
              (if q = 0 then
                f_p ⟨r.1, by have := r.2; omega⟩ -
                  f_p ⟨r.1 + 1, by have := r.2; omega⟩
              else 0)
          else 0
      let A₀ : Matrix (Fin (k - 1)) (Fin (k - 1)) ℂ :=
        (-(r_a / (4 * (k : ℂ)))) • lineCoalescingTridiag (k - 1)
      let sol : Fin (k - 1) → ℂ := (A₀.det)⁻¹ • A₀.cramer (-rhs)
      fun s =>
        if _hs0 : s.1 = 0 then 0
        else if _hsk : s.1 < k then sol ⟨s.1 - 1, by omega⟩
        else 0
noncomputable def lcJetMid2D {k : ℕ}
    (β : Fin (k + 1) → MvPowerSeries (Fin 2) ℂ) (i : Fin k) :
    MvPowerSeries (Fin 2) ℂ :=
  MvPowerSeries.C (1 / 2 : ℂ) * (β i.castSucc + β i.succ)

noncomputable def lcJetHalfStep2D {k : ℕ}
    (β : Fin (k + 1) → MvPowerSeries (Fin 2) ℂ) (i : Fin k) :
    MvPowerSeries (Fin 2) ℂ :=
  MvPowerSeries.C (1 / 2 : ℂ) * (β i.succ - β i.castSucc)

noncomputable def lcJetAction2D {k : ℕ}
    (h_ser S_ser : Fin k → PowerSeries ℂ)
    (β : Fin (k + 1) → MvPowerSeries (Fin 2) ℂ) :
    MvPowerSeries (Fin 2) ℂ :=
  ∑ i : Fin k,
    MvPowerSeries.C (2 : ℂ) *
      compPowerSeries2D (h_ser i) (lcJetMid2D β i) *
      compPowerSeries2D (S_ser i) (lcJetHalfStep2D β i)

noncomputable def lcJetEdgePlus2D
    (h_i S_i C_i : PowerSeries ℂ)
    (ψ_i d_i : MvPowerSeries (Fin 2) ℂ) :
    MvPowerSeries (Fin 2) ℂ :=
  compPowerSeries2D (PowerSeries.derivative h_i) ψ_i * compPowerSeries2D S_i d_i +
    compPowerSeries2D h_i ψ_i * compPowerSeries2D C_i d_i

noncomputable def lcJetEdgeMinus2D
    (h_i S_i C_i : PowerSeries ℂ)
    (ψ_i d_i : MvPowerSeries (Fin 2) ℂ) :
    MvPowerSeries (Fin 2) ℂ :=
  compPowerSeries2D (PowerSeries.derivative h_i) ψ_i * compPowerSeries2D S_i d_i -
    compPowerSeries2D h_i ψ_i * compPowerSeries2D C_i d_i

noncomputable def lcJetGrad2D {k : ℕ}
    (h_ser S_ser C_ser : Fin k → PowerSeries ℂ)
    (β : Fin (k + 1) → MvPowerSeries (Fin 2) ℂ) (r : Fin (k - 1)) :
    MvPowerSeries (Fin 2) ℂ :=
  let i_L : Fin k := ⟨r.1, by have := r.2; omega⟩
  let i_R : Fin k := ⟨r.1 + 1, by have := r.2; omega⟩
  lcJetEdgePlus2D (h_ser i_L) (S_ser i_L) (C_ser i_L)
      (lcJetMid2D β i_L) (lcJetHalfStep2D β i_L) +
    lcJetEdgeMinus2D (h_ser i_R) (S_ser i_R) (C_ser i_R)
      (lcJetMid2D β i_R) (lcJetHalfStep2D β i_R)

noncomputable def lcJetFormalHess {k : ℕ}
    (h_ser : Fin k → PowerSeries ℂ) (s_d c_d : Fin k → ℂ) :
    Matrix (Fin (k - 1)) (Fin (k - 1)) ℂ :=
  fun r s =>
    let i_L : Fin k := ⟨r.1, by have := r.2; omega⟩
    let i_R : Fin k := ⟨r.1 + 1, by have := r.2; omega⟩
    let h0_L := PowerSeries.coeff 0 (h_ser i_L)
    let h1_L := PowerSeries.coeff 1 (h_ser i_L)
    let h2_L := 2 * PowerSeries.coeff 2 (h_ser i_L)
    let h0_R := PowerSeries.coeff 0 (h_ser i_R)
    let h1_R := PowerSeries.coeff 1 (h_ser i_R)
    let h2_R := 2 * PowerSeries.coeff 2 (h_ser i_R)
    if r.1 = s.1 then
      ((h2_L - h0_L) / 2 * s_d i_L + h1_L * c_d i_L) +
        ((h2_R - h0_R) / 2 * s_d i_R - h1_R * c_d i_R)
    else if s.1 = r.1 + 1 then
      (h0_R + h2_R) / 2 * s_d i_R
    else if r.1 = s.1 + 1 then
      (h0_L + h2_L) / 2 * s_d i_L
    else
      0

noncomputable def lcJetTrunc1D (K : ℕ) (f : PowerSeries ℂ) : PowerSeries ℂ :=
  PowerSeries.mk fun m => if m ≤ K then PowerSeries.coeff m f else 0

noncomputable def lcJetTruncAngles {k : ℕ} (N₀ : ℕ)
    (α : Fin (k + 1) → MvPowerSeries (Fin 2) ℂ) (r : Fin (k + 1)) :
    MvPowerSeries (Fin 2) ℂ :=
  fun u =>
    if r.1 = 0 ∨ r.1 = k then MvPowerSeries.coeff u (α r)
    else if u 0 + u 1 < N₀ then MvPowerSeries.coeff u (α r)
    else 0
def sjcHoloLipPair (p : ℕ) (σ' M L Δ : ℝ) (f₁ f₂ : ℂ → ℂ) : Prop :=
  0 ≤ M ∧ 0 ≤ L ∧ 0 ≤ Δ ∧
  IsStripHoloSymBounded p σ' M f₁ ∧
  IsStripHoloSymBounded p σ' M f₂ ∧
  IsStripBounded p σ' (L * Δ) (fun z => f₁ z - f₂ z)

noncomputable def sjcPowM (p : ℕ) (M : ℝ) : ℕ → ℝ
  | 0 => 1
  | d + 1 => (2 : ℝ) ^ p * sjcPowM p M d * M

noncomputable def sjcPowL (p : ℕ) (M L : ℝ) : ℕ → ℝ
  | 0 => 0
  | d + 1 => (2 : ℝ) ^ p * (sjcPowM p M d * L + sjcPowL p M L d * M)

noncomputable def sjcInvM (p : ℕ) (M_g : ℝ) : ℝ :=
  (((p + 1).factorial : ℝ) * (4 : ℝ) ^ (p + 2)) * shjCompConst p M_g

noncomputable def sjcInvL (p : ℕ) (M_g L_g : ℝ) : ℝ :=
  (2 : ℝ) ^ p * sjcInvM p M_g * L_g

noncomputable def sjcDivM (p : ℕ) (M_f M_g : ℝ) : ℝ :=
  (2 : ℝ) ^ p * M_f * sjcInvM p M_g

noncomputable def sjcDivL (p : ℕ) (M_f L_f M_g L_g : ℝ) : ℝ :=
  (2 : ℝ) ^ p * (M_f * sjcInvL p M_g L_g + L_f * sjcInvM p M_g)

noncomputable def sjcExpM (p : ℕ) (M_f : ℝ) : ℝ :=
  Real.exp (M_f + 1) * shjCompConst p M_f

noncomputable def sjcExpL (p : ℕ) (M_f L_f : ℝ) : ℝ :=
  shjCompConst p M_f * ((2 : ℝ) ^ p * Real.exp (M_f + 1) * L_f)

noncomputable def sjcSincM (p : ℕ) (M_f : ℝ) : ℝ :=
  (1 / 2 : ℝ) * sjcExpM p M_f

noncomputable def sjcSincL (p : ℕ) (M_f L_f : ℝ) : ℝ :=
  (1 / 2 : ℝ) * sjcExpL p M_f L_f

def sjcAdmissibleEval (m : ℕ) (M₁ σ σ' Δ : ℝ)
    (w₁ w₂ : ℝ → ℝ) (W₁ W₂ X₁ T₁ z₀₁ X₂ T₂ z₀₂ : ℂ → ℂ) : Prop :=
  0 < σ ∧ 0 < σ' ∧ 0 ≤ Δ ∧
  IsBoundedStripExt (m + 15) σ M₁ w₁ W₁ ∧
  IsBoundedStripExt (m + 15) σ M₁ w₂ W₂ ∧
  sjcHoloLipPair (m + 2) σ' 1 1 Δ T₁ T₂ ∧
  sjcHoloLipPair (m + 2) σ' 1 1 Δ z₀₁ z₀₂ ∧
  sjcHoloLipPair (m + 2) σ' 1 (2 * (2 : ℝ) ^ (m + 2)) Δ
    (fun z => T₁ z * z₀₁ z) (fun z => T₂ z * z₀₂ z) ∧
  (∀ c ∈ Set.Icc (0 : ℝ) 1, ∀ z ∈ horizStrip σ',
    (X₁ z + (c : ℂ) * T₁ z ∈ horizStrip σ ∧ X₂ z + (c : ℂ) * T₂ z ∈ horizStrip σ) ∧
    (X₁ z + (c : ℂ) * (T₁ z * z₀₁ z) ∈ horizStrip σ ∧
      X₂ z + (c : ℂ) * (T₂ z * z₀₂ z) ∈ horizStrip σ)) ∧
  (∀ (L_y : ℝ) (y₁ y₂ : ℂ → ℂ),
    sjcHoloLipPair (m + 2) σ' 1 L_y Δ y₁ y₂ →
    (∀ z ∈ horizStrip σ', X₁ z + y₁ z ∈ horizStrip σ ∧ X₂ z + y₂ z ∈ horizStrip σ) →
    ∀ d : ℕ, d ≤ 3 →
      sjcHoloLipPair (m + 2) σ'
        (M₁ * shjCompConst (m + 2) 3)
        (shjCompConst (m + 2) 3 * (1 + (2 : ℝ) ^ (m + 2) * M₁ * (1 + L_y)))
        Δ
        (fun z => iteratedDeriv d W₁ (X₁ z + y₁ z))
        (fun z => iteratedDeriv d W₂ (X₂ z + y₂ z))) ∧
  (∀ z ∈ horizStrip σ',
    ‖mFactor_C W₁ (X₁ z) (T₁ z) (z₀₁ z) - 1‖ ≤ 1 / 2 ∧
    ‖mFactor_C W₂ (X₂ z) (T₂ z) (z₀₂ z) - 1‖ ≤ 1 / 2)
noncomputable def glancingPrelimLift (t₀ : ℝ) (U : ℂ × ℂ → ℂ) (U_star : ℂ → ℂ)
    (p : ℂ × ℂ) : ℂ :=
  U p + (U_star p.1 - U (p.1, (t₀ : ℂ)))

noncomputable def glancingAffineCand (t₀ : ℝ) (U : ℂ × ℂ → ℂ) (U_star z : ℂ → ℂ)
    (p : ℂ × ℂ) : ℂ :=
  U p + (U_star p.1 - U (p.1, (t₀ : ℂ))) +
    (p.2 - (t₀ : ℂ)) * (deriv U_star p.1 * z p.1)

noncomputable def glancingJetWitness (t₀ : ℝ) (U : ℂ × ℂ → ℂ) (U_star z : ℂ → ℂ)
    (p : ℂ × ℂ) : ℂ :=
  ((U_star p.1 - U (p.1, (t₀ : ℂ))) +
    (p.2 - (t₀ : ℂ)) * (deriv U_star p.1 * z p.1)) /
    deriv (fun y' : ℂ => U (y', p.2)) p.1

def PrelimCyclicJetSolveProp {Ω : Set Plane} (B : AnalyticBoundaryData Ω)
    (S : GlancingScalePackage B) : Prop :=
  CyclicJetAndDiffOpProp →
  ∃ C_z : ℝ, 1 ≤ C_z ∧
    ∀ (s d δ ε η_slice : ℝ) (N l q : ℕ) (U : ℂ × ℂ → ℂ) (U_star : ℂ → ℂ),
      0 < s → s ≤ S.s_act → 0 < d → d ≤ S.d_act → d < s / 2 →
      0 < δ → δ < d / 100 → 0 < ε → ε < 1 →
      0 ≤ η_slice → η_slice ≤ S.η_adm / 8 → 1 ≤ N →
      IsAdmissibleGlancingCand s d (3 * S.η_adm / 4) U →
      (∀ p ∈ glancingDomain 1 s d, ‖glancingResidualOp B U p‖ ≤ ε) →
      1 ≤ l → 2 ≤ q → q ≤ N →
      let t₀ : ℝ := (2 * Real.pi * (l : ℝ)) / (q : ℝ)
      t₀ < d - 2 * δ →
      ExactRationalSliceAt B s δ η_slice l q U U_star →
      let Q := 1 + (N : ℝ) + δ⁻¹
      let η_tot := ε + η_slice
      ∃ z : ℂ → ℂ,
        DifferentiableOn ℂ z (horizStrip (s - 6 * δ)) ∧
        (∀ y ∈ horizStrip (s - 6 * δ), z (y + 2 * Real.pi) = z y) ∧
        (∀ y ∈ horizStrip (s - 6 * δ), ‖z y‖ ≤ C_z * Q ^ 5 * η_tot) ∧
        (∀ y ∈ horizStrip (s - 6 * δ),
          glancingDiffOp
            (fun p =>
              glancingLinCoeff B (fun r => U_star r.1) (p.1, (t₀ : ℂ)) *
                (glancingDiffOp
                  (fun r =>
                    deriv (fun t : ℂ => U (r.1, t)) (t₀ : ℂ) / deriv U_star r.1 + z r.1)
                  (p.1, (t₀ : ℂ)) + ((t₀ : ℂ))⁻¹))
            (y, (t₀ : ℂ)) = 0)

def AffineJetRegularityProp {Ω : Set Plane} (B : AnalyticBoundaryData Ω)
    (S : GlancingScalePackage B) : Prop :=
  CyclicJetAndDiffOpProp →
  ∀ (s d δ η_slice M_z t₀ : ℝ) (l q : ℕ) (U : ℂ × ℂ → ℂ) (U_star z : ℂ → ℂ),
    0 < s → s ≤ S.s_act → 0 < d → d ≤ S.d_act → d < s / 2 →
    0 < δ → δ < d / 100 → 0 ≤ η_slice → 0 ≤ M_z →
    IsAdmissibleGlancingCand s d (3 * S.η_adm / 4) U →
    0 < t₀ → t₀ < d - 2 * δ →
    t₀ = (2 * Real.pi * (l : ℝ)) / (q : ℝ) →
    ExactRationalSliceAt B s δ η_slice l q U U_star →
    DifferentiableOn ℂ z (horizStrip (s - 6 * δ)) →
    (∀ y ∈ horizStrip (s - 6 * δ), z (y + 2 * Real.pi) = z y ∧ ‖z y‖ ≤ M_z) →
    let Q₀ := 1 + δ⁻¹
    let ρ_jet := η_slice + 10 * Q₀ ^ 2 * M_z
    let U_tilde := glancingAffineCand t₀ U U_star z
    let W_plus := glancingJetWitness t₀ U U_star z
    let g_plus : ℂ × ℂ → ℂ := fun p => glancingLinCoeff B U p * glancingDiffOp W_plus p
    let H_plus : ℂ × ℂ → ℂ := fun p => glancingResidualOp B U p + glancingDiffOp g_plus p
    ρ_jet ≤ S.η_adm / 8 →
    DifferentiableOn ℂ U_tilde
      (horizStrip (s - 7 * δ) ×ˢ Metric.ball (t₀ : ℂ) (δ / 4)) ∧
    DifferentiableOn ℂ W_plus
      (horizStrip (s - 7 * δ) ×ˢ Metric.ball (t₀ : ℂ) (δ / 4)) ∧
    (∀ k : ℕ, k ≤ 2 → ∀ w ∈ horizStrip (s - 7 * δ), ∀ t ∈ Metric.ball (t₀ : ℂ) (δ / 4),
      ‖iteratedDeriv k (fun y' : ℂ => U_tilde (y', t) - U (y', t)) w‖ ≤ ρ_jet ∧
      ‖iteratedDeriv k (fun y' : ℂ => U_tilde (y', t) - y') w‖ ≤ 7 * S.η_adm / 8) ∧
    (∀ w ∈ horizStrip (s - 7 * δ), ∀ t ∈ Metric.ball (t₀ : ℂ) (δ / 4),
      ‖W_plus (w, t)‖ ≤ (4 / 3 : ℝ) * ρ_jet) ∧
    DifferentiableOn ℂ W_plus
      (horizStrip (s - 8 * δ) ×ˢ Metric.ball (t₀ : ℂ) (δ / 8)) ∧
    (∀ y ∈ horizStrip (s - 8 * δ), ∀ t ∈ Metric.ball (t₀ : ℂ) (δ / 8),
      W_plus (y + 2 * Real.pi, t) = W_plus (y, t)) ∧
    DifferentiableOn ℂ g_plus
      (horizStrip (s - 9 * δ) ×ˢ Metric.ball (t₀ : ℂ) (δ / 8)) ∧
    (∀ y ∈ horizStrip (s - 9 * δ), ∀ t ∈ Metric.ball (t₀ : ℂ) (δ / 8),
      g_plus (y + 2 * Real.pi, t) = g_plus (y, t) ∧
      ‖g_plus (y, t)‖ ≤ 6 * Q₀ * ρ_jet ∧
      ‖glancingDiffOp W_plus (y, t)‖ ≤ 6 * Q₀ * ρ_jet) ∧
    DifferentiableOn ℂ H_plus
      (horizStrip (s - 9 * δ) ×ˢ Metric.ball (t₀ : ℂ) (δ / 4)) ∧
    DifferentiableOn ℂ H_plus
      (horizStrip (s - 10 * δ) ×ˢ Metric.ball (t₀ : ℂ) (δ / 8)) ∧
    DifferentiableOn ℂ
      (fun y : ℂ => deriv (fun t : ℂ => H_plus (y, t)) (t₀ : ℂ))
      (horizStrip (s - 10 * δ))

def ExactJetQuadCompatProp {Ω : Set Plane} (B : AnalyticBoundaryData Ω)
    (S : GlancingScalePackage B) : Prop :=
  ∀ (s d δ ε η_slice ρ_jet t₀ : ℝ) (l q : ℕ) (U : ℂ × ℂ → ℂ) (U_star z : ℂ → ℂ),
    0 < s → s ≤ S.s_act → 0 < d → d ≤ S.d_act → d < s / 2 →
    0 < δ → δ < d / 100 → 0 < ε → 0 ≤ η_slice → 0 ≤ ρ_jet → ρ_jet ≤ S.η_adm / 8 →
    IsAdmissibleGlancingCand s d (3 * S.η_adm / 4) U →
    (∀ p ∈ glancingDomain 1 s d, ‖glancingResidualOp B U p‖ ≤ ε) →
    0 < t₀ → t₀ < d - 2 * δ →
    t₀ = (2 * Real.pi * (l : ℝ)) / (q : ℝ) →
    ExactRationalSliceAt B s δ η_slice l q U U_star →
    DifferentiableOn ℂ z (horizStrip (s - 6 * δ)) →
    (∀ y ∈ horizStrip (s - 6 * δ),
      glancingDiffOp
        (fun p =>
          glancingLinCoeff B (fun r => U_star r.1) (p.1, (t₀ : ℂ)) *
            (glancingDiffOp
              (fun r =>
                deriv (fun t : ℂ => U (r.1, t)) (t₀ : ℂ) / deriv U_star r.1 + z r.1)
              (p.1, (t₀ : ℂ)) + ((t₀ : ℂ))⁻¹))
        (y, (t₀ : ℂ)) = 0) →
    let U_tilde := glancingAffineCand t₀ U U_star z
    let W_plus := glancingJetWitness t₀ U U_star z
    let g_plus : ℂ × ℂ → ℂ := fun p => glancingLinCoeff B U p * glancingDiffOp W_plus p
    let H_plus : ℂ × ℂ → ℂ := fun p => glancingResidualOp B U p + glancingDiffOp g_plus p
    DifferentiableOn ℂ U_tilde
      (horizStrip (s - 7 * δ) ×ˢ Metric.ball (t₀ : ℂ) (δ / 4)) →
    DifferentiableOn ℂ W_plus
      (horizStrip (s - 7 * δ) ×ˢ Metric.ball (t₀ : ℂ) (δ / 4)) →
    (∀ k : ℕ, k ≤ 2 → ∀ w ∈ horizStrip (s - 7 * δ), ∀ t ∈ Metric.ball (t₀ : ℂ) (δ / 4),
      ‖iteratedDeriv k (fun y' : ℂ => U_tilde (y', t) - U (y', t)) w‖ ≤ ρ_jet ∧
      ‖iteratedDeriv k (fun y' : ℂ => U_tilde (y', t) - y') w‖ ≤ 7 * S.η_adm / 8) →
    (∀ w ∈ horizStrip (s - 7 * δ), ∀ t ∈ Metric.ball (t₀ : ℂ) (δ / 4),
      ‖W_plus (w, t)‖ ≤ (4 / 3 : ℝ) * ρ_jet) →
    DifferentiableOn ℂ H_plus
      (horizStrip (s - 9 * δ) ×ˢ Metric.ball (t₀ : ℂ) (δ / 4)) →
    let Q₀ := 1 + δ⁻¹
    let M_quad_raw := 8 * Q₀ * (3 * Q₀ * ε * ρ_jet + S.C_quad * ρ_jet ^ 2)
    ∀ y ∈ horizStrip (s - 10 * δ),
      ‖H_plus (y, (t₀ : ℂ))‖ ≤ M_quad_raw ∧
      ‖deriv (fun t : ℂ => H_plus (y, t)) (t₀ : ℂ)‖ ≤ M_quad_raw
def IsIsolatedGraphSlicedAt (y_c τ_c : ℂ) (ρ_y ρ_t : ℝ) (H : ℂ × ℂ → ℂ) (t₂ : ℝ) : Prop :=
  ({ y : ℂ | y ∈ Metric.closedBall y_c (3 * ρ_y / 4) ∧ H (y, (t₂ : ℂ)) = 0 }).Finite ∧
  ∀ y_star ∈ Metric.ball y_c (3 * ρ_y / 4),
    ∃ (r_u r_t : ℝ) (z : ℂ → ℂ),
      0 < r_u ∧ 0 < r_t ∧
      DifferentiableOn ℂ z (Metric.ball (t₂ : ℂ) r_t) ∧
      z (t₂ : ℂ) = y_star ∧
      ∀ u ∈ Metric.ball (0 : ℂ) r_u, ∀ t ∈ Metric.ball (t₂ : ℂ) r_t,
        (z t + u, t) ∈ Metric.ball y_c ρ_y ×ˢ Metric.ball τ_c ρ_t ∧
        (u ≠ 0 → H (z t + u, t) ≠ 0)

def SeparableRectRootContProp : Prop :=
  ∀ (a₁ a₂ b₁ b₂ : ℝ) (t_c : ℂ) (r_t : ℝ) (D : ℕ),
    a₁ < a₂ → b₁ < b₂ → 0 < r_t → 1 ≤ D →
    let R_w : Set ℂ := { w : ℂ | a₁ < w.re ∧ w.re < a₂ ∧ b₁ < w.im ∧ w.im < b₂ }
    let U : Set (ℂ × ℂ) := R_w ×ˢ Metric.ball t_c r_t
    ∀ (A : Fin (D + 1) → ℂ × ℂ → ℂ),
      (∀ d : Fin (D + 1), DifferentiableOn ℂ (A d) U) →
      (∀ q ∈ U,
        A (Fin.last D) q ≠ 0 ∧
        ∀ z : ℂ,
          ∑ d : Fin (D + 1), A d q * z ^ (d : ℕ) = 0 →
          ∑ d : Fin D, (((d : ℕ) + 1 : ℕ) : ℂ) * A d.succ q * z ^ (d : ℕ) ≠ 0) →
      ((∀ (V : Set (ℂ × ℂ)) (g₁ g₂ : ℂ × ℂ → ℂ) (q₀ : ℂ × ℂ),
          IsOpen V → IsPreconnected V → V ⊆ U → q₀ ∈ V →
          DifferentiableOn ℂ g₁ V → DifferentiableOn ℂ g₂ V →
          (∀ q ∈ V, ∑ d : Fin (D + 1), A d q * (g₁ q) ^ (d : ℕ) = 0) →
          (∀ q ∈ V, ∑ d : Fin (D + 1), A d q * (g₂ q) ^ (d : ℕ) = 0) →
          g₁ q₀ = g₂ q₀ →
          ∀ q ∈ V, g₁ q = g₂ q) ∧
        (∀ (a₁' a₂' b₁' b₂' : ℝ) (w₀ z₀ : ℂ),
          a₁ < a₁' → a₁' < a₂' → a₂' < a₂ →
          b₁ < b₁' → b₁' < b₂' → b₂' < b₂ →
          a₁' < w₀.re → w₀.re < a₂' → b₁' < w₀.im → w₀.im < b₂' →
          ∑ d : Fin (D + 1), A d (w₀, t_c) * z₀ ^ (d : ℕ) = 0 →
          let R_w' : Set ℂ := { w : ℂ | a₁' < w.re ∧ w.re < a₂' ∧ b₁' < w.im ∧ w.im < b₂' }
          ∃ (δ_t : ℝ) (Λ : ℂ × ℂ → ℂ),
            0 < δ_t ∧ δ_t ≤ r_t ∧
            DifferentiableOn ℂ Λ (R_w' ×ˢ Metric.ball t_c δ_t) ∧
            Λ (w₀, t_c) = z₀ ∧
            ∀ q ∈ R_w' ×ˢ Metric.ball t_c δ_t,
              ∑ d : Fin (D + 1), A d q * (Λ q) ^ (d : ℕ) = 0))

def DualLineTubePeriodicProp {Ω : Set Plane} {C : AnalyticGlancingCollar Ω}
    {hDet : EndpointDeterminationData C} (W : CollarWidthTubeData C hDet) : Prop :=
  ∀ (k : ℤ) (i : Fin 2) (p : ℂ × ℂ),
    p ∈ meroTubeENNR W.r_base W.h_L →
    let shift_k : ℂ × ℂ → ℂ × ℂ :=
      fun q => (q.1 + ((2 * Real.pi * (k : ℝ) : ℝ) : ℂ), q.2)
    shift_k p ∈ meroTubeENNR W.r_base W.h_L ∧
    ∀ q ∈ Metric.ball p (min ((W.L_mero i).rad p) ((W.L_mero i).rad (shift_k p))),
      (W.L_mero i).num (shift_k p) (shift_k q) * (W.L_mero i).den p q =
        (W.L_mero i).num p q * (W.L_mero i).den (shift_k p) (shift_k q)

def HasLoopBranchDefectAt {Ω : Set Plane} {C : AnalyticGlancingCollar Ω}
    {hDet : EndpointDeterminationData C} (W : CollarWidthTubeData C hDet)
    (t₂ H₂ x_star : ℝ) : Prop :=
  ∃ ρ₀ : ℝ, 0 < ρ₀ ∧ ρ₀ < W.s_base / 2 ∧
    ∀ ρ : ℝ, 0 < ρ → ρ < ρ₀ →
      ∃ (δ_w δ_loop : ℝ) (Λ_loop : Fin 2 → ℂ × ℂ → ℂ),
        0 < δ_w ∧ δ_w ≤ 1 / 8 ∧ 0 < δ_loop ∧
        Metric.ball (t₂ : ℂ) δ_loop ⊆ Metric.ball (0 : ℂ) W.r_base ∧
        let y_star : ℂ := (x_star : ℂ) + (H₂ : ℂ) * Complex.I
        let w_start : ℂ := (Real.log ρ : ℂ) - ((Real.pi / 2 : ℝ) : ℂ) * Complex.I
        let p₀ : ℂ × ℂ := (y_star - (ρ : ℂ) * Complex.I + (t₂ : ℂ), (t₂ : ℂ))
        let LoopStrip : Set (ℂ × ℂ) :=
          { w : ℂ | |w.re - Real.log ρ| < δ_w ∧
              w.im ∈ Set.Ioo (-Real.pi / 2 - 1 / 8) (3 * Real.pi / 2 + 1 / 8) } ×ˢ
            Metric.ball (t₂ : ℂ) δ_loop
        p₀ ∈ meroTubeENNR W.r_base W.h_L ∧
        (∀ ι : Fin 2, DifferentiableOn ℂ (Λ_loop ι) LoopStrip) ∧
        (∃ r_att : ℝ, 0 < r_att ∧
          ∀ w t : ℂ, ‖w - w_start‖ < r_att → ‖t - (t₂ : ℂ)‖ < r_att →
            (w, t) ∈ LoopStrip ∧
            ∀ ι : Fin 2,
              (y_star + Complex.exp w + t, t) ∈ Metric.ball p₀ ((W.L_mero ι).rad p₀) ∧
              (W.L_mero ι).num p₀ (y_star + Complex.exp w + t, t) =
                Λ_loop ι (w, t) * (W.L_mero ι).den p₀ (y_star + Complex.exp w + t, t)) ∧
        (∃ ι : Fin 2,
          ¬ ∀ᶠ p in nhds (w_start, (t₂ : ℂ)),
              Λ_loop ι (p.1 + 2 * Real.pi * Complex.I, p.2) = Λ_loop ι p)
def pointCoalescingTridiag (m : ℕ) : Matrix (Fin m) (Fin m) ℂ :=
  fun r s =>
    if r.1 = s.1 then 2
    else if s.1 = r.1 + 1 ∨ r.1 = s.1 + 1 then -1
    else 0

def pointCoalescingExtend {R : Type*} [Zero R] [One R] {k : ℕ}
    (u : Fin (k - 1) → R) (s : Fin (k + 1)) : R :=
  if hs0 : s.1 = 0 then 0
  else if hs : s.1 < k then u ⟨s.1 - 1, by omega⟩
  else 1

def pointCoalescingStep {R : Type*} [Ring R] {k : ℕ}
    (u : Fin (k - 1) → R) (i : Fin k) : R :=
  pointCoalescingExtend u i.succ - pointCoalescingExtend u i.castSucc

noncomputable def pointFormalEdgeLambda {k : ℕ} (r_a : ℂ) (f_p : Fin (k + 1) → ℂ)
    (z : Fin k → PowerSeries ℂ) (i : Fin k) : PowerSeries ℂ :=
  -PowerSeries.C (r_a ^ 2 / 8) * (z i) ^ 2 -
    PowerSeries.C (r_a * (f_p i.succ + f_p i.castSucc) / 2) * PowerSeries.X -
    PowerSeries.C ((f_p i.succ - f_p i.castSucc) ^ 2 / 2) * PowerSeries.X ^ 2 * ((z i)⁻¹) ^ 2

noncomputable def pointFormalDerivSeries {k : ℕ} (r_a : ℂ) (f_p : Fin (k + 1) → ℂ)
    (u : Fin (k - 1) → PowerSeries ℂ) : PowerSeries ℂ :=
  let z := pointCoalescingStep u
  ∑ i : Fin k,
    (-PowerSeries.C (r_a * (f_p i.succ + f_p i.castSucc) / 2) * z i +
      PowerSeries.C ((f_p i.succ - f_p i.castSucc) ^ 2) * PowerSeries.X * (z i)⁻¹)

structure PointCoalescingFormalData (k : ℕ) (r_a : ℂ) (f_p : Fin (k + 1) → ℂ) where
  tridiag_det_ne : (pointCoalescingTridiag (k - 1)).det ≠ 0
  u_ps : Fin (k - 1) → PowerSeries ℂ
  const_eq : ∀ r : Fin (k - 1),
    PowerSeries.constantCoeff (u_ps r) = ((r.1 + 1 : ℕ) : ℂ) / (k : ℂ)
  coeff_rec : ∀ (q : ℕ), 1 ≤ q → ∀ r : Fin (k - 1),
    let u_trunc : Fin (k - 1) → Polynomial ℂ := fun s =>
      ∑ m ∈ Finset.range q, Polynomial.C (PowerSeries.coeff m (u_ps s)) * Polynomial.X ^ m
    let z_trunc : Fin k → PowerSeries ℂ := fun i =>
      ((pointCoalescingStep u_trunc i : Polynomial ℂ) : PowerSeries ℂ)
    let i_L : Fin k := ⟨r.1, by have := r.2; omega⟩
    let i_R : Fin k := ⟨r.1 + 1, by have := r.2; omega⟩
    ((-(r_a ^ 2 / (4 * (k : ℂ)))) • pointCoalescingTridiag (k - 1)).mulVec
        (fun s => PowerSeries.coeff q (u_ps s)) r +
      PowerSeries.coeff q
        (pointFormalEdgeLambda r_a f_p z_trunc i_L -
          pointFormalEdgeLambda r_a f_p z_trunc i_R) = 0
  zero_of_higher_deriv_vanish :
    (∀ d : ℕ, 1 ≤ d → PowerSeries.coeff d (pointFormalDerivSeries r_a f_p u_ps) = 0) →
      ∀ r : Fin (k + 1), f_p r = 0

noncomputable def pointLimEdgeLambda {k : ℕ} (r_a : ℂ) (f_p : Fin (k + 1) → ℂ)
    (w : ℂ) (Z : Fin k → ℂ) (i : Fin k) : ℂ :=
  -(r_a ^ 2 / 8) * (Z i) ^ 2 -
    (r_a * (f_p i.succ + f_p i.castSucc) / 2) * w -
    ((f_p i.succ - f_p i.castSucc) ^ 2 / 2) * w ^ 2 * ((Z i) ^ 2)⁻¹

noncomputable def pointCoalescingTermII {k J : ℕ} (p : ℕ) (ℓ_base : Fin k → ℂ)
    (F : ℂ → ℂ) (g : Fin (k + 1) → Fin (J + 1) → ℂ → ℂ)
    (x_vec : Fin (k + 1) → ℂ) (ε : ℂ) : ℂ :=
  let F_pert : Fin (k + 1) → ℂ → ℂ :=
    fun m z => F z + ∑ q : Fin (J + 1), ε ^ (q : ℕ) * g m q z
  ∑ i : Fin k,
    ((F_pert i.succ (x_vec i.succ) - F_pert i.castSucc (x_vec i.castSucc)) /
        pointRelEdgeLen ℓ_base F_pert x_vec i) *
      ∑ q : Fin (J + 1),
        if p ≤ (q : ℕ) then
          ((q : ℕ) : ℂ) * ε ^ ((q : ℕ) - 1) *
            (g i.succ q (x_vec i.succ) - g i.castSucc q (x_vec i.castSucc))
        else 0
noncomputable def rl6_impactDotYY (X_loc : Fin 2 → ℂ × ℂ → ℂ) (q : ℂ × ℂ) : ℂ :=
  (iterDerivYT 1 0 (X_loc 0) q) ^ 2 + (iterDerivYT 1 0 (X_loc 1) q) ^ 2

noncomputable def rl6_impactDotTY (X_loc : Fin 2 → ℂ × ℂ → ℂ) (q : ℂ × ℂ) : ℂ :=
  iterDerivYT 0 1 (X_loc 0) q * iterDerivYT 1 0 (X_loc 0) q +
    iterDerivYT 0 1 (X_loc 1) q * iterDerivYT 1 0 (X_loc 1) q

noncomputable def rl6_impactDetYYY (X_loc : Fin 2 → ℂ × ℂ → ℂ) (q : ℂ × ℂ) : ℂ :=
  iterDerivYT 1 0 (X_loc 0) q * iterDerivYT 2 0 (X_loc 1) q -
    iterDerivYT 1 0 (X_loc 1) q * iterDerivYT 2 0 (X_loc 0) q

def rl6_IsLocalRegularImpactChart {Ω : Set Plane} {C : AnalyticGlancingCollar Ω}
    (M : MeromorphicCollarData C) (p : ℂ × ℂ) (r : ℝ)
    (X_loc : Fin 2 → ℂ × ℂ → ℂ) : Prop :=
  0 < r ∧
  Metric.ball p r ⊆ meroTubeENNR M.r_base M.h_X ∧
  (∀ i : Fin 2, DifferentiableOn ℂ (X_loc i) (Metric.ball p r)) ∧
  (∀ i : Fin 2, MeroAgreesHolo (M.X_mero i) (X_loc i) (Metric.ball p r)) ∧
  rl6_impactDotYY X_loc p ≠ 0 ∧
  rl6_impactDetYYY X_loc p ≠ 0

def rl6_regularLocusSet {Ω : Set Plane} {C : AnalyticGlancingCollar Ω}
    (M : MeromorphicCollarData C) : Set (ℂ × ℂ) :=
  { p ∈ meroTubeENNR M.r_base M.h_X |
    ∃ (r : ℝ) (X_loc : Fin 2 → ℂ × ℂ → ℂ),
      rl6_IsLocalRegularImpactChart M p r X_loc }

open Classical in
noncomputable def rl6_regularImpactMap {Ω : Set Plane} {C : AnalyticGlancingCollar Ω}
    (M : MeromorphicCollarData C) (i : Fin 2) (p : ℂ × ℂ) : ℂ :=
  if h : p ∈ rl6_regularLocusSet M then (Classical.choose h.2.choose_spec) i p else 0

noncomputable def rl6_sixthPowerFieldG6 {Ω : Set Plane} (C : AnalyticGlancingCollar Ω)
    (M : MeromorphicCollarData C) (p : ℂ × ℂ) : ℂ :=
  (rl6_impactDetYYY (rl6_regularImpactMap M) p) ^ 4 /
    ((C.c : ℂ) ^ 2 * (rl6_impactDotYY (rl6_regularImpactMap M) p) ^ 3)

noncomputable def rl6_sixthRootRatioR {Ω : Set Plane} {C : AnalyticGlancingCollar Ω}
    (M : MeromorphicCollarData C) (p : ℂ × ℂ) : ℂ :=
  rl6_impactDotTY (rl6_regularImpactMap M) p /
    rl6_impactDotYY (rl6_regularImpactMap M) p

structure rl6_Holo2DRegularToolkit : Prop where
  eqOn_of_preconnected_2D : ∀ {W : Set (ℂ × ℂ)} {f g : ℂ × ℂ → ℂ} {p₀ : ℂ × ℂ} {r₀ : ℝ},
    IsOpen W → IsPreconnected W → DifferentiableOn ℂ f W → DifferentiableOn ℂ g W →
    p₀ ∈ W → 0 < r₀ → Metric.ball p₀ r₀ ⊆ W →
    (∀ q ∈ Metric.ball p₀ r₀, f q = g q) → ∀ p ∈ W, f p = g p
  iterDerivYT_holo : ∀ {W : Set (ℂ × ℂ)} {f : ℂ × ℂ → ℂ},
    IsOpen W → DifferentiableOn ℂ f W →
    DifferentiableOn ℂ (iterDerivYT 1 0 f) W ∧
    DifferentiableOn ℂ (iterDerivYT 0 1 f) W ∧
    DifferentiableOn ℂ (iterDerivYT 2 0 f) W
  iterDerivYT_comm : ∀ {W : Set (ℂ × ℂ)} {f : ℂ × ℂ → ℂ},
    IsOpen W → DifferentiableOn ℂ f W →
    ∀ p ∈ W, iterDerivYT 0 1 (iterDerivYT 1 0 f) p = iterDerivYT 1 0 (iterDerivYT 0 1 f) p
  punctured_ball_chain : ∀ {p₀ a b : ℂ × ℂ} {r₀ : ℝ} {h : ℂ × ℂ → ℂ},
    0 < r₀ → DifferentiableOn ℂ h (Metric.ball p₀ r₀) →
    a ∈ Metric.ball p₀ r₀ → b ∈ Metric.ball p₀ r₀ →
    h a ≠ 0 → h b ≠ 0 →
    ∃ (M_len : ℕ) (c : Fin (M_len + 1) → ℂ × ℂ) (ε : ℝ),
      0 < ε ∧
      c 0 = a ∧
      c (Fin.last M_len) = b ∧
      (∀ k : Fin (M_len + 1), Metric.ball (c k) ε ⊆ { q ∈ Metric.ball p₀ r₀ | h q ≠ 0 }) ∧
      (∀ k : Fin M_len,
        (Metric.ball (c k.castSucc) ε ∩ Metric.ball (c k.succ) ε).Nonempty)
structure SixthRootChainSolution {Ω : Set Plane} (C : AnalyticGlancingCollar Ω)
    (M : MeromorphicCollarData C) (K : NonisotropicCurveData C M)
    (Reg : RegularCollarLocusData C M K)
    (N : ℕ) (c : Fin (N + 1) → ℂ × ℂ) (ρ : Fin (N + 1) → ℝ) where
  c_zero : c 0 = ((0 : ℂ), (0 : ℂ))
  ρ_zero : ρ 0 = Reg.r_origin
  balls_valid : ∀ k : Fin (N + 1), 0 < ρ k ∧ Metric.ball (c k) (ρ k) ⊆ Reg.U_reg
  overlaps_nonempty : ∀ k : Fin N,
    (Metric.ball (c k.castSucc) (ρ k.castSucc) ∩ Metric.ball (c k.succ) (ρ k.succ)).Nonempty
  𝔰 : Fin (N + 1) → ℂ × ℂ → ℂ
  𝔰_zero_eq : ∀ q ∈ Metric.ball (c 0) (ρ 0), 𝔰 0 q = K.𝔰_init q
  𝔰_holo : ∀ k : Fin (N + 1), DifferentiableOn ℂ (𝔰 k) (Metric.ball (c k) (ρ k))
  𝔰_ode : ∀ k : Fin (N + 1), ∀ q ∈ Metric.ball (c k) (ρ k),
    (iterDerivYT 1 0 (𝔰 k) q) ^ 6 = Reg.G_6 q ∧
    iterDerivYT 0 1 (𝔰 k) q = Reg.R_ratio q * iterDerivYT 1 0 (𝔰 k) q
  𝔰_overlap_eq : ∀ k : Fin N,
    ∀ q ∈ Metric.ball (c k.castSucc) (ρ k.castSucc) ∩ Metric.ball (c k.succ) (ρ k.succ),
      𝔰 k.castSucc q = 𝔰 k.succ q
structure IrrShiftSlabCover (x₀ θ₀ t₁ ρ : ℝ) where
  N_slab : ℕ
  N_slab_pos : 1 ≤ N_slab
  x_c : Fin N_slab → ℝ
  a_step : Fin N_slab → ℕ
  b_step : Fin N_slab → ℕ
  p_per : Fin N_slab → ℤ
  q_per : Fin N_slab → ℤ
  step_bounds : ∀ α : Fin N_slab, 1 ≤ a_step α ∧ 2 ≤ b_step α
  covers_period : ∀ x ∈ Set.Icc (0 : ℝ) (2 * Real.pi),
    ∃ α : Fin N_slab, |x - x_c α| < ρ
  back_approx : ∀ α : Fin N_slab,
    |(x_c α + θ₀ - (a_step α : ℝ) * t₁ - 2 * Real.pi * (p_per α : ℝ)) - x₀| < ρ
  fwd_approx : ∀ α : Fin N_slab,
    |(x_c α + θ₀ + (b_step α : ℝ) * t₁ - 2 * Real.pi * (q_per α : ℝ)) - x₀| < ρ

def bandUnshearedSlab (s_base H₁ ε x_c t₁ r₁ : ℝ) : Set (ℂ × ℂ) :=
  { p : ℂ × ℂ |
    |p.1.re - x_c| < ε / 16 ∧
    -s_base / 2 < p.1.im ∧ p.1.im < H₁ + 3 * ε / 16 ∧
    ‖p.2 - (t₁ : ℂ)‖ < r₁ }

def bandShearedSlab (s_base H₁ ε x_c s_minus t₁ r₁ : ℝ) : Set (ℂ × ℂ) :=
  { q : ℂ × ℂ | (q.1 - (s_minus : ℂ) * q.2, q.2) ∈ bandUnshearedSlab s_base H₁ ε x_c t₁ r₁ }

def bandShearedBaseBox (s_base x_c s_minus t₁ r₁ ε : ℝ) : Set (ℂ × ℂ) :=
  { q : ℂ × ℂ |
    |(q.1 - (s_minus : ℂ) * q.2).re - x_c| < ε / 16 ∧
    |(q.1 - (s_minus : ℂ) * q.2).im| < s_base / 2 ∧
    ‖q.2 - (t₁ : ℂ)‖ < r₁ }

noncomputable def bandBaseEndpointFn {Ω : Set Plane} (C : AnalyticGlancingCollar Ω)
    (is_point : Bool) (y t : ℂ) (i : Fin 2) : ℂ :=
  if is_point then glancingImpact C y t i else glancingDualLine C y t i

structure ShearedSlabEndpointPkg {Ω : Set Plane} {C : AnalyticGlancingCollar Ω}
    {hDet : EndpointDeterminationData C} (W : CollarWidthTubeData C hDet)
    (H₁ ε t₁ : ℝ) (is_point : Bool) where
  r₁ : ℝ
  r₁_pos : 0 < r₁
  ball_sub_base : Metric.ball (t₁ : ℂ) r₁ ⊆ Metric.ball (0 : ℂ) W.r_base
  h_L_lower : ∀ t ∈ Metric.ball (t₁ : ℂ) r₁, ENNReal.ofReal (H₁ - ε / 16) < W.h_L t
  N_slab : ℕ
  N_slab_pos : 1 ≤ N_slab
  x_c : Fin N_slab → ℝ
  k_span : Fin N_slab → ℕ
  j_idx : Fin N_slab → ℕ
  s_minus : Fin N_slab → ℝ
  idx_bounds : ∀ α : Fin N_slab,
    2 ≤ k_span α ∧ 0 < j_idx α ∧
    (if is_point then j_idx α ≤ k_span α else j_idx α < k_span α) ∧
    s_minus α + (if is_point then (j_idx α : ℝ) - 1 / 2 else (j_idx α : ℝ)) = 0
  shift_small : ∀ α : Fin N_slab,
    (|s_minus α| + (k_span α : ℝ)) * r₁ < W.s_base / 4
  covers_period : ∀ x ∈ Set.Icc (0 : ℝ) (2 * Real.pi),
    ∃ α : Fin N_slab, |x - x_c α| < ε / 16
  E_left : ∀ α : Fin N_slab, Fin 2 →
    MeroOn2D (bandShearedSlab W.s_base H₁ ε (x_c α) (s_minus α) t₁ r₁)
  E_right : ∀ α : Fin N_slab, Fin 2 →
    MeroOn2D (bandShearedSlab W.s_base H₁ ε (x_c α) (s_minus α) t₁ r₁)
  left_agrees_base : ∀ (α : Fin N_slab) (i : Fin 2),
    MeroAgreesHolo (E_left α i)
      (fun q => bandBaseEndpointFn C is_point q.1 q.2 i)
      (bandShearedBaseBox W.s_base (x_c α) (s_minus α) t₁ r₁ ε)
  right_agrees_base : ∀ (α : Fin N_slab) (i : Fin 2),
    MeroAgreesHolo (E_right α i)
      (fun q => bandBaseEndpointFn C is_point (q.1 + (k_span α : ℂ) * q.2) q.2 i)
      (bandShearedBaseBox W.s_base (x_c α) (s_minus α) t₁ r₁ ε)
noncomputable def rmdCompConst : ℕ → ℝ → ℝ
  | 0, _ => 1
  | k + 1, B => max 1 ((2 : ℝ) ^ k * B) * rmdCompConst k B

def rmdJetBnd (k : ℕ) (B : ℝ) (f : ℝ → ℝ) : Prop :=
  ContDiff ℝ (k : WithTop ℕ∞) f ∧
  0 ≤ B ∧
  ∀ j : ℕ, j ≤ k → ∀ x : ℝ, |iteratedDeriv j f x| ≤ B

def rmdDerivBnd (k : ℕ) (B : ℝ) (f : ℝ → ℝ) : Prop :=
  ContDiff ℝ (k : WithTop ℕ∞) f ∧
  0 ≤ B ∧
  ∀ j : ℕ, 1 ≤ j → j ≤ k → ∀ x : ℝ, |iteratedDeriv j f x| ≤ B

noncomputable def rmdK0 (w : ℝ → ℝ) (M₀ d : ℝ) : ℝ :=
  ∫ s in (0 : ℝ)..1, Real.exp (w (M₀ + s * d) - w M₀)

noncomputable def rmdKsym (w : ℝ → ℝ) (M₀ h : ℝ) : ℝ :=
  (1 / 2 : ℝ) * ∫ s in (0 : ℝ)..1, (1 - s) *
    (deriv w (M₀ + s * h) * Real.exp (w (M₀ + s * h) - w M₀) +
     deriv w (M₀ - s * h) * Real.exp (w (M₀ - s * h) - w M₀))

noncomputable def rmdK1 (w : ℝ → ℝ) (M₀ h : ℝ) : ℝ :=
  (1 / 2 : ℝ) * ∫ s in (0 : ℝ)..1,
    (deriv w (M₀ + s * h) * Real.exp (w (M₀ + s * h) - w M₀) +
     deriv w (M₀ - s * h) * Real.exp (w (M₀ - s * h) - w M₀))

noncomputable def rmdK2 (w : ℝ → ℝ) (M₀ h : ℝ) : ℝ :=
  (1 / 2 : ℝ) * ∫ s in (0 : ℝ)..1, (1 - s) *
    ((iteratedDeriv 2 w (M₀ + s * h) + (deriv w (M₀ + s * h)) ^ 2) *
       Real.exp (w (M₀ + s * h) - w M₀) +
     (iteratedDeriv 2 w (M₀ - s * h) + (deriv w (M₀ - s * h)) ^ 2) *
       Real.exp (w (M₀ - s * h) - w M₀))

noncomputable def rmdKlin (w : ℝ → ℝ) (M₀ d : ℝ) : ℝ :=
  -∫ s in (0 : ℝ)..1, deriv w (M₀ + s * d) * Real.exp (w M₀ - w (M₀ + s * d))

noncomputable def rmdOdeRhs (w : ℝ → ℝ) (M₀ h d M₀' h' : ℝ) : ℝ :=
  let Ed := Real.exp (w M₀ - w (M₀ + d))
  (h ^ 2 * (Ed * rmdK2 w M₀ h) + d * rmdKlin w M₀ d) * M₀' +
    (h * h') * (Ed * rmdK1 w M₀ h)

noncomputable def rmdSingleSeq (M₁ C₀ : ℝ) : ℕ → ℝ
  | 0 => C₀
  | r + 1 =>
      let C_r := rmdSingleSeq M₁ C₀ r
      let B_r := 3 + C_r / 16
      let K_c := rmdCompConst r B_r
      let M_E := Real.exp (2 * M₁) * rmdCompConst r (2 * M₁ * K_c)
      let M_K1 := (2 : ℝ) ^ r * (M₁ * K_c) * M_E
      let M_K2 := (2 : ℝ) ^ r * (M₁ * K_c + (2 : ℝ) ^ r * (M₁ * K_c) * (M₁ * K_c)) * M_E
      let M_EdK2 := (2 : ℝ) ^ r * M_E * M_K2
      let M_EdK1 := (2 : ℝ) ^ r * M_E * M_K1
      let C_step :=
        (2 : ℝ) ^ r *
          ((2 : ℝ) ^ r * (21 * (2 : ℝ) ^ r) * M_EdK2 + (2 : ℝ) ^ r * C_r * M_K1) * 2 +
        (2 : ℝ) ^ r * (2 : ℝ) ^ r * M_EdK1
      max C_r C_step

noncomputable def rmdLipSeq (M₁ C_single L₀ : ℝ) : ℕ → ℝ
  | 0 => L₀
  | r + 1 =>
      let L_r := rmdLipSeq M₁ C_single L₀ r
      let B_star := 3 + C_single / 16
      let K_c := rmdCompConst r B_star
      let M_E := Real.exp (2 * M₁) * rmdCompConst r (2 * M₁ * K_c)
      let M_K1 := (2 : ℝ) ^ r * (M₁ * K_c) * M_E
      let M_K2 := (2 : ℝ) ^ r * (M₁ * K_c + (2 : ℝ) ^ r * (M₁ * K_c) * (M₁ * K_c)) * M_E
      let M_EdK2 := (2 : ℝ) ^ r * M_E * M_K2
      let M_EdK1 := (2 : ℝ) ^ r * M_E * M_K1
      let M_P12 := (2 : ℝ) ^ r * (21 * (2 : ℝ) ^ r) * M_EdK2 + (2 : ℝ) ^ r * C_single * M_K1
      let κ_r := 1 + L_r / 16
      let D_w := (2 : ℝ) ^ r * M₁ * K_c * κ_r + K_c
      let D_E := (2 : ℝ) ^ r * Real.exp (2 * M₁) * rmdCompConst r (2 * M₁ * K_c) * (2 * D_w)
      let D_K1 := (2 : ℝ) ^ r * (D_w * M_E + (M₁ * K_c) * D_E)
      let D_w2 := D_w + (2 : ℝ) ^ r * (D_w * (M₁ * K_c) + (M₁ * K_c) * D_w)
      let D_K2 :=
        (2 : ℝ) ^ r * (D_w2 * M_E + (M₁ * K_c + (2 : ℝ) ^ r * (M₁ * K_c) * (M₁ * K_c)) * D_E)
      let D_EdK2 := (2 : ℝ) ^ r * (D_E * M_K2 + M_E * D_K2)
      let D_EdK1 := (2 : ℝ) ^ r * (D_E * M_K1 + M_E * D_K1)
      let D_P12 :=
        (2 : ℝ) ^ r * (5 * (2 : ℝ) ^ r * M_EdK2 + 21 * (2 : ℝ) ^ r * D_EdK2) +
        (2 : ℝ) ^ r * (L_r * M_K1 + C_single * D_K1)
      let L_step :=
        (2 : ℝ) ^ r * (D_P12 * 2 + M_P12 * 1) +
        (2 : ℝ) ^ r * (3 * (2 : ℝ) ^ r * M_EdK1 + (2 : ℝ) ^ r * D_EdK1)
      max L_r L_step
def slabBoxWide (x_edge R_0 y_row δ_slab δ_t : ℝ) : Set (ℂ × ℂ) :=
  { p : ℂ × ℂ |
    |p.1.re - x_edge| < R_0 / 2 + 4 * δ_slab ∧
    |p.1.im - y_row| < 4 * δ_slab ∧
    ‖p.2‖ < 4 * δ_t }

noncomputable def polyReflectVec (L : Fin 2 → ℂ) (N₀ N₁ : ℂ) : Fin 2 → ℂ :=
  let dotLN := L 0 * N₀ + L 1 * N₁
  let dotNN := N₀ ^ 2 + N₁ ^ 2
  ![2 * dotLN * N₀ - dotNN * L 0, 2 * dotLN * N₁ - dotNN * L 1]

structure RegularEdgeLazutkinChart {Ω : Set Plane} (C : AnalyticGlancingCollar Ω)
    {hDet : EndpointDeterminationData C} (W : CollarWidthTubeData C hDet)
    (H₀ : ℝ) (Z₀ : ZeroSliceExtractedData W) where
  x_edge : ℝ
  R_0 : ℝ
  H₀_ge : 2 * W.s_base ≤ H₀
  R_0_pos : 0 < R_0
  R_0_lt : R_0 < W.s_base / 2
  g_nf : Fin 2 → ℂ → ℂ
  ϕ_loc : ℂ → ℂ
  U_θ : Set ℂ
  ϕ_inv : ℂ → ℂ
  h_loc : ℂ → ℂ
  τ_proj : ℂ → ℂ
  U_τ : Set ℂ
  τ_inv : ℂ → ℂ
  g_nf_holo : ∀ i : Fin 2,
    DifferentiableOn ℂ (g_nf i)
      (Metric.ball ((x_edge : ℂ) + (H₀ : ℂ) * Complex.I) (2 * R_0))
  g_nf_eq_slice : ∀ i : Fin 2,
    ∀ z ∈ Metric.ball ((x_edge : ℂ) + (H₀ : ℂ) * Complex.I) (2 * R_0) ∩ horizStrip H₀,
      g_nf i z = Z₀.Γ_slice z i
  ϕ_loc_holo : DifferentiableOn ℂ ϕ_loc
    (Metric.ball ((x_edge : ℂ) + (H₀ : ℂ) * Complex.I) (2 * R_0))
  ϕ_deriv_ne_zero : ∀ z ∈ Metric.ball ((x_edge : ℂ) + (H₀ : ℂ) * Complex.I) (2 * R_0),
    deriv ϕ_loc z ≠ 0
  U_θ_open : IsOpen U_θ
  ϕ_maps_to : Set.MapsTo ϕ_loc
    (Metric.ball ((x_edge : ℂ) + (H₀ : ℂ) * Complex.I) (2 * R_0)) U_θ
  ϕ_open_image : ∀ r : ℝ, 0 < r → r ≤ 2 * R_0 →
    IsOpen (ϕ_loc '' Metric.ball ((x_edge : ℂ) + (H₀ : ℂ) * Complex.I) r)
  ϕ_inv_holo : DifferentiableOn ℂ ϕ_inv U_θ
  ϕ_left_inv : ∀ z ∈ Metric.ball ((x_edge : ℂ) + (H₀ : ℂ) * Complex.I) (2 * R_0),
    ϕ_inv (ϕ_loc z) = z
  ϕ_right_inv : ∀ θ ∈ U_θ,
    ϕ_inv θ ∈ Metric.ball ((x_edge : ℂ) + (H₀ : ℂ) * Complex.I) (2 * R_0) ∧
    ϕ_loc (ϕ_inv θ) = θ
  h_loc_holo : DifferentiableOn ℂ h_loc U_θ
  h_loc_ne_zero : ∀ θ ∈ U_θ, h_loc θ ≠ 0
  g_nf_support_eq : ∀ z ∈ Metric.ball ((x_edge : ℂ) + (H₀ : ℂ) * Complex.I) (2 * R_0),
    g_nf 0 z = h_loc (ϕ_loc z) * Complex.cos (ϕ_loc z) -
      deriv h_loc (ϕ_loc z) * Complex.sin (ϕ_loc z) ∧
    g_nf 1 z = h_loc (ϕ_loc z) * Complex.sin (ϕ_loc z) +
      deriv h_loc (ϕ_loc z) * Complex.cos (ϕ_loc z)
  g_nf_deriv_eq : ∀ z ∈ Metric.ball ((x_edge : ℂ) + (H₀ : ℂ) * Complex.I) (2 * R_0),
    deriv (g_nf 0) z = -(C.c : ℂ) * Complex.sin (ϕ_loc z) / (deriv ϕ_loc z) ^ 2 ∧
    deriv (g_nf 1) z = (C.c : ℂ) * Complex.cos (ϕ_loc z) / (deriv ϕ_loc z) ^ 2
  lazutkin_ode : ∀ z ∈ Metric.ball ((x_edge : ℂ) + (H₀ : ℂ) * Complex.I) (2 * R_0),
    (h_loc (ϕ_loc z) + deriv (deriv h_loc) (ϕ_loc z)) * (deriv ϕ_loc z) ^ 3 = (C.c : ℂ)
  τ_def : ∀ z : ℂ,
    τ_proj z =
      -g_nf 0 z * Complex.sin (ϕ_loc ((x_edge : ℂ) + (H₀ : ℂ) * Complex.I)) +
        g_nf 1 z * Complex.cos (ϕ_loc ((x_edge : ℂ) + (H₀ : ℂ) * Complex.I))
  τ_deriv_ne_zero : ∀ z ∈ Metric.ball ((x_edge : ℂ) + (H₀ : ℂ) * Complex.I) (2 * R_0),
    deriv τ_proj z ≠ 0
  U_τ_open : IsOpen U_τ
  τ_maps_to : Set.MapsTo τ_proj
    (Metric.ball ((x_edge : ℂ) + (H₀ : ℂ) * Complex.I) (2 * R_0)) U_τ
  τ_open_image : ∀ r : ℝ, 0 < r → r ≤ 2 * R_0 →
    IsOpen (τ_proj '' Metric.ball ((x_edge : ℂ) + (H₀ : ℂ) * Complex.I) r)
  τ_inv_holo : DifferentiableOn ℂ τ_inv U_τ
  τ_left_inv : ∀ z ∈ Metric.ball ((x_edge : ℂ) + (H₀ : ℂ) * Complex.I) (2 * R_0),
    τ_inv (τ_proj z) = z
  τ_right_inv : ∀ w ∈ U_τ,
    τ_inv w ∈ Metric.ball ((x_edge : ℂ) + (H₀ : ℂ) * Complex.I) (2 * R_0) ∧
    τ_proj (τ_inv w) = w

structure CubicStepSuccessorData (c : ℝ) (s_edge : ℂ) (R_0 : ℝ)
    (ϕ_loc h_loc : ℂ → ℂ) where
  δ_rec : ℝ
  C_rec : ℝ
  δ_rec_pos : 0 < δ_rec
  δ_rec_lt : δ_rec < R_0
  C_rec_pos : 0 < C_rec
  G_succ : ℂ × ℂ → ℂ
  L_line : Fin 2 → ℂ × ℂ → ℂ
  G_succ_holo : DifferentiableOn ℂ G_succ
    (Metric.ball s_edge R_0 ×ˢ Metric.ball (0 : ℂ) δ_rec)
  G_succ_cubic : ∀ V Δ : ℂ,
    V ∈ Metric.ball s_edge R_0 →
    Δ ∈ Metric.ball (0 : ℂ) δ_rec →
    ‖G_succ (V, Δ) - Δ‖ ≤ C_rec * ‖Δ‖ ^ 3
  L_line_holo : ∀ i : Fin 2, DifferentiableOn ℂ (L_line i)
    (Metric.ball s_edge R_0 ×ˢ Metric.ball (0 : ℂ) δ_rec)
  L_line_eq : ∀ V Δ : ℂ,
    V ∈ Metric.ball s_edge R_0 →
    Δ ∈ Metric.ball (0 : ℂ) δ_rec →
    L_line 0 (V, Δ) =
      Complex.cos (ϕ_loc V) / (-supportAction1_ℂ h_loc (ϕ_loc V) (ϕ_loc (V + Δ))) ∧
    L_line 1 (V, Δ) =
      Complex.sin (ϕ_loc V) / (-supportAction1_ℂ h_loc (ϕ_loc V) (ϕ_loc (V + Δ)))
  forward_step_unique : ∀ V Δ_m Δ_p : ℂ,
    V ∈ Metric.ball s_edge R_0 →
    Δ_m ∈ Metric.ball (0 : ℂ) δ_rec →
    Δ_p ∈ Metric.ball (0 : ℂ) δ_rec →
    (Δ_p + Δ_m ≠ 0 ∨ (Δ_m = 0 ∧ Δ_p = 0)) →
    -supportAction1_ℂ h_loc (ϕ_loc V) (ϕ_loc (V + Δ_p)) =
      supportAction2_ℂ h_loc (ϕ_loc (V - Δ_m)) (ϕ_loc V) →
    Δ_p = G_succ (V, Δ_m)

structure SlabBilliardHoloData {Ω : Set Plane} {C : AnalyticGlancingCollar Ω}
    {hDet : EndpointDeterminationData C} (W : CollarWidthTubeData C hDet)
    (Z₀ : ZeroSliceExtractedData W) (H₀ x_edge R_0 : ℝ) where
  y_row : ℝ
  δ_slab : ℝ
  δ_t0 : ℝ
  y_row_bounds : H₀ - R_0 / 16 < y_row ∧ y_row < H₀ - R_0 / 32
  δ_slab_pos : 0 < δ_slab
  δ_slab_lt_R : δ_slab < R_0 / 256
  δ_slab_lt_gap : y_row + 4 * δ_slab < H₀ - R_0 / 64
  δ_t0_pos : 0 < δ_t0
  L_slab : Fin 2 → ℂ × ℂ → ℂ
  X_slab : Fin 2 → ℂ × ℂ → ℂ
  L_slab_holo : ∀ i : Fin 2,
    DifferentiableOn ℂ (L_slab i) (slabBoxWide x_edge R_0 y_row δ_slab δ_t0)
  X_slab_holo : ∀ i : Fin 2,
    DifferentiableOn ℂ (X_slab i) (slabBoxWide x_edge R_0 y_row δ_slab δ_t0)
  L_slab_agrees : ∀ i : Fin 2,
    MeroAgreesHolo (W.L_mero i) (L_slab i) (slabBoxWide x_edge R_0 y_row δ_slab δ_t0)
  X_slab_zero : ∀ y : ℂ,
    (y, (0 : ℂ)) ∈ slabBoxWide x_edge R_0 y_row δ_slab δ_t0 →
    ∀ i : Fin 2, X_slab i (y, 0) = Z₀.Γ_slice y i
  L_slab_even : ∀ i : Fin 2, ∀ y t : ℂ,
    (y, t) ∈ slabBoxWide x_edge R_0 y_row δ_slab δ_t0 →
    L_slab i (y, -t) = L_slab i (y, t)
  slab_incidence : ∀ y t : ℂ,
    (y, t) ∈ slabBoxWide x_edge R_0 y_row δ_slab δ_t0 →
    (y - t / 2, t) ∈ slabBoxWide x_edge R_0 y_row δ_slab δ_t0 →
    (y + t / 2, t) ∈ slabBoxWide x_edge R_0 y_row δ_slab δ_t0 →
    (L_slab 0 (y - t / 2, t) * X_slab 0 (y, t) +
      L_slab 1 (y - t / 2, t) * X_slab 1 (y, t) = 1) ∧
    (L_slab 0 (y + t / 2, t) * X_slab 0 (y, t) +
      L_slab 1 (y + t / 2, t) * X_slab 1 (y, t) = 1)
  slab_rank_one : ∀ p ∈ slabBoxWide x_edge R_0 y_row δ_slab δ_t0,
    iterDerivYT 1 0 (X_slab 0) p * iterDerivYT 0 1 (X_slab 1) p =
      iterDerivYT 0 1 (X_slab 0) p * iterDerivYT 1 0 (X_slab 1) p
  slab_reflection : ∀ y t : ℂ,
    (y, t) ∈ slabBoxWide x_edge R_0 y_row δ_slab δ_t0 →
    (y - t / 2, t) ∈ slabBoxWide x_edge R_0 y_row δ_slab δ_t0 →
    (y + t / 2, t) ∈ slabBoxWide x_edge R_0 y_row δ_slab δ_t0 →
    ∀ i : Fin 2,
      let W_vec := polyReflectVec (fun j => L_slab j (y - t / 2, t))
        (iterDerivYT 1 0 (X_slab 1) (y, t)) (-iterDerivYT 1 0 (X_slab 0) (y, t))
      L_slab i (y + t / 2, t) * (W_vec 0 * X_slab 0 (y, t) + W_vec 1 * X_slab 1 (y, t)) =
        W_vec i
  L_mero_even : ∀ i : Fin 2, ∀ p ∈ meroTubeENNR W.r_base W.h_L,
    (p.1, -p.2) ∈ meroTubeENNR W.r_base W.h_L ∧
    ∀ q ∈ Metric.ball p (min ((W.L_mero i).rad p) ((W.L_mero i).rad (p.1, -p.2))),
      (W.L_mero i).num p q * (W.L_mero i).den (p.1, -p.2) (q.1, -q.2) =
        (W.L_mero i).num (p.1, -p.2) (q.1, -q.2) * (W.L_mero i).den p q

structure SlabAngleBridgeData {Ω : Set Plane} {C : AnalyticGlancingCollar Ω}
    {hDet : EndpointDeterminationData C} (W : CollarWidthTubeData C hDet)
    (H₀ : ℝ) (Z₀ : ZeroSliceExtractedData W)
    (E : RegularEdgeLazutkinChart C W H₀ Z₀)
    (S_rec : CubicStepSuccessorData C.c
      ((E.x_edge : ℂ) + (H₀ : ℂ) * Complex.I) E.R_0 E.ϕ_loc E.h_loc)
    (H_slab : SlabBilliardHoloData W Z₀ H₀ E.x_edge E.R_0) where
  δ_t : ℝ
  C_init : ℝ
  δ_t_pos : 0 < δ_t
  C_init_pos : 0 < C_init
  V_slab : ℂ × ℂ → ℂ
  V_slab_holo : DifferentiableOn ℂ V_slab
    (slabBox E.x_edge E.R_0 H_slab.y_row H_slab.δ_slab δ_t)
  V_slab_quad : ∀ p ∈ slabBox E.x_edge E.R_0 H_slab.y_row H_slab.δ_slab δ_t,
    ‖V_slab p - p.1‖ ≤ C_init * ‖p.2‖ ^ 2
  slab_recurrence : ∀ y t : ℂ,
    (y - t, t) ∈ slabBox E.x_edge E.R_0 H_slab.y_row H_slab.δ_slab δ_t →
    (y, t) ∈ slabBox E.x_edge E.R_0 H_slab.y_row H_slab.δ_slab δ_t →
    (y + t, t) ∈ slabBox E.x_edge E.R_0 H_slab.y_row H_slab.δ_slab δ_t →
    V_slab (y, t) ∈ Metric.ball ((E.x_edge : ℂ) + (H₀ : ℂ) * Complex.I) E.R_0 ∧
    ‖V_slab (y, t) - V_slab (y - t, t)‖ < S_rec.δ_rec ∧
    ‖V_slab (y + t, t) - V_slab (y, t)‖ < S_rec.δ_rec ∧
    V_slab (y + t, t) - V_slab (y, t) =
      S_rec.G_succ (V_slab (y, t), V_slab (y, t) - V_slab (y - t, t))
  slab_agrees_L : ∀ i : Fin 2,
    MeroAgreesHolo (W.L_mero i)
      (fun p => S_rec.L_line i (V_slab p, V_slab (p.1 + p.2, p.2) - V_slab p))
      { p : ℂ × ℂ |
        |p.1.re - E.x_edge| < E.R_0 / 2 + H_slab.δ_slab ∧
        |p.1.im - H_slab.y_row| < H_slab.δ_slab ∧
        ‖p.2‖ < δ_t }
noncomputable def dualLineShift {Ω : Set Plane} (C : AnalyticGlancingCollar Ω) (q : ℤ) :
    Fin 2 → ℂ × ℂ → ℂ :=
  fun ι p => glancingDualLine C (p.1 + (q : ℂ) * p.2) p.2 ι

noncomputable def homIntersect (E F : Fin 2 → ℂ × ℂ → ℂ) : Fin 3 → ℂ × ℂ → ℂ
  | 0, p => F 1 p - E 1 p
  | 1, p => E 0 p - F 0 p
  | 2, p => E 0 p * F 1 p - E 1 p * F 0 p

noncomputable def homRankOneDet (W : Fin 3 → ℂ × ℂ → ℂ) (p : ℂ × ℂ) : ℂ :=
  W 0 p * (iterDerivYT 1 0 (W 1) p * iterDerivYT 0 1 (W 2) p -
    iterDerivYT 0 1 (W 1) p * iterDerivYT 1 0 (W 2) p) -
  W 1 p * (iterDerivYT 1 0 (W 0) p * iterDerivYT 0 1 (W 2) p -
    iterDerivYT 0 1 (W 0) p * iterDerivYT 1 0 (W 2) p) +
  W 2 p * (iterDerivYT 1 0 (W 0) p * iterDerivYT 0 1 (W 1) p -
    iterDerivYT 0 1 (W 0) p * iterDerivYT 1 0 (W 1) p)

noncomputable def homReflectOut (E : Fin 2 → ℂ × ℂ → ℂ) (W : Fin 3 → ℂ × ℂ → ℂ) :
    Fin 2 → ℂ × ℂ → ℂ :=
  fun ι p =>
    let T₀ := W 2 p * iterDerivYT 1 0 (W 0) p - W 0 p * iterDerivYT 1 0 (W 2) p
    let T₁ := W 2 p * iterDerivYT 1 0 (W 1) p - W 1 p * iterDerivYT 1 0 (W 2) p
    let N₀ := T₁
    let N₁ := -T₀
    let dotLN := E 0 p * N₀ + E 1 p * N₁
    let dotNN := N₀ * N₀ + N₁ * N₁
    2 * dotLN * (if ι = 0 then N₀ else N₁) - dotNN * E ι p

noncomputable def homReflectRes (E F : Fin 2 → ℂ × ℂ → ℂ) : Fin 2 → ℂ × ℂ → ℂ :=
  fun ι p =>
    let W := homIntersect E F
    let V := homReflectOut E W
    W 2 p * V ι p - (V 0 p * W 0 p + V 1 p * W 1 p) * F ι p

def symCollarDom (s_b r_b : ℝ) {N_idx : ℕ} (q_idx : Fin N_idx → ℤ) : Set (ℂ × ℂ) :=
  let J_bound : ℝ := ((Finset.univ.sup fun a : Fin N_idx => (q_idx a).natAbs : ℕ) : ℝ) + 2
  { p : ℂ × ℂ | |p.1.im| < s_b / 2 ∧ ‖p.2‖ < r_b ∧ |p.2.im| < s_b / (2 * J_bound) }

structure BaseCollarBilliardData {Ω : Set Plane} (C : AnalyticGlancingCollar Ω)
    (hDet : EndpointDeterminationData C) where
  dualLine_even : ∀ y t : ℂ, |y.im| < 2 * hDet.s_det → ‖t‖ < 2 * hDet.r_det →
    ∀ ι : Fin 2, glancingDualLine C y (-t) ι = glancingDualLine C y t ι
  symJet_neg_t : ∀ {N_idx : ℕ} (q_idx : Fin N_idx → ℤ) (neg_idx : Fin N_idx → Fin N_idx)
      (M : ℕ) (p : ℂ × ℂ),
    (∀ a : Fin N_idx, q_idx (neg_idx a) = -q_idx a) →
    ‖p.2‖ < 2 * hDet.r_det →
    (∀ a : Fin N_idx,
      |(p.1 + (q_idx a : ℂ) * p.2).im| < 2 * hDet.s_det ∧
      |(p.1 - (q_idx a : ℂ) * p.2).im| < 2 * hDet.s_det) →
    ∀ v : SymJetVar N_idx M,
      symJetEnv C q_idx M (p.1, -p.2) v =
        (-1 : ℂ) ^ v.2.2.2.1 *
          symJetEnv C q_idx M p (neg_idx v.1, v.2.1, v.2.2.1, v.2.2.2)
  primary_rank_one : ∀ p : ℂ × ℂ, |p.1.im| < hDet.s_det → ‖p.2‖ < hDet.r_det →
    homRankOneDet (homIntersect (dualLineShift C 0) (dualLineShift C 1)) p = 0
  primary_reflect : ∀ p : ℂ × ℂ, |p.1.im| < hDet.s_det → ‖p.2‖ < hDet.r_det →
    ∀ ι : Fin 2, homReflectRes (dualLineShift C 0) (dualLineShift C 1) ι p = 0
  primary_w2_ne_zero : ∀ r : ℝ, 0 < r → r ≤ min (hDet.s_det / 2) (hDet.r_det / 2) →
    ∃ p : ℂ × ℂ, |p.1.im| < r ∧ ‖p.2‖ < r ∧ p.2.im = 0 ∧
      homIntersect (dualLineShift C 0) (dualLineShift C 1) 2 p ≠ 0
  primary_not_isotropic_line : ∀ (r : ℝ) (s_iso c_star : ℂ),
    0 < r → r ≤ min (hDet.s_det / 2) (hDet.r_det / 2) →
    (s_iso = 1 ∨ s_iso = -1) →
    ∃ p : ℂ × ℂ, |p.1.im| < r ∧ ‖p.2‖ < r ∧ p.2.im = 0 ∧
      homIntersect (dualLineShift C 0) (dualLineShift C 1) 0 p +
        s_iso * Complex.I * homIntersect (dualLineShift C 0) (dualLineShift C 1) 1 p -
        c_star * homIntersect (dualLineShift C 0) (dualLineShift C 1) 2 p ≠ 0
  primary_step_distinct : ∀ r : ℝ, 0 < r → r ≤ min (hDet.s_det / 2) (hDet.r_det / 2) →
    ∃ p : ℂ × ℂ, |p.1.im| < r ∧ ‖p.2‖ < r ∧ p.2.im = 0 ∧
      let W₁ := homIntersect (dualLineShift C 0) (dualLineShift C 1)
      let W₀ := homIntersect (dualLineShift C (-1)) (dualLineShift C 0)
      W₁ 0 p * W₀ 2 p - W₀ 0 p * W₁ 2 p ≠ 0 ∨
      W₁ 1 p * W₀ 2 p - W₀ 1 p * W₁ 2 p ≠ 0
  envelope_quad_factor : ∀ x₀ : ℝ,
    ∃ (r_s r_env : ℝ) (s_minus s_plus : ℂ × ℂ → ℂ) (Q_inc : ℂ → ℂ × ℂ → ℂ),
      0 < r_env ∧ r_env ≤ r_s ∧ r_s < min (hDet.s_det / 4) (hDet.r_det / 4) ∧
      DifferentiableOn ℂ s_minus (Metric.ball (x₀ : ℂ) r_env ×ˢ Metric.ball (0 : ℂ) r_env) ∧
      DifferentiableOn ℂ s_plus (Metric.ball (x₀ : ℂ) r_env ×ˢ Metric.ball (0 : ℂ) r_env) ∧
      (∀ p ∈ Metric.ball (x₀ : ℂ) r_env ×ˢ Metric.ball (0 : ℂ) r_env,
        s_minus p ∈ Metric.ball (x₀ : ℂ) r_s ∧
        s_plus p ∈ Metric.ball (x₀ : ℂ) r_s ∧
        glancingBoundaryCurve C (s_minus p) = glancingImpact C (p.1 - p.2 / 2) p.2 ∧
        glancingBoundaryCurve C (s_plus p) = glancingImpact C (p.1 + p.2 / 2) p.2) ∧
      (∀ s ∈ Metric.ball (x₀ : ℂ) r_s,
        ∀ p ∈ Metric.ball (x₀ : ℂ) r_env ×ˢ Metric.ball (0 : ℂ) r_env,
          Q_inc s p ≠ 0 ∧
          dualLineShift C 0 0 p * glancingBoundaryCurve C s 0 +
            dualLineShift C 0 1 p * glancingBoundaryCurve C s 1 - 1 =
            (s - s_minus p) * (s - s_plus p) * Q_inc s p) ∧
      (∀ (B : Set (ℂ × ℂ)) (F : Fin 2 → ℂ × ℂ → ℂ),
        IsOpen B → B ⊆ Metric.ball (x₀ : ℂ) r_env ×ˢ Metric.ball (0 : ℂ) r_env →
        (∀ ι : Fin 2, DifferentiableOn ℂ (F ι) B) →
        (∀ q ∈ B,
          let W := homIntersect (dualLineShift C 0) F
          W 2 q ≠ 0 ∧
          W 0 q = W 2 q * glancingImpact C (q.1 + q.2 / 2) q.2 0 ∧
          W 1 q = W 2 q * glancingImpact C (q.1 + q.2 / 2) q.2 1 ∧
          ∀ ι : Fin 2, homReflectRes (dualLineShift C 0) F ι q = 0) →
        ∀ q ∈ B, ∀ ι : Fin 2, F ι q = dualLineShift C 1 ι q)

structure PuncturedGlancingBridgeData {Ω : Set Plane} {C : AnalyticGlancingCollar Ω}
    {hDet : EndpointDeterminationData C} (W : CollarWidthTubeData C hDet)
    (t₂ : ℝ) (D_wall : AlignedWallDefectData W t₂)
    {N_idx : ℕ} (q_idx : Fin N_idx → ℤ) where
  y₀ : ℝ
  r_y : ℝ
  r_t : ℝ
  t_end : ℝ
  r_end : ℝ
  r_y_pos : 0 < r_y
  r_t_pos : 0 < r_t
  t_end_pos : 0 < t_end
  t_end_lt : t_end < 3 * r_t / 4
  r_end_pos : 0 < r_end
  bidisk_sub_dom :
    Metric.ball (y₀ : ℂ) r_y ×ˢ Metric.ball (0 : ℂ) r_t ⊆
      symCollarDom W.s_base W.r_base q_idx
  ball_end_sub :
    Metric.ball ((y₀ : ℂ), (t_end : ℂ)) r_end ⊆
      Metric.ball (y₀ : ℂ) (3 * r_y / 4) ×ˢ
        { t : ℂ | 0 < ‖t‖ ∧ ‖t‖ < 3 * r_t / 4 }
  D_det : Fin 2 → ℕ
  D_det_pos : ∀ ι : Fin 2, 1 ≤ D_det ι
  A_coeff : ∀ ι : Fin 2, Fin (D_det ι + 1) → ℂ × ℂ → ℂ
  m_t : ℕ
  H_tilde : ℂ × ℂ → ℂ
  coeff_holo : ∀ ι d,
    DifferentiableOn ℂ (A_coeff ι d)
      (Metric.ball (y₀ : ℂ) r_y ×ˢ Metric.ball (0 : ℂ) r_t)
  H_tilde_holo :
    DifferentiableOn ℂ H_tilde
      (Metric.ball (y₀ : ℂ) r_y ×ˢ Metric.ball (0 : ℂ) r_t)
  H_tilde_ne_zero : ∀ p ∈ Metric.ball (y₀ : ℂ) r_y ×ˢ Metric.ball (0 : ℂ) r_t,
    H_tilde p ≠ 0
  lead_dvd : ∀ ι : Fin 2, ∃ G_div : ℂ × ℂ → ℂ,
    DifferentiableOn ℂ G_div
      (Metric.ball (y₀ : ℂ) r_y ×ˢ Metric.ball (0 : ℂ) r_t) ∧
    ∀ p ∈ Metric.ball (y₀ : ℂ) r_y ×ˢ Metric.ball (0 : ℂ) r_t,
      p.2 ^ m_t * H_tilde p = A_coeff ι (Fin.last (D_det ι)) p * G_div p
  separable_punc : ∀ ι : Fin 2,
    ∀ p ∈ Metric.ball (y₀ : ℂ) r_y ×ˢ (Metric.ball (0 : ℂ) r_t \ {0}),
      A_coeff ι (Fin.last (D_det ι)) p ≠ 0 ∧
      ∀ z : ℂ,
        ∑ d : Fin (D_det ι + 1), A_coeff ι d p * z ^ (d : ℕ) = 0 →
        ∑ d : Fin (D_det ι),
          (((d : ℕ) + 1 : ℕ) : ℂ) * A_coeff ι d.succ p * z ^ (d : ℕ) ≠ 0
  M₁_end : Fin 2 → ℂ × ℂ → ℂ
  M₁_end_holo : ∀ ι : Fin 2,
    DifferentiableOn ℂ (M₁_end ι) (Metric.ball ((y₀ : ℂ), (t_end : ℂ)) r_end)
  M₁_end_solves : ∀ ι : Fin 2, ∀ p ∈ Metric.ball ((y₀ : ℂ), (t_end : ℂ)) r_end,
    ∑ d : Fin (D_det ι + 1), A_coeff ι d p * (M₁_end ι p) ^ (d : ℕ) = 0
  M₁_ne_primary : ∃ ι_def : Fin 2, ∃ p ∈ Metric.ball ((y₀ : ℂ), (t_end : ℂ)) r_end,
    M₁_end ι_def p ≠ dualLineShift C 1 ι_def p
  fwd_rank_one :
    (∀ p : ℂ × ℂ, |p.1.im| < hDet.s_det → ‖p.2‖ < hDet.r_det →
      homRankOneDet (homIntersect (dualLineShift C 0) (dualLineShift C 1)) p = 0) →
    ∀ p ∈ Metric.ball ((y₀ : ℂ), (t_end : ℂ)) r_end,
      homRankOneDet (homIntersect (dualLineShift C 0) M₁_end) p = 0
  fwd_reflect :
    (∀ p : ℂ × ℂ, |p.1.im| < hDet.s_det → ‖p.2‖ < hDet.r_det →
      ∀ ι : Fin 2, homReflectRes (dualLineShift C 0) (dualLineShift C 1) ι p = 0) →
    ∀ p ∈ Metric.ball ((y₀ : ℂ), (t_end : ℂ)) r_end,
      ∀ ι : Fin 2, homReflectRes (dualLineShift C 0) M₁_end ι p = 0
  rev_w2_zero :
    (∀ p ∈ Metric.ball ((y₀ : ℂ), (t_end : ℂ)) r_end,
      homIntersect (dualLineShift C 0) M₁_end 2 p = 0) →
    ∀ p ∈ symCollarDom W.s_base W.r_base q_idx,
      homIntersect (dualLineShift C 0) (dualLineShift C 1) 2 p = 0
  rev_iso_line : ∀ s_iso c_star : ℂ,
    (∀ p ∈ Metric.ball ((y₀ : ℂ), (t_end : ℂ)) r_end,
      homIntersect (dualLineShift C 0) M₁_end 0 p +
        s_iso * Complex.I * homIntersect (dualLineShift C 0) M₁_end 1 p -
        c_star * homIntersect (dualLineShift C 0) M₁_end 2 p = 0) →
    ∀ p ∈ symCollarDom W.s_base W.r_base q_idx,
      homIntersect (dualLineShift C 0) (dualLineShift C 1) 0 p +
        s_iso * Complex.I * homIntersect (dualLineShift C 0) (dualLineShift C 1) 1 p -
        c_star * homIntersect (dualLineShift C 0) (dualLineShift C 1) 2 p = 0
  rev_prev_eq :
    (∀ p ∈ Metric.ball ((y₀ : ℂ), (t_end : ℂ)) r_end,
      let W₁ := homIntersect (dualLineShift C 0) M₁_end
      let W₀ := homIntersect (dualLineShift C (-1)) (dualLineShift C 0)
      W₁ 0 p * W₀ 2 p - W₀ 0 p * W₁ 2 p = 0 ∧
      W₁ 1 p * W₀ 2 p - W₀ 1 p * W₁ 2 p = 0) →
    ∀ p ∈ symCollarDom W.s_base W.r_base q_idx,
      let W₁ := homIntersect (dualLineShift C 0) (dualLineShift C 1)
      let W₀ := homIntersect (dualLineShift C (-1)) (dualLineShift C 0)
      W₁ 0 p * W₀ 2 p - W₀ 0 p * W₁ 2 p = 0 ∧
      W₁ 1 p * W₀ 2 p - W₀ 1 p * W₁ 2 p = 0
  poly_transfer : ∀ (M D : ℕ) (ι_star : Fin 2)
      (P_coeff : Fin (D + 1) → MvPolynomial (SymJetVar N_idx M) ℂ),
    (∀ p ∈ symCollarDom W.s_base W.r_base q_idx,
      ∑ d : Fin (D + 1),
        MvPolynomial.eval (symJetEnv C q_idx M p) (P_coeff d) *
          (dualLineShift C 1 ι_star p) ^ (d : ℕ) = 0) ↔
    (∀ p ∈ Metric.ball ((y₀ : ℂ), (t_end : ℂ)) r_end,
      ∑ d : Fin (D + 1),
        MvPolynomial.eval (symJetEnv C q_idx M p) (P_coeff d) *
          (M₁_end ι_star p) ^ (d : ℕ) = 0)

structure CompactAnnulusEvenData {Ω : Set Plane} {C : AnalyticGlancingCollar Ω}
    {hDet : EndpointDeterminationData C} (W : CollarWidthTubeData C hDet)
    (t₂ : ℝ) (D_wall : AlignedWallDefectData W t₂)
    {N_idx : ℕ} (q_idx : Fin N_idx → ℤ)
    (Br : PuncturedGlancingBridgeData W t₂ D_wall q_idx) where
  y_ann : ℝ
  δ_y : ℝ
  t_near : ℝ
  r_match : ℝ
  δ_y_pos : 0 < δ_y
  t_near_pos : 0 < t_near
  r_match_pos : 0 < r_match
  ann_sub_dom :
    Metric.ball (y_ann : ℂ) δ_y ×ˢ
      { t : ℂ | t_near / 2 < ‖t‖ ∧ ‖t‖ < 3 * t_near / 2 } ⊆
      symCollarDom W.s_base W.r_base q_idx
  match_ball_sub :
    Metric.ball ((y_ann : ℂ), (t_near : ℂ)) r_match ⊆
      Metric.ball (y_ann : ℂ) δ_y ×ˢ
        { t : ℂ | t_near / 2 < ‖t‖ ∧ ‖t‖ < 3 * t_near / 2 }
  M_even : Fin 2 → ℂ × ℂ → ℂ
  M_even_holo : ∀ ι : Fin 2,
    DifferentiableOn ℂ (M_even ι)
      (Metric.ball (y_ann : ℂ) δ_y ×ˢ
        { t : ℂ | t_near / 2 < ‖t‖ ∧ ‖t‖ < 3 * t_near / 2 })
  M_even_symm : ∀ ι : Fin 2,
    ∀ p ∈ Metric.ball (y_ann : ℂ) δ_y ×ˢ
        { t : ℂ | t_near / 2 < ‖t‖ ∧ ‖t‖ < 3 * t_near / 2 },
      M_even ι (p.1, -p.2) = M_even ι p
  poly_transfer : ∀ (M D : ℕ) (ι_star : Fin 2)
      (P_coeff : Fin (D + 1) → MvPolynomial (SymJetVar N_idx M) ℂ),
    (∀ p ∈ Metric.ball ((Br.y₀ : ℂ), (Br.t_end : ℂ)) Br.r_end,
      ∑ d : Fin (D + 1),
        MvPolynomial.eval (symJetEnv C q_idx M p) (P_coeff d) *
          (Br.M₁_end ι_star p) ^ (d : ℕ) = 0) ↔
    (∀ p ∈ Metric.ball ((y_ann : ℂ), (t_near : ℂ)) r_match,
      ∑ d : Fin (D + 1),
        MvPolynomial.eval (symJetEnv C q_idx M p) (P_coeff d) *
          (M_even ι_star p) ^ (d : ℕ) = 0)
noncomputable def pointRotAngleR (rotIdx : Fin 4) : ℝ :=
  match rotIdx with
  | ⟨0, _⟩ => 0
  | ⟨1, _⟩ => Real.pi
  | ⟨2, _⟩ => -Real.pi / 2
  | ⟨3, _⟩ => Real.pi / 2

noncomputable def pointRotAngle (rotIdx : Fin 4) : ℂ :=
  (pointRotAngleR rotIdx : ℂ)

noncomputable def pointSupportCurve {Ω : Set Plane} (C : AnalyticGlancingCollar Ω)
    (θ : ℂ) : Fin 2 → ℂ :=
  ![C.h_ℂ θ * Complex.cos θ - deriv C.h_ℂ θ * Complex.sin θ,
    C.h_ℂ θ * Complex.sin θ + deriv C.h_ℂ θ * Complex.cos θ]

noncomputable def pointPhiMap {Ω : Set Plane} (C : AnalyticGlancingCollar Ω) (k : ℕ)
    (rotIdx : Fin 4) (p : ℂ × ℂ) : ℂ × ℂ :=
  (pointChartACoord C rotIdx p,
    pointChartBCoord C k rotIdx p - pointChartACoord C rotIdx p)

noncomputable def pointChartEll {Ω : Set Plane} (C : AnalyticGlancingCollar Ω) {k : ℕ}
    (Ψ : ℂ × ℂ → ℂ × ℂ) (i : Fin k) (q : ℂ × ℂ) : ℂ :=
  let y := (Ψ q).1
  let t := (Ψ q).2
  let P_curr := glancingImpact C (y + ((i : ℕ) : ℂ) * t) t
  let P_next := glancingImpact C (y + (((i : ℕ) + 1 : ℕ) : ℂ) * t) t
  let Θ_i := glancingTheta C (y + (((i : ℕ) : ℂ) + 1 / 2) * t) t
  (-(P_next 0 - P_curr 0)) * Complex.sin Θ_i + (P_next 1 - P_curr 1) * Complex.cos Θ_i

noncomputable def pointTridiagMat (m : ℕ) : Matrix (Fin m) (Fin m) ℂ :=
  fun r s =>
    if r.1 = s.1 then 2
    else if s.1 = r.1 + 1 then -1
    else if r.1 = s.1 + 1 then -1
    else 0

noncomputable def pointDivZero (F : ℂ × ℂ → ℂ) (q : ℂ × ℂ) : ℂ :=
  ∫ τ in (0 : ℝ)..1, iterDerivYT 0 1 F (q.1, (τ : ℂ) * q.2)

structure PointLocalGraphData {Ω : Set Plane} (C : AnalyticGlancingCollar Ω) where
  rotIdx : Fin 4
  a₀ : ℝ
  ρ_x : ℝ
  ρ_x_pos : 0 < ρ_x
  sin_rot_base_gt : 1 / 2 < -Real.sin (C.ϕ 0 + pointRotAngleR rotIdx)
  a₀_eq : (a₀ : ℂ) = rotCoordX rotIdx (pointSupportCurve C (C.ϕ 0 : ℂ))
  W_θ : Set ℂ
  W_θ_open : IsOpen W_θ
  θ₀_mem_W_θ : ((C.ϕ 0 : ℝ) : ℂ) ∈ W_θ
  W_θ_sub_strip : W_θ ⊆ horizStrip (2 * C.s_h)
  F : ℂ → ℂ
  θ_inv : ℂ → ℂ
  F_holo : DifferentiableOn ℂ F (Metric.ball (a₀ : ℂ) ρ_x)
  θ_inv_holo : DifferentiableOn ℂ θ_inv (Metric.ball (a₀ : ℂ) ρ_x)
  θ_inv_base : θ_inv (a₀ : ℂ) = ((C.ϕ 0 : ℝ) : ℂ)
  θ_inv_maps : ∀ z ∈ Metric.ball (a₀ : ℂ) ρ_x, θ_inv z ∈ W_θ
  θ_left_inv : ∀ θ ∈ W_θ,
    rotCoordX rotIdx (pointSupportCurve C θ) ∈ Metric.ball (a₀ : ℂ) ρ_x ∧
    θ_inv (rotCoordX rotIdx (pointSupportCurve C θ)) = θ ∧
    rotCoordY rotIdx (pointSupportCurve C θ) =
      F (rotCoordX rotIdx (pointSupportCurve C θ))
  θ_right_inv : ∀ z ∈ Metric.ball (a₀ : ℂ) ρ_x,
    rotCoordX rotIdx (pointSupportCurve C (θ_inv z)) = z ∧
    rotCoordY rotIdx (pointSupportCurve C (θ_inv z)) = F z
  W_θ_nondeg : ∀ θ ∈ W_θ,
    1 / 4 < (-Complex.sin (θ + pointRotAngle rotIdx)).re ∧
    C.h_ℂ θ + deriv (deriv C.h_ℂ) θ ≠ 0
  F_deriv_eq : ∀ z ∈ Metric.ball (a₀ : ℂ) ρ_x,
    deriv F z =
      Complex.cos (θ_inv z + pointRotAngle rotIdx) /
        (-Complex.sin (θ_inv z + pointRotAngle rotIdx))
  F_deriv2_eq : ∀ z ∈ Metric.ball (a₀ : ℂ) ρ_x,
    deriv (deriv F) z =
      1 / ((C.h_ℂ (θ_inv z) + deriv (deriv C.h_ℂ) (θ_inv z)) *
        (-Complex.sin (θ_inv z + pointRotAngle rotIdx)) ^ 3)
  F_real : ∀ x : ℝ, |x - a₀| < ρ_x →
    (x : ℂ) ∈ Metric.ball (a₀ : ℂ) ρ_x ∧
    (F (x : ℂ)).im = 0 ∧
    deriv (deriv F) (x : ℂ) ≠ 0 ∧
    ∃ v_x : ℝ, deriv F (x : ℂ) = (v_x : ℂ)

structure PointRawChartData {Ω : Set Plane} (C : AnalyticGlancingCollar Ω)
    (B : BaseCollarAndCramerData C) (k : ℕ) (G_gr : PointLocalGraphData C) where
  R₀ : ℝ
  δ₀ : ℝ
  R₀_pos : 0 < R₀
  δ₀_pos : 0 < δ₀
  two_R₀_le : 2 * R₀ ≤ G_gr.ρ_x
  V₀ : Set (ℂ × ℂ)
  Ψ : ℂ × ℂ → ℂ × ℂ
  V₀_open : IsOpen V₀
  V₀_sub : V₀ ⊆ pointChainBox C B k
  Φ_holo_V₀ : DifferentiableOn ℂ (pointPhiMap C k G_gr.rotIdx) V₀
  Ψ_holo : DifferentiableOn ℂ Ψ
    (Metric.ball (G_gr.a₀ : ℂ) (2 * R₀) ×ˢ Metric.ball (0 : ℂ) (2 * δ₀))
  Ψ_maps_V₀ :
    ∀ q ∈ Metric.ball (G_gr.a₀ : ℂ) (2 * R₀) ×ˢ Metric.ball (0 : ℂ) (2 * δ₀),
      Ψ q ∈ V₀
  Φ_left_inv :
    ∀ q ∈ Metric.ball (G_gr.a₀ : ℂ) (2 * R₀) ×ˢ Metric.ball (0 : ℂ) (2 * δ₀),
      pointPhiMap C k G_gr.rotIdx (Ψ q) = q
  Φ_right_inv : ∀ p ∈ V₀,
    pointPhiMap C k G_gr.rotIdx p ∈
      Metric.ball (G_gr.a₀ : ℂ) (2 * R₀) ×ˢ Metric.ball (0 : ℂ) (2 * δ₀) ∧
    Ψ (pointPhiMap C k G_gr.rotIdx p) = p
  det_ab_ne_zero : ∀ p ∈ V₀, pointChartDetAB C k G_gr.rotIdx p ≠ 0
  Ψ_det :
    ∀ q ∈ Metric.ball (G_gr.a₀ : ℂ) (2 * R₀) ×ˢ Metric.ball (0 : ℂ) (2 * δ₀),
      iterDerivYT 1 0 (fun q' => (Ψ q').1) q *
          iterDerivYT 0 1 (fun q' => (Ψ q').2) q -
        iterDerivYT 0 1 (fun q' => (Ψ q').1) q *
          iterDerivYT 1 0 (fun q' => (Ψ q').2) q =
        (pointChartDetAB C k G_gr.rotIdx (Ψ q))⁻¹
  x_holo_maps : ∀ r : Fin (k + 1),
    DifferentiableOn ℂ (pointChartX C k G_gr.rotIdx Ψ r)
      (Metric.ball (G_gr.a₀ : ℂ) (2 * R₀) ×ˢ Metric.ball (0 : ℂ) (2 * δ₀)) ∧
    ∀ q ∈ Metric.ball (G_gr.a₀ : ℂ) (2 * R₀) ×ˢ Metric.ball (0 : ℂ) (2 * δ₀),
      glancingMidAngle C ((Ψ q).1 + ((r : ℕ) : ℂ) * (Ψ q).2) (Ψ q).2 ∈ G_gr.W_θ ∧
      pointChartX C k G_gr.rotIdx Ψ r q ∈ Metric.ball (G_gr.a₀ : ℂ) G_gr.ρ_x ∧
      G_gr.θ_inv (pointChartX C k G_gr.rotIdx Ψ r q) =
        glancingMidAngle C ((Ψ q).1 + ((r : ℕ) : ℂ) * (Ψ q).2) (Ψ q).2 ∧
      rotCoordY G_gr.rotIdx
        (glancingImpact C ((Ψ q).1 + ((r : ℕ) : ℂ) * (Ψ q).2) (Ψ q).2) =
        G_gr.F (pointChartX C k G_gr.rotIdx Ψ r q)
  Θ_edge_holo_maps : ∀ i : Fin k,
    DifferentiableOn ℂ
      (fun q => glancingTheta C ((Ψ q).1 + (((i : ℕ) : ℂ) + 1 / 2) * (Ψ q).2) (Ψ q).2)
      (Metric.ball (G_gr.a₀ : ℂ) (2 * R₀) ×ˢ Metric.ball (0 : ℂ) (2 * δ₀)) ∧
    ∀ q ∈ Metric.ball (G_gr.a₀ : ℂ) (2 * R₀) ×ˢ Metric.ball (0 : ℂ) (2 * δ₀),
      glancingTheta C ((Ψ q).1 + (((i : ℕ) : ℂ) + 1 / 2) * (Ψ q).2) (Ψ q).2 ∈ G_gr.W_θ
  ℓ_holo_vec : ∀ i : Fin k,
    DifferentiableOn ℂ (pointChartEll C Ψ i)
      (Metric.ball (G_gr.a₀ : ℂ) (2 * R₀) ×ˢ Metric.ball (0 : ℂ) (2 * δ₀)) ∧
    ∀ q ∈ Metric.ball (G_gr.a₀ : ℂ) (2 * R₀) ×ˢ Metric.ball (0 : ℂ) (2 * δ₀),
      (pointChartEll C Ψ i q) ^ 2 =
        pointEdgeSq (fun _ => G_gr.F) (fun r => pointChartX C k G_gr.rotIdx Ψ r q) i ∧
      pointChartX C k G_gr.rotIdx Ψ i.succ q -
          pointChartX C k G_gr.rotIdx Ψ i.castSucc q =
        pointChartEll C Ψ i q *
          (-Complex.sin
            (glancingTheta C ((Ψ q).1 + (((i : ℕ) : ℂ) + 1 / 2) * (Ψ q).2) (Ψ q).2 +
              pointRotAngle G_gr.rotIdx)) ∧
      G_gr.F (pointChartX C k G_gr.rotIdx Ψ i.succ q) -
          G_gr.F (pointChartX C k G_gr.rotIdx Ψ i.castSucc q) =
        pointChartEll C Ψ i q *
          Complex.cos
            (glancingTheta C ((Ψ q).1 + (((i : ℕ) : ℂ) + 1 / 2) * (Ψ q).2) (Ψ q).2 +
              pointRotAngle G_gr.rotIdx)
  real_slice : ∀ a δ : ℝ,
    ((a : ℂ), (δ : ℂ)) ∈
      Metric.ball (G_gr.a₀ : ℂ) (2 * R₀) ×ˢ Metric.ball (0 : ℂ) (2 * δ₀) →
    (Ψ ((a : ℂ), (δ : ℂ))).1.im = 0 ∧
    (Ψ ((a : ℂ), (δ : ℂ))).2.im = 0 ∧
    (∀ r : Fin (k + 1), (pointChartX C k G_gr.rotIdx Ψ r ((a : ℂ), (δ : ℂ))).im = 0) ∧
    (∀ i : Fin k, (pointChartEll C Ψ i ((a : ℂ), (δ : ℂ))).im = 0)
  zero_slice : ∀ z ∈ Metric.ball (G_gr.a₀ : ℂ) (2 * R₀),
    (Ψ (z, 0)).2 = 0 ∧
    (∀ r : Fin (k + 1), pointChartX C k G_gr.rotIdx Ψ r (z, 0) = z) ∧
    (∀ r : Fin (k + 1),
      glancingMidAngle C ((Ψ (z, 0)).1 + ((r : ℕ) : ℂ) * (Ψ (z, 0)).2) (Ψ (z, 0)).2 =
        G_gr.θ_inv z) ∧
    (∀ i : Fin k,
      glancingTheta C ((Ψ (z, 0)).1 + (((i : ℕ) : ℂ) + 1 / 2) * (Ψ (z, 0)).2)
        (Ψ (z, 0)).2 = G_gr.θ_inv z) ∧
    (∀ i : Fin k, pointChartEll C Ψ i (z, 0) = 0)
  x_deriv_d_zero : ∀ r : Fin (k + 1), ∀ z ∈ Metric.ball (G_gr.a₀ : ℂ) (2 * R₀),
    deriv (fun w : ℂ => pointChartX C k G_gr.rotIdx Ψ r (z, w)) 0 =
      ((r : ℕ) : ℂ) / (k : ℂ)
  base_derivs_at_a₀ :
    let r₀ : ℝ := C.h (C.ϕ 0) + deriv (deriv C.h) (C.ϕ 0)
    let s₀ : ℝ := -Real.sin (C.ϕ 0 + pointRotAngleR G_gr.rotIdx)
    Ψ ((G_gr.a₀ : ℂ), 0) = (0, 0) ∧
    deriv (fun w : ℂ => (Ψ ((G_gr.a₀ : ℂ), w)).2) 0 =
      1 / ((k : ℂ) * ((r₀ * s₀ * deriv C.ϕ 0 : ℝ) : ℂ)) ∧
    ∀ i : Fin k,
      deriv (fun w : ℂ =>
        glancingTheta C
          ((Ψ ((G_gr.a₀ : ℂ), w)).1 + (((i : ℕ) : ℂ) + 1 / 2) * (Ψ ((G_gr.a₀ : ℂ), w)).2)
          (Ψ ((G_gr.a₀ : ℂ), w)).2) 0 =
        (((i : ℕ) : ℂ) + 1 / 2) / ((k : ℂ) * ((r₀ * s₀ : ℝ) : ℂ))
noncomputable def lineRecPsExpScale (c : ℂ) : PowerSeries ℂ :=
  PowerSeries.mk (fun n => c ^ n / (n.factorial : ℂ))

noncomputable def lineRecPsExp1D (c : ℂ) (θ : PowerSeries ℂ) : PowerSeries ℂ :=
  MvPowerSeries.coeff 0 (lineArcCompConst2D1D (lineRecPsExpScale c) (MvPowerSeries.C θ))

noncomputable def lineRecPsCos (θ : PowerSeries ℂ) : PowerSeries ℂ :=
  MvPowerSeries.coeff 0 (lineArcCompConst2D1D lineArcPsCos0 (MvPowerSeries.C θ))

noncomputable def lineRecPsSin (θ : PowerSeries ℂ) : PowerSeries ℂ :=
  MvPowerSeries.coeff 0 (lineArcCompConst2D1D lineArcPsSin0 (MvPowerSeries.C θ))

noncomputable def lineRecCircleAngle (c₀ s₀ : ℂ) (C S : PowerSeries ℂ) : PowerSeries ℂ :=
  let u := PowerSeries.C c₀ * C + PowerSeries.C s₀ * S
  let v := PowerSeries.C c₀ * S - PowerSeries.C s₀ * C
  PowerSeries.mk (fun n =>
    match n with
    | 0 => 0
    | m + 1 =>
        PowerSeries.coeff m (u * PowerSeries.derivative v - v * PowerSeries.derivative u) /
          ((m + 1 : ℕ) : ℂ))

def lineRecVanishesBelow (k : ℕ) (S : MvPowerSeries (Fin 2) (PowerSeries ℂ)) : Prop :=
  ∀ (d : Fin 2 →₀ ℕ) (m : ℕ), d 0 + d 1 + m < k →
    PowerSeries.coeff m (MvPowerSeries.coeff d S) = 0

open Classical in
noncomputable def lineRecLiftArcFn (F : Subfield ℂ) (Φ : ↥F →+* PowerSeries ℂ) (z : ℂ) :
    PowerSeries ℂ :=
  if hz : z ∈ F then Φ ⟨z, hz⟩ else PowerSeries.C z

noncomputable def lineRecLiftMv2D (F : Subfield ℂ) (Φ : ↥F →+* PowerSeries ℂ)
    (Ψ : MvPowerSeries (Fin 2) ℂ) : MvPowerSeries (Fin 2) (PowerSeries ℂ) :=
  fun d => lineRecLiftArcFn F Φ (MvPowerSeries.coeff d Ψ)

noncomputable def lineRecJetSeq (A : ℕ → PowerSeries ℂ) (Δ : PowerSeries ℂ) (l : ℕ) :
    PowerSeries ℂ :=
  PowerSeries.mk (fun n =>
    PowerSeries.coeff l
      (∑ r ∈ Finset.range (l + 1),
        PowerSeries.C (1 / ((n.factorial : ℂ) * (r.factorial : ℂ))) * A (n + r) * (-Δ) ^ r))

noncomputable def lineRecIota0 :
    MvPowerSeries (Fin 2) ℂ →+* MvPowerSeries (Fin 2) (PowerSeries ℂ) :=
  MvPowerSeries.map PowerSeries.C

noncomputable def lineRecXeps (j : ℕ) : MvPowerSeries (Fin 2) (PowerSeries ℂ) :=
  MvPowerSeries.C (PowerSeries.X ^ j)

def lineRecEqMod (j : ℕ) (S₁ S₂ : MvPowerSeries (Fin 2) (PowerSeries ℂ)) : Prop :=
  ∀ l ≤ j, lineArcSlice2D1D l S₁ = lineArcSlice2D1D l S₂

def lineRecIsEpsConst (S : MvPowerSeries (Fin 2) (PowerSeries ℂ)) : Prop :=
  ∀ (d : Fin 2 →₀ ℕ) (m : ℕ), 1 ≤ m → PowerSeries.coeff m (MvPowerSeries.coeff d S) = 0

noncomputable def lineRecMid0 {k : ℕ}
    (β₀ : Fin (k + 1) → MvPowerSeries (Fin 2) ℂ) (i : Fin k) : MvPowerSeries (Fin 2) ℂ :=
  (β₀ i.castSucc + β₀ i.succ) * MvPowerSeries.C (1 / 2 : ℂ)

noncomputable def lineRecHalfStep0 {k : ℕ}
    (β₀ : Fin (k + 1) → MvPowerSeries (Fin 2) ℂ) (i : Fin k) : MvPowerSeries (Fin 2) ℂ :=
  (β₀ i.succ - β₀ i.castSucc) * MvPowerSeries.C (1 / 2 : ℂ)

noncomputable def lineRecSin0 {k : ℕ} (sin_d0 cos_d0 : Fin k → ℂ)
    (β₀ : Fin (k + 1) → MvPowerSeries (Fin 2) ℂ) (i : Fin k) : MvPowerSeries (Fin 2) ℂ :=
  MvPowerSeries.C (sin_d0 i) * compPowerSeries2D lineArcPsCos0 (lineRecHalfStep0 β₀ i) +
    MvPowerSeries.C (cos_d0 i) * compPowerSeries2D lineArcPsSin0 (lineRecHalfStep0 β₀ i)

noncomputable def lineRecCos0 {k : ℕ} (sin_d0 cos_d0 : Fin k → ℂ)
    (β₀ : Fin (k + 1) → MvPowerSeries (Fin 2) ℂ) (i : Fin k) : MvPowerSeries (Fin 2) ℂ :=
  MvPowerSeries.C (cos_d0 i) * compPowerSeries2D lineArcPsCos0 (lineRecHalfStep0 β₀ i) -
    MvPowerSeries.C (sin_d0 i) * compPowerSeries2D lineArcPsSin0 (lineRecHalfStep0 β₀ i)

noncomputable def lineRecGrad0 {k : ℕ} (sin_d0 cos_d0 : Fin k → ℂ)
    (f₀ : Fin k → PowerSeries ℂ) (β₀ : Fin (k + 1) → MvPowerSeries (Fin 2) ℂ)
    (r : Fin (k - 1)) : MvPowerSeries (Fin 2) ℂ :=
  let i_L : Fin k := ⟨r.1, by have := r.2; omega⟩
  let i_R : Fin k := ⟨r.1 + 1, by have := r.2; omega⟩
  compPowerSeries2D (PowerSeries.derivative (f₀ i_L)) (lineRecMid0 β₀ i_L) *
      lineRecSin0 sin_d0 cos_d0 β₀ i_L +
    compPowerSeries2D (f₀ i_L) (lineRecMid0 β₀ i_L) *
      lineRecCos0 sin_d0 cos_d0 β₀ i_L +
    compPowerSeries2D (PowerSeries.derivative (f₀ i_R)) (lineRecMid0 β₀ i_R) *
      lineRecSin0 sin_d0 cos_d0 β₀ i_R -
    compPowerSeries2D (f₀ i_R) (lineRecMid0 β₀ i_R) *
      lineRecCos0 sin_d0 cos_d0 β₀ i_R

noncomputable def lineRecHess0 {k : ℕ} (sin_d0 cos_d0 : Fin k → ℂ)
    (f₀ : Fin k → PowerSeries ℂ) (β₀ : Fin (k + 1) → MvPowerSeries (Fin 2) ℂ)
    (r s : Fin (k - 1)) : MvPowerSeries (Fin 2) ℂ :=
  let i_L : Fin k := ⟨r.1, by have := r.2; omega⟩
  let i_R : Fin k := ⟨r.1 + 1, by have := r.2; omega⟩
  let H_L := compPowerSeries2D (f₀ i_L) (lineRecMid0 β₀ i_L)
  let H'_L := compPowerSeries2D (PowerSeries.derivative (f₀ i_L)) (lineRecMid0 β₀ i_L)
  let H''_L := compPowerSeries2D (PowerSeries.derivative (PowerSeries.derivative (f₀ i_L)))
    (lineRecMid0 β₀ i_L)
  let H_R := compPowerSeries2D (f₀ i_R) (lineRecMid0 β₀ i_R)
  let H'_R := compPowerSeries2D (PowerSeries.derivative (f₀ i_R)) (lineRecMid0 β₀ i_R)
  let H''_R := compPowerSeries2D (PowerSeries.derivative (PowerSeries.derivative (f₀ i_R)))
    (lineRecMid0 β₀ i_R)
  let S_L := lineRecSin0 sin_d0 cos_d0 β₀ i_L
  let C_L := lineRecCos0 sin_d0 cos_d0 β₀ i_L
  let S_R := lineRecSin0 sin_d0 cos_d0 β₀ i_R
  let C_R := lineRecCos0 sin_d0 cos_d0 β₀ i_R
  if r.1 = s.1 then
    ((H''_L - H_L) * MvPowerSeries.C (1 / 2 : ℂ) * S_L + H'_L * C_L) +
      ((H''_R - H_R) * MvPowerSeries.C (1 / 2 : ℂ) * S_R - H'_R * C_R)
  else if s.1 = r.1 + 1 then
    (H_R + H''_R) * MvPowerSeries.C (1 / 2 : ℂ) * S_R
  else if r.1 = s.1 + 1 then
    (H_L + H''_L) * MvPowerSeries.C (1 / 2 : ℂ) * S_L
  else
    0

structure LineRecFormalTrigToolkit : Prop where
  trig_coeff_mem : ∀ (K : Subfield ℂ) (n : ℕ),
    PowerSeries.coeff n lineArcPsSin0 ∈ K ∧ PowerSeries.coeff n lineArcPsCos0 ∈ K
  trig_deriv :
    PowerSeries.derivative lineArcPsSin0 = lineArcPsCos0 ∧
    PowerSeries.derivative lineArcPsCos0 = -lineArcPsSin0
  circle_lift : ∀ (c₀ s₀ : ℂ) (C S : PowerSeries ℂ),
    c₀ ^ 2 + s₀ ^ 2 = 1 →
    C ^ 2 + S ^ 2 = 1 →
    PowerSeries.constantCoeff C = c₀ →
    PowerSeries.constantCoeff S = s₀ →
    let θ := lineRecCircleAngle c₀ s₀ C S
    PowerSeries.constantCoeff θ = 0 ∧
    C = PowerSeries.C c₀ * lineRecPsCos θ - PowerSeries.C s₀ * lineRecPsSin θ ∧
    S = PowerSeries.C s₀ * lineRecPsCos θ + PowerSeries.C c₀ * lineRecPsSin θ ∧
    (θ = 0 ↔ C = PowerSeries.C c₀ ∧ S = PowerSeries.C s₀)
  half_step_diff : ∀ (c₁ s₁ c₂ s₂ : ℂ) (C₁ S₁ C₂ S₂ : PowerSeries ℂ),
    c₁ ^ 2 + s₁ ^ 2 = 1 →
    c₂ ^ 2 + s₂ ^ 2 = 1 →
    C₁ ^ 2 + S₁ ^ 2 = 1 →
    C₂ ^ 2 + S₂ ^ 2 = 1 →
    PowerSeries.constantCoeff C₁ = c₁ →
    PowerSeries.constantCoeff S₁ = s₁ →
    PowerSeries.constantCoeff C₂ = c₂ →
    PowerSeries.constantCoeff S₂ = s₂ →
    let θ₁ := lineRecCircleAngle c₁ s₁ C₁ S₁
    let θ₂ := lineRecCircleAngle c₂ s₂ C₂ S₂
    S₂ * C₁ - C₂ * S₁ =
      PowerSeries.C (s₂ * c₁ - c₂ * s₁) * lineRecPsCos (θ₂ - θ₁) +
        PowerSeries.C (c₂ * c₁ + s₂ * s₁) * lineRecPsSin (θ₂ - θ₁) ∧
    C₂ * C₁ + S₂ * S₁ =
      PowerSeries.C (c₂ * c₁ + s₂ * s₁) * lineRecPsCos (θ₂ - θ₁) -
        PowerSeries.C (s₂ * c₁ - c₂ * s₁) * lineRecPsSin (θ₂ - θ₁)
  comp_trig_add_2D1D : ∀ (w : PowerSeries ℂ) (B : MvPowerSeries (Fin 2) (PowerSeries ℂ)),
    PowerSeries.constantCoeff w = 0 →
    MvPowerSeries.coeff 0 B = 0 →
    lineArcCompConst2D1D lineArcPsCos0 (MvPowerSeries.C w + B) =
      MvPowerSeries.C (lineRecPsCos w) * lineArcCompConst2D1D lineArcPsCos0 B -
        MvPowerSeries.C (lineRecPsSin w) * lineArcCompConst2D1D lineArcPsSin0 B ∧
    lineArcCompConst2D1D lineArcPsSin0 (MvPowerSeries.C w + B) =
      MvPowerSeries.C (lineRecPsSin w) * lineArcCompConst2D1D lineArcPsCos0 B +
        MvPowerSeries.C (lineRecPsCos w) * lineArcCompConst2D1D lineArcPsSin0 B

structure LineRecFormalLiftToolkit : Prop where
  jetSeq_zero : ∀ (A : ℕ → PowerSeries ℂ) (Δ : PowerSeries ℂ) (n : ℕ),
    PowerSeries.coeff n (lineRecJetSeq A Δ 0) =
      PowerSeries.constantCoeff (A n) / (n.factorial : ℂ)
  jetSeq_deriv : ∀ (A : ℕ → PowerSeries ℂ) (Δ : PowerSeries ℂ) (l : ℕ),
    PowerSeries.derivative (lineRecJetSeq A Δ l) = lineRecJetSeq (fun m => A (m + 1)) Δ l
  jetSeq_eq_C_of_zero_shift : ∀ (A : ℕ → PowerSeries ℂ),
    (∀ l : ℕ, 1 ≤ l → lineRecJetSeq A 0 l = 0) →
    ∀ m : ℕ, A m = PowerSeries.C (PowerSeries.constantCoeff (A m))
  liftArcFn_props : ∀ (K F : Subfield ℂ) (Φ : ↥F →+* PowerSeries ℂ) (hKF : K ≤ F),
    (∀ (x : ℂ) (hx : x ∈ K), Φ ⟨x, hKF hx⟩ = PowerSeries.C x) →
    (∀ y : ↥F, PowerSeries.constantCoeff (Φ y) = (y : ℂ)) →
    (∀ z : ℂ, PowerSeries.constantCoeff (lineRecLiftArcFn F Φ z) = z) ∧
    (∀ x ∈ K, lineRecLiftArcFn F Φ x = PowerSeries.C x) ∧
    (∀ x ∈ F, ∀ y ∈ F,
      lineRecLiftArcFn F Φ (x + y) = lineRecLiftArcFn F Φ x + lineRecLiftArcFn F Φ y ∧
      lineRecLiftArcFn F Φ (x - y) = lineRecLiftArcFn F Φ x - lineRecLiftArcFn F Φ y ∧
      lineRecLiftArcFn F Φ (x * y) = lineRecLiftArcFn F Φ x * lineRecLiftArcFn F Φ y)
  liftMv2D_ring : ∀ (F : Subfield ℂ) (Φ : ↥F →+* PowerSeries ℂ),
    (∀ c : ℂ, lineRecLiftMv2D F Φ (MvPowerSeries.C c) =
      MvPowerSeries.C (lineRecLiftArcFn F Φ c)) ∧
    (∀ Ψ₁ Ψ₂ : MvPowerSeries (Fin 2) ℂ,
      (∀ d, MvPowerSeries.coeff d Ψ₁ ∈ F) →
      (∀ d, MvPowerSeries.coeff d Ψ₂ ∈ F) →
      lineRecLiftMv2D F Φ (Ψ₁ + Ψ₂) = lineRecLiftMv2D F Φ Ψ₁ + lineRecLiftMv2D F Φ Ψ₂ ∧
      lineRecLiftMv2D F Φ (Ψ₁ - Ψ₂) = lineRecLiftMv2D F Φ Ψ₁ - lineRecLiftMv2D F Φ Ψ₂ ∧
      lineRecLiftMv2D F Φ (Ψ₁ * Ψ₂) = lineRecLiftMv2D F Φ Ψ₁ * lineRecLiftMv2D F Φ Ψ₂)
  liftMv2D_comp_const : ∀ (K F : Subfield ℂ) (Φ : ↥F →+* PowerSeries ℂ) (hKF : K ≤ F),
    (∀ (x : ℂ) (hx : x ∈ K), Φ ⟨x, hKF hx⟩ = PowerSeries.C x) →
    ∀ (g : PowerSeries ℂ) (Ψ : MvPowerSeries (Fin 2) ℂ),
      (∀ n, PowerSeries.coeff n g ∈ K) →
      MvPowerSeries.coeff 0 Ψ = 0 →
      (∀ d, MvPowerSeries.coeff d Ψ ∈ F) →
      lineRecLiftMv2D F Φ (compPowerSeries2D g Ψ) =
        lineArcCompConst2D1D g (lineRecLiftMv2D F Φ Ψ)
  liftMv2D_comp_recenter : ∀ (K F : Subfield ℂ) (Φ : ↥F →+* PowerSeries ℂ) (hKF : K ≤ F),
    (∀ (x : ℂ) (hx : x ∈ K), Φ ⟨x, hKF hx⟩ = PowerSeries.C x) →
    ∀ (H_star : ℕ → ℂ) (Δ : PowerSeries ℂ) (Ψ : MvPowerSeries (Fin 2) ℂ),
      (∀ m, H_star m ∈ F) →
      PowerSeries.constantCoeff Δ = 0 →
      MvPowerSeries.coeff 0 Ψ = 0 →
      (∀ d, MvPowerSeries.coeff d Ψ ∈ F) →
      lineRecLiftMv2D F Φ
          (compPowerSeries2D (PowerSeries.mk (fun n => H_star n / (n.factorial : ℂ))) Ψ) =
        lineArcComp2D1D
          (lineRecJetSeq (fun m => lineRecLiftArcFn F Φ (H_star m)) Δ)
          (MvPowerSeries.C Δ + lineRecLiftMv2D F Φ Ψ)

structure LineRecTopSplitToolkit : Prop where
  action_top_split : ∀ {k : ℕ} (_hk : 2 ≤ k) (sin_d0 cos_d0 : Fin k → ℂ)
    (f_full : Fin k → ℕ → PowerSeries ℂ)
    (β_full : ℕ → Fin (k + 1) → MvPowerSeries (Fin 2) ℂ),
    (∀ r : Fin (k + 1), MvPowerSeries.coeff 0 (β_full 0 r) = 0) →
    (∀ J : ℕ, β_full (J + 1) 0 = 0 ∧ β_full (J + 1) (Fin.last k) = 0) →
    ∀ J : ℕ,
      lineArcSlice2D1D (J + 1) (lineArcFormalAction2D1D sin_d0 cos_d0 f_full β_full) =
        lineArcSlice2D1D (J + 1)
          (lineArcFormalAction2D1D sin_d0 cos_d0
            (lineArcTruncSupport J f_full) (lineArcTruncBeta J β_full)) +
        (∑ i : Fin k,
          (2 * lineRecSin0 sin_d0 cos_d0 (β_full 0) i) *
            compPowerSeries2D (f_full i (J + 1)) (lineRecMid0 (β_full 0) i)) +
        ∑ r : Fin (k - 1),
          lineRecGrad0 sin_d0 cos_d0 (fun i => f_full i 0) (β_full 0) r *
            β_full (J + 1) ⟨r.1 + 1, by have := r.2; omega⟩
  grad_top_split : ∀ {k : ℕ} (_hk : 2 ≤ k) (sin_d0 cos_d0 : Fin k → ℂ)
    (f_full : Fin k → ℕ → PowerSeries ℂ)
    (β_full : ℕ → Fin (k + 1) → MvPowerSeries (Fin 2) ℂ),
    (∀ r : Fin (k + 1), MvPowerSeries.coeff 0 (β_full 0 r) = 0) →
    (∀ J : ℕ, β_full (J + 1) 0 = 0 ∧ β_full (J + 1) (Fin.last k) = 0) →
    ∀ (J : ℕ) (r : Fin (k - 1)),
      lineArcSlice2D1D (J + 1) (lineArcFormalGrad2D1D sin_d0 cos_d0 f_full β_full r) =
        lineArcSlice2D1D (J + 1)
          (lineArcFormalGrad2D1D sin_d0 cos_d0
            (lineArcTruncSupport (J + 1) f_full) (lineArcTruncBeta J β_full) r) +
        ∑ s : Fin (k - 1),
          lineRecHess0 sin_d0 cos_d0 (fun i => f_full i 0) (β_full 0) r s *
            β_full (J + 1) ⟨s.1 + 1, by have := s.2; omega⟩
  slice_pos_zero_of_pos_zero : ∀ {k : ℕ} (sin_d0 cos_d0 : Fin k → ℂ)
    (f_seq : Fin k → ℕ → PowerSeries ℂ)
    (β_seq : ℕ → Fin (k + 1) → MvPowerSeries (Fin 2) ℂ) (m : ℕ),
    1 ≤ m →
    (∀ (i : Fin k) (l : ℕ), 1 ≤ l → f_seq i l = 0) →
    (∀ (l : ℕ) (r : Fin (k + 1)), 1 ≤ l → β_seq l r = 0) →
    lineArcSlice2D1D m (lineArcFormalAction2D1D sin_d0 cos_d0 f_seq β_seq) = 0 ∧
      ∀ r : Fin (k - 1),
        lineArcSlice2D1D m (lineArcFormalGrad2D1D sin_d0 cos_d0 f_seq β_seq r) = 0

structure LineRecSubSeriesToolkit : Prop where
  C_mem : ∀ (L : Subfield ℂ) {c : ℂ}, c ∈ L → lineCoreCoeffsIn L (MvPowerSeries.C c)
  X_mem : ∀ (L : Subfield ℂ) (s : Fin 2), lineCoreCoeffsIn L (MvPowerSeries.X s)
  add_mem : ∀ (L : Subfield ℂ) {S T : MvPowerSeries (Fin 2) ℂ},
    lineCoreCoeffsIn L S → lineCoreCoeffsIn L T → lineCoreCoeffsIn L (S + T)
  sub_mem : ∀ (L : Subfield ℂ) {S T : MvPowerSeries (Fin 2) ℂ},
    lineCoreCoeffsIn L S → lineCoreCoeffsIn L T → lineCoreCoeffsIn L (S - T)
  mul_mem : ∀ (L : Subfield ℂ) {S T : MvPowerSeries (Fin 2) ℂ},
    lineCoreCoeffsIn L S → lineCoreCoeffsIn L T → lineCoreCoeffsIn L (S * T)
  comp1D_mem : ∀ (L : Subfield ℂ) {f : PowerSeries ℂ} {U : MvPowerSeries (Fin 2) ℂ},
    (∀ n : ℕ, PowerSeries.coeff n f ∈ L) → MvPowerSeries.coeff 0 U = 0 →
    lineCoreCoeffsIn L U → lineCoreCoeffsIn L (compPowerSeries2D f U)
def PuncturedSliceRemovableProp {Ω : Set Plane} (C : AnalyticGlancingCollar Ω)
    (M : MeromorphicCollarData C) (K : NonisotropicCurveData C M) : Prop :=
  M.h_X 0 = ⊤ →
  ∀ (u₀ : ℂ) (δ : ℝ) (v_sl : ℂ → ℂ) (n d : Fin 2 → ℂ → ℂ),
    0 < δ →
    DifferentiableOn ℂ v_sl (Metric.ball u₀ δ \ {u₀}) →
    (∀ i : Fin 2, DifferentiableOn ℂ (n i) (Metric.ball u₀ δ) ∧
      DifferentiableOn ℂ (d i) (Metric.ball u₀ δ)) →
    (∀ u ∈ Metric.ball u₀ δ \ {u₀}, ∃ s : ℂ,
      Complex.exp (Complex.I * s) = v_sl u ∧ K.f s ≠ 0 ∧
      ∀ i : Fin 2, d i u ≠ 0 ∧ n i u = K.Γ s i * d i u) →
    ∃ L : ℂ, L ≠ 0 ∧ Filter.Tendsto v_sl (nhdsWithin u₀ {u₀}ᶜ) (nhds L)

structure GlobalExponentialExtensionData {Ω : Set Plane} (C : AnalyticGlancingCollar Ω)
    (M : MeromorphicCollarData C) (K : NonisotropicCurveData C M)
    (Reg : RegularCollarLocusData C M K)
    (ExpLift : RegularExponentialLiftData C M K Reg) where
  V_plus : ℂ × ℂ → ℂ
  V_minus : ℂ × ℂ → ℂ
  V_plus_holo : DifferentiableOn ℂ V_plus (meroTubeENNR M.r_base M.h_X)
  V_minus_holo : DifferentiableOn ℂ V_minus (meroTubeENNR M.r_base M.h_X)
  V_mul_one : ∀ p ∈ meroTubeENNR M.r_base M.h_X, V_plus p * V_minus p = 1
  V_plus_reg_eq : ∀ p ∈ Reg.U_reg, V_plus p = ExpLift.v p
  V_wall_strict : ∀ H₀ : ℝ, M.h_X 0 = ENNReal.ofReal H₀ →
    0 < H₀ ∧ ∀ p ∈ meroTubeENNR M.r_base M.h_X,
      ‖V_plus p‖ < Real.exp H₀ ∧ ‖V_minus p‖ < Real.exp H₀
noncomputable def deepPurePhiSqFirst (μ : ℂ) : ℂ :=
  (1 / 4 : ℂ) * ∑' m : ℕ, (-μ / 4) ^ m / ((2 * m + 3).factorial : ℂ)

noncomputable def deepPureGSqFirst (w : ℂ) : ℂ :=
  ∑' m : ℕ, (3 * (2 * m + 2) : ℂ) * (-w) ^ m / ((2 * m + 3).factorial : ℂ)

noncomputable def deepPureFrozenAction (Phi_sq W : ℂ → ℂ) (T Z J : ℂ) : ℂ :=
  J ^ 3 * Phi_sq (T ^ 2 * W Z * J ^ 2)

structure IsDeepPureFrozenPair (Phi_sq G_sq : ℂ → ℂ) : Prop where
  phi_holo : DifferentiableOn ℂ Phi_sq (Metric.ball (0 : ℂ) 8)
  g_holo : DifferentiableOn ℂ G_sq (Metric.ball (0 : ℂ) 2)
  phi_zero : Phi_sq 0 = (1 / 24 : ℂ)
  g_zero : G_sq 0 = 1
  legendre : ∀ μ ∈ Metric.ball (0 : ℂ) 8,
    2 * Phi_sq μ + 2 * μ * deriv Phi_sq μ = (1 / 12 : ℂ) * G_sq (μ / 4)

structure DeepPureRootData (G_sq : ℂ → ℂ) where
  ρ_u : ℝ
  C_j : ℝ
  j_root : ℂ → ℂ
  ρ_u_pos : 0 < ρ_u
  ρ_u_lt : ρ_u < 1 / 4
  C_j_pos : 0 < C_j
  j_holo : DifferentiableOn ℂ j_root (Metric.ball (0 : ℂ) ρ_u)
  j_zero : j_root 0 = 1
  j_props : ∀ u ∈ Metric.ball (0 : ℂ) ρ_u,
    j_root u ≠ 0 ∧
    ‖j_root u - 1‖ < 1 / 16 ∧
    ‖(j_root u)⁻¹ - 1‖ ≤ C_j * ‖u‖ ∧
    ‖u * (j_root u) ^ 2‖ < 2 ∧
    (j_root u) ^ 3 * G_sq (u * (j_root u) ^ 2) = 1
  j_unique : ∀ u ∈ Metric.ball (0 : ℂ) ρ_u, ∀ J : ℂ,
    ‖J - 1‖ < 1 / 8 → J ^ 3 * G_sq (u * J ^ 2) = 1 → J = j_root u

structure DeepPureModelSolution (α A₀ T₀ : ℝ) (G_sq W : ℂ → ℂ) where
  D_mod : ℝ
  C_mod : ℝ
  S_lim : ℂ × ℂ → ℂ
  D_mod_ge : 20 ≤ D_mod
  C_mod_pos : 0 < C_mod
  S_lim_holo : DifferentiableOn ℂ S_lim
    { p : ℂ × ℂ | ‖p.1‖ < T₀ ∧ D_mod < -p.2.im ∧ |p.2.re| < A₀ * (-p.2.im) }
  S_lim_props : ∀ T Y : ℂ, ‖T‖ < T₀ → D_mod < -Y.im → |Y.re| < A₀ * (-Y.im) →
    (S_lim (T, Y)).im < 0 ∧
    S_lim (-T, Y) = S_lim (T, Y) ∧
    ‖S_lim (T, Y) - Y‖ ≤ C_mod * ‖T‖ ^ 2 * (-Y.im) ^ (1 - 2 * α) ∧
    ‖(T / 2) ^ 2 * W (S_lim (T, Y)) * (deriv (fun Y' : ℂ => S_lim (T, Y')) Y) ^ 2‖ < 2 ∧
    (deriv (fun Y' : ℂ => S_lim (T, Y')) Y) ^ 3 *
      G_sq ((T / 2) ^ 2 * W (S_lim (T, Y)) *
        (deriv (fun Y' : ℂ => S_lim (T, Y')) Y) ^ 2) = 1
  S_lim_zero : ∀ Y : ℂ, D_mod < -Y.im → |Y.re| < A₀ * (-Y.im) → S_lim (0, Y) = Y
  S_lim_unique_1d : ∀ D₀ : ℝ, D_mod ≤ D₀ → ∀ T : ℂ, ‖T‖ < T₀ →
    ∀ (S_star : ℂ → ℂ) (C_star D₁ : ℝ),
      D₀ ≤ D₁ → 0 < C_star →
      DifferentiableOn ℂ S_star
        { Y : ℂ | D₀ < -Y.im ∧ |Y.re| < (A₀ + 1) * (-Y.im) } →
      (∀ Y : ℂ, D₀ < -Y.im → |Y.re| < (A₀ + 1) * (-Y.im) →
        ‖S_star Y - Y‖ ≤ C_star * (-Y.im) ^ (1 - 2 * α)) →
      (∀ Y : ℂ, D₁ < -Y.im → |Y.re| < (A₀ + 1) * (-Y.im) →
        (deriv S_star Y) ^ 3 *
          G_sq ((T / 2) ^ 2 * W (S_star Y) * (deriv S_star Y) ^ 2) = 1) →
      ∀ Y : ℂ, D₀ < -Y.im → |Y.re| < A₀ * (-Y.im) → S_star Y = S_lim (T, Y)

structure DeepPureRescaledPassages (α A₀ T₀ : ℝ) (B_seq : ℕ → ℝ) (Phi_sq W : ℂ → ℂ) where
  D_pass : ℝ
  D_rec : ℝ
  C_pass : ℝ
  S_seq : ℕ → (ℂ × ℂ → ℂ)
  p_seq : ℕ → (ℂ → ℂ → ℂ → ℂ)
  D_pass_ge : 20 ≤ D_pass
  D_rec_ge : D_pass ≤ D_rec
  C_pass_pos : 0 < C_pass
  B_pos : ∀ n : ℕ, 0 < B_seq n
  B_tendsto : Filter.Tendsto B_seq Filter.atTop Filter.atTop
  W_holo : DifferentiableOn ℂ W { Z : ℂ | Z.im < 0 }
  W_bound : ∀ Z : ℂ, 1 ≤ -Z.im → |Z.re| ≤ (A₀ + 6) * (-Z.im) →
    ‖W Z‖ ≤ C_pass * (-Z.im) ^ (-2 * α)
  trunc_passages : ∀ R_top : ℝ, D_pass < R_top →
    ∃ N_cone : ℕ, ∀ n ≥ N_cone,
      DifferentiableOn ℂ (S_seq n)
        { p : ℂ × ℂ |
          ‖p.1‖ < (3 / 2 : ℝ) * T₀ ∧
          D_pass / 2 < -p.2.im ∧ -p.2.im < R_top ∧
          |p.2.re| < (A₀ + 3) * (-p.2.im) } ∧
      (∀ T Y : ℂ,
        ‖T‖ < (3 / 2 : ℝ) * T₀ →
        D_pass / 2 < -Y.im → -Y.im < R_top →
        |Y.re| < (A₀ + 3) * (-Y.im) →
        (S_seq n (T, Y)).im < 0 ∧
        ‖S_seq n (T, Y) - Y‖ ≤ C_pass * ‖T‖ ^ 2 * (-Y.im) ^ (1 - 2 * α)) ∧
      (∀ Y : ℂ, D_pass / 2 < -Y.im → -Y.im < R_top → |Y.re| < (A₀ + 3) * (-Y.im) →
        S_seq n (0, Y) = Y)
  action_holo_and_conv : ∀ T : ℂ, ‖T‖ < T₀ →
    ∀ K_Z : Set ℂ, IsCompact K_Z →
      K_Z ⊆ { Z : ℂ | D_rec < -Z.im ∧ |Z.re| < (A₀ + 3) * (-Z.im) } →
      (∃ U_Z : Set ℂ, IsOpen U_Z ∧ K_Z ⊆ U_Z ∧
        U_Z ⊆ { Z : ℂ | D_rec / 2 < -Z.im ∧ |Z.re| < (A₀ + 4) * (-Z.im) } ∧
        ∃ N_holo : ℕ, ∀ n ≥ N_holo,
          DifferentiableOn ℂ (fun q : ℂ × ℂ => p_seq n T q.1 q.2)
            (U_Z ×ˢ Metric.ball (1 : ℂ) (1 / 4)) ∧
          DifferentiableOn ℂ
            (fun q : ℂ × ℂ => deriv (fun J' => p_seq n T q.1 J') q.2)
            (U_Z ×ˢ Metric.ball (1 : ℂ) (1 / 4))) ∧
      TendstoUniformlyOn
        (fun n (q : ℂ × ℂ) => p_seq n T q.1 q.2)
        (fun q : ℂ × ℂ => deepPureFrozenAction Phi_sq W T q.1 q.2)
        Filter.atTop (K_Z ×ˢ Metric.closedBall (1 : ℂ) (1 / 8)) ∧
      TendstoUniformlyOn
        (fun n (q : ℂ × ℂ) => deriv (fun J' => p_seq n T q.1 J') q.2)
        (fun q : ℂ × ℂ => deriv (fun J' => deepPureFrozenAction Phi_sq W T q.1 J') q.2)
        Filter.atTop (K_Z ×ˢ Metric.closedBall (1 : ℂ) (1 / 8)) ∧
      TendstoUniformlyOn
        (fun n (q : ℂ × ℂ) => deriv (fun Z' => p_seq n T Z' q.2) q.1)
        (fun q : ℂ × ℂ => deriv (fun Z' => deepPureFrozenAction Phi_sq W T Z' q.2) q.1)
        Filter.atTop (K_Z ×ˢ Metric.closedBall (1 : ℂ) (1 / 8))
  recurrence_eq : ∀ R_top : ℝ, 3 * D_rec < R_top →
    ∀ T : ℂ, ‖T‖ < T₀ → T ≠ 0 →
      ∃ N_rec : ℕ, ∀ n ≥ N_rec,
        ∀ Y : ℂ, 2 * D_rec < -Y.im → -Y.im < R_top - 2 → |Y.re| < (A₀ + 2) * (-Y.im) →
          let h_n : ℂ := T / (B_seq n : ℂ)
          let J_p : ℂ := (S_seq n (T, Y + h_n) - S_seq n (T, Y)) / h_n
          let J_m : ℂ := (S_seq n (T, Y) - S_seq n (T, Y - h_n)) / h_n
          ‖J_p - 1‖ ≤ 1 / 16 ∧ ‖J_m - 1‖ ≤ 1 / 16 ∧
          D_rec < -(S_seq n (T, Y)).im ∧
          |(S_seq n (T, Y)).re| < (A₀ + 3) * (-(S_seq n (T, Y)).im) ∧
          D_rec < -(S_seq n (T, Y - h_n)).im ∧
          |(S_seq n (T, Y - h_n)).re| < (A₀ + 3) * (-(S_seq n (T, Y - h_n)).im) ∧
          deriv (fun J' => p_seq n T (S_seq n (T, Y)) J') J_p -
            deriv (fun J' => p_seq n T (S_seq n (T, Y - h_n)) J') J_m =
            h_n * deriv (fun Z' => p_seq n T Z' J_p) (S_seq n (T, Y))
noncomputable def pcJetEdgeDX {k : ℕ} (x_base : Fin (k + 1) → ℂ)
    (β : Fin (k + 1) → MvPowerSeries (Fin 2) ℂ) (i : Fin k) :
    MvPowerSeries (Fin 2) ℂ :=
  MvPowerSeries.C (x_base i.succ - x_base i.castSucc) + (β i.succ - β i.castSucc)

noncomputable def pcJetEdgeDY {k : ℕ} (F_ser : Fin (k + 1) → PowerSeries ℂ)
    (β : Fin (k + 1) → MvPowerSeries (Fin 2) ℂ) (i : Fin k) :
    MvPowerSeries (Fin 2) ℂ :=
  compPowerSeries2D (F_ser i.succ) (β i.succ) -
    compPowerSeries2D (F_ser i.castSucc) (β i.castSucc)

noncomputable def pcJetEdgeU {k : ℕ} (x_base : Fin (k + 1) → ℂ) (ℓ_base : Fin k → ℂ)
    (F_ser : Fin (k + 1) → PowerSeries ℂ)
    (β : Fin (k + 1) → MvPowerSeries (Fin 2) ℂ) (i : Fin k) :
    MvPowerSeries (Fin 2) ℂ :=
  MvPowerSeries.C (((ℓ_base i) ^ 2)⁻¹) *
    ((pcJetEdgeDX x_base β i) ^ 2 + (pcJetEdgeDY F_ser β i) ^ 2 -
      MvPowerSeries.C ((ℓ_base i) ^ 2))

noncomputable def pcJetAction2D {k : ℕ} (x_base : Fin (k + 1) → ℂ) (ℓ_base : Fin k → ℂ)
    (S_ser : PowerSeries ℂ) (F_ser : Fin (k + 1) → PowerSeries ℂ)
    (β : Fin (k + 1) → MvPowerSeries (Fin 2) ℂ) :
    MvPowerSeries (Fin 2) ℂ :=
  ∑ i : Fin k,
    MvPowerSeries.C (ℓ_base i) *
      compPowerSeries2D S_ser (pcJetEdgeU x_base ℓ_base F_ser β i)

noncomputable def pcJetNumSucc {k : ℕ} (x_base : Fin (k + 1) → ℂ)
    (F_ser : Fin (k + 1) → PowerSeries ℂ)
    (β : Fin (k + 1) → MvPowerSeries (Fin 2) ℂ) (i : Fin k) :
    MvPowerSeries (Fin 2) ℂ :=
  pcJetEdgeDX x_base β i +
    pcJetEdgeDY F_ser β i *
      compPowerSeries2D (PowerSeries.derivative (F_ser i.succ)) (β i.succ)

noncomputable def pcJetNumCast {k : ℕ} (x_base : Fin (k + 1) → ℂ)
    (F_ser : Fin (k + 1) → PowerSeries ℂ)
    (β : Fin (k + 1) → MvPowerSeries (Fin 2) ℂ) (i : Fin k) :
    MvPowerSeries (Fin 2) ℂ :=
  pcJetEdgeDX x_base β i +
    pcJetEdgeDY F_ser β i *
      compPowerSeries2D (PowerSeries.derivative (F_ser i.castSucc)) (β i.castSucc)

noncomputable def pcJetEdgeTermSucc {k : ℕ} (x_base : Fin (k + 1) → ℂ) (ℓ_base : Fin k → ℂ)
    (I_ser : PowerSeries ℂ) (F_ser : Fin (k + 1) → PowerSeries ℂ)
    (β : Fin (k + 1) → MvPowerSeries (Fin 2) ℂ) (i : Fin k) :
    MvPowerSeries (Fin 2) ℂ :=
  MvPowerSeries.C ((ℓ_base i)⁻¹) *
    pcJetNumSucc x_base F_ser β i *
    compPowerSeries2D I_ser (pcJetEdgeU x_base ℓ_base F_ser β i)

noncomputable def pcJetEdgeTermCast {k : ℕ} (x_base : Fin (k + 1) → ℂ) (ℓ_base : Fin k → ℂ)
    (I_ser : PowerSeries ℂ) (F_ser : Fin (k + 1) → PowerSeries ℂ)
    (β : Fin (k + 1) → MvPowerSeries (Fin 2) ℂ) (i : Fin k) :
    MvPowerSeries (Fin 2) ℂ :=
  MvPowerSeries.C ((ℓ_base i)⁻¹) *
    pcJetNumCast x_base F_ser β i *
    compPowerSeries2D I_ser (pcJetEdgeU x_base ℓ_base F_ser β i)

noncomputable def pcJetGrad2D {k : ℕ} (x_base : Fin (k + 1) → ℂ) (ℓ_base : Fin k → ℂ)
    (I_ser : PowerSeries ℂ) (F_ser : Fin (k + 1) → PowerSeries ℂ)
    (β : Fin (k + 1) → MvPowerSeries (Fin 2) ℂ) (r : Fin (k - 1)) :
    MvPowerSeries (Fin 2) ℂ :=
  let i_L : Fin k := ⟨r.1, by have := r.2; omega⟩
  let i_R : Fin k := ⟨r.1 + 1, by have := r.2; omega⟩
  pcJetEdgeTermSucc x_base ℓ_base I_ser F_ser β i_L -
    pcJetEdgeTermCast x_base ℓ_base I_ser F_ser β i_R

noncomputable def pcJetVertexWeight {k : ℕ} (ℓ_base : Fin k → ℂ)
    (F_ser : Fin (k + 1) → PowerSeries ℂ) (s : Fin (k - 1)) : ℂ :=
  let i_L : Fin k := ⟨s.1, by have := s.2; omega⟩
  let i_R : Fin k := ⟨s.1 + 1, by have := s.2; omega⟩
  (PowerSeries.coeff 0 (F_ser i_L.succ) - PowerSeries.coeff 0 (F_ser i_L.castSucc)) /
      ℓ_base i_L -
    (PowerSeries.coeff 0 (F_ser i_R.succ) - PowerSeries.coeff 0 (F_ser i_R.castSucc)) /
      ℓ_base i_R

noncomputable def pcJetFormalHess {k : ℕ} (x_base : Fin (k + 1) → ℂ) (ℓ_base : Fin k → ℂ)
    (F_ser : Fin (k + 1) → PowerSeries ℂ) :
    Matrix (Fin (k - 1)) (Fin (k - 1)) ℂ :=
  fun r s =>
    let i_L : Fin k := ⟨r.1, by have := r.2; omega⟩
    let i_R : Fin k := ⟨r.1 + 1, by have := r.2; omega⟩
    let Δx_L := x_base i_L.succ - x_base i_L.castSucc
    let ΔY_L := PowerSeries.coeff 0 (F_ser i_L.succ) - PowerSeries.coeff 0 (F_ser i_L.castSucc)
    let L_L := ℓ_base i_L
    let F1_L_succ := PowerSeries.coeff 1 (F_ser i_L.succ)
    let F1_L_cast := PowerSeries.coeff 1 (F_ser i_L.castSucc)
    let F2_L_succ := 2 * PowerSeries.coeff 2 (F_ser i_L.succ)
    let n_L_succ := Δx_L + ΔY_L * F1_L_succ
    let n_L_cast := Δx_L + ΔY_L * F1_L_cast
    let Δx_R := x_base i_R.succ - x_base i_R.castSucc
    let ΔY_R := PowerSeries.coeff 0 (F_ser i_R.succ) - PowerSeries.coeff 0 (F_ser i_R.castSucc)
    let L_R := ℓ_base i_R
    let F1_R_cast := PowerSeries.coeff 1 (F_ser i_R.castSucc)
    let F1_R_succ := PowerSeries.coeff 1 (F_ser i_R.succ)
    let F2_R_cast := 2 * PowerSeries.coeff 2 (F_ser i_R.castSucc)
    let n_R_cast := Δx_R + ΔY_R * F1_R_cast
    let n_R_succ := Δx_R + ΔY_R * F1_R_succ
    if r.1 = s.1 then
      (((1 + F1_L_succ ^ 2 + ΔY_L * F2_L_succ) * L_L ^ 2 - n_L_succ ^ 2) / L_L ^ 3) +
        (((1 + F1_R_cast ^ 2 - ΔY_R * F2_R_cast) * L_R ^ 2 - n_R_cast ^ 2) / L_R ^ 3)
    else if s.1 = r.1 + 1 then
      ((-1 - F1_R_succ * F1_R_cast) * L_R ^ 2 + n_R_cast * n_R_succ) / L_R ^ 3
    else if r.1 = s.1 + 1 then
      ((-1 - F1_L_cast * F1_L_succ) * L_L ^ 2 + n_L_succ * n_L_cast) / L_L ^ 3
    else
      0

noncomputable def pcJetTrunc1D (K : ℕ) (f : PowerSeries ℂ) : PowerSeries ℂ :=
  PowerSeries.mk fun m => if m ≤ K then PowerSeries.coeff m f else 0

noncomputable def pcJetTruncAbscissas {k : ℕ} (N₀ : ℕ)
    (β : Fin (k + 1) → MvPowerSeries (Fin 2) ℂ) (r : Fin (k + 1)) :
    MvPowerSeries (Fin 2) ℂ :=
  fun u =>
    if r.1 = 0 ∨ r.1 = k then MvPowerSeries.coeff u (β r)
    else if u 0 + u 1 < N₀ then MvPowerSeries.coeff u (β r)
    else 0
noncomputable def sfcaBivarDiv (f : ℂ → ℂ → ℂ) (b₀ b₁ : ℂ) : ℂ :=
  dslope (fun z₀ => dslope (fun z₁ => f z₀ z₁) 0 b₁) 0 b₀

def IsSfcaBivarHoloVanish (f : ℂ → ℂ → ℂ) : Prop :=
  DifferentiableOn ℂ (fun z : ℂ × ℂ => f z.1 z.2)
    (Metric.ball (0 : ℂ) sfcaRhoB ×ˢ Metric.ball (0 : ℂ) sfcaRhoB) ∧
  (∀ z₁ : ℂ, ‖z₁‖ < sfcaRhoB → f 0 z₁ = 0) ∧
  (∀ z₀ : ℂ, ‖z₀‖ < sfcaRhoB → f z₀ 0 = 0)
noncomputable def puisDualLine0 {Ω : Set Plane} (C : AnalyticGlancingCollar Ω) (d : ℕ) :
    Fin 2 → ℂ × ℂ → ℂ :=
  fun ι p => dualLineShift C 0 ι (p.1, p.2 ^ d)

structure PuiseuxCoverGermData {Ω : Set Plane} {C : AnalyticGlancingCollar Ω}
    {hDet : EndpointDeterminationData C} (W : CollarWidthTubeData C hDet)
    (t₂ : ℝ) (D_wall : AlignedWallDefectData W t₂)
    {N_idx : ℕ} (q_idx : Fin N_idx → ℤ)
    (Br : PuncturedGlancingBridgeData W t₂ D_wall q_idx) where
  d : ℕ
  d_pos : 1 ≤ d
  r_yp : ℝ
  r_τ : ℝ
  K_p : ℕ
  r_yp_pos : 0 < r_yp
  r_yp_le : r_yp ≤ Br.r_y / 2
  r_τ_pos : 0 < r_τ
  r_τ_pow_lt : r_τ ^ d < Br.r_t / 2
  M_puis : Fin 2 → ℂ × ℂ → ℂ
  N_puis : Fin 2 → ℂ × ℂ → ℂ
  M_puis_holo : ∀ ι : Fin 2,
    DifferentiableOn ℂ (M_puis ι)
      (Metric.ball (Br.y₀ : ℂ) r_yp ×ˢ (Metric.ball (0 : ℂ) r_τ \ {0}))
  N_puis_holo : ∀ ι : Fin 2,
    DifferentiableOn ℂ (N_puis ι)
      (Metric.ball (Br.y₀ : ℂ) r_yp ×ˢ Metric.ball (0 : ℂ) r_τ)
  N_puis_eq : ∀ ι : Fin 2,
    ∀ p ∈ Metric.ball (Br.y₀ : ℂ) r_yp ×ˢ Metric.ball (0 : ℂ) r_τ,
      p.2 ≠ 0 → N_puis ι p = p.2 ^ K_p * M_puis ι p
  puis_rank_one :
    ∀ p ∈ Metric.ball (Br.y₀ : ℂ) r_yp ×ˢ (Metric.ball (0 : ℂ) r_τ \ {0}),
      homRankOneDet (homIntersect (puisDualLine0 C d) M_puis) p = 0
  puis_reflect :
    ∀ p ∈ Metric.ball (Br.y₀ : ℂ) r_yp ×ˢ (Metric.ball (0 : ℂ) r_τ \ {0}),
      ∀ ι : Fin 2, homReflectRes (puisDualLine0 C d) M_puis ι p = 0
  not_w2_zero :
    ¬ ∀ p ∈ Metric.ball (Br.y₀ : ℂ) r_yp ×ˢ (Metric.ball (0 : ℂ) r_τ \ {0}),
        homIntersect (puisDualLine0 C d) M_puis 2 p = 0
  not_iso_line : ∀ (V : Set (ℂ × ℂ)) (s_iso c_star : ℂ),
    IsOpen V → V.Nonempty →
    V ⊆ Metric.ball (Br.y₀ : ℂ) r_yp ×ˢ (Metric.ball (0 : ℂ) r_τ \ {0}) →
    (s_iso = 1 ∨ s_iso = -1) →
    ¬ ∀ p ∈ V,
        homIntersect (puisDualLine0 C d) M_puis 0 p +
          s_iso * Complex.I * homIntersect (puisDualLine0 C d) M_puis 1 p -
          c_star * homIntersect (puisDualLine0 C d) M_puis 2 p = 0
  not_prev_eq : ∀ (V : Set (ℂ × ℂ)),
    IsOpen V → V.Nonempty →
    V ⊆ Metric.ball (Br.y₀ : ℂ) r_yp ×ˢ (Metric.ball (0 : ℂ) r_τ \ {0}) →
    ¬ ∀ p ∈ V,
        let W₁ := homIntersect (puisDualLine0 C d) M_puis
        let W₀ : Fin 3 → ℂ × ℂ → ℂ := fun k q =>
          homIntersect (dualLineShift C (-1)) (dualLineShift C 0) k (q.1, q.2 ^ d)
        W₁ 0 p * W₀ 2 p - W₀ 0 p * W₁ 2 p = 0 ∧
        W₁ 1 p * W₀ 2 p - W₀ 1 p * W₁ 2 p = 0
  not_primary : ∀ (V : Set (ℂ × ℂ)),
    IsOpen V → V.Nonempty →
    V ⊆ Metric.ball (Br.y₀ : ℂ) r_yp ×ˢ (Metric.ball (0 : ℂ) r_τ \ {0}) →
    ¬ ∀ p ∈ V, ∀ ι : Fin 2, M_puis ι p = dualLineShift C 1 ι (p.1, p.2 ^ d)
  puis_poly_transfer : ∀ (y_m t_m r_m : ℝ) (M_cand : Fin 2 → ℂ × ℂ → ℂ),
    0 < t_m → 0 < r_m →
    Metric.ball ((y_m : ℂ), (t_m : ℂ)) r_m ⊆
      symCollarDom W.s_base W.r_base q_idx →
    (∀ ι : Fin 2, DifferentiableOn ℂ (M_cand ι) (Metric.ball ((y_m : ℂ), (t_m : ℂ)) r_m)) →
    (∃ V_τ : Set (ℂ × ℂ), IsOpen V_τ ∧ V_τ.Nonempty ∧
      V_τ ⊆ Metric.ball (Br.y₀ : ℂ) r_yp ×ˢ (Metric.ball (0 : ℂ) r_τ \ {0}) ∧
      (∀ q ∈ V_τ, (q.1, q.2 ^ d) ∈ Metric.ball ((y_m : ℂ), (t_m : ℂ)) r_m ∧
        ∀ ι : Fin 2, M_puis ι q = M_cand ι (q.1, q.2 ^ d))) →
    ∀ (M D : ℕ) (ι_star : Fin 2)
      (P_coeff : Fin (D + 1) → MvPolynomial (SymJetVar N_idx M) ℂ),
      (∀ p ∈ Metric.ball ((Br.y₀ : ℂ), (Br.t_end : ℂ)) Br.r_end,
        ∑ deg : Fin (D + 1),
          MvPolynomial.eval (symJetEnv C q_idx M p) (P_coeff deg) *
            (Br.M₁_end ι_star p) ^ (deg : ℕ) = 0) ↔
      (∀ p ∈ Metric.ball ((y_m : ℂ), (t_m : ℂ)) r_m,
        ∑ deg : Fin (D + 1),
          MvPolynomial.eval (symJetEnv C q_idx M p) (P_coeff deg) *
            (M_cand ι_star p) ^ (deg : ℕ) = 0)

structure RegularAffineIntersectionData {Ω : Set Plane} {C : AnalyticGlancingCollar Ω}
    {hDet : EndpointDeterminationData C} (W : CollarWidthTubeData C hDet)
    (t₂ : ℝ) (D_wall : AlignedWallDefectData W t₂)
    {N_idx : ℕ} (q_idx : Fin N_idx → ℤ)
    (Br : PuncturedGlancingBridgeData W t₂ D_wall q_idx)
    (G : PuiseuxCoverGermData W t₂ D_wall q_idx Br) where
  y₁ : ℝ
  ρ₁ : ℝ
  m_star : ℕ
  ρ₁_pos : 0 < ρ₁
  ball_y₁_sub : Metric.ball (y₁ : ℂ) ρ₁ ⊆ Metric.ball (Br.y₀ : ℂ) G.r_yp
  ρ₁_le_τ : ρ₁ ≤ G.r_τ
  W_tilde : Fin 3 → ℂ × ℂ → ℂ
  Z : Fin 2 → ℂ × ℂ → ℂ
  W_tilde_holo : ∀ k : Fin 3,
    DifferentiableOn ℂ (W_tilde k) (Metric.ball (y₁ : ℂ) ρ₁ ×ˢ Metric.ball (0 : ℂ) ρ₁)
  W_tilde_puis_eq : ∀ p ∈ Metric.ball (y₁ : ℂ) ρ₁ ×ˢ Metric.ball (0 : ℂ) ρ₁,
    p.2 ≠ 0 → ∀ k : Fin 3,
      p.2 ^ m_star * W_tilde k p =
        p.2 ^ G.K_p * homIntersect (puisDualLine0 C G.d) G.M_puis k p
  W_tilde_two_ne_zero : ∀ p ∈ Metric.ball (y₁ : ℂ) ρ₁ ×ˢ Metric.ball (0 : ℂ) ρ₁,
    W_tilde 2 p ≠ 0
  Z_eq : ∀ ι : Fin 2, ∀ p ∈ Metric.ball (y₁ : ℂ) ρ₁ ×ˢ Metric.ball (0 : ℂ) ρ₁,
    Z ι p = W_tilde ι.castSucc p / W_tilde 2 p
  Z_holo : ∀ ι : Fin 2,
    DifferentiableOn ℂ (Z ι) (Metric.ball (y₁ : ℂ) ρ₁ ×ˢ Metric.ball (0 : ℂ) ρ₁)
  Z_incidence : ∀ p ∈ Metric.ball (y₁ : ℂ) ρ₁ ×ˢ Metric.ball (0 : ℂ) ρ₁,
    puisDualLine0 C G.d 0 p * Z 0 p + puisDualLine0 C G.d 1 p * Z 1 p = 1
  Z_rank_one : ∀ p ∈ Metric.ball (y₁ : ℂ) ρ₁ ×ˢ Metric.ball (0 : ℂ) ρ₁,
    pderivA (Z 0) p * pderivD (Z 1) p = pderivD (Z 0) p * pderivA (Z 1) p

structure TransverseNonisotropicArcData {Ω : Set Plane} {C : AnalyticGlancingCollar Ω}
    {hDet : EndpointDeterminationData C} (W : CollarWidthTubeData C hDet)
    (t₂ : ℝ) (D_wall : AlignedWallDefectData W t₂)
    {N_idx : ℕ} (q_idx : Fin N_idx → ℤ)
    (Br : PuncturedGlancingBridgeData W t₂ D_wall q_idx)
    (G : PuiseuxCoverGermData W t₂ D_wall q_idx Br)
    (R : RegularAffineIntersectionData W t₂ D_wall q_idx Br G) where
  y₂ : ℝ
  δ_s : ℝ
  δ₂ : ℝ
  δ_s_pos : 0 < δ_s
  δ₂_pos : 0 < δ₂
  δ₂_le_s : δ₂ ≤ δ_s
  ball_y₂_s_sub : Metric.ball (y₂ : ℂ) δ_s ⊆ Metric.ball (R.y₁ : ℂ) R.ρ₁
  δ₂_le_ρ₁ : δ₂ ≤ R.ρ₁
  Z_zero : Fin 2 → ℂ → ℂ
  σ : ℂ × ℂ → ℂ
  Z_zero_holo : ∀ ι : Fin 2, DifferentiableOn ℂ (Z_zero ι) (Metric.ball (y₂ : ℂ) δ_s)
  Z_zero_incidence_zero : ∀ s ∈ Metric.ball (y₂ : ℂ) δ_s,
    dualLineShift C 0 0 (s, 0) * Z_zero 0 s + dualLineShift C 0 1 (s, 0) * Z_zero 1 s = 1
  Z_zero_nonisotropic_at : (deriv (Z_zero 0) (y₂ : ℂ)) ^ 2 + (deriv (Z_zero 1) (y₂ : ℂ)) ^ 2 ≠ 0
  Z_zero_transverse_at :
    dualLineShift C 0 0 ((y₂ : ℂ), 0) * deriv (Z_zero 0) (y₂ : ℂ) +
      dualLineShift C 0 1 ((y₂ : ℂ), 0) * deriv (Z_zero 1) (y₂ : ℂ) ≠ 0
  σ_holo : DifferentiableOn ℂ σ (Metric.ball (y₂ : ℂ) δ₂ ×ˢ Metric.ball (0 : ℂ) δ₂)
  σ_maps_to : ∀ p ∈ Metric.ball (y₂ : ℂ) δ₂ ×ˢ Metric.ball (0 : ℂ) δ₂,
    σ p ∈ Metric.ball (y₂ : ℂ) δ_s
  σ_at_zero : ∀ y ∈ Metric.ball (y₂ : ℂ) δ₂, σ (y, 0) = y
  σ_pderivA_ne_zero : ∀ p ∈ Metric.ball (y₂ : ℂ) δ₂ ×ˢ Metric.ball (0 : ℂ) δ₂,
    pderivA σ p ≠ 0
  Z_eq_comp_σ : ∀ ι : Fin 2, ∀ p ∈ Metric.ball (y₂ : ℂ) δ₂ ×ˢ Metric.ball (0 : ℂ) δ₂,
    R.Z ι p = Z_zero ι (σ p)
noncomputable def rp_iterDslope (w₁ : ℂ) (g : ℂ → ℂ) : ℕ → ℂ → ℂ
  | 0 => g
  | k + 1 => dslope (rp_iterDslope w₁ g k) w₁

noncomputable def rp_substPS (f Ψ : PowerSeries ℂ) : PowerSeries ℂ :=
  PowerSeries.mk fun m =>
    ∑ r ∈ Finset.range (m + 1), PowerSeries.coeff r f * PowerSeries.coeff m (Ψ ^ r)

noncomputable def rp_jetVSeries (u : ℕ → ℂ → ℂ) (z : ℂ) : PowerSeries ℂ :=
  PowerSeries.mk fun m =>
    if m % 2 = 0 ∧ 2 ≤ m then u (m / 2) z else 0

noncomputable def rp_jetHPlusSeries (u : ℕ → ℂ → ℂ) (z : ℂ) : PowerSeries ℂ :=
  PowerSeries.mk fun m =>
    (if m = 1 then (1 : ℂ) else 0) +
      ∑ p ∈ Finset.HasAntidiagonal.antidiagonal m,
        if p.1 % 2 = 0 ∧ 2 ≤ p.1 ∧ 1 ≤ p.2 then
          iteratedDeriv p.2 (u (p.1 / 2)) z / (p.2.factorial : ℂ)
        else 0

noncomputable def rp_jetHMinusSeries (u : ℕ → ℂ → ℂ) (z : ℂ) : PowerSeries ℂ :=
  PowerSeries.mk fun m =>
    (if m = 1 then (1 : ℂ) else 0) +
      ∑ p ∈ Finset.HasAntidiagonal.antidiagonal m,
        if p.1 % 2 = 0 ∧ 2 ≤ p.1 ∧ 1 ≤ p.2 then
          (-1 : ℂ) ^ (p.2 + 1) * (iteratedDeriv p.2 (u (p.1 / 2)) z / (p.2.factorial : ℂ))
        else 0

noncomputable def rp_reflPolySeries {n : ℕ} (G : LocalPositiveCenterGerm n)
    (N : ℕ) (u : ℕ → ℂ → ℂ) (z : ℂ) : PowerSeries ℂ :=
  ∑ d ∈ Finset.range (N + 1),
    ∑ k ∈ Finset.HasAntidiagonal.antidiagonal d,
      rp_substPS (holoTaylor1D (reflDiffCoeff G k.1 k.2) z) (rp_jetVSeries u z) *
        (rp_jetHMinusSeries u z) ^ k.1 * (rp_jetHPlusSeries u z) ^ k.2

def rp_truncJet (u : ℕ → ℂ → ℂ) (j i : ℕ) : ℂ → ℂ :=
  if 1 ≤ i ∧ i < j then u i else fun _ => 0

def rp_VanishesToOrderPS (M : ℕ) (P : PowerSeries ℂ) : Prop :=
  ∀ m : ℕ, m < M → PowerSeries.coeff m P = 0

def rp_HasPSLaurentWeight (w : ℤ) (Ψ : ℂ → PowerSeries ℂ) : Prop :=
  ∀ β : ℕ,
    MeromorphicAt (fun z => PowerSeries.coeff β (Ψ z)) 0 ∧
      ((w - (β : ℤ) : ℤ) : WithTop ℤ) ≤
        meromorphicOrderAt (fun z => PowerSeries.coeff β (Ψ z)) 0
noncomputable def pculTaylorRem2 (F : ℂ → ℂ) (z d : ℂ) : ℂ :=
  ∫ t in (0 : ℝ)..1, ((1 - t : ℝ) : ℂ) * deriv (deriv F) (z + (t : ℂ) * d)

noncomputable def pculSlopeSpeed (v_a : ℝ) (m : ℂ) : ℂ :=
  (Real.sqrt (1 + v_a ^ 2) : ℂ) *
    sqrt1p ((m ^ 2 - (v_a : ℂ) ^ 2) / ((1 + v_a ^ 2 : ℝ) : ℂ))

noncomputable def pculGammaQuot (v_a : ℝ) (m₁ m₂ : ℂ) : ℂ :=
  let σ₁ := pculSlopeSpeed v_a m₁
  let σ₂ := pculSlopeSpeed v_a m₂
  (1 - m₁ * m₂ + σ₁ * σ₂) / (σ₁ * σ₂ * (σ₁ + σ₂))

noncomputable def pculPsiQuadQuot (v_a : ℝ) (μ m : ℂ) : ℂ :=
  let σ_m := pculSlopeSpeed v_a m
  let σ_μ := pculSlopeSpeed v_a μ
  (σ_m * (1 + μ * m + σ_m * σ_μ))⁻¹

def PculUnifBdd (φ : Filter ℝ) (D : Set ℂ) (F : ℝ → ℂ → ℂ) (f : ℂ → ℂ) : Prop :=
  TendstoUniformlyOn F f φ D ∧ ∃ M : ℝ, 0 ≤ M ∧ ∀ e ∈ D, ‖f e‖ ≤ M
def wallBridgeB (K : ℕ) : ℕ := K + 2

def wallUnalignedShifts (K : ℕ) {N_idx : ℕ} (q_idx : Fin N_idx → ℤ) : Finset ℤ :=
  ({(-1 : ℤ), (0 : ℤ), ((wallBridgeB K : ℕ) : ℤ)} : Finset ℤ) ∪ Finset.univ.image q_idx

def wallAllShifts (K : ℕ) {N_idx : ℕ} (q_idx : Fin N_idx → ℤ) : Finset ℤ :=
  insert (1 : ℤ) (wallUnalignedShifts K q_idx)

noncomputable def wallAllJBound (K : ℕ) {N_idx : ℕ} (q_idx : Fin N_idx → ℤ) : ℝ :=
  (((wallAllShifts K q_idx).sup (fun q : ℤ => q.natAbs) : ℕ) : ℝ) + 2

def wallUnifiedDom (s_b r_b : ℝ) (K : ℕ) {N_idx : ℕ} (q_idx : Fin N_idx → ℤ) : Set (ℂ × ℂ) :=
  { p : ℂ × ℂ | |p.1.im| < s_b / 2 ∧ ‖p.2‖ < r_b ∧
      |p.2.im| < s_b / (2 * wallAllJBound K q_idx) }

def wallShiftPair (q : ℤ) (p : ℂ × ℂ) : ℂ × ℂ :=
  (p.1 + (q : ℂ) * p.2, p.2)

noncomputable def fieldSymJetEnv {N_idx : ℕ} (q_idx : Fin N_idx → ℤ) (M : ℕ)
    (E : ℤ → Fin 2 → ℂ × ℂ → ℂ) (p : ℂ × ℂ) : SymJetVar N_idx M → ℂ :=
  fun v => iterDerivYT v.2.2.1.1 v.2.2.2.1 (E (q_idx v.1) v.2.1) p

structure RootDetourChain {D_det : Fin 2 → ℕ}
    (U_reg : Set (ℂ × ℂ))
    (C_poly : ∀ ι : Fin 2, Fin (D_det ι + 1) → ℂ × ℂ → ℂ)
    (p_a : ℂ × ℂ) (r_a : ℝ) (M_a : Fin 2 → ℂ × ℂ → ℂ)
    (p_b : ℂ × ℂ) (r_b : ℝ) (M_b : Fin 2 → ℂ × ℂ → ℂ) where
  L_ch : ℕ
  c_ch : Fin (L_ch + 1) → ℂ × ℂ
  r_ch : Fin (L_ch + 1) → ℝ
  M_ch : Fin (L_ch + 1) → Fin 2 → ℂ × ℂ → ℂ
  r_ch_pos : ∀ j, 0 < r_ch j
  ball_sub_reg : ∀ j, Metric.ball (c_ch j) (r_ch j) ⊆ U_reg
  start_eq : c_ch 0 = p_a ∧ Metric.ball (c_ch 0) (r_ch 0) ⊆ Metric.ball p_a r_a ∧
    ∀ ι : Fin 2, ∀ q ∈ Metric.ball (c_ch 0) (r_ch 0), M_ch 0 ι q = M_a ι q
  end_eq : c_ch (Fin.last L_ch) = p_b ∧ r_ch (Fin.last L_ch) = r_b ∧
    ∀ ι : Fin 2, ∀ q ∈ Metric.ball p_b r_b, M_ch (Fin.last L_ch) ι q = M_b ι q
  step_overlap : ∀ j : Fin L_ch,
    (Metric.ball (c_ch j.castSucc) (r_ch j.castSucc) ∩
      Metric.ball (c_ch j.succ) (r_ch j.succ)).Nonempty ∧
    ∀ ι : Fin 2,
      ∀ q ∈ Metric.ball (c_ch j.castSucc) (r_ch j.castSucc) ∩
          Metric.ball (c_ch j.succ) (r_ch j.succ),
        M_ch j.castSucc ι q = M_ch j.succ ι q
  holo_and_solves : ∀ j (ι : Fin 2),
    DifferentiableOn ℂ (M_ch j ι) (Metric.ball (c_ch j) (r_ch j)) ∧
    ∀ q ∈ Metric.ball (c_ch j) (r_ch j),
      ∑ d : Fin (D_det ι + 1), C_poly ι d q * (M_ch j ι q) ^ (d : ℕ) = 0

structure ZeroAvoidingRootContKit : Prop where
  isPreconnected_compl_zero : ∀ {U : Set (ℂ × ℂ)} {H : ℂ × ℂ → ℂ},
    IsOpen U → Convex ℝ U → DifferentiableOn ℂ H U →
    IsPreconnected { p ∈ U | H p ≠ 0 }
  exists_nonzero_finset_on_open : ∀ {ι : Type} (s : Finset ι) {W V : Set (ℂ × ℂ)}
      (f : ι → ℂ × ℂ → ℂ),
    IsOpen W → IsPreconnected W → IsOpen V → V.Nonempty → V ⊆ W →
    (∀ i ∈ s, DifferentiableOn ℂ (f i) W ∧ ∃ p ∈ W, f i p ≠ 0) →
    ∃ p ∈ V, ∀ i ∈ s, f i p ≠ 0
  detour_root_chain : ∀ {U : Set (ℂ × ℂ)} {H : ℂ × ℂ → ℂ} {D_det : Fin 2 → ℕ}
      (C_poly : ∀ ι : Fin 2, Fin (D_det ι + 1) → ℂ × ℂ → ℂ)
      (p_a p_b : ℂ × ℂ) (r_a : ℝ) (M_a : Fin 2 → ℂ × ℂ → ℂ),
    IsOpen U → Convex ℝ U → DifferentiableOn ℂ H U →
    (∀ ι : Fin 2, 1 ≤ D_det ι) →
    (∀ ι d, DifferentiableOn ℂ (C_poly ι d) U) →
    (∀ ι : Fin 2, ∀ q ∈ U, H q ≠ 0 →
      C_poly ι (Fin.last (D_det ι)) q ≠ 0 ∧
      ∀ z : ℂ,
        ∑ d : Fin (D_det ι + 1), C_poly ι d q * z ^ (d : ℕ) = 0 →
        ∑ d : Fin (D_det ι),
          (((d : ℕ) + 1 : ℕ) : ℂ) * C_poly ι d.succ q * z ^ (d : ℕ) ≠ 0) →
    p_a ∈ U → H p_a ≠ 0 → p_b ∈ U → H p_b ≠ 0 →
    0 < r_a → Metric.ball p_a r_a ⊆ U →
    (∀ ι : Fin 2, DifferentiableOn ℂ (M_a ι) (Metric.ball p_a r_a)) →
    (∀ ι : Fin 2, ∀ q ∈ Metric.ball p_a r_a,
      ∑ d : Fin (D_det ι + 1), C_poly ι d q * (M_a ι q) ^ (d : ℕ) = 0) →
    ∃ (r_b : ℝ) (M_b : Fin 2 → ℂ × ℂ → ℂ),
      0 < r_b ∧ Metric.ball p_b r_b ⊆ { q ∈ U | H q ≠ 0 } ∧
      (∀ ι : Fin 2, DifferentiableOn ℂ (M_b ι) (Metric.ball p_b r_b)) ∧
      (∀ ι : Fin 2, ∀ q ∈ Metric.ball p_b r_b,
        ∑ d : Fin (D_det ι + 1), C_poly ι d q * (M_b ι q) ^ (d : ℕ) = 0) ∧
      Nonempty (RootDetourChain { q ∈ U | H q ≠ 0 } C_poly p_a r_a M_a p_b r_b M_b)

structure EndpointClearingAndBidiskData {Ω : Set Plane} {C : AnalyticGlancingCollar Ω}
    {hDet : EndpointDeterminationData C} (W : CollarWidthTubeData C hDet)
    (K : ℕ) {N_idx : ℕ} (q_idx : Fin N_idx → ℤ) where
  M_det : Fin 2 → ℕ
  D_det : Fin 2 → ℕ
  D_det_pos : ∀ ι : Fin 2, 1 ≤ D_det ι
  Q_det : ∀ ι : Fin 2, Fin (D_det ι + 1) → MvPolynomial (LineJetVar (M_det ι)) ℂ
  Disc_det : ∀ ι : Fin 2, MvPolynomial (LineJetVar (M_det ι)) ℂ
  A_coeff : ∀ ι : Fin 2, Fin (D_det ι + 1) → ℂ × ℂ → ℂ
  Δ_base : Fin 2 → ℂ × ℂ → ℂ
  A_coeff_def : ∀ ι d p,
    A_coeff ι d p =
      MvPolynomial.eval
        (lineJetEnv (M_det ι) (dualLineShift C 0)
          (dualLineShift C (wallBridgeB K : ℤ)) p)
        (Q_det ι d)
  Δ_base_def : ∀ ι p,
    Δ_base ι p =
      MvPolynomial.eval
        (lineJetEnv (M_det ι) (dualLineShift C 0)
          (dualLineShift C (wallBridgeB K : ℤ)) p)
        (Disc_det ι)
  univ_separable : ∀ (ι : Fin 2) (env : LineJetVar (M_det ι) → ℂ) (z : ℂ),
    MvPolynomial.eval env (Q_det ι (Fin.last (D_det ι))) ≠ 0 →
    MvPolynomial.eval env (Disc_det ι) ≠ 0 →
    ∑ d : Fin (D_det ι + 1), MvPolynomial.eval env (Q_det ι d) * z ^ (d : ℕ) = 0 →
    ∑ d : Fin (D_det ι),
      (((d : ℕ) + 1 : ℕ) : ℂ) * MvPolynomial.eval env (Q_det ι d.succ) * z ^ (d : ℕ) ≠ 0
  base_coeff_holo : ∀ ι d,
    DifferentiableOn ℂ (A_coeff ι d) (wallUnifiedDom W.s_base W.r_base K q_idx)
  base_disc_holo : ∀ ι,
    DifferentiableOn ℂ (Δ_base ι) (wallUnifiedDom W.s_base W.r_base K q_idx)
  base_lead_witness : ∀ ι : Fin 2,
    ∃ p ∈ wallUnifiedDom W.s_base W.r_base K q_idx, A_coeff ι (Fin.last (D_det ι)) p ≠ 0
  base_disc_witness : ∀ ι : Fin 2,
    ∃ p ∈ wallUnifiedDom W.s_base W.r_base K q_idx, Δ_base ι p ≠ 0
  base_primary_solves : ∀ ι : Fin 2,
    ∀ p ∈ wallUnifiedDom W.s_base W.r_base K q_idx,
      ∑ d : Fin (D_det ι + 1), A_coeff ι d p * (dualLineShift C 1 ι p) ^ (d : ℕ) = 0
  y₀ : ℝ
  r_y : ℝ
  r_t : ℝ
  t_end : ℝ
  m_t : ℕ
  H_tilde : ℂ × ℂ → ℂ
  r_y_pos : 0 < r_y
  r_t_pos : 0 < r_t
  t_end_pos : 0 < t_end
  t_end_lt : t_end < 3 * r_t / 4
  bidisk_sub_unified :
    Metric.ball (y₀ : ℂ) r_y ×ˢ Metric.ball (0 : ℂ) r_t ⊆
      wallUnifiedDom W.s_base W.r_base K q_idx
  H_tilde_holo :
    DifferentiableOn ℂ H_tilde (Metric.ball (y₀ : ℂ) r_y ×ˢ Metric.ball (0 : ℂ) r_t)
  H_tilde_ne_zero : ∀ p ∈ Metric.ball (y₀ : ℂ) r_y ×ˢ Metric.ball (0 : ℂ) r_t,
    H_tilde p ≠ 0
  H_base_factor : ∀ p ∈ Metric.ball (y₀ : ℂ) r_y ×ˢ Metric.ball (0 : ℂ) r_t,
    p.2 ^ m_t * H_tilde p =
      A_coeff 0 (Fin.last (D_det 0)) p * Δ_base 0 p *
        A_coeff 1 (Fin.last (D_det 1)) p * Δ_base 1 p
  separable_punc : ∀ ι : Fin 2,
    ∀ p ∈ Metric.ball (y₀ : ℂ) r_y ×ˢ (Metric.ball (0 : ℂ) r_t \ {0}),
      A_coeff ι (Fin.last (D_det ι)) p ≠ 0 ∧
      ∀ z : ℂ,
        ∑ d : Fin (D_det ι + 1), A_coeff ι d p * z ^ (d : ℕ) = 0 →
        ∑ d : Fin (D_det ι),
          (((d : ℕ) + 1 : ℕ) : ℂ) * A_coeff ι d.succ p * z ^ (d : ℕ) ≠ 0
  clear_pair : ∀ (U : Set (ℂ × ℂ)) (N₀ D₀ N_b D_b : Fin 2 → ℂ × ℂ → ℂ),
    IsOpen U →
    (∀ c : Fin 2, DifferentiableOn ℂ (N₀ c) U ∧ DifferentiableOn ℂ (D₀ c) U ∧
      DifferentiableOn ℂ (N_b c) U ∧ DifferentiableOn ℂ (D_b c) U) →
    ∃ (C_cl : ∀ ι : Fin 2, Fin (D_det ι + 1) → ℂ × ℂ → ℂ)
      (Δ_cl : Fin 2 → ℂ × ℂ → ℂ)
      (S_cl S_disc : Fin 2 → ℂ × ℂ → ℂ),
      (∀ ι d, DifferentiableOn ℂ (C_cl ι d) U) ∧
      (∀ ι, DifferentiableOn ℂ (Δ_cl ι) U) ∧
      (∀ ι, DifferentiableOn ℂ (S_cl ι) U ∧ DifferentiableOn ℂ (S_disc ι) U) ∧
      ∀ p ∈ U, (∀ c : Fin 2, D₀ c p ≠ 0 ∧ D_b c p ≠ 0) →
        ∀ ι : Fin 2,
          S_cl ι p ≠ 0 ∧ S_disc ι p ≠ 0 ∧
          (∀ d, C_cl ι d p = S_cl ι p *
            MvPolynomial.eval
              (lineJetEnv (M_det ι) (fun c q => N₀ c q / D₀ c q)
                (fun c q => N_b c q / D_b c q) p)
              (Q_det ι d)) ∧
          Δ_cl ι p = S_disc ι p *
            MvPolynomial.eval
              (lineJetEnv (M_det ι) (fun c q => N₀ c q / D₀ c q)
                (fun c q => N_b c q / D_b c q) p)
              (Disc_det ι)

noncomputable def wallAnchorPt (x_star H₂ ρ t₂ : ℝ) : ℂ × ℂ :=
  ((x_star : ℂ) + ((H₂ - ρ : ℝ) : ℂ) * Complex.I, (t₂ : ℂ))

noncomputable def wallAnchorField {Ω : Set Plane} {C : AnalyticGlancingCollar Ω}
    {hDet : EndpointDeterminationData C} (W : CollarWidthTubeData C hDet)
    (x_star H₂ ρ t₂ : ℝ) (q : ℤ) (c : Fin 2) (p : ℂ × ℂ) : ℂ :=
  let c_q := wallShiftPair q (wallAnchorPt x_star H₂ ρ t₂)
  (W.L_mero c).num c_q (wallShiftPair q p) /
    (W.L_mero c).den c_q (wallShiftPair q p)

structure WallLoopTopBranchData {Ω : Set Plane} {C : AnalyticGlancingCollar Ω}
    {hDet : EndpointDeterminationData C} (W : CollarWidthTubeData C hDet)
    (t₂ : ℝ) (D_wall : AlignedWallDefectData W t₂)
    {N_idx : ℕ} (q_idx : Fin N_idx → ℤ) where
  ρ : ℝ
  r_anchor : ℝ
  H_top_guard : ℂ × ℂ → ℂ
  M₁_top : Fin 2 → ℂ × ℂ → ℂ
  ρ_pos : 0 < ρ
  ρ_lt : ρ < W.s_base / 2
  r_anchor_pos : 0 < r_anchor
  anchor_in_chart : ∀ q ∈ wallAllShifts D_wall.K q_idx, ∀ c : Fin 2,
    let c_q := wallShiftPair q (wallAnchorPt D_wall.x_star D_wall.H₂ ρ t₂)
    c_q ∈ meroTubeENNR W.r_base W.h_L ∧
    ∀ p ∈ Metric.ball (wallAnchorPt D_wall.x_star D_wall.H₂ ρ t₂) r_anchor,
      wallShiftPair q p ∈ Metric.ball c_q ((W.L_mero c).rad c_q)
  guard_holo : DifferentiableOn ℂ H_top_guard
    (Metric.ball (wallAnchorPt D_wall.x_star D_wall.H₂ ρ t₂) r_anchor)
  guard_witness : ∃ p ∈ Metric.ball (wallAnchorPt D_wall.x_star D_wall.H₂ ρ t₂) r_anchor,
    H_top_guard p ≠ 0
  guard_den_ne_zero : ∀ p ∈ Metric.ball (wallAnchorPt D_wall.x_star D_wall.H₂ ρ t₂) r_anchor,
    H_top_guard p ≠ 0 →
    ∀ q ∈ wallAllShifts D_wall.K q_idx, ∀ c : Fin 2,
      (W.L_mero c).den (wallShiftPair q (wallAnchorPt D_wall.x_star D_wall.H₂ ρ t₂))
        (wallShiftPair q p) ≠ 0
  M₁_top_holo : ∀ ι : Fin 2,
    DifferentiableOn ℂ (M₁_top ι)
      (Metric.ball (wallAnchorPt D_wall.x_star D_wall.H₂ ρ t₂) r_anchor)
  M₁_top_ne_primary : ∃ ι_def : Fin 2,
    ∀ (V : Set (ℂ × ℂ)), IsOpen V → V.Nonempty →
      V ⊆ { p ∈ Metric.ball (wallAnchorPt D_wall.x_star D_wall.H₂ ρ t₂) r_anchor |
              H_top_guard p ≠ 0 } →
      ∃ p ∈ V, M₁_top ι_def p ≠
        wallAnchorField W D_wall.x_star D_wall.H₂ ρ t₂ 1 ι_def p
  loop_root_transfer : ∀ (M D : ℕ) (ι : Fin 2)
      (Q : Fin (D + 1) → MvPolynomial (LineJetVar M) ℂ),
    let Ω_anc := { p ∈ Metric.ball (wallAnchorPt D_wall.x_star D_wall.H₂ ρ t₂) r_anchor |
                     H_top_guard p ≠ 0 }
    let F_anc := wallAnchorField W D_wall.x_star D_wall.H₂ ρ t₂
    (∀ p ∈ Ω_anc,
      ∑ d : Fin (D + 1),
        MvPolynomial.eval (lineJetEnv M (F_anc 0) (F_anc (wallBridgeB D_wall.K : ℤ)) p) (Q d) *
          (F_anc 1 ι p) ^ (d : ℕ) = 0) →
    (∀ p ∈ Ω_anc,
      ∑ d : Fin (D + 1),
        MvPolynomial.eval (lineJetEnv M (F_anc 0) (F_anc (wallBridgeB D_wall.K : ℤ)) p) (Q d) *
          (M₁_top ι p) ^ (d : ℕ) = 0)
  loop_fwd_rank_one :
    let Ω_anc := { p ∈ Metric.ball (wallAnchorPt D_wall.x_star D_wall.H₂ ρ t₂) r_anchor |
                     H_top_guard p ≠ 0 }
    let F_anc := wallAnchorField W D_wall.x_star D_wall.H₂ ρ t₂
    (∀ p ∈ Ω_anc, homRankOneDet (homIntersect (F_anc 0) (F_anc 1)) p = 0) →
    (∀ p ∈ Ω_anc, homRankOneDet (homIntersect (F_anc 0) M₁_top) p = 0)
  loop_fwd_reflect :
    let Ω_anc := { p ∈ Metric.ball (wallAnchorPt D_wall.x_star D_wall.H₂ ρ t₂) r_anchor |
                     H_top_guard p ≠ 0 }
    let F_anc := wallAnchorField W D_wall.x_star D_wall.H₂ ρ t₂
    (∀ p ∈ Ω_anc, ∀ ι : Fin 2, homReflectRes (F_anc 0) (F_anc 1) ι p = 0) →
    (∀ p ∈ Ω_anc, ∀ ι : Fin 2, homReflectRes (F_anc 0) M₁_top ι p = 0)
  loop_rev_w2_zero :
    let Ω_anc := { p ∈ Metric.ball (wallAnchorPt D_wall.x_star D_wall.H₂ ρ t₂) r_anchor |
                     H_top_guard p ≠ 0 }
    let F_anc := wallAnchorField W D_wall.x_star D_wall.H₂ ρ t₂
    ∀ (V : Set (ℂ × ℂ)), IsOpen V → V.Nonempty → V ⊆ Ω_anc →
      (∀ p ∈ V, homIntersect (F_anc 0) M₁_top 2 p = 0) →
      ∀ p ∈ Ω_anc, homIntersect (F_anc 0) (F_anc 1) 2 p = 0
  loop_rev_iso_line : ∀ s_iso c_star : ℂ,
    let Ω_anc := { p ∈ Metric.ball (wallAnchorPt D_wall.x_star D_wall.H₂ ρ t₂) r_anchor |
                     H_top_guard p ≠ 0 }
    let F_anc := wallAnchorField W D_wall.x_star D_wall.H₂ ρ t₂
    ∀ (V : Set (ℂ × ℂ)), IsOpen V → V.Nonempty → V ⊆ Ω_anc →
      (∀ p ∈ V,
        homIntersect (F_anc 0) M₁_top 0 p +
          s_iso * Complex.I * homIntersect (F_anc 0) M₁_top 1 p -
          c_star * homIntersect (F_anc 0) M₁_top 2 p = 0) →
      ∀ p ∈ Ω_anc,
        homIntersect (F_anc 0) (F_anc 1) 0 p +
          s_iso * Complex.I * homIntersect (F_anc 0) (F_anc 1) 1 p -
          c_star * homIntersect (F_anc 0) (F_anc 1) 2 p = 0
  loop_rev_prev_eq :
    let Ω_anc := { p ∈ Metric.ball (wallAnchorPt D_wall.x_star D_wall.H₂ ρ t₂) r_anchor |
                     H_top_guard p ≠ 0 }
    let F_anc := wallAnchorField W D_wall.x_star D_wall.H₂ ρ t₂
    ∀ (V : Set (ℂ × ℂ)), IsOpen V → V.Nonempty → V ⊆ Ω_anc →
      (∀ p ∈ V,
        let W₁ := homIntersect (F_anc 0) M₁_top
        let W₀ := homIntersect (F_anc (-1)) (F_anc 0)
        W₁ 0 p * W₀ 2 p - W₀ 0 p * W₁ 2 p = 0 ∧
        W₁ 1 p * W₀ 2 p - W₀ 1 p * W₁ 2 p = 0) →
      ∀ p ∈ Ω_anc,
        let W₁ := homIntersect (F_anc 0) (F_anc 1)
        let W₀ := homIntersect (F_anc (-1)) (F_anc 0)
        W₁ 0 p * W₀ 2 p - W₀ 0 p * W₁ 2 p = 0 ∧
        W₁ 1 p * W₀ 2 p - W₀ 1 p * W₁ 2 p = 0
  loop_poly_transfer : ∀ (M D : ℕ) (ι_star : Fin 2)
      (P_coeff : Fin (D + 1) → MvPolynomial (SymJetVar N_idx M) ℂ),
    let Ω_anc := { p ∈ Metric.ball (wallAnchorPt D_wall.x_star D_wall.H₂ ρ t₂) r_anchor |
                     H_top_guard p ≠ 0 }
    let F_anc := wallAnchorField W D_wall.x_star D_wall.H₂ ρ t₂
    ∀ (V : Set (ℂ × ℂ)), IsOpen V → V.Nonempty → V ⊆ Ω_anc →
      ((∀ p ∈ Ω_anc,
          ∑ d : Fin (D + 1),
            MvPolynomial.eval (fieldSymJetEnv q_idx M F_anc p) (P_coeff d) *
              (F_anc 1 ι_star p) ^ (d : ℕ) = 0) ↔
        (∀ p ∈ V,
          ∑ d : Fin (D + 1),
            MvPolynomial.eval (fieldSymJetEnv q_idx M F_anc p) (P_coeff d) *
              (M₁_top ι_star p) ^ (d : ℕ) = 0))

structure VerticalChainDescentData {Ω : Set Plane} {C : AnalyticGlancingCollar Ω}
    {hDet : EndpointDeterminationData C} (W : CollarWidthTubeData C hDet)
    (t₂ H₂ x_star : ℝ) (K : ℕ) {N_idx : ℕ} (q_idx : Fin N_idx → ℤ)
    (E_base : EndpointClearingAndBidiskData W K q_idx)
    (ρ r_anchor : ℝ) (H_top_guard : ℂ × ℂ → ℂ) where
  primary_solves_at_anchor : ∀ ι : Fin 2,
    let Ω_anc := { p ∈ Metric.ball (wallAnchorPt x_star H₂ ρ t₂) r_anchor | H_top_guard p ≠ 0 }
    let F_anc := wallAnchorField W x_star H₂ ρ t₂
    ∀ p ∈ Ω_anc,
      ∑ d : Fin (E_base.D_det ι + 1),
        MvPolynomial.eval
          (lineJetEnv (E_base.M_det ι) (F_anc 0) (F_anc (wallBridgeB K : ℤ)) p)
          (E_base.Q_det ι d) *
        (F_anc 1 ι p) ^ (d : ℕ) = 0
  ascend_rank_one :
    let Ω_anc := { p ∈ Metric.ball (wallAnchorPt x_star H₂ ρ t₂) r_anchor | H_top_guard p ≠ 0 }
    let F_anc := wallAnchorField W x_star H₂ ρ t₂
    (∀ p ∈ wallUnifiedDom W.s_base W.r_base K q_idx,
      homRankOneDet (homIntersect (dualLineShift C 0) (dualLineShift C 1)) p = 0) →
    ∀ p ∈ Ω_anc, homRankOneDet (homIntersect (F_anc 0) (F_anc 1)) p = 0
  ascend_reflect :
    let Ω_anc := { p ∈ Metric.ball (wallAnchorPt x_star H₂ ρ t₂) r_anchor | H_top_guard p ≠ 0 }
    let F_anc := wallAnchorField W x_star H₂ ρ t₂
    (∀ p ∈ wallUnifiedDom W.s_base W.r_base K q_idx,
      ∀ ι : Fin 2, homReflectRes (dualLineShift C 0) (dualLineShift C 1) ι p = 0) →
    ∀ p ∈ Ω_anc, ∀ ι : Fin 2, homReflectRes (F_anc 0) (F_anc 1) ι p = 0
  descend_primary_w2_zero :
    let Ω_anc := { p ∈ Metric.ball (wallAnchorPt x_star H₂ ρ t₂) r_anchor | H_top_guard p ≠ 0 }
    let F_anc := wallAnchorField W x_star H₂ ρ t₂
    (∀ p ∈ Ω_anc, homIntersect (F_anc 0) (F_anc 1) 2 p = 0) →
    ∀ p ∈ wallUnifiedDom W.s_base W.r_base K q_idx,
      homIntersect (dualLineShift C 0) (dualLineShift C 1) 2 p = 0
  descend_primary_iso_line : ∀ s_iso c_star : ℂ,
    let Ω_anc := { p ∈ Metric.ball (wallAnchorPt x_star H₂ ρ t₂) r_anchor | H_top_guard p ≠ 0 }
    let F_anc := wallAnchorField W x_star H₂ ρ t₂
    (∀ p ∈ Ω_anc,
      homIntersect (F_anc 0) (F_anc 1) 0 p +
        s_iso * Complex.I * homIntersect (F_anc 0) (F_anc 1) 1 p -
        c_star * homIntersect (F_anc 0) (F_anc 1) 2 p = 0) →
    ∀ p ∈ wallUnifiedDom W.s_base W.r_base K q_idx,
      homIntersect (dualLineShift C 0) (dualLineShift C 1) 0 p +
        s_iso * Complex.I * homIntersect (dualLineShift C 0) (dualLineShift C 1) 1 p -
        c_star * homIntersect (dualLineShift C 0) (dualLineShift C 1) 2 p = 0
  descend_primary_prev_eq :
    let Ω_anc := { p ∈ Metric.ball (wallAnchorPt x_star H₂ ρ t₂) r_anchor | H_top_guard p ≠ 0 }
    let F_anc := wallAnchorField W x_star H₂ ρ t₂
    (∀ p ∈ Ω_anc,
      let W₁ := homIntersect (F_anc 0) (F_anc 1)
      let W₀ := homIntersect (F_anc (-1)) (F_anc 0)
      W₁ 0 p * W₀ 2 p - W₀ 0 p * W₁ 2 p = 0 ∧
      W₁ 1 p * W₀ 2 p - W₀ 1 p * W₁ 2 p = 0) →
    ∀ p ∈ wallUnifiedDom W.s_base W.r_base K q_idx,
      let W₁ := homIntersect (dualLineShift C 0) (dualLineShift C 1)
      let W₀ := homIntersect (dualLineShift C (-1)) (dualLineShift C 0)
      W₁ 0 p * W₀ 2 p - W₀ 0 p * W₁ 2 p = 0 ∧
      W₁ 1 p * W₀ 2 p - W₀ 1 p * W₁ 2 p = 0
  primary_poly_transfer : ∀ (M D : ℕ) (ι_star : Fin 2)
      (P_coeff : Fin (D + 1) → MvPolynomial (SymJetVar N_idx M) ℂ),
    let Ω_anc := { p ∈ Metric.ball (wallAnchorPt x_star H₂ ρ t₂) r_anchor | H_top_guard p ≠ 0 }
    let F_anc := wallAnchorField W x_star H₂ ρ t₂
    (∀ p ∈ wallUnifiedDom W.s_base W.r_base K q_idx,
      ∑ d : Fin (D + 1),
        MvPolynomial.eval (symJetEnv C q_idx M p) (P_coeff d) *
          (dualLineShift C 1 ι_star p) ^ (d : ℕ) = 0) ↔
    (∀ p ∈ Ω_anc,
      ∑ d : Fin (D + 1),
        MvPolynomial.eval (fieldSymJetEnv q_idx M F_anc p) (P_coeff d) *
          (F_anc 1 ι_star p) ^ (d : ℕ) = 0)
  descend_branch : ∀ (M_top : Fin 2 → ℂ × ℂ → ℂ),
    let Ω_anc := { p ∈ Metric.ball (wallAnchorPt x_star H₂ ρ t₂) r_anchor | H_top_guard p ≠ 0 }
    let F_anc := wallAnchorField W x_star H₂ ρ t₂
    (∀ ι : Fin 2, DifferentiableOn ℂ (M_top ι)
      (Metric.ball (wallAnchorPt x_star H₂ ρ t₂) r_anchor)) →
    (∀ ι : Fin 2, ∀ p ∈ Ω_anc,
      ∑ d : Fin (E_base.D_det ι + 1),
        MvPolynomial.eval
          (lineJetEnv (E_base.M_det ι) (F_anc 0) (F_anc (wallBridgeB K : ℤ)) p)
          (E_base.Q_det ι d) *
        (M_top ι p) ^ (d : ℕ) = 0) →
    (∃ ι_def : Fin 2, ∀ (V : Set (ℂ × ℂ)), IsOpen V → V.Nonempty → V ⊆ Ω_anc →
      ∃ p ∈ V, M_top ι_def p ≠ F_anc 1 ι_def p) →
    ∃ (V_init : Set (ℂ × ℂ)) (r_end : ℝ) (M₁_end : Fin 2 → ℂ × ℂ → ℂ),
      IsOpen V_init ∧ V_init.Nonempty ∧ V_init ⊆ Ω_anc ∧
      0 < r_end ∧
      Metric.ball ((E_base.y₀ : ℂ), (E_base.t_end : ℂ)) r_end ⊆
        Metric.ball (E_base.y₀ : ℂ) (3 * E_base.r_y / 4) ×ˢ
          { t : ℂ | 0 < ‖t‖ ∧ ‖t‖ < 3 * E_base.r_t / 4 } ∧
      (∀ ι : Fin 2, DifferentiableOn ℂ (M₁_end ι)
        (Metric.ball ((E_base.y₀ : ℂ), (E_base.t_end : ℂ)) r_end)) ∧
      (∀ ι : Fin 2, ∀ p ∈ Metric.ball ((E_base.y₀ : ℂ), (E_base.t_end : ℂ)) r_end,
        ∑ d : Fin (E_base.D_det ι + 1), E_base.A_coeff ι d p * (M₁_end ι p) ^ (d : ℕ) = 0) ∧
      (∃ ι_def : Fin 2, ∃ p ∈ Metric.ball ((E_base.y₀ : ℂ), (E_base.t_end : ℂ)) r_end,
        M₁_end ι_def p ≠ dualLineShift C 1 ι_def p) ∧
      ((∀ p ∈ Ω_anc, homRankOneDet (homIntersect (F_anc 0) M_top) p = 0) →
        ∀ p ∈ Metric.ball ((E_base.y₀ : ℂ), (E_base.t_end : ℂ)) r_end,
          homRankOneDet (homIntersect (dualLineShift C 0) M₁_end) p = 0) ∧
      ((∀ p ∈ Ω_anc, ∀ ι : Fin 2, homReflectRes (F_anc 0) M_top ι p = 0) →
        ∀ p ∈ Metric.ball ((E_base.y₀ : ℂ), (E_base.t_end : ℂ)) r_end,
          ∀ ι : Fin 2, homReflectRes (dualLineShift C 0) M₁_end ι p = 0) ∧
      ((∀ p ∈ Metric.ball ((E_base.y₀ : ℂ), (E_base.t_end : ℂ)) r_end,
          homIntersect (dualLineShift C 0) M₁_end 2 p = 0) →
        ∀ p ∈ V_init, homIntersect (F_anc 0) M_top 2 p = 0) ∧
      (∀ s_iso c_star : ℂ,
        (∀ p ∈ Metric.ball ((E_base.y₀ : ℂ), (E_base.t_end : ℂ)) r_end,
          homIntersect (dualLineShift C 0) M₁_end 0 p +
            s_iso * Complex.I * homIntersect (dualLineShift C 0) M₁_end 1 p -
            c_star * homIntersect (dualLineShift C 0) M₁_end 2 p = 0) →
        ∀ p ∈ V_init,
          homIntersect (F_anc 0) M_top 0 p +
            s_iso * Complex.I * homIntersect (F_anc 0) M_top 1 p -
            c_star * homIntersect (F_anc 0) M_top 2 p = 0) ∧
      ((∀ p ∈ Metric.ball ((E_base.y₀ : ℂ), (E_base.t_end : ℂ)) r_end,
          let W₁ := homIntersect (dualLineShift C 0) M₁_end
          let W₀ := homIntersect (dualLineShift C (-1)) (dualLineShift C 0)
          W₁ 0 p * W₀ 2 p - W₀ 0 p * W₁ 2 p = 0 ∧
          W₁ 1 p * W₀ 2 p - W₀ 1 p * W₁ 2 p = 0) →
        ∀ p ∈ V_init,
          let W₁ := homIntersect (F_anc 0) M_top
          let W₀ := homIntersect (F_anc (-1)) (F_anc 0)
          W₁ 0 p * W₀ 2 p - W₀ 0 p * W₁ 2 p = 0 ∧
          W₁ 1 p * W₀ 2 p - W₀ 1 p * W₁ 2 p = 0) ∧
      (∀ (M D : ℕ) (ι_star : Fin 2)
          (P_coeff : Fin (D + 1) → MvPolynomial (SymJetVar N_idx M) ℂ),
        (∀ p ∈ V_init,
          ∑ d : Fin (D + 1),
            MvPolynomial.eval (fieldSymJetEnv q_idx M F_anc p) (P_coeff d) *
              (M_top ι_star p) ^ (d : ℕ) = 0) ↔
        (∀ p ∈ Metric.ball ((E_base.y₀ : ℂ), (E_base.t_end : ℂ)) r_end,
          ∑ d : Fin (D + 1),
            MvPolynomial.eval (symJetEnv C q_idx M p) (P_coeff d) *
              (M₁_end ι_star p) ^ (d : ℕ) = 0))
def RefSteepContinuationProp : Prop :=
  ∀ (X : ExpStripData), IsOpen X.D_strip →
  ∀ (P : ChordActionPackage X) (α γ_steep : ℝ),
    1 / 2 < α → α < 1 → 0 < γ_steep → γ_steep < 1 / 4 →
    ∃ (C_st η_st : ℝ), 1 ≤ C_st ∧ 0 < η_st ∧ η_st < 1 / 16 ∧
      ∀ (x₀ h_ref m_steep d δ_ceil Δ_slab r M_scale C_init : ℝ)
        (s_init : ℂ × ℂ → ℂ),
        0 < m_steep → 0 < d → 0 < Δ_slab → 2 * Δ_slab ≤ δ_ceil →
        4 * d ≤ δ_ceil - Δ_slab → 0 < r → 0 < M_scale → 0 ≤ C_init →
        12 * r * (δ_ceil / d) ^ α ≤ Δ_slab / 16 →
        r / d ≤ η_st →
        r * d ^ (-α) * M_scale ≤ η_st →
        C_init * (1 + 8 * δ_ceil / (γ_steep * Δ_slab)) ≤
          M_scale ^ 2 * δ_ceil ^ (1 - 2 * α) →
        (let L_in : ℝ := 2 * m_steep + 2 / γ_steep + 4
         let S_init : Set (ℂ × ℂ) :=
           { p : ℂ × ℂ |
             δ_ceil - Δ_slab < h_ref - p.1.im ∧ h_ref - p.1.im < δ_ceil ∧
             |p.1.re - x₀| < L_in * (h_ref - p.1.im) ∧
             ‖p.2‖ < 12 * r * (δ_ceil / d) ^ α }
         let W_steep : Set (ℂ × ℂ) :=
           { p : ℂ × ℂ |
             d / 2 < h_ref - p.1.im ∧ h_ref - p.1.im < δ_ceil - Δ_slab / 4 ∧
             |p.1.re - x₀| < m_steep * (h_ref - p.1.im) ∧
             ‖p.2‖ < 10 * r * ((h_ref - p.1.im) / d) ^ α ∧
             γ_steep * ‖p.2‖ < |p.2.im| }
         (∀ s : ℂ, d / 10 ≤ h_ref - s.im → h_ref - s.im ≤ (5 / 4) * δ_ceil →
           |s.re - x₀| ≤ L_in * (h_ref - s.im) →
           s ∈ X.D_strip ∧
           ‖X.f s‖ ≤ M_scale * (h_ref - s.im) ^ (-α) ∧
           Real.sqrt ‖X.q s‖ ≤ M_scale * (h_ref - s.im) ^ (-α)) →
         DifferentiableOn ℂ s_init S_init →
         (∀ y t : ℂ, (y, t) ∈ S_init →
           s_init (y, -t) = s_init (y, t) ∧
           ‖s_init (y, t) - y‖ ≤ C_init * ‖t‖ ^ 2) →
         (∀ y : ℂ, (y, (0 : ℂ)) ∈ S_init → s_init (y, 0) = y) →
         (∀ y t : ℂ, t ≠ 0 →
           (y - t, t) ∈ S_init → (y, t) ∈ S_init → (y + t, t) ∈ S_init →
           let s_prev := s_init (y - t, t)
           let s_curr := s_init (y, t)
           let s_next := s_init (y + t, t)
           let J_prev := (s_curr - s_prev) / t
           let J_curr := (s_next - s_curr) / t
           deriv (fun J' => P.p_act s_curr J' t) J_curr -
             t * deriv (fun s' => P.p_act s' J_curr t) s_curr =
             deriv (fun J' => P.p_act s_prev J' t) J_prev) →
         ∃ s_steep : ℂ × ℂ → ℂ,
           DifferentiableOn ℂ s_steep W_steep ∧
           (∀ p ∈ W_steep, s_steep p ∈ X.D_strip) ∧
           (∀ y t : ℂ, (y, t) ∈ W_steep →
             s_steep (y, -t) = s_steep (y, t) ∧
             ‖s_steep (y, t) - y‖ ≤
               C_st * ‖t‖ ^ 2 * M_scale ^ 2 * (h_ref - y.im) ^ (1 - 2 * α)) ∧
           (∀ y t : ℂ, (y, t) ∈ W_steep →
             δ_ceil - (3 / 4) * Δ_slab < h_ref - y.im →
             s_steep (y, t) = s_init (y, t)) ∧
           (∀ y t : ℂ, γ_steep * ‖t‖ < t.im →
             (y - t, t) ∈ W_steep → (y, t) ∈ W_steep → (y + t, t) ∈ W_steep →
             let s_prev := s_steep (y - t, t)
             let s_curr := s_steep (y, t)
             let s_next := s_steep (y + t, t)
             let J_prev := (s_curr - s_prev) / t
             let J_curr := (s_next - s_curr) / t
             deriv (fun J' => P.p_act s_curr J' t) J_curr -
               t * deriv (fun s' => P.p_act s' J_curr t) s_curr =
               deriv (fun J' => P.p_act s_prev J' t) J_prev))

def SchwarzPoissonBumpProp : Prop :=
  ∀ (M_dip η_plus γ₀ : ℝ),
    0 < M_dip → 0 < η_plus → 0 < γ₀ → γ₀ < 1 / 8 →
    ∃ (C_bump C_err γ_steep : ℝ),
      0 < C_bump ∧ 0 < C_err ∧ 0 < γ_steep ∧ γ_steep < γ₀ ∧
      ∀ (c : ℂ) (r : ℝ), ‖c‖ < 1 / 3 → 1 / 2 ≤ r → r < 1 →
        ∃ g : ℂ → ℂ,
          DifferentiableOn ℂ g (Metric.ball (0 : ℂ) (1 / r)) ∧
          g 0 = 0 ∧
          (∀ ζ ∈ Metric.closedBall (0 : ℂ) 1,
            ‖g ζ‖ ≤ C_bump ∧ -M_dip ≤ (g ζ).im ∧ (g ζ).im ≤ η_plus) ∧
          (∀ ζ ∈ Metric.sphere (0 : ℂ) 1,
            |(c + ζ).im| ≤ (6 / 5) * γ_steep * ‖c + ζ‖ →
            0 ≤ M_dip + (g ζ).im ∧ M_dip + (g ζ).im ≤ C_err * (1 - r))

def RefDyadicConeFillingProp : Prop :=
  ∀ α : ℝ, 1 / 2 < α → α < 1 →
    ∃ (D_dip C_bump M_ceil γ_dyad : ℝ),
      2 ≤ D_dip ∧ 0 < C_bump ∧ 8 < M_ceil ∧ 0 < γ_dyad ∧ γ_dyad < 1 / 8 ∧
      ∀ (X : ExpStripData), IsOpen X.D_strip → Convex ℝ X.D_strip →
      ∀ (x₀ h_ref m₀ d δ₀ r M_scale C_st A₀ : ℝ)
        (s_band₀ s_steep : ℂ × ℂ → ℂ),
        0 < m₀ → 0 < d → d < δ₀ → 0 < r → 0 < M_scale → 0 < C_st → 0 ≤ A₀ →
        (let m_aux : ℝ := max m₀ ((C_bump + 4) / (D_dip - 1))
         let m_steep : ℝ := 2 * (m_aux + C_bump + 2)
         let A_ind : ℝ := max A₀ (2 ^ (2 * α - 1) * C_st)
         let Ω_init : Set (ℂ × ℂ) :=
           { p : ℂ × ℂ |
             δ₀ < h_ref - p.1.im ∧ h_ref - p.1.im < M_ceil * δ₀ ∧
             |p.1.re - x₀| < m_aux * (h_ref - p.1.im) ∧
             ‖p.2‖ < r * ((h_ref - p.1.im) / d) ^ α }
         let W_steep : Set (ℂ × ℂ) :=
           { p : ℂ × ℂ |
             d / 2 < h_ref - p.1.im ∧ h_ref - p.1.im < M_ceil * δ₀ ∧
             |p.1.re - x₀| < m_steep * (h_ref - p.1.im) ∧
             ‖p.2‖ < 10 * r * ((h_ref - p.1.im) / d) ^ α ∧
             γ_dyad * ‖p.2‖ < |p.2.im| }
         let Ω_out : Set (ℂ × ℂ) :=
           { p : ℂ × ℂ |
             d < h_ref - p.1.im ∧ h_ref - p.1.im < 2 * δ₀ ∧
             |p.1.re - x₀| < m₀ * (h_ref - p.1.im) ∧
             ‖p.2‖ < r * ((h_ref - p.1.im) / d) ^ α }
         DifferentiableOn ℂ s_band₀ Ω_init →
         (∀ y t : ℂ, (y, t) ∈ Ω_init →
           s_band₀ (y, -t) = s_band₀ (y, t) ∧
           ‖s_band₀ (y, t) - y‖ ≤
             A₀ * ‖t‖ ^ 2 * M_scale ^ 2 * (h_ref - y.im) ^ (1 - 2 * α)) →
         (∀ y : ℂ, (y, (0 : ℂ)) ∈ Ω_init → s_band₀ (y, 0) = y) →
         DifferentiableOn ℂ s_steep W_steep →
         (∀ y t : ℂ, (y, t) ∈ W_steep →
           s_steep (y, -t) = s_steep (y, t) ∧
           ‖s_steep (y, t) - y‖ ≤
             C_st * ‖t‖ ^ 2 * M_scale ^ 2 * (h_ref - y.im) ^ (1 - 2 * α)) →
         (∀ p ∈ Ω_init ∩ W_steep, s_band₀ p = s_steep p) →
         (∀ y : ℂ, d < h_ref - y.im → h_ref - y.im < 2 * δ₀ →
           |y.re - x₀| < m₀ * (h_ref - y.im) →
           Metric.ball y
             (2 * A_ind * r ^ 2 * d ^ (-2 * α) * M_scale ^ 2 * (h_ref - y.im)) ⊆
             X.D_strip) →
         ∃ s_cone : ℂ × ℂ → ℂ,
           DifferentiableOn ℂ s_cone Ω_out ∧
           (∀ p ∈ Ω_out, s_cone p ∈ X.D_strip) ∧
           (∀ y t : ℂ, (y, t) ∈ Ω_out →
             s_cone (y, -t) = s_cone (y, t) ∧
             ‖s_cone (y, t) - y‖ ≤
               A_ind * ‖t‖ ^ 2 * M_scale ^ 2 * (h_ref - y.im) ^ (1 - 2 * α)) ∧
           (∀ y : ℂ, (y, (0 : ℂ)) ∈ Ω_out → s_cone (y, 0) = y) ∧
           (∀ p ∈ Ω_out ∩ Ω_init, s_cone p = s_band₀ p) ∧
           (∀ p ∈ Ω_out ∩ W_steep, s_cone p = s_steep p))

def DeepPassageAnchorData (X : ExpStripData) (P : ChordActionPackage X)
    (kind : ExpProfileKind) (seq : ExpSequenceData X kind) : Prop :=
  ∀ T_max : ℝ, 0 < T_max →
    ∃ (D_anc C_anc α : ℝ),
      0 < D_anc ∧ 0 < C_anc ∧ 1 / 2 < α ∧ α < 1 ∧
      ∀ A D_top : ℝ, 0 < A → D_anc + 2 < D_top →
        ∃ (N_init : ℕ) (U_phys : ℕ → Set (ℂ × ℂ))
          (s_tilde : ℕ → ℂ × ℂ → ℂ) (δ_base : ℕ → ℝ),
          ∀ n ≥ N_init,
            let s_n : ℂ := (seq.x_seq n : ℂ) + (seq.h_seq n : ℂ) * Complex.I
            let coneSet : Set (ℂ × ℂ) :=
              { p : ℂ × ℂ |
                D_anc < -p.1.im ∧ -p.1.im < D_top ∧
                |p.1.re| < A * (-p.1.im) ∧ ‖p.2‖ < T_max }
            IsOpen (U_phys n) ∧
            0 < δ_base n ∧
            (∀ y t : ℂ, (y, t) ∈ U_phys n → 0 ≤ y.im →
              ∀ τ : ℝ, 0 ≤ τ → τ ≤ y.im →
                ((y.re : ℂ) + (τ : ℂ) * Complex.I, t) ∈ U_phys n) ∧
            (∀ y t : ℂ, (y, t) ∈ U_phys n → (y, -t) ∈ U_phys n) ∧
            DifferentiableOn ℂ (s_tilde n) (U_phys n) ∧
            (∀ p ∈ U_phys n, s_tilde n p ∈ X.D_strip) ∧
            (∀ y t : ℂ, (y, t) ∈ U_phys n → s_tilde n (y, -t) = s_tilde n (y, t)) ∧
            (∀ y t : ℂ, |y.im| < δ_base n → ‖t‖ < T_max / seq.m_seq n →
              (y, t) ∈ U_phys n ∧ (y, t) ∈ X.Tube ∧ s_tilde n (y, t) = X.𝔰 (y, t)) ∧
            (∀ y : ℂ, (s_n + (seq.ℓ_seq n : ℂ) * y, (0 : ℂ)) ∈ U_phys n →
              D_anc < -y.im → -y.im < D_top → |y.re| < A * (-y.im) →
              s_tilde n (s_n + (seq.ℓ_seq n : ℂ) * y, 0) =
                s_n + (seq.ℓ_seq n : ℂ) * y) ∧
            (∀ p ∈ coneSet,
              (s_n + (seq.ℓ_seq n : ℂ) * p.1, p.2 / (seq.m_seq n : ℂ)) ∈ U_phys n ∧
              0 < (s_n + (seq.ℓ_seq n : ℂ) * p.1).im ∧
              ‖(s_tilde n (s_n + (seq.ℓ_seq n : ℂ) * p.1, p.2 / (seq.m_seq n : ℂ)) - s_n) /
                  (seq.ℓ_seq n : ℂ) - p.1‖ ≤
                C_anc * ‖p.2‖ ^ 2 * (-p.1.im) ^ (1 - 2 * α)) ∧
            (∀ Y T : ℂ, T ≠ 0 →
              (Y, T) ∈ coneSet →
              (Y - T / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ), T) ∈ coneSet →
              (Y + T / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ), T) ∈ coneSet →
              let t : ℂ := T / (seq.m_seq n : ℂ)
              let y : ℂ := s_n + (seq.ℓ_seq n : ℂ) * Y
              let s_prev : ℂ := s_tilde n (y - t, t)
              let s_curr : ℂ := s_tilde n (y, t)
              let s_next : ℂ := s_tilde n (y + t, t)
              let J_prev : ℂ := (s_curr - s_prev) / t
              let J_curr : ℂ := (s_next - s_curr) / t
              deriv (fun J' => P.p_act s_curr J' t) J_curr -
                t * deriv (fun s' => P.p_act s' J_curr t) s_curr =
                deriv (fun J' => P.p_act s_prev J' t) J_prev)
noncomputable def sgaRealArcMinusChord (S : FiniteWallNonisotropicStrip) (u v : ℝ) : ℝ :=
  (∫ ξ in u..v, S.c / (S.f (ξ : ℂ)).re ^ 2) -
    Real.sqrt (((S.Γ (v : ℂ) 0).re - (S.Γ (u : ℂ) 0).re) ^ 2 +
      ((S.Γ (v : ℂ) 1).re - (S.Γ (u : ℂ) 1).re) ^ 2)
noncomputable def ssbpcBaseJetEnv {Ω : Set Plane} (C : AnalyticGlancingCollar Ω)
    (M k : ℕ) (is_point : Bool) (q : ℂ × ℂ) : PointJetVar M → ℂ :=
  pointJetEnv M
    (fun i r => bandBaseEndpointFn C is_point r.1 r.2 i)
    (fun i r => bandBaseEndpointFn C is_point (r.1 + (k : ℂ) * r.2) r.2 i)
    C.A q

structure SsbpcBaseDetPkg {Ω : Set Plane} (C : AnalyticGlancingCollar Ω)
    (s_base x_c s_minus t₁ r₁ ε : ℝ) (k : ℕ) (is_point : Bool) (ι : Fin 2) where
  M : ℕ
  D : ℕ
  D_pos : 1 ≤ D
  Q : Fin (D + 1) → MvPolynomial (PointJetVar M) ℂ
  Disc : MvPolynomial (PointJetVar M) ℂ
  base_left_holo : ∀ i : Fin 2,
    DifferentiableOn ℂ (fun q => bandBaseEndpointFn C is_point q.1 q.2 i)
      (bandShearedBaseBox s_base x_c s_minus t₁ r₁ ε)
  base_right_holo : ∀ i : Fin 2,
    DifferentiableOn ℂ
      (fun q => bandBaseEndpointFn C is_point (q.1 + (k : ℂ) * q.2) q.2 i)
      (bandShearedBaseBox s_base x_c s_minus t₁ r₁ ε)
  base_solves : ∀ p : ℂ × ℂ,
    (p.1 + (s_minus : ℂ) * p.2, p.2) ∈ bandShearedBaseBox s_base x_c s_minus t₁ r₁ ε →
    ∑ d : Fin (D + 1),
      MvPolynomial.eval
        (ssbpcBaseJetEnv C M k is_point (p.1 + (s_minus : ℂ) * p.2, p.2))
        (Q d) *
      (glancingDualLine C p.1 p.2 ι) ^ (d : ℕ) = 0
  lead_ne_zero_on_base : ∀ V₀ : Set (ℂ × ℂ),
    IsOpen V₀ → V₀.Nonempty →
    V₀ ⊆ bandShearedBaseBox s_base x_c s_minus t₁ r₁ ε →
    ∃ q ∈ V₀, MvPolynomial.eval (ssbpcBaseJetEnv C M k is_point q) (Q (Fin.last D)) ≠ 0
  disc_ne_zero_on_base : ∀ V₀ : Set (ℂ × ℂ),
    IsOpen V₀ → V₀.Nonempty →
    V₀ ⊆ bandShearedBaseBox s_base x_c s_minus t₁ r₁ ε →
    ∃ q ∈ V₀, MvPolynomial.eval (ssbpcBaseJetEnv C M k is_point q) Disc ≠ 0
  univ_separable : ∀ (env : PointJetVar M → ℂ) (z : ℂ),
    MvPolynomial.eval env (Q (Fin.last D)) ≠ 0 →
    MvPolynomial.eval env Disc ≠ 0 →
    ∑ d : Fin (D + 1), MvPolynomial.eval env (Q d) * z ^ (d : ℕ) = 0 →
    ∑ d : Fin D,
      (((d : ℕ) + 1 : ℕ) : ℂ) * MvPolynomial.eval env (Q d.succ) * z ^ (d : ℕ) ≠ 0

noncomputable def ssbpcQuotNumY (D : ℂ × ℂ → ℂ) : ℕ → (ℂ × ℂ → ℂ) → (ℂ × ℂ → ℂ)
  | 0, N => N
  | m + 1, N => fun q =>
      pderivA (ssbpcQuotNumY D m N) q * D q -
        ((m + 1 : ℕ) : ℂ) * ssbpcQuotNumY D m N q * pderivA D q

noncomputable def ssbpcQuotNumYT (D : ℂ × ℂ → ℂ) (a : ℕ) : ℕ → (ℂ × ℂ → ℂ) → (ℂ × ℂ → ℂ)
  | 0, N => ssbpcQuotNumY D a N
  | m + 1, N => fun q =>
      pderivD (ssbpcQuotNumYT D a m N) q * D q -
        ((a + m + 1 : ℕ) : ℂ) * ssbpcQuotNumYT D a m N q * pderivD D q

noncomputable def ssbpcPolyDeg {σ : Type} [Fintype σ] (P : MvPolynomial σ ℂ) : ℕ :=
  P.support.sup (fun m => ∑ v : σ, m v)

noncomputable def ssbpcHomogEval {σ : Type} [Fintype σ] (R : ℕ) (P : MvPolynomial σ ℂ)
    (M_num : σ → ℂ) (D_den : ℂ) : ℂ :=
  ∑ m ∈ P.support,
    P.coeff m * (∏ v : σ, (M_num v) ^ (m v)) * D_den ^ (R - ∑ v : σ, m v)

noncomputable def ssbpcPairChartRad {Ω_dom : Set (ℂ × ℂ)}
    (E₀ E₁ : Fin 2 → MeroOn2D Ω_dom) (p : ℂ × ℂ) : ℝ :=
  min (min ((E₀ 0).rad p) ((E₀ 1).rad p)) (min ((E₁ 0).rad p) ((E₁ 1).rad p))

noncomputable def ssbpcPairNum {Ω_dom : Set (ℂ × ℂ)}
    (E₀ E₁ : Fin 2 → MeroOn2D Ω_dom) (p q : ℂ × ℂ) (ci : Fin 2 × Fin 2) : ℂ :=
  if ci.1 = 0 then (E₀ ci.2).num p q else (E₁ ci.2).num p q

noncomputable def ssbpcPairDen {Ω_dom : Set (ℂ × ℂ)}
    (E₀ E₁ : Fin 2 → MeroOn2D Ω_dom) (p q : ℂ × ℂ) (ci : Fin 2 × Fin 2) : ℂ :=
  if ci.1 = 0 then (E₀ ci.2).den p q else (E₁ ci.2).den p q

noncomputable def ssbpcPairDenProd {Ω_dom : Set (ℂ × ℂ)}
    (E₀ E₁ : Fin 2 → MeroOn2D Ω_dom) (p q : ℂ × ℂ) : ℂ :=
  ∏ ci : Fin 2 × Fin 2, ssbpcPairDen E₀ E₁ p q ci

noncomputable def ssbpcClearedJetEnv {Ω_dom : Set (ℂ × ℂ)} (M : ℕ)
    (E₀ E₁ : Fin 2 → MeroOn2D Ω_dom) (A : ℂ → ℂ) (p q : ℂ × ℂ) : PointJetVar M → ℂ
  | Sum.inl v =>
      let ci : Fin 2 × Fin 2 := (v.1, v.2.1)
      ssbpcQuotNumYT (fun r => ssbpcPairDen E₀ E₁ p r ci) v.2.2.1.1 v.2.2.2.1
          (fun r => ssbpcPairNum E₀ E₁ p r ci) q *
        (ssbpcPairDen E₀ E₁ p q ci) ^ ((2 * M + 1) - (v.2.2.1.1 + v.2.2.2.1 + 1)) *
        ∏ cj ∈ Finset.univ.erase ci, (ssbpcPairDen E₀ E₁ p q cj) ^ (2 * M + 1)
  | Sum.inr β =>
      iterDeriv1D β.1 A q.2 * (ssbpcPairDenProd E₀ E₁ p q) ^ (2 * M + 1)

noncomputable def ssbpcClearedPoly {Ω_dom : Set (ℂ × ℂ)} (M R : ℕ)
    (P : MvPolynomial (PointJetVar M) ℂ) (E₀ E₁ : Fin 2 → MeroOn2D Ω_dom)
    (A : ℂ → ℂ) (p q : ℂ × ℂ) : ℂ :=
  ssbpcHomogEval R P (ssbpcClearedJetEnv M E₀ E₁ A p q)
    ((ssbpcPairDenProd E₀ E₁ p q) ^ (2 * M + 1))

structure SsbpcMeroJetClearedProp {Ω_dom : Set (ℂ × ℂ)} (B_base : Set (ℂ × ℂ))
    (E₀ E₁ : Fin 2 → MeroOn2D Ω_dom) (g₀ g₁ : Fin 2 → ℂ × ℂ → ℂ)
    (A : ℂ → ℂ) : Prop where
  rad_pos : ∀ p ∈ Ω_dom, 0 < ssbpcPairChartRad E₀ E₁ p ∧
    Metric.ball p (ssbpcPairChartRad E₀ E₁ p) ⊆ Ω_dom
  denProd_holo : ∀ p ∈ Ω_dom,
    DifferentiableOn ℂ (ssbpcPairDenProd E₀ E₁ p)
      (Metric.ball p (ssbpcPairChartRad E₀ E₁ p))
  denProd_ne_zero : ∀ p ∈ Ω_dom, ∀ V : Set (ℂ × ℂ),
    IsOpen V → V.Nonempty → V ⊆ Metric.ball p (ssbpcPairChartRad E₀ E₁ p) →
    ∃ q ∈ V, ssbpcPairDenProd E₀ E₁ p q ≠ 0
  cleared_holo : ∀ (M R : ℕ) (P : MvPolynomial (PointJetVar M) ℂ),
    ∀ p ∈ Ω_dom,
      DifferentiableOn ℂ (ssbpcClearedPoly M R P E₀ E₁ A p)
        (Metric.ball p (ssbpcPairChartRad E₀ E₁ p))
  eval_at_reg : ∀ (M R : ℕ) (P : MvPolynomial (PointJetVar M) ℂ),
    ssbpcPolyDeg P ≤ R →
    ∀ p ∈ Ω_dom, ∀ q ∈ Metric.ball p (ssbpcPairChartRad E₀ E₁ p),
      ssbpcPairDenProd E₀ E₁ p q ≠ 0 →
      let D_com := (ssbpcPairDenProd E₀ E₁ p q) ^ (2 * M + 1)
      let env : PointJetVar M → ℂ := fun v => ssbpcClearedJetEnv M E₀ E₁ A p q v / D_com
      ssbpcClearedPoly M R P E₀ E₁ A p q = D_com ^ R * MvPolynomial.eval env P
  chart_compat : ∀ (M R : ℕ) (P : MvPolynomial (PointJetVar M) ℂ),
    ssbpcPolyDeg P ≤ R →
    ∀ p₁ ∈ Ω_dom, ∀ p₂ ∈ Ω_dom,
      ∀ q ∈ Metric.ball p₁ (ssbpcPairChartRad E₀ E₁ p₁) ∩
          Metric.ball p₂ (ssbpcPairChartRad E₀ E₁ p₂),
        ssbpcClearedPoly M R P E₀ E₁ A p₁ q *
          ((ssbpcPairDenProd E₀ E₁ p₂ q) ^ (2 * M + 1)) ^ R =
        ssbpcClearedPoly M R P E₀ E₁ A p₂ q *
          ((ssbpcPairDenProd E₀ E₁ p₁ q) ^ (2 * M + 1)) ^ R
  agrees_on_base : ∀ (M R : ℕ) (P : MvPolynomial (PointJetVar M) ℂ),
    ssbpcPolyDeg P ≤ R →
    ∀ p ∈ B_base, ∃ r_ag : ℝ,
      0 < r_ag ∧ r_ag ≤ ssbpcPairChartRad E₀ E₁ p ∧ Metric.ball p r_ag ⊆ B_base ∧
      ∀ q ∈ Metric.ball p r_ag,
        ssbpcClearedPoly M R P E₀ E₁ A p q =
          MvPolynomial.eval (pointJetEnv M g₀ g₁ A q) P *
            ((ssbpcPairDenProd E₀ E₁ p q) ^ (2 * M + 1)) ^ R
  cleared_ne_zero_of_base : ∀ (M R : ℕ) (P : MvPolynomial (PointJetVar M) ℂ),
    ssbpcPolyDeg P ≤ R →
    (∀ V₀ : Set (ℂ × ℂ), IsOpen V₀ → V₀.Nonempty → V₀ ⊆ B_base →
      ∃ q ∈ V₀, MvPolynomial.eval (pointJetEnv M g₀ g₁ A q) P ≠ 0) →
    ∀ p ∈ Ω_dom, ∀ V : Set (ℂ × ℂ),
      IsOpen V → V.Nonempty → V ⊆ Metric.ball p (ssbpcPairChartRad E₀ E₁ p) →
      ∃ q ∈ V, ssbpcClearedPoly M R P E₀ E₁ A p q ≠ 0

structure SsbpcBandChartBidiskCover (s_base H₁ ε t₁ r₁ : ℝ) (N_slab : ℕ)
    (x_c s_minus : Fin N_slab → ℝ)
    (r_chart : Fin N_slab → ℂ × ℂ → ℝ) where
  N_cov : ℕ
  α_of : Fin N_cov → Fin N_slab
  y_c : Fin N_cov → ℂ
  τ_c : Fin N_cov → ℂ
  ρ : Fin N_cov → ℝ
  ρ_pos : ∀ β : Fin N_cov, 0 < ρ β ∧
    Metric.ball (τ_c β) (ρ β) ⊆ Metric.ball (t₁ : ℂ) r₁
  covers_band : ∀ (x y_im : ℝ) (t : ℂ),
    x ∈ Set.Icc (0 : ℝ) (2 * Real.pi) →
    y_im ∈ Set.Icc (H₁ - ε / 16) (H₁ + ε / 16) →
    t ∈ Metric.closedBall (t₁ : ℂ) (r₁ / 2) →
    ∃ β : Fin N_cov,
      ((x : ℂ) + (y_im : ℂ) * Complex.I) ∈ Metric.ball (y_c β) (3 * ρ β / 4) ∧
      t ∈ Metric.ball (τ_c β) (3 * ρ β / 4)
  center_in_sheared : ∀ β : Fin N_cov,
    ((y_c β) + (s_minus (α_of β) : ℂ) * (τ_c β), τ_c β) ∈
      bandShearedSlab s_base H₁ ε (x_c (α_of β)) (s_minus (α_of β)) t₁ r₁
  bidisk_in_unsheared : ∀ β : Fin N_cov,
    Metric.ball (y_c β) (ρ β) ×ˢ Metric.ball (τ_c β) (ρ β) ⊆
      bandUnshearedSlab s_base H₁ ε (x_c (α_of β)) t₁ r₁
  sheared_in_chart_ball : ∀ β : Fin N_cov,
    let p_sh := ((y_c β) + (s_minus (α_of β) : ℂ) * (τ_c β), τ_c β)
    ∀ q ∈ Metric.ball (y_c β) (ρ β) ×ˢ Metric.ball (τ_c β) (ρ β),
      (q.1 + (s_minus (α_of β) : ℂ) * q.2, q.2) ∈
        Metric.ball p_sh (r_chart (α_of β) p_sh)
noncomputable def firstFieldSinc (z : ℂ) : ℂ :=
  ∑' m : ℕ, (-1 : ℂ) ^ m * z ^ (2 * m) / ((2 * m + 1).factorial : ℂ)

noncomputable def firstFieldG (z : ℂ) : ℂ :=
  ∑' m : ℕ, 6 * (-1 : ℂ) ^ m * ((m + 1 : ℕ) : ℂ) * z ^ (2 * m) /
    ((2 * m + 3).factorial : ℂ)

noncomputable def secondFieldSinhc (z : ℂ) : ℂ :=
  ∑' m : ℕ, z ^ (2 * m) / ((2 * m + 1).factorial : ℂ)

noncomputable def secondFieldGNum (z : ℂ) : ℂ :=
  ∑' m : ℕ, 6 * (4 : ℂ) ^ m * z ^ (2 * m) / ((2 * m + 3).factorial : ℂ)

structure FrozenCalculusProp : Prop where
  sinc_entire : Differentiable ℂ firstFieldSinc
  gF_entire : Differentiable ℂ firstFieldG
  sinhc_entire : Differentiable ℂ secondFieldSinhc
  gQ_entire : Differentiable ℂ secondFieldGNum
  sinc_zero : firstFieldSinc 0 = 1
  gF_zero : firstFieldG 0 = 1
  sinhc_zero : secondFieldSinhc 0 = 1
  gQ_zero : secondFieldGNum 0 = 1
  sinc_mul : ∀ z : ℂ, z * firstFieldSinc z = Complex.sin z
  gF_mul : ∀ z : ℂ, z ^ 3 * firstFieldG z = 3 * (Complex.sin z - z * Complex.cos z)
  sinhc_mul : ∀ z : ℂ, z * secondFieldSinhc z = Complex.sinh z
  gQ_mul : ∀ z : ℂ,
    2 * z ^ 3 * secondFieldGNum z = 3 * (Complex.sinh z * Complex.cosh z - z)
  energy_first : ∀ lam J : ℂ,
    frozenEnergyE .firstField lam J = (J ^ 3 / 12) * firstFieldG (lam * J / 2)
  twist_first : ∀ lam J : ℂ,
    deriv (deriv (frozenActionP .firstField lam)) J =
      (J / 4) * firstFieldSinc (lam * J / 2)
  energy_second : ∀ lam J : ℂ, Complex.cosh (lam * J / 2) ≠ 0 →
    frozenEnergyE .secondField lam J =
      (J ^ 3 / (12 * Complex.cosh (lam * J / 2) ^ 2)) * secondFieldGNum (lam * J / 2)
  twist_second : ∀ lam J : ℂ, Complex.cosh (lam * J / 2) ≠ 0 →
    deriv (deriv (frozenActionP .secondField lam)) J =
      (J * secondFieldSinhc (lam * J / 2)) / (4 * Complex.cosh (lam * J / 2) ^ 3)
  local_J_inj : ∃ δ_E : ℝ, 0 < δ_E ∧
    ∀ (kind : ExpProfileKind) (lam J₁ J₂ : ℂ),
      ‖lam‖ < δ_E → ‖J₁ - 1‖ < δ_E → ‖J₂ - 1‖ < δ_E →
      frozenEnergyE kind lam J₁ = frozenEnergyE kind lam J₂ → J₁ = J₂

structure ModelDiskInput (kind : ExpProfileKind) where
  v_c : ℝ
  P : ℂ → ℂ
  M : ℂ → ℂ
  p_even : ℕ → ℝ
  v_c_pos : 0 < v_c
  p_zero : p_even 0 = 1
  p_one_pos : 0 < p_even 1
  p_nonneg : ∀ m : ℕ, 0 ≤ p_even m
  P_holo : DifferentiableOn ℂ P (Metric.ball (0 : ℂ) v_c)
  P_ne_zero : ∀ v ∈ Metric.ball (0 : ℂ) v_c, P v ≠ 0
  P_hasSum : ∀ v ∈ Metric.ball (0 : ℂ) v_c,
    HasSum (fun m : ℕ => (p_even m : ℂ) * v ^ (2 * m)) (P v)
  M_holo : DifferentiableOn ℂ M (Metric.ball (0 : ℂ) v_c)
  M_zero : M 0 = 0
  M_even : ∀ v ∈ Metric.ball (0 : ℂ) v_c, M (-v) = M v
  M_real : ∀ r : ℝ, |r| < v_c → (M (r : ℂ)).im = 0
  disk_energy_reg : ∀ v ∈ Metric.ball (0 : ℂ) v_c,
    let lam := 2 * v * Complex.exp (M v)
    let J := P v * (1 + v * deriv M v)
    frozenEnergyE kind lam J = 1 / 12 ∧ IsRegularFrozenState kind lam J
  real_bridge :
    match kind with
    | .firstField =>
        v_c = Real.pi ∧
        ∀ r ∈ Set.Ioo (0 : ℝ) Real.pi,
          ((Real.exp ((M (r : ℂ)).re) : ℝ) : ℂ) ^ 3 = firstFieldG (r : ℂ) ∧
          (Real.sin r / r) * (P (r : ℂ)).re = Real.exp (2 * (M (r : ℂ)).re)
    | .secondField =>
        v_c = 1 ∧
        (∀ r ∈ Set.Ioo (0 : ℝ) 1, (P (r : ℂ)).re = Real.exp (2 * (M (r : ℂ)).re)) ∧
        (∀ z : ℝ, 0 < z →
          (((2 * Real.tanh z * Real.exp ((M (Real.tanh z : ℂ)).re) : ℝ) : ℂ)) ^ 3 =
            12 * ((Real.tanh z : ℂ) - (z : ℂ) / (Complex.cosh (z : ℂ)) ^ 2))

structure InnerDiskModelPackage (kind : ExpProfileKind) (I : ModelDiskInput kind) where
  R : ℝ
  r_uniq : ℝ
  Δ_ball : ℂ → ℂ
  w_real : ℝ → ℝ
  R_pos : 0 < R
  r_uniq_pos : 0 < r_uniq
  r_uniq_lt : r_uniq < R
  Δ_ball_holo : DifferentiableOn ℂ Δ_ball (Metric.ball (0 : ℂ) R)
  Δ_ball_zero : Δ_ball 0 = 0
  Δ_ball_even : ∀ w ∈ Metric.ball (0 : ℂ) R, Δ_ball (-w) = Δ_ball w
  ball_regular_energy : ∀ w ∈ Metric.ball (0 : ℂ) R,
    let lam := w * Complex.exp (-Complex.I * Δ_ball w)
    let J := 1 - Complex.I * w * deriv Δ_ball w
    frozenEnergyE kind lam J = 1 / 12 ∧ IsRegularFrozenState kind lam J
  local_uniqueness : ∀ (w_coeff : ℂ) (D₁ : ℝ) (S_loc : ℂ → ℂ),
    0 < D₁ →
    DifferentiableOn ℂ S_loc { Y : ℂ | D₁ < -Y.im } →
    (∀ ε : ℝ, 0 < ε → ∃ D₂ : ℝ, D₁ < D₂ ∧ ∀ Y : ℂ, D₂ < -Y.im → ‖S_loc Y - Y‖ < ε) →
    (∀ Y : ℂ, D₁ < -Y.im → ‖w_coeff * Complex.exp (-Complex.I * Y)‖ < r_uniq) →
    (∀ Y : ℂ, D₁ < -Y.im →
      frozenEnergyE kind
        (w_coeff * Complex.exp (-Complex.I * S_loc Y))
        (deriv S_loc Y) = 1 / 12) →
    ∀ Y : ℂ, D₁ < -Y.im →
      S_loc Y = Y + Δ_ball (w_coeff * Complex.exp (-Complex.I * Y))
  w_real_cont : ContinuousOn w_real (Set.Ico 0 I.v_c)
  w_real_tendsto : Filter.Tendsto w_real (nhdsWithin I.v_c (Set.Iio I.v_c)) (nhds R)
  w_real_props : ∀ r ∈ Set.Ioo (0 : ℝ) I.v_c,
    0 < w_real r ∧ w_real r < R ∧
    HasDerivAt w_real (w_real r / (r * (I.P (r : ℂ)).re)) r ∧
    Δ_ball (w_real r : ℂ) =
      Complex.I * Complex.log (((2 * r * Real.exp ((I.M (r : ℂ)).re) : ℝ) : ℂ) / (w_real r : ℂ))

def slitInDomain (R r_patch : ℝ) : Set ℂ :=
  { w : ℂ | w ∈ Metric.ball (R : ℂ) r_patch ∧ (R : ℂ) - w ∈ Complex.slitPlane }

def slitOutDomain (R r_patch : ℝ) : Set ℂ :=
  { w : ℂ | w ∈ Metric.ball (R : ℂ) r_patch ∧ w - (R : ℂ) ∈ Complex.slitPlane }

def LocalSlitChartProp (kind : ExpProfileKind) (R : ℝ) (Δ_ball : ℂ → ℂ) : Prop :=
  ∃ (r_patch ε_ov : ℝ) (Δ_slit_in Δ_slit_out : ℂ → ℂ),
    0 < r_patch ∧ r_patch < R ∧ 0 < ε_ov ∧ ε_ov < r_patch ∧
    DifferentiableOn ℂ Δ_slit_in (slitInDomain R r_patch) ∧
    DifferentiableOn ℂ Δ_slit_out (slitOutDomain R r_patch) ∧
    (∀ x ∈ Set.Ioo (R - ε_ov) R, Δ_slit_in (x : ℂ) = Δ_ball (x : ℂ)) ∧
    (∀ w ∈ slitInDomain R r_patch,
      let lam := w * Complex.exp (-Complex.I * Δ_slit_in w)
      let J := 1 - Complex.I * w * deriv Δ_slit_in w
      frozenEnergyE kind lam J = 1 / 12 ∧ IsRegularFrozenState kind lam J) ∧
    (∀ w ∈ slitOutDomain R r_patch,
      let lam := w * Complex.exp (-Complex.I * Δ_slit_out w)
      let J := 1 - Complex.I * w * deriv Δ_slit_out w
      frozenEnergyE kind lam J = 1 / 12 ∧ IsRegularFrozenState kind lam J) ∧
    (∀ w ∈ slitInDomain R r_patch ∩ slitOutDomain R r_patch,
      0 < w.im → Δ_slit_out w = Δ_slit_in w) ∧
    (∀ w ∈ slitInDomain R r_patch ∩ slitOutDomain R r_patch,
      w.im < 0 → Δ_slit_out w ≠ Δ_slit_in w)
def IsDownwardVertConvex (U : Set (ℂ × ℂ)) : Prop :=
  IsOpen U ∧
  ∀ y t : ℂ, (y, t) ∈ U → 0 ≤ y.im →
    ∀ τ : ℝ, 0 ≤ τ → τ ≤ y.im →
      ((y.re : ℂ) + (τ : ℂ) * Complex.I, t) ∈ U

noncomputable def expBasePt {X : ExpStripData} {kind : ExpProfileKind}
    (seq : ExpSequenceData X kind) (n : ℕ) : ℂ :=
  (seq.x_seq n : ℂ) + (seq.h_seq n : ℂ) * Complex.I

noncomputable def rescaledLift {X : ExpStripData} {kind : ExpProfileKind}
    (seq : ExpSequenceData X kind) (s_fn : ℂ × ℂ → ℂ) (n : ℕ) (Y T : ℂ) : ℂ :=
  (s_fn (expBasePt seq n + (seq.ℓ_seq n : ℂ) * Y, T / (seq.m_seq n : ℂ)) -
    expBasePt seq n) / (seq.ℓ_seq n : ℂ)

def SatisfiesScaledChordRecurrence {X : ExpStripData} (P : ChordActionPackage X)
    {kind : ExpProfileKind} (seq : ExpSequenceData X kind)
    (S_fn : ℂ → ℂ) (n : ℕ) (Y T : ℂ) : Prop :=
  let a_n : ℂ := T / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ)
  let t : ℂ := T / (seq.m_seq n : ℂ)
  let s_prev : ℂ := expBasePt seq n + (seq.ℓ_seq n : ℂ) * S_fn (Y - a_n)
  let s_curr : ℂ := expBasePt seq n + (seq.ℓ_seq n : ℂ) * S_fn Y
  let s_next : ℂ := expBasePt seq n + (seq.ℓ_seq n : ℂ) * S_fn (Y + a_n)
  let J_prev : ℂ := (s_curr - s_prev) / t
  let J_curr : ℂ := (s_next - s_curr) / t
  deriv (fun J' => P.p_act s_curr J' t) J_curr -
    t * deriv (fun s' => P.p_act s' J_curr t) s_curr =
    deriv (fun J' => P.p_act s_prev J' t) J_prev

def IsRegularFrozenModel {X : ExpStripData} {kind : ExpProfileKind}
    (seq : ExpSequenceData X kind) (V_mod : Set (ℂ × ℂ)) (S_star : ℂ × ℂ → ℂ) : Prop :=
  IsOpen V_mod ∧
  DifferentiableOn ℂ S_star V_mod ∧
  ∀ p ∈ V_mod,
    let lam : ℂ := p.2 * seq.c₀ * Complex.exp (-Complex.I * S_star p)
    let J : ℂ := deriv (fun Y' => S_star (Y', p.2)) p.1
    frozenEnergyE kind lam J = 1 / 12 ∧ IsRegularFrozenState kind lam J

noncomputable def circleAvgCont (f₀ : ℂ × ℂ → ℂ) (Φ : (ℂ × ℂ) × ℂ → ℂ × ℂ)
    (p : ℂ × ℂ) : ℂ :=
  ((2 * Real.pi : ℝ) : ℂ)⁻¹ *
    ∫ ϕ in (0 : ℝ)..(2 * Real.pi), f₀ (Φ (p, Complex.exp ((ϕ : ℂ) * Complex.I)))

structure DiskContinuationToolkitProp : Prop where
  vertical_tube_uniqueness :
    ∀ (U₁ U₂ : Set (ℂ × ℂ)) (f₁ f₂ : ℂ × ℂ → ℂ) (y₀ t₀ : ℂ) (δ₀ : ℝ),
      IsDownwardVertConvex U₁ →
      IsDownwardVertConvex U₂ →
      DifferentiableOn ℂ f₁ U₁ →
      DifferentiableOn ℂ f₂ U₂ →
      (y₀, t₀) ∈ U₁ ∩ U₂ →
      0 ≤ y₀.im →
      0 < δ₀ →
      (∀ y : ℂ, ‖y - (y₀.re : ℂ)‖ < δ₀ → f₁ (y, t₀) = f₂ (y, t₀)) →
      f₁ (y₀, t₀) = f₂ (y₀, t₀)
  binomial_dip_poly :
    ∀ (ϕ₁ ϕ₂ C_dip η_plus : ℝ),
      0 < C_dip → 0 < η_plus →
      ∃ (δ_ϕ : ℝ) (g : ℂ → ℂ),
        0 < δ_ϕ ∧
        Differentiable ℂ g ∧
        g 0 = 0 ∧
        (∀ ζ : ℂ, ‖ζ‖ ≤ 1 → ‖g ζ‖ ≤ 8 * C_dip ∧ (g ζ).im ≤ η_plus) ∧
        (∀ ϕ : ℝ,
          (∃ k : ℤ, |ϕ - ϕ₁ - 2 * Real.pi * (k : ℝ)| ≤ δ_ϕ ∨
                    |ϕ - ϕ₂ - 2 * Real.pi * (k : ℝ)| ≤ δ_ϕ) →
          (g (Complex.exp ((ϕ : ℂ) * Complex.I))).im ≤ -C_dip)
  circle_average_disk_continuation :
    ∀ (W U₀ : Set (ℂ × ℂ)) (f₀ : ℂ × ℂ → ℂ) (Φ : (ℂ × ℂ) × ℂ → ℂ × ℂ),
      IsOpen W →
      IsOpen U₀ →
      DifferentiableOn ℂ f₀ U₀ →
      DifferentiableOn ℂ Φ (W ×ˢ Metric.ball (0 : ℂ) (3 / 2)) →
      (∀ p ∈ W, Φ (p, 0) = p) →
      (∀ p ∈ W, ∀ ϕ : ℝ, Φ (p, Complex.exp ((ϕ : ℂ) * Complex.I)) ∈ U₀) →
      DifferentiableOn ℂ (circleAvgCont f₀ Φ) W ∧
      (∀ p ∈ W, (∀ ζ ∈ Metric.closedBall (0 : ℂ) 1, Φ (p, ζ) ∈ U₀) →
        circleAvgCont f₀ Φ p = f₀ p) ∧
      (∀ (U_star : Set (ℂ × ℂ)) (f_star : ℂ × ℂ → ℂ),
        IsOpen U_star →
        DifferentiableOn ℂ f_star U_star →
        ∀ p ∈ W, (∀ ζ ∈ Metric.closedBall (0 : ℂ) 1, Φ (p, ζ) ∈ U_star) →
          ∀ B : ℝ, 0 ≤ B →
            (∀ ϕ ∈ Set.Icc (0 : ℝ) (2 * Real.pi),
              ‖f₀ (Φ (p, Complex.exp ((ϕ : ℂ) * Complex.I))) -
                f_star (Φ (p, Complex.exp ((ϕ : ℂ) * Complex.I)))‖ ≤ B) →
            ‖circleAvgCont f₀ Φ p - f_star p‖ ≤ B) ∧
      (∀ (X : ExpStripData), IsExpObstructionStrip X →
        (∀ q ∈ U₀, f₀ q ∈ X.D_strip) →
        ∀ p ∈ W, circleAvgCont f₀ Φ p ∈ X.D_strip)
  partial_derivs_holo_3d :
    ∀ (U : Set (ℂ × ℂ × ℂ)) (F : ℂ × ℂ × ℂ → ℂ),
      IsOpen U → DifferentiableOn ℂ F U →
      DifferentiableOn ℂ
        (fun q : ℂ × ℂ × ℂ => deriv (fun S' => F (S', q.2.1, q.2.2)) q.1) U ∧
      DifferentiableOn ℂ
        (fun q : ℂ × ℂ × ℂ => deriv (fun J' => F (q.1, J', q.2.2)) q.2.1) U

structure RegularCorridorTrackingProp (X : ExpStripData) (P : ChordActionPackage X)
    (kind : ExpProfileKind) (seq : ExpSequenceData X kind) : Prop where
  horizontal_chain_tracking :
    ∀ (V_mod : Set (ℂ × ℂ)) (S_star : ℂ × ℂ → ℂ) (T₀ Y_plus : ℂ)
      (ε_plus L_max : ℝ) (S_init : ℕ → ℂ → ℂ) (N_base : ℕ) (N_step : ℕ → ℕ),
      IsRegularFrozenModel seq V_mod S_star →
      T₀ ≠ 0 → 0 < ε_plus → 0 < L_max →
      Metric.closedBall Y_plus (3 * ε_plus) ×ˢ ({T₀} : Set ℂ) ⊆ V_mod →
      (∀ Z ∈ Metric.closedBall Y_plus ε_plus, ∀ τ ∈ Set.Icc (0 : ℝ) L_max,
        (Z + (τ : ℂ) * T₀, T₀) ∈ V_mod) →
      (∀ n ≥ N_base, DifferentiableOn ℂ (S_init n) (Metric.ball Y_plus (3 * ε_plus))) →
      (∀ n ≥ N_base, ∀ Z ∈ Metric.ball Y_plus (2 * ε_plus),
        Z - T₀ / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ) ∈ Metric.ball Y_plus (3 * ε_plus) →
        Z + T₀ / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ) ∈ Metric.ball Y_plus (3 * ε_plus) →
        SatisfiesScaledChordRecurrence P seq (S_init n) n Z T₀) →
      TendstoUniformlyOn S_init (fun Z => S_star (Z, T₀))
        Filter.atTop (Metric.closedBall Y_plus (2 * ε_plus)) →
      (∀ n : ℕ, (N_step n : ℝ) / (seq.ℓ_seq n * seq.m_seq n) ≤ L_max) →
      ∃ (N_tr : ℕ) (S_chain : ℕ → ℕ → ℂ → ℂ),
        N_base ≤ N_tr ∧
        (∀ n ≥ N_tr, ∀ j ≤ N_step n,
          DifferentiableOn ℂ (S_chain n j) (Metric.ball Y_plus ε_plus)) ∧
        (∀ n ≥ N_tr, ∀ Z ∈ Metric.ball Y_plus ε_plus,
          let a_n : ℂ := T₀ / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ)
          S_chain n 0 Z = S_init n Z ∧ S_chain n 1 Z = S_init n (Z + a_n)) ∧
        (∀ n ≥ N_tr, ∀ j < N_step n, ∀ Z ∈ Metric.ball Y_plus ε_plus,
          let a_n : ℂ := T₀ / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ)
          Z + a_n ∈ Metric.ball Y_plus ε_plus →
          S_chain n (j + 1) Z = S_chain n j (Z + a_n)) ∧
        (∀ ε : ℝ, 0 < ε → ∃ N₁ ≥ N_tr, ∀ n ≥ N₁, ∀ j ≤ N_step n,
          ∀ Z ∈ Metric.ball Y_plus ε_plus,
            let a_n : ℂ := T₀ / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ)
            ‖S_chain n j Z - S_star (Z + (j : ℂ) * a_n, T₀)‖ < ε)
  steep_vertical_passage :
    ∀ (V_mod : Set (ℂ × ℂ)) (S_star : ℂ × ℂ → ℂ)
      (σ η T_max : ℝ) (U_T : Set ℂ) (x_lo x_hi y_bot y_top : ℝ)
      (K_steep : Set (ℂ × ℂ)),
      IsRegularFrozenModel seq V_mod S_star →
      (σ = 1 ∨ σ = -1) → 0 < η → 0 < T_max →
      IsOpen U_T →
      U_T ⊆ { T : ℂ | η < σ * T.im ∧ ‖T‖ < T_max } →
      x_lo < x_hi → y_bot < y_top →
      (let B_init : Set (ℂ × ℂ) :=
        { p : ℂ × ℂ |
          x_lo < p.1.re ∧ p.1.re < x_hi ∧
          y_bot < p.1.im ∧ p.1.im < y_top ∧ p.2 ∈ U_T }
       let y_mid : ℝ := (y_bot + y_top) / 2
       let δ_y : ℝ := (y_top - y_bot) / 4
       B_init ⊆ V_mod →
       IsCompact K_steep →
       K_steep ⊆ { p : ℂ × ℂ |
         x_lo < p.1.re ∧ p.1.re < x_hi ∧
         y_bot + δ_y ≤ p.1.im ∧ p.2 ∈ U_T } →
       (∀ p ∈ K_steep, ∀ τ ∈ Set.Icc y_mid (max y_mid p.1.im),
         let Y_vert : ℂ := (p.1.re : ℂ) + (τ : ℂ) * Complex.I
         let s_end : ℝ := (τ - y_mid) / (σ * p.2.im)
         (∀ s ∈ Set.Icc (0 : ℝ) s_end,
           (Y_vert - (s : ℂ) * (σ : ℂ) * p.2, p.2) ∈ V_mod) ∧
         x_lo < (Y_vert - (s_end : ℂ) * (σ : ℂ) * p.2).re ∧
         (Y_vert - (s_end : ℂ) * (σ : ℂ) * p.2).re < x_hi) →
       ∃ W_steep : Set (ℂ × ℂ),
         IsOpen W_steep ∧
         K_steep ⊆ W_steep ∧
         W_steep ⊆ V_mod ∧
         W_steep ⊆ { p : ℂ × ℂ |
           x_lo < p.1.re ∧ p.1.re < x_hi ∧
           y_bot + δ_y / 2 < p.1.im ∧ p.2 ∈ U_T } ∧
         (∀ Y T : ℂ, (Y, T) ∈ W_steep →
           ∀ τ : ℝ, y_bot + δ_y ≤ τ → τ ≤ Y.im →
             ((Y.re : ℂ) + (τ : ℂ) * Complex.I, T) ∈ W_steep) ∧
         ∀ (N₀ : ℕ) (S_low : ℕ → ℂ × ℂ → ℂ),
           (∀ n ≥ N₀, DifferentiableOn ℂ (S_low n) B_init) →
           (∀ n ≥ N₀, ∀ Y T : ℂ, T ≠ 0 →
             (Y, T) ∈ B_init →
             (Y - T / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ), T) ∈ B_init →
             (Y + T / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ), T) ∈ B_init →
             SatisfiesScaledChordRecurrence P seq (fun Z => S_low n (Z, T)) n Y T) →
           (∀ K : Set (ℂ × ℂ), IsCompact K → K ⊆ B_init →
             TendstoUniformlyOn S_low S_star Filter.atTop K) →
           ∃ (N_st : ℕ) (S_ext : ℕ → ℂ × ℂ → ℂ),
             N₀ ≤ N_st ∧
             (∀ n ≥ N_st, DifferentiableOn ℂ (S_ext n) W_steep) ∧
             (∀ n ≥ N_st, ∀ p ∈ W_steep,
               expBasePt seq n + (seq.ℓ_seq n : ℂ) * S_ext n p ∈ X.D_strip) ∧
             (∀ n ≥ N_st, ∀ p ∈ W_steep, p.1.im < y_top - δ_y →
               S_ext n p = S_low n p) ∧
             TendstoUniformlyOn S_ext S_star Filter.atTop K_steep)

structure RadialBypassPatchesData (X : ExpStripData) (P : ChordActionPackage X)
    (kind : ExpProfileKind) (seq : ExpSequenceData X kind)
    (M : BranchMonodromyPackage kind) where
  ν' : ℝ
  ε_patch : ℝ
  N_patch : ℕ
  U_plus : ℕ → Set (ℂ × ℂ)
  U_minus : ℕ → Set (ℂ × ℂ)
  s_plus : ℕ → ℂ × ℂ → ℂ
  s_minus : ℕ → ℂ × ℂ → ℂ
  δ_zero : ℕ → ℝ
  ν'_pos : 0 < ν'
  ν'_lt : ν' < M.ν
  ε_patch_pos : 0 < ε_patch
  ε_patch_lt_ν : ε_patch < ν' / 12
  ε_patch_lt_δ : ε_patch < M.δ_θ / 12
  patch_props : ∀ n ≥ N_patch,
    let T_star : ℝ := (‖seq.c₀‖)⁻¹
    let α_c : ℝ := Complex.arg seq.c₀
    let t₀_n : ℝ := T_star / seq.m_seq n
    let x₀_plus_n : ℝ := seq.x_seq n + seq.ℓ_seq n * (α_c - M.θ)
    let x₀_minus_n : ℝ := seq.x_seq n + seq.ℓ_seq n * (α_c + M.θ)
    let b_plus_n : ℝ := seq.h_seq n + seq.ℓ_seq n * (Real.log M.R + 3 * ν' / 4)
    let Y_plus : ℂ :=
      ((α_c - M.θ : ℝ) : ℂ) + ((Real.log M.R + ν' / 2 : ℝ) : ℂ) * Complex.I
    let Y_minus : ℂ :=
      ((α_c + M.θ : ℝ) : ℂ) + ((Real.log M.R + ν' / 2 : ℝ) : ℂ) * Complex.I
    IsDownwardVertConvex (U_plus n) ∧
    IsDownwardVertConvex (U_minus n) ∧
    0 < δ_zero n ∧
    DifferentiableOn ℂ (s_plus n) (U_plus n) ∧
    (∀ p ∈ U_plus n, s_plus n p ∈ X.D_strip) ∧
    DifferentiableOn ℂ (s_minus n) (U_minus n) ∧
    (∀ p ∈ U_minus n, s_minus n p ∈ X.D_strip) ∧
    (∀ y t : ℂ, ‖y - (x₀_plus_n : ℂ)‖ < δ_zero n → ‖t - (t₀_n : ℂ)‖ < δ_zero n →
      (y, t) ∈ U_plus n ∧ s_plus n (y, t) = X.𝔰 (y, t)) ∧
    (∀ y t : ℂ, ‖y - (x₀_minus_n : ℂ)‖ < δ_zero n → ‖t - (t₀_n : ℂ)‖ < δ_zero n →
      (y, t) ∈ U_minus n ∧ s_minus n (y, t) = X.𝔰 (y, t)) ∧
    (∀ η : ℝ, 0 ≤ η → η ≤ b_plus_n →
      ((x₀_plus_n : ℂ) + (η : ℂ) * Complex.I, (t₀_n : ℂ)) ∈ U_plus n) ∧
    (∀ Z ∈ Metric.ball Y_plus (3 * ε_patch),
      (expBasePt seq n + (seq.ℓ_seq n : ℂ) * Z, (t₀_n : ℂ)) ∈ U_plus n) ∧
    (∀ Z ∈ Metric.ball Y_minus (3 * ε_patch),
      (expBasePt seq n + (seq.ℓ_seq n : ℂ) * Z, (t₀_n : ℂ)) ∈ U_minus n) ∧
    (∀ Z ∈ Metric.ball Y_plus (2 * ε_patch),
      Z - (T_star : ℂ) / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ) ∈
        Metric.ball Y_plus (3 * ε_patch) →
      Z + (T_star : ℂ) / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ) ∈
        Metric.ball Y_plus (3 * ε_patch) →
      SatisfiesScaledChordRecurrence P seq
        (fun W => rescaledLift seq (s_plus n) n W (T_star : ℂ)) n Z (T_star : ℂ))
  conv_plus :
    let T_star : ℝ := (‖seq.c₀‖)⁻¹
    let α_c : ℝ := Complex.arg seq.c₀
    let Y_plus : ℂ :=
      ((α_c - M.θ : ℝ) : ℂ) + ((Real.log M.R + ν' / 2 : ℝ) : ℂ) * Complex.I
    TendstoUniformlyOn
      (fun n Z => rescaledLift seq (s_plus n) n Z (T_star : ℂ))
      (fun Z => Z + M.Δ_inner ((T_star : ℂ) * seq.c₀ * Complex.exp (-Complex.I * Z)))
      Filter.atTop (Metric.closedBall Y_plus (2 * ε_patch))
  conv_minus :
    let T_star : ℝ := (‖seq.c₀‖)⁻¹
    let α_c : ℝ := Complex.arg seq.c₀
    let Y_minus : ℂ :=
      ((α_c + M.θ : ℝ) : ℂ) + ((Real.log M.R + ν' / 2 : ℝ) : ℂ) * Complex.I
    TendstoUniformlyOn
      (fun n Z => rescaledLift seq (s_minus n) n Z (T_star : ℂ))
      (fun Z => Z + M.Δ_inner ((T_star : ℂ) * seq.c₀ * Complex.exp (-Complex.I * Z)))
      Filter.atTop (Metric.closedBall Y_minus (2 * ε_patch))
structure paJetHoloAtZero (H : ℂ → ℂ) : Prop where
  out : ∃ U : Set ℂ, IsOpen U ∧ (0 : ℂ) ∈ U ∧ DifferentiableOn ℂ H U

def paJetPsEqUpTo (l : ℕ) (P Q : PowerSeries ℂ) : Prop :=
  ∀ n ≤ l, PowerSeries.coeff n P = PowerSeries.coeff n Q

structure paJetPsHoloOn (V : Set (ℂ × ℂ)) (P : (ℂ × ℂ) → PowerSeries ℂ) : Prop where
  out : ∀ m : ℕ, DifferentiableOn ℂ (fun q => PowerSeries.coeff m (P q)) V

def paJetVanish2D1D (k : ℕ) (W : MvPowerSeries (Fin 2) (PowerSeries ℂ)) : Prop :=
  ∀ (d : Fin 2 →₀ ℕ) (m : ℕ), d 0 + d 1 + m < k →
    PowerSeries.coeff m (MvPowerSeries.coeff d W) = 0

noncomputable def paJetT2D1D (p₁ : ℂ × ℂ) (P : (ℂ × ℂ) → PowerSeries ℂ) :
    MvPowerSeries (Fin 2) (PowerSeries ℂ) :=
  pointArcPack2D1D (fun m => taylor2D (fun q => PowerSeries.coeff m (P q)) p₁)

noncomputable def pointArcPolyShift {J : ℕ} (c : Fin (J + 1) → ℂ) : PowerSeries ℂ :=
  ∑ l : Fin (J + 1), PowerSeries.C (c l) * PowerSeries.X ^ (l : ℕ)

noncomputable def pointArcPolyComp (φ Z : PowerSeries ℂ) : PowerSeries ℂ :=
  PowerSeries.mk fun m =>
    ∑ n ∈ Finset.range (m + 1),
      PowerSeries.coeff n φ * PowerSeries.coeff m (Z ^ n)

noncomputable def pointArcPolyGraph {k J : ℕ} (F : ℂ → ℂ)
    (g : Fin (k + 1) → Fin (J + 1) → ℂ → ℂ) (x₀ : Fin (k + 1) → ℂ)
    (β : Fin (J + 1) → Fin (k + 1) → ℂ) (r : Fin (k + 1)) : PowerSeries ℂ :=
  pointArcPolyComp (pointArcHoloTaylor1D F (x₀ r)) (pointArcPolyShift (fun l => β l r)) +
    ∑ l : Fin (J + 1),
      PowerSeries.X ^ (l : ℕ) *
        pointArcPolyComp (pointArcHoloTaylor1D (g r l) (x₀ r))
          (pointArcPolyShift (fun q => β q r))

noncomputable def pointArcPolyGraphDeriv {k J : ℕ} (F : ℂ → ℂ)
    (g : Fin (k + 1) → Fin (J + 1) → ℂ → ℂ) (x₀ : Fin (k + 1) → ℂ)
    (β : Fin (J + 1) → Fin (k + 1) → ℂ) (r : Fin (k + 1)) : PowerSeries ℂ :=
  pointArcPolyComp (pointArcHoloTaylor1D (deriv F) (x₀ r)) (pointArcPolyShift (fun l => β l r)) +
    ∑ l : Fin (J + 1),
      PowerSeries.X ^ (l : ℕ) *
        pointArcPolyComp (pointArcHoloTaylor1D (deriv (g r l)) (x₀ r))
          (pointArcPolyShift (fun q => β q r))

noncomputable def pointArcPolyDx {k J : ℕ} (x₀ : Fin (k + 1) → ℂ)
    (β : Fin (J + 1) → Fin (k + 1) → ℂ) (i : Fin k) : PowerSeries ℂ :=
  PowerSeries.C (x₀ i.succ - x₀ i.castSucc) +
    (pointArcPolyShift (fun l => β l i.succ) - pointArcPolyShift (fun l => β l i.castSucc))

noncomputable def pointArcPolyDy {k J : ℕ} (F : ℂ → ℂ)
    (g : Fin (k + 1) → Fin (J + 1) → ℂ → ℂ) (x₀ : Fin (k + 1) → ℂ)
    (β : Fin (J + 1) → Fin (k + 1) → ℂ) (i : Fin k) : PowerSeries ℂ :=
  pointArcPolyGraph F g x₀ β i.succ - pointArcPolyGraph F g x₀ β i.castSucc

noncomputable def pointArcPolyEdgeSq {k J : ℕ} (F : ℂ → ℂ)
    (g : Fin (k + 1) → Fin (J + 1) → ℂ → ℂ) (x₀ : Fin (k + 1) → ℂ)
    (β : Fin (J + 1) → Fin (k + 1) → ℂ) (i : Fin k) : PowerSeries ℂ :=
  (pointArcPolyDx x₀ β i) ^ 2 + (pointArcPolyDy F g x₀ β i) ^ 2

noncomputable def pointArcPolyEdgeRel {k J : ℕ} (ℓ₀ : Fin k → ℂ) (F : ℂ → ℂ)
    (g : Fin (k + 1) → Fin (J + 1) → ℂ → ℂ) (x₀ : Fin (k + 1) → ℂ)
    (β : Fin (J + 1) → Fin (k + 1) → ℂ) (i : Fin k) : PowerSeries ℂ :=
  (pointArcPolyEdgeSq F g x₀ β i - PowerSeries.C ((ℓ₀ i) ^ 2)) *
    PowerSeries.C (((ℓ₀ i) ^ 2)⁻¹)

noncomputable def pointArcPolyLen {k J : ℕ} (ℓ₀ : Fin k → ℂ) (F : ℂ → ℂ)
    (g : Fin (k + 1) → Fin (J + 1) → ℂ → ℂ) (x₀ : Fin (k + 1) → ℂ)
    (β : Fin (J + 1) → Fin (k + 1) → ℂ) : PowerSeries ℂ :=
  ∑ i : Fin k,
    PowerSeries.C (ℓ₀ i) *
      pointArcPolyComp pointArcPsSqrt1p (pointArcPolyEdgeRel ℓ₀ F g x₀ β i)

noncomputable def pointArcPolyInvEdgeLen {k J : ℕ} (ℓ₀ : Fin k → ℂ) (F : ℂ → ℂ)
    (g : Fin (k + 1) → Fin (J + 1) → ℂ → ℂ) (x₀ : Fin (k + 1) → ℂ)
    (β : Fin (J + 1) → Fin (k + 1) → ℂ) (i : Fin k) : PowerSeries ℂ :=
  PowerSeries.C ((ℓ₀ i)⁻¹) *
    pointArcPolyComp pointArcPsInvSqrt1p (pointArcPolyEdgeRel ℓ₀ F g x₀ β i)

noncomputable def pointArcPolyGrad {k J : ℕ} (ℓ₀ : Fin k → ℂ) (F : ℂ → ℂ)
    (g : Fin (k + 1) → Fin (J + 1) → ℂ → ℂ) (x₀ : Fin (k + 1) → ℂ)
    (β : Fin (J + 1) → Fin (k + 1) → ℂ) (r : Fin (k - 1)) : PowerSeries ℂ :=
  let i_L : Fin k := ⟨r.1, by have := r.2; omega⟩
  let i_R : Fin k := ⟨r.1 + 1, by have := r.2; omega⟩
  (pointArcPolyDx x₀ β i_L +
      pointArcPolyDy F g x₀ β i_L * pointArcPolyGraphDeriv F g x₀ β i_L.succ) *
      pointArcPolyInvEdgeLen ℓ₀ F g x₀ β i_L -
    (pointArcPolyDx x₀ β i_R +
      pointArcPolyDy F g x₀ β i_R * pointArcPolyGraphDeriv F g x₀ β i_R.castSucc) *
      pointArcPolyInvEdgeLen ℓ₀ F g x₀ β i_R
noncomputable def volterraIter (Q : ℝ → ℂ) (init : ℝ → ℂ) : ℕ → ℝ → ℂ
  | 0, w => init w
  | m + 1, w => ∫ v in (0 : ℝ)..w, ((w - v : ℝ) : ℂ) * Q v * volterraIter Q init m v

noncomputable def c0Kernel (Q : ℝ → ℂ) (w : ℝ) : ℂ :=
  ∑' m : ℕ, volterraIter Q (fun _ => 1) m w

noncomputable def c0Deriv (Q : ℝ → ℂ) (w : ℝ) : ℂ :=
  ∫ v in (0 : ℝ)..w, Q v * c0Kernel Q v

noncomputable def k0Kernel (Q : ℝ → ℂ) (w : ℝ) : ℂ :=
  ∑' m : ℕ, volterraIter Q (fun v => (v : ℂ)) m w

noncomputable def k0Deriv (Q : ℝ → ℂ) (w : ℝ) : ℂ :=
  1 + ∫ v in (0 : ℝ)..w, Q v * k0Kernel Q v

noncomputable def pertPotential (sgn : ℂ) (Q : ℝ → ℂ) (a₀ a₁ : ℂ) (w : ℝ) : ℂ :=
  let Fw := a₀ * c0Kernel Q w + a₁ * k0Kernel Q w
  let Fpw := a₀ * c0Deriv Q w + a₁ * k0Deriv Q w
  Q w - sgn * (3 * Complex.I / 2) * Fpw - (1 / 4 : ℂ) * Fw ^ 2

noncomputable def kPlusVal (Q : ℝ → ℂ) (a₀ a₁ : ℂ) : ℂ :=
  k0Kernel (pertPotential 1 Q a₀ a₁) 1

noncomputable def kMinusVal (Q : ℝ → ℂ) (a₀ a₁ : ℂ) : ℂ :=
  k0Kernel (pertPotential (-1) Q a₀ a₁) 1

noncomputable def canonRoot (Q : ℝ → ℂ) (a₀ a₁ : ℂ) : ℂ :=
  let kp := kPlusVal Q a₀ a₁
  let km := kMinusVal Q a₀ a₁
  ((kp + km) / 2) *
    Complex.exp ((1 / 2 : ℂ) * Complex.log (4 * kp * km / (kp + km) ^ 2))

noncomputable def slNumerator (Q : ℝ → ℂ) (w₀ w₁ : ℂ) : ℂ :=
  k0Kernel Q 1 - canonRoot Q w₀ ((w₁ - w₀ * c0Kernel Q 1) / k0Kernel Q 1)

noncomputable def slDivided (Q : ℝ → ℂ) (a₀ a₁ : ℂ) : ℂ :=
  let b₀ := a₀
  let b₁ := a₀ * c0Kernel Q 1 + a₁ * k0Kernel Q 1
  if b₀ ≠ 0 ∧ b₁ ≠ 0 then
    (k0Kernel Q 1 - canonRoot Q a₀ a₁) / (b₀ * b₁)
  else
    (1 / 2 : ℂ) * dslope (fun w₀ => dslope (fun w₁ => slNumerator Q w₀ w₁) 0 b₁) 0 b₀ +
      (1 / 2 : ℂ) * dslope (fun w₁ => dslope (fun w₀ => slNumerator Q w₀ w₁) 0 b₀) 0 b₁

noncomputable def stripPotential (X : ExpStripData) (s h : ℂ) (w : ℝ) : ℂ :=
  h ^ 2 * X.q (s + (w : ℂ) * h)

noncomputable def chordPhi (X : ExpStripData) (s h : ℂ) : ℂ :=
  if h = 0 then (1 / 24 : ℂ)
  else @ite _ (s ∈ X.D_strip ∧ s + h ∈ X.D_strip ∧ k0Kernel (stripPotential X s h) 1 ≠ 0)
    (Classical.propDecidable _)
    (slDivided (stripPotential X s h) (h * X.f s) (h ^ 2 * deriv X.f s))
    (1 / 24 : ℂ)

noncomputable def chordActionP (X : ExpStripData) (s J t : ℂ) : ℂ :=
  J ^ 3 * chordPhi X s (t * J)

def VolterraDivisionProp : Prop :=
  (∀ Q : ℝ → ℂ, ContinuousOn Q (Set.Icc (0 : ℝ) 1) →
    c0Kernel Q 0 = 1 ∧
    c0Deriv Q 0 = 0 ∧
    k0Kernel Q 0 = 0 ∧
    k0Deriv Q 0 = 1 ∧
    ContinuousOn (c0Kernel Q) (Set.Icc (0 : ℝ) 1) ∧
    ContinuousOn (c0Deriv Q) (Set.Icc (0 : ℝ) 1) ∧
    ContinuousOn (k0Kernel Q) (Set.Icc (0 : ℝ) 1) ∧
    ContinuousOn (k0Deriv Q) (Set.Icc (0 : ℝ) 1) ∧
    (∀ w ∈ Set.Icc (0 : ℝ) 1,
      HasDerivWithinAt (c0Kernel Q) (c0Deriv Q w) (Set.Icc (0 : ℝ) 1) w ∧
      HasDerivWithinAt (c0Deriv Q) (Q w * c0Kernel Q w) (Set.Icc (0 : ℝ) 1) w ∧
      HasDerivWithinAt (k0Kernel Q) (k0Deriv Q w) (Set.Icc (0 : ℝ) 1) w ∧
      HasDerivWithinAt (k0Deriv Q) (Q w * k0Kernel Q w) (Set.Icc (0 : ℝ) 1) w) ∧
    (∀ y y' : ℝ → ℂ,
      ContinuousOn y (Set.Icc (0 : ℝ) 1) →
      ContinuousOn y' (Set.Icc (0 : ℝ) 1) →
      (∀ w ∈ Set.Icc (0 : ℝ) 1,
        HasDerivWithinAt y (y' w) (Set.Icc (0 : ℝ) 1) w ∧
        HasDerivWithinAt y' (Q w * y w) (Set.Icc (0 : ℝ) 1) w) →
      ∀ w ∈ Set.Icc (0 : ℝ) 1,
        y w = y 0 * c0Kernel Q w + y' 0 * k0Kernel Q w ∧
        y' w = y 0 * c0Deriv Q w + y' 0 * k0Deriv Q w) ∧
    (∀ g g' : ℝ → ℂ,
      ContinuousOn g (Set.Icc (0 : ℝ) 1) →
      ContinuousOn g' (Set.Icc (0 : ℝ) 1) →
      (∀ w ∈ Set.Icc (0 : ℝ) 1,
        g w ≠ 0 ∧
        HasDerivWithinAt g (g' w) (Set.Icc (0 : ℝ) 1) w ∧
        HasDerivWithinAt g' (Q w * g w) (Set.Icc (0 : ℝ) 1) w) →
      k0Kernel Q 1 = g 0 * g 1 * ∫ w in (0 : ℝ)..1, (g w)⁻¹ ^ 2)) ∧
  ((∀ (M Δ : ℝ) (Q₁ Q₂ : ℝ → ℂ),
      0 ≤ M → 0 ≤ Δ →
      ContinuousOn Q₁ (Set.Icc (0 : ℝ) 1) →
      ContinuousOn Q₂ (Set.Icc (0 : ℝ) 1) →
      (∀ w ∈ Set.Icc (0 : ℝ) 1, ‖Q₁ w‖ ≤ M ∧ ‖Q₂ w‖ ≤ M ∧ ‖Q₁ w - Q₂ w‖ ≤ Δ) →
      ∀ w ∈ Set.Icc (0 : ℝ) 1,
        ‖c0Kernel Q₁ w‖ ≤ Real.exp M ∧
        ‖k0Kernel Q₁ w‖ ≤ Real.exp M ∧
        ‖c0Deriv Q₁ w‖ ≤ M * Real.exp M ∧
        ‖k0Deriv Q₁ w‖ ≤ 1 + M * Real.exp M ∧
        ‖c0Kernel Q₁ w - c0Kernel Q₂ w‖ ≤ Real.exp M * Δ ∧
        ‖k0Kernel Q₁ w - k0Kernel Q₂ w‖ ≤ Real.exp M * Δ ∧
        ‖c0Deriv Q₁ w - c0Deriv Q₂ w‖ ≤ (1 + M) * Real.exp M * Δ ∧
        ‖k0Deriv Q₁ w - k0Deriv Q₂ w‖ ≤ (1 + M) * Real.exp M * Δ) ∧
    (∀ (U : Set (ℂ × ℂ)) (Q : ℂ × ℂ → ℝ → ℂ) (a₀ a₁ : ℂ × ℂ → ℂ),
      IsOpen U →
      ContinuousOn (fun q : (ℂ × ℂ) × ℝ => Q q.1 q.2) (U ×ˢ Set.Icc (0 : ℝ) 1) →
      (∀ w ∈ Set.Icc (0 : ℝ) 1, DifferentiableOn ℂ (fun p => Q p w) U) →
      DifferentiableOn ℂ a₀ U →
      DifferentiableOn ℂ a₁ U →
      DifferentiableOn ℂ (fun p => c0Kernel (Q p) 1) U ∧
      DifferentiableOn ℂ (fun p => k0Kernel (Q p) 1) U ∧
      DifferentiableOn ℂ (fun p => kPlusVal (Q p) (a₀ p) (a₁ p)) U ∧
      DifferentiableOn ℂ (fun p => kMinusVal (Q p) (a₀ p) (a₁ p)) U)) ∧
  ((∀ (Q : ℝ → ℂ) (a₀ a₁ : ℂ),
      ContinuousOn Q (Set.Icc (0 : ℝ) 1) →
      k0Kernel (fun w => Q (1 - w)) 1 = k0Kernel Q 1 ∧
      kPlusVal Q (-a₀) (-a₁) = kMinusVal Q a₀ a₁ ∧
      kMinusVal Q (-a₀) (-a₁) = kPlusVal Q a₀ a₁ ∧
      canonRoot Q (-a₀) (-a₁) = canonRoot Q a₀ a₁ ∧
      ∀ w₀ w₁ : ℂ, slNumerator Q (-w₀) (-w₁) = slNumerator Q w₀ w₁) ∧
    (∀ (Q : ℝ → ℂ) (a₀ a₁ : ℂ),
      ContinuousOn Q (Set.Icc (0 : ℝ) 1) →
      k0Kernel Q 1 ≠ 0 →
      let b₁ := a₀ * c0Kernel Q 1 + a₁ * k0Kernel Q 1
      let b₁' := a₀ * c0Deriv Q 1 + a₁ * k0Deriv Q 1
      slDivided (fun w => Q (1 - w)) (-b₁) b₁' = slDivided Q a₀ a₁) ∧
    slDivided (fun _ => 0) 0 0 = (1 / 24 : ℂ)) ∧
  (∀ Q₀ : ℝ → ℂ,
    ContinuousOn Q₀ (Set.Icc (0 : ℝ) 1) →
    k0Kernel Q₀ 1 ≠ 0 →
    ∃ δ_Q r_b M_num : ℝ,
      0 < δ_Q ∧ 0 < r_b ∧ 0 < M_num ∧
      (∀ Q : ℝ → ℂ,
        ContinuousOn Q (Set.Icc (0 : ℝ) 1) →
        (∀ w ∈ Set.Icc (0 : ℝ) 1, ‖Q w - Q₀ w‖ < δ_Q) →
        k0Kernel Q 1 ≠ 0 ∧
        (∀ w₀ w₁ : ℂ, ‖w₀‖ ≤ r_b → ‖w₁‖ ≤ r_b →
          ‖slNumerator Q w₀ w₁‖ ≤ M_num ∧
          slNumerator Q 0 w₁ = 0 ∧
          slNumerator Q w₀ 0 = 0) ∧
        (∀ a₀ a₁ : ℂ,
          let b₀ := a₀
          let b₁ := a₀ * c0Kernel Q 1 + a₁ * k0Kernel Q 1
          ‖b₀‖ < r_b / 2 → ‖b₁‖ < r_b / 2 →
          slDivided Q a₀ a₁ =
            (((2 * Real.pi) ^ 2 : ℝ) : ℂ)⁻¹ *
              ∫ θ₀ in (0 : ℝ)..(2 * Real.pi),
                ∫ θ₁ in (0 : ℝ)..(2 * Real.pi),
                  slNumerator Q
                    ((r_b : ℂ) * Complex.exp ((θ₀ : ℂ) * Complex.I))
                    ((r_b : ℂ) * Complex.exp ((θ₁ : ℂ) * Complex.I)) /
                  (((r_b : ℂ) * Complex.exp ((θ₀ : ℂ) * Complex.I) - b₀) *
                    ((r_b : ℂ) * Complex.exp ((θ₁ : ℂ) * Complex.I) - b₁)))) ∧
      (∀ (Q₁ Q₂ : ℝ → ℂ) (Δ : ℝ),
        0 ≤ Δ →
        ContinuousOn Q₁ (Set.Icc (0 : ℝ) 1) →
        ContinuousOn Q₂ (Set.Icc (0 : ℝ) 1) →
        (∀ w ∈ Set.Icc (0 : ℝ) 1,
          ‖Q₁ w - Q₀ w‖ < δ_Q ∧ ‖Q₂ w - Q₀ w‖ < δ_Q ∧ ‖Q₁ w - Q₂ w‖ ≤ Δ) →
        ∀ w₀ w₁ : ℂ, ‖w₀‖ ≤ r_b → ‖w₁‖ ≤ r_b →
          ‖slNumerator Q₁ w₀ w₁ - slNumerator Q₂ w₀ w₁‖ ≤ M_num * Δ) ∧
      (∀ (U : Set (ℂ × ℂ)) (Q : ℂ × ℂ → ℝ → ℂ) (a₀ a₁ : ℂ × ℂ → ℂ),
        IsOpen U →
        ContinuousOn (fun q : (ℂ × ℂ) × ℝ => Q q.1 q.2) (U ×ˢ Set.Icc (0 : ℝ) 1) →
        (∀ w ∈ Set.Icc (0 : ℝ) 1, DifferentiableOn ℂ (fun p => Q p w) U) →
        (∀ p ∈ U, ∀ w ∈ Set.Icc (0 : ℝ) 1, ‖Q p w - Q₀ w‖ < δ_Q) →
        DifferentiableOn ℂ a₀ U →
        DifferentiableOn ℂ a₁ U →
        (∀ p ∈ U,
          ‖a₀ p‖ < r_b / 2 ∧
          ‖a₀ p * c0Kernel (Q p) 1 + a₁ p * k0Kernel (Q p) 1‖ < r_b / 2) →
        DifferentiableOn ℂ (fun p => slDivided (Q p) (a₀ p) (a₁ p)) U))
noncomputable def qdDiskMap (d x₀ σ : ℝ) (q : ℂ × ℂ) : ℂ × ℂ :=
  ((x₀ : ℂ) + (σ : ℂ) * Complex.I - ((d : ℂ) * Complex.I / 4) * q.2 ^ 2 + q.1,
   (d : ℂ) * q.2)

noncomputable def qdDiskInv (d x₀ σ : ℝ) (p : ℂ × ℂ) : ℂ × ℂ :=
  (p.1 - ((x₀ : ℂ) + (σ : ℂ) * Complex.I) + (Complex.I / (4 * (d : ℂ))) * p.2 ^ 2,
   p.2 / (d : ℂ))

def qdFullDisk (d : ℝ) : Set (ℂ × ℂ) :=
  Metric.ball (0 : ℂ) (d / 50) ×ˢ Metric.ball (0 : ℂ) (51 / 50)

def qdAnnulus (d : ℝ) : Set (ℂ × ℂ) :=
  Metric.ball (0 : ℂ) (d / 50) ×ˢ { ζ : ℂ | 49 / 50 < ‖ζ‖ ∧ ‖ζ‖ < 51 / 50 }

def qdAnnulusUp (d : ℝ) : Set (ℂ × ℂ) :=
  { q : ℂ × ℂ | q ∈ qdAnnulus d ∧ -‖q.2‖ / 20 < q.2.im }

def qdAnnulusLo (d : ℝ) : Set (ℂ × ℂ) :=
  { q : ℂ × ℂ | q ∈ qdAnnulus d ∧ q.2.im < ‖q.2‖ / 20 }

noncomputable def qdStepShift (d : ℝ) (q : ℂ × ℂ) : ℂ × ℂ :=
  (q.1 + ((d / 100 : ℝ) : ℂ) * Complex.I, q.2)

noncomputable def qdStepShiftInv (d : ℝ) (q : ℂ × ℂ) : ℂ × ℂ :=
  (q.1 - ((d / 100 : ℝ) : ℂ) * Complex.I, q.2)

noncomputable def qdCollarShiftMap (b_shift : ℂ → ℂ) (p : ℂ × ℂ) : ℂ × ℂ :=
  (p.1 - b_shift p.2, p.2)

noncomputable def qdCollarUnshiftMap (b_shift : ℂ → ℂ) (p : ℂ × ℂ) : ℂ × ℂ :=
  (p.1 + b_shift p.2, p.2)

noncomputable def qdWallPatchToQuad (b_shift : ℂ → ℂ) (d x₀ H : ℝ) (p : ℂ × ℂ) : ℂ × ℂ :=
  qdDiskInv d x₀ H (qdCollarUnshiftMap b_shift p)

def qdBridgeDisk (d : ℝ) : Set ℂ :=
  Metric.ball (-((d / 200 : ℝ) : ℂ) * Complex.I) (d / 125)

def qdLowerHalfDisk (d ε : ℝ) : Set ℂ :=
  { w : ℂ | ‖w‖ < (9 / 500 : ℝ) * d ∧ w.im < -ε / 8 }

def qdWallPatchBidisk (x₀ H ε : ℝ) : Set (ℂ × ℂ) :=
  { p : ℂ × ℂ |
    ‖p.1 - ((x₀ : ℂ) + (H : ℂ) * Complex.I)‖ < ε ∧
    ‖p.2 - ((0 : ℝ) : ℂ)‖ < ε }

def qdWallPatchOverlap (x₀ H ε δ : ℝ) : Set (ℂ × ℂ) :=
  { p : ℂ × ℂ |
    |p.1.re - x₀| < ε / 4 ∧
    |p.1.im - (H - ε / 2)| < ε / 4 ∧
    ‖p.2 - ((0 : ℝ) : ℂ)‖ < δ }

def QdHasContTwoSidedInvOn (Φ Φ_inv : ℂ × ℂ → ℂ × ℂ) (U W : Set (ℂ × ℂ)) : Prop :=
  IsOpen U ∧ IsOpen W ∧ DifferentiableOn ℂ Φ U ∧ Set.MapsTo Φ U W ∧
  ContinuousOn Φ_inv W ∧ (∀ p ∈ U, Φ_inv (Φ p) = p) ∧ (∀ q ∈ W, Φ (Φ_inv q) = q)

structure QdMero2DPullbackGluingToolkit : Prop where
  eq_symm : ∀ {W₁ W₂ : Set (ℂ × ℂ)} {F₁ : MeroOn2D W₁} {F₂ : MeroOn2D W₂}
      {U : Set (ℂ × ℂ)},
    MeroEqOn F₁ F₂ U → MeroEqOn F₂ F₁ U
  eq_trans : ∀ {W₁ W₂ W₃ : Set (ℂ × ℂ)} {F₁ : MeroOn2D W₁} {F₂ : MeroOn2D W₂}
      {F₃ : MeroOn2D W₃} {U : Set (ℂ × ℂ)},
    MeroEqOn F₁ F₂ U → MeroEqOn F₂ F₃ U → MeroEqOn F₁ F₃ U
  eq_of_isPreconnected : ∀ {W₁ W₂ U V : Set (ℂ × ℂ)} {F₁ : MeroOn2D W₁} {F₂ : MeroOn2D W₂},
    IsOpen U → IsPreconnected U → U ⊆ W₁ ∩ W₂ →
    IsOpen V → V.Nonempty → V ⊆ U →
    MeroEqOn F₁ F₂ V → MeroEqOn F₁ F₂ U
  glue_two : ∀ {U₁ U₂ U : Set (ℂ × ℂ)},
    IsOpen U₁ → IsOpen U₂ → U = U₁ ∪ U₂ →
    ∀ (G₁ : MeroOn2D U₁) (G₂ : MeroOn2D U₂),
      MeroEqOn G₁ G₂ (U₁ ∩ U₂) →
      ∃ G : MeroOn2D U, MeroEqOn G G₁ U₁ ∧ MeroEqOn G G₂ U₂
  exists_pullback : ∀ {U W : Set (ℂ × ℂ)} {Φ Φ_inv : ℂ × ℂ → ℂ × ℂ},
    QdHasContTwoSidedInvOn Φ Φ_inv U W →
    ∀ F : MeroOn2D W, ∃ G : MeroOn2D U, MeroEqOnPullback G F Φ U
  pullback_id_self : ∀ {W : Set (ℂ × ℂ)} (F : MeroOn2D W),
    MeroEqOnPullback F F id W
  pullback_congr : ∀ {W₁ W₂ W₃ U V : Set (ℂ × ℂ)} {G₁ : MeroOn2D W₁}
      {G₂ : MeroOn2D W₂} {F : MeroOn2D W₃} {Φ Φ' : ℂ × ℂ → ℂ × ℂ},
    IsOpen V → V ⊆ U → DifferentiableOn ℂ Φ' V → (∀ q ∈ V, Φ' q = Φ q) →
    MeroEqOn G₂ G₁ V → MeroEqOnPullback G₁ F Φ U →
    MeroEqOnPullback G₂ F Φ' V
  pullback_comp : ∀ {W₁ W₂ W₃ U₁ U₂ V : Set (ℂ × ℂ)} {G₁ : MeroOn2D W₁}
      {G₂ : MeroOn2D W₂} {G₃ : MeroOn2D W₃} {Φ₁ Φ₁_inv Φ₂ : ℂ × ℂ → ℂ × ℂ},
    QdHasContTwoSidedInvOn Φ₁ Φ₁_inv U₁ W₂ →
    DifferentiableOn ℂ Φ₂ U₂ →
    IsOpen V → V ⊆ U₁ → Set.MapsTo Φ₁ V U₂ →
    MeroEqOnPullback G₁ G₂ Φ₁ U₁ → MeroEqOnPullback G₂ G₃ Φ₂ U₂ →
    MeroEqOnPullback G₁ G₃ (Φ₂ ∘ Φ₁) V
  pullback_meroEqOn : ∀ {W₁ W₂ W₃ W₄ U₁ U₂ V O : Set (ℂ × ℂ)}
      {G₁ : MeroOn2D W₁} {G₂ : MeroOn2D W₂} {F₁ : MeroOn2D W₃} {F₂ : MeroOn2D W₄}
      {Φ₁ Φ₁_inv Φ₂ : ℂ × ℂ → ℂ × ℂ},
    IsOpen V → V ⊆ U₁ ∩ U₂ →
    QdHasContTwoSidedInvOn Φ₁ Φ₁_inv V W₃ →
    (∀ q ∈ V, Φ₂ q = Φ₁ q) →
    MeroEqOnPullback G₁ F₁ Φ₁ U₁ → MeroEqOnPullback G₂ F₂ Φ₂ U₂ →
    MeroEqOn F₁ F₂ O → Set.MapsTo Φ₁ V O →
    MeroEqOn G₁ G₂ V
  pullback_of_isPreconnected : ∀ {W₁ W₂ U V : Set (ℂ × ℂ)}
      {F₁ : MeroOn2D W₁} {F₂ : MeroOn2D W₂} {Φ Φ_inv : ℂ × ℂ → ℂ × ℂ},
    IsPreconnected U → U ⊆ W₁ →
    QdHasContTwoSidedInvOn Φ Φ_inv U W₂ →
    IsOpen V → V.Nonempty → V ⊆ U →
    MeroEqOnPullback F₁ F₂ Φ V → MeroEqOnPullback F₁ F₂ Φ U
def PointRecPsSqrtLawsProp : Prop :=
  PowerSeries.constantCoeff pointArcPsSqrt1p = 1 ∧
  PowerSeries.constantCoeff pointArcPsInvSqrt1p = 1 ∧
  pointArcPsSqrt1p ^ 2 = 1 + PowerSeries.X ∧
  pointArcPsSqrt1p * pointArcPsInvSqrt1p = 1

structure PointRecSqrtSplitToolkit : Prop where
  psSqrt1p_deriv :
    PowerSeries.derivative pointArcPsSqrt1p =
      PowerSeries.C (1 / 2 : ℂ) * pointArcPsInvSqrt1p ∧
    PowerSeries.derivative pointArcPsInvSqrt1p =
      PowerSeries.C (-1 / 2 : ℂ) * pointArcPsInvSqrt1p ^ 3
  unit_sqrt_2D1D :
    ∀ (ℓ_star : ℂ) (Q L L_inv : MvPowerSeries (Fin 2) (PowerSeries ℂ)),
      ℓ_star ≠ 0 →
      L ^ 2 = Q →
      L_inv * L = 1 →
      PowerSeries.constantCoeff (MvPowerSeries.coeff 0 L) = ℓ_star →
      let U := (Q - MvPowerSeries.C (PowerSeries.C (ℓ_star ^ 2))) *
        MvPowerSeries.C (PowerSeries.C ((ℓ_star ^ 2)⁻¹))
      PowerSeries.coeff 0 (MvPowerSeries.coeff 0 U) = 0 ∧
      L = MvPowerSeries.C (PowerSeries.C ℓ_star) *
        pointArcCompConst2D1D pointArcPsSqrt1p U ∧
      L_inv = MvPowerSeries.C (PowerSeries.C ℓ_star⁻¹) *
        pointArcCompConst2D1D pointArcPsInvSqrt1p U
  unit_sqrt_2D :
    ∀ (ℓ_star : ℂ) (Q₀ L₀ L₀_inv : MvPowerSeries (Fin 2) ℂ),
      ℓ_star ≠ 0 →
      L₀ ^ 2 = Q₀ →
      L₀_inv * L₀ = 1 →
      MvPowerSeries.coeff 0 L₀ = ℓ_star →
      let U₀ := (Q₀ - MvPowerSeries.C (ℓ_star ^ 2)) * MvPowerSeries.C ((ℓ_star ^ 2)⁻¹)
      MvPowerSeries.coeff 0 U₀ = 0 ∧
      L₀ = MvPowerSeries.C ℓ_star * compPowerSeries2D pointArcPsSqrt1p U₀ ∧
      L₀_inv = MvPowerSeries.C ℓ_star⁻¹ * compPowerSeries2D pointArcPsInvSqrt1p U₀
  ab_split_unique :
    ∀ (U V : PowerSeries ℂ),
      PowerSeries.coeff 0 U = 0 →
      compPowerSeries2D U (MvPowerSeries.X 0) +
        compPowerSeries2D V (MvPowerSeries.X 0 + MvPowerSeries.X 1) = 0 →
      U = 0 ∧ V = 0

open Classical in
noncomputable def pointRecLiftArcFn (F : Subfield ℂ) (Φ : ↥F →+* PowerSeries ℂ) (z : ℂ) :
    PowerSeries ℂ :=
  if hz : z ∈ F then Φ ⟨z, hz⟩ else PowerSeries.C z

noncomputable def pointRecLiftMv2D (F : Subfield ℂ) (Φ : ↥F →+* PowerSeries ℂ)
    (Ψ : MvPowerSeries (Fin 2) ℂ) : MvPowerSeries (Fin 2) (PowerSeries ℂ) :=
  fun d => pointRecLiftArcFn F Φ (MvPowerSeries.coeff d Ψ)

noncomputable def pointRecJetSeq (A : ℕ → PowerSeries ℂ) (Δ : PowerSeries ℂ) (l : ℕ) :
    PowerSeries ℂ :=
  PowerSeries.mk (fun n =>
    PowerSeries.coeff l
      (∑ m ∈ Finset.range (l + 1),
        PowerSeries.C (1 / ((n.factorial : ℂ) * (m.factorial : ℂ))) * A (n + m) * (-Δ) ^ m))

noncomputable def pointRecFormalU (F : Subfield ℂ) (Φ : ↥F →+* PowerSeries ℂ)
    (S_ab : MvPowerSeries (Fin 2) ℂ) (l : ℕ) : PowerSeries ℂ :=
  if l = 0 then 0
  else PowerSeries.mk (fun n =>
    if n = 0 then 0
    else PowerSeries.coeff l (pointRecLiftArcFn F Φ (MvPowerSeries.coeff (Finsupp.single 0 n) S_ab)))

noncomputable def pointRecFormalV (F : Subfield ℂ) (Φ : ↥F →+* PowerSeries ℂ)
    (S_ab : MvPowerSeries (Fin 2) ℂ) (l : ℕ) : PowerSeries ℂ :=
  if l = 0 then 0
  else PowerSeries.mk (fun n =>
    PowerSeries.coeff l (pointRecLiftArcFn F Φ (MvPowerSeries.coeff (Finsupp.single 1 n) S_ab)))

structure PointRecFormalLiftToolkit : Prop where
  jetSeq_zero :
    ∀ (A : ℕ → PowerSeries ℂ) (Δ : PowerSeries ℂ) (n : ℕ),
      PowerSeries.coeff n (pointRecJetSeq A Δ 0) =
        PowerSeries.constantCoeff (A n) / (n.factorial : ℂ)
  jetSeq_deriv :
    ∀ (A : ℕ → PowerSeries ℂ) (Δ : PowerSeries ℂ) (l : ℕ),
      PowerSeries.derivative (pointRecJetSeq A Δ l) =
        pointRecJetSeq (fun m => A (m + 1)) Δ l
  jetSeq_eq_C_of_zero_shift :
    ∀ (A : ℕ → PowerSeries ℂ),
      (∀ l : ℕ, 1 ≤ l → pointRecJetSeq A 0 l = 0) →
      ∀ m : ℕ, A m = PowerSeries.C (PowerSeries.constantCoeff (A m))
  liftArcFn_props :
    ∀ (K F : Subfield ℂ) (Φ : ↥F →+* PowerSeries ℂ) (hKF : K ≤ F),
      (∀ (x : ℂ) (hx : x ∈ K), Φ ⟨x, hKF hx⟩ = PowerSeries.C x) →
      (∀ y : ↥F, PowerSeries.constantCoeff (Φ y) = (y : ℂ)) →
      (∀ z : ℂ, PowerSeries.constantCoeff (pointRecLiftArcFn F Φ z) = z) ∧
      (∀ x ∈ K, pointRecLiftArcFn F Φ x = PowerSeries.C x) ∧
      (∀ x ∈ F, ∀ y ∈ F,
        pointRecLiftArcFn F Φ (x + y) =
          pointRecLiftArcFn F Φ x + pointRecLiftArcFn F Φ y ∧
        pointRecLiftArcFn F Φ (x - y) =
          pointRecLiftArcFn F Φ x - pointRecLiftArcFn F Φ y ∧
        pointRecLiftArcFn F Φ (x * y) =
          pointRecLiftArcFn F Φ x * pointRecLiftArcFn F Φ y) ∧
      (∀ z ∈ F, z ≠ 0 →
        (pointRecLiftArcFn F Φ z) ^ 2 = (PowerSeries.C z) ^ 2 →
        pointRecLiftArcFn F Φ z = PowerSeries.C z)
  liftMv2D_ring :
    ∀ (F : Subfield ℂ) (Φ : ↥F →+* PowerSeries ℂ),
      (∀ c : ℂ,
        pointRecLiftMv2D F Φ (MvPowerSeries.C c) =
          MvPowerSeries.C (pointRecLiftArcFn F Φ c)) ∧
      (∀ Ψ₁ Ψ₂ : MvPowerSeries (Fin 2) ℂ,
        (∀ d, MvPowerSeries.coeff d Ψ₁ ∈ F) →
        (∀ d, MvPowerSeries.coeff d Ψ₂ ∈ F) →
        pointRecLiftMv2D F Φ (Ψ₁ + Ψ₂) =
          pointRecLiftMv2D F Φ Ψ₁ + pointRecLiftMv2D F Φ Ψ₂ ∧
        pointRecLiftMv2D F Φ (Ψ₁ - Ψ₂) =
          pointRecLiftMv2D F Φ Ψ₁ - pointRecLiftMv2D F Φ Ψ₂ ∧
        pointRecLiftMv2D F Φ (Ψ₁ * Ψ₂) =
          pointRecLiftMv2D F Φ Ψ₁ * pointRecLiftMv2D F Φ Ψ₂)
  liftMv2D_comp_recenter :
    ∀ (K F : Subfield ℂ) (Φ : ↥F →+* PowerSeries ℂ) (hKF : K ≤ F),
      (∀ (x : ℂ) (hx : x ∈ K), Φ ⟨x, hKF hx⟩ = PowerSeries.C x) →
      ∀ (H_star : ℕ → ℂ) (Δ : PowerSeries ℂ) (Ψ : MvPowerSeries (Fin 2) ℂ),
        (∀ m, H_star m ∈ F) →
        PowerSeries.constantCoeff Δ = 0 →
        MvPowerSeries.coeff 0 Ψ = 0 →
        (∀ d, MvPowerSeries.coeff d Ψ ∈ F) →
        pointRecLiftMv2D F Φ
            (compPowerSeries2D (PowerSeries.mk (fun n => H_star n / (n.factorial : ℂ))) Ψ) =
          pointArcComp2D1D
            (pointRecJetSeq (fun m => pointRecLiftArcFn F Φ (H_star m)) Δ)
            (MvPowerSeries.C Δ + pointRecLiftMv2D F Φ Ψ)
  liftMv2D_comp2D_ab_split :
    ∀ (K F : Subfield ℂ) (Φ : ↥F →+* PowerSeries ℂ) (hKF : K ≤ F),
      (∀ (x : ℂ) (hx : x ∈ K), Φ ⟨x, hKF hx⟩ = PowerSeries.C x) →
      ∀ (S_ab : MvPowerSeries (Fin 2) ℂ),
        (∀ d, MvPowerSeries.coeff d S_ab ∈ F) →
        (∀ d : Fin 2 →₀ ℕ, 1 ≤ d 0 → 1 ≤ d 1 → MvPowerSeries.coeff d S_ab ∈ K) →
        ∀ l : ℕ, 1 ≤ l →
          PowerSeries.coeff 0 (pointRecFormalU F Φ S_ab l) = 0 ∧
          pointArcSlice2D1D l
              (pointRecLiftMv2D F Φ
                (pointArcComp2D S_ab (MvPowerSeries.X 0)
                  (MvPowerSeries.X 0 + MvPowerSeries.X 1))) =
            compPowerSeries2D (pointRecFormalU F Φ S_ab l) (MvPowerSeries.X 0) +
              compPowerSeries2D (pointRecFormalV F Φ S_ab l)
                (MvPowerSeries.X 0 + MvPowerSeries.X 1)

noncomputable def pointRecDx0 {k : ℕ} (x_star : Fin (k + 1) → ℂ)
    (β₀ : Fin (k + 1) → MvPowerSeries (Fin 2) ℂ) (i : Fin k) : MvPowerSeries (Fin 2) ℂ :=
  MvPowerSeries.C (x_star i.succ - x_star i.castSucc) + (β₀ i.succ - β₀ i.castSucc)

noncomputable def pointRecDy0 {k : ℕ} (f₀ : Fin (k + 1) → PowerSeries ℂ)
    (β₀ : Fin (k + 1) → MvPowerSeries (Fin 2) ℂ) (i : Fin k) : MvPowerSeries (Fin 2) ℂ :=
  compPowerSeries2D (f₀ i.succ) (β₀ i.succ) - compPowerSeries2D (f₀ i.castSucc) (β₀ i.castSucc)

noncomputable def pointRecEdgeSq0 {k : ℕ} (x_star : Fin (k + 1) → ℂ)
    (f₀ : Fin (k + 1) → PowerSeries ℂ) (β₀ : Fin (k + 1) → MvPowerSeries (Fin 2) ℂ)
    (i : Fin k) : MvPowerSeries (Fin 2) ℂ :=
  (pointRecDx0 x_star β₀ i) ^ 2 + (pointRecDy0 f₀ β₀ i) ^ 2

noncomputable def pointRecEdgeRel0 {k : ℕ} (ℓ_star : Fin k → ℂ) (x_star : Fin (k + 1) → ℂ)
    (f₀ : Fin (k + 1) → PowerSeries ℂ) (β₀ : Fin (k + 1) → MvPowerSeries (Fin 2) ℂ)
    (i : Fin k) : MvPowerSeries (Fin 2) ℂ :=
  (pointRecEdgeSq0 x_star f₀ β₀ i - MvPowerSeries.C ((ℓ_star i) ^ 2)) *
    MvPowerSeries.C (((ℓ_star i) ^ 2)⁻¹)

noncomputable def pointRecLen0 {k : ℕ} (ℓ_star : Fin k → ℂ) (x_star : Fin (k + 1) → ℂ)
    (f₀ : Fin (k + 1) → PowerSeries ℂ) (β₀ : Fin (k + 1) → MvPowerSeries (Fin 2) ℂ)
    (i : Fin k) : MvPowerSeries (Fin 2) ℂ :=
  MvPowerSeries.C (ℓ_star i) *
    compPowerSeries2D pointArcPsSqrt1p (pointRecEdgeRel0 ℓ_star x_star f₀ β₀ i)

noncomputable def pointRecInvLen0 {k : ℕ} (ℓ_star : Fin k → ℂ) (x_star : Fin (k + 1) → ℂ)
    (f₀ : Fin (k + 1) → PowerSeries ℂ) (β₀ : Fin (k + 1) → MvPowerSeries (Fin 2) ℂ)
    (i : Fin k) : MvPowerSeries (Fin 2) ℂ :=
  MvPowerSeries.C ((ℓ_star i)⁻¹) *
    compPowerSeries2D pointArcPsInvSqrt1p (pointRecEdgeRel0 ℓ_star x_star f₀ β₀ i)

noncomputable def pointRecWeight0 {k : ℕ} (ℓ_star : Fin k → ℂ) (x_star : Fin (k + 1) → ℂ)
    (f₀ : Fin (k + 1) → PowerSeries ℂ) (β₀ : Fin (k + 1) → MvPowerSeries (Fin 2) ℂ)
    (r : Fin (k - 1)) : MvPowerSeries (Fin 2) ℂ :=
  let i_L : Fin k := ⟨r.1, by have := r.2; omega⟩
  let i_R : Fin k := ⟨r.1 + 1, by have := r.2; omega⟩
  pointRecDy0 f₀ β₀ i_L * pointRecInvLen0 ℓ_star x_star f₀ β₀ i_L -
    pointRecDy0 f₀ β₀ i_R * pointRecInvLen0 ℓ_star x_star f₀ β₀ i_R

noncomputable def pointRecGrad0 {k : ℕ} (ℓ_star : Fin k → ℂ) (x_star : Fin (k + 1) → ℂ)
    (f₀ : Fin (k + 1) → PowerSeries ℂ) (β₀ : Fin (k + 1) → MvPowerSeries (Fin 2) ℂ)
    (r : Fin (k - 1)) : MvPowerSeries (Fin 2) ℂ :=
  let i_L : Fin k := ⟨r.1, by have := r.2; omega⟩
  let i_R : Fin k := ⟨r.1 + 1, by have := r.2; omega⟩
  (pointRecDx0 x_star β₀ i_L +
      pointRecDy0 f₀ β₀ i_L *
        compPowerSeries2D (PowerSeries.derivative (f₀ i_L.succ)) (β₀ i_L.succ)) *
      pointRecInvLen0 ℓ_star x_star f₀ β₀ i_L -
    (pointRecDx0 x_star β₀ i_R +
      pointRecDy0 f₀ β₀ i_R *
        compPowerSeries2D (PowerSeries.derivative (f₀ i_R.castSucc)) (β₀ i_R.castSucc)) *
      pointRecInvLen0 ℓ_star x_star f₀ β₀ i_R

noncomputable def pointRecHess0 {k : ℕ} (ℓ_star : Fin k → ℂ) (x_star : Fin (k + 1) → ℂ)
    (f₀ : Fin (k + 1) → PowerSeries ℂ) (β₀ : Fin (k + 1) → MvPowerSeries (Fin 2) ℂ)
    (r s : Fin (k - 1)) : MvPowerSeries (Fin 2) ℂ :=
  let i_L : Fin k := ⟨r.1, by have := r.2; omega⟩
  let i_R : Fin k := ⟨r.1 + 1, by have := r.2; omega⟩
  let Δx_L := pointRecDx0 x_star β₀ i_L
  let ΔY_L := pointRecDy0 f₀ β₀ i_L
  let L_L := pointRecLen0 ℓ_star x_star f₀ β₀ i_L
  let invL_L := pointRecInvLen0 ℓ_star x_star f₀ β₀ i_L
  let F'_L_succ := compPowerSeries2D (PowerSeries.derivative (f₀ i_L.succ)) (β₀ i_L.succ)
  let F'_L_cast := compPowerSeries2D (PowerSeries.derivative (f₀ i_L.castSucc)) (β₀ i_L.castSucc)
  let F''_L_succ :=
    compPowerSeries2D (PowerSeries.derivative (PowerSeries.derivative (f₀ i_L.succ))) (β₀ i_L.succ)
  let n_L_succ := Δx_L + ΔY_L * F'_L_succ
  let n_L_cast := Δx_L + ΔY_L * F'_L_cast
  let Δx_R := pointRecDx0 x_star β₀ i_R
  let ΔY_R := pointRecDy0 f₀ β₀ i_R
  let L_R := pointRecLen0 ℓ_star x_star f₀ β₀ i_R
  let invL_R := pointRecInvLen0 ℓ_star x_star f₀ β₀ i_R
  let F'_R_cast := compPowerSeries2D (PowerSeries.derivative (f₀ i_R.castSucc)) (β₀ i_R.castSucc)
  let F'_R_succ := compPowerSeries2D (PowerSeries.derivative (f₀ i_R.succ)) (β₀ i_R.succ)
  let F''_R_cast :=
    compPowerSeries2D (PowerSeries.derivative (PowerSeries.derivative (f₀ i_R.castSucc)))
      (β₀ i_R.castSucc)
  let n_R_cast := Δx_R + ΔY_R * F'_R_cast
  let n_R_succ := Δx_R + ΔY_R * F'_R_succ
  if r.1 = s.1 then
    (((1 + F'_L_succ ^ 2 + ΔY_L * F''_L_succ) * L_L ^ 2 - n_L_succ ^ 2) * invL_L ^ 3) +
      (((1 + F'_R_cast ^ 2 - ΔY_R * F''_R_cast) * L_R ^ 2 - n_R_cast ^ 2) * invL_R ^ 3)
  else if s.1 = r.1 + 1 then
    ((-1 - F'_R_succ * F'_R_cast) * L_R ^ 2 + n_R_cast * n_R_succ) * invL_R ^ 3
  else if r.1 = s.1 + 1 then
    ((-1 - F'_L_cast * F'_L_succ) * L_L ^ 2 + n_L_succ * n_L_cast) * invL_L ^ 3
  else
    0

structure PointRecTopSplitToolkit : Prop where
  len_top_split :
    ∀ {k : ℕ} (_hk : 2 ≤ k) (ℓ_star : Fin k → ℂ) (x_star : Fin (k + 1) → ℂ)
      (f_full : Fin (k + 1) → ℕ → PowerSeries ℂ)
      (β_full : ℕ → Fin (k + 1) → MvPowerSeries (Fin 2) ℂ),
      (∀ i : Fin k, ℓ_star i ≠ 0) →
      (∀ r : Fin (k + 1), MvPowerSeries.coeff 0 (β_full 0 r) = 0) →
      (∀ i : Fin k,
        (ℓ_star i) ^ 2 =
          (x_star i.succ - x_star i.castSucc) ^ 2 +
            (PowerSeries.constantCoeff (f_full i.succ 0) -
              PowerSeries.constantCoeff (f_full i.castSucc 0)) ^ 2) →
      (∀ J : ℕ, f_full 0 (J + 1) = 0 ∧ f_full (Fin.last k) (J + 1) = 0) →
      (∀ J : ℕ, β_full (J + 1) 0 = 0 ∧ β_full (J + 1) (Fin.last k) = 0) →
      ∀ J : ℕ,
        pointArcSlice2D1D (J + 1) (pointArcFormalLen2D1D ℓ_star x_star f_full β_full) =
          pointArcSlice2D1D (J + 1)
              (pointArcFormalLen2D1D ℓ_star x_star
                (pointArcTruncGraph J f_full) (pointArcTruncBeta J β_full)) +
            (∑ r : Fin (k - 1),
              pointRecWeight0 ℓ_star x_star (fun u => f_full u 0) (β_full 0) r *
                compPowerSeries2D
                  (f_full ⟨r.1 + 1, by have := r.2; omega⟩ (J + 1))
                  (β_full 0 ⟨r.1 + 1, by have := r.2; omega⟩)) +
            ∑ r : Fin (k - 1),
              pointRecGrad0 ℓ_star x_star (fun u => f_full u 0) (β_full 0) r *
                β_full (J + 1) ⟨r.1 + 1, by have := r.2; omega⟩
  grad_top_split :
    ∀ {k : ℕ} (_hk : 2 ≤ k) (ℓ_star : Fin k → ℂ) (x_star : Fin (k + 1) → ℂ)
      (f_full : Fin (k + 1) → ℕ → PowerSeries ℂ)
      (β_full : ℕ → Fin (k + 1) → MvPowerSeries (Fin 2) ℂ),
      (∀ i : Fin k, ℓ_star i ≠ 0) →
      (∀ r : Fin (k + 1), MvPowerSeries.coeff 0 (β_full 0 r) = 0) →
      (∀ i : Fin k,
        (ℓ_star i) ^ 2 =
          (x_star i.succ - x_star i.castSucc) ^ 2 +
            (PowerSeries.constantCoeff (f_full i.succ 0) -
              PowerSeries.constantCoeff (f_full i.castSucc 0)) ^ 2) →
      (∀ J : ℕ, β_full (J + 1) 0 = 0 ∧ β_full (J + 1) (Fin.last k) = 0) →
      ∀ (J : ℕ) (r : Fin (k - 1)),
        pointArcSlice2D1D (J + 1) (pointArcFormalGrad2D1D ℓ_star x_star f_full β_full r) =
          pointArcSlice2D1D (J + 1)
              (pointArcFormalGrad2D1D ℓ_star x_star
                (pointArcTruncGraph (J + 1) f_full) (pointArcTruncBeta J β_full) r) +
            ∑ s : Fin (k - 1),
              pointRecHess0 ℓ_star x_star (fun u => f_full u 0) (β_full 0) r s *
                β_full (J + 1) ⟨s.1 + 1, by have := s.2; omega⟩
  slice_pos_zero_of_pos_zero :
    ∀ {k : ℕ} (ℓ_star : Fin k → ℂ) (x_star : Fin (k + 1) → ℂ)
      (f_seq : Fin (k + 1) → ℕ → PowerSeries ℂ)
      (β_seq : ℕ → Fin (k + 1) → MvPowerSeries (Fin 2) ℂ)
      (m : ℕ),
      1 ≤ m →
      (∀ (r : Fin (k + 1)) (l : ℕ), 1 ≤ l → f_seq r l = 0) →
      (∀ (l : ℕ) (r : Fin (k + 1)), 1 ≤ l → β_seq l r = 0) →
      pointArcSlice2D1D m (pointArcFormalLen2D1D ℓ_star x_star f_seq β_seq) = 0 ∧
      ∀ r : Fin (k - 1),
        pointArcSlice2D1D m (pointArcFormalGrad2D1D ℓ_star x_star f_seq β_seq r) = 0
structure DfmcFrozenKernelData (kind : ExpProfileKind) where
  tildePhi : ℂ → ℂ
  G_ker : ℂ → ℂ
  r_reg : ℝ
  r_reg_pos : 0 < r_reg
  r_reg_le_one : r_reg ≤ 1
  tildePhi_holo : DifferentiableOn ℂ tildePhi (Metric.ball (0 : ℂ) 1)
  G_ker_holo : DifferentiableOn ℂ G_ker (Metric.ball (0 : ℂ) 1)
  tildePhi_even : ∀ u ∈ Metric.ball (0 : ℂ) 1, tildePhi (-u) = tildePhi u
  G_ker_even : ∀ u ∈ Metric.ball (0 : ℂ) 1, G_ker (-u) = G_ker u
  tildePhi_zero : tildePhi 0 = 1 / 24
  G_ker_zero : G_ker 0 = 1
  action_eq : ∀ lam J : ℂ, frozenActionP kind lam J = J ^ 3 * tildePhi (lam * J / 2)
  energy_eq : ∀ lam J : ℂ, ‖lam * J / 2‖ < 1 →
    frozenEnergyE kind lam J = (J ^ 3 / 12) * G_ker (lam * J / 2)
  regular_of_small : ∀ lam J : ℂ, J ≠ 0 → ‖lam * J / 2‖ < r_reg →
    IsRegularFrozenState kind lam J
  frozen_action_holo_2d : ∀ (c₀ T : ℂ),
    DifferentiableOn ℂ
      (fun q : ℂ × ℂ =>
        frozenActionP kind (T * c₀ * Complex.exp (-Complex.I * q.1)) q.2)
      { q : ℂ × ℂ | ‖T * c₀ * Complex.exp (-Complex.I * q.1) * q.2 / 2‖ < 1 }
  legendre_deriv_zero : ∀ (V : Set ℂ) (S_star : ℂ → ℂ) (c₀ T : ℂ),
    IsOpen V →
    DifferentiableOn ℂ S_star V →
    (∀ Y ∈ V, ‖T * c₀ * Complex.exp (-Complex.I * S_star Y) * deriv S_star Y / 2‖ < 1) →
    (∀ Y ∈ V,
      deriv (fun Y' =>
        deriv (fun J' =>
          frozenActionP kind (T * c₀ * Complex.exp (-Complex.I * S_star Y')) J')
          (deriv S_star Y')) Y =
      deriv (fun S' =>
        frozenActionP kind (T * c₀ * Complex.exp (-Complex.I * S')) (deriv S_star Y))
        (S_star Y)) →
    ∀ Y ∈ V,
      deriv (fun Y' =>
        frozenEnergyE kind (T * c₀ * Complex.exp (-Complex.I * S_star Y'))
          (deriv S_star Y')) Y = 0

structure DfmcAnalyticModelPackage (kind : ExpProfileKind) where
  ρ_mod : ℝ
  r_lam : ℝ
  ρ_J : ℝ
  C_Δ : ℝ
  Δ₀ : ℂ → ℂ
  ρ_mod_pos : 0 < ρ_mod
  r_lam_pos : 0 < r_lam
  ρ_J_pos : 0 < ρ_J
  ρ_J_lt : ρ_J < 1 / 4
  C_Δ_pos : 0 < C_Δ
  Δ₀_holo : DifferentiableOn ℂ Δ₀ (Metric.ball (0 : ℂ) ρ_mod)
  Δ₀_zero : Δ₀ 0 = 0
  Δ₀_even : ∀ w ∈ Metric.ball (0 : ℂ) ρ_mod, Δ₀ (-w) = Δ₀ w
  Δ₀_bound : ∀ w ∈ Metric.ball (0 : ℂ) ρ_mod, ‖Δ₀ w‖ ≤ C_Δ * ‖w‖ ^ 2
  model_energy : ∀ (w_coeff Y : ℂ),
    ‖w_coeff * Complex.exp (-Complex.I * Y)‖ < ρ_mod →
    frozenEnergyE kind
      (w_coeff * Complex.exp (-Complex.I *
        (Y + Δ₀ (w_coeff * Complex.exp (-Complex.I * Y)))))
      (deriv (fun Y' => Y' + Δ₀ (w_coeff * Complex.exp (-Complex.I * Y'))) Y) = 1 / 12
  regular_on_polydisk : ∀ lam J : ℂ, ‖lam‖ < r_lam → ‖J - 1‖ < ρ_J →
    ‖lam * J / 2‖ < 1 ∧ IsRegularFrozenState kind lam J
  cone_ode_uniqueness : ∀ (w_coeff : ℂ) (D₁ A₁ : ℝ) (S_star : ℂ → ℂ),
    0 < D₁ → 0 < A₁ →
    DifferentiableOn ℂ S_star { Y : ℂ | D₁ < -Y.im ∧ |Y.re| < A₁ * (-Y.im) } →
    Filter.Tendsto
      (fun τ : ℝ => S_star (-(τ : ℂ) * Complex.I) + (τ : ℂ) * Complex.I)
      Filter.atTop (nhds 0) →
    (∀ Y : ℂ, D₁ < -Y.im → |Y.re| < A₁ * (-Y.im) →
      ‖w_coeff * Complex.exp (-Complex.I * Y)‖ < ρ_mod ∧
      ‖w_coeff * Complex.exp (-Complex.I * S_star Y)‖ < r_lam ∧
      ‖deriv S_star Y - 1‖ < ρ_J ∧
      frozenEnergyE kind (w_coeff * Complex.exp (-Complex.I * S_star Y))
        (deriv S_star Y) = 1 / 12) →
    ∀ Y : ℂ, D₁ < -Y.im → |Y.re| < A₁ * (-Y.im) →
      S_star Y = Y + Δ₀ (w_coeff * Complex.exp (-Complex.I * Y))

def DfmcAnchorWitnessAt (X : ExpStripData) (P : ChordActionPackage X)
    (kind : ExpProfileKind) (seq : ExpSequenceData X kind)
    (T_bound D_anc C_anc α A' D_top' : ℝ)
    (N_init : ℕ) (U_phys : ℕ → Set (ℂ × ℂ))
    (s_tilde : ℕ → ℂ × ℂ → ℂ) (δ_base : ℕ → ℝ) : Prop :=
  ∀ n ≥ N_init,
    let s_n : ℂ := (seq.x_seq n : ℂ) + (seq.h_seq n : ℂ) * Complex.I
    let coneSet : Set (ℂ × ℂ) :=
      { p : ℂ × ℂ |
        D_anc < -p.1.im ∧ -p.1.im < D_top' ∧
        |p.1.re| < A' * (-p.1.im) ∧ ‖p.2‖ < T_bound }
    IsOpen (U_phys n) ∧
    0 < δ_base n ∧
    (∀ y t : ℂ, (y, t) ∈ U_phys n → 0 ≤ y.im →
      ∀ τ : ℝ, 0 ≤ τ → τ ≤ y.im →
        ((y.re : ℂ) + (τ : ℂ) * Complex.I, t) ∈ U_phys n) ∧
    (∀ y t : ℂ, (y, t) ∈ U_phys n → (y, -t) ∈ U_phys n) ∧
    DifferentiableOn ℂ (s_tilde n) (U_phys n) ∧
    (∀ p ∈ U_phys n, s_tilde n p ∈ X.D_strip) ∧
    (∀ y t : ℂ, (y, t) ∈ U_phys n → s_tilde n (y, -t) = s_tilde n (y, t)) ∧
    (∀ y t : ℂ, |y.im| < δ_base n → ‖t‖ < T_bound / seq.m_seq n →
      (y, t) ∈ U_phys n ∧ (y, t) ∈ X.Tube ∧ s_tilde n (y, t) = X.𝔰 (y, t)) ∧
    (∀ y : ℂ, (s_n + (seq.ℓ_seq n : ℂ) * y, (0 : ℂ)) ∈ U_phys n →
      D_anc < -y.im → -y.im < D_top' → |y.re| < A' * (-y.im) →
      s_tilde n (s_n + (seq.ℓ_seq n : ℂ) * y, 0) =
        s_n + (seq.ℓ_seq n : ℂ) * y) ∧
    (∀ p ∈ coneSet,
      (s_n + (seq.ℓ_seq n : ℂ) * p.1, p.2 / (seq.m_seq n : ℂ)) ∈ U_phys n ∧
      0 < (s_n + (seq.ℓ_seq n : ℂ) * p.1).im ∧
      ‖(s_tilde n (s_n + (seq.ℓ_seq n : ℂ) * p.1, p.2 / (seq.m_seq n : ℂ)) - s_n) /
          (seq.ℓ_seq n : ℂ) - p.1‖ ≤
        C_anc * ‖p.2‖ ^ 2 * (-p.1.im) ^ (1 - 2 * α)) ∧
    (∀ Y T : ℂ, T ≠ 0 →
      (Y, T) ∈ coneSet →
      (Y - T / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ), T) ∈ coneSet →
      (Y + T / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ), T) ∈ coneSet →
      let t : ℂ := T / (seq.m_seq n : ℂ)
      let y : ℂ := s_n + (seq.ℓ_seq n : ℂ) * Y
      let s_prev : ℂ := s_tilde n (y - t, t)
      let s_curr : ℂ := s_tilde n (y, t)
      let s_next : ℂ := s_tilde n (y + t, t)
      let J_prev : ℂ := (s_curr - s_prev) / t
      let J_curr : ℂ := (s_next - s_curr) / t
      deriv (fun J' => P.p_act s_curr J' t) J_curr -
        t * deriv (fun s' => P.p_act s' J_curr t) s_curr =
        deriv (fun J' => P.p_act s_prev J' t) J_prev)

def DfmcHasAnchorAt (X : ExpStripData) (P : ChordActionPackage X)
    (kind : ExpProfileKind) (seq : ExpSequenceData X kind)
    (T_bound D_anc C_anc α : ℝ) : Prop :=
  ∀ A' D_top' : ℝ, 0 < A' → D_anc + 2 < D_top' →
    ∃ (N_init : ℕ) (U_phys : ℕ → Set (ℂ × ℂ))
      (s_tilde : ℕ → ℂ × ℂ → ℂ) (δ_base : ℕ → ℝ),
      DfmcAnchorWitnessAt X P kind seq T_bound D_anc C_anc α A' D_top'
        N_init U_phys s_tilde δ_base

structure DfmcExtractedLimit (X : ExpStripData) (P : ChordActionPackage X)
    (kind : ExpProfileKind) (seq : ExpSequenceData X kind)
    (D₀ C_anc α A T_max : ℝ) where
  Y_star : ℂ
  T_star : ℂ
  S_star : ℂ → ℂ
  φ : ℕ → ℕ
  F_seq : ℕ → ℂ → ℂ
  T_star_ne : T_star ≠ 0
  T_star_lt : ‖T_star‖ < T_max
  Y_star_mem : D₀ < -Y_star.im ∧ |Y_star.re| < (A + 2) * (-Y_star.im)
  φ_strictMono : StrictMono φ
  S_star_holo : DifferentiableOn ℂ S_star
    { Y : ℂ | D₀ < -Y.im ∧ |Y.re| < (A + 2) * (-Y.im) }
  S_star_bound : ∀ Y : ℂ, D₀ < -Y.im → |Y.re| < (A + 2) * (-Y.im) →
    ‖S_star Y - Y‖ ≤ C_anc * ‖T_star‖ ^ 2 * (-Y.im) ^ (1 - 2 * α)
  F_conv : TendstoLocallyUniformlyOn F_seq S_star Filter.atTop
    { Y : ℂ | D₀ < -Y.im ∧ |Y.re| < (A + 2) * (-Y.im) }
  F_deriv_conv : TendstoLocallyUniformlyOn (fun k => deriv (F_seq k)) (deriv S_star)
    Filter.atTop { Y : ℂ | D₀ < -Y.im ∧ |Y.re| < (A + 2) * (-Y.im) }
  local_holo_and_recurrence :
    ∀ (Y₀ : ℂ) (r₀ : ℝ), 0 < r₀ →
      Metric.closedBall Y₀ (2 * r₀) ⊆
        { Y : ℂ | D₀ < -Y.im ∧ |Y.re| < (A + 2) * (-Y.im) } →
      ∃ K₀ : ℕ, ∀ k ≥ K₀,
        DifferentiableOn ℂ (F_seq k) (Metric.ball Y₀ (2 * r₀)) ∧
        (let n := φ k
         let a_n : ℂ := T_star / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ)
         let t : ℂ := T_star / (seq.m_seq n : ℂ)
         let s_n : ℂ := (seq.x_seq n : ℂ) + (seq.h_seq n : ℂ) * Complex.I
         ‖a_n‖ < r₀ / 2 ∧
         ∀ Y ∈ Metric.ball Y₀ r₀,
           let s_prev := s_n + (seq.ℓ_seq n : ℂ) * F_seq k (Y - a_n)
           let s_curr := s_n + (seq.ℓ_seq n : ℂ) * F_seq k Y
           let J_prev := (F_seq k Y - F_seq k (Y - a_n)) / a_n
           let J_curr := (F_seq k (Y + a_n) - F_seq k Y) / a_n
           deriv (fun J' => P.p_act s_curr J' t) J_curr -
             t * deriv (fun s' => P.p_act s' J_curr t) s_curr =
             deriv (fun J' => P.p_act s_prev J' t) J_prev)
noncomputable def refSteepActionA {X : ExpStripData} (P : ChordActionPackage X)
    (s J t : ℂ) : ℂ :=
  P.p_act s J t - J ^ 3 / 24

noncomputable def refSteepActionDJ {X : ExpStripData} (P : ChordActionPackage X)
    (s J t : ℂ) : ℂ :=
  deriv (fun J' : ℂ => refSteepActionA P s J' t) J

noncomputable def refSteepActionDS {X : ExpStripData} (P : ChordActionPackage X)
    (s J t : ℂ) : ℂ :=
  deriv (fun s' : ℂ => refSteepActionA P s' J t) s

noncomputable def refSteepPerturbG {X : ExpStripData} (P : ChordActionPackage X)
    (s_0 t J : ℂ) : ℂ :=
  refSteepActionDJ P s_0 J t - t * refSteepActionDS P s_0 J t

noncomputable def refSteepResidual {X : ExpStripData} (P : ChordActionPackage X)
    (s_m J_m s_0 t J : ℂ) : ℂ :=
  (1 / 8 : ℂ) * (J ^ 2 - J_m ^ 2) +
    refSteepPerturbG P s_0 t J -
    refSteepActionDJ P s_m J_m t

def refSteepPolydisk (z₀ : ℂ) (r_s r_t : ℝ) : Set (ℂ × ℂ × ℂ) :=
  { q : ℂ × ℂ × ℂ | ‖q.1 - z₀‖ < r_s / 4 ∧ ‖q.2.1 - 1‖ < 1 / 4 ∧ ‖q.2.2‖ < r_t }

noncomputable def refSteepIterJ {X : ExpStripData} (P : ChordActionPackage X)
    (s_m s_0 t : ℂ) : ℕ → ℂ
  | 0 => (s_0 - s_m) / t
  | n + 1 =>
      let u := refSteepIterJ P s_m s_0 t n
      u - (4 : ℂ) * refSteepResidual P s_m ((s_0 - s_m) / t) s_0 t u

noncomputable def refSteepSolJ {X : ExpStripData} (P : ChordActionPackage X)
    (s_m s_0 t : ℂ) : ℂ :=
  Filter.limUnder Filter.atTop (refSteepIterJ P s_m s_0 t)

noncomputable def refSteepChain {X : ExpStripData} (P : ChordActionPackage X)
    (s_init : ℂ × ℂ → ℂ) (y_bot t : ℂ) : ℕ → ℂ × ℂ
  | 0 => (s_init (y_bot, t), s_init (y_bot + t, t))
  | j + 1 =>
      let prev := refSteepChain P s_init y_bot t j
      (prev.2, prev.2 + t * refSteepSolJ P prev.1 prev.2 t)

noncomputable def refSteepPsi {X : ExpStripData} (P : ChordActionPackage X)
    (s_init : ℂ × ℂ → ℂ) (N : ℕ) (y t : ℂ) : ℂ :=
  (refSteepChain P s_init (y - ((N : ℂ) + 1) * t) t N).2

def RefSteepJetProp (X : ExpStripData) (P : ChordActionPackage X) : Prop :=
  (∀ (z₀ : ℂ) (r_s r_t : ℝ), 0 < r_s → 0 < r_t →
    DifferentiableOn ℂ (fun q : ℂ × ℂ × ℂ => P.p_act q.1 q.2.1 q.2.2)
      (refSteepPolydisk z₀ r_s r_t) →
    ∀ s_m J_m s_0 t J : ℂ,
      ‖s_m - z₀‖ < r_s / 4 → ‖J_m - 1‖ < 1 / 4 →
      ‖s_0 - z₀‖ < r_s / 4 → ‖J - 1‖ < 1 / 4 → ‖t‖ < r_t →
      refSteepResidual P s_m J_m s_0 t J =
        (deriv (fun J' => P.p_act s_0 J' t) J -
          t * deriv (fun s' => P.p_act s' J t) s_0) -
        deriv (fun J' => P.p_act s_m J' t) J_m) ∧
  (∀ (z₀ : ℂ) (r_s r_t : ℝ), 0 < r_s → 0 < r_t →
    DifferentiableOn ℂ (fun q : ℂ × ℂ × ℂ => P.p_act q.1 q.2.1 q.2.2)
      (refSteepPolydisk z₀ r_s r_t) →
    ∀ s_m J_m s_0 t J : ℂ,
      ‖s_0 - z₀‖ < r_s / 8 → ‖J - 1‖ < 1 / 8 → ‖t‖ < r_t →
      HasDerivAt (fun J' => refSteepResidual P s_m J_m s_0 t J')
        ((1 / 4 : ℂ) * J + deriv (refSteepPerturbG P s_0 t) J) J) ∧
  (∀ (U : Set (ℂ × ℂ)) (s_fn J_fn : ℂ × ℂ → ℂ),
    IsOpen U →
    DifferentiableOn ℂ s_fn U →
    DifferentiableOn ℂ J_fn U →
    (∀ p₀ ∈ U, ∃ (z₀ : ℂ) (r_s r_t : ℝ), 0 < r_s ∧ 0 < r_t ∧
      DifferentiableOn ℂ (fun q : ℂ × ℂ × ℂ => P.p_act q.1 q.2.1 q.2.2)
        (refSteepPolydisk z₀ r_s r_t) ∧
      ‖s_fn p₀ - z₀‖ < r_s / 8 ∧ ‖J_fn p₀ - 1‖ < 1 / 8 ∧ ‖p₀.2‖ < r_t) →
    DifferentiableOn ℂ (fun p : ℂ × ℂ => refSteepActionDJ P (s_fn p) (J_fn p) p.2) U ∧
    DifferentiableOn ℂ (fun p : ℂ × ℂ => refSteepActionDS P (s_fn p) (J_fn p) p.2) U) ∧
  (∀ (z₀ : ℂ) (r_s r_t ρ_s M_a : ℝ) (s_m s_0 J_m t : ℂ),
    0 < r_s → 0 < r_t → 0 < ρ_s → 0 ≤ M_a →
    DifferentiableOn ℂ (fun q : ℂ × ℂ × ℂ => P.p_act q.1 q.2.1 q.2.2)
      (refSteepPolydisk z₀ r_s r_t) →
    ‖J_m - 1‖ ≤ 1 / 32 → ‖t‖ < r_t →
    (∀ θ ∈ Set.Icc (0 : ℝ) 1,
      ∀ s' ∈ Metric.closedBall ((1 - (θ : ℂ)) * s_m + (θ : ℂ) * s_0) ρ_s,
        ‖s' - z₀‖ < r_s / 8 ∧
        ∀ J' ∈ Metric.closedBall (1 : ℂ) (3 / 32),
          ‖refSteepActionA P s' J' t‖ ≤ M_a) →
    (∀ J ∈ Metric.closedBall J_m (1 / 32),
      ‖deriv (refSteepPerturbG P s_0 t) J‖ ≤
        4096 * M_a + 64 * ‖t‖ * M_a / ρ_s) ∧
    ‖refSteepActionDS P s_0 J_m t‖ ≤ M_a / ρ_s ∧
    ‖refSteepActionDJ P s_0 J_m t - refSteepActionDJ P s_m J_m t‖ ≤
      (32 * M_a / ρ_s) * ‖s_0 - s_m‖)

def IsRefSteepContractivePt (X : ExpStripData) (P : ChordActionPackage X)
    (s_m s_0 t : ℂ) : Prop :=
  t ≠ 0 ∧
  let J_m := (s_0 - s_m) / t
  ‖J_m - 1‖ ≤ 1 / 32 ∧
  (∃ (z₀ : ℂ) (r_s r_t : ℝ), 0 < r_s ∧ 0 < r_t ∧
    DifferentiableOn ℂ (fun q : ℂ × ℂ × ℂ => P.p_act q.1 q.2.1 q.2.2)
      (refSteepPolydisk z₀ r_s r_t) ∧
    ‖s_m - z₀‖ < r_s / 8 ∧ ‖s_0 - z₀‖ < r_s / 8 ∧ ‖t‖ < r_t) ∧
  (∀ J ∈ Metric.closedBall J_m (1 / 32),
    ‖deriv (refSteepPerturbG P s_0 t) J‖ ≤ 1 / 32) ∧
  ‖refSteepResidual P s_m J_m s_0 t J_m‖ ≤ 1 / 256

def RefSteepSolverProp (X : ExpStripData) (P : ChordActionPackage X) : Prop :=
  (∀ s_m s_0 t : ℂ,
    IsRefSteepContractivePt X P s_m s_0 t →
    let J_m := (s_0 - s_m) / t
    let J_p := refSteepSolJ P s_m s_0 t
    ‖J_p - J_m‖ ≤ 8 * ‖refSteepResidual P s_m J_m s_0 t J_m‖ ∧
    deriv (fun J' => P.p_act s_0 J' t) J_p -
      t * deriv (fun s' => P.p_act s' J_p t) s_0 =
      deriv (fun J' => P.p_act s_m J' t) J_m ∧
    (∀ J' ∈ Metric.closedBall J_m (1 / 32),
      deriv (fun J'' => P.p_act s_0 J'' t) J' -
        t * deriv (fun s' => P.p_act s' J' t) s_0 =
        deriv (fun J'' => P.p_act s_m J'' t) J_m →
      J' = J_p)) ∧
  (∀ (U : Set (ℂ × ℂ)) (s_m s_0 : ℂ × ℂ → ℂ),
    IsOpen U →
    DifferentiableOn ℂ s_m U →
    DifferentiableOn ℂ s_0 U →
    (∀ p ∈ U, IsRefSteepContractivePt X P (s_m p) (s_0 p) p.2) →
    DifferentiableOn ℂ (fun p : ℂ × ℂ => refSteepSolJ P (s_m p) (s_0 p) p.2) U)

def RefSteepStepAdmProp (X : ExpStripData) (P : ChordActionPackage X) : Prop :=
  (∀ β x_start Δ : ℝ, ∀ M : ℕ,
    1 < β → 0 < x_start → 0 < Δ →
    Δ * (∑ j ∈ Finset.range M, (x_start + ((j + 1 : ℕ) : ℝ) * Δ) ^ (-β)) ≤
      x_start ^ (1 - β) / (β - 1)) ∧
  (∀ (α γ_steep x₀ h_ref m_steep d δ_ceil Δ_slab r M_scale C_init : ℝ)
     (s_init : ℂ × ℂ → ℂ),
    1 / 2 < α → α < 1 → 0 < γ_steep → γ_steep < 1 / 4 →
    0 < m_steep → 0 < d → 0 < Δ_slab → 2 * Δ_slab ≤ δ_ceil →
    0 < r → 0 < M_scale → 0 ≤ C_init →
    C_init * (1 + 8 * δ_ceil / (γ_steep * Δ_slab)) ≤
      M_scale ^ 2 * δ_ceil ^ (1 - 2 * α) →
    let L_in : ℝ := 2 * m_steep + 2 / γ_steep + 4
    let S_init : Set (ℂ × ℂ) :=
      { p : ℂ × ℂ |
        δ_ceil - Δ_slab < h_ref - p.1.im ∧ h_ref - p.1.im < δ_ceil ∧
        |p.1.re - x₀| < L_in * (h_ref - p.1.im) ∧
        ‖p.2‖ < 12 * r * (δ_ceil / d) ^ α }
    DifferentiableOn ℂ s_init S_init →
    (∀ y t : ℂ, (y, t) ∈ S_init → ‖s_init (y, t) - y‖ ≤ C_init * ‖t‖ ^ 2) →
    ∀ z_bot t : ℂ,
      γ_steep * ‖t‖ < t.im →
      ‖t‖ < 10 * r * (δ_ceil / d) ^ α →
      δ_ceil - (31 / 32) * Δ_slab < h_ref - (z_bot + t).im →
      h_ref - z_bot.im < δ_ceil - (1 / 32) * Δ_slab →
      |(z_bot + t).re - x₀| ≤ (m_steep + 1 / γ_steep) * (h_ref - (z_bot + t).im) →
      (z_bot, t) ∈ S_init ∧
      (z_bot + t, t) ∈ S_init ∧
      ‖s_init (z_bot, t) - z_bot‖ ≤ ‖t‖ ^ 2 * M_scale ^ 2 * δ_ceil ^ (1 - 2 * α) ∧
      ‖s_init (z_bot + t, t) - (z_bot + t)‖ ≤
        ‖t‖ ^ 2 * M_scale ^ 2 * δ_ceil ^ (1 - 2 * α) ∧
      ‖(s_init (z_bot + t, t) - s_init (z_bot, t)) / t - 1‖ ≤
        ‖t‖ ^ 2 * M_scale ^ 2 * δ_ceil ^ (-2 * α)) ∧
  (∃ (η_adm C_res : ℝ), 0 < η_adm ∧ η_adm ≤ 1 / 6400 ∧ 0 < C_res ∧
    ∀ (α γ_steep x₀ h_ref m_steep d δ_ceil r M_scale : ℝ),
      1 / 2 < α → α < 1 → 0 < γ_steep → γ_steep < 1 / 4 →
      0 < m_steep → 0 < d → 0 < δ_ceil → 0 < r → 0 < M_scale →
      r / d ≤ η_adm →
      r * d ^ (-α) * M_scale ≤ η_adm →
      (let L_in : ℝ := 2 * m_steep + 2 / γ_steep + 4
       (∀ s : ℂ, d / 10 ≤ h_ref - s.im → h_ref - s.im ≤ (5 / 4) * δ_ceil →
         |s.re - x₀| ≤ L_in * (h_ref - s.im) →
         s ∈ X.D_strip ∧
         ‖X.f s‖ ≤ M_scale * (h_ref - s.im) ^ (-α) ∧
         Real.sqrt ‖X.q s‖ ≤ M_scale * (h_ref - s.im) ^ (-α)) →
       ∀ z_0 t s_m s_0 : ℂ,
         γ_steep * ‖t‖ < t.im →
         d / 2 < h_ref - (z_0 + t).im →
         h_ref - (z_0 - t).im < δ_ceil →
         |(z_0 + t).re - x₀| ≤ (m_steep + 1 / γ_steep) * (h_ref - (z_0 + t).im) →
         ‖t‖ < 10 * r * ((h_ref - (z_0 + t).im) / d) ^ α →
         ‖s_m - (z_0 - t)‖ ≤ (1 / 512) * (h_ref - (z_0 - t).im) →
         ‖s_0 - z_0‖ ≤ (1 / 512) * (h_ref - z_0.im) →
         ‖(s_0 - s_m) / t - 1‖ ≤ 1 / 32 →
         IsRefSteepContractivePt X P s_m s_0 t ∧
         8 * ‖refSteepResidual P s_m ((s_0 - s_m) / t) s_0 t ((s_0 - s_m) / t)‖ ≤
           C_res * ‖t‖ ^ 3 * M_scale ^ 2 * (h_ref - z_0.im) ^ (-2 * α - 1)))

def RefUpwardSteepProp (X : ExpStripData) (P : ChordActionPackage X) : Prop :=
  ∀ (α γ_steep : ℝ),
    1 / 2 < α → α < 1 → 0 < γ_steep → γ_steep < 1 / 4 →
    ∃ (C_st η_st : ℝ), 1 ≤ C_st ∧ 0 < η_st ∧ η_st < 1 / 16 ∧
      ∀ (x₀ h_ref m_steep d δ_ceil Δ_slab r M_scale C_init : ℝ)
        (s_init : ℂ × ℂ → ℂ),
        0 < m_steep → 0 < d → 0 < Δ_slab → 2 * Δ_slab ≤ δ_ceil →
        4 * d ≤ δ_ceil - Δ_slab → 0 < r → 0 < M_scale → 0 ≤ C_init →
        12 * r * (δ_ceil / d) ^ α ≤ Δ_slab / 16 →
        r / d ≤ η_st →
        r * d ^ (-α) * M_scale ≤ η_st →
        C_init * (1 + 8 * δ_ceil / (γ_steep * Δ_slab)) ≤
          M_scale ^ 2 * δ_ceil ^ (1 - 2 * α) →
        (let L_in : ℝ := 2 * m_steep + 2 / γ_steep + 4
         let S_init : Set (ℂ × ℂ) :=
           { p : ℂ × ℂ |
             δ_ceil - Δ_slab < h_ref - p.1.im ∧ h_ref - p.1.im < δ_ceil ∧
             |p.1.re - x₀| < L_in * (h_ref - p.1.im) ∧
             ‖p.2‖ < 12 * r * (δ_ceil / d) ^ α }
         let W_up : Set (ℂ × ℂ) :=
           { p : ℂ × ℂ |
             d / 2 < h_ref - p.1.im ∧ h_ref - p.1.im < δ_ceil - Δ_slab / 4 ∧
             |p.1.re - x₀| < m_steep * (h_ref - p.1.im) ∧
             ‖p.2‖ < 10 * r * ((h_ref - p.1.im) / d) ^ α ∧
             γ_steep * ‖p.2‖ < p.2.im }
         (∀ s : ℂ, d / 10 ≤ h_ref - s.im → h_ref - s.im ≤ (5 / 4) * δ_ceil →
           |s.re - x₀| ≤ L_in * (h_ref - s.im) →
           s ∈ X.D_strip ∧
           ‖X.f s‖ ≤ M_scale * (h_ref - s.im) ^ (-α) ∧
           Real.sqrt ‖X.q s‖ ≤ M_scale * (h_ref - s.im) ^ (-α)) →
         DifferentiableOn ℂ s_init S_init →
         (∀ y t : ℂ, (y, t) ∈ S_init →
           ‖s_init (y, t) - y‖ ≤ C_init * ‖t‖ ^ 2) →
         (∀ y t : ℂ, t ≠ 0 →
           (y - t, t) ∈ S_init → (y, t) ∈ S_init → (y + t, t) ∈ S_init →
           let s_prev := s_init (y - t, t)
           let s_curr := s_init (y, t)
           let s_next := s_init (y + t, t)
           let J_prev := (s_curr - s_prev) / t
           let J_curr := (s_next - s_curr) / t
           deriv (fun J' => P.p_act s_curr J' t) J_curr -
             t * deriv (fun s' => P.p_act s' J_curr t) s_curr =
             deriv (fun J' => P.p_act s_prev J' t) J_prev) →
         ∃ s_up : ℂ × ℂ → ℂ,
           DifferentiableOn ℂ s_up W_up ∧
           (∀ p ∈ W_up, s_up p ∈ X.D_strip) ∧
           (∀ y t : ℂ, (y, t) ∈ W_up →
             ‖s_up (y, t) - y‖ ≤
               C_st * ‖t‖ ^ 2 * M_scale ^ 2 * (h_ref - y.im) ^ (1 - 2 * α)) ∧
           (∀ y t : ℂ, (y, t) ∈ W_up →
             δ_ceil - (3 / 4) * Δ_slab < h_ref - y.im →
             s_up (y, t) = s_init (y, t)) ∧
           (∀ y t : ℂ, γ_steep * ‖t‖ < t.im →
             (y - t, t) ∈ W_up → (y, t) ∈ W_up → (y + t, t) ∈ W_up →
             let s_prev := s_up (y - t, t)
             let s_curr := s_up (y, t)
             let s_next := s_up (y + t, t)
             let J_prev := (s_curr - s_prev) / t
             let J_curr := (s_next - s_curr) / t
             deriv (fun J' => P.p_act s_curr J' t) J_curr -
               t * deriv (fun s' => P.p_act s' J_curr t) s_curr =
               deriv (fun J' => P.p_act s_prev J' t) J_prev))
def EntireAffineBandInitProp : Prop :=
  SchwarzPoissonBumpProp → ∀ (α K₀ γ₀ : ℝ),
    1 / 2 < α → α < 1 → 8 < K₀ → 0 < γ₀ → γ₀ < 1 / 8 →
    ∃ (C_bump_init γ_init : ℝ),
      0 < C_bump_init ∧ 0 < γ_init ∧ γ_init < γ₀ ∧
      ∀ (x₀ h_ref s_base ρ_base m_aux d r M_scale C_st C_init : ℝ)
        (s_base_fn U_base s_steep : ℂ × ℂ → ℂ),
        0 < s_base → s_base ≤ h_ref → 0 < ρ_base → 0 < m_aux →
        0 < d → 4 * d ≤ h_ref / (2 * K₀) → 0 < r → 0 < M_scale →
        0 < C_st → 0 ≤ C_init →
        8 * r * (2 * h_ref / d) ^ α ≤ ρ_base →
        C_init ≤ M_scale ^ 2 * (2 * h_ref) ^ (1 - 2 * α) →
        (let m_steep_init : ℝ := 2 * (m_aux + (4 * K₀ + 1) * C_bump_init + 2)
         let A₀ : ℝ := max 1 ((3 / 2 : ℝ) ^ (2 * α - 1) * C_st)
         let δ_seed : ℝ := s_base / (16 * (1 + C_bump_init))
         let U_base_dom : Set (ℂ × ℂ) :=
           { p : ℂ × ℂ | |p.1.im| < s_base ∧ ‖p.2‖ < ρ_base }
         let W_steep_init : Set (ℂ × ℂ) :=
           { p : ℂ × ℂ |
             d / 2 < h_ref - p.1.im ∧ h_ref - p.1.im < h_ref + s_base / 2 ∧
             |p.1.re - x₀| < m_steep_init * (h_ref - p.1.im) ∧
             ‖p.2‖ < 10 * r * ((h_ref - p.1.im) / d) ^ α ∧
             γ_init * ‖p.2‖ < |p.2.im| }
         let Ω_mid : Set (ℂ × ℂ) :=
           { p : ℂ × ℂ |
             h_ref / (2 * K₀) < h_ref - p.1.im ∧ h_ref - p.1.im < h_ref + δ_seed ∧
             |p.1.re - x₀| < m_aux * (h_ref - p.1.im) ∧
             ‖p.2‖ < r * ((h_ref - p.1.im) / d) ^ α }
         DifferentiableOn ℂ U_base U_base_dom →
         (∀ y t : ℂ, (y, t) ∈ U_base_dom →
           s_base_fn (y, t) - y = t ^ 2 * U_base (y, t) ∧
           U_base (y, -t) = U_base (y, t) ∧
           ‖U_base (y, t)‖ ≤ C_init) →
         DifferentiableOn ℂ s_steep W_steep_init →
         (∀ y t : ℂ, (y, t) ∈ W_steep_init →
           s_steep (y, -t) = s_steep (y, t) ∧
           ‖s_steep (y, t) - y‖ ≤
             C_st * ‖t‖ ^ 2 * M_scale ^ 2 * (h_ref - y.im) ^ (1 - 2 * α)) →
         (∀ p ∈ W_steep_init, |p.1.im| < s_base / 2 → ‖p.2‖ < ρ_base →
           s_steep p = s_base_fn p) →
         ∃ s_band₀ : ℂ × ℂ → ℂ,
           DifferentiableOn ℂ s_band₀ Ω_mid ∧
           (∀ y t : ℂ, (y, t) ∈ Ω_mid →
             s_band₀ (y, -t) = s_band₀ (y, t) ∧
             ‖s_band₀ (y, t) - y‖ ≤
               A₀ * ‖t‖ ^ 2 * M_scale ^ 2 * (h_ref - y.im) ^ (1 - 2 * α)) ∧
           (∀ y : ℂ, (y, (0 : ℂ)) ∈ Ω_mid → s_band₀ (y, 0) = y) ∧
           (∀ p ∈ Ω_mid, |p.1.im| < δ_seed → s_band₀ p = s_base_fn p) ∧
           (∀ p ∈ Ω_mid ∩ W_steep_init, s_band₀ p = s_steep p))

def EntireConeParamRecurrenceProp : Prop :=
  ∀ (X : ExpStripData), X.D_strip = Set.univ →
  ∀ (P : ChordActionPackage X) (α γ_rec : ℝ),
    1 / 2 < α → α < 1 → 0 < γ_rec → γ_rec < 1 / 4 →
    ∀ (x₀ h_ref d δ_top m₀ R_par M_scale C_disp : ℝ)
      (s_cone : ℂ × ℂ → ℂ),
      0 < d → 4 * d < δ_top → 1 ≤ m₀ → 0 < R_par → 0 < M_scale → 0 ≤ C_disp →
      (let Ω_rec : Set (ℂ × ℂ) :=
         { p : ℂ × ℂ |
           d < h_ref - p.1.im ∧ h_ref - p.1.im < δ_top ∧
           |p.1.re - x₀| < m₀ * (h_ref - p.1.im) ∧
           ‖p.2‖ < R_par }
       (∀ w : ℂ, d ≤ h_ref - w.im → h_ref - w.im ≤ (3 / 2) * δ_top →
         ‖X.f w‖ ≤ M_scale * (h_ref - w.im) ^ (-α) ∧
         Real.sqrt ‖X.q w‖ ≤ M_scale * (h_ref - w.im) ^ (-α)) →
       DifferentiableOn ℂ s_cone Ω_rec →
       (∀ z t : ℂ, (z, t) ∈ Ω_rec →
         ‖s_cone (z, t) - z‖ ≤ C_disp * ‖t‖ ^ 2 * (h_ref - z.im) ^ (1 - 2 * α)) →
       (∀ z t : ℂ, γ_rec * ‖t‖ < t.im →
         (z - t, t) ∈ Ω_rec → (z, t) ∈ Ω_rec → (z + t, t) ∈ Ω_rec →
         let s_prev := s_cone (z - t, t)
         let s_curr := s_cone (z, t)
         let s_next := s_cone (z + t, t)
         let J_prev := (s_curr - s_prev) / t
         let J_curr := (s_next - s_curr) / t
         deriv (fun J' => P.p_act s_curr J' t) J_curr -
           t * deriv (fun s' => P.p_act s' J_curr t) s_curr =
           deriv (fun J' => P.p_act s_prev J' t) J_prev) →
       ∀ y t₀ : ℂ,
         let δ_y : ℝ := h_ref - y.im
         2 * d ≤ δ_y → (5 / 4) * δ_y < δ_top →
         |y.re - x₀| < ((3 / 4 : ℝ) * m₀ - 1 / 4) * δ_y →
         t₀ ≠ 0 → ‖t₀‖ < R_par / 2 → R_par ≤ δ_y / 32 →
         4 * R_par * M_scale * δ_y ^ (-α) ≤ P.η_sf →
         64 * C_disp * R_par ^ 2 * δ_y ^ (-2 * α) ≤ 1 / 16 →
         let s_prev := s_cone (y - t₀, t₀)
         let s_curr := s_cone (y, t₀)
         let s_next := s_cone (y + t₀, t₀)
         let J_prev := (s_curr - s_prev) / t₀
         let J_curr := (s_next - s_curr) / t₀
         deriv (fun J' => P.p_act s_curr J' t₀) J_curr -
           t₀ * deriv (fun s' => P.p_act s' J_curr t₀) s_curr =
           deriv (fun J' => P.p_act s_prev J' t₀) J_prev)
noncomputable def expParamStar {X : ExpStripData} {kind : ExpProfileKind}
    (seq : ExpSequenceData X kind) : ℝ :=
  (‖seq.c₀‖)⁻¹

noncomputable def expArgC0 {X : ExpStripData} {kind : ExpProfileKind}
    (seq : ExpSequenceData X kind) : ℝ :=
  Complex.arg seq.c₀

noncomputable def expShearOffset (T_star : ℝ) (T : ℂ) : ℂ :=
  -Complex.I * Complex.log (T / (T_star : ℂ))

noncomputable def expShearedModelW (α_c : ℝ) (Y_tilde : ℂ) : ℂ :=
  Complex.exp (-Complex.I * (Y_tilde - (α_c : ℂ)))

noncomputable def expShearedInnerModel {X : ExpStripData} {kind : ExpProfileKind}
    (seq : ExpSequenceData X kind) (M : BranchMonodromyPackage kind) (p : ℂ × ℂ) : ℂ :=
  p.1 + expShearOffset (expParamStar seq) p.2 +
    M.Δ_inner (expShearedModelW (expArgC0 seq) p.1)

def expShearedInnerDomain {X : ExpStripData} {kind : ExpProfileKind}
    (seq : ExpSequenceData X kind) (M : BranchMonodromyPackage kind) : Set (ℂ × ℂ) :=
  { p : ℂ × ℂ |
    ‖p.2 - (expParamStar seq : ℂ)‖ < (15 / 32 : ℝ) * expParamStar seq ∧
    expShearedModelW (expArgC0 seq) p.1 ∈ branchInnerDomain M.R M.ν M.θ M.δ_θ }

def complexRect (x_lo x_hi y_lo y_hi : ℝ) : Set ℂ :=
  { z : ℂ | x_lo < z.re ∧ z.re < x_hi ∧ y_lo < z.im ∧ z.im < y_hi }

noncomputable def physToSheared {X : ExpStripData} {kind : ExpProfileKind}
    (seq : ExpSequenceData X kind) (n : ℕ) (p : ℂ × ℂ) : ℂ × ℂ :=
  ((p.1 - expBasePt seq n) / (seq.ℓ_seq n : ℂ) -
    expShearOffset (expParamStar seq) ((seq.m_seq n : ℂ) * p.2),
   (seq.m_seq n : ℂ) * p.2)

noncomputable def shearedToPhys {X : ExpStripData} {kind : ExpProfileKind}
    (seq : ExpSequenceData X kind) (n : ℕ) (q : ℂ × ℂ) : ℂ × ℂ :=
  (expBasePt seq n +
    (seq.ℓ_seq n : ℂ) * (q.1 + expShearOffset (expParamStar seq) q.2),
   q.2 / (seq.m_seq n : ℂ))

noncomputable def shearedRescaledLift {X : ExpStripData} {kind : ExpProfileKind}
    (seq : ExpSequenceData X kind) (s_fn : ℂ × ℂ → ℂ) (n : ℕ) (q : ℂ × ℂ) : ℂ :=
  rescaledLift seq s_fn n (q.1 + expShearOffset (expParamStar seq) q.2) q.2

structure ShearedModelAndDeepBridgeProp (X : ExpStripData) (P : ChordActionPackage X)
    (kind : ExpProfileKind) (seq : ExpSequenceData X kind)
    (M : BranchMonodromyPackage kind) : Prop where
  T_star_pos : 0 < expParamStar seq
  unit_c₀ :
    (expParamStar seq : ℂ) * seq.c₀ =
      Complex.exp ((expArgC0 seq : ℂ) * Complex.I)
  shear_zero : expShearOffset (expParamStar seq) (expParamStar seq : ℂ) = 0
  shear_holo_bounds :
    let U_T_all := Metric.ball (expParamStar seq : ℂ) ((15 / 32 : ℝ) * expParamStar seq)
    DifferentiableOn ℂ (expShearOffset (expParamStar seq)) U_T_all ∧
    ∀ T ∈ U_T_all,
      T ≠ 0 ∧ ‖T‖ < 2 * expParamStar seq ∧
      |(expShearOffset (expParamStar seq) T).im| < 1 ∧
      |(expShearOffset (expParamStar seq) T).re| < 4
  inner_model_reg :
    IsRegularFrozenModel seq (expShearedInnerDomain seq M) (expShearedInnerModel seq M)
  mem_inner_of_lt_log_R :
    ∀ Y_tilde T : ℂ,
      ‖T - (expParamStar seq : ℂ)‖ < (15 / 32 : ℝ) * expParamStar seq →
      Y_tilde.im < Real.log M.R →
      (Y_tilde, T) ∈ expShearedInnerDomain seq M
  mem_inner_of_sector :
    ∀ (sgn : ℝ) (Y_tilde T : ℂ),
      (sgn = 1 ∨ sgn = -1) →
      ‖T - (expParamStar seq : ℂ)‖ < (15 / 32 : ℝ) * expParamStar seq →
      Y_tilde.im < Real.log M.R + 2 * M.ν →
      |Y_tilde.re - (expArgC0 seq - sgn * M.θ)| < 2 * M.δ_θ →
      (Y_tilde, T) ∈ expShearedInnerDomain seq M
  arcsin_collar :
    ∀ (x₀ δ_ϕ : ℝ),
      x₀ ∈ Set.Icc (-1 / 4 : ℝ) (1 / 4) → 0 < δ_ϕ →
      ∀ ϕ : ℝ, |Real.sin ϕ - x₀| ≤ (1 / 4 : ℝ) * min 1 δ_ϕ →
        ∃ k : ℤ,
          |ϕ - Real.arcsin x₀ - 2 * Real.pi * (k : ℝ)| ≤ δ_ϕ ∨
          |ϕ - (Real.pi - Real.arcsin x₀) - 2 * Real.pi * (k : ℝ)| ≤ δ_ϕ
  deep_sheared_init :
    ∃ D₁ : ℝ, 2 ≤ D₁ ∧
      ∀ (X_deep H_deep_bot : ℝ), 0 < X_deep → H_deep_bot < -D₁ - 4 →
        let U_T_all := Metric.ball (expParamStar seq : ℂ) ((15 / 32 : ℝ) * expParamStar seq)
        let R_deep := complexRect (-X_deep) X_deep H_deep_bot (-D₁ - 1)
        ∃ (N_init : ℕ) (U_phys : ℕ → Set (ℂ × ℂ))
          (s_tilde : ℕ → ℂ × ℂ → ℂ) (δ_base : ℕ → ℝ),
          (∀ n ≥ N_init,
            let S_sh := shearedRescaledLift seq (s_tilde n) n
            IsDownwardVertConvex (U_phys n) ∧
            0 < δ_base n ∧
            DifferentiableOn ℂ (s_tilde n) (U_phys n) ∧
            (∀ p ∈ U_phys n, s_tilde n p ∈ X.D_strip) ∧
            (∀ y t : ℂ, |y.im| < δ_base n → ‖t‖ < 4 * expParamStar seq / seq.m_seq n →
              (y, t) ∈ U_phys n ∧ s_tilde n (y, t) = X.𝔰 (y, t)) ∧
            (∀ q ∈ R_deep ×ˢ U_T_all, shearedToPhys seq n q ∈ U_phys n) ∧
            DifferentiableOn ℂ S_sh (R_deep ×ˢ U_T_all) ∧
            (∀ q ∈ R_deep ×ˢ U_T_all,
              expBasePt seq n + (seq.ℓ_seq n : ℂ) * S_sh q ∈ X.D_strip) ∧
            (∀ Y T : ℂ, T ∈ U_T_all → Y ∈ R_deep →
              Y - T / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ) ∈ R_deep →
              Y + T / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ) ∈ R_deep →
              SatisfiesScaledChordRecurrence P seq (fun Z => S_sh (Z, T)) n Y T)) ∧
          (∀ K : Set (ℂ × ℂ), IsCompact K → K ⊆ R_deep ×ˢ U_T_all →
            TendstoUniformlyOn
              (fun n q => shearedRescaledLift seq (s_tilde n) n q)
              (expShearedInnerModel seq M) Filter.atTop K)

def ShearedDiskLiftProp (X : ExpStripData) (P : ChordActionPackage X)
    (kind : ExpProfileKind) (seq : ExpSequenceData X kind) : Prop :=
  ∀ (V_mod : Set (ℂ × ℂ)) (S_star : ℂ × ℂ → ℂ)
    (T_max R_rad η M_g η_plus : ℝ)
    (U_T_prev K_T_prev U_T_c : Set ℂ)
    (x_lo x_c_lo x_c_hi x_hi H_prev_bot y_bot y_top H_c_bot H_c_top : ℝ)
    (g : ℂ → ℂ),
    IsRegularFrozenModel seq V_mod S_star →
    0 < T_max → 0 < R_rad → 0 < η → 0 ≤ M_g → 0 < η_plus →
    IsOpen U_T_prev → IsCompact K_T_prev → K_T_prev ⊆ U_T_prev →
    U_T_prev ⊆ Metric.ball (0 : ℂ) T_max →
    IsOpen U_T_c →
    x_lo < x_c_lo - M_g → x_c_lo < x_c_hi → x_c_hi + M_g < x_hi →
    H_prev_bot < y_bot → y_bot < y_top →
    H_prev_bot < H_c_bot - M_g → H_c_bot < H_c_top →
    (let δ_y : ℝ := (y_top - y_bot) / 4
     let y_mid : ℝ := (y_bot + y_top) / 2
     let U_prev : Set (ℂ × ℂ) := complexRect x_lo x_hi H_prev_bot y_top ×ˢ U_T_prev
     let B_rec : Set (ℂ × ℂ) := complexRect x_lo x_hi y_bot y_top ×ˢ U_T_prev
     let W_c : Set (ℂ × ℂ) := complexRect x_c_lo x_c_hi H_c_bot H_c_top ×ˢ U_T_c
     H_c_bot < y_top - δ_y - η_plus →
     Differentiable ℂ g → g 0 = 0 →
     (∀ ζ : ℂ, ‖ζ‖ ≤ 1 → ‖g ζ‖ ≤ M_g ∧ (g ζ).im ≤ η_plus) →
     (∀ T_c ∈ U_T_c, ∀ ϕ : ℝ,
       T_c + (R_rad : ℂ) * Complex.exp ((ϕ : ℂ) * Complex.I) ∈ K_T_prev) →
     (∀ T_c ∈ U_T_c, ∀ ζ ∈ Metric.closedBall (0 : ℂ) 1,
       T_c + (R_rad : ℂ) * ζ ∈ U_T_prev) →
     (∀ T_c ∈ U_T_c, ∀ ϕ : ℝ,
       |(T_c + (R_rad : ℂ) * Complex.exp ((ϕ : ℂ) * Complex.I)).im| ≤
         (3 / 2 : ℝ) * η →
       H_c_top + (g (Complex.exp ((ϕ : ℂ) * Complex.I))).im ≤
         y_top - (3 / 2 : ℝ) * δ_y) →
     B_rec ⊆ V_mod →
     (∀ p ∈ W_c, ∀ ζ ∈ Metric.closedBall (0 : ℂ) 1,
       (p.1 + g ζ, p.2 + (R_rad : ℂ) * ζ) ∈ V_mod) →
     (∀ (σ : ℝ), (σ = 1 ∨ σ = -1) →
       ∀ (Y' T' : ℂ),
         x_c_lo - M_g ≤ Y'.re → Y'.re ≤ x_c_hi + M_g →
         y_mid ≤ Y'.im → Y'.im ≤ H_c_top + η_plus →
         T' ∈ K_T_prev → (3 / 2 : ℝ) * η ≤ σ * T'.im →
         ∀ τ ∈ Set.Icc y_mid Y'.im,
           let Y_vert : ℂ := (Y'.re : ℂ) + (τ : ℂ) * Complex.I
           let s_end : ℝ := (τ - y_mid) / (σ * T'.im)
           (∀ s ∈ Set.Icc (0 : ℝ) s_end,
             (Y_vert - (s : ℂ) * (σ : ℂ) * T', T') ∈ V_mod) ∧
           x_lo < (Y_vert - (s_end : ℂ) * (σ : ℂ) * T').re ∧
           (Y_vert - (s_end : ℂ) * (σ : ℂ) * T').re < x_hi) →
     ∀ (N₀ : ℕ) (S_prev : ℕ → ℂ × ℂ → ℂ),
       (∀ n ≥ N₀, DifferentiableOn ℂ (S_prev n) U_prev) →
       (∀ n ≥ N₀, ∀ p ∈ U_prev,
         expBasePt seq n + (seq.ℓ_seq n : ℂ) * S_prev n p ∈ X.D_strip) →
       (∀ n ≥ N₀, ∀ Y T : ℂ, T ≠ 0 →
         (Y, T) ∈ B_rec →
         (Y - T / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ), T) ∈ B_rec →
         (Y + T / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ), T) ∈ B_rec →
         SatisfiesScaledChordRecurrence P seq (fun Z => S_prev n (Z, T)) n Y T) →
       (∀ K : Set (ℂ × ℂ), IsCompact K → K ⊆ U_prev →
         TendstoUniformlyOn S_prev S_star Filter.atTop K) →
       ∃ (N₁ : ℕ) (S_next : ℕ → ℂ × ℂ → ℂ),
         N₀ ≤ N₁ ∧
         (∀ n ≥ N₁, DifferentiableOn ℂ (S_next n) W_c) ∧
         (∀ n ≥ N₁, ∀ p ∈ W_c,
           expBasePt seq n + (seq.ℓ_seq n : ℂ) * S_next n p ∈ X.D_strip) ∧
         (∀ n ≥ N₁, ∀ p ∈ W_c, p.1.im < y_top - δ_y - η_plus →
           S_next n p = S_prev n p) ∧
         TendstoUniformlyOn S_next S_star Filter.atTop W_c)

def VertRecurrenceProp (X : ExpStripData) (P : ChordActionPackage X)
    (kind : ExpProfileKind) (seq : ExpSequenceData X kind) : Prop :=
  ∀ (V_mod : Set (ℂ × ℂ)) (S_star : ℂ × ℂ → ℂ)
    (T_max : ℝ) (U_T K_T : Set ℂ)
    (x₁ x₂ y₁ y₂ y_seed δ_r : ℝ)
    (N₀ : ℕ) (S_seq : ℕ → ℂ × ℂ → ℂ),
    IsRegularFrozenModel seq V_mod S_star →
    0 < T_max → 0 < δ_r →
    IsOpen U_T → IsCompact K_T → K_T ⊆ U_T →
    U_T ⊆ { T : ℂ | T ≠ 0 ∧ ‖T‖ < T_max } →
    x₁ + 2 * δ_r < x₂ → y₁ + 2 * δ_r < y₂ →
    y₁ + δ_r < y_seed → y_seed ≤ y₂ →
    complexRect x₁ x₂ y₁ y₂ ×ˢ U_T ⊆ V_mod →
    (∀ n ≥ N₀, DifferentiableOn ℂ (S_seq n) (complexRect x₁ x₂ y₁ y₂ ×ˢ U_T)) →
    (∀ K : Set (ℂ × ℂ), IsCompact K → K ⊆ complexRect x₁ x₂ y₁ y₂ ×ˢ U_T →
      TendstoUniformlyOn S_seq S_star Filter.atTop K) →
    (∀ n ≥ N₀, ∀ Y T : ℂ, T ∈ K_T →
      Y ∈ complexRect x₁ x₂ y₁ y_seed →
      Y - T / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ) ∈ complexRect x₁ x₂ y₁ y_seed →
      Y + T / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ) ∈ complexRect x₁ x₂ y₁ y_seed →
      SatisfiesScaledChordRecurrence P seq (fun Z => S_seq n (Z, T)) n Y T) →
    ∃ N_rec : ℕ, N₀ ≤ N_rec ∧
      ∀ n ≥ N_rec, ∀ T ∈ K_T,
        ∀ Y ∈ complexRect (x₁ + δ_r) (x₂ - δ_r) (y₁ + δ_r) (y₂ - δ_r),
          SatisfiesScaledChordRecurrence P seq (fun Z => S_seq n (Z, T)) n Y T

def StageOneShearedProp (X : ExpStripData) (P : ChordActionPackage X)
    (kind : ExpProfileKind) (seq : ExpSequenceData X kind)
    (M : BranchMonodromyPackage kind) : Prop :=
  ∀ ν' : ℝ, 0 < ν' → ν' < M.ν →
    let T_star : ℝ := expParamStar seq
    let α_c : ℝ := expArgC0 seq
    let r₀ : ℝ := T_star / 32
    let X₁ : ℝ := |α_c| + M.θ + 10
    let U_T_1 : Set ℂ := Metric.ball (T_star : ℂ) ((3 / 2 : ℝ) * r₀)
    ∃ (H_1_bot H_cut_0 : ℝ) (N₁ : ℕ)
      (U_phys : ℕ → Set (ℂ × ℂ)) (s_tilde : ℕ → ℂ × ℂ → ℂ)
      (δ_base : ℕ → ℝ) (S₁ : ℕ → ℂ × ℂ → ℂ),
      H_1_bot < Real.log M.R - 55 ∧
      H_1_bot + 1 < H_cut_0 ∧
      H_cut_0 < Real.log M.R - 50 ∧
      (let R_1_full := complexRect (-X₁) X₁ H_1_bot (Real.log M.R - ν')
       let R_1_rec :=
         complexRect (-X₁ + ν' / 8) (X₁ - ν' / 8)
           (H_1_bot + ν' / 8) (Real.log M.R - (9 / 8 : ℝ) * ν')
       (∀ n ≥ N₁,
         IsDownwardVertConvex (U_phys n) ∧
         0 < δ_base n ∧
         DifferentiableOn ℂ (s_tilde n) (U_phys n) ∧
         (∀ p ∈ U_phys n, s_tilde n p ∈ X.D_strip) ∧
         (∀ y t : ℂ, |y.im| < δ_base n → ‖t‖ < 4 * T_star / seq.m_seq n →
           (y, t) ∈ U_phys n ∧ s_tilde n (y, t) = X.𝔰 (y, t)) ∧
         (∀ q ∈ complexRect (-X₁) X₁ H_1_bot H_cut_0 ×ˢ U_T_1,
           shearedToPhys seq n q ∈ U_phys n ∧
           expBasePt seq n + (seq.ℓ_seq n : ℂ) * S₁ n q =
             s_tilde n (shearedToPhys seq n q)) ∧
         DifferentiableOn ℂ (S₁ n) (R_1_full ×ˢ U_T_1) ∧
         (∀ q ∈ R_1_full ×ˢ U_T_1,
           expBasePt seq n + (seq.ℓ_seq n : ℂ) * S₁ n q ∈ X.D_strip) ∧
         (∀ Y T : ℂ, T ∈ U_T_1 → Y ∈ R_1_rec →
           SatisfiesScaledChordRecurrence P seq (fun Z => S₁ n (Z, T)) n Y T)) ∧
       TendstoUniformlyOn S₁ (expShearedInnerModel seq M) Filter.atTop
         (R_1_full ×ˢ U_T_1))
noncomputable def rctScaledActionP {X : ExpStripData} (P : ChordActionPackage X)
    {kind : ExpProfileKind} (seq : ExpSequenceData X kind) (n : ℕ) (S J T : ℂ) : ℂ :=
  P.p_act (expBasePt seq n + (seq.ℓ_seq n : ℂ) * S) J (T / (seq.m_seq n : ℂ))

noncomputable def rctModelActionP (kind : ExpProfileKind) {X : ExpStripData}
    (seq : ExpSequenceData X kind) (S J T : ℂ) : ℂ :=
  frozenActionP kind (T * seq.c₀ * Complex.exp (-Complex.I * S)) J

noncomputable def rctActDS (F : ℂ → ℂ → ℂ → ℂ) (S J T : ℂ) : ℂ :=
  deriv (fun S' => F S' J T) S

noncomputable def rctActDJ (F : ℂ → ℂ → ℂ → ℂ) (S J T : ℂ) : ℂ :=
  deriv (fun J' => F S J' T) J

noncomputable def rctActDJJ (F : ℂ → ℂ → ℂ → ℂ) (S J T : ℂ) : ℂ :=
  deriv (fun J' => deriv (fun J'' => F S J'' T) J') J

noncomputable def rctActDSJ (F : ℂ → ℂ → ℂ → ℂ) (S J T : ℂ) : ℂ :=
  deriv (fun S' => deriv (fun J' => F S' J' T) J) S

noncomputable def rctActDJS (F : ℂ → ℂ → ℂ → ℂ) (S J T : ℂ) : ℂ :=
  deriv (fun J' => deriv (fun S' => F S' J' T) S) J

noncomputable def rctInitSymplecticState {X : ExpStripData} (P : ChordActionPackage X)
    {kind : ExpProfileKind} (seq : ExpSequenceData X kind)
    (n : ℕ) (σ : ℝ) (S_prev S_curr T : ℂ) : ℂ × ℂ :=
  let a_n : ℂ := T / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ)
  if 0 < σ then
    let D_prev : ℂ := (S_curr - S_prev) / a_n
    (S_curr, rctActDJ (rctScaledActionP P seq n) S_prev D_prev T)
  else
    let D_prev : ℂ := (S_prev - S_curr) / a_n
    (S_curr,
      rctActDJ (rctScaledActionP P seq n) S_curr D_prev T -
        a_n * rctActDS (rctScaledActionP P seq n) S_curr D_prev T)

noncomputable def rctRunCorridorChain {X : ExpStripData} {kind : ExpProfileKind}
    (seq : ExpSequenceData X kind)
    (Ψ : ℕ → ℂ × ℂ → ℂ × ℂ → ℂ × ℂ)
    (σ : ℝ) (n : ℕ) : ℕ → ℂ → ℂ → ℂ × ℂ → ℂ × ℂ
  | 0, _, _, q₀ => q₀
  | k + 1, Y₀, T, q₀ =>
      let a_n : ℂ := T / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ)
      Ψ n (Y₀ + (k : ℂ) * (σ : ℂ) * a_n, T)
        (rctRunCorridorChain seq Ψ σ n k Y₀ T q₀)

structure RctFrozenJetAndELProp (X : ExpStripData) (P : ChordActionPackage X)
    (kind : ExpProfileKind) (seq : ExpSequenceData X kind) : Prop where
  chart_jets :
    ∀ (S₀ J₀ T₀ : ℂ),
      IsRegularFrozenState kind
        (T₀ * seq.c₀ * Complex.exp (-Complex.I * S₀)) J₀ →
      let μ₀ : ℂ := rctActDJJ (rctModelActionP kind seq) S₀ J₀ T₀
      μ₀ ≠ 0 ∧
      ∃ (r_c : ℝ) (N_c : ℕ) (M_c : ℝ),
        0 < r_c ∧ 0 < M_c ∧
        let Q_c : Set (ℂ × ℂ × ℂ) :=
          { q : ℂ × ℂ × ℂ |
            ‖q.1 - S₀‖ < r_c ∧ ‖q.2.1 - J₀‖ < r_c ∧ ‖q.2.2 - T₀‖ < r_c }
        DifferentiableOn ℂ (fun q : ℂ × ℂ × ℂ => rctModelActionP kind seq q.1 q.2.1 q.2.2) Q_c ∧
        DifferentiableOn ℂ (fun q : ℂ × ℂ × ℂ => rctActDS (rctModelActionP kind seq) q.1 q.2.1 q.2.2) Q_c ∧
        DifferentiableOn ℂ (fun q : ℂ × ℂ × ℂ => rctActDJ (rctModelActionP kind seq) q.1 q.2.1 q.2.2) Q_c ∧
        DifferentiableOn ℂ (fun q : ℂ × ℂ × ℂ => rctActDJJ (rctModelActionP kind seq) q.1 q.2.1 q.2.2) Q_c ∧
        (∀ n ≥ N_c,
          DifferentiableOn ℂ (fun q : ℂ × ℂ × ℂ => rctScaledActionP P seq n q.1 q.2.1 q.2.2) Q_c ∧
          DifferentiableOn ℂ (fun q : ℂ × ℂ × ℂ => rctActDS (rctScaledActionP P seq n) q.1 q.2.1 q.2.2) Q_c ∧
          DifferentiableOn ℂ (fun q : ℂ × ℂ × ℂ => rctActDJ (rctScaledActionP P seq n) q.1 q.2.1 q.2.2) Q_c ∧
          DifferentiableOn ℂ (fun q : ℂ × ℂ × ℂ => rctActDJJ (rctScaledActionP P seq n) q.1 q.2.1 q.2.2) Q_c ∧
          DifferentiableOn ℂ (fun q : ℂ × ℂ × ℂ => rctActDSJ (rctScaledActionP P seq n) q.1 q.2.1 q.2.2) Q_c ∧
          DifferentiableOn ℂ (fun q : ℂ × ℂ × ℂ => rctActDJS (rctScaledActionP P seq n) q.1 q.2.1 q.2.2) Q_c ∧
          (∀ q ∈ Q_c,
            ‖rctActDJJ (rctScaledActionP P seq n) q.1 q.2.1 q.2.2 - μ₀‖ ≤ (1 / 8 : ℝ) * ‖μ₀‖ ∧
            ‖rctActDS (rctScaledActionP P seq n) q.1 q.2.1 q.2.2‖ ≤ M_c ∧
            ‖rctActDJ (rctScaledActionP P seq n) q.1 q.2.1 q.2.2‖ ≤ M_c ∧
            ‖rctActDSJ (rctScaledActionP P seq n) q.1 q.2.1 q.2.2‖ ≤ M_c ∧
            ‖rctActDJS (rctScaledActionP P seq n) q.1 q.2.1 q.2.2‖ ≤ M_c ∧
            ‖rctActDJJ (rctScaledActionP P seq n) q.1 q.2.1 q.2.2‖ ≤ M_c) ∧
          (∀ S₁ J₁ S₂ J₂ T : ℂ,
            (S₁, (J₁, T)) ∈ Q_c → (S₂, (J₂, T)) ∈ Q_c →
            ‖rctActDS (rctScaledActionP P seq n) S₁ J₁ T -
              rctActDS (rctScaledActionP P seq n) S₂ J₂ T‖ ≤
              M_c * (‖S₁ - S₂‖ + ‖J₁ - J₂‖) ∧
            ‖rctActDJ (rctScaledActionP P seq n) S₁ J₁ T -
              rctActDJ (rctScaledActionP P seq n) S₂ J₂ T‖ ≤
              M_c * (‖S₁ - S₂‖ + ‖J₁ - J₂‖))) ∧
        (∀ ε : ℝ, 0 < ε → ∃ N_ε ≥ N_c, ∀ n ≥ N_ε,
          ∀ S₁ J₁ S₂ J₂ T : ℂ,
            (S₁, (J₁, T)) ∈ Q_c → (S₂, (J₂, T)) ∈ Q_c →
            ‖rctActDS (rctScaledActionP P seq n) S₁ J₁ T -
              rctActDS (rctModelActionP kind seq) S₁ J₁ T‖ ≤ ε ∧
            ‖rctActDJ (rctScaledActionP P seq n) S₁ J₁ T -
              rctActDJ (rctModelActionP kind seq) S₁ J₁ T‖ ≤ ε ∧
            ‖(rctActDJ (rctScaledActionP P seq n) S₁ J₁ T -
                rctActDJ (rctModelActionP kind seq) S₁ J₁ T) -
              (rctActDJ (rctScaledActionP P seq n) S₂ J₂ T -
                rctActDJ (rctModelActionP kind seq) S₂ J₂ T)‖ ≤
              ε * (‖S₁ - S₂‖ + ‖J₁ - J₂‖)) ∧
        (∀ n ≥ N_c, ∀ (S_fn : ℂ → ℂ) (Y T : ℂ), T ≠ 0 →
          let a_n : ℂ := T / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ)
          let D_prev : ℂ := (S_fn Y - S_fn (Y - a_n)) / a_n
          let D_curr : ℂ := (S_fn (Y + a_n) - S_fn Y) / a_n
          (S_fn Y, (D_curr, T)) ∈ Q_c →
          (S_fn (Y - a_n), (D_prev, T)) ∈ Q_c →
          SatisfiesScaledChordRecurrence P seq S_fn n Y T →
          rctActDJ (rctScaledActionP P seq n) (S_fn Y) D_curr T -
            a_n * rctActDS (rctScaledActionP P seq n) (S_fn Y) D_curr T =
            rctActDJ (rctScaledActionP P seq n) (S_fn (Y - a_n)) D_prev T)
  model_euler_lagrange :
    ∀ (V_mod : Set (ℂ × ℂ)) (S_star : ℂ × ℂ → ℂ),
      IsRegularFrozenModel seq V_mod S_star →
      DifferentiableOn ℂ
        (fun p : ℂ × ℂ => deriv (fun Y' => S_star (Y', p.2)) p.1) V_mod ∧
      ∀ K : Set (ℂ × ℂ), IsCompact K → K ⊆ V_mod →
        ∃ (a_max C_EL : ℝ), 0 < a_max ∧ 0 < C_EL ∧
          ∀ p ∈ K, ∀ a : ℂ, 0 < ‖a‖ → ‖a‖ ≤ a_max →
            let Y : ℂ := p.1
            let T : ℂ := p.2
            let J_star : ℂ := deriv (fun Y' => S_star (Y', T)) Y
            let D_prev : ℂ := (S_star (Y, T) - S_star (Y - a, T)) / a
            let D_curr : ℂ := (S_star (Y + a, T) - S_star (Y, T)) / a
            (Y - a, T) ∈ V_mod ∧ (Y + a, T) ∈ V_mod ∧
            ‖S_star (Y + a, T) - S_star (Y, T)‖ ≤ C_EL * ‖a‖ ∧
            ‖S_star (Y, T) - S_star (Y - a, T)‖ ≤ C_EL * ‖a‖ ∧
            ‖D_prev - J_star‖ ≤ C_EL * ‖a‖ ∧
            ‖D_curr - J_star‖ ≤ C_EL * ‖a‖ ∧
            ‖(rctActDJ (rctModelActionP kind seq) (S_star (Y, T)) D_curr T -
                a * rctActDS (rctModelActionP kind seq) (S_star (Y, T)) D_curr T) -
              rctActDJ (rctModelActionP kind seq) (S_star (Y - a, T)) D_prev T‖ ≤
              C_EL * ‖a‖ ^ 2

def RctCorridorStepEngineProp (X : ExpStripData) (P : ChordActionPackage X)
    (kind : ExpProfileKind) (seq : ExpSequenceData X kind) : Prop :=
  ∀ (V_mod : Set (ℂ × ℂ)) (S_star : ℂ × ℂ → ℂ) (K_corr : Set (ℂ × ℂ))
    (σ T_max L_max : ℝ),
    IsRegularFrozenModel seq V_mod S_star →
    IsCompact K_corr → K_corr ⊆ V_mod →
    (σ = 1 ∨ σ = -1) → 0 < T_max → 0 < L_max →
    (∀ p ∈ K_corr, ‖p.2‖ ≤ T_max) →
    DifferentiableOn ℂ
      (fun p : ℂ × ℂ => deriv (fun Y' => S_star (Y', p.2)) p.1) V_mod ∧
    (∃ (a_max C_EL : ℝ), 0 < a_max ∧ 0 < C_EL ∧
      ∀ p ∈ K_corr, ∀ a : ℂ, 0 < ‖a‖ → ‖a‖ ≤ a_max →
        let Y : ℂ := p.1
        let T : ℂ := p.2
        let J_star : ℂ := deriv (fun Y' => S_star (Y', T)) Y
        let D_prev : ℂ := (S_star (Y, T) - S_star (Y - a, T)) / a
        let D_curr : ℂ := (S_star (Y + a, T) - S_star (Y, T)) / a
        (Y - a, T) ∈ V_mod ∧ (Y + a, T) ∈ V_mod ∧
        ‖S_star (Y + a, T) - S_star (Y, T)‖ ≤ C_EL * ‖a‖ ∧
        ‖S_star (Y, T) - S_star (Y - a, T)‖ ≤ C_EL * ‖a‖ ∧
        ‖D_prev - J_star‖ ≤ C_EL * ‖a‖ ∧
        ‖D_curr - J_star‖ ≤ C_EL * ‖a‖) ∧
    ∃ (η_corr r_init C_Gron : ℝ) (N_eng : ℕ) (δ_mod : ℕ → ℝ)
      (Ψ : ℕ → ℂ × ℂ → ℂ × ℂ → ℂ × ℂ),
      0 < η_corr ∧ 0 < r_init ∧ 0 < C_Gron ∧
      (∀ n : ℕ, 0 ≤ δ_mod n) ∧
      Filter.Tendsto δ_mod Filter.atTop (nhds 0) ∧
      let U_corr : Set (ℂ × ℂ) :=
        { p : ℂ × ℂ | ∃ q ∈ K_corr, ‖p - q‖ < η_corr }
      IsOpen U_corr ∧ U_corr ⊆ V_mod ∧
      (∀ (n d k₁ : ℕ) (Y₀ T : ℂ) (q₀ : ℂ × ℂ),
        let a_n : ℂ := T / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ)
        rctRunCorridorChain seq Ψ σ n (d + k₁) Y₀ T q₀ =
          rctRunCorridorChain seq Ψ σ n k₁
            (Y₀ + (d : ℂ) * (σ : ℂ) * a_n) T
            (rctRunCorridorChain seq Ψ σ n d Y₀ T q₀)) ∧
      (∀ n ≥ N_eng, ∀ (Y T : ℂ) (S_fn : ℂ → ℂ),
        (Y, T) ∈ U_corr → T ≠ 0 → ‖T‖ ≤ T_max →
        let a_n : ℂ := T / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ)
        let J_star : ℂ := deriv (fun Y' => S_star (Y', T)) Y
        SatisfiesScaledChordRecurrence P seq S_fn n Y T →
        ‖S_fn (Y - (σ : ℂ) * a_n) - S_star (Y - (σ : ℂ) * a_n, T)‖ < r_init →
        ‖S_fn Y - S_star (Y, T)‖ < r_init →
        ‖S_fn (Y + (σ : ℂ) * a_n) - S_star (Y + (σ : ℂ) * a_n, T)‖ < r_init →
        ‖(S_fn Y - S_fn (Y - (σ : ℂ) * a_n)) / ((σ : ℂ) * a_n) - J_star‖ < r_init →
        ‖(S_fn (Y + (σ : ℂ) * a_n) - S_fn Y) / ((σ : ℂ) * a_n) - J_star‖ < r_init →
        Ψ n (Y, T)
          (rctInitSymplecticState P seq n σ (S_fn (Y - (σ : ℂ) * a_n)) (S_fn Y) T) =
          rctInitSymplecticState P seq n σ (S_fn Y) (S_fn (Y + (σ : ℂ) * a_n)) T) ∧
      (∀ n ≥ N_eng, ∀ K_n : ℕ,
        (K_n : ℝ) / (seq.ℓ_seq n * seq.m_seq n) ≤ L_max →
        ∀ (Y₀ T S_prev S_curr : ℂ),
          T ≠ 0 → ‖T‖ ≤ T_max →
          (∀ k ≤ K_n,
            let a_n : ℂ := T / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ)
            (Y₀ + (k : ℂ) * (σ : ℂ) * a_n, T) ∈ U_corr) →
          let a_n : ℂ := T / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ)
          let e_init : ℝ :=
            ‖S_curr - S_star (Y₀, T)‖ +
              ‖(S_curr - S_prev) / ((σ : ℂ) * a_n) -
                deriv (fun Y' => S_star (Y', T)) Y₀‖
          e_init < r_init →
          ∀ k ≤ K_n,
            let S_k : ℂ :=
              (rctRunCorridorChain seq Ψ σ n k Y₀ T
                (rctInitSymplecticState P seq n σ S_prev S_curr T)).1
            ‖S_k - S_star (Y₀ + (k : ℂ) * (σ : ℂ) * a_n, T)‖ ≤
              C_Gron * (e_init + δ_mod n) ∧
            expBasePt seq n + (seq.ℓ_seq n : ℂ) * S_k ∈ X.D_strip) ∧
      (∀ n ≥ N_eng, ∀ K_n : ℕ,
        (K_n : ℝ) / (seq.ℓ_seq n * seq.m_seq n) ≤ L_max →
        ∀ (W : Set (ℂ × ℂ)) (Y₀_fn T_fn S_prev_fn S_curr_fn : ℂ × ℂ → ℂ),
          IsOpen W →
          DifferentiableOn ℂ Y₀_fn W →
          DifferentiableOn ℂ T_fn W →
          DifferentiableOn ℂ S_prev_fn W →
          DifferentiableOn ℂ S_curr_fn W →
          (∀ w ∈ W,
            T_fn w ≠ 0 ∧ ‖T_fn w‖ ≤ T_max ∧
            let a_n : ℂ := T_fn w / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ)
            (∀ k ≤ K_n, (Y₀_fn w + (k : ℂ) * (σ : ℂ) * a_n, T_fn w) ∈ U_corr) ∧
            ‖S_curr_fn w - S_star (Y₀_fn w, T_fn w)‖ +
              ‖(S_curr_fn w - S_prev_fn w) / ((σ : ℂ) * a_n) -
                deriv (fun Y' => S_star (Y', T_fn w)) (Y₀_fn w)‖ < r_init) →
          ∀ k ≤ K_n,
            DifferentiableOn ℂ
              (fun w : ℂ × ℂ =>
                (rctRunCorridorChain seq Ψ σ n k (Y₀_fn w) (T_fn w)
                  (rctInitSymplecticState P seq n σ (S_prev_fn w) (S_curr_fn w) (T_fn w))).1)
              W)
noncomputable def wltbExpPt (y_star : ℂ) (wt : ℂ × ℂ) : ℂ × ℂ :=
  (y_star + Complex.exp wt.1, wt.2)

noncomputable def wltbSlitLog (y_star : ℂ) (ρ : ℝ) (y : ℂ) : ℂ :=
  (Real.log ρ : ℂ) - ((Real.pi / 2 : ℝ) : ℂ) * Complex.I +
    Complex.log ((Complex.I / (ρ : ℂ)) * (y - y_star))

noncomputable def wltbDerivY : ℕ → (ℂ × ℂ → ℂ) → (ℂ × ℂ → ℂ)
  | 0, f => f
  | α + 1, f => fun p => Complex.exp (-p.1) * pderivA (wltbDerivY α f) p

noncomputable def wltbDerivYT (α β : ℕ) (f : ℂ × ℂ → ℂ) (p : ℂ × ℂ) : ℂ :=
  iterDerivYT 0 β (wltbDerivY α f) p

noncomputable def wltbHomRankOneDet (W_hom : Fin 3 → ℂ × ℂ → ℂ) (p : ℂ × ℂ) : ℂ :=
  W_hom 0 p * (wltbDerivYT 1 0 (W_hom 1) p * wltbDerivYT 0 1 (W_hom 2) p -
    wltbDerivYT 0 1 (W_hom 1) p * wltbDerivYT 1 0 (W_hom 2) p) -
  W_hom 1 p * (wltbDerivYT 1 0 (W_hom 0) p * wltbDerivYT 0 1 (W_hom 2) p -
    wltbDerivYT 0 1 (W_hom 0) p * wltbDerivYT 1 0 (W_hom 2) p) +
  W_hom 2 p * (wltbDerivYT 1 0 (W_hom 0) p * wltbDerivYT 0 1 (W_hom 1) p -
    wltbDerivYT 0 1 (W_hom 0) p * wltbDerivYT 1 0 (W_hom 1) p)

noncomputable def wltbHomReflectOut (E : Fin 2 → ℂ × ℂ → ℂ) (W_hom : Fin 3 → ℂ × ℂ → ℂ) :
    Fin 2 → ℂ × ℂ → ℂ :=
  fun ι p =>
    let T₀ := W_hom 2 p * wltbDerivYT 1 0 (W_hom 0) p - W_hom 0 p * wltbDerivYT 1 0 (W_hom 2) p
    let T₁ := W_hom 2 p * wltbDerivYT 1 0 (W_hom 1) p - W_hom 1 p * wltbDerivYT 1 0 (W_hom 2) p
    let N₀ := T₁
    let N₁ := -T₀
    let dotLN := E 0 p * N₀ + E 1 p * N₁
    let dotNN := N₀ * N₀ + N₁ * N₁
    2 * dotLN * (if ι = 0 then N₀ else N₁) - dotNN * E ι p

noncomputable def wltbHomReflectRes (E F : Fin 2 → ℂ × ℂ → ℂ) : Fin 2 → ℂ × ℂ → ℂ :=
  fun ι p =>
    let W_hom := homIntersect E F
    let V := wltbHomReflectOut E W_hom
    W_hom 2 p * V ι p - (V 0 p * W_hom 0 p + V 1 p * W_hom 1 p) * F ι p

noncomputable def wltbLineJetEnv (M : ℕ) (E₀ E₁ : Fin 2 → ℂ × ℂ → ℂ) (p : ℂ × ℂ) :
    LineJetVar M → ℂ :=
  fun v =>
    if v.1 = 0 then
      wltbDerivYT v.2.2.1.1 v.2.2.2.1 (E₀ v.2.1) p
    else
      wltbDerivYT v.2.2.1.1 v.2.2.2.1 (E₁ v.2.1) p

noncomputable def wltbFieldSymJetEnv {N_idx : ℕ} (q_idx : Fin N_idx → ℤ) (M : ℕ)
    (E : ℤ → Fin 2 → ℂ × ℂ → ℂ) (p : ℂ × ℂ) : SymJetVar N_idx M → ℂ :=
  fun v => wltbDerivYT v.2.2.1.1 v.2.2.2.1 (E (q_idx v.1) v.2.1) p
structure CgpsInverseChordData (U_symm : Set ℝ) (ρ : ℝ → ℝ) (h_b : ℝ) (h μ : ℝ → ℝ) : Prop where
  hb_pos : 0 < h_b
  hb_mem : h_b ∈ U_symm
  Rb_ge_one : 1 ≤ ρ h_b
  Rb_gt_zero_val : ρ 0 < ρ h_b
  ρ_mono_nonneg : ∀ y₁ y₂ : ℝ, 0 ≤ y₁ → y₁ ≤ y₂ → y₂ ∈ U_symm → y₁ ∈ U_symm ∧ ρ y₁ ≤ ρ y₂
  ρ_bdd_on_Icc : ∀ B : ℝ, 0 ≤ B → B ∈ U_symm → ∃ M : ℝ, ∀ y ∈ Set.Icc 0 B, ρ y ≤ M
  h_mem_and_inv : ∀ z : ℝ, ρ h_b ≤ z → h_b ≤ h z ∧ h z ∈ U_symm ∧ ρ (h z) = z
  h_strictMono : StrictMonoOn h (Set.Ici (ρ h_b))
  h_left_inv : ∀ y ∈ U_symm, h_b ≤ y → ρ h_b ≤ ρ y ∧ h (ρ y) = y
  μ_mono : MonotoneOn μ (Set.Ici (ρ h_b))
  exp_μ_ge_secant : ∀ z : ℝ, ρ h_b ≤ z → (z - ρ 0) / h z ≤ Real.exp (μ z)
  exp_μ_ge_base : ∀ z : ℝ, ρ h_b ≤ z → (ρ h_b - ρ 0) / h_b ≤ Real.exp (μ z)
  chord_bounds : ∀ z₁ z₂ : ℝ, ρ h_b ≤ z₁ → z₁ < z₂ →
    Real.exp (-μ z₂) * (z₂ - z₁) ≤ h z₂ - h z₁ ∧
    h z₂ - h z₁ ≤ Real.exp (-μ z₁) * (z₂ - z₁)
  exp_decay_height : ∀ c R_star : ℝ, 0 < c → ρ h_b ≤ R_star →
    (∀ z : ℝ, R_star ≤ z → c * z ≤ μ z) →
    ∀ R₁ R₂ : ℝ, R_star ≤ R₁ → R₁ ≤ R₂ →
      h R₂ - h R₁ ≤ Real.exp (-c * R₁) / (1 - Real.exp (-c))
structure UcbStripPoissonData (S : FiniteWallNonisotropicStrip) : Prop where
  kernel_cont : ∀ h' y : ℝ, 0 < h' → h' < S.H → 0 < y → y < h' →
    Continuous (fun u : ℝ => bootStripPoissonKernel h' u y)
  kernel_periodic : ∀ h' y : ℝ, 0 < h' → h' < S.H → 0 < y → y < h' →
    Function.Periodic (fun u : ℝ => bootStripPoissonKernel h' u y) (2 * Real.pi)
  kernel_nonneg : ∀ h' y u : ℝ, 0 < h' → h' < S.H → 0 < y → y < h' →
    0 ≤ bootStripPoissonKernel h' u y
  kernel_integral : ∀ h' y : ℝ, 0 < h' → h' < S.H → 0 < y → y < h' →
    (∫ u in (0 : ℝ)..(2 * Real.pi), bootStripPoissonKernel h' u y) = y / h'
  kernel_core_lower : ∃ c_core : ℝ, 0 < c_core ∧
    ∀ h' y u : ℝ, 0 < h' → h' < S.H → 0 < y → y < h' →
      h' - y ≤ h' / 4 → |u| ≤ 4 * (h' - y) →
      c_core / (h' - y) ≤ bootStripPoissonKernel h' u y
  strip_harmonic_V : ∀ h' y x : ℝ, 0 < h' → h' < S.H → 0 < y → y < h' →
    (S.V ((x : ℂ) + (y : ℂ) * Complex.I)).im =
      ∫ ξ in (0 : ℝ)..(2 * Real.pi),
        bootStripPoissonKernel h' (x - ξ) y *
          (S.V ((ξ : ℂ) + (h' : ℂ) * Complex.I)).im
def VolterraODEProp : Prop :=
  ∀ Q : ℝ → ℂ, ContinuousOn Q (Set.Icc (0 : ℝ) 1) →
    c0Kernel Q 0 = 1 ∧
    c0Deriv Q 0 = 0 ∧
    k0Kernel Q 0 = 0 ∧
    k0Deriv Q 0 = 1 ∧
    ContinuousOn (c0Kernel Q) (Set.Icc (0 : ℝ) 1) ∧
    ContinuousOn (c0Deriv Q) (Set.Icc (0 : ℝ) 1) ∧
    ContinuousOn (k0Kernel Q) (Set.Icc (0 : ℝ) 1) ∧
    ContinuousOn (k0Deriv Q) (Set.Icc (0 : ℝ) 1) ∧
    (∀ w ∈ Set.Icc (0 : ℝ) 1,
      HasDerivWithinAt (c0Kernel Q) (c0Deriv Q w) (Set.Icc (0 : ℝ) 1) w ∧
      HasDerivWithinAt (c0Deriv Q) (Q w * c0Kernel Q w) (Set.Icc (0 : ℝ) 1) w ∧
      HasDerivWithinAt (k0Kernel Q) (k0Deriv Q w) (Set.Icc (0 : ℝ) 1) w ∧
      HasDerivWithinAt (k0Deriv Q) (Q w * k0Kernel Q w) (Set.Icc (0 : ℝ) 1) w) ∧
    (∀ y y' : ℝ → ℂ,
      ContinuousOn y (Set.Icc (0 : ℝ) 1) →
      ContinuousOn y' (Set.Icc (0 : ℝ) 1) →
      (∀ w ∈ Set.Icc (0 : ℝ) 1,
        HasDerivWithinAt y (y' w) (Set.Icc (0 : ℝ) 1) w ∧
        HasDerivWithinAt y' (Q w * y w) (Set.Icc (0 : ℝ) 1) w) →
      ∀ w ∈ Set.Icc (0 : ℝ) 1,
        y w = y 0 * c0Kernel Q w + y' 0 * k0Kernel Q w ∧
        y' w = y 0 * c0Deriv Q w + y' 0 * k0Deriv Q w) ∧
    (∀ g g' : ℝ → ℂ,
      ContinuousOn g (Set.Icc (0 : ℝ) 1) →
      ContinuousOn g' (Set.Icc (0 : ℝ) 1) →
      (∀ w ∈ Set.Icc (0 : ℝ) 1,
        g w ≠ 0 ∧
        HasDerivWithinAt g (g' w) (Set.Icc (0 : ℝ) 1) w ∧
        HasDerivWithinAt g' (Q w * g w) (Set.Icc (0 : ℝ) 1) w) →
      k0Kernel Q 1 = g 0 * g 1 * ∫ w in (0 : ℝ)..1, (g w)⁻¹ ^ 2)

def VolterraLipHoloProp : Prop :=
  (∀ (M Δ : ℝ) (Q₁ Q₂ : ℝ → ℂ),
    0 ≤ M → 0 ≤ Δ →
    ContinuousOn Q₁ (Set.Icc (0 : ℝ) 1) →
    ContinuousOn Q₂ (Set.Icc (0 : ℝ) 1) →
    (∀ w ∈ Set.Icc (0 : ℝ) 1, ‖Q₁ w‖ ≤ M ∧ ‖Q₂ w‖ ≤ M ∧ ‖Q₁ w - Q₂ w‖ ≤ Δ) →
    ∀ w ∈ Set.Icc (0 : ℝ) 1,
      ‖c0Kernel Q₁ w‖ ≤ Real.exp M ∧
      ‖k0Kernel Q₁ w‖ ≤ Real.exp M ∧
      ‖c0Deriv Q₁ w‖ ≤ M * Real.exp M ∧
      ‖k0Deriv Q₁ w‖ ≤ 1 + M * Real.exp M ∧
      ‖c0Kernel Q₁ w - c0Kernel Q₂ w‖ ≤ Real.exp M * Δ ∧
      ‖k0Kernel Q₁ w - k0Kernel Q₂ w‖ ≤ Real.exp M * Δ ∧
      ‖c0Deriv Q₁ w - c0Deriv Q₂ w‖ ≤ (1 + M) * Real.exp M * Δ ∧
      ‖k0Deriv Q₁ w - k0Deriv Q₂ w‖ ≤ (1 + M) * Real.exp M * Δ) ∧
  (∀ (U : Set (ℂ × ℂ)) (Q : ℂ × ℂ → ℝ → ℂ) (a₀ a₁ : ℂ × ℂ → ℂ),
    IsOpen U →
    ContinuousOn (fun q : (ℂ × ℂ) × ℝ => Q q.1 q.2) (U ×ˢ Set.Icc (0 : ℝ) 1) →
    (∀ w ∈ Set.Icc (0 : ℝ) 1, DifferentiableOn ℂ (fun p => Q p w) U) →
    DifferentiableOn ℂ a₀ U →
    DifferentiableOn ℂ a₁ U →
    DifferentiableOn ℂ (fun p => c0Kernel (Q p) 1) U ∧
    DifferentiableOn ℂ (fun p => k0Kernel (Q p) 1) U ∧
    DifferentiableOn ℂ (fun p => kPlusVal (Q p) (a₀ p) (a₁ p)) U ∧
    DifferentiableOn ℂ (fun p => kMinusVal (Q p) (a₀ p) (a₁ p)) U)

noncomputable def bivarHybridDiv (N : ℂ → ℂ → ℂ) (b₀ b₁ : ℂ) : ℂ :=
  if b₀ ≠ 0 ∧ b₁ ≠ 0 then
    N b₀ b₁ / (b₀ * b₁)
  else
    (1 / 2 : ℂ) * dslope (fun w₀ => dslope (fun w₁ => N w₀ w₁) 0 b₁) 0 b₀ +
      (1 / 2 : ℂ) * dslope (fun w₁ => dslope (fun w₀ => N w₀ w₁) 0 b₀) 0 b₁
noncomputable def cseChartG (F : ℂ → ℂ → ℂ → ℂ) (b σ : ℝ) (S T D : ℂ) : ℂ :=
  let a : ℂ := T / (b : ℂ)
  if 0 < σ then
    rctActDJ F S D T - a * rctActDS F S D T
  else
    rctActDJ F (S - a * D) D T

noncomputable def cseChartNewton (F : ℂ → ℂ → ℂ → ℂ) (μ₀ : ℂ) (b σ : ℝ)
    (S P_mom T D : ℂ) : ℂ :=
  D - μ₀⁻¹ * (cseChartG F b σ S T D - P_mom)

noncomputable def cseChartIter (F : ℂ → ℂ → ℂ → ℂ) (μ₀ J₀ : ℂ) (b σ : ℝ)
    (S P_mom T : ℂ) : ℕ → ℂ
  | 0 => J₀
  | m + 1 => cseChartNewton F μ₀ b σ S P_mom T (cseChartIter F μ₀ J₀ b σ S P_mom T m)

noncomputable def cseChartRoot (F : ℂ → ℂ → ℂ → ℂ) (μ₀ J₀ : ℂ) (b σ : ℝ)
    (S P_mom T : ℂ) : ℂ :=
  Filter.limUnder Filter.atTop (cseChartIter F μ₀ J₀ b σ S P_mom T)

noncomputable def cseChartStep (F : ℂ → ℂ → ℂ → ℂ) (μ₀ J₀ : ℂ) (b σ : ℝ)
    (S P_mom T : ℂ) : ℂ × ℂ :=
  let a : ℂ := T / (b : ℂ)
  let D : ℂ := cseChartRoot F μ₀ J₀ b σ S P_mom T
  if 0 < σ then
    (S + a * D, P_mom + a * rctActDS F S D T)
  else
    let S_next : ℂ := S - a * D
    (S_next, P_mom - a * rctActDS F S_next D T)

def CseChartActionJet (F : ℂ → ℂ → ℂ → ℂ) (S₀ J₀ T₀ μ₀ : ℂ) (r_c M_c : ℝ) : Prop :=
  0 < r_c ∧ 0 < M_c ∧ μ₀ ≠ 0 ∧
  let Q_c : Set (ℂ × ℂ × ℂ) :=
    { q : ℂ × ℂ × ℂ | ‖q.1 - S₀‖ < r_c ∧ ‖q.2.1 - J₀‖ < r_c ∧ ‖q.2.2 - T₀‖ < r_c }
  DifferentiableOn ℂ (fun q : ℂ × ℂ × ℂ => F q.1 q.2.1 q.2.2) Q_c ∧
  DifferentiableOn ℂ (fun q : ℂ × ℂ × ℂ => rctActDS F q.1 q.2.1 q.2.2) Q_c ∧
  DifferentiableOn ℂ (fun q : ℂ × ℂ × ℂ => rctActDJ F q.1 q.2.1 q.2.2) Q_c ∧
  DifferentiableOn ℂ (fun q : ℂ × ℂ × ℂ => rctActDJJ F q.1 q.2.1 q.2.2) Q_c ∧
  DifferentiableOn ℂ (fun q : ℂ × ℂ × ℂ => rctActDSJ F q.1 q.2.1 q.2.2) Q_c ∧
  DifferentiableOn ℂ (fun q : ℂ × ℂ × ℂ => rctActDJS F q.1 q.2.1 q.2.2) Q_c ∧
  (∀ q ∈ Q_c,
    ‖rctActDJJ F q.1 q.2.1 q.2.2 - μ₀‖ ≤ (1 / 8 : ℝ) * ‖μ₀‖ ∧
    ‖rctActDS F q.1 q.2.1 q.2.2‖ ≤ M_c ∧
    ‖rctActDJ F q.1 q.2.1 q.2.2‖ ≤ M_c ∧
    ‖rctActDSJ F q.1 q.2.1 q.2.2‖ ≤ M_c ∧
    ‖rctActDJS F q.1 q.2.1 q.2.2‖ ≤ M_c ∧
    ‖rctActDJJ F q.1 q.2.1 q.2.2‖ ≤ M_c) ∧
  (∀ S₁ J₁ S₂ J₂ T : ℂ,
    (S₁, (J₁, T)) ∈ Q_c → (S₂, (J₂, T)) ∈ Q_c →
    ‖rctActDS F S₁ J₁ T - rctActDS F S₂ J₂ T‖ ≤ M_c * (‖S₁ - S₂‖ + ‖J₁ - J₂‖) ∧
    ‖rctActDJ F S₁ J₁ T - rctActDJ F S₂ J₂ T‖ ≤ M_c * (‖S₁ - S₂‖ + ‖J₁ - J₂‖))

def CseStepSmall (J₀ μ₀ : ℂ) (r_c M_c b : ℝ) (T : ℂ) : Prop :=
  let a : ℂ := T / (b : ℂ)
  ‖a‖ ≤ 1 ∧
  ‖a‖ * (1 + ‖J₀‖ + r_c) ≤ r_c / 4 ∧
  ‖a‖ * M_c * (1 + ‖J₀‖) ≤ min (‖μ₀‖ / 8) (‖μ₀‖ * r_c / 32)

def CseInChartDom (S₀ T₀ P₀ μ₀ : ℂ) (r_c r_T M_c : ℝ) (S P_mom T : ℂ) : Prop :=
  ‖S - S₀‖ < min (r_c / 4) (‖μ₀‖ * r_c / (32 * M_c)) ∧
  ‖P_mom - P₀‖ < (1 / 16 : ℝ) * ‖μ₀‖ * r_c ∧
  ‖T - T₀‖ < r_T

def CseSingleChartSolverProp : Prop :=
  ∀ (F : ℂ → ℂ → ℂ → ℂ) (S₀ J₀ T₀ P₀ μ₀ : ℂ) (r_c r_T M_c b σ : ℝ),
    CseChartActionJet F S₀ J₀ T₀ μ₀ r_c M_c →
    0 < r_T → r_T ≤ r_c → 0 < b →
    (∀ T : ℂ, ‖T - T₀‖ < r_T →
      ‖rctActDJ F S₀ J₀ T - P₀‖ ≤ (1 / 32 : ℝ) * ‖μ₀‖ * r_c) →
    (∀ S P_mom T : ℂ,
      CseInChartDom S₀ T₀ P₀ μ₀ r_c r_T M_c S P_mom T →
      CseStepSmall J₀ μ₀ r_c M_c b T →
      ‖cseChartRoot F μ₀ J₀ b σ S P_mom T - J₀‖ ≤ r_c / 2 ∧
      cseChartG F b σ S T (cseChartRoot F μ₀ J₀ b σ S P_mom T) = P_mom ∧
      ∀ D_test : ℂ, ‖D_test - J₀‖ ≤ (3 / 4 : ℝ) * r_c →
        ‖cseChartRoot F μ₀ J₀ b σ S P_mom T - D_test‖ ≤
          (2 / ‖μ₀‖) * ‖cseChartG F b σ S T D_test - P_mom‖) ∧
    (let C_D : ℝ := 2 * (2 * M_c + 1) / ‖μ₀‖
     let C_step : ℝ := C_D + M_c * (1 + 2 * C_D)
     ∀ S₁ P₁ S₂ P₂ T : ℂ,
       CseInChartDom S₀ T₀ P₀ μ₀ r_c r_T M_c S₁ P₁ T →
       CseInChartDom S₀ T₀ P₀ μ₀ r_c r_T M_c S₂ P₂ T →
       CseStepSmall J₀ μ₀ r_c M_c b T →
       let a : ℂ := T / (b : ℂ)
       let q₁' := cseChartStep F μ₀ J₀ b σ S₁ P₁ T
       let q₂' := cseChartStep F μ₀ J₀ b σ S₂ P₂ T
       ‖q₁'.1 - q₂'.1‖ + ‖q₁'.2 - q₂'.2‖ ≤
         (1 + C_step * ‖a‖) * (‖S₁ - S₂‖ + ‖P₁ - P₂‖)) ∧
    (∀ (W : Set (ℂ × ℂ)) (S_fn P_fn T_fn : ℂ × ℂ → ℂ),
      IsOpen W →
      DifferentiableOn ℂ S_fn W →
      DifferentiableOn ℂ P_fn W →
      DifferentiableOn ℂ T_fn W →
      (∀ w ∈ W,
        CseInChartDom S₀ T₀ P₀ μ₀ r_c r_T M_c (S_fn w) (P_fn w) (T_fn w) ∧
        CseStepSmall J₀ μ₀ r_c M_c b (T_fn w)) →
      DifferentiableOn ℂ
        (fun w => (cseChartStep F μ₀ J₀ b σ (S_fn w) (P_fn w) (T_fn w)).1) W ∧
      DifferentiableOn ℂ
        (fun w => (cseChartStep F μ₀ J₀ b σ (S_fn w) (P_fn w) (T_fn w)).2) W)

noncomputable def cseModelState {X : ExpStripData} (P : ChordActionPackage X)
    {kind : ExpProfileKind} (seq : ExpSequenceData X kind)
    (S_star : ℂ × ℂ → ℂ) (n : ℕ) (σ : ℝ) (Y T : ℂ) : ℂ × ℂ :=
  let a_n : ℂ := T / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ)
  rctInitSymplecticState P seq n σ (S_star (Y - (σ : ℂ) * a_n, T)) (S_star (Y, T)) T

def CseCorridorAtlasProp (X : ExpStripData) (P : ChordActionPackage X)
    (kind : ExpProfileKind) (seq : ExpSequenceData X kind) : Prop :=
  ∀ (V_mod : Set (ℂ × ℂ)) (S_star : ℂ × ℂ → ℂ) (K_corr : Set (ℂ × ℂ))
    (σ T_max : ℝ),
    IsRegularFrozenModel seq V_mod S_star →
    K_corr.Nonempty → IsCompact K_corr → K_corr ⊆ V_mod →
    (σ = 1 ∨ σ = -1) → 0 < T_max →
    (∀ p ∈ K_corr, ‖p.2‖ ≤ T_max) →
    ∃ (η_corr r_tube r_init_atl C_Lip C_cons : ℝ) (N_atl : ℕ) (δ₀ : ℕ → ℝ)
      (Ψ : ℕ → ℂ × ℂ → ℂ × ℂ → ℂ × ℂ),
      0 < η_corr ∧ 0 < r_tube ∧ 0 < r_init_atl ∧ 0 < C_Lip ∧ 0 < C_cons ∧
      (∀ n : ℕ, 0 ≤ δ₀ n) ∧
      Filter.Tendsto δ₀ Filter.atTop (nhds 0) ∧
      let U_corr : Set (ℂ × ℂ) :=
        { p : ℂ × ℂ | ∃ q ∈ K_corr, ‖p - q‖ < η_corr }
      IsOpen U_corr ∧ U_corr ⊆ V_mod ∧
      (∀ n ≥ N_atl, ∀ (Y T : ℂ) (S_fn : ℂ → ℂ),
        (Y, T) ∈ U_corr → T ≠ 0 → ‖T‖ ≤ T_max →
        let a_n : ℂ := T / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ)
        let J_star : ℂ := deriv (fun Y' => S_star (Y', T)) Y
        SatisfiesScaledChordRecurrence P seq S_fn n Y T →
        ‖S_fn (Y - (σ : ℂ) * a_n) - S_star (Y - (σ : ℂ) * a_n, T)‖ < r_init_atl →
        ‖S_fn Y - S_star (Y, T)‖ < r_init_atl →
        ‖S_fn (Y + (σ : ℂ) * a_n) - S_star (Y + (σ : ℂ) * a_n, T)‖ < r_init_atl →
        ‖(S_fn Y - S_fn (Y - (σ : ℂ) * a_n)) / ((σ : ℂ) * a_n) - J_star‖ < r_init_atl →
        ‖(S_fn (Y + (σ : ℂ) * a_n) - S_fn Y) / ((σ : ℂ) * a_n) - J_star‖ < r_init_atl →
        Ψ n (Y, T)
          (rctInitSymplecticState P seq n σ (S_fn (Y - (σ : ℂ) * a_n)) (S_fn Y) T) =
          rctInitSymplecticState P seq n σ (S_fn Y) (S_fn (Y + (σ : ℂ) * a_n)) T) ∧
      (∀ n ≥ N_atl, ∀ (Y₀ T S_prev S_curr : ℂ),
        (Y₀, T) ∈ U_corr → T ≠ 0 → ‖T‖ ≤ T_max →
        let a_n : ℂ := T / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ)
        let e_init : ℝ :=
          ‖S_curr - S_star (Y₀, T)‖ +
            ‖(S_curr - S_prev) / ((σ : ℂ) * a_n) -
              deriv (fun Y' => S_star (Y', T)) Y₀‖
        e_init < r_init_atl →
        let q₀ := rctInitSymplecticState P seq n σ S_prev S_curr T
        let q_mod := cseModelState P seq S_star n σ Y₀ T
        ‖q₀.1 - q_mod.1‖ + ‖q₀.2 - q_mod.2‖ ≤ C_cons * (e_init + δ₀ n)) ∧
      (∀ n ≥ N_atl, ∀ (Y T : ℂ) (q₁ q₂ : ℂ × ℂ),
        (Y, T) ∈ U_corr → T ≠ 0 → ‖T‖ ≤ T_max →
        let a_n : ℂ := T / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ)
        let q_mod := cseModelState P seq S_star n σ Y T
        ‖q₁.1 - q_mod.1‖ + ‖q₁.2 - q_mod.2‖ ≤ r_tube →
        ‖q₂.1 - q_mod.1‖ + ‖q₂.2 - q_mod.2‖ ≤ r_tube →
        ‖(Ψ n (Y, T) q₁).1 - (Ψ n (Y, T) q₂).1‖ +
          ‖(Ψ n (Y, T) q₁).2 - (Ψ n (Y, T) q₂).2‖ ≤
          (1 + C_Lip * ‖a_n‖) * (‖q₁.1 - q₂.1‖ + ‖q₁.2 - q₂.2‖)) ∧
      (∀ n ≥ N_atl, ∀ (Y T : ℂ),
        (Y, T) ∈ U_corr → T ≠ 0 → ‖T‖ ≤ T_max →
        let a_n : ℂ := T / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ)
        let q_mod := cseModelState P seq S_star n σ Y T
        let q_mod_next := cseModelState P seq S_star n σ (Y + (σ : ℂ) * a_n) T
        ‖(Ψ n (Y, T) q_mod).1 - q_mod_next.1‖ +
          ‖(Ψ n (Y, T) q_mod).2 - q_mod_next.2‖ ≤ C_cons * δ₀ n * ‖a_n‖) ∧
      (∀ n ≥ N_atl, ∀ (Y T S : ℂ),
        (Y, T) ∈ U_corr → ‖S - S_star (Y, T)‖ ≤ r_tube →
        expBasePt seq n + (seq.ℓ_seq n : ℂ) * S ∈ X.D_strip) ∧
      (∀ n ≥ N_atl, ∀ (W : Set (ℂ × ℂ)) (Y₀_fn T_fn S_prev_fn S_curr_fn : ℂ × ℂ → ℂ),
        IsOpen W →
        DifferentiableOn ℂ Y₀_fn W →
        DifferentiableOn ℂ T_fn W →
        DifferentiableOn ℂ S_prev_fn W →
        DifferentiableOn ℂ S_curr_fn W →
        (∀ w ∈ W,
          (Y₀_fn w, T_fn w) ∈ U_corr ∧ T_fn w ≠ 0 ∧ ‖T_fn w‖ ≤ T_max ∧
          let a_n : ℂ := T_fn w / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ)
          ‖S_curr_fn w - S_star (Y₀_fn w, T_fn w)‖ +
            ‖(S_curr_fn w - S_prev_fn w) / ((σ : ℂ) * a_n) -
              deriv (fun Y' => S_star (Y', T_fn w)) (Y₀_fn w)‖ < r_init_atl) →
        DifferentiableOn ℂ
          (fun w => (rctInitSymplecticState P seq n σ (S_prev_fn w) (S_curr_fn w) (T_fn w)).1) W ∧
        DifferentiableOn ℂ
          (fun w => (rctInitSymplecticState P seq n σ (S_prev_fn w) (S_curr_fn w) (T_fn w)).2) W) ∧
      (∀ n ≥ N_atl, ∀ (W : Set (ℂ × ℂ)) (Y_fn T_fn S_fn P_fn : ℂ × ℂ → ℂ),
        IsOpen W →
        DifferentiableOn ℂ Y_fn W →
        DifferentiableOn ℂ T_fn W →
        DifferentiableOn ℂ S_fn W →
        DifferentiableOn ℂ P_fn W →
        (∀ w ∈ W,
          (Y_fn w, T_fn w) ∈ U_corr ∧ T_fn w ≠ 0 ∧ ‖T_fn w‖ ≤ T_max ∧
          let q_mod := cseModelState P seq S_star n σ (Y_fn w) (T_fn w)
          ‖S_fn w - q_mod.1‖ + ‖P_fn w - q_mod.2‖ ≤ r_tube) →
        DifferentiableOn ℂ (fun w => (Ψ n (Y_fn w, T_fn w) (S_fn w, P_fn w)).1) W ∧
        DifferentiableOn ℂ (fun w => (Ψ n (Y_fn w, T_fn w) (S_fn w, P_fn w)).2) W)
noncomputable def idpluSlopeQ {kind : ExpProfileKind} (I : ModelDiskInput kind) (ξ : ℂ) : ℂ :=
  dslope (fun z : ℂ => (I.P z)⁻¹) 0 ξ

noncomputable def idpluQ {kind : ExpProfileKind} (I : ModelDiskInput kind) (v : ℂ) : ℂ :=
  ∫ t in (0 : ℝ)..1, v * idpluSlopeQ I ((t : ℂ) * v)

noncomputable def idpluWMap {kind : ExpProfileKind} (I : ModelDiskInput kind) (v : ℂ) : ℂ :=
  2 * v * Complex.exp (idpluQ I v)

noncomputable def idpluWReal {kind : ExpProfileKind} (I : ModelDiskInput kind) (r : ℝ) : ℝ :=
  2 * r * Real.exp ((idpluQ I (r : ℂ)).re)

noncomputable def idpluRadius {kind : ExpProfileKind} (I : ModelDiskInput kind) : ℝ :=
  sSup (idpluWReal I '' Set.Ico (0 : ℝ) I.v_c)

structure IdpluForwardDiskMapProp {kind : ExpProfileKind} (I : ModelDiskInput kind) : Prop where
  R_pos : 0 < idpluRadius I
  R_le : idpluRadius I ≤ 2 * I.v_c
  Q_holo : DifferentiableOn ℂ (idpluQ I) (Metric.ball (0 : ℂ) I.v_c)
  Q_zero : idpluQ I 0 = 0
  Q_even : ∀ v ∈ Metric.ball (0 : ℂ) I.v_c, idpluQ I (-v) = idpluQ I v
  Q_real : ∀ r : ℝ, |r| < I.v_c → (idpluQ I (r : ℂ)).im = 0
  Q_mul_deriv : ∀ v ∈ Metric.ball (0 : ℂ) I.v_c,
    v * deriv (idpluQ I) v = (I.P v)⁻¹ - 1
  w_map_holo : DifferentiableOn ℂ (idpluWMap I) (Metric.ball (0 : ℂ) I.v_c)
  w_map_zero : idpluWMap I 0 = 0
  w_map_deriv_zero : deriv (idpluWMap I) 0 = 2
  w_map_odd : ∀ v ∈ Metric.ball (0 : ℂ) I.v_c, idpluWMap I (-v) = -idpluWMap I v
  w_map_deriv : ∀ v ∈ Metric.ball (0 : ℂ) I.v_c,
    deriv (idpluWMap I) v = 2 * Complex.exp (idpluQ I v) / I.P v
  w_map_real : ∀ r : ℝ, |r| < I.v_c → idpluWMap I (r : ℂ) = (idpluWReal I r : ℂ)
  w_real_cont : ContinuousOn (idpluWReal I) (Set.Ico 0 I.v_c)
  w_real_strictMono : StrictMonoOn (idpluWReal I) (Set.Ico 0 I.v_c)
  w_real_zero : idpluWReal I 0 = 0
  w_real_tendsto : Filter.Tendsto (idpluWReal I)
    (nhdsWithin I.v_c (Set.Iio I.v_c)) (nhds (idpluRadius I))
  w_real_surj : ∀ y ∈ Set.Ico (0 : ℝ) (idpluRadius I),
    ∃ r ∈ Set.Ico (0 : ℝ) I.v_c, idpluWReal I r = y
  w_real_props : ∀ r ∈ Set.Ioo (0 : ℝ) I.v_c,
    0 < idpluWReal I r ∧ idpluWReal I r < idpluRadius I ∧
    HasDerivAt (idpluWReal I) (idpluWReal I r / (r * (I.P (r : ℂ)).re)) r

structure IdpluLocalNonnegOddSeriesData {kind : ExpProfileKind} (I : ModelDiskInput kind) where
  c : ℕ → ℝ
  r₀ : ℝ
  r₀_pos : 0 < r₀
  r₀_le_R : r₀ ≤ idpluRadius I
  c_zero : c 0 = 0
  c_one : c 1 = 1 / 2
  c_nonneg : ∀ n : ℕ, 0 ≤ c n
  c_even_zero : ∀ k : ℕ, c (2 * k) = 0
  local_inv : ∀ w ∈ Metric.ball (0 : ℂ) r₀,
    Summable (fun n : ℕ => (c n : ℂ) * w ^ n) ∧
    ‖∑' n : ℕ, (c n : ℂ) * w ^ n‖ < I.v_c ∧
    idpluWMap I (∑' n : ℕ, (c n : ℂ) * w ^ n) = w

structure IdpluPringsheimInverseData {kind : ExpProfileKind} (I : ModelDiskInput kind) where
  v_inv : ℂ → ℂ
  v_inv_holo : DifferentiableOn ℂ v_inv (Metric.ball (0 : ℂ) (idpluRadius I))
  v_inv_zero : v_inv 0 = 0
  v_inv_odd : ∀ w ∈ Metric.ball (0 : ℂ) (idpluRadius I), v_inv (-w) = -v_inv w
  v_inv_maps_to : ∀ w ∈ Metric.ball (0 : ℂ) (idpluRadius I),
    v_inv w ∈ Metric.ball (0 : ℂ) I.v_c
  w_map_v_inv : ∀ w ∈ Metric.ball (0 : ℂ) (idpluRadius I),
    idpluWMap I (v_inv w) = w
  v_inv_ode : ∀ w ∈ Metric.ball (0 : ℂ) (idpluRadius I),
    w * deriv v_inv w = v_inv w * I.P (v_inv w)
  v_inv_real : ∀ r ∈ Set.Ico (0 : ℝ) I.v_c,
    v_inv (idpluWReal I r : ℂ) = (r : ℂ)
noncomputable def deepPassPt (S : FiniteWallNonisotropicStrip)
    (ξ_seq d_seq : ℕ → ℝ) (n : ℕ) (Z : ℂ) : ℂ :=
  (ξ_seq n : ℂ) + (S.H : ℂ) * Complex.I + (d_seq n : ℂ) * Z

noncomputable def deepPassStep (d_seq B_seq : ℕ → ℝ) (n : ℕ) (T : ℂ) : ℂ :=
  T * (d_seq n : ℂ) / (B_seq n : ℂ)

noncomputable def deepPassActionSeq (S : FiniteWallNonisotropicStrip)
    (A : SmallFieldChordActionData S) (ξ_seq d_seq B_seq : ℕ → ℝ)
    (n : ℕ) (T Z J : ℂ) : ℂ :=
  smallChordActionP A.Phi (deepPassPt S ξ_seq d_seq n Z) J (deepPassStep d_seq B_seq n T)

noncomputable def deepPassPhiDS (Phi : ℂ × ℂ → ℂ) (q : ℂ × ℂ) : ℂ :=
  deriv (fun s' : ℂ => Phi (s', q.2)) q.1

noncomputable def deepPassPhiDH (Phi : ℂ × ℂ → ℂ) (q : ℂ × ℂ) : ℂ :=
  deriv (fun h' : ℂ => Phi (q.1, h')) q.2

structure DeepPassPartialCalculus (S : FiniteWallNonisotropicStrip)
    (A : SmallFieldChordActionData S) : Prop where
  phi_ds_holo : DifferentiableOn ℂ (deepPassPhiDS A.Phi) (smallChordDomain S A.η_SL)
  phi_dh_holo : DifferentiableOn ℂ (deepPassPhiDH A.Phi) (smallChordDomain S A.η_SL)
  deriv_actionP_J : ∀ s J t : ℂ,
    (s, t * J) ∈ smallChordDomain S A.η_SL →
    deriv (fun J' : ℂ => smallChordActionP A.Phi s J' t) J =
      3 * J ^ 2 * A.Phi (s, t * J) + J ^ 3 * t * deepPassPhiDH A.Phi (s, t * J)
  deriv_actionP_s : ∀ s J t : ℂ,
    (s, t * J) ∈ smallChordDomain S A.η_SL →
    deriv (fun s' : ℂ => smallChordActionP A.Phi s' J t) s =
      J ^ 3 * deepPassPhiDS A.Phi (s, t * J)
  cauchy_deriv_conv : ∀ (U_Z K_Z : Set ℂ) (ρ_K : ℝ)
      (g_seq : ℕ → ℂ → ℂ → ℂ) (g_lim : ℂ → ℂ → ℂ),
    IsOpen U_Z → IsCompact K_Z → 0 < ρ_K →
    Metric.cthickening ρ_K K_Z ⊆ U_Z →
    (∃ N₀ : ℕ, ∀ n ≥ N₀,
      DifferentiableOn ℂ (fun q : ℂ × ℂ => g_seq n q.1 q.2)
        (U_Z ×ˢ Metric.ball (1 : ℂ) (1 / 4))) →
    DifferentiableOn ℂ (fun q : ℂ × ℂ => g_lim q.1 q.2)
      (U_Z ×ˢ Metric.ball (1 : ℂ) (1 / 4)) →
    TendstoUniformlyOn
      (fun n (q : ℂ × ℂ) => g_seq n q.1 q.2)
      (fun q : ℂ × ℂ => g_lim q.1 q.2)
      Filter.atTop (Metric.cthickening ρ_K K_Z ×ˢ Metric.closedBall (1 : ℂ) (3 / 16)) →
    TendstoUniformlyOn
      (fun n (q : ℂ × ℂ) => deriv (fun J' => g_seq n q.1 J') q.2)
      (fun q : ℂ × ℂ => deriv (fun J' => g_lim q.1 J') q.2)
      Filter.atTop (K_Z ×ˢ Metric.closedBall (1 : ℂ) (1 / 8)) ∧
    TendstoUniformlyOn
      (fun n (q : ℂ × ℂ) => deriv (fun Z' => g_seq n Z' q.2) q.1)
      (fun q : ℂ × ℂ => deriv (fun Z' => g_lim Z' q.2) q.1)
      Filter.atTop (K_Z ×ˢ Metric.closedBall (1 : ℂ) (1 / 8))

structure DeepPassConeCore (S : FiniteWallNonisotropicStrip)
    (α A₀ T₀ δ_b : ℝ) (d_seq B_seq ξ_seq : ℕ → ℝ) where
  D_pass : ℝ
  C_A : ℝ
  C_pass : ℝ
  N_coarse : ℕ
  S_seq : ℕ → (ℂ × ℂ → ℂ)
  D_pass_ge : 20 ≤ D_pass
  C_A_pos : 0 < C_A
  C_pass_pos : 0 < C_pass
  C_A_sq_le : C_A ^ 2 ≤ C_pass
  coarse_bound : ∀ n ≥ N_coarse, ∀ Z : ℂ,
    1 ≤ -Z.im → d_seq n * (-Z.im) ≤ δ_b → |Z.re| ≤ (A₀ + 6) * (-Z.im) →
    (d_seq n / B_seq n) * shapeModulus S (deepPassPt S ξ_seq d_seq n Z) ≤
      C_A * (-Z.im) ^ (-α)
  trunc_and_tube : ∀ R_top : ℝ, D_pass < R_top →
    ∃ N_cone : ℕ, ∀ n ≥ N_cone,
      DifferentiableOn ℂ (S_seq n)
        { p : ℂ × ℂ |
          ‖p.1‖ < (3 / 2 : ℝ) * T₀ ∧
          D_pass / 2 < -p.2.im ∧ -p.2.im < R_top ∧
          |p.2.re| < (A₀ + 3) * (-p.2.im) } ∧
      (∀ T Y : ℂ,
        ‖T‖ < (3 / 2 : ℝ) * T₀ →
        D_pass / 2 < -Y.im → -Y.im < R_top →
        |Y.re| < (A₀ + 3) * (-Y.im) →
        (S_seq n (T, Y)).im < 0 ∧
        ‖S_seq n (T, Y) - Y‖ ≤ C_pass * ‖T‖ ^ 2 * (-Y.im) ^ (1 - 2 * α)) ∧
      (∀ Y : ℂ, D_pass / 2 < -Y.im → -Y.im < R_top → |Y.re| < (A₀ + 3) * (-Y.im) →
        S_seq n (0, Y) = Y) ∧
      (∀ T Y : ℂ,
        ‖T‖ < (3 / 2 : ℝ) * T₀ →
        D_pass / 2 < -Y.im → -Y.im < R_top →
        |Y.re| < (A₀ + 3) * (-Y.im) →
        (deepPassPt S ξ_seq d_seq n Y, deepPassStep d_seq B_seq n T) ∈
          finiteWallTube S.r_star S.h_X →
        S_seq n (T, Y) =
          (S.𝔰 (deepPassPt S ξ_seq d_seq n Y, deepPassStep d_seq B_seq n T) -
            (ξ_seq n : ℂ) - (S.H : ℂ) * Complex.I) / (d_seq n : ℂ))

structure DeepPassRecurrenceData (S : FiniteWallNonisotropicStrip)
    (A : SmallFieldChordActionData S) (α A₀ T₀ δ_b : ℝ)
    (d_seq B_seq ξ_seq : ℕ → ℝ)
    (C_core : DeepPassConeCore S α A₀ T₀ δ_b d_seq B_seq ξ_seq) where
  D_rec : ℝ
  D_rec_ge : C_core.D_pass ≤ D_rec
  small_field_on_D_rec :
    4 * T₀ ^ 2 * C_core.C_A ^ 2 * (2 / D_rec) ^ (2 * α) < min (A.η_SL / 2) 4
  compact_chord_admissible : ∀ K_pad : Set ℂ, IsCompact K_pad →
    K_pad ⊆ { Z : ℂ | D_rec / 2 < -Z.im ∧ |Z.re| < (A₀ + 4) * (-Z.im) } →
    (∃ N_adm : ℕ, ∀ n ≥ N_adm,
      ∀ Z ∈ K_pad, ∀ J : ℂ, ‖J‖ ≤ 5 / 4 → ∀ T' : ℂ, ‖T'‖ ≤ (5 / 4 : ℝ) * T₀ →
        (deepPassPt S ξ_seq d_seq n Z, deepPassStep d_seq B_seq n T' * J) ∈
          smallChordDomain S A.η_SL) ∧
    (∀ ε : ℝ, 0 < ε → ∃ N_deriv : ℕ, ∀ n ≥ N_deriv,
      ∀ Z ∈ K_pad, ∀ J : ℂ, ‖J‖ ≤ 5 / 4 → ∀ T' : ℂ, ‖T'‖ ≤ (5 / 4 : ℝ) * T₀ →
        ‖(deepPassStep d_seq B_seq n T' * J) ^ 2 *
          deriv S.f (deepPassPt S ξ_seq d_seq n Z)‖ < ε)
  action_holo_on_open : ∀ T : ℂ, ‖T‖ < T₀ →
    ∀ K_Z : Set ℂ, IsCompact K_Z →
      K_Z ⊆ { Z : ℂ | D_rec < -Z.im ∧ |Z.re| < (A₀ + 3) * (-Z.im) } →
      ∃ (U_Z : Set ℂ) (ρ_K : ℝ),
        IsOpen U_Z ∧ 0 < ρ_K ∧ K_Z ⊆ U_Z ∧
        Metric.cthickening ρ_K K_Z ⊆ U_Z ∧
        Metric.cthickening (2 * ρ_K) K_Z ⊆
          { Z : ℂ | D_rec / 2 < -Z.im ∧ |Z.re| < (A₀ + 4) * (-Z.im) } ∧
        U_Z ⊆ { Z : ℂ | D_rec / 2 < -Z.im ∧ |Z.re| < (A₀ + 4) * (-Z.im) } ∧
        ∃ N_holo : ℕ, ∀ n ≥ N_holo,
          DifferentiableOn ℂ
            (fun q : ℂ × ℂ => deepPassActionSeq S A ξ_seq d_seq B_seq n T q.1 q.2)
            (U_Z ×ˢ Metric.ball (1 : ℂ) (1 / 4)) ∧
          DifferentiableOn ℂ
            (fun q : ℂ × ℂ =>
              deriv (fun J' => deepPassActionSeq S A ξ_seq d_seq B_seq n T q.1 J') q.2)
            (U_Z ×ˢ Metric.ball (1 : ℂ) (1 / 4))
  recurrence_eq : ∀ R_top : ℝ, 3 * D_rec < R_top →
    ∀ T : ℂ, ‖T‖ < T₀ → T ≠ 0 →
      ∃ N_rec : ℕ, ∀ n ≥ N_rec,
        ∀ Y : ℂ, 2 * D_rec < -Y.im → -Y.im < R_top - 2 → |Y.re| < (A₀ + 2) * (-Y.im) →
          let h_n : ℂ := T / (B_seq n : ℂ)
          let J_p : ℂ := (C_core.S_seq n (T, Y + h_n) - C_core.S_seq n (T, Y)) / h_n
          let J_m : ℂ := (C_core.S_seq n (T, Y) - C_core.S_seq n (T, Y - h_n)) / h_n
          ‖J_p - 1‖ ≤ 1 / 16 ∧ ‖J_m - 1‖ ≤ 1 / 16 ∧
          D_rec < -(C_core.S_seq n (T, Y)).im ∧
          |(C_core.S_seq n (T, Y)).re| < (A₀ + 3) * (-(C_core.S_seq n (T, Y)).im) ∧
          D_rec < -(C_core.S_seq n (T, Y - h_n)).im ∧
          |(C_core.S_seq n (T, Y - h_n)).re| < (A₀ + 3) * (-(C_core.S_seq n (T, Y - h_n)).im) ∧
          deriv (fun J' => deepPassActionSeq S A ξ_seq d_seq B_seq n T (C_core.S_seq n (T, Y)) J') J_p -
            deriv (fun J' => deepPassActionSeq S A ξ_seq d_seq B_seq n T (C_core.S_seq n (T, Y - h_n)) J') J_m =
            h_n * deriv (fun Z' => deepPassActionSeq S A ξ_seq d_seq B_seq n T Z' J_p) (C_core.S_seq n (T, Y))
noncomputable def steepRowEnergy (S : FiniteWallNonisotropicStrip) (y : ℝ) : ℝ :=
  (2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi),
    (‖S.f ((x : ℂ) + (y : ℂ) * Complex.I)‖ ^ 2 +
      ‖S.q ((x : ℂ) + (y : ℂ) * Complex.I)‖)

structure SteepDiagonalRowData (S : FiniteWallNonisotropicStrip)
    (δ_b C_tail' : ℝ) (h_seq ℓ_seq m0_seq : ℕ → ℝ) : Prop where
  C_tail_pos : 0 < C_tail'
  row_basic : ∀ j : ℕ,
    0 < h_seq j ∧
    h_seq j < S.H ∧
    S.H - h_seq j < δ_b ∧
    0 < ℓ_seq j ∧
    0 < m0_seq j ∧
    3 * ((j : ℝ) + 3) * ℓ_seq j < S.H - h_seq j ∧
    steepRowEnergy S (h_seq j) = (m0_seq j) ^ 2
  h_tendsto : Filter.Tendsto h_seq Filter.atTop (nhds S.H)
  ℓ_tendsto : Filter.Tendsto ℓ_seq Filter.atTop (nhds 0)
  prod_tendsto : Filter.Tendsto (fun j => ℓ_seq j * m0_seq j) Filter.atTop Filter.atTop
  ratio_tendsto : Filter.Tendsto (fun j => (S.H - h_seq j) / ℓ_seq j) Filter.atTop Filter.atTop
  unit_band_bound : ∀ j : ℕ, ∀ u ∈ Set.Icc (-1 : ℝ) 1,
    |h_seq j + ℓ_seq j * u| < S.H ∧
    steepRowEnergy S (h_seq j + ℓ_seq j * u) / (m0_seq j) ^ 2 ≤
      Real.exp (2 * u) + (4 * Real.exp 2 * ((j : ℝ) + 1))⁻¹
  local_band_bound : ∀ j : ℕ,
    ∀ u ∈ Set.Icc (-2 * ((j : ℝ) + 2)) (2 * ((j : ℝ) + 2)),
      |h_seq j + ℓ_seq j * u| < S.H ∧
      steepRowEnergy S (h_seq j + ℓ_seq j * u) / (m0_seq j) ^ 2 ≤
        2 * Real.exp (2 * |u|) + 1
  coarse_tail_bound : ∀ j : ℕ, ∀ v : ℝ, 0 ≤ v → ℓ_seq j * v ≤ (5 / 2 : ℝ) * δ_b →
    |h_seq j - ℓ_seq j * v| < S.H ∧
    steepRowEnergy S (h_seq j - ℓ_seq j * v) / (m0_seq j) ^ 2 ≤
      C_tail' * (1 + v) ^ (-(5 / 4 : ℝ))
def secondScaleCompactRect (m : ℕ) : Set ℂ :=
  { Z : ℂ | |Z.re| ≤ (m : ℝ) ∧ -(m : ℝ) ≤ Z.im ∧ Z.im ≤ -((m : ℝ)⁻¹) }

structure SecondScaleKernelTileToolkit (S : FiniteWallNonisotropicStrip) : Prop where
  poisson_props :
    ∀ (d_a : ℝ) (w : ℝ → ℝ),
      0 < d_a →
      Continuous w →
      Function.Periodic w (2 * Real.pi) →
      (∀ y : ℝ, 0 ≤ w y) →
      (2 * Real.pi)⁻¹ * (∫ y in (0 : ℝ)..(2 * Real.pi), w y) = 1 →
      Continuous (ancestorPoissonDensity d_a w) ∧
      Function.Periodic (ancestorPoissonDensity d_a w) (2 * Real.pi) ∧
      (∀ x : ℝ, 0 ≤ ancestorPoissonDensity d_a w x) ∧
      (2 * Real.pi)⁻¹ * (∫ x in (0 : ℝ)..(2 * Real.pi), ancestorPoissonDensity d_a w x) = 1 ∧
      (∀ B h : ℝ, 0 ≤ B → |h| ≤ B * d_a →
        ∀ G : ℝ → ℝ, Continuous G → Function.Periodic G (2 * Real.pi) →
          (2 * Real.pi)⁻¹ * (∫ x in (0 : ℝ)..(2 * Real.pi),
            (G (x + h)) ^ 2 * ancestorPoissonDensity d_a w x) ≤
            2 * (1 + B ^ 2) * ((2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi),
              (G x) ^ 2 * ancestorPoissonDensity d_a w x))
  tile_props :
    ∀ A k : ℝ, 0 ≤ A → criticalDepthThreshold S ≤ k →
      Continuous (tileSupModulus S A k) ∧
      Function.Periodic (tileSupModulus S A k) (2 * Real.pi) ∧
      (∀ x : ℝ, 0 ≤ tileSupModulus S A k x) ∧
      (∀ x : ℝ, ∀ s ∈ upperStripTile S A k x,
        Real.exp (-k) * shapeModulus S s ≤ tileSupModulus S A k x)
  q_sup_cont :
    ∀ K : Set ℂ, IsCompact K → K.Nonempty → K ⊆ criticalLowerHalfPlane →
      ∀ d c : ℝ, 0 < d → 0 ≤ c → (∀ Z ∈ K, d * (-Z.im) < S.H) →
        Continuous (fun x : ℝ =>
          min 1 (sSup ((fun Z : ℂ =>
            c * ‖S.q ((x : ℂ) + (S.H : ℂ) * Complex.I + (d : ℂ) * Z)‖) '' K)))
def meshTileIsGood (F : ℂ → ℂ) (B_low : ℝ) (c : ℂ) (ρ : ℝ) : Prop :=
  ∃ q ∈ meshClosedSquare c ρ, Real.exp B_low ≤ ‖F q‖

def DyadicShadowBoundAt (L₀ M_lat C_shad : ℝ) : Prop :=
  ∀ (p d τ M_top U₀ H_def : ℝ) (F : ℂ → ℂ)
    (N : ℕ) (x_T d_T ρ_T : Fin N → ℝ),
    0 < d → 0 < τ → τ < d / 4 → 0 ≤ U₀ → 0 < H_def →
    (∀ i : Fin N, 0 < ρ_T i ∧ 1024 * ρ_T i ≤ d_T i ∧ d_T i ≤ 2048 * ρ_T i ∧
      d_T i ≤ d / 2 ∧ |x_T i - p| ≤ (L₀ + 3) * d ∧ τ < d_T i / 4) →
    DifferentiableOn ℂ F criticalLowerHalfPlane →
    (∀ z : ℂ, |z.re - p| ≤ M_lat * d → τ ≤ -z.im → -z.im ≤ 2 * d →
      ‖F z‖ ≤ Real.exp M_top) →
    Real.exp (M_top - U₀) ≤ ‖F ((p : ℂ) - (d : ℂ) * Complex.I)‖ →
    (∀ i : Fin N, ∀ z ∈ Metric.closedBall ((x_T i : ℂ) - (d_T i : ℂ) * Complex.I) (ρ_T i / 8),
      ‖F z‖ ≤ Real.exp (M_top - H_def)) →
    MeasureTheory.volume.real
      (⋃ i : Fin N, Set.Icc (x_T i - ρ_T i / 2) (x_T i + ρ_T i / 2)) ≤
      C_shad * d * (U₀ / H_def)

def DyadicChainRoutingAt (C_route C_len : ℝ) : Prop :=
  ∀ (m : ℕ) (c : Fin (m + 1) → ℂ) (ρ : Fin (m + 1) → ℝ)
    (F : ℂ → ℂ) (M T : ℝ),
    0 < T →
    (∀ k : Fin (m + 1), 0 < ρ k) →
    (∀ k : Fin m,
      (meshClosedSquare (c k.castSucc) (ρ k.castSucc) ∩
        meshClosedSquare (c k.succ) (ρ k.succ)).Nonempty ∧
      ρ k.castSucc / 2 ≤ ρ k.succ ∧ ρ k.succ ≤ 2 * ρ k.castSucc) →
    (∀ k : Fin (m + 1),
      DifferentiableOn ℂ F (Metric.ball (c k) (100 * ρ k)) ∧
      (∀ z ∈ Metric.ball (c k) (100 * ρ k), ‖F z‖ ≤ Real.exp M) ∧
      (∃ q ∈ meshClosedSquare (c k) (ρ k), Real.exp (M - 2 * T) ≤ ‖F q‖)) →
    ∃ (γ : List ℂ) (hγ : γ ≠ []),
      γ.head hγ ∈ meshClosedSquare (c 0) (ρ 0) ∧
      γ.getLast hγ ∈ meshClosedSquare (c (Fin.last m)) (ρ (Fin.last m)) ∧
      meshPolyTrace γ ⊆ (⋃ k : Fin (m + 1), meshClosedSquare (c k) (9 * ρ k)) ∧
      meshPolyLength γ ≤ C_len * (∑ k : Fin (m + 1), ρ k) ∧
      ∀ z ∈ meshPolyTrace γ, Real.exp (M - C_route * T) ≤ ‖F z‖

def DyadicGoodHorizChain (x_left : ℝ) (M_w L_min L_max : ℕ)
    (isGoodTile : ℂ → ℝ → Prop) : Prop :=
  ∃ (m : ℕ) (c : Fin (m + 1) → ℂ) (ρ : Fin (m + 1) → ℝ),
    (∀ k : Fin (m + 1),
      0 < ρ k ∧
      1024 * ρ k ≤ -(c k).im ∧
      -(c k).im ≤ 2048 * ρ k ∧
      x_left + ρ k / 2 ≤ (c k).re ∧
      (c k).re ≤ x_left + (M_w : ℝ) / 2 - ρ k / 2 ∧
      ((2 : ℝ) ^ L_max)⁻¹ + ρ k / 2 ≤ -(c k).im ∧
      -(c k).im ≤ ((2 : ℝ) ^ L_min)⁻¹ - ρ k / 2 ∧
      isGoodTile (c k) (ρ k)) ∧
    (c 0).re = x_left + ρ 0 / 2 ∧
    (c (Fin.last m)).re = x_left + (M_w : ℝ) / 2 - ρ (Fin.last m) / 2 ∧
    (∀ k : Fin m,
      (meshClosedSquare (c k.castSucc) (ρ k.castSucc) ∩
        meshClosedSquare (c k.succ) (ρ k.succ)).Nonempty ∧
      ρ k.castSucc / 2 ≤ ρ k.succ ∧ ρ k.succ ≤ 2 * ρ k.castSucc) ∧
    (∑ k : Fin (m + 1), ρ k) ≤ 512 * (M_w : ℝ) * ((L_max - L_min : ℕ) : ℝ)

def DyadicBadVertChain (x_left : ℝ) (M_w L_min L_max : ℕ)
    (isGoodTile : ℂ → ℝ → Prop) : Prop :=
  ∃ (r : ℕ) (x_T d_T ρ_T : Fin (r + 1) → ℝ),
    (∀ k : Fin (r + 1),
      0 < ρ_T k ∧
      1024 * ρ_T k ≤ d_T k ∧
      d_T k ≤ 2048 * ρ_T k ∧
      x_left + ρ_T k / 2 ≤ x_T k ∧
      x_T k ≤ x_left + (M_w : ℝ) / 2 - ρ_T k / 2 ∧
      ((2 : ℝ) ^ L_max)⁻¹ + ρ_T k / 2 ≤ d_T k ∧
      d_T k ≤ ((2 : ℝ) ^ L_min)⁻¹ - ρ_T k / 2 ∧
      ¬ isGoodTile ((x_T k : ℂ) - (d_T k : ℂ) * Complex.I) (ρ_T k)) ∧
    d_T 0 = ((2 : ℝ) ^ L_max)⁻¹ + ρ_T 0 / 2 ∧
    d_T (Fin.last r) = ((2 : ℝ) ^ L_min)⁻¹ - ρ_T (Fin.last r) / 2 ∧
    (∀ k : Fin r,
      |x_T k.succ - x_T k.castSucc| ≤ (ρ_T k.castSucc + ρ_T k.succ) / 2 ∧
      |d_T k.succ - d_T k.castSucc| ≤ (ρ_T k.castSucc + ρ_T k.succ) / 2 ∧
      ρ_T k.castSucc / 2 ≤ ρ_T k.succ ∧ ρ_T k.succ ≤ 2 * ρ_T k.castSucc)

def DyadicGoodVertChain (x_left : ℝ) (M_w L_min L_max : ℕ)
    (isGoodTile : ℂ → ℝ → Prop) : Prop :=
  ∃ (m : ℕ) (c : Fin (m + 1) → ℂ) (ρ : Fin (m + 1) → ℝ),
    (∀ k : Fin (m + 1),
      0 < ρ k ∧
      1024 * ρ k ≤ -(c k).im ∧
      -(c k).im ≤ 2048 * ρ k ∧
      x_left + ρ k / 2 ≤ (c k).re ∧
      (c k).re ≤ x_left + (M_w : ℝ) / 2 - ρ k / 2 ∧
      ((2 : ℝ) ^ L_max)⁻¹ + ρ k / 2 ≤ -(c k).im ∧
      -(c k).im ≤ ((2 : ℝ) ^ L_min)⁻¹ - ρ k / 2 ∧
      isGoodTile (c k) (ρ k)) ∧
    -(c 0).im = ((2 : ℝ) ^ L_min)⁻¹ - ρ 0 / 2 ∧
    -(c (Fin.last m)).im = ((2 : ℝ) ^ L_max)⁻¹ + ρ (Fin.last m) / 2 ∧
    (∀ k : Fin m,
      (meshClosedSquare (c k.castSucc) (ρ k.castSucc) ∩
        meshClosedSquare (c k.succ) (ρ k.succ)).Nonempty ∧
      ρ k.castSucc / 2 ≤ ρ k.succ ∧ ρ k.succ ≤ 2 * ρ k.castSucc) ∧
    (∑ k : Fin (m + 1), ρ k) ≤ 512 * (M_w : ℝ) * ((L_max - L_min : ℕ) : ℝ)

def DyadicBadLatChain (x_left : ℝ) (M_w L_min L_max : ℕ)
    (isGoodTile : ℂ → ℝ → Prop) : Prop :=
  ∃ (r : ℕ) (x_T d_T ρ_T : Fin (r + 1) → ℝ),
    (∀ k : Fin (r + 1),
      0 < ρ_T k ∧
      1024 * ρ_T k ≤ d_T k ∧
      d_T k ≤ 2048 * ρ_T k ∧
      x_left + ρ_T k / 2 ≤ x_T k ∧
      x_T k ≤ x_left + (M_w : ℝ) / 2 - ρ_T k / 2 ∧
      ((2 : ℝ) ^ L_max)⁻¹ + ρ_T k / 2 ≤ d_T k ∧
      d_T k ≤ ((2 : ℝ) ^ L_min)⁻¹ - ρ_T k / 2 ∧
      ¬ isGoodTile ((x_T k : ℂ) - (d_T k : ℂ) * Complex.I) (ρ_T k)) ∧
    x_T 0 = x_left + ρ_T 0 / 2 ∧
    x_T (Fin.last r) = x_left + (M_w : ℝ) / 2 - ρ_T (Fin.last r) / 2 ∧
    (∀ k : Fin r,
      |x_T k.succ - x_T k.castSucc| ≤ (ρ_T k.castSucc + ρ_T k.succ) / 2 ∧
      |d_T k.succ - d_T k.castSucc| ≤ (ρ_T k.castSucc + ρ_T k.succ) / 2 ∧
      ρ_T k.castSucc / 2 ≤ ρ_T k.succ ∧ ρ_T k.succ ≤ 2 * ρ_T k.castSucc)

def EpochBandScheduleData (F : ℂ → ℂ) (lam L₀ M_lat C_small : ℝ) : Prop :=
  ∃ (u ε_seq M_top : ℕ → ℝ) (L_a L_b : ℕ → ℕ),
    (∀ j : ℕ, 1 ≤ u j ∧ u j + 1 ≤ u (j + 1)) ∧
    Filter.Tendsto u Filter.atTop Filter.atTop ∧
    (∀ j : ℕ, 0 < ε_seq j ∧ ε_seq j ≤ C_small) ∧
    Antitone ε_seq ∧
    Filter.Tendsto ε_seq Filter.atTop (nhds 0) ∧
    (∀ j : ℕ, 1 / C_small ≤ ε_seq j * u j) ∧
    (∀ j : ℕ, 10 ≤ L_b j ∧ L_b j + 4 ≤ L_a j ∧ L_a j + 4 ≤ L_b (j + 1)) ∧
    (∀ j : ℕ, ((L_a (j + 2) + 3 - (L_b j - 3) : ℕ) : ℝ) ≤ ε_seq j * u j) ∧
    (∀ j : ℕ, lam * u j ≤ M_top j ∧ M_top j ≤ lam * u j + C_small * (ε_seq j * u j)) ∧
    (∀ j : ℕ, ∀ z : ℂ,
      |z.re| ≤ 5 →
      ((2 : ℝ) ^ (L_a (j + 2) + 6))⁻¹ ≤ -z.im →
      -z.im ≤ 16 * ((2 : ℝ) ^ L_b j)⁻¹ →
      ‖F z‖ ≤ Real.exp (M_top j)) ∧
    (∀ j : ℕ, ∀ x₀ : ℝ, |x₀| ≤ 3 →
      ∃ p δ_w : ℝ,
        16 * ((2 : ℝ) ^ L_a j)⁻¹ < δ_w ∧
        δ_w < ((2 : ℝ) ^ L_b j)⁻¹ / 16 ∧
        |p - x₀| ≤ L₀ * δ_w ∧
        (L₀ + M_lat) * δ_w ≤ 1 ∧
        Real.exp (M_top j - C_small * (ε_seq j * u j)) ≤
          ‖F ((p : ℂ) - (δ_w : ℂ) * Complex.I)‖ ∧
        (∀ z : ℂ, |z.re - p| ≤ M_lat * δ_w →
          ((2 : ℝ) ^ (L_a j + 3))⁻¹ ≤ -z.im → -z.im ≤ 2 * δ_w →
          ‖F z‖ ≤ Real.exp (M_top j))) ∧
    (∀ j : ℕ, ∀ x₀ : ℝ, |x₀| ≤ 3 →
      ∃ p δ_w : ℝ,
        16 * ((2 : ℝ) ^ (L_b j - 3))⁻¹ < δ_w ∧
        |p - x₀| ≤ L₀ * δ_w ∧
        (L₀ + M_lat + 2) * δ_w ≤ 1 / 8 ∧
        Real.exp (M_top j - C_small * (ε_seq j * u j)) ≤
          ‖F ((p : ℂ) - (δ_w : ℂ) * Complex.I)‖ ∧
        (∀ z : ℂ, |z.re - p| ≤ M_lat * δ_w →
          ((2 : ℝ) ^ (L_a (j + 2) + 6))⁻¹ ≤ -z.im → -z.im ≤ 2 * δ_w →
          ‖F z‖ ≤ Real.exp (M_top j)))
def dualGridTurnRight (d : Fin 4) : Fin 4 :=
  ⟨(d.val + 1) % 4, Nat.mod_lt _ (Nat.zero_lt_succ 3)⟩

def dualGridTurnLeft (d : Fin 4) : Fin 4 :=
  ⟨(d.val + 3) % 4, Nat.mod_lt _ (Nat.zero_lt_succ 3)⟩

def dualGridStartPt (e : ℤ × ℤ × Fin 4) : ℤ × ℤ :=
  (e.1, e.2.1)

def dualGridEndPt (e : ℤ × ℤ × Fin 4) : ℤ × ℤ :=
  match e.2.2.val with
  | 0 => (e.1, e.2.1 + 1)
  | 1 => (e.1 + 1, e.2.1)
  | 2 => (e.1, e.2.1 - 1)
  | _ => (e.1 - 1, e.2.1)

def dualGridLeftCell (e : ℤ × ℤ × Fin 4) : ℤ × ℤ :=
  match e.2.2.val with
  | 0 => (e.1 - 1, e.2.1)
  | 1 => (e.1, e.2.1)
  | 2 => (e.1, e.2.1 - 1)
  | _ => (e.1 - 1, e.2.1 - 1)

def dualGridRightCell (e : ℤ × ℤ × Fin 4) : ℤ × ℤ :=
  match e.2.2.val with
  | 0 => (e.1, e.2.1)
  | 1 => (e.1, e.2.1 - 1)
  | 2 => (e.1 - 1, e.2.1 - 1)
  | _ => (e.1 - 1, e.2.1)

def dualGridInEdge (vx vy : ℤ) (d : Fin 4) : ℤ × ℤ × Fin 4 :=
  match d.val with
  | 0 => (vx, vy - 1, d)
  | 1 => (vx - 1, vy, d)
  | 2 => (vx, vy + 1, d)
  | _ => (vx + 1, vy, d)

def dualGridIsBoundary (inMark : ℤ × ℤ → Bool) (e : ℤ × ℤ × Fin 4) : Bool :=
  inMark (dualGridLeftCell e) && !inMark (dualGridRightCell e)

def dualGridNextEdge (inMark : ℤ × ℤ → Bool) (e : ℤ × ℤ × Fin 4) : ℤ × ℤ × Fin 4 :=
  let v := dualGridEndPt e
  let eR : ℤ × ℤ × Fin 4 := (v.1, v.2, dualGridTurnRight e.2.2)
  let eS : ℤ × ℤ × Fin 4 := (v.1, v.2, e.2.2)
  let eL : ℤ × ℤ × Fin 4 := (v.1, v.2, dualGridTurnLeft e.2.2)
  if dualGridIsBoundary inMark eR then eR
  else if dualGridIsBoundary inMark eS then eS
  else eL

def dualGridPrevEdge (inMark : ℤ × ℤ → Bool) (e : ℤ × ℤ × Fin 4) : ℤ × ℤ × Fin 4 :=
  let e1 := dualGridInEdge e.1 e.2.1 (dualGridTurnLeft e.2.2)
  let e2 := dualGridInEdge e.1 e.2.1 e.2.2
  let e3 := dualGridInEdge e.1 e.2.1 (dualGridTurnRight e.2.2)
  if dualGridIsBoundary inMark e1 then e1
  else if dualGridIsBoundary inMark e2 then e2
  else e3

def dualGridInBox (W H : ℕ) (e : ℤ × ℤ × Fin 4) : Bool :=
  match e.2.2.val with
  | 0 => decide (0 ≤ e.1 ∧ e.1 < (W : ℤ) ∧ 0 ≤ e.2.1 ∧ e.2.1 < (H : ℤ))
  | 1 => decide (0 ≤ e.1 ∧ e.1 + 1 < (W : ℤ) ∧ 1 ≤ e.2.1 ∧ e.2.1 < (H : ℤ))
  | 2 => decide (0 ≤ e.1 ∧ e.1 < (W : ℤ) ∧ 1 ≤ e.2.1 ∧ e.2.1 ≤ (H : ℤ))
  | _ => decide (1 ≤ e.1 ∧ e.1 < (W : ℤ) ∧ 1 ≤ e.2.1 ∧ e.2.1 < (H : ℤ))

def dualGridActiveFinset (W H : ℕ) (inMark : ℤ × ℤ → Bool) : Finset (ℤ × ℤ × Fin 4) :=
  (Finset.Ico (0 : ℤ) (W : ℤ) ×ˢ (Finset.Icc (0 : ℤ) (H : ℤ) ×ˢ
    (Finset.univ : Finset (Fin 4)))).filter
      (fun e => dualGridInBox W H e && dualGridIsBoundary inMark e)

def dualGridToFinCell (W H : ℕ) (hW : 1 ≤ W) (hH : 1 ≤ H) (c : ℤ × ℤ) : Fin W × Fin H :=
  (if hx : c.1.toNat < W then ⟨c.1.toNat, hx⟩ else ⟨0, Nat.lt_of_lt_of_le Nat.zero_lt_one hW⟩,
   if hy : c.2.toNat < H then ⟨c.2.toNat, hy⟩ else ⟨0, Nat.lt_of_lt_of_le Nat.zero_lt_one hH⟩)

def dualGridWalkFrom {α : Type} (step : α → α) (isStop : α → Bool) : ℕ → α → List α
  | 0, x => [x]
  | n + 1, x => if isStop x then [x] else x :: dualGridWalkFrom step isStop n (step x)
noncomputable def ldtTruncDeficit (S : FiniteWallNonisotropicStrip)
    (K : ℝ) (m : ℕ) (z : ℂ) : ℝ :=
  K - Real.log (max ‖S.f z‖ ((1 / 2 : ℝ) ^ m))

structure LdtTruncPotentialToolkit (S : FiniteWallNonisotropicStrip) : Prop where
  cont_on : ∀ (K : ℝ) (m : ℕ),
    ContinuousOn (ldtTruncDeficit S K m) (horizStrip S.H)
  periodic : ∀ (K : ℝ) (m : ℕ), ∀ z ∈ horizStrip S.H,
    ldtTruncDeficit S K m (z + 2 * Real.pi) = ldtTruncDeficit S K m z
  conj_symm : ∀ (K : ℝ) (m : ℕ), ∀ z ∈ horizStrip S.H,
    ldtTruncDeficit S K m (starRingEnd ℂ z) = ldtTruncDeficit S K m z
  nonneg_of_norm_le : ∀ (K : ℝ) (m : ℕ) (z : ℂ),
    0 ≤ K → ‖S.f z‖ ≤ Real.exp K → 0 ≤ ldtTruncDeficit S K m z
  le_of_exp_sub_le : ∀ (K D : ℝ) (m : ℕ) (z : ℂ),
    Real.exp (K - D) ≤ ‖S.f z‖ → ldtTruncDeficit S K m z ≤ D
  monotone_trunc : ∀ (K : ℝ) (z : ℂ),
    Monotone (fun m : ℕ => ldtTruncDeficit S K m z)
  ofReal_deficit_le_iSup_trunc : ∀ (K : ℝ) (z : ℂ),
    ENNReal.ofReal (K - Real.log ‖S.f z‖) ≤
      ⨆ m : ℕ, ENNReal.ofReal (ldtTruncDeficit S K m z)
  circle_supermean : ∀ (K : ℝ) (m : ℕ) (z₀ : ℂ) (r : ℝ),
    0 < r → Metric.closedBall z₀ r ⊆ horizStrip S.H →
    Real.circleAverage (ldtTruncDeficit S K m) z₀ r ≤ ldtTruncDeficit S K m z₀
  ball_supermean : ∀ (K : ℝ) (m : ℕ) (z₀ : ℂ) (R : ℝ),
    0 < R → Metric.closedBall z₀ R ⊆ horizStrip S.H →
    (Real.pi * R ^ 2)⁻¹ * (∫ w in Metric.ball z₀ R, ldtTruncDeficit S K m w) ≤
      ldtTruncDeficit S K m z₀
  ball_deficit_le_of_trunc_le : ∀ (K B : ℝ) (z₀ : ℂ) (Δ : ℝ),
    0 ≤ K → 0 ≤ B → 0 < Δ →
    Metric.closedBall z₀ Δ ⊆ horizStrip S.H →
    (∀ z ∈ Metric.closedBall z₀ Δ, ‖S.f z‖ ≤ Real.exp K) →
    MeasureTheory.IntegrableOn (fun w : ℂ => K - Real.log ‖S.f w‖)
      (Metric.ball z₀ Δ) MeasureTheory.volume →
    (∀ m : ℕ, (∫ w in Metric.ball z₀ Δ, ldtTruncDeficit S K m w) ≤ B) →
    (∫ w in Metric.ball z₀ Δ, (K - Real.log ‖S.f w‖)) ≤ B
  slab_max_principle : ∀ (a b : ℝ) (Φ : ℂ → ℝ),
    a < b →
    ContinuousOn Φ { z : ℂ | a ≤ z.im ∧ z.im ≤ b } →
    (∀ z : ℂ, a ≤ z.im → z.im ≤ b → Φ (z + 2 * Real.pi) = Φ z) →
    (∀ x : ℝ, Φ ((x : ℂ) + (a : ℂ) * Complex.I) ≤ 0 ∧
      Φ ((x : ℂ) + (b : ℂ) * Complex.I) ≤ 0) →
    (∀ z₀ : ℂ, a < z₀.im → z₀.im < b →
      ∃ r₀ : ℝ, 0 < r₀ ∧ ∀ r : ℝ, 0 < r → r < r₀ →
        Φ z₀ ≤ Real.circleAverage Φ z₀ r) →
    ∀ z : ℂ, a ≤ z.im → z.im ≤ b → Φ z ≤ 0

structure LdtRowAndMomentData (S : FiniteWallNonisotropicStrip) : Prop where
  row_mean_bound : ∃ C_row : ℝ, 0 < C_row ∧
    ∀ (K y : ℝ) (m : ℕ), |y| < S.H →
      (2 * Real.pi)⁻¹ * (∫ x in (0 : ℝ)..(2 * Real.pi),
        ldtTruncDeficit S K m ((x : ℂ) + (y : ℂ) * Complex.I)) ≤ K + C_row
  weighted_shifted_balls_bound :
    ∀ (F ρ : ℝ → ℝ) (centers : Finset ℂ) (Δ K C₀ B_row : ℝ),
      Continuous F → Continuous ρ →
      (∀ x : ℝ, 0 ≤ F x) → (∀ x : ℝ, 0 ≤ ρ x) →
      0 < Δ → 0 ≤ K → 0 ≤ C₀ → 0 ≤ B_row →
      (∀ c ∈ centers, ∀ x ∈ Set.Icc (0 : ℝ) (2 * Real.pi),
        Metric.closedBall ((x : ℂ) + c) Δ ⊆ horizStrip S.H) →
      (∀ c ∈ centers, ∀ x ∈ Set.Icc (0 : ℝ) (2 * Real.pi),
        ∀ z ∈ Metric.closedBall ((x : ℂ) + c) Δ, ‖S.f z‖ ≤ Real.exp K) →
      (∀ c ∈ centers, ∀ x ∈ Set.Icc (0 : ℝ) (2 * Real.pi),
        MeasureTheory.IntegrableOn (fun w : ℂ => K - Real.log ‖S.f w‖)
          (Metric.ball ((x : ℂ) + c) Δ) MeasureTheory.volume) →
      (∀ x ∈ Set.Icc (0 : ℝ) (2 * Real.pi),
        F x ≤ C₀ * ∑ c ∈ centers,
          (1 + (Real.pi * Δ ^ 2)⁻¹ *
            ∫ w in Metric.ball ((x : ℂ) + c) Δ, (K - Real.log ‖S.f w‖))) →
      (∀ (m : ℕ), ∀ c ∈ centers, ∀ u ∈ Metric.ball (0 : ℂ) Δ,
        (2 * Real.pi)⁻¹ * (∫ x in (0 : ℝ)..(2 * Real.pi),
          ldtTruncDeficit S K m ((x : ℂ) + c + u) * ρ x) ≤ B_row) →
      (2 * Real.pi)⁻¹ * (∫ x in (0 : ℝ)..(2 * Real.pi), F x * ρ x) ≤
        C₀ * (centers.card : ℝ) *
          ((2 * Real.pi)⁻¹ * (∫ x in (0 : ℝ)..(2 * Real.pi), ρ x) + B_row)
  sqrt_q_first_moment :
    ∃ C_q : ℝ, 0 < C_q ∧
      ∀ k : ℝ, criticalDepthThreshold S ≤ k →
        Real.exp (-k) * ((2 * Real.pi)⁻¹ *
          ∫ x in (0 : ℝ)..(2 * Real.pi),
            Real.sqrt ‖S.q ((x : ℂ) + ((S.H - Real.exp (-k) : ℝ) : ℂ) * Complex.I)‖) ≤
          C_q * (1 + k)
noncomputable def mpwcPolyIntegral (f : ℂ → ℂ) : List ℂ → ℂ
  | [] => 0
  | [_] => 0
  | a :: b :: rest =>
      (∫ t in (0 : ℝ)..(1 : ℝ), (b - a) * f ((1 - t) • a + t • b)) +
        mpwcPolyIntegral f (b :: rest)

open Classical in
noncomputable def mpwcPolyPrefixTo :
    (L : List ℂ) → L ≠ [] → (p : ℂ) → p ∈ meshPolyTrace L → List ℂ
  | [], hL, _, _ => absurd rfl hL
  | [_], _, p, _ => [p]
  | a :: b :: rest, _, p, hp =>
      if hseg : p ∈ segment ℝ a b then [a, p]
      else a :: mpwcPolyPrefixTo (b :: rest) (List.cons_ne_nil b rest) p (hp.resolve_left hseg)
def sliceRegClosedComp (S : FiniteWallNonisotropicStrip) (P : OddPeriodicSliceData S) : Set ℂ :=
  (horizStrip (sliceHeight S P.N) \ P.Z_all)ᶜ

noncomputable def sliceSingDist (S : FiniteWallNonisotropicStrip) (P : OddPeriodicSliceData S)
    (y : ℂ) : ℝ :=
  Metric.infDist y (sliceRegClosedComp S P)

noncomputable def sliceSafeBallRad (S : FiniteWallNonisotropicStrip) (P : OddPeriodicSliceData S)
    (y : ℂ) : ℝ :=
  (1 / 4 : ℝ) * min 1 (sliceSingDist S P y)

noncomputable def sliceLocalSupTerm (S : FiniteWallNonisotropicStrip)
    (P : OddPeriodicSliceData S) (k : Fin P.N) (ζ : ℂ) : ℝ :=
  ‖sliceSpeedSeq S P.N k.val ζ‖ ^ 6 +
    (‖sliceSpeedSeq S P.N k.val ζ‖ ^ 6)⁻¹ +
    Real.exp (6 * |(sliceAngleSeq S P.N k.val ζ).im|) +
    ‖Complex.sin (P.d0 k ζ)‖ ^ 6 +
    (‖Complex.sin (P.d0 k ζ)‖ ^ 6)⁻¹ +
    ‖P.ℓ_slice k ζ‖ ^ 6 +
    (‖P.ℓ_slice k ζ‖ ^ 6)⁻¹

noncomputable def sliceLocalSupDenom (S : FiniteWallNonisotropicStrip)
    (P : OddPeriodicSliceData S) (y : ℂ) : ℝ :=
  1 + ∑ k : Fin P.N,
    sSup ((fun u : ℂ => sliceLocalSupTerm S P k (y + (sliceSafeBallRad S P y : ℂ) * u)) ''
      Metric.closedBall (0 : ℂ) 1)

noncomputable def adaptiveStepRadius (S : FiniteWallNonisotropicStrip)
    (P : OddPeriodicSliceData S) (L : ℝ) (y : ℂ) : ℝ :=
  (Real.exp (-4 * (max L 2) ^ 7) / (10000 * (1 + S.H + S.c) ^ 3)) *
    ((min 1 (sliceSingDist S P y)) ^ 4 / sliceLocalSupDenom S P y)

structure IsScaleAdmissibleStep (S : FiniteWallNonisotropicStrip)
    (P : OddPeriodicSliceData S) (M : ℝ) (ρ : ℂ → ℝ) : Prop where
  scale_ge_two : 2 ≤ M
  measurable : Measurable ρ
  periodic : ∀ y : ℂ, ρ (y + 2 * Real.pi) = ρ y
  cont_on : ContinuousOn ρ (horizStrip (sliceHeight S P.N) \ P.Z_all)
  nonneg : ∀ y : ℂ, 0 ≤ ρ y
  pos_iff : ∀ y : ℂ, 0 < ρ y ↔ y ∈ horizStrip (sliceHeight S P.N) \ P.Z_all
  le_sing_dist : ∀ y : ℂ, ρ y ≤ (1 / 100 : ℝ) * min 1 (sliceSingDist S P y)
  small_shape_step : ∀ y ∈ horizStrip (sliceHeight S P.N) \ P.Z_all,
    ∀ z : ℂ, ‖z‖ ≤ ρ y → ∀ j : Fin P.N,
      ‖sliceImpactSeq S P.N j.val (y + z) - sliceImpactSeq S P.N j.val y‖ ≤
        Real.exp (-M ^ 2) * sliceShapeDepth S P j y
  jump_log_speed : ∀ y ∈ horizStrip (sliceHeight S P.N) \ P.Z_all,
    ∀ z : ℂ, ‖z‖ ≤ ρ y → ∀ j : Fin P.N,
      |Real.log ‖sliceSpeedSeq S P.N j.val (y + z)‖ -
        Real.log ‖sliceSpeedSeq S P.N j.val y‖| ≤ 1
  jump_log_sin_d0 : ∀ y ∈ horizStrip (sliceHeight S P.N) \ P.Z_all,
    ∀ z : ℂ, ‖z‖ ≤ ρ y → ∀ j : Fin P.N,
      |Real.log ‖Complex.sin (P.d0 j (y + z))‖ -
        Real.log ‖Complex.sin (P.d0 j y)‖| ≤ 1
  jump_log_chord : ∀ y ∈ horizStrip (sliceHeight S P.N) \ P.Z_all,
    ∀ z : ℂ, ‖z‖ ≤ ρ y → ∀ j : Fin P.N,
      |Real.log ‖P.ℓ_slice j (y + z)‖ - Real.log ‖P.ℓ_slice j y‖| ≤ 1
  jump_angle : ∀ y ∈ horizStrip (sliceHeight S P.N) \ P.Z_all,
    ∀ z : ℂ, ‖z‖ ≤ ρ y → ∀ j : Fin P.N,
      ‖sliceAngleSeq S P.N j.val (y + z) - sliceAngleSeq S P.N j.val y‖ ≤ 1
  jump_pos : ∀ y ∈ horizStrip (sliceHeight S P.N) \ P.Z_all,
    ∀ z : ℂ, ‖z‖ ≤ ρ y → ∀ j : Fin P.N,
      ‖slicePosSeq S P.N j.val (y + z) - slicePosSeq S P.N j.val y‖ ≤ 1
  taylor_impact : ∀ y ∈ horizStrip (sliceHeight S P.N) \ P.Z_all,
    ∀ z : ℂ, ‖z‖ ≤ ρ y → ∀ j : Fin P.N,
      ‖sliceImpactSeq S P.N j.val (y + z) - sliceImpactSeq S P.N j.val y -
          deriv (sliceImpactSeq S P.N j.val) y * z‖ ≤
        (1 / 2 : ℝ) * Real.exp (-M ^ 3) * ρ y
  taylor_angle : ∀ y ∈ horizStrip (sliceHeight S P.N) \ P.Z_all,
    ∀ z : ℂ, ‖z‖ ≤ ρ y → ∀ j : Fin P.N,
      ‖sliceAngleSeq S P.N j.val (y + z) - sliceAngleSeq S P.N j.val y -
          deriv (sliceAngleSeq S P.N j.val) y * z‖ ≤
        (1 / 2 : ℝ) * Real.exp (-M ^ 3) * ρ y
  taylor_pos₀ : ∀ y ∈ horizStrip (sliceHeight S P.N) \ P.Z_all,
    ∀ z : ℂ, ‖z‖ ≤ ρ y → ∀ j : Fin P.N,
      ‖slicePosSeq S P.N j.val (y + z) 0 - slicePosSeq S P.N j.val y 0 -
          deriv (fun w => slicePosSeq S P.N j.val w 0) y * z‖ ≤
        (1 / 4 : ℝ) * Real.exp (-M ^ 3) * ρ y
  taylor_pos₁ : ∀ y ∈ horizStrip (sliceHeight S P.N) \ P.Z_all,
    ∀ z : ℂ, ‖z‖ ≤ ρ y → ∀ j : Fin P.N,
      ‖slicePosSeq S P.N j.val (y + z) 1 - slicePosSeq S P.N j.val y 1 -
          deriv (fun w => slicePosSeq S P.N j.val w 1) y * z‖ ≤
        (1 / 4 : ℝ) * Real.exp (-M ^ 3) * ρ y
  taylor_support : ∀ y ∈ horizStrip (sliceHeight S P.N) \ P.Z_all,
    ∀ z : ℂ, ‖z‖ ≤ ρ y → ∀ j : Fin P.N,
      ‖sliceSupportSeq S P.N j.val (y + z) - sliceSupportSeq S P.N j.val y -
          deriv (sliceSupportSeq S P.N j.val) y * z‖ ≤
        (1 / 2 : ℝ) * (1 + ‖slicePosSeq S P.N j.val y‖) * Real.exp (-M ^ 3) * ρ y

structure WalkBaseAndStopProp (S : FiniteWallNonisotropicStrip)
    (P : OddPeriodicSliceData S) (C_clk : ℝ) : Prop where
  C_clk_pos : 0 < C_clk
  walk_in_reg : ∀ M : ℝ, ∀ ρ : ℂ → ℝ, IsScaleAdmissibleStep S P M ρ →
    ∀ om : WalkSpace, ∀ m : ℕ,
      walkPos ρ om m ∈ horizStrip (sliceHeight S P.N) \ P.Z_all ∧
      0 < ρ (walkPos ρ om m)
  walk_stops : ∀ M : ℝ, ∀ ρ : ℂ → ℝ, IsScaleAdmissibleStep S P M ρ →
    ∀ᵐ om : WalkSpace ∂walkMeasure,
      ∃ m : ℕ, M ≤ Finset.univ.sup' Finset.univ_nonempty
        (fun j => sliceHistory S P ρ om j m)
  walk_clock : ∀ M : ℝ, ∀ ρ : ℂ → ℝ, IsScaleAdmissibleStep S P M ρ →
    MeasureTheory.Integrable
      (fun om : WalkSpace => ∑ m ∈ Finset.range (sliceStopTau S P ρ M om),
        (ρ (walkPos ρ om m)) ^ 2) walkMeasure ∧
    (∫ om, (∑ m ∈ Finset.range (sliceStopTau S P ρ M om),
      (ρ (walkPos ρ om m)) ^ 2) ∂walkMeasure) ≤ C_clk
  impact_sq_sum : ∀ M : ℝ, ∀ ρ : ℂ → ℝ, IsScaleAdmissibleStep S P M ρ →
    ∀ j : Fin P.N,
      MeasureTheory.Integrable
        (fun om : WalkSpace => ∑ m ∈ Finset.range (sliceStopTau S P ρ M om),
          ‖sliceImpactSeq S P.N j.val (walkPos ρ om (m + 1)) -
            sliceImpactSeq S P.N j.val (walkPos ρ om m)‖ ^ 2) walkMeasure ∧
      (∫ om, (∑ m ∈ Finset.range (sliceStopTau S P ρ M om),
        ‖sliceImpactSeq S P.N j.val (walkPos ρ om (m + 1)) -
          sliceImpactSeq S P.N j.val (walkPos ρ om m)‖ ^ 2) ∂walkMeasure) ≤ 2 * S.H ^ 2

def SliceRetreatBoundProp (S : FiniteWallNonisotropicStrip)
    (P : OddPeriodicSliceData S) : Prop :=
  ∀ δ : ℝ, 0 < δ →
    ∃ M_ret : ℝ, 2 ≤ M_ret ∧
      ∀ M : ℝ, M_ret ≤ M →
        ∀ ρ : ℂ → ℝ, IsScaleAdmissibleStep S P M ρ →
          walkMeasure.real {om : WalkSpace |
            ∃ m ≤ sliceStopTau S P ρ M om, ∃ j : Fin P.N,
              sliceLogDepth S P j (walkPos ρ om m) <
                sliceHistory S P ρ om j m - 4 * Real.log M} ≤ δ

structure AdmissibleHittingAndClockProp (S : FiniteWallNonisotropicStrip)
    (P : OddPeriodicSliceData S) (C_hit C_rem : ℝ) : Prop where
  C_hit_pos : 0 < C_hit
  C_rem_pos : 0 < C_rem
  first_hit_dom : ∀ M d r_int : ℝ, ∀ ρ : ℂ → ℝ, ∀ j : Fin P.N, ∀ E : Set ℝ,
    IsScaleAdmissibleStep S P M ρ →
    0 < d → d < S.H / 4 →
    100 * Real.exp (-M ^ 2) * d ≤ r_int →
    MeasurableSet E → (∀ x : ℝ, x ∈ E ↔ x + 2 * Real.pi ∈ E) →
    walkMeasure.real {om : WalkSpace |
      (∃ m ≤ sliceStopTau S P ρ M om,
        sliceShapeDepth S P j (walkPos ρ om m) ≤ d) ∧
      Set.Ioo
        ((sliceImpactSeq S P.N j.val
          (walkPos ρ om (sliceFirstHit S P ρ M d j om))).re - r_int)
        ((sliceImpactSeq S P.N j.val
          (walkPos ρ om (sliceFirstHit S P ρ M d j om))).re + r_int) ⊆
        E} ≤
    C_hit * MeasureTheory.volume.real (E ∩ Set.Icc (0 : ℝ) (2 * Real.pi))
  rem_clock_tail : ∀ M d B : ℝ, ∀ ρ : ℂ → ℝ, ∀ j : Fin P.N,
    IsScaleAdmissibleStep S P M ρ →
    0 < d → d < S.H / 4 → 1 ≤ B → d * Real.exp (B / 4) < S.H / 4 →
    walkMeasure.real {om : WalkSpace |
      d ^ 2 * Real.exp B <
        ∑ m ∈ Finset.Ico (sliceFirstHit S P ρ M d j om)
            (sliceStopTau S P ρ M om),
          ‖deriv (sliceImpactSeq S P.N j.val) (walkPos ρ om m)‖ ^ 2 *
            (ρ (walkPos ρ om m)) ^ 2} ≤
    C_rem * Real.exp (-B / 4)
  stopped_disp : ∀ M d r_exit q_K : ℝ, ∀ ρ : ℂ → ℝ,
    ∀ (J : Finset (Fin P.N)) (hJ : J.Nonempty) (i : Fin P.N),
    IsScaleAdmissibleStep S P M ρ →
    i ∈ J → 0 < d → d < S.H / 4 → 0 < r_exit → 0 < q_K →
    walkMeasure.real {om : WalkSpace |
      (∑ m ∈ Finset.Ico (sliceLastFirstHit S P ρ M d J hJ om)
          (sliceDiskExit S P ρ M d r_exit J hJ i om),
        (2 * ‖deriv (sliceImpactSeq S P.N i.val) (walkPos ρ om m)‖ ^ 2 +
          Real.exp (-2 * M ^ 3)) *
          (ρ (walkPos ρ om m)) ^ 2 ≤ q_K) ∧
      r_exit <
        ‖sliceImpactSeq S P.N i.val
            (walkPos ρ om (sliceDiskExit S P ρ M d r_exit J hJ i om)) -
          sliceImpactSeq S P.N i.val
            (walkPos ρ om (sliceLastFirstHit S P ρ M d J hJ om))‖} ≤
    2 * q_K / r_exit ^ 2

def StoppedLogDeficitProp (S : FiniteWallNonisotropicStrip)
    (P : OddPeriodicSliceData S) : Prop :=
  ∀ g : ℂ → ℂ,
    DifferentiableOn ℂ g (horizStrip (sliceHeight S P.N) \ P.Z_all) →
    (∀ y ∈ horizStrip (sliceHeight S P.N) \ P.Z_all, g y ≠ 0) →
    (∃ C₀ : ℝ, 0 ≤ C₀ ∧ ∀ x ∈ Set.Icc (0 : ℝ) (2 * Real.pi),
      -C₀ ≤ Real.log ‖g x‖ ∧ Real.log ‖g x‖ ≤ C₀) →
    ∃ C_g : ℝ, 0 < C_g ∧
      ∀ M B₀ B₁ : ℝ, 1 ≤ B₀ → 1 ≤ B₁ →
        ∀ ρ : ℂ → ℝ, IsScaleAdmissibleStep S P M ρ →
          (∀ y ∈ horizStrip (sliceHeight S P.N) \ P.Z_all, ∀ z : ℂ, ‖z‖ ≤ ρ y →
            |Real.log ‖g (y + z)‖ - Real.log ‖g y‖| ≤ 1) →
          walkMeasure.real {om : WalkSpace |
            ∃ m ≤ sliceStopTau S P ρ M om,
              (∀ l < m, Real.log ‖g (walkPos ρ om l)‖ ≤ B₀) ∧
              Real.log ‖g (walkPos ρ om m)‖ < -B₁} ≤
            C_g * (1 + B₀) / (1 + B₁)

structure AdmissibleModifiedInverseProp (S : FiniteWallNonisotropicStrip)
    (P : OddPeriodicSliceData S) (C_inv : ℝ) : Prop where
  C_inv_pos : 0 < C_inv
  inv_bound : ∀ M U V : ℝ, ∀ ρ : ℂ → ℝ,
    IsScaleAdmissibleStep S P M ρ → 1 ≤ U → U ≤ V →
    ∀ I F : Finset (Fin P.N), I ⊂ Finset.univ → Disjoint I F →
      ∃ E_bad : Set WalkSpace, MeasurableSet E_bad ∧
        walkMeasure.real E_bad ≤ C_inv * (1 + U) / (1 + V) ∧
        ∀ om : WalkSpace, om ∉ E_bad →
          ∀ m ≤ sliceStopTau S P ρ M om,
            (∀ n ≤ m, sliceGeomCost S P (walkPos ρ om n) ≤ U) →
            (∀ i ∈ I, sliceHistory S P ρ om i m ≤ U) →
            ∃ B_inv : Matrix (Fin P.N) (Fin P.N) ℂ,
              P.B_mat I F (walkPos ρ om m) * B_inv = 1 ∧
              B_inv * P.B_mat I F (walkPos ρ om m) = 1 ∧
              ∀ r c : Fin P.N, ‖B_inv r c‖ ≤ Real.exp (C_inv * V)

def HasUniformPowerGeometry (S : FiniteWallNonisotropicStrip)
    (P : OddPeriodicSliceData S) (σ : ℝ) : Prop :=
  ∃ A_cap : ℝ, 1 ≤ A_cap ∧
    ∀ δ : ℝ, 0 < δ →
      ∃ M₀ : ℝ, 2 ≤ M₀ ∧
        ∀ M M_cap : ℝ, M₀ ≤ M → A_cap * M ≤ M_cap →
          ∀ ρ : ℂ → ℝ, IsScaleAdmissibleStep S P M_cap ρ →
            walkMeasure.real {om : WalkSpace |
              ∃ m ≤ sliceStopTau S P ρ M om,
                M ^ σ < sliceGeomCost S P (walkPos ρ om m)} ≤ δ
def dyadicDropUntil {α : Type} [DecidableEq α] (x : α) : List α → List α
  | [] => []
  | y :: ys => if y = x then y :: ys else dyadicDropUntil x ys

def dyadicParentIdx (i j : ℕ) : ℕ × ℕ × ℕ :=
  let m := Nat.log 2 (1024 + j) - 10
  (m, i / 2 ^ m, (1024 + j) / 2 ^ m - 1024)

def dyadicValidTile (M_w L_min L_max : ℕ) (t : ℕ × ℕ × ℕ) : Prop :=
  t.1 < L_max - L_min ∧ t.2.1 < M_w * 2 ^ (L_max + 9 - t.1) ∧ t.2.2 < 1024

noncomputable def dyadicTileSide (L_max : ℕ) (t : ℕ × ℕ × ℕ) : ℝ :=
  (2 : ℝ) ^ t.1 * ((2 : ℝ) ^ (L_max + 10))⁻¹

noncomputable def dyadicTileX (x_left : ℝ) (L_max : ℕ) (t : ℕ × ℕ × ℕ) : ℝ :=
  x_left + ((t.2.1 : ℝ) + 1 / 2) * dyadicTileSide L_max t

noncomputable def dyadicTileDepth (L_max : ℕ) (t : ℕ × ℕ × ℕ) : ℝ :=
  (1024 + (t.2.2 : ℝ) + 1 / 2) * dyadicTileSide L_max t

noncomputable def dyadicTileCenter (x_left : ℝ) (L_max : ℕ) (t : ℕ × ℕ × ℕ) : ℂ :=
  (dyadicTileX x_left L_max t : ℂ) - (dyadicTileDepth L_max t : ℂ) * Complex.I
noncomputable def stepOccupDensity (S : FiniteWallNonisotropicStrip)
    (ε h₀ s x v : ℝ) : ℝ :=
  if |truncLogSpeed S ε (upperRowPt S v x)| ≤ h₀ then
    ∫ u : ℝ,
      min ((truncLogSpeed S ε (upperRowPt S (v + s) (x + u)) -
        truncLogSpeed S ε (upperRowPt S v x)) ^ 2) (h₀ ^ 2) *
      stripExitKernel (S.H - Real.exp (-(v + s))) (S.H - Real.exp (-v)) u
  else 0
def dtpcChainSpace : ℕ → Type
  | 0 => ℝ
  | n + 1 => dtpcChainSpace n × ℝ

instance dtpcInstMeasurableChainSpace : ∀ n : ℕ, MeasurableSpace (dtpcChainSpace n)
  | 0 => Real.measurableSpace
  | n + 1 => @Prod.instMeasurableSpace (dtpcChainSpace n) ℝ
      (dtpcInstMeasurableChainSpace n) Real.measurableSpace

noncomputable def dtpcStepMeasure (κ : ℕ → ℝ → ℝ) (m : ℕ) : MeasureTheory.Measure ℝ :=
  MeasureTheory.volume.withDensity (fun u : ℝ => ENNReal.ofReal (κ m u))

noncomputable def dtpcChainMeasure (κ : ℕ → ℝ → ℝ) :
    (n : ℕ) → MeasureTheory.Measure (dtpcChainSpace n)
  | 0 =>
      ENNReal.ofReal (2 * Real.pi)⁻¹ •
        MeasureTheory.volume.restrict (Set.Ioc (0 : ℝ) (2 * Real.pi))
  | n + 1 =>
      (dtpcChainMeasure κ n).prod (dtpcStepMeasure κ n)

def dtpcChainPath : ∀ (n : ℕ), dtpcChainSpace n → (ℕ → ℝ)
  | 0, x₀, _ => x₀
  | n + 1, p, k =>
      if k ≤ n then dtpcChainPath n p.1 k else dtpcChainPath n p.1 n + p.2

def dtpcStepExtend (m : ℕ) (w : ℕ → ℝ) (u : ℝ) : ℕ → ℝ :=
  fun k => if k ≤ m then w k else w m + u

def dtpcDependsUpTo (r : ℕ) (Φ : (ℕ → ℝ) → ℝ) : Prop :=
  ∀ w₁ w₂ : ℕ → ℝ, (∀ k ≤ r, w₁ k = w₂ k) → Φ w₁ = Φ w₂

noncomputable def dtpcStopX (R : ℝ) (g : ℕ → ℝ → ℝ) : ℕ → (ℕ → ℝ) → ℝ
  | 0, w => g 0 (w 0)
  | m + 1, w =>
      if ∀ k ∈ Finset.range (m + 1), g k (w k) ≤ R then
        g (m + 1) (w (m + 1))
      else
        dtpcStopX R g m w
structure AdaptiveStepTopPackage (S : FiniteWallNonisotropicStrip)
    (P : OddPeriodicSliceData S) : Prop where
  cont : ∀ L : ℝ, Continuous (adaptiveStepRadius S P L)
  periodic : ∀ L : ℝ, ∀ y : ℂ,
    adaptiveStepRadius S P L (y + 2 * Real.pi) = adaptiveStepRadius S P L y
  nonneg : ∀ L : ℝ, ∀ y : ℂ, 0 ≤ adaptiveStepRadius S P L y
  pos_iff : ∀ L : ℝ, ∀ y : ℂ,
    0 < adaptiveStepRadius S P L y ↔ y ∈ horizStrip (sliceHeight S P.N) \ P.Z_all
  le_sing_dist : ∀ L : ℝ, ∀ y : ℂ,
    adaptiveStepRadius S P L y ≤ (1 / 100 : ℝ) * min 1 (sliceSingDist S P y)
  denom_ge_one : ∀ y : ℂ, 1 ≤ sliceLocalSupDenom S P y
  safe_ball_sub_and_le : ∀ y ∈ horizStrip (sliceHeight S P.N) \ P.Z_all,
    ∀ k : Fin P.N, ∀ ζ ∈ Metric.closedBall y (sliceSafeBallRad S P y),
      ζ ∈ horizStrip (sliceHeight S P.N) \ P.Z_all ∧
      sliceLocalSupTerm S P k ζ ≤ sliceLocalSupDenom S P y

noncomputable def stripPoissonKernel (h sgn t v : ℝ) : ℝ :=
  Real.cos (Real.pi * v / (2 * h)) /
    (4 * h * (Real.cosh (Real.pi * t / (2 * h)) - sgn * Real.sin (Real.pi * v / (2 * h))))

noncomputable def stripPoissonExt (h : ℝ) (ϕ_pos ϕ_neg : ℝ → ℝ) (y : ℂ) : ℝ :=
  ∫ x : ℝ, (ϕ_pos x * stripPoissonKernel h 1 (y.re - x) y.im +
    ϕ_neg x * stripPoissonKernel h (-1) (y.re - x) y.im)

structure StripPoissonToolkitProp (h : ℝ) : Prop where
  cont_on_and_bound : ∀ (ϕ_pos ϕ_neg : ℝ → ℝ) (B : ℝ),
    Measurable ϕ_pos → Measurable ϕ_neg → 0 ≤ B →
    (∀ x : ℝ, |ϕ_pos x| ≤ B) → (∀ x : ℝ, |ϕ_neg x| ≤ B) →
    ContinuousOn (stripPoissonExt h ϕ_pos ϕ_neg) (horizStrip h) ∧
    (∀ y ∈ horizStrip h, |stripPoissonExt h ϕ_pos ϕ_neg y| ≤ B) ∧
    (∀ y : ℂ, ∀ R : ℝ, Metric.closedBall y |R| ⊆ horizStrip h →
      Real.circleAverage (stripPoissonExt h ϕ_pos ϕ_neg) y R =
        stripPoissonExt h ϕ_pos ϕ_neg y)
  real_period_integral : ∀ (ϕ_pos ϕ_neg : ℝ → ℝ) (B : ℝ),
    Measurable ϕ_pos → Measurable ϕ_neg →
    Function.Periodic ϕ_pos (2 * Real.pi) → Function.Periodic ϕ_neg (2 * Real.pi) →
    0 ≤ B → (∀ x : ℝ, |ϕ_pos x| ≤ B) → (∀ x : ℝ, |ϕ_neg x| ≤ B) →
    (2 * Real.pi)⁻¹ * (∫ x in (0 : ℝ)..(2 * Real.pi),
      stripPoissonExt h ϕ_pos ϕ_neg (x : ℂ)) =
    (4 * Real.pi)⁻¹ * (∫ x in (0 : ℝ)..(2 * Real.pi), (ϕ_pos x + ϕ_neg x))
  tendsto_boundary : ∀ (ϕ_pos ϕ_neg : ℝ → ℝ),
    Continuous ϕ_pos → Continuous ϕ_neg →
    Function.Periodic ϕ_pos (2 * Real.pi) → Function.Periodic ϕ_neg (2 * Real.pi) →
    ∀ x₀ : ℝ,
      Filter.Tendsto (stripPoissonExt h ϕ_pos ϕ_neg)
        (nhdsWithin ((x₀ : ℂ) + (h : ℂ) * Complex.I) (horizStrip h))
        (nhds (ϕ_pos x₀)) ∧
      Filter.Tendsto (stripPoissonExt h ϕ_pos ϕ_neg)
        (nhdsWithin ((x₀ : ℂ) - (h : ℂ) * Complex.I) (horizStrip h))
        (nhds (ϕ_neg x₀))
  slice_l2_domination : ∀ (v : ℂ → ℝ) (v_pos v_neg : ℝ → ℝ) (B : ℝ),
    ContinuousOn v (horizStrip h) →
    (∀ y ∈ horizStrip h, v (y + 2 * Real.pi) = v y) →
    0 ≤ B → (∀ y ∈ horizStrip h, |v y| ≤ B) →
    (∀ y : ℂ, ∀ r : ℝ, 0 < r → Metric.closedBall y r ⊆ horizStrip h →
      Real.circleAverage v y r = v y) →
    Measurable v_pos → Measurable v_neg →
    Function.Periodic v_pos (2 * Real.pi) → Function.Periodic v_neg (2 * Real.pi) →
    (∀ x : ℝ, |v_pos x| ≤ B ∧ |v_neg x| ≤ B) →
    (∀ᵐ x : ℝ ∂MeasureTheory.volume,
      Filter.Tendsto
        (fun n : ℕ => v ((x : ℂ) + (((1 - 1 / ((n : ℝ) + 2)) * h : ℝ) : ℂ) * Complex.I))
        Filter.atTop (nhds (v_pos x)) ∧
      Filter.Tendsto
        (fun n : ℕ => v ((x : ℂ) - (((1 - 1 / ((n : ℝ) + 2)) * h : ℝ) : ℂ) * Complex.I))
        Filter.atTop (nhds (v_neg x))) →
    ∀ (n : ℕ), ∀ y ∈ horizStrip h,
      let h_n : ℝ := (1 - 1 / ((n : ℝ) + 2)) * h
      let ϕ_n_pos : ℝ → ℝ := fun x => v ((x : ℂ) + (h_n : ℂ) * Complex.I)
      let ϕ_n_neg : ℝ → ℝ := fun x => v ((x : ℂ) - (h_n : ℂ) * Complex.I)
      (v y - stripPoissonExt h ϕ_n_pos ϕ_n_neg y) ^ 2 ≤
        stripPoissonExt h
          (fun x => (v_pos x - ϕ_n_pos x) ^ 2)
          (fun x => (v_neg x - ϕ_n_neg x) ^ 2) y

structure AdmissibleWalkWallExitProp (S : FiniteWallNonisotropicStrip)
    (P : OddPeriodicSliceData S) (M : ℝ) (ρ : ℂ → ℝ) : Prop where
  walk_in_reg : ∀ om : WalkSpace, ∀ m : ℕ,
    walkPos ρ om m ∈ horizStrip (sliceHeight S P.N) \ P.Z_all ∧
    0 < ρ (walkPos ρ om m)
  walk_clock :
    MeasureTheory.Integrable
      (fun om : WalkSpace => ∑ m ∈ Finset.range (sliceStopTau S P ρ M om),
        (ρ (walkPos ρ om m)) ^ 2) walkMeasure ∧
    (∫ om, (∑ m ∈ Finset.range (sliceStopTau S P ρ M om),
      (ρ (walkPos ρ om m)) ^ 2) ∂walkMeasure) ≤ 2 * (sliceHeight S P.N) ^ 2
  impact_sq_sum : ∀ j : Fin P.N,
    MeasureTheory.Integrable
      (fun om : WalkSpace => ∑ m ∈ Finset.range (sliceStopTau S P ρ M om),
        ‖sliceImpactSeq S P.N j.val (walkPos ρ om (m + 1)) -
          sliceImpactSeq S P.N j.val (walkPos ρ om m)‖ ^ 2) walkMeasure ∧
    (∫ om, (∑ m ∈ Finset.range (sliceStopTau S P ρ M om),
      ‖sliceImpactSeq S P.N j.val (walkPos ρ om (m + 1)) -
        sliceImpactSeq S P.N j.val (walkPos ρ om m)‖ ^ 2) ∂walkMeasure) ≤ 2 * S.H ^ 2
  harmonic_expectation_eq : ∀ (U : ℂ → ℝ) (B : ℝ),
    ContinuousOn U (horizStrip (sliceHeight S P.N)) →
    (∀ y ∈ horizStrip (sliceHeight S P.N), |U y| ≤ B) →
    (∀ y ∈ horizStrip (sliceHeight S P.N) \ P.Z_all,
      Real.circleAverage U y (ρ y) = U y) →
    ∀ m : ℕ,
      (∫ om, U (walkPos ρ om m) ∂walkMeasure) =
        (2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi), U (x : ℂ)
  ae_wall_exit_and_impact_im_conv :
    ∃ (x_inf sgn_inf : WalkSpace → ℝ) (v_inf : Fin P.N → WalkSpace → ℝ),
      Measurable x_inf ∧ Measurable sgn_inf ∧ (∀ j : Fin P.N, Measurable (v_inf j)) ∧
      ∀ᵐ om : WalkSpace ∂walkMeasure,
        (sgn_inf om = 1 ∨ sgn_inf om = -1) ∧
        Filter.Tendsto (fun m : ℕ => walkPos ρ om m) Filter.atTop
          (nhds ((x_inf om : ℂ) + ((sgn_inf om * sliceHeight S P.N : ℝ) : ℂ) * Complex.I)) ∧
        ∀ j : Fin P.N,
          Filter.Tendsto
            (fun m : ℕ => (sliceImpactSeq S P.N j.val (walkPos ρ om m)).im)
            Filter.atTop (nhds (v_inf j om))
noncomputable def oddSliceN (S : FiniteWallNonisotropicStrip) : ℕ :=
  2 * Nat.floor (Real.pi / S.r_star) + 3

instance oddSliceNeZero (S : FiniteWallNonisotropicStrip) : NeZero (oddSliceN S) :=
  ⟨by unfold oddSliceN; omega⟩

noncomputable def oddSliceCRec (S : FiniteWallNonisotropicStrip) : ℝ :=
  2 * (oddSliceN S : ℝ) + 3

noncomputable def holoScaledPos (S : FiniteWallNonisotropicStrip) (s : ℂ) : Fin 2 → ℂ :=
  ![S.f s * S.H0 s * Complex.cos (S.ϕ s) - deriv S.H0 s * Complex.sin (S.ϕ s),
    S.f s * S.H0 s * Complex.sin (S.ϕ s) + deriv S.H0 s * Complex.cos (S.ϕ s)]

noncomputable def oddSliceTheta (S : FiniteWallNonisotropicStrip) (j : ℤ) (y : ℂ) : ℂ :=
  (Real.pi : ℂ) +
    ∑ m ∈ Finset.range (oddSliceN S),
      (-1 : ℂ) ^ m * sliceAngleSeq S (oddSliceN S) (j - (m : ℤ)) y

noncomputable def stateShiftedAngle (S : FiniteWallNonisotropicStrip)
    (z : Fin (oddSliceN S) → ℂ) (j : Fin (oddSliceN S)) (m : ℕ) : ℂ :=
  if h : m ≤ j.val then
    S.ϕ (z ⟨j.val - m, by omega⟩)
  else
    S.ϕ (z ⟨(j.val + oddSliceN S - m) % oddSliceN S,
      Nat.mod_lt _ (by unfold oddSliceN; omega)⟩) - 2 * Real.pi

noncomputable def stateTheta (S : FiniteWallNonisotropicStrip)
    (z : Fin (oddSliceN S) → ℂ) (j : Fin (oddSliceN S)) : ℂ :=
  (Real.pi : ℂ) +
    ∑ m ∈ Finset.range (oddSliceN S), (-1 : ℂ) ^ m * stateShiftedAngle S z j m

noncomputable def stateD0 (S : FiniteWallNonisotropicStrip)
    (z : Fin (oddSliceN S) → ℂ) (j : Fin (oddSliceN S)) : ℂ :=
  stateTheta S z j - S.ϕ (z j)

noncomputable def stateChordNum (S : FiniteWallNonisotropicStrip)
    (z : Fin (oddSliceN S) → ℂ) (j : Fin (oddSliceN S)) : ℂ :=
  let j_next : Fin (oddSliceN S) := @cycNext (oddSliceN S) (oddSliceNeZero S) j;
  let K₀ : Fin 2 → ℂ := holoScaledPos S (z j);
  let K₁ : Fin 2 → ℂ := holoScaledPos S (z j_next);
  (-(S.f (z j) * K₁ 0 - S.f (z j_next) * K₀ 0)) * Complex.sin (stateTheta S z j) +
    (S.f (z j) * K₁ 1 - S.f (z j_next) * K₀ 1) * Complex.cos (stateTheta S z j)

noncomputable def oddSliceStateVec (S : FiniteWallNonisotropicStrip) (y : ℂ) :
    Fin (oddSliceN S) → ℂ :=
  fun j => sliceImpactSeq S (oddSliceN S) j.val y

noncomputable def oddSliceChordNum (S : FiniteWallNonisotropicStrip)
    (j : Fin (oddSliceN S)) (y : ℂ) : ℂ :=
  stateChordNum S (oddSliceStateVec S y) j

noncomputable def stateDeltaRow (S : FiniteWallNonisotropicStrip)
    (z : Fin (oddSliceN S) → ℂ) : ℂ :=
  (∏ m : Fin (oddSliceN S), stateChordNum S z m) *
    (∏ m : Fin (oddSliceN S), Complex.sin (stateD0 S z m))

noncomputable def stateClearedM0Entry (S : FiniteWallNonisotropicStrip)
    (z : Fin (oddSliceN S) → ℂ) (i k : Fin (oddSliceN S)) : ℂ :=
  let inst : NeZero (oddSliceN S) := oddSliceNeZero S
  let ip : Fin (oddSliceN S) := @cycPrev (oddSliceN S) inst i
  let inext : Fin (oddSliceN S) := @cycNext (oddSliceN S) inst i
  let knext : Fin (oddSliceN S) := @cycNext (oddSliceN S) inst k
  let P_sin : ℂ := ∏ m : Fin (oddSliceN S), Complex.sin (stateD0 S z m)
  let P_ell_omit : Fin (oddSliceN S) → ℂ :=
    fun r => ∏ m ∈ Finset.univ.erase r, stateChordNum S z m
  (if i = k then
      (S.f (z ip) * S.f (z i) * P_ell_omit ip +
        S.f (z i) * S.f (z inext) * P_ell_omit i) * P_sin
    else 0) +
  (if k = inext then S.f (z i) * S.f (z inext) * P_ell_omit i * P_sin else 0) +
  (if i = knext then S.f (z k) * S.f (z knext) * P_ell_omit k * P_sin else 0)

noncomputable def stateClearedVDiag (S : FiniteWallNonisotropicStrip)
    (z : Fin (oddSliceN S) → ℂ) (i : Fin (oddSliceN S)) : ℂ :=
  (2 / (S.c : ℂ)) * (S.f (z i)) ^ 3 *
    (∏ m : Fin (oddSliceN S), stateChordNum S z m) *
    (∏ m ∈ Finset.univ.erase i, Complex.sin (stateD0 S z m))

noncomputable def stateClearedB (S : FiniteWallNonisotropicStrip)
    (I F : Finset (Fin (oddSliceN S))) (z : Fin (oddSliceN S) → ℂ) :
    Matrix (Fin (oddSliceN S)) (Fin (oddSliceN S)) ℂ :=
  Matrix.of fun i k =>
    if i ∈ I ∪ F ∧ k ∈ I ∪ F then
      stateClearedM0Entry S z i k - (if i = k ∧ i ∈ I then stateClearedVDiag S z i else 0)
    else if i = k then stateDeltaRow S z else 0

def oddSliceZAll (S : FiniteWallNonisotropicStrip) : Set ℂ :=
  { y : ℂ | y ∈ horizStrip (sliceHeight S (oddSliceN S)) ∧
    ((∃ j : Fin (oddSliceN S),
        S.f (oddSliceStateVec S y j) = 0 ∨
        Complex.sin (stateD0 S (oddSliceStateVec S y) j) = 0 ∨
        stateChordNum S (oddSliceStateVec S y) j = 0) ∨
     (∃ I F : Finset (Fin (oddSliceN S)),
        I ⊂ Finset.univ ∧ Disjoint I F ∧
        (stateClearedB S I F (oddSliceStateVec S y)).det = 0)) }

structure OddSliceChordProp (S : FiniteWallNonisotropicStrip) : Prop where
  impact_holo : ∀ k : ℤ,
    DifferentiableOn ℂ (sliceImpactSeq S (oddSliceN S) k)
      (horizStrip (sliceHeight S (oddSliceN S)))
  impact_maps_to : ∀ k : ℤ, ∀ y ∈ horizStrip (sliceHeight S (oddSliceN S)),
    sliceImpactSeq S (oddSliceN S) k y ∈ horizStrip S.H
  impact_quasiperiodic : ∀ k : ℤ, ∀ y ∈ horizStrip (sliceHeight S (oddSliceN S)),
    sliceImpactSeq S (oddSliceN S) k (y + 2 * Real.pi) =
      sliceImpactSeq S (oddSliceN S) k y + 2 * Real.pi
  impact_shift_N : ∀ k : ℤ, ∀ y ∈ horizStrip (sliceHeight S (oddSliceN S)),
    sliceImpactSeq S (oddSliceN S) (k + (oddSliceN S : ℤ)) y =
      sliceImpactSeq S (oddSliceN S) k y + 2 * Real.pi
  impact_conj : ∀ k : ℤ, ∀ y ∈ horizStrip (sliceHeight S (oddSliceN S)),
    sliceImpactSeq S (oddSliceN S) k (starRingEnd ℂ y) =
      starRingEnd ℂ (sliceImpactSeq S (oddSliceN S) k y)
  holoScaledPos_holo : ∀ i : Fin 2,
    DifferentiableOn ℂ (fun s => holoScaledPos S s i) (horizStrip S.H)
  holoScaledPos_periodic : ∀ s ∈ horizStrip S.H,
    holoScaledPos S (s + 2 * Real.pi) = holoScaledPos S s
  holoScaledPos_eq : ∀ s ∈ horizStrip S.H, S.f s ≠ 0 → ∀ i : Fin 2,
    holoScaledPos S s i = S.f s * S.Γ s i
  θ_holo : ∀ j : ℤ,
    DifferentiableOn ℂ (oddSliceTheta S j) (horizStrip (sliceHeight S (oddSliceN S)))
  θ_quasiperiodic : ∀ j : ℤ, ∀ y ∈ horizStrip (sliceHeight S (oddSliceN S)),
    oddSliceTheta S j (y + 2 * Real.pi) = oddSliceTheta S j y + 2 * Real.pi
  θ_shift_N : ∀ j : ℤ, ∀ y ∈ horizStrip (sliceHeight S (oddSliceN S)),
    oddSliceTheta S (j + (oddSliceN S : ℤ)) y = oddSliceTheta S j y + 2 * Real.pi
  θ_conj : ∀ j : ℤ, ∀ y ∈ horizStrip (sliceHeight S (oddSliceN S)),
    oddSliceTheta S j (starRingEnd ℂ y) = starRingEnd ℂ (oddSliceTheta S j y)
  θ_sum : ∀ j : ℤ, ∀ y ∈ horizStrip (sliceHeight S (oddSliceN S)),
    oddSliceTheta S (j - 1) y + oddSliceTheta S j y = 2 * sliceAngleSeq S (oddSliceN S) j y
  θ_real : ∀ j : ℤ, ∀ x : ℝ,
    oddSliceTheta S j x =
      S.Θ_gl
        ((x : ℂ) + ((((j : ℝ) + 1 / 2) * sliceParamT0 (oddSliceN S) : ℝ) : ℂ),
          (sliceParamT0 (oddSliceN S) : ℂ))
  θ_eq_stateTheta : ∀ y ∈ horizStrip (sliceHeight S (oddSliceN S)),
    ∀ j : Fin (oddSliceN S),
      oddSliceTheta S j.val y = stateTheta S (oddSliceStateVec S y) j
  θ_eq_gl_strip : ∀ j : ℤ, ∀ y ∈ horizStrip S.s_star,
    oddSliceTheta S j y =
      S.Θ_gl
        (y + ((((j : ℝ) + 1 / 2) * sliceParamT0 (oddSliceN S) : ℝ) : ℂ),
          (sliceParamT0 (oddSliceN S) : ℂ))
  ℓ_num_holo : ∀ j : Fin (oddSliceN S),
    DifferentiableOn ℂ (oddSliceChordNum S j) (horizStrip (sliceHeight S (oddSliceN S)))
  ℓ_num_periodic : ∀ j : Fin (oddSliceN S), ∀ y ∈ horizStrip (sliceHeight S (oddSliceN S)),
    oddSliceChordNum S j (y + 2 * Real.pi) = oddSliceChordNum S j y
  ℓ_real : ∀ j : Fin (oddSliceN S), ∀ x : ℝ,
    oddSliceChordNum S j x /
      (sliceSpeedSeq S (oddSliceN S) j.val x *
        sliceSpeedSeq S (oddSliceN S) ((j.val : ℤ) + 1) x) =
      (S.ℓ_chord (x + (j.val : ℝ) * sliceParamT0 (oddSliceN S))
        (sliceParamT0 (oddSliceN S)) : ℂ)
  reg_chord_vec_pt : ∀ y ∈ horizStrip (sliceHeight S (oddSliceN S)),
    (∀ k : Fin (oddSliceN S), sliceSpeedSeq S (oddSliceN S) k.val y ≠ 0) →
    ∀ j : Fin (oddSliceN S),
      slicePosSeq S (oddSliceN S) ((j.val : ℤ) + 1) y 0 -
        slicePosSeq S (oddSliceN S) j.val y 0 =
        -(oddSliceChordNum S j y /
          (sliceSpeedSeq S (oddSliceN S) j.val y *
            sliceSpeedSeq S (oddSliceN S) ((j.val : ℤ) + 1) y)) *
          Complex.sin (oddSliceTheta S j.val y) ∧
      slicePosSeq S (oddSliceN S) ((j.val : ℤ) + 1) y 1 -
        slicePosSeq S (oddSliceN S) j.val y 1 =
        (oddSliceChordNum S j y /
          (sliceSpeedSeq S (oddSliceN S) j.val y *
            sliceSpeedSeq S (oddSliceN S) ((j.val : ℤ) + 1) y)) *
          Complex.cos (oddSliceTheta S j.val y)
  reg_deriv_pos_pt : ∀ y ∈ horizStrip (sliceHeight S (oddSliceN S)),
    (∀ k : Fin (oddSliceN S), sliceSpeedSeq S (oddSliceN S) k.val y ≠ 0) →
    ∀ j : Fin (oddSliceN S),
      deriv (fun z => slicePosSeq S (oddSliceN S) j.val z 0) y =
        -(S.c : ℂ) * (sliceSpeedSeq S (oddSliceN S) j.val y)⁻¹ ^ 2 *
          Complex.sin (sliceAngleSeq S (oddSliceN S) j.val y) *
          deriv (sliceImpactSeq S (oddSliceN S) j.val) y ∧
      deriv (fun z => slicePosSeq S (oddSliceN S) j.val z 1) y =
        (S.c : ℂ) * (sliceSpeedSeq S (oddSliceN S) j.val y)⁻¹ ^ 2 *
          Complex.cos (sliceAngleSeq S (oddSliceN S) j.val y) *
          deriv (sliceImpactSeq S (oddSliceN S) j.val) y
  reg_deriv_support_pt : ∀ y ∈ horizStrip (sliceHeight S (oddSliceN S)),
    (∀ k : Fin (oddSliceN S), sliceSpeedSeq S (oddSliceN S) k.val y ≠ 0) →
    ∀ j : Fin (oddSliceN S),
      deriv (sliceSupportSeq S (oddSliceN S) j.val) y =
        (-slicePosSeq S (oddSliceN S) j.val y 0 *
            Complex.sin (sliceAngleSeq S (oddSliceN S) j.val y) +
          slicePosSeq S (oddSliceN S) j.val y 1 *
            Complex.cos (sliceAngleSeq S (oddSliceN S) j.val y)) *
        deriv (sliceAngleSeq S (oddSliceN S) j.val) y
  pos_reconstruction_pt : ∀ y ∈ horizStrip (sliceHeight S (oddSliceN S)),
    (∀ k : Fin (oddSliceN S), sliceSpeedSeq S (oddSliceN S) k.val y ≠ 0) →
    (∀ k : Fin (oddSliceN S),
      Complex.sin (oddSliceTheta S k.val y - sliceAngleSeq S (oddSliceN S) k.val y) ≠ 0) →
    ∀ B_ang B_sup : ℝ, 0 ≤ B_ang → 0 ≤ B_sup →
      (∀ k : Fin (oddSliceN S),
        ‖sliceAngleSeq S (oddSliceN S) k.val y‖ +
          |Real.log ‖Complex.sin
            (oddSliceTheta S k.val y - sliceAngleSeq S (oddSliceN S) k.val y)‖| ≤ B_ang) →
      (∀ k : Fin (oddSliceN S), ‖sliceSupportSeq S (oddSliceN S) k.val y‖ ≤ B_sup) →
      ∀ j : Fin (oddSliceN S),
        ‖slicePosSeq S (oddSliceN S) j.val y‖ ≤
          oddSliceCRec S * Real.exp (oddSliceCRec S * B_ang) * B_sup

structure OddSliceJacobiProp (S : FiniteWallNonisotropicStrip) : Prop where
  Z_all_subset : oddSliceZAll S ⊆ horizStrip (sliceHeight S (oddSliceN S))
  reg_open : IsOpen (horizStrip (sliceHeight S (oddSliceN S)) \ oddSliceZAll S)
  real_not_mem_Z_all : ∀ x : ℝ, (x : ℂ) ∉ oddSliceZAll S
  Z_all_periodic : ∀ y : ℂ, y ∈ oddSliceZAll S ↔ y + 2 * Real.pi ∈ oddSliceZAll S
  Z_all_compact_finite : ∀ ε : ℝ, 0 < ε → ε < sliceHeight S (oddSliceN S) →
    (oddSliceZAll S ∩
      { y : ℂ | y.re ∈ Set.Icc (0 : ℝ) (2 * Real.pi) ∧
        |y.im| ≤ sliceHeight S (oddSliceN S) - ε }).Finite
  reg_speed_ne_zero : ∀ y ∈ horizStrip (sliceHeight S (oddSliceN S)) \ oddSliceZAll S,
    ∀ j : Fin (oddSliceN S), sliceSpeedSeq S (oddSliceN S) j.val y ≠ 0
  reg_sin_d0_ne_zero : ∀ y ∈ horizStrip (sliceHeight S (oddSliceN S)) \ oddSliceZAll S,
    ∀ j : Fin (oddSliceN S),
      Complex.sin (oddSliceTheta S j.val y - sliceAngleSeq S (oddSliceN S) j.val y) ≠ 0
  reg_chord_ne_zero : ∀ y ∈ horizStrip (sliceHeight S (oddSliceN S)) \ oddSliceZAll S,
    ∀ j : Fin (oddSliceN S),
      oddSliceChordNum S j y /
        (sliceSpeedSeq S (oddSliceN S) j.val y *
          sliceSpeedSeq S (oddSliceN S) ((j.val : ℤ) + 1) y) ≠ 0
  jacobi_null : ∀ y ∈ horizStrip (sliceHeight S (oddSliceN S)) \ oddSliceZAll S,
    (@jacobiH (oddSliceN S) (oddSliceNeZero S) S.c
      (fun j => sliceSpeedSeq S (oddSliceN S) j.val y)
      (fun j => oddSliceTheta S j.val y - sliceAngleSeq S (oddSliceN S) j.val y)
      (fun j => oddSliceChordNum S j y /
        (sliceSpeedSeq S (oddSliceN S) j.val y *
          sliceSpeedSeq S (oddSliceN S) ((j.val : ℤ) + 1) y))).mulVec
      (jacobiNullVec (oddSliceN S) S.c
        (fun j => sliceSpeedSeq S (oddSliceN S) j.val y)
        (fun j => oddSliceTheta S j.val y - sliceAngleSeq S (oddSliceN S) j.val y)
        (fun j => deriv (sliceImpactSeq S (oddSliceN S) j.val) y)) = 0
  jacobi_M0_mulVec : ∀ y ∈ horizStrip (sliceHeight S (oddSliceN S)) \ oddSliceZAll S,
    ∀ j : Fin (oddSliceN S),
      2 * sliceSpeedSeq S (oddSliceN S) j.val y *
        deriv (sliceImpactSeq S (oddSliceN S) j.val) y =
        (@jacobiM0 (oddSliceN S) (oddSliceNeZero S)
          (fun i => oddSliceChordNum S i y /
            (sliceSpeedSeq S (oddSliceN S) i.val y *
              sliceSpeedSeq S (oddSliceN S) ((i.val : ℤ) + 1) y))).mulVec
          (jacobiNullVec (oddSliceN S) S.c
            (fun i => sliceSpeedSeq S (oddSliceN S) i.val y)
            (fun i => oddSliceTheta S i.val y - sliceAngleSeq S (oddSliceN S) i.val y)
            (fun i => deriv (sliceImpactSeq S (oddSliceN S) i.val) y)) j
  modified_det_ne_zero : ∀ y ∈ horizStrip (sliceHeight S (oddSliceN S)) \ oddSliceZAll S,
    ∀ I F : Finset (Fin (oddSliceN S)), I ⊂ Finset.univ → Disjoint I F →
      (@modifiedJacobiB (oddSliceN S) (oddSliceNeZero S) S.c
        (fun i => sliceSpeedSeq S (oddSliceN S) i.val y)
        (fun i => oddSliceTheta S i.val y - sliceAngleSeq S (oddSliceN S) i.val y)
        (fun i => oddSliceChordNum S i y /
          (sliceSpeedSeq S (oddSliceN S) i.val y *
            sliceSpeedSeq S (oddSliceN S) ((i.val : ℤ) + 1) y))
        I F).det ≠ 0
  cofactor_norm : ∀ y ∈ horizStrip (sliceHeight S (oddSliceN S)) \ oddSliceZAll S,
    ∀ j : Fin (oddSliceN S),
      (jacobiNullVec (oddSliceN S) S.c
        (fun i => sliceSpeedSeq S (oddSliceN S) i.val y)
        (fun i => oddSliceTheta S i.val y - sliceAngleSeq S (oddSliceN S) i.val y)
        (fun i => deriv (sliceImpactSeq S (oddSliceN S) i.val) y) j) ^ 2 =
      (-1 : ℂ) ^ (oddSliceN S - 1) *
        (S.A (sliceParamT0 (oddSliceN S) : ℂ) / (oddSliceN S : ℂ)) *
        (∏ i : Fin (oddSliceN S),
          (oddSliceChordNum S i y /
            (sliceSpeedSeq S (oddSliceN S) i.val y *
              sliceSpeedSeq S (oddSliceN S) ((i.val : ℤ) + 1) y))) *
        (@modifiedJacobiB (oddSliceN S) (oddSliceNeZero S) S.c
          (fun i => sliceSpeedSeq S (oddSliceN S) i.val y)
          (fun i => oddSliceTheta S i.val y - sliceAngleSeq S (oddSliceN S) i.val y)
          (fun i => oddSliceChordNum S i y /
            (sliceSpeedSeq S (oddSliceN S) i.val y *
              sliceSpeedSeq S (oddSliceN S) ((i.val : ℤ) + 1) y))
          (Finset.univ.erase j) ∅).det
  cleared_cofactor_eq : ∀ y ∈ horizStrip (sliceHeight S (oddSliceN S)),
    ∀ j : Fin (oddSliceN S),
      ((S.c : ℂ) * Complex.sin (stateD0 S (oddSliceStateVec S y) j) *
          deriv (sliceImpactSeq S (oddSliceN S) j.val) y) ^ 2 *
        (∏ i : Fin (oddSliceN S), (S.f (oddSliceStateVec S y i)) ^ 2) *
        (stateDeltaRow S (oddSliceStateVec S y)) ^ (oddSliceN S) =
      (-1 : ℂ) ^ (oddSliceN S - 1) *
        (S.A (sliceParamT0 (oddSliceN S) : ℂ) / (oddSliceN S : ℂ)) *
        (S.f (oddSliceStateVec S y j)) ^ 4 *
        (∏ i : Fin (oddSliceN S), stateChordNum S (oddSliceStateVec S y) i) *
        (stateClearedB S (Finset.univ.erase j) ∅ (oddSliceStateVec S y)).det
noncomputable def coneCurvEnvelope (S : FiniteWallNonisotropicStrip)
    (L₀ C₁ C₂ K x₀ k : ℝ) : ℝ :=
  (64 / Real.pi) *
    ∫ t in (-C₁ * Real.log (2 * K) - 2 : ℝ)..(C₂ + 5),
      ∫ τ in (-(60 * L₀ + 10) : ℝ)..(60 * L₀ + 10),
        Real.exp (-2 * (k + t)) *
          ‖S.q (upperRowPt S (k + t) (x₀ + Real.exp (-(k + t)) * τ))‖
structure StripAngleAndAmplitudeData (S : FiniteWallNonisotropicStrip)
    (hBudget : CriticalAngleBudgetData S) (P : OddPeriodicSliceData S) : Prop where
  speed_amp_cap : ∃ C_f : ℝ, 1 ≤ C_f ∧ ∀ s ∈ horizStrip S.H,
    ‖S.f s‖ ≤ Real.exp (C_f * (1 + max (-Real.log (S.H - |s.im|)) 0))
  odd_cycle_theta_bound : ∀ y ∈ horizStrip (sliceHeight S P.N) \ P.Z_all, ∀ j : Fin P.N,
    ‖P.θ_seq j.val y‖ ≤ (2 * (P.N : ℝ) + 1) * Real.pi +
      (P.N : ℝ) * Finset.univ.sup' Finset.univ_nonempty
        (fun k : Fin P.N => ‖sliceAngleSeq S P.N k.val y‖)
  odd_cycle_d0_bound : ∀ y ∈ horizStrip (sliceHeight S P.N) \ P.Z_all, ∀ j : Fin P.N,
    ‖P.d0 j y‖ ≤ (2 * (P.N : ℝ) + 1) * Real.pi +
      ((P.N : ℝ) + 1) * Finset.univ.sup' Finset.univ_nonempty
        (fun k : Fin P.N => ‖sliceAngleSeq S P.N k.val y‖)
  chord_upper_bound : ∀ y ∈ horizStrip (sliceHeight S P.N) \ P.Z_all, ∀ j : Fin P.N,
    ‖P.ℓ_slice j y‖ ≤ 4 * Real.exp ‖P.θ_seq j.val y‖ *
      (1 + Finset.univ.sup' Finset.univ_nonempty
        (fun k : Fin P.N => ‖slicePosSeq S P.N k.val y‖))
  angle_strip_majorant : ∃ C_har : ℝ, 0 < C_har ∧ ∀ K : ℝ, hBudget.k₀ ≤ K →
    let H_K : ℝ := S.H - Real.exp (-K)
    ∃ (U_K : ℂ → ℝ) (B_UK : ℝ),
      0 ≤ B_UK ∧
      ContinuousOn U_K (horizStrip H_K) ∧
      (∀ w ∈ horizStrip H_K, ‖S.ϕ w - w‖ ^ 2 ≤ U_K w ∧ U_K w ≤ B_UK) ∧
      (∀ j : Fin P.N,
        (2 * Real.pi)⁻¹ *
          (∫ x in (0 : ℝ)..(2 * Real.pi), U_K (sliceImpactSeq S P.N j.val x)) ≤
          C_har * K ^ (2 * hBudget.ρ)) ∧
      (∀ (j : Fin P.N) (y₀ : ℂ) (R : ℝ), 0 < R →
        (∀ z ∈ Metric.closedBall y₀ R,
          z ∈ horizStrip (sliceHeight S P.N) ∧
          sliceImpactSeq S P.N j.val z ∈ horizStrip H_K) →
        Real.circleAverage (fun y => U_K (sliceImpactSeq S P.N j.val y)) y₀ R =
          U_K (sliceImpactSeq S P.N j.val y₀))

noncomputable def sliceRunningPosMax (S : FiniteWallNonisotropicStrip)
    (P : OddPeriodicSliceData S) (y_seq : ℕ → ℂ) (n : ℕ) : ℝ :=
  1 + (Finset.range (n + 1)).sup' ⟨0, Finset.mem_range.mpr (Nat.zero_lt_succ n)⟩ fun l =>
    Finset.univ.sup' Finset.univ_nonempty fun k : Fin P.N =>
      ‖slicePosSeq S P.N k.val (y_seq l)‖

open Classical in
noncomputable def sliceIsTiny (S : FiniteWallNonisotropicStrip)
    (P : OddPeriodicSliceData S) (bG : ℝ) (j : Fin P.N) (y_seq : ℕ → ℂ) : ℕ → Bool
  | 0 => false
  | n + 1 =>
      if sliceIsTiny S P bG j y_seq n then
        decide (Real.log ‖sliceSpeedSeq S P.N j.val (y_seq (n + 1))‖ < -bG)
      else
        decide (Real.log ‖sliceSpeedSeq S P.N j.val (y_seq (n + 1))‖ ≤ -2 * bG)

open Classical in
noncomputable def sliceJointSwitches (S : FiniteWallNonisotropicStrip)
    (P : OddPeriodicSliceData S) (bG : ℝ) (y_seq : ℕ → ℂ) (T : ℕ) : ℕ :=
  ((Finset.range T).filter fun n =>
    ∃ j : Fin P.N, sliceIsTiny S P bG j y_seq n ≠ sliceIsTiny S P bG j y_seq (n + 1)).card

open Classical in
noncomputable def sliceAngCutOK (S : FiniteWallNonisotropicStrip)
    (P : OddPeriodicSliceData S) (r_star : ℝ) (y_seq : ℕ → ℂ) (n : ℕ) : Bool :=
  decide (∀ l ≤ n, ∀ k : Fin P.N, ‖sliceAngleSeq S P.N k.val (y_seq l)‖ ≤ r_star)

noncomputable def sliceModPosMart (S : FiniteWallNonisotropicStrip)
    (P : OddPeriodicSliceData S) (bG r_star : ℝ) (j : Fin P.N) (ι : Fin 2)
    (y_seq : ℕ → ℂ) (m : ℕ) : ℂ :=
  ∑ n ∈ Finset.range m,
    if sliceAngCutOK S P r_star y_seq n && !sliceIsTiny S P bG j y_seq n then
      slicePosSeq S P.N j.val (y_seq (n + 1)) ι - slicePosSeq S P.N j.val (y_seq n) ι
    else 0

noncomputable def sliceTinySupMart (S : FiniteWallNonisotropicStrip)
    (P : OddPeriodicSliceData S) (bG r_star : ℝ) (j : Fin P.N)
    (y_seq : ℕ → ℂ) (m : ℕ) : ℂ :=
  ∑ n ∈ Finset.range m,
    if sliceAngCutOK S P r_star y_seq n && sliceIsTiny S P bG j y_seq n then
      ((sliceRunningPosMax S P y_seq n : ℂ))⁻¹ *
        (sliceSupportSeq S P.N j.val (y_seq (n + 1)) - sliceSupportSeq S P.N j.val (y_seq n))
    else 0
noncomputable def slicePhaseDepth (S : FiniteWallNonisotropicStrip)
    (P : OddPeriodicSliceData S) (y : ℂ) : ℝ :=
  sliceHeight S P.N - |y.im|

noncomputable def bootRunningPosMax (S : FiniteWallNonisotropicStrip)
    (P : OddPeriodicSliceData S) (y_seq : ℕ → ℂ) (n : ℕ) : ℝ :=
  1 + (Finset.range (n + 1)).sup' ⟨0, Finset.mem_range.mpr (Nat.zero_lt_succ n)⟩ fun l =>
    Finset.univ.sup' Finset.univ_nonempty fun k : Fin P.N =>
      ‖slicePosSeq S P.N k.val (y_seq l)‖

noncomputable def bootEps0 (σ : ℝ) : ℝ :=
  (1 - σ) / 4

noncomputable def bootGapEta (N : ℕ) (σ : ℝ) : ℝ :=
  bootEps0 σ / (3 * ((N : ℝ) + 2))

noncomputable def bootGapXi (N : ℕ) (σ : ℝ) (ν : Fin (N + 1)) : ℝ :=
  σ + bootEps0 σ / 3 + (2 * (ν.val : ℝ) + 1) * bootGapEta N σ
structure ExtendedPeriodicSliceArc (S : FiniteWallNonisotropicStrip) (x_star : ℝ) where
  δ_arc : ℝ
  δ_arc_pos : 0 < δ_arc
  δ_arc_lt_half_h : δ_arc < sliceHeight S (oddSliceN S) / 2
  s_ext : ℂ → Fin (oddSliceN S) → ℂ
  s_ext_holo : ∀ j : Fin (oddSliceN S),
    DifferentiableOn ℂ (fun y => s_ext y j)
      (Metric.ball ((x_star : ℂ) + (sliceHeight S (oddSliceN S) : ℂ) * Complex.I) δ_arc)
  s_ext_in_strip :
    ∀ y ∈ Metric.ball ((x_star : ℂ) + (sliceHeight S (oddSliceN S) : ℂ) * Complex.I) δ_arc,
      ∀ j : Fin (oddSliceN S), s_ext y j ∈ horizStrip S.H
  s_ext_agrees :
    ∀ y ∈ Metric.ball ((x_star : ℂ) + (sliceHeight S (oddSliceN S) : ℂ) * Complex.I) δ_arc,
      y ∈ horizStrip (sliceHeight S (oddSliceN S)) →
      ∀ j : Fin (oddSliceN S), s_ext y j = sliceImpactSeq S (oddSliceN S) j.val y
  s_ext_f_ne :
    ∀ y ∈ Metric.ball ((x_star : ℂ) + (sliceHeight S (oddSliceN S) : ℂ) * Complex.I) δ_arc,
      ∀ j : Fin (oddSliceN S), S.f (s_ext y j) ≠ 0
  s_ext_sin_ne :
    ∀ y ∈ Metric.ball ((x_star : ℂ) + (sliceHeight S (oddSliceN S) : ℂ) * Complex.I) δ_arc,
      ∀ j : Fin (oddSliceN S), Complex.sin (stateD0 S (s_ext y) j) ≠ 0
  s_ext_chord_ne :
    ∀ y ∈ Metric.ball ((x_star : ℂ) + (sliceHeight S (oddSliceN S) : ℂ) * Complex.I) δ_arc,
      ∀ j : Fin (oddSliceN S), stateChordNum S (s_ext y) j ≠ 0
  s_ext_deriv_ne :
    ∀ y ∈ Metric.ball ((x_star : ℂ) + (sliceHeight S (oddSliceN S) : ℂ) * Complex.I) δ_arc,
      ∀ j : Fin (oddSliceN S), deriv (fun z => s_ext z j) y ≠ 0

noncomputable def clearedReflectE (S : FiniteWallNonisotropicStrip) (s_m s_0 s_p : ℂ) : ℂ :=
  let Km := holoScaledPos S s_m
  let K0 := holoScaledPos S s_0
  let Kp := holoScaledPos S s_p
  let fm := S.f s_m
  let f0 := S.f s_0
  let fp := S.f s_p
  let c0 := Complex.cos (S.ϕ s_0)
  let sn0 := Complex.sin (S.ϕ s_0)
  let dm0 := fm * K0 0 - f0 * Km 0
  let dm1 := fm * K0 1 - f0 * Km 1
  let dp0 := f0 * Kp 0 - fp * K0 0
  let dp1 := f0 * Kp 1 - fp * K0 1
  (dm0 * c0 + dm1 * sn0) * (-dp0 * sn0 + dp1 * c0) +
    (-dm0 * sn0 + dm1 * c0) * (dp0 * c0 + dp1 * sn0)

structure ReturnMapNormalFormData (S : FiniteWallNonisotropicStrip) where
  x_edge : ℝ
  ρ_0 : ℝ
  ρ_v : ℝ
  ρ_1 : ℝ
  ρ_v1 : ℝ
  ρ_s : ℝ
  ρ_bounds :
    0 < ρ_1 ∧ ρ_1 ≤ ρ_0 ∧ ρ_0 < sliceHeight S (oddSliceN S) / 2 ∧
    0 < ρ_v1 ∧ ρ_v1 ≤ ρ_v ∧ 0 < ρ_s
  s0_arc : ℂ → ℂ
  s1_arc : ℂ → ℂ
  s0_inv : ℂ → ℂ
  s0_arc_holo :
    DifferentiableOn ℂ s0_arc
      (Metric.ball ((x_edge : ℂ) + (sliceHeight S (oddSliceN S) : ℂ) * Complex.I) ρ_0)
  s1_arc_holo :
    DifferentiableOn ℂ s1_arc
      (Metric.ball ((x_edge : ℂ) + (sliceHeight S (oddSliceN S) : ℂ) * Complex.I) ρ_0)
  s0_arc_in_strip :
    ∀ u ∈ Metric.ball ((x_edge : ℂ) + (sliceHeight S (oddSliceN S) : ℂ) * Complex.I) ρ_0,
      s0_arc u ∈ horizStrip S.H
  s0_inv_holo :
    DifferentiableOn ℂ s0_inv
      (Metric.ball (s0_arc ((x_edge : ℂ) + (sliceHeight S (oddSliceN S) : ℂ) * Complex.I)) ρ_s)
  s0_arc_left_inv :
    ∀ u ∈ Metric.ball ((x_edge : ℂ) + (sliceHeight S (oddSliceN S) : ℂ) * Complex.I) ρ_1,
      s0_arc u ∈
        Metric.ball
          (s0_arc ((x_edge : ℂ) + (sliceHeight S (oddSliceN S) : ℂ) * Complex.I)) ρ_s ∧
      s0_inv (s0_arc u) = u
  s0_inv_right_inv :
    ∀ w ∈ Metric.ball
        (s0_arc ((x_edge : ℂ) + (sliceHeight S (oddSliceN S) : ℂ) * Complex.I)) ρ_s,
      s0_inv w ∈
        Metric.ball ((x_edge : ℂ) + (sliceHeight S (oddSliceN S) : ℂ) * Complex.I) ρ_0 ∧
      s0_arc (s0_inv w) = w
  F_plus : ℂ × ℂ → ℂ × ℂ
  F_minus : ℂ × ℂ → ℂ × ℂ
  σ : ℂ → ℂ
  A_plus : ℂ × ℂ → ℂ
  B_plus : ℂ × ℂ → ℂ
  A_minus : ℂ × ℂ → ℂ
  B_minus : ℂ × ℂ → ℂ
  F_plus_holo :
    DifferentiableOn ℂ F_plus
      (Metric.ball ((x_edge : ℂ) + (sliceHeight S (oddSliceN S) : ℂ) * Complex.I) ρ_0 ×ˢ
        Metric.ball (0 : ℂ) ρ_v)
  F_minus_holo :
    DifferentiableOn ℂ F_minus
      (Metric.ball ((x_edge : ℂ) + (sliceHeight S (oddSliceN S) : ℂ) * Complex.I) ρ_0 ×ˢ
        Metric.ball (0 : ℂ) ρ_v)
  σ_holo :
    DifferentiableOn ℂ σ
      (Metric.ball ((x_edge : ℂ) + (sliceHeight S (oddSliceN S) : ℂ) * Complex.I) ρ_0)
  σ_ne_zero :
    ∀ u ∈ Metric.ball ((x_edge : ℂ) + (sliceHeight S (oddSliceN S) : ℂ) * Complex.I) ρ_0,
      σ u ≠ 0
  rem_holo :
    DifferentiableOn ℂ A_plus
      (Metric.ball ((x_edge : ℂ) + (sliceHeight S (oddSliceN S) : ℂ) * Complex.I) ρ_0 ×ˢ
        Metric.ball (0 : ℂ) ρ_v) ∧
    DifferentiableOn ℂ B_plus
      (Metric.ball ((x_edge : ℂ) + (sliceHeight S (oddSliceN S) : ℂ) * Complex.I) ρ_0 ×ˢ
        Metric.ball (0 : ℂ) ρ_v) ∧
    DifferentiableOn ℂ A_minus
      (Metric.ball ((x_edge : ℂ) + (sliceHeight S (oddSliceN S) : ℂ) * Complex.I) ρ_0 ×ˢ
        Metric.ball (0 : ℂ) ρ_v) ∧
    DifferentiableOn ℂ B_minus
      (Metric.ball ((x_edge : ℂ) + (sliceHeight S (oddSliceN S) : ℂ) * Complex.I) ρ_0 ×ˢ
        Metric.ball (0 : ℂ) ρ_v)
  F_plus_eq :
    ∀ u ∈ Metric.ball ((x_edge : ℂ) + (sliceHeight S (oddSliceN S) : ℂ) * Complex.I) ρ_0,
      ∀ v ∈ Metric.ball (0 : ℂ) ρ_v,
        F_plus (u, v) =
          (u + σ u * v + v ^ 2 * A_plus (u, v),
           v - deriv σ u * v ^ 2 + v ^ 3 * B_plus (u, v))
  F_minus_eq :
    ∀ u ∈ Metric.ball ((x_edge : ℂ) + (sliceHeight S (oddSliceN S) : ℂ) * Complex.I) ρ_0,
      ∀ v ∈ Metric.ball (0 : ℂ) ρ_v,
        F_minus (u, v) =
          (u - σ u * v + v ^ 2 * A_minus (u, v),
           v + deriv σ u * v ^ 2 + v ^ 3 * B_minus (u, v))
  F_mutual_inv :
    ∀ u ∈ Metric.ball ((x_edge : ℂ) + (sliceHeight S (oddSliceN S) : ℂ) * Complex.I) ρ_1,
      ∀ v ∈ Metric.ball (0 : ℂ) ρ_v1,
        F_plus (u, v) ∈
          Metric.ball ((x_edge : ℂ) + (sliceHeight S (oddSliceN S) : ℂ) * Complex.I) ρ_0 ×ˢ
            Metric.ball (0 : ℂ) ρ_v ∧
        F_minus (u, v) ∈
          Metric.ball ((x_edge : ℂ) + (sliceHeight S (oddSliceN S) : ℂ) * Complex.I) ρ_0 ×ˢ
            Metric.ball (0 : ℂ) ρ_v ∧
        F_minus (F_plus (u, v)) = (u, v) ∧
        F_plus (F_minus (u, v)) = (u, v)
  slice_at_t0 :
    ∀ y ∈ Metric.ball ((x_edge : ℂ) + (sliceHeight S (oddSliceN S) : ℂ) * Complex.I) (ρ_1 / 2),
      y.im < sliceHeight S (oddSliceN S) →
      S.𝔰 (y, (sliceParamT0 (oddSliceN S) : ℂ)) = s0_arc y ∧
      S.𝔰 (y + (sliceParamT0 (oddSliceN S) : ℂ), (sliceParamT0 (oddSliceN S) : ℂ)) = s1_arc y
  chartV_deriv_t0 :
    ∀ y ∈ Metric.ball ((x_edge : ℂ) + (sliceHeight S (oddSliceN S) : ℂ) * Complex.I) (ρ_1 / 2),
      y.im < sliceHeight S (oddSliceN S) →
      deriv (fun t => S.𝔰 (y + t, t) - s1_arc (s0_inv (S.𝔰 (y, t))))
        (sliceParamT0 (oddSliceN S) : ℂ) =
        (oddSliceN S : ℂ) * (σ y)⁻¹
  subheight_tube_step :
    ∀ μ : ℝ, 0 < μ → μ < sliceHeight S (oddSliceN S) →
      ∃ r_μ : ℝ, 0 < r_μ ∧ r_μ < S.r_star - sliceParamT0 (oddSliceN S) ∧
        ∀ y ∈ Metric.ball
            ((x_edge : ℂ) + (sliceHeight S (oddSliceN S) : ℂ) * Complex.I) (ρ_1 / 2),
          y.im < sliceHeight S (oddSliceN S) - μ →
          ∀ t ∈ Metric.ball (sliceParamT0 (oddSliceN S) : ℂ) r_μ,
            (y, t) ∈ finiteWallTube S.r_star S.h_X ∧
            (y + t, t) ∈ finiteWallTube S.r_star S.h_X ∧
            S.𝔰 (y, t) ∈
              Metric.ball
                (s0_arc ((x_edge : ℂ) + (sliceHeight S (oddSliceN S) : ℂ) * Complex.I)) ρ_s ∧
            (s0_inv (S.𝔰 (y, t)), S.𝔰 (y + t, t) - s1_arc (s0_inv (S.𝔰 (y, t)))) ∈
              Metric.ball ((x_edge : ℂ) + (sliceHeight S (oddSliceN S) : ℂ) * Complex.I) ρ_1 ×ˢ
                Metric.ball (0 : ℂ) ρ_v1 ∧
            (y + (oddSliceN S : ℂ) * (t - (sliceParamT0 (oddSliceN S) : ℂ)) ∈
                Metric.ball
                  ((x_edge : ℂ) + (sliceHeight S (oddSliceN S) : ℂ) * Complex.I) (ρ_1 / 2) →
              (y + (oddSliceN S : ℂ) * (t - (sliceParamT0 (oddSliceN S) : ℂ))).im <
                sliceHeight S (oddSliceN S) - μ →
              F_plus (s0_inv (S.𝔰 (y, t)), S.𝔰 (y + t, t) - s1_arc (s0_inv (S.𝔰 (y, t)))) =
                (s0_inv
                  (S.𝔰 (y + (oddSliceN S : ℂ) * (t - (sliceParamT0 (oddSliceN S) : ℂ)), t)),
                 S.𝔰 (y + (oddSliceN S : ℂ) * (t - (sliceParamT0 (oddSliceN S) : ℂ)) + t, t) -
                   s1_arc
                     (s0_inv
                       (S.𝔰
                         (y + (oddSliceN S : ℂ) * (t - (sliceParamT0 (oddSliceN S) : ℂ)),
                           t)))))

def steepCorridorSet (S : FiniteWallNonisotropicStrip) (x_edge δ_cor r_steep : ℝ) :
    Set (ℂ × ℂ) :=
  { p : ℂ × ℂ |
    |p.1.re - x_edge| < δ_cor ∧
    sliceHeight S (oddSliceN S) - 2 * δ_cor < p.1.im ∧
    p.1.im < sliceHeight S (oddSliceN S) + δ_cor / 2 ∧
    0 < ‖p.2 - (sliceParamT0 (oddSliceN S) : ℂ)‖ ∧
    ‖p.2 - (sliceParamT0 (oddSliceN S) : ℂ)‖ < r_steep ∧
    ‖p.2 - (sliceParamT0 (oddSliceN S) : ℂ)‖ / 3 <
      |(p.2 - (sliceParamT0 (oddSliceN S) : ℂ)).im| }

structure SteepSliceSectorData (S : FiniteWallNonisotropicStrip) where
  x_edge : ℝ
  δ_cor : ℝ
  r_steep : ℝ
  δ_cor_pos : 0 < δ_cor
  δ_cor_lt : δ_cor < sliceHeight S (oddSliceN S) / 4 ∧ δ_cor < S.s_star / 2
  r_steep_pos : 0 < r_steep
  r_steep_lt : r_steep < S.r_star - sliceParamT0 (oddSliceN S)
  S_steep : ℂ × ℂ → ℂ
  S_steep_holo : DifferentiableOn ℂ S_steep (steepCorridorSet S x_edge δ_cor r_steep)
  S_steep_in_strip :
    ∀ p ∈ steepCorridorSet S x_edge δ_cor r_steep, S_steep p ∈ horizStrip S.H
  S_steep_agrees :
    ∀ μ : ℝ, 0 < μ → μ < sliceHeight S (oddSliceN S) →
      ∃ r_μ : ℝ, 0 < r_μ ∧ r_μ ≤ r_steep ∧
        ∀ p ∈ steepCorridorSet S x_edge δ_cor r_steep,
          p.1.im < sliceHeight S (oddSliceN S) - μ →
          ‖p.2 - (sliceParamT0 (oddSliceN S) : ℂ)‖ < r_μ →
          S_steep p = S.𝔰 p
def phClkSetDependsUpTo (n : ℕ) (E : Set WalkSpace) : Prop :=
  MeasurableSet E ∧
    ∀ om₁ om₂ : WalkSpace, (∀ k ≤ n, om₁ k = om₂ k) → (om₁ ∈ E ↔ om₂ ∈ E)

noncomputable def phClkWallDist (S : FiniteWallNonisotropicStrip)
    (P : OddPeriodicSliceData S) (sgn : ℝ) (y : ℂ) : ℝ :=
  sliceHeight S P.N - sgn * y.im

noncomputable def phClkConcaveBarrier (S : FiniteWallNonisotropicStrip)
    (P : OddPeriodicSliceData S) (sgn R : ℝ) (y : ℂ) : ℝ :=
  phClkWallDist S P sgn y * (4 * R - phClkWallDist S P sgn y)

noncomputable def phClkConvexBarrier (h ε v : ℝ) : ℝ :=
  -Real.log (h + ε - v) - Real.log (h + ε + v) + 2 * Real.log (h + ε)

structure PhClkStepToolkitProp (S : FiniteWallNonisotropicStrip)
    (P : OddPeriodicSliceData S) (ρ : ℂ → ℝ) : Prop where
  prob_walk : MeasureTheory.IsProbabilityMeasure walkMeasure
  walk_in_reg : ∀ om : WalkSpace, ∀ n : ℕ,
    walkPos ρ om n ∈ horizStrip (sliceHeight S P.N) \ P.Z_all
  reg_phase_depth_pos_and_step : ∀ y ∈ horizStrip (sliceHeight S P.N) \ P.Z_all,
    0 < slicePhaseDepth S P y ∧
    ρ y ≤ (1 / 100 : ℝ) * slicePhaseDepth S P y
  walkPos_depends : ∀ (k : ℕ) (om₁ om₂ : WalkSpace),
    (∀ l ≤ k, om₁ l = om₂ l) → walkPos ρ om₁ k = walkPos ρ om₂ k
  measurable_im : ∀ k : ℕ, Measurable (fun om : WalkSpace => (walkPos ρ om k).im)
  measurable_rho : ∀ k : ℕ, Measurable (fun om : WalkSpace => ρ (walkPos ρ om k))
  measurable_logDepth : ∀ (k : ℕ) (j : Fin P.N),
    Measurable (fun om : WalkSpace => sliceLogDepth S P j (walkPos ρ om k))
  measurable_geomCost : ∀ k : ℕ,
    Measurable (fun om : WalkSpace => sliceGeomCost S P (walkPos ρ om k))
  wall_linear_drift : ∀ (n : ℕ) (sgn : ℝ) (E : Set WalkSpace),
    (sgn = 1 ∨ sgn = -1) → phClkSetDependsUpTo n E →
    MeasureTheory.Integrable
      (E.indicator fun om : WalkSpace =>
        phClkWallDist S P sgn (walkPos ρ om (n + 1)) -
          phClkWallDist S P sgn (walkPos ρ om n)) walkMeasure ∧
    (∫ om, E.indicator (fun om : WalkSpace =>
        phClkWallDist S P sgn (walkPos ρ om (n + 1)) -
          phClkWallDist S P sgn (walkPos ρ om n)) om ∂walkMeasure) = 0
  wall_concave_drift : ∀ (n : ℕ) (sgn R : ℝ) (E : Set WalkSpace),
    (sgn = 1 ∨ sgn = -1) → phClkSetDependsUpTo n E →
    MeasureTheory.Integrable
      (E.indicator fun om : WalkSpace =>
        phClkConcaveBarrier S P sgn R (walkPos ρ om (n + 1)) -
          phClkConcaveBarrier S P sgn R (walkPos ρ om n)) walkMeasure ∧
    MeasureTheory.Integrable
      (E.indicator fun om : WalkSpace => (ρ (walkPos ρ om n)) ^ 2) walkMeasure ∧
    (∫ om, E.indicator (fun om : WalkSpace =>
        phClkConcaveBarrier S P sgn R (walkPos ρ om (n + 1)) -
          phClkConcaveBarrier S P sgn R (walkPos ρ om n)) om ∂walkMeasure) =
      -(1 / 2 : ℝ) * ∫ om, E.indicator
        (fun om : WalkSpace => (ρ (walkPos ρ om n)) ^ 2) om ∂walkMeasure
  masked_impact_l2 : ∀ (j : Fin P.N) (E : ℕ → Set WalkSpace) (N_hor : ℕ),
    (∀ n : ℕ, phClkSetDependsUpTo n (E n)) →
    MeasureTheory.Integrable
      (fun om : WalkSpace =>
        ‖∑ n ∈ Finset.range N_hor,
          (E n).indicator (fun om : WalkSpace =>
            sliceImpactSeq S P.N j.val (walkPos ρ om (n + 1)) -
              sliceImpactSeq S P.N j.val (walkPos ρ om n)) om‖ ^ 2) walkMeasure ∧
    (∫ om, ‖∑ n ∈ Finset.range N_hor,
        (E n).indicator (fun om : WalkSpace =>
          sliceImpactSeq S P.N j.val (walkPos ρ om (n + 1)) -
            sliceImpactSeq S P.N j.val (walkPos ρ om n)) om‖ ^ 2 ∂walkMeasure) =
      ∫ om, (∑ n ∈ Finset.range N_hor,
        ‖(E n).indicator (fun om : WalkSpace =>
          sliceImpactSeq S P.N j.val (walkPos ρ om (n + 1)) -
            sliceImpactSeq S P.N j.val (walkPos ρ om n)) om‖ ^ 2) ∂walkMeasure
  imag_step_lower_drift : ∀ (n : ℕ) (ψ : ℝ → ℝ) (L q : ℂ → ℝ) (B_q : ℝ),
    ContinuousOn ψ (Set.Icc (-sliceHeight S P.N) (sliceHeight S P.N)) →
    Measurable (fun om : WalkSpace => q (walkPos ρ om n)) →
    (∀ y ∈ horizStrip (sliceHeight S P.N) \ P.Z_all, 0 ≤ q y ∧ q y ≤ B_q) →
    (∀ y ∈ horizStrip (sliceHeight S P.N) \ P.Z_all, ∀ δ : ℝ, |δ| ≤ ρ y →
      L y * δ + 2 * q y * δ ^ 2 ≤ ψ (y.im + δ) - ψ y.im) →
    MeasureTheory.Integrable
      (fun om : WalkSpace => q (walkPos ρ om n) * (ρ (walkPos ρ om n)) ^ 2) walkMeasure ∧
    MeasureTheory.Integrable
      (fun om : WalkSpace => ψ ((walkPos ρ om n).im)) walkMeasure ∧
    MeasureTheory.Integrable
      (fun om : WalkSpace => ψ ((walkPos ρ om (n + 1)).im)) walkMeasure ∧
    (∫ om, q (walkPos ρ om n) * (ρ (walkPos ρ om n)) ^ 2 ∂walkMeasure) ≤
      (∫ om, ψ ((walkPos ρ om (n + 1)).im) ∂walkMeasure) -
        (∫ om, ψ ((walkPos ρ om n).im) ∂walkMeasure)
def shcbWalkDependsOnPrefix {α : Type} [MeasurableSpace α] (n : ℕ) (H : WalkSpace → α) : Prop :=
  ∃ h₀ : (Finset.range (n + 1) → ℝ) → α,
    Measurable h₀ ∧ ∀ om : WalkSpace, H om = h₀ (Finset.restrict (Finset.range (n + 1)) om)

def shcbWalkPrefixEvent (n : ℕ) (A : Set WalkSpace) : Prop :=
  ∃ S₀ : Set (Finset.range (n + 1) → ℝ),
    MeasurableSet S₀ ∧ A = Finset.restrict (Finset.range (n + 1)) ⁻¹' S₀

structure ShcbWalkCircleStepToolkit (S : FiniteWallNonisotropicStrip)
    (P : OddPeriodicSliceData S) : Prop where
  isProbWalk : MeasureTheory.IsProbabilityMeasure walkMeasure
  sliceHeight_bounds : S.s_star ≤ sliceHeight S P.N ∧ sliceHeight S P.N ≤ S.H
  impact_holo : ∀ j : Fin P.N,
    DifferentiableOn ℂ (sliceImpactSeq S P.N j.val) (horizStrip (sliceHeight S P.N))
  impact_maps_to : ∀ j : Fin P.N, ∀ y ∈ horizStrip (sliceHeight S P.N),
    sliceImpactSeq S P.N j.val y ∈ horizStrip S.H
  impact_real_im_zero : ∀ j : Fin P.N, ∀ x : ℝ,
    (sliceImpactSeq S P.N j.val (x : ℂ)).im = 0 ∧
    sliceShapeDepth S P j (x : ℂ) = S.H
  closedBall_in_reg : ∀ {M : ℝ} {ρ : ℂ → ℝ}, IsScaleAdmissibleStep S P M ρ →
    ∀ om : WalkSpace, ∀ m : ℕ,
      walkPos ρ om m ∈ horizStrip (sliceHeight S P.N) \ P.Z_all ∧
      0 < ρ (walkPos ρ om m) ∧
      Metric.closedBall (walkPos ρ om m) (ρ (walkPos ρ om m)) ⊆
        horizStrip (sliceHeight S P.N) \ P.Z_all
  walkPos_measurable : ∀ {M : ℝ} {ρ : ℂ → ℝ}, IsScaleAdmissibleStep S P M ρ →
    ∀ m : ℕ, Measurable (fun om : WalkSpace => walkPos ρ om m)
  prefix_of_measurable_reg : ∀ {M : ℝ} {ρ : ℂ → ℝ}, IsScaleAdmissibleStep S P M ρ →
    ∀ {α : Type} [MeasurableSpace α] {f : ℂ → α},
      Measurable (Set.domRestrict (horizStrip (sliceHeight S P.N) \ P.Z_all) f) →
      ∀ m : ℕ, shcbWalkDependsOnPrefix m (fun om => f (walkPos ρ om m))
  eval_zero_integral : ∀ F : ℝ → ℝ, Measurable F → (∃ B : ℝ, ∀ x : ℝ, |F x| ≤ B) →
    MeasureTheory.Integrable (fun om : WalkSpace => F (om 0)) walkMeasure ∧
    (∫ om, F (om 0) ∂walkMeasure) =
      (2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi), F x
  step_pair_integral : ∀ {𝕜 : Type} [RCLike 𝕜] {M : ℝ} {ρ : ℂ → ℝ},
    IsScaleAdmissibleStep S P M ρ →
    ∀ (n : ℕ) (H : WalkSpace → 𝕜) (K : ℂ → ℂ → 𝕜),
      shcbWalkDependsOnPrefix n H →
      (∃ B_H : ℝ, ∀ om : WalkSpace, ‖H om‖ ≤ B_H) →
      Measurable (Set.indicator
        ((horizStrip (sliceHeight S P.N) \ P.Z_all) ×ˢ
          (horizStrip (sliceHeight S P.N) \ P.Z_all))
        (fun p : ℂ × ℂ => K p.1 p.2)) →
      (∃ B_K : ℝ, ∀ y ∈ horizStrip (sliceHeight S P.N) \ P.Z_all,
        ∀ z ∈ Metric.closedBall y (ρ y), ‖K y z‖ ≤ B_K) →
      MeasureTheory.Integrable
        (fun om : WalkSpace => H om * K (walkPos ρ om n) (walkPos ρ om (n + 1))) walkMeasure ∧
      MeasureTheory.Integrable
        (fun om : WalkSpace => H om * Real.circleAverage (K (walkPos ρ om n))
          (walkPos ρ om n) (ρ (walkPos ρ om n))) walkMeasure ∧
      (∫ om, H om * K (walkPos ρ om n) (walkPos ρ om (n + 1)) ∂walkMeasure) =
        ∫ om, H om * Real.circleAverage (K (walkPos ρ om n))
          (walkPos ρ om n) (ρ (walkPos ρ om n)) ∂walkMeasure
  holo_circle_mean_and_var : ∀ {U : Set ℂ} {f : ℂ → ℂ} {y : ℂ} {r : ℝ},
    IsOpen U → DifferentiableOn ℂ f U → 0 < r → Metric.closedBall y r ⊆ U →
    Real.circleAverage f y r = f y ∧
    Real.circleAverage (fun z => (f z).re) y r = (f y).re ∧
    Real.circleAverage (fun z => (f z).im) y r = (f y).im ∧
    Real.circleAverage (fun z => ‖f z - f y‖ ^ 2) y r =
      2 * Real.circleAverage (fun z => ((f z).im - (f y).im) ^ 2) y r ∧
    r ^ 2 * ‖deriv f y‖ ^ 2 ≤
      2 * Real.circleAverage (fun z => ((f z).im - (f y).im) ^ 2) y r

def ShcbFirstHitDomProp (S : FiniteWallNonisotropicStrip)
    (P : OddPeriodicSliceData S) (C_hit : ℝ) : Prop :=
  ∀ M d r_int : ℝ, ∀ ρ : ℂ → ℝ, ∀ j : Fin P.N, ∀ E : Set ℝ,
    IsScaleAdmissibleStep S P M ρ →
    0 < d → d < S.H / 4 →
    100 * Real.exp (-M ^ 2) * d ≤ r_int →
    MeasurableSet E → (∀ x : ℝ, x ∈ E ↔ x + 2 * Real.pi ∈ E) →
    walkMeasure.real {om : WalkSpace |
      (∃ m ≤ sliceStopTau S P ρ M om,
        sliceShapeDepth S P j (walkPos ρ om m) ≤ d) ∧
      Set.Ioo
        ((sliceImpactSeq S P.N j.val
          (walkPos ρ om (sliceFirstHit S P ρ M d j om))).re - r_int)
        ((sliceImpactSeq S P.N j.val
          (walkPos ρ om (sliceFirstHit S P ρ M d j om))).re + r_int) ⊆
        E} ≤
    C_hit * MeasureTheory.volume.real (E ∩ Set.Icc (0 : ℝ) (2 * Real.pi))

def ShcbRemainingClockTailProp (S : FiniteWallNonisotropicStrip)
    (P : OddPeriodicSliceData S) (C_rem : ℝ) : Prop :=
  ∀ M d B : ℝ, ∀ ρ : ℂ → ℝ, ∀ j : Fin P.N,
    IsScaleAdmissibleStep S P M ρ →
    0 < d → d < S.H / 4 → 1 ≤ B → d * Real.exp (B / 4) < S.H / 4 →
    walkMeasure.real {om : WalkSpace |
      d ^ 2 * Real.exp B <
        ∑ m ∈ Finset.Ico (sliceFirstHit S P ρ M d j om)
            (sliceStopTau S P ρ M om),
          ‖deriv (sliceImpactSeq S P.N j.val) (walkPos ρ om m)‖ ^ 2 *
            (ρ (walkPos ρ om m)) ^ 2} ≤
    C_rem * Real.exp (-B / 4)

def ShcbStoppedDisplacementProp (S : FiniteWallNonisotropicStrip)
    (P : OddPeriodicSliceData S) : Prop :=
  ∀ M d r_exit q_K : ℝ, ∀ ρ : ℂ → ℝ,
    ∀ (J : Finset (Fin P.N)) (hJ : J.Nonempty) (i : Fin P.N),
    IsScaleAdmissibleStep S P M ρ →
    i ∈ J → 0 < d → d < S.H / 4 → 0 < r_exit → 0 < q_K →
    walkMeasure.real {om : WalkSpace |
      (∑ m ∈ Finset.Ico (sliceLastFirstHit S P ρ M d J hJ om)
          (sliceDiskExit S P ρ M d r_exit J hJ i om),
        (2 * ‖deriv (sliceImpactSeq S P.N i.val) (walkPos ρ om m)‖ ^ 2 +
          Real.exp (-2 * M ^ 3)) *
          (ρ (walkPos ρ om m)) ^ 2 ≤ q_K) ∧
      r_exit <
        ‖sliceImpactSeq S P.N i.val
            (walkPos ρ om (sliceDiskExit S P ρ M d r_exit J hJ i om)) -
          sliceImpactSeq S P.N i.val
            (walkPos ρ om (sliceLastFirstHit S P ρ M d J hJ om))‖} ≤
    2 * q_K / r_exit ^ 2
noncomputable def arcS0 (S : FiniteWallNonisotropicStrip) {x_star : ℝ}
    (A : ExtendedPeriodicSliceArc S x_star) (u : ℂ) : ℂ :=
  A.s_ext u ⟨0, by unfold oddSliceN; omega⟩

noncomputable def arcS1 (S : FiniteWallNonisotropicStrip) {x_star : ℝ}
    (A : ExtendedPeriodicSliceArc S x_star) (u : ℂ) : ℂ :=
  A.s_ext u ⟨1, by unfold oddSliceN; omega⟩

structure ClearedReflectionArcProp (S : FiniteWallNonisotropicStrip) (x_star : ℝ)
    (A : ExtendedPeriodicSliceArc S x_star) : Prop where
  analytic_at_strip :
    ∀ s_m s_0 s_p : ℂ,
      s_m ∈ horizStrip S.H → s_0 ∈ horizStrip S.H → s_p ∈ horizStrip S.H →
      AnalyticAt ℂ (fun p : (ℂ × ℂ) × ℂ => clearedReflectE S p.1.1 p.1.2 p.2)
        ((s_m, s_0), s_p)
  periodic_m :
    ∀ s_m s_0 s_p : ℂ,
      s_m ∈ horizStrip S.H →
      clearedReflectE S (s_m + 2 * Real.pi) s_0 s_p = clearedReflectE S s_m s_0 s_p
  periodic_0 :
    ∀ s_m s_0 s_p : ℂ,
      s_0 ∈ horizStrip S.H →
      clearedReflectE S s_m (s_0 + 2 * Real.pi) s_p = clearedReflectE S s_m s_0 s_p
  periodic_p :
    ∀ s_m s_0 s_p : ℂ,
      s_p ∈ horizStrip S.H →
      clearedReflectE S s_m s_0 (s_p + 2 * Real.pi) = clearedReflectE S s_m s_0 s_p
  subheight_tube_vanish :
    ∀ μ : ℝ, 0 < μ → μ < sliceHeight S (oddSliceN S) →
      ∃ r_tube : ℝ, 0 < r_tube ∧ r_tube < S.r_star - sliceParamT0 (oddSliceN S) ∧
        ∀ y ∈ horizStrip (sliceHeight S (oddSliceN S) - μ),
          ∀ t ∈ Metric.ball (sliceParamT0 (oddSliceN S) : ℂ) r_tube,
            (∀ k : ℕ, k ≤ oddSliceN S + 1 →
              (y + (k : ℂ) * t, t) ∈ finiteWallTube S.r_star S.h_X) ∧
            (∀ k : ℕ, 1 ≤ k → k ≤ oddSliceN S →
              clearedReflectE S
                (S.𝔰 (y + ((k - 1 : ℕ) : ℂ) * t, t))
                (S.𝔰 (y + (k : ℂ) * t, t))
                (S.𝔰 (y + ((k + 1 : ℕ) : ℂ) * t, t)) = 0)
  arc_vanish :
    ∀ y ∈ Metric.ball ((x_star : ℂ) + (sliceHeight S (oddSliceN S) : ℂ) * Complex.I) A.δ_arc,
      ∀ j : Fin (oddSliceN S),
        clearedReflectE S
          (A.s_ext y (@cycPrev (oddSliceN S) (oddSliceNeZero S) j))
          (A.s_ext y j)
          (A.s_ext y (@cycNext (oddSliceN S) (oddSliceNeZero S) j)) = 0
  arc_partials_ne_zero :
    ∀ y ∈ Metric.ball ((x_star : ℂ) + (sliceHeight S (oddSliceN S) : ℂ) * Complex.I) A.δ_arc,
      ∀ j : Fin (oddSliceN S),
        deriv
          (fun z =>
            clearedReflectE S
              (A.s_ext y (@cycPrev (oddSliceN S) (oddSliceNeZero S) j))
              (A.s_ext y j) z)
          (A.s_ext y (@cycNext (oddSliceN S) (oddSliceNeZero S) j)) ≠ 0 ∧
        deriv
          (fun w =>
            clearedReflectE S w
              (A.s_ext y j)
              (A.s_ext y (@cycNext (oddSliceN S) (oddSliceNeZero S) j)))
          (A.s_ext y (@cycPrev (oddSliceN S) (oddSliceNeZero S) j)) ≠ 0

structure ConjugatedReturnMapArcData (S : FiniteWallNonisotropicStrip) (x_star : ℝ)
    (A : ExtendedPeriodicSliceArc S x_star) where
  δ_0 : ℝ
  δ_v0 : ℝ
  δ_1 : ℝ
  δ_v1 : ℝ
  δ_bounds : 0 < δ_1 ∧ δ_1 < δ_0 ∧ δ_0 ≤ A.δ_arc ∧ 0 < δ_v1 ∧ δ_v1 < δ_v0
  s0_inv : ℂ → ℂ
  s0_arc_open_map :
    ∀ U : Set ℂ, IsOpen U →
      U ⊆ Metric.ball ((x_star : ℂ) + (sliceHeight S (oddSliceN S) : ℂ) * Complex.I) δ_0 →
      IsOpen (arcS0 S A '' U)
  s0_inv_holo_on_image :
    DifferentiableOn ℂ s0_inv
      (arcS0 S A ''
        Metric.ball ((x_star : ℂ) + (sliceHeight S (oddSliceN S) : ℂ) * Complex.I) δ_0)
  s0_left_inv :
    ∀ u ∈ Metric.ball ((x_star : ℂ) + (sliceHeight S (oddSliceN S) : ℂ) * Complex.I) δ_0,
      s0_inv (arcS0 S A u) = u
  F_plus : ℂ × ℂ → ℂ × ℂ
  F_minus : ℂ × ℂ → ℂ × ℂ
  F_plus_holo :
    DifferentiableOn ℂ F_plus
      (Metric.ball ((x_star : ℂ) + (sliceHeight S (oddSliceN S) : ℂ) * Complex.I) δ_0 ×ˢ
        Metric.ball (0 : ℂ) δ_v0)
  F_minus_holo :
    DifferentiableOn ℂ F_minus
      (Metric.ball ((x_star : ℂ) + (sliceHeight S (oddSliceN S) : ℂ) * Complex.I) δ_0 ×ˢ
        Metric.ball (0 : ℂ) δ_v0)
  F_plus_zero :
    ∀ u ∈ Metric.ball ((x_star : ℂ) + (sliceHeight S (oddSliceN S) : ℂ) * Complex.I) δ_0,
      F_plus (u, 0) = (u, 0)
  F_minus_zero :
    ∀ u ∈ Metric.ball ((x_star : ℂ) + (sliceHeight S (oddSliceN S) : ℂ) * Complex.I) δ_0,
      F_minus (u, 0) = (u, 0)
  F_mutual_inv :
    ∀ u ∈ Metric.ball ((x_star : ℂ) + (sliceHeight S (oddSliceN S) : ℂ) * Complex.I) δ_1,
      ∀ v ∈ Metric.ball (0 : ℂ) δ_v1,
        F_plus (u, v) ∈
          Metric.ball ((x_star : ℂ) + (sliceHeight S (oddSliceN S) : ℂ) * Complex.I) δ_0 ×ˢ
            Metric.ball (0 : ℂ) δ_v0 ∧
        F_minus (u, v) ∈
          Metric.ball ((x_star : ℂ) + (sliceHeight S (oddSliceN S) : ℂ) * Complex.I) δ_0 ×ˢ
            Metric.ball (0 : ℂ) δ_v0 ∧
        F_minus (F_plus (u, v)) = (u, v) ∧
        F_plus (F_minus (u, v)) = (u, v)
  arc_slice_at_t0 :
    ∀ y ∈ Metric.ball ((x_star : ℂ) + (sliceHeight S (oddSliceN S) : ℂ) * Complex.I) δ_0,
      y.im < sliceHeight S (oddSliceN S) →
      S.𝔰 (y, (sliceParamT0 (oddSliceN S) : ℂ)) = arcS0 S A y ∧
      S.𝔰 (y + (sliceParamT0 (oddSliceN S) : ℂ), (sliceParamT0 (oddSliceN S) : ℂ)) =
        arcS1 S A y
  arc_subheight_step :
    ∀ μ : ℝ, 0 < μ → μ < sliceHeight S (oddSliceN S) →
      ∃ r_μ : ℝ, 0 < r_μ ∧ r_μ < S.r_star - sliceParamT0 (oddSliceN S) ∧
        ∀ y ∈ Metric.ball
            ((x_star : ℂ) + (sliceHeight S (oddSliceN S) : ℂ) * Complex.I)
            ((3 / 4 : ℝ) * δ_1),
          y.im < sliceHeight S (oddSliceN S) - μ →
          ∀ t ∈ Metric.ball (sliceParamT0 (oddSliceN S) : ℂ) r_μ,
            (y, t) ∈ finiteWallTube S.r_star S.h_X ∧
            (y + t, t) ∈ finiteWallTube S.r_star S.h_X ∧
            S.𝔰 (y, t) ∈
              arcS0 S A ''
                Metric.ball
                  ((x_star : ℂ) + (sliceHeight S (oddSliceN S) : ℂ) * Complex.I) δ_0 ∧
            (s0_inv (S.𝔰 (y, t)), S.𝔰 (y + t, t) - arcS1 S A (s0_inv (S.𝔰 (y, t)))) ∈
              Metric.ball
                ((x_star : ℂ) + (sliceHeight S (oddSliceN S) : ℂ) * Complex.I) δ_1 ×ˢ
                Metric.ball (0 : ℂ) δ_v1 ∧
            (y + (oddSliceN S : ℂ) * (t - (sliceParamT0 (oddSliceN S) : ℂ)) ∈
                Metric.ball
                  ((x_star : ℂ) + (sliceHeight S (oddSliceN S) : ℂ) * Complex.I)
                  ((3 / 4 : ℝ) * δ_1) →
              (y + (oddSliceN S : ℂ) * (t - (sliceParamT0 (oddSliceN S) : ℂ))).im <
                sliceHeight S (oddSliceN S) - μ →
              F_plus
                (s0_inv (S.𝔰 (y, t)),
                 S.𝔰 (y + t, t) - arcS1 S A (s0_inv (S.𝔰 (y, t)))) =
                (s0_inv
                  (S.𝔰 (y + (oddSliceN S : ℂ) * (t - (sliceParamT0 (oddSliceN S) : ℂ)), t)),
                 S.𝔰
                   (y + (oddSliceN S : ℂ) * (t - (sliceParamT0 (oddSliceN S) : ℂ)) + t, t) -
                   arcS1 S A
                     (s0_inv
                       (S.𝔰
                         (y + (oddSliceN S : ℂ) * (t - (sliceParamT0 (oddSliceN S) : ℂ)),
                           t)))))

structure ConjugacyNormalFormExpansion (y_star : ℂ) (δ_0 δ_v1 : ℝ)
    (F_plus F_minus : ℂ × ℂ → ℂ × ℂ) where
  ρ_v : ℝ
  ρ_v_pos : 0 < ρ_v
  ρ_v_le : ρ_v ≤ δ_v1
  σ : ℂ → ℂ
  A_plus : ℂ × ℂ → ℂ
  B_plus : ℂ × ℂ → ℂ
  A_minus : ℂ × ℂ → ℂ
  B_minus : ℂ × ℂ → ℂ
  σ_holo : DifferentiableOn ℂ σ (Metric.ball y_star δ_0)
  σ_nonzero_exists : ∃ y_sub ∈ Metric.ball y_star δ_0, σ y_sub ≠ 0
  rem_holo :
    DifferentiableOn ℂ A_plus (Metric.ball y_star δ_0 ×ˢ Metric.ball (0 : ℂ) ρ_v) ∧
    DifferentiableOn ℂ B_plus (Metric.ball y_star δ_0 ×ˢ Metric.ball (0 : ℂ) ρ_v) ∧
    DifferentiableOn ℂ A_minus (Metric.ball y_star δ_0 ×ˢ Metric.ball (0 : ℂ) ρ_v) ∧
    DifferentiableOn ℂ B_minus (Metric.ball y_star δ_0 ×ˢ Metric.ball (0 : ℂ) ρ_v)
  F_plus_eq :
    ∀ u ∈ Metric.ball y_star δ_0, ∀ v ∈ Metric.ball (0 : ℂ) ρ_v,
      F_plus (u, v) =
        (u + σ u * v + v ^ 2 * A_plus (u, v),
         v - deriv σ u * v ^ 2 + v ^ 3 * B_plus (u, v))
  F_minus_eq :
    ∀ u ∈ Metric.ball y_star δ_0, ∀ v ∈ Metric.ball (0 : ℂ) ρ_v,
      F_minus (u, v) =
        (u - σ u * v + v ^ 2 * A_minus (u, v),
         v + deriv σ u * v ^ 2 + v ^ 3 * B_minus (u, v))

theorem support_ellipse_criterion (Ω : Set Plane)
    (hΩ : IsSmoothPositivelyCurvedBilliardDomain Ω)
    (L : SupportLazutkinData Ω)
    (hTrig : HasTrigSpeed L) :
    IsEllipse Ω :=
by
  
  have polar_rep : ∀ x y : ℝ, (x ≠ 0 ∨ y ≠ 0) →
      ∃ r θ : ℝ, 0 < r ∧ r ^ 2 = x ^ 2 + y ^ 2 ∧ x = r * Real.cos θ ∧ y = r * Real.sin θ := by
    intro x y hxy
    let z : ℂ := ⟨x, y⟩
    have hz : z ≠ 0 := by
      intro hz0
      rcases hxy with hx | hy
      · exact hx (congr_arg Complex.re hz0)
      · exact hy (congr_arg Complex.im hz0)
    refine ⟨‖z‖, z.arg, norm_pos_iff.mpr hz, ?_, ?_, ?_⟩
    · rw [Complex.sq_norm, Complex.normSq_mk]
      ring
    · exact (Complex.norm_mul_cos_arg z).symm
    · exact (Complex.norm_mul_sin_arg z).symm

  
  obtain ⟨B₀, C₀, D₀, h_speed⟩ := hTrig
  have hϕ_add_nat : ∀ n : ℕ, L.ϕ (n * (2 * Real.pi)) = L.ϕ 0 + n * (2 * Real.pi) := by
    intro n
    induction n with
    | zero => simp
    | succ n ih =>
      have hstep : ((n + 1 : ℕ) : ℝ) * (2 * Real.pi) = (n : ℝ) * (2 * Real.pi) + 2 * Real.pi := by
        push_cast; ring
      rw [hstep, L.ϕ_quasiperiodic, ih]
      push_cast; ring
  have hϕ_sub_nat : ∀ n : ℕ, L.ϕ (-((n : ℝ) * (2 * Real.pi))) = L.ϕ 0 - n * (2 * Real.pi) := by
    intro n
    induction n with
    | zero => simp
    | succ n ih =>
      have hstep := L.ϕ_quasiperiodic (-(((n + 1 : ℕ) : ℝ) * (2 * Real.pi)))
      have harg : -(((n + 1 : ℕ) : ℝ) * (2 * Real.pi)) + 2 * Real.pi = -((n : ℝ) * (2 * Real.pi)) := by
        push_cast; ring
      rw [harg, ih] at hstep
      push_cast at hstep ⊢
      linarith
  have hϕ_surj : Function.Surjective L.ϕ := by
    intro θ
    have h2pi : (0 : ℝ) < 2 * Real.pi := by positivity
    obtain ⟨n, hn⟩ := exists_nat_gt (|θ - L.ϕ 0| / (2 * Real.pi))
    have habs : |θ - L.ϕ 0| < (n : ℝ) * (2 * Real.pi) := by
      have hmul := mul_lt_mul_of_pos_right hn h2pi
      rwa [div_mul_cancel₀ _ (ne_of_gt h2pi)] at hmul
    have hn_pos : 0 < (n : ℝ) * (2 * Real.pi) := lt_of_le_of_lt (abs_nonneg _) habs
    have hab : -((n : ℝ) * (2 * Real.pi)) ≤ (n : ℝ) * (2 * Real.pi) := by linarith
    have hbounds := abs_lt.mp habs
    have hmem : θ ∈ Set.Icc (L.ϕ (-((n : ℝ) * (2 * Real.pi)))) (L.ϕ ((n : ℝ) * (2 * Real.pi))) := by
      rw [hϕ_sub_nat, hϕ_add_nat]
      exact ⟨by linarith, by linarith⟩
    obtain ⟨x, _, hx⟩ := intermediate_value_Icc hab L.ϕ_smooth.continuous.continuousOn hmem
    exact ⟨x, hx⟩

  let q_N : ℝ → ℝ := fun θ => C₀ + B₀ * Real.cos (2 * θ) + D₀ * Real.sin (2 * θ)
  have hq_pos : ∀ θ : ℝ, 0 < q_N θ := by
    intro θ
    obtain ⟨x, rfl⟩ := hϕ_surj θ
    have hdx : 0 < deriv L.ϕ x := L.ϕ_deriv_pos x
    have hsq : (deriv L.ϕ x) ^ 2 = q_N (L.ϕ x) := h_speed x
    nlinarith
  have h_ode : ∀ θ : ℝ, (L.h θ + deriv (deriv L.h) θ) * (Real.sqrt (q_N θ)) ^ 3 = L.c := by
    intro θ
    obtain ⟨x, rfl⟩ := hϕ_surj θ
    have hdx : 0 ≤ deriv L.ϕ x := le_of_lt (L.ϕ_deriv_pos x)
    have hsqrt : Real.sqrt (q_N (L.ϕ x)) = deriv L.ϕ x := by
      dsimp [q_N]
      rw [← h_speed x, Real.sqrt_sq hdx]
    rw [hsqrt]
    exact L.lazutkin_norm x

  
  let Δ_N : ℝ := C₀ ^ 2 - B₀ ^ 2 - D₀ ^ 2
  have hΔ_pos : 0 < Δ_N := by
    by_cases hBD : -B₀ = 0 ∧ -D₀ = 0
    · have hB0 : B₀ = 0 := by linarith [hBD.1]
      have hD0 : D₀ = 0 := by linarith [hBD.2]
      have hC0 : 0 < C₀ := by
        have h0 := hq_pos 0
        simp [q_N, hB0, hD0] at h0
        exact h0
      dsimp [Δ_N]
      rw [hB0, hD0]
      nlinarith
    · have hBD' : -B₀ ≠ 0 ∨ -D₀ ≠ 0 := not_and_or.mp hBD
      obtain ⟨r, φ, hr_pos, hr_sq, hB, hD⟩ := polar_rep (-B₀) (-D₀) hBD'
      have hqφ : 0 < C₀ + B₀ * Real.cos φ + D₀ * Real.sin φ := by
        have h := hq_pos (φ / 2)
        dsimp [q_N] at h
        have h2 : 2 * (φ / 2) = φ := by ring
        rwa [h2] at h
      have hr_lt : r < C₀ := by
        have hmul : 0 < r * (C₀ + B₀ * Real.cos φ + D₀ * Real.sin φ) := mul_pos hr_pos hqφ
        have hid : r * (C₀ + B₀ * Real.cos φ + D₀ * Real.sin φ) = r * C₀ - (B₀ ^ 2 + D₀ ^ 2) := by
          calc r * (C₀ + B₀ * Real.cos φ + D₀ * Real.sin φ)
              = r * C₀ + B₀ * (r * Real.cos φ) + D₀ * (r * Real.sin φ) := by ring
            _ = r * C₀ + B₀ * (-B₀) + D₀ * (-D₀) := by rw [← hB, ← hD]
            _ = r * C₀ - (B₀ ^ 2 + D₀ ^ 2) := by ring
        nlinarith
      dsimp [Δ_N]
      nlinarith

  
  let α : ℝ := L.c / Δ_N
  have hα_pos : 0 < α := div_pos L.c_pos hΔ_pos
  let p : ℝ → ℝ := fun θ => -B₀ * Real.sin (2 * θ) + D₀ * Real.cos (2 * θ)
  let h_E : ℝ → ℝ := fun θ => α * Real.sqrt (q_N θ)
  let dh_E : ℝ → ℝ := fun θ => α * (p θ / Real.sqrt (q_N θ))
  let ddh_E : ℝ → ℝ := fun θ =>
    α * ((2 * (C₀ - q_N θ) * Real.sqrt (q_N θ) - p θ * (p θ / Real.sqrt (q_N θ))) /
      (Real.sqrt (q_N θ)) ^ 2)
  have h2_deriv : ∀ θ : ℝ, HasDerivAt (fun t : ℝ => 2 * t) 2 θ := by
    intro θ
    simpa using (hasDerivAt_id θ).const_mul (2 : ℝ)
  have hq_deriv : ∀ θ : ℝ, HasDerivAt q_N (2 * p θ) θ := by
    intro θ
    have hc : HasDerivAt (fun t => Real.cos (2 * t)) (-Real.sin (2 * θ) * 2) θ :=
      (Real.hasDerivAt_cos (2 * θ)).comp θ (h2_deriv θ)
    have hs : HasDerivAt (fun t => Real.sin (2 * t)) (Real.cos (2 * θ) * 2) θ :=
      (Real.hasDerivAt_sin (2 * θ)).comp θ (h2_deriv θ)
    have hcomb := ((hasDerivAt_const θ C₀).add (hc.const_mul B₀)).add (hs.const_mul D₀)
    convert hcomb using 1
    dsimp [p]
    ring
  have hp_deriv : ∀ θ : ℝ, HasDerivAt p (2 * (C₀ - q_N θ)) θ := by
    intro θ
    have hc : HasDerivAt (fun t => Real.cos (2 * t)) (-Real.sin (2 * θ) * 2) θ :=
      (Real.hasDerivAt_cos (2 * θ)).comp θ (h2_deriv θ)
    have hs : HasDerivAt (fun t => Real.sin (2 * t)) (Real.cos (2 * θ) * 2) θ :=
      (Real.hasDerivAt_sin (2 * θ)).comp θ (h2_deriv θ)
    have hcomb := (hs.const_mul (-B₀)).add (hc.const_mul D₀)
    convert hcomb using 1
    dsimp [q_N]
    ring
  have hsqrt_deriv : ∀ θ : ℝ, HasDerivAt (fun t => Real.sqrt (q_N t)) (p θ / Real.sqrt (q_N θ)) θ := by
    intro θ
    have hs := (hq_deriv θ).sqrt (ne_of_gt (hq_pos θ))
    convert hs using 1
    ring
  have hhE_deriv₁ : ∀ θ : ℝ, HasDerivAt h_E (dh_E θ) θ :=
    fun θ => (hsqrt_deriv θ).const_mul α
  have hhE_deriv₂ : ∀ θ : ℝ, HasDerivAt dh_E (ddh_E θ) θ := by
    intro θ
    have hne : Real.sqrt (q_N θ) ≠ 0 := ne_of_gt (Real.sqrt_pos.mpr (hq_pos θ))
    exact ((hp_deriv θ).div (hsqrt_deriv θ) hne).const_mul α
  have hhE_ode : ∀ θ : ℝ, (h_E θ + ddh_E θ) * (Real.sqrt (q_N θ)) ^ 3 = L.c := by
    intro θ
    set s := Real.sqrt (q_N θ)
    have hs_pos : 0 < s := Real.sqrt_pos.mpr (hq_pos θ)
    have hs_ne : s ≠ 0 := ne_of_gt hs_pos
    have hs_sq : s ^ 2 = q_N θ := Real.sq_sqrt (le_of_lt (hq_pos θ))
    have hΔ_ne : Δ_N ≠ 0 := ne_of_gt hΔ_pos
    have htrig : Real.cos (2 * θ) ^ 2 + Real.sin (2 * θ) ^ 2 = 1 := Real.cos_sq_add_sin_sq (2 * θ)
    have hstep1 : (h_E θ + ddh_E θ) * s ^ 3 =
        α * (s ^ 4 + 2 * (C₀ - q_N θ) * s ^ 2 - p θ ^ 2) := by
      dsimp [h_E, ddh_E]
      change (α * s + α * ((2 * (C₀ - q_N θ) * s - p θ * (p θ / s)) / s ^ 2)) * s ^ 3 =
        α * (s ^ 4 + 2 * (C₀ - q_N θ) * s ^ 2 - p θ ^ 2)
      field_simp [hs_ne]
      ring
    have hstep2 : s ^ 4 + 2 * (C₀ - q_N θ) * s ^ 2 - p θ ^ 2 = Δ_N := by
      have hs4 : s ^ 4 = q_N θ ^ 2 := by
        calc s ^ 4 = (s ^ 2) ^ 2 := by ring
          _ = q_N θ ^ 2 := by rw [hs_sq]
      rw [hs4, hs_sq]
      dsimp [q_N, p, Δ_N]
      calc (C₀ + B₀ * Real.cos (2 * θ) + D₀ * Real.sin (2 * θ)) ^ 2 +
            2 * (C₀ - (C₀ + B₀ * Real.cos (2 * θ) + D₀ * Real.sin (2 * θ))) *
              (C₀ + B₀ * Real.cos (2 * θ) + D₀ * Real.sin (2 * θ)) -
            (-B₀ * Real.sin (2 * θ) + D₀ * Real.cos (2 * θ)) ^ 2
          = C₀ ^ 2 - (B₀ ^ 2 + D₀ ^ 2) * (Real.cos (2 * θ) ^ 2 + Real.sin (2 * θ) ^ 2) := by ring
        _ = C₀ ^ 2 - B₀ ^ 2 - D₀ ^ 2 := by rw [htrig]; ring
    rw [hstep1, hstep2]
    dsimp [α]
    exact div_mul_cancel₀ L.c hΔ_ne
  have h_harm_eq : ∀ θ : ℝ, L.h θ + deriv (deriv L.h) θ = h_E θ + ddh_E θ := by
    intro θ
    have hs3_pos : 0 < (Real.sqrt (q_N θ)) ^ 3 := pow_pos (Real.sqrt_pos.mpr (hq_pos θ)) 3
    have heq : (L.h θ + deriv (deriv L.h) θ) * (Real.sqrt (q_N θ)) ^ 3 =
        (h_E θ + ddh_E θ) * (Real.sqrt (q_N θ)) ^ 3 := by
      rw [h_ode θ, hhE_ode θ]
    exact mul_right_cancel₀ (ne_of_gt hs3_pos) heq

  have hh_diff : Differentiable ℝ L.h := L.h_smooth.differentiable (by simp)
  have hdh_diff : Differentiable ℝ (deriv L.h) :=
    (L.h_smooth.of_le (by simp : (1 + 1 : WithTop ℕ∞) ≤ ∞)).deriv'.differentiable_one
  let u : ℝ → ℝ := fun θ => L.h θ - h_E θ
  let du : ℝ → ℝ := fun θ => deriv L.h θ - dh_E θ
  let ddu : ℝ → ℝ := fun θ => deriv (deriv L.h) θ - ddh_E θ
  have hu_deriv : ∀ θ : ℝ, HasDerivAt u (du θ) θ :=
    fun θ => (hh_diff θ).hasDerivAt.sub (hhE_deriv₁ θ)
  have hdu_deriv : ∀ θ : ℝ, HasDerivAt du (ddu θ) θ :=
    fun θ => (hdh_diff θ).hasDerivAt.sub (hhE_deriv₂ θ)
  have hu_osc : ∀ θ : ℝ, u θ + ddu θ = 0 := by
    intro θ
    dsimp [u, ddu]
    linarith [h_harm_eq θ]
  let I₁ : ℝ → ℝ := fun θ => u θ * Real.cos θ - du θ * Real.sin θ
  let I₂ : ℝ → ℝ := fun θ => u θ * Real.sin θ + du θ * Real.cos θ
  have hI₁_deriv : ∀ θ : ℝ, HasDerivAt I₁ 0 θ := by
    intro θ
    have h1 := (hu_deriv θ).mul (Real.hasDerivAt_cos θ)
    have h2 := (hdu_deriv θ).mul (Real.hasDerivAt_sin θ)
    have hsub := h1.sub h2
    convert hsub using 1
    calc (0 : ℝ) = -(u θ + ddu θ) * Real.sin θ := by rw [hu_osc θ]; ring
      _ = (du θ * Real.cos θ + u θ * -Real.sin θ) - (ddu θ * Real.sin θ + du θ * Real.cos θ) := by ring
  have hI₂_deriv : ∀ θ : ℝ, HasDerivAt I₂ 0 θ := by
    intro θ
    have h1 := (hu_deriv θ).mul (Real.hasDerivAt_sin θ)
    have h2 := (hdu_deriv θ).mul (Real.hasDerivAt_cos θ)
    have hadd := h1.add h2
    convert hadd using 1
    calc (0 : ℝ) = (u θ + ddu θ) * Real.cos θ := by rw [hu_osc θ]; ring
      _ = (du θ * Real.sin θ + u θ * Real.cos θ) + (ddu θ * Real.cos θ + du θ * -Real.sin θ) := by ring
  have hI₁_const : ∀ θ : ℝ, I₁ θ = I₁ 0 := fun θ =>
    is_const_of_deriv_eq_zero (fun t => (hI₁_deriv t).differentiableAt)
      (fun t => (hI₁_deriv t).deriv) θ 0
  have hI₂_const : ∀ θ : ℝ, I₂ θ = I₂ 0 := fun θ =>
    is_const_of_deriv_eq_zero (fun t => (hI₂_deriv t).differentiableAt)
      (fun t => (hI₂_deriv t).deriv) θ 0
  let c₁ : ℝ := I₁ 0
  let c₂ : ℝ := I₂ 0
  have hh_formula : ∀ θ : ℝ, L.h θ = c₁ * Real.cos θ + c₂ * Real.sin θ + h_E θ := by
    intro θ
    have hu_eq : u θ = c₁ * Real.cos θ + c₂ * Real.sin θ := by
      calc u θ = u θ * (Real.cos θ ^ 2 + Real.sin θ ^ 2) := by rw [Real.cos_sq_add_sin_sq]; ring
        _ = I₁ θ * Real.cos θ + I₂ θ * Real.sin θ := by dsimp [I₁, I₂]; ring
        _ = c₁ * Real.cos θ + c₂ * Real.sin θ := by rw [hI₁_const θ, hI₂_const θ]
    dsimp [u] at hu_eq
    linarith
  have hdh_formula : ∀ θ : ℝ, deriv L.h θ = -c₁ * Real.sin θ + c₂ * Real.cos θ + dh_E θ := by
    intro θ
    have hdu_eq : du θ = -c₁ * Real.sin θ + c₂ * Real.cos θ := by
      calc du θ = du θ * (Real.cos θ ^ 2 + Real.sin θ ^ 2) := by rw [Real.cos_sq_add_sin_sq]; ring
        _ = -I₁ θ * Real.sin θ + I₂ θ * Real.cos θ := by dsimp [I₁, I₂]; ring
        _ = -c₁ * Real.sin θ + c₂ * Real.cos θ := by rw [hI₁_const θ, hI₂_const θ]
    dsimp [du] at hdu_eq
    linarith

  
  let c_shift : Plane := (WithLp.equiv 2 (Fin 2 → ℝ)).symm ![c₁, c₂]
  let c_ell : Plane := L.c₀ + c_shift
  let β : ℝ := (α ^ 2 * Δ_N)⁻¹
  have hβ_pos : 0 < β := inv_pos.mpr (mul_pos (sq_pos_of_pos hα_pos) hΔ_pos)
  have hβαΔ : β * α ^ 2 * Δ_N = 1 := by
    dsimp [β]
    have hne : α ^ 2 * Δ_N ≠ 0 := ne_of_gt (mul_pos (sq_pos_of_pos hα_pos) hΔ_pos)
    field_simp [hne]
  let Q : Matrix (Fin 2) (Fin 2) ℝ :=
    !![β * (C₀ - B₀), -β * D₀; -β * D₀, β * (C₀ + B₀)]
  have hQ_symm : Q.IsSymm := by
    rw [Matrix.IsSymm.ext_iff]
    intro i j
    fin_cases i <;> fin_cases j <;> simp [Q]
  have hQ_herm : Q.IsHermitian := by
    apply Matrix.IsHermitian.ext
    intro i j
    fin_cases i <;> fin_cases j <;> simp [Q]
  have hCB_pos : 0 < C₀ - B₀ := by
    have h := hq_pos (Real.pi / 2)
    dsimp [q_N] at h
    have h2 : 2 * (Real.pi / 2) = Real.pi := by ring
    rw [h2, Real.cos_pi, Real.sin_pi] at h
    linarith
  have hQ_quad : ∀ v : Fin 2 → ℝ,
      v ⬝ᵥ Q.mulVec v =
        β * ((C₀ - B₀) * v 0 ^ 2 - 2 * D₀ * v 0 * v 1 + (C₀ + B₀) * v 1 ^ 2) := by
    intro v
    simp [Q, Matrix.mulVec, dotProduct, Fin.sum_univ_two]
    ring
  have hQ_posDef : Q.PosDef := by
    apply Matrix.PosDef.of_dotProduct_mulVec_pos hQ_herm
    intro v hv
    have hstar : star v = v := by ext i; simp
    rw [hstar, hQ_quad v]
    have hv_nz : v 0 ≠ 0 ∨ v 1 ≠ 0 := by
      by_contra h0
      push_neg at h0
      apply hv
      ext i
      fin_cases i
      · exact h0.1
      · exact h0.2
    have hsq_id : (C₀ - B₀) * ((C₀ - B₀) * v 0 ^ 2 - 2 * D₀ * v 0 * v 1 + (C₀ + B₀) * v 1 ^ 2) =
        ((C₀ - B₀) * v 0 - D₀ * v 1) ^ 2 + Δ_N * v 1 ^ 2 := by
      dsimp [Δ_N]
      ring
    have hrhs_pos : 0 < ((C₀ - B₀) * v 0 - D₀ * v 1) ^ 2 + Δ_N * v 1 ^ 2 := by
      by_cases hv1 : v 1 = 0
      · rw [hv1]
        have hv0 : v 0 ≠ 0 := hv_nz.resolve_right (not_not.mpr hv1)
        have hprod : (C₀ - B₀) * v 0 ≠ 0 := mul_ne_zero (ne_of_gt hCB_pos) hv0
        have hsq_pos : 0 < ((C₀ - B₀) * v 0) ^ 2 := sq_pos_of_ne_zero hprod
        linarith
      · have hv1_sq : 0 < v 1 ^ 2 := sq_pos_of_ne_zero hv1
        have h1 : 0 ≤ ((C₀ - B₀) * v 0 - D₀ * v 1) ^ 2 := sq_nonneg _
        nlinarith
    have hinner_pos : 0 < (C₀ - B₀) * v 0 ^ 2 - 2 * D₀ * v 0 * v 1 + (C₀ + B₀) * v 1 ^ 2 := by
      nlinarith
    exact mul_pos hβ_pos hinner_pos

  let γ : ℝ → Plane :=
    fun θ => L.c₀ + L.h θ • unitNormalVec θ + deriv L.h θ • unitTangentVec θ
  have hγ_coord0 : ∀ θ : ℝ,
      Real.sqrt (q_N θ) * (γ θ - c_ell).ofLp 0 =
        α * ((C₀ + B₀) * Real.cos θ + D₀ * Real.sin θ) := by
    intro θ
    set s := Real.sqrt (q_N θ)
    have hs_ne : s ≠ 0 := ne_of_gt (Real.sqrt_pos.mpr (hq_pos θ))
    have hs_sq : s ^ 2 = q_N θ := Real.sq_sqrt (le_of_lt (hq_pos θ))
    have hcoord : (γ θ - c_ell).ofLp 0 = h_E θ * Real.cos θ - dh_E θ * Real.sin θ := by
      simp [γ, c_ell, c_shift, unitNormalVec, unitTangentVec]
      rw [hh_formula θ, hdh_formula θ]
      linear_combination c₁ * Real.cos_sq_add_sin_sq θ
    rw [hcoord]
    have h1 : s * (h_E θ * Real.cos θ - dh_E θ * Real.sin θ) =
        α * (q_N θ * Real.cos θ - p θ * Real.sin θ) := by
      dsimp [h_E, dh_E]
      change s * (α * s * Real.cos θ - α * (p θ / s) * Real.sin θ) =
        α * (q_N θ * Real.cos θ - p θ * Real.sin θ)
      rw [← hs_sq]
      field_simp [hs_ne]
    rw [h1]
    dsimp [q_N, p]
    rw [Real.cos_two_mul', Real.sin_two_mul]
    calc α * ((C₀ + B₀ * (Real.cos θ ^ 2 - Real.sin θ ^ 2) +
            D₀ * (2 * Real.sin θ * Real.cos θ)) * Real.cos θ -
            (-B₀ * (2 * Real.sin θ * Real.cos θ) +
            D₀ * (Real.cos θ ^ 2 - Real.sin θ ^ 2)) * Real.sin θ)
        = α * (C₀ * Real.cos θ + (B₀ * Real.cos θ + D₀ * Real.sin θ) *
            (Real.cos θ ^ 2 + Real.sin θ ^ 2)) := by ring
      _ = α * ((C₀ + B₀) * Real.cos θ + D₀ * Real.sin θ) := by rw [Real.cos_sq_add_sin_sq]; ring

  have hγ_coord1 : ∀ θ : ℝ,
      Real.sqrt (q_N θ) * (γ θ - c_ell).ofLp 1 =
        α * (D₀ * Real.cos θ + (C₀ - B₀) * Real.sin θ) := by
    intro θ
    set s := Real.sqrt (q_N θ)
    have hs_ne : s ≠ 0 := ne_of_gt (Real.sqrt_pos.mpr (hq_pos θ))
    have hs_sq : s ^ 2 = q_N θ := Real.sq_sqrt (le_of_lt (hq_pos θ))
    have hcoord : (γ θ - c_ell).ofLp 1 = h_E θ * Real.sin θ + dh_E θ * Real.cos θ := by
      simp [γ, c_ell, c_shift, unitNormalVec, unitTangentVec]
      rw [hh_formula θ, hdh_formula θ]
      linear_combination c₂ * Real.cos_sq_add_sin_sq θ
    rw [hcoord]
    have h1 : s * (h_E θ * Real.sin θ + dh_E θ * Real.cos θ) =
        α * (q_N θ * Real.sin θ + p θ * Real.cos θ) := by
      dsimp [h_E, dh_E]
      change s * (α * s * Real.sin θ + α * (p θ / s) * Real.cos θ) =
        α * (q_N θ * Real.sin θ + p θ * Real.cos θ)
      rw [← hs_sq]
      field_simp [hs_ne]
    rw [h1]
    dsimp [q_N, p]
    rw [Real.cos_two_mul', Real.sin_two_mul]
    calc α * ((C₀ + B₀ * (Real.cos θ ^ 2 - Real.sin θ ^ 2) +
            D₀ * (2 * Real.sin θ * Real.cos θ)) * Real.sin θ +
            (-B₀ * (2 * Real.sin θ * Real.cos θ) +
            D₀ * (Real.cos θ ^ 2 - Real.sin θ ^ 2)) * Real.cos θ)
        = α * (C₀ * Real.sin θ + (D₀ * Real.cos θ - B₀ * Real.sin θ) *
            (Real.cos θ ^ 2 + Real.sin θ ^ 2)) := by ring
      _ = α * (D₀ * Real.cos θ + (C₀ - B₀) * Real.sin θ) := by rw [Real.cos_sq_add_sin_sq]; ring

  have hq_expand : ∀ θ : ℝ, q_N θ =
      (C₀ + B₀) * Real.cos θ ^ 2 + 2 * D₀ * Real.sin θ * Real.cos θ +
        (C₀ - B₀) * Real.sin θ ^ 2 := by
    intro θ
    dsimp [q_N]
    rw [Real.cos_two_mul', Real.sin_two_mul]
    calc C₀ + B₀ * (Real.cos θ ^ 2 - Real.sin θ ^ 2) + D₀ * (2 * Real.sin θ * Real.cos θ)
        = C₀ * 1 + B₀ * (Real.cos θ ^ 2 - Real.sin θ ^ 2) +
            D₀ * (2 * Real.sin θ * Real.cos θ) := by ring
      _ = C₀ * (Real.cos θ ^ 2 + Real.sin θ ^ 2) + B₀ * (Real.cos θ ^ 2 - Real.sin θ ^ 2) +
            D₀ * (2 * Real.sin θ * Real.cos θ) := by rw [← Real.cos_sq_add_sin_sq θ]
      _ = (C₀ + B₀) * Real.cos θ ^ 2 + 2 * D₀ * Real.sin θ * Real.cos θ +
            (C₀ - B₀) * Real.sin θ ^ 2 := by ring

  let F : Plane → ℝ := fun x => (x - c_ell).ofLp ⬝ᵥ Q.mulVec (x - c_ell).ofLp
  have h_front_F : frontier Ω = { x : Plane | F x = 1 } := by
    rw [L.frontier_eq]
    change Set.range γ = { x : Plane | F x = 1 }
    ext x
    simp only [Set.mem_range, Set.mem_setOf_eq]
    constructor
    · rintro ⟨θ, rfl⟩
      set s := Real.sqrt (q_N θ)
      have hs_pos : 0 < s := Real.sqrt_pos.mpr (hq_pos θ)
      have hs2_ne : s ^ 2 ≠ 0 := ne_of_gt (sq_pos_of_pos hs_pos)
      have hs_sq : s ^ 2 = q_N θ := Real.sq_sqrt (le_of_lt (hq_pos θ))
      have h0 : s * (γ θ - c_ell).ofLp 0 = α * ((C₀ + B₀) * Real.cos θ + D₀ * Real.sin θ) :=
        hγ_coord0 θ
      have h1 : s * (γ θ - c_ell).ofLp 1 = α * (D₀ * Real.cos θ + (C₀ - B₀) * Real.sin θ) :=
        hγ_coord1 θ
      have hs2F : s ^ 2 * F (γ θ) = s ^ 2 * 1 := by
        change s ^ 2 * ((γ θ - c_ell).ofLp ⬝ᵥ Q.mulVec (γ θ - c_ell).ofLp) = s ^ 2 * 1
        rw [hQ_quad ((γ θ - c_ell).ofLp)]
        calc s ^ 2 * (β * ((C₀ - B₀) * (γ θ - c_ell).ofLp 0 ^ 2 -
              2 * D₀ * (γ θ - c_ell).ofLp 0 * (γ θ - c_ell).ofLp 1 +
              (C₀ + B₀) * (γ θ - c_ell).ofLp 1 ^ 2))
            = β * ((C₀ - B₀) * (s * (γ θ - c_ell).ofLp 0) ^ 2 -
              2 * D₀ * (s * (γ θ - c_ell).ofLp 0) * (s * (γ θ - c_ell).ofLp 1) +
              (C₀ + B₀) * (s * (γ θ - c_ell).ofLp 1) ^ 2) := by ring
          _ = β * ((C₀ - B₀) * (α * ((C₀ + B₀) * Real.cos θ + D₀ * Real.sin θ)) ^ 2 -
              2 * D₀ * (α * ((C₀ + B₀) * Real.cos θ + D₀ * Real.sin θ)) *
                (α * (D₀ * Real.cos θ + (C₀ - B₀) * Real.sin θ)) +
              (C₀ + B₀) * (α * (D₀ * Real.cos θ + (C₀ - B₀) * Real.sin θ)) ^ 2) := by rw [h0, h1]
          _ = (β * α ^ 2 * Δ_N) *
              ((C₀ + B₀) * Real.cos θ ^ 2 + 2 * D₀ * Real.sin θ * Real.cos θ +
                (C₀ - B₀) * Real.sin θ ^ 2) := by dsimp [Δ_N]; ring
          _ = q_N θ := by rw [hβαΔ, ← hq_expand θ]; ring
          _ = s ^ 2 * 1 := by rw [hs_sq]; ring
      exact mul_left_cancel₀ hs2_ne hs2F
    · intro hxF
      set u := (x - c_ell).ofLp
      let v : Fin 2 → ℝ := Q.mulVec u
      have hv0_def : v 0 = β * (C₀ - B₀) * u 0 - β * D₀ * u 1 := by
        simp [v, Q, Matrix.mulVec, dotProduct, Fin.sum_univ_two]
        ring
      have hv1_def : v 1 = -β * D₀ * u 0 + β * (C₀ + B₀) * u 1 := by
        simp [v, Q, Matrix.mulVec, dotProduct, Fin.sum_univ_two]
      have huv : u 0 * v 0 + u 1 * v 1 = 1 := by
        simpa [F, u, v, dotProduct, Fin.sum_univ_two] using hxF
      have hv_nz : v 0 ≠ 0 ∨ v 1 ≠ 0 := by
        by_contra h0
        push_neg at h0
        rw [h0.1, h0.2] at huv
        norm_num at huv
      obtain ⟨r, θ, hr_pos, _, hv0, hv1⟩ := polar_rep (v 0) (v 1) hv_nz
      have hu0 : u 0 = α ^ 2 * r * ((C₀ + B₀) * Real.cos θ + D₀ * Real.sin θ) := by
        calc u 0 = (β * α ^ 2 * Δ_N) * u 0 := by rw [hβαΔ]; ring
          _ = α ^ 2 * ((C₀ + B₀) * (β * (C₀ - B₀) * u 0 - β * D₀ * u 1) +
              D₀ * (-β * D₀ * u 0 + β * (C₀ + B₀) * u 1)) := by dsimp [Δ_N]; ring
          _ = α ^ 2 * ((C₀ + B₀) * v 0 + D₀ * v 1) := by rw [← hv0_def, ← hv1_def]
          _ = α ^ 2 * r * ((C₀ + B₀) * Real.cos θ + D₀ * Real.sin θ) := by rw [hv0, hv1]; ring
      have hu1 : u 1 = α ^ 2 * r * (D₀ * Real.cos θ + (C₀ - B₀) * Real.sin θ) := by
        calc u 1 = (β * α ^ 2 * Δ_N) * u 1 := by rw [hβαΔ]; ring
          _ = α ^ 2 * (D₀ * (β * (C₀ - B₀) * u 0 - β * D₀ * u 1) +
              (C₀ - B₀) * (-β * D₀ * u 0 + β * (C₀ + B₀) * u 1)) := by dsimp [Δ_N]; ring
          _ = α ^ 2 * (D₀ * v 0 + (C₀ - B₀) * v 1) := by rw [← hv0_def, ← hv1_def]
          _ = α ^ 2 * r * (D₀ * Real.cos θ + (C₀ - B₀) * Real.sin θ) := by rw [hv0, hv1]; ring
      set s := Real.sqrt (q_N θ)
      have hs_pos : 0 < s := Real.sqrt_pos.mpr (hq_pos θ)
      have hs_ne : s ≠ 0 := ne_of_gt hs_pos
      have hs_sq : s ^ 2 = q_N θ := Real.sq_sqrt (le_of_lt (hq_pos θ))
      have hars_sq : (α * r * s) ^ 2 = 1 := by
        calc (α * r * s) ^ 2 = α ^ 2 * r ^ 2 * s ^ 2 := by ring
          _ = α ^ 2 * r ^ 2 * q_N θ := by rw [hs_sq]
          _ = α ^ 2 * r ^ 2 *
              ((C₀ + B₀) * Real.cos θ ^ 2 + 2 * D₀ * Real.sin θ * Real.cos θ +
                (C₀ - B₀) * Real.sin θ ^ 2) := by rw [hq_expand θ]
          _ = (α ^ 2 * r * ((C₀ + B₀) * Real.cos θ + D₀ * Real.sin θ)) * (r * Real.cos θ) +
              (α ^ 2 * r * (D₀ * Real.cos θ + (C₀ - B₀) * Real.sin θ)) * (r * Real.sin θ) := by ring
          _ = u 0 * v 0 + u 1 * v 1 := by rw [← hu0, ← hu1, ← hv0, ← hv1]
          _ = 1 := huv
      have hars_pos : 0 < α * r * s := mul_pos (mul_pos hα_pos hr_pos) hs_pos
      have hars : α * r * s = 1 := by nlinarith
      have hsu0 : s * u 0 = s * (γ θ - c_ell).ofLp 0 := by
        rw [hu0, hγ_coord0 θ]
        calc s * (α ^ 2 * r * ((C₀ + B₀) * Real.cos θ + D₀ * Real.sin θ))
            = (α * r * s) * (α * ((C₀ + B₀) * Real.cos θ + D₀ * Real.sin θ)) := by ring
          _ = α * ((C₀ + B₀) * Real.cos θ + D₀ * Real.sin θ) := by rw [hars]; ring
      have hsu1 : s * u 1 = s * (γ θ - c_ell).ofLp 1 := by
        rw [hu1, hγ_coord1 θ]
        calc s * (α ^ 2 * r * (D₀ * Real.cos θ + (C₀ - B₀) * Real.sin θ))
            = (α * r * s) * (α * (D₀ * Real.cos θ + (C₀ - B₀) * Real.sin θ)) := by ring
          _ = α * (D₀ * Real.cos θ + (C₀ - B₀) * Real.sin θ) := by rw [hars]; ring
      have hsub_eq : γ θ - c_ell = x - c_ell := by
        ext i
        fin_cases i
        · exact (mul_left_cancel₀ hs_ne hsu0).symm
        · exact (mul_left_cancel₀ hs_ne hsu1).symm
      exact ⟨θ, sub_left_injective hsub_eq⟩

  
  have hF_center : F c_ell = 0 := by
    simp [F]
  have hF_ray : ∀ (t : ℝ) (w : Plane),
      F (c_ell + t • w) = t ^ 2 * (w.ofLp ⬝ᵥ Q.mulVec w.ofLp) := by
    intro t w
    have hsub : c_ell + t • w - c_ell = t • w := add_sub_cancel_left c_ell (t • w)
    change (c_ell + t • w - c_ell).ofLp ⬝ᵥ Q.mulVec (c_ell + t • w - c_ell).ofLp =
      t ^ 2 * (w.ofLp ⬝ᵥ Q.mulVec w.ofLp)
    rw [hsub]
    have hl : (t • w).ofLp = t • w.ofLp := rfl
    rw [hl, Matrix.mulVec_smul, smul_dotProduct, dotProduct_smul, smul_eq_mul, smul_eq_mul]
    ring
  have hF_pos : ∀ x : Plane, x ≠ c_ell → 0 < F x := by
    intro x hx
    have hne : (x - c_ell).ofLp ≠ 0 := by
      intro h0
      apply hx
      have hsub0 : x - c_ell = 0 := by
        ext i
        exact congr_fun h0 i
      exact sub_eq_zero.mp hsub0
    have hp := hQ_posDef.dotProduct_mulVec_pos hne
    have hstar : star (x - c_ell).ofLp = (x - c_ell).ofLp := by ext i; simp
    rwa [hstar] at hp

  have hc_ell_mem : c_ell ∈ Ω := by
    let e₁ : Plane := (WithLp.equiv 2 (Fin 2 → ℝ)).symm ![1, 0]
    have hm_eq : e₁.ofLp ⬝ᵥ Q.mulVec e₁.ofLp = β * (C₀ - B₀) := by
      rw [hQ_quad e₁.ofLp]
      simp [e₁]
    have hm_pos : 0 < e₁.ofLp ⬝ᵥ Q.mulVec e₁.ofLp := by
      rw [hm_eq]
      exact mul_pos hβ_pos hCB_pos
    set m := e₁.ofLp ⬝ᵥ Q.mulVec e₁.ofLp
    let t₀ : ℝ := (Real.sqrt m)⁻¹
    have hsqrt_pos : 0 < Real.sqrt m := Real.sqrt_pos.mpr hm_pos
    have ht₀_pos : 0 < t₀ := inv_pos.mpr hsqrt_pos
    have ht₀_sq : t₀ ^ 2 * m = 1 := by
      dsimp [t₀]
      have hne : Real.sqrt m ≠ 0 := ne_of_gt hsqrt_pos
      have hsq : (Real.sqrt m) ^ 2 = m := Real.sq_sqrt (le_of_lt hm_pos)
      field_simp [hne]
      exact hsq.symm
    let p_pos : Plane := c_ell + t₀ • e₁
    let p_neg : Plane := c_ell + (-t₀) • e₁
    have hp_pos_cl : p_pos ∈ closure Ω := by
      apply frontier_subset_closure
      rw [h_front_F]
      rw [Set.mem_setOf_eq, hF_ray t₀ e₁]
      exact ht₀_sq
    have hp_neg_cl : p_neg ∈ closure Ω := by
      apply frontier_subset_closure
      rw [h_front_F]
      rw [Set.mem_setOf_eq, hF_ray (-t₀) e₁, neg_sq]
      exact ht₀_sq
    have hp_ne : p_pos ≠ p_neg := by
      intro heq
      have h0 : (p_pos - p_neg).ofLp 0 = 0 := by rw [heq]; simp
      have hcalc : (p_pos - p_neg).ofLp 0 = 2 * t₀ := by
        simp [p_pos, p_neg, e₁]
        ring
      linarith
    have hc_seg : c_ell ∈ openSegment ℝ p_pos p_neg := by
      refine ⟨1 / 2, 1 / 2, by norm_num, by norm_num, by norm_num, ?_⟩
      dsimp [p_pos, p_neg]
      module
    exact hΩ.domain.openSegment_subset p_pos hp_pos_cl p_neg hp_neg_cl hp_ne hc_seg

  have h_not_front_of_mem : ∀ y ∈ Ω, y ∉ frontier Ω := by
    intro y hy hy_front
    have hint : y ∈ interior Ω := by
      rwa [hΩ.domain.isOpen.interior_eq]
    exact hy_front.2 hint

  have hΩ_eq : Ω = { x : Plane | F x < 1 } := by
    ext x
    simp only [Set.mem_setOf_eq]
    constructor
    · intro hx
      by_contra hge
      push_neg at hge
      have hFx_nonneg : 0 ≤ F x := by linarith
      let r : ℝ := Real.sqrt (F x)
      have hr_nonneg : 0 ≤ r := Real.sqrt_nonneg (F x)
      have hr_sq : r ^ 2 = F x := Real.sq_sqrt hFx_nonneg
      have hr_ge_one : 1 ≤ r := by nlinarith
      have hr_ne : r ≠ 0 := by linarith
      let s : ℝ := r⁻¹
      have hs_pos : 0 < s := inv_pos.mpr (by linarith)
      have hs_le_one : s ≤ 1 := inv_le_one_of_one_le₀ hr_ge_one
      let y : Plane := (1 - s) • c_ell + s • x
      have hy_mem : y ∈ Ω :=
        hΩ.domain.convex hc_ell_mem hx (by linarith) (le_of_lt hs_pos) (by ring)
      have hy_eq : y = c_ell + s • (x - c_ell) := by
        dsimp [y]
        module
      have hy_F : F y = 1 := by
        rw [hy_eq, hF_ray s (x - c_ell)]
        change (r⁻¹) ^ 2 * F x = 1
        rw [← hr_sq]
        calc (r⁻¹) ^ 2 * r ^ 2 = (r * r⁻¹) ^ 2 := by ring
          _ = 1 := by rw [mul_inv_cancel₀ hr_ne]; norm_num
      have hy_front : y ∈ frontier Ω := by
        rw [h_front_F]
        exact hy_F
      exact h_not_front_of_mem y hy_mem hy_front
    · intro hx
      by_cases hxc : x = c_ell
      · rwa [hxc]
      · have hFx_pos : 0 < F x := hF_pos x hxc
        let r : ℝ := Real.sqrt (F x)
        have hr_pos : 0 < r := Real.sqrt_pos.mpr hFx_pos
        have hr_ne : r ≠ 0 := ne_of_gt hr_pos
        have hr_sq : r ^ 2 = F x := Real.sq_sqrt (le_of_lt hFx_pos)
        have hr_lt_one : r < 1 := by nlinarith
        let y : Plane := c_ell + r⁻¹ • (x - c_ell)
        have hy_F : F y = 1 := by
          rw [hF_ray r⁻¹ (x - c_ell)]
          change (r⁻¹) ^ 2 * F x = 1
          rw [← hr_sq]
          calc (r⁻¹) ^ 2 * r ^ 2 = (r * r⁻¹) ^ 2 := by ring
            _ = 1 := by rw [mul_inv_cancel₀ hr_ne]; norm_num
        have hy_cl : y ∈ closure Ω := by
          apply frontier_subset_closure
          rw [h_front_F]
          exact hy_F
        have hc_cl : c_ell ∈ closure Ω := subset_closure hc_ell_mem
        have hcy_ne : c_ell ≠ y := by
          intro heq
          have h0 : F c_ell = F y := congr_arg F heq
          rw [hF_center, hy_F] at h0
          norm_num at h0
        have hx_seg : x ∈ openSegment ℝ c_ell y := by
          refine ⟨1 - r, r, by linarith, hr_pos, by ring, ?_⟩
          have hry : r • y = r • c_ell + x - c_ell := by
            calc r • (c_ell + r⁻¹ • (x - c_ell))
                = r • c_ell + (r * r⁻¹) • (x - c_ell) := by rw [smul_add, smul_smul]
              _ = r • c_ell + (1 : ℝ) • (x - c_ell) := by rw [mul_inv_cancel₀ hr_ne]
              _ = r • c_ell + x - c_ell := by module
          calc (1 - r) • c_ell + r • y
              = (1 - r) • c_ell + (r • c_ell + x - c_ell) := by rw [hry]
            _ = x := by module
        exact hΩ.domain.openSegment_subset c_ell hc_cl y hy_cl hcy_ne hx_seg

  exact ⟨c_ell, Q, hQ_symm, hQ_posDef, hΩ_eq⟩

theorem support_lazutkin_boundary_package (Ω : Set Plane)
    (hΩ : IsSmoothPositivelyCurvedBilliardDomain Ω) :
    Nonempty (SupportBoundaryPackage Ω) :=
by
  
  have deriv_per_plane : ∀ (g : ℝ → Plane) (P : ℝ),
      Differentiable ℝ g → Function.Periodic g P → Function.Periodic (deriv g) P := by
    intro g P hg hper t
    have h1 : HasDerivAt (fun y => g (y + P)) (deriv g (t + P)) t := by
      convert (hg (t + P)).hasDerivAt.scomp t ((hasDerivAt_id t).add_const P) using 1 <;>
        simp [Function.comp_def]
    have h2 : HasDerivAt (fun y => g (y + P)) (deriv g t) t := by
      have heq : (fun y => g (y + P)) = g := funext hper
      rw [heq]
      exact (hg t).hasDerivAt
    exact h1.unique h2
  have deriv_per_real : ∀ (g : ℝ → ℝ) (P : ℝ),
      Differentiable ℝ g → Function.Periodic g P → Function.Periodic (deriv g) P := by
    intro g P hg hper t
    have h1 : HasDerivAt (fun y => g (y + P)) (deriv g (t + P)) t := by
      convert (hg (t + P)).hasDerivAt.comp t ((hasDerivAt_id t).add_const P) using 1 <;>
        simp [Function.comp_def]
    have h2 : HasDerivAt (fun y => g (y + P)) (deriv g t) t := by
      have heq : (fun y => g (y + P)) = g := funext hper
      rw [heq]
      exact (hg t).hasDerivAt
    exact h1.unique h2
  have smooth_primitive : ∀ (w : ℝ → ℝ) (y₀ a : ℝ),
      ContDiff ℝ ∞ w →
      let F : ℝ → ℝ := fun t => y₀ + a * ∫ η in (0 : ℝ)..t, w η
      ContDiff ℝ ∞ F ∧ ∀ t : ℝ, HasDerivAt F (a * w t) t := by
    intro w y₀ a hw
    dsimp only
    let F : ℝ → ℝ := fun t => y₀ + a * ∫ η in (0 : ℝ)..t, w η
    have hw_cont : Continuous w := hw.continuous
    have hF_deriv : ∀ t : ℝ, HasDerivAt F (a * w t) t := by
      intro t
      have hint : HasDerivAt (fun u => ∫ η in (0 : ℝ)..u, w η) (w t) t :=
        intervalIntegral.integral_hasDerivAt_right
          (hw_cont.intervalIntegrable 0 t)
          (hw_cont.stronglyMeasurableAtFilter MeasureTheory.volume (nhds t))
          hw_cont.continuousAt
      exact (hint.const_mul a).const_add y₀
    have hF_diff : Differentiable ℝ F := fun t => (hF_deriv t).differentiableAt
    have hderiv_eq : deriv F = fun t => a * w t := funext fun t => (hF_deriv t).deriv
    have hderiv_smooth : ContDiff ℝ ∞ (deriv F) := by
      rw [hderiv_eq]
      exact contDiff_const.mul hw
    have hF_smooth : ContDiff ℝ ∞ F := by
      rw [contDiff_infty]
      intro m
      have hm1 : ContDiff ℝ ((m : WithTop ℕ∞) + 1) F := by
        rw [contDiff_succ_iff_deriv]
        exact ⟨hF_diff, by simp, hderiv_smooth.of_le (by simp)⟩
      exact hm1.of_le (by simp)
    exact ⟨hF_smooth, hF_deriv⟩
  have smooth_quasiperiodic_inv : ∀ (f f' : ℝ → ℝ) (T₁ T₂ : ℝ),
      0 < T₁ → 0 < T₂ → ContDiff ℝ ∞ f →
      (∀ x : ℝ, HasDerivAt f (f' x) x) →
      (∀ x : ℝ, 0 < f' x) →
      (∀ x : ℝ, f (x + T₁) = f x + T₂) →
      ∃ g : ℝ → ℝ,
        ContDiff ℝ ∞ g ∧
        (∀ x : ℝ, g (f x) = x) ∧
        (∀ y : ℝ, f (g y) = y) ∧
        (∀ y : ℝ, HasDerivAt g (f' (g y))⁻¹ y) ∧
        (∀ y : ℝ, g (y + T₂) = g y + T₁) ∧
        (∀ (k : ℤ) (x : ℝ), f (x + (k : ℝ) * T₁) = f x + (k : ℝ) * T₂) := by
    intro f f' T₁ T₂ hT₁ hT₂ hf_smooth hf_deriv hf'_pos hf_qp
    have hf_deriv_eq : deriv f = f' := funext fun x => (hf_deriv x).deriv
    have hf_mono : StrictMono f := strictMono_of_deriv_pos (by rw [hf_deriv_eq]; exact hf'_pos)
    have hf_shift_nat : ∀ (n : ℕ) (x : ℝ), f (x + (n : ℝ) * T₁) = f x + (n : ℝ) * T₂ := by
      intro n
      induction n with
      | zero => intro x; simp
      | succ n ih =>
        intro x
        have heq : x + ((n + 1 : ℕ) : ℝ) * T₁ = (x + (n : ℝ) * T₁) + T₁ := by push_cast; ring
        rw [heq, hf_qp, ih x]
        push_cast; ring
    have hf_shift_int : ∀ (k : ℤ) (x : ℝ), f (x + (k : ℝ) * T₁) = f x + (k : ℝ) * T₂ := by
      intro k x
      rcases Int.eq_nat_or_neg k with ⟨n, rfl | rfl⟩
      · simpa using hf_shift_nat n x
      · have h1 := hf_shift_nat n (x - (n : ℝ) * T₁)
        have h2 : (x - (n : ℝ) * T₁) + (n : ℝ) * T₁ = x := by ring
        rw [h2] at h1
        have h3 : x + ((-(n : ℤ) : ℤ) : ℝ) * T₁ = x - (n : ℝ) * T₁ := by push_cast; ring
        rw [h3]
        push_cast
        linarith
    have hf_surj : Function.Surjective f := by
      intro y
      obtain ⟨N, hN⟩ := exists_nat_gt (|y - f 0| / T₂)
      have hN_nonneg : (0 : ℝ) ≤ (N : ℝ) := Nat.cast_nonneg N
      have hNT₂ : |y - f 0| < (N : ℝ) * T₂ := (div_lt_iff₀ hT₂).mp hN
      let a : ℝ := -((N : ℝ) * T₁)
      let b : ℝ := (N : ℝ) * T₁
      have hab : a ≤ b := by dsimp [a, b]; nlinarith
      have hlow : f a ≤ y := by
        have hsub := hf_shift_int (-(N : ℤ)) 0
        have ha_eq : (0 : ℝ) + ((-(N : ℤ) : ℤ) : ℝ) * T₁ = a := by dsimp [a]; push_cast; ring
        rw [ha_eq] at hsub
        push_cast at hsub
        linarith [neg_abs_le (y - f 0)]
      have hhigh : y ≤ f b := by
        have hadd := hf_shift_nat N 0
        have hb_eq : (0 : ℝ) + (N : ℝ) * T₁ = b := by dsimp [b]; ring
        rw [hb_eq] at hadd
        linarith [le_abs_self (y - f 0)]
      obtain ⟨x, _, hx⟩ := intermediate_value_Icc hab hf_smooth.continuous.continuousOn ⟨hlow, hhigh⟩
      exact ⟨x, hx⟩
    let f_iso : ℝ ≃o ℝ := StrictMono.orderIsoOfSurjective f hf_mono hf_surj
    let f_homeo : ℝ ≃ₜ ℝ := f_iso.toHomeomorph
    let g : ℝ → ℝ := f_homeo.symm
    have hg_left : ∀ x : ℝ, g (f x) = x := fun x => f_iso.symm_apply_apply x
    have hg_right : ∀ y : ℝ, f (g y) = y := fun y => f_iso.apply_symm_apply y
    have hg_smooth : ContDiff ℝ ∞ g :=
      f_homeo.contDiff_symm_deriv (fun x => ne_of_gt (hf'_pos x)) hf_deriv hf_smooth
    have hg_diff : Differentiable ℝ g := hg_smooth.differentiable (by simp)
    have hg_deriv : ∀ y : ℝ, HasDerivAt g (f' (g y))⁻¹ y := by
      intro y
      have hcomp : HasDerivAt (fun z => f (g z)) (f' (g y) * deriv g y) y :=
        (hf_deriv (g y)).comp y (hg_diff y).hasDerivAt
      have hid : HasDerivAt (fun z => f (g z)) 1 y := by
        have heq : (fun z => f (g z)) = id := funext hg_right
        rw [heq]
        exact hasDerivAt_id y
      have hmul : f' (g y) * deriv g y = 1 := hcomp.unique hid
      have h_eq : deriv g y = (f' (g y))⁻¹ := by
        have hne : f' (g y) ≠ 0 := ne_of_gt (hf'_pos (g y))
        exact eq_inv_of_mul_eq_one_right hmul
      rw [← h_eq]
      exact (hg_diff y).hasDerivAt
    have hg_qp : ∀ y : ℝ, g (y + T₂) = g y + T₁ := by
      intro y
      apply hf_mono.injective
      rw [hg_right, hf_qp, hg_right]
    exact ⟨g, hg_smooth, hg_left, hg_right, hg_deriv, hg_qp, hf_shift_int⟩

  
  have plane_inner : ∀ x y : Plane, inner ℝ x y = x 0 * y 0 + x 1 * y 1 := by
    intro x y
    rw [PiLp.inner_apply, Fin.sum_univ_two]
    simp [mul_comm]
  have plane_norm_sq : ∀ x : Plane, ‖x‖ ^ 2 = (x 0) ^ 2 + (x 1) ^ 2 := by
    intro x
    rw [PiLp.norm_sq_eq_of_L2, Fin.sum_univ_two]
    simp
  let e₀ : Plane := EuclideanSpace.single 0 1
  let e₁ : Plane := EuclideanSpace.single 1 1
  have hn_eq : ∀ ϑ : ℝ, unitNormalVec ϑ = Real.cos ϑ • e₀ + Real.sin ϑ • e₁ := by
    intro ϑ
    ext i
    fin_cases i <;> simp [unitNormalVec, e₀, e₁]
  have he_eq : ∀ ϑ : ℝ, unitTangentVec ϑ = (-Real.sin ϑ) • e₀ + Real.cos ϑ • e₁ := by
    intro ϑ
    ext i
    fin_cases i <;> simp [unitTangentVec, e₀, e₁]
  have hn_smooth : ContDiff ℝ ∞ unitNormalVec := by
    have heq : unitNormalVec = fun ϑ => Real.cos ϑ • e₀ + Real.sin ϑ • e₁ := funext hn_eq
    rw [heq]
    exact (Real.contDiff_cos.smul contDiff_const).add (Real.contDiff_sin.smul contDiff_const)
  have hn_deriv : ∀ ϑ : ℝ, HasDerivAt unitNormalVec (unitTangentVec ϑ) ϑ := by
    intro ϑ
    have heq : unitNormalVec = fun u => Real.cos u • e₀ + Real.sin u • e₁ := funext hn_eq
    rw [heq, he_eq ϑ]
    exact ((Real.hasDerivAt_cos ϑ).smul_const e₀).add ((Real.hasDerivAt_sin ϑ).smul_const e₁)
  have he_deriv : ∀ ϑ : ℝ, HasDerivAt unitTangentVec (-unitNormalVec ϑ) ϑ := by
    intro ϑ
    have heq : unitTangentVec = fun u => (-Real.sin u) • e₀ + Real.cos u • e₁ := funext he_eq
    rw [heq]
    have hneg : -unitNormalVec ϑ = (-Real.cos ϑ) • e₀ + (-Real.sin ϑ) • e₁ := by
      rw [hn_eq ϑ]; ext i; fin_cases i <;> simp [e₀, e₁]
    rw [hneg]
    exact (((Real.hasDerivAt_sin ϑ).neg).smul_const e₀).add ((Real.hasDerivAt_cos ϑ).smul_const e₁)
  have hn_norm : ∀ ϑ : ℝ, ‖unitNormalVec ϑ‖ = 1 := by
    intro ϑ
    have hsq : ‖unitNormalVec ϑ‖ ^ 2 = 1 := by
      rw [plane_norm_sq]
      simp [unitNormalVec, Real.cos_sq_add_sin_sq]
    nlinarith [norm_nonneg (unitNormalVec ϑ)]
  have hn_self : ∀ ϑ : ℝ, inner ℝ (unitNormalVec ϑ) (unitNormalVec ϑ) = 1 := by
    intro ϑ
    rw [plane_inner]
    simp [unitNormalVec]
    nlinarith [Real.cos_sq_add_sin_sq ϑ]
  have he_self : ∀ ϑ : ℝ, inner ℝ (unitTangentVec ϑ) (unitTangentVec ϑ) = 1 := by
    intro ϑ
    rw [plane_inner]
    simp [unitTangentVec]
    nlinarith [Real.cos_sq_add_sin_sq ϑ]
  have hne_orth : ∀ ϑ : ℝ, inner ℝ (unitNormalVec ϑ) (unitTangentVec ϑ) = 0 := by
    intro ϑ
    rw [plane_inner]
    simp [unitNormalVec, unitTangentVec]
    ring
  have hen_orth : ∀ ϑ : ℝ, inner ℝ (unitTangentVec ϑ) (unitNormalVec ϑ) = 0 := by
    intro ϑ
    rw [real_inner_comm]
    exact hne_orth ϑ
  have hframe_decomp : ∀ (ϑ : ℝ) (v : Plane),
      v = inner ℝ v (unitNormalVec ϑ) • unitNormalVec ϑ +
          inner ℝ v (unitTangentVec ϑ) • unitTangentVec ϑ := by
    intro ϑ v
    ext i
    have hcs := Real.cos_sq_add_sin_sq ϑ
    fin_cases i
    · simp [plane_inner, unitNormalVec, unitTangentVec]
      linear_combination -(v.ofLp 0) * hcs
    · simp [plane_inner, unitNormalVec, unitTangentVec]
      linear_combination -(v.ofLp 1) * hcs
  have hn_per : Function.Periodic unitNormalVec (2 * Real.pi) := by
    intro ϑ
    ext i
    fin_cases i <;> simp [unitNormalVec, Real.cos_add_two_pi, Real.sin_add_two_pi]
  have h2pi_pos : 0 < 2 * Real.pi := by linarith [Real.pi_gt_three]

  
  obtain ⟨c₀, hc₀⟩ := hΩ.domain.nonempty
  obtain ⟨ε_ball, hε_ball_pos, hball_sub⟩ := Metric.isOpen_iff.mp hΩ.domain.isOpen c₀ hc₀
  let r₀ : ℝ := ε_ball / 3
  have hr₀_pos : 0 < r₀ := by dsimp [r₀]; linarith
  have hclosedBall_sub : Metric.closedBall c₀ (2 * r₀) ⊆ Ω :=
    Set.Subset.trans (Metric.closedBall_subset_ball (by dsimp [r₀]; linarith)) hball_sub
  obtain ⟨γ, L, hγ, hκ⟩ := hΩ.boundary_smooth_pos_curvature

  
  let γ₁ : ℝ → Plane := deriv γ
  let γ₂ : ℝ → Plane := deriv γ₁
  have hγ_diff : Differentiable ℝ γ := hγ.smooth.differentiable (by simp)
  have hγ₁_smooth : ContDiff ℝ ∞ γ₁ := hγ.smooth.iterate_deriv 1
  have hγ₂_smooth : ContDiff ℝ ∞ γ₂ := hγ.smooth.iterate_deriv 2
  have hγ₁_diff : Differentiable ℝ γ₁ := hγ₁_smooth.differentiable (by simp)
  let proj₀ : Plane →L[ℝ] ℝ := EuclideanSpace.proj 0
  let proj₁ : Plane →L[ℝ] ℝ := EuclideanSpace.proj 1
  have hγ₁_coord_deriv : ∀ (i : Fin 2) (t : ℝ),
      HasDerivAt (fun u => γ₁ u i) (γ₂ t i) t := by
    intro i t
    exact (EuclideanSpace.proj i).hasFDerivAt.comp_hasDerivAt t (hγ₁_diff t).hasDerivAt
  have hγ₁₀_smooth : ContDiff ℝ ∞ (fun t => γ₁ t 0) := proj₀.contDiff.comp hγ₁_smooth
  have hγ₁₁_smooth : ContDiff ℝ ∞ (fun t => γ₁ t 1) := proj₁.contDiff.comp hγ₁_smooth
  have hγ₂₀_smooth : ContDiff ℝ ∞ (fun t => γ₂ t 0) := proj₀.contDiff.comp hγ₂_smooth
  have hγ₂₁_smooth : ContDiff ℝ ∞ (fun t => γ₂ t 1) := proj₁.contDiff.comp hγ₂_smooth

  let q : ℝ → ℝ := fun t => (γ₁ t 0) ^ 2 + (γ₁ t 1) ^ 2
  let s : ℝ → ℝ := fun t => ‖γ₁ t‖
  have hs_pos : ∀ t : ℝ, 0 < s t := fun t => norm_pos_iff.mpr (hγ.regular t)
  have hs_sq : ∀ t : ℝ, (s t) ^ 2 = q t := fun t => plane_norm_sq (γ₁ t)
  have hq_pos : ∀ t : ℝ, 0 < q t := by
    intro t; rw [← hs_sq t]; exact sq_pos_of_pos (hs_pos t)
  have hq_smooth : ContDiff ℝ ∞ q := (hγ₁₀_smooth.pow 2).add (hγ₁₁_smooth.pow 2)
  have hs_eq_sqrt : ∀ t : ℝ, s t = Real.sqrt (q t) := by
    intro t; rw [← hs_sq t, Real.sqrt_sq (norm_nonneg _)]
  let s_deriv_fn : ℝ → ℝ := fun t => (γ₁ t 0 * γ₂ t 0 + γ₁ t 1 * γ₂ t 1) / s t
  have hs_deriv : ∀ t : ℝ, HasDerivAt s (s_deriv_fn t) t := by
    intro t
    have hq_d : HasDerivAt q (2 * γ₁ t 0 * γ₂ t 0 + 2 * γ₁ t 1 * γ₂ t 1) t := by
      have h0 : HasDerivAt (fun u => (γ₁ u 0) ^ 2) (2 * γ₁ t 0 * γ₂ t 0) t := by
        convert (hγ₁_coord_deriv 0 t).pow 2 using 1
        simp [mul_assoc]
      have h1 : HasDerivAt (fun u => (γ₁ u 1) ^ 2) (2 * γ₁ t 1 * γ₂ t 1) t := by
        convert (hγ₁_coord_deriv 1 t).pow 2 using 1
        simp [mul_assoc]
      exact h0.add h1
    have hsqrt := hq_d.sqrt (ne_of_gt (hq_pos t))
    have heq : (fun u => Real.sqrt (q u)) = s := funext fun u => (hs_eq_sqrt u).symm
    rw [heq, ← hs_eq_sqrt t] at hsqrt
    convert hsqrt using 1
    dsimp [s_deriv_fn]
    have hs_ne : s t ≠ 0 := ne_of_gt (hs_pos t)
    field_simp

  let angRate : ℝ → ℝ := fun t => det2 (γ₁ t) (γ₂ t) / q t
  have hangRate_smooth : ContDiff ℝ ∞ angRate := by
    have hnum : ContDiff ℝ ∞ (fun t => det2 (γ₁ t) (γ₂ t)) :=
      (hγ₁₀_smooth.mul hγ₂₁_smooth).sub (hγ₁₁_smooth.mul hγ₂₀_smooth)
    exact hnum.div hq_smooth (fun t => ne_of_gt (hq_pos t))
  have hangRate_eq_curv : ∀ t : ℝ, angRate t = s t * signedCurvature γ t := by
    intro t
    dsimp [angRate, signedCurvature, γ₁, γ₂, s]
    have hs_ne : ‖deriv γ t‖ ≠ 0 := ne_of_gt (hs_pos t)
    have hq_eq : q t = ‖deriv γ t‖ ^ 2 := (hs_sq t).symm
    rw [hq_eq]
    field_simp
  have hangRate_pos : ∀ t : ℝ, 0 < angRate t := by
    intro t
    rw [hangRate_eq_curv t]
    exact mul_pos (hs_pos t) (hκ t)

  let v₀ : ℝ → ℝ := fun t => γ₁ t 0 / s t
  let v₁ : ℝ → ℝ := fun t => γ₁ t 1 / s t
  have hv_unit : ∀ t : ℝ, (v₀ t) ^ 2 + (v₁ t) ^ 2 = 1 := by
    intro t
    dsimp [v₀, v₁]
    have hs_ne : s t ≠ 0 := ne_of_gt (hs_pos t)
    have hsq := hs_sq t
    dsimp [q] at hsq
    field_simp
    linarith
  have hv₀_deriv : ∀ t : ℝ, HasDerivAt v₀ (-v₁ t * angRate t) t := by
    intro t
    have hd := (hγ₁_coord_deriv 0 t).div (hs_deriv t) (ne_of_gt (hs_pos t))
    convert hd using 1
    dsimp [v₁, angRate, det2, s_deriv_fn]
    rw [← hs_sq t]
    have hs_ne : s t ≠ 0 := ne_of_gt (hs_pos t)
    field_simp
    rw [hs_sq t]
    dsimp [q]
    ring
  have hv₁_deriv : ∀ t : ℝ, HasDerivAt v₁ (v₀ t * angRate t) t := by
    intro t
    have hd := (hγ₁_coord_deriv 1 t).div (hs_deriv t) (ne_of_gt (hs_pos t))
    convert hd using 1
    dsimp [v₀, angRate, det2, s_deriv_fn]
    rw [← hs_sq t]
    have hs_ne : s t ≠ 0 := ne_of_gt (hs_pos t)
    field_simp
    rw [hs_sq t]
    dsimp [q]
    ring

  let z₀ : ℂ := (v₁ 0 : ℂ) + ((-v₀ 0 : ℝ) : ℂ) * Complex.I
  let θ₀ : ℝ := Complex.arg z₀
  have hz₀_re : z₀.re = v₁ 0 := by simp [z₀]
  have hz₀_im : z₀.im = -v₀ 0 := by simp [z₀]
  have hz₀_norm : ‖z₀‖ = 1 := by
    have hnsq : Complex.normSq z₀ = 1 := by
      rw [Complex.normSq_apply, hz₀_re, hz₀_im]
      nlinarith [hv_unit 0]
    rw [Complex.norm_def, hnsq, Real.sqrt_one]
  have hcos_θ₀ : Real.cos θ₀ = v₁ 0 := by
    have h := Complex.norm_mul_cos_arg z₀
    rwa [hz₀_norm, one_mul, hz₀_re] at h
  have hsin_θ₀ : Real.sin θ₀ = -v₀ 0 := by
    have h := Complex.norm_mul_sin_arg z₀
    rwa [hz₀_norm, one_mul, hz₀_im] at h

  let θ : ℝ → ℝ := fun t => θ₀ + (1 : ℝ) * ∫ η in (0 : ℝ)..t, angRate η
  obtain ⟨hθ_smooth, hθ_deriv_raw⟩ := smooth_primitive angRate θ₀ 1 hangRate_smooth
  have hθ_deriv : ∀ t : ℝ, HasDerivAt θ (angRate t) t := by
    intro t; simpa [θ] using hθ_deriv_raw t

  let E_lyap : ℝ → ℝ := fun t => (v₀ t + Real.sin (θ t)) ^ 2 + (v₁ t - Real.cos (θ t)) ^ 2
  have hE_zero_at_0 : E_lyap 0 = 0 := by
    have hθ0 : θ 0 = θ₀ := by simp [θ]
    dsimp [E_lyap]
    rw [hθ0, hcos_θ₀, hsin_θ₀]
    ring
  have hE_deriv_zero : ∀ t : ℝ, HasDerivAt E_lyap 0 t := by
    intro t
    have hsin_d : HasDerivAt (fun u => Real.sin (θ u)) (Real.cos (θ t) * angRate t) t :=
      (Real.hasDerivAt_sin (θ t)).comp t (hθ_deriv t)
    have hcos_d : HasDerivAt (fun u => Real.cos (θ u)) (-Real.sin (θ t) * angRate t) t :=
      (Real.hasDerivAt_cos (θ t)).comp t (hθ_deriv t)
    have hd1 : HasDerivAt (fun u => (v₀ u + Real.sin (θ u)) ^ 2)
        (2 * (v₀ t + Real.sin (θ t)) * (-v₁ t * angRate t + Real.cos (θ t) * angRate t)) t := by
      convert ((hv₀_deriv t).add hsin_d).pow 2 using 1
      simp [mul_assoc]
    have hd2 : HasDerivAt (fun u => (v₁ u - Real.cos (θ u)) ^ 2)
        (2 * (v₁ t - Real.cos (θ t)) * (v₀ t * angRate t - (-Real.sin (θ t) * angRate t))) t := by
      convert ((hv₁_deriv t).sub hcos_d).pow 2 using 1
      simp [mul_assoc]
    convert hd1.add hd2 using 1
    ring
  have hE_all_zero : ∀ t : ℝ, E_lyap t = 0 := by
    intro t
    have hconst := is_const_of_deriv_eq_zero
      (fun u => (hE_deriv_zero u).differentiableAt)
      (fun u => (hE_deriv_zero u).deriv) t 0
    rw [hconst, hE_zero_at_0]
  have hγ₁_frenet : ∀ t : ℝ, γ₁ t = s t • unitTangentVec (θ t) := by
    intro t
    have hE := hE_all_zero t
    dsimp [E_lyap] at hE
    have hv₀_eq : v₀ t = -Real.sin (θ t) := by
      nlinarith [sq_nonneg (v₀ t + Real.sin (θ t)), sq_nonneg (v₁ t - Real.cos (θ t))]
    have hv₁_eq : v₁ t = Real.cos (θ t) := by
      nlinarith [sq_nonneg (v₀ t + Real.sin (θ t)), sq_nonneg (v₁ t - Real.cos (θ t))]
    have hs_ne : s t ≠ 0 := ne_of_gt (hs_pos t)
    have h0 : γ₁ t 0 = s t * (-Real.sin (θ t)) := by
      dsimp [v₀] at hv₀_eq
      exact (div_eq_iff hs_ne).mp hv₀_eq |>.trans (mul_comm _ _)
    have h1 : γ₁ t 1 = s t * Real.cos (θ t) := by
      dsimp [v₁] at hv₁_eq
      exact (div_eq_iff hs_ne).mp hv₁_eq |>.trans (mul_comm _ _)
    ext i
    fin_cases i
    · simpa [unitTangentVec] using h0
    · simpa [unitTangentVec] using h1
  have hγ₂_frenet : ∀ t : ℝ,
      γ₂ t = s_deriv_fn t • unitTangentVec (θ t) - (s t * angRate t) • unitNormalVec (θ t) := by
    intro t
    have he_comp : HasDerivAt (fun u => unitTangentVec (θ u)) (angRate t • (-unitNormalVec (θ t))) t :=
      (he_deriv (θ t)).scomp t (hθ_deriv t)
    have hrhs : HasDerivAt (fun u => s u • unitTangentVec (θ u))
        (s t • (angRate t • (-unitNormalVec (θ t))) + s_deriv_fn t • unitTangentVec (θ t)) t :=
      (hs_deriv t).smul he_comp
    have hlhs : HasDerivAt (fun u => s u • unitTangentVec (θ u)) (γ₂ t) t := by
      have heq : (fun u => s u • unitTangentVec (θ u)) = γ₁ := funext fun u => (hγ₁_frenet u).symm
      rw [heq]
      exact (hγ₁_diff t).hasDerivAt
    rw [hlhs.unique hrhs]
    ext i
    simp
    ring

  
  have hγ_mem_frontier : ∀ t : ℝ, γ t ∈ frontier Ω := by
    intro t; rw [← hγ.range_eq]; exact ⟨t, rfl⟩
  have hγ_mem_closure : ∀ t : ℝ, γ t ∈ closure Ω :=
    fun t => frontier_subset_closure (hγ_mem_frontier t)
  have hθ_normal_and_closure : ∀ t₀ : ℝ,
      IsOutwardUnitNormal Ω (γ t₀) (unitNormalVec (θ t₀)) ∧
      ∀ x ∈ closure Ω, inner ℝ (x - γ t₀) (unitNormalVec (θ t₀)) ≤ 0 := by
    intro t₀
    have hnot_mem : γ t₀ ∉ Ω := by
      have hfr := hγ_mem_frontier t₀
      rw [frontier, hΩ.domain.isOpen.interior_eq] at hfr
      exact hfr.2
    obtain ⟨f_sep, hf_sep⟩ :=
      geometric_hahn_banach_open_point hΩ.domain.convex hΩ.domain.isOpen hnot_mem
    let w : Plane := (InnerProductSpace.toDual ℝ Plane).symm f_sep
    have hw_apply : ∀ y : Plane, inner ℝ y w = f_sep y := by
      intro y
      rw [real_inner_comm]
      exact InnerProductSpace.toDual_symm_apply (𝕜 := ℝ) (E := Plane) (x := y) (y := f_sep)
    have hw_ne : w ≠ 0 := by
      intro hw0
      have hlt := hf_sep c₀ hc₀
      have heq : f_sep c₀ - f_sep (γ t₀) = inner ℝ (c₀ - γ t₀) w := by
        rw [inner_sub_left, hw_apply, hw_apply]
      rw [hw0, inner_zero_right] at heq
      linarith
    have hw_norm_pos : 0 < ‖w‖ := norm_pos_iff.mpr hw_ne
    let u : Plane := ‖w‖⁻¹ • w
    have hu_norm : ‖u‖ = 1 := by
      dsimp [u]; rw [norm_smul, Real.norm_of_nonneg (inv_nonneg.mpr (le_of_lt hw_norm_pos))]
      exact inv_mul_cancel₀ (ne_of_gt hw_norm_pos)
    have hu_open : ∀ x ∈ Ω, inner ℝ (x - γ t₀) u ≤ 0 := by
      intro x hx
      dsimp [u]
      rw [inner_smul_right, inner_sub_left, hw_apply, hw_apply]
      have hlt := hf_sep x hx
      exact mul_nonpos_of_nonneg_of_nonpos (inv_nonneg.mpr (le_of_lt hw_norm_pos)) (by linarith)
    have hu_closure : ∀ x ∈ closure Ω, inner ℝ (x - γ t₀) u ≤ 0 := by
      have hsub : Ω ⊆ {x : Plane | inner ℝ (x - γ t₀) u ≤ 0} := hu_open
      have hcl : IsClosed {x : Plane | inner ℝ (x - γ t₀) u ≤ 0} :=
        isClosed_le ((continuous_id.sub continuous_const).inner continuous_const) continuous_const
      exact fun x hx => closure_minimal hsub hcl hx
    let φ : ℝ → ℝ := fun t => inner ℝ (γ t - γ t₀) u
    let φ₁ : ℝ → ℝ := fun t => inner ℝ (γ₁ t) u
    have hφ_le : ∀ t : ℝ, φ t ≤ 0 := fun t => hu_closure (γ t) (hγ_mem_closure t)
    have hφ_t₀ : φ t₀ = 0 := by simp [φ]
    have hφ_deriv : ∀ t : ℝ, HasDerivAt φ (φ₁ t) t := by
      intro t
      have hd := ((hγ_diff t).hasDerivAt.sub_const (γ t₀)).inner ℝ (hasDerivAt_const t u)
      simpa [φ, φ₁] using hd
    have hφ₁_deriv : ∀ t : ℝ, HasDerivAt φ₁ (inner ℝ (γ₂ t) u) t := by
      intro t
      have hd := (hγ₁_diff t).hasDerivAt.inner ℝ (hasDerivAt_const t u)
      simpa [φ₁] using hd
    have hφ_max : IsLocalMax φ t₀ := by
      have hmax : IsMaxOn φ Set.univ t₀ := fun t _ => by rw [hφ_t₀]; exact hφ_le t
      exact hmax.isLocalMax Filter.univ_mem
    have hφ₁_zero : φ₁ t₀ = 0 := hφ_max.hasDerivAt_eq_zero (hφ_deriv t₀)
    have hu_orth_e : inner ℝ u (unitTangentVec (θ t₀)) = 0 := by
      have h1 : φ₁ t₀ = s t₀ * inner ℝ (unitTangentVec (θ t₀)) u := by
        dsimp [φ₁]; rw [hγ₁_frenet t₀, inner_smul_left]; simp
      rw [hφ₁_zero] at h1
      have h2 : inner ℝ (unitTangentVec (θ t₀)) u = 0 :=
        (mul_eq_zero.mp h1.symm).resolve_left (ne_of_gt (hs_pos t₀))
      rwa [real_inner_comm]
    let c_u : ℝ := inner ℝ u (unitNormalVec (θ t₀))
    have hu_span : u = c_u • unitNormalVec (θ t₀) := by
      have hdec := hframe_decomp (θ t₀) u
      rw [hu_orth_e, zero_smul, add_zero] at hdec
      exact hdec
    have hcu_abs : |c_u| = 1 := by
      have h1 := hu_norm
      rw [hu_span, norm_smul, hn_norm, mul_one, Real.norm_eq_abs] at h1
      exact h1
    have hφ₂_nonpos : inner ℝ (γ₂ t₀) u ≤ 0 := by
      by_contra hnot
      have hpos : 0 < inner ℝ (γ₂ t₀) u := lt_of_not_ge hnot
      have hslope_lim := (hasDerivAt_iff_tendsto_slope_left_right.mp (hφ₁_deriv t₀)).2
      have hev : {t : ℝ | 0 < slope φ₁ t₀ t} ∈ nhdsWithin t₀ (Set.Ioi t₀) :=
        hslope_lim (Ioi_mem_nhds hpos)
      rw [Metric.mem_nhdsWithin_iff] at hev
      obtain ⟨δ, hδ_pos, hδ_sub⟩ := hev
      have hab : t₀ < t₀ + δ / 2 := by linarith
      have hφ_diff : Differentiable ℝ φ := fun t => (hφ_deriv t).differentiableAt
      have hφ_cont : ContinuousOn φ (Set.Icc t₀ (t₀ + δ / 2)) :=
        hφ_diff.continuous.continuousOn
      obtain ⟨ξ, hξ_mem, hξ_eq⟩ :=
        exists_hasDerivAt_eq_slope φ φ₁ hab hφ_cont (fun x _ => hφ_deriv x)
      have hξ_ball : ξ ∈ Metric.ball t₀ δ ∩ Set.Ioi t₀ := by
        refine ⟨?_, hξ_mem.1⟩
        rw [Metric.mem_ball, Real.dist_eq, abs_of_pos (sub_pos.mpr hξ_mem.1)]
        linarith [hξ_mem.2]
      have hslope_pos : 0 < slope φ₁ t₀ ξ := hδ_sub hξ_ball
      rw [slope_def_field, hφ₁_zero, sub_zero] at hslope_pos
      have hφ₁_ξ_pos : 0 < φ₁ ξ :=
        (div_pos_iff_of_pos_right (sub_pos.mpr hξ_mem.1)).mp hslope_pos
      have hφ₁_ξ_nonpos : φ₁ ξ ≤ 0 := by
        rw [hξ_eq, hφ_t₀, sub_zero]
        exact div_nonpos_of_nonpos_of_nonneg (hφ_le (t₀ + δ / 2)) (by linarith)
      linarith
    have hcu_nonneg : 0 ≤ c_u := by
      rw [hγ₂_frenet t₀, inner_sub_left, inner_smul_left, inner_smul_left] at hφ₂_nonpos
      simp only [conj_trivial] at hφ₂_nonpos
      have he_u : inner ℝ (unitTangentVec (θ t₀)) u = 0 := by
        rw [real_inner_comm]; exact hu_orth_e
      have hn_u : inner ℝ (unitNormalVec (θ t₀)) u = c_u := by
        rw [real_inner_comm]
      rw [he_u, hn_u, mul_zero, zero_sub] at hφ₂_nonpos
      have hsw_pos : 0 < s t₀ * angRate t₀ := mul_pos (hs_pos t₀) (hangRate_pos t₀)
      nlinarith
    have hcu_one : c_u = 1 := by
      rcases abs_eq (by norm_num : (0 : ℝ) ≤ 1) |>.mp hcu_abs with h1 | h2
      · exact h1
      · linarith
    have hu_eq_n : u = unitNormalVec (θ t₀) := by rw [hu_span, hcu_one, one_smul]
    rw [hu_eq_n] at hu_closure hu_open
    refine ⟨⟨hn_norm (θ t₀), ⟨γ, L, t₀, hγ, rfl, ?_⟩, hu_open⟩, hu_closure⟩
    change inner ℝ (unitNormalVec (θ t₀)) (γ₁ t₀) = 0
    rw [hγ₁_frenet t₀, inner_smul_right, hne_orth, mul_zero]

  
  have hγ₁_per : Function.Periodic γ₁ L := deriv_per_plane γ L hγ_diff hγ.periodic
  have hγ₂_per : Function.Periodic γ₂ L := deriv_per_plane γ₁ L hγ₁_diff hγ₁_per
  have hangRate_per : Function.Periodic angRate L := by
    intro t; dsimp [angRate, q]; rw [hγ₁_per t, hγ₂_per t]
  let Δ : ℝ := θ L - θ 0
  have hθ_shift_const : ∀ t : ℝ, θ (t + L) - θ t = Δ := by
    intro t
    have hd : ∀ u : ℝ, HasDerivAt (fun y => θ (y + L) - θ y) 0 u := by
      intro u
      have h1 : HasDerivAt (fun y => θ (y + L)) (angRate (u + L)) u := by
        convert (hθ_deriv (u + L)).comp u ((hasDerivAt_id u).add_const L) using 1 <;>
          simp [Function.comp_def]
      have h2 := h1.sub (hθ_deriv u)
      rwa [hangRate_per u, sub_self] at h2
    have hconst := is_const_of_deriv_eq_zero
      (fun u => (hd u).differentiableAt) (fun u => (hd u).deriv) t 0
    simpa [Δ] using hconst
  have hθ_mono : StrictMono θ :=
    strictMono_of_deriv_pos (by intro t; rw [(hθ_deriv t).deriv]; exact hangRate_pos t)
  have hΔ_pos : 0 < Δ := sub_pos.mpr (hθ_mono hγ.period_pos)
  have hcos_Δ : Real.cos Δ = 1 := by
    have hγ₁_L : γ₁ L = γ₁ 0 := by simpa using hγ₁_per 0
    have hs_L : s L = s 0 := by dsimp [s]; rw [hγ₁_L]
    have he_L : unitTangentVec (θ L) = unitTangentVec (θ 0) := by
      have h1 := hγ₁_frenet L
      rw [hγ₁_L, hγ₁_frenet 0, hs_L] at h1
      exact smul_right_injective Plane (ne_of_gt (hs_pos 0)) h1.symm
    have hsin_L : Real.sin (θ L) = Real.sin (θ 0) := by
      have h0 := congrArg (fun v : Plane => v 0) he_L
      simp [unitTangentVec] at h0
      linarith
    have hcos_L : Real.cos (θ L) = Real.cos (θ 0) := by
      have h1 := congrArg (fun v : Plane => v 1) he_L
      simpa [unitTangentVec] using h1
    dsimp [Δ]
    rw [Real.cos_sub, hcos_L, hsin_L]
    nlinarith [Real.cos_sq_add_sin_sq (θ 0)]
  obtain ⟨k_wind, hk_wind⟩ := (Real.cos_eq_one_iff Δ).mp hcos_Δ
  have hk_pos : 1 ≤ k_wind := by
    have hk_real : 0 < (k_wind : ℝ) := by
      have hprod : 0 < (k_wind : ℝ) * (2 * Real.pi) := by linarith
      exact (mul_pos_iff_of_pos_right h2pi_pos).mp hprod
    exact_mod_cast Int.lt_iff_add_one_le.mp (Int.cast_pos.mp hk_real)
  have hk_le_one : k_wind ≤ 1 := by
    by_contra hnot_le
    have hk_ge2 : 2 ≤ k_wind := by omega
    have hk_cast : (2 : ℝ) ≤ (k_wind : ℝ) := by exact_mod_cast hk_ge2
    have hθL_eq : θ L = θ 0 + (k_wind : ℝ) * (2 * Real.pi) := by dsimp [Δ] at hk_wind; linarith
    have h_mid_low : θ 0 < θ 0 + 2 * Real.pi := by linarith
    have h_mid_high : θ 0 + 2 * Real.pi < θ L := by rw [hθL_eq]; nlinarith
    obtain ⟨t₁, ht₁_mem, ht₁_eq⟩ := intermediate_value_Icc (le_of_lt hγ.period_pos)
      hθ_smooth.continuous.continuousOn ⟨le_of_lt h_mid_low, le_of_lt h_mid_high⟩
    have ht₁_pos : 0 < t₁ := by
      rcases eq_or_lt_of_le ht₁_mem.1 with rfl | hpos
      · linarith
      · exact hpos
    have ht₁_lt_L : t₁ < L := by
      rcases eq_or_lt_of_le ht₁_mem.2 with rfl | hlt
      · linarith
      · exact hlt
    have hn_t₁ : unitNormalVec (θ t₁) = unitNormalVec (θ 0) := by
      change θ t₁ = θ 0 + 2 * Real.pi at ht₁_eq
      rw [ht₁_eq]
      exact hn_per (θ 0)
    let p₀ : Plane := γ 0
    let p₁ : Plane := γ t₁
    let n₀ : Plane := unitNormalVec (θ 0)
    have hp₁_p₀ : inner ℝ (p₁ - p₀) n₀ ≤ 0 := (hθ_normal_and_closure 0).2 p₁ (hγ_mem_closure t₁)
    have hp₀_p₁ : inner ℝ (p₀ - p₁) n₀ ≤ 0 := by
      have h := (hθ_normal_and_closure t₁).2 p₀ (hγ_mem_closure 0)
      rwa [hn_t₁] at h
    have hp_orth : inner ℝ (p₁ - p₀) n₀ = 0 := by
      have hneg : inner ℝ (p₀ - p₁) n₀ = -inner ℝ (p₁ - p₀) n₀ := by
        rw [← neg_sub, inner_neg_left]
      linarith
    by_cases hp_eq : p₀ = p₁
    · obtain ⟨m, hm⟩ := hγ.simple t₁ 0 hp_eq.symm
      have hm_pos : (0 : ℝ) < (m : ℝ) := by
        have : 0 < (m : ℝ) * L := by linarith
        exact (mul_pos_iff_of_pos_right hγ.period_pos).mp this
      have hm_lt1 : (m : ℝ) < 1 := by
        have : (m : ℝ) * L < 1 * L := by linarith
        exact lt_of_mul_lt_mul_right this (le_of_lt hγ.period_pos)
      have hm_z_pos : 0 < m := Int.cast_pos.mp hm_pos
      have hm_z_lt1 : m < 1 := by exact_mod_cast hm_lt1
      omega
    · let z : Plane := (1 / 2 : ℝ) • p₀ + (1 / 2 : ℝ) • p₁
      have hz_openSeg : z ∈ openSegment ℝ p₀ p₁ :=
        ⟨1 / 2, 1 / 2, by norm_num, by norm_num, by norm_num, rfl⟩
      have hz_mem : z ∈ Ω :=
        hΩ.domain.openSegment_subset p₀ (hγ_mem_closure 0) p₁ (hγ_mem_closure t₁) hp_eq hz_openSeg
      obtain ⟨δ_z, hδ_z_pos, hball_z⟩ := Metric.isOpen_iff.mp hΩ.domain.isOpen z hz_mem
      let x_in : Plane := z + (δ_z / 2) • n₀
      have hx_in_mem : x_in ∈ Ω := by
        apply hball_z
        rw [Metric.mem_ball, dist_eq_norm]
        have hsub : x_in - z = (δ_z / 2) • n₀ := by dsimp [x_in]; abel
        rw [hsub, norm_smul, hn_norm, mul_one, Real.norm_of_nonneg (by linarith)]
        linarith
      have hz_orth : inner ℝ (z - p₀) n₀ = 0 := by
        have hsub_z : z - p₀ = (1 / 2 : ℝ) • (p₁ - p₀) := by
          dsimp [z]; ext i; simp; ring
        rw [hsub_z, inner_smul_left, hp_orth, mul_zero]
      have hx_pos : 0 < inner ℝ (x_in - p₀) n₀ := by
        have hsub : x_in - p₀ = (z - p₀) + (δ_z / 2) • n₀ := by dsimp [x_in]; abel
        rw [hsub, inner_add_left, inner_smul_left, hz_orth, hn_self, conj_trivial]
        linarith
      have hx_nonpos : inner ℝ (x_in - p₀) n₀ ≤ 0 := (hθ_normal_and_closure 0).1.2.2 x_in hx_in_mem
      linarith
  have hk_one : k_wind = 1 := le_antisymm hk_le_one hk_pos
  have hθ_qp : ∀ t : ℝ, θ (t + L) = θ t + 2 * Real.pi := by
    intro t
    have h := hθ_shift_const t
    rw [hk_one] at hk_wind
    push_cast at hk_wind
    linarith

  
  obtain ⟨τ, hτ_smooth, hτ_left, hτ_right, hτ_deriv, hτ_qp, hθ_shift_int⟩ :=
    smooth_quasiperiodic_inv θ angRate L (2 * Real.pi) hγ.period_pos h2pi_pos
      hθ_smooth hθ_deriv hangRate_pos hθ_qp
  let Γ : ℝ → Plane := fun ψ => γ (τ ψ)
  let h : ℝ → ℝ := fun ψ => inner ℝ (Γ ψ - c₀) (unitNormalVec ψ)
  have hΓ_smooth : ContDiff ℝ ∞ Γ := hγ.smooth.comp hτ_smooth
  have hh_smooth : ContDiff ℝ ∞ h := (hΓ_smooth.sub contDiff_const).inner ℝ hn_smooth
  have hΓ_per : Function.Periodic Γ (2 * Real.pi) := by
    intro ψ; dsimp [Γ]; rw [hτ_qp ψ, hγ.periodic (τ ψ)]
  have hh_per : Function.Periodic h (2 * Real.pi) := by
    intro ψ; dsimp [h]; rw [hΓ_per ψ, hn_per ψ]
  have hsupport_closure : ∀ ψ : ℝ, ∀ x ∈ closure Ω, inner ℝ (x - c₀) (unitNormalVec ψ) ≤ h ψ := by
    intro ψ x hx
    have hcl := (hθ_normal_and_closure (τ ψ)).2 x hx
    rw [hτ_right ψ] at hcl
    have hsplit : x - Γ ψ = (x - c₀) - (Γ ψ - c₀) := by abel
    rw [hsplit, inner_sub_left] at hcl
    dsimp [h]
    linarith
  have htwo_r₀_le : ∀ ψ : ℝ, 2 * r₀ ≤ h ψ := by
    intro ψ
    let x_ψ : Plane := c₀ + (2 * r₀) • unitNormalVec ψ
    have hx_ball : x_ψ ∈ Metric.closedBall c₀ (2 * r₀) := by
      rw [Metric.mem_closedBall, dist_eq_norm]
      have hsub : x_ψ - c₀ = (2 * r₀) • unitNormalVec ψ := by dsimp [x_ψ]; abel
      rw [hsub, norm_smul, hn_norm, mul_one, Real.norm_of_nonneg (by linarith)]
    have hx_cl : x_ψ ∈ closure Ω := subset_closure (hclosedBall_sub hx_ball)
    have hle := hsupport_closure ψ x_ψ hx_cl
    have hval : inner ℝ (x_ψ - c₀) (unitNormalVec ψ) = 2 * r₀ := by
      have hsub : x_ψ - c₀ = (2 * r₀) • unitNormalVec ψ := by dsimp [x_ψ]; abel
      rw [hsub, inner_smul_left, hn_self, conj_trivial, mul_one]
    linarith
  have hh_pos : ∀ ψ : ℝ, 0 < h ψ := fun ψ => by linarith [htwo_r₀_le ψ]

  let ρ_κ : ℝ → ℝ := fun ψ => (signedCurvature γ (τ ψ))⁻¹
  have hρ_κ_pos : ∀ ψ : ℝ, 0 < ρ_κ ψ := fun ψ => inv_pos.mpr (hκ (τ ψ))
  have hΓ_deriv : ∀ ψ : ℝ, HasDerivAt Γ (ρ_κ ψ • unitTangentVec ψ) ψ := by
    intro ψ
    have hd := (hγ_diff (τ ψ)).hasDerivAt.scomp ψ (hτ_deriv ψ)
    change HasDerivAt Γ ((angRate (τ ψ))⁻¹ • γ₁ (τ ψ)) ψ at hd
    convert hd using 1
    rw [hγ₁_frenet (τ ψ), hτ_right ψ, hangRate_eq_curv (τ ψ), smul_smul]
    congr 1
    dsimp [ρ_κ]
    have hs_ne : s (τ ψ) ≠ 0 := ne_of_gt (hs_pos (τ ψ))
    have hκ_ne : signedCurvature γ (τ ψ) ≠ 0 := ne_of_gt (hκ (τ ψ))
    field_simp
  have hh_deriv_at : ∀ ψ : ℝ, HasDerivAt h (inner ℝ (Γ ψ - c₀) (unitTangentVec ψ)) ψ := by
    intro ψ
    have hd := ((hΓ_deriv ψ).sub_const c₀).inner ℝ (hn_deriv ψ)
    convert hd using 1
    rw [inner_smul_left, hen_orth, mul_zero, add_zero]
  have hh_deriv_eq : ∀ ψ : ℝ, deriv h ψ = inner ℝ (Γ ψ - c₀) (unitTangentVec ψ) :=
    fun ψ => (hh_deriv_at ψ).deriv
  have hsupport_pt_eq : ∀ ψ : ℝ, supportBoundaryPt c₀ h ψ = Γ ψ := by
    intro ψ
    dsimp [supportBoundaryPt]
    rw [hh_deriv_eq ψ, add_assoc]
    have hdec := hframe_decomp ψ (Γ ψ - c₀)
    dsimp [h]
    rw [← hdec]
    abel
  have hh_deriv2_at : ∀ ψ : ℝ, HasDerivAt (deriv h) (ρ_κ ψ - h ψ) ψ := by
    intro ψ
    have hfn : deriv h = fun u => inner ℝ (Γ u - c₀) (unitTangentVec u) := funext hh_deriv_eq
    rw [hfn]
    have hd := ((hΓ_deriv ψ).sub_const c₀).inner ℝ (he_deriv ψ)
    convert hd using 1
    rw [inner_neg_right, inner_smul_left, he_self, conj_trivial, mul_one]
    dsimp [h]
    ring
  have hr_pos : ∀ ψ : ℝ, 0 < h ψ + deriv (deriv h) ψ := by
    intro ψ
    rw [(hh_deriv2_at ψ).deriv]
    linarith [hρ_κ_pos ψ]
  have hfrontier_eq : frontier Ω =
      Set.range (fun ψ : ℝ => c₀ + h ψ • unitNormalVec ψ + deriv h ψ • unitTangentVec ψ) := by
    rw [← hγ.range_eq]
    ext p
    simp only [Set.mem_range]
    constructor
    · rintro ⟨t, rfl⟩
      refine ⟨θ t, ?_⟩
      change supportBoundaryPt c₀ h (θ t) = γ t
      rw [hsupport_pt_eq (θ t)]
      dsimp [Γ]
      rw [hτ_left t]
    · rintro ⟨ψ, rfl⟩
      refine ⟨τ ψ, ?_⟩
      exact (hsupport_pt_eq ψ).symm
  have hΓ_mem_fr : ∀ ψ : ℝ, supportBoundaryPt c₀ h ψ ∈ frontier Ω := by
    intro ψ
    rw [hfrontier_eq]
    exact ⟨ψ, rfl⟩
  have hΓ_inj : ∀ θ₁ θ₂ : ℝ,
      supportBoundaryPt c₀ h θ₁ = supportBoundaryPt c₀ h θ₂ →
      ∃ k : ℤ, θ₁ - θ₂ = k * (2 * Real.pi) := by
    intro θ₁ θ₂ heq
    rw [hsupport_pt_eq θ₁, hsupport_pt_eq θ₂] at heq
    obtain ⟨k, hk⟩ := hγ.simple (τ θ₁) (τ θ₂) heq
    have hτ_eq : τ θ₁ = τ θ₂ + (k : ℝ) * L := by linarith
    have hθ_ap := congrArg θ hτ_eq
    rw [hτ_right θ₁, hθ_shift_int k (τ θ₂), hτ_right θ₂] at hθ_ap
    exact ⟨k, by linarith⟩
  have hΓ_normal : ∀ ψ : ℝ,
      IsOutwardUnitNormal Ω (supportBoundaryPt c₀ h ψ) (unitNormalVec ψ) := by
    intro ψ
    rw [hsupport_pt_eq ψ]
    have h := (hθ_normal_and_closure (τ ψ)).1
    rwa [hτ_right ψ] at h

  
  let r : ℝ → ℝ := fun ϑ => h ϑ + deriv (deriv h) ϑ
  have hr_smooth : ContDiff ℝ ∞ r := hh_smooth.add (hh_smooth.iterate_deriv 2)
  have hh_diff : Differentiable ℝ h := hh_smooth.differentiable (by simp)
  have hh'_diff : Differentiable ℝ (deriv h) :=
    (hh_smooth.iterate_deriv 1).differentiable (by simp)
  have hh'_per : Function.Periodic (deriv h) (2 * Real.pi) :=
    deriv_per_real h (2 * Real.pi) hh_diff hh_per
  have hh''_per : Function.Periodic (deriv (deriv h)) (2 * Real.pi) :=
    deriv_per_real (deriv h) (2 * Real.pi) hh'_diff hh'_per
  have hr_per : Function.Periodic r (2 * Real.pi) := by
    intro ϑ; dsimp [r]; rw [hh_per ϑ, hh''_per ϑ]

  let ρ : ℝ → ℝ := fun ϑ => Real.exp ((1 / 3 : ℝ) * Real.log (r ϑ))
  have hρ_smooth : ContDiff ℝ ∞ ρ := by
    rw [contDiff_iff_contDiffAt]
    intro ϑ
    have hlog : ContDiffAt ℝ ∞ (fun u => Real.log (r u)) ϑ :=
      ContDiffAt.comp ϑ (Real.contDiffAt_log.mpr (ne_of_gt (hr_pos ϑ))) hr_smooth.contDiffAt
    exact Real.contDiff_exp.contDiffAt.comp ϑ (contDiffAt_const.mul hlog)
  have hρ_pos : ∀ ϑ : ℝ, 0 < ρ ϑ := fun ϑ => Real.exp_pos _
  have hρ_per : Function.Periodic ρ (2 * Real.pi) := by
    intro ϑ; dsimp [ρ]; rw [hr_per ϑ]
  have hρ_cube : ∀ ϑ : ℝ, (ρ ϑ) ^ 3 = r ϑ := by
    intro ϑ
    dsimp [ρ]
    rw [← Real.exp_nat_mul]
    have hmul : (3 : ℕ) * ((1 / 3 : ℝ) * Real.log (r ϑ)) = Real.log (r ϑ) := by
      push_cast; ring
    rw [hmul, Real.exp_log (hr_pos ϑ)]

  let I_laz : ℝ := ∫ η in (0 : ℝ)..(2 * Real.pi), ρ η
  have hI_pos : 0 < I_laz := by
    obtain ⟨η_min, _, hη_min⟩ := isCompact_Icc.exists_isMinOn
      ⟨0, ⟨le_rfl, le_of_lt h2pi_pos⟩⟩ hρ_smooth.continuous.continuousOn
    have hmono : (∫ _ in (0 : ℝ)..(2 * Real.pi), ρ η_min) ≤ I_laz :=
      intervalIntegral.integral_mono_on (le_of_lt h2pi_pos)
        intervalIntegrable_const
        (hρ_smooth.continuous.intervalIntegrable 0 (2 * Real.pi))
        (fun x hx => hη_min hx)
    rw [intervalIntegral.integral_const, sub_zero, smul_eq_mul] at hmono
    exact lt_of_lt_of_le (mul_pos h2pi_pos (hρ_pos η_min)) hmono
  let k_laz : ℝ := (2 * Real.pi) / I_laz
  have hk_laz_pos : 0 < k_laz := div_pos h2pi_pos hI_pos
  let c_laz : ℝ := (k_laz ^ 3)⁻¹
  have hc_laz_pos : 0 < c_laz := inv_pos.mpr (pow_pos hk_laz_pos 3)
  let Ψ : ℝ → ℝ := fun ϑ => (0 : ℝ) + k_laz * ∫ η in (0 : ℝ)..ϑ, ρ η
  obtain ⟨hΨ_smooth, hΨ_deriv⟩ := smooth_primitive ρ 0 k_laz hρ_smooth
  have hΨ'_pos : ∀ ϑ : ℝ, 0 < k_laz * ρ ϑ := fun ϑ => mul_pos hk_laz_pos (hρ_pos ϑ)
  have hΨ_qp : ∀ ϑ : ℝ, Ψ (ϑ + 2 * Real.pi) = Ψ ϑ + 2 * Real.pi := by
    intro ϑ
    have hd : ∀ u : ℝ, HasDerivAt (fun y => Ψ (y + 2 * Real.pi) - Ψ y) 0 u := by
      intro u
      have h1 : HasDerivAt (fun y => Ψ (y + 2 * Real.pi)) (k_laz * ρ (u + 2 * Real.pi)) u := by
        convert (hΨ_deriv (u + 2 * Real.pi)).comp u ((hasDerivAt_id u).add_const (2 * Real.pi)) using 1 <;>
          simp [Ψ, Function.comp_def]
      have h2 := h1.sub (hΨ_deriv u)
      rwa [hρ_per u, sub_self] at h2
    have hconst := is_const_of_deriv_eq_zero
      (fun u => (hd u).differentiableAt) (fun u => (hd u).deriv) ϑ 0
    have h0 : Ψ (0 + 2 * Real.pi) - Ψ 0 = 2 * Real.pi := by
      dsimp [Ψ]
      rw [zero_add, intervalIntegral.integral_same, mul_zero, add_zero, zero_add, sub_zero]
      exact div_mul_cancel₀ (2 * Real.pi) (ne_of_gt hI_pos)
    linarith
  obtain ⟨ϕ, hϕ_smooth, _, _, hϕ_deriv, hϕ_qp, _⟩ :=
    smooth_quasiperiodic_inv Ψ (fun ϑ => k_laz * ρ ϑ) (2 * Real.pi) (2 * Real.pi)
      h2pi_pos h2pi_pos hΨ_smooth hΨ_deriv hΨ'_pos hΨ_qp
  have hϕ_deriv_pos : ∀ x : ℝ, 0 < deriv ϕ x := by
    intro x
    rw [(hϕ_deriv x).deriv]
    exact inv_pos.mpr (hΨ'_pos (ϕ x))
  have hlaz_norm : ∀ x : ℝ, (h (ϕ x) + deriv (deriv h) (ϕ x)) * (deriv ϕ x) ^ 3 = c_laz := by
    intro x
    change r (ϕ x) * (deriv ϕ x) ^ 3 = c_laz
    rw [← hρ_cube (ϕ x), (hϕ_deriv x).deriv]
    dsimp [c_laz]
    have hk_ne : k_laz ≠ 0 := ne_of_gt hk_laz_pos
    have hρ_ne : ρ (ϕ x) ≠ 0 := ne_of_gt (hρ_pos (ϕ x))
    field_simp

  
  exact ⟨{
    c₀ := c₀
    c₀_mem := hc₀
    h := h
    h_smooth := hh_smooth
    h_periodic := hh_per
    h_pos := hh_pos
    r_pos := hr_pos
    frontier_eq := hfrontier_eq
    ϕ := ϕ
    c := c_laz
    c_pos := hc_laz_pos
    ϕ_smooth := hϕ_smooth
    ϕ_deriv_pos := hϕ_deriv_pos
    ϕ_quasiperiodic := hϕ_qp
    lazutkin_norm := hlaz_norm
    r₀ := r₀
    r₀_pos := hr₀_pos
    closedBall_subset := hclosedBall_sub
    two_r₀_le_h := htwo_r₀_le
    Γ_mem_frontier := hΓ_mem_fr
    Γ_inj_mod_two_pi := hΓ_inj
    Γ_outward_normal := hΓ_normal
    support_bound_closure := hsupport_closure
  }⟩

theorem support_phase_billiard_map (Ω : Set Plane)
    (hΩ : IsSmoothPositivelyCurvedBilliardDomain Ω)
    (B : SupportBoundaryPackage Ω) :
    Nonempty (SupportPhaseMapData Ω B) :=
by
  have hpi_pos : 0 < Real.pi := Real.pi_pos
  have h2pi_pos : 0 < 2 * Real.pi := by linarith
  have hh_diff : Differentiable ℝ B.h := (contDiff_infty_iff_deriv.mp B.h_smooth).1
  have hdh_smooth : ContDiff ℝ ∞ (deriv B.h) := (contDiff_infty_iff_deriv.mp B.h_smooth).2
  have hdh_diff : Differentiable ℝ (deriv B.h) := (contDiff_infty_iff_deriv.mp hdh_smooth).1
  have hh_cont : Continuous B.h := B.h_smooth.continuous
  have hdh_cont : Continuous (deriv B.h) := hdh_smooth.continuous
  have hdh_per : Function.Periodic (deriv B.h) (2 * Real.pi) := by
    intro θ
    have hd1 : HasDerivAt (fun x : ℝ => B.h (x + 2 * Real.pi))
        (deriv B.h (θ + 2 * Real.pi) * 1) θ :=
      (hh_diff (θ + 2 * Real.pi)).hasDerivAt.comp θ ((hasDerivAt_id θ).add_const (2 * Real.pi))
    have hshift : (fun x : ℝ => B.h (x + 2 * Real.pi)) = B.h := funext B.h_periodic
    rw [hshift, mul_one] at hd1
    exact hd1.deriv.symm
  have hh_sub_pi : ∀ θ : ℝ, B.h (θ - Real.pi) = B.h (θ + Real.pi) := by
    intro θ
    have h1 := B.h_periodic (θ - Real.pi)
    have h2 : θ - Real.pi + 2 * Real.pi = θ + Real.pi := by ring
    rw [h2] at h1
    exact h1.symm
  
  let g : ℝ → ℝ → ℝ := fun β s =>
    B.h s * Real.cos (β - s) + deriv B.h s * Real.sin (β - s)
  have hg_hasDeriv : ∀ β s : ℝ,
      HasDerivAt (g β) ((B.h s + deriv (deriv B.h) s) * Real.sin (β - s)) s := by
    intro β s
    have h_sub : HasDerivAt (fun x : ℝ => β - x) (-1) s := by
      convert (hasDerivAt_const s β).sub (hasDerivAt_id s) using 1
      · rfl
      · norm_num
    have h_cos : HasDerivAt (fun x : ℝ => Real.cos (β - x)) (-Real.sin (β - s) * (-1)) s :=
      (Real.hasDerivAt_cos (β - s)).comp s h_sub
    have h_sin : HasDerivAt (fun x : ℝ => Real.sin (β - x)) (Real.cos (β - s) * (-1)) s :=
      (Real.hasDerivAt_sin (β - s)).comp s h_sub
    have h1 := (hh_diff s).hasDerivAt.mul h_cos
    have h2 := (hdh_diff s).hasDerivAt.mul h_sin
    convert h1.add h2 using 1
    ring
  have hg_cont : ∀ β : ℝ, Continuous (g β) := by
    intro β
    exact (hh_cont.mul (Real.continuous_cos.comp (continuous_const.sub continuous_id))).add
      (hdh_cont.mul (Real.continuous_sin.comp (continuous_const.sub continuous_id)))
  have hg_self : ∀ β : ℝ, g β β = B.h β := by
    intro β; simp [g]
  have hg_add_pi : ∀ β : ℝ, g β (β + Real.pi) = -B.h (β + Real.pi) := by
    intro β
    have hsub : β - (β + Real.pi) = -Real.pi := by ring
    simp [g, hsub]
  have hg_sub_pi : ∀ β : ℝ, g β (β - Real.pi) = -B.h (β + Real.pi) := by
    intro β
    have hsub : β - (β - Real.pi) = Real.pi := by ring
    simp [g, hsub, hh_sub_pi β]
  have hg_mono : ∀ β : ℝ, StrictMonoOn (g β) (Set.Icc (β - Real.pi) β) := by
    intro β
    apply strictMonoOn_of_deriv_pos (convex_Icc _ _) (hg_cont β).continuousOn
    intro s hs
    rw [interior_Icc] at hs
    rw [(hg_hasDeriv β s).deriv]
    exact mul_pos (B.r_pos s)
      (Real.sin_pos_of_pos_of_lt_pi (by linarith [hs.2]) (by linarith [hs.1]))
  have hg_anti : ∀ β : ℝ, StrictAntiOn (g β) (Set.Icc β (β + Real.pi)) := by
    intro β
    apply strictAntiOn_of_deriv_neg (convex_Icc _ _) (hg_cont β).continuousOn
    intro s hs
    rw [interior_Icc] at hs
    rw [(hg_hasDeriv β s).deriv]
    have hsin_neg : Real.sin (β - s) < 0 := by
      have heq : β - s = -(s - β) := by ring
      rw [heq, Real.sin_neg]
      exact neg_lt_zero.mpr
        (Real.sin_pos_of_pos_of_lt_pi (by linarith [hs.1]) (by linarith [hs.2]))
    exact mul_neg_of_pos_of_neg (B.r_pos s) hsin_neg
  let F₁ : ℝ → ℝ → ℝ := fun θ₁ θ₂ => -supportAction1_ℝ B.h θ₁ θ₂
  let F₂ : ℝ → ℝ → ℝ := fun θ₁ θ₂ => supportAction2_ℝ B.h θ₁ θ₂
  have hF₁_eq_g : ∀ θ₁ θ₂ : ℝ, F₁ θ₁ θ₂ = g θ₁ ((θ₁ + θ₂) / 2) := by
    intro θ₁ θ₂
    dsimp [F₁, supportAction1_ℝ, g]
    have hd : θ₁ - (θ₁ + θ₂) / 2 = -((θ₂ - θ₁) / 2) := by ring
    rw [hd, Real.cos_neg, Real.sin_neg]
    ring
  have hF₂_eq_g : ∀ θ₁ θ₂ : ℝ, F₂ θ₁ θ₂ = g θ₂ ((θ₁ + θ₂) / 2) := by
    intro θ₁ θ₂
    dsimp [F₂, supportAction2_ℝ, g]
    have hd : θ₂ - (θ₁ + θ₂) / 2 = (θ₂ - θ₁) / 2 := by ring
    rw [hd]
    ring
  have hF₁_diag : ∀ θ : ℝ, F₁ θ θ = B.h θ := by
    intro θ; rw [hF₁_eq_g, show (θ + θ) / 2 = θ by ring, hg_self]
  have hF₁_top : ∀ θ : ℝ, F₁ θ (θ + 2 * Real.pi) = -B.h (θ + Real.pi) := by
    intro θ; rw [hF₁_eq_g, show (θ + (θ + 2 * Real.pi)) / 2 = θ + Real.pi by ring, hg_add_pi]
  have hF₂_diag : ∀ θ : ℝ, F₂ θ θ = B.h θ := by
    intro θ; rw [hF₂_eq_g, show (θ + θ) / 2 = θ by ring, hg_self]
  have hF₂_bot : ∀ θ : ℝ, F₂ (θ - 2 * Real.pi) θ = -B.h (θ + Real.pi) := by
    intro θ; rw [hF₂_eq_g, show (θ - 2 * Real.pi + θ) / 2 = θ - Real.pi by ring, hg_sub_pi]
  have hF₁_per : ∀ θ₁ θ₂ : ℝ, F₁ (θ₁ + 2 * Real.pi) (θ₂ + 2 * Real.pi) = F₁ θ₁ θ₂ := by
    intro θ₁ θ₂
    dsimp [F₁, supportAction1_ℝ]
    have hm : (θ₁ + 2 * Real.pi + (θ₂ + 2 * Real.pi)) / 2 = (θ₁ + θ₂) / 2 + 2 * Real.pi := by ring
    have hd : (θ₂ + 2 * Real.pi - (θ₁ + 2 * Real.pi)) / 2 = (θ₂ - θ₁) / 2 := by ring
    rw [hm, hd, B.h_periodic ((θ₁ + θ₂) / 2), hdh_per ((θ₁ + θ₂) / 2)]
  have hF₂_per : ∀ θ₁ θ₂ : ℝ, F₂ (θ₁ + 2 * Real.pi) (θ₂ + 2 * Real.pi) = F₂ θ₁ θ₂ := by
    intro θ₁ θ₂
    dsimp [F₂, supportAction2_ℝ]
    have hm : (θ₁ + 2 * Real.pi + (θ₂ + 2 * Real.pi)) / 2 = (θ₁ + θ₂) / 2 + 2 * Real.pi := by ring
    have hd : (θ₂ + 2 * Real.pi - (θ₁ + 2 * Real.pi)) / 2 = (θ₂ - θ₁) / 2 := by ring
    rw [hm, hd, B.h_periodic ((θ₁ + θ₂) / 2), hdh_per ((θ₁ + θ₂) / 2)]
  have hF₁_anti : ∀ θ : ℝ, StrictAntiOn (F₁ θ) (Set.Icc θ (θ + 2 * Real.pi)) := by
    intro θ a ha b hb hab
    rw [hF₁_eq_g, hF₁_eq_g]
    exact hg_anti θ
      ⟨by linarith [ha.1], by linarith [ha.2]⟩
      ⟨by linarith [hb.1], by linarith [hb.2]⟩
      (by linarith)
  have hF₂_mono : ∀ θ : ℝ, StrictMonoOn (fun θ₁ => F₂ θ₁ θ) (Set.Icc (θ - 2 * Real.pi) θ) := by
    intro θ a ha b hb hab
    dsimp
    rw [hF₂_eq_g, hF₂_eq_g]
    exact hg_mono θ
      ⟨by linarith [ha.1], by linarith [ha.2]⟩
      ⟨by linarith [hb.1], by linarith [hb.2]⟩
      (by linarith)
  have hF₁_smooth : ContDiff ℝ ∞ (fun u : ℝ × ℝ => F₁ u.1 u.2) := by
    have hmid : ContDiff ℝ ∞ (fun u : ℝ × ℝ => (u.1 + u.2) / 2) :=
      (contDiff_fst.add contDiff_snd).div_const 2
    have hdiff : ContDiff ℝ ∞ (fun u : ℝ × ℝ => (u.2 - u.1) / 2) :=
      (contDiff_snd.sub contDiff_fst).div_const 2
    exact (((hdh_smooth.comp hmid).mul (Real.contDiff_sin.comp hdiff)).sub
      ((B.h_smooth.comp hmid).mul (Real.contDiff_cos.comp hdiff))).neg
