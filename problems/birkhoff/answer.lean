            Finset.mem_erase.mpr
              ⟨h0d_ne_d0, Finset.HasAntidiagonal.mem_antidiagonal.mpr (zero_add d)⟩
          rw [MvPowerSeries.coeff_mul, ← Finset.add_sum_erase _ _ hd0_mem,
            ← Finset.add_sum_erase _ _ h0d_mem_erase] at h_cd
          let rem : ℂ :=
            ∑ p ∈ ((Finset.HasAntidiagonal.antidiagonal d).erase (d, 0)).erase (0, d),
              MvPowerSeries.coeff p.1 S * MvPowerSeries.coeff p.2 S
          have hrem_mem : rem ∈ L := by
            refine L.sum_mem fun p hp => ?_
            rcases Finset.mem_erase.mp hp with ⟨hp_ne_0d, hp_er1⟩
            rcases Finset.mem_erase.mp hp_er1 with ⟨hp_ne_d0, hp_mem⟩
            rcases h_antidiag hp_mem with ⟨hp_add, hp_deg⟩
            have hp1_ne : p.1 0 + p.1 1 ≠ 0 := by
              intro hp10
              have hp1_zero : p.1 = 0 := (h_eq_zero_iff p.1).mpr hp10
              have hp2_eq : p.2 = d := by rw [hp1_zero, zero_add] at hp_add; exact hp_add
              exact hp_ne_0d (Prod.ext hp1_zero hp2_eq)
            have hp2_ne : p.2 0 + p.2 1 ≠ 0 := by
              intro hp20
              have hp2_zero : p.2 = 0 := (h_eq_zero_iff p.2).mpr hp20
              have hp1_eq : p.1 = d := by rw [hp2_zero, add_zero] at hp_add; exact hp_add
              exact hp_ne_d0 (Prod.ext hp1_eq hp2_zero)
            exact L.mul_mem
              (ih (p.1 0 + p.1 1) (by omega) p.1 rfl)
              (ih (p.2 0 + p.2 1) (by omega) p.2 rfl)
          have h_solve :
