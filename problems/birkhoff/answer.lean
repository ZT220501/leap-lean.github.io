  set G₂ : Set ℂ := {ζ ∈ 𝒟₂ | |W ζ| ≤ h₀ / 2}
  set B₂ : Set ℂ := 𝒟₂ ∩ (fun ζ : ℂ => |W ζ|) ⁻¹' Set.Ioi (h₀ / 2)
