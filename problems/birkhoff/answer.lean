                  Real.exp (C_chain * (1 + |κ - k_a| + |k_n - k_a|)) := by
    obtain ⟨C_def, hC_def_pos, h_def⟩ := hCrit.log_deficit_bound
    have h_overlap_step : ∀ (U : ℝ) (m : ℕ) (p₁ p₂ : ℂ) (r₁ r₂ R : ℝ),
        0 ≤ U → 0 < r₁ → 0 < r₂ → 0 < R →
        ‖p₁ - p₂‖ + r₁ + r₂ ≤ R →
        Metric.closedBall p₁ (r₁ + R) ⊆ horizStrip S.H →
        (∀ z ∈ Metric.closedBall p₁ (r₁ + R), ‖S.f z‖ ≤ Real.exp U) →
        (Real.pi * r₂ ^ 2)⁻¹ * (∫ w in Metric.ball p₂ r₂, ldtTruncDeficit S U m w) ≤
          (R / r₂) ^ 2 *
            ((Real.pi * r₁ ^ 2)⁻¹ * (∫ w in Metric.ball p₁ r₁, ldtTruncDeficit S U m w)) := by
      intro U m p₁ p₂ r₁ r₂ R hU hr₁ hr₂ hR hdist hcb_strip hcb_norm
      let g : ℂ → ℝ := ldtTruncDeficit S U m
      let I₂ : ℝ := ∫ w in Metric.ball p₂ r₂, g w
