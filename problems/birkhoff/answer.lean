        have : (1 / 2 : ℝ) ^ i ≤ 1 := pow_le_one₀ (by norm_num) (by norm_num)
        nlinarith
      have hδ_lt_d : δ i < d_seq i / 100 := by
        have hd_lo := (hd_seq_bounds i).1
        linarith
      have hbase_pos : 0 < d₀ / (2 : ℝ) ^ i := by positivity
