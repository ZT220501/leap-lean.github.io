    · rw [LineGlancingChartData.U_a, Metric.mem_ball, Complex.dist_eq, ← Complex.ofReal_sub,
        Complex.norm_real, Real.norm_eq_abs]
      have hpos : 0 < G.C₀ * δ₁ := mul_pos G.C₀_pos hq₁_trap.1
      linarith [hq₁_trap.2.2, G.R_pos]
    · rw [LineGlancingChartData.U_d, Metric.mem_ball, dist_zero_right, Complex.norm_real,
        Real.norm_eq_abs, abs_of_pos hq₁_trap.1]
      linarith [hq₁_trap.2.1, G.δ_star_pos]
  let W₀ : Set ℂ := horizStrip (2 * C.s_h)
  have hW₀_open : IsOpen W₀ :=
    isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const
  have hh'_holo : DifferentiableOn ℂ (deriv C.h_ℂ) W₀ := C.h_ℂ_holo.deriv hW₀_open
  have hh''_holo : DifferentiableOn ℂ (deriv (deriv C.h_ℂ)) W₀ := hh'_holo.deriv hW₀_open
  have hinv2_U₀ : DifferentiableOn ℂ (fun _ : ℂ × ℂ => (1 / 2 : ℂ)) U₀ :=
    differentiableOn_const (1 / 2 : ℂ)
  have hα_end : ∀ q ∈ U₀, G.α_fn 0 q = q.1 ∧ G.α_fn (Fin.last k) q = q.1 + q.2 :=
    fun q hq => G.α_endpoints q hq
  have h_diff_add : ∀ {f g : ℂ × ℂ → ℂ},
      DifferentiableOn ℂ f U₀ → DifferentiableOn ℂ g U₀ →
      DifferentiableOn ℂ (fun q => f q + g q) U₀ := fun hf hg => hf.add hg
  have h_diff_sub : ∀ {f g : ℂ × ℂ → ℂ},
      DifferentiableOn ℂ f U₀ → DifferentiableOn ℂ g U₀ →
      DifferentiableOn ℂ (fun q => f q - g q) U₀ := fun hf hg => hf.sub hg
  have h_diff_mul : ∀ {f g : ℂ × ℂ → ℂ},
      DifferentiableOn ℂ f U₀ → DifferentiableOn ℂ g U₀ →
      DifferentiableOn ℂ (fun q => f q * g q) U₀ := fun hf hg => hf.mul hg
  have h_diff_cmul : ∀ (c : ℂ) {g : ℂ × ℂ → ℂ},
      DifferentiableOn ℂ g U₀ → DifferentiableOn ℂ (fun q => c * g q) U₀ :=
    fun c _ hg => (differentiableOn_const c).mul hg
  have h_diff_mulc : ∀ {f : ℂ × ℂ → ℂ} (c : ℂ),
