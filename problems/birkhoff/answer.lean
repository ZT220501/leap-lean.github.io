        have h1 := hw_lt m₁
        have h2 := hw_lt m₂
        rw [← h_eq] at h2
        have h_le : |c m₁ - c m₂| ≤ |c m₁ - w m₁| + |c m₂ - w m₁| := by
          have : c m₁ - c m₂ = (c m₁ - w m₁) - (c m₂ - w m₁) := by ring
          rw [this]
