      (fun _ => Metric.isOpen_ball)
      (fun ζ hζ => Set.mem_iUnion.mpr ⟨⟨ζ, hζ⟩, Metric.mem_ball_self (hρ_pos ⟨ζ, hζ⟩)⟩)
