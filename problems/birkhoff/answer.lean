    · rw [abs_of_nonneg hy0] at hry_le; linarith
    · rw [abs_of_neg hy0] at hry_le; linarith
  
  have hStopX_eq_of_E : ∀ m (w : ℕ → ℝ), E_pred m w → dtpcStopX R g m w = g m (w m) := by
