      IsOpen V →
      0 ≤ M_G →
      0 ≤ B →
      DifferentiableOn ℂ G V →
      (∀ j : ℕ, j ≤ p → ∀ w ∈ V, ‖iteratedDeriv j G w‖ ≤ M_G) →
      DifferentiableOn ℂ f (horizStrip σ') →
      (∀ z ∈ horizStrip σ', f z ∈ V) →
      (∀ j : ℕ, 1 ≤ j → j ≤ p → ∀ z ∈ horizStrip σ', ‖iteratedDeriv j f z‖ ≤ B) →
      IsSkrStripBnd p σ' (M_G * skrCompConst p B) (fun z => G (f z)) := by
    intro p
    induction p with
    | zero =>
      intro σ' M_G B V G f _hV_open _hM_G _hB hG hG_bnd hf hf_maps _hf_bnd
      refine ⟨hG.comp hf hf_maps, ?_⟩
      intro k hk z hz
      have hk0 : k = 0 := Nat.le_zero.mp hk
      subst hk0
      simp only [iteratedDeriv_zero, skrCompConst, mul_one]
      simpa only [iteratedDeriv_zero] using hG_bnd 0 le_rfl (f z) (hf_maps z hz)
    | succ p ih =>
      intro σ' M_G B V G f hV_open hM_G hB hG hG_bnd hf hf_maps hf_bnd
      refine ⟨hG.comp hf hf_maps, ?_⟩
      intro k hk z hz
      cases k with
      | zero =>
        simp only [iteratedDeriv_zero]
        have h0 : ‖G (f z)‖ ≤ M_G := by
