        intro m
        exact (((h_cont_on K m).mono hcb).integrableOn_compact (isCompact_closedBall z₀ Δ)).mono_set
          Metric.ball_subset_closedBall
      have htrunc_nonneg : ∀ m : ℕ, 0 ≤ᵐ[μ] ldtTruncDeficit S K m := by
        intro m
        rw [Filter.EventuallyLE, MeasureTheory.ae_restrict_iff' measurableSet_ball]
