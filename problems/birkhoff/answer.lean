          deriv F_W (glancingMidAngle C y t) * deriv (fun y' => glancingMidAngle C y' t) y := by
        change deriv (F_W ∘ fun y' => glancingMidAngle C y' t) y = _
        exact deriv_comp y hFW_diff hMid_y
      have hWt : deriv (fun t' => pairIsoW (fun i w => glancingImpact C w.1 w.2 i) (y, t')) t =
