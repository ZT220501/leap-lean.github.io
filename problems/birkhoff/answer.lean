    let A_amp : ℝ := 4 * C_dip
    have hA_pos : 0 < A_amp := by positivity
    let ε_cap : ℝ := min η_plus C_dip
    have hε_pos : 0 < ε_cap := lt_min hη hCdip
    let N : ℕ := Nat.ceil ((2 * A_amp / ε_cap) ^ 2) + 1
