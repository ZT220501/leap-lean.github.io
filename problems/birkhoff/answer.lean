      simp
  have hHolo_add : ∀ {H₁ H₂ : ℂ → ℂ}, paJetHoloAtZero H₁ → paJetHoloAtZero H₂ →
      paJetHoloAtZero (fun z => H₁ z + H₂ z) ∧
      holoTaylor1D (fun z => H₁ z + H₂ z) 0 = holoTaylor1D H₁ 0 + holoTaylor1D H₂ 0 := by
    rintro H₁ H₂ ⟨⟨U₁, hU₁, h0₁, hd₁⟩⟩ ⟨⟨U₂, hU₂, h0₂, hd₂⟩⟩
    refine ⟨⟨⟨U₁ ∩ U₂, hU₁.inter hU₂, ⟨h0₁, h0₂⟩,
      (hd₁.mono Set.inter_subset_left).add (hd₂.mono Set.inter_subset_right)⟩⟩, ?_⟩
    ext n
    simp only [holoTaylor1D, PowerSeries.coeff_mk, map_add]
    rw [iteratedDeriv_fun_add (hHolo_contDiff ⟨⟨U₁, hU₁, h0₁, hd₁⟩⟩ n)
      (hHolo_contDiff ⟨⟨U₂, hU₂, h0₂, hd₂⟩⟩ n), add_div]
  have hHolo_sub : ∀ {H₁ H₂ : ℂ → ℂ}, paJetHoloAtZero H₁ → paJetHoloAtZero H₂ →
      paJetHoloAtZero (fun z => H₁ z - H₂ z) ∧
      holoTaylor1D (fun z => H₁ z - H₂ z) 0 = holoTaylor1D H₁ 0 - holoTaylor1D H₂ 0 := by
    rintro H₁ H₂ ⟨⟨U₁, hU₁, h0₁, hd₁⟩⟩ ⟨⟨U₂, hU₂, h0₂, hd₂⟩⟩
    refine ⟨⟨⟨U₁ ∩ U₂, hU₁.inter hU₂, ⟨h0₁, h0₂⟩,
      (hd₁.mono Set.inter_subset_left).sub (hd₂.mono Set.inter_subset_right)⟩⟩, ?_⟩
    ext n
    simp only [holoTaylor1D, PowerSeries.coeff_mk, map_sub]
    rw [iteratedDeriv_fun_sub (hHolo_contDiff ⟨⟨U₁, hU₁, h0₁, hd₁⟩⟩ n)
      (hHolo_contDiff ⟨⟨U₂, hU₂, h0₂, hd₂⟩⟩ n), sub_div]
  have hHolo_mul : ∀ {H₁ H₂ : ℂ → ℂ}, paJetHoloAtZero H₁ → paJetHoloAtZero H₂ →
      paJetHoloAtZero (fun z => H₁ z * H₂ z) ∧
      holoTaylor1D (fun z => H₁ z * H₂ z) 0 = holoTaylor1D H₁ 0 * holoTaylor1D H₂ 0 := by
    rintro H₁ H₂ ⟨⟨U₁, hU₁, h0₁, hd₁⟩⟩ ⟨⟨U₂, hU₂, h0₂, hd₂⟩⟩
    refine ⟨⟨⟨U₁ ∩ U₂, hU₁.inter hU₂, ⟨h0₁, h0₂⟩,
      (hd₁.mono Set.inter_subset_left).mul (hd₂.mono Set.inter_subset_right)⟩⟩, ?_⟩
    ext n
    rw [PowerSeries.coeff_mul, Finset.Nat.sum_antidiagonal_eq_sum_range_succ
      (fun i j => PowerSeries.coeff i (holoTaylor1D H₁ 0) * PowerSeries.coeff j (holoTaylor1D H₂ 0))]
    simp only [holoTaylor1D, PowerSeries.coeff_mk]
    rw [iteratedDeriv_fun_mul (hHolo_contDiff ⟨⟨U₁, hU₁, h0₁, hd₁⟩⟩ n)
      (hHolo_contDiff ⟨⟨U₂, hU₂, h0₂, hd₂⟩⟩ n), Finset.sum_div]
    apply Finset.sum_congr rfl
    intro i hi
    have hi_le : i ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
    have hfac_nat : (n.choose i : ℂ) * (i.factorial : ℂ) * ((n - i).factorial : ℂ) =
        (n.factorial : ℂ) := by exact_mod_cast Nat.choose_mul_factorial_mul_factorial hi_le
    have hnf : (n.factorial : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero n)
    have hif : (i.factorial : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero i)
    have hmf : ((n - i).factorial : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)
    rw [div_mul_div_comm, div_eq_div_iff hnf (mul_ne_zero hif hmf)]
    linear_combination (iteratedDeriv i H₁ 0 * iteratedDeriv (n - i) H₂ 0) * hfac_nat
  have hHolo_pow : ∀ {H : ℂ → ℂ}, paJetHoloAtZero H → ∀ k : ℕ,
      paJetHoloAtZero (fun z => H z ^ k) ∧
