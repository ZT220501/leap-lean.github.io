                intro A₁ A₂ B_ser hA
                have hvbA : lineCoreVanishesBelow (n + 1) (A₁ - A₂) := by
                  intro u hu
                  rw [map_sub, hA u (by omega), sub_self]
                have hvbP : lineCoreVanishesBelow (n + 1) ((A₁ - A₂) * B_ser) := by
                  simpa using hSub.vanishesBelow_mul hvbA (h_vb_zero B_ser)
                have h0 := hvbP d (by omega)
                rw [sub_mul, map_sub] at h0
                exact sub_eq_zero.mp h0
              congr 1
              · congr 1
                · exact h_prod_eq _ _ _ (fun u hu =>
                    h_comp_deriv_trunc1D n (h_ser _) _ u hu)
                · exact h_prod_eq _ _ _ (fun u hu =>
                    h_comp_trunc1D (n + 1) (h_ser _) _ u (by omega))
              · congr 1
                · exact h_prod_eq _ _ _ (fun u hu =>
                    h_comp_deriv_trunc1D n (h_ser _) _ u hu)
                · exact h_prod_eq _ _ _ (fun u hu =>
                    h_comp_trunc1D (n + 1) (h_ser _) _ u (by omega))
            rw [h_eq, hGrad_tay r, map_zero]
          
          have h_edge_pert : ∀ i : Fin k,
              let h0 := PowerSeries.coeff 0 (h_ser i)
              let h1 := PowerSeries.coeff 1 (h_ser i)
              let h2 := 2 * PowerSeries.coeff 2 (h_ser i)
              let δη_m := MvPowerSeries.coeff d (η i.castSucc)
              let δη_p := MvPowerSeries.coeff d (η i.succ)
              MvPowerSeries.coeff d
                  (lcJetEdgePlus2D (h_tr i) (S_ser i) (C_ser i)
                    (lcJetMid2D α_ser i) (lcJetHalfStep2D α_ser i) -
                   lcJetEdgePlus2D (h_tr i) (S_ser i) (C_ser i)
                    (lcJetMid2D α_ref i) (lcJetHalfStep2D α_ref i)) =
                ((h2 - h0) / 2 * s_d i + h1 * c_d i) * δη_p +
                  (h0 + h2) / 2 * s_d i * δη_m ∧
              MvPowerSeries.coeff d
                  (lcJetEdgeMinus2D (h_tr i) (S_ser i) (C_ser i)
                    (lcJetMid2D α_ser i) (lcJetHalfStep2D α_ser i) -
                   lcJetEdgeMinus2D (h_tr i) (S_ser i) (C_ser i)
                    (lcJetMid2D α_ref i) (lcJetHalfStep2D α_ref i)) =
                (h0 + h2) / 2 * s_d i * δη_p +
                  ((h2 - h0) / 2 * s_d i - h1 * c_d i) * δη_m := by
            intro i h0 h1 h2 δη_m δη_p
            let ψ0 := lcJetMid2D α_ref i
            let ηψ := lcJetMid2D η i
            let d0 := lcJetHalfStep2D α_ref i
            let ηd := lcJetHalfStep2D η i
            have hψ_split : lcJetMid2D α_ser i = ψ0 + ηψ := by
              ext u
              simp only [lcJetMid2D, ψ0, ηψ, η, MvPowerSeries.coeff_C_mul, map_add, map_sub]
              ring
            have hd_split : lcJetHalfStep2D α_ser i = d0 + ηd := by
              ext u
              simp only [lcJetHalfStep2D, d0, ηd, η, MvPowerSeries.coeff_C_mul, map_add, map_sub]
              ring
            have hηψ_vb : lineCoreVanishesBelow n ηψ :=
              h_vb_C_mul _ (h_vb_add (hη_vb i.castSucc) (hη_vb i.succ))
            have hηd_vb : lineCoreVanishesBelow n ηd :=
