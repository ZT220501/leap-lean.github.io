        have hHess_sum : (∑ s : Fin (k - 1),
            pointInteriorHess ℓ₀ F (deriv F) (deriv (deriv F)) x₀ r s *
              β_top ⟨s.1 + 1, by have := s.2; omega⟩) =
            diag_c * β_top i_L.succ + sup_c * β_top i_R.succ + sub_c * β_top i_L.castSucc := by
          rw [Finset.sum_congr rfl fun s _ => hHess_split s, Finset.sum_add_distrib,
