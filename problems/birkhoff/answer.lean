  have h_lam_psi_S0 : ∀ z ∈ S_strip 8 (4 * Real.pi),
      lamZ z ≠ 0 ∧
      (lamZ z) ^ 3 = 12 * PhiQ z ∧
      ‖lamZ z - (Λ : ℂ)‖ < Λ / 4 ∧
      HasDerivAt PhiQ (2 * z * Complex.tanh z / (Complex.cosh z) ^ 2) z ∧
