  obtain ⟨hcont_F, hcont_Full, hF_le_Full, hG_cont, hG_mono, hG_lower, hattains,
    hslab_le, hbump, hpoisson, hq_sup⟩ := hPart1
  
  have hG_upper : ∀ j : ℝ, k₀ ≤ j → rowLogMaxF j ≤ 3 * j + hPoly.C_poly := by
    intro j hj
    obtain ⟨x_max, _, hx_eq⟩ := hattains j hj
    let z : ℂ := (x_max : ℂ) + ((S.H - Real.exp (-j) : ℝ) : ℂ) * Complex.I
    have hf_le_mod : ‖S.f z‖ ≤ shapeModulus S z := le_max_left _ _
    have hmod_le := hPoly.modulus_sup_poly_bound j hj x_max
    have hexp_G : Real.exp (rowLogMaxF j) ≤ Real.exp j * (hPoly.C_poly * (1 + j) ^ 2) := by
      calc Real.exp (rowLogMaxF j) = ‖S.f z‖ := hx_eq.symm
        _ ≤ shapeModulus S z := hf_le_mod
        _ = Real.exp j * (Real.exp (-j) * shapeModulus S z) := by
            rw [← mul_assoc, ← Real.exp_add, add_neg_cancel, Real.exp_zero, one_mul]
        _ ≤ Real.exp j * (hPoly.C_poly * (1 + j) ^ 2) :=
            mul_le_mul_of_nonneg_left hmod_le (le_of_lt (Real.exp_pos j))
    have hc_le : hPoly.C_poly ≤ Real.exp hPoly.C_poly := by
      linarith [Real.add_one_le_exp hPoly.C_poly]
    have h1j_le : (1 + j) ^ 2 ≤ Real.exp (2 * j) := by
      have h1 : 1 + j ≤ Real.exp j := by linarith [Real.add_one_le_exp j]
      calc (1 + j) ^ 2 ≤ (Real.exp j) ^ 2 := sq_le_sq' (by linarith) h1
        _ = Real.exp (2 * j) := by rw [sq, ← Real.exp_add]; ring_nf
    have hexp_tot : Real.exp (rowLogMaxF j) ≤ Real.exp (3 * j + hPoly.C_poly) := by
      calc Real.exp (rowLogMaxF j)
          ≤ Real.exp j * (hPoly.C_poly * (1 + j) ^ 2) := hexp_G
        _ ≤ Real.exp j * (Real.exp hPoly.C_poly * Real.exp (2 * j)) := by
            apply mul_le_mul_of_nonneg_left _ (le_of_lt (Real.exp_pos j))
            exact mul_le_mul hc_le h1j_le (sq_nonneg _) (le_of_lt (Real.exp_pos _))
        _ = Real.exp (3 * j + hPoly.C_poly) := by
            rw [← mul_assoc, ← Real.exp_add, ← Real.exp_add]; congr 1; ring
    exact Real.exp_le_exp.mp hexp_tot
  
  
  
  have hPart2 : ∃ C_jmp c_jmp K₀ : ℝ,
