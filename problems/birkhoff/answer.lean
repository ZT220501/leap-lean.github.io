            lt_min (by positivity) (div_pos hε hC_lip_pos), ?_⟩
          intro τ hτ
          have hτ_norm : ‖τ‖ < min (3 * r_τ_raw / 4) (ε / C_lip) := by
            simpa [dist_zero_right] using hτ
          have hy_cl : y ∈ Metric.closedBall (Br.y₀ : ℂ) (9 * Br.r_y / 16) :=
