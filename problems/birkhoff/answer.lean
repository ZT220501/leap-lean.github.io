            (C.h_ℂ ψ * Complex.sin ψ + deriv C.h_ℂ ψ * Complex.cos ψ) * Complex.sin θ =
            C.h_ℂ ψ * Complex.cos (ψ - θ) - deriv C.h_ℂ ψ * Complex.sin (ψ - θ) := by
          intro ψ θ
          rw [Complex.cos_sub, Complex.sin_sub]
          ring
        have hr0 : L.𝔰_raw p = K.𝔰_init p := L.𝔰_raw_init_eq p.1 p.2 h1 h3
        have hrm : L.𝔰_raw (p.1 - p.2, p.2) = K.𝔰_init (p.1 - p.2, p.2) :=
          L.𝔰_raw_init_eq (p.1 - p.2) p.2 h2 h3
        have himp0 := K.𝔰_init_impact p.1 p.2 h1 h3
        have himp0_0 := congr_fun himp0 0
        have himp0_1 := congr_fun himp0 1
        simp only [glancingImpact, glancingMidAngle, glancingTheta,
          Matrix.cons_val_zero, Matrix.cons_val_one] at himp0_0 himp0_1
        have himpm := K.𝔰_init_impact (p.1 - p.2) p.2 h2 h3
        have himpm_0 := congr_fun himpm 0
        have himpm_1 := congr_fun himpm 1
        simp only [glancingImpact, glancingMidAngle, glancingTheta,
          Matrix.cons_val_zero, Matrix.cons_val_one] at himpm_0 himpm_1
        set w' : ℂ := p.1 - p.2 / 2
        have hw_plus : p.1 + p.2 / 2 = w' + p.2 := by dsimp [w']; ring
        have hw_minus1 : p.1 - p.2 - p.2 / 2 = w' - p.2 := by dsimp [w']; ring
        have hw_minus2 : p.1 - p.2 + p.2 / 2 = w' := by dsimp [w']; ring
        have heq0 : K.Γ (L.𝔰_raw p) 0 * Complex.cos (Θ_sh p) +
