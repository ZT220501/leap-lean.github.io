      obtain ⟨_, hb₁_bnd, _, hb_lip⟩ :=
        H_jet.jet_pt_bounds w hw y₁ y₂ (σ * u₁) (σ * u₂) hσu₁ hσu₂
      have hσ_diff : |σ * u₁ - σ * u₂| ≤ (q : ℝ) * M := by
