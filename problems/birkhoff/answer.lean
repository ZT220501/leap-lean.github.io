  have h_interval_pigeonhole : ∀ (a b δ : ℝ) (S_near : Finset ℝ) (F_avoid : Set ℝ),
      0 < δ → 4 * ((S_near.card : ℝ) + 1) * δ ≤ b - a → F_avoid.Finite →
      ∃ t ∈ Set.Ioo a b, t ∉ F_avoid ∧ ∀ r ∈ S_near, δ ≤ |t - r| := by
    intro a b δ S_near F_avoid hδ hlen hF
    let M : ℕ := S_near.card + 1
    let c : Fin M → ℝ := fun m => a + (4 * (m.1 : ℝ) + 2) * δ
    have h_exists_center : ∃ m : Fin M, ∀ r ∈ S_near, (3 / 2 : ℝ) * δ ≤ |c m - r| := by
      by_contra! h_bad
      choose w hw_mem hw_lt using h_bad
      have h_maps : Set.MapsTo w ↑(Finset.univ : Finset (Fin M)) ↑S_near := by
        intro m _
        exact Finset.mem_coe.mpr (hw_mem m)
      have h_card : S_near.card < (Finset.univ : Finset (Fin M)).card := by
        simp [M]
      obtain ⟨m₁, _, m₂, _, h_ne, h_eq⟩ :=
        Finset.exists_ne_map_eq_of_card_lt_of_maps_to h_card h_maps
      have h_idx_gap : (1 : ℝ) ≤ |(m₁.1 : ℝ) - (m₂.1 : ℝ)| := by
        have h_val_ne : m₁.1 ≠ m₂.1 := fun h => h_ne (Fin.ext h)
        rcases lt_or_gt_of_ne h_val_ne with hlt | hgt
        · have hle : (m₁.1 : ℝ) + 1 ≤ (m₂.1 : ℝ) := by exact_mod_cast Nat.succ_le_of_lt hlt
          rw [abs_of_nonpos (by linarith)]
          linarith
        · have hle : (m₂.1 : ℝ) + 1 ≤ (m₁.1 : ℝ) := by exact_mod_cast Nat.succ_le_of_lt hgt
          rw [abs_of_nonneg (by linarith)]
          linarith
      have hc_gap : 4 * δ ≤ |c m₁ - c m₂| := by
        have h_diff : c m₁ - c m₂ = 4 * ((m₁.1 : ℝ) - (m₂.1 : ℝ)) * δ := by
          dsimp [c]
          ring
        rw [h_diff, abs_mul, abs_mul, abs_of_pos (by norm_num : (0 : ℝ) < 4), abs_of_pos hδ]
        nlinarith
