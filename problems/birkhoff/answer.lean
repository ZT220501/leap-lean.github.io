      · have hsl_ι : MvPowerSeries.coeff d
            (pointArcSlice2D1D 0 (ι₀ (compPowerSeries2D (f_u j) (pointArcSlice2D1D 0 Z₀)))) =
            MvPowerSeries.coeff d (compPowerSeries2D (f_u j) (pointArcSlice2D1D 0 Z₀)) := by
          change PowerSeries.coeff 0 (PowerSeries.C _) = _
          rw [PowerSeries.coeff_C, if_pos rfl]
        rw [hsl_ι]
        change PowerSeries.coeff 0 (MvPowerSeries.coeff d
            (∑ n ∈ Finset.range (M + 1),
              MvPowerSeries.C (PowerSeries.C (PowerSeries.coeff n (f_u j))) * Z₀ ^ n)) =
          ∑ n ∈ Finset.range (d 0 + d 1 + 1),
            PowerSeries.coeff n (f_u j) * MvPowerSeries.coeff d ((pointArcSlice2D1D 0 Z₀) ^ n)
        rw [map_sum, map_sum]
        have hterm_n : ∀ n : ℕ,
            PowerSeries.coeff 0 (MvPowerSeries.coeff d
              (MvPowerSeries.C (PowerSeries.C (PowerSeries.coeff n (f_u j))) * Z₀ ^ n)) =
              PowerSeries.coeff n (f_u j) * MvPowerSeries.coeff d ((pointArcSlice2D1D 0 Z₀) ^ n) := by
          intro n
          rw [MvPowerSeries.coeff_C_mul, PowerSeries.coeff_C_mul, ← hslice0_pow]
          rfl
        simp_rw [hterm_n]
        symm
        refine Finset.sum_subset (Finset.range_mono (by omega)) ?_
        intro n _ hnd
        rw [Finset.mem_range] at hnd
        rw [hVB2D_pow hZ0 n d (by omega), mul_zero]
      · rfl
    have hMod_comp_arg_pert : ∀ {J : ℕ} (g_seq : ℕ → PowerSeries ℂ)
        {Z₀ : MvPowerSeries (Fin 2) (PowerSeries ℂ)} (δ : MvPowerSeries (Fin 2) ℂ),
        MvPowerSeries.coeff 0 (pointArcSlice2D1D 0 Z₀) = 0 →
        ModEq (J + 1)
          (pointArcComp2D1D g_seq (Z₀ + X_ε ^ (J + 1) * ι₀ δ))
          (pointArcComp2D1D g_seq Z₀ +
            X_ε ^ (J + 1) *
              ι₀ (compPowerSeries2D (PowerSeries.derivative (g_seq 0))
                (pointArcSlice2D1D 0 Z₀) * δ)) := by
      intro J g_seq Z₀ δ hZ0
      let j := J + 1
      have hj1 : 1 ≤ j := Nat.succ_pos J
      let Z₀₀ := pointArcSlice2D1D 0 Z₀
      let Z₁ := Z₀ + X_ε ^ j * ι₀ δ
      have hXj_VE : ∀ Φ : MvPowerSeries (Fin 2) ℂ, VanishesEps j (X_ε ^ j * ι₀ Φ) :=
        fun Φ => hVE_mul_any (ι₀ Φ) (hVE_X_pow j)
      have hZ₁_slice0 : pointArcSlice2D1D 0 Z₁ = Z₀₀ := by
