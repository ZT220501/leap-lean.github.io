      obtain ⟨hXW_z, hXW_t⟩ := hslice_diff hXW_W₁ (z, t) hp
      have hev_z : (fun z' => X_Z (z', t)) =ᶠ[nhds z] (fun z' => G.Z_loc (v (z', t))) := by
        filter_upwards [Metric.ball_mem_nhds z₀ hr₁_pos |> fun h =>
