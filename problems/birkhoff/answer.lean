        linarith [Real.exp_pos ((-2 * lam + 3 * η j) * u j)]
      · have h1 := (h_level_osc j).2.1 q_j hqj_σL w hw_σL
        have h2 := (h_level_osc j).1 (z_pt j) (hz_mem j) q_j hqj_γ
        calc ‖C₀ w - C₀ (z_pt j)‖
            = ‖(C₀ w - C₀ q_j) + (C₀ q_j - C₀ (z_pt j))‖ := by ring_nf
          _ ≤ ‖C₀ w - C₀ q_j‖ + ‖C₀ q_j - C₀ (z_pt j)‖ := norm_add_le _ _
          _ ≤ 4 * Real.exp ((-2 * lam + 3 * η j) * u j) := by linarith
      · have h1 := (h_level_osc j).2.2 qp_j hqp_σR w hw_σR
        have h2 := (h_level_osc j).1 (z_pt j) (hz_mem j) qp_j hqp_γ
        calc ‖C₀ w - C₀ (z_pt j)‖
            = ‖(C₀ w - C₀ qp_j) + (C₀ qp_j - C₀ (z_pt j))‖ := by ring_nf
          _ ≤ ‖C₀ w - C₀ qp_j‖ + ‖C₀ qp_j - C₀ (z_pt j)‖ := norm_add_le _ _
          _ ≤ 4 * Real.exp ((-2 * lam + 3 * η j) * u j) := by linarith
    have h_w_cstar : ‖C₀ w - c_star‖ ≤ C_osc * Real.exp ((-2 * lam + 3 * η j) * u j) := by
      have h_zj := h_tail_dist j hj
      calc ‖C₀ w - c_star‖
          = ‖(C₀ w - C₀ (z_pt j)) + (C₀ (z_pt j) - c_star)‖ := by ring_nf
        _ ≤ ‖C₀ w - C₀ (z_pt j)‖ + ‖C₀ (z_pt j) - c_star‖ := norm_add_le _ _
        _ ≤ 4 * Real.exp ((-2 * lam + 3 * η j) * u j) +
            (6 / (1 - Real.exp (-1))) * Real.exp ((-2 * lam + 3 * η j) * u j) :=
            add_le_add h_w_zj h_zj
        _ = C_osc * Real.exp ((-2 * lam + 3 * η j) * u j) := by dsimp [C_osc]; ring
    have hη_j : η j ≤ 1 / 8 := hη_le j hj
    have hu_j : 1 ≤ u j := (hu_step j).1
    rw [norm_mul]
    calc ‖F w‖ * ‖C₀ w - c_star‖
        ≤ Real.exp ((lam + η j) * u j) * (C_osc * Real.exp ((-2 * lam + 3 * η j) * u j)) :=
          mul_le_mul h_mod_w.2 h_w_cstar (norm_nonneg _) (le_of_lt (Real.exp_pos _))
      _ = C_osc * Real.exp ((-lam + 4 * η j) * u j) := by
          rw [mul_left_comm, ← Real.exp_add]
          congr 2; ring
      _ ≤ C_osc * Real.exp (-(1 / 2 : ℝ) * u j) := by
          apply mul_le_mul_of_nonneg_left _ (le_of_lt hC_osc_pos)
          apply Real.exp_le_exp.mpr
          nlinarith
  
  obtain ⟨C₀, hC₀_deriv, hG_prod⟩ := hs1_ode
  obtain ⟨u, A, B, η, γ, σ_left, σ_right, hγ, hσL, hσR,
    hu_step, hu_top, hAB, hB_zero, hη_pos, hη_anti, hη_zero, hmesh⟩ :=
    hPolyMesh.exists_mesh
  have hu_mono : Monotone u :=
    monotone_nat_of_le_succ (fun n => by linarith [(hu_step n).2])
  have hA_strictAnti : StrictAnti A :=
    strictAnti_nat_of_succ_lt (fun n => by linarith [(hAB (n + 1)).2.1, (hAB n).2.2])
  have h_sub : ∀ j : ℕ,
      meshPolyTrace (γ j) ⊆ criticalLowerHalfPlane ∧
      meshPolyTrace (σ_left j) ⊆ criticalLowerHalfPlane ∧
      meshPolyTrace (σ_right j) ⊆ criticalLowerHalfPlane := by
    intro j
    rcases hmesh j with ⟨hγ_tr, _, _, hσL_tr, _, _, hσR_tr, _⟩
    refine ⟨?_, ?_, ?_⟩
    · intro w hw
      have hw_im := (hγ_tr w hw).2.2.1
      have hA_pos := (hAB j).1
      change w.im < 0; linarith
    · intro w hw
      have hw_im := (hσL_tr w hw).2.2
      change w.im < 0; linarith
    · intro w hw
      have hw_im := (hσR_tr w hw).2.2
      change w.im < 0; linarith
  have h_cross_pair : ∀ j k : ℕ, B k ≤ B j → A (j + 2) ≤ A k →
      (meshPolyTrace (γ k) ∩ meshPolyTrace (σ_left j)).Nonempty ∧
      (meshPolyTrace (γ k) ∩ meshPolyTrace (σ_right j)).Nonempty := by
    intro j k hBk hAk
    rcases hmesh k with ⟨hγk_tr, hγk_hd, hγk_tl, _⟩
    rcases hmesh j with ⟨_, _, _, hσL_tr, hσL_hd, hσL_tl, hσR_tr, hσR_hd, hσR_tl, _⟩
    refine ⟨hs2_cross (γ k) (σ_left j) (hγ k) (hσL j) (-2.4) 2.4 (-B k) (-A k)
        (by norm_num) (by linarith [(hAB k).2.1]) ?_ (by linarith) (by linarith) ?_
        (by linarith) (by linarith),
      hs2_cross (γ k) (σ_right j) (hγ k) (hσR j) (-2.4) 2.4 (-B k) (-A k)
        (by norm_num) (by linarith [(hAB k).2.1]) ?_ (by linarith) (by linarith) ?_
        (by linarith) (by linarith)⟩
    · intro w hw; have h := hγk_tr w hw; exact ⟨by linarith, by linarith⟩
    · intro w hw; have h := hσL_tr w hw; exact ⟨by linarith, by linarith⟩
    · intro w hw; have h := hγk_tr w hw; exact ⟨by linarith, by linarith⟩
    · intro w hw; have h := hσR_tr w hw; exact ⟨by linarith, by linarith⟩
  have h_len : ∀ j : ℕ,
      meshPolyLength (γ j) ≤ Real.exp (η j * u j) ∧
      meshPolyLength (σ_left j) ≤ Real.exp (η j * u j) ∧
      meshPolyLength (σ_right j) ≤ Real.exp (η j * u j) := by
    intro j
    rcases hmesh j with ⟨_, _, _, _, _, _, _, _, _, hγ_len, hσL_len, hσR_len, _⟩
    exact ⟨hγ_len, hσL_len, hσR_len⟩
  have h_mod : ∀ j : ℕ,
      ∀ w ∈ meshPolyTrace (γ j) ∪ meshPolyTrace (σ_left j) ∪ meshPolyTrace (σ_right j),
        Real.exp ((lam - η j) * u j) ≤ ‖F w‖ ∧
        ‖F w‖ ≤ Real.exp ((lam + η j) * u j) := by
    intro j
    rcases hmesh j with ⟨_, _, _, _, _, _, _, _, _, _, _, _, h_mod_j⟩
    exact h_mod_j
  have h_cross : ∀ j : ℕ,
      (meshPolyTrace (γ j) ∩ meshPolyTrace (σ_left j)).Nonempty ∧
      (meshPolyTrace (γ (j + 1)) ∩ meshPolyTrace (σ_left j)).Nonempty ∧
      (meshPolyTrace (γ j) ∩ meshPolyTrace (σ_right j)).Nonempty := by
    intro j
    have hj0 := h_cross_pair j j le_rfl (hA_strictAnti.antitone (by omega))
    have hj1 := h_cross_pair j (j + 1)
      (by linarith [(hAB j).2.1, (hAB j).2.2]) (hA_strictAnti.antitone (by omega))
    exact ⟨hj0.1, hj1.1, hj0.2⟩
  obtain ⟨c_star, C_osc, J₀, hC_osc, h_prod_bd⟩ :=
    hs5_tele C₀ u η γ σ_left σ_right hγ hσL hσR
      hC₀_deriv hu_step hη_pos hη_anti hη_zero h_sub h_len h_mod h_cross
  obtain ⟨G, hG_holo, ⟨z_nz, hz_nz_mem, hz_nz⟩, hG_eq⟩ := hG_prod c_star
  have hG_mesh_bd : ∀ m ≥ J₀,
      ∀ w ∈ meshPolyTrace (γ m) ∪ meshPolyTrace (σ_left m) ∪ meshPolyTrace (σ_right m),
        ‖G w‖ ≤ C_osc * Real.exp (-(1 / 2 : ℝ) * u m) := by
    intro m hm w hw
    have hw_mem : w ∈ criticalLowerHalfPlane := by
      rcases hw with (hwγ | hwL) | hwR
      · exact (h_sub m).1 hwγ
      · exact (h_sub m).2.1 hwL
      · exact (h_sub m).2.2 hwR
    obtain ⟨hw_ne, hw_bd⟩ := h_prod_bd m hm w hw
    rw [hG_eq w hw_mem hw_ne]
    exact hw_bd
  have hG_decay : ∀ ε : ℝ, 0 < ε → ∃ δ₀ : ℝ, 0 < δ₀ ∧
      ∀ x δ : ℝ, |x| ≤ 1 → 0 < δ → δ < δ₀ →
        ‖G ((x : ℂ) - (δ : ℂ) * Complex.I)‖ < ε := by
    intro ε hε
    obtain ⟨N_u, hN_u⟩ :=
      Filter.eventually_atTop.mp (Filter.tendsto_atTop.mp hu_top (2 * Real.log (C_osc / ε) + 1))
    let J₁ : ℕ := max J₀ N_u
    have hJ₀_le_J₁ : J₀ ≤ J₁ := le_max_left J₀ N_u
    have hu_J₁ : 2 * Real.log (C_osc / ε) + 1 ≤ u J₁ := hN_u J₁ (le_max_right J₀ N_u)
    have h_exp_J₁ : C_osc * Real.exp (-(1 / 2 : ℝ) * u J₁) < ε := by
      have hdiv_pos : 0 < ε / C_osc := div_pos hε hC_osc
      have hlog_eq : -Real.log (C_osc / ε) = Real.log (ε / C_osc) := by
        rw [← Real.log_inv, inv_div]
      have hexp_lt : Real.exp (-(1 / 2 : ℝ) * u J₁) < ε / C_osc := by
        rw [← Real.exp_log hdiv_pos]
        apply Real.exp_lt_exp.mpr
        linarith
      calc C_osc * Real.exp (-(1 / 2 : ℝ) * u J₁)
          < C_osc * (ε / C_osc) := mul_lt_mul_of_pos_left hexp_lt hC_osc
        _ = ε := mul_div_cancel₀ ε (ne_of_gt hC_osc)
    refine ⟨A J₁, (hAB J₁).1, ?_⟩
    intro x δ hx hδ hδ_lt
    obtain ⟨M_B, hM_B⟩ := Metric.tendsto_atTop.mp hB_zero δ hδ
    have h_ex : ∃ m : ℕ, A m < δ := by
      refine ⟨M_B, ?_⟩
      have hdist : dist (B M_B) 0 < δ := hM_B M_B le_rfl
      rw [Real.dist_eq, sub_zero, abs_of_pos (lt_trans (hAB M_B).1 (hAB M_B).2.1)] at hdist
      linarith [(hAB M_B).2.1]
    classical
    let m : ℕ := Nat.find h_ex
    have hm_spec : A m < δ := Nat.find_spec h_ex
    have hJ₁_lt_m : J₁ < m := by
      by_contra h_not
      have h_le : A J₁ ≤ A m := hA_strictAnti.antitone (le_of_not_gt h_not)
      linarith
    obtain ⟨j, hm_eq⟩ : ∃ j : ℕ, m = j + 1 :=
      Nat.exists_eq_succ_of_ne_zero (by omega)
    rw [hm_eq] at hm_spec
    have hJ₁_le_j : J₁ ≤ j := by omega
    have hJ₀_le_j : J₀ ≤ j := le_trans hJ₀_le_J₁ hJ₁_le_j
    have hδ_le_Aj : δ ≤ A j := by
      have h_not_lt : ¬ (A j < δ) := Nat.find_min h_ex (by omega)
      linarith
    let z₀ : ℂ := (x : ℂ) - (δ : ℂ) * Complex.I
    have hz₀_re : z₀.re = x := by simp [z₀]
    have hz₀_im : z₀.im = -δ := by simp [z₀]
    have hz₀_mem : z₀ ∈ criticalLowerHalfPlane := by
      change z₀.im < 0; linarith
    let M_bound : ℝ := C_osc * Real.exp (-(1 / 2 : ℝ) * u j)
    have hM_nonneg : 0 ≤ M_bound :=
      mul_nonneg (le_of_lt hC_osc) (le_of_lt (Real.exp_pos _))
    have hx_bounds : -1 ≤ x ∧ x ≤ 1 := abs_le.mp hx
    have h_cj0 := h_cross_pair j j le_rfl (hA_strictAnti.antitone (by omega))
    have h_cj2 := h_cross_pair j (j + 2)
      (by linarith [(hAB j).2.1, (hAB j).2.2, (hAB (j + 1)).2.1, (hAB (j + 1)).2.2]) le_rfl
    have hz₀_bd : ‖G z₀‖ ≤ M_bound := by
      refine hs3_max G z₀ M_bound
        (γ j) (σ_right j) (γ (j + 2)) (σ_left j)
        (hγ j) (hσR j) (hγ (j + 2)) (hσL j)
        hG_holo hz₀_mem hM_nonneg
        (h_sub j).1 (h_sub j).2.2 (h_sub (j + 2)).1 (h_sub j).2.1
        ?_ ?_ ?_ ?_ h_cj0.1 h_cj0.2 h_cj2.2 h_cj2.1
      · intro w hw
        rcases hmesh j with ⟨hγ_tr, _⟩
        have hw_im := (hγ_tr w hw).2.2.1
        exact ⟨by linarith, hG_mesh_bd j hJ₀_le_j w (Or.inl (Or.inl hw))⟩
      · intro w hw
        rcases hmesh j with ⟨_, _, _, _, _, _, hσR_tr, _⟩
        have hw_re := (hσR_tr w hw).1
        exact ⟨by linarith, hG_mesh_bd j hJ₀_le_j w (Or.inr hw)⟩
      · intro w hw
        rcases hmesh (j + 2) with ⟨hγ2_tr, _⟩
        have hw_im := (hγ2_tr w hw).2.2.2
        have hB2_lt : B (j + 2) < A (j + 1) := (hAB (j + 1)).2.2
        have hu_le : u j ≤ u (j + 2) := hu_mono (by omega)
        have h_bd2 : ‖G w‖ ≤ C_osc * Real.exp (-(1 / 2 : ℝ) * u (j + 2)) :=
          hG_mesh_bd (j + 2) (by omega) w (Or.inl (Or.inl hw))
        have hexp_le : Real.exp (-(1 / 2 : ℝ) * u (j + 2)) ≤ Real.exp (-(1 / 2 : ℝ) * u j) :=
          Real.exp_le_exp.mpr (by linarith)
        exact ⟨by linarith, le_trans h_bd2 (mul_le_mul_of_nonneg_left hexp_le (le_of_lt hC_osc))⟩
      · intro w hw
        rcases hmesh j with ⟨_, _, _, hσL_tr, _⟩
        have hw_re := (hσL_tr w hw).2.1
        exact ⟨by linarith, hG_mesh_bd j hJ₀_le_j w (Or.inl (Or.inr hw))⟩
    have hu_J₁_le : u J₁ ≤ u j := hu_mono hJ₁_le_j
    have hM_le : M_bound ≤ C_osc * Real.exp (-(1 / 2 : ℝ) * u J₁) :=
      mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr (by linarith)) (le_of_lt hC_osc)
    exact lt_of_le_of_lt (le_trans hz₀_bd hM_le) h_exp_J₁
  exact hz_nz (hs4_uniq G hG_holo hG_decay z_nz hz_nz_mem)

theorem high_modulus_mesh_contradiction (F Q_lim : ℂ → ℂ) (lam : ℝ)
    (hF_holo : DifferentiableOn ℂ F criticalLowerHalfPlane)
    (hQ_holo : DifferentiableOn ℂ Q_lim criticalLowerHalfPlane)
    (hF_nonzero : ∃ z ∈ criticalLowerHalfPlane, F z ≠ 0)
    (hF_ode : ∀ z ∈ criticalLowerHalfPlane, deriv (deriv F) z = Q_lim z * F z)
    (hlam : 1 ≤ lam)
    (hMesh : FirstFieldMeshHypotheses F lam) :
    False :=
by
  have hShadow : BadTileShadowBoundProp := bad_tile_shadow_green_bound
  have hRoute : GoodChainRoutingProp := good_chain_polygonal_routing
  have hDual : GridFourEightDualityProp := grid_four_eight_duality
  have hPolyMesh : HighModulusPolygonalMesh F lam :=
    epoch_bands_to_polygonal_mesh F lam hF_holo hlam hMesh hShadow hRoute hDual
  exact mesh_primitive_winding_contradiction
    F Q_lim lam hF_holo hQ_holo hF_nonzero hF_ode hlam hPolyMesh

theorem critical_angle_budget_and_envelope (S : FiniteWallNonisotropicStrip)
    (hCrit : CriticalWallData S) :
    Nonempty (CriticalAngleBudgetData S) :=
by
  have hBoot : CriticalBootstrapPackage S :=
    critical_bootstrap_and_vanishing_exclusion S hCrit
  have hNoProhib : ¬ ProhibitedCriticalSequence S := by
    intro hProhib
    obtain ⟨M⟩ := moment_law_and_second_scale_extraction S hCrit hBoot hProhib
    have hMesh : FirstFieldMeshHypotheses M.F M.lam :=
      first_field_growth_and_witnesses S hCrit hBoot M
    exact high_modulus_mesh_contradiction
      M.F M.Q_lim M.lam M.F_holo M.Q_lim_holo M.F_nonzero M.deriv2_F M.one_le_lam hMesh
  exact conditional_angle_budget_reduction S hCrit hBoot hNoProhib

theorem large_moment_normal_center_selection (S : FiniteWallNonisotropicStrip)
    (hBudget : CriticalAngleBudgetData S) (ε₀ L_star : ℝ)
    (hε₀ : 0 < ε₀) (hL_star : 0 < L_star)
    (K_seq j_seq : ℕ → ℝ)
    (hK_tendsto : Filter.Tendsto K_seq Filter.atTop Filter.atTop)
    (hK_lower : ∀ n : ℕ,
      max (10240000 * max hBudget.C_env 1) (2 * hBudget.k₀ + 4 * (n : ℝ) + 40) ≤ K_seq n)
    (hj_mem : ∀ n : ℕ,
      j_seq n ∈ Set.Icc ((9 / 10 : ℝ) * K_seq n) ((21 / 10 : ℝ) * K_seq n) ∧
      (K_seq n) ^ (1 / 100 : ℝ) ≤ rowMomentFull S (j_seq n))
    (h_bad : ∀ n : ℕ, ∀ k ∈ Set.Icc ((4 / 5 : ℝ) * K_seq n) ((11 / 5 : ℝ) * K_seq n),
      ε₀ ≤ lmRowModerateMeas S (K_seq n) k) :
    ∃ (k_seq x_seq : ℕ → ℝ) (C_cone : ℝ) (M_exhaust : ℕ → ℝ),
      NormalizedCenterEnvelope S hBudget L_star C_cone M_exhaust k_seq x_seq ∧
      ∀ n : ℕ,
        (K_seq n) ^ (1 / 100 : ℝ) ≤ rowMomentFull S (k_seq n) ∧
        (17 / 20 : ℝ) * K_seq n ≤ k_seq n ∧
        ε₀ / (4 * Real.pi) ≤ lmBoxModerateFraction S (K_seq n) (k_seq n) (x_seq n) :=
by
  have hk₀_ge_one : 1 ≤ hBudget.k₀ := hBudget.k₀_ge_one
  have hexp_k₀_lt : Real.exp (-hBudget.k₀) < S.H / 10 := hBudget.exp_neg_k₀_lt
  have hmom_poly : ∀ k : ℝ, hBudget.k₀ ≤ k → rowMomentFull S k ≤ hBudget.C_env * (1 + k) :=
    hBudget.moment_poly_bound
  
  obtain ⟨k_seq, hk_ge_k₀, hk_tendsto, hmom_tendsto, h_normal, h_mom_K, hk_Icc, hk_gap⟩ :
      ∃ k_seq : ℕ → ℝ,
        (∀ n : ℕ, hBudget.k₀ ≤ k_seq n) ∧
        Filter.Tendsto k_seq Filter.atTop Filter.atTop ∧
        Filter.Tendsto (fun n => rowMomentFull S (k_seq n)) Filter.atTop Filter.atTop ∧
        (∀ n : ℕ, ∀ l : ℝ, hBudget.k₀ ≤ l →
          rowMomentFull S l ≤ rowMomentFull S (k_seq n) * Real.exp ((1 / 8 : ℝ) * |l - k_seq n|)) ∧
        (∀ n : ℕ, (K_seq n) ^ (1 / 100 : ℝ) ≤ rowMomentFull S (k_seq n)) ∧
        (∀ n : ℕ, k_seq n ∈ Set.Icc ((17 / 20 : ℝ) * K_seq n) ((43 / 20 : ℝ) * K_seq n)) ∧
        (∀ n : ℕ, 3 * (n : ℝ) + 34 ≤ k_seq n - hBudget.k₀) := by
    clear hε₀ hL_star h_bad L_star ε₀
    have h_mom_nonneg : ∀ l : ℝ, 0 ≤ rowMomentFull S l := by
      intro l
      exact mul_nonneg (Real.exp_nonneg _) (Real.sqrt_nonneg _)
    have h_mom_cont : ContinuousOn (rowMomentFull S) (Set.Ici hBudget.k₀) := by
      let Φ : ℝ → ℝ → ℂ := fun l x =>
        (x : ℂ) + ((S.H - Real.exp (-max l hBudget.k₀) : ℝ) : ℂ) * Complex.I
      have hΦ_cont : Continuous (fun p : ℝ × ℝ => Φ p.1 p.2) := by
        refine (Complex.continuous_ofReal.comp continuous_snd).add ?_
        refine (Complex.continuous_ofReal.comp ?_).mul continuous_const
        exact continuous_const.sub (Real.continuous_exp.comp (Continuous.neg (continuous_fst.max continuous_const)))
      have hΦ_mem : ∀ p : ℝ × ℝ, Φ p.1 p.2 ∈ horizStrip S.H := by
        intro p
        simp only [horizStrip, Set.mem_setOf_eq, Φ, Complex.add_im, Complex.ofReal_im,
          Complex.mul_im, Complex.ofReal_re, Complex.I_im, Complex.I_re, mul_one, mul_zero,
          add_zero, zero_add]
        have h_max : hBudget.k₀ ≤ max p.1 hBudget.k₀ := le_max_right _ _
        have h_epos : 0 < Real.exp (-max p.1 hBudget.k₀) := Real.exp_pos _
        have h_ele : Real.exp (-max p.1 hBudget.k₀) ≤ Real.exp (-hBudget.k₀) :=
          Real.exp_le_exp.mpr (by linarith)
        have hH : 0 < S.H := S.H_pos
        rw [abs_lt]
        constructor <;> linarith
      have hf_cont : Continuous (fun p : ℝ × ℝ => S.f (Φ p.1 p.2)) :=
        S.f_holo.continuousOn.comp_continuous hΦ_cont hΦ_mem
      have hq_cont : Continuous (fun p : ℝ × ℝ => S.q (Φ p.1 p.2)) :=
        S.q_holo.continuousOn.comp_continuous hΦ_cont hΦ_mem
      have h_ing_cont : Continuous (fun p : ℝ × ℝ => ‖S.f (Φ p.1 p.2)‖ ^ 2 + ‖S.q (Φ p.1 p.2)‖) :=
        ((continuous_norm.comp hf_cont).pow 2).add (continuous_norm.comp hq_cont)
      have h_int_cont : Continuous (fun l : ℝ =>
          ∫ x in (0 : ℝ)..(2 * Real.pi), (‖S.f (Φ l x)‖ ^ 2 + ‖S.q (Φ l x)‖)) :=
        intervalIntegral.continuous_parametric_intervalIntegral_of_continuous'
          h_ing_cont 0 (2 * Real.pi)
      let μ_clamp : ℝ → ℝ := fun l =>
        Real.exp (-max l hBudget.k₀) * Real.sqrt ((2 * Real.pi)⁻¹ *
          ∫ x in (0 : ℝ)..(2 * Real.pi), (‖S.f (Φ l x)‖ ^ 2 + ‖S.q (Φ l x)‖))
      have hμ_cont : Continuous μ_clamp := by
        refine (Real.continuous_exp.comp (Continuous.neg (continuous_id.max continuous_const))).mul ?_
        exact Real.continuous_sqrt.comp (continuous_const.mul h_int_cont)
      refine hμ_cont.continuousOn.congr ?_
      intro l hl
      have hmax_eq : max l hBudget.k₀ = l := max_eq_left hl
      simp only [rowMomentFull, μ_clamp, Φ, hmax_eq]
    have h_ex : ∀ n : ℕ, ∃ k : ℝ,
        hBudget.k₀ ≤ k ∧
