      (Finset.sum_sdiff (Finset.subset_univ Bad)).symm
    rw [Real.dist_eq, sub_zero, abs_of_nonneg MeasureTheory.measureReal_nonneg]
    linarith
  
  let D_deg : Set ℝ :=
    {D ∈ Set.Icc (1 : ℝ) 2 |
