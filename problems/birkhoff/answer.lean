    have hev_r₀ : ∀ᶠ t in F₀, t ∈ B₀ := nhdsWithin_le_nhds (Metric.ball_mem_nhds 0 hr₀)
    have hev_s₀ : ∀ᶠ t in F₀, s₀ t ∈ Metric.ball (x : ℂ) R_s :=
      hs₀_lim (Metric.ball_mem_nhds (x : ℂ) hRs)
    have hev_hp : ∀ᶠ t in F₀, h_p t ∈ Metric.ball (0 : ℂ) R_s :=
      hhp0_F0 (Metric.ball_mem_nhds 0 hRs)
    have hev_hm : ∀ᶠ t in F₀, h_m t ∈ Metric.ball (0 : ℂ) R_s :=
      hhm0_F0 (Metric.ball_mem_nhds 0 hRs)
    have hev_hp2 : ∀ᶠ t in F₀, ‖h_p t‖ ≤ 2 * ‖t‖ := by
      filter_upwards [hlim_p.norm (Metric.ball_mem_nhds ‖(1 : ℂ)‖ zero_lt_one), hev_t_ne]
        with t ht hne
      have h1 : ‖h_p t / t‖ < 2 := by
        change ‖h_p t / t‖ ∈ Metric.ball ‖(1 : ℂ)‖ 1 at ht
        rw [Metric.mem_ball, Real.dist_eq, norm_one] at ht
        linarith [abs_lt.mp ht]
      rw [norm_div, div_lt_iff₀ (norm_pos_iff.mpr hne)] at h1
      exact h1.le
    have hev_hm2 : ∀ᶠ t in F₀, ‖h_m t‖ ≤ 2 * ‖t‖ := by
      filter_upwards [hlim_m.norm (Metric.ball_mem_nhds ‖(-1 : ℂ)‖ zero_lt_one), hev_t_ne]
        with t ht hne
      have h1 : ‖h_m t / t‖ < 2 := by
        change ‖h_m t / t‖ ∈ Metric.ball ‖(-1 : ℂ)‖ 1 at ht
        rw [Metric.mem_ball, Real.dist_eq, norm_neg, norm_one] at ht
        linarith [abs_lt.mp ht]
      rw [norm_div, div_lt_iff₀ (norm_pos_iff.mpr hne)] at h1
      exact h1.le
    have hnorm_t_lim : Filter.Tendsto (fun t : ℂ => ‖t‖) F₀ (nhds 0) := by
      simpa using (continuous_norm.continuousWithinAt
        (x := (0 : ℂ)) (s := {(0 : ℂ)}ᶜ)).tendsto
    have hTp_lim : Filter.Tendsto (fun t => T_p t / t) F₀
        (nhds ((C.c : ℂ) * (K.f (x : ℂ))⁻¹ ^ 2)) := by
      have hlead : Filter.Tendsto
          (fun t => (C.c : ℂ) * (K.f (s₀ t))⁻¹ ^ 2 * (h_p t / t)) F₀
          (nhds ((C.c : ℂ) * (K.f (x : ℂ))⁻¹ ^ 2 * 1)) :=
        (tendsto_const_nhds.mul ((hf_s0_lim.inv₀ hfx_ne).pow 2)).mul hlim_p
      rw [mul_one] at hlead
      have hdiff_zero : Filter.Tendsto
          (fun t => T_p t / t - (C.c : ℂ) * (K.f (s₀ t))⁻¹ ^ 2 * (h_p t / t)) F₀ (nhds 0) := by
        rw [tendsto_zero_iff_norm_tendsto_zero]
        refine squeeze_zero' (Filter.Eventually.of_forall fun _ => norm_nonneg _) ?_
          (by simpa using hnorm_t_lim.const_mul (4 * C_T))
        filter_upwards [hev_s₀, hev_hp, hev_hp2, hev_t_ne] with t hs₀t hhpt h2t hne
        have hbd := (hSlope_x (s₀ t) hs₀t (h_p t) hhpt).1
        have hrew : T_p t / t - (C.c : ℂ) * (K.f (s₀ t))⁻¹ ^ 2 * (h_p t / t) =
            (T_p t - (C.c : ℂ) * (K.f (s₀ t))⁻¹ ^ 2 * h_p t) / t := by ring
        rw [hrew, norm_div, div_le_iff₀ (norm_pos_iff.mpr hne)]
        calc ‖T_p t - (C.c : ℂ) * (K.f (s₀ t))⁻¹ ^ 2 * h_p t‖
            ≤ C_T * ‖h_p t‖ ^ 2 := hbd
          _ ≤ C_T * (2 * ‖t‖) ^ 2 :=
            mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (norm_nonneg _) h2t 2) hCT
          _ = 4 * C_T * ‖t‖ * ‖t‖ := by ring
      simpa using hlead.add hdiff_zero
    have hTm_lim : Filter.Tendsto (fun t => T_m t / t) F₀
        (nhds (-((C.c : ℂ) * (K.f (x : ℂ))⁻¹ ^ 2))) := by
      have hlead : Filter.Tendsto
          (fun t => (C.c : ℂ) * (K.f (s₀ t))⁻¹ ^ 2 * (h_m t / t)) F₀
          (nhds ((C.c : ℂ) * (K.f (x : ℂ))⁻¹ ^ 2 * (-1))) :=
        (tendsto_const_nhds.mul ((hf_s0_lim.inv₀ hfx_ne).pow 2)).mul hlim_m
      have hdiff_zero : Filter.Tendsto
          (fun t => T_m t / t - (C.c : ℂ) * (K.f (s₀ t))⁻¹ ^ 2 * (h_m t / t)) F₀ (nhds 0) := by
        rw [tendsto_zero_iff_norm_tendsto_zero]
        refine squeeze_zero' (Filter.Eventually.of_forall fun _ => norm_nonneg _) ?_
          (by simpa using hnorm_t_lim.const_mul (4 * C_T))
        filter_upwards [hev_s₀, hev_hm, hev_hm2, hev_t_ne] with t hs₀t hhmt h2t hne
        have hbd := (hSlope_x (s₀ t) hs₀t (h_m t) hhmt).1
        have hrew : T_m t / t - (C.c : ℂ) * (K.f (s₀ t))⁻¹ ^ 2 * (h_m t / t) =
            (T_m t - (C.c : ℂ) * (K.f (s₀ t))⁻¹ ^ 2 * h_m t) / t := by ring
        rw [hrew, norm_div, div_le_iff₀ (norm_pos_iff.mpr hne)]
        calc ‖T_m t - (C.c : ℂ) * (K.f (s₀ t))⁻¹ ^ 2 * h_m t‖
            ≤ C_T * ‖h_m t‖ ^ 2 := hbd
          _ ≤ C_T * (2 * ‖t‖) ^ 2 :=
            mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (norm_nonneg _) h2t 2) hCT
          _ = 4 * C_T * ‖t‖ * ‖t‖ := by ring
      convert hlead.add hdiff_zero using 2 <;> ring
    let E_p : ℂ → ℂ := fun t => N_p t - T_p t * chordPoly (s₀ t) (h_p t)
    let E_m : ℂ → ℂ := fun t => N_m t - T_m t * chordPoly (s₀ t) (h_m t)
    let M_T_lim : ℝ := ‖(C.c : ℂ) * (K.f (x : ℂ))⁻¹ ^ 2‖ + 1
    have hMT_pos : 0 ≤ M_T_lim := by positivity
    have hev_Tp_bnd : ∀ᶠ t in F₀, ‖T_p t / t‖ ≤ M_T_lim := by
      filter_upwards [hTp_lim.norm
        (Metric.ball_mem_nhds ‖(C.c : ℂ) * (K.f (x : ℂ))⁻¹ ^ 2‖ zero_lt_one)] with t ht
      rw [Set.mem_preimage, Metric.mem_ball, Real.dist_eq] at ht
      dsimp [M_T_lim]; linarith [abs_lt.mp ht]
    have hev_Tm_bnd : ∀ᶠ t in F₀, ‖T_m t / t‖ ≤ M_T_lim := by
      filter_upwards [hTm_lim.norm
        (Metric.ball_mem_nhds ‖-((C.c : ℂ) * (K.f (x : ℂ))⁻¹ ^ 2)‖ zero_lt_one)] with t ht
      rw [Set.mem_preimage, Metric.mem_ball, Real.dist_eq, norm_neg] at ht
      dsimp [M_T_lim]; linarith [abs_lt.mp ht]
    have hrem_lim : Filter.Tendsto
        (fun t => (E_p t * T_m t + T_p t * E_m t) / t ^ 6) F₀ (nhds 0) := by
      rw [tendsto_zero_iff_norm_tendsto_zero]
      refine squeeze_zero' (Filter.Eventually.of_forall fun _ => norm_nonneg _) ?_
        (by simpa using hnorm_t_lim.const_mul (128 * C_E * M_T_lim))
      filter_upwards [hev_s₀, hev_hp, hev_hm, hev_hp2, hev_hm2, hev_Tp_bnd, hev_Tm_bnd, hev_t_ne]
        with t hs₀t hhpt hhmt h2p h2m hTpb hTmb hne
      have hEp : ‖E_p t‖ ≤ 64 * C_E * ‖t‖ ^ 6 := by
        calc ‖E_p t‖ ≤ C_E * ‖h_p t‖ ^ 6 := (hSlope_x (s₀ t) hs₀t (h_p t) hhpt).2
          _ ≤ C_E * (2 * ‖t‖) ^ 6 :=
            mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (norm_nonneg _) h2p 6) hCE
          _ = 64 * C_E * ‖t‖ ^ 6 := by ring
      have hEm : ‖E_m t‖ ≤ 64 * C_E * ‖t‖ ^ 6 := by
        calc ‖E_m t‖ ≤ C_E * ‖h_m t‖ ^ 6 := (hSlope_x (s₀ t) hs₀t (h_m t) hhmt).2
          _ ≤ C_E * (2 * ‖t‖) ^ 6 :=
            mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (norm_nonneg _) h2m 6) hCE
          _ = 64 * C_E * ‖t‖ ^ 6 := by ring
      have hrew : (E_p t * T_m t + T_p t * E_m t) / t ^ 6 =
          (E_p t / t ^ 5) * (T_m t / t) + (T_p t / t) * (E_m t / t ^ 5) := by
        field_simp [hne]
      rw [hrew]
      have ht5_pos : 0 < ‖t‖ ^ 5 := pow_pos (norm_pos_iff.mpr hne) 5
      have hEp5 : ‖E_p t / t ^ 5‖ ≤ 64 * C_E * ‖t‖ := by
        rw [norm_div, norm_pow, div_le_iff₀ ht5_pos]
        calc ‖E_p t‖ ≤ 64 * C_E * ‖t‖ ^ 6 := hEp
          _ = 64 * C_E * ‖t‖ * ‖t‖ ^ 5 := by ring
      have hEm5 : ‖E_m t / t ^ 5‖ ≤ 64 * C_E * ‖t‖ := by
        rw [norm_div, norm_pow, div_le_iff₀ ht5_pos]
        calc ‖E_m t‖ ≤ 64 * C_E * ‖t‖ ^ 6 := hEm
          _ = 64 * C_E * ‖t‖ * ‖t‖ ^ 5 := by ring
      calc ‖(E_p t / t ^ 5) * (T_m t / t) + (T_p t / t) * (E_m t / t ^ 5)‖
          ≤ ‖(E_p t / t ^ 5) * (T_m t / t)‖ + ‖(T_p t / t) * (E_m t / t ^ 5)‖ := norm_add_le _ _
        _ = ‖E_p t / t ^ 5‖ * ‖T_m t / t‖ + ‖T_p t / t‖ * ‖E_m t / t ^ 5‖ := by
            rw [norm_mul, norm_mul]
        _ ≤ (64 * C_E * ‖t‖) * M_T_lim + M_T_lim * (64 * C_E * ‖t‖) :=
            add_le_add (mul_le_mul hEp5 hTmb (norm_nonneg _) (by positivity))
              (mul_le_mul hTpb hEm5 (norm_nonneg _) hMT_pos)
        _ = 128 * C_E * M_T_lim * ‖t‖ := by ring
    have hP_sum_lim : Filter.Tendsto
        (fun t => (chordPoly (s₀ t) (h_p t) + chordPoly (s₀ t) (h_m t)) / t ^ 4) F₀
        (nhds (-(1 / 2 : ℂ) * K.f (x : ℂ) * deriv (deriv V) (x : ℂ) +
          K.f (x : ℂ) * deriv W_pot (x : ℂ) / 240)) := by
      have hlin_term : Filter.Tendsto
          (fun t => -(1 / 2 : ℂ) * K.f (s₀ t) * ((h_p t + h_m t) / t ^ 4)) F₀
          (nhds (-(1 / 2 : ℂ) * K.f (x : ℂ) * deriv (deriv V) (x : ℂ))) :=
        (hf_s0_lim.const_mul (-(1 / 2 : ℂ))).mul hlim_sum
      have hquad_zero : Filter.Tendsto
          (fun t => h_p t ^ 2 - h_p t * h_m t + h_m t ^ 2) F₀ (nhds 0) := by
        simpa using ((hhp0_F0.pow 2).sub (hhp0_F0.mul hhm0_F0)).add (hhm0_F0.pow 2)
      have hcub_term : Filter.Tendsto
          (fun t => ((deriv (deriv K.f) (s₀ t) - K.f (s₀ t) ^ 3) / 24) *
            ((h_p t + h_m t) / t ^ 4) * (h_p t ^ 2 - h_p t * h_m t + h_m t ^ 2)) F₀ (nhds 0) := by
        have hc1 := ((hdf2_s0_lim.sub (hf_s0_lim.pow 3)).div_const 24).mul hlim_sum
        simpa using hc1.mul hquad_zero
      have hquart_term : Filter.Tendsto
          (fun t => (K.f (s₀ t) * deriv W_pot (s₀ t) / 480) *
            ((h_p t / t) ^ 4 + (h_m t / t) ^ 4)) F₀
          (nhds ((K.f (x : ℂ) * deriv W_pot (x : ℂ) / 480) * ((1 : ℂ) ^ 4 + (-1 : ℂ) ^ 4))) :=
        ((hf_s0_lim.mul hdW_s0_lim).div_const 480).mul ((hlim_p.pow 4).add (hlim_m.pow 4))
      have hcomb := (hlin_term.add hcub_term).add hquart_term
      have hrew_lim : -(1 / 2 : ℂ) * K.f (x : ℂ) * deriv (deriv V) (x : ℂ) + 0 +
          (K.f (x : ℂ) * deriv W_pot (x : ℂ) / 480) * ((1 : ℂ) ^ 4 + (-1 : ℂ) ^ 4) =
          -(1 / 2 : ℂ) * K.f (x : ℂ) * deriv (deriv V) (x : ℂ) +
          K.f (x : ℂ) * deriv W_pot (x : ℂ) / 240 := by ring
      rw [hrew_lim] at hcomb
      refine hcomb.congr' ?_
      filter_upwards [hev_t_ne] with t hne
      dsimp [chordPoly]
      field_simp [hne]
      ring
    have hfull_lim : Filter.Tendsto (fun t => R_x t / t ^ 6) F₀
        (nhds (((C.c : ℂ) * (K.f (x : ℂ))⁻¹ ^ 2) * (-((C.c : ℂ) * (K.f (x : ℂ))⁻¹ ^ 2)) *
          (-(1 / 2 : ℂ) * K.f (x : ℂ) * deriv (deriv V) (x : ℂ) +
            K.f (x : ℂ) * deriv W_pot (x : ℂ) / 240) + 0)) := by
      have h1 := ((hTp_lim.mul hTm_lim).mul hP_sum_lim).add hrem_lim
      refine h1.congr' ?_
      filter_upwards [hev_t_ne] with t hne
      dsimp [R_x, E_p, E_m]
      field_simp [hne]
      ring
    have hzero_lim : Filter.Tendsto (fun t => R_x t / t ^ 6) F₀ (nhds 0) := by
      refine tendsto_const_nhds.congr' ?_
      filter_upwards [hev_r₀] with t ht
      simp [hRx_zero t ht]
    have heq0 := tendsto_nhds_unique hfull_lim hzero_lim
    have hc_ne : (C.c : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (ne_of_gt C.c_pos)
    have hfac_ne : ((C.c : ℂ) * (K.f (x : ℂ))⁻¹ ^ 2) *
        (-((C.c : ℂ) * (K.f (x : ℂ))⁻¹ ^ 2)) * K.f (x : ℂ) ≠ 0 := by
      have hinv_ne : (K.f (x : ℂ))⁻¹ ≠ 0 := inv_ne_zero hfx_ne
      exact mul_ne_zero (mul_ne_zero (mul_ne_zero hc_ne (pow_ne_zero 2 hinv_ne))
        (neg_ne_zero.mpr (mul_ne_zero hc_ne (pow_ne_zero 2 hinv_ne)))) hfx_ne
    have hprod0 : (((C.c : ℂ) * (K.f (x : ℂ))⁻¹ ^ 2) *
        (-((C.c : ℂ) * (K.f (x : ℂ))⁻¹ ^ 2)) * K.f (x : ℂ)) *
        (-(1 / 2 : ℂ) * deriv (deriv V) (x : ℂ) + deriv W_pot (x : ℂ) / 240) = 0 := by
      linear_combination heq0
    rcases mul_eq_zero.mp hprod0 with hbad | hgood
    · exact absurd hbad hfac_ne
    · linear_combination -2 * hgood
  
  have hV_deriv : ∀ s ∈ D_H, deriv V s = (1 / 120 : ℂ) *
      (K.f s ^ 2 + 8 * speedPotentialQ K s -
        (2 * Real.pi)⁻¹ *
          ∫ x in (0 : ℝ)..(2 * Real.pi), (K.f x ^ 2 + 8 * speedPotentialQ K x)) := by
    let G : ℂ → ℂ := fun z => deriv V z - (1 / 120 : ℂ) * W_pot z
    have hdV_holo : DifferentiableOn ℂ (deriv V) D_H := hV_holo.deriv hDH_open
    have hG_holo : DifferentiableOn ℂ G D_H := hdV_holo.sub (hW_holo.const_mul (1 / 120 : ℂ))
    have hdG_ana : AnalyticOnNhd ℂ (deriv G) D_H :=
      (hG_holo.deriv hDH_open).analyticOnNhd hDH_open
    have hdG_real : ∀ x : ℝ, deriv G (x : ℂ) = 0 := by
      intro x
      have hx_nhds : D_H ∈ nhds (x : ℂ) := hDH_open.mem_nhds (hreal_DH x)
      have h1 : HasDerivAt (deriv V) (deriv (deriv V) (x : ℂ)) (x : ℂ) :=
        (hdV_holo.differentiableAt hx_nhds).hasDerivAt
      have h2 : HasDerivAt W_pot (deriv W_pot (x : ℂ)) (x : ℂ) :=
        (hW_holo.differentiableAt hx_nhds).hasDerivAt
      have hG_at : HasDerivAt G
          (deriv (deriv V) (x : ℂ) - (1 / 120 : ℂ) * deriv W_pot (x : ℂ)) (x : ℂ) :=
        h1.sub (h2.const_mul (1 / 120 : ℂ))
      rw [hG_at.deriv, hreal_d2 x, sub_self]
    have hfreq : ∃ᶠ z in nhdsWithin (0 : ℂ) {(0 : ℂ)}ᶜ, deriv G z = 0 := by
      have hseq : Filter.Tendsto (fun n : ℕ => ((1 / ((n : ℝ) + 1) : ℝ) : ℂ))
          Filter.atTop (nhdsWithin (0 : ℂ) {(0 : ℂ)}ᶜ) := by
        rw [tendsto_nhdsWithin_iff]
        refine ⟨?_, Filter.Eventually.of_forall fun n => ?_⟩
        · have h0 : Filter.Tendsto (fun n : ℕ => (1 / ((n : ℝ) + 1) : ℝ))
              Filter.atTop (nhds 0) := tendsto_one_div_add_atTop_nhds_zero_nat
          have h0c := (Complex.continuous_ofReal.tendsto 0).comp h0
          simpa [Function.comp_def] using h0c
        · rw [Set.mem_compl_singleton_iff, Complex.ofReal_ne_zero]
          positivity
      exact hseq.frequently ((Filter.Eventually.of_forall fun n : ℕ =>
        hdG_real (1 / ((n : ℝ) + 1))).frequently)
    have h0_DH : (0 : ℂ) ∈ D_H := by simpa using hreal_DH 0
    have hdG_zero : Set.EqOn (deriv G) 0 D_H :=
      hdG_ana.eqOn_zero_of_preconnected_of_frequently_eq_zero hDH_pre h0_DH hfreq
    have hG_const : ∀ z ∈ D_H, G z = G 0 :=
      fun z hz => hDH_open.is_const_of_deriv_eq_zero hDH_pre hG_holo hdG_zero hz h0_DH
    have hdV_cont : Continuous (fun x : ℝ => deriv V (x : ℂ)) :=
      hdV_holo.continuousOn.comp_continuous Complex.continuous_ofReal hreal_DH
    have hW_cont : Continuous (fun x : ℝ => W_pot (x : ℂ)) :=
      hW_holo.continuousOn.comp_continuous Complex.continuous_ofReal hreal_DH
    have hint_dV : (∫ x in (0 : ℝ)..(2 * Real.pi), deriv V (x : ℂ)) = 0 := by
      have hderiv_V : ∀ x ∈ Set.uIcc (0 : ℝ) (2 * Real.pi),
          HasDerivAt (fun t : ℝ => V (t : ℂ)) (deriv V (x : ℂ)) x := by
        intro x _
        have hx_nhds : D_H ∈ nhds (x : ℂ) := hDH_open.mem_nhds (hreal_DH x)
        exact ((hV_holo.differentiableAt hx_nhds).hasDerivAt).comp_ofReal
      rw [intervalIntegral.integral_eq_sub_of_hasDerivAt hderiv_V
        (hdV_cont.intervalIntegrable 0 (2 * Real.pi))]
      have hcast : ((2 * Real.pi : ℝ) : ℂ) = (0 : ℂ) + 2 * (Real.pi : ℂ) := by push_cast; ring
      rw [hcast, Complex.ofReal_zero, hV_per 0 h0_DH, sub_self]
    have hint_G : (∫ x in (0 : ℝ)..(2 * Real.pi), G (x : ℂ)) = (2 * (Real.pi : ℂ)) * G 0 := by
      have hcongr : ∀ x : ℝ, G (x : ℂ) = G 0 := fun x => hG_const (x : ℂ) (hreal_DH x)
      simp_rw [hcongr]
      rw [intervalIntegral.integral_const]
      simp [Complex.real_smul]
    have hint_G2 : (∫ x in (0 : ℝ)..(2 * Real.pi), G (x : ℂ)) =
        -(1 / 120 : ℂ) * ∫ x in (0 : ℝ)..(2 * Real.pi), W_pot (x : ℂ) := by
      dsimp [G]
      rw [intervalIntegral.integral_sub (hdV_cont.intervalIntegrable 0 (2 * Real.pi))
          ((hW_cont.const_mul _).intervalIntegrable 0 (2 * Real.pi)),
        intervalIntegral.integral_const_mul, hint_dV, zero_sub]
      ring
    have h2pi_ne : (2 * (Real.pi : ℂ)) ≠ 0 :=
      mul_ne_zero two_ne_zero (Complex.ofReal_ne_zero.mpr Real.pi_ne_zero)
    have hG0_eq : G 0 = -(1 / 120 : ℂ) * ((2 * Real.pi)⁻¹ *
        ∫ x in (0 : ℝ)..(2 * Real.pi), W_pot (x : ℂ)) := by
      have hlin : (2 * (Real.pi : ℂ)) * G 0 =
          -(1 / 120 : ℂ) * ∫ x in (0 : ℝ)..(2 * Real.pi), W_pot (x : ℂ) :=
        hint_G.symm.trans hint_G2
      calc G 0 = (2 * (Real.pi : ℂ))⁻¹ * ((2 * (Real.pi : ℂ)) * G 0) := by
            field_simp [h2pi_ne]
        _ = (2 * (Real.pi : ℂ))⁻¹ * (-(1 / 120 : ℂ) *
              ∫ x in (0 : ℝ)..(2 * Real.pi), W_pot (x : ℂ)) := by rw [hlin]
        _ = -(1 / 120 : ℂ) * ((2 * Real.pi)⁻¹ *
              ∫ x in (0 : ℝ)..(2 * Real.pi), W_pot (x : ℂ)) := by push_cast; ring
    intro s hs
    have hGs := hG_const s hs
    rw [hG0_eq] at hGs
    dsimp [G, W_pot] at hGs
    linear_combination hGs
  exact ⟨hV_holo, hV_per, hV_conj, hV_mean, h𝔰_d1, h𝔰_d2, hV_deriv⟩

theorem speed_zeros_and_displacement (Ω : Set Plane)
    (C : AnalyticGlancingCollar Ω)
    (M : MeromorphicCollarData C)
    (K : NonisotropicCurveData C M)
    (L : NormalizedGlobalLiftData C M K) :
    Nonempty (SpeedAndCollarPackage C M K L) :=
by
  have hSimple := speed_zeros_simple_and_inflection Ω C M K L
  obtain ⟨hq_holo, hderiv2_f, hq_per, hq_conj, hH0_holo, hH0_per, hH0_conj, hH0_eq, hH0_deriv⟩ :=
    potential_and_support_extension Ω C M K hSimple
  have hChord := real_collar_chord_geometry Ω C M K L
  obtain ⟨hV_holo, hV_per, hV_conj, hV_mean, h𝔰_d1, h𝔰_d2, hV_deriv⟩ :=
    first_impact_displacement_law Ω C M K L hq_holo hderiv2_f hChord
  exact ⟨{
    q := speedPotentialQ K
    H0 := supportProfileH0 K
    V := firstImpactDisplacementV L
    ℓ_chord := realCollarChordLen L
    f_simple_zeros := hSimple
    q_holo := hq_holo
    deriv2_f := hderiv2_f
    q_periodic := hq_per
    q_conj := hq_conj
    H0_holo := hH0_holo
    H0_periodic := hH0_per
    H0_conj := hH0_conj
    H0_eq := hH0_eq
    H0_deriv := hH0_deriv
    V_holo := hV_holo
    V_periodic := hV_per
    V_conj := hV_conj
    V_mean_zero := hV_mean
    𝔰_deriv_t_zero := h𝔰_d1
    𝔰_deriv2_t_zero := h𝔰_d2
    V_deriv := hV_deriv
    real_collar_chord := hChord
  }⟩

theorem entire_tube_and_real_wall_no_patch (Ω : Set Plane)
    (C : AnalyticGlancingCollar Ω)
    (M : MeromorphicCollarData C)
    (K : NonisotropicCurveData C M)
    (L : NormalizedGlobalLiftData C M K) :
    (M.h_X 0 = ⊤ → Nonempty (EntireTubeObstructionData C M K L)) ∧
    (∀ (H t₀ x₀ ε : ℝ),
      M.h_X 0 = ENNReal.ofReal H →
      |t₀| < L.r_star →
      M.h_X (t₀ : ℂ) ≠ ⊤ →
      0 < ε → ε < L.s_star →
      ¬ ∃ g : ℂ × ℂ → ℂ,
        DifferentiableOn ℂ g
          { p : ℂ × ℂ |
            ‖p.1 - ((x₀ : ℂ) + (finiteWallWidthFn M L (t₀ : ℂ) : ℂ) * Complex.I)‖ < ε ∧
            ‖p.2 - (t₀ : ℂ)‖ < ε } ∧
        (∀ p : ℂ × ℂ,
          ‖p.1 - ((x₀ : ℂ) + (finiteWallWidthFn M L (t₀ : ℂ) : ℂ) * Complex.I)‖ < ε →
          ‖p.2 - (t₀ : ℂ)‖ < ε → g p ∈ horizStrip H) ∧
        ∃ δ : ℝ, 0 < δ ∧ δ ≤ ε ∧
          ∀ p : ℂ × ℂ,
            |p.1.re - x₀| < ε / 4 →
            |p.1.im - (finiteWallWidthFn M L (t₀ : ℂ) - ε / 2)| < ε / 4 →
            ‖p.2 - (t₀ : ℂ)‖ < δ → g p = L.𝔰 p) :=
by
  classical
  have h_eqOn_convex : ∀ {W : Set (ℂ × ℂ)} {f g : ℂ × ℂ → ℂ} {p₀ : ℂ × ℂ} {r₀ : ℝ},
      IsOpen W → Convex ℝ W → DifferentiableOn ℂ f W → DifferentiableOn ℂ g W →
      p₀ ∈ W → 0 < r₀ →
      (∀ q ∈ Metric.ball p₀ r₀, f q = g q) → ∀ p ∈ W, f p = g p := by
    intro W f g p₀ r₀ hW_open hW_conv hf hg hp₀ hr₀ hball p hp
    let φ : ℂ → ℂ × ℂ := fun z => (p₀.1 + z * (p.1 - p₀.1), p₀.2 + z * (p.2 - p₀.2))
    have hφ_diff : Differentiable ℂ φ :=
      (differentiable_const _ |>.add (differentiable_id.mul (differentiable_const _))).prodMk
        (differentiable_const _ |>.add (differentiable_id.mul (differentiable_const _)))
    let Ω_z : Set ℂ := φ ⁻¹' W
    have hΩ_open : IsOpen Ω_z := hW_open.preimage hφ_diff.continuous
    have hΩ_conv : Convex ℝ Ω_z := by
      intro z₁ hz₁ z₂ hz₂ a b ha hb hab
      have h_aff : φ (a • z₁ + b • z₂) = a • φ z₁ + b • φ z₂ := by
        have hab_c : (a : ℂ) + (b : ℂ) = 1 := by exact_mod_cast hab
        ext
        · simp only [φ, Prod.smul_mk, Prod.mk_add_mk, Complex.real_smul]
          linear_combination -hab_c * p₀.1
        · simp only [φ, Prod.smul_mk, Prod.mk_add_mk, Complex.real_smul]
          linear_combination -hab_c * p₀.2
      show φ (a • z₁ + b • z₂) ∈ W
      rw [h_aff]
      exact hW_conv hz₁ hz₂ ha hb hab
    have h0_mem : (0 : ℂ) ∈ Ω_z := by
      show φ 0 ∈ W
      simpa [φ] using hp₀
    have h1_mem : (1 : ℂ) ∈ Ω_z := by
      show φ 1 ∈ W
      simpa [φ] using hp
    have hd_diff : DifferentiableOn ℂ (fun z => f (φ z) - g (φ z)) Ω_z :=
      (hf.sub hg).comp hφ_diff.differentiableOn (fun z hz => hz)
    have hd_ana : AnalyticOnNhd ℂ (fun z => f (φ z) - g (φ z)) Ω_z :=
      (Complex.analyticOnNhd_iff_differentiableOn hΩ_open).mpr hd_diff
    have hev0 : ∀ᶠ z in nhds (0 : ℂ), f (φ z) - g (φ z) = 0 := by
      have hφ0 : φ 0 = p₀ := by simp [φ]
      have hmem : ∀ᶠ z in nhds (0 : ℂ), φ z ∈ Metric.ball p₀ r₀ := by
        apply hφ_diff.continuous.continuousAt.tendsto.eventually
        rw [hφ0]
        exact Metric.isOpen_ball.mem_nhds (Metric.mem_ball_self hr₀)
      exact hmem.mono (fun z hz => sub_eq_zero.mpr (hball (φ z) hz))
    have h1_zero := hd_ana.eqOn_zero_of_preconnected_of_eventuallyEq_zero
      hΩ_conv.isPreconnected h0_mem hev0 h1_mem
    change f (φ 1) - g (φ 1) = 0 at h1_zero
    have hφ1 : φ 1 = p := by simp [φ]
    rw [hφ1] at h1_zero
    exact sub_eq_zero.mp h1_zero
  have h_eqOn_zero : ∀ {W V : Set (ℂ × ℂ)},
      IsOpen W → Convex ℝ W → IsOpen V → V.Nonempty → V ⊆ W →
      ∀ {f : ℂ × ℂ → ℂ}, DifferentiableOn ℂ f W → (∀ p ∈ V, f p = 0) → ∀ p ∈ W, f p = 0 := by
    intro W V hW_open hW_conv hV_open ⟨p₀, hp₀V⟩ hVW f hf_holo hV_zero
    obtain ⟨r₀, hr₀_pos, hball_V⟩ := Metric.isOpen_iff.mp hV_open p₀ hp₀V
    exact h_eqOn_convex hW_open hW_conv hf_holo (differentiableOn_const 0)
      (hVW hp₀V) hr₀_pos (fun q hq => hV_zero q (hball_V hq))
  have hr_star_lt_base : L.r_star < M.r_base := by
    linarith [L.r_star_le, K.r_init_le, M.r_base_pos]
  have hs_star_le_quarter_base : L.s_star ≤ M.s_base / 4 := by
    linarith [L.s_star_le, K.s_init_le]
  have hs_star_lt_base : L.s_star < M.s_base := by
    linarith [hs_star_le_quarter_base, M.s_base_pos]
  have h0_rbase : (0 : ℂ) ∈ Metric.ball (0 : ℂ) M.r_base :=
    Metric.mem_ball_self M.r_base_pos
  have h_hX0_pos : 0 < M.h_X 0 :=
    lt_of_lt_of_le (ENNReal.ofReal_pos.mpr M.s_base_pos) (M.h_X_ge 0 h0_rbase)
  have h_base_sub_T_mero :
      { p : ℂ × ℂ | |p.1.im| < M.s_base ∧ ‖p.2‖ < M.r_base } ⊆
        meroTubeENNR M.r_base M.h_X := by
    intro p ⟨hp_im, hp_t⟩
    have ht_ball : p.2 ∈ Metric.ball (0 : ℂ) M.r_base := by
      rwa [Metric.mem_ball, dist_zero_right]
    have hconj_ball : starRingEnd ℂ p.2 ∈ Metric.ball (0 : ℂ) M.r_base := by
      rw [Metric.mem_ball, dist_zero_right, Complex.norm_conj]
      exact hp_t
    have him := abs_lt.mp hp_im
    refine ⟨hp_t, ?_, ?_⟩
    · exact lt_of_lt_of_le
        ((ENNReal.ofReal_lt_ofReal_iff M.s_base_pos).mpr (by linarith))
        (M.h_X_ge _ hconj_ball)
    · exact lt_of_lt_of_le
        ((ENNReal.ofReal_lt_ofReal_iff M.s_base_pos).mpr him.2)
        (M.h_X_ge _ ht_ball)
  have h_rect_open_conv : ∀ (x_lo x_hi y_lo y_hi : ℝ) (t_c : ℂ) (r_t : ℝ),
      IsOpen { p : ℂ × ℂ | x_lo < p.1.re ∧ p.1.re < x_hi ∧
          y_lo < p.1.im ∧ p.1.im < y_hi ∧ ‖p.2 - t_c‖ < r_t } ∧
      Convex ℝ { p : ℂ × ℂ | x_lo < p.1.re ∧ p.1.re < x_hi ∧
          y_lo < p.1.im ∧ p.1.im < y_hi ∧ ‖p.2 - t_c‖ < r_t } := by
    intro x_lo x_hi y_lo y_hi t_c r_t
    have h_eq : { p : ℂ × ℂ | x_lo < p.1.re ∧ p.1.re < x_hi ∧
          y_lo < p.1.im ∧ p.1.im < y_hi ∧ ‖p.2 - t_c‖ < r_t } =
        ((Complex.reCLM ⁻¹' Set.Ioo x_lo x_hi) ∩
          (Complex.imCLM ⁻¹' Set.Ioo y_lo y_hi)) ×ˢ
          Metric.ball t_c r_t := by
      ext ⟨y, t⟩
      simp only [Set.mem_setOf_eq, Set.mem_prod, Set.mem_inter_iff, Set.mem_preimage,
        Complex.reCLM_apply, Set.mem_Ioo, Complex.imCLM_apply, Metric.mem_ball, dist_eq_norm]
      tauto
    rw [h_eq]
    refine ⟨((isOpen_Ioo.preimage Complex.continuous_re).inter
        (isOpen_Ioo.preimage Complex.continuous_im)).prod Metric.isOpen_ball, ?_⟩
    exact (((convex_Ioo x_lo x_hi).linear_preimage Complex.reCLM.toLinearMap).inter
      ((convex_Ioo y_lo y_hi).linear_preimage Complex.imCLM.toLinearMap)).prod
      (convex_ball t_c r_t)
  have h_lsc_ball : ∀ (t_c : ℂ) (c_val : ℝ),
      t_c ∈ Metric.ball (0 : ℂ) M.r_base →
      ENNReal.ofReal c_val < M.h_X t_c →
      ∃ δ_l : ℝ, 0 < δ_l ∧ ∀ t : ℂ, ‖t - t_c‖ < δ_l → ENNReal.ofReal c_val < M.h_X t := by
    intro t_c c_val ht_c hc
    have hev : ∀ᶠ t in nhds t_c, ENNReal.ofReal c_val < M.h_X t := by
      have h1 := M.h_X_lsc t_c ht_c (ENNReal.ofReal c_val) hc
      rwa [nhdsWithin_eq_nhds.mpr (Metric.isOpen_ball.mem_nhds ht_c)] at h1
    obtain ⟨δ_l, hδ_l, hball⟩ := Metric.eventually_nhds_iff_ball.mp hev
    exact ⟨δ_l, hδ_l, fun t ht => hball t (by rwa [Metric.mem_ball, dist_eq_norm])⟩
  have h_T_mero_open : IsOpen (meroTubeENNR M.r_base M.h_X) := by
    have h_sep : ∀ (a : ℝ) (t_c : ℂ),
        t_c ∈ Metric.ball (0 : ℂ) M.r_base →
        ENNReal.ofReal a < M.h_X t_c →
        ∃ c_a : ℝ, a < c_a ∧ ENNReal.ofReal c_a < M.h_X t_c := by
      intro a t_c ht_c ha_lt
      by_cases ha_s : a < M.s_base / 2
      · refine ⟨M.s_base / 2, ha_s, ?_⟩
        exact lt_of_lt_of_le
          ((ENNReal.ofReal_lt_ofReal_iff M.s_base_pos).mpr (by linarith [M.s_base_pos]))
          (M.h_X_ge t_c ht_c)
      · push_neg at ha_s
        have ha_pos : 0 < a := by linarith [M.s_base_pos]
        rcases eq_top_or_lt_top (M.h_X t_c) with htop | hlt
        · exact ⟨a + 1, by linarith, htop ▸ ENNReal.ofReal_lt_top⟩
        · let H_c : ℝ := (M.h_X t_c).toReal
          have hHc_eq : M.h_X t_c = ENNReal.ofReal H_c :=
            (ENNReal.ofReal_toReal (ne_of_lt hlt)).symm
          rw [hHc_eq] at ha_lt
          have hHc_pos : 0 < H_c :=
            ENNReal.ofReal_pos.mp (lt_trans (ENNReal.ofReal_pos.mpr ha_pos) ha_lt)
          have ha_Hc : a < H_c := (ENNReal.ofReal_lt_ofReal_iff hHc_pos).mp ha_lt
          refine ⟨(a + H_c) / 2, by linarith, ?_⟩
          rw [hHc_eq]
          exact (ENNReal.ofReal_lt_ofReal_iff hHc_pos).mpr (by linarith)
    rw [Metric.isOpen_iff]
    intro p ⟨hp_t, hp_neg, hp_pos⟩
    have ht_ball : p.2 ∈ Metric.ball (0 : ℂ) M.r_base := by
      rwa [Metric.mem_ball, dist_zero_right]
    have hconj_ball : starRingEnd ℂ p.2 ∈ Metric.ball (0 : ℂ) M.r_base := by
      rw [Metric.mem_ball, dist_zero_right, Complex.norm_conj]
      exact hp_t
    obtain ⟨c_pos, hc_pos_gt, hc_pos_lt⟩ := h_sep p.1.im p.2 ht_ball hp_pos
    obtain ⟨δ_pos, hδ_pos, hball_pos⟩ := h_lsc_ball p.2 c_pos ht_ball hc_pos_lt
    obtain ⟨c_neg, hc_neg_gt, hc_neg_lt⟩ := h_sep (-p.1.im) (starRingEnd ℂ p.2) hconj_ball hp_neg
    obtain ⟨δ_neg, hδ_neg, hball_neg⟩ := h_lsc_ball (starRingEnd ℂ p.2) c_neg hconj_ball hc_neg_lt
    let r_p : ℝ :=
      min (M.r_base - ‖p.2‖)
        (min (min (c_pos - p.1.im) (c_neg + p.1.im)) (min δ_pos δ_neg))
    have hr_p_pos : 0 < r_p :=
      lt_min (by linarith)
        (lt_min (lt_min (by linarith) (by linarith)) (lt_min hδ_pos hδ_neg))
    refine ⟨r_p, hr_p_pos, ?_⟩
    intro q hq
    rw [Metric.mem_ball, Prod.dist_eq, max_lt_iff, dist_eq_norm, dist_eq_norm] at hq
    obtain ⟨hq1, hq2⟩ := hq
    have hr1 : r_p ≤ M.r_base - ‖p.2‖ := min_le_left _ _
    have hr_cpos : r_p ≤ c_pos - p.1.im :=
      le_trans (min_le_right _ _) (le_trans (min_le_left _ _) (min_le_left _ _))
    have hr_cneg : r_p ≤ c_neg + p.1.im :=
      le_trans (min_le_right _ _) (le_trans (min_le_left _ _) (min_le_right _ _))
    have hr_dpos : r_p ≤ δ_pos :=
      le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_left _ _))
    have hr_dneg : r_p ≤ δ_neg :=
      le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_right _ _))
    have him_diff : |q.1.im - p.1.im| < r_p := by
      have h : (q.1 - p.1).im = q.1.im - p.1.im := by simp
      rw [← h]
      exact lt_of_le_of_lt (Complex.abs_im_le_norm _) hq1
    have him_b := abs_lt.mp him_diff
    have hq2_norm : ‖q.2‖ < M.r_base := by
      have htri : ‖q.2‖ ≤ ‖p.2‖ + ‖q.2 - p.2‖ := norm_le_insert' q.2 p.2
      linarith
    have hconj_dist : ‖starRingEnd ℂ q.2 - starRingEnd ℂ p.2‖ < δ_neg := by
      rw [← map_sub, Complex.norm_conj]
      exact lt_of_lt_of_le hq2 hr_dneg
    refine ⟨hq2_norm, ?_, ?_⟩
    · exact lt_of_le_of_lt (ENNReal.ofReal_le_ofReal (by linarith))
        (hball_neg (starRingEnd ℂ q.2) hconj_dist)
    · exact lt_of_le_of_lt (ENNReal.ofReal_le_ofReal (by linarith))
        (hball_pos q.2 (lt_of_lt_of_le hq2 hr_dpos))
  have h_bshift_real : ∀ (t₀ : ℝ), |t₀| < M.r_base →
      (L.b_shift (t₀ : ℂ)).im = 0 ∧
      ∀ η : ℝ, 0 < η → ∃ δ_b : ℝ, 0 < δ_b ∧
        ∀ t : ℂ, ‖t - (t₀ : ℂ)‖ < δ_b →
          ‖L.b_shift t - L.b_shift (t₀ : ℂ)‖ < η := by
    intro t₀ ht₀
    have ht₀_ball : (t₀ : ℂ) ∈ Metric.ball (0 : ℂ) M.r_base := by
      rw [Metric.mem_ball, dist_zero_right, Complex.norm_real, Real.norm_eq_abs]
      exact ht₀
    have him : (L.b_shift (t₀ : ℂ)).im = 0 := by
      have hconj := L.b_shift_conj (t₀ : ℂ) ht₀_ball
      rw [Complex.conj_ofReal] at hconj
      exact Complex.conj_eq_iff_im.mp hconj.symm
    refine ⟨him, fun η hη => ?_⟩
    have hcont : ContinuousAt L.b_shift (t₀ : ℂ) :=
      L.b_shift_holo.continuousOn.continuousAt (Metric.isOpen_ball.mem_nhds ht₀_ball)
    obtain ⟨δ_b, hδ_b, hball⟩ := Metric.continuousAt_iff.mp hcont η hη
    exact ⟨δ_b, hδ_b, fun t ht => by
      simpa only [dist_eq_norm] using hball (by rwa [dist_eq_norm])⟩
  
  have h_pole_clear : ∀ (i : Fin 2) (s₁ : ℂ), s₁ ∈ horizStripENNR (M.h_X 0) →
      ∃ (r₁ : ℝ) (N : ℕ) (N_hol : ℂ → ℂ),
        0 < r₁ ∧
        DifferentiableOn ℂ N_hol (Metric.ball s₁ r₁) ∧
        ∀ z ∈ Metric.ball s₁ r₁, z ≠ s₁ →
          K.f z ≠ 0 ∧ (z - s₁) ^ N * K.Γ z i = N_hol z := by
    intro i s₁ hs₁
    have hDH_open : IsOpen (horizStripENNR (M.h_X 0)) :=
      isOpen_lt (ENNReal.continuous_ofReal.comp (continuous_abs.comp Complex.continuous_im))
        continuous_const
    have hDH_conv : Convex ℝ (horizStripENNR (M.h_X 0)) := by
      intro z₁ hz₁ z₂ hz₂ a b ha hb hab
      have him_le : |(a • z₁ + b • z₂).im| ≤ max |z₁.im| |z₂.im| := by
        have h1 : (a • z₁ + b • z₂).im = a * z₁.im + b * z₂.im := by simp
        rw [h1]
        calc |a * z₁.im + b * z₂.im|
            ≤ |a * z₁.im| + |b * z₂.im| := abs_add_le _ _
          _ = a * |z₁.im| + b * |z₂.im| := by
              rw [abs_mul, abs_mul, abs_of_nonneg ha, abs_of_nonneg hb]
          _ ≤ a * max |z₁.im| |z₂.im| + b * max |z₁.im| |z₂.im| := by
              gcongr
              · exact le_max_left _ _
              · exact le_max_right _ _
          _ = (a + b) * max |z₁.im| |z₂.im| := by ring
          _ = max |z₁.im| |z₂.im| := by rw [hab, one_mul]
      show ENNReal.ofReal |(a • z₁ + b • z₂).im| < M.h_X 0
      calc ENNReal.ofReal |(a • z₁ + b • z₂).im|
          ≤ ENNReal.ofReal (max |z₁.im| |z₂.im|) := ENNReal.ofReal_le_ofReal him_le
        _ < M.h_X 0 := by
            rcases max_choice |z₁.im| |z₂.im| with hmax | hmax <;> rw [hmax]
            · exact hz₁
            · exact hz₂
    have h0_DH : (0 : ℂ) ∈ horizStripENNR (M.h_X 0) := by
      show ENNReal.ofReal |(0 : ℂ).im| < M.h_X 0
      simpa using h_hX0_pos
    have hf0_ne : K.f 0 ≠ 0 := by
      intro h0
      have hpos := (K.f_real_pos 0).1
      simp [h0] at hpos
    have hf_ana : AnalyticOnNhd ℂ K.f (horizStripENNR (M.h_X 0)) :=
      (Complex.analyticOnNhd_iff_differentiableOn hDH_open).mpr K.f_holo
    have hf_punc : ∀ᶠ z in nhdsWithin s₁ {s₁}ᶜ, K.f z ≠ 0 := by
      rcases (hf_ana s₁ hs₁).eventually_eq_zero_or_eventually_ne_zero with hev0 | hev_ne
      · exact False.elim (hf0_ne
          (hf_ana.eqOn_zero_of_preconnected_of_eventuallyEq_zero hDH_conv.isPreconnected
            hs₁ hev0 h0_DH))
      · exact hev_ne
    rw [eventually_nhdsWithin_iff] at hf_punc
    obtain ⟨r_f, hr_f_pos, hr_f⟩ := Metric.eventually_nhds_iff_ball.mp hf_punc
    have hΓ_at : MeromorphicAt (fun z => K.Γ z i) s₁ := by
      fin_cases i
      · exact K.Γ_mero.1 s₁ hs₁
      · exact K.Γ_mero.2 s₁ hs₁
    obtain ⟨n, h_loc, hh_ana, hh_ev⟩ :=
      MeromorphicAt.iff_eventuallyEq_zpow_smul_analyticAt.mp hΓ_at
    obtain ⟨r_h, hr_h_pos, hr_h⟩ :=
      Metric.eventually_nhds_iff_ball.mp hh_ana.eventually_analyticAt
    have hh_holo : DifferentiableOn ℂ h_loc (Metric.ball s₁ r_h) :=
      AnalyticOnNhd.differentiableOn (fun z hz => hr_h z hz)
    change ∀ᶠ z in nhdsWithin s₁ {s₁}ᶜ, K.Γ z i = (z - s₁) ^ n • h_loc z at hh_ev
    rw [eventually_nhdsWithin_iff] at hh_ev
    obtain ⟨r_eq, hr_eq_pos, hr_eq⟩ := Metric.eventually_nhds_iff_ball.mp hh_ev
    let N : ℕ := (-n).toNat
    let M_exp : ℕ := (n + (N : ℤ)).toNat
    have hNM : (N : ℤ) + n = (M_exp : ℤ) := by omega
