            rcases h_antidiag hp_mem with ⟨hp_add, hp_deg⟩
            have hp2_ne : p.2 0 + p.2 1 ≠ 0 := by
              intro hp20
              have hp2_zero : p.2 = 0 := (h_eq_zero_iff p.2).mpr hp20
              have hp1_eq : p.1 = d := by rw [hp2_zero, add_zero] at hp_add; exact hp_add
              exact hp_ne (Prod.ext hp1_eq hp2_zero)
            exact L.mul_mem (ih (p.1 0 + p.1 1) (by omega) p.1 rfl) (hT p.2)
          have h_solve : MvPowerSeries.coeff d S = (-rem) / MvPowerSeries.coeff 0 T := by
            apply eq_div_of_mul_eq ht0_ne
            linear_combination h_cd
          rw [h_solve]
          exact L.div_mem (L.neg_mem hrem_mem) (hT 0)
    intro d
    exact h_ind (d 0 + d 1) d rfl
  have h_sqrt_mem : ∀ (L : Subfield ℂ) {S T : MvPowerSeries (Fin 2) ℂ},
