    fun hf hg => (hJet.taylor2D_ring hU₀_open hp₁_U₀ hf hg).1
  have h_tay_sub : ∀ {f g : ℂ × ℂ → ℂ},
      DifferentiableOn ℂ f U₀ → DifferentiableOn ℂ g U₀ →
      taylor2D (fun q => f q - g q) p₁ = taylor2D f p₁ - taylor2D g p₁ :=
    fun hf hg => (hJet.taylor2D_ring hU₀_open hp₁_U₀ hf hg).2.1
  have h_tay_mul : ∀ {f g : ℂ × ℂ → ℂ},
      DifferentiableOn ℂ f U₀ → DifferentiableOn ℂ g U₀ →
      taylor2D (fun q => f q * g q) p₁ = taylor2D f p₁ * taylor2D g p₁ :=
    fun hf hg => (hJet.taylor2D_ring hU₀_open hp₁_U₀ hf hg).2.2
  have h_tay_cmul : ∀ (c : ℂ) {g : ℂ × ℂ → ℂ},
