                  ‖p_0 + ζ * v_0‖ ≤ ‖p_0‖ + ‖ζ‖ * ‖v_0‖ := by
                    rw [← norm_mul]; exact norm_add_le _ _
                  _ ≤ r + (R₀ / 2) * 1 :=
                    add_le_add hp0 (mul_le_mul (le_of_lt hζ) hv0_norm (norm_nonneg _) (by linarith))
                  _ ≤ R₀ := by linarith
              · calc
                  ‖p_p + ζ * v_p‖ ≤ ‖p_p‖ + ‖ζ‖ * ‖v_p‖ := by
