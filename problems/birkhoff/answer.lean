          · intro ζ hζ
            exact (differentiableOn_const (g_plus ζ T_c Y)).div
              ((differentiableOn_const ζ).sub differentiableOn_id)
              (fun ζ₀ hζ₀ => hDisjoint_bdry ζ hζ ζ₀ hζ₀)
        exact hI_holo.const_mul (2 * (Real.pi : ℂ) * Complex.I)⁻¹
      have hg_holo_col : DifferentiableOn ℂ (fun ζ => g_plus ζ T_c Y) V_collar := by
        have hG_col : DifferentiableOn ℂ G V_collar :=
          hG_holo.mono (fun ζ hζ => (hCollar_Uw_mem ζ hζ T_c hTc Y hY_in_Uw).1)
        have hmap : DifferentiableOn ℂ (fun ζ => (ζ, Y + G ζ - G T_c)) V_collar :=
          differentiableOn_id.prodMk
            (((differentiableOn_const Y).add hG_col).sub (differentiableOn_const (G T_c)))
        exact hΦ_holo.comp hmap (fun ζ hζ => (hCollar_Uw_mem ζ hζ T_c hTc Y hY_in_Uw).2.2)
      have hgtilde_eq_col : ∀ ζ ∈ V_collar, g_tilde ζ = g_plus ζ T_c Y := by
        intro ζ hζ
