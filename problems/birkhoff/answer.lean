            (Ψ (z, 0)).2 = G_gr.θ_inv z) ∧
        (∀ i : Fin k, pointChartEll C Ψ i (z, 0) = 0) := by
      intro z hz
      have hΨz := hΨ_zero_eq z hz
      have hqz_U₀ : (z, (0 : ℂ)) ∈ U₀ := ⟨hz, Metric.mem_ball_self (by positivity)⟩
      have hyz_W₀ : Ψ (z, 0) ∈ W₀ := hV₀_sub (hΨ_maps_V₀ (z, 0) hqz_U₀)
      have hyz_2s₁ : |(Ψ (z, 0)).1.im| < 2 * C.s₁ := by
