  jet_lip : ∀ (σ σ' α ρ sgn Δe Δτ : ℝ) (q : ℕ) (w₁ w₂ : ℝ → ℝ)
      (W₁ W₂ e_X₁ τ_T₁ e_X₂ τ_T₂ : ℂ → ℂ),
