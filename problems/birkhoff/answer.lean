                     lcJetEdgeMinus2D (h_tr i_R) (S_ser i_R) (C_ser i_R)
                      (lcJetMid2D α_ref i_R) (lcJetHalfStep2D α_ref i_R)) := by
              unfold lcJetGrad2D
              simp only [map_add, map_sub]
              ring
            have h_L_pert := (h_edge_pert i_L).1
            have h_R_pert := (h_edge_pert i_R).2
            rw [h_grad_tr_zero r, zero_sub] at h_grad_diff
            change _ = b_vec r
            dsimp only [b_vec]
            rw [h_grad_diff, h_L_pert, h_R_pert]
            dsimp only [D_val, U_val, L_val, i_L, i_R, Fin.castSucc, Fin.succ, Fin.castAdd,
              Fin.castLE]
            ring
          have hx_mem : ∀ s : Fin (k - 1), x_vec s ∈ F_val :=
            hSub.mulVec_mem F_val hH_mem hHess_det hb_mem hHx_eq
          
          rcases Nat.eq_zero_or_pos r_goal.1 with hr0 | hr_pos
          · have h_eq : r_goal = 0 := Fin.ext hr0
            rw [h_eq, hα_zero]
            exact hSub.X_mem F_val 0 d
          · rcases lt_or_eq_of_le (Nat.le_of_lt_succ r_goal.2) with hr_lt | hrk
            · let s_idx : Fin (k - 1) := ⟨r_goal.1 - 1, by omega⟩
              have h_idx : (⟨s_idx.1 + 1, by have := s_idx.2; omega⟩ : Fin (k + 1)) = r_goal := by
                apply Fin.ext; dsimp [s_idx]; omega
              have hx_s := hx_mem s_idx
              dsimp only [x_vec] at hx_s
              rw [hη_int s_idx d (le_of_eq hd_eq.symm), h_idx] at hx_s
              exact hx_s
            · have h_eq : r_goal = Fin.last k := Fin.ext hrk
              rw [h_eq, hα_last]
              exact hSub.add_mem F_val (hSub.X_mem F_val 0) (hSub.X_mem F_val 1) d
  
  have hVandStep : ∀ (M : ℕ), max 2 k < M →
      (∀ (i : Fin k) (m : ℕ), m < M → PowerSeries.coeff m (h_ser i) ∈ F_val) →
      ∀ i : Fin k, PowerSeries.coeff M (h_ser i) ∈ F_val := by
    intro M hM hJetsLow
    have hM3 : 3 ≤ M := by omega
    have hkM : k + 1 ≤ M := by omega
    have hM_lt_2N : M < 2 * (M - 1) := by omega
    have hAngLow : ∀ (r : Fin (k + 1)) (u : Fin 2 →₀ ℕ), u 0 + u 1 ≤ M - 2 →
        MvPowerSeries.coeff u (α_ser r) ∈ F_val :=
      hStatRec (M - 2) (fun i m hm => hJetsLow i m (by omega))
    
    let h_low : Fin k → PowerSeries ℂ := fun i => lcJetTrunc1D (M - 1) (h_ser i)
    let ψ_ser : Fin k → MvPowerSeries (Fin 2) ℂ := fun i => lcJetMid2D α_ser i
    have hψ_c0 : ∀ i : Fin k, MvPowerSeries.coeff 0 (ψ_ser i) = 0 := by
      intro i
      dsimp only [ψ_ser, lcJetMid2D]
      rw [MvPowerSeries.coeff_C_mul, map_add, hα_c0, hα_c0, add_zero, mul_zero]
    have h_act_split : ∀ d : Fin 2 →₀ ℕ, d 0 + d 1 = M →
