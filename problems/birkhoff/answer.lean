            (dirichletInv_ℂ q (stripMeshForcing_ℂ J_C q W₂ d₂) (j + 1) ζ -
            dirichletInv_ℂ q (stripMeshForcing_ℂ J_C q W₂ d₂) j ζ) =
          dirichletInv_ℂ q f_diff (j + 1) ζ - dirichletInv_ℂ q f_diff j ζ
        linear_combination h1 - h0
      rw [hStepFn]
      exact hBall.2.2.2 j hj k hk z hz
  have hSingle : ∀ (w : ℝ → ℝ) (W : ℂ → ℂ),
