          (m0_seq j) ^ 2 ≤ 2 * Real.exp (3 * ((R : ℝ) + 1)) + 1 := by
      intro θ _
      let uθ : ℝ := (3 / 2 : ℝ) * ((R : ℝ) + 1) * Real.sin θ
      have hy_eq : h_seq j + (3 / 2 : ℝ) * (((R : ℝ) + 1) * ℓ_seq j) * Real.sin θ =
