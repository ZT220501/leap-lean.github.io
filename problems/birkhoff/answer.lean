        linarith
      have hε_pos : 0 < ε_bar i := by dsimp [ε_bar]; positivity
      have hε_lt1 : ε_bar i < 1 := by
        dsimp [ε_bar]
        exact pow_lt_one₀ hbase_pos.le (by linarith) hA_pos.ne'
      have hN_ge1 : 1 ≤ N_seq i := by dsimp [N_seq]; omega
      let R_i : ℝ := (2 : ℝ) ^ i / d₀
      have hR_gt4 : 4 < R_i := by
        dsimp [R_i]
        rw [lt_div_iff₀ hd₀_pos]
        linarith
      have hR_pos : 0 < R_i := by linarith
      have hε_eq_R : ε_bar i = R_i⁻¹ ^ A_exp := by
