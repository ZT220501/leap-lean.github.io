      have hc : ContinuousAt (fun d : ℂ => q₁ + d) 0 := continuousAt_const.add continuousAt_id
      have hq0 : q₁ + (0 : ℂ) = q₁ := add_zero q₁
      have hcomp : ContinuousAt (fun d : ℂ => -u₁ (q₁ + d)) 0 :=
        (ContinuousAt.comp (by rw [hq0]; exact hu₁_cont) hc).neg
      have ht := (hcomp.continuousWithinAt (s := {(0 : ℂ)}ᶜ)).tendsto
      rwa [hq0] at ht
    have h_ev : (fun d : ℂ => u₁ (q₁ - d)) =ᶠ[nhdsWithin 0 {0}ᶜ] (fun d : ℂ => -u₁ (q₁ + d)) := by
      filter_upwards [nhdsWithin_le_nhds (Metric.ball_mem_nhds (0 : ℂ) hr₀_pos),
          self_mem_nhdsWithin] with d hd hd_ne
      rw [Metric.mem_ball, dist_zero_right] at hd
      have hev := hu_even d hd
      rw [hu_exp1 (q₁ - d), hu_exp1 (q₁ + d)] at hev
      have h_alg : d * (u₁ (q₁ - d) + u₁ (q₁ + d)) = 0 := by linear_combination -hev
      rcases mul_eq_zero.mp h_alg with h0 | hsum
      · exact absurd h0 hd_ne
      · linear_combination hsum
    have h_eq : u₁ q₁ = -u₁ q₁ := tendsto_nhds_unique ht1 (ht2.congr' h_ev.symm)
    linear_combination h_eq / 2
  let u₂ : ℂ → ℂ := dslope u₁ q₁
  have hu₂_diff : DifferentiableOn ℂ u₂ B :=
    (Complex.differentiableOn_dslope hB_nhds).mpr hu₁_diff
  let β₁ : ℂ := u₂ q₁
  let u₃ : ℂ → ℂ := dslope u₂ q₁
  have hu₃_diff : DifferentiableOn ℂ u₃ B :=
    (Complex.differentiableOn_dslope hB_nhds).mpr hu₂_diff
  have hu_exp3 : ∀ z : ℂ, u z = α₁ + β₁ * (z - q₁) ^ 2 + (z - q₁) ^ 3 * u₃ z := by
    intro z
    have h1 := sub_smul_dslope u₁ q₁ z
    have h2 := sub_smul_dslope u₂ q₁ z
    simp only [smul_eq_mul] at h1 h2
    rw [hu₁_zero, sub_zero] at h1
    dsimp [u₂, u₃, β₁] at h1 h2 ⊢
    rw [hu_exp1 z, ← h1]
    linear_combination -(z - q₁) ^ 2 * h2
  have hu₃_zero : u₃ q₁ = 0 := by
    have hu₃_cont : ContinuousAt u₃ q₁ := (hu₃_diff.differentiableAt hB_nhds).continuousAt
    have ht1 : Filter.Tendsto (fun d : ℂ => u₃ (q₁ - d)) (nhdsWithin 0 {0}ᶜ) (nhds (u₃ q₁)) := by
      have hc : ContinuousAt (fun d : ℂ => q₁ - d) 0 := continuousAt_const.sub continuousAt_id
      have hq0 : q₁ - (0 : ℂ) = q₁ := sub_zero q₁
      have hcomp : ContinuousAt (fun d : ℂ => u₃ (q₁ - d)) 0 :=
        ContinuousAt.comp (by rw [hq0]; exact hu₃_cont) hc
      have ht := (hcomp.continuousWithinAt (s := {(0 : ℂ)}ᶜ)).tendsto
      rwa [hq0] at ht
    have ht2 : Filter.Tendsto (fun d : ℂ => -u₃ (q₁ + d)) (nhdsWithin 0 {0}ᶜ) (nhds (-u₃ q₁)) := by
      have hc : ContinuousAt (fun d : ℂ => q₁ + d) 0 := continuousAt_const.add continuousAt_id
      have hq0 : q₁ + (0 : ℂ) = q₁ := add_zero q₁
      have hcomp : ContinuousAt (fun d : ℂ => -u₃ (q₁ + d)) 0 :=
        (ContinuousAt.comp (by rw [hq0]; exact hu₃_cont) hc).neg
      have ht := (hcomp.continuousWithinAt (s := {(0 : ℂ)}ᶜ)).tendsto
      rwa [hq0] at ht
    have h_ev : (fun d : ℂ => u₃ (q₁ - d)) =ᶠ[nhdsWithin 0 {0}ᶜ] (fun d : ℂ => -u₃ (q₁ + d)) := by
      filter_upwards [nhdsWithin_le_nhds (Metric.ball_mem_nhds (0 : ℂ) hr₀_pos),
          self_mem_nhdsWithin] with d hd hd_ne
      rw [Metric.mem_ball, dist_zero_right] at hd
      have hev := hu_even d hd
      rw [hu_exp3 (q₁ - d), hu_exp3 (q₁ + d)] at hev
      have hd3_ne : d ^ 3 ≠ 0 := pow_ne_zero 3 hd_ne
      have h_alg : d ^ 3 * (u₃ (q₁ - d) + u₃ (q₁ + d)) = 0 := by linear_combination -hev
      rcases mul_eq_zero.mp h_alg with h0 | hsum
      · exact absurd h0 hd3_ne
      · linear_combination hsum
    have h_eq : u₃ q₁ = -u₃ q₁ := tendsto_nhds_unique ht1 (ht2.congr' h_ev.symm)
    linear_combination h_eq / 2
  let u₄ : ℂ → ℂ := dslope u₃ q₁
  have hu₄_diff : DifferentiableOn ℂ u₄ B :=
    (Complex.differentiableOn_dslope hB_nhds).mpr hu₃_diff
  have hdu₄_diff : DifferentiableOn ℂ (deriv u₄) B := hu₄_diff.deriv Metric.isOpen_ball
  have hu_exp4 : ∀ z : ℂ, u z = α₁ + β₁ * (z - q₁) ^ 2 + (z - q₁) ^ 4 * u₄ z := by
    intro z
    have h3 := sub_smul_dslope u₃ q₁ z
    simp only [smul_eq_mul] at h3
    rw [hu₃_zero, sub_zero] at h3
    dsimp [u₄] at h3 ⊢
    rw [hu_exp3 z, ← h3]
    ring
  have ha_laurent : ∀ z ∈ B, z ≠ q₁ →
      a z = α₁ * (z - q₁)⁻¹ + β₁ * (z - q₁) + (z - q₁) ^ 3 * u₄ z ∧
      deriv a z = -α₁ * ((z - q₁) ^ 2)⁻¹ + β₁ +
        3 * (z - q₁) ^ 2 * u₄ z + (z - q₁) ^ 3 * deriv u₄ z := by
    intro z hz hz_ne
    have hzq : z - q₁ ≠ 0 := sub_ne_zero.mpr hz_ne
    have ha_val : ∀ w ∈ B \ {q₁},
        a w = α₁ * (w - q₁)⁻¹ + β₁ * (w - q₁) + (w - q₁) ^ 3 * u₄ w := by
      intro w hw
      have hwq : w - q₁ ≠ 0 := sub_ne_zero.mpr hw.2
      rw [ha_on_B w hw.1 hw.2, hu_exp4 w]
      field_simp
    refine ⟨ha_val z ⟨hz, hz_ne⟩, ?_⟩
    have h_nhds_punc : B \ {q₁} ∈ nhds z :=
      (Metric.isOpen_ball.sdiff isClosed_singleton).mem_nhds ⟨hz, hz_ne⟩
    have h_ev : a =ᶠ[nhds z] (fun w => α₁ * (w - q₁)⁻¹ + β₁ * (w - q₁) + (w - q₁) ^ 3 * u₄ w) :=
      Filter.eventuallyEq_of_mem h_nhds_punc ha_val
    rw [h_ev.deriv_eq]
    have hd_sub : HasDerivAt (fun w : ℂ => w - q₁) 1 z := by
      simpa using (hasDerivAt_id z).sub_const q₁
    have hd_term1 : HasDerivAt (fun w : ℂ => α₁ * (w - q₁)⁻¹) (-α₁ * ((z - q₁) ^ 2)⁻¹) z := by
      convert (hd_sub.inv hzq).const_mul α₁ using 1
      field_simp
    have hd_term2 : HasDerivAt (fun w : ℂ => β₁ * (w - q₁)) β₁ z := by
      simpa using hd_sub.const_mul β₁
    have hd_u₄ : HasDerivAt u₄ (deriv u₄ z) z :=
      (hu₄_diff.differentiableAt (Metric.isOpen_ball.mem_nhds hz)).hasDerivAt
    have hd_pow3 : HasDerivAt (fun w : ℂ => (w - q₁) ^ 3) (3 * (z - q₁) ^ 2) z := by
      convert hd_sub.pow 3 using 1
      ring
    have hd_term3 : HasDerivAt (fun w : ℂ => (w - q₁) ^ 3 * u₄ w)
        (3 * (z - q₁) ^ 2 * u₄ z + (z - q₁) ^ 3 * deriv u₄ z) z :=
      hd_pow3.mul hd_u₄
    have hd_sum : HasDerivAt
        (fun w : ℂ => α₁ * (w - q₁)⁻¹ + β₁ * (w - q₁) + (w - q₁) ^ 3 * u₄ w)
        (-α₁ * ((z - q₁) ^ 2)⁻¹ + β₁ + 3 * (z - q₁) ^ 2 * u₄ z + (z - q₁) ^ 3 * deriv u₄ z) z := by
      convert (hd_term1.add hd_term2).add hd_term3 using 1
      ring
    exact hd_sum.deriv
  
  let A₄ : ℂ := (α₁ ^ 2)⁻¹
  let A₂ : ℂ := -6 * β₁ * α₁⁻¹
  let Ψ : ℂ → ℂ := fun z => (deriv a z) ^ 2 - A₄ * (a z) ^ 4 - A₂ * (a z) ^ 2
  let R_loc : ℂ → ℂ := fun z => β₁ + (z - q₁) ^ 2 * u₄ z
  let S_loc : ℂ → ℂ := fun z => 3 * u₄ z + (z - q₁) * deriv u₄ z
  let H₁ : ℂ → ℂ := fun z =>
    (β₁ ^ 2 - 2 * α₁ * S_loc z + 2 * β₁ * (z - q₁) ^ 2 * S_loc z +
      (z - q₁) ^ 4 * (S_loc z) ^ 2) +
    (-4 * α₁ * u₄ z - 6 * (R_loc z) ^ 2 - 4 * α₁⁻¹ * (z - q₁) ^ 2 * (R_loc z) ^ 3 -
      (α₁ ^ 2)⁻¹ * (z - q₁) ^ 4 * (R_loc z) ^ 4) +
    (12 * β₁ * R_loc z + 6 * β₁ * α₁⁻¹ * (z - q₁) ^ 2 * (R_loc z) ^ 2)
  have hR_diff : DifferentiableOn ℂ R_loc B :=
    differentiableOn_const _ |>.add (((differentiableOn_id.sub (differentiableOn_const q₁)).pow 2).mul hu₄_diff)
  have hS_diff : DifferentiableOn ℂ S_loc B :=
    ((differentiableOn_const 3).mul hu₄_diff).add
      ((differentiableOn_id.sub (differentiableOn_const q₁)).mul hdu₄_diff)
  have hsub_diff : DifferentiableOn ℂ (fun z : ℂ => z - q₁) B :=
    differentiableOn_id.sub (differentiableOn_const q₁)
  have hH₁_diff : DifferentiableOn ℂ H₁ B := by
    have hp1 : DifferentiableOn ℂ (fun z =>
        β₁ ^ 2 - 2 * α₁ * S_loc z + 2 * β₁ * (z - q₁) ^ 2 * S_loc z +
          (z - q₁) ^ 4 * (S_loc z) ^ 2) B :=
      (((differentiableOn_const _).sub ((differentiableOn_const _).mul hS_diff)).add
        (((differentiableOn_const _).mul (hsub_diff.pow 2)).mul hS_diff)).add
        ((hsub_diff.pow 4).mul (hS_diff.pow 2))
    have hp2 : DifferentiableOn ℂ (fun z =>
        -4 * α₁ * u₄ z - 6 * (R_loc z) ^ 2 - 4 * α₁⁻¹ * (z - q₁) ^ 2 * (R_loc z) ^ 3 -
          (α₁ ^ 2)⁻¹ * (z - q₁) ^ 4 * (R_loc z) ^ 4) B :=
      ((((differentiableOn_const _).mul hu₄_diff).sub
        ((differentiableOn_const _).mul (hR_diff.pow 2))).sub
        (((differentiableOn_const _).mul (hsub_diff.pow 2)).mul (hR_diff.pow 3))).sub
        (((differentiableOn_const _).mul (hsub_diff.pow 4)).mul (hR_diff.pow 4))
    have hp3 : DifferentiableOn ℂ (fun z =>
        12 * β₁ * R_loc z + 6 * β₁ * α₁⁻¹ * (z - q₁) ^ 2 * (R_loc z) ^ 2) B :=
      ((differentiableOn_const _).mul hR_diff).add
        (((differentiableOn_const _).mul (hsub_diff.pow 2)).mul (hR_diff.pow 2))
    exact (hp1.add hp2).add hp3
  have hΨ_eq_H₁ : ∀ z ∈ B, z ≠ q₁ → Ψ z = H₁ z := by
    intro z hz hz_ne
    obtain ⟨ha_z, hda_z⟩ := ha_laurent z hz hz_ne
    have hzq : z - q₁ ≠ 0 := sub_ne_zero.mpr hz_ne
    have hα : α₁ ≠ 0 := hα₁_ne
    dsimp [Ψ, H₁, R_loc, S_loc, A₄, A₂]
    rw [ha_z, hda_z]
    field_simp
    ring
  
  have hΨ_shift : ∀ (δ ε : ℂ), (ε = 1 ∨ ε = -1) →
      (∀ y : ℂ, a (y + δ) = ε * a y) → ∀ y : ℂ, Ψ (y + δ) = Ψ y := by
    intro δ ε hε h_shift y
    have h_fun : (fun w : ℂ => a (w + δ)) = (fun w : ℂ => ε * a w) := funext h_shift
    have hd_shift : deriv a (y + δ) = ε * deriv a y := by
      calc
        deriv a (y + δ) = deriv (fun w : ℂ => a (w + δ)) y := (deriv_comp_add_const a δ y).symm
        _ = deriv (fun w : ℂ => ε * a w) y := by rw [h_fun]
        _ = ε * deriv a y := deriv_const_mul_field ε
    dsimp [Ψ]
    rw [hd_shift, h_shift y]
    rcases hε with rfl | rfl <;> ring
  have hΨ_loc : ∀ s : ℂ, ∃ (V : Set ℂ) (q_s : ℂ → ℂ),
      IsOpen V ∧ s ∈ V ∧ DifferentiableOn ℂ q_s V ∧ ∀ z ∈ V, z ≠ s → Ψ z = q_s z := by
    intro s
    by_cases hs_ana : AnalyticAt ℂ a s
    · obtain ⟨r_s, hr_s_pos, hr_s_ana⟩ :=
        Metric.eventually_nhds_iff_ball.mp hs_ana.eventually_analyticAt
      have ha_diff_s : DifferentiableOn ℂ a (Metric.ball s r_s) :=
        fun z hz => (hr_s_ana z hz).differentiableAt.differentiableWithinAt
      have hda_diff_s : DifferentiableOn ℂ (deriv a) (Metric.ball s r_s) :=
        ha_diff_s.deriv Metric.isOpen_ball
      have hΨ_diff_s : DifferentiableOn ℂ Ψ (Metric.ball s r_s) :=
        ((hda_diff_s.pow 2).sub ((differentiableOn_const A₄).mul (ha_diff_s.pow 4))).sub
          ((differentiableOn_const A₂).mul (ha_diff_s.pow 2))
      exact ⟨Metric.ball s r_s, Ψ, Metric.isOpen_ball, Metric.mem_ball_self hr_s_pos,
        hΨ_diff_s, fun _ _ _ => rfl⟩
    · obtain ⟨m, n, h_case⟩ := ha_poles_class s hs_ana
      have h_per_mn : isPer (m • b 0 + n • b 1) := isPer_zsmul m n
      have h_shift_data : ∃ (δ ε : ℂ), s = q₁ + δ ∧ (ε = 1 ∨ ε = -1) ∧
          ∀ y : ℂ, a (y + δ) = ε * a y := by
        rcases h_case with hs1 | hs2
        · refine ⟨m • b 0 + n • b 1, 1, by rw [hs1]; abel, Or.inl rfl, fun y => ?_⟩
          simpa using h_per_mn y
        · refine ⟨η + (m • b 0 + n • b 1), -1, by rw [hs2]; abel, Or.inr rfl, fun y => ?_⟩
          have h_add : y + (η + (m • b 0 + n • b 1)) = (y + η) + (m • b 0 + n • b 1) := by abel
          rw [h_add, h_per_mn, ha_eta, neg_one_mul]
      obtain ⟨δ, ε, hs_eq, hε, ha_δ⟩ := h_shift_data
      have hΨ_δ := hΨ_shift δ ε hε ha_δ
      refine ⟨Metric.ball s r₀, fun z => H₁ (z - δ), Metric.isOpen_ball,
        Metric.mem_ball_self hr₀_pos, ?_, ?_⟩
      · intro z hz
        have hzB : z - δ ∈ B := by
          rw [Metric.mem_ball, dist_eq_norm] at hz ⊢
          have h_sub : (z - δ) - q₁ = z - s := by rw [hs_eq]; abel
          rwa [h_sub]
        have hd_H₁ : DifferentiableAt ℂ H₁ (z - δ) :=
          hH₁_diff.differentiableAt (Metric.isOpen_ball.mem_nhds hzB)
        exact (hd_H₁.comp z (differentiableAt_id.sub (differentiableAt_const δ))).differentiableWithinAt
      · intro z hz hz_ne
        have hzB : z - δ ∈ B := by
          rw [Metric.mem_ball, dist_eq_norm] at hz ⊢
          have h_sub : (z - δ) - q₁ = z - s := by rw [hs_eq]; abel
          rwa [h_sub]
        have hz_ne_q₁ : z - δ ≠ q₁ := by
          intro h_eq
          apply hz_ne
          rw [hs_eq, ← h_eq]
          abel
        calc
          Ψ z = Ψ ((z - δ) + δ) := by ring_nf
          _ = Ψ (z - δ) := hΨ_δ (z - δ)
          _ = H₁ (z - δ) := hΨ_eq_H₁ (z - δ) hzB hz_ne_q₁
  obtain ⟨hΨ_ext_diff, hΨ_ext_val, hΨ_ext_per⟩ := hpLim Ψ hΨ_loc
  have hΨ_per0 : ∀ z : ℂ, Ψ (z + b 0) = Ψ z :=
    hΨ_shift (b 0) 1 (Or.inl rfl) (fun y => by simpa using hb0 y)
  have hΨ_per1 : ∀ z : ℂ, Ψ (z + b 1) = Ψ z :=
    hΨ_shift (b 1) 1 (Or.inl rfl) (fun y => by simpa using hb1 y)
  obtain ⟨c₀, hc₀⟩ := hb_liouville _ hΨ_ext_diff
    (hΨ_ext_per (b 0) hΨ_per0) (hΨ_ext_per (b 1) hΨ_per1)
  have h_ode_ana : ∀ s : ℂ, AnalyticAt ℂ a s →
      (deriv a s) ^ 2 = A₄ * (a s) ^ 4 + A₂ * (a s) ^ 2 + c₀ := by
    intro s hs_ana
    obtain ⟨r_s, hr_s_pos, hr_s_ana⟩ :=
      Metric.eventually_nhds_iff_ball.mp hs_ana.eventually_analyticAt
    have ha_diff_s : DifferentiableOn ℂ a (Metric.ball s r_s) :=
      fun z hz => (hr_s_ana z hz).differentiableAt.differentiableWithinAt
    have hda_diff_s : DifferentiableOn ℂ (deriv a) (Metric.ball s r_s) :=
      ha_diff_s.deriv Metric.isOpen_ball
    have hΨ_diff_s : DifferentiableOn ℂ Ψ (Metric.ball s r_s) :=
      ((hda_diff_s.pow 2).sub ((differentiableOn_const A₄).mul (ha_diff_s.pow 4))).sub
        ((differentiableOn_const A₂).mul (ha_diff_s.pow 2))
    have h_val := hΨ_ext_val s (Metric.ball s r_s) Ψ Metric.isOpen_ball
      (Metric.mem_ball_self hr_s_pos) hΨ_diff_s (fun _ _ _ => rfl)
    rw [hc₀ s] at h_val
    dsimp [Ψ] at h_val
    linear_combination -h_val
  
  refine ⟨-(A₄.re + c₀.re), -A₂.re, A₄.im - c₀.im, ?_⟩
  intro x
  obtain ⟨hx_ana, hx_deriv⟩ := ha_real_deriv x
  have h_ode := h_ode_ana x hx_ana
  rw [hx_deriv, ha_real x] at h_ode
  let E : ℂ := Complex.exp (((2 * ϕ x : ℝ) : ℂ) * Complex.I)
  let E_inv : ℂ := Complex.exp (((-(2 * ϕ x) : ℝ) : ℂ) * Complex.I)
  have hE_mul : E * E_inv = 1 := by
    dsimp [E, E_inv]
    rw [← Complex.exp_add]
    have : (((2 * ϕ x : ℝ) : ℂ) * Complex.I) + (((-(2 * ϕ x) : ℝ) : ℂ) * Complex.I) = 0 := by
      push_cast; ring
    rw [this, Complex.exp_zero]
  have ha_sq : (Complex.exp (Complex.I * (ϕ x : ℂ))) ^ 2 = E := by
    dsimp [E]
    rw [← Complex.exp_nat_mul]
    congr 1
    push_cast
    ring
  have ha_pow4 : (Complex.exp (Complex.I * (ϕ x : ℂ))) ^ 4 = E ^ 2 := by
    calc
      (Complex.exp (Complex.I * (ϕ x : ℂ))) ^ 4 =
          ((Complex.exp (Complex.I * (ϕ x : ℂ))) ^ 2) ^ 2 := by ring
      _ = E ^ 2 := by rw [ha_sq]
  have hda_sq : (Complex.I * (↑(deriv ϕ x) : ℂ) * Complex.exp (Complex.I * (ϕ x : ℂ))) ^ 2 =
      -((↑(deriv ϕ x) : ℂ) ^ 2) * E := by
    calc
      (Complex.I * (↑(deriv ϕ x) : ℂ) * Complex.exp (Complex.I * (ϕ x : ℂ))) ^ 2
        = Complex.I ^ 2 * (↑(deriv ϕ x) : ℂ) ^ 2 * (Complex.exp (Complex.I * (ϕ x : ℂ))) ^ 2 := by ring
      _ = -((↑(deriv ϕ x) : ℂ) ^ 2) * E := by rw [Complex.I_sq, ha_sq]; ring
  rw [hda_sq, ha_pow4, ha_sq] at h_ode
  have h_solve : ((↑(deriv ϕ x) : ℂ) ^ 2) = -A₂ - A₄ * E - c₀ * E_inv := by
    calc
      ((↑(deriv ϕ x) : ℂ) ^ 2) = -((-((↑(deriv ϕ x) : ℂ) ^ 2) * E) * E_inv) := by
        linear_combination -((↑(deriv ϕ x) : ℂ) ^ 2) * hE_mul
      _ = -((A₄ * E ^ 2 + A₂ * E + c₀) * E_inv) := by rw [h_ode]
      _ = -A₂ * (E * E_inv) - A₄ * E * (E * E_inv) - c₀ * E_inv := by ring
      _ = -A₂ - A₄ * E - c₀ * E_inv := by rw [hE_mul]; ring
  have hE_euler : E = (Real.cos (2 * ϕ x) : ℂ) + (Real.sin (2 * ϕ x) : ℂ) * Complex.I := by
    dsimp [E]
    rw [Complex.exp_mul_I, ← Complex.ofReal_cos, ← Complex.ofReal_sin]
  have hE_inv_euler : E_inv = (Real.cos (2 * ϕ x) : ℂ) - (Real.sin (2 * ϕ x) : ℂ) * Complex.I := by
    dsimp [E_inv]
    rw [Complex.exp_mul_I, ← Complex.ofReal_cos, ← Complex.ofReal_sin, Real.cos_neg, Real.sin_neg]
    push_cast
    ring
  rw [hE_euler, hE_inv_euler] at h_solve
  have h_re := congrArg Complex.re h_solve
  simp only [sq, Complex.sub_re, Complex.neg_re, Complex.mul_re, Complex.add_re,
    Complex.sub_im, Complex.mul_im, Complex.add_im,
    Complex.ofReal_re, Complex.ofReal_im, Complex.I_re, Complex.I_im] at h_re ⊢
  linarith

theorem isotropic_center_trig_speed (Ω : Set Plane)
    (C : AnalyticGlancingCollar Ω)
    (M : MeromorphicCollarData C)
    (hIso : HasIsotropicCenter M) :
    HasTrigSpeed C.toSupportLazutkinData :=
by
  obtain ⟨B⟩ := collar_isotropic_germ_and_symmetries Ω C M
  obtain ⟨p₀, hp₀, n₀, u₀, hn₀, hu₀_ana, hu₀_ne, ha_p₀⟩ := hIso
  have hn₀_abs : 1 ≤ n₀.natAbs :=
    Nat.one_le_iff_ne_zero.mpr (Int.natAbs_ne_zero.mpr hn₀)
  obtain ⟨G₀, hG₀_cb⟩ := B.positive_germ_of_center p₀ hp₀ n₀ u₀ hn₀ hu₀_ana hu₀_ne ha_p₀
  obtain ⟨P₀⟩ := isotropic_center_rational_profile n₀.natAbs hn₀_abs G₀
  obtain ⟨_, ε₀, hε₀_pos, hε₀_le, hε₀_symm⟩ :=
    wronskian_simplicity_and_local_reflection n₀.natAbs hn₀_abs G₀ P₀
  obtain ⟨h_top, _⟩ := hG₀_cb ε₀ hε₀_pos hε₀_le hε₀_symm
  have hD_univ : horizStripENNR (M.h_X 0) = Set.univ := by
    ext s
    simp [horizStripENNR, h_top]
  have ha_mero_univ : MeromorphicOn M.a_mero Set.univ := hD_univ ▸ M.a_mero_mero
  have ha_mero_at : ∀ q : ℂ, MeromorphicAt M.a_mero q :=
    fun q => ha_mero_univ q (Set.mem_univ q)
  have hp₀_ord_mero : meromorphicOrderAt M.a_mero p₀ = (n₀ : WithTop ℤ) := by
    refine (meromorphicOrderAt_eq_int_iff (ha_mero_at p₀)).mpr ⟨u₀, hu₀_ana, hu₀_ne, ?_⟩
    simpa [smul_eq_mul] using ha_p₀
  have hp₀_im : p₀.im ≠ 0 := by
    intro hp₀_im0
    have hp₀_eq : ((p₀.re : ℝ) : ℂ) = p₀ :=
      Complex.ext rfl (by simpa using hp₀_im0.symm)
    have hp₀_not_disc : p₀ ∉ M.E_disc := hp₀_eq ▸ (B.real_base p₀.re).2.1
    have h_reg_p₀ := M.slice_reg p₀ hp₀ hp₀_not_disc
    have ha_ana_p₀ : AnalyticAt ℂ M.a_mero p₀ := h_reg_p₀.2.2.1
    have ha_ne_p₀ : M.a_mero p₀ ≠ 0 := h_reg_p₀.2.2.2.2.1
    have hp₀_ord_zero : meromorphicOrderAt M.a_mero p₀ = ((0 : ℤ) : WithTop ℤ) := by
      refine (meromorphicOrderAt_eq_int_iff (ha_mero_at p₀)).mpr
        ⟨M.a_mero, ha_ana_p₀, ha_ne_p₀, ?_⟩
      filter_upwards with z
      simp
    rw [hp₀_ord_mero] at hp₀_ord_zero
    exact hn₀ (WithTop.coe_inj.mp hp₀_ord_zero)
  let a_nf : ℂ → ℂ := toMeromorphicNFOn M.a_mero Set.univ
  have ha_nf : MeromorphicNFOn a_nf Set.univ :=
    meromorphicNFOn_toMeromorphicNFOn M.a_mero Set.univ
  have ha_nf_at : ∀ q : ℂ, MeromorphicNFAt a_nf q :=
    fun q => ha_nf (Set.mem_univ q)
  have ha_nf_eq_of_not_disc : ∀ s : ℂ, s ∉ M.E_disc → a_nf s = M.a_mero s := by
    intro s hs
    have hs_ana : AnalyticAt ℂ M.a_mero s :=
      (M.slice_reg s (hD_univ.symm ▸ Set.mem_univ s) hs).2.2.1
    have hs_nf : MeromorphicNFAt M.a_mero s :=
      meromorphicNFAt_iff_analyticAt_or.mpr (Or.inl hs_ana)
    calc
      a_nf s = toMeromorphicNFAt M.a_mero s s :=
        toMeromorphicNFOn_eq_toMeromorphicNFAt ha_mero_univ (Set.mem_univ s)
      _ = M.a_mero s := congrFun (toMeromorphicNFAt_eq_self.mpr hs_nf) s
  have ha_nhdsNE : ∀ q : ℂ, a_nf =ᶠ[nhdsWithin q {q}ᶜ] M.a_mero := by
    intro q
    obtain ⟨r, hr_pos, -, hr_disc⟩ := M.E_disc_isolated q (hD_univ.symm ▸ Set.mem_univ q)
    rw [eventuallyEq_nhdsWithin_iff]
    filter_upwards [Metric.ball_mem_nhds q hr_pos] with z hz hz_ne
    exact ha_nf_eq_of_not_disc z (hr_disc z hz hz_ne)
  have ha_nf_affine : ∀ (ε σ c x : ℂ), (ε = 1 ∨ ε = -1) → (σ = 1 ∨ σ = -1) →
      MeromorphicNFAt (fun z => ε * a_nf (σ * z + c)) x := by
    intro ε σ c x hε hσ
    have hε_ne : ε ≠ 0 := by rcases hε with rfl | rfl <;> norm_num
    have hσ_ne : σ ≠ 0 := by rcases hσ with rfl | rfl <;> norm_num
    have h_aff_ana : AnalyticAt ℂ (fun z : ℂ => σ * z + c) x := by
      have h1 : AnalyticAt ℂ (fun _ : ℂ => σ) x := analyticAt_const
      have h2 : AnalyticAt ℂ (fun z : ℂ => z) x := analyticAt_id
      have h3 : AnalyticAt ℂ (fun _ : ℂ => c) x := analyticAt_const
      exact (h1.mul h2).add h3
    have hy_nf : MeromorphicNFAt a_nf (σ * x + c) := ha_nf_at (σ * x + c)
    rcases meromorphicNFAt_iff_analyticAt_or.mp hy_nf with hy_ana | ⟨hy_mero, hy_ord_neg, hy_zero⟩
    · refine meromorphicNFAt_iff_analyticAt_or.mpr (Or.inl ?_)
      have h_eps : AnalyticAt ℂ (fun _ : ℂ => ε) x := analyticAt_const
      exact h_eps.mul (hy_ana.fun_comp_of_eq h_aff_ana rfl)
    · cases h_ord : meromorphicOrderAt a_nf (σ * x + c) with
      | top =>
        rw [h_ord] at hy_ord_neg
        exact absurd hy_ord_neg (not_lt_of_ge le_top)
      | coe m =>
        rw [h_ord] at hy_ord_neg
        obtain ⟨v, hv_ana, hv_ne, hv_eq⟩ := (meromorphicOrderAt_eq_int_iff hy_mero).mp h_ord
        let v' : ℂ → ℂ := fun z => ε * σ ^ m * v (σ * z + c)
        have hv'_ana : AnalyticAt ℂ v' x := by
          have h_c : AnalyticAt ℂ (fun _ : ℂ => ε * σ ^ m) x := analyticAt_const
          exact h_c.mul (hv_ana.fun_comp_of_eq h_aff_ana rfl)
        have hv'_ne : v' x ≠ 0 := by
          dsimp [v']
          exact mul_ne_zero (mul_ne_zero hε_ne (zpow_ne_zero m hσ_ne)) hv_ne
        have hg_eq : ∀ᶠ z in nhdsWithin x {x}ᶜ,
            ε * a_nf (σ * z + c) = (z - x) ^ m • v' z := by
          rw [eventually_nhdsWithin_iff] at hv_eq ⊢
          have h_cont : ContinuousAt (fun z : ℂ => σ * z + c) x := h_aff_ana.continuousAt
          filter_upwards [h_cont.eventually hv_eq] with z hz hz_ne
          have h_diff : σ * z + c - (σ * x + c) = σ * (z - x) := by ring
          have hw_ne : σ * z + c ≠ σ * x + c := by
            intro h_eq
            apply sub_ne_zero.mpr hz_ne
            exact mul_right_injective₀ hσ_ne (by simpa [h_diff] using sub_eq_zero.mpr h_eq)
          have h_val := hz hw_ne
          simp only [smul_eq_mul, v'] at h_val ⊢
          rw [h_val, h_diff, mul_zpow]
          ring
        have hg_mero : MeromorphicAt (fun z => ε * a_nf (σ * z + c)) x :=
          MeromorphicAt.iff_eventuallyEq_zpow_smul_analyticAt.mpr ⟨m, v', hv'_ana, hg_eq⟩
        have hg_ord : meromorphicOrderAt (fun z => ε * a_nf (σ * z + c)) x = (m : WithTop ℤ) :=
          (meromorphicOrderAt_eq_int_iff hg_mero).mpr ⟨v', hv'_ana, hv'_ne, hg_eq⟩
        refine meromorphicNFAt_iff_analyticAt_or.mpr (Or.inr ⟨hg_mero, ?_, ?_⟩)
        · rw [hg_ord]
          exact hy_ord_neg
        · simp [hy_zero]
  have ha_real : ∀ x : ℝ, a_nf x = Complex.exp (Complex.I * C.ϕ x) := by
    intro x
    rw [ha_nf_eq_of_not_disc x (B.real_base x).2.1]
    exact (B.real_base x).2.2
  have ha_per : ∀ s : ℂ, a_nf (s + 2 * Real.pi) = a_nf s := by
    intro s
    have hg_nf : MeromorphicNFAt (fun z => (1 : ℂ) * a_nf ((1 : ℂ) * z + 2 * Real.pi)) s :=
      ha_nf_affine 1 1 (2 * Real.pi) s (Or.inl rfl) (Or.inl rfl)
    have hg_nf' : MeromorphicNFAt (fun z => a_nf (z + 2 * Real.pi)) s := by
      simpa using hg_nf
    obtain ⟨r₁, hr₁_pos, -, hr₁_disc⟩ := M.E_disc_isolated s (hD_univ.symm ▸ Set.mem_univ s)
    obtain ⟨r₂, hr₂_pos, -, hr₂_disc⟩ :=
      M.E_disc_isolated (s + 2 * Real.pi) (hD_univ.symm ▸ Set.mem_univ _)
    have h_eq_punc : (fun z => a_nf (z + 2 * Real.pi)) =ᶠ[nhdsWithin s {s}ᶜ] a_nf := by
      rw [eventuallyEq_nhdsWithin_iff]
      filter_upwards [Metric.ball_mem_nhds s (lt_min hr₁_pos hr₂_pos)] with z hz hz_ne
      have hz₁ : z ∉ M.E_disc :=
        hr₁_disc z (Metric.mem_ball.mpr (lt_of_lt_of_le (Metric.mem_ball.mp hz) (min_le_left _ _)))
          hz_ne
      have hz₂_ball : z + 2 * Real.pi ∈ Metric.ball (s + 2 * Real.pi) r₂ := by
        rw [Metric.mem_ball, dist_add_right]
        exact lt_of_lt_of_le (Metric.mem_ball.mp hz) (min_le_right _ _)
      have hz₂_ne : z + 2 * Real.pi ≠ s + 2 * Real.pi :=
        fun h => hz_ne (add_right_cancel h)
      have hz₂ : z + 2 * Real.pi ∉ M.E_disc := hr₂_disc (z + 2 * Real.pi) hz₂_ball hz₂_ne
      rw [ha_nf_eq_of_not_disc (z + 2 * Real.pi) hz₂, ha_nf_eq_of_not_disc z hz₁]
      exact B.a_periodic_reg z (hD_univ.symm ▸ Set.mem_univ z) hz₁
        (hD_univ.symm ▸ Set.mem_univ _) hz₂
    exact ((hg_nf'.eventuallyEq_nhdsNE_iff_eventuallyEq_nhds (ha_nf_at s)).mp h_eq_punc).eq_of_nhds
  have ha_conj : ∀ q : ℂ,
      ∀ᶠ z in nhdsWithin q {q}ᶜ, a_nf (starRingEnd ℂ z) * starRingEnd ℂ (a_nf z) = 1 := by
    intro q
    obtain ⟨r₁, hr₁_pos, -, hr₁_disc⟩ := M.E_disc_isolated q (hD_univ.symm ▸ Set.mem_univ q)
    obtain ⟨r₂, hr₂_pos, -, hr₂_disc⟩ :=
      M.E_disc_isolated (starRingEnd ℂ q) (hD_univ.symm ▸ Set.mem_univ _)
    rw [eventually_nhdsWithin_iff]
    filter_upwards [Metric.ball_mem_nhds q (lt_min hr₁_pos hr₂_pos)] with z hz hz_ne
    have hz₁ : z ∉ M.E_disc :=
      hr₁_disc z (Metric.mem_ball.mpr (lt_of_lt_of_le (Metric.mem_ball.mp hz) (min_le_left _ _)))
        hz_ne
    have hz₂_ball : starRingEnd ℂ z ∈ Metric.ball (starRingEnd ℂ q) r₂ := by
      rw [Metric.mem_ball]
      simpa [Complex.dist_eq, ← map_sub] using
        lt_of_lt_of_le (Metric.mem_ball.mp hz) (min_le_right _ _)
    have hz₂_ne : starRingEnd ℂ z ≠ starRingEnd ℂ q :=
      fun h => hz_ne ((RingHom.injective (starRingEnd ℂ)) h)
    have hz₂ : starRingEnd ℂ z ∉ M.E_disc := hr₂_disc (starRingEnd ℂ z) hz₂_ball hz₂_ne
    rw [ha_nf_eq_of_not_disc (starRingEnd ℂ z) hz₂, ha_nf_eq_of_not_disc z hz₁]
    exact B.a_conj_reg z (hD_univ.symm ▸ Set.mem_univ z) hz₁
      (hD_univ.symm ▸ Set.mem_univ _) hz₂
  have hp₀_ord : meromorphicOrderAt a_nf p₀ ≠ 0 := by
    rw [meromorphicOrderAt_congr (ha_nhdsNE p₀), hp₀_ord_mero]
    exact fun h => hn₀ (WithTop.coe_inj.mp h)
  have ha_centers : ∀ q : ℂ, meromorphicOrderAt a_nf q ≠ 0 →
      (meromorphicOrderAt a_nf q = 1 ∨ meromorphicOrderAt a_nf q = -1) ∧
      ∀ s : ℂ, a_nf (2 * q - s) = -a_nf s := by
    intro q hq_ord
    have hq_ord_eq : meromorphicOrderAt a_nf q = meromorphicOrderAt M.a_mero q :=
      meromorphicOrderAt_congr (ha_nhdsNE q)
    have hq_ne_top : meromorphicOrderAt M.a_mero q ≠ ⊤ :=
      B.order_ne_top q (hD_univ.symm ▸ Set.mem_univ q)
    cases h_ord_q : meromorphicOrderAt M.a_mero q with
    | top => exact absurd h_ord_q hq_ne_top
    | coe n_q =>
      have hn_q_ne : n_q ≠ 0 := by
        intro hn_q0
        apply hq_ord
        rw [hq_ord_eq, h_ord_q, hn_q0]
        rfl
      obtain ⟨u_q, hu_q_ana, hu_q_ne, ha_q_smul⟩ :=
        (meromorphicOrderAt_eq_int_iff (ha_mero_at q)).mp h_ord_q
      have ha_q : ∀ᶠ z in nhdsWithin q {q}ᶜ, M.a_mero z = (z - q) ^ n_q * u_q z := by
        simpa [smul_eq_mul] using ha_q_smul
      have hn_q_abs : 1 ≤ n_q.natAbs :=
        Nat.one_le_iff_ne_zero.mpr (Int.natAbs_ne_zero.mpr hn_q_ne)
      obtain ⟨G_q, hG_q_cb⟩ :=
        B.positive_germ_of_center q (hD_univ.symm ▸ Set.mem_univ q)
          n_q u_q hn_q_ne hu_q_ana hu_q_ne ha_q
      obtain ⟨P_q⟩ := isotropic_center_rational_profile n_q.natAbs hn_q_abs G_q
      obtain ⟨hn_q_one, ε_q, hε_q_pos, hε_q_le, hε_q_symm⟩ :=
        wronskian_simplicity_and_local_reflection n_q.natAbs hn_q_abs G_q P_q
      obtain ⟨_, ha_mero_refl⟩ := hG_q_cb ε_q hε_q_pos hε_q_le hε_q_symm
      refine ⟨?_, ?_⟩
      · rw [hq_ord_eq, h_ord_q]
        rcases Int.natAbs_eq n_q with h_pos | h_neg
        · left
          have : n_q = 1 := by omega
          simp [this]
        · right
          have : n_q = -1 := by omega
          simp [this]
      · intro s
        have hg_nf : MeromorphicNFAt (fun z => (-1 : ℂ) * a_nf ((-1 : ℂ) * z + 2 * q)) s :=
          ha_nf_affine (-1) (-1) (2 * q) s (Or.inr rfl) (Or.inr rfl)
        have hg_nf' : MeromorphicNFAt (fun z => -a_nf (2 * q - z)) s := by
          have h_fun : (fun z : ℂ => (-1 : ℂ) * a_nf ((-1 : ℂ) * z + 2 * q)) =
              (fun z : ℂ => -a_nf (2 * q - z)) := by
            ext z
            ring_nf
          rwa [h_fun] at hg_nf
        obtain ⟨r₁, hr₁_pos, -, hr₁_disc⟩ := M.E_disc_isolated s (hD_univ.symm ▸ Set.mem_univ s)
        obtain ⟨r₂, hr₂_pos, -, hr₂_disc⟩ :=
          M.E_disc_isolated (2 * q - s) (hD_univ.symm ▸ Set.mem_univ _)
        have h_eq_punc : (fun z => -a_nf (2 * q - z)) =ᶠ[nhdsWithin s {s}ᶜ] a_nf := by
          rw [eventuallyEq_nhdsWithin_iff]
          filter_upwards [Metric.ball_mem_nhds s (lt_min hr₁_pos hr₂_pos)] with z hz hz_ne
          have hz₁ : z ∉ M.E_disc :=
            hr₁_disc z
              (Metric.mem_ball.mpr (lt_of_lt_of_le (Metric.mem_ball.mp hz) (min_le_left _ _)))
              hz_ne
          have hz₂_ball : 2 * q - z ∈ Metric.ball (2 * q - s) r₂ := by
            rw [Metric.mem_ball, dist_eq_norm]
            have h_sub : (2 * q - z) - (2 * q - s) = -(z - s) := by ring
            rw [h_sub, norm_neg, ← dist_eq_norm]
            exact lt_of_lt_of_le (Metric.mem_ball.mp hz) (min_le_right _ _)
          have hz₂_ne : 2 * q - z ≠ 2 * q - s := by
            intro h
            apply hz_ne
            simp only [Set.mem_singleton_iff]
            linear_combination -h
          have hz₂ : 2 * q - z ∉ M.E_disc := hr₂_disc (2 * q - z) hz₂_ball hz₂_ne
          rw [ha_nf_eq_of_not_disc (2 * q - z) hz₂, ha_nf_eq_of_not_disc z hz₁,
            ha_mero_refl z hz₁ hz₂, neg_neg]
        have h_pt : -a_nf (2 * q - s) = a_nf s :=
          ((hg_nf'.eventuallyEq_nhdsNE_iff_eventuallyEq_nhds (ha_nf_at s)).mp h_eq_punc).eq_of_nhds
        linear_combination -h_pt
  have hϕ_diff : Differentiable ℝ C.ϕ := C.ϕ_smooth.differentiable (by decide)
  have hϕ_deriv : deriv C.ϕ 0 ≠ 0 := ne_of_gt (C.ϕ_deriv_pos 0)
  exact elliptic_normal_pole_cancellation a_nf C.ϕ p₀ ha_nf hϕ_diff hϕ_deriv
    ha_real ha_per ha_conj hp₀_im hp₀_ord ha_centers

theorem nonisotropic_curve_and_collar_germ (Ω : Set Plane)
    (C : AnalyticGlancingCollar Ω)
    (M : MeromorphicCollarData C)
    (hNonIso : ¬ HasIsotropicCenter M)
    (hNonConst : ∃ x : ℝ, deriv (deriv C.ϕ) x ≠ 0) :
    Nonempty (NonisotropicCurveData C M) :=
by
  have h_real_simple : ∀ x₁ x₂ : ℝ,
      glancingBoundaryCurve C x₁ = glancingBoundaryCurve C x₂ →
      ∃ k : ℤ, x₁ - x₂ = k * (2 * Real.pi) := by
    have hh1 : ContDiff ℝ ((1 : WithTop ℕ∞) + 1) C.h := C.h_smooth.of_le (by decide)
    have hh_diff : Differentiable ℝ C.h := C.h_smooth.differentiable (by decide)
    have hdh_diff : Differentiable ℝ (deriv C.h) := hh1.deriv'.differentiable_one
    have hdh_ℂ_real : ∀ θ : ℝ, deriv C.h_ℂ (θ : ℂ) = ((deriv C.h θ : ℝ) : ℂ) := by
      intro θ
      have hmem : (θ : ℂ) ∈ horizStrip (2 * C.s_h) := by
        simp [horizStrip, C.s_h_pos]
      have hopen : IsOpen (horizStrip (2 * C.s_h)) :=
        isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const
      have hd1 := ((C.h_ℂ_holo.differentiableAt (hopen.mem_nhds hmem)).hasDerivAt).scomp θ
        (Complex.ofRealCLM.hasDerivAt (x := θ))
      have hd2 := Complex.ofRealCLM.hasFDerivAt.comp_hasDerivAt θ (hh_diff θ).hasDerivAt
      have heq : C.h_ℂ ∘ Complex.ofReal = (⇑Complex.ofRealCLM) ∘ C.h :=
        funext C.h_ℂ_real
      rw [heq] at hd1
      simpa using hd1.unique hd2
    let γ₀ : ℝ → ℝ × ℝ := fun θ =>
      (C.h θ * Real.cos θ - deriv C.h θ * Real.sin θ,
       C.h θ * Real.sin θ + deriv C.h θ * Real.cos θ)
    have hdh_per : Function.Periodic (deriv C.h) (2 * Real.pi) := by
      intro θ
      have hd1 : HasDerivAt (fun u => C.h (u + 2 * Real.pi)) (deriv C.h (θ + 2 * Real.pi)) θ :=
        (hh_diff (θ + 2 * Real.pi)).hasDerivAt.comp_add_const θ (2 * Real.pi)
      have heq : (fun u => C.h (u + 2 * Real.pi)) = C.h := funext C.h_periodic
      rw [heq] at hd1
      exact hd1.unique (hh_diff θ).hasDerivAt
    have hγ₀_per : Function.Periodic γ₀ (2 * Real.pi) := by
      intro θ
      simp only [γ₀, C.h_periodic θ, hdh_per θ, Real.cos_add_two_pi, Real.sin_add_two_pi]
    have hγ₀_arc : ∀ θ_a θ_b : ℝ, θ_a < θ_b → θ_b ≤ θ_a + Real.pi → γ₀ θ_a ≠ γ₀ θ_b := by
      intro θ_a θ_b hab hpi heq
      let θ_mid : ℝ := (θ_a + θ_b) / 2
      let P : ℝ → ℝ := fun θ => -(γ₀ θ).1 * Real.sin θ_mid + (γ₀ θ).2 * Real.cos θ_mid
      have hP_eq : ∀ θ : ℝ, P θ =
          C.h θ * Real.sin (θ - θ_mid) + deriv C.h θ * Real.cos (θ - θ_mid) := by
        intro θ
        simp only [P, γ₀, Real.sin_sub, Real.cos_sub]
        ring
      have hP_deriv : ∀ θ : ℝ, HasDerivAt P
          ((C.h θ + deriv (deriv C.h) θ) * Real.cos (θ - θ_mid)) θ := by
        intro θ
        have hs : HasDerivAt (fun u => Real.sin (u - θ_mid)) (Real.cos (θ - θ_mid)) θ := by
          simpa [Function.comp_def] using
            (Real.hasDerivAt_sin (θ - θ_mid)).comp θ ((hasDerivAt_id θ).sub_const θ_mid)
        have hc : HasDerivAt (fun u => Real.cos (u - θ_mid)) (-Real.sin (θ - θ_mid)) θ := by
          simpa [Function.comp_def] using
            (Real.hasDerivAt_cos (θ - θ_mid)).comp θ ((hasDerivAt_id θ).sub_const θ_mid)
        have h1 := (hh_diff θ).hasDerivAt.mul hs
        have h2 := (hdh_diff θ).hasDerivAt.mul hc
        have hsum : HasDerivAt
            (fun u => C.h u * Real.sin (u - θ_mid) + deriv C.h u * Real.cos (u - θ_mid))
            ((deriv C.h θ * Real.sin (θ - θ_mid) + C.h θ * Real.cos (θ - θ_mid)) +
              (deriv (deriv C.h) θ * Real.cos (θ - θ_mid) + deriv C.h θ * (-Real.sin (θ - θ_mid))))
            θ := h1.add h2
        rw [← funext hP_eq] at hsum
        convert hsum using 1
        ring
      have hP_diff : Differentiable ℝ P := fun θ => (hP_deriv θ).differentiableAt
      have hP_mono : StrictMonoOn P (Set.Icc θ_a θ_b) := by
        refine strictMonoOn_of_deriv_pos (convex_Icc θ_a θ_b) hP_diff.continuous.continuousOn ?_
        intro θ hθ
        rw [interior_Icc] at hθ
        rw [(hP_deriv θ).deriv]
        refine mul_pos (C.r_pos θ) (Real.cos_pos_of_mem_Ioo ⟨?_, ?_⟩)
        · dsimp [θ_mid]; linarith [hθ.1, hθ.2]
        · dsimp [θ_mid]; linarith [hθ.1, hθ.2]
      have hlt : P θ_a < P θ_b :=
        hP_mono (Set.left_mem_Icc.mpr hab.le) (Set.right_mem_Icc.mpr hab.le) hab
