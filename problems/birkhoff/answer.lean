      refine ⟨hOnePair, ?_⟩
      intro σ_sgn Δ B₁ H₁ B₂ H₂ hP₁ hP₂ ⟨hΔ, hBd, hHd⟩
      obtain ⟨_, hH₁_q, _, _, _, _⟩ := hOnePair σ_sgn B₁ H₁ hP₁
      obtain ⟨_, hH₂_q, _, _, _, _⟩ := hOnePair σ_sgn B₂ H₂ hP₂
      have hH_sum_q : HasCJetBound_fcks p (2 * (Real.pi + 1) / (q : ℝ)) (fun x => H₁ x + H₂ x) :=
        hJet.jet_mono le_rfl (by ring_nf; rfl) (hJet.jet_add hH₁_q hH₂_q)
      have hH_sq_diff_raw := hJet.jet_mul hHd hH_sum_q
