        exact le_trans (hcard_eq ▸ Finset.card_le_card himg_sub) hpair_le
    let Bad : Finset (Fin N) := Finset.univ.filter (fun m : Fin N => ∃ t ∈ F₀, t ∈ I_m m)
    let Good : Finset (Fin N) := Finset.univ \ Bad
    have hBad_sub : Bad ⊆ F₀.biUnion H_hit := by
      intro m hm
      obtain ⟨_, t, htF, htI⟩ := Finset.mem_filter.mp hm
      exact Finset.mem_biUnion.mpr ⟨t, htF, Finset.mem_filter.mpr ⟨Finset.mem_univ m, htI⟩⟩
    have hBad_card : Bad.card ≤ 2 * m₀ := by
