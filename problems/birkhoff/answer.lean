        ∀ z ∈ Metric.closedBall q R₀, ‖H z‖ ≤ Real.exp M := by
      intro H hH_holo hH_sph z hz
      have h_dc : DiffContOnCl ℂ H (Metric.ball q R₀) :=
        hH_holo.diffContOnCl_ball h_cb_R₀_U₀
      have h_fr : ∀ w ∈ frontier (Metric.ball q R₀), ‖H w‖ ≤ Real.exp M := by
        rw [frontier_ball q hR₀_pos.ne']
        exact hH_sph
      have h_cl : z ∈ closure (Metric.ball q R₀) := by
        rwa [closure_ball q hR₀_pos.ne']
      exact Complex.norm_le_of_forall_mem_frontier_norm_le Metric.isBounded_ball h_dc h_fr h_cl
    have h_fuel : ∀ (fuel : ℕ) (H : ℂ → ℂ),
