        rw [← Finset.sum_neg_distrib]
        refine Finset.sum_congr rfl ?_
        intro i hi
        rw [Finset.mem_range] at hi
        have hsub_idx : j - i + 1 = j + 1 - i := by omega
        rw [hΦ_eq_coe L, Polynomial.coeff_coe]
