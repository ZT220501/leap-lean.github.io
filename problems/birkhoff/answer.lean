            have h_sum_L : (∑ s : Fin (k - 1), if r.1 = s.1 + 1 then L_val * x_vec s else 0) =
                L_val * MvPowerSeries.coeff d (η ⟨r.1, by have := r.2; omega⟩) := by
              by_cases hr_bot : 0 < r.1
              · let s_prev : Fin (k - 1) := ⟨r.1 - 1, by have := r.2; omega⟩
                have h_iff : ∀ s : Fin (k - 1), (r.1 = s.1 + 1) ↔ s = s_prev := by
                  intro s
                  constructor
                  · intro h; apply Fin.ext; dsimp [s_prev]; omega
                  · intro h; subst h; dsimp [s_prev]; omega
                simp only [h_iff, Finset.sum_ite_eq', Finset.mem_univ, ↓reduceIte]
                have h_idx : (⟨s_prev.1 + 1, by have := s_prev.2; omega⟩ : Fin (k + 1)) =
                    ⟨r.1, by have := r.2; omega⟩ := by
                  apply Fin.ext; dsimp [s_prev]; omega
                simp only [x_vec, h_idx]
              · have hr0 : r.1 = 0 := by omega
                have h_zero_idx : (⟨r.1, by have := r.2; omega⟩ : Fin (k + 1)) = 0 :=
                  Fin.ext hr0
                have h_none : ∀ s : Fin (k - 1), ¬ (r.1 = s.1 + 1) := by
                  intro s; omega
                have hη_z : η 0 = 0 := hη_zero
