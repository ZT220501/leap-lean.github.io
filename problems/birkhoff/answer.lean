              (continuous_const.mul (Complex.continuous_ofReal.mul continuous_const))).continuousOn
          have hγ_maps : Set.MapsTo (fun θ : ℝ => X₀ + (s : ℂ) * ((θ : ℂ) * Y₀))
              (Set.Icc (0 : ℝ) 1) (horizStrip σ) := fun θ hθ => hPtMem θ hθ s hs
          have hc1 := hW1.1.continuousOn.comp hγ_cont hγ_maps
          have hc2 := hW0.1.continuousOn.comp hγ_cont hγ_maps
          exact hc1.mul (Complex.continuous_exp.comp_continuousOn (hc2.sub continuousOn_const))
        have hBnd_gz : ∀ θ ∈ Set.Icc (0 : ℝ) 1, ∀ s ∈ Set.Icc (0 : ℝ) 1,
            ‖g_z θ s‖ ≤ M₁ * Real.exp (2 * M₁) := by
          intro θ hθ s hs
          have hmem := hPtMem θ hθ s hs
          have hb1 : ‖deriv W (X₀ + (s : ℂ) * ((θ : ℂ) * Y₀))‖ ≤ M₁ := by
            simpa [iteratedDeriv_zero] using hW1.2.2.2 0 (by omega) _ hmem
          have hb2 : ‖W (X₀ + (s : ℂ) * ((θ : ℂ) * Y₀))‖ ≤ M₁ := by
            simpa [iteratedDeriv_zero] using hW0.2.2.2 0 (by omega) _ hmem
