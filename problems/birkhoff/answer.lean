  let K'_M : ℕ → Set ℝ := fun M => Set.Icc (a_M M) (b_M M)
  let U_M : ℕ → ℝ := fun M => 2 * ((M : ℝ) + 1) * Real.log 2 + 1
  let B_M : ℕ → ℝ := fun M => (2 : ℝ) ^ (M + 2) * U_M M
  let L_M : ℕ → ℝ := fun M => 2 * B_M M / a_M M
  have ha_pos : ∀ M : ℕ, 0 < a_M M := fun M => by positivity
  have ha_le_half : ∀ M : ℕ, a_M M ≤ 1 / 2 := by
    intro M
    dsimp [a_M]
    rw [pow_succ]
    have : (1 / 2 : ℝ) ^ M ≤ 1 := pow_le_one₀ (by norm_num) (by norm_num)
    linarith
  have hb_ge_two : ∀ M : ℕ, 2 ≤ b_M M := by
    intro M
    dsimp [b_M]
    rw [pow_succ]
    have : (1 : ℝ) ≤ (2 : ℝ) ^ M := one_le_pow₀ (by norm_num)
    linarith
  have hU_pos : ∀ M : ℕ, 0 < U_M M := by
    intro M
    have : 0 < Real.log 2 := Real.log_pos one_lt_two
    dsimp [U_M]
    positivity
  have hB_pos : ∀ M : ℕ, 0 < B_M M := fun M => mul_pos (by positivity) (hU_pos M)
  have hU_le_B : ∀ M : ℕ, U_M M ≤ B_M M := by
    intro M
    dsimp [B_M]
    have h1 : (1 : ℝ) ≤ (2 : ℝ) ^ (M + 2) := one_le_pow₀ (by norm_num)
    nlinarith [hU_pos M]
  have hL_pos : ∀ M : ℕ, 0 < L_M M := fun M => div_pos (mul_pos zero_lt_two (hB_pos M)) (ha_pos M)
  have h_exists_N : ∀ M : ℕ, ∃ N : ℕ, ∀ n ≥ N, b_M M ≤ R_seq n ∧ ε_seq n ≤ 1 := by
    intro M
    have h1 : ∀ᶠ n in Filter.atTop, b_M M ≤ R_seq n := hR_top.eventually_ge_atTop (b_M M)
    have h2 : ∀ᶠ n in Filter.atTop, ε_seq n ≤ 1 :=
      (hε_zero.eventually (gt_mem_nhds zero_lt_one)).mono fun _ hn => le_of_lt hn
    exact Filter.eventually_atTop.mp (h1.and h2)
  let N_M : ℕ → ℕ := fun M => Classical.choose (h_exists_N M)
  have hN_M : ∀ M n : ℕ, N_M M ≤ n → b_M M ≤ R_seq n ∧ ε_seq n ≤ 1 :=
    fun M => Classical.choose_spec (h_exists_N M)
  have h_bound_K' : ∀ (M n : ℕ), N_M M ≤ n → ∀ D ∈ K'_M M, |ψ n D| ≤ B_M M := by
    intro M n hn D hD
    obtain ⟨hR_b, hε_le⟩ := hN_M M n hn
    have hK'_sub : K'_M M ⊆ Set.Ioc 0 (R_seq n) := by
      intro x hx
      exact ⟨lt_of_lt_of_le (ha_pos M) hx.1, le_trans hx.2 hR_b⟩
    have h_upper_K' : ∀ x ∈ K'_M M, ψ n x ≤ U_M M := by
      intro x hx
      have hx_Ioc : x ∈ Set.Ioc 0 (R_seq n) := hK'_sub hx
      have hx_pos : 0 < x := hx_Ioc.1
      have ha_eq : a_M M = ((2 : ℝ) ^ (M + 1))⁻¹ := by
        dsimp [a_M]
        rw [one_div, inv_pow]
      have hlog_lo : -(((M : ℝ) + 1) * Real.log 2) ≤ Real.log x := by
        have := Real.log_le_log (ha_pos M) hx.1
        rw [ha_eq, Real.log_inv, Real.log_pow] at this
        push_cast at this
        linarith
      have hlog_hi : Real.log x ≤ ((M : ℝ) + 1) * Real.log 2 := by
        have := Real.log_le_log hx_pos hx.2
        dsimp [b_M] at this
        rw [Real.log_pow] at this
        push_cast at this
        linarith
      have habs_log : |Real.log x| ≤ ((M : ℝ) + 1) * Real.log 2 :=
        abs_le.mpr ⟨by linarith, hlog_hi⟩
      have h_up := hm_upper n x hx_Ioc
      have h_neg_le : -Real.log x ≤ |Real.log x| := neg_le_abs _
      have h_eps_mul : ε_seq n * |Real.log x| ≤ 1 * |Real.log x| :=
        mul_le_mul_of_nonneg_right hε_le (abs_nonneg _)
      dsimp [ψ, U_M]
      linarith
    have hψ_hi : ψ n D ≤ B_M M := le_trans (h_upper_K' D hD) (hU_le_B M)
    have hψ_lo : -B_M M ≤ ψ n D := by
      rcases lt_trichotomy D 1 with hD_lt | rfl | hD_gt
      · have hb_gt_one : 1 < b_M M := lt_of_lt_of_le one_lt_two (hb_ge_two M)
        have hden : 0 < b_M M - D := by linarith
        let w₁ : ℝ := (b_M M - 1) / (b_M M - D)
        let w₂ : ℝ := (1 - D) / (b_M M - D)
        have hw₁ : 0 ≤ w₁ := div_nonneg (by linarith) (le_of_lt hden)
        have hw₂ : 0 ≤ w₂ := div_nonneg (by linarith) (le_of_lt hden)
        have hw_sum : w₁ + w₂ = 1 := by dsimp [w₁, w₂]; field_simp [hden.ne']; ring
        have hw_pt : w₁ * D + w₂ * b_M M = 1 := by dsimp [w₁, w₂]; field_simp [hden.ne']; ring
        have hb_mem : b_M M ∈ K'_M M := ⟨le_trans (ha_le_half M) (by linarith), le_rfl⟩
        have h_cvx := (hm_conv n).2 (hK'_sub hD) (hK'_sub hb_mem) hw₁ hw₂ hw_sum
        simp only [smul_eq_mul] at h_cvx
        rw [hw_pt, hm_one n, Real.log_one] at h_cvx
        have h_b_up : ψ n (b_M M) ≤ U_M M := h_upper_K' (b_M M) hb_mem
        have h_lin : 0 ≤ w₁ * ψ n D + w₂ * U_M M := by
          have : w₂ * ψ n (b_M M) ≤ w₂ * U_M M := mul_le_mul_of_nonneg_left h_b_up hw₂
          dsimp [ψ] at *
          linarith
        have h_mul_den : 0 ≤ (b_M M - 1) * ψ n D + (1 - D) * U_M M := by
          have := mul_le_mul_of_nonneg_left h_lin (le_of_lt hden)
          have heq : (b_M M - D) * (w₁ * ψ n D + w₂ * U_M M) =
