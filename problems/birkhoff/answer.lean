      have hst0 := hStencil_zero z hz_s
      refine ⟨hst0, ?_, ?_, ?_⟩
      · rw [hst0]
        exact hE₀_bnd z hz_s
      · have hball_sub : Metric.ball z δ ⊆ horizStrip s := by
          intro w hw
          rw [Metric.mem_ball, dist_eq_norm] at hw
          change |w.im| < s
          have him : w.im = z.im + (w - z).im := by simp
          rw [him]
          have h1 := abs_add_le z.im (w - z).im
          have h2 := Complex.abs_im_le_norm (w - z)
          have hz_im : |z.im| < s - δ := hz
