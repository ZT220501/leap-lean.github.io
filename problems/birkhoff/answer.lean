            ≤ (2 * Real.pi)⁻¹ * ((2 * Real.pi)⁻¹ *
              ∫ y in (0 : ℝ)..(2 * Real.pi), (2 * Real.pi * (Real.pi ^ 2 / 2)) * w y) := by gcongr
          _ = (Real.pi ^ 2 / 2) * ((2 * Real.pi)⁻¹ * ∫ y in (0 : ℝ)..(2 * Real.pi), w y) := by
              rw [intervalIntegral.integral_const_mul]
              have h2pi_ne : 2 * Real.pi ≠ 0 := ne_of_gt h2pi_pos
