    have hfU_mvt := Convex.norm_image_sub_le_of_norm_deriv_le
      (fun z hz => hfU_holo.differentiableAt
        (isOpen_ball.mem_nhds (Metric.ball_subset_ball (by linarith) hz)))
      hfU_deriv_bd (convex_ball t₀ (R / 3)) ht₀_in_R3 ht_in_R3
    rw [hfU_t₀, sub_zero] at hfU_mvt
    have hU_err : ‖chartU y₀ t - y₀‖ ≤ C_init * ‖bStep t‖ := by
