              iteratedDeriv 2 W (X₀ + (s : ℂ) * ((t : ℂ) * Y₀)) -
            8 * (iteratedDeriv 1 W (X₀ + (s : ℂ) * ((t : ℂ) * Y₀))) ^ 3‖ ≤
          2 * M₁ + 12 * M₁ ^ 2 + 8 * M₁ ^ 3 := by
        calc
          _ ≤ ‖-2 * iteratedDeriv 3 W (X₀ + (s : ℂ) * ((t : ℂ) * Y₀)) +
                12 * iteratedDeriv 1 W (X₀ + (s : ℂ) * ((t : ℂ) * Y₀)) *
                  iteratedDeriv 2 W (X₀ + (s : ℂ) * ((t : ℂ) * Y₀))‖ +
              ‖8 * (iteratedDeriv 1 W (X₀ + (s : ℂ) * ((t : ℂ) * Y₀))) ^ 3‖ := norm_sub_le _ _
          _ ≤ ‖-2 * iteratedDeriv 3 W (X₀ + (s : ℂ) * ((t : ℂ) * Y₀))‖ +
              ‖12 * iteratedDeriv 1 W (X₀ + (s : ℂ) * ((t : ℂ) * Y₀)) *
                  iteratedDeriv 2 W (X₀ + (s : ℂ) * ((t : ℂ) * Y₀))‖ +
              ‖8 * (iteratedDeriv 1 W (X₀ + (s : ℂ) * ((t : ℂ) * Y₀))) ^ 3‖ := by
            linarith [norm_add_le
              (-2 * iteratedDeriv 3 W (X₀ + (s : ℂ) * ((t : ℂ) * Y₀)))
              (12 * iteratedDeriv 1 W (X₀ + (s : ℂ) * ((t : ℂ) * Y₀)) *
                iteratedDeriv 2 W (X₀ + (s : ℂ) * ((t : ℂ) * Y₀)))]
          _ ≤ 2 * M₁ + 12 * M₁ ^ 2 + 8 * M₁ ^ 3 := by
            repeat rw [norm_mul]
            rw [norm_pow]
            have hn2 : ‖(-2 : ℂ)‖ = 2 := by norm_num
            have hn12 : ‖(12 : ℂ)‖ = 12 := by norm_num
            have hn8 : ‖(8 : ℂ)‖ = 8 := by norm_num
            rw [hn2, hn12, hn8]
            have hp3 : ‖iteratedDeriv 1 W (X₀ + (s : ℂ) * ((t : ℂ) * Y₀))‖ ^ 3 ≤ M₁ ^ 3 :=
              pow_le_pow_left₀ (norm_nonneg _) hb1 3
            nlinarith [norm_nonneg (iteratedDeriv 1 W (X₀ + (s : ℂ) * ((t : ℂ) * Y₀))),
              norm_nonneg (iteratedDeriv 2 W (X₀ + (s : ℂ) * ((t : ℂ) * Y₀)))]
      dsimp only [gH, M_kerH]
      rw [norm_mul, norm_mul]
      have hProd : ‖-2 * iteratedDeriv 3 W (X₀ + (s : ℂ) * ((t : ℂ) * Y₀)) +
            12 * iteratedDeriv 1 W (X₀ + (s : ℂ) * ((t : ℂ) * Y₀)) *
              iteratedDeriv 2 W (X₀ + (s : ℂ) * ((t : ℂ) * Y₀)) -
