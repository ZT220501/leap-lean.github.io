          have hk0 : (0 : ℝ) ≤ (k : ℝ) := by positivity
          have habs : |s_minus + (k : ℝ)| ≤ |s_minus| + (k : ℝ) := by
            calc |s_minus + (k : ℝ)| ≤ |s_minus| + |(k : ℝ)| := abs_add_le _ _
              _ = |s_minus| + (k : ℝ) := by rw [abs_of_nonneg hk0]
          calc |y.im + (s_minus + (k : ℝ)) * q.2.im|
