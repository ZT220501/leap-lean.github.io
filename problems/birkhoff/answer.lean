    have h_quotYT_id : ∀ {U : Set (ℂ × ℂ)} {N_f D_f f : ℂ × ℂ → ℂ},
        IsOpen U → DifferentiableOn ℂ D_f U → DifferentiableOn ℂ f U →
        (∀ q ∈ U, N_f q = f q * D_f q) →
        ∀ a b : ℕ, ∀ q ∈ U,
          ssbpcQuotNumYT D_f a b N_f q = iterDerivYT a b f q * (D_f q) ^ (a + b + 1) := by
      intro U N_f D_f f hU hD hf hN_eq a
      have h_y : ∀ m : ℕ, ∀ q ∈ U,
          ssbpcQuotNumY D_f m N_f q = iterDerivY m f q * (D_f q) ^ (m + 1) := by
        intro m
        induction m with
        | zero =>
          intro q hq
          simpa [ssbpcQuotNumY, iterDerivY] using hN_eq q hq
        | succ m ih =>
          intro q hq
          have h_nhds : ∀ᶠ z in nhds q.1, (z, q.2) ∈ U :=
