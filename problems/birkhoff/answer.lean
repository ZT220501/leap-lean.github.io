        (by rw [abs_of_nonneg (by linarith)]; linarith)
        hDX_holo hDstep_holo hDmid_holo
        (hLipX j (le_of_lt hj)) (hLipStep j hj) (hLipMid j hj) r hr ζ hζ

  
  let K_inv : ℝ := S.K_mesh + 12 * S.R_mesh + 1
