            (g (Complex.exp ((ϕ : ℂ) * Complex.I))).im ≤ -C_dip) := by
    intro ϕ₁ ϕ₂ C_dip η_plus hCdip hη
    have hc_bound : ∀ n : ℕ,
        (2 * (n : ℝ) + 1) * ((n.centralBinom : ℝ) / (4 : ℝ) ^ n) ^ 2 ≤ 1 := by
      intro n
      induction n with
      | zero => norm_num
      | succ n ih =>
        have hrec_nat := Nat.succ_mul_centralBinom_succ n
        have hrec_real :
            ((n : ℝ) + 1) * ((n + 1).centralBinom : ℝ) =
