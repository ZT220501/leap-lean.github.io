          -((d_nat : ℂ) ^ 2 * (Rw1 ^ α * Rw1 ^ α)) *
            ((γ : ℂ) ^ 2 *
                ((P_plus.eval w) ^ γ * ((P_plus.eval w) ^ α - (Q_plus.eval w) ^ α) *
                  (Q_ρ.eval w) ^ γ * ((P_ρ.eval w) ^ α - (Q_ρ.eval w) ^ α)) -
              (α : ℂ) ^ 2 *
                ((Q_plus.eval w) ^ α * ((P_plus.eval w) ^ γ - (Q_plus.eval w) ^ γ) *
                  (P_ρ.eval w) ^ α * ((P_ρ.eval w) ^ γ - (Q_ρ.eval w) ^ γ))) =
          (((d_nat : ℂ) ^ 2 * (γ : ℂ) ^ 2 *
              ((Rw1 * (P_plus.eval w / Q_plus.eval w)) ^ α - Rw1 ^ α) *
              ((Rw1 * (Q_ρ.eval w / P_ρ.eval w)) ^ α - Rw1 ^ α)) -
            ((d_nat : ℂ) ^ 2 * (α : ℂ) ^ 2 * Rw1 ^ (2 * α + 2 * γ) *
              (((Rw1 * (P_plus.eval w / Q_plus.eval w)) ^ γ)⁻¹ - (Rw1 ^ γ)⁻¹) *
              (((Rw1 * (Q_ρ.eval w / P_ρ.eval w)) ^ γ)⁻¹ - (Rw1 ^ γ)⁻¹))) *
            ((Q_plus.eval w) ^ α * (P_ρ.eval w) ^ α * (P_plus.eval w) ^ γ * (Q_ρ.eval w) ^ γ) := by
        rw [h_mid_split]
        simp only [mul_pow, div_pow]
        field_simp [hQp_ne, hPw_ne, hPp_ne, hQw_ne, hRw1_γ_ne]
        ring
      rw [h_sub0, zero_mul] at h_id
      change ((Polynomial.C ((γ : ℂ) ^ 2) *
          (P_plus ^ γ * (P_plus ^ α - Q_plus ^ α) * Q_ρ ^ γ * (P_ρ ^ α - Q_ρ ^ α)) -
        Polynomial.C ((α : ℂ) ^ 2) *
          (Q_plus ^ α * (P_plus ^ γ - Q_plus ^ γ) * P_ρ ^ α * (P_ρ ^ γ - Q_ρ ^ γ)))).eval w = 0
      simp only [Polynomial.eval_sub, Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_pow]
      exact (mul_eq_zero.mp h_id).resolve_left
        (neg_ne_zero.mpr (mul_ne_zero h_d_ne (mul_ne_zero hRw1_α_ne hRw1_α_ne)))
  obtain ⟨h_n1, P_ρ, Q_ρ, s, hs, hP_monic, hQ_monic, hP_deg, hQ_deg,
    h_coprime, h_diff_ne, h_diff_deg, h_n2, h_n4⟩ := h_part1
  have h_part2 :
      ((P_ρ.comp (Polynomial.X + 1) ^ 5 - Q_ρ.comp (Polynomial.X + 1) ^ 5) *
          (P_ρ ^ 5 - Q_ρ ^ 5) ≠
        25 * (P_ρ.comp (Polynomial.X + 1) - Q_ρ.comp (Polynomial.X + 1)) *
          (P_ρ - Q_ρ) * P_ρ ^ 4 * Q_ρ.comp (Polynomial.X + 1) ^ 4) ∧
      (∀ α γ : ℕ, 1 ≤ γ → γ < α → Nat.Coprime α γ →
        Polynomial.C ((γ : ℂ) ^ 2) *
          (P_ρ.comp (Polynomial.X + 1) ^ γ *
            (P_ρ.comp (Polynomial.X + 1) ^ α - Q_ρ.comp (Polynomial.X + 1) ^ α) *
            Q_ρ ^ γ * (P_ρ ^ α - Q_ρ ^ α)) ≠
        Polynomial.C ((α : ℂ) ^ 2) *
          (Q_ρ.comp (Polynomial.X + 1) ^ α *
            (P_ρ.comp (Polynomial.X + 1) ^ γ - Q_ρ.comp (Polynomial.X + 1) ^ γ) *
            P_ρ ^ α * (P_ρ ^ γ - Q_ρ ^ γ))) := by
    let Δ_ρ : Polynomial ℂ := P_ρ - Q_ρ
    have hP_ne : P_ρ ≠ 0 := hP_monic.ne_zero
    have hQ_ne : Q_ρ ≠ 0 := hQ_monic.ne_zero
    have hP_lc : P_ρ.coeff s = 1 := by rw [← hP_deg]; exact hP_monic.leadingCoeff
    have hQ_lc : Q_ρ.coeff s = 1 := by rw [← hQ_deg]; exact hQ_monic.leadingCoeff
    let c_Δ : ℂ := Δ_ρ.leadingCoeff
    have hc_Δ_ne : c_Δ ≠ 0 := Polynomial.leadingCoeff_ne_zero.mpr h_diff_ne
    have hc_Δ_coeff : Δ_ρ.coeff (s - 1) = c_Δ := by
      change (P_ρ - Q_ρ).coeff (s - 1) = (P_ρ - Q_ρ).leadingCoeff
      rw [← h_diff_deg, Polynomial.coeff_natDegree]
    let W_ρ : Polynomial ℂ := P_ρ.derivative * Q_ρ - P_ρ * Q_ρ.derivative
    have hW_alt : W_ρ = Δ_ρ.derivative * Q_ρ - Δ_ρ * Q_ρ.derivative := by
      have hP_eq : P_ρ = Q_ρ + Δ_ρ := by dsimp [Δ_ρ]; ring
      have hP'_eq : P_ρ.derivative = Q_ρ.derivative + Δ_ρ.derivative := by
        rw [hP_eq, map_add]
      dsimp [W_ρ]
      rw [hP'_eq, hP_eq]
      ring
    have hW_deg_and_ne : W_ρ ≠ 0 ∧ W_ρ.natDegree = 2 * s - 2 := by
      have h_le_and_coeff : W_ρ.natDegree ≤ 2 * s - 2 ∧ W_ρ.coeff (2 * s - 2) = -c_Δ := by
        by_cases hs1 : s = 1
        · subst hs1
          have hΔ_deg0 : Δ_ρ.natDegree = 0 := by simpa [Δ_ρ] using h_diff_deg
          have hΔ_C : Δ_ρ = Polynomial.C c_Δ := by
            rw [← hc_Δ_coeff]
            exact Polynomial.eq_C_of_natDegree_eq_zero hΔ_deg0
          have hΔ'_zero : Δ_ρ.derivative = 0 := by rw [hΔ_C, Polynomial.derivative_C]
          have hQ'_deg : Q_ρ.derivative.natDegree ≤ 0 := by
            have := Polynomial.natDegree_derivative_le Q_ρ
            omega
          have hW_eq1 : W_ρ = -(Polynomial.C c_Δ * Q_ρ.derivative) := by
            rw [hW_alt, hΔ'_zero, hΔ_C]
            ring
          refine ⟨?_, ?_⟩
          · rw [hW_eq1, Polynomial.natDegree_neg]
            exact le_trans (Polynomial.natDegree_C_mul_le c_Δ Q_ρ.derivative) hQ'_deg
          · change W_ρ.coeff 0 = -c_Δ
            rw [hW_eq1, Polynomial.coeff_neg, Polynomial.coeff_C_mul, Polynomial.coeff_derivative,
              Nat.zero_add, hQ_lc]
            ring
        · have hs2 : 2 ≤ s := by omega
          have hΔ'_deg : Δ_ρ.derivative.natDegree ≤ s - 2 := by
            have := Polynomial.natDegree_derivative_le Δ_ρ
            have hd : Δ_ρ.natDegree = s - 1 := h_diff_deg
            omega
          have hQ'_deg : Q_ρ.derivative.natDegree ≤ s - 1 := by
            have := Polynomial.natDegree_derivative_le Q_ρ
            omega
          have h_deg1 : (Δ_ρ.derivative * Q_ρ).natDegree ≤ 2 * s - 2 := by
            calc (Δ_ρ.derivative * Q_ρ).natDegree
              ≤ Δ_ρ.derivative.natDegree + Q_ρ.natDegree := Polynomial.natDegree_mul_le
              _ ≤ (s - 2) + s := Nat.add_le_add hΔ'_deg (le_of_eq hQ_deg)
              _ = 2 * s - 2 := by omega
          have h_deg2 : (Δ_ρ * Q_ρ.derivative).natDegree ≤ 2 * s - 2 := by
            calc (Δ_ρ * Q_ρ.derivative).natDegree
              ≤ Δ_ρ.natDegree + Q_ρ.derivative.natDegree := Polynomial.natDegree_mul_le
              _ ≤ (s - 1) + (s - 1) := Nat.add_le_add (le_of_eq h_diff_deg) hQ'_deg
              _ = 2 * s - 2 := by omega
          have hW_le : W_ρ.natDegree ≤ 2 * s - 2 := by
            rw [hW_alt]
            exact le_trans (Polynomial.natDegree_sub_le _ _) (max_le h_deg1 h_deg2)
          have h_c1 : (Δ_ρ.derivative * Q_ρ).coeff (2 * s - 2) = c_Δ * ((s - 1 : ℕ) : ℂ) := by
            rw [Polynomial.coeff_mul]
            rw [Finset.sum_eq_single (s - 2, s)]
            · rw [Polynomial.coeff_derivative, hQ_lc]
              have h_idx : s - 2 + 1 = s - 1 := by omega
              rw [h_idx, hc_Δ_coeff]
              have h_cast : ((s - 2 : ℕ) : ℂ) + 1 = ((s - 1 : ℕ) : ℂ) := by
                rw [← h_idx]; push_cast; rfl
              rw [h_cast, mul_one]
            · intro b hb hb_ne
              have hb_sum : b.1 + b.2 = 2 * s - 2 := by simpa using hb
              by_cases hb1 : s - 2 < b.1
              · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (lt_of_le_of_lt hΔ'_deg hb1), zero_mul]
              · have hb2 : Q_ρ.natDegree < b.2 := by
                  rcases b with ⟨b1, b2⟩
                  dsimp at hb_sum hb1 ⊢
                  rw [hQ_deg]
                  by_contra h_le
                  have h_b1 : b1 = s - 2 := by omega
                  have h_b2 : b2 = s := by omega
                  exact hb_ne (Prod.ext h_b1 h_b2)
                rw [Polynomial.coeff_eq_zero_of_natDegree_lt hb2, mul_zero]
            · intro h_not_mem
              apply False.elim (h_not_mem ?_)
              simp
              omega
          have h_c2 : (Δ_ρ * Q_ρ.derivative).coeff (2 * s - 2) = c_Δ * (s : ℂ) := by
            rw [Polynomial.coeff_mul]
            rw [Finset.sum_eq_single (s - 1, s - 1)]
            · rw [hc_Δ_coeff, Polynomial.coeff_derivative]
              have h_idx : s - 1 + 1 = s := by omega
              rw [h_idx, hQ_lc]
              have h_cast : ((s - 1 : ℕ) : ℂ) + 1 = (s : ℂ) := by
                rw [← h_idx]; push_cast; rfl
              rw [h_cast, one_mul]
            · intro b hb hb_ne
              have hb_sum : b.1 + b.2 = 2 * s - 2 := by simpa using hb
              by_cases hb1 : s - 1 < b.1
              · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (h_diff_deg ▸ hb1), zero_mul]
              · have hb2 : s - 1 < b.2 := by
                  rcases b with ⟨b1, b2⟩
                  dsimp at hb_sum hb1 ⊢
                  by_contra h_le
                  have h_b1 : b1 = s - 1 := by omega
                  have h_b2 : b2 = s - 1 := by omega
                  exact hb_ne (Prod.ext h_b1 h_b2)
                rw [Polynomial.coeff_eq_zero_of_natDegree_lt (lt_of_le_of_lt hQ'_deg hb2), mul_zero]
            · intro h_not_mem
              apply False.elim (h_not_mem ?_)
              simp
              omega
          refine ⟨hW_le, ?_⟩
          rw [hW_alt, Polynomial.coeff_sub, h_c1, h_c2, Nat.cast_sub (by omega : 1 ≤ s)]
          push_cast
          ring
      have h_c_ne : W_ρ.coeff (2 * s - 2) ≠ 0 := by
        rw [h_le_and_coeff.2]
        exact neg_ne_zero.mpr hc_Δ_ne
      have hW_ne : W_ρ ≠ 0 := by
        intro h0
        rw [h0, Polynomial.coeff_zero] at h_c_ne
        exact h_c_ne rfl
      exact ⟨hW_ne, Polynomial.natDegree_eq_of_le_of_coeff_ne_zero h_le_and_coeff.1 h_c_ne⟩
    have hW_ne : W_ρ ≠ 0 := hW_deg_and_ne.1
    have hW_deg : W_ρ.natDegree = 2 * s - 2 := hW_deg_and_ne.2
    have hW_rm_le : ∀ (F G : Polynomial ℂ),
        (W_ρ = F.derivative * G - F * G.derivative ∨ W_ρ = G.derivative * F - G * F.derivative) →
        ∀ w₀ : ℂ, Polynomial.rootMultiplicity w₀ F - 1 ≤ Polynomial.rootMultiplicity w₀ W_ρ := by
      intro F G hFG w₀
      let e : ℕ := Polynomial.rootMultiplicity w₀ F
      by_cases he1 : e ≤ 1
      · change e - 1 ≤ _
        have : e - 1 = 0 := by omega
        rw [this]
        exact Nat.zero_le _
      · have he2 : 2 ≤ e := by omega
        have hF_ne : F ≠ 0 := by
          intro h0
          have : e = 0 := by dsimp [e]; rw [h0, Polynomial.rootMultiplicity_zero]
          omega
        have h_root : F.IsRoot w₀ := (Polynomial.rootMultiplicity_pos hF_ne).mp (by omega)
        have hdvd_F : (Polynomial.X - Polynomial.C w₀) ^ (e - 1) ∣ F :=
          dvd_trans (pow_dvd_pow _ (by omega : e - 1 ≤ e)) (Polynomial.pow_rootMultiplicity_dvd F w₀)
        have hdvd_F' : (Polynomial.X - Polynomial.C w₀) ^ (e - 1) ∣ F.derivative := by
          have h_rm' : Polynomial.rootMultiplicity w₀ F.derivative = e - 1 :=
            Polynomial.derivative_rootMultiplicity_of_root h_root
          rw [← h_rm']
          exact Polynomial.pow_rootMultiplicity_dvd F.derivative w₀
        have hdvd_W : (Polynomial.X - Polynomial.C w₀) ^ (e - 1) ∣ W_ρ := by
          rcases hFG with h1 | h2
          · rw [h1]
            exact dvd_sub (dvd_mul_of_dvd_left hdvd_F' G) (dvd_mul_of_dvd_left hdvd_F G.derivative)
          · rw [h2]
            exact dvd_sub (dvd_mul_of_dvd_right hdvd_F G.derivative) (dvd_mul_of_dvd_right hdvd_F' G)
        exact (Polynomial.le_rootMultiplicity_iff hW_ne).mpr hdvd_W
    have h_sum_roots : ∀ (F : Polynomial ℂ), F ≠ 0 →
        ∑ w ∈ F.roots.toFinset, Polynomial.rootMultiplicity w F = F.natDegree := by
