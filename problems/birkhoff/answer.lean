      have hfL_ana : AnalyticOnNhd ℂ (fun w => H_plus T T_c w) U_w :=
        hfL_holo.analyticOnNhd hUw_open
      have hfR_ana : AnalyticOnNhd ℂ (fun w => g_plus T T_c w) U_w :=
        hfR_holo.analyticOnNhd hUw_open
      have hev : (fun w => H_plus T T_c w) =ᶠ[nhds w₀] (fun w => g_plus T T_c w) := by
