        one_mem' := ⟨1, 1, by simp, by simp⟩
        add_mem' := by
          rintro _ _ ⟨A₁, B₁, hB₁, rfl⟩ ⟨A₂, B₂, hB₂, rfl⟩
          refine ⟨A₁ * B₂ + A₂ * B₁, B₁ * B₂, by rw [map_mul]; exact mul_ne_zero hB₁ hB₂, ?_⟩
          rw [div_add_div _ _ hB₁ hB₂]
          simp only [map_add, map_mul]
          ring
        zero_mem' := ⟨0, 1, by simp, by simp⟩
        neg_mem' := by
          rintro _ ⟨A, B, hB, rfl⟩
          exact ⟨-A, B, hB, by rw [map_neg, neg_div]⟩
        inv_mem' := by
          rintro _ ⟨A, B, hB, rfl⟩
          by_cases hA : ev_pt A = 0
          · exact ⟨0, 1, by simp, by simp [hA]⟩
          · exact ⟨B, A, hA, by rw [inv_div]⟩
