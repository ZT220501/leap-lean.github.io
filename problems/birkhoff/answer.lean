    rw [sq, ← Real.exp_add]
    ring_nf
  rw [hexp_sq] at hbessel
  have hcurv_sq : κ₀ ^ (2 : ℕ) * ‖g 0‖ ^ (2 : ℕ) ≤ ‖deriv (deriv g) 0‖ ^ (2 : ℕ) := by
    have hprod := pow_le_pow_left₀ (by positivity) hg_curv 2
    rwa [mul_pow] at hprod
  have h1δ_sq_le : (1 + δ₀) ^ (2 : ℕ) ≤ 1 + κ₀ ^ (2 : ℕ) / 64 := by nlinarith
  have hg0_prod_lt : (1 + δ₀) ^ (2 : ℕ) * ‖g 0‖ ^ (2 : ℕ) < 1 + δ₀ := by
    have h_step1 : (1 + δ₀) ^ (2 : ℕ) * ‖g 0‖ ^ (2 : ℕ) ≤
        (1 + κ₀ ^ (2 : ℕ) / 64) * ‖g 0‖ ^ (2 : ℕ) :=
      mul_le_mul_of_nonneg_right h1δ_sq_le (sq_nonneg _)
    have h_step2 : (1 + κ₀ ^ (2 : ℕ) / 64) * ‖g 0‖ ^ (2 : ℕ) ≤
        ‖g 0‖ ^ (2 : ℕ) + (1 / 64 : ℝ) * ‖deriv (deriv g) 0‖ ^ (2 : ℕ) := by nlinarith
    exact lt_of_le_of_lt (le_trans h_step1 h_step2) (lt_of_le_of_lt hbessel hexp32_lt)
  have hg0_lt_inv : (1 + δ₀) * ‖g 0‖ ^ (2 : ℕ) < 1 := by
    have hpos : 0 < 1 + δ₀ := by linarith
    have hrew : (1 + δ₀) * ((1 + δ₀) * ‖g 0‖ ^ (2 : ℕ)) < (1 + δ₀) * 1 := by
      linarith [hg0_prod_lt]
    exact lt_of_mul_lt_mul_left hrew (le_of_lt hpos)
  have h1_lt_eta : 1 < (1 + δ₀) * (1 - η) ^ (2 : ℕ) := by
    have hid : (1 + δ₀) * (1 - η) ^ (2 : ℕ) - 1 = (δ₀ / 9) * (3 - 5 * δ₀ + δ₀ ^ (2 : ℕ)) := by
      dsimp [η]; ring
    have h35 : 0 < 3 - 5 * δ₀ + δ₀ ^ (2 : ℕ) := by nlinarith
    have hprod_pos : 0 < (δ₀ / 9) * (3 - 5 * δ₀ + δ₀ ^ (2 : ℕ)) := mul_pos (by positivity) h35
    linarith
  have hg0_sq_lt : ‖g 0‖ ^ (2 : ℕ) < (1 - η) ^ (2 : ℕ) := by
    have hlt : (1 + δ₀) * ‖g 0‖ ^ (2 : ℕ) < (1 + δ₀) * (1 - η) ^ (2 : ℕ) :=
      lt_trans hg0_lt_inv h1_lt_eta
    exact lt_of_mul_lt_mul_left hlt (by positivity : 0 ≤ 1 + δ₀)
  have hg0_le : ‖g 0‖ ≤ 1 - η := by
    by_contra h_not_g0
    have hgt : 1 - η < ‖g 0‖ := lt_of_not_ge h_not_g0
    have hsq_lt : (1 - η) ^ (2 : ℕ) < ‖g 0‖ ^ (2 : ℕ) := by nlinarith
    linarith
  exact not_le_of_gt h_lt (h_s3 hg_cb_le_2 hg0_le)

theorem cone_curv_envelope_and_amp_chain (S : FiniteWallNonisotropicStrip)
    (hBudget : CriticalAngleBudgetData S)
    (A : AmplitudeDeficitData S hBudget)
    (L₀ C₁ C₂ : ℝ) (hL₀ : 0 < L₀) (hC₁ : 0 < C₁) (hC₂ : 0 < C₂) :
    ∃ K_cone C_cone : ℝ, A.K_amp ≤ K_cone ∧ 0 < C_cone ∧
      ∀ K : ℝ, K_cone ≤ K →
        (∀ v ∈ Set.Icc ((9 / 10 : ℝ) * K) ((21 / 10 : ℝ) * K),
          rowMomentFull S v ≤ K ^ (1 / 100 : ℝ)) →
        ContinuousOn (fun p : ℝ × ℝ => coneCurvEnvelope S L₀ C₁ C₂ K p.1 p.2)
          (Set.Icc (0 : ℝ) (2 * Real.pi) ×ˢ Set.Icc ((6 / 5 : ℝ) * K) ((9 / 5 : ℝ) * K)) ∧
        (∀ k ∈ Set.Icc ((6 / 5 : ℝ) * K) ((9 / 5 : ℝ) * K),
          (∫ x₀ in (0 : ℝ)..(2 * Real.pi), coneCurvEnvelope S L₀ C₁ C₂ K x₀ k) ≤
            C_cone * K ^ (3 / 100 : ℝ)) ∧
        (∀ x₀ ∈ Set.Icc (0 : ℝ) (2 * Real.pi),
          ∀ k ∈ Set.Icc ((6 / 5 : ℝ) * K) ((9 / 5 : ℝ) * K),
          ∀ z₁ ∈ horizStrip S.H,
            |truncLogSpeed S (A.epsK K) (upperRowPt S k x₀)| ≤
              (1 / 4 : ℝ) * K ^ (3 / 50 : ℝ) →
            |localAmp S (upperRowPt S k x₀) -
                truncLogSpeed S (A.epsK K) (upperRowPt S k x₀)| ≤
              K ^ (1 / 50 : ℝ) →
            coneCurvEnvelope S L₀ C₁ C₂ K x₀ k ≤ K ^ (2 / 50 : ℝ) →
            0 < z₁.im →
            |z₁.re - x₀| ≤ L₀ * wallDepth S z₁ →
            k - C₁ * Real.log k ≤ -Real.log (wallDepth S z₁) →
            -Real.log (wallDepth S z₁) ≤ k + C₂ →
            let x₁ : ℝ := z₁.re
            let δ₁ : ℝ := wallDepth S z₁
            let v₁ : ℝ := -Real.log δ₁
            let δ₂ : ℝ := Real.exp (-3) * δ₁
            let z₂ : ℂ := (x₁ : ℂ) + ((S.H - δ₂ : ℝ) : ℂ) * Complex.I
            v₁ ∈ Set.Icc ((23 / 20 : ℝ) * K) ((37 / 20 : ℝ) * K) ∧
            0 < δ₁ ∧ δ₁ < S.H / 8 ∧
            0 < δ₂ ∧ δ₂ < S.H / 8 ∧
            tileCurvBound S x₁ δ₁ ≤ 2 * K ^ (1 / 50 : ℝ) ∧
            tileCurvBound S x₁ δ₂ ≤ 2 * K ^ (1 / 50 : ℝ) ∧
            (∀ ζ ∈ Metric.closedBall z₁ (3 * δ₁ / 8),
              |localAmp S ζ| ≤ (1 / 3 : ℝ) * K ^ (3 / 50 : ℝ)) ∧
            (∀ ζ ∈ Metric.closedBall z₂ (3 * δ₂ / 8),
              |localAmp S ζ| ≤ (1 / 3 : ℝ) * K ^ (3 / 50 : ℝ)) ∧
            (∀ ζ ∈ Metric.closedBall z₁ (δ₁ / 2),
              Real.log (A.epsK K) ≤ localAmp S ζ) ∧
            (∀ ζ ∈ Metric.closedBall z₂ (δ₂ / 2),
              Real.log (A.epsK K) ≤ localAmp S ζ)) :=
by
  have hOpen_strip : IsOpen (horizStrip S.H) :=
    isOpen_Iio.preimage (continuous_abs.comp Complex.continuous_im)
  have hf_cont : ContinuousOn S.f (horizStrip S.H) := S.f_holo.continuousOn
  have hq_cont : ContinuousOn S.q (horizStrip S.H) := S.q_holo.continuousOn
  have hC_amp_pos : 0 < A.C_amp := lt_of_lt_of_le zero_lt_one A.one_le_C_amp

  
  obtain ⟨C_cone, hC_cone_def⟩ :
      ∃ x : ℝ, x = 256 * (60 * L₀ + 10) * (200 * C₁ + C₂ + 7) := ⟨_, rfl⟩
  have hC_cone_pos : 0 < C_cone := by rw [hC_cone_def]; positivity
  obtain ⟨M_amp, hM_amp_def⟩ :
      ∃ x : ℝ, x = 1 + 2 * A.C_amp * (800 * C₁ + 4 * L₀ + 4 * C₂ + 18) := ⟨_, rfl⟩
  have hM_amp_pos : 0 < M_amp := by rw [hM_amp_def]; positivity
  obtain ⟨K_cone, hK_cone_def⟩ : ∃ x : ℝ, x = max A.K_amp
      (max ((4000 * C₁ + 200) ^ (2 : ℕ))
        (max (20 * (C₂ + 10)) ((12 * M_amp) ^ (50 : ℕ)))) := ⟨_, rfl⟩
  have hKamp_le_Kcone : A.K_amp ≤ K_cone := by rw [hK_cone_def]; exact le_max_left _ _
  refine ⟨K_cone, C_cone, hKamp_le_Kcone, hC_cone_pos, ?_⟩
  intro K hK hSmall

  
  have hThresholds :
      A.K_amp ≤ K ∧
      hBudget.k₀ ≤ K ∧
      (200 : ℝ) ≤ K ∧
      (1 : ℝ) ≤ K ∧
      0 < K ∧
      (1 : ℝ) ≤ K ^ (1 / 100 : ℝ) ∧
      (1 : ℝ) ≤ K ^ (1 / 50 : ℝ) ∧
      Real.log (2 * K) ≤ 200 * K ^ (1 / 100 : ℝ) ∧
      C₁ * Real.log (2 * K) + 10 ≤ (1 / 20 : ℝ) * K ∧
      C₂ + 10 ≤ (1 / 20 : ℝ) * K ∧
      M_amp * K ^ (3 / 100 : ℝ) ≤ (1 / 12 : ℝ) * K ^ (3 / 50 : ℝ) := by
    have hPow_le_rpow : ∀ (b : ℝ) (m : ℕ), 0 ≤ b → m ≠ 0 → b ^ m ≤ K →
        b ≤ K ^ (1 / (m : ℝ)) := by
      intro b m hb hm hbm
      have hm_pos : (0 : ℝ) < (m : ℝ) := Nat.cast_pos.mpr (Nat.pos_of_ne_zero hm)
      have h1 : (b ^ m) ^ (1 / (m : ℝ)) ≤ K ^ (1 / (m : ℝ)) :=
        Real.rpow_le_rpow (pow_nonneg hb m) hbm (by positivity)
      have h2 : (b ^ m) ^ (1 / (m : ℝ)) = b := by
        rw [← Real.rpow_natCast b m, ← Real.rpow_mul hb,
          mul_one_div_cancel (ne_of_gt hm_pos), Real.rpow_one]
      rwa [h2] at h1
    rw [hK_cone_def] at hK
    have hKamp_le_K : A.K_amp ≤ K := le_trans (le_max_left _ _) hK
    have hK_r1 := le_trans (le_max_right _ _) hK
    have hPow_C1 : (4000 * C₁ + 200) ^ (2 : ℕ) ≤ K := le_trans (le_max_left _ _) hK_r1
    have hK_r2 := le_trans (le_max_right _ _) hK_r1
    have hLin_C2 : 20 * (C₂ + 10) ≤ K := le_trans (le_max_left _ _) hK_r2
    have hPow_M : (12 * M_amp) ^ (50 : ℕ) ≤ K := le_trans (le_max_right _ _) hK_r2
    have hk₀_le_K : hBudget.k₀ ≤ K :=
      le_trans (le_max_left _ _) (le_trans A.K_amp_ge hKamp_le_K)
    have h200_le_K : (200 : ℝ) ≤ K :=
      le_trans (le_max_right _ _) (le_trans A.K_amp_ge hKamp_le_K)
    have h1_le_K : (1 : ℝ) ≤ K := by linarith only [h200_le_K]
    have hK_pos : 0 < K := by linarith only [h200_le_K]
    have h1_rpow100 : (1 : ℝ) ≤ K ^ (1 / 100 : ℝ) := by
      calc (1 : ℝ) = (1 : ℝ) ^ (1 / 100 : ℝ) := (Real.one_rpow _).symm
        _ ≤ K ^ (1 / 100 : ℝ) := Real.rpow_le_rpow zero_le_one h1_le_K (by norm_num)
    have h1_rpow50 : (1 : ℝ) ≤ K ^ (1 / 50 : ℝ) := by
      calc (1 : ℝ) = (1 : ℝ) ^ (1 / 50 : ℝ) := (Real.one_rpow _).symm
        _ ≤ K ^ (1 / 50 : ℝ) := Real.rpow_le_rpow zero_le_one h1_le_K (by norm_num)
    have hLog2K : Real.log (2 * K) ≤ 200 * K ^ (1 / 100 : ℝ) := by
      have h2K_pos : 0 < 2 * K := by positivity
      have h1 : (1 / 100 : ℝ) * Real.log (2 * K) ≤ (2 * K) ^ (1 / 100 : ℝ) - 1 := by
        rw [← Real.log_rpow h2K_pos]
        exact Real.log_le_sub_one_of_pos (Real.rpow_pos_of_pos h2K_pos _)
      have h2 : (2 * K) ^ (1 / 100 : ℝ) = (2 : ℝ) ^ (1 / 100 : ℝ) * K ^ (1 / 100 : ℝ) :=
        Real.mul_rpow (by norm_num) hK_pos.le
      have h3 : (2 : ℝ) ^ (1 / 100 : ℝ) ≤ 2 := by
        calc (2 : ℝ) ^ (1 / 100 : ℝ) ≤ (2 : ℝ) ^ (1 : ℝ) :=
              Real.rpow_le_rpow_of_exponent_le (by norm_num) (by norm_num)
          _ = 2 := Real.rpow_one 2
      have h4 : (2 * K) ^ (1 / 100 : ℝ) ≤ 2 * K ^ (1 / 100 : ℝ) := by
        rw [h2]
        exact mul_le_mul_of_nonneg_right h3 (Real.rpow_nonneg hK_pos.le _)
      linarith only [h1, h4]
    have hC1_log : C₁ * Real.log (2 * K) + 10 ≤ (1 / 20 : ℝ) * K := by
      have h1 : 4000 * C₁ + 200 ≤ K ^ (1 / 2 : ℝ) := by
        simpa using hPow_le_rpow (4000 * C₁ + 200) 2 (by positivity) (by norm_num) hPow_C1
      have h2 : K ^ (1 / 2 : ℝ) ≤ K ^ (99 / 100 : ℝ) :=
        Real.rpow_le_rpow_of_exponent_le h1_le_K (by norm_num)
      have h3 : (4000 * C₁ + 200) * K ^ (1 / 100 : ℝ) ≤ K := by
        calc (4000 * C₁ + 200) * K ^ (1 / 100 : ℝ)
            ≤ K ^ (99 / 100 : ℝ) * K ^ (1 / 100 : ℝ) :=
              mul_le_mul_of_nonneg_right (le_trans h1 h2) (Real.rpow_nonneg hK_pos.le _)
          _ = K ^ (1 : ℝ) := by rw [← Real.rpow_add hK_pos]; norm_num
          _ = K := Real.rpow_one K
      have h4 : C₁ * Real.log (2 * K) ≤ 200 * C₁ * K ^ (1 / 100 : ℝ) := by
        have := mul_le_mul_of_nonneg_left hLog2K hC₁.le
        linarith only [this]
      have h5 : (10 : ℝ) ≤ 10 * K ^ (1 / 100 : ℝ) := by linarith only [h1_rpow100]
      have h6 : 200 * C₁ * K ^ (1 / 100 : ℝ) + 10 * K ^ (1 / 100 : ℝ) =
          (1 / 20 : ℝ) * ((4000 * C₁ + 200) * K ^ (1 / 100 : ℝ)) := by ring
      linarith only [h3, h4, h5, h6]
    have hC2_b : C₂ + 10 ≤ (1 / 20 : ℝ) * K := by linarith only [hLin_C2]
    have hMamp_b : M_amp * K ^ (3 / 100 : ℝ) ≤ (1 / 12 : ℝ) * K ^ (3 / 50 : ℝ) := by
      have h1 : 12 * M_amp ≤ K ^ (1 / 50 : ℝ) := by
        simpa using hPow_le_rpow (12 * M_amp) 50 (by positivity) (by norm_num) hPow_M
      have h2 : K ^ (1 / 50 : ℝ) ≤ K ^ (3 / 100 : ℝ) :=
        Real.rpow_le_rpow_of_exponent_le h1_le_K (by norm_num)
      have h3 : 12 * M_amp * K ^ (3 / 100 : ℝ) ≤ K ^ (3 / 50 : ℝ) := by
        calc 12 * M_amp * K ^ (3 / 100 : ℝ)
            ≤ K ^ (3 / 100 : ℝ) * K ^ (3 / 100 : ℝ) :=
              mul_le_mul_of_nonneg_right (le_trans h1 h2) (Real.rpow_nonneg hK_pos.le _)
          _ = K ^ (3 / 50 : ℝ) := by rw [← Real.rpow_add hK_pos]; norm_num
      linarith only [h3]
    exact ⟨hKamp_le_K, hk₀_le_K, h200_le_K, h1_le_K, hK_pos,
      h1_rpow100, h1_rpow50, hLog2K, hC1_log, hC2_b, hMamp_b⟩

  rcases hThresholds with ⟨hKamp_le_K, hk₀_le_K, h200_le_K, h1_le_K, hK_pos,
    h1_rpow100, h1_rpow50, hLog2K, hC1_log_bound, hC2_bound, hMamp_bound⟩

  have hDepth_of_ge : ∀ w : ℝ, hBudget.k₀ ≤ w → Real.exp (-w) < S.H / 8 := by
    intro w hw
    have hexp_le : Real.exp (-w) ≤ Real.exp (-hBudget.k₀) :=
      Real.exp_le_exp.mpr (by linarith only [hw])
    linarith only [hexp_le, hBudget.exp_neg_k₀_lt, S.H_pos]

  have hUpper_in_strip : ∀ w x : ℝ, hBudget.k₀ ≤ w → upperRowPt S w x ∈ horizStrip S.H := by
    intro w x hw
    have hd_lt : Real.exp (-w) < S.H / 8 := hDepth_of_ge w hw
    have hd_pos : 0 < Real.exp (-w) := Real.exp_pos _
    have him : (upperRowPt S w x).im = S.H - Real.exp (-w) := by
      simp only [upperRowPt, Complex.add_im, Complex.ofReal_im, Complex.mul_im,
        Complex.ofReal_re, Complex.I_re, Complex.I_im, mul_one, mul_zero, add_zero, zero_add]
    change |(upperRowPt S w x).im| < S.H
    rw [him, abs_lt]
    exact ⟨by linarith only [hd_lt, S.H_pos], by linarith only [hd_pos]⟩

  
  
  
  have hPillar1 :
      ContinuousOn (fun p : ℝ × ℝ => coneCurvEnvelope S L₀ C₁ C₂ K p.1 p.2)
        (Set.Icc (0 : ℝ) (2 * Real.pi) ×ˢ Set.Icc ((6 / 5 : ℝ) * K) ((9 / 5 : ℝ) * K)) ∧
      (∀ k ∈ Set.Icc ((6 / 5 : ℝ) * K) ((9 / 5 : ℝ) * K),
        (∫ x₀ in (0 : ℝ)..(2 * Real.pi), coneCurvEnvelope S L₀ C₁ C₂ K x₀ k) ≤
          C_cone * K ^ (3 / 100 : ℝ)) := by
    have hSwap : ∀ (f : ℝ × ℝ → ℝ), Continuous f →
        ∀ {a b c d : ℝ}, a ≤ b → c ≤ d →
          (∫ x in a..b, ∫ y in c..d, f (x, y)) = ∫ y in c..d, ∫ x in a..b, f (x, y) := by
      intro f hf a b c d hab hcd
      simp only [intervalIntegral.integral_of_le hab, intervalIntegral.integral_of_le hcd]
      have hInt_compact : MeasureTheory.IntegrableOn f
          (Set.Icc a b ×ˢ Set.Icc c d) MeasureTheory.volume :=
        hf.continuousOn.integrableOn_compact (isCompact_Icc.prod isCompact_Icc)
      have hSub : Set.Ioc a b ×ˢ Set.Ioc c d ⊆ Set.Icc a b ×ˢ Set.Icc c d :=
        Set.prod_mono Set.Ioc_subset_Icc_self Set.Ioc_subset_Icc_self
      have hInt_prod : MeasureTheory.Integrable (Function.uncurry (fun x y => f (x, y)))
          ((MeasureTheory.volume.restrict (Set.Ioc a b)).prod
            (MeasureTheory.volume.restrict (Set.Ioc c d))) := by
        rw [MeasureTheory.Measure.prod_restrict, ← MeasureTheory.Measure.volume_eq_prod ℝ ℝ]
        exact hInt_compact.mono_set hSub
      exact MeasureTheory.integral_integral_swap hInt_prod
    set a₀ : ℝ := -C₁ * Real.log (2 * K) - 2
    set b₀ : ℝ := C₂ + 5
    set M_L : ℝ := 60 * L₀ + 10
    have ha₀_le_b₀ : a₀ ≤ b₀ := by
      have h1_le_2K : (1 : ℝ) ≤ 2 * K := by linarith only [h1_le_K]
      have hC1_nn : 0 ≤ C₁ * Real.log (2 * K) :=
        mul_nonneg hC₁.le (Real.log_nonneg h1_le_2K)
      dsimp [a₀, b₀]
      linarith only [hC1_nn, hC₂]
    have hML_pos : 0 < M_L := by positivity
    have hML_le : -M_L ≤ M_L := by linarith only [hML_pos]
    let k_cl : ℝ → ℝ := fun k => max ((6 / 5 : ℝ) * K) (min ((9 / 5 : ℝ) * K) k)
    let t_cl : ℝ → ℝ := fun t => max a₀ (min b₀ t)
    let w_cl : ℝ → ℝ → ℝ := fun k t => k_cl k + t_cl t
    have hk_cl_bounds : ∀ k : ℝ,
        (6 / 5 : ℝ) * K ≤ k_cl k ∧ k_cl k ≤ (9 / 5 : ℝ) * K := fun k =>
      ⟨le_max_left _ _, max_le (by linarith only [hK_pos]) (min_le_left _ _)⟩
    have ht_cl_bounds : ∀ t : ℝ, a₀ ≤ t_cl t ∧ t_cl t ≤ b₀ := fun t =>
      ⟨le_max_left _ _, max_le ha₀_le_b₀ (min_le_left _ _)⟩
    have hw_cl_bounds : ∀ k t : ℝ,
        (11 / 10 : ℝ) * K ≤ w_cl k t ∧ w_cl k t ≤ (19 / 10 : ℝ) * K := by
      intro k t
      have hk_b := hk_cl_bounds k
      have ht_b := ht_cl_bounds t
      dsimp [w_cl]
      exact ⟨by dsimp [a₀] at ht_b; linarith only [hk_b.1, ht_b.1, hC1_log_bound, hK_pos],
        by dsimp [b₀] at ht_b; linarith only [hk_b.2, ht_b.2, hC2_bound, hK_pos]⟩
    have hw_cl_k0 : ∀ k t : ℝ, hBudget.k₀ ≤ w_cl k t := fun k t => by
      linarith only [(hw_cl_bounds k t).1, hk₀_le_K, hK_pos]
    let Ψ : ((ℝ × ℝ) × ℝ) × ℝ → ℂ := fun q =>
      upperRowPt S (w_cl q.1.1.2 q.1.2) (q.1.1.1 + Real.exp (-w_cl q.1.1.2 q.1.2) * q.2)
    have hw_cl_cont : Continuous (fun r : (ℝ × ℝ) × ℝ => w_cl r.1.2 r.2) :=
      (continuous_const.max (continuous_const.min continuous_fst.snd)).add
        (continuous_const.max (continuous_const.min continuous_snd))
    have hw4_cont : Continuous (fun q : ((ℝ × ℝ) × ℝ) × ℝ => w_cl q.1.1.2 q.1.2) :=
      hw_cl_cont.comp continuous_fst
    have hΨ_cont : Continuous Ψ := by
      dsimp [Ψ, upperRowPt]
      exact (Complex.continuous_ofReal.comp
        (continuous_fst.fst.fst.add
          ((Real.continuous_exp.comp hw4_cont.neg).mul continuous_snd))).add
        ((Complex.continuous_ofReal.comp
          (continuous_const.sub (Real.continuous_exp.comp hw4_cont.neg))).mul continuous_const)
    let Φ_cl : ((ℝ × ℝ) × ℝ) × ℝ → ℝ := fun q =>
      Real.exp (-2 * w_cl q.1.1.2 q.1.2) * ‖S.q (Ψ q)‖
    have hΦ_cl_cont : Continuous Φ_cl :=
      (Real.continuous_exp.comp (continuous_const.mul hw4_cont)).mul
        ((hq_cont.comp_continuous hΨ_cont (fun q => hUpper_in_strip _ _ (hw_cl_k0 _ _))).norm)
    let H₁ : (ℝ × ℝ) × ℝ → ℝ := fun r => ∫ τ in (-M_L)..M_L, Φ_cl (r, τ)
    have hH₁_cont : Continuous H₁ :=
      @intervalIntegral.continuous_parametric_intervalIntegral_of_continuous' ℝ ((ℝ × ℝ) × ℝ)
        _ _ _ MeasureTheory.volume _ _ (fun r τ => Φ_cl (r, τ)) hΦ_cl_cont (-M_L) M_L
    let F_cl : ℝ × ℝ → ℝ := fun p => (64 / Real.pi) * ∫ t in a₀..b₀, H₁ (p, t)
    have hF_cl_cont : Continuous F_cl :=
      continuous_const.mul
