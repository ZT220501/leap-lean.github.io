              (hTk.step_pair_integral hAdm n (H_mask n) K_Ψ
                (hH_pref n (Finset.mem_range.mp hn)) (hH_bd n) hKΨ_meas hKΨ_bd).1
          have hSumBound : (∑ n ∈ Finset.range N_cap,
                ∫ om, H_mask n om * K_Ψ (walkPos ρ om n) (walkPos ρ om (n + 1)) ∂walkMeasure) ≤
              -(1 / 2 : ℝ) * ∫ om, (∑ n ∈ Finset.range N_cap,
                H_mask n om * q_clk (walkPos ρ om n)) ∂walkMeasure := by
            calc
              (∑ n ∈ Finset.range N_cap,
                  ∫ om, H_mask n om * K_Ψ (walkPos ρ om n) (walkPos ρ om (n + 1)) ∂walkMeasure)
                ≤ ∑ n ∈ Finset.range N_cap,
                    (-(1 / 2 : ℝ) * ∫ om, H_mask n om * q_clk (walkPos ρ om n) ∂walkMeasure) :=
                  Finset.sum_le_sum fun n hn => hStepΨBound n (Finset.mem_range.mp hn)
              _ = -(1 / 2 : ℝ) * ∑ n ∈ Finset.range N_cap,
                    ∫ om, H_mask n om * q_clk (walkPos ρ om n) ∂walkMeasure := by
                  rw [← Finset.mul_sum]
              _ = -(1 / 2 : ℝ) * ∫ om, (∑ n ∈ Finset.range N_cap,
                    H_mask n om * q_clk (walkPos ρ om n)) ∂walkMeasure := by
                  congr 1
                  symm
                  exact MeasureTheory.integral_finsetSum _ fun n hn =>
                    hStepClkInt n (Finset.mem_range.mp hn)
          have hτ_int_nn : 0 ≤ ∫ om, (A_s sgn).indicator
              (fun om' => g_Ψ (walkPos ρ om' (τ_s sgn om'))) om ∂walkMeasure := by
            refine MeasureTheory.integral_nonneg fun om => ?_
            by_cases hA : om ∈ A_s sgn
            · rw [Set.indicator_of_mem hA]; exact hΨ_τ_nonneg om hA
            · simp [Set.indicator_of_notMem hA]
          have hσ_int_le : (∫ om, (A_s sgn).indicator
                (fun om' => g_Ψ (walkPos ρ om' (σ_p om'))) om ∂walkMeasure) ≤
              4 * R * d₀ * walkMeasure.real (A_s sgn) := by
            have hPt : ∀ om : WalkSpace,
                (A_s sgn).indicator (fun om' => g_Ψ (walkPos ρ om' (σ_p om'))) om ≤
                  (A_s sgn).indicator (fun _ => 4 * R * d₀) om := by
              intro om
              by_cases hA : om ∈ A_s sgn
              · rw [Set.indicator_of_mem hA, Set.indicator_of_mem hA]; exact hΨ_σ_le om hA
              · simp [Set.indicator_of_notMem hA]
            calc
              (∫ om, (A_s sgn).indicator (fun om' => g_Ψ (walkPos ρ om' (σ_p om'))) om ∂walkMeasure)
                ≤ ∫ om, (A_s sgn).indicator (fun _ => 4 * R * d₀) om ∂walkMeasure :=
                  MeasureTheory.integral_mono hInt_Ψ_σ
                    ((MeasureTheory.integrable_const _).indicator hA_meas) hPt
              _ = 4 * R * d₀ * walkMeasure.real (A_s sgn) := by
                  rw [MeasureTheory.integral_indicator_const _ hA_meas, smul_eq_mul, mul_comm]
          linarith
        exact ⟨hSumClkInt, hClockIntBound⟩
      have hDisjA : Disjoint (A_s 1) (A_s (-1)) := by
        rw [Set.disjoint_left]
        intro om h1 hm1
        have hp : (0 : ℝ) < 1 := zero_lt_one
        have hn : ¬ (0 : ℝ) < -1 := by norm_num
        have hi1 := h1.2
        have him1 := hm1.2
        simp only [if_pos hp] at hi1
        simp only [if_neg hn] at him1
        linarith
      have hSumA_le_one : walkMeasure.real (A_s 1) + walkMeasure.real (A_s (-1)) ≤ 1 := by
        rw [← MeasureTheory.measureReal_union hDisjA hAm1_meas]
        calc
          walkMeasure.real (A_s 1 ∪ A_s (-1))
            ≤ walkMeasure.real (Set.univ : Set WalkSpace) :=
              MeasureTheory.measureReal_mono (Set.subset_univ _)
          _ = 1 := by simp [MeasureTheory.measureReal_def]
      have hRetBoth : walkMeasure.real {om | sliceShapeDepth S P j (walkPos ρ om (σ_p om)) ≤ d₀ ∧
            ∃ m, σ_p om ≤ m ∧ m ≤ N_cap ∧ R ≤ sliceShapeDepth S P j (walkPos ρ om m)} ≤
          d₀ / R := by
        have hSubBoth : {om | sliceShapeDepth S P j (walkPos ρ om (σ_p om)) ≤ d₀ ∧
              ∃ m, σ_p om ≤ m ∧ m ≤ N_cap ∧ R ≤ sliceShapeDepth S P j (walkPos ρ om m)} ⊆
            {om ∈ A_s 1 | R ≤ u_fn 1 (sliceImpactSeq S P.N j.val (walkPos ρ om (τ_s 1 om)))} ∪
            {om ∈ A_s (-1) |
              R ≤ u_fn (-1) (sliceImpactSeq S P.N j.val (walkPos ρ om (τ_s (-1) om)))} := by
          rintro om ⟨hd_σ, m, hσm, hmN, hRm⟩
          have hHitU : ∀ sgn : ℝ, (sgn = 1 ∨ sgn = -1) →
              R ≤ u_fn sgn (sliceImpactSeq S P.N j.val (walkPos ρ om (τ_s sgn om))) := by
            intro sgn hsgn
            have hm_reg : walkPos ρ om m ∈ Ω_reg := (hTk.closedBall_in_reg hAdm om m).1
            have hDepthLeU : sliceShapeDepth S P j (walkPos ρ om m) ≤
                u_fn sgn (sliceImpactSeq S P.N j.val (walkPos ρ om m)) := by
              dsimp only [sliceShapeDepth, u_fn]
              rcases hsgn with rfl | rfl
              · linarith [le_abs_self (sliceImpactSeq S P.N j.val (walkPos ρ om m)).im]
              · linarith [neg_le_abs (sliceImpactSeq S P.N j.val (walkPos ρ om m)).im]
            have hRu_m : R ≤ u_fn sgn (sliceImpactSeq S P.N j.val (walkPos ρ om m)) :=
              le_trans hRm hDepthLeU
            have hτ_m : τ_s sgn om ≤ m := hFindMin' _ ⟨hσm, Or.inr hRu_m⟩
            have hτ_N : τ_s sgn om ≤ N_cap := le_trans hτ_m hmN
            have hspec := @Nat.find_spec
              (fun k => σ_p om ≤ k ∧
                (N_cap ≤ k ∨ R ≤ u_fn sgn (sliceImpactSeq S P.N j.val (walkPos ρ om k))))
              (Classical.decPred _) ⟨N_cap, hσ_le om, Or.inl le_rfl⟩
            rcases hspec.2 with hgeN | hRu_τ
            · have hEqm : τ_s sgn om = m := le_antisymm hτ_m (le_trans hmN hgeN)
              rw [hEqm]; exact hRu_m
            · exact hRu_τ
          by_cases him : 0 ≤ (sliceImpactSeq S P.N j.val (walkPos ρ om (σ_p om))).im
          · left
            refine ⟨⟨hd_σ, ?_⟩, hHitU 1 (Or.inl rfl)⟩
            simp [zero_lt_one, him]
          · right
            refine ⟨⟨hd_σ, ?_⟩, hHitU (-1) (Or.inr rfl)⟩
            have hn : ¬ (0 : ℝ) < -1 := by norm_num
            simp [hn, not_le.mp him]
        have h1 := (hPerSign 1 (Or.inl rfl)).1
        have hm1 := (hPerSign (-1) (Or.inr rfl)).1
        calc
          walkMeasure.real {om | sliceShapeDepth S P j (walkPos ρ om (σ_p om)) ≤ d₀ ∧
              ∃ m, σ_p om ≤ m ∧ m ≤ N_cap ∧ R ≤ sliceShapeDepth S P j (walkPos ρ om m)}
            ≤ walkMeasure.real
                ({om ∈ A_s 1 | R ≤ u_fn 1 (sliceImpactSeq S P.N j.val (walkPos ρ om (τ_s 1 om)))} ∪
                 {om ∈ A_s (-1) |
                   R ≤ u_fn (-1) (sliceImpactSeq S P.N j.val (walkPos ρ om (τ_s (-1) om)))}) :=
              MeasureTheory.measureReal_mono hSubBoth
          _ ≤ walkMeasure.real
                {om ∈ A_s 1 | R ≤ u_fn 1 (sliceImpactSeq S P.N j.val (walkPos ρ om (τ_s 1 om)))} +
              walkMeasure.real
                {om ∈ A_s (-1) |
                  R ≤ u_fn (-1) (sliceImpactSeq S P.N j.val (walkPos ρ om (τ_s (-1) om)))} :=
              MeasureTheory.measureReal_union_le _ _
          _ ≤ (d₀ / R) * walkMeasure.real (A_s 1) + (d₀ / R) * walkMeasure.real (A_s (-1)) :=
              add_le_add h1 hm1
          _ = (d₀ / R) * (walkMeasure.real (A_s 1) + walkMeasure.real (A_s (-1))) := by ring
          _ ≤ (d₀ / R) * 1 := mul_le_mul_of_nonneg_left hSumA_le_one (div_nonneg hd₀.le hR.le)
          _ = d₀ / R := mul_one _
      refine ⟨hRetBoth, fun hdR hR_lt sgn hsgn => ?_, hA1_meas, hAm1_meas⟩
      rcases hPerSign sgn hsgn with ⟨hRetS, hConcS⟩
      rcases hConcS hdR hR_lt with ⟨hIntS, hBdS⟩
      exact ⟨hRetS, hIntS, hBdS⟩
    have hRetreatProp : SliceRetreatBoundProp S P := by
      intro δ hδ
      let M_ret : ℝ := max (max 2 (|Real.log S.H| + 4)) (8 * Real.exp 1 * (P.N : ℝ) / δ + 2)
      have hM_ret_ge2 : 2 ≤ M_ret :=
        le_trans (le_max_left 2 _) (le_max_left _ _)
      refine ⟨M_ret, hM_ret_ge2, fun M hM ρ hAdm => ?_⟩
      have hM_ge2 : 2 ≤ M := le_trans hM_ret_ge2 hM
      have hM_ge_logH : |Real.log S.H| + 4 ≤ M :=
        le_trans (le_trans (le_max_right 2 _) (le_max_left _ _)) hM
      have hM_ge_δ : 8 * Real.exp 1 * (P.N : ℝ) / δ + 2 ≤ M :=
        le_trans (le_max_right _ _) hM
      have hM_pos : 0 < M := by linarith
      have hlogM_pos : 0 < Real.log M :=
        lt_of_lt_of_le (Real.log_pos one_lt_two) (Real.log_le_log zero_lt_two hM_ge2)
      let τ_cap : ℕ → WalkSpace → ℕ := fun N_cap om =>
        @Nat.find (fun m => N_cap ≤ m ∨
          M ≤ Finset.univ.sup' Finset.univ_nonempty (fun k => sliceHistory S P ρ om k m))
          (Classical.decPred _) ⟨N_cap, Or.inl le_rfl⟩
      let E_ret_cap : ℕ → Set WalkSpace := fun N_cap =>
        {om | ∃ m ≤ τ_cap N_cap om, ∃ j : Fin P.N,
          sliceLogDepth S P j (walkPos ρ om m) <
            sliceHistory S P ρ om j m - 4 * Real.log M}
      have hDepthPosLeH : ∀ (om : WalkSpace) (n : ℕ) (j : Fin P.N),
          0 < sliceShapeDepth S P j (walkPos ρ om n) ∧
          sliceShapeDepth S P j (walkPos ρ om n) ≤ S.H ∧
          -Real.log S.H ≤ sliceLogDepth S P j (walkPos ρ om n) := by
        intro om n j
        have hy : walkPos ρ om n ∈ Ω_reg := (hTk.closedBall_in_reg hAdm om n).1
        have him := hTk.impact_maps_to j _ hy.1
        change |(sliceImpactSeq S P.N j.val (walkPos ρ om n)).im| < S.H at him
        have hd_pos : 0 < sliceShapeDepth S P j (walkPos ρ om n) := by
          dsimp only [sliceShapeDepth]; linarith
        have hd_le : sliceShapeDepth S P j (walkPos ρ om n) ≤ S.H := by
          dsimp only [sliceShapeDepth]
          linarith [abs_nonneg (sliceImpactSeq S P.N j.val (walkPos ρ om n)).im]
        refine ⟨hd_pos, hd_le, ?_⟩
        dsimp only [sliceLogDepth]
        linarith [Real.log_le_log hd_pos hd_le]
      let I_M : Finset ℤ := Finset.Icc ⌊-Real.log S.H⌋ (⌊M⌋ + 1)
      have hCardIM : (I_M.card : ℝ) ≤ 2 * M := by
        dsimp only [I_M]
        rw [Int.card_Icc]
        set diff : ℤ := ⌊M⌋ + 1 + 1 - ⌊-Real.log S.H⌋
        by_cases hdiff : 0 ≤ diff
        · have hcast : ((diff.toNat : ℕ) : ℝ) = (diff : ℝ) := by
            exact_mod_cast Int.toNat_of_nonneg hdiff
          rw [hcast]
          dsimp only [diff]
          push_cast
          have h1 : (⌊M⌋ : ℝ) ≤ M := Int.floor_le M
          have h2 : -Real.log S.H - 1 < (⌊-Real.log S.H⌋ : ℝ) := Int.sub_one_lt_floor _
          have h3 : Real.log S.H ≤ |Real.log S.H| := le_abs_self _
          linarith
        · rw [Int.toNat_of_nonpos (le_of_not_ge hdiff)]
          simp; linarith
      have hexp_step_half : Real.exp (-1) ≤ 1 - Real.exp (-M ^ 2) := by
        have he2 : (2 : ℝ) ≤ Real.exp 1 := by linarith [Real.add_one_le_exp (1 : ℝ)]
        have he_inv : Real.exp (-1) ≤ 1 / 2 := by
          rw [Real.exp_neg]
          have := inv_anti₀ zero_lt_two he2
          linarith
        have hM2 : -M ^ 2 ≤ -4 := by nlinarith
        have heM2 : Real.exp (-M ^ 2) ≤ 1 / 2 := by
          refine le_trans (Real.exp_le_exp.mpr hM2) ?_
          have h4 : (-4 : ℝ) ≤ -1 := by norm_num
          exact le_trans (Real.exp_le_exp.mpr h4) he_inv
        linarith
      have hCapRetBound : ∀ N_cap : ℕ, walkMeasure.real (E_ret_cap N_cap) ≤ δ := by
        intro N_cap
        let B_jl : Fin P.N × ℤ → Set WalkSpace := fun p =>
          let d_l := Real.exp (-(p.2 : ℝ))
          let R_l := Real.exp (-(p.2 : ℝ) - 1) * M ^ 4
          let σ_l : WalkSpace → ℕ := fun om =>
            @Nat.find (fun m => N_cap ≤ m ∨ sliceShapeDepth S P p.1 (walkPos ρ om m) ≤ d_l)
              (Classical.decPred _) ⟨N_cap, Or.inl le_rfl⟩
          {om | sliceShapeDepth S P p.1 (walkPos ρ om (σ_l om)) ≤ d_l ∧
            ∃ m, σ_l om ≤ m ∧ m ≤ N_cap ∧ R_l ≤ sliceShapeDepth S P p.1 (walkPos ρ om m)}
        have hCover : E_ret_cap N_cap ⊆ ⋃ p ∈ (Finset.univ : Finset (Fin P.N)) ×ˢ I_M, B_jl p := by
          rintro om ⟨m, hm_τ, j, hret⟩
          have hτ_le_N : τ_cap N_cap om ≤ N_cap := hFindMin' _ (Or.inl le_rfl)
          have hm_N : m ≤ N_cap := le_trans hm_τ hτ_le_N
          have hm_pos : 1 ≤ m := by
            by_contra hm0
            have hm_eq0 : m = 0 := by omega
            subst hm_eq0
            have h0 : sliceHistory S P ρ om j 0 = sliceLogDepth S P j (walkPos ρ om 0) := by
              simp [sliceHistory]
            linarith
          have hm1_lt : m - 1 < τ_cap N_cap om :=
            lt_of_lt_of_le (Nat.sub_lt hm_pos Nat.zero_lt_one) hm_τ
          have hmin_τ := @Nat.find_min
            (fun k => N_cap ≤ k ∨
              M ≤ Finset.univ.sup' Finset.univ_nonempty (fun i => sliceHistory S P ρ om i k))
            (Classical.decPred _) _ (m - 1) hm1_lt
          have hHist_m1_lt : sliceHistory S P ρ om j (m - 1) < M := by
            have hSupLt : Finset.univ.sup' Finset.univ_nonempty
                (fun i => sliceHistory S P ρ om i (m - 1)) < M :=
              lt_of_not_ge fun hge => hmin_τ (Or.inr hge)
            exact lt_of_le_of_lt
              (Finset.le_sup' (fun i => sliceHistory S P ρ om i (m - 1)) (Finset.mem_univ j))
              hSupLt
          have hLog_m1_lt : sliceLogDepth S P j (walkPos ρ om (m - 1)) < M := by
            refine lt_of_le_of_lt ?_ hHist_m1_lt
            exact Finset.le_sup' (fun n => sliceLogDepth S P j (walkPos ρ om n))
              (Finset.mem_range.mpr (Nat.lt_succ_self (m - 1)))
          have hLog_m_lt : sliceLogDepth S P j (walkPos ρ om m) < M + 1 := by
            have hm_succ : (m - 1) + 1 = m := Nat.sub_add_cancel hm_pos
            let y_prev := walkPos ρ om (m - 1)
            have hy_prev : y_prev ∈ Ω_reg := (hTk.closedBall_in_reg hAdm om (m - 1)).1
            have hρ_prev : 0 < ρ y_prev := (hTk.closedBall_in_reg hAdm om (m - 1)).2.1
            let z : ℂ := (ρ y_prev : ℂ) * Complex.exp ((om m : ℂ) * Complex.I)
            have hz_norm : ‖z‖ ≤ ρ y_prev := by
              rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hρ_prev,
                Complex.norm_exp_ofReal_mul_I, mul_one]
            have hstep_pos : walkPos ρ om m = y_prev + z := by
              conv_lhs => rw [← hm_succ, walkPos]
              dsimp only [y_prev, z]
              rw [hm_succ]
            have hSmall := hAdm.small_shape_step y_prev hy_prev z hz_norm j
            rw [← hstep_pos] at hSmall
            have hImDiff : |(sliceImpactSeq S P.N j.val (walkPos ρ om m)).im| -
                |(sliceImpactSeq S P.N j.val y_prev).im| ≤
                Real.exp (-M ^ 2) * sliceShapeDepth S P j y_prev := by
              refine le_trans (abs_sub_abs_le_abs_sub _ _) ?_
              rw [← Complex.sub_im]
              exact le_trans (Complex.abs_im_le_norm _) hSmall
            have hDepthStep : Real.exp (-1) * sliceShapeDepth S P j y_prev ≤
                sliceShapeDepth S P j (walkPos ρ om m) := by
              have h1 : (1 - Real.exp (-M ^ 2)) * sliceShapeDepth S P j y_prev ≤
                  sliceShapeDepth S P j (walkPos ρ om m) := by
                dsimp only [sliceShapeDepth] at hImDiff ⊢
                linarith
              exact le_trans
                (mul_le_mul_of_nonneg_right hexp_step_half (hDepthPosLeH om (m - 1) j).1.le) h1
            have hLogStep := Real.log_le_log
              (mul_pos (Real.exp_pos _) (hDepthPosLeH om (m - 1) j).1) hDepthStep
            rw [Real.log_mul (Real.exp_pos _).ne' (hDepthPosLeH om (m - 1) j).1.ne',
              Real.log_exp] at hLogStep
            dsimp only [sliceLogDepth, y_prev] at hLog_m1_lt hLogStep ⊢
            linarith
          have hHist_m_bounds : -Real.log S.H ≤ sliceHistory S P ρ om j m ∧
