        have h_adm_j := hStep_at (w (j + 1)) t (a j) (b j)
          hp.2.2.2.2
          (by
            rw [hw_plus]
            exact lt_of_lt_of_le hp.1 (hD_ge_Dy (j + 2) hj2_le))
          (by
            rw [hw_minus]
            exact hD_lt_ceil j hj_le)
          (by
            rw [hw_plus]
            exact hw_re (j + 2) hj2_le)
          (by
            rw [hw_plus]
            exact ht_lt_Dj2)
          (by
            rw [hw_minus]
            exact le_trans ih_a hDj_512)
          (le_trans ih_b hDj1_512)
          (le_trans (ih_J j le_rfl) hDj1_32)
        rcases h_adm_j with ⟨hContr_j, hRes_j⟩
