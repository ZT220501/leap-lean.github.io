        exact mul_le_mul_of_nonneg_right hcard_r (by positivity)
      have h3 : (2 * (m₀ : ℝ)) * (2 / (N : ℝ)) < ε / 2 := by
        have hmul : 8 * ((m₀ : ℝ) + 1) < (N : ℝ) * ε := (div_lt_iff₀ hε).mp hN_gt
