      intro K F Φ hKF hΦ_K S_ab hS_F hS_mix l hl1
      have hl0 : l ≠ 0 := by omega
      have hU0 : PowerSeries.coeff 0 (pointRecFormalU F Φ S_ab l) = 0 := by
        simp [pointRecFormalU, hl0]
      refine ⟨hU0, ?_⟩
      have hX_mem : ∀ (i : Fin 2) (d : Fin 2 →₀ ℕ),
          MvPowerSeries.coeff d (MvPowerSeries.X i : MvPowerSeries (Fin 2) ℂ) ∈ K := by
        intro i d
        rw [MvPowerSeries.coeff_X]
        split_ifs
        · exact K.one_mem
        · exact K.zero_mem
      have hX01_mem : ∀ d : Fin 2 →₀ ℕ,
          MvPowerSeries.coeff d (MvPowerSeries.X 0 + MvPowerSeries.X 1 : MvPowerSeries (Fin 2) ℂ) ∈ K :=
        fun d => by rw [map_add]; exact K.add_mem (hX_mem 0 d) (hX_mem 1 d)
      have hmon_mem_K : ∀ (a b : ℕ) (d : Fin 2 →₀ ℕ),
          MvPowerSeries.coeff d
            ((MvPowerSeries.X 0 : MvPowerSeries (Fin 2) ℂ) ^ a *
              (MvPowerSeries.X 0 + MvPowerSeries.X 1) ^ b) ∈ K := by
        intro a b d
        rw [MvPowerSeries.coeff_mul]
        exact K.sum_mem fun p _ => K.mul_mem
          (h_coeffs_mem_pow K _ (hX_mem 0) a p.1)
          (h_coeffs_mem_pow K _ hX01_mem b p.2)
      have hK_fix : ∀ x ∈ K, pointRecLiftArcFn F Φ x = PowerSeries.C x := by
        intro x hx
        dsimp only [pointRecLiftArcFn]
        rw [dif_pos (hKF hx), hΦ_K x hx]
      ext d
      let N := d 0 + d 1
      change PowerSeries.coeff l (pointRecLiftArcFn F Φ
          (∑ a ∈ Finset.range (N + 1), ∑ b ∈ Finset.range (N + 1),
            MvPowerSeries.coeff (Finsupp.single 0 a + Finsupp.single 1 b) S_ab *
              MvPowerSeries.coeff d
                ((MvPowerSeries.X 0) ^ a * (MvPowerSeries.X 0 + MvPowerSeries.X 1) ^ b))) =
        MvPowerSeries.coeff d (compPowerSeries2D (pointRecFormalU F Φ S_ab l) (MvPowerSeries.X 0)) +
          MvPowerSeries.coeff d (compPowerSeries2D (pointRecFormalV F Φ S_ab l)
            (MvPowerSeries.X 0 + MvPowerSeries.X 1))
      have h_outer_mem : ∀ a ∈ Finset.range (N + 1),
          (∑ b ∈ Finset.range (N + 1),
            MvPowerSeries.coeff (Finsupp.single 0 a + Finsupp.single 1 b) S_ab *
              MvPowerSeries.coeff d
                ((MvPowerSeries.X 0) ^ a * (MvPowerSeries.X 0 + MvPowerSeries.X 1) ^ b)) ∈ F := by
        intro a _
        exact F.sum_mem fun b _ => F.mul_mem (hS_F _) (hKF (hmon_mem_K a b d))
      have hsum_outer := h_lift_sum F Φ (Finset.range (N + 1))
        (fun a => ∑ b ∈ Finset.range (N + 1),
          MvPowerSeries.coeff (Finsupp.single 0 a + Finsupp.single 1 b) S_ab *
            MvPowerSeries.coeff d
              ((MvPowerSeries.X 0) ^ a * (MvPowerSeries.X 0 + MvPowerSeries.X 1) ^ b)) h_outer_mem
      rw [hsum_outer, map_sum]
      have h_row : ∀ a ∈ Finset.range (N + 1),
          PowerSeries.coeff l (pointRecLiftArcFn F Φ
            (∑ b ∈ Finset.range (N + 1),
              MvPowerSeries.coeff (Finsupp.single 0 a + Finsupp.single 1 b) S_ab *
                MvPowerSeries.coeff d
                  ((MvPowerSeries.X 0) ^ a * (MvPowerSeries.X 0 + MvPowerSeries.X 1) ^ b))) =
          if a = 0 then
            ∑ b ∈ Finset.range (N + 1),
              PowerSeries.coeff b (pointRecFormalV F Φ S_ab l) *
                MvPowerSeries.coeff d ((MvPowerSeries.X 0 + MvPowerSeries.X 1) ^ b)
          else
            PowerSeries.coeff a (pointRecFormalU F Φ S_ab l) *
              MvPowerSeries.coeff d ((MvPowerSeries.X 0) ^ a) := by
        intro a _
        have hsum_inner := h_lift_sum F Φ (Finset.range (N + 1))
          (fun b => MvPowerSeries.coeff (Finsupp.single 0 a + Finsupp.single 1 b) S_ab *
            MvPowerSeries.coeff d
              ((MvPowerSeries.X 0) ^ a * (MvPowerSeries.X 0 + MvPowerSeries.X 1) ^ b))
          (fun b _ => F.mul_mem (hS_F _) (hKF (hmon_mem_K a b d)))
        rw [hsum_inner, map_sum]
        split_ifs with ha0
        · subst ha0
          apply Finset.sum_congr rfl
          intro b _
          rw [Finsupp.single_zero, zero_add, pow_zero, one_mul,
            h_lift_mul F Φ (hS_F _) (hKF (hmon_mem_K 0 b d) |> fun _ =>
              h_coeffs_mem_pow F _ (fun q => hKF (hX01_mem q)) b d),
            hK_fix _ (h_coeffs_mem_pow K _ hX01_mem b d), PowerSeries.coeff_mul_C]
          simp [pointRecFormalV, hl0]
        · rw [Finset.sum_eq_single 0]
          · rw [Finsupp.single_zero, add_zero, pow_zero, mul_one,
              h_lift_mul F Φ (hS_F _) (h_coeffs_mem_pow F _ (fun q => hKF (hX_mem 0 q)) a d),
              hK_fix _ (h_coeffs_mem_pow K _ (hX_mem 0) a d), PowerSeries.coeff_mul_C]
            simp [pointRecFormalU, hl0, ha0]
          · intro b _ hb0
            let e_ab : Fin 2 →₀ ℕ := Finsupp.single 0 a + Finsupp.single 1 b
            have h10 : 1 ≤ e_ab 0 := by simp [e_ab]; omega
            have h11 : 1 ≤ e_ab 1 := by simp [e_ab]; omega
            have hSab_K := hS_mix e_ab h10 h11
            change PowerSeries.coeff l (pointRecLiftArcFn F Φ
              (MvPowerSeries.coeff e_ab S_ab * _)) = 0
            rw [h_lift_mul F Φ (hKF hSab_K) (hKF (hmon_mem_K a b d)),
              hK_fix _ hSab_K, hK_fix _ (hmon_mem_K a b d), ← map_mul,
              PowerSeries.coeff_C, if_neg hl0]
          · intro h0
            exact False.elim (h0 (Finset.mem_range.mpr (by omega)))
      rw [Finset.sum_congr rfl h_row, Finset.sum_ite]
      have hfilt0 : (Finset.range (N + 1)).filter (fun a => a = 0) = {0} := by
        ext a; simp only [Finset.mem_filter, Finset.mem_range, Finset.mem_singleton]; omega
      rw [hfilt0, Finset.sum_singleton]
      have hU_sum :
          (∑ x ∈ (Finset.range (N + 1)).filter (fun a => ¬a = 0),
            PowerSeries.coeff x (pointRecFormalU F Φ S_ab l) *
              MvPowerSeries.coeff d ((MvPowerSeries.X 0) ^ x)) =
          ∑ x ∈ Finset.range (N + 1),
            PowerSeries.coeff x (pointRecFormalU F Φ S_ab l) *
              MvPowerSeries.coeff d ((MvPowerSeries.X 0) ^ x) := by
        refine Finset.sum_subset (Finset.filter_subset _ _) ?_
        intro x hx hnot
        rw [Finset.mem_filter] at hnot
        have hx0 : x = 0 := by tauto
        subst hx0
        rw [hU0, zero_mul]
      rw [hU_sum, add_comm]
      rfl
    exact ⟨h_jet_zero, h_jet_deriv, h_jet_zero_shift, h_lift_props, h_mv_ring, h_recenter, h_ab_split⟩
  have hSplit : PointRecTopSplitToolkit := by
    clear Ω C B k hk G a₁ δ₁ ha₁ hδ₁ E hAlg hJet hNonAlg hSqrt hLift
    rcases hLaws with ⟨hS0, hI0, hS_sq, hSI⟩
    let S := pointArcPsSqrt1p
    let I := pointArcPsInvSqrt1p
    have hIS : I * S = 1 := mul_comm S I ▸ hSI
    have hdS : PowerSeries.derivative S = PowerSeries.C (1 / 2 : ℂ) * I := by
      have hSS : S * S = 1 + PowerSeries.X := by simpa [S, sq] using hS_sq
      have hdSS := congr_arg (fun f : PowerSeries ℂ => PowerSeries.derivative f) hSS
      rw [Derivation.leibniz, map_add, PowerSeries.derivative_one, PowerSeries.derivative_X,
        zero_add] at hdSS
      simp only [smul_eq_mul] at hdSS
      have hc2 : PowerSeries.C (1 / 2 : ℂ) + PowerSeries.C (1 / 2 : ℂ) = 1 := by
        rw [← map_add]; norm_num
      calc PowerSeries.derivative S
          = (PowerSeries.C (1 / 2 : ℂ) + PowerSeries.C (1 / 2 : ℂ)) *
              (I * S) * PowerSeries.derivative S := by rw [hc2, hIS, one_mul, one_mul]
        _ = PowerSeries.C (1 / 2 : ℂ) * I *
              (S * PowerSeries.derivative S + S * PowerSeries.derivative S) := by ring
        _ = PowerSeries.C (1 / 2 : ℂ) * I * 1 := by rw [hdSS]
        _ = PowerSeries.C (1 / 2 : ℂ) * I := mul_one _
    have hdI : PowerSeries.derivative I = PowerSeries.C (-1 / 2 : ℂ) * I ^ 3 := by
      have hdSI : PowerSeries.derivative (S * I) = PowerSeries.derivative (1 : PowerSeries ℂ) :=
        congr_arg (fun f : PowerSeries ℂ => PowerSeries.derivative f) hSI
      rw [Derivation.leibniz, PowerSeries.derivative_one] at hdSI
      simp only [smul_eq_mul] at hdSI
      have hc_neg : -PowerSeries.C (1 / 2 : ℂ) = PowerSeries.C (-1 / 2 : ℂ) := by
        rw [← map_neg]; norm_num
      calc PowerSeries.derivative I
          = (I * S) * PowerSeries.derivative I := by rw [hIS, one_mul]
        _ = I * (S * PowerSeries.derivative I + I * PowerSeries.derivative S) -
              I ^ 2 * PowerSeries.derivative S := by ring
        _ = I * 0 - I ^ 2 * (PowerSeries.C (1 / 2 : ℂ) * I) := by rw [hdSI, hdS]
        _ = (-PowerSeries.C (1 / 2 : ℂ)) * I ^ 3 := by ring
        _ = PowerSeries.C (-1 / 2 : ℂ) * I ^ 3 := by rw [hc_neg]
    let IsEpsConst : MvPowerSeries (Fin 2) (PowerSeries ℂ) → Prop :=
      fun W => ∀ (d : Fin 2 →₀ ℕ) (m : ℕ), 1 ≤ m →
        PowerSeries.coeff m (MvPowerSeries.coeff d W) = 0
    have hEC_C : ∀ c : ℂ, IsEpsConst (MvPowerSeries.C (PowerSeries.C c)) := by
      intro c d m hm1
      rw [MvPowerSeries.coeff_C]
      split_ifs
      · rw [PowerSeries.coeff_C, if_neg (by omega)]
      · rw [map_zero]
    have hEC_add : ∀ {A B}, IsEpsConst A → IsEpsConst B → IsEpsConst (A + B) := by
      intro A B hA hB d m hm1
      rw [map_add, map_add, hA d m hm1, hB d m hm1, add_zero]
    have hEC_sub : ∀ {A B}, IsEpsConst A → IsEpsConst B → IsEpsConst (A - B) := by
      intro A B hA hB d m hm1
      rw [map_sub, map_sub, hA d m hm1, hB d m hm1, sub_zero]
    have hEC_mul : ∀ {A B}, IsEpsConst A → IsEpsConst B → IsEpsConst (A * B) := by
      intro A B hA hB d m hm1
      rw [MvPowerSeries.coeff_mul, map_sum]
      apply Finset.sum_eq_zero
      intro p _
      rw [PowerSeries.coeff_mul]
      apply Finset.sum_eq_zero
      intro q hq
      have hq_eq : q.1 + q.2 = m := Finset.HasAntidiagonal.mem_antidiagonal.mp hq
      by_cases hq1 : 1 ≤ q.1
      · rw [hA p.1 q.1 hq1, zero_mul]
      · rw [hB p.2 q.2 (by omega), mul_zero]
    have hEC_pow : ∀ {A} (n : ℕ), IsEpsConst A → IsEpsConst (A ^ n) := by
      intro A n hA
      induction n with
      | zero =>
          rw [pow_zero]
          have h1 : (1 : MvPowerSeries (Fin 2) (PowerSeries ℂ)) =
              MvPowerSeries.C (PowerSeries.C 1) := by rw [map_one, map_one]
          rw [h1]
          exact hEC_C 1
      | succ n ih => rw [pow_succ]; exact hEC_mul ih hA
    have hEC_sum : ∀ {ι : Type} (s : Finset ι) (F : ι → MvPowerSeries (Fin 2) (PowerSeries ℂ)),
        (∀ i ∈ s, IsEpsConst (F i)) → IsEpsConst (∑ i ∈ s, F i) := by
      intro ι s F hF d m hm1
      rw [map_sum, map_sum]
      exact Finset.sum_eq_zero fun i hi => hF i hi d m hm1
    have hEC_comp : ∀ (g_seq : ℕ → PowerSeries ℂ) {Z},
        (∀ l, 1 ≤ l → g_seq l = 0) → IsEpsConst Z → IsEpsConst (pointArcComp2D1D g_seq Z) := by
      intro g_seq Z hg hZ d m hm1
      have hdef : MvPowerSeries.coeff d (pointArcComp2D1D g_seq Z) =
          PowerSeries.mk (fun m' =>
            PowerSeries.coeff m'
              (MvPowerSeries.coeff d
                (∑ n ∈ Finset.range (d 0 + d 1 + m' + 1),
                  MvPowerSeries.C (PowerSeries.mk (fun l => PowerSeries.coeff n (g_seq l))) *
                    Z ^ n))) := rfl
      rw [hdef, PowerSeries.coeff_mk]
      refine hEC_sum _ _ ?_ d m hm1
      intro n _
      refine hEC_mul ?_ (hEC_pow n hZ)
      intro d' m' hm'1
      rw [MvPowerSeries.coeff_C]
      split_ifs
      · rw [PowerSeries.coeff_mk, hg m' hm'1, map_zero]
      · rw [map_zero]
    have h_slice_pos_zero :
        ∀ {k : ℕ} (ℓ_star : Fin k → ℂ) (x_star : Fin (k + 1) → ℂ)
          (f_seq : Fin (k + 1) → ℕ → PowerSeries ℂ)
          (β_seq : ℕ → Fin (k + 1) → MvPowerSeries (Fin 2) ℂ)
          (m : ℕ),
          1 ≤ m →
          (∀ (r : Fin (k + 1)) (l : ℕ), 1 ≤ l → f_seq r l = 0) →
          (∀ (l : ℕ) (r : Fin (k + 1)), 1 ≤ l → β_seq l r = 0) →
          pointArcSlice2D1D m (pointArcFormalLen2D1D ℓ_star x_star f_seq β_seq) = 0 ∧
          ∀ r : Fin (k - 1),
            pointArcSlice2D1D m (pointArcFormalGrad2D1D ℓ_star x_star f_seq β_seq r) = 0 := by
      intro k ℓ_star x_star f_seq β_seq m hm1 hf0 hβ0
      have hAbsc : ∀ r : Fin (k + 1), IsEpsConst (pointArcFormalAbscissa2D1D β_seq r) := by
        intro r d l hl1
        change PowerSeries.coeff l (PowerSeries.mk (fun l' => MvPowerSeries.coeff d (β_seq l' r))) = 0
        rw [PowerSeries.coeff_mk, hβ0 l r hl1, map_zero]
      have hDx : ∀ i : Fin k, IsEpsConst (pointArcFormalDx2D1D x_star β_seq i) :=
        fun i => hEC_add (hEC_C _) (hEC_sub (hAbsc i.succ) (hAbsc i.castSucc))
      have hDy : ∀ i : Fin k, IsEpsConst (pointArcFormalDy2D1D f_seq β_seq i) :=
        fun i => hEC_sub (hEC_comp _ (hf0 i.succ) (hAbsc i.succ))
          (hEC_comp _ (hf0 i.castSucc) (hAbsc i.castSucc))
      have hRel : ∀ i : Fin k, IsEpsConst (pointArcFormalEdgeRel2D1D ℓ_star x_star f_seq β_seq i) :=
        fun i => hEC_mul
          (hEC_sub (hEC_add (hEC_pow 2 (hDx i)) (hEC_pow 2 (hDy i))) (hEC_C _)) (hEC_C _)
      have hConstSeq : ∀ φ : PowerSeries ℂ, ∀ l : ℕ, 1 ≤ l →
          (if l = 0 then φ else 0) = 0 := fun φ l hl1 => if_neg (by omega)
      have hLen : IsEpsConst (pointArcFormalLen2D1D ℓ_star x_star f_seq β_seq) :=
        hEC_sum _ _ fun i _ => hEC_mul (hEC_C _) (hEC_comp _ (hConstSeq S) (hRel i))
      have hInvLen : ∀ i : Fin k,
          IsEpsConst (pointArcFormalInvEdgeLen2D1D ℓ_star x_star f_seq β_seq i) :=
        fun i => hEC_mul (hEC_C _) (hEC_comp _ (hConstSeq I) (hRel i))
      have hdf0 : ∀ (u : Fin (k + 1)) (l : ℕ), 1 ≤ l →
          PowerSeries.derivative (f_seq u l) = 0 := by
        intro u l hl1; rw [hf0 u l hl1, map_zero]
      refine ⟨?_, ?_⟩
      · ext d; exact hLen d m hm1
      · intro r; ext d
        refine hEC_sub ?_ ?_ d m hm1
        · exact hEC_mul
            (hEC_add (hDx _) (hEC_mul (hDy _) (hEC_comp _ (hdf0 _) (hAbsc _))))
            (hInvLen _)
        · exact hEC_mul
            (hEC_add (hDx _) (hEC_mul (hDy _) (hEC_comp _ (hdf0 _) (hAbsc _))))
            (hInvLen _)
    let ι₀ : MvPowerSeries (Fin 2) ℂ → MvPowerSeries (Fin 2) (PowerSeries ℂ) :=
      fun Φ d => PowerSeries.C (MvPowerSeries.coeff d Φ)
    let X_ε : MvPowerSeries (Fin 2) (PowerSeries ℂ) := MvPowerSeries.C PowerSeries.X
    let VanishesEps : ℕ → MvPowerSeries (Fin 2) (PowerSeries ℂ) → Prop :=
      fun k W => ∀ l < k, pointArcSlice2D1D l W = 0
    let ModEq : ℕ → MvPowerSeries (Fin 2) (PowerSeries ℂ) →
        MvPowerSeries (Fin 2) (PowerSeries ℂ) → Prop :=
      fun j A B => VanishesEps (j + 1) (A - B)
    have hSlice_zero_iff : ∀ (l : ℕ) (W : MvPowerSeries (Fin 2) (PowerSeries ℂ)),
        pointArcSlice2D1D l W = 0 ↔
          ∀ d : Fin 2 →₀ ℕ, PowerSeries.coeff l (MvPowerSeries.coeff d W) = 0 := by
      intro l W
      refine ⟨fun h d => ?_, fun h => ?_⟩
      · have hd := congr_arg (MvPowerSeries.coeff d) h
        rw [map_zero] at hd
        exact hd
      · ext d
        rw [map_zero]
        exact h d
    have hVE_zero : ∀ k, VanishesEps k 0 := by
      intro k l _; ext d; exact map_zero _
    have hVE_mono : ∀ {a b W}, a ≤ b → VanishesEps b W → VanishesEps a W :=
      fun hab hW l hl => hW l (lt_of_lt_of_le hl hab)
    have hVE_add : ∀ {k A B}, VanishesEps k A → VanishesEps k B → VanishesEps k (A + B) := by
      intro k A B hA hB l hl; ext d
      change PowerSeries.coeff l (MvPowerSeries.coeff d (A + B)) = 0
      have hAd := congr_arg (MvPowerSeries.coeff d) (hA l hl)
      have hBd := congr_arg (MvPowerSeries.coeff d) (hB l hl)
      rw [map_add, map_add]
      change PowerSeries.coeff l (MvPowerSeries.coeff d A) +
        PowerSeries.coeff l (MvPowerSeries.coeff d B) = 0
      simp only [map_zero] at hAd hBd
      rw [show PowerSeries.coeff l (MvPowerSeries.coeff d A) = 0 from hAd,
        show PowerSeries.coeff l (MvPowerSeries.coeff d B) = 0 from hBd, add_zero]
    have hVE_neg : ∀ {k A}, VanishesEps k A → VanishesEps k (-A) := by
      intro k A hA l hl; ext d
      have hAd := congr_arg (MvPowerSeries.coeff d) (hA l hl)
      change PowerSeries.coeff l (MvPowerSeries.coeff d (-A)) = 0
      rw [map_neg, map_neg, show PowerSeries.coeff l (MvPowerSeries.coeff d A) = 0 from hAd, neg_zero]
    have hVE_mul : ∀ {a b A B}, VanishesEps a A → VanishesEps b B →
        VanishesEps (a + b) (A * B) := by
      intro a b A B hA hB l hl; ext d
      change PowerSeries.coeff l (MvPowerSeries.coeff d (A * B)) = 0
      rw [MvPowerSeries.coeff_mul, map_sum]
      apply Finset.sum_eq_zero
      intro p _
      rw [PowerSeries.coeff_mul]
      apply Finset.sum_eq_zero
      intro q hq
      have hq_eq : q.1 + q.2 = l := Finset.HasAntidiagonal.mem_antidiagonal.mp hq
      by_cases h1 : q.1 < a
      · have h0 : PowerSeries.coeff q.1 (MvPowerSeries.coeff p.1 A) = 0 :=
          congr_arg (MvPowerSeries.coeff p.1) (hA q.1 h1)
        rw [h0, zero_mul]
      · have h0 : PowerSeries.coeff q.2 (MvPowerSeries.coeff p.2 B) = 0 :=
          congr_arg (MvPowerSeries.coeff p.2) (hB q.2 (by omega))
        rw [h0, mul_zero]
    have hVE_mul_any : ∀ {a A} (B : MvPowerSeries (Fin 2) (PowerSeries ℂ)),
        VanishesEps a A → VanishesEps a (A * B) := by
      intro a A B hA
      simpa only [add_zero] using hVE_mul hA (fun l hl => False.elim (Nat.not_lt_zero l hl))
    have hVE_X_pow : ∀ r : ℕ, VanishesEps r (X_ε ^ r) := by
      intro r
      induction r with
      | zero => intro l hl; omega
      | succ r ih =>
          rw [pow_succ']
          have hX1 : VanishesEps 1 X_ε := by
            intro l hl
            have hl0 : l = 0 := by omega
            subst hl0; ext d
            change PowerSeries.coeff 0 (MvPowerSeries.coeff d (MvPowerSeries.C PowerSeries.X)) = 0
            rw [MvPowerSeries.coeff_C]
            split_ifs <;> simp
          simpa only [Nat.add_comm 1 r] using hVE_mul hX1 ih
    have hMod_refl : ∀ j A, ModEq j A A := fun j A => by simpa [ModEq] using hVE_zero (j + 1)
    have hMod_symm : ∀ {j A B}, ModEq j A B → ModEq j B A := by
      intro j A B h
      simpa only [ModEq, neg_sub] using hVE_neg h
    have hMod_trans : ∀ {j A B C}, ModEq j A B → ModEq j B C → ModEq j A C := by
      intro j A B C h1 h2
      have hsum := hVE_add h1 h2
      have heq : (A - B) + (B - C) = A - C := by abel
      rwa [heq] at hsum
    have hMod_add : ∀ {j A₁ A₂ B₁ B₂}, ModEq j A₁ A₂ → ModEq j B₁ B₂ →
        ModEq j (A₁ + B₁) (A₂ + B₂) := by
      intro j A₁ A₂ B₁ B₂ hA hB
      have hsum := hVE_add hA hB
      have heq : (A₁ - A₂) + (B₁ - B₂) = (A₁ + B₁) - (A₂ + B₂) := by abel
      rwa [heq] at hsum
    have hMod_sub : ∀ {j A₁ A₂ B₁ B₂}, ModEq j A₁ A₂ → ModEq j B₁ B₂ →
        ModEq j (A₁ - B₁) (A₂ - B₂) := by
      intro j A₁ A₂ B₁ B₂ hA hB
      have hsum := hVE_add hA (hVE_neg hB)
      have heq : (A₁ - A₂) + -(B₁ - B₂) = (A₁ - B₁) - (A₂ - B₂) := by abel
      rwa [heq] at hsum
    have hMod_mul : ∀ {j A₁ A₂ B₁ B₂}, ModEq j A₁ A₂ → ModEq j B₁ B₂ →
        ModEq j (A₁ * B₁) (A₂ * B₂) := by
      intro j A₁ A₂ B₁ B₂ hA hB
      have h1 : VanishesEps (j + 1) ((A₁ - A₂) * B₁) := hVE_mul_any B₁ hA
      have h2 : VanishesEps (j + 1) (A₂ * (B₁ - B₂)) := by
        rw [mul_comm]; exact hVE_mul_any A₂ hB
      have hsum := hVE_add h1 h2
      have heq : (A₁ - A₂) * B₁ + A₂ * (B₁ - B₂) = A₁ * B₁ - A₂ * B₂ := by ring
      rwa [heq] at hsum
    have hMod_sq : ∀ {j A₁ A₂}, ModEq j A₁ A₂ → ModEq j (A₁ ^ 2) (A₂ ^ 2) := by
      intro j A₁ A₂ hA
      rw [sq, sq]
      exact hMod_mul hA hA
    have hMod_sum : ∀ {ι : Type} (j : ℕ) (s : Finset ι)
        (F₁ F₂ : ι → MvPowerSeries (Fin 2) (PowerSeries ℂ)),
        (∀ i ∈ s, ModEq j (F₁ i) (F₂ i)) → ModEq j (∑ i ∈ s, F₁ i) (∑ i ∈ s, F₂ i) := by
      intro ι j s F₁ F₂ hF
      classical
      induction s using Finset.induction_on with
      | empty => simpa using hMod_refl j 0
      | @insert a s ha ih =>
          rw [Finset.sum_insert ha, Finset.sum_insert ha]
          exact hMod_add (hF a (Finset.mem_insert_self a s))
            (ih fun i hi => hF i (Finset.mem_insert_of_mem hi))
    have hι_add : ∀ A B, ι₀ (A + B) = ι₀ A + ι₀ B := by
      intro A B; ext d m
      have h1 : MvPowerSeries.coeff d (ι₀ (A + B)) =
          PowerSeries.C (MvPowerSeries.coeff d (A + B)) := rfl
      rw [h1, map_add, map_add, map_add]; rfl
    have hι_sub : ∀ A B, ι₀ (A - B) = ι₀ A - ι₀ B := by
      intro A B; ext d m
      have h1 : MvPowerSeries.coeff d (ι₀ (A - B)) =
          PowerSeries.C (MvPowerSeries.coeff d (A - B)) := rfl
      rw [h1, map_sub, map_sub, map_sub]; rfl
    have hι_mul : ∀ A B, ι₀ (A * B) = ι₀ A * ι₀ B := by
      intro A B; ext d m
      have h1 : MvPowerSeries.coeff d (ι₀ (A * B)) =
          PowerSeries.C (MvPowerSeries.coeff d (A * B)) := rfl
      rw [h1, MvPowerSeries.coeff_mul, MvPowerSeries.coeff_mul, map_sum, map_sum, map_sum]
      apply Finset.sum_congr rfl; intro p _
      change PowerSeries.coeff m (PowerSeries.C _) =
        PowerSeries.coeff m (PowerSeries.C _ * PowerSeries.C _)
      rw [← map_mul]
    have hι_C : ∀ c : ℂ, ι₀ (MvPowerSeries.C c) = MvPowerSeries.C (PowerSeries.C c) := by
      intro c; ext d m
      have h1 : MvPowerSeries.coeff d (ι₀ (MvPowerSeries.C c)) =
          PowerSeries.C (MvPowerSeries.coeff d (MvPowerSeries.C c)) := rfl
      rw [h1, MvPowerSeries.coeff_C, MvPowerSeries.coeff_C]
      split_ifs <;> simp
    have hι_pow : ∀ A n, ι₀ (A ^ n) = (ι₀ A) ^ n := by
      intro A n
      induction n with
      | zero =>
          rw [pow_zero, pow_zero]
          have h1 : (1 : MvPowerSeries (Fin 2) ℂ) = MvPowerSeries.C 1 := rfl
          rw [h1, hι_C 1, map_one, map_one]
      | succ n ih => rw [pow_succ, pow_succ, hι_mul, ih]
    have hι_sum : ∀ {ι : Type} (s : Finset ι) (F : ι → MvPowerSeries (Fin 2) ℂ),
        ι₀ (∑ i ∈ s, F i) = ∑ i ∈ s, ι₀ (F i) := by
      intro ι s F
      classical
      induction s using Finset.induction_on with
      | empty => simpa using hι_C 0
      | @insert a s ha ih => rw [Finset.sum_insert ha, Finset.sum_insert ha, hι_add, ih]
    have hslice0_add : ∀ A B, pointArcSlice2D1D 0 (A + B) =
        pointArcSlice2D1D 0 A + pointArcSlice2D1D 0 B := by
      intro A B; ext d
      rw [map_add]
      change PowerSeries.coeff 0 (MvPowerSeries.coeff d (A + B)) = _
      rw [map_add, map_add]; rfl
    have hslice0_sub : ∀ A B, pointArcSlice2D1D 0 (A - B) =
        pointArcSlice2D1D 0 A - pointArcSlice2D1D 0 B := by
      intro A B; ext d
      rw [map_sub]
      change PowerSeries.coeff 0 (MvPowerSeries.coeff d (A - B)) = _
      rw [map_sub, map_sub]; rfl
    have hslice0_mul : ∀ A B, pointArcSlice2D1D 0 (A * B) =
        pointArcSlice2D1D 0 A * pointArcSlice2D1D 0 B := by
      intro A B; ext d
      change PowerSeries.coeff 0 (MvPowerSeries.coeff d (A * B)) = _
      rw [MvPowerSeries.coeff_mul, MvPowerSeries.coeff_mul, map_sum]
      apply Finset.sum_congr rfl; intro p _
      rw [PowerSeries.coeff_zero_eq_constantCoeff, map_mul,
        ← PowerSeries.coeff_zero_eq_constantCoeff]
      rfl
    have hslice0_pow : ∀ A n, pointArcSlice2D1D 0 (A ^ n) = (pointArcSlice2D1D 0 A) ^ n := by
      intro A n
      induction n with
      | zero =>
          ext d
          change PowerSeries.coeff 0 (MvPowerSeries.coeff d 1) = MvPowerSeries.coeff d 1
          rw [MvPowerSeries.coeff_one, MvPowerSeries.coeff_one]
          split_ifs <;> simp
      | succ n ih => rw [pow_succ, pow_succ, hslice0_mul, ih]
    have hslice0_C : ∀ c : ℂ,
        pointArcSlice2D1D 0 (MvPowerSeries.C (PowerSeries.C c)) = MvPowerSeries.C c := by
      intro c; ext d
      change PowerSeries.coeff 0 (MvPowerSeries.coeff d (MvPowerSeries.C (PowerSeries.C c))) = _
      rw [MvPowerSeries.coeff_C, MvPowerSeries.coeff_C]
      split_ifs <;> simp
    have hMod_mul_vanish : ∀ {j : ℕ} (A T : MvPowerSeries (Fin 2) (PowerSeries ℂ)),
        VanishesEps j T → ModEq j (A * T) (ι₀ (pointArcSlice2D1D 0 A) * T) := by
      intro j A T hT
      have hA0 : VanishesEps 1 (A - ι₀ (pointArcSlice2D1D 0 A)) := by
        intro l hl
        have hl0 : l = 0 := by omega
        subst hl0; ext d
        rw [map_zero]
        change PowerSeries.coeff 0 (MvPowerSeries.coeff d (A - ι₀ (pointArcSlice2D1D 0 A))) = 0
        rw [map_sub, map_sub]
        have h0 : MvPowerSeries.coeff d (ι₀ (pointArcSlice2D1D 0 A)) =
            PowerSeries.C (PowerSeries.coeff 0 (MvPowerSeries.coeff d A)) := rfl
        rw [h0, PowerSeries.coeff_C, if_pos rfl, sub_self]
      have hprod : VanishesEps (j + 1) ((A - ι₀ (pointArcSlice2D1D 0 A)) * T) := by
        simpa only [Nat.add_comm 1 j] using hVE_mul hA0 hT
      have heq : (A - ι₀ (pointArcSlice2D1D 0 A)) * T =
          A * T - ι₀ (pointArcSlice2D1D 0 A) * T := sub_mul _ _ _
      rwa [heq] at hprod
    have hSlice_top_extract : ∀ {j : ℕ} {A B : MvPowerSeries (Fin 2) (PowerSeries ℂ)}
        {Δ : MvPowerSeries (Fin 2) ℂ},
        ModEq j A (B + X_ε ^ j * ι₀ Δ) →
        pointArcSlice2D1D j A = pointArcSlice2D1D j B + Δ := by
      intro j A B Δ hMod
      ext d
      have hd := congr_arg (MvPowerSeries.coeff d) (hMod j (Nat.lt_succ_self j))
      rw [map_zero] at hd
      change PowerSeries.coeff j (MvPowerSeries.coeff d (A - (B + X_ε ^ j * ι₀ Δ))) = 0 at hd
      rw [map_sub, map_sub, sub_eq_zero, map_add, map_add] at hd
      rw [map_add]
      change PowerSeries.coeff j (MvPowerSeries.coeff d A) =
        PowerSeries.coeff j (MvPowerSeries.coeff d B) + MvPowerSeries.coeff d Δ
      rw [hd]
      apply congr_arg₂ (· + ·) rfl
      dsimp only [X_ε]
      rw [← map_pow, MvPowerSeries.coeff_C_mul]
      have h0 : MvPowerSeries.coeff d (ι₀ Δ) = PowerSeries.C (MvPowerSeries.coeff d Δ) := rfl
      rw [h0]
      simpa [zero_add, PowerSeries.coeff_C] using
        PowerSeries.coeff_X_pow_mul (PowerSeries.C (MvPowerSeries.coeff d Δ)) j 0
    let VanishesBelow : ℕ → MvPowerSeries (Fin 2) (PowerSeries ℂ) → Prop :=
      fun k Z => ∀ (d : Fin 2 →₀ ℕ) (m : ℕ), d 0 + d 1 + m < k →
        PowerSeries.coeff m (MvPowerSeries.coeff d Z) = 0
    have hVB_of_slice0 : ∀ {Z : MvPowerSeries (Fin 2) (PowerSeries ℂ)},
        MvPowerSeries.coeff 0 (pointArcSlice2D1D 0 Z) = 0 → VanishesBelow 1 Z := by
      intro Z hZ0 d m hlt
      have hd_eq : d = 0 := by ext i; fin_cases i <;> simp <;> omega
      have hm0 : m = 0 := by omega
      subst hd_eq hm0
      exact hZ0
    have hVB_mul : ∀ {a b X Y}, VanishesBelow a X → VanishesBelow b Y →
        VanishesBelow (a + b) (X * Y) := by
      intro a b X Y hX hY d m hlt
      rw [MvPowerSeries.coeff_mul, map_sum]
      apply Finset.sum_eq_zero; intro p hp
      have hp_eq : p.1 + p.2 = d := Finset.HasAntidiagonal.mem_antidiagonal.mp hp
      have hp0 : p.1 0 + p.2 0 = d 0 := by rw [← Finsupp.add_apply, hp_eq]
      have hp1 : p.1 1 + p.2 1 = d 1 := by rw [← Finsupp.add_apply, hp_eq]
      rw [PowerSeries.coeff_mul]
      apply Finset.sum_eq_zero; intro q hq
      have hq_eq : q.1 + q.2 = m := Finset.HasAntidiagonal.mem_antidiagonal.mp hq
      by_cases h1 : p.1 0 + p.1 1 + q.1 < a
      · rw [hX p.1 q.1 h1, zero_mul]
      · rw [hY p.2 q.2 (by omega), mul_zero]
    have hVB_pow : ∀ {Z}, VanishesBelow 1 Z → ∀ n, VanishesBelow n (Z ^ n) := by
      intro Z hZ n
      induction n with
      | zero => intro d m h; omega
      | succ n ih => rw [pow_succ]; exact hVB_mul ih hZ
    have hVB2D_pow : ∀ {U₀ : MvPowerSeries (Fin 2) ℂ}, MvPowerSeries.coeff 0 U₀ = 0 →
        ∀ (n : ℕ) (d : Fin 2 →₀ ℕ), d 0 + d 1 < n → MvPowerSeries.coeff d (U₀ ^ n) = 0 := by
      intro U₀ hU0 n d hlt
      have hZ0 : MvPowerSeries.coeff 0 (pointArcSlice2D1D 0 (ι₀ U₀)) = 0 := by
        change PowerSeries.coeff 0 (PowerSeries.C (MvPowerSeries.coeff 0 U₀)) = 0
        rw [PowerSeries.coeff_C, if_pos rfl, hU0]
      have hZ : VanishesBelow 1 (ι₀ U₀) := hVB_of_slice0 hZ0
      have hpow := hVB_pow hZ n d 0 (by omega)
      rw [← hι_pow] at hpow
      have h0 : MvPowerSeries.coeff d (ι₀ (U₀ ^ n)) =
          PowerSeries.C (MvPowerSeries.coeff d (U₀ ^ n)) := rfl
      rw [h0, PowerSeries.coeff_C, if_pos rfl] at hpow
      exact hpow
    have hComp2D1D_trunc : ∀ (g_seq : ℕ → PowerSeries ℂ) {Z},
        VanishesBelow 1 Z → ∀ (d : Fin 2 →₀ ℕ) (m M : ℕ), d 0 + d 1 + m ≤ M →
        PowerSeries.coeff m (MvPowerSeries.coeff d (pointArcComp2D1D g_seq Z)) =
          PowerSeries.coeff m (MvPowerSeries.coeff d
            (∑ n ∈ Finset.range (M + 1),
              MvPowerSeries.C (PowerSeries.mk (fun l => PowerSeries.coeff n (g_seq l))) * Z ^ n)) := by
      intro g_seq Z hZ d m M hle
      have hdef : MvPowerSeries.coeff d (pointArcComp2D1D g_seq Z) =
          PowerSeries.mk (fun m' =>
            PowerSeries.coeff m'
              (MvPowerSeries.coeff d
                (∑ n ∈ Finset.range (d 0 + d 1 + m' + 1),
                  MvPowerSeries.C (PowerSeries.mk (fun l => PowerSeries.coeff n (g_seq l))) *
                    Z ^ n))) := rfl
      rw [hdef, PowerSeries.coeff_mk, map_sum, map_sum, map_sum, map_sum]
      refine Finset.sum_subset (Finset.range_mono (by omega)) ?_
      intro n _ hndm
      rw [Finset.mem_range] at hndm
      rw [MvPowerSeries.coeff_C_mul, PowerSeries.coeff_mul]
      apply Finset.sum_eq_zero; intro q hq
      have hq_eq : q.1 + q.2 = m := Finset.HasAntidiagonal.mem_antidiagonal.mp hq
      rw [hVB_pow hZ n d q.2 (by omega), mul_zero]
    have hslice0_comp2D1D : ∀ (g_seq : ℕ → PowerSeries ℂ) {Z},
        MvPowerSeries.coeff 0 (pointArcSlice2D1D 0 Z) = 0 →
        pointArcSlice2D1D 0 (pointArcComp2D1D g_seq Z) =
          compPowerSeries2D (g_seq 0) (pointArcSlice2D1D 0 Z) := by
      intro g_seq Z hZ0; ext d
      change PowerSeries.coeff 0 (MvPowerSeries.coeff d (pointArcComp2D1D g_seq Z)) =
        ∑ n ∈ Finset.range (d 0 + d 1 + 1),
          PowerSeries.coeff n (g_seq 0) * MvPowerSeries.coeff d ((pointArcSlice2D1D 0 Z) ^ n)
      rw [hComp2D1D_trunc g_seq (hVB_of_slice0 hZ0) d 0 (d 0 + d 1) (by omega),
        map_sum, map_sum]
      apply Finset.sum_congr rfl; intro n _
      rw [MvPowerSeries.coeff_C_mul, PowerSeries.coeff_zero_eq_constantCoeff, map_mul,
        ← PowerSeries.coeff_zero_eq_constantCoeff, PowerSeries.coeff_mk, ← hslice0_pow]
      rfl
    have hslice0_compConst : ∀ (φ : PowerSeries ℂ) {Z},
        MvPowerSeries.coeff 0 (pointArcSlice2D1D 0 Z) = 0 →
        pointArcSlice2D1D 0 (pointArcCompConst2D1D φ Z) =
          compPowerSeries2D φ (pointArcSlice2D1D 0 Z) := by
      intro φ Z hZ0
      exact hslice0_comp2D1D (fun l => if l = 0 then φ else 0) hZ0
    have hcomp2D_mul : ∀ (A B : PowerSeries ℂ) {U₀ : MvPowerSeries (Fin 2) ℂ},
        MvPowerSeries.coeff 0 U₀ = 0 →
        compPowerSeries2D (A * B) U₀ = compPowerSeries2D A U₀ * compPowerSeries2D B U₀ := by
      intro A B U₀ hU0
      ext d
      let N := d 0 + d 1
      have htrunc2D : ∀ (φ : PowerSeries ℂ) (d' : Fin 2 →₀ ℕ), d' 0 + d' 1 ≤ N →
          MvPowerSeries.coeff d' (compPowerSeries2D φ U₀) =
            MvPowerSeries.coeff d'
              (∑ n ∈ Finset.range (N + 1), MvPowerSeries.C (PowerSeries.coeff n φ) * U₀ ^ n) := by
        intro φ d' hd'
        change (∑ n ∈ Finset.range (d' 0 + d' 1 + 1), _) = _
        rw [map_sum]
        simp_rw [MvPowerSeries.coeff_C_mul]
        refine Finset.sum_subset (Finset.range_mono (by omega)) ?_
        intro n _ hnd'
        rw [Finset.mem_range] at hnd'
        rw [hVB2D_pow hU0 n d' (by omega), mul_zero]
      let P : PowerSeries ℂ → MvPowerSeries (Fin 2) ℂ := fun φ =>
        ∑ n ∈ Finset.range (N + 1), MvPowerSeries.C (PowerSeries.coeff n φ) * U₀ ^ n
      have hmul_P : MvPowerSeries.coeff d (compPowerSeries2D A U₀ * compPowerSeries2D B U₀) =
          MvPowerSeries.coeff d (P A * P B) := by
        rw [MvPowerSeries.coeff_mul, MvPowerSeries.coeff_mul]
        apply Finset.sum_congr rfl; intro p hp
        have hp_eq : p.1 + p.2 = d := Finset.HasAntidiagonal.mem_antidiagonal.mp hp
        have hp0 : p.1 0 + p.2 0 = d 0 := by rw [← Finsupp.add_apply, hp_eq]
        have hp1 : p.1 1 + p.2 1 = d 1 := by rw [← Finsupp.add_apply, hp_eq]
        rw [htrunc2D A p.1 (by omega), htrunc2D B p.2 (by omega)]
      rw [hmul_P, htrunc2D (A * B) d le_rfl]
      dsimp only [P]
      rw [Finset.sum_mul]; simp only [Finset.mul_sum]
      have hprod_term : ∀ a b : ℕ,
          (MvPowerSeries.C (PowerSeries.coeff a A) * U₀ ^ a) *
            (MvPowerSeries.C (PowerSeries.coeff b B) * U₀ ^ b) =
          MvPowerSeries.C (PowerSeries.coeff a A * PowerSeries.coeff b B) * U₀ ^ (a + b) := by
        intro a b; rw [pow_add, map_mul]; ring
      simp_rw [hprod_term]; rw [map_sum]; simp_rw [map_sum]
      let term : ℕ → ℕ → ℂ := fun a b =>
        MvPowerSeries.coeff d
          (MvPowerSeries.C (PowerSeries.coeff a A * PowerSeries.coeff b B) * U₀ ^ (a + b))
      symm
      calc (∑ a ∈ Finset.range (N + 1), ∑ b ∈ Finset.range (N + 1), term a b)
          = ∑ a ∈ Finset.range (N + 1), ∑ b ∈ Finset.range (N + 1),
              ∑ n ∈ Finset.range (N + 1), if n = a + b then term a b else 0 := by
            apply Finset.sum_congr rfl; intro a _; apply Finset.sum_congr rfl; intro b _
            rw [Finset.sum_ite_eq']
            split_ifs with hmem
            · rfl
            · rw [Finset.mem_range] at hmem
              dsimp only [term]
              rw [MvPowerSeries.coeff_C_mul, hVB2D_pow hU0 (a + b) d (by omega), mul_zero]
        _ = ∑ a ∈ Finset.range (N + 1), ∑ n ∈ Finset.range (N + 1),
              ∑ b ∈ Finset.range (N + 1), if n = a + b then term a b else 0 := by
            apply Finset.sum_congr rfl; intro a _; exact Finset.sum_comm
        _ = ∑ n ∈ Finset.range (N + 1), ∑ a ∈ Finset.range (N + 1),
              ∑ b ∈ Finset.range (N + 1), if n = a + b then term a b else 0 := Finset.sum_comm
        _ = ∑ n ∈ Finset.range (N + 1), ∑ a ∈ Finset.range (n + 1), term a (n - a) := by
            apply Finset.sum_congr rfl; intro n hn
            have hn_le : n ≤ N := Nat.lt_succ_iff.mp (Finset.mem_range.mp hn)
            have hinner : ∀ a ∈ Finset.range (N + 1),
                (∑ b ∈ Finset.range (N + 1), if n = a + b then term a b else 0) =
                  if a ≤ n then term a (n - a) else 0 := by
              intro a _
              split_ifs with han
              · rw [Finset.sum_eq_single (n - a)]
                · rw [if_pos (by omega)]
                · intro b _ _; rw [if_neg (by omega)]
                · intro hnot; exact False.elim (hnot (Finset.mem_range.mpr (by omega)))
              · apply Finset.sum_eq_zero; intro b _; rw [if_neg (by omega)]
            rw [Finset.sum_congr rfl hinner, ← Finset.sum_filter]
            have hfilt : (Finset.range (N + 1)).filter (fun a => a ≤ n) = Finset.range (n + 1) := by
              ext a; simp only [Finset.mem_filter, Finset.mem_range]; omega
            rw [hfilt]
        _ = _ := by
            apply Finset.sum_congr rfl; intro n _
            rw [PowerSeries.coeff_mul,
              Finset.Nat.sum_antidiagonal_eq_sum_range_succ
                (fun a b => PowerSeries.coeff a A * PowerSeries.coeff b B) n,
              MvPowerSeries.coeff_C_mul, Finset.sum_mul]
            apply Finset.sum_congr rfl; intro a ha
            have han : a + (n - a) = n := by have := Finset.mem_range.mp ha; omega
            dsimp only [term]; rw [han, MvPowerSeries.coeff_C_mul]
    have hcomp2D_C : ∀ (c : ℂ) (U₀ : MvPowerSeries (Fin 2) ℂ),
        compPowerSeries2D (PowerSeries.C c) U₀ = MvPowerSeries.C c := by
      intro c U₀; ext d
      change (∑ n ∈ Finset.range (d 0 + d 1 + 1), _) = _
      rw [Finset.sum_eq_single 0]
      · rw [PowerSeries.coeff_C, if_pos rfl, pow_zero, MvPowerSeries.coeff_C, MvPowerSeries.coeff_one]
        split_ifs <;> simp
      · intro n _ hn0; rw [PowerSeries.coeff_C, if_neg hn0, zero_mul]
      · intro h0; exact False.elim (h0 (Finset.mem_range.mpr (by omega)))
    have hcomp2D_SI : ∀ {U₀ : MvPowerSeries (Fin 2) ℂ}, MvPowerSeries.coeff 0 U₀ = 0 →
        compPowerSeries2D S U₀ * compPowerSeries2D I U₀ = 1 := by
      intro U₀ hU0
      rw [← hcomp2D_mul S I hU0, hSI, ← map_one PowerSeries.C, hcomp2D_C, map_one]
    have hMod_comp_trunc_seq : ∀ {j : ℕ} (g₁ g₂ : ℕ → PowerSeries ℂ)
        {Z₁ Z₂ : MvPowerSeries (Fin 2) (PowerSeries ℂ)},
        (∀ l ≤ j, g₁ l = g₂ l) → ModEq j Z₁ Z₂ →
        ModEq j (pointArcComp2D1D g₁ Z₁) (pointArcComp2D1D g₂ Z₂) := by
      intro j g₁ g₂ Z₁ Z₂ hg hZ
      have hstep1 : ModEq j (pointArcComp2D1D g₁ Z₁) (pointArcComp2D1D g₂ Z₁) := by
        intro l hl
        rw [hSlice_zero_iff]; intro d
        rw [map_sub, map_sub, sub_eq_zero]
        have hd1 : MvPowerSeries.coeff d (pointArcComp2D1D g₁ Z₁) =
            PowerSeries.mk (fun m =>
              PowerSeries.coeff m
                (MvPowerSeries.coeff d
                  (∑ n ∈ Finset.range (d 0 + d 1 + m + 1),
                    MvPowerSeries.C (PowerSeries.mk (fun l' => PowerSeries.coeff n (g₁ l'))) *
                      Z₁ ^ n))) := rfl
        have hd2 : MvPowerSeries.coeff d (pointArcComp2D1D g₂ Z₁) =
            PowerSeries.mk (fun m =>
              PowerSeries.coeff m
                (MvPowerSeries.coeff d
                  (∑ n ∈ Finset.range (d 0 + d 1 + m + 1),
                    MvPowerSeries.C (PowerSeries.mk (fun l' => PowerSeries.coeff n (g₂ l'))) *
                      Z₁ ^ n))) := rfl
        rw [hd1, hd2, PowerSeries.coeff_mk, PowerSeries.coeff_mk,
          map_sum, map_sum, map_sum, map_sum]
        apply Finset.sum_congr rfl; intro n _
        rw [MvPowerSeries.coeff_C_mul, MvPowerSeries.coeff_C_mul,
          PowerSeries.coeff_mul, PowerSeries.coeff_mul]
        apply Finset.sum_congr rfl; intro q hq
        have hq_eq : q.1 + q.2 = l := Finset.HasAntidiagonal.mem_antidiagonal.mp hq
        rw [PowerSeries.coeff_mk, PowerSeries.coeff_mk, hg q.1 (by omega)]
      refine hMod_trans hstep1 ?_
      intro l hl
      rw [hSlice_zero_iff]; intro d
      rw [map_sub, map_sub, sub_eq_zero]
      have hd1 : MvPowerSeries.coeff d (pointArcComp2D1D g₂ Z₁) =
          PowerSeries.mk (fun m =>
            PowerSeries.coeff m
              (MvPowerSeries.coeff d
                (∑ n ∈ Finset.range (d 0 + d 1 + m + 1),
                  MvPowerSeries.C (PowerSeries.mk (fun l' => PowerSeries.coeff n (g₂ l'))) *
                    Z₁ ^ n))) := rfl
      have hd2 : MvPowerSeries.coeff d (pointArcComp2D1D g₂ Z₂) =
          PowerSeries.mk (fun m =>
            PowerSeries.coeff m
              (MvPowerSeries.coeff d
                (∑ n ∈ Finset.range (d 0 + d 1 + m + 1),
                  MvPowerSeries.C (PowerSeries.mk (fun l' => PowerSeries.coeff n (g₂ l'))) *
