    have hμ_p : glancingMidAngle C (y + t / 2) t = (θ_0 + θ_p) / 2 := by
      unfold glancingMidAngle
      rw [show (y + t / 2) - t / 2 = y by ring, show (y + t / 2) + t / 2 = y + t by ring]
    have hpm : glancingImpact C (y - t / 2) t 0 * Complex.cos θ_0 +
        glancingImpact C (y - t / 2) t 1 * Complex.sin θ_0 = glancingOffset C y t := by
      simp only [glancingImpact, Matrix.cons_val_zero, Matrix.cons_val_one, hμ_m]
      rw [h_trig, show (θ_m + θ_0) / 2 - θ_0 = -((θ_0 - θ_m) / 2) by ring,
