        (∀ j : ℕ, j ≤ q → ∀ k : ℕ, k ≤ m + 2 → ∀ z ∈ horizStrip σ_mesh,
          (q : ℝ) ^ 2 * ‖iteratedDeriv k (fun ζ => d (n + 1) j ζ - d n j ζ) z‖ ≤
            (R_strip / 2) * (1 / 2 : ℝ) ^ n) ∧
        (∀ j : ℕ, j < q → ∀ k : ℕ, k ≤ m + 2 → ∀ z ∈ horizStrip σ_mesh,
          (q : ℝ) ^ 3 *
            ‖iteratedDeriv k
              (fun ζ => (d (n + 1) (j + 1) ζ - d (n + 1) j ζ) - (d n (j + 1) ζ - d n j ζ)) z‖ ≤
            (R_strip / 2) * (1 / 2 : ℝ) ^ n) := by
      intro n
      induction n with
      | zero =>
        simp only [pow_zero, mul_one]
        refine ⟨?_, ?_⟩
        · intro j hj k hk z hz
          have hEq : (fun ζ : ℂ => d 1 j ζ - d 0 j ζ) = d 1 j := by
