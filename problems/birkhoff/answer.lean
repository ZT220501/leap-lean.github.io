          _ = |δ| * ‖s₁‖ + |δ| * ‖s₂‖ := by simp
          _ ≤ δ * 1 + δ * 1 := by rw [abs_of_pos hδ]; gcongr
          _ < ρ := by dsimp [δ]; linarith
      let p_pp : ℂ := s₀ + (δ : ℂ) * 1 + (δ : ℂ) * Complex.I
      let p_np : ℂ := s₀ + (δ : ℂ) * (-1) + (δ : ℂ) * Complex.I
      let p_pn : ℂ := s₀ + (δ : ℂ) * 1 + (δ : ℂ) * (-Complex.I)
      have hp_pp_B : p_pp ∈ B := hnorm_δ 1 Complex.I (by simp) (by simp)
      have hp_np_B : p_np ∈ B := hnorm_δ (-1) Complex.I (by simp) (by simp)
      have hp_pn_B : p_pn ∈ B := hnorm_δ 1 (-Complex.I) (by simp) (by simp)
      have h12 : IsPreconnected (U_pos ∪ V_pos) :=
