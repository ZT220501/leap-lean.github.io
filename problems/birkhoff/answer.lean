      (∃ ζ ∈ Metric.ball z₀ R₀, d ζ ≠ 0) →
      ∃ (Q : Polynomial ℂ) (u : ℂ → ℂ),
        Q.Monic ∧ DifferentiableOn ℂ u (Metric.ball z₀ R₀) ∧
        (∀ ζ ∈ Metric.ball z₀ R₀, d ζ = Q.eval ζ * u ζ) ∧
        (∀ ζ ∈ Metric.closedBall z₀ (R₀ / 2), u ζ ≠ 0) := by
