          have hg₁_at : DifferentiableAt ℂ g₁ s₀ := hg₁_diff.differentiableAt (hU.mem_nhds hs₀_U)
          have hg₃_at : DifferentiableAt ℂ g₃ s₀ := hg₃_diff.differentiableAt (hU.mem_nhds hs₀_U)
          have hnum_at : DifferentiableAt ℂ (fun w => -g₃ w * (2 * a₀ + (w - s₀) ^ 2 * g₃ w)) s₀ :=
            (hg₃_at.neg).mul ((differentiableAt_const (2 * a₀)).add
              ((((differentiableAt_id).sub_const s₀).pow 2).mul hg₃_at))
          have hden_at : DifferentiableAt ℂ (fun w => a₀ ^ 2 * g₁ w ^ 2) s₀ :=
            (differentiableAt_const (a₀ ^ 2)).mul (hg₁_at.pow 2)
          have hden_ne : a₀ ^ 2 * g₁ s₀ ^ 2 ≠ 0 := by
            rw [hg₁_s₀]
            exact mul_ne_zero (pow_ne_zero 2 ha₀_ne) (pow_ne_zero 2 ha₀_ne)
          refine (hnum_at.div hden_at hden_ne).sub ?_
          refine DifferentiableAt.fun_sum fun z hz => ?_
          have hs₀_ne_z : s₀ - z ≠ 0 := sub_ne_zero.mpr (Finset.ne_of_mem_erase hz).symm
          exact (differentiableAt_const _).mul
            (((differentiableAt_id.sub_const z).inv hs₀_ne_z).pow 2)
        have h_nhds_g₁ : {w : ℂ | g₁ w ≠ 0} ∈ nhds s₀ := by
          have hg₁_cont : ContinuousAt g₁ s₀ :=
            hg₁_diff.continuousOn.continuousAt (hU.mem_nhds hs₀_U)
          have hg₁_ne0 : g₁ s₀ ≠ 0 := by rw [hg₁_s₀]; exact ha₀_ne
          exact hg₁_cont.preimage_mem_nhds (isOpen_compl_singleton.mem_nhds hg₁_ne0)
        have h_ev_G : G =ᶠ[nhds s₀] H_loc := by
          filter_upwards [h_nhds_g₁] with w hg₁_ne
          by_cases hw_eq : w = s₀
          · rw [hw_eq]
            dsimp [G, H_loc]
            simp only [hs₀_S, ↓reduceIte]
            congr 1
            change -2 * g₃ s₀ / a₀ ^ 3 =
              -g₃ s₀ * (2 * a₀ + (s₀ - s₀) ^ 2 * g₃ s₀) / (a₀ ^ 2 * g₁ s₀ ^ 2)
            rw [hg₁_s₀, div_eq_div_iff (pow_ne_zero 3 ha₀_ne)
              (mul_ne_zero (pow_ne_zero 2 ha₀_ne) (pow_ne_zero 2 ha₀_ne))]
            ring
          · have hsub_ne : w - s₀ ≠ 0 := sub_ne_zero.mpr hw_eq
            have hfw_ne : f w ≠ 0 := by
              rw [hf_eq w]
              exact mul_ne_zero hsub_ne hg₁_ne
            have hw_not_S : w ∉ S_int := fun hwS => hfw_ne ((hS_mem w).mp hwS).2
            dsimp [G, H_loc]
            simp only [hw_not_S, ↓reduceIte]
            rw [← Finset.add_sum_erase S_int _ hs₀_S]
            have h_frac : (f w)⁻¹ ^ 2 - a₀⁻¹ ^ 2 * (w - s₀)⁻¹ ^ 2 =
                -g₃ w * (2 * a₀ + (w - s₀) ^ 2 * g₃ w) / (a₀ ^ 2 * g₁ w ^ 2) := by
              have hden1 : f w ^ 2 ≠ 0 := pow_ne_zero 2 hfw_ne
              have hden2 : a₀ ^ 2 * (w - s₀) ^ 2 ≠ 0 :=
                mul_ne_zero (pow_ne_zero 2 ha₀_ne) (pow_ne_zero 2 hsub_ne)
              have hden3 : a₀ ^ 2 * g₁ w ^ 2 ≠ 0 :=
                mul_ne_zero (pow_ne_zero 2 ha₀_ne) (pow_ne_zero 2 hg₁_ne)
              have hlhs : (f w)⁻¹ ^ 2 - a₀⁻¹ ^ 2 * (w - s₀)⁻¹ ^ 2 =
                  (a₀ ^ 2 * (w - s₀) ^ 2 - f w ^ 2) / (f w ^ 2 * (a₀ ^ 2 * (w - s₀) ^ 2)) := by
                rw [inv_pow, inv_pow, inv_pow, ← mul_inv, inv_eq_one_div, inv_eq_one_div,
                  div_sub_div _ _ hden1 hden2]
                ring
              rw [hlhs, div_eq_div_iff (mul_ne_zero hden1 hden2) hden3, hf_eq w, hg₁_expand w]
              ring
            change (f w)⁻¹ ^ 2 - (a₀⁻¹ ^ 2 * (w - s₀)⁻¹ ^ 2 +
                ∑ z ∈ S_int.erase s₀, (deriv f z)⁻¹ ^ 2 * (w - z)⁻¹ ^ 2) = _
            rw [← sub_sub, h_frac]
        exact h_ev_G.differentiableAt_iff.mpr hH_loc_diffAt
      · have hfs₀_ne : f s₀ ≠ 0 := fun h0 => hs₀_S ((hS_mem s₀).mpr ⟨hs₀_box, h0⟩)
        let H_reg : ℂ → ℂ := fun w =>
          (f w)⁻¹ ^ 2 - ∑ z ∈ S_int, (deriv f z)⁻¹ ^ 2 * (w - z)⁻¹ ^ 2
        have hH_reg_diffAt : DifferentiableAt ℂ H_reg s₀ := by
          have hf_at : DifferentiableAt ℂ f s₀ := hf.differentiableAt (hU.mem_nhds hs₀_U)
          refine ((hf_at.inv hfs₀_ne).pow 2).sub ?_
          refine DifferentiableAt.fun_sum fun z hz => ?_
          have hs₀_ne_z : s₀ - z ≠ 0 := sub_ne_zero.mpr (fun heq => hs₀_S (heq ▸ hz))
          exact (differentiableAt_const _).mul
            (((differentiableAt_id.sub_const z).inv hs₀_ne_z).pow 2)
        have h_nhds_f : {w : ℂ | f w ≠ 0} ∈ nhds s₀ := by
          have hf_cont : ContinuousAt f s₀ := hf.continuousOn.continuousAt (hU.mem_nhds hs₀_U)
          exact hf_cont.preimage_mem_nhds (isOpen_compl_singleton.mem_nhds hfs₀_ne)
        have h_ev_G : G =ᶠ[nhds s₀] H_reg := by
          filter_upwards [h_nhds_f] with w hfw_ne
          have hw_not_S : w ∉ S_int := fun hwS => hfw_ne ((hS_mem w).mp hwS).2
          dsimp [G, H_reg]
          simp only [hw_not_S, ↓reduceIte]
        exact h_ev_G.differentiableAt_iff.mpr hH_reg_diffAt
    let c₁ : ℂ := (a : ℂ) + (y_lo : ℂ) * Complex.I
    let c₂ : ℂ := (b : ℂ) + (y_hi : ℂ) * Complex.I
    have hc₁_re : c₁.re = a := by simp [c₁]
    have hc₂_re : c₂.re = b := by simp [c₂]
    have hc₁_im : c₁.im = y_lo := by simp [c₁]
    have hc₂_im : c₂.im = y_hi := by simp [c₂]
    have hG_diffOn : DifferentiableOn ℂ G (Set.uIcc c₁.re c₂.re ×ℂ Set.uIcc c₁.im c₂.im) := by
      rw [hc₁_re, hc₂_re, hc₁_im, hc₂_im, Set.uIcc_of_le hab, Set.uIcc_of_le hy]
      exact fun s hs => (hG_diffAt s hs).differentiableWithinAt
    have h_rect_G := Complex.integral_boundary_rect_eq_zero_of_differentiableOn G c₁ c₂ hG_diffOn
    rw [hc₁_re, hc₂_re, hc₁_im, hc₂_im, smul_eq_mul, smul_eq_mul] at h_rect_G
    have h_horiz_side : ∀ y₀ ∈ Set.Icc y_lo y_hi,
        (∀ x ∈ Set.Icc a b, f ((x : ℂ) + (y₀ : ℂ) * Complex.I) ≠ 0) →
        (∫ x in a..b, G ((x : ℂ) + (y₀ : ℂ) * Complex.I)) =
          (∫ x in a..b, (f ((x : ℂ) + (y₀ : ℂ) * Complex.I))⁻¹ ^ 2) -
            ∑ z ∈ S_int, (deriv f z)⁻¹ ^ 2 *
              (((a : ℂ) + (y₀ : ℂ) * Complex.I - z)⁻¹ -
                ((b : ℂ) + (y₀ : ℂ) * Complex.I - z)⁻¹) := by
      intro y₀ hy₀ h_nz
      let γ_h : ℝ → ℂ := fun x => (x : ℂ) + (y₀ : ℂ) * Complex.I
      have hγ_cont : Continuous γ_h := by fun_prop
      have hγ_maps : Set.MapsTo γ_h (Set.Icc a b) U := by
        intro x hx
        apply hRU
        rw [Complex.mem_reProdIm]
        exact ⟨by simpa [γ_h] using hx, by simpa [γ_h] using hy₀⟩
      have h_uIcc_ab : Set.uIcc a b = Set.Icc a b := Set.uIcc_of_le hab
      have h_congr : ∫ x in a..b, G (γ_h x) =
          ∫ x in a..b,
            ((f (γ_h x))⁻¹ ^ 2 - ∑ z ∈ S_int, (deriv f z)⁻¹ ^ 2 * (γ_h x - z)⁻¹ ^ 2) := by
        refine intervalIntegral.integral_congr fun x hx => ?_
        rw [h_uIcc_ab] at hx
        have hne := h_nz x hx
        have hnotS : γ_h x ∉ S_int := fun hS => hne ((hS_mem _).mp hS).2
        dsimp [G]
        simp only [hnotS, ↓reduceIte]
      have hf_int : IntervalIntegrable (fun x => (f (γ_h x))⁻¹ ^ 2) MeasureTheory.volume a b := by
        apply ContinuousOn.intervalIntegrable
        rw [h_uIcc_ab]
        have hf_c : ContinuousOn (fun x => f (γ_h x)) (Set.Icc a b) :=
          hf.continuousOn.comp hγ_cont.continuousOn hγ_maps
        exact (hf_c.inv₀ h_nz).pow 2
      have hpole_cont : ∀ z ∈ S_int,
          ContinuousOn (fun x => (deriv f z)⁻¹ ^ 2 * (γ_h x - z)⁻¹ ^ 2) (Set.Icc a b) := by
        intro z hz
        have hz0 := ((hS_mem z).mp hz).2
        have hsub_nz : ∀ x ∈ Set.Icc a b, γ_h x - z ≠ 0 := by
          intro x hx heq
          have heq' : γ_h x = z := sub_eq_zero.mp heq
          exact h_nz x hx (by dsimp [γ_h] at heq'; rw [heq']; exact hz0)
        exact continuousOn_const.mul
          (((hγ_cont.continuousOn.sub continuousOn_const).inv₀ hsub_nz).pow 2)
      have hpole_int : ∀ z ∈ S_int,
          IntervalIntegrable (fun x => (deriv f z)⁻¹ ^ 2 * (γ_h x - z)⁻¹ ^ 2)
            MeasureTheory.volume a b := by
        intro z hz
        apply ContinuousOn.intervalIntegrable
        rw [h_uIcc_ab]
        exact hpole_cont z hz
      have hsum_int : IntervalIntegrable
          (fun x => ∑ z ∈ S_int, (deriv f z)⁻¹ ^ 2 * (γ_h x - z)⁻¹ ^ 2) MeasureTheory.volume a b := by
        apply ContinuousOn.intervalIntegrable
        rw [h_uIcc_ab]
        exact continuousOn_finsetSum S_int hpole_cont
      rw [h_congr, intervalIntegral.integral_sub hf_int hsum_int,
        intervalIntegral.integral_finsetSum hpole_int]
      congr 1
      refine Finset.sum_congr rfl fun z hz => ?_
      have hz0 := ((hS_mem z).mp hz).2
      have hsub_nz : ∀ x ∈ Set.uIcc a b, γ_h x - z ≠ 0 := by
        rw [h_uIcc_ab]
        intro x hx heq
        have heq' : γ_h x = z := sub_eq_zero.mp heq
        exact h_nz x hx (by dsimp [γ_h] at heq'; rw [heq']; exact hz0)
      let P_h : ℝ → ℂ := fun x => -(deriv f z)⁻¹ ^ 2 * (γ_h x - z)⁻¹
      have hP_deriv : ∀ x ∈ Set.uIcc a b,
          HasDerivAt P_h ((deriv f z)⁻¹ ^ 2 * (γ_h x - z)⁻¹ ^ 2) x := by
        intro x hx
        have hγ_hd : HasDerivAt (fun t : ℝ => γ_h t - z) 1 x := by
          dsimp [γ_h]
          simpa using (((hasDerivAt_id x).ofReal_comp).add_const ((y₀ : ℂ) * Complex.I)).sub_const z
        have hinv_hd := hγ_hd.inv (hsub_nz x hx)
        have hmul_hd : HasDerivAt P_h (-(deriv f z)⁻¹ ^ 2 * (-1 / (γ_h x - z) ^ 2)) x :=
          hinv_hd.const_mul (-(deriv f z)⁻¹ ^ 2)
        have h_eq_d : -(deriv f z)⁻¹ ^ 2 * (-1 / (γ_h x - z) ^ 2) =
            (deriv f z)⁻¹ ^ 2 * (γ_h x - z)⁻¹ ^ 2 := by
          rw [inv_pow (γ_h x - z), div_eq_mul_inv]
          ring
        rwa [h_eq_d] at hmul_hd
      rw [intervalIntegral.integral_eq_sub_of_hasDerivAt hP_deriv (hpole_int z hz)]
      dsimp [P_h, γ_h]
      ring
    have h_vert_side : ∀ x₀ ∈ Set.Icc a b,
        (∀ y ∈ Set.Icc y_lo y_hi, f ((x₀ : ℂ) + (y : ℂ) * Complex.I) ≠ 0) →
        (∫ y in y_lo..y_hi, G ((x₀ : ℂ) + (y : ℂ) * Complex.I)) =
          (∫ y in y_lo..y_hi, (f ((x₀ : ℂ) + (y : ℂ) * Complex.I))⁻¹ ^ 2) -
            ∑ z ∈ S_int, (deriv f z)⁻¹ ^ 2 *
              (Complex.I * ((x₀ : ℂ) + (y_hi : ℂ) * Complex.I - z)⁻¹ -
                Complex.I * ((x₀ : ℂ) + (y_lo : ℂ) * Complex.I - z)⁻¹) := by
      intro x₀ hx₀ h_nz
      let γ_v : ℝ → ℂ := fun y => (x₀ : ℂ) + (y : ℂ) * Complex.I
      have hγ_cont : Continuous γ_v := by fun_prop
      have hγ_maps : Set.MapsTo γ_v (Set.Icc y_lo y_hi) U := by
        intro y hy_mem
        apply hRU
        rw [Complex.mem_reProdIm]
        exact ⟨by simpa [γ_v] using hx₀, by simpa [γ_v] using hy_mem⟩
      have h_uIcc_y : Set.uIcc y_lo y_hi = Set.Icc y_lo y_hi := Set.uIcc_of_le hy
      have h_congr : ∫ y in y_lo..y_hi, G (γ_v y) =
          ∫ y in y_lo..y_hi,
            ((f (γ_v y))⁻¹ ^ 2 - ∑ z ∈ S_int, (deriv f z)⁻¹ ^ 2 * (γ_v y - z)⁻¹ ^ 2) := by
        refine intervalIntegral.integral_congr fun y hy_mem => ?_
        rw [h_uIcc_y] at hy_mem
        have hne := h_nz y hy_mem
        have hnotS : γ_v y ∉ S_int := fun hS => hne ((hS_mem _).mp hS).2
        dsimp [G]
        simp only [hnotS, ↓reduceIte]
      have hf_int : IntervalIntegrable (fun y => (f (γ_v y))⁻¹ ^ 2) MeasureTheory.volume y_lo y_hi := by
        apply ContinuousOn.intervalIntegrable
        rw [h_uIcc_y]
        have hf_c : ContinuousOn (fun y => f (γ_v y)) (Set.Icc y_lo y_hi) :=
          hf.continuousOn.comp hγ_cont.continuousOn hγ_maps
        exact (hf_c.inv₀ h_nz).pow 2
      have hpole_cont : ∀ z ∈ S_int,
          ContinuousOn (fun y => (deriv f z)⁻¹ ^ 2 * (γ_v y - z)⁻¹ ^ 2) (Set.Icc y_lo y_hi) := by
        intro z hz
        have hz0 := ((hS_mem z).mp hz).2
        have hsub_nz : ∀ y ∈ Set.Icc y_lo y_hi, γ_v y - z ≠ 0 := by
          intro y hy_mem heq
          have heq' : γ_v y = z := sub_eq_zero.mp heq
          exact h_nz y hy_mem (by dsimp [γ_v] at heq'; rw [heq']; exact hz0)
        exact continuousOn_const.mul
          (((hγ_cont.continuousOn.sub continuousOn_const).inv₀ hsub_nz).pow 2)
      have hpole_int : ∀ z ∈ S_int,
          IntervalIntegrable (fun y => (deriv f z)⁻¹ ^ 2 * (γ_v y - z)⁻¹ ^ 2)
            MeasureTheory.volume y_lo y_hi := by
        intro z hz
        apply ContinuousOn.intervalIntegrable
        rw [h_uIcc_y]
        exact hpole_cont z hz
      have hsum_int : IntervalIntegrable
          (fun y => ∑ z ∈ S_int, (deriv f z)⁻¹ ^ 2 * (γ_v y - z)⁻¹ ^ 2)
          MeasureTheory.volume y_lo y_hi := by
        apply ContinuousOn.intervalIntegrable
        rw [h_uIcc_y]
        exact continuousOn_finsetSum S_int hpole_cont
      rw [h_congr, intervalIntegral.integral_sub hf_int hsum_int,
        intervalIntegral.integral_finsetSum hpole_int]
      congr 1
      refine Finset.sum_congr rfl fun z hz => ?_
      have hz0 := ((hS_mem z).mp hz).2
      have hsub_nz : ∀ y ∈ Set.uIcc y_lo y_hi, γ_v y - z ≠ 0 := by
        rw [h_uIcc_y]
        intro y hy_mem heq
        have heq' : γ_v y = z := sub_eq_zero.mp heq
        exact h_nz y hy_mem (by dsimp [γ_v] at heq'; rw [heq']; exact hz0)
      let P_v : ℝ → ℂ := fun y => (deriv f z)⁻¹ ^ 2 * Complex.I * (γ_v y - z)⁻¹
      have hP_deriv : ∀ y ∈ Set.uIcc y_lo y_hi,
          HasDerivAt P_v ((deriv f z)⁻¹ ^ 2 * (γ_v y - z)⁻¹ ^ 2) y := by
        intro y hy_mem
        have hγ_hd : HasDerivAt (fun t : ℝ => γ_v t - z) Complex.I y := by
          dsimp [γ_v]
          have h1 : HasDerivAt (fun t : ℝ => (t : ℂ) * Complex.I) ((1 : ℂ) * Complex.I) y :=
            ((hasDerivAt_id y).ofReal_comp).mul_const Complex.I
          simpa using ((h1.const_add (x₀ : ℂ)).sub_const z)
        have hinv_hd := hγ_hd.inv (hsub_nz y hy_mem)
        have hmul_hd : HasDerivAt P_v
            (((deriv f z)⁻¹ ^ 2 * Complex.I) * (-Complex.I / (γ_v y - z) ^ 2)) y :=
          hinv_hd.const_mul ((deriv f z)⁻¹ ^ 2 * Complex.I)
        have h_eq_d : ((deriv f z)⁻¹ ^ 2 * Complex.I) * (-Complex.I / (γ_v y - z) ^ 2) =
            (deriv f z)⁻¹ ^ 2 * (γ_v y - z)⁻¹ ^ 2 := by
          rw [inv_pow (γ_v y - z), div_eq_mul_inv]
          calc ((deriv f z)⁻¹ ^ 2 * Complex.I) * (-Complex.I * ((γ_v y - z) ^ 2)⁻¹)
              = (deriv f z)⁻¹ ^ 2 * (-(Complex.I * Complex.I)) * ((γ_v y - z) ^ 2)⁻¹ := by ring
            _ = (deriv f z)⁻¹ ^ 2 * (-(-1 : ℂ)) * ((γ_v y - z) ^ 2)⁻¹ := by rw [Complex.I_mul_I]
            _ = (deriv f z)⁻¹ ^ 2 * ((γ_v y - z) ^ 2)⁻¹ := by ring
        rwa [h_eq_d] at hmul_hd
      rw [intervalIntegral.integral_eq_sub_of_hasDerivAt hP_deriv (hpole_int z hz)]
      dsimp [P_v, γ_v]
      ring
    rw [h_horiz_side y_lo ⟨le_rfl, hy⟩ h_bot,
        h_horiz_side y_hi ⟨hy, le_rfl⟩ h_top,
        h_vert_side b ⟨hab, le_rfl⟩ h_right,
        h_vert_side a ⟨le_rfl, hab⟩ h_left] at h_rect_G
    let S_bot := ∑ z ∈ S_int, (deriv f z)⁻¹ ^ 2 *
      (((a : ℂ) + (y_lo : ℂ) * Complex.I - z)⁻¹ - ((b : ℂ) + (y_lo : ℂ) * Complex.I - z)⁻¹)
    let S_top := ∑ z ∈ S_int, (deriv f z)⁻¹ ^ 2 *
      (((a : ℂ) + (y_hi : ℂ) * Complex.I - z)⁻¹ - ((b : ℂ) + (y_hi : ℂ) * Complex.I - z)⁻¹)
    let S_right := ∑ z ∈ S_int, (deriv f z)⁻¹ ^ 2 *
      (Complex.I * ((b : ℂ) + (y_hi : ℂ) * Complex.I - z)⁻¹ -
        Complex.I * ((b : ℂ) + (y_lo : ℂ) * Complex.I - z)⁻¹)
    let S_left := ∑ z ∈ S_int, (deriv f z)⁻¹ ^ 2 *
      (Complex.I * ((a : ℂ) + (y_hi : ℂ) * Complex.I - z)⁻¹ -
        Complex.I * ((a : ℂ) + (y_lo : ℂ) * Complex.I - z)⁻¹)
    have h_sum_cancel : (-S_bot + S_top) - Complex.I * S_right + Complex.I * S_left = 0 := by
      dsimp [S_bot, S_top, S_right, S_left]
      rw [Finset.mul_sum, Finset.mul_sum, ← Finset.sum_neg_distrib, ← Finset.sum_add_distrib,
        ← Finset.sum_sub_distrib, ← Finset.sum_add_distrib]
      refine Finset.sum_eq_zero fun z _ => ?_
      calc -((deriv f z)⁻¹ ^ 2 *
              (((a : ℂ) + (y_lo : ℂ) * Complex.I - z)⁻¹ -
                ((b : ℂ) + (y_lo : ℂ) * Complex.I - z)⁻¹)) +
            (deriv f z)⁻¹ ^ 2 *
              (((a : ℂ) + (y_hi : ℂ) * Complex.I - z)⁻¹ -
                ((b : ℂ) + (y_hi : ℂ) * Complex.I - z)⁻¹) -
            Complex.I * ((deriv f z)⁻¹ ^ 2 *
              (Complex.I * ((b : ℂ) + (y_hi : ℂ) * Complex.I - z)⁻¹ -
                Complex.I * ((b : ℂ) + (y_lo : ℂ) * Complex.I - z)⁻¹)) +
            Complex.I * ((deriv f z)⁻¹ ^ 2 *
              (Complex.I * ((a : ℂ) + (y_hi : ℂ) * Complex.I - z)⁻¹ -
                Complex.I * ((a : ℂ) + (y_lo : ℂ) * Complex.I - z)⁻¹))
          = (deriv f z)⁻¹ ^ 2 * (1 + Complex.I * Complex.I) *
              (((a : ℂ) + (y_hi : ℂ) * Complex.I - z)⁻¹ -
                ((a : ℂ) + (y_lo : ℂ) * Complex.I - z)⁻¹ -
                ((b : ℂ) + (y_hi : ℂ) * Complex.I - z)⁻¹ +
                ((b : ℂ) + (y_lo : ℂ) * Complex.I - z)⁻¹) := by ring
        _ = 0 := by rw [Complex.I_mul_I]; ring
    linear_combination h_rect_G - h_sum_cancel

  
  have h_staircase_bound : ∀ (M : ℕ) (y_lo y_hi B : ℝ) (x y : ℕ → ℝ),
      1 ≤ M → 0 ≤ y_lo → y_lo ≤ y_hi → y_hi < S.H → 0 < B →
      x M = x 0 + 2 * Real.pi →
      (∀ j < M, x j ≤ x (j + 1)) →
      (∀ j < M, y j ∈ Set.Icc y_lo y_hi) →
      (∀ j < M, ∀ u ∈ Set.Icc 0 y_hi, S.f ((x j : ℂ) + (u : ℂ) * Complex.I) ≠ 0) →
      (∀ j < M, ∀ t ∈ Set.Icc (x j) (x (j + 1)), B ≤ ‖S.f ((t : ℂ) + (y j : ℂ) * Complex.I)‖) →
      (∀ j < M, ∀ u ∈ Set.Icc y_lo y_hi, B ≤ ‖S.f ((x j : ℂ) + (u : ℂ) * Complex.I)‖) →
      (∀ j < M,
        ((∫ t in x j..x (j + 1), (S.f (t : ℂ))⁻¹ ^ 2) -
          ∫ t in x j..x (j + 1), (S.f ((t : ℂ) + (y j : ℂ) * Complex.I))⁻¹ ^ 2) +
          Complex.I * (∫ u in (0 : ℝ)..y j, (S.f ((x (j + 1) : ℂ) + (u : ℂ) * Complex.I))⁻¹ ^ 2) -
          Complex.I * (∫ u in (0 : ℝ)..y j, (S.f ((x j : ℂ) + (u : ℂ) * Complex.I))⁻¹ ^ 2) = 0) →
      ‖∫ t in (0 : ℝ)..(2 * Real.pi), (S.f (t : ℂ))⁻¹ ^ 2‖ ≤
        (2 * Real.pi + (M : ℝ) * (y_hi - y_lo)) / B ^ 2 := by
    intro M y_lo y_hi B x y hM hy_lo0 hy_le hy_hiH hB hxM hx_mono hy_mem h_vnz h_tread h_riser h_rect
    let g : ℂ → ℂ := fun s => (S.f s)⁻¹ ^ 2
    have h_real_mem : ∀ t : ℝ, (t : ℂ) ∈ horizStrip S.H := by
      intro t
      change |(t : ℂ).im| < S.H
      simp [S.H_pos]
    have hg_real_cont : Continuous (fun t : ℝ => g (t : ℂ)) := by
      have hf_c : Continuous (fun t : ℝ => S.f (t : ℂ)) :=
        S.f_holo.continuousOn.comp_continuous Complex.continuous_ofReal h_real_mem
      have hf_nz : ∀ t : ℝ, S.f (t : ℂ) ≠ 0 := by
        intro t h0
        have hre := (S.f_real_pos t).1
        rw [h0, Complex.zero_re] at hre
        exact lt_irrefl 0 hre
      exact (hf_c.inv₀ hf_nz).pow 2
    have hg_real_per : Function.Periodic (fun t : ℝ => g (t : ℂ)) (2 * Real.pi) := by
      intro t
      dsimp [g]
      have hcast : ((t + 2 * Real.pi : ℝ) : ℂ) = (t : ℂ) + 2 * Real.pi := by push_cast; ring
      rw [hcast, S.f_periodic (t : ℂ) (h_real_mem t)]
    have h_bot_sum : (∑ j ∈ Finset.range M, ∫ t in x j..x (j + 1), g (t : ℂ)) =
        ∫ t in (0 : ℝ)..(2 * Real.pi), g (t : ℂ) := by
      have h_ind : ∀ k : ℕ, (∑ j ∈ Finset.range k, ∫ t in x j..x (j + 1), g (t : ℂ)) =
          ∫ t in x 0..x k, g (t : ℂ) := by
        intro k
        induction k with
        | zero => simp
        | succ k ih =>
          rw [Finset.sum_range_succ, ih]
          exact intervalIntegral.integral_add_adjacent_intervals
            (hg_real_cont.intervalIntegrable _ _) (hg_real_cont.intervalIntegrable _ _)
      rw [h_ind M, hxM]
      have hper_eq := hg_real_per.intervalIntegral_add_eq (x 0) 0
      simpa using hper_eq
    obtain ⟨m, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.one_le_iff_ne_zero.mp hM)
    let y_prev : ℕ → ℝ := fun j => if j = 0 then y m else y (j - 1)
    have hy_prev_mem : ∀ j < m + 1, y_prev j ∈ Set.Icc y_lo y_hi := by
      intro j hj
      by_cases hj0 : j = 0
      · subst hj0
        simpa [y_prev] using hy_mem m (Nat.lt_succ_self m)
      · have hj_pred : j - 1 < m + 1 := Nat.lt_of_le_of_lt (Nat.sub_le j 1) hj
        simpa [y_prev, hj0] using hy_mem (j - 1) hj_pred
    have h_right_eq_prev :
        (∑ j ∈ Finset.range (m + 1), ∫ u in (0 : ℝ)..y j, g ((x (j + 1) : ℂ) + (u : ℂ) * Complex.I)) =
        ∑ j ∈ Finset.range (m + 1), ∫ u in (0 : ℝ)..y_prev j, g ((x j : ℂ) + (u : ℂ) * Complex.I) := by
      rw [Finset.sum_range_succ, Finset.sum_range_succ']
      refine congrArg₂ (· + ·) ?_ ?_
      · refine Finset.sum_congr rfl fun k _ => ?_
        simp [y_prev]
      · simp only [y_prev, ↓reduceIte]
        rw [hxM]
        refine intervalIntegral.integral_congr fun u hu => ?_
        have hym_nonneg : 0 ≤ y m := le_trans hy_lo0 (hy_mem m (Nat.lt_succ_self m)).1
        rw [Set.uIcc_of_le hym_nonneg] at hu
        have hu_lt_H : |u| < S.H := by
          rw [abs_of_nonneg hu.1]
          exact lt_of_le_of_lt (le_trans hu.2 (hy_mem m (Nat.lt_succ_self m)).2) hy_hiH
        have hs_mem : (x 0 : ℂ) + (u : ℂ) * Complex.I ∈ horizStrip S.H := by
          change |((x 0 : ℂ) + (u : ℂ) * Complex.I).im| < S.H
          simpa using hu_lt_H
        have h_shift : ((x 0 + 2 * Real.pi : ℝ) : ℂ) + (u : ℂ) * Complex.I =
            ((x 0 : ℂ) + (u : ℂ) * Complex.I) + 2 * Real.pi := by
          push_cast
          ring
        dsimp [g]
        rw [h_shift, S.f_periodic _ hs_mem]
    have h_vert_diff : ∀ j < m + 1,
        (∫ u in (0 : ℝ)..y j, g ((x j : ℂ) + (u : ℂ) * Complex.I)) -
          (∫ u in (0 : ℝ)..y_prev j, g ((x j : ℂ) + (u : ℂ) * Complex.I)) =
          ∫ u in y_prev j..y j, g ((x j : ℂ) + (u : ℂ) * Complex.I) := by
      intro j hj
      let γ_j : ℝ → ℂ := fun u => (x j : ℂ) + (u : ℂ) * Complex.I
      have hγ_cont : Continuous γ_j := by fun_prop
      have hγ_maps : Set.MapsTo γ_j (Set.Icc 0 y_hi) (horizStrip S.H) := by
        intro u hu
        change |(γ_j u).im| < S.H
        have him : (γ_j u).im = u := by simp [γ_j]
        rw [him, abs_of_nonneg hu.1]
        exact lt_of_le_of_lt hu.2 hy_hiH
      have hg_cont_Icc : ContinuousOn (fun u => g (γ_j u)) (Set.Icc 0 y_hi) := by
        have hf_c : ContinuousOn (fun u => S.f (γ_j u)) (Set.Icc 0 y_hi) :=
          S.f_holo.continuousOn.comp hγ_cont.continuousOn hγ_maps
        exact (hf_c.inv₀ (h_vnz j hj)).pow 2
      have h0_mem : (0 : ℝ) ∈ Set.Icc 0 y_hi := ⟨le_rfl, le_trans hy_lo0 hy_le⟩
      have hyp_mem : y_prev j ∈ Set.Icc 0 y_hi :=
        ⟨le_trans hy_lo0 (hy_prev_mem j hj).1, (hy_prev_mem j hj).2⟩
      have hyj_mem : y j ∈ Set.Icc 0 y_hi :=
        ⟨le_trans hy_lo0 (hy_mem j hj).1, (hy_mem j hj).2⟩
      have hint1 : IntervalIntegrable (fun u => g (γ_j u)) MeasureTheory.volume 0 (y_prev j) :=
        (hg_cont_Icc.mono (Set.uIcc_subset_Icc h0_mem hyp_mem)).intervalIntegrable
      have hint2 : IntervalIntegrable (fun u => g (γ_j u)) MeasureTheory.volume (y_prev j) (y j) :=
        (hg_cont_Icc.mono (Set.uIcc_subset_Icc hyp_mem hyj_mem)).intervalIntegrable
      have hadj := intervalIntegral.integral_add_adjacent_intervals hint1 hint2
      dsimp [γ_j] at hadj
      linear_combination -hadj
    have h_staircase_eq : (∫ t in (0 : ℝ)..(2 * Real.pi), g (t : ℂ)) =
        (∑ j ∈ Finset.range (m + 1), ∫ t in x j..x (j + 1), g ((t : ℂ) + (y j : ℂ) * Complex.I)) +
          Complex.I * ∑ j ∈ Finset.range (m + 1),
            ∫ u in y_prev j..y j, g ((x j : ℂ) + (u : ℂ) * Complex.I) := by
      have h_cell_eq : ∀ j ∈ Finset.range (m + 1),
          (∫ t in x j..x (j + 1), g (t : ℂ)) =
            (∫ t in x j..x (j + 1), g ((t : ℂ) + (y j : ℂ) * Complex.I)) +
              Complex.I * (∫ u in (0 : ℝ)..y j, g ((x j : ℂ) + (u : ℂ) * Complex.I)) -
              Complex.I * (∫ u in (0 : ℝ)..y j, g ((x (j + 1) : ℂ) + (u : ℂ) * Complex.I)) := by
        intro j hj
        have hr := h_rect j (Finset.mem_range.mp hj)
        dsimp [g]
        linear_combination hr
      have h_sum := Finset.sum_congr rfl h_cell_eq
      rw [h_bot_sum, Finset.sum_sub_distrib, Finset.sum_add_distrib,
        ← Finset.mul_sum, ← Finset.mul_sum, h_right_eq_prev] at h_sum
      have h_sub_sum :
          (∑ j ∈ Finset.range (m + 1), ∫ u in (0 : ℝ)..y j, g ((x j : ℂ) + (u : ℂ) * Complex.I)) -
            (∑ j ∈ Finset.range (m + 1), ∫ u in (0 : ℝ)..y_prev j, g ((x j : ℂ) + (u : ℂ) * Complex.I)) =
            ∑ j ∈ Finset.range (m + 1), ∫ u in y_prev j..y j, g ((x j : ℂ) + (u : ℂ) * Complex.I) := by
        rw [← Finset.sum_sub_distrib]
        exact Finset.sum_congr rfl fun j hj => h_vert_diff j (Finset.mem_range.mp hj)
      linear_combination h_sum + Complex.I * h_sub_sum
    have h_inv_sq_le : ∀ s : ℂ, B ≤ ‖S.f s‖ → ‖g s‖ ≤ (B ^ 2)⁻¹ := by
      intro s hs
      dsimp [g]
      rw [norm_pow, norm_inv, inv_pow]
      exact inv_anti₀ (pow_pos hB 2) (pow_le_pow_left₀ hB.le hs 2)
    have h_tread_sum_norm :
        ‖∑ j ∈ Finset.range (m + 1), ∫ t in x j..x (j + 1), g ((t : ℂ) + (y j : ℂ) * Complex.I)‖ ≤
          (B ^ 2)⁻¹ * (2 * Real.pi) := by
      calc ‖∑ j ∈ Finset.range (m + 1), ∫ t in x j..x (j + 1), g ((t : ℂ) + (y j : ℂ) * Complex.I)‖
          ≤ ∑ j ∈ Finset.range (m + 1),
              ‖∫ t in x j..x (j + 1), g ((t : ℂ) + (y j : ℂ) * Complex.I)‖ :=
            norm_sum_le _ _
        _ ≤ ∑ j ∈ Finset.range (m + 1), (B ^ 2)⁻¹ * (x (j + 1) - x j) := by
            refine Finset.sum_le_sum fun j hj => ?_
            have hj_lt := Finset.mem_range.mp hj
            have hmono := hx_mono j hj_lt
            have hbound_j : ∀ t ∈ Set.uIoc (x j) (x (j + 1)),
                ‖g ((t : ℂ) + (y j : ℂ) * Complex.I)‖ ≤ (B ^ 2)⁻¹ := by
              intro t ht
              have ht_Icc : t ∈ Set.Icc (x j) (x (j + 1)) := by
                rw [← Set.uIcc_of_le hmono]
                exact Set.uIoc_subset_uIcc ht
              exact h_inv_sq_le _ (h_tread j hj_lt t ht_Icc)
            have hn := intervalIntegral.norm_integral_le_of_norm_le_const hbound_j
            rwa [abs_of_nonneg (sub_nonneg.mpr hmono)] at hn
        _ = (B ^ 2)⁻¹ * ∑ j ∈ Finset.range (m + 1), (x (j + 1) - x j) :=
            (Finset.mul_sum _ _ _).symm
        _ = (B ^ 2)⁻¹ * (x (m + 1) - x 0) := by rw [Finset.sum_range_sub]
        _ = (B ^ 2)⁻¹ * (2 * Real.pi) := by rw [hxM]; ring
    have h_riser_sum_norm :
        ‖Complex.I * ∑ j ∈ Finset.range (m + 1),
            ∫ u in y_prev j..y j, g ((x j : ℂ) + (u : ℂ) * Complex.I)‖ ≤
          ((m + 1 : ℕ) : ℝ) * ((B ^ 2)⁻¹ * (y_hi - y_lo)) := by
      rw [norm_mul, Complex.norm_I, one_mul]
      calc ‖∑ j ∈ Finset.range (m + 1), ∫ u in y_prev j..y j, g ((x j : ℂ) + (u : ℂ) * Complex.I)‖
          ≤ ∑ j ∈ Finset.range (m + 1),
              ‖∫ u in y_prev j..y j, g ((x j : ℂ) + (u : ℂ) * Complex.I)‖ :=
            norm_sum_le _ _
        _ ≤ ∑ _j ∈ Finset.range (m + 1), (B ^ 2)⁻¹ * (y_hi - y_lo) := by
            refine Finset.sum_le_sum fun j hj => ?_
            have hj_lt := Finset.mem_range.mp hj
            have hyp := hy_prev_mem j hj_lt
            have hyj := hy_mem j hj_lt
            have hbound_j : ∀ u ∈ Set.uIoc (y_prev j) (y j),
                ‖g ((x j : ℂ) + (u : ℂ) * Complex.I)‖ ≤ (B ^ 2)⁻¹ := by
              intro u hu
              have hu_Icc : u ∈ Set.Icc y_lo y_hi :=
                Set.uIcc_subset_Icc hyp hyj (Set.uIoc_subset_uIcc hu)
              exact h_inv_sq_le _ (h_riser j hj_lt u hu_Icc)
            have hn := intervalIntegral.norm_integral_le_of_norm_le_const hbound_j
            have habs : |y j - y_prev j| ≤ y_hi - y_lo := by
              rw [abs_le]
              exact ⟨by linarith [hyp.2, hyj.1], by linarith [hyp.1, hyj.2]⟩
            exact le_trans hn (mul_le_mul_of_nonneg_left habs (by positivity))
        _ = ((m + 1 : ℕ) : ℝ) * ((B ^ 2)⁻¹ * (y_hi - y_lo)) := by simp
    dsimp [g] at h_staircase_eq
    rw [h_staircase_eq]
    calc ‖(∑ j ∈ Finset.range (m + 1),
              ∫ t in x j..x (j + 1), (S.f ((t : ℂ) + (y j : ℂ) * Complex.I))⁻¹ ^ 2) +
            Complex.I * ∑ j ∈ Finset.range (m + 1),
              ∫ u in y_prev j..y j, (S.f ((x j : ℂ) + (u : ℂ) * Complex.I))⁻¹ ^ 2‖
        ≤ (B ^ 2)⁻¹ * (2 * Real.pi) + ((m + 1 : ℕ) : ℝ) * ((B ^ 2)⁻¹ * (y_hi - y_lo)) :=
          le_trans (norm_add_le _ _) (add_le_add h_tread_sum_norm h_riser_sum_norm)
      _ = (2 * Real.pi + ((m + 1 : ℕ) : ℝ) * (y_hi - y_lo)) / B ^ 2 := by
          rw [div_eq_mul_inv]
          ring

  
  have hOpen_strip : IsOpen (horizStrip S.H) :=
    isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const
  let I_real : ℝ := ‖∫ t in (0 : ℝ)..(2 * Real.pi), (S.f (t : ℂ))⁻¹ ^ 2‖
  have hI_pos : 0 < I_real := by
    let r_fn : ℝ → ℝ := fun t => ((S.f (t : ℂ)).re)⁻¹ ^ 2
    have h_f_re : ∀ t : ℝ, S.f (t : ℂ) = (((S.f (t : ℂ)).re : ℝ) : ℂ) := by
      intro t
      apply Complex.ext <;> simp [(S.f_real_pos t).2]
    have h_inv_sq_eq : ∀ t : ℝ, (S.f (t : ℂ))⁻¹ ^ 2 = (r_fn t : ℂ) := by
      intro t
      dsimp [r_fn]
      rw [h_f_re t]
      push_cast
      rfl
    have hr_cont : Continuous r_fn := by
      have hf_c : Continuous (fun t : ℝ => S.f (t : ℂ)) :=
        S.f_holo.continuousOn.comp_continuous Complex.continuous_ofReal
          (fun t => by change |(t : ℂ).im| < S.H; simp [S.H_pos])
      exact ((Complex.continuous_re.comp hf_c).inv₀
        (fun t => ((S.f_real_pos t).1).ne')).pow 2
    have hr_int_pos : 0 < ∫ t in (0 : ℝ)..(2 * Real.pi), r_fn t := by
      refine intervalIntegral.integral_pos (by positivity) hr_cont.continuousOn
        (fun t _ => by dsimp [r_fn]; positivity)
        ⟨0, ⟨le_rfl, by positivity⟩, ?_⟩
      dsimp [r_fn]
      have h0 := (S.f_real_pos 0).1
      positivity
    have hint_eq : (∫ t in (0 : ℝ)..(2 * Real.pi), (S.f (t : ℂ))⁻¹ ^ 2) =
        ((∫ t in (0 : ℝ)..(2 * Real.pi), r_fn t : ℝ) : ℂ) := by
      simp_rw [h_inv_sq_eq]
      exact intervalIntegral.integral_ofReal
    dsimp [I_real]
    rw [hint_eq, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hr_int_pos]
    exact hr_int_pos

  have hP_pos : 0 < R.P := lt_trans zero_lt_one (lt_trans R.one_lt_α₁ (lt_trans R.α₁_lt_α₂ R.α₂_lt_P))
  let M_B : ℝ := (8 : ℝ) ^ R.P
  have hM_B_pos : 0 < M_B := by positivity
  have hM_B_ge_one : 1 ≤ M_B := Real.one_le_rpow (by norm_num) hP_pos.le
  let δ₀ : ℝ := c₀ / M_B
  have hδ₀_pos : 0 < δ₀ := by positivity
  obtain ⟨N_zero, h_disk⟩ := h_unit_disk_lower_bound δ₀ hδ₀_pos
  let η : ℝ := 1 / (60 * ((N_zero : ℝ) + 1))
  have hη_pos : 0 < η := by positivity
  have hη_le : η ≤ 1 / 2 := by
    dsimp [η]
    have hN_nonneg : (0 : ℝ) ≤ (N_zero : ℝ) := Nat.cast_nonneg N_zero
    rw [div_le_div_iff₀ (by positivity) (by norm_num)]
    linarith
  obtain ⟨c_low, hc_low_pos, h_low⟩ := h_disk η hη_pos hη_le
  let c_cell : ℝ := M_B * c_low
  have hc_cell_pos : 0 < c_cell := by positivity

  let K_target : ℝ := Real.sqrt (7 * Real.pi / (c_cell ^ 2 * I_real))
  let k : ℕ := max 3 (Nat.ceil K_target + 1)
  let n : ℕ := φ k
  have hk_ge_3 : 3 ≤ k := le_max_left _ _
  have hk_le_n : k ≤ n := hφ.id_le k
  have hn_ge_3 : 3 ≤ n := le_trans hk_ge_3 hk_le_n

  let d : ℝ := R.d_seq n
  let m : ℝ := R.m_seq n
  have hd_eq : d = Real.exp (-R.k_seq n) := R.d_seq_eq n
  have hd_pos : 0 < d := by rw [hd_eq]; positivity
  have hk_seq_ge : R.k₀ + (n : ℝ) ≤ R.k_seq n := R.k_seq_ge n
  have hn_real_ge_3 : (3 : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn_ge_3
  have h2_le_exp1 : (2 : ℝ) ≤ Real.exp 1 := by
    have := Real.add_one_le_exp 1
    linarith
  have hd_le_16 : d ≤ 1 / 16 := by
    have hk_ge_4 : 4 ≤ R.k_seq n := by linarith [R.one_le_k₀]
    have h16 : (16 : ℝ) ≤ Real.exp (R.k_seq n) := by
      calc (16 : ℝ) = 2 ^ 4 := by norm_num
        _ ≤ (Real.exp 1) ^ 4 := pow_le_pow_left₀ (by norm_num) h2_le_exp1 4
        _ = Real.exp ((4 : ℕ) * 1) := (Real.exp_nat_mul 1 4).symm
        _ = Real.exp 4 := by norm_num
        _ ≤ Real.exp (R.k_seq n) := Real.exp_le_exp.mpr hk_ge_4
    rw [hd_eq, Real.exp_neg]
    exact inv_le_of_inv_le₀ (by positivity) (by simpa using h16)
  have hd_le_exp_k0 : d ≤ (1 / 8 : ℝ) * Real.exp (-R.k₀) := by
    have hk_ge_k0_3 : R.k₀ + 3 ≤ R.k_seq n := by linarith
    have h8 : (8 : ℝ) ≤ Real.exp 3 := by
      calc (8 : ℝ) = 2 ^ 3 := by norm_num
        _ ≤ (Real.exp 1) ^ 3 := pow_le_pow_left₀ (by norm_num) h2_le_exp1 3
        _ = Real.exp ((3 : ℕ) * 1) := (Real.exp_nat_mul 1 3).symm
        _ = Real.exp 3 := by norm_num
    have hexp_inv3 : Real.exp (-3) ≤ 1 / 8 := by
      rw [Real.exp_neg]
      exact inv_le_of_inv_le₀ (by positivity) (by simpa using h8)
    calc d = Real.exp (-R.k_seq n) := hd_eq
      _ ≤ Real.exp (-(R.k₀ + 3)) := Real.exp_le_exp.mpr (by linarith)
      _ = Real.exp (-3) * Real.exp (-R.k₀) := by rw [← Real.exp_add]; ring_nf
      _ ≤ (1 / 8 : ℝ) * Real.exp (-R.k₀) :=
          mul_le_mul_of_nonneg_right hexp_inv3 (Real.exp_pos _).le
  have hd_le_H16 : d ≤ S.H / 16 := by
    linarith [R.exp_neg_k₀_le_half_H]
  have hm_ge_k1 : (k : ℝ) + 1 ≤ m := by
    have hk_le_nr : (k : ℝ) ≤ (n : ℝ) := by exact_mod_cast hk_le_n
    have hn_nonneg : (0 : ℝ) ≤ (n : ℝ) := Nat.cast_nonneg n
    have hα₂_gt1 : 1 < R.α₂ := lt_trans R.one_lt_α₁ R.α₁_lt_α₂
    have h_prod_ge : (n : ℝ) ≤ R.α₂ * R.k_seq n := by
      nlinarith [R.one_le_k₀]
    calc (k : ℝ) + 1 ≤ (n : ℝ) + 1 := by linarith
      _ ≤ Real.exp (n : ℝ) := by have := Real.add_one_le_exp (n : ℝ); linarith
      _ ≤ Real.exp (R.α₂ * R.k_seq n) := Real.exp_le_exp.mpr h_prod_ge
      _ ≤ m := R.m_seq_lower n
  have hm_pos : 0 < m := lt_of_lt_of_le (by positivity) (R.m_seq_pos n)

  
  have h_rescaled_disk : ∀ (x₀ : ℝ) (Z_star : ℂ),
      Z_star ∈ Metric.closedBall (-Complex.I) (1 / 8) →
      let h_u : ℂ → ℂ := fun u =>
        (M_B⁻¹ : ℂ) * superlinearRescaledF S x₀ d m (Z_star + ((3 / 4 : ℝ) : ℂ) * u)
      DifferentiableOn ℂ h_u (Metric.ball (0 : ℂ) (13 / 12)) ∧
      (∀ u ∈ Metric.ball (0 : ℂ) (13 / 12), h_u u = 0 → deriv h_u u ≠ 0) ∧
      (∀ u ∈ Metric.closedBall (0 : ℂ) 1, ‖h_u u‖ ≤ 1) := by
    intro x₀ Z_star hZ_star h_u
    have hZ_dist : ‖Z_star - (-Complex.I)‖ ≤ 1 / 8 := by
      simpa [Metric.mem_closedBall, dist_eq_norm] using hZ_star
    have hZ_im_abs : |Z_star.im + 1| ≤ 1 / 8 := by
      have him : |(Z_star - (-Complex.I)).im| ≤ ‖Z_star - (-Complex.I)‖ :=
        Complex.abs_im_le_norm _
      have him_eq : (Z_star - (-Complex.I)).im = Z_star.im + 1 := by simp
