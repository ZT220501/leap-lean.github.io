      have hq_hi_r : u_re / Δ_k + 1 / 2 < (q : ℝ) + 1 := Int.lt_floor_add_one _
      have hL_ge1_r : (1 : ℝ) ≤ (L : ℝ) := by exact_mod_cast hL_ge
      have hu_div_bound : |u_re| < (8 / 3 : ℝ) * (L : ℝ) * Δ_k := by
        have hv_lt2 : v < 2 * ((2 : ℝ) ^ k) := by simpa [pow_succ'] using hv_lt_2k1
        calc |u_re| ≤ (L : ℝ) * v := hu_le
          _ < (L : ℝ) * (2 * ((2 : ℝ) ^ k)) := mul_lt_mul_of_pos_left hv_lt2 (by positivity)
          _ = (8 / 3 : ℝ) * (L : ℝ) * Δ_k := by dsimp only [Δ_k]; ring
      have hq_mem : q ∈ Finset.Icc (-3 * (L : ℤ)) (3 * (L : ℤ)) := by
