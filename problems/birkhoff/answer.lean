    have h_tail_le_half :
        ∑ j ∈ Finset.range N, (((2 * N).choose (N + j + 1) : ℝ) / (4 : ℝ) ^ N) ≤ 1 / 2 := by
      have hsum_real :
          2 * (∑ j ∈ Finset.range N, ((2 * N).choose (N + j + 1) : ℝ)) +
            (N.centralBinom : ℝ) = (4 : ℝ) ^ N := by
        exact_mod_cast h_row_sum_nat
      rw [← Finset.sum_div]
      have h4_pos : (0 : ℝ) < (4 : ℝ) ^ N := by positivity
      rw [div_le_iff₀ h4_pos]
      have hcb_nonneg : (0 : ℝ) ≤ (N.centralBinom : ℝ) := Nat.cast_nonneg _
      linarith
    have hQ_norm_le : ∀ w : ℂ, ‖w‖ ≤ 1 → ‖Q_N w‖ ≤ 1 / 2 := by
      intro w hw
