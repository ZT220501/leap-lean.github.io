      have h_c_pos : (((n : ℤ) + 3 : ℤ) : ℂ) ^ 2 = (d_nat : ℂ) ^ 2 * (α : ℂ) ^ 2 := by
        have h1 : ((n : ℤ) + 3) = ((d_nat * α : ℕ) : ℤ) := by rw [hα_mul]; push_cast; rfl
        rw [h1]
        push_cast
        ring
      rw [h_exp_pos (P.ξ (w + 2)) hξ2, h_exp_pos (P.ξ (w + 1)) hξ1, h_exp_pos (P.ξ w) hξ0,
        h_exp_neg (P.ξ (w + 2)) hξ2, h_exp_neg (P.ξ (w + 1)) hξ1, h_exp_neg (P.ξ w) hξ0,
        h_exp_mid, h_c_neg, h_c_pos, h_rat2, h_rat0] at h_ref
      have h_rw1_fold : (P.ξ (w + 1)) ^ d_nat = Rw1 := rfl
      rw [h_rw1_fold] at h_ref
      have h_sub0 := sub_eq_zero.mpr h_ref
      have h_d_ne : (d_nat : ℂ) ^ 2 ≠ 0 := pow_ne_zero 2 (Nat.cast_ne_zero.mpr (by omega))
      have hRw1_α_ne : Rw1 ^ α ≠ 0 := pow_ne_zero α hRw1_ne
      have hRw1_γ_ne : Rw1 ^ γ ≠ 0 := pow_ne_zero γ hRw1_ne
      have h_mid_split : Rw1 ^ (2 * α + 2 * γ) = Rw1 ^ α * Rw1 ^ α * Rw1 ^ γ * Rw1 ^ γ := by
        rw [pow_add, two_mul α, pow_add, two_mul γ, pow_add]
        ring
