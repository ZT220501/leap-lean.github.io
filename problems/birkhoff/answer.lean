    have hF_cont : Continuous (Function.uncurry (fun x₀ θ => Φ (γ x₀ θ))) :=
      hΦ_cont.comp_continuous hγ_cont (fun p => hγ_mem p.1 p.2)
    have h_cont : Continuous (maj_fn y₀ r) :=
      continuous_const.mul
        (intervalIntegral.continuous_parametric_intervalIntegral_of_continuous' hF_cont 0 (2 * Real.pi))
    have h_per : Function.Periodic (maj_fn y₀ r) (2 * Real.pi) := by
      intro x₀
      dsimp only [maj_fn]
      congr 1
      refine intervalIntegral.integral_congr fun θ _ => ?_
      have hshift : γ (x₀ + 2 * Real.pi) θ = γ x₀ θ + 2 * Real.pi := by
        dsimp only [γ]; push_cast; ring
      change Φ (γ (x₀ + 2 * Real.pi) θ) = Φ (γ x₀ θ)
      rw [hshift, hΦ_per (γ x₀ θ) (hγ_mem x₀ θ)]
    have h_dom : ∀ x₀ : ℝ, 0 ≤ maj_fn y₀ r x₀ ∧
