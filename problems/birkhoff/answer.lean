    exact (hPartialA hσ_open hfσ).comp σ.differentiable.differentiableOn
      (fun p hp => by simpa [σ] using hp)
  
  have h_zero_disc_cnt_fin :
      ∀ (c : ℂ) (r : ℝ), 0 < r → ∀ (g : ℂ → ℂ),
        DifferentiableOn ℂ g (Metric.ball c r) →
        (∃ z₀ ∈ Metric.ball c r, g z₀ ≠ 0) →
        ({ t : ℝ | (t : ℂ) ∈ Metric.ball c r ∧ g (t : ℂ) = 0 }).Countable ∧
        (∀ r' : ℝ, r' < r → ({ z : ℂ | z ∈ Metric.closedBall c r' ∧ g z = 0 }).Finite) := by
    intro c r _ g hg ⟨z₀, hz₀, hgz₀⟩
    let D : Set ℂ := Metric.ball c r
    let Z : Set ℂ := { z : ℂ | z ∈ D ∧ g z = 0 }
    have hg_ana : AnalyticOnNhd ℂ g D := hg.analyticOnNhd Metric.isOpen_ball
    have hZ_disc : IsDiscrete Z := by
      rw [isDiscrete_iff_nhdsNE]
      intro w hw
      rcases (hg_ana w hw.1).eventually_eq_zero_or_eventually_ne_zero with hev0 | hev_ne
      · exfalso
        exact hgz₀ (hg_ana.eqOn_zero_of_preconnected_of_eventuallyEq_zero
          (convex_ball c r).isPreconnected hw.1 hev0 hz₀)
      · rw [← Filter.empty_mem_iff_bot]
        have hsub : Zᶜ ∈ nhdsWithin w {w}ᶜ :=
          Filter.mem_of_superset hev_ne (fun z hz hmem => hz hmem.2)
        have hinter := Filter.inter_mem_inf hsub (Filter.mem_principal_self Z)
        rwa [Set.compl_inter_self] at hinter
    have hZ_cnt : Z.Countable :=
      (HereditarilyLindelofSpace.isLindelof Z).countable_of_isDiscrete hZ_disc
    refine ⟨hZ_cnt.preimage Complex.ofReal_injective, ?_⟩
    intro r' hr'
    let K : Set ℂ := Metric.closedBall c r'
    let S : Set ℂ := K ∩ g ⁻¹' ({0} : Set ℂ)
    have hK_sub : K ⊆ D := Metric.closedBall_subset_ball hr'
    have hg_K : ContinuousOn g K := hg.continuousOn.mono hK_sub
    have hS_closed : IsClosed S :=
      hg_K.preimage_isClosed_of_isClosed Metric.isClosed_closedBall isClosed_singleton
    have hS_compact : IsCompact S :=
      (ProperSpace.isCompact_closedBall c r').of_isClosed_subset hS_closed Set.inter_subset_left
    have hS_disc : IsDiscrete S := hZ_disc.mono (fun z hz => ⟨hK_sub hz.1, hz.2⟩)
    exact hS_compact.finite hS_disc
  
  have h_weier_prep :
      ∀ (y₀ t_tilde : ℂ) (R_y R_t : ℝ), 0 < R_y → 0 < R_t →
        ∀ (H_loc : ℂ × ℂ → ℂ),
          DifferentiableOn ℂ H_loc (Metric.ball y₀ R_y ×ˢ Metric.ball t_tilde R_t) →
          H_loc (y₀, t_tilde) = 0 →
          (∃ y_nz ∈ Metric.ball y₀ R_y, H_loc (y_nz, t_tilde) ≠ 0) →
          ∃ (r_y r_t : ℝ) (m : ℕ) (c : Fin m → ℂ → ℂ),
            0 < r_y ∧ r_y ≤ R_y ∧ 0 < r_t ∧ r_t ≤ R_t ∧ 1 ≤ m ∧
            (∀ k : Fin m, DifferentiableOn ℂ (c k) (Metric.ball t_tilde r_t)) ∧
            (∀ y ∈ Metric.ball y₀ r_y, ∀ t ∈ Metric.ball t_tilde r_t,
              H_loc (y, t) = 0 ↔
                (y - y₀) ^ m + ∑ k : Fin m, c k t * (y - y₀) ^ (k : ℕ) = 0) := by
    intro y₀ t_tilde R_y R_t hR_y hR_t H_loc hHolo_loc hH0 ⟨y_nz, hy_nz, hH_nz⟩
    have hBidisk_open : IsOpen (Metric.ball y₀ R_y ×ˢ Metric.ball t_tilde R_t) :=
      Metric.isOpen_ball.prod Metric.isOpen_ball
    let g₀ : ℂ → ℂ := fun w => H_loc (y₀ + w, t_tilde)
    have hg₀_holo : DifferentiableOn ℂ g₀ (Metric.ball (0 : ℂ) R_y) := by
      refine hHolo_loc.comp ((differentiable_id.const_add y₀).prodMk
        (differentiable_const t_tilde)).differentiableOn ?_
      intro w hw
      refine ⟨?_, Metric.mem_ball_self hR_t⟩
      simpa [Metric.mem_ball, dist_eq_norm] using hw
    have hg₀_ana : AnalyticOnNhd ℂ g₀ (Metric.ball (0 : ℂ) R_y) :=
      hg₀_holo.analyticOnNhd Metric.isOpen_ball
    have hw_nz_mem : y_nz - y₀ ∈ Metric.ball (0 : ℂ) R_y := by
      simpa [Metric.mem_ball, dist_eq_norm] using hy_nz
    have hg₀_wnz : g₀ (y_nz - y₀) ≠ 0 := by
      dsimp only [g₀]
      rw [add_sub_cancel]
      exact hH_nz
    have hg₀_nhdsNE : ∀ᶠ w in nhdsWithin (0 : ℂ) {(0 : ℂ)}ᶜ, g₀ w ≠ 0 := by
      rcases (hg₀_ana 0 (Metric.mem_ball_self hR_y)).eventually_eq_zero_or_eventually_ne_zero
        with hev0 | hev_ne
      · exfalso
        exact hg₀_wnz (hg₀_ana.eqOn_zero_of_preconnected_of_eventuallyEq_zero
          (convex_ball 0 R_y).isPreconnected (Metric.mem_ball_self hR_y) hev0 hw_nz_mem)
      · exact hev_ne
    obtain ⟨ε₀, hε₀_pos, hε₀_nz⟩ := Metric.mem_nhdsWithin_iff.mp hg₀_nhdsNE
    let r_y : ℝ := min R_y ε₀ / 2
    have hr_y_pos : 0 < r_y := by dsimp [r_y]; positivity
    have hr_y_le : r_y ≤ R_y := by
      dsimp [r_y]; linarith [min_le_left R_y ε₀]
    have h32_lt_Ry : 3 * r_y / 2 < R_y := by
      dsimp [r_y]; linarith [min_le_left R_y ε₀]
    have h32_lt_ε₀ : 3 * r_y / 2 < ε₀ := by
      dsimp [r_y]; linarith [min_le_right R_y ε₀]
    let K_ann : Set ℂ := Metric.closedBall (0 : ℂ) (3 * r_y / 2) \ Metric.ball (0 : ℂ) (r_y / 2)
    have hK_ann_compact : IsCompact K_ann :=
      (ProperSpace.isCompact_closedBall (0 : ℂ) (3 * r_y / 2)).diff Metric.isOpen_ball
    have hK_ann_nz0 : ∀ w ∈ K_ann, H_loc (y₀ + w, t_tilde) ≠ 0 := by
      intro w ⟨hw_cl, hw_not_ball⟩
      have hw_norm_le : ‖w‖ ≤ 3 * r_y / 2 := by simpa [Metric.mem_closedBall] using hw_cl
      have hw_norm_ge : r_y / 2 ≤ ‖w‖ := by
        have := mt (fun h : ‖w‖ < r_y / 2 => by simpa [Metric.mem_ball] using h) hw_not_ball
        linarith
      have hw_ne : w ∈ ({(0 : ℂ)}ᶜ : Set ℂ) := by
        intro hw0
        rw [Set.mem_singleton_iff] at hw0
        rw [hw0, norm_zero] at hw_norm_ge
        linarith
      have hw_lt_ε₀ : w ∈ Metric.ball (0 : ℂ) ε₀ := by
        simpa [Metric.mem_ball, dist_zero_right] using lt_of_le_of_lt hw_norm_le h32_lt_ε₀
      exact hε₀_nz ⟨hw_lt_ε₀, hw_ne⟩
    have h_exists_rt :
        ∃ r_t : ℝ, 0 < r_t ∧ r_t ≤ R_t ∧
          ∀ w ∈ K_ann, ∀ t ∈ Metric.ball t_tilde r_t, H_loc (y₀ + w, t) ≠ 0 := by
      by_contra h_no
      push Not at h_no
      have h_seq : ∀ n : ℕ, ∃ w ∈ K_ann, ∃ t ∈ Metric.ball t_tilde (R_t / ((n : ℝ) + 1)),
          H_loc (y₀ + w, t) = 0 := by
        intro n
        have hpos : 0 < R_t / ((n : ℝ) + 1) := by positivity
        have hle : R_t / ((n : ℝ) + 1) ≤ R_t :=
          div_le_self (le_of_lt hR_t) (by linarith [Nat.cast_nonneg (α := ℝ) n])
        exact h_no (R_t / ((n : ℝ) + 1)) hpos hle
      choose w_s hw_s t_s ht_s hH_s using h_seq
      obtain ⟨w_lim, hw_lim, φ, hφ_mono, hw_tend⟩ := hK_ann_compact.tendsto_subseq hw_s
      have ht_tend : Filter.Tendsto (t_s ∘ φ) Filter.atTop (nhds t_tilde) := by
        rw [Metric.tendsto_nhds]
        intro ε hε
        have hdiv_zero : Filter.Tendsto (fun k : ℕ => R_t / ((φ k : ℝ) + 1))
            Filter.atTop (nhds 0) :=
          tendsto_const_nhds.div_atTop
            ((Filter.tendsto_atTop_add_const_right Filter.atTop 1
              tendsto_natCast_atTop_atTop).comp hφ_mono.tendsto_atTop)
        filter_upwards [hdiv_zero.eventually (gt_mem_nhds hε)] with k hk
        exact lt_trans (Metric.mem_ball.mp (ht_s (φ k))) hk
      have hw_in_Ry : y₀ + w_lim ∈ Metric.ball y₀ R_y := by
        have hw_le : ‖w_lim‖ ≤ 3 * r_y / 2 := by simpa [Metric.mem_closedBall] using hw_lim.1
        rw [Metric.mem_ball, dist_eq_norm, add_sub_cancel_left]
        exact lt_of_le_of_lt hw_le h32_lt_Ry
      have hH_cont : ContinuousAt H_loc (y₀ + w_lim, t_tilde) :=
        (hHolo_loc.differentiableAt (hBidisk_open.mem_nhds
          ⟨hw_in_Ry, Metric.mem_ball_self hR_t⟩)).continuousAt
      have hpair_tend : Filter.Tendsto (fun k : ℕ => (y₀ + w_s (φ k), t_s (φ k)))
          Filter.atTop (nhds (y₀ + w_lim, t_tilde)) :=
        (hw_tend.const_add y₀).prodMk_nhds ht_tend
      have hH_tend : Filter.Tendsto (fun k : ℕ => H_loc (y₀ + w_s (φ k), t_s (φ k)))
          Filter.atTop (nhds (H_loc (y₀ + w_lim, t_tilde))) :=
        hH_cont.tendsto.comp hpair_tend
      have hH_ev0 : (fun k : ℕ => H_loc (y₀ + w_s (φ k), t_s (φ k))) = fun _ => (0 : ℂ) := by
        ext k; exact hH_s (φ k)
      rw [hH_ev0] at hH_tend
      exact hK_ann_nz0 w_lim hw_lim (tendsto_nhds_unique hH_tend tendsto_const_nhds)
    obtain ⟨r_t, hr_t_pos, hr_t_le, hK_ann_nz⟩ := h_exists_rt
    let B32 : Set ℂ := Metric.ball (0 : ℂ) (3 * r_y / 2)
    let D_t : Set ℂ := Metric.ball t_tilde r_t
    have hry_B32 : (r_y : ℂ) ∈ B32 := by
      rw [Metric.mem_ball, dist_zero_right, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hr_y_pos]
      linarith
    have hry_Kann : (r_y : ℂ) ∈ K_ann := by
      refine ⟨?_, ?_⟩
      · rw [Metric.mem_closedBall, dist_zero_right, Complex.norm_real, Real.norm_eq_abs,
          abs_of_pos hr_y_pos]; linarith
      · rw [Metric.mem_ball, dist_zero_right, Complex.norm_real, Real.norm_eq_abs,
          abs_of_pos hr_y_pos]; linarith
    have h_factor_one :
        ∀ (g : ℂ → ℂ), DifferentiableOn ℂ g B32 → g (r_y : ℂ) ≠ 0 →
          ∀ α ∈ B32, g α = 0 →
            ∃ (μ : ℕ) (g₁ : ℂ → ℂ),
              1 ≤ μ ∧ DifferentiableOn ℂ g₁ B32 ∧ g₁ (r_y : ℂ) ≠ 0 ∧ g₁ α ≠ 0 ∧
              (∀ z : ℂ, g z = (z - α) ^ μ * g₁ z) := by
      intro g hg hg_ry α hα hgα
      have hg_ana : AnalyticOnNhd ℂ g B32 := hg.analyticOnNhd Metric.isOpen_ball
      have hord_ry_zero : analyticOrderAt g (r_y : ℂ) = 0 :=
        not_ne_iff.mp (mt (hg_ana (r_y : ℂ) hry_B32).analyticOrderAt_ne_zero.mp hg_ry)
      have hord_ry_ne_top : analyticOrderAt g (r_y : ℂ) ≠ ⊤ := by
        rw [hord_ry_zero]; exact ENat.zero_ne_top
      have hord_α_ne_top : analyticOrderAt g α ≠ ⊤ :=
        hg_ana.analyticOrderAt_ne_top_of_isPreconnected
          (convex_ball 0 (3 * r_y / 2)).isPreconnected hry_B32 hα hord_ry_ne_top
      obtain ⟨h_loc, hh_ana, hh_nz, hev⟩ :=
        (hg_ana α hα).analyticOrderAt_ne_top.mp hord_α_ne_top
      let μ : ℕ := analyticOrderNatAt g α
      have hμ_pos : 1 ≤ μ := by
        by_contra hμ0
        have hμ_eq : μ = 0 := by omega
        have hval := hev.self_of_nhds
        change g α = (α - α) ^ μ • h_loc α at hval
        rw [hgα, hμ_eq, pow_zero, one_smul] at hval
        exact hh_nz hval.symm
      let g₁ : ℂ → ℂ := fun z => if z = α then h_loc α else g z / (z - α) ^ μ
      have hg_eq : ∀ z : ℂ, g z = (z - α) ^ μ * g₁ z := by
        intro z
        by_cases hza : z = α
        · subst hza
          rw [sub_self, zero_pow (by omega), zero_mul, hgα]
        · dsimp only [g₁]
          rw [ite_eq_right_iff.mpr (fun h => (hza h).elim),
            mul_div_cancel₀ _ (pow_ne_zero μ (sub_ne_zero.mpr hza))]
      have hg₁_holo : DifferentiableOn ℂ g₁ B32 := by
        intro z hz
        apply DifferentiableAt.differentiableWithinAt
        by_cases hza : z = α
        · subst hza
          refine hh_ana.differentiableAt.congr_of_eventuallyEq ?_
          filter_upwards [hev] with w hw
          by_cases hwa : w = z
          · simp [g₁, hwa]
          · dsimp only [g₁] at *
            rw [ite_eq_right_iff.mpr (fun h => (hwa h).elim), hw, smul_eq_mul,
              mul_div_cancel_left₀ _ (pow_ne_zero μ (sub_ne_zero.mpr hwa))]
        · have hdiff_div : DifferentiableAt ℂ (fun w => g w / (w - α) ^ μ) z :=
            (hg.differentiableAt (Metric.isOpen_ball.mem_nhds hz)).div
              ((differentiableAt_id.sub_const α).pow μ)
              (pow_ne_zero μ (sub_ne_zero.mpr hza))
          refine hdiff_div.congr_of_eventuallyEq ?_
          filter_upwards [isOpen_compl_singleton.mem_nhds hza] with w hw
          simp [g₁, Set.mem_compl_singleton_iff.mp hw]
      have hg₁_ry : g₁ (r_y : ℂ) ≠ 0 := by
        intro h0
        apply hg_ry
        rw [hg_eq (r_y : ℂ), h0, mul_zero]
      have hg₁_α : g₁ α ≠ 0 := by simp [g₁, hh_nz]
      exact ⟨μ, g₁, hμ_pos, hg₁_holo, hg₁_ry, hg₁_α, hg_eq⟩
    have h_factor_finset :
        ∀ (S : Finset ℂ) (g : ℂ → ℂ),
          DifferentiableOn ℂ g B32 → g (r_y : ℂ) ≠ 0 →
          (∀ w ∈ B32, g w = 0 → w ∈ S) →
          (∀ α ∈ S, ‖α‖ < r_y / 2) →
          ∃ (L : List ℂ) (u : ℂ → ℂ),
            (∀ α ∈ L, ‖α‖ < r_y / 2) ∧
            DifferentiableOn ℂ u B32 ∧
            (∀ w ∈ B32, u w ≠ 0) ∧
            (∀ w : ℂ, g w = (L.map (fun α => w - α)).prod * u w) := by
      intro S
      induction S using Finset.induction_on with
      | empty =>
        intro g hg hg_ry hzeros _
        refine ⟨[], g, by simp, hg, ?_, by simp⟩
        intro w hw hw0
        exact Finset.notMem_empty w (hzeros w hw hw0)
      | @insert α S hα_not_S ih =>
        intro g hg hg_ry hzeros hrad
        by_cases hgα : g α = 0
        · have hα_norm : ‖α‖ < r_y / 2 := hrad α (Finset.mem_insert_self α S)
          have hα_B32 : α ∈ B32 := by
            rw [Metric.mem_ball, dist_zero_right]
            linarith
          obtain ⟨μ, g₁, _, hg₁_holo, hg₁_ry, hg₁_α, hg_eq⟩ :=
            h_factor_one g hg hg_ry α hα_B32 hgα
          have hzeros₁ : ∀ w ∈ B32, g₁ w = 0 → w ∈ S := by
            intro w hw hw0
            have hgw : g w = 0 := by rw [hg_eq w, hw0, mul_zero]
            rcases Finset.mem_insert.mp (hzeros w hw hgw) with rfl | hwS
            · exact False.elim (hg₁_α hw0)
            · exact hwS
          have hrad₁ : ∀ β ∈ S, ‖β‖ < r_y / 2 :=
            fun β hβ => hrad β (Finset.mem_insert_of_mem hβ)
          obtain ⟨L₁, u, hL₁_rad, hu_holo, hu_nz, hg₁_eq⟩ :=
            ih g₁ hg₁_holo hg₁_ry hzeros₁ hrad₁
          refine ⟨List.replicate μ α ++ L₁, u, ?_, hu_holo, hu_nz, ?_⟩
          · intro β hβ
            rcases List.mem_append.mp hβ with hrep | hmem₁
            · rw [List.eq_of_mem_replicate hrep]; exact hα_norm
            · exact hL₁_rad β hmem₁
          · intro w
            rw [hg_eq w, hg₁_eq w, List.map_append, List.prod_append,
              List.map_replicate, List.prod_replicate, mul_assoc]
        · refine ih g hg hg_ry ?_ (fun β hβ => hrad β (Finset.mem_insert_of_mem hβ))
          intro w hw hw0
          rcases Finset.mem_insert.mp (hzeros w hw hw0) with rfl | hwS
          · exact False.elim (hgα hw0)
          · exact hwS
    have h_slice_factor :
        ∀ t ∈ D_t, ∃ (L : List ℂ) (u : ℂ → ℂ),
          (∀ α ∈ L, ‖α‖ < r_y / 2) ∧
          DifferentiableOn ℂ u B32 ∧
          (∀ w ∈ B32, u w ≠ 0) ∧
          (∀ w : ℂ, H_loc (y₀ + w, t) = (L.map (fun α => w - α)).prod * u w) := by
      intro t ht
      let f_t : ℂ → ℂ := fun w => H_loc (y₀ + w, t)
      have hft_holo : DifferentiableOn ℂ f_t B32 := by
        refine hHolo_loc.comp ((differentiable_id.const_add y₀).prodMk
          (differentiable_const t)).differentiableOn ?_
        intro w hw
        refine ⟨?_, Metric.ball_subset_ball hr_t_le ht⟩
        rw [Metric.mem_ball, dist_eq_norm, add_sub_cancel_left]
        exact lt_trans (by simpa [B32, Metric.mem_ball] using hw) h32_lt_Ry
      have hft_ry : f_t (r_y : ℂ) ≠ 0 := hK_ann_nz (r_y : ℂ) hry_Kann t ht
      have hZ_fin : ({ z : ℂ | z ∈ Metric.closedBall (0 : ℂ) (r_y / 2) ∧ f_t z = 0 }).Finite :=
        (h_zero_disc_cnt_fin 0 (3 * r_y / 2) (by linarith) f_t hft_holo
          ⟨(r_y : ℂ), hry_B32, hft_ry⟩).2 (r_y / 2) (by linarith)
      let S_t : Finset ℂ := hZ_fin.toFinset
      have hzeros_sub : ∀ w ∈ B32, f_t w = 0 → w ∈ S_t := by
        intro w hw hfw0
        rw [Set.Finite.mem_toFinset]
        refine ⟨?_, hfw0⟩
        by_contra hw_not_cl
        have hw_gt : r_y / 2 < ‖w‖ := by
          have := mt (fun h : ‖w‖ ≤ r_y / 2 => by simpa [Metric.mem_closedBall] using h) hw_not_cl
          linarith
        have hw_Kann : w ∈ K_ann :=
          ⟨Metric.ball_subset_closedBall hw,
           fun hb => not_lt_of_ge (le_of_lt hw_gt) (by simpa [Metric.mem_ball] using hb)⟩
        exact hK_ann_nz w hw_Kann t ht hfw0
      have hrad_St : ∀ α ∈ S_t, ‖α‖ < r_y / 2 := by
        intro α hα
        obtain ⟨hα_cl, hα_zero⟩ := hZ_fin.mem_toFinset.mp hα
        by_contra h_ge
        have hα_Kann : α ∈ K_ann :=
          ⟨Metric.closedBall_subset_closedBall (by linarith) hα_cl,
           fun hb => h_ge (by simpa [Metric.mem_ball] using hb)⟩
        exact hK_ann_nz α hα_Kann t ht hα_zero
      exact h_factor_finset S_t f_t hft_holo hft_ry hzeros_sub hrad_St
    let p_fn : ℕ → ℂ → ℂ := fun k t =>
      (2 * ↑Real.pi * Complex.I)⁻¹ *
        ∮ w in C(0, r_y), w ^ k * (pderivA H_loc (y₀ + w, t) / H_loc (y₀ + w, t))
    let U_ann : Set (ℂ × ℂ) :=
      { w : ℂ | r_y / 2 < ‖w‖ ∧ ‖w‖ < 3 * r_y / 2 } ×ˢ D_t
    have hU_ann_open : IsOpen U_ann :=
      ((isOpen_lt continuous_const continuous_norm).inter
        (isOpen_lt continuous_norm continuous_const)).prod Metric.isOpen_ball
    have hU_ann_nz : ∀ q ∈ U_ann, H_loc (y₀ + q.1, q.2) ≠ 0 := by
      intro q ⟨⟨hq1_gt, hq1_lt⟩, hq2⟩
      have hq1_Kann : q.1 ∈ K_ann :=
        ⟨by simpa [Metric.mem_closedBall] using le_of_lt hq1_lt,
         fun hb => not_lt_of_ge (le_of_lt hq1_gt) (by simpa [Metric.mem_ball] using hb)⟩
      exact hK_ann_nz q.1 hq1_Kann q.2 hq2
    have hpA_H_holo : DifferentiableOn ℂ (pderivA H_loc)
        (Metric.ball y₀ R_y ×ˢ Metric.ball t_tilde R_t) :=
      (hpderiv_holo hBidisk_open hHolo_loc).1
    have hp_fn_holo : ∀ k : ℕ, DifferentiableOn ℂ (p_fn k) D_t := by
      intro k t₀ ht₀
      apply DifferentiableAt.differentiableWithinAt
      let F_k : ℂ × ℂ → ℂ := fun q =>
        q.1 ^ k * (pderivA H_loc (y₀ + q.1, q.2) / H_loc (y₀ + q.1, q.2))
      have hshift_holo : Differentiable ℂ (fun q : ℂ × ℂ => (y₀ + q.1, q.2)) :=
        (differentiable_fst.const_add y₀).prodMk differentiable_snd
      have hshift_maps : Set.MapsTo (fun q : ℂ × ℂ => (y₀ + q.1, q.2)) U_ann
          (Metric.ball y₀ R_y ×ˢ Metric.ball t_tilde R_t) := by
        intro q ⟨⟨_, hq1_lt⟩, hq2⟩
        refine ⟨?_, Metric.ball_subset_ball hr_t_le hq2⟩
        rw [Metric.mem_ball, dist_eq_norm, add_sub_cancel_left]
        exact lt_trans hq1_lt h32_lt_Ry
      have hshift_on : DifferentiableOn ℂ (fun q : ℂ × ℂ => (y₀ + q.1, q.2)) U_ann :=
        hshift_holo.differentiableOn
