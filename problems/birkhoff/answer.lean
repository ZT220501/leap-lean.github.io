        dsimp [lamZ]; ring
      rw [heq, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hΛ_pos]
      have hw_norm : ‖(1 / 3 : ℂ) * Complex.log (PhiQ z)‖ < 1 / 15 := by
        rw [norm_mul, show ‖(1 / 3 : ℂ)‖ = 1 / 3 by norm_num]
        linarith
