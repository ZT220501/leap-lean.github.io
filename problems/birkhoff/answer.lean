          ENNReal.ofReal B := by
        rw [h_ofReal_raw]
        exact le_trans h_lint_le h_sup_le
      exact (ENNReal.ofReal_le_ofReal_iff hB).mp h_tot
    have h_slab_max : ∀ (a b : ℝ) (Φ : ℂ → ℝ),
        a < b →
        ContinuousOn Φ { z : ℂ | a ≤ z.im ∧ z.im ≤ b } →
        (∀ z : ℂ, a ≤ z.im → z.im ≤ b → Φ (z + 2 * Real.pi) = Φ z) →
        (∀ x : ℝ, Φ ((x : ℂ) + (a : ℂ) * Complex.I) ≤ 0 ∧
          Φ ((x : ℂ) + (b : ℂ) * Complex.I) ≤ 0) →
        (∀ z₀ : ℂ, a < z₀.im → z₀.im < b →
          ∃ r₀ : ℝ, 0 < r₀ ∧ ∀ r : ℝ, 0 < r → r < r₀ →
            Φ z₀ ≤ Real.circleAverage Φ z₀ r) →
        ∀ z : ℂ, a ≤ z.im → z.im ≤ b → Φ z ≤ 0 := by
      intro a b Φ hab hΦ_cont hΦ_per hΦ_bdry hΦ_sub
      have hper_int : ∀ (k : ℤ) (z : ℂ), a ≤ z.im → z.im ≤ b →
          Φ (z + (k : ℂ) * (2 * Real.pi)) = Φ z := by
        intro k
        induction k using Int.induction_on with
        | zero => intro z _ _; simp
        | succ n ih =>
          intro z hza hzb
          have ih' : Φ (z + (n : ℂ) * (2 * Real.pi)) = Φ z := by
            simpa using ih z hza hzb
          have h_eq : z + (((n : ℤ) + 1 : ℤ) : ℂ) * (2 * Real.pi) =
              (z + (n : ℂ) * (2 * Real.pi)) + 2 * Real.pi := by push_cast; ring
          rw [h_eq]
          have him : (z + (n : ℂ) * (2 * Real.pi)).im = z.im := by simp
          rw [hΦ_per _ (by linarith) (by linarith), ih']
        | pred n ih =>
          intro z hza hzb
          have ih' : Φ (z + (-(n : ℂ)) * (2 * Real.pi)) = Φ z := by
            simpa using ih z hza hzb
          let w : ℂ := z + ((-(n : ℤ) - 1 : ℤ) : ℂ) * (2 * Real.pi)
          have hw_im : w.im = z.im := by dsimp [w]; simp
          have hw_step : w + 2 * Real.pi = z + (-(n : ℂ)) * (2 * Real.pi) := by
            dsimp [w]; push_cast; ring
          have h1 := hΦ_per w (by linarith) (by linarith)
          rw [hw_step] at h1
          exact h1.symm.trans ih'
      let γ : ℝ × ℝ → ℂ := fun p =>
        (p.1 : ℂ) + ((max a (min p.2 b) : ℝ) : ℂ) * Complex.I
      have hγ_cont : Continuous γ := by dsimp [γ]; fun_prop
      have hγ_mem : ∀ p : ℝ × ℝ, γ p ∈ { z : ℂ | a ≤ z.im ∧ z.im ≤ b } := by
        intro p
        have him : (γ p).im = max a (min p.2 b) := by simp [γ]
        change a ≤ (γ p).im ∧ (γ p).im ≤ b
        rw [him]
        exact ⟨le_max_left _ _, max_le hab.le (min_le_right _ _)⟩
      let ψ : ℝ × ℝ → ℝ := fun p => Φ (γ p)
      have hψ_cont : Continuous ψ := hΦ_cont.comp_continuous hγ_cont hγ_mem
      let Q : Set (ℝ × ℝ) := Set.Icc (0 : ℝ) (2 * Real.pi) ×ˢ Set.Icc a b
      have hQ_compact : IsCompact Q := isCompact_Icc.prod isCompact_Icc
      have hQ_nonempty : Q.Nonempty := ⟨(0, a), ⟨by positivity, by positivity⟩, le_refl a, hab.le⟩
      obtain ⟨p_max, hp_max_Q, hp_max⟩ := hQ_compact.exists_isMaxOn hQ_nonempty hψ_cont.continuousOn
      let M : ℝ := ψ p_max
      have hΦ_le_M : ∀ z : ℂ, a ≤ z.im → z.im ≤ b → Φ z ≤ M := by
