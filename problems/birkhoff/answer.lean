        dsimp [Δx₀]
        rw [hx₀_real δ hδ_mem i.succ, hx₀_real δ hδ_mem i.castSucc, sub_zero]
      have hw2_re : 0 < (Δx₀ δ i * pculSlopeSpeed v_a (m₀ δ i)).re := by
        rw [Complex.mul_re, hdx_im, zero_mul, sub_zero]
        exact mul_pos hdx_re (lt_trans (half_pos hs_a_pos) hσ_re)
