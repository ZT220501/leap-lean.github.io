    refine ⟨A_fn, J_fn, hA_pos, ?_⟩
    intro j R hR_le
    rcases hDiag.row_basic j with ⟨hh_pos, _, _, hℓ_pos, hm0_pos, _, _⟩
    have hm0_sq_pos : 0 < (m0_seq j) ^ 2 := sq_pos_of_pos hm0_pos
    have hR_le_r : (R : ℝ) ≤ (j : ℝ) + 1 := by exact_mod_cast hR_le
    have hr_pos : 0 < ((R : ℝ) + 1) * ℓ_seq j := by positivity
    have h_strip : |h_seq j| + (3 / 2 : ℝ) * (((R : ℝ) + 1) * ℓ_seq j) < S.H := by
      let u_top : ℝ := (3 / 2 : ℝ) * ((R : ℝ) + 1)
      have hj_nn : (0 : ℝ) ≤ (j : ℝ) := Nat.cast_nonneg j
      have hR_nn : (0 : ℝ) ≤ (R : ℝ) := Nat.cast_nonneg R
      have hu_mem : u_top ∈ Set.Icc (-2 * ((j : ℝ) + 2)) (2 * ((j : ℝ) + 2)) := by
        dsimp only [u_top]; constructor <;> linarith
      have hb := (hDiag.local_band_bound j u_top hu_mem).1
      have hpos_inside : 0 < h_seq j + ℓ_seq j * u_top := by positivity
      rw [abs_of_pos hh_pos]
      rw [abs_of_pos hpos_inside] at hb
      dsimp only [u_top] at hb
      linarith
    rcases hMaj (h_seq j) (((R : ℝ) + 1) * ℓ_seq j) hr_pos h_strip with
      ⟨hm_cont, _, hm_dom, hm_mean⟩
    refine ⟨hm_cont.div_const _, fun x => div_nonneg (hm_dom x).1 hm0_sq_pos.le,
      fun x z hz => div_le_div_of_nonneg_right ((hm_dom x).2 z hz) hm0_sq_pos.le, ?_⟩
    dsimp only [J_fn]
    rw [intervalIntegral.integral_div, ← mul_div_assoc, hm_mean,
      mul_div_assoc, ← intervalIntegral.integral_div]
    have hcont_E : Continuous (fun θ : ℝ =>
        steepRowEnergy S (h_seq j + (3 / 2 : ℝ) * (((R : ℝ) + 1) * ℓ_seq j) * Real.sin θ) /
          (m0_seq j) ^ 2) := by
      simp_rw [hE_Φ]
      have hbiv : Continuous (Function.uncurry (fun (θ : ℝ) (x : ℝ) =>
