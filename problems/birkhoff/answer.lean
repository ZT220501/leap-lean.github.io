          h_nonneg_of_norm_le K m w hK (hnorm w (Metric.ball_subset_closedBall hw))
      have h_ofReal_raw : ENNReal.ofReal (∫ w in Metric.ball z₀ Δ, (K - Real.log ‖S.f w‖)) =
