  have hstrip_conv : ∀ H : ℝ, 0 < H → Convex ℝ (horizStrip H) := by
    intro H _ z₁ hz₁ z₂ hz₂ u₁ u₂ hu₁ hu₂ hu_sum
    simp only [horizStrip, Set.mem_ofPred_eq] at hz₁ hz₂ ⊢
