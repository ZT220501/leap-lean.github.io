          have hinner : ΔW + (2 : ℝ) ^ m * M * ΔH ≤ (1 + (2 : ℝ) ^ m * M) * (ΔH + ΔW) := by
            nlinarith
          calc skrCompConst m 2 * (ΔW + (2 : ℝ) ^ m * M * ΔH)
              ≤ skrCompConst m 2 * ((1 + (2 : ℝ) ^ m * M) * (ΔH + ΔW)) :=
                mul_le_mul_of_nonneg_left hinner hcc
            _ = L_sl * Δ := by dsimp [L_sl, Δ]; ring
        exact ⟨h1, h2, hCalc.bnd_mono hL_le hDiffRaw⟩
      have hContEta : ∀ z ∈ horizStrip σ',
          ContinuousOn (fun η : ℝ => deriv W₁ (z + ((η * c : ℝ) : ℂ) * H₁ z))
            (Set.Icc (0 : ℝ) 1) ∧
          ContinuousOn (fun η : ℝ => deriv W₂ (z + ((η * c : ℝ) : ℂ) * H₂ z))
            (Set.Icc (0 : ℝ) 1) := by
        intro z hz
        refine ⟨hdW₁.1.continuousOn.comp ?_ ?_, hdW₂.1.continuousOn.comp ?_ ?_⟩
        · exact continuousOn_const.add
            ((Complex.continuous_ofReal.comp (continuous_id.mul continuous_const)).continuousOn.mul
