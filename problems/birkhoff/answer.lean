    rw [hJ_curr, hJ_prev, h_s_deriv]
    have hd1 : deriv (fun J' => P.p_act s_curr J' t_step) q_curr.2.1 = F_DJ n q_curr := rfl
    have hd2 : deriv (fun J' => P.p_act s_prev J' t_step) q_prev.2.1 = F_DJ n q_prev := rfl
    rw [hd1, hd2]
    exact sub_eq_zero.symm
  
