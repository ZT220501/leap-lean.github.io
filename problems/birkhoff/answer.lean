      have hmR := hHolo_mul hnum_R.1 (hInvEdge_tay i_R).1
      have hsub := hHolo_sub hmL.1 hmR.1
      have heq_ps : holoTaylor1D
          (fun ε => pointRelInteriorGrad ℓ₀ (pointArcPertGraph F g ε)
