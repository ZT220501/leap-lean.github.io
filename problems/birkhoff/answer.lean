                        (F_val.add_mem F_val.one_mem (F_val.pow_mem (hJ1 i_L.succ) 2))
                        (F_val.mul_mem hΔYL (hJ2 i_L.succ)))
                      (F_val.pow_mem (hℓ_mem i_L) 2))
                    (F_val.pow_mem hnLs 2))
