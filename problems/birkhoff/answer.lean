            N_vert i₀ q c p / D_vert i₀ q c p = N_vert i₁ q c p / D_vert i₁ q c p) ∧
      (let i_top : Fin L_vert := ⟨L_vert - 1, Nat.sub_lt hL_pos Nat.one_pos⟩
