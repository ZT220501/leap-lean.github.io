    intro m hm w
    set y := dtpcStopX R g m w
    have hy : |y| ≤ B := hStopX_bdd m hm w
    rw [abs_of_nonneg (hTanakaAlg y 0).1]
    have hry : Real.sqrt (h ^ 2 + y ^ 2) ≤ h + |y| := by
      rw [Real.sqrt_le_left (by positivity)]
      nlinarith [sq_abs y, abs_nonneg y]
    change Real.sqrt (h ^ 2 + y ^ 2) + y ≤ h + 2 * B
    have hy2 : y ≤ |y| := le_abs_self y
    linarith
  have hDriftNonneg : ∀ m < M,
