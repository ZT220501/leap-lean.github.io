    have hμ_ge_diff : |y - x| ≤ μ := le_max_left _ _
    have hμ_pos : 0 < μ := lt_of_lt_of_le hh hμ_ge_h
    have hx_sq_le : x ^ 2 ≤ h ^ 2 := by nlinarith [sq_abs x, abs_nonneg x]
    have hrx_le : rx ≤ (3 / 2 : ℝ) * h := by
      rw [Real.sqrt_le_left (by positivity)]
