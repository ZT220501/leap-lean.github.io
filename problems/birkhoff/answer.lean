    let Δη : ℝ := (H₂ - ρ) / (L_vert : ℝ)
    have hΔη_pos : 0 < Δη := div_pos hH₂_sub_pos hL_real_pos
    have hΔη_mul : (L_vert : ℝ) * Δη = H₂ - ρ :=
