      have hΦ_p := h_fderiv_partials hΩsq_open hΦ_Ωsq hp
      refine (p1.hasFDerivAt.prodMk hΦ_p).congr_fderiv
        (ContinuousLinearMap.ext fun ⟨dv, du⟩ => ?_)
      ext <;> simp [L_tri, p1, p2, a_fn, b_fn, mul_comm]
    have hL_cont : ContinuousAt (fun p => L_tri (a_fn p) (b_fn p)) p₀ := by
      rw [Metric.continuousAt_iff]
      intro ε hε
      obtain ⟨δ₁, hδ₁_pos, hδ₁⟩ := Metric.continuousAt_iff.mp ha_cont (ε / 3) (by positivity)
      obtain ⟨δ₂, hδ₂_pos, hδ₂⟩ := Metric.continuousAt_iff.mp hb_cont (ε / 3) (by positivity)
      refine ⟨min δ₁ δ₂, lt_min hδ₁_pos hδ₂_pos, fun p hp => ?_⟩
      have ha_lt : ‖a_fn p - a_fn p₀‖ < ε / 3 :=
        dist_eq_norm (a_fn p) (a_fn p₀) ▸ hδ₁ (lt_of_lt_of_le hp (min_le_left _ _))
      have hb_lt : ‖b_fn p - b_fn p₀‖ < ε / 3 :=
        dist_eq_norm (b_fn p) (b_fn p₀) ▸ hδ₂ (lt_of_lt_of_le hp (min_le_right _ _))
      rw [dist_eq_norm]
      have hle : ‖L_tri (a_fn p) (b_fn p) - L_tri (a_fn p₀) (b_fn p₀)‖ ≤
          ‖a_fn p - a_fn p₀‖ + ‖b_fn p - b_fn p₀‖ := by
        refine ContinuousLinearMap.opNorm_le_bound _ (by positivity) fun d => ?_
        have hd_eq : (L_tri (a_fn p) (b_fn p) - L_tri (a_fn p₀) (b_fn p₀)) d =
            ((0 : ℂ), (a_fn p * d.1 + b_fn p * d.2) - (a_fn p₀ * d.1 + b_fn p₀ * d.2)) := by
          ext
          · simp [L_tri]
          · rfl
        rw [hd_eq, Prod.norm_def, norm_zero, max_eq_right (norm_nonneg _)]
        have hlin : (a_fn p * d.1 + b_fn p * d.2) - (a_fn p₀ * d.1 + b_fn p₀ * d.2) =
            (a_fn p - a_fn p₀) * d.1 + (b_fn p - b_fn p₀) * d.2 := by ring
        rw [hlin]
        have hd1 : ‖d.1‖ ≤ ‖d‖ := norm_fst_le d
        have hd2 : ‖d.2‖ ≤ ‖d‖ := norm_snd_le d
        calc
          ‖(a_fn p - a_fn p₀) * d.1 + (b_fn p - b_fn p₀) * d.2‖
              ≤ ‖a_fn p - a_fn p₀‖ * ‖d.1‖ + ‖b_fn p - b_fn p₀‖ * ‖d.2‖ := by
                refine le_trans (norm_add_le _ _) ?_
                simp only [norm_mul, le_refl]
          _ ≤ ‖a_fn p - a_fn p₀‖ * ‖d‖ + ‖b_fn p - b_fn p₀‖ * ‖d‖ := by gcongr
          _ = (‖a_fn p - a_fn p₀‖ + ‖b_fn p - b_fn p₀‖) * ‖d‖ := by ring
      linarith
    have hb_ne : b_fn p₀ ≠ 0 := by
      intro hb0
      have hE_diff0 : DifferentiableAt ℂ (fun z => E_sq (q₀.1, z)) u₀ :=
        ((hE_holo.mono hΩsq_sub_Ω1).differentiableAt (hΩsq_open.mem_nhds hp₀_mem)).comp u₀
          ((differentiableAt_const q₀.1).prodMk differentiableAt_id)
      have hb_eq : b_fn p₀ = 1 + deriv (fun z => E_sq (q₀.1, z)) u₀ :=
        ((hasDerivAt_id u₀).add hE_diff0.hasDerivAt).deriv
      have hle := hE_deriv_le q₀.1 hq₀.1 u₀ hp₀_mem.2
      have h1 : (1 : ℝ) ≤ 1 / 4 := by
        calc
          (1 : ℝ) = ‖-(1 : ℂ)‖ := by simp
          _ = ‖deriv (fun z => E_sq (q₀.1, z)) u₀‖ := by
                congr 1; linear_combination hb_eq - hb0
          _ ≤ 1 / 4 := hle
      norm_num at h1
    let M_inv : (ℂ × ℂ) →L[ℂ] (ℂ × ℂ) :=
      @ContinuousLinearMap.mk ℂ ℂ _ _ (RingHom.id ℂ) (ℂ × ℂ) _ _ (ℂ × ℂ) _ _
        NormedSpace.toModule NormedSpace.toModule
        { toFun := fun d => (d.1, (b_fn p₀)⁻¹ * (d.2 - a_fn p₀ * d.1))
          map_add' := fun x y => by
            ext
            · rfl
            · simp; ring
          map_smul' := fun c x => by
            ext
            · rfl
            · simp; ring }
        (continuous_fst.prodMk
          (continuous_const.mul (continuous_snd.sub (continuous_const.mul continuous_fst))))
    let e_Ψ : (ℂ × ℂ) ≃L[ℂ] (ℂ × ℂ) :=
      ContinuousLinearEquiv.equivOfInverse (L_tri (a_fn p₀) (b_fn p₀)) M_inv
        (fun d => by
          ext
          · rfl
          · change (b_fn p₀)⁻¹ * ((a_fn p₀ * d.1 + b_fn p₀ * d.2) - a_fn p₀ * d.1) = d.2
            field_simp [hb_ne]; ring)
        (fun d => by
          ext
          · rfl
          · change a_fn p₀ * d.1 + b_fn p₀ * ((b_fn p₀)⁻¹ * (d.2 - a_fn p₀ * d.1)) = d.2
            field_simp [hb_ne]; ring)
    have hStrict : HasStrictFDerivAt Ψ (e_Ψ : (ℂ × ℂ) →L[ℂ] (ℂ × ℂ)) p₀ :=
      hasStrictFDerivAt_of_hasFDerivAt_of_continuousAt
        (Filter.eventually_of_mem (hΩsq_open.mem_nhds hp₀_mem) hΨ_fderiv) hL_cont
    let φ := hStrict.toOpenPartialHomeomorph Ψ
    have hp₀_src : p₀ ∈ φ.source := hStrict.mem_toOpenPartialHomeomorph_source
    have hφ_p₀ : φ p₀ = q₀ := by
      rw [HasStrictFDerivAt.toOpenPartialHomeomorph_coe, hΨ_p₀]
    have hq₀_tgt : q₀ ∈ φ.target := hφ_p₀ ▸ φ.map_source hp₀_src
    have hsymm_fderiv : HasFDerivAt φ.symm (e_Ψ.symm : (ℂ × ℂ) →L[ℂ] (ℂ × ℂ)) q₀ :=
      φ.hasFDerivAt_symm hq₀_tgt (by
        rw [← hφ_p₀, φ.left_inv hp₀_src, HasStrictFDerivAt.toOpenPartialHomeomorph_coe]
        exact hStrict.hasFDerivAt)
    have hsymm_cont : ContinuousAt φ.symm q₀ := hsymm_fderiv.differentiableAt.continuousAt
    have hsymm_q₀ : φ.symm q₀ = p₀ := by rw [← hφ_p₀, φ.left_inv hp₀_src]
    have hev_eq : (fun q : ℂ × ℂ => (φ.symm q).2) =ᶠ[nhds q₀] U_inv := by
      have hmem1 : W_inv ∈ nhds q₀ := hWinv_open.mem_nhds hq₀
      have hmem2 : φ.target ∈ nhds q₀ := φ.open_target.mem_nhds hq₀_tgt
      have hmem3 : φ.symm ⁻¹' Ω_sq ∈ nhds q₀ :=
        hsymm_cont.preimage_mem_nhds (hsymm_q₀.symm ▸ hΩsq_open.mem_nhds hp₀_mem)
      filter_upwards [hmem1, hmem2, hmem3] with q hqW hqt hqΩ
      have hright : Ψ (φ.symm q) = q := by
        simpa [φ, HasStrictFDerivAt.toOpenPartialHomeomorph_coe] using φ.right_inv hqt
      have h1 : (φ.symm q).1 = q.1 := by simpa [Ψ] using congr_arg Prod.fst hright
      have h2 : Φ_sq (q.1, (φ.symm q).2) = q.2 := by
        have hsnd : Φ_sq (φ.symm q) = q.2 := by simpa [Ψ] using congr_arg Prod.snd hright
        rwa [← Prod.eta (φ.symm q), h1] at hsnd
      exact hU_unique q.1 q.2 (φ.symm q).2 hqW hqΩ.2 h2
    exact (p2.differentiableAt.comp q₀ hsymm_fderiv.differentiableAt).congr_of_eventuallyEq
      hev_eq.symm
  
  let δ_rec : ℝ := r_1 / 3
  have hδ_pos : 0 < δ_rec := by positivity
  have hδ_lt_r1 : δ_rec < r_1 := by dsimp [δ_rec]; linarith
  have hδ_lt_r0 : δ_rec < r_0 := lt_trans hδ_lt_r1 hr1_lt_r0
  have hδ_lt_R0 : δ_rec < R_0 := by linarith
  let C_rec : ℝ := 9 * M_C + 1
  have hC_pos : 0 < C_rec := by linarith
  let G_succ : ℂ × ℂ → ℂ := fun p => U_inv (p.1, -Φ_sq (p.1, -p.2))
  let W_rec : Set (ℂ × ℂ) := B_1 ×ˢ Metric.ball (0 : ℂ) δ_rec
  have hB1_sub_B98 : B_1 ⊆ B_98 := Metric.ball_subset_ball (by linarith)
  have h_neg_maps_Ωsq : Set.MapsTo (fun p : ℂ × ℂ => (p.1, -p.2)) W_rec Ω_sq := by
    intro p hp
    refine ⟨hB1_sub_B98 hp.1, ?_⟩
    have hp2 : ‖p.2‖ < δ_rec := by simpa using hp.2
    simpa using lt_trans hp2 hδ_lt_r1
  have h_arg_maps_Winv : Set.MapsTo (fun p : ℂ × ℂ => (p.1, -Φ_sq (p.1, -p.2))) W_rec W_inv := by
    intro p hp
    refine ⟨hB1_sub_B98 hp.1, ?_⟩
    have hp2 : ‖p.2‖ < δ_rec := by simpa using hp.2
    have hΦ_le := (hΦ_norm p.1 (hB1_sub_B98 hp.1) (-p.2) (h_neg_maps_Ωsq hp).2).2
    simp only [Metric.mem_ball, dist_zero_right, norm_neg] at hΦ_le ⊢
    calc
      ‖Φ_sq (p.1, -p.2)‖ ≤ (5 / 4 : ℝ) * ‖p.2‖ := hΦ_le
      _ < (5 / 4 : ℝ) * (r_1 / 3) := by dsimp [δ_rec] at hp2; linarith
      _ < r_1 / 2 := by linarith
  have hG_holo : DifferentiableOn ℂ G_succ W_rec := by
    have hΦ_neg : DifferentiableOn ℂ (fun p : ℂ × ℂ => -Φ_sq (p.1, -p.2)) W_rec := by
      exact ((hΦ_holo.mono hΩsq_sub_Ω1).comp
        (differentiable_fst.prodMk differentiable_snd.neg).differentiableOn h_neg_maps_Ωsq).neg
    exact hU_holo.comp (differentiable_fst.differentiableOn.prodMk hΦ_neg) h_arg_maps_Winv
  have hG_cubic : ∀ V Δ : ℂ, V ∈ B_1 → Δ ∈ Metric.ball (0 : ℂ) δ_rec →
      ‖G_succ (V, Δ) - Δ‖ ≤ C_rec * ‖Δ‖ ^ 3 := by
    intro V Δ hV hΔ
    have hp_rec : (V, Δ) ∈ W_rec := ⟨hV, hΔ⟩
    have hq_inv : (V, -Φ_sq (V, -Δ)) ∈ W_inv := h_arg_maps_Winv hp_rec
    let u : ℂ := G_succ (V, Δ)
    have hu_r1 : u ∈ Metric.ball (0 : ℂ) r_1 := hU_mem _ hq_inv
    have hΦ_u : Φ_sq (V, u) = -Φ_sq (V, -Δ) := hU_spec _ hq_inv
    have hV_98 : V ∈ B_98 := hB1_sub_B98 hV
    have hnegΔ_r1 : -Δ ∈ Metric.ball (0 : ℂ) r_1 := (h_neg_maps_Ωsq hp_rec).2
    have hu_le_2Δ : ‖u‖ ≤ 2 * ‖Δ‖ := by
      have h1 := (hΦ_norm V hV_98 u hu_r1).1
      have h2 := (hΦ_norm V hV_98 (-Δ) hnegΔ_r1).2
      rw [hΦ_u, norm_neg] at h1
      rw [norm_neg] at h2
      linarith [norm_nonneg Δ]
    have hu3_le : ‖u‖ ^ 3 ≤ 8 * ‖Δ‖ ^ 3 := by
      calc
        ‖u‖ ^ 3 ≤ (2 * ‖Δ‖) ^ 3 := by gcongr
        _ = 8 * ‖Δ‖ ^ 3 := by ring
    have hCu_le : ‖C_tilde (V, u)‖ ≤ M_C :=
      le_trans (hMC0 ⟨(V, u), hΩsq_sub_KC ⟨hV_98, hu_r1⟩, rfl⟩) (le_max_left _ _)
    have hCΔ_le : ‖C_tilde (V, -Δ)‖ ≤ M_C :=
      le_trans (hMC0 ⟨(V, -Δ), hΩsq_sub_KC ⟨hV_98, hnegΔ_r1⟩, rfl⟩) (le_max_left _ _)
    have hdiff : u - Δ = Δ ^ 3 * C_tilde (V, -Δ) - u ^ 3 * C_tilde (V, u) := by
      have hexp : u + u ^ 3 * C_tilde (V, u) = -(-Δ + (-Δ) ^ 3 * C_tilde (V, -Δ)) := hΦ_u
      linear_combination hexp
    rw [hdiff]
    calc
      ‖Δ ^ 3 * C_tilde (V, -Δ) - u ^ 3 * C_tilde (V, u)‖
          ≤ ‖Δ ^ 3 * C_tilde (V, -Δ)‖ + ‖u ^ 3 * C_tilde (V, u)‖ := norm_sub_le _ _
      _ = ‖Δ‖ ^ 3 * ‖C_tilde (V, -Δ)‖ + ‖u‖ ^ 3 * ‖C_tilde (V, u)‖ := by simp
      _ ≤ ‖Δ‖ ^ 3 * M_C + (8 * ‖Δ‖ ^ 3) * M_C := by gcongr
      _ = 9 * M_C * ‖Δ‖ ^ 3 := by ring
      _ ≤ C_rec * ‖Δ‖ ^ 3 := by dsimp [C_rec]; nlinarith [pow_nonneg (norm_nonneg Δ) 3]
  let L_line : Fin 2 → ℂ × ℂ → ℂ := fun i p =>
    (if i = 0 then Complex.cos (ϕ_loc p.1) else Complex.sin (ϕ_loc p.1)) / D_act p
  have hWrec_sub_W0 : W_rec ⊆ W_0 :=
    Set.prod_mono hB1_sub_B32 (Metric.ball_subset_ball (le_of_lt hδ_lt_r0))
  have hL_holo : ∀ i : Fin 2, DifferentiableOn ℂ (L_line i) W_rec := by
    intro i
    have hϕ_rec : DifferentiableOn ℂ (fun p : ℂ × ℂ => ϕ_loc p.1) W_rec := by
      exact hϕ_holo.comp differentiable_fst.differentiableOn fun p hp => hB1_sub_B2 hp.1
    have hD_rec : DifferentiableOn ℂ D_act W_rec :=
      hD_holo_WA.mono (hWrec_sub_W0.trans hW0_sub_WA)
    have hD_ne_rec : ∀ p ∈ W_rec, D_act p ≠ 0 :=
      fun p hp => hDen_ne p.1 hp.1 p.2 (Metric.ball_subset_ball (le_of_lt hδ_lt_r0) hp.2)
    have hDinv_rec : DifferentiableOn ℂ (fun p : ℂ × ℂ => (D_act p)⁻¹) W_rec :=
      hD_rec.inv hD_ne_rec
    by_cases hi : i = 0
    · rw [show L_line i = fun p : ℂ × ℂ => Complex.cos (ϕ_loc p.1) * (D_act p)⁻¹ from
        funext fun _ => by simp [L_line, hi, div_eq_mul_inv]]
      exact (Complex.differentiable_cos.comp_differentiableOn hϕ_rec).mul hDinv_rec
    · rw [show L_line i = fun p : ℂ × ℂ => Complex.sin (ϕ_loc p.1) * (D_act p)⁻¹ from
        funext fun _ => by simp [L_line, hi, div_eq_mul_inv]]
      exact (Complex.differentiable_sin.comp_differentiableOn hϕ_rec).mul hDinv_rec
  refine ⟨{
    δ_rec := δ_rec
    C_rec := C_rec
    δ_rec_pos := hδ_pos
    δ_rec_lt := hδ_lt_R0
    C_rec_pos := hC_pos
    G_succ := G_succ
    L_line := L_line
    G_succ_holo := hG_holo
    G_succ_cubic := hG_cubic
    L_line_holo := hL_holo
    L_line_eq := fun V Δ _ _ => ⟨rfl, by simp [L_line, D_act]⟩
    forward_step_unique := fun V Δ_m Δ_p hV hΔm hΔp hguard hstat => by
      rcases hguard with h_nonback | ⟨rfl, rfl⟩
      · have hne : Δ_p ≠ -Δ_m := fun heq => h_nonback (by linear_combination heq)
        have hF_eq : F_norm (V, Δ_p) = F_norm (V, -Δ_m) := hSwap V Δ_m Δ_p hV hstat
        have hV_32 : V ∈ B_32 := hB1_sub_B32 hV
        have hV_54 : V ∈ B_54 := Metric.ball_subset_ball (by linarith) hV
        have hV_98 : V ∈ B_98 := hB1_sub_B98 hV
        have hΔp_r1 : Δ_p ∈ Metric.ball (0 : ℂ) r_1 :=
          Metric.ball_subset_ball (le_of_lt hδ_lt_r1) hΔp
        have hΔm_r1 : -Δ_m ∈ Metric.ball (0 : ℂ) r_1 :=
          (@h_neg_maps_Ωsq (V, Δ_m) ⟨hV, hΔm⟩).2
        have hr1_le_η1 : r_1 ≤ η_1 := by linarith
        have hΔp_η1 : Δ_p ∈ Metric.ball (0 : ℂ) η_1 := Metric.ball_subset_ball hr1_le_η1 hΔp_r1
        have hΔm_η1 : -Δ_m ∈ Metric.ball (0 : ℂ) η_1 := Metric.ball_subset_ball hr1_le_η1 hΔm_r1
        have hΔp_r0 : Δ_p ∈ Metric.ball (0 : ℂ) r_0 :=
          Metric.ball_subset_ball (le_of_lt hr1_lt_r0) hΔp_r1
        have hΔm_r0 : -Δ_m ∈ Metric.ball (0 : ℂ) r_0 :=
          Metric.ball_subset_ball (le_of_lt hr1_lt_r0) hΔm_r1
        have hsq_eq : Φ_sq (V, Δ_p) ^ 2 = Φ_sq (V, -Δ_m) ^ 2 := by
          rw [hΦ_sq_eq V hV_54 Δ_p hΔp_η1, ← hF_fac V hV_32 Δ_p hΔp_r0, hF_eq,
            hF_fac V hV_32 (-Δ_m) hΔm_r0, ← hΦ_sq_eq V hV_54 (-Δ_m) hΔm_η1]
        rcases sq_eq_sq_iff_eq_or_eq_neg.mp hsq_eq with hpos | hneg
        · exact False.elim (hne (hΦ_inj V hV_98 Δ_p hΔp_r1 (-Δ_m) hΔm_r1 hpos))
        · exact hU_unique V (-Φ_sq (V, -Δ_m)) Δ_p (@h_arg_maps_Winv (V, Δ_m) ⟨hV, hΔm⟩) hΔp_r1 hneg
      · have h0 := hG_cubic V 0 hV (Metric.mem_ball_self hδ_pos)
        simp only [sub_zero, norm_zero, ne_eq, OfNat.ofNat_ne_zero, not_false_eq_true,
          zero_pow, mul_zero] at h0
        exact (norm_eq_zero.mp (le_antisymm h0 (norm_nonneg _))).symm
  }⟩

theorem collar_cylinder_billiard_identities (Ω : Set Plane)
    (C : AnalyticGlancingCollar Ω)
    (hDet : EndpointDeterminationData C)
    (B_cramer : BaseCollarAndCramerData C)
    (W : CollarWidthTubeData C hDet)
    (H₀ : ℝ)
    (hHX : W.h_X 0 = ENNReal.ofReal H₀)
    (Z₀ : ZeroSliceExtractedData W)
    (x_edge R_0 : ℝ)
    (hR0_pos : 0 < R_0)
    (hR0_lt : R_0 < W.s_base / 2) :
    Nonempty (SlabBilliardHoloData W Z₀ H₀ x_edge R_0) :=
by
  classical
  
  
  
  have h_den_nz_sub : ∀ {W' : Set (ℂ × ℂ)} (F : MeroOn2D W') {p : ℂ × ℂ} (hp : p ∈ W')
      {q₀ : ℂ × ℂ} {η : ℝ} (hη : 0 < η),
      Metric.ball q₀ η ⊆ Metric.ball p (F.rad p) →
      ∃ q ∈ Metric.ball q₀ η, F.den p q ≠ 0 := by
    intro W' F p hp q₀ η hη hsub
    by_contra h_none
    have h_all : ∀ q ∈ Metric.ball q₀ η, F.den p q = 0 :=
      fun q hq => Decidable.byContradiction fun hne => h_none ⟨q, hq, hne⟩
    obtain ⟨q_nz, hq_nz_mem, hq_nz⟩ := F.den_ne_zero p hp
    exact hq_nz (B_cramer.eqOn_zero_of_preconnected_2D
      Metric.isOpen_ball (convex_ball p (F.rad p)).isPreconnected
      Metric.isOpen_ball ⟨q₀, Metric.mem_ball_self hη⟩ hsub
      (F.den_holo p hp) h_all q_nz hq_nz_mem)
  have h_cancel_den : ∀ {W' : Set (ℂ × ℂ)} (F : MeroOn2D W') {p : ℂ × ℂ} (hp : p ∈ W')
      {q₀ : ℂ × ℂ} {η : ℝ} (hη : 0 < η)
      (hsub : Metric.ball q₀ η ⊆ Metric.ball p (F.rad p))
      {g : ℂ × ℂ → ℂ} (hg : DifferentiableOn ℂ g (Metric.ball q₀ η)),
      (∀ q ∈ Metric.ball q₀ η, g q * F.den p q = 0) →
      ∀ q ∈ Metric.ball q₀ η, g q = 0 := by
    intro W' F p hp q₀ η hη hsub g hg hmul
    obtain ⟨q₁, hq₁_mem, hq₁_ne⟩ := h_den_nz_sub F hp hη hsub
    have h_cont : ContinuousAt (F.den p) q₁ :=
      (F.den_holo p hp).continuousOn.continuousAt
        (Metric.isOpen_ball.mem_nhds (hsub hq₁_mem))
    obtain ⟨δ₁, hδ₁_pos, hδ₁_ne⟩ :=
      Metric.eventually_nhds_iff_ball.mp (h_cont.eventually_ne hq₁_ne)
    obtain ⟨δ₂, hδ₂_pos, hδ₂_sub⟩ := Metric.isOpen_iff.mp Metric.isOpen_ball q₁ hq₁_mem
    let δ := min δ₁ δ₂
    have hδ_pos : 0 < δ := lt_min hδ₁_pos hδ₂_pos
    have hδ_sub : Metric.ball q₁ δ ⊆ Metric.ball q₀ η :=
      Set.Subset.trans (Metric.ball_subset_ball (min_le_right _ _)) hδ₂_sub
    have hg_zero : ∀ q ∈ Metric.ball q₁ δ, g q = 0 := fun q hq =>
      (mul_eq_zero.mp (hmul q (hδ_sub hq))).resolve_right
        (hδ₁_ne q (Metric.ball_subset_ball (min_le_left _ _) hq))
    exact B_cramer.eqOn_zero_of_preconnected_2D
      Metric.isOpen_ball (convex_ball q₀ η).isPreconnected
      Metric.isOpen_ball ⟨q₁, Metric.mem_ball_self hδ_pos⟩ hδ_sub hg hg_zero
  have h_prod_den_nz : ∀ {W' : Set (ℂ × ℂ)} (F G : MeroOn2D W') {p : ℂ × ℂ} (hp : p ∈ W'),
      ∃ q ∈ Metric.ball p (min (F.rad p) (G.rad p)), F.den p q * G.den p q ≠ 0 := by
    intro W' F G p hp
    let r := min (F.rad p) (G.rad p)
    have hr : 0 < r := lt_min (F.rad_pos p hp) (G.rad_pos p hp)
    by_contra h_none
    have h_all : ∀ q ∈ Metric.ball p r, F.den p q * G.den p q = 0 :=
      fun q hq => Decidable.byContradiction fun hne => h_none ⟨q, hq, hne⟩
    have hF_zero : ∀ q ∈ Metric.ball p r, F.den p q = 0 :=
      h_cancel_den G hp hr (Metric.ball_subset_ball (min_le_right _ _))
        ((F.den_holo p hp).mono (Metric.ball_subset_ball (min_le_left _ _))) h_all
    obtain ⟨q₁, hq₁_mem, hq₁_ne⟩ :=
      h_den_nz_sub F hp hr (Metric.ball_subset_ball (min_le_left _ _))
    exact hq₁_ne (hF_zero q₁ hq₁_mem)
  have h_agrees_eq_at : ∀ {W' : Set (ℂ × ℂ)} (F : MeroOn2D W') {U₁ U₂ : Set (ℂ × ℂ)}
      {f₁ f₂ : ℂ × ℂ → ℂ},
      DifferentiableOn ℂ f₁ U₁ → DifferentiableOn ℂ f₂ U₂ →
      MeroAgreesHolo F f₁ U₁ → MeroAgreesHolo F f₂ U₂ →
      ∀ p ∈ U₁ ∩ U₂, f₁ p = f₂ p := by
    intro W' F U₁ U₂ f₁ f₂ hf₁ hf₂ hA₁ hA₂ p hp
    obtain ⟨r₁, hr₁_pos, hr₁_le, hr₁_sub, hr₁_eq⟩ := hA₁.2 p hp.1
    obtain ⟨r₂, hr₂_pos, hr₂_le, hr₂_sub, hr₂_eq⟩ := hA₂.2 p hp.2
    let r := min r₁ r₂
    have hr_pos : 0 < r := lt_min hr₁_pos hr₂_pos
    have hr_sub_F : Metric.ball p r ⊆ Metric.ball p (F.rad p) :=
      Metric.ball_subset_ball (le_trans (min_le_left _ _) hr₁_le)
    have hdiff_holo : DifferentiableOn ℂ (fun q => f₁ q - f₂ q) (Metric.ball p r) :=
      (hf₁.mono (Set.Subset.trans (Metric.ball_subset_ball (min_le_left _ _)) hr₁_sub)).sub
        (hf₂.mono (Set.Subset.trans (Metric.ball_subset_ball (min_le_right _ _)) hr₂_sub))
    have hmul_zero : ∀ q ∈ Metric.ball p r, (f₁ q - f₂ q) * F.den p q = 0 := fun q hq => by
      have e₁ := hr₁_eq q (Metric.ball_subset_ball (min_le_left _ _) hq)
      have e₂ := hr₂_eq q (Metric.ball_subset_ball (min_le_right _ _) hq)
      linear_combination -e₁ + e₂
    exact sub_eq_zero.mp (h_cancel_den F (hA₁.1 hp.1) hr_pos hr_sub_F hdiff_holo hmul_zero p
      (Metric.mem_ball_self hr_pos))
  have h_agrees_mono : ∀ {W' : Set (ℂ × ℂ)} (F : MeroOn2D W') {U V : Set (ℂ × ℂ)}
      {f : ℂ × ℂ → ℂ}, IsOpen V → V ⊆ U → MeroAgreesHolo F f U → MeroAgreesHolo F f V := by
    intro W' F U V f hV_open hVU hA
    refine ⟨Set.Subset.trans hVU hA.1, fun p hp => ?_⟩
    obtain ⟨r₁, hr₁_pos, hr₁_le, _, hr₁_eq⟩ := hA.2 p (hVU hp)
    obtain ⟨r₂, hr₂_pos, hr₂_sub⟩ := Metric.isOpen_iff.mp hV_open p hp
    exact ⟨min r₁ r₂, lt_min hr₁_pos hr₂_pos, le_trans (min_le_left _ _) hr₁_le,
      Set.Subset.trans (Metric.ball_subset_ball (min_le_right _ _)) hr₂_sub,
      fun q hq => hr₁_eq q (Metric.ball_subset_ball (min_le_left _ _) hq)⟩
  have h_mero_zero_preconn : ∀ {W' : Set (ℂ × ℂ)} (F : MeroOn2D W') {V V₀ : Set (ℂ × ℂ)},
      IsOpen V → IsPreconnected V → V ⊆ W' →
      IsOpen V₀ → V₀.Nonempty → V₀ ⊆ V →
      (∀ p ∈ V₀, ∃ r > 0, r ≤ F.rad p ∧ ∀ q ∈ Metric.ball p r, F.num p q = 0) →
      ∀ p ∈ V, ∀ q ∈ Metric.ball p (F.rad p), F.num p q = 0 := by
    intro W' F V V₀ hV_open hV_pre hVW hV₀_open hV₀_ne hV₀V hV₀_zero
    let S : Set (ℂ × ℂ) := { p ∈ V | ∀ q ∈ Metric.ball p (F.rad p), F.num p q = 0 }
    let S' : Set (ℂ × ℂ) := { p ∈ V | ¬ ∀ q ∈ Metric.ball p (F.rad p), F.num p q = 0 }
    have hS_open : IsOpen S := Metric.isOpen_iff.mpr fun p₀ hp₀ => by
      obtain ⟨R₀, hR₀_pos, hR₀_sub⟩ := Metric.isOpen_iff.mp hV_open p₀ hp₀.1
      let R₁ := min R₀ (F.rad p₀)
      have hR₁_pos : 0 < R₁ := lt_min hR₀_pos (F.rad_pos p₀ (hVW hp₀.1))
      refine ⟨R₁, hR₁_pos, fun p hp => ?_⟩
      have hpV : p ∈ V := hR₀_sub (Metric.ball_subset_ball (min_le_left _ _) hp)
      let η := min (R₁ - dist p p₀) (F.rad p)
      have hη_pos : 0 < η := lt_min (sub_pos.mpr (Metric.mem_ball.mp hp)) (F.rad_pos p (hVW hpV))
      have hη_sub_p₀ : Metric.ball p η ⊆ Metric.ball p₀ (F.rad p₀) := fun q hq => by
        rw [Metric.mem_ball]
        have hq' := Metric.mem_ball.mp hq
        have hη₁ : η ≤ R₁ - dist p p₀ := min_le_left _ _
        have hR₁_le : R₁ ≤ F.rad p₀ := min_le_right _ _
        linarith [dist_triangle q p p₀]
      have hη_sub_p : Metric.ball p η ⊆ Metric.ball p (F.rad p) :=
        Metric.ball_subset_ball (min_le_right _ _)
      have hmul : ∀ q ∈ Metric.ball p η, F.num p q * F.den p₀ q = 0 := fun q hq => by
        have hcomp := F.compat p (hVW hpV) p₀ (hVW hp₀.1) q ⟨hη_sub_p hq, hη_sub_p₀ hq⟩
        rw [hcomp, hp₀.2 q (hη_sub_p₀ hq), zero_mul]
      have hzero_η : ∀ q ∈ Metric.ball p η, F.num p q = 0 :=
        h_cancel_den F (hVW hp₀.1) hη_pos hη_sub_p₀ ((F.num_holo p (hVW hpV)).mono hη_sub_p) hmul
      exact ⟨hpV, B_cramer.eqOn_zero_of_preconnected_2D
        Metric.isOpen_ball (convex_ball p (F.rad p)).isPreconnected
        Metric.isOpen_ball ⟨p, Metric.mem_ball_self hη_pos⟩ hη_sub_p
        (F.num_holo p (hVW hpV)) hzero_η⟩
    have hS'_open : IsOpen S' := Metric.isOpen_iff.mpr fun p₀ hp₀ => by
      obtain ⟨R₀, hR₀_pos, hR₀_sub⟩ := Metric.isOpen_iff.mp hV_open p₀ hp₀.1
      let R₁ := min R₀ (F.rad p₀)
      have hR₁_pos : 0 < R₁ := lt_min hR₀_pos (F.rad_pos p₀ (hVW hp₀.1))
      refine ⟨R₁, hR₁_pos, fun p hp => ?_⟩
      have hpV : p ∈ V := hR₀_sub (Metric.ball_subset_ball (min_le_left _ _) hp)
      refine ⟨hpV, fun hp_zero => hp₀.2 ?_⟩
      let η := min (R₁ - dist p p₀) (F.rad p)
      have hη_pos : 0 < η := lt_min (sub_pos.mpr (Metric.mem_ball.mp hp)) (F.rad_pos p (hVW hpV))
      have hη_sub_p₀ : Metric.ball p η ⊆ Metric.ball p₀ (F.rad p₀) := fun q hq => by
        rw [Metric.mem_ball]
        have hq' := Metric.mem_ball.mp hq
        have hη₁ : η ≤ R₁ - dist p p₀ := min_le_left _ _
        have hR₁_le : R₁ ≤ F.rad p₀ := min_le_right _ _
        linarith [dist_triangle q p p₀]
      have hη_sub_p : Metric.ball p η ⊆ Metric.ball p (F.rad p) :=
        Metric.ball_subset_ball (min_le_right _ _)
      have hmul : ∀ q ∈ Metric.ball p η, F.num p₀ q * F.den p q = 0 := fun q hq => by
        have hcomp := F.compat p₀ (hVW hp₀.1) p (hVW hpV) q ⟨hη_sub_p₀ hq, hη_sub_p hq⟩
        rw [hcomp, hp_zero q (hη_sub_p hq), zero_mul]
      have hzero_η : ∀ q ∈ Metric.ball p η, F.num p₀ q = 0 :=
        h_cancel_den F (hVW hpV) hη_pos hη_sub_p ((F.num_holo p₀ (hVW hp₀.1)).mono hη_sub_p₀) hmul
      exact B_cramer.eqOn_zero_of_preconnected_2D
        Metric.isOpen_ball (convex_ball p₀ (F.rad p₀)).isPreconnected
        Metric.isOpen_ball ⟨p, Metric.mem_ball_self hη_pos⟩ hη_sub_p₀
        (F.num_holo p₀ (hVW hp₀.1)) hzero_η
    have h_cov : V ⊆ S ∪ S' := fun p hp =>
      if h : ∀ q ∈ Metric.ball p (F.rad p), F.num p q = 0 then Or.inl ⟨hp, h⟩ else Or.inr ⟨hp, h⟩
    have h_disj : V ∩ (S ∩ S') = ∅ :=
      Set.eq_empty_iff_forall_notMem.mpr fun p ⟨_, hp₁, hp₂⟩ => hp₂.2 hp₁.2
    rcases isPreconnected_iff_subset_of_disjoint.mp hV_pre S S' hS_open hS'_open h_cov h_disj with
      hVS | hVS'
    · exact fun p hp => (hVS hp).2
    · obtain ⟨p₀, hp₀⟩ := hV₀_ne
      obtain ⟨r, hr_pos, hr_le, hr_zero⟩ := hV₀_zero p₀ hp₀
      have hp₀S : ∀ q ∈ Metric.ball p₀ (F.rad p₀), F.num p₀ q = 0 :=
        B_cramer.eqOn_zero_of_preconnected_2D
          Metric.isOpen_ball (convex_ball p₀ (F.rad p₀)).isPreconnected
          Metric.isOpen_ball ⟨p₀, Metric.mem_ball_self hr_pos⟩ (Metric.ball_subset_ball hr_le)
          (F.num_holo p₀ (hVW (hV₀V hp₀))) hr_zero
      exact False.elim ((hVS' (hV₀V hp₀)).2 hp₀S)
  have h_holo_zero_of_num_zero : ∀ {W' : Set (ℂ × ℂ)} (F : MeroOn2D W') {U : Set (ℂ × ℂ)}
      {g : ℂ × ℂ → ℂ}, DifferentiableOn ℂ g U → MeroAgreesHolo F g U →
      (∀ p ∈ U, ∀ q ∈ Metric.ball p (F.rad p), F.num p q = 0) → ∀ p ∈ U, g p = 0 := by
    intro W' F U g hg hA hnum p hp
    obtain ⟨r, hr_pos, hr_le, hr_sub, hr_eq⟩ := hA.2 p hp
    have hmul : ∀ q ∈ Metric.ball p r, g q * F.den p q = 0 := fun q hq => by
      rw [← hr_eq q hq]
      exact hnum p hp q (Metric.ball_subset_ball hr_le hq)
    exact h_cancel_den F (hA.1 hp) hr_pos (Metric.ball_subset_ball hr_le) (hg.mono hr_sub)
