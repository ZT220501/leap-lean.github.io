      β_zero := fun _ _ => rfl
      β_endpoints := fun _ _ => ⟨rfl, rfl⟩
      β_taylor := by
        intro l r hl1
        have hl_lt : (l : ℕ) < D_form.p := by omega
        rw [(D_form.vanish_lt_p (l : ℕ) hl1 hl_lt).2.1 r, hJet.taylor2D_const, map_zero]
      grad_jet_zero := by
        intro q _ r l hl1 _
        rcases l with _ | l
        · omega
        · have hfn :
              (fun ε : ℂ =>
                pointRelInteriorGrad (fun i => G.ℓ_fn i q)
                  (pointArcPertGraph (J := p₀) G.F (fun _ _ _ => 0) ε)
                  (pointArcPertGraphDeriv (J := p₀) G.F (fun _ _ _ => 0) ε)
                  (pointArcPertAbscissa (J := p₀) (fun s => G.x_fn s q) (fun _ _ => 0) ε) r) =
              fun _ : ℂ =>
                pointRelInteriorGrad (fun i => G.ℓ_fn i q) (fun _ => G.F) (fun _ => deriv G.F)
                  (fun s => G.x_fn s q) r := by
            ext ε
            congr 1
            · ext s z; simp [pointArcPertGraph]
            · ext s z; simp [pointArcPertGraphDeriv]
            · ext s; simp [pointArcPertAbscissa]
