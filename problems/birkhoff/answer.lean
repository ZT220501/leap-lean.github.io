theorem cyclic_jet_and_diffop_calculus : CyclicJetAndDiffOpProp :=
by
  have hStrip_open : ∀ H : ℝ, IsOpen (horizStrip H) :=
    fun H => isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const
  have hStrip_add_real : ∀ (H : ℝ) (y : ℂ) (c : ℝ),
      y ∈ horizStrip H → y + (c : ℂ) ∈ horizStrip H := by
    intro H y c hy
    change |(y + (c : ℂ)).im| < H
    have him : (y + (c : ℂ)).im = y.im := by simp
    rw [him]
    exact hy
  have hStrip_add_2pi : ∀ (H : ℝ) (y : ℂ),
      y ∈ horizStrip H → y + 2 * Real.pi ∈ horizStrip H := by
    intro H y hy
    have hcast : (2 : ℂ) * (Real.pi : ℂ) = ((2 * Real.pi : ℝ) : ℂ) := by push_cast; rfl
    rw [hcast]
    exact hStrip_add_real H y (2 * Real.pi) hy
  have hBall_im : ∀ (t_c r_t : ℝ) (t : ℂ),
      t ∈ Metric.ball (t_c : ℂ) r_t → |t.im| < r_t := by
    intro t_c r_t t ht
    rw [Metric.mem_ball, dist_eq_norm] at ht
    have him : t.im = (t - (t_c : ℂ)).im := by simp
    rw [him]
    exact lt_of_le_of_lt (Complex.abs_im_le_norm (t - (t_c : ℂ))) ht
  have huIcc_abs : ∀ μ ∈ Set.uIcc (-1 / 2 : ℝ) (1 / 2 : ℝ), |μ| ≤ 1 / 2 := by
    intro μ hμ
    rw [Set.uIcc_of_le (by norm_num : (-1 / 2 : ℝ) ≤ 1 / 2), Set.mem_Icc] at hμ
    exact abs_le.mpr ⟨by linarith [hμ.1], hμ.2⟩
  have hSeg_strip : ∀ (σ' r_t : ℝ) (y t : ℂ) (μ : ℝ),
      0 < r_t → y ∈ horizStrip σ' → |t.im| < r_t → |μ| ≤ 1 / 2 →
      y + (μ : ℂ) * t ∈ horizStrip (σ' + r_t / 2) := by
    intro σ' r_t y t μ _ hy ht_im hμ_abs
    change |(y + (μ : ℂ) * t).im| < σ' + r_t / 2
    have hy_im : |y.im| < σ' := hy
    have him : (y + (μ : ℂ) * t).im = y.im + μ * t.im := by simp
    rw [him]
    have htri : |y.im + μ * t.im| ≤ |y.im| + |μ * t.im| := by
      simpa only [Real.norm_eq_abs] using norm_add_le y.im (μ * t.im)
    rw [abs_mul] at htri
    have hmul : |μ| * |t.im| ≤ (1 / 2 : ℝ) * r_t :=
      mul_le_mul hμ_abs (le_of_lt ht_im) (abs_nonneg _) (by norm_num)
    linarith
  refine ⟨?_, ?_, ?_⟩
  · 
    intro h_py σ σ' t₀ r_t M_V V hσ' hr_t hσσ' hM_V hV_holo hV_pb
    let W_big : Set (ℂ × ℂ) := horizStrip σ ×ˢ Metric.ball (t₀ : ℂ) r_t
    let W_mid : Set (ℂ × ℂ) := horizStrip ((σ + σ') / 2) ×ˢ Metric.ball (t₀ : ℂ) r_t
    let W_out : Set (ℂ × ℂ) := horizStrip σ' ×ˢ Metric.ball (t₀ : ℂ) r_t
    have hW_big_open : IsOpen W_big := (hStrip_open σ).prod Metric.isOpen_ball
    have hW_out_open : IsOpen W_out := (hStrip_open σ').prod Metric.isOpen_ball
    let F_y : ℂ × ℂ → ℂ := fun p => deriv (fun y' : ℂ => V (y', p.2)) p.1
    have hFy_holo : DifferentiableOn ℂ F_y W_big := h_py W_big V hW_big_open hV_holo
    have hFy_cont : ContinuousOn F_y W_big := hFy_holo.continuousOn
    let R_z : ℝ := (σ - σ') / 4
    let B_Fy : ℝ := 4 * (σ - σ')⁻¹ * M_V
    have hΔ_pos : 0 < σ - σ' := by linarith
    have hRz_pos : 0 < R_z := by dsimp [R_z]; linarith
    have hFy_mid_bound : ∀ q ∈ W_mid, ‖F_y q‖ ≤ B_Fy := by
      rintro ⟨z, t⟩ ⟨hz, ht⟩
      have hz_im : |z.im| < (σ + σ') / 2 := hz
      have hcb : Metric.closedBall z R_z ⊆ horizStrip σ := by
        intro w hw
        rw [Metric.mem_closedBall, dist_eq_norm] at hw
        change |w.im| < σ
        have hw_im : w.im = z.im + (w - z).im := by simp
        rw [hw_im]
        have htri : |z.im + (w - z).im| ≤ |z.im| + |(w - z).im| := by
          simpa only [Real.norm_eq_abs] using norm_add_le z.im (w - z).im
        have him_le : |(w - z).im| ≤ ‖w - z‖ := Complex.abs_im_le_norm (w - z)
        dsimp [R_z] at hw
        linarith
      have hg_holo : DifferentiableOn ℂ (fun y' : ℂ => V (y', t)) (horizStrip σ) :=
        hV_holo.comp (differentiable_id.prodMk (differentiable_const t)).differentiableOn
          (fun y' hy' => ⟨hy', ht⟩)
      have hdc : DiffContOnCl ℂ (fun y' : ℂ => V (y', t)) (Metric.ball z R_z) :=
        hg_holo.diffContOnCl_ball hcb
      have hcauchy : ‖F_y (z, t)‖ ≤ M_V / R_z :=
        Complex.norm_deriv_le_of_forall_mem_sphere_norm_le hRz_pos hdc
          (fun w hw => (hV_pb w (hcb (Metric.sphere_subset_closedBall hw)) t ht).2)
      have hdiv_eq : M_V / R_z = B_Fy := by
        have hΔ_ne : σ - σ' ≠ 0 := ne_of_gt hΔ_pos
        dsimp [R_z, B_Fy]
        field_simp [hΔ_ne]
      rwa [hdiv_eq] at hcauchy
    let I_cc : Set ℝ := Set.uIcc (-1 / 2 : ℝ) (1 / 2 : ℝ)
    let I_oc : Set ℝ := Set.uIoc (-1 / 2 : ℝ) (1 / 2 : ℝ)
    have hshift_mid : ∀ μ ∈ I_cc, ∀ p ∈ W_out, (p.1 + (μ : ℂ) * p.2, p.2) ∈ W_mid := by
      rintro μ hμ ⟨y, t⟩ ⟨hy, ht⟩
      refine ⟨?_, ht⟩
      have h1 : y + (μ : ℂ) * t ∈ horizStrip (σ' + r_t / 2) :=
        hSeg_strip σ' r_t y t μ hr_t hy (hBall_im t₀ r_t t ht) (huIcc_abs μ hμ)
      change |(y + (μ : ℂ) * t).im| < (σ + σ') / 2
      have h2 : |(y + (μ : ℂ) * t).im| < σ' + r_t / 2 := h1
      linarith
    have hmid_sub_big : W_mid ⊆ W_big := by
      rintro ⟨z, t⟩ ⟨hz, ht⟩
      refine ⟨?_, ht⟩
      change |z.im| < σ
      have hz_im : |z.im| < (σ + σ') / 2 := hz
      linarith
    let Φ : ℝ → (ℂ × ℂ) → ℂ := fun μ p => F_y (p.1 + (μ : ℂ) * p.2, p.2)
    have hΦ_cont : ContinuousOn (fun x : ℝ × (ℂ × ℂ) => Φ x.1 x.2) (I_cc ×ˢ W_out) := by
      have hmap_cont : Continuous (fun x : ℝ × (ℂ × ℂ) => (x.2.1 + (x.1 : ℂ) * x.2.2, x.2.2)) :=
        (continuous_fst.comp continuous_snd |>.add
          ((Complex.continuous_ofReal.comp continuous_fst).mul
            (continuous_snd.comp continuous_snd))).prodMk (continuous_snd.comp continuous_snd)
      exact hFy_cont.comp hmap_cont.continuousOn
        (fun x hx => hmid_sub_big (hshift_mid x.1 hx.1 x.2 hx.2))
    have hΦ_holo : ∀ μ ∈ I_cc, DifferentiableOn ℂ (Φ μ) W_out := by
      intro μ hμ
      have hmap_diff : Differentiable ℂ (fun p : ℂ × ℂ => (p.1 + (μ : ℂ) * p.2, p.2)) :=
        (differentiable_fst.add ((differentiable_const (μ : ℂ)).mul differentiable_snd)).prodMk
          differentiable_snd
      exact hFy_holo.comp hmap_diff.differentiableOn
        (fun p hp => hmid_sub_big (hshift_mid μ hμ p hp))
    have hΦ_bound : ∀ μ ∈ I_cc, ∀ p ∈ W_out, ‖Φ μ p‖ ≤ B_Fy :=
      fun μ hμ p hp => hFy_mid_bound _ (hshift_mid μ hμ p hp)
    refine ⟨?_, ?_⟩
    · intro p₀ hp₀
      obtain ⟨ε, hε_pos, hball_sub⟩ := Metric.isOpen_iff.mp hW_out_open p₀ hp₀
      let r : ℝ := ε / 2
      have hr : 0 < r := by dsimp [r]; linarith
      have h2r_eq : 2 * r = ε := by dsimp [r]; ring
      have hball2_sub : Metric.ball p₀ (2 * r) ⊆ W_out := by rwa [h2r_eq]
      let μ₀ := MeasureTheory.volume.restrict I_oc
      have hμ_le : μ₀ ≤ MeasureTheory.volume.restrict I_cc :=
        MeasureTheory.Measure.restrict_mono Set.uIoc_subset_uIcc le_rfl
      have hs_nhds : Metric.ball p₀ r ∈ nhds p₀ := Metric.ball_mem_nhds p₀ hr
      have hp₀_mem2 : p₀ ∈ Metric.ball p₀ (2 * r) := Metric.mem_ball_self (by linarith)
      have hble : ∀ p ∈ Metric.ball p₀ r, Metric.ball p r ⊆ Metric.ball p₀ (2 * r) := by
        intro p hp q hq
        rw [Metric.mem_ball] at hp hq ⊢
        calc
          dist q p₀ ≤ dist q p + dist p p₀ := dist_triangle q p p₀
          _ < r + r := add_lt_add hq hp
          _ = 2 * r := by ring
      have hfderiv_bound : ∀ μ ∈ I_cc, ∀ p ∈ Metric.ball p₀ r,
          ‖fderiv ℂ (Φ μ) p‖ ≤ (2 * B_Fy) / r := by
        intro μ hμ p hp
        have hp_out : p ∈ W_out := hball2_sub (hble p hp (Metric.mem_ball_self hr))
        have hholo_ball : DifferentiableOn ℂ (Φ μ) (Metric.ball p r) :=
          (hΦ_holo μ hμ).mono (fun q hq => hball2_sub (hble p hp hq))
        have hmaps : Set.MapsTo (Φ μ) (Metric.ball p r) (Metric.closedBall (Φ μ p) (2 * B_Fy)) := by
          intro q hq
