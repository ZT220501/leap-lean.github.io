          MvPowerSeries.coeff d (lcJetAction2D h_low S_ser α_ser) +
            ∑ i : Fin k,
              2 * s_d i * PowerSeries.coeff M (h_ser i) *
                MvPowerSeries.coeff d ((ψ_ser i) ^ M) := by
      intro d hdM
      unfold lcJetAction2D
      rw [map_sum, map_sum, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun i _ => ?_
      let P := compPowerSeries2D (h_ser i) (ψ_ser i)
      let P0 := compPowerSeries2D (h_low i) (ψ_ser i)
      let Q := MvPowerSeries.C (2 : ℂ) * compPowerSeries2D (S_ser i) (lcJetHalfStep2D α_ser i)
      have hP_vb : lineCoreVanishesBelow M (P - P0) := by
