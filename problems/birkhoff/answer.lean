            _ = ‖p₁.1 - p₂.1‖ + |(q : ℝ)| * ‖p₁.2 - p₂.2‖ := by
                rw [norm_mul, Complex.norm_intCast]
        have h_qR : |(q : ℝ)| * ‖p₁.2 - p₂.2‖ ≤ |(q : ℝ)| * R :=
