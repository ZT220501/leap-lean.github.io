        ((∀ p ∈ Metric.ball p_a r_a, Ψ E_chart M_a p = 0) ↔
         (∀ p ∈ Metric.ball p_b r_b, Ψ E_chart M_b p = 0)) := by
    intro Ψ hΨ Ω_chart U_reg D_det C_poly E_chart p_a p_b r_a r_b M_a M_b
      hΩ_open hU_sub hr_a hba_sub hr_b hE_holo hMa_holo ⟨ch⟩
    let B_ch : Fin (ch.L_ch + 1) → Set (ℂ × ℂ) :=
      fun j => Metric.ball (ch.c_ch j) (ch.r_ch j)
    have hB_sub : ∀ j, B_ch j ⊆ Ω_chart := fun j =>
      Set.Subset.trans (ch.ball_sub_reg j) hU_sub
    have h_start :
        (∀ p ∈ Metric.ball p_a r_a, Ψ E_chart M_a p = 0) ↔
        (∀ p ∈ B_ch 0, Ψ E_chart (ch.M_ch 0) p = 0) :=
      hTransfer_overlap hΨ Metric.isOpen_ball (convex_ball _ _).isPreconnected
        Metric.isOpen_ball (convex_ball _ _).isPreconnected
        Metric.isOpen_ball (Metric.nonempty_ball.mpr (ch.r_ch_pos 0))
        ch.start_eq.2.1 Subset.rfl
        (fun q hq c => (hE_holo q hq c).mono hba_sub) hMa_holo
        (fun q hq c => (hE_holo q hq c).mono (hB_sub 0))
        (fun ι => (ch.holo_and_solves 0 ι).1)
        (fun _ _ _ _ _ => rfl)
        (fun ι p hp => (ch.start_eq.2.2 ι p hp).symm)
    have h_chain : ∀ (m : ℕ) (hm : m ≤ ch.L_ch),
        (∀ p ∈ B_ch 0, Ψ E_chart (ch.M_ch 0) p = 0) ↔
        (∀ p ∈ B_ch ⟨m, Nat.lt_succ_of_le hm⟩,
          Ψ E_chart (ch.M_ch ⟨m, Nat.lt_succ_of_le hm⟩) p = 0) := by
      intro m
      induction m with
      | zero =>
        intro _
        exact Iff.rfl
      | succ m ih =>
        intro hm1
        have hm_lt : m < ch.L_ch := by omega
        let j : Fin ch.L_ch := ⟨m, hm_lt⟩
        have h_step :
            (∀ p ∈ B_ch j.castSucc, Ψ E_chart (ch.M_ch j.castSucc) p = 0) ↔
            (∀ p ∈ B_ch j.succ, Ψ E_chart (ch.M_ch j.succ) p = 0) :=
          hTransfer_overlap hΨ Metric.isOpen_ball (convex_ball _ _).isPreconnected
            Metric.isOpen_ball (convex_ball _ _).isPreconnected
            (Metric.isOpen_ball.inter Metric.isOpen_ball) (ch.step_overlap j).1
            Set.inter_subset_left Set.inter_subset_right
            (fun q hq c => (hE_holo q hq c).mono (hB_sub j.castSucc))
            (fun ι => (ch.holo_and_solves j.castSucc ι).1)
            (fun q hq c => (hE_holo q hq c).mono (hB_sub j.succ))
            (fun ι => (ch.holo_and_solves j.succ ι).1)
            (fun _ _ _ _ _ => rfl)
            (fun ι p hp => (ch.step_overlap j).2 ι p hp)
        exact (ih (Nat.le_of_lt hm_lt)).trans h_step
