        split_ifs with h_in
        · exact hCollar_eq_Y T_c hTc ζ ⟨h_in, hζ⟩
        · rfl
      have hgtilde_holo : DifferentiableOn ℂ g_tilde W_ext :=
        diffOn_union_open hOpen_hd hV_collar_open hH_holo_hd hg_holo_col
          (fun ζ hζ => by dsimp [g_tilde]; split_ifs; rfl) hgtilde_eq_col
      have hcl_sub : closure upperHalfDiskOpen ⊆ upperHalfDiskOpen ∪ upperHalfDiskBdry := by
        have hclosed : IsClosed { ζ : ℂ | ‖ζ‖ ≤ t₀ ∧ 0 ≤ ζ.im } :=
          (isClosed_le continuous_norm continuous_const).inter
            (isClosed_le continuous_const Complex.continuous_im)
        have h1 : closure upperHalfDiskOpen ⊆ { ζ : ℂ | ‖ζ‖ ≤ t₀ ∧ 0 ≤ ζ.im } :=
          closure_minimal (fun ζ hζ => ⟨le_of_lt hζ.1, le_of_lt hζ.2⟩) hclosed
        intro ζ hζ
        obtain ⟨hnorm, him⟩ := h1 hζ
        rcases lt_or_eq_of_le hnorm with hlt | heq
        · rcases lt_or_eq_of_le him with him_pos | him_zero
          · exact Or.inl ⟨hlt, him_pos⟩
          · exact Or.inr (Or.inl ⟨him_zero.symm, le_trans (Complex.abs_re_le_norm ζ) (le_of_lt hlt)⟩)
        · exact Or.inr (Or.inr ⟨heq, him⟩)
      have hcl_W : closure upperHalfDiskOpen ⊆ W_ext :=
