                  r_exit < ‖sliceImpactSeq S P.N i.val (walkPos ρ om (η_pure N_cap om)) -
                    sliceImpactSeq S P.N i.val (walkPos ρ om (T_pure N_cap om))‖) :=
              @Nat.find_spec
                (fun k => T_pure N_cap om ≤ k ∧
                  (N_cap ≤ k ∨ r_exit < ‖sliceImpactSeq S P.N i.val (walkPos ρ om k) -
                    sliceImpactSeq S P.N i.val (walkPos ρ om (T_pure N_cap om))‖))
                (Classical.decPred _) ⟨N_cap, hT_le om, Or.inl le_rfl⟩
            have hexit : r_exit < ‖sliceImpactSeq S P.N i.val (walkPos ρ om (η_pure N_cap om)) -
                sliceImpactSeq S P.N i.val (walkPos ρ om (T_pure N_cap om))‖ :=
              hspec.2.resolve_left (not_le.mpr hη_lt_cap)
            have hmem : η_pure N_cap om ∈ Finset.Ico (T_pure N_cap om) (n + 1) :=
