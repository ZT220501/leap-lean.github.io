        dsimp only [pointRecLiftArcFn]
        rw [dif_pos (hKF hinv_K), hΦ_K _ hinv_K, one_div]
      rw [hlift_inv, MvPowerSeries.coeff_C_mul, ← h_mv_pow F Φ Ψ hΨF s]
      rfl
    have h_ab_split : ∀ (K F : Subfield ℂ) (Φ : ↥F →+* PowerSeries ℂ) (hKF : K ≤ F),
        (∀ (x : ℂ) (hx : x ∈ K), Φ ⟨x, hKF hx⟩ = PowerSeries.C x) →
        ∀ (S_ab : MvPowerSeries (Fin 2) ℂ),
          (∀ d, MvPowerSeries.coeff d S_ab ∈ F) →
          (∀ d : Fin 2 →₀ ℕ, 1 ≤ d 0 → 1 ≤ d 1 → MvPowerSeries.coeff d S_ab ∈ K) →
