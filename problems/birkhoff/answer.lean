    have hΔx₀_re_ev : ∀ i : Fin k, ∀ᶠ δ in φ, 0 < (Δx₀ δ i).re ∧ Δx₀ δ i ≠ 0 := by
      intro i
      have hre_lim : Filter.Tendsto (fun δ : ℝ => (Δx₀ δ i / (δ : ℂ)).re) φ
