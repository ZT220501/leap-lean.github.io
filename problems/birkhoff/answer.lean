        · intro r _; simp [r.2]
        · intro r₁ _ r₂ _ h; exact Fin.ext (Fin.mk.inj h)
        · intro i hi
          rw [Finset.mem_filter] at hi
          exact ⟨⟨i.1, hi.2⟩, Finset.mem_univ _, Fin.ext rfl⟩
        · intro r _; rfl
      have h_sum2 : (∑ i : Fin k, E_minus_low i * Δ i.castSucc) =
          ∑ r : Fin (k - 1),
            E_minus_low ⟨r.1 + 1, by have := r.2; omega⟩ *
              Δ ⟨r.1 + 1, by have := r.2; omega⟩ := by
        have h_flt : (∑ i : Fin k, E_minus_low i * Δ i.castSucc) =
            ∑ i ∈ Finset.univ.filter (fun i : Fin k => 0 < i.1),
              E_minus_low i * Δ i.castSucc := by
          rw [← Finset.sum_filter_add_sum_filter_not Finset.univ (fun i : Fin k => 0 < i.1)]
          have h_rest : (∑ i ∈ Finset.univ.filter (fun i : Fin k => ¬ 0 < i.1),
              E_minus_low i * Δ i.castSucc) = 0 := by
            refine Finset.sum_eq_zero fun i hi => ?_
            rw [Finset.mem_filter] at hi
            have hi0 : i.1 = 0 := by omega
            have h_cast_zero : i.castSucc = 0 := Fin.ext hi0
            have hΔ_z : Δ 0 = 0 := hΔ_zero
            rw [h_cast_zero, hΔ_z, mul_zero]
          rw [h_rest, add_zero]
        rw [h_flt]
        symm
        refine Finset.sum_bij
          (fun (r : Fin (k - 1)) _ => (⟨r.1 + 1, by have := r.2; omega⟩ : Fin k))
          ?_ ?_ ?_ ?_
        · intro r _; simp
        · intro r₁ _ r₂ _ h
