      refine ⟨r_ag, hr_ag_pos, hr_ag_le, hr_ag_sub, ?_⟩
      intro q hq
      have h_rel : ∀ ci : Fin 2 × Fin 2, ∀ q' ∈ Metric.ball p r_ag,
