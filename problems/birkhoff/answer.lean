                  Complex.exp (Complex.I * (n : ℂ) * (μ : ℂ) * t))) *
                Complex.exp (Complex.I * (n : ℂ) * z)) :=
        Differentiable.sum fun n _ =>
          (differentiable_const _).mul (Complex.differentiable_exp.comp
            ((differentiable_const _).mul differentiable_id))
      have h_fn_eq2 : (∑ n ∈ Finset.Icc (-(N : ℤ)) (N : ℤ),
          fun z : ℂ =>
            (v_mode n t * (Complex.I * (n : ℂ)) *
              (∫ μ in (-1 / 2 : ℝ)..(1 / 2 : ℝ),
                Complex.exp (Complex.I * (n : ℂ) * (μ : ℂ) * t))) *
              Complex.exp (Complex.I * (n : ℂ) * z)) =
          (fun z : ℂ =>
            ∑ n ∈ Finset.Icc (-(N : ℤ)) (N : ℤ),
              (v_mode n t * (Complex.I * (n : ℂ)) *
                (∫ μ in (-1 / 2 : ℝ)..(1 / 2 : ℝ),
                  Complex.exp (Complex.I * (n : ℂ) * (μ : ℂ) * t))) *
                Complex.exp (Complex.I * (n : ℂ) * z)) := by
        ext z; simp
      rwa [h_fn_eq2] at h_dsum
    
    have hU_adm_full : IsAdmissibleGlancingCand s d S.η_adm U :=
      h_adm_mono (by linarith [S.η_adm_pos]) hU_adm
    obtain ⟨ha_holo, ha_props⟩ := S.linCoeff_props s d U hs_pos hs_le hd_pos hd_le hd_lt hU_adm_full
    let a_U : ℂ × ℂ → ℂ := glancingLinCoeff B U
    let S_t : Set ℂ := horizStrip (s - 17 * δ - |t.im| / 2)
    have hSt_sub17 : ∀ z ∈ S_t, (z, t) ∈ glancingDomain (1 / 2) (s - 17 * δ) (d - 17 * δ) := by
      intro z hz
      have hz_im : |z.im| < s - 17 * δ - |t.im| / 2 := hz
      refine ⟨lt_of_lt_of_le ht20 (by linarith), ?_⟩
      show |z.im| < s - 17 * δ - (1 / 2) * |t.im|
      linarith
    let f_err : ℂ → ℂ := fun z => a_U (z, t) * (glancingDiffOp v (z, t) - b_mid (z, t))
    have hf_err_holo : DifferentiableOn ℂ f_err S_t := by
      have ha_slice : DifferentiableOn ℂ (fun z : ℂ => a_U (z, t)) S_t :=
        ha_holo.comp (differentiableOn_id.prodMk (differentiableOn_const t))
          (fun z hz => h_dom_mono le_rfl (by linarith) (by linarith) (hSt_sub17 z hz))
      have hb_slice : DifferentiableOn ℂ (fun z : ℂ => b_mid (z, t)) S_t :=
        hb_holo.comp (differentiableOn_id.prodMk (differentiableOn_const t))
          (fun z hz => h_dom_mono le_rfl (by linarith) (by linarith) (hSt_sub17 z hz))
      exact ha_slice.mul (hdv_entire.differentiableOn.sub hb_slice)
    have hf_err_bound : ∀ z ∈ S_t, ‖f_err z‖ ≤ C_v * Q ^ B_v * ε ^ 2 := by
      intro z hz
      have hzt17 := hSt_sub17 z hz
      have hzt0 : (z, t) ∈ glancingDomain (1 / 2) s d :=
        h_dom_mono le_rfl (by linarith) (by linarith) hzt17
      have h4 : ‖4 * a_U (z, t) - 1‖ ≤ 1 / 4 := (ha_props z t hzt0).2.2.2
      have ha_le1 : ‖a_U (z, t)‖ ≤ 1 := by
        have h_sum : 4 * ‖a_U (z, t)‖ ≤ ‖4 * a_U (z, t) - 1‖ + 1 := by
          calc 4 * ‖a_U (z, t)‖ = ‖4 * a_U (z, t)‖ := by rw [norm_mul, Complex.norm_ofNat]
            _ = ‖(4 * a_U (z, t) - 1) + 1‖ := by ring_nf
            _ ≤ ‖4 * a_U (z, t) - 1‖ + ‖(1 : ℂ)‖ := norm_add_le _ _
            _ = ‖4 * a_U (z, t) - 1‖ + 1 := by simp
        linarith
      dsimp [f_err]
      rw [norm_mul]
      calc ‖a_U (z, t)‖ * ‖glancingDiffOp v (z, t) - b_mid (z, t)‖
          ≤ 1 * (C_v * Q ^ B_v * ε ^ 2) :=
            mul_le_mul ha_le1 (hv_res (z, t) hzt17) (norm_nonneg _) zero_le_one
        _ = C_v * Q ^ B_v * ε ^ 2 := one_mul _
    have hf_err_eq : ∀ z ∈ S_t,
        f_err z = a_U (z, t) * glancingDiffOp v (z, t) - h (z, t) - meanShift U h t := by
      intro z hz
      have hzt12 : (z, t) ∈ glancingDomain (1 / 2) (s - 12 * δ) (d - 12 * δ) :=
        h_dom_mono le_rfl (by linarith) (by linarith) (hSt_sub17 z hz)
      have h_alg := (hb_props z t hzt12).2.2.2.2
      dsimp [f_err, a_U]
      rw [mul_sub, h_alg]
      ring
    have h_diff_lin_bound :
        ‖glancingDiffOp (fun q => a_U (q.1, t) * glancingDiffOp v (q.1, t)) (y, t) -
          glancingDiffOp h (y, t)‖ ≤ 2 * C_v * Q ^ (B_v + 1) * ε ^ 2 := by
      have h_mu_in_St : ∀ μ : ℝ, |μ| ≤ 1 / 2 →
          ∀ w ∈ Metric.ball (y + (μ : ℂ) * t) δ, w ∈ S_t := by
        intro μ hμ w hw
        have hw_dist : ‖w - (y + (μ : ℂ) * t)‖ < δ := by rwa [Metric.mem_ball, dist_eq_norm] at hw
        have hw_im : |(w - (y + (μ : ℂ) * t)).im| ≤ ‖w - (y + (μ : ℂ) * t)‖ :=
          Complex.abs_im_le_norm _
        have h_im_split : w.im = y.im + μ * t.im + (w - (y + (μ : ℂ) * t)).im := by simp
        have h_mu_t : |μ * t.im| ≤ |t.im| / 2 := by
          rw [abs_mul]
          calc |μ| * |t.im| ≤ (1 / 2) * |t.im| := by gcongr
            _ = |t.im| / 2 := by ring
        show |w.im| < s - 17 * δ - |t.im| / 2
        rw [h_im_split]
        have h1 := abs_add_le (y.im + μ * t.im) (w - (y + (μ : ℂ) * t)).im
        have h2 := abs_add_le y.im (μ * t.im)
        have ht_im_nonneg : 0 ≤ |t.im| := abs_nonneg _
        linarith
      
      let G₁ : ℂ × ℂ → ℂ := fun q => a_U (q.1, t) * glancingDiffOp v (q.1, t)
      have hG₁_holo : DifferentiableOn ℂ (fun z : ℂ => G₁ (z, t)) S_t := by
        have ha_slice : DifferentiableOn ℂ (fun z : ℂ => a_U (z, t)) S_t :=
          ha_holo.comp (differentiableOn_id.prodMk (differentiableOn_const t))
            (fun z hz => h_dom_mono le_rfl (by linarith) (by linarith) (hSt_sub17 z hz))
        exact ha_slice.mul hdv_entire.differentiableOn
      have hG₁_y_holo : DifferentiableOn ℂ (fun p : ℂ × ℂ => deriv (fun z : ℂ => G₁ (z, t)) p.1)
          (S_t ×ˢ (Set.univ : Set ℂ)) :=
        S.partial_y_holo (S_t ×ˢ Set.univ) (fun p => G₁ (p.1, t))
          ((h_open_strip _).prod isOpen_univ)
          (hG₁_holo.comp differentiableOn_fst (fun p hp => hp.1))
      have hh_slice_holo : DifferentiableOn ℂ (fun z : ℂ => h (z, t)) S_t :=
        hh_holo.comp (differentiableOn_id.prodMk (differentiableOn_const t)) (fun z hz => by
          have hz_im : |z.im| < s - 17 * δ - |t.im| / 2 := hz
          refine ⟨lt_of_lt_of_le ht20 (by linarith), ?_⟩
          show |z.im| < s - 11 * δ - 0 * |t.im|
          have := abs_nonneg t.im
          linarith)
      have hh_y_holo : DifferentiableOn ℂ (fun p : ℂ × ℂ => deriv (fun z : ℂ => h (z, t)) p.1)
          (S_t ×ˢ (Set.univ : Set ℂ)) :=
        S.partial_y_holo (S_t ×ˢ Set.univ) (fun p => h (p.1, t))
          ((h_open_strip _).prod isOpen_univ)
          (hh_slice_holo.comp differentiableOn_fst (fun p hp => hp.1))
      have h_mu_mem_St : ∀ μ ∈ Set.uIcc (-1 / 2 : ℝ) (1 / 2 : ℝ), y + (μ : ℂ) * t ∈ S_t := by
        intro μ hμ
        rw [Set.uIcc_of_le (by norm_num : (-1 / 2 : ℝ) ≤ 1 / 2)] at hμ
        have hμ_abs : |μ| ≤ 1 / 2 := abs_le.mpr ⟨by linarith [hμ.1], hμ.2⟩
        exact h_mu_in_St μ hμ_abs (y + (μ : ℂ) * t) (Metric.mem_ball_self hδ_pos)
      have h_path : Continuous (fun μ : ℝ => (y + (μ : ℂ) * t, (0 : ℂ))) :=
        (continuous_const.add (Complex.continuous_ofReal.mul continuous_const)).prodMk
          continuous_const
      have h_int1 : IntervalIntegrable
          (fun μ : ℝ => deriv (fun z : ℂ => G₁ (z, t)) (y + (μ : ℂ) * t))
          MeasureTheory.volume (-1 / 2 : ℝ) (1 / 2 : ℝ) :=
        (hG₁_y_holo.continuousOn.comp h_path.continuousOn
          (fun μ hμ => ⟨h_mu_mem_St μ hμ, trivial⟩)).intervalIntegrable
      have h_int2 : IntervalIntegrable
          (fun μ : ℝ => deriv (fun z : ℂ => h (z, t)) (y + (μ : ℂ) * t))
          MeasureTheory.volume (-1 / 2 : ℝ) (1 / 2 : ℝ) :=
        (hh_y_holo.continuousOn.comp h_path.continuousOn
          (fun μ hμ => ⟨h_mu_mem_St μ hμ, trivial⟩)).intervalIntegrable
      have h_sub_int : glancingDiffOp G₁ (y, t) - glancingDiffOp h (y, t) =
          ∫ μ in (-1 / 2 : ℝ)..(1 / 2 : ℝ), deriv f_err (y + (μ : ℂ) * t) := by
        simp only [glancingDiffOp]
        rw [← intervalIntegral.integral_sub h_int1 h_int2]
        refine intervalIntegral.integral_congr fun μ hμ => ?_
        let z_μ := y + (μ : ℂ) * t
        have hz_St : z_μ ∈ S_t := h_mu_mem_St μ hμ
        have h_ev : f_err =ᶠ[nhds z_μ]
            fun z : ℂ => G₁ (z, t) - h (z, t) - meanShift U h t := by
          filter_upwards [(h_open_strip _).mem_nhds hz_St] with z hz
          exact hf_err_eq z hz
        have hG₁_at : DifferentiableAt ℂ (fun z : ℂ => G₁ (z, t)) z_μ :=
          hG₁_holo.differentiableAt ((h_open_strip _).mem_nhds hz_St)
        have hh_at : DifferentiableAt ℂ (fun z : ℂ => h (z, t)) z_μ :=
          hh_slice_holo.differentiableAt ((h_open_strip _).mem_nhds hz_St)
        rw [h_ev.deriv_eq, deriv_sub_const]
        exact (hG₁_at.hasDerivAt.sub hh_at.hasDerivAt).deriv.symm
      rw [h_sub_int]
      have h_int_norm : ‖∫ μ in (-1 / 2 : ℝ)..(1 / 2 : ℝ), deriv f_err (y + (μ : ℂ) * t)‖ ≤
          (2 * C_v * Q ^ (B_v + 1) * ε ^ 2) * |(1 / 2 : ℝ) - (-1 / 2 : ℝ)| :=
        intervalIntegral.norm_integral_le_of_norm_le_const fun μ hμ => by
          rw [Set.uIoc_of_le (by norm_num : (-1 / 2 : ℝ) ≤ 1 / 2)] at hμ
          have hμ_abs : |μ| ≤ 1 / 2 := abs_le.mpr ⟨by linarith [hμ.1], hμ.2⟩
          let z_μ := y + (μ : ℂ) * t
          have h2 : 2 * (δ / 2) = δ := by ring
          have h_c1 := h_cauchy_iter (z₀ := z_μ) (R := δ / 2) (C_b := C_v * Q ^ B_v * ε ^ 2)
            1 (half_pos hδ_pos) (by positivity)
            (by rw [h2]; exact hf_err_holo.mono (h_mu_in_St μ hμ_abs))
            (fun w hw => hf_err_bound w (h_mu_in_St μ hμ_abs w (by rwa [h2] at hw)))
          rw [iteratedDeriv_one, Nat.factorial_one, Nat.cast_one, one_mul, pow_one] at h_c1
          have h_d_le : δ⁻¹ ≤ Q := by dsimp [Q]; linarith
          calc ‖deriv f_err z_μ‖ ≤ C_v * Q ^ B_v * ε ^ 2 / (δ / 2) := h_c1
            _ = 2 * C_v * δ⁻¹ * Q ^ B_v * ε ^ 2 := by ring
            _ ≤ 2 * C_v * Q * Q ^ B_v * ε ^ 2 := by gcongr
            _ = 2 * C_v * Q ^ (B_v + 1) * ε ^ 2 := by rw [pow_succ]; ring
      have h_len : |(1 / 2 : ℝ) - (-1 / 2 : ℝ)| = 1 := by norm_num
      rw [h_len, mul_one] at h_int_norm
      exact h_int_norm
    
    have h_trans_bound :
        ‖deriv (fun z : ℂ => glancingResidualOp B U (z, t) * v (z, t)) y‖ ≤
          2 * C_v * Q ^ (B_v + 1) * ε ^ 2 := by
      obtain ⟨hE_holo, _, _, _⟩ :=
        S.E_op_props s d U hs_pos hs_le hd_pos hd_le hd_lt hU_adm_full
      let f_trans : ℂ → ℂ := fun z => glancingResidualOp B U (z, t) * v (z, t)
      have h_ball_mem : ∀ w ∈ Metric.ball y δ,
          (w, t) ∈ glancingDomain 1 s d ∧ (w, t) ∈ glancingDomain 0 (s - 17 * δ) (d - 17 * δ) := by
        intro w hw
        have hw_dist : ‖w - y‖ < δ := by rwa [Metric.mem_ball, dist_eq_norm] at hw
        have hw_im : |(w - y).im| ≤ ‖w - y‖ := Complex.abs_im_le_norm _
        have hw_split : w.im = y.im + (w - y).im := by simp
        have hw_abs := abs_add_le y.im (w - y).im
        have ht_im_nonneg := abs_nonneg t.im
        refine ⟨⟨lt_of_lt_of_le ht20 (by linarith), ?_⟩, ⟨lt_of_lt_of_le ht20 (by linarith), ?_⟩⟩
        · show |w.im| < s - 1 * |t.im|; rw [hw_split]; linarith
        · show |w.im| < s - 17 * δ - 0 * |t.im|; rw [hw_split]; linarith
      have h2 : 2 * (δ / 2) = δ := by ring
      have hf_trans_holo : DifferentiableOn ℂ f_trans (Metric.ball y (2 * (δ / 2))) := by
        rw [h2]
        exact (hE_holo.comp (differentiableOn_id.prodMk (differentiableOn_const t))
          (fun w hw => (h_ball_mem w hw).1)).mul
          (hv_holo.comp (differentiableOn_id.prodMk (differentiableOn_const t))
            (fun w hw => h_dom_mono le_rfl le_rfl (by linarith) (h_ball_mem w hw).2))
      have hf_trans_le : ∀ w ∈ Metric.ball y (2 * (δ / 2)),
          ‖f_trans w‖ ≤ C_v * Q ^ B_v * ε ^ 2 := by
        intro w hw
        rw [h2] at hw
        obtain ⟨hw1, hw17⟩ := h_ball_mem w hw
        dsimp [f_trans]
        rw [norm_mul]
        calc ‖glancingResidualOp B U (w, t)‖ * ‖v (w, t)‖
            ≤ ε * (C_v * Q ^ B_v * ε) :=
              mul_le_mul (hE_le (w, t) hw1) (hv_norm (w, t) hw17) (norm_nonneg _) (le_of_lt hε_pos)
          _ = C_v * Q ^ B_v * ε ^ 2 := by ring
      have h_c1 := h_cauchy_iter (z₀ := y) (R := δ / 2) (C_b := C_v * Q ^ B_v * ε ^ 2)
        1 (half_pos hδ_pos) (by positivity) hf_trans_holo hf_trans_le
      rw [iteratedDeriv_one, Nat.factorial_one, Nat.cast_one, one_mul, pow_one] at h_c1
      have h_d_le : δ⁻¹ ≤ Q := by dsimp [Q]; linarith
      calc ‖deriv f_trans y‖ ≤ C_v * Q ^ B_v * ε ^ 2 / (δ / 2) := h_c1
        _ = 2 * C_v * δ⁻¹ * Q ^ B_v * ε ^ 2 := by ring
        _ ≤ 2 * C_v * Q * Q ^ B_v * ε ^ 2 := by gcongr
        _ = 2 * C_v * Q ^ (B_v + 1) * ε ^ 2 := by rw [pow_succ]; ring
    
    let ρ : ℝ := C_ΔU * Q ^ B_ΔU * ε
    have hρ_le_small : ρ ≤ S.η_adm / 8 := by
      have hC_le : C_ΔU ≤ C_step := le_trans (le_max_left _ _) (le_max_right _ _)
      have hQ_le : Q ^ B_ΔU ≤ Q ^ B₀ := pow_le_pow_right₀ hQ_ge_one (by dsimp [B₀]; omega)
      calc C_ΔU * Q ^ B_ΔU * ε ≤ C_step * Q ^ B₀ * ε := by gcongr
        _ ≤ c_small := h_step_small
        _ = S.η_adm / 8 := rfl
    have hu_holo : DifferentiableOn ℂ (fun z : ℂ => U (z, t)) (horizStrip (s - 18 * δ)) :=
      hU_adm.1.comp (differentiableOn_id.prodMk (differentiableOn_const t)) (fun z hz => by
        have hz_im : |z.im| < s - 18 * δ := hz
        refine ⟨lt_of_lt_of_le ht20 (by linarith), ?_⟩
        show |z.im| < s - 0 * |t.im|; linarith)
    have hv_slice_holo : DifferentiableOn ℂ (fun z : ℂ => v (z, t)) (horizStrip (s - 18 * δ)) :=
      hv_holo.comp (differentiableOn_id.prodMk (differentiableOn_const t)) (fun z hz => by
        have hz_im : |z.im| < s - 18 * δ := hz
        refine ⟨lt_of_lt_of_le ht20 (by linarith), ?_⟩
        show |z.im| < s - 17 * δ - 0 * |t.im|; linarith)
    have h_quad := S.slice_quad_approx (s - 18 * δ) ρ y t
      (fun z => U (z, t)) (fun z => v (z, t))
      (by linarith) (by linarith) (lt_of_lt_of_le ht20 (by linarith)) (by linarith)
      (by positivity) hρ_le_small hu_holo hv_slice_holo
      (fun k hk z hz => by
        have hz_im : |z.im| < s - 18 * δ := hz
        exact hU_adm_full.2.2.2.2 k (by omega) z t
          ⟨lt_of_lt_of_le ht20 (by linarith), by show |z.im| < s - 0 * |t.im|; linarith⟩)
      (fun k hk z hz => hΔU_c3 k (by omega) z t hz (lt_of_lt_of_le ht20 (by linarith)))
    
    have h_quad_2D :
        ‖glancingResidualOp B (fun q => U q + ΔU q) (y, t) -
          glancingResidualOp B U (y, t) -
          (glancingDiffOp (fun q => a_U (q.1, t) * glancingDiffOp v (q.1, t)) (y, t) +
            deriv (fun z : ℂ => glancingResidualOp B U (z, t) * v (z, t)) y)‖ ≤
          S.C_quad * ρ ^ 2 := h_quad
    
    have hp11 : (y, t) ∈ glancingDomain 1 (s - 11 * δ) (d - 11 * δ) :=
      h_dom_mono le_rfl (by linarith) (by linarith) hp20
    have h_h_res := hh_res (y, t) hp11
    let T₁ := glancingResidualOp B (fun q => U q + ΔU q) (y, t) -
      glancingResidualOp B U (y, t) -
      (glancingDiffOp (fun q => a_U (q.1, t) * glancingDiffOp v (q.1, t)) (y, t) +
        deriv (fun z : ℂ => glancingResidualOp B U (z, t) * v (z, t)) y)
    let T₂ := glancingDiffOp (fun q => a_U (q.1, t) * glancingDiffOp v (q.1, t)) (y, t) -
      glancingDiffOp h (y, t)
    let T₃ := deriv (fun z : ℂ => glancingResidualOp B U (z, t) * v (z, t)) y
    let T₄ := glancingDiffOp h (y, t) + glancingResidualOp B U (y, t)
    have h_sum_4 : glancingResidualOp B (fun q => U q + ΔU q) (y, t) =
        T₁ + T₂ + T₃ + T₄ := by
      dsimp [T₁, T₂, T₃, T₄]; ring
    have hQ_mid : Q ^ B_mid ≤ Q ^ B₀ :=
      pow_le_pow_right₀ hQ_ge_one (by dsimp [B₀, B_ΔU, B_v]; omega)
    have hQ_v1 : Q ^ (B_v + 1) ≤ Q ^ B₀ :=
      pow_le_pow_right₀ hQ_ge_one (by dsimp [B₀, B_ΔU]; omega)
    have h_quad_B0 : S.C_quad * ρ ^ 2 = S.C_quad * C_ΔU ^ 2 * Q ^ B₀ * ε ^ 2 := by
      dsimp [ρ, B₀]
      rw [mul_pow, mul_pow, ← pow_mul, mul_comm B_ΔU 2]
      ring
    have hC_final_le : C_final ≤ C_step := le_trans (le_max_right _ _) (le_max_right _ _)
    rw [h_sum_4]
    calc ‖T₁ + T₂ + T₃ + T₄‖
        ≤ ‖T₁ + T₂ + T₃‖ + ‖T₄‖ := norm_add_le _ _
      _ ≤ ‖T₁ + T₂‖ + ‖T₃‖ + ‖T₄‖ := by gcongr; exact norm_add_le _ _
      _ ≤ ‖T₁‖ + ‖T₂‖ + ‖T₃‖ + ‖T₄‖ := by gcongr; exact norm_add_le _ _
      _ ≤ S.C_quad * C_ΔU ^ 2 * Q ^ B₀ * ε ^ 2 +
            2 * C_v * Q ^ B₀ * ε ^ 2 +
            2 * C_v * Q ^ B₀ * ε ^ 2 +
            C_mid * Q ^ B₀ * ε ^ 2 := by
          gcongr
          · rw [← h_quad_B0]; exact h_quad_2D
          · exact h_diff_lin_bound.trans (by gcongr)
          · exact h_trans_bound.trans (by gcongr)
          · exact h_h_res.trans (by gcongr)
      _ = C_final * Q ^ B₀ * ε ^ 2 := by dsimp [C_final]; ring
      _ ≤ C_step * Q ^ B₀ * ε ^ 2 := by gcongr

theorem resonant_glancing_newton_step (Ω : Set Plane)
    (B : AnalyticBoundaryData Ω) :
    Nonempty (GlancingActionAndStepData B) :=
by
  obtain ⟨S⟩ := glancing_operator_and_factorization Ω B
  have hRat : RationalCompatProp B S := rational_value_and_jet_compatibility Ω B S
  have hDiv : BufferedFourierDivProp := buffered_sinc_fourier_division
  exact two_step_resonant_newton_assembly Ω B S hRat hDiv

theorem glancing_convergence_and_symplectic_form (Ω : Set Plane)
    (B : AnalyticBoundaryData Ω)
    (G : GlancingActionAndStepData B) :
    Nonempty (AnalyticGlancingCollar Ω) :=
by
  
  have h_stage1 : ∀ (m : ℕ), 1 ≤ m →
      ∃ (s_init d_init M_init : ℝ) (U_init : ℂ × ℂ → ℂ),
        0 < s_init ∧ s_init ≤ G.s_act ∧
        0 < d_init ∧ d_init ≤ G.d_act ∧ d_init < s_init / 2 ∧
        0 < M_init ∧
        IsAdmissibleGlancingCand s_init d_init (G.η_adm / 4) U_init ∧
        (∀ y : ℂ, |y.im| < s_init → U_init (y, 0) = y) ∧
        (∀ p ∈ glancingDomain 1 s_init d_init,
          ‖G.E_op U_init p‖ ≤ M_init * ‖p.2‖ ^ (2 * m + 2)) := by
    intro m hm
    have hs_act_pos : 0 < G.s_act := G.s_act_pos
    have hd_act_pos : 0 < G.d_act := G.d_act_pos
    have hη_pos : 0 < G.η_adm := G.η_adm_pos
    have hOpenStrip : ∀ H : ℝ, IsOpen (horizStrip H) :=
      fun H => isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const
    have hConvStrip : ∀ H : ℝ, Convex ℝ (horizStrip H) := by
      intro H z₁ hz₁ z₂ hz₂ a b ha hb hab
      change |z₁.im| < H at hz₁
      change |z₂.im| < H at hz₂
      change |(a • z₁ + b • z₂).im| < H
      calc |(a • z₁ + b • z₂).im|
          = |a * z₁.im + b * z₂.im| := by simp [Complex.add_im, Complex.real_smul]
        _ ≤ |a * z₁.im| + |b * z₂.im| := abs_add_le _ _
        _ = a * |z₁.im| + b * |z₂.im| := by
            rw [abs_mul, abs_mul, abs_of_nonneg ha, abs_of_nonneg hb]
        _ < a * H + b * H := by
            rcases lt_or_eq_of_le ha with ha' | rfl
            · exact add_lt_add_of_lt_of_le (mul_lt_mul_of_pos_left hz₁ ha')
                (mul_le_mul_of_nonneg_left hz₂.le hb)
            · simp only [zero_add] at hab; subst hab; simp [hz₂]
        _ = H := by rw [← add_mul, hab, one_mul]
    have hIterD_holo : ∀ (n : ℕ) (R : ℝ) (g : ℂ → ℂ), 0 < R →
        DifferentiableOn ℂ g (Metric.ball 0 R) →
        DifferentiableOn ℂ (glancingIterDslopeAtZero n g) (Metric.ball 0 R) := by
      intro n R g hR hg
      induction n with
      | zero => exact hg
      | succ n ih =>
          exact (Complex.differentiableOn_dslope (Metric.ball_mem_nhds 0 hR)).mpr ih
    have hIterD_eq_pow : ∀ (n : ℕ) (g : ℂ → ℂ),
        (∀ k < n, glancingIterDslopeAtZero k g 0 = 0) →
        ∀ z : ℂ, g z = z ^ n * glancingIterDslopeAtZero n g z := by
      intro n g hzero
      induction n with
      | zero => intro z; simp [glancingIterDslopeAtZero]
      | succ n ih =>
          intro z
          have hprev := ih (fun k hk => hzero k (Nat.lt_succ_of_lt hk)) z
          have hn0 : glancingIterDslopeAtZero n g 0 = 0 := hzero n (Nat.lt_succ_self n)
          have hsub := sub_smul_dslope (glancingIterDslopeAtZero n g) 0 z
          simp only [sub_zero, hn0, smul_eq_mul] at hsub
          rw [hprev, ← hsub, glancingIterDslopeAtZero, pow_succ]
          ring
    have hIterD_bound : ∀ (n : ℕ) (R M : ℝ) (g : ℂ → ℂ), 0 < R → 0 ≤ M →
        DifferentiableOn ℂ g (Metric.ball 0 R) →
        (∀ z ∈ Metric.ball 0 R, ‖g z‖ ≤ M) →
        (∀ k < n, glancingIterDslopeAtZero k g 0 = 0) →
        ∀ z ∈ Metric.ball 0 R, ‖glancingIterDslopeAtZero n g z‖ ≤ M / R ^ n := by
      intro n R M g hR hM hg hbound hzero
      induction n with
      | zero => intro z hz; simpa [glancingIterDslopeAtZero] using hbound z hz
      | succ n ih =>
          intro z hz
          have hprev_bound := ih (fun k hk => hzero k (Nat.lt_succ_of_lt hk))
          have hn0 : glancingIterDslopeAtZero n g 0 = 0 := hzero n (Nat.lt_succ_self n)
          have hn_holo := hIterD_holo n R g hR hg
          have hmaps : Set.MapsTo (glancingIterDslopeAtZero n g) (Metric.ball 0 R)
              (Metric.closedBall (glancingIterDslopeAtZero n g 0) (M / R ^ n)) := by
            intro w hw
            rw [hn0, Metric.mem_closedBall, dist_zero_right]
            exact hprev_bound w hw
          have hd := Complex.norm_dslope_le_div_of_mapsTo_ball hn_holo hmaps hz
          calc ‖glancingIterDslopeAtZero (n + 1) g z‖
              ≤ (M / R ^ n) / R := hd
            _ = M / R ^ (n + 1) := by rw [div_div, pow_succ]
    have hEven_quad_bound : ∀ (R M : ℝ) (g : ℂ → ℂ), 0 < R → 0 ≤ M →
        DifferentiableOn ℂ g (Metric.ball 0 R) →
        g 0 = 0 →
        (∀ z ∈ Metric.ball 0 R, g (-z) = g z) →
        (∀ z ∈ Metric.ball 0 R, ‖g z‖ ≤ M) →
        ∀ z ∈ Metric.ball 0 R, ‖g z‖ ≤ (M / R ^ 2) * ‖z‖ ^ 2 := by
      intro R M g hR hM hg hg0 heven hbound
      have h1_zero : glancingIterDslopeAtZero 1 g 0 = 0 := by
        let g1 := dslope g 0
        have hg1_holo : DifferentiableOn ℂ g1 (Metric.ball 0 R) :=
          (Complex.differentiableOn_dslope (Metric.ball_mem_nhds 0 hR)).mpr hg
        have hg1_cont : ContinuousAt g1 0 :=
          (hg1_holo.differentiableAt (Metric.ball_mem_nhds 0 hR)).continuousAt
        let τ_seq : ℕ → ℂ := fun n => Complex.ofReal (R / ((n : ℝ) + 2))
        have hτ_tend : Filter.Tendsto τ_seq Filter.atTop (nhds 0) := by
          have hreal : Filter.Tendsto (fun n : ℕ => R / ((n : ℝ) + 2)) Filter.atTop (nhds 0) := by
            have hden : Filter.Tendsto (fun n : ℕ => (n : ℝ) + 2) Filter.atTop Filter.atTop :=
              Filter.tendsto_atTop_add_const_right Filter.atTop 2 tendsto_natCast_atTop_atTop
            exact tendsto_const_nhds.div_atTop hden
          exact (Complex.continuous_ofReal.tendsto 0).comp hreal
        have h_odd_seq : ∀ n : ℕ, g1 (-τ_seq n) = -g1 (τ_seq n) := by
          intro n
          have hpos : 0 < R / ((n : ℝ) + 2) := by positivity
          have hlt : R / ((n : ℝ) + 2) < R := by
            rw [div_lt_iff₀ (by positivity)]
            nlinarith [Nat.cast_nonneg (α := ℝ) n]
          have hne : τ_seq n ≠ 0 :=
            Complex.ofReal_ne_zero.mpr hpos.ne'
          have hmem : τ_seq n ∈ Metric.ball 0 R := by
            rw [Metric.mem_ball, dist_zero_right]
            dsimp [τ_seq]
            rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos hpos]
            exact hlt
          have hneg_ne : -τ_seq n ≠ 0 := neg_ne_zero.mpr hne
          simp only [g1, dslope_of_ne _ hne, dslope_of_ne _ hneg_ne, slope_def_field,
            sub_zero, hg0, heven (τ_seq n) hmem]
          ring
        have ht1 : Filter.Tendsto (fun n => g1 (-τ_seq n)) Filter.atTop (nhds (g1 0)) := by
          have : Filter.Tendsto (fun n => -τ_seq n) Filter.atTop (nhds 0) := by
            simpa using hτ_tend.neg
          exact hg1_cont.tendsto.comp this
        have ht2 : Filter.Tendsto (fun n => -g1 (τ_seq n)) Filter.atTop (nhds (-g1 0)) :=
          (hg1_cont.tendsto.comp hτ_tend).neg
        have heq_neg : g1 0 = -g1 0 :=
          tendsto_nhds_unique ht1 (by simpa [h_odd_seq] using ht2)
        have h2 : (2 : ℂ) * g1 0 = 0 := by linear_combination heq_neg
        exact (mul_eq_zero.mp h2).resolve_left (by norm_num)
      have hzero2 : ∀ k < 2, glancingIterDslopeAtZero k g 0 = 0 := by
        intro k hk
        interval_cases k
        · exact hg0
        · exact h1_zero
      intro z hz
      have heq := hIterD_eq_pow 2 g hzero2 z
      have hbd := hIterD_bound 2 R M g hR hM hg hbound hzero2 z hz
      calc ‖g z‖ = ‖z ^ 2 * glancingIterDslopeAtZero 2 g z‖ := by rw [heq]
        _ = ‖z‖ ^ 2 * ‖glancingIterDslopeAtZero 2 g z‖ := by rw [norm_mul, norm_pow]
        _ ≤ ‖z‖ ^ 2 * (M / R ^ 2) := mul_le_mul_of_nonneg_left hbd (sq_nonneg _)
        _ = (M / R ^ 2) * ‖z‖ ^ 2 := mul_comm _ _
    have hSolve_ODE : ∀ (s_mid s_sub : ℝ) (c_fn : ℂ → ℂ),
        0 < s_sub → s_sub < s_mid →
        DifferentiableOn ℂ c_fn (horizStrip s_mid) →
        (∀ y ∈ horizStrip s_mid, c_fn (y + 2 * Real.pi) = c_fn y) →
        (∀ y ∈ horizStrip s_mid, c_fn (starRingEnd ℂ y) = starRingEnd ℂ (c_fn y)) →
        (∫ x in (0 : ℝ)..(2 * Real.pi), c_fn x) = 0 →
        ∃ (u : ℂ → ℂ) (M_u : ℝ),
          0 < M_u ∧
          DifferentiableOn ℂ u (horizStrip s_sub) ∧
          (∀ y ∈ horizStrip s_sub, u (y + 2 * Real.pi) = u y) ∧
          (∀ y ∈ horizStrip s_sub, u (starRingEnd ℂ y) = starRingEnd ℂ (u y)) ∧
          (∀ y ∈ horizStrip s_sub, ‖u y‖ ≤ M_u) ∧
          (∀ y ∈ horizStrip s_sub, (1 / 4 : ℂ) * deriv (deriv u) y = -c_fn y) := by
      intro s_mid s_sub c_fn hs_sub_pos hs_sub_lt hc_holo hc_per hc_conj hc_int
      have hs_mid_pos : 0 < s_mid := hs_sub_pos.trans hs_sub_lt
      have h0_mem : (0 : ℂ) ∈ horizStrip s_mid := by simp [horizStrip, hs_mid_pos]
      have hPrim_once : ∀ f : ℂ → ℂ,
          DifferentiableOn ℂ f (horizStrip s_mid) →
          (∀ y ∈ horizStrip s_mid, f (y + 2 * Real.pi) = f y) →
          (∀ y ∈ horizStrip s_mid, f (starRingEnd ℂ y) = starRingEnd ℂ (f y)) →
          (∫ x in (0 : ℝ)..(2 * Real.pi), f x) = 0 →
          ∃ g : ℂ → ℂ,
            (∀ y ∈ horizStrip s_mid, HasDerivAt g (f y) y) ∧
            (∀ y ∈ horizStrip s_mid, g (y + 2 * Real.pi) = g y) ∧
            (∀ y ∈ horizStrip s_mid, g (starRingEnd ℂ y) = starRingEnd ℂ (g y)) := by
        intro f hf_holo hf_per hf_conj hf_int
        obtain ⟨G0, hG0⟩ := (hConvStrip s_mid).exists_forall_hasDerivWithinAt hf_holo
        let g : ℂ → ℂ := fun z => G0 z - G0 0
        have hg_deriv : ∀ z ∈ horizStrip s_mid, HasDerivAt g (f z) z := by
          intro z hz
          exact ((hG0 z hz).hasDerivAt ((hOpenStrip s_mid).mem_nhds hz)).sub_const (G0 0)
        have hg_holo : DifferentiableOn ℂ g (horizStrip s_mid) :=
          fun z hz => (hg_deriv z hz).differentiableAt.differentiableWithinAt
        have hg0 : g 0 = 0 := sub_self _
        let diff_per : ℂ → ℂ := fun z => g (z + 2 * Real.pi) - g z
        have hshift_mem : ∀ z ∈ horizStrip s_mid, z + 2 * Real.pi ∈ horizStrip s_mid := by
          intro z hz; change |z.im| < s_mid at hz; change |(z + 2 * Real.pi).im| < s_mid; simpa using hz
        have hdiff_per_deriv : ∀ z ∈ horizStrip s_mid, HasDerivAt diff_per 0 z := by
          intro z hz
          have hd1 : HasDerivAt (g ∘ fun w : ℂ => w + (2 * (Real.pi : ℂ))) (f (z + 2 * Real.pi) * 1) z :=
            (hg_deriv (z + 2 * Real.pi) (hshift_mem z hz)).comp z
              ((hasDerivAt_id z).add_const (2 * (Real.pi : ℂ)))
          rw [mul_one, hf_per z hz] at hd1
          have hd : HasDerivAt diff_per (f z - f z) z := hd1.sub (hg_deriv z hz)
          simpa using hd
        have hdiff_per_holo : DifferentiableOn ℂ diff_per (horizStrip s_mid) :=
          fun z hz => (hdiff_per_deriv z hz).differentiableAt.differentiableWithinAt
        have hdiff_per_const : ∀ z ∈ horizStrip s_mid, diff_per z = diff_per 0 := by
          intro z hz
          exact (hOpenStrip s_mid).is_const_of_deriv_eq_zero (hConvStrip s_mid).isPreconnected
            hdiff_per_holo (fun w hw => (hdiff_per_deriv w hw).deriv) hz h0_mem
        have hg_ftc : g (2 * Real.pi) - g 0 = ∫ x in (0 : ℝ)..(2 * Real.pi), f x := by
          have hderiv_real : ∀ x ∈ Set.uIcc (0 : ℝ) (2 * Real.pi),
              HasDerivAt (fun t : ℝ => g t) (f x) x := by
            intro x _
            have hx_mem : (x : ℂ) ∈ horizStrip s_mid := by simp [horizStrip, hs_mid_pos]
            exact (hg_deriv x hx_mem).comp_ofReal
          have hf_cont_r : Continuous (fun x : ℝ => f x) := by
            refine ContinuousOn.comp_continuous hf_holo.continuousOn Complex.continuous_ofReal ?_
            intro x; simp [horizStrip, hs_mid_pos]
          have h_int := (intervalIntegral.integral_eq_sub_of_hasDerivAt hderiv_real
            (hf_cont_r.intervalIntegrable 0 (2 * Real.pi))).symm
          simpa [Complex.ofReal_mul, Complex.ofReal_ofNat] using h_int
        have hg_per : ∀ z ∈ horizStrip s_mid, g (z + 2 * Real.pi) = g z := by
          intro z hz
          have hc := hdiff_per_const z hz
          dsimp [diff_per] at hc
          have h0_add : (0 : ℂ) + 2 * Real.pi = (2 * Real.pi : ℂ) := zero_add _
          rw [h0_add, hg_ftc, hf_int] at hc
          exact sub_eq_zero.mp hc
        let diff_conj : ℂ → ℂ := fun z => starRingEnd ℂ (g (starRingEnd ℂ z)) - g z
        have hconj_mem : ∀ z ∈ horizStrip s_mid, starRingEnd ℂ z ∈ horizStrip s_mid := by
          intro z hz; change |z.im| < s_mid at hz; change |(starRingEnd ℂ z).im| < s_mid; simpa using hz
        have hdiff_conj_deriv : ∀ z ∈ horizStrip s_mid, HasDerivAt diff_conj 0 z := by
          intro z hz
          have hd_raw := (hg_deriv (starRingEnd ℂ z) (hconj_mem z hz)).conj_conj
          simp only [RingHomCompTriple.comp_apply, RingHom.id_apply] at hd_raw
          have hf_cc : starRingEnd ℂ (f (starRingEnd ℂ z)) = f z := by
            rw [hf_conj z hz, RingHomCompTriple.comp_apply, RingHom.id_apply]
          rw [hf_cc] at hd_raw
          have hd : HasDerivAt diff_conj (f z - f z) z := hd_raw.sub (hg_deriv z hz)
          simpa using hd
        have hdiff_conj_holo : DifferentiableOn ℂ diff_conj (horizStrip s_mid) :=
          fun z hz => (hdiff_conj_deriv z hz).differentiableAt.differentiableWithinAt
        have hg_conj : ∀ z ∈ horizStrip s_mid, g (starRingEnd ℂ z) = starRingEnd ℂ (g z) := by
          intro z hz
          have hc := (hOpenStrip s_mid).is_const_of_deriv_eq_zero (hConvStrip s_mid).isPreconnected
            hdiff_conj_holo (fun w hw => (hdiff_conj_deriv w hw).deriv) (hconj_mem z hz) h0_mem
          dsimp [diff_conj] at hc
          simp only [RingHomCompTriple.comp_apply, RingHom.id_apply, map_zero, hg0, sub_zero] at hc
          exact (sub_eq_zero.mp hc).symm
        exact ⟨g, hg_deriv, hg_per, hg_conj⟩
      let f1 : ℂ → ℂ := fun z => (-4 : ℂ) * c_fn z
      have hf1_int : (∫ x in (0 : ℝ)..(2 * Real.pi), f1 x) = 0 := by
        simp only [f1, intervalIntegral.integral_const_mul, hc_int, mul_zero]
      obtain ⟨g1, hg1_deriv, hg1_per, hg1_conj⟩ := hPrim_once f1
        (hc_holo.const_mul (-4 : ℂ))
        (fun y hy => by dsimp [f1]; rw [hc_per y hy])
        (fun y hy => by dsimp [f1]; rw [map_mul, map_neg, map_ofNat, hc_conj y hy])
        hf1_int
      let μ1 : ℂ := ((2 * Real.pi : ℝ) : ℂ)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi), g1 x
      have hg1_holo : DifferentiableOn ℂ g1 (horizStrip s_mid) :=
        fun z hz => (hg1_deriv z hz).differentiableAt.differentiableWithinAt
      have hg1_cont_r : Continuous (fun x : ℝ => g1 x) := by
        refine ContinuousOn.comp_continuous hg1_holo.continuousOn Complex.continuous_ofReal ?_
        intro x; simp [horizStrip, hs_mid_pos]
      have hμ1_conj : starRingEnd ℂ μ1 = μ1 := by
        have hg1_real : ∀ x : ℝ, (g1 x).im = 0 := by
          intro x
          have hx_mem : (x : ℂ) ∈ horizStrip s_mid := by simp [horizStrip, hs_mid_pos]
          have hcx := hg1_conj x hx_mem
          simp only [Complex.conj_ofReal] at hcx
          have him := congr_arg Complex.im hcx
          simp at him; linarith
        have hg1_eq_re : (fun x : ℝ => g1 x) = (fun x : ℝ => ((g1 x).re : ℂ)) := by
          ext x
          apply Complex.ext <;> simp [hg1_real x]
        have hμ1_real : μ1 = (((2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi), (g1 x).re : ℝ) : ℂ) := by
          dsimp [μ1]
          rw [hg1_eq_re, intervalIntegral.integral_ofReal]
          push_cast; rfl
        rw [hμ1_real, Complex.conj_ofReal]
      let w1 : ℂ → ℂ := fun z => g1 z - μ1
      have hw1_holo : DifferentiableOn ℂ w1 (horizStrip s_mid) := hg1_holo.sub (differentiableOn_const μ1)
      have hw1_per : ∀ y ∈ horizStrip s_mid, w1 (y + 2 * Real.pi) = w1 y :=
        fun y hy => by dsimp [w1]; rw [hg1_per y hy]
      have hw1_conj : ∀ y ∈ horizStrip s_mid, w1 (starRingEnd ℂ y) = starRingEnd ℂ (w1 y) :=
        fun y hy => by dsimp [w1]; rw [map_sub, hg1_conj y hy, hμ1_conj]
      have hw1_int : (∫ x in (0 : ℝ)..(2 * Real.pi), w1 x) = 0 := by
        dsimp [w1]
        rw [intervalIntegral.integral_sub (hg1_cont_r.intervalIntegrable 0 (2 * Real.pi))
          intervalIntegrable_const, intervalIntegral.integral_const]
        simp only [sub_zero, Complex.real_smul]
        dsimp [μ1]
        have h2pi_ne : ((2 * Real.pi : ℝ) : ℂ) ≠ 0 := by
          exact_mod_cast (by positivity : (2 * Real.pi : ℝ) ≠ 0)
        rw [← mul_assoc, mul_inv_cancel₀ h2pi_ne, one_mul, sub_self]
      obtain ⟨u, hu_deriv, hu_per, hu_conj⟩ := hPrim_once w1 hw1_holo hw1_per hw1_conj hw1_int
      have hu_holo : DifferentiableOn ℂ u (horizStrip s_mid) :=
        fun z hz => (hu_deriv z hz).differentiableAt.differentiableWithinAt
      have hsub : horizStrip s_sub ⊆ horizStrip s_mid := fun z hz => lt_trans hz hs_sub_lt
      let K_u : Set ℂ := { z : ℂ | z.re ∈ Set.Icc (0 : ℝ) (2 * Real.pi) ∧ |z.im| ≤ s_sub }
      have hK_u_closed : IsClosed K_u :=
        (isClosed_Icc.preimage Complex.continuous_re).inter
          (isClosed_le (continuous_abs.comp Complex.continuous_im) continuous_const)
      have hK_u_bdd : Bornology.IsBounded K_u := by
        refine Bornology.IsBounded.subset (Metric.isBounded_closedBall (x := (0 : ℂ))
          (r := 2 * Real.pi + s_sub)) ?_
        intro z hz
        rw [Metric.mem_closedBall, dist_zero_right]
        have hre : |z.re| ≤ 2 * Real.pi := by
          rw [abs_of_nonneg hz.1.1]; exact hz.1.2
        exact (Complex.norm_le_abs_re_add_abs_im z).trans (add_le_add hre hz.2)
      have hK_u_compact : IsCompact K_u := Metric.isCompact_of_isClosed_isBounded hK_u_closed hK_u_bdd
      have hK_u_sub : K_u ⊆ horizStrip s_mid :=
        fun z hz => lt_of_le_of_lt hz.2 hs_sub_lt
      obtain ⟨z_max, -, hz_max⟩ := hK_u_compact.exists_isMaxOn
        ⟨0, ⟨⟨le_rfl, by positivity⟩, by simp [hs_sub_pos.le]⟩⟩
        (continuous_norm.comp_continuousOn (hu_holo.continuousOn.mono hK_u_sub))
      let M_u : ℝ := 1 + ‖u z_max‖
      have hM_u_pos : 0 < M_u := by positivity
      have hu_bound : ∀ y ∈ horizStrip s_sub, ‖u y‖ ≤ M_u := by
        intro y hy
        have h2pi_pos : (0 : ℝ) < 2 * Real.pi := by positivity
        let k : ℤ := Int.floor (y.re / (2 * Real.pi))
        let y₀ : ℂ := y - (((k : ℝ) * (2 * Real.pi) : ℝ) : ℂ)
        have hy₀_im : y₀.im = y.im := by simp [y₀]
        have hy₀_re : y₀.re ∈ Set.Icc (0 : ℝ) (2 * Real.pi) := by
          have hre_eq : y₀.re = y.re - (k : ℝ) * (2 * Real.pi) := by simp [y₀]
          rw [hre_eq]
          refine ⟨?_, ?_⟩
          · have := (le_div_iff₀ h2pi_pos).mp (Int.floor_le (y.re / (2 * Real.pi)))
            linarith
          · have := (div_lt_iff₀ h2pi_pos).mp (Int.lt_floor_add_one (y.re / (2 * Real.pi)))
            linarith
        have hy₀_K : y₀ ∈ K_u := ⟨hy₀_re, by rw [hy₀_im]; exact le_of_lt hy⟩
        have hu_shift_int : ∀ (n : ℤ) (z : ℂ), z ∈ horizStrip s_mid →
            u (z + (n : ℂ) * (2 * (Real.pi : ℂ))) = u z := by
          intro n
          induction n using Int.induction_on with
          | zero => intro z _; simp
          | succ n ihn =>
              intro z hz
              have hzn_mem : z + ((n : ℤ) : ℂ) * (2 * (Real.pi : ℂ)) ∈ horizStrip s_mid := by
                change |z.im| < s_mid at hz
                change |(z + ((n : ℤ) : ℂ) * (2 * (Real.pi : ℂ))).im| < s_mid; simpa using hz
              have hsplit : z + (((n : ℤ) + 1 : ℤ) : ℂ) * (2 * (Real.pi : ℂ)) =
                  (z + ((n : ℤ) : ℂ) * (2 * (Real.pi : ℂ))) + 2 * Real.pi := by push_cast; ring
              rw [hsplit, hu_per _ hzn_mem, ihn z hz]
