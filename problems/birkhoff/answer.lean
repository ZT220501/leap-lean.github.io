        (fun x : (ℂ × ℂ) × ℂ => F (x.1.1, x.2) * (x.1.2 * x.2 / (1 - x.1.2 * x.2))) W_G2 := by
      have h1 : DifferentiableOn ℂ (fun x : (ℂ × ℂ) × ℂ => F (x.1.1, x.2)) W_G2 :=
        hF_holo.comp
