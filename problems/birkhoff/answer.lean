            · have hn3 : ¬ r.1 = s.1 + 1 := by omega
              have hv : (⟨s.1 + 1, by have := s.2; omega⟩ : Fin (k + 1)) = i_R.succ := by
                ext; dsimp only [i_R, Fin.val_succ]; omega
              rw [if_pos h2, if_pos h2, if_neg hn3, add_zero, hv]
            · rw [if_neg h2, if_neg h2, zero_add]
              by_cases h3 : r.1 = s.1 + 1
              · have hv : (⟨s.1 + 1, by have := s.2; omega⟩ : Fin (k + 1)) = i_L.castSucc := by
                  ext; dsimp only [i_L, Fin.val_castSucc]; omega
