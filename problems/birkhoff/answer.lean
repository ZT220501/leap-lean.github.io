      obtain ⟨C_def, hC_def_pos, h_def⟩ := hCrit.log_deficit_bound
      obtain ⟨K₀, hK₀⟩ := hCrit.critical_upper_bound 1 zero_lt_one
      let k₀ : ℝ := criticalDepthThreshold S
