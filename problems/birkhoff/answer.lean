        hcShiftInv (ρ_m q j α) (fun x : ℝ => errA_m q w j x + α * errB_m q w j x) := by
      unfold halfCellInvMinus_ℝ hcShiftInv; rw [hFm]
    have hIp : halfCellInvPlus_ℝ q w j α =
        hcShiftInv (ρ_p q j α) (fun x : ℝ => errA_p q w j x + α * errB_p q w j x) := by
      unfold halfCellInvPlus_ℝ hcShiftInv; rw [hFp]
    have hDm : halfCellInvDispMinus q w j α =
        hcShiftInvDisp (ρ_m q j α) (fun x : ℝ => errA_m q w j x + α * errB_m q w j x) := by
      ext z; unfold halfCellInvDispMinus hcShiftInvDisp; rw [hIm]
    have hDp : halfCellInvDispPlus q w j α =
        hcShiftInvDisp (ρ_p q j α) (fun x : ℝ => errA_p q w j x + α * errB_p q w j x) := by
      ext z; unfold halfCellInvDispPlus hcShiftInvDisp; rw [hIp]
    exact ⟨hFm, hFp, hIm, hIp, hDm, hDp⟩
  have hSinglePairs : ∀ (q : ℕ) (w : ℝ → ℝ) (j : ℕ),
      S.N_mesh ≤ q →
      IsPeriodicSmoothBounded (m + 15) M w →
      j < q →
      IsHcBoundedPeriodicPair (m + 2) (3 * (S.R_mesh / (q : ℝ) ^ 2))
        (errA_m q w j) (errB_m q w j) ∧
      IsHcBoundedPeriodicPair (m + 2) (3 * (S.R_mesh / (q : ℝ) ^ 2))
        (errA_p q w j) (errB_p q w j) := by
    intro q w j hq_mesh hw hj
    have hq4 : 4 ≤ q := le_trans S.N_mesh_ge_four hq_mesh
    have hq_pos : (0 : ℝ) < (q : ℝ) := by exact_mod_cast (by omega : 0 < q)
    have hq2_pos : (0 : ℝ) < (q : ℝ) ^ 2 := sq_pos_of_pos hq_pos
    have hq_ge1 : (1 : ℝ) ≤ (q : ℝ) := by exact_mod_cast (by omega : 1 ≤ q)
    have hq2_le_q3 : (q : ℝ) ^ 2 ≤ (q : ℝ) ^ 3 := by nlinarith
    obtain ⟨_, _, _, hMeshJ, hMidJ⟩ := S.real_mesh_props q w hq_mesh (hWeakenM w hw)
    have hd_j := hMeshJ j (Nat.le_of_lt hj)
    have hd_j1 := hMeshJ (j + 1) hj
    have hmid_j := hMidJ j hj
    exact hBuildPairs (m + 2) (S.R_mesh / (q : ℝ) ^ 2)
      (realMeshDisp q w j)
      (fun x : ℝ => realMeshDisp q w (j + 1) x - realMeshDisp q w j x)
      (realMidpointDisp q w j)
      hd_j.1 (hd_j1.1.sub hd_j.1) hmid_j.1
      hd_j.2.1 (hd_j1.2.1.sub hd_j.2.1) hmid_j.2.1
      (fun k hk x =>
        ⟨(le_div_iff₀' hq2_pos).mpr (hd_j.2.2 k hk x),
         (le_div_iff₀' hq2_pos).mpr
           (le_trans (mul_le_mul_of_nonneg_right hq2_le_q3 (abs_nonneg _))
             (hmid_j.2.2.1 k hk x)),
         (le_div_iff₀' hq2_pos).mpr (hmid_j.2.2.2 k hk x)⟩)
  obtain ⟨C_jet, hC_jet_pos, hJetSingle, hJetLip⟩ := hStage4
  let N_inv : ℕ := max S.N_mesh (Nat.ceil (12 * S.R_mesh) + 1)
  let C_inv : ℝ := 3 * S.R_mesh * C_jet
  have hC_inv_pos : 0 < C_inv :=
    mul_pos (mul_pos (by norm_num) S.R_mesh_pos) hC_jet_pos
  have hEpsSmall : ∀ q : ℕ, N_inv ≤ q →
      0 ≤ 3 * (S.R_mesh / (q : ℝ) ^ 2) ∧ 3 * (S.R_mesh / (q : ℝ) ^ 2) ≤ 1 / 4 := by
    intro q hq
    have hq_mesh : S.N_mesh ≤ q := le_trans (le_max_left _ _) hq
    have hq4 : 4 ≤ q := le_trans S.N_mesh_ge_four hq_mesh
    have hq_pos : (0 : ℝ) < (q : ℝ) := by exact_mod_cast (by omega : 0 < q)
    have hq2_pos : (0 : ℝ) < (q : ℝ) ^ 2 := sq_pos_of_pos hq_pos
    have hq_ge1 : (1 : ℝ) ≤ (q : ℝ) := by exact_mod_cast (by omega : 1 ≤ q)
    have hq_le_q2 : (q : ℝ) ≤ (q : ℝ) ^ 2 := by nlinarith
    have hq_ceil : Nat.ceil (12 * S.R_mesh) + 1 ≤ q := le_trans (le_max_right _ _) hq
    have h12R_le_ceil : 12 * S.R_mesh ≤ (Nat.ceil (12 * S.R_mesh) : ℝ) := Nat.le_ceil _
    have hceil_le_q : (Nat.ceil (12 * S.R_mesh) : ℝ) ≤ (q : ℝ) := by
      exact_mod_cast (by omega : Nat.ceil (12 * S.R_mesh) ≤ q)
    refine ⟨mul_nonneg (by norm_num) (div_nonneg (le_of_lt S.R_mesh_pos) (le_of_lt hq2_pos)), ?_⟩
    rw [show 3 * (S.R_mesh / (q : ℝ) ^ 2) = (3 * S.R_mesh) / (q : ℝ) ^ 2 by ring,
      div_le_iff₀ hq2_pos]
    linarith
  refine ⟨{
    C_inv := C_inv
    N_inv := N_inv
    C_inv_pos := hC_inv_pos
    N_inv_ge := le_max_left _ _
    inv_props := ?_
    inv_lip := ?_
  }⟩
  · intro q w j hq hw hj
    have hq_mesh : S.N_mesh ≤ q := le_trans (le_max_left _ _) hq
    have hq4 : 4 ≤ q := le_trans S.N_mesh_ge_four hq_mesh
    have hq_pos : (0 : ℝ) < (q : ℝ) := by exact_mod_cast (by omega : 0 < q)
    have hq_ne : (q : ℝ) ≠ 0 := ne_of_gt hq_pos
    obtain ⟨hε0, hε4⟩ := hEpsSmall q hq
    obtain ⟨hPair_m, hPair_p⟩ := hSinglePairs q w j hq_mesh hw hj
    have hρ_m_cont : Continuous (ρ_m q j) :=
      (continuous_const.mul (continuous_const.add (continuous_id.div_const 2))).div_const (q : ℝ)
    have hρ_p_cont : Continuous (ρ_p q j) :=
      (continuous_const.mul
        (continuous_const.add ((continuous_const.add continuous_id).div_const 2))).div_const (q : ℝ)
    obtain ⟨hCont_m, hBnd_m⟩ :=
      hJetSingle (ρ_m q j) (errA_m q w j) (errB_m q w j)
        (3 * (S.R_mesh / (q : ℝ) ^ 2)) hρ_m_cont hε0 hε4 hPair_m
    obtain ⟨hCont_p, hBnd_p⟩ :=
      hJetSingle (ρ_p q j) (errA_p q w j) (errB_p q w j)
        (3 * (S.R_mesh / (q : ℝ) ^ 2)) hρ_p_cont hε0 hε4 hPair_p
    refine ⟨?_, ?_⟩
    · intro k hk
      have hEq_m :
          (fun p : ℝ × ℝ => iteratedDeriv k (halfCellInvDispMinus q w j p.1) p.2) =
          (fun p : ℝ × ℝ =>
            iteratedDeriv k
              (hcShiftInvDisp (ρ_m q j p.1)
                (fun x : ℝ => errA_m q w j x + p.1 * errB_m q w j x)) p.2) := by
        ext p; rw [(hFwdIds q w j p.1 hq_ne).2.2.2.2.1]
      have hEq_p :
          (fun p : ℝ × ℝ => iteratedDeriv k (halfCellInvDispPlus q w j p.1) p.2) =
          (fun p : ℝ × ℝ =>
            iteratedDeriv k
              (hcShiftInvDisp (ρ_p q j p.1)
                (fun x : ℝ => errA_p q w j x + p.1 * errB_p q w j x)) p.2) := by
        ext p; rw [(hFwdIds q w j p.1 hq_ne).2.2.2.2.2]
      rw [hEq_m, hEq_p]
      exact ⟨hCont_m k hk, hCont_p k hk⟩
    · intro α hα
      obtain ⟨hFm, hFp, hIm, hIp, hDm, hDp⟩ := hFwdIds q w j α hq_ne
      have hHalfPair : ∀ (A B : ℝ → ℝ),
          IsHcBoundedPeriodicPair (m + 2) (3 * (S.R_mesh / (q : ℝ) ^ 2)) A B →
          Function.Periodic (fun x : ℝ => A x + α * B x) (2 * Real.pi) ∧
          ContDiff ℝ ((m + 2 : ℕ) : WithTop ℕ∞) (fun x : ℝ => A x + α * B x) ∧
          (∀ x : ℝ, |(fun u : ℝ => A u + α * B u) x| ≤ 1 / 2 ∧
            |deriv (fun u : ℝ => A u + α * B u) x| ≤ 1 / 2) := by
        intro A B hAB
        rcases hAB with ⟨hA_per, hB_per, hA_cd, hB_cd, hAB_bnd⟩
        have hα_abs : |α| ≤ 1 := by rw [abs_le]; exact ⟨by linarith [hα.1], hα.2⟩
        refine ⟨fun x => by dsimp; rw [hA_per x, hB_per x],
          hA_cd.add (contDiff_const.mul hB_cd), ?_⟩
        intro x
        have h0A := (hAB_bnd 0 (Nat.zero_le _) x).1
        have h0B := (hAB_bnd 0 (Nat.zero_le _) x).2
        rw [iteratedDeriv_zero] at h0A h0B
        have h0_tri := abs_add_le (A x) (α * B x)
        rw [abs_mul] at h0_tri
        have h0_mul : |α| * |B x| ≤ 1 * (3 * (S.R_mesh / (q : ℝ) ^ 2)) :=
          mul_le_mul hα_abs h0B (abs_nonneg _) zero_le_one
        have h1_le : ((1 : ℕ) : WithTop ℕ∞) ≤ ((m + 2 : ℕ) : WithTop ℕ∞) := by
          exact_mod_cast (by omega : 1 ≤ m + 2)
        have hd_eq : deriv (fun u : ℝ => A u + α * B u) x = deriv A x + α * deriv B x := by
          rw [← iteratedDeriv_one,
            iteratedDeriv_fun_add (hA_cd.contDiffAt.of_le h1_le)
              ((contDiff_const.mul hB_cd).contDiffAt.of_le h1_le),
            iteratedDeriv_const_mul α (hB_cd.contDiffAt.of_le h1_le),
            iteratedDeriv_one, iteratedDeriv_one]
        have h1A := (hAB_bnd 1 (by omega) x).1
        have h1B := (hAB_bnd 1 (by omega) x).2
        rw [iteratedDeriv_one] at h1A h1B
        have h1_tri := abs_add_le (deriv A x) (α * deriv B x)
        rw [abs_mul] at h1_tri
        have h1_mul : |α| * |deriv B x| ≤ 1 * (3 * (S.R_mesh / (q : ℝ) ^ 2)) :=
          mul_le_mul hα_abs h1B (abs_nonneg _) zero_le_one
        exact ⟨by dsimp; linarith, by rw [hd_eq]; linarith⟩
      obtain ⟨he_m_per, he_m_cd, he_m_half⟩ := hHalfPair _ _ hPair_m
      obtain ⟨he_p_per, he_p_cd, he_p_half⟩ := hHalfPair _ _ hPair_p
      obtain ⟨hf_m_cd, _, hψ_m_cd, hf_m_qp, hg_m_qp, hL_m, hR_m, hCh_m, _, _, _⟩ :=
        hStage2 (m + 2) (ρ_m q j α) (fun x : ℝ => errA_m q w j x + α * errB_m q w j x)
          (by omega) he_m_per he_m_cd he_m_half
      obtain ⟨hf_p_cd, _, hψ_p_cd, hf_p_qp, hg_p_qp, hL_p, hR_p, hCh_p, _, _, _⟩ :=
        hStage2 (m + 2) (ρ_p q j α) (fun x : ℝ => errA_p q w j x + α * errB_p q w j x)
          (by omega) he_p_per he_p_cd he_p_half
      have hm1_le_m2 : ((m + 1 : ℕ) : WithTop ℕ∞) ≤ ((m + 2 : ℕ) : WithTop ℕ∞) := by
        exact_mod_cast Nat.le_succ (m + 1)
      rw [hFm, hFp, hIm, hIp, hDm, hDp]
      refine ⟨hf_m_cd, hf_p_cd, hψ_m_cd.of_le hm1_le_m2, hψ_p_cd.of_le hm1_le_m2,
        hf_m_qp, hf_p_qp, hg_m_qp, hg_p_qp, hL_m, hR_m, hL_p, hR_p, hCh_m, hCh_p, ?_⟩
      intro k hk z
      have hC_eq : C_jet * (3 * (S.R_mesh / (q : ℝ) ^ 2)) = C_inv / (q : ℝ) ^ 2 := by
        dsimp [C_inv]; ring
      rw [← hC_eq]
      exact ⟨hBnd_m α hα k hk z, hBnd_p α hα k hk z⟩
  · intro q w₁ w₂ j α hq hw₁ hw₂ hj hα k hk z
    have hq_mesh : S.N_mesh ≤ q := le_trans (le_max_left _ _) hq
    have hq4 : 4 ≤ q := le_trans S.N_mesh_ge_four hq_mesh
    have hq_pos : (0 : ℝ) < (q : ℝ) := by exact_mod_cast (by omega : 0 < q)
    have hq_ne : (q : ℝ) ≠ 0 := ne_of_gt hq_pos
    have hq2_pos : (0 : ℝ) < (q : ℝ) ^ 2 := sq_pos_of_pos hq_pos
    have hq_ge1 : (1 : ℝ) ≤ (q : ℝ) := by exact_mod_cast (by omega : 1 ≤ q)
    have hq2_le_q3 : (q : ℝ) ^ 2 ≤ (q : ℝ) ^ 3 := by nlinarith
    have hDiffSup_nonneg : 0 ≤ realDiffSup (m + 15) w₁ w₂ := by
      apply Real.sSup_nonneg
      rintro r ⟨l, _, y, _, rfl⟩
      exact abs_nonneg _
    obtain ⟨hε0, hε4⟩ := hEpsSmall q hq
    obtain ⟨hPair_m₁, hPair_p₁⟩ := hSinglePairs q w₁ j hq_mesh hw₁ hj
    obtain ⟨hPair_m₂, hPair_p₂⟩ := hSinglePairs q w₂ j hq_mesh hw₂ hj
    obtain ⟨_, _, _, hMeshJ₁, hMidJ₁⟩ := S.real_mesh_props q w₁ hq_mesh (hWeakenM w₁ hw₁)
    obtain ⟨_, _, _, hMeshJ₂, hMidJ₂⟩ := S.real_mesh_props q w₂ hq_mesh (hWeakenM w₂ hw₂)
    obtain ⟨hLipD, hLipΔD, hLipMid⟩ :=
      S.real_mesh_lip q w₁ w₂ hq_mesh (hWeakenM w₁ hw₁) (hWeakenM w₂ hw₂)
    have hd_j₁ := hMeshJ₁ j (Nat.le_of_lt hj)
    have hd_j1₁ := hMeshJ₁ (j + 1) hj
    have hmid_j₁ := hMidJ₁ j hj
    have hd_j₂ := hMeshJ₂ j (Nat.le_of_lt hj)
    have hd_j1₂ := hMeshJ₂ (j + 1) hj
    have hmid_j₂ := hMidJ₂ j hj
    let B₀_lip : ℝ := (S.R_mesh * realDiffSup (m + 15) w₁ w₂) / (q : ℝ) ^ 2
    obtain ⟨hDiff_m_raw, hDiff_p_raw⟩ := hBuildPairs (m + 2) B₀_lip
      (fun x : ℝ => realMeshDisp q w₁ j x - realMeshDisp q w₂ j x)
      (fun x : ℝ =>
        (realMeshDisp q w₁ (j + 1) x - realMeshDisp q w₁ j x) -
          (realMeshDisp q w₂ (j + 1) x - realMeshDisp q w₂ j x))
      (fun x : ℝ => realMidpointDisp q w₁ j x - realMidpointDisp q w₂ j x)
      (hd_j₁.1.sub hd_j₂.1)
      ((hd_j1₁.1.sub hd_j₁.1).sub (hd_j1₂.1.sub hd_j₂.1))
      (hmid_j₁.1.sub hmid_j₂.1)
      (hd_j₁.2.1.sub hd_j₂.2.1)
      ((hd_j1₁.2.1.sub hd_j₁.2.1).sub (hd_j1₂.2.1.sub hd_j₂.2.1))
      (hmid_j₁.2.1.sub hmid_j₂.2.1)
      (fun l hl x =>
        ⟨(le_div_iff₀' hq2_pos).mpr (hLipD j (Nat.le_of_lt hj) l hl x),
         (le_div_iff₀' hq2_pos).mpr
           (le_trans (mul_le_mul_of_nonneg_right hq2_le_q3 (abs_nonneg _))
             (hLipΔD j hj l hl x)),
         (le_div_iff₀' hq2_pos).mpr (hLipMid j hj l hl x)⟩)
    have hDiff_m : IsHcBoundedPeriodicPair (m + 2) (3 * B₀_lip)
        (fun x : ℝ => errA_m q w₁ j x - errA_m q w₂ j x)
        (fun x : ℝ => errB_m q w₁ j x - errB_m q w₂ j x) := by
      have hEqBm : (fun x : ℝ => errB_m q w₁ j x - errB_m q w₂ j x) =
          (fun x : ℝ =>
            (1 / 2 : ℝ) *
              ((realMeshDisp q w₁ (j + 1) x - realMeshDisp q w₁ j x) -
                (realMeshDisp q w₂ (j + 1) x - realMeshDisp q w₂ j x)) +
              (realMidpointDisp q w₁ j x - realMidpointDisp q w₂ j x)) := by
        ext x; dsimp [errB_m]; ring
      rw [hEqBm]
      exact hDiff_m_raw
    have hDiff_p : IsHcBoundedPeriodicPair (m + 2) (3 * B₀_lip)
        (fun x : ℝ => errA_p q w₁ j x - errA_p q w₂ j x)
        (fun x : ℝ => errB_p q w₁ j x - errB_p q w₂ j x) := by
      have hEqAp : (fun x : ℝ => errA_p q w₁ j x - errA_p q w₂ j x) =
          (fun x : ℝ =>
            (realMeshDisp q w₁ j x - realMeshDisp q w₂ j x) +
              (1 / 2 : ℝ) *
                ((realMeshDisp q w₁ (j + 1) x - realMeshDisp q w₁ j x) -
                  (realMeshDisp q w₂ (j + 1) x - realMeshDisp q w₂ j x)) +
              (realMidpointDisp q w₁ j x - realMidpointDisp q w₂ j x)) := by
        ext x; dsimp [errA_p]; ring
      have hEqBp : (fun x : ℝ => errB_p q w₁ j x - errB_p q w₂ j x) =
          (fun x : ℝ =>
            (1 / 2 : ℝ) *
              ((realMeshDisp q w₁ (j + 1) x - realMeshDisp q w₁ j x) -
                (realMeshDisp q w₂ (j + 1) x - realMeshDisp q w₂ j x)) -
              (realMidpointDisp q w₁ j x - realMidpointDisp q w₂ j x)) := by
        ext x; dsimp [errB_p]; ring
      rw [hEqAp, hEqBp]
      exact hDiff_p_raw
    have h3B₀_nonneg : 0 ≤ 3 * B₀_lip := by
      dsimp [B₀_lip]
      exact mul_nonneg (by norm_num)
        (div_nonneg (mul_nonneg (le_of_lt S.R_mesh_pos) hDiffSup_nonneg) (le_of_lt hq2_pos))
    have hDm₁ := (hFwdIds q w₁ j α hq_ne).2.2.2.2.1
    have hDm₂ := (hFwdIds q w₂ j α hq_ne).2.2.2.2.1
    have hDp₁ := (hFwdIds q w₁ j α hq_ne).2.2.2.2.2
    have hDp₂ := (hFwdIds q w₂ j α hq_ne).2.2.2.2.2
    rw [hDm₁, hDm₂, hDp₁, hDp₂]
    have hL_m := hJetLip (ρ_m q j)
      (errA_m q w₁ j) (errB_m q w₁ j) (errA_m q w₂ j) (errB_m q w₂ j)
      (3 * (S.R_mesh / (q : ℝ) ^ 2)) (3 * B₀_lip) hε0 hε4 h3B₀_nonneg
      hPair_m₁ hPair_m₂ hDiff_m α hα k hk z
    have hL_p := hJetLip (ρ_p q j)
      (errA_p q w₁ j) (errB_p q w₁ j) (errA_p q w₂ j) (errB_p q w₂ j)
      (3 * (S.R_mesh / (q : ℝ) ^ 2)) (3 * B₀_lip) hε0 hε4 h3B₀_nonneg
      hPair_p₁ hPair_p₂ hDiff_p α hα k hk z
    have hC_lip_eq : C_jet * (3 * B₀_lip) =
        (C_inv / (q : ℝ) ^ 2) * realDiffSup (m + 15) w₁ w₂ := by
      dsimp [C_inv, B₀_lip]; ring
    rw [← hC_lip_eq]
    exact ⟨hL_m, hL_p⟩

theorem forward_cell_kernel_system (m : ℕ) (M : ℝ)
    (hm : 2 ≤ m) (hM : 0 < M) (S : StationaryMeshSystem m (M + 1)) :
    Nonempty (ForwardKernelSystem m M S) :=
by
  have hJet : RealCJetToolkitProp_fcks := by
    have hConst : ∀ (p : ℕ) (c : ℝ), HasCJetBound_fcks p |c| (fun _ => c) := by
      intro p c
      refine ⟨contDiff_const, abs_nonneg c, fun k _ x => ?_⟩
      rw [iteratedDeriv_const]
      split_ifs
      · exact le_rfl
      · simp [abs_nonneg c]
    have hMono : ∀ {p' p : ℕ} {B₁ B₂ : ℝ} {f : ℝ → ℝ},
        p' ≤ p → B₁ ≤ B₂ → HasCJetBound_fcks p B₁ f → HasCJetBound_fcks p' B₂ f := by
      intro p' p B₁ B₂ f hp' hB hf
      refine ⟨hf.1.of_le (by exact_mod_cast hp'), le_trans hf.2.1 hB, fun k hk x => ?_⟩
      exact le_trans (hf.2.2 k (le_trans hk hp') x) hB
    have hAdd : ∀ {p : ℕ} {B₁ B₂ : ℝ} {f g : ℝ → ℝ},
        HasCJetBound_fcks p B₁ f → HasCJetBound_fcks p B₂ g →
        HasCJetBound_fcks p (B₁ + B₂) (fun x => f x + g x) := by
      intro p B₁ B₂ f g hf hg
      refine ⟨hf.1.add hg.1, add_nonneg hf.2.1 hg.2.1, fun k hk x => ?_⟩
      have hfk : ContDiffAt ℝ (k : WithTop ℕ∞) f x := (hf.1.of_le (by exact_mod_cast hk)).contDiffAt
      have hgk : ContDiffAt ℝ (k : WithTop ℕ∞) g x := (hg.1.of_le (by exact_mod_cast hk)).contDiffAt
      rw [iteratedDeriv_fun_add hfk hgk]
      exact le_trans (abs_add_le _ _) (add_le_add (hf.2.2 k hk x) (hg.2.2 k hk x))
    have hSub : ∀ {p : ℕ} {B₁ B₂ : ℝ} {f g : ℝ → ℝ},
        HasCJetBound_fcks p B₁ f → HasCJetBound_fcks p B₂ g →
        HasCJetBound_fcks p (B₁ + B₂) (fun x => f x - g x) := by
      intro p B₁ B₂ f g hf hg
      refine ⟨hf.1.sub hg.1, add_nonneg hf.2.1 hg.2.1, fun k hk x => ?_⟩
      have hfk : ContDiffAt ℝ (k : WithTop ℕ∞) f x := (hf.1.of_le (by exact_mod_cast hk)).contDiffAt
      have hgk : ContDiffAt ℝ (k : WithTop ℕ∞) g x := (hg.1.of_le (by exact_mod_cast hk)).contDiffAt
      rw [iteratedDeriv_fun_sub hfk hgk]
      calc |iteratedDeriv k f x - iteratedDeriv k g x|
          ≤ |iteratedDeriv k f x| + |iteratedDeriv k g x| := abs_sub _ _
        _ ≤ B₁ + B₂ := add_le_add (hf.2.2 k hk x) (hg.2.2 k hk x)
    have hConstMul : ∀ {p : ℕ} {B : ℝ} (c : ℝ) {f : ℝ → ℝ},
        HasCJetBound_fcks p B f → HasCJetBound_fcks p (|c| * B) (fun x => c * f x) := by
      intro p B c f hf
      refine ⟨contDiff_const.mul hf.1, mul_nonneg (abs_nonneg c) hf.2.1, fun k hk x => ?_⟩
      have hfk : ContDiffAt ℝ (k : WithTop ℕ∞) f x := (hf.1.of_le (by exact_mod_cast hk)).contDiffAt
      rw [iteratedDeriv_const_mul c hfk, abs_mul]
      exact mul_le_mul_of_nonneg_left (hf.2.2 k hk x) (abs_nonneg c)
    have hMul : ∀ {p : ℕ} {B₁ B₂ : ℝ} {f g : ℝ → ℝ},
        HasCJetBound_fcks p B₁ f → HasCJetBound_fcks p B₂ g →
        HasCJetBound_fcks p ((2 : ℝ) ^ p * B₁ * B₂) (fun x => f x * g x) := by
      intro p B₁ B₂ f g hf hg
      have hB1 : 0 ≤ B₁ := hf.2.1
      have hB2 : 0 ≤ B₂ := hg.2.1
      refine ⟨hf.1.mul hg.1, by positivity, fun k hk x => ?_⟩
      have hfk : ContDiffAt ℝ (k : WithTop ℕ∞) f x := (hf.1.of_le (by exact_mod_cast hk)).contDiffAt
      have hgk : ContDiffAt ℝ (k : WithTop ℕ∞) g x := (hg.1.of_le (by exact_mod_cast hk)).contDiffAt
      rw [iteratedDeriv_fun_mul hfk hgk]
      calc |∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * iteratedDeriv i f x * iteratedDeriv (k - i) g x|
          ≤ ∑ i ∈ Finset.range (k + 1), |(k.choose i : ℝ) * iteratedDeriv i f x * iteratedDeriv (k - i) g x| :=
            Finset.abs_sum_le_sum_abs _ _
