      have h_inv_ε : 1 / ε_bar i = R_i ^ A_exp := by
        rw [hε_eq_R, one_div, ← inv_pow, inv_inv]
      have hlog_pos : 0 < Real.log (1 / ε_bar i) := by
        apply Real.log_pos
        rw [one_lt_div hε_pos]
        exact hε_lt1
      let x_i : ℝ := (δ i)⁻¹ * Real.log (1 / ε_bar i)
      have hx_pos : 0 < x_i := mul_pos (inv_pos.mpr hδ_pos) hlog_pos
      have hceil_ge : x_i ≤ (Nat.ceil x_i : ℝ) := Nat.le_ceil x_i
      have hN_ge_x : x_i ≤ (N_seq i : ℝ) := by
        dsimp [N_seq]; push_cast; linarith
      have hexp_le : Real.exp (-(N_seq i : ℝ) * δ i) ≤ ε_bar i := by
        have h1 : x_i * δ i ≤ (N_seq i : ℝ) * δ i :=
          mul_le_mul_of_nonneg_right hN_ge_x hδ_pos.le
        have h2 : x_i * δ i = -Real.log (ε_bar i) := by
          dsimp [x_i]
          have : (δ i)⁻¹ * Real.log (1 / ε_bar i) * δ i = Real.log (1 / ε_bar i) := by
            field_simp [hδ_pos.ne']
          rw [this, one_div, Real.log_inv]
        have h3 : -(N_seq i : ℝ) * δ i ≤ Real.log (ε_bar i) := by linarith
        calc Real.exp (-(N_seq i : ℝ) * δ i)
            ≤ Real.exp (Real.log (ε_bar i)) := Real.exp_le_exp.mpr h3
          _ = ε_bar i := Real.exp_log hε_pos
      have hδ_inv_eq : (δ i)⁻¹ = 400 * R_i := by
        dsimp [δ, R_i]
        rw [_root_.one_div_pow]
        field_simp [hd₀_pos.ne', h2i_pos.ne']
      have hlog_R_lt : Real.log R_i ≤ R_i := by
        have := Real.log_le_sub_one_of_pos hR_pos
        linarith
      have hx_le : x_i ≤ 400 * (A_exp : ℝ) * R_i ^ 2 := by
        dsimp [x_i]
        rw [hδ_inv_eq, h_inv_ε, Real.log_pow]
        have h1 : 400 * R_i * ((A_exp : ℝ) * Real.log R_i) ≤ 400 * R_i * ((A_exp : ℝ) * R_i) :=
          mul_le_mul_of_nonneg_left
            (mul_le_mul_of_nonneg_left hlog_R_lt (Nat.cast_nonneg A_exp)) (by positivity)
        linarith [show 400 * R_i * ((A_exp : ℝ) * R_i) = 400 * (A_exp : ℝ) * R_i ^ 2 by ring]
      have hceil_lt : (Nat.ceil x_i : ℝ) < x_i + 1 := Nat.ceil_lt_add_one hx_pos.le
      have hQ_le : 1 + (N_seq i : ℝ) + (δ i)⁻¹ ≤ K_B * R_i ^ 2 := by
        have hN_cast : (N_seq i : ℝ) = 1 + (Nat.ceil x_i : ℝ) := by dsimp [N_seq]; push_cast; ring
        rw [hN_cast, hδ_inv_eq]
        have hR_sq_gt_R : R_i ≤ R_i ^ 2 := by nlinarith
        have hR_sq_gt_1 : 1 ≤ R_i ^ 2 := by nlinarith
        have hA_nonneg : (0 : ℝ) ≤ (A_exp : ℝ) := Nat.cast_nonneg _
        nlinarith [hK_B_eq]
      have hQ_nonneg : 0 ≤ 1 + (N_seq i : ℝ) + (δ i)⁻¹ := by positivity
      have hQ_pow : (1 + (N_seq i : ℝ) + (δ i)⁻¹) ^ B₀ ≤ K_B ^ B₀ * R_i ^ (2 * B₀) := by
        calc (1 + (N_seq i : ℝ) + (δ i)⁻¹) ^ B₀
            ≤ (K_B * R_i ^ 2) ^ B₀ := pow_le_pow_left₀ hQ_nonneg hQ_le B₀
          _ = K_B ^ B₀ * R_i ^ (2 * B₀) := by rw [mul_pow, ← pow_mul]
      have hR_ε_eq : R_i ^ (2 * B₀) * ε_bar i = d₀ ^ 2 * (1 / 4 : ℝ) ^ i := by
        rw [hε_eq_R]
        have hA_split : A_exp = 2 * B₀ + 2 := rfl
        rw [hA_split, pow_add, ← mul_assoc]
        have hcancel : R_i ^ (2 * B₀) * R_i⁻¹ ^ (2 * B₀) = 1 := by
          rw [← mul_pow, mul_inv_cancel₀ hR_pos.ne', one_pow]
        rw [hcancel, one_mul]
        dsimp [R_i]
        rw [inv_div, div_pow, div_eq_mul_inv]
        have : ((2 : ℝ) ^ i) ^ 2 = (4 : ℝ) ^ i := by
