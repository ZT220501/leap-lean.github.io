                (B₁ / (q : ℝ) ^ 2) * (B₂ / (q : ℝ)) * B₃ * ((C_osc / (q : ℝ)) * S_diff)) =
              ((8 : ℝ) ^ r *
                ((H_ker.C_ker / (q : ℝ) ^ 3) * (B₂ / (q : ℝ)) * B₃ * B₄ +
                  (B₁ / (q : ℝ) ^ 2) * (H_ker.C_ker / (q : ℝ) ^ 2) * B₃ * B₄ +
                  (B₁ / (q : ℝ) ^ 2) * (B₂ / (q : ℝ)) * (C_osc / (q : ℝ) ^ 2) * B₄ +
                  (B₁ / (q : ℝ) ^ 2) * (B₂ / (q : ℝ)) * B₃ * (C_osc / (q : ℝ)))) * S_diff := by
            ring
          rw [heq]
          exact mul_le_mul_of_nonneg_right (hCombineHalf r hr) hS_nonneg
        let subM : ℂ → ℂ := fun ζ =>
          cellKernelMinus_ℂ W₁ (X_ℂ₁ j (xInvMinus₁ j α ζ)) (μ_ℂ₁ j (xInvMinus₁ j α ζ)) ζ *
              (μ_ℂ₁ j (xInvMinus₁ j α ζ) - X_ℂ₁ j (xInvMinus₁ j α ζ)) *
              deriv (xInvMinus₁ j α) ζ *
              Complex.exp (-Complex.I * (n : ℂ) * (xInvMinus₁ j α ζ - ζ)) -
            cellKernelMinus_ℂ W₂ (X_ℂ₂ j (xInvMinus₂ j α ζ)) (μ_ℂ₂ j (xInvMinus₂ j α ζ)) ζ *
              (μ_ℂ₂ j (xInvMinus₂ j α ζ) - X_ℂ₂ j (xInvMinus₂ j α ζ)) *
              deriv (xInvMinus₂ j α) ζ *
              Complex.exp (-Complex.I * (n : ℂ) * (xInvMinus₂ j α ζ - ζ))
        let subP : ℂ → ℂ := fun ζ =>
          cellKernelPlus_ℂ W₁ (X_ℂ₁ (j + 1) (xInvPlus₁ j α ζ)) (μ_ℂ₁ j (xInvPlus₁ j α ζ)) ζ *
              (X_ℂ₁ (j + 1) (xInvPlus₁ j α ζ) - μ_ℂ₁ j (xInvPlus₁ j α ζ)) *
              deriv (xInvPlus₁ j α) ζ *
              Complex.exp (-Complex.I * (n : ℂ) * (xInvPlus₁ j α ζ - ζ)) -
            cellKernelPlus_ℂ W₂ (X_ℂ₂ (j + 1) (xInvPlus₂ j α ζ)) (μ_ℂ₂ j (xInvPlus₂ j α ζ)) ζ *
              (X_ℂ₂ (j + 1) (xInvPlus₂ j α ζ) - μ_ℂ₂ j (xInvPlus₂ j α ζ)) *
              deriv (xInvPlus₂ j α) ζ *
              Complex.exp (-Complex.I * (n : ℂ) * (xInvPlus₂ j α ζ - ζ))
        have hSplitΔ : (fun ζ => ΔG j ζ α) = (fun ζ => subM ζ + subP ζ) := by
          ext ζ; dsimp [ΔG, stripCellIntegrand_ℂ, subM, subP]; ring
        have hcM_diff : ContDiffAt ℂ (r : WithTop ℕ∞) subM w_pt :=
          (((hRegM₁.1 α hα).sub (hRegM₂.1 α hα)).contDiffOn hU_open).contDiffAt
            (hU_open.mem_nhds hw)
        have hcP_diff : ContDiffAt ℂ (r : WithTop ℕ∞) subP w_pt :=
          (((hRegP₁.1 α hα).sub (hRegP₂.1 α hα)).contDiffOn hU_open).contDiffAt
            (hU_open.mem_nhds hw)
        rw [hSplitΔ, iteratedDeriv_fun_add hcM_diff hcP_diff]
        calc ‖iteratedDeriv r subM w_pt + iteratedDeriv r subP w_pt‖
            ≤ ‖iteratedDeriv r subM w_pt‖ + ‖iteratedDeriv r subP w_pt‖ := norm_add_le _ _
          _ ≤ (C_half / (q : ℝ) ^ 4) * S_diff + (C_half / (q : ℝ) ^ 4) * S_diff :=
              add_le_add (le_trans hSubM hFactorS) (le_trans hSubP hFactorS)
          _ = (C_cell / (q : ℝ) ^ 4) * S_diff := by dsimp [C_cell]; ring
      have hPInt := hParamInt hU_open
        (mul_nonneg (by dsimp [C_cell]; positivity) hS_nonneg)
        hΔG_holo hΔG_cont hΔG_bnd
      exact ⟨hCont0, hPInt.1, hPInt.2⟩

    let D_lip : ℂ → ℂ := fun ζ =>
      pref * ∑ j ∈ Finset.range q, ∫ α in (0 : ℝ)..1, ΔG j ζ α
    have hEvLip : (fun ζ : ℂ =>
        stripB_canon n W₁ X_ℂ₁ μ_ℂ₁ xInvMinus₁ xInvPlus₁ ζ -
          stripB_canon n W₂ X_ℂ₂ μ_ℂ₂ xInvMinus₂ xInvPlus₂ ζ) =ᶠ[nhds z] D_lip := by
      filter_upwards [hU_open.mem_nhds hz] with ζ hζ
      dsimp [stripB_canon, D_lip, pref, q]
      have hIntSub : ∀ j ∈ Finset.range q,
          (∫ α in (0 : ℝ)..1, ΔG j ζ α) =
            (∫ α in (0 : ℝ)..1,
              stripCellIntegrand_ℂ n W₁ X_ℂ₁ μ_ℂ₁ xInvMinus₁ xInvPlus₁ j ζ α) -
            (∫ α in (0 : ℝ)..1,
              stripCellIntegrand_ℂ n W₂ X_ℂ₂ μ_ℂ₂ xInvMinus₂ xInvPlus₂ j ζ α) := by
        intro j hj
        have hc := (hCellDiffProps j (Finset.mem_range.mp hj)).1 ζ hζ
        exact intervalIntegral.integral_sub
          (hc.1.intervalIntegrable_of_Icc zero_le_one)
          (hc.2.intervalIntegrable_of_Icc zero_le_one)
      rw [Finset.sum_congr rfl hIntSub, Finset.sum_sub_distrib, mul_sub]
    have hSumLipHolo : DifferentiableOn ℂ
        (fun ζ => ∑ j ∈ Finset.range q, ∫ α in (0 : ℝ)..1, ΔG j ζ α) U_inv :=
      hHoloSum (Finset.range q) (fun j ζ => ∫ α in (0 : ℝ)..1, ΔG j ζ α)
        (fun j hj => (hCellDiffProps j (Finset.mem_range.mp hj)).2.1)
    have hSumLipContAt : ContDiffAt ℂ (k : WithTop ℕ∞)
        (fun ζ => ∑ j ∈ Finset.range q, ∫ α in (0 : ℝ)..1, ΔG j ζ α) z :=
      (hSumLipHolo.contDiffOn hU_open).contDiffAt (hU_open.mem_nhds hz)
    rw [hEvLip.iteratedDeriv_eq k]
    dsimp [D_lip]
    rw [iteratedDeriv_const_mul pref hSumLipContAt,
      hIterSum hU_open hz (Finset.range q)
        (fun j ζ => ∫ α in (0 : ℝ)..1, ΔG j ζ α)
        (fun j hj => (hCellDiffProps j (Finset.mem_range.mp hj)).2.1) k,
      norm_mul]
    have hpref_norm : ‖pref‖ = (q : ℝ) ^ 2 / (6 * Real.pi) := by
      dsimp [pref]
      rw [norm_neg, Complex.norm_real, Real.norm_eq_abs,
        abs_of_nonneg (by have := Real.pi_pos; positivity)]
    rw [hpref_norm]
    have hSumBnd : ‖∑ j ∈ Finset.range q,
          iteratedDeriv k (fun ζ => ∫ α in (0 : ℝ)..1, ΔG j ζ α) z‖ ≤
        (q : ℝ) * ((C_cell / (q : ℝ) ^ 4) * S_diff) := by
      calc ‖∑ j ∈ Finset.range q,
            iteratedDeriv k (fun ζ => ∫ α in (0 : ℝ)..1, ΔG j ζ α) z‖
          ≤ ∑ j ∈ Finset.range q,
              ‖iteratedDeriv k (fun ζ => ∫ α in (0 : ℝ)..1, ΔG j ζ α) z‖ :=
            norm_sum_le _ _
        _ ≤ ∑ _j ∈ Finset.range q, ((C_cell / (q : ℝ) ^ 4) * S_diff) := by
            apply Finset.sum_le_sum
            intro j hj
            exact (hCellDiffProps j (Finset.mem_range.mp hj)).2.2 k hk z hz
        _ = (q : ℝ) * ((C_cell / (q : ℝ) ^ 4) * S_diff) := by
            rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
    have hpi_ne : Real.pi ≠ 0 := Real.pi_ne_zero
    calc ((q : ℝ) ^ 2 / (6 * Real.pi)) *
          ‖∑ j ∈ Finset.range q,
            iteratedDeriv k (fun ζ => ∫ α in (0 : ℝ)..1, ΔG j ζ α) z‖
        ≤ ((q : ℝ) ^ 2 / (6 * Real.pi)) * ((q : ℝ) * ((C_cell / (q : ℝ) ^ 4) * S_diff)) :=
          mul_le_mul_of_nonneg_left hSumBnd (by have := Real.pi_pos; positivity)
      _ = ((C_cell / (6 * Real.pi)) / (q : ℝ)) * S_diff := by field_simp [hq_ne, hpi_ne]
      _ ≤ (C_mult / |(n : ℝ)|) * S_diff := by
          rw [hn_abs_R]
          apply mul_le_mul_of_nonneg_right _ hS_nonneg
          apply div_le_div_of_nonneg_right _ (le_of_lt hq_pos)
          dsimp [C_mult]; linarith

theorem strip_multiplier_extension_and_bounds (m : ℕ) (M : ℝ)
    (hm : 2 ≤ m) (hM : 0 < M) (S : StationaryMeshSystem m (M + 1)) :
    ∃ (K_strip : ℝ) (N_strip : ℕ), S.K_mesh < K_strip ∧ S.N_mesh ≤ N_strip ∧
      ∀ (σ : ℝ) (n : ℤ), σ ∈ Set.Ioc (0 : ℝ) 1 → (N_strip : ℤ) ≤ |n| →
        K_strip / (n : ℝ) ^ 2 < 1 →
        (∀ (w : ℝ → ℝ) (W : ℂ → ℂ),
          IsPeriodicSmoothBounded (m + 15) M w →
          IsBoundedStripExt (m + 15) σ M w W →
          ∃ B : ℂ → ℂ,
            DifferentiableOn ℂ B (horizStrip ((1 - K_strip / (n : ℝ) ^ 2) * σ)) ∧
            (∀ x : ℝ, B x = globalB_mult n w x) ∧
            (∀ z ∈ horizStrip ((1 - K_strip / (n : ℝ) ^ 2) * σ), B (z + 2 * Real.pi) = B z) ∧
            (∀ k : ℕ, k ≤ m → ∀ z ∈ horizStrip ((1 - K_strip / (n : ℝ) ^ 2) * σ),
              ‖iteratedDeriv k (fun ζ : ℂ => B ζ - 1) z‖ ≤ K_strip / |(n : ℝ)|)) ∧
        (∀ (K' : ℝ), K_strip ≤ K' → K' / (n : ℝ) ^ 2 < 1 →
          ∀ (w₁ w₂ : ℝ → ℝ) (W₁ W₂ B₁ B₂ : ℂ → ℂ),
            IsPeriodicSmoothBounded (m + 15) M w₁ →
            IsPeriodicSmoothBounded (m + 15) M w₂ →
            IsBoundedStripExt (m + 15) σ M w₁ W₁ →
            IsBoundedStripExt (m + 15) σ M w₂ W₂ →
            DifferentiableOn ℂ B₁ (horizStrip ((1 - K' / (n : ℝ) ^ 2) * σ)) →
            DifferentiableOn ℂ B₂ (horizStrip ((1 - K' / (n : ℝ) ^ 2) * σ)) →
            (∀ x : ℝ, B₁ x = globalB_mult n w₁ x) →
            (∀ x : ℝ, B₂ x = globalB_mult n w₂ x) →
            ∀ k : ℕ, k ≤ m → ∀ z ∈ horizStrip ((1 - K' / (n : ℝ) ^ 2) * σ),
              ‖iteratedDeriv k (fun ζ : ℂ => B₁ ζ - B₂ ζ) z‖ ≤
                (K_strip / |(n : ℝ)|) * stripDiffSup (m + 15) σ W₁ W₂) :=
by
  have hStripEqOn : ∀ (H : ℝ), 0 < H → ∀ (f g : ℂ → ℂ),
      DifferentiableOn ℂ f (horizStrip H) →
      DifferentiableOn ℂ g (horizStrip H) →
      (∀ x : ℝ, f x = g x) →
      Set.EqOn f g (horizStrip H) := by
    intro H hH f g hf hg hreal
    have hOpen : IsOpen (horizStrip H) :=
      isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const
    have hConv : Convex ℝ (horizStrip H) := by
      intro z₁ hz₁ z₂ hz₂ a b ha hb hab
      change |(a • z₁ + b • z₂).im| < H
      change |z₁.im| < H at hz₁
      change |z₂.im| < H at hz₂
      have him : (a • z₁ + b • z₂).im = a * z₁.im + b * z₂.im := by simp
      rw [him]
      calc |a * z₁.im + b * z₂.im|
          ≤ |a * z₁.im| + |b * z₂.im| := abs_add_le _ _
        _ = a * |z₁.im| + b * |z₂.im| := by
            rw [abs_mul, abs_mul, abs_of_nonneg ha, abs_of_nonneg hb]
        _ < a * H + b * H := by
            rcases eq_or_lt_of_le ha with rfl | ha_pos
            · simp at hab ⊢; subst hab; simpa using hz₂
            · have h1 : a * |z₁.im| < a * H := mul_lt_mul_of_pos_left hz₁ ha_pos
              have h2 : b * |z₂.im| ≤ b * H := mul_le_mul_of_nonneg_left (le_of_lt hz₂) hb
              linarith
        _ = H := by nlinarith
    have h0 : (0 : ℂ) ∈ horizStrip H := by
      change |(0 : ℂ).im| < H
      simpa using hH
    have hFreq : ∃ᶠ z in nhdsWithin (0 : ℂ) {(0 : ℂ)}ᶜ, f z = g z := by
      rw [Filter.frequently_iff]
      intro U hU
      rw [Metric.mem_nhdsWithin_iff] at hU
      obtain ⟨ε, hε, hSub⟩ := hU
      refine ⟨((ε / 2 : ℝ) : ℂ), hSub ⟨?_, ?_⟩, hreal (ε / 2)⟩
      · rw [Metric.mem_ball, dist_zero_right, Complex.norm_real, Real.norm_eq_abs,
          abs_of_pos (by linarith)]
        linarith
      · simp only [Set.mem_compl_iff, Set.mem_singleton_iff, Complex.ofReal_eq_zero]
        linarith
    exact (hf.analyticOnNhd hOpen).eqOn_of_preconnected_of_frequently_eq
      (hg.analyticOnNhd hOpen) hConv.isPreconnected h0 hFreq
  obtain ⟨H_inv⟩ := strip_half_cell_inv_system m M hm hM S
  obtain ⟨H_ker⟩ := strip_cell_kernel_system m M hm hM S H_inv
  obtain ⟨C_mult, N_mult, hCm_pos, hNm_ge, hMult⟩ :=
    strip_canonical_multiplier_bounds m M hm hM S H_inv H_ker
  let K_strip : ℝ := max H_inv.K_inv C_mult + 1
  let N_strip : ℕ := N_mult
  have hKm_lt_Ks : S.K_mesh < K_strip := by
    have h1 := H_inv.K_mesh_lt
    have h2 : H_inv.K_inv ≤ max H_inv.K_inv C_mult := le_max_left _ _
    dsimp [K_strip]
    linarith
  have hNm_le_Ns : S.N_mesh ≤ N_strip :=
    le_trans H_inv.N_mesh_le (le_trans H_ker.N_inv_le hNm_ge)
  refine ⟨K_strip, N_strip, hKm_lt_Ks, hNm_le_Ns, ?_⟩
  intro σ n hσ hn hKs_lt_one
  have hσ_pos : 0 < σ := hσ.1
  have hσ_nonneg : 0 ≤ σ := le_of_lt hσ_pos
  have hq_abs : |n| = (n.natAbs : ℤ) := by
    rcases Int.natAbs_eq n with h | h
    · conv_lhs => rw [h]
      exact abs_of_nonneg (Nat.cast_nonneg _)
    · conv_lhs => rw [h]
      rw [abs_neg]
      exact abs_of_nonneg (Nat.cast_nonneg _)
  have hq_sq : (n.natAbs : ℝ) ^ 2 = (n : ℝ) ^ 2 := by
    have hsq_int : ((n.natAbs : ℕ) : ℤ) ^ 2 = n ^ 2 := by
      rcases Int.natAbs_eq n with h | h
      · conv_rhs => rw [h]
      · conv_rhs => rw [h]
        ring
    have hc := congrArg (Int.cast : ℤ → ℝ) hsq_int
    rw [Int.cast_pow, Int.cast_natCast, Int.cast_pow] at hc
    exact hc
  have hNmult_le_q : N_mult ≤ n.natAbs := by
    dsimp [N_strip] at hn
    rw [hq_abs] at hn
    exact Int.ofNat_le.mp hn
  have hNinv_le_q : H_inv.N_inv ≤ n.natAbs :=
    le_trans H_ker.N_inv_le (le_trans hNm_ge hNmult_le_q)
  have hNmesh_le_q : S.N_mesh ≤ n.natAbs :=
    le_trans H_inv.N_mesh_le hNinv_le_q
  have hKinv_le_Ks : H_inv.K_inv ≤ K_strip := by
    have h1 : H_inv.K_inv ≤ max H_inv.K_inv C_mult := le_max_left _ _
    dsimp [K_strip]
    linarith
  have hCm_le_Ks : C_mult ≤ K_strip := by
    have h1 : C_mult ≤ max H_inv.K_inv C_mult := le_max_right _ _
    dsimp [K_strip]
    linarith
  have hKinv_div_le : H_inv.K_inv / (n : ℝ) ^ 2 ≤ K_strip / (n : ℝ) ^ 2 :=
    div_le_div_of_nonneg_right hKinv_le_Ks (sq_nonneg _)
  have hKinv_lt_one : H_inv.K_inv / (n : ℝ) ^ 2 < 1 :=
    lt_of_le_of_lt hKinv_div_le hKs_lt_one
  have hKinv_q_lt_one : H_inv.K_inv / (n.natAbs : ℝ) ^ 2 < 1 := by
    rwa [hq_sq]
  have hKmesh_q_lt_one : S.K_mesh / (n.natAbs : ℝ) ^ 2 < 1 := by
    have h1 : S.K_mesh / (n.natAbs : ℝ) ^ 2 ≤ H_inv.K_inv / (n.natAbs : ℝ) ^ 2 :=
      div_le_div_of_nonneg_right (le_of_lt H_inv.K_mesh_lt) (sq_nonneg _)
    exact lt_of_le_of_lt h1 hKinv_q_lt_one
  have hBuildTuple : ∀ (w : ℝ → ℝ) (W : ℂ → ℂ),
      IsPeriodicSmoothBounded (m + 15) M w →
      IsBoundedStripExt (m + 15) σ M w W →
      ∃ (X_ℂ μ_ℂ : ℕ → ℂ → ℂ) (xInvMinus xInvPlus : ℕ → ℝ → ℂ → ℂ),
        IsAdmissibleStripInvTuple m M S H_inv.K_inv H_inv.C_inv σ n.natAbs w W
          X_ℂ μ_ℂ xInvMinus xInvPlus := by
    intro w W hw hW
    have hw_M1 : IsPeriodicSmoothBounded (m + 15) (M + 1) w :=
      ⟨hw.1, hw.2.1, fun k hk x => le_trans (hw.2.2 k hk x) (by linarith)⟩
    have hW_M1 : IsBoundedStripExt (m + 15) σ (M + 1) w W :=
      ⟨hW.1, hW.2.1, hW.2.2.1, hW.2.2.2.1,
        fun k hk z hz => le_trans (hW.2.2.2.2 k hk z hz) (by linarith)⟩
    obtain ⟨X_ℂ, μ_ℂ, hMesh⟩ :=
      S.strip_mesh_ext σ n.natAbs w W hσ hNmesh_le_q hKmesh_q_lt_one hw_M1 hW_M1
    obtain ⟨xInvMinus, xInvPlus, hInv⟩ :=
      H_inv.inv_ext σ n.natAbs w W X_ℂ μ_ℂ hσ hNinv_le_q hKinv_q_lt_one hw hW hMesh
    exact ⟨X_ℂ, μ_ℂ, xInvMinus, xInvPlus, hw, hW, hMesh, hInv⟩
  obtain ⟨hMult1, hMult2⟩ := hMult σ n hσ hn hKinv_lt_one
  refine ⟨?_, ?_⟩
  · intro w W hw hW
    obtain ⟨X_ℂ, μ_ℂ, xInvMinus, xInvPlus, hAdm⟩ := hBuildTuple w W hw hW
    obtain ⟨hB_holo, hB_real, hB_per, hB_bnd⟩ :=
      hMult1 w W X_ℂ μ_ℂ xInvMinus xInvPlus hAdm
    have hSub :
        horizStrip ((1 - K_strip / (n : ℝ) ^ 2) * σ) ⊆
          horizStrip ((1 - H_inv.K_inv / (n : ℝ) ^ 2) * σ) := by
      intro z hz
      change |z.im| < (1 - K_strip / (n : ℝ) ^ 2) * σ at hz
      change |z.im| < (1 - H_inv.K_inv / (n : ℝ) ^ 2) * σ
      have hWidth : (1 - K_strip / (n : ℝ) ^ 2) * σ ≤ (1 - H_inv.K_inv / (n : ℝ) ^ 2) * σ :=
        mul_le_mul_of_nonneg_right (by linarith) hσ_nonneg
      exact lt_of_lt_of_le hz hWidth
    refine ⟨stripB_canon n W X_ℂ μ_ℂ xInvMinus xInvPlus,
      hB_holo.mono hSub, hB_real, ?_, ?_⟩
    · intro z hz
      exact hB_per z (hSub hz)
    · intro k hk z hz
      exact le_trans (hB_bnd k hk z (hSub hz))
        (div_le_div_of_nonneg_right hCm_le_Ks (abs_nonneg _))
  · intro K' hKs_le_K' hK'_lt_one w₁ w₂ W₁ W₂ B₁ B₂ hw₁ hw₂ hW₁ hW₂
      hB₁_holo hB₂_holo hB₁_real hB₂_real k hk z hz
    obtain ⟨X_ℂ₁, μ_ℂ₁, xInvMinus₁, xInvPlus₁, hAdm₁⟩ := hBuildTuple w₁ W₁ hw₁ hW₁
    obtain ⟨X_ℂ₂, μ_ℂ₂, xInvMinus₂, xInvPlus₂, hAdm₂⟩ := hBuildTuple w₂ W₂ hw₂ hW₂
    obtain ⟨hBc₁_holo, hBc₁_real, _, _⟩ :=
      hMult1 w₁ W₁ X_ℂ₁ μ_ℂ₁ xInvMinus₁ xInvPlus₁ hAdm₁
    obtain ⟨hBc₂_holo, hBc₂_real, _, _⟩ :=
      hMult1 w₂ W₂ X_ℂ₂ μ_ℂ₂ xInvMinus₂ xInvPlus₂ hAdm₂
    let H' : ℝ := (1 - K' / (n : ℝ) ^ 2) * σ
    have hH'_pos : 0 < H' := mul_pos (by linarith) hσ_pos
    have hKinv_le_K' : H_inv.K_inv ≤ K' := le_trans hKinv_le_Ks hKs_le_K'
    have hKinv_div_le_K' : H_inv.K_inv / (n : ℝ) ^ 2 ≤ K' / (n : ℝ) ^ 2 :=
      div_le_div_of_nonneg_right hKinv_le_K' (sq_nonneg _)
    have hSub' :
        horizStrip H' ⊆ horizStrip ((1 - H_inv.K_inv / (n : ℝ) ^ 2) * σ) := by
      intro ζ hζ
      change |ζ.im| < H' at hζ
      change |ζ.im| < (1 - H_inv.K_inv / (n : ℝ) ^ 2) * σ
      have hWidth : H' ≤ (1 - H_inv.K_inv / (n : ℝ) ^ 2) * σ :=
        mul_le_mul_of_nonneg_right (by linarith) hσ_nonneg
      exact lt_of_lt_of_le hζ hWidth
    let B_c₁ := stripB_canon n W₁ X_ℂ₁ μ_ℂ₁ xInvMinus₁ xInvPlus₁
    let B_c₂ := stripB_canon n W₂ X_ℂ₂ μ_ℂ₂ xInvMinus₂ xInvPlus₂
    have hEq₁ : Set.EqOn B₁ B_c₁ (horizStrip H') :=
      hStripEqOn H' hH'_pos B₁ B_c₁ hB₁_holo (hBc₁_holo.mono hSub')
        (fun x => (hB₁_real x).trans (hBc₁_real x).symm)
    have hEq₂ : Set.EqOn B₂ B_c₂ (horizStrip H') :=
      hStripEqOn H' hH'_pos B₂ B_c₂ hB₂_holo (hBc₂_holo.mono hSub')
        (fun x => (hB₂_real x).trans (hBc₂_real x).symm)
    have hEqDiff : Set.EqOn (fun ζ : ℂ => B₁ ζ - B₂ ζ) (fun ζ : ℂ => B_c₁ ζ - B_c₂ ζ)
        (horizStrip H') := by
      intro ζ hζ
      simp only [hEq₁ hζ, hEq₂ hζ]
    have hOpen' : IsOpen (horizStrip H') :=
      isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const
    have hEvEq : (fun ζ : ℂ => B₁ ζ - B₂ ζ) =ᶠ[nhds z] (fun ζ : ℂ => B_c₁ ζ - B_c₂ ζ) :=
      hEqDiff.eventuallyEq_of_mem (hOpen'.mem_nhds hz)
    rw [hEvEq.iteratedDeriv_eq k]
    have hLip :=
      hMult2 w₁ w₂ W₁ W₂ X_ℂ₁ μ_ℂ₁ X_ℂ₂ μ_ℂ₂ xInvMinus₁ xInvPlus₁ xInvMinus₂ xInvPlus₂
        hAdm₁ hAdm₂ k hk z (hSub' hz)
    have hSupNonneg : 0 ≤ stripDiffSup (m + 15) σ W₁ W₂ := by
      apply Real.sSup_nonneg
      rintro r ⟨j, _, ζ, _, rfl⟩
      exact norm_nonneg _
    have hK_le : C_mult / |(n : ℝ)| ≤ K_strip / |(n : ℝ)| :=
      div_le_div_of_nonneg_right hCm_le_Ks (abs_nonneg _)
    exact le_trans hLip (mul_le_mul_of_nonneg_right hK_le hSupNonneg)

theorem high_frequency_action_system (Ω : Set Plane)
    (R : RationalCollarData Ω) :
    Nonempty (HighFreqActionSystem (fun x : ℝ => Real.log (deriv R.ϕ x))) :=
by
  have hIntConj : ∀ (a b : ℝ) (f : ℝ → ℂ),
      (∫ x in a..b, starRingEnd ℂ (f x)) = starRingEnd ℂ (∫ x in a..b, f x) := by
    intro a b f
    simp only [intervalIntegral, integral_conj, map_sub]
  have hPhaseConj : ∀ (n : ℤ) (θ : ℝ),
      Complex.exp (-Complex.I * ((-n : ℤ) : ℂ) * (θ : ℂ)) =
        starRingEnd ℂ (Complex.exp (-Complex.I * (n : ℂ) * (θ : ℂ))) := by
    intro n θ
    rw [← Complex.exp_conj]
    congr 1
    simp only [Int.cast_neg, map_mul, map_neg, Complex.conj_I, Complex.conj_ofReal, map_intCast]
    ring
  have hC_conj : ∀ (n : ℤ) (w : ℝ → ℝ),
      globalC_coeff (-n) w = starRingEnd ℂ (globalC_coeff n w) := by
    intro n w
    by_cases hn : n = 0
    · subst hn; simp [globalC_coeff]
    · have hneg : -n ≠ 0 := neg_ne_zero.mpr hn
      by_cases hMesh : HasUniqueGlobalMesh n.natAbs w
      · simp only [globalC_coeff, hn, hneg, hMesh, ↓reduceIte, Int.natAbs_neg]
        have hBody :
            (fun x : ℝ =>
              Complex.exp (-Complex.I * ((-n : ℤ) : ℂ) * (x : ℂ)) *
                (critAction_ℝ n.natAbs w x : ℂ)) =
            (fun x : ℝ =>
              starRingEnd ℂ
                (Complex.exp (-Complex.I * (n : ℂ) * (x : ℂ)) *
                  (critAction_ℝ n.natAbs w x : ℂ))) := by
          ext x
          rw [hPhaseConj n x, map_mul, Complex.conj_ofReal]
        rw [hBody, hIntConj]
        simp only [map_neg, map_mul, map_inv₀, Complex.conj_ofReal]
      · simp [globalC_coeff, hn, hneg, hMesh]
  have hb_conj : ∀ (n : ℤ) (w : ℝ → ℝ) (z : ℝ),
      globalB_mult (-n) w z = starRingEnd ℂ (globalB_mult n w z) := by
    intro n w z
    by_cases hn : n = 0
    · subst hn; simp [globalB_mult]
    · have hneg : -n ≠ 0 := neg_ne_zero.mpr hn
      by_cases hMesh : HasUniqueGlobalMesh n.natAbs w
      · simp only [globalB_mult, hn, hneg, hMesh, ↓reduceIte, Int.natAbs_neg]
        simp only [map_neg, map_mul, Complex.conj_ofReal, map_sum]
        congr 2
        ext j
        rw [← hIntConj]
        congr 1
        ext α
        simp only [hPhaseConj, map_add, map_mul, Complex.conj_ofReal]
      · simp [globalB_mult, hn, hneg, hMesh]
  obtain ⟨N_vanish, hN_pos, hZeroTab⟩ := table_and_zero_action_vanishing Ω R
  refine ⟨{
    C_coeff := globalC_coeff
    b_mult := globalB_mult
    N_vanish := N_vanish
    N_vanish_pos := hN_pos
    C_zero := fun n hn => (hZeroTab n hn).1
    C_table_zero := fun n hn => (hZeroTab n hn).2
    C_conj_symm := hC_conj
    b_mult_conj_symm := hb_conj
    deriv_and_bounds := ?_
  }⟩
  intro m M hm hM
  have hM1 : 0 < M + 1 := by linarith
  obtain ⟨S⟩ := uniform_stationary_mesh_system m (M + 1) hm hM1
  obtain ⟨K_real, N_real, hKr_pos, _, hReal⟩ :=
    real_action_deriv_and_multiplier_bounds m M hm hM S
  obtain ⟨K_strip, N_strip, hKs_gt, _, hStrip⟩ :=
    strip_multiplier_extension_and_bounds m M hm hM S
  let K : ℝ := max K_real K_strip
  let N_m : ℕ := max N_vanish (max N_real N_strip)
  refine ⟨K, N_m, lt_max_of_lt_left hKr_pos, le_max_left _ _, ?_, ?_⟩
  · intro n hn
    have hn_real : (N_real : ℤ) ≤ |n| := by
      have h1 : N_real ≤ N_m := le_trans (le_max_left _ _) (le_max_right _ _)
      exact le_trans (Int.ofNat_le.mpr h1) hn
    obtain ⟨hReal1, hReal2⟩ := hReal n hn_real
    refine ⟨?_, ?_⟩
    · intro w hw
      obtain ⟨hCont, hPer, hDeriv, hBnd⟩ := hReal1 w hw
      refine ⟨hCont, hPer, hDeriv, ?_⟩
      intro k hk x
      exact le_trans (hBnd k hk x)
        (div_le_div_of_nonneg_right (le_max_left K_real K_strip) (abs_nonneg _))
    · intro w₁ w₂ hw₁ hw₂ k hk x
      have hSupNonneg : 0 ≤ realDiffSup (m + 15) w₁ w₂ := by
        apply Real.sSup_nonneg
        rintro r ⟨j, _, y, _, rfl⟩
        exact abs_nonneg _
      have hK_le : K_real / |(n : ℝ)| ≤ K / |(n : ℝ)| :=
        div_le_div_of_nonneg_right (le_max_left K_real K_strip) (abs_nonneg _)
      exact le_trans (hReal2 w₁ w₂ hw₁ hw₂ k hk x)
        (mul_le_mul_of_nonneg_right hK_le hSupNonneg)
  · intro σ n hσ hn hKn
    have hn_strip : (N_strip : ℤ) ≤ |n| := by
      have h1 : N_strip ≤ N_m := le_trans (le_max_right _ _) (le_max_right _ _)
      exact le_trans (Int.ofNat_le.mpr h1) hn
    have hKs_le_K : K_strip ≤ K := le_max_right K_real K_strip
    have hKs_n2 : K_strip / (n : ℝ) ^ 2 ≤ K / (n : ℝ) ^ 2 :=
      div_le_div_of_nonneg_right hKs_le_K (sq_nonneg _)
    have hKs_lt_one : K_strip / (n : ℝ) ^ 2 < 1 := lt_of_le_of_lt hKs_n2 hKn
    have hSub :
        horizStrip ((1 - K / (n : ℝ) ^ 2) * σ) ⊆
          horizStrip ((1 - K_strip / (n : ℝ) ^ 2) * σ) := by
      intro z hz
      change |z.im| < (1 - K / (n : ℝ) ^ 2) * σ at hz
      change |z.im| < (1 - K_strip / (n : ℝ) ^ 2) * σ
      have hσ_nonneg : 0 ≤ σ := le_of_lt hσ.1
      have hWidth : (1 - K / (n : ℝ) ^ 2) * σ ≤ (1 - K_strip / (n : ℝ) ^ 2) * σ :=
        mul_le_mul_of_nonneg_right (by linarith) hσ_nonneg
      exact lt_of_lt_of_le hz hWidth
    obtain ⟨hStrip1, hStrip2⟩ := hStrip σ n hσ hn_strip hKs_lt_one
    refine ⟨?_, ?_⟩
    · intro w W hw hW
      obtain ⟨B, hB_holo, hB_real, hB_per, hB_bnd⟩ := hStrip1 w W hw hW
      refine ⟨B, hB_holo.mono hSub, hB_real, ?_, ?_⟩
      · intro z hz
        exact hB_per z (hSub hz)
      · intro k hk z hz
        exact le_trans (hB_bnd k hk z (hSub hz))
          (div_le_div_of_nonneg_right hKs_le_K (abs_nonneg _))
    · intro w₁ w₂ W₁ W₂ B₁ B₂ hw₁ hw₂ hW₁ hW₂ hB₁_holo hB₂_holo hB₁_real hB₂_real k hk z hz
      have hLip :=
        hStrip2 K hKs_le_K hKn w₁ w₂ W₁ W₂ B₁ B₂
          hw₁ hw₂ hW₁ hW₂ hB₁_holo hB₂_holo hB₁_real hB₂_real k hk z hz
      have hSupNonneg : 0 ≤ stripDiffSup (m + 15) σ W₁ W₂ := by
        apply Real.sSup_nonneg
        rintro r ⟨j, _, ζ, _, rfl⟩
        exact norm_nonneg _
      have hK_le : K_strip / |(n : ℝ)| ≤ K / |(n : ℝ)| :=
        div_le_div_of_nonneg_right hKs_le_K (abs_nonneg _)
      exact le_trans hLip (mul_le_mul_of_nonneg_right hK_le hSupNonneg)

theorem high_mode_wiener_operator_inversion (Ω : Set Plane)
    (R : RationalCollarData Ω)
    (H_sys : HighFreqActionSystem (uTable R)) :
    ∃ N_op : ℕ, H_sys.N_vanish ≤ N_op ∧
      ∀ N : ℕ, N_op ≤ N → Nonempty (WienerHighModeAt R H_sys N) :=
by
  have isOpen_horizStrip : ∀ τ : ℝ, IsOpen (horizStrip τ) :=
    fun τ => isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const
  have periodic_ibp_one : ∀ (h h' : ℝ → ℂ), (∀ x : ℝ, HasDerivAt h (h' x) x) →
      Continuous h' → h (2 * Real.pi) = h 0 → ∀ (j : ℤ), j ≠ 0 → ∀ (y : ℝ),
      ∫ x in (0 : ℝ)..(2 * Real.pi),
        Complex.exp (-Complex.I * (j : ℂ) * ((x : ℂ) + (y : ℂ) * Complex.I)) * h x =
      -(-Complex.I * (j : ℂ))⁻¹ *
        ∫ x in (0 : ℝ)..(2 * Real.pi),
          Complex.exp (-Complex.I * (j : ℂ) * ((x : ℂ) + (y : ℂ) * Complex.I)) * h' x := by
    intro h h' hh hh'_cont hper j hj y
    set α : ℂ := -Complex.I * (j : ℂ)
    have hα : α ≠ 0 := mul_ne_zero (neg_ne_zero.mpr Complex.I_ne_zero) (Int.cast_ne_zero.mpr hj)
    let E : ℝ → ℂ := fun x => Complex.exp (α * ((x : ℂ) + (y : ℂ) * Complex.I))
    have hE_cont : Continuous E := by fun_prop
    have h_cont : Continuous h := Differentiable.continuous (fun x => (hh x).differentiableAt)
    have hE_deriv : ∀ x : ℝ, HasDerivAt E (α * E x) x := by
      intro x
      have hx : HasDerivAt (fun x' : ℝ => α * ((x' : ℂ) + (y : ℂ) * Complex.I)) α x := by
        simpa using ((Complex.ofRealCLM.hasDerivAt (x := x)).add_const
          ((y : ℂ) * Complex.I)).const_mul α
      simpa [E, mul_comm] using hx.cexp
    have hE_per : E (2 * Real.pi) = E 0 := by
      dsimp [E]
      have hexp : α * (((2 * Real.pi : ℝ) : ℂ) + (y : ℂ) * Complex.I) =
          α * (((0 : ℝ) : ℂ) + (y : ℂ) * Complex.I) + ((-j : ℤ) : ℂ) * (2 * Real.pi * Complex.I) := by
        dsimp [α]; push_cast; ring
      rw [hexp, Complex.exp_add, Complex.exp_int_mul_two_pi_mul_I, mul_one, Complex.ofReal_zero]
    let P : ℝ → ℂ := fun x => α⁻¹ * E x * h x
    have hP_deriv : ∀ x ∈ Set.uIcc (0 : ℝ) (2 * Real.pi),
        HasDerivAt P (E x * h x + α⁻¹ * E x * h' x) x := by
      intro x _
      have hd := ((hE_deriv x).const_mul α⁻¹).mul (hh x)
      convert hd using 1
      rw [← mul_assoc, inv_mul_cancel₀ hα, one_mul]
    have hf1_int : IntervalIntegrable (fun x => E x * h x) MeasureTheory.volume 0 (2 * Real.pi) :=
      (hE_cont.mul h_cont).intervalIntegrable _ _
    have hf2_int : IntervalIntegrable (fun x => α⁻¹ * E x * h' x)
        MeasureTheory.volume 0 (2 * Real.pi) :=
      ((continuous_const.mul hE_cont).mul hh'_cont).intervalIntegrable _ _
    have hftc := intervalIntegral.integral_eq_sub_of_hasDerivAt hP_deriv (hf1_int.add hf2_int)
    have hP_sub : P (2 * Real.pi) - P 0 = 0 := by
      dsimp [P]; rw [hE_per, hper, sub_self]
    rw [hP_sub, intervalIntegral.integral_add hf1_int hf2_int] at hftc
    have hpull : (∫ x in (0 : ℝ)..(2 * Real.pi), α⁻¹ * E x * h' x) =
        α⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi), E x * h' x := by
      simp [mul_assoc, intervalIntegral.integral_const_mul]
    rw [hpull] at hftc
    calc ∫ x in (0 : ℝ)..(2 * Real.pi), E x * h x
        = -(α⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi), E x * h' x) := eq_neg_of_add_eq_zero_left hftc
      _ = -α⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi), E x * h' x := by ring
  have periodic_ibp_two_bound : ∀ (h h' h'' : ℝ → ℂ),
      (∀ x : ℝ, HasDerivAt h (h' x) x) →
      (∀ x : ℝ, HasDerivAt h' (h'' x) x) →
      Continuous h'' →
      h (2 * Real.pi) = h 0 → h' (2 * Real.pi) = h' 0 →
      ∀ (L : ℝ), 0 ≤ L → (∀ x : ℝ, ‖h'' x‖ ≤ L) →
      ∀ (j : ℤ), j ≠ 0 → ∀ (y : ℝ),
      ‖((2 * Real.pi : ℝ) : ℂ)⁻¹ *
        ∫ x in (0 : ℝ)..(2 * Real.pi),
          Complex.exp (-Complex.I * (j : ℂ) * ((x : ℂ) + (y : ℂ) * Complex.I)) * h x‖ ≤
        (4 * L / (1 + |(j : ℝ)|) ^ 2) * Real.exp ((j : ℝ) * y) := by
    intro h h' h'' hh hh' hh''_cont hper h'per L hL hbound j hj y
    have hh'_cont : Continuous h' := Differentiable.continuous (fun x => (hh' x).differentiableAt)
    rw [periodic_ibp_one h h' hh hh'_cont hper j hj y,
        periodic_ibp_one h' h'' hh' hh''_cont h'per j hj y]
    set α : ℂ := -Complex.I * (j : ℂ)
    have hα_norm : ‖-α⁻¹‖ = |(j : ℝ)|⁻¹ := by
      simp [α, norm_inv, Complex.norm_I]
    have hexp_norm : ∀ x : ℝ,
        ‖Complex.exp (α * ((x : ℂ) + (y : ℂ) * Complex.I))‖ = Real.exp ((j : ℝ) * y) := by
      intro x
      have hre : α * ((x : ℂ) + (y : ℂ) * Complex.I) =
          (((j : ℝ) * y : ℝ) : ℂ) + ((-(j : ℝ) * x : ℝ) : ℂ) * Complex.I := by
        dsimp [α]; push_cast; ring_nf; simp [Complex.I_sq]
      rw [hre, Complex.norm_exp]
      simp
    have hint_le : ‖∫ x in (0 : ℝ)..(2 * Real.pi),
        Complex.exp (α * ((x : ℂ) + (y : ℂ) * Complex.I)) * h'' x‖ ≤
        (Real.exp ((j : ℝ) * y) * L) * (2 * Real.pi) := by
      have h1 := intervalIntegral.norm_integral_le_of_norm_le_const
        (a := (0 : ℝ)) (b := 2 * Real.pi) (C := Real.exp ((j : ℝ) * y) * L)
        (f := fun x => Complex.exp (α * ((x : ℂ) + (y : ℂ) * Complex.I)) * h'' x)
        (fun x _ => by
          rw [norm_mul, hexp_norm]
          exact mul_le_mul_of_nonneg_left (hbound x) (Real.exp_nonneg _))
      have h2pi : |2 * Real.pi - 0| = 2 * Real.pi := by
        rw [sub_zero, abs_of_pos Real.two_pi_pos]
      simpa [h2pi] using h1
    have h2pi_inv : ‖((2 * Real.pi : ℝ) : ℂ)⁻¹‖ = (2 * Real.pi)⁻¹ := by
      rw [norm_inv, Complex.norm_real, Real.norm_of_nonneg Real.two_pi_pos.le]
    have hj_one : (1 : ℝ) ≤ |(j : ℝ)| := by
      exact_mod_cast Int.one_le_abs hj
    have hj_pos : (0 : ℝ) < |(j : ℝ)| := lt_of_lt_of_le zero_lt_one hj_one
    have hj_sq : (1 + |(j : ℝ)|) ^ 2 ≤ 4 * |(j : ℝ)| ^ 2 := by nlinarith
    have hfrac : |(j : ℝ)|⁻¹ * (|(j : ℝ)|⁻¹ * L) ≤ 4 * L / (1 + |(j : ℝ)|) ^ 2 := by
      have hpos1 : 0 < (1 + |(j : ℝ)|) ^ 2 := by positivity
      have hpos2 : 0 < |(j : ℝ)| ^ 2 := by positivity
      rw [show |(j : ℝ)|⁻¹ * (|(j : ℝ)|⁻¹ * L) = L / |(j : ℝ)| ^ 2 by ring]
      rw [div_le_div_iff₀ hpos2 hpos1]
      nlinarith
    calc ‖((2 * Real.pi : ℝ) : ℂ)⁻¹ *
          (-α⁻¹ * (-α⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi),
            Complex.exp (α * ((x : ℂ) + (y : ℂ) * Complex.I)) * h'' x))‖
        = (2 * Real.pi)⁻¹ * (|(j : ℝ)|⁻¹ * (|(j : ℝ)|⁻¹ *
            ‖∫ x in (0 : ℝ)..(2 * Real.pi),
              Complex.exp (α * ((x : ℂ) + (y : ℂ) * Complex.I)) * h'' x‖)) := by
          simp only [norm_mul, h2pi_inv, hα_norm]
      _ ≤ (2 * Real.pi)⁻¹ * (|(j : ℝ)|⁻¹ * (|(j : ℝ)|⁻¹ *
            ((Real.exp ((j : ℝ) * y) * L) * (2 * Real.pi)))) := by
          gcongr
      _ = (|(j : ℝ)|⁻¹ * (|(j : ℝ)|⁻¹ * L)) * Real.exp ((j : ℝ) * y) := by
          field_simp [Real.two_pi_pos.ne']
      _ ≤ (4 * L / (1 + |(j : ℝ)|) ^ 2) * Real.exp ((j : ℝ) * y) := by
          exact mul_le_mul_of_nonneg_right hfrac (Real.exp_nonneg _)
  have h_four :
      (∀ (g : ℝ → ℂ) (L : ℝ), 0 ≤ L →
        Function.Periodic g (2 * Real.pi) →
        ContDiff ℝ (2 : WithTop ℕ∞) g →
        (∀ p : ℕ, p ≤ 2 → ∀ x : ℝ, ‖iteratedDeriv p g x‖ ≤ L) →
        ∀ j : ℤ, ‖periodicFourierCoeff g j‖ ≤ 4 * L / (1 + |(j : ℝ)|) ^ 2) ∧
      (∀ (τ L : ℝ) (g : ℝ → ℂ) (G : ℂ → ℂ), 0 < τ → 0 ≤ L →
        DifferentiableOn ℂ G (horizStrip τ) →
        (∀ x : ℝ, G x = g x) →
        (∀ z ∈ horizStrip τ, G (z + 2 * Real.pi) = G z) →
        (∀ p : ℕ, p ≤ 2 → ∀ z ∈ horizStrip τ, ‖iteratedDeriv p G z‖ ≤ L) →
        ∀ j : ℤ, ‖periodicFourierCoeff g j‖ ≤
          (4 * L / (1 + |(j : ℝ)|) ^ 2) * Real.exp (-τ * |(j : ℝ)|)) ∧
      (∀ (g₁ g₂ : ℝ → ℂ), (∀ x : ℝ, g₂ x = starRingEnd ℂ (g₁ x)) →
        ∀ j : ℤ, periodicFourierCoeff g₂ (-j) = starRingEnd ℂ (periodicFourierCoeff g₁ j)) ∧
      (∀ (c : ℤ → ℂ) (b : ℝ → ℂ),
        (∀ k : ℤ, c (-k) = starRingEnd ℂ (c k)) →
        Summable (fun k : ℤ => ‖c k‖) →
        Continuous b →
        ∀ n : ℤ,
          (Summable (fun k : ℤ => periodicFourierCoeff b (n - k) * c k) ∧
            ((2 * Real.pi : ℝ) : ℂ)⁻¹ *
              (∫ x in (0 : ℝ)..(2 * Real.pi),
                Complex.exp (-Complex.I * (n : ℂ) * (x : ℂ)) * b x *
                  (fourierSeriesℝ c x : ℂ)) =
              ∑' k : ℤ, periodicFourierCoeff b (n - k) * c k) ∧
          (Summable (fun k : ℤ => periodicFourierCoeff (fun x => b x - 1) (n - k) * c k) ∧
            ((2 * Real.pi : ℝ) : ℂ)⁻¹ *
              (∫ x in (0 : ℝ)..(2 * Real.pi),
                Complex.exp (-Complex.I * (n : ℂ) * (x : ℂ)) * b x *
                  (fourierSeriesℝ c x : ℂ)) =
              c n + ∑' k : ℤ, periodicFourierCoeff (fun x => b x - 1) (n - k) * c k)) ∧
      (∀ (c₁ c₂ : ℤ → ℂ),
        Summable (fun k : ℤ => ‖c₁ k‖) →
        Summable (fun k : ℤ => ‖c₂ k‖) →
        ∀ x : ℝ, fourierSeriesℝ (fun k => c₁ k - c₂ k) x =
          fourierSeriesℝ c₁ x - fourierSeriesℝ c₂ x) := by
    refine ⟨?_, ?_, ?_, ?_, ?_⟩
    · intro g L hL hper hg hbound j
