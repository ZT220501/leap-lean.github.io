            mul_le_mul_of_nonneg_right (by linarith [hR_mono_seq m]) hB
  have h_tiny_interval : ∀ {a d : ℕ} (had : a + d ≤ T) (j : Fin P.N),
      (∀ i < d, sliceIsTiny S P bG j y_seq (a + i) = true) →
      ‖sliceSupportSeq S P.N j.val (y_seq (a + d))‖ ≤
        2 * Real.exp r_star * sliceRunningPosMax S P y_seq a +
          4 * Real.exp (-bG / 3) * sliceRunningPosMax S P y_seq (a + d) := by
    intro a d had j h_tiny
    have ha_le : a ≤ T := le_trans (Nat.le_add_right a d) had
    have h_diff_le :
        ‖sliceSupportSeq S P.N j.val (y_seq (a + d)) -
            sliceSupportSeq S P.N j.val (y_seq a)‖ ≤
          4 * Real.exp (-bG / 3) * sliceRunningPosMax S P y_seq (a + d) := by
