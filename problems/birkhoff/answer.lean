      rw [this, Real.rpow_natCast]
    rw [hD_rpow]
    dsimp [ε_anc]
    exact div_mul_cancel₀ 2 (pow_ne_zero 3 hu₀_pos.ne')
  have hAnchor_base : ∀ D : ℝ, D₁ ≤ D → ∃ N_D : ℕ, ∀ n ≥ N_D,
      (R.m_seq n)⁻¹ < S.r_star →
      S.H - S.h_X (((R.m_seq n)⁻¹ : ℝ) : ℂ) < D * R.d_seq n →
      ∀ ξ x : ℝ,
        ‖rescaledLift ξ (R.d_seq n) (R.m_seq n) ((x : ℂ) - (D : ℂ) * Complex.I) -
          ((x : ℂ) - (D : ℂ) * Complex.I)‖ ≤ C₁ * D ^ (-(1 / 2 : ℝ)) := by
    intro D hD
    have hD_pos : 0 < D := lt_of_lt_of_le hD₁_pos hD
    obtain ⟨N_D, hN_D⟩ := exists_nat_gt (max (D_base / d₀_anc) (D / δ_star_anc))
    refine ⟨N_D, ?_⟩
    intro n hn ht_lt hwidth ξ x
    let d_n : ℝ := R.d_seq n
    let m_n : ℝ := R.m_seq n
    have hd_n_pos : 0 < d_n := hd_pos n
    have hm_n_pos : 0 < m_n := hm_pos n
    have hn_cast : max (D_base / d₀_anc) (D / δ_star_anc) < (n : ℝ) + 1 := by
      have : (N_D : ℝ) ≤ (n : ℝ) := Nat.cast_le.mpr hn
      linarith
    let d : ℝ := D_base * d_n
    let r : ℝ := 2 / m_n
    let x₀ : ℝ := ξ + d_n * x
    have hd_arg_pos : 0 < d := by dsimp [d]; positivity
    have hd_arg_lt : d < d₀_anc := by
      have h1 : D_base / d₀_anc < (n : ℝ) + 1 := lt_of_le_of_lt (le_max_left _ _) hn_cast
      have h2 : D_base * (1 / ((n : ℝ) + 1)) < d₀_anc := by
        rw [mul_one_div, div_lt_iff₀ (by positivity)]
        have := (div_lt_iff₀ hd₀_anc_pos).mp h1
        linarith
      exact lt_of_le_of_lt (mul_le_mul_of_nonneg_left (hd_le_inv n) (by positivity)) h2
    have hD_dn_lt : D * d_n < δ_star_anc := by
      have h1 : D / δ_star_anc < (n : ℝ) + 1 := lt_of_le_of_lt (le_max_right _ _) hn_cast
      have h2 : D * (1 / ((n : ℝ) + 1)) < δ_star_anc := by
        rw [mul_one_div, div_lt_iff₀ (by positivity)]
        have := (div_lt_iff₀ hδs_anc_pos).mp h1
        linarith
