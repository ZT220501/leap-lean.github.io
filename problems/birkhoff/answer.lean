          (hasDerivAt_const p.1 (s_n n)).add ((hasDerivAt_id p.1).const_mul (seq.ℓ_seq n : ℂ))
        have hcomp := (hf_at.hasDerivAt.comp p.1 hg).const_mul (((seq.m_seq n)⁻¹ : ℂ))
        have hd_eq := hcomp.deriv
        simpa [F_tilde, s_pt] using hd_eq
      have ha1_eq : a₁_seq n p = (p.2 ^ 2 / (b_n n : ℂ)) * deriv (F_tilde n) p.1 := by
        rw [h_chain]
        dsimp [a₁_seq, h_pt, b_n]
        push_cast
        have hℓ := hℓ_ne n
        have hm := hm_ne n
        field_simp [hℓ, hm]
      rw [ha1_eq, norm_mul, norm_div, norm_pow, Complex.norm_real,
        Real.norm_of_nonneg (hb_pos n).le]
      have hp2_sq : ‖p.2‖ ^ 2 ≤ (‖H₀‖ + 1) ^ 2 + 1 := by
        have hp2 := h_p2_bound p hp
        have : ‖p.2‖ ^ 2 ≤ (‖H₀‖ + 1) ^ 2 := pow_le_pow_left₀ (norm_nonneg _) hp2 2
        linarith
      have hbn_gt : B_num / ε < b_n n := by linarith [hN_b1 n hn_b1]
      have hbn_pos : 0 < b_n n := hb_pos n
      have h_quot_lt : B_num / b_n n < ε := by
        rw [div_lt_iff₀ hbn_pos]
        have := (div_lt_iff₀ hε).mp hbn_gt
        linarith
      calc (‖p.2‖ ^ 2 / b_n n) * ‖deriv (F_tilde n) p.1‖
          = (‖p.2‖ ^ 2 * ‖deriv (F_tilde n) p.1‖) / b_n n := div_mul_eq_mul_div _ _ _
        _ ≤ B_num / b_n n := by
            refine div_le_div_of_nonneg_right ?_ hbn_pos.le
            dsimp [B_num]
            exact mul_le_mul hp2_sq h_deriv_le (norm_nonneg _) (by positivity)
        _ < ε := h_quot_lt

  obtain ⟨N₀, h3_holo, h3_Q, h3_a0, h3_a1⟩ := h_step3
  have hQ_slice_cont : ∀ n ≥ N₀, ∀ p ∈ U₁, ContinuousOn (Q_seq n p) (Set.Icc (0 : ℝ) 1) :=
    fun n hn p hp => (h3_holo n hn).2.2.1 p hp
  
  
  
  have hU₁_open : IsOpen U₁ := by
    change IsOpen ({ p : ℂ × ℂ | ‖p.1 - S₀‖ < 1 } ∩ { p : ℂ × ℂ | ‖p.2 - H₀‖ < 1 })
    exact (isOpen_lt (by fun_prop) continuous_const).inter
      (isOpen_lt (by fun_prop) continuous_const)
  have hU_δ_open : ∀ δ : ℝ, IsOpen { p : ℂ × ℂ | ‖p.1 - S₀‖ < δ ∧ ‖p.2 - H₀‖ < δ } := by
    intro δ
    change IsOpen ({ p : ℂ × ℂ | ‖p.1 - S₀‖ < δ } ∩ { p : ℂ × ℂ | ‖p.2 - H₀‖ < δ })
    exact (isOpen_lt (by fun_prop) continuous_const).inter
      (isOpen_lt (by fun_prop) continuous_const)

  
  have h_regime_A : kind = .firstField → Λ_fn p₀ ≠ 0 → Complex.sin (Λ_fn p₀ / 2) ≠ 0 →
      ∃ (δ : ℝ) (N₁ : ℕ), 0 < δ ∧ δ ≤ 1 ∧ N₀ ≤ N₁ ∧
        let U_δ : Set (ℂ × ℂ) := { p : ℂ × ℂ | ‖p.1 - S₀‖ < δ ∧ ‖p.2 - H₀‖ < δ }
        (∀ p ∈ U_δ, Λ_fn p ≠ 0) ∧
        (∀ n ≥ N₁, (∀ p ∈ U_δ, k0Kernel (Q_seq n p) 1 ≠ 0) ∧
