          _ = 2 * S.c * Real.exp (H_star / 8 + (M ^ σ - H_star / 2)) := by rw [← Real.exp_add]
          _ = 2 * S.c * Real.exp (M ^ σ - (3 / 8 : ℝ) * H_star) := by
