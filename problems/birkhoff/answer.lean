    calc
      ‖sliceSupportSeq S P.N j.val (y_seq (a + d))‖
          ≤ ‖sliceSupportSeq S P.N j.val (y_seq a)‖ +
              ‖sliceSupportSeq S P.N j.val (y_seq (a + d)) -
                sliceSupportSeq S P.N j.val (y_seq a)‖ := by
            conv_lhs => rw [h_eq]
            exact norm_add_le _ _
      _ ≤ 2 * Real.exp r_star * sliceRunningPosMax S P y_seq a +
            4 * Real.exp (-bG / 3) * sliceRunningPosMax S P y_seq (a + d) :=
