      have hprod := mul_le_mul hsq1 hsq2 (pow_nonneg (norm_nonneg w) 2) (by positivity)
      have hrhs_eq : (2 * ((ε / r) * d ^ α₁)) ^ 2 * R₀ ^ 2 =
