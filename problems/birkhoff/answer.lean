            ssbpcClearedPoly M R P E₀ E₁ A p q =
              MvPolynomial.eval (pointJetEnv M g₀ g₁ A q) P *
                ((ssbpcPairDenProd E₀ E₁ p q) ^ (2 * M + 1)) ^ R := by
      intro M R P hR p hp
      obtain ⟨r₀₀, hr₀₀_pos, hr₀₀_le, hr₀₀_sub, hr₀₀_eq⟩ := (h_agrees 0).1.2 p hp
      obtain ⟨r₀₁, hr₀₁_pos, hr₀₁_le, _, hr₀₁_eq⟩ := (h_agrees 1).1.2 p hp
      obtain ⟨r₁₀, hr₁₀_pos, hr₁₀_le, _, hr₁₀_eq⟩ := (h_agrees 0).2.2 p hp
      obtain ⟨r₁₁, hr₁₁_pos, hr₁₁_le, _, hr₁₁_eq⟩ := (h_agrees 1).2.2 p hp
      let r_ag := min (min r₀₀ r₀₁) (min r₁₀ r₁₁)
      have hr_ag_pos : 0 < r_ag :=
        lt_min (lt_min hr₀₀_pos hr₀₁_pos) (lt_min hr₁₀_pos hr₁₁_pos)
      have hr_ag_le : r_ag ≤ ssbpcPairChartRad E₀ E₁ p :=
        min_le_min (min_le_min hr₀₀_le hr₀₁_le) (min_le_min hr₁₀_le hr₁₁_le)
      have hr_ag_sub : Metric.ball p r_ag ⊆ B_base :=
