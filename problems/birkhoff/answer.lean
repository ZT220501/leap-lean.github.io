        (fun k Y => deriv (fun Y' => P.S_seq (φ₁ (ψ k)) (T_star, Y')) Y) (deriv S_star)
        Filter.atTop C₂ := by
      refine tendstoLocallyUniformlyOn_of_forall_exists_nhds fun Y hY => ?_
      obtain ⟨m, hm_nhds⟩ := hKm_nhds Y hY
      have h_deriv_Um := (h_Um_holo_deriv m).2
      have h_unif_Km : TendstoUniformlyOn
          (fun k Y => deriv (fun Y' => P.S_seq (φ₁ (ψ k)) (T_star, Y')) Y) (deriv S_star)
          Filter.atTop (K_m m) :=
        (tendstoLocallyUniformlyOn_iff_forall_isCompact (hUm_open m)).mp h_deriv_Um
          (K_m m) (hKm_sub_Um m) (hKm_comp m)
      exact ⟨K_m m, hm_nhds, h_unif_Km⟩
    have hS_disp_C₂ : ∀ Y : ℂ, D₀ < -Y.im → |Y.re| < (A₀ + 2) * (-Y.im) →
        ‖S_star Y - Y‖ ≤ (P.C_pass * T₀ ^ 2 + 1) * (-Y.im) ^ (1 - 2 * α) := by
      intro Y hY_im hY_re
      have hY_C₂ : Y ∈ C₂ := ⟨hY_im, hY_re⟩
      obtain ⟨m, hm⟩ := exists_nat_gt (-Y.im - D₀)
      have hY_Um : Y ∈ U_m m := ⟨hY_im, by linarith, hY_re⟩
      have h_tend_Y : Filter.Tendsto
          (fun k => ‖P.S_seq (φ₁ (ψ k)) (T_star, Y) - Y‖) Filter.atTop
