    have hpow : (-1 : ℂ) ^ β * (-1 : ℂ) ^ β = 1 := by rw [← mul_pow]; norm_num
    rw [hpow, one_mul]
  have hIterYT_congr : ∀ {U : Set (ℂ × ℂ)}, IsOpen U → ∀ {f₁ f₂ : ℂ × ℂ → ℂ},
      (∀ r ∈ U, f₁ r = f₂ r) → ∀ (α β : ℕ) {q : ℂ × ℂ}, q ∈ U →
        iterDerivYT α β f₁ q = iterDerivYT α β f₂ q := by
    intro U hU f₁ f₂ hfg α β q hq
    have hY : ∀ (m : ℕ) {r : ℂ × ℂ}, r ∈ U → iterDerivY m f₁ r = iterDerivY m f₂ r := by
      intro m
      induction m with
      | zero => intro r hr; exact hfg r hr
      | succ m ih =>
        intro r hr
        simp only [iterDerivY]
        apply Filter.EventuallyEq.deriv_eq
