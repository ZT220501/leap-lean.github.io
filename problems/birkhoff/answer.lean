          dsimp [circleMap]
          fun_prop
        have h_cont_box : ContinuousOn (fun q : ℝ × ℝ => q.1 * g (circleMap z₀ q.1 q.2))
            (Set.Icc (0 : ℝ) R ×ˢ Set.Icc (-Real.pi) Real.pi) :=
          continuousOn_fst.mul (hg_cont.comp h_cm_cont.continuousOn h_cm_maps)
        exact (h_cont_box.integrableOn_compact h_compact).mono_set
          (Set.prod_mono Set.Ioo_subset_Icc_self Set.Ioo_subset_Icc_self)
      have hprod_int' : MeasureTheory.IntegrableOn
          (fun q : ℝ × ℝ => q.1 * g (circleMap z₀ q.1 q.2))
          (Set.Ioo (0 : ℝ) R ×ˢ Set.Ioo (-Real.pi) Real.pi)
          (MeasureTheory.volume.prod MeasureTheory.volume) := hprod_int
      rw [show (MeasureTheory.volume : MeasureTheory.Measure (ℝ × ℝ)) =
          MeasureTheory.volume.prod MeasureTheory.volume from rfl]
      rw [MeasureTheory.setIntegral_prod _ hprod_int']
      have hinner_le : ∀ r ∈ Set.Ioo (0 : ℝ) R,
          (∫ θ in Set.Ioo (-Real.pi) Real.pi, r * g (circleMap z₀ r θ)) ≤
            r * (2 * Real.pi * g z₀) := by
        intro r ⟨hr0, hrR⟩
        rw [MeasureTheory.integral_const_mul]
        have h_ioo_ioc : (∫ θ in Set.Ioo (-Real.pi) Real.pi, g (circleMap z₀ r θ)) =
            (∫ θ in (-Real.pi)..Real.pi, g (circleMap z₀ r θ)) := by
          rw [intervalIntegral.integral_of_le (by linarith [Real.pi_pos]),
            MeasureTheory.integral_Ioc_eq_integral_Ioo]
        have hper : Function.Periodic (fun θ : ℝ => g (circleMap z₀ r θ)) (2 * Real.pi) :=
          fun θ => by simp [periodic_circleMap z₀ r θ]
        have hper_eq : (∫ θ in (-Real.pi)..Real.pi, g (circleMap z₀ r θ)) =
            (∫ θ in (0 : ℝ)..(2 * Real.pi), g (circleMap z₀ r θ)) := by
          have h1 := hper.intervalIntegral_add_eq (-Real.pi) 0
          ring_nf at h1 ⊢
          exact h1
        have hcb_r : Metric.closedBall z₀ r ⊆ horizStrip S.H :=
          (Metric.closedBall_subset_closedBall hrR.le).trans hcb
        have hcavg := h_circle_supermean K m z₀ r hr0 hcb_r
        rw [Real.circleAverage_def, smul_eq_mul] at hcavg
        have hint_bound : (∫ θ in (0 : ℝ)..(2 * Real.pi), g (circleMap z₀ r θ)) ≤
            2 * Real.pi * g z₀ := by
          have h2pi : (0 : ℝ) < 2 * Real.pi := by positivity
          have := mul_le_mul_of_nonneg_left hcavg h2pi.le
