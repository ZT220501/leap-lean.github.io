      have hU₀_sub : rectB (α₁_seq 0) (α₂_seq 0) β₁₀ β₂₀ ⊆
          Metric.ball w₀ η ×ˢ Metric.ball t_c η := by
        rw [← hw₀_re_im]
        refine rectB_sub_bidisk x₀ y₀ (α₁_seq 0) (α₂_seq 0) β₁₀ β₂₀ ?_ ?_
          (le_max_right _ _) (min_le_right _ _)
        · dsimp [α₁_seq]; simp
        · dsimp [α₂_seq]; simp
      exact ⟨σ₀, hσ₀_holo.mono hU₀_sub, hσ₀_pt, fun q hq => hσ₀_sol q (hU₀_sub hq)⟩
    | succ k ih =>
      obtain ⟨G_k, hGk_holo, hGk_pt, hGk_sol⟩ := ih
      have hks : 0 ≤ (k : ℝ) * s := mul_nonneg (Nat.cast_nonneg k) (le_of_lt hs_pos)
      have hrs : r = 2 * s := by dsimp [r, s]; ring
      
      have hRight : ∃ G_R : ℂ × ℂ → ℂ,
          DifferentiableOn ℂ G_R (rectB (α₁_seq k) (α₂_seq (k + 1)) β₁₀ β₂₀) ∧
          G_R (w₀, t_c) = z₀ ∧
          ∀ q ∈ rectB (α₁_seq k) (α₂_seq (k + 1)) β₁₀ β₂₀, P_fn q (G_R q) = 0 := by
        by_cases h_cap : a₂' ≤ x₀ + r + (k : ℝ) * s
        · have h_eq_α : α₂_seq (k + 1) = α₂_seq k := by
            dsimp [α₂_seq]
            push_cast
            rw [min_eq_left (by linarith), min_eq_left h_cap]
          rw [h_eq_α]
          exact ⟨G_k, hGk_holo, hGk_pt, hGk_sol⟩
        · replace h_cap : x₀ + r + (k : ℝ) * s < a₂' := lt_of_not_ge h_cap
          have hα₂k_eq : α₂_seq k = x₀ + r + (k : ℝ) * s := min_eq_right (le_of_lt h_cap)
          let x_s : ℝ := x₀ + ((k : ℝ) + 1) * s
          let w_R : ℂ := (x_s : ℂ) + (y₀ : ℂ) * Complex.I
          have hw_R_re : w_R.re = x_s := by simp [w_R]
          have hw_R_im : w_R.im = y₀ := by simp [w_R]
          have hx_s_gt : x₀ < x_s := by dsimp [x_s]; linarith
          have hx_s_lt : x_s < α₂_seq k := by rw [hα₂k_eq]; dsimp [x_s]; linarith
          have hw_R_Rw' : w_R ∈ R_w' :=
            ⟨by rw [hw_R_re]; linarith [hw₀_re₁], by rw [hw_R_re]; linarith [min_le_left a₂' (x₀ + r + (k : ℝ) * s)],
             by rw [hw_R_im]; exact hw₀_im₁, by rw [hw_R_im]; exact hw₀_im₂⟩
          have hw_R_Uk : (w_R, t_c) ∈ rectB (α₁_seq k) (α₂_seq k) β₁₀ β₂₀ :=
            ⟨⟨by rw [hw_R_re]; linarith [(hx₀_α k).1], by rw [hw_R_re]; exact hx_s_lt,
              by rw [hw_R_im]; exact hy₀_β₀.1, by rw [hw_R_im]; exact hy₀_β₀.2⟩,
             Metric.mem_ball_self hη_pos⟩
          obtain ⟨σ_R, hσ_R_holo, hσ_R_pt, hσ_R_sol⟩ :=
            hLift w_R hw_R_Rw' (G_k (w_R, t_c)) (hGk_sol (w_R, t_c) hw_R_Uk)
          let α₁' : ℝ := max a₁' (x_s - r)
          have hα₂_succ : min a₂' (x_s + r) = α₂_seq (k + 1) := by
            dsimp [α₂_seq, x_s]; push_cast; ring_nf
          let B_R := rectB α₁' (α₂_seq (k + 1)) β₁₀ β₂₀
          have hB_R_sub : B_R ⊆ Metric.ball w_R η ×ˢ Metric.ball t_c η := by
            refine rectB_sub_bidisk x_s y₀ α₁' (α₂_seq (k + 1)) β₁₀ β₂₀
              (le_max_right _ _) ?_ (le_max_right _ _) (min_le_right _ _)
            rw [← hα₂_succ]; exact min_le_right _ _
          have hw_R_BR : (w_R, t_c) ∈ B_R := by
            refine ⟨⟨?_, ?_, by rw [hw_R_im]; exact hy₀_β₀.1, by rw [hw_R_im]; exact hy₀_β₀.2⟩,
              Metric.mem_ball_self hη_pos⟩
            · rw [hw_R_re]; exact max_lt (by linarith [hw₀_re₁]) (by linarith)
            · rw [hw_R_re, ← hα₂_succ]; exact lt_min (by linarith) (by linarith)
          let V_ov := rectB (α₁_seq k) (α₂_seq k) β₁₀ β₂₀ ∩ B_R
          have hV_ov_eq : V_ov =
              rectB (max (α₁_seq k) α₁') (min (α₂_seq k) (α₂_seq (k + 1)))
                (max β₁₀ β₁₀) (min β₂₀ β₂₀) :=
            inter_rectB _ _ _ _ _ _ _ _
          have hV_ov_open : IsOpen V_ov := hV_ov_eq ▸ isOpen_rectB _ _ _ _
          have hV_ov_pre : IsPreconnected V_ov := hV_ov_eq ▸ isPreconn_rectB _ _ _ _
          have hV_ov_U : V_ov ⊆ U :=
            Set.Subset.trans Set.inter_subset_left
              (rectB_sub_U _ _ _ _ (le_max_left _ _) (min_le_left _ _)
                (le_max_left _ _) (min_le_left _ _))
          have h_agree_R : ∀ q ∈ V_ov, G_k q = σ_R q :=
            hUniq V_ov G_k σ_R (w_R, t_c) hV_ov_open hV_ov_pre hV_ov_U ⟨hw_R_Uk, hw_R_BR⟩
              (hGk_holo.mono Set.inter_subset_left)
              ((hσ_R_holo.mono hB_R_sub).mono Set.inter_subset_right)
              (fun q hq => hGk_sol q hq.1) (fun q hq => hσ_R_sol q (hB_R_sub hq.2))
              hσ_R_pt.symm
          obtain ⟨G_R, hGR_holo, hGR_1, _, hGR_sol⟩ :=
            paste_two (rectB (α₁_seq k) (α₂_seq k) β₁₀ β₂₀) B_R G_k σ_R
              (isOpen_rectB _ _ _ _) (isOpen_rectB _ _ _ _)
              hGk_holo (hσ_R_holo.mono hB_R_sub) hGk_sol
              (fun q hq => hσ_R_sol q (hB_R_sub hq)) h_agree_R
          have h_ord₁ : α₁_seq k ≤ α₁' := by
            dsimp [α₁_seq, α₁', x_s]
            exact max_le_max le_rfl (by linarith)
          have h_ord₂ : α₁' < α₂_seq k := by
            rw [hα₂k_eq]; dsimp [α₁', x_s]
            exact max_lt (by linarith [hw₀_re₁]) (by linarith)
          have h_ord₃ : α₂_seq k ≤ α₂_seq (k + 1) := by
            dsimp [α₂_seq]; push_cast
            exact min_le_min le_rfl (by linarith)
          have h_un : rectB (α₁_seq k) (α₂_seq k) β₁₀ β₂₀ ∪ B_R =
              rectB (α₁_seq k) (α₂_seq (k + 1)) β₁₀ β₂₀ :=
            rectB_union_x _ _ _ _ _ _ h_ord₁ h_ord₂ h_ord₃
          rw [h_un] at hGR_holo hGR_sol
          have hw₀_Uk : (w₀, t_c) ∈ rectB (α₁_seq k) (α₂_seq k) β₁₀ β₂₀ :=
            ⟨⟨(hx₀_α k).1, (hx₀_α k).2, hy₀_β₀.1, hy₀_β₀.2⟩, Metric.mem_ball_self hη_pos⟩
          exact ⟨G_R, hGR_holo, (hGR_1 (w₀, t_c) hw₀_Uk).trans hGk_pt, hGR_sol⟩
      obtain ⟨G_R, hGR_holo, hGR_pt, hGR_sol⟩ := hRight
      
      by_cases h_capL : x₀ - r - (k : ℝ) * s ≤ a₁'
      · have h_eq_α : α₁_seq (k + 1) = α₁_seq k := by
          dsimp [α₁_seq]
          push_cast
          rw [max_eq_left (by linarith), max_eq_left h_capL]
        rw [h_eq_α]
        exact ⟨G_R, hGR_holo, hGR_pt, hGR_sol⟩
      · replace h_capL : a₁' < x₀ - r - (k : ℝ) * s := lt_of_not_ge h_capL
        have hα₁k_eq : α₁_seq k = x₀ - r - (k : ℝ) * s := max_eq_right (le_of_lt h_capL)
        let x_ss : ℝ := x₀ - ((k : ℝ) + 1) * s
        let w_L : ℂ := (x_ss : ℂ) + (y₀ : ℂ) * Complex.I
        have hw_L_re : w_L.re = x_ss := by simp [w_L]
        have hw_L_im : w_L.im = y₀ := by simp [w_L]
        have hx_ss_lt : x_ss < x₀ := by dsimp [x_ss]; linarith
        have hx_ss_gt : α₁_seq k < x_ss := by rw [hα₁k_eq]; dsimp [x_ss]; linarith
        have hw_L_Rw' : w_L ∈ R_w' :=
          ⟨by rw [hw_L_re]; linarith, by rw [hw_L_re]; linarith [hw₀_re₂],
           by rw [hw_L_im]; exact hw₀_im₁, by rw [hw_L_im]; exact hw₀_im₂⟩
        have hw_L_UR : (w_L, t_c) ∈ rectB (α₁_seq k) (α₂_seq (k + 1)) β₁₀ β₂₀ :=
          ⟨⟨by rw [hw_L_re]; exact hx_ss_gt, by rw [hw_L_re]; linarith [(hx₀_α (k + 1)).2],
            by rw [hw_L_im]; exact hy₀_β₀.1, by rw [hw_L_im]; exact hy₀_β₀.2⟩,
           Metric.mem_ball_self hη_pos⟩
        obtain ⟨σ_L, hσ_L_holo, hσ_L_pt, hσ_L_sol⟩ :=
          hLift w_L hw_L_Rw' (G_R (w_L, t_c)) (hGR_sol (w_L, t_c) hw_L_UR)
        let α₂'' : ℝ := min a₂' (x_ss + r)
        have hα₁_succ : max a₁' (x_ss - r) = α₁_seq (k + 1) := by
          dsimp [α₁_seq, x_ss]; push_cast; ring_nf
        let B_L := rectB (α₁_seq (k + 1)) α₂'' β₁₀ β₂₀
        have hB_L_sub : B_L ⊆ Metric.ball w_L η ×ˢ Metric.ball t_c η := by
          refine rectB_sub_bidisk x_ss y₀ (α₁_seq (k + 1)) α₂'' β₁₀ β₂₀
            ?_ (min_le_right _ _) (le_max_right _ _) (min_le_right _ _)
          rw [← hα₁_succ]; exact le_max_right _ _
        have hw_L_BL : (w_L, t_c) ∈ B_L := by
          refine ⟨⟨?_, ?_, by rw [hw_L_im]; exact hy₀_β₀.1, by rw [hw_L_im]; exact hy₀_β₀.2⟩,
            Metric.mem_ball_self hη_pos⟩
          · rw [hw_L_re, ← hα₁_succ]; exact max_lt (by linarith) (by linarith)
          · rw [hw_L_re]; exact lt_min (by linarith [hw₀_re₂]) (by linarith)
        let V_ovL := B_L ∩ rectB (α₁_seq k) (α₂_seq (k + 1)) β₁₀ β₂₀
        have hV_ovL_eq : V_ovL =
            rectB (max (α₁_seq (k + 1)) (α₁_seq k)) (min α₂'' (α₂_seq (k + 1)))
              (max β₁₀ β₁₀) (min β₂₀ β₂₀) :=
          inter_rectB _ _ _ _ _ _ _ _
        have hV_ovL_open : IsOpen V_ovL := hV_ovL_eq ▸ isOpen_rectB _ _ _ _
        have hV_ovL_pre : IsPreconnected V_ovL := hV_ovL_eq ▸ isPreconn_rectB _ _ _ _
        have hV_ovL_U : V_ovL ⊆ U :=
          Set.Subset.trans Set.inter_subset_right
            (rectB_sub_U _ _ _ _ (le_max_left _ _) (min_le_left _ _)
              (le_max_left _ _) (min_le_left _ _))
        have h_agree_L : ∀ q ∈ V_ovL, σ_L q = G_R q :=
          hUniq V_ovL σ_L G_R (w_L, t_c) hV_ovL_open hV_ovL_pre hV_ovL_U ⟨hw_L_BL, hw_L_UR⟩
            ((hσ_L_holo.mono hB_L_sub).mono Set.inter_subset_left)
            (hGR_holo.mono Set.inter_subset_right)
            (fun q hq => hσ_L_sol q (hB_L_sub hq.1)) (fun q hq => hGR_sol q hq.2)
            hσ_L_pt
        obtain ⟨G_next, hGn_holo, _, hGn_2, hGn_sol⟩ :=
          paste_two B_L (rectB (α₁_seq k) (α₂_seq (k + 1)) β₁₀ β₂₀) σ_L G_R
            (isOpen_rectB _ _ _ _) (isOpen_rectB _ _ _ _)
            (hσ_L_holo.mono hB_L_sub) hGR_holo
            (fun q hq => hσ_L_sol q (hB_L_sub hq)) hGR_sol h_agree_L
        have h_ord₁ : α₁_seq (k + 1) ≤ α₁_seq k := by
          dsimp [α₁_seq]; push_cast
          exact max_le_max le_rfl (by linarith)
        have h_ord₂ : α₁_seq k < α₂'' := by
          rw [hα₁k_eq]; dsimp [α₂'', x_ss]
          exact lt_min (by linarith [hw₀_re₂]) (by linarith)
        have h_ord₃ : α₂'' ≤ α₂_seq (k + 1) := by
          dsimp [α₂'', α₂_seq, x_ss]; push_cast
          exact min_le_min le_rfl (by linarith)
        have h_unL : B_L ∪ rectB (α₁_seq k) (α₂_seq (k + 1)) β₁₀ β₂₀ =
            rectB (α₁_seq (k + 1)) (α₂_seq (k + 1)) β₁₀ β₂₀ :=
          rectB_union_x _ _ _ _ _ _ h_ord₁ h_ord₂ h_ord₃
        rw [h_unL] at hGn_holo hGn_sol
        have hw₀_UR : (w₀, t_c) ∈ rectB (α₁_seq k) (α₂_seq (k + 1)) β₁₀ β₂₀ :=
          ⟨⟨(hx₀_α k).1, (hx₀_α (k + 1)).2, hy₀_β₀.1, hy₀_β₀.2⟩, Metric.mem_ball_self hη_pos⟩
        exact ⟨G_next, hGn_holo, (hGn_2 (w₀, t_c) hw₀_UR).trans hGR_pt, hGn_sol⟩
  obtain ⟨N_x, hN_x⟩ := exists_nat_gt (max (a₂' - x₀) (x₀ - a₁') / s)
  have hN_x_mul : max (a₂' - x₀) (x₀ - a₁') < (N_x : ℝ) * s :=
    (div_lt_iff₀ hs_pos).mp hN_x
  have hα₁_Nx : α₁_seq N_x = a₁' :=
    max_eq_left (by linarith [le_max_right (a₂' - x₀) (x₀ - a₁')])
  have hα₂_Nx : α₂_seq N_x = a₂' :=
    min_eq_left (by linarith [le_max_left (a₂' - x₀) (x₀ - a₁')])
  obtain ⟨H₀, hH₀_holo, hH₀_pt, hH₀_sol⟩ := hHoriz N_x
  rw [hα₁_Nx, hα₂_Nx] at hH₀_holo hH₀_sol
  
  let β₁_seq : ℕ → ℝ := fun m => max b₁' (y₀ - r - (m : ℝ) * s)
  let β₂_seq : ℕ → ℝ := fun m => min b₂' (y₀ + r + (m : ℝ) * s)
  have hy₀_β : ∀ m : ℕ, β₁_seq m < y₀ ∧ y₀ < β₂_seq m := by
    intro m
    have hms : 0 ≤ (m : ℝ) * s := mul_nonneg (Nat.cast_nonneg m) (le_of_lt hs_pos)
    dsimp [β₁_seq, β₂_seq, y₀]
    exact ⟨max_lt hw₀_im₁ (by linarith), lt_min hw₀_im₂ (by linarith)⟩
  have hVert : ∀ m : ℕ,
      ∃ H_m : ℂ × ℂ → ℂ,
        DifferentiableOn ℂ H_m (rectB a₁' a₂' (β₁_seq m) (β₂_seq m)) ∧
        H_m (w₀, t_c) = z₀ ∧
        ∀ q ∈ rectB a₁' a₂' (β₁_seq m) (β₂_seq m), P_fn q (H_m q) = 0 := by
    intro m
    induction m with
    | zero =>
      have hb₁_0 : β₁_seq 0 = β₁₀ := by dsimp [β₁_seq, β₁₀]; simp
      have hb₂_0 : β₂_seq 0 = β₂₀ := by dsimp [β₂_seq, β₂₀]; simp
      rw [hb₁_0, hb₂_0]
      exact ⟨H₀, hH₀_holo, hH₀_pt, hH₀_sol⟩
    | succ m ih =>
      obtain ⟨H_m, hHm_holo, hHm_pt, hHm_sol⟩ := ih
      have hms : 0 ≤ (m : ℝ) * s := mul_nonneg (Nat.cast_nonneg m) (le_of_lt hs_pos)
      have hrs : r = 2 * s := by dsimp [r, s]; ring
      
      have hTop : ∃ H_T : ℂ × ℂ → ℂ,
          DifferentiableOn ℂ H_T (rectB a₁' a₂' (β₁_seq m) (β₂_seq (m + 1))) ∧
          H_T (w₀, t_c) = z₀ ∧
          ∀ q ∈ rectB a₁' a₂' (β₁_seq m) (β₂_seq (m + 1)), P_fn q (H_T q) = 0 := by
        by_cases h_capT : b₂' ≤ y₀ + r + (m : ℝ) * s
        · have h_eq_β : β₂_seq (m + 1) = β₂_seq m := by
            dsimp [β₂_seq]
            push_cast
            rw [min_eq_left (by linarith), min_eq_left h_capT]
          rw [h_eq_β]
          exact ⟨H_m, hHm_holo, hHm_pt, hHm_sol⟩
        · replace h_capT : y₀ + r + (m : ℝ) * s < b₂' := lt_of_not_ge h_capT
          have hβ₂m_eq : β₂_seq m = y₀ + r + (m : ℝ) * s := min_eq_right (le_of_lt h_capT)
          let y_s : ℝ := y₀ + ((m : ℝ) + 1) * s
          have hy_s_gt : y₀ < y_s := by dsimp [y_s]; linarith
          have hy_s_lt : y_s < β₂_seq m := by rw [hβ₂m_eq]; dsimp [y_s]; linarith
          let β₁' : ℝ := max b₁' (y_s - r)
          have hβ₂_succ : min b₂' (y_s + r) = β₂_seq (m + 1) := by
            dsimp [β₂_seq, y_s]; push_cast; ring_nf
          let Q_fam : ℝ → Set (ℂ × ℂ) :=
            fun x => rectB (max a₁' (x - r)) (min a₂' (x + r)) β₁' (β₂_seq (m + 1))
          have h_pt_Vm : ∀ x ∈ Set.Ioo a₁' a₂',
              (((x : ℂ) + (y_s : ℂ) * Complex.I, t_c) : ℂ × ℂ) ∈
                rectB a₁' a₂' (β₁_seq m) (β₂_seq m) := by
            intro x hx
            exact ⟨⟨by simp [hx.1], by simp [hx.2],
              by simp; linarith [(hy₀_β m).1], by simp; exact hy_s_lt⟩,
              Metric.mem_ball_self hη_pos⟩
          have h_pt_Rw' : ∀ x ∈ Set.Ioo a₁' a₂',
              ((x : ℂ) + (y_s : ℂ) * Complex.I) ∈ R_w' := by
            intro x hx
            exact ⟨by simp [hx.1], by simp [hx.2],
              by simp; linarith [hw₀_im₁], by simp; linarith⟩
          have h_lift_x : ∀ x : ℝ,
              ∃ σ : ℂ × ℂ → ℂ,
                x ∈ Set.Ioo a₁' a₂' →
                  DifferentiableOn ℂ σ (Q_fam x) ∧
                  σ ((x : ℂ) + (y_s : ℂ) * Complex.I, t_c) =
                    H_m ((x : ℂ) + (y_s : ℂ) * Complex.I, t_c) ∧
                  ∀ q ∈ Q_fam x, P_fn q (σ q) = 0 := by
            intro x
            by_cases hx : x ∈ Set.Ioo a₁' a₂'
            · obtain ⟨σ, hσ_holo, hσ_pt, hσ_sol⟩ :=
                hLift ((x : ℂ) + (y_s : ℂ) * Complex.I) (h_pt_Rw' x hx)
                  (H_m ((x : ℂ) + (y_s : ℂ) * Complex.I, t_c))
                  (hHm_sol _ (h_pt_Vm x hx))
              have hQ_sub : Q_fam x ⊆
                  Metric.ball ((x : ℂ) + (y_s : ℂ) * Complex.I) η ×ˢ Metric.ball t_c η := by
                refine rectB_sub_bidisk x y_s _ _ _ _
                  (le_max_right _ _) (min_le_right _ _) (le_max_right _ _) ?_
                rw [← hβ₂_succ]; exact min_le_right _ _
              exact ⟨σ, fun _ => ⟨hσ_holo.mono hQ_sub, hσ_pt, fun q hq => hσ_sol q (hQ_sub hq)⟩⟩
            · exact ⟨fun _ => 0, fun h => False.elim (hx h)⟩
          choose σ_fam hσ_fam using h_lift_x
          have hy_s_in_T : β₁' < y_s ∧ y_s < β₂_seq (m + 1) := by
            refine ⟨max_lt (by linarith [hw₀_im₁]) (by linarith), ?_⟩
            rw [← hβ₂_succ]; exact lt_min (by linarith) (by linarith)
          have h_σ_eq_Hm : ∀ x ∈ Set.Ioo a₁' a₂',
              ∀ q ∈ Q_fam x ∩ rectB a₁' a₂' (β₁_seq m) (β₂_seq m), σ_fam x q = H_m q := by
            intro x hx
            have hp_Qx : (((x : ℂ) + (y_s : ℂ) * Complex.I, t_c) : ℂ × ℂ) ∈ Q_fam x :=
              ⟨⟨by rw [(h_re_im x y_s).1]; exact max_lt hx.1 (by linarith),
                by rw [(h_re_im x y_s).1]; exact lt_min hx.2 (by linarith),
                by rw [(h_re_im x y_s).2]; exact hy_s_in_T.1,
                by rw [(h_re_im x y_s).2]; exact hy_s_in_T.2⟩,
               Metric.mem_ball_self hη_pos⟩
            exact hUniq (Q_fam x ∩ rectB a₁' a₂' (β₁_seq m) (β₂_seq m))
              (σ_fam x) H_m ((x : ℂ) + (y_s : ℂ) * Complex.I, t_c)
              (isOpen_inter_rectB _ _ _ _ _ _ _ _) (isPreconn_inter_rectB _ _ _ _ _ _ _ _)
              (Set.Subset.trans Set.inter_subset_right
                (rectB_sub_U _ _ _ _ le_rfl le_rfl (le_max_left _ _) (min_le_left _ _)))
              ⟨hp_Qx, h_pt_Vm x hx⟩
              ((hσ_fam x hx).1.mono Set.inter_subset_left)
              (hHm_holo.mono Set.inter_subset_right)
              (fun q hq => (hσ_fam x hx).2.2 q hq.1)
              (fun q hq => hHm_sol q hq.2)
              (hσ_fam x hx).2.1
          have h_compat_T : ∀ x₁ ∈ Set.Ioo a₁' a₂', ∀ x₂ ∈ Set.Ioo a₁' a₂',
              ∀ q ∈ Q_fam x₁ ∩ Q_fam x₂, σ_fam x₁ q = σ_fam x₂ q := by
            intro x₁ hx₁ x₂ hx₂ q hq
            let x_q : ℝ := q.1.re
            let pt_q : ℂ × ℂ := ((x_q : ℂ) + (y_s : ℂ) * Complex.I, t_c)
            have hpt_re : pt_q.1.re = x_q := by simp [pt_q]
            have hpt_im : pt_q.1.im = y_s := by simp [pt_q]
            have hp_Q₁ : pt_q ∈ Q_fam x₁ :=
              ⟨⟨by rw [hpt_re]; exact hq.1.1.1,
                by rw [hpt_re]; exact hq.1.1.2.1,
                by rw [hpt_im]; exact hy_s_in_T.1,
                by rw [hpt_im]; exact hy_s_in_T.2⟩,
               Metric.mem_ball_self hη_pos⟩
            have hp_Q₂ : pt_q ∈ Q_fam x₂ :=
              ⟨⟨by rw [hpt_re]; exact hq.2.1.1,
                by rw [hpt_re]; exact hq.2.1.2.1,
                by rw [hpt_im]; exact hy_s_in_T.1,
                by rw [hpt_im]; exact hy_s_in_T.2⟩,
               Metric.mem_ball_self hη_pos⟩
            have hx_q_Ioo : x_q ∈ Set.Ioo a₁' a₂' :=
              ⟨lt_of_le_of_lt (le_max_left _ _) hq.1.1.1,
               lt_of_lt_of_le hq.1.1.2.1 (min_le_left _ _)⟩
            have hp_Vm : pt_q ∈ rectB a₁' a₂' (β₁_seq m) (β₂_seq m) := h_pt_Vm x_q hx_q_Ioo
            have hp_eq : σ_fam x₁ pt_q = σ_fam x₂ pt_q :=
              (h_σ_eq_Hm x₁ hx₁ pt_q ⟨hp_Q₁, hp_Vm⟩).trans
                (h_σ_eq_Hm x₂ hx₂ pt_q ⟨hp_Q₂, hp_Vm⟩).symm
            exact hUniq (Q_fam x₁ ∩ Q_fam x₂) (σ_fam x₁) (σ_fam x₂) pt_q
              (isOpen_inter_rectB _ _ _ _ _ _ _ _) (isPreconn_inter_rectB _ _ _ _ _ _ _ _)
              (Set.Subset.trans Set.inter_subset_left
                (rectB_sub_U _ _ _ _ (le_max_left _ _) (min_le_left _ _)
                  (le_max_left _ _) (min_le_left _ _)))
              ⟨hp_Q₁, hp_Q₂⟩
              ((hσ_fam x₁ hx₁).1.mono Set.inter_subset_left)
              ((hσ_fam x₂ hx₂).1.mono Set.inter_subset_right)
              (fun q' hq' => (hσ_fam x₁ hx₁).2.2 q' hq'.1)
              (fun q' hq' => (hσ_fam x₂ hx₂).2.2 q' hq'.2)
              hp_eq q hq
          obtain ⟨Sig_T, hSig_T_holo, hSig_T_eq, hSig_T_sol⟩ :=
            glue_family (Set.Ioo a₁' a₂') Q_fam σ_fam
              (fun x _ => isOpen_rectB _ _ _ _)
              (fun x hx => (hσ_fam x hx).1)
              (fun x hx => (hσ_fam x hx).2.2)
              h_compat_T
          have h_iUnion_T : (⋃ x ∈ Set.Ioo a₁' a₂', Q_fam x) =
              rectB a₁' a₂' β₁' (β₂_seq (m + 1)) := by
            ext ⟨w, t⟩
            constructor
            · intro hq
              obtain ⟨x, _, ⟨⟨hw₁, hw₂, hw₃, hw₄⟩, ht⟩⟩ := Set.mem_iUnion₂.mp hq
              exact ⟨⟨lt_of_le_of_lt (le_max_left _ _) hw₁,
                lt_of_lt_of_le hw₂ (min_le_left _ _), hw₃, hw₄⟩, ht⟩
            · rintro ⟨⟨hw₁, hw₂, hw₃, hw₄⟩, ht⟩
              exact Set.mem_iUnion₂.mpr ⟨w.re, ⟨hw₁, hw₂⟩,
                ⟨⟨max_lt hw₁ (by linarith), lt_min hw₂ (by linarith), hw₃, hw₄⟩, ht⟩⟩
          rw [h_iUnion_T] at hSig_T_holo hSig_T_sol
          have h_agree_T : ∀ q ∈ rectB a₁' a₂' (β₁_seq m) (β₂_seq m) ∩
              rectB a₁' a₂' β₁' (β₂_seq (m + 1)), H_m q = Sig_T q := by
            intro q ⟨hq_Vm, hq_ST⟩
            rw [← h_iUnion_T] at hq_ST
            obtain ⟨x, hx, hq_Qx⟩ := Set.mem_iUnion₂.mp hq_ST
            rw [hSig_T_eq x hx q hq_Qx]
            exact (h_σ_eq_Hm x hx q ⟨hq_Qx, hq_Vm⟩).symm
          obtain ⟨H_T, hHT_holo, hHT_1, _, hHT_sol⟩ :=
            paste_two (rectB a₁' a₂' (β₁_seq m) (β₂_seq m))
              (rectB a₁' a₂' β₁' (β₂_seq (m + 1))) H_m Sig_T
              (isOpen_rectB _ _ _ _) (isOpen_rectB _ _ _ _)
              hHm_holo hSig_T_holo hHm_sol hSig_T_sol h_agree_T
          have h_ord₁ : β₁_seq m ≤ β₁' := by
            dsimp [β₁_seq, β₁', y_s]; exact max_le_max le_rfl (by linarith)
          have h_ord₂ : β₁' < β₂_seq m := by
            rw [hβ₂m_eq]; dsimp [β₁', y_s]
            exact max_lt (by linarith [hw₀_im₁]) (by linarith)
          have h_ord₃ : β₂_seq m ≤ β₂_seq (m + 1) := by
            dsimp [β₂_seq]; push_cast; exact min_le_min le_rfl (by linarith)
          have h_unT : rectB a₁' a₂' (β₁_seq m) (β₂_seq m) ∪
              rectB a₁' a₂' β₁' (β₂_seq (m + 1)) =
              rectB a₁' a₂' (β₁_seq m) (β₂_seq (m + 1)) :=
            rectB_union_y _ _ _ _ _ _ h_ord₁ h_ord₂ h_ord₃
          rw [h_unT] at hHT_holo hHT_sol
          have hw₀_Vm : (w₀, t_c) ∈ rectB a₁' a₂' (β₁_seq m) (β₂_seq m) :=
            ⟨⟨hw₀_re₁, hw₀_re₂, (hy₀_β m).1, (hy₀_β m).2⟩, Metric.mem_ball_self hη_pos⟩
          exact ⟨H_T, hHT_holo, (hHT_1 (w₀, t_c) hw₀_Vm).trans hHm_pt, hHT_sol⟩
      obtain ⟨H_T, hHT_holo, hHT_pt, hHT_sol⟩ := hTop
      
      by_cases h_capB : y₀ - r - (m : ℝ) * s ≤ b₁'
      · have h_eq_β : β₁_seq (m + 1) = β₁_seq m := by
          dsimp [β₁_seq]
          push_cast
          rw [max_eq_left (by linarith), max_eq_left h_capB]
        rw [h_eq_β]
        exact ⟨H_T, hHT_holo, hHT_pt, hHT_sol⟩
      · replace h_capB : b₁' < y₀ - r - (m : ℝ) * s := lt_of_not_ge h_capB
        have hβ₁m_eq : β₁_seq m = y₀ - r - (m : ℝ) * s := max_eq_right (le_of_lt h_capB)
        let y_ss : ℝ := y₀ - ((m : ℝ) + 1) * s
        have hy_ss_lt : y_ss < y₀ := by dsimp [y_ss]; linarith
        have hy_ss_gt : β₁_seq m < y_ss := by rw [hβ₁m_eq]; dsimp [y_ss]; linarith
        let β₂'' : ℝ := min b₂' (y_ss + r)
        have hβ₁_succ : max b₁' (y_ss - r) = β₁_seq (m + 1) := by
          dsimp [β₁_seq, y_ss]; push_cast; ring_nf
        let Q_famB : ℝ → Set (ℂ × ℂ) :=
          fun x => rectB (max a₁' (x - r)) (min a₂' (x + r)) (β₁_seq (m + 1)) β₂''
        have h_pt_VT : ∀ x ∈ Set.Ioo a₁' a₂',
            (((x : ℂ) + (y_ss : ℂ) * Complex.I, t_c) : ℂ × ℂ) ∈
              rectB a₁' a₂' (β₁_seq m) (β₂_seq (m + 1)) := by
          intro x hx
          exact ⟨⟨by simp [hx.1], by simp [hx.2],
            by simp [hy_ss_gt], by simp; linarith [(hy₀_β (m + 1)).2]⟩,
            Metric.mem_ball_self hη_pos⟩
        have h_pt_Rw'B : ∀ x ∈ Set.Ioo a₁' a₂',
            ((x : ℂ) + (y_ss : ℂ) * Complex.I) ∈ R_w' := by
          intro x hx
          exact ⟨by simp [hx.1], by simp [hx.2],
            by simp; linarith, by simp; linarith [hw₀_im₂]⟩
        have h_lift_xB : ∀ x : ℝ,
            ∃ σ : ℂ × ℂ → ℂ,
              x ∈ Set.Ioo a₁' a₂' →
                DifferentiableOn ℂ σ (Q_famB x) ∧
                σ ((x : ℂ) + (y_ss : ℂ) * Complex.I, t_c) =
                  H_T ((x : ℂ) + (y_ss : ℂ) * Complex.I, t_c) ∧
                ∀ q ∈ Q_famB x, P_fn q (σ q) = 0 := by
          intro x
          by_cases hx : x ∈ Set.Ioo a₁' a₂'
          · obtain ⟨σ, hσ_holo, hσ_pt, hσ_sol⟩ :=
              hLift ((x : ℂ) + (y_ss : ℂ) * Complex.I) (h_pt_Rw'B x hx)
                (H_T ((x : ℂ) + (y_ss : ℂ) * Complex.I, t_c))
                (hHT_sol _ (h_pt_VT x hx))
            have hQ_sub : Q_famB x ⊆
                Metric.ball ((x : ℂ) + (y_ss : ℂ) * Complex.I) η ×ˢ Metric.ball t_c η := by
              refine rectB_sub_bidisk x y_ss _ _ _ _
                (le_max_right _ _) (min_le_right _ _) ?_ (min_le_right _ _)
              rw [← hβ₁_succ]; exact le_max_right _ _
            exact ⟨σ, fun _ => ⟨hσ_holo.mono hQ_sub, hσ_pt, fun q hq => hσ_sol q (hQ_sub hq)⟩⟩
          · exact ⟨fun _ => 0, fun h => False.elim (hx h)⟩
        choose σ_famB hσ_famB using h_lift_xB
        have hy_ss_in_B : β₁_seq (m + 1) < y_ss ∧ y_ss < β₂'' := by
          refine ⟨?_, lt_min (by linarith [hw₀_im₂]) (by linarith)⟩
          rw [← hβ₁_succ]; exact max_lt (by linarith) (by linarith)
        have h_σ_eq_HT : ∀ x ∈ Set.Ioo a₁' a₂',
            ∀ q ∈ Q_famB x ∩ rectB a₁' a₂' (β₁_seq m) (β₂_seq (m + 1)),
              σ_famB x q = H_T q := by
          intro x hx
          have hp_Qx : (((x : ℂ) + (y_ss : ℂ) * Complex.I, t_c) : ℂ × ℂ) ∈ Q_famB x :=
            ⟨⟨by rw [(h_re_im x y_ss).1]; exact max_lt hx.1 (by linarith),
              by rw [(h_re_im x y_ss).1]; exact lt_min hx.2 (by linarith),
              by rw [(h_re_im x y_ss).2]; exact hy_ss_in_B.1,
              by rw [(h_re_im x y_ss).2]; exact hy_ss_in_B.2⟩,
             Metric.mem_ball_self hη_pos⟩
          exact hUniq (Q_famB x ∩ rectB a₁' a₂' (β₁_seq m) (β₂_seq (m + 1)))
            (σ_famB x) H_T ((x : ℂ) + (y_ss : ℂ) * Complex.I, t_c)
            (isOpen_inter_rectB _ _ _ _ _ _ _ _) (isPreconn_inter_rectB _ _ _ _ _ _ _ _)
            (Set.Subset.trans Set.inter_subset_right
              (rectB_sub_U _ _ _ _ le_rfl le_rfl (le_max_left _ _) (min_le_left _ _)))
            ⟨hp_Qx, h_pt_VT x hx⟩
            ((hσ_famB x hx).1.mono Set.inter_subset_left)
            (hHT_holo.mono Set.inter_subset_right)
            (fun q hq => (hσ_famB x hx).2.2 q hq.1)
            (fun q hq => hHT_sol q hq.2)
            (hσ_famB x hx).2.1
        have h_compat_B : ∀ x₁ ∈ Set.Ioo a₁' a₂', ∀ x₂ ∈ Set.Ioo a₁' a₂',
            ∀ q ∈ Q_famB x₁ ∩ Q_famB x₂, σ_famB x₁ q = σ_famB x₂ q := by
          intro x₁ hx₁ x₂ hx₂ q hq
          let x_q : ℝ := q.1.re
          let pt_q : ℂ × ℂ := ((x_q : ℂ) + (y_ss : ℂ) * Complex.I, t_c)
          have hpt_re : pt_q.1.re = x_q := by simp [pt_q]
          have hpt_im : pt_q.1.im = y_ss := by simp [pt_q]
          have hp_Q₁ : pt_q ∈ Q_famB x₁ :=
            ⟨⟨by rw [hpt_re]; exact hq.1.1.1,
              by rw [hpt_re]; exact hq.1.1.2.1,
              by rw [hpt_im]; exact hy_ss_in_B.1,
              by rw [hpt_im]; exact hy_ss_in_B.2⟩,
             Metric.mem_ball_self hη_pos⟩
          have hp_Q₂ : pt_q ∈ Q_famB x₂ :=
            ⟨⟨by rw [hpt_re]; exact hq.2.1.1,
              by rw [hpt_re]; exact hq.2.1.2.1,
              by rw [hpt_im]; exact hy_ss_in_B.1,
              by rw [hpt_im]; exact hy_ss_in_B.2⟩,
             Metric.mem_ball_self hη_pos⟩
          have hx_q_Ioo : x_q ∈ Set.Ioo a₁' a₂' :=
            ⟨lt_of_le_of_lt (le_max_left _ _) hq.1.1.1,
             lt_of_lt_of_le hq.1.1.2.1 (min_le_left _ _)⟩
          have hp_VT : pt_q ∈ rectB a₁' a₂' (β₁_seq m) (β₂_seq (m + 1)) := h_pt_VT x_q hx_q_Ioo
          have hp_eq : σ_famB x₁ pt_q = σ_famB x₂ pt_q :=
            (h_σ_eq_HT x₁ hx₁ pt_q ⟨hp_Q₁, hp_VT⟩).trans
              (h_σ_eq_HT x₂ hx₂ pt_q ⟨hp_Q₂, hp_VT⟩).symm
          exact hUniq (Q_famB x₁ ∩ Q_famB x₂) (σ_famB x₁) (σ_famB x₂) pt_q
            (isOpen_inter_rectB _ _ _ _ _ _ _ _) (isPreconn_inter_rectB _ _ _ _ _ _ _ _)
            (Set.Subset.trans Set.inter_subset_left
              (rectB_sub_U _ _ _ _ (le_max_left _ _) (min_le_left _ _)
                (le_max_left _ _) (min_le_left _ _)))
            ⟨hp_Q₁, hp_Q₂⟩
            ((hσ_famB x₁ hx₁).1.mono Set.inter_subset_left)
            ((hσ_famB x₂ hx₂).1.mono Set.inter_subset_right)
            (fun q' hq' => (hσ_famB x₁ hx₁).2.2 q' hq'.1)
            (fun q' hq' => (hσ_famB x₂ hx₂).2.2 q' hq'.2)
            hp_eq q hq
        obtain ⟨Sig_B, hSig_B_holo, hSig_B_eq, hSig_B_sol⟩ :=
          glue_family (Set.Ioo a₁' a₂') Q_famB σ_famB
            (fun x _ => isOpen_rectB _ _ _ _)
            (fun x hx => (hσ_famB x hx).1)
            (fun x hx => (hσ_famB x hx).2.2)
            h_compat_B
        have h_iUnion_B : (⋃ x ∈ Set.Ioo a₁' a₂', Q_famB x) =
            rectB a₁' a₂' (β₁_seq (m + 1)) β₂'' := by
          ext ⟨w, t⟩
          constructor
          · intro hq
            obtain ⟨x, _, ⟨⟨hw₁, hw₂, hw₃, hw₄⟩, ht⟩⟩ := Set.mem_iUnion₂.mp hq
            exact ⟨⟨lt_of_le_of_lt (le_max_left _ _) hw₁,
              lt_of_lt_of_le hw₂ (min_le_left _ _), hw₃, hw₄⟩, ht⟩
          · rintro ⟨⟨hw₁, hw₂, hw₃, hw₄⟩, ht⟩
            exact Set.mem_iUnion₂.mpr ⟨w.re, ⟨hw₁, hw₂⟩,
              ⟨⟨max_lt hw₁ (by linarith), lt_min hw₂ (by linarith), hw₃, hw₄⟩, ht⟩⟩
        rw [h_iUnion_B] at hSig_B_holo hSig_B_sol
        have h_agree_B : ∀ q ∈ rectB a₁' a₂' (β₁_seq (m + 1)) β₂'' ∩
            rectB a₁' a₂' (β₁_seq m) (β₂_seq (m + 1)), Sig_B q = H_T q := by
          intro q ⟨hq_SB, hq_VT⟩
          rw [← h_iUnion_B] at hq_SB
          obtain ⟨x, hx, hq_Qx⟩ := Set.mem_iUnion₂.mp hq_SB
          rw [hSig_B_eq x hx q hq_Qx]
          exact h_σ_eq_HT x hx q ⟨hq_Qx, hq_VT⟩
        obtain ⟨H_next, hHn_holo, _, hHn_2, hHn_sol⟩ :=
          paste_two (rectB a₁' a₂' (β₁_seq (m + 1)) β₂'')
            (rectB a₁' a₂' (β₁_seq m) (β₂_seq (m + 1))) Sig_B H_T
            (isOpen_rectB _ _ _ _) (isOpen_rectB _ _ _ _)
            hSig_B_holo hHT_holo hSig_B_sol hHT_sol h_agree_B
        have h_ord₁ : β₁_seq (m + 1) ≤ β₁_seq m := by
          dsimp [β₁_seq]; push_cast; exact max_le_max le_rfl (by linarith)
        have h_ord₂ : β₁_seq m < β₂'' := by
          rw [hβ₁m_eq]; dsimp [β₂'', y_ss]
          exact lt_min (by linarith [hw₀_im₂]) (by linarith)
        have h_ord₃ : β₂'' ≤ β₂_seq (m + 1) := by
          dsimp [β₂'', β₂_seq, y_ss]; push_cast; exact min_le_min le_rfl (by linarith)
        have h_unB : rectB a₁' a₂' (β₁_seq (m + 1)) β₂'' ∪
            rectB a₁' a₂' (β₁_seq m) (β₂_seq (m + 1)) =
            rectB a₁' a₂' (β₁_seq (m + 1)) (β₂_seq (m + 1)) :=
          rectB_union_y _ _ _ _ _ _ h_ord₁ h_ord₂ h_ord₃
        rw [h_unB] at hHn_holo hHn_sol
        have hw₀_VT : (w₀, t_c) ∈ rectB a₁' a₂' (β₁_seq m) (β₂_seq (m + 1)) :=
          ⟨⟨hw₀_re₁, hw₀_re₂, (hy₀_β m).1, (hy₀_β (m + 1)).2⟩, Metric.mem_ball_self hη_pos⟩
        exact ⟨H_next, hHn_holo, (hHn_2 (w₀, t_c) hw₀_VT).trans hHT_pt, hHn_sol⟩
  obtain ⟨N_y, hN_y⟩ := exists_nat_gt (max (b₂' - y₀) (y₀ - b₁') / s)
  have hN_y_mul : max (b₂' - y₀) (y₀ - b₁') < (N_y : ℝ) * s :=
    (div_lt_iff₀ hs_pos).mp hN_y
  have hβ₁_Ny : β₁_seq N_y = b₁' :=
    max_eq_left (by linarith [le_max_right (b₂' - y₀) (y₀ - b₁')])
  have hβ₂_Ny : β₂_seq N_y = b₂' :=
    min_eq_left (by linarith [le_max_left (b₂' - y₀) (y₀ - b₁')])
  obtain ⟨Λ, hΛ_holo, hΛ_pt, hΛ_sol⟩ := hVert N_y
  rw [hβ₁_Ny, hβ₂_Ny] at hΛ_holo hΛ_sol
  exact ⟨η, Λ, hη_pos, hη_le_rt, hΛ_holo, hΛ_pt, hΛ_sol⟩

theorem punctured_graph_monodromy_dichotomy (Ω : Set Plane)
    (C : AnalyticGlancingCollar Ω)
    (hDet : EndpointDeterminationData C)
    (W : CollarWidthTubeData C hDet)
    (hPer : DualLineTubePeriodicProp W)
    (hRectCont : SeparableRectRootContProp)
    (H₁ η t₁ t₂ H₂ : ℝ)
    (B_poly : FullBandPolyData W H₁ η t₁)
    (β : Fin B_poly.N_cov)
    (ht₂_mem : |t₂| < W.r_base)
    (ht₂_β : (t₂ : ℂ) ∈ Metric.ball (B_poly.τ_c β) (3 * B_poly.ρ_t β / 4))
    (hhL : W.h_L (t₂ : ℂ) = ENNReal.ofReal H₂)
    (hH₂_ge : 2 * W.s_base ≤ H₂) :
    (∀ x_mod : ℝ,
      (x_mod : ℂ) + (H₂ : ℂ) * Complex.I ∈ Metric.ball (B_poly.y_c β) (3 * B_poly.ρ_y β / 4) →
      B_poly.H_exc β ((x_mod : ℂ) + (H₂ : ℂ) * Complex.I, (t₂ : ℂ)) ≠ 0 →
      WallRegAt W t₂ H₂ x_mod) ∧
    (∀ (x_star : ℝ) (k_shift : ℤ),
      IsIsolatedGraphSlicedAt (B_poly.y_c β) (B_poly.τ_c β)
        (B_poly.ρ_y β) (B_poly.ρ_t β) (B_poly.H_exc β) t₂ →
      ((x_star + t₂ - 2 * Real.pi * (k_shift : ℝ) : ℝ) : ℂ) + (H₂ : ℂ) * Complex.I ∈
        Metric.ball (B_poly.y_c β) (3 * B_poly.ρ_y β / 4) →
      ¬ WallRegAt W t₂ H₂ (x_star + t₂) →
      HasLoopBranchDefectAt W t₂ H₂ x_star) :=
by
  classical
  have eqOn_zero_convex_2D : ∀ {W_dom : Set (ℂ × ℂ)}, IsOpen W_dom → Convex ℝ W_dom →
      ∀ {f : ℂ × ℂ → ℂ}, DifferentiableOn ℂ f W_dom →
      ∀ {p₀ : ℂ × ℂ}, p₀ ∈ W_dom → (∀ᶠ q in nhds p₀, f q = 0) →
      ∀ p ∈ W_dom, f p = 0 := by
    intro W_dom hW_open hW_conv f hf_holo p₀ hp₀ hf_ev p hp
    let γ : ℂ → ℂ × ℂ := fun ζ => (p₀.1 + ζ * (p.1 - p₀.1), p₀.2 + ζ * (p.2 - p₀.2))
    have hγ_diff : Differentiable ℂ γ :=
      (differentiable_const p₀.1 |>.add (differentiable_id.mul (differentiable_const _))).prodMk
        (differentiable_const p₀.2 |>.add (differentiable_id.mul (differentiable_const _)))
    let W₁ : Set ℂ := γ ⁻¹' W_dom
    have hW₁_open : IsOpen W₁ := hW_open.preimage hγ_diff.continuous
    have hW₁_conv : Convex ℝ W₁ := by
      intro ζ₁ hζ₁ ζ₂ hζ₂ a b ha hb hab
      have habC : (a : ℂ) + (b : ℂ) = 1 := by exact_mod_cast hab
      have haff : γ (a • ζ₁ + b • ζ₂) = a • γ ζ₁ + b • γ ζ₂ := by
        ext <;> simp only [γ, Prod.smul_fst, Prod.smul_snd, Prod.fst_add, Prod.snd_add,
          Complex.real_smul]
        · calc p₀.1 + (↑a * ζ₁ + ↑b * ζ₂) * (p.1 - p₀.1)
              = ((↑a + ↑b) * p₀.1) + (↑a * ζ₁ + ↑b * ζ₂) * (p.1 - p₀.1) := by rw [habC, one_mul]
            _ = ↑a * (p₀.1 + ζ₁ * (p.1 - p₀.1)) + ↑b * (p₀.1 + ζ₂ * (p.1 - p₀.1)) := by ring
        · calc p₀.2 + (↑a * ζ₁ + ↑b * ζ₂) * (p.2 - p₀.2)
              = ((↑a + ↑b) * p₀.2) + (↑a * ζ₁ + ↑b * ζ₂) * (p.2 - p₀.2) := by rw [habC, one_mul]
            _ = ↑a * (p₀.2 + ζ₁ * (p.2 - p₀.2)) + ↑b * (p₀.2 + ζ₂ * (p.2 - p₀.2)) := by ring
      change γ (a • ζ₁ + b • ζ₂) ∈ W_dom
      rw [haff]
      exact hW_conv hζ₁ hζ₂ ha hb hab
    have h0_mem : (0 : ℂ) ∈ W₁ := by simpa [W₁, γ] using hp₀
    have h1_mem : (1 : ℂ) ∈ W₁ := by
      change (p₀.1 + 1 * (p.1 - p₀.1), p₀.2 + 1 * (p.2 - p₀.2)) ∈ W_dom
      simpa using hp
    have hg_holo : DifferentiableOn ℂ (f ∘ γ) W₁ :=
      hf_holo.comp hγ_diff.differentiableOn (fun _ h => h)
    have hg_ana : AnalyticOnNhd ℂ (f ∘ γ) W₁ := hg_holo.analyticOnNhd hW₁_open
    have hγ0 : γ 0 = p₀ := by ext <;> simp [γ]
    have hg_ev : (f ∘ γ) =ᶠ[nhds (0 : ℂ)] 0 := by
      have h_tendsto : Filter.Tendsto γ (nhds (0 : ℂ)) (nhds p₀) := by
        rw [← hγ0]
        exact hγ_diff.continuous.continuousAt
      exact h_tendsto.eventually hf_ev
    have h1 := AnalyticOnNhd.eqOn_zero_of_preconnected_of_eventuallyEq_zero
      hg_ana hW₁_conv.isPreconnected h0_mem hg_ev h1_mem
    simpa [γ] using h1

  have cancel_holo_convex_2D : ∀ {W_dom V : Set (ℂ × ℂ)}, IsOpen W_dom → Convex ℝ W_dom →
      IsOpen V → V ⊆ W_dom →
      ∀ {f g : ℂ × ℂ → ℂ}, ContinuousOn f V → DifferentiableOn ℂ g W_dom →
      (∃ q_nz ∈ W_dom, g q_nz ≠ 0) → (∀ q ∈ V, f q * g q = 0) →
      ∀ q ∈ V, f q = 0 := by
    intro W_dom V hW_open hW_conv hV_open hVW f g hf_cont hg_holo hg_nz hprod q₁ hq₁
    by_contra hfq₁
    obtain ⟨q_nz, hq_nz_W, hg_q_nz⟩ := hg_nz
    have hf_contAt : ContinuousAt f q₁ := (hf_cont q₁ hq₁).continuousAt (hV_open.mem_nhds hq₁)
    have hg_ev : ∀ᶠ q in nhds q₁, g q = 0 := by
      filter_upwards [hV_open.mem_nhds hq₁, hf_contAt.eventually_ne hfq₁] with q hqV hfq
      exact (mul_eq_zero.mp (hprod q hqV)).resolve_left hfq
    exact hg_q_nz (eqOn_zero_convex_2D hW_open hW_conv hg_holo (hVW hq₁) hg_ev q_nz hq_nz_W)

  have finset_prod_eq_zero_convex_2D : ∀ {α : Type} [DecidableEq α] {V : Set (ℂ × ℂ)},
      IsOpen V → Convex ℝ V → ∀ {p₀ : ℂ × ℂ}, p₀ ∈ V →
      ∀ (S : Finset α) (h : α → ℂ × ℂ → ℂ),
        (∀ m ∈ S, DifferentiableOn ℂ (h m) V) →
        (∀ q ∈ V, (∏ m ∈ S, h m q) = 0) →
        ∃ m₀ ∈ S, ∀ q ∈ V, h m₀ q = 0 := by
    intro α _ V hV_open hV_conv p₀ hp₀ S h hh_holo hprod
    have hprod_diff : ∀ (T : Finset α),
        (∀ m ∈ T, DifferentiableOn ℂ (h m) V) →
        DifferentiableOn ℂ (fun q => ∏ m ∈ T, h m q) V := by
      intro T hT
      induction T using Finset.induction_on with
      | empty => simp [differentiableOn_const]
      | @insert b T hb ihT =>
        have hb_holo := hT b (Finset.mem_insert_self b T)
        have hT_holo := ihT (fun m hm => hT m (Finset.mem_insert_of_mem hm))
        have heq : (fun q => ∏ m ∈ insert b T, h m q) =
            fun q => h b q * ∏ m ∈ T, h m q := by
          ext q; exact Finset.prod_insert hb
        rw [heq]
        exact hb_holo.mul hT_holo
    induction S using Finset.induction_on with
    | empty =>
      exfalso
      have h1 := hprod p₀ hp₀
      simp at h1
    | @insert a S ha ih =>
      by_cases ha_zero : ∀ q ∈ V, h a q = 0
      · exact ⟨a, Finset.mem_insert_self a S, ha_zero⟩
      · push Not at ha_zero
        have hS_holo : ∀ m ∈ S, DifferentiableOn ℂ (h m) V :=
          fun m hm => hh_holo m (Finset.mem_insert_of_mem hm)
        have hprod_cont : ContinuousOn (fun q => ∏ m ∈ S, h m q) V :=
          (hprod_diff S hS_holo).continuousOn
        have hS_zero : ∀ q ∈ V, (∏ m ∈ S, h m q) = 0 := by
          refine cancel_holo_convex_2D hV_open hV_conv hV_open Set.Subset.rfl hprod_cont
            (hh_holo a (Finset.mem_insert_self a S)) ha_zero (fun q hq => ?_)
          have hq0 := hprod q hq
          rw [Finset.prod_insert ha, mul_comm] at hq0
          exact hq0
        obtain ⟨m₀, hm₀, hm₀_zero⟩ := ih hS_holo hS_zero
        exact ⟨m₀, Finset.mem_insert_of_mem hm₀, hm₀_zero⟩

  have isOpen_and_convex_rect : ∀ (a₁ a₂ b₁ b₂ : ℝ),
      IsOpen { w : ℂ | a₁ < w.re ∧ w.re < a₂ ∧ b₁ < w.im ∧ w.im < b₂ } ∧
      Convex ℝ { w : ℂ | a₁ < w.re ∧ w.re < a₂ ∧ b₁ < w.im ∧ w.im < b₂ } := by
    intro a₁ a₂ b₁ b₂
    have heq : { w : ℂ | a₁ < w.re ∧ w.re < a₂ ∧ b₁ < w.im ∧ w.im < b₂ } =
        (Complex.reLm ⁻¹' Set.Ioo a₁ a₂) ∩ (Complex.imLm ⁻¹' Set.Ioo b₁ b₂) := by
      ext w
      simp [Set.mem_Ioo, and_assoc]
    rw [heq]
    refine ⟨(isOpen_Ioo.preimage Complex.continuous_re).inter
        (isOpen_Ioo.preimage Complex.continuous_im),
      ((convex_Ioo a₁ a₂).linear_preimage Complex.reLm).inter
        ((convex_Ioo b₁ b₂).linear_preimage Complex.imLm)⟩

  have poly_simple_roots_card : ∀ (D : ℕ) (c : Fin (D + 1) → ℂ),
      c (Fin.last D) ≠ 0 →
      (∀ z : ℂ,
        ∑ d : Fin (D + 1), c d * z ^ (d : ℕ) = 0 →
        ∑ d : Fin D, (((d : ℕ) + 1 : ℕ) : ℂ) * c d.succ * z ^ (d : ℕ) ≠ 0) →
      let P : Polynomial ℂ := ∑ d : Fin (D + 1), Polynomial.C (c d) * Polynomial.X ^ (d : ℕ)
      P.roots.toFinset.card = D ∧
      ∀ z : ℂ, z ∈ P.roots.toFinset ↔ ∑ d : Fin (D + 1), c d * z ^ (d : ℕ) = 0 := by
    intro D c hcD hsep P
    have heval : ∀ z : ℂ, P.eval z = ∑ d : Fin (D + 1), c d * z ^ (d : ℕ) := by
      intro z
      simp [P, Polynomial.eval_finsetSum]
    have hderiv_eval : ∀ z : ℂ, (Polynomial.derivative P).eval z =
        ∑ d : Fin D, (((d : ℕ) + 1 : ℕ) : ℂ) * c d.succ * z ^ (d : ℕ) := by
      intro z
      have hP_split : P = Polynomial.C (c 0) * Polynomial.X ^ 0 +
          ∑ d : Fin D, Polynomial.C (c d.succ) * Polynomial.X ^ ((d : ℕ) + 1) := by
        dsimp only [P]
        exact Fin.sum_univ_succ _
      rw [hP_split, map_add, map_sum, Polynomial.derivative_C_mul_X_pow]
      simp only [Nat.cast_zero, mul_zero, map_zero, zero_mul, zero_add,
        Polynomial.eval_finsetSum]
      refine Finset.sum_congr rfl fun d _ => ?_
      rw [Polynomial.derivative_C_mul_X_pow]
      simp [mul_comm (c d.succ), mul_assoc]
    have hcoeff : ∀ n : ℕ, P.coeff n = ∑ d : Fin (D + 1), if n = (d : ℕ) then c d else 0 := by
      intro n
      simp [P, Polynomial.finsetSum_coeff, Polynomial.coeff_C_mul, Polynomial.coeff_X_pow]
    have hdeg_le : P.natDegree ≤ D := by
      refine Polynomial.natDegree_le_iff_coeff_eq_zero.mpr fun n hn => ?_
      rw [hcoeff n]
      refine Finset.sum_eq_zero fun d _ => ?_
      have hne : n ≠ (d : ℕ) := by have := d.isLt; omega
      simp [hne]
    have hcoeff_D : P.coeff D = c (Fin.last D) := by
      rw [hcoeff D]
      refine (Finset.sum_eq_single (Fin.last D) (fun d _ hd => ?_)
        (fun h => False.elim (h (Finset.mem_univ _)))).trans ?_
      · have hne : D ≠ (d : ℕ) := fun hEq => hd (Fin.ext hEq.symm)
        simp [hne]
      · simp
    have hdeg : P.natDegree = D :=
      Polynomial.natDegree_eq_of_le_of_coeff_ne_zero hdeg_le (by rwa [hcoeff_D])
    have hP_ne : P ≠ 0 := by
      intro h0
      apply hcD
      rw [← hcoeff_D, h0, Polynomial.coeff_zero]
    have hnodup : P.roots.Nodup := by
      rw [Multiset.nodup_iff_count_le_one]
      intro z
      rw [Polynomial.count_roots]
      by_contra hgt
      push Not at hgt
      obtain ⟨hr1, hr2⟩ := (Polynomial.one_lt_rootMultiplicity_iff_isRoot hP_ne).mp hgt
      rw [Polynomial.IsRoot.def, heval] at hr1
      rw [Polynomial.IsRoot.def, hderiv_eval] at hr2
      exact hsep z hr1 hr2
    refine ⟨?_, fun z => ?_⟩
    · rw [Multiset.toFinset_card_of_nodup hnodup, IsAlgClosed.card_roots_eq_natDegree, hdeg]
    · simp [Multiset.mem_toFinset, Polynomial.mem_roots hP_ne, Polynomial.IsRoot.def, heval]

  
  have hCauchy : ∀ (ρ₀ δ_t : ℝ) (t_c : ℂ) (D : ℕ),
      0 < ρ₀ → 0 < δ_t → 1 ≤ D →
      ∀ (a : Fin (D + 1) → ℂ × ℂ → ℂ),
        (∀ d : Fin (D + 1),
          DifferentiableOn ℂ (a d) (Metric.ball (0 : ℂ) ρ₀ ×ˢ Metric.ball t_c δ_t)) →
        (∀ u ∈ Metric.ball (0 : ℂ) ρ₀, u ≠ 0 → ∀ t ∈ Metric.ball t_c δ_t,
          a (Fin.last D) (u, t) ≠ 0 ∧
          ∀ z : ℂ,
            ∑ d : Fin (D + 1), a d (u, t) * z ^ (d : ℕ) = 0 →
            ∑ d : Fin D, (((d : ℕ) + 1 : ℕ) : ℂ) * a d.succ (u, t) * z ^ (d : ℕ) ≠ 0) →
        ∀ (Λ_ann : ℂ × ℂ → ℂ),
          DifferentiableOn ℂ Λ_ann
            ({ w : ℂ | Real.log (ρ₀ / 2) < w.re ∧ w.re < Real.log (7 * ρ₀ / 8) ∧
                -Real.pi / 2 - 3 / 16 < w.im ∧ w.im < 3 * Real.pi / 2 + 3 / 16 } ×ˢ
              Metric.ball t_c δ_t) →
          (∀ q ∈
            ({ w : ℂ | Real.log (ρ₀ / 2) < w.re ∧ w.re < Real.log (7 * ρ₀ / 8) ∧
                -Real.pi / 2 - 3 / 16 < w.im ∧ w.im < 3 * Real.pi / 2 + 3 / 16 } ×ˢ
              Metric.ball t_c δ_t),
            ∑ d : Fin (D + 1), a d (Complex.exp q.1, q.2) * (Λ_ann q) ^ (d : ℕ) = 0) →
          (∀ᶠ q in nhds
            ((Real.log (5 * ρ₀ / 8) : ℂ) - ((Real.pi / 2 : ℝ) : ℂ) * Complex.I, t_c),
            Λ_ann (q.1 + 2 * Real.pi * Complex.I, q.2) = Λ_ann q) →
          ∃ N : ℂ × ℂ → ℂ,
            DifferentiableOn ℂ N
              (Metric.ball (0 : ℂ) (13 * ρ₀ / 16) ×ˢ Metric.ball t_c δ_t) ∧
            ∀ᶠ q in nhds
              ((Real.log (5 * ρ₀ / 8) : ℂ) - ((Real.pi / 2 : ℝ) : ℂ) * Complex.I, t_c),
              N (Complex.exp q.1, q.2) =
                a (Fin.last D) (Complex.exp q.1, q.2) * Λ_ann q := by
    intro ρ₀ δ_t t_c D hρ₀ hδ_t hD a ha_holo ha_sep Λ_ann hΛ_holo hΛ_root h_mono_eq
    let R_ann : Set ℂ :=
      { w : ℂ | Real.log (ρ₀ / 2) < w.re ∧ w.re < Real.log (7 * ρ₀ / 8) ∧
          -Real.pi / 2 - 3 / 16 < w.im ∧ w.im < 3 * Real.pi / 2 + 3 / 16 }
    let w_seed : ℂ := (Real.log (5 * ρ₀ / 8) : ℂ) - ((Real.pi / 2 : ℝ) : ℂ) * Complex.I
    have hpi_gt3 : (3 : ℝ) < Real.pi := Real.pi_gt_three
    have hlog_half_lt_58 : Real.log (ρ₀ / 2) < Real.log (5 * ρ₀ / 8) :=
      Real.log_lt_log (by linarith) (by linarith)
    have hlog_58_lt_1316 : Real.log (5 * ρ₀ / 8) < Real.log (13 * ρ₀ / 16) :=
      Real.log_lt_log (by linarith) (by linarith)
    have hlog_1316_lt_2732 : Real.log (13 * ρ₀ / 16) < Real.log (27 * ρ₀ / 32) :=
      Real.log_lt_log (by linarith) (by linarith)
    have hlog_2732_lt_78 : Real.log (27 * ρ₀ / 32) < Real.log (7 * ρ₀ / 8) :=
      Real.log_lt_log (by linarith) (by linarith)
    have hlog_58_lt_78 : Real.log (5 * ρ₀ / 8) < Real.log (7 * ρ₀ / 8) :=
      lt_trans hlog_58_lt_1316 (lt_trans hlog_1316_lt_2732 hlog_2732_lt_78)
    let R_bot : Set ℂ :=
      { w : ℂ | Real.log (ρ₀ / 2) < w.re ∧ w.re < Real.log (7 * ρ₀ / 8) ∧
          -Real.pi / 2 - 3 / 16 < w.im ∧ w.im < -Real.pi / 2 + 3 / 16 }
    let S_bot : Set (ℂ × ℂ) := R_bot ×ˢ Metric.ball t_c δ_t
    have hR_bot_oc := isOpen_and_convex_rect (Real.log (ρ₀ / 2)) (Real.log (7 * ρ₀ / 8))
      (-Real.pi / 2 - 3 / 16) (-Real.pi / 2 + 3 / 16)
    have hS_bot_open : IsOpen S_bot := hR_bot_oc.1.prod Metric.isOpen_ball
    have hS_bot_conv : Convex ℝ S_bot := hR_bot_oc.2.prod (convex_ball t_c δ_t)
    have hw_seed_bot : (w_seed, t_c) ∈ S_bot := by
      refine ⟨⟨?_, ?_, ?_, ?_⟩, Metric.mem_ball_self hδ_t⟩
      · simpa [w_seed] using hlog_half_lt_58
      · simpa [w_seed] using hlog_58_lt_78
      · simp [w_seed]; linarith
      · simp [w_seed]; linarith
    have hS_bot_sub1 : S_bot ⊆ R_ann ×ˢ Metric.ball t_c δ_t := by
      intro q hq
      exact ⟨⟨hq.1.1, hq.1.2.1, hq.1.2.2.1, by linarith [hq.1.2.2.2, hpi_gt3]⟩, hq.2⟩
    have hS_bot_sub2 : ∀ q ∈ S_bot,
        (q.1 + 2 * Real.pi * Complex.I, q.2) ∈ R_ann ×ˢ Metric.ball t_c δ_t := by
      intro q hq
      have hre : (q.1 + 2 * (Real.pi : ℂ) * Complex.I).re = q.1.re := by simp
      have him : (q.1 + 2 * (Real.pi : ℂ) * Complex.I).im = q.1.im + 2 * Real.pi := by simp
      refine ⟨⟨?_, ?_, ?_, ?_⟩, hq.2⟩
      · rw [hre]; exact hq.1.1
      · rw [hre]; exact hq.1.2.1
      · rw [him]; linarith [hq.1.2.2.1, hpi_gt3]
      · rw [him]; linarith [hq.1.2.2.2]
    have h_bot_per : ∀ q ∈ S_bot, Λ_ann (q.1 + 2 * Real.pi * Complex.I, q.2) = Λ_ann q := by
      have hdiff_per : DifferentiableOn ℂ
          (fun q : ℂ × ℂ => Λ_ann (q.1 + 2 * Real.pi * Complex.I, q.2) - Λ_ann q) S_bot := by
        have hsh : Differentiable ℂ (fun q : ℂ × ℂ => (q.1 + 2 * Real.pi * Complex.I, q.2)) :=
          (differentiable_fst.add (differentiable_const _)).prodMk differentiable_snd
        exact (hΛ_holo.comp hsh.differentiableOn hS_bot_sub2).sub (hΛ_holo.mono hS_bot_sub1)
      have hev_zero : ∀ᶠ q in nhds (w_seed, t_c),
          Λ_ann (q.1 + 2 * Real.pi * Complex.I, q.2) - Λ_ann q = 0 := by
        filter_upwards [h_mono_eq] with q hq using sub_eq_zero.mpr hq
      intro q hq
      exact sub_eq_zero.mp
        (eqOn_zero_convex_2D hS_bot_open hS_bot_conv hdiff_per hw_seed_bot hev_zero q hq)
    let A_out : Set ℂ := { u : ℂ | ρ₀ / 2 < ‖u‖ ∧ ‖u‖ < 7 * ρ₀ / 8 }
    let U₁ : Set ℂ := { u : ℂ | u ∈ A_out ∧ -Complex.I * u ∈ Complex.slitPlane }
    let U₂ : Set ℂ := { u : ℂ | u ∈ A_out ∧ u.im < 0 ∧ |u.re| < (-u.im) / 8 }
    have hA_out_open : IsOpen A_out :=
      (isOpen_lt continuous_const continuous_norm).inter (isOpen_lt continuous_norm continuous_const)
    have hU₁_open : IsOpen U₁ :=
      hA_out_open.inter (Complex.isOpen_slitPlane.preimage (continuous_const.mul continuous_id))
    have hU₂_open : IsOpen U₂ :=
      hA_out_open.inter
        ((isOpen_lt Complex.continuous_im continuous_const).inter
          (isOpen_lt (continuous_abs.comp Complex.continuous_re)
            ((Complex.continuous_im.neg).div_const 8)))
    have hA_cov : A_out ⊆ U₁ ∪ U₂ := by
      intro u hu
      by_cases h1 : -Complex.I * u ∈ Complex.slitPlane
      · exact Or.inl ⟨hu, h1⟩
      · right
        rw [Complex.mem_slitPlane_iff] at h1
        push Not at h1
        have hre : (-Complex.I * u).re = u.im := by simp
        have him : (-Complex.I * u).im = -u.re := by simp
        rw [hre] at h1
        rw [him] at h1
        have hure0 : u.re = 0 := by linarith [h1.2]
        have hu_ne : u ≠ 0 := by
          intro h0
          have hu1 : ρ₀ / 2 < ‖u‖ := hu.1
          rw [h0, norm_zero] at hu1
          linarith
