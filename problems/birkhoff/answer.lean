        have hDB₂ : DifferentiableOn ℂ (dslope B₂ 0) U₀ :=
          (Complex.differentiableOn_dslope hU₀_nhds).mpr hB₂
        refine ⟨hA₁.mul hA₂, hB₁.mul hB₂,
          fun ε =>
            Ψ₁ ε * B₂ ε + c₁ * dslope B₂ 0 ε +
            B₁ ε * Ψ₂ ε + c₂ * dslope B₁ 0 ε +
            ε ^ (l - 1) * (c₁ + ε * Ψ₁ ε) * (c₂ + ε * Ψ₂ ε),
          ((((hΨ₁.mul hB₂).add ((differentiableOn_const c₁).mul hDB₂)).add
            (hB₁.mul hΨ₂)).add ((differentiableOn_const c₂).mul hDB₁)).add
            (((differentiableOn_id.pow (l - 1)).mul
              ((differentiableOn_const c₁).add (differentiableOn_id.mul hΨ₁))).mul
              ((differentiableOn_const c₂).add (differentiableOn_id.mul hΨ₂))),
          fun ε hε => ?_⟩
        have hB₁_eq : B₁ ε = B₁ 0 + ε * dslope B₁ 0 ε := by
          have h := sub_smul_dslope B₁ 0 ε
          rw [sub_zero, smul_eq_mul] at h
          linear_combination -h
        have hB₂_eq : B₂ ε = B₂ 0 + ε * dslope B₂ 0 ε := by
          have h := sub_smul_dslope B₂ 0 ε
          rw [sub_zero, smul_eq_mul] at h
          linear_combination -h
        have hA₁_eq : A₁ ε = B₁ ε + ε ^ l * (c₁ + ε * Ψ₁ ε) := by
          linear_combination he₁ ε hε
        have hA₂_eq : A₂ ε = B₂ ε + ε ^ l * (c₂ + ε * Ψ₂ ε) := by
          linear_combination he₂ ε hε
        have hpow2l : ε ^ l * ε ^ l = ε ^ (l + 1) * ε ^ (l - 1) := by
          rw [← pow_add, ← pow_add]
          congr 1
