      den := fun p q => F.den p q * G.den p q
      rad_pos := fun p hp => lt_min (F.rad_pos p hp) (G.rad_pos p hp)
      ball_sub := fun p hp =>
        Set.Subset.trans (Metric.ball_subset_ball (min_le_left _ _)) (F.ball_sub p hp)
      num_holo := fun p hp =>
        (((F.num_holo p hp).mono (Metric.ball_subset_ball (min_le_left _ _))).mul
          ((G.den_holo p hp).mono (Metric.ball_subset_ball (min_le_right _ _)))).add
        (((G.num_holo p hp).mono (Metric.ball_subset_ball (min_le_right _ _))).mul
          ((F.den_holo p hp).mono (Metric.ball_subset_ball (min_le_left _ _))))
      den_holo := fun p hp =>
        ((F.den_holo p hp).mono (Metric.ball_subset_ball (min_le_left _ _))).mul
          ((G.den_holo p hp).mono (Metric.ball_subset_ball (min_le_right _ _)))
