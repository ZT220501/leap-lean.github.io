    have hdeg_zero_iff : ∀ d : Fin 2 →₀ ℕ, d = 0 ↔ d 0 + d 1 = 0 := by
      intro d
      constructor
      · rintro rfl; simp
      · intro h; ext i; fin_cases i <;> (simp; omega)
    have hdeg_add : ∀ d₁ d₂ : Fin 2 →₀ ℕ,
        (d₁ + d₂) 0 + (d₁ + d₂) 1 = (d₁ 0 + d₁ 1) + (d₂ 0 + d₂ 1) := by
      intro d₁ d₂; simp only [Finsupp.add_apply]; omega
    have hdeg_single : ∀ (ι : Fin 2) (d : Fin 2 →₀ ℕ),
        (d + e ι) 0 + (d + e ι) 1 = d 0 + d 1 + 1 := by
      intro ι d; fin_cases ι <;> (simp [e]; omega)
    have hmv_add : ∀ (ι : Fin 2) (Φ Ψ : MvPowerSeries (Fin 2) ℂ),
        mvDeriv ι (Φ + Ψ) = mvDeriv ι Φ + mvDeriv ι Ψ := by
      intro ι Φ Ψ
      ext d
      rw [map_add, hmv_coeff, hmv_coeff, hmv_coeff, map_add, mul_add]
    have hmv_mul_left : ∀ (ι : Fin 2) (Φ Ψ : MvPowerSeries (Fin 2) ℂ) (d : Fin 2 →₀ ℕ),
        MvPowerSeries.coeff d (mvDeriv ι Φ * Ψ) =
          ∑ p ∈ Finset.HasAntidiagonal.antidiagonal (d + e ι),
            ((p.1 ι : ℕ) : ℂ) * MvPowerSeries.coeff p.1 Φ * MvPowerSeries.coeff p.2 Ψ := by
      intro ι Φ Ψ d
      let S₁ := (Finset.HasAntidiagonal.antidiagonal (d + e ι)).filter (fun p => p.1 ι ≠ 0)
      rw [MvPowerSeries.coeff_mul]
      have hbij :
          (∑ q ∈ Finset.HasAntidiagonal.antidiagonal d,
            MvPowerSeries.coeff q.1 (mvDeriv ι Φ) * MvPowerSeries.coeff q.2 Ψ) =
          ∑ p ∈ S₁,
            ((p.1 ι : ℕ) : ℂ) * MvPowerSeries.coeff p.1 Φ * MvPowerSeries.coeff p.2 Ψ := by
        refine Finset.sum_bij (fun q _ => (q.1 + e ι, q.2)) ?_ ?_ ?_ ?_
        · intro q hq
          rw [Finset.HasAntidiagonal.mem_antidiagonal] at hq
          rw [Finset.mem_filter, Finset.HasAntidiagonal.mem_antidiagonal]
          refine ⟨by rw [← hq]; exact add_right_comm q.1 (e ι) q.2, ?_⟩
          simp [e]
        · rintro ⟨a₁, b₁⟩ _ ⟨a₂, b₂⟩ _ heq
          simp only [Prod.mk.injEq] at heq ⊢
          exact ⟨add_right_cancel heq.1, heq.2⟩
        · rintro ⟨p₁, p₂⟩ hp
          rw [Finset.mem_filter, Finset.HasAntidiagonal.mem_antidiagonal] at hp
          rcases hp with ⟨hp_sum, hp_ne⟩
          dsimp only at hp_ne
          have hsub_add : p₁ - e ι + e ι = p₁ := by
            ext k
            simp only [e, Finsupp.add_apply, Finsupp.tsub_apply, Finsupp.single_apply]
            split_ifs with h
            · subst h; omega
            · omega
          refine ⟨(p₁ - e ι, p₂), ?_, Prod.ext hsub_add rfl⟩
          rw [Finset.HasAntidiagonal.mem_antidiagonal]
          apply add_right_cancel (b := e ι)
          calc (p₁ - e ι + p₂) + e ι = (p₁ - e ι + e ι) + p₂ := add_right_comm _ _ _
            _ = p₁ + p₂ := by rw [hsub_add]
            _ = d + e ι := hp_sum
        · intro q _
          rw [hmv_coeff]
          have hcoord : (q.1 + e ι) ι = q.1 ι + 1 := by simp [e]
          dsimp only
          rw [hcoord, mul_assoc]
      rw [hbij]
      refine Finset.sum_subset (Finset.filter_subset _ _) ?_
      intro p hp hnot
      rw [Finset.mem_filter, not_and, not_not] at hnot
      simp [hnot hp]
    have hmv_mul : ∀ (ι : Fin 2) (Φ Ψ : MvPowerSeries (Fin 2) ℂ),
        mvDeriv ι (Φ * Ψ) = mvDeriv ι Φ * Ψ + Φ * mvDeriv ι Ψ := by
      intro ι Φ Ψ
      ext d
      rw [map_add, hmv_mul_left ι Φ Ψ d, mul_comm Φ (mvDeriv ι Ψ), hmv_mul_left ι Ψ Φ d]
      have hswap :
          (∑ p ∈ Finset.HasAntidiagonal.antidiagonal (d + e ι),
            ((p.1 ι : ℕ) : ℂ) * MvPowerSeries.coeff p.1 Ψ * MvPowerSeries.coeff p.2 Φ) =
          ∑ p ∈ Finset.HasAntidiagonal.antidiagonal (d + e ι),
            ((p.2 ι : ℕ) : ℂ) * MvPowerSeries.coeff p.1 Φ * MvPowerSeries.coeff p.2 Ψ := by
        refine Finset.sum_bij (fun p _ => (p.2, p.1)) ?_ ?_ ?_ ?_
        · intro p hp
          rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp ⊢
          rw [add_comm, hp]
        · rintro ⟨a₁, b₁⟩ _ ⟨a₂, b₂⟩ _ heq
          simpa [Prod.mk.injEq, and_comm] using heq
        · rintro ⟨p₁, p₂⟩ hp
          refine ⟨(p₂, p₁), ?_, rfl⟩
          rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp ⊢
          rw [add_comm, hp]
        · intro p _; ring
      rw [hswap, ← Finset.sum_add_distrib, hmv_coeff, MvPowerSeries.coeff_mul, Finset.mul_sum]
      refine Finset.sum_congr rfl ?_
      intro p hp
      rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp
      have hcoord : p.1 ι + p.2 ι = d ι + 1 := by
        have hc := congr_arg (fun x => x ι) hp
        simpa [e, Finsupp.add_apply] using hc
      have hcast : ((p.1 ι : ℕ) : ℂ) + ((p.2 ι : ℕ) : ℂ) = ((d ι + 1 : ℕ) : ℂ) := by
        exact_mod_cast hcoord
      rw [← hcast]
      ring
    have hmv_one : ∀ ι : Fin 2, mvDeriv ι 1 = 0 := by
      intro ι
      ext d
      have hne : d + e ι ≠ 0 := by
        intro h0
        have hc := congr_arg (fun x => x ι) h0
        simp [e] at hc
      rw [hmv_coeff, map_zero, MvPowerSeries.coeff_one]
      simp [hne]
    have hmv_pow : ∀ (ι : Fin 2) (Ψ : MvPowerSeries (Fin 2) ℂ) (k : ℕ),
        mvDeriv ι (Ψ ^ (k + 1)) = ((k + 1 : ℕ) : ℂ) • (mvDeriv ι Ψ * Ψ ^ k) := by
      intro ι Ψ k
      induction k with
      | zero => simp
      | succ k ih =>
        rw [pow_succ Ψ (k + 1), hmv_mul, ih, smul_mul_assoc, mul_assoc, ← pow_succ,
          mul_comm (Ψ ^ (k + 1)) (mvDeriv ι Ψ)]
        have hcast : ((k + 1 + 1 : ℕ) : ℂ) = ((k + 1 : ℕ) : ℂ) + 1 := by push_cast; ring
        rw [hcast, add_smul, one_smul]
    have hpow_vanish : ∀ {Ψ : MvPowerSeries (Fin 2) ℂ}, MvPowerSeries.coeff 0 Ψ = 0 →
        ∀ (m : ℕ) (d : Fin 2 →₀ ℕ), d 0 + d 1 < m → MvPowerSeries.coeff d (Ψ ^ m) = 0 := by
      intro Ψ hΨ0 m
      induction m with
      | zero => intro d hd; omega
      | succ m ih =>
        intro d hd
        rw [pow_succ, MvPowerSeries.coeff_mul]
        refine Finset.sum_eq_zero ?_
        intro p hp
        rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp
        by_cases hp2 : p.2 = 0
        · rw [hp2, hΨ0, mul_zero]
        · have hp2_pos : 1 ≤ p.2 0 + p.2 1 := by
            have hne0 : p.2 0 + p.2 1 ≠ 0 := mt (hdeg_zero_iff p.2).mpr hp2
            omega
          have hsum_deg := hdeg_add p.1 p.2
          rw [hp] at hsum_deg
          rw [ih p.1 (by omega), zero_mul]
    have hmv_comp : ∀ (ι : Fin 2) (f : PowerSeries ℂ) (Ψ : MvPowerSeries (Fin 2) ℂ),
        MvPowerSeries.coeff 0 Ψ = 0 →
        mvDeriv ι (compPowerSeries2D f Ψ) =
          mvDeriv ι Ψ * compPowerSeries2D (PowerSeries.derivative f) Ψ := by
      intro ι f Ψ hΨ0
      ext d
      let N : ℕ := d 0 + d 1
      have hdeg_e : (d + e ι) 0 + (d + e ι) 1 = N + 1 := hdeg_single ι d
      have hlhs : MvPowerSeries.coeff d (mvDeriv ι (compPowerSeries2D f Ψ)) =
          ∑ m ∈ Finset.range (N + 2),
            PowerSeries.coeff m f * MvPowerSeries.coeff d (mvDeriv ι (Ψ ^ m)) := by
        rw [hmv_coeff, hcomp_coeff, hdeg_e, Finset.mul_sum]
        refine Finset.sum_congr rfl (fun m _ => ?_)
        rw [hmv_coeff]
        ring
      rw [hlhs, Finset.sum_range_succ']
      have hterm0 : PowerSeries.coeff 0 f * MvPowerSeries.coeff d (mvDeriv ι (Ψ ^ 0)) = 0 := by
        rw [pow_zero, hmv_one ι, map_zero, mul_zero]
      rw [hterm0, add_zero]
      have hstep_sum :
          (∑ k ∈ Finset.range (N + 1),
            PowerSeries.coeff (k + 1) f * MvPowerSeries.coeff d (mvDeriv ι (Ψ ^ (k + 1)))) =
          ∑ k ∈ Finset.range (N + 1),
            ∑ p ∈ Finset.HasAntidiagonal.antidiagonal d,
              MvPowerSeries.coeff p.1 (mvDeriv ι Ψ) *
                (PowerSeries.coeff k (PowerSeries.derivative f) * MvPowerSeries.coeff p.2 (Ψ ^ k)) := by
        refine Finset.sum_congr rfl ?_
        intro k _
        rw [hmv_pow ι Ψ k, map_smul, smul_eq_mul, MvPowerSeries.coeff_mul,
          PowerSeries.coeff_derivative]
        push_cast
        rw [Finset.mul_sum, Finset.mul_sum]
        refine Finset.sum_congr rfl (fun p _ => by ring)
      rw [hstep_sum, Finset.sum_comm, MvPowerSeries.coeff_mul]
      refine Finset.sum_congr rfl ?_
      intro p hp
      rw [← Finset.mul_sum, hcomp_coeff]
      congr 1
      symm
      refine Finset.sum_subset ?_ ?_
      · intro k hk
        rw [Finset.HasAntidiagonal.mem_antidiagonal] at hp
        have hsum_deg := hdeg_add p.1 p.2
        rw [hp] at hsum_deg
        rw [Finset.mem_range] at hk ⊢
        omega
      · intro k _ hk_not
        rw [Finset.mem_range, not_lt] at hk_not
        rw [hpow_vanish hΨ0 k p.2 (by omega), mul_zero]
    have hmv_leib : ∀ Φ Ψ : MvPowerSeries (Fin 2) ℂ,
        mvDerivA (Φ + Ψ) = mvDerivA Φ + mvDerivA Ψ ∧
        mvDerivD (Φ + Ψ) = mvDerivD Φ + mvDerivD Ψ ∧
        mvDerivA (Φ * Ψ) = mvDerivA Φ * Ψ + Φ * mvDerivA Ψ ∧
        mvDerivD (Φ * Ψ) = mvDerivD Φ * Ψ + Φ * mvDerivD Ψ :=
      fun Φ Ψ => ⟨hmv_add 0 Φ Ψ, hmv_add 1 Φ Ψ, hmv_mul 0 Φ Ψ, hmv_mul 1 Φ Ψ⟩
    have hmv_comp_AD : ∀ (f : PowerSeries ℂ) (Ψ : MvPowerSeries (Fin 2) ℂ),
        MvPowerSeries.coeff 0 Ψ = 0 →
        mvDerivA (compPowerSeries2D f Ψ) =
          mvDerivA Ψ * compPowerSeries2D (PowerSeries.derivative f) Ψ ∧
        mvDerivD (compPowerSeries2D f Ψ) =
          mvDerivD Ψ * compPowerSeries2D (PowerSeries.derivative f) Ψ :=
      fun f Ψ hΨ0 => ⟨hmv_comp 0 f Ψ hΨ0, hmv_comp 1 f Ψ hΨ0⟩
    let e₀ : Fin 2 →₀ ℕ := e 0
    let e₁ : Fin 2 →₀ ℕ := e 1
    have hmvA_coeff : ∀ (Φ : MvPowerSeries (Fin 2) ℂ) (d : Fin 2 →₀ ℕ),
        MvPowerSeries.coeff d (mvDerivA Φ) =
          ((d 0 + 1 : ℕ) : ℂ) * MvPowerSeries.coeff (d + e₀) Φ := fun _ _ => rfl
    have hmvD_coeff : ∀ (Φ : MvPowerSeries (Fin 2) ℂ) (d : Fin 2 →₀ ℕ),
        MvPowerSeries.coeff d (mvDerivD Φ) =
          ((d 1 + 1 : ℕ) : ℂ) * MvPowerSeries.coeff (d + e₁) Φ := fun _ _ => rfl
    have hslice_at : ∀ {U : Set (ℂ × ℂ)}, IsOpen U → ∀ {f : ℂ × ℂ → ℂ},
        DifferentiableOn ℂ f U → ∀ q ∈ U,
        DifferentiableAt ℂ (fun z => f (z, q.2)) q.1 ∧
        DifferentiableAt ℂ (fun w => f (q.1, w)) q.2 := by
      intro U hU f hf q hq
      have hfq : DifferentiableAt ℂ f q := hf.differentiableAt (hU.mem_nhds hq)
      exact ⟨hfq.comp q.1 (differentiableAt_id.prodMk (differentiableAt_const q.2)),
        hfq.comp q.2 ((differentiableAt_const q.1).prodMk differentiableAt_id)⟩
    have hmv_taylor : ∀ {U : Set (ℂ × ℂ)}, IsOpen U → ∀ {p₀ : ℂ × ℂ}, p₀ ∈ U →
        ∀ {f : ℂ × ℂ → ℂ}, DifferentiableOn ℂ f U →
          mvDerivA (taylor2D f p₀) = taylor2D (pderivA f) p₀ ∧
          mvDerivD (taylor2D f p₀) = taylor2D (pderivD f) p₀ := by
      intro U hU p₀ hp₀ f hf
      constructor
      · ext d
        rw [hmvA_coeff, htaylor_coeff, htaylor_coeff]
        have hd0 : (d + e₀) 0 = d 0 + 1 := by simp [e₀, e]
        have hd1 : (d + e₀) 1 = d 1 := by simp [e₀, e]
        rw [hd0, hd1, (hiterYT_step hU hf (d 0) (d 1) p₀ hp₀).1, Nat.factorial_succ (d 0), Nat.cast_mul]
        have hc : ((d 0 + 1 : ℕ) : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.succ_ne_zero _)
        have hf0 : ((d 0).factorial : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)
        have hf1 : ((d 1).factorial : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)
        field_simp
      · ext d
        rw [hmvD_coeff, htaylor_coeff, htaylor_coeff]
        have hd0 : (d + e₁) 0 = d 0 := by simp [e₁, e]
        have hd1 : (d + e₁) 1 = d 1 + 1 := by simp [e₁, e]
        rw [hd0, hd1, (hiterYT_step hU hf (d 0) (d 1) p₀ hp₀).2, Nat.factorial_succ (d 1), Nat.cast_mul]
        have hc : ((d 1 + 1 : ℕ) : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.succ_ne_zero _)
        have hf0 : ((d 0).factorial : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)
        have hf1 : ((d 1).factorial : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)
        field_simp
    have hcoeff_step : ∀ {Φ Ψ : MvPowerSeries (Fin 2) ℂ} {N : ℕ} {d : Fin 2 →₀ ℕ},
        d 0 + d 1 = N + 1 →
        (∀ d' : Fin 2 →₀ ℕ, d' 0 + d' 1 = N →
          MvPowerSeries.coeff d' (mvDerivA Φ) = MvPowerSeries.coeff d' (mvDerivA Ψ) ∧
          MvPowerSeries.coeff d' (mvDerivD Φ) = MvPowerSeries.coeff d' (mvDerivD Ψ)) →
        MvPowerSeries.coeff d Φ = MvPowerSeries.coeff d Ψ := by
      intro Φ Ψ N d hd heq
      by_cases hd0 : d 0 = 0
      · let d' : Fin 2 →₀ ℕ := d - e₁
        have hd'_add : d' + e₁ = d := by
          ext i
          simp only [d', e₁, e, Finsupp.add_apply, Finsupp.tsub_apply]
          (fin_cases i <;> simp); omega
        have hd'_deg : d' 0 + d' 1 = N := by
          have hsum := congr_arg (fun x : Fin 2 →₀ ℕ => x 0 + x 1) hd'_add
          simp only [e₁, e, Finsupp.add_apply, Finsupp.single_eq_same] at hsum
          have : (Finsupp.single (1 : Fin 2) (1 : ℕ)) 0 = 0 := by simp
          omega
        have hD := (heq d' hd'_deg).2
        rw [hmvD_coeff, hmvD_coeff, hd'_add] at hD
        have hne : ((d' 1 + 1 : ℕ) : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.succ_ne_zero _)
        exact mul_left_cancel₀ hne hD
      · let d' : Fin 2 →₀ ℕ := d - e₀
        have hd'_add : d' + e₀ = d := by
          ext i
          simp only [d', e₀, e, Finsupp.add_apply, Finsupp.tsub_apply]
          (fin_cases i <;> simp); omega
        have hd'_deg : d' 0 + d' 1 = N := by
          have hsum := congr_arg (fun x : Fin 2 →₀ ℕ => x 0 + x 1) hd'_add
          simp only [e₀, e, Finsupp.add_apply, Finsupp.single_eq_same] at hsum
          have : (Finsupp.single (0 : Fin 2) (1 : ℕ)) 1 = 0 := by simp
          omega
        have hA := (heq d' hd'_deg).1
        rw [hmvA_coeff, hmvA_coeff, hd'_add] at hA
        have hne : ((d' 0 + 1 : ℕ) : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.succ_ne_zero _)
        exact mul_left_cancel₀ hne hA
    have htaylor_add : ∀ {U : Set (ℂ × ℂ)}, IsOpen U → ∀ {p₀ : ℂ × ℂ}, p₀ ∈ U →
        ∀ {f g : ℂ × ℂ → ℂ}, DifferentiableOn ℂ f U → DifferentiableOn ℂ g U →
          taylor2D (fun p => f p + g p) p₀ = taylor2D f p₀ + taylor2D g p₀ := by
      intro U hU p₀ hp₀
      have hind : ∀ (N : ℕ) {f g : ℂ × ℂ → ℂ}, DifferentiableOn ℂ f U → DifferentiableOn ℂ g U →
          ∀ d : Fin 2 →₀ ℕ, d 0 + d 1 ≤ N →
            MvPowerSeries.coeff d (taylor2D (fun p => f p + g p) p₀) =
              MvPowerSeries.coeff d (taylor2D f p₀ + taylor2D g p₀) := by
        intro N
        induction N with
        | zero =>
          intro f g _ _ d hd
          have hd0 : d = 0 := (hdeg_zero_iff d).mpr (by omega)
          subst hd0
          rw [map_add, htaylor_coeff, htaylor_coeff, htaylor_coeff]
          simp [iterDerivYT, iterDerivY]
        | succ N ih =>
          intro f g hf hg d hd
          by_cases hle : d 0 + d 1 ≤ N
          · exact ih hf hg d hle
          · refine hcoeff_step (N := N) (by omega) ?_
            intro d' hd'
            have hfg : DifferentiableOn ℂ (fun p => f p + g p) U := hf.add hg
            have hpA_add : ∀ q ∈ U, pderivA (fun p => f p + g p) q = pderivA f q + pderivA g q :=
              fun q hq => ((hslice_at hU hf q hq).1.hasDerivAt.add (hslice_at hU hg q hq).1.hasDerivAt).deriv
            have hpD_add : ∀ q ∈ U, pderivD (fun p => f p + g p) q = pderivD f q + pderivD g q :=
              fun q hq => ((hslice_at hU hf q hq).2.hasDerivAt.add (hslice_at hU hg q hq).2.hasDerivAt).deriv
            constructor
            · rw [(hmv_taylor hU hp₀ hfg).1, htaylor2D_congr hU hp₀ hpA_add,
                (hmv_leib _ _).1, (hmv_taylor hU hp₀ hf).1, (hmv_taylor hU hp₀ hg).1]
              exact ih (hpderiv_holo hU hf).1 (hpderiv_holo hU hg).1 d' (le_of_eq hd')
            · rw [(hmv_taylor hU hp₀ hfg).2, htaylor2D_congr hU hp₀ hpD_add,
                (hmv_leib _ _).2.1, (hmv_taylor hU hp₀ hf).2, (hmv_taylor hU hp₀ hg).2]
              exact ih (hpderiv_holo hU hf).2 (hpderiv_holo hU hg).2 d' (le_of_eq hd')
      intro f g hf hg
      ext d
      exact hind (d 0 + d 1) hf hg d le_rfl
    have htaylor_mul : ∀ {U : Set (ℂ × ℂ)}, IsOpen U → ∀ {p₀ : ℂ × ℂ}, p₀ ∈ U →
        ∀ {f g : ℂ × ℂ → ℂ}, DifferentiableOn ℂ f U → DifferentiableOn ℂ g U →
          taylor2D (fun p => f p * g p) p₀ = taylor2D f p₀ * taylor2D g p₀ := by
      intro U hU p₀ hp₀
      have hind : ∀ (N : ℕ) {f g : ℂ × ℂ → ℂ}, DifferentiableOn ℂ f U → DifferentiableOn ℂ g U →
          ∀ d : Fin 2 →₀ ℕ, d 0 + d 1 ≤ N →
            MvPowerSeries.coeff d (taylor2D (fun p => f p * g p) p₀) =
              MvPowerSeries.coeff d (taylor2D f p₀ * taylor2D g p₀) := by
        intro N
        induction N with
        | zero =>
          intro f g _ _ d hd
          have hd0 : d = 0 := (hdeg_zero_iff d).mpr (by omega)
          subst hd0
          rw [MvPowerSeries.coeff_zero_eq_constantCoeff, map_mul,
            ← MvPowerSeries.coeff_zero_eq_constantCoeff,
            htaylor_coeff, htaylor_coeff, htaylor_coeff]
          simp [iterDerivYT, iterDerivY]
        | succ N ih =>
          intro f g hf hg d hd
          by_cases hle : d 0 + d 1 ≤ N
          · exact ih hf hg d hle
          · refine hcoeff_step (N := N) (by omega) ?_
            intro d' hd'
            obtain ⟨hfA, hfD⟩ := hpderiv_holo hU hf
            obtain ⟨hgA, hgD⟩ := hpderiv_holo hU hg
            have hfg : DifferentiableOn ℂ (fun p => f p * g p) U := hf.mul hg
            have hfAg : DifferentiableOn ℂ (fun p => pderivA f p * g p) U := hfA.mul hg
            have hfgA : DifferentiableOn ℂ (fun p => f p * pderivA g p) U := hf.mul hgA
            have hfDg : DifferentiableOn ℂ (fun p => pderivD f p * g p) U := hfD.mul hg
            have hfgD : DifferentiableOn ℂ (fun p => f p * pderivD g p) U := hf.mul hgD
            have hpA_mul : ∀ q ∈ U,
                pderivA (fun p => f p * g p) q = pderivA f q * g q + f q * pderivA g q :=
              fun q hq => ((hslice_at hU hf q hq).1.hasDerivAt.mul (hslice_at hU hg q hq).1.hasDerivAt).deriv
            have hpD_mul : ∀ q ∈ U,
                pderivD (fun p => f p * g p) q = pderivD f q * g q + f q * pderivD g q :=
              fun q hq => ((hslice_at hU hf q hq).2.hasDerivAt.mul (hslice_at hU hg q hq).2.hasDerivAt).deriv
            constructor
            · rw [(hmv_taylor hU hp₀ hfg).1, htaylor2D_congr hU hp₀ hpA_mul,
                htaylor_add hU hp₀ hfAg hfgA,
                (hmv_leib _ _).2.2.1, (hmv_taylor hU hp₀ hf).1, (hmv_taylor hU hp₀ hg).1,
                map_add, map_add, ih hfA hg d' (le_of_eq hd'), ih hf hgA d' (le_of_eq hd')]
            · rw [(hmv_taylor hU hp₀ hfg).2, htaylor2D_congr hU hp₀ hpD_mul,
                htaylor_add hU hp₀ hfDg hfgD,
                (hmv_leib _ _).2.2.2, (hmv_taylor hU hp₀ hf).2, (hmv_taylor hU hp₀ hg).2,
                map_add, map_add, ih hfD hg d' (le_of_eq hd'), ih hf hgD d' (le_of_eq hd')]
      intro f g hf hg
      ext d
      exact hind (d 0 + d 1) hf hg d le_rfl
    refine ⟨hmv_taylor, htaylor_mul, ?_⟩
    intro U W_ψ hU hW_ψ p₀ hp₀ ψ g₀ hψ hg₀ hmaps
    let Ψ : MvPowerSeries (Fin 2) ℂ := centeredTaylor2D ψ p₀
    have hΨ0 : MvPowerSeries.coeff 0 Ψ = 0 := by
      change MvPowerSeries.coeff 0 (taylor2D (fun p => ψ p - ψ p₀) p₀) = 0
      rw [htaylor_coeff]
      simp [iterDerivYT, iterDerivY]
    have hΨ_sub_holo : DifferentiableOn ℂ (fun p => ψ p - ψ p₀) U :=
      hψ.sub (differentiableOn_const (ψ p₀))
    have hΨ_dA : mvDerivA Ψ = taylor2D (pderivA ψ) p₀ := by
      change mvDerivA (taylor2D (fun p => ψ p - ψ p₀) p₀) = _
      rw [(hmv_taylor hU hp₀ hΨ_sub_holo).1]
      exact htaylor2D_congr hU hp₀ (fun q _ => deriv_sub_const (f := fun z => ψ (z, q.2)) (ψ p₀))
    have hΨ_dD : mvDerivD Ψ = taylor2D (pderivD ψ) p₀ := by
      change mvDerivD (taylor2D (fun p => ψ p - ψ p₀) p₀) = _
      rw [(hmv_taylor hU hp₀ hΨ_sub_holo).2]
      exact htaylor2D_congr hU hp₀ (fun q _ => deriv_sub_const (f := fun w => ψ (q.1, w)) (ψ p₀))
    have hderiv_holo1D : ∀ (h : ℂ → ℂ) (w₀ : ℂ),
        PowerSeries.derivative (holoTaylor1D h w₀) = holoTaylor1D (deriv h) w₀ := by
      intro h w₀
      ext m
      rw [PowerSeries.coeff_derivative, holoTaylor1D, holoTaylor1D,
        PowerSeries.coeff_mk, PowerSeries.coeff_mk, iteratedDeriv_succ',
        Nat.factorial_succ, Nat.cast_mul]
      have hc1 : ((m : ℂ) + 1) ≠ 0 := by exact_mod_cast Nat.succ_ne_zero m
      have hc2 : (m.factorial : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero m)
      push_cast
      field_simp
    have hind : ∀ (N : ℕ) {g : ℂ → ℂ}, DifferentiableOn ℂ g W_ψ →
        ∀ d : Fin 2 →₀ ℕ, d 0 + d 1 ≤ N →
          MvPowerSeries.coeff d (taylor2D (fun p => g (ψ p)) p₀) =
            MvPowerSeries.coeff d (compPowerSeries2D (holoTaylor1D g (ψ p₀)) Ψ) := by
      intro N
      induction N with
      | zero =>
        intro g _ d hd
        have hd0 : d = 0 := (hdeg_zero_iff d).mpr (by omega)
        subst hd0
        rw [htaylor_coeff, hcomp_coeff]
        simp [iterDerivYT, iterDerivY, holoTaylor1D]
      | succ N ih =>
        intro g hg d hd
        by_cases hle : d 0 + d 1 ≤ N
        · exact ih hg d hle
        · refine hcoeff_step (N := N) (by omega) ?_
          intro d' hd'
          obtain ⟨hψA, hψD⟩ := hpderiv_holo hU hψ
          have hg' : DifferentiableOn ℂ (deriv g) W_ψ := hg.deriv hW_ψ
          have hgψ_holo : DifferentiableOn ℂ (fun p => g (ψ p)) U :=
            hg.comp hψ (fun p hp => hmaps p hp)
          have hg'ψ_holo : DifferentiableOn ℂ (fun p => deriv g (ψ p)) U :=
            hg'.comp hψ (fun p hp => hmaps p hp)
          have hpA_comp : ∀ q ∈ U,
              pderivA (fun p => g (ψ p)) q = pderivA ψ q * deriv g (ψ q) := by
            intro q hq
            have hgat : DifferentiableAt ℂ g (ψ q) :=
              hg.differentiableAt (hW_ψ.mem_nhds (hmaps q hq))
            have hdc := deriv_comp q.1 hgat (hslice_at hU hψ q hq).1
            simpa [pderivA, Function.comp_def, mul_comm] using hdc
          have hpD_comp : ∀ q ∈ U,
              pderivD (fun p => g (ψ p)) q = pderivD ψ q * deriv g (ψ q) := by
            intro q hq
            have hgat : DifferentiableAt ℂ g (ψ q) :=
              hg.differentiableAt (hW_ψ.mem_nhds (hmaps q hq))
            have hdc := deriv_comp q.2 hgat (hslice_at hU hψ q hq).2
            simpa [pderivD, Function.comp_def, mul_comm] using hdc
          have hdeg_le_right : ∀ r ∈ Finset.HasAntidiagonal.antidiagonal d',
              r.2 0 + r.2 1 ≤ N := by
            intro r hr
            rw [Finset.HasAntidiagonal.mem_antidiagonal] at hr
            have hsum := congr_arg (fun x : Fin 2 →₀ ℕ => x 0 + x 1) hr
            simp only [Finsupp.add_apply] at hsum
            omega
          constructor
          · rw [(hmv_taylor hU hp₀ hgψ_holo).1, htaylor2D_congr hU hp₀ hpA_comp,
              htaylor_mul hU hp₀ hψA hg'ψ_holo,
              (hmv_comp_AD (holoTaylor1D g (ψ p₀)) Ψ hΨ0).1, hΨ_dA, hderiv_holo1D g (ψ p₀),
