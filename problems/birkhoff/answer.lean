        have hm := hHolo_mul (hdy_edge_tay i_R).1 (hdy_tay i_R.castSucc).1
        have ha := hHolo_add (hdx_tay i_R).1 hm.1
        exact ⟨ha.1, by rw [ha.2, (hdx_tay i_R).2, hm.2, (hdy_edge_tay i_R).2, (hdy_tay i_R.castSucc).2]⟩
      have hev_grad :
