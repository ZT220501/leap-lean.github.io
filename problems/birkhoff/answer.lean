                    norm_pos_iff.mpr (h_ne_on_reg _ (h_walk_in_reg om 0).1)
                  have hy0_le : ‖walkPos ρ om 0 - q‖ ≤ R + 1 := by
                    have h_tri : ‖(om 0 : ℂ) - q‖ ≤ ‖(om 0 : ℂ)‖ + ‖q‖ := norm_sub_le _ _
                    have hom0 : ‖(om 0 : ℂ)‖ ≤ 2 * Real.pi := by
                      rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hA.1]
                      exact le_of_lt hA.2
                    dsimp only [walkPos, R]
                    linarith [hR_nat0]
                  have hlog : L_q (walkPos ρ om 0) ≤ M_up := Real.log_le_log hy0_ne hy0_le
                  linarith
                · rw [hZ0_eq, Set.indicator_of_notMem hA]
              · rintro ⟨hA, _, ⟨m, hm0, hlt⟩⟩
                have hm_eq : m = 0 := Nat.eq_zero_of_le_zero hm0
                subst hm_eq
                rw [hZ0_eq, Set.indicator_of_mem hA]
                linarith
          | succ k ih =>
              intro om
              rcases ih om with ⟨ih_act, ih_nonneg, ih_cross⟩
              have hZ_succ : Z (k + 1) om = Z k om +
                  (KeepGoing k).indicator
                    (fun om' => L_q (walkPos ρ om' k) - L_q (walkPos ρ om' (k + 1))) om := rfl
              have h_act_succ : (om ∈ A₀ ∧ ∀ j < k + 1, om ∈ stepOK j) →
                  Z (k + 1) om = M_up - L_q (walkPos ρ om (k + 1)) := by
                rintro ⟨hA, hj⟩
                have h_in_keep : om ∈ KeepGoing k :=
                  (hKeep_iff k om).mpr ⟨hA, fun j hle => hj j (Nat.lt_succ_of_le hle)⟩
                have hZk := ih_act ⟨hA, fun j hlt => hj j (Nat.lt_succ_of_lt hlt)⟩
                rw [hZ_succ, Set.indicator_of_mem h_in_keep, hZk]
                ring
              refine ⟨h_act_succ, ?_, ?_⟩
              · rcases Classical.em (om ∈ KeepGoing k) with h_in_keep | h_in_keep
                · rcases (hKeep_iff k om).mp h_in_keep with ⟨hA, hj⟩
                  have hZk1 := h_act_succ ⟨hA, fun j hlt => hj j (Nat.le_of_lt_succ hlt)⟩
                  rw [hZk1]
                  have hyk_R : ‖walkPos ρ om k - q‖ ≤ R := (hj k le_rfl).1
                  have hρ1 : ρ (walkPos ρ om k) ≤ 1 :=
                    le_trans (h_reg_ball _ (h_walk_in_reg om k).1).1 (by norm_num)
                  have hyk1_le : ‖walkPos ρ om (k + 1) - q‖ ≤ R + 1 := by
                    have h_tri : ‖walkPos ρ om (k + 1) - q‖ ≤
                        ‖walkPos ρ om k - q‖ + ‖walkPos ρ om (k + 1) - walkPos ρ om k‖ := by
                      simpa using norm_add_le (walkPos ρ om k - q)
                        (walkPos ρ om (k + 1) - walkPos ρ om k)
                    have h_st : ‖walkPos ρ om (k + 1) - walkPos ρ om k‖ = ρ (walkPos ρ om k) := by
                      rw [h_walk_step_eq, h_circleMap_norm _ _ _ (hAdm.nonneg _)]
                    linarith
                  have hyk1_pos : 0 < ‖walkPos ρ om (k + 1) - q‖ :=
                    norm_pos_iff.mpr (h_ne_on_reg _ (h_walk_in_reg om (k + 1)).1)
                  have hlog : L_q (walkPos ρ om (k + 1)) ≤ M_up :=
                    Real.log_le_log hyk1_pos hyk1_le
                  linarith
                · rw [hZ_succ, Set.indicator_of_notMem h_in_keep, add_zero]
                  exact ih_nonneg
              · rintro ⟨hA, hj_R, ⟨m, hm_le, hm_lt⟩⟩
                by_cases h_prev : ∃ m' ≤ k, L_q (walkPos ρ om m') < -B₁
                · rcases h_prev with ⟨m', hm'_le, hm'_lt⟩
                  have h_not_keep : om ∉ KeepGoing k := by
                    intro h_in
                    have h_ok := ((hKeep_iff k om).mp h_in).2 m' hm'_le
                    linarith [h_ok.2]
                  rw [hZ_succ, Set.indicator_of_notMem h_not_keep, add_zero]
                  exact ih_cross ⟨hA, fun j hjk => hj_R j (Nat.le_succ_of_le hjk),
                    ⟨m', hm'_le, hm'_lt⟩⟩
                · have h_all_ok : ∀ j < k + 1, om ∈ stepOK j := by
                    intro j hj_lt
                    have hj_le : j ≤ k := Nat.le_of_lt_succ hj_lt
                    refine ⟨hj_R j (Nat.le_succ_of_le hj_le), ?_⟩
                    by_contra h_neg
                    exact h_prev ⟨j, hj_le, lt_of_not_ge h_neg⟩
                  have hm_eq : m = k + 1 := by
                    rcases Nat.of_le_succ hm_le with hmk | rfl
                    · exact False.elim (h_prev ⟨m, hmk, hm_lt⟩)
                    · rfl
                  subst hm_eq
                  rw [h_act_succ ⟨hA, h_all_ok⟩]
                  linarith
        have hZ_int_and_exp : ∀ k : ℕ,
            MeasureTheory.Integrable (Z k) walkMeasure ∧
            (∫ om, Z k om ∂walkMeasure) ≤ M_up + C₀ := by
          intro k
          induction k with
          | zero =>
              have hZ0_meas : Measurable (Z 0) :=
                (measurable_const.sub (hLq_meas.comp (h_walk_meas 0))).indicator hA₀_meas
              have hZ0_bd : ∀ om : WalkSpace, ‖Z 0 om‖ ≤ M_up + B_col 0 := by
                intro om
                rw [Real.norm_eq_abs, hZ0_eq]
                by_cases hA : om ∈ A₀
                · rw [Set.indicator_of_mem hA]
                  have h1 := hB_col_le 0 _ (h_walk_in_col 0 om hA)
                  rw [abs_le] at h1 ⊢
                  exact ⟨by linarith [hM_up_pos, hB_col_nonneg 0], by linarith [hM_up_pos]⟩
                · rw [Set.indicator_of_notMem hA, abs_zero]
                  linarith [hM_up_pos, hB_col_nonneg 0]
              have hZ0_int : MeasureTheory.Integrable (Z 0) walkMeasure :=
                MeasureTheory.Integrable.of_bound hZ0_meas.aestronglyMeasurable
                  (M_up + B_col 0) (Filter.Eventually.of_forall hZ0_bd)
              refine ⟨hZ0_int, ?_⟩
              have hZ0_le : ∀ om : WalkSpace, Z 0 om ≤ M_up + C₀ := by
                intro om
                rw [hZ0_eq]
                by_cases hA : om ∈ A₀
                · rw [Set.indicator_of_mem hA]
                  dsimp only [walkPos]
                  linarith [hLq_real_lb (om 0)]
                · rw [Set.indicator_of_notMem hA]
                  linarith [hM_up_pos, hC₀_nonneg]
              calc ∫ om, Z 0 om ∂walkMeasure
                _ ≤ ∫ _ : WalkSpace, (M_up + C₀) ∂walkMeasure :=
                    MeasureTheory.integral_mono hZ0_int (MeasureTheory.integrable_const _) hZ0_le
                _ = M_up + C₀ := h_int_const _
          | succ k ih =>
              have hH_meas : @Measurable WalkSpace ℝ (prefSigma k) _
                  ((KeepGoing k).indicator 1) :=
                Measurable.indicator (m := prefSigma k) measurable_const (hKeep_pref k)
              have hΦ_cont : ContinuousOn (Function.uncurry (fun y w : ℂ => L_q y - L_q w))
                  (Ω_reg ×ˢ Ω_reg) :=
                (hLq_cont.comp continuousOn_fst (fun _ hp => hp.1)).sub
                  (hLq_cont.comp continuousOn_snd (fun _ hp => hp.2))
              have hΦ_bd : ∀ om : WalkSpace, ∀ θ : ℝ,
                  |(KeepGoing k).indicator (1 : WalkSpace → ℝ) om *
                    (L_q (walkPos ρ om k) -
                      L_q (circleMap (walkPos ρ om k) (ρ (walkPos ρ om k)) θ))| ≤
                  B_col k + B_col (k + 1) := by
                intro om θ
                rcases Classical.em (om ∈ KeepGoing k) with h_in | h_in
                · have hA : om ∈ A₀ := ((hKeep_iff k om).mp h_in).1
                  have hy_col : walkPos ρ om k ∈ K_col k := h_walk_in_col k om hA
                  have hw_col : circleMap (walkPos ρ om k) (ρ (walkPos ρ om k)) θ ∈
                      K_col (k + 1) :=
                    hK_col_step k _ _ hy_col
                      (le_of_eq (h_circleMap_norm _ _ _ (hAdm.nonneg _)))
                  have h1 := hB_col_le k _ hy_col
                  have h2 := hB_col_le (k + 1) _ hw_col
                  simp only [Set.indicator_of_mem h_in, Pi.one_apply, one_mul]
                  rw [abs_le] at h1 h2 ⊢
                  exact ⟨by linarith, by linarith⟩
                · simp only [Set.indicator_of_notMem h_in, zero_mul, abs_zero]
                  linarith [hB_col_nonneg k, hB_col_nonneg (k + 1)]
              have h_inc := h_step_exp k ((KeepGoing k).indicator 1)
                (fun y w => L_q y - L_q w) (B_col k + B_col (k + 1))
                hH_meas hΦ_cont hΦ_bd
              have h_inc_eq : ∀ om : WalkSpace,
                  (KeepGoing k).indicator
                    (fun om' => L_q (walkPos ρ om' k) - L_q (walkPos ρ om' (k + 1))) om =
                  (KeepGoing k).indicator 1 om *
                    (L_q (walkPos ρ om k) - L_q (walkPos ρ om (k + 1))) :=
                fun om => h_ind_mul (KeepGoing k) _ om
              have h_inc_int : MeasureTheory.Integrable
                  (fun om : WalkSpace => (KeepGoing k).indicator
                    (fun om' => L_q (walkPos ρ om' k) - L_q (walkPos ρ om' (k + 1))) om)
                  walkMeasure := by
                simpa only [← h_inc_eq] using h_inc.1
              have h_inc_zero : (∫ om, (KeepGoing k).indicator
                  (fun om' => L_q (walkPos ρ om' k) - L_q (walkPos ρ om' (k + 1))) om
                  ∂walkMeasure) = 0 := by
                simp_rw [h_inc_eq]
                rw [h_inc.2.2]
                have h_pt : ∀ om : WalkSpace,
                    Real.circleAverage (fun w => L_q (walkPos ρ om k) - L_q w)
                      (walkPos ρ om k) (ρ (walkPos ρ om k)) = 0 := by
                  intro om
                  let y₀ := walkPos ρ om k
                  have hy₀ : y₀ ∈ Ω_reg := (h_walk_in_reg om k).1
                  let r := ρ y₀
                  have hr : 0 < r := (h_walk_in_reg om k).2
                  have hball_sub : Metric.closedBall y₀ r ⊆ Ω_reg := (h_reg_ball y₀ hy₀).2.2.2
                  have hc_Lq : CircleIntegrable L_q y₀ r :=
                    ((hLq_cont.mono hball_sub).mono
                      Metric.sphere_subset_closedBall).circleIntegrable hr.le
                  change Real.circleAverage ((fun _ => L_q y₀) - L_q) y₀ r = 0
                  rw [Real.circleAverage_sub (circleIntegrable_const _ _ _) hc_Lq,
                    Real.circleAverage_const, hLq_cavg y₀ hy₀, sub_self]
                simp [h_pt]
              have hZ_succ_eq : Z (k + 1) = fun om => Z k om +
                  (KeepGoing k).indicator
                    (fun om' => L_q (walkPos ρ om' k) - L_q (walkPos ρ om' (k + 1))) om := rfl
              rw [hZ_succ_eq]
              refine ⟨ih.1.add h_inc_int, ?_⟩
              rw [MeasureTheory.integral_add ih.1 h_inc_int, h_inc_zero, add_zero]
              exact ih.2
        let W_kn : ℕ → Set WalkSpace := fun k =>
          A₀ ∩ (⋂ l : ℕ, {om : WalkSpace | ‖walkPos ρ om l - q‖ ≤ R}) ∩
            (⋃ m ∈ Finset.range (k + 1), {om : WalkSpace | L_q (walkPos ρ om m) < -B₁})
        have hW_meas : ∀ k : ℕ, MeasurableSet (W_kn k) := by
          intro k
          have h1 : MeasurableSet (⋂ l : ℕ, {om : WalkSpace | ‖walkPos ρ om l - q‖ ≤ R}) :=
            MeasurableSet.iInter (fun l => measurableSet_Iic.preimage
              ((continuous_norm.comp (continuous_id.sub continuous_const)).measurable.comp
                (h_walk_meas l)))
          have h2 : MeasurableSet
              (⋃ m ∈ Finset.range (k + 1), {om : WalkSpace | L_q (walkPos ρ om m) < -B₁}) :=
            (Finset.range (k + 1)).measurableSet_biUnion
              (fun m _ => measurableSet_Iio.preimage (hLq_meas.comp (h_walk_meas m)))
          exact (hA₀_meas.inter h1).inter h2
        have hW_mono : Monotone W_kn := by
          intro j k hjk om ⟨hA_R, hm⟩
          refine ⟨hA_R, ?_⟩
          simp only [Set.mem_iUnion, Finset.mem_range] at hm ⊢
          rcases hm with ⟨m, hm_lt, hm_neg⟩
          exact ⟨m, lt_of_lt_of_le hm_lt (Nat.add_le_add_right hjk 1), hm_neg⟩
        have hW_le_k : ∀ k : ℕ,
            walkMeasure (W_kn k) ≤ ENNReal.ofReal ((M_up + C₀) / (M_up + (n : ℝ) + 1)) := by
          intro k
          have h_denom_pos : 0 < M_up + B₁ := by
            dsimp only [B₁]
            have hn0 : (0 : ℝ) ≤ (n : ℝ) := Nat.cast_nonneg n
            linarith [hM_up_pos]
          have h_pt_dom : ∀ om : WalkSpace,
              (M_up + B₁) * (W_kn k).indicator 1 om ≤ Z k om := by
            intro om
            rcases Classical.em (om ∈ W_kn k) with hom | hom
            · have ⟨⟨hA, hR_all⟩, hm_un⟩ := hom
              simp only [Set.mem_iInter] at hR_all
              simp only [Set.mem_iUnion, Finset.mem_range] at hm_un
              rcases hm_un with ⟨m, hm_lt, hm_neg⟩
              simp only [Set.indicator_of_mem hom, Pi.one_apply, mul_one]
              exact (hZ_props k om).2.2
                ⟨hA, fun j _ => hR_all j, ⟨m, Nat.le_of_lt_succ hm_lt, hm_neg⟩⟩
            · simp only [Set.indicator_of_notMem hom, mul_zero]
              exact (hZ_props k om).2.1
          have h_ind_int : MeasureTheory.Integrable
              (fun om : WalkSpace => (M_up + B₁) * (W_kn k).indicator 1 om) walkMeasure :=
            ((MeasureTheory.integrable_const (1 : ℝ)).indicator (hW_meas k)).const_mul (M_up + B₁)
          have h_int_le := MeasureTheory.integral_mono h_ind_int (hZ_int_and_exp k).1 h_pt_dom
          rw [MeasureTheory.integral_const_mul, MeasureTheory.integral_indicator_one (hW_meas k)]
            at h_int_le
          have h_real_le : walkMeasure.real (W_kn k) ≤ (M_up + C₀) / (M_up + B₁) :=
            (le_div_iff₀' h_denom_pos).mpr (le_trans h_int_le (hZ_int_and_exp k).2)
          have h_assoc : M_up + B₁ = M_up + (n : ℝ) + 1 := by
            dsimp [B₁]
            ring
          rw [MeasureTheory.measureReal_def, h_assoc] at h_real_le
          rw [← ENNReal.ofReal_toReal (MeasureTheory.measure_ne_top walkMeasure (W_kn k))]
          exact ENNReal.ofReal_le_ofReal h_real_le
        have h_ER_sub : E_R ⊆ ⋃ k : ℕ, W_kn k := by
          rintro om ⟨hA, hR_all, h_tend⟩
          have h_tend_norm : Filter.Tendsto (fun m : ℕ => dist (walkPos ρ om m) q)
              Filter.atTop (nhds 0) :=
            tendsto_iff_dist_tendsto_zero.mp h_tend
          have hexp_pos : 0 < Real.exp (-B₁) := Real.exp_pos _
          obtain ⟨m, hm⟩ := (Metric.tendsto_atTop.mp h_tend_norm (Real.exp (-B₁)) hexp_pos)
          have hm_dist : ‖walkPos ρ om m - q‖ < Real.exp (-B₁) := by
            simpa [dist_eq_norm] using hm m le_rfl
          have hm_pos : 0 < ‖walkPos ρ om m - q‖ :=
            norm_pos_iff.mpr (h_ne_on_reg _ (h_walk_in_reg om m).1)
          have hm_log : L_q (walkPos ρ om m) < -B₁ :=
            (Real.log_lt_iff_lt_exp hm_pos).mpr hm_dist
          refine Set.mem_iUnion.mpr ⟨m, ⟨⟨hA, Set.mem_iInter.mpr hR_all⟩, ?_⟩⟩
          exact Set.mem_iUnion.mpr ⟨m, Set.mem_iUnion.mpr
            ⟨Finset.mem_range.mpr (Nat.lt_succ_self m), hm_log⟩⟩
        calc walkMeasure E_R
          _ ≤ walkMeasure (⋃ k : ℕ, W_kn k) := MeasureTheory.measure_mono h_ER_sub
          _ = ⨆ k : ℕ, walkMeasure (W_kn k) := hW_mono.measure_iUnion
          _ ≤ ENNReal.ofReal ((M_up + C₀) / (M_up + (n : ℝ) + 1)) := iSup_le hW_le_k
      by_contra h_ne_zero
      have hc_pos : 0 < (walkMeasure E_R).toReal :=
        ENNReal.toReal_pos h_ne_zero (MeasureTheory.measure_ne_top walkMeasure E_R)
      obtain ⟨n, hn⟩ := exists_nat_ge ((M_up + C₀) / (walkMeasure E_R).toReal)
      have hn0 : (0 : ℝ) ≤ (n : ℝ) := Nat.cast_nonneg n
      have h_denom_pos : 0 < M_up + (n : ℝ) + 1 := by linarith [hM_up_pos]
      have h_toReal_le : (walkMeasure E_R).toReal ≤ (M_up + C₀) / (M_up + (n : ℝ) + 1) := by
        have h1 := ENNReal.toReal_mono ENNReal.ofReal_ne_top (h_ER_le_n n)
        rwa [ENNReal.toReal_ofReal (div_nonneg (by linarith) h_denom_pos.le)] at h1
      have h_mul1 : M_up + C₀ ≤ (n : ℝ) * (walkMeasure E_R).toReal :=
        (div_le_iff₀ hc_pos).mp hn
      have h_mul2 : (walkMeasure E_R).toReal * (M_up + (n : ℝ) + 1) ≤ M_up + C₀ :=
        (le_div_iff₀ h_denom_pos).mp h_toReal_le
      nlinarith
    have h_A0_q_sub : {om : WalkSpace | om ∈ A₀ ∧
        Filter.Tendsto (fun m : ℕ => walkPos ρ om m) Filter.atTop (nhds q)} ⊆
        ⋃ R_nat : ℕ, {om : WalkSpace | om ∈ A₀ ∧
          (∀ l : ℕ, ‖walkPos ρ om l - q‖ ≤ 2 * Real.pi + ‖q‖ + 1 + (R_nat : ℝ)) ∧
          Filter.Tendsto (fun m : ℕ => walkPos ρ om m) Filter.atTop (nhds q)} := by
      rintro om ⟨hA, h_tend⟩
      obtain ⟨M₀, hM₀⟩ := Metric.tendsto_atTop.mp h_tend 1 one_pos
      let S_max : ℝ := (Finset.range (M₀ + 1)).sup'
        ⟨0, Finset.mem_range.mpr (Nat.zero_lt_succ M₀)⟩
        (fun l => ‖walkPos ρ om l - q‖)
      obtain ⟨R_nat, hR_nat⟩ := exists_nat_ge S_max
      refine Set.mem_iUnion.mpr ⟨R_nat, hA, ?_, h_tend⟩
      intro l
      by_cases hl : l ≤ M₀
      · have hl_le : ‖walkPos ρ om l - q‖ ≤ S_max :=
          Finset.le_sup' (f := fun j => ‖walkPos ρ om j - q‖)
            (Finset.mem_range.mpr (Nat.lt_succ_of_le hl))
        linarith [Real.two_pi_pos, norm_nonneg q]
      · have hl_ge : M₀ ≤ l := le_of_not_ge hl
        have hl_lt : ‖walkPos ρ om l - q‖ < 1 := by
          simpa [dist_eq_norm] using hM₀ l hl_ge
        have hR_nat0 : (0 : ℝ) ≤ (R_nat : ℝ) := Nat.cast_nonneg R_nat
        linarith [Real.two_pi_pos, norm_nonneg q]
    have h_A0_q_null : walkMeasure {om : WalkSpace | om ∈ A₀ ∧
        Filter.Tendsto (fun m : ℕ => walkPos ρ om m) Filter.atTop (nhds q)} = 0 :=
      MeasureTheory.measure_mono_null h_A0_q_sub (MeasureTheory.measure_iUnion_null h_ER_null)
    have h_full_sub : {om : WalkSpace |
        Filter.Tendsto (fun m : ℕ => walkPos ρ om m) Filter.atTop (nhds q)} ⊆
        {om : WalkSpace | om ∈ A₀ ∧
          Filter.Tendsto (fun m : ℕ => walkPos ρ om m) Filter.atTop (nhds q)} ∪ A₀ᶜ := by
      intro om hom
      by_cases hA : om ∈ A₀
      · exact Or.inl ⟨hA, hom⟩
      · exact Or.inr hA
    exact MeasureTheory.measure_mono_null h_full_sub
      (MeasureTheory.measure_union_null h_A0_q_null hA₀_compl_null)
  have h_avoid_Z_ae : ∀ᵐ om : WalkSpace ∂walkMeasure, ∀ q ∈ P.Z_all,
      ¬ Filter.Tendsto (fun m : ℕ => walkPos ρ om m) Filter.atTop (nhds q) := by
    rw [MeasureTheory.ae_iff]
    have h_eq : {om : WalkSpace | ¬ ∀ q ∈ P.Z_all,
        ¬ Filter.Tendsto (fun m : ℕ => walkPos ρ om m) Filter.atTop (nhds q)} =
        ⋃ q ∈ P.Z_all, {om : WalkSpace |
          Filter.Tendsto (fun m : ℕ => walkPos ρ om m) Filter.atTop (nhds q)} := by
      ext om
      simp
    rw [h_eq]
    exact (MeasureTheory.measure_biUnion_null_iff hZ_countable).mpr h_polar

  
  
  
  let x_inf : WalkSpace → ℝ := fun om => om 0 + d_inf om
  let sgn_inf : WalkSpace → ℝ := fun om => if 0 ≤ y_im_inf om then 1 else -1
  have hx_inf_meas : Measurable x_inf := (measurable_pi_apply 0).add hd_inf_meas
  have hsgn_inf_meas : Measurable sgn_inf :=
    Measurable.ite (measurableSet_Ici.preimage hy_im_inf_meas) measurable_const measurable_const
  refine
    { walk_in_reg := h_walk_in_reg
      walk_clock := h_walk_clock
      impact_sq_sum := h_impact_sq_sum
      harmonic_expectation_eq := h_harm_exp
      ae_wall_exit_and_impact_im_conv := ⟨x_inf, sgn_inf, v_inf,
        hx_inf_meas, hsgn_inf_meas, hv_inf_meas, ?_⟩ }
  filter_upwards [hd_conv, hy_im_conv, hv_inf_conv, h_avoid_Z_ae] with om hd_om hy_om hv_om hZ_om
  have hx_om : Filter.Tendsto (fun m : ℕ => (walkPos ρ om m).re) Filter.atTop
      (nhds (x_inf om)) := by
    have h_eq : (fun m : ℕ => (walkPos ρ om m).re) = fun m : ℕ => om 0 + d_re m om := by
      ext m
      simp [d_re]
    rw [h_eq]
    exact hd_om.const_add (om 0)
  let y_lim : ℂ := (x_inf om : ℂ) + (y_im_inf om : ℂ) * Complex.I
  have hy_walk_conv : Filter.Tendsto (fun m : ℕ => walkPos ρ om m) Filter.atTop (nhds y_lim) := by
    have h_eq : (fun m : ℕ => walkPos ρ om m) =
        fun m : ℕ => ((walkPos ρ om m).re : ℂ) + ((walkPos ρ om m).im : ℂ) * Complex.I := by
      ext m
      exact (Complex.re_add_im _).symm
    rw [h_eq]
    exact (Complex.continuous_ofReal.continuousAt.tendsto.comp hx_om).add
      ((Complex.continuous_ofReal.continuousAt.tendsto.comp hy_om).mul_const Complex.I)
  have hy_im_le : |y_im_inf om| ≤ h :=
    le_of_tendsto' (continuous_abs.continuousAt.tendsto.comp hy_om)
      (fun m => le_of_lt (h_walk_in_reg om m).1.1)
  have hy_im_abs_eq : |y_im_inf om| = h := by
    by_contra h_ne
    have h_lt : |y_im_inf om| < h := lt_of_le_of_ne hy_im_le h_ne
    have hy_lim_strip : y_lim ∈ horizStrip h := by
      simpa [horizStrip, y_lim] using h_lt
    have hy_lim_not_Z : y_lim ∉ P.Z_all := fun h_in => hZ_om y_lim h_in hy_walk_conv
    have hy_lim_reg : y_lim ∈ Ω_reg := ⟨hy_lim_strip, hy_lim_not_Z⟩
    have hy_shift_conv : Filter.Tendsto (fun m : ℕ => walkPos ρ om (m + 1))
        Filter.atTop (nhds y_lim) :=
      (Filter.tendsto_add_atTop_iff_nat 1).mpr hy_walk_conv
    have hρ_to_zero : Filter.Tendsto (fun m : ℕ => ρ (walkPos ρ om m))
        Filter.atTop (nhds 0) := by
      have h_norm_conv : Filter.Tendsto
          (fun m : ℕ => ‖walkPos ρ om (m + 1) - walkPos ρ om m‖) Filter.atTop (nhds 0) := by
        simpa [sub_self] using (hy_shift_conv.sub hy_walk_conv).norm
      have h_eq : (fun m : ℕ => ‖walkPos ρ om (m + 1) - walkPos ρ om m‖) =
          fun m : ℕ => ρ (walkPos ρ om m) := by
        ext m
        rw [h_walk_step_eq, h_circleMap_norm _ _ _ (hAdm.nonneg _)]
      rwa [h_eq] at h_norm_conv
    have hρ_cont_at : ContinuousAt ρ y_lim :=
      hAdm.cont_on.continuousAt (P.reg_open.mem_nhds hy_lim_reg)
    have hρ_to_val : Filter.Tendsto (fun m : ℕ => ρ (walkPos ρ om m))
        Filter.atTop (nhds (ρ y_lim)) :=
      hρ_cont_at.tendsto.comp hy_walk_conv
    have hρ_zero : ρ y_lim = 0 := tendsto_nhds_unique hρ_to_val hρ_to_zero
    have hρ_pos : 0 < ρ y_lim := (hAdm.pos_iff y_lim).mpr hy_lim_reg
    linarith
  have hsgn_cases : (sgn_inf om = 1 ∨ sgn_inf om = -1) ∧
      y_im_inf om = sgn_inf om * h := by
    by_cases h_nonneg : 0 ≤ y_im_inf om
    · have hsgn_eq : sgn_inf om = 1 := by simp [sgn_inf, h_nonneg]
      refine ⟨Or.inl hsgn_eq, ?_⟩
      rw [hsgn_eq, one_mul]
      rwa [abs_of_nonneg h_nonneg] at hy_im_abs_eq
    · have hsgn_eq : sgn_inf om = -1 := by simp [sgn_inf, h_nonneg]
      refine ⟨Or.inr hsgn_eq, ?_⟩
      rw [hsgn_eq, neg_one_mul]
      rw [abs_of_neg (lt_of_not_ge h_nonneg)] at hy_im_abs_eq
      linarith
  refine ⟨hsgn_cases.1, ?_, hv_om⟩
  have hy_lim_eq : y_lim =
      (x_inf om : ℂ) + ((sgn_inf om * sliceHeight S P.N : ℝ) : ℂ) * Complex.I := by
    dsimp only [y_lim, h]
    rw [hsgn_cases.2]
  rwa [← hy_lim_eq]

theorem tangential_safe_boundary_stopping (S : FiniteWallNonisotropicStrip)
    (P : OddPeriodicSliceData S) (M : ℝ) (ρ : ℂ → ℝ)
    (hAdm : IsScaleAdmissibleStep S P M ρ)
    (hPoisson : StripPoissonToolkitProp (sliceHeight S P.N))
    (hWalk : AdmissibleWalkWallExitProp S P M ρ) :
    ∀ᵐ om : WalkSpace ∂walkMeasure,
      ∃ m : ℕ, M ≤ Finset.univ.sup' Finset.univ_nonempty
        (fun j => sliceHistory S P ρ om j m) :=
by
  have hProbUnif : MeasureTheory.IsProbabilityMeasure unifTwoPiMeasure := by
    refine ⟨?_⟩
    simp only [unifTwoPiMeasure, MeasureTheory.Measure.smul_apply,
      MeasureTheory.Measure.restrict_apply_univ, smul_eq_mul, Real.volume_Ico, sub_zero]
    exact ENNReal.inv_mul_cancel
      (ENNReal.ofReal_pos.mpr Real.two_pi_pos).ne' ENNReal.ofReal_ne_top
  haveI hProbWalk : MeasureTheory.IsProbabilityMeasure walkMeasure := by
    dsimp only [walkMeasure]
    infer_instance
  let h : ℝ := sliceHeight S P.N
  have hN_pos : (0 : ℝ) < (P.N : ℝ) := by
    exact_mod_cast lt_of_lt_of_le (by decide : 0 < 3) P.N_ge_three
  have ht₀_pos : 0 < sliceParamT0 P.N :=
    div_pos Real.two_pi_pos hN_pos
  have ht₀_mem : (sliceParamT0 P.N : ℂ) ∈ Metric.ball (0 : ℂ) S.r_star := by
    rw [Metric.mem_ball, dist_zero_right, Complex.norm_real, Real.norm_eq_abs, abs_of_pos ht₀_pos]
    exact P.t₀_lt_r_star
  have hh_pos : 0 < h :=
    lt_of_lt_of_le S.s_star_pos (S.h_X_bounds _ ht₀_mem).1
  have h_strip_open : IsOpen (horizStrip h) :=
    isOpen_Iio.preimage (continuous_abs.comp Complex.continuous_im)
  have h_walk_meas : ∀ m : ℕ, Measurable (fun om : WalkSpace => walkPos ρ om m) := by
    intro m
    induction m with
    | zero =>
        dsimp only [walkPos]
        exact Complex.continuous_ofReal.measurable.comp (measurable_pi_apply 0)
    | succ m ih =>
        have hρ_m : Measurable (fun om : WalkSpace => (ρ (walkPos ρ om m) : ℂ)) :=
          Complex.continuous_ofReal.measurable.comp (hAdm.measurable.comp ih)
        have hexp_m : Measurable
            (fun om : WalkSpace => Complex.exp ((om (m + 1) : ℂ) * Complex.I)) :=
          Complex.continuous_exp.measurable.comp
            ((Complex.continuous_ofReal.measurable.comp
              (measurable_pi_apply (m + 1))).mul_const Complex.I)
        dsimp only [walkPos]
        exact ih.add (hρ_m.mul hexp_m)
  have h_comp_walk_meas : ∀ {U : ℂ → ℝ}, ContinuousOn U (horizStrip h) →
      ∀ m : ℕ, Measurable (fun om : WalkSpace => U (walkPos ρ om m)) := by
    intro U hU m
    have h_sub : Measurable (fun om : WalkSpace =>
        (⟨walkPos ρ om m, (hWalk.walk_in_reg om m).1.1⟩ : horizStrip h)) :=
      (h_walk_meas m).subtype_mk
    exact (continuousOn_iff_continuous_domRestrict.mp hU).measurable.comp h_sub
  have h_safe_ball : ∀ y ∈ horizStrip h \ P.Z_all,
      Metric.closedBall y |ρ y| ⊆ horizStrip h := by
    intro y hy w hw
    have hρ_pos : 0 < ρ y := (hAdm.pos_iff y).mpr hy
    rw [Metric.mem_closedBall, abs_of_pos hρ_pos, dist_comm] at hw
    by_contra hw_not
    have hw_comp : w ∈ sliceRegClosedComp S P := fun hw_reg => hw_not hw_reg.1
    have h_inf : sliceSingDist S P y ≤ dist y w :=
      Metric.infDist_le_dist_of_mem hw_comp
    have h_le : ρ y ≤ (1 / 100 : ℝ) * sliceSingDist S P y :=
      le_trans (hAdm.le_sing_dist y)
        (mul_le_mul_of_nonneg_left (min_le_right 1 _) (by norm_num))
    linarith
  
  let v_im : Fin P.N → ℂ → ℝ := fun j y => (sliceImpactSeq S P.N j.val y).im
  let h_approx : ℕ → ℝ := fun n => (1 - 1 / ((n : ℝ) + 2)) * h
  let tr_pos : Fin P.N → ℕ → ℝ → ℝ :=
    fun j n x => v_im j ((x : ℂ) + (h_approx n : ℂ) * Complex.I)
  let tr_neg : Fin P.N → ℕ → ℝ → ℝ :=
    fun j n x => v_im j ((x : ℂ) - (h_approx n : ℂ) * Complex.I)
  let lim_pos : Fin P.N → ℝ → ℝ := fun j x =>
    max (-S.H) (min S.H (Filter.limUnder Filter.atTop (fun n : ℕ => tr_pos j n x)))
  let lim_neg : Fin P.N → ℝ → ℝ := fun j x =>
    max (-S.H) (min S.H (Filter.limUnder Filter.atTop (fun n : ℕ => tr_neg j n x)))
  have hp_tube : ∀ (j : Fin P.N), ∀ y ∈ horizStrip h,
      (y + ((j.val : ℤ) : ℂ) * (sliceParamT0 P.N : ℂ), (sliceParamT0 P.N : ℂ)) ∈
        finiteWallTube S.r_star S.h_X := by
    intro j y hy
    have hy_lt : -h < y.im ∧ y.im < h := abs_lt.mp hy
    refine ⟨?_, ?_, ?_⟩
    · simpa [Metric.mem_ball, dist_zero_right] using ht₀_mem
    · simp only [Complex.conj_ofReal, Complex.add_im, Complex.mul_im,
        Complex.ofReal_im, Complex.intCast_im, mul_zero, zero_mul, add_zero]
      exact hy_lt.1
    · simp only [Complex.add_im, Complex.mul_im,
        Complex.ofReal_im, Complex.intCast_im, mul_zero, zero_mul, add_zero]
      exact hy_lt.2
  have hs_holo : ∀ j : Fin P.N,
      DifferentiableOn ℂ (sliceImpactSeq S P.N j.val) (horizStrip h) := by
    intro j
    have h_aff : Differentiable ℂ
        (fun y : ℂ => (y + ((j.val : ℤ) : ℂ) * (sliceParamT0 P.N : ℂ),
          (sliceParamT0 P.N : ℂ))) :=
      Differentiable.prodMk (differentiable_id.add (differentiable_const _))
        (differentiable_const _)
    exact S.𝔰_holo.comp h_aff.differentiableOn (fun y hy => hp_tube j y hy)
  have hv_cont : ∀ j : Fin P.N, ContinuousOn (v_im j) (horizStrip h) :=
    fun j => Complex.continuous_im.comp_continuousOn (hs_holo j).continuousOn
  have hv_per : ∀ j : Fin P.N, ∀ y ∈ horizStrip h,
      v_im j (y + 2 * Real.pi) = v_im j y := by
    intro j y hy
    have h_eq : y + 2 * Real.pi + ((j.val : ℤ) : ℂ) * (sliceParamT0 P.N : ℂ) =
        (y + ((j.val : ℤ) : ℂ) * (sliceParamT0 P.N : ℂ)) + 2 * Real.pi := by ring
    have hq := S.𝔰_quasiperiodic _ (hp_tube j y hy)
    dsimp only [v_im, sliceImpactSeq] at *
    rw [h_eq, hq]
    simp
  have hv_lt_H : ∀ j : Fin P.N, ∀ y ∈ horizStrip h, |v_im j y| < S.H :=
    fun j y hy => S.𝔰_maps_to _ (hp_tube j y hy)
  have hv_le_H : ∀ j : Fin P.N, ∀ y ∈ horizStrip h, |v_im j y| ≤ S.H :=
    fun j y hy => le_of_lt (hv_lt_H j y hy)
  have hv_harm : ∀ j : Fin P.N, ∀ y : ℂ, ∀ r : ℝ,
      0 < r → Metric.closedBall y r ⊆ horizStrip h →
      Real.circleAverage (v_im j) y r = v_im j y := by
    intro j y r hr hsub
    have hs_an : AnalyticOnNhd ℂ (sliceImpactSeq S P.N j.val) (horizStrip h) :=
      (hs_holo j).analyticOnNhd h_strip_open
    have h_harm_ball : InnerProductSpace.HarmonicOnNhd (v_im j) (Metric.closedBall y |r|) := by
      intro z hz
      rw [abs_of_pos hr] at hz
      exact (hs_an z (hsub hz)).harmonicAt_im
    exact h_harm_ball.circleAverage_eq
  have hh_approx_bounds : ∀ n : ℕ, 0 < h_approx n ∧ h_approx n < h := by
    intro n
    have hn2 : (2 : ℝ) ≤ (n : ℝ) + 2 := by linarith [(Nat.cast_nonneg n : (0 : ℝ) ≤ (n : ℝ))]
    have h_inv_pos : 0 < 1 / ((n : ℝ) + 2) := by positivity
    have h_inv_le : 1 / ((n : ℝ) + 2) ≤ 1 / 2 :=
      one_div_le_one_div_of_le (by norm_num) hn2
    dsimp only [h_approx]
    constructor <;> nlinarith
  have hz_pos_mem : ∀ (n : ℕ) (x : ℝ),
      (x : ℂ) + (h_approx n : ℂ) * Complex.I ∈ horizStrip h := by
    intro n x
    rcases hh_approx_bounds n with ⟨h0, h1⟩
    simp [horizStrip, abs_of_pos h0, h1]
  have hz_neg_mem : ∀ (n : ℕ) (x : ℝ),
      (x : ℂ) - (h_approx n : ℂ) * Complex.I ∈ horizStrip h := by
    intro n x
    rcases hh_approx_bounds n with ⟨h0, h1⟩
    simp [horizStrip, abs_of_pos h0, h1]
  have htr_pos_cont : ∀ (j : Fin P.N) (n : ℕ), Continuous (tr_pos j n) := by
    intro j n
    have hc : Continuous (fun x : ℝ => (x : ℂ) + (h_approx n : ℂ) * Complex.I) :=
      Complex.continuous_ofReal.add continuous_const
    exact (hv_cont j).comp_continuous hc (hz_pos_mem n)
  have htr_neg_cont : ∀ (j : Fin P.N) (n : ℕ), Continuous (tr_neg j n) := by
    intro j n
    have hc : Continuous (fun x : ℝ => (x : ℂ) - (h_approx n : ℂ) * Complex.I) :=
      Complex.continuous_ofReal.sub continuous_const
    exact (hv_cont j).comp_continuous hc (hz_neg_mem n)
  have htr_pos_per : ∀ (j : Fin P.N) (n : ℕ), Function.Periodic (tr_pos j n) (2 * Real.pi) := by
    intro j n x
    have heq : (((x + 2 * Real.pi : ℝ) : ℂ) + (h_approx n : ℂ) * Complex.I) =
        ((x : ℂ) + (h_approx n : ℂ) * Complex.I) + 2 * Real.pi := by push_cast; ring
    dsimp only [tr_pos]
    rw [heq]
    exact hv_per j _ (hz_pos_mem n x)
  have htr_neg_per : ∀ (j : Fin P.N) (n : ℕ), Function.Periodic (tr_neg j n) (2 * Real.pi) := by
    intro j n x
    have heq : (((x + 2 * Real.pi : ℝ) : ℂ) - (h_approx n : ℂ) * Complex.I) =
        ((x : ℂ) - (h_approx n : ℂ) * Complex.I) + 2 * Real.pi := by push_cast; ring
    dsimp only [tr_neg]
    rw [heq]
    exact hv_per j _ (hz_neg_mem n x)
  have htr_pos_bdd : ∀ (j : Fin P.N) (n : ℕ) (x : ℝ), |tr_pos j n x| ≤ S.H :=
    fun j n x => hv_le_H j _ (hz_pos_mem n x)
  have htr_neg_bdd : ∀ (j : Fin P.N) (n : ℕ) (x : ℝ), |tr_neg j n x| ≤ S.H :=
    fun j n x => hv_le_H j _ (hz_neg_mem n x)
  have hlim_pos_meas : ∀ j : Fin P.N, Measurable (lim_pos j) := by
    intro j
    have h_lu : Measurable
        (fun x : ℝ => Filter.limUnder Filter.atTop (fun n : ℕ => tr_pos j n x)) :=
      (MeasureTheory.StronglyMeasurable.limUnder
        (fun n => (htr_pos_cont j n).stronglyMeasurable)).measurable
    exact measurable_const.max (measurable_const.min h_lu)
  have hlim_neg_meas : ∀ j : Fin P.N, Measurable (lim_neg j) := by
    intro j
    have h_lu : Measurable
        (fun x : ℝ => Filter.limUnder Filter.atTop (fun n : ℕ => tr_neg j n x)) :=
      (MeasureTheory.StronglyMeasurable.limUnder
        (fun n => (htr_neg_cont j n).stronglyMeasurable)).measurable
    exact measurable_const.max (measurable_const.min h_lu)
  have hlim_pos_per : ∀ j : Fin P.N, Function.Periodic (lim_pos j) (2 * Real.pi) := by
    intro j x
    dsimp only [lim_pos]
    have hseq : (fun n : ℕ => tr_pos j n (x + 2 * Real.pi)) = (fun n : ℕ => tr_pos j n x) :=
      funext (fun n => htr_pos_per j n x)
    rw [hseq]
  have hlim_neg_per : ∀ j : Fin P.N, Function.Periodic (lim_neg j) (2 * Real.pi) := by
    intro j x
    dsimp only [lim_neg]
    have hseq : (fun n : ℕ => tr_neg j n (x + 2 * Real.pi)) = (fun n : ℕ => tr_neg j n x) :=
      funext (fun n => htr_neg_per j n x)
    rw [hseq]
  have hlim_bdd : ∀ (j : Fin P.N) (x : ℝ), |lim_pos j x| ≤ S.H ∧ |lim_neg j x| ≤ S.H := by
    intro j x
    have hH : -S.H ≤ S.H := by linarith [S.H_pos]
    constructor
    · exact abs_le.mpr ⟨le_max_left _ _, max_le hH (min_le_left _ _)⟩
    · exact abs_le.mpr ⟨le_max_left _ _, max_le hH (min_le_left _ _)⟩
  have hh_approx_tendsto : Filter.Tendsto h_approx Filter.atTop (nhds h) := by
    have h_inv : Filter.Tendsto (fun n : ℕ => 1 / ((n : ℝ) + 2)) Filter.atTop (nhds 0) := by
      have h1 := (tendsto_one_div_add_atTop_nhds_zero_nat (𝕜 := ℝ)).comp
        (Filter.tendsto_add_atTop_nat 1)
      simpa only [Function.comp_def, Nat.cast_add, Nat.cast_one, add_assoc,
        one_add_one_eq_two] using h1
    simpa [h_approx] using ((tendsto_const_nhds (x := (1 : ℝ))).sub h_inv).mul_const h
  let goodBC : ℝ → Prop := fun x =>
    (∀ j : Fin P.N,
      Filter.Tendsto (fun n : ℕ => tr_pos j n x) Filter.atTop (nhds (lim_pos j x)) ∧
      Filter.Tendsto (fun n : ℕ => tr_neg j n x) Filter.atTop (nhds (lim_neg j x))) ∧
    (∃ j : Fin P.N, |lim_pos j x| = S.H) ∧
    (∃ j : Fin P.N, |lim_neg j x| = S.H)
  have h_ae_bc : ∀ᵐ x : ℝ ∂MeasureTheory.volume, goodBC x := by
    refine P.boundary_contact.mono ?_
    intro x hbc
    obtain ⟨s_pos, h_cone_pos, j_pos, hj_pos⟩ := hbc 1 (Or.inl rfl)
    obtain ⟨s_neg, h_cone_neg, j_neg, hj_neg⟩ := hbc (-1) (Or.inr rfl)
    have hz_pos_tendsto : Filter.Tendsto
        (fun n : ℕ => (x : ℂ) + (h_approx n : ℂ) * Complex.I)
        Filter.atTop
        (nhdsWithin ((x : ℂ) + ((1 * h : ℝ) : ℂ) * Complex.I)
          {y : ℂ | y ∈ horizStrip h ∧ |y.re - x| ≤ (1 : ℝ) * (h - |y.im|)}) := by
      refine tendsto_nhdsWithin_iff.mpr ⟨?_, Filter.Eventually.of_forall ?_⟩
      · have hc : Filter.Tendsto (fun n : ℕ => (h_approx n : ℂ)) Filter.atTop (nhds (h : ℂ)) :=
          Complex.continuous_ofReal.continuousAt.tendsto.comp hh_approx_tendsto
        simpa [one_mul] using (tendsto_const_nhds (x := (x : ℂ))).add (hc.mul_const Complex.I)
      · intro n
        rcases hh_approx_bounds n with ⟨h0, h1⟩
        refine ⟨hz_pos_mem n x, ?_⟩
        simp [abs_of_pos h0]
        linarith
    have hz_neg_tendsto : Filter.Tendsto
        (fun n : ℕ => (x : ℂ) - (h_approx n : ℂ) * Complex.I)
        Filter.atTop
        (nhdsWithin ((x : ℂ) + (((-1 : ℝ) * h : ℝ) : ℂ) * Complex.I)
          {y : ℂ | y ∈ horizStrip h ∧ |y.re - x| ≤ (1 : ℝ) * (h - |y.im|)}) := by
      refine tendsto_nhdsWithin_iff.mpr ⟨?_, Filter.Eventually.of_forall ?_⟩
      · have hc : Filter.Tendsto (fun n : ℕ => (h_approx n : ℂ)) Filter.atTop (nhds (h : ℂ)) :=
          Complex.continuous_ofReal.continuousAt.tendsto.comp hh_approx_tendsto
        have h_lim : (x : ℂ) - (h : ℂ) * Complex.I =
            (x : ℂ) + (((-1 : ℝ) * h : ℝ) : ℂ) * Complex.I := by push_cast; ring
        rw [← h_lim]
        exact (tendsto_const_nhds (x := (x : ℂ))).sub (hc.mul_const Complex.I)
      · intro n
        rcases hh_approx_bounds n with ⟨h0, h1⟩
        refine ⟨hz_neg_mem n x, ?_⟩
        simp [abs_of_pos h0]
        linarith
    have h_pos_eq : ∀ j : Fin P.N,
        Filter.Tendsto (fun n : ℕ => tr_pos j n x) Filter.atTop (nhds (s_pos j).im) ∧
        lim_pos j x = (s_pos j).im := by
      intro j
      have ht : Filter.Tendsto (fun n : ℕ => tr_pos j n x) Filter.atTop (nhds (s_pos j).im) :=
        Complex.continuous_im.continuousAt.tendsto.comp
          ((h_cone_pos 1 zero_lt_one j).comp hz_pos_tendsto)
      have habs : |(s_pos j).im| ≤ S.H :=
        le_of_tendsto' (continuous_abs.continuousAt.tendsto.comp ht) (htr_pos_bdd j · x)
      rcases abs_le.mp habs with ⟨h_ge, h_le⟩
      refine ⟨ht, ?_⟩
      dsimp only [lim_pos]
      rw [ht.limUnder_eq, min_eq_right h_le, max_eq_right h_ge]
    have h_neg_eq : ∀ j : Fin P.N,
        Filter.Tendsto (fun n : ℕ => tr_neg j n x) Filter.atTop (nhds (s_neg j).im) ∧
        lim_neg j x = (s_neg j).im := by
      intro j
      have ht : Filter.Tendsto (fun n : ℕ => tr_neg j n x) Filter.atTop (nhds (s_neg j).im) :=
        Complex.continuous_im.continuousAt.tendsto.comp
          ((h_cone_neg 1 zero_lt_one j).comp hz_neg_tendsto)
      have habs : |(s_neg j).im| ≤ S.H :=
        le_of_tendsto' (continuous_abs.continuousAt.tendsto.comp ht) (htr_neg_bdd j · x)
      rcases abs_le.mp habs with ⟨h_ge, h_le⟩
      refine ⟨ht, ?_⟩
      dsimp only [lim_neg]
      rw [ht.limUnder_eq, min_eq_right h_le, max_eq_right h_ge]
    refine ⟨fun j => ⟨?_, ?_⟩, ⟨j_pos, ?_⟩, ⟨j_neg, ?_⟩⟩
    · rw [(h_pos_eq j).2]; exact (h_pos_eq j).1
    · rw [(h_neg_eq j).2]; exact (h_neg_eq j).1
    · rw [(h_pos_eq j_pos).2]; exact hj_pos
    · rw [(h_neg_eq j_neg).2]; exact hj_neg
  
  obtain ⟨x_inf, sgn_inf, v_inf, hx_meas, hsgn_meas, hv_meas, h_walk_ae⟩ :=
    hWalk.ae_wall_exit_and_impact_im_conv
  have h_poisson_tendsto_ae : ∀ (ϕ_p ϕ_n : ℝ → ℝ),
      Continuous ϕ_p → Continuous ϕ_n →
      Function.Periodic ϕ_p (2 * Real.pi) → Function.Periodic ϕ_n (2 * Real.pi) →
      ∀ᵐ om : WalkSpace ∂walkMeasure,
        Filter.Tendsto
          (fun m : ℕ => stripPoissonExt h ϕ_p ϕ_n (walkPos ρ om m))
          Filter.atTop
          (nhds (if 0 ≤ sgn_inf om then ϕ_p (x_inf om) else ϕ_n (x_inf om))) := by
    intro ϕ_p ϕ_n hcp hcn hpp hpn
    refine h_walk_ae.mono ?_
    intro om ⟨hsgn, h_pos_conv, _⟩
    have h_within : Filter.Tendsto (fun m : ℕ => walkPos ρ om m) Filter.atTop
        (nhdsWithin ((x_inf om : ℂ) + ((sgn_inf om * h : ℝ) : ℂ) * Complex.I) (horizStrip h)) :=
      tendsto_nhdsWithin_iff.mpr
        ⟨h_pos_conv, Filter.Eventually.of_forall (fun m => (hWalk.walk_in_reg om m).1.1)⟩
    have htb := hPoisson.tendsto_boundary ϕ_p ϕ_n hcp hcn hpp hpn (x_inf om)
    rcases hsgn with hs1 | hsn1
    · have h_nonneg : 0 ≤ sgn_inf om := by linarith
      have h_pt : (x_inf om : ℂ) + ((sgn_inf om * h : ℝ) : ℂ) * Complex.I =
          (x_inf om : ℂ) + (h : ℂ) * Complex.I := by rw [hs1]; push_cast; ring
      rw [if_pos h_nonneg]
      rw [h_pt] at h_within
      exact htb.1.comp h_within
    · have h_neg : ¬ 0 ≤ sgn_inf om := by linarith
      have h_pt : (x_inf om : ℂ) + ((sgn_inf om * h : ℝ) : ℂ) * Complex.I =
          (x_inf om : ℂ) - (h : ℂ) * Complex.I := by rw [hsn1]; push_cast; ring
      rw [if_neg h_neg]
      rw [h_pt] at h_within
      exact htb.2.comp h_within
  have h_exit_expect : ∀ (ϕ : ℝ → ℝ),
      Continuous ϕ → Function.Periodic ϕ (2 * Real.pi) → (∀ x : ℝ, |ϕ x| ≤ 1) →
      (∫ om, ϕ (x_inf om) ∂walkMeasure) =
        (2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi), ϕ x := by
    intro ϕ hϕ_cont hϕ_per hϕ_bdd
    let U : ℂ → ℝ := stripPoissonExt h ϕ ϕ
    obtain ⟨hU_cont, hU_bdd, hU_harm⟩ :=
      hPoisson.cont_on_and_bound ϕ ϕ 1 hϕ_cont.measurable hϕ_cont.measurable
        zero_le_one hϕ_bdd hϕ_bdd
    have hU_step : ∀ m : ℕ,
        (∫ om, U (walkPos ρ om m) ∂walkMeasure) =
          (2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi), ϕ x := by
      intro m
      rw [hWalk.harmonic_expectation_eq U 1 hU_cont hU_bdd
        (fun y hy => hU_harm y (ρ y) (h_safe_ball y hy)) m]
      rw [hPoisson.real_period_integral ϕ ϕ 1 hϕ_cont.measurable hϕ_cont.measurable
        hϕ_per hϕ_per zero_le_one hϕ_bdd hϕ_bdd]
      simp_rw [← two_mul, intervalIntegral.integral_const_mul]
      ring
    have h_ae_lim : ∀ᵐ om : WalkSpace ∂walkMeasure,
        Filter.Tendsto (fun m : ℕ => U (walkPos ρ om m)) Filter.atTop (nhds (ϕ (x_inf om))) := by
      refine (h_poisson_tendsto_ae ϕ ϕ hϕ_cont hϕ_cont hϕ_per hϕ_per).mono ?_
      intro om hom
      simpa only [ite_self] using hom
    have h_dct : Filter.Tendsto (fun m : ℕ => ∫ om, U (walkPos ρ om m) ∂walkMeasure)
        Filter.atTop (nhds (∫ om, ϕ (x_inf om) ∂walkMeasure)) :=
      MeasureTheory.tendsto_integral_of_dominated_convergence (fun _ : WalkSpace => (1 : ℝ))
        (fun m => (h_comp_walk_meas hU_cont m).aestronglyMeasurable)
        (MeasureTheory.integrable_const (1 : ℝ))
        (fun m => Filter.Eventually.of_forall fun om => by
          rw [Real.norm_eq_abs]
          exact hU_bdd _ (hWalk.walk_in_reg om m).1.1)
        h_ae_lim
    have h_const : Filter.Tendsto (fun m : ℕ => ∫ om, U (walkPos ρ om m) ∂walkMeasure)
        Filter.atTop (nhds ((2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi), ϕ x)) := by
      simp_rw [hU_step]
      exact tendsto_const_nhds
    exact tendsto_nhds_unique h_dct h_const
  have h_null_avoid : ∀ (N_null : Set ℝ), MeasureTheory.volume N_null = 0 →
      walkMeasure {om : WalkSpace | x_inf om ∈ N_null} = 0 := by
    intro N_null hN_null
    have h_eps_bound : ∀ ε : ℝ, 0 < ε → ε < Real.pi →
        walkMeasure {om : WalkSpace | x_inf om ∈ N_null} ≤
          ENNReal.ofReal (ε / (2 * Real.pi)) := by
      intro ε hε hε_lt
      let N_per : Set ℝ :=
        ⋃ k : ℤ, (fun x : ℝ => x + (k : ℝ) * (2 * Real.pi)) ⁻¹' N_null
      have hN_sub_per : N_null ⊆ N_per := by
        intro x hx
        exact Set.mem_iUnion.mpr ⟨0, by simpa using hx⟩
      have hN_per_shift : ∀ (x : ℝ) (m : ℤ),
          x ∈ N_per ↔ x + (m : ℝ) * (2 * Real.pi) ∈ N_per := by
        intro x m
        constructor
        · rintro ⟨_, ⟨k, rfl⟩, hk⟩
          refine Set.mem_iUnion.mpr ⟨k - m, ?_⟩
          change (x + (m : ℝ) * (2 * Real.pi)) + ((k - m : ℤ) : ℝ) * (2 * Real.pi) ∈ N_null
          have heq : (x + (m : ℝ) * (2 * Real.pi)) + ((k - m : ℤ) : ℝ) * (2 * Real.pi) =
              x + (k : ℝ) * (2 * Real.pi) := by push_cast; ring
          rw [heq]; exact hk
        · rintro ⟨_, ⟨k, rfl⟩, hk⟩
          refine Set.mem_iUnion.mpr ⟨m + k, ?_⟩
          change x + ((m + k : ℤ) : ℝ) * (2 * Real.pi) ∈ N_null
          have heq : x + ((m + k : ℤ) : ℝ) * (2 * Real.pi) =
              (x + (m : ℝ) * (2 * Real.pi)) + (k : ℝ) * (2 * Real.pi) := by push_cast; ring
          rw [heq]; exact hk
      have hN_per_null : MeasureTheory.volume N_per = 0 :=
        MeasureTheory.measure_iUnion_null_iff.mpr fun k => by
          rw [MeasureTheory.measure_preimage_add_right]
          exact hN_null
      let A₀ : Set ℝ := N_per ∩ Set.Ico (0 : ℝ) (2 * Real.pi)
      have hA₀_lt : MeasureTheory.volume A₀ < ENNReal.ofReal ε := by
        have hA₀_zero : MeasureTheory.volume A₀ = 0 :=
          MeasureTheory.measure_mono_null Set.inter_subset_left hN_per_null
        rw [hA₀_zero]
        exact ENNReal.ofReal_pos.mpr hε
      obtain ⟨V, hA₀V, hV_open, hV_lt⟩ :=
        Set.exists_isOpen_lt_of_lt A₀ (ENNReal.ofReal ε) hA₀_lt
      let O : Set ℝ :=
        ⋃ k : ℤ, (fun x : ℝ => x + (k : ℝ) * (2 * Real.pi)) ⁻¹' V
      have hO_open : IsOpen O :=
        isOpen_iUnion fun k => hV_open.preimage (continuous_id.add continuous_const)
      have hO_shift : ∀ (x : ℝ) (m : ℤ),
          x ∈ O ↔ x + (m : ℝ) * (2 * Real.pi) ∈ O := by
        intro x m
        constructor
        · rintro ⟨_, ⟨k, rfl⟩, hk⟩
          refine Set.mem_iUnion.mpr ⟨k - m, ?_⟩
          change (x + (m : ℝ) * (2 * Real.pi)) + ((k - m : ℤ) : ℝ) * (2 * Real.pi) ∈ V
          have heq : (x + (m : ℝ) * (2 * Real.pi)) + ((k - m : ℤ) : ℝ) * (2 * Real.pi) =
              x + (k : ℝ) * (2 * Real.pi) := by push_cast; ring
          rw [heq]; exact hk
        · rintro ⟨_, ⟨k, rfl⟩, hk⟩
          refine Set.mem_iUnion.mpr ⟨m + k, ?_⟩
          change x + ((m + k : ℤ) : ℝ) * (2 * Real.pi) ∈ V
          have heq : x + ((m + k : ℤ) : ℝ) * (2 * Real.pi) =
              (x + (m : ℝ) * (2 * Real.pi)) + (k : ℝ) * (2 * Real.pi) := by push_cast; ring
          rw [heq]; exact hk
      have hN_sub_O : N_null ⊆ O := by
        intro x hx
        let m : ℤ := Int.floor (x / (2 * Real.pi))
        let x₀ : ℝ := x + ((-m : ℤ) : ℝ) * (2 * Real.pi)
        have hm_le : (m : ℝ) * (2 * Real.pi) ≤ x :=
          (le_div_iff₀ Real.two_pi_pos).mp (Int.floor_le (x / (2 * Real.pi)))
        have hx_lt : x < ((m : ℝ) + 1) * (2 * Real.pi) :=
          (div_lt_iff₀ Real.two_pi_pos).mp (Int.lt_floor_add_one (x / (2 * Real.pi)))
        have hx₀_Ico : x₀ ∈ Set.Ico (0 : ℝ) (2 * Real.pi) := by
          dsimp only [x₀]
          push_cast
          constructor <;> linarith
        have hx₀_per : x₀ ∈ N_per := (hN_per_shift x (-m)).mp (hN_sub_per hx)
        exact Set.mem_iUnion.mpr ⟨-m, hA₀V ⟨hx₀_per, hx₀_Ico⟩⟩
      let tile : ℤ → Set ℝ := fun k =>
        V ∩ Set.Ico ((k : ℝ) * (2 * Real.pi)) (((k : ℝ) + 1) * (2 * Real.pi))
      have hO_fund_sub : O ∩ Set.Ico (0 : ℝ) (2 * Real.pi) ⊆
          ⋃ k : ℤ, (fun x : ℝ => x + (k : ℝ) * (2 * Real.pi)) ⁻¹' (tile k) := by
        rintro x ⟨⟨_, ⟨k, rfl⟩, hkV⟩, hx0, hx2pi⟩
        refine Set.mem_iUnion.mpr ⟨k, hkV, ?_, ?_⟩ <;> linarith
      have h_tile_disj : Pairwise (fun k₁ k₂ => Disjoint (tile k₁) (tile k₂)) := by
        intro k₁ k₂ hk_ne
        rw [Set.disjoint_left]
        intro y hy₁ hy₂
        rcases lt_or_gt_of_ne hk_ne with hlt | hgt
        · have hk_le : (k₁ : ℝ) + 1 ≤ (k₂ : ℝ) := by
            exact_mod_cast Int.add_one_le_iff.mpr hlt
          have h_mul : ((k₁ : ℝ) + 1) * (2 * Real.pi) ≤ (k₂ : ℝ) * (2 * Real.pi) :=
            mul_le_mul_of_nonneg_right hk_le Real.two_pi_pos.le
          linarith [hy₁.2.2, hy₂.2.1]
        · have hk_le : (k₂ : ℝ) + 1 ≤ (k₁ : ℝ) := by
            exact_mod_cast Int.add_one_le_iff.mpr hgt
          have h_mul : ((k₂ : ℝ) + 1) * (2 * Real.pi) ≤ (k₁ : ℝ) * (2 * Real.pi) :=
            mul_le_mul_of_nonneg_right hk_le Real.two_pi_pos.le
          linarith [hy₂.2.2, hy₁.2.1]
      have hO_fund_lt : MeasureTheory.volume (O ∩ Set.Ico (0 : ℝ) (2 * Real.pi)) <
          ENNReal.ofReal ε := by
        calc
          MeasureTheory.volume (O ∩ Set.Ico (0 : ℝ) (2 * Real.pi))
            ≤ MeasureTheory.volume
                (⋃ k : ℤ, (fun x : ℝ => x + (k : ℝ) * (2 * Real.pi)) ⁻¹' (tile k)) :=
              MeasureTheory.measure_mono hO_fund_sub
          _ ≤ ∑' k : ℤ, MeasureTheory.volume
                ((fun x : ℝ => x + (k : ℝ) * (2 * Real.pi)) ⁻¹' (tile k)) :=
              MeasureTheory.measure_iUnion_le _
          _ = ∑' k : ℤ, MeasureTheory.volume (tile k) := by
              simp_rw [MeasureTheory.measure_preimage_add_right]
          _ = MeasureTheory.volume (⋃ k : ℤ, tile k) :=
              (MeasureTheory.measure_iUnion h_tile_disj
                (fun k => hV_open.measurableSet.inter measurableSet_Ico)).symm
          _ ≤ MeasureTheory.volume V :=
              MeasureTheory.measure_mono (Set.iUnion_subset fun _ => Set.inter_subset_left)
          _ < ENNReal.ofReal ε := hV_lt
      have hOc_closed : IsClosed Oᶜ := hO_open.isClosed_compl
      have hOc_ne : Oᶜ.Nonempty := by
        rw [Set.nonempty_iff_ne_empty]
        intro h_empty
        have hO_univ : O = Set.univ := compl_empty_iff.mp h_empty
        have h_eq : MeasureTheory.volume (O ∩ Set.Ico (0 : ℝ) (2 * Real.pi)) =
            ENNReal.ofReal (2 * Real.pi) := by
          rw [hO_univ, Set.univ_inter, Real.volume_Ico, sub_zero]
        have h_lt := hO_fund_lt
        rw [h_eq] at h_lt
        have h2pi_lt : 2 * Real.pi < ε :=
          (ENNReal.ofReal_lt_ofReal_iff hε).mp h_lt
        linarith [Real.pi_pos]
      let ψ : ℕ → ℝ → ℝ := fun r x => min 1 ((r : ℝ) * Metric.infDist x Oᶜ)
      have hψ_cont : ∀ r : ℕ, Continuous (ψ r) :=
        fun r => continuous_const.min (continuous_const.mul (Metric.continuous_infDist_pt Oᶜ))
      have hψ_nonneg : ∀ (r : ℕ) (x : ℝ), 0 ≤ ψ r x := by
        intro r x
        exact le_min zero_le_one (mul_nonneg (Nat.cast_nonneg r) Metric.infDist_nonneg)
      have hψ_le_one : ∀ (r : ℕ) (x : ℝ), ψ r x ≤ 1 := fun _ _ => min_le_left _ _
      have hψ_bdd : ∀ (r : ℕ) (x : ℝ), |ψ r x| ≤ 1 :=
        fun r x => abs_le.mpr ⟨by linarith [hψ_nonneg r x], hψ_le_one r x⟩
      have hOc_img : (fun y : ℝ => y + 2 * Real.pi) '' Oᶜ = Oᶜ := by
        ext z
        constructor
        · rintro ⟨y, hy, rfl⟩
          intro hz
          have hyO : y ∈ O := by
            refine (hO_shift y 1).mpr ?_
            simpa using hz
          exact hy hyO
        · intro hz
          refine ⟨z - 2 * Real.pi, ?_, by ring⟩
          intro hyO
          have hzO : z ∈ O := by
            have h1 := (hO_shift (z - 2 * Real.pi) 1).mp hyO
            have heq : (z - 2 * Real.pi) + ((1 : ℤ) : ℝ) * (2 * Real.pi) = z := by
              push_cast; ring
            rw [heq] at h1
            exact h1
          exact hz hzO
      have hψ_per : ∀ r : ℕ, Function.Periodic (ψ r) (2 * Real.pi) := by
        intro r x
        dsimp only [ψ]
        have hd : Metric.infDist (x + 2 * Real.pi) Oᶜ = Metric.infDist x Oᶜ := by
          nth_rw 1 [← hOc_img]
          exact Metric.infDist_image (isometry_add_right (2 * Real.pi))
        rw [hd]
      let A_seq : ℕ → Set WalkSpace := fun r => {om : WalkSpace | 1 ≤ ψ r (x_inf om)}
      have hA_mono : Monotone A_seq := by
        intro r₁ r₂ hr om hom
        simp only [A_seq, Set.mem_setOf_eq, ψ] at *
        refine le_trans hom (min_le_min_left 1 ?_)
        exact mul_le_mul_of_nonneg_right (by exact_mod_cast hr) Metric.infDist_nonneg
      have h_sub_union : {om : WalkSpace | x_inf om ∈ N_null} ⊆ ⋃ r : ℕ, A_seq r := by
        intro om hom
        have hxO : x_inf om ∈ O := hN_sub_O hom
        have hx_not_Oc : x_inf om ∉ Oᶜ := fun hc => hc hxO
        have hd_pos : 0 < Metric.infDist (x_inf om) Oᶜ :=
          (IsClosed.notMem_iff_infDist_pos hOc_closed hOc_ne).mp hx_not_Oc
        obtain ⟨r, hr⟩ := exists_nat_ge (1 / Metric.infDist (x_inf om) Oᶜ)
        refine Set.mem_iUnion.mpr ⟨r, ?_⟩
        simp only [A_seq, Set.mem_setOf_eq, ψ]
        refine le_min le_rfl ?_
        exact (div_le_iff₀ hd_pos).mp hr
      have hA_bound : ∀ r : ℕ, walkMeasure (A_seq r) ≤ ENNReal.ofReal (ε / (2 * Real.pi)) := by
        intro r
        have hAr_meas : MeasurableSet (A_seq r) :=
          measurableSet_Ici.preimage ((hψ_cont r).measurable.comp hx_meas)
        have h_ind_le : ∀ om : WalkSpace,
            (A_seq r).indicator (1 : WalkSpace → ℝ) om ≤ ψ r (x_inf om) := by
          intro om
          by_cases hom : om ∈ A_seq r
          · simp [Set.indicator_of_mem hom]; exact hom
          · simp [Set.indicator_of_notMem hom]; exact hψ_nonneg r (x_inf om)
        have h_int_Ar : walkMeasure.real (A_seq r) ≤
            ∫ om, ψ r (x_inf om) ∂walkMeasure := by
          rw [← MeasureTheory.integral_indicator_one hAr_meas]
          refine MeasureTheory.integral_mono ?_ ?_ h_ind_le
          · exact (MeasureTheory.integrable_const (1 : ℝ)).indicator hAr_meas
          · refine (MeasureTheory.integrable_const (1 : ℝ)).mono'
              (((hψ_cont r).measurable.comp hx_meas).aestronglyMeasurable)
              (Filter.Eventually.of_forall fun om => ?_)
            rw [Real.norm_eq_abs]
            exact hψ_bdd r (x_inf om)
        let S_O : Set ℝ := O ∩ Set.Ico (0 : ℝ) (2 * Real.pi)
        have hSO_meas : MeasurableSet S_O := hO_open.measurableSet.inter measurableSet_Ico
        have hSO_fin : MeasureTheory.volume S_O < ⊤ :=
          lt_of_lt_of_le hO_fund_lt ENNReal.ofReal_lt_top.le
        have h_int_ψ_le : (∫ x in (0 : ℝ)..(2 * Real.pi), ψ r x) ≤ ε := by
          rw [intervalIntegral.integral_of_le Real.two_pi_pos.le,
            ← MeasureTheory.restrict_Ico_eq_restrict_Ioc,
            ← MeasureTheory.integral_indicator measurableSet_Ico]
          have h_pt_le : ∀ x : ℝ,
              (Set.Ico (0 : ℝ) (2 * Real.pi)).indicator (ψ r) x ≤
                S_O.indicator (1 : ℝ → ℝ) x := by
            intro x
            by_cases hxI : x ∈ Set.Ico (0 : ℝ) (2 * Real.pi)
            · rw [Set.indicator_of_mem hxI]
              by_cases hxO : x ∈ O
              · have hxSO : x ∈ S_O := ⟨hxO, hxI⟩
                simp [Set.indicator_of_mem hxSO, hψ_le_one r x]
              · have hxSO : x ∉ S_O := fun h => hxO h.1
                have hxOc : x ∈ Oᶜ := hxO
                simp [Set.indicator_of_notMem hxSO, ψ, Metric.infDist_zero_of_mem hxOc]
            · have hxSO : x ∉ S_O := fun h => hxI h.2
              simp [Set.indicator_of_notMem hxI, Set.indicator_of_notMem hxSO]
          have h_SO_int : MeasureTheory.Integrable (S_O.indicator (1 : ℝ → ℝ))
              MeasureTheory.volume := by
            change MeasureTheory.Integrable (S_O.indicator (fun _ => (1 : ℝ)))
              MeasureTheory.volume
            exact (MeasureTheory.integrableOn_const hSO_fin.ne (by simp)).integrable_indicator
              hSO_meas
          have h_Ico_fin : MeasureTheory.volume (Set.Ico (0 : ℝ) (2 * Real.pi)) < ⊤ := by
            rw [Real.volume_Ico]; exact ENNReal.ofReal_lt_top
          have h_Ico_int : MeasureTheory.Integrable
              ((Set.Ico (0 : ℝ) (2 * Real.pi)).indicator (1 : ℝ → ℝ))
              MeasureTheory.volume := by
            change MeasureTheory.Integrable
              ((Set.Ico (0 : ℝ) (2 * Real.pi)).indicator (fun _ => (1 : ℝ)))
              MeasureTheory.volume
            exact (MeasureTheory.integrableOn_const h_Ico_fin.ne (by simp)).integrable_indicator
              measurableSet_Ico
          have h_ψ_ind_int : MeasureTheory.Integrable
              ((Set.Ico (0 : ℝ) (2 * Real.pi)).indicator (ψ r))
              MeasureTheory.volume := by
            refine h_Ico_int.mono'
              ((hψ_cont r).measurable.indicator measurableSet_Ico).aestronglyMeasurable
              (Filter.Eventually.of_forall fun x => ?_)
            by_cases hxI : x ∈ Set.Ico (0 : ℝ) (2 * Real.pi)
            · simp [Set.indicator_of_mem hxI, Real.norm_eq_abs, hψ_bdd r x]
            · simp [Set.indicator_of_notMem hxI]
          have h_le_vol : (∫ x, (Set.Ico (0 : ℝ) (2 * Real.pi)).indicator (ψ r) x) ≤
              MeasureTheory.volume.real S_O := by
            rw [← MeasureTheory.integral_indicator_one hSO_meas]
            exact MeasureTheory.integral_mono h_ψ_ind_int h_SO_int h_pt_le
          have h_vol_le : MeasureTheory.volume.real S_O ≤ ε := by
            rw [MeasureTheory.measureReal_def, ← ENNReal.toReal_ofReal hε.le]
            exact ENNReal.toReal_mono ENNReal.ofReal_ne_top hO_fund_lt.le
          exact le_trans h_le_vol h_vol_le
        have h_real_le : walkMeasure.real (A_seq r) ≤ ε / (2 * Real.pi) := by
          have h1 := le_trans h_int_Ar
            (le_of_eq (h_exit_expect (ψ r) (hψ_cont r) (hψ_per r) (hψ_bdd r)))
          have h2 : (2 * Real.pi)⁻¹ * (∫ x in (0 : ℝ)..(2 * Real.pi), ψ r x) ≤
              (2 * Real.pi)⁻¹ * ε :=
            mul_le_mul_of_nonneg_left h_int_ψ_le (inv_nonneg.mpr Real.two_pi_pos.le)
          have h_eq : (2 * Real.pi)⁻¹ * ε = ε / (2 * Real.pi) := by ring
          linarith
        rw [← ENNReal.ofReal_toReal (MeasureTheory.measure_ne_top walkMeasure (A_seq r)),
          ← MeasureTheory.measureReal_def]
        exact ENNReal.ofReal_le_ofReal h_real_le
      calc
        walkMeasure {om : WalkSpace | x_inf om ∈ N_null}
          ≤ walkMeasure (⋃ r : ℕ, A_seq r) := MeasureTheory.measure_mono h_sub_union
        _ = ⨆ r : ℕ, walkMeasure (A_seq r) := hA_mono.measure_iUnion
        _ ≤ ENNReal.ofReal (ε / (2 * Real.pi)) := iSup_le hA_bound
    by_contra hm_ne
    have hm_pos : 0 < (walkMeasure {om : WalkSpace | x_inf om ∈ N_null}).toReal :=
      ENNReal.toReal_pos hm_ne (MeasureTheory.measure_ne_top walkMeasure _)
    let m_val : ℝ := (walkMeasure {om : WalkSpace | x_inf om ∈ N_null}).toReal
    let ε₀ : ℝ := min (Real.pi / 2) (Real.pi * m_val)
    have hε₀_pos : 0 < ε₀ := lt_min (half_pos Real.pi_pos) (mul_pos Real.pi_pos hm_pos)
    have hε₀_lt : ε₀ < Real.pi :=
      lt_of_le_of_lt (min_le_left _ _) (half_lt_self Real.pi_pos)
    have h_le_of := h_eps_bound ε₀ hε₀_pos hε₀_lt
    have h_toReal_le : m_val ≤ ε₀ / (2 * Real.pi) := by
      have h1 := ENNReal.toReal_mono ENNReal.ofReal_ne_top h_le_of
      rwa [ENNReal.toReal_ofReal (div_nonneg hε₀_pos.le Real.two_pi_pos.le)] at h1
    have hε₀_le : ε₀ ≤ Real.pi * m_val := min_le_right _ _
    have h_div_le : ε₀ / (2 * Real.pi) ≤ m_val / 2 := by
      calc
        ε₀ / (2 * Real.pi) ≤ (Real.pi * m_val) / (2 * Real.pi) :=
          div_le_div_of_nonneg_right hε₀_le Real.two_pi_pos.le
        _ = m_val / 2 := by
          have hpi : Real.pi ≠ 0 := Real.pi_pos.ne'
          field_simp [hpi]
    linarith [hm_pos]
  
  have h_walk_bc : ∀ᵐ om : WalkSpace ∂walkMeasure, goodBC (x_inf om) := by
    have h_vol_null : MeasureTheory.volume {x : ℝ | ¬ goodBC x} = 0 :=
      MeasureTheory.ae_iff.mp h_ae_bc
    exact MeasureTheory.ae_iff.mpr (h_null_avoid {x : ℝ | ¬ goodBC x} h_vol_null)
  have h_id_site : ∀ j : Fin P.N,
      ∀ᵐ om : WalkSpace ∂walkMeasure,
        v_inf j om = if 0 ≤ sgn_inf om then lim_pos j (x_inf om) else lim_neg j (x_inf om) := by
    intro j
    let B : ℝ := S.H
    have hB_nonneg : 0 ≤ B := S.H_pos.le
    let U_seq : ℕ → ℂ → ℝ := fun n => stripPoissonExt h (tr_pos j n) (tr_neg j n)
    let Δ_pos : ℕ → ℝ → ℝ := fun n x => (lim_pos j x - tr_pos j n x) ^ 2
    let Δ_neg : ℕ → ℝ → ℝ := fun n x => (lim_neg j x - tr_neg j n x) ^ 2
    let W_seq : ℕ → ℂ → ℝ := fun n => stripPoissonExt h (Δ_pos n) (Δ_neg n)
    let δ_seq : ℕ → ℝ := fun n =>
      (4 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi), (Δ_pos n x + Δ_neg n x)
    have h_dom_pt : ∀ (n : ℕ), ∀ y ∈ horizStrip h,
        (v_im j y - U_seq n y) ^ 2 ≤ W_seq n y :=
      hPoisson.slice_l2_domination (v_im j) (lim_pos j) (lim_neg j) B
        (hv_cont j) (hv_per j) hB_nonneg (hv_le_H j) (hv_harm j)
        (hlim_pos_meas j) (hlim_neg_meas j) (hlim_pos_per j) (hlim_neg_per j)
        (hlim_bdd j) (h_ae_bc.mono fun x hx => hx.1 j)
    have hΔ_pos_meas : ∀ n : ℕ, Measurable (Δ_pos n) :=
      fun n => (continuous_pow 2).measurable.comp
        ((hlim_pos_meas j).sub (htr_pos_cont j n).measurable)
    have hΔ_neg_meas : ∀ n : ℕ, Measurable (Δ_neg n) :=
      fun n => (continuous_pow 2).measurable.comp
        ((hlim_neg_meas j).sub (htr_neg_cont j n).measurable)
    have hΔ_pos_per : ∀ n : ℕ, Function.Periodic (Δ_pos n) (2 * Real.pi) := by
      intro n x
      dsimp only [Δ_pos]
      rw [hlim_pos_per j x, htr_pos_per j n x]
    have hΔ_neg_per : ∀ n : ℕ, Function.Periodic (Δ_neg n) (2 * Real.pi) := by
      intro n x
      dsimp only [Δ_neg]
      rw [hlim_neg_per j x, htr_neg_per j n x]
    have hΔ_pos_bdd : ∀ (n : ℕ) (x : ℝ), |Δ_pos n x| ≤ 4 * B ^ 2 := by
      intro n x
      have h1 := abs_le.mp (hlim_bdd j x).1
      have h2 := abs_le.mp (htr_pos_bdd j n x)
      rw [abs_of_nonneg (sq_nonneg _)]
      dsimp only [Δ_pos]
      nlinarith
    have hΔ_neg_bdd : ∀ (n : ℕ) (x : ℝ), |Δ_neg n x| ≤ 4 * B ^ 2 := by
      intro n x
      have h1 := abs_le.mp (hlim_bdd j x).2
      have h2 := abs_le.mp (htr_neg_bdd j n x)
      rw [abs_of_nonneg (sq_nonneg _)]
      dsimp only [Δ_neg]
      nlinarith
    let G_seq : ℕ → WalkSpace → ℝ := fun n om =>
      (v_inf j om - (if 0 ≤ sgn_inf om then tr_pos j n (x_inf om) else tr_neg j n (x_inf om))) ^ 2
    let G_inf : WalkSpace → ℝ := fun om =>
      (v_inf j om - (if 0 ≤ sgn_inf om then lim_pos j (x_inf om) else lim_neg j (x_inf om))) ^ 2
    have hG_le_δ : ∀ n : ℕ, (∫ om, G_seq n om ∂walkMeasure) ≤ δ_seq n := by
      intro n
      obtain ⟨hU_cont, hU_bdd, _⟩ :=
        hPoisson.cont_on_and_bound (tr_pos j n) (tr_neg j n) B
          (htr_pos_cont j n).measurable (htr_neg_cont j n).measurable
          hB_nonneg (htr_pos_bdd j n) (htr_neg_bdd j n)
      obtain ⟨hW_cont, hW_bdd, hW_harm⟩ :=
        hPoisson.cont_on_and_bound (Δ_pos n) (Δ_neg n) (4 * B ^ 2)
          (hΔ_pos_meas n) (hΔ_neg_meas n) (by positivity) (hΔ_pos_bdd n) (hΔ_neg_bdd n)
      let F_step : ℕ → WalkSpace → ℝ := fun m om =>
        (v_im j (walkPos ρ om m) - U_seq n (walkPos ρ om m)) ^ 2
      have hF_meas : ∀ m : ℕ, Measurable (F_step m) := fun m =>
        (continuous_pow 2).measurable.comp
          ((h_comp_walk_meas (hv_cont j) m).sub (h_comp_walk_meas hU_cont m))
      have hF_bdd : ∀ (m : ℕ) (om : WalkSpace), ‖F_step m om‖ ≤ 4 * B ^ 2 := by
        intro m om
        have hy : walkPos ρ om m ∈ horizStrip h := (hWalk.walk_in_reg om m).1.1
        have h1 := abs_le.mp (hv_le_H j _ hy)
        have h2 := abs_le.mp (hU_bdd _ hy)
        rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _)]
        dsimp only [F_step]
        nlinarith
      have hF_int_le : ∀ m : ℕ, (∫ om, F_step m om ∂walkMeasure) ≤ δ_seq n := by
        intro m
        have hW_exp : (∫ om, W_seq n (walkPos ρ om m) ∂walkMeasure) = δ_seq n := by
          rw [hWalk.harmonic_expectation_eq (W_seq n) (4 * B ^ 2) hW_cont hW_bdd
            (fun y hy => hW_harm y (ρ y) (h_safe_ball y hy)) m]
          exact hPoisson.real_period_integral (Δ_pos n) (Δ_neg n) (4 * B ^ 2)
            (hΔ_pos_meas n) (hΔ_neg_meas n) (hΔ_pos_per n) (hΔ_neg_per n)
            (by positivity) (hΔ_pos_bdd n) (hΔ_neg_bdd n)
        rw [← hW_exp]
        refine MeasureTheory.integral_mono ?_ ?_ (fun om =>
          h_dom_pt n _ (hWalk.walk_in_reg om m).1.1)
        · exact (MeasureTheory.integrable_const (4 * B ^ 2)).mono'
            (hF_meas m).aestronglyMeasurable (Filter.Eventually.of_forall (hF_bdd m))
        · refine (MeasureTheory.integrable_const (4 * B ^ 2)).mono'
            (h_comp_walk_meas hW_cont m).aestronglyMeasurable
            (Filter.Eventually.of_forall fun om => ?_)
          rw [Real.norm_eq_abs]
          exact hW_bdd _ (hWalk.walk_in_reg om m).1.1
      have hF_ae_conv : ∀ᵐ om : WalkSpace ∂walkMeasure,
          Filter.Tendsto (fun m : ℕ => F_step m om) Filter.atTop (nhds (G_seq n om)) := by
        refine (h_walk_ae.and
          (h_poisson_tendsto_ae (tr_pos j n) (tr_neg j n)
            (htr_pos_cont j n) (htr_neg_cont j n)
            (htr_pos_per j n) (htr_neg_per j n))).mono ?_
        intro om ⟨⟨_, _, hv_conv⟩, hU_conv⟩
        exact ((hv_conv j).sub hU_conv).pow 2
      have hF_dct : Filter.Tendsto (fun m : ℕ => ∫ om, F_step m om ∂walkMeasure)
          Filter.atTop (nhds (∫ om, G_seq n om ∂walkMeasure)) :=
        MeasureTheory.tendsto_integral_of_dominated_convergence
          (fun _ : WalkSpace => 4 * B ^ 2)
          (fun m => (hF_meas m).aestronglyMeasurable)
          (MeasureTheory.integrable_const (4 * B ^ 2))
          (fun m => Filter.Eventually.of_forall (hF_bdd m))
          hF_ae_conv
      exact le_of_tendsto' hF_dct hF_int_le
    have hδ_tendsto : Filter.Tendsto δ_seq Filter.atTop (nhds 0) := by
      have h_int_zero : Filter.Tendsto
          (fun n : ℕ => ∫ x in (0 : ℝ)..(2 * Real.pi), (Δ_pos n x + Δ_neg n x))
          Filter.atTop (nhds (∫ _x in (0 : ℝ)..(2 * Real.pi), (0 : ℝ))) := by
        refine intervalIntegral.tendsto_integral_filter_of_dominated_convergence
          (fun _ : ℝ => 8 * B ^ 2) ?_ ?_ intervalIntegrable_const ?_
        · exact Filter.Eventually.of_forall fun n =>
            ((hΔ_pos_meas n).add (hΔ_neg_meas n)).aestronglyMeasurable
        · refine Filter.Eventually.of_forall fun n => Filter.Eventually.of_forall fun x _ => ?_
          rw [Real.norm_eq_abs]
          have h1 := hΔ_pos_bdd n x
          have h2 := hΔ_neg_bdd n x
          exact le_trans (abs_add_le _ _) (by linarith)
        · refine h_ae_bc.mono fun x hx _ => ?_
          rcases hx.1 j with ⟨htp, htn⟩
          have hp0 : Filter.Tendsto (fun n : ℕ => Δ_pos n x) Filter.atTop (nhds 0) := by
            simpa [Δ_pos] using (((tendsto_const_nhds (x := lim_pos j x)).sub htp).pow 2)
          have hn0 : Filter.Tendsto (fun n : ℕ => Δ_neg n x) Filter.atTop (nhds 0) := by
            simpa [Δ_neg] using (((tendsto_const_nhds (x := lim_neg j x)).sub htn).pow 2)
          simpa using hp0.add hn0
      simpa [δ_seq] using h_int_zero.const_mul (4 * Real.pi)⁻¹
    have hv_inf_ae_bdd : ∀ᵐ om : WalkSpace ∂walkMeasure, |v_inf j om| ≤ B := by
      refine h_walk_ae.mono ?_
      intro om ⟨_, _, hv_conv⟩
      exact le_of_tendsto' (continuous_abs.continuousAt.tendsto.comp (hv_conv j))
        (fun m => hv_le_H j _ (hWalk.walk_in_reg om m).1.1)
    have hG_seq_meas : ∀ n : ℕ, Measurable (G_seq n) := by
      intro n
      have h_ite : Measurable
          (fun om : WalkSpace =>
            if 0 ≤ sgn_inf om then tr_pos j n (x_inf om) else tr_neg j n (x_inf om)) :=
        Measurable.ite (measurableSet_Ici.preimage hsgn_meas)
          ((htr_pos_cont j n).measurable.comp hx_meas)
          ((htr_neg_cont j n).measurable.comp hx_meas)
      exact (continuous_pow 2).measurable.comp ((hv_meas j).sub h_ite)
    have hG_inf_meas : Measurable G_inf := by
      have h_ite : Measurable
          (fun om : WalkSpace =>
            if 0 ≤ sgn_inf om then lim_pos j (x_inf om) else lim_neg j (x_inf om)) :=
        Measurable.ite (measurableSet_Ici.preimage hsgn_meas)
          ((hlim_pos_meas j).comp hx_meas)
          ((hlim_neg_meas j).comp hx_meas)
      exact (continuous_pow 2).measurable.comp ((hv_meas j).sub h_ite)
    have hG_seq_ae_bdd : ∀ n : ℕ, ∀ᵐ om : WalkSpace ∂walkMeasure, ‖G_seq n om‖ ≤ 4 * B ^ 2 := by
      intro n
      refine hv_inf_ae_bdd.mono fun om hvb => ?_
      have h1 := abs_le.mp hvb
      rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _)]
      dsimp only [G_seq]
      by_cases hs : 0 ≤ sgn_inf om
      · rw [if_pos hs]
        have h2 := abs_le.mp (htr_pos_bdd j n (x_inf om))
        nlinarith
      · rw [if_neg hs]
        have h2 := abs_le.mp (htr_neg_bdd j n (x_inf om))
        nlinarith
    have hG_inf_ae_bdd : ∀ᵐ om : WalkSpace ∂walkMeasure, ‖G_inf om‖ ≤ 4 * B ^ 2 := by
      refine hv_inf_ae_bdd.mono fun om hvb => ?_
      have h1 := abs_le.mp hvb
      rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _)]
      dsimp only [G_inf]
      by_cases hs : 0 ≤ sgn_inf om
      · rw [if_pos hs]
        have h2 := abs_le.mp (hlim_bdd j (x_inf om)).1
        nlinarith
      · rw [if_neg hs]
        have h2 := abs_le.mp (hlim_bdd j (x_inf om)).2
        nlinarith
    have hG_ae_conv : ∀ᵐ om : WalkSpace ∂walkMeasure,
        Filter.Tendsto (fun n : ℕ => G_seq n om) Filter.atTop (nhds (G_inf om)) := by
      refine h_walk_bc.mono fun om hbc => ?_
      rcases hbc.1 j with ⟨htp, htn⟩
      dsimp only [G_seq, G_inf]
      by_cases hs : 0 ≤ sgn_inf om
      · simp only [if_pos hs]
        exact (tendsto_const_nhds.sub htp).pow 2
      · simp only [if_neg hs]
        exact (tendsto_const_nhds.sub htn).pow 2
    have hG_dct : Filter.Tendsto (fun n : ℕ => ∫ om, G_seq n om ∂walkMeasure)
        Filter.atTop (nhds (∫ om, G_inf om ∂walkMeasure)) :=
      MeasureTheory.tendsto_integral_of_dominated_convergence
        (fun _ : WalkSpace => 4 * B ^ 2)
        (fun n => (hG_seq_meas n).aestronglyMeasurable)
        (MeasureTheory.integrable_const (4 * B ^ 2))
        hG_seq_ae_bdd
        hG_ae_conv
    have hG_inf_int_le : (∫ om, G_inf om ∂walkMeasure) ≤ 0 :=
      le_of_tendsto_of_tendsto hG_dct hδ_tendsto (Filter.Eventually.of_forall hG_le_δ)
    have hG_inf_int_zero : (∫ om, G_inf om ∂walkMeasure) = 0 :=
      le_antisymm hG_inf_int_le (MeasureTheory.integral_nonneg (fun _ => sq_nonneg _))
    have hG_inf_integrable : MeasureTheory.Integrable G_inf walkMeasure :=
      (MeasureTheory.integrable_const (4 * B ^ 2)).mono'
        hG_inf_meas.aestronglyMeasurable hG_inf_ae_bdd
    have hG_inf_ae_zero : G_inf =ᵐ[walkMeasure] 0 :=
      (MeasureTheory.integral_eq_zero_iff_of_nonneg (fun _ => sq_nonneg _)
        hG_inf_integrable).mp hG_inf_int_zero
    refine hG_inf_ae_zero.mono fun om hom => ?_
    exact sub_eq_zero.mp (sq_eq_zero_iff.mp hom)
  
  have h_id_all : ∀ᵐ om : WalkSpace ∂walkMeasure, ∀ j : Fin P.N,
      v_inf j om = if 0 ≤ sgn_inf om then lim_pos j (x_inf om) else lim_neg j (x_inf om) :=
    Filter.eventually_all.mpr h_id_site
  refine ((h_walk_ae.and h_walk_bc).and h_id_all).mono ?_
  intro om ⟨⟨⟨hsgn, _, hv_conv⟩, _, ⟨j_pos, hj_pos⟩, ⟨j_neg, hj_neg⟩⟩, h_id⟩
  have h_contact : ∃ j₀ : Fin P.N, |v_inf j₀ om| = S.H := by
    rcases hsgn with hs1 | hsn1
    · refine ⟨j_pos, ?_⟩
      rw [h_id j_pos, if_pos (by linarith)]
      exact hj_pos
    · refine ⟨j_neg, ?_⟩
      rw [h_id j_neg, if_neg (by linarith)]
      exact hj_neg
  obtain ⟨j₀, hj₀⟩ := h_contact
  have h_depth_tendsto : Filter.Tendsto
      (fun m : ℕ => sliceShapeDepth S P j₀ (walkPos ρ om m))
      Filter.atTop (nhds 0) := by
    have hc : Continuous (fun u : ℝ => S.H - |u|) := continuous_const.sub continuous_abs
    have ht := hc.continuousAt.tendsto.comp (hv_conv j₀)
    simpa only [Function.comp_def, sliceShapeDepth, hj₀, sub_self] using ht
  have h_ev_lt : ∀ᶠ m : ℕ in Filter.atTop,
      sliceShapeDepth S P j₀ (walkPos ρ om m) < Real.exp (-M) :=
    h_depth_tendsto.eventually (gt_mem_nhds (Real.exp_pos (-M)))
  obtain ⟨m, hm_lt⟩ := h_ev_lt.exists
  have h_depth_pos : 0 < sliceShapeDepth S P j₀ (walkPos ρ om m) := by
    have hlt : |v_im j₀ (walkPos ρ om m)| < S.H :=
      hv_lt_H j₀ _ (hWalk.walk_in_reg om m).1.1
    dsimp only [sliceShapeDepth, v_im] at *
    linarith
  have hM_le_log : M ≤ sliceLogDepth S P j₀ (walkPos ρ om m) := by
    have hlog : Real.log (sliceShapeDepth S P j₀ (walkPos ρ om m)) ≤ -M :=
      (Real.log_le_iff_le_exp h_depth_pos).mpr (le_of_lt hm_lt)
    dsimp only [sliceLogDepth]
    linarith
  have h_le_hist : sliceLogDepth S P j₀ (walkPos ρ om m) ≤ sliceHistory S P ρ om j₀ m :=
    Finset.le_sup' (fun n => sliceLogDepth S P j₀ (walkPos ρ om n))
      (Finset.self_mem_range_succ m)
  have h_le_sup : sliceHistory S P ρ om j₀ m ≤
      Finset.univ.sup' Finset.univ_nonempty (fun j => sliceHistory S P ρ om j m) :=
    Finset.le_sup' (fun j => sliceHistory S P ρ om j m) (Finset.mem_univ j₀)
  exact ⟨m, le_trans hM_le_log (le_trans h_le_hist h_le_sup)⟩

theorem adaptive_walk_step_and_stopping (S : FiniteWallNonisotropicStrip)
    (P : OddPeriodicSliceData S) :
    (∀ L : ℝ, Measurable (adaptiveStepRadius S P L)) ∧
    (∀ L : ℝ, 2 ≤ L → IsScaleAdmissibleStep S P (L ^ 2) (adaptiveStepRadius S P L)) ∧
    ∃ C_clk : ℝ, WalkBaseAndStopProp S P C_clk :=
by
  have hN_pos : (0 : ℝ) < (P.N : ℝ) := by
    exact_mod_cast lt_of_lt_of_le (by decide : 0 < 3) P.N_ge_three
  have ht₀_pos : 0 < sliceParamT0 P.N :=
    div_pos Real.two_pi_pos hN_pos
  have ht₀_mem : (sliceParamT0 P.N : ℂ) ∈ Metric.ball (0 : ℂ) S.r_star := by
    rw [Metric.mem_ball, dist_zero_right, Complex.norm_real, Real.norm_eq_abs, abs_of_pos ht₀_pos]
    exact P.t₀_lt_r_star
  have hh : 0 < sliceHeight S P.N :=
    lt_of_lt_of_le S.s_star_pos (S.h_X_bounds _ ht₀_mem).1
  have hTop : AdaptiveStepTopPackage S P :=
    adaptive_step_topological_admissibility S P
  have hPoisson : StripPoissonToolkitProp (sliceHeight S P.N) :=
    strip_poisson_harmonic_toolkit (sliceHeight S P.N) hh
  refine ⟨fun L => (hTop.cont L).measurable, adaptive_step_analytic_bounds S P hTop, ?_⟩
  refine ⟨2 * (sliceHeight S P.N) ^ 2, ?_⟩
  refine
    { C_clk_pos := by positivity
      walk_in_reg := fun M ρ hAdm =>
        (admissible_walk_martingale_and_wall_exit S P M ρ hAdm).walk_in_reg
      walk_stops := fun M ρ hAdm =>
        tangential_safe_boundary_stopping S P M ρ hAdm hPoisson
          (admissible_walk_martingale_and_wall_exit S P M ρ hAdm)
      walk_clock := fun M ρ hAdm =>
        (admissible_walk_martingale_and_wall_exit S P M ρ hAdm).walk_clock
      impact_sq_sum := fun M ρ hAdm =>
        (admissible_walk_martingale_and_wall_exit S P M ρ hAdm).impact_sq_sum }

theorem slice_hitting_and_clock_bounds (S : FiniteWallNonisotropicStrip)
    (P : OddPeriodicSliceData S) :
    SliceRetreatBoundProp S P ∧
    ∃ C_hit C_rem : ℝ, AdmissibleHittingAndClockProp S P C_hit C_rem :=
by
  have hTk : ShcbWalkCircleStepToolkit S P := by
    have hProbUnif : MeasureTheory.IsProbabilityMeasure unifTwoPiMeasure := by
      refine ⟨?_⟩
      simp only [unifTwoPiMeasure, MeasureTheory.Measure.smul_apply,
        MeasureTheory.Measure.restrict_apply_univ, smul_eq_mul, Real.volume_Ico, sub_zero]
      exact ENNReal.inv_mul_cancel
        (ENNReal.ofReal_pos.mpr Real.two_pi_pos).ne' ENNReal.ofReal_ne_top
    have hProbWalk : MeasureTheory.IsProbabilityMeasure walkMeasure := by
      dsimp only [walkMeasure]
      infer_instance
    have hN_pos : (0 : ℝ) < (P.N : ℝ) := by
      exact_mod_cast lt_of_lt_of_le (by norm_num : 0 < 3) P.N_ge_three
    have ht₀_pos : 0 < sliceParamT0 P.N := div_pos Real.two_pi_pos hN_pos
    have ht₀_ball : (sliceParamT0 P.N : ℂ) ∈ Metric.ball (0 : ℂ) S.r_star := by
      rw [Metric.mem_ball, dist_zero_right, Complex.norm_real, Real.norm_eq_abs, abs_of_pos ht₀_pos]
      exact P.t₀_lt_r_star
    have hHeight : S.s_star ≤ sliceHeight S P.N ∧ sliceHeight S P.N ≤ S.H :=
      S.h_X_bounds _ ht₀_ball
    have hh_pos : 0 < sliceHeight S P.N := lt_of_lt_of_le S.s_star_pos hHeight.1
    have hTubeMap : ∀ (j : ℤ) {y : ℂ}, y ∈ horizStrip (sliceHeight S P.N) →
        (y + (j : ℂ) * (sliceParamT0 P.N : ℂ), (sliceParamT0 P.N : ℂ)) ∈
          finiteWallTube S.r_star S.h_X := by
      intro j y hy
      change |y.im| < sliceHeight S P.N at hy
      rcases abs_lt.mp hy with ⟨hy1, hy2⟩
      dsimp only [sliceHeight] at hy1 hy2
      refine ⟨?_, ?_, ?_⟩
      · rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos ht₀_pos]
        exact P.t₀_lt_r_star
      · simp only [Complex.conj_ofReal, Complex.add_im, Complex.mul_im, Complex.intCast_im,
          Complex.ofReal_im, mul_zero]
        linarith
      · simp only [Complex.add_im, Complex.mul_im, Complex.intCast_im, Complex.ofReal_im,
          mul_zero]
        linarith
    have hImpactHolo : ∀ j : Fin P.N,
        DifferentiableOn ℂ (sliceImpactSeq S P.N j.val) (horizStrip (sliceHeight S P.N)) := by
      intro j
      have hAff : Differentiable ℂ
          (fun y : ℂ => (y + (j.val : ℂ) * (sliceParamT0 P.N : ℂ), (sliceParamT0 P.N : ℂ))) :=
        (differentiable_id.add (differentiable_const _)).prodMk (differentiable_const _)
      exact S.𝔰_holo.comp hAff.differentiableOn (fun y hy => hTubeMap j.val hy)
    have hImpactMaps : ∀ j : Fin P.N, ∀ y ∈ horizStrip (sliceHeight S P.N),
        sliceImpactSeq S P.N j.val y ∈ horizStrip S.H := by
      intro j y hy
      exact S.𝔰_maps_to _ (hTubeMap j.val hy)
    have hImpactReal : ∀ j : Fin P.N, ∀ x : ℝ,
        (sliceImpactSeq S P.N j.val (x : ℂ)).im = 0 ∧
        sliceShapeDepth S P j (x : ℂ) = S.H := by
      intro j x
      have hx_mem : (x : ℂ) ∈ horizStrip (sliceHeight S P.N) := by
        simp [horizStrip, hh_pos]
      have hconj := S.𝔰_conj _ (hTubeMap j.val hx_mem)
      simp only [map_add, map_mul, map_intCast, Complex.conj_ofReal] at hconj
      have him : (sliceImpactSeq S P.N j.val (x : ℂ)).im = 0 := by
        have h1 := congr_arg Complex.im hconj
        simp only [Complex.conj_im] at h1
        dsimp only [sliceImpactSeq]
        linarith
      refine ⟨him, ?_⟩
      simp [sliceShapeDepth, him]
    have hBallSub : ∀ {M : ℝ} {ρ : ℂ → ℝ}, IsScaleAdmissibleStep S P M ρ →
        ∀ {y : ℂ}, y ∈ horizStrip (sliceHeight S P.N) \ P.Z_all →
          0 < ρ y ∧ Metric.closedBall y (ρ y) ⊆ horizStrip (sliceHeight S P.N) \ P.Z_all := by
      intro M ρ hAdm y hy
      have hρ_pos : 0 < ρ y := (hAdm.pos_iff y).mpr hy
      have hle := hAdm.le_sing_dist y
      have hmin : min 1 (sliceSingDist S P y) ≤ sliceSingDist S P y := min_le_right _ _
      have hlt : ρ y < sliceSingDist S P y := by linarith
      refine ⟨hρ_pos, ?_⟩
      intro ζ hζ
      by_contra hnot
      have hdist : sliceSingDist S P y ≤ dist y ζ := Metric.infDist_le_dist_of_mem hnot
      rw [Metric.mem_closedBall, dist_comm] at hζ
      linarith
    have hClosedBallWalk : ∀ {M : ℝ} {ρ : ℂ → ℝ}, IsScaleAdmissibleStep S P M ρ →
        ∀ om : WalkSpace, ∀ m : ℕ,
          walkPos ρ om m ∈ horizStrip (sliceHeight S P.N) \ P.Z_all ∧
          0 < ρ (walkPos ρ om m) ∧
          Metric.closedBall (walkPos ρ om m) (ρ (walkPos ρ om m)) ⊆
            horizStrip (sliceHeight S P.N) \ P.Z_all := by
      intro M ρ hAdm om m
      have hmem : walkPos ρ om m ∈ horizStrip (sliceHeight S P.N) \ P.Z_all := by
        induction m with
        | zero =>
            refine ⟨?_, P.real_not_mem_Z_all (om 0)⟩
            simp [walkPos, horizStrip, hh_pos]
        | succ k ih =>
            rcases hBallSub hAdm ih with ⟨hρ_pos, hsub⟩
            apply hsub
            rw [Metric.mem_closedBall, walkPos, dist_eq_norm, add_sub_cancel_left,
              norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hρ_pos,
              Complex.norm_exp_ofReal_mul_I, mul_one]
      rcases hBallSub hAdm hmem with ⟨hpos, hsub⟩
      exact ⟨hmem, hpos, hsub⟩
    have hWalkMeas : ∀ {M : ℝ} {ρ : ℂ → ℝ}, IsScaleAdmissibleStep S P M ρ →
        ∀ m : ℕ, Measurable (fun om : WalkSpace => walkPos ρ om m) := by
      intro M ρ hAdm m
      induction m with
      | zero =>
          exact Complex.continuous_ofReal.measurable.comp (measurable_pi_apply 0)
      | succ k ih =>
          have h1 : Measurable (fun om : WalkSpace => (ρ (walkPos ρ om k) : ℂ)) :=
            Complex.continuous_ofReal.measurable.comp (hAdm.measurable.comp ih)
          have h2 : Measurable (fun om : WalkSpace => Complex.exp ((om (k + 1) : ℂ) * Complex.I)) :=
            Complex.continuous_exp.measurable.comp
              ((Complex.continuous_ofReal.measurable.comp (measurable_pi_apply (k + 1))).mul
                measurable_const)
          exact ih.add (h1.mul h2)
    have hPrefixReg : ∀ {M : ℝ} {ρ : ℂ → ℝ}, IsScaleAdmissibleStep S P M ρ →
        ∀ {α : Type} [MeasurableSpace α] {f : ℂ → α},
          Measurable (Set.domRestrict (horizStrip (sliceHeight S P.N) \ P.Z_all) f) →
          ∀ m : ℕ, shcbWalkDependsOnPrefix m (fun om => f (walkPos ρ om m)) := by
      intro M ρ hAdm α _ f hf m
      let omExt : (Finset.range (m + 1) → ℝ) → WalkSpace :=
        fun p k => if hk : k < m + 1 then p ⟨k, Finset.mem_range.mpr hk⟩ else 0
      have hOmExtMeas : Measurable omExt := by
        refine Measurable.of_eval fun k => ?_
        by_cases hk : k < m + 1
        · have hEq : (fun p : Finset.range (m + 1) → ℝ => omExt p k) =
              fun p => p ⟨k, Finset.mem_range.mpr hk⟩ := by
            ext p; dsimp only [omExt]; rw [dif_pos hk]
          rw [hEq]; exact measurable_pi_apply _
        · have hEq : (fun p : Finset.range (m + 1) → ℝ => omExt p k) = fun _ => 0 := by
            ext p; dsimp only [omExt]; rw [dif_neg hk]
          rw [hEq]; exact measurable_const
      have hWalkEq : ∀ om : WalkSpace, ∀ k ≤ m,
          walkPos ρ (omExt (Finset.restrict (Finset.range (m + 1)) om)) k = walkPos ρ om k := by
        intro om k hk
        induction k with
        | zero =>
            have h0 : 0 < m + 1 := Nat.zero_lt_succ m
            change (if hk0 : 0 < m + 1 then om 0 else 0 : ℝ) = (om 0 : ℂ)
            rw [dif_pos h0]
        | succ l ihl =>
            have hl : l ≤ m := Nat.le_of_succ_le hk
            have hl1 : l + 1 < m + 1 := Nat.succ_lt_succ hk
            have hstep : omExt (Finset.restrict (Finset.range (m + 1)) om) (l + 1) = om (l + 1) := by
              change (if h : l + 1 < m + 1 then om (l + 1) else 0) = om (l + 1)
              rw [dif_pos hl1]
            rw [walkPos, walkPos, ihl hl, hstep]
      let gSub : (Finset.range (m + 1) → ℝ) → ↥(horizStrip (sliceHeight S P.N) \ P.Z_all) :=
        fun p => ⟨walkPos ρ (omExt p) m, (hClosedBallWalk hAdm (omExt p) m).1⟩
      have hgSubMeas : Measurable gSub :=
        ((hWalkMeas hAdm m).comp hOmExtMeas).subtype_mk
      refine ⟨fun p => Set.domRestrict (horizStrip (sliceHeight S P.N) \ P.Z_all) f (gSub p),
        hf.comp hgSubMeas, ?_⟩
      intro om
      dsimp only [gSub, Set.domRestrict_apply]
      rw [hWalkEq om m le_rfl]
    have hUnifIntegral : ∀ G : ℝ → ℝ, Measurable G → (∃ B : ℝ, ∀ x : ℝ, |G x| ≤ B) →
        MeasureTheory.Integrable G unifTwoPiMeasure ∧
        (∫ x, G x ∂unifTwoPiMeasure) =
          (2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi), G x := by
      intro G hG ⟨B, hB⟩
      have hInt : MeasureTheory.Integrable G unifTwoPiMeasure :=
        MeasureTheory.Integrable.of_bound hG.aestronglyMeasurable B
          (Filter.Eventually.of_forall hB)
      refine ⟨hInt, ?_⟩
      rw [unifTwoPiMeasure, MeasureTheory.integral_smul_measure, smul_eq_mul,
        ENNReal.toReal_inv, ENNReal.toReal_ofReal Real.two_pi_pos.le,
        MeasureTheory.restrict_Ico_eq_restrict_Ioc,
        ← intervalIntegral.integral_of_le Real.two_pi_pos.le]
    have hEvalZero : ∀ F : ℝ → ℝ, Measurable F → (∃ B : ℝ, ∀ x : ℝ, |F x| ≤ B) →
        MeasureTheory.Integrable (fun om : WalkSpace => F (om 0)) walkMeasure ∧
        (∫ om, F (om 0) ∂walkMeasure) =
          (2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi), F x := by
      intro F hF ⟨B, hB⟩
      have hIntWalk : MeasureTheory.Integrable (fun om : WalkSpace => F (om 0)) walkMeasure :=
        MeasureTheory.Integrable.of_bound
          (hF.comp (measurable_pi_apply 0)).aestronglyMeasurable B
          (Filter.Eventually.of_forall fun om => hB (om 0))
      have hMap0 : MeasureTheory.Measure.map (fun om : WalkSpace => om 0) walkMeasure =
          unifTwoPiMeasure :=
        MeasureTheory.Measure.infinitePi_map_eval (fun _ : ℕ => unifTwoPiMeasure) 0
      refine ⟨hIntWalk, ?_⟩
      have h1 := (hUnifIntegral F hF ⟨B, hB⟩).2
      rw [← h1, ← hMap0,
        MeasureTheory.integral_map (measurable_pi_apply 0).aemeasurable]
      rw [hMap0]
      exact hF.aestronglyMeasurable
    have hStepPair : ∀ {𝕜 : Type} [RCLike 𝕜] {M : ℝ} {ρ : ℂ → ℝ},
        IsScaleAdmissibleStep S P M ρ →
        ∀ (n : ℕ) (H : WalkSpace → 𝕜) (K : ℂ → ℂ → 𝕜),
          shcbWalkDependsOnPrefix n H →
          (∃ B_H : ℝ, ∀ om : WalkSpace, ‖H om‖ ≤ B_H) →
          Measurable (Set.indicator
            ((horizStrip (sliceHeight S P.N) \ P.Z_all) ×ˢ
              (horizStrip (sliceHeight S P.N) \ P.Z_all))
            (fun p : ℂ × ℂ => K p.1 p.2)) →
          (∃ B_K : ℝ, ∀ y ∈ horizStrip (sliceHeight S P.N) \ P.Z_all,
            ∀ z ∈ Metric.closedBall y (ρ y), ‖K y z‖ ≤ B_K) →
          MeasureTheory.Integrable
            (fun om : WalkSpace => H om * K (walkPos ρ om n) (walkPos ρ om (n + 1))) walkMeasure ∧
          MeasureTheory.Integrable
            (fun om : WalkSpace => H om * Real.circleAverage (K (walkPos ρ om n))
              (walkPos ρ om n) (ρ (walkPos ρ om n))) walkMeasure ∧
          (∫ om, H om * K (walkPos ρ om n) (walkPos ρ om (n + 1)) ∂walkMeasure) =
            ∫ om, H om * Real.circleAverage (K (walkPos ρ om n))
              (walkPos ρ om n) (ρ (walkPos ρ om n)) ∂walkMeasure := by
      intro 𝕜 _ M ρ hAdm n H K ⟨h₀, hh₀_meas, hh₀_eq⟩ ⟨B_H, hBH⟩ hK_meas ⟨B_K, hBK⟩
      let Ω_reg := horizStrip (sliceHeight S P.N) \ P.Z_all
      have hΩ_meas : MeasurableSet Ω_reg := P.reg_open.measurableSet
      let S_ball : Set (ℂ × ℂ) := {p : ℂ × ℂ | p.1 ∈ Ω_reg ∧ p.2 ∈ Ω_reg ∧ dist p.2 p.1 ≤ ρ p.1}
      have hSet_meas : MeasurableSet S_ball := by
        have h1 : MeasurableSet {p : ℂ × ℂ | p.1 ∈ Ω_reg} := hΩ_meas.preimage measurable_fst
        have h2 : MeasurableSet {p : ℂ × ℂ | p.2 ∈ Ω_reg} := hΩ_meas.preimage measurable_snd
        have h3 : MeasurableSet {p : ℂ × ℂ | dist p.2 p.1 ≤ ρ p.1} :=
          measurableSet_le (continuous_snd.dist continuous_fst).measurable
            (hAdm.measurable.comp measurable_fst)
        exact h1.inter (h2.inter h3)
      let K_ind : ℂ × ℂ → 𝕜 := Set.indicator (Ω_reg ×ˢ Ω_reg) (fun p => K p.1 p.2)
      let K₀ : ℂ × ℂ → 𝕜 := Set.indicator S_ball K_ind
      have hK₀_meas : Measurable K₀ := hK_meas.indicator hSet_meas
      let BK' : ℝ := max B_K 0
      have hBK'_nonneg : 0 ≤ BK' := le_max_right _ _
      have hK₀_bound : ∀ p : ℂ × ℂ, ‖K₀ p‖ ≤ BK' := by
        intro p
        by_cases hp : p ∈ S_ball
        · have hp2 : p ∈ Ω_reg ×ˢ Ω_reg := ⟨hp.1, hp.2.1⟩
          simp only [K₀, K_ind, Set.indicator_of_mem hp, Set.indicator_of_mem hp2]
          exact le_trans (hBK p.1 hp.1 p.2 hp.2.2) (le_max_left _ _)
        · simp [K₀, Set.indicator_of_notMem hp, hBK'_nonneg]
      have hK₀_agree : ∀ y ∈ Ω_reg, ∀ θ : ℝ,
          K₀ (y, circleMap y (ρ y) θ) = K y (circleMap y (ρ y) θ) := by
        intro y hy θ
        rcases hBallSub hAdm hy with ⟨hρ_pos, hsub⟩
        have hdist : dist (circleMap y (ρ y) θ) y ≤ ρ y := by
          rw [dist_eq_norm, circleMap_sub_center, norm_circleMap_zero, abs_of_pos hρ_pos]
        have hz_reg : circleMap y (ρ y) θ ∈ Ω_reg := hsub hdist
        have hp1 : (y, circleMap y (ρ y) θ) ∈ S_ball := ⟨hy, hz_reg, hdist⟩
        have hp2 : (y, circleMap y (ρ y) θ) ∈ Ω_reg ×ˢ Ω_reg := ⟨hy, hz_reg⟩
        simp [K₀, K_ind, Set.indicator_of_mem hp1, Set.indicator_of_mem hp2]
      let omExt : (Finset.range (n + 1) → ℝ) → WalkSpace :=
        fun p k => if hk : k < n + 1 then p ⟨k, Finset.mem_range.mpr hk⟩ else 0
      have hOmExtMeas : Measurable omExt := by
        refine Measurable.of_eval fun k => ?_
        by_cases hk : k < n + 1
        · have hEq : (fun p : Finset.range (n + 1) → ℝ => omExt p k) =
              fun p => p ⟨k, Finset.mem_range.mpr hk⟩ := by
            ext p; dsimp only [omExt]; rw [dif_pos hk]
          rw [hEq]; exact measurable_pi_apply _
        · have hEq : (fun p : Finset.range (n + 1) → ℝ => omExt p k) = fun _ => 0 := by
            ext p; dsimp only [omExt]; rw [dif_neg hk]
          rw [hEq]; exact measurable_const
      have hWalkEq : ∀ om : WalkSpace, ∀ k ≤ n,
          walkPos ρ (omExt (Finset.restrict (Finset.range (n + 1)) om)) k = walkPos ρ om k := by
        intro om k hk
        induction k with
        | zero =>
            have h0 : 0 < n + 1 := Nat.zero_lt_succ n
            change (if hk0 : 0 < n + 1 then om 0 else 0 : ℝ) = (om 0 : ℂ)
            rw [dif_pos h0]
        | succ l ihl =>
            have hl : l ≤ n := Nat.le_of_succ_le hk
            have hl1 : l + 1 < n + 1 := Nat.succ_lt_succ hk
            have hstep : omExt (Finset.restrict (Finset.range (n + 1)) om) (l + 1) = om (l + 1) := by
              change (if h : l + 1 < n + 1 then om (l + 1) else 0) = om (l + 1)
              rw [dif_pos hl1]
            rw [walkPos, walkPos, ihl hl, hstep]
      let yPref : (Finset.range (n + 1) → ℝ) → ℂ := fun p => walkPos ρ (omExt p) n
      have hyPrefMeas : Measurable yPref := (hWalkMeas hAdm n).comp hOmExtMeas
      have hyPrefReg : ∀ p, yPref p ∈ Ω_reg := fun p => (hClosedBallWalk hAdm (omExt p) n).1
      let Φ : (Finset.range (n + 1) → ℝ) × ℝ → 𝕜 :=
        fun q => h₀ q.1 * K₀ (yPref q.1, circleMap (yPref q.1) (ρ (yPref q.1)) q.2)
      have hCircMeas : Measurable (fun q : (Finset.range (n + 1) → ℝ) × ℝ =>
          circleMap (yPref q.1) (ρ (yPref q.1)) q.2) := by
        have h1 : Measurable (fun q : (Finset.range (n + 1) → ℝ) × ℝ => yPref q.1) :=
          hyPrefMeas.comp measurable_fst
        have h2 : Measurable (fun q : (Finset.range (n + 1) → ℝ) × ℝ => (ρ (yPref q.1) : ℂ)) :=
          Complex.continuous_ofReal.measurable.comp (hAdm.measurable.comp h1)
        have h3 : Measurable (fun q : (Finset.range (n + 1) → ℝ) × ℝ =>
            Complex.exp ((q.2 : ℂ) * Complex.I)) :=
          Complex.continuous_exp.measurable.comp
            ((Complex.continuous_ofReal.measurable.comp measurable_snd).mul measurable_const)
        dsimp only [circleMap]
        exact h1.add (h2.mul h3)
      have hΦ_meas : Measurable Φ :=
        (hh₀_meas.comp measurable_fst).mul
          (hK₀_meas.comp ((hyPrefMeas.comp measurable_fst).prodMk hCircMeas))
      let BH' : ℝ := max B_H 0
      have hBH_ext : ∀ p : Finset.range (n + 1) → ℝ, ‖h₀ p‖ ≤ BH' := by
        intro p
        have hres : Finset.restrict (Finset.range (n + 1)) (omExt p) = p := by
          ext ⟨k, hk⟩
          have hk_lt : k < n + 1 := Finset.mem_range.mp hk
          change (if h : k < n + 1 then p ⟨k, Finset.mem_range.mpr h⟩ else 0) = p ⟨k, hk⟩
          rw [dif_pos hk_lt]
        have := hBH (omExt p)
        rw [hh₀_eq (omExt p), hres] at this
        exact le_trans this (le_max_left _ _)
      have hΦ_bound : ∀ q, ‖Φ q‖ ≤ BH' * BK' := by
        intro q
        dsimp only [Φ]
        rw [norm_mul]
        exact mul_le_mul (hBH_ext q.1) (hK₀_bound _) (norm_nonneg _) (le_max_right _ _)
      let fPref : WalkSpace → (Finset.range (n + 1) → ℝ) := Finset.restrict (Finset.range (n + 1))
      let fNext : WalkSpace → ℝ := fun om => om (n + 1)
      have hfPrefMeas : Measurable fPref :=
        Measurable.of_eval fun i => measurable_pi_apply i.1
      have hfNextMeas : Measurable fNext := measurable_pi_apply (n + 1)
      have hStepId : ∀ om : WalkSpace,
          H om * K (walkPos ρ om n) (walkPos ρ om (n + 1)) = Φ (fPref om, fNext om) := by
        intro om
        have hy_eq : yPref (fPref om) = walkPos ρ om n := hWalkEq om n le_rfl
        have hy_reg : walkPos ρ om n ∈ Ω_reg := (hClosedBallWalk hAdm om n).1
        have hstep : walkPos ρ om (n + 1) = circleMap (walkPos ρ om n) (ρ (walkPos ρ om n)) (om (n + 1)) := by
          simp [walkPos, circleMap]
        dsimp only [Φ, fNext]
        rw [← hh₀_eq om, hy_eq, hK₀_agree (walkPos ρ om n) hy_reg (om (n + 1)), ← hstep]
      have hIntLHS : MeasureTheory.Integrable
          (fun om : WalkSpace => H om * K (walkPos ρ om n) (walkPos ρ om (n + 1))) walkMeasure := by
        have hIntΦ : MeasureTheory.Integrable (fun om => Φ (fPref om, fNext om)) walkMeasure :=
          MeasureTheory.Integrable.of_bound
            (hΦ_meas.comp (hfPrefMeas.prodMk hfNextMeas)).aestronglyMeasurable
            (BH' * BK') (Filter.Eventually.of_forall fun om => hΦ_bound _)
        exact hIntΦ.congr (Filter.Eventually.of_forall fun om => (hStepId om).symm)
      refine ⟨hIntLHS, ?_⟩
      have hIndepAll :=
        ProbabilityTheory.iIndepFun_infinitePi
          (P := fun _ : ℕ => unifTwoPiMeasure) (X := fun _ => id) (fun _ => measurable_id)
      have hDisj : Disjoint (Finset.range (n + 1)) ({n + 1} : Finset ℕ) := by
        rw [Finset.disjoint_singleton_right, Finset.mem_range]
        omega
      have hIndepFin :=
        hIndepAll.indepFun_finset (Finset.range (n + 1)) {n + 1} hDisj
          (fun _ => measurable_pi_apply _)
      have hIndepPair : ProbabilityTheory.IndepFun fPref fNext walkMeasure :=
        hIndepFin.comp measurable_id
          (measurable_pi_apply (⟨n + 1, Finset.mem_singleton_self (n + 1)⟩ : ({n + 1} : Finset ℕ)))
      have hMapNext : MeasureTheory.Measure.map fNext walkMeasure = unifTwoPiMeasure :=
        MeasureTheory.Measure.infinitePi_map_eval (fun _ : ℕ => unifTwoPiMeasure) (n + 1)
      let μPref := MeasureTheory.Measure.map fPref walkMeasure
      have : MeasureTheory.IsProbabilityMeasure μPref :=
        ⟨by rw [MeasureTheory.Measure.map_apply hfPrefMeas MeasurableSet.univ,
              Set.preimage_univ, MeasureTheory.measure_univ]⟩
      have hMapProd : MeasureTheory.Measure.map (fun om => (fPref om, fNext om)) walkMeasure =
          μPref.prod unifTwoPiMeasure := by
        rw [← hMapNext]
        exact (ProbabilityTheory.indepFun_iff_map_prod_eq_prod_map_map
          hfPrefMeas.aemeasurable hfNextMeas.aemeasurable).mp hIndepPair
      have hIntProd : MeasureTheory.Integrable Φ (μPref.prod unifTwoPiMeasure) :=
        MeasureTheory.Integrable.of_bound hΦ_meas.aestronglyMeasurable (BH' * BK')
          (Filter.Eventually.of_forall hΦ_bound)
      have hLHS_eq : (∫ om, H om * K (walkPos ρ om n) (walkPos ρ om (n + 1)) ∂walkMeasure) =
          ∫ p, (∫ θ, Φ (p, θ) ∂unifTwoPiMeasure) ∂μPref := by
        calc
          (∫ om, H om * K (walkPos ρ om n) (walkPos ρ om (n + 1)) ∂walkMeasure)
            = ∫ om, Φ (fPref om, fNext om) ∂walkMeasure :=
              MeasureTheory.integral_congr_ae (Filter.Eventually.of_forall hStepId)
          _ = ∫ q, Φ q ∂MeasureTheory.Measure.map (fun om => (fPref om, fNext om)) walkMeasure := by
              symm
              apply MeasureTheory.integral_map (hfPrefMeas.prodMk hfNextMeas).aemeasurable
              rw [hMapProd]
              exact hΦ_meas.aestronglyMeasurable
          _ = ∫ q, Φ q ∂(μPref.prod unifTwoPiMeasure) := by rw [hMapProd]
          _ = ∫ p, (∫ θ, Φ (p, θ) ∂unifTwoPiMeasure) ∂μPref :=
              MeasureTheory.integral_prod Φ hIntProd
      have hInnerEq : ∀ p : Finset.range (n + 1) → ℝ,
          (∫ θ, Φ (p, θ) ∂unifTwoPiMeasure) =
            h₀ p * Real.circleAverage (K (yPref p)) (yPref p) (ρ (yPref p)) := by
        intro p
        have hy_reg : yPref p ∈ Ω_reg := hyPrefReg p
        calc
          (∫ θ, Φ (p, θ) ∂unifTwoPiMeasure)
            = h₀ p * ∫ θ, K₀ (yPref p, circleMap (yPref p) (ρ (yPref p)) θ) ∂unifTwoPiMeasure := by
              dsimp only [Φ]
              exact MeasureTheory.integral_const_mul (h₀ p) _
          _ = h₀ p * ((2 * Real.pi)⁻¹ •
                ∫ θ in (0 : ℝ)..(2 * Real.pi),
                  K₀ (yPref p, circleMap (yPref p) (ρ (yPref p)) θ)) := by
              congr 1
              rw [unifTwoPiMeasure, MeasureTheory.integral_smul_measure,
                ENNReal.toReal_inv, ENNReal.toReal_ofReal Real.two_pi_pos.le,
                MeasureTheory.restrict_Ico_eq_restrict_Ioc,
                ← intervalIntegral.integral_of_le Real.two_pi_pos.le]
          _ = h₀ p * Real.circleAverage (K (yPref p)) (yPref p) (ρ (yPref p)) := by
              rw [Real.circleAverage_def]
              congr 2
              apply intervalIntegral.integral_congr
              intro θ _
              exact hK₀_agree (yPref p) hy_reg θ
      let Ψ : (Finset.range (n + 1) → ℝ) → 𝕜 := fun p => ∫ θ, Φ (p, θ) ∂unifTwoPiMeasure
      have hΨ_int : MeasureTheory.Integrable Ψ μPref := hIntProd.integral_prod_left
      have hΨ_walk_int : MeasureTheory.Integrable (fun om => Ψ (fPref om)) walkMeasure :=
        (MeasureTheory.integrable_map_measure hΨ_int.aestronglyMeasurable hfPrefMeas.aemeasurable).mp
          hΨ_int
      have hAvgEq : ∀ om : WalkSpace,
          Ψ (fPref om) = H om * Real.circleAverage (K (walkPos ρ om n))
            (walkPos ρ om n) (ρ (walkPos ρ om n)) := by
        intro om
        dsimp only [Ψ]
        rw [hInnerEq (fPref om), ← hh₀_eq om]
        dsimp only [yPref, fPref]
        rw [hWalkEq om n le_rfl]
      refine ⟨?_, ?_⟩
      · exact hΨ_walk_int.congr (Filter.Eventually.of_forall hAvgEq)
      calc
        (∫ om, H om * K (walkPos ρ om n) (walkPos ρ om (n + 1)) ∂walkMeasure)
          = ∫ p, Ψ p ∂μPref := hLHS_eq
        _ = ∫ om, Ψ (fPref om) ∂walkMeasure :=
            MeasureTheory.integral_map hfPrefMeas.aemeasurable hΨ_int.aestronglyMeasurable
        _ = ∫ om, H om * Real.circleAverage (K (walkPos ρ om n))
              (walkPos ρ om n) (ρ (walkPos ρ om n)) ∂walkMeasure :=
            MeasureTheory.integral_congr_ae (Filter.Eventually.of_forall hAvgEq)
    have hHoloMeanVar : ∀ {U : Set ℂ} {f : ℂ → ℂ} {y : ℂ} {r : ℝ},
        IsOpen U → DifferentiableOn ℂ f U → 0 < r → Metric.closedBall y r ⊆ U →
        Real.circleAverage f y r = f y ∧
        Real.circleAverage (fun z => (f z).re) y r = (f y).re ∧
        Real.circleAverage (fun z => (f z).im) y r = (f y).im ∧
        Real.circleAverage (fun z => ‖f z - f y‖ ^ 2) y r =
          2 * Real.circleAverage (fun z => ((f z).im - (f y).im) ^ 2) y r ∧
        r ^ 2 * ‖deriv f y‖ ^ 2 ≤
          2 * Real.circleAverage (fun z => ((f z).im - (f y).im) ^ 2) y r := by
      intro U f y r hU hf hr hsub
      have hr_abs : |r| = r := abs_of_pos hr
      have hHoloAvg : ∀ {g : ℂ → ℂ}, DifferentiableOn ℂ g U →
          CircleIntegrable g y r ∧ Real.circleAverage g y r = g y := by
        intro g hg
        have hg_cont : ContinuousOn g (Metric.closedBall y r) := hg.continuousOn.mono hsub
        have hg_ci : CircleIntegrable g y r :=
          (hg_cont.mono Metric.sphere_subset_closedBall).circleIntegrable hr.le
        have hg_cont_abs : ContinuousOn g (Metric.closedBall y |r|) := by
          rw [hr_abs]; exact hg_cont
        have hg_avg : Real.circleAverage g y r = g y := by
          apply circleAverage_of_differentiable_on_off_countable Set.countable_empty hg_cont_abs
          intro z hz
          rw [hr_abs] at hz
          exact hg.differentiableAt (hU.mem_nhds (hsub (Metric.ball_subset_closedBall hz.1)))
        exact ⟨hg_ci, hg_avg⟩
      rcases hHoloAvg hf with ⟨hf_ci, hf_avg⟩
      have hReAvg : Real.circleAverage (fun z => (f z).re) y r = (f y).re := by
        have := ContinuousLinearMap.circleAverage_comp_comm Complex.reCLM hf_ci
        simpa [Function.comp_def, hf_avg] using this
      have hImAvg : Real.circleAverage (fun z => (f z).im) y r = (f y).im := by
        have := ContinuousLinearMap.circleAverage_comp_comm Complex.imCLM hf_ci
        simpa [Function.comp_def, hf_avg] using this
      let gSq : ℂ → ℂ := fun z => (f z - f y) ^ 2
      have hgSq_diff : DifferentiableOn ℂ gSq U :=
        (hf.sub (differentiableOn_const (f y))).pow 2
      rcases hHoloAvg hgSq_diff with ⟨hgSq_ci, hgSq_avg⟩
      have hgSq_re_avg : Real.circleAverage (fun z => (gSq z).re) y r = 0 := by
        have := ContinuousLinearMap.circleAverage_comp_comm Complex.reCLM hgSq_ci
        simpa [Function.comp_def, gSq, hgSq_avg] using this
      have hImSq_ci : CircleIntegrable (fun z => ((f z).im - (f y).im) ^ 2) y r :=
        (((Complex.continuous_im.comp_continuousOn (hf.continuousOn.mono hsub)).sub
          continuousOn_const).pow 2 |>.mono Metric.sphere_subset_closedBall).circleIntegrable hr.le
      have hReSq_ci : CircleIntegrable (fun z => (gSq z).re) y r :=
        ((Complex.continuous_re.comp_continuousOn (hgSq_diff.continuousOn.mono hsub)).mono
          Metric.sphere_subset_closedBall).circleIntegrable hr.le
      let fImSq : ℂ → ℝ := fun z => ((f z).im - (f y).im) ^ 2
      have hNormSqId : (fun z => ‖f z - f y‖ ^ 2) =
          ((fImSq + fImSq) + (fun z => (gSq z).re)) := by
        ext z
        have hsq : (gSq z).re = ((f z).re - (f y).re) ^ 2 - ((f z).im - (f y).im) ^ 2 := by
          dsimp only [gSq]
          rw [sq, Complex.mul_re, Complex.sub_re, Complex.sub_im]
          ring
        have hn : ‖f z - f y‖ ^ 2 = ((f z).re - (f y).re) ^ 2 + ((f z).im - (f y).im) ^ 2 := by
          rw [← Complex.normSq_eq_norm_sq, Complex.normSq_apply, Complex.sub_re, Complex.sub_im]
          ring
        dsimp only [Pi.add_apply, fImSq]
        linarith
      have hVarEq : Real.circleAverage (fun z => ‖f z - f y‖ ^ 2) y r =
          2 * Real.circleAverage fImSq y r := by
        rw [hNormSqId, Real.circleAverage_add (hImSq_ci.add hImSq_ci) hReSq_ci,
          Real.circleAverage_add hImSq_ci hImSq_ci, hgSq_re_avg, add_zero]
        ring
      let hSub : ℂ → ℂ := fun z => f z - f y
      have hhSub_diff : DifferentiableOn ℂ hSub (Metric.closedBall y r) :=
        (hf.sub (differentiableOn_const (f y))).mono hsub
      have hCauchy := DifferentiableOn.deriv_eq_smul_circleIntegral hr hhSub_diff
      have hDerivEq : deriv hSub y = deriv f y := deriv_sub_const (f := f) (f y)
      rw [hDerivEq] at hCauchy
      have hNormCauchy : 2 * Real.pi * ‖deriv f y‖ ≤
          ∫ θ in (0 : ℝ)..(2 * Real.pi), r⁻¹ * ‖f (circleMap y r θ) - f y‖ := by
        have hLHS : ‖(2 * (Real.pi : ℂ) * Complex.I) • deriv f y‖ = 2 * Real.pi * ‖deriv f y‖ := by
          rw [norm_smul, norm_mul, norm_mul, Complex.norm_ofNat, Complex.norm_real,
            Real.norm_eq_abs, abs_of_pos Real.pi_pos, Complex.norm_I, mul_one]
        rw [← hLHS, ← hCauchy, circleIntegral]
        refine le_trans (intervalIntegral.norm_integral_le_integral_norm Real.two_pi_pos.le) ?_
        have hEqNorm : ∀ θ : ℝ,
            ‖deriv (circleMap y r) θ • ((1 / (circleMap y r θ - y) ^ 2) • hSub (circleMap y r θ))‖ =
              r⁻¹ * ‖f (circleMap y r θ) - f y‖ := by
          intro θ
          rw [deriv_circleMap, circleMap_sub_center, smul_smul, norm_smul, norm_mul, norm_mul,
            norm_div, norm_one, norm_pow, norm_circleMap_zero, abs_of_pos hr, Complex.norm_I,
            mul_one]
          have hr_ne : r ≠ 0 := hr.ne'
          dsimp only [hSub]
          field_simp
        rw [intervalIntegral.integral_congr (fun θ _ => hEqNorm θ)]
      let μ : ℝ := Real.circleAverage (fun z => ‖f z - f y‖) y r
      have hμ_bound : r * ‖deriv f y‖ ≤ μ := by
        have hIntPull : (∫ θ in (0 : ℝ)..(2 * Real.pi), r⁻¹ * ‖f (circleMap y r θ) - f y‖) =
            r⁻¹ * (2 * Real.pi * μ) := by
          dsimp only [μ]
          rw [intervalIntegral.integral_const_mul, Real.circleAverage_def, smul_eq_mul]
          have h2pi_ne : 2 * Real.pi ≠ 0 := Real.two_pi_pos.ne'
          field_simp
        rw [hIntPull] at hNormCauchy
        have h1 : r * (2 * Real.pi * ‖deriv f y‖) ≤ r * (r⁻¹ * (2 * Real.pi * μ)) :=
          mul_le_mul_of_nonneg_left hNormCauchy hr.le
        have hr_ne : r ≠ 0 := hr.ne'
        have h2 : r * (r⁻¹ * (2 * Real.pi * μ)) = 2 * Real.pi * μ := by field_simp
        rw [h2] at h1
        nlinarith [Real.pi_pos]
      have hμ_nonneg : 0 ≤ μ := by
        dsimp only [μ]
        rw [Real.circleAverage_def, smul_eq_mul]
        exact mul_nonneg (inv_nonneg.mpr Real.two_pi_pos.le)
          (intervalIntegral.integral_nonneg Real.two_pi_pos.le fun θ _ => norm_nonneg _)
      have hJensen : μ ^ 2 ≤ Real.circleAverage (fun z => ‖f z - f y‖ ^ 2) y r := by
        let gθ : ℝ → ℝ := fun θ => ‖f (circleMap y r θ) - f y‖
        have hgθ_cont : Continuous gθ := by
          refine continuous_norm.comp (Continuous.sub ?_ continuous_const)
          exact (hf.continuousOn.mono hsub).comp_continuous (continuous_circleMap y r)
            (fun θ => circleMap_mem_closedBall y hr.le θ)
        have hNonneg : 0 ≤ ∫ θ in (0 : ℝ)..(2 * Real.pi), (gθ θ - μ) ^ 2 :=
          intervalIntegral.integral_nonneg Real.two_pi_pos.le fun θ _ => sq_nonneg _
        have hExpand : (∫ θ in (0 : ℝ)..(2 * Real.pi), (gθ θ - μ) ^ 2) =
            (∫ θ in (0 : ℝ)..(2 * Real.pi), gθ θ ^ 2) -
              2 * μ * (∫ θ in (0 : ℝ)..(2 * Real.pi), gθ θ) + 2 * Real.pi * μ ^ 2 := by
          have hIntA : IntervalIntegrable (fun θ => gθ θ ^ 2 - 2 * μ * gθ θ)
              MeasureTheory.volume 0 (2 * Real.pi) :=
            ((hgθ_cont.pow 2).sub (continuous_const.mul hgθ_cont)).intervalIntegrable _ _
          have hIntB : IntervalIntegrable (fun _ : ℝ => μ ^ 2)
              MeasureTheory.volume 0 (2 * Real.pi) := intervalIntegrable_const
          have h1 : (fun θ => (gθ θ - μ) ^ 2) =
              (fun θ => (gθ θ ^ 2 - 2 * μ * gθ θ) + μ ^ 2) := by ext θ; ring
          have hSubEq := intervalIntegral.integral_sub (μ := MeasureTheory.volume)
            (f := fun θ => gθ θ ^ 2) (g := fun θ => 2 * μ * gθ θ)
            ((hgθ_cont.pow 2).intervalIntegrable 0 (2 * Real.pi))
            ((continuous_const.mul hgθ_cont).intervalIntegrable 0 (2 * Real.pi))
          rw [h1, intervalIntegral.integral_add hIntA hIntB, hSubEq,
            intervalIntegral.integral_const_mul, intervalIntegral.integral_const,
            sub_zero, smul_eq_mul]
        have hInt1 : (∫ θ in (0 : ℝ)..(2 * Real.pi), gθ θ) = 2 * Real.pi * μ := by
          dsimp only [μ, gθ]
          rw [Real.circleAverage_def, smul_eq_mul]
          have h2pi_ne : 2 * Real.pi ≠ 0 := Real.two_pi_pos.ne'
          field_simp
        have hInt2 : (∫ θ in (0 : ℝ)..(2 * Real.pi), gθ θ ^ 2) =
            2 * Real.pi * Real.circleAverage (fun z => ‖f z - f y‖ ^ 2) y r := by
          dsimp only [gθ]
          rw [Real.circleAverage_def, smul_eq_mul]
          have h2pi_ne : 2 * Real.pi ≠ 0 := Real.two_pi_pos.ne'
          field_simp
        rw [hExpand, hInt1, hInt2] at hNonneg
        nlinarith [Real.pi_pos]
      have hDerivSq : r ^ 2 * ‖deriv f y‖ ^ 2 ≤ μ ^ 2 := by
        have hprod : 0 ≤ r * ‖deriv f y‖ := mul_nonneg hr.le (norm_nonneg _)
        nlinarith
      exact ⟨hf_avg, hReAvg, hImAvg, hVarEq, le_trans hDerivSq (hVarEq ▸ hJensen)⟩
    exact ⟨hProbWalk, hHeight, hImpactHolo, hImpactMaps, hImpactReal,
      hClosedBallWalk, hWalkMeas, hPrefixReg, hEvalZero, hStepPair, hHoloMeanVar⟩
  have : MeasureTheory.IsProbabilityMeasure walkMeasure := hTk.isProbWalk
  have hMeasIndCont : ∀ {α β : Type} [TopologicalSpace α] [MeasurableSpace α]
      [OpensMeasurableSpace α] [TopologicalSpace β] [mβ : MeasurableSpace β] [BorelSpace β] [Zero β]
      {V : Set α} {g : α → β}, IsOpen V → ContinuousOn g V → Measurable (Set.indicator V g) := by
    intro α β _ _ _ _ mβ hBorel _ V g hV hg
    have hmβ : mβ = borel β := hBorel.measurable_eq
    subst hmβ
    refine measurable_generateFrom fun U hU => ?_
    classical
    have hEq : Set.indicator V g ⁻¹' U =
        (V ∩ g ⁻¹' U) ∪ (if (0 : β) ∈ U then Vᶜ else ∅) := by
      ext x
      by_cases hx : x ∈ V
      · simp [hx]
      · simp [hx]
    rw [hEq]
    refine (hg.isOpen_inter_preimage hV hU).measurableSet.union ?_
    split_ifs
    · exact hV.measurableSet.compl
    · exact MeasurableSet.empty
  have hPrefMono : ∀ {α : Type} [MeasurableSpace α] {m n : ℕ} {H : WalkSpace → α},
      m ≤ n → shcbWalkDependsOnPrefix m H → shcbWalkDependsOnPrefix n H := by
    intro α _ m n H hmn ⟨h₀, hh₀_meas, hh₀_eq⟩
    let res : (Finset.range (n + 1) → ℝ) → (Finset.range (m + 1) → ℝ) :=
      fun p k => p ⟨k.1, Finset.mem_range.mpr
        (lt_of_lt_of_le (Finset.mem_range.mp k.2) (Nat.succ_le_succ hmn))⟩
    have hres_meas : Measurable res := Measurable.of_eval fun _ => measurable_pi_apply _
    exact ⟨h₀ ∘ res, hh₀_meas.comp hres_meas, fun om => hh₀_eq om⟩
  have hPrefMeas : ∀ {α : Type} [MeasurableSpace α] {n : ℕ} {H : WalkSpace → α},
      shcbWalkDependsOnPrefix n H → Measurable H := by
    intro α _ n H ⟨h₀, hh₀_m, hh₀_eq⟩
    have hRes : Measurable (Finset.restrict (Finset.range (n + 1)) : WalkSpace → _) :=
      Measurable.of_eval fun k => measurable_pi_apply k.1
    have hEq : H = h₀ ∘ Finset.restrict (Finset.range (n + 1)) := funext hh₀_eq
    rw [hEq]
    exact hh₀_m.comp hRes
  have hPrefPair : ∀ {α β γ : Type} [MeasurableSpace α] [MeasurableSpace β] [MeasurableSpace γ]
      {n : ℕ} {op : α → β → γ} {H₁ : WalkSpace → α} {H₂ : WalkSpace → β},
      Measurable (fun p : α × β => op p.1 p.2) →
      shcbWalkDependsOnPrefix n H₁ → shcbWalkDependsOnPrefix n H₂ →
      shcbWalkDependsOnPrefix n (fun om => op (H₁ om) (H₂ om)) := by
    intro α β γ _ _ _ n op H₁ H₂ hop ⟨h₁, hh₁_m, hh₁_eq⟩ ⟨h₂, hh₂_m, hh₂_eq⟩
    exact ⟨fun p => op (h₁ p) (h₂ p), hop.comp (hh₁_m.prodMk hh₂_m),
      fun om => by simp [hh₁_eq om, hh₂_eq om]⟩
  have hPrefComp : ∀ {α β : Type} [MeasurableSpace α] [MeasurableSpace β]
      {n : ℕ} {g : α → β} {H : WalkSpace → α},
      Measurable g → shcbWalkDependsOnPrefix n H → shcbWalkDependsOnPrefix n (fun om => g (H om)) := by
    intro α β _ _ n g H hg ⟨h₀, hh₀_m, hh₀_eq⟩
    exact ⟨g ∘ h₀, hg.comp hh₀_m, fun om => by simp [hh₀_eq om]⟩
  have hPrefConst : ∀ {α : Type} [MeasurableSpace α] (n : ℕ) (c : α),
      shcbWalkDependsOnPrefix n (fun _ => c) :=
    fun n c => ⟨fun _ => c, measurable_const, fun _ => rfl⟩
  have hPrefSum : ∀ {ι : Type} (s : Finset ι) {n : ℕ} {f : ι → WalkSpace → ℝ},
      (∀ x ∈ s, shcbWalkDependsOnPrefix n (f x)) →
      shcbWalkDependsOnPrefix n (fun om => ∑ x ∈ s, f x om) := by
    intro ι s n f hf
    classical
    induction s using Finset.induction_on with
    | empty =>
        simpa using hPrefConst n (0 : ℝ)
    | @insert a s' ha ih =>
        have ha_p : shcbWalkDependsOnPrefix n (f a) := hf a (Finset.mem_insert_self a s')
        have hs_p : shcbWalkDependsOnPrefix n (fun om => ∑ x ∈ s', f x om) :=
          ih (fun x hx => hf x (Finset.mem_insert_of_mem hx))
        rcases hPrefPair measurable_add ha_p hs_p with ⟨h₀, hh₀_m, hh₀_eq⟩
        refine ⟨h₀, hh₀_m, fun om => ?_⟩
        change ∑ x ∈ insert a s', f x om = h₀ (Finset.restrict (Finset.range (n + 1)) om)
        rw [Finset.sum_insert ha]
        exact hh₀_eq om
  have hEvMono : ∀ {m n : ℕ} {A : Set WalkSpace},
      m ≤ n → shcbWalkPrefixEvent m A → shcbWalkPrefixEvent n A := by
    intro m n A hmn ⟨S₀, hS₀, hEq⟩
    let res : (Finset.range (n + 1) → ℝ) → (Finset.range (m + 1) → ℝ) :=
      fun p k => p ⟨k.1, Finset.mem_range.mpr
        (lt_of_lt_of_le (Finset.mem_range.mp k.2) (Nat.succ_le_succ hmn))⟩
    have hres_meas : Measurable res := Measurable.of_eval fun _ => measurable_pi_apply _
    refine ⟨res ⁻¹' S₀, hS₀.preimage hres_meas, ?_⟩
    ext om
    simp [hEq, res, Finset.restrict_def]
  have hEvUniv : ∀ n : ℕ, shcbWalkPrefixEvent n Set.univ :=
    fun n => ⟨Set.univ, MeasurableSet.univ, rfl⟩
  have hEvCompl : ∀ {n : ℕ} {A : Set WalkSpace},
      shcbWalkPrefixEvent n A → shcbWalkPrefixEvent n Aᶜ :=
    fun ⟨S₀, hS₀, hEq⟩ => ⟨S₀ᶜ, hS₀.compl, by rw [hEq]; rfl⟩
  have hEvInter : ∀ {n : ℕ} {A B : Set WalkSpace},
      shcbWalkPrefixEvent n A → shcbWalkPrefixEvent n B → shcbWalkPrefixEvent n (A ∩ B) :=
    fun ⟨S₁, hS₁, hEq₁⟩ ⟨S₂, hS₂, hEq₂⟩ =>
      ⟨S₁ ∩ S₂, hS₁.inter hS₂, by rw [hEq₁, hEq₂]; rfl⟩
  have hEvUnion : ∀ {n : ℕ} {A B : Set WalkSpace},
      shcbWalkPrefixEvent n A → shcbWalkPrefixEvent n B → shcbWalkPrefixEvent n (A ∪ B) :=
    fun ⟨S₁, hS₁, hEq₁⟩ ⟨S₂, hS₂, hEq₂⟩ =>
      ⟨S₁ ∪ S₂, hS₁.union hS₂, by rw [hEq₁, hEq₂]; rfl⟩
  have hEvBiInter : ∀ {ι : Type} (s : Finset ι) {n : ℕ} {A : ι → Set WalkSpace},
      (∀ x ∈ s, shcbWalkPrefixEvent n (A x)) →
      shcbWalkPrefixEvent n {om | ∀ x ∈ s, om ∈ A x} := by
    intro ι s n A hA
    classical
    induction s using Finset.induction_on with
    | empty =>
        have : {om : WalkSpace | ∀ x ∈ (∅ : Finset ι), om ∈ A x} = Set.univ := by ext; simp
        rw [this]; exact hEvUniv n
    | @insert a s' ha ih =>
        have hEq : {om : WalkSpace | ∀ x ∈ insert a s', om ∈ A x} =
