                        rw [add_pow]
                  _ = MvPowerSeries.C (PowerSeries.C (1 / (s.factorial : ℂ)) * A s) * Ψ_lift ^ s := by
                        rw [hZ_sub]
      rw [hsum_swap, map_sum, map_sum]
      have htrunc_d :
          (∑ s ∈ Finset.range (N + 1),
            PowerSeries.coeff l₀
              (MvPowerSeries.coeff d
