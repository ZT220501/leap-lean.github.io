  have hFtilde_strip : ∀ p ∈ D_a ×ˢ Metric.ball (0 : ℂ) 1, F_tilde p ∈ horizStrip S.H := by
    rintro ⟨a, ζ⟩ ⟨ha, hζ⟩
    have hζ_norm : ‖ζ‖ < 1 := by simpa [Metric.mem_ball, dist_zero_right] using hζ
    let w : ℂ := starRingEnd ℂ ζ
    have hw_ball : w ∈ Metric.ball (0 : ℂ) 1 := by
      rw [Metric.mem_ball, dist_zero_right, RCLike.norm_conj]
      exact hζ_norm
    let P_ζ : ℝ → ℝ := fun θ => (1 - ‖ζ‖ ^ 2) / ‖circleMap 0 1 θ - ζ‖ ^ 2
    have h_sub_pos : ∀ θ : ℝ, 0 < ‖circleMap 0 1 θ - ζ‖ := by
      intro θ
      have h1 : ‖circleMap 0 1 θ‖ = 1 := by simp [norm_circleMap_zero]
      have h2 : ‖circleMap 0 1 θ‖ - ‖ζ‖ ≤ ‖circleMap 0 1 θ - ζ‖ :=
        norm_sub_norm_le (circleMap 0 1 θ) ζ
      linarith
    have h_sub_ne : ∀ θ : ℝ, circleMap 0 1 θ - ζ ≠ 0 :=
      fun θ => norm_pos_iff.mp (h_sub_pos θ)
    have h_one_sub_ne : ∀ θ : ℝ, 1 - w * circleMap 0 1 θ ≠ 0 := by
      intro θ hsub
      have hmul : w * circleMap 0 1 θ = 1 := (sub_eq_zero.mp hsub).symm
      have h1 : ‖w * circleMap 0 1 θ‖ = 1 := by rw [hmul, norm_one]
      have hcm : ‖circleMap 0 1 θ‖ = 1 := by simp [norm_circleMap_zero]
      rw [norm_mul, hcm, mul_one, RCLike.norm_conj] at h1
      linarith
    have hP_nonneg : ∀ θ : ℝ, 0 ≤ P_ζ θ := by
      intro θ
      exact div_nonneg (by nlinarith [norm_nonneg ζ]) (sq_nonneg _)
    have hP_cont : Continuous P_ζ :=
      continuous_const.div
        (((continuous_circleMap 0 1).sub continuous_const).norm.pow 2)
        (fun θ => pow_ne_zero 2 (h_sub_pos θ).ne')
    have h_kernel_eq : ∀ θ : ℝ,
        circleMap 0 1 θ / (circleMap 0 1 θ - ζ) +
          w * circleMap 0 1 θ / (1 - w * circleMap 0 1 θ) =
        ((P_ζ θ : ℝ) : ℂ) := by
      intro θ
      set z : ℂ := circleMap 0 1 θ
      have hz_norm : ‖z‖ = 1 := by simp [z, norm_circleMap_zero]
      have hz_ne : z ≠ 0 := norm_pos_iff.mp (by linarith)
      have hz_conj : z * starRingEnd ℂ z = 1 := by
        rw [Complex.mul_conj, Complex.normSq_eq_norm_sq, hz_norm, one_pow, Complex.ofReal_one]
      have hζ_conj : ζ * w = ((‖ζ‖ ^ 2 : ℝ) : ℂ) := by
        dsimp [w]
        rw [Complex.mul_conj, Complex.normSq_eq_norm_sq]
      have hdiff_conj : (z - ζ) * (starRingEnd ℂ z - w) = ((‖z - ζ‖ ^ 2 : ℝ) : ℂ) := by
        dsimp [w]
        rw [← map_sub, Complex.mul_conj, Complex.normSq_eq_norm_sq]
      have hden_fact : 1 - w * z = z * (starRingEnd ℂ z - w) := by
        calc
          1 - w * z = z * starRingEnd ℂ z - w * z := by rw [hz_conj]
          _ = z * (starRingEnd ℂ z - w) := by ring
      have hconj_sub_ne : starRingEnd ℂ z - w ≠ 0 := by
        intro h0
        apply h_one_sub_ne θ
        change 1 - w * z = 0
        rw [hden_fact, h0, mul_zero]
      have h_second : w * z / (1 - w * z) = w / (starRingEnd ℂ z - w) := by
        rw [hden_fact, mul_comm w z, mul_div_mul_left w _ hz_ne]
      rw [h_second, div_add_div _ _ (h_sub_ne θ) hconj_sub_ne, hdiff_conj]
      have hnum_eq : z * (starRingEnd ℂ z - w) + (z - ζ) * w = 1 - ((‖ζ‖ ^ 2 : ℝ) : ℂ) := by
        calc
          z * (starRingEnd ℂ z - w) + (z - ζ) * w = z * starRingEnd ℂ z - ζ * w := by ring
          _ = 1 - ((‖ζ‖ ^ 2 : ℝ) : ℂ) := by rw [hz_conj, hζ_conj]
      rw [hnum_eq]
      dsimp [P_ζ, z]
      push_cast
      rfl

    have h_int_1 :
        (∫ θ in (0 : ℝ)..(2 * Real.pi),
          circleMap 0 1 θ / (circleMap 0 1 θ - ζ)) = 2 * (Real.pi : ℂ) := by
      have hc := circleIntegral.integral_sub_inv_of_mem_ball hζ
      unfold circleIntegral at hc
      simp only [deriv_circleMap, smul_eq_mul] at hc
      have h_congr : ∀ θ : ℝ,
          circleMap 0 1 θ * Complex.I * (circleMap 0 1 θ - ζ)⁻¹ =
            Complex.I * (circleMap 0 1 θ / (circleMap 0 1 θ - ζ)) := by
        intro θ; rw [div_eq_mul_inv]; ring
      simp_rw [h_congr, intervalIntegral.integral_const_mul] at hc
      apply mul_left_cancel₀ Complex.I_ne_zero
      linear_combination hc

    have h_int_2 :
        (∫ θ in (0 : ℝ)..(2 * Real.pi),
          w * circleMap 0 1 θ / (1 - w * circleMap 0 1 θ)) = 0 := by
      obtain ⟨ρ_w, h1_lt_ρw, _, hkw_holo⟩ := h_conj_kernel_holo w hw_ball
      have hkw_dc : DiffContOnCl ℂ (fun z => w / (1 - w * z)) (Metric.ball (0 : ℂ) 1) :=
        hkw_holo.diffContOnCl_ball (Metric.closedBall_subset_ball h1_lt_ρw)
      have hz := DiffContOnCl.circleIntegral_eq_zero zero_le_one hkw_dc
      unfold circleIntegral at hz
      simp only [deriv_circleMap, smul_eq_mul] at hz
      have h_congr : ∀ θ : ℝ,
