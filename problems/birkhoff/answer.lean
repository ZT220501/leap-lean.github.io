      _ = B := by rw [MeasureTheory.integral_const_mul, hκ_one m hm, mul_one]
  let C_pred : ℕ → (ℕ → ℝ) → Prop := fun j w => ¬ E_pred j w
  let ξ_inc : ℕ → (ℕ → ℝ) → ℝ := fun j w =>
    if C_pred j w then g (j + 1) (w (j + 1)) - g_bar j (w j) else 0
  let Z_mart : ℕ → (ℕ → ℝ) → ℝ := fun k w => ∑ j ∈ Finset.range k, ξ_inc j w
  let A_surv : ℕ → (ℕ → ℝ) → Prop := fun k w => ∀ i ∈ Finset.range (k + 1), -(R - h) < Z_mart i w
  let Y_stop : ℕ → (ℕ → ℝ) → ℝ := fun k w =>
    ∑ j ∈ Finset.range k, (if A_surv j w then ξ_inc j w else 0)
  have hξ_meas : ∀ j < M, Measurable (ξ_inc j) := by
    intro j hj
    exact Measurable.ite (hE_meas j (by omega)).compl
      ((hMeasG (j + 1) (by omega)).sub ((hgbar_meas j hj).comp (measurable_pi_apply j)))
      measurable_const
  have hξ_bdd : ∀ j < M, ∀ w : ℕ → ℝ, |ξ_inc j w| ≤ 2 * B := by
    intro j hj w; simp only [ξ_inc]; split_ifs
    · have h1 := hg_bdd (j + 1) (by omega) (w (j + 1))
