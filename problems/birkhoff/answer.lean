            rw [Finset.sum_range_sub J_step (j + 1)]
            ring
          have h_norm_tel : ‖J_step (j + 1) - 1‖ ≤
              ‖J_step 0 - 1‖ + ∑ m ∈ Finset.range (j + 1), ‖J_step (m + 1) - J_step m‖ := by
            rw [h_tel]
            exact le_trans (norm_add_le _ _)
