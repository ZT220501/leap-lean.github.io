      IsBoundedStripExt (m + 15) σ M₁ w W →
      (∀ n : ℕ, IsStripMeshDispBall (m + 2) q σ_mesh R_strip (stripMeshIter_ℂ J_C q W n)) ∧
      IsStripMeshDispBall (m + 2) q σ_mesh R_strip (stripCanonDisp_ℂ J_C q W) ∧
      (∀ j : ℕ, j ≤ q → ∀ k : ℕ, ∀ z ∈ horizStrip σ_mesh,
        Filter.Tendsto (fun n => iteratedDeriv k (stripMeshIter_ℂ J_C q W n j) z) Filter.atTop
          (nhds (iteratedDeriv k (stripCanonDisp_ℂ J_C q W j) z))) ∧
      (∀ j : ℕ, j + 1 < q → ∀ z ∈ horizStrip σ_mesh,
        stripCanonDisp_ℂ J_C q W (j + 2) z -
          2 * stripCanonDisp_ℂ J_C q W (j + 1) z +
          stripCanonDisp_ℂ J_C q W j z =
          stripForcingAt_ℂ J_C q W (stripCanonDisp_ℂ J_C q W) j z) := by
    intro w W hw hW
    let d : ℕ → ℕ → ℂ → ℂ := stripMeshIter_ℂ J_C q W
    let d_star : ℕ → ℂ → ℂ := stripCanonDisp_ℂ J_C q W
    have hd_iter_ball : ∀ n : ℕ, IsStripMeshDispBall (m + 2) q σ_mesh R_strip (d n) := by
      intro n
      induction n with
      | zero =>
        refine ⟨fun _ => ⟨rfl, rfl⟩, fun _ _ _ => rfl, ?_, ?_⟩
        · intro j _
          refine ⟨differentiableOn_const 0, fun _ _ => rfl, ?_, ?_⟩
          · intro _ _
            simp [d, stripMeshIter_ℂ]
          · intro k _ z _
            change (q : ℝ) ^ 2 * ‖iteratedDeriv k (fun _ : ℂ => (0 : ℂ)) z‖ ≤ R_strip
            rw [iteratedDeriv_const]
            split_ifs <;> simp [le_of_lt hR_pos]
        · intro j _ k _ z _
          have hZeroFn : (fun ζ : ℂ => d 0 (j + 1) ζ - d 0 j ζ) = (fun _ : ℂ => (0 : ℂ)) := by
            ext ζ
            simp [d, stripMeshIter_ℂ]
          rw [hZeroFn, iteratedDeriv_const]
          split_ifs <;> simp [le_of_lt hR_pos]
