    have h4 := hCalc.comp_bnd m σ' (Real.exp R_W) (2 * M) V_W Complex.exp (fun z => 2 * W₂ z)
      Metric.isOpen_ball (Real.exp_nonneg _) (by linarith) hExpBall.1
      (fun j _ w hw => hExpBall.2 j w hw) h2W2_bnd.1
      (fun z hz => Metric.mem_ball.mpr (by rw [dist_zero_right]; linarith [hBndPt h2W2_bnd z hz]))
      (fun j _ hjm z hz => h2W2_bnd.2 j hjm z hz)
    have hDiff2 := hCalc.comp_diff_bnd m σ' (Real.exp R_W) 0 (2 * M) (2 * Δ) V_W
      Complex.exp Complex.exp (fun z => 2 * W₁ z) (fun z => 2 * W₂ z)
      Metric.isOpen_ball (convex_ball 0 R_W) (Real.exp_nonneg _) le_rfl (by linarith) (by linarith)
      hExpBall.1 hExpBall.1 (fun j _ _ _ => by simp [sub_self])
      (fun j _ w hw => hExpBall.2 j w hw) h2W1_bnd.1 h2W2_bnd.1
      (fun z hz => Metric.mem_ball.mpr (by rw [dist_zero_right]; linarith [hBndPt h2W1_bnd z hz]))
      (fun z hz => Metric.mem_ball.mpr (by rw [dist_zero_right]; linarith [hBndPt h2W2_bnd z hz]))
      (fun j _ hjm z hz => h2W1_bnd.2 j hjm z hz)
      (fun j _ hjm z hz => h2W2_bnd.2 j hjm z hz)
      h2Wdiff
    have hL2_eq : skrCompConst m (2 * M) * (0 + (2 : ℝ) ^ m * Real.exp R_W * (2 * Δ)) =
        L_eW2 * Δ := by
      dsimp [L_eW2]; ring
    rw [hL2_eq] at hDiff2
    exact ⟨⟨h1, h2, hDiff1⟩, ⟨h3, h4, hDiff2⟩⟩

  
  
  
  obtain ⟨B_sl, L_sl, hBsl_nn, hLsl_nn, hSlopePair, hSlopeCont⟩ := hSlopeProps
  obtain ⟨B_eW1, L_eW1, B_eW2, L_eW2, hBeW1_nn, hLeW1_nn, hBeW2_nn, hLeW2_nn, hExpW⟩ := hExpWPair
  
  have hRE_ex :
