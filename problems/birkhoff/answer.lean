        (Classical.choose_spec (Classical.choose_spec (hcoeff_frac d))).2
      let Q_tilde : Fin (D₀ + 1) → MvPolynomial ι_all (↥K₀) := fun d =>
        A_d d * ∏ d' ∈ Finset.univ.erase d, B_d d'
      let B_prod : ℂ := ∏ d' : Fin (D₀ + 1), ev_pt (B_d d')
