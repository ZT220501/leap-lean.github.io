              _ = (C_res / (2 * α * γ_steep)) * ‖t‖ ^ 2 * M_scale ^ 2 *
                    (D (j + 2)) ^ (-2 * α) := by ring
          rw [h_refl_J] at h_sum_le1
          have h0_bound := hJ0_D (j + 2) hj2_le
          have h_add := add_le_add h0_bound (le_trans h_sum_le1 h_tail_J)
          have h_comb :
