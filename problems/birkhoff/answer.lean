  have hCJet_inv_one_add : ∀ (σ' : ℝ) (g : ℂ → ℂ),
      IsStripCJetBounded p σ' (1 / 2) g →
      (∀ z ∈ horizStrip σ', (1 / 2 : ℝ) ≤ ‖(1 : ℂ) + g z‖ ∧ (1 : ℂ) + g z ≠ 0) ∧
      IsStripCJetBounded p σ' C_inv (fun z => ((1 : ℂ) + g z)⁻¹) := by
    intro σ' g hg
    let U := horizStrip σ'
    let h : ℂ → ℂ := fun z => ((1 : ℂ) + g z)⁻¹
    have h_lower : ∀ z ∈ U, (1 / 2 : ℝ) ≤ ‖(1 : ℂ) + g z‖ ∧ (1 : ℂ) + g z ≠ 0 := by
      intro z hz
      have hg0 : ‖g z‖ ≤ 1 / 2 := by
        simpa [iteratedDeriv_zero] using hg.2.2.2 0 (Nat.zero_le p) z hz
      have htri := norm_sub_norm_le (1 : ℂ) (-g z)
      simp only [norm_one, norm_neg, sub_neg_eq_add] at htri
      have hge : (1 / 2 : ℝ) ≤ ‖(1 : ℂ) + g z‖ := by linarith
      exact ⟨hge, norm_pos_iff.mp (by linarith)⟩
    have h1g_holo : DifferentiableOn ℂ (fun y : ℂ => (1 : ℂ) + g y) U :=
      (differentiableOn_const (1 : ℂ)).fun_add hg.1
    have hh_holo : DifferentiableOn ℂ h U :=
      h1g_holo.fun_inv (fun z hz => (h_lower z hz).2)
    have hInd : ∀ k : ℕ, k ≤ p → ∀ z ∈ U, ‖iteratedDeriv k h z‖ ≤ 2 * C_mul ^ k := by
      intro k
      induction k using Nat.strong_induction_on with
      | h k ih =>
        intro hk z hz
        cases k with
        | zero =>
          rw [iteratedDeriv_zero, pow_zero, mul_one]
          dsimp only [h]
          rw [norm_inv]
          have hanti := inv_anti₀ (by norm_num : (0 : ℝ) < 1 / 2) (h_lower z hz).1
          linarith [show ((1 / 2 : ℝ))⁻¹ = 2 by norm_num]
        | succ m' =>
          have hLocal : (fun y : ℂ => ((1 : ℂ) + g y) * h y) =ᶠ[nhds z] (fun _ : ℂ => (1 : ℂ)) :=
            Filter.eventuallyEq_of_mem ((hOpen σ').mem_nhds hz)
              (fun y hy => mul_inv_cancel₀ (h_lower y hy).2)
          have hDerivZero :
              iteratedDeriv (m' + 1) (fun y : ℂ => ((1 : ℂ) + g y) * h y) z = 0 := by
            rw [hLocal.iteratedDeriv_eq, iteratedDeriv_const]
            simp
          rw [iteratedDeriv_fun_mul (hContDiffAt h1g_holo hz (m' + 1))
                (hContDiffAt hh_holo hz (m' + 1)),
              Finset.sum_range_succ'] at hDerivZero
          simp only [Nat.choose_zero_right, Nat.cast_one, one_mul, iteratedDeriv_zero,
            Nat.sub_zero] at hDerivZero
          have hEqTerm :
              ((1 : ℂ) + g z) * iteratedDeriv (m' + 1) h z =
                -∑ j ∈ Finset.range (m' + 1),
                  ((m' + 1).choose (j + 1) : ℂ) *
                    iteratedDeriv (j + 1) (fun y : ℂ => (1 : ℂ) + g y) z *
                    iteratedDeriv (m' + 1 - (j + 1)) h z :=
            eq_neg_of_add_eq_zero_right hDerivZero
          have hNormProd :
              ‖(1 : ℂ) + g z‖ * ‖iteratedDeriv (m' + 1) h z‖ ≤ C_mul ^ (m' + 1) := by
            calc
              ‖(1 : ℂ) + g z‖ * ‖iteratedDeriv (m' + 1) h z‖
                = ‖((1 : ℂ) + g z) * iteratedDeriv (m' + 1) h z‖ := (norm_mul _ _).symm
              _ = ‖∑ j ∈ Finset.range (m' + 1),
                    ((m' + 1).choose (j + 1) : ℂ) *
                      iteratedDeriv (j + 1) (fun y : ℂ => (1 : ℂ) + g y) z *
                      iteratedDeriv (m' + 1 - (j + 1)) h z‖ := by
                  rw [hEqTerm, norm_neg]
              _ ≤ ∑ j ∈ Finset.range (m' + 1),
                    ‖((m' + 1).choose (j + 1) : ℂ) *
                      iteratedDeriv (j + 1) (fun y : ℂ => (1 : ℂ) + g y) z *
                      iteratedDeriv (m' + 1 - (j + 1)) h z‖ :=
                  norm_sum_le _ _
              _ ≤ ∑ j ∈ Finset.range (m' + 1),
                    ((m' + 1).choose (j + 1) : ℝ) * C_mul ^ m' := by
                  apply Finset.sum_le_sum
                  intro j hj
                  have hj_lt : j < m' + 1 := Finset.mem_range.mp hj
                  have hj1_le_p : j + 1 ≤ p := by omega
                  have hsub_lt : m' + 1 - (j + 1) < m' + 1 := by omega
                  have hsub_le_m : m' + 1 - (j + 1) ≤ m' := by omega
                  have hsub_le_p : m' + 1 - (j + 1) ≤ p := by omega
                  have h1g_deriv :
                      iteratedDeriv (j + 1) (fun y : ℂ => (1 : ℂ) + g y) z =
                        iteratedDeriv (j + 1) g z := by
                    rw [iteratedDeriv_fun_add
                          (hContDiffAt (differentiableOn_const (1 : ℂ)) hz (j + 1))
                          (hContDiffAt hg.1 hz (j + 1)),
                        iteratedDeriv_const]
                    simp
                  have hg_bnd : ‖iteratedDeriv (j + 1) g z‖ ≤ 1 / 2 :=
                    hg.2.2.2 (j + 1) hj1_le_p z hz
                  have hh_bnd :
                      ‖iteratedDeriv (m' + 1 - (j + 1)) h z‖ ≤ 2 * C_mul ^ m' := by
                    calc
                      ‖iteratedDeriv (m' + 1 - (j + 1)) h z‖
