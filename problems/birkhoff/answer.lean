          (fun _ _ => ⟨hq_norm, hq_norm, by simp⟩)
          1 ⟨zero_le_one, le_rfl⟩).1
      have ha0_seq_le : ‖a₀_seq n p‖ ≤ r_b / 8 + 1 := by
        calc ‖a₀_seq n p‖ = ‖a₀_lim p + (a₀_seq n p - a₀_lim p)‖ := by ring_nf
          _ ≤ ‖a₀_lim p‖ + ‖a₀_seq n p - a₀_lim p‖ := norm_add_le _ _
          _ ≤ r_b / 8 + 1 := by linarith
      have hb1_diff : ‖(a₀_seq n p * c0Kernel (Q_seq n p) 1 +
          a₁_seq n p * k0Kernel (Q_seq n p) 1) -
          a₀_lim p * c0Kernel (fun _ => q_lim p) 1‖ ≤ C_B * η_in := by
        have h_rew : (a₀_seq n p * c0Kernel (Q_seq n p) 1 +
            a₁_seq n p * k0Kernel (Q_seq n p) 1) -
            a₀_lim p * c0Kernel (fun _ => q_lim p) 1 =
            a₀_seq n p * (c0Kernel (Q_seq n p) 1 - c0Kernel (fun _ => q_lim p) 1) +
            (a₀_seq n p - a₀_lim p) * c0Kernel (fun _ => q_lim p) 1 +
            a₁_seq n p * k0Kernel (Q_seq n p) 1 := by ring
        rw [h_rew]
        have t1 := norm_add_le
          (a₀_seq n p * (c0Kernel (Q_seq n p) 1 - c0Kernel (fun _ => q_lim p) 1) +
            (a₀_seq n p - a₀_lim p) * c0Kernel (fun _ => q_lim p) 1)
          (a₁_seq n p * k0Kernel (Q_seq n p) 1)
        have t2 := norm_add_le
          (a₀_seq n p * (c0Kernel (Q_seq n p) 1 - c0Kernel (fun _ => q_lim p) 1))
          ((a₀_seq n p - a₀_lim p) * c0Kernel (fun _ => q_lim p) 1)
        have m1 : ‖a₀_seq n p * (c0Kernel (Q_seq n p) 1 - c0Kernel (fun _ => q_lim p) 1)‖ ≤
            (r_b / 8 + 1) * (Real.exp M_Q * η_in) := by
          rw [norm_mul]
          exact mul_le_mul ha0_seq_le h_lip.2.2.2.2.1 (norm_nonneg _) (by positivity)
        have m2 : ‖(a₀_seq n p - a₀_lim p) * c0Kernel (fun _ => q_lim p) 1‖ ≤
            η_in * Real.exp M_Q := by
          rw [norm_mul]
          exact mul_le_mul ha0_d.le hc0_le (norm_nonneg _) (by positivity)
        have m3 : ‖a₁_seq n p * k0Kernel (Q_seq n p) 1‖ ≤ η_in * Real.exp M_Q := by
          rw [norm_mul]
          exact mul_le_mul ha1_d.le h_lip.2.1 (norm_nonneg _) (by positivity)
        dsimp [C_B]
        nlinarith [Real.exp_pos M_Q, hr_b, hη_in_pos]
      have hCB_lt : C_B * η_in < η := by
        have := (le_div_iff₀ (by positivity : 0 < 2 * C_B)).mp hη_le_CB
        linarith
      have hη_in_lt_η : η_in < η := by
        have hCB_ge1 : 1 ≤ C_B := by dsimp [C_B]; linarith [ show (0 : ℝ) ≤ (r_b / 8 + 3) * Real.exp M_Q by positivity ]
        have : η_in ≤ C_B * η_in := by
          simpa using mul_le_mul_of_nonneg_right hCB_ge1 hη_in_pos.le
        exact lt_of_le_of_lt this hCB_lt
      exact ⟨fun w hw => lt_trans (hQ_d w hw) hη_in_lt_η,
        lt_trans ha0_d hη_in_lt_η, lt_of_le_of_lt hb1_diff hCB_lt⟩

    let η_safe : ℝ := min (δ_Q / 2) (r_b / 8)
    have hη_safe_pos : 0 < η_safe := lt_min (by positivity) (by positivity)
    obtain ⟨N₁, hN₁_ge, hN₁⟩ := h_unif_B η_safe hη_safe_pos

    have h_B_safe : ∀ n ≥ N₁, ∀ p ∈ U_δ,
        (∀ w ∈ Set.Icc (0 : ℝ) 1, ‖Q_seq n p w - Q₀ w‖ < δ_Q) ∧
        ‖a₀_seq n p‖ < r_b / 4 ∧
        ‖a₀_seq n p * c0Kernel (Q_seq n p) 1 + a₁_seq n p * k0Kernel (Q_seq n p) 1‖ < r_b / 4 ∧
        k0Kernel (Q_seq n p) 1 ≠ 0 := by
      intro n hn p hp
      obtain ⟨hq_d0, ha0_lim_lt, hb1_lim_lt, _⟩ := h_lim_Uδ p hp
      obtain ⟨hQ_d, ha0_d, hb1_d⟩ := hN₁ n hn p hp
      have hη1 : η_safe ≤ δ_Q / 2 := min_le_left _ _
      have hη2 : η_safe ≤ r_b / 8 := min_le_right _ _
      have hQ_Q0 : ∀ w ∈ Set.Icc (0 : ℝ) 1, ‖Q_seq n p w - Q₀ w‖ < δ_Q := by
        intro w hw
        dsimp [Q₀]
        calc ‖Q_seq n p w - q_lim p₀‖
            = ‖(Q_seq n p w - q_lim p) + (q_lim p - q_lim p₀)‖ := by ring_nf
          _ ≤ ‖Q_seq n p w - q_lim p‖ + ‖q_lim p - q_lim p₀‖ := norm_add_le _ _
          _ < δ_Q := by linarith [hQ_d w hw]
      have hb0_lt : ‖a₀_seq n p‖ < r_b / 4 := by
        calc ‖a₀_seq n p‖ = ‖a₀_lim p + (a₀_seq n p - a₀_lim p)‖ := by ring_nf
          _ ≤ ‖a₀_lim p‖ + ‖a₀_seq n p - a₀_lim p‖ := norm_add_le _ _
          _ < r_b / 4 := by linarith
      set b₁_n := a₀_seq n p * c0Kernel (Q_seq n p) 1 + a₁_seq n p * k0Kernel (Q_seq n p) 1
      have hb1_lt : ‖b₁_n‖ < r_b / 4 := by
        calc ‖b₁_n‖
            = ‖a₀_lim p * c0Kernel (fun _ => q_lim p) 1 +
                (b₁_n - a₀_lim p * c0Kernel (fun _ => q_lim p) 1)‖ := by ring_nf
          _ ≤ ‖a₀_lim p * c0Kernel (fun _ => q_lim p) 1‖ +
                ‖b₁_n - a₀_lim p * c0Kernel (fun _ => q_lim p) 1‖ := norm_add_le _ _
          _ < r_b / 4 := by linarith
      have hk0_n : k0Kernel (Q_seq n p) 1 ≠ 0 := by
        have hp1 : p ∈ U₁ := hU_sub hp
        have hn0 : N₀ ≤ n := le_trans hN₁_ge hn
        have hQ_cont_p : ContinuousOn (Q_seq n p) (Set.Icc (0 : ℝ) 1) :=
          hQ_slice_cont n hn0 p hp1
        exact (hRep (Q_seq n p) hQ_cont_p hQ_Q0).1
      exact ⟨hQ_Q0, hb0_lt, hb1_lt, hk0_n⟩

    
    let ζ_c : ℝ → ℂ := fun θ => (r_b : ℂ) * Complex.exp ((θ : ℂ) * Complex.I)
    have hζ_norm : ∀ θ : ℝ, ‖ζ_c θ‖ = r_b := by
      intro θ
      dsimp [ζ_c]
      rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg hr_b.le,
        Complex.norm_exp_ofReal_mul_I, mul_one]
    let cauchyF : (ℝ → ℂ) → ℂ → ℂ → ℝ → ℝ → ℂ := fun Q b₀ b₁ θ₀ θ₁ =>
      slNumerator Q (ζ_c θ₀) (ζ_c θ₁) / ((ζ_c θ₀ - b₀) * (ζ_c θ₁ - b₁))

    have h_cauchy_int : ∀ (Q : ℝ → ℂ) (b₀ b₁ : ℂ),
        ContinuousOn Q (Set.Icc (0 : ℝ) 1) →
        (∀ w ∈ Set.Icc (0 : ℝ) 1, ‖Q w - Q₀ w‖ < δ_Q) →
        ‖b₀‖ ≤ r_b / 4 → ‖b₁‖ ≤ r_b / 4 →
        Measurable (Function.uncurry (cauchyF Q b₀ b₁)) ∧
        (∀ θ₀ θ₁ : ℝ, ‖cauchyF Q b₀ b₁ θ₀ θ₁‖ ≤ 4 * M_num / r_b ^ 2) ∧
        (∀ θ₀ : ℝ, IntervalIntegrable (cauchyF Q b₀ b₁ θ₀)
          MeasureTheory.volume 0 (2 * Real.pi)) ∧
        IntervalIntegrable
          (fun θ₀ : ℝ => ∫ θ₁ in (0 : ℝ)..(2 * Real.pi), cauchyF Q b₀ b₁ θ₀ θ₁)
          MeasureTheory.volume 0 (2 * Real.pi) := by
      intro Q b₀ b₁ hQ_c hQ_d hb0 hb1
      obtain ⟨_, hNum_bound, _⟩ := hRep Q hQ_c hQ_d
      obtain ⟨_, _, hkp_univ, hkm_univ⟩ :=
        hVolt.2.1.2 (Set.univ : Set (ℂ × ℂ)) (fun _ => Q) Prod.fst
          (fun w : ℂ × ℂ => (w.2 - w.1 * c0Kernel Q 1) / k0Kernel Q 1)
          isOpen_univ
          (ContinuousOn.comp hQ_c continuous_snd.continuousOn (fun _ hq => hq.2))
          (fun _ _ => differentiableOn_const _)
          differentiable_fst.differentiableOn
          (by fun_prop)
      have hkp_meas : Measurable
          (fun w : ℂ × ℂ => kPlusVal Q w.1 ((w.2 - w.1 * c0Kernel Q 1) / k0Kernel Q 1)) :=
        (continuousOn_univ.mp hkp_univ.continuousOn).measurable
      have hkm_meas : Measurable
          (fun w : ℂ × ℂ => kMinusVal Q w.1 ((w.2 - w.1 * c0Kernel Q 1) / k0Kernel Q 1)) :=
        (continuousOn_univ.mp hkm_univ.continuousOn).measurable
      have hroot_meas : Measurable
          (fun w : ℂ × ℂ => canonRoot Q w.1 ((w.2 - w.1 * c0Kernel Q 1) / k0Kernel Q 1)) := by
        dsimp [canonRoot]
        refine ((hkp_meas.add hkm_meas).div_const 2).mul ?_
        refine Complex.continuous_exp.measurable.comp (measurable_const.mul ?_)
        refine Complex.measurable_log.comp ?_
        exact ((measurable_const.mul hkp_meas).mul hkm_meas).div
          ((hkp_meas.add hkm_meas).pow_const 2)
      have hζ_cont : Continuous ζ_c := by dsimp [ζ_c]; fun_prop
      have hF_meas_aux : ∀ (root_fn : ℂ × ℂ → ℂ), Measurable root_fn →
          Measurable (fun q : ℝ × ℝ =>
            (k0Kernel Q 1 - root_fn (ζ_c q.1, ζ_c q.2)) /
              ((ζ_c q.1 - b₀) * (ζ_c q.2 - b₁))) := by
        intro root_fn hm
        fun_prop
      have hF_meas : Measurable (Function.uncurry (cauchyF Q b₀ b₁)) :=
        hF_meas_aux _ hroot_meas
      have hF_bound : ∀ θ₀ θ₁ : ℝ, ‖cauchyF Q b₀ b₁ θ₀ θ₁‖ ≤ 4 * M_num / r_b ^ 2 := by
        intro θ₀ θ₁
        dsimp [cauchyF]
        rw [norm_div, norm_mul]
        have hN_le : ‖slNumerator Q (ζ_c θ₀) (ζ_c θ₁)‖ ≤ M_num :=
          (hNum_bound (ζ_c θ₀) (ζ_c θ₁) (hζ_norm θ₀).le (hζ_norm θ₁).le).1
        have hd0 : r_b / 2 ≤ ‖ζ_c θ₀ - b₀‖ := by
          have := norm_add_le (ζ_c θ₀ - b₀) b₀
          have h_eq : (ζ_c θ₀ - b₀) + b₀ = ζ_c θ₀ := by ring
          rw [h_eq, hζ_norm θ₀] at this
          linarith
        have hd1 : r_b / 2 ≤ ‖ζ_c θ₁ - b₁‖ := by
          have := norm_add_le (ζ_c θ₁ - b₁) b₁
          have h_eq : (ζ_c θ₁ - b₁) + b₁ = ζ_c θ₁ := by ring
          rw [h_eq, hζ_norm θ₁] at this
          linarith
        have hden_ge : r_b ^ 2 / 4 ≤ ‖ζ_c θ₀ - b₀‖ * ‖ζ_c θ₁ - b₁‖ := by
          calc r_b ^ 2 / 4 = (r_b / 2) * (r_b / 2) := by ring
            _ ≤ ‖ζ_c θ₀ - b₀‖ * ‖ζ_c θ₁ - b₁‖ :=
              mul_le_mul hd0 hd1 (by positivity) (norm_nonneg _)
        calc ‖slNumerator Q (ζ_c θ₀) (ζ_c θ₁)‖ / (‖ζ_c θ₀ - b₀‖ * ‖ζ_c θ₁ - b₁‖)
            ≤ M_num / (r_b ^ 2 / 4) :=
              div_le_div₀ hM_num.le hN_le (by positivity) hden_ge
          _ = 4 * M_num / r_b ^ 2 := by ring
      let B_F : ℝ := 4 * M_num / r_b ^ 2
      have hB_F_pos : 0 < B_F := by positivity
      have h_slice_meas : ∀ (G : ℝ → ℝ → ℂ), Measurable (Function.uncurry G) →
          ∀ θ₀ : ℝ, Measurable (G θ₀) :=
        fun G hG θ₀ => hG.comp (by fun_prop : Measurable (fun θ₁ : ℝ => (θ₀, θ₁)))
      have h_int_sm : ∀ (G : ℝ → ℝ → ℂ), Measurable (Function.uncurry G) →
          MeasureTheory.StronglyMeasurable
            (fun θ₀ : ℝ => ∫ θ₁ in (0 : ℝ)..(2 * Real.pi), G θ₀ θ₁) := by
        intro G hG
        have h_le : (0 : ℝ) ≤ 2 * Real.pi := by positivity
        simp_rw [intervalIntegral.integral_of_le h_le]
        exact hG.stronglyMeasurable.integral_prod_right'
      have h_inner_int : ∀ θ₀ : ℝ, IntervalIntegrable (cauchyF Q b₀ b₁ θ₀)
          MeasureTheory.volume 0 (2 * Real.pi) := by
        intro θ₀
        have hm1 : Measurable (cauchyF Q b₀ b₁ θ₀) := h_slice_meas _ hF_meas θ₀
        exact (intervalIntegrable_const (c := B_F)).mono_fun hm1.aestronglyMeasurable
          (Filter.Eventually.of_forall fun θ₁ => by
            rw [Real.norm_of_nonneg hB_F_pos.le]
            exact hF_bound θ₀ θ₁)
      have h_outer_sm : MeasureTheory.StronglyMeasurable
          (fun θ₀ : ℝ => ∫ θ₁ in (0 : ℝ)..(2 * Real.pi), cauchyF Q b₀ b₁ θ₀ θ₁) :=
        h_int_sm _ hF_meas
      have h_outer_int : IntervalIntegrable
          (fun θ₀ : ℝ => ∫ θ₁ in (0 : ℝ)..(2 * Real.pi), cauchyF Q b₀ b₁ θ₀ θ₁)
          MeasureTheory.volume 0 (2 * Real.pi) := by
        refine (intervalIntegrable_const (c := B_F * (2 * Real.pi))).mono_fun
          h_outer_sm.aestronglyMeasurable
          (Filter.Eventually.of_forall fun θ₀ => ?_)
        rw [Real.norm_of_nonneg (by positivity)]
        have hb : ∀ θ₁ ∈ Set.uIoc (0 : ℝ) (2 * Real.pi),
            ‖cauchyF Q b₀ b₁ θ₀ θ₁‖ ≤ B_F := fun θ₁ _ => hF_bound θ₀ θ₁
        have hint_le := intervalIntegral.norm_integral_le_of_norm_le_const hb
        rwa [sub_zero, abs_of_pos Real.two_pi_pos] at hint_le
      exact ⟨hF_meas, hF_bound, h_inner_int, h_outer_int⟩

    refine ⟨δ, N₁, hδ_pos, hδ_le1, hN₁_ge,
      fun p hp => (h_lim_Uδ p hp).2.2.2, ?_, ?_⟩
    · intro n hn
      have hn0 : N₀ ≤ n := le_trans hN₁_ge hn
      obtain ⟨_, hQ_c, _, hQ_h, ha0_h, ha1_h⟩ := h3_holo n hn0
      refine ⟨fun p hp => (h_B_safe n hn p hp).2.2.2, ?_⟩
      refine hHoloDiv U_δ (Q_seq n) (a₀_seq n) (a₁_seq n) (hU_δ_open δ)
        (hQ_c.mono (Set.prod_mono_left hU_sub))
        (fun w hw => (hQ_h w hw).mono hU_sub)
        (fun p hp w hw => (h_B_safe n hn p hp).1 w hw)
        (ha0_h.mono hU_sub) (ha1_h.mono hU_sub) ?_
      intro p hp
      obtain ⟨_, hb0_lt, hb1_lt, _⟩ := h_B_safe n hn p hp
      exact ⟨by linarith, by linarith⟩

    · 
      rw [Metric.tendstoUniformlyOn_iff]
      intro ε hε
      let C_cauchy : ℝ := 4 * M_num / r_b ^ 2 + 64 * M_num / r_b ^ 3 + 1
      have hC_cauchy_pos : 0 < C_cauchy := by positivity
      let η_c : ℝ := min η_safe (ε / (2 * C_cauchy))
      have hη_c_pos : 0 < η_c := lt_min hη_safe_pos (by positivity)
      obtain ⟨N₂, _, hN₂⟩ := h_unif_B η_c hη_c_pos
      rw [Filter.eventually_atTop]
      refine ⟨max N₁ N₂, fun n hn p hp => ?_⟩
      have hn1 : N₁ ≤ n := le_trans (le_max_left _ _) hn
      have hn2 : N₂ ≤ n := le_trans (le_max_right _ _) hn
      have hn0 : N₀ ≤ n := le_trans hN₁_ge hn1
      have hp1 : p ∈ U₁ := hU_sub hp
      obtain ⟨hq_d0, ha0_lim_lt, hb1_lim_lt, _⟩ := h_lim_Uδ p hp
      obtain ⟨hQ_Q0, hb0_n_lt, hb1_n_lt, _⟩ := h_B_safe n hn1 p hp
      obtain ⟨hQ_d, ha0_d, hb1_d⟩ := hN₂ n hn2 p hp
      have hQ_cont_p : ContinuousOn (Q_seq n p) (Set.Icc (0 : ℝ) 1) :=
        hQ_slice_cont n hn0 p hp1
      set b₀_n := a₀_seq n p
      set b₁_n := a₀_seq n p * c0Kernel (Q_seq n p) 1 + a₁_seq n p * k0Kernel (Q_seq n p) 1
      set b₀_l := a₀_lim p
      set b₁_l := a₀_lim p * c0Kernel (fun _ => q_lim p) 1
      have h_rep_n : slDivided (Q_seq n p) (a₀_seq n p) (a₁_seq n p) =
          (((2 * Real.pi) ^ 2 : ℝ) : ℂ)⁻¹ *
            ∫ θ₀ in (0 : ℝ)..(2 * Real.pi),
              ∫ θ₁ in (0 : ℝ)..(2 * Real.pi), cauchyF (Q_seq n p) b₀_n b₁_n θ₀ θ₁ :=
        (hRep (Q_seq n p) hQ_cont_p hQ_Q0).2.2 (a₀_seq n p) (a₁_seq n p)
          (by linarith) (by linarith)
      have hqlim_Q0 : ∀ w ∈ Set.Icc (0 : ℝ) 1, ‖(fun _ : ℝ => q_lim p) w - Q₀ w‖ < δ_Q :=
        fun _ _ => lt_trans hq_d0 (by linarith)
      have h_rep_l : slDivided (fun _ => q_lim p) (a₀_lim p) 0 =
          (((2 * Real.pi) ^ 2 : ℝ) : ℂ)⁻¹ *
            ∫ θ₀ in (0 : ℝ)..(2 * Real.pi),
              ∫ θ₁ in (0 : ℝ)..(2 * Real.pi),
                cauchyF (fun _ => q_lim p) b₀_l b₁_l θ₀ θ₁ := by
        have hr := (hRep (fun _ => q_lim p) continuousOn_const hqlim_Q0).2.2
          (a₀_lim p) 0 (by linarith) (by rw [zero_mul, add_zero]; linarith [hb1_lim_lt])
        simpa [b₀_l, b₁_l] using hr
      obtain ⟨_, _, h_in_n, h_out_n⟩ :=
        h_cauchy_int (Q_seq n p) b₀_n b₁_n hQ_cont_p hQ_Q0
          (by linarith) (by linarith)
      obtain ⟨_, _, h_in_l, h_out_l⟩ :=
        h_cauchy_int (fun _ => q_lim p) b₀_l b₁_l continuousOn_const hqlim_Q0
          (by linarith) (by linarith)

      have h_pt_diff : ∀ θ₀ θ₁ : ℝ,
          ‖cauchyF (Q_seq n p) b₀_n b₁_n θ₀ θ₁ -
            cauchyF (fun _ => q_lim p) b₀_l b₁_l θ₀ θ₁‖ ≤ C_cauchy * η_c := by
        intro θ₀ θ₁
        set N₁_v := slNumerator (Q_seq n p) (ζ_c θ₀) (ζ_c θ₁)
        set N₂_v := slNumerator (fun _ => q_lim p) (ζ_c θ₀) (ζ_c θ₁)
        set D₁_v := (ζ_c θ₀ - b₀_n) * (ζ_c θ₁ - b₁_n)
        set D₂_v := (ζ_c θ₀ - b₀_l) * (ζ_c θ₁ - b₁_l)
        have hd0_n : r_b / 2 ≤ ‖ζ_c θ₀ - b₀_n‖ := by
          have := norm_add_le (ζ_c θ₀ - b₀_n) b₀_n
          have h_eq : (ζ_c θ₀ - b₀_n) + b₀_n = ζ_c θ₀ := by ring
          rw [h_eq, hζ_norm θ₀] at this; linarith
        have hd1_n : r_b / 2 ≤ ‖ζ_c θ₁ - b₁_n‖ := by
          have := norm_add_le (ζ_c θ₁ - b₁_n) b₁_n
          have h_eq : (ζ_c θ₁ - b₁_n) + b₁_n = ζ_c θ₁ := by ring
          rw [h_eq, hζ_norm θ₁] at this; linarith
        have hd0_l : r_b / 2 ≤ ‖ζ_c θ₀ - b₀_l‖ := by
          have := norm_add_le (ζ_c θ₀ - b₀_l) b₀_l
          have h_eq : (ζ_c θ₀ - b₀_l) + b₀_l = ζ_c θ₀ := by ring
          rw [h_eq, hζ_norm θ₀] at this; linarith
        have hd1_l : r_b / 2 ≤ ‖ζ_c θ₁ - b₁_l‖ := by
          have := norm_add_le (ζ_c θ₁ - b₁_l) b₁_l
          have h_eq : (ζ_c θ₁ - b₁_l) + b₁_l = ζ_c θ₁ := by ring
          rw [h_eq, hζ_norm θ₁] at this; linarith
        have hD1_ge : r_b ^ 2 / 4 ≤ ‖D₁_v‖ := by
          dsimp [D₁_v]; rw [norm_mul]
          calc r_b ^ 2 / 4 = (r_b / 2) * (r_b / 2) := by ring
            _ ≤ ‖ζ_c θ₀ - b₀_n‖ * ‖ζ_c θ₁ - b₁_n‖ :=
              mul_le_mul hd0_n hd1_n (by positivity) (norm_nonneg _)
        have hD2_ge : r_b ^ 2 / 4 ≤ ‖D₂_v‖ := by
          dsimp [D₂_v]; rw [norm_mul]
          calc r_b ^ 2 / 4 = (r_b / 2) * (r_b / 2) := by ring
            _ ≤ ‖ζ_c θ₀ - b₀_l‖ * ‖ζ_c θ₁ - b₁_l‖ :=
              mul_le_mul hd0_l hd1_l (by positivity) (norm_nonneg _)
        have hD1_ne : D₁_v ≠ 0 := norm_pos_iff.mp (lt_of_lt_of_le (by positivity) hD1_ge)
        have hD2_ne : D₂_v ≠ 0 := norm_pos_iff.mp (lt_of_lt_of_le (by positivity) hD2_ge)
        have h_alg : cauchyF (Q_seq n p) b₀_n b₁_n θ₀ θ₁ -
            cauchyF (fun _ => q_lim p) b₀_l b₁_l θ₀ θ₁ =
            (N₁_v - N₂_v) / D₁_v + N₂_v * (D₂_v - D₁_v) / (D₁_v * D₂_v) := by
          change N₁_v / D₁_v - N₂_v / D₂_v =
            (N₁_v - N₂_v) / D₁_v + N₂_v * (D₂_v - D₁_v) / (D₁_v * D₂_v)
          field_simp [hD1_ne, hD2_ne]; ring
        rw [h_alg]
        have hN_lip : ‖N₁_v - N₂_v‖ ≤ M_num * η_c :=
          hLipN (Q_seq n p) (fun _ => q_lim p) η_c hη_c_pos.le hQ_cont_p continuousOn_const
            (fun w hw => ⟨hQ_Q0 w hw, hqlim_Q0 w hw, (hQ_d w hw).le⟩)
            (ζ_c θ₀) (ζ_c θ₁) (hζ_norm θ₀).le (hζ_norm θ₁).le
        have hN2_le : ‖N₂_v‖ ≤ M_num :=
          ((hRep (fun _ => q_lim p) continuousOn_const hqlim_Q0).2.1
            (ζ_c θ₀) (ζ_c θ₁) (hζ_norm θ₀).le (hζ_norm θ₁).le).1
        have hD_sub : ‖D₂_v - D₁_v‖ ≤ 4 * r_b * η_c := by
          have h_rew : D₂_v - D₁_v =
              (b₀_n - b₀_l) * (ζ_c θ₁ - b₁_l) + (ζ_c θ₀ - b₀_n) * (b₁_n - b₁_l) := by
            dsimp [D₁_v, D₂_v]; ring
          rw [h_rew]
          have t1 := norm_add_le ((b₀_n - b₀_l) * (ζ_c θ₁ - b₁_l))
            ((ζ_c θ₀ - b₀_n) * (b₁_n - b₁_l))
          have hi1 : ‖ζ_c θ₁ - b₁_l‖ ≤ 2 * r_b := by
            have := norm_sub_le (ζ_c θ₁) b₁_l
            rw [hζ_norm θ₁] at this; linarith
          have hi0 : ‖ζ_c θ₀ - b₀_n‖ ≤ 2 * r_b := by
            have := norm_sub_le (ζ_c θ₀) b₀_n
            rw [hζ_norm θ₀] at this; linarith
          have m1 : ‖(b₀_n - b₀_l) * (ζ_c θ₁ - b₁_l)‖ ≤ η_c * (2 * r_b) := by
            rw [norm_mul]; exact mul_le_mul ha0_d.le hi1 (norm_nonneg _) hη_c_pos.le
          have m2 : ‖(ζ_c θ₀ - b₀_n) * (b₁_n - b₁_l)‖ ≤ (2 * r_b) * η_c := by
            rw [norm_mul]; exact mul_le_mul hi0 hb1_d.le (norm_nonneg _) (by positivity)
          linarith
        have h_term1 : ‖(N₁_v - N₂_v) / D₁_v‖ ≤ (4 * M_num / r_b ^ 2) * η_c := by
          rw [norm_div]
          calc ‖N₁_v - N₂_v‖ / ‖D₁_v‖
              ≤ (M_num * η_c) / (r_b ^ 2 / 4) :=
                div_le_div₀ (by positivity) hN_lip (by positivity) hD1_ge
            _ = (4 * M_num / r_b ^ 2) * η_c := by ring
        have h_term2 : ‖N₂_v * (D₂_v - D₁_v) / (D₁_v * D₂_v)‖ ≤
            (64 * M_num / r_b ^ 3) * η_c := by
          rw [norm_div, norm_mul, norm_mul]
          have hnum_le : ‖N₂_v‖ * ‖D₂_v - D₁_v‖ ≤ M_num * (4 * r_b * η_c) :=
            mul_le_mul hN2_le hD_sub (norm_nonneg _) hM_num.le
          have hden_ge : (r_b ^ 2 / 4) * (r_b ^ 2 / 4) ≤ ‖D₁_v‖ * ‖D₂_v‖ :=
            mul_le_mul hD1_ge hD2_ge (by positivity) (norm_nonneg _)
          calc (‖N₂_v‖ * ‖D₂_v - D₁_v‖) / (‖D₁_v‖ * ‖D₂_v‖)
              ≤ (M_num * (4 * r_b * η_c)) / ((r_b ^ 2 / 4) * (r_b ^ 2 / 4)) :=
                div_le_div₀ (by positivity) hnum_le (by positivity) hden_ge
            _ = (64 * M_num / r_b ^ 3) * η_c := by field_simp [hr_b.ne']; ring
        calc ‖(N₁_v - N₂_v) / D₁_v + N₂_v * (D₂_v - D₁_v) / (D₁_v * D₂_v)‖
            ≤ ‖(N₁_v - N₂_v) / D₁_v‖ + ‖N₂_v * (D₂_v - D₁_v) / (D₁_v * D₂_v)‖ :=
              norm_add_le _ _
          _ ≤ (4 * M_num / r_b ^ 2) * η_c + (64 * M_num / r_b ^ 3) * η_c :=
              add_le_add h_term1 h_term2
          _ ≤ C_cauchy * η_c := by dsimp [C_cauchy]; nlinarith [hη_c_pos]

      rw [dist_comm, dist_eq_norm, h_rep_n, h_rep_l, ← mul_sub,
        ← intervalIntegral.integral_sub h_out_n h_out_l, norm_mul]
      have h_inner_le : ∀ θ₀ ∈ Set.uIoc (0 : ℝ) (2 * Real.pi),
          ‖(∫ θ₁ in (0 : ℝ)..(2 * Real.pi), cauchyF (Q_seq n p) b₀_n b₁_n θ₀ θ₁) -
            (∫ θ₁ in (0 : ℝ)..(2 * Real.pi),
              cauchyF (fun _ => q_lim p) b₀_l b₁_l θ₀ θ₁)‖ ≤
            (C_cauchy * η_c) * (2 * Real.pi) := by
        intro θ₀ _
        rw [← intervalIntegral.integral_sub (h_in_n θ₀) (h_in_l θ₀)]
        have hb_diff : ∀ θ₁ ∈ Set.uIoc (0 : ℝ) (2 * Real.pi),
            ‖cauchyF (Q_seq n p) b₀_n b₁_n θ₀ θ₁ -
              cauchyF (fun _ => q_lim p) b₀_l b₁_l θ₀ θ₁‖ ≤ C_cauchy * η_c :=
          fun θ₁ _ => h_pt_diff θ₀ θ₁
        have hle := intervalIntegral.norm_integral_le_of_norm_le_const hb_diff
        rwa [sub_zero, abs_of_pos Real.two_pi_pos] at hle
      have h_outer_le := intervalIntegral.norm_integral_le_of_norm_le_const h_inner_le
      rw [sub_zero, abs_of_pos Real.two_pi_pos] at h_outer_le
      have h2pi_sq_pos : 0 < (2 * Real.pi) ^ 2 := by positivity
      have h_pref_norm : ‖(((2 * Real.pi) ^ 2 : ℝ) : ℂ)⁻¹‖ = ((2 * Real.pi) ^ 2)⁻¹ := by
        rw [norm_inv, Complex.norm_real, Real.norm_of_nonneg h2pi_sq_pos.le]
      rw [h_pref_norm]
      have h_prod_le : ((2 * Real.pi) ^ 2)⁻¹ *
          ‖∫ θ₀ in (0 : ℝ)..(2 * Real.pi),
            ((∫ θ₁ in (0 : ℝ)..(2 * Real.pi), cauchyF (Q_seq n p) b₀_n b₁_n θ₀ θ₁) -
             (∫ θ₁ in (0 : ℝ)..(2 * Real.pi),
               cauchyF (fun _ => q_lim p) b₀_l b₁_l θ₀ θ₁))‖ ≤ C_cauchy * η_c := by
        calc ((2 * Real.pi) ^ 2)⁻¹ * _
            ≤ ((2 * Real.pi) ^ 2)⁻¹ * ((C_cauchy * η_c) * (2 * Real.pi) * (2 * Real.pi)) :=
              mul_le_mul_of_nonneg_left h_outer_le (by positivity)
          _ = C_cauchy * η_c := by field_simp [Real.two_pi_pos.ne']
      have h_lt_eps : C_cauchy * η_c < ε := by
        have : η_c ≤ ε / (2 * C_cauchy) := min_le_right _ _
        have := (le_div_iff₀ (by positivity : 0 < 2 * C_cauchy)).mp this
        linarith
      exact lt_of_le_of_lt h_prod_le h_lt_eps

  
  
  
  
  have h_chordPhi_eq_sl : ∀ (n : ℕ) (p : ℂ × ℂ),
      s_pt n p ∈ X.D_strip → s_pt n p + h_pt n p ∈ X.D_strip →
      k0Kernel (Q_seq n p) 1 ≠ 0 →
      chordPhi X (s_pt n p) (h_pt n p) = slDivided (Q_seq n p) (a₀_seq n p) (a₁_seq n p) := by
    intro n p hs hsh hk0
    unfold chordPhi
    split_ifs with hh hcond
    · have hQ0 : Q_seq n p = fun _ => 0 := by
        ext w; simp [Q_seq, stripPotential, hh]
      have ha0_0 : a₀_seq n p = 0 := by simp [a₀_seq, hh]
      have ha1_0 : a₁_seq n p = 0 := by simp [a₁_seq, hh]
      rw [hQ0, ha0_0, ha1_0, hVolt.2.2.1.2.2]
    · rfl
    · exfalso; exact hcond ⟨hs, hsh, hk0⟩

  let lam₀ : ℂ := T₀ * seq.c₀ * Complex.exp (-Complex.I * S₀)
  have hΛ_p0 : Λ_fn p₀ = lam₀ * J₀ := by
    dsimp [Λ_fn, p₀, H₀, lam₀]; ring

  have h_bidisk : ∃ (δ₀ : ℝ) (N_reg : ℕ), 0 < δ₀ ∧
      let U_δ₀ : Set (ℂ × ℂ) := { p : ℂ × ℂ | ‖p.1 - S₀‖ < δ₀ ∧ ‖p.2 - H₀‖ < δ₀ }
      (∀ n ≥ N_reg, DifferentiableOn ℂ (fun p => chordPhi X (s_pt n p) (h_pt n p)) U_δ₀) ∧
      TendstoUniformlyOn
        (fun n p => chordPhi X (s_pt n p) (h_pt n p))
        (fun p => frozenPhi kind (Λ_fn p))
        Filter.atTop U_δ₀ := by
    have hkind_or : kind = .firstField ∨ kind = .secondField :=
      ExpProfileKind.casesOn kind (Or.inl rfl) (Or.inr rfl)
    rcases hkind_or with hkind | hkind
    · 
      have hReg1 : IsRegularFrozenState .firstField lam₀ J₀ := hkind ▸ hReg
      obtain ⟨hJ0_ne, hsin_reg⟩ := h_reg_first lam₀ J₀ hReg1
      by_cases hT0 : T₀ = 0
      · 
        have hΛ0_zero : Λ_fn p₀ = 0 := by
          rw [hΛ_p0]; dsimp [lam₀]; simp [hT0]
        have hk0_0 : k0Kernel (fun _ => q_lim p₀) 1 ≠ 0 := by
          have h1 : k0Kernel (fun _ => (0 : ℂ)) 1 = 1 := by
            simpa using (h_kern_zero 1 ⟨zero_le_one, le_rfl⟩).2.2.1
          have hq0 : (fun _ : ℝ => q_lim p₀) = fun _ => (0 : ℂ) := by
            ext; simp [q_lim, hkind]
          rw [hq0, h1]; exact one_ne_zero
        have ha0_0 : a₀_lim p₀ = 0 := by simp [a₀_lim, hkind, hΛ0_zero]
        obtain ⟨δ₄, N₁, hδ₄_pos, hδ₄_le1, hN₁_ge, _, h4_holo, h4_unif⟩ :=
          h_regime_B hk0_0 ha0_0
        have hΛ_cont : Continuous Λ_fn := by dsimp [Λ_fn]; fun_prop
        obtain ⟨δ_pi, hδ_pi_pos, hδ_pi⟩ :=
          Metric.continuousAt_iff.mp hΛ_cont.continuousAt Real.pi Real.pi_pos
        let δ₀ : ℝ := min δ₄ δ_pi
        have hδ₀_pos : 0 < δ₀ := lt_min hδ₄_pos hδ_pi_pos
        let U_δ₀ : Set (ℂ × ℂ) := { p : ℂ × ℂ | ‖p.1 - S₀‖ < δ₀ ∧ ‖p.2 - H₀‖ < δ₀ }
        have hU0_sub4 : U_δ₀ ⊆ { p : ℂ × ℂ | ‖p.1 - S₀‖ < δ₄ ∧ ‖p.2 - H₀‖ < δ₄ } :=
          fun p hp => ⟨lt_of_lt_of_le hp.1 (min_le_left _ _),
                       lt_of_lt_of_le hp.2 (min_le_left _ _)⟩
        have hU0_sub1 : U_δ₀ ⊆ U₁ := fun p hp =>
          ⟨lt_of_lt_of_le (hU0_sub4 hp).1 hδ₄_le1,
           lt_of_lt_of_le (hU0_sub4 hp).2 hδ₄_le1⟩
        have h_lim_eq : ∀ p ∈ U_δ₀,
            slDivided (fun _ => q_lim p) (a₀_lim p) 0 = frozenPhi kind (Λ_fn p) := by
          intro p hp
          dsimp [q_lim, a₀_lim]
          rw [hkind]
          dsimp
          by_cases hΛp : Λ_fn p = 0
          · rw [hΛp, hVolt.2.2.1.2.2, h_phi_zero .firstField]
          · have hdist_pi : dist p p₀ < δ_pi := by
              rw [Prod.dist_eq, max_lt_iff]
              exact ⟨lt_of_lt_of_le (by rw [dist_eq_norm]; exact hp.1) (min_le_right _ _),
                     lt_of_lt_of_le (by rw [dist_eq_norm]; exact hp.2) (min_le_right _ _)⟩
            have hΛ_lt_pi : ‖Λ_fn p‖ < Real.pi := by
              have hd := hδ_pi hdist_pi
              rwa [hΛ0_zero, dist_zero_right] at hd
            have hsin_ne : Complex.sin (Λ_fn p / 2) ≠ 0 := by
              intro hsin0
              obtain ⟨k, hk⟩ := Complex.sin_eq_zero_iff.mp hsin0
              rcases eq_or_ne k 0 with rfl | hk_ne
              · simp at hk; exact hΛp hk
              · have hk_ge1 : (1 : ℝ) ≤ |(k : ℝ)| := by
                  have : (1 : ℤ) ≤ |k| := Int.one_le_abs hk_ne
                  exact_mod_cast this
                have hnorm_eq : ‖Λ_fn p / 2‖ = |(k : ℝ)| * Real.pi := by
                  rw [hk, norm_mul, Complex.norm_intCast, Complex.norm_real,
                    Real.norm_of_nonneg Real.pi_pos.le]
                have hhalf : ‖Λ_fn p / 2‖ < Real.pi / 2 := by
                  rw [norm_div, Complex.norm_ofNat]; linarith
                nlinarith [Real.pi_pos]
            rw [h_sl_first (Λ_fn p) hΛp hsin_ne, h_phi_first (Λ_fn p) hΛp]
        refine ⟨δ₀, N₁, hδ₀_pos, ?_, ?_⟩
        · intro n hn
          have hn0 : N₀ ≤ n := le_trans hN₁_ge hn
          refine ((h4_holo n hn).2.mono hU0_sub4).congr ?_
          intro p hp
          obtain ⟨hs, hsh⟩ := (h3_holo n hn0).1 p (hU0_sub1 hp)
          exact h_chordPhi_eq_sl n p hs hsh ((h4_holo n hn).1 p (hU0_sub4 hp))
        · have hu := h4_unif.mono hU0_sub4
          rw [Metric.tendstoUniformlyOn_iff] at hu ⊢
          intro ε hε
          filter_upwards [hu ε hε, Filter.eventually_ge_atTop N₁] with n hn_eps hn p hp
          have hn0 : N₀ ≤ n := le_trans hN₁_ge hn
          obtain ⟨hs, hsh⟩ := (h3_holo n hn0).1 p (hU0_sub1 hp)
          rw [h_chordPhi_eq_sl n p hs hsh ((h4_holo n hn).1 p (hU0_sub4 hp)),
            ← h_lim_eq p hp]
          exact hn_eps p hp
      · 
        have hlam0_ne : lam₀ ≠ 0 :=
          mul_ne_zero (mul_ne_zero hT0 seq.c₀_ne_zero) (Complex.exp_ne_zero _)
        have hΛ0_ne : Λ_fn p₀ ≠ 0 := by
          rw [hΛ_p0]; exact mul_ne_zero hlam0_ne hJ0_ne
        have hsin0_ne : Complex.sin (Λ_fn p₀ / 2) ≠ 0 := by
          rw [hΛ_p0]; exact hsin_reg hlam0_ne
        obtain ⟨δ₀, N₁, hδ₀_pos, hδ₀_le1, hN₁_ge, hΛ_ne_on, h4_holo, h4_unif⟩ :=
          h_regime_A hkind hΛ0_ne hsin0_ne
        let U_δ₀ : Set (ℂ × ℂ) := { p : ℂ × ℂ | ‖p.1 - S₀‖ < δ₀ ∧ ‖p.2 - H₀‖ < δ₀ }
        have hU0_sub1 : U_δ₀ ⊆ U₁ := fun p hp =>
          ⟨lt_of_lt_of_le hp.1 hδ₀_le1, lt_of_lt_of_le hp.2 hδ₀_le1⟩
        refine ⟨δ₀, N₁, hδ₀_pos, ?_, ?_⟩
        · intro n hn
          have hn0 : N₀ ≤ n := le_trans hN₁_ge hn
          refine (h4_holo n hn).2.congr ?_
          intro p hp
          obtain ⟨hs, hsh⟩ := (h3_holo n hn0).1 p (hU0_sub1 hp)
          exact h_chordPhi_eq_sl n p hs hsh ((h4_holo n hn).1 p hp)
        · rw [Metric.tendstoUniformlyOn_iff] at h4_unif ⊢
          intro ε hε
          filter_upwards [h4_unif ε hε, Filter.eventually_ge_atTop N₁] with n hn_eps hn p hp
          have hn0 : N₀ ≤ n := le_trans hN₁_ge hn
          obtain ⟨hs, hsh⟩ := (h3_holo n hn0).1 p (hU0_sub1 hp)
          rw [h_chordPhi_eq_sl n p hs hsh ((h4_holo n hn).1 p hp),
            hkind, h_phi_first (Λ_fn p) (hΛ_ne_on p hp)]
          exact hn_eps p hp

    · 
      have hReg2 : IsRegularFrozenState .secondField lam₀ J₀ := hkind ▸ hReg
      obtain ⟨hJ0_ne, hcosh0_ne, hsinh_reg⟩ := h_reg_second lam₀ J₀ hReg2
      have hk0_0 : k0Kernel (fun _ => q_lim p₀) 1 ≠ 0 := by
        dsimp [q_lim]; rw [hkind]; dsimp
        by_cases hΛ0 : Λ_fn p₀ = 0
        · rw [hΛ0, zero_pow two_ne_zero]
          have h1 : k0Kernel (fun _ => (0 : ℂ)) 1 = 1 := by
            simpa using (h_kern_zero 1 ⟨zero_le_one, le_rfl⟩).2.2.1
          rw [h1]; exact one_ne_zero
        · have hlam0_ne : lam₀ ≠ 0 := by
            intro h0; apply hΛ0; rw [hΛ_p0, h0, zero_mul]
          have hsinh0_ne : Complex.sinh (Λ_fn p₀ / 2) ≠ 0 := by
            rw [hΛ_p0]; exact hsinh_reg hlam0_ne
          have hcosh0_ne' : Complex.cosh (Λ_fn p₀ / 2) ≠ 0 := by
            rwa [hΛ_p0]
          have hk_val := (h_kern_const_sq (fun _ => (Λ_fn p₀) ^ 2) (Λ_fn p₀) hΛ0
            continuousOn_const (fun _ _ => rfl)).2
          rw [hk_val]
          have hsinh_full : Complex.sinh (Λ_fn p₀) =
              2 * Complex.sinh (Λ_fn p₀ / 2) * Complex.cosh (Λ_fn p₀ / 2) := by
            have h2 : Λ_fn p₀ = 2 * (Λ_fn p₀ / 2) := by ring
            conv_lhs => rw [h2]
            exact Complex.sinh_two_mul (Λ_fn p₀ / 2)
          rw [hsinh_full]
          exact div_ne_zero
            (mul_ne_zero (mul_ne_zero two_ne_zero hsinh0_ne) hcosh0_ne') hΛ0
      have ha0_0 : a₀_lim p₀ = 0 := by simp [a₀_lim, hkind]
      obtain ⟨δ₀, N₁, hδ₀_pos, hδ₀_le1, hN₁_ge, hk0_lim_ne, h4_holo, h4_unif⟩ :=
        h_regime_B hk0_0 ha0_0
      let U_δ₀ : Set (ℂ × ℂ) := { p : ℂ × ℂ | ‖p.1 - S₀‖ < δ₀ ∧ ‖p.2 - H₀‖ < δ₀ }
      have hU0_sub1 : U_δ₀ ⊆ U₁ := fun p hp =>
        ⟨lt_of_lt_of_le hp.1 hδ₀_le1, lt_of_lt_of_le hp.2 hδ₀_le1⟩
      have h_lim_eq : ∀ p ∈ U_δ₀,
          slDivided (fun _ => q_lim p) (a₀_lim p) 0 = frozenPhi kind (Λ_fn p) := by
        intro p hp
        have hk0_p := hk0_lim_ne p hp
        dsimp [q_lim, a₀_lim] at hk0_p ⊢
        rw [hkind] at hk0_p ⊢
        dsimp at hk0_p ⊢
        by_cases hΛp : Λ_fn p = 0
        · rw [hΛp, zero_pow two_ne_zero, hVolt.2.2.1.2.2, h_phi_zero .secondField]
        · obtain ⟨hcosh_p, _, hsl_p⟩ := h_sl_second (Λ_fn p) hΛp hk0_p
          rw [hsl_p, h_phi_second (Λ_fn p) hΛp hcosh_p]
      refine ⟨δ₀, N₁, hδ₀_pos, ?_, ?_⟩
      · intro n hn
        have hn0 : N₀ ≤ n := le_trans hN₁_ge hn
        refine (h4_holo n hn).2.congr ?_
        intro p hp
        obtain ⟨hs, hsh⟩ := (h3_holo n hn0).1 p (hU0_sub1 hp)
        exact h_chordPhi_eq_sl n p hs hsh ((h4_holo n hn).1 p hp)
      · rw [Metric.tendstoUniformlyOn_iff] at h4_unif ⊢
        intro ε hε
        filter_upwards [h4_unif ε hε, Filter.eventually_ge_atTop N₁] with n hn_eps hn p hp
        have hn0 : N₀ ≤ n := le_trans hN₁_ge hn
        obtain ⟨hs, hsh⟩ := (h3_holo n hn0).1 p (hU0_sub1 hp)
        rw [h_chordPhi_eq_sl n p hs hsh ((h4_holo n hn).1 p hp), ← h_lim_eq p hp]
        exact hn_eps p hp

  
  obtain ⟨δ₀, N_reg, hδ₀_pos, h_bi_holo, h_bi_unif⟩ := h_bidisk
  let δ_reg : ℝ := min (min δ₀ 1) (δ₀ / (‖J₀‖ + ‖T₀‖ + 2))
  have hδ_reg_pos : 0 < δ_reg :=
    lt_min (lt_min hδ₀_pos zero_lt_one) (by positivity)
  let P_reg : Set (ℂ × ℂ × ℂ) :=
    { q : ℂ × ℂ × ℂ | ‖q.1 - S₀‖ < δ_reg ∧ ‖q.2.1 - J₀‖ < δ_reg ∧ ‖q.2.2 - T₀‖ < δ_reg }
  let U_δ₀ : Set (ℂ × ℂ) := { p : ℂ × ℂ | ‖p.1 - S₀‖ < δ₀ ∧ ‖p.2 - H₀‖ < δ₀ }
  let π_SH : ℂ × ℂ × ℂ → ℂ × ℂ := fun q => (q.1, q.2.2 * q.2.1)

  have h_maps : Set.MapsTo π_SH P_reg U_δ₀ := by
    intro q ⟨hqS, hqJ, hqT⟩
    have hδ_le0 : δ_reg ≤ δ₀ := le_trans (min_le_left _ _) (min_le_left _ _)
    have hδ_le1 : δ_reg ≤ 1 := le_trans (min_le_left _ _) (min_le_right _ _)
    have hδ_prod : δ_reg ≤ δ₀ / (‖J₀‖ + ‖T₀‖ + 2) := min_le_right _ _
    refine ⟨lt_of_lt_of_le hqS hδ_le0, ?_⟩
    dsimp [π_SH, H₀]
    have hJ_norm : ‖q.2.1‖ ≤ ‖J₀‖ + 1 := by
      calc ‖q.2.1‖ = ‖J₀ + (q.2.1 - J₀)‖ := by ring_nf
        _ ≤ ‖J₀‖ + ‖q.2.1 - J₀‖ := norm_add_le _ _
        _ ≤ ‖J₀‖ + 1 := by linarith
    have h_rew : q.2.2 * q.2.1 - T₀ * J₀ =
        (q.2.2 - T₀) * q.2.1 + T₀ * (q.2.1 - J₀) := by ring
    rw [h_rew]
    have t1 := norm_add_le ((q.2.2 - T₀) * q.2.1) (T₀ * (q.2.1 - J₀))
    have m1 : ‖(q.2.2 - T₀) * q.2.1‖ ≤ δ_reg * (‖J₀‖ + 1) := by
      rw [norm_mul]; exact mul_le_mul hqT.le hJ_norm (norm_nonneg _) (by positivity)
    have m2 : ‖T₀ * (q.2.1 - J₀)‖ ≤ ‖T₀‖ * δ_reg := by
      rw [norm_mul]; exact mul_le_mul_of_nonneg_left hqJ.le (norm_nonneg _)
    have h_mul_le : δ_reg * (‖J₀‖ + ‖T₀‖ + 2) ≤ δ₀ :=
      (le_div_iff₀ (by positivity : 0 < ‖J₀‖ + ‖T₀‖ + 2)).mp hδ_prod
    nlinarith [hδ_reg_pos, norm_nonneg J₀, norm_nonneg T₀]

  have h_act_n : ∀ (n : ℕ) (q : ℂ × ℂ × ℂ),
      chordActionP X
        ((seq.x_seq n : ℂ) + (seq.h_seq n : ℂ) * Complex.I + (seq.ℓ_seq n : ℂ) * q.1)
        q.2.1 (q.2.2 / (seq.m_seq n : ℂ)) =
        q.2.1 ^ 3 * chordPhi X (s_pt n (π_SH q)) (h_pt n (π_SH q)) := by
    intro n q
    dsimp [chordActionP, s_pt, h_pt, s_n, π_SH]
    rw [div_mul_eq_mul_div]

  have h_act_lim : ∀ q : ℂ × ℂ × ℂ,
      frozenActionP kind (q.2.2 * seq.c₀ * Complex.exp (-Complex.I * q.1)) q.2.1 =
        q.2.1 ^ 3 * frozenPhi kind (Λ_fn (π_SH q)) := by
    intro q
    rw [h_factor]
    congr 2
    dsimp [Λ_fn, π_SH]
    ring

  have h_pull_holo : ∀ (G : ℂ × ℂ → ℂ), DifferentiableOn ℂ G U_δ₀ →
      DifferentiableOn ℂ (fun q : ℂ × ℂ × ℂ => q.2.1 ^ 3 * G (π_SH q)) P_reg := by
    intro G hG
    exact DifferentiableOn.mul (by fun_prop)
      (hG.comp (by dsimp [π_SH]; fun_prop) h_maps)

  refine ⟨δ_reg, N_reg, hδ_reg_pos, ?_, ?_⟩
  · intro n hn
    exact (h_pull_holo _ (h_bi_holo n hn)).congr (fun q _ => h_act_n n q)
  · rw [Metric.tendstoUniformlyOn_iff] at h_bi_unif ⊢
    intro ε hε
    let M_J3 : ℝ := (‖J₀‖ + 1) ^ 3 + 1
    have hM_J3_pos : 0 < M_J3 := by positivity
    filter_upwards [h_bi_unif (ε / M_J3) (by positivity)] with n hn q hq
    have hd := hn (π_SH q) (h_maps hq)
    rw [dist_comm, dist_eq_norm] at hd ⊢
    rw [h_act_n n q, h_act_lim q, ← mul_sub, norm_mul, norm_pow]
    have hδ_le1 : δ_reg ≤ 1 := le_trans (min_le_left _ _) (min_le_right _ _)
    have hJ_le : ‖q.2.1‖ ≤ ‖J₀‖ + 1 := by
      calc ‖q.2.1‖ = ‖J₀ + (q.2.1 - J₀)‖ := by ring_nf
        _ ≤ ‖J₀‖ + ‖q.2.1 - J₀‖ := norm_add_le _ _
        _ ≤ ‖J₀‖ + 1 := by linarith [hq.2.1]
    have hJ3_le : ‖q.2.1‖ ^ 3 ≤ M_J3 := by
      have := pow_le_pow_left₀ (norm_nonneg _) hJ_le 3
      dsimp [M_J3]; linarith
    calc ‖q.2.1‖ ^ 3 * ‖chordPhi X (s_pt n (π_SH q)) (h_pt n (π_SH q)) -
          frozenPhi kind (Λ_fn (π_SH q))‖
        ≤ M_J3 * ‖chordPhi X (s_pt n (π_SH q)) (h_pt n (π_SH q)) -
            frozenPhi kind (Λ_fn (π_SH q))‖ :=
          mul_le_mul_of_nonneg_right hJ3_le (norm_nonneg _)
      _ < M_J3 * (ε / M_J3) := mul_lt_mul_of_pos_left hd hM_J3_pos
      _ = ε := mul_div_cancel₀ ε hM_J3_pos.ne'

theorem sturm_liouville_chord_action_and_frozen_convergence : (∀ S : FiniteWallNonisotropicStrip, IsExpObstructionStrip S.toExpStripData) ∧
    (∀ E : EntireNonisotropicStrip, IsExpObstructionStrip E.toExpStripData) ∧
    (∀ X : ExpStripData, IsExpObstructionStrip X → Nonempty (ChordActionPackage X)) :=
by
  refine ⟨?_, ?_, ?_⟩
  · intro S
    have hs_sub : horizStrip S.s_star ⊆ horizStrip S.H :=
      fun s hs => lt_trans hs S.s_star_lt_H
    refine
      { c_pos := S.c_pos
        s_star_pos := S.s_star_pos
        r_star_pos := S.r_star_pos
        r_star_lt_half_s_star := S.r_star_lt_half_s_star
        r_star_lt_pi := S.r_star_lt_pi
        D_strip_open := isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const
        D_strip_convex := by
          intro z₁ hz₁ z₂ hz₂ a b ha hb hab
          change |(a • z₁ + b • z₂).im| < S.H
          change |z₁.im| < S.H at hz₁
          change |z₂.im| < S.H at hz₂
          have him : (a • z₁ + b • z₂).im = a * z₁.im + b * z₂.im := by simp
          rw [him]
          calc |a * z₁.im + b * z₂.im|
              ≤ |a * z₁.im| + |b * z₂.im| := abs_add_le _ _
            _ = a * |z₁.im| + b * |z₂.im| := by
                rw [abs_mul, abs_mul, abs_of_nonneg ha, abs_of_nonneg hb]
            _ < a * S.H + b * S.H := by
                rcases eq_or_lt_of_le ha with rfl | ha_pos
                · simp only [zero_add] at hab
                  subst hab
                  linarith
                · nlinarith
            _ = (a + b) * S.H := by ring
            _ = S.H := by rw [hab, one_mul]
        base_strip_subset := hs_sub
        D_strip_add_real := by
          intro s hs x
          change |(s + (x : ℂ)).im| < S.H
          change |s.im| < S.H at hs
          simpa using hs
        D_strip_conj := by
          intro s hs
          change |((starRingEnd ℂ) s).im| < S.H
          change |s.im| < S.H at hs
          simpa using hs
        D_strip_vert_balanced := by
          intro s hs y hy
          change |((s.re : ℂ) + (y : ℂ) * Complex.I).im| < S.H
          change |s.im| < S.H at hs
          have him : ((s.re : ℂ) + (y : ℂ) * Complex.I).im = y := by simp
          rw [him]
          exact lt_of_le_of_lt hy hs
        ϕ_holo := S.ϕ_holo
        f_holo := S.f_holo
        q_holo := S.q_holo
        deriv_ϕ := S.deriv_ϕ
        deriv2_f := S.deriv2_f
        ϕ_quasiperiodic := S.ϕ_quasiperiodic
        f_periodic := S.f_periodic
        q_periodic := S.q_periodic
        ϕ_conj := S.ϕ_conj
        f_conj := S.f_conj
        q_conj := S.q_conj
        f_real_pos := S.f_real_pos
        f_lower_strip_ne_zero := S.f_lower_strip_ne_zero
        Γ_base_holo :=
          ⟨fun s hs =>
            (S.Γ_reg_holo s (hs_sub hs) (S.f_lower_strip_ne_zero s hs)).1.differentiableWithinAt,
           fun s hs =>
            (S.Γ_reg_holo s (hs_sub hs) (S.f_lower_strip_ne_zero s hs)).2.differentiableWithinAt⟩
        Γ_base_deriv₀ := fun s hs => S.Γ_deriv₀ s (hs_sub hs) (S.f_lower_strip_ne_zero s hs)
        Γ_base_deriv₁ := fun s hs => S.Γ_deriv₁ s (hs_sub hs) (S.f_lower_strip_ne_zero s hs)
        Γ_base_periodic := fun s hs => S.Γ_periodic s (hs_sub hs) (S.f_lower_strip_ne_zero s hs)
        Γ_base_conj := fun s hs => S.Γ_conj s (hs_sub hs) (S.f_lower_strip_ne_zero s hs)
        Tube_open := S.tube_open
        Tube_base_subset := by
          intro p hp
          dsimp [FiniteWallNonisotropicStrip.toExpStripData] at hp ⊢
          rcases hp with ⟨hp1, hp2⟩ | ⟨hp1, hp2⟩
          · have hb1 : S.s_star ≤ S.h_X p.2 := (S.h_X_bounds p.2 (by simpa using hp2)).1
            have hb2 : S.s_star ≤ S.h_X (starRingEnd ℂ p.2) :=
              (S.h_X_bounds (starRingEnd ℂ p.2) (by simpa using hp2)).1
            rw [abs_lt] at hp1
            exact ⟨hp2, by linarith, by linarith⟩
          · change |p.1.im| < S.H at hp1
            rw [abs_lt] at hp1
            refine ⟨by simp [hp2, S.r_star_pos], ?_, ?_⟩
            · simp [hp2, S.h_X_zero]; linarith
            · simp [hp2, S.h_X_zero]; linarith
        Tube_param_subset := fun _ hp => hp.1
        Tube_vertically_star_shaped := by
          intro y t hyt η hη0 hη1
          rcases hyt with ⟨ht_norm, hy_lo, hy_hi⟩
          have hb1 : S.s_star ≤ S.h_X t := (S.h_X_bounds t (by simpa using ht_norm)).1
          have hb2 : S.s_star ≤ S.h_X (starRingEnd ℂ t) :=
            (S.h_X_bounds (starRingEnd ℂ t) (by simpa using ht_norm)).1
          have hs_pos : 0 < S.s_star := S.s_star_pos
          refine ⟨ht_norm, ?_, ?_⟩
          · change -S.h_X (starRingEnd ℂ t) < (((y.re : ℂ) + ((η * y.im : ℝ) : ℂ) * Complex.I)).im
            have him : (((y.re : ℂ) + ((η * y.im : ℝ) : ℂ) * Complex.I)).im = η * y.im := by simp
            rw [him]
            rcases le_or_gt 0 y.im with hy0 | hy0
            · have : 0 ≤ η * y.im := mul_nonneg hη0 hy0
              linarith
            · nlinarith
          · change (((y.re : ℂ) + ((η * y.im : ℝ) : ℂ) * Complex.I)).im < S.h_X t
            have him : (((y.re : ℂ) + ((η * y.im : ℝ) : ℂ) * Complex.I)).im = η * y.im := by simp
            rw [him]
            rcases le_or_gt 0 y.im with hy0 | hy0
            · nlinarith
            · have : η * y.im ≤ 0 := mul_nonpos_of_nonneg_of_nonpos hη0 hy0.le
              linarith
        Tube_horiz_invariant := by
          intro y t x hyt
          rcases hyt with ⟨ht_norm, hy_lo, hy_hi⟩
          exact ⟨ht_norm, by simpa using hy_lo, by simpa using hy_hi⟩
        Tube_even := by
          intro y t hyt
          rcases hyt with ⟨ht_norm, hy_lo, hy_hi⟩
          have ht_ball : t ∈ Metric.ball (0 : ℂ) S.r_star := by simpa using ht_norm
          have hct_ball : starRingEnd ℂ t ∈ Metric.ball (0 : ℂ) S.r_star := by simpa using ht_norm
          have he1 : S.h_X (-t) = S.h_X t := S.h_X_even t ht_ball
          have he2 : S.h_X (starRingEnd ℂ (-t)) = S.h_X (starRingEnd ℂ t) := by
            rw [map_neg]
            exact S.h_X_even (starRingEnd ℂ t) hct_ball
          exact ⟨by simpa using ht_norm,
            by dsimp at hy_lo ⊢; rw [he2]; exact hy_lo,
            by dsimp at hy_hi ⊢; rw [he1]; exact hy_hi⟩
        Tube_conj := by
          intro y t hyt
          rcases hyt with ⟨ht_norm, hy_lo, hy_hi⟩
          refine ⟨by simpa using ht_norm, ?_, ?_⟩
          · change -S.h_X (starRingEnd ℂ (starRingEnd ℂ t)) < (starRingEnd ℂ y).im
            simp only [RingHomCompTriple.comp_apply, RingHom.id_apply, Complex.conj_im]
            linarith
          · change (starRingEnd ℂ y).im < S.h_X (starRingEnd ℂ t)
            simp only [Complex.conj_im]
            linarith
        𝔰_holo := S.𝔰_holo
        𝔰_maps_to := S.𝔰_maps_to
        𝔰_lower_strip_im := S.𝔰_lower_strip_im
        𝔰_zero := S.𝔰_zero
        𝔰_quasiperiodic := fun y t hyt => S.𝔰_quasiperiodic (y, t) hyt
        𝔰_even := fun y t hyt => S.𝔰_even (y, t) hyt
        𝔰_conj := fun y t hyt => S.𝔰_conj (y, t) hyt
        𝔰_mean_zero := S.𝔰_mean_zero
        real_collar_reflection := by
          intro x t ht_pos ht_lt
          obtain ⟨_, _, h1, h2, h3, h4, h5, h6, h7, h8, h9, _⟩ :=
            S.real_collar_chord x t ht_pos ht_lt
          refine ⟨h1, h2, ?_, ?_, h5, h6, h7, h8, h9⟩
          · dsimp [FiniteWallNonisotropicStrip.toExpStripData]
            have h_arg : (((x - t : ℝ) : ℂ) + (t : ℂ) / 2) = (x : ℂ) - (t : ℂ) / 2 := by
              push_cast
              ring
            rw [h_arg]
            exact h3
          · dsimp [FiniteWallNonisotropicStrip.toExpStripData]
            have h_arg : (((x + 2 * Real.pi : ℝ) : ℂ) + (t : ℂ) / 2) =
                (x : ℂ) + 2 * Real.pi + (t : ℂ) / 2 := by
              push_cast
              ring
            rw [h_arg]
            exact h4
        real_vertical_promotion := by
          intro t₀ x₀ b ht₀_abs hb_pos ⟨W, hW_open, hW_seg, s_tilde, hs_holo, hs_maps, δ₀, hδ₀_pos, h_agree⟩
          dsimp [FiniteWallNonisotropicStrip.toExpStripData] at ht₀_abs hs_maps h_agree ⊢
          have ht₀_ball : (t₀ : ℂ) ∈ Metric.ball (0 : ℂ) S.r_star := by
            rw [Metric.mem_ball, dist_zero_right, Complex.norm_real]
            exact ht₀_abs
          have hb_lt_H₁ : b < S.h_X (t₀ : ℂ) := by
            by_contra! hH₁_le
            let H₁ : ℝ := S.h_X (t₀ : ℂ)
            have hH₁_ge_s : S.s_star ≤ H₁ := (S.h_X_bounds (t₀ : ℂ) ht₀_ball).1
            have hH₁_pos : 0 < H₁ := lt_of_lt_of_le S.s_star_pos hH₁_ge_s
            let γ : ℝ → ℂ × ℂ := fun η => ((x₀ : ℂ) + (η : ℂ) * Complex.I, (t₀ : ℂ))
            have hγ_cont : Continuous γ := by fun_prop
            let K_seg : Set (ℂ × ℂ) := γ '' Set.Icc (0 : ℝ) H₁
            have hK_comp : IsCompact K_seg := isCompact_Icc.image hγ_cont
            have hK_sub : K_seg ⊆ W := by
              rintro _ ⟨η, ⟨hη0, hη1⟩, rfl⟩
              exact hW_seg η hη0 (le_trans hη1 hH₁_le)
            obtain ⟨r_W, hr_W_pos, hr_W_sub⟩ := hK_comp.exists_thickening_subset_open hW_open hK_sub
            let ε : ℝ :=
              min (min (r_W / 2) (S.s_star / 2)) (min ((S.r_star - |t₀|) / 2) (δ₀ / 2))
            have hε_pos : 0 < ε := by
              refine lt_min (lt_min (by positivity) (by linarith [S.s_star_pos]))
                (lt_min (by linarith) (by positivity))
            have hε_le_rW : ε ≤ r_W / 2 := le_trans (min_le_left _ _) (min_le_left _ _)
            have hε_le_s : ε ≤ S.s_star / 2 := le_trans (min_le_left _ _) (min_le_right _ _)
            have hε_le_r : ε ≤ (S.r_star - |t₀|) / 2 :=
              le_trans (min_le_right _ _) (min_le_left _ _)
            have hε_le_δ₀ : ε ≤ δ₀ / 2 := le_trans (min_le_right _ _) (min_le_right _ _)
            have hε_lt_s : ε < S.s_star := by linarith [S.s_star_pos]
            have h_ball_W : ∀ p : ℂ × ℂ,
                ‖p.1 - ((x₀ : ℂ) + (H₁ : ℂ) * Complex.I)‖ < ε →
                ‖p.2 - (t₀ : ℂ)‖ < ε → p ∈ W := by
              intro p hp1 hp2
              apply hr_W_sub
              rw [Metric.mem_thickening_iff]
              refine ⟨γ H₁, ⟨H₁, ⟨hH₁_pos.le, le_rfl⟩, rfl⟩, ?_⟩
              rw [Prod.dist_eq, max_lt_iff]
              refine ⟨?_, ?_⟩
              · rw [dist_eq_norm]
                linarith
              · rw [dist_eq_norm]
                linarith
            have h_lsc_ev := S.h_X_lsc (t₀ : ℂ) ht₀_ball (H₁ - ε / 8) (by linarith)
            obtain ⟨δ_lsc, hδ_lsc_pos, hδ_lsc⟩ := Metric.mem_nhdsWithin_iff.mp h_lsc_ev
            let δ : ℝ := min ε δ_lsc
            have hδ_pos : 0 < δ := lt_min hε_pos hδ_lsc_pos
            have hδ_le_ε : δ ≤ ε := min_le_left _ _
            have hδ_le_lsc : δ ≤ δ_lsc := min_le_right _ _
            refine S.no_patch_at_real_wall t₀ x₀ ε ht₀_abs hε_pos hε_lt_s
              ⟨s_tilde, hs_holo.mono (fun p hp => h_ball_W p hp.1 hp.2),
                fun p hp1 hp2 => hs_maps p (h_ball_W p hp1 hp2), δ, hδ_pos, hδ_le_ε, ?_⟩
            intro p hp_re hp_im hp_t
            set t : ℂ := p.2
            have ht_norm : ‖t‖ < S.r_star := by
              have h1 : ‖t‖ ≤ ‖(t₀ : ℂ)‖ + ‖t - (t₀ : ℂ)‖ := norm_le_insert' t (t₀ : ℂ)
              have h2 : ‖(t₀ : ℂ)‖ = |t₀| := Complex.norm_real t₀
              linarith
            have ht_ball_r : t ∈ Metric.ball (0 : ℂ) S.r_star := by simpa using ht_norm
            have hct_ball_r : starRingEnd ℂ t ∈ Metric.ball (0 : ℂ) S.r_star := by simpa using ht_norm
            have ht_hX : H₁ - ε / 8 < S.h_X t := by
              have ht_mem : t ∈ Metric.ball (t₀ : ℂ) δ_lsc ∩ Metric.ball (0 : ℂ) S.r_star := by
                refine ⟨?_, ht_ball_r⟩
                rw [Metric.mem_ball, dist_eq_norm]
                exact lt_of_lt_of_le hp_t hδ_le_lsc
              exact hδ_lsc ht_mem
            have hct_hX : S.s_star ≤ S.h_X (starRingEnd ℂ t) := (S.h_X_bounds _ hct_ball_r).1
            let R_y : Set ℂ :=
              { y : ℂ | |y.re - x₀| < ε / 4 ∧ -ε / 4 < y.im ∧ y.im < H₁ - ε / 4 }
            have hR_open : IsOpen R_y := by
              change IsOpen ({ y : ℂ | |y.re - x₀| < ε / 4 } ∩
                ({ y : ℂ | -ε / 4 < y.im } ∩ { y : ℂ | y.im < H₁ - ε / 4 }))
              refine (isOpen_lt ?_ continuous_const).inter
                ((isOpen_lt continuous_const Complex.continuous_im).inter
                  (isOpen_lt Complex.continuous_im continuous_const))
              fun_prop
            have hR_conv : Convex ℝ R_y := by
              intro y₁ hy₁ y₂ hy₂ a c ha hc hac
              rcases hy₁ with ⟨hre₁, him_lo₁, him_hi₁⟩
              rcases hy₂ with ⟨hre₂, him_lo₂, him_hi₂⟩
              have h_re_eq : (a • y₁ + c • y₂).re - x₀ =
                  a * (y₁.re - x₀) + c * (y₂.re - x₀) := by
                simp only [Complex.add_re, Complex.real_smul, Complex.mul_re, Complex.ofReal_re,
                  Complex.ofReal_im, zero_mul, sub_zero]
                calc a * y₁.re + c * y₂.re - x₀
                    = a * y₁.re + c * y₂.re - 1 * x₀ := by ring
                  _ = a * y₁.re + c * y₂.re - (a + c) * x₀ := by rw [hac]
                  _ = a * (y₁.re - x₀) + c * (y₂.re - x₀) := by ring
              have h_im_eq : (a • y₁ + c • y₂).im = a * y₁.im + c * y₂.im := by simp
              refine ⟨?_, ?_, ?_⟩
              · change |(a • y₁ + c • y₂).re - x₀| < ε / 4
                rw [h_re_eq]
                calc |a * (y₁.re - x₀) + c * (y₂.re - x₀)|
                    ≤ |a * (y₁.re - x₀)| + |c * (y₂.re - x₀)| := abs_add_le _ _
                  _ = a * |y₁.re - x₀| + c * |y₂.re - x₀| := by
                      rw [abs_mul, abs_mul, abs_of_nonneg ha, abs_of_nonneg hc]
                  _ < a * (ε / 4) + c * (ε / 4) := by
                      rcases eq_or_lt_of_le ha with rfl | ha_pos
                      · simp only [zero_add] at hac; subst hac; linarith
                      · nlinarith
                  _ = (a + c) * (ε / 4) := by ring
                  _ = ε / 4 := by rw [hac, one_mul]
              · change -ε / 4 < (a • y₁ + c • y₂).im
                rw [h_im_eq]
                rcases eq_or_lt_of_le ha with rfl | ha_pos
                · simp only [zero_add] at hac; subst hac; linarith
                · calc -ε / 4 = (a + c) * (-ε / 4) := by rw [hac, one_mul]
                    _ < a * y₁.im + c * y₂.im := by nlinarith
              · change (a • y₁ + c • y₂).im < H₁ - ε / 4
                rw [h_im_eq]
                rcases eq_or_lt_of_le ha with rfl | ha_pos
                · simp only [zero_add] at hac; subst hac; linarith
                · calc a * y₁.im + c * y₂.im
                    < (a + c) * (H₁ - ε / 4) := by nlinarith
                    _ = H₁ - ε / 4 := by rw [hac, one_mul]
            have hR_W : ∀ y ∈ R_y, (y, t) ∈ W := by
              intro y ⟨hy_re, hy_lo, hy_hi⟩
              apply hr_W_sub
              rw [Metric.mem_thickening_iff]
              let η : ℝ := max 0 y.im
              have hη_mem : η ∈ Set.Icc (0 : ℝ) H₁ :=
                ⟨le_max_left _ _, max_le hH₁_pos.le (by linarith)⟩
              refine ⟨γ η, ⟨η, hη_mem, rfl⟩, ?_⟩
              rw [Prod.dist_eq, max_lt_iff]
              refine ⟨?_, ?_⟩
              · rw [dist_eq_norm]
                have h_im_diff : |(y - ((x₀ : ℂ) + (η : ℂ) * Complex.I)).im| < ε / 4 := by
                  have : (y - ((x₀ : ℂ) + (η : ℂ) * Complex.I)).im = y.im - max 0 y.im := by simp [η]
                  rw [this]
                  rcases le_or_gt 0 y.im with h0 | h0
                  · rw [max_eq_right h0, sub_self, abs_zero]; linarith
                  · rw [max_eq_left h0.le, sub_zero, abs_of_neg h0]; linarith
                have h_re_diff : |(y - ((x₀ : ℂ) + (η : ℂ) * Complex.I)).re| < ε / 4 := by
                  simpa using hy_re
                have h_norm := Complex.norm_le_abs_re_add_abs_im (y - ((x₀ : ℂ) + (η : ℂ) * Complex.I))
                linarith
              · rw [dist_eq_norm]
                linarith
            have hR_tube : ∀ y ∈ R_y, (y, t) ∈ finiteWallTube S.r_star S.h_X := by
              intro y ⟨_, hy_lo, hy_hi⟩
              exact ⟨ht_norm, by dsimp; linarith, by dsimp; linarith⟩
            have hg1_holo : DifferentiableOn ℂ (fun y => s_tilde (y, t)) R_y := by
              have h_map : Differentiable ℂ (fun y : ℂ => (y, t)) := by fun_prop
              exact hs_holo.comp h_map.differentiableOn hR_W
            have hg2_holo : DifferentiableOn ℂ (fun y => S.𝔰 (y, t)) R_y := by
              have h_map : Differentiable ℂ (fun y : ℂ => (y, t)) := by fun_prop
              exact S.𝔰_holo.comp h_map.differentiableOn hR_tube
            have hg1_ana : AnalyticOnNhd ℂ (fun y => s_tilde (y, t)) R_y :=
              (Complex.analyticOnNhd_iff_differentiableOn hR_open).mpr hg1_holo
            have hg2_ana : AnalyticOnNhd ℂ (fun y => S.𝔰 (y, t)) R_y :=
              (Complex.analyticOnNhd_iff_differentiableOn hR_open).mpr hg2_holo
            have hx₀_mem : (x₀ : ℂ) ∈ R_y := by
              refine ⟨by simp; linarith, by simp; linarith, ?_⟩
              simp only [Complex.ofReal_im]
              linarith
            have hp1_mem : p.1 ∈ R_y := by
              rw [abs_lt] at hp_im
              exact ⟨hp_re, by linarith, by linarith⟩
            have h_ev : (fun y => s_tilde (y, t)) =ᶠ[nhds (x₀ : ℂ)] (fun y => S.𝔰 (y, t)) := by
              filter_upwards [Metric.ball_mem_nhds (x₀ : ℂ) hδ₀_pos] with y hy
              rw [Metric.mem_ball, dist_eq_norm] at hy
              exact (h_agree y t hy (by linarith)).2
            exact hg1_ana.eqOn_of_preconnected_of_eventuallyEq hg2_ana hR_conv.isPreconnected
              hx₀_mem h_ev hp1_mem
          have h_lsc_b := S.h_X_lsc (t₀ : ℂ) ht₀_ball b hb_lt_H₁
          obtain ⟨δ₁, hδ₁_pos, hδ₁⟩ := Metric.mem_nhdsWithin_iff.mp h_lsc_b
          refine ⟨min δ₁ (S.r_star - |t₀|), lt_min hδ₁_pos (by linarith), ?_⟩
          intro p ⟨hp_im, hp_t⟩
          have hp_t1 : ‖p.2 - (t₀ : ℂ)‖ < δ₁ := lt_of_lt_of_le hp_t (min_le_left _ _)
          have hp_t2 : ‖p.2 - (t₀ : ℂ)‖ < S.r_star - |t₀| :=
            lt_of_lt_of_le hp_t (min_le_right _ _)
          have hp2_norm : ‖p.2‖ < S.r_star := by
            have h1 : ‖p.2‖ ≤ ‖(t₀ : ℂ)‖ + ‖p.2 - (t₀ : ℂ)‖ := norm_le_insert' p.2 (t₀ : ℂ)
            have h2 : ‖(t₀ : ℂ)‖ = |t₀| := Complex.norm_real t₀
            linarith
          have hp2_hX : b < S.h_X p.2 := by
            apply hδ₁
            refine ⟨?_, Metric.mem_ball.mpr (by simpa using hp2_norm)⟩
            rw [Metric.mem_ball, dist_eq_norm]
            exact hp_t1
          have hcp2_t1 : ‖starRingEnd ℂ p.2 - (t₀ : ℂ)‖ < δ₁ := by
            have h_eq : starRingEnd ℂ p.2 - (t₀ : ℂ) = starRingEnd ℂ (p.2 - (t₀ : ℂ)) := by simp
            rw [h_eq, Complex.norm_conj]
            exact hp_t1
          have hcp2_hX : b < S.h_X (starRingEnd ℂ p.2) := by
            apply hδ₁
            refine ⟨?_, Metric.mem_ball.mpr (by simpa using hp2_norm)⟩
            rw [Metric.mem_ball, dist_eq_norm]
            exact hcp2_t1
          rw [abs_le] at hp_im
          exact ⟨hp2_norm, by linarith, by linarith⟩ }
  · intro E
    refine
      { c_pos := E.c_pos
        s_star_pos := E.s_star_pos
        r_star_pos := E.r_star_pos
        r_star_lt_half_s_star := E.r_star_lt_half_s_star
        r_star_lt_pi := E.r_star_lt_pi
        D_strip_open := isOpen_univ
        D_strip_convex := convex_univ
        base_strip_subset := Set.subset_univ _
        D_strip_add_real := fun _ _ _ => Set.mem_univ _
        D_strip_conj := fun _ _ => Set.mem_univ _
        D_strip_vert_balanced := fun _ _ _ _ => Set.mem_univ _
        ϕ_holo := E.ϕ_entire.differentiableOn
        f_holo := E.f_entire.differentiableOn
        q_holo := E.q_entire.differentiableOn
        deriv_ϕ := fun s _ => E.deriv_ϕ s
        deriv2_f := fun s _ => E.deriv2_f s
        ϕ_quasiperiodic := fun s _ => E.ϕ_quasiperiodic s
        f_periodic := fun s _ => E.f_periodic s
        q_periodic := fun s _ => E.q_periodic s
        ϕ_conj := fun s _ => E.ϕ_conj s
        f_conj := fun s _ => E.f_conj s
        q_conj := fun s _ => E.q_conj s
        f_real_pos := E.f_real_pos
        f_lower_strip_ne_zero := E.f_lower_strip_ne_zero
        Γ_base_holo := E.Γ0_holo
        Γ_base_deriv₀ := E.Γ0_deriv₀
        Γ_base_deriv₁ := E.Γ0_deriv₁
        Γ_base_periodic := E.Γ0_periodic
        Γ_base_conj := E.Γ0_conj
        Tube_open := E.T_open
        Tube_base_subset := by
          intro p hp
          apply E.T_base_subset
          rcases hp with hp | hp
          · exact Or.inl hp
          · exact Or.inr hp.2
        Tube_param_subset := E.T_param_subset
        Tube_vertically_star_shaped := E.T_vertically_star_shaped
        Tube_horiz_invariant := E.T_horiz_invariant
        Tube_even := E.T_even
        Tube_conj := E.T_conj
        𝔰_holo := E.𝔰_holo
        𝔰_maps_to := fun _ _ => Set.mem_univ _
        𝔰_lower_strip_im := E.𝔰_lower_strip_im
        𝔰_zero := fun y _ => E.𝔰_zero y
        𝔰_quasiperiodic := E.𝔰_quasiperiodic
        𝔰_even := E.𝔰_even
        𝔰_conj := E.𝔰_conj
        𝔰_mean_zero := E.𝔰_mean_zero
        real_collar_reflection := E.real_collar_reflection
        real_vertical_promotion := by
          intro t₀ x₀ b ht₀ hb ⟨W, hW_open, hW_seg, s_tilde, hs_holo, _, δ₀, hδ₀_pos, h_agree⟩
          exact E.real_vertical_promotion t₀ x₀ b ht₀ hb
            ⟨W, hW_open, hW_seg, s_tilde, hs_holo, δ₀, hδ₀_pos, h_agree⟩ }
  · intro X hX
    have hVolt : VolterraDivisionProp := volterra_picard_and_analytic_division
    obtain ⟨⟨η_sf, C_sf, hη_pos, hC_pos, hSF⟩, ⟨r_rec, hr_pos, hr_lt, hRec⟩⟩ :=
      small_field_and_base_collar_recurrence hVolt X hX
    refine ⟨{
      p_act := chordActionP X
      η_sf := η_sf
      C_sf := C_sf
      r_rec := r_rec
      η_sf_pos := hη_pos
      C_sf_pos := hC_pos
      r_rec_pos := hr_pos
      r_rec_lt := hr_lt
      p_act_zero := by
        intro s J
        simp [chordActionP, chordPhi]
        ring
      small_field := hSF
      base_recurrence := hRec
      frozen_conv := fun kind seq S₀ J₀ T₀ hReg =>
        frozen_action_regular_convergence hVolt X hX kind seq S₀ J₀ T₀ hReg
    }⟩

theorem ref_steep_action_perturbation_jets (X : ExpStripData) (P : ChordActionPackage X) :
    RefSteepJetProp X P :=
by
  let b₁ : ℂ × ℂ × ℂ := (1, (0, 0))
  let b₂ : ℂ × ℂ × ℂ := (0, (1, 0))
  let b₃ : ℂ × ℂ × ℂ := (0, (0, 1))
  have hb_eq : ∀ u₁ u₂ u₃ : ℂ, u₁ • b₁ + u₂ • b₂ + u₃ • b₃ = (u₁, (u₂, u₃)) := by
    intro u₁ u₂ u₃
    refine Prod.ext ?_ (Prod.ext ?_ ?_) <;> simp [b₁, b₂, b₃]

  have h_actA_comp : ∀ {E : Type} [NormedAddCommGroup E] [NormedSpace ℂ E]
      (z₀ : ℂ) (r_s r_t : ℝ) (W : Set E) (f₁ f₂ f₃ : E → ℂ),
      DifferentiableOn ℂ (fun q : ℂ × ℂ × ℂ => P.p_act q.1 q.2.1 q.2.2)
        (refSteepPolydisk z₀ r_s r_t) →
      DifferentiableOn ℂ f₁ W →
      DifferentiableOn ℂ f₂ W →
      DifferentiableOn ℂ f₃ W →
      (∀ x ∈ W, ‖f₁ x - z₀‖ < r_s / 4 ∧ ‖f₂ x - 1‖ < 1 / 4 ∧ ‖f₃ x‖ < r_t) →
      DifferentiableOn ℂ (fun x => refSteepActionA P (f₁ x) (f₂ x) (f₃ x)) W := by
    intro E _ _ z₀ r_s r_t W f₁ f₂ f₃ hP hf₁ hf₂ hf₃ hMaps
    let tup : E → ℂ × ℂ × ℂ := fun x => f₁ x • b₁ + f₂ x • b₂ + f₃ x • b₃
    have htup_diff : DifferentiableOn ℂ tup W :=
      ((hf₁.smul_const b₁).add (hf₂.smul_const b₂)).add (hf₃.smul_const b₃)
    have htup_maps : Set.MapsTo tup W (refSteepPolydisk z₀ r_s r_t) := by
      intro x hx
      rw [show tup x = (f₁ x, (f₂ x, f₃ x)) from hb_eq (f₁ x) (f₂ x) (f₃ x)]
      exact hMaps x hx
    have hp_diff : DifferentiableOn ℂ (fun x => P.p_act (f₁ x) (f₂ x) (f₃ x)) W := by
      refine (hP.comp htup_diff htup_maps).congr (fun x _ => ?_)
      dsimp only [Function.comp_def, tup]
      rw [hb_eq (f₁ x) (f₂ x) (f₃ x)]
    have hcub_diff : DifferentiableOn ℂ (fun x => (1 / 24 : ℂ) * (f₂ x) ^ 3) W :=
      (differentiableOn_const (1 / 24 : ℂ)).mul (hf₂.pow 3)
    refine (hp_diff.sub hcub_diff).congr (fun x _ => ?_)
    change P.p_act (f₁ x) (f₂ x) (f₃ x) - (f₂ x) ^ 3 / 24 =
      P.p_act (f₁ x) (f₂ x) (f₃ x) - (1 / 24 : ℂ) * (f₂ x) ^ 3
    ring

  have h_actA_cont : ∀ {α : Type} [TopologicalSpace α]
      (z₀ : ℂ) (r_s r_t : ℝ) (S : Set α) (g₁ g₂ g₃ : α → ℂ),
      DifferentiableOn ℂ (fun q : ℂ × ℂ × ℂ => P.p_act q.1 q.2.1 q.2.2)
        (refSteepPolydisk z₀ r_s r_t) →
      ContinuousOn g₁ S →
      ContinuousOn g₂ S →
      ContinuousOn g₃ S →
      (∀ x ∈ S, ‖g₁ x - z₀‖ < r_s / 4 ∧ ‖g₂ x - 1‖ < 1 / 4 ∧ ‖g₃ x‖ < r_t) →
      ContinuousOn (fun x => refSteepActionA P (g₁ x) (g₂ x) (g₃ x)) S := by
    intro α _ z₀ r_s r_t S g₁ g₂ g₃ hP hg₁ hg₂ hg₃ hMaps
    let tup : α → ℂ × ℂ × ℂ := fun x => g₁ x • b₁ + g₂ x • b₂ + g₃ x • b₃
    have htup_cont : ContinuousOn tup S :=
      ((hg₁.smul continuousOn_const).add (hg₂.smul continuousOn_const)).add
        (hg₃.smul continuousOn_const)
    have htup_maps : Set.MapsTo tup S (refSteepPolydisk z₀ r_s r_t) := by
      intro x hx
      rw [show tup x = (g₁ x, (g₂ x, g₃ x)) from hb_eq (g₁ x) (g₂ x) (g₃ x)]
      exact hMaps x hx
    have hp_cont : ContinuousOn (fun x => P.p_act (g₁ x) (g₂ x) (g₃ x)) S := by
      refine (hP.continuousOn.comp htup_cont htup_maps).congr (fun x _ => ?_)
      dsimp only [Function.comp_def, tup]
      rw [hb_eq (g₁ x) (g₂ x) (g₃ x)]
    have hcub_cont : ContinuousOn (fun x => (1 / 24 : ℂ) * (g₂ x) ^ 3) S :=
      continuousOn_const.mul (hg₂.pow 3)
    refine (hp_cont.sub hcub_cont).congr (fun x _ => ?_)
    change P.p_act (g₁ x) (g₂ x) (g₃ x) - (g₂ x) ^ 3 / 24 =
      P.p_act (g₁ x) (g₂ x) (g₃ x) - (1 / 24 : ℂ) * (g₂ x) ^ 3
    ring

  have hDiffA_J_on : ∀ (z₀ : ℂ) (r_s r_t : ℝ),
      DifferentiableOn ℂ (fun q : ℂ × ℂ × ℂ => P.p_act q.1 q.2.1 q.2.2)
        (refSteepPolydisk z₀ r_s r_t) →
      ∀ s t : ℂ, ‖s - z₀‖ < r_s / 4 → ‖t‖ < r_t →
      DifferentiableOn ℂ (fun J' : ℂ => refSteepActionA P s J' t)
        (Metric.ball (1 : ℂ) (1 / 4)) := by
    intro z₀ r_s r_t hP s t hs ht
    exact h_actA_comp z₀ r_s r_t (Metric.ball (1 : ℂ) (1 / 4))
      (fun _ => s) id (fun _ => t) hP
      (differentiableOn_const s) differentiableOn_id (differentiableOn_const t)
      (fun J' hJ' => ⟨hs, by simpa [Metric.mem_ball, dist_eq_norm] using hJ', ht⟩)

  have hDiffA_s_on : ∀ (z₀ : ℂ) (r_s r_t : ℝ),
      DifferentiableOn ℂ (fun q : ℂ × ℂ × ℂ => P.p_act q.1 q.2.1 q.2.2)
        (refSteepPolydisk z₀ r_s r_t) →
      ∀ J t : ℂ, ‖J - 1‖ < 1 / 4 → ‖t‖ < r_t →
      DifferentiableOn ℂ (fun s' : ℂ => refSteepActionA P s' J t)
        (Metric.ball z₀ (r_s / 4)) := by
    intro z₀ r_s r_t hP J t hJ ht
    exact h_actA_comp z₀ r_s r_t (Metric.ball z₀ (r_s / 4))
      id (fun _ => J) (fun _ => t) hP
      differentiableOn_id (differentiableOn_const J) (differentiableOn_const t)
      (fun s' hs' => ⟨by simpa [Metric.mem_ball, dist_eq_norm] using hs', hJ, ht⟩)

  have hDiffA_J : ∀ (z₀ : ℂ) (r_s r_t : ℝ),
      DifferentiableOn ℂ (fun q : ℂ × ℂ × ℂ => P.p_act q.1 q.2.1 q.2.2)
        (refSteepPolydisk z₀ r_s r_t) →
      ∀ s J t : ℂ, ‖s - z₀‖ < r_s / 4 → ‖J - 1‖ < 1 / 4 → ‖t‖ < r_t →
      DifferentiableAt ℂ (fun J' : ℂ => refSteepActionA P s J' t) J := by
    intro z₀ r_s r_t hP s J t hs hJ ht
    exact (hDiffA_J_on z₀ r_s r_t hP s t hs ht).differentiableAt
      (Metric.isOpen_ball.mem_nhds (by simpa [Metric.mem_ball, dist_eq_norm] using hJ))

  have hDiffA_s : ∀ (z₀ : ℂ) (r_s r_t : ℝ),
      DifferentiableOn ℂ (fun q : ℂ × ℂ × ℂ => P.p_act q.1 q.2.1 q.2.2)
        (refSteepPolydisk z₀ r_s r_t) →
      ∀ s J t : ℂ, ‖s - z₀‖ < r_s / 4 → ‖J - 1‖ < 1 / 4 → ‖t‖ < r_t →
      DifferentiableAt ℂ (fun s' : ℂ => refSteepActionA P s' J t) s := by
    intro z₀ r_s r_t hP s J t hs hJ ht
    exact (hDiffA_s_on z₀ r_s r_t hP J t hJ ht).differentiableAt
      (Metric.isOpen_ball.mem_nhds (by simpa [Metric.mem_ball, dist_eq_norm] using hs))

  have hP_split : ∀ s J' t : ℂ,
      P.p_act s J' t = (1 / 24 : ℂ) * J' ^ 3 + refSteepActionA P s J' t := by
    intro s J' t
    dsimp [refSteepActionA]
    ring

  have hP_deriv_J : ∀ (z₀ : ℂ) (r_s r_t : ℝ),
      DifferentiableOn ℂ (fun q : ℂ × ℂ × ℂ => P.p_act q.1 q.2.1 q.2.2)
        (refSteepPolydisk z₀ r_s r_t) →
      ∀ s J t : ℂ, ‖s - z₀‖ < r_s / 4 → ‖J - 1‖ < 1 / 4 → ‖t‖ < r_t →
      deriv (fun J' : ℂ => P.p_act s J' t) J =
        (1 / 8 : ℂ) * J ^ 2 + refSteepActionDJ P s J t := by
    intro z₀ r_s r_t hP s J t hs hJ ht
    have hd_cub : HasDerivAt (fun J' : ℂ => (1 / 24 : ℂ) * J' ^ 3) ((1 / 8 : ℂ) * J ^ 2) J := by
      have h1 := (hasDerivAt_pow 3 J).const_mul (1 / 24 : ℂ)
      convert h1 using 1
      ring
    have hd_act : HasDerivAt (fun J' : ℂ => refSteepActionA P s J' t)
        (refSteepActionDJ P s J t) J :=
      (hDiffA_J z₀ r_s r_t hP s J t hs hJ ht).hasDerivAt
    have hd_sum := hd_cub.add hd_act
    have h_fn : (fun J' : ℂ => P.p_act s J' t) =
        (fun J' : ℂ => (1 / 24 : ℂ) * J' ^ 3 + refSteepActionA P s J' t) := by
      ext J'
      exact hP_split s J' t
    rw [h_fn]
    exact hd_sum.deriv

  have hP_deriv_s : ∀ (z₀ : ℂ) (r_s r_t : ℝ),
      DifferentiableOn ℂ (fun q : ℂ × ℂ × ℂ => P.p_act q.1 q.2.1 q.2.2)
        (refSteepPolydisk z₀ r_s r_t) →
      ∀ s J t : ℂ, ‖s - z₀‖ < r_s / 4 → ‖J - 1‖ < 1 / 4 → ‖t‖ < r_t →
      deriv (fun s' : ℂ => P.p_act s' J t) s = refSteepActionDS P s J t := by
    intro z₀ r_s r_t hP s J t hs hJ ht
    have hd_act : HasDerivAt (fun s' : ℂ => refSteepActionA P s' J t)
        (refSteepActionDS P s J t) s :=
      (hDiffA_s z₀ r_s r_t hP s J t hs hJ ht).hasDerivAt
    have hd_sum : HasDerivAt
        (fun s' : ℂ => (1 / 24 : ℂ) * J ^ 3 + refSteepActionA P s' J t)
        (refSteepActionDS P s J t) s :=
      hd_act.const_add ((1 / 24 : ℂ) * J ^ 3)
    have h_fn : (fun s' : ℂ => P.p_act s' J t) =
        (fun s' : ℂ => (1 / 24 : ℂ) * J ^ 3 + refSteepActionA P s' J t) := by
      ext s'
      exact hP_split s' J t
    rw [h_fn]
    exact hd_sum.deriv

  have hConj1 : ∀ (z₀ : ℂ) (r_s r_t : ℝ), 0 < r_s → 0 < r_t →
      DifferentiableOn ℂ (fun q : ℂ × ℂ × ℂ => P.p_act q.1 q.2.1 q.2.2)
        (refSteepPolydisk z₀ r_s r_t) →
      ∀ s_m J_m s_0 t J : ℂ,
        ‖s_m - z₀‖ < r_s / 4 → ‖J_m - 1‖ < 1 / 4 →
        ‖s_0 - z₀‖ < r_s / 4 → ‖J - 1‖ < 1 / 4 → ‖t‖ < r_t →
        refSteepResidual P s_m J_m s_0 t J =
          (deriv (fun J' => P.p_act s_0 J' t) J -
            t * deriv (fun s' => P.p_act s' J t) s_0) -
          deriv (fun J' => P.p_act s_m J' t) J_m := by
    intro z₀ r_s r_t _hr_s _hr_t hP s_m J_m s_0 t J hsm hJm hs0 hJ ht
    rw [hP_deriv_J z₀ r_s r_t hP s_0 J t hs0 hJ ht,
        hP_deriv_s z₀ r_s r_t hP s_0 J t hs0 hJ ht,
        hP_deriv_J z₀ r_s r_t hP s_m J_m t hsm hJm ht]
    dsimp [refSteepResidual, refSteepPerturbG]
    ring

  have h_param_holo : ∀ (a b : ℝ) (W : Set (ℂ × ℂ)) (F : ℝ → ℂ × ℂ → ℂ),
      IsOpen W →
      ContinuousOn (fun q : ℝ × (ℂ × ℂ) => F q.1 q.2) (Set.uIcc a b ×ˢ W) →
      (∀ τ ∈ Set.uIcc a b, DifferentiableOn ℂ (F τ) W) →
      DifferentiableOn ℂ (fun p : ℂ × ℂ => ∫ τ in a..b, F τ p) W := by
    intro a b W F hW hCont hHolo p₀ hp₀
    obtain ⟨ε, hε, hε_sub⟩ := Metric.isOpen_iff.mp hW p₀ hp₀
    let r : ℝ := ε / 3
    have hr : 0 < r := by positivity
    have h2r_lt : 2 * r < ε := by dsimp only [r]; linarith
    have h2r_sub : Metric.closedBall p₀ (2 * r) ⊆ W :=
      (Metric.closedBall_subset_ball h2r_lt).trans hε_sub
    have hK_compact : IsCompact (Set.uIcc a b ×ˢ Metric.closedBall p₀ (2 * r)) :=
      isCompact_uIcc.prod (isCompact_closedBall p₀ (2 * r))
    have hK_sub : Set.uIcc a b ×ˢ Metric.closedBall p₀ (2 * r) ⊆ Set.uIcc a b ×ˢ W :=
      Set.prod_mono Subset.rfl h2r_sub
    obtain ⟨C₀, hC₀⟩ := hK_compact.exists_bound_of_continuousOn (hCont.mono hK_sub)
    let M : ℝ := max C₀ 0
    have hM_bound : ∀ τ ∈ Set.uIcc a b, ∀ q ∈ Metric.closedBall p₀ (2 * r), ‖F τ q‖ ≤ M := by
      intro τ hτ q hq
      exact (hC₀ (τ, q) ⟨hτ, hq⟩).trans (le_max_left _ _)
    let s : Set (ℂ × ℂ) := Metric.ball p₀ r
    have hs_nhds : s ∈ nhds p₀ := Metric.ball_mem_nhds p₀ hr
    have hs_2r : ∀ p ∈ s, ∀ q ∈ Metric.ball p r, q ∈ Metric.closedBall p₀ (2 * r) := by
      intro p hp q hq
      rw [Metric.mem_closedBall]
      have hp' : dist p p₀ < r := hp
      have hq' : dist q p < r := hq
      linarith [dist_triangle q p p₀]
    have hs_sub : s ⊆ W := fun p hp =>
      h2r_sub (Metric.ball_subset_closedBall
        (Metric.mem_ball.mpr (by linarith [Metric.mem_ball.mp hp])))
    have h_slice_cont : ∀ p ∈ W, ContinuousOn (fun τ : ℝ => F τ p) (Set.uIcc a b) := fun p hp =>
      hCont.comp (continuous_id.prodMk continuous_const).continuousOn (fun τ hτ => ⟨hτ, hp⟩)
    let μ₀ : MeasureTheory.Measure ℝ := MeasureTheory.volume.restrict (Set.uIoc a b)
    have hμ_le : μ₀ ≤ MeasureTheory.volume.restrict (Set.uIcc a b) :=
      MeasureTheory.Measure.restrict_mono Set.uIoc_subset_uIcc le_rfl
    have hF_meas : ∀ᶠ p in nhds p₀, MeasureTheory.AEStronglyMeasurable (fun τ => F τ p) μ₀ := by
      filter_upwards [hs_nhds] with p hp
      exact ((h_slice_cont p (hs_sub hp)).aestronglyMeasurable measurableSet_uIcc).mono_measure hμ_le
    have hF_int : IntervalIntegrable (fun τ => F τ p₀) MeasureTheory.volume a b :=
      (h_slice_cont p₀ hp₀).intervalIntegrable
    let δ : ℕ → ℝ := fun n => (1 / ((n : ℝ) + 1)) * (r / 2)
    let h : ℕ → ℂ := fun n => ((δ n : ℝ) : ℂ)
    have hδ_pos : ∀ n : ℕ, 0 < δ n := fun n => by positivity
    have hδ_lt : ∀ n : ℕ, δ n < r := by
      intro n
      have hn : (1 : ℝ) ≤ (n : ℝ) + 1 := by linarith [(Nat.cast_nonneg n : (0 : ℝ) ≤ n)]
      have h1 : 1 / ((n : ℝ) + 1) ≤ 1 := div_le_one_of_le₀ hn (by positivity)
      dsimp only [δ]
      nlinarith
    have hh_ne : ∀ n : ℕ, h n ≠ 0 := fun n => Complex.ofReal_ne_zero.mpr (hδ_pos n).ne'
    have hh_norm : ∀ n : ℕ, ‖h n‖ < r := by
      intro n
      rw [Complex.norm_real, Real.norm_of_nonneg (hδ_pos n).le]
      exact hδ_lt n
    let e₁ : ℂ × ℂ := ((1 : ℂ), (0 : ℂ))
    let e₂ : ℂ × ℂ := ((0 : ℂ), (1 : ℂ))
    have hp1_mem : ∀ n : ℕ, p₀ + h n • e₁ ∈ W := by
      intro n
      apply hs_sub
      rw [Metric.mem_ball, dist_self_add_left, Prod.norm_def]
      simp [e₁, hh_norm n]
    have hp2_mem : ∀ n : ℕ, p₀ + h n • e₂ ∈ W := by
      intro n
      apply hs_sub
      rw [Metric.mem_ball, dist_self_add_left, Prod.norm_def]
      simp [e₂, hh_norm n]
    have hh_tendsto : Filter.Tendsto h Filter.atTop (nhdsWithin (0 : ℂ) {(0 : ℂ)}ᶜ) := by
      rw [tendsto_nhdsWithin_iff]
      refine ⟨?_, Filter.Eventually.of_forall
        (fun n => Set.mem_compl_singleton_iff.mpr (hh_ne n))⟩
      have h0 : Filter.Tendsto δ Filter.atTop (nhds (0 : ℝ)) := by
        simpa [δ] using tendsto_one_div_add_atTop_nhds_zero_nat.mul_const (r / 2)
      simpa [h, Function.comp_def] using (Complex.continuous_ofReal.tendsto 0).comp h0
    let g_seq : ℕ → ℝ → ((ℂ × ℂ) →L[ℂ] ℂ) := fun n τ =>
      ((h n)⁻¹ • (F τ (p₀ + h n • e₁) - F τ p₀)) • ContinuousLinearMap.fst ℂ ℂ ℂ +
      ((h n)⁻¹ • (F τ (p₀ + h n • e₂) - F τ p₀)) • ContinuousLinearMap.snd ℂ ℂ ℂ
    have hg_meas : ∀ n : ℕ, MeasureTheory.AEStronglyMeasurable (g_seq n) μ₀ := by
      intro n
      have hc1 : ContinuousOn
          (fun τ => (h n)⁻¹ • (F τ (p₀ + h n • e₁) - F τ p₀)) (Set.uIcc a b) :=
        (continuousOn_const (c := (h n)⁻¹)).smul
          ((h_slice_cont _ (hp1_mem n)).sub (h_slice_cont p₀ hp₀))
      have hc2 : ContinuousOn
          (fun τ => (h n)⁻¹ • (F τ (p₀ + h n • e₂) - F τ p₀)) (Set.uIcc a b) :=
        (continuousOn_const (c := (h n)⁻¹)).smul
          ((h_slice_cont _ (hp2_mem n)).sub (h_slice_cont p₀ hp₀))
      have hcg : ContinuousOn (g_seq n) (Set.uIcc a b) :=
        (hc1.smul (continuousOn_const (c := ContinuousLinearMap.fst ℂ ℂ ℂ))).add
          (hc2.smul (continuousOn_const (c := ContinuousLinearMap.snd ℂ ℂ ℂ)))
      exact (hcg.aestronglyMeasurable measurableSet_uIcc).mono_measure hμ_le
    have hF'_meas : MeasureTheory.AEStronglyMeasurable (fun τ => fderiv ℂ (F τ) p₀) μ₀ := by
      refine aestronglyMeasurable_of_tendsto_ae Filter.atTop hg_meas ?_
      filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_uIoc] with τ hτ_ioc
      have hτ : τ ∈ Set.uIcc a b := Set.uIoc_subset_uIcc hτ_ioc
      have hFD : HasFDerivAt (F τ) (fderiv ℂ (F τ) p₀) p₀ :=
        ((hHolo τ hτ).differentiableAt (hW.mem_nhds hp₀)).hasFDerivAt
      have ht1 :=
        (hasLineDerivAt_iff_tendsto_slope_zero.mp (hFD.hasLineDerivAt e₁)).comp hh_tendsto
      have ht2 :=
        (hasLineDerivAt_iff_tendsto_slope_zero.mp (hFD.hasLineDerivAt e₂)).comp hh_tendsto
      have ht_sum : Filter.Tendsto (g_seq · τ) Filter.atTop
          (nhds ((fderiv ℂ (F τ) p₀ e₁) • ContinuousLinearMap.fst ℂ ℂ ℂ +
            (fderiv ℂ (F τ) p₀ e₂) • ContinuousLinearMap.snd ℂ ℂ ℂ)) :=
        (ht1.smul_const _).add (ht2.smul_const _)
      have hL_eq : (fderiv ℂ (F τ) p₀ e₁) • ContinuousLinearMap.fst ℂ ℂ ℂ +
          (fderiv ℂ (F τ) p₀ e₂) • ContinuousLinearMap.snd ℂ ℂ ℂ = fderiv ℂ (F τ) p₀ := by
        refine ContinuousLinearMap.ext (fun ⟨v₁, v₂⟩ => ?_)
        have hv : ((v₁, v₂) : ℂ × ℂ) = v₁ • e₁ + v₂ • e₂ := by ext <;> simp [e₁, e₂]
        conv_rhs => rw [hv, (fderiv ℂ (F τ) p₀).map_add, (fderiv ℂ (F τ) p₀).map_smul,
          (fderiv ℂ (F τ) p₀).map_smul]
        simp [mul_comm]
      rwa [hL_eq] at ht_sum
    have h_fderiv_bound : ∀ τ ∈ Set.uIcc a b, ∀ p ∈ s, ‖fderiv ℂ (F τ) p‖ ≤ 2 * M / r := by
      intro τ hτ p hp
      have hball_sub : Metric.ball p r ⊆ W := fun q hq => h2r_sub (hs_2r p hp q hq)
      have hmaps : Set.MapsTo (F τ) (Metric.ball p r) (Metric.closedBall (F τ p) (2 * M)) := by
        intro q hq
        rw [Metric.mem_closedBall, dist_eq_norm]
        have hq2r : q ∈ Metric.closedBall p₀ (2 * r) := hs_2r p hp q hq
        have hp2r : p ∈ Metric.closedBall p₀ (2 * r) := hs_2r p hp p (Metric.mem_ball_self hr)
        calc ‖F τ q - F τ p‖ ≤ ‖F τ q‖ + ‖F τ p‖ := norm_sub_le _ _
          _ ≤ M + M := add_le_add (hM_bound τ hτ q hq2r) (hM_bound τ hτ p hp2r)
          _ = 2 * M := by ring
      exact Complex.norm_fderiv_le_div_of_mapsTo_ball ((hHolo τ hτ).mono hball_sub) hmaps hr
    have h_ae_bound :
        ∀ᵐ τ : ℝ, τ ∈ Set.uIoc a b → ∀ p ∈ s, ‖fderiv ℂ (F τ) p‖ ≤ 2 * M / r :=
      Filter.Eventually.of_forall
        (fun τ hτ p hp => h_fderiv_bound τ (Set.uIoc_subset_uIcc hτ) p hp)
    have h_ae_diff :
        ∀ᵐ τ : ℝ, τ ∈ Set.uIoc a b → ∀ p ∈ s, HasFDerivAt (F τ) (fderiv ℂ (F τ) p) p :=
      Filter.Eventually.of_forall (fun τ hτ p hp =>
        ((hHolo τ (Set.uIoc_subset_uIcc hτ)).differentiableAt
          (hW.mem_nhds (hs_sub hp))).hasFDerivAt)
    have hIntFD := intervalIntegral.hasFDerivAt_integral_of_dominated_of_fderiv_le
      (𝕜 := ℂ) (F := fun p τ => F τ p) (F' := fun p τ => fderiv ℂ (F τ) p)
      (bound := fun _ => 2 * M / r)
      hs_nhds hF_meas hF_int hF'_meas h_ae_bound intervalIntegrable_const h_ae_diff
    exact hIntFD.differentiableAt.differentiableWithinAt

  have h_local_jets : ∀ (B₀ : Set (ℂ × ℂ)) (s_fn J_fn : ℂ × ℂ → ℂ)
      (z₀ : ℂ) (r_s r_t : ℝ),
      IsOpen B₀ →
      0 < r_s → 0 < r_t →
      DifferentiableOn ℂ (fun q : ℂ × ℂ × ℂ => P.p_act q.1 q.2.1 q.2.2)
        (refSteepPolydisk z₀ r_s r_t) →
      DifferentiableOn ℂ s_fn B₀ →
      DifferentiableOn ℂ J_fn B₀ →
      (∀ p ∈ B₀, ‖s_fn p - z₀‖ < r_s / 8 ∧ ‖J_fn p - 1‖ < 1 / 8 ∧ ‖p.2‖ < r_t) →
      DifferentiableOn ℂ (fun p : ℂ × ℂ => refSteepActionDJ P (s_fn p) (J_fn p) p.2) B₀ ∧
      DifferentiableOn ℂ (fun p : ℂ × ℂ => refSteepActionDS P (s_fn p) (J_fn p) p.2) B₀ := by
    intro B₀ s_fn J_fn z₀ r_s r_t hB₀_open hr_s _hr_t hP hs_holo hJ_holo hB₀_bounds
    refine ⟨?_, ?_⟩
    · let R_J : ℝ := 3 / 16
      have hRJ : 0 < R_J := by norm_num
      have h_cmJ_norm : ∀ θ : ℝ, ‖circleMap (1 : ℂ) R_J θ - 1‖ = R_J := by
        intro θ
        rw [circleMap_sub_center]
        simp [circleMap, abs_of_pos hRJ]
      have h_subJ_ne : ∀ θ : ℝ, ∀ p ∈ B₀, (circleMap (1 : ℂ) R_J θ - J_fn p) ^ 2 ≠ 0 := by
        intro θ p hp
        apply pow_ne_zero 2
        rw [sub_ne_zero]
        intro h_eq
        have hd1 : ‖circleMap (1 : ℂ) R_J θ - 1‖ = R_J := h_cmJ_norm θ
        have hd2 : ‖J_fn p - 1‖ < 1 / 8 := (hB₀_bounds p hp).2.1
        rw [h_eq] at hd1
        dsimp only [R_J] at hd1
        linarith
      have h_mapsJ : ∀ θ : ℝ, ∀ p ∈ B₀,
          ‖s_fn p - z₀‖ < r_s / 4 ∧ ‖circleMap (1 : ℂ) R_J θ - 1‖ < 1 / 4 ∧ ‖p.2‖ < r_t := by
        intro θ p hp
        refine ⟨by linarith [(hB₀_bounds p hp).1], ?_, (hB₀_bounds p hp).2.2⟩
        rw [h_cmJ_norm θ]
        dsimp only [R_J]
        norm_num
      let F_J : ℝ → ℂ × ℂ → ℂ := fun θ p =>
        (2 * (Real.pi : ℂ) * Complex.I)⁻¹ *
          (deriv (circleMap (1 : ℂ) R_J) θ *
            (((circleMap (1 : ℂ) R_J θ - J_fn p) ^ 2)⁻¹ *
              refSteepActionA P (s_fn p) (circleMap (1 : ℂ) R_J θ) p.2))
      have hFJ_cont : ContinuousOn (fun q : ℝ × (ℂ × ℂ) => F_J q.1 q.2)
          (Set.uIcc 0 (2 * Real.pi) ×ˢ B₀) := by
        have hc_deriv : Continuous (fun q : ℝ × (ℂ × ℂ) => deriv (circleMap (1 : ℂ) R_J) q.1) := by
          rw [show (fun q : ℝ × (ℂ × ℂ) => deriv (circleMap (1 : ℂ) R_J) q.1) =
              fun q : ℝ × (ℂ × ℂ) => circleMap 0 R_J q.1 * Complex.I by
            ext q; exact deriv_circleMap (1 : ℂ) R_J q.1]
          exact ((continuous_circleMap 0 R_J).comp continuous_fst).mul continuous_const
        have hc_cm : Continuous (fun q : ℝ × (ℂ × ℂ) => circleMap (1 : ℂ) R_J q.1) :=
          (continuous_circleMap (1 : ℂ) R_J).comp continuous_fst
        have hc_s : ContinuousOn (fun q : ℝ × (ℂ × ℂ) => s_fn q.2)
            (Set.uIcc 0 (2 * Real.pi) ×ˢ B₀) :=
          hs_holo.continuousOn.comp continuous_snd.continuousOn (fun _ hq => hq.2)
        have hc_J : ContinuousOn (fun q : ℝ × (ℂ × ℂ) => J_fn q.2)
            (Set.uIcc 0 (2 * Real.pi) ×ˢ B₀) :=
          hJ_holo.continuousOn.comp continuous_snd.continuousOn (fun _ hq => hq.2)
        have hc_t : ContinuousOn (fun q : ℝ × (ℂ × ℂ) => q.2.2)
            (Set.uIcc 0 (2 * Real.pi) ×ˢ B₀) :=
          (continuous_snd.comp continuous_snd).continuousOn
        have hc_act : ContinuousOn
            (fun q : ℝ × (ℂ × ℂ) => refSteepActionA P (s_fn q.2) (circleMap (1 : ℂ) R_J q.1) q.2.2)
            (Set.uIcc 0 (2 * Real.pi) ×ˢ B₀) :=
          h_actA_cont z₀ r_s r_t (Set.uIcc 0 (2 * Real.pi) ×ˢ B₀)
            (fun q => s_fn q.2) (fun q => circleMap (1 : ℂ) R_J q.1) (fun q => q.2.2) hP
            hc_s hc_cm.continuousOn hc_t (fun q hq => h_mapsJ q.1 q.2 hq.2)
        have hc_inv : ContinuousOn
            (fun q : ℝ × (ℂ × ℂ) => ((circleMap (1 : ℂ) R_J q.1 - J_fn q.2) ^ 2)⁻¹)
            (Set.uIcc 0 (2 * Real.pi) ×ˢ B₀) :=
          ContinuousOn.inv₀
            ((hc_cm.continuousOn.sub hc_J).pow 2)
            (fun q hq => h_subJ_ne q.1 q.2 hq.2)
        exact continuousOn_const.mul (hc_deriv.continuousOn.mul (hc_inv.mul hc_act))
      have hFJ_holo : ∀ θ ∈ Set.uIcc 0 (2 * Real.pi), DifferentiableOn ℂ (F_J θ) B₀ := by
        intro θ _
        have hd_inv : DifferentiableOn ℂ
            (fun p : ℂ × ℂ => ((circleMap (1 : ℂ) R_J θ - J_fn p) ^ 2)⁻¹) B₀ :=
          DifferentiableOn.inv
            (((differentiableOn_const (circleMap (1 : ℂ) R_J θ)).sub hJ_holo).pow 2)
            (fun p hp => h_subJ_ne θ p hp)
        have hd_act : DifferentiableOn ℂ
            (fun p : ℂ × ℂ => refSteepActionA P (s_fn p) (circleMap (1 : ℂ) R_J θ) p.2) B₀ :=
          h_actA_comp z₀ r_s r_t B₀ s_fn (fun _ => circleMap (1 : ℂ) R_J θ) Prod.snd hP
            hs_holo (differentiableOn_const _) differentiable_snd.differentiableOn
            (fun p hp => h_mapsJ θ p hp)
        exact (differentiableOn_const _).mul ((differentiableOn_const _).mul (hd_inv.mul hd_act))
      have hIntJ_holo : DifferentiableOn ℂ
          (fun p : ℂ × ℂ => ∫ θ in (0 : ℝ)..(2 * Real.pi), F_J θ p) B₀ :=
        h_param_holo 0 (2 * Real.pi) B₀ F_J hB₀_open hFJ_cont hFJ_holo
      refine hIntJ_holo.congr (fun p hp => ?_)
      have hs_p : ‖s_fn p - z₀‖ < r_s / 4 := by linarith [(hB₀_bounds p hp).1]
      have hJ_in_RJ : J_fn p ∈ Metric.ball (1 : ℂ) R_J := by
        rw [Metric.mem_ball, dist_eq_norm]
        dsimp only [R_J]
        linarith [(hB₀_bounds p hp).2.1]
      have hcl_subJ : Metric.closedBall (1 : ℂ) R_J ⊆ Metric.ball (1 : ℂ) (1 / 4) :=
        Metric.closedBall_subset_ball (by dsimp only [R_J]; norm_num)
      have hCauchy := (Complex.two_pi_I_inv_smul_circleIntegral_sub_sq_inv_smul_of_differentiable
        Metric.isOpen_ball hcl_subJ
        (hDiffA_J_on z₀ r_s r_t hP (s_fn p) p.2 hs_p (hB₀_bounds p hp).2.2)
        hJ_in_RJ).symm
      change deriv (fun J' : ℂ => refSteepActionA P (s_fn p) J' p.2) (J_fn p) =
        ∫ θ in (0 : ℝ)..(2 * Real.pi), F_J θ p
      rw [hCauchy, circleIntegral_def_Icc, MeasureTheory.integral_Icc_eq_integral_Ioc,
        ← intervalIntegral.integral_of_le Real.two_pi_pos.le, ← intervalIntegral.integral_smul]
      refine intervalIntegral.integral_congr (fun θ _ => ?_)
      simp [F_J, smul_eq_mul, mul_assoc]
    · let R_s : ℝ := (3 / 16 : ℝ) * r_s
      have hRs : 0 < R_s := by positivity
      have h_cmS_norm : ∀ θ : ℝ, ‖circleMap z₀ R_s θ - z₀‖ = R_s := by
        intro θ
        rw [circleMap_sub_center]
        simp [circleMap, abs_of_pos hRs]
      have h_subS_ne : ∀ θ : ℝ, ∀ p ∈ B₀, (circleMap z₀ R_s θ - s_fn p) ^ 2 ≠ 0 := by
        intro θ p hp
        apply pow_ne_zero 2
        rw [sub_ne_zero]
        intro h_eq
        have hd1 : ‖circleMap z₀ R_s θ - z₀‖ = R_s := h_cmS_norm θ
        have hd2 : ‖s_fn p - z₀‖ < r_s / 8 := (hB₀_bounds p hp).1
        rw [h_eq] at hd1
        dsimp only [R_s] at hd1
        linarith
      have h_mapsS : ∀ θ : ℝ, ∀ p ∈ B₀,
          ‖circleMap z₀ R_s θ - z₀‖ < r_s / 4 ∧ ‖J_fn p - 1‖ < 1 / 4 ∧ ‖p.2‖ < r_t := by
        intro θ p hp
        refine ⟨?_, by linarith [(hB₀_bounds p hp).2.1], (hB₀_bounds p hp).2.2⟩
        rw [h_cmS_norm θ]
        dsimp only [R_s]
        linarith
      let F_s : ℝ → ℂ × ℂ → ℂ := fun θ p =>
        (2 * (Real.pi : ℂ) * Complex.I)⁻¹ *
          (deriv (circleMap z₀ R_s) θ *
            (((circleMap z₀ R_s θ - s_fn p) ^ 2)⁻¹ *
              refSteepActionA P (circleMap z₀ R_s θ) (J_fn p) p.2))
      have hFS_cont : ContinuousOn (fun q : ℝ × (ℂ × ℂ) => F_s q.1 q.2)
          (Set.uIcc 0 (2 * Real.pi) ×ˢ B₀) := by
        have hc_deriv : Continuous (fun q : ℝ × (ℂ × ℂ) => deriv (circleMap z₀ R_s) q.1) := by
          rw [show (fun q : ℝ × (ℂ × ℂ) => deriv (circleMap z₀ R_s) q.1) =
              fun q : ℝ × (ℂ × ℂ) => circleMap 0 R_s q.1 * Complex.I by
            ext q; exact deriv_circleMap z₀ R_s q.1]
          exact ((continuous_circleMap 0 R_s).comp continuous_fst).mul continuous_const
        have hc_cm : Continuous (fun q : ℝ × (ℂ × ℂ) => circleMap z₀ R_s q.1) :=
          (continuous_circleMap z₀ R_s).comp continuous_fst
        have hc_s : ContinuousOn (fun q : ℝ × (ℂ × ℂ) => s_fn q.2)
            (Set.uIcc 0 (2 * Real.pi) ×ˢ B₀) :=
          hs_holo.continuousOn.comp continuous_snd.continuousOn (fun _ hq => hq.2)
        have hc_J : ContinuousOn (fun q : ℝ × (ℂ × ℂ) => J_fn q.2)
            (Set.uIcc 0 (2 * Real.pi) ×ˢ B₀) :=
          hJ_holo.continuousOn.comp continuous_snd.continuousOn (fun _ hq => hq.2)
        have hc_t : ContinuousOn (fun q : ℝ × (ℂ × ℂ) => q.2.2)
            (Set.uIcc 0 (2 * Real.pi) ×ˢ B₀) :=
          (continuous_snd.comp continuous_snd).continuousOn
        have hc_act : ContinuousOn
            (fun q : ℝ × (ℂ × ℂ) => refSteepActionA P (circleMap z₀ R_s q.1) (J_fn q.2) q.2.2)
            (Set.uIcc 0 (2 * Real.pi) ×ˢ B₀) :=
          h_actA_cont z₀ r_s r_t (Set.uIcc 0 (2 * Real.pi) ×ˢ B₀)
            (fun q => circleMap z₀ R_s q.1) (fun q => J_fn q.2) (fun q => q.2.2) hP
            hc_cm.continuousOn hc_J hc_t (fun q hq => h_mapsS q.1 q.2 hq.2)
        have hc_inv : ContinuousOn
            (fun q : ℝ × (ℂ × ℂ) => ((circleMap z₀ R_s q.1 - s_fn q.2) ^ 2)⁻¹)
            (Set.uIcc 0 (2 * Real.pi) ×ˢ B₀) :=
          ContinuousOn.inv₀
            ((hc_cm.continuousOn.sub hc_s).pow 2)
            (fun q hq => h_subS_ne q.1 q.2 hq.2)
        exact continuousOn_const.mul (hc_deriv.continuousOn.mul (hc_inv.mul hc_act))
      have hFS_holo : ∀ θ ∈ Set.uIcc 0 (2 * Real.pi), DifferentiableOn ℂ (F_s θ) B₀ := by
        intro θ _
        have hd_inv : DifferentiableOn ℂ
            (fun p : ℂ × ℂ => ((circleMap z₀ R_s θ - s_fn p) ^ 2)⁻¹) B₀ :=
          DifferentiableOn.inv
            (((differentiableOn_const (circleMap z₀ R_s θ)).sub hs_holo).pow 2)
            (fun p hp => h_subS_ne θ p hp)
        have hd_act : DifferentiableOn ℂ
            (fun p : ℂ × ℂ => refSteepActionA P (circleMap z₀ R_s θ) (J_fn p) p.2) B₀ :=
          h_actA_comp z₀ r_s r_t B₀ (fun _ => circleMap z₀ R_s θ) J_fn Prod.snd hP
            (differentiableOn_const _) hJ_holo differentiable_snd.differentiableOn
            (fun p hp => h_mapsS θ p hp)
        exact (differentiableOn_const _).mul ((differentiableOn_const _).mul (hd_inv.mul hd_act))
      have hIntS_holo : DifferentiableOn ℂ
          (fun p : ℂ × ℂ => ∫ θ in (0 : ℝ)..(2 * Real.pi), F_s θ p) B₀ :=
        h_param_holo 0 (2 * Real.pi) B₀ F_s hB₀_open hFS_cont hFS_holo
      refine hIntS_holo.congr (fun p hp => ?_)
      have hJ_p : ‖J_fn p - 1‖ < 1 / 4 := by linarith [(hB₀_bounds p hp).2.1]
      have hs_in_Rs : s_fn p ∈ Metric.ball z₀ R_s := by
        rw [Metric.mem_ball, dist_eq_norm]
        dsimp only [R_s]
        linarith [(hB₀_bounds p hp).1]
      have hcl_subS : Metric.closedBall z₀ R_s ⊆ Metric.ball z₀ (r_s / 4) :=
        Metric.closedBall_subset_ball (by dsimp only [R_s]; linarith)
      have hCauchy := (Complex.two_pi_I_inv_smul_circleIntegral_sub_sq_inv_smul_of_differentiable
        Metric.isOpen_ball hcl_subS
        (hDiffA_s_on z₀ r_s r_t hP (J_fn p) p.2 hJ_p (hB₀_bounds p hp).2.2)
        hs_in_Rs).symm
      change deriv (fun s' : ℂ => refSteepActionA P s' (J_fn p) p.2) (s_fn p) =
        ∫ θ in (0 : ℝ)..(2 * Real.pi), F_s θ p
      rw [hCauchy, circleIntegral_def_Icc, MeasureTheory.integral_Icc_eq_integral_Ioc,
        ← intervalIntegral.integral_of_le Real.two_pi_pos.le, ← intervalIntegral.integral_smul]
      refine intervalIntegral.integral_congr (fun θ _ => ?_)
      simp [F_s, smul_eq_mul, mul_assoc]

  have hConj3 : ∀ (U : Set (ℂ × ℂ)) (s_fn J_fn : ℂ × ℂ → ℂ),
      IsOpen U →
      DifferentiableOn ℂ s_fn U →
      DifferentiableOn ℂ J_fn U →
      (∀ p₀ ∈ U, ∃ (z₀ : ℂ) (r_s r_t : ℝ), 0 < r_s ∧ 0 < r_t ∧
        DifferentiableOn ℂ (fun q : ℂ × ℂ × ℂ => P.p_act q.1 q.2.1 q.2.2)
          (refSteepPolydisk z₀ r_s r_t) ∧
        ‖s_fn p₀ - z₀‖ < r_s / 8 ∧ ‖J_fn p₀ - 1‖ < 1 / 8 ∧ ‖p₀.2‖ < r_t) →
      DifferentiableOn ℂ (fun p : ℂ × ℂ => refSteepActionDJ P (s_fn p) (J_fn p) p.2) U ∧
      DifferentiableOn ℂ (fun p : ℂ × ℂ => refSteepActionDS P (s_fn p) (J_fn p) p.2) U := by
    intro U s_fn J_fn hU_open hs_holo hJ_holo hLoc
    have h_both : ∀ p₀ ∈ U,
        DifferentiableWithinAt ℂ (fun p : ℂ × ℂ => refSteepActionDJ P (s_fn p) (J_fn p) p.2) U p₀ ∧
        DifferentiableWithinAt ℂ (fun p : ℂ × ℂ => refSteepActionDS P (s_fn p) (J_fn p) p.2) U p₀ := by
      intro p₀ hp₀
      obtain ⟨z₀, r_s, r_t, hr_s, hr_t, hP, hs₀, hJ₀, ht₀⟩ := hLoc p₀ hp₀
      let B₀ : Set (ℂ × ℂ) :=
        (U ∩ s_fn ⁻¹' Metric.ball z₀ (r_s / 8)) ∩
          ((U ∩ J_fn ⁻¹' Metric.ball (1 : ℂ) (1 / 8)) ∩
            Prod.snd ⁻¹' Metric.ball (0 : ℂ) r_t)
      have hB₀_open : IsOpen B₀ :=
        (hs_holo.continuousOn.isOpen_inter_preimage hU_open Metric.isOpen_ball).inter
          ((hJ_holo.continuousOn.isOpen_inter_preimage hU_open Metric.isOpen_ball).inter
            (Metric.isOpen_ball.preimage continuous_snd))
      have hB₀_sub : B₀ ⊆ U := fun _ hp => hp.1.1
      have hp₀_B₀ : p₀ ∈ B₀ :=
        ⟨⟨hp₀, by simpa [Metric.mem_ball, dist_eq_norm] using hs₀⟩,
         ⟨hp₀, by simpa [Metric.mem_ball, dist_eq_norm] using hJ₀⟩,
         by simpa [Metric.mem_ball, dist_eq_norm] using ht₀⟩
      have hB₀_bounds : ∀ p ∈ B₀,
          ‖s_fn p - z₀‖ < r_s / 8 ∧ ‖J_fn p - 1‖ < 1 / 8 ∧ ‖p.2‖ < r_t := by
        intro p hp
        exact ⟨by simpa [Metric.mem_ball, dist_eq_norm] using hp.1.2,
               by simpa [Metric.mem_ball, dist_eq_norm] using hp.2.1.2,
               by simpa [Metric.mem_ball, dist_eq_norm] using hp.2.2⟩
      obtain ⟨hDJ_B₀, hDS_B₀⟩ :=
        h_local_jets B₀ s_fn J_fn z₀ r_s r_t hB₀_open hr_s hr_t hP
          (hs_holo.mono hB₀_sub) (hJ_holo.mono hB₀_sub) hB₀_bounds
      exact ⟨(hDJ_B₀.differentiableAt (hB₀_open.mem_nhds hp₀_B₀)).differentiableWithinAt,
             (hDS_B₀.differentiableAt (hB₀_open.mem_nhds hp₀_B₀)).differentiableWithinAt⟩
    exact ⟨fun p₀ hp₀ => (h_both p₀ hp₀).1, fun p₀ hp₀ => (h_both p₀ hp₀).2⟩

  have hDiffG_J : ∀ (z₀ : ℂ) (r_s r_t : ℝ), 0 < r_s → 0 < r_t →
      DifferentiableOn ℂ (fun q : ℂ × ℂ × ℂ => P.p_act q.1 q.2.1 q.2.2)
        (refSteepPolydisk z₀ r_s r_t) →
      ∀ s_0 t J : ℂ, ‖s_0 - z₀‖ < r_s / 8 → ‖J - 1‖ < 1 / 8 → ‖t‖ < r_t →
      DifferentiableAt ℂ (refSteepPerturbG P s_0 t) J := by
    intro z₀ r_s r_t hr_s hr_t hP s_0 t J hs₀ hJ ht
    let U_J : Set (ℂ × ℂ) := Metric.ball (1 : ℂ) (1 / 8) ×ˢ Metric.ball (0 : ℂ) r_t
    have hUJ_open : IsOpen U_J := Metric.isOpen_ball.prod Metric.isOpen_ball
    obtain ⟨hDJ_UJ, hDS_UJ⟩ :=
      h_local_jets U_J (fun _ => s_0) Prod.fst z₀ r_s r_t hUJ_open hr_s hr_t hP
        (differentiableOn_const s_0) differentiable_fst.differentiableOn
        (fun p hp =>
          ⟨hs₀,
           by simpa [Metric.mem_ball, dist_eq_norm] using hp.1,
           by simpa [Metric.mem_ball, dist_eq_norm] using hp.2⟩)
    let ι_J : ℂ → ℂ × ℂ := fun J' => (J', t)
    have hι_diff : Differentiable ℂ ι_J :=
      differentiable_id.prodMk (differentiable_const t)
    have hι_maps : Set.MapsTo ι_J (Metric.ball (1 : ℂ) (1 / 8)) U_J :=
      fun _ hJ' => ⟨hJ', by simpa [Metric.mem_ball, dist_eq_norm] using ht⟩
    have hJ_nhds : Metric.ball (1 : ℂ) (1 / 8) ∈ nhds J :=
      Metric.isOpen_ball.mem_nhds (by simpa [Metric.mem_ball, dist_eq_norm] using hJ)
    have hDJ_at : DifferentiableAt ℂ (fun J' : ℂ => refSteepActionDJ P s_0 J' t) J :=
      (hDJ_UJ.comp hι_diff.differentiableOn hι_maps).differentiableAt hJ_nhds
    have hDS_at : DifferentiableAt ℂ (fun J' : ℂ => refSteepActionDS P s_0 J' t) J :=
      (hDS_UJ.comp hι_diff.differentiableOn hι_maps).differentiableAt hJ_nhds
    exact hDJ_at.sub (hDS_at.const_mul t)

  have hDiffDJ_s : ∀ (z₀ : ℂ) (r_s r_t : ℝ), 0 < r_s → 0 < r_t →
      DifferentiableOn ℂ (fun q : ℂ × ℂ × ℂ => P.p_act q.1 q.2.1 q.2.2)
        (refSteepPolydisk z₀ r_s r_t) →
      ∀ s J t : ℂ, ‖s - z₀‖ < r_s / 8 → ‖J - 1‖ < 1 / 8 → ‖t‖ < r_t →
      DifferentiableAt ℂ (fun s' : ℂ => refSteepActionDJ P s' J t) s := by
    intro z₀ r_s r_t hr_s hr_t hP s J t hs hJ ht
    let U_s : Set (ℂ × ℂ) := Metric.ball z₀ (r_s / 8) ×ˢ Metric.ball (0 : ℂ) r_t
    have hUs_open : IsOpen U_s := Metric.isOpen_ball.prod Metric.isOpen_ball
    obtain ⟨hDJ_Us, _⟩ :=
      h_local_jets U_s Prod.fst (fun _ => J) z₀ r_s r_t hUs_open hr_s hr_t hP
        differentiable_fst.differentiableOn (differentiableOn_const J)
        (fun p hp =>
          ⟨by simpa [Metric.mem_ball, dist_eq_norm] using hp.1,
           hJ,
           by simpa [Metric.mem_ball, dist_eq_norm] using hp.2⟩)
    let ι_s : ℂ → ℂ × ℂ := fun s' => (s', t)
    have hι_diff : Differentiable ℂ ι_s :=
      differentiable_id.prodMk (differentiable_const t)
    have hι_maps : Set.MapsTo ι_s (Metric.ball z₀ (r_s / 8)) U_s :=
      fun _ hs' => ⟨hs', by simpa [Metric.mem_ball, dist_eq_norm] using ht⟩
    have hs_nhds : Metric.ball z₀ (r_s / 8) ∈ nhds s :=
      Metric.isOpen_ball.mem_nhds (by simpa [Metric.mem_ball, dist_eq_norm] using hs)
    exact (hDJ_Us.comp hι_diff.differentiableOn hι_maps).differentiableAt hs_nhds

  have hConj2 : ∀ (z₀ : ℂ) (r_s r_t : ℝ), 0 < r_s → 0 < r_t →
      DifferentiableOn ℂ (fun q : ℂ × ℂ × ℂ => P.p_act q.1 q.2.1 q.2.2)
        (refSteepPolydisk z₀ r_s r_t) →
      ∀ s_m J_m s_0 t J : ℂ,
        ‖s_0 - z₀‖ < r_s / 8 → ‖J - 1‖ < 1 / 8 → ‖t‖ < r_t →
        HasDerivAt (fun J' => refSteepResidual P s_m J_m s_0 t J')
          ((1 / 4 : ℂ) * J + deriv (refSteepPerturbG P s_0 t) J) J := by
    intro z₀ r_s r_t hr_s hr_t hP s_m J_m s_0 t J hs₀ hJ ht
    have hd_quad : HasDerivAt (fun J' : ℂ => (1 / 8 : ℂ) * (J' ^ 2 - J_m ^ 2))
        ((1 / 4 : ℂ) * J) J := by
      have h1 := ((hasDerivAt_pow 2 J).sub_const (J_m ^ 2)).const_mul (1 / 8 : ℂ)
      convert h1 using 1
      ring
    have hd_G : HasDerivAt (refSteepPerturbG P s_0 t)
        (deriv (refSteepPerturbG P s_0 t) J) J :=
      (hDiffG_J z₀ r_s r_t hr_s hr_t hP s_0 t J hs₀ hJ ht).hasDerivAt
    simpa [refSteepResidual] using
      (hd_quad.add hd_G).sub_const (refSteepActionDJ P s_m J_m t)

  have h_cauchy_closed : ∀ (f : ℂ → ℂ) (c : ℂ) (R C : ℝ),
      0 < R →
      (∀ z ∈ Metric.closedBall c R, DifferentiableAt ℂ f z) →
      (∀ z ∈ Metric.closedBall c R, ‖f z‖ ≤ C) →
      ‖deriv f c‖ ≤ C / R := by
    intro f c R C hR hf_diff hf_bnd
    have hf_on : DifferentiableOn ℂ f (Metric.closedBall c R) :=
      fun z hz => (hf_diff z hz).differentiableWithinAt
    have hf_dc : DiffContOnCl ℂ f (Metric.ball c R) :=
      hf_on.diffContOnCl_ball Subset.rfl
    exact Complex.norm_deriv_le_of_forall_mem_sphere_norm_le hR hf_dc
      (fun z hz => hf_bnd z (Metric.sphere_subset_closedBall hz))

  have hConj4 : ∀ (z₀ : ℂ) (r_s r_t ρ_s M_a : ℝ) (s_m s_0 J_m t : ℂ),
      0 < r_s → 0 < r_t → 0 < ρ_s → 0 ≤ M_a →
      DifferentiableOn ℂ (fun q : ℂ × ℂ × ℂ => P.p_act q.1 q.2.1 q.2.2)
        (refSteepPolydisk z₀ r_s r_t) →
      ‖J_m - 1‖ ≤ 1 / 32 → ‖t‖ < r_t →
      (∀ θ ∈ Set.Icc (0 : ℝ) 1,
        ∀ s' ∈ Metric.closedBall ((1 - (θ : ℂ)) * s_m + (θ : ℂ) * s_0) ρ_s,
          ‖s' - z₀‖ < r_s / 8 ∧
          ∀ J' ∈ Metric.closedBall (1 : ℂ) (3 / 32),
            ‖refSteepActionA P s' J' t‖ ≤ M_a) →
      (∀ J ∈ Metric.closedBall J_m (1 / 32),
        ‖deriv (refSteepPerturbG P s_0 t) J‖ ≤
          4096 * M_a + 64 * ‖t‖ * M_a / ρ_s) ∧
      ‖refSteepActionDS P s_0 J_m t‖ ≤ M_a / ρ_s ∧
      ‖refSteepActionDJ P s_0 J_m t - refSteepActionDJ P s_m J_m t‖ ≤
        (32 * M_a / ρ_s) * ‖s_0 - s_m‖ := by
    intro z₀ r_s r_t ρ_s M_a s_m s_0 J_m t hr_s hr_t hρ_s _hM_a hP hJm ht hBound
    have hJm_in3 : J_m ∈ Metric.closedBall (1 : ℂ) (3 / 32) := by
      rw [Metric.mem_closedBall, dist_eq_norm]
      linarith
    have hJm_lt8 : ‖J_m - 1‖ < 1 / 8 := by linarith
    have hBound0 : ∀ s' ∈ Metric.closedBall s_0 ρ_s,
        ‖s' - z₀‖ < r_s / 8 ∧
        ∀ J' ∈ Metric.closedBall (1 : ℂ) (3 / 32),
          ‖refSteepActionA P s' J' t‖ ≤ M_a := by
      intro s' hs'
      have hθ1 : (1 : ℝ) ∈ Set.Icc (0 : ℝ) 1 := ⟨zero_le_one, le_rfl⟩
      have hs'_1 :
          s' ∈ Metric.closedBall ((1 - ((1 : ℝ) : ℂ)) * s_m + ((1 : ℝ) : ℂ) * s_0) ρ_s := by
        simpa using hs'
      exact hBound 1 hθ1 s' hs'_1
    have hs0_self : s_0 ∈ Metric.closedBall s_0 ρ_s := Metric.mem_closedBall_self hρ_s.le
    have hs0_lt8 : ‖s_0 - z₀‖ < r_s / 8 := (hBound0 s_0 hs0_self).1
    have hs0_lt4 : ‖s_0 - z₀‖ < r_s / 4 := by linarith
    have hDS_s0 : ∀ J₁ ∈ Metric.closedBall (1 : ℂ) (3 / 32),
        ‖refSteepActionDS P s_0 J₁ t‖ ≤ M_a / ρ_s := by
      intro J₁ hJ₁
      have hJ₁_lt4 : ‖J₁ - 1‖ < 1 / 4 := by
        have : ‖J₁ - 1‖ ≤ 3 / 32 := by simpa [Metric.mem_closedBall, dist_eq_norm] using hJ₁
        linarith
      exact h_cauchy_closed (fun s' => refSteepActionA P s' J₁ t) s_0 ρ_s M_a hρ_s
        (fun s' hs' =>
          hDiffA_s z₀ r_s r_t hP s' J₁ t (by linarith [(hBound0 s' hs').1]) hJ₁_lt4 ht)
        (fun s' hs' => (hBound0 s' hs').2 J₁ hJ₁)
    refine ⟨?_, hDS_s0 J_m hJm_in3, ?_⟩
    · intro J hJ
      have hJ_dist1 : ‖J - 1‖ ≤ 1 / 16 := by
        have hJ_Jm : ‖J - J_m‖ ≤ 1 / 32 := by
          simpa [Metric.mem_closedBall, dist_eq_norm] using hJ
        calc ‖J - 1‖ = ‖(J - J_m) + (J_m - 1)‖ := by ring_nf
          _ ≤ ‖J - J_m‖ + ‖J_m - 1‖ := norm_add_le _ _
          _ ≤ 1 / 16 := by linarith
      let r_J : ℝ := 1 / 64
      have hr_J : 0 < r_J := by norm_num
      have hJ1_dist1 : ∀ J₁ ∈ Metric.closedBall J r_J, ‖J₁ - 1‖ ≤ 5 / 64 := by
        intro J₁ hJ₁
        have hJ₁_J : ‖J₁ - J‖ ≤ r_J := by
          simpa [Metric.mem_closedBall, dist_eq_norm] using hJ₁
        calc ‖J₁ - 1‖ = ‖(J₁ - J) + (J - 1)‖ := by ring_nf
          _ ≤ ‖J₁ - J‖ + ‖J - 1‖ := norm_add_le _ _
          _ ≤ 5 / 64 := by dsimp only [r_J] at hJ₁_J; linarith
      have hJ1_in3 : ∀ J₁ ∈ Metric.closedBall J r_J,
          J₁ ∈ Metric.closedBall (1 : ℂ) (3 / 32) := by
        intro J₁ hJ₁
        rw [Metric.mem_closedBall, dist_eq_norm]
        linarith [hJ1_dist1 J₁ hJ₁]
      have hJ1_lt8 : ∀ J₁ ∈ Metric.closedBall J r_J, ‖J₁ - 1‖ < 1 / 8 := by
        intro J₁ hJ₁
        linarith [hJ1_dist1 J₁ hJ₁]
      have hG_bnd : ∀ J₁ ∈ Metric.closedBall J r_J,
          ‖refSteepPerturbG P s_0 t J₁‖ ≤ M_a / r_J + ‖t‖ * (M_a / ρ_s) := by
        intro J₁ hJ₁
        have hz_in3 : ∀ z ∈ Metric.closedBall J₁ r_J,
            z ∈ Metric.closedBall (1 : ℂ) (3 / 32) := by
          intro z hz
          have hz_J₁ : ‖z - J₁‖ ≤ r_J := by
            simpa [Metric.mem_closedBall, dist_eq_norm] using hz
          have hJ₁_1 : ‖J₁ - 1‖ ≤ 5 / 64 := hJ1_dist1 J₁ hJ₁
          rw [Metric.mem_closedBall, dist_eq_norm]
          calc ‖z - 1‖ = ‖(z - J₁) + (J₁ - 1)‖ := by ring_nf
            _ ≤ ‖z - J₁‖ + ‖J₁ - 1‖ := norm_add_le _ _
            _ ≤ 3 / 32 := by dsimp only [r_J] at hz_J₁; linarith
        have hDJ_J1 : ‖refSteepActionDJ P s_0 J₁ t‖ ≤ M_a / r_J :=
          h_cauchy_closed (fun z => refSteepActionA P s_0 z t) J₁ r_J M_a hr_J
            (fun z hz => by
              have hz3 : ‖z - 1‖ ≤ 3 / 32 := by
                simpa [Metric.mem_closedBall, dist_eq_norm] using hz_in3 z hz
              exact hDiffA_J z₀ r_s r_t hP s_0 z t hs0_lt4 (by linarith) ht)
            (fun z hz => (hBound0 s_0 hs0_self).2 z (hz_in3 z hz))
        have hDS_J1 : ‖refSteepActionDS P s_0 J₁ t‖ ≤ M_a / ρ_s :=
          hDS_s0 J₁ (hJ1_in3 J₁ hJ₁)
        calc ‖refSteepPerturbG P s_0 t J₁‖
            = ‖refSteepActionDJ P s_0 J₁ t - t * refSteepActionDS P s_0 J₁ t‖ := rfl
          _ ≤ ‖refSteepActionDJ P s_0 J₁ t‖ + ‖t * refSteepActionDS P s_0 J₁ t‖ :=
              norm_sub_le _ _
          _ = ‖refSteepActionDJ P s_0 J₁ t‖ + ‖t‖ * ‖refSteepActionDS P s_0 J₁ t‖ := by
              rw [norm_mul]
          _ ≤ M_a / r_J + ‖t‖ * (M_a / ρ_s) :=
              add_le_add hDJ_J1 (mul_le_mul_of_nonneg_left hDS_J1 (norm_nonneg t))
      have h_raw : ‖deriv (refSteepPerturbG P s_0 t) J‖ ≤
          (M_a / r_J + ‖t‖ * (M_a / ρ_s)) / r_J :=
        h_cauchy_closed (refSteepPerturbG P s_0 t) J r_J
          (M_a / r_J + ‖t‖ * (M_a / ρ_s)) hr_J
          (fun J₁ hJ₁ => hDiffG_J z₀ r_s r_t hr_s hr_t hP s_0 t J₁ hs0_lt8 (hJ1_lt8 J₁ hJ₁) ht)
          hG_bnd
      have h_alg : (M_a / r_J + ‖t‖ * (M_a / ρ_s)) / r_J =
          4096 * M_a + 64 * ‖t‖ * M_a / ρ_s := by
        dsimp only [r_J]
        field_simp [hρ_s.ne']
        ring
      rwa [h_alg] at h_raw
    · let h_DJ : ℂ → ℂ := fun s' => refSteepActionDJ P s' J_m t
      have hz_Jm_in3 : ∀ z ∈ Metric.closedBall J_m (1 / 32),
          z ∈ Metric.closedBall (1 : ℂ) (3 / 32) := by
        intro z hz
        rw [Metric.mem_closedBall, dist_eq_norm] at hz ⊢
        calc ‖z - 1‖ = ‖(z - J_m) + (J_m - 1)‖ := by ring_nf
          _ ≤ ‖z - J_m‖ + ‖J_m - 1‖ := norm_add_le _ _
          _ ≤ 3 / 32 := by linarith
      have h_seg_data : ∀ σ ∈ segment ℝ s_m s_0,
          DifferentiableAt ℂ h_DJ σ ∧ ‖deriv h_DJ σ‖ ≤ 32 * M_a / ρ_s := by
        intro σ hσ
        rw [segment_eq_image ℝ s_m s_0] at hσ
        rcases hσ with ⟨θ, hθ, rfl⟩
        set c_θ : ℂ := (1 - θ) • s_m + θ • s_0
        have hc_eq : c_θ = (1 - (θ : ℂ)) * s_m + (θ : ℂ) * s_0 := by
          simp [c_θ, Complex.real_smul]
        have hBθ : ∀ s' ∈ Metric.closedBall c_θ ρ_s,
            ‖s' - z₀‖ < r_s / 8 ∧
            ∀ J' ∈ Metric.closedBall (1 : ℂ) (3 / 32),
              ‖refSteepActionA P s' J' t‖ ≤ M_a := by
          intro s' hs'
          rw [hc_eq] at hs'
          exact hBound θ hθ s' hs'
        have hc_self : c_θ ∈ Metric.closedBall c_θ ρ_s := Metric.mem_closedBall_self hρ_s.le
        have h_diff_σ : DifferentiableAt ℂ h_DJ c_θ :=
          hDiffDJ_s z₀ r_s r_t hr_s hr_t hP c_θ J_m t (hBθ c_θ hc_self).1 hJm_lt8 ht
        have h_DJ_ball : ∀ s' ∈ Metric.closedBall c_θ ρ_s, ‖h_DJ s'‖ ≤ 32 * M_a := by
          intro s' hs'
          have h_raw_s :=
            h_cauchy_closed (fun z => refSteepActionA P s' z t) J_m (1 / 32) M_a (by norm_num)
              (fun z hz => by
                have hz3 : ‖z - 1‖ ≤ 3 / 32 := by
                  simpa [Metric.mem_closedBall, dist_eq_norm] using hz_Jm_in3 z hz
                exact hDiffA_J z₀ r_s r_t hP s' z t (by linarith [(hBθ s' hs').1])
                  (by linarith) ht)
              (fun z hz => (hBθ s' hs').2 z (hz_Jm_in3 z hz))
          have h32 : M_a / (1 / 32 : ℝ) = 32 * M_a := by ring
          rwa [h32] at h_raw_s
        have h_deriv_σ : ‖deriv h_DJ c_θ‖ ≤ 32 * M_a / ρ_s :=
          h_cauchy_closed h_DJ c_θ ρ_s (32 * M_a) hρ_s
            (fun s' hs' => hDiffDJ_s z₀ r_s r_t hr_s hr_t hP s' J_m t (hBθ s' hs').1 hJm_lt8 ht)
            h_DJ_ball
        exact ⟨h_diff_σ, h_deriv_σ⟩
      exact Convex.norm_image_sub_le_of_norm_deriv_le
        (fun σ hσ => (h_seg_data σ hσ).1)
        (fun σ hσ => (h_seg_data σ hσ).2)
        (convex_segment s_m s_0)
        (left_mem_segment ℝ s_m s_0)
        (right_mem_segment ℝ s_m s_0)

  exact ⟨hConj1, hConj2, hConj3, hConj4⟩

theorem ref_steep_holomorphic_step_solver (X : ExpStripData) (P : ChordActionPackage X)
    (hJets : RefSteepJetProp X P) :
    RefSteepSolverProp X P :=
by
  have h_core : ∀ s_m s_0 t : ℂ,
      IsRefSteepContractivePt X P s_m s_0 t →
      let J_m := (s_0 - s_m) / t
      let J_p := refSteepSolJ P s_m s_0 t
      (∀ n : ℕ, refSteepIterJ P s_m s_0 t n ∈ Metric.closedBall J_m (1 / 32)) ∧
      (∀ n : ℕ, ‖refSteepIterJ P s_m s_0 t n - refSteepIterJ P s_m s_0 t (n + 1)‖ ≤
        (1 / 64 : ℝ) * (1 / 2 : ℝ) ^ n) ∧
      Filter.Tendsto (refSteepIterJ P s_m s_0 t) Filter.atTop (nhds J_p) ∧
      ‖J_p - J_m‖ ≤ 8 * ‖refSteepResidual P s_m J_m s_0 t J_m‖ ∧
      deriv (fun J' => P.p_act s_0 J' t) J_p -
        t * deriv (fun s' => P.p_act s' J_p t) s_0 =
        deriv (fun J' => P.p_act s_m J' t) J_m ∧
      (∀ J' ∈ Metric.closedBall J_m (1 / 32),
        deriv (fun J'' => P.p_act s_0 J'' t) J' -
          t * deriv (fun s' => P.p_act s' J' t) s_0 =
          deriv (fun J'' => P.p_act s_m J'' t) J_m →
        J' = J_p) := by
    intro s_m s_0 t hPt
    rcases hPt with
      ⟨_, hJm_one, ⟨z₀, r_s, r_t, hrs_pos, hrt_pos, hHolo, hsm_z₀, hs0_z₀, ht_rt⟩,
        hG_ball, hres_init⟩
    let J_m : ℂ := (s_0 - s_m) / t
    let R : ℂ → ℂ := fun w => refSteepResidual P s_m J_m s_0 t w
    let T : ℂ → ℂ := fun w => w - (4 : ℂ) * R w
    let u : ℕ → ℂ := refSteepIterJ P s_m s_0 t
    let J_p : ℂ := refSteepSolJ P s_m s_0 t
    let B : Set ℂ := Metric.closedBall J_m (1 / 32)
    have hw_one : ∀ w ∈ B, ‖w - 1‖ ≤ 1 / 16 := by
      intro w hw
      have hw_dist : ‖w - J_m‖ ≤ 1 / 32 := by
        simpa [B, Metric.mem_closedBall, dist_eq_norm] using hw
      calc ‖w - 1‖ = ‖(w - J_m) + (J_m - 1)‖ := by ring_nf
        _ ≤ ‖w - J_m‖ + ‖J_m - 1‖ := norm_add_le _ _
        _ ≤ 1 / 32 + 1 / 32 := add_le_add hw_dist hJm_one
        _ = 1 / 16 := by norm_num
    have hT_hasDeriv : ∀ w ∈ B,
        HasDerivAt T (-(w - 1) - (4 : ℂ) * deriv (refSteepPerturbG P s_0 t) w) w := by
      intro w hw
      have hw_lt : ‖w - 1‖ < 1 / 8 := lt_of_le_of_lt (hw_one w hw) (by norm_num)
      have hR_d : HasDerivAt R ((1 / 4 : ℂ) * w + deriv (refSteepPerturbG P s_0 t) w) w :=
        hJets.2.1 z₀ r_s r_t hrs_pos hrt_pos hHolo s_m J_m s_0 t w hs0_z₀ hw_lt ht_rt
      have hT_raw : HasDerivAt T
          (1 - (4 : ℂ) * ((1 / 4 : ℂ) * w + deriv (refSteepPerturbG P s_0 t) w)) w :=
        (hasDerivAt_id w).sub (hR_d.const_mul (4 : ℂ))
      convert hT_raw using 1
      ring
    have hT_deriv_le : ∀ w ∈ B, ‖deriv T w‖ ≤ 1 / 2 := by
      intro w hw
      rw [(hT_hasDeriv w hw).deriv]
      have hG_le : ‖deriv (refSteepPerturbG P s_0 t) w‖ ≤ 1 / 32 := hG_ball w hw
      have hw1 : ‖w - 1‖ ≤ 1 / 16 := hw_one w hw
      have h4 : ‖(4 : ℂ) * deriv (refSteepPerturbG P s_0 t) w‖ =
          4 * ‖deriv (refSteepPerturbG P s_0 t) w‖ := by
        rw [norm_mul]
        norm_num
      calc ‖-(w - 1) - (4 : ℂ) * deriv (refSteepPerturbG P s_0 t) w‖
          ≤ ‖-(w - 1)‖ + ‖(4 : ℂ) * deriv (refSteepPerturbG P s_0 t) w‖ := norm_sub_le _ _
        _ = ‖w - 1‖ + 4 * ‖deriv (refSteepPerturbG P s_0 t) w‖ := by rw [norm_neg, h4]
        _ ≤ 1 / 16 + 4 * (1 / 32) := by linarith
        _ ≤ 1 / 2 := by norm_num
    have hT_lip : ∀ w₁ ∈ B, ∀ w₂ ∈ B, ‖T w₂ - T w₁‖ ≤ (1 / 2 : ℝ) * ‖w₂ - w₁‖ := by
      intro w₁ hw₁ w₂ hw₂
      exact Convex.norm_image_sub_le_of_norm_deriv_le
        (fun w hw => (hT_hasDeriv w hw).differentiableAt)
        hT_deriv_le (convex_closedBall J_m (1 / 32)) hw₁ hw₂
    have hJm_mem : J_m ∈ B := Metric.mem_closedBall_self (by norm_num)
    have hTJm_sub : T J_m - J_m = -(4 : ℂ) * R J_m := by
      dsimp [T]
      ring
    have hTJm_norm : ‖T J_m - J_m‖ = 4 * ‖R J_m‖ := by
      rw [hTJm_sub, norm_mul]
      norm_num
    have hT_maps : ∀ w ∈ B, T w ∈ B := by
      intro w hw
      rw [Metric.mem_closedBall, dist_eq_norm]
      have hw_dist : ‖w - J_m‖ ≤ 1 / 32 := by
        simpa [B, Metric.mem_closedBall, dist_eq_norm] using hw
      have h1 : ‖T w - T J_m‖ ≤ (1 / 2 : ℝ) * ‖w - J_m‖ := hT_lip J_m hJm_mem w hw
      calc ‖T w - J_m‖ = ‖(T w - T J_m) + (T J_m - J_m)‖ := by ring_nf
        _ ≤ ‖T w - T J_m‖ + ‖T J_m - J_m‖ := norm_add_le _ _
        _ ≤ (1 / 2 : ℝ) * (1 / 32) + 4 * (1 / 256) := by
            have : ‖T J_m - J_m‖ ≤ 4 * (1 / 256) := by linarith [hTJm_norm, hres_init]
            linarith
        _ = 1 / 32 := by norm_num
    have hu_zero : u 0 = J_m := rfl
    have hu_succ : ∀ n : ℕ, u (n + 1) = T (u n) := fun _ => rfl
    have hu_mem : ∀ n : ℕ, u n ∈ B := by
      intro n
      induction n with
      | zero => exact hJm_mem
      | succ n ih => rw [hu_succ]; exact hT_maps (u n) ih
    have hu_step : ∀ n : ℕ, dist (u n) (u (n + 1)) ≤ (4 * ‖R J_m‖) * (1 / 2 : ℝ) ^ n := by
      intro n
      induction n with
      | zero =>
        rw [hu_zero, hu_succ, hu_zero, dist_comm, dist_eq_norm, hTJm_norm, pow_zero, mul_one]
      | succ n ih =>
        rw [hu_succ n, hu_succ (n + 1), dist_eq_norm]
        calc ‖T (u n) - T (u (n + 1))‖
            ≤ (1 / 2 : ℝ) * ‖u n - u (n + 1)‖ :=
              hT_lip (u (n + 1)) (hu_mem (n + 1)) (u n) (hu_mem n)
          _ = (1 / 2 : ℝ) * dist (u n) (u (n + 1)) := by rw [dist_eq_norm]
          _ ≤ (1 / 2 : ℝ) * ((4 * ‖R J_m‖) * (1 / 2 : ℝ) ^ n) :=
              mul_le_mul_of_nonneg_left ih (by norm_num)
          _ = (4 * ‖R J_m‖) * (1 / 2 : ℝ) ^ (n + 1) := by ring
    have hu_step64 : ∀ n : ℕ, ‖u n - u (n + 1)‖ ≤ (1 / 64 : ℝ) * (1 / 2 : ℝ) ^ n := by
      intro n
      rw [← dist_eq_norm]
      have h4 : 4 * ‖R J_m‖ ≤ 1 / 64 := by linarith [hres_init]
      exact le_trans (hu_step n) (mul_le_mul_of_nonneg_right h4 (by positivity))
    have hu_cauchy : CauchySeq u :=
      cauchySeq_of_le_geometric (1 / 2 : ℝ) (4 * ‖R J_m‖) (by norm_num) hu_step
    have hu_lim : Filter.Tendsto u Filter.atTop (nhds J_p) :=
      hu_cauchy.tendsto_limUnder
    have hJp_mem : J_p ∈ B :=
      Metric.isClosed_closedBall.mem_of_tendsto hu_lim (Filter.Eventually.of_forall hu_mem)
    have hJp_dist : ‖J_p - J_m‖ ≤ 8 * ‖R J_m‖ := by
      have hd := dist_le_of_le_geometric_of_tendsto₀ (1 / 2 : ℝ) (4 * ‖R J_m‖)
        (by norm_num) hu_step hu_lim
      rw [hu_zero, dist_comm, dist_eq_norm] at hd
      calc ‖J_p - J_m‖ ≤ (4 * ‖R J_m‖) / (1 - 1 / 2) := hd
        _ = 8 * ‖R J_m‖ := by ring
    have hT_Jp : T J_p = J_p := by
      have h1 : Filter.Tendsto (fun n => u (n + 1)) Filter.atTop (nhds J_p) :=
        (Filter.tendsto_add_atTop_iff_nat 1).mpr hu_lim
      have h2 : Filter.Tendsto (fun n => T (u n)) Filter.atTop (nhds (T J_p)) :=
        (hT_hasDeriv J_p hJp_mem).continuousAt.tendsto.comp hu_lim
      exact tendsto_nhds_unique h2 h1
    have hR_Jp : R J_p = 0 := by
      have hsub : J_p - (4 : ℂ) * R J_p = J_p := hT_Jp
      have h40 : (4 : ℂ) * R J_p = 0 := by linear_combination -hsub
      exact (mul_eq_zero.mp h40).resolve_left (by norm_num)
    have hsm_4 : ‖s_m - z₀‖ < r_s / 4 := by linarith
    have hs0_4 : ‖s_0 - z₀‖ < r_s / 4 := by linarith
    have hJm_4 : ‖J_m - 1‖ < 1 / 4 := lt_of_le_of_lt hJm_one (by norm_num)
    have hR_eq : ∀ w ∈ B,
        R w = (deriv (fun J' => P.p_act s_0 J' t) w -
          t * deriv (fun s' => P.p_act s' w t) s_0) -
          deriv (fun J' => P.p_act s_m J' t) J_m := by
      intro w hw
      exact hJets.1 z₀ r_s r_t hrs_pos hrt_pos hHolo s_m J_m s_0 t w
        hsm_4 hJm_4 hs0_4 (lt_of_le_of_lt (hw_one w hw) (by norm_num)) ht_rt
    have hRec_Jp :
        deriv (fun J' => P.p_act s_0 J' t) J_p -
          t * deriv (fun s' => P.p_act s' J_p t) s_0 =
          deriv (fun J' => P.p_act s_m J' t) J_m := by
      have h0 := hR_eq J_p hJp_mem
      rw [hR_Jp] at h0
      exact sub_eq_zero.mp h0.symm
    have hUniq : ∀ J' ∈ B,
        deriv (fun J'' => P.p_act s_0 J'' t) J' -
          t * deriv (fun s' => P.p_act s' J' t) s_0 =
          deriv (fun J'' => P.p_act s_m J'' t) J_m →
        J' = J_p := by
      intro J' hJ'_mem hJ'_eq
      have hRJ' : R J' = 0 := by
        rw [hR_eq J' hJ'_mem]
        exact sub_eq_zero.mpr hJ'_eq
      have hTJ' : T J' = J' := by
        dsimp [T]
        rw [hRJ', mul_zero, sub_zero]
      have hlip := hT_lip J_p hJp_mem J' hJ'_mem
      rw [hTJ', hT_Jp] at hlip
      have hnorm0 : ‖J' - J_p‖ = 0 := by linarith [norm_nonneg (J' - J_p)]
      exact sub_eq_zero.mp (norm_eq_zero.mp hnorm0)
    exact ⟨hu_mem, hu_step64, hu_lim, hJp_dist, hRec_Jp, hUniq⟩
  refine ⟨fun s_m s_0 t hPt => (h_core s_m s_0 t hPt).2.2.2, ?_⟩
  intro U s_m s_0 hU hs_m hs_0 hContr
  let v : ℕ → ℂ × ℂ → ℂ := fun n p => refSteepIterJ P (s_m p) (s_0 p) p.2 n
  let v_inf : ℂ × ℂ → ℂ := fun p => refSteepSolJ P (s_m p) (s_0 p) p.2
  let π₂ : (ℂ × ℂ) →L[ℂ] ℂ :=
    { toFun := fun p => p.2
      map_add' := fun _ _ => rfl
      map_smul' := fun c p => by simp
      cont := continuous_snd }
  have hsnd : DifferentiableOn ℂ (fun p : ℂ × ℂ => p.2) U := π₂.differentiableOn
  have hv0 : DifferentiableOn ℂ (v 0) U := by
    have hinv : DifferentiableOn ℂ (fun p : ℂ × ℂ => (p.2)⁻¹) U :=
      hsnd.inv (fun p hp => (hContr p hp).1)
    exact ((hs_0.sub hs_m).mul hinv).congr (fun p _ => div_eq_mul_inv (s_0 p - s_m p) p.2)
  have hDJ_m : DifferentiableOn ℂ
      (fun p : ℂ × ℂ => refSteepActionDJ P (s_m p) (v 0 p) p.2) U := by
    refine (hJets.2.2.1 U s_m (v 0) hU hs_m hv0 ?_).1
    intro p₀ hp₀
    rcases hContr p₀ hp₀ with ⟨_, hJm_one, ⟨z₀, r_s, r_t, hrs, hrt, hHolo, hsm_z₀, _, ht_rt⟩, _, _⟩
    exact ⟨z₀, r_s, r_t, hrs, hrt, hHolo, hsm_z₀, lt_of_le_of_lt hJm_one (by norm_num), ht_rt⟩
  have hv_holo : ∀ n : ℕ, DifferentiableOn ℂ (v n) U := by
    intro n
    induction n with
    | zero => exact hv0
    | succ n ih =>
      have hJet_n := hJets.2.2.1 U s_0 (v n) hU hs_0 ih (by
        intro p₀ hp₀
        have hvn_mem := (h_core (s_m p₀) (s_0 p₀) p₀.2 (hContr p₀ hp₀)).1 n
        rw [Metric.mem_closedBall, dist_eq_norm] at hvn_mem
        rcases hContr p₀ hp₀ with
          ⟨_, hJm_one, ⟨z₀, r_s, r_t, hrs, hrt, hHolo, _, hs0_z₀, ht_rt⟩, _, _⟩
        have hvn_one : ‖v n p₀ - 1‖ < 1 / 8 := by
          calc ‖v n p₀ - 1‖ = ‖(v n p₀ - v 0 p₀) + (v 0 p₀ - 1)‖ := by ring_nf
            _ ≤ ‖v n p₀ - v 0 p₀‖ + ‖v 0 p₀ - 1‖ := norm_add_le _ _
            _ ≤ 1 / 32 + 1 / 32 := add_le_add hvn_mem hJm_one
            _ < 1 / 8 := by norm_num
        exact ⟨z₀, r_s, r_t, hrs, hrt, hHolo, hs0_z₀, hvn_one, ht_rt⟩)
      have hquad : DifferentiableOn ℂ
          (fun p : ℂ × ℂ => (1 / 8 : ℂ) * (v n p ^ 2 - v 0 p ^ 2)) U :=
        ((ih.pow 2).sub (hv0.pow 2)).const_mul (1 / 8 : ℂ)
      have hG_n : DifferentiableOn ℂ
          (fun p : ℂ × ℂ => refSteepPerturbG P (s_0 p) p.2 (v n p)) U :=
        hJet_n.1.sub (hsnd.mul hJet_n.2)
      have hRes_n : DifferentiableOn ℂ
          (fun p : ℂ × ℂ => refSteepResidual P (s_m p) (v 0 p) (s_0 p) p.2 (v n p)) U :=
        (hquad.add hG_n).sub hDJ_m
      exact ih.sub (hRes_n.const_mul (4 : ℂ))
  have hslice1 : ∀ y t : ℂ, HasDerivAt (fun ξ : ℂ => (ξ, t)) ((1 : ℂ), (0 : ℂ)) y := by
    intro y t
    have h := ((hasDerivAt_id y).smul_const ((1 : ℂ), (0 : ℂ))).add
      (hasDerivAt_const y ((0 : ℂ), t))
    convert h using 1
    · ext ξ <;> simp
    · ext <;> simp
  have hslice2 : ∀ y t : ℂ, HasDerivAt (fun ζ : ℂ => (y, ζ)) ((0 : ℂ), (1 : ℂ)) t := by
    intro y t
    have h := (hasDerivAt_const t (y, (0 : ℂ))).add
      ((hasDerivAt_id t).smul_const ((0 : ℂ), (1 : ℂ)))
    convert h using 1
    · ext ζ <;> simp
    · ext <;> simp
  have hfderiv_2d : ∀ (g : ℂ × ℂ → ℂ) (y t : ℂ),
      DifferentiableAt ℂ g (y, t) →
      ‖fderiv ℂ g (y, t)‖ ≤
        ‖deriv (fun ξ => g (ξ, t)) y‖ + ‖deriv (fun ζ => g (y, ζ)) t‖ := by
    intro g y t hg
    let L := fderiv ℂ g (y, t)
    have hL1 : deriv (fun ξ => g (ξ, t)) y = L (1, 0) :=
      (hg.hasFDerivAt.comp_hasDerivAt y (hslice1 y t)).deriv
    have hL2 : deriv (fun ζ => g (y, ζ)) t = L (0, 1) :=
      (hg.hasFDerivAt.comp_hasDerivAt t (hslice2 y t)).deriv
    rw [hL1, hL2]
    refine L.opNorm_le_bound (by positivity) (fun h => ?_)
    have hh_eq : h = h.1 • ((1 : ℂ), (0 : ℂ)) + h.2 • ((0 : ℂ), (1 : ℂ)) := by
      ext <;> simp
    have hLh : L h = h.1 • L (1, 0) + h.2 • L (0, 1) := by
      conv_lhs => rw [hh_eq]
      rw [map_add, map_smul, map_smul]
    have hh1 : ‖h.1‖ ≤ ‖h‖ := norm_fst_le h
    have hh2 : ‖h.2‖ ≤ ‖h‖ := norm_snd_le h
    calc ‖L h‖ = ‖h.1 • L (1, 0) + h.2 • L (0, 1)‖ := by rw [hLh]
      _ ≤ ‖h.1 • L (1, 0)‖ + ‖h.2 • L (0, 1)‖ := norm_add_le _ _
      _ = ‖h.1‖ * ‖L (1, 0)‖ + ‖h.2‖ * ‖L (0, 1)‖ := by rw [norm_smul, norm_smul]
      _ ≤ ‖h‖ * ‖L (1, 0)‖ + ‖h‖ * ‖L (0, 1)‖ :=
          add_le_add (mul_le_mul_of_nonneg_right hh1 (norm_nonneg _))
            (mul_le_mul_of_nonneg_right hh2 (norm_nonneg _))
      _ = (‖L (1, 0)‖ + ‖L (0, 1)‖) * ‖h‖ := by ring
  intro p₀ hp₀
  obtain ⟨R_open, hR_pos, hBall_sub⟩ := Metric.isOpen_iff.mp hU p₀ hp₀
  let r₀ : ℝ := R_open / 3
  have hr₀_pos : 0 < r₀ := by dsimp [r₀]; positivity
  let P₀ : Set (ℂ × ℂ) := Metric.ball p₀ r₀
  have hP₀_sub : P₀ ⊆ U := by
    intro q hq
    apply hBall_sub
    rw [Metric.mem_ball] at hq ⊢
    dsimp [r₀] at hq
    linarith
  have hfderiv_step : ∀ (n : ℕ), ∀ p ∈ P₀,
      dist (fderiv ℂ (v n) p) (fderiv ℂ (v (n + 1)) p) ≤
        (1 / (32 * r₀)) * (1 / 2 : ℝ) ^ n := by
    intro n p hp
    let d_n : ℂ × ℂ → ℂ := fun q => v n q - v (n + 1) q
    have hd_holo : DifferentiableOn ℂ d_n U := (hv_holo n).sub (hv_holo (n + 1))
    have hp_dist : dist p p₀ < r₀ := Metric.mem_ball.mp hp
    rw [Prod.dist_eq, max_lt_iff] at hp_dist
    rcases hp_dist with ⟨hp1_dist, hp2_dist⟩
    have h_s1_maps : Set.MapsTo (fun ξ : ℂ => (ξ, p.2)) (Metric.ball p₀.1 R_open) U := by
      intro ξ hξ
      apply hBall_sub
      rw [Metric.mem_ball, Prod.dist_eq, max_lt_iff]
      exact ⟨Metric.mem_ball.mp hξ, lt_trans hp2_dist (by dsimp [r₀]; linarith)⟩
    have h_s1_holo : DifferentiableOn ℂ (fun ξ : ℂ => d_n (ξ, p.2)) (Metric.ball p₀.1 R_open) :=
      hd_holo.comp (fun ξ _ => (hslice1 ξ p.2).differentiableAt.differentiableWithinAt) h_s1_maps
    have h_s1_cb : Metric.closedBall p.1 r₀ ⊆ Metric.ball p₀.1 R_open := by
      intro ξ hξ
      rw [Metric.mem_closedBall] at hξ
      rw [Metric.mem_ball]
      have htri := dist_triangle ξ p.1 p₀.1
      dsimp [r₀] at hξ hp1_dist
      linarith
    have h_s1_dc : DiffContOnCl ℂ (fun ξ : ℂ => d_n (ξ, p.2)) (Metric.ball p.1 r₀) :=
      h_s1_holo.diffContOnCl_ball h_s1_cb
    have h_s1_sph : ∀ ξ ∈ Metric.sphere p.1 r₀,
        ‖d_n (ξ, p.2)‖ ≤ (1 / 64 : ℝ) * (1 / 2 : ℝ) ^ n := by
      intro ξ hξ
      have h_in_U : (ξ, p.2) ∈ U :=
        h_s1_maps (h_s1_cb (Metric.sphere_subset_closedBall hξ))
      exact (h_core (s_m (ξ, p.2)) (s_0 (ξ, p.2)) p.2 (hContr (ξ, p.2) h_in_U)).2.1 n
    have h_deriv1 : ‖deriv (fun ξ : ℂ => d_n (ξ, p.2)) p.1‖ ≤
        ((1 / 64 : ℝ) * (1 / 2 : ℝ) ^ n) / r₀ :=
      Complex.norm_deriv_le_of_forall_mem_sphere_norm_le hr₀_pos h_s1_dc h_s1_sph
    have h_s2_maps : Set.MapsTo (fun ζ : ℂ => (p.1, ζ)) (Metric.ball p₀.2 R_open) U := by
      intro ζ hζ
      apply hBall_sub
      rw [Metric.mem_ball, Prod.dist_eq, max_lt_iff]
      exact ⟨lt_trans hp1_dist (by dsimp [r₀]; linarith), Metric.mem_ball.mp hζ⟩
    have h_s2_holo : DifferentiableOn ℂ (fun ζ : ℂ => d_n (p.1, ζ)) (Metric.ball p₀.2 R_open) :=
      hd_holo.comp (fun ζ _ => (hslice2 p.1 ζ).differentiableAt.differentiableWithinAt) h_s2_maps
    have h_s2_cb : Metric.closedBall p.2 r₀ ⊆ Metric.ball p₀.2 R_open := by
      intro ζ hζ
      rw [Metric.mem_closedBall] at hζ
      rw [Metric.mem_ball]
      have htri := dist_triangle ζ p.2 p₀.2
      dsimp [r₀] at hζ hp2_dist
      linarith
    have h_s2_dc : DiffContOnCl ℂ (fun ζ : ℂ => d_n (p.1, ζ)) (Metric.ball p.2 r₀) :=
      h_s2_holo.diffContOnCl_ball h_s2_cb
    have h_s2_sph : ∀ ζ ∈ Metric.sphere p.2 r₀,
        ‖d_n (p.1, ζ)‖ ≤ (1 / 64 : ℝ) * (1 / 2 : ℝ) ^ n := by
      intro ζ hζ
      have h_in_U : (p.1, ζ) ∈ U :=
        h_s2_maps (h_s2_cb (Metric.sphere_subset_closedBall hζ))
      exact (h_core (s_m (p.1, ζ)) (s_0 (p.1, ζ)) ζ (hContr (p.1, ζ) h_in_U)).2.1 n
    have h_deriv2 : ‖deriv (fun ζ : ℂ => d_n (p.1, ζ)) p.2‖ ≤
        ((1 / 64 : ℝ) * (1 / 2 : ℝ) ^ n) / r₀ :=
      Complex.norm_deriv_le_of_forall_mem_sphere_norm_le hr₀_pos h_s2_dc h_s2_sph
    have hp_nhds : U ∈ nhds p := hU.mem_nhds (hP₀_sub hp)
    have hvn_at : DifferentiableAt ℂ (v n) p := (hv_holo n).differentiableAt hp_nhds
    have hvn1_at : DifferentiableAt ℂ (v (n + 1)) p := (hv_holo (n + 1)).differentiableAt hp_nhds
    have hd_at : DifferentiableAt ℂ d_n (p.1, p.2) := hvn_at.sub hvn1_at
    have h_fderiv_eq : fderiv ℂ (v n) p - fderiv ℂ (v (n + 1)) p = fderiv ℂ d_n (p.1, p.2) :=
      (fderiv_sub hvn_at hvn1_at).symm
    rw [dist_eq_norm, h_fderiv_eq]
    calc ‖fderiv ℂ d_n (p.1, p.2)‖
        ≤ ‖deriv (fun ξ => d_n (ξ, p.2)) p.1‖ + ‖deriv (fun ζ => d_n (p.1, ζ)) p.2‖ :=
          hfderiv_2d d_n p.1 p.2 hd_at
      _ ≤ ((1 / 64 : ℝ) * (1 / 2 : ℝ) ^ n) / r₀ + ((1 / 64 : ℝ) * (1 / 2 : ℝ) ^ n) / r₀ :=
          add_le_add h_deriv1 h_deriv2
      _ = (1 / (32 * r₀)) * (1 / 2 : ℝ) ^ n := by ring
  let g' : ℂ × ℂ → ((ℂ × ℂ) →L[ℂ] ℂ) :=
    fun p => Filter.limUnder Filter.atTop (fun n => fderiv ℂ (v n) p)
  have hg'_lim : ∀ p ∈ P₀,
      Filter.Tendsto (fun n => fderiv ℂ (v n) p) Filter.atTop (nhds (g' p)) := by
    intro p hp
    have hc : CauchySeq (fun n => fderiv ℂ (v n) p) :=
      cauchySeq_of_le_geometric (1 / 2 : ℝ) (1 / (32 * r₀)) (by norm_num)
        (fun n => hfderiv_step n p hp)
    exact hc.tendsto_limUnder
  have hg'_tail : ∀ p ∈ P₀, ∀ n : ℕ,
      dist (g' p) (fderiv ℂ (v n) p) ≤ (1 / (16 * r₀)) * (1 / 2 : ℝ) ^ n := by
    intro p hp n
    rw [dist_comm]
    have hd := dist_le_of_le_geometric_of_tendsto (1 / 2 : ℝ) (1 / (32 * r₀))
      (by norm_num) (fun k => hfderiv_step k p hp) (hg'_lim p hp) n
    calc dist (fderiv ℂ (v n) p) (g' p)
        ≤ (1 / (32 * r₀)) * (1 / 2 : ℝ) ^ n / (1 - 1 / 2) := hd
      _ = (1 / (16 * r₀)) * (1 / 2 : ℝ) ^ n := by ring
  have hunif : TendstoUniformlyOn (fun n p => fderiv ℂ (v n) p) g' Filter.atTop P₀ := by
    rw [Metric.tendstoUniformlyOn_iff]
    intro ε hε
    have h_zero : Filter.Tendsto (fun n : ℕ => (1 / (16 * r₀)) * (1 / 2 : ℝ) ^ n)
        Filter.atTop (nhds 0) := by
      simpa using (tendsto_pow_atTop_nhds_zero_of_lt_one
        (by norm_num : (0 : ℝ) ≤ 1 / 2) (by norm_num : (1 / 2 : ℝ) < 1)).const_mul (1 / (16 * r₀))
    obtain ⟨N, hN⟩ := (Metric.tendsto_atTop.mp h_zero) ε hε
    refine Filter.eventually_atTop.mpr ⟨N, fun n hn p hp => ?_⟩
    have h_lt : (1 / (16 * r₀)) * (1 / 2 : ℝ) ^ n < ε := by
      have hd := hN n hn
      have h_nonneg : 0 ≤ (1 / (16 * r₀)) * (1 / 2 : ℝ) ^ n := by positivity
      rwa [Real.dist_eq, sub_zero, abs_of_nonneg h_nonneg] at hd
    exact lt_of_le_of_lt (hg'_tail p hp n) h_lt
  have hv_hasFDeriv : ∀ n : ℕ, ∀ x ∈ P₀, HasFDerivAt (v n) (fderiv ℂ (v n) x) x := by
    intro n x hx
    exact ((hv_holo n).differentiableAt (hU.mem_nhds (hP₀_sub hx))).hasFDerivAt
  have hv_ptwise : ∀ x ∈ P₀, Filter.Tendsto (fun n => v n x) Filter.atTop (nhds (v_inf x)) := by
    intro x hx
    exact (h_core (s_m x) (s_0 x) x.2 (hContr x (hP₀_sub hx))).2.2.1
  have h_lim_fderiv : HasFDerivAt v_inf (g' p₀) p₀ :=
    hasFDerivAt_of_tendstoUniformlyOn Metric.isOpen_ball hunif hv_hasFDeriv
      hv_ptwise (Metric.mem_ball_self hr₀_pos)
  exact h_lim_fderiv.differentiableAt.differentiableWithinAt

theorem ref_steep_step_admissibility_and_mesh_sum (X : ExpStripData) (P : ChordActionPackage X)
    (hJets : RefSteepJetProp X P) :
    RefSteepStepAdmProp X P :=
by
  refine ⟨?_, ?_, ?_⟩
  
  
  
  · intro β x_start Δ M hβ hx hΔ
    let g : ℝ → ℝ := fun u => (x_start + u) ^ (1 - β) / (1 - β)
    have h1β_neg : 1 - β < 0 := by linarith only [hβ]
    have h1β_ne : 1 - β ≠ 0 := h1β_neg.ne
    have hg_deriv : ∀ u : ℝ, 0 ≤ u → HasDerivAt g ((x_start + u) ^ (-β)) u := by
      intro u hu
      have hxu : 0 < x_start + u := by linarith only [hx, hu]
      have h1 : HasDerivAt (fun v : ℝ => x_start + v) 1 u := by
        simpa using (hasDerivAt_id u).const_add x_start
      have h2 : HasDerivAt (fun v : ℝ => (x_start + v) ^ (1 - β))
          (1 * (1 - β) * (x_start + u) ^ ((1 - β) - 1)) u :=
        h1.rpow_const (Or.inl hxu.ne')
      have h3 : HasDerivAt g ((1 * (1 - β) * (x_start + u) ^ ((1 - β) - 1)) / (1 - β)) u :=
        h2.div_const (1 - β)
      have h_eq : (1 * (1 - β) * (x_start + u) ^ ((1 - β) - 1)) / (1 - β) =
          (x_start + u) ^ (-β) := by
        have hexp : (1 - β) - 1 = -β := by ring
        rw [hexp]
        field_simp [h1β_ne]
      rwa [h_eq] at h3
    let F : ℕ → ℝ := fun k => g ((k : ℝ) * Δ)
    have h_step : ∀ j : ℕ,
        Δ * (x_start + ((j + 1 : ℕ) : ℝ) * Δ) ^ (-β) ≤ F (j + 1) - F j := by
      intro j
      let a : ℝ := (j : ℝ) * Δ
      let b : ℝ := ((j + 1 : ℕ) : ℝ) * Δ
      have ha_nonneg : 0 ≤ a := mul_nonneg (Nat.cast_nonneg j) hΔ.le
      have hba : b - a = Δ := by
        dsimp only [a, b]
        push_cast
        ring
      have hab : a < b := by linarith only [hba, hΔ]
      have hg_cont : ContinuousOn g (Set.Icc a b) := by
        intro u hu
        exact (hg_deriv u (le_trans ha_nonneg hu.1)).continuousAt.continuousWithinAt
      have hg_d : ∀ u ∈ Set.Ioo a b, HasDerivAt g ((x_start + u) ^ (-β)) u := by
        intro u hu
        exact hg_deriv u (le_trans ha_nonneg hu.1.le)
      obtain ⟨c, hc_mem, hc_eq⟩ := exists_hasDerivAt_eq_slope g _ hab hg_cont hg_d
      have hxc_pos : 0 < x_start + c := by linarith only [hx, ha_nonneg, hc_mem.1]
      have hxcb : x_start + c ≤ x_start + b := by linarith only [hc_mem.2]
      have hrpow_le : (x_start + b) ^ (-β) ≤ (x_start + c) ^ (-β) :=
        Real.rpow_le_rpow_of_nonpos hxc_pos hxcb (by linarith only [hβ])
      rw [hc_eq, hba] at hrpow_le
      have hmul := mul_le_mul_of_nonneg_left hrpow_le hΔ.le
      have hcancel : Δ * ((g b - g a) / Δ) = F (j + 1) - F j := by
        dsimp only [F, a, b]
        field_simp [hΔ.ne']
      rwa [hcancel] at hmul
    calc Δ * (∑ j ∈ Finset.range M, (x_start + ((j + 1 : ℕ) : ℝ) * Δ) ^ (-β))
        = ∑ j ∈ Finset.range M, Δ * (x_start + ((j + 1 : ℕ) : ℝ) * Δ) ^ (-β) :=
          Finset.mul_sum _ _ _
      _ ≤ ∑ j ∈ Finset.range M, (F (j + 1) - F j) :=
          Finset.sum_le_sum (fun j _ => h_step j)
      _ = F M - F 0 := Finset.sum_range_sub F M
      _ ≤ x_start ^ (1 - β) / (β - 1) := by
          have hxM_pos : 0 < x_start + (M : ℝ) * Δ :=
            add_pos_of_pos_of_nonneg hx (mul_nonneg (Nat.cast_nonneg M) hΔ.le)
          have hrpow_pos : 0 < (x_start + (M : ℝ) * Δ) ^ (1 - β) :=
            Real.rpow_pos_of_pos hxM_pos (1 - β)
          have hFM_nonpos : F M ≤ 0 :=
            div_nonpos_of_nonneg_of_nonpos hrpow_pos.le h1β_neg.le
          have hF0 : F 0 = -(x_start ^ (1 - β) / (β - 1)) := by
            dsimp only [F, g]
            simp only [Nat.cast_zero, zero_mul, add_zero]
            have hsub : 1 - β = -(β - 1) := by ring
            rw [hsub, div_neg]
          linarith only [hFM_nonpos, hF0]
  
  
  
  · intro α γ_steep x₀ h_ref m_steep d δ_ceil Δ_slab r M_scale C_init s_init
      hα1 hα2 hγ1 hγ2 hm hd hΔ h2Δ hr hM hCinit hAbs
      L_in S_init hs_init_holo hs_init_bound
      z_bot t ht_steep ht_norm hz_top_dep hz_bot_dep hz_top_re
    have hδ_pos : 0 < δ_ceil := by linarith only [hΔ, h2Δ]
    have h_rpow_pos : 0 < (δ_ceil / d) ^ α :=
      Real.rpow_pos_of_pos (div_pos hδ_pos hd) α
    have ht_12 : ‖t‖ < 12 * r * (δ_ceil / d) ^ α := by
      nlinarith only [ht_norm, hr, h_rpow_pos]
    have ht_im_pos : 0 < t.im :=
      lt_of_le_of_lt (mul_nonneg hγ1.le (norm_nonneg t)) ht_steep
    have ht_ne : t ≠ 0 := by
      intro h0
      rw [h0, Complex.zero_im] at ht_im_pos
      exact lt_irrefl 0 ht_im_pos
    have ht_norm_pos : 0 < ‖t‖ := norm_pos_iff.mpr ht_ne
    have ht_div_γ : ‖t‖ < t.im / γ_steep :=
      (lt_div_iff₀ hγ1).mpr (by linarith only [ht_steep])
    have ht_re_le : |t.re| ≤ t.im / γ_steep :=
      le_trans (Complex.abs_re_le_norm t) ht_div_γ.le
    let ρ_slab : ℝ := Δ_slab / 32
    have hρ_pos : 0 < ρ_slab := div_pos hΔ (by norm_num)
    
    have h_cb_in_S : ∀ θ ∈ Set.Icc (0 : ℝ) 1,
        ∀ z' ∈ Metric.closedBall ((1 - (θ : ℂ)) * z_bot + (θ : ℂ) * (z_bot + t)) ρ_slab,
          (z', t) ∈ S_init := by
      intro θ hθ z' hz'
      set w : ℂ := (1 - (θ : ℂ)) * z_bot + (θ : ℂ) * (z_bot + t)
      have hw_eq : w = (z_bot + t) - ((1 - θ : ℝ) : ℂ) * t := by
        dsimp only [w]
        push_cast
        ring
      have hw_im_bot : w.im = z_bot.im + θ * t.im := by
        dsimp only [w]
        simp
        ring
      have hw_im_top : w.im = (z_bot + t).im - (1 - θ) * t.im := by
        rw [hw_eq]
        simp
      have hθ_im_nonneg : 0 ≤ θ * t.im := mul_nonneg hθ.1 ht_im_pos.le
      have h1θ_nonneg : 0 ≤ 1 - θ := sub_nonneg.mpr hθ.2
      have h1θ_im_nonneg : 0 ≤ (1 - θ) * t.im := mul_nonneg h1θ_nonneg ht_im_pos.le
      have hw_dep_lo : h_ref - (z_bot + t).im ≤ h_ref - w.im := by
        linarith only [hw_im_top, h1θ_im_nonneg]
      have hw_dep_hi : h_ref - w.im ≤ h_ref - z_bot.im := by
        linarith only [hw_im_bot, hθ_im_nonneg]
      have hz'_norm : ‖z' - w‖ ≤ Δ_slab / 32 := by
        simpa only [Metric.mem_closedBall, dist_eq_norm, ρ_slab] using hz'
      have hz'_im_abs : |z'.im - w.im| ≤ Δ_slab / 32 := by
        have h1 : |(z' - w).im| ≤ ‖z' - w‖ := Complex.abs_im_le_norm (z' - w)
        simpa only [Complex.sub_im] using le_trans h1 hz'_norm
      rcases abs_le.mp hz'_im_abs with ⟨hz'_im_lo, hz'_im_hi⟩
      have hz'_dep_lo : δ_ceil - Δ_slab < h_ref - z'.im := by
        linarith only [hz_top_dep, hw_dep_lo, hz'_im_hi]
      have hz'_dep_hi : h_ref - z'.im < δ_ceil := by
        linarith only [hz_bot_dep, hw_dep_hi, hz'_im_lo]
      
      have hw_re_eq : w.re - x₀ = ((z_bot + t).re - x₀) + (-(1 - θ) * t.re) := by
        rw [hw_eq]
        simp
        ring
      have hw_re_tri : |w.re - x₀| ≤ |(z_bot + t).re - x₀| + (1 - θ) * |t.re| := by
        rw [hw_re_eq]
        refine le_trans (abs_add_le _ _) ?_
        have h_term : |-(1 - θ) * t.re| = (1 - θ) * |t.re| := by
          rw [neg_mul, abs_neg, abs_mul, abs_of_nonneg h1θ_nonneg]
        linarith only [h_term]
      have h_inv_γ_pos : 0 < 1 / γ_steep := one_div_pos.mpr hγ1
      have h_slope_pos : 0 < m_steep + 1 / γ_steep := add_pos hm h_inv_γ_pos
      have h_step_re : (1 - θ) * |t.re| ≤ (m_steep + 1 / γ_steep) * ((1 - θ) * t.im) := by
        have h1 : (1 - θ) * |t.re| ≤ (1 - θ) * (t.im / γ_steep) :=
          mul_le_mul_of_nonneg_left ht_re_le h1θ_nonneg
        have h2 : (1 - θ) * (t.im / γ_steep) = (1 / γ_steep) * ((1 - θ) * t.im) := by ring
        have h3 : (1 / γ_steep) * ((1 - θ) * t.im) ≤
            (m_steep + 1 / γ_steep) * ((1 - θ) * t.im) :=
          mul_le_mul_of_nonneg_right (by linarith only [hm]) h1θ_im_nonneg
        exact le_trans h1 (h2 ▸ h3)
      have hw_re_bound : |w.re - x₀| ≤ (m_steep + 1 / γ_steep) * (h_ref - w.im) := by
        have h_sum : h_ref - (z_bot + t).im + (1 - θ) * t.im = h_ref - w.im := by
          linarith only [hw_im_top]
        have h_add := add_le_add hz_top_re h_step_re
        rw [← mul_add, h_sum] at h_add
        exact le_trans hw_re_tri h_add
      have hz'_dep_gt_ρ : Δ_slab / 32 < h_ref - z'.im := by
        linarith only [hΔ, h2Δ, hz'_dep_lo]
      have hz'_dep_pos : 0 < h_ref - z'.im := by
        linarith only [hΔ, hz'_dep_gt_ρ]
      have hw_dep_lt_two : h_ref - w.im < 2 * (h_ref - z'.im) := by
        linarith only [hz'_im_hi, hz'_dep_gt_ρ]
      have hz'_re_diff : |z'.re - w.re| ≤ Δ_slab / 32 := by
        have h1 : |(z' - w).re| ≤ ‖z' - w‖ := Complex.abs_re_le_norm (z' - w)
        simpa only [Complex.sub_re] using le_trans h1 hz'_norm
      have hz'_re_tri : |z'.re - x₀| ≤ |z'.re - w.re| + |w.re - x₀| := by
        have h_split : z'.re - x₀ = (z'.re - w.re) + (w.re - x₀) := by ring
        rw [h_split]
        exact abs_add_le _ _
      have hz'_re_lt : |z'.re - x₀| < L_in * (h_ref - z'.im) := by
        have h_w_scaled : (m_steep + 1 / γ_steep) * (h_ref - w.im) <
            (m_steep + 1 / γ_steep) * (2 * (h_ref - z'.im)) :=
          mul_lt_mul_of_pos_left hw_dep_lt_two h_slope_pos
        have h_comb : |z'.re - x₀| <
            (2 * m_steep + 2 / γ_steep + 1) * (h_ref - z'.im) := by
          have h_alg : (h_ref - z'.im) + (m_steep + 1 / γ_steep) * (2 * (h_ref - z'.im)) =
              (2 * m_steep + 2 / γ_steep + 1) * (h_ref - z'.im) := by ring
          linarith only [hz'_re_tri, hz'_re_diff, hz'_dep_gt_ρ, hw_re_bound, h_w_scaled, h_alg]
        have h_Lin : (2 * m_steep + 2 / γ_steep + 1) * (h_ref - z'.im) <
            L_in * (h_ref - z'.im) := by
          dsimp only [L_in]
          nlinarith only [hz'_dep_pos]
        exact lt_trans h_comb h_Lin
      exact ⟨hz'_dep_lo, hz'_dep_hi, hz'_re_lt, ht_12⟩
    have hz_bot_mem : (z_bot, t) ∈ S_init := by
      have h0 : (0 : ℝ) ∈ Set.Icc (0 : ℝ) 1 := ⟨le_rfl, zero_le_one⟩
      have h_self : z_bot ∈ Metric.closedBall
          ((1 - ((0 : ℝ) : ℂ)) * z_bot + ((0 : ℝ) : ℂ) * (z_bot + t)) ρ_slab := by
        simp [Metric.mem_closedBall, hρ_pos.le]
      exact h_cb_in_S 0 h0 z_bot h_self
    have hz_top_mem : (z_bot + t, t) ∈ S_init := by
      have h1 : (1 : ℝ) ∈ Set.Icc (0 : ℝ) 1 := ⟨zero_le_one, le_rfl⟩
      have h_self : z_bot + t ∈ Metric.closedBall
          ((1 - ((1 : ℝ) : ℂ)) * z_bot + ((1 : ℝ) : ℂ) * (z_bot + t)) ρ_slab := by
        simp [Metric.mem_closedBall, hρ_pos.le]
      exact h_cb_in_S 1 h1 (z_bot + t) h_self
    
    let V_t : Set ℂ := { z' : ℂ | (z', t) ∈ S_init }
    let g_t : ℂ → ℂ := fun z' => s_init (z', t) - z'
    have hg_holo : DifferentiableOn ℂ g_t V_t := by
