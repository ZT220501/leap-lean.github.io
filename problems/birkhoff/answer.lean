    have h_inv_eq : (Real.pi * (1 / 9 : ℝ) ^ 2)⁻¹ = 81 * Real.pi⁻¹ := by
      field_simp [Real.pi_ne_zero]
      ring
    calc Real.sqrt ‖q_t z‖
        ≤ (Real.pi * (1 / 9 : ℝ) ^ 2)⁻¹ * ∫ w in Metric.ball z (1 / 9), Real.sqrt ‖q_t w‖ :=
          h_submean
      _ ≤ (81 * Real.pi⁻¹) * (86609 * Real.pi * (I_def + 1)) := by
          rw [h_inv_eq]
          exact mul_le_mul_of_nonneg_left h_b19_int_le (by positivity)
      _ = 7015329 * (1 + I_def) := by
          field_simp [Real.pi_ne_zero]
          ring
      _ ≤ 7100000 * (1 + I_def) := by linarith
  refine ⟨7100000, by norm_num, ?_⟩
  intro U f q hU hf hq h_ode h_simp z₀ Δ K hΔ hSub hBdd
  let φ_z : ℂ → ℂ := fun ζ => z₀ + (Δ : ℂ) * ζ
  let U_t : Set ℂ := φ_z ⁻¹' U
  let f_t : ℂ → ℂ := fun ζ => 1 * f (φ_z ζ)
  let q_t : ℂ → ℂ := fun ζ => ((Δ ^ 2 : ℝ) : ℂ) * q (φ_z ζ)
  obtain ⟨hUt_open, hf_t, hq_t, h_ode_t, h_simp_t⟩ :=
    h_ode_affine U f q z₀ Δ 1 hU hf hq h_ode h_simp hΔ one_ne_zero
  have hφ_maps : ∀ ζ ∈ Metric.closedBall (0 : ℂ) 1, φ_z ζ ∈ Metric.closedBall z₀ Δ := by
    intro ζ hζ
    have hζ_le : ‖ζ‖ ≤ 1 := by simpa [Metric.mem_closedBall, dist_zero_right] using hζ
    rw [Metric.mem_closedBall, dist_eq_norm]
    dsimp [φ_z]
    rw [add_sub_cancel_left, norm_mul, Complex.norm_of_nonneg hΔ.le]
    nlinarith
  have hSub_t : Metric.closedBall (0 : ℂ) 1 ⊆ U_t := fun ζ hζ => hSub (hφ_maps ζ hζ)
  have hBdd_t : ∀ ζ ∈ Metric.closedBall (0 : ℂ) 1, ‖f_t ζ‖ ≤ Real.exp K := by
    intro ζ hζ
    dsimp [f_t]
    rw [one_mul]
    exact hBdd (φ_z ζ) (hφ_maps ζ hζ)
  obtain ⟨hf_t_int, hq_t_bound⟩ :=
    h_unit U_t f_t q_t K hUt_open hf_t hq_t h_ode_t h_simp_t hSub_t hBdd_t
  have hf_t_int' : MeasureTheory.IntegrableOn
      (fun ζ : ℂ => K - Real.log ‖f (z₀ + (Δ : ℂ) * ζ)‖)
      (Metric.ball (0 : ℂ) 1) MeasureTheory.volume := by
    simpa [f_t, φ_z] using hf_t_int
  obtain ⟨hf_dst_int, hf_dst_val⟩ :=
    h_ball_affine z₀ Δ 1 (fun w => K - Real.log ‖f w‖) hΔ zero_lt_one hf_t_int'
  rw [mul_one] at hf_dst_int hf_dst_val
  refine ⟨hf_dst_int, fun z hz => ?_⟩
  let ζ : ℂ := ((Δ⁻¹ : ℝ) : ℂ) * (z - z₀)
  have hζ_mem : ζ ∈ Metric.ball (0 : ℂ) (1 / 4) := by
    rw [Metric.mem_ball, dist_eq_norm] at hz
    rw [Metric.mem_ball, dist_zero_right]
    dsimp [ζ]
    rw [norm_mul, Complex.norm_of_nonneg (inv_nonneg.mpr hΔ.le), ← div_eq_inv_mul,
      div_lt_iff₀ hΔ]
    linarith
  have hφ_ζ : φ_z ζ = z := by
    dsimp [φ_z, ζ]
    have hΔ_c_ne : (Δ : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hΔ.ne'
