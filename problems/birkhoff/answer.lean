          (∀ v ∈ Metric.ball (0 : ℂ) ρ, ‖B v‖ < 1) ∧
          (∀ v ∈ Metric.ball (0 : ℂ) ρ, 1 - B v ∈ Complex.slitPlane) ∧
          γ 0 = 0 ∧
          γ 1 = d 1 ∧
          (∀ m : ℕ, 0 ≤ γ m) ∧
          (∀ v ∈ Metric.ball (0 : ℂ) ρ,
            HasSum (fun m : ℕ => (γ m : ℂ) * v ^ (2 * m)) (-Complex.log (1 - B v)))) := by
    have h_even_ball : ∀ (ρ C : ℝ) (c : ℕ → ℝ),
        0 < ρ → 0 ≤ C →
        (∀ m : ℕ, |c m| ≤ C * (ρ⁻¹) ^ (2 * m)) →
        let F : ℂ → ℂ := fun v => ∑' m : ℕ, (c m : ℂ) * v ^ (2 * m)
        let F' : ℂ → ℂ := fun v => ∑' m : ℕ, (c m : ℂ) * ((2 * m : ℕ) : ℂ) * v ^ (2 * m - 1)
