            mul_le_mul_of_nonneg_right hz_lt.le (Real.exp_pos _).le
        _ = 3 * Real.exp (-(3 / 2 : ℝ) * z.re) := by
            rw [mul_assoc, ← Real.exp_add]; congr 2; ring
    have hPhi_bound : ‖PhiQ z - 1‖ ≤ 64 * Real.exp (-(3 / 2 : ℝ) * z.re) := by
      rw [hPhi_diff, norm_div, norm_pow]
      have h_num : ‖-2 * q - 2 * q ^ 2 - 4 * z * q‖ ≤ 16 * Real.exp (-(3 / 2 : ℝ) * z.re) := by
        have htri1 := norm_add_le (-2 * q + (-2 * q ^ 2)) (-4 * z * q)
        have htri2 := norm_add_le (-2 * q) (-2 * q ^ 2)
        have heq : -2 * q - 2 * q ^ 2 - 4 * z * q = (-2 * q + (-2 * q ^ 2)) + (-4 * z * q) := by ring
        rw [heq]
        have hn1 : ‖-2 * q‖ = 2 * ‖q‖ := by rw [norm_mul, norm_neg, Complex.norm_ofNat]
        have hn2 : ‖-2 * q ^ 2‖ = 2 * ‖q ^ 2‖ := by rw [norm_mul, norm_neg, Complex.norm_ofNat]
        have hn3 : ‖-4 * z * q‖ = 4 * ‖z * q‖ := by
          rw [mul_assoc, norm_mul, norm_neg, Complex.norm_ofNat]
        linarith
      have h_den : (1 / 4 : ℝ) < ‖1 + q‖ ^ 2 := by nlinarith
      have h_den_pos : 0 < ‖1 + q‖ ^ 2 := by positivity
      rw [div_le_iff₀ h_den_pos]
      nlinarith [Real.exp_pos (-(3 / 2 : ℝ) * z.re)]
    have hPhi_lt_tenth : ‖PhiQ z - 1‖ < 1 / 10 := by
      have h1 : Real.exp (-(3 / 2 : ℝ) * z.re) < Real.exp (-12) :=
        Real.exp_lt_exp.mpr (by linarith)
      have h2 : Real.exp (-12) ≤ 1 / 729 := by
        rw [Real.exp_neg]
        exact (inv_anti₀ (by norm_num) hexp12_ge).trans (by norm_num)
      linarith
    have hPhi_re : 0 < (PhiQ z).re := by
      have hre : |(PhiQ z - 1).re| ≤ ‖PhiQ z - 1‖ := Complex.abs_re_le_norm _
      simp only [Complex.sub_re, Complex.one_re] at hre
      rw [abs_le] at hre
