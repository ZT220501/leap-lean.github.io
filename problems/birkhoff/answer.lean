    have hb_ge1 : (1 : ℝ) ≤ (b_nat : ℝ) := by exact_mod_cast (show 1 ≤ K + 2 by omega)
    have hp2_lt : ‖p.2‖ < hDet.r_det :=
      lt_of_lt_of_le hp2 (div_le_self (le_of_lt hr_det) hb_ge1)
    exact ⟨him, by linarith⟩
  have h_aeval_lineJet_mem : ∀ (q₀ q₁ : ℤ) (M : ℕ) (Q : MvPolynomial (LineJetVar M) ℂ),
      MvPolynomial.aeval (lineJetTay q₀ q₁ M) Q ∈ jetAlg {q₀, q₁} := by
    intro q₀ q₁ M Q
    have h_var : ∀ v : LineJetVar M, lineJetTay q₀ q₁ M v ∈ jetAlg {q₀, q₁} := by
      intro v
      apply Algebra.subset_adjoin
      dsimp only [lineJetTay]
      split_ifs with hv
      · exact ⟨q₀, Or.inl rfl, v.2.1, v.2.2.1.1, v.2.2.2.1, rfl⟩
      · exact ⟨q₁, Or.inr rfl, v.2.1, v.2.2.1.1, v.2.2.2.1, rfl⟩
    induction Q using MvPolynomial.induction_on with
    | C c => rw [MvPolynomial.aeval_C]; exact (jetAlg {q₀, q₁}).algebraMap_mem c
    | add P₁ P₂ ih₁ ih₂ => rw [map_add]; exact (jetAlg {q₀, q₁}).add_mem ih₁ ih₂
    | mul_X P v ih => rw [map_mul, MvPolynomial.aeval_X]; exact (jetAlg {q₀, q₁}).mul_mem ih (h_var v)
  have h_base_to_alg : ∀ (j₀ : ℤ) (ι : Fin 2),
      (∃ (U₀ : Set (ℂ × ℂ)) (M D : ℕ) (Q : Fin (D + 1) → MvPolynomial (LineJetVar M) ℂ),
        IsOpen U₀ ∧ ((0 : ℂ), (0 : ℂ)) ∈ U₀ ∧
        (∀ p ∈ U₀,
          ∑ d : Fin (D + 1),
            MvPolynomial.eval (lineJetEnv M (F 0) (F b_z) p) (Q d) * (F j₀ ι p) ^ (d : ℕ) = 0) ∧
        (∃ q_w ∈ W_det_b,
          MvPolynomial.eval (lineJetEnv M (F 0) (F b_z) q_w) (Q (Fin.last D)) ≠ 0)) →
      ∀ m : ℤ, IsAlgebraic ↥(jetAlg {m, m + b_z}) (taylor2D (F (m + j₀) ι) (0, 0)) := by
    rintro j₀ ι ⟨U₀, M, D, Q, hU₀_open, hU₀_00, hQ_zero, ⟨q_w, hqw_mem, hqw_ne⟩⟩ m
    let Qm : Fin (D + 1) → MvPolynomial (LineJetVar (2 * M)) ℂ :=
      fun d => MvPolynomial.bind₁ (Ψ m M) (Q d)
    let U_all : Set (ℂ × ℂ) :=
      W m ∩ W (m + b_z) ∩ W (m + j₀) ∩ ((σ m) ⁻¹' U₀)
    have hU_all_open : IsOpen U_all :=
      (((hW_open m).inter (hW_open (m + b_z))).inter (hW_open (m + j₀))).inter
        (hU₀_open.preimage (hσ_cont m))
    have hU_all_00 : ((0 : ℂ), (0 : ℂ)) ∈ U_all :=
      ⟨⟨⟨hW_00 m, hW_00 (m + b_z)⟩, hW_00 (m + j₀)⟩, by simpa [σ] using hU₀_00⟩
    have henv_holo : ∀ (V : Set (ℂ × ℂ)), V ⊆ W m → V ⊆ W (m + b_z) → IsOpen V →
        ∀ v : LineJetVar (2 * M),
          DifferentiableOn ℂ (fun p => lineJetEnv (2 * M) (F m) (F (m + b_z)) p v) V := by
      intro V hV1 hV2 _hV v
      dsimp only [lineJetEnv]
      split_ifs
      · exact (k_iterYT_holo (hW_open m) (hF_holo m v.2.1) _ _).mono hV1
      · exact (k_iterYT_holo (hW_open (m + b_z)) (hF_holo (m + b_z) v.2.1) _ _).mono hV2
    have h_env_tay : ∀ (V : Set (ℂ × ℂ)), V ⊆ W m → V ⊆ W (m + b_z) →
        IsOpen V → ((0 : ℂ), (0 : ℂ)) ∈ V →
        ∀ R_poly : MvPolynomial (LineJetVar (2 * M)) ℂ,
          taylor2D (fun p => MvPolynomial.eval (lineJetEnv (2 * M) (F m) (F (m + b_z)) p) R_poly) (0, 0) =
            MvPolynomial.aeval (lineJetTay m (m + b_z) (2 * M)) R_poly := by
      intro V hV1 hV2 hV hV0 R_poly
      rw [h_taylor_eval hV hV0 _ (henv_holo V hV1 hV2 hV) R_poly]
      have hf_eq : (fun v => taylor2D (fun p => lineJetEnv (2 * M) (F m) (F (m + b_z)) p v) (0, 0)) =
          lineJetTay m (m + b_z) (2 * M) := by
        funext v; dsimp only [lineJetEnv, lineJetTay]; split_ifs <;> rfl
      rw [hf_eq]
    have h_vanish_U : ∀ p ∈ U_all,
        ∑ d : Fin (D + 1),
          MvPolynomial.eval (lineJetEnv (2 * M) (F m) (F (m + b_z)) p) (Qm d) *
            (F (m + j₀) ι p) ^ (d : ℕ) = 0 := by
      intro p ⟨⟨⟨hpm, hpmb⟩, _⟩, hpU₀⟩
      have hp0 : p ∈ W (0 + m) := by simpa using hpm
      have hp1 : p ∈ W (b_z + m) := by simpa [add_comm] using hpmb
      have h_eq :
          (∑ d : Fin (D + 1),
            MvPolynomial.eval (lineJetEnv (2 * M) (F m) (F (m + b_z)) p) (Qm d) *
              (F (m + j₀) ι p) ^ (d : ℕ)) =
          ∑ d : Fin (D + 1),
            MvPolynomial.eval (lineJetEnv M (F 0) (F b_z) (σ m p)) (Q d) *
              (F j₀ ι (σ m p)) ^ (d : ℕ) := by
        refine Finset.sum_congr rfl (fun d _ => ?_)
        have hb_sh := h_bind₁_shear m 0 b_z M (Q d) hp0 hp1
        simp only [zero_add, add_comm b_z m] at hb_sh
        have hF_sh : F (m + j₀) ι p = F j₀ ι (σ m p) := by
          simpa [add_comm] using (congr_fun (hF_comp j₀ m ι) p).symm
        rw [hb_sh, hF_sh]
      rw [h_eq]
      exact hQ_zero (σ m p) hpU₀
    have h_tay_zero :
        ∑ d : Fin (D + 1),
          MvPolynomial.aeval (lineJetTay m (m + b_z) (2 * M)) (Qm d) *
            (taylor2D (F (m + j₀) ι) (0, 0)) ^ (d : ℕ) = 0 := by
      have hsub1 : U_all ⊆ W m := fun _ hp => hp.1.1.1
      have hsub2 : U_all ⊆ W (m + b_z) := fun _ hp => hp.1.1.2
      have hsub3 : U_all ⊆ W (m + j₀) := fun _ hp => hp.1.2
      have h_sum0 : taylor2D (fun _ : ℂ × ℂ => (0 : ℂ)) (0, 0) = 0 := by
        simpa using (k_taylor_alg isOpen_univ (Set.mem_univ _)).1 0
      have h_congr := k_taylor2D_congr hU_all_open hU_all_00 h_vanish_U
      rw [h_sum0] at h_congr
      rw [h_taylor_sum_pow hU_all_open hU_all_00 _ _
        (fun d => h_eval_holo hU_all_open _ (henv_holo U_all hsub1 hsub2 hU_all_open) (Qm d))
        ((hF_holo (m + j₀) ι).mono hsub3)] at h_congr
      simpa only [h_env_tay U_all hsub1 hsub2 hU_all_open hU_all_00] using h_congr
    let P_alg : Polynomial ↥(jetAlg {m, m + b_z}) :=
      ∑ d : Fin (D + 1),
        Polynomial.monomial (d : ℕ)
          ⟨MvPolynomial.aeval (lineJetTay m (m + b_z) (2 * M)) (Qm d),
            h_aeval_lineJet_mem m (m + b_z) (2 * M) (Qm d)⟩
    refine ⟨P_alg, ?_, ?_⟩
    · intro hP0
      have hcD := congr_arg (fun R : Polynomial ↥(jetAlg {m, m + b_z}) => (R.coeff D : MvPowerSeries (Fin 2) ℂ)) hP0
      have h_coeffD : (P_alg.coeff D : MvPowerSeries (Fin 2) ℂ) =
          MvPolynomial.aeval (lineJetTay m (m + b_z) (2 * M)) (Qm (Fin.last D)) := by
        simp only [P_alg, Polynomial.finsetSum_coeff, Polynomial.coeff_monomial,
          AddSubmonoidClass.coe_finsetSum]
        rw [Finset.sum_eq_single (Fin.last D)]
        · simp [Fin.last]
        · intro d _ hd_ne
          have hval_ne : (d : ℕ) ≠ D := fun hv => hd_ne (Fin.ext hv)
          simp [hval_ne]
        · intro h_abs; exact False.elim (h_abs (Finset.mem_univ _))
      rw [h_coeffD, Polynomial.coeff_zero, ZeroMemClass.coe_zero] at hcD
      let V_chk : Set (ℂ × ℂ) := W m ∩ W (m + b_z)
      have hV_chk_open : IsOpen V_chk := (hW_open m).inter (hW_open (m + b_z))
      have hV_chk_pre : IsPreconnected V_chk := ((hW_conv m).inter (hW_conv (m + b_z))).isPreconnected
      have hV_chk_00 : ((0 : ℂ), (0 : ℂ)) ∈ V_chk := ⟨hW_00 m, hW_00 (m + b_z)⟩
      rw [← h_env_tay V_chk Set.inter_subset_left Set.inter_subset_right hV_chk_open hV_chk_00] at hcD
      have h_zero_on := k_eqOn_taylor0 hV_chk_open hV_chk_pre hV_chk_00
        (h_eval_holo hV_chk_open _ (henv_holo V_chk Set.inter_subset_left Set.inter_subset_right hV_chk_open) (Qm (Fin.last D)))
        hcD
      let p_w : ℂ × ℂ := σ (-m) q_w
      have hqw_0 : q_w ∈ W 0 := hW_det_sub 0 (by simp) hqw_mem
      have hqw_b : q_w ∈ W b_z := hW_det_sub b_z (by simp [b_z]) hqw_mem
      have hpw_m : p_w ∈ W m := by
        change σ m p_w ∈ U_det2
        simpa [p_w, hσ_inv, W, σ] using hqw_0
      have hpw_mb : p_w ∈ W (m + b_z) := by
        change σ (m + b_z) p_w ∈ U_det2
        rw [add_comm, ← hσ_comp, show σ m p_w = q_w from hσ_inv m q_w]
        exact hqw_b
      have h_eval0 := h_zero_on p_w ⟨hpw_m, hpw_mb⟩
      have hb_sh := h_bind₁_shear m 0 b_z M (Q (Fin.last D)) (by simpa using hpw_m)
        (by simpa [add_comm] using hpw_mb)
      simp only [zero_add, add_comm b_z m] at hb_sh
      rw [hb_sh, show σ m p_w = q_w from hσ_inv m q_w] at h_eval0
      exact hqw_ne h_eval0
    · simp only [P_alg, map_sum, Polynomial.aeval_monomial]
      exact h_tay_zero
  have hStep : ∀ (m : ℤ) (ι : Fin 2),
      IsAlgebraic ↥(jetAlg {m, m + b_z}) (taylor2D (F (m - 1) ι) (0, 0)) ∧
      IsAlgebraic ↥(jetAlg {m, m + b_z}) (taylor2D (F (m + b_z - 1) ι) (0, 0)) := by
    intro m ι
    have h_env_eq : ∀ (M : ℕ) (p : ℂ × ℂ),
        lineJetEnv M
          (fun c q => glancingDualLine C q.1 q.2 c)
          (fun c q => glancingDualLine C (q.1 + (b_nat : ℂ) * q.2) q.2 c) p =
        lineJetEnv M (F 0) (F b_z) p := by
      intro M p; funext v; simp [lineJetEnv, F, b_z]
    constructor
    · obtain ⟨M₂, D₂, _hD₂, Q₂, _Disc₂, hQ₂_eq, ⟨yw, tw, hyw, htw, hQw_ne, _⟩, _⟩ :=
        hDet.line_determination b_nat (by dsimp [b_nat]; omega) 1 (by omega) (by dsimp [b_nat]; omega) ι
      let q_idx₀ : Fin 3 → ℤ := ![0, b_z, -b_z]
      have hsym₀ : ∀ a : Fin 3, (q_idx₀ a ≤ 0 ∨ K < (q_idx₀ a).natAbs) ∧
          ∃ b' : Fin 3, q_idx₀ b' = -q_idx₀ a := by
        intro a
        fin_cases a <;> dsimp only
        · exact ⟨Or.inl (by simp [q_idx₀]), 0, by simp [q_idx₀]⟩
        · refine ⟨Or.inr ?_, 2, by simp [q_idx₀]⟩
          change K < ((K + 2 : ℕ) : ℤ).natAbs
          rw [Int.natAbs_natCast]; omega
        · refine ⟨Or.inl ?_, 1, by simp [q_idx₀]⟩
          simp [q_idx₀, b_z, b_nat]
      let emb₀ : LineJetVar M₂ → SymJetVar 3 M₂ :=
        fun v => (if v.1 = 0 then 0 else 1, v.2.1, v.2.2.1, v.2.2.2)
      let Q₂' : Fin (D₂ + 1) → MvPolynomial (SymJetVar 3 M₂) ℂ :=
        fun d => MvPolynomial.rename emb₀ (Q₂ d)
      have h_ren₀ : ∀ (p : ℂ × ℂ) (d : Fin (D₂ + 1)),
          MvPolynomial.eval (symJetEnv C q_idx₀ M₂ p) (Q₂' d) =
            MvPolynomial.eval (lineJetEnv M₂ (F 0) (F b_z) p) (Q₂ d) := by
        intro p d
        rw [MvPolynomial.eval_rename]
        have hf_eq : (symJetEnv C q_idx₀ M₂ p) ∘ emb₀ = lineJetEnv M₂ (F 0) (F b_z) p := by
          funext v
          dsimp only [Function.comp_apply, emb₀, symJetEnv, lineJetEnv, F]
          split_ifs with hv <;> simp [q_idx₀]
        rw [hf_eq]
      let J_bound₀ : ℝ := ((Finset.univ.sup fun a : Fin 3 => (q_idx₀ a).natAbs : ℕ) : ℝ) + 2
      let V_dom₀ : Set (ℂ × ℂ) :=
        { p : ℂ × ℂ | |p.1.im| < s_b / 2 ∧ ‖p.2‖ < r_b ∧ |p.2.im| < s_b / (2 * J_bound₀) }
      obtain ⟨hVd₀_open, hVd₀_pre, hVd₀_00, hVd₀_sub⟩ := hVdom_props q_idx₀
      have h_holo_sum1 : DifferentiableOn ℂ
          (fun p => ∑ d : Fin (D₂ + 1),
            MvPolynomial.eval (symJetEnv C q_idx₀ M₂ p) (Q₂' d) *
              (glancingDualLine C (p.1 + p.2) p.2 ι) ^ (d : ℕ)) V_dom₀ := by
        refine h_holo_sum Finset.univ _ (fun d _ => ?_)
        have h_env_v : ∀ v : SymJetVar 3 M₂,
            DifferentiableOn ℂ (fun p => symJetEnv C q_idx₀ M₂ p v) V_dom₀ := by
          intro v
          have hle : ((q_idx₀ v.1).natAbs : ℝ) ≤ J_bound₀ := by
            have h1 : (q_idx₀ v.1).natAbs ≤ Finset.univ.sup fun a : Fin 3 => (q_idx₀ a).natAbs :=
              Finset.le_sup (f := fun a : Fin 3 => (q_idx₀ a).natAbs) (Finset.mem_univ v.1)
            have h2 : ((q_idx₀ v.1).natAbs : ℝ) ≤
                ((Finset.univ.sup fun a : Fin 3 => (q_idx₀ a).natAbs : ℕ) : ℝ) := by exact_mod_cast h1
            dsimp [J_bound₀]; linarith
          exact (k_iterYT_holo (hW_open _) (hF_holo (q_idx₀ v.1) v.2.1) _ _).mono
            (hVd₀_sub _ hle)
        have hF1 : DifferentiableOn ℂ (fun p : ℂ × ℂ => glancingDualLine C (p.1 + p.2) p.2 ι) V_dom₀ := by
          have h1_eq : (fun p : ℂ × ℂ => glancingDualLine C (p.1 + p.2) p.2 ι) = F 1 ι := by
            funext p; simp [F]
          rw [h1_eq]
          have h1_le : ((1 : ℤ).natAbs : ℝ) ≤ J_bound₀ := by
            have h0_nn : (0 : ℝ) ≤ ((Finset.univ.sup fun a : Fin 3 => (q_idx₀ a).natAbs : ℕ) : ℝ) :=
              Nat.cast_nonneg _
            dsimp [J_bound₀]; norm_num; linarith
          exact (hF_holo 1 ι).mono (hVd₀_sub 1 h1_le)
        exact h_holo_mul (h_eval_holo hVd₀_open _ h_env_v (Q₂' d)) (h_holo_pow hF1 (d : ℕ))
      have h_on_inter : ∀ p ∈ V_dom₀ ∩ W_det_b,
          ∑ d : Fin (D₂ + 1),
            MvPolynomial.eval (symJetEnv C q_idx₀ M₂ p) (Q₂' d) *
              (glancingDualLine C (p.1 + p.2) p.2 ι) ^ (d : ℕ) = 0 := by
        intro p ⟨_, hp_det⟩
        have h1 := hQ₂_eq p.1 p.2 hp_det.1 hp_det.2
        simpa [h_ren₀, h_env_eq] using h1
      have h_on_Vdom₀ : ∀ p ∈ V_dom₀,
          ∑ d : Fin (D₂ + 1),
            MvPolynomial.eval (symJetEnv C q_idx₀ M₂ p) (Q₂' d) *
              (glancingDualLine C (p.1 + p.2) p.2 ι) ^ (d : ℕ) = 0 :=
        k_eqOn_preconn hVd₀_open hVd₀_pre
          (hVd₀_open.inter hW_det_open) ⟨(0, 0), hVd₀_00, hW_det_00⟩
          Set.inter_subset_left h_holo_sum1 h_on_inter
      have h_refl₀ := hRefl 3 M₂ D₂ q_idx₀ ι Q₂' hsym₀ h_on_Vdom₀
      have h_neg1 : m + (-1 : ℤ) = m - 1 := by ring
      rw [← h_neg1]
      refine h_base_to_alg (-1) ι ⟨V_dom₀, M₂, D₂, Q₂, hVd₀_open, hVd₀_00, ?_, ?_⟩ m
      · intro p hp
        have hr := h_refl₀ p hp
        have hFm1 : ∀ q : ℂ × ℂ, F (-1) ι q = glancingDualLine C (q.1 - q.2) q.2 ι := by
          intro q; simp [F, sub_eq_add_neg]
        simpa only [h_ren₀, hFm1] using hr
      · refine ⟨(yw, tw), ⟨hyw, htw⟩, ?_⟩
        simpa only [h_env_eq] using hQw_ne
    · obtain ⟨M₁, D₁, _hD₁, Q₁, _Disc₁, hQ₁_eq, ⟨yw, tw, hyw, htw, hQw_ne, _⟩, _⟩ :=
        hDet.line_determination b_nat (by dsimp [b_nat]; omega) (K + 1) (by omega) (by dsimp [b_nat]; omega) ι
      have h_b1 : m + ((K + 1 : ℕ) : ℤ) = m + b_z - 1 := by dsimp [b_z, b_nat]; ring
      rw [← h_b1]
      refine h_base_to_alg ((K + 1 : ℕ) : ℤ) ι ⟨W_det_b, M₁, D₁, Q₁, hW_det_open, hW_det_00, ?_, ?_⟩ m
      · intro p ⟨hp1, hp2⟩
        have h1 := hQ₁_eq p.1 p.2 hp1 hp2
        simpa only [h_env_eq, F, Int.cast_natCast] using h1
      · refine ⟨(yw, tw), ⟨hyw, htw⟩, ?_⟩
        simpa only [h_env_eq] using hQw_ne

  
  have hReflStep : ∀ (M_star D_star : ℕ)
      (Q_star : Fin (D_star + 1) → MvPolynomial (LineJetVar M_star) ℂ) (n : ℕ),
      (∑ d : Fin (D_star + 1),
        MvPolynomial.aeval (lineJetTay B_z (B_z + b_z) M_star) (Q_star d) *
          (taylor2D (F (1 - 2 * (n : ℤ)) ι_star) (0, 0)) ^ (d : ℕ) = 0) →
      (∑ d : Fin (D_star + 1),
        MvPolynomial.aeval (lineJetTay B_z (B_z + b_z) M_star) (Q_star d) *
          (taylor2D (F (1 - 2 * ((n + 1 : ℕ) : ℤ)) ι_star) (0, 0)) ^ (d : ℕ) = 0) := by
    intro M_star D_star Q_star n h_root_n
    let U_n : Set (ℂ × ℂ) := W B_z ∩ W (B_z + b_z) ∩ W (1 - 2 * (n : ℤ))
    have hUn_open : IsOpen U_n :=
      ((hW_open B_z).inter (hW_open (B_z + b_z))).inter (hW_open (1 - 2 * (n : ℤ)))
    have hUn_pre : IsPreconnected U_n :=
      (((hW_conv B_z).inter (hW_conv (B_z + b_z))).inter (hW_conv (1 - 2 * (n : ℤ)))).isPreconnected
    have hUn_00 : ((0 : ℂ), (0 : ℂ)) ∈ U_n :=
      ⟨⟨hW_00 B_z, hW_00 (B_z + b_z)⟩, hW_00 (1 - 2 * (n : ℤ))⟩
    have henv_B : ∀ {V : Set (ℂ × ℂ)}, V ⊆ W B_z → V ⊆ W (B_z + b_z) →
        ∀ v : LineJetVar M_star,
          DifferentiableOn ℂ (fun p => lineJetEnv M_star (F B_z) (F (B_z + b_z)) p v) V := by
      intro V hV1 hV2 v
      dsimp only [lineJetEnv]
      split_ifs
      · exact (k_iterYT_holo (hW_open _) (hF_holo B_z v.2.1) _ _).mono hV1
      · exact (k_iterYT_holo (hW_open _) (hF_holo (B_z + b_z) v.2.1) _ _).mono hV2
    have h_env_B_tay : ∀ {V : Set (ℂ × ℂ)}, V ⊆ W B_z → V ⊆ W (B_z + b_z) →
        IsOpen V → ((0 : ℂ), (0 : ℂ)) ∈ V →
        ∀ R_poly : MvPolynomial (LineJetVar M_star) ℂ,
          taylor2D (fun p => MvPolynomial.eval (lineJetEnv M_star (F B_z) (F (B_z + b_z)) p) R_poly) (0, 0) =
            MvPolynomial.aeval (lineJetTay B_z (B_z + b_z) M_star) R_poly := by
      intro V hV1 hV2 hV hV0 R_poly
      rw [h_taylor_eval hV hV0 _ (henv_B hV1 hV2) R_poly]
      have hf_eq : (fun v => taylor2D (fun p => lineJetEnv M_star (F B_z) (F (B_z + b_z)) p v) (0, 0)) =
          lineJetTay B_z (B_z + b_z) M_star := by
        funext v; dsimp only [lineJetEnv, lineJetTay]; split_ifs <;> rfl
      rw [hf_eq]
    let G_n : ℂ × ℂ → ℂ := fun p =>
      ∑ d : Fin (D_star + 1),
        MvPolynomial.eval (lineJetEnv M_star (F B_z) (F (B_z + b_z)) p) (Q_star d) *
          (F (1 - 2 * (n : ℤ)) ι_star p) ^ (d : ℕ)
    have hGn_holo : DifferentiableOn ℂ G_n U_n := by
      refine h_holo_sum Finset.univ _ (fun d _ => ?_)
      exact h_holo_mul
        (h_eval_holo hUn_open _ (henv_B (fun _ hp => hp.1.1) (fun _ hp => hp.1.2)) (Q_star d))
        (h_holo_pow ((hF_holo (1 - 2 * (n : ℤ)) ι_star).mono (fun _ hp => hp.2)) (d : ℕ))
    have hGn_tay : taylor2D G_n (0, 0) = 0 := by
      rw [h_taylor_sum_pow hUn_open hUn_00 _ _
        (fun d => h_eval_holo hUn_open _ (henv_B (fun _ hp => hp.1.1) (fun _ hp => hp.1.2)) (Q_star d))
        ((hF_holo _ _).mono (fun _ hp => hp.2))]
      simpa only [h_env_B_tay (fun _ hp => hp.1.1) (fun _ hp => hp.1.2) hUn_open hUn_00] using h_root_n
    have hGn_zero : ∀ p ∈ U_n, G_n p = 0 :=
      k_eqOn_taylor0 hUn_open hUn_pre hUn_00 hGn_holo hGn_tay
    let q_idx_n : Fin 4 → ℤ :=
      ![B_z + 2 * (n : ℤ), -(B_z + 2 * (n : ℤ)),
        B_z + b_z + 2 * (n : ℤ), -(B_z + b_z + 2 * (n : ℤ))]
    have hsym_n : ∀ a : Fin 4, (q_idx_n a ≤ 0 ∨ K < (q_idx_n a).natAbs) ∧
        ∃ b' : Fin 4, q_idx_n b' = -q_idx_n a := by
      intro a
      fin_cases a <;> dsimp only
      · refine ⟨Or.inr ?_, 1, by simp [q_idx_n]⟩
        change K < (q_idx_n 0).natAbs
        have hq0 : q_idx_n 0 = ((K + 3 + 2 * n : ℕ) : ℤ) := by
          simp [q_idx_n, B_z, B_nat]
        rw [hq0, Int.natAbs_natCast]; omega
      · refine ⟨Or.inl ?_, 0, by simp [q_idx_n]⟩
        dsimp [q_idx_n, B_z, B_nat]; omega
      · refine ⟨Or.inr ?_, 3, by simp [q_idx_n]⟩
        change K < (q_idx_n 2).natAbs
        have hq2 : q_idx_n 2 = ((K + 3 + (K + 2) + 2 * n : ℕ) : ℤ) := by
          simp [q_idx_n, B_z, B_nat, b_z, b_nat]
        rw [hq2, Int.natAbs_natCast]; omega
      · refine ⟨Or.inl ?_, 2, by simp [q_idx_n]⟩
        dsimp [q_idx_n, B_z, B_nat, b_z, b_nat]; omega
    let emb_n : LineJetVar (2 * M_star) → SymJetVar 4 (2 * M_star) :=
      fun v => (if v.1 = 0 then 0 else 2, v.2.1, v.2.2.1, v.2.2.2)
    let Q_tilde : Fin (D_star + 1) → MvPolynomial (SymJetVar 4 (2 * M_star)) ℂ :=
      fun d => MvPolynomial.rename emb_n (MvPolynomial.bind₁ (Ψ (2 * (n : ℤ)) M_star) (Q_star d))
    have h_ren_n : ∀ (p : ℂ × ℂ) (d : Fin (D_star + 1)),
        p ∈ W (B_z + 2 * (n : ℤ)) → p ∈ W (B_z + b_z + 2 * (n : ℤ)) →
        MvPolynomial.eval (symJetEnv C q_idx_n (2 * M_star) p) (Q_tilde d) =
          MvPolynomial.eval (lineJetEnv M_star (F B_z) (F (B_z + b_z)) (σ (2 * (n : ℤ)) p)) (Q_star d) := by
      intro p d hp0 hp2
      rw [MvPolynomial.eval_rename]
      have h_comp_env : (symJetEnv C q_idx_n (2 * M_star) p) ∘ emb_n =
          lineJetEnv (2 * M_star) (F (B_z + 2 * (n : ℤ))) (F (B_z + b_z + 2 * (n : ℤ))) p := by
        funext v
        dsimp only [Function.comp_apply, emb_n, symJetEnv, lineJetEnv, F]
        split_ifs with hv <;> simp [q_idx_n]
      rw [h_comp_env]
      exact h_bind₁_shear (2 * (n : ℤ)) B_z (B_z + b_z) M_star (Q_star d) hp0 hp2
    let J_bound_n : ℝ := ((Finset.univ.sup fun a : Fin 4 => (q_idx_n a).natAbs : ℕ) : ℝ) + 2
    let V_dom_n : Set (ℂ × ℂ) :=
      { p : ℂ × ℂ | |p.1.im| < s_b / 2 ∧ ‖p.2‖ < r_b ∧ |p.2.im| < s_b / (2 * J_bound_n) }
    obtain ⟨hVdn_open, hVdn_pre, hVdn_00, hVdn_sub⟩ := hVdom_props q_idx_n
    have h_q_le : ∀ a : Fin 4, ((q_idx_n a).natAbs : ℝ) ≤ J_bound_n := by
      intro a
      have h1 : (q_idx_n a).natAbs ≤ Finset.univ.sup fun b' : Fin 4 => (q_idx_n b').natAbs :=
        Finset.le_sup (f := fun b' : Fin 4 => (q_idx_n b').natAbs) (Finset.mem_univ a)
      have h2 : ((q_idx_n a).natAbs : ℝ) ≤
          ((Finset.univ.sup fun b' : Fin 4 => (q_idx_n b').natAbs : ℕ) : ℝ) := by exact_mod_cast h1
      dsimp [J_bound_n]; linarith
    have h_holo_Vdn : DifferentiableOn ℂ
        (fun p => ∑ d : Fin (D_star + 1),
          MvPolynomial.eval (symJetEnv C q_idx_n (2 * M_star) p) (Q_tilde d) *
            (glancingDualLine C (p.1 + p.2) p.2 ι_star) ^ (d : ℕ)) V_dom_n := by
      refine h_holo_sum Finset.univ _ (fun d _ => ?_)
      have h_env_v : ∀ v : SymJetVar 4 (2 * M_star),
          DifferentiableOn ℂ (fun p => symJetEnv C q_idx_n (2 * M_star) p v) V_dom_n := fun v =>
        (k_iterYT_holo (hW_open _) (hF_holo (q_idx_n v.1) v.2.1) _ _).mono
          (hVdn_sub _ (h_q_le v.1))
      have hF1 : DifferentiableOn ℂ (fun p : ℂ × ℂ => glancingDualLine C (p.1 + p.2) p.2 ι_star) V_dom_n := by
        have h1_eq : (fun p : ℂ × ℂ => glancingDualLine C (p.1 + p.2) p.2 ι_star) = F 1 ι_star := by
          funext p; simp [F]
        rw [h1_eq]
        have h1_le : ((1 : ℤ).natAbs : ℝ) ≤ J_bound_n := by
          have h0_nn : (0 : ℝ) ≤ ((Finset.univ.sup fun a : Fin 4 => (q_idx_n a).natAbs : ℕ) : ℝ) :=
            Nat.cast_nonneg _
          dsimp [J_bound_n]; norm_num; linarith
        exact (hF_holo 1 ι_star).mono (hVdn_sub 1 h1_le)
      exact h_holo_mul (h_eval_holo hVdn_open _ h_env_v (Q_tilde d)) (h_holo_pow hF1 (d : ℕ))
    let V_ov : Set (ℂ × ℂ) := V_dom_n ∩ ((σ (2 * (n : ℤ))) ⁻¹' U_n)
    have hVov_open : IsOpen V_ov := hVdn_open.inter (hUn_open.preimage (hσ_cont _))
    have hVov_00 : ((0 : ℂ), (0 : ℂ)) ∈ V_ov := by
      refine ⟨hVdn_00, ?_⟩
      change σ (2 * (n : ℤ)) (0, 0) ∈ U_n
      have h0 : σ (2 * (n : ℤ)) (0, 0) = (0, 0) := by ext <;> simp [σ]
      rw [h0]; exact hUn_00
    have h_on_Vov : ∀ p ∈ V_ov,
        ∑ d : Fin (D_star + 1),
          MvPolynomial.eval (symJetEnv C q_idx_n (2 * M_star) p) (Q_tilde d) *
            (glancingDualLine C (p.1 + p.2) p.2 ι_star) ^ (d : ℕ) = 0 := by
      intro p ⟨hp_vd, hp_un⟩
      have hp0 : p ∈ W (B_z + 2 * (n : ℤ)) := hVdn_sub _ (h_q_le 0) hp_vd
      have hp2 : p ∈ W (B_z + b_z + 2 * (n : ℤ)) := hVdn_sub _ (h_q_le 2) hp_vd
      have hF1_eq : glancingDualLine C (p.1 + p.2) p.2 ι_star =
          F (1 - 2 * (n : ℤ)) ι_star (σ (2 * (n : ℤ)) p) := by
        have hc := congr_fun (hF_comp (1 - 2 * (n : ℤ)) (2 * (n : ℤ)) ι_star) p
        have h_add : (1 - 2 * (n : ℤ)) + 2 * (n : ℤ) = 1 := by ring
        rw [h_add] at hc
        simpa [F] using hc.symm
      have h_eq :
          (∑ d : Fin (D_star + 1),
            MvPolynomial.eval (symJetEnv C q_idx_n (2 * M_star) p) (Q_tilde d) *
              (glancingDualLine C (p.1 + p.2) p.2 ι_star) ^ (d : ℕ)) =
          G_n (σ (2 * (n : ℤ)) p) := by
        refine Finset.sum_congr rfl (fun d _ => ?_)
        rw [h_ren_n p d hp0 hp2, hF1_eq]
      rw [h_eq]
      exact hGn_zero _ hp_un
    have h_on_Vdn := k_eqOn_preconn hVdn_open hVdn_pre
      hVov_open ⟨(0, 0), hVov_00⟩ Set.inter_subset_left h_holo_Vdn h_on_Vov
    have h_refl_n := hRefl 4 (2 * M_star) D_star q_idx_n ι_star Q_tilde hsym_n h_on_Vdn
    let U_next : Set (ℂ × ℂ) :=
      W B_z ∩ W (B_z + b_z) ∩ W (1 - 2 * ((n + 1 : ℕ) : ℤ)) ∩
        ((σ (-(2 * (n : ℤ)))) ⁻¹' V_dom_n)
    have hUnext_open : IsOpen U_next :=
      (((hW_open B_z).inter (hW_open (B_z + b_z))).inter
        (hW_open (1 - 2 * ((n + 1 : ℕ) : ℤ)))).inter (hVdn_open.preimage (hσ_cont _))
    have hUnext_00 : ((0 : ℂ), (0 : ℂ)) ∈ U_next := by
      refine ⟨⟨⟨hW_00 B_z, hW_00 (B_z + b_z)⟩, hW_00 _⟩, ?_⟩
      change σ (-(2 * (n : ℤ))) (0, 0) ∈ V_dom_n
      have h0 : σ (-(2 * (n : ℤ))) (0, 0) = (0, 0) := by ext <;> simp [σ]
      rw [h0]; exact hVdn_00
    have hGnext_zero : ∀ q ∈ U_next,
        ∑ d : Fin (D_star + 1),
          MvPolynomial.eval (lineJetEnv M_star (F B_z) (F (B_z + b_z)) q) (Q_star d) *
            (F (1 - 2 * ((n + 1 : ℕ) : ℤ)) ι_star q) ^ (d : ℕ) = 0 := by
      intro q ⟨_, hq_pre⟩
      let p : ℂ × ℂ := σ (-(2 * (n : ℤ))) q
      have hp_vd : p ∈ V_dom_n := hq_pre
      have hr := h_refl_n p hp_vd
      have hp0 : p ∈ W (B_z + 2 * (n : ℤ)) := hVdn_sub _ (h_q_le 0) hp_vd
      have hp2 : p ∈ W (B_z + b_z + 2 * (n : ℤ)) := hVdn_sub _ (h_q_le 2) hp_vd
      have hFm1_eq : glancingDualLine C (p.1 - p.2) p.2 ι_star =
          F (1 - 2 * ((n + 1 : ℕ) : ℤ)) ι_star q := by
        have hc := congr_fun (hF_comp (-1) (-(2 * (n : ℤ))) ι_star) q
        have h_add : (-1 : ℤ) + -(2 * (n : ℤ)) = 1 - 2 * ((n + 1 : ℕ) : ℤ) := by
          push_cast; ring
        rw [h_add] at hc
        simpa [p, F, sub_eq_add_neg] using hc
      have h_eq :
          (∑ d : Fin (D_star + 1),
            MvPolynomial.eval (lineJetEnv M_star (F B_z) (F (B_z + b_z)) q) (Q_star d) *
              (F (1 - 2 * ((n + 1 : ℕ) : ℤ)) ι_star q) ^ (d : ℕ)) =
          ∑ d : Fin (D_star + 1),
            MvPolynomial.eval (symJetEnv C q_idx_n (2 * M_star) p) (Q_tilde d) *
              (glancingDualLine C (p.1 - p.2) p.2 ι_star) ^ (d : ℕ) := by
        refine Finset.sum_congr rfl (fun d _ => ?_)
        rw [h_ren_n p d hp0 hp2, show σ (2 * (n : ℤ)) p = q from hσ_inv (2 * (n : ℤ)) q, hFm1_eq]
      rw [h_eq]
      exact hr
    have hsub1 : U_next ⊆ W B_z := fun _ hq => hq.1.1.1
    have hsub2 : U_next ⊆ W (B_z + b_z) := fun _ hq => hq.1.1.2
    have hsub3 : U_next ⊆ W (1 - 2 * ((n + 1 : ℕ) : ℤ)) := fun _ hq => hq.1.2
    have h_sum0 : taylor2D (fun _ : ℂ × ℂ => (0 : ℂ)) (0, 0) = 0 := by
      simpa using (k_taylor_alg isOpen_univ (Set.mem_univ _)).1 0
    have h_congr := k_taylor2D_congr hUnext_open hUnext_00 hGnext_zero
    rw [h_sum0] at h_congr
    rw [h_taylor_sum_pow hUnext_open hUnext_00 _ _
      (fun d => h_eval_holo hUnext_open _ (henv_B hsub1 hsub2) (Q_star d))
      ((hF_holo _ _).mono hsub3)] at h_congr
    simpa only [h_env_B_tay hsub1 hsub2 hUnext_open hUnext_00] using h_congr

  
  have : IsDomain (MvPowerSeries (Fin 2) ℂ) :=
    NoZeroDivisors.to_isDomain (MvPowerSeries (Fin 2) ℂ)
  have h_mvA_const : ∀ c : ℂ, mvDerivA (algebraMap ℂ (MvPowerSeries (Fin 2) ℂ) c) = 0 := by
    intro c
    funext d
    have hne : d + Finsupp.single 0 1 ≠ 0 := by
      intro h0
      have := Finsupp.ext_iff.mp h0 0
      simp at this
    change ((d 0 + 1 : ℕ) : ℂ) *
      MvPowerSeries.coeff (d + Finsupp.single 0 1) (algebraMap ℂ _ c) = 0
    simp [MvPowerSeries.algebraMap_apply, MvPowerSeries.coeff_C, hne]
  have h_mvD_const : ∀ c : ℂ, mvDerivD (algebraMap ℂ (MvPowerSeries (Fin 2) ℂ) c) = 0 := by
    intro c
    funext d
    have hne : d + Finsupp.single 1 1 ≠ 0 := by
      intro h0
      have := Finsupp.ext_iff.mp h0 1
      simp at this
    change ((d 1 + 1 : ℕ) : ℂ) *
      MvPowerSeries.coeff (d + Finsupp.single 1 1) (algebraMap ℂ _ c) = 0
    simp [MvPowerSeries.algebraMap_apply, MvPowerSeries.coeff_C, hne]
  have h_jet_step : ∀ (j : ℤ) (ι : Fin 2) (α β : ℕ),
      mvDerivA (taylor2D (iterDerivYT α β (F j ι)) (0, 0)) =
        taylor2D (iterDerivYT (α + 1) β (F j ι)) (0, 0) ∧
      mvDerivD (taylor2D (iterDerivYT α β (F j ι)) (0, 0)) =
        taylor2D (iterDerivYT α (β + 1) (F j ι)) (0, 0) := by
    intro j ι α β
    have h_it_holo := k_iterYT_holo (hW_open j) (hF_holo j ι) α β
    obtain ⟨hmA, hmD⟩ := k_mv_taylor (hW_open j) (hW_00 j) h_it_holo
    constructor
    · rw [hmA]
      exact k_taylor2D_congr (hW_open j) (hW_00 j) (fun p hp =>
        (k_iterYT_step (hW_open j) (hF_holo j ι) α β p hp).2.2.1)
    · rw [hmD]
      exact k_taylor2D_congr (hW_open j) (hW_00 j) (fun p hp =>
        (k_iterYT_step (hW_open j) (hF_holo j ι) α β p hp).2.2.2)
  have h_deriv_alg : ∀ (D : MvPowerSeries (Fin 2) ℂ → MvPowerSeries (Fin 2) ℂ),
      (∀ Φ Ψ, D (Φ + Ψ) = D Φ + D Ψ) →
      (∀ Φ Ψ, D (Φ * Ψ) = D Φ * Ψ + Φ * D Ψ) →
      (∀ c : ℂ, D (algebraMap ℂ (MvPowerSeries (Fin 2) ℂ) c) = 0) →
      (∀ (I : Set ℤ), ∀ Φ ∈ jetSet I, D Φ ∈ jetSet I) →
      ∀ (I : Set ℤ) (x : MvPowerSeries (Fin 2) ℂ),
        IsAlgebraic ↥(jetAlg I) x → IsAlgebraic ↥(jetAlg I) (D x) := by
    intro D hD_add hD_mul hD_const hD_jet I x hx
    let A := jetAlg I
    have : IsDomain ↥A := Subalgebra.isDomain A
    have hD0 : D 0 = 0 := by simpa using hD_const 0
    have hD_mem : ∀ a ∈ A, D a ∈ A := by
      intro a ha
      refine Algebra.adjoin_induction ?_ ?_ ?_ ?_ ha
      · intro y hy; exact Algebra.subset_adjoin (hD_jet I y hy)
      · intro r; rw [hD_const r]; exact A.zero_mem
      · intro y₁ y₂ _ _ ih₁ ih₂; rw [hD_add]; exact A.add_mem ih₁ ih₂
      · intro y₁ y₂ hy₁ hy₂ ih₁ ih₂; rw [hD_mul]; exact A.add_mem (A.mul_mem ih₁ hy₂) (A.mul_mem hy₁ ih₂)
    have hD_sum : ∀ {α : Type} (s : Finset α) (g : α → MvPowerSeries (Fin 2) ℂ),
        D (∑ i ∈ s, g i) = ∑ i ∈ s, D (g i) := by
      intro α s g
      classical
      induction s using Finset.induction_on with
      | empty => simp [hD0]
      | insert a s ha ih => simp [Finset.sum_insert ha, hD_add, ih]
    have hD_pow : ∀ (z : MvPowerSeries (Fin 2) ℂ) (n : ℕ),
        D (z ^ n) = (n : MvPowerSeries (Fin 2) ℂ) * z ^ (n - 1) * D z := by
      have hD1 : D 1 = 0 := by simpa only [map_one] using hD_const 1
      intro z n
      induction n with
      | zero => simp [hD1]
      | succ k ih =>
        cases k with
        | zero => simp
        | succ m =>
          rw [pow_succ z (m + 1), hD_mul, ih]
          simp only [Nat.add_sub_cancel]
          push_cast
          ring
    classical
    let Pred : ℕ → Prop := fun n =>
      ∃ P : Polynomial ↥A, P ≠ 0 ∧ P.natDegree = n ∧ Polynomial.aeval x P = 0
    obtain ⟨P₀, hP₀_ne, hP₀_ev⟩ := id hx
    have h_ex : ∃ n : ℕ, Pred n := ⟨P₀.natDegree, P₀, hP₀_ne, rfl, hP₀_ev⟩
    let N := Nat.find h_ex
    obtain ⟨P, hP_ne, hP_deg, hP_ev⟩ := Nat.find_spec h_ex
    change P.natDegree = N at hP_deg
    have hN_ne : N ≠ 0 := by
      intro hN0
      have hP_C := Polynomial.eq_C_of_natDegree_eq_zero (hP_deg.trans hN0)
      rw [hP_C, Polynomial.aeval_C] at hP_ev
      apply hP_ne
      rw [hP_C]
      have hc0 : P.coeff 0 = 0 := Subtype.ext hP_ev
      simp [hc0]
    let P' : Polynomial ↥A := Polynomial.derivative P
    have hP'_ne : P' ≠ 0 := by
      intro hP'0
      have h_coeff := congr_arg (fun Q : Polynomial ↥A => Q.coeff (N - 1)) hP'0
      simp only [P', Polynomial.coeff_derivative, Polynomial.coeff_zero] at h_coeff
      have hN1 : N - 1 + 1 = N := Nat.sub_add_cancel (Nat.pos_of_ne_zero hN_ne)
      have hN_cast : ((N - 1 : ℕ) + 1 : ↥A) = (N : ↥A) := by
        calc
          ((N - 1 : ℕ) + 1 : ↥A) = (((N - 1) + 1 : ℕ) : ↥A) := by push_cast; rfl
          _ = (N : ↥A) := by rw [hN1]
      rw [hN1, hN_cast] at h_coeff
      have h_lead : P.coeff N ≠ 0 := by
        rw [← hP_deg]
        exact Polynomial.leadingCoeff_ne_zero.mpr hP_ne
      have hN_ne_A : (N : ↥A) ≠ 0 := by
        intro h0
        let φ : ↥A →+* ℂ :=
          (@MvPowerSeries.constantCoeff (Fin 2) ℂ _).comp A.val.toRingHom
        have h_c0 := congr_arg φ h0
        simp only [map_natCast, map_zero, Nat.cast_eq_zero] at h_c0
        exact hN_ne h_c0
      exact mul_ne_zero h_lead hN_ne_A h_coeff
    have hP'_deg_lt : P'.natDegree < N := by
      rw [← hP_deg]
      exact Polynomial.natDegree_derivative_lt (by rw [hP_deg]; exact hN_ne)
    let u : MvPowerSeries (Fin 2) ℂ := Polynomial.aeval x P'
    have hu_ne : u ≠ 0 := by
      intro hu0
      exact Nat.find_min h_ex hP'_deg_lt ⟨P', hP'_ne, rfl, hu0⟩
    let v : MvPowerSeries (Fin 2) ℂ :=
      ∑ i ∈ Finset.range (N + 1), D (P.coeff i : MvPowerSeries (Fin 2) ℂ) * x ^ i
    have hu_eq : u = ∑ i ∈ Finset.range (N + 1),
        (P.coeff i : MvPowerSeries (Fin 2) ℂ) * (i : MvPowerSeries (Fin 2) ℂ) * x ^ (i - 1) := by
      have hP_sum := Polynomial.as_sum_range_C_mul_X_pow P
      rw [hP_deg] at hP_sum
      conv_lhs => rw [show u = Polynomial.aeval x (Polynomial.derivative P) from rfl, hP_sum]
      rw [map_sum, map_sum]
      refine Finset.sum_congr rfl (fun i _ => ?_)
      rw [Polynomial.derivative_C_mul, Polynomial.derivative_X_pow, map_mul, map_mul,
        map_pow, Polynomial.aeval_C, Polynomial.aeval_C, Polynomial.aeval_X]
      simp [Algebra.algebraMap_eq_smul_one, Subalgebra.smul_def, mul_assoc]
    have huv_rel : u * D x + v = 0 := by
      have h_ev_sum : Polynomial.aeval x P =
          ∑ i ∈ Finset.range (N + 1), (P.coeff i : MvPowerSeries (Fin 2) ℂ) * x ^ i := by
        rw [Polynomial.aeval_eq_sum_range, hP_deg]
        rfl
      have hD_ev : D (Polynomial.aeval x P) = 0 := by rw [hP_ev, hD0]
      rw [h_ev_sum, hD_sum] at hD_ev
      have h_expand : (∑ i ∈ Finset.range (N + 1), D ((P.coeff i : MvPowerSeries (Fin 2) ℂ) * x ^ i)) =
          v + u * D x := by
        rw [hu_eq, Finset.sum_mul, ← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        rw [hD_mul, hD_pow]
        ring
      rw [h_expand, add_comm] at hD_ev
      exact hD_ev
    let S' : Set (MvPowerSeries (Fin 2) ℂ) := insert x (jetSet I)
    let B_alg : Subalgebra ℂ (MvPowerSeries (Fin 2) ℂ) := Algebra.adjoin ℂ S'
    have hAB : A ≤ B_alg := Algebra.adjoin_mono (Set.subset_insert x (jetSet I))
    have hx_B : x ∈ B_alg := Algebra.subset_adjoin (Set.mem_insert x (jetSet I))
    have hu_B : u ∈ B_alg := by
      dsimp only [u]
      rw [Polynomial.aeval_eq_sum_range]
      refine B_alg.sum_mem (fun i _ => ?_)
      rw [Subalgebra.smul_def]
      exact B_alg.mul_mem (hAB (P'.coeff i).2) (B_alg.pow_mem hx_B i)
    have hv_B : v ∈ B_alg := by
      refine B_alg.sum_mem (fun i _ => ?_)
      exact B_alg.mul_mem (hAB (hD_mem _ (P.coeff i).2)) (B_alg.pow_mem hx_B i)
    have hDx_B : IsAlgebraic ↥B_alg (D x) := by
      let L_poly : Polynomial ↥B_alg :=
        Polynomial.C ⟨u, hu_B⟩ * Polynomial.X + Polynomial.C ⟨v, hv_B⟩
      refine ⟨L_poly, ?_, ?_⟩
      · intro hL0
        have hc1 := congr_arg (fun Q : Polynomial ↥B_alg => Q.coeff 1) hL0
        simp [L_poly] at hc1
        exact hu_ne (congr_arg Subtype.val hc1)
      · simp [L_poly]
        exact huv_rel
    refine IsAlgebraic.adjoin_of_forall_isAlgebraic ?_ hDx_B
    intro z hz
    rcases hz with ⟨hz_in, hz_not⟩
    rcases Set.mem_insert_iff.mp hz_in with rfl | hz_jet
    · exact hx
    · exact False.elim (hz_not hz_jet)
  have h_mvA_alg : ∀ (I : Set ℤ) (x : MvPowerSeries (Fin 2) ℂ),
      IsAlgebraic ↥(jetAlg I) x → IsAlgebraic ↥(jetAlg I) (mvDerivA x) := by
    refine h_deriv_alg mvDerivA
      (fun Φ Ψ => (k_mv_leib Φ Ψ).1)
      (fun Φ Ψ => (k_mv_leib Φ Ψ).2.2.1)
      h_mvA_const ?_
    rintro I _ ⟨j, hj, ι, α, β, rfl⟩
    exact ⟨j, hj, ι, α + 1, β, (h_jet_step j ι α β).1⟩
  have h_mvD_alg : ∀ (I : Set ℤ) (x : MvPowerSeries (Fin 2) ℂ),
      IsAlgebraic ↥(jetAlg I) x → IsAlgebraic ↥(jetAlg I) (mvDerivD x) := by
    refine h_deriv_alg mvDerivD
      (fun Φ Ψ => (k_mv_leib Φ Ψ).2.1)
      (fun Φ Ψ => (k_mv_leib Φ Ψ).2.2.2)
      h_mvD_const ?_
    rintro I _ ⟨j, hj, ι, α, β, rfl⟩
    exact ⟨j, hj, ι, α, β + 1, (h_jet_step j ι α β).2⟩
  have h_iter00 : ∀ f : ℂ × ℂ → ℂ, iterDerivYT 0 0 f = f := by
    intro f; funext ⟨y, t⟩; rfl
  have h_all_jets_alg : ∀ (I : Set ℤ) (q : ℤ) (ι : Fin 2),
      IsAlgebraic ↥(jetAlg I) (taylor2D (F q ι) (0, 0)) →
      ∀ α β : ℕ, IsAlgebraic ↥(jetAlg I) (taylor2D (iterDerivYT α β (F q ι)) (0, 0)) := by
    intro I q ι h0 α
    have hα : IsAlgebraic ↥(jetAlg I) (taylor2D (iterDerivYT α 0 (F q ι)) (0, 0)) := by
      induction α with
      | zero => simpa [h_iter00] using h0
      | succ a iha => rw [← (h_jet_step q ι a 0).1]; exact h_mvA_alg I _ iha
    intro β
    induction β with
    | zero => exact hα
    | succ c ihc => rw [← (h_jet_step q ι α c).2]; exact h_mvD_alg I _ ihc
  let J : ℕ → Set ℤ := fun r =>
    { q : ℤ | ∃ s ≤ r, q = B_z - (s : ℤ) ∨ q = B_z + b_z - (s : ℤ) }
  have h_tower_step : ∀ (r : ℕ) (a : MvPowerSeries (Fin 2) ℂ),
      IsAlgebraic ↥(jetAlg (J (r + 1))) a → IsAlgebraic ↥(jetAlg (J r)) a := by
    intro r a ha
    let m : ℤ := B_z - (r : ℤ)
    have h_pair_sub : ({m, m + b_z} : Set ℤ) ⊆ J r := by
      intro q hq
      rcases hq with rfl | rfl
      · exact ⟨r, le_rfl, Or.inl rfl⟩
      · exact ⟨r, le_rfl, Or.inr (by dsimp [m]; ring)⟩
    have h_alg_le : jetAlg {m, m + b_z} ≤ jetAlg (J r) := by
      refine Algebra.adjoin_mono ?_
      rintro _ ⟨j, hj, ι, α, β, rfl⟩
      exact ⟨j, h_pair_sub hj, ι, α, β, rfl⟩
    refine IsAlgebraic.adjoin_of_forall_isAlgebraic ?_ ha
    intro Φ hΦ
    rcases hΦ with ⟨⟨q, hq1, ι, α, β, rfl⟩, hnot⟩
    rcases hq1 with ⟨s, hs, hq_eq⟩
    have hs_eq : s = r + 1 := by
      by_contra hne
      have hs_le : s ≤ r := by omega
      exact hnot ⟨q, ⟨s, hs_le, hq_eq⟩, ι, α, β, rfl⟩
    subst hs_eq
    rcases hq_eq with rfl | rfl
    · have hq_m : B_z - ((r + 1 : ℕ) : ℤ) = m - 1 := by dsimp [m]; ring
      rw [hq_m]
      exact h_all_jets_alg (J r) (m - 1) ι
        (IsAlgebraic.tower_top_of_subalgebra_le h_alg_le (hStep m ι).1) α β
    · have hq_mb : B_z + b_z - ((r + 1 : ℕ) : ℤ) = m + b_z - 1 := by dsimp [m]; ring
      rw [hq_mb]
      exact h_all_jets_alg (J r) (m + b_z - 1) ι
        (IsAlgebraic.tower_top_of_subalgebra_le h_alg_le (hStep m ι).2) α β
  have h_tower_all : ∀ (r : ℕ) (a : MvPowerSeries (Fin 2) ℂ),
      IsAlgebraic ↥(jetAlg (J r)) a → IsAlgebraic ↥(jetAlg (J 0)) a := by
    intro r
    induction r with
    | zero => intro a ha; exact ha
    | succ r ih => intro a ha; exact ih a (h_tower_step r a ha)
  have h1_mem_J : (1 : ℤ) ∈ J (K + 2) := by
    refine ⟨K + 2, le_rfl, Or.inl ?_⟩
    dsimp [B_z, B_nat]; omega
  have hx_mem : taylor2D (F 1 ι_star) (0, 0) ∈ jetAlg (J (K + 2)) := by
    apply Algebra.subset_adjoin
    exact ⟨1, h1_mem_J, ι_star, 0, 0, by rw [h_iter00]⟩
  have : IsDomain ↥(jetAlg (J (K + 2))) := Subalgebra.isDomain (jetAlg (J (K + 2)))
  have hx_alg_top : IsAlgebraic ↥(jetAlg (J (K + 2))) (taylor2D (F 1 ι_star) (0, 0)) := by
    refine ⟨Polynomial.X - Polynomial.C ⟨taylor2D (F 1 ι_star) (0, 0), hx_mem⟩,
      Polynomial.X_sub_C_ne_zero _, ?_⟩
    simp
  have hx_alg_0 := h_tower_all (K + 2) _ hx_alg_top
  have hJ0 : J 0 = {B_z, B_z + b_z} := by
    ext q
    simp only [J, Set.mem_ofPred_eq, Nat.le_zero, exists_eq_left, Nat.cast_zero, sub_zero,
      Set.mem_insert_iff, Set.mem_singleton_iff]
  have hAlg1 : IsAlgebraic ↥(jetAlg {B_z, B_z + b_z}) (taylor2D (F 1 ι_star) (0, 0)) := by
    dsimp only [jetAlg, jetSet] at hx_alg_0 ⊢
    rwa [hJ0] at hx_alg_0

  
  obtain ⟨P_star, hP_ne, hP_aeval⟩ := hAlg1
  let D_star : ℕ := P_star.natDegree
  let A_top := jetAlg {B_z, B_z + b_z}
  let P_R : Polynomial (MvPowerSeries (Fin 2) ℂ) :=
    P_star.map (algebraMap (↥A_top) (MvPowerSeries (Fin 2) ℂ))
  have hPR_ne : P_R ≠ 0 := by
    intro h0
    apply hP_ne
    have h0' : P_star.map (algebraMap (↥A_top) (MvPowerSeries (Fin 2) ℂ)) =
        (0 : Polynomial ↥A_top).map (algebraMap (↥A_top) (MvPowerSeries (Fin 2) ℂ)) := by
      simpa [P_R] using h0
    exact Polynomial.map_injective _ Subtype.val_injective h0'
  have hPR_deg : P_R.natDegree ≤ D_star := Polynomial.natDegree_map_le
  let gen : (Fin 2 × Fin 2 × ℕ × ℕ) → MvPowerSeries (Fin 2) ℂ :=
    fun w =>
      if w.1 = 0 then
        taylor2D (iterDerivYT w.2.2.1 w.2.2.2 (F B_z w.2.1)) (0, 0)
      else
        taylor2D (iterDerivYT w.2.2.1 w.2.2.2 (F (B_z + b_z) w.2.1)) (0, 0)
  have h_jet_range : jetSet {B_z, B_z + b_z} = Set.range gen := by
    ext Φ
    constructor
    · rintro ⟨j, hj, ι, α, β, rfl⟩
      rcases hj with rfl | rfl
      · exact ⟨(0, ι, α, β), by simp [gen]⟩
      · exact ⟨(1, ι, α, β), by simp [gen]⟩
    · rintro ⟨w, rfl⟩
      dsimp only [gen]
      split_ifs with hw
      · exact ⟨B_z, Or.inl rfl, w.2.1, w.2.2.1, w.2.2.2, rfl⟩
      · exact ⟨B_z + b_z, Or.inr rfl, w.2.1, w.2.2.1, w.2.2.2, rfl⟩
  have h_coeff_range : ∀ d : Fin (D_star + 1),
      ∃ R : MvPolynomial (Fin 2 × Fin 2 × ℕ × ℕ) ℂ,
        MvPolynomial.aeval gen R = P_R.coeff (d : ℕ) := by
    intro d
    have h_mem : P_R.coeff (d : ℕ) ∈ A_top := by
      simp only [P_R, Polynomial.coeff_map]
      exact (P_star.coeff (d : ℕ)).2
    have h_adjoin_eq : A_top = (MvPolynomial.aeval gen).range := by
      dsimp only [A_top, jetAlg]
      rw [h_jet_range]
      exact Algebra.adjoin_range_eq_range_aeval ℂ gen
    rw [h_adjoin_eq] at h_mem
    exact h_mem
  choose R_d hR_d using h_coeff_range
  classical
  let wMax : (Fin 2 × Fin 2 × ℕ × ℕ) → ℕ := fun w => max w.2.2.1 w.2.2.2
  let cMax : ((Fin 2 × Fin 2 × ℕ × ℕ) →₀ ℕ) → ℕ := fun c => c.support.sup wMax
  let dMax : Fin (D_star + 1) → ℕ := fun d => (R_d d).support.sup cMax
  let M_star : ℕ := Finset.univ.sup dMax
  let truncVar : (Fin 2 × Fin 2 × ℕ × ℕ) → MvPolynomial (LineJetVar M_star) ℂ :=
    fun w =>
      if h : w.2.2.1 ≤ M_star ∧ w.2.2.2 ≤ M_star then
        MvPolynomial.X (w.1, w.2.1, ⟨w.2.2.1, Nat.lt_succ_of_le h.1⟩, ⟨w.2.2.2, Nat.lt_succ_of_le h.2⟩)
      else 0
  let Q_star : Fin (D_star + 1) → MvPolynomial (LineJetVar M_star) ℂ :=
    fun d => MvPolynomial.bind₁ truncVar (R_d d)
  have hQ_star_eq : ∀ d : Fin (D_star + 1),
      MvPolynomial.aeval (lineJetTay B_z (B_z + b_z) M_star) (Q_star d) = P_R.coeff (d : ℕ) := by
    intro d
    dsimp only [Q_star]
    rw [MvPolynomial.aeval_bind₁, ← hR_d d]
    change MvPolynomial.eval₂ (algebraMap ℂ _) _ (R_d d) =
      MvPolynomial.eval₂ (algebraMap ℂ _) gen (R_d d)
    refine MvPolynomial.eval₂_congr _ _ _ (fun {w c} hwc hcoeff => ?_)
    have hc_supp : c ∈ (R_d d).support := MvPolynomial.mem_support_iff.mpr hcoeff
    have hmax_le : wMax w ≤ M_star := by
      calc
        wMax w ≤ cMax c := Finset.le_sup (f := wMax) hwc
        _ ≤ dMax d := Finset.le_sup (f := cMax) hc_supp
        _ ≤ M_star := Finset.le_sup (f := dMax) (Finset.mem_univ d)
    have h_le : w.2.2.1 ≤ M_star ∧ w.2.2.2 ≤ M_star :=
      ⟨le_trans (le_max_left _ _) hmax_le, le_trans (le_max_right _ _) hmax_le⟩
    have htrunc : truncVar w =
        MvPolynomial.X (w.1, w.2.1, ⟨w.2.2.1, Nat.lt_succ_of_le h_le.1⟩, ⟨w.2.2.2, Nat.lt_succ_of_le h_le.2⟩) := by
      simp [truncVar, h_le]
    simp only [htrunc, MvPolynomial.aeval_X, lineJetTay, gen]
  have hPR_eval : ∀ z : MvPowerSeries (Fin 2) ℂ,
      Polynomial.eval z P_R =
        ∑ d : Fin (D_star + 1),
          MvPolynomial.aeval (lineJetTay B_z (B_z + b_z) M_star) (Q_star d) * z ^ (d : ℕ) := by
    intro z
    rw [Polynomial.eval_eq_sum_range' (Nat.lt_succ_of_le hPR_deg), ← Fin.sum_univ_eq_sum_range]
    refine Finset.sum_congr rfl (fun d _ => ?_)
    rw [hQ_star_eq d]
  let z_seq : ℕ → MvPowerSeries (Fin 2) ℂ :=
    fun n => taylor2D (F (1 - 2 * (n : ℤ)) ι_star) (0, 0)
  have hz_root : ∀ n : ℕ, P_R.IsRoot (z_seq n) := by
    intro n
    change Polynomial.eval (z_seq n) P_R = 0
    rw [hPR_eval]
    induction n with
    | zero =>
      rw [← hPR_eval]
      have hz0 : z_seq 0 = taylor2D (F 1 ι_star) (0, 0) := by simp [z_seq]
      rw [hz0]
      dsimp only [P_R]
      rw [Polynomial.eval_map, ← Polynomial.aeval_def]
      exact hP_aeval
    | succ n ih =>
      exact hReflStep M_star D_star Q_star n ih
  let S_roots : Finset (MvPowerSeries (Fin 2) ℂ) :=
    (Finset.range (D_star + 1)).image z_seq
  have hS_sub : S_roots.val ⊆ P_R.roots := by
    rw [Multiset.subset_iff]
    intro x hx
    have hx' : x ∈ S_roots := hx
    rcases Finset.mem_image.mp hx' with ⟨n, _, rfl⟩
    exact (Polynomial.mem_roots hPR_ne).mpr (hz_root n)
  have h_card_le : S_roots.card ≤ P_R.natDegree :=
    Polynomial.card_le_degree_of_subset_roots hS_sub
  have h_card_eq : S_roots.card = D_star + 1 := by
    dsimp only [S_roots]
    rw [Finset.card_image_of_injective _ h_inj, Finset.card_range]
  omega

theorem real_wall_no_patch (Ω : Set Plane)
    (C : AnalyticGlancingCollar Ω)
    (hDet : EndpointDeterminationData C)
    (W : CollarWidthTubeData C hDet) :
    NoPatchAtRealProp W :=
by
  have h_no_patch :
      ∀ (t₀ x₀ H₁ ε δ : ℝ),
        |t₀| < W.r_base →
        W.h_L (t₀ : ℂ) = ENNReal.ofReal H₁ →
        0 < ε →
        ε < W.s_base →
        0 < δ →
        δ ≤ ε →
        HasRealWallPatch W t₀ x₀ H₁ ε δ →
        False := by
    intro t₀ x₀ H₁ ε δ ht₀ hhL hε_pos hε_lt hδ_pos hδ_le hPatch
    have ht₀_ball : (t₀ : ℂ) ∈ Metric.ball (0 : ℂ) W.r_base := by
      simpa [Metric.mem_ball, dist_zero_right, Complex.norm_real, Real.norm_eq_abs] using ht₀
    have hX_ge : ENNReal.ofReal (2 * W.s_base) ≤ W.h_X (t₀ : ℂ) :=
      W.h_X_ge_two (t₀ : ℂ) ht₀_ball
    have hL_eq_X : W.h_L (t₀ : ℂ) = W.h_X (t₀ : ℂ) := by
      simpa using W.h_L_eq (t₀ : ℂ) ht₀_ball
    have h2s_pos : 0 < 2 * W.s_base := by
      linarith [W.s_base_pos]
    have hH₁_pos : 0 < H₁ := by
      by_contra h_not_pos
      have h_le : H₁ ≤ 0 := le_of_not_gt h_not_pos
      have h0 : ENNReal.ofReal H₁ = 0 := ENNReal.ofReal_eq_zero.mpr h_le
      have hpos : (0 : ENNReal) < ENNReal.ofReal (2 * W.s_base) :=
        ENNReal.ofReal_pos.mpr h2s_pos
      rw [← hL_eq_X, hhL, h0] at hX_ge
      exact not_lt_of_ge hX_ge hpos
    obtain ⟨δ_star, hδ_star_pos, hδ_star_lt, hBand⟩ :=
      irrational_shift_band_polynomials Ω C hDet W t₀ x₀ H₁ ε δ
        ht₀ hhL hε_pos hε_lt hδ_pos hδ_le hPatch
    let I_irr : Set ℝ :=
      { t₁ : ℝ | t₁ ∈ Set.Ioo (t₀ - δ_star) (t₀ + δ_star) ∧
          Irrational (t₁ / (2 * Real.pi)) }
    let B_fn : ∀ u : I_irr, FullBandPolyData W H₁ (ε / 16) u.1 :=
      fun u => Classical.choice (hBand u.1 u.2.1 u.2.2)
    have h_weier :
        ∀ u : I_irr,
          ∃ E_bad : Set ℝ, E_bad.Countable ∧
            ∀ t₂ ∈ Set.Ioo (u.1 - (B_fn u).r₁ / 2) (u.1 + (B_fn u).r₁ / 2) \ E_bad,
              ENNReal.ofReal (H₁ + ε / 16) ≤ W.h_L (t₂ : ℂ) := by
      intro u
      have hu_abs : |u.1| < W.r_base := by
        rw [abs_lt]
        constructor <;> linarith [u.2.1.1, u.2.1.2, hδ_star_pos, hδ_star_lt,
          le_abs_self t₀, neg_le_abs t₀]
      obtain ⟨E_bad, hE_cnt, hE_prop⟩ :=
        weierstrass_wall_monodromy_defect Ω C hDet W H₁ (ε / 16) u.1
          (by linarith) hu_abs (B_fn u)
      refine ⟨E_bad, hE_cnt, fun t₂ ht₂ => ?_⟩
      rcases hE_prop t₂ ht₂ with h_ge | hD
      · exact h_ge
      · obtain ⟨D_wall⟩ := hD
        have hRefl : PolyReflectionProp C W.s_base W.r_base D_wall.K :=
          loop_involution_polynomial_reflection Ω C hDet W t₂ D_wall
        exact False.elim
          (differential_shear_root_contradiction Ω C hDet W.s_base W.r_base
            W.s_base_pos W.s_base_le_det W.r_base_pos W.r_base_le_det
            W.r_base_lt_s_base D_wall.K hRefl)
    choose E_bad hE_bad_cnt hE_bad_bound using h_weier
    let J : I_irr → Set ℝ :=
      fun u => Set.Ioo (u.1 - (B_fn u).r₁ / 2) (u.1 + (B_fn u).r₁ / 2)
    obtain ⟨T_cnt, hT_cnt, hT_union⟩ :=
      TopologicalSpace.isOpen_iUnion_countable J (fun _ => isOpen_Ioo)
    let E_rat : Set ℝ := Set.range (fun q : ℚ => (q : ℝ) * (2 * Real.pi))
    let E_cnt : Set ℝ := E_rat ∪ ⋃ u ∈ T_cnt, E_bad u
    have hE_cnt : E_cnt.Countable :=
      (Set.countable_range _).union (hT_cnt.biUnion (fun u _ => hE_bad_cnt u))
    have h_ae :
        ∀ t ∈ Set.Ioo (t₀ - δ_star) (t₀ + δ_star) \ E_cnt,
          ENNReal.ofReal (H₁ + ε / 16) ≤ W.h_L (t : ℂ) := by
      intro t ht
      have ht_not_rat : t ∉ E_rat := fun h => ht.2 (Or.inl h)
      have ht_irr : Irrational (t / (2 * Real.pi)) := by
        rintro ⟨q, hq⟩
        apply ht_not_rat
        refine ⟨q, ?_⟩
        have h2pi : (2 * Real.pi : ℝ) ≠ 0 := ne_of_gt Real.two_pi_pos
        dsimp only
        rw [hq, div_mul_cancel₀ _ h2pi]
      let u₀ : I_irr := ⟨t, ht.1, ht_irr⟩
      have ht_Ju₀ : t ∈ J u₀ := by
        have hr₁_pos : 0 < (B_fn u₀).r₁ := (B_fn u₀).r₁_pos
        exact ⟨by linarith, by linarith⟩
      have ht_iUnion : t ∈ ⋃ u : I_irr, J u := Set.mem_iUnion.mpr ⟨u₀, ht_Ju₀⟩
      rw [← hT_union] at ht_iUnion
      rcases Set.mem_iUnion₂.mp ht_iUnion with ⟨u₁, hu₁_mem, ht_Ju₁⟩
      have ht_not_bad : t ∉ E_bad u₁ :=
        fun hbad => ht.2 (Or.inr (Set.mem_iUnion₂.mpr ⟨u₁, hu₁_mem, hbad⟩))
      exact hE_bad_bound u₁ t ⟨ht_Ju₁, ht_not_bad⟩
    have h_transfer : ENNReal.ofReal (H₁ + ε / 16) ≤ W.h_L (t₀ : ℂ) :=
      W.real_interval_countable_transfer t₀ δ_star (H₁ + ε / 16) E_cnt
        hδ_star_pos (by linarith) hE_cnt h_ae
    rw [hhL] at h_transfer
    have h_le_real : H₁ + ε / 16 ≤ H₁ :=
      (ENNReal.ofReal_le_ofReal_iff (le_of_lt hH₁_pos)).mp h_transfer
    linarith
  refine ⟨?_, ?_⟩
  · intro t₀ x₀ H₁ ε ht₀ hhX hε_pos hε_lt ⟨g, δ, hδ_pos, hδ_le, hg⟩
    have ht₀_ball : (t₀ : ℂ) ∈ Metric.ball (0 : ℂ) W.r_base := by
      simpa [Metric.mem_ball, dist_zero_right, Complex.norm_real, Real.norm_eq_abs] using ht₀
    have hhL : W.h_L (t₀ : ℂ) = ENNReal.ofReal H₁ := by
      have h_eq := W.h_L_eq (t₀ : ℂ) ht₀_ball
      simpa [hhX] using h_eq
    exact h_no_patch t₀ x₀ H₁ ε δ ht₀ hhL hε_pos hε_lt hδ_pos hδ_le (Or.inl ⟨g, hg⟩)
  · intro t₀ x₀ H₁ ε ht₀ hhL hε_pos hε_lt ⟨g, δ, hδ_pos, hδ_le, hg⟩
    exact h_no_patch t₀ x₀ H₁ ε δ ht₀ hhL hε_pos hε_lt hδ_pos hδ_le (Or.inr ⟨g, hg⟩)

theorem zero_slice_extraction_and_regularity (Ω : Set Plane)
    (C : AnalyticGlancingCollar Ω)
    (hDet : EndpointDeterminationData C)
    (W : CollarWidthTubeData C hDet) :
    Nonempty (ZeroSliceExtractedData W) :=
by
  classical
  have heqOn_zero_ball :
      ∀ {p_a q₀ : ℂ × ℂ} {R η : ℝ},
        q₀ ∈ Metric.ball p_a R → 0 < η →
        ∀ {f_ball : ℂ × ℂ → ℂ},
          DifferentiableOn ℂ f_ball (Metric.ball p_a R) →
          (∀ q ∈ Metric.ball q₀ η, f_ball q = 0) →
          ∀ q ∈ Metric.ball p_a R, f_ball q = 0 := by
    intro p_a q₀ R η hq₀_a hη_pos f_ball hf_ball hf_zero q hq
    let φ : ℂ → ℂ × ℂ := fun z => (q₀.1 + z * (q.1 - q₀.1), q₀.2 + z * (q.2 - q₀.2))
    have hφ_cont : Continuous φ :=
      (continuous_const.add (continuous_id.mul continuous_const)).prodMk
        (continuous_const.add (continuous_id.mul continuous_const))
    have hφ_holo : Differentiable ℂ φ :=
      ((differentiable_const q₀.1).add (differentiable_id.mul (differentiable_const _))).prodMk
        ((differentiable_const q₀.2).add (differentiable_id.mul (differentiable_const _)))
    let U_z : Set ℂ := φ ⁻¹' Metric.ball p_a R
    have hUz_open : IsOpen U_z := Metric.isOpen_ball.preimage hφ_cont
    have hUz_conv : Convex ℝ U_z := by
      intro z₁ hz₁ z₂ hz₂ a b ha hb hab
      have hab_c : (a : ℂ) + (b : ℂ) = 1 := by exact_mod_cast hab
      have h_aff : φ (a • z₁ + b • z₂) = a • φ z₁ + b • φ z₂ := by
        ext
        · simp only [φ, Prod.smul_fst, Prod.fst_add, Complex.real_smul]
          linear_combination -q₀.1 * hab_c
        · simp only [φ, Prod.smul_snd, Prod.snd_add, Complex.real_smul]
          linear_combination -q₀.2 * hab_c
      change φ (a • z₁ + b • z₂) ∈ Metric.ball p_a R
      rw [h_aff]
      exact convex_ball p_a R hz₁ hz₂ ha hb hab
    have h0_Uz : (0 : ℂ) ∈ U_z := by
      change φ 0 ∈ Metric.ball p_a R
      simpa [φ] using hq₀_a
    have h1_Uz : (1 : ℂ) ∈ U_z := by
      change φ 1 ∈ Metric.ball p_a R
      have hφ1 : φ 1 = q := by ext <;> simp [φ]
      rwa [hφ1]
    have hg_an : AnalyticOnNhd ℂ (fun z => f_ball (φ z)) U_z :=
      (hf_ball.comp hφ_holo.differentiableOn (fun _ hz => hz)).analyticOnNhd hUz_open
    have hg_ev0 : (fun z => f_ball (φ z)) =ᶠ[nhds (0 : ℂ)] 0 := by
      have hφ0 : φ 0 = q₀ := by ext <;> simp [φ]
      have h_pre : φ ⁻¹' Metric.ball q₀ η ∈ nhds (0 : ℂ) :=
        hφ_cont.continuousAt.preimage_mem_nhds
          (by rw [hφ0]; exact Metric.isOpen_ball.mem_nhds (Metric.mem_ball_self hη_pos))
      filter_upwards [h_pre] with z hz
      exact hf_zero (φ z) hz
    have h_eq1 := hg_an.eqOn_zero_of_preconnected_of_eventuallyEq_zero
      hUz_conv.isPreconnected h0_Uz hg_ev0 h1_Uz
    have hφ1 : φ 1 = q := by ext <;> simp [φ]
    simpa [hφ1] using h_eq1

  have hpderiv_holo :
      ∀ {U : Set (ℂ × ℂ)}, IsOpen U → ∀ {f : ℂ × ℂ → ℂ},
        DifferentiableOn ℂ f U →
        DifferentiableOn ℂ (pderivA f) U ∧ DifferentiableOn ℂ (pderivD f) U := by
    have h_param_diff :
        ∀ {W s : Set (ℂ × ℂ)} {x₀ : ℂ × ℂ} {a b C_bd : ℝ} {c_mul : ℂ}
          {g_target : ℂ × ℂ → ℂ}
          {F : (ℂ × ℂ) → ℝ → ℂ} {F' : (ℂ × ℂ) → ℝ → (ℂ × ℂ) →L[ℂ] ℂ},
          s ∈ nhds x₀ →
          (∀ᶠ x in nhds x₀,
            MeasureTheory.AEStronglyMeasurable (F x) (MeasureTheory.volume.restrict (Set.uIoc a b))) →
          IntervalIntegrable (F x₀) MeasureTheory.volume a b →
          MeasureTheory.AEStronglyMeasurable (F' x₀) (MeasureTheory.volume.restrict (Set.uIoc a b)) →
          (∀ θ : ℝ, ∀ x ∈ s, ‖F' x θ‖ ≤ C_bd) →
          (∀ θ : ℝ, ∀ x ∈ s, HasFDerivAt (fun y => F y θ) (F' x θ) x) →
          (∀ x ∈ s, g_target x = c_mul * ∫ θ in a..b, F x θ) →
          DifferentiableWithinAt ℂ g_target W x₀ := by
      intro W s x₀ a b C_bd c_mul g_target F F' hs hF_meas hF_int hF'_meas h_bd h_fd h_eq
      have hd : DifferentiableAt ℂ (fun x => ∫ θ in a..b, F x θ) x₀ :=
        (intervalIntegral.hasFDerivAt_integral_of_dominated_of_fderiv_le (𝕜 := ℂ)
          hs hF_meas hF_int hF'_meas
          (Filter.Eventually.of_forall (fun θ _ x hx => h_bd θ x hx))
          intervalIntegrable_const
          (Filter.Eventually.of_forall (fun θ _ x hx => h_fd θ x hx))).differentiableAt
      have h_ev : g_target =ᶠ[nhds x₀] (fun x => c_mul * ∫ θ in a..b, F x θ) := by
        filter_upwards [hs] with x hx
        exact h_eq x hx
      exact ((hd.const_mul c_mul).congr_of_eventuallyEq h_ev).differentiableWithinAt
    let π₁ : (ℂ × ℂ) →L[ℂ] ℂ :=
      { toLinearMap := { toFun := Prod.fst, map_add' := fun _ _ => rfl, map_smul' := fun _ _ => rfl }
        cont := continuous_fst }
    let π₂ : (ℂ × ℂ) →L[ℂ] ℂ :=
      { toLinearMap := { toFun := Prod.snd, map_add' := fun _ _ => rfl, map_smul' := fun _ _ => rfl }
        cont := continuous_snd }
    have hπ₁_norm : ∀ v : ℂ × ℂ, ‖π₁ v‖ ≤ ‖v‖ := fun v => norm_fst_le v
    have hπ₂_norm : ∀ v : ℂ × ℂ, ‖π₂ v‖ ≤ ‖v‖ := fun v => norm_snd_le v
    have hpderivD : ∀ {W : Set (ℂ × ℂ)}, IsOpen W → ∀ {g : ℂ × ℂ → ℂ},
        DifferentiableOn ℂ g W → DifferentiableOn ℂ (pderivD g) W := by
      intro W hW g hg p₀ hp₀
      obtain ⟨R₀, _hR₀_pos, hR₀_sub⟩ := Metric.isOpen_iff.mp hW p₀ hp₀
      let r : ℝ := R₀ / 3
      have hr_pos : 0 < r := by dsimp [r]; linarith
      let K₂ : Set (ℂ × ℂ) := Metric.closedBall p₀ (2 * r)
      have hK₂_sub_W : K₂ ⊆ W :=
        Set.Subset.trans (Metric.closedBall_subset_ball (by dsimp [r]; linarith)) hR₀_sub
      obtain ⟨M₀, hM₀⟩ := (isCompact_closedBall p₀ (2 * r)).exists_bound_of_continuousOn
        (hg.continuousOn.mono hK₂_sub_W)
      let M_g : ℝ := max M₀ 0
      let B_q : Set (ℂ × ℂ) := Metric.ball p₀ (r / 2)
      have hp₀_Bq : p₀ ∈ B_q := Metric.mem_ball_self (half_pos hr_pos)
      have hBq_nhds : B_q ∈ nhds p₀ := Metric.isOpen_ball.mem_nhds hp₀_Bq
      have hBq_coord : ∀ {q : ℂ × ℂ}, q ∈ B_q → dist q.1 p₀.1 < r / 2 ∧ dist q.2 p₀.2 < r / 2 := by
        intro q hq
        have hp : q ∈ Metric.ball p₀.1 (r / 2) ×ˢ Metric.ball p₀.2 (r / 2) :=
          (ball_prod_same p₀.1 p₀.2 (r / 2)).symm ▸ hq
        exact ⟨Metric.mem_ball.mp hp.1, Metric.mem_ball.mp hp.2⟩
      let z_map : ℝ → ℂ := fun θ => circleMap p₀.2 r θ
      have hz_dist : ∀ θ : ℝ, ‖z_map θ - p₀.2‖ = r := by
        intro θ
        simpa [z_map, dist_eq_norm] using circleMap_mem_sphere p₀.2 hr_pos.le θ
      have hz_sub_lb : ∀ q ∈ B_q, ∀ θ : ℝ, r / 2 ≤ ‖z_map θ - q.2‖ := by
        intro q hq θ
        have hq2 : ‖q.2 - p₀.2‖ < r / 2 := by rw [← dist_eq_norm]; exact (hBq_coord hq).2
        have h_tri : ‖z_map θ - p₀.2‖ ≤ ‖z_map θ - q.2‖ + ‖q.2 - p₀.2‖ := by
          simpa using norm_add_le (z_map θ - q.2) (q.2 - p₀.2)
        rw [hz_dist θ] at h_tri
        linarith
      have hz_sub_ne : ∀ q ∈ B_q, ∀ θ : ℝ, z_map θ - q.2 ≠ 0 := by
        intro q hq θ h0
        have hlb := hz_sub_lb q hq θ
        rw [h0, norm_zero] at hlb
        linarith
      have h_mem_K₂ : ∀ y : ℂ, dist y p₀.1 ≤ 3 * r / 2 → ∀ θ : ℝ, (y, z_map θ) ∈ K₂ := by
        intro y hy θ
        rw [Metric.mem_closedBall, Prod.dist_eq]
        refine max_le (by linarith) ?_
        rw [dist_eq_norm, hz_dist θ]
        linarith
      have h_cauchy_eq : ∀ q ∈ B_q,
          pderivD g q =
            (2 * ↑Real.pi * Complex.I)⁻¹ *
              ∫ θ in (0 : ℝ)..(2 * Real.pi),
                deriv (circleMap p₀.2 r) θ * (((z_map θ - q.2) ^ 2)⁻¹ * g (q.1, z_map θ)) := by
        intro q hq
        obtain ⟨hq1_dist, hq2_dist⟩ := hBq_coord hq
        have hq2_ball : q.2 ∈ Metric.ball p₀.2 r := Metric.mem_ball.mpr (by linarith)
        have h_slice_holo : DifferentiableOn ℂ (fun z : ℂ => g (q.1, z)) (Metric.ball p₀.2 (2 * r)) := by
          refine hg.comp ((differentiableOn_const q.1).prodMk differentiableOn_id) ?_
          intro z hz
          apply hR₀_sub
          rw [Metric.mem_ball, Prod.dist_eq]
          exact max_lt (lt_trans hq1_dist (by dsimp [r]; linarith))
            (lt_trans (Metric.mem_ball.mp hz) (by dsimp [r]; linarith))
        have h_ci := Complex.two_pi_I_inv_smul_circleIntegral_sub_sq_inv_smul_of_differentiable
          Metric.isOpen_ball (Metric.closedBall_subset_ball (by linarith)) h_slice_holo hq2_ball
        dsimp only [pderivD]
        rw [← h_ci, circleIntegral]
        simp only [smul_eq_mul, mul_assoc, z_map]
      have h_pderivA_bound : ∀ q ∈ B_q, ∀ θ : ℝ, ‖pderivA g (q.1, z_map θ)‖ ≤ M_g / r := by
        intro q hq θ
        have hq1_dist := (hBq_coord hq).1
        have h_1d_diff : DiffContOnCl ℂ (fun w : ℂ => g (w, z_map θ)) (Metric.ball q.1 r) := by
          refine (hg.comp (differentiableOn_id.prodMk (differentiableOn_const (z_map θ))) ?_).diffContOnCl_ball
            (Set.Subset.refl _)
          intro w hw
          apply hK₂_sub_W
          apply h_mem_K₂ w
          calc dist w p₀.1 ≤ dist w q.1 + dist q.1 p₀.1 := dist_triangle _ _ _
            _ ≤ r + r / 2 := add_le_add (Metric.mem_closedBall.mp hw) hq1_dist.le
            _ = 3 * r / 2 := by ring
        have h_sph : ∀ w ∈ Metric.sphere q.1 r, ‖g (w, z_map θ)‖ ≤ M_g := by
          intro w hw
          have hw_K₂ : (w, z_map θ) ∈ K₂ := by
            apply h_mem_K₂ w
            calc dist w p₀.1 ≤ dist w q.1 + dist q.1 p₀.1 := dist_triangle _ _ _
              _ ≤ r + r / 2 := add_le_add (by rw [Metric.mem_sphere.mp hw]) hq1_dist.le
              _ = 3 * r / 2 := by ring
          exact le_trans (hM₀ _ hw_K₂) (le_max_left _ _)
        exact Complex.norm_deriv_le_of_forall_mem_sphere_norm_le hr_pos h_1d_diff h_sph
      let F_int : (ℂ × ℂ) → ℝ → ℂ := fun q θ =>
        deriv (circleMap p₀.2 r) θ * (((z_map θ - q.2) ^ 2)⁻¹ * g (q.1, z_map θ))
      let F'_int : (ℂ × ℂ) → ℝ → (ℂ × ℂ) →L[ℂ] ℂ := fun q θ =>
        (deriv (circleMap p₀.2 r) θ * (((z_map θ - q.2) ^ 2)⁻¹ * pderivA g (q.1, z_map θ))) • π₁ +
        (deriv (circleMap p₀.2 r) θ * (2 * ((z_map θ - q.2) ^ 3)⁻¹ * g (q.1, z_map θ))) • π₂
      have h_F_cont : ∀ q ∈ B_q, Continuous (F_int q) := by
        intro q hq
        have h_dc : Continuous (fun θ : ℝ => deriv (circleMap p₀.2 r) θ) := by
          have heq : (fun θ : ℝ => deriv (circleMap p₀.2 r) θ) = fun θ => circleMap 0 r θ * Complex.I :=
            funext (deriv_circleMap p₀.2 r)
          rw [heq]
          exact (continuous_circleMap 0 r).mul continuous_const
        have h_inv : Continuous (fun θ : ℝ => ((z_map θ - q.2) ^ 2)⁻¹) :=
          (((continuous_circleMap p₀.2 r).sub continuous_const).pow 2).inv₀
            (fun θ => pow_ne_zero 2 (hz_sub_ne q hq θ))
        have h_g : Continuous (fun θ : ℝ => g (q.1, z_map θ)) := by
          have hq1_dist := (hBq_coord hq).1
          exact (hg.continuousOn.mono hK₂_sub_W).comp_continuous
            (continuous_const.prodMk (continuous_circleMap p₀.2 r))
            (fun θ => h_mem_K₂ q.1 (by linarith) θ)
        exact h_dc.mul (h_inv.mul h_g)
      have h_meas_F : ∀ᶠ q in nhds p₀,
          MeasureTheory.AEStronglyMeasurable (F_int q)
            (MeasureTheory.volume.restrict (Set.uIoc 0 (2 * Real.pi))) := by
        filter_upwards [hBq_nhds] with q hq
        exact (h_F_cont q hq).aestronglyMeasurable
      have h_int_F0 : IntervalIntegrable (F_int p₀) MeasureTheory.volume 0 (2 * Real.pi) :=
        (h_F_cont p₀ hp₀_Bq).intervalIntegrable _ _
      have h_meas_pderivA0 :
          MeasureTheory.AEStronglyMeasurable (fun θ : ℝ => pderivA g (p₀.1, z_map θ))
            (MeasureTheory.volume.restrict (Set.uIoc 0 (2 * Real.pi))) := by
        let δ_seq : ℕ → ℂ := fun n => ((r / (2 * ((n : ℝ) + 1)) : ℝ) : ℂ)
        let dq_seq : ℕ → ℝ → ℂ := fun n θ => dslope (fun w : ℂ => g (w, z_map θ)) p₀.1 (p₀.1 + δ_seq n)
        have h_dq_meas : ∀ n : ℕ,
            MeasureTheory.AEStronglyMeasurable (dq_seq n)
              (MeasureTheory.volume.restrict (Set.uIoc 0 (2 * Real.pi))) := by
          intro n
          have h_pos_n : 0 < r / (2 * ((n : ℝ) + 1)) := div_pos hr_pos (by positivity)
          have h_le_n : r / (2 * ((n : ℝ) + 1)) ≤ r / 2 := by
            have : (2 : ℝ) * 1 ≤ 2 * ((n : ℝ) + 1) := by
              have : (0 : ℝ) ≤ (n : ℝ) := Nat.cast_nonneg n
              linarith
            exact div_le_div_of_nonneg_left hr_pos.le (by norm_num) (by linarith)
          have hδ_ne : δ_seq n ≠ 0 := Complex.ofReal_ne_zero.mpr h_pos_n.ne'
          have h_eq_div : dq_seq n = fun θ => (g (p₀.1 + δ_seq n, z_map θ) - g (p₀.1, z_map θ)) / δ_seq n := by
            ext θ
            dsimp only [dq_seq]
            rw [dslope_of_ne _ (by simp [hδ_ne]), slope_def_field]
            ring_nf
          rw [h_eq_div]
          have hc1 : Continuous (fun θ : ℝ => g (p₀.1 + δ_seq n, z_map θ)) :=
            (hg.continuousOn.mono hK₂_sub_W).comp_continuous
              (continuous_const.prodMk (continuous_circleMap p₀.2 r))
              (fun θ => h_mem_K₂ (p₀.1 + δ_seq n) (by
                rw [dist_eq_norm, add_sub_cancel_left, Complex.norm_real, Real.norm_eq_abs, abs_of_pos h_pos_n]
                linarith) θ)
          have hc2 : Continuous (fun θ : ℝ => g (p₀.1, z_map θ)) :=
            (hg.continuousOn.mono hK₂_sub_W).comp_continuous
              (continuous_const.prodMk (continuous_circleMap p₀.2 r))
              (fun θ => h_mem_K₂ p₀.1 (by rw [dist_self]; positivity) θ)
          exact ((hc1.sub hc2).div_const _).aestronglyMeasurable
        have hδ_tend : Filter.Tendsto (fun n : ℕ => p₀.1 + δ_seq n) Filter.atTop (nhds p₀.1) := by
          have h_real : Filter.Tendsto (fun n : ℕ => r / (2 * ((n : ℝ) + 1))) Filter.atTop (nhds 0) :=
            tendsto_const_nhds.div_atTop
              (Filter.Tendsto.const_mul_atTop (by norm_num)
                (tendsto_natCast_atTop_atTop.atTop_add tendsto_const_nhds))
          simpa [δ_seq] using tendsto_const_nhds.add (Complex.continuous_ofReal.continuousAt.tendsto.comp h_real)
        refine aestronglyMeasurable_of_tendsto_ae Filter.atTop h_dq_meas
          (Filter.Eventually.of_forall (fun θ => ?_))
        have h_slice_diff : DifferentiableAt ℂ (fun w : ℂ => g (w, z_map θ)) p₀.1 := by
          have hp_W : (p₀.1, z_map θ) ∈ W := hK₂_sub_W (h_mem_K₂ p₀.1 (by rw [dist_self]; positivity) θ)
          exact (hg.differentiableAt (hW.mem_nhds hp_W)).comp p₀.1
            (differentiableAt_id.prodMk (differentiableAt_const _))
        have ht := (continuousAt_dslope_same.mpr h_slice_diff).tendsto.comp hδ_tend
        rw [dslope_same] at ht
        exact ht
      have h_meas_F'0 :
          MeasureTheory.AEStronglyMeasurable (F'_int p₀)
            (MeasureTheory.volume.restrict (Set.uIoc 0 (2 * Real.pi))) := by
        have h_dc : Continuous (fun θ : ℝ => deriv (circleMap p₀.2 r) θ) := by
          have heq : (fun θ : ℝ => deriv (circleMap p₀.2 r) θ) = fun θ => circleMap 0 r θ * Complex.I :=
            funext (deriv_circleMap p₀.2 r)
          rw [heq]
          exact (continuous_circleMap 0 r).mul continuous_const
        have h_inv2 : Continuous (fun θ : ℝ => ((z_map θ - p₀.2) ^ 2)⁻¹) :=
          (((continuous_circleMap p₀.2 r).sub continuous_const).pow 2).inv₀
            (fun θ => pow_ne_zero 2 (hz_sub_ne p₀ hp₀_Bq θ))
        have h_inv3 : Continuous (fun θ : ℝ => 2 * ((z_map θ - p₀.2) ^ 3)⁻¹ * g (p₀.1, z_map θ)) :=
          (continuous_const.mul
            ((((continuous_circleMap p₀.2 r).sub continuous_const).pow 3).inv₀
              (fun θ => pow_ne_zero 3 (hz_sub_ne p₀ hp₀_Bq θ)))).mul
            ((hg.continuousOn.mono hK₂_sub_W).comp_continuous
              (continuous_const.prodMk (continuous_circleMap p₀.2 r))
              (fun θ => h_mem_K₂ p₀.1 (by rw [dist_self]; positivity) θ))
        have hm := (((h_dc.aestronglyMeasurable.mul
          (h_inv2.aestronglyMeasurable.mul h_meas_pderivA0)).smul_const π₁)).add
          ((h_dc.mul h_inv3).aestronglyMeasurable.smul_const π₂)
        exact hm.congr (Filter.Eventually.of_forall (fun _ => rfl))
      let C_bd : ℝ := r * ((2 / r) ^ 2 * (M_g / r)) + r * (2 * (2 / r) ^ 3 * M_g)
      have h_bound : ∀ θ : ℝ, ∀ q ∈ B_q, ‖F'_int q θ‖ ≤ C_bd := by
        intro θ q hq
        have h_dc_norm : ‖deriv (circleMap p₀.2 r) θ‖ = r := by
          rw [deriv_circleMap, norm_mul, Complex.norm_I, mul_one]
          simpa [dist_zero_right] using circleMap_mem_sphere (0 : ℂ) hr_pos.le θ
        have h_inv_le : ‖(z_map θ - q.2)⁻¹‖ ≤ 2 / r := by
          rw [norm_inv, inv_le_comm₀ (norm_pos_iff.mpr (hz_sub_ne q hq θ)) (div_pos zero_lt_two hr_pos)]
          have hlb := hz_sub_lb q hq θ
          rw [inv_div]
          exact hlb
        have h_inv2_le : ‖((z_map θ - q.2) ^ 2)⁻¹‖ ≤ (2 / r) ^ 2 := by
          rw [← inv_pow, norm_pow]
          exact pow_le_pow_left₀ (norm_nonneg _) h_inv_le 2
        have h_inv3_le : ‖((z_map θ - q.2) ^ 3)⁻¹‖ ≤ (2 / r) ^ 3 := by
          rw [← inv_pow, norm_pow]
          exact pow_le_pow_left₀ (norm_nonneg _) h_inv_le 3
        have hq1_dist := (hBq_coord hq).1
        have h_g_le : ‖g (q.1, z_map θ)‖ ≤ M_g :=
          le_trans (hM₀ _ (h_mem_K₂ q.1 (by linarith) θ)) (le_max_left _ _)
        have h_pd_le : ‖pderivA g (q.1, z_map θ)‖ ≤ M_g / r := h_pderivA_bound q hq θ
        refine ContinuousLinearMap.opNorm_le_bound _ (by positivity) (fun v => ?_)
        dsimp only [F'_int]
        simp only [_root_.add_apply, _root_.smul_apply, smul_eq_mul]
        have hb1 : ‖deriv (circleMap p₀.2 r) θ * (((z_map θ - q.2) ^ 2)⁻¹ * pderivA g (q.1, z_map θ)) * π₁ v‖ ≤
            r * ((2 / r) ^ 2 * (M_g / r)) * ‖v‖ := by
          simp only [norm_mul, h_dc_norm]
          gcongr
          exact hπ₁_norm v
        have hb2 : ‖deriv (circleMap p₀.2 r) θ * (2 * ((z_map θ - q.2) ^ 3)⁻¹ * g (q.1, z_map θ)) * π₂ v‖ ≤
            r * (2 * (2 / r) ^ 3 * M_g) * ‖v‖ := by
          simp only [norm_mul, h_dc_norm, Complex.norm_ofNat]
          gcongr
          exact hπ₂_norm v
        calc ‖deriv (circleMap p₀.2 r) θ * (((z_map θ - q.2) ^ 2)⁻¹ * pderivA g (q.1, z_map θ)) * π₁ v +
                deriv (circleMap p₀.2 r) θ * (2 * ((z_map θ - q.2) ^ 3)⁻¹ * g (q.1, z_map θ)) * π₂ v‖
            ≤ _ + _ := norm_add_le _ _
          _ ≤ r * ((2 / r) ^ 2 * (M_g / r)) * ‖v‖ + r * (2 * (2 / r) ^ 3 * M_g) * ‖v‖ := add_le_add hb1 hb2
          _ = C_bd * ‖v‖ := by dsimp [C_bd]; ring
      have h_has_fderiv : ∀ θ : ℝ, ∀ q ∈ B_q, HasFDerivAt (fun x => F_int x θ) (F'_int q θ) q := by
        intro θ q hq
        have hq1_dist := (hBq_coord hq).1
        have hp_W : (q.1, z_map θ) ∈ W := hK₂_sub_W (h_mem_K₂ q.1 (by linarith) θ)
        have hd_slice : HasDerivAt (fun w : ℂ => g (w, z_map θ)) (pderivA g (q.1, z_map θ)) q.1 :=
          ((hg.differentiableAt (hW.mem_nhds hp_W)).comp q.1
            (differentiableAt_id.prodMk (differentiableAt_const _))).hasDerivAt
        have hf_fst := HasDerivAt.comp_hasFDerivAt q hd_slice π₁.hasFDerivAt
        have hz_ne : z_map θ - q.2 ≠ 0 := hz_sub_ne q hq θ
        have hd_inv : HasDerivAt (fun w : ℂ => ((z_map θ - w) ^ 2)⁻¹) (2 * ((z_map θ - q.2) ^ 3)⁻¹) q.2 := by
          have hd_sub : HasDerivAt (fun w : ℂ => z_map θ - w) (-1) q.2 :=
            (hasDerivAt_id q.2).const_sub (z_map θ)
          have hd_sq : HasDerivAt (fun w : ℂ => (z_map θ - w) ^ 2)
              (2 * (z_map θ - q.2) ^ (2 - 1) * (-1)) q.2 := hd_sub.pow 2
          have hd_i := hd_sq.inv (pow_ne_zero 2 hz_ne)
          have heq_d : -(2 * (z_map θ - q.2) ^ (2 - 1) * -1) / ((z_map θ - q.2) ^ 2) ^ 2 =
              2 * ((z_map θ - q.2) ^ 3)⁻¹ := by
            field_simp [hz_ne]; ring
          rwa [heq_d] at hd_i
        have hf_snd := HasDerivAt.comp_hasFDerivAt q hd_inv π₂.hasFDerivAt
        have hf_prod := (hf_snd.mul hf_fst).const_mul (deriv (circleMap p₀.2 r) θ)
        refine hf_prod.congr_fderiv ?_
        refine ContinuousLinearMap.ext (fun v => ?_)
        dsimp only [F'_int, Function.comp_def]
        simp only [_root_.add_apply, _root_.smul_apply, smul_eq_mul]
        change deriv (circleMap p₀.2 r) θ *
            (((z_map θ - q.2) ^ 2)⁻¹ * (pderivA g (q.1, z_map θ) * π₁ v) +
              g (q.1, z_map θ) * (2 * ((z_map θ - q.2) ^ 3)⁻¹ * π₂ v)) =
          deriv (circleMap p₀.2 r) θ * (((z_map θ - q.2) ^ 2)⁻¹ * pderivA g (q.1, z_map θ)) * π₁ v +
            deriv (circleMap p₀.2 r) θ * (2 * ((z_map θ - q.2) ^ 3)⁻¹ * g (q.1, z_map θ)) * π₂ v
        ring
      exact h_param_diff hBq_nhds h_meas_F h_int_F0 h_meas_F'0 h_bound h_has_fderiv h_cauchy_eq
    intro U hU f hf
    have hpderivA : DifferentiableOn ℂ (pderivA f) U := by
      let swap : ℂ × ℂ → ℂ × ℂ := Prod.swap
      have hswap_holo : Differentiable ℂ swap := differentiable_snd.prodMk differentiable_fst
      have hswap_open : IsOpen (swap ⁻¹' U) := hU.preimage continuous_swap
      have hf_swap : DifferentiableOn ℂ (fun p => f (swap p)) (swap ⁻¹' U) :=
        hf.comp hswap_holo.differentiableOn (fun _ hp => hp)
      have hd_swap := hpderivD hswap_open hf_swap
      have h_eq : pderivA f = fun p => pderivD (fun q => f (swap q)) (swap p) := by
        ext p
        rfl
      rw [h_eq]
      exact hd_swap.comp hswap_holo.differentiableOn (fun _ hp => hp)
    exact ⟨hpderivA, hpderivD hU hf⟩
  let D_H : Set ℂ := horizStripENNR (W.h_X 0)
  let T_X : Set (ℂ × ℂ) := meroTubeENNR W.r_base W.h_X
  let T_L : Set (ℂ × ℂ) := meroTubeENNR W.r_base W.h_L
  let U_base2 : Set (ℂ × ℂ) := { p : ℂ × ℂ | |p.1.im| < 2 * W.s_base ∧ ‖p.2‖ < W.r_base }

  
  have h_open_hs : ∀ H : ℝ, IsOpen (horizStrip H) :=
    fun H => isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const
  have h_preconn_hs : ∀ H : ℝ, IsPreconnected (horizStrip H) := by
    intro H
    refine (?_ : Convex ℝ (horizStrip H)).isPreconnected
    intro s₁ hs₁ s₂ hs₂ a b ha hb hab
    change |s₁.im| < H at hs₁
    change |s₂.im| < H at hs₂
    change |(a • s₁ + b • s₂).im| < H
    have him : (a • s₁ + b • s₂).im = a * s₁.im + b * s₂.im := by
      simp [Complex.add_im, Complex.real_smul, Complex.mul_im]
    rw [him]
    rcases eq_or_lt_of_le ha with rfl | ha_pos
    · have hb1 : b = 1 := by linarith
      subst hb1
      have h_eq : |(0 : ℝ) * s₁.im + 1 * s₂.im| = |s₂.im| := by ring_nf
      rw [h_eq]
      exact hs₂
    · have h1 : a * |s₁.im| < a * H := mul_lt_mul_of_pos_left hs₁ ha_pos
      have h2 : b * |s₂.im| ≤ b * H := mul_le_mul_of_nonneg_left hs₂.le hb
      have h3 : |a * s₁.im + b * s₂.im| ≤ a * |s₁.im| + b * |s₂.im| := by
        calc |a * s₁.im + b * s₂.im| ≤ |a * s₁.im| + |b * s₂.im| := abs_add_le _ _
          _ = a * |s₁.im| + b * |s₂.im| := by rw [abs_mul, abs_mul, abs_of_nonneg ha, abs_of_nonneg hb]
      calc |a * s₁.im + b * s₂.im| ≤ a * |s₁.im| + b * |s₂.im| := h3
        _ < a * H + b * H := add_lt_add_of_lt_of_le h1 h2
        _ = (a + b) * H := by ring
        _ = H := by rw [hab, one_mul]

  have h0_ball : (0 : ℂ) ∈ Metric.ball (0 : ℂ) W.r_base := Metric.mem_ball_self W.r_base_pos
  have hhX0_ge : ENNReal.ofReal (2 * W.s_base) ≤ W.h_X 0 := W.h_X_ge_two 0 h0_ball
  have hhL0_eq : W.h_L 0 = W.h_X 0 := by
    have h := W.h_L_eq 0 h0_ball
    simp at h
    exact h

  have hDH_open_preconn : IsOpen D_H ∧ IsPreconnected D_H := by
    by_cases hTop : W.h_X 0 = ⊤
    · have h_univ : D_H = Set.univ := by
        ext s
        simp [D_H, horizStripENNR, hTop, ENNReal.ofReal_lt_top]
      rw [h_univ]
      exact ⟨isOpen_univ, convex_univ.isPreconnected⟩
    · let H₀ : ℝ := (W.h_X 0).toReal
      have hH₀_eq : ENNReal.ofReal H₀ = W.h_X 0 := ENNReal.ofReal_toReal hTop
      have h2s_pos : 0 < 2 * W.s_base := by linarith [W.s_base_pos]
      have hH₀_pos : 0 < H₀ := by
        have h_pos_ennr : (0 : ENNReal) < ENNReal.ofReal H₀ :=
          lt_of_lt_of_le (ENNReal.ofReal_pos.mpr h2s_pos) (hhX0_ge.trans_eq hH₀_eq.symm)
        exact ENNReal.ofReal_pos.mp h_pos_ennr
      have h_eq_hs : D_H = horizStrip H₀ := by
        ext s
        change ENNReal.ofReal |s.im| < W.h_X 0 ↔ |s.im| < H₀
        rw [← hH₀_eq]
        exact ENNReal.ofReal_lt_ofReal_iff hH₀_pos
      rw [h_eq_hs]
      exact ⟨h_open_hs H₀, h_preconn_hs H₀⟩
  have hDH_open : IsOpen D_H := hDH_open_preconn.1
  have hDH_preconn : IsPreconnected D_H := hDH_open_preconn.2

  have hDH_conj : ∀ s ∈ D_H, starRingEnd ℂ s ∈ D_H := by
    intro s hs
    change ENNReal.ofReal |s.im| < W.h_X 0 at hs
    change ENNReal.ofReal |(starRingEnd ℂ s).im| < W.h_X 0
    simpa [Complex.conj_im, abs_neg] using hs

  have h0_base : (0 : ℂ) ∈ horizStrip W.s_base := by
    simp [horizStrip, W.s_base_pos]
  have hbase_sub_two : horizStrip W.s_base ⊆ horizStrip (2 * W.s_base) := by
    intro s hs
    change |s.im| < W.s_base at hs
    change |s.im| < 2 * W.s_base
    linarith [W.s_base_pos]
  have htwo_sub_DH : horizStrip (2 * W.s_base) ⊆ D_H := by
    intro s hs
    change |s.im| < 2 * W.s_base at hs
    change ENNReal.ofReal |s.im| < W.h_X 0
    exact lt_of_lt_of_le ((ENNReal.ofReal_lt_ofReal_iff (by linarith [W.s_base_pos])).mpr hs) hhX0_ge
  have h0_DH : (0 : ℂ) ∈ D_H := htwo_sub_DH (hbase_sub_two h0_base)

  have hslice_X : ∀ s ∈ D_H, (s, (0 : ℂ)) ∈ T_X := by
    intro s hs
    change ENNReal.ofReal |s.im| < W.h_X 0 at hs
    refine ⟨by simp [W.r_base_pos], ?_, ?_⟩
    · simp only [map_zero]
      exact lt_of_le_of_lt (ENNReal.ofReal_le_ofReal (neg_le_abs s.im)) hs
    · exact lt_of_le_of_lt (ENNReal.ofReal_le_ofReal (le_abs_self s.im)) hs
  have hslice_L : ∀ s ∈ D_H, (s, (0 : ℂ)) ∈ T_L := by
    intro s hs
    obtain ⟨h1, h2, h3⟩ := hslice_X s hs
    refine ⟨h1, ?_, ?_⟩
    · simp only [map_zero] at h2 ⊢
      rwa [hhL0_eq]
    · rwa [hhL0_eq]

  have hU_base2_open : IsOpen U_base2 :=
    (isOpen_lt (continuous_abs.comp (Complex.continuous_im.comp continuous_fst)) continuous_const).inter
      (isOpen_lt (continuous_norm.comp continuous_snd) continuous_const)
  have h00_U_base2 : ((0 : ℂ), (0 : ℂ)) ∈ U_base2 := by
    simp [U_base2, W.s_base_pos, W.r_base_pos]
  have hU_sub_det : U_base2 ⊆ { p : ℂ × ℂ | |p.1.im| < 2 * hDet.s_det ∧ ‖p.2‖ < 2 * hDet.r_det } := by
    intro p hp
    exact ⟨by linarith [hp.1, W.s_base_le_det], by linarith [hp.2, W.r_base_le_det, hDet.r_det_pos]⟩
  have himpact_holo : ∀ i : Fin 2, DifferentiableOn ℂ (fun p : ℂ × ℂ => glancingImpact C p.1 p.2 i) U_base2 :=
    fun i => (hDet.impact_holo i).mono hU_sub_det
  have hdualLine_holo : ∀ i : Fin 2, DifferentiableOn ℂ (fun p : ℂ × ℂ => glancingDualLine C p.1 p.2 i) U_base2 :=
    fun i => (hDet.dualLine_holo i).mono hU_sub_det

  have h2s_lt_2s₁ : 2 * W.s_base < 2 * C.s₁ := by
    linarith [W.s_base_le_s₁, C.r₁_pos, C.r₁_lt_s₁]
  have h2s_lt_2s₀ : 2 * W.s_base < 2 * C.s₀ := by
    linarith [W.s_base_le_s₀, C.s₀_pos]
  have htwo_sub_2s₀ : horizStrip (2 * W.s_base) ⊆ horizStrip (2 * C.s₀) := by
    intro z hz
    change |z.im| < 2 * W.s_base at hz
    change |z.im| < 2 * C.s₀
    linarith

  have himpact_zero : ∀ z ∈ horizStrip (2 * W.s_base), ∀ i : Fin 2,
      glancingImpact C z 0 i = glancingBoundaryCurve C z i := by
    intro z hz i
    have hz_s₁ : |z.im| < 2 * C.s₁ := lt_trans hz h2s_lt_2s₁
    have hmid : glancingMidAngle C z 0 = C.ϕ_ℂ z := by
      dsimp only [glancingMidAngle, glancingTheta]
      simp only [zero_div, sub_zero, add_zero, C.U_zero z hz_s₁]
      ring
    dsimp only [glancingImpact, glancingBoundaryCurve]
    rw [hmid]

  have hϕ_an_2s₀ : AnalyticOnNhd ℂ C.ϕ_ℂ (horizStrip (2 * C.s₀)) :=
    C.ϕ_ℂ_holo.analyticOnNhd (h_open_hs (2 * C.s₀))
  have hh_an_2sh : AnalyticOnNhd ℂ C.h_ℂ (horizStrip (2 * C.s_h)) :=
    C.h_ℂ_holo.analyticOnNhd (h_open_hs (2 * C.s_h))

  have h_exp_deriv : ∀ z ∈ horizStrip (2 * W.s_base),
      HasDerivAt (fun w => Complex.exp (Complex.I * C.ϕ_ℂ w))
        (Complex.I * deriv C.ϕ_ℂ z * Complex.exp (Complex.I * C.ϕ_ℂ z)) z := by
    intro z hz
    have hz₀ : z ∈ horizStrip (2 * C.s₀) := htwo_sub_2s₀ hz
    have hϕ_d : HasDerivAt C.ϕ_ℂ (deriv C.ϕ_ℂ z) z :=
      (hϕ_an_2s₀ z hz₀).differentiableAt.hasDerivAt
    have h_mul : HasDerivAt (fun w => Complex.I * C.ϕ_ℂ w) (Complex.I * deriv C.ϕ_ℂ z) z :=
      hϕ_d.const_mul Complex.I
    have h_cexp : HasDerivAt (fun w => Complex.exp (Complex.I * C.ϕ_ℂ w))
        (Complex.exp (Complex.I * C.ϕ_ℂ z) * (Complex.I * deriv C.ϕ_ℂ z)) z :=
      (Complex.hasDerivAt_exp (Complex.I * C.ϕ_ℂ z)).comp z h_mul
    have h_comm : Complex.exp (Complex.I * C.ϕ_ℂ z) * (Complex.I * deriv C.ϕ_ℂ z) =
        Complex.I * deriv C.ϕ_ℂ z * Complex.exp (Complex.I * C.ϕ_ℂ z) := by ring
    rwa [h_comm] at h_cexp

  have h_exp_holo : DifferentiableOn ℂ (fun z => Complex.exp (Complex.I * C.ϕ_ℂ z)) (horizStrip (2 * W.s_base)) :=
    fun z hz => (h_exp_deriv z hz).differentiableAt.differentiableWithinAt
  have hexp_an : AnalyticOnNhd ℂ (fun z => Complex.exp (Complex.I * C.ϕ_ℂ z)) (horizStrip (2 * W.s_base)) :=
    h_exp_holo.analyticOnNhd (h_open_hs (2 * W.s_base))
  have hspeed_an : AnalyticOnNhd ℂ (deriv C.ϕ_ℂ) (horizStrip (2 * W.s_base)) :=
    fun z hz => (hϕ_an_2s₀ z (htwo_sub_2s₀ hz)).deriv
  have hspeed_ne : ∀ z ∈ horizStrip (2 * W.s_base), deriv C.ϕ_ℂ z ≠ 0 :=
    fun z hz => C.ϕ_ℂ_deriv_ne_zero z (htwo_sub_2s₀ hz)

  have h_curve_derivs : ∀ z ∈ horizStrip (2 * W.s_base),
      HasDerivAt (fun w => glancingBoundaryCurve C w 0)
        (-(C.h_ℂ (C.ϕ_ℂ z) + deriv (deriv C.h_ℂ) (C.ϕ_ℂ z)) * deriv C.ϕ_ℂ z * Complex.sin (C.ϕ_ℂ z)) z ∧
      HasDerivAt (fun w => glancingBoundaryCurve C w 1)
        ((C.h_ℂ (C.ϕ_ℂ z) + deriv (deriv C.h_ℂ) (C.ϕ_ℂ z)) * deriv C.ϕ_ℂ z * Complex.cos (C.ϕ_ℂ z)) z := by
    intro z hz
    have hz₀ : z ∈ horizStrip (2 * C.s₀) := htwo_sub_2s₀ hz
    let θ := C.ϕ_ℂ z
    have hθ : θ ∈ horizStrip (2 * C.s_h) := C.ϕ_ℂ_maps_to z hz₀
    have hϕ_d : HasDerivAt C.ϕ_ℂ (deriv C.ϕ_ℂ z) z :=
      (hϕ_an_2s₀ z hz₀).differentiableAt.hasDerivAt
    have hh_d : HasDerivAt C.h_ℂ (deriv C.h_ℂ θ) θ :=
      (hh_an_2sh θ hθ).differentiableAt.hasDerivAt
    have hh'_d : HasDerivAt (deriv C.h_ℂ) (deriv (deriv C.h_ℂ) θ) θ :=
      (hh_an_2sh θ hθ).deriv.differentiableAt.hasDerivAt
    have hd_hϕ : HasDerivAt (fun w => C.h_ℂ (C.ϕ_ℂ w)) (deriv C.h_ℂ θ * deriv C.ϕ_ℂ z) z :=
      hh_d.comp z hϕ_d
    have hd_h'ϕ : HasDerivAt (fun w => deriv C.h_ℂ (C.ϕ_ℂ w)) (deriv (deriv C.h_ℂ) θ * deriv C.ϕ_ℂ z) z :=
      hh'_d.comp z hϕ_d
    have hd_cos : HasDerivAt (fun w => Complex.cos (C.ϕ_ℂ w)) (-Complex.sin θ * deriv C.ϕ_ℂ z) z :=
      (Complex.hasDerivAt_cos θ).comp z hϕ_d
    have hd_sin : HasDerivAt (fun w => Complex.sin (C.ϕ_ℂ w)) (Complex.cos θ * deriv C.ϕ_ℂ z) z :=
      (Complex.hasDerivAt_sin θ).comp z hϕ_d
    have hc0 : (fun w => glancingBoundaryCurve C w 0) =
        fun w => C.h_ℂ (C.ϕ_ℂ w) * Complex.cos (C.ϕ_ℂ w) - deriv C.h_ℂ (C.ϕ_ℂ w) * Complex.sin (C.ϕ_ℂ w) := by
      ext w; simp [glancingBoundaryCurve]
    have hc1 : (fun w => glancingBoundaryCurve C w 1) =
        fun w => C.h_ℂ (C.ϕ_ℂ w) * Complex.sin (C.ϕ_ℂ w) + deriv C.h_ℂ (C.ϕ_ℂ w) * Complex.cos (C.ϕ_ℂ w) := by
      ext w; simp [glancingBoundaryCurve]
    refine ⟨?_, ?_⟩
    · rw [hc0]
      have hd := (hd_hϕ.mul hd_cos).sub (hd_h'ϕ.mul hd_sin)
      have heq : deriv C.h_ℂ θ * deriv C.ϕ_ℂ z * Complex.cos θ +
          C.h_ℂ θ * (-Complex.sin θ * deriv C.ϕ_ℂ z) -
          (deriv (deriv C.h_ℂ) θ * deriv C.ϕ_ℂ z * Complex.sin θ +
            deriv C.h_ℂ θ * (Complex.cos θ * deriv C.ϕ_ℂ z)) =
          -(C.h_ℂ (C.ϕ_ℂ z) + deriv (deriv C.h_ℂ) (C.ϕ_ℂ z)) * deriv C.ϕ_ℂ z * Complex.sin (C.ϕ_ℂ z) := by
        dsimp only [θ]; ring
      rwa [heq] at hd
    · rw [hc1]
      have hd := (hd_hϕ.mul hd_sin).add (hd_h'ϕ.mul hd_cos)
      have heq : deriv C.h_ℂ θ * deriv C.ϕ_ℂ z * Complex.sin θ +
          C.h_ℂ θ * (Complex.cos θ * deriv C.ϕ_ℂ z) +
          (deriv (deriv C.h_ℂ) θ * deriv C.ϕ_ℂ z * Complex.cos θ +
            deriv C.h_ℂ θ * (-Complex.sin θ * deriv C.ϕ_ℂ z)) =
          (C.h_ℂ (C.ϕ_ℂ z) + deriv (deriv C.h_ℂ) (C.ϕ_ℂ z)) * deriv C.ϕ_ℂ z * Complex.cos (C.ϕ_ℂ z) := by
        dsimp only [θ]; ring
      rwa [heq] at hd

  have hcurve_an : ∀ i : Fin 2, AnalyticOnNhd ℂ (fun z => glancingBoundaryCurve C z i) (horizStrip (2 * W.s_base)) := by
    intro i
    fin_cases i
    · have h0 : DifferentiableOn ℂ (fun z => glancingBoundaryCurve C z 0) (horizStrip (2 * W.s_base)) :=
        fun z hz => (h_curve_derivs z hz).1.differentiableAt.differentiableWithinAt
      exact h0.analyticOnNhd (h_open_hs (2 * W.s_base))
    · have h1 : DifferentiableOn ℂ (fun z => glancingBoundaryCurve C z 1) (horizStrip (2 * W.s_base)) :=
        fun z hz => (h_curve_derivs z hz).2.differentiableAt.differentiableWithinAt
      exact h1.analyticOnNhd (h_open_hs (2 * W.s_base))

  have h_iso : ∀ z ∈ horizStrip (2 * W.s_base),
      (deriv (fun w => glancingBoundaryCurve C w 0) z +
        Complex.I * deriv (fun w => glancingBoundaryCurve C w 1) z =
        Complex.I * C.c * Complex.exp (Complex.I * C.ϕ_ℂ z) / (deriv C.ϕ_ℂ z) ^ 2) ∧
      (deriv (fun w => glancingBoundaryCurve C w 0) z -
        Complex.I * deriv (fun w => glancingBoundaryCurve C w 1) z =
        -Complex.I * C.c / (Complex.exp (Complex.I * C.ϕ_ℂ z) * (deriv C.ϕ_ℂ z) ^ 2)) := by
    intro z hz
    have hz₀ : z ∈ horizStrip (2 * C.s₀) := htwo_sub_2s₀ hz
    obtain ⟨hd0, hd1⟩ := h_curve_derivs z hz
    rw [hd0.deriv, hd1.deriv]
    let θ := C.ϕ_ℂ z
    let R_θ := C.h_ℂ θ + deriv (deriv C.h_ℂ) θ
    let ϕ' := deriv C.ϕ_ℂ z
    have hϕ'_ne : ϕ' ≠ 0 := C.ϕ_ℂ_deriv_ne_zero z hz₀
    have hϕ'2_ne : ϕ' ^ 2 ≠ 0 := pow_ne_zero 2 hϕ'_ne
    have hlaz : R_θ * ϕ' ^ 3 = (C.c : ℂ) := C.lazutkin_norm_ℂ z hz₀
    have hexp_eq : Complex.exp (Complex.I * θ) = Complex.cos θ + Complex.sin θ * Complex.I := by
      rw [mul_comm Complex.I θ, Complex.exp_mul_I]
    have hexp_ne : Complex.exp (Complex.I * θ) ≠ 0 := Complex.exp_ne_zero _
    have h_unit : Complex.exp (Complex.I * θ) * (Complex.cos θ - Complex.sin θ * Complex.I) = 1 := by
      rw [hexp_eq]
      calc (Complex.cos θ + Complex.sin θ * Complex.I) * (Complex.cos θ - Complex.sin θ * Complex.I)
          = Complex.cos θ ^ 2 - Complex.sin θ ^ 2 * Complex.I ^ 2 := by ring
        _ = Complex.cos θ ^ 2 + Complex.sin θ ^ 2 := by rw [Complex.I_sq]; ring
        _ = 1 := Complex.cos_sq_add_sin_sq θ
    refine ⟨?_, ?_⟩
    · rw [eq_div_iff hϕ'2_ne]
      calc (-R_θ * ϕ' * Complex.sin θ + Complex.I * (R_θ * ϕ' * Complex.cos θ)) * ϕ' ^ 2
          = Complex.I * (R_θ * ϕ' ^ 3) * (Complex.cos θ + Complex.sin θ * Complex.I) := by
            linear_combination -(R_θ * ϕ' ^ 3 * Complex.sin θ) * Complex.I_sq
        _ = Complex.I * (C.c : ℂ) * Complex.exp (Complex.I * θ) := by rw [hlaz, ← hexp_eq]
    · have h_den_ne : Complex.exp (Complex.I * θ) * ϕ' ^ 2 ≠ 0 := mul_ne_zero hexp_ne hϕ'2_ne
      rw [eq_div_iff h_den_ne]
      calc (-R_θ * ϕ' * Complex.sin θ - Complex.I * (R_θ * ϕ' * Complex.cos θ)) *
              (Complex.exp (Complex.I * θ) * ϕ' ^ 2)
          = -Complex.I * (R_θ * ϕ' ^ 3) *
              (Complex.exp (Complex.I * θ) * (Complex.cos θ - Complex.sin θ * Complex.I)) := by
            linear_combination -(R_θ * ϕ' ^ 3 * Complex.sin θ * Complex.exp (Complex.I * θ)) * Complex.I_sq
        _ = -Complex.I * (C.c : ℂ) * 1 := by rw [hlaz, h_unit]
        _ = -Complex.I * (C.c : ℂ) := mul_one _

  have hiso_pos : ∀ z ∈ horizStrip (2 * W.s_base),
      deriv (fun w => glancingBoundaryCurve C w 0) z +
        Complex.I * deriv (fun w => glancingBoundaryCurve C w 1) z =
        Complex.I * C.c * Complex.exp (Complex.I * C.ϕ_ℂ z) / (deriv C.ϕ_ℂ z) ^ 2 :=
    fun z hz => (h_iso z hz).1
  have hiso_neg : ∀ z ∈ horizStrip (2 * W.s_base),
      deriv (fun w => glancingBoundaryCurve C w 0) z -
        Complex.I * deriv (fun w => glancingBoundaryCurve C w 1) z =
        -Complex.I * C.c / (Complex.exp (Complex.I * C.ϕ_ℂ z) * (deriv C.ϕ_ℂ z) ^ 2) :=
    fun z hz => (h_iso z hz).2
  have hexp_deriv : ∀ z ∈ horizStrip (2 * W.s_base),
      deriv (fun w => Complex.exp (Complex.I * C.ϕ_ℂ w)) z =
        Complex.I * deriv C.ϕ_ℂ z * Complex.exp (Complex.I * C.ϕ_ℂ z) :=
    fun z hz => (h_exp_deriv z hz).deriv

  have hcurve_conj : ∀ z ∈ horizStrip (2 * W.s_base), ∀ i : Fin 2,
      glancingBoundaryCurve C (starRingEnd ℂ z) i =
        starRingEnd ℂ (glancingBoundaryCurve C z i) := by
    intro z hz i
    have hz₀ : z ∈ horizStrip (2 * C.s₀) := htwo_sub_2s₀ hz
    have hθ : C.ϕ_ℂ z ∈ horizStrip (2 * C.s_h) := C.ϕ_ℂ_maps_to z hz₀
    have hθ_bar : starRingEnd ℂ (C.ϕ_ℂ z) ∈ horizStrip (2 * C.s_h) := by
      change |(C.ϕ_ℂ z).im| < 2 * C.s_h at hθ
      change |(starRingEnd ℂ (C.ϕ_ℂ z)).im| < 2 * C.s_h
      simpa [Complex.conj_im, abs_neg] using hθ
    have h_deriv_h_conj : deriv C.h_ℂ (starRingEnd ℂ (C.ϕ_ℂ z)) = starRingEnd ℂ (deriv C.h_ℂ (C.ϕ_ℂ z)) := by
      have hd : HasDerivAt C.h_ℂ (deriv C.h_ℂ (C.ϕ_ℂ z)) (C.ϕ_ℂ z) :=
        (hh_an_2sh (C.ϕ_ℂ z) hθ).differentiableAt.hasDerivAt
      have hd_cc := hd.conj_conj
      have h_ev : C.h_ℂ =ᶠ[nhds (starRingEnd ℂ (C.ϕ_ℂ z))]
          (⇑(starRingEnd ℂ) ∘ C.h_ℂ ∘ ⇑(starRingEnd ℂ)) := by
        filter_upwards [(h_open_hs (2 * C.s_h)).mem_nhds hθ_bar] with w hw
        change C.h_ℂ w = starRingEnd ℂ (C.h_ℂ (starRingEnd ℂ w))
        rw [C.h_ℂ_conj w hw, Complex.conj_conj]
      exact (hd_cc.congr_of_eventuallyEq h_ev).deriv
    fin_cases i
    · change glancingBoundaryCurve C (starRingEnd ℂ z) 0 = starRingEnd ℂ (glancingBoundaryCurve C z 0)
      dsimp only [glancingBoundaryCurve]
      simp only [Matrix.cons_val_zero, C.ϕ_ℂ_conj z hz₀, C.h_ℂ_conj (C.ϕ_ℂ z) hθ, h_deriv_h_conj,
        Complex.cos_conj, Complex.sin_conj, map_sub, map_mul]
    · change glancingBoundaryCurve C (starRingEnd ℂ z) 1 = starRingEnd ℂ (glancingBoundaryCurve C z 1)
      dsimp only [glancingBoundaryCurve]
      simp only [Matrix.cons_val_one, Matrix.cons_val_zero, C.ϕ_ℂ_conj z hz₀, C.h_ℂ_conj (C.ϕ_ℂ z) hθ,
        h_deriv_h_conj, Complex.cos_conj, Complex.sin_conj, map_add, map_mul]

  
  have h_atlas_exists :
      ∀ (T : Set (ℂ × ℂ)) (F : MeroOn2D T)
        (hSlice_sub : ∀ s ∈ D_H, (s, (0 : ℂ)) ∈ T)
        (f_init : ℂ × ℂ → ℂ)
        (hf_holo : DifferentiableOn ℂ f_init U_base2)
        (hf_agrees : MeroAgreesHolo F f_init U_base2),
        ∃ (δ : ℂ → ℝ) (N_tilde D_tilde : ℂ → ℂ × ℂ → ℂ),
          (∀ s ∈ D_H, 0 < δ s) ∧
          (∀ s ∈ D_H, Metric.ball s (δ s) ⊆ D_H) ∧
          (∀ s ∈ D_H, ∀ z ∈ Metric.ball s (δ s),
            ∀ᶠ w in nhdsWithin z {z}ᶜ, D_tilde s (w, 0) ≠ 0) ∧
          (∀ s ∈ D_H, DifferentiableOn ℂ (N_tilde s) (Metric.ball (s, (0 : ℂ)) (δ s))) ∧
          (∀ s ∈ D_H, DifferentiableOn ℂ (D_tilde s) (Metric.ball (s, (0 : ℂ)) (δ s))) ∧
          (∀ s₁ ∈ D_H, ∀ s₂ ∈ D_H,
            ∀ z ∈ Metric.ball s₁ (δ s₁) ∩ Metric.ball s₂ (δ s₂),
              N_tilde s₁ (z, 0) * D_tilde s₂ (z, 0) = N_tilde s₂ (z, 0) * D_tilde s₁ (z, 0)) ∧
          (∀ s ∈ D_H, ∀ z ∈ Metric.ball s (δ s),
            D_tilde s (z, 0) ≠ 0 →
            ∃ r_z : ℝ, 0 < r_z ∧
              Metric.ball z r_z ⊆ Metric.ball s (δ s) ∧
              Metric.ball (z, (0 : ℂ)) r_z ⊆ T ∧
              DifferentiableOn ℂ (fun q => N_tilde s q / D_tilde s q) (Metric.ball (z, (0 : ℂ)) r_z) ∧
              MeroAgreesHolo F (fun q => N_tilde s q / D_tilde s q) (Metric.ball (z, (0 : ℂ)) r_z)) ∧
          (∀ s ∈ D_H, ∀ (U : Set (ℂ × ℂ)) (g : ℂ × ℂ → ℂ),
            IsOpen U → (s, (0 : ℂ)) ∈ U → DifferentiableOn ℂ g U → MeroAgreesHolo F g U →
            ∀ᶠ w in nhds s, N_tilde s (w, 0) = g (w, 0) * D_tilde s (w, 0)) := by
    intro T F hSlice_sub f_init hf_holo hf_agrees
    have h_compat_transfer :
        ∀ {p_a p_b : ℂ × ℂ} (hp_a : p_a ∈ T) (hp_b : p_b ∈ T)
          {V : Set (ℂ × ℂ)} (hV_open : IsOpen V)
          (hV_a : V ⊆ Metric.ball p_a (F.rad p_a))
          (hV_b : V ⊆ Metric.ball p_b (F.rad p_b))
          {N_t D_t : ℂ × ℂ → ℂ}
          (hN_cont : ContinuousOn N_t V) (hD_cont : ContinuousOn D_t V)
          (h_eq_a : ∀ q ∈ V, F.num p_a q * D_t q = N_t q * F.den p_a q),
          ∀ q ∈ V, F.num p_b q * D_t q = N_t q * F.den p_b q := by
      intro p_a p_b hp_a hp_b V hV_open hV_a hV_b N_t D_t hN_cont hD_cont h_eq_a q₀ hq₀
      by_contra h_ne
      let g_diff : ℂ × ℂ → ℂ := fun q => F.num p_b q * D_t q - N_t q * F.den p_b q
      have hg_ne : g_diff q₀ ≠ 0 := sub_ne_zero.mpr h_ne
      have hg_cont : ContinuousOn g_diff V :=
        (((F.num_holo p_b hp_b).continuousOn.mono hV_b).mul hD_cont).sub
          (hN_cont.mul ((F.den_holo p_b hp_b).continuousOn.mono hV_b))
      have h_nhds : {q : ℂ × ℂ | g_diff q ≠ 0} ∩ V ∈ nhds q₀ :=
        Filter.inter_mem
          ((hg_cont.continuousAt (hV_open.mem_nhds hq₀)).eventually_ne hg_ne)
          (hV_open.mem_nhds hq₀)
      obtain ⟨η, hη_pos, hη_sub⟩ := Metric.mem_nhds_iff.mp h_nhds
      have h_den_zero_ball : ∀ q ∈ Metric.ball q₀ η, F.den p_a q = 0 := by
        intro q hq
        have hq_mem := hη_sub hq
        have hq_V : q ∈ V := hq_mem.2
        have hq_ab : q ∈ Metric.ball p_b (F.rad p_b) ∩ Metric.ball p_a (F.rad p_a) :=
          ⟨hV_b hq_V, hV_a hq_V⟩
        have h_comp := F.compat p_b hp_b p_a hp_a q hq_ab
        have h_prod : g_diff q * F.den p_a q = 0 := by
          dsimp only [g_diff]
          calc (F.num p_b q * D_t q - N_t q * F.den p_b q) * F.den p_a q
              = (F.num p_b q * F.den p_a q) * D_t q - N_t q * F.den p_b q * F.den p_a q := by ring
            _ = (F.num p_a q * F.den p_b q) * D_t q - N_t q * F.den p_b q * F.den p_a q := by
                rw [h_comp]
            _ = (F.num p_a q * D_t q) * F.den p_b q - N_t q * F.den p_b q * F.den p_a q := by ring
            _ = (N_t q * F.den p_a q) * F.den p_b q - N_t q * F.den p_b q * F.den p_a q := by
                rw [h_eq_a q hq_V]
            _ = 0 := by ring
        exact (mul_eq_zero.mp h_prod).resolve_left hq_mem.1
      have h_den_all_zero : ∀ q ∈ Metric.ball p_a (F.rad p_a), F.den p_a q = 0 :=
        heqOn_zero_ball (hV_a hq₀) hη_pos (F.den_holo p_a hp_a) h_den_zero_ball
      obtain ⟨q_nz, hq_nz_mem, hq_nz⟩ := F.den_ne_zero p_a hp_a
      exact hq_nz (h_den_all_zero q_nz hq_nz_mem)

    let dslopeT : (ℂ × ℂ → ℂ) → (ℂ × ℂ → ℂ) :=
      fun g p => dslope (fun t : ℂ => g (p.1, t)) 0 p.2

    have h_dslopeT_step :
        ∀ (s₀ : ℂ) (δ₀ : ℝ) (hδ₀ : 0 < δ₀) (g : ℂ × ℂ → ℂ),
          DifferentiableOn ℂ g (Metric.ball (s₀, (0 : ℂ)) δ₀) →
          (∀ y ∈ Metric.ball s₀ δ₀, g (y, 0) = 0) →
          DifferentiableOn ℂ (dslopeT g) (Metric.ball (s₀, (0 : ℂ)) δ₀) ∧
          (∀ p ∈ Metric.ball (s₀, (0 : ℂ)) δ₀, p.2 * dslopeT g p = g p) := by
      intro s₀ δ₀ _hδ₀ g hg hg0
      let B : Set (ℂ × ℂ) := Metric.ball (s₀, (0 : ℂ)) δ₀
      have hB_prod : B = Metric.ball s₀ δ₀ ×ˢ Metric.ball (0 : ℂ) δ₀ :=
        (ball_prod_same s₀ (0 : ℂ) δ₀).symm
      have h_fac : ∀ p ∈ B, p.2 * dslopeT g p = g p := by
        intro p hp
        have hp_prod : p ∈ Metric.ball s₀ δ₀ ×ˢ Metric.ball (0 : ℂ) δ₀ := hB_prod ▸ hp
        have h_sub := sub_smul_dslope (fun t : ℂ => g (p.1, t)) 0 p.2
        simp only [sub_zero, smul_eq_mul, hg0 p.1 hp_prod.1] at h_sub
        exact h_sub
      let g_t : ℂ × ℂ → ℂ := pderivD g
      have hg_t : DifferentiableOn ℂ g_t B := (hpderiv_holo Metric.isOpen_ball hg).2
      have hg_ty : DifferentiableOn ℂ (pderivA g_t) B :=
        (hpderiv_holo Metric.isOpen_ball hg_t).1
      have hg_tt : DifferentiableOn ℂ (pderivD g_t) B :=
        (hpderiv_holo Metric.isOpen_ball hg_t).2
      have h_scale_mem : ∀ {r : ℝ} {q : ℂ × ℂ}, q ∈ Metric.ball (s₀, (0 : ℂ)) r →
          ∀ u ∈ Set.Icc (0 : ℝ) 1, (q.1, (u : ℂ) * q.2) ∈ Metric.ball (s₀, (0 : ℂ)) r := by
        intro r q hq u hu
        rw [← ball_prod_same] at hq ⊢
        refine ⟨hq.1, ?_⟩
        have hq2 : ‖q.2‖ < r := by simpa [Metric.mem_ball, dist_zero_right] using hq.2
        change (u : ℂ) * q.2 ∈ Metric.ball (0 : ℂ) r
        rw [Metric.mem_ball, dist_zero_right]
        have hu_norm : ‖(u : ℂ)‖ ≤ 1 := by
          rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hu.1]
          exact hu.2
        calc ‖(u : ℂ) * q.2‖ = ‖(u : ℂ)‖ * ‖q.2‖ := norm_mul _ _
          _ ≤ 1 * ‖q.2‖ := mul_le_mul_of_nonneg_right hu_norm (norm_nonneg _)
          _ = ‖q.2‖ := one_mul _
          _ < r := hq2
      have h_int_eq : ∀ p ∈ B, dslopeT g p = ∫ u in (0 : ℝ)..1, g_t (p.1, (u : ℂ) * p.2) := by
        intro p hp
        have hp_prod : p ∈ Metric.ball s₀ δ₀ ×ˢ Metric.ball (0 : ℂ) δ₀ := hB_prod ▸ hp
        by_cases ht : p.2 = 0
        · dsimp only [dslopeT, g_t, pderivD]
          rw [ht, dslope_same]
          simp only [mul_zero, intervalIntegral.integral_const, sub_zero, one_smul]
        · have h_cont_u : ContinuousOn (fun u : ℝ => g_t (p.1, (u : ℂ) * p.2)) (Set.uIcc 0 1) := by
            rw [Set.uIcc_of_le zero_le_one]
            exact hg_t.continuousOn.comp
              (continuousOn_const.prodMk ((Complex.continuous_ofReal.continuousOn).mul continuousOn_const))
              (fun u hu => h_scale_mem hp u hu)
          have h_deriv_u : ∀ u ∈ Set.uIcc (0 : ℝ) 1,
              HasDerivAt (fun τ : ℝ => g (p.1, (τ : ℂ) * p.2)) (p.2 * g_t (p.1, (u : ℂ) * p.2)) u := by
            intro u hu
            rw [Set.uIcc_of_le zero_le_one] at hu
            have hpu : (p.1, (u : ℂ) * p.2) ∈ B := h_scale_mem hp u hu
            have hg_slice : DifferentiableAt ℂ (fun w : ℂ => g (p.1, w)) ((u : ℂ) * p.2) :=
              (hg.differentiableAt (Metric.isOpen_ball.mem_nhds hpu)).comp ((u : ℂ) * p.2)
                ((differentiableAt_const p.1).prodMk differentiableAt_id)
            have h_out : HasDerivAt (fun w : ℂ => g (p.1, w)) (g_t (p.1, (u : ℂ) * p.2)) ((u : ℂ) * p.2) :=
              hg_slice.hasDerivAt
            have h_in : HasDerivAt (fun τ : ℝ => (τ : ℂ) * p.2) p.2 u := by
              simpa using (Complex.ofRealCLM.hasDerivAt (x := u)).mul_const p.2
            have h_comp := HasDerivAt.scomp u h_out h_in
            rw [smul_eq_mul] at h_comp
            exact h_comp
          have h_int_prod :
              ∫ u in (0 : ℝ)..1, p.2 * g_t (p.1, (u : ℂ) * p.2) = g p := by
            have h_ftc := intervalIntegral.integral_eq_sub_of_hasDerivAt h_deriv_u
              ((continuousOn_const.mul h_cont_u).intervalIntegrable)
            simp only [Complex.ofReal_one, one_mul, Complex.ofReal_zero, zero_mul,
              hg0 p.1 hp_prod.1, sub_zero] at h_ftc
            exact h_ftc
          rw [intervalIntegral.integral_const_mul] at h_int_prod
          exact mul_left_cancel₀ ht ((h_fac p hp).trans h_int_prod.symm)
      have h_fderiv_eq : ∀ q ∈ B,
          fderiv ℂ g_t q =
            pderivA g_t q • ContinuousLinearMap.fst ℂ ℂ ℂ +
            pderivD g_t q • ContinuousLinearMap.snd ℂ ℂ ℂ := by
        intro q hq
        have hdq : DifferentiableAt ℂ g_t q := hg_t.differentiableAt (Metric.isOpen_ball.mem_nhds hq)
        have hL := hdq.hasFDerivAt
        have h1 : (fderiv ℂ g_t q) (1, 0) = pderivA g_t q := by
          have h_in1 : HasDerivAt (fun z : ℂ => (z, q.2)) (1, 0) q.1 :=
            (hasDerivAt_id q.1).prodMk (hasDerivAt_const q.1 q.2)
          exact (hL.comp_hasDerivAt q.1 h_in1).deriv.symm
        have h2 : (fderiv ℂ g_t q) (0, 1) = pderivD g_t q := by
          have h_in2 : HasDerivAt (fun z : ℂ => (q.1, z)) (0, 1) q.2 :=
            (hasDerivAt_const q.2 q.1).prodMk (hasDerivAt_id q.2)
          exact (hL.comp_hasDerivAt q.2 h_in2).deriv.symm
        refine ContinuousLinearMap.ext (fun v => ?_)
        have hv : v = v.1 • ((1 : ℂ), (0 : ℂ)) + v.2 • ((0 : ℂ), (1 : ℂ)) := by
          ext <;> simp
        calc (fderiv ℂ g_t q) v
            = (fderiv ℂ g_t q) (v.1 • ((1 : ℂ), (0 : ℂ)) + v.2 • ((0 : ℂ), (1 : ℂ))) := by
                rw [← hv]
          _ = v.1 • (fderiv ℂ g_t q) (1, 0) + v.2 • (fderiv ℂ g_t q) (0, 1) := by
                rw [map_add, map_smul, map_smul]
          _ = v.1 * pderivA g_t q + v.2 * pderivD g_t q := by
                rw [h1, h2, smul_eq_mul, smul_eq_mul]
          _ = (pderivA g_t q • ContinuousLinearMap.fst ℂ ℂ ℂ +
                pderivD g_t q • ContinuousLinearMap.snd ℂ ℂ ℂ) v := by
                simp [mul_comm]
      have h_holo : DifferentiableOn ℂ (dslopeT g) B := by
        intro p_star hp_star
        have h_dist : dist p_star (s₀, (0 : ℂ)) < δ₀ := Metric.mem_ball.mp hp_star
        let δ₁ : ℝ := (dist p_star (s₀, (0 : ℂ)) + δ₀) / 2
        have hδ₁_gt : dist p_star (s₀, (0 : ℂ)) < δ₁ := by dsimp [δ₁]; linarith
        have hδ₁_lt : δ₁ < δ₀ := by dsimp [δ₁]; linarith
        let B₁ : Set (ℂ × ℂ) := Metric.ball (s₀, (0 : ℂ)) δ₁
        let K₁ : Set (ℂ × ℂ) := Metric.closedBall (s₀, (0 : ℂ)) δ₁
        have hp_B₁ : p_star ∈ B₁ := Metric.mem_ball.mpr hδ₁_gt
        have hK₁_sub : K₁ ⊆ B := Metric.closedBall_subset_ball hδ₁_lt
        have hB₁_sub_K₁ : B₁ ⊆ K₁ := Metric.ball_subset_closedBall
        have hK₁_compact : IsCompact K₁ := isCompact_closedBall (s₀, (0 : ℂ)) δ₁
        obtain ⟨M₁, hM₁⟩ := hK₁_compact.exists_bound_of_continuousOn (hg_ty.continuousOn.mono hK₁_sub)
        obtain ⟨M₂, hM₂⟩ := hK₁_compact.exists_bound_of_continuousOn (hg_tt.continuousOn.mono hK₁_sub)
        let M_bd : ℝ := max M₁ 0 + max M₂ 0
        let Φ_clm : ℝ → (ℂ × ℂ) →L[ℂ] (ℂ × ℂ) :=
          fun u => (ContinuousLinearMap.fst ℂ ℂ ℂ).prod ((u : ℂ) • ContinuousLinearMap.snd ℂ ℂ ℂ)
        let F_int : (ℂ × ℂ) → ℝ → ℂ := fun q u => g_t (q.1, (u : ℂ) * q.2)
        let F'_int : (ℂ × ℂ) → ℝ → (ℂ × ℂ) →L[ℂ] ℂ := fun q u =>
          pderivA g_t (q.1, (u : ℂ) * q.2) • ContinuousLinearMap.fst ℂ ℂ ℂ +
          ((u : ℂ) * pderivD g_t (q.1, (u : ℂ) * q.2)) • ContinuousLinearMap.snd ℂ ℂ ℂ
        have h_F_cont : ∀ q ∈ B₁, ContinuousOn (F_int q) (Set.Icc (0 : ℝ) 1) := by
          intro q hq
          exact hg_t.continuousOn.comp
            (continuousOn_const.prodMk ((Complex.continuous_ofReal.continuousOn).mul continuousOn_const))
            (fun u hu => hK₁_sub (hB₁_sub_K₁ (h_scale_mem hq u hu)))
        have h_F'_cont : ContinuousOn (F'_int p_star) (Set.Icc (0 : ℝ) 1) := by
          have h_map : ∀ u ∈ Set.Icc (0 : ℝ) 1, (p_star.1, (u : ℂ) * p_star.2) ∈ B :=
            fun u hu => hK₁_sub (hB₁_sub_K₁ (h_scale_mem hp_B₁ u hu))
          have hc1 : ContinuousOn (fun u : ℝ => pderivA g_t (p_star.1, (u : ℂ) * p_star.2)) (Set.Icc 0 1) :=
            hg_ty.continuousOn.comp
              (continuousOn_const.prodMk ((Complex.continuous_ofReal.continuousOn).mul continuousOn_const))
              h_map
          have hc2 : ContinuousOn (fun u : ℝ => (u : ℂ) * pderivD g_t (p_star.1, (u : ℂ) * p_star.2)) (Set.Icc 0 1) :=
            Complex.continuous_ofReal.continuousOn.mul
              (hg_tt.continuousOn.comp
                (continuousOn_const.prodMk ((Complex.continuous_ofReal.continuousOn).mul continuousOn_const))
                h_map)
          exact (hc1.smul continuousOn_const).add (hc2.smul continuousOn_const)
        have hB₁_nhds : B₁ ∈ nhds p_star := Metric.isOpen_ball.mem_nhds hp_B₁
        have h_meas_F : ∀ᶠ q in nhds p_star,
            MeasureTheory.AEStronglyMeasurable (F_int q) (MeasureTheory.volume.restrict (Set.uIoc 0 1)) := by
          filter_upwards [hB₁_nhds] with q hq
          refine ((h_F_cont q hq).mono ?_).aestronglyMeasurable measurableSet_uIoc
          rw [Set.uIoc_of_le zero_le_one]
          exact Set.Ioc_subset_Icc_self
        have h_int_F0 : IntervalIntegrable (F_int p_star) MeasureTheory.volume 0 1 := by
          refine ContinuousOn.intervalIntegrable ?_
          rw [Set.uIcc_of_le zero_le_one]
          exact h_F_cont p_star hp_B₁
        have h_meas_F'0 :
            MeasureTheory.AEStronglyMeasurable (F'_int p_star) (MeasureTheory.volume.restrict (Set.uIoc 0 1)) := by
          refine (h_F'_cont.mono ?_).aestronglyMeasurable measurableSet_uIoc
          rw [Set.uIoc_of_le zero_le_one]
          exact Set.Ioc_subset_Icc_self
        have h_bound : ∀ᵐ u ∂MeasureTheory.volume, u ∈ Set.uIoc (0 : ℝ) 1 →
            ∀ q ∈ B₁, ‖F'_int q u‖ ≤ M_bd := by
          refine Filter.Eventually.of_forall (fun u hu q hq => ?_)
          rw [Set.uIoc_of_le zero_le_one] at hu
          have hu_icc : u ∈ Set.Icc (0 : ℝ) 1 := ⟨le_of_lt hu.1, hu.2⟩
          have hqu_K₁ : (q.1, (u : ℂ) * q.2) ∈ K₁ := hB₁_sub_K₁ (h_scale_mem hq u hu_icc)
          have hb1 : ‖pderivA g_t (q.1, (u : ℂ) * q.2)‖ ≤ max M₁ 0 :=
            le_trans (hM₁ _ hqu_K₁) (le_max_left _ _)
          have hb2 : ‖pderivD g_t (q.1, (u : ℂ) * q.2)‖ ≤ max M₂ 0 :=
            le_trans (hM₂ _ hqu_K₁) (le_max_left _ _)
          have hu_norm : ‖(u : ℂ)‖ ≤ 1 := by
            rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hu_icc.1]
            exact hu_icc.2
          refine ContinuousLinearMap.opNorm_le_bound _ (by positivity) (fun v => ?_)
          dsimp only [F'_int]
          simp only [_root_.add_apply, _root_.smul_apply, ContinuousLinearMap.coe_fst',
            ContinuousLinearMap.coe_snd', smul_eq_mul]
          calc ‖pderivA g_t (q.1, (u : ℂ) * q.2) * v.1 +
                  (u : ℂ) * pderivD g_t (q.1, (u : ℂ) * q.2) * v.2‖
              ≤ ‖pderivA g_t (q.1, (u : ℂ) * q.2) * v.1‖ +
                  ‖(u : ℂ) * pderivD g_t (q.1, (u : ℂ) * q.2) * v.2‖ := norm_add_le _ _
            _ = ‖pderivA g_t (q.1, (u : ℂ) * q.2)‖ * ‖v.1‖ +
                  ‖(u : ℂ)‖ * ‖pderivD g_t (q.1, (u : ℂ) * q.2)‖ * ‖v.2‖ := by
                  simp only [norm_mul]
            _ ≤ max M₁ 0 * ‖v‖ + 1 * max M₂ 0 * ‖v‖ := by
                  gcongr
                  · exact norm_fst_le v
                  · exact norm_snd_le v
            _ = M_bd * ‖v‖ := by dsimp [M_bd]; ring
        have h_has_fderiv : ∀ᵐ u ∂MeasureTheory.volume, u ∈ Set.uIoc (0 : ℝ) 1 →
            ∀ q ∈ B₁, HasFDerivAt (fun x => F_int x u) (F'_int q u) q := by
          refine Filter.Eventually.of_forall (fun u hu q hq => ?_)
          rw [Set.uIoc_of_le zero_le_one] at hu
          have hu_icc : u ∈ Set.Icc (0 : ℝ) 1 := ⟨le_of_lt hu.1, hu.2⟩
          have hqu_B : Φ_clm u q ∈ B := hK₁_sub (hB₁_sub_K₁ (h_scale_mem hq u hu_icc))
          have hd_gt : HasFDerivAt g_t (fderiv ℂ g_t (Φ_clm u q)) (Φ_clm u q) :=
            (hg_t.differentiableAt (Metric.isOpen_ball.mem_nhds hqu_B)).hasFDerivAt
          have h_comp := hd_gt.comp q (Φ_clm u).hasFDerivAt
          have h_clm_eq : (fderiv ℂ g_t (Φ_clm u q)).comp (Φ_clm u) = F'_int q u := by
            rw [h_fderiv_eq (Φ_clm u q) hqu_B]
            refine ContinuousLinearMap.ext (fun v => ?_)
            simp [Φ_clm, F'_int, mul_assoc, mul_comm]
          rw [h_clm_eq] at h_comp
          exact h_comp
        have h_int_fderiv := intervalIntegral.hasFDerivAt_integral_of_dominated_of_fderiv_le
          hB₁_nhds h_meas_F h_int_F0 h_meas_F'0 h_bound intervalIntegrable_const h_has_fderiv
        have h_ev_eq : dslopeT g =ᶠ[nhds p_star] (fun x => ∫ u in (0 : ℝ)..1, F_int x u) := by
          filter_upwards [Metric.isOpen_ball.mem_nhds hp_star] with x hx
          exact h_int_eq x hx
        exact (h_int_fderiv.congr_of_eventuallyEq h_ev_eq).differentiableAt.differentiableWithinAt
      exact ⟨h_holo, h_fac⟩

    have h_dslopeT_iter :
        ∀ (m : ℕ) (s₀ : ℂ) (δ₀ : ℝ) (hδ₀ : 0 < δ₀) (g : ℂ × ℂ → ℂ),
          DifferentiableOn ℂ g (Metric.ball (s₀, (0 : ℂ)) δ₀) →
          (∀ j < m, ∀ y ∈ Metric.ball s₀ δ₀, (dslopeT^[j] g) (y, 0) = 0) →
          DifferentiableOn ℂ (dslopeT^[m] g) (Metric.ball (s₀, (0 : ℂ)) δ₀) ∧
          (∀ p ∈ Metric.ball (s₀, (0 : ℂ)) δ₀, p.2 ^ m * (dslopeT^[m] g) p = g p) := by
      intro m
      induction m with
      | zero =>
        intro s₀ δ₀ _ g hg _
        refine ⟨by simpa using hg, fun p _ => by simp⟩
      | succ m ih =>
        intro s₀ δ₀ hδ₀ g hg hvan
        obtain ⟨hm_holo, hm_fac⟩ := ih s₀ δ₀ hδ₀ g hg (fun j hj => hvan j (Nat.lt_succ_of_lt hj))
        obtain ⟨hstep_holo, hstep_fac⟩ :=
          h_dslopeT_step s₀ δ₀ hδ₀ (dslopeT^[m] g) hm_holo (hvan m (Nat.lt_succ_self m))
        refine ⟨by simpa only [Function.iterate_succ_apply'] using hstep_holo, fun p hp => ?_⟩
        rw [Function.iterate_succ_apply', pow_succ, mul_assoc, hstep_fac p hp, hm_fac p hp]

    have h_den_factor :
        ∀ s₀ ∈ D_H,
          ∃ (k : ℕ) (D_t : ℂ × ℂ → ℂ),
            DifferentiableOn ℂ D_t (Metric.ball (s₀, (0 : ℂ)) (F.rad (s₀, 0))) ∧
            (∀ p ∈ Metric.ball (s₀, (0 : ℂ)) (F.rad (s₀, 0)),
              p.2 ^ k * D_t p = F.den (s₀, 0) p) ∧
            (∀ δ : ℝ, 0 < δ → δ ≤ F.rad (s₀, 0) →
              ∃ y₁ ∈ Metric.ball s₀ δ, D_t (y₁, 0) ≠ 0) := by
      intro s₀ hs₀
      let p₀ : ℂ × ℂ := (s₀, 0)
      have hp₀ : p₀ ∈ T := hSlice_sub s₀ hs₀
      let δ_rad : ℝ := F.rad p₀
      have hδ_rad : 0 < δ_rad := F.rad_pos p₀ hp₀
      let D : ℂ × ℂ → ℂ := F.den p₀
      have hD_holo : DifferentiableOn ℂ D (Metric.ball p₀ δ_rad) := F.den_holo p₀ hp₀
      have h_ex_m : ∃ m : ℕ, ∃ y ∈ Metric.ball s₀ δ_rad, (dslopeT^[m] D) (y, 0) ≠ 0 := by
        by_contra h_no_m
        have h_all_zero : ∀ m : ℕ, ∀ y ∈ Metric.ball s₀ δ_rad, (dslopeT^[m] D) (y, 0) = 0 := by
          intro m y hy
          by_contra h_nz
          exact h_no_m ⟨m, y, hy, h_nz⟩
        obtain ⟨q_star, hq_mem, hq_ne⟩ := F.den_ne_zero p₀ hp₀
        have hq_prod : q_star ∈ Metric.ball s₀ δ_rad ×ˢ Metric.ball (0 : ℂ) δ_rad :=
          (ball_prod_same s₀ (0 : ℂ) δ_rad).symm ▸ hq_mem
        have ht_ne : q_star.2 ≠ 0 := by
          intro ht0
          have h0 := h_all_zero 0 q_star.1 hq_prod.1
          simp only [Function.iterate_zero, id_eq] at h0
          apply hq_ne
          calc D q_star = D (q_star.1, q_star.2) := rfl
            _ = D (q_star.1, 0) := by rw [ht0]
            _ = 0 := h0
        have ht_pos : 0 < ‖q_star.2‖ := norm_pos_iff.mpr ht_ne
        have ht_lt : ‖q_star.2‖ < δ_rad := by simpa [Metric.mem_ball, dist_zero_right] using hq_prod.2
        let r : ℝ := (‖q_star.2‖ + δ_rad) / 2
        have hr_gt : ‖q_star.2‖ < r := by dsimp [r]; linarith
        have hr_lt : r < δ_rad := by dsimp [r]; linarith
        have hr_pos : 0 < r := lt_trans ht_pos hr_gt
        have hD_slice_holo : DifferentiableOn ℂ (fun t : ℂ => D (q_star.1, t)) (Metric.ball 0 δ_rad) := by
          refine hD_holo.comp ((differentiableOn_const q_star.1).prodMk differentiableOn_id) ?_
          intro t ht
          rw [← ball_prod_same]
          exact ⟨hq_prod.1, ht⟩
        obtain ⟨M₀, hM₀⟩ := (isCompact_closedBall (0 : ℂ) r).exists_bound_of_continuousOn
          (hD_slice_holo.continuousOn.mono (Metric.closedBall_subset_ball hr_lt))
        let M : ℝ := max M₀ 0
        have h_bound_all : ∀ m : ℕ, ‖D q_star‖ ≤ M * (‖q_star.2‖ / r) ^ m := by
          intro m
          obtain ⟨hm_holo, hm_fac⟩ :=
            h_dslopeT_iter m s₀ δ_rad hδ_rad D hD_holo (fun j _ => h_all_zero j)
          let h_m : ℂ → ℂ := fun t => (dslopeT^[m] D) (q_star.1, t)
          have hhm_holo : DifferentiableOn ℂ h_m (Metric.ball 0 δ_rad) := by
            refine hm_holo.comp ((differentiableOn_const q_star.1).prodMk differentiableOn_id) ?_
            intro t ht
            rw [← ball_prod_same]
            exact ⟨hq_prod.1, ht⟩
          have hhm_diffCont : DiffContOnCl ℂ h_m (Metric.ball (0 : ℂ) r) :=
            hhm_holo.diffContOnCl_ball (Metric.closedBall_subset_ball hr_lt)
          have h_front : ∀ z ∈ frontier (Metric.ball (0 : ℂ) r), ‖h_m z‖ ≤ M / r ^ m := by
            intro z hz
            rw [frontier_ball (0 : ℂ) hr_pos.ne', Metric.mem_sphere, dist_zero_right] at hz
            have hq_z : (q_star.1, z) ∈ Metric.ball p₀ δ_rad := by
              rw [← ball_prod_same]
              refine ⟨hq_prod.1, ?_⟩
              change z ∈ Metric.ball (0 : ℂ) δ_rad
              rw [Metric.mem_ball, dist_zero_right, hz]
              exact hr_lt
            have h_eq_z := hm_fac (q_star.1, z) hq_z
            have h_norm_z : r ^ m * ‖h_m z‖ ≤ M := by
              calc r ^ m * ‖h_m z‖ = ‖z‖ ^ m * ‖h_m z‖ := by rw [hz]
                _ = ‖z ^ m * h_m z‖ := by rw [norm_mul, norm_pow]
                _ = ‖D (q_star.1, z)‖ := by rw [h_eq_z]
                _ ≤ M₀ := hM₀ z (by rw [Metric.mem_closedBall, dist_zero_right, hz])
                _ ≤ M := le_max_left _ _
            exact (le_div_iff₀' (pow_pos hr_pos m)).mpr h_norm_z
          have h_m_pt : ‖h_m q_star.2‖ ≤ M / r ^ m :=
            Complex.norm_le_of_forall_mem_frontier_norm_le Metric.isBounded_ball hhm_diffCont h_front
              (subset_closure (by simpa [Metric.mem_ball, dist_zero_right] using hr_gt))
          calc ‖D q_star‖ = ‖q_star.2 ^ m * h_m q_star.2‖ := by rw [hm_fac q_star hq_mem]
            _ = ‖q_star.2‖ ^ m * ‖h_m q_star.2‖ := by rw [norm_mul, norm_pow]
            _ ≤ ‖q_star.2‖ ^ m * (M / r ^ m) :=
                mul_le_mul_of_nonneg_left h_m_pt (pow_nonneg (norm_nonneg _) _)
            _ = M * (‖q_star.2‖ ^ m / r ^ m) := mul_div_left_comm _ _ _
            _ = M * (‖q_star.2‖ / r) ^ m := by rw [← div_pow]
        have h_tend : Filter.Tendsto (fun m : ℕ => M * (‖q_star.2‖ / r) ^ m) Filter.atTop (nhds 0) := by
          simpa only [mul_zero] using
            tendsto_const_nhds.mul
              (tendsto_pow_atTop_nhds_zero_of_lt_one (div_nonneg (norm_nonneg _) hr_pos.le)
                ((div_lt_one hr_pos).mpr hr_gt))
        have h_le_zero : ‖D q_star‖ ≤ 0 :=
          le_of_tendsto_of_tendsto' tendsto_const_nhds h_tend h_bound_all
        exact (lt_irrefl (0 : ℝ)) (lt_of_lt_of_le (norm_pos_iff.mpr hq_ne) h_le_zero)
      let k : ℕ := Nat.find h_ex_m
      obtain ⟨y₁, hy₁_mem, hy₁_ne⟩ := Nat.find_spec h_ex_m
      have hk_min : ∀ j < k, ∀ y ∈ Metric.ball s₀ δ_rad, (dslopeT^[j] D) (y, 0) = 0 := by
        intro j hj y hy
        by_contra hy_ne
        exact Nat.find_min h_ex_m hj ⟨y, hy, hy_ne⟩
      obtain ⟨hk_holo, hk_fac⟩ := h_dslopeT_iter k s₀ δ_rad hδ_rad D hD_holo hk_min
      refine ⟨k, dslopeT^[k] D, hk_holo, hk_fac, fun δ hδ _hδ_le => ?_⟩
      by_contra h_no_y
      have h_sub_zero : ∀ y ∈ Metric.ball s₀ δ, (dslopeT^[k] D) (y, 0) = 0 := by
        intro y hy; by_contra h_nz; exact h_no_y ⟨y, hy, h_nz⟩
      have h_slice_an : AnalyticOnNhd ℂ (fun y : ℂ => (dslopeT^[k] D) (y, 0)) (Metric.ball s₀ δ_rad) := by
        refine (hk_holo.comp (differentiableOn_id.prodMk (differentiableOn_const 0)) ?_).analyticOnNhd
          Metric.isOpen_ball
        intro y hy
        rw [← ball_prod_same]
        exact ⟨hy, Metric.mem_ball_self hδ_rad⟩
      have h_ev_zero : (fun y : ℂ => (dslopeT^[k] D) (y, 0)) =ᶠ[nhds s₀] 0 := by
        filter_upwards [Metric.isOpen_ball.mem_nhds (Metric.mem_ball_self hδ)] with y hy
        exact h_sub_zero y hy
      have h_eq_all := h_slice_an.eqOn_zero_of_preconnected_of_eventuallyEq_zero
        (convex_ball s₀ δ_rad).isPreconnected (Metric.mem_ball_self hδ_rad) h_ev_zero
      exact hy₁_ne (h_eq_all hy₁_mem)

    let HasChart : ℂ → Prop := fun s₀ =>
      ∃ (δ : ℝ) (N_t D_t : ℂ × ℂ → ℂ),
        0 < δ ∧ δ ≤ F.rad (s₀, 0) ∧
        Metric.ball s₀ δ ⊆ D_H ∧
        DifferentiableOn ℂ N_t (Metric.ball (s₀, (0 : ℂ)) δ) ∧
        DifferentiableOn ℂ D_t (Metric.ball (s₀, (0 : ℂ)) δ) ∧
        (∃ z₁ ∈ Metric.ball s₀ δ, D_t (z₁, 0) ≠ 0) ∧
        (∀ q ∈ Metric.ball (s₀, (0 : ℂ)) δ,
          F.num (s₀, 0) q * D_t q = N_t q * F.den (s₀, 0) q)

    have h0_chart : HasChart 0 := by
      obtain ⟨r₀, hr₀_pos, hr₀_rad, hr₀_U, hr₀_eq⟩ := hf_agrees.2 (0, 0) h00_U_base2
      obtain ⟨r₁, hr₁_pos, hr₁_DH⟩ := Metric.isOpen_iff.mp hDH_open 0 h0_DH
      let δ := min r₀ r₁
      have hδ_pos : 0 < δ := lt_min hr₀_pos hr₁_pos
      refine ⟨δ, f_init, fun _ => 1, hδ_pos, le_trans (min_le_left _ _) hr₀_rad,
        Set.Subset.trans (Metric.ball_subset_ball (min_le_right _ _)) hr₁_DH,
        hf_holo.mono (Set.Subset.trans (Metric.ball_subset_ball (min_le_left _ _)) hr₀_U),
        differentiableOn_const 1,
        ⟨0, Metric.mem_ball_self hδ_pos, one_ne_zero⟩,
        fun q hq => ?_⟩
      simp only [mul_one]
      exact hr₀_eq q (Metric.ball_subset_ball (min_le_left _ _) hq)

    let S_good : Set ℂ := {s ∈ D_H | HasChart s}
    let S_bad : Set ℂ := {s ∈ D_H | ¬ HasChart s}

    have h_good_open : IsOpen S_good := by
      rw [Metric.isOpen_iff]
      intro s₀ ⟨hs₀_DH, δ₀, N₀, D₀, hδ₀_pos, hδ₀_rad, hδ₀_DH, hN₀_holo, hD₀_holo, ⟨z₁, hz₁_mem, hz₁_ne⟩, h_eq₀⟩
      refine ⟨δ₀, hδ₀_pos, fun s₁ hs₁ => ?_⟩
      have hs₁_DH : s₁ ∈ D_H := hδ₀_DH hs₁
      refine ⟨hs₁_DH, ?_⟩
      have h_gap : 0 < δ₀ - dist s₁ s₀ := sub_pos.mpr (Metric.mem_ball.mp hs₁)
      let δ₁ : ℝ := min (δ₀ - dist s₁ s₀) (F.rad (s₁, 0))
      have hδ₁_pos : 0 < δ₁ := lt_min h_gap (F.rad_pos (s₁, 0) (hSlice_sub s₁ hs₁_DH))
      have h_sub_1d : Metric.ball s₁ δ₁ ⊆ Metric.ball s₀ δ₀ := by
        intro z hz
        rw [Metric.mem_ball] at hz ⊢
        have h_le : δ₁ ≤ δ₀ - dist s₁ s₀ := min_le_left _ _
        linarith [dist_triangle z s₁ s₀]
      have h_sub_2d : Metric.ball (s₁, (0 : ℂ)) δ₁ ⊆ Metric.ball (s₀, (0 : ℂ)) δ₀ := by
        intro q hq
        rw [← ball_prod_same] at hq ⊢
        exact ⟨h_sub_1d hq.1, Metric.ball_subset_ball (le_trans (min_le_left _ _) (sub_le_self _ dist_nonneg)) hq.2⟩
      have h_nz_1d : ∃ z₂ ∈ Metric.ball s₁ δ₁, D₀ (z₂, 0) ≠ 0 := by
        by_contra h_no_z
        have h_all_z : ∀ y ∈ Metric.ball s₁ δ₁, D₀ (y, 0) = 0 := by
          intro y hy; by_contra h_nz; exact h_no_z ⟨y, hy, h_nz⟩
        have h_an : AnalyticOnNhd ℂ (fun y : ℂ => D₀ (y, 0)) (Metric.ball s₀ δ₀) := by
          refine (hD₀_holo.comp (differentiableOn_id.prodMk (differentiableOn_const 0)) ?_).analyticOnNhd
            Metric.isOpen_ball
          intro y hy
          rw [← ball_prod_same]
          exact ⟨hy, Metric.mem_ball_self hδ₀_pos⟩
        have h_ev : (fun y : ℂ => D₀ (y, 0)) =ᶠ[nhds s₁] 0 := by
          filter_upwards [Metric.isOpen_ball.mem_nhds (Metric.mem_ball_self hδ₁_pos)] with y hy
          exact h_all_z y hy
        exact hz₁_ne (h_an.eqOn_zero_of_preconnected_of_eventuallyEq_zero
          (convex_ball s₀ δ₀).isPreconnected hs₁ h_ev hz₁_mem)
      refine ⟨δ₁, N₀, D₀, hδ₁_pos, min_le_right _ _, Set.Subset.trans h_sub_1d hδ₀_DH,
        hN₀_holo.mono h_sub_2d, hD₀_holo.mono h_sub_2d, h_nz_1d, ?_⟩
      exact h_compat_transfer (hSlice_sub s₀ hs₀_DH) (hSlice_sub s₁ hs₁_DH)
        Metric.isOpen_ball
        (Set.Subset.trans h_sub_2d (Metric.ball_subset_ball hδ₀_rad))
        (Metric.ball_subset_ball (min_le_right _ _))
        (hN₀_holo.continuousOn.mono h_sub_2d) (hD₀_holo.continuousOn.mono h_sub_2d)
        (fun q hq => h_eq₀ q (h_sub_2d hq))

    have h_bad_open : IsOpen S_bad := by
      rw [Metric.isOpen_iff]
      intro s₀ ⟨hs₀_DH, hs₀_not⟩
      obtain ⟨r_D, hr_D_pos, hr_D_sub⟩ := Metric.isOpen_iff.mp hDH_open s₀ hs₀_DH
      let δ : ℝ := min r_D (F.rad (s₀, 0))
      have hδ_pos : 0 < δ := lt_min hr_D_pos (F.rad_pos (s₀, 0) (hSlice_sub s₀ hs₀_DH))
      have hδ_rad : δ ≤ F.rad (s₀, 0) := min_le_right _ _
      have hδ_DH : Metric.ball s₀ δ ⊆ D_H :=
        Set.Subset.trans (Metric.ball_subset_ball (min_le_left _ _)) hr_D_sub
      refine ⟨δ, hδ_pos, fun s₁ hs₁ => ⟨hδ_DH hs₁, ?_⟩⟩
      intro hs₁_chart
      apply hs₀_not
      obtain ⟨δ₁, N₁, D₁, hδ₁_pos, hδ₁_rad, _, hN₁_holo, hD₁_holo, ⟨z₁, hz₁_mem, hz₁_ne⟩, h_eq₁⟩ := hs₁_chart
      obtain ⟨k, D_t, hDt_holo_rad, hDt_fac_rad, hDt_nz⟩ := h_den_factor s₀ hs₀_DH
      have hDt_holo : DifferentiableOn ℂ D_t (Metric.ball (s₀, (0 : ℂ)) δ) :=
        hDt_holo_rad.mono (Metric.ball_subset_ball hδ_rad)
      let V₁ : Set ℂ := Metric.ball s₀ δ ∩ Metric.ball s₁ δ₁
      have hs₁_V₁ : s₁ ∈ V₁ := ⟨hs₁, Metric.mem_ball_self hδ₁_pos⟩
      have hV₁_open : IsOpen V₁ := Metric.isOpen_ball.inter Metric.isOpen_ball
      have h_ex_zstar : ∃ z_star ∈ V₁, D₁ (z_star, 0) ≠ 0 := by
        by_contra h_no_z
        have h_all_z : ∀ y ∈ V₁, D₁ (y, 0) = 0 := by
          intro y hy; by_contra h_nz; exact h_no_z ⟨y, hy, h_nz⟩
        have h_an : AnalyticOnNhd ℂ (fun y : ℂ => D₁ (y, 0)) (Metric.ball s₁ δ₁) := by
          refine (hD₁_holo.comp (differentiableOn_id.prodMk (differentiableOn_const 0)) ?_).analyticOnNhd
            Metric.isOpen_ball
          intro y hy
          rw [← ball_prod_same]
          exact ⟨hy, Metric.mem_ball_self hδ₁_pos⟩
        have h_ev : (fun y : ℂ => D₁ (y, 0)) =ᶠ[nhds s₁] 0 := by
          filter_upwards [hV₁_open.mem_nhds hs₁_V₁] with y hy
          exact h_all_z y hy
        exact hz₁_ne (h_an.eqOn_zero_of_preconnected_of_eventuallyEq_zero
          (convex_ball s₁ δ₁).isPreconnected (Metric.mem_ball_self hδ₁_pos) h_ev hz₁_mem)
      obtain ⟨z_star, ⟨hz_s₀, hz_s₁⟩, hz_ne⟩ := h_ex_zstar
      have hz_2d_1 : (z_star, (0 : ℂ)) ∈ Metric.ball (s₁, (0 : ℂ)) δ₁ := by
        rw [← ball_prod_same]
        exact ⟨hz_s₁, Metric.mem_ball_self hδ₁_pos⟩
      have h_cont_z : ContinuousAt D₁ (z_star, (0 : ℂ)) :=
        hD₁_holo.continuousOn.continuousAt (Metric.isOpen_ball.mem_nhds hz_2d_1)
      obtain ⟨η₀, hη₀_pos, hη₀_nz⟩ := Metric.eventually_nhds_iff.mp (h_cont_z.eventually_ne hz_ne)
      let η : ℝ := min η₀ (min (δ - dist z_star s₀) (δ₁ - dist z_star s₁))
      have hη_pos : 0 < η := lt_min hη₀_pos
        (lt_min (sub_pos.mpr (Metric.mem_ball.mp hz_s₀)) (sub_pos.mpr (Metric.mem_ball.mp hz_s₁)))
      have hη_sub_s₀ : Metric.ball (z_star, (0 : ℂ)) η ⊆ Metric.ball (s₀, (0 : ℂ)) δ := by
        intro q hq
        rw [← ball_prod_same] at hq ⊢
        refine ⟨?_, Metric.ball_subset_ball (le_trans (min_le_right _ _) (le_trans (min_le_left _ _) (sub_le_self _ dist_nonneg))) hq.2⟩
        have hq1 : dist q.1 z_star < η := Metric.mem_ball.mp hq.1
        have h_le : η ≤ δ - dist z_star s₀ := le_trans (min_le_right _ _) (min_le_left _ _)
        rw [Metric.mem_ball]
        linarith [dist_triangle q.1 z_star s₀]
      have hη_sub_s₁ : Metric.ball (z_star, (0 : ℂ)) η ⊆ Metric.ball (s₁, (0 : ℂ)) δ₁ := by
        intro q hq
        rw [← ball_prod_same] at hq ⊢
        refine ⟨?_, Metric.ball_subset_ball (le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (sub_le_self _ dist_nonneg))) hq.2⟩
        have hq1 : dist q.1 z_star < η := Metric.mem_ball.mp hq.1
        have h_le : η ≤ δ₁ - dist z_star s₁ := le_trans (min_le_right _ _) (min_le_right _ _)
        rw [Metric.mem_ball]
        linarith [dist_triangle q.1 z_star s₁]
      have h_trans_η : ∀ q ∈ Metric.ball (z_star, (0 : ℂ)) η,
          F.num (s₀, 0) q * D₁ q = N₁ q * F.den (s₀, 0) q :=
        h_compat_transfer (hSlice_sub s₁ (hδ_DH hs₁)) (hSlice_sub s₀ hs₀_DH)
          Metric.isOpen_ball
          (Set.Subset.trans hη_sub_s₁ (Metric.ball_subset_ball hδ₁_rad))
          (Set.Subset.trans hη_sub_s₀ (Metric.ball_subset_ball hδ_rad))
          (hN₁_holo.continuousOn.mono hη_sub_s₁)
          (hD₁_holo.continuousOn.mono hη_sub_s₁)
          (fun q hq => h_eq₁ q (hη_sub_s₁ hq))
      let N : ℂ × ℂ → ℂ := F.num (s₀, 0)
      have hN_holo : DifferentiableOn ℂ N (Metric.ball (s₀, (0 : ℂ)) δ) :=
        (F.num_holo (s₀, 0) (hSlice_sub s₀ hs₀_DH)).mono (Metric.ball_subset_ball hδ_rad)
      have hN_van : ∀ m : ℕ, m ≤ k → ∀ j < m, ∀ y ∈ Metric.ball s₀ δ, (dslopeT^[j] N) (y, 0) = 0 := by
        intro m
        induction m with
        | zero => intro _ j hj; exact absurd hj (Nat.not_lt_zero j)
        | succ m ih =>
          intro hm_le j hj
          have hm_prev := ih (Nat.le_of_succ_le hm_le)
          rcases lt_or_eq_of_le (Nat.le_of_lt_succ hj) with hj_lt | hj_eq
          · exact hm_prev j hj_lt
          · rw [hj_eq]
            obtain ⟨hm_holo, hm_fac⟩ := h_dslopeT_iter m s₀ δ hδ_pos N hN_holo hm_prev
            have h_zero_η : ∀ y ∈ Metric.ball z_star η, (dslopeT^[m] N) (y, 0) = 0 := by
              intro y hy
              let t_seq : ℕ → ℂ := fun n => ((η / (2 * ((n : ℝ) + 1)) : ℝ) : ℂ)
              have ht_tend : Filter.Tendsto t_seq Filter.atTop (nhds 0) := by
                have h_real : Filter.Tendsto (fun n : ℕ => η / (2 * ((n : ℝ) + 1))) Filter.atTop (nhds 0) := by
                  have h_atTop : Filter.Tendsto (fun n : ℕ => 2 * ((n : ℝ) + 1)) Filter.atTop Filter.atTop :=
                    Filter.Tendsto.const_mul_atTop (by norm_num)
                      (tendsto_natCast_atTop_atTop.atTop_add tendsto_const_nhds)
                  exact tendsto_const_nhds.div_atTop h_atTop
                have hc := Complex.continuous_ofReal.continuousAt.tendsto.comp h_real
                rw [Complex.ofReal_zero] at hc
                exact hc
              have hy0_η : (y, (0 : ℂ)) ∈ Metric.ball (z_star, (0 : ℂ)) η := by
                rw [← ball_prod_same]
                exact ⟨hy, Metric.mem_ball_self hη_pos⟩
              have h_seq_eq : ∀ n : ℕ,
                  (dslopeT^[m] N) (y, t_seq n) * D₁ (y, t_seq n) =
                  t_seq n ^ (k - m) * N₁ (y, t_seq n) * D_t (y, t_seq n) := by
                intro n
                have h_pos_n : 0 < η / (2 * ((n : ℝ) + 1)) :=
                  div_pos hη_pos (by positivity)
                have h_lt_n : η / (2 * ((n : ℝ) + 1)) < η := by
                  have h_den_gt : (1 : ℝ) < 2 * ((n : ℝ) + 1) := by
                    have : (0 : ℝ) ≤ (n : ℝ) := Nat.cast_nonneg n
                    linarith
                  exact div_lt_self hη_pos h_den_gt
                have ht_ne : t_seq n ≠ 0 := Complex.ofReal_ne_zero.mpr h_pos_n.ne'
                have hq_η : (y, t_seq n) ∈ Metric.ball (z_star, (0 : ℂ)) η := by
                  rw [← ball_prod_same]
                  refine ⟨hy, ?_⟩
                  change t_seq n ∈ Metric.ball (0 : ℂ) η
                  rw [Metric.mem_ball, dist_zero_right, Complex.norm_real, Real.norm_eq_abs,
                    abs_of_pos h_pos_n]
                  exact h_lt_n
                have hq_s₀ : (y, t_seq n) ∈ Metric.ball (s₀, (0 : ℂ)) δ := hη_sub_s₀ hq_η
                have hq_rad : (y, t_seq n) ∈ Metric.ball (s₀, (0 : ℂ)) (F.rad (s₀, 0)) :=
                  Metric.ball_subset_ball hδ_rad hq_s₀
                have h1 := hm_fac (y, t_seq n) hq_s₀
                have h2 := h_trans_η (y, t_seq n) hq_η
                have h3 := hDt_fac_rad (y, t_seq n) hq_rad
                have hk_split : k = m + (k - m) := (Nat.add_sub_of_le (Nat.le_of_succ_le hm_le)).symm
                apply mul_left_cancel₀ (pow_ne_zero m ht_ne)
                calc t_seq n ^ m * ((dslopeT^[m] N) (y, t_seq n) * D₁ (y, t_seq n))
                    = (t_seq n ^ m * (dslopeT^[m] N) (y, t_seq n)) * D₁ (y, t_seq n) := by ring
                  _ = N (y, t_seq n) * D₁ (y, t_seq n) := by rw [h1]
                  _ = N₁ (y, t_seq n) * F.den (s₀, 0) (y, t_seq n) := h2
                  _ = N₁ (y, t_seq n) * (t_seq n ^ k * D_t (y, t_seq n)) := by rw [← h3]
                  _ = N₁ (y, t_seq n) * ((t_seq n ^ m * t_seq n ^ (k - m)) * D_t (y, t_seq n)) := by
                      rw [← pow_add, ← hk_split]
                  _ = t_seq n ^ m * (t_seq n ^ (k - m) * N₁ (y, t_seq n) * D_t (y, t_seq n)) := by ring
              have h_pt_tend : Filter.Tendsto (fun n : ℕ => (y, t_seq n)) Filter.atTop (nhds (y, (0 : ℂ))) :=
                tendsto_const_nhds.prodMk_nhds ht_tend
              have h_lhs_tend : Filter.Tendsto
                  (fun n : ℕ => (dslopeT^[m] N) (y, t_seq n) * D₁ (y, t_seq n))
                  Filter.atTop (nhds ((dslopeT^[m] N) (y, 0) * D₁ (y, 0))) :=
                ((hm_holo.continuousOn.continuousAt (Metric.isOpen_ball.mem_nhds (hη_sub_s₀ hy0_η))).tendsto.comp h_pt_tend).mul
                  ((hD₁_holo.continuousOn.continuousAt (Metric.isOpen_ball.mem_nhds (hη_sub_s₁ hy0_η))).tendsto.comp h_pt_tend)
              have hk_sub_ne : k - m ≠ 0 := by omega
              have h_rhs_tend : Filter.Tendsto
                  (fun n : ℕ => t_seq n ^ (k - m) * N₁ (y, t_seq n) * D_t (y, t_seq n))
                  Filter.atTop (nhds 0) := by
                have h_pow0 : (0 : ℂ) ^ (k - m) = 0 := zero_pow hk_sub_ne
                have h_t_pow : Filter.Tendsto (fun n : ℕ => t_seq n ^ (k - m)) Filter.atTop (nhds 0) := by
                  simpa [h_pow0] using ht_tend.pow (k - m)
                simpa using (h_t_pow.mul
                  ((hN₁_holo.continuousOn.continuousAt (Metric.isOpen_ball.mem_nhds (hη_sub_s₁ hy0_η))).tendsto.comp h_pt_tend)).mul
                  ((hDt_holo.continuousOn.continuousAt (Metric.isOpen_ball.mem_nhds (hη_sub_s₀ hy0_η))).tendsto.comp h_pt_tend)
              have h_lim_eq : (dslopeT^[m] N) (y, 0) * D₁ (y, 0) = 0 :=
                tendsto_nhds_unique h_lhs_tend (by simpa only [← h_seq_eq] using h_rhs_tend)
              have hD1_y0_ne : D₁ (y, 0) ≠ 0 :=
                hη₀_nz (lt_of_lt_of_le (Metric.mem_ball.mp hy0_η) (min_le_left _ _))
              exact (mul_eq_zero.mp h_lim_eq).resolve_right hD1_y0_ne
            have h_an_m : AnalyticOnNhd ℂ (fun y : ℂ => (dslopeT^[m] N) (y, 0)) (Metric.ball s₀ δ) := by
              refine (hm_holo.comp (differentiableOn_id.prodMk (differentiableOn_const 0)) ?_).analyticOnNhd
                Metric.isOpen_ball
              intro y hy
              rw [← ball_prod_same]
              exact ⟨hy, Metric.mem_ball_self hδ_pos⟩
            have h_ev_m : (fun y : ℂ => (dslopeT^[m] N) (y, 0)) =ᶠ[nhds z_star] 0 := by
              filter_upwards [Metric.isOpen_ball.mem_nhds (Metric.mem_ball_self hη_pos)] with y hy
              exact h_zero_η y hy
            exact h_an_m.eqOn_zero_of_preconnected_of_eventuallyEq_zero
              (convex_ball s₀ δ).isPreconnected hz_s₀ h_ev_m
      obtain ⟨hNk_holo, hNk_fac⟩ := h_dslopeT_iter k s₀ δ hδ_pos N hN_holo (hN_van k le_rfl)
      refine ⟨δ, dslopeT^[k] N, D_t, hδ_pos, hδ_rad, hδ_DH, hNk_holo, hDt_holo,
        hDt_nz δ hδ_pos hδ_rad, fun q hq => ?_⟩
      have hq_rad : q ∈ Metric.ball (s₀, (0 : ℂ)) (F.rad (s₀, 0)) := Metric.ball_subset_ball hδ_rad hq
      calc F.num (s₀, 0) q * D_t q
          = (q.2 ^ k * (dslopeT^[k] N) q) * D_t q := by rw [hNk_fac q hq]
        _ = (dslopeT^[k] N) q * (q.2 ^ k * D_t q) := by ring
        _ = (dslopeT^[k] N) q * F.den (s₀, 0) q := by rw [hDt_fac_rad q hq_rad]

    have h_all_chart : ∀ s ∈ D_H, HasChart s := by
      intro s hs
      by_contra hs_not
      have h_sub_union : D_H ⊆ S_good ∪ S_bad := fun z hz =>
        by_cases (fun h : HasChart z => Or.inl ⟨hz, h⟩) (fun h => Or.inr ⟨hz, h⟩)
      obtain ⟨w, _, hw_good, hw_bad⟩ :=
        hDH_preconn S_good S_bad h_good_open h_bad_open h_sub_union
          ⟨0, h0_DH, h0_DH, h0_chart⟩ ⟨s, hs, hs, hs_not⟩
      exact hw_bad.2 hw_good.2

    let δ_fn : ℂ → ℝ := fun s => if hs : s ∈ D_H then Classical.choose (h_all_chart s hs) else 1
    let N_fn : ℂ → (ℂ × ℂ → ℂ) := fun s =>
      if hs : s ∈ D_H then Classical.choose (Classical.choose_spec (h_all_chart s hs)) else fun _ => 0
    let D_fn : ℂ → (ℂ × ℂ → ℂ) := fun s =>
      if hs : s ∈ D_H then
        Classical.choose (Classical.choose_spec (Classical.choose_spec (h_all_chart s hs)))
      else fun _ => 1

    have h_spec : ∀ s (hs : s ∈ D_H),
        0 < δ_fn s ∧ δ_fn s ≤ F.rad (s, 0) ∧
        Metric.ball s (δ_fn s) ⊆ D_H ∧
        DifferentiableOn ℂ (N_fn s) (Metric.ball (s, (0 : ℂ)) (δ_fn s)) ∧
        DifferentiableOn ℂ (D_fn s) (Metric.ball (s, (0 : ℂ)) (δ_fn s)) ∧
        (∃ z₁ ∈ Metric.ball s (δ_fn s), D_fn s (z₁, 0) ≠ 0) ∧
        (∀ q ∈ Metric.ball (s, (0 : ℂ)) (δ_fn s),
          F.num (s, 0) q * D_fn s q = N_fn s q * F.den (s, 0) q) := by
      intro s hs
      simp only [δ_fn, N_fn, D_fn, hs, ↓reduceDIte]
      exact Classical.choose_spec (Classical.choose_spec (Classical.choose_spec (h_all_chart s hs)))

    refine ⟨δ_fn, N_fn, D_fn,
      fun s hs => (h_spec s hs).1,
      fun s hs => (h_spec s hs).2.2.1,
      fun s hs z hz => ?_,
      fun s hs => (h_spec s hs).2.2.2.1,
      fun s hs => (h_spec s hs).2.2.2.2.1,
      fun s₁ hs₁ s₂ hs₂ z ⟨hz₁, hz₂⟩ => ?_,
      fun s hs z hz hDz_ne => ?_,
      fun s hs U g _hU_open hsU hg_holo hg_agrees => ?_⟩
    · obtain ⟨hδ_pos, _, _, _, hD_holo, ⟨z₁, hz₁_mem, hz₁_ne⟩, _⟩ := h_spec s hs
      have h_an : AnalyticOnNhd ℂ (fun w : ℂ => D_fn s (w, 0)) (Metric.ball s (δ_fn s)) := by
        refine (hD_holo.comp (differentiableOn_id.prodMk (differentiableOn_const 0)) ?_).analyticOnNhd
          Metric.isOpen_ball
        intro w hw
        rw [← ball_prod_same]
        exact ⟨hw, Metric.mem_ball_self hδ_pos⟩
      rcases (h_an z hz).eventually_eq_zero_or_eventually_ne_zero with h_ev0 | h_ev_ne
      · exfalso
        exact hz₁_ne (h_an.eqOn_zero_of_preconnected_of_eventuallyEq_zero
          (convex_ball s (δ_fn s)).isPreconnected hz h_ev0 hz₁_mem)
      · exact h_ev_ne
    · obtain ⟨_, hδ₁_rad, hδ₁_DH, hN₁_holo, hD₁_holo, _, h_eq₁⟩ := h_spec s₁ hs₁
      obtain ⟨_, hδ₂_rad, _, hN₂_holo, hD₂_holo, _, h_eq₂⟩ := h_spec s₂ hs₂
      have hz_DH : z ∈ D_H := hδ₁_DH hz₁
      have hp_z : (z, (0 : ℂ)) ∈ T := hSlice_sub z hz_DH
      let η : ℝ := min (F.rad (z, 0)) (min (δ_fn s₁ - dist z s₁) (δ_fn s₂ - dist z s₂))
      have hη_pos : 0 < η := lt_min (F.rad_pos (z, 0) hp_z)
        (lt_min (sub_pos.mpr (Metric.mem_ball.mp hz₁)) (sub_pos.mpr (Metric.mem_ball.mp hz₂)))
      have h_sub₁ : Metric.ball (z, (0 : ℂ)) η ⊆ Metric.ball (s₁, (0 : ℂ)) (δ_fn s₁) := by
        intro q hq
        rw [← ball_prod_same] at hq ⊢
        refine ⟨?_, Metric.ball_subset_ball (le_trans (min_le_right _ _) (le_trans (min_le_left _ _) (sub_le_self _ dist_nonneg))) hq.2⟩
        have hq1 : dist q.1 z < η := Metric.mem_ball.mp hq.1
        have h_le : η ≤ δ_fn s₁ - dist z s₁ := le_trans (min_le_right _ _) (min_le_left _ _)
        rw [Metric.mem_ball]
        linarith [dist_triangle q.1 z s₁]
      have h_sub₂ : Metric.ball (z, (0 : ℂ)) η ⊆ Metric.ball (s₂, (0 : ℂ)) (δ_fn s₂) := by
        intro q hq
        rw [← ball_prod_same] at hq ⊢
        refine ⟨?_, Metric.ball_subset_ball (le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (sub_le_self _ dist_nonneg))) hq.2⟩
        have hq1 : dist q.1 z < η := Metric.mem_ball.mp hq.1
        have h_le : η ≤ δ_fn s₂ - dist z s₂ := le_trans (min_le_right _ _) (min_le_right _ _)
        rw [Metric.mem_ball]
        linarith [dist_triangle q.1 z s₂]
      have h_tr₁ := h_compat_transfer (hSlice_sub s₁ hs₁) hp_z Metric.isOpen_ball
        (Set.Subset.trans h_sub₁ (Metric.ball_subset_ball hδ₁_rad))
        (Metric.ball_subset_ball (min_le_left _ _))
        (hN₁_holo.continuousOn.mono h_sub₁) (hD₁_holo.continuousOn.mono h_sub₁)
        (fun q hq => h_eq₁ q (h_sub₁ hq))
      have h_tr₂ := h_compat_transfer (hSlice_sub s₂ hs₂) hp_z Metric.isOpen_ball
        (Set.Subset.trans h_sub₂ (Metric.ball_subset_ball hδ₂_rad))
        (Metric.ball_subset_ball (min_le_left _ _))
        (hN₂_holo.continuousOn.mono h_sub₂) (hD₂_holo.continuousOn.mono h_sub₂)
        (fun q hq => h_eq₂ q (h_sub₂ hq))
      by_contra h_cross_ne
      let g_cr : ℂ × ℂ → ℂ := fun q => N_fn s₁ q * D_fn s₂ q - N_fn s₂ q * D_fn s₁ q
      have hg_ne : g_cr (z, 0) ≠ 0 := sub_ne_zero.mpr h_cross_ne
      have hg_cont : ContinuousAt g_cr (z, 0) :=
        (((hN₁_holo.continuousOn.mono h_sub₁).mul (hD₂_holo.continuousOn.mono h_sub₂)).sub
          ((hN₂_holo.continuousOn.mono h_sub₂).mul (hD₁_holo.continuousOn.mono h_sub₁))).continuousAt
          (Metric.isOpen_ball.mem_nhds (Metric.mem_ball_self hη_pos))
      obtain ⟨η', hη'_pos, hη'_nz⟩ := Metric.eventually_nhds_iff.mp (hg_cont.eventually_ne hg_ne)
      let η₂ := min η η'
      have hη₂_pos : 0 < η₂ := lt_min hη_pos hη'_pos
      have h_den_zero : ∀ q ∈ Metric.ball (z, (0 : ℂ)) η₂, F.den (z, 0) q = 0 := by
        intro q hq
        have hq_η : q ∈ Metric.ball (z, (0 : ℂ)) η := Metric.ball_subset_ball (min_le_left _ _) hq
        have h_mul : g_cr q * F.den (z, 0) q = 0 := by
          dsimp only [g_cr]
          calc (N_fn s₁ q * D_fn s₂ q - N_fn s₂ q * D_fn s₁ q) * F.den (z, 0) q
              = (N_fn s₁ q * F.den (z, 0) q) * D_fn s₂ q -
                  (N_fn s₂ q * F.den (z, 0) q) * D_fn s₁ q := by ring
            _ = (F.num (z, 0) q * D_fn s₁ q) * D_fn s₂ q -
                  (F.num (z, 0) q * D_fn s₂ q) * D_fn s₁ q := by rw [← h_tr₁ q hq_η, ← h_tr₂ q hq_η]
            _ = 0 := by ring
        exact (mul_eq_zero.mp h_mul).resolve_left
          (hη'_nz (lt_of_lt_of_le (Metric.mem_ball.mp hq) (min_le_right _ _)))
      obtain ⟨q_nz, hq_nz_mem, hq_nz⟩ := F.den_ne_zero (z, 0) hp_z
      exact hq_nz (heqOn_zero_ball (Metric.mem_ball_self (F.rad_pos (z, 0) hp_z)) hη₂_pos
        (F.den_holo (z, 0) hp_z) h_den_zero q_nz hq_nz_mem)
    · obtain ⟨hδ_pos, hδ_rad, _, hN_holo, hD_holo, _, h_eq⟩ := h_spec s hs
      have hz_2d : (z, (0 : ℂ)) ∈ Metric.ball (s, (0 : ℂ)) (δ_fn s) := by
        rw [← ball_prod_same]
        exact ⟨hz, Metric.mem_ball_self hδ_pos⟩
      have hD_cont : ContinuousAt (D_fn s) (z, 0) :=
        hD_holo.continuousOn.continuousAt (Metric.isOpen_ball.mem_nhds hz_2d)
      obtain ⟨r₀, hr₀_pos, hr₀_nz⟩ := Metric.eventually_nhds_iff.mp (hD_cont.eventually_ne hDz_ne)
      let r_z : ℝ := min r₀ (δ_fn s - dist z s)
      have hrz_pos : 0 < r_z := lt_min hr₀_pos (sub_pos.mpr (Metric.mem_ball.mp hz))
      have h_sub_1d : Metric.ball z r_z ⊆ Metric.ball s (δ_fn s) := by
        intro w hw
        rw [Metric.mem_ball] at hw ⊢
        have h_le : r_z ≤ δ_fn s - dist z s := min_le_right _ _
        linarith [dist_triangle w z s]
      have h_sub_2d : Metric.ball (z, (0 : ℂ)) r_z ⊆ Metric.ball (s, (0 : ℂ)) (δ_fn s) := by
        intro q hq
        rw [← ball_prod_same] at hq ⊢
        exact ⟨h_sub_1d hq.1, Metric.ball_subset_ball (le_trans (min_le_right _ _) (sub_le_self _ dist_nonneg)) hq.2⟩
      have h_sub_T : Metric.ball (z, (0 : ℂ)) r_z ⊆ T :=
        Set.Subset.trans h_sub_2d
          (Set.Subset.trans (Metric.ball_subset_ball hδ_rad) (F.ball_sub (s, 0) (hSlice_sub s hs)))
      have h_nz_ball : ∀ q ∈ Metric.ball (z, (0 : ℂ)) r_z, D_fn s q ≠ 0 :=
        fun q hq => hr₀_nz (lt_of_lt_of_le (Metric.mem_ball.mp hq) (min_le_left _ _))
      have h_quot_holo : DifferentiableOn ℂ (fun q => N_fn s q / D_fn s q) (Metric.ball (z, (0 : ℂ)) r_z) := by
        have h_eq_div : (fun q => N_fn s q / D_fn s q) = (N_fn s * fun x => (D_fn s x)⁻¹) :=
          funext (fun _ => div_eq_mul_inv _ _)
        rw [h_eq_div]
        intro q hq
        have hN_at : DifferentiableAt ℂ (N_fn s) q :=
          (hN_holo.mono h_sub_2d).differentiableAt (Metric.isOpen_ball.mem_nhds hq)
        have hD_at : DifferentiableAt ℂ (D_fn s) q :=
          (hD_holo.mono h_sub_2d).differentiableAt (Metric.isOpen_ball.mem_nhds hq)
        have h_inv_at : DifferentiableAt ℂ (fun x => (D_fn s x)⁻¹) q :=
          (differentiableAt_inv (h_nz_ball q hq)).comp q hD_at
        exact (hN_at.mul h_inv_at).differentiableWithinAt
      refine ⟨r_z, hrz_pos, h_sub_1d, h_sub_T, h_quot_holo, ⟨h_sub_T, fun p hp => ?_⟩⟩
      have hp_T : p ∈ T := h_sub_T hp
      let r_p : ℝ := min (r_z - dist p (z, 0)) (F.rad p)
      have hrp_pos : 0 < r_p := lt_min (sub_pos.mpr (Metric.mem_ball.mp hp)) (F.rad_pos p hp_T)
      have hrp_sub_rz : Metric.ball p r_p ⊆ Metric.ball (z, (0 : ℂ)) r_z := by
        intro q hq
        rw [Metric.mem_ball] at hq ⊢
        have h_le : r_p ≤ r_z - dist p (z, 0) := min_le_left _ _
        linarith [dist_triangle q p (z, 0)]
      have h_tr := h_compat_transfer (hSlice_sub s hs) hp_T Metric.isOpen_ball
        (Set.Subset.trans (Set.Subset.trans hrp_sub_rz h_sub_2d) (Metric.ball_subset_ball hδ_rad))
        (Metric.ball_subset_ball (min_le_right _ _))
        (hN_holo.continuousOn.mono (Set.Subset.trans hrp_sub_rz h_sub_2d))
        (hD_holo.continuousOn.mono (Set.Subset.trans hrp_sub_rz h_sub_2d))
        (fun q hq => h_eq q (h_sub_2d (hrp_sub_rz hq)))
      refine ⟨r_p, hrp_pos, min_le_right _ _, hrp_sub_rz, fun q hq => ?_⟩
      have hDs_ne : D_fn s q ≠ 0 := h_nz_ball q (hrp_sub_rz hq)
      have h_mul_q := h_tr q hq
      calc F.num p q = (F.num p q * D_fn s q) / D_fn s q := (mul_div_cancel_right₀ _ hDs_ne).symm
        _ = (N_fn s q * F.den p q) / D_fn s q := by rw [h_mul_q]
        _ = (N_fn s q / D_fn s q) * F.den p q := by ring
    · obtain ⟨hδ_pos, _, _, hN_holo, hD_holo, _, h_eq⟩ := h_spec s hs
      obtain ⟨r₁, hr₁_pos, hr₁_rad, hr₁_U, hr₁_eq⟩ := hg_agrees.2 (s, 0) hsU
      let η : ℝ := min r₁ (δ_fn s)
      have hη_pos : 0 < η := lt_min hr₁_pos hδ_pos
      have h_eq_2d : ∀ q ∈ Metric.ball (s, (0 : ℂ)) η, N_fn s q = g q * D_fn s q := by
        intro q₀ hq₀
        by_contra h_ne
        let g_d : ℂ × ℂ → ℂ := fun q => N_fn s q - g q * D_fn s q
        have hgd_ne : g_d q₀ ≠ 0 := sub_ne_zero.mpr h_ne
        have hgd_cont : ContinuousAt g_d q₀ :=
          ((hN_holo.continuousOn.mono (Metric.ball_subset_ball (min_le_right _ _))).sub
            ((hg_holo.continuousOn.mono (Set.Subset.trans (Metric.ball_subset_ball (min_le_left _ _)) hr₁_U)).mul
              (hD_holo.continuousOn.mono (Metric.ball_subset_ball (min_le_right _ _))))).continuousAt
            (Metric.isOpen_ball.mem_nhds hq₀)
        obtain ⟨η', hη'_pos, hη'_nz⟩ := Metric.eventually_nhds_iff.mp (hgd_cont.eventually_ne hgd_ne)
        let r_b : ℝ := min (η - dist q₀ (s, 0)) η'
        have hrb_pos : 0 < r_b := lt_min (sub_pos.mpr (Metric.mem_ball.mp hq₀)) hη'_pos
        have hrb_sub_η : Metric.ball q₀ r_b ⊆ Metric.ball (s, (0 : ℂ)) η := by
          intro q hq
          rw [Metric.mem_ball] at hq ⊢
          have h_le : r_b ≤ η - dist q₀ (s, 0) := min_le_left _ _
          linarith [dist_triangle q q₀ (s, 0)]
        have h_den_z : ∀ q ∈ Metric.ball q₀ r_b, F.den (s, 0) q = 0 := by
          intro q hq
          have hq_η := hrb_sub_η hq
          have h_prod : g_d q * F.den (s, 0) q = 0 := by
            dsimp only [g_d]
            calc (N_fn s q - g q * D_fn s q) * F.den (s, 0) q
                = N_fn s q * F.den (s, 0) q - (g q * F.den (s, 0) q) * D_fn s q := by ring
              _ = F.num (s, 0) q * D_fn s q - F.num (s, 0) q * D_fn s q := by
                  rw [← h_eq q (Metric.ball_subset_ball (min_le_right _ _) hq_η),
                      ← hr₁_eq q (Metric.ball_subset_ball (min_le_left _ _) hq_η)]
              _ = 0 := sub_self _
          exact (mul_eq_zero.mp h_prod).resolve_left
            (hη'_nz (lt_of_lt_of_le (Metric.mem_ball.mp hq) (min_le_right _ _)))
        have hp_s : (s, (0 : ℂ)) ∈ T := hSlice_sub s hs
        obtain ⟨q_nz, hq_nz_mem, hq_nz⟩ := F.den_ne_zero (s, 0) hp_s
        exact hq_nz (heqOn_zero_ball
          (Metric.ball_subset_ball (le_trans (min_le_left _ _) hr₁_rad) hq₀) hrb_pos
          (F.den_holo (s, 0) hp_s) h_den_z q_nz hq_nz_mem)
      filter_upwards [Metric.isOpen_ball.mem_nhds (Metric.mem_ball_self hη_pos)] with w hw
      exact h_eq_2d (w, 0) (by rw [← ball_prod_same]; exact ⟨hw, Metric.mem_ball_self hη_pos⟩)

  
  have hAX_ex := fun i : Fin 2 =>
    h_atlas_exists T_X (W.X_mero i) hslice_X
      (fun p => glancingImpact C p.1 p.2 i) (himpact_holo i) (W.X_agrees_two i)
  choose δ_X N_X D_X hδX_pos hδX_strip hDX_ev_ne hNX_holo hDX_holo hX_overlap hX_loc_holo hX_slice_eq
    using hAX_ex

  have hAL_ex := fun i : Fin 2 =>
    h_atlas_exists T_L (W.L_mero i) hslice_L
      (fun p => glancingDualLine C p.1 p.2 i) (hdualLine_holo i) (W.L_agrees_two i)
  choose δ_L N_L D_L hδL_pos hδL_strip hDL_ev_ne _ _ _ hL_loc_holo _
    using hAL_ex

  
  have h_eq_zero_of_cont_nhdsNE :
      ∀ {R : ℂ → ℂ} {s : ℂ}, ContinuousAt R s → (∀ᶠ z in nhdsWithin s {s}ᶜ, R z = 0) → R s = 0 := by
    intro R s h_cont h_ev
    let z_seq : ℕ → ℂ := fun n => s + ((1 / ((n : ℝ) + 1) : ℝ) : ℂ)
    have hz_ne : ∀ n : ℕ, z_seq n ≠ s := by
      intro n h_eq
      have h_pos : (0 : ℝ) < 1 / ((n : ℝ) + 1) := div_pos one_pos (by positivity)
      dsimp only [z_seq] at h_eq
      exact Complex.ofReal_ne_zero.mpr h_pos.ne' (add_left_cancel (h_eq.trans (add_zero s).symm))
    have hz_tend : Filter.Tendsto z_seq Filter.atTop (nhds s) := by
      have h_real : Filter.Tendsto (fun n : ℕ => (1 : ℝ) / ((n : ℝ) + 1)) Filter.atTop (nhds 0) :=
        tendsto_const_nhds.div_atTop (tendsto_natCast_atTop_atTop.atTop_add tendsto_const_nhds)
      simpa [z_seq] using tendsto_const_nhds.add (Complex.continuous_ofReal.continuousAt.tendsto.comp h_real)
    have hz_nhdsNE : Filter.Tendsto z_seq Filter.atTop (nhdsWithin s {s}ᶜ) :=
      tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within _ hz_tend
        (Filter.Eventually.of_forall hz_ne)
    have h_ev_seq : (fun _ : ℕ => (0 : ℂ)) =ᶠ[Filter.atTop] (fun n : ℕ => R (z_seq n)) := by
      filter_upwards [hz_nhdsNE.eventually h_ev] with n hn
      exact hn.symm
    exact tendsto_nhds_unique (h_cont.tendsto.comp hz_tend) (tendsto_const_nhds.congr' h_ev_seq)

  have h_mero_zero_on_nhdsNE :
      ∀ {R : ℂ → ℂ}, MeromorphicOn R D_H →
        (∀ᶠ z in nhds (0 : ℂ), R z = 0) →
        ∀ s ∈ D_H, ∀ᶠ z in nhdsWithin s {s}ᶜ, R z = 0 := by
    intro R hR_mero hR_zero0 s hs
    have h_ord0 : meromorphicOrderAt R 0 = ⊤ :=
      meromorphicOrderAt_eq_top_iff.mpr (hR_zero0.filter_mono nhdsWithin_le_nhds)
    have h_ords : meromorphicOrderAt R s = ⊤ := by
      by_contra h_ne_top
      exact absurd h_ord0 (hR_mero.meromorphicOrderAt_ne_top_of_isPreconnected hDH_preconn hs h0_DH h_ne_top)
    exact meromorphicOrderAt_eq_top_iff.mp h_ords

  let B_chart : Fin 2 → ℂ → Set ℂ := fun i s => Metric.ball s (δ_X i s)
  let q_chart : Fin 2 → ℂ → ℂ → ℂ := fun i s z => N_X i s (z, 0) / D_X i s (z, 0)
  let Γ_raw : ℂ → Fin 2 → ℂ := fun s i =>
    if s ∈ D_H then toMeromorphicNFOn (q_chart i s) (B_chart i s) s else 0
  let Γ_slice : ℂ → Fin 2 → ℂ := fun s i =>
    toMeromorphicNFOn (fun z => Γ_raw z i) D_H s

  have hΓ_nf : MeromorphicNFOn (fun s => Γ_slice s 0) D_H ∧
      MeromorphicNFOn (fun s => Γ_slice s 1) D_H :=
    ⟨meromorphicNFOn_toMeromorphicNFOn _ _, meromorphicNFOn_toMeromorphicNFOn _ _⟩
  have hΓ_mero : MeromorphicOn (fun s => Γ_slice s 0) D_H ∧
      MeromorphicOn (fun s => Γ_slice s 1) D_H :=
    ⟨hΓ_nf.1.meromorphicOn, hΓ_nf.2.meromorphicOn⟩
  have hΓ_nf_i : ∀ i : Fin 2, MeromorphicNFOn (fun s => Γ_slice s i) D_H := by
    intro i; fin_cases i; exact hΓ_nf.1; exact hΓ_nf.2
  have hΓ_mero_i : ∀ i : Fin 2, MeromorphicOn (fun s => Γ_slice s i) D_H := by
    intro i; fin_cases i; exact hΓ_mero.1; exact hΓ_mero.2

  have hq_mero : ∀ (i : Fin 2) {s : ℂ}, s ∈ D_H → MeromorphicOn (q_chart i s) (B_chart i s) := by
    intro i s hs
    have hN_an : AnalyticOnNhd ℂ (fun z => N_X i s (z, 0)) (B_chart i s) := by
      refine ((hNX_holo i s hs).comp (differentiableOn_id.prodMk (differentiableOn_const 0)) ?_).analyticOnNhd
        Metric.isOpen_ball
      intro z hz
      rw [← ball_prod_same]
      exact ⟨hz, Metric.mem_ball_self (hδX_pos i s hs)⟩
    have hD_an : AnalyticOnNhd ℂ (fun z => D_X i s (z, 0)) (B_chart i s) := by
      refine ((hDX_holo i s hs).comp (differentiableOn_id.prodMk (differentiableOn_const 0)) ?_).analyticOnNhd
        Metric.isOpen_ball
      intro z hz
      rw [← ball_prod_same]
      exact ⟨hz, Metric.mem_ball_self (hδX_pos i s hs)⟩
    exact hN_an.meromorphicOn.div hD_an.meromorphicOn

  have hΓ_raw_chart_eq : ∀ (i : Fin 2) {s₀ : ℂ} (hs₀ : s₀ ∈ D_H),
      ∀ z ∈ B_chart i s₀, Γ_raw z i = toMeromorphicNFOn (q_chart i s₀) (B_chart i s₀) z := by
    intro i s₀ hs₀ z hz
    have hz_DH : z ∈ D_H := hδX_strip i s₀ hs₀ hz
    have h_raw_def : Γ_raw z i = toMeromorphicNFOn (q_chart i z) (B_chart i z) z := by
      simp [Γ_raw, hz_DH]
    rw [h_raw_def]
    have h_nf_z : MeromorphicNFAt (toMeromorphicNFOn (q_chart i z) (B_chart i z)) z :=
      meromorphicNFOn_toMeromorphicNFOn _ _ (Metric.mem_ball_self (hδX_pos i z hz_DH))
    have h_nf_s0 : MeromorphicNFAt (toMeromorphicNFOn (q_chart i s₀) (B_chart i s₀)) z :=
      meromorphicNFOn_toMeromorphicNFOn _ _ hz
    have h_ev_q : q_chart i z =ᶠ[nhdsWithin z {z}ᶜ] q_chart i s₀ := by
      have h_mem_both : B_chart i s₀ ∩ B_chart i z ∈ nhdsWithin z {z}ᶜ :=
        nhdsWithin_le_nhds ((Metric.isOpen_ball.inter Metric.isOpen_ball).mem_nhds
          ⟨hz, Metric.mem_ball_self (hδX_pos i z hz_DH)⟩)
      filter_upwards [h_mem_both,
        hDX_ev_ne i s₀ hs₀ z hz,
        hDX_ev_ne i z hz_DH z (Metric.mem_ball_self (hδX_pos i z hz_DH))] with w hw hDs0 hDz
      dsimp only [q_chart]
      rw [div_eq_div_iff hDz hDs0]
      exact hX_overlap i z hz_DH s₀ hs₀ w ⟨hw.2, hw.1⟩
    have h_ev_nf : toMeromorphicNFOn (q_chart i z) (B_chart i z) =ᶠ[nhdsWithin z {z}ᶜ]
        toMeromorphicNFOn (q_chart i s₀) (B_chart i s₀) :=
      ((hq_mero i hz_DH).toMeromorphicNFOn_eq_self_on_nhdsNE
        (Metric.mem_ball_self (hδX_pos i z hz_DH))).trans
        (h_ev_q.trans ((hq_mero i hs₀).toMeromorphicNFOn_eq_self_on_nhdsNE hz).symm)
    exact ((h_nf_z.eventuallyEq_nhdsNE_iff_eventuallyEq_nhds h_nf_s0).mp h_ev_nf).eq_of_nhds

  have hΓ_raw_mero : ∀ i : Fin 2, MeromorphicOn (fun z => Γ_raw z i) D_H := by
    intro i s₀ hs₀
    have hs₀_ball : s₀ ∈ B_chart i s₀ := Metric.mem_ball_self (hδX_pos i s₀ hs₀)
    have h_nf_mero : MeromorphicAt (toMeromorphicNFOn (q_chart i s₀) (B_chart i s₀)) s₀ :=
      (meromorphicNFOn_toMeromorphicNFOn (q_chart i s₀) (B_chart i s₀)).meromorphicOn s₀ hs₀_ball
    have h_ev : toMeromorphicNFOn (q_chart i s₀) (B_chart i s₀) =ᶠ[nhdsWithin s₀ {s₀}ᶜ]
        (fun z => Γ_raw z i) := by
      filter_upwards [nhdsWithin_le_nhds (Metric.isOpen_ball.mem_nhds hs₀_ball)] with z hz
      exact (hΓ_raw_chart_eq i hs₀ z hz).symm
    exact h_nf_mero.congr h_ev

  have hΓ_slice_eq_q_nhdsNE : ∀ (i : Fin 2) {s : ℂ} (hs : s ∈ D_H),
      (fun w => Γ_slice w i) =ᶠ[nhdsWithin s {s}ᶜ] q_chart i s := by
    intro i s hs
    have hs_ball : s ∈ B_chart i s := Metric.mem_ball_self (hδX_pos i s hs)
    have h1 : (fun w => Γ_slice w i) =ᶠ[nhdsWithin s {s}ᶜ] (fun w => Γ_raw w i) :=
      (hΓ_raw_mero i).toMeromorphicNFOn_eq_self_on_nhdsNE hs
    have h2 : (fun w => Γ_raw w i) =ᶠ[nhdsWithin s {s}ᶜ]
        toMeromorphicNFOn (q_chart i s) (B_chart i s) := by
      filter_upwards [nhdsWithin_le_nhds (Metric.isOpen_ball.mem_nhds hs_ball)] with w hw
      exact hΓ_raw_chart_eq i hs w hw
    have h3 : toMeromorphicNFOn (q_chart i s) (B_chart i s) =ᶠ[nhdsWithin s {s}ᶜ] q_chart i s :=
      (hq_mero i hs).toMeromorphicNFOn_eq_self_on_nhdsNE hs_ball
    exact h1.trans (h2.trans h3)

  let dZ_m : ℂ → ℂ := fun z =>
    deriv (fun w => Γ_slice w 0) z + Complex.I * deriv (fun w => Γ_slice w 1) z
  let dW_m : ℂ → ℂ := fun z =>
    deriv (fun w => Γ_slice w 0) z - Complex.I * deriv (fun w => Γ_slice w 1) z
  let A_2 : ℂ → ℂ := fun z => -dZ_m z / dW_m z
  let f_raw : ℂ → ℂ := fun z => deriv A_2 z / (2 * Complex.I * A_2 z)
  let f_mero : ℂ → ℂ := toMeromorphicNFOn f_raw D_H
  let a_raw : ℂ → ℂ := fun z => (f_mero z) ^ 2 * dZ_m z / (Complex.I * (C.c : ℂ))
  let a_mero : ℂ → ℂ := toMeromorphicNFOn a_raw D_H

  have hdZ_mero : MeromorphicOn dZ_m D_H :=
    hΓ_mero.1.deriv.add ((MeromorphicOn.const Complex.I).mul hΓ_mero.2.deriv)
  have hdW_mero : MeromorphicOn dW_m D_H :=
    hΓ_mero.1.deriv.sub ((MeromorphicOn.const Complex.I).mul hΓ_mero.2.deriv)
  have h_neg_dZ_mero : MeromorphicOn (fun z => -dZ_m z) D_H :=
    ((MeromorphicOn.const (0 : ℂ)).sub hdZ_mero).congr (fun z _ => zero_sub (dZ_m z)) hDH_open
  have hA2_mero : MeromorphicOn A_2 D_H := h_neg_dZ_mero.div hdW_mero
  have hf_raw_mero : MeromorphicOn f_raw D_H :=
    hA2_mero.deriv.div ((MeromorphicOn.const (2 * Complex.I)).mul hA2_mero)
  have hf_nf : MeromorphicNFOn f_mero D_H := meromorphicNFOn_toMeromorphicNFOn _ _
  have hf_mero_on : MeromorphicOn f_mero D_H := hf_nf.meromorphicOn
  have hf2_mero : MeromorphicOn (fun z => (f_mero z) ^ 2) D_H :=
    (hf_mero_on.mul hf_mero_on).congr (fun z _ => (sq (f_mero z)).symm) hDH_open
  have ha_raw_mero : MeromorphicOn a_raw D_H :=
    (hf2_mero.mul hdZ_mero).div (MeromorphicOn.const (Complex.I * (C.c : ℂ)))
  have ha_nf : MeromorphicNFOn a_mero D_H := meromorphicNFOn_toMeromorphicNFOn _ _
  have ha_mero_on : MeromorphicOn a_mero D_H := ha_nf.meromorphicOn

  have h_Γ_base2_eq : ∀ z ∈ horizStrip (2 * W.s_base), ∀ i : Fin 2,
      Γ_slice z i = glancingBoundaryCurve C z i := by
    intro z hz i
    have hz_DH : z ∈ D_H := htwo_sub_DH hz
    have hz_U2 : (z, (0 : ℂ)) ∈ U_base2 := ⟨hz, by simp [W.r_base_pos]⟩
    have h_ev_mul := hX_slice_eq i z hz_DH U_base2
      (fun p => glancingImpact C p.1 p.2 i) hU_base2_open hz_U2 (himpact_holo i) (W.X_agrees_two i)
    have h_ev_q : q_chart i z =ᶠ[nhdsWithin z {z}ᶜ] (fun w => glancingBoundaryCurve C w i) := by
      filter_upwards [h_ev_mul.filter_mono nhdsWithin_le_nhds,
        nhdsWithin_le_nhds ((h_open_hs (2 * W.s_base)).mem_nhds hz),
        hDX_ev_ne i z hz_DH z (Metric.mem_ball_self (hδX_pos i z hz_DH))] with w hw_mul hw_hs hDw
      dsimp only [q_chart]
      rw [hw_mul, mul_div_cancel_right₀ _ hDw, himpact_zero w hw_hs i]
    have h_ev_nf := (hΓ_slice_eq_q_nhdsNE i hz_DH).trans h_ev_q
    exact (((hΓ_nf_i i hz_DH).eventuallyEq_nhdsNE_iff_eventuallyEq_nhds
      (hcurve_an i z hz).meromorphicNFAt).mp h_ev_nf).eq_of_nhds

  have h_af_base2_eq : ∀ z ∈ horizStrip (2 * W.s_base),
      f_mero z = deriv C.ϕ_ℂ z ∧ a_mero z = Complex.exp (Complex.I * C.ϕ_ℂ z) := by
    have hc_ne : (C.c : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr C.c_pos.ne'
    have h_deriv_Γ_eq : ∀ (i : Fin 2), ∀ z ∈ horizStrip (2 * W.s_base),
        deriv (fun w => Γ_slice w i) z = deriv (fun w => glancingBoundaryCurve C w i) z := by
      intro i z hz
      have h_ev : (fun w => Γ_slice w i) =ᶠ[nhds z] (fun w => glancingBoundaryCurve C w i) := by
        filter_upwards [(h_open_hs (2 * W.s_base)).mem_nhds hz] with w hw
        exact h_Γ_base2_eq w hw i
      exact h_ev.deriv_eq
    have hdZ_eq : ∀ z ∈ horizStrip (2 * W.s_base),
        dZ_m z = Complex.I * (C.c : ℂ) * Complex.exp (Complex.I * C.ϕ_ℂ z) / (deriv C.ϕ_ℂ z) ^ 2 := by
      intro z hz
      dsimp only [dZ_m]
      rw [h_deriv_Γ_eq 0 z hz, h_deriv_Γ_eq 1 z hz, hiso_pos z hz]
    have hdW_eq : ∀ z ∈ horizStrip (2 * W.s_base),
        dW_m z = -Complex.I * (C.c : ℂ) / (Complex.exp (Complex.I * C.ϕ_ℂ z) * (deriv C.ϕ_ℂ z) ^ 2) := by
      intro z hz
      dsimp only [dW_m]
      rw [h_deriv_Γ_eq 0 z hz, h_deriv_Γ_eq 1 z hz, hiso_neg z hz]
    have hA2_eq : ∀ z ∈ horizStrip (2 * W.s_base),
        A_2 z = (Complex.exp (Complex.I * C.ϕ_ℂ z)) ^ 2 := by
      intro z hz
      dsimp only [A_2]
      rw [hdZ_eq z hz, hdW_eq z hz]
      have hexp_ne : Complex.exp (Complex.I * C.ϕ_ℂ z) ≠ 0 := Complex.exp_ne_zero _
      have hϕ'_ne : deriv C.ϕ_ℂ z ≠ 0 := hspeed_ne z hz
      field_simp [hc_ne, Complex.I_ne_zero, hexp_ne, hϕ'_ne]
    have hf_raw_eq : ∀ z ∈ horizStrip (2 * W.s_base), f_raw z = deriv C.ϕ_ℂ z := by
      intro z hz
      have hA2_ev : A_2 =ᶠ[nhds z] (fun w => (Complex.exp (Complex.I * C.ϕ_ℂ w)) ^ 2) := by
        filter_upwards [(h_open_hs (2 * W.s_base)).mem_nhds hz] with w hw
        exact hA2_eq w hw
      have hd_exp : HasDerivAt (fun w => Complex.exp (Complex.I * C.ϕ_ℂ w))
          (Complex.I * deriv C.ϕ_ℂ z * Complex.exp (Complex.I * C.ϕ_ℂ z)) z := by
        have h_an := hexp_an z hz
        rw [← hexp_deriv z hz]
        exact h_an.differentiableAt.hasDerivAt
      have hd_sq : HasDerivAt (fun w => (Complex.exp (Complex.I * C.ϕ_ℂ w)) ^ 2)
          (2 * Complex.exp (Complex.I * C.ϕ_ℂ z) ^ (2 - 1) *
            (Complex.I * deriv C.ϕ_ℂ z * Complex.exp (Complex.I * C.ϕ_ℂ z))) z :=
        hd_exp.pow 2
      have h_deriv_A2 : deriv A_2 z =
          2 * Complex.I * deriv C.ϕ_ℂ z * (Complex.exp (Complex.I * C.ϕ_ℂ z)) ^ 2 := by
        rw [hA2_ev.deriv_eq, hd_sq.deriv]
        ring
      dsimp only [f_raw]
      rw [h_deriv_A2, hA2_eq z hz]
      have hexp_ne : Complex.exp (Complex.I * C.ϕ_ℂ z) ≠ 0 := Complex.exp_ne_zero _
      field_simp [Complex.I_ne_zero, hexp_ne]
    have hf_mero_eq : ∀ z ∈ horizStrip (2 * W.s_base), f_mero z = deriv C.ϕ_ℂ z := by
      intro z hz
      have hz_DH : z ∈ D_H := htwo_sub_DH hz
      have h_ev1 : f_mero =ᶠ[nhdsWithin z {z}ᶜ] f_raw :=
        hf_raw_mero.toMeromorphicNFOn_eq_self_on_nhdsNE hz_DH
      have h_ev2 : f_raw =ᶠ[nhdsWithin z {z}ᶜ] deriv C.ϕ_ℂ := by
        filter_upwards [nhdsWithin_le_nhds ((h_open_hs (2 * W.s_base)).mem_nhds hz)] with w hw
        exact hf_raw_eq w hw
      exact (((hf_nf hz_DH).eventuallyEq_nhdsNE_iff_eventuallyEq_nhds
        (hspeed_an z hz).meromorphicNFAt).mp (h_ev1.trans h_ev2)).eq_of_nhds
    have ha_raw_eq : ∀ z ∈ horizStrip (2 * W.s_base),
        a_raw z = Complex.exp (Complex.I * C.ϕ_ℂ z) := by
      intro z hz
      dsimp only [a_raw]
      rw [hf_mero_eq z hz, hdZ_eq z hz]
      have hϕ'_ne : deriv C.ϕ_ℂ z ≠ 0 := hspeed_ne z hz
      field_simp [hc_ne, Complex.I_ne_zero, hϕ'_ne]
    intro z hz
    refine ⟨hf_mero_eq z hz, ?_⟩
    have hz_DH : z ∈ D_H := htwo_sub_DH hz
    have h_ev1 : a_mero =ᶠ[nhdsWithin z {z}ᶜ] a_raw :=
      ha_raw_mero.toMeromorphicNFOn_eq_self_on_nhdsNE hz_DH
    have h_ev2 : a_raw =ᶠ[nhdsWithin z {z}ᶜ] (fun w => Complex.exp (Complex.I * C.ϕ_ℂ w)) := by
      filter_upwards [nhdsWithin_le_nhds ((h_open_hs (2 * W.s_base)).mem_nhds hz)] with w hw
      exact ha_raw_eq w hw
    exact (((ha_nf hz_DH).eventuallyEq_nhdsNE_iff_eventuallyEq_nhds
      (hexp_an z hz).meromorphicNFAt).mp (h_ev1.trans h_ev2)).eq_of_nhds

  have h_slice_base_eq : ∀ s ∈ horizStrip W.s_base,
      Γ_slice s = glancingBoundaryCurve C s ∧
      a_mero s = Complex.exp (Complex.I * C.ϕ_ℂ s) ∧
      f_mero s = deriv C.ϕ_ℂ s := by
    intro s hs
    have hs2 : s ∈ horizStrip (2 * W.s_base) := hbase_sub_two hs
    refine ⟨funext (fun i => h_Γ_base2_eq s hs2 i),
      (h_af_base2_eq s hs2).2, (h_af_base2_eq s hs2).1⟩

  let IsSliceReg : ℂ → Prop := fun s =>
    s ∈ D_H ∧
    AnalyticAt ℂ a_mero s ∧ a_mero s ≠ 0 ∧
    AnalyticAt ℂ f_mero s ∧ f_mero s ≠ 0 ∧
    ∃ (r₀ : ℝ) (X_loc : Fin 2 → ℂ × ℂ → ℂ),
      0 < r₀ ∧
      Metric.ball s r₀ ⊆ D_H ∧
      Metric.ball (s, (0 : ℂ)) r₀ ⊆ T_X ∧
      (∀ i : Fin 2, DifferentiableOn ℂ (X_loc i) (Metric.ball (s, (0 : ℂ)) r₀)) ∧
      (∀ i : Fin 2, MeroAgreesHolo (W.X_mero i) (X_loc i) (Metric.ball (s, (0 : ℂ)) r₀))

  let E_disc : Set ℂ := {s ∈ D_H | ¬ IsSliceReg s}

  have h_base_reg : ∀ s ∈ horizStrip W.s_base, IsSliceReg s := by
    intro s hs
    have hs2 : s ∈ horizStrip (2 * W.s_base) := hbase_sub_two hs
    have hs_DH : s ∈ D_H := htwo_sub_DH hs2
    have ha_an_s : AnalyticAt ℂ a_mero s := by
      refine (hexp_an s hs2).congr ?_
      filter_upwards [(h_open_hs (2 * W.s_base)).mem_nhds hs2] with w hw
      exact (h_af_base2_eq w hw).2.symm
    have hf_an_s : AnalyticAt ℂ f_mero s := by
      refine (hspeed_an s hs2).congr ?_
      filter_upwards [(h_open_hs (2 * W.s_base)).mem_nhds hs2] with w hw
      exact (h_af_base2_eq w hw).1.symm
    have ha_ne_s : a_mero s ≠ 0 := by
      rw [(h_af_base2_eq s hs2).2]
      exact Complex.exp_ne_zero _
    have hf_ne_s : f_mero s ≠ 0 := by
      rw [(h_af_base2_eq s hs2).1]
      exact hspeed_ne s hs2
    let r₀ : ℝ := min W.s_base W.r_base
    have hr₀_pos : 0 < r₀ := lt_min W.s_base_pos W.r_base_pos
    have h_sub_1d : Metric.ball s r₀ ⊆ horizStrip (2 * W.s_base) := by
      intro z hz
      change |s.im| < W.s_base at hs
      change |z.im| < 2 * W.s_base
      have h_dist_r0 : ‖z - s‖ < r₀ := by rw [← dist_eq_norm]; exact Metric.mem_ball.mp hz
      have h_dist : ‖z - s‖ < W.s_base := lt_of_lt_of_le h_dist_r0 (min_le_left _ _)
      have h_im : |(z - s).im| ≤ ‖z - s‖ := Complex.abs_im_le_norm (z - s)
      have h_eq : z.im = (z - s).im + s.im := by simp
      rw [h_eq]
      calc |(z - s).im + s.im| ≤ |(z - s).im| + |s.im| := abs_add_le _ _
        _ < W.s_base + W.s_base := add_lt_add (lt_of_le_of_lt h_im h_dist) hs
        _ = 2 * W.s_base := by ring
    have h_sub_U2 : Metric.ball (s, (0 : ℂ)) r₀ ⊆ U_base2 := by
      intro p hp
      rw [← ball_prod_same] at hp
      refine ⟨h_sub_1d hp.1, ?_⟩
      have hp2_r0 : ‖p.2‖ < r₀ := by
        have h := Metric.mem_ball.mp hp.2
        rwa [dist_zero_right] at h
      exact lt_of_lt_of_le hp2_r0 (min_le_right _ _)
    refine ⟨hs_DH, ha_an_s, ha_ne_s, hf_an_s, hf_ne_s,
      r₀, fun i p => glancingImpact C p.1 p.2 i, hr₀_pos,
      Set.Subset.trans h_sub_1d htwo_sub_DH,
      Set.Subset.trans h_sub_U2 (W.X_agrees_two 0).1,
      fun i => (himpact_holo i).mono h_sub_U2,
      fun i => ⟨Set.Subset.trans h_sub_U2 (W.X_agrees_two i).1, fun p hp => ?_⟩⟩
    obtain ⟨r₁, hr₁_pos, hr₁_rad, _, hr₁_eq⟩ := (W.X_agrees_two i).2 p (h_sub_U2 hp)
    let r₂ : ℝ := min r₁ (r₀ - dist p (s, 0))
    have hr₂_pos : 0 < r₂ := lt_min hr₁_pos (sub_pos.mpr (Metric.mem_ball.mp hp))
    have hr₂_sub : Metric.ball p r₂ ⊆ Metric.ball (s, (0 : ℂ)) r₀ := by
      intro q hq
      rw [Metric.mem_ball] at hq ⊢
      have h_le : r₂ ≤ r₀ - dist p (s, 0) := min_le_right _ _
      linarith [dist_triangle q p (s, 0)]
    exact ⟨r₂, hr₂_pos, le_trans (min_le_left _ _) hr₁_rad, hr₂_sub,
      fun q hq => hr₁_eq q (Metric.ball_subset_ball (min_le_left _ _) hq)⟩

  have hE_base_disj : ∀ s ∈ horizStrip W.s_base, s ∉ E_disc :=
    fun s hs hE => hE.2 (h_base_reg s hs)

  have ha_ord_ne_top : ∀ s ∈ D_H, meromorphicOrderAt a_mero s ≠ ⊤ := by
    have h0_reg := h_base_reg 0 h0_base
    have h_ev0 : ∀ᶠ z in nhdsWithin (0 : ℂ) {0}ᶜ, a_mero z ≠ 0 :=
      (h0_reg.2.1.continuousAt.eventually_ne h0_reg.2.2.1).filter_mono nhdsWithin_le_nhds
    have h0_ne_top : meromorphicOrderAt a_mero 0 ≠ ⊤ :=
      (meromorphicOrderAt_ne_top_iff_eventually_ne_zero (ha_mero_on 0 h0_DH)).mpr h_ev0
    exact fun s hs => ha_mero_on.meromorphicOrderAt_ne_top_of_isPreconnected hDH_preconn h0_DH hs h0_ne_top

  have hf_ord_ne_top : ∀ s ∈ D_H, meromorphicOrderAt f_mero s ≠ ⊤ := by
    have h0_reg := h_base_reg 0 h0_base
    have h_ev0 : ∀ᶠ z in nhdsWithin (0 : ℂ) {0}ᶜ, f_mero z ≠ 0 :=
      (h0_reg.2.2.2.1.continuousAt.eventually_ne h0_reg.2.2.2.2.1).filter_mono nhdsWithin_le_nhds
    have h0_ne_top : meromorphicOrderAt f_mero 0 ≠ ⊤ :=
      (meromorphicOrderAt_ne_top_iff_eventually_ne_zero (hf_mero_on 0 h0_DH)).mpr h_ev0
    exact fun s hs => hf_mero_on.meromorphicOrderAt_ne_top_of_isPreconnected hDH_preconn h0_DH hs h0_ne_top

  have hE_isolated : ∀ s ∈ D_H, ∃ r : ℝ, 0 < r ∧ Metric.ball s r ⊆ D_H ∧
      ∀ z ∈ Metric.ball s r, z ≠ s → z ∉ E_disc := by
    intro s hs
    have h_ev_all : ∀ᶠ z in nhdsWithin s {s}ᶜ,
        AnalyticAt ℂ a_mero z ∧ a_mero z ≠ 0 ∧
        AnalyticAt ℂ f_mero z ∧ f_mero z ≠ 0 ∧
        D_X 0 s (z, 0) ≠ 0 ∧ D_X 1 s (z, 0) ≠ 0 := by
      filter_upwards [(ha_mero_on s hs).eventually_analyticAt,
        (meromorphicOrderAt_ne_top_iff_eventually_ne_zero (ha_mero_on s hs)).mp (ha_ord_ne_top s hs),
        (hf_mero_on s hs).eventually_analyticAt,
        (meromorphicOrderAt_ne_top_iff_eventually_ne_zero (hf_mero_on s hs)).mp (hf_ord_ne_top s hs),
        hDX_ev_ne 0 s hs s (Metric.mem_ball_self (hδX_pos 0 s hs)),
        hDX_ev_ne 1 s hs s (Metric.mem_ball_self (hδX_pos 1 s hs))]
        with z h1 h2 h3 h4 h5 h6
      exact ⟨h1, h2, h3, h4, h5, h6⟩
    obtain ⟨ρ₀, hρ₀_pos, hρ₀_prop⟩ :=
      Metric.eventually_nhds_iff.mp (eventually_nhdsWithin_iff.mp h_ev_all)
    let r : ℝ := min ρ₀ (min (δ_X 0 s) (δ_X 1 s))
    have hr_pos : 0 < r := lt_min hρ₀_pos (lt_min (hδX_pos 0 s hs) (hδX_pos 1 s hs))
    have hr_DH : Metric.ball s r ⊆ D_H :=
      Set.Subset.trans (Metric.ball_subset_ball (le_trans (min_le_right _ _) (min_le_left _ _)))
        (hδX_strip 0 s hs)
    refine ⟨r, hr_pos, hr_DH, fun z hz hzne hE => hE.2 ?_⟩
    have hz_ρ₀ : dist z s < ρ₀ := lt_of_lt_of_le (Metric.mem_ball.mp hz) (min_le_left _ _)
    obtain ⟨ha_z, ha_nz, hf_z, hf_nz, hD0_nz, hD1_nz⟩ := hρ₀_prop hz_ρ₀ hzne
    have hz_b0 : z ∈ Metric.ball s (δ_X 0 s) :=
      Metric.ball_subset_ball (le_trans (min_le_right _ _) (min_le_left _ _)) hz
    have hz_b1 : z ∈ Metric.ball s (δ_X 1 s) :=
      Metric.ball_subset_ball (le_trans (min_le_right _ _) (min_le_right _ _)) hz
    obtain ⟨r_z0, hrz0_pos, hrz0_1d, hrz0_T, hrz0_holo, hrz0_ag⟩ :=
      hX_loc_holo 0 s hs z hz_b0 hD0_nz
    obtain ⟨r_z1, hrz1_pos, _, hrz1_T, hrz1_holo, hrz1_ag⟩ :=
      hX_loc_holo 1 s hs z hz_b1 hD1_nz
    let r_z : ℝ := min r_z0 r_z1
    have hrz_pos : 0 < r_z := lt_min hrz0_pos hrz1_pos
    let X_loc : Fin 2 → ℂ × ℂ → ℂ := fun i q => N_X i s q / D_X i s q
    refine ⟨hr_DH hz, ha_z, ha_nz, hf_z, hf_nz, r_z, X_loc, hrz_pos,
      Set.Subset.trans (Metric.ball_subset_ball (min_le_left _ _))
        (Set.Subset.trans hrz0_1d (hδX_strip 0 s hs)),
      Set.Subset.trans (Metric.ball_subset_ball (min_le_left _ _)) hrz0_T,
      fun i => ?_, fun i => ?_⟩
    · fin_cases i
      · exact hrz0_holo.mono (Metric.ball_subset_ball (min_le_left _ _))
      · exact hrz1_holo.mono (Metric.ball_subset_ball (min_le_right _ _))
    · fin_cases i
      · refine ⟨Set.Subset.trans (Metric.ball_subset_ball (min_le_left _ _)) hrz0_T, fun p hp => ?_⟩
        obtain ⟨rp, hrp_pos, hrp_rad, _, hrp_eq⟩ :=
          hrz0_ag.2 p (Metric.ball_subset_ball (min_le_left _ _) hp)
        let rp' := min rp (r_z - dist p (z, 0))
        have hrp'_pos : 0 < rp' := lt_min hrp_pos (sub_pos.mpr (Metric.mem_ball.mp hp))
        have hrp'_sub : Metric.ball p rp' ⊆ Metric.ball (z, 0) r_z := by
          intro q hq
          rw [Metric.mem_ball] at hq ⊢
          have h_le : rp' ≤ r_z - dist p (z, 0) := min_le_right _ _
          linarith [dist_triangle q p (z, 0)]
        exact ⟨rp', hrp'_pos, le_trans (min_le_left _ _) hrp_rad, hrp'_sub,
          fun q hq => hrp_eq q (Metric.ball_subset_ball (min_le_left _ _) hq)⟩
      · refine ⟨Set.Subset.trans (Metric.ball_subset_ball (min_le_right _ _)) hrz1_T, fun p hp => ?_⟩
        obtain ⟨rp, hrp_pos, hrp_rad, _, hrp_eq⟩ :=
          hrz1_ag.2 p (Metric.ball_subset_ball (min_le_right _ _) hp)
        let rp' := min rp (r_z - dist p (z, 0))
        have hrp'_pos : 0 < rp' := lt_min hrp_pos (sub_pos.mpr (Metric.mem_ball.mp hp))
        have hrp'_sub : Metric.ball p rp' ⊆ Metric.ball (z, 0) r_z := by
          intro q hq
          rw [Metric.mem_ball] at hq ⊢
          have h_le : rp' ≤ r_z - dist p (z, 0) := min_le_right _ _
          linarith [dist_triangle q p (z, 0)]
        exact ⟨rp', hrp'_pos, le_trans (min_le_left _ _) hrp_rad, hrp'_sub,
          fun q hq => hrp_eq q (Metric.ball_subset_ball (min_le_left _ _) hq)⟩

  have hL_isolated : ∀ s ∈ D_H, ∃ r : ℝ, 0 < r ∧ Metric.ball s r ⊆ D_H ∧
      ∀ z ∈ Metric.ball s r, z ≠ s →
        ∃ (r_z : ℝ) (L_loc : Fin 2 → ℂ × ℂ → ℂ),
          0 < r_z ∧
          Metric.ball (z, (0 : ℂ)) r_z ⊆ T_L ∧
          (∀ i : Fin 2, DifferentiableOn ℂ (L_loc i) (Metric.ball (z, (0 : ℂ)) r_z)) ∧
          (∀ i : Fin 2, MeroAgreesHolo (W.L_mero i) (L_loc i) (Metric.ball (z, (0 : ℂ)) r_z)) := by
    intro s hs
    have h_ev_L : ∀ᶠ z in nhdsWithin s {s}ᶜ,
        D_L 0 s (z, 0) ≠ 0 ∧ D_L 1 s (z, 0) ≠ 0 := by
      filter_upwards [hDL_ev_ne 0 s hs s (Metric.mem_ball_self (hδL_pos 0 s hs)),
        hDL_ev_ne 1 s hs s (Metric.mem_ball_self (hδL_pos 1 s hs))]
        with z h0 h1
      exact ⟨h0, h1⟩
    obtain ⟨ρ₀, hρ₀_pos, hρ₀_prop⟩ :=
      Metric.eventually_nhds_iff.mp (eventually_nhdsWithin_iff.mp h_ev_L)
    let r : ℝ := min ρ₀ (min (δ_L 0 s) (δ_L 1 s))
    have hr_pos : 0 < r := lt_min hρ₀_pos (lt_min (hδL_pos 0 s hs) (hδL_pos 1 s hs))
    have hr_DH : Metric.ball s r ⊆ D_H :=
      Set.Subset.trans (Metric.ball_subset_ball (le_trans (min_le_right _ _) (min_le_left _ _)))
        (hδL_strip 0 s hs)
    refine ⟨r, hr_pos, hr_DH, fun z hz hzne => ?_⟩
    obtain ⟨hD0_nz, hD1_nz⟩ :=
      hρ₀_prop (lt_of_lt_of_le (Metric.mem_ball.mp hz) (min_le_left _ _)) hzne
    obtain ⟨r_z0, hrz0_pos, _, hrz0_T, hrz0_holo, hrz0_ag⟩ :=
      hL_loc_holo 0 s hs z
        (Metric.ball_subset_ball (le_trans (min_le_right _ _) (min_le_left _ _)) hz) hD0_nz
    obtain ⟨r_z1, hrz1_pos, _, hrz1_T, hrz1_holo, hrz1_ag⟩ :=
      hL_loc_holo 1 s hs z
        (Metric.ball_subset_ball (le_trans (min_le_right _ _) (min_le_right _ _)) hz) hD1_nz
    let r_z : ℝ := min r_z0 r_z1
    have hrz_pos : 0 < r_z := lt_min hrz0_pos hrz1_pos
    let L_loc : Fin 2 → ℂ × ℂ → ℂ := fun i q => N_L i s q / D_L i s q
    refine ⟨r_z, L_loc, hrz_pos,
      Set.Subset.trans (Metric.ball_subset_ball (min_le_left _ _)) hrz0_T,
      fun i => ?_, fun i => ?_⟩
    · fin_cases i
      · exact hrz0_holo.mono (Metric.ball_subset_ball (min_le_left _ _))
      · exact hrz1_holo.mono (Metric.ball_subset_ball (min_le_right _ _))
    · fin_cases i
      · refine ⟨Set.Subset.trans (Metric.ball_subset_ball (min_le_left _ _)) hrz0_T, fun p hp => ?_⟩
        obtain ⟨rp, hrp_pos, hrp_rad, _, hrp_eq⟩ :=
          hrz0_ag.2 p (Metric.ball_subset_ball (min_le_left _ _) hp)
        let rp' := min rp (r_z - dist p (z, 0))
        have hrp'_pos : 0 < rp' := lt_min hrp_pos (sub_pos.mpr (Metric.mem_ball.mp hp))
        have hrp'_sub : Metric.ball p rp' ⊆ Metric.ball (z, 0) r_z := by
          intro q hq
          rw [Metric.mem_ball] at hq ⊢
          have h_le : rp' ≤ r_z - dist p (z, 0) := min_le_right _ _
          linarith [dist_triangle q p (z, 0)]
        exact ⟨rp', hrp'_pos, le_trans (min_le_left _ _) hrp_rad, hrp'_sub,
          fun q hq => hrp_eq q (Metric.ball_subset_ball (min_le_left _ _) hq)⟩
      · refine ⟨Set.Subset.trans (Metric.ball_subset_ball (min_le_right _ _)) hrz1_T, fun p hp => ?_⟩
        obtain ⟨rp, hrp_pos, hrp_rad, _, hrp_eq⟩ :=
          hrz1_ag.2 p (Metric.ball_subset_ball (min_le_right _ _) hp)
        let rp' := min rp (r_z - dist p (z, 0))
        have hrp'_pos : 0 < rp' := lt_min hrp_pos (sub_pos.mpr (Metric.mem_ball.mp hp))
        have hrp'_sub : Metric.ball p rp' ⊆ Metric.ball (z, 0) r_z := by
          intro q hq
          rw [Metric.mem_ball] at hq ⊢
          have h_le : rp' ≤ r_z - dist p (z, 0) := min_le_right _ _
          linarith [dist_triangle q p (z, 0)]
        exact ⟨rp', hrp'_pos, le_trans (min_le_left _ _) hrp_rad, hrp'_sub,
          fun q hq => hrp_eq q (Metric.ball_subset_ball (min_le_left _ _) hq)⟩

  let R₁ : ℂ → ℂ := fun z => dZ_m z * (f_mero z) ^ 2 - Complex.I * (C.c : ℂ) * a_mero z
  let R₂ : ℂ → ℂ := fun z => dW_m z * (a_mero z * (f_mero z) ^ 2) + Complex.I * (C.c : ℂ)
  let R₃ : ℂ → ℂ := fun z => deriv a_mero z - Complex.I * f_mero z * a_mero z

  have hR₁_mero : MeromorphicOn R₁ D_H :=
    (hdZ_mero.mul hf2_mero).sub ((MeromorphicOn.const (Complex.I * (C.c : ℂ))).mul ha_mero_on)
  have hR₂_mero : MeromorphicOn R₂ D_H :=
    (hdW_mero.mul (ha_mero_on.mul hf2_mero)).add (MeromorphicOn.const (Complex.I * (C.c : ℂ)))
  have hR₃_mero : MeromorphicOn R₃ D_H :=
    ha_mero_on.deriv.sub (((MeromorphicOn.const Complex.I).mul hf_mero_on).mul ha_mero_on)

  have hR_zero_nhds0 :
      (∀ᶠ z in nhds (0 : ℂ), R₁ z = 0) ∧
      (∀ᶠ z in nhds (0 : ℂ), R₂ z = 0) ∧
      (∀ᶠ z in nhds (0 : ℂ), R₃ z = 0) := by
    have h0_2s : (0 : ℂ) ∈ horizStrip (2 * W.s_base) := hbase_sub_two h0_base
    have h_deriv_Γ : ∀ (i : Fin 2), ∀ z ∈ horizStrip (2 * W.s_base),
        deriv (fun w => Γ_slice w i) z = deriv (fun w => glancingBoundaryCurve C w i) z := by
      intro i z hz
      have h_ev : (fun w => Γ_slice w i) =ᶠ[nhds z] (fun w => glancingBoundaryCurve C w i) := by
        filter_upwards [(h_open_hs (2 * W.s_base)).mem_nhds hz] with w hw
        exact h_Γ_base2_eq w hw i
      exact h_ev.deriv_eq
    have h_deriv_a : ∀ z ∈ horizStrip (2 * W.s_base),
        deriv a_mero z = Complex.I * deriv C.ϕ_ℂ z * Complex.exp (Complex.I * C.ϕ_ℂ z) := by
      intro z hz
      have h_ev : a_mero =ᶠ[nhds z] (fun w => Complex.exp (Complex.I * C.ϕ_ℂ w)) := by
        filter_upwards [(h_open_hs (2 * W.s_base)).mem_nhds hz] with w hw
        exact (h_af_base2_eq w hw).2
      rw [h_ev.deriv_eq, hexp_deriv z hz]
    refine ⟨?_, ?_, ?_⟩
    · filter_upwards [(h_open_hs (2 * W.s_base)).mem_nhds h0_2s] with z hz
      dsimp only [R₁, dZ_m]
      rw [h_deriv_Γ 0 z hz, h_deriv_Γ 1 z hz, hiso_pos z hz,
        (h_af_base2_eq z hz).1, (h_af_base2_eq z hz).2]
      have hϕ'_ne : deriv C.ϕ_ℂ z ≠ 0 := hspeed_ne z hz
      rw [div_mul_cancel₀ _ (pow_ne_zero 2 hϕ'_ne), sub_self]
    · filter_upwards [(h_open_hs (2 * W.s_base)).mem_nhds h0_2s] with z hz
      dsimp only [R₂, dW_m]
      rw [h_deriv_Γ 0 z hz, h_deriv_Γ 1 z hz, hiso_neg z hz,
        (h_af_base2_eq z hz).1, (h_af_base2_eq z hz).2]
      have h_den_ne : Complex.exp (Complex.I * C.ϕ_ℂ z) * (deriv C.ϕ_ℂ z) ^ 2 ≠ 0 :=
        mul_ne_zero (Complex.exp_ne_zero _) (pow_ne_zero 2 (hspeed_ne z hz))
      rw [div_mul_cancel₀ _ h_den_ne]
      ring
    · filter_upwards [(h_open_hs (2 * W.s_base)).mem_nhds h0_2s] with z hz
      dsimp only [R₃]
      rw [h_deriv_a z hz, (h_af_base2_eq z hz).1, (h_af_base2_eq z hz).2, sub_self]

  have h_slice_reg : ∀ s ∈ D_H, s ∉ E_disc →
      AnalyticAt ℂ (fun z => Γ_slice z 0) s ∧
      AnalyticAt ℂ (fun z => Γ_slice z 1) s ∧
      AnalyticAt ℂ a_mero s ∧
      AnalyticAt ℂ f_mero s ∧
      a_mero s ≠ 0 ∧
      f_mero s ≠ 0 ∧
      deriv (fun z => Γ_slice z 0) s + Complex.I * deriv (fun z => Γ_slice z 1) s =
        Complex.I * C.c * a_mero s / (f_mero s) ^ 2 ∧
      deriv (fun z => Γ_slice z 0) s - Complex.I * deriv (fun z => Γ_slice z 1) s =
        -Complex.I * C.c / (a_mero s * (f_mero s) ^ 2) ∧
      deriv a_mero s = Complex.I * f_mero s * a_mero s ∧
      ∃ (r_s : ℝ) (X_loc : Fin 2 → ℂ × ℂ → ℂ),
        0 < r_s ∧
        Metric.ball (s, (0 : ℂ)) r_s ⊆ T_X ∧
        (∀ z ∈ Metric.ball s r_s, z ∈ D_H ∧ z ∉ E_disc) ∧
        (∀ i : Fin 2, DifferentiableOn ℂ (X_loc i) (Metric.ball (s, (0 : ℂ)) r_s)) ∧
        (∀ i : Fin 2, MeroAgreesHolo (W.X_mero i) (X_loc i) (Metric.ball (s, (0 : ℂ)) r_s)) ∧
        (∀ i : Fin 2, ∀ z ∈ Metric.ball s r_s, X_loc i (z, 0) = Γ_slice z i) := by
    intro s hs hs_not_E
    have h_reg : IsSliceReg s := by
      by_contra h_not
      exact hs_not_E ⟨hs, h_not⟩
    obtain ⟨_, ha_an, ha_ne, hf_an, hf_ne, r₀, X_loc, hr₀_pos, hr₀_DH, hr₀_T, hX_holo, hX_ag⟩ := h_reg
    have hX_loc_slice_eq : ∀ (i : Fin 2), ∀ z ∈ Metric.ball s r₀, X_loc i (z, 0) = Γ_slice z i := by
      intro i z hz
      have hz_DH : z ∈ D_H := hr₀_DH hz
      have hz_2d : (z, (0 : ℂ)) ∈ Metric.ball (s, (0 : ℂ)) r₀ := by
        rw [← ball_prod_same]
        exact ⟨hz, Metric.mem_ball_self hr₀_pos⟩
      have h_ev_mul := hX_slice_eq i z hz_DH
        (Metric.ball (s, (0 : ℂ)) r₀) (X_loc i) Metric.isOpen_ball hz_2d (hX_holo i) (hX_ag i)
      have h_ev_q : q_chart i z =ᶠ[nhdsWithin z {z}ᶜ] (fun w => X_loc i (w, 0)) := by
        filter_upwards [h_ev_mul.filter_mono nhdsWithin_le_nhds,
          hDX_ev_ne i z hz_DH z (Metric.mem_ball_self (hδX_pos i z hz_DH))] with w hw_mul hDw
        dsimp only [q_chart]
        rw [hw_mul, mul_div_cancel_right₀ _ hDw]
      have hX_1d_holo : DifferentiableOn ℂ (fun w => X_loc i (w, 0)) (Metric.ball s r₀) := by
        refine (hX_holo i).comp (differentiableOn_id.prodMk (differentiableOn_const 0)) ?_
        intro w hw
        rw [← ball_prod_same]
        exact ⟨hw, Metric.mem_ball_self hr₀_pos⟩
      have hX_1d_an : AnalyticAt ℂ (fun w => X_loc i (w, 0)) z :=
        hX_1d_holo.analyticAt (Metric.isOpen_ball.mem_nhds hz)
      exact ((((hΓ_nf_i i hz_DH).eventuallyEq_nhdsNE_iff_eventuallyEq_nhds
        hX_1d_an.meromorphicNFAt).mp ((hΓ_slice_eq_q_nhdsNE i hz_DH).trans h_ev_q)).eq_of_nhds).symm
    have hΓ_an : ∀ i : Fin 2, AnalyticAt ℂ (fun z => Γ_slice z i) s := by
      intro i
      have hX_1d_holo : DifferentiableOn ℂ (fun w => X_loc i (w, 0)) (Metric.ball s r₀) := by
        refine (hX_holo i).comp (differentiableOn_id.prodMk (differentiableOn_const 0)) ?_
        intro w hw
        rw [← ball_prod_same]
        exact ⟨hw, Metric.mem_ball_self hr₀_pos⟩
      refine (hX_1d_holo.analyticAt (Metric.isOpen_ball.mem_nhds (Metric.mem_ball_self hr₀_pos))).congr ?_
      filter_upwards [Metric.isOpen_ball.mem_nhds (Metric.mem_ball_self hr₀_pos)] with w hw
      exact hX_loc_slice_eq i w hw
    have hR₁_cont : ContinuousAt R₁ s :=
      (((hΓ_an 0).deriv.continuousAt.add (continuousAt_const.mul (hΓ_an 1).deriv.continuousAt)).mul
        (hf_an.continuousAt.pow 2)).sub (continuousAt_const.mul ha_an.continuousAt)
    have hR₂_cont : ContinuousAt R₂ s :=
      (((hΓ_an 0).deriv.continuousAt.sub (continuousAt_const.mul (hΓ_an 1).deriv.continuousAt)).mul
        (ha_an.continuousAt.mul (hf_an.continuousAt.pow 2))).add continuousAt_const
    have hR₃_cont : ContinuousAt R₃ s :=
      ha_an.deriv.continuousAt.sub ((continuousAt_const.mul hf_an.continuousAt).mul ha_an.continuousAt)
    have hR₁_s : R₁ s = 0 :=
      h_eq_zero_of_cont_nhdsNE hR₁_cont (h_mero_zero_on_nhdsNE hR₁_mero hR_zero_nhds0.1 s hs)
    have hR₂_s : R₂ s = 0 :=
      h_eq_zero_of_cont_nhdsNE hR₂_cont (h_mero_zero_on_nhdsNE hR₂_mero hR_zero_nhds0.2.1 s hs)
    have hR₃_s : R₃ s = 0 :=
      h_eq_zero_of_cont_nhdsNE hR₃_cont (h_mero_zero_on_nhdsNE hR₃_mero hR_zero_nhds0.2.2 s hs)
    have h_ode1 : deriv (fun z => Γ_slice z 0) s + Complex.I * deriv (fun z => Γ_slice z 1) s =
        Complex.I * C.c * a_mero s / (f_mero s) ^ 2 := by
      rw [eq_div_iff (pow_ne_zero 2 hf_ne)]
      exact sub_eq_zero.mp hR₁_s
    have h_ode2 : deriv (fun z => Γ_slice z 0) s - Complex.I * deriv (fun z => Γ_slice z 1) s =
        -Complex.I * C.c / (a_mero s * (f_mero s) ^ 2) := by
      rw [eq_div_iff (mul_ne_zero ha_ne (pow_ne_zero 2 hf_ne))]
      linear_combination hR₂_s
    have h_ode3 : deriv a_mero s = Complex.I * f_mero s * a_mero s :=
      sub_eq_zero.mp hR₃_s
    have h_ev_af : ∀ᶠ z in nhds s,
        AnalyticAt ℂ a_mero z ∧ a_mero z ≠ 0 ∧ AnalyticAt ℂ f_mero z ∧ f_mero z ≠ 0 := by
      filter_upwards [ha_an.eventually_analyticAt, ha_an.continuousAt.eventually_ne ha_ne,
        hf_an.eventually_analyticAt, hf_an.continuousAt.eventually_ne hf_ne] with z h1 h2 h3 h4
      exact ⟨h1, h2, h3, h4⟩
    obtain ⟨ρ₁, hρ₁_pos, hρ₁_prop⟩ := Metric.eventually_nhds_iff.mp h_ev_af
    let r_s : ℝ := min ρ₁ (r₀ / 2)
    have hrs_pos : 0 < r_s := lt_min hρ₁_pos (half_pos hr₀_pos)
    have hrs_le_r₀ : r_s ≤ r₀ := le_trans (min_le_right _ _) (half_le_self hr₀_pos.le)
    refine ⟨hΓ_an 0, hΓ_an 1, ha_an, hf_an, ha_ne, hf_ne, h_ode1, h_ode2, h_ode3,
      r_s, X_loc, hrs_pos,
      Set.Subset.trans (Metric.ball_subset_ball hrs_le_r₀) hr₀_T,
      fun z hz => ?_,
      fun i => (hX_holo i).mono (Metric.ball_subset_ball hrs_le_r₀),
      fun i => ⟨Set.Subset.trans (Metric.ball_subset_ball hrs_le_r₀) hr₀_T, fun p hp => ?_⟩,
      fun i z hz => hX_loc_slice_eq i z (Metric.ball_subset_ball hrs_le_r₀ hz)⟩
    · have hz_r₀ : z ∈ Metric.ball s r₀ := Metric.ball_subset_ball hrs_le_r₀ hz
      refine ⟨hr₀_DH hz_r₀, fun hE => hE.2 ?_⟩
      obtain ⟨ha_z, ha_nz, hf_z, hf_nz⟩ :=
        hρ₁_prop (lt_of_lt_of_le (Metric.mem_ball.mp hz) (min_le_left _ _))
      have h_sub_half_1d : Metric.ball z (r₀ / 2) ⊆ Metric.ball s r₀ := by
        intro w hw
        rw [Metric.mem_ball] at hw hz ⊢
        have hz_half : dist z s < r₀ / 2 := lt_of_lt_of_le hz (min_le_right _ _)
        calc dist w s ≤ dist w z + dist z s := dist_triangle _ _ _
          _ < r₀ / 2 + r₀ / 2 := add_lt_add hw hz_half
          _ = r₀ := add_halves r₀
      have h_sub_half_2d : Metric.ball (z, (0 : ℂ)) (r₀ / 2) ⊆ Metric.ball (s, (0 : ℂ)) r₀ := by
        intro q hq
        rw [← ball_prod_same] at hq ⊢
        exact ⟨h_sub_half_1d hq.1, Metric.ball_subset_ball (half_le_self hr₀_pos.le) hq.2⟩
      refine ⟨hr₀_DH hz_r₀, ha_z, ha_nz, hf_z, hf_nz, r₀ / 2, X_loc, half_pos hr₀_pos,
        Set.Subset.trans h_sub_half_1d hr₀_DH,
        Set.Subset.trans h_sub_half_2d hr₀_T,
        fun i => (hX_holo i).mono h_sub_half_2d,
        fun i => ⟨Set.Subset.trans h_sub_half_2d hr₀_T, fun p hp => ?_⟩⟩
      obtain ⟨rp, hrp_pos, hrp_rad, _, hrp_eq⟩ := (hX_ag i).2 p (h_sub_half_2d hp)
      let rp' := min rp (r₀ / 2 - dist p (z, 0))
      have hrp'_pos : 0 < rp' := lt_min hrp_pos (sub_pos.mpr (Metric.mem_ball.mp hp))
      have hrp'_sub : Metric.ball p rp' ⊆ Metric.ball (z, 0) (r₀ / 2) := by
        intro q hq
        rw [Metric.mem_ball] at hq ⊢
        have h_le : rp' ≤ r₀ / 2 - dist p (z, 0) := min_le_right _ _
        linarith [dist_triangle q p (z, 0)]
      exact ⟨rp', hrp'_pos, le_trans (min_le_left _ _) hrp_rad, hrp'_sub,
        fun q hq => hrp_eq q (Metric.ball_subset_ball (min_le_left _ _) hq)⟩
    · obtain ⟨rp, hrp_pos, hrp_rad, _, hrp_eq⟩ :=
        (hX_ag i).2 p (Metric.ball_subset_ball hrs_le_r₀ hp)
      let rp' := min rp (r_s - dist p (s, 0))
      have hrp'_pos : 0 < rp' := lt_min hrp_pos (sub_pos.mpr (Metric.mem_ball.mp hp))
      have hrp'_sub : Metric.ball p rp' ⊆ Metric.ball (s, 0) r_s := by
        intro q hq
        rw [Metric.mem_ball] at hq ⊢
        have h_le : rp' ≤ r_s - dist p (s, 0) := min_le_right _ _
        linarith [dist_triangle q p (s, 0)]
      exact ⟨rp', hrp'_pos, le_trans (min_le_left _ _) hrp_rad, hrp'_sub,
        fun q hq => hrp_eq q (Metric.ball_subset_ball (min_le_left _ _) hq)⟩

  have hΓ_conj_nhdsNE : ∀ s ∈ D_H, ∀ i : Fin 2,
      ∀ᶠ z in nhdsWithin s {s}ᶜ,
        Γ_slice (starRingEnd ℂ z) i = starRingEnd ℂ (Γ_slice z i) := by
    have h_conj_mero : ∀ i : Fin 2,
        MeromorphicOn (fun z => starRingEnd ℂ (Γ_slice (starRingEnd ℂ z) i)) D_H := by
      intro i s hs
      have hs_bar : starRingEnd ℂ s ∈ D_H := hDH_conj s hs
      obtain ⟨n, h, hh_an, hh_ev⟩ :=
        MeromorphicAt.iff_eventuallyEq_zpow_smul_analyticAt.mp (hΓ_mero_i i (starRingEnd ℂ s) hs_bar)
      let h_conj : ℂ → ℂ := fun z => starRingEnd ℂ (h (starRingEnd ℂ z))
      have hh_conj_an : AnalyticAt ℂ h_conj s := by
        obtain ⟨ρ, hρ_pos, hρ_an⟩ := Metric.eventually_nhds_iff.mp hh_an.eventually_analyticAt
        have hh_conj_holo : DifferentiableOn ℂ h_conj (Metric.ball s ρ) := by
          intro z hz
          have hz_bar_dist : dist (starRingEnd ℂ z) (starRingEnd ℂ s) < ρ := by
            rw [dist_eq_norm, ← map_sub, Complex.norm_conj, ← dist_eq_norm]
            exact Metric.mem_ball.mp hz
          have hd : HasDerivAt h (deriv h (starRingEnd ℂ z)) (starRingEnd ℂ z) :=
            (hρ_an hz_bar_dist).differentiableAt.hasDerivAt
          have hd_cc := hd.conj_conj
          rw [Complex.conj_conj] at hd_cc
          exact hd_cc.differentiableAt.differentiableWithinAt
        exact hh_conj_holo.analyticAt (Metric.isOpen_ball.mem_nhds (Metric.mem_ball_self hρ_pos))
      have h_conj_tend : Filter.Tendsto (starRingEnd ℂ) (nhdsWithin s {s}ᶜ)
          (nhdsWithin (starRingEnd ℂ s) {starRingEnd ℂ s}ᶜ) := by
        refine tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within _
          (Complex.continuous_conj.continuousAt.tendsto.mono_left nhdsWithin_le_nhds) ?_
        filter_upwards [self_mem_nhdsWithin] with z hz h_eq
        exact hz (by simpa [Complex.conj_conj] using congr_arg (starRingEnd ℂ) h_eq)
      refine MeromorphicAt.iff_eventuallyEq_zpow_smul_analyticAt.mpr ⟨n, h_conj, hh_conj_an, ?_⟩
      filter_upwards [h_conj_tend.eventually hh_ev] with z hz
      dsimp only [h_conj]
      rw [hz, smul_eq_mul, smul_eq_mul, map_mul, map_zpow₀, map_sub,
        Complex.conj_conj, Complex.conj_conj]
    intro s hs i
    let R_conj : ℂ → ℂ := fun z => starRingEnd ℂ (Γ_slice (starRingEnd ℂ z) i) - Γ_slice z i
    have hR_conj_mero : MeromorphicOn R_conj D_H := (h_conj_mero i).sub (hΓ_mero_i i)
    have hR_conj_zero0 : ∀ᶠ z in nhds (0 : ℂ), R_conj z = 0 := by
      have h0_2s : (0 : ℂ) ∈ horizStrip (2 * W.s_base) := hbase_sub_two h0_base
      filter_upwards [(h_open_hs (2 * W.s_base)).mem_nhds h0_2s] with z hz
      have hz_bar : starRingEnd ℂ z ∈ horizStrip (2 * W.s_base) := by
        change |z.im| < 2 * W.s_base at hz
        change |(starRingEnd ℂ z).im| < 2 * W.s_base
        simpa [Complex.conj_im, abs_neg] using hz
      dsimp only [R_conj]
      rw [h_Γ_base2_eq (starRingEnd ℂ z) hz_bar i, h_Γ_base2_eq z hz i,
        hcurve_conj z hz i, Complex.conj_conj, sub_self]
    filter_upwards [h_mero_zero_on_nhdsNE hR_conj_mero hR_conj_zero0 s hs] with z hz
    have h_eq : starRingEnd ℂ (Γ_slice (starRingEnd ℂ z) i) = Γ_slice z i := sub_eq_zero.mp hz
    simpa only [Complex.conj_conj] using congr_arg (starRingEnd ℂ) h_eq

  exact ⟨{
    Γ_slice := Γ_slice
    a_mero := a_mero
    f_mero := f_mero
    E_disc := E_disc
    E_disc_sub := fun _ h => h.1
    E_disc_base_disjoint := hE_base_disj
    E_disc_isolated := hE_isolated
    Γ_nf := hΓ_nf
    Γ_mero := hΓ_mero
    a_mero_mero := ha_mero_on
    f_mero_mero := hf_mero_on
    slice_base_eq := h_slice_base_eq
    slice_reg := h_slice_reg
    Γ_conj_nhdsNE := hΓ_conj_nhdsNE
    L_slice_holo_isolated := hL_isolated
  }⟩

theorem regular_edge_lazutkin_chart (Ω : Set Plane)
    (C : AnalyticGlancingCollar Ω)
    (hDet : EndpointDeterminationData C)
    (W : CollarWidthTubeData C hDet)
    (H₀ : ℝ)
    (hHX : W.h_X 0 = ENNReal.ofReal H₀)
    (Z₀ : ZeroSliceExtractedData W)
    (x_star sgn ε : ℝ)
    (hsgn : sgn = 1 ∨ sgn = -1)
    (hε : 0 < ε)
    (g : Fin 2 → ℂ → ℂ)
    (hg0 : MeromorphicOn (g 0)
      (Metric.ball ((x_star : ℂ) + ((sgn * H₀ : ℝ) : ℂ) * Complex.I) ε))
    (hg1 : MeromorphicOn (g 1)
      (Metric.ball ((x_star : ℂ) + ((sgn * H₀ : ℝ) : ℂ) * Complex.I) ε))
    (V_overlap : Set ℂ)
    (hVopen : IsOpen V_overlap)
    (hVne : V_overlap.Nonempty)
    (hVsub : V_overlap ⊆
      Metric.ball ((x_star : ℂ) + ((sgn * H₀ : ℝ) : ℂ) * Complex.I) ε ∩ horizStrip H₀)
    (hg_eq : ∀ i : Fin 2, ∀ z ∈ V_overlap, g i z = Z₀.Γ_slice z i) :
    Nonempty (RegularEdgeLazutkinChart C W H₀ Z₀) :=
by
  let _ := (Ω, hDet)
  
  
  
  have h_part1 :
      2 * W.s_base ≤ H₀ ∧
      ∃ (g_nf : Fin 2 → ℂ → ℂ) (s₀ : ℂ) (r_reg : ℝ),
        (∀ i : Fin 2,
          MeromorphicOn (g_nf i) (Metric.ball ((x_star : ℂ) + (H₀ : ℂ) * Complex.I) ε)) ∧
        (∀ i : Fin 2,
          ∀ z ∈ Metric.ball ((x_star : ℂ) + (H₀ : ℂ) * Complex.I) ε ∩ horizStrip H₀,
            g_nf i z = Z₀.Γ_slice z i) ∧
        0 < r_reg ∧
        Metric.ball s₀ r_reg ⊆
          Metric.ball ((x_star : ℂ) + (H₀ : ℂ) * Complex.I) ε ∩ horizStrip H₀ ∧
        (∀ z ∈ Metric.ball s₀ r_reg, z ∈ horizStripENNR (W.h_X 0) ∧ z ∉ Z₀.E_disc) := by
    have h2s_pos : 0 < 2 * W.s_base := by linarith [W.s_base_pos]
    have h_ge_two : ENNReal.ofReal (2 * W.s_base) ≤ W.h_X 0 :=
      W.h_X_ge_two 0 (Metric.mem_ball_self W.r_base_pos)
    have h_ge_ofReal : ENNReal.ofReal (2 * W.s_base) ≤ ENNReal.ofReal H₀ := hHX ▸ h_ge_two
    have hH₀_ennr_pos : 0 < ENNReal.ofReal H₀ :=
      lt_of_lt_of_le (ENNReal.ofReal_pos.mpr h2s_pos) h_ge_ofReal
    have hH₀_pos : 0 < H₀ := ENNReal.ofReal_pos.mp hH₀_ennr_pos
    have hH₀_ge : 2 * W.s_base ≤ H₀ :=
      (ENNReal.ofReal_le_ofReal_iff (le_of_lt hH₀_pos)).mp h_ge_ofReal
    have hstrip_iff : ∀ s : ℂ, s ∈ horizStripENNR (W.h_X 0) ↔ s ∈ horizStrip H₀ := by
      intro s
      dsimp [horizStripENNR, horizStrip]
      rw [hHX, ENNReal.ofReal_lt_ofReal_iff hH₀_pos]

    let s_star : ℂ := (x_star : ℂ) + (H₀ : ℂ) * Complex.I
    let B_plus : Set ℂ := Metric.ball s_star ε
    have hg_mero : ∀ i : Fin 2,
        MeromorphicOn (g i) (Metric.ball ((x_star : ℂ) + ((sgn * H₀ : ℝ) : ℂ) * Complex.I) ε) :=
      Fin.forall_fin_two.mpr ⟨hg0, hg1⟩

    have h_upper : ∃ (g₁ : Fin 2 → ℂ → ℂ) (V₁ : Set ℂ),
        (∀ i : Fin 2, MeromorphicOn (g₁ i) B_plus) ∧
        IsOpen V₁ ∧ V₁.Nonempty ∧
        V₁ ⊆ B_plus ∩ horizStrip H₀ ∧
        (∀ i : Fin 2, ∀ z ∈ V₁, g₁ i z = Z₀.Γ_slice z i) := by
      rcases hsgn with rfl | rfl
      · have h1 : ((1 * H₀ : ℝ) : ℂ) = (H₀ : ℂ) := by push_cast; ring
        refine ⟨g, V_overlap, ?_, hVopen, hVne, ?_, hg_eq⟩
        · intro i; simpa [B_plus, s_star, h1] using hg_mero i
        · simpa [B_plus, s_star, h1] using hVsub
      · let conj := starRingEnd ℂ
        let s_minus : ℂ := (x_star : ℂ) + (((-1 : ℝ) * H₀ : ℝ) : ℂ) * Complex.I
        have hconj_star : conj s_star = s_minus := by
          dsimp [conj, s_star, s_minus]
          simp [Complex.conj_ofReal, Complex.conj_I]
        have hdist_conj : ∀ a b : ℂ, dist (conj a) (conj b) = dist a b := by
          intro a b
          rw [dist_eq_norm, dist_eq_norm, ← map_sub, Complex.norm_conj]
        have hdist_star : ∀ z : ℂ, dist (conj z) s_minus = dist z s_star := by
          intro z
          rw [← hconj_star, hdist_conj]
        let g₁ : Fin 2 → ℂ → ℂ := fun i z => conj (g i (conj z))
        have hg₁_mero : ∀ i : Fin 2, MeromorphicOn (g₁ i) B_plus := by
          intro i z₀ hz₀
          have hw₀ : conj z₀ ∈ Metric.ball s_minus ε := by
            rw [Metric.mem_ball, hdist_star]
            exact hz₀
          obtain ⟨n, u, hu_an, hu_ev⟩ :=
            MeromorphicAt.iff_eventuallyEq_zpow_smul_analyticAt.mp (hg_mero i (conj z₀) hw₀)
          obtain ⟨r₂, hr₂_pos, hr₂_an⟩ := Metric.eventually_nhds_iff.mp hu_an.eventually_analyticAt
          let u_tilde : ℂ → ℂ := ⇑conj ∘ u ∘ ⇑conj
          have hu_tilde_holo : DifferentiableOn ℂ u_tilde (Metric.ball z₀ r₂) := by
            intro z hz
            have hcz : dist (conj z) (conj z₀) < r₂ := by
              rw [hdist_conj]; exact hz
            have hu_hd := (hr₂_an hcz).differentiableAt.hasDerivAt
            have hcc := hu_hd.conj_conj
            rw [Complex.conj_conj] at hcc
            exact hcc.differentiableAt.differentiableWithinAt
          have hu_tilde_an : AnalyticAt ℂ u_tilde z₀ :=
            hu_tilde_holo.analyticAt
              (Metric.isOpen_ball.mem_nhds (Metric.mem_ball_self hr₂_pos))
          obtain ⟨r₁, hr₁_pos, hr₁_eq⟩ := Metric.mem_nhdsWithin_iff.mp hu_ev
          refine MeromorphicAt.iff_eventuallyEq_zpow_smul_analyticAt.mpr ⟨n, u_tilde, hu_tilde_an, ?_⟩
          refine Metric.mem_nhdsWithin_iff.mpr ⟨r₁, hr₁_pos, ?_⟩
          rintro z ⟨hz_lt, hz_ne⟩
          have hcz_lt : conj z ∈ Metric.ball (conj z₀) r₁ := by
            rw [Metric.mem_ball, hdist_conj]; exact hz_lt
          have hcz_ne : conj z ≠ conj z₀ := by
            intro heq
            apply hz_ne
            have h1 := congrArg conj heq
            simpa [conj, Complex.conj_conj] using h1
          have hgz : g i (conj z) = (conj z - conj z₀) ^ n • u (conj z) :=
            hr₁_eq ⟨hcz_lt, hcz_ne⟩
          dsimp [g₁, u_tilde, Function.comp]
          change conj (g i (conj z)) = (z - z₀) ^ n • conj (u (conj z))
          rw [hgz]
          simp only [smul_eq_mul, map_mul, map_zpow₀, map_sub, conj, Complex.conj_conj]
        obtain ⟨p₀, hp₀_V⟩ := hVne
        have hp₀_sub := hVsub hp₀_V
        have hp₀_strip : p₀ ∈ horizStripENNR (W.h_X 0) := (hstrip_iff p₀).mpr hp₀_sub.2
        obtain ⟨r_V, hr_V_pos, hr_V_sub⟩ := Metric.isOpen_iff.mp hVopen p₀ hp₀_V
        have hconj_both : ∀ᶠ w in nhdsWithin p₀ {p₀}ᶜ,
            ∀ i : Fin 2, Z₀.Γ_slice (conj w) i = conj (Z₀.Γ_slice w i) := by
          filter_upwards [Z₀.Γ_conj_nhdsNE p₀ hp₀_strip 0,
            Z₀.Γ_conj_nhdsNE p₀ hp₀_strip 1] with w hw0 hw1 i
          fin_cases i
          · exact hw0
          · exact hw1
        obtain ⟨r_c, hr_c_pos, hr_c_eq⟩ := Metric.mem_nhdsWithin_iff.mp hconj_both
        let r : ℝ := min r_V r_c
        have hr_pos : 0 < r := lt_min hr_V_pos hr_c_pos
        let p₁ : ℂ := p₀ + ((r / 2 : ℝ) : ℂ)
        let V₁ : Set ℂ := Metric.ball (conj p₁) (r / 2)
        have hV₁_open : IsOpen V₁ := Metric.isOpen_ball
        have hV₁_ne : V₁.Nonempty := ⟨conj p₁, Metric.mem_ball_self (half_pos hr_pos)⟩
        have hp₁_dist : dist p₁ p₀ = r / 2 := by
          dsimp [p₁]
          rw [dist_eq_norm, add_sub_cancel_left, Complex.norm_real,
            Real.norm_of_nonneg (le_of_lt (half_pos hr_pos))]
        have hV₁_w : ∀ z ∈ V₁,
            conj z ∈ V_overlap ∧ conj z ∈ Metric.ball p₀ r_c ∧ conj z ≠ p₀ := by
          intro z hz
          have hwp₁ : dist (conj z) p₁ < r / 2 := by
            have h1 : dist (conj z) (conj (conj p₁)) < r / 2 := by
              rwa [hdist_conj]
            simpa [conj, Complex.conj_conj] using h1
          have hwp₀ : dist (conj z) p₀ < r := by
            calc
              dist (conj z) p₀ ≤ dist (conj z) p₁ + dist p₁ p₀ := dist_triangle _ _ _
              _ < r / 2 + r / 2 := by rw [hp₁_dist]; linarith
              _ = r := add_halves r
          have hw_ne : conj z ≠ p₀ := by
            intro heq
            rw [heq, dist_comm, hp₁_dist] at hwp₁
            exact lt_irrefl _ hwp₁
          exact ⟨hr_V_sub (lt_of_lt_of_le hwp₀ (min_le_left _ _)),
            lt_of_lt_of_le hwp₀ (min_le_right _ _), hw_ne⟩
        refine ⟨g₁, V₁, hg₁_mero, hV₁_open, hV₁_ne, ?_, ?_⟩
        · intro z hz
          obtain ⟨hw_V, _, _⟩ := hV₁_w z hz
          have hw_sub := hVsub hw_V
          refine ⟨?_, ?_⟩
          · rw [Metric.mem_ball, ← hdist_star]
            exact hw_sub.1
          · dsimp [horizStrip] at hw_sub ⊢
            have him : (conj z).im = -z.im := Complex.conj_im z
            have habs : |(conj z).im| = |z.im| := by rw [him, abs_neg]
            rw [← habs]
            exact hw_sub.2
        · intro i z hz
          obtain ⟨hw_V, hw_rc, hw_ne⟩ := hV₁_w z hz
          have hc_slice : Z₀.Γ_slice (conj (conj z)) i = conj (Z₀.Γ_slice (conj z) i) :=
            hr_c_eq ⟨hw_rc, hw_ne⟩ i
          dsimp [g₁]
          rw [hg_eq i (conj z) hw_V, ← hc_slice]
          dsimp [conj]
          rw [Complex.conj_conj]

    obtain ⟨g₁, V₁, hg₁_mero, hV₁_open, hV₁_ne, hV₁_sub, hg₁_eq⟩ := h_upper

    let g_nf : Fin 2 → ℂ → ℂ := fun i => toMeromorphicNFOn (g₁ i) B_plus
    have hg_nf_nf : ∀ i : Fin 2, MeromorphicNFOn (g_nf i) B_plus :=
      fun i => meromorphicNFOn_toMeromorphicNFOn (g₁ i) B_plus
    have hg_nf_mero : ∀ i : Fin 2, MeromorphicOn (g_nf i) B_plus :=
      fun i => (hg_nf_nf i).meromorphicOn

    let U_int : Set ℂ := B_plus ∩ horizStrip H₀
    have hstrip_open : IsOpen (horizStrip H₀) :=
      isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const
    have hU_int_open : IsOpen U_int := Metric.isOpen_ball.inter hstrip_open
    have hstrip_conv : Convex ℝ (horizStrip H₀) := by
      intro x hx y hy a b ha hb hab
      change |x.im| < H₀ at hx
      change |y.im| < H₀ at hy
      change |(a • x + b • y).im| < H₀
      have him : (a • x + b • y).im = a * x.im + b * y.im := by simp
      rw [him]
      calc
        |a * x.im + b * y.im| ≤ |a * x.im| + |b * y.im| := abs_add_le _ _
        _ = a * |x.im| + b * |y.im| := by
          rw [abs_mul, abs_mul, abs_of_nonneg ha, abs_of_nonneg hb]
        _ < a * H₀ + b * H₀ := by
          by_cases ha0 : a = 0
          · subst ha0
            have hb1 : b = 1 := by linarith
            subst hb1; linarith
          · have ha_pos : 0 < a := lt_of_le_of_ne ha (Ne.symm ha0)
            have h1 : a * |x.im| < a * H₀ := mul_lt_mul_of_pos_left hx ha_pos
            have h2 : b * |y.im| ≤ b * H₀ := mul_le_mul_of_nonneg_left (le_of_lt hy) hb
            linarith
        _ = H₀ := by linear_combination H₀ * hab
    have hU_int_pre : IsPreconnected U_int :=
      ((convex_ball s_star ε).inter hstrip_conv).isPreconnected

    obtain ⟨z_v, hz_v_V₁⟩ := hV₁_ne
    have hz_v_U : z_v ∈ U_int := hV₁_sub hz_v_V₁

    have hg_nf_eq_slice : ∀ i : Fin 2, ∀ z ∈ U_int, g_nf i z = Z₀.Γ_slice z i := by
      intro i z hz
      let γ_i : ℂ → ℂ := fun w => Z₀.Γ_slice w i
      have hγ_nf : MeromorphicNFOn γ_i (horizStripENNR (W.h_X 0)) := by
        dsimp [γ_i]; fin_cases i
        · exact Z₀.Γ_nf.1
        · exact Z₀.Γ_nf.2
      have hγ_mero : MeromorphicOn γ_i (horizStripENNR (W.h_X 0)) := by
        dsimp [γ_i]; fin_cases i
        · exact Z₀.Γ_mero.1
        · exact Z₀.Γ_mero.2
      have hd_mero : MeromorphicOn (fun w => g_nf i w - γ_i w) U_int :=
        MeromorphicOn.sub (fun w hw => hg_nf_mero i w hw.1)
          (fun w hw => hγ_mero w ((hstrip_iff w).mpr hw.2))
      have hd_top_zv : meromorphicOrderAt (fun w => g_nf i w - γ_i w) z_v = ⊤ := by
        rw [meromorphicOrderAt_eq_top_iff]
        have hev1 : g_nf i =ᶠ[nhdsWithin z_v {z_v}ᶜ] g₁ i :=
          (hg₁_mero i).toMeromorphicNFOn_eq_self_on_nhdsNE hz_v_U.1
        have hev2 : g₁ i =ᶠ[nhdsWithin z_v {z_v}ᶜ] γ_i :=
          Filter.eventually_of_mem (nhdsWithin_le_nhds (hV₁_open.mem_nhds hz_v_V₁))
            (hg₁_eq i)
        filter_upwards [hev1, hev2] with w hw1 hw2
        rw [hw1, hw2, sub_self]
      have hd_top_z : meromorphicOrderAt (fun w => g_nf i w - γ_i w) z = ⊤ := by
        by_contra hne
        exact hd_mero.meromorphicOrderAt_ne_top_of_isPreconnected hU_int_pre
          hz hz_v_U hne hd_top_zv
      have hev_punc : g_nf i =ᶠ[nhdsWithin z {z}ᶜ] γ_i := by
        filter_upwards [meromorphicOrderAt_eq_top_iff.mp hd_top_z] with w hw
        exact sub_eq_zero.mp hw
      have hnf1 : MeromorphicNFAt (g_nf i) z := hg_nf_nf i hz.1
      have hnf2 : MeromorphicNFAt γ_i z := hγ_nf ((hstrip_iff z).mpr hz.2)
      exact ((MeromorphicNFAt.eventuallyEq_nhdsNE_iff_eventuallyEq_nhds hnf1 hnf2).mp
        hev_punc).eq_of_nhds

    obtain ⟨r_u, hr_u_pos, hr_u_sub⟩ := Metric.isOpen_iff.mp hU_int_open z_v hz_v_U
    obtain ⟨r_e, hr_e_pos, _, hr_e_noE⟩ :=
      Z₀.E_disc_isolated z_v ((hstrip_iff z_v).mpr hz_v_U.2)
    let r_m : ℝ := min r_u r_e
    have hr_m_pos : 0 < r_m := lt_min hr_u_pos hr_e_pos
    let s₀ : ℂ := z_v + ((r_m / 2 : ℝ) : ℂ)
    have hs₀_dist : dist s₀ z_v = r_m / 2 := by
      dsimp [s₀]
      rw [dist_eq_norm, add_sub_cancel_left, Complex.norm_real,
        Real.norm_of_nonneg (le_of_lt (half_pos hr_m_pos))]
    have hs₀_ru : s₀ ∈ Metric.ball z_v r_u := by
      rw [Metric.mem_ball, hs₀_dist]
      linarith [min_le_left r_u r_e]
    have hs₀_re : s₀ ∈ Metric.ball z_v r_e := by
      rw [Metric.mem_ball, hs₀_dist]
      linarith [min_le_right r_u r_e]
    have hs₀_ne_zv : s₀ ≠ z_v := by
      intro heq
      rw [heq, dist_self] at hs₀_dist
      linarith
    have hs₀_U : s₀ ∈ U_int := hr_u_sub hs₀_ru
    have hs₀_noE : s₀ ∉ Z₀.E_disc := hr_e_noE s₀ hs₀_re hs₀_ne_zv
    obtain ⟨_, _, _, _, _, _, _, _, _, r_s, _, hr_s_pos, _, hr_s_reg, _⟩ :=
      Z₀.slice_reg s₀ ((hstrip_iff s₀).mpr hs₀_U.2) hs₀_noE
    obtain ⟨r_u2, hr_u2_pos, hr_u2_sub⟩ := Metric.isOpen_iff.mp hU_int_open s₀ hs₀_U
    let r_reg : ℝ := min r_s r_u2
    have hr_reg_pos : 0 < r_reg := lt_min hr_s_pos hr_u2_pos

    refine ⟨hH₀_ge, g_nf, s₀, r_reg, hg_nf_mero, hg_nf_eq_slice, hr_reg_pos,
      Set.Subset.trans (Metric.ball_subset_ball (min_le_right _ _)) hr_u2_sub,
      fun z hz => hr_s_reg z (Metric.ball_subset_ball (min_le_left _ _) hz)⟩

  obtain ⟨hH₀_ge, g_nf, s₀, r_reg, hg_nf_mero, hg_nf_eq_slice, hr_reg_pos,
    hB_reg_sub_int, hB_reg_slice⟩ := h_part1

  
  
  
  have hreg : ∀ z ∈ Metric.ball s₀ r_reg,
      AnalyticAt ℂ (g_nf 0) z ∧
      AnalyticAt ℂ (g_nf 1) z ∧
      AnalyticAt ℂ Z₀.a_mero z ∧
      AnalyticAt ℂ Z₀.f_mero z ∧
      Z₀.a_mero z ≠ 0 ∧
      Z₀.f_mero z ≠ 0 ∧
      deriv (g_nf 0) z + Complex.I * deriv (g_nf 1) z =
        Complex.I * (C.c : ℂ) * Z₀.a_mero z / (Z₀.f_mero z) ^ 2 ∧
      deriv (g_nf 0) z - Complex.I * deriv (g_nf 1) z =
        -Complex.I * (C.c : ℂ) / (Z₀.a_mero z * (Z₀.f_mero z) ^ 2) ∧
      deriv Z₀.a_mero z = Complex.I * Z₀.f_mero z * Z₀.a_mero z := by
    have hg_holo_reg : ∀ i : Fin 2, DifferentiableOn ℂ (g_nf i) (Metric.ball s₀ r_reg) := by
      intro i w hw
      have hγ_holo : DifferentiableOn ℂ (fun u => Z₀.Γ_slice u i) (Metric.ball s₀ r_reg) := by
        intro u hu
        obtain ⟨hu_st, hu_noE⟩ := hB_reg_slice u hu
        fin_cases i
        · exact (Z₀.slice_reg u hu_st hu_noE).1.differentiableAt.differentiableWithinAt
        · exact (Z₀.slice_reg u hu_st hu_noE).2.1.differentiableAt.differentiableWithinAt
      exact (hγ_holo.congr (fun u hu => hg_nf_eq_slice i u (hB_reg_sub_int hu))) w hw
    intro z hz
    obtain ⟨hz_st, hz_noE⟩ := hB_reg_slice z hz
    obtain ⟨_, _, ha_an, hf_an, ha_nz, hf_nz, hdZ_sl, hdW_sl, hda_sl, _⟩ :=
      Z₀.slice_reg z hz_st hz_noE
    have hev0 : g_nf 0 =ᶠ[nhds z] fun u => Z₀.Γ_slice u 0 :=
      Filter.eventually_of_mem (Metric.isOpen_ball.mem_nhds hz)
        (fun u hu => hg_nf_eq_slice 0 u (hB_reg_sub_int hu))
    have hev1 : g_nf 1 =ᶠ[nhds z] fun u => Z₀.Γ_slice u 1 :=
      Filter.eventually_of_mem (Metric.isOpen_ball.mem_nhds hz)
        (fun u hu => hg_nf_eq_slice 1 u (hB_reg_sub_int hu))
    refine ⟨(hg_holo_reg 0).analyticAt (Metric.isOpen_ball.mem_nhds hz),
      (hg_holo_reg 1).analyticAt (Metric.isOpen_ball.mem_nhds hz),
      ha_an, hf_an, ha_nz, hf_nz, ?_, ?_, hda_sl⟩
    · rw [hev0.deriv_eq, hev1.deriv_eq, hdZ_sl]
    · rw [hev0.deriv_eq, hev1.deriv_eq, hdW_sl]

  
  
  
  have h_part2 :
      ∃ (x_edge R_1 : ℝ) (a_g f_g : ℂ → ℂ),
        0 < R_1 ∧
        Metric.ball ((x_edge : ℂ) + (H₀ : ℂ) * Complex.I) R_1 ⊆
          Metric.ball ((x_star : ℂ) + (H₀ : ℂ) * Complex.I) ε ∧
        (∀ i : Fin 2,
          DifferentiableOn ℂ (g_nf i)
            (Metric.ball ((x_edge : ℂ) + (H₀ : ℂ) * Complex.I) R_1)) ∧
        DifferentiableOn ℂ a_g
          (Metric.ball ((x_edge : ℂ) + (H₀ : ℂ) * Complex.I) R_1) ∧
        DifferentiableOn ℂ f_g
          (Metric.ball ((x_edge : ℂ) + (H₀ : ℂ) * Complex.I) R_1) ∧
        (∀ z ∈ Metric.ball ((x_edge : ℂ) + (H₀ : ℂ) * Complex.I) R_1, a_g z ≠ 0) ∧
        (∀ z ∈ Metric.ball ((x_edge : ℂ) + (H₀ : ℂ) * Complex.I) R_1, f_g z ≠ 0) ∧
        (∀ z ∈ Metric.ball ((x_edge : ℂ) + (H₀ : ℂ) * Complex.I) R_1,
          g_nf 0 z * deriv (g_nf 1) z - g_nf 1 z * deriv (g_nf 0) z ≠ 0) ∧
        (∀ z ∈ Metric.ball ((x_edge : ℂ) + (H₀ : ℂ) * Complex.I) R_1,
          (deriv (g_nf 0) z + Complex.I * deriv (g_nf 1) z) * (f_g z) ^ 2 =
            Complex.I * (C.c : ℂ) * a_g z) ∧
        (∀ z ∈ Metric.ball ((x_edge : ℂ) + (H₀ : ℂ) * Complex.I) R_1,
          (deriv (g_nf 0) z - Complex.I * deriv (g_nf 1) z) * a_g z * (f_g z) ^ 2 =
            -Complex.I * (C.c : ℂ)) ∧
        (∀ z ∈ Metric.ball ((x_edge : ℂ) + (H₀ : ℂ) * Complex.I) R_1,
          deriv a_g z = Complex.I * f_g z * a_g z) := by
    have hc : 0 < C.c := C.c_pos
    have hB_reg_sub : Metric.ball s₀ r_reg ⊆
        Metric.ball ((x_star : ℂ) + (H₀ : ℂ) * Complex.I) ε :=
      Set.Subset.trans hB_reg_sub_int Set.inter_subset_left
    let a_mero := Z₀.a_mero
    let f_mero := Z₀.f_mero
    let s_star : ℂ := (x_star : ℂ) + (H₀ : ℂ) * Complex.I
    let B_plus : Set ℂ := Metric.ball s_star ε
    let B_reg : Set ℂ := Metric.ball s₀ r_reg
    have hs_star_mem : s_star ∈ B_plus := Metric.mem_ball_self hε
    have hs₀_B_reg : s₀ ∈ B_reg := Metric.mem_ball_self hr_reg_pos
    have hs₀_B_plus : s₀ ∈ B_plus := hB_reg_sub hs₀_B_reg
    have hB_plus_pre : IsPreconnected B_plus := (convex_ball s_star ε).isPreconnected
    have hc_ne : (C.c : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (ne_of_gt hc)
    have hIc_ne : Complex.I * (C.c : ℂ) ≠ 0 := mul_ne_zero Complex.I_ne_zero hc_ne

    let dZ_g : ℂ → ℂ := fun z => deriv (g_nf 0) z + Complex.I * deriv (g_nf 1) z
    let dW_g : ℂ → ℂ := fun z => deriv (g_nf 0) z - Complex.I * deriv (g_nf 1) z
    let A2_g : ℂ → ℂ := fun z => ((0 : ℂ) - dZ_g z) / dW_g z
    let f_g : ℂ → ℂ := fun z => deriv A2_g z / ((2 * Complex.I) * A2_g z)
    let a_g : ℂ → ℂ := fun z => (dZ_g z * (f_g z) ^ 2) / (Complex.I * (C.c : ℂ))
    let W_sup : ℂ → ℂ := fun z => g_nf 0 z * deriv (g_nf 1) z - g_nf 1 z * deriv (g_nf 0) z
    let R_W : ℂ → ℂ := fun z => dW_g z * a_g z * (f_g z) ^ 2 + Complex.I * (C.c : ℂ)
    let R_a : ℂ → ℂ := fun z => deriv a_g z - Complex.I * f_g z * a_g z

    have hd0_mero : MeromorphicOn (deriv (g_nf 0)) B_plus := (hg_nf_mero 0).deriv
    have hd1_mero : MeromorphicOn (deriv (g_nf 1)) B_plus := (hg_nf_mero 1).deriv
    have hdZ_mero : MeromorphicOn dZ_g B_plus :=
      hd0_mero.add ((MeromorphicOn.const Complex.I).mul hd1_mero)
    have hdW_mero : MeromorphicOn dW_g B_plus :=
      hd0_mero.sub ((MeromorphicOn.const Complex.I).mul hd1_mero)
    have hA2_mero : MeromorphicOn A2_g B_plus :=
      ((MeromorphicOn.const (0 : ℂ)).sub hdZ_mero).div hdW_mero
    have hf_mero : MeromorphicOn f_g B_plus :=
      hA2_mero.deriv.div ((MeromorphicOn.const (2 * Complex.I)).mul hA2_mero)
    have ha_mero : MeromorphicOn a_g B_plus :=
      (hdZ_mero.mul (hf_mero.pow 2)).div (MeromorphicOn.const (Complex.I * (C.c : ℂ)))
    have hWsup_mero : MeromorphicOn W_sup B_plus :=
      ((hg_nf_mero 0).mul hd1_mero).sub ((hg_nf_mero 1).mul hd0_mero)
    have hRW_mero : MeromorphicOn R_W B_plus :=
      ((hdW_mero.mul ha_mero).mul (hf_mero.pow 2)).add
        (MeromorphicOn.const (Complex.I * (C.c : ℂ)))
    have hRa_mero : MeromorphicOn R_a B_plus :=
      ha_mero.deriv.sub (((MeromorphicOn.const Complex.I).mul hf_mero).mul ha_mero)

    have hA2_eq_B_reg : ∀ z ∈ B_reg, A2_g z = (a_mero z) ^ 2 := by
      intro z hz
      obtain ⟨_, _, _, _, ha_nz, hf_nz, hdZ_eq, hdW_eq, _⟩ := hreg z hz
      dsimp [A2_g, dZ_g, dW_g, a_mero, f_mero]
      rw [hdZ_eq, hdW_eq]
      have hI : Complex.I ≠ 0 := Complex.I_ne_zero
      field_simp [hc_ne, hI, ha_nz, hf_nz]
      ring

    have hf_eq_B_reg : ∀ z ∈ B_reg, f_g z = f_mero z := by
      intro z hz
      obtain ⟨_, _, ha_an, _, ha_nz, _, _, _, hda_eq⟩ := hreg z hz
      have hev : A2_g =ᶠ[nhds z] fun w => (a_mero w) ^ 2 :=
        Filter.eventually_of_mem (Metric.isOpen_ball.mem_nhds hz) hA2_eq_B_reg
      have ha_hd : HasDerivAt a_mero (Complex.I * f_mero z * a_mero z) z := by
        have h1 := ha_an.differentiableAt.hasDerivAt
        rwa [hda_eq] at h1
      have hsq_hd : HasDerivAt (fun w => (a_mero w) ^ 2)
          (2 * Complex.I * f_mero z * (a_mero z) ^ 2) z :=
        (ha_hd.pow 2).congr_deriv (by push_cast; ring)
      have hdA2 : deriv A2_g z = 2 * Complex.I * f_mero z * (a_mero z) ^ 2 := by
        rw [hev.deriv_eq, hsq_hd.deriv]
      dsimp [f_g, a_mero, f_mero] at hdA2 ⊢
      rw [hdA2, hA2_eq_B_reg z hz]
      dsimp [a_mero]
      have hI : Complex.I ≠ 0 := Complex.I_ne_zero
      field_simp [hI, ha_nz]

    have ha_eq_B_reg : ∀ z ∈ B_reg, a_g z = a_mero z := by
      intro z hz
      obtain ⟨_, _, _, _, _, hf_nz, hdZ_eq, _, _⟩ := hreg z hz
      dsimp [a_g, dZ_g]
      rw [hdZ_eq, hf_eq_B_reg z hz]
      dsimp [a_mero, f_mero]
      have hI : Complex.I ≠ 0 := Complex.I_ne_zero
      field_simp [hc_ne, hI, hf_nz]

    have hRW_zero_B_reg : ∀ z ∈ B_reg, R_W z = 0 := by
      intro z hz
      obtain ⟨_, _, _, _, ha_nz, hf_nz, _, hdW_eq, _⟩ := hreg z hz
      dsimp [R_W, dW_g]
      rw [hdW_eq, ha_eq_B_reg z hz, hf_eq_B_reg z hz]
      dsimp [a_mero, f_mero]
      field_simp [ha_nz, hf_nz]
      ring

    have hRa_zero_B_reg : ∀ z ∈ B_reg, R_a z = 0 := by
      intro z hz
      obtain ⟨_, _, _, _, _, _, _, _, hda_eq⟩ := hreg z hz
      have hev : a_g =ᶠ[nhds z] a_mero :=
        Filter.eventually_of_mem (Metric.isOpen_ball.mem_nhds hz) ha_eq_B_reg
      dsimp [R_a]
      rw [hev.deriv_eq]
      dsimp [a_mero]
      rw [hda_eq, hf_eq_B_reg z hz, ha_eq_B_reg z hz]
      dsimp [a_mero, f_mero]
      exact sub_self _

    have ha_ord_s₀ : meromorphicOrderAt a_g s₀ ≠ ⊤ := by
      rw [meromorphicOrderAt_ne_top_iff_eventually_ne_zero (ha_mero s₀ hs₀_B_plus)]
      refine Filter.eventually_of_mem
        (nhdsWithin_le_nhds (Metric.isOpen_ball.mem_nhds hs₀_B_reg)) ?_
      intro z hz
      rw [ha_eq_B_reg z hz]
      exact (hreg z hz).2.2.2.2.1

    have hf_ord_s₀ : meromorphicOrderAt f_g s₀ ≠ ⊤ := by
      rw [meromorphicOrderAt_ne_top_iff_eventually_ne_zero (hf_mero s₀ hs₀_B_plus)]
      refine Filter.eventually_of_mem
        (nhdsWithin_le_nhds (Metric.isOpen_ball.mem_nhds hs₀_B_reg)) ?_
      intro z hz
      rw [hf_eq_B_reg z hz]
      exact (hreg z hz).2.2.2.2.2.1

    have hRW_ord_s₀ : meromorphicOrderAt R_W s₀ = ⊤ := by
      rw [meromorphicOrderAt_eq_top_iff]
      exact Filter.eventually_of_mem
        (nhdsWithin_le_nhds (Metric.isOpen_ball.mem_nhds hs₀_B_reg)) hRW_zero_B_reg

    have hRa_ord_s₀ : meromorphicOrderAt R_a s₀ = ⊤ := by
      rw [meromorphicOrderAt_eq_top_iff]
      exact Filter.eventually_of_mem
        (nhdsWithin_le_nhds (Metric.isOpen_ball.mem_nhds hs₀_B_reg)) hRa_zero_B_reg

    have hWsup_ord_s₀ : meromorphicOrderAt W_sup s₀ ≠ ⊤ := by
      intro htop
      have hev_punc : ∀ᶠ z in nhdsWithin s₀ {s₀}ᶜ, W_sup z = 0 :=
        meromorphicOrderAt_eq_top_iff.mp htop
      have hg0_holo_reg : DifferentiableOn ℂ (g_nf 0) B_reg :=
        fun z hz => (hreg z hz).1.differentiableAt.differentiableWithinAt
      have hg1_holo_reg : DifferentiableOn ℂ (g_nf 1) B_reg :=
        fun z hz => (hreg z hz).2.1.differentiableAt.differentiableWithinAt
      have hW_holo_reg : DifferentiableOn ℂ W_sup B_reg :=
        (hg0_holo_reg.mul (hg1_holo_reg.deriv Metric.isOpen_ball)).sub
          (hg1_holo_reg.mul (hg0_holo_reg.deriv Metric.isOpen_ball))
      have hW_cont_s₀ : ContinuousAt W_sup s₀ :=
        hW_holo_reg.continuousOn.continuousAt (Metric.isOpen_ball.mem_nhds hs₀_B_reg)
      have hWs₀_zero : W_sup s₀ = 0 :=
        tendsto_nhds_unique hW_cont_s₀.continuousWithinAt
          (tendsto_const_nhds.congr' (hev_punc.mono fun _ hz => hz.symm))
      obtain ⟨r_w, hr_w_pos, hr_w_zero⟩ := Metric.mem_nhdsWithin_iff.mp hev_punc
      let r₀ : ℝ := min r_w r_reg
      have hr₀_pos : 0 < r₀ := lt_min hr_w_pos hr_reg_pos
      let B₀ : Set ℂ := Metric.ball s₀ r₀
      have hB₀_sub_reg : B₀ ⊆ B_reg := Metric.ball_subset_ball (min_le_right _ _)
      have hs₀_B₀ : s₀ ∈ B₀ := Metric.mem_ball_self hr₀_pos
      have hW_zero_B₀ : ∀ z ∈ B₀, W_sup z = 0 := by
        intro z hz
        by_cases hzs : z = s₀
        · subst hzs; exact hWs₀_zero
        · exact hr_w_zero ⟨Metric.ball_subset_ball (min_le_left _ _) hz, hzs⟩
      have hf_holo_B₀ : DifferentiableOn ℂ f_mero B₀ :=
        fun z hz => (hreg z (hB₀_sub_reg hz)).2.2.2.1.differentiableAt.differentiableWithinAt
      obtain ⟨ϕ_raw, hϕ_raw⟩ := hf_holo_B₀.isExactOn_ball
      let ϕ₀ : ℂ → ℂ := fun z =>
        ϕ_raw z - ϕ_raw s₀ - Complex.I * Complex.log (a_mero s₀)
      have hϕ₀_hd : ∀ z ∈ B₀, HasDerivAt ϕ₀ (f_mero z) z := by
        intro z hz
        exact ((hϕ_raw z hz).sub_const (ϕ_raw s₀)).sub_const
          (Complex.I * Complex.log (a_mero s₀))
      let Q₀ : ℂ → ℂ := fun z => a_mero z * Complex.exp (-Complex.I * ϕ₀ z)
      have hQ₀_hd : ∀ z ∈ B₀, HasDerivAt Q₀ 0 z := by
        intro z hz
        obtain ⟨_, _, ha_an, _, _, _, _, _, hda⟩ := hreg z (hB₀_sub_reg hz)
        have ha_hd : HasDerivAt a_mero (Complex.I * f_mero z * a_mero z) z := by
          have h1 := ha_an.differentiableAt.hasDerivAt
          rwa [hda] at h1
        have hexp_hd : HasDerivAt (fun w => Complex.exp (-Complex.I * ϕ₀ w))
            (Complex.exp (-Complex.I * ϕ₀ z) * (-Complex.I * f_mero z)) z :=
          (Complex.hasDerivAt_exp (-Complex.I * ϕ₀ z)).comp z
            ((hϕ₀_hd z hz).const_mul (-Complex.I))
        exact (ha_hd.mul hexp_hd).congr_deriv (by ring)
      have ha_exp_B₀ : ∀ z ∈ B₀, a_mero z = Complex.exp (Complex.I * ϕ₀ z) := by
        intro z hz
        have hQ₀_s₀ : Q₀ s₀ = 1 := by
          have harg : -Complex.I * ϕ₀ s₀ = -Complex.log (a_mero s₀) := by
            dsimp [ϕ₀]; ring_nf; simp [Complex.I_sq]
          have ha_s₀_ne := (hreg s₀ hs₀_B_reg).2.2.2.2.1
          dsimp [Q₀]
          rw [harg, Complex.exp_neg, Complex.exp_log ha_s₀_ne]
          exact mul_inv_cancel₀ ha_s₀_ne
        have hQc : Q₀ z = 1 := by
          rw [IsOpen.is_const_of_deriv_eq_zero Metric.isOpen_ball
            (convex_ball s₀ r₀).isPreconnected
            (fun w hw => (hQ₀_hd w hw).differentiableAt.differentiableWithinAt)
            (fun w hw => (hQ₀_hd w hw).deriv) hz hs₀_B₀, hQ₀_s₀]
        dsimp [Q₀] at hQc
        calc
          a_mero z = a_mero z * Complex.exp (-Complex.I * ϕ₀ z) * Complex.exp (Complex.I * ϕ₀ z) := by
            rw [mul_assoc, ← Complex.exp_add]; simp
          _ = Complex.exp (Complex.I * ϕ₀ z) := by rw [hQc, one_mul]
      have hg_deriv_B₀ : ∀ z ∈ B₀,
          deriv (g_nf 0) z = -(C.c : ℂ) * Complex.sin (ϕ₀ z) / (f_mero z) ^ 2 ∧
          deriv (g_nf 1) z = (C.c : ℂ) * Complex.cos (ϕ₀ z) / (f_mero z) ^ 2 := by
        intro z hz
        obtain ⟨_, _, _, _, _, hf_nz, hdZ, hdW, _⟩ := hreg z (hB₀_sub_reg hz)
        dsimp [a_mero, f_mero] at ha_exp_B₀ ⊢
        rw [ha_exp_B₀ z hz] at hdZ hdW
        have hexp_p : Complex.exp (Complex.I * ϕ₀ z) =
            Complex.cos (ϕ₀ z) + Complex.sin (ϕ₀ z) * Complex.I := by
          rw [mul_comm, Complex.exp_mul_I]
        have hexp_n : (Complex.exp (Complex.I * ϕ₀ z))⁻¹ =
            Complex.cos (ϕ₀ z) - Complex.sin (ϕ₀ z) * Complex.I := by
          rw [← Complex.exp_neg]
          have h1 : -(Complex.I * ϕ₀ z) = (-ϕ₀ z) * Complex.I := by ring
          rw [h1, Complex.exp_mul_I, Complex.cos_neg, Complex.sin_neg]
          ring
        have hdW' : deriv (g_nf 0) z - Complex.I * deriv (g_nf 1) z =
            -Complex.I * (C.c : ℂ) * (Complex.exp (Complex.I * ϕ₀ z))⁻¹ / (Z₀.f_mero z) ^ 2 := by
          rw [hdW]; ring
        rw [hexp_p] at hdZ
        rw [hexp_n] at hdW'
        constructor
        · have hsum : 2 * deriv (g_nf 0) z =
              2 * (-(C.c : ℂ) * Complex.sin (ϕ₀ z) / (Z₀.f_mero z) ^ 2) := by
            calc
              2 * deriv (g_nf 0) z =
                  (deriv (g_nf 0) z + Complex.I * deriv (g_nf 1) z) +
                  (deriv (g_nf 0) z - Complex.I * deriv (g_nf 1) z) := by ring
              _ = Complex.I * (C.c : ℂ) * (Complex.cos (ϕ₀ z) + Complex.sin (ϕ₀ z) * Complex.I) /
                    (Z₀.f_mero z) ^ 2 +
                  (-Complex.I * (C.c : ℂ) * (Complex.cos (ϕ₀ z) - Complex.sin (ϕ₀ z) * Complex.I) /
                    (Z₀.f_mero z) ^ 2) := by rw [hdZ, hdW']
              _ = 2 * Complex.I ^ 2 * (C.c : ℂ) * Complex.sin (ϕ₀ z) / (Z₀.f_mero z) ^ 2 := by ring
              _ = 2 * (-(C.c : ℂ) * Complex.sin (ϕ₀ z) / (Z₀.f_mero z) ^ 2) := by
                rw [Complex.I_sq]; ring
          exact mul_left_cancel₀ two_ne_zero hsum
        · have h2I : (2 : ℂ) * Complex.I ≠ 0 := mul_ne_zero two_ne_zero Complex.I_ne_zero
          have hdiff : (2 * Complex.I) * deriv (g_nf 1) z =
              (2 * Complex.I) * ((C.c : ℂ) * Complex.cos (ϕ₀ z) / (Z₀.f_mero z) ^ 2) := by
            calc
              (2 * Complex.I) * deriv (g_nf 1) z =
                  (deriv (g_nf 0) z + Complex.I * deriv (g_nf 1) z) -
                  (deriv (g_nf 0) z - Complex.I * deriv (g_nf 1) z) := by ring
              _ = Complex.I * (C.c : ℂ) * (Complex.cos (ϕ₀ z) + Complex.sin (ϕ₀ z) * Complex.I) /
                    (Z₀.f_mero z) ^ 2 -
                  (-Complex.I * (C.c : ℂ) * (Complex.cos (ϕ₀ z) - Complex.sin (ϕ₀ z) * Complex.I) /
                    (Z₀.f_mero z) ^ 2) := by rw [hdZ, hdW']
              _ = (2 * Complex.I) * ((C.c : ℂ) * Complex.cos (ϕ₀ z) / (Z₀.f_mero z) ^ 2) := by ring
          exact mul_left_cancel₀ h2I hdiff
      let H₀_sup : ℂ → ℂ := fun z =>
        g_nf 0 z * Complex.cos (ϕ₀ z) + g_nf 1 z * Complex.sin (ϕ₀ z)
      let T₀_sup : ℂ → ℂ := fun z =>
        -g_nf 0 z * Complex.sin (ϕ₀ z) + g_nf 1 z * Complex.cos (ϕ₀ z)
      have hH₀_zero : ∀ z ∈ B₀, H₀_sup z = 0 := by
        intro z hz
        obtain ⟨hd0, hd1⟩ := hg_deriv_B₀ z hz
        have hf_nz : f_mero z ≠ 0 := (hreg z (hB₀_sub_reg hz)).2.2.2.2.2.1
        have hcf_ne : (C.c : ℂ) / (f_mero z) ^ 2 ≠ 0 :=
          div_ne_zero hc_ne (pow_ne_zero 2 hf_nz)
        have hWeq : W_sup z = ((C.c : ℂ) / (f_mero z) ^ 2) * H₀_sup z := by
          dsimp [W_sup, H₀_sup]; rw [hd0, hd1]; ring
        rw [hW_zero_B₀ z hz] at hWeq
        exact (mul_eq_zero.mp hWeq.symm).resolve_left hcf_ne
      have hT₀_zero : ∀ z ∈ B₀, T₀_sup z = 0 := by
        intro z hz
        obtain ⟨hd0, hd1⟩ := hg_deriv_B₀ z hz
        have hg0_hd := (hreg z (hB₀_sub_reg hz)).1.differentiableAt.hasDerivAt
        have hg1_hd := (hreg z (hB₀_sub_reg hz)).2.1.differentiableAt.hasDerivAt
        have hc_hd := (Complex.hasDerivAt_cos (ϕ₀ z)).comp z (hϕ₀_hd z hz)
        have hs_hd := (Complex.hasDerivAt_sin (ϕ₀ z)).comp z (hϕ₀_hd z hz)
        have hH_hd : HasDerivAt H₀_sup (f_mero z * T₀_sup z) z := by
          refine ((hg0_hd.mul hc_hd).add (hg1_hd.mul hs_hd)).congr_deriv ?_
          dsimp [T₀_sup]; rw [hd0, hd1]; ring
        have hev : H₀_sup =ᶠ[nhds z] fun _ => (0 : ℂ) :=
          Filter.eventually_of_mem (Metric.isOpen_ball.mem_nhds hz) hH₀_zero
        have h0 : f_mero z * T₀_sup z = 0 := by
          rw [← hH_hd.deriv, hev.deriv_eq, deriv_const]
        exact (mul_eq_zero.mp h0).resolve_left (hreg z (hB₀_sub_reg hz)).2.2.2.2.2.1
      obtain ⟨hd0_s, hd1_s⟩ := hg_deriv_B₀ s₀ hs₀_B₀
      have hg0_hd := (hreg s₀ hs₀_B_reg).1.differentiableAt.hasDerivAt
      have hg1_hd := (hreg s₀ hs₀_B_reg).2.1.differentiableAt.hasDerivAt
      have hc_hd := (Complex.hasDerivAt_cos (ϕ₀ s₀)).comp s₀ (hϕ₀_hd s₀ hs₀_B₀)
      have hs_hd := (Complex.hasDerivAt_sin (ϕ₀ s₀)).comp s₀ (hϕ₀_hd s₀ hs₀_B₀)
      have hT_hd : HasDerivAt T₀_sup ((C.c : ℂ) / (f_mero s₀) ^ 2) s₀ := by
        refine (((hg0_hd.neg).mul hs_hd).add (hg1_hd.mul hc_hd)).congr_deriv ?_
        have hHz := hH₀_zero s₀ hs₀_B₀
        dsimp [H₀_sup] at hHz
        dsimp only [Function.comp, Pi.neg_apply]
        rw [hd0_s, hd1_s]
        linear_combination
          ((C.c : ℂ) / (f_mero s₀) ^ 2) * Complex.sin_sq_add_cos_sq (ϕ₀ s₀) -
            f_mero s₀ * hHz
      have hevT : T₀_sup =ᶠ[nhds s₀] fun _ => (0 : ℂ) :=
        Filter.eventually_of_mem (Metric.isOpen_ball.mem_nhds hs₀_B₀) hT₀_zero
      have hcf_zero : (C.c : ℂ) / (f_mero s₀) ^ 2 = 0 := by
        rw [← hT_hd.deriv, hevT.deriv_eq, deriv_const]
      exact div_ne_zero hc_ne (pow_ne_zero 2 (hreg s₀ hs₀_B_reg).2.2.2.2.2.1) hcf_zero

    have ha_ord_star : meromorphicOrderAt a_g s_star ≠ ⊤ :=
      ha_mero.meromorphicOrderAt_ne_top_of_isPreconnected hB_plus_pre
        hs₀_B_plus hs_star_mem ha_ord_s₀
    have hf_ord_star : meromorphicOrderAt f_g s_star ≠ ⊤ :=
      hf_mero.meromorphicOrderAt_ne_top_of_isPreconnected hB_plus_pre
        hs₀_B_plus hs_star_mem hf_ord_s₀
    have hWsup_ord_star : meromorphicOrderAt W_sup s_star ≠ ⊤ :=
      hWsup_mero.meromorphicOrderAt_ne_top_of_isPreconnected hB_plus_pre
        hs₀_B_plus hs_star_mem hWsup_ord_s₀
    have hRW_ord_all : ∀ z ∈ B_plus, meromorphicOrderAt R_W z = ⊤ := by
      intro z hz
      by_contra hne
      exact hRW_mero.meromorphicOrderAt_ne_top_of_isPreconnected hB_plus_pre
        hz hs₀_B_plus hne hRW_ord_s₀
    have hRa_ord_all : ∀ z ∈ B_plus, meromorphicOrderAt R_a z = ⊤ := by
      intro z hz
      by_contra hne
      exact hRa_mero.meromorphicOrderAt_ne_top_of_isPreconnected hB_plus_pre
        hz hs₀_B_plus hne hRa_ord_s₀

    have hev_punc_all : ∀ᶠ z in nhdsWithin s_star {s_star}ᶜ,
        AnalyticAt ℂ (g_nf 0) z ∧ AnalyticAt ℂ (g_nf 1) z ∧
        AnalyticAt ℂ a_g z ∧ AnalyticAt ℂ f_g z ∧
        a_g z ≠ 0 ∧ f_g z ≠ 0 ∧ W_sup z ≠ 0 := by
      have h1 := (hg_nf_mero 0 s_star hs_star_mem).eventually_analyticAt
      have h2 := (hg_nf_mero 1 s_star hs_star_mem).eventually_analyticAt
      have h3 := (ha_mero s_star hs_star_mem).eventually_analyticAt
      have h4 := (hf_mero s_star hs_star_mem).eventually_analyticAt
      have h5 := (meromorphicOrderAt_ne_top_iff_eventually_ne_zero
        (ha_mero s_star hs_star_mem)).mp ha_ord_star
      have h6 := (meromorphicOrderAt_ne_top_iff_eventually_ne_zero
        (hf_mero s_star hs_star_mem)).mp hf_ord_star
      have h7 := (meromorphicOrderAt_ne_top_iff_eventually_ne_zero
        (hWsup_mero s_star hs_star_mem)).mp hWsup_ord_star
      filter_upwards [h1, h2, h3, h4, h5, h6, h7] with z hz1 hz2 hz3 hz4 hz5 hz6 hz7
      exact ⟨hz1, hz2, hz3, hz4, hz5, hz6, hz7⟩

    obtain ⟨r_p, hr_p_pos, hr_p_prop⟩ := Metric.mem_nhdsWithin_iff.mp hev_punc_all
    let r_punc : ℝ := min r_p (ε / 2)
    have hr_punc_pos : 0 < r_punc := lt_min hr_p_pos (half_pos hε)
    have hr_punc_le_rp : r_punc ≤ r_p := min_le_left _ _
    have hr_punc_le_eps : r_punc ≤ ε / 2 := min_le_right _ _

    let x_edge : ℝ := x_star + r_punc / 2
    let s_edge : ℂ := (x_edge : ℂ) + (H₀ : ℂ) * Complex.I
    have hs_edge_diff : s_edge - s_star = ((r_punc / 2 : ℝ) : ℂ) := by
      dsimp [s_edge, s_star, x_edge]; push_cast; ring
    have hs_edge_dist : dist s_edge s_star = r_punc / 2 := by
      rw [dist_eq_norm, hs_edge_diff, Complex.norm_real, Real.norm_of_nonneg (by linarith)]
    have hs_edge_lt_rp : s_edge ∈ Metric.ball s_star r_p := by
      rw [Metric.mem_ball]; linarith
    have hs_edge_ne_star : s_edge ≠ s_star := by
      intro heq
      rw [heq, dist_self] at hs_edge_dist
      linarith
    obtain ⟨hg0_an_e, hg1_an_e, ha_an_e, hf_an_e, ha_ne_e, hf_ne_e, hW_ne_e⟩ :=
      hr_p_prop ⟨hs_edge_lt_rp, hs_edge_ne_star⟩

    have hev_an_edge : ∀ᶠ z in nhds s_edge,
        AnalyticAt ℂ (g_nf 0) z ∧ AnalyticAt ℂ (g_nf 1) z ∧
        AnalyticAt ℂ a_g z ∧ AnalyticAt ℂ f_g z ∧
        a_g z ≠ 0 ∧ f_g z ≠ 0 := by
      filter_upwards [hg0_an_e.eventually_analyticAt, hg1_an_e.eventually_analyticAt,
        ha_an_e.eventually_analyticAt, hf_an_e.eventually_analyticAt,
        ha_an_e.continuousAt.eventually_ne ha_ne_e,
        hf_an_e.continuousAt.eventually_ne hf_ne_e] with z h1 h2 h3 h4 h5 h6
      exact ⟨h1, h2, h3, h4, h5, h6⟩

    obtain ⟨r_a, hr_a_pos, hr_a_prop⟩ := Metric.eventually_nhds_iff.mp hev_an_edge
    have hg0_holo_ra : DifferentiableOn ℂ (g_nf 0) (Metric.ball s_edge r_a) :=
      fun z hz => (hr_a_prop hz).1.differentiableAt.differentiableWithinAt
    have hg1_holo_ra : DifferentiableOn ℂ (g_nf 1) (Metric.ball s_edge r_a) :=
      fun z hz => (hr_a_prop hz).2.1.differentiableAt.differentiableWithinAt
    have hW_holo_ra : DifferentiableOn ℂ W_sup (Metric.ball s_edge r_a) :=
      (hg0_holo_ra.mul (hg1_holo_ra.deriv Metric.isOpen_ball)).sub
        (hg1_holo_ra.mul (hg0_holo_ra.deriv Metric.isOpen_ball))
    have hW_cont_e : ContinuousAt W_sup s_edge :=
      hW_holo_ra.continuousOn.continuousAt
        (Metric.isOpen_ball.mem_nhds (Metric.mem_ball_self hr_a_pos))
    obtain ⟨r_W, hr_W_pos, hr_W_ne⟩ :=
      Metric.eventually_nhds_iff.mp (hW_cont_e.eventually_ne hW_ne_e)

    let R_1 : ℝ := min r_a (min r_W (ε / 2))
    have hR_1_pos : 0 < R_1 := lt_min hr_a_pos (lt_min hr_W_pos (half_pos hε))
    have hR_1_le_ra : R_1 ≤ r_a := min_le_left _ _
    have hR_1_le_rW : R_1 ≤ r_W := le_trans (min_le_right _ _) (min_le_left _ _)
    have hR_1_le_eps : R_1 ≤ ε / 2 := le_trans (min_le_right _ _) (min_le_right _ _)

    let B_init : Set ℂ := Metric.ball s_edge R_1
    have hB_init_sub_ra : B_init ⊆ Metric.ball s_edge r_a := Metric.ball_subset_ball hR_1_le_ra
    have hB_init_sub_plus : B_init ⊆ B_plus := by
      intro z hz
      rw [Metric.mem_ball] at hz ⊢
      calc
        dist z s_star ≤ dist z s_edge + dist s_edge s_star := dist_triangle _ _ _
        _ < R_1 + r_punc / 2 := by rw [hs_edge_dist]; linarith
        _ ≤ ε / 2 + (ε / 2) / 2 := by linarith
        _ < ε := by linarith

    have hg0_holo_init : DifferentiableOn ℂ (g_nf 0) B_init := hg0_holo_ra.mono hB_init_sub_ra
    have hg1_holo_init : DifferentiableOn ℂ (g_nf 1) B_init := hg1_holo_ra.mono hB_init_sub_ra
    have ha_holo_init : DifferentiableOn ℂ a_g B_init :=
      fun z hz => (hr_a_prop (hB_init_sub_ra hz)).2.2.1.differentiableAt.differentiableWithinAt
    have hf_holo_init : DifferentiableOn ℂ f_g B_init :=
      fun z hz => (hr_a_prop (hB_init_sub_ra hz)).2.2.2.1.differentiableAt.differentiableWithinAt
    have ha_ne_init : ∀ z ∈ B_init, a_g z ≠ 0 :=
      fun z hz => (hr_a_prop (hB_init_sub_ra hz)).2.2.2.2.1
    have hf_ne_init : ∀ z ∈ B_init, f_g z ≠ 0 :=
      fun z hz => (hr_a_prop (hB_init_sub_ra hz)).2.2.2.2.2
    have hW_ne_init : ∀ z ∈ B_init, W_sup z ≠ 0 :=
      fun z hz => hr_W_ne (lt_of_lt_of_le hz hR_1_le_rW)

    have hiso_Z_init : ∀ z ∈ B_init,
        (deriv (g_nf 0) z + Complex.I * deriv (g_nf 1) z) * (f_g z) ^ 2 =
          Complex.I * (C.c : ℂ) * a_g z := by
      intro z _
      dsimp [a_g, dZ_g]
      field_simp [hIc_ne]

    have hRW_holo_init : DifferentiableOn ℂ R_W B_init := by
      have hdW_holo : DifferentiableOn ℂ dW_g B_init :=
        (hg0_holo_init.deriv Metric.isOpen_ball).sub
          ((differentiableOn_const Complex.I).mul (hg1_holo_init.deriv Metric.isOpen_ball))
      exact ((hdW_holo.mul ha_holo_init).mul (hf_holo_init.pow 2)).add
        (differentiableOn_const (Complex.I * (C.c : ℂ)))
    have hiso_W_init : ∀ z ∈ B_init,
        (deriv (g_nf 0) z - Complex.I * deriv (g_nf 1) z) * a_g z * (f_g z) ^ 2 =
          -Complex.I * (C.c : ℂ) := by
      intro z hz
      have hcont : ContinuousAt R_W z :=
        hRW_holo_init.continuousOn.continuousAt (Metric.isOpen_ball.mem_nhds hz)
      have hev0 : ∀ᶠ w in nhdsWithin z {z}ᶜ, R_W w = 0 :=
        meromorphicOrderAt_eq_top_iff.mp (hRW_ord_all z (hB_init_sub_plus hz))
      have hRW_z : R_W z = 0 :=
        tendsto_nhds_unique hcont.continuousWithinAt
          (tendsto_const_nhds.congr' (hev0.mono fun _ hw => hw.symm))
      dsimp [R_W, dW_g] at hRW_z
      linear_combination hRW_z

    have hRa_holo_init : DifferentiableOn ℂ R_a B_init :=
      (ha_holo_init.deriv Metric.isOpen_ball).sub
        (((differentiableOn_const Complex.I).mul hf_holo_init).mul ha_holo_init)
    have hderiv_a_init : ∀ z ∈ B_init, deriv a_g z = Complex.I * f_g z * a_g z := by
      intro z hz
      have hcont : ContinuousAt R_a z :=
        hRa_holo_init.continuousOn.continuousAt (Metric.isOpen_ball.mem_nhds hz)
      have hev0 : ∀ᶠ w in nhdsWithin z {z}ᶜ, R_a w = 0 :=
        meromorphicOrderAt_eq_top_iff.mp (hRa_ord_all z (hB_init_sub_plus hz))
      have hRa_z : R_a z = 0 :=
        tendsto_nhds_unique hcont.continuousWithinAt
          (tendsto_const_nhds.congr' (hev0.mono fun _ hw => hw.symm))
      dsimp [R_a] at hRa_z
      linear_combination hRa_z

    refine ⟨x_edge, R_1, a_g, f_g, hR_1_pos, hB_init_sub_plus,
      Fin.forall_fin_two.mpr ⟨hg0_holo_init, hg1_holo_init⟩,
      ha_holo_init, hf_holo_init, ha_ne_init, hf_ne_init, hW_ne_init,
      hiso_Z_init, hiso_W_init, hderiv_a_init⟩

  obtain ⟨x_edge, R_1, a_g, f_g, hR1, hB_init_sub_plus, hg_holo, ha_holo, hf_holo,
    ha_ne, hf_ne, hW_ne, hiso_Z, hiso_W, hderiv_a⟩ := h_part2

  
  
  
  have h_part3 :
      ∃ (R_0 : ℝ) (ϕ_loc : ℂ → ℂ) (U_θ : Set ℂ) (ϕ_inv h_loc τ_proj : ℂ → ℂ)
        (U_τ : Set ℂ) (τ_inv : ℂ → ℂ),
        0 < R_0 ∧ R_0 < W.s_base / 2 ∧ 2 * R_0 ≤ R_1 ∧
        DifferentiableOn ℂ ϕ_loc
          (Metric.ball ((x_edge : ℂ) + (H₀ : ℂ) * Complex.I) (2 * R_0)) ∧
        (∀ z ∈ Metric.ball ((x_edge : ℂ) + (H₀ : ℂ) * Complex.I) (2 * R_0),
          deriv ϕ_loc z ≠ 0) ∧
        IsOpen U_θ ∧
        Set.MapsTo ϕ_loc
          (Metric.ball ((x_edge : ℂ) + (H₀ : ℂ) * Complex.I) (2 * R_0)) U_θ ∧
        (∀ r : ℝ, 0 < r → r ≤ 2 * R_0 →
          IsOpen (ϕ_loc '' Metric.ball ((x_edge : ℂ) + (H₀ : ℂ) * Complex.I) r)) ∧
        DifferentiableOn ℂ ϕ_inv U_θ ∧
        (∀ z ∈ Metric.ball ((x_edge : ℂ) + (H₀ : ℂ) * Complex.I) (2 * R_0),
          ϕ_inv (ϕ_loc z) = z) ∧
        (∀ θ ∈ U_θ,
          ϕ_inv θ ∈ Metric.ball ((x_edge : ℂ) + (H₀ : ℂ) * Complex.I) (2 * R_0) ∧
          ϕ_loc (ϕ_inv θ) = θ) ∧
        DifferentiableOn ℂ h_loc U_θ ∧
        (∀ θ ∈ U_θ, h_loc θ ≠ 0) ∧
        (∀ z ∈ Metric.ball ((x_edge : ℂ) + (H₀ : ℂ) * Complex.I) (2 * R_0),
          g_nf 0 z = h_loc (ϕ_loc z) * Complex.cos (ϕ_loc z) -
            deriv h_loc (ϕ_loc z) * Complex.sin (ϕ_loc z) ∧
          g_nf 1 z = h_loc (ϕ_loc z) * Complex.sin (ϕ_loc z) +
            deriv h_loc (ϕ_loc z) * Complex.cos (ϕ_loc z)) ∧
        (∀ z ∈ Metric.ball ((x_edge : ℂ) + (H₀ : ℂ) * Complex.I) (2 * R_0),
          deriv (g_nf 0) z = -(C.c : ℂ) * Complex.sin (ϕ_loc z) / (deriv ϕ_loc z) ^ 2 ∧
          deriv (g_nf 1) z = (C.c : ℂ) * Complex.cos (ϕ_loc z) / (deriv ϕ_loc z) ^ 2) ∧
        (∀ z ∈ Metric.ball ((x_edge : ℂ) + (H₀ : ℂ) * Complex.I) (2 * R_0),
          (h_loc (ϕ_loc z) + deriv (deriv h_loc) (ϕ_loc z)) * (deriv ϕ_loc z) ^ 3 = (C.c : ℂ)) ∧
        (∀ z : ℂ,
          τ_proj z =
            -g_nf 0 z * Complex.sin (ϕ_loc ((x_edge : ℂ) + (H₀ : ℂ) * Complex.I)) +
              g_nf 1 z * Complex.cos (ϕ_loc ((x_edge : ℂ) + (H₀ : ℂ) * Complex.I))) ∧
        (∀ z ∈ Metric.ball ((x_edge : ℂ) + (H₀ : ℂ) * Complex.I) (2 * R_0),
          deriv τ_proj z ≠ 0) ∧
        IsOpen U_τ ∧
        Set.MapsTo τ_proj
          (Metric.ball ((x_edge : ℂ) + (H₀ : ℂ) * Complex.I) (2 * R_0)) U_τ ∧
        (∀ r : ℝ, 0 < r → r ≤ 2 * R_0 →
          IsOpen (τ_proj '' Metric.ball ((x_edge : ℂ) + (H₀ : ℂ) * Complex.I) r)) ∧
        DifferentiableOn ℂ τ_inv U_τ ∧
        (∀ z ∈ Metric.ball ((x_edge : ℂ) + (H₀ : ℂ) * Complex.I) (2 * R_0),
          τ_inv (τ_proj z) = z) ∧
        (∀ w ∈ U_τ,
          τ_inv w ∈ Metric.ball ((x_edge : ℂ) + (H₀ : ℂ) * Complex.I) (2 * R_0) ∧
          τ_proj (τ_inv w) = w) := by
    have hc : 0 < C.c := C.c_pos
    have hs_base : 0 < W.s_base := W.s_base_pos
    let s_edge : ℂ := (x_edge : ℂ) + (H₀ : ℂ) * Complex.I
    let B₁ : Set ℂ := Metric.ball s_edge R_1
    have hs_edge_B₁ : s_edge ∈ B₁ := Metric.mem_ball_self hR1
    have hc_ne : (C.c : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (ne_of_gt hc)

    obtain ⟨ϕ_raw, hϕ_raw⟩ := hf_holo.isExactOn_ball
    let ϕ_loc : ℂ → ℂ := fun z =>
      ϕ_raw z - ϕ_raw s_edge - Complex.I * Complex.log (a_g s_edge)
    have hϕ_hasDeriv : ∀ z ∈ B₁, HasDerivAt ϕ_loc (f_g z) z := by
      intro z hz
      exact ((hϕ_raw z hz).sub_const (ϕ_raw s_edge)).sub_const
        (Complex.I * Complex.log (a_g s_edge))
    have hϕ_holo_B₁ : DifferentiableOn ℂ ϕ_loc B₁ :=
      fun z hz => (hϕ_hasDeriv z hz).differentiableAt.differentiableWithinAt
    have hϕ_deriv_B₁ : ∀ z ∈ B₁, deriv ϕ_loc z = f_g z :=
      fun z hz => (hϕ_hasDeriv z hz).deriv

    let Q : ℂ → ℂ := fun z => a_g z * Complex.exp (-Complex.I * ϕ_loc z)
    have hQ_hasDeriv : ∀ z ∈ B₁, HasDerivAt Q 0 z := by
      intro z hz
      have ha_at : HasDerivAt a_g (Complex.I * f_g z * a_g z) z := by
        have h1 := (ha_holo.differentiableAt (Metric.isOpen_ball.mem_nhds hz)).hasDerivAt
        rwa [hderiv_a z hz] at h1
      have hexp_at : HasDerivAt (fun w => Complex.exp (-Complex.I * ϕ_loc w))
          (Complex.exp (-Complex.I * ϕ_loc z) * (-Complex.I * f_g z)) z :=
        (Complex.hasDerivAt_exp (-Complex.I * ϕ_loc z)).comp z
          ((hϕ_hasDeriv z hz).const_mul (-Complex.I))
      exact (ha_at.mul hexp_at).congr_deriv (by ring)
    have hQ_holo : DifferentiableOn ℂ Q B₁ :=
      fun z hz => (hQ_hasDeriv z hz).differentiableAt.differentiableWithinAt
    have hQ_deriv_zero : Set.EqOn (deriv Q) 0 B₁ :=
      fun z hz => (hQ_hasDeriv z hz).deriv
    have hQ_s_edge : Q s_edge = 1 := by
      have hlog_arg : -Complex.I * ϕ_loc s_edge = -Complex.log (a_g s_edge) := by
        dsimp [ϕ_loc]
        ring_nf
        simp [Complex.I_sq]
      dsimp [Q]
      rw [hlog_arg, Complex.exp_neg, Complex.exp_log (ha_ne s_edge hs_edge_B₁)]
      exact mul_inv_cancel₀ (ha_ne s_edge hs_edge_B₁)
    have ha_eq_exp : ∀ z ∈ B₁, a_g z = Complex.exp (Complex.I * ϕ_loc z) := by
      intro z hz
      have hQc : Q z = 1 := by
        rw [IsOpen.is_const_of_deriv_eq_zero Metric.isOpen_ball
          (convex_ball s_edge R_1).isPreconnected hQ_holo hQ_deriv_zero hz hs_edge_B₁,
          hQ_s_edge]
      dsimp [Q] at hQc
      calc
        a_g z = a_g z * Complex.exp (-Complex.I * ϕ_loc z) * Complex.exp (Complex.I * ϕ_loc z) := by
          rw [mul_assoc, ← Complex.exp_add]
          simp
        _ = Complex.exp (Complex.I * ϕ_loc z) := by rw [hQc, one_mul]

    have hg_hasDeriv : ∀ i : Fin 2, ∀ z ∈ B₁, HasDerivAt (g_nf i) (deriv (g_nf i) z) z :=
      fun i z hz => ((hg_holo i).differentiableAt (Metric.isOpen_ball.mem_nhds hz)).hasDerivAt
    have hg_deriv_B₁ : ∀ z ∈ B₁,
        deriv (g_nf 0) z = -(C.c : ℂ) * Complex.sin (ϕ_loc z) / (f_g z) ^ 2 ∧
        deriv (g_nf 1) z = (C.c : ℂ) * Complex.cos (ϕ_loc z) / (f_g z) ^ 2 := by
      intro z hz
      have hf2_ne : (f_g z) ^ 2 ≠ 0 := pow_ne_zero 2 (hf_ne z hz)
      have hexp_pos : Complex.exp (Complex.I * ϕ_loc z) =
          Complex.cos (ϕ_loc z) + Complex.sin (ϕ_loc z) * Complex.I := by
        rw [mul_comm, Complex.exp_mul_I]
      have hexp_neg : Complex.exp (-Complex.I * ϕ_loc z) =
          Complex.cos (ϕ_loc z) - Complex.sin (ϕ_loc z) * Complex.I := by
        have h1 : -Complex.I * ϕ_loc z = (-ϕ_loc z) * Complex.I := by ring
        rw [h1, Complex.exp_mul_I, Complex.cos_neg, Complex.sin_neg]
        ring
      have hZ := hiso_Z z hz
      rw [ha_eq_exp z hz] at hZ
      have hW := hiso_W z hz
      rw [ha_eq_exp z hz] at hW
      have hW' : (deriv (g_nf 0) z - Complex.I * deriv (g_nf 1) z) * (f_g z) ^ 2 =
          -Complex.I * (C.c : ℂ) * Complex.exp (-Complex.I * ϕ_loc z) := by
        calc
          (deriv (g_nf 0) z - Complex.I * deriv (g_nf 1) z) * (f_g z) ^ 2
            = (deriv (g_nf 0) z - Complex.I * deriv (g_nf 1) z) *
                Complex.exp (Complex.I * ϕ_loc z) * (f_g z) ^ 2 *
                Complex.exp (-Complex.I * ϕ_loc z) := by
              have he1 : Complex.exp (Complex.I * ϕ_loc z) * Complex.exp (-Complex.I * ϕ_loc z) = 1 := by
                rw [← Complex.exp_add]; simp
              calc
                (deriv (g_nf 0) z - Complex.I * deriv (g_nf 1) z) * (f_g z) ^ 2
                  = (deriv (g_nf 0) z - Complex.I * deriv (g_nf 1) z) * (f_g z) ^ 2 *
                      (Complex.exp (Complex.I * ϕ_loc z) * Complex.exp (-Complex.I * ϕ_loc z)) := by
                    rw [he1, mul_one]
                _ = _ := by ring
          _ = -Complex.I * (C.c : ℂ) * Complex.exp (-Complex.I * ϕ_loc z) := by rw [hW]
      rw [hexp_pos] at hZ
      rw [hexp_neg] at hW'
      have h0_eq : deriv (g_nf 0) z * (f_g z) ^ 2 = -(C.c : ℂ) * Complex.sin (ϕ_loc z) := by
        have hsum : 2 * (deriv (g_nf 0) z * (f_g z) ^ 2) =
            2 * (-(C.c : ℂ) * Complex.sin (ϕ_loc z)) := by
          calc
            2 * (deriv (g_nf 0) z * (f_g z) ^ 2)
              = (deriv (g_nf 0) z + Complex.I * deriv (g_nf 1) z) * (f_g z) ^ 2 +
                (deriv (g_nf 0) z - Complex.I * deriv (g_nf 1) z) * (f_g z) ^ 2 := by ring
            _ = Complex.I * (C.c : ℂ) * (Complex.cos (ϕ_loc z) + Complex.sin (ϕ_loc z) * Complex.I) +
                (-Complex.I * (C.c : ℂ) * (Complex.cos (ϕ_loc z) - Complex.sin (ϕ_loc z) * Complex.I)) := by
              rw [hZ, hW']
            _ = 2 * Complex.I ^ 2 * (C.c : ℂ) * Complex.sin (ϕ_loc z) := by ring
            _ = 2 * (-(C.c : ℂ) * Complex.sin (ϕ_loc z)) := by rw [Complex.I_sq]; ring
        exact mul_left_cancel₀ two_ne_zero hsum
      have h1_eq : deriv (g_nf 1) z * (f_g z) ^ 2 = (C.c : ℂ) * Complex.cos (ϕ_loc z) := by
        have h2I_ne : (2 : ℂ) * Complex.I ≠ 0 := mul_ne_zero two_ne_zero Complex.I_ne_zero
        have hdiff : (2 * Complex.I) * (deriv (g_nf 1) z * (f_g z) ^ 2) =
            (2 * Complex.I) * ((C.c : ℂ) * Complex.cos (ϕ_loc z)) := by
          calc
            (2 * Complex.I) * (deriv (g_nf 1) z * (f_g z) ^ 2)
              = (deriv (g_nf 0) z + Complex.I * deriv (g_nf 1) z) * (f_g z) ^ 2 -
                (deriv (g_nf 0) z - Complex.I * deriv (g_nf 1) z) * (f_g z) ^ 2 := by ring
            _ = Complex.I * (C.c : ℂ) * (Complex.cos (ϕ_loc z) + Complex.sin (ϕ_loc z) * Complex.I) -
                (-Complex.I * (C.c : ℂ) * (Complex.cos (ϕ_loc z) - Complex.sin (ϕ_loc z) * Complex.I)) := by
              rw [hZ, hW']
            _ = (2 * Complex.I) * ((C.c : ℂ) * Complex.cos (ϕ_loc z)) := by ring
        exact mul_left_cancel₀ h2I_ne hdiff
      exact ⟨eq_div_iff hf2_ne |>.mpr h0_eq, eq_div_iff hf2_ne |>.mpr h1_eq⟩

    let θ₀ : ℂ := ϕ_loc s_edge
    let τ_proj : ℂ → ℂ := fun z =>
      -g_nf 0 z * Complex.sin θ₀ + g_nf 1 z * Complex.cos θ₀
    have hτ_hasDeriv_B₁ : ∀ z ∈ B₁,
        HasDerivAt τ_proj
          (-deriv (g_nf 0) z * Complex.sin θ₀ + deriv (g_nf 1) z * Complex.cos θ₀) z := by
      intro z hz
      exact (((hg_hasDeriv 0 z hz).neg).mul_const (Complex.sin θ₀)).add
        ((hg_hasDeriv 1 z hz).mul_const (Complex.cos θ₀))
    have hτ_holo_B₁ : DifferentiableOn ℂ τ_proj B₁ :=
      fun z hz => (hτ_hasDeriv_B₁ z hz).differentiableAt.differentiableWithinAt
    have hτ_deriv_s_edge : deriv τ_proj s_edge ≠ 0 := by
      rw [(hτ_hasDeriv_B₁ s_edge hs_edge_B₁).deriv]
      obtain ⟨hd0, hd1⟩ := hg_deriv_B₁ s_edge hs_edge_B₁
      rw [hd0, hd1]
      have hcalc : -(-(C.c : ℂ) * Complex.sin θ₀ / (f_g s_edge) ^ 2) * Complex.sin θ₀ +
          (C.c : ℂ) * Complex.cos θ₀ / (f_g s_edge) ^ 2 * Complex.cos θ₀ =
          (C.c : ℂ) / (f_g s_edge) ^ 2 * (Complex.sin θ₀ ^ 2 + Complex.cos θ₀ ^ 2) := by
        dsimp [θ₀]; ring
      rw [hcalc, Complex.sin_sq_add_cos_sq, mul_one]
      exact div_ne_zero hc_ne (pow_ne_zero 2 (hf_ne s_edge hs_edge_B₁))
    have hτ_deriv_cont : ContinuousAt (deriv τ_proj) s_edge :=
      (hτ_holo_B₁.deriv Metric.isOpen_ball).continuousOn.continuousAt
        (Metric.isOpen_ball.mem_nhds hs_edge_B₁)
    obtain ⟨r_τ, hr_τ_pos, hr_τ_ne⟩ :=
      Metric.eventually_nhds_iff.mp (hτ_deriv_cont.eventually_ne hτ_deriv_s_edge)

    have hϕ_strict : HasStrictDerivAt ϕ_loc (deriv ϕ_loc s_edge) s_edge :=
      (hϕ_holo_B₁.analyticAt (Metric.isOpen_ball.mem_nhds hs_edge_B₁)).hasStrictDerivAt
    have hϕ_deriv_s_edge : deriv ϕ_loc s_edge ≠ 0 := by
      rw [hϕ_deriv_B₁ s_edge hs_edge_B₁]
      exact hf_ne s_edge hs_edge_B₁
    have hϕ_fderiv := hϕ_strict.hasStrictFDerivAt_equiv hϕ_deriv_s_edge
    let e_ϕ := HasStrictFDerivAt.toOpenPartialHomeomorph ϕ_loc hϕ_fderiv
    have he_ϕ_coe : (e_ϕ : ℂ → ℂ) = ϕ_loc :=
      HasStrictFDerivAt.toOpenPartialHomeomorph_coe hϕ_fderiv
    have hs_edge_e_ϕ : s_edge ∈ e_ϕ.source :=
      HasStrictFDerivAt.mem_toOpenPartialHomeomorph_source hϕ_fderiv
    obtain ⟨r_ϕ_src, hr_ϕ_src_pos, hr_ϕ_src_sub⟩ :=
      Metric.isOpen_iff.mp e_ϕ.open_source s_edge hs_edge_e_ϕ

    have hτ_strict : HasStrictDerivAt τ_proj (deriv τ_proj s_edge) s_edge :=
      (hτ_holo_B₁.analyticAt (Metric.isOpen_ball.mem_nhds hs_edge_B₁)).hasStrictDerivAt
    have hτ_fderiv := hτ_strict.hasStrictFDerivAt_equiv hτ_deriv_s_edge
    let e_τ := HasStrictFDerivAt.toOpenPartialHomeomorph τ_proj hτ_fderiv
    have he_τ_coe : (e_τ : ℂ → ℂ) = τ_proj :=
      HasStrictFDerivAt.toOpenPartialHomeomorph_coe hτ_fderiv
    have hs_edge_e_τ : s_edge ∈ e_τ.source :=
      HasStrictFDerivAt.mem_toOpenPartialHomeomorph_source hτ_fderiv
    obtain ⟨r_τ_src, hr_τ_src_pos, hr_τ_src_sub⟩ :=
      Metric.isOpen_iff.mp e_τ.open_source s_edge hs_edge_e_τ

    let R_min : ℝ := min R_1 (min r_τ (min r_ϕ_src (min r_τ_src W.s_base)))
    have hR_min_pos : 0 < R_min :=
      lt_min hR1 (lt_min hr_τ_pos (lt_min hr_ϕ_src_pos (lt_min hr_τ_src_pos hs_base)))
    let R_0 : ℝ := R_min / 4
    have hR_0_pos : 0 < R_0 := by dsimp [R_0]; linarith
    have hR_min_le_R1 : R_min ≤ R_1 := min_le_left _ _
    have hR_min_le_rτ : R_min ≤ r_τ := le_trans (min_le_right _ _) (min_le_left _ _)
    have hR_min_le_rϕ : R_min ≤ r_ϕ_src :=
      le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_left _ _))
    have hR_min_le_rτs : R_min ≤ r_τ_src :=
      le_trans (min_le_right _ _) (le_trans (min_le_right _ _)
        (le_trans (min_le_right _ _) (min_le_left _ _)))
    have hR_min_le_sb : R_min ≤ W.s_base :=
      le_trans (min_le_right _ _) (le_trans (min_le_right _ _)
        (le_trans (min_le_right _ _) (min_le_right _ _)))
    have hR_0_lt_sb : R_0 < W.s_base / 2 := by dsimp [R_0]; linarith
    have h2R_0_le_R1 : 2 * R_0 ≤ R_1 := by dsimp [R_0]; linarith
    have h2R_0_le_rτ : 2 * R_0 ≤ r_τ := by dsimp [R_0]; linarith
    have h2R_0_le_rϕ : 2 * R_0 ≤ r_ϕ_src := by dsimp [R_0]; linarith
    have h2R_0_le_rτs : 2 * R_0 ≤ r_τ_src := by dsimp [R_0]; linarith

    let B₂ : Set ℂ := Metric.ball s_edge (2 * R_0)
    have hB₂_sub_B₁ : B₂ ⊆ B₁ := Metric.ball_subset_ball h2R_0_le_R1
    have hB₂_sub_eϕ : B₂ ⊆ e_ϕ.source :=
      Set.Subset.trans (Metric.ball_subset_ball h2R_0_le_rϕ) hr_ϕ_src_sub
    have hB₂_sub_eτ : B₂ ⊆ e_τ.source :=
      Set.Subset.trans (Metric.ball_subset_ball h2R_0_le_rτs) hr_τ_src_sub

    let U_θ : Set ℂ := ϕ_loc '' B₂
    let ϕ_inv : ℂ → ℂ := e_ϕ.symm
    let U_τ : Set ℂ := τ_proj '' B₂
    let τ_inv : ℂ → ℂ := e_τ.symm

    have hU_θ_open : IsOpen U_θ := by
      dsimp [U_θ]; rw [← he_ϕ_coe]
      exact e_ϕ.isOpen_image_of_subset_source Metric.isOpen_ball hB₂_sub_eϕ
    have hϕ_open_img : ∀ r : ℝ, 0 < r → r ≤ 2 * R_0 →
        IsOpen (ϕ_loc '' Metric.ball s_edge r) := by
      intro r _ hr_le
      rw [← he_ϕ_coe]
      exact e_ϕ.isOpen_image_of_subset_source Metric.isOpen_ball
        (Set.Subset.trans (Metric.ball_subset_ball hr_le) hB₂_sub_eϕ)
    have hϕ_left_inv : ∀ z ∈ B₂, ϕ_inv (ϕ_loc z) = z := by
      intro z hz
      dsimp [ϕ_inv]
      rw [← he_ϕ_coe]
      exact e_ϕ.left_inv (hB₂_sub_eϕ hz)
    have hϕ_right_inv : ∀ θ ∈ U_θ, ϕ_inv θ ∈ B₂ ∧ ϕ_loc (ϕ_inv θ) = θ := by
      rintro θ ⟨z, hz, rfl⟩
      rw [hϕ_left_inv z hz]
      exact ⟨hz, rfl⟩
    have hϕ_inv_hasDeriv : ∀ θ ∈ U_θ,
        HasDerivAt ϕ_inv (f_g (ϕ_inv θ))⁻¹ θ := by
      rintro θ ⟨z, hz, rfl⟩
      have hz_B₁ : z ∈ B₁ := hB₂_sub_B₁ hz
      have hz_src : z ∈ e_ϕ.source := hB₂_sub_eϕ hz
      have hθ_tgt : e_ϕ z ∈ e_ϕ.target := e_ϕ.map_source hz_src
      rw [he_ϕ_coe] at hθ_tgt
      have hsymm_z : e_ϕ.symm (ϕ_loc z) = z := hϕ_left_inv z hz
      have hd_at : HasDerivAt (e_ϕ : ℂ → ℂ) (f_g z) (e_ϕ.symm (ϕ_loc z)) := by
        rw [he_ϕ_coe, hsymm_z]
        exact hϕ_hasDeriv z hz_B₁
      have hinv_d := e_ϕ.hasDerivAt_symm hθ_tgt (hf_ne z hz_B₁) hd_at
      dsimp [ϕ_inv]
      rwa [hsymm_z]
    have hϕ_inv_holo : DifferentiableOn ℂ ϕ_inv U_θ :=
      fun θ hθ => (hϕ_inv_hasDeriv θ hθ).differentiableAt.differentiableWithinAt

    have hτ_deriv_ne_B₂ : ∀ z ∈ B₂, deriv τ_proj z ≠ 0 := by
      intro z hz
      exact hr_τ_ne (Metric.ball_subset_ball h2R_0_le_rτ hz)
    have hU_τ_open : IsOpen U_τ := by
      dsimp [U_τ]; rw [← he_τ_coe]
      exact e_τ.isOpen_image_of_subset_source Metric.isOpen_ball hB₂_sub_eτ
    have hτ_open_img : ∀ r : ℝ, 0 < r → r ≤ 2 * R_0 →
        IsOpen (τ_proj '' Metric.ball s_edge r) := by
      intro r _ hr_le
      rw [← he_τ_coe]
      exact e_τ.isOpen_image_of_subset_source Metric.isOpen_ball
        (Set.Subset.trans (Metric.ball_subset_ball hr_le) hB₂_sub_eτ)
    have hτ_left_inv : ∀ z ∈ B₂, τ_inv (τ_proj z) = z := by
      intro z hz
      dsimp [τ_inv]
      rw [← he_τ_coe]
      exact e_τ.left_inv (hB₂_sub_eτ hz)
    have hτ_right_inv : ∀ w ∈ U_τ, τ_inv w ∈ B₂ ∧ τ_proj (τ_inv w) = w := by
      rintro w ⟨z, hz, rfl⟩
      rw [hτ_left_inv z hz]
      exact ⟨hz, rfl⟩
    have hτ_inv_holo : DifferentiableOn ℂ τ_inv U_τ := by
      rintro w ⟨z, hz, rfl⟩
      have hz_B₁ : z ∈ B₁ := hB₂_sub_B₁ hz
      have hz_src : z ∈ e_τ.source := hB₂_sub_eτ hz
      have hw_tgt : e_τ z ∈ e_τ.target := e_τ.map_source hz_src
      rw [he_τ_coe] at hw_tgt
      have hsymm_z : e_τ.symm (τ_proj z) = z := hτ_left_inv z hz
      have hd_at : HasDerivAt (e_τ : ℂ → ℂ) (deriv τ_proj z) (e_τ.symm (τ_proj z)) := by
        rw [he_τ_coe, hsymm_z]
        exact (hτ_holo_B₁.differentiableAt (Metric.isOpen_ball.mem_nhds hz_B₁)).hasDerivAt
      exact (e_τ.hasDerivAt_symm hw_tgt (hτ_deriv_ne_B₂ z hz) hd_at).differentiableAt.differentiableWithinAt

    let H_sup : ℂ → ℂ := fun z =>
      g_nf 0 z * Complex.cos (ϕ_loc z) + g_nf 1 z * Complex.sin (ϕ_loc z)
    let T_sup : ℂ → ℂ := fun z =>
      -g_nf 0 z * Complex.sin (ϕ_loc z) + g_nf 1 z * Complex.cos (ϕ_loc z)
    let h_loc : ℂ → ℂ := fun θ => H_sup (ϕ_inv θ)

    have hH_hasDeriv : ∀ z ∈ B₁, HasDerivAt H_sup (f_g z * T_sup z) z := by
      intro z hz
      obtain ⟨hd0, hd1⟩ := hg_deriv_B₁ z hz
      have hc_at := (Complex.hasDerivAt_cos (ϕ_loc z)).comp z (hϕ_hasDeriv z hz)
      have hs_at := (Complex.hasDerivAt_sin (ϕ_loc z)).comp z (hϕ_hasDeriv z hz)
      refine (((hg_hasDeriv 0 z hz).mul hc_at).add ((hg_hasDeriv 1 z hz).mul hs_at)).congr_deriv ?_
      dsimp [T_sup]
      rw [hd0, hd1]
      ring
    have hT_hasDeriv : ∀ z ∈ B₁,
        HasDerivAt T_sup ((C.c : ℂ) / (f_g z) ^ 2 - f_g z * H_sup z) z := by
      intro z hz
      obtain ⟨hd0, hd1⟩ := hg_deriv_B₁ z hz
      have hc_at := (Complex.hasDerivAt_cos (ϕ_loc z)).comp z (hϕ_hasDeriv z hz)
      have hs_at := (Complex.hasDerivAt_sin (ϕ_loc z)).comp z (hϕ_hasDeriv z hz)
      refine ((((hg_hasDeriv 0 z hz).neg).mul hs_at).add
        ((hg_hasDeriv 1 z hz).mul hc_at)).congr_deriv ?_
      dsimp [H_sup]
      rw [hd0, hd1]
      linear_combination ((C.c : ℂ) / (f_g z) ^ 2) * Complex.sin_sq_add_cos_sq (ϕ_loc z)

    have hH_ne_B₁ : ∀ z ∈ B₁, H_sup z ≠ 0 := by
      intro z hz hHz
      obtain ⟨hd0, hd1⟩ := hg_deriv_B₁ z hz
      have hW : g_nf 0 z * deriv (g_nf 1) z - g_nf 1 z * deriv (g_nf 0) z =
          ((C.c : ℂ) / (f_g z) ^ 2) * H_sup z := by
        dsimp [H_sup]
        rw [hd0, hd1]
        ring
      rw [hHz, mul_zero] at hW
      exact hW_ne z hz hW

    have hh_loc_hasDeriv : ∀ θ ∈ U_θ, HasDerivAt h_loc (T_sup (ϕ_inv θ)) θ := by
      intro θ hθ
      have hz_B₂ : ϕ_inv θ ∈ B₂ := (hϕ_right_inv θ hθ).1
      have hz_B₁ : ϕ_inv θ ∈ B₁ := hB₂_sub_B₁ hz_B₂
      refine ((hH_hasDeriv (ϕ_inv θ) hz_B₁).comp θ (hϕ_inv_hasDeriv θ hθ)).congr_deriv ?_
      have hne := hf_ne (ϕ_inv θ) hz_B₁
      field_simp [hne]

    have hh_loc_holo : DifferentiableOn ℂ h_loc U_θ :=
      fun θ hθ => (hh_loc_hasDeriv θ hθ).differentiableAt.differentiableWithinAt
    have hh_loc_ne : ∀ θ ∈ U_θ, h_loc θ ≠ 0 :=
      fun θ hθ => hH_ne_B₁ (ϕ_inv θ) (hB₂_sub_B₁ (hϕ_right_inv θ hθ).1)
    have hh_loc_deriv_eq : ∀ θ ∈ U_θ, deriv h_loc θ = T_sup (ϕ_inv θ) :=
      fun θ hθ => (hh_loc_hasDeriv θ hθ).deriv

    have hg_support_eq : ∀ z ∈ B₂,
        g_nf 0 z = h_loc (ϕ_loc z) * Complex.cos (ϕ_loc z) -
          deriv h_loc (ϕ_loc z) * Complex.sin (ϕ_loc z) ∧
        g_nf 1 z = h_loc (ϕ_loc z) * Complex.sin (ϕ_loc z) +
          deriv h_loc (ϕ_loc z) * Complex.cos (ϕ_loc z) := by
      intro z hz
      have hθ : ϕ_loc z ∈ U_θ := ⟨z, hz, rfl⟩
      have hl : h_loc (ϕ_loc z) = H_sup z := by
        dsimp [h_loc]; rw [hϕ_left_inv z hz]
      have hd : deriv h_loc (ϕ_loc z) = T_sup z := by
        rw [hh_loc_deriv_eq (ϕ_loc z) hθ, hϕ_left_inv z hz]
      rw [hl, hd]
      dsimp [H_sup, T_sup]
      constructor
      · linear_combination -(g_nf 0 z) * Complex.cos_sq_add_sin_sq (ϕ_loc z)
      · linear_combination -(g_nf 1 z) * Complex.sin_sq_add_cos_sq (ϕ_loc z)

    have hlazutkin : ∀ z ∈ B₂,
        (h_loc (ϕ_loc z) + deriv (deriv h_loc) (ϕ_loc z)) * (deriv ϕ_loc z) ^ 3 = (C.c : ℂ) := by
      intro z hz
      have hz_B₁ : z ∈ B₁ := hB₂_sub_B₁ hz
      have hθ : ϕ_loc z ∈ U_θ := ⟨z, hz, rfl⟩
      have hl : h_loc (ϕ_loc z) = H_sup z := by
        dsimp [h_loc]; rw [hϕ_left_inv z hz]
      have hev : deriv h_loc =ᶠ[nhds (ϕ_loc z)] fun θ => T_sup (ϕ_inv θ) :=
        Filter.eventually_of_mem (hU_θ_open.mem_nhds hθ) hh_loc_deriv_eq
      have hd2_comp : HasDerivAt (fun θ => T_sup (ϕ_inv θ))
          (((C.c : ℂ) / (f_g z) ^ 2 - f_g z * H_sup z) * (f_g z)⁻¹) (ϕ_loc z) := by
        have h1 := (hT_hasDeriv (ϕ_inv (ϕ_loc z)) (by rw [hϕ_left_inv z hz]; exact hz_B₁)).comp
          (ϕ_loc z) (hϕ_inv_hasDeriv (ϕ_loc z) hθ)
        rwa [hϕ_left_inv z hz] at h1
      have hd2 : deriv (deriv h_loc) (ϕ_loc z) =
          ((C.c : ℂ) / (f_g z) ^ 2 - f_g z * H_sup z) * (f_g z)⁻¹ := by
        rw [hev.deriv_eq, hd2_comp.deriv]
      rw [hl, hd2, hϕ_deriv_B₁ z hz_B₁]
      have hf_z_ne : f_g z ≠ 0 := hf_ne z hz_B₁
      field_simp [hf_z_ne]
      ring

    refine ⟨R_0, ϕ_loc, U_θ, ϕ_inv, h_loc, τ_proj, U_τ, τ_inv,
      hR_0_pos, hR_0_lt_sb, h2R_0_le_R1,
      hϕ_holo_B₁.mono hB₂_sub_B₁,
      fun z hz => by rw [hϕ_deriv_B₁ z (hB₂_sub_B₁ hz)]; exact hf_ne z (hB₂_sub_B₁ hz),
      hU_θ_open,
      fun z hz => ⟨z, hz, rfl⟩,
      hϕ_open_img,
      hϕ_inv_holo,
      hϕ_left_inv,
      hϕ_right_inv,
      hh_loc_holo,
      hh_loc_ne,
      hg_support_eq,
      fun z hz => by
        rw [hϕ_deriv_B₁ z (hB₂_sub_B₁ hz)]
        exact hg_deriv_B₁ z (hB₂_sub_B₁ hz),
      hlazutkin,
      fun _ => rfl,
      hτ_deriv_ne_B₂,
      hU_τ_open,
      fun z hz => ⟨z, hz, rfl⟩,
      hτ_open_img,
      hτ_inv_holo,
      hτ_left_inv,
      hτ_right_inv⟩

  obtain ⟨R_0, ϕ_loc, U_θ, ϕ_inv, h_loc, τ_proj, U_τ, τ_inv,
    hR_0_pos, hR_0_lt_sb, h2R_0_le_R1,
    hϕ_loc_holo, hϕ_deriv_ne_zero, hU_θ_open, hϕ_maps_to, hϕ_open_image,
    hϕ_inv_holo, hϕ_left_inv, hϕ_right_inv,
    hh_loc_holo, hh_loc_ne_zero, hg_nf_support_eq, hg_nf_deriv_eq, hlazutkin_ode,
    hτ_def, hτ_deriv_ne_zero, hU_τ_open, hτ_maps_to, hτ_open_image,
    hτ_inv_holo, hτ_left_inv, hτ_right_inv⟩ := h_part3

  have hB₂_sub_R1 :
      Metric.ball ((x_edge : ℂ) + (H₀ : ℂ) * Complex.I) (2 * R_0) ⊆
        Metric.ball ((x_edge : ℂ) + (H₀ : ℂ) * Complex.I) R_1 :=
    Metric.ball_subset_ball h2R_0_le_R1

  exact ⟨{
    x_edge := x_edge
    R_0 := R_0
    H₀_ge := hH₀_ge
    R_0_pos := hR_0_pos
    R_0_lt := hR_0_lt_sb
    g_nf := g_nf
    ϕ_loc := ϕ_loc
    U_θ := U_θ
    ϕ_inv := ϕ_inv
    h_loc := h_loc
    τ_proj := τ_proj
    U_τ := U_τ
    τ_inv := τ_inv
    g_nf_holo := fun i => (hg_holo i).mono hB₂_sub_R1
    g_nf_eq_slice := fun i z hz =>
      hg_nf_eq_slice i z ⟨hB_init_sub_plus (hB₂_sub_R1 hz.1), hz.2⟩
    ϕ_loc_holo := hϕ_loc_holo
    ϕ_deriv_ne_zero := hϕ_deriv_ne_zero
    U_θ_open := hU_θ_open
    ϕ_maps_to := hϕ_maps_to
    ϕ_open_image := hϕ_open_image
    ϕ_inv_holo := hϕ_inv_holo
    ϕ_left_inv := hϕ_left_inv
    ϕ_right_inv := hϕ_right_inv
    h_loc_holo := hh_loc_holo
    h_loc_ne_zero := hh_loc_ne_zero
    g_nf_support_eq := hg_nf_support_eq
    g_nf_deriv_eq := hg_nf_deriv_eq
    lazutkin_ode := hlazutkin_ode
    τ_def := hτ_def
    τ_deriv_ne_zero := hτ_deriv_ne_zero
    U_τ_open := hU_τ_open
    τ_maps_to := hτ_maps_to
    τ_open_image := hτ_open_image
    τ_inv_holo := hτ_inv_holo
    τ_left_inv := hτ_left_inv
    τ_right_inv := hτ_right_inv
  }⟩

theorem cubic_step_successor_and_dual_line (Ω : Set Plane)
    (C : AnalyticGlancingCollar Ω)
    (B_cramer : BaseCollarAndCramerData C)
    (s_edge : ℂ)
    (R_0 : ℝ)
    (hR0 : 0 < R_0)
    (ϕ_loc h_loc : ℂ → ℂ)
    (U_θ : Set ℂ)
    (hUθ_open : IsOpen U_θ)
    (hϕ_holo : DifferentiableOn ℂ ϕ_loc (Metric.ball s_edge (2 * R_0)))
    (hϕ_deriv_ne : ∀ z ∈ Metric.ball s_edge (2 * R_0), deriv ϕ_loc z ≠ 0)
    (hϕ_maps : Set.MapsTo ϕ_loc (Metric.ball s_edge (2 * R_0)) U_θ)
    (hh_holo : DifferentiableOn ℂ h_loc U_θ)
    (hh_ne : ∀ θ ∈ U_θ, h_loc θ ≠ 0)
    (hlaz : ∀ z ∈ Metric.ball s_edge (2 * R_0),
      (h_loc (ϕ_loc z) + deriv (deriv h_loc) (ϕ_loc z)) * (deriv ϕ_loc z) ^ 3 = (C.c : ℂ)) :
    Nonempty (CubicStepSuccessorData C.c s_edge R_0 ϕ_loc h_loc) :=
by
  classical
  let _ := hϕ_deriv_ne
  have hc_pos : 0 < C.c := C.c_pos
  have hc_ne : (C.c : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (ne_of_gt hc_pos)
  let B_2 : Set ℂ := Metric.ball s_edge (2 * R_0)
  let B_32 : Set ℂ := Metric.ball s_edge ((3 / 2 : ℝ) * R_0)
  let B_1 : Set ℂ := Metric.ball s_edge R_0
  have hB1_sub_B32 : B_1 ⊆ B_32 := Metric.ball_subset_ball (by linarith)
  have hB32_sub_B2 : B_32 ⊆ B_2 := Metric.ball_subset_ball (by linarith)
  have hB1_sub_B2 : B_1 ⊆ B_2 := hB1_sub_B32.trans hB32_sub_B2
  let f : ℂ → ℂ := deriv ϕ_loc
  have hf_holo : DifferentiableOn ℂ f B_2 := hϕ_holo.deriv Metric.isOpen_ball
  have hf'_holo : DifferentiableOn ℂ (deriv f) B_2 := hf_holo.deriv Metric.isOpen_ball
  have hh'_holo : DifferentiableOn ℂ (deriv h_loc) U_θ := hh_holo.deriv hUθ_open
  have hh''_holo : DifferentiableOn ℂ (deriv (deriv h_loc)) U_θ := hh'_holo.deriv hUθ_open
  let r_loc : ℂ → ℂ := fun θ => h_loc θ + deriv (deriv h_loc) θ
  have hr_holo : DifferentiableOn ℂ r_loc U_θ := by exact hh_holo.add hh''_holo
  
  let p1 : (ℂ × ℂ) →L[ℂ] ℂ :=
    @ContinuousLinearMap.mk ℂ ℂ _ _ (RingHom.id ℂ) (ℂ × ℂ) _ _ ℂ _ _
      NormedSpace.toModule NormedSpace.toModule
      { toFun := Prod.fst, map_add' := fun _ _ => rfl, map_smul' := fun _ _ => rfl }
      continuous_fst
  let p2 : (ℂ × ℂ) →L[ℂ] ℂ :=
    @ContinuousLinearMap.mk ℂ ℂ _ _ (RingHom.id ℂ) (ℂ × ℂ) _ _ ℂ _ _
      NormedSpace.toModule NormedSpace.toModule
      { toFun := Prod.snd, map_add' := fun _ _ => rfl, map_smul' := fun _ _ => rfl }
      continuous_snd
  have h_partials : ∀ {W : Set (ℂ × ℂ)}, IsOpen W → ∀ {g : ℂ × ℂ → ℂ},
      DifferentiableOn ℂ g W →
      DifferentiableOn ℂ (fun p : ℂ × ℂ => deriv (fun z => g (z, p.2)) p.1) W ∧
      DifferentiableOn ℂ (fun p : ℂ × ℂ => deriv (fun z => g (p.1, z)) p.2) W := by
    intro W hW g hg
    exact ⟨B_cramer.iterDerivYT_holo hW hg 1 0, B_cramer.iterDerivYT_holo hW hg 0 1⟩
  have h_fderiv_partials : ∀ {W : Set (ℂ × ℂ)}, IsOpen W → ∀ {G : ℂ × ℂ → ℂ},
      DifferentiableOn ℂ G W → ∀ {q : ℂ × ℂ}, q ∈ W →
      HasFDerivAt G
        (p1.smulRight (deriv (fun z : ℂ => G (z, q.2)) q.1) +
          p2.smulRight (deriv (fun z : ℂ => G (q.1, z)) q.2)) q := by
    intro W hW G hG q hq
    have hf_at : HasFDerivAt G (fderiv ℂ G q) q :=
      (hG.differentiableAt (hW.mem_nhds hq)).hasFDerivAt
