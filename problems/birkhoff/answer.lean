          have h2 : 2 * (Nat.floor x : ℝ) / (N : ℝ) ≤ u + 1 :=
            (div_le_iff₀ hN_pos_real).mpr h1
          change -1 + 2 * (Nat.floor x : ℝ) / (N : ℝ) ≤ u
          linarith
        · have hfl : x < (Nat.floor x : ℝ) + 1 := Nat.lt_floor_add_one x
          have h1 : (u + 1) * (N : ℝ) ≤ 2 * ((Nat.floor x : ℝ) + 1) := by
            dsimp [x] at hfl; linarith
          have h2 : u + 1 ≤ 2 * ((Nat.floor x : ℝ) + 1) / (N : ℝ) :=
            (le_div_iff₀ hN_pos_real).mpr h1
          change u ≤ -1 + 2 * ((Nat.floor x : ℝ) + 1) / (N : ℝ)
