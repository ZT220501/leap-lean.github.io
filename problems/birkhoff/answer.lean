          paJetT2D1D p₁ (fun q => P q - Q q) = paJetT2D1D p₁ P - paJetT2D1D p₁ Q := by
        rintro P Q ⟨hP⟩ ⟨hQ⟩
        refine hExt2D1D fun d n => ?_
        rw [hT_coeff, map_sub, map_sub, hT_coeff, hT_coeff]
        simp only [map_sub]
        rw [(hLC.taylor2D_ring hV hp₁ (hP n) (hQ n)).2.1, map_sub]
      have hTay2D_sum : ∀ {ι : Type} (s : Finset ι) (f : ι → ℂ × ℂ → ℂ),
