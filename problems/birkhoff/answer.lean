        by_contra hlt
        have hD₀_eq : p_alg.natDegree = 0 := by omega
        rw [Polynomial.eq_C_of_natDegree_eq_zero hD₀_eq] at hp_aeval hp_ne
        have hc0_ne : p_alg.coeff 0 ≠ 0 := fun h => hp_ne (by simp [h])
        simp only [Polynomial.aeval_C] at hp_aeval
        exact hc0_ne (K_pt.subtype.injective (by simpa using hp_aeval))
      have hcoeff_frac : ∀ d : Fin (D₀ + 1),
