      have h0' : A.comp (Polynomial.X + Polynomial.C 1) = 0 := by simpa using h0
      have h1 := congrArg (fun B => B.comp (Polynomial.X - Polynomial.C 1)) h0'
      simp only [h_comp_shift_inv, Polynomial.zero_comp] at h1
      exact hA h1
    have h_rm_shift_le : ∀ (A : Polynomial ℂ) (c z : ℂ), A ≠ 0 →
