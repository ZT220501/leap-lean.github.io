          hG_cl_mono (by linarith)
        linarith
      have hcl_diff_nonneg : 0 ≤ G_cl (v + L_K) - G_cl (v - L_K) := by
        have := hG_cl_mono (by linarith : v - L_K ≤ v + L_K)
        linarith
      rcases lt_or_ge (μ_f v) (v ^ (1 / 4 : ℝ)) with hlow | hhigh
      · have hμ_nn : 0 ≤ μ_f v := (hF_le_Full v hv_ge_k₀).1
        have hv_sq : (μ_f v) ^ 2 ≤ (v ^ (1 / 4 : ℝ)) ^ 2 :=
          sq_le_sq' (by linarith) (le_of_lt hlow)
        have hv_rpow_eq : (v ^ (1 / 4 : ℝ)) ^ 2 = v ^ (1 / 2 : ℝ) := by
          rw [← Real.rpow_natCast (v ^ (1 / 4 : ℝ)) 2, ← Real.rpow_mul (le_of_lt hv_pos)]
          norm_num
        have hv_le_K_half : v ^ (1 / 2 : ℝ) ≤ K ^ (1 / 2 : ℝ) :=
          Real.rpow_le_rpow (le_of_lt hv_pos) hv_le_K (by norm_num)
        have hterm_nn : 0 ≤ A_K * (G_cl (v + L_K) - G_cl (v - L_K)) :=
          mul_nonneg hAK_nonneg hcl_diff_nonneg
        linarith
      · have hμ_nn : 0 ≤ μ_f v := (hF_le_Full v hv_ge_k₀).1
        have h1v_le : (1 + v) ^ (1 - hPoly.ε₁) ≤ (1 + K) ^ (1 - hPoly.ε₁) :=
          Real.rpow_le_rpow (by linarith) (by linarith) (by linarith)
        have hμ_up1 : μ_f v ≤ hPoly.C_poly * (1 + K) ^ (1 - hPoly.ε₁) :=
          le_trans (hPoly.sublinear_f_bound v hv_ge_k₀)
            (mul_le_mul_of_nonneg_left h1v_le (le_of_lt hCp_pos))
        have hjmp_v : c_jmp * μ_f v ≤ G_cl (v + L_K) - G_cl (v - L_K) :=
          le_trans (hjump v hv_ge_K₀ hhigh) hdiff_le
        have hμ_up2 : μ_f v ≤ (G_cl (v + L_K) - G_cl (v - L_K)) / c_jmp :=
          (le_div_iff₀ hc_jmp).mpr (by linarith)
        have hsq_le : (μ_f v) ^ 2 ≤ A_K * (G_cl (v + L_K) - G_cl (v - L_K)) := by
          calc (μ_f v) ^ 2 = μ_f v * μ_f v := sq (μ_f v)
            _ ≤ (hPoly.C_poly * (1 + K) ^ (1 - hPoly.ε₁)) *
                  ((G_cl (v + L_K) - G_cl (v - L_K)) / c_jmp) :=
                mul_le_mul hμ_up1 hμ_up2 hμ_nn (by positivity)
            _ = A_K * (G_cl (v + L_K) - G_cl (v - L_K)) := by dsimp [A_K]; ring
        have hK_half_nn : 0 ≤ K ^ (1 / 2 : ℝ) := Real.rpow_nonneg (le_of_lt hK_pos) _
        linarith
    have h_maj_cont : Continuous (fun v : ℝ =>
        K ^ (1 / 2 : ℝ) + A_K * (G_cl (v + L_K) - G_cl (v - L_K))) := by fun_prop
    have h_int_K0_K : (∫ v in K₀..K, (μ_f v) ^ 2) ≤
        ∫ v in K₀..K, (K ^ (1 / 2 : ℝ) + A_K * (G_cl (v + L_K) - G_cl (v - L_K))) :=
      intervalIntegral.integral_mono_on hK₀_le_K
        (hsq_int_on K₀ K hk₀_le_K₀ hK₀_le_K) (h_maj_cont.intervalIntegrable K₀ K) hpt
    have h_split_maj :
        (∫ v in K₀..K, (K ^ (1 / 2 : ℝ) + A_K * (G_cl (v + L_K) - G_cl (v - L_K)))) =
          (K - K₀) * K ^ (1 / 2 : ℝ) +
            A_K * (∫ v in K₀..K, (G_cl (v + L_K) - G_cl (v - L_K))) := by
      have h1 : IntervalIntegrable (fun _ : ℝ => K ^ (1 / 2 : ℝ)) MeasureTheory.volume K₀ K :=
        intervalIntegrable_const
      have h2 : IntervalIntegrable (fun v : ℝ => A_K * (G_cl (v + L_K) - G_cl (v - L_K)))
          MeasureTheory.volume K₀ K :=
        (Continuous.intervalIntegrable (by fun_prop) K₀ K)
      rw [intervalIntegral.integral_add h1 h2, intervalIntegral.integral_const,
        smul_eq_mul, intervalIntegral.integral_const_mul]
    have h_tele :
        (∫ v in K₀..K, (G_cl (v + L_K) - G_cl (v - L_K))) =
          (∫ u in (K - L_K)..(K + L_K), G_cl u) -
            (∫ u in (K₀ - L_K)..(K₀ + L_K), G_cl u) := by
      have hi1 : IntervalIntegrable (fun v : ℝ => G_cl (v + L_K)) MeasureTheory.volume K₀ K :=
        (hG_cl_cont.comp (continuous_id.add continuous_const)).intervalIntegrable K₀ K
      have hi2 : IntervalIntegrable (fun v : ℝ => G_cl (v - L_K)) MeasureTheory.volume K₀ K :=
        (hG_cl_cont.comp (continuous_id.sub continuous_const)).intervalIntegrable K₀ K
      rw [intervalIntegral.integral_sub hi1 hi2,
        intervalIntegral.integral_comp_add_right G_cl L_K,
        intervalIntegral.integral_comp_sub_right G_cl L_K]
      have ha1 := intervalIntegral.integral_add_adjacent_intervals
        (hG_cl_cont.intervalIntegrable (μ := MeasureTheory.volume) (K₀ - L_K) (K₀ + L_K))
        (hG_cl_cont.intervalIntegrable (μ := MeasureTheory.volume) (K₀ + L_K) (K + L_K))
      have ha2 := intervalIntegral.integral_add_adjacent_intervals
        (hG_cl_cont.intervalIntegrable (μ := MeasureTheory.volume) (K₀ - L_K) (K - L_K))
        (hG_cl_cont.intervalIntegrable (μ := MeasureTheory.volume) (K - L_K) (K + L_K))
      linarith
    have h_hi_int : (∫ u in (K - L_K)..(K + L_K), G_cl u) ≤ 2 * L_K * G (K + L_K) := by
      have hle : K - L_K ≤ K + L_K := by linarith
      have h_eq_top : G_cl (K + L_K) = G (K + L_K) := hG_cl_eq (K + L_K) (by linarith)
      calc ∫ u in (K - L_K)..(K + L_K), G_cl u
          ≤ ∫ _ in (K - L_K)..(K + L_K), G (K + L_K) := by
            apply intervalIntegral.integral_mono_on hle
              (hG_cl_cont.intervalIntegrable _ _) intervalIntegrable_const
            intro u hu
            rw [← h_eq_top]
            exact hG_cl_mono hu.2
        _ = 2 * L_K * G (K + L_K) := by
            rw [intervalIntegral.integral_const, smul_eq_mul]; ring
    have h_lo_int : 2 * L_K * G k₀ ≤ ∫ u in (K₀ - L_K)..(K₀ + L_K), G_cl u := by
      have hle : K₀ - L_K ≤ K₀ + L_K := by linarith
      calc 2 * L_K * G k₀
          = ∫ _ in (K₀ - L_K)..(K₀ + L_K), G k₀ := by
            rw [intervalIntegral.integral_const, smul_eq_mul]; ring
        _ ≤ ∫ u in (K₀ - L_K)..(K₀ + L_K), G_cl u := by
            apply intervalIntegral.integral_mono_on hle
              intervalIntegrable_const (hG_cl_cont.intervalIntegrable _ _)
            intro u _
            exact hG_cl_ge u
    have hG_diff_le : G (K + L_K) - G k₀ ≤ M_G * K := by
      have hup : G (K + L_K) ≤ 3 * (K + L_K) + hPoly.C_poly := hG_upper (K + L_K) (by linarith)
      have hneg : -G k₀ ≤ |G k₀| := neg_le_abs (G k₀)
      have hC_nn : 0 ≤ hPoly.C_poly + |G k₀| := by positivity
      calc G (K + L_K) - G k₀
          ≤ 3 * (2 * K) + (hPoly.C_poly + |G k₀|) * 1 := by linarith
        _ ≤ 6 * K + (hPoly.C_poly + |G k₀|) * K := by nlinarith
        _ = M_G * K := by dsimp [M_G]; ring
    have h_tele_le :
        (∫ v in K₀..K, (G_cl (v + L_K) - G_cl (v - L_K))) ≤ 2 * C_jmp * Real.log K * M_G * K := by
      rw [h_tele]
      calc (∫ u in (K - L_K)..(K + L_K), G_cl u) - (∫ u in (K₀ - L_K)..(K₀ + L_K), G_cl u)
          ≤ 2 * L_K * (G (K + L_K) - G k₀) := by linarith
        _ ≤ 2 * L_K * (M_G * K) := mul_le_mul_of_nonneg_left hG_diff_le (by positivity)
        _ = 2 * C_jmp * Real.log K * M_G * K := by dsimp [L_K]; ring
    have h_low_rpow : (K - K₀) * K ^ (1 / 2 : ℝ) ≤ K ^ (2 * ρ) := by
      have hK0_pos : 0 ≤ K₀ := by linarith
      have h1 : (K - K₀) * K ^ (1 / 2 : ℝ) ≤ K * K ^ (1 / 2 : ℝ) :=
        mul_le_mul_of_nonneg_right (by linarith) (Real.rpow_nonneg (le_of_lt hK_pos) _)
      have h2 : K * K ^ (1 / 2 : ℝ) = K ^ (3 / 2 : ℝ) := by
        calc K * K ^ (1 / 2 : ℝ) = K ^ (1 : ℝ) * K ^ (1 / 2 : ℝ) := by rw [Real.rpow_one]
          _ = K ^ (1 + 1 / 2 : ℝ) := (Real.rpow_add hK_pos 1 (1 / 2)).symm
          _ = K ^ (3 / 2 : ℝ) := by norm_num
      have h3 : K ^ (3 / 2 : ℝ) ≤ K ^ (2 * ρ) := by
        have hρ_ge : (7 / 8 : ℝ) ≤ ρ := le_max_left _ _
        exact Real.rpow_le_rpow_of_exponent_le hK_ge_one (by linarith)
      linarith
    have h_1pK_rpow : (1 + K) ^ (1 - hPoly.ε₁) ≤ 2 * K ^ (1 - hPoly.ε₁) := by
      have h1 : (1 + K) ^ (1 - hPoly.ε₁) ≤ (2 * K) ^ (1 - hPoly.ε₁) :=
        Real.rpow_le_rpow (by linarith) (by linarith) (by linarith)
      have h2 : (2 * K) ^ (1 - hPoly.ε₁) = (2 : ℝ) ^ (1 - hPoly.ε₁) * K ^ (1 - hPoly.ε₁) :=
        Real.mul_rpow (by norm_num) (le_of_lt hK_pos)
      have h3 : (2 : ℝ) ^ (1 - hPoly.ε₁) ≤ 2 := by
        calc (2 : ℝ) ^ (1 - hPoly.ε₁) ≤ (2 : ℝ) ^ (1 : ℝ) :=
              Real.rpow_le_rpow_of_exponent_le (by norm_num) (by linarith)
          _ = 2 := Real.rpow_one 2
      calc (1 + K) ^ (1 - hPoly.ε₁) ≤ (2 : ℝ) ^ (1 - hPoly.ε₁) * K ^ (1 - hPoly.ε₁) := by linarith
        _ ≤ 2 * K ^ (1 - hPoly.ε₁) :=
            mul_le_mul_of_nonneg_right h3 (Real.rpow_nonneg (le_of_lt hK_pos) _)
    have h_logK_rpow : Real.log K ≤ (2 / hPoly.ε₁) * K ^ (hPoly.ε₁ / 2) := by
      have hKe_pos : 0 < K ^ (hPoly.ε₁ / 2) := Real.rpow_pos_of_pos hK_pos (hPoly.ε₁ / 2)
      have h1 : Real.log (K ^ (hPoly.ε₁ / 2)) ≤ K ^ (hPoly.ε₁ / 2) - 1 :=
        Real.log_le_sub_one_of_pos hKe_pos
      rw [Real.log_rpow hK_pos (hPoly.ε₁ / 2)] at h1
      have h2 : (hPoly.ε₁ / 2) * Real.log K ≤ K ^ (hPoly.ε₁ / 2) := by linarith
      calc Real.log K = (2 / hPoly.ε₁) * ((hPoly.ε₁ / 2) * Real.log K) := by field_simp
        _ ≤ (2 / hPoly.ε₁) * K ^ (hPoly.ε₁ / 2) :=
            mul_le_mul_of_nonneg_left h2 (by positivity)
    have h_high_rpow :
        A_K * (∫ v in K₀..K, (G_cl (v + L_K) - G_cl (v - L_K))) ≤ C_tail * K ^ (2 * ρ) := by
      have h1 : A_K * (∫ v in K₀..K, (G_cl (v + L_K) - G_cl (v - L_K))) ≤
          A_K * (2 * C_jmp * Real.log K * M_G * K) :=
        mul_le_mul_of_nonneg_left h_tele_le hAK_nonneg
      have h2 : A_K ≤ (2 * hPoly.C_poly / c_jmp) * K ^ (1 - hPoly.ε₁) := by
        dsimp [A_K]
        calc hPoly.C_poly * (1 + K) ^ (1 - hPoly.ε₁) / c_jmp
            ≤ hPoly.C_poly * (2 * K ^ (1 - hPoly.ε₁)) / c_jmp := by gcongr
          _ = (2 * hPoly.C_poly / c_jmp) * K ^ (1 - hPoly.ε₁) := by ring
      have h3 : 2 * C_jmp * Real.log K * M_G * K ≤
          (4 * C_jmp * M_G / hPoly.ε₁) * (K ^ (hPoly.ε₁ / 2) * K) := by
        calc 2 * C_jmp * Real.log K * M_G * K
            ≤ 2 * C_jmp * ((2 / hPoly.ε₁) * K ^ (hPoly.ε₁ / 2)) * M_G * K := by gcongr
          _ = (4 * C_jmp * M_G / hPoly.ε₁) * (K ^ (hPoly.ε₁ / 2) * K) := by ring
      have h_prod_K : K ^ (1 - hPoly.ε₁) * (K ^ (hPoly.ε₁ / 2) * K) ≤ K ^ (2 * ρ) := by
        have hp : K ^ (1 - hPoly.ε₁) * (K ^ (hPoly.ε₁ / 2) * K) = K ^ (2 - hPoly.ε₁ / 2) := by
          calc K ^ (1 - hPoly.ε₁) * (K ^ (hPoly.ε₁ / 2) * K)
              = K ^ (1 - hPoly.ε₁) * (K ^ (hPoly.ε₁ / 2) * K ^ (1 : ℝ)) := by rw [Real.rpow_one]
            _ = K ^ (1 - hPoly.ε₁) * K ^ (hPoly.ε₁ / 2 + 1) := by rw [← Real.rpow_add hK_pos]
            _ = K ^ ((1 - hPoly.ε₁) + (hPoly.ε₁ / 2 + 1)) := by rw [← Real.rpow_add hK_pos]
            _ = K ^ (2 - hPoly.ε₁ / 2) := by congr 1; ring
        rw [hp]
        have hρ_ge : 1 - hPoly.ε₁ / 4 ≤ ρ := le_max_right _ _
        exact Real.rpow_le_rpow_of_exponent_le hK_ge_one (by linarith)
      have h_rhs_nn : 0 ≤ 2 * C_jmp * Real.log K * M_G * K := by positivity
      calc A_K * (∫ v in K₀..K, (G_cl (v + L_K) - G_cl (v - L_K)))
          ≤ A_K * (2 * C_jmp * Real.log K * M_G * K) := h1
        _ ≤ ((2 * hPoly.C_poly / c_jmp) * K ^ (1 - hPoly.ε₁)) *
              ((4 * C_jmp * M_G / hPoly.ε₁) * (K ^ (hPoly.ε₁ / 2) * K)) :=
            mul_le_mul h2 h3 h_rhs_nn (by positivity)
        _ = C_tail * (K ^ (1 - hPoly.ε₁) * (K ^ (hPoly.ε₁ / 2) * K)) := by
            dsimp [C_tail]; ring
        _ ≤ C_tail * K ^ (2 * ρ) :=
            mul_le_mul_of_nonneg_left h_prod_K (le_of_lt hC_tail_pos)
    have hadj :
        (∫ v in k₀..K, (μ_f v) ^ 2) = I₀ + ∫ v in K₀..K, (μ_f v) ^ 2 := by
      exact (intervalIntegral.integral_add_adjacent_intervals
        (hsq_int_on k₀ K₀ le_rfl hk₀_le_K₀) (hsq_int_on K₀ K hk₀_le_K₀ hK₀_le_K)).symm
    have hI0_le : I₀ ≤ I₀ * K ^ (2 * ρ) :=
      le_mul_of_one_le_right hI₀_nonneg h1_le_K2ρ
    calc ∫ v in k₀..K, (μ_f v) ^ 2
        = I₀ + ∫ v in K₀..K, (μ_f v) ^ 2 := hadj
      _ ≤ I₀ + ((K - K₀) * K ^ (1 / 2 : ℝ) +
            A_K * (∫ v in K₀..K, (G_cl (v + L_K) - G_cl (v - L_K)))) := by
          linarith [h_int_K0_K, h_split_maj]
      _ ≤ I₀ * K ^ (2 * ρ) + K ^ (2 * ρ) + C_tail * K ^ (2 * ρ) := by
          linarith [hI0_le, h_low_rpow, h_high_rpow]
      _ = C_ang * K ^ (2 * ρ) := by dsimp [C_ang]; ring

theorem conditional_angle_budget_reduction (S : FiniteWallNonisotropicStrip)
    (hCrit : CriticalWallData S)
    (hBoot : CriticalBootstrapPackage S)
    (hNoProhib : ¬ ProhibitedCriticalSequence S) :
    Nonempty (CriticalAngleBudgetData S) :=
by
  have hDef : LogDeficitTransferPackage S :=
    log_deficit_transfer_estimates S hCrit
  obtain ⟨hPoly⟩ :=
    sublinear_saving_and_poly_envelopes S hCrit hBoot hNoProhib hDef
  obtain ⟨C_ang, ρ, hC_ang_pos, hρ_pos, hρ_lt_one, hAng⟩ :=
    row_max_jump_and_angle_budget S hNoProhib hDef hPoly
  let k₀ : ℝ := criticalDepthThreshold S
  let C_env : ℝ := max (2 * hPoly.C_poly) C_ang
  have hk₀_ge_one : 1 ≤ k₀ := le_max_left 1 (-Real.log (S.H / 20))
  have hexp_k₀_lt : Real.exp (-k₀) < S.H / 10 := by
    have hH_pos : 0 < S.H := S.H_pos
    have hH20_pos : 0 < S.H / 20 := by linarith
    have h_neg_le : -k₀ ≤ Real.log (S.H / 20) := by
      have h1 : -Real.log (S.H / 20) ≤ k₀ := le_max_right 1 (-Real.log (S.H / 20))
      linarith
    have hexp_le : Real.exp (-k₀) ≤ S.H / 20 := by
      calc Real.exp (-k₀)
          ≤ Real.exp (Real.log (S.H / 20)) := Real.exp_le_exp.mpr h_neg_le
        _ = S.H / 20 := Real.exp_log hH20_pos
    linarith
  have hC_env_pos : 0 < C_env := lt_max_of_lt_right hC_ang_pos
  refine ⟨{
    k₀ := k₀
    C_env := C_env
    ρ := ρ
    k₀_ge_one := hk₀_ge_one
    exp_neg_k₀_lt := hexp_k₀_lt
    C_env_pos := hC_env_pos
    ρ_pos := hρ_pos
    ρ_lt_one := hρ_lt_one
    moment_poly_bound := ?_
    row_sup_poly_bound := ?_
    angle_budget := ?_
    single_center_vanishing_exclusion := ?_
  }⟩
  · intro k hk
    have h1 : rowMomentFull S k ≤ hPoly.C_poly * (1 + k) := hPoly.moment_poly_bound k hk
    have hC_le : hPoly.C_poly ≤ C_env := by
      have hpos := hPoly.C_poly_pos
      exact le_trans (by linarith) (le_max_left _ _)
    have hk1_nonneg : 0 ≤ 1 + k := by linarith
    exact le_trans h1 (mul_le_mul_of_nonneg_right hC_le hk1_nonneg)
  · intro k hk x
    let z : ℂ := (x : ℂ) + ((S.H - Real.exp (-k) : ℝ) : ℂ) * Complex.I
    have hf_le : ‖S.f z‖ ≤ shapeModulus S z := le_max_left _ _
    have hq_le : Real.sqrt ‖S.q z‖ ≤ shapeModulus S z := le_max_right _ _
    have hsum_le : ‖S.f z‖ + Real.sqrt ‖S.q z‖ ≤ 2 * shapeModulus S z := by linarith
    have hexp_pos : 0 < Real.exp (-k) := Real.exp_pos (-k)
    have hmod : Real.exp (-k) * shapeModulus S z ≤ hPoly.C_poly * (1 + k) ^ 2 :=
      hPoly.modulus_sup_poly_bound k hk x
    have hC2_le : 2 * hPoly.C_poly ≤ C_env := le_max_left _ _
    have hsq_nonneg : 0 ≤ (1 + k) ^ 2 := sq_nonneg (1 + k)
    calc Real.exp (-k) * (‖S.f z‖ + Real.sqrt ‖S.q z‖)
        ≤ Real.exp (-k) * (2 * shapeModulus S z) :=
          mul_le_mul_of_nonneg_left hsum_le (le_of_lt hexp_pos)
      _ = 2 * (Real.exp (-k) * shapeModulus S z) := by ring
      _ ≤ 2 * (hPoly.C_poly * (1 + k) ^ 2) := by linarith
      _ = (2 * hPoly.C_poly) * (1 + k) ^ 2 := by ring
      _ ≤ C_env * (1 + k) ^ 2 :=
          mul_le_mul_of_nonneg_right hC2_le hsq_nonneg
  · intro K hK
    refine ⟨(hAng K hK).1, ?_⟩
    have h1 := (hAng K hK).2
    have hC_le : C_ang ≤ C_env := le_max_right _ _
    have hK_nonneg : 0 ≤ K := by linarith
    have hrpow_nonneg : 0 ≤ K ^ (2 * ρ) := Real.rpow_nonneg hK_nonneg (2 * ρ)
    exact le_trans h1 (mul_le_mul_of_nonneg_right hC_le hrpow_nonneg)
  · intro c_exp α₀ δ_b hc_pos hc_lt hα₀_gt hα₀_lt hδ_pos hδ_lt
    let α : ℝ := (1 / 2 + α₀) / 2
    have hα_gt : 1 / 2 < α := by dsimp [α]; linarith
    have hα_lt_α₀ : α < α₀ := by dsimp [α]; linarith
    have hα_lt_one : α < 1 := by dsimp [α]; linarith
    obtain ⟨L_star, hL_star_pos, hQC⟩ :=
      hBoot.quiet_cone_exclusion α δ_b hα_gt hα_lt_one hδ_pos hδ_lt
    refine ⟨L_star, hL_star_pos, ?_⟩
    intro k_seq x_seq C₀ C₁ hC₀ hC₁ hk_ge hk_tend hB_tend hEnv hCone hConv
    rcases hConv with ⟨hF_conv, hQ_conv⟩
    have hEnv' : ∀ n : ℕ, ∀ l : ℝ, criticalDepthThreshold S ≤ l →
        rowMomentFull S l ≤ C₀ * rowMomentFull S (k_seq n) *
          Real.exp (c_exp * max (k_seq n - l) 0 + c_exp * max (l - k_seq n) 0) := by
      intro n l hl
      have hmax_eq : c_exp * max (k_seq n - l) 0 + c_exp * max (l - k_seq n) 0 =
          c_exp * |l - k_seq n| := by
        rcases le_total l (k_seq n) with hlk | hkl
        · have h1 : max (k_seq n - l) 0 = k_seq n - l := max_eq_left (by linarith)
          have h2 : max (l - k_seq n) 0 = 0 := max_eq_right (by linarith)
          have h3 : |l - k_seq n| = k_seq n - l := by
            rw [abs_of_nonpos (by linarith)]; ring
          rw [h1, h2, h3]; ring
        · have h1 : max (k_seq n - l) 0 = 0 := max_eq_right (by linarith)
          have h2 : max (l - k_seq n) 0 = l - k_seq n := max_eq_left (by linarith)
          have h3 : |l - k_seq n| = l - k_seq n := abs_of_nonneg (by linarith)
          rw [h1, h2, h3]; ring
      rw [hmax_eq]
      exact hEnv n l hl
    apply hQC c_exp c_exp C₀ (le_of_lt hc_pos) hc_lt hc_pos hC₀ k_seq x_seq hk_ge hk_tend hB_tend hEnv'
    intro c_depth ε hc_depth_pos hε_pos
    have hdiff_pos : 0 < α₀ - α := by linarith
    have h_tend_R : Filter.Tendsto (fun x : ℝ => x ^ (-(α₀ - α))) Filter.atTop (nhds 0) :=
      tendsto_rpow_neg_atTop hdiff_pos
    have h_ev_R : ∀ᶠ x : ℝ in Filter.atTop, x ^ (-(α₀ - α)) < ε / C₁ :=
      h_tend_R.eventually (gt_mem_nhds (div_pos hε_pos hC₁))
    rw [Filter.eventually_atTop] at h_ev_R
    obtain ⟨R₀, hR₀⟩ := h_ev_R
    let R : ℝ := max (max 1 c_depth) R₀
    have hR_ge_one : 1 ≤ R := le_trans (le_max_left 1 c_depth) (le_max_left _ R₀)
    have hR_pos : 0 < R := by linarith
    have hR_decay : C₁ * R ^ (-(α₀ - α)) ≤ ε := by
      have hlt : R ^ (-(α₀ - α)) * C₁ < ε := (lt_div_iff₀ hC₁).mp (hR₀ R (le_max_right _ R₀))
      linarith
    have h_ev_B : ∀ᶠ n : ℕ in Filter.atTop, 1 ≤ rowMomentFull S (k_seq n) :=
      hB_tend.eventually_ge_atTop 1
    rw [Filter.eventually_atTop] at h_ev_B
    obtain ⟨N_B, hN_B⟩ := h_ev_B
    let Φ : ℝ × ℝ → ℂ := fun p => (p.1 : ℂ) + (p.2 : ℂ) * Complex.I
    have hΦ_cont : Continuous Φ := by fun_prop
    let box : Set (ℝ × ℝ) := Set.Icc (-(L_star * R)) (L_star * R) ×ˢ Set.Icc (-R) (-c_depth)
    let K_trap : Set ℂ := Φ '' box
    have hK_compact : IsCompact K_trap := (isCompact_Icc.prod isCompact_Icc).image hΦ_cont
    have hK_sub : K_trap ⊆ { Z : ℂ | Z.im < 0 } := by
      rintro Z ⟨⟨u, v⟩, ⟨_, hv⟩, rfl⟩
      have hzim : ((u : ℂ) + (v : ℂ) * Complex.I).im = v := by simp
      change ((u : ℂ) + (v : ℂ) * Complex.I).im < 0
      rw [hzim]
      linarith [hv.2]
    have hF_unif : TendstoUniformlyOn
        (fun n Z => ((Real.exp (-k_seq n) / rowMomentFull S (k_seq n) : ℝ) : ℂ) *
          S.f ((x_seq n : ℂ) + (S.H : ℂ) * Complex.I + (Real.exp (-k_seq n) : ℂ) * Z))
        (fun _ => 0) Filter.atTop K_trap :=
      (tendstoLocallyUniformlyOn_iff_tendstoUniformlyOn_of_compact hK_compact).mp
        (hF_conv.mono hK_sub)
    have hQ_unif : TendstoUniformlyOn
        (fun n Z => ((Real.exp (-k_seq n) / rowMomentFull S (k_seq n) : ℝ) : ℂ) ^ 2 *
          S.q ((x_seq n : ℂ) + (S.H : ℂ) * Complex.I + (Real.exp (-k_seq n) : ℂ) * Z))
        (fun _ => 0) Filter.atTop K_trap :=
      (tendstoLocallyUniformlyOn_iff_tendstoUniformlyOn_of_compact hK_compact).mp
        (hQ_conv.mono hK_sub)
    let η : ℝ := ε * R ^ (-α)
    have hη_pos : 0 < η := mul_pos hε_pos (Real.rpow_pos_of_pos hR_pos (-α))
    have hF_ev := (Metric.tendstoUniformlyOn_iff.mp hF_unif) η hη_pos
    have hQ_ev := (Metric.tendstoUniformlyOn_iff.mp hQ_unif) (η ^ 2) (sq_pos_of_pos hη_pos)
    rw [Filter.eventually_atTop] at hF_ev hQ_ev
    obtain ⟨N_F, hN_F⟩ := hF_ev
    obtain ⟨N_Q, hN_Q⟩ := hQ_ev
    refine ⟨max N_B (max N_F N_Q), ?_⟩
    intro n hn s hdepth_lo hdepth_hi hre_cone
    have hn_B : N_B ≤ n := le_trans (le_max_left _ _) hn
    have hn_F : N_F ≤ n := le_trans (le_max_left N_F N_Q) (le_trans (le_max_right _ _) hn)
    have hn_Q : N_Q ≤ n := le_trans (le_max_right N_F N_Q) (le_trans (le_max_right _ _) hn)
    let d_n : ℝ := Real.exp (-k_seq n)
    let B_n : ℝ := rowMomentFull S (k_seq n)
    have hd_pos : 0 < d_n := Real.exp_pos (-k_seq n)
    have hB_ge_one : 1 ≤ B_n := hN_B n hn_B
    have hB_pos : 0 < B_n := by linarith
    have hdB_pos : 0 < d_n / B_n := div_pos hd_pos hB_pos
    have hdepth_pos : 0 < wallDepth S s :=
      lt_of_lt_of_le (mul_pos hc_depth_pos hd_pos) hdepth_lo
    rcases le_total (wallDepth S s) (R * d_n) with h_inner | h_outer
    · let u : ℝ := (s.re - x_seq n) / d_n
      let v : ℝ := -wallDepth S s / d_n
      let Z : ℂ := Φ (u, v)
      have hre_bound : |s.re - x_seq n| ≤ (L_star * R) * d_n := by
        calc |s.re - x_seq n|
            ≤ L_star * wallDepth S s := hre_cone
          _ ≤ L_star * (R * d_n) := mul_le_mul_of_nonneg_left h_inner (le_of_lt hL_star_pos)
          _ = (L_star * R) * d_n := by ring
      have hu_mem : u ∈ Set.Icc (-(L_star * R)) (L_star * R) := by
        rw [abs_le] at hre_bound
        refine ⟨?_, ?_⟩
        · dsimp [u]
          rw [le_div_iff₀ hd_pos]
          linarith [hre_bound.1]
        · dsimp [u]
          rw [div_le_iff₀ hd_pos]
          exact hre_bound.2
      have hv_mem : v ∈ Set.Icc (-R) (-c_depth) := by
        refine ⟨?_, ?_⟩
        · dsimp [v]
          rw [le_div_iff₀ hd_pos]
          linarith
        · dsimp [v]
          rw [div_le_iff₀ hd_pos]
          linarith
      have hZ_mem : Z ∈ K_trap := ⟨(u, v), ⟨hu_mem, hv_mem⟩, rfl⟩
      have hs_eq : (x_seq n : ℂ) + (S.H : ℂ) * Complex.I + (d_n : ℂ) * Z = s := by
        have hd_ne : d_n ≠ 0 := ne_of_gt hd_pos
        apply Complex.ext
        · simp only [Z, Φ, u, v, wallDepth, Complex.add_re, Complex.ofReal_re, Complex.mul_re,
            Complex.I_re, Complex.I_im, Complex.ofReal_im]
          field_simp [hd_ne]
          ring
        · simp only [Z, Φ, u, v, wallDepth, Complex.add_im, Complex.ofReal_im, Complex.mul_im,
            Complex.I_re, Complex.I_im, Complex.ofReal_re]
          field_simp [hd_ne]
          ring
      have hF_dist := hN_F n hn_F Z hZ_mem
      have hQ_dist := hN_Q n hn_Q Z hZ_mem
      simp only [dist_zero_left] at hF_dist hQ_dist
      rw [hs_eq] at hF_dist hQ_dist
      have hf_bound : (d_n / B_n) * ‖S.f s‖ ≤ η := by
        have hnorm : ‖((d_n / B_n : ℝ) : ℂ) * S.f s‖ = (d_n / B_n) * ‖S.f s‖ := by
          rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hdB_pos]
        rw [hnorm] at hF_dist
        exact le_of_lt hF_dist
      have hq_bound : (d_n / B_n) * Real.sqrt ‖S.q s‖ ≤ η := by
        have hnorm : ‖((d_n / B_n : ℝ) : ℂ) ^ 2 * S.q s‖ = (d_n / B_n) ^ 2 * ‖S.q s‖ := by
          rw [norm_mul, norm_pow, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hdB_pos]
        rw [hnorm] at hQ_dist
        have hsqrt := Real.sqrt_le_sqrt (le_of_lt hQ_dist)
        rw [Real.sqrt_mul (sq_nonneg (d_n / B_n)), Real.sqrt_sq (le_of_lt hdB_pos),
          Real.sqrt_sq (le_of_lt hη_pos)] at hsqrt
        exact hsqrt
      have hmod_bound : (d_n / B_n) * shapeModulus S s ≤ η := by
        dsimp [shapeModulus]
        rw [mul_max_of_nonneg _ _ (le_of_lt hdB_pos)]
        exact max_le hf_bound hq_bound
      have ht_le_R : wallDepth S s / d_n ≤ R := (div_le_iff₀ hd_pos).mpr h_inner
      have ht_nonneg : 0 ≤ wallDepth S s / d_n := div_nonneg (le_of_lt hdepth_pos) (le_of_lt hd_pos)
      have hrpow_le : (wallDepth S s / d_n) ^ α ≤ R ^ α :=
        Real.rpow_le_rpow ht_nonneg ht_le_R (by linarith)
      have hmod_nonneg : 0 ≤ (d_n / B_n) * shapeModulus S s :=
        mul_nonneg (le_of_lt hdB_pos) (le_trans (norm_nonneg _) (le_max_left _ _))
      have hrpow_nonneg : 0 ≤ (wallDepth S s / d_n) ^ α :=
        Real.rpow_nonneg ht_nonneg α
      calc (d_n / B_n) * shapeModulus S s * (wallDepth S s / d_n) ^ α
          ≤ η * R ^ α := mul_le_mul hmod_bound hrpow_le hrpow_nonneg (le_of_lt hη_pos)
        _ = ε * (R ^ (-α) * R ^ α) := by dsimp [η]; ring
        _ = ε * R ^ (-α + α) := by rw [← Real.rpow_add hR_pos]
        _ = ε * R ^ (0 : ℝ) := by ring_nf
        _ = ε := by rw [Real.rpow_zero, mul_one]
    · have hd_le_depth : d_n ≤ wallDepth S s := by
        calc d_n = 1 * d_n := (one_mul d_n).symm
          _ ≤ R * d_n := mul_le_mul_of_nonneg_right hR_ge_one (le_of_lt hd_pos)
          _ ≤ wallDepth S s := h_outer
      have hcone_s := hCone n s hd_le_depth hdepth_hi hre_cone
      let t : ℝ := wallDepth S s / d_n
      have ht_ge_R : R ≤ t := (le_div_iff₀ hd_pos).mpr h_outer
      have ht_pos : 0 < t := lt_of_lt_of_le hR_pos ht_ge_R
      have hinv_eq : (d_n / wallDepth S s) ^ α₀ = t ^ (-α₀) := by
        have hdt : d_n / wallDepth S s = t⁻¹ := by dsimp [t]; rw [inv_div]
        rw [hdt, Real.inv_rpow (le_of_lt ht_pos) α₀, ← Real.rpow_neg (le_of_lt ht_pos) α₀]
      rw [hinv_eq] at hcone_s
      have htα_nonneg : 0 ≤ t ^ α := Real.rpow_nonneg (le_of_lt ht_pos) α
      have ht_decay : t ^ (-(α₀ - α)) ≤ R ^ (-(α₀ - α)) := by
        have ha : 0 < R ^ (α₀ - α) := Real.rpow_pos_of_pos hR_pos (α₀ - α)
        have hb : 0 < t ^ (α₀ - α) := Real.rpow_pos_of_pos ht_pos (α₀ - α)
        have hab : R ^ (α₀ - α) ≤ t ^ (α₀ - α) :=
          Real.rpow_le_rpow (le_of_lt hR_pos) ht_ge_R (le_of_lt hdiff_pos)
        rw [Real.rpow_neg (le_of_lt ht_pos), Real.rpow_neg (le_of_lt hR_pos)]
        calc (t ^ (α₀ - α))⁻¹
            = (R ^ (α₀ - α) * (R ^ (α₀ - α))⁻¹) * (t ^ (α₀ - α))⁻¹ := by
              rw [mul_inv_cancel₀ (ne_of_gt ha), one_mul]
          _ = R ^ (α₀ - α) * ((R ^ (α₀ - α))⁻¹ * (t ^ (α₀ - α))⁻¹) := by ring
          _ ≤ t ^ (α₀ - α) * ((R ^ (α₀ - α))⁻¹ * (t ^ (α₀ - α))⁻¹) :=
              mul_le_mul_of_nonneg_right hab
                (mul_nonneg (le_of_lt (inv_pos.mpr ha)) (le_of_lt (inv_pos.mpr hb)))
          _ = (t ^ (α₀ - α) * (t ^ (α₀ - α))⁻¹) * (R ^ (α₀ - α))⁻¹ := by ring
          _ = (R ^ (α₀ - α))⁻¹ := by rw [mul_inv_cancel₀ (ne_of_gt hb), one_mul]
      calc (d_n / B_n) * shapeModulus S s * t ^ α
          ≤ (C₁ * t ^ (-α₀)) * t ^ α := mul_le_mul_of_nonneg_right hcone_s htα_nonneg
        _ = C₁ * (t ^ (-α₀) * t ^ α) := by ring
        _ = C₁ * t ^ (-α₀ + α) := by rw [← Real.rpow_add ht_pos]
        _ = C₁ * t ^ (-(α₀ - α)) := by congr 2; ring
        _ ≤ C₁ * R ^ (-(α₀ - α)) := mul_le_mul_of_nonneg_left ht_decay (le_of_lt hC₁)
        _ ≤ ε := hR_decay

theorem hadamard_moment_law_compactness (S : FiniteWallNonisotropicStrip)
    (k_seq ε_seq : ℕ → ℝ)
    (h_basic : ∀ n : ℕ, criticalDepthThreshold S ≤ k_seq n ∧
      0 < ε_seq n ∧ 1 ≤ rowMomentFull S (k_seq n))
    (hk_top : Filter.Tendsto k_seq Filter.atTop Filter.atTop)
    (hε_zero : Filter.Tendsto ε_seq Filter.atTop (nhds 0))
    (h_norm : ∀ n : ℕ, ∀ j : ℝ, criticalDepthThreshold S ≤ j →
      rowMomentFull S j ≤ rowMomentFull S (k_seq n) * Real.exp (ε_seq n * |j - k_seq n|)) :
    ∃ (σ : ℕ → ℕ) (m : ℝ → ℝ),
      StrictMono σ ∧
      (∀ D : ℝ, 0 < D → 0 < m D) ∧
      m 1 = 1 ∧
      (∀ D : ℝ, 0 < D → m D ≤ D⁻¹) ∧
      ConvexOn ℝ (Set.Ioi 0) (fun D => Real.log (m D)) ∧
      TendstoLocallyUniformlyOn
        (fun n D =>
          rowMomentFull S (k_seq (σ n) - Real.log D) / (rowMomentFull S (k_seq (σ n)) * D))
        m Filter.atTop (Set.Ioi 0) :=
by
  have h2pi_pos : (0 : ℝ) < 2 * Real.pi := Real.two_pi_pos
  have hStrip_open : IsOpen (horizStrip S.H) :=
    isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const
  
  have h_three_lines : ∀ (h : ℂ → ℂ),
      DifferentiableOn ℂ h (horizStrip S.H) →
      (∀ s ∈ horizStrip S.H, h (s + 2 * Real.pi) = h s) →
      ∀ (y₀ y₁ θ : ℝ), y₀ ∈ Set.Ioo (-S.H) S.H → y₁ ∈ Set.Ioo (-S.H) S.H →
      0 ≤ θ → θ ≤ 1 →
      (2 * Real.pi)⁻¹ *
          (∫ x in (0 : ℝ)..(2 * Real.pi),
            ‖h ((x : ℂ) + (((1 - θ) * y₀ + θ * y₁ : ℝ) : ℂ) * Complex.I)‖) ≤
        ((2 * Real.pi)⁻¹ *
            ∫ x in (0 : ℝ)..(2 * Real.pi), ‖h ((x : ℂ) + (y₀ : ℂ) * Complex.I)‖) ^ (1 - θ) *
          ((2 * Real.pi)⁻¹ *
            ∫ x in (0 : ℝ)..(2 * Real.pi), ‖h ((x : ℂ) + (y₁ : ℂ) * Complex.I)‖) ^ θ := by
    intro h hh_holo hh_per y₀ y₁ θ hy₀ hy₁ hθ₀ hθ₁
    rcases eq_or_lt_of_le hθ₀ with rfl | hθ₀_pos
    · simp [Real.rpow_zero, Real.rpow_one]
    rcases eq_or_lt_of_le hθ₁ with rfl | hθ₁_lt
    · simp [Real.rpow_zero, Real.rpow_one]
    have hy₀_abs : |y₀| < S.H := abs_lt.mpr ⟨hy₀.1, hy₀.2⟩
    have hy₁_abs : |y₁| < S.H := abs_lt.mpr ⟨hy₁.1, hy₁.2⟩
    let m₀ : ℝ := max |y₀| |y₁|
    have hm₀_lt : m₀ < S.H := max_lt hy₀_abs hy₁_abs
    have hm₀_nonneg : 0 ≤ m₀ := le_trans (abs_nonneg y₀) (le_max_left _ _)
    let M_y : ℝ := (m₀ + S.H) / 2
    have hM_gt : m₀ < M_y := by dsimp [M_y]; linarith
    have hM_lt : M_y < S.H := by dsimp [M_y]; linarith
    let δ : ℝ := (S.H - m₀) / (8 * (|y₁ - y₀| + 1))
    have h_den_pos : 0 < 8 * (|y₁ - y₀| + 1) := by positivity
    have hδ_pos : 0 < δ := div_pos (by linarith) h_den_pos
    have hδ_mul : 2 * δ * |y₁ - y₀| ≤ (S.H - m₀) / 4 := by
      have h_eq : 2 * δ * |y₁ - y₀| * (8 * (|y₁ - y₀| + 1)) = 2 * (S.H - m₀) * |y₁ - y₀| := by
        dsimp [δ]; field_simp [h_den_pos.ne']
      nlinarith [abs_nonneg (y₁ - y₀)]
    let U_δ : Set ℂ := { z : ℂ | -2 * δ < z.re ∧ z.re < 1 + 2 * δ }
    have hU_open : IsOpen U_δ :=
      (isOpen_lt continuous_const Complex.continuous_re).inter
        (isOpen_lt Complex.continuous_re continuous_const)
    have h_im_le : ∀ u : ℝ, -2 * δ < u → u < 1 + 2 * δ → |(1 - u) * y₀ + u * y₁| ≤ M_y := by
      intro u hu_lo hu_hi
      have hy₀_le : |y₀| ≤ m₀ := le_max_left _ _
      have hy₁_le : |y₁| ≤ m₀ := le_max_right _ _
      rcases lt_or_ge u 0 with hu0 | hu0
      · have heq : (1 - u) * y₀ + u * y₁ = y₀ + u * (y₁ - y₀) := by ring
        rw [heq]
        calc |y₀ + u * (y₁ - y₀)|
            ≤ |y₀| + |u * (y₁ - y₀)| := abs_add_le _ _
          _ = |y₀| + (-u) * |y₁ - y₀| := by
              rw [abs_mul, abs_of_neg hu0]
          _ ≤ m₀ + 2 * δ * |y₁ - y₀| := by
              have : (-u) * |y₁ - y₀| ≤ (2 * δ) * |y₁ - y₀| :=
                mul_le_mul_of_nonneg_right (by linarith) (abs_nonneg _)
              linarith
          _ ≤ M_y := by dsimp [M_y]; linarith
      · rcases le_or_gt u 1 with hu1 | hu1
        · calc |(1 - u) * y₀ + u * y₁|
              ≤ |(1 - u) * y₀| + |u * y₁| := abs_add_le _ _
            _ = (1 - u) * |y₀| + u * |y₁| := by
                rw [abs_mul, abs_mul, abs_of_nonneg (by linarith), abs_of_nonneg hu0]
            _ ≤ (1 - u) * m₀ + u * m₀ := by
                have h1 : (1 - u) * |y₀| ≤ (1 - u) * m₀ :=
                  mul_le_mul_of_nonneg_left hy₀_le (by linarith)
                have h2 : u * |y₁| ≤ u * m₀ :=
                  mul_le_mul_of_nonneg_left hy₁_le hu0
                linarith
            _ = m₀ := by ring
            _ ≤ M_y := le_of_lt hM_gt
        · have heq : (1 - u) * y₀ + u * y₁ = y₁ + (u - 1) * (y₁ - y₀) := by ring
          rw [heq]
          calc |y₁ + (u - 1) * (y₁ - y₀)|
              ≤ |y₁| + |(u - 1) * (y₁ - y₀)| := abs_add_le _ _
            _ = |y₁| + (u - 1) * |y₁ - y₀| := by
                rw [abs_mul, abs_of_pos (sub_pos.mpr hu1)]
            _ ≤ m₀ + 2 * δ * |y₁ - y₀| := by
                have : (u - 1) * |y₁ - y₀| ≤ (2 * δ) * |y₁ - y₀| :=
                  mul_le_mul_of_nonneg_right (by linarith) (abs_nonneg _)
                linarith
            _ ≤ M_y := by dsimp [M_y]; linarith
    have h_mem_shift : ∀ (s : ℂ) (r : ℝ), s + (r : ℂ) ∈ horizStrip S.H ↔ s ∈ horizStrip S.H := by
      intro s r
      simp [horizStrip]
    have hh_per' : ∀ s ∈ horizStrip S.H, h (s + ((2 * Real.pi : ℝ) : ℂ)) = h s := by
      intro s hs
      convert hh_per s hs using 2
      push_cast
      ring
    have hh_per_int : ∀ (k : ℤ) (s : ℂ), s ∈ horizStrip S.H →
        h (s + ((k * (2 * Real.pi) : ℝ) : ℂ)) = h s := by
      intro k
      induction k using Int.induction_on with
      | zero =>
        intro s _
        simp
      | succ m ih =>
        intro s hs
        have h_split : s + ((((m + 1 : ℤ) : ℝ) * (2 * Real.pi) : ℝ) : ℂ) =
            (s + (((m : ℝ) * (2 * Real.pi) : ℝ) : ℂ)) + ((2 * Real.pi : ℝ) : ℂ) := by
          push_cast
          ring
        rw [h_split, hh_per' _ ((h_mem_shift s _).mpr hs)]
        convert ih s hs using 2
      | pred m ih =>
        intro s hs
        have hs_prev : s + (((-(m : ℝ) - 1) * (2 * Real.pi) : ℝ) : ℂ) ∈ horizStrip S.H :=
          (h_mem_shift s _).mpr hs
        have h_step := hh_per' _ hs_prev
        have h_eq1 : (s + (((-(m : ℝ) - 1) * (2 * Real.pi) : ℝ) : ℂ)) + ((2 * Real.pi : ℝ) : ℂ) =
            s + (((-(m : ℝ)) * (2 * Real.pi) : ℝ) : ℂ) := by
          push_cast
          ring
        have h_eq2 : s + (((-(m : ℤ) - 1 : ℤ) * (2 * Real.pi) : ℝ) : ℂ) =
            s + (((-(m : ℝ) - 1) * (2 * Real.pi) : ℝ) : ℂ) := by
          push_cast
          ring
        rw [h_eq1] at h_step
        rw [h_eq2, ← h_step]
        convert ih s hs using 2
        push_cast
        ring
    have hh_ana : AnalyticOnNhd ℂ h (horizStrip S.H) :=
      (Complex.analyticOnNhd_iff_differentiableOn hStrip_open).mpr hh_holo
    have hdh_cont : ContinuousOn (deriv h) (horizStrip S.H) := hh_ana.deriv.continuousOn
    have hdh_per_int : ∀ (k : ℤ) (s : ℂ), s ∈ horizStrip S.H →
        deriv h (s + ((k * (2 * Real.pi) : ℝ) : ℂ)) = deriv h s := by
      intro k s hs
      let c : ℂ := ((k * (2 * Real.pi) : ℝ) : ℂ)
      have hs_c : s + c ∈ horizStrip S.H := (h_mem_shift s _).mpr hs
      have hd1 : HasDerivAt (fun w : ℂ => h (w + c)) (deriv h (s + c) * 1) s :=
