    have hCosSinIter : ∀ k : ℕ, ∀ y : ℝ,
        |iteratedDeriv k Real.cos y| ≤ 1 ∧ |iteratedDeriv k Real.sin y| ≤ 1 := by
      intro k
      induction k with
      | zero =>
        intro y
        simp [iteratedDeriv_zero, Real.abs_cos_le_one, Real.abs_sin_le_one]
      | succ k ih =>
        intro y
        have hdcos : deriv Real.cos = -Real.sin := funext fun _ => Real.deriv_cos
        refine ⟨?_, ?_⟩
        · rw [iteratedDeriv_succ', hdcos]
          have hneg : iteratedDeriv k (-Real.sin) y = -iteratedDeriv k Real.sin y :=
            iteratedDeriv_fun_neg k Real.sin y
          rw [hneg, abs_neg]
          exact (ih y).2
        · rw [iteratedDeriv_succ', Real.deriv_sin]
          exact (ih y).1
    have hSincJet : HasCJetBound_fcks (p + 1) 1 realSinc_fcks := by
      let G : ℝ → ℝ → ℝ := fun s u => Real.cos (s * u)
      have hG_cd : ContDiff ℝ ((p + 1 : ℕ) : WithTop ℕ∞) (Function.uncurry G) :=
