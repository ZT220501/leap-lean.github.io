    have h_inv_area : (Real.pi * r_l ^ 2)⁻¹ = (4 * Real.exp (2 * A) / Real.pi) * Real.exp (2 * l) := by
      dsimp [r_l]
      have hpi : (Real.pi : ℝ) ≠ 0 := Real.pi_pos.ne'
      have heA : Real.exp (-A) ^ 2 * Real.exp (2 * A) = 1 := by
        rw [← Real.exp_nat_mul, ← Real.exp_add]
