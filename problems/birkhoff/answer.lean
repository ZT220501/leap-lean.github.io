  have h_spine_mem :
      ∀ (i : Fin m) (n k : ℕ), ∀ δ ∈ Set.Icc (δ_n n) (δ_n 0),
        ((a₀ : ℂ), (δ : ℂ)) ∈ V_ode ∧ ψ i ((a₀ : ℂ), (δ : ℂ)) ∈ W_n i k := by
    intro i n k δ hδ
    have hδ_pos : 0 < δ := lt_of_lt_of_le (hδn_pos n) hδ.1
    have hδ_le₀ : δ ≤ δ₀ := by linarith [hδ.2, hδn_zero]
    have hCδ_le : C₀ * δ ≤ C₀ * δ₀ := mul_le_mul_of_nonneg_left hδ_le₀ (le_of_lt hC₀)
    have hq_trap : (a₀, δ) ∈ webTrapezoid a₀ R δ_star C₀ := by
      refine ⟨hδ_pos, lt_of_le_of_lt hδ_le₀ hδ₀_lt, ?_⟩
      simp only [sub_self, abs_zero]
      linarith
    have hq_base : (a₀, δ) ∈ webBaseClosure a₀ R δ_star :=
      ⟨le_of_lt hδ_pos, lt_of_le_of_lt hδ_le₀ hδ₀_lt, by simp [le_of_lt hR]⟩
    have hb := hψ_base i (a₀, δ) hq_base
    refine ⟨hV_cov (a₀, δ) hq_trap, ?_, ?_⟩
    · have h1 : |(ψ i ((a₀ : ℂ), (δ : ℂ))).re - a₀| ≤ C₀ * δ := hb.2.1
      have h2 := hR'n_gt k
      have h3 := hρ_pos i k
      linarith
    · rw [hb.1, abs_zero]
      exact hρ_pos i k
  have hpderivA_center_ne :
      ∀ (i : Fin m) (k : ℕ), pderivA (ψ i) ((a₀ : ℂ), (δ_n k : ℂ)) ≠ 0 := by
    intro i k h0
    have hq_base : (a₀, δ_n k) ∈ webBaseClosure a₀ R δ_star :=
      ⟨le_of_lt (hδn_pos k), lt_of_le_of_lt (hδn_le k) hδ₀_lt, by simp [le_of_lt hR]⟩
    have hre := (hψ_base i (a₀, δ_n k) hq_base).2.2
    change 1 / 2 ≤ (pderivA (ψ i) ((a₀ : ℂ), (δ_n k : ℂ))).re at hre
    rw [h0, Complex.zero_re] at hre
    linarith
  
  have h_spine_tube :
      ∀ (i : Fin m) (n : ℕ),
        ∃ Ω_sp : Set (ℂ × ℂ),
          IsOpen Ω_sp ∧ Ω_sp ⊆ V_ode ∧
          ((a₀ : ℂ), (δ_n 0 : ℂ)) ∈ Ω_sp ∧
          ∀ p ∈ Ω_sp,
            ψ i p ∈ W_n i n ∩ W_n i 0 ∧
            g_n i n (ψ i p) = F₀ i p ∧
            g_n i 0 (ψ i p) = F₀ i p := by
    intro i n
    let U_tube : Set (ℂ × ℂ) := V_ode ∩ ψ i ⁻¹' (W_n i n ∩ W_n i 0)
    have hUtube_open : IsOpen U_tube :=
      ((hψ_holo i).mono hV_sub).continuousOn.isOpen_inter_preimage hV_ode
        ((hWn_open i n).inter (hWn_open i 0))
    let S_sp : Set (ℂ × ℂ) := (fun δ : ℝ => ((a₀ : ℂ), (δ : ℂ))) '' Set.Icc (δ_n n) (δ_n 0)
    have hS_pre : IsPreconnected S_sp :=
      (convex_Icc (δ_n n) (δ_n 0)).isPreconnected.image _
        (continuous_const.prodMk Complex.continuous_ofReal).continuousOn
    have hS_sub : S_sp ⊆ U_tube := by
      rintro _ ⟨δ, hδ, rfl⟩
      exact ⟨(h_spine_mem i n n δ hδ).1, (h_spine_mem i n n δ hδ).2, (h_spine_mem i n 0 δ hδ).2⟩
    obtain ⟨Ω_sp, hΩ_open, hΩ_pre, hS_Ω, hΩ_U⟩ := exists_preconn_nhd hS_pre hUtube_open hS_sub
    have hδn_le0 : δ_n n ≤ δ_n 0 := by rw [hδn_zero]; exact hδn_le n
    have hp_n_mem : ((a₀ : ℂ), (δ_n n : ℂ)) ∈ Ω_sp :=
      hS_Ω ⟨δ_n n, ⟨le_rfl, hδn_le0⟩, rfl⟩
    have hp_0_mem : ((a₀ : ℂ), (δ_n 0 : ℂ)) ∈ Ω_sp :=
      hS_Ω ⟨δ_n 0, ⟨hδn_le0, le_rfl⟩, rfl⟩
    have hΩ_V : Ω_sp ⊆ V_ode := hΩ_U.trans Set.inter_subset_left
    have h_eq_n : ∀ p ∈ Ω_sp, g_n i n (ψ i p) = F₀ i p :=
      h_transport_zero Ω_sp (W_n i n) (δ_n n) (B_a i n) (ψ i) (F₀ i) (g_n i n)
        hΩ_open hΩ_pre hΩ_V hp_n_mem (hWn_open i n)
        ((hψ_holo i).mono hV_sub) (hF₀_holo i) (hcross i) (hg_n_holo i n)
        (fun p hp => (hΩ_U hp).2.1) (hpderivA_center_ne i n)
        (hBa_open i n) (ha₀_Ba i n) (fun z hz => (hBa_eq i n z hz).2)
    have h_eq_0 : ∀ p ∈ Ω_sp, g_n i 0 (ψ i p) = F₀ i p :=
      h_transport_zero Ω_sp (W_n i 0) (δ_n 0) (B_a i 0) (ψ i) (F₀ i) (g_n i 0)
        hΩ_open hΩ_pre hΩ_V hp_0_mem (hWn_open i 0)
        ((hψ_holo i).mono hV_sub) (hF₀_holo i) (hcross i) (hg_n_holo i 0)
        (fun p hp => (hΩ_U hp).2.2) (hpderivA_center_ne i 0)
        (hBa_open i 0) (ha₀_Ba i 0) (fun z hz => (hBa_eq i 0 z hz).2)
    exact ⟨Ω_sp, hΩ_open, hΩ_V, hp_0_mem,
      fun p hp => ⟨(hΩ_U hp).2, h_eq_n p hp, h_eq_0 p hp⟩⟩
  choose Ω_sp hΩ_sp_open _hΩ_sp_sub hp0_Ω_sp hΩ_sp_prop using h_spine_tube
  
  let w₀ : Fin m → ℂ := fun i => ψ i ((a₀ : ℂ), (δ_n 0 : ℂ))
  have hw₀_mem : ∀ (i : Fin m) (k : ℕ), w₀ i ∈ W_n i k := fun i k =>
    (h_spine_mem i 0 k (δ_n 0) ⟨le_rfl, le_rfl⟩).2
  have hg_ev_zero : ∀ (i : Fin m) (n : ℕ), g_n i n =ᶠ[nhds (w₀ i)] g_n i 0 := by
    intro i n
    let ι₀ : ℂ → ℂ × ℂ := fun w => (σ i 0 w, (δ_n 0 : ℂ))
    have hσ0_cont : ContinuousAt (σ i 0) (w₀ i) :=
      ((hσ_holo i 0).differentiableAt ((hWn_open i 0).mem_nhds (hw₀_mem i 0))).continuousAt
    have hι₀_cont : ContinuousAt ι₀ (w₀ i) := hσ0_cont.prodMk continuousAt_const
    have hι₀_w₀ : ι₀ (w₀ i) = ((a₀ : ℂ), (δ_n 0 : ℂ)) := by
      dsimp [ι₀, w₀]
      rw [hσ_a₀ i 0]
    have h_nhds : W_n i 0 ∩ ι₀ ⁻¹' (Ω_sp i n) ∈ nhds (w₀ i) :=
      Filter.inter_mem ((hWn_open i 0).mem_nhds (hw₀_mem i 0))
        (hι₀_cont.preimage_mem_nhds ((hΩ_sp_open i n).mem_nhds (by rw [hι₀_w₀]; exact hp0_Ω_sp i n)))
    refine Filter.eventuallyEq_of_mem h_nhds ?_
    rintro w ⟨hw_W0, hw_pre⟩
    have hψ_ι : ψ i (ι₀ w) = w := (hWn_inv i 0 w hw_W0).2.1
    have hsp := hΩ_sp_prop i n (ι₀ w) hw_pre
    calc
      g_n i n w = g_n i n (ψ i (ι₀ w)) := by rw [hψ_ι]
      _ = F₀ i (ι₀ w) := hsp.2.1
      _ = g_n i 0 (ψ i (ι₀ w)) := hsp.2.2.symm
      _ = g_n i 0 w := by rw [hψ_ι]
  have hg_compat :
      ∀ (i : Fin m) (k n : ℕ), ∀ w ∈ W_n i k ∩ W_n i n, g_n i k w = g_n i n w := by
    intro i k n
    let W_kn : Set ℂ := W_n i k ∩ W_n i n
    have hWkn_open : IsOpen W_kn := (hWn_open i k).inter (hWn_open i n)
    have hWkn_pre : IsPreconnected W_kn := ((hWn_conv i k).inter (hWn_conv i n)).isPreconnected
    have hw₀_Wkn : w₀ i ∈ W_kn := ⟨hw₀_mem i k, hw₀_mem i n⟩
    have hgk_ana : AnalyticOnNhd ℂ (g_n i k) W_kn :=
      ((hg_n_holo i k).mono Set.inter_subset_left).analyticOnNhd hWkn_open
    have hgn_ana : AnalyticOnNhd ℂ (g_n i n) W_kn :=
      ((hg_n_holo i n).mono Set.inter_subset_right).analyticOnNhd hWkn_open
    exact hgk_ana.eqOn_of_preconnected_of_eventuallyEq hgn_ana hWkn_pre hw₀_Wkn
      ((hg_ev_zero i k).trans (hg_ev_zero i n).symm)
  
  let U_i : Fin m → Set ℂ := fun i => ⋃ n : ℕ, W_n i n
  have hUi_open : ∀ i : Fin m, IsOpen (U_i i) := fun i =>
    isOpen_iUnion (fun n => hWn_open i n)
  classical
  let g : Fin m → ℂ → ℂ := fun i w =>
    if hw : ∃ n : ℕ, w ∈ W_n i n then g_n i (Classical.choose hw) w else 0
  have hg_eq_on_Wn : ∀ (i : Fin m) (n : ℕ), ∀ w ∈ W_n i n, g i w = g_n i n w := by
    intro i n w hw
    have hex : ∃ k : ℕ, w ∈ W_n i k := ⟨n, hw⟩
    dsimp [g]
    simp only [hex, ↓reduceDIte]
    exact hg_compat i (Classical.choose hex) n w ⟨Classical.choose_spec hex, hw⟩
  have hg_holo_Ui : ∀ i : Fin m, DifferentiableOn ℂ (g i) (U_i i) := by
    intro i w hw
    rcases Set.mem_iUnion.mp hw with ⟨n, hwn⟩
    have hev : g i =ᶠ[nhds w] g_n i n :=
      Filter.eventuallyEq_of_mem ((hWn_open i n).mem_nhds hwn) (fun y hy => hg_eq_on_Wn i n y hy)
    exact (((hg_n_holo i n).differentiableAt ((hWn_open i n).mem_nhds hwn)).congr_of_eventuallyEq
      hev).differentiableWithinAt
  have hUi_cov : ∀ (i : Fin m) (x : ℝ), |x - a₀| < R → (x : ℂ) ∈ U_i i := by
    intro i x hx
    have hgap : 0 < R - |x - a₀| := sub_pos.mpr hx
    obtain ⟨n, hn⟩ := exists_nat_gt (3 * (C₀ * δ₀) / (R - |x - a₀|))
    have hn1_pos : (0 : ℝ) < (n : ℝ) + 1 := by positivity
    have h_lt1 : 3 * (C₀ * δ₀) / (R - |x - a₀|) < (n : ℝ) + 1 := by linarith
    have h_mul : 3 * (C₀ * δ₀) < (R - |x - a₀|) * ((n : ℝ) + 1) := by
      linarith [(div_lt_iff₀ hgap).mp h_lt1]
    have h_3C : 3 * (C₀ * δ_n n) < R - |x - a₀| := by
      have h_eq : 3 * (C₀ * δ_n n) = 3 * (C₀ * δ₀) / ((n : ℝ) + 1) := by
        dsimp [δ_n]
        ring
      rw [h_eq, div_lt_iff₀ hn1_pos]
      exact h_mul
    refine Set.mem_iUnion.mpr ⟨n, ?_, ?_⟩
    · simp only [Complex.ofReal_re]
      dsimp [R'_n]
      linarith [hρ_pos i n]
    · simp [hρ_pos i n]
  
  let U_all : Set ℂ := ⋂ i : Fin m, U_i i
  have hUall_open : IsOpen U_all := isOpen_iInter_of_finite hUi_open
  let I_ℂ : Set ℂ := Complex.ofReal '' Set.Ioo (a₀ - R) (a₀ + R)
  have hI_pre : IsPreconnected I_ℂ :=
    (convex_Ioo (a₀ - R) (a₀ + R)).isPreconnected.image _ Complex.continuous_ofReal.continuousOn
  have hI_sub : I_ℂ ⊆ U_all := by
    rintro _ ⟨x, hx, rfl⟩
    refine Set.mem_iInter.mpr (fun i => hUi_cov i x ?_)
    rw [abs_lt]
    exact ⟨by linarith [hx.1], by linarith [hx.2]⟩
  obtain ⟨W_ψ, hW_open, hW_pre, hI_W, hW_Uall⟩ := exists_preconn_nhd hI_pre hUall_open hI_sub
  have hW_cov : ∀ x : ℝ, |x - a₀| < R → (x : ℂ) ∈ W_ψ := by
    intro x hx
    have hx_lt := abs_lt.mp hx
    exact hI_W ⟨x, ⟨by linarith, by linarith⟩, rfl⟩
  have hg_holo_W : ∀ i : Fin m, DifferentiableOn ℂ (g i) W_ψ := fun i =>
    (hg_holo_Ui i).mono (hW_Uall.trans (Set.iInter_subset _ i))
  
  have htrap_conv : Convex ℝ (webTrapezoid a₀ R δ_star C₀) := by
    intro q₁ hq₁ q₂ hq₂ t₁ t₂ ht₁ ht₂ ht₁₂
    by_cases ht₁_zero : t₁ = 0
    · have ht₂_one : t₂ = 1 := by linarith
      simpa [ht₁_zero, ht₂_one] using hq₂
    · have ht₁_pos : 0 < t₁ := lt_of_le_of_ne ht₁ (Ne.symm ht₁_zero)
      refine ⟨?_, ?_, ?_⟩
      · simp only [Prod.smul_snd, Prod.snd_add, smul_eq_mul]
        exact add_pos_of_pos_of_nonneg (mul_pos ht₁_pos hq₁.1) (mul_nonneg ht₂ (le_of_lt hq₂.1))
      · simp only [Prod.smul_snd, Prod.snd_add, smul_eq_mul]
        have h1 : t₁ * q₁.2 < t₁ * δ_star := mul_lt_mul_of_pos_left hq₁.2.1 ht₁_pos
        have h2 : t₂ * q₂.2 ≤ t₂ * δ_star := mul_le_mul_of_nonneg_left (le_of_lt hq₂.2.1) ht₂
        calc
          t₁ * q₁.2 + t₂ * q₂.2 < t₁ * δ_star + t₂ * δ_star := add_lt_add_of_lt_of_le h1 h2
          _ = (t₁ + t₂) * δ_star := by ring
          _ = δ_star := by rw [ht₁₂, one_mul]
      · simp only [Prod.smul_fst, Prod.fst_add, Prod.smul_snd, Prod.snd_add, smul_eq_mul]
        have h_rew : (t₁ * q₁.1 + t₂ * q₂.1) - a₀ = t₁ * (q₁.1 - a₀) + t₂ * (q₂.1 - a₀) := by
          linear_combination a₀ * ht₁₂
        rw [h_rew]
        have h_tri := abs_add_le (t₁ * (q₁.1 - a₀)) (t₂ * (q₂.1 - a₀))
        rw [abs_mul, abs_mul, abs_of_nonneg ht₁, abs_of_nonneg ht₂] at h_tri
        have h1 : t₁ * |q₁.1 - a₀| < t₁ * (R - C₀ * q₁.2) :=
          mul_lt_mul_of_pos_left hq₁.2.2 ht₁_pos
        have h2 : t₂ * |q₂.1 - a₀| ≤ t₂ * (R - C₀ * q₂.2) :=
          mul_le_mul_of_nonneg_left (le_of_lt hq₂.2.2) ht₂
        calc
          |t₁ * (q₁.1 - a₀) + t₂ * (q₂.1 - a₀)| ≤ t₁ * |q₁.1 - a₀| + t₂ * |q₂.1 - a₀| := h_tri
          _ < t₁ * (R - C₀ * q₁.2) + t₂ * (R - C₀ * q₂.2) := add_lt_add_of_lt_of_le h1 h2
          _ = (t₁ + t₂) * R - C₀ * (t₁ * q₁.2 + t₂ * q₂.2) := by ring
          _ = R - C₀ * (t₁ * q₁.2 + t₂ * q₂.2) := by rw [ht₁₂, one_mul]
  let T_ℂ : Set (ℂ × ℂ) :=
    (fun q : ℝ × ℝ => ((q.1 : ℂ), (q.2 : ℂ))) '' webTrapezoid a₀ R δ_star C₀
  have hT_pre : IsPreconnected T_ℂ :=
    htrap_conv.isPreconnected.image _
      ((Complex.continuous_ofReal.comp continuous_fst).prodMk
        (Complex.continuous_ofReal.comp continuous_snd)).continuousOn
  let U_good : Set (ℂ × ℂ) := V_ode ∩ ⋂ i : Fin m, (V_ode ∩ ψ i ⁻¹' W_ψ)
  have hUgood_open : IsOpen U_good :=
    hV_ode.inter (isOpen_iInter_of_finite (fun i =>
      ((hψ_holo i).mono hV_sub).continuousOn.isOpen_inter_preimage hV_ode hW_open))
  have hT_sub : T_ℂ ⊆ U_good := by
    rintro _ ⟨q, hq, rfl⟩
    refine ⟨hV_cov q hq, Set.mem_iInter.mpr (fun i => ⟨hV_cov q hq, ?_⟩)⟩
    have hq_base : q ∈ webBaseClosure a₀ R δ_star := by
      refine ⟨le_of_lt hq.1, hq.2.1, ?_⟩
      have hCq : 0 < C₀ * q.2 := mul_pos hC₀ hq.1
      linarith [hq.2.2]
    have hb := hψ_base i q hq_base
    have hψ_real :
        ψ i ((q.1 : ℂ), (q.2 : ℂ)) = (((ψ i ((q.1 : ℂ), (q.2 : ℂ))).re : ℝ) : ℂ) := by
      apply Complex.ext
      · simp
      · simpa using hb.1
    rw [Set.mem_preimage, hψ_real]
    refine hW_cov _ ?_
    have h_tri := abs_sub_le (ψ i ((q.1 : ℂ), (q.2 : ℂ))).re q.1 a₀
    linarith [hb.2.1, hq.2.2]
  obtain ⟨V_plus, hVp_open, hVp_pre, hT_Vp, hVp_Ugood⟩ :=
    exists_preconn_nhd hT_pre hUgood_open hT_sub
  have hVp_sub : V_plus ⊆ V_ode := hVp_Ugood.trans Set.inter_subset_left
  have hVp_cov : ∀ q ∈ webTrapezoid a₀ R δ_star C₀, ((q.1 : ℂ), (q.2 : ℂ)) ∈ V_plus :=
    fun q hq => hT_Vp ⟨q, hq, rfl⟩
  have hVp_maps : ∀ p ∈ V_plus, ∀ i : Fin m, ψ i p ∈ W_ψ := fun p hp i =>
    ((Set.mem_iInter.mp (hVp_Ugood hp).2) i).2
  
  have hp0_Vp : ((a₀ : ℂ), (δ_n 0 : ℂ)) ∈ V_plus := by
    rw [hδn_zero]
    refine hVp_cov (a₀, δ₀) ⟨hδ₀_pos, hδ₀_lt, ?_⟩
    simp only [sub_self, abs_zero]
    linarith
  have hVp_eq : ∀ i : Fin m, ∀ p ∈ V_plus, g i (ψ i p) = F₀ i p := by
    intro i p hp
    let V_ov : Set (ℂ × ℂ) := V_plus ∩ Ω_sp i 0
    have hVov_open : IsOpen V_ov := hVp_open.inter (hΩ_sp_open i 0)
    have hVov_ne : V_ov.Nonempty := ⟨((a₀ : ℂ), (δ_n 0 : ℂ)), hp0_Vp, hp0_Ω_sp i 0⟩
    let H_i : ℂ × ℂ → ℂ := fun q => g i (ψ i q) - F₀ i q
    have hHi_holo : DifferentiableOn ℂ H_i V_plus :=
      ((hg_holo_W i).comp ((hψ_holo i).mono (hVp_sub.trans hV_sub))
        (fun q hq => hVp_maps q hq i)).sub ((hF₀_holo i).mono hVp_sub)
    have hHi_ov : ∀ q ∈ V_ov, H_i q = 0 := by
      intro q hq
      have hsp := hΩ_sp_prop i 0 q hq.2
      dsimp [H_i]
      rw [hg_eq_on_Wn i 0 (ψ i q) hsp.1.2, hsp.2.2, sub_self]
    exact sub_eq_zero.mp
      (hKit.eqOn_zero_of_preconnected_2D hVp_open hVp_pre hVov_open hVov_ne
        Set.inter_subset_left hHi_holo hHi_ov p hp)
  exact ⟨W_ψ, V_plus, g, hW_open, hW_pre, hW_cov, hVp_open, hVp_pre, hVp_sub,
    hVp_cov, hg_holo_W, fun p hp => ⟨fun i => hVp_maps p hp i, fun i => hVp_eq i p hp⟩⟩

theorem finite_web_ode_continuation : FiniteWebContinuationProp :=
by
  intro m hm a₀ R δ_star C₀ hR hδ_star hC₀ hC₀δ U₀ U_plus hU₀ hU_plus hU₀_cov hU_plus_cov
    ψ w B hψ_holo hw_holo hB_holo hψ_base hweb_nondeg a₁ δ₁ hδ₁_pos hδ₁_lt ha₁ f hf_web
  have hKit : Holo2DAndTaylorToolkit := holo_2d_and_taylor_toolkit
  obtain ⟨sys⟩ :=
    web_vandermonde_pde_reduction m hm hKit U₀ U_plus hU₀ hU_plus ψ w B hψ_holo hw_holo hB_holo
  have htrap_sub_base : ∀ q ∈ webTrapezoid a₀ R δ_star C₀, q ∈ webBaseClosure a₀ R δ_star := by
    intro q hq
    rcases hq with ⟨hq_pos, hq_lt, hq_abs⟩
    refine ⟨le_of_lt hq_pos, hq_lt, ?_⟩
    have hC₀q : 0 < C₀ * q.2 := mul_pos hC₀ hq_pos
    linarith
  have hpderivA_ne :
      ∀ q ∈ webBaseClosure a₀ R δ_star, ∀ i : Fin m,
        pderivA (ψ i) ((q.1 : ℂ), (q.2 : ℂ)) ≠ 0 := by
    intro q hq i hzero
    have hre := (hψ_base i q hq).2.2
    change 1 / 2 ≤ (pderivA (ψ i) ((q.1 : ℂ), (q.2 : ℂ))).re at hre
    rw [hzero, Complex.zero_re] at hre
    linarith
  have hcov_ode :
      ∀ q ∈ webTrapezoid a₀ R δ_star C₀,
        ((q.1 : ℂ), (q.2 : ℂ)) ∈ webODEDomain ψ w U₀ U_plus := by
    intro q hq
    have hq_base : q ∈ webBaseClosure a₀ R δ_star := htrap_sub_base q hq
    refine sys.mem_ode_domain ((q.1 : ℂ), (q.2 : ℂ))
      ⟨hU₀_cov q hq_base, hU_plus_cov q hq⟩
      (hweb_nondeg q hq).1 (hpderivA_ne q hq_base) (hweb_nondeg q hq).2
  have hq₁_trap : (a₁, δ₁) ∈ webTrapezoid a₀ R δ_star C₀ := by
    refine ⟨hδ₁_pos, hδ₁_lt, ?_⟩
    have hmul : C₀ * δ₁ < C₀ * δ_star := mul_lt_mul_of_pos_left hδ₁_lt hC₀
    dsimp only
    linarith
  set p₁ : ℂ × ℂ := ((a₁ : ℂ), (δ₁ : ℂ))
  have hp₁_ode : p₁ ∈ webODEDomain ψ w U₀ U_plus := hcov_ode (a₁, δ₁) hq₁_trap
  obtain ⟨V_formal, hV_formal_zero, hV_formal_ode⟩ := sys.formal_ode p₁ hp₁_ode f hf_web
  obtain ⟨V_ode, V, hV_ode_open, hV_ode_pre, hV_ode_sub, hV_ode_cov, hV_holo, hV_taylor, hV_pde⟩ :=
    trapezoid_linear_pde_continuation (Fin m × Fin m) hKit a₀ R δ_star C₀ a₁ δ₁
      hR hδ_star hC₀ hC₀δ hδ₁_pos hδ₁_lt ha₁
      (webODEDomain ψ w U₀ U_plus) sys.isOpen_ode hcov_ode
      sys.M_a sys.M_δ sys.c_a sys.c_δ
      sys.M_a_holo sys.M_δ_holo sys.c_a_holo sys.c_δ_holo
      V_formal (fun idx => (hV_formal_ode idx).1) (fun idx => (hV_formal_ode idx).2)
  let F₀ : Fin m → ℂ × ℂ → ℂ := fun i p => V p (i, ⟨0, hm⟩)
  have hF₀_holo : ∀ i : Fin m, DifferentiableOn ℂ (F₀ i) V_ode :=
    fun i => hV_holo (i, ⟨0, hm⟩)
  have hF₀_cross :
      ∀ i : Fin m, ∀ p ∈ V_ode,
        pderivD (ψ i) p * pderivA (F₀ i) p = pderivA (ψ i) p * pderivD (F₀ i) p := by
    intro i p hp
    have hp_ode : p ∈ webODEDomain ψ w U₀ U_plus := hV_ode_sub hp
    have hpde := hV_pde p hp (i, ⟨0, hm⟩)
    change pderivD (ψ i) p * pderivA (fun q => V q (i, ⟨0, hm⟩)) p =
      pderivA (ψ i) p * pderivD (fun q => V q (i, ⟨0, hm⟩)) p
    rw [hpde.1, hpde.2]
    exact sys.cross_rel p hp_ode (V p) i
  have hV_ode_sub_U₀ : V_ode ⊆ U₀ := Set.Subset.trans hV_ode_sub sys.ode_sub_U₀
  have hV_ode_sub_U_plus : V_ode ⊆ U_plus := Set.Subset.trans hV_ode_sub sys.ode_sub_U_plus
  obtain ⟨W_ψ, V_plus, g, hW_open, hW_pre, hW_cov, hVp_open, hVp_pre, hVp_sub_ode,
      hVp_cov, hg_holo, hVp_prop⟩ :=
    trapezoid_foliation_edge_descent m hm hKit a₀ R δ_star C₀ hR hδ_star hC₀ hC₀δ
      U₀ V_ode hU₀ hV_ode_open hV_ode_sub_U₀ hU₀_cov hV_ode_cov
      ψ F₀ hψ_holo hF₀_holo hψ_base hF₀_cross
  have hVp_sub_U₀ : V_plus ⊆ U₀ := Set.Subset.trans hVp_sub_ode hV_ode_sub_U₀
  have hVp_sub_U_plus : V_plus ⊆ U_plus := Set.Subset.trans hVp_sub_ode hV_ode_sub_U_plus
  have hp₁_Vp : p₁ ∈ V_plus := hVp_cov (a₁, δ₁) hq₁_trap
  have hψ_Vp : ∀ i : Fin m, DifferentiableOn ℂ (ψ i) V_plus :=
    fun i => (hψ_holo i).mono hVp_sub_U₀
  have hψ_maps : ∀ i : Fin m, ∀ p ∈ V_plus, ψ i p ∈ W_ψ :=
    fun i p hp => (hVp_prop p hp).1 i
  have hg_comp_taylor :
      ∀ i : Fin m,
        taylor2D (fun p => g i (ψ i p)) p₁ =
          compPowerSeries2D (holoTaylor1D (g i) (ψ i p₁)) (centeredTaylor2D (ψ i) p₁) :=
    fun i => hKit.taylor2D_comp_1D hVp_open hW_open hp₁_Vp (hψ_Vp i) (hg_holo i) (hψ_maps i)
  have hg_series : ∀ i : Fin m, holoTaylor1D (g i) (ψ i p₁) = f i := by
    intro i
    have hcongr1 : taylor2D (fun p => g i (ψ i p)) p₁ = taylor2D (F₀ i) p₁ :=
      hKit.taylor2D_congr hVp_open hp₁_Vp (fun p hp => (hVp_prop p hp).2 i)
    have hcomp_eq :
        compPowerSeries2D (holoTaylor1D (g i) (ψ i p₁)) (centeredTaylor2D (ψ i) p₁) =
          compPowerSeries2D (f i) (centeredTaylor2D (ψ i) p₁) := by
      rw [← hg_comp_taylor i, hcongr1]
      exact (hV_taylor (i, ⟨0, hm⟩)).trans (hV_formal_zero i)
    exact hKit.compPowerSeries2D_inj hU₀ (hVp_sub_U₀ hp₁_Vp) (hψ_holo i)
      (hpderivA_ne (a₁, δ₁) (htrap_sub_base (a₁, δ₁) hq₁_trap) i)
      (holoTaylor1D (g i) (ψ i p₁)) (f i) hcomp_eq
  let term : Fin m → ℂ × ℂ → ℂ := fun i p => w i p * g i (ψ i p)
  have hterm_holo : ∀ i : Fin m, DifferentiableOn ℂ (term i) V_plus := by
    intro i
    exact ((hw_holo i).mono hVp_sub_U_plus).mul
      ((hg_holo i).comp (hψ_Vp i) (fun p hp => hψ_maps i p hp))
  have hsum_holo_and_taylor :
      ∀ s : Finset (Fin m),
        DifferentiableOn ℂ (fun p => ∑ i ∈ s, term i p) V_plus ∧
        taylor2D (fun p => ∑ i ∈ s, term i p) p₁ = ∑ i ∈ s, taylor2D (term i) p₁ := by
    intro s
    induction s using Finset.induction_on with
    | empty =>
      refine ⟨differentiableOn_const 0, ?_⟩
      simpa using (hKit.taylor2D_algebra hVp_open hp₁_Vp).1 0
    | @insert a s ha ih =>
      have h_eq : (fun p => ∑ i ∈ insert a s, term i p) =
          (fun p => term a p + ∑ i ∈ s, term i p) := by
        ext p
        exact Finset.sum_insert ha
      rw [h_eq, Finset.sum_insert ha]
      refine ⟨(hterm_holo a).add ih.1, ?_⟩
      rw [((hKit.taylor2D_algebra hVp_open hp₁_Vp).2 (hterm_holo a) ih.1).1, ih.2]
  have hsum_taylor_eq_B :
      taylor2D (fun p => ∑ i : Fin m, term i p) p₁ = taylor2D B p₁ := by
    rw [(hsum_holo_and_taylor Finset.univ).2, ← hf_web]
    refine Finset.sum_congr rfl ?_
    intro i _
    have hwi_Vp : DifferentiableOn ℂ (w i) V_plus := (hw_holo i).mono hVp_sub_U_plus
    have hgi_Vp : DifferentiableOn ℂ (fun p => g i (ψ i p)) V_plus :=
      (hg_holo i).comp (hψ_Vp i) (fun p hp => hψ_maps i p hp)
    have hmul_eq := ((hKit.taylor2D_algebra hVp_open hp₁_Vp).2 hwi_Vp hgi_Vp).2.2
    change taylor2D (fun p => w i p * g i (ψ i p)) p₁ =
      taylor2D (w i) p₁ * compPowerSeries2D (f i) (centeredTaylor2D (ψ i) p₁)
    rw [hmul_eq, hg_comp_taylor i, hg_series i]
  have hB_Vp : DifferentiableOn ℂ B V_plus := hB_holo.mono hVp_sub_U_plus
  have hres_holo :
      DifferentiableOn ℂ (fun p => (∑ i : Fin m, term i p) - B p) V_plus :=
    (hsum_holo_and_taylor Finset.univ).1.sub hB_Vp
  have hres_taylor :
      taylor2D (fun p => (∑ i : Fin m, term i p) - B p) p₁ = 0 := by
    rw [((hKit.taylor2D_algebra hVp_open hp₁_Vp).2 (hsum_holo_and_taylor Finset.univ).1 hB_Vp).2.1,
      hsum_taylor_eq_B, sub_self]
  refine ⟨W_ψ, V_plus, g, hW_open, hW_pre, hW_cov, hVp_open, hVp_pre, hVp_sub_U₀,
    hVp_sub_U_plus, hVp_cov, hg_holo, ?_, ?_⟩
  · intro i
    refine ⟨hψ_maps i p₁ hp₁_Vp, ?_⟩
    intro n
    have hcoeff := congr_arg (PowerSeries.coeff n) (hg_series i)
    simpa [holoTaylor1D] using hcoeff
  · intro p hp
    refine ⟨fun i => hψ_maps i p hp, ?_⟩
    have hzero : (∑ i : Fin m, term i p) - B p = 0 :=
      hKit.eqOn_zero_of_taylor2D_zero hVp_open hVp_pre hp₁_Vp hres_holo hres_taylor p hp
    exact sub_eq_zero.mp hzero

theorem line_glancing_chart_and_hessian (Ω : Set Plane)
    (C : AnalyticGlancingCollar Ω)
    (B : BaseCollarAndCramerData C)
    (k : ℕ) (hk : 2 ≤ k) :
    Nonempty (LineGlancingChartData C B k) :=
by
  let a₀ : ℝ := C.ϕ 0
  have h_part12 : ∃ (R₀ δ₀ : ℝ) (e : OpenPartialHomeomorph (ℂ × ℂ) (ℂ × ℂ)),
      0 < R₀ ∧ 0 < δ₀ ∧
      (↑e : ℂ × ℂ → ℂ × ℂ) =
        (fun p => (glancingTheta C p.1 p.2,
          glancingTheta C (p.1 + (k : ℂ) * p.2) p.2 - glancingTheta C p.1 p.2)) ∧
      (Metric.ball (a₀ : ℂ) (2 * R₀) ×ˢ Metric.ball (0 : ℂ) (2 * δ₀) ⊆ e.target) ∧
      (∀ q ∈ Metric.ball (a₀ : ℂ) (2 * R₀) ×ˢ Metric.ball (0 : ℂ) (2 * δ₀),
        e.symm q ∈ lineChainBox C B k) ∧
      DifferentiableOn ℂ e.symm
        (Metric.ball (a₀ : ℂ) (2 * R₀) ×ˢ Metric.ball (0 : ℂ) (2 * δ₀)) ∧
      (∀ r : Fin (k + 1),
        DifferentiableOn ℂ (lineChartAlpha C k e.symm r)
          (Metric.ball (a₀ : ℂ) (2 * R₀) ×ˢ Metric.ball (0 : ℂ) (2 * δ₀))) ∧
      (∀ i : Fin k,
        ∀ q ∈ Metric.ball (a₀ : ℂ) (2 * R₀) ×ˢ Metric.ball (0 : ℂ) (2 * δ₀),
          lineChartPsi C k e.symm i q ∈ horizStrip (2 * C.s_h)) ∧
      (∀ r : Fin (k + 1), ∀ a δ : ℝ,
        ((a : ℂ), (δ : ℂ)) ∈ Metric.ball (a₀ : ℂ) (2 * R₀) ×ˢ Metric.ball (0 : ℂ) (2 * δ₀) →
          (lineChartAlpha C k e.symm r ((a : ℂ), (δ : ℂ))).im = 0) ∧
      (∀ r : Fin (k + 1), ∀ z ∈ Metric.ball (a₀ : ℂ) (2 * R₀),
        lineChartAlpha C k e.symm r (z, 0) = z ∧
        deriv (fun w : ℂ => lineChartAlpha C k e.symm r (z, w)) 0 = ((r : ℕ) : ℂ) / (k : ℂ)) ∧
      (∀ q ∈ Metric.ball (a₀ : ℂ) (2 * R₀) ×ˢ Metric.ball (0 : ℂ) (2 * δ₀),
        (∀ r : Fin (k - 1),
          lineInteriorGrad (fun _ => C.h_ℂ) (fun _ => deriv C.h_ℂ)
            (fun s => lineChartAlpha C k e.symm s q) r = 0) ∧
        iterDerivYT 1 0 (lineChartAction C k e.symm) q =
          glancingOffset C ((e.symm q).1 + (k : ℂ) * (e.symm q).2) (e.symm q).2 -
            glancingOffset C (e.symm q).1 (e.symm q).2 ∧
        iterDerivYT 0 1 (lineChartAction C k e.symm) q =
          glancingOffset C ((e.symm q).1 + (k : ℂ) * (e.symm q).2) (e.symm q).2) := by
    let W₀ : Set (ℂ × ℂ) := lineChainBox C B k
    have hk_pos : (0 : ℝ) < (k : ℝ) := by positivity
    have hk_ge2 : (2 : ℝ) ≤ (k : ℝ) := by exact_mod_cast hk
    have hk_ne : (k : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
    have hW₀_open : IsOpen W₀ := by
      refine IsOpen.inter ?_ ?_
      · exact isOpen_lt (continuous_abs.comp (Complex.continuous_im.comp continuous_fst))
          continuous_const
      · exact isOpen_lt (continuous_norm.comp continuous_snd) continuous_const
    have h00_W₀ : ((0 : ℂ), (0 : ℂ)) ∈ W₀ := by
      simp [W₀, lineChainBox, B.s_det_pos, div_pos B.r_det_pos hk_pos]
    have h_shift_bounds : ∀ p ∈ W₀, ∀ j : ℕ, j ≤ k + 1 →
        |(p.1 + (j : ℂ) * p.2).im| < (11 / 8 : ℝ) * B.s_det ∧ ‖p.2‖ < B.r_det / 2 := by
      intro p hp j hj
      have hmul_k : (k : ℝ) * ‖p.2‖ < B.r_det := (lt_div_iff₀' hk_pos).mp hp.2
      have hp2_nn : 0 ≤ ‖p.2‖ := norm_nonneg _
      have hp2_lt : ‖p.2‖ < B.r_det / 2 := by
        have h2le : 2 * ‖p.2‖ ≤ (k : ℝ) * ‖p.2‖ := mul_le_mul_of_nonneg_right hk_ge2 hp2_nn
        linarith
      have hj_le : (j : ℝ) ≤ (k : ℝ) + 1 := by exact_mod_cast hj
      have hj_im : |((j : ℂ) * p.2).im| ≤ ((k : ℝ) + 1) * ‖p.2‖ := by
        calc |((j : ℂ) * p.2).im|
            ≤ ‖(j : ℂ) * p.2‖ := Complex.abs_im_le_norm _
          _ = (j : ℝ) * ‖p.2‖ := by rw [norm_mul, Complex.norm_natCast]
          _ ≤ ((k : ℝ) + 1) * ‖p.2‖ := mul_le_mul_of_nonneg_right hj_le hp2_nn
      refine ⟨?_, hp2_lt⟩
      rw [Complex.add_im]
      have htri : |p.1.im + ((j : ℂ) * p.2).im| ≤ |p.1.im| + |((j : ℂ) * p.2).im| :=
        abs_add_le _ _
      have hmul_kp1 : ((k : ℝ) + 1) * ‖p.2‖ < (3 / 2 : ℝ) * B.r_det := by
        have : ((k : ℝ) + 1) * ‖p.2‖ = (k : ℝ) * ‖p.2‖ + ‖p.2‖ := by ring
        linarith
      linarith [hp.1, B.r_det_lt_s_det]
    let Θ_sh : ℕ → ℂ × ℂ → ℂ := fun j p => glancingTheta C (p.1 + (j : ℂ) * p.2) p.2
    have hΘ_sh_holo : ∀ j : ℕ, j ≤ k + 1 → DifferentiableOn ℂ (Θ_sh j) W₀ := by
      intro j hj
      have haff : Differentiable ℂ (fun p : ℂ × ℂ => (p.1 + (j : ℂ) * p.2, p.2)) :=
        (differentiable_fst.add ((differentiable_const (j : ℂ)).mul differentiable_snd)).prodMk
          differentiable_snd
      change DifferentiableOn ℂ
        ((fun q : ℂ × ℂ => glancingTheta C q.1 q.2) ∘
          (fun p : ℂ × ℂ => (p.1 + (j : ℂ) * p.2, p.2))) W₀
      refine B.theta_holo.comp haff.differentiableOn ?_
      intro p hp
      obtain ⟨him, hnm⟩ := h_shift_bounds p hp j hj
      exact ⟨by linarith [B.s_det_pos], by linarith [B.r_det_pos]⟩
    let Φ₁ : ℂ × ℂ → ℂ := fun p => glancingTheta C p.1 p.2
    let Φ₂ : ℂ × ℂ → ℂ := fun p =>
      glancingTheta C (p.1 + (k : ℂ) * p.2) p.2 - glancingTheta C p.1 p.2
    let Φ : ℂ × ℂ → ℂ × ℂ := fun p => (Φ₁ p, Φ₂ p)
    have hΦ₁_holo : DifferentiableOn ℂ Φ₁ W₀ := by
      simpa [Φ₁, Θ_sh] using hΘ_sh_holo 0 (by omega)
    have hΦ₂_holo : DifferentiableOn ℂ Φ₂ W₀ := (hΘ_sh_holo k (by omega)).sub hΦ₁_holo
    have h_fderiv_2d : ∀ {f : ℂ × ℂ → ℂ}, DifferentiableOn ℂ f W₀ → ∀ p ∈ W₀,
        HasFDerivAt f
          ((iterDerivYT 1 0 f p) • ContinuousLinearMap.fst ℂ ℂ ℂ +
            (iterDerivYT 0 1 f p) • ContinuousLinearMap.snd ℂ ℂ ℂ) p := by
      intro f hf p hp
      have hf_at : HasFDerivAt f (fderiv ℂ f p) p :=
        (hf.differentiableAt (hW₀_open.mem_nhds hp)).hasFDerivAt
      have hin1 : HasDerivAt (fun z : ℂ => (z, p.2)) ((1 : ℂ), (0 : ℂ)) p.1 := by
        simpa using ((hasDerivAt_id p.1).hasFDerivAt.prodMk
          (hasDerivAt_const p.1 p.2).hasFDerivAt).hasDerivAt
      have hin2 : HasDerivAt (fun w : ℂ => (p.1, w)) ((0 : ℂ), (1 : ℂ)) p.2 := by
        simpa using ((hasDerivAt_const p.2 p.1).hasFDerivAt.prodMk
          (hasDerivAt_id p.2).hasFDerivAt).hasDerivAt
      have hd1 : iterDerivYT 1 0 f p = (fderiv ℂ f p) ((1 : ℂ), (0 : ℂ)) :=
        (hf_at.comp_hasDerivAt p.1 hin1).deriv
      have hd2 : iterDerivYT 0 1 f p = (fderiv ℂ f p) ((0 : ℂ), (1 : ℂ)) :=
        (hf_at.comp_hasDerivAt p.2 hin2).deriv
      convert hf_at using 1
      apply ContinuousLinearMap.ext
      intro v
      have hv : v = v.1 • ((1 : ℂ), (0 : ℂ)) + v.2 • ((0 : ℂ), (1 : ℂ)) := by ext <;> simp
      conv_rhs => rw [hv]
      rw [map_add, map_smul, map_smul, ← hd1, ← hd2]
      simp [smul_eq_mul, mul_comm]
    let a₁₁ : ℂ × ℂ → ℂ := iterDerivYT 1 0 Φ₁
    let a₁₂ : ℂ × ℂ → ℂ := iterDerivYT 0 1 Φ₁
    let a₂₁ : ℂ × ℂ → ℂ := iterDerivYT 1 0 Φ₂
    let a₂₂ : ℂ × ℂ → ℂ := iterDerivYT 0 1 Φ₂
    let Δ_Φ : ℂ × ℂ → ℂ := fun p => a₁₁ p * a₂₂ p - a₁₂ p * a₂₁ p
    let E₁₁ : (ℂ × ℂ) →L[ℂ] (ℂ × ℂ) :=
      (ContinuousLinearMap.inl ℂ ℂ ℂ).comp (ContinuousLinearMap.fst ℂ ℂ ℂ)
    let E₁₂ : (ℂ × ℂ) →L[ℂ] (ℂ × ℂ) :=
      (ContinuousLinearMap.inl ℂ ℂ ℂ).comp (ContinuousLinearMap.snd ℂ ℂ ℂ)
    let E₂₁ : (ℂ × ℂ) →L[ℂ] (ℂ × ℂ) :=
      (ContinuousLinearMap.inr ℂ ℂ ℂ).comp (ContinuousLinearMap.fst ℂ ℂ ℂ)
    let E₂₂ : (ℂ × ℂ) →L[ℂ] (ℂ × ℂ) :=
      (ContinuousLinearMap.inr ℂ ℂ ℂ).comp (ContinuousLinearMap.snd ℂ ℂ ℂ)
    let L_Φ : ℂ × ℂ → (ℂ × ℂ) →L[ℂ] (ℂ × ℂ) := fun p =>
      a₁₁ p • E₁₁ + a₁₂ p • E₁₂ + a₂₁ p • E₂₁ + a₂₂ p • E₂₂
    have hΦ_fderiv : ∀ p ∈ W₀, HasFDerivAt Φ (L_Φ p) p := by
      intro p hp
      have h1 := h_fderiv_2d hΦ₁_holo p hp
      have h2 := h_fderiv_2d hΦ₂_holo p hp
      convert h1.prodMk h2 using 1
      apply ContinuousLinearMap.ext
      intro v
      ext <;> simp [L_Φ, E₁₁, E₁₂, E₂₁, E₂₂, a₁₁, a₁₂, a₂₁, a₂₂]
    have ha₁₁_cont : ContinuousOn a₁₁ W₀ := (B.iterDerivYT_holo hW₀_open hΦ₁_holo 1 0).continuousOn
    have ha₁₂_cont : ContinuousOn a₁₂ W₀ := (B.iterDerivYT_holo hW₀_open hΦ₁_holo 0 1).continuousOn
    have ha₂₁_cont : ContinuousOn a₂₁ W₀ := (B.iterDerivYT_holo hW₀_open hΦ₂_holo 1 0).continuousOn
    have ha₂₂_cont : ContinuousOn a₂₂ W₀ := (B.iterDerivYT_holo hW₀_open hΦ₂_holo 0 1).continuousOn
    have hL_Φ_cont : ContinuousOn L_Φ W₀ :=
      (((ha₁₁_cont.smul continuousOn_const).add (ha₁₂_cont.smul continuousOn_const)).add
        (ha₂₁_cont.smul continuousOn_const)).add (ha₂₂_cont.smul continuousOn_const)
    have hΔ_cont : ContinuousOn Δ_Φ W₀ :=
      (ha₁₁_cont.mul ha₂₂_cont).sub (ha₁₂_cont.mul ha₂₁_cont)
    have hΦ_strict : ∀ p ∈ W₀, HasStrictFDerivAt Φ (L_Φ p) p := by
      intro p hp
      exact hasStrictFDerivAt_of_hasFDerivAt_of_continuousAt
        (Filter.eventually_of_mem (hW₀_open.mem_nhds hp) hΦ_fderiv)
        (hL_Φ_cont.continuousAt (hW₀_open.mem_nhds hp))
    let cramerEquiv : ∀ p : ℂ × ℂ, Δ_Φ p ≠ 0 → (ℂ × ℂ) ≃L[ℂ] (ℂ × ℂ) := fun p hΔ =>
      let adj_Φ : (ℂ × ℂ) →L[ℂ] (ℂ × ℂ) :=
        a₂₂ p • E₁₁ + (-a₁₂ p) • E₁₂ + (-a₂₁ p) • E₂₁ + a₁₁ p • E₂₂
      let L_inv : (ℂ × ℂ) →L[ℂ] (ℂ × ℂ) := (Δ_Φ p)⁻¹ • adj_Φ
      ContinuousLinearEquiv.equivOfInverse (L_Φ p) L_inv
