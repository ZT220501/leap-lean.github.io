            rw [abs_le]
            have h1 : -(1 / 2 : ℝ) ≤ u_re / Δ_k - (q : ℝ) := by linarith
            have h2 : u_re / Δ_k - (q : ℝ) ≤ 1 / 2 := by linarith
            have heq : u_re - (q : ℝ) * Δ_k = (u_re / Δ_k - (q : ℝ)) * Δ_k := by field_simp
            rw [heq]
            constructor <;> nlinarith
          rw [hre_eq, abs_mul, abs_of_pos hℓ_pos]
          calc ℓ_seq j * |u_re - (q : ℝ) * Δ_k|
              ≤ ℓ_seq j * ((1 / 2 : ℝ) * Δ_k) := by gcongr
            _ = (3 / 8 : ℝ) * R_k := by dsimp only [Δ_k, R_k]; ring
