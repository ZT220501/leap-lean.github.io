      have hev_id : (fun z' => v (z', 0)) =ᶠ[nhds z₀] id := by
        filter_upwards [Metric.ball_mem_nhds z₀ hr₁_pos] with z' hz'
        rw [Metric.mem_ball, dist_eq_norm] at hz'
        exact hv_zero z' (lt_of_lt_of_le hz' hr₁_le_2rZ)
      rw [hev_id.deriv_eq, deriv_id]
    have hcoeff0_vA : MvPowerSeries.coeff 0 (mvDerivA Φ_v) = 1 := by
      rw [(hmv_taylor hW₁_open hp₀_W₁ hv_W₁).1]
      change iterDerivYT 0 0 (pderivA v) (z₀, 0) / (((0 : ℕ).factorial : ℂ) * ((0 : ℕ).factorial : ℂ)) = 1
