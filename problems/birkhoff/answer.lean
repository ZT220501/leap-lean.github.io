    have hKi_bound : ∃ B_K : ℝ, ∀ y ∈ Ω_reg, ∀ z ∈ Metric.closedBall y (ρ y), ‖K_i y z‖ ≤ B_K := by
      refine ⟨S.H, fun y hy z hz => ?_⟩
      have hnorm : ‖z - y‖ ≤ ρ y := by simpa [Metric.mem_closedBall, dist_eq_norm] using hz
      have hSmall := hAdm.small_shape_step y hy (z - y) hnorm i
      rw [add_sub_cancel] at hSmall
