            have h_mesh_P := hMesh (2 * α) (D (j + 2)) t.im j (by linarith) hDj2_pos htim_pos
            have h_tail_sum : ∑ m ∈ Finset.range j, ‖t * (J_step (m + 1) - 1)‖ ≤
                (C_J * (1 / ((2 * α - 1) * γ_steep))) * B ^ 2 * ‖t‖ ^ 2 *
                  (D (j + 2)) ^ (1 - 2 * α) := by
              calc ∑ m ∈ Finset.range j, ‖t * (J_step (m + 1) - 1)‖
                  ≤ ∑ m ∈ Finset.range j,
                      ‖t‖ * (C_J * B ^ 2 * ‖t‖ ^ 2 * (D (m + 2)) ^ (-2 * α)) := by
                    refine Finset.sum_le_sum (fun m hm => ?_)
                    rw [norm_mul]
                    exact mul_le_mul_of_nonneg_left
