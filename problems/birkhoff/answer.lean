            _ = ((2 : ℝ) ^ 2) ^ i := by rw [mul_comm, pow_mul]
            _ = (4 : ℝ) ^ i := by norm_num
        rw [this, ← _root_.inv_pow]
        ring
      have hstep_le : G.C_step * (1 + (N_seq i : ℝ) + (δ i)⁻¹) ^ B₀ * ε_bar i ≤ stepBound i := by
        calc G.C_step * (1 + (N_seq i : ℝ) + (δ i)⁻¹) ^ B₀ * ε_bar i
            ≤ G.C_step * (K_B ^ B₀ * R_i ^ (2 * B₀)) * ε_bar i :=
              mul_le_mul_of_nonneg_right
                (mul_le_mul_of_nonneg_left hQ_pow hC_pos.le) hε_pos.le
          _ = G.C_step * K_B ^ B₀ * (R_i ^ (2 * B₀) * ε_bar i) := by ring
          _ = stepBound i := by dsimp [stepBound]; rw [hR_ε_eq]; ring
      have hsb_le_small : stepBound i ≤ G.c_small := by
        dsimp [stepBound]
        have h1 : (1 / 4 : ℝ) ^ i ≤ 1 := pow_le_one₀ (by norm_num) (by norm_num)
        have h2 : G.C_step * K_B ^ B₀ * d₀ ^ 2 * (1 / 4 : ℝ) ^ i ≤ G.C_step * K_B ^ B₀ * d₀ ^ 2 := by
          have : 0 ≤ G.C_step * K_B ^ B₀ * d₀ ^ 2 := by positivity
          nlinarith
        have h3 : c_min ≤ G.c_small := min_le_left _ _
        linarith
      have hquad_le :
          G.C_step * (1 + (N_seq i : ℝ) + (δ i)⁻¹) ^ B₀ * (ε_bar i) ^ 2 ≤ ε_bar (i + 1) := by
        have hε_succ : ε_bar (i + 1) = ε_bar i / (2 : ℝ) ^ A_exp := by
          dsimp [ε_bar]
          rw [pow_succ (2 : ℝ) i, ← div_div, div_pow]
        calc G.C_step * (1 + (N_seq i : ℝ) + (δ i)⁻¹) ^ B₀ * (ε_bar i) ^ 2
            = (G.C_step * (1 + (N_seq i : ℝ) + (δ i)⁻¹) ^ B₀ * ε_bar i) * ε_bar i := by ring
          _ ≤ stepBound i * ε_bar i := mul_le_mul_of_nonneg_right hstep_le hε_pos.le
          _ = (G.C_step * K_B ^ B₀ * (2 : ℝ) ^ A_exp * d₀ ^ 2 * (1 / 4 : ℝ) ^ i) *
                (ε_bar i / (2 : ℝ) ^ A_exp) := by
              dsimp [stepBound]
              have h2A_ne : ((2 : ℝ) ^ A_exp) ≠ 0 := by positivity
              field_simp [h2A_ne]
          _ ≤ 1 * (ε_bar i / (2 : ℝ) ^ A_exp) := by
              refine mul_le_mul_of_nonneg_right ?_ (by positivity)
              have h1 : (1 / 4 : ℝ) ^ i ≤ 1 := pow_le_one₀ (by norm_num) (by norm_num)
              have h2 : 0 ≤ G.C_step * K_B ^ B₀ * (2 : ℝ) ^ A_exp * d₀ ^ 2 := by positivity
              nlinarith
          _ = ε_bar (i + 1) := by rw [one_mul, hε_succ]
      exact ⟨hδ_pos, hδ_lt_d, hε_pos, hε_lt1, hN_ge1, hexp_le, hstep_le, hsb_le_small, hquad_le⟩
    let IterGood : ℕ → (ℂ × ℂ → ℂ) → Prop := fun i U =>
      IsAdmissibleGlancingCand (s_seq i) (d_seq i) (η_seq i) U ∧
