        have hsq : ‖s - c_jkq‖ ^ 2 ≤ (r_jk j k) ^ 2 := by
          rw [Complex.sq_norm, Complex.normSq_apply]
          rcases abs_le.mp hre_diff with ⟨hr1, hr2⟩
          rcases abs_le.mp him_diff with ⟨hi1, hi2⟩
          have hrjk_eq : r_jk j k = (5 / 8 : ℝ) * R_k := by dsimp only [r_jk, R_k]; ring
          rw [hrjk_eq]
