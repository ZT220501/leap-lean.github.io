    have h_strict : 0 < η * (r ^ 2 / 2) := by positivity
    dsimp [D_η] at h_ca_D_le
    linarith
  exact ⟨⟨B_U, hB_U_nonneg, fun w hw => ⟨h_majorize w hw, hU_le_BU w hw⟩⟩,
    hU_per, hU_real_mean, ⟨F_ext, hF_ext_holo, hU_eq_re⟩⟩

 have h_part5 : StripAngleAndAmplitudeData S hBudget P := by
