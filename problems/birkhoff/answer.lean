      rw [Filter.eventually_atTop] at h_ev ⊢
      obtain ⟨D_0, hD_0⟩ := h_ev
      refine ⟨D_0 + m, fun k hk z hz => ?_⟩
      have hk_eq : k = (k - m) + m := (Nat.sub_add_cancel (by omega)).symm
      rw [hk_eq, hψ_shift (k - m)]
      exact hD_0 (k - m) (by omega) z hz
    let u_star : ℂ → ℂ := fun Y => Filter.limUnder Filter.atTop (fun k => u_fn (φ₁ (ψ k)) Y)
    let S_star : ℂ → ℂ := fun Y => Y + u_star Y
    have hS_unif_Km : ∀ m : ℕ,
