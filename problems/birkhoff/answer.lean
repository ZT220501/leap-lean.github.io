    induction β with
    | zero =>
      simpa [webDiffCoeff]
    | succ β ih =>
      rw [Function.iterate_succ_apply', ih, hmvD_sum]
      have hlhs :
          (∑ k ∈ Finset.range (α + β + 1),
            mvDerivD (taylor2D (webDiffCoeff (pderivA (ψ i)) (pderivD (ψ i)) (w i) α β k) p₁ *
              F k)) =
          (∑ k ∈ Finset.range (α + β + 1),
            taylor2D (pderivD (webDiffCoeff (pderivA (ψ i)) (pderivD (ψ i)) (w i) α β k)) p₁ *
              F k) +
