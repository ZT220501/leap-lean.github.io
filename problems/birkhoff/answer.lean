        rw [h_eq_N, circleIntegral]
        congr 1
        refine intervalIntegral.integral_congr fun θ _ => ?_
        have hN_cir : N_puis ι (p.1, γ θ) = (γ θ) ^ K_p * M_puis ι (p.1, γ θ) := by
