    have hpD_sub : pderivD (fun p => ψ i p - ψ i p₁) = pderivD (ψ i) := by
      ext p
      exact deriv_sub_const (f := fun z : ℂ => ψ i (p.1, z)) (ψ i p₁)
    have hmvΨ := hKit.mvDeriv_rules.2 hU₀ hp₁_0 hψ_sub
