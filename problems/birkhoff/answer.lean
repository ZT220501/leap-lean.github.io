                  ((ε ^ j * ε ^ (l - 1)) * W_Δ ε *
                    ∑ q ∈ Finset.range j, D_A ε ^ q * dslope B 0 ε ^ (j - 1 - q)) := by ring
            _ = ε ^ (l + 1) * (lineCoalescingDslopeIter F z₀ j z₀ *
                  (ε ^ (j - 2) * W_Δ ε *
                    ∑ q ∈ Finset.range j, D_A ε ^ q * dslope B 0 ε ^ (j - 1 - q))) := by
                rw [hpow_j]; ring
        have h_rem_diff :
            (A ε - z₀) ^ (l + 1) * R_rem (A ε) - (B ε - z₀) ^ (l + 1) * R_rem (B ε) =
            ε ^ (l + 1) * ((D_A ε) ^ (l + 1) * R_rem (A ε) - (dslope B 0 ε) ^ (l + 1) * R_rem (B ε)) := by
          rw [hA_sub, hB_sub, mul_pow, mul_pow]
          ring
        have h_lin_diff :
            deriv F z₀ * (A ε - z₀) ^ 1 - deriv F z₀ * (B ε - z₀) ^ 1 =
            (deriv F z₀ * c) * ε ^ l + ε ^ (l + 1) * (deriv F z₀ * Ψ ε) := by
          have hAB : (A ε - z₀) ^ 1 - (B ε - z₀) ^ 1 = c * ε ^ l + ε ^ (l + 1) * Ψ ε := by
            rw [pow_one, pow_one]
