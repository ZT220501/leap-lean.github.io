      let r' : ℝ := (r + I.v_c) / 2
      have hr'_ico : r' ∈ Set.Ico (0 : ℝ) I.v_c :=
        ⟨by dsimp [r']; linarith [hr.1, I.v_c_pos], by dsimp [r']; linarith [hr.2]⟩
