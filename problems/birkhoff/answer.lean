            linarith [hno_exit (η_pure N_cap om) hmem]
        rw [hA_eq]
        refine hEvBiUnion (Finset.range (n + 1)) fun t₀ ht₀ => ?_
        have ht₀_le : t₀ ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp ht₀)
        refine hEvInter (hEvInter (hT_eq_ev t₀ ht₀_le) ?_) ?_
        · refine hEvBiInter (Finset.Ico t₀ (n + 1)) fun m hm => ?_
