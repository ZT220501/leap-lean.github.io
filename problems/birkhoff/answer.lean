          ring
        have hSy_d : HasDerivAt (fun t' => S_y x t') (S_yy x t) t := by
          convert ((((hz_re.neg).mul hw_im).add (hz_im.mul hw_re)).const_mul 2) using 1
          dsimp [S_yy]
          ring
        have hu_d : HasDerivAt (fun t' => u x t') (u_y x t) t := by
          convert ((hS_d.log (hS_pos x t).ne').const_mul (1 / 2 : ℝ)) using 1
          dsimp [u_y]
          ring
        have huy_d : HasDerivAt (fun t' => u_y x t') (u_yy x t) t := by
          have h2S_ne : 2 * S x t ≠ 0 := by linarith [hS_pos x t]
          convert hSy_d.div (hS_d.const_mul 2) h2S_ne using 1
          have hne : S x t ≠ 0 := (hS_pos x t).ne'
          dsimp [u_yy]
          field_simp [hne]
        exact ⟨hu_d, huy_d⟩
      have h_lap_nonneg : ∀ x t : ℝ, 0 ≤ u_xx x t + u_yy x t := by
        intro x t
        have h_id : u_xx x t + u_yy x t =
