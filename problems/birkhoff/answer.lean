      0 ≤ M_G →
      0 ≤ B →
      DifferentiableOn ℂ G V →
      (∀ j : ℕ, j ≤ p → ∀ w ∈ V, ‖iteratedDeriv j G w‖ ≤ M_G) →
      DifferentiableOn ℂ f (horizStrip σ') →
      (∀ z ∈ horizStrip σ', f z ∈ V) →
      (∀ j : ℕ, 1 ≤ j → j ≤ p → ∀ z ∈ horizStrip σ', ‖iteratedDeriv j f z‖ ≤ B) →
      IsStripBounded p σ' (M_G * shjCompConst p B) (fun z => G (f z)) := by
    intro p σ' M_G B V G f hV_open hM_G hB hG_diff hG_bnd hf_diff hf_maps hf_bnd
    induction p generalizing M_G G with
    | zero =>
