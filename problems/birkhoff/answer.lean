          dsimp only [f_full]; rw [hΔψ_all0 i]
        rw [h_eq]
        exact h_all_f0 l hl i
      rw [hLift.jetSeq_eq_C_of_zero_shift (A_jet i) h_seq0 m, hLift_const]
    have hr₀_mem : E.coreTuple r₀ ∈ E.F_val :=
      Subfield.subset_closure (Or.inr ⟨r₀, rfl⟩)
    have h_lift_r₀ : lineRecLiftArcFn E.F_val Φ (E.coreTuple r₀) =
        PowerSeries.C (E.coreTuple r₀) := by
      have h_mem_core := E.core_entries_subset ⟨r₀, rfl⟩
      rcases h_mem_core with ⟨r, hr_cs | hr_sn⟩ | ⟨i, m, him⟩
      · rw [hr_cs]; exact (hCS_const r).1
      · rw [hr_sn]; exact (hCS_const r).2
      · rw [him]; exact hA_const i m
    unfold lineRecLiftArcFn at h_lift_r₀
    rw [dif_pos hr₀_mem] at h_lift_r₀
    exact hr₀_ne h_lift_r₀
  classical
  let p_min : ℕ := Nat.find h_exists_p
  have hp_spec : 1 ≤ p_min ∧ ∃ i : Fin k, f_full i p_min ≠ 0 := Nat.find_spec h_exists_p
  let i₀ : Fin k := Classical.choose hp_spec.2
  have hi₀_ne : f_full i₀ p_min ≠ 0 := Classical.choose_spec hp_spec.2
  have h_vanish_lt : ∀ l : ℕ, 1 ≤ l → l < p_min →
      (∀ i : Fin k, f_full i l = 0) ∧ (∀ r : Fin (k + 1), β_full l r = 0) ∧ K_seq l = 0 := by
    have hf_lt : ∀ m : ℕ, 1 ≤ m → m ≤ p_min - 1 → ∀ i : Fin k, f_full i m = 0 := by
      intro m hm1 hm_le i
      have hm_lt : m < p_min := by have := hp_spec.1; omega
      have hnot := Nat.find_min h_exists_p hm_lt
      by_contra hne
      exact hnot ⟨hm1, i, hne⟩
    intro l hl1 hlt
    have hl_le : l ≤ p_min - 1 := by omega
    exact ⟨hf_lt l hl1 hl_le, (h_sub_vanish (p_min - 1) hf_lt l hl1 hl_le).1,
      (h_sub_vanish (p_min - 1) hf_lt l hl1 hl_le).2⟩
  exact ⟨{
    p := p_min
    p_pos := hp_spec.1
    i₀ := i₀
    f_full := f_full
    β_full := β_full
    K_seq := K_seq
    f_zero := hf_zero
    β_zero := hβ_zero
    β_endpoints := hβ_end
    f_lead_ne_zero := hi₀_ne
    vanish_lt_p := h_vanish_lt
    formal_web_step := h_web_step
    formal_hess_step := h_hess_step
  }⟩

theorem line_arc_single_step_web_continuation (Ω : Set Plane)
    (C : AnalyticGlancingCollar Ω)
    (B : BaseCollarAndCramerData C)
    (k : ℕ) (hk : 2 ≤ k)
    (G : LineGlancingChartData C B k)
    (a₁ δ₁ : ℝ)
    (ha₁ : a₁ ∈ Set.Ioo (G.a₀ - G.R / 4) (G.a₀ + G.R / 4))
    (hδ₁ : δ₁ ∈ Set.Ioo 0 G.δ_star)
    (hJet : LineArcJetAndTaylorToolkit)
    (hWeb : FiniteWebContinuationProp)
    (D_form : LineArcFormalDeformationData C B k G a₁ δ₁)
    (J : ℕ) (hJp : D_form.p ≤ J + 1)
    (S : LineArcStepAnalyticData C B k G a₁ δ₁ D_form J) :
    ∃ S' : LineArcStepAnalyticData C B k G a₁ δ₁ D_form (J + 1),
      ∀ (i : Fin k) (m : Fin (J + 1)), S'.g i m.castSucc = S.g i m :=
by
  
  let p₁ : ℂ × ℂ := ((a₁ : ℂ), (δ₁ : ℂ))
  let U₀ : Set (ℂ × ℂ) := G.U_a ×ˢ G.U_d
  have hU₀_open : IsOpen U₀ := Metric.isOpen_ball.prod Metric.isOpen_ball
  have ha₁_abs : |a₁ - G.a₀| < G.R / 4 :=
    abs_lt.mpr ⟨by linarith [ha₁.1], by linarith [ha₁.2]⟩
  have ha₁_trap_bound : |a₁ - G.a₀| < G.R - G.C₀ * G.δ_star := by
    linarith [G.C₀_δ_star_lt, G.R_pos]
  have hq₁_trap : (a₁, δ₁) ∈ webTrapezoid G.a₀ G.R G.δ_star G.C₀ := by
    refine ⟨hδ₁.1, hδ₁.2, ?_⟩
    have hCδ : G.C₀ * δ₁ < G.C₀ * G.δ_star := mul_lt_mul_of_pos_left hδ₁.2 G.C₀_pos
    linarith
  have hp₁_S : p₁ ∈ S.V_plus := S.trapezoid_mem_V_plus (a₁, δ₁) hq₁_trap
  have hU₀_base : ∀ q ∈ webBaseClosure G.a₀ G.R G.δ_star, ((q.1 : ℂ), (q.2 : ℂ)) ∈ U₀ := by
    intro q hq
    refine ⟨?_, ?_⟩
    · rw [LineGlancingChartData.U_a, Metric.mem_ball, Complex.dist_eq, ← Complex.ofReal_sub,
        Complex.norm_real, Real.norm_eq_abs]
      linarith [hq.2.2, G.R_pos]
    · rw [LineGlancingChartData.U_d, Metric.mem_ball, dist_zero_right, Complex.norm_real,
        Real.norm_eq_abs, abs_of_nonneg hq.1]
      linarith [hq.2.1, G.δ_star_pos]
  have hinv2_U₀ : DifferentiableOn ℂ (fun _ : ℂ × ℂ => (2 : ℂ)⁻¹) U₀ :=
    differentiableOn_const (2 : ℂ)⁻¹
  have hψ_holo : ∀ i : Fin k, DifferentiableOn ℂ (G.ψ_fn i) U₀ := by
    intro i
    have h1 : DifferentiableOn ℂ (fun q : ℂ × ℂ => lineChartAlpha C k G.Ψ i.castSucc q) U₀ :=
      G.α_holo i.castSucc
    have h2 : DifferentiableOn ℂ (fun q : ℂ × ℂ => lineChartAlpha C k G.Ψ i.succ q) U₀ :=
      G.α_holo i.succ
    exact ((h1.add h2).mul hinv2_U₀).congr fun q _ => by
      change (lineChartAlpha C k G.Ψ i.castSucc q + lineChartAlpha C k G.Ψ i.succ q) / 2 = _
      exact div_eq_mul_inv _ 2
  have hd_holo : ∀ i : Fin k, DifferentiableOn ℂ (G.d_fn i) U₀ := by
    intro i
    have h1 : DifferentiableOn ℂ (fun q : ℂ × ℂ => lineChartAlpha C k G.Ψ i.succ q) U₀ :=
      G.α_holo i.succ
    have h2 : DifferentiableOn ℂ (fun q : ℂ × ℂ => lineChartAlpha C k G.Ψ i.castSucc q) U₀ :=
      G.α_holo i.castSucc
    exact ((h1.sub h2).mul hinv2_U₀).congr fun q _ => by
      change (lineChartAlpha C k G.Ψ i.succ q - lineChartAlpha C k G.Ψ i.castSucc q) / 2 = _
      exact div_eq_mul_inv _ 2
  have hw_holo_U₀ : ∀ i : Fin k, DifferentiableOn ℂ (G.w_fn i) U₀ := by
    intro i
    exact ((differentiableOn_const (2 : ℂ)).mul
      (Complex.differentiable_sin.comp_differentiableOn (hd_holo i))).congr fun _ _ => rfl

  
  have hh_S : DifferentiableOn ℂ C.h_ℂ S.W_ψ := C.h_ℂ_holo.mono S.W_ψ_sub_strip
  have hg0_S : ∀ (i : Fin k) (z : ℂ), S.g i 0 z = 0 :=
    fun i z => S.g_lt_p i 0 (by have := D_form.p_pos; simp; omega) z
  have hα_S : ∀ s : Fin (k + 1), DifferentiableOn ℂ (G.α_fn s) S.V_plus :=
    fun s => (G.α_holo s).mono S.V_plus_sub
  let B_act : ℂ × ℂ → ℂ := fun q =>
    lineArcEpsJet (J + 1)
      (fun ε =>
        lineChainAction (lineArcPertSupport C.h_ℂ S.g ε)
          (lineArcPertAngles (fun s => G.α_fn s q) (fun m s => S.β m s q) ε))
  let B_rhs : ℂ × ℂ → ℂ := fun q => D_form.K_seq (J + 1) - B_act q
  have hB_act_holo : DifferentiableOn ℂ B_act S.V_plus :=
    (hJet.epsJet_holo (J + 1) S.W_ψ_open S.V_plus_open hh_S S.g_holo hg0_S
      hα_S S.ψ_maps_W_ψ S.β_holo S.β_zero).1
  have hB_rhs_holo : DifferentiableOn ℂ B_rhs S.V_plus :=
    (differentiableOn_const (D_form.K_seq (J + 1))).sub hB_act_holo
  have hB_act_taylor :
      taylor2D B_act p₁ =
        lineArcSlice2D1D (J + 1)
          (lineArcFormalAction2D1D
            (fun i => Complex.sin (G.d_fn i p₁))
            (fun i => Complex.cos (G.d_fn i p₁))
            (lineArcTruncSupport J D_form.f_full)
            (lineArcTruncBeta J D_form.β_full)) := by
    have ht := (hJet.taylor2D_epsJet_eq (J + 1) S.W_ψ_open S.V_plus_open hp₁_S
      hh_S S.g_holo hg0_S hα_S S.ψ_maps_W_ψ S.β_holo S.β_zero).1
    have hf_eq :
        (fun (i : Fin k) (l : ℕ) =>
          if l = 0 then lineArcHoloTaylor1D C.h_ℂ (lineChainMid (fun s => G.α_fn s p₁) i)
          else if hl : l < J + 1 then
            lineArcHoloTaylor1D (S.g i ⟨l, hl⟩) (lineChainMid (fun s => G.α_fn s p₁) i)
          else 0) = lineArcTruncSupport J D_form.f_full := by
      funext i l
      unfold lineArcTruncSupport
      by_cases hl0 : l = 0
      · subst hl0
        simp only [↓reduceIte, Nat.zero_le]
        exact (D_form.f_zero i).symm
      · by_cases hl : l < J + 1
        · have hl_le : l ≤ J := by omega
          have hl_ge1 : 1 ≤ (⟨l, hl⟩ : Fin (J + 1)).1 := by simp; omega
          simp only [hl0, ↓reduceIte, hl, ↓reduceDIte, hl_le]
          exact S.g_taylor i ⟨l, hl⟩ hl_ge1
        · have hl_nle : ¬ l ≤ J := by omega
          simp [hl0, hl, hl_nle]
    have hβ_eq :
        (fun (l : ℕ) (s : Fin (k + 1)) =>
          if l = 0 then centeredTaylor2D (G.α_fn s) p₁
          else if hl : l < J + 1 then taylor2D (S.β ⟨l, hl⟩ s) p₁
          else 0) = lineArcTruncBeta J D_form.β_full := by
      funext l s
      unfold lineArcTruncBeta
      by_cases hl0 : l = 0
      · subst hl0
        simp only [↓reduceIte, Nat.zero_le]
        exact (D_form.β_zero s).symm
      · by_cases hl : l < J + 1
        · have hl_le : l ≤ J := by omega
          have hl_ge1 : 1 ≤ (⟨l, hl⟩ : Fin (J + 1)).1 := by simp; omega
          simp only [hl0, ↓reduceIte, hl, ↓reduceDIte, hl_le]
          exact S.β_taylor ⟨l, hl⟩ s hl_ge1
        · have hl_nle : ¬ l ≤ J := by omega
          simp [hl0, hl, hl_nle]
    rw [hf_eq, hβ_eq] at ht
    exact ht
  have h_web_formal :
      ∑ i : Fin k,
        taylor2D (G.w_fn i) p₁ *
          compPowerSeries2D (D_form.f_full i (J + 1)) (centeredTaylor2D (G.ψ_fn i) p₁) =
        taylor2D B_rhs p₁ := by
    have hsub : taylor2D B_rhs p₁ =
        MvPowerSeries.C (D_form.K_seq (J + 1)) - taylor2D B_act p₁ := by
      rw [(hJet.taylor2D_ring S.V_plus_open hp₁_S
        (differentiableOn_const (D_form.K_seq (J + 1))) hB_act_holo).2.1,
        hJet.taylor2D_const p₁ (D_form.K_seq (J + 1))]
    rw [hsub, ← D_form.formal_web_step J, hB_act_taylor, add_sub_cancel_left]
  obtain ⟨W_new, V_new, g_new, hW_new_open, _hW_new_preconn, hW_new_real,
      hV_new_open, _hV_new_preconn, _hV_new_sub_U₀, hV_new_sub_S, hV_new_trap,
      hg_new_holo, hg_new_taylor_coeff, hg_new_eq⟩ :=
    hWeb k (by omega) G.a₀ G.R G.δ_star G.C₀ G.R_pos G.δ_star_pos G.C₀_pos G.C₀_δ_star_lt
      U₀ S.V_plus hU₀_open S.V_plus_open hU₀_base S.trapezoid_mem_V_plus
      G.ψ_fn G.w_fn B_rhs hψ_holo (fun i => (hw_holo_U₀ i).mono S.V_plus_sub) hB_rhs_holo
      G.ψ_web_base (fun q hq => ⟨(G.trapezoid_nondeg q hq).1, (G.trapezoid_nondeg q hq).2.1⟩)
      a₁ δ₁ hδ₁.1 hδ₁.2 ha₁_trap_bound (fun i => D_form.f_full i (J + 1)) h_web_formal
  have hg_new_taylor : ∀ i : Fin k,
      lineArcHoloTaylor1D (g_new i) (G.ψ_fn i p₁) = D_form.f_full i (J + 1) := by
    intro i
    ext n
    rw [lineArcHoloTaylor1D, holoTaylor1D, PowerSeries.coeff_mk]
    exact (hg_new_taylor_coeff i).2 n

  
  let W_int : Set ℂ := W_new ∩ S.W_ψ
  have hW_int_open : IsOpen W_int := hW_new_open.inter S.W_ψ_open
  let W_ψ' : Set ℂ := connectedComponentIn W_int (G.a₀ : ℂ)
  have hW_ψ'_open : IsOpen W_ψ' := hW_int_open.connectedComponentIn
  have hW_ψ'_preconn : IsPreconnected W_ψ' := isPreconnected_connectedComponentIn
  have hW_ψ'_sub_int : W_ψ' ⊆ W_int := connectedComponentIn_subset W_int (G.a₀ : ℂ)
  have hW_ψ'_sub_new : W_ψ' ⊆ W_new := fun _ hz => (hW_ψ'_sub_int hz).1
  have hW_ψ'_sub_S : W_ψ' ⊆ S.W_ψ := fun _ hz => (hW_ψ'_sub_int hz).2
  have hW_ψ'_sub_strip : W_ψ' ⊆ horizStrip (2 * C.s_h) :=
    hW_ψ'_sub_S.trans S.W_ψ_sub_strip
  have hW_ψ'_real : ∀ x : ℝ, |x - G.a₀| < G.R → (x : ℂ) ∈ W_ψ' := by
    let I_R : Set ℝ := Set.Ioo (G.a₀ - G.R) (G.a₀ + G.R)
    have hI_preconn : IsPreconnected ((fun x : ℝ => (x : ℂ)) '' I_R) :=
      (convex_Ioo (G.a₀ - G.R) (G.a₀ + G.R)).isPreconnected.image _
        Complex.continuous_ofReal.continuousOn
    have ha₀_mem : (G.a₀ : ℂ) ∈ (fun x : ℝ => (x : ℂ)) '' I_R :=
      ⟨G.a₀, ⟨by linarith [G.R_pos], by linarith [G.R_pos]⟩, rfl⟩
    have hI_sub : (fun x : ℝ => (x : ℂ)) '' I_R ⊆ W_int := by
      rintro _ ⟨x, hx, rfl⟩
      have hx_abs : |x - G.a₀| < G.R := abs_lt.mpr ⟨by linarith [hx.1], by linarith [hx.2]⟩
      exact ⟨hW_new_real x hx_abs, S.real_mem_W_ψ x hx_abs⟩
    have hsub := hI_preconn.subset_connectedComponentIn ha₀_mem hI_sub
    intro x hx
    rcases abs_lt.mp hx with ⟨hx1, hx2⟩
    exact hsub ⟨x, ⟨by linarith, by linarith⟩, rfl⟩
  have h_spine : ∀ q ∈ webTrapezoid G.a₀ G.R G.δ_star G.C₀, ∀ i : Fin k,
      G.ψ_fn i ((q.1 : ℂ), (q.2 : ℂ)) ∈ W_ψ' := by
    intro q hq i
    have hpos : 0 < G.C₀ * q.2 := mul_pos G.C₀_pos hq.1
    have hq1_abs : |q.1 - G.a₀| < G.R := by linarith [hq.2.2]
    have hq1_W' : (q.1 : ℂ) ∈ W_ψ' := hW_ψ'_real q.1 hq1_abs
    have hcomp_eq : W_ψ' = connectedComponentIn W_int (q.1 : ℂ) :=
      connectedComponentIn_eq hq1_W'
    let γ : ℝ → ℂ := fun t => G.ψ_fn i ((q.1 : ℂ), (t : ℂ))
    have hγ_maps_U₀ : Set.MapsTo (fun t : ℝ => ((q.1 : ℂ), (t : ℂ))) (Set.Icc 0 q.2) U₀ := by
      intro t ht
      refine ⟨?_, ?_⟩
      · rw [LineGlancingChartData.U_a, Metric.mem_ball, Complex.dist_eq, ← Complex.ofReal_sub,
          Complex.norm_real, Real.norm_eq_abs]
        linarith [G.R_pos]
      · rw [LineGlancingChartData.U_d, Metric.mem_ball, dist_zero_right, Complex.norm_real,
          Real.norm_eq_abs, abs_of_nonneg ht.1]
        linarith [ht.2, hq.2.1, G.δ_star_pos]
    have hγ_cont : ContinuousOn γ (Set.Icc 0 q.2) :=
      (hψ_holo i).continuousOn.comp
        (continuous_const.prodMk Complex.continuous_ofReal).continuousOn hγ_maps_U₀
    have hΓ_preconn : IsPreconnected (γ '' Set.Icc 0 q.2) :=
      (convex_Icc 0 q.2).isPreconnected.image γ hγ_cont
    have hγ0 : γ 0 = (q.1 : ℂ) := by
      change (lineChartAlpha C k G.Ψ i.castSucc ((q.1 : ℂ), ((0 : ℝ) : ℂ)) +
        lineChartAlpha C k G.Ψ i.succ ((q.1 : ℂ), ((0 : ℝ) : ℂ))) / 2 = (q.1 : ℂ)
      rw [Complex.ofReal_zero, (G.α_at_zero i.castSucc q.1 hq1_abs).1,
        (G.α_at_zero i.succ q.1 hq1_abs).1]
      ring
    have hq1_mem_Γ : (q.1 : ℂ) ∈ γ '' Set.Icc 0 q.2 :=
      ⟨0, ⟨le_rfl, le_of_lt hq.1⟩, hγ0⟩
    have hΓ_sub : γ '' Set.Icc 0 q.2 ⊆ W_int := by
      rintro _ ⟨t, ht, rfl⟩
      rcases eq_or_lt_of_le ht.1 with rfl | ht_pos
      · rw [hγ0]
        exact hW_ψ'_sub_int hq1_W'
      · have hqt_trap : (q.1, t) ∈ webTrapezoid G.a₀ G.R G.δ_star G.C₀ := by
          refine ⟨ht_pos, lt_of_le_of_lt ht.2 hq.2.1, ?_⟩
          have hCt : G.C₀ * t ≤ G.C₀ * q.2 :=
            mul_le_mul_of_nonneg_left ht.2 (le_of_lt G.C₀_pos)
          linarith [hq.2.2]
        exact ⟨(hg_new_eq ((q.1 : ℂ), (t : ℂ)) (hV_new_trap (q.1, t) hqt_trap)).1 i,
          S.ψ_maps_W_ψ ((q.1 : ℂ), (t : ℂ)) (S.trapezoid_mem_V_plus (q.1, t) hqt_trap) i⟩
    rw [hcomp_eq]
    exact hΓ_preconn.subset_connectedComponentIn hq1_mem_Γ hΓ_sub
      ⟨q.2, ⟨le_of_lt hq.1, le_rfl⟩, rfl⟩
  let V_int : Set (ℂ × ℂ) := V_new ∩ ⋂ i : Fin k, (U₀ ∩ G.ψ_fn i ⁻¹' W_ψ')
  have hV_int_open : IsOpen V_int :=
    hV_new_open.inter (isOpen_iInter_of_finite fun i =>
      (hψ_holo i).continuousOn.isOpen_inter_preimage hU₀_open hW_ψ'_open)
  let V_plus' : Set (ℂ × ℂ) := connectedComponentIn V_int p₁
  have hV_plus'_open : IsOpen V_plus' := hV_int_open.connectedComponentIn
  have hV_plus'_preconn : IsPreconnected V_plus' := isPreconnected_connectedComponentIn
  have hV_plus'_sub_int : V_plus' ⊆ V_int := connectedComponentIn_subset V_int p₁
  have hV_plus'_sub_new : V_plus' ⊆ V_new := fun _ hq => (hV_plus'_sub_int hq).1
  have hV_plus'_sub_S : V_plus' ⊆ S.V_plus := hV_plus'_sub_new.trans hV_new_sub_S
  have hV_plus'_sub_U₀ : V_plus' ⊆ U₀ := hV_plus'_sub_S.trans S.V_plus_sub
  have hψ_maps_W_ψ' : ∀ q ∈ V_plus', ∀ i : Fin k, G.ψ_fn i q ∈ W_ψ' :=
    fun q hq i => (Set.mem_iInter.mp (hV_plus'_sub_int hq).2 i).2
  have hTrap_conv : Convex ℝ (webTrapezoid G.a₀ G.R G.δ_star G.C₀) := by
    intro x hx y hy a b ha hb hab
    rcases eq_or_lt_of_le ha with rfl | ha_pos
    · simp_all
    · refine ⟨?_, ?_, ?_⟩
      · have h1 : 0 < a * x.2 := mul_pos ha_pos hx.1
        have h2 : 0 ≤ b * y.2 := mul_nonneg hb (le_of_lt hy.1)
        change 0 < a * x.2 + b * y.2
        linarith
      · have h1 : a * x.2 < a * G.δ_star := mul_lt_mul_of_pos_left hx.2.1 ha_pos
        have h2 : b * y.2 ≤ b * G.δ_star := mul_le_mul_of_nonneg_left (le_of_lt hy.2.1) hb
        change a * x.2 + b * y.2 < G.δ_star
        calc a * x.2 + b * y.2
            < a * G.δ_star + b * G.δ_star := by linarith
          _ = G.δ_star := by rw [← add_mul, hab, one_mul]
      · change |(a * x.1 + b * y.1) - G.a₀| < G.R - G.C₀ * (a * x.2 + b * y.2)
        have hsplit : (a * x.1 + b * y.1) - G.a₀ = a * (x.1 - G.a₀) + b * (y.1 - G.a₀) := by
          calc (a * x.1 + b * y.1) - G.a₀
              = (a * x.1 + b * y.1) - (a + b) * G.a₀ := by rw [hab, one_mul]
            _ = a * (x.1 - G.a₀) + b * (y.1 - G.a₀) := by ring
        rw [hsplit]
        calc |a * (x.1 - G.a₀) + b * (y.1 - G.a₀)|
            ≤ |a * (x.1 - G.a₀)| + |b * (y.1 - G.a₀)| := abs_add_le _ _
          _ = a * |x.1 - G.a₀| + b * |y.1 - G.a₀| := by
              rw [abs_mul, abs_mul, abs_of_nonneg ha, abs_of_nonneg hb]
          _ < a * (G.R - G.C₀ * x.2) + b * (G.R - G.C₀ * y.2) := by
              have h1 : a * |x.1 - G.a₀| < a * (G.R - G.C₀ * x.2) :=
                mul_lt_mul_of_pos_left hx.2.2 ha_pos
              have h2 : b * |y.1 - G.a₀| ≤ b * (G.R - G.C₀ * y.2) :=
                mul_le_mul_of_nonneg_left (le_of_lt hy.2.2) hb
              linarith
          _ = G.R - G.C₀ * (a * x.2 + b * y.2) := by
              calc a * (G.R - G.C₀ * x.2) + b * (G.R - G.C₀ * y.2)
                  = (a + b) * G.R - G.C₀ * (a * x.2 + b * y.2) := by ring
                _ = G.R - G.C₀ * (a * x.2 + b * y.2) := by rw [hab, one_mul]
  have hTrap_mem_V_plus' : ∀ q ∈ webTrapezoid G.a₀ G.R G.δ_star G.C₀,
      ((q.1 : ℂ), (q.2 : ℂ)) ∈ V_plus' := by
    let emb : ℝ × ℝ → ℂ × ℂ := fun q => ((q.1 : ℂ), (q.2 : ℂ))
    have hemb_cont : Continuous emb :=
      (Complex.continuous_ofReal.comp continuous_fst).prodMk
        (Complex.continuous_ofReal.comp continuous_snd)
    have himg_preconn : IsPreconnected (emb '' webTrapezoid G.a₀ G.R G.δ_star G.C₀) :=
      hTrap_conv.isPreconnected.image emb hemb_cont.continuousOn
    have hp₁_mem_img : p₁ ∈ emb '' webTrapezoid G.a₀ G.R G.δ_star G.C₀ :=
      ⟨(a₁, δ₁), hq₁_trap, rfl⟩
    have himg_sub : emb '' webTrapezoid G.a₀ G.R G.δ_star G.C₀ ⊆ V_int := by
      rintro _ ⟨q, hq, rfl⟩
      refine ⟨hV_new_trap q hq, Set.mem_iInter.mpr fun i =>
        ⟨S.V_plus_sub (hV_new_sub_S (hV_new_trap q hq)), h_spine q hq i⟩⟩
    have hsub := himg_preconn.subset_connectedComponentIn hp₁_mem_img himg_sub
    intro q hq
    exact hsub ⟨q, hq, rfl⟩
  have hp₁_V' : p₁ ∈ V_plus' := hTrap_mem_V_plus' (a₁, δ₁) hq₁_trap
  have hbase_ψ_mem' : ∀ i : Fin k, G.ψ_fn i p₁ ∈ W_ψ' := hψ_maps_W_ψ' p₁ hp₁_V'

  
  let g' : Fin k → Fin (J + 1 + 1) → ℂ → ℂ := fun i => Fin.snoc (S.g i) (g_new i)
  have hg'_cast : ∀ (i : Fin k) (m : Fin (J + 1)), g' i m.castSucc = S.g i m :=
    fun i m => Fin.snoc_castSucc (α := fun _ => ℂ → ℂ) (g_new i) (S.g i) m
  have hg'_last : ∀ i : Fin k, g' i (Fin.last (J + 1)) = g_new i :=
    fun i => Fin.snoc_last (α := fun _ => ℂ → ℂ) (g_new i) (S.g i)
  have hg'_holo : ∀ (i : Fin k) (l : Fin (J + 1 + 1)), DifferentiableOn ℂ (g' i l) W_ψ' := by
    intro i l
    refine Fin.lastCases ?_ ?_ l
    · rw [hg'_last i]
      exact (hg_new_holo i).mono hW_ψ'_sub_new
    · intro m
      rw [hg'_cast i m]
      exact (S.g_holo i m).mono hW_ψ'_sub_S
  have hg'_lt_p : ∀ (i : Fin k) (l : Fin (J + 1 + 1)),
      (l : ℕ) < D_form.p → ∀ z : ℂ, g' i l z = 0 := by
    intro i l
    refine Fin.lastCases ?_ ?_ l
    · intro hl _
      exfalso
      simp only [Fin.val_last] at hl
      omega
    · intro m hl z
      rw [hg'_cast i m]
      exact S.g_lt_p i m (by simpa only [Fin.val_castSucc] using hl) z
  have hg'_zero : ∀ (i : Fin k) (z : ℂ), g' i 0 z = 0 :=
    fun i z => hg'_lt_p i 0 (by have := D_form.p_pos; simp; omega) z
  have hg'_taylor : ∀ (i : Fin k) (l : Fin (J + 1 + 1)), 1 ≤ (l : ℕ) →
      lineArcHoloTaylor1D (g' i l) (G.ψ_fn i p₁) = D_form.f_full i (l : ℕ) := by
    intro i l
    refine Fin.lastCases ?_ ?_ l
    · intro _
      rw [hg'_last i, Fin.val_last]
      exact hg_new_taylor i
    · intro m hl
      rw [hg'_cast i m, Fin.val_castSucc]
      exact S.g_taylor i m (by simpa only [Fin.val_castSucc] using hl)

  let β_zero_top : Fin (J + 1 + 1) → Fin (k + 1) → ℂ × ℂ → ℂ :=
    Fin.snoc S.β (fun _ _ => 0)
  have hβ_zt_cast : ∀ (m : Fin (J + 1)) (s : Fin (k + 1)),
      β_zero_top m.castSucc s = S.β m s := by
    intro m s
    exact congr_fun (Fin.snoc_castSucc (α := fun _ => Fin (k + 1) → ℂ × ℂ → ℂ)
      (fun _ _ => 0) S.β m) s
  have hβ_zt_last : ∀ s : Fin (k + 1), β_zero_top (Fin.last (J + 1)) s = fun _ => 0 := by
    intro s
    exact congr_fun (Fin.snoc_last (α := fun _ => Fin (k + 1) → ℂ × ℂ → ℂ)
      (fun _ _ => 0) S.β) s
  have hβ_zt_holo : ∀ (l : Fin (J + 1 + 1)) (s : Fin (k + 1)),
      DifferentiableOn ℂ (β_zero_top l s) V_plus' := by
    intro l s
    refine Fin.lastCases ?_ ?_ l
    · rw [hβ_zt_last s]
      exact differentiableOn_const 0
    · intro m
      rw [hβ_zt_cast m s]
      exact (S.β_holo m s).mono hV_plus'_sub_S
  have hβ_zt_zero : ∀ (s : Fin (k + 1)) (q : ℂ × ℂ), β_zero_top 0 s q = 0 := by
    intro s q
    rw [← Fin.castSucc_zero, hβ_zt_cast]
    exact S.β_zero s q

  let H_stat : ℂ × ℂ → Matrix (Fin (k - 1)) (Fin (k - 1)) ℂ := fun q =>
    lineInteriorHess (fun _ => C.h_ℂ) (fun _ => deriv C.h_ℂ)
      (fun _ => deriv (deriv C.h_ℂ)) (fun u => G.α_fn u q)
  let R_grad : ℂ × ℂ → Fin (k - 1) → ℂ := fun q r =>
    lineArcEpsJet (J + 1)
      (fun ε =>
        lineInteriorGrad (lineArcPertSupport C.h_ℂ g' ε)
          (lineArcPertSupportDeriv C.h_ℂ g' ε)
          (lineArcPertAngles (fun s => G.α_fn s q) (fun m s => β_zero_top m s q) ε) r)
  have hW₀_open : IsOpen (horizStrip (2 * C.s_h)) :=
    isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const
  have hh'_strip_holo : DifferentiableOn ℂ (deriv C.h_ℂ) (horizStrip (2 * C.s_h)) :=
    C.h_ℂ_holo.deriv hW₀_open
  have hh''_strip_holo : DifferentiableOn ℂ (deriv (deriv C.h_ℂ)) (horizStrip (2 * C.s_h)) :=
    hh'_strip_holo.deriv hW₀_open
  have hH_holo : ∀ r s : Fin (k - 1), DifferentiableOn ℂ (fun q => H_stat q r s) V_plus' := by
    intro r s
    have h_U₀ : DifferentiableOn ℂ (fun q => H_stat q r s) U₀ := by
      let i_L : Fin k := ⟨r.1, by have := r.2; omega⟩
      let i_R : Fin k := ⟨r.1 + 1, by have := r.2; omega⟩
      have hh_L : DifferentiableOn ℂ (fun q => C.h_ℂ (G.ψ_fn i_L q)) U₀ :=
        C.h_ℂ_holo.comp (hψ_holo i_L) (G.ψ_maps_strip i_L)
      have hh'_L : DifferentiableOn ℂ (fun q => deriv C.h_ℂ (G.ψ_fn i_L q)) U₀ :=
        hh'_strip_holo.comp (hψ_holo i_L) (G.ψ_maps_strip i_L)
      have hh''_L : DifferentiableOn ℂ (fun q => deriv (deriv C.h_ℂ) (G.ψ_fn i_L q)) U₀ :=
        hh''_strip_holo.comp (hψ_holo i_L) (G.ψ_maps_strip i_L)
      have hh_R : DifferentiableOn ℂ (fun q => C.h_ℂ (G.ψ_fn i_R q)) U₀ :=
        C.h_ℂ_holo.comp (hψ_holo i_R) (G.ψ_maps_strip i_R)
      have hh'_R : DifferentiableOn ℂ (fun q => deriv C.h_ℂ (G.ψ_fn i_R q)) U₀ :=
        hh'_strip_holo.comp (hψ_holo i_R) (G.ψ_maps_strip i_R)
      have hh''_R : DifferentiableOn ℂ (fun q => deriv (deriv C.h_ℂ) (G.ψ_fn i_R q)) U₀ :=
        hh''_strip_holo.comp (hψ_holo i_R) (G.ψ_maps_strip i_R)
      have hsin_L : DifferentiableOn ℂ (fun q => Complex.sin (G.d_fn i_L q)) U₀ :=
        Complex.differentiable_sin.comp_differentiableOn (hd_holo i_L)
      have hcos_L : DifferentiableOn ℂ (fun q => Complex.cos (G.d_fn i_L q)) U₀ :=
        Complex.differentiable_cos.comp_differentiableOn (hd_holo i_L)
      have hsin_R : DifferentiableOn ℂ (fun q => Complex.sin (G.d_fn i_R q)) U₀ :=
        Complex.differentiable_sin.comp_differentiableOn (hd_holo i_R)
      have hcos_R : DifferentiableOn ℂ (fun q => Complex.cos (G.d_fn i_R q)) U₀ :=
        Complex.differentiable_cos.comp_differentiableOn (hd_holo i_R)
      dsimp only [H_stat, lineInteriorHess]
      split_ifs
      · exact (((((hh''_L.sub hh_L).mul hinv2_U₀).mul hsin_L).add (hh'_L.mul hcos_L)).add
          ((((hh''_R.sub hh_R).mul hinv2_U₀).mul hsin_R).sub (hh'_R.mul hcos_R))).congr
          fun q _ => by
            dsimp only [Pi.add_apply, Pi.sub_apply, Pi.mul_apply, i_L, i_R,
              LineGlancingChartData.ψ_fn, LineGlancingChartData.d_fn,
              lineChartPsi, lineChartHalfStep]
            ring
      · exact (((hh_R.add hh''_R).mul hinv2_U₀).mul hsin_R).congr fun q _ => by
          dsimp only [Pi.add_apply, Pi.sub_apply, Pi.mul_apply, i_R,
            LineGlancingChartData.ψ_fn, LineGlancingChartData.d_fn,
            lineChartPsi, lineChartHalfStep]
          ring
      · exact (((hh_L.add hh''_L).mul hinv2_U₀).mul hsin_L).congr fun q _ => by
          dsimp only [Pi.add_apply, Pi.sub_apply, Pi.mul_apply, i_L,
            LineGlancingChartData.ψ_fn, LineGlancingChartData.d_fn,
            lineChartPsi, lineChartHalfStep]
          ring
      · exact differentiableOn_const 0
    exact h_U₀.mono hV_plus'_sub_U₀
  have hh_W' : DifferentiableOn ℂ C.h_ℂ W_ψ' := C.h_ℂ_holo.mono hW_ψ'_sub_strip
  have hα_V' : ∀ s : Fin (k + 1), DifferentiableOn ℂ (G.α_fn s) V_plus' :=
    fun s => (G.α_holo s).mono hV_plus'_sub_U₀
  have hR_holo : ∀ r : Fin (k - 1), DifferentiableOn ℂ (fun q => R_grad q r) V_plus' :=
    (hJet.epsJet_holo (J + 1) hW_ψ'_open hV_plus'_open hh_W' hg'_holo hg'_zero
      hα_V' hψ_maps_W_ψ' hβ_zt_holo hβ_zt_zero).2
  have hH_det_ne : ∀ q ∈ V_plus', (H_stat q).det ≠ 0 :=
    fun q hq => S.hess_det_ne_zero q (hV_plus'_sub_S hq)

  let β_formal : Fin (k - 1) → MvPowerSeries (Fin 2) ℂ :=
    fun s => D_form.β_full (J + 1) ⟨s.1 + 1, by have := s.2; omega⟩
  have h_hess_formal : ∀ r : Fin (k - 1),
      taylor2D (fun q => R_grad q r) p₁ +
        ∑ s : Fin (k - 1), taylor2D (fun q => H_stat q r s) p₁ * β_formal s = 0 := by
    intro r
    have ht := (hJet.taylor2D_epsJet_eq (J + 1) hW_ψ'_open hV_plus'_open hp₁_V'
      hh_W' hg'_holo hg'_zero hα_V' hψ_maps_W_ψ' hβ_zt_holo hβ_zt_zero).2 r
    have hf_eq :
        (fun (i : Fin k) (l : ℕ) =>
          if l = 0 then lineArcHoloTaylor1D C.h_ℂ (lineChainMid (fun s => G.α_fn s p₁) i)
          else if hl : l < J + 1 + 1 then
            lineArcHoloTaylor1D (g' i ⟨l, hl⟩) (lineChainMid (fun s => G.α_fn s p₁) i)
          else 0) = lineArcTruncSupport (J + 1) D_form.f_full := by
      funext i l
      unfold lineArcTruncSupport
      by_cases hl0 : l = 0
      · subst hl0
        simp only [↓reduceIte, Nat.zero_le]
        exact (D_form.f_zero i).symm
      · by_cases hl : l < J + 1 + 1
        · have hl_le : l ≤ J + 1 := by omega
          have hl_ge1 : 1 ≤ (⟨l, hl⟩ : Fin (J + 1 + 1)).1 := by simp; omega
          simp only [hl0, ↓reduceIte, hl, ↓reduceDIte, hl_le]
          exact hg'_taylor i ⟨l, hl⟩ hl_ge1
        · have hl_nle : ¬ l ≤ J + 1 := by omega
          simp [hl0, hl, hl_nle]
    have hβ_eq :
        (fun (l : ℕ) (s : Fin (k + 1)) =>
          if l = 0 then centeredTaylor2D (G.α_fn s) p₁
          else if hl : l < J + 1 + 1 then taylor2D (β_zero_top ⟨l, hl⟩ s) p₁
          else 0) = lineArcTruncBeta J D_form.β_full := by
      funext l s
      unfold lineArcTruncBeta
      by_cases hl0 : l = 0
      · subst hl0
        simp only [↓reduceIte, Nat.zero_le]
        exact (D_form.β_zero s).symm
      · by_cases hlJ : l < J + 1
        · have hl : l < J + 1 + 1 := by omega
          have hl_le : l ≤ J := by omega
          have hfin : (⟨l, hl⟩ : Fin (J + 1 + 1)) = (⟨l, hlJ⟩ : Fin (J + 1)).castSucc :=
            Fin.ext rfl
          have hl_ge1 : 1 ≤ (⟨l, hlJ⟩ : Fin (J + 1)).1 := by simp; omega
          simp only [hl0, ↓reduceIte, hl, ↓reduceDIte, hl_le, hfin, hβ_zt_cast]
          exact S.β_taylor ⟨l, hlJ⟩ s hl_ge1
        · by_cases hl : l < J + 1 + 1
          · have hl_nle : ¬ l ≤ J := by omega
            have hfin : (⟨l, hl⟩ : Fin (J + 1 + 1)) = Fin.last (J + 1) := by
              ext; simp; omega
            simp only [hl0, ↓reduceIte, hl, ↓reduceDIte, hl_nle, hfin, hβ_zt_last]
            rw [hJet.taylor2D_const p₁ 0, map_zero]
          · have hl_nle : ¬ l ≤ J := by omega
            simp [hl0, hl, hl_nle]
    rw [hf_eq, hβ_eq] at ht
    change taylor2D (fun q => R_grad q r) p₁ = _ at ht
    rw [ht]
    exact D_form.formal_hess_step J r

  have hM_det_holo : ∀ (M : ℂ × ℂ → Matrix (Fin (k - 1)) (Fin (k - 1)) ℂ),
      (∀ r s : Fin (k - 1), DifferentiableOn ℂ (fun q => M q r s) V_plus') →
      DifferentiableOn ℂ (fun q => (M q).det) V_plus' := by
    intro M hM
    have hprod : ∀ (σ : Equiv.Perm (Fin (k - 1))) (s : Finset (Fin (k - 1))),
        DifferentiableOn ℂ (fun q => ∏ i ∈ s, M q (σ i) i) V_plus' := by
      intro σ s
      induction s using Finset.induction_on with
      | empty => simp [differentiableOn_const]
      | insert a s ha ih =>
        exact ((hM (σ a) a).mul ih).congr fun q _ => Finset.prod_insert ha
    have hdet_eq : (fun q => (M q).det) = fun q =>
        ∑ σ : Equiv.Perm (Fin (k - 1)),
          ((Equiv.Perm.sign σ : ℤ) : ℂ) * ∏ i : Fin (k - 1), M q (σ i) i := by
      ext q
      simp only [Matrix.det_apply, Units.smul_def, zsmul_eq_mul]
    rw [hdet_eq]
    exact DifferentiableOn.fun_sum fun σ _ =>
      (differentiableOn_const _).mul (hprod σ Finset.univ)

  let β_int : Fin (k - 1) → ℂ × ℂ → ℂ := fun u q =>
    -((H_stat q).det)⁻¹ * ((H_stat q).cramer (R_grad q)) u
  have hβ_int_holo : ∀ u : Fin (k - 1), DifferentiableOn ℂ (β_int u) V_plus' := by
    intro u
    have hdet_inv : DifferentiableOn ℂ (fun q => -((H_stat q).det)⁻¹) V_plus' :=
      ((hM_det_holo H_stat hH_holo).inv hH_det_ne).neg
    have hcramer : DifferentiableOn ℂ (fun q => ((H_stat q).cramer (R_grad q)) u) V_plus' := by
      have hfn : (fun q => ((H_stat q).cramer (R_grad q)) u) =
          fun q => ((H_stat q).updateCol u (R_grad q)).det := by
        ext q
        exact Matrix.cramer_apply (H_stat q) (R_grad q) u
      rw [hfn]
      apply hM_det_holo
      intro r s
      by_cases hsu : s = u
      · subst hsu
        exact (hR_holo r).congr fun q _ => by simp
      · exact (hH_holo r s).congr fun q _ => by simp [hsu]
    exact hdet_inv.mul hcramer
  have hβ_int_solve : ∀ q ∈ V_plus', ∀ r : Fin (k - 1),
      R_grad q r + ∑ s : Fin (k - 1), H_stat q r s * β_int s q = 0 := by
    intro q hq r
    have hβ_eq_smul : (fun s => β_int s q) = (-((H_stat q).det)⁻¹) • (H_stat q).cramer (R_grad q) := by
      ext s
      simp [β_int]
    have hsum : (∑ s : Fin (k - 1), H_stat q r s * β_int s q) =
        ((H_stat q).mulVec (fun s => β_int s q)) r := rfl
    rw [hsum, hβ_eq_smul, Matrix.mulVec_smul, Matrix.mulVec_cramer]
    simp only [Pi.smul_apply, smul_eq_mul]
    calc R_grad q r + -((H_stat q).det)⁻¹ * ((H_stat q).det * R_grad q r)
        = R_grad q r - (((H_stat q).det)⁻¹ * (H_stat q).det) * R_grad q r := by ring
      _ = R_grad q r - 1 * R_grad q r := by rw [inv_mul_cancel₀ (hH_det_ne q hq)]
      _ = 0 := by ring
  have htaylor_sum : ∀ (s_set : Finset (Fin (k - 1))) (F : Fin (k - 1) → ℂ × ℂ → ℂ),
      (∀ u ∈ s_set, DifferentiableOn ℂ (F u) V_plus') →
      taylor2D (fun q => ∑ u ∈ s_set, F u q) p₁ = ∑ u ∈ s_set, taylor2D (F u) p₁ := by
    intro s_set F hF
    induction s_set using Finset.induction_on with
    | empty =>
      simp only [Finset.sum_empty]
      rw [hJet.taylor2D_const p₁ 0, map_zero]
    | insert a s_set ha ih =>
      have h1 : DifferentiableOn ℂ (F a) V_plus' := hF a (Finset.mem_insert_self a s_set)
      have h2 : DifferentiableOn ℂ (fun q => ∑ u ∈ s_set, F u q) V_plus' :=
        DifferentiableOn.fun_sum fun u hu => hF u (Finset.mem_insert_of_mem hu)
      have hcongr : taylor2D (fun q => ∑ u ∈ insert a s_set, F u q) p₁ =
          taylor2D (fun q => F a q + ∑ u ∈ s_set, F u q) p₁ :=
        hJet.taylor2D_congr hV_plus'_open hp₁_V' fun q _ => Finset.sum_insert ha
      rw [hcongr, (hJet.taylor2D_ring hV_plus'_open hp₁_V' h1 h2).1,
        ih (fun u hu => hF u (Finset.mem_insert_of_mem hu)), Finset.sum_insert ha]
  have hβ_int_taylor : ∀ u : Fin (k - 1), taylor2D (β_int u) p₁ = β_formal u := by
    have h_int_series : ∀ r : Fin (k - 1),
        taylor2D (fun q => R_grad q r) p₁ +
          ∑ s : Fin (k - 1), taylor2D (fun q => H_stat q r s) p₁ * taylor2D (β_int s) p₁ = 0 := by
      intro r
      have h0 : taylor2D (fun q => R_grad q r + ∑ s : Fin (k - 1), H_stat q r s * β_int s q) p₁ =
          taylor2D (fun _ => (0 : ℂ)) p₁ :=
        hJet.taylor2D_congr hV_plus'_open hp₁_V' fun q hq => hβ_int_solve q hq r
      have hsum_holo : DifferentiableOn ℂ
          (fun q => ∑ s : Fin (k - 1), H_stat q r s * β_int s q) V_plus' :=
        DifferentiableOn.fun_sum fun s _ => (hH_holo r s).mul (hβ_int_holo s)
      rw [hJet.taylor2D_const p₁ 0, map_zero,
        (hJet.taylor2D_ring hV_plus'_open hp₁_V' (hR_holo r) hsum_holo).1,
        htaylor_sum Finset.univ (fun s q => H_stat q r s * β_int s q)
          (fun s _ => (hH_holo r s).mul (hβ_int_holo s))] at h0
      rw [← h0]
      congr 1
      refine Finset.sum_congr rfl fun s _ => ?_
      exact ((hJet.taylor2D_ring hV_plus'_open hp₁_V' (hH_holo r s) (hβ_int_holo s)).2.2).symm
    let M_ps : Matrix (Fin (k - 1)) (Fin (k - 1)) (MvPowerSeries (Fin 2) ℂ) :=
      fun r s => taylor2D (fun q => H_stat q r s) p₁
    let Δ : Fin (k - 1) → MvPowerSeries (Fin 2) ℂ :=
      fun s => taylor2D (β_int s) p₁ - β_formal s
    have hMΔ : M_ps.mulVec Δ = 0 := by
      funext r
      change ∑ s : Fin (k - 1), M_ps r s * (taylor2D (β_int s) p₁ - β_formal s) = 0
      simp only [mul_sub, Finset.sum_sub_distrib]
      have h1 := h_int_series r
      have h2 := h_hess_formal r
      change taylor2D (fun q => R_grad q r) p₁ +
        ∑ s : Fin (k - 1), M_ps r s * taylor2D (β_int s) p₁ = 0 at h1
      change taylor2D (fun q => R_grad q r) p₁ +
        ∑ s : Fin (k - 1), M_ps r s * β_formal s = 0 at h2
      have hdiff := congr_arg₂ (· - ·) h1 h2
      simpa [add_sub_add_left_eq_sub] using hdiff
    have hadj : (M_ps.adjugate * M_ps).mulVec Δ = 0 := by
      rw [← Matrix.mulVec_mulVec, hMΔ, Matrix.mulVec_zero]
    rw [Matrix.adjugate_mul, Matrix.smul_mulVec, Matrix.one_mulVec] at hadj
    have hmap_det : MvPowerSeries.constantCoeff M_ps.det = (H_stat p₁).det := by
      rw [RingHom.map_det]
      congr 1
      ext r s
      rw [RingHom.mapMatrix_apply, ← MvPowerSeries.coeff_zero_eq_constantCoeff]
      change iterDerivYT ((0 : Fin 2 →₀ ℕ) 0) ((0 : Fin 2 →₀ ℕ) 1) (fun q => H_stat q r s) p₁ /
        ((((0 : Fin 2 →₀ ℕ) 0).factorial : ℂ) * (((0 : Fin 2 →₀ ℕ) 1).factorial : ℂ)) =
        H_stat p₁ r s
      simp [iterDerivYT, iterDerivY]
    have hdet_unit : IsUnit M_ps.det := by
      rw [MvPowerSeries.isUnit_iff_constantCoeff, hmap_det]
      exact isUnit_iff_ne_zero.mpr (hH_det_ne p₁ hp₁_V')
    intro u
    have hu : Δ u * M_ps.det = 0 := by
      have h1 : (M_ps.det • Δ) u = 0 := congr_fun hadj u
      simpa [Pi.smul_apply, smul_eq_mul, mul_comm] using h1
    exact sub_eq_zero.mp ((hdet_unit.mul_left_eq_zero).mp hu)

  
  let β_top : Fin (k + 1) → ℂ × ℂ → ℂ := fun s q =>
    if hs : 0 < s.1 ∧ s.1 < k then β_int ⟨s.1 - 1, by omega⟩ q else 0
  have hβ_top_end : ∀ q : ℂ × ℂ, β_top 0 q = 0 ∧ β_top (Fin.last k) q = 0 := by
    intro q
    simp [β_top]
  have hβ_top_succ : ∀ (u : Fin (k - 1)) (q : ℂ × ℂ),
      β_top ⟨u.1 + 1, by have := u.2; omega⟩ q = β_int u q := by
    intro u q
    have hs : 0 < u.1 + 1 ∧ u.1 + 1 < k := by have := u.2; omega
    dsimp only [β_top]
    split_ifs
    rfl
  have hβ_top_holo : ∀ s : Fin (k + 1), DifferentiableOn ℂ (β_top s) V_plus' := by
    intro s
    by_cases hs : 0 < s.1 ∧ s.1 < k
    · exact (hβ_int_holo ⟨s.1 - 1, by omega⟩).congr fun q _ => by dsimp only [β_top]; split_ifs; rfl
    · exact (differentiableOn_const 0).congr fun q _ => by dsimp only [β_top]; split_ifs; rfl
  have hβ_top_taylor : ∀ s : Fin (k + 1), taylor2D (β_top s) p₁ = D_form.β_full (J + 1) s := by
    intro s
    by_cases hs : 0 < s.1 ∧ s.1 < k
    · have hfn : β_top s = β_int ⟨s.1 - 1, by omega⟩ :=
        funext fun q => by dsimp only [β_top]; split_ifs; rfl
      rw [hfn, hβ_int_taylor ⟨s.1 - 1, by omega⟩]
      dsimp only [β_formal]
      congr 1
      ext
      dsimp only
      omega
    · have hfn : β_top s = fun _ => (0 : ℂ) :=
        funext fun q => by dsimp only [β_top]; split_ifs; rfl
      rw [hfn, hJet.taylor2D_const p₁ 0, map_zero]
      have hs_cases : s = 0 ∨ s = Fin.last k := by
        have := s.2
        rcases (by omega : s.1 = 0 ∨ s.1 = k) with h0 | hk'
        · left; ext; exact h0
        · right; ext; exact hk'
      rcases hs_cases with rfl | rfl
      · exact ((D_form.β_endpoints (J + 1) (by omega)).1).symm
      · exact ((D_form.β_endpoints (J + 1) (by omega)).2).symm

  let β' : Fin (J + 1 + 1) → Fin (k + 1) → ℂ × ℂ → ℂ := Fin.snoc S.β β_top
  have hβ'_cast : ∀ (m : Fin (J + 1)) (s : Fin (k + 1)), β' m.castSucc s = S.β m s := by
    intro m s
    exact congr_fun (Fin.snoc_castSucc (α := fun _ => Fin (k + 1) → ℂ × ℂ → ℂ) β_top S.β m) s
  have hβ'_last : ∀ s : Fin (k + 1), β' (Fin.last (J + 1)) s = β_top s := by
    intro s
    exact congr_fun (Fin.snoc_last (α := fun _ => Fin (k + 1) → ℂ × ℂ → ℂ) β_top S.β) s
  have hβ'_holo : ∀ (l : Fin (J + 1 + 1)) (r : Fin (k + 1)),
      DifferentiableOn ℂ (β' l r) V_plus' := by
    intro l r
    refine Fin.lastCases ?_ ?_ l
    · rw [hβ'_last r]
      exact hβ_top_holo r
    · intro m
      rw [hβ'_cast m r]
      exact (S.β_holo m r).mono hV_plus'_sub_S
  have hβ'_zero : ∀ (r : Fin (k + 1)) (q : ℂ × ℂ), β' 0 r q = 0 := by
    intro r q
    rw [← Fin.castSucc_zero, hβ'_cast]
    exact S.β_zero r q
  have hβ'_endpoints : ∀ (l : Fin (J + 1 + 1)) (q : ℂ × ℂ),
      β' l 0 q = 0 ∧ β' l (Fin.last k) q = 0 := by
    intro l q
    refine Fin.lastCases ?_ ?_ l
    · rw [hβ'_last 0, hβ'_last (Fin.last k)]
      exact hβ_top_end q
    · intro m
      rw [hβ'_cast m 0, hβ'_cast m (Fin.last k)]
      exact S.β_endpoints m q
  have hβ'_taylor : ∀ (l : Fin (J + 1 + 1)) (r : Fin (k + 1)), 1 ≤ (l : ℕ) →
      taylor2D (β' l r) p₁ = D_form.β_full (l : ℕ) r := by
    intro l r
    refine Fin.lastCases ?_ ?_ l
    · intro _
      rw [hβ'_last r, Fin.val_last]
      exact hβ_top_taylor r
    · intro m hl
      rw [hβ'_cast m r, Fin.val_castSucc]
      exact S.β_taylor m r (by simpa only [Fin.val_castSucc] using hl)

  have h_top_jets : ∀ q ∈ V_plus',
      lineArcEpsJet (J + 1)
          (fun ε =>
            lineChainAction (lineArcPertSupport C.h_ℂ g' ε)
              (lineArcPertAngles (fun s => G.α_fn s q) (fun m s => β' m s q) ε)) =
        D_form.K_seq (J + 1) ∧
      ∀ r : Fin (k - 1),
        lineArcEpsJet (J + 1)
            (fun ε =>
              lineInteriorGrad (lineArcPertSupport C.h_ℂ g' ε)
                (lineArcPertSupportDeriv C.h_ℂ g' ε)
                (lineArcPertAngles (fun s => G.α_fn s q) (fun m s => β' m s q) ε) r) = 0 := by
    intro q hq
    have hβ'_pt : (fun m s => β' m s q) =
        Fin.snoc (fun m s => S.β m s q) (fun s => β_top s q) := by
      funext m s
      refine Fin.lastCases ?_ ?_ m
      · rw [hβ'_last s, Fin.snoc_last (α := fun _ => Fin (k + 1) → ℂ)]
      · intro m₀
        rw [hβ'_cast m₀ s, Fin.snoc_castSucc (α := fun _ => Fin (k + 1) → ℂ)]
    have hβ_zt_pt : (fun m s => β_zero_top m s q) =
        Fin.snoc (fun m s => S.β m s q) (fun _ => 0) := by
      funext m s
      refine Fin.lastCases ?_ ?_ m
      · rw [hβ_zt_last s, Fin.snoc_last (α := fun _ => Fin (k + 1) → ℂ)]
      · intro m₀
        rw [hβ_zt_cast m₀ s, Fin.snoc_castSucc (α := fun _ => Fin (k + 1) → ℂ)]
    have hsplit := hJet.epsJet_succ_split (g := S.g) (g_top := g_new)
      (α₀ := fun s => G.α_fn s q)
      (β := fun m s => S.β m s q) (β_top := fun s => β_top s q)
      hk hW_ψ'_open hh_W'
      (fun i m => (S.g_holo i m).mono hW_ψ'_sub_S)
      (fun i => (hg_new_holo i).mono hW_ψ'_sub_new)
      hg0_S (hψ_maps_W_ψ' q hq) (fun s => S.β_zero s q) (hβ_top_end q)
    refine ⟨?_, ?_⟩
    · rw [hβ'_pt, hsplit.1]
      have hstat_zero :
          (∑ r : Fin (k - 1),
            lineInteriorGrad (fun _ => C.h_ℂ) (fun _ => deriv C.h_ℂ)
              (fun s => G.α_fn s q) r *
              β_top ⟨r.1 + 1, by have := r.2; omega⟩ q) = 0 := by
        refine Finset.sum_eq_zero fun r _ => ?_
        rw [G.stationary_on_chart q (hV_plus'_sub_U₀ hq) r, zero_mul]
      have hweb_q := (hg_new_eq q (hV_plus'_sub_new hq)).2
      change ∑ i : Fin k, G.w_fn i q * g_new i (G.ψ_fn i q) =
        D_form.K_seq (J + 1) - B_act q at hweb_q
      have hsum_w :
          (∑ i : Fin k,
            2 * Complex.sin (lineChainHalfStep (fun s => G.α_fn s q) i) *
              g_new i (lineChainMid (fun s => G.α_fn s q) i)) =
          ∑ i : Fin k, G.w_fn i q * g_new i (G.ψ_fn i q) := rfl
      rw [hstat_zero, add_zero, hsum_w, hweb_q]
      change B_act q + (D_form.K_seq (J + 1) - B_act q) = D_form.K_seq (J + 1)
      exact add_sub_cancel _ _
    · intro r
      rw [hβ'_pt]
      rw [hsplit.2 r, ← hβ_zt_pt]
      have hsum_hess :
          (∑ s : Fin (k - 1),
            lineInteriorHess (fun _ => C.h_ℂ) (fun _ => deriv C.h_ℂ)
              (fun _ => deriv (deriv C.h_ℂ)) (fun u => G.α_fn u q) r s *
              β_top ⟨s.1 + 1, by have := s.2; omega⟩ q) =
          ∑ s : Fin (k - 1), H_stat q r s * β_int s q := by
        refine Finset.sum_congr rfl fun s _ => ?_
        rw [hβ_top_succ s q]
      rw [hsum_hess]
      exact hβ_int_solve q hq r

  refine ⟨{
    W_ψ := W_ψ'
    V_plus := V_plus'
    g := g'
    β := β'
    W_ψ_open := hW_ψ'_open
    W_ψ_preconn := hW_ψ'_preconn
    W_ψ_sub_strip := hW_ψ'_sub_strip
    real_mem_W_ψ := hW_ψ'_real
    base_ψ_mem := hbase_ψ_mem'
    V_plus_open := hV_plus'_open
    V_plus_preconn := hV_plus'_preconn
    V_plus_sub := hV_plus'_sub_U₀
    trapezoid_mem_V_plus := hTrap_mem_V_plus'
    ψ_maps_W_ψ := hψ_maps_W_ψ'
    hess_det_ne_zero := hH_det_ne
    g_holo := hg'_holo
    g_lt_p := hg'_lt_p
    g_taylor := hg'_taylor
    β_holo := hβ'_holo
    β_zero := hβ'_zero
    β_endpoints := hβ'_endpoints
    β_taylor := hβ'_taylor
    grad_jet_zero := by
      intro q hq r l hl1 hlJ1
      rcases eq_or_lt_of_le hlJ1 with rfl | hl_lt
      · exact (h_top_jets q hq).2 r
      · have hlJ : l ≤ J := by omega
        have htrunc := (hJet.epsJet_trunc_eq (J₁ := J) (J₂ := J + 1)
          (g₁ := S.g) (g₂ := g') (α₀ := fun s => G.α_fn s q)
          (β₁ := fun m s => S.β m s q) (β₂ := fun m s => β' m s q)
          (Nat.le_succ J) hl1 hlJ hW_ψ'_open hh_W'
          (fun i m => (S.g_holo i m).mono hW_ψ'_sub_S) hg'_holo hg0_S hg'_zero
          (fun i m z _ => congr_fun (hg'_cast i m) z)
          (hψ_maps_W_ψ' q hq)
          (fun s => S.β_zero s q) (fun s => hβ'_zero s q)
          (fun m s => congr_fun (hβ'_cast m s) q)).2 r
        rw [htrunc]
        exact S.grad_jet_zero q (hV_plus'_sub_S hq) r l hl1 hlJ
    action_jet_const := by
      intro q hq l
      refine Fin.lastCases ?_ ?_ l
      · intro _
        rw [Fin.val_last]
        exact (h_top_jets q hq).1
      · intro m hl1
        rw [Fin.val_castSucc] at hl1 ⊢
        have hmJ : (m : ℕ) ≤ J := Nat.le_of_lt_succ m.2
        have htrunc := (hJet.epsJet_trunc_eq (J₁ := J) (J₂ := J + 1)
          (g₁ := S.g) (g₂ := g') (α₀ := fun s => G.α_fn s q)
          (β₁ := fun m₀ s => S.β m₀ s q) (β₂ := fun m₀ s => β' m₀ s q)
          (Nat.le_succ J) hl1 hmJ hW_ψ'_open hh_W'
          (fun i m₀ => (S.g_holo i m₀).mono hW_ψ'_sub_S) hg'_holo hg0_S hg'_zero
          (fun i m₀ z _ => congr_fun (hg'_cast i m₀) z)
          (hψ_maps_W_ψ' q hq)
          (fun s => S.β_zero s q) (fun s => hβ'_zero s q)
          (fun m₀ s => congr_fun (hβ'_cast m₀ s) q)).1
        rw [htrunc]
        exact S.action_jet_const q (hV_plus'_sub_S hq) m hl1
  }, hg'_cast⟩

theorem line_formal_arc_web_continuation (Ω : Set Plane)
    (C : AnalyticGlancingCollar Ω)
    (B : BaseCollarAndCramerData C)
    (k : ℕ) (hk : 2 ≤ k)
    (G : LineGlancingChartData C B k)
    (a₁ δ₁ : ℝ)
    (ha₁ : a₁ ∈ Set.Ioo (G.a₀ - G.R / 4) (G.a₀ + G.R / 4))
    (hδ₁ : δ₁ ∈ Set.Ioo 0 G.δ_star)
    (E : LineCoreEliminationData C B k G a₁ δ₁)
    (hAlg : AlgebraicLiftingToolkit)
    (hWeb : FiniteWebContinuationProp)
    (hNonAlg : ∃ r : Fin E.N_core, ¬ IsAlgebraic (↥E.K_end) (E.coreTuple r)) :
    Nonempty (LineContinuedDeformationData C B k G a₁ δ₁) :=
by
  have hJet : LineArcJetAndTaylorToolkit := line_arc_jet_and_taylor_toolkit
  obtain ⟨D_form⟩ :=
    line_arc_formal_recentered_system Ω C B k hk G a₁ δ₁ ha₁ hδ₁ E hAlg hJet hNonAlg
  let p₁ : ℂ × ℂ := ((a₁ : ℂ), (δ₁ : ℂ))
  let U₀ : Set (ℂ × ℂ) := G.U_a ×ˢ G.U_d
  have hU₀_open : IsOpen U₀ := Metric.isOpen_ball.prod Metric.isOpen_ball
  have hq₁_trap : (a₁, δ₁) ∈ webTrapezoid G.a₀ G.R G.δ_star G.C₀ := by
    refine ⟨hδ₁.1, hδ₁.2, ?_⟩
    have ha₁_abs : |a₁ - G.a₀| < G.R / 4 :=
      abs_lt.mpr ⟨by linarith [ha₁.1], by linarith [ha₁.2]⟩
    have hCδ : G.C₀ * δ₁ < G.C₀ * G.δ_star := mul_lt_mul_of_pos_left hδ₁.2 G.C₀_pos
    linarith [G.C₀_δ_star_lt, G.R_pos]
  have htrap_sub_U₀ : ∀ q ∈ webTrapezoid G.a₀ G.R G.δ_star G.C₀,
      ((q.1 : ℂ), (q.2 : ℂ)) ∈ U₀ := by
    intro q hq
    refine ⟨?_, ?_⟩
    · rw [LineGlancingChartData.U_a, Metric.mem_ball, Complex.dist_eq, ← Complex.ofReal_sub,
        Complex.norm_real, Real.norm_eq_abs]
      have hpos : 0 < G.C₀ * q.2 := mul_pos G.C₀_pos hq.1
      linarith [hq.2.2, G.R_pos]
    · rw [LineGlancingChartData.U_d, Metric.mem_ball, dist_zero_right, Complex.norm_real,
        Real.norm_eq_abs, abs_of_pos hq.1]
      linarith [hq.2.1, G.δ_star_pos]
  have hp₁_U₀ : p₁ ∈ U₀ := htrap_sub_U₀ (a₁, δ₁) hq₁_trap
  let W₀ : Set ℂ := horizStrip (2 * C.s_h)
  have hW₀_open : IsOpen W₀ :=
    isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const
  have hW₀_conv : Convex ℝ W₀ := by
    intro z hz w hw a b ha hb hab
    rcases eq_or_lt_of_le ha with rfl | ha_pos
    · simp_all
    · change |(a • z + b • w).im| < 2 * C.s_h
      have him : (a • z + b • w).im = a * z.im + b * w.im := by simp
      rw [him]
      calc |a * z.im + b * w.im|
          ≤ |a * z.im| + |b * w.im| := abs_add_le _ _
        _ = a * |z.im| + b * |w.im| := by
            rw [abs_mul, abs_mul, abs_of_nonneg ha, abs_of_nonneg hb]
        _ < a * (2 * C.s_h) + b * (2 * C.s_h) := by
            have h1 : a * |z.im| < a * (2 * C.s_h) := mul_lt_mul_of_pos_left hz ha_pos
            have h2 : b * |w.im| ≤ b * (2 * C.s_h) :=
              mul_le_mul_of_nonneg_left (le_of_lt hw) hb
            linarith
        _ = 2 * C.s_h := by rw [← add_mul, hab, one_mul]
  have hW₀_preconn : IsPreconnected W₀ := hW₀_conv.isPreconnected
  have hh'_holo : DifferentiableOn ℂ (deriv C.h_ℂ) W₀ := C.h_ℂ_holo.deriv hW₀_open
  have hh''_holo : DifferentiableOn ℂ (deriv (deriv C.h_ℂ)) W₀ := hh'_holo.deriv hW₀_open
  have hinv2_U₀ : DifferentiableOn ℂ (fun _ : ℂ × ℂ => (2 : ℂ)⁻¹) U₀ :=
    differentiableOn_const (2 : ℂ)⁻¹
  have hψ_holo : ∀ i : Fin k, DifferentiableOn ℂ (G.ψ_fn i) U₀ := by
    intro i
    have h1 : DifferentiableOn ℂ (fun q : ℂ × ℂ => lineChartAlpha C k G.Ψ i.castSucc q) U₀ :=
      G.α_holo i.castSucc
    have h2 : DifferentiableOn ℂ (fun q : ℂ × ℂ => lineChartAlpha C k G.Ψ i.succ q) U₀ :=
      G.α_holo i.succ
    exact ((h1.add h2).mul hinv2_U₀).congr fun q _ => by
      change (lineChartAlpha C k G.Ψ i.castSucc q + lineChartAlpha C k G.Ψ i.succ q) / 2 = _
      exact div_eq_mul_inv _ 2
  have hd_holo : ∀ i : Fin k, DifferentiableOn ℂ (G.d_fn i) U₀ := by
    intro i
    have h1 : DifferentiableOn ℂ (fun q : ℂ × ℂ => lineChartAlpha C k G.Ψ i.succ q) U₀ :=
      G.α_holo i.succ
    have h2 : DifferentiableOn ℂ (fun q : ℂ × ℂ => lineChartAlpha C k G.Ψ i.castSucc q) U₀ :=
      G.α_holo i.castSucc
    exact ((h1.sub h2).mul hinv2_U₀).congr fun q _ => by
      change (lineChartAlpha C k G.Ψ i.succ q - lineChartAlpha C k G.Ψ i.castSucc q) / 2 = _
      exact div_eq_mul_inv _ 2
  have hH_entry_cont : ∀ r s : Fin (k - 1),
      ContinuousOn
        (fun q : ℂ × ℂ =>
          lineInteriorHess (fun _ => C.h_ℂ) (fun _ => deriv C.h_ℂ)
            (fun _ => deriv (deriv C.h_ℂ)) (fun u => G.α_fn u q) r s)
        U₀ := by
    intro r s
    have h_holo : DifferentiableOn ℂ
        (fun q : ℂ × ℂ =>
          lineInteriorHess (fun _ => C.h_ℂ) (fun _ => deriv C.h_ℂ)
            (fun _ => deriv (deriv C.h_ℂ)) (fun u => G.α_fn u q) r s)
        U₀ := by
      let i_L : Fin k := ⟨r.1, by have := r.2; omega⟩
      let i_R : Fin k := ⟨r.1 + 1, by have := r.2; omega⟩
      have hh_L : DifferentiableOn ℂ (fun q => C.h_ℂ (G.ψ_fn i_L q)) U₀ :=
        C.h_ℂ_holo.comp (hψ_holo i_L) (G.ψ_maps_strip i_L)
      have hh'_L : DifferentiableOn ℂ (fun q => deriv C.h_ℂ (G.ψ_fn i_L q)) U₀ :=
        hh'_holo.comp (hψ_holo i_L) (G.ψ_maps_strip i_L)
      have hh''_L : DifferentiableOn ℂ (fun q => deriv (deriv C.h_ℂ) (G.ψ_fn i_L q)) U₀ :=
        hh''_holo.comp (hψ_holo i_L) (G.ψ_maps_strip i_L)
      have hh_R : DifferentiableOn ℂ (fun q => C.h_ℂ (G.ψ_fn i_R q)) U₀ :=
        C.h_ℂ_holo.comp (hψ_holo i_R) (G.ψ_maps_strip i_R)
      have hh'_R : DifferentiableOn ℂ (fun q => deriv C.h_ℂ (G.ψ_fn i_R q)) U₀ :=
        hh'_holo.comp (hψ_holo i_R) (G.ψ_maps_strip i_R)
      have hh''_R : DifferentiableOn ℂ (fun q => deriv (deriv C.h_ℂ) (G.ψ_fn i_R q)) U₀ :=
        hh''_holo.comp (hψ_holo i_R) (G.ψ_maps_strip i_R)
      have hsin_L : DifferentiableOn ℂ (fun q => Complex.sin (G.d_fn i_L q)) U₀ :=
        Complex.differentiable_sin.comp_differentiableOn (hd_holo i_L)
      have hcos_L : DifferentiableOn ℂ (fun q => Complex.cos (G.d_fn i_L q)) U₀ :=
        Complex.differentiable_cos.comp_differentiableOn (hd_holo i_L)
      have hsin_R : DifferentiableOn ℂ (fun q => Complex.sin (G.d_fn i_R q)) U₀ :=
        Complex.differentiable_sin.comp_differentiableOn (hd_holo i_R)
      have hcos_R : DifferentiableOn ℂ (fun q => Complex.cos (G.d_fn i_R q)) U₀ :=
        Complex.differentiable_cos.comp_differentiableOn (hd_holo i_R)
      unfold lineInteriorHess
      dsimp only
      split_ifs
      · exact (((((hh''_L.sub hh_L).mul hinv2_U₀).mul hsin_L).add (hh'_L.mul hcos_L)).add
          ((((hh''_R.sub hh_R).mul hinv2_U₀).mul hsin_R).sub (hh'_R.mul hcos_R))).congr
          fun q _ => by
            dsimp only [Pi.add_apply, Pi.sub_apply, Pi.mul_apply, i_L, i_R,
              LineGlancingChartData.ψ_fn, LineGlancingChartData.d_fn,
              lineChartPsi, lineChartHalfStep]
            ring
      · exact (((hh_R.add hh''_R).mul hinv2_U₀).mul hsin_R).congr fun q _ => by
          dsimp only [Pi.add_apply, Pi.sub_apply, Pi.mul_apply, i_R,
            LineGlancingChartData.ψ_fn, LineGlancingChartData.d_fn,
            lineChartPsi, lineChartHalfStep]
          ring
      · exact (((hh_L.add hh''_L).mul hinv2_U₀).mul hsin_L).congr fun q _ => by
          dsimp only [Pi.add_apply, Pi.sub_apply, Pi.mul_apply, i_L,
            LineGlancingChartData.ψ_fn, LineGlancingChartData.d_fn,
            lineChartPsi, lineChartHalfStep]
          ring
      · exact differentiableOn_const 0
    exact h_holo.continuousOn
  let hessDet : ℂ × ℂ → ℂ := fun q =>
    (lineInteriorHess (fun _ => C.h_ℂ) (fun _ => deriv C.h_ℂ)
      (fun _ => deriv (deriv C.h_ℂ)) (fun u => G.α_fn u q)).det
  have hhessDet_cont : ContinuousOn hessDet U₀ := by
    have hfun : hessDet = fun q =>
        ∑ σ : Equiv.Perm (Fin (k - 1)),
          ((Equiv.Perm.sign σ : ℤ) : ℂ) *
            ∏ i : Fin (k - 1),
              lineInteriorHess (fun _ => C.h_ℂ) (fun _ => deriv C.h_ℂ)
                (fun _ => deriv (deriv C.h_ℂ)) (fun u => G.α_fn u q) (σ i) i := by
      ext q
      simp only [hessDet, Matrix.det_apply, Units.smul_def, zsmul_eq_mul]
    rw [hfun]
    exact continuousOn_finset_sum _ fun σ _ =>
      continuousOn_const.mul (continuousOn_finset_prod _ fun i _ => hH_entry_cont (σ i) i)
  let U_hess : Set (ℂ × ℂ) := U₀ ∩ hessDet ⁻¹' ({0}ᶜ)
  have hU_hess_open : IsOpen U_hess :=
    hhessDet_cont.isOpen_inter_preimage hU₀_open isOpen_compl_singleton
  let V₀ : Set (ℂ × ℂ) := connectedComponentIn U_hess p₁
  have hTrap_conv : Convex ℝ (webTrapezoid G.a₀ G.R G.δ_star G.C₀) := by
    intro x hx y hy a b ha hb hab
    rcases eq_or_lt_of_le ha with rfl | ha_pos
    · simp_all
    · refine ⟨?_, ?_, ?_⟩
      · have h1 : 0 < a * x.2 := mul_pos ha_pos hx.1
        have h2 : 0 ≤ b * y.2 := mul_nonneg hb (le_of_lt hy.1)
        change 0 < a * x.2 + b * y.2
        linarith
      · have h1 : a * x.2 < a * G.δ_star := mul_lt_mul_of_pos_left hx.2.1 ha_pos
        have h2 : b * y.2 ≤ b * G.δ_star := mul_le_mul_of_nonneg_left (le_of_lt hy.2.1) hb
        change a * x.2 + b * y.2 < G.δ_star
        calc a * x.2 + b * y.2
            < a * G.δ_star + b * G.δ_star := by linarith
          _ = G.δ_star := by rw [← add_mul, hab, one_mul]
      · change |(a * x.1 + b * y.1) - G.a₀| < G.R - G.C₀ * (a * x.2 + b * y.2)
        have hsplit : (a * x.1 + b * y.1) - G.a₀ = a * (x.1 - G.a₀) + b * (y.1 - G.a₀) := by
          calc (a * x.1 + b * y.1) - G.a₀
              = (a * x.1 + b * y.1) - (a + b) * G.a₀ := by rw [hab, one_mul]
            _ = a * (x.1 - G.a₀) + b * (y.1 - G.a₀) := by ring
        rw [hsplit]
        calc |a * (x.1 - G.a₀) + b * (y.1 - G.a₀)|
            ≤ |a * (x.1 - G.a₀)| + |b * (y.1 - G.a₀)| := abs_add_le _ _
          _ = a * |x.1 - G.a₀| + b * |y.1 - G.a₀| := by
              rw [abs_mul, abs_mul, abs_of_nonneg ha, abs_of_nonneg hb]
          _ < a * (G.R - G.C₀ * x.2) + b * (G.R - G.C₀ * y.2) := by
              have h1 : a * |x.1 - G.a₀| < a * (G.R - G.C₀ * x.2) :=
                mul_lt_mul_of_pos_left hx.2.2 ha_pos
              have h2 : b * |y.1 - G.a₀| ≤ b * (G.R - G.C₀ * y.2) :=
                mul_le_mul_of_nonneg_left (le_of_lt hy.2.2) hb
              linarith
          _ = G.R - G.C₀ * (a * x.2 + b * y.2) := by
              calc a * (G.R - G.C₀ * x.2) + b * (G.R - G.C₀ * y.2)
                  = (a + b) * G.R - G.C₀ * (a * x.2 + b * y.2) := by ring
                _ = G.R - G.C₀ * (a * x.2 + b * y.2) := by rw [hab, one_mul]
  have hTrap_mem_V₀ : ∀ q ∈ webTrapezoid G.a₀ G.R G.δ_star G.C₀,
      ((q.1 : ℂ), (q.2 : ℂ)) ∈ V₀ := by
    let emb : ℝ × ℝ → ℂ × ℂ := fun q => ((q.1 : ℂ), (q.2 : ℂ))
    have hemb_cont : Continuous emb :=
      (Complex.continuous_ofReal.comp continuous_fst).prodMk
        (Complex.continuous_ofReal.comp continuous_snd)
    have himg_preconn : IsPreconnected (emb '' webTrapezoid G.a₀ G.R G.δ_star G.C₀) :=
      hTrap_conv.isPreconnected.image emb hemb_cont.continuousOn
    have hp₁_mem_img : p₁ ∈ emb '' webTrapezoid G.a₀ G.R G.δ_star G.C₀ :=
      ⟨(a₁, δ₁), hq₁_trap, rfl⟩
    have himg_sub : emb '' webTrapezoid G.a₀ G.R G.δ_star G.C₀ ⊆ U_hess := by
      rintro _ ⟨q, hq, rfl⟩
      exact ⟨htrap_sub_U₀ q hq, (G.trapezoid_nondeg q hq).2.2⟩
    have hsub := himg_preconn.subset_connectedComponentIn hp₁_mem_img himg_sub
    intro q hq
    exact hsub ⟨q, hq, rfl⟩
  let p₀ : ℕ := D_form.p - 1
  have hp₀ : p₀ + 1 = D_form.p := Nat.sub_add_cancel D_form.p_pos
  let S_base : LineArcStepAnalyticData C B k G a₁ δ₁ D_form p₀ :=
    { W_ψ := W₀
      V_plus := V₀
      g := fun _ _ _ => 0
      β := fun _ _ _ => 0
      W_ψ_open := hW₀_open
      W_ψ_preconn := hW₀_preconn
      W_ψ_sub_strip := Subset.rfl
      real_mem_W_ψ := fun x _ => by simp [W₀, horizStrip, C.s_h_pos]
      base_ψ_mem := fun i => G.ψ_maps_strip i p₁ hp₁_U₀
      V_plus_open := hU_hess_open.connectedComponentIn
      V_plus_preconn := isPreconnected_connectedComponentIn
      V_plus_sub := (connectedComponentIn_subset U_hess p₁).trans Set.inter_subset_left
      trapezoid_mem_V_plus := hTrap_mem_V₀
      ψ_maps_W_ψ := fun q hq i =>
        G.ψ_maps_strip i q ((connectedComponentIn_subset U_hess p₁ hq).1)
      hess_det_ne_zero := fun q hq => (connectedComponentIn_subset U_hess p₁ hq).2
      g_holo := fun _ _ => differentiableOn_const 0
      g_lt_p := fun _ _ _ _ => rfl
      g_taylor := by
        intro i l hl1
        have hl_lt : (l : ℕ) < D_form.p := by omega
        rw [(D_form.vanish_lt_p (l : ℕ) hl1 hl_lt).1 i]
        ext n
        simp only [lineArcHoloTaylor1D, holoTaylor1D, PowerSeries.coeff_mk, map_zero]
        rcases n with _ | n
        · simp
        · rw [iteratedDeriv_const]
          simp
      β_holo := fun _ _ => differentiableOn_const 0
      β_zero := fun _ _ => rfl
      β_endpoints := fun _ _ => ⟨rfl, rfl⟩
      β_taylor := by
        intro l r hl1
        have hl_lt : (l : ℕ) < D_form.p := by omega
        rw [(D_form.vanish_lt_p (l : ℕ) hl1 hl_lt).2.1 r, hJet.taylor2D_const, map_zero]
      grad_jet_zero := by
        intro q _ r l hl1 _
        rcases l with _ | l
        · omega
        · have hfn :
              (fun ε : ℂ =>
                lineInteriorGrad (lineArcPertSupport (J := p₀) C.h_ℂ (fun _ _ _ => 0) ε)
                  (lineArcPertSupportDeriv (J := p₀) C.h_ℂ (fun _ _ _ => 0) ε)
                  (lineArcPertAngles (J := p₀) (fun s => G.α_fn s q) (fun _ _ => 0) ε) r) =
              fun _ : ℂ =>
                lineInteriorGrad (fun _ => C.h_ℂ) (fun _ => deriv C.h_ℂ)
                  (fun s => G.α_fn s q) r := by
            ext ε
            congr 1
            · ext i z; simp [lineArcPertSupport]
            · ext i z; simp [lineArcPertSupportDeriv]
            · ext s; simp [lineArcPertAngles]
          rw [lineArcEpsJet, hfn, iteratedDeriv_const]
          simp
      action_jet_const := by
        intro q _ l hl1
        have hl_lt : (l : ℕ) < D_form.p := by omega
        rw [(D_form.vanish_lt_p (l : ℕ) hl1 hl_lt).2.2]
        rcases hln : (l : ℕ) with _ | m
        · omega
        · have hfn :
              (fun ε : ℂ =>
                lineChainAction (lineArcPertSupport (J := p₀) C.h_ℂ (fun _ _ _ => 0) ε)
                  (lineArcPertAngles (J := p₀) (fun s => G.α_fn s q) (fun _ _ => 0) ε)) =
              fun _ : ℂ => lineChainAction (fun _ => C.h_ℂ) (fun s => G.α_fn s q) := by
            ext ε
            congr 1
            · ext i z; simp [lineArcPertSupport]
            · ext s; simp [lineArcPertAngles]
          rw [lineArcEpsJet, hfn, iteratedDeriv_const]
          simp }
  obtain ⟨S_lead_raw, _⟩ :=
    line_arc_single_step_web_continuation Ω C B k hk G a₁ δ₁ ha₁ hδ₁ hJet hWeb
      D_form p₀ (by omega) S_base
  let S_p : LineArcStepAnalyticData C B k G a₁ δ₁ D_form D_form.p := hp₀ ▸ S_lead_raw
  let W_lead : Set ℂ := S_p.W_ψ
  let g_lead : Fin k → ℂ → ℂ := fun i => S_p.g i (Fin.last D_form.p)
  let tower : ∀ m : ℕ,
      { S : LineArcStepAnalyticData C B k G a₁ δ₁ D_form (D_form.p + m) //
        ∀ i : Fin k, S.g i ⟨D_form.p, by omega⟩ = g_lead i } :=
    fun m =>
      Nat.rec
        (motive := fun m =>
          { S : LineArcStepAnalyticData C B k G a₁ δ₁ D_form (D_form.p + m) //
            ∀ i : Fin k, S.g i ⟨D_form.p, by omega⟩ = g_lead i })
        ⟨S_p, fun _ => rfl⟩
        (fun m ih =>
          let h_step := line_arc_single_step_web_continuation Ω C B k hk G a₁ δ₁ ha₁ hδ₁
            hJet hWeb D_form (D_form.p + m) (by omega) ih.1
          let S_next := Classical.choose h_step
          have h_eq := Classical.choose_spec h_step
          ⟨S_next, fun i => (h_eq i ⟨D_form.p, by omega⟩).trans (ih.2 i)⟩)
        m
  have h_models : ∀ (m : ℕ), ∀ a ∈ Set.Ioo (G.a₀ - G.R) (G.a₀ + G.R),
      Nonempty (LineTruncatedCoalescingModel k D_form.p (D_form.p + m) a C.h_ℂ
        (fun i => g_lead i (a : ℂ))) := by
    intro m a ha
    let S_m := (tower m).1
    have hg_m := (tower m).2
    have ha_abs : |a - G.a₀| < G.R := abs_lt.mpr ⟨by linarith [ha.1], by linarith [ha.2]⟩
    let δ₀ : ℝ := min G.δ_star ((G.R - |a - G.a₀|) / G.C₀)
    have hδ₀_pos : 0 < δ₀ :=
      lt_min G.δ_star_pos (div_pos (by linarith) G.C₀_pos)
    have h_mem_V : ∀ δ ∈ Set.Ioo (0 : ℝ) δ₀, ((a : ℂ), (δ : ℂ)) ∈ S_m.V_plus := by
      intro δ hδ
      apply S_m.trapezoid_mem_V_plus (a, δ)
      refine ⟨hδ.1, lt_of_lt_of_le hδ.2 (min_le_left _ _), ?_⟩
      have hlt : δ < (G.R - |a - G.a₀|) / G.C₀ := lt_of_lt_of_le hδ.2 (min_le_right _ _)
      have hmul : δ * G.C₀ < G.R - |a - G.a₀| := (lt_div_iff₀ G.C₀_pos).mp hlt
      linarith
    refine ⟨{
      W_n := S_m.W_ψ
      W_n_open := S_m.W_ψ_open
      a_mem := S_m.real_mem_W_ψ a ha_abs
      h_holo := C.h_ℂ_holo.mono S_m.W_ψ_sub_strip
      g := S_m.g
      g_holo := S_m.g_holo
      g_lt_p := fun i l hl z _ => S_m.g_lt_p i l hl z
      g_at_p := fun i _ => congr_fun (hg_m i) (a : ℂ)
      K := fun l => D_form.K_seq (l : ℕ)
      δ₀ := δ₀
      δ₀_pos := hδ₀_pos
      α₀ := fun δ r => G.α_fn r ((a : ℂ), (δ : ℂ))
      β := fun l δ r => S_m.β l r ((a : ℂ), (δ : ℂ))
      β_zero := fun δ r => S_m.β_zero r ((a : ℂ), (δ : ℂ))
      α₀_endpoints := fun δ hδ =>
        G.α_endpoints ((a : ℂ), (δ : ℂ)) (S_m.V_plus_sub (h_mem_V δ hδ))
      β_endpoints := fun l δ => S_m.β_endpoints l ((a : ℂ), (δ : ℂ))
      α₀_tendsto := by
        intro r
        have ha0_U₀ : ((a : ℂ), (0 : ℂ)) ∈ U₀ := by
          refine ⟨?_, ?_⟩
          · rw [LineGlancingChartData.U_a, Metric.mem_ball, Complex.dist_eq,
              ← Complex.ofReal_sub, Complex.norm_real, Real.norm_eq_abs]
            linarith [G.R_pos]
          · rw [LineGlancingChartData.U_d, Metric.mem_ball, dist_zero_right, norm_zero]
            linarith [G.δ_star_pos]
        let φ : ℂ → ℂ := fun z => G.α_fn r ((a : ℂ), z)
        have hφ_diff : DifferentiableAt ℂ φ 0 :=
          ((G.α_holo r).differentiableAt (hU₀_open.mem_nhds ha0_U₀)).comp 0
            ((differentiableAt_const (a : ℂ)).prodMk differentiableAt_id)
        have hφ_deriv : HasDerivAt φ (((r : ℕ) : ℂ) / (k : ℂ)) 0 :=
          (G.α_at_zero r a ha_abs).2 ▸ hφ_diff.hasDerivAt
        have h_slope := hφ_deriv.tendsto_slope_zero
        have h_ofReal : Filter.Tendsto (fun δ : ℝ => (δ : ℂ))
            (nhdsWithin (0 : ℝ) (Set.Ioi 0)) (nhdsWithin (0 : ℂ) {(0 : ℂ)}ᶜ) :=
          tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within _
            (((Complex.continuous_ofReal.tendsto 0).mono_left nhdsWithin_le_nhds) :
              Filter.Tendsto (fun δ : ℝ => (δ : ℂ)) (nhdsWithin 0 (Set.Ioi 0)) (nhds (0 : ℂ)))
            (eventually_nhdsWithin_of_forall fun δ (hδ : 0 < δ) =>
              Set.mem_compl_singleton_iff.mpr (Complex.ofReal_ne_zero.mpr (ne_of_gt hδ)))
        refine (h_slope.comp h_ofReal).congr fun δ => ?_
        dsimp only [Function.comp_apply, φ]
        have h0 : G.α_fn r ((a : ℂ), 0) = (a : ℂ) := (G.α_at_zero r a ha_abs).1
        rw [zero_add, h0, smul_eq_mul, inv_mul_eq_div]
      α₀_maps_W_n := fun δ hδ i => S_m.ψ_maps_W_ψ ((a : ℂ), (δ : ℂ)) (h_mem_V δ hδ) i
      α₀_stat := fun δ hδ r =>
        G.stationary_on_chart ((a : ℂ), (δ : ℂ)) (S_m.V_plus_sub (h_mem_V δ hδ)) r
      grad_jet_zero := by
        intro δ hδ r l hl1 hlJ
        have h_div := S_m.grad_jet_zero ((a : ℂ), (δ : ℂ)) (h_mem_V δ hδ) r l hl1 hlJ
        unfold lineArcEpsJet at h_div
        have h_fac : (l.factorial : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero l)
        exact (div_eq_zero_iff.mp h_div).resolve_right h_fac
      action_jet_const := fun δ hδ l hl1 =>
        S_m.action_jet_const ((a : ℂ), (δ : ℂ)) (h_mem_V δ hδ) l hl1
    }⟩
  refine ⟨{
    p := D_form.p
    p_pos := D_form.p_pos
    f_lead := fun i => D_form.f_full i D_form.p
    i₀ := D_form.i₀
    f_lead_i₀_ne_zero := D_form.f_lead_ne_zero
    W_lead := W_lead
    W_lead_open := S_p.W_ψ_open
    W_lead_preconn := S_p.W_ψ_preconn
    real_mem_W_lead := S_p.real_mem_W_ψ
    g_lead := g_lead
    g_lead_holo := fun i => S_p.g_holo i (Fin.last D_form.p)
    g_lead_taylor := by
      intro i
      refine ⟨S_p.base_ψ_mem i, fun n => ?_⟩
      have ht := congr_arg (PowerSeries.coeff n)
        (S_p.g_taylor i (Fin.last D_form.p) D_form.p_pos)
      simpa [lineArcHoloTaylor1D, holoTaylor1D, g_lead] using ht
    trunc_models := by
      intro J hJp a ha
      have hJ_eq : D_form.p + (J - D_form.p) = J := Nat.add_sub_of_le hJp
      exact hJ_eq ▸ h_models (J - D_form.p) a ha
  }⟩

theorem line_coalescing_cubic_variational_zero (k p : ℕ) (hk : 2 ≤ k) (hp : 1 ≤ p)
    (a : ℝ) (h_ℂ : ℂ → ℂ)
    (hr_ne : h_ℂ (a : ℂ) + deriv (deriv h_ℂ) (a : ℂ) ≠ 0)
    (f_p : Fin k → ℂ)
    (hAlg : AlgebraicLiftingToolkit)
    (hModels : ∀ n : ℕ, 2 ≤ n →
      Nonempty (LineTruncatedCoalescingModel k p (n * p) a h_ℂ f_p)) :
    ∀ i : Fin k, f_p i = 0 :=
by
  
  let c_ext : ℕ → Fin (k + 1) → ℂ :=
    lineCoalescingFormalSeq k (h_ℂ (a : ℂ) + deriv (deriv h_ℂ) (a : ℂ)) f_p
  have hP1 :
      (lineCoalescingTridiag (k - 1)).det ≠ 0 ∧
      ((∀ d : ℕ,
          ∑ i : Fin k,
            f_p i * (c_ext d i.succ - c_ext d i.castSucc) = 0) →
        ∀ i : Fin k, f_p i = 0) := by
    let r_a : ℂ := h_ℂ (a : ℂ) + deriv (deriv h_ℂ) (a : ℂ)
    have h_sqrt := hAlg.sqrt_power_sum_zero
    have hk_ne : (k : ℂ) ≠ 0 := by exact_mod_cast (by omega : k ≠ 0)
    have hT_det : ∀ m : ℕ, (lineCoalescingTridiag m).det ≠ 0 := by
      intro m
      let L_m : Matrix (Fin m) (Fin m) ℂ := fun r t =>
        if r.1 = t.1 then 1
        else if r.1 = t.1 + 1 then -(((t.1 : ℂ) + 1) / ((t.1 : ℂ) + 2))
        else 0
      let U_m : Matrix (Fin m) (Fin m) ℂ := fun t s =>
        if t.1 = s.1 then ((t.1 : ℂ) + 2) / ((t.1 : ℂ) + 1)
        else if s.1 = t.1 + 1 then -1
        else 0
      have hL_tri : L_m.IsLowerTriangular := by
        intro r t hrt
        have hlt : r.1 < t.1 := hrt
        dsimp only [L_m]
        rw [if_neg (by omega), if_neg (by omega)]
      have hU_tri : U_m.IsUpperTriangular := by
        intro t s hst
        have hlt : s.1 < t.1 := hst
        dsimp only [U_m]
        rw [if_neg (by omega), if_neg (by omega)]
      have hLU : L_m * U_m = lineCoalescingTridiag m := by
        ext r s
        rw [Matrix.mul_apply]
        by_cases hr0 : r.1 = 0
        · rw [Fintype.sum_eq_single r]
          · dsimp only [L_m, U_m, lineCoalescingTridiag]
            rw [if_pos rfl, one_mul, hr0]
            by_cases hs0 : s.1 = 0
            · simp [hs0]
            · have h0s : ¬ (0 = s.1) := fun h => hs0 h.symm
              by_cases hs1 : s.1 = 1
              · simp [hs1]
              · have hs01 : ¬ (s.1 = 0 + 1) := by omega
                have h0s1 : ¬ (0 = s.1 + 1) := by omega
                simp [h0s, hs01, h0s1]
          · intro t htr
            have ht_ne : t.1 ≠ 0 := fun h => htr (Fin.ext (h.trans hr0.symm))
            dsimp only [L_m]
            split_ifs <;> first | omega | ring
        · let r_prev : Fin m := ⟨r.1 - 1, by omega⟩
          have hr_ne_prev : r ≠ r_prev := by
            intro h
            have := congr_arg Fin.val h
            dsimp [r_prev] at this
            omega
          rw [Fintype.sum_eq_add r r_prev hr_ne_prev]
          · have h_rp1 : ((r_prev.1 : ℂ) + 1) ≠ 0 := by
              exact_mod_cast (by omega : r_prev.1 + 1 ≠ 0)
            have h_rp2 : ((r_prev.1 : ℂ) + 2) ≠ 0 := by
              exact_mod_cast (by omega : r_prev.1 + 2 ≠ 0)
            have hr_eq : (r.1 : ℂ) = (r_prev.1 : ℂ) + 1 := by
              dsimp [r_prev]
              exact_mod_cast (by omega : r.1 = r.1 - 1 + 1)
            have hL_rr : L_m r r = 1 := by simp [L_m]
            have hL_rp : L_m r r_prev = -(((r_prev.1 : ℂ) + 1) / ((r_prev.1 : ℂ) + 2)) := by
              dsimp only [L_m]
              rw [if_neg (by dsimp [r_prev]; omega), if_pos (by dsimp [r_prev]; omega)]
            rw [hL_rr, hL_rp]
            by_cases hsr : r.1 = s.1
            · have h1 : U_m r s = ((r_prev.1 : ℂ) + 3) / ((r_prev.1 : ℂ) + 2) := by
                dsimp only [U_m]
                rw [if_pos hsr, hr_eq]
                ring
              have h2 : U_m r_prev s = -1 := by
                dsimp only [U_m]
                rw [if_neg (by dsimp [r_prev]; omega), if_pos (by dsimp [r_prev]; omega)]
              have h3 : lineCoalescingTridiag m r s = 2 := by simp [lineCoalescingTridiag, hsr]
              rw [h1, h2, h3]
              field_simp
              ring
            · by_cases hs_succ : s.1 = r.1 + 1
              · have h1 : U_m r s = -1 := by
                  dsimp only [U_m]
                  rw [if_neg hsr, if_pos hs_succ]
