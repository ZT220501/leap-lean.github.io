        rw [hμ_r r, (G_gr.θ_right_inv z hz_WF).1]
      refine ⟨h2_zero, hx_r, hμ_r, ?_, ?_⟩
      · intro i; simp [h2_zero, hΘ_yz]
      · intro i; simp [pointChartEll, h2_zero]
    have hx_deriv_d_zero : ∀ r : Fin (k + 1), ∀ z ∈ Metric.ball (G_gr.a₀ : ℂ) (2 * R₀),
