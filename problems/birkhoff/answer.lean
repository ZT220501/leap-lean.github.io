                  (U_w ×ˢ upperHalfDiskBdry) :=
                hG_holo.continuousOn.comp continuousOn_snd
                  (fun p hp => (hCollar_Uw_mem p.2 (hBdry_sub_collar hp.2) T_c hTc p.1 hp.1).1)
              have hmap_cont : ContinuousOn
                  (fun p : ℂ × ℂ => (p.2, p.1 + G p.2 - G T_c))
                  (U_w ×ˢ upperHalfDiskBdry) :=
