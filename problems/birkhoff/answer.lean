        · have h_eq : u_lt i = u i := ite_eq_left_iff.mpr (fun h => absurd ⟨hi, hij⟩ h)
          rw [h_eq]; exact hu i hi hij
        · have h_eq : u_lt i = fun _ => 0 := ite_eq_right_iff.mpr (fun h => (hij h.2).elim)
          rw [h_eq]
