            (2 * Z_mart m w) * (d u * κ m u) + (d u) ^ 2 * κ m u := by
          intro u
          rw [hΔY2_eq]
          have hAm_u : A_surv m (dtpcStepExtend m w u) :=
            (hA_dep m (dtpcStepExtend m w u) w (fun i hi => h_ext_le i hi u)).mpr hAm
          have hZm_u : Z_mart m (dtpcStepExtend m w u) = Z_mart m w :=
            hZ_dep m (dtpcStepExtend m w u) w (fun i hi => h_ext_le i hi u)
          have hCm_u : C_pred m (dtpcStepExtend m w u) := by
            intro hE_u; apply hCm; intro i hi
            have him : i ≤ m := by have := Finset.mem_range.mp hi; omega
            simpa [h_ext_le i him u] using hE_u i hi
          have h_not : ¬ (m + 1 ≤ m) := by omega
          have hξ_u : ξ_inc m (dtpcStepExtend m w u) = d u := by
            simp [ξ_inc, hCm_u, dtpcStepExtend, h_not, d, x]
          simp only [hAm_u, ↓reduceIte, hZm_u, hξ_u]; ring
        have hQ_decomp_pt : ∀ u : ℝ, (g (m + 1) (x + u) - g m x) ^ 2 * κ m u =
            ((d u) ^ 2 * κ m u + (2 * b) * (d u * κ m u)) + b ^ 2 * κ m u := by
          intro u; simp only [d, b]; ring
        have h_int_d2_add : MeasureTheory.Integrable
            (fun u : ℝ => (d u) ^ 2 * κ m u + (2 * b) * (d u * κ m u)) MeasureTheory.volume :=
          h_int_d2.add (h_int_d.const_mul (2 * b))
        simp_rw [hY_inner_pt, hQ_decomp_pt]
        rw [MeasureTheory.integral_add (h_int_d.const_mul (2 * Z_mart m w)) h_int_d2,
          MeasureTheory.integral_const_mul, h_d_zero, mul_zero, zero_add,
          MeasureTheory.integral_add h_int_d2_add ((hκ_int m hm).const_mul (b ^ 2)),
          MeasureTheory.integral_add h_int_d2 (h_int_d.const_mul (2 * b)),
          MeasureTheory.integral_const_mul, h_d_zero, mul_zero, add_zero,
          MeasureTheory.integral_const_mul, hκ_one m hm, mul_one]
        linarith [sq_nonneg b]
      · have hY_zero : ∀ u : ℝ, ΔY2 m (dtpcStepExtend m w u) * κ m u = 0 := by
          intro u
          rw [hΔY2_eq]
          by_cases hAm : A_surv m w
          · have hCm : ¬ C_pred m w := fun hc => hAC ⟨hAm, hc⟩
            have h_not_Cm_u : ¬ C_pred m (dtpcStepExtend m w u) := by
              intro hc_u; apply hCm; intro hE_w; apply hc_u; intro i hi
              have him : i ≤ m := by have := Finset.mem_range.mp hi; omega
              simpa [h_ext_le i him u] using hE_w i hi
            have hξ_zero : ξ_inc m (dtpcStepExtend m w u) = 0 := by simp [ξ_inc, h_not_Cm_u]
            split_ifs <;> simp [hξ_zero]
          · have h_not_Am_u : ¬ A_surv m (dtpcStepExtend m w u) :=
              fun ha_u => hAm ((hA_dep m (dtpcStepExtend m w u) w (fun i hi => h_ext_le i hi u)).mp ha_u)
            simp [h_not_Am_u]
        simp_rw [hY_zero, MeasureTheory.integral_zero]
        exact MeasureTheory.integral_nonneg (fun u => mul_nonneg (sq_nonneg _) (hκ_nonneg m hm u))
    have h_tel : ∀ om : dtpcChainSpace M,
        (Y_stop M (dtpcChainPath M om)) ^ 2 =
          ∑ m ∈ Finset.range M, ΔY2 m (dtpcChainPath M om) := by
      intro om
      have h_sub_tel := Finset.sum_range_sub (fun k => (Y_stop k (dtpcChainPath M om)) ^ 2) M
      have hY0 : Y_stop 0 (dtpcChainPath M om) = 0 := by simp [Y_stop]
      rw [hY0] at h_sub_tel
      linarith
    simp_rw [h_tel]
    rw [MeasureTheory.integral_finsetSum (Finset.range M) (fun m hm => by
        have hm' : m < M := Finset.mem_range.mp hm
        exact hChainIntOfBdd M le_rfl (ΔY2 m) (2 * ((M : ℝ) * (2 * B)) ^ 2)
          (((hY_meas (m + 1) (by omega)).pow_const 2).sub ((hY_meas m (by omega)).pow_const 2))
          (fun w => by
            have h1 := hY_bdd (m + 1) (by omega) w
            have h2 := hY_bdd m (by omega) w
            have h1s : (Y_stop (m + 1) w) ^ 2 ≤ ((M : ℝ) * (2 * B)) ^ 2 := by
              nlinarith [sq_abs (Y_stop (m + 1) w), abs_nonneg (Y_stop (m + 1) w)]
            have h2s : (Y_stop m w) ^ 2 ≤ ((M : ℝ) * (2 * B)) ^ 2 := by
              nlinarith [sq_abs (Y_stop m w), abs_nonneg (Y_stop m w)]
            calc |ΔY2 m w|
                ≤ |(Y_stop (m + 1) w) ^ 2| + |(Y_stop m w) ^ 2| := abs_sub _ _
              _ = (Y_stop (m + 1) w) ^ 2 + (Y_stop m w) ^ 2 := by
                  rw [abs_of_nonneg (sq_nonneg _), abs_of_nonneg (sq_nonneg _)]
              _ ≤ 2 * ((M : ℝ) * (2 * B)) ^ 2 := by linarith)),
      show (∫ om, QVar (dtpcChainPath M om) ∂dtpcChainMeasure κ M) =
        ∑ m ∈ Finset.range M, ∫ om, ΔQ m (dtpcChainPath M om) ∂dtpcChainMeasure κ M from
        MeasureTheory.integral_finsetSum (Finset.range M) (fun m hm => by
          have hm' : m < M := Finset.mem_range.mp hm
          exact hChainIntOfBdd M le_rfl (ΔQ m) (4 * B ^ 2)
            (((hMeasG (m + 1) (by omega)).sub (hMeasG m (by omega))).pow_const 2)
            (hQTermBdd m hm'))]
    exact Finset.sum_le_sum (fun m hm => h_step_L2 m (Finset.mem_range.mp hm))
  have hPostBound : (∫ om, PostOccup (dtpcChainPath M om) ∂dtpcChainMeasure κ M) ≤
      (M : ℝ) * h ^ 2 * (∫ om, QVar (dtpcChainPath M om) ∂dtpcChainMeasure κ M) / (R - h) ^ 2 := by
    have hPost_int := hChainIntOfBdd M le_rfl PostOccup ((M : ℝ) * h ^ 2) hPostOccupMeas hPostOccupBdd
    have hYM2_int : MeasureTheory.Integrable
        (fun om => (Y_stop M (dtpcChainPath M om)) ^ 2) (dtpcChainMeasure κ M) :=
      hChainIntOfBdd M le_rfl (fun w => (Y_stop M w) ^ 2) (((M : ℝ) * (2 * B)) ^ 2)
        ((hY_meas M le_rfl).pow_const 2)
        (fun w => by
          rw [abs_of_nonneg (sq_nonneg _)]
          have h1 := hY_bdd M le_rfl w
          nlinarith [sq_abs (Y_stop M w), abs_nonneg (Y_stop M w)])
    have h_dom_int := MeasureTheory.integral_mono hPost_int
      (hYM2_int.const_mul ((M : ℝ) * h ^ 2 / (R - h) ^ 2))
      (fun om => hPostDom (dtpcChainPath M om))
    rw [MeasureTheory.integral_const_mul] at h_dom_int
    have h_mul_L2 : ((M : ℝ) * h ^ 2 / (R - h) ^ 2) *
          (∫ om, (Y_stop M (dtpcChainPath M om)) ^ 2 ∂dtpcChainMeasure κ M) ≤
        ((M : ℝ) * h ^ 2 / (R - h) ^ 2) *
          (∫ om, QVar (dtpcChainPath M om) ∂dtpcChainMeasure κ M) :=
      mul_le_mul_of_nonneg_left hYM_L2 (by positivity)
    calc (∫ om, PostOccup (dtpcChainPath M om) ∂dtpcChainMeasure κ M)
        ≤ ((M : ℝ) * h ^ 2 / (R - h) ^ 2) *
            (∫ om, QVar (dtpcChainPath M om) ∂dtpcChainMeasure κ M) :=
          le_trans h_dom_int h_mul_L2
      _ = (M : ℝ) * h ^ 2 *
            (∫ om, QVar (dtpcChainPath M om) ∂dtpcChainMeasure κ M) / (R - h) ^ 2 := by ring
  
  rw [hOccSplit, hVarSplit]
  exact add_le_add hPreBound hPostBound

theorem strip_exit_kernel_and_submean (S : FiniteWallNonisotropicStrip) :
    StripExitKernelData S :=
by
  have h_base : ∀ H_p y₀ : ℝ, 0 < H_p → |y₀| < H_p →
      Continuous (stripExitKernel H_p y₀) ∧
      (∀ u : ℝ, 0 < stripExitKernel H_p y₀ u) ∧
      MeasureTheory.Integrable (stripExitKernel H_p y₀) MeasureTheory.volume ∧
      (∫ u : ℝ, stripExitKernel H_p y₀ u) = 1 ∧
      ∀ A : ℝ, 0 < A →
        (∫ u in {u : ℝ | A < |u|}, stripExitKernel H_p y₀ u) =
          (2 / Real.pi) * Real.arctan
            (Real.cos (Real.pi * y₀ / (2 * H_p)) / Real.sinh (Real.pi * A / (2 * H_p))) := by
    intro H_p y₀ hHp hy₀
    have hy₀_bounds : -H_p < y₀ ∧ y₀ < H_p := abs_lt.mp hy₀
    set θ : ℝ := Real.pi * y₀ / (2 * H_p)
    have h2Hp_pos : 0 < 2 * H_p := by positivity
    have hθ_mem : θ ∈ Set.Ioo (-(Real.pi / 2)) (Real.pi / 2) := by
      constructor
      · rw [lt_div_iff₀ h2Hp_pos]
        nlinarith [Real.pi_pos, hy₀_bounds.1]
      · rw [div_lt_iff₀ h2Hp_pos]
        nlinarith [Real.pi_pos, hy₀_bounds.2]
    have hcos_pos : 0 < Real.cos θ := Real.cos_pos_of_mem_Ioo hθ_mem
    have h_denom_eq : ∀ u : ℝ,
        Real.cosh (Real.pi * u / (2 * H_p)) ^ 2 - Real.sin θ ^ 2 =
          Real.sinh (Real.pi * u / (2 * H_p)) ^ 2 + Real.cos θ ^ 2 := by
      intro u
      have hc := Real.cosh_sq (Real.pi * u / (2 * H_p))
      have hs := Real.sin_sq θ
      linarith
    have h_denom_pos : ∀ u : ℝ,
        0 < Real.cosh (Real.pi * u / (2 * H_p)) ^ 2 - Real.sin θ ^ 2 := by
      intro u
      rw [h_denom_eq u]
      positivity
    have h_pos : ∀ u : ℝ, 0 < stripExitKernel H_p y₀ u := by
      intro u
      unfold stripExitKernel
      have hch : 0 < Real.cosh (Real.pi * u / (2 * H_p)) := Real.cosh_pos _
      have hd : 0 < Real.cosh (Real.pi * u / (2 * H_p)) ^ 2 - Real.sin θ ^ 2 := h_denom_pos u
      positivity
    have h_cont : Continuous (stripExitKernel H_p y₀) := by
      unfold stripExitKernel
      have h_lin : Continuous (fun u : ℝ => Real.pi * u / (2 * H_p)) :=
        (continuous_const.mul continuous_id).div_const _
      have h_ch : Continuous (fun u : ℝ => Real.cosh (Real.pi * u / (2 * H_p))) :=
        Real.continuous_cosh.comp h_lin
      refine Continuous.div ?_ ?_ (fun u => ne_of_gt (h_denom_pos u))
      · exact continuous_const.mul (h_ch.mul continuous_const)
      · exact (h_ch.pow 2).sub continuous_const
    have h_even : ∀ u : ℝ, stripExitKernel H_p y₀ (-u) = stripExitKernel H_p y₀ u := by
      intro u
      unfold stripExitKernel
      have hneg : Real.pi * (-u) / (2 * H_p) = -(Real.pi * u / (2 * H_p)) := by ring
      rw [hneg, Real.cosh_neg]
    let F : ℝ → ℝ := fun u =>
      Real.pi⁻¹ * Real.arctan (Real.sinh (Real.pi * u / (2 * H_p)) / Real.cos θ)
    have hF_deriv : ∀ u : ℝ, HasDerivAt F (stripExitKernel H_p y₀ u) u := by
      intro u
      have h1 : HasDerivAt (fun t : ℝ => Real.pi * t / (2 * H_p)) (Real.pi / (2 * H_p)) u := by
        simpa using ((hasDerivAt_id u).const_mul Real.pi).div_const (2 * H_p)
      have h2 : HasDerivAt (fun t : ℝ => Real.sinh (Real.pi * t / (2 * H_p)))
          (Real.cosh (Real.pi * u / (2 * H_p)) * (Real.pi / (2 * H_p))) u :=
        (Real.hasDerivAt_sinh _).comp u h1
      have h3 := (h2.div_const (Real.cos θ)).arctan.const_mul Real.pi⁻¹
      convert h3 using 1
      unfold stripExitKernel
      change (2 * H_p)⁻¹ * (Real.cosh (Real.pi * u / (2 * H_p)) * Real.cos θ) /
          (Real.cosh (Real.pi * u / (2 * H_p)) ^ 2 - Real.sin θ ^ 2) = _
      rw [h_denom_eq u]
      have hpi_ne : Real.pi ≠ 0 := Real.pi_ne_zero
      have hHp_ne : H_p ≠ 0 := ne_of_gt hHp
      have hcos_ne : Real.cos θ ≠ 0 := ne_of_gt hcos_pos
      have hd_ne : Real.sinh (Real.pi * u / (2 * H_p)) ^ 2 + Real.cos θ ^ 2 ≠ 0 := by positivity
      field_simp
      ring
    have hF_tendsto : Filter.Tendsto F Filter.atTop (nhds (1 / 2 : ℝ)) := by
      have h_lin_top : Filter.Tendsto (fun u : ℝ => Real.pi * u / (2 * H_p))
          Filter.atTop Filter.atTop := by
        have hpos : 0 < Real.pi / (2 * H_p) := by positivity
        exact (Filter.tendsto_id.const_mul_atTop hpos).congr (fun u => by simp only [id_eq]; ring)
      have h_sinh_top : Filter.Tendsto Real.sinh Filter.atTop Filter.atTop := by
        refine Filter.tendsto_atTop_mono' Filter.atTop ?_ Filter.tendsto_id
        filter_upwards [Filter.eventually_ge_atTop (0 : ℝ)] with x hx
        exact Real.self_le_sinh_iff.mpr hx
      have h_quot_top : Filter.Tendsto
          (fun u : ℝ => Real.sinh (Real.pi * u / (2 * H_p)) / Real.cos θ)
          Filter.atTop Filter.atTop :=
        ((h_sinh_top.comp h_lin_top).const_mul_atTop (inv_pos.mpr hcos_pos)).congr
          (fun u => (inv_mul_eq_div _ _))
      have h_atan :=
        ((Real.tendsto_arctan_atTop.mono_right nhdsWithin_le_nhds).comp h_quot_top).const_mul
          Real.pi⁻¹
      convert h_atan using 1
      have hpi_ne : Real.pi ≠ 0 := Real.pi_ne_zero
      congr 1
      field_simp
    have h_Ioi_int : ∀ a : ℝ,
        MeasureTheory.IntegrableOn (stripExitKernel H_p y₀) (Set.Ioi a) MeasureTheory.volume :=
      fun a => MeasureTheory.integrableOn_Ioi_deriv_of_nonneg'
        (fun x _ => hF_deriv x) (fun x _ => le_of_lt (h_pos x)) hF_tendsto
    have h_Ioi_val : ∀ a : ℝ,
        (∫ u in Set.Ioi a, stripExitKernel H_p y₀ u) = 1 / 2 - F a :=
      fun a => MeasureTheory.integral_Ioi_of_hasDerivAt_of_nonneg'
        (fun x _ => hF_deriv x) (fun x _ => le_of_lt (h_pos x)) hF_tendsto
    have h_ind_neg : ∀ a : ℝ,
        (fun u : ℝ => (Set.Ioi a).indicator (stripExitKernel H_p y₀) (-u)) =
          (Set.Iio (-a)).indicator (stripExitKernel H_p y₀) := by
      intro a
      ext u
      by_cases hu : u < -a
      · have hnu : -u ∈ Set.Ioi a := by simp only [Set.mem_Ioi]; linarith
        have hu' : u ∈ Set.Iio (-a) := hu
        rw [Set.indicator_of_mem hnu, Set.indicator_of_mem hu', h_even u]
      · have hnu : -u ∉ Set.Ioi a := by simp only [Set.mem_Ioi]; linarith
        have hu' : u ∉ Set.Iio (-a) := hu
        simp only [Set.indicator, hnu, hu', ↓reduceIte]
    have h_Iio_int : ∀ a : ℝ,
        MeasureTheory.IntegrableOn (stripExitKernel H_p y₀) (Set.Iio (-a)) MeasureTheory.volume := by
      intro a
      rw [← MeasureTheory.integrable_indicator_iff measurableSet_Iio, ← h_ind_neg a]
      exact ((MeasureTheory.integrable_indicator_iff measurableSet_Ioi).mpr (h_Ioi_int a)).comp_neg
    have h_Iio_val : ∀ a : ℝ,
        (∫ u in Set.Iio (-a), stripExitKernel H_p y₀ u) = 1 / 2 - F a := by
      intro a
      rw [← MeasureTheory.integral_indicator measurableSet_Iio, ← h_ind_neg a,
        MeasureTheory.integral_neg_eq_self, MeasureTheory.integral_indicator measurableSet_Ioi,
        h_Ioi_val a]
    have hF0 : F 0 = 0 := by simp [F]
    have h_Iic0_int : MeasureTheory.IntegrableOn (stripExitKernel H_p y₀) (Set.Iic 0)
        MeasureTheory.volume := by
      have h0 := h_Iio_int 0
      rw [neg_zero] at h0
      exact h0.congr_set_ae MeasureTheory.Iio_ae_eq_Iic.symm
    have h_Iic0_val : (∫ u in Set.Iic 0, stripExitKernel H_p y₀ u) = 1 / 2 := by
      rw [← MeasureTheory.setIntegral_congr_set MeasureTheory.Iio_ae_eq_Iic]
      have h0 := h_Iio_val 0
      rw [neg_zero, hF0, sub_zero] at h0
      exact h0
    have h_univ_eq : Set.Iic (0 : ℝ) ∪ Set.Ioi (0 : ℝ) = Set.univ := Set.Iic_union_Ioi
    have h_disj0 : Disjoint (Set.Iic (0 : ℝ)) (Set.Ioi (0 : ℝ)) := Set.Iic_disjoint_Ioi le_rfl
    have h_int : MeasureTheory.Integrable (stripExitKernel H_p y₀) MeasureTheory.volume := by
      rw [← MeasureTheory.integrableOn_univ, ← h_univ_eq]
      exact h_Iic0_int.union (h_Ioi_int 0)
    have h_mass : (∫ u : ℝ, stripExitKernel H_p y₀ u) = 1 := by
      rw [← MeasureTheory.setIntegral_univ, ← h_univ_eq,
        MeasureTheory.setIntegral_union h_disj0 measurableSet_Ioi h_Iic0_int (h_Ioi_int 0),
        h_Iic0_val, h_Ioi_val 0, hF0]
      norm_num
    refine ⟨h_cont, h_pos, h_int, h_mass, ?_⟩
    intro A hA
    have h_set_eq : {u : ℝ | A < |u|} = Set.Iio (-A) ∪ Set.Ioi A := by
      ext u
      change A < |u| ↔ u ∈ Set.Iio (-A) ∪ Set.Ioi A
      simp only [Set.mem_union, Set.mem_Iio, Set.mem_Ioi, lt_abs]
      constructor
      · rintro (h | h)
        · exact Or.inr h
        · exact Or.inl (by linarith)
      · rintro (h | h)
        · exact Or.inr (by linarith)
        · exact Or.inl h
    have h_disjA : Disjoint (Set.Iio (-A)) (Set.Ioi A) := by
      rw [Set.disjoint_iff]
      intro u hu
      simp only [Set.mem_inter_iff, Set.mem_Iio, Set.mem_Ioi] at hu
      linarith [hu.1, hu.2]
    rw [h_set_eq,
      MeasureTheory.setIntegral_union h_disjA measurableSet_Ioi (h_Iio_int A) (h_Ioi_int A),
      h_Iio_val A, h_Ioi_val A]
    have h_arg_pos : 0 < Real.pi * A / (2 * H_p) := by positivity
    have h_sinh_pos : 0 < Real.sinh (Real.pi * A / (2 * H_p)) :=
      Real.sinh_pos_iff.mpr h_arg_pos
    set t : ℝ := Real.sinh (Real.pi * A / (2 * H_p)) / Real.cos θ
    have ht_pos : 0 < t := div_pos h_sinh_pos hcos_pos
    have h_inv : Real.cos θ / Real.sinh (Real.pi * A / (2 * H_p)) = t⁻¹ :=
      (inv_div _ _).symm
    rw [h_inv, Real.arctan_inv_of_pos ht_pos]
    dsimp only [F]
    have hpi_ne : Real.pi ≠ 0 := Real.pi_ne_zero
    field_simp
    ring
  have h_tail_le : ∀ d d' R : ℝ, 0 < d' → d' < d → d < S.H → 0 < R →
      (∫ u in {u : ℝ | R * d < |u|}, stripExitKernel (S.H - d') (S.H - d) u) ≤ 1 / R := by
    intro d d' R hd' hdd' hd hR
    have hd_pos : 0 < d := lt_trans hd' hdd'
    set H_p : ℝ := S.H - d'
    set y₀ : ℝ := S.H - d
    have hHp : 0 < H_p := by linarith
    have hy₀_pos : 0 < y₀ := by linarith
    have hy₀_lt : |y₀| < H_p := by rw [abs_of_pos hy₀_pos]; linarith
    have hA_pos : 0 < R * d := mul_pos hR hd_pos
    have h_tail := (h_base H_p y₀ hHp hy₀_lt).2.2.2.2 (R * d) hA_pos
    rw [h_tail]
    set φ : ℝ := Real.pi * (d - d') / (2 * H_p)
    have hφ_pos : 0 < φ := by
      have hdd'_pos : 0 < d - d' := sub_pos.mpr hdd'
      positivity
    have h_cos_eq : Real.cos (Real.pi * y₀ / (2 * H_p)) = Real.sin φ := by
      have h_ang : Real.pi * y₀ / (2 * H_p) = Real.pi / 2 - φ := by
        dsimp only [y₀, H_p, φ]
        have hHp_ne : S.H - d' ≠ 0 := ne_of_gt hHp
        field_simp
        ring
      rw [h_ang, Real.cos_pi_div_two_sub]
    rw [h_cos_eq]
    set β : ℝ := Real.pi * (R * d) / (2 * H_p)
    have hβ_pos : 0 < β := by positivity
    have h_sinh_ge : β ≤ Real.sinh β := Real.self_le_sinh_iff.mpr (le_of_lt hβ_pos)
    have h_sinh_pos : 0 < Real.sinh β := lt_of_lt_of_le hβ_pos h_sinh_ge
    have h_sin_le : Real.sin φ ≤ Real.pi * d / (2 * H_p) := by
      refine le_trans (Real.sin_le (le_of_lt hφ_pos)) ?_
      dsimp only [φ]
      gcongr
      linarith
    set q : ℝ := Real.sin φ / Real.sinh β
    have hq_nonneg : 0 ≤ q := by
      dsimp only [q]
      have h_sin_nonneg : 0 ≤ Real.sin φ := by
        by_cases hφ_pi : φ ≤ Real.pi
        · exact Real.sin_nonneg_of_nonneg_of_le_pi (le_of_lt hφ_pos) hφ_pi
        · exfalso
          have : φ < Real.pi / 2 := by
            dsimp only [φ, H_p]
            rw [div_lt_div_iff₀ (by positivity) (by positivity)]
            nlinarith [Real.pi_pos]
          linarith [Real.pi_pos]
      exact div_nonneg h_sin_nonneg (le_of_lt h_sinh_pos)
    have h_atan_le : Real.arctan q ≤ q := by
      rcases eq_or_lt_of_le hq_nonneg with hq0 | hq_pos
      · rw [← hq0, Real.arctan_zero]
      · obtain ⟨c, _, h_eq_slope⟩ := exists_hasDerivAt_eq_slope Real.arctan
          (fun x => 1 / (1 + x ^ 2)) hq_pos Real.continuous_arctan.continuousOn
          (fun x _ => Real.hasDerivAt_arctan x)
        rw [Real.arctan_zero, sub_zero, sub_zero] at h_eq_slope
        have h_le_one : 1 / (1 + c ^ 2) ≤ 1 := by
          rw [div_le_one (by positivity)]
          nlinarith
        rw [h_eq_slope, div_le_one hq_pos] at h_le_one
        exact h_le_one
    have hq_le : q ≤ (Real.pi * d / (2 * H_p)) / β := by
      dsimp only [q]
