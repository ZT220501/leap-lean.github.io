      have ht_norm : ‖q.2‖ < W.r_base := by
        simpa [Metric.mem_ball, dist_zero_right] using ht_base
      have ht_im : |q.2.im| < S.r₁ := by
        have h_eq_im : q.2.im = (q.2 - (t₁ : ℂ)).im := by simp
        rw [h_eq_im]
        exact lt_of_le_of_lt (Complex.abs_im_le_norm _) h_t
      have h_u_im : |q.1.im| < 2 * hDet.s_det := by
        have him : q.1.im = y.im + s_minus * q.2.im := by
          rw [hq1]
          simp [Complex.add_im, Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im]
        have h1 : |y.im + s_minus * q.2.im| ≤ |y.im| + |s_minus| * |q.2.im| := by
          calc |y.im + s_minus * q.2.im|
              ≤ |y.im| + |s_minus * q.2.im| := abs_add_le _ _
            _ = |y.im| + |s_minus| * |q.2.im| := by rw [abs_mul]
        have h2 : |s_minus| * |q.2.im| ≤ (|s_minus| + (k : ℝ)) * S.r₁ := by
          have hk0 : (0 : ℝ) ≤ (k : ℝ) := by positivity
          exact mul_le_mul (by linarith) (le_of_lt ht_im) (abs_nonneg _) (by positivity)
        rw [him]
        linarith [W.s_base_pos, W.s_base_le_det]
      have h_uk_im : |(q.1 + (k : ℂ) * q.2).im| < 2 * hDet.s_det := by
        have him : (q.1 + (k : ℂ) * q.2).im = y.im + (s_minus + (k : ℝ)) * q.2.im := by
          rw [hq1]
          simp [Complex.add_im, Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im]
