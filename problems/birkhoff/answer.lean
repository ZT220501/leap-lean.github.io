        have hre_d : |Z.re - Y.re| ≤ δ₀ := le_trans (Complex.abs_re_le_norm (Z - Y)) hZ
        rw [abs_le] at him_d hre_d
        have h_δ4 : δ₀ ≤ D₀ / 4 := by nlinarith
        refine ⟨by linarith [hY.1], by linarith [hY.2.1], ?_⟩
        have hre1 : |Z.re| ≤ |Y.re| + δ₀ := by
