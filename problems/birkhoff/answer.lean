    · simpa using (h_seg_pt 0 ⟨le_rfl, zero_le_one⟩).1
    · simpa using (h_seg_pt 1 ⟨zero_le_one, le_rfl⟩).1
    · have h0 := (h_seg_pt 0 ⟨le_rfl, zero_le_one⟩).2
      simp only [Complex.ofReal_zero, zero_mul, add_zero] at h0
      rw [norm_mul]
