        intervalIntegrable_const ?_).2
      · filter_upwards [Metric.ball_mem_nhds z₀ hr_pos] with w hw
        exact hMeas w (hBallSubU hw)
      · exact Filter.Eventually.of_forall fun t ht w hw => hCauchy t (huIoc_sub ht) w hw
      · exact Filter.Eventually.of_forall fun t ht w hw =>
          ((hHolo t (huIoc_sub ht)).differentiableAt
            ((hOpen σ').mem_nhds (hBallSubU hw))).hasDerivAt
    exact ⟨hMeasDeriv, hHasDeriv⟩
  
  have h_param_int_bound : ∀ (p : ℕ) (σ' M : ℝ) (F : ℝ → ℂ → ℂ),
