      V_fine x = V_pos x - V_neg x ∧ |V_fine x| = V_pos x + V_neg x := by
    intro x
    dsimp [V_pos, V_neg]
    rcases le_total 0 (V_fine x) with hx | hx
    · rw [max_eq_left hx, max_eq_right (neg_nonpos.mpr hx), abs_of_nonneg hx]
      constructor <;> ring
    · rw [max_eq_right hx, max_eq_left (neg_nonneg.mpr hx), abs_of_nonpos hx]
      constructor <;> ring
  have h_st_diff :
      (∫ x in (0 : ℝ)..(2 * Real.pi), V_fine x * ν_st x) =
      (∫ x in (0 : ℝ)..(2 * Real.pi), V_pos x * ν_st x) -
        (∫ x in (0 : ℝ)..(2 * Real.pi), V_neg x * ν_st x) := by
    have h_fn : (fun x : ℝ => V_fine x * ν_st x) =
        (fun x : ℝ => V_pos x * ν_st x - V_neg x * ν_st x) := by
      ext x
      rw [(hV_split x).1]
      ring
    rw [h_fn]
    exact intervalIntegral.integral_sub
      ((hV_pos_cont.mul hν_st_cont).intervalIntegrable 0 (2 * Real.pi))
      ((hV_neg_cont.mul hν_st_cont).intervalIntegrable 0 (2 * Real.pi))
  have h_abs_sum :
      (∫ x in (0 : ℝ)..(2 * Real.pi), |V_fine x| * ν x) =
      (∫ x in (0 : ℝ)..(2 * Real.pi), V_pos x * ν x) +
        (∫ x in (0 : ℝ)..(2 * Real.pi), V_neg x * ν x) := by
    have h_fn : (fun x : ℝ => |V_fine x| * ν x) =
        (fun x : ℝ => V_pos x * ν x + V_neg x * ν x) := by
      ext x
      rw [(hV_split x).2]
      ring
    rw [h_fn]
    exact intervalIntegral.integral_add
      ((hV_pos_cont.mul hν_cont).intervalIntegrable 0 (2 * Real.pi))
      ((hV_neg_cont.mul hν_cont).intervalIntegrable 0 (2 * Real.pi))
  have h_neg_cmp :
      c_ker * (∫ x in (0 : ℝ)..(2 * Real.pi), V_neg x * ν x) ≤
      ∫ x in (0 : ℝ)..(2 * Real.pi), V_neg x * ν_st x := by
    rw [← intervalIntegral.integral_const_mul]
    refine intervalIntegral.integral_mono_on h_2pi_pos.le
      ((continuous_const.mul (hV_neg_cont.mul hν_cont)).intervalIntegrable 0 (2 * Real.pi))
      ((hV_neg_cont.mul hν_st_cont).intervalIntegrable 0 (2 * Real.pi)) (fun x _ => ?_)
    calc c_ker * (V_neg x * ν x)
        = V_neg x * (c_ker * ν x) := by ring
      _ ≤ V_neg x * ν_st x := mul_le_mul_of_nonneg_left (hν_cmp x).1 (hV_neg_nonneg x)
  have h_pos_cmp :
      (∫ x in (0 : ℝ)..(2 * Real.pi), V_pos x * ν_st x) ≤
      C_ker * (∫ x in (0 : ℝ)..(2 * Real.pi), V_pos x * ν x) := by
    rw [← intervalIntegral.integral_const_mul]
    refine intervalIntegral.integral_mono_on h_2pi_pos.le
      ((hV_pos_cont.mul hν_st_cont).intervalIntegrable 0 (2 * Real.pi))
      ((continuous_const.mul (hV_pos_cont.mul hν_cont)).intervalIntegrable 0 (2 * Real.pi))
      (fun x _ => ?_)
    calc V_pos x * ν_st x
        ≤ V_pos x * (C_ker * ν x) := mul_le_mul_of_nonneg_left (hν_cmp x).2 (hV_pos_nonneg x)
      _ = C_ker * (V_pos x * ν x) := by ring
  have h_anc_abs :
      -(∫ y in (0 : ℝ)..(2 * Real.pi), V_anc y * w y) ≤
      ∫ y in (0 : ℝ)..(2 * Real.pi), |V_anc y| * w y := by
    rw [← intervalIntegral.integral_neg]
    refine intervalIntegral.integral_mono_on h_2pi_pos.le
      ((hV_anc_cont.mul hw_cont).neg.intervalIntegrable 0 (2 * Real.pi))
      ((hV_anc_cont.abs.mul hw_cont).intervalIntegrable 0 (2 * Real.pi)) (fun y _ => ?_)
    calc -(V_anc y * w y)
        = (-V_anc y) * w y := by ring
      _ ≤ |V_anc y| * w y := mul_le_mul_of_nonneg_right (neg_le_abs (V_anc y)) (hw_nonneg y)
  let I_pos : ℝ := (2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi), V_pos x * ν x
  let I_neg : ℝ := (2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi), V_neg x * ν x
  let I_anc : ℝ := (2 * Real.pi)⁻¹ * ∫ y in (0 : ℝ)..(2 * Real.pi), |V_anc y| * w y
  have hI_pos_nonneg : 0 ≤ I_pos :=
    mul_nonneg h_2pi_inv_nonneg
      (intervalIntegral.integral_nonneg h_2pi_pos.le
        (fun x _ => mul_nonneg (hV_pos_nonneg x) (hν_nonneg x)))
  have hI_anc_nonneg : 0 ≤ I_anc :=
    mul_nonneg h_2pi_inv_nonneg
      (intervalIntegral.integral_nonneg h_2pi_pos.le
        (fun y _ => mul_nonneg (abs_nonneg _) (hw_nonneg y)))
  have h_raw_neg_bound :
      c_ker * (∫ x in (0 : ℝ)..(2 * Real.pi), V_neg x * ν x) ≤
      C_ker * (∫ x in (0 : ℝ)..(2 * Real.pi), V_pos x * ν x) +
        (∫ y in (0 : ℝ)..(2 * Real.pi), |V_anc y| * w y) := by
    linarith [h_fubini, h_st_diff, h_neg_cmp, h_pos_cmp, h_anc_abs]
  have hI_neg_bound : c_ker * I_neg ≤ C_ker * I_pos + I_anc := by
    have hm := mul_le_mul_of_nonneg_left h_raw_neg_bound h_2pi_inv_nonneg
    dsimp [I_neg, I_pos, I_anc]
    linarith
  have h_goal_eq :
      (2 * Real.pi)⁻¹ * (∫ x in (0 : ℝ)..(2 * Real.pi), |V_fine x| * ν x) =
      I_pos + I_neg := by
    rw [h_abs_sum]
    dsimp [I_pos, I_neg]
    ring
  change (2 * Real.pi)⁻¹ * (∫ x in (0 : ℝ)..(2 * Real.pi), |V_fine x| * ν x) ≤
    C_bal * (I_pos + I_anc)
  rw [h_goal_eq]
  have h_c_bal_mul : c_ker * C_bal = c_ker + C_ker + 1 := by
    dsimp [C_bal]
    field_simp [hc_ker_pos.ne']
    ring
  have h_mul_le : c_ker * (I_pos + I_neg) ≤ c_ker * (C_bal * (I_pos + I_anc)) := by
    calc c_ker * (I_pos + I_neg)
        = c_ker * I_pos + c_ker * I_neg := by ring
      _ ≤ c_ker * I_pos + (C_ker * I_pos + I_anc) := by linarith
      _ ≤ (c_ker + C_ker + 1) * I_pos + (c_ker + C_ker + 1) * I_anc := by nlinarith
      _ = (c_ker + C_ker + 1) * (I_pos + I_anc) := by ring
      _ = c_ker * (C_bal * (I_pos + I_anc)) := by rw [← h_c_bal_mul]; ring
  exact le_of_mul_le_mul_left h_mul_le hc_ker_pos

theorem weighted_tile_and_row_cell_transfer (S : FiniteWallNonisotropicStrip)
    (hInt : BootInteriorTransferProp S) :
    (∀ A₁ A₂ k x : ℝ, 0 ≤ A₁ → A₁ ≤ A₂ → criticalDepthThreshold S ≤ k →
      0 ≤ tileSupModulus S A₁ k x ∧
      Real.exp (-k) * shapeModulus S (bootRowPt S k x) ≤ tileSupModulus S A₁ k x ∧
      tileSupModulus S A₁ k x ≤ tileSupModulus S A₂ k x) ∧
    (∀ B : ℝ, 1 ≤ B → ∃ C_tr : ℝ, 0 < C_tr ∧
      ∀ (k_a q A_coarse : ℝ) (ν : ℝ → ℝ),
        criticalDepthThreshold S + 1 ≤ k_a →
        k_a ≤ q →
        B ≤ A_coarse →
        Continuous ν →
        Function.Periodic ν (2 * Real.pi) →
        (∀ x : ℝ, 0 ≤ ν x) →
        (∀ M x x' : ℝ, 0 ≤ M → |x' - x| ≤ M * Real.exp (-k_a) →
          ν x' ≤ 2 * (1 + M ^ 2) * ν x) →
        IntervalIntegrable
          (fun l : ℝ => (2 * Real.pi)⁻¹ * ∫ u in (0 : ℝ)..(2 * Real.pi),
            (Real.exp (-l) * shapeModulus S (bootRowPt S l u)) ^ 2 * ν u)
          MeasureTheory.volume (max (k_a - 1) (q - B - 1)) (q + B + 1) ∧
        (2 * Real.pi)⁻¹ * (∫ x in (0 : ℝ)..(2 * Real.pi), (tileSupModulus S B q x) ^ 2 * ν x) ≤
          Real.exp (-2 * (q - k_a)) * ((2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi),
            (tileSupModulus S A_coarse k_a x) ^ 2 * ν x) +
          C_tr * ∫ l in (max (k_a - 1) (q - B - 1))..(q + B + 1),
            ((2 * Real.pi)⁻¹ * ∫ u in (0 : ℝ)..(2 * Real.pi),
              (Real.exp (-l) * shapeModulus S (bootRowPt S l u)) ^ 2 * ν u)) ∧
    (∃ C_rc : ℝ, 0 < C_rc ∧
      ∀ (k_a j : ℝ) (ν : ℝ → ℝ),
        criticalDepthThreshold S + 1 ≤ k_a →
        k_a + 1 ≤ j →
        Continuous ν →
        Function.Periodic ν (2 * Real.pi) →
        (∀ x : ℝ, 0 ≤ ν x) →
        (2 * Real.pi)⁻¹ * (∫ x in (0 : ℝ)..(2 * Real.pi), ν x) = 1 →
        (∀ M x x' : ℝ, 0 ≤ M → |x' - x| ≤ M * Real.exp (-k_a) →
          ν x' ≤ 2 * (1 + M ^ 2) * ν x) →
        IntervalIntegrable
          (fun l : ℝ => (2 * Real.pi)⁻¹ * ∫ u in (0 : ℝ)..(2 * Real.pi),
            Real.exp (-l) * |(S.V (bootRowPt S l u)).im| * ν u)
          MeasureTheory.volume (j - 1) (j + 1) ∧
        (2 * Real.pi)⁻¹ * (∫ x in (0 : ℝ)..(2 * Real.pi),
          (Real.exp (-j) * shapeModulus S (bootRowPt S j x)) ^ 2 * ν x) ≤
          C_rc * (1 + ∫ l in (j - 1)..(j + 1),
            ((2 * Real.pi)⁻¹ * ∫ u in (0 : ℝ)..(2 * Real.pi),
              Real.exp (-l) * |(S.V (bootRowPt S l u)).im| * ν u))) :=
by
  have h2pi_pos : 0 < 2 * Real.pi := Real.two_pi_pos
  have h2pi_ne : (2 * Real.pi : ℝ) ≠ 0 := h2pi_pos.ne'
  have h2pi_inv_nonneg : 0 ≤ (2 * Real.pi)⁻¹ := inv_nonneg.mpr h2pi_pos.le
  let k₀ : ℝ := criticalDepthThreshold S
  have hExpRow : ∀ r : ℝ, k₀ ≤ r → Real.exp (-r) ≤ S.H / 20 := by
    intro r hr
    have hlog : -Real.log (S.H / 20) ≤ r := le_trans (le_max_right 1 _) hr
    calc Real.exp (-r) ≤ Real.exp (Real.log (S.H / 20)) :=
          Real.exp_le_exp.mpr (by linarith)
      _ = S.H / 20 := Real.exp_log (by linarith [S.H_pos])
  have h_re_im : ∀ x y : ℝ,
      ((x : ℂ) + (y : ℂ) * Complex.I).re = x ∧ ((x : ℂ) + (y : ℂ) * Complex.I).im = y :=
    fun x y => ⟨by simp, by simp⟩
  have hRowPt_re : ∀ r u : ℝ, (bootRowPt S r u).re = u :=
    fun r u => (h_re_im u (S.H - Real.exp (-r))).1
  have hRowPt_im : ∀ r u : ℝ, (bootRowPt S r u).im = S.H - Real.exp (-r) :=
    fun r u => (h_re_im u (S.H - Real.exp (-r))).2
  have hRowMem : ∀ r : ℝ, k₀ ≤ r → ∀ u : ℝ, bootRowPt S r u ∈ horizStrip S.H := by
    intro r hr u
    have hexp_le := hExpRow r hr
    have hexp_pos : 0 < Real.exp (-r) := Real.exp_pos (-r)
    change |(bootRowPt S r u).im| < S.H
    rw [hRowPt_im, abs_lt]
    constructor <;> linarith [S.H_pos]
  have hModContOn : ContinuousOn (shapeModulus S) (horizStrip S.H) :=
    continuous_max.comp_continuousOn
      (S.f_holo.continuousOn.norm.prodMk
        (Real.continuous_sqrt.comp_continuousOn S.q_holo.continuousOn.norm))
  have hModNonneg : ∀ s : ℂ, 0 ≤ shapeModulus S s :=
    fun s => le_trans (norm_nonneg _) (le_max_left _ _)
  have hModPer : ∀ s ∈ horizStrip S.H, shapeModulus S (s + 2 * Real.pi) = shapeModulus S s := by
    intro s hs
    dsimp [shapeModulus]
    rw [S.f_periodic s hs, S.q_periodic s hs]
  
  have hTileSubAndComp : ∀ A k x : ℝ, 0 ≤ A →
      upperStripTile S A k x ⊆ horizStrip S.H ∧ IsCompact (upperStripTile S A k x) := by
    intro A k x hA
    have hSub : upperStripTile S A k x ⊆ horizStrip S.H := by
      intro s hs
      have hpos : 0 < Real.exp (-A) * Real.exp (-k) := by positivity
      have hwd : Real.exp (-A) * Real.exp (-k) ≤ S.H - s.im := hs.2.1
      change |s.im| < S.H
      rw [abs_lt]
      constructor <;> linarith [hs.1, S.H_pos]
    have hwd_cont : Continuous (wallDepth S) := continuous_const.sub Complex.continuous_im
    have hClosed : IsClosed (upperStripTile S A k x) :=
      (isClosed_le continuous_const Complex.continuous_im).inter
        ((isClosed_le continuous_const hwd_cont).inter
          ((isClosed_le hwd_cont continuous_const).inter
            (isClosed_le
              (continuous_abs.comp (Complex.continuous_re.sub continuous_const))
              (continuous_const.mul hwd_cont))))
    have hBallSub : upperStripTile S A k x ⊆ Metric.closedBall (x : ℂ) ((A + 1) * S.H) := by
      intro s hs
      rw [Metric.mem_closedBall, dist_eq_norm]
      have hpos : 0 < Real.exp (-A) * Real.exp (-k) := by positivity
      have hwd_pos : 0 < S.H - s.im := lt_of_lt_of_le hpos hs.2.1
      have hwd_le : wallDepth S s ≤ S.H := by
        dsimp [wallDepth]
        linarith [hs.1]
      have hre_le : |s.re - x| ≤ A * S.H :=
        le_trans hs.2.2.2 (mul_le_mul_of_nonneg_left hwd_le hA)
      have him_abs : |(s - (x : ℂ)).im| = s.im := by
        simp [abs_of_nonneg hs.1]
      have hre_abs : |(s - (x : ℂ)).re| = |s.re - x| := by simp
      calc ‖s - (x : ℂ)‖ ≤ |(s - (x : ℂ)).re| + |(s - (x : ℂ)).im| :=
            Complex.norm_le_abs_re_add_abs_im _
        _ = |s.re - x| + s.im := by rw [hre_abs, him_abs]
        _ ≤ A * S.H + S.H := by linarith
        _ = (A + 1) * S.H := by ring
    exact ⟨hSub, (isCompact_closedBall (x : ℂ) ((A + 1) * S.H)).of_isClosed_subset hClosed hBallSub⟩
  have hTileBdd : ∀ A k x : ℝ, 0 ≤ A →
      BddAbove (shapeModulus S '' upperStripTile S A k x) := by
    intro A k x hA
    obtain ⟨hSub, hComp⟩ := hTileSubAndComp A k x hA
    exact (hComp.image_of_continuousOn (hModContOn.mono hSub)).bddAbove
  have hRowInTile : ∀ A k x : ℝ, 0 ≤ A → k₀ ≤ k →
      bootRowPt S k x ∈ upperStripTile S A k x := by
    intro A k x hA hk
    have hexp_le := hExpRow k hk
    have hexp_pos : 0 < Real.exp (-k) := Real.exp_pos (-k)
    have hwd : wallDepth S (bootRowPt S k x) = Real.exp (-k) := by
      dsimp [wallDepth]
      rw [hRowPt_im]
      ring
    refine ⟨?_, ?_, ?_, ?_⟩
    · rw [hRowPt_im]
      linarith [S.H_pos]
    · rw [hwd]
      have : Real.exp (-A) ≤ 1 := Real.exp_le_one_iff.mpr (by linarith)
      calc Real.exp (-A) * Real.exp (-k) ≤ 1 * Real.exp (-k) :=
            mul_le_mul_of_nonneg_right this hexp_pos.le
        _ = Real.exp (-k) := one_mul _
    · rw [hwd]
      refine le_min (by linarith [S.H_pos]) ?_
      have : 1 ≤ Real.exp A := Real.one_le_exp hA
      calc Real.exp (-k) = 1 * Real.exp (-k) := (one_mul _).symm
        _ ≤ Real.exp A * Real.exp (-k) := mul_le_mul_of_nonneg_right this hexp_pos.le
    · rw [hRowPt_re, sub_self, abs_zero, hwd]
      positivity
  
  have hConj1 : ∀ A₁ A₂ k x : ℝ, 0 ≤ A₁ → A₁ ≤ A₂ → k₀ ≤ k →
      0 ≤ tileSupModulus S A₁ k x ∧
      Real.exp (-k) * shapeModulus S (bootRowPt S k x) ≤ tileSupModulus S A₁ k x ∧
      tileSupModulus S A₁ k x ≤ tileSupModulus S A₂ k x := by
    intro A₁ A₂ k x hA₁ hA₁₂ hk
    have hA₂ : 0 ≤ A₂ := le_trans hA₁ hA₁₂
    have hs₀_mem : bootRowPt S k x ∈ upperStripTile S A₁ k x := hRowInTile A₁ k x hA₁ hk
    have hSub₁₂ : upperStripTile S A₁ k x ⊆ upperStripTile S A₂ k x := by
      intro s hs
      have hpos : 0 < Real.exp (-A₁) * Real.exp (-k) := by positivity
      have hwd_nn : 0 ≤ wallDepth S s := le_trans hpos.le hs.2.1
      refine ⟨hs.1, ?_, ?_, ?_⟩
      · exact le_trans
          (mul_le_mul_of_nonneg_right (Real.exp_le_exp.mpr (by linarith)) (Real.exp_pos (-k)).le)
          hs.2.1
      · refine le_min (le_trans hs.2.2.1 (min_le_left _ _)) ?_
        exact le_trans (le_trans hs.2.2.1 (min_le_right _ _))
          (mul_le_mul_of_nonneg_right (Real.exp_le_exp.mpr hA₁₂) (Real.exp_pos (-k)).le)
      · exact le_trans hs.2.2.2 (mul_le_mul_of_nonneg_right hA₁₂ hwd_nn)
    have h_row_le : shapeModulus S (bootRowPt S k x) ≤
        sSup (shapeModulus S '' upperStripTile S A₁ k x) :=
      le_csSup (hTileBdd A₁ k x hA₁) ⟨bootRowPt S k x, hs₀_mem, rfl⟩
    have h_sup_mono : sSup (shapeModulus S '' upperStripTile S A₁ k x) ≤
        sSup (shapeModulus S '' upperStripTile S A₂ k x) :=
      csSup_le_csSup (hTileBdd A₂ k x hA₂)
        ⟨_, ⟨bootRowPt S k x, hs₀_mem, rfl⟩⟩ (Set.image_mono hSub₁₂)
    have hexp_nn : 0 ≤ Real.exp (-k) := (Real.exp_pos (-k)).le
    have h1 : Real.exp (-k) * shapeModulus S (bootRowPt S k x) ≤ tileSupModulus S A₁ k x :=
      mul_le_mul_of_nonneg_left h_row_le hexp_nn
    have h2 : tileSupModulus S A₁ k x ≤ tileSupModulus S A₂ k x :=
      mul_le_mul_of_nonneg_left h_sup_mono hexp_nn
    have h0 : 0 ≤ Real.exp (-k) * shapeModulus S (bootRowPt S k x) :=
      mul_nonneg hexp_nn (hModNonneg _)
    exact ⟨le_trans h0 h1, h1, h2⟩
  
  let l_c : ℝ → ℝ := fun l => max k₀ l
  have hl_c_cont : Continuous l_c := continuous_const.max continuous_id
  have hl_c_ge : ∀ l : ℝ, k₀ ≤ l_c l := fun l => le_max_left k₀ l
  have hPt_cont : Continuous (fun p : ℝ × ℝ => bootRowPt S (l_c p.1) p.2) := by
    dsimp [bootRowPt]
    exact (Complex.continuous_ofReal.comp continuous_snd).add
      ((Complex.continuous_ofReal.comp
        (continuous_const.sub (Real.continuous_exp.comp (hl_c_cont.comp continuous_fst).neg))).mul
        continuous_const)
  have hPt_mem : ∀ p : ℝ × ℝ, bootRowPt S (l_c p.1) p.2 ∈ horizStrip S.H :=
    fun p => hRowMem (l_c p.1) (hl_c_ge p.1) p.2
  have hRowPt_shift : ∀ r u : ℝ, bootRowPt S r (u + 2 * Real.pi) = bootRowPt S r u + 2 * Real.pi := by
    intro r u
    dsimp [bootRowPt]
    push_cast
    ring
  let G_M : ℝ → ℝ → ℝ := fun l u =>
    (Real.exp (-l_c l) * shapeModulus S (bootRowPt S (l_c l) u)) ^ 2
  let G_V : ℝ → ℝ → ℝ := fun l u =>
    Real.exp (-l_c l) * |(S.V (bootRowPt S (l_c l) u)).im|
  have hGM_cont : Continuous (Function.uncurry G_M) := by
    have h1 : Continuous (fun p : ℝ × ℝ => Real.exp (-l_c p.1)) :=
      Real.continuous_exp.comp (hl_c_cont.comp continuous_fst).neg
    have h2 : Continuous (fun p : ℝ × ℝ => shapeModulus S (bootRowPt S (l_c p.1) p.2)) :=
      hModContOn.comp_continuous hPt_cont hPt_mem
    exact (h1.mul h2).pow 2
  have hGM_nn : ∀ l u : ℝ, 0 ≤ G_M l u := fun l u => sq_nonneg _
  have hGM_per : ∀ l : ℝ, Function.Periodic (G_M l) (2 * Real.pi) := by
    intro l u
    dsimp [G_M]
    rw [hRowPt_shift, hModPer _ (hRowMem (l_c l) (hl_c_ge l) u)]
  have hGV_cont : Continuous (Function.uncurry G_V) := by
    have h1 : Continuous (fun p : ℝ × ℝ => Real.exp (-l_c p.1)) :=
      Real.continuous_exp.comp (hl_c_cont.comp continuous_fst).neg
    have h2 : Continuous (fun p : ℝ × ℝ => |(S.V (bootRowPt S (l_c p.1) p.2)).im|) :=
      continuous_abs.comp (Complex.continuous_im.comp
        (S.V_holo.continuousOn.comp_continuous hPt_cont hPt_mem))
    exact h1.mul h2
  have hGV_nn : ∀ l u : ℝ, 0 ≤ G_V l u :=
    fun l u => mul_nonneg (Real.exp_pos _).le (abs_nonneg _)
  have hGV_per : ∀ l : ℝ, Function.Periodic (G_V l) (2 * Real.pi) := by
    intro l u
    dsimp [G_V]
    rw [hRowPt_shift, S.V_periodic _ (hRowMem (l_c l) (hl_c_ge l) u)]
  
  have hSwap : ∀ (a₁ b₁ a₂ b₂ : ℝ), a₁ ≤ b₁ → a₂ ≤ b₂ →
      ∀ (g : ℝ → ℝ → ℝ), Continuous (Function.uncurry g) →
        (∫ x in a₁..b₁, ∫ y in a₂..b₂, g x y) = ∫ y in a₂..b₂, ∫ x in a₁..b₁, g x y := by
    intro a₁ b₁ a₂ b₂ ha₁ ha₂ g hg
    simp only [intervalIntegral.integral_of_le ha₁, intervalIntegral.integral_of_le ha₂]
    rw [MeasureTheory.integral_integral_swap]
    have hcomp : IsCompact (Set.Icc a₁ b₁ ×ˢ Set.Icc a₂ b₂) := isCompact_Icc.prod isCompact_Icc
