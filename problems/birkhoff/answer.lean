              rw [← Int.cast_sub, ← Int.cast_abs]
              exact_mod_cast Int.one_le_abs (by omega : ((L_t t ht).length : ℤ) - (m : ℤ) ≠ 0)
            have hnorm_eq : dist (((L_t t ht).length : ℂ)) (m : ℂ) =
                |(((L_t t ht).length : ℤ) : ℝ) - ((m : ℤ) : ℝ)| := by
              have hsub_cast : (((L_t t ht).length : ℂ) - (m : ℂ)) =
