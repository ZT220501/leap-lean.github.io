          have h_mid_ref_c0 : ∀ i : Fin k, MvPowerSeries.coeff 0 (lcJetMid2D α_ref i) = 0 := by
            intro i
            unfold lcJetMid2D
            rw [MvPowerSeries.coeff_C_mul, map_add, hα_ref_c0, hα_ref_c0, add_zero, mul_zero]
          have h_step_ref_c0 : ∀ i : Fin k,
              MvPowerSeries.coeff 0 (lcJetHalfStep2D α_ref i) = 0 := by
            intro i
            unfold lcJetHalfStep2D
            rw [MvPowerSeries.coeff_C_mul, map_sub, hα_ref_c0, hα_ref_c0, sub_self, mul_zero]
          have h_mid_ref_mem : ∀ i : Fin k, lineCoreCoeffsIn F_val (lcJetMid2D α_ref i) :=
            fun i => hSub.mul_mem F_val (hSub.C_mem F_val h_half_mem)
              (hSub.add_mem F_val (hα_ref_mem i.castSucc) (hα_ref_mem i.succ))
          have h_step_ref_mem : ∀ i : Fin k, lineCoreCoeffsIn F_val (lcJetHalfStep2D α_ref i) :=
            fun i => hSub.mul_mem F_val (hSub.C_mem F_val h_half_mem)
              (hSub.sub_mem F_val (hα_ref_mem i.succ) (hα_ref_mem i.castSucc))
          have h_grad_ref_mem : ∀ r : Fin (k - 1),
              MvPowerSeries.coeff d (lcJetGrad2D h_tr S_ser C_ser α_ref r) ∈ F_val := by
            intro r
            let i_L : Fin k := ⟨r.1, by have := r.2; omega⟩
            let i_R : Fin k := ⟨r.1 + 1, by have := r.2; omega⟩
            have hEp : ∀ i : Fin k, lineCoreCoeffsIn F_val
                (lcJetEdgePlus2D (h_tr i) (S_ser i) (C_ser i)
                  (lcJetMid2D α_ref i) (lcJetHalfStep2D α_ref i)) :=
              fun i => hSub.add_mem F_val
                (hSub.mul_mem F_val
                  (hSub.comp1D_mem F_val (hh'_tr_mem i) (h_mid_ref_c0 i) (h_mid_ref_mem i))
