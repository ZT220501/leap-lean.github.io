      have hAvgS := (hTk.holo_circle_mean_and_var hStripOpen (hTk.impact_holo i) hρ_pos hsub_strip).1
      have hci1 : CircleIntegrable (sliceImpactSeq S P.N i.val) y (ρ y) :=
        (((hTk.impact_holo i).continuousOn.mono hsub_strip).mono
