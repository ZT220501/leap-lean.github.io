      have h1 : Real.exp (-l) * M_low ≤ 1 * M_low :=
        mul_le_mul_of_nonneg_right hexp_l_le_one hM_low_nonneg
      simpa using pow_le_pow_left₀ (by positivity) h1 2
    have h_avg_le2 := mul_le_mul_of_nonneg_left h_mono_x2 (by positivity : 0 ≤ (2 * Real.pi)⁻¹)
