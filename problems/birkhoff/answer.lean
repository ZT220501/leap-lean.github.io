    have hη₁_sub_q0 : Metric.ball p η₁ ⊆ Metric.ball q₀ (G₂.rad q₀) :=
      Metric.ball_subset_ball' (by dsimp [η₁]; linarith [min_le_right η (G₂.rad q₀ - dist p q₀)])
    let D : ℂ × ℂ → ℂ := fun q => G q * G₂.den q₀ q - (q.1 - w₁) ^ m * G₂.num q₀ q
    have hD_holo : DifferentiableOn ℂ D (Metric.ball p η₁) := by
      have hG_on : DifferentiableOn ℂ G (Metric.ball p η₁) :=
        hClG₂.2.1.mono (Set.Subset.trans hη₁_sub_η hη_sub)
