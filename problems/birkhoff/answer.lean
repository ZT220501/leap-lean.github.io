          have hy_lt : y < (k₀ : ℝ) + 1 := Nat.lt_floor_add_one y
          have hm_lt_k1 : (m.1 : ℝ) < ((k₀ + 1 : ℕ) : ℝ) := by push_cast; linarith
          have hm_le_k : m.1 < k₀ + 1 := Nat.cast_lt.mp hm_lt_k1
          have hk_le_m1_r : (k₀ : ℝ) ≤ ((m.1 + 1 : ℕ) : ℝ) := by push_cast; linarith
