          _ ≤ ((2 * Real.pi)⁻¹ * 2) *
                ((D.C_neg * (N l) ^ 2) * ∫ x in (0 : ℝ)..(2 * Real.pi), (b x) ^ m) :=
              mul_le_mul_of_nonneg_left hint_pos hpos_c
          _ = 2 * D.C_neg * (N l) ^ 2 *
                ((2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi), (b x) ^ m) := by ring
      have h2 : 2 * D.C_neg * (N l) ^ 2 *
            ((2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi), (b x) ^ m) ≤
          (2 * D.C_neg * (D.C_b2 ^ 2 + 1)) * Λ ^ m * (N l) ^ 2 := by
        have hfac : 0 ≤ 2 * D.C_neg * (N l) ^ 2 := by
          have := D.C_neg_pos; positivity
        calc 2 * D.C_neg * (N l) ^ 2 *
              ((2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi), (b x) ^ m)
            ≤ 2 * D.C_neg * (N l) ^ 2 * ((D.C_b2 ^ 2 + 1) * Λ ^ m) :=
              mul_le_mul_of_nonneg_left hIbm_le hfac
          _ = (2 * D.C_neg * (D.C_b2 ^ 2 + 1)) * Λ ^ m * (N l) ^ 2 := by ring
      have hCV1 : 2 * D.C_neg * (D.C_b2 ^ 2 + 1) ≤ C_V := le_max_left _ _
      have hΛm_Nl : 0 ≤ Λ ^ m * (N l) ^ 2 :=
        mul_nonneg (Real.rpow_nonneg (le_of_lt hΛ_pos) m) (sq_nonneg _)
      calc (2 * Real.pi)⁻¹ * (∫ x in (0 : ℝ)..(2 * Real.pi), F l x)
          ≤ (2 * D.C_neg * (D.C_b2 ^ 2 + 1)) * Λ ^ m * (N l) ^ 2 := le_trans h1 h2
        _ = (2 * D.C_neg * (D.C_b2 ^ 2 + 1)) * (Λ ^ m * (N l) ^ 2) := by ring
        _ ≤ C_V * (Λ ^ m * (N l) ^ 2) := mul_le_mul_of_nonneg_right hCV1 hΛm_Nl
        _ = C_V * (1 + M_r) ^ m * (N l) ^ 2 := by dsimp [Λ]; ring
    · have hgp_cont : Continuous (fun x : ℝ => (g x) ^ p) :=
        hg_cont.rpow_const (fun _ => Or.inr (le_of_lt hp_pos))
      have hgp_le : ∀ x : ℝ, (g x) ^ p ≤ D.C_neg ^ p * (b x) ^ 2 := by
        intro x
        have hpow := Real.rpow_le_rpow (hg_nonneg x) (hg_le x) (le_of_lt hp_pos)
        rw [Real.mul_rpow (le_of_lt D.C_neg_pos) (Real.rpow_nonneg (hb_nonneg x) m),
          ← Real.rpow_mul (hb_nonneg x), hmp_eq_two, Real.rpow_two] at hpow
        exact hpow
      have hint_gp : (∫ x in (0 : ℝ)..(2 * Real.pi), (g x) ^ p) ≤
          ∫ x in (0 : ℝ)..(2 * Real.pi), D.C_neg ^ p * (b x) ^ 2 :=
        intervalIntegral.integral_mono_on (by positivity : (0 : ℝ) ≤ 2 * Real.pi)
          (hgp_cont.intervalIntegrable _ _)
          ((continuous_const.mul (hb_cont.pow 2)).intervalIntegrable _ _)
          (fun x _ => hgp_le x)
      rw [intervalIntegral.integral_const_mul] at hint_gp
      have h1 : (2 * Real.pi)⁻¹ * (∫ x in (0 : ℝ)..(2 * Real.pi), (g x) ^ p) ≤
          D.C_neg ^ p * I_b2 := by
        dsimp [I_b2]
        calc (2 * Real.pi)⁻¹ * (∫ x in (0 : ℝ)..(2 * Real.pi), (g x) ^ p)
            ≤ (2 * Real.pi)⁻¹ * (D.C_neg ^ p * ∫ x in (0 : ℝ)..(2 * Real.pi), (b x) ^ 2) :=
              mul_le_mul_of_nonneg_left hint_gp (by positivity)
          _ = D.C_neg ^ p * ((2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi), (b x) ^ 2) := by ring
      have h2 : D.C_neg ^ p * I_b2 ≤ (D.C_neg ^ p * D.C_b2 ^ 2) * (1 + M_r) ^ 2 := by
        have hCneg_p : 0 ≤ D.C_neg ^ p := Real.rpow_nonneg (le_of_lt D.C_neg_pos) p
        calc D.C_neg ^ p * I_b2
            ≤ D.C_neg ^ p * (D.C_b2 ^ 2 * (1 + M_r) ^ 2) :=
              mul_le_mul_of_nonneg_left hIb2_le hCneg_p
          _ = (D.C_neg ^ p * D.C_b2 ^ 2) * (1 + M_r) ^ 2 := by ring
      have hCV2 : D.C_neg ^ p * D.C_b2 ^ 2 ≤ C_V := le_max_right _ _
      exact le_trans (le_trans h1 h2) (mul_le_mul_of_nonneg_right hCV2 (sq_nonneg _))
  
  let K₁ : ℝ := C_row
  let K₂ : ℝ := C_row * C_V * C_N ^ 2 * Real.exp (2 * max β a)
  have hK₂_pos : 0 < K₂ := by dsimp [K₂]; positivity
  let C₀_sq : ℝ := 2 * K₁ + 1 + 2 * K₂ * (4 * K₂) ^ (m / (2 - m))
  have hC₀_sq_pos : 0 < C₀_sq := by
    dsimp [C₀_sq]
    have : 0 < 2 * K₂ * (4 * K₂) ^ (m / (2 - m)) :=
      mul_pos (by positivity) (Real.rpow_pos_of_pos (by positivity) _)
    linarith [hC_row_pos]
  let C₀ : ℝ := Real.sqrt C₀_sq
  have hC₀_pos : 0 < C₀ := Real.sqrt_pos.mpr hC₀_sq_pos
  have hrm_nonneg : ∀ j : ℝ, 0 ≤ rowMomentFull S j :=
    fun j => mul_nonneg (Real.exp_nonneg _) (Real.sqrt_nonneg _)
  have hLinear_bound : ∀ N : ℝ → ℝ, IsCriticalEnvelope S β a C_N C₁ N →
      ∀ k : ℝ, k₀ ≤ k → rowMomentFull S k ≤ C₀ * N k := by
    intro N hN
    let R_N : Set ℝ := (fun j : ℝ => rowMomentFull S j / N j) '' Set.Ici k₀
    let C_star : ℝ := sSup R_N
    have hRN_ne : R_N.Nonempty :=
      ⟨rowMomentFull S k₀ / N k₀, ⟨k₀, Set.mem_Ici.mpr le_rfl, rfl⟩⟩
    obtain ⟨M_fin, _, hM_fin⟩ := hN.finite_ratio
    have hRN_bdd : BddAbove R_N := by
      refine ⟨M_fin, ?_⟩
      rintro r ⟨j, hj, rfl⟩
      have hj_k0 : k₀ ≤ j := Set.mem_Ici.mp hj
      have hNj_pos : 0 < N j := lt_of_lt_of_le zero_lt_one (hN.one_le j hj_k0)
      exact (div_le_iff₀ hNj_pos).mpr (hM_fin j hj_k0)
    have hCstar_nonneg : 0 ≤ C_star := by
      have hNk0_pos : 0 < N k₀ := lt_of_lt_of_le zero_lt_one (hN.one_le k₀ le_rfl)
      have h0 : 0 ≤ rowMomentFull S k₀ / N k₀ := div_nonneg (hrm_nonneg k₀) (le_of_lt hNk0_pos)
      exact le_trans h0 (le_csSup hRN_bdd ⟨k₀, Set.mem_Ici.mpr le_rfl, rfl⟩)
    have hRatio_star : ∀ j : ℝ, k₀ ≤ j → rowMomentFull S j ≤ C_star * N j := by
      intro j hj
      have hNj_pos : 0 < N j := lt_of_lt_of_le zero_lt_one (hN.one_le j hj)
      have hmem : rowMomentFull S j / N j ∈ R_N := ⟨j, Set.mem_Ici.mpr hj, rfl⟩
      exact (div_le_iff₀ hNj_pos).mp (le_csSup hRN_bdd hmem)
    let M_rhs_sq : ℝ := K₁ + K₂ * (1 + C_star) ^ m
    have hM_rhs_sq_nonneg : 0 ≤ M_rhs_sq := by
      dsimp [M_rhs_sq]
      have : 0 ≤ K₂ * (1 + C_star) ^ m :=
        mul_nonneg (le_of_lt hK₂_pos) (Real.rpow_nonneg (by linarith) m)
      linarith [hC_row_pos]
    let M_rhs : ℝ := Real.sqrt M_rhs_sq
    have hRatio_improved : ∀ k : ℝ, k₀ ≤ k → rowMomentFull S k / N k ≤ M_rhs := by
      intro k hk
      let B_k : ℝ := C_V * C_N ^ 2 * Real.exp (2 * max β a) * (1 + C_star) ^ m * (N k) ^ 2
      have hBk_nonneg : 0 ≤ B_k := by
        dsimp [B_k]
        exact mul_nonneg
          (mul_nonneg
            (mul_nonneg (mul_nonneg (le_of_lt hC_V_pos) (sq_nonneg _)) (Real.exp_nonneg _))
            (Real.rpow_nonneg (by linarith) m))
          (sq_nonneg _)
      have hB_row : ∀ l : ℝ, k₀ ≤ l → |l - k| ≤ 1 →
          (2 * Real.pi)⁻¹ * (∫ u in (0 : ℝ)..(2 * Real.pi), F l u) ≤ B_k := by
        intro l hl hdist
        have hNl_le : N l ≤ C_N * N k * Real.exp (max β a) := by
          simpa using hEnv_window N hN 1 k l zero_le_one hk hl hdist
        have hNl_nonneg : 0 ≤ N l := le_trans zero_le_one (hN.one_le l hl)
        have hNl_sq : (N l) ^ 2 ≤ C_N ^ 2 * Real.exp (2 * max β a) * (N k) ^ 2 := by
          have hsq := pow_le_pow_left₀ hNl_nonneg hNl_le 2
          have hexp2 : (Real.exp (max β a)) ^ 2 = Real.exp (2 * max β a) := by
            rw [← Real.exp_nat_mul]
            push_cast
            ring_nf
          calc (N l) ^ 2 ≤ (C_N * N k * Real.exp (max β a)) ^ 2 := hsq
            _ = C_N ^ 2 * (Real.exp (max β a)) ^ 2 * (N k) ^ 2 := by ring
            _ = C_N ^ 2 * Real.exp (2 * max β a) * (N k) ^ 2 := by rw [hexp2]
        have hcm := (hConeMom N C_star l hN hCstar_nonneg hRatio_star hl).1
        have hfac : 0 ≤ C_V * (1 + C_star) ^ m :=
          mul_nonneg (le_of_lt hC_V_pos) (Real.rpow_nonneg (by linarith) m)
        calc (2 * Real.pi)⁻¹ * (∫ u in (0 : ℝ)..(2 * Real.pi), F l u)
            ≤ C_V * (1 + C_star) ^ m * (N l) ^ 2 := hcm
          _ ≤ C_V * (1 + C_star) ^ m * (C_N ^ 2 * Real.exp (2 * max β a) * (N k) ^ 2) :=
              mul_le_mul_of_nonneg_left hNl_sq hfac
          _ = B_k := by dsimp [B_k]; ring
      have hsq_k := hRowSq k B_k hk hBk_nonneg hB_row
      have hNk_ge_one : 1 ≤ N k := hN.one_le k hk
      have hNk_pos : 0 < N k := lt_of_lt_of_le zero_lt_one hNk_ge_one
      have hNk_sq_ge_one : 1 ≤ (N k) ^ 2 := by nlinarith
      have hsq_rhs : (rowMomentFull S k) ^ 2 ≤ (M_rhs * N k) ^ 2 := by
        calc (rowMomentFull S k) ^ 2
            ≤ C_row * (1 + B_k) := hsq_k
          _ ≤ C_row * ((N k) ^ 2 + B_k) := by nlinarith [hC_row_pos]
          _ = M_rhs_sq * (N k) ^ 2 := by dsimp [M_rhs_sq, K₁, K₂, B_k]; ring
          _ = M_rhs ^ 2 * (N k) ^ 2 := by rw [Real.sq_sqrt hM_rhs_sq_nonneg]
          _ = (M_rhs * N k) ^ 2 := by ring
      have hle_prod : rowMomentFull S k ≤ M_rhs * N k :=
        (abs_le_of_sq_le_sq' hsq_rhs (mul_nonneg (Real.sqrt_nonneg _) (le_of_lt hNk_pos))).2
      exact (div_le_iff₀ hNk_pos).mpr hle_prod
    have hCstar_le_M : C_star ≤ M_rhs := by
      apply csSup_le hRN_ne
      rintro r ⟨k, hk, rfl⟩
      exact hRatio_improved k (Set.mem_Ici.mp hk)
    have hCstar_sq_fp : C_star ^ 2 ≤ K₁ + K₂ * (1 + C_star) ^ m := by
      have hsq := pow_le_pow_left₀ hCstar_nonneg hCstar_le_M 2
      rwa [Real.sq_sqrt hM_rhs_sq_nonneg] at hsq
    have hYoung_fp : K₂ * (1 + C_star) ^ m ≤
        1 / 2 + (1 / 2) * C_star ^ 2 + K₂ * (4 * K₂) ^ (m / (2 - m)) := by
      have hw1 : 0 ≤ m / 2 := by linarith
      have hw2 : 0 ≤ 1 - m / 2 := by linarith
      have h4K : 0 < 4 * K₂ := by positivity
      let p₁ : ℝ := (4 * K₂)⁻¹ * (1 + C_star) ^ 2
      let p₂ : ℝ := (4 * K₂) ^ (m / (2 - m))
      have hp₁ : 0 ≤ p₁ := by positivity
      have hp₂ : 0 ≤ p₂ := Real.rpow_nonneg (le_of_lt h4K) _
      have hgm := Real.geom_mean_le_arith_mean2_weighted hw1 hw2 hp₁ hp₂
        (by ring : m / 2 + (1 - m / 2) = 1)
      have hlhs : p₁ ^ (m / 2) * p₂ ^ (1 - m / 2) = (1 + C_star) ^ m := by
        dsimp [p₁, p₂]
        rw [Real.mul_rpow (by positivity) (sq_nonneg _), Real.inv_rpow (le_of_lt h4K),
          ← Real.rpow_two (1 + C_star), ← Real.rpow_mul (by linarith),
          ← Real.rpow_mul (le_of_lt h4K),
          show (2 : ℝ) * (m / 2) = m by ring,
          show m / (2 - m) * (1 - m / 2) = m / 2 by
            have : 2 - m ≠ 0 := by linarith
            field_simp]
        have hpos : (4 * K₂) ^ (m / 2) ≠ 0 := ne_of_gt (Real.rpow_pos_of_pos h4K _)
        calc ((4 * K₂) ^ (m / 2))⁻¹ * (1 + C_star) ^ m * (4 * K₂) ^ (m / 2)
            = (((4 * K₂) ^ (m / 2))⁻¹ * (4 * K₂) ^ (m / 2)) * (1 + C_star) ^ m := by ring
          _ = (1 + C_star) ^ m := by rw [inv_mul_cancel₀ hpos, one_mul]
      have hrhs : (m / 2) * p₁ + (1 - m / 2) * p₂ ≤ p₁ + p₂ := by nlinarith
      have h1 : (1 + C_star) ^ m ≤ p₁ + p₂ := by linarith
      have h2 : K₂ * (1 + C_star) ^ m ≤ K₂ * (p₁ + p₂) :=
        mul_le_mul_of_nonneg_left h1 (le_of_lt hK₂_pos)
      have h3 : K₂ * p₁ = (1 / 4 : ℝ) * (1 + C_star) ^ 2 := by
        dsimp [p₁]
        have : K₂ ≠ 0 := ne_of_gt hK₂_pos
        field_simp
      have hsq : (1 + C_star) ^ 2 ≤ 2 * (1 + C_star ^ 2) := by
        nlinarith [sq_nonneg (1 - C_star)]
      nlinarith
    have hCstar_sq_le : C_star ^ 2 ≤ C₀ ^ 2 := by
      rw [Real.sq_sqrt (le_of_lt hC₀_sq_pos)]
      dsimp [C₀_sq]
      linarith
    have hCstar_le_C0 : C_star ≤ C₀ :=
      (abs_le_of_sq_le_sq' hCstar_sq_le (le_of_lt hC₀_pos)).2
    intro k hk
    have hNk_nonneg : 0 ≤ N k := le_trans zero_le_one (hN.one_le k hk)
    exact le_trans (hRatio_star k hk) (mul_le_mul_of_nonneg_right hCstar_le_C0 hNk_nonneg)
  
  let C_quad : ℝ := max C₀ (C_V * (1 + C₀) ^ m)
  let C_p : ℝ := C_V * (1 + C₀) ^ 2
  have hC_quad_pos : 0 < C_quad := lt_of_lt_of_le hC₀_pos (le_max_left _ _)
  have hC_p_pos : 0 < C_p := by dsimp [C_p]; positivity
  refine ⟨C_quad, C_p, hC_quad_pos, hC_p_pos, ?_, ?_⟩
  · intro N hN k hk
    have hNk_nonneg : 0 ≤ N k := le_trans zero_le_one (hN.one_le k hk)
    have hlin := hLinear_bound N hN k hk
    obtain ⟨hV_L1, hV_Lp⟩ :=
      hConeMom N C₀ k hN (le_of_lt hC₀_pos) (hLinear_bound N hN) hk
    refine ⟨?_, ?_, hV_Lp⟩
    · exact le_trans hlin (mul_le_mul_of_nonneg_right (le_max_left _ _) hNk_nonneg)
    · exact le_trans hV_L1 (mul_le_mul_of_nonneg_right (le_max_right _ _) (sq_nonneg _))
  · intro A hA
    obtain ⟨C_t2, hC_t2_pos, hTileRows⟩ := hInt.tile_L2_from_rows A hA
    let M_scale : ℝ := C₀ * C_N * Real.exp (max β a * (A + 1))
    have hM_scale_pos : 0 < M_scale := by dsimp [M_scale]; positivity
    let C_tile_sq : ℝ := C_t2 * (1 + 2 * (A + 1) * M_scale ^ 2)
    have hC_tile_sq_pos : 0 < C_tile_sq := by dsimp [C_tile_sq]; positivity
    let C_tile : ℝ := Real.sqrt C_tile_sq
    refine ⟨C_tile, Real.sqrt_pos.mpr hC_tile_sq_pos, ?_⟩
    intro N hN k hk
    have hNk_ge_one : 1 ≤ N k := hN.one_le k hk
    have hNk_nonneg : 0 ≤ N k := le_trans zero_le_one hNk_ge_one
    have hNk_sq_ge_one : 1 ≤ (N k) ^ 2 := by nlinarith
    let a_lim : ℝ := max k₀ (k - A - 1)
    let b_lim : ℝ := k + A + 1
    have ha_le_b : a_lim ≤ b_lim := max_le (by linarith) (by linarith)
    have hb_sub_a : b_lim - a_lim ≤ 2 * (A + 1) := by
      have : k - A - 1 ≤ a_lim := le_max_right _ _
      dsimp [b_lim]
      linarith
    have hrow_win_pt : ∀ l ∈ Set.Icc a_lim b_lim,
        (rowMomentFull S l) ^ 2 ≤ M_scale ^ 2 * (N k) ^ 2 := by
      intro l hl
      have hl_k0 : k₀ ≤ l := le_trans (le_max_left _ _) hl.1
      have hl_lo : k - A - 1 ≤ l := le_trans (le_max_right _ _) hl.1
      have habs : |l - k| ≤ A + 1 :=
        abs_sub_le_iff.mpr ⟨by dsimp [b_lim] at hl; linarith [hl.2], by linarith⟩
      have hNl_le : N l ≤ C_N * N k * Real.exp (max β a * (A + 1)) :=
        hEnv_window N hN (A + 1) k l (by linarith) hk hl_k0 habs
      have hrm_le : rowMomentFull S l ≤ M_scale * N k := by
        calc rowMomentFull S l
            ≤ C₀ * N l := hLinear_bound N hN l hl_k0
          _ ≤ C₀ * (C_N * N k * Real.exp (max β a * (A + 1))) :=
              mul_le_mul_of_nonneg_left hNl_le (le_of_lt hC₀_pos)
          _ = M_scale * N k := by dsimp [M_scale]; ring
      calc (rowMomentFull S l) ^ 2
          ≤ (M_scale * N k) ^ 2 := pow_le_pow_left₀ (hrm_nonneg l) hrm_le 2
        _ = M_scale ^ 2 * (N k) ^ 2 := by ring
    have hI_rows_le : (∫ l in a_lim..b_lim, (rowMomentFull S l) ^ 2) ≤
        2 * (A + 1) * M_scale ^ 2 * (N k) ^ 2 := by
      by_cases hInt_rows :
          IntervalIntegrable (fun l => (rowMomentFull S l) ^ 2) MeasureTheory.volume a_lim b_lim
      · have hmono := intervalIntegral.integral_mono_on ha_le_b hInt_rows intervalIntegrable_const
          hrow_win_pt
        rw [intervalIntegral.integral_const, smul_eq_mul] at hmono
        have hfac : 0 ≤ M_scale ^ 2 * (N k) ^ 2 := by positivity
        calc (∫ l in a_lim..b_lim, (rowMomentFull S l) ^ 2)
            ≤ (b_lim - a_lim) * (M_scale ^ 2 * (N k) ^ 2) := hmono
          _ ≤ (2 * (A + 1)) * (M_scale ^ 2 * (N k) ^ 2) :=
              mul_le_mul_of_nonneg_right hb_sub_a hfac
          _ = 2 * (A + 1) * M_scale ^ 2 * (N k) ^ 2 := by ring
      · rw [intervalIntegral.integral_undef hInt_rows]
        positivity
    have htile_sq : (2 * Real.pi)⁻¹ * (∫ x in (0 : ℝ)..(2 * Real.pi), (tileSupModulus S A k x) ^ 2) ≤
        (C_tile * N k) ^ 2 := by
      have ht := hTileRows k hk
      change (2 * Real.pi)⁻¹ * (∫ x in (0 : ℝ)..(2 * Real.pi), (tileSupModulus S A k x) ^ 2) ≤
        C_t2 * (1 + ∫ l in a_lim..b_lim, (rowMomentFull S l) ^ 2) at ht
      calc (2 * Real.pi)⁻¹ * (∫ x in (0 : ℝ)..(2 * Real.pi), (tileSupModulus S A k x) ^ 2)
          ≤ C_t2 * (1 + ∫ l in a_lim..b_lim, (rowMomentFull S l) ^ 2) := ht
        _ ≤ C_t2 * ((N k) ^ 2 + 2 * (A + 1) * M_scale ^ 2 * (N k) ^ 2) := by
            nlinarith [hC_t2_pos, hNk_sq_ge_one, hI_rows_le]
        _ = C_tile_sq * (N k) ^ 2 := by dsimp [C_tile_sq]; ring
        _ = C_tile ^ 2 * (N k) ^ 2 := by rw [Real.sq_sqrt (le_of_lt hC_tile_sq_pos)]
        _ = (C_tile * N k) ^ 2 := by ring
    exact Real.sqrt_le_iff.mpr ⟨mul_nonneg (Real.sqrt_nonneg _) hNk_nonneg, htile_sq⟩

theorem ucb_strip_poisson_representation (S : FiniteWallNonisotropicStrip)
    (hInt : BootInteriorTransferProp S) :
    UcbStripPoissonData S :=
by
  have hCoshId : ∀ X : ℝ,
      Real.cosh X - 1 = (1 / 2 : ℝ) * Real.exp |X| * (1 - Real.exp (-|X|)) ^ 2 := by
    intro X
    rw [← Real.cosh_abs, Real.cosh_eq]
    have hexp : Real.exp |X| * Real.exp (-|X|) = 1 := by
      rw [← Real.exp_add, add_neg_cancel, Real.exp_zero]
    calc
      (Real.exp |X| + Real.exp (-|X|)) / 2 - 1
        = (Real.exp |X| - 2 * (Real.exp |X| * Real.exp (-|X|)) +
            (Real.exp |X| * Real.exp (-|X|)) * Real.exp (-|X|)) / 2 := by
          rw [hexp]; ring
      _ = (1 / 2 : ℝ) * Real.exp |X| * (1 - Real.exp (-|X|)) ^ 2 := by ring
  have hCoshGeOne : ∀ X : ℝ, 1 ≤ Real.cosh X := by
    intro X
    have h := hCoshId X
    have hnonneg : 0 ≤ (1 / 2 : ℝ) * Real.exp |X| * (1 - Real.exp (-|X|)) ^ 2 := by positivity
    linarith
  have hOneSubCosPos : ∀ θ : ℝ, 0 < θ → θ < Real.pi → 0 < 1 - Real.cos θ := by
    intro θ hθ0 hθpi
    have hsin2 : 0 < Real.sin (θ / 2) :=
      Real.sin_pos_of_pos_of_lt_pi (by linarith) (by linarith)
