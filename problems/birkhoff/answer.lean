        _ ≤ t ^ (8 : ℕ) := pow_le_pow_right₀ ht_ge_1 (by decide)
    have hexp_le : 7 * t ^ (8 : ℕ) - (3 / 4 : ℝ) * t ^ (16 : ℕ) ≤ -t := by
      have h16 : t ^ (16 : ℕ) = t ^ (8 : ℕ) * t ^ (8 : ℕ) := by ring
      rw [h16]
      nlinarith
    have hCQ_le_t : 200 * C_Q + 1 ≤ t :=
      le_trans (le_trans (le_max_right _ _) (le_max_right _ _)) ht_ge_tmin
    have hexp_t : 200 * C_Q + 1 ≤ Real.exp t := by linarith [Real.add_one_le_exp t]
    have h1 : Real.exp (7 * t ^ (8 : ℕ) - (3 / 4 : ℝ) * t ^ (16 : ℕ)) ≤ (Real.exp t)⁻¹ := by
      rw [← Real.exp_neg]
      exact Real.exp_le_exp.mpr hexp_le
    have hpos_et : 0 < Real.exp t := Real.exp_pos t
    calc C_Q * (2 * Real.exp (7 * t ^ (8 : ℕ) - (3 / 4 : ℝ) * t ^ (16 : ℕ)))
        ≤ C_Q * (2 * (Real.exp t)⁻¹) :=
          mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left h1 (by norm_num)) hC_Q_nn
      _ = (2 * C_Q) * (Real.exp t)⁻¹ := by ring
      _ ≤ ((1 / 100 : ℝ) * Real.exp t) * (Real.exp t)⁻¹ :=
          mul_le_mul_of_nonneg_right (by linarith) (le_of_lt (inv_pos.mpr hpos_et))
      _ = 1 / 100 := by field_simp [ne_of_gt hpos_et]
  
  obtain ⟨E_inv, hE_inv_meas, hE_inv_spec⟩ := hJac_spec L K hL_ge_min hK_ge_jac
  let ρ := G.stepRadius L
  let E_gap : Set WalkSpace := {om : WalkSpace |
    ¬ ((∃ m : ℕ, L ≤ Finset.univ.sup' Finset.univ_nonempty
          (fun j => sliceHistory S P ρ om j m)) ∧
        (∀ j : Fin P.N,
          sliceHistory S P ρ om j (sliceStopTau S P ρ L om) ≤ u₀ ∨
            3 * K ≤ sliceHistory S P ρ om j (sliceStopTau S P ρ L om)))}
  let E_clk : Set WalkSpace := {om : WalkSpace |
    100 * G.C_clk < ∑ m ∈ Finset.range (sliceStopTau S P ρ L om), (ρ (walkPos ρ om m)) ^ 2}
  let E_geom : Set WalkSpace := {om : WalkSpace |
    ∃ m ≤ sliceStopTau S P ρ L om, L ^ σ < sliceGeomCost S P (walkPos ρ om m)}
  let E_hit : Set WalkSpace := {om : WalkSpace |
    ∃ j : Fin P.N,
      (∃ m ≤ sliceStopTau S P ρ L om, sliceShapeDepth S P j (walkPos ρ om m) ≤ d) ∧
      ¬ ((∀ ζ ∈ Metric.closedBall
              (sliceImpactSeq S P.N j.val (walkPos ρ om (sliceFirstHit S P ρ L d j om))) r_rob,
            ‖S.f ζ‖ ≤ Real.exp (-h₁)) ∨
          (∀ ζ ∈ Metric.closedBall
              (sliceImpactSeq S P.N j.val (walkPos ρ om (sliceFirstHit S P ρ L d j om))) r_rob,
            Real.exp h₁ ≤ ‖S.f ζ‖))}
  let E_rem_j : Fin P.N → Set WalkSpace := fun j => {om : WalkSpace |
    d ^ 2 * Real.exp u₀ <
      ∑ m ∈ Finset.Ico (sliceFirstHit S P ρ L d j om) (sliceStopTau S P ρ L om),
        ‖deriv (sliceImpactSeq S P.N j.val) (walkPos ρ om m)‖ ^ 2 * (ρ (walkPos ρ om m)) ^ 2}
  let E_rem : Set WalkSpace := ⋃ j ∈ (Finset.univ : Finset (Fin P.N)), E_rem_j j
  let E_disp_p : Finset (Fin P.N) × Fin P.N → Set WalkSpace := fun p =>
    if hp : p.2 ∈ p.1 then
      have hJ_p : p.1.Nonempty := ⟨p.2, hp⟩
      {om : WalkSpace |
        (∑ m ∈ Finset.Ico (sliceLastFirstHit S P ρ L d p.1 hJ_p om)
            (sliceDiskExit S P ρ L d r_rob p.1 hJ_p p.2 om),
          (2 * ‖deriv (sliceImpactSeq S P.N p.2.val) (walkPos ρ om m)‖ ^ 2 +
            Real.exp (-2 * L ^ 3)) * (ρ (walkPos ρ om m)) ^ 2 ≤ q_K) ∧
        r_rob <
          ‖sliceImpactSeq S P.N p.2.val
              (walkPos ρ om (sliceDiskExit S P ρ L d r_rob p.1 hJ_p p.2 om)) -
            sliceImpactSeq S P.N p.2.val
              (walkPos ρ om (sliceLastFirstHit S P ρ L d p.1 hJ_p om))‖}
    else ∅
  let E_disp : Set WalkSpace := ⋃ p ∈ Q_fin, E_disp_p p
  have hE_gap_le : walkMeasure.real E_gap ≤ 1 / 10 := hGap_meas
  have hE_clk_le : walkMeasure.real E_clk ≤ 1 / 100 := hClk L hL_ge_min
  have hE_geom_le : walkMeasure.real E_geom ≤ 1 / 100 := hGeom_spec L hL_ge_L₁
  have hE_hit_le : walkMeasure.real E_hit ≤ 1 / 100 := by
    have h1 := hHit_spec L K k hL_ge_min hK_ge_hit hk_mem h100_overshoot
    have h2 : (P.N : ℝ) * G.C_hit *
        MeasureTheory.volume.real
          {x ∈ Set.Icc (0 : ℝ) (2 * Real.pi) | ¬ HasRobustSignDisk S K k x} ≤
        (P.N : ℝ) * G.C_hit * ε_rob :=
      mul_le_mul_of_nonneg_left hk_meas (by have := G.C_hit_pos; positivity)
    have h3 : (P.N : ℝ) * G.C_hit * ε_rob = 1 / 100 := by
      dsimp only [ε_rob]
      have := G.C_hit_pos
      field_simp [ne_of_gt hN_pos, ne_of_gt this]
    linarith
  have hE_rem_le : walkMeasure.real E_rem ≤ 1 / 100 := by
    calc walkMeasure.real E_rem
        ≤ ∑ j ∈ (Finset.univ : Finset (Fin P.N)), walkMeasure.real (E_rem_j j) :=
          MeasureTheory.measureReal_biUnion_finset_le _ _
      _ ≤ ∑ _j ∈ (Finset.univ : Finset (Fin P.N)), (G.C_rem * Real.exp (-u₀ / 4)) :=
          Finset.sum_le_sum fun j _ =>
            G.remaining_clock_tail L d u₀ j hL_ge_min hd_pos hd_lt_H4 hu₀_ge_1 hd_u₀_lt_H4
      _ = (P.N : ℝ) * G.C_rem * Real.exp (-u₀ / 4) := by simp [mul_assoc]
      _ ≤ 1 / 100 := hrem_small
  have hE_disp_le : walkMeasure.real E_disp ≤ 1 / 100 := by
    calc walkMeasure.real E_disp
        ≤ ∑ p ∈ Q_fin, walkMeasure.real (E_disp_p p) :=
          MeasureTheory.measureReal_biUnion_finset_le _ _
      _ ≤ ∑ _p ∈ Q_fin, (2 * q_K / r_rob ^ 2) := by
          refine Finset.sum_le_sum fun p hp => ?_
          have hp_mem : p.2 ∈ p.1 := (Finset.mem_filter.mp hp).2
          dsimp only [E_disp_p]
          rw [dite_eq_left_of_eq_true (eq_true hp_mem)]
          exact G.stopped_displacement_bound L d r_rob q_K p.1 ⟨p.2, hp_mem⟩ p.2
            hL_ge_min hp_mem hd_pos hd_lt_H4 hr_rob_pos hq_K_pos
      _ = C_Q * (2 * q_K / r_rob ^ 2) := by simp [C_Q]
      _ ≤ 1 / 100 := hdisp_small
  
  have h_cover : (Set.univ : Set WalkSpace) ⊆
      E_gap ∪ E_clk ∪ E_geom ∪ E_inv ∪ E_hit ∪ E_rem ∪ E_disp := by
    intro om _
    by_cases h1 : om ∈ E_gap
    · exact Or.inl (Or.inl (Or.inl (Or.inl (Or.inl (Or.inl h1)))))
    by_cases h2 : om ∈ E_clk
    · exact Or.inl (Or.inl (Or.inl (Or.inl (Or.inl (Or.inr h2)))))
    by_cases h3 : om ∈ E_geom
    · exact Or.inl (Or.inl (Or.inl (Or.inl (Or.inr h3))))
    by_cases h4 : om ∈ E_inv
    · exact Or.inl (Or.inl (Or.inl (Or.inr h4)))
    by_cases h5 : om ∈ E_hit
    · exact Or.inl (Or.inl (Or.inr h5))
    by_cases h6 : om ∈ E_rem
    · exact Or.inl (Or.inr h6)
    right
    have hgap_ok : (∃ m : ℕ, L ≤ Finset.univ.sup' Finset.univ_nonempty
          (fun j => sliceHistory S P ρ om j m)) ∧
        (∀ j : Fin P.N, sliceHistory S P ρ om j (sliceStopTau S P ρ L om) ≤ u₀ ∨
          3 * K ≤ sliceHistory S P ρ om j (sliceStopTau S P ρ L om)) :=
      not_not.mp h1
    obtain ⟨J, hJ, i, hi_J, hJ_compl, hi_hit, hi_eq_TJ, hη_le_tau, hJ_le_TJ, hIco_ball, hη_exit⟩ :=
      hTrap_spec L K k hL_ge_min hK_ge_trap hk_mem h3K_lt_L om hgap_ok.1 hgap_ok.2
    have h_geom_ok : ∀ n ≤ sliceStopTau S P ρ L om,
        sliceGeomCost S P (walkPos ρ om n) ≤ t := by
      intro n hn
      by_contra hgt
      exact h3 ⟨n, hn, lt_of_le_of_lt hL_sigma_le_t (not_le.mp hgt)⟩
    have hi_ball_sign :
        (∀ ζ ∈ Metric.closedBall
            (sliceImpactSeq S P.N i.val (walkPos ρ om
              (sliceLastFirstHit S P ρ L d J hJ om))) r_rob,
          ‖S.f ζ‖ ≤ Real.exp (-h₁)) ∨
        (∀ ζ ∈ Metric.closedBall
            (sliceImpactSeq S P.N i.val (walkPos ρ om
              (sliceLastFirstHit S P ρ L d J hJ om))) r_rob,
          Real.exp h₁ ≤ ‖S.f ζ‖) := by
      rw [← hi_eq_TJ]
      by_contra hfail
      exact h5 ⟨i, hi_hit, hfail⟩
    let T_J := sliceLastFirstHit S P ρ L d J hJ om
    let η := sliceDiskExit S P ρ L d r_rob J hJ i om
    have h_deriv_sum :
        ∑ m ∈ Finset.Ico T_J η,
          2 * ‖deriv (sliceImpactSeq S P.N i.val) (walkPos ρ om m)‖ ^ 2 *
            (ρ (walkPos ρ om m)) ^ 2 ≤ (1 / 2 : ℝ) * q_K := by
      have h_pt : ∀ m ∈ Finset.Ico T_J η,
          2 * ‖deriv (sliceImpactSeq S P.N i.val) (walkPos ρ om m)‖ ^ 2 *
            (ρ (walkPos ρ om m)) ^ 2 ≤
          (1 / (2 * (P.N : ℝ))) * Real.exp (6 * h₂ - 2 * h₁) *
            ∑ j ∈ J, ‖deriv (sliceImpactSeq S P.N j.val) (walkPos ρ om m)‖ ^ 2 *
              (ρ (walkPos ρ om m)) ^ 2 := by
        intro m hm
        obtain ⟨hm_le_tau, hm_ball⟩ := hIco_ball m hm
        have hm_sign : ‖sliceSpeedSeq S P.N i.val (walkPos ρ om m)‖ ≤ Real.exp (-h₁) ∨
            Real.exp h₁ ≤ ‖sliceSpeedSeq S P.N i.val (walkPos ρ om m)‖ := by
          unfold sliceSpeedSeq
          rcases hi_ball_sign with hlow | hhigh
          · exact Or.inl (hlow _ hm_ball)
          · exact Or.inr (hhigh _ hm_ball)
        have h_jac := hE_inv_spec om h4 h_geom_ok J hJ hJ_compl m hm_le_tau i hm_sign
        have h_mul := mul_le_mul_of_nonneg_right h_jac (sq_nonneg (ρ (walkPos ρ om m)))
        change 2 * ‖deriv (sliceImpactSeq S P.N i.val) (walkPos ρ om m)‖ ^ 2 *
            (ρ (walkPos ρ om m)) ^ 2 ≤
          (1 / (2 * (P.N : ℝ)) * Real.exp (6 * h₂ - 2 * h₁) *
            ∑ j ∈ J, ‖deriv (sliceImpactSeq S P.N j.val) (walkPos ρ om m)‖ ^ 2) *
              (ρ (walkPos ρ om m)) ^ 2 at h_mul
        rwa [mul_assoc (1 / (2 * (P.N : ℝ)) * Real.exp (6 * h₂ - 2 * h₁)), Finset.sum_mul] at h_mul
      calc ∑ m ∈ Finset.Ico T_J η,
            2 * ‖deriv (sliceImpactSeq S P.N i.val) (walkPos ρ om m)‖ ^ 2 *
              (ρ (walkPos ρ om m)) ^ 2
          ≤ ∑ m ∈ Finset.Ico T_J η,
              (1 / (2 * (P.N : ℝ))) * Real.exp (6 * h₂ - 2 * h₁) *
                ∑ j ∈ J, ‖deriv (sliceImpactSeq S P.N j.val) (walkPos ρ om m)‖ ^ 2 *
                  (ρ (walkPos ρ om m)) ^ 2 := Finset.sum_le_sum h_pt
        _ = (1 / (2 * (P.N : ℝ))) * Real.exp (6 * h₂ - 2 * h₁) *
              ∑ j ∈ J, ∑ m ∈ Finset.Ico T_J η,
                ‖deriv (sliceImpactSeq S P.N j.val) (walkPos ρ om m)‖ ^ 2 *
                  (ρ (walkPos ρ om m)) ^ 2 := by
            rw [← Finset.mul_sum, Finset.sum_comm]
        _ ≤ (1 / (2 * (P.N : ℝ))) * Real.exp (6 * h₂ - 2 * h₁) *
              ∑ _j ∈ J, (d ^ 2 * Real.exp u₀) := by
            refine mul_le_mul_of_nonneg_left (Finset.sum_le_sum fun j hj => ?_) (by positivity)
            have h_sub_Ico : Finset.Ico T_J η ⊆
                Finset.Ico (sliceFirstHit S P ρ L d j om) (sliceStopTau S P ρ L om) :=
              Finset.Ico_subset_Ico (hJ_le_TJ j hj) hη_le_tau
            have h_le_rem : ∑ m ∈ Finset.Ico (sliceFirstHit S P ρ L d j om)
                  (sliceStopTau S P ρ L om),
                ‖deriv (sliceImpactSeq S P.N j.val) (walkPos ρ om m)‖ ^ 2 *
                  (ρ (walkPos ρ om m)) ^ 2 ≤ d ^ 2 * Real.exp u₀ := by
              by_contra hgt
              exact h6 (Set.mem_biUnion (Finset.mem_univ j) (not_le.mp hgt))
            exact le_trans
              (Finset.sum_le_sum_of_subset_of_nonneg h_sub_Ico fun _ _ _ => by positivity)
              h_le_rem
        _ ≤ (1 / (2 * (P.N : ℝ))) * Real.exp (6 * h₂ - 2 * h₁) *
              ((P.N : ℝ) * (d ^ 2 * Real.exp u₀)) := by
            simp only [Finset.sum_const, nsmul_eq_mul]
            have hJ_card : (J.card : ℝ) ≤ (P.N : ℝ) := by
              exact_mod_cast le_trans (Finset.card_le_card (Finset.subset_univ J))
                (by simp)
            exact mul_le_mul_of_nonneg_left
              (mul_le_mul_of_nonneg_right hJ_card (by positivity)) (by positivity)
        _ = (1 / 2 : ℝ) * d ^ 2 * (Real.exp (6 * h₂ - 2 * h₁) * Real.exp u₀) := by
            field_simp [ne_of_gt hN_pos]
        _ = (1 / 2 : ℝ) * (d ^ 2 * Real.exp (6 * h₂ + u₀ - 2 * h₁)) := by
            rw [← Real.exp_add]; ring_nf
        _ ≤ (1 / 2 : ℝ) * q_K := by
            have hu₀_le_h₂ : u₀ ≤ h₂ := by
              rw [hu₀_eq, hh₂_eq]
              exact pow_le_pow_right₀ ht_ge_1 (by decide)
            dsimp only [q_K]
            refine mul_le_mul_of_nonneg_left
              (mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr (by linarith)) (by positivity))
              (by norm_num)
    have h_clk_sum :
        ∑ m ∈ Finset.Ico T_J η, Real.exp (-2 * L ^ 3) * (ρ (walkPos ρ om m)) ^ 2 ≤
          (1 / 2 : ℝ) * q_K := by
      have h_sub_range : Finset.Ico T_J η ⊆ Finset.range (sliceStopTau S P ρ L om) := by
        intro m hm
        rw [Finset.mem_Ico] at hm
        exact Finset.mem_range.mpr (lt_of_lt_of_le hm.2 hη_le_tau)
      have h_tot_clk : ∑ m ∈ Finset.range (sliceStopTau S P ρ L om),
          (ρ (walkPos ρ om m)) ^ 2 ≤ 100 * G.C_clk := not_lt.mp h2
      calc ∑ m ∈ Finset.Ico T_J η, Real.exp (-2 * L ^ 3) * (ρ (walkPos ρ om m)) ^ 2
          = Real.exp (-2 * L ^ 3) * ∑ m ∈ Finset.Ico T_J η, (ρ (walkPos ρ om m)) ^ 2 := by
            rw [Finset.mul_sum]
        _ ≤ Real.exp (-2 * L ^ 3) *
              ∑ m ∈ Finset.range (sliceStopTau S P ρ L om), (ρ (walkPos ρ om m)) ^ 2 :=
            mul_le_mul_of_nonneg_left
              (Finset.sum_le_sum_of_subset_of_nonneg h_sub_range fun _ _ _ => sq_nonneg _)
              (le_of_lt (Real.exp_pos _))
        _ ≤ Real.exp (-2 * L ^ 3) * (100 * G.C_clk) :=
            mul_le_mul_of_nonneg_left h_tot_clk (le_of_lt (Real.exp_pos _))
        _ = 100 * G.C_clk * Real.exp (-2 * L ^ 3) := by ring
        _ ≤ (1 / 2 : ℝ) * q_K := hclk_half_qK
    have h_comb_sum :
        ∑ m ∈ Finset.Ico T_J η,
          (2 * ‖deriv (sliceImpactSeq S P.N i.val) (walkPos ρ om m)‖ ^ 2 +
            Real.exp (-2 * L ^ 3)) * (ρ (walkPos ρ om m)) ^ 2 ≤ q_K := by
      have h_split : ∑ m ∈ Finset.Ico T_J η,
            (2 * ‖deriv (sliceImpactSeq S P.N i.val) (walkPos ρ om m)‖ ^ 2 +
              Real.exp (-2 * L ^ 3)) * (ρ (walkPos ρ om m)) ^ 2 =
          (∑ m ∈ Finset.Ico T_J η,
            2 * ‖deriv (sliceImpactSeq S P.N i.val) (walkPos ρ om m)‖ ^ 2 *
              (ρ (walkPos ρ om m)) ^ 2) +
          (∑ m ∈ Finset.Ico T_J η,
            Real.exp (-2 * L ^ 3) * (ρ (walkPos ρ om m)) ^ 2) := by
        rw [← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl fun m _ => by ring
      rw [h_split]
      linarith
    have hp_Q : (J, i) ∈ Q_fin := Finset.mem_filter.mpr ⟨Finset.mem_univ _, hi_J⟩
    refine Set.mem_biUnion hp_Q ?_
    dsimp only [E_disp_p]
    rw [dite_eq_left_of_eq_true (eq_true hi_J)]
    exact ⟨h_comb_sum, hη_exit⟩
  
  have h_one : (1 : ℝ) ≤ walkMeasure.real
      (E_gap ∪ E_clk ∪ E_geom ∪ E_inv ∪ E_hit ∪ E_rem ∪ E_disp) := by
    calc (1 : ℝ)
        = walkMeasure.real (Set.univ : Set WalkSpace) :=
          (@MeasureTheory.probReal_univ _ _ walkMeasure hProb).symm
      _ ≤ walkMeasure.real (E_gap ∪ E_clk ∪ E_geom ∪ E_inv ∪ E_hit ∪ E_rem ∪ E_disp) :=
          MeasureTheory.measureReal_mono h_cover (h_walk_ne_top _)
  have u1 := MeasureTheory.measureReal_union_le (μ := walkMeasure)
    (E_gap ∪ E_clk ∪ E_geom ∪ E_inv ∪ E_hit ∪ E_rem) E_disp
  have u2 := MeasureTheory.measureReal_union_le (μ := walkMeasure)
    (E_gap ∪ E_clk ∪ E_geom ∪ E_inv ∪ E_hit) E_rem
  have u3 := MeasureTheory.measureReal_union_le (μ := walkMeasure)
    (E_gap ∪ E_clk ∪ E_geom ∪ E_inv) E_hit
  have u4 := MeasureTheory.measureReal_union_le (μ := walkMeasure)
    (E_gap ∪ E_clk ∪ E_geom) E_inv
  have u5 := MeasureTheory.measureReal_union_le (μ := walkMeasure) (E_gap ∪ E_clk) E_geom
  have u6 := MeasureTheory.measureReal_union_le (μ := walkMeasure) E_gap E_clk
  linarith [h_one, u1, u2, u3, u4, u5, u6, hE_gap_le, hE_clk_le, hE_geom_le,
    hE_inv_meas, hE_hit_le, hE_rem_le, hE_disp_le]

theorem odd_slice_sign_test_contradiction (S : FiniteWallNonisotropicStrip)
    (hCrit : CriticalWallData S)
    (hBudget : CriticalAngleBudgetData S) :
    False :=
by
  have hRobust : ∀ ε : ℝ, 0 < ε →
      ∃ K₀ : ℝ, hBudget.k₀ ≤ K₀ ∧
        ∀ K : ℝ, K₀ ≤ K →
          ∃ k ∈ Set.Icc ((4 / 5 : ℝ) * K) ((11 / 5 : ℝ) * K),
            MeasureTheory.volume.real
              {x ∈ Set.Icc (0 : ℝ) (2 * Real.pi) | ¬ HasRobustSignDisk S K k x} ≤ ε := by
    intro ε hε
    have hε2 : 0 < ε / 2 := half_pos hε
    obtain ⟨K₁, hK₁_ge, hK₁⟩ := large_moment_row_sign_test S hBudget (ε / 2) hε2
    obtain ⟨K₂, hK₂_ge, hK₂⟩ := small_moment_row_sign_test S hCrit hBudget (ε / 2) hε2
    obtain ⟨K₃, hK₃_ge, hK₃⟩ := row_sign_test_to_robust_disks S hBudget (ε / 2) hε2
    refine ⟨max K₁ (max K₂ K₃), le_trans hK₁_ge (le_max_left _ _), ?_⟩
    intro K hK
    have hK_ge_one : 1 ≤ K :=
      le_trans hBudget.k₀_ge_one (le_trans hK₁_ge (le_trans (le_max_left _ _) hK))
    have hK₁_le : K₁ ≤ K := le_trans (le_max_left _ _) hK
    have hK₂₃_le : max K₂ K₃ ≤ K := le_trans (le_max_right _ _) hK
    have hK₂_le : K₂ ≤ K := le_trans (le_max_left _ _) hK₂₃_le
    have hK₃_le : K₃ ≤ K := le_trans (le_max_right _ _) hK₂₃_le
    have hk_mod : ∃ k ∈ Set.Icc ((4 / 5 : ℝ) * K) ((11 / 5 : ℝ) * K),
        MeasureTheory.volume.real
          {x ∈ Set.Icc (0 : ℝ) (2 * Real.pi) |
            Real.exp (-K ^ (1 / 200 : ℝ)) ≤ ‖S.f (upperRowPt S k x)‖ ∧
            ‖S.f (upperRowPt S k x)‖ ≤ Real.exp (K ^ (1 / 200 : ℝ))} ≤ ε / 2 := by
      by_cases hLarge : ∃ j ∈ Set.Icc ((9 / 10 : ℝ) * K) ((21 / 10 : ℝ) * K),
          K ^ (1 / 100 : ℝ) ≤ rowMomentFull S j
      · exact hK₁ K hK₁_le hLarge
      · have hSmall : ∀ v ∈ Set.Icc ((9 / 10 : ℝ) * K) ((21 / 10 : ℝ) * K),
            rowMomentFull S v ≤ K ^ (1 / 100 : ℝ) := by
          intro v hv
          by_contra hgt
          exact hLarge ⟨v, hv, le_of_not_ge hgt⟩
        obtain ⟨k, hk_mem, hk_meas⟩ := hK₂ K hK₂_le hSmall
        refine ⟨k, ⟨?_, ?_⟩, hk_meas⟩
        · linarith [hk_mem.1]
        · linarith [hk_mem.2]
    obtain ⟨k, hk_mem, hk_meas⟩ := hk_mod
    have h_rob := hK₃ K hK₃_le k hk_mem
    exact ⟨k, hk_mem, by linarith⟩
  obtain ⟨P⟩ := odd_slice_jacobi_and_boundary_contact S
  obtain ⟨G⟩ := odd_slice_stopped_geometry_all_powers S hBudget P
  exact odd_slice_last_site_contradiction S hBudget P G hRobust

theorem birkhoff_theorem_1_2 (Ω : Set Plane)
    (hΩ : IsSmoothPositivelyCurvedBilliardDomain Ω)
    (hCollar : HasContinuousCausticCollar Ω) :
    IsEllipse Ω :=
by
  obtain ⟨C⟩ := glancing_collar_conjugation Ω hΩ hCollar
  rcases shape_strip_dichotomy Ω hΩ C with hTrig | hEntire | hFinite
  · exact support_ellipse_criterion Ω hΩ C.toSupportLazutkinData hTrig
  · obtain ⟨E⟩ := hEntire
    exact False.elim (noncritical_and_entire_growth_exclusion.1 E)
  · obtain ⟨S⟩ := hFinite
    have hCrit : CriticalWallData S := noncritical_and_entire_growth_exclusion.2 S
    obtain ⟨hBudget⟩ := critical_angle_budget_and_envelope S hCrit
    exact False.elim (odd_slice_sign_test_contradiction S hCrit hBudget)
