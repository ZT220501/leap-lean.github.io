      exact (differentiableWithinAt_inter (hU_pos_open.mem_nhds hpos)).mp h_inter
  · intro p hp
    rcases lt_or_gt_of_ne (him_ne p hp) with hneg | hpos
    · have h_not : ¬ (0 ≤ p.2.im) := not_le.mpr hneg
      change (if 0 ≤ p.2.im then s_up p else s_up (p.1, -p.2)) ∈ X.D_strip
      rw [if_neg h_not]
      exact hs_up_strip (p.1, -p.2) (h_neg_up p hp hneg)
    · change (if 0 ≤ p.2.im then s_up p else s_up (p.1, -p.2)) ∈ X.D_strip
      rw [if_pos hpos.le]
      exact hs_up_strip p (h_pos_up p hp hpos)
  · intro y t hyt
    rcases lt_or_gt_of_ne (him_ne (y, t) hyt) with hneg | hpos
    · have h_not : ¬ (0 ≤ t.im) := not_le.mpr hneg
      have h_pos_neg : 0 ≤ (-t).im := by
        rw [Complex.neg_im]
        linarith only [hneg]
      have hs1 : s_steep (y, t) = s_up (y, -t) := by
        change (if 0 ≤ t.im then s_up (y, t) else s_up (y, -t)) = s_up (y, -t)
        rw [if_neg h_not]
      have hs2 : s_steep (y, -t) = s_up (y, -t) := by
        change (if 0 ≤ (-t).im then s_up (y, -t) else s_up (y, -(-t))) = s_up (y, -t)
        rw [if_pos h_pos_neg]
      refine ⟨by rw [hs1, hs2], ?_⟩
      rw [hs1]
      simpa only [norm_neg] using hs_up_bound y (-t) (h_neg_up (y, t) hyt hneg)
    · have h_not_neg : ¬ (0 ≤ (-t).im) := by
        rw [Complex.neg_im]
        linarith only [hpos]
      have hs1 : s_steep (y, t) = s_up (y, t) := by
        change (if 0 ≤ t.im then s_up (y, t) else s_up (y, -t)) = s_up (y, t)
        rw [if_pos hpos.le]
      have hs2 : s_steep (y, -t) = s_up (y, t) := by
        change (if 0 ≤ (-t).im then s_up (y, -t) else s_up (y, -(-t))) = s_up (y, t)
        rw [if_neg h_not_neg, neg_neg]
      refine ⟨by rw [hs1, hs2], ?_⟩
      rw [hs1]
      exact hs_up_bound y t (h_pos_up (y, t) hyt hpos)
  · intro y t hyt hdeep
    rcases lt_or_gt_of_ne (him_ne (y, t) hyt) with hneg | hpos
    · have h_not : ¬ (0 ≤ t.im) := not_le.mpr hneg
      have hs1 : s_steep (y, t) = s_up (y, -t) := by
        change (if 0 ≤ t.im then s_up (y, t) else s_up (y, -t)) = s_up (y, -t)
        rw [if_neg h_not]
      rw [hs1, hs_up_init y (-t) (h_neg_up (y, t) hyt hneg) hdeep]
      have hyt_S : (y, t) ∈ S_init := by
        have hD_pos : 0 < h_ref - y.im := by linarith only [hd, hyt.1]
        have hD_lt : h_ref - y.im < δ_ceil := by linarith only [hΔ, hyt.2.1]
        have hδ_pos : 0 < δ_ceil := by linarith only [hΔ, h2Δ]
        have h_Lin_gt : m_steep < L_in := by
          have : 0 < 2 / γ_steep := div_pos (by norm_num) hγ1
          dsimp only [L_in]
          linarith only [hm, this]
        have h_re : |y.re - x₀| < L_in * (h_ref - y.im) :=
          lt_trans hyt.2.2.1 (mul_lt_mul_of_pos_right h_Lin_gt hD_pos)
        have h_div_le : (h_ref - y.im) / d ≤ δ_ceil / d :=
          div_le_div_of_nonneg_right hD_lt.le hd.le
        have h_rpow_le : ((h_ref - y.im) / d) ^ α ≤ (δ_ceil / d) ^ α :=
          Real.rpow_le_rpow (div_nonneg hD_pos.le hd.le) h_div_le (by linarith only [hα1])
        have h_rpow_pos : 0 < (δ_ceil / d) ^ α :=
          Real.rpow_pos_of_pos (div_pos hδ_pos hd) α
        have h_t_lt : ‖t‖ < 12 * r * (δ_ceil / d) ^ α := by
          have h10 : 10 * r * ((h_ref - y.im) / d) ^ α ≤ 10 * r * (δ_ceil / d) ^ α :=
            mul_le_mul_of_nonneg_left h_rpow_le (by positivity)
          have h12 : 10 * r * (δ_ceil / d) ^ α < 12 * r * (δ_ceil / d) ^ α := by
            nlinarith only [hr, h_rpow_pos]
          exact lt_of_lt_of_le hyt.2.2.2.1 h10 |>.trans h12
        exact ⟨by linarith only [hΔ, hdeep], hD_lt, h_re, h_t_lt⟩
      exact (hs_init_even_bound y t hyt_S).1
    · have hs1 : s_steep (y, t) = s_up (y, t) := by
        change (if 0 ≤ t.im then s_up (y, t) else s_up (y, -t)) = s_up (y, t)
        rw [if_pos hpos.le]
      rw [hs1]
      exact hs_up_init y t (h_pos_up (y, t) hyt hpos) hdeep
  · intro y t ht_steep h_prev h_curr h_next
    dsimp only
    have hpos : 0 < t.im :=
      lt_of_le_of_lt (mul_nonneg hγ1.le (norm_nonneg t)) ht_steep
    have hs_prev : s_steep (y - t, t) = s_up (y - t, t) := by
      change (if 0 ≤ t.im then s_up (y - t, t) else s_up (y - t, -t)) = s_up (y - t, t)
      rw [if_pos hpos.le]
    have hs_curr : s_steep (y, t) = s_up (y, t) := by
      change (if 0 ≤ t.im then s_up (y, t) else s_up (y, -t)) = s_up (y, t)
      rw [if_pos hpos.le]
    have hs_next : s_steep (y + t, t) = s_up (y + t, t) := by
      change (if 0 ≤ t.im then s_up (y + t, t) else s_up (y + t, -t)) = s_up (y + t, t)
      rw [if_pos hpos.le]
    simpa only [hs_prev, hs_curr, hs_next] using
      hs_up_rec y t ht_steep
        (h_pos_up (y - t, t) h_prev hpos)
        (h_pos_up (y, t) h_curr hpos)
        (h_pos_up (y + t, t) h_next hpos)

theorem schwarz_poisson_and_dyadic_cone_filling : SchwarzPoissonBumpProp ∧ RefDyadicConeFillingProp :=
by
  let spdcConeDomain := fun (h_ref x₀ m d r α δ_min δ_max : ℝ) =>
    { p : ℂ × ℂ |
      δ_min < h_ref - p.1.im ∧ h_ref - p.1.im < δ_max ∧
      |p.1.re - x₀| < m * (h_ref - p.1.im) ∧
      ‖p.2‖ < r * ((h_ref - p.1.im) / d) ^ α }
  let spdcSteepDomain := fun (h_ref x₀ m_steep γ_dyad d r α δ_max : ℝ) =>
    { p : ℂ × ℂ |
      d / 2 < h_ref - p.1.im ∧ h_ref - p.1.im < δ_max ∧
      |p.1.re - x₀| < m_steep * (h_ref - p.1.im) ∧
      ‖p.2‖ < 10 * r * ((h_ref - p.1.im) / d) ^ α ∧
      γ_dyad * ‖p.2‖ < |p.2.im| }
  let spdcCirclePatchProp : Prop :=
    ∀ (V_comb P_patch : Set (ℂ × ℂ)) (U_comb : ℂ × ℂ → ℂ)
      (Φ_base : ℂ → ℂ × ℂ) (R_Φ : ℝ),
      IsOpen V_comb →
      DifferentiableOn ℂ U_comb V_comb →
      IsOpen P_patch →
      1 < R_Φ →
      DifferentiableOn ℂ Φ_base (Metric.ball (0 : ℂ) R_Φ) →
      Φ_base 0 = 0 →
      (∀ p ∈ P_patch, ∀ θ : ℝ, p + Φ_base (circleMap 0 1 θ) ∈ V_comb) →
      let H : ℂ × ℂ → ℂ := fun p => Real.circleAverage (fun ζ => U_comb (p + Φ_base ζ)) 0 1
      DifferentiableOn ℂ H P_patch ∧
      (∀ p ∈ P_patch,
        (∀ ζ ∈ Metric.closedBall (0 : ℂ) 1, p + Φ_base ζ ∈ V_comb) →
        H p = U_comb p) ∧
      (∀ p ∈ P_patch, ∀ M_bd : ℝ,
        (∀ θ : ℝ, ‖U_comb (p + Φ_base (circleMap 0 1 θ))‖ ≤ M_bd) →
        ‖H p‖ ≤ M_bd)
  let spdcFixedBumpProp := fun (D_dip C_bump γ_dyad R_Φ : ℝ) =>
    0 < C_bump ∧ 0 < γ_dyad ∧ γ_dyad < 1 / 8 ∧ 1 < R_Φ ∧
    ∀ c : ℂ, ‖c‖ < 1 / 3 →
      ∃ g : ℂ → ℂ,
        DifferentiableOn ℂ g (Metric.ball (0 : ℂ) R_Φ) ∧
        g 0 = 0 ∧
        (∀ ζ ∈ Metric.closedBall (0 : ℂ) 1,
          ‖g ζ‖ ≤ C_bump ∧ (g ζ).im ≤ 1 / 5) ∧
        (∀ ζ ∈ Metric.sphere (0 : ℂ) 1,
          |(c + ζ).im| ≤ (6 / 5) * γ_dyad * ‖c + ζ‖ →
          (g ζ).im ≤ -(D_dip + 1))

  have h_s1 : SchwarzPoissonBumpProp := by
    have h_clamp_le : ∀ a b : ℝ,
        max (0 : ℝ) (min 1 a) - max (0 : ℝ) (min 1 b) ≤ |a - b| := by
      intro a b
      have hab : a - b ≤ |a - b| := le_abs_self (a - b)
      have h0 : (0 : ℝ) ≤ |a - b| := abs_nonneg (a - b)
      have fb_nonneg : 0 ≤ max (0 : ℝ) (min 1 b) := le_max_left _ _
      by_cases ha : a ≤ 0
      · have fa_eq : max (0 : ℝ) (min 1 a) = 0 :=
          max_eq_left (le_trans (min_le_right 1 a) ha)
        linarith
      · push Not at ha
        by_cases hb : 1 ≤ b
        · have fb_eq : max (0 : ℝ) (min 1 b) = 1 := by
            rw [min_eq_left hb, max_eq_right zero_le_one]
          have fa_le : max (0 : ℝ) (min 1 a) ≤ 1 := max_le zero_le_one (min_le_left 1 a)
          linarith
        · push Not at hb
          have fa_le_a : max (0 : ℝ) (min 1 a) ≤ a := max_le ha.le (min_le_right 1 a)
          have b_le_fb : b ≤ max (0 : ℝ) (min 1 b) := by
            rw [min_eq_right hb.le]
            exact le_max_right 0 b
          linarith
    have h_clamp_lip : ∀ a b : ℝ,
        |max (0 : ℝ) (min 1 a) - max (0 : ℝ) (min 1 b)| ≤ |a - b| := by
      intro a b
      rw [abs_le]
      refine ⟨?_, h_clamp_le a b⟩
      have hsym := h_clamp_le b a
      rw [abs_sub_comm] at hsym
      linarith

    have h_circle_add : ∀ θ u : ℝ,
        circleMap 0 1 (θ + u) = circleMap 0 1 θ * circleMap 0 1 u := by
      intro θ u
      simp [circleMap_zero, add_mul, Complex.exp_add]

    have h_shift_ℂ : ∀ (F : ℝ → ℂ) (θ : ℝ),
        Function.Periodic F (2 * Real.pi) →
        (∫ φ in (0 : ℝ)..(2 * Real.pi), F φ) = ∫ u in (-Real.pi)..Real.pi, F (θ + u) := by
      intro F θ hper
      have h1 := hper.intervalIntegral_add_eq (θ - Real.pi) 0
      simp only [zero_add] at h1
      have h2 : θ - Real.pi + 2 * Real.pi = θ + Real.pi := by ring
      rw [← h1, h2]
      have h3 := intervalIntegral.integral_comp_add_left F θ (a := -Real.pi) (b := Real.pi)
      have h4 : θ + -Real.pi = θ - Real.pi := by ring
      rw [h4] at h3
      exact h3.symm

    have h_shift_ℝ : ∀ (F : ℝ → ℝ) (θ : ℝ),
        Function.Periodic F (2 * Real.pi) →
        (∫ φ in (0 : ℝ)..(2 * Real.pi), F φ) = ∫ u in (-Real.pi)..Real.pi, F (θ + u) := by
      intro F θ hper
      have h1 := hper.intervalIntegral_add_eq (θ - Real.pi) 0
      simp only [zero_add] at h1
      have h2 : θ - Real.pi + 2 * Real.pi = θ + Real.pi := by ring
      rw [← h1, h2]
      have h3 := intervalIntegral.integral_comp_add_left F θ (a := -Real.pi) (b := Real.pi)
      have h4 : θ + -Real.pi = θ - Real.pi := by ring
      rw [h4] at h3
      exact h3.symm

    have h_mean_kernel : ∀ w : ℂ, ‖w‖ < 1 →
        (∫ φ in (0 : ℝ)..(2 * Real.pi), w / (circleMap 0 1 φ - w)) = 0 := by
      intro w hw
      let wb : ℂ := starRingEnd ℂ w
      have hwb_norm : ‖wb‖ = ‖w‖ := Complex.norm_conj w
      let h : ℂ → ℂ := fun z => (wb * z) / (1 - wb * z)
      have h_denom_ne : ∀ z ∈ Metric.closedBall (0 : ℂ) 1, 1 - wb * z ≠ 0 := by
        intro z hz h_eq
        have hz_le : ‖z‖ ≤ 1 := by simpa using hz
        have h_mul_lt : ‖wb * z‖ < 1 := by
          calc ‖wb * z‖ = ‖w‖ * ‖z‖ := by rw [norm_mul, hwb_norm]
            _ ≤ ‖w‖ * 1 := mul_le_mul_of_nonneg_left hz_le (norm_nonneg w)
            _ = ‖w‖ := mul_one _
            _ < 1 := hw
        have h_one : (1 : ℂ) = wb * z := sub_eq_zero.mp h_eq
        have : (1 : ℝ) = ‖wb * z‖ := by simpa using congrArg norm h_one
        linarith
      have h_diffAt : ∀ z ∈ Metric.closedBall (0 : ℂ) 1, DifferentiableAt ℂ h z := by
        intro z hz
        exact (differentiableAt_const wb |>.mul differentiableAt_id).div
          (differentiableAt_const 1 |>.sub (differentiableAt_const wb |>.mul differentiableAt_id))
          (h_denom_ne z hz)
      have h_diffCont : DiffContOnCl ℂ h (Metric.ball (0 : ℂ) 1) := by
        refine ⟨fun z hz => (h_diffAt z (Metric.ball_subset_closedBall hz)).differentiableWithinAt, ?_⟩
        rw [closure_ball (0 : ℂ) one_ne_zero]
        exact fun z hz => (h_diffAt z hz).continuousAt.continuousWithinAt
      have h_avg : Real.circleAverage h 0 1 = 0 := by
        rw [Real.circleAverage_eq_circleIntegral one_ne_zero,
          h_diffCont.circleIntegral_sub_inv_smul (Metric.mem_ball_self zero_lt_one)]
        simp [h]
      have h_int_h : (∫ φ in (0 : ℝ)..(2 * Real.pi), h (circleMap 0 1 φ)) = 0 := by
        rw [Real.circleAverage_def] at h_avg
        rcases smul_eq_zero.mp h_avg with h_inv | h_zero
        · exfalso
          have : (0 : ℝ) < (2 * Real.pi)⁻¹ := by positivity
          linarith
        · exact h_zero
      have h_conj_eq : ∀ φ : ℝ,
          w / (circleMap 0 1 φ - w) = Complex.conjCLE (h (circleMap 0 1 φ)) := by
        intro φ
        set z : ℂ := circleMap 0 1 φ
        have hz_norm : ‖z‖ = 1 := by simp [z, norm_circleMap_zero]
        have hz_ne : z ≠ 0 := by
          intro h0
          simp [h0] at hz_norm
        have hzb_ne : starRingEnd ℂ z ≠ 0 := by
          intro h0
          exact hz_ne (by simpa using congrArg (starRingEnd ℂ) h0)
        have hzz : z * starRingEnd ℂ z = 1 := by
          rw [Complex.mul_conj, Complex.normSq_eq_norm_sq, hz_norm]
          norm_num
        change w / (z - w) = starRingEnd ℂ ((wb * z) / (1 - wb * z))
        simp only [wb, map_div₀, map_mul, map_sub, map_one, Complex.conj_conj]
        have h_den : 1 - w * starRingEnd ℂ z = (z - w) * starRingEnd ℂ z := by
          calc 1 - w * starRingEnd ℂ z = z * starRingEnd ℂ z - w * starRingEnd ℂ z := by rw [hzz]
            _ = (z - w) * starRingEnd ℂ z := (sub_mul z w _).symm
        rw [h_den, mul_div_mul_right w (z - w) hzb_ne]
      have h_cont_h : Continuous (fun φ : ℝ => h (circleMap 0 1 φ)) := by
        refine ContinuousOn.comp_continuous
          (fun z hz => (h_diffAt z hz).continuousAt.continuousWithinAt)
          (continuous_circleMap 0 1) ?_
        intro φ
        simp [norm_circleMap_zero]
      calc (∫ φ in (0 : ℝ)..(2 * Real.pi), w / (circleMap 0 1 φ - w))
          = ∫ φ in (0 : ℝ)..(2 * Real.pi),
              Complex.conjCLE.toContinuousLinearMap (h (circleMap 0 1 φ)) := by
              congr 1
              ext φ
              exact h_conj_eq φ
        _ = Complex.conjCLE.toContinuousLinearMap
              (∫ φ in (0 : ℝ)..(2 * Real.pi), h (circleMap 0 1 φ)) :=
              ContinuousLinearMap.intervalIntegral_comp_comm
                Complex.conjCLE.toContinuousLinearMap (h_cont_h.intervalIntegrable _ _)
        _ = 0 := by rw [h_int_h, map_zero]

    have h_poisson_re : ∀ z w : ℂ, ‖z‖ = 1 → ‖w‖ < 1 →
        (w / (z - w)).re = ((1 - ‖w‖ ^ 2) / ‖z - w‖ ^ 2 - 1) / 2 := by
      intro z w hz hw
      have hzw_ne : z - w ≠ 0 := by
        intro h0
        rw [sub_eq_zero.mp h0] at hz
        linarith
      have hzw_sq_pos : 0 < ‖z - w‖ ^ 2 := sq_pos_of_pos (norm_pos_iff.mpr hzw_ne)
      have hz_sq : z.re ^ 2 + z.im ^ 2 = 1 := by
        have := Complex.normSq_eq_norm_sq z
        rw [Complex.normSq_apply, hz] at this
        linarith
      have hw_sq : ‖w‖ ^ 2 = w.re ^ 2 + w.im ^ 2 := by
        have := (Complex.normSq_eq_norm_sq w).symm
        rw [Complex.normSq_apply] at this
        linarith
      have hzw_sq : ‖z - w‖ ^ 2 = (z.re - w.re) ^ 2 + (z.im - w.im) ^ 2 := by
        have := (Complex.normSq_eq_norm_sq (z - w)).symm
        rw [Complex.normSq_apply] at this
        simpa [pow_two] using this
      rw [Complex.div_re, Complex.normSq_eq_norm_sq]
      field_simp [hzw_sq_pos.ne']
      rw [hw_sq, hzw_sq]
      simp only [Complex.sub_re, Complex.sub_im]
      linarith [hz_sq]

    have h_jordan : ∀ u r : ℝ, u ∈ Set.Icc (-Real.pi) Real.pi → 1 / 2 ≤ r → r < 1 →
        2 * u ^ 2 / Real.pi ^ 2 ≤ ‖circleMap 0 1 u - (r : ℂ)‖ ^ 2 ∧
        |u| / Real.pi ≤ ‖circleMap 0 1 u - (r : ℂ)‖ := by
      intro u r hu hr_lo _
      have hpi_pos : 0 < Real.pi := Real.pi_pos
      have hu2_abs : |u / 2| = |u| / 2 := by
        rw [abs_div, abs_of_pos (by norm_num : (0 : ℝ) < 2)]
      have hu_abs : |u / 2| ≤ Real.pi / 2 := by
        rw [hu2_abs]
        have : |u| ≤ Real.pi := abs_le.mpr hu
        linarith
      have hsin : |u| / Real.pi ≤ |Real.sin (u / 2)| := by
        have h1 := Real.mul_abs_le_abs_sin hu_abs
        have h2 : 2 / Real.pi * |u / 2| = |u| / Real.pi := by
          rw [hu2_abs]
          field_simp [hpi_pos.ne']
        rwa [h2] at h1
      have hsin_sq : u ^ 2 / Real.pi ^ 2 ≤ Real.sin (u / 2) ^ 2 := by
        have hsq := pow_le_pow_left₀ (by positivity) hsin 2
        simpa [div_pow, sq_abs] using hsq
      have hcos_id : 1 - Real.cos u = 2 * Real.sin (u / 2) ^ 2 := by
        have hc := Real.cos_two_mul' (u / 2)
        have hs := Real.sin_sq_add_cos_sq (u / 2)
        have h2u : 2 * (u / 2) = u := by ring
        rw [h2u] at hc
        linarith
      have hnorm_sq : ‖circleMap 0 1 u - (r : ℂ)‖ ^ 2 =
          (1 - r) ^ 2 + 4 * r * Real.sin (u / 2) ^ 2 := by
        have h1 := (Complex.normSq_eq_norm_sq (circleMap 0 1 u - (r : ℂ))).symm
        rw [Complex.normSq_apply] at h1
        have hre : (circleMap 0 1 u - (r : ℂ)).re = Real.cos u - r := by
          simp [circleMap_zero]
        have him : (circleMap 0 1 u - (r : ℂ)).im = Real.sin u := by
          simp [circleMap_zero]
        rw [hre, him] at h1
        have hs := Real.sin_sq_add_cos_sq u
        nlinarith [h1, hs, hcos_id]
      have h_bound_sq : 2 * u ^ 2 / Real.pi ^ 2 ≤ ‖circleMap 0 1 u - (r : ℂ)‖ ^ 2 := by
        rw [hnorm_sq]
        have h_nonneg : 0 ≤ Real.sin (u / 2) ^ 2 := sq_nonneg _
        have h_nonneg2 : 0 ≤ (1 - r) ^ 2 := sq_nonneg _
        have h4r : 2 * (u ^ 2 / Real.pi ^ 2) ≤ 4 * r * Real.sin (u / 2) ^ 2 := by
          calc 2 * (u ^ 2 / Real.pi ^ 2) ≤ 2 * Real.sin (u / 2) ^ 2 := by linarith
            _ ≤ 4 * r * Real.sin (u / 2) ^ 2 := by nlinarith
        linarith [show 2 * u ^ 2 / Real.pi ^ 2 = 2 * (u ^ 2 / Real.pi ^ 2) by ring]
      refine ⟨h_bound_sq, ?_⟩
      have h_weak_sq : (|u| / Real.pi) ^ 2 ≤ ‖circleMap 0 1 u - (r : ℂ)‖ ^ 2 := by
        have : (|u| / Real.pi) ^ 2 = u ^ 2 / Real.pi ^ 2 := by rw [div_pow, sq_abs]
        rw [this]
        have : 0 ≤ u ^ 2 / Real.pi ^ 2 := by positivity
        linarith [show 2 * u ^ 2 / Real.pi ^ 2 = 2 * (u ^ 2 / Real.pi ^ 2) by ring]
      nlinarith [norm_nonneg (circleMap 0 1 u - (r : ℂ)),
        show (0 : ℝ) ≤ |u| / Real.pi by positivity]

    intro M_dip η_plus γ₀ hM_pos hη_pos hγ₀_pos hγ₀_lt
    let δ_v : ℝ := min (1 / 16) (η_plus / (8 * (M_dip + η_plus)))
    have hδv_pos : 0 < δ_v := lt_min (by norm_num) (by positivity)
    have hδv_le16 : δ_v ≤ 1 / 16 := min_le_left _ _
    have hδv_le_η : δ_v ≤ η_plus / (8 * (M_dip + η_plus)) := min_le_right _ _
    let γ_steep : ℝ := min (γ₀ / 2) (δ_v / 4)
    have hγs_pos : 0 < γ_steep := lt_min (by positivity) (by positivity)
    have hγs_lt : γ_steep < γ₀ := lt_of_le_of_lt (min_le_left _ _) (by linarith)
    have hγs_le_δv : γ_steep ≤ δ_v / 4 := min_le_right _ _
    let L_χ : ℝ := (M_dip + η_plus) / δ_v
    have hLχ_pos : 0 < L_χ := by positivity
    let C_bump : ℝ := 2 * Real.pi * L_χ
    let C_err : ℝ := 4 * Real.pi ^ 2 * (M_dip + η_plus) / δ_v ^ 2
    refine ⟨C_bump, C_err, γ_steep, by positivity, by positivity, hγs_pos, hγs_lt, ?_⟩

    intro c r hc_lt hr_lo hr_lt
    have hr_pos : 0 < r := by linarith
    let y₀ : ℝ := -c.im
    have hy₀_abs : |y₀| < 1 / 3 := by
      dsimp [y₀]
      rw [abs_neg]
      exact lt_of_le_of_lt (Complex.abs_im_le_norm c) hc_lt

    let ψ : ℝ → ℝ := fun s => max 0 (min 1 (2 - |s - y₀| / δ_v))
    let τ_c : ℝ → ℝ := fun φ => ψ (Real.sin φ)
    have hψ_cont : Continuous ψ := by dsimp [ψ]; fun_prop
    have hτ_cont : Continuous τ_c := hψ_cont.comp Real.continuous_sin
    have hψ_nonneg : ∀ s : ℝ, 0 ≤ ψ s := fun _ => le_max_left _ _
    have hψ_le_one : ∀ s : ℝ, ψ s ≤ 1 := fun _ => max_le zero_le_one (min_le_left _ _)
    have hτ_nonneg : ∀ φ : ℝ, 0 ≤ τ_c φ := fun φ => hψ_nonneg (Real.sin φ)
    have hτ_le_one : ∀ φ : ℝ, τ_c φ ≤ 1 := fun φ => hψ_le_one (Real.sin φ)
    have hτ_per : Function.Periodic τ_c (2 * Real.pi) := fun φ => by
      dsimp [τ_c]
      rw [Real.sin_add_two_pi]
    have hτ_lip : ∀ φ₁ φ₂ : ℝ, |τ_c φ₁ - τ_c φ₂| ≤ |φ₁ - φ₂| / δ_v := by
      intro φ₁ φ₂
      calc |τ_c φ₁ - τ_c φ₂|
          ≤ |(2 - |Real.sin φ₁ - y₀| / δ_v) - (2 - |Real.sin φ₂ - y₀| / δ_v)| :=
            h_clamp_lip _ _
        _ = |(|Real.sin φ₂ - y₀| - |Real.sin φ₁ - y₀|)| / δ_v := by
            have : (2 - |Real.sin φ₁ - y₀| / δ_v) - (2 - |Real.sin φ₂ - y₀| / δ_v) =
                (|Real.sin φ₂ - y₀| - |Real.sin φ₁ - y₀|) / δ_v := by ring
            rw [this, abs_div, abs_of_pos hδv_pos]
        _ ≤ |Real.sin φ₁ - Real.sin φ₂| / δ_v := by
            refine div_le_div_of_nonneg_right ?_ hδv_pos.le
            exact abs_abs_sub_abs_le_abs_sub (Real.sin φ₂ - y₀) (Real.sin φ₁ - y₀) |>.trans_eq
              (by rw [← abs_neg]; ring_nf)
        _ ≤ |φ₁ - φ₂| / δ_v :=
            div_le_div_of_nonneg_right (Real.abs_sin_sub_sin_le φ₁ φ₂) hδv_pos.le

    have hψ_supp_zero : ∀ s : ℝ, 2 * δ_v ≤ |s - y₀| → ψ s = 0 := by
      intro s hs
      have hdiv : 2 ≤ |s - y₀| / δ_v := (le_div_iff₀ hδv_pos).mpr hs
      have hmin : min 1 (2 - |s - y₀| / δ_v) ≤ 0 :=
        le_trans (min_le_right _ _) (by linarith)
      exact max_eq_left hmin

    have hτ_le_cos : ∀ φ : ℝ, τ_c φ ≤ 2 * |Real.cos φ| * ψ (Real.sin φ) := by
      intro φ
      by_cases h_out : 2 * δ_v ≤ |Real.sin φ - y₀|
      · simp [τ_c, hψ_supp_zero (Real.sin φ) h_out]
      · push Not at h_out
        have hsin_lt : |Real.sin φ| < 1 / 2 := by
          have : |Real.sin φ| ≤ |Real.sin φ - y₀| + |y₀| := by
            have := abs_add_le (Real.sin φ - y₀) y₀
            simpa using this
          linarith
        have hsin_sq : Real.sin φ ^ 2 < 1 / 4 := by
          have h1 : |Real.sin φ| ^ 2 < (1 / 2 : ℝ) ^ 2 :=
            pow_lt_pow_left₀ hsin_lt (abs_nonneg _) (by norm_num)
          rw [sq_abs] at h1
          norm_num at h1
          exact h1
        have hcos_sq : 3 / 4 < Real.cos φ ^ 2 := by
          linarith [Real.sin_sq_add_cos_sq φ]
        have hcos_gt : 1 / 2 < |Real.cos φ| := by
          by_contra hle
          push Not at hle
          have : |Real.cos φ| ^ 2 ≤ (1 / 2 : ℝ) ^ 2 :=
            pow_le_pow_left₀ (abs_nonneg _) hle 2
          rw [sq_abs] at this
          linarith
        nlinarith [hψ_nonneg (Real.sin φ)]

    have h_int_ψ_bound : (∫ s in (-1 : ℝ)..1, ψ s) ≤ 4 * δ_v := by
      let a₁ : ℝ := y₀ - 2 * δ_v
      let a₂ : ℝ := y₀ + 2 * δ_v
      have hy₀_bd : -(1 / 3) < y₀ ∧ y₀ < 1 / 3 := abs_lt.mp hy₀_abs
      have ha₁_lo : -1 ≤ a₁ := by dsimp [a₁]; linarith
      have ha₁_a₂ : a₁ ≤ a₂ := by dsimp [a₁, a₂]; linarith
      have ha₂_hi : a₂ ≤ 1 := by dsimp [a₂]; linarith
      have h_split1 := intervalIntegral.integral_add_adjacent_intervals (μ := MeasureTheory.volume)
        (f := ψ) (a := -1) (b := a₁) (c := 1)
        (hψ_cont.intervalIntegrable _ _) (hψ_cont.intervalIntegrable _ _)
      have h_split2 := intervalIntegral.integral_add_adjacent_intervals (μ := MeasureTheory.volume)
        (f := ψ) (a := a₁) (b := a₂) (c := 1)
        (hψ_cont.intervalIntegrable _ _) (hψ_cont.intervalIntegrable _ _)
      have h_z1 : (∫ s in (-1 : ℝ)..a₁, ψ s) ≤ 0 := by
        have := intervalIntegral.integral_mono_on (μ := MeasureTheory.volume) ha₁_lo
          (hψ_cont.intervalIntegrable _ _)
          (intervalIntegrable_const (c := (0 : ℝ))) (fun s hs => by
            have hs_le : s ≤ y₀ - 2 * δ_v := hs.2
            have : 2 * δ_v ≤ |s - y₀| := by rw [abs_of_nonpos (by linarith)]; linarith
            simp [hψ_supp_zero s this])
        simpa using this
      have h_z2 : (∫ s in a₂..1, ψ s) ≤ 0 := by
        have := intervalIntegral.integral_mono_on (μ := MeasureTheory.volume) ha₂_hi
          (hψ_cont.intervalIntegrable _ _)
          (intervalIntegrable_const (c := (0 : ℝ))) (fun s hs => by
            have hs_ge : y₀ + 2 * δ_v ≤ s := hs.1
            have : 2 * δ_v ≤ |s - y₀| := by rw [abs_of_nonneg (by linarith)]; linarith
            simp [hψ_supp_zero s this])
        simpa using this
      have h_mid : (∫ s in a₁..a₂, ψ s) ≤ 4 * δ_v := by
        have := intervalIntegral.integral_mono_on (μ := MeasureTheory.volume) ha₁_a₂
          (hψ_cont.intervalIntegrable _ _)
          (intervalIntegrable_const (c := (1 : ℝ))) (fun s _ => hψ_le_one s)
        have hconst : (∫ _ in a₁..a₂, (1 : ℝ)) = 4 * δ_v := by
          simp [a₁, a₂]
          ring
        linarith
      linarith

    have h_int_τ_bound : (∫ φ in (0 : ℝ)..(2 * Real.pi), τ_c φ) ≤ 16 * δ_v := by
      let g_abs : ℝ → ℝ := fun φ => |Real.cos φ| * ψ (Real.sin φ)
      have hg_cont : Continuous g_abs := (continuous_abs.comp Real.continuous_cos).mul hτ_cont
      have h_mono := intervalIntegral.integral_mono_on (μ := MeasureTheory.volume)
        (by positivity : (0 : ℝ) ≤ 2 * Real.pi)
        (hτ_cont.intervalIntegrable _ _)
        ((show Continuous (fun φ => 2 * g_abs φ) from hg_cont.const_mul 2).intervalIntegrable _ _)
        (fun φ _ => by simpa [g_abs, mul_assoc] using hτ_le_cos φ)
      rw [intervalIntegral.integral_const_mul] at h_mono
      have h_s1 := intervalIntegral.integral_add_adjacent_intervals (μ := MeasureTheory.volume)
        (f := g_abs) (a := 0) (b := Real.pi / 2) (c := 2 * Real.pi)
        (hg_cont.intervalIntegrable _ _) (hg_cont.intervalIntegrable _ _)
      have h_s2 := intervalIntegral.integral_add_adjacent_intervals (μ := MeasureTheory.volume)
        (f := g_abs) (a := Real.pi / 2) (b := 3 * Real.pi / 2) (c := 2 * Real.pi)
        (hg_cont.intervalIntegrable _ _) (hg_cont.intervalIntegrable _ _)
      have h_sub_pos : ∀ a b : ℝ,
          (∫ φ in a..b, ψ (Real.sin φ) * Real.cos φ) = ∫ s in Real.sin a..Real.sin b, ψ s := by
        intro a b
        exact intervalIntegral.integral_comp_mul_deriv
          (fun x _ => Real.hasDerivAt_sin x) Real.continuous_cos.continuousOn hψ_cont
      have h_i1 : (∫ φ in (0 : ℝ)..(Real.pi / 2), g_abs φ) = ∫ s in (0 : ℝ)..1, ψ s := by
        have h_congr : Set.EqOn g_abs (fun φ => ψ (Real.sin φ) * Real.cos φ)
            (Set.uIcc 0 (Real.pi / 2)) := by
          intro φ hφ
          rw [Set.uIcc_of_le (by positivity)] at hφ
          have hcos : 0 ≤ Real.cos φ :=
            Real.cos_nonneg_of_mem_Icc ⟨by linarith [Real.pi_pos, hφ.1], hφ.2⟩
          dsimp [g_abs]
          rw [abs_of_nonneg hcos, mul_comm]
        rw [intervalIntegral.integral_congr h_congr, h_sub_pos, Real.sin_zero, Real.sin_pi_div_two]
      have h_i2 : (∫ φ in (Real.pi / 2)..(3 * Real.pi / 2), g_abs φ) =
          ∫ s in (-1 : ℝ)..1, ψ s := by
        have h_congr : Set.EqOn g_abs (fun φ => -(ψ (Real.sin φ) * Real.cos φ))
            (Set.uIcc (Real.pi / 2) (3 * Real.pi / 2)) := by
          intro φ hφ
          rw [Set.uIcc_of_le (by linarith [Real.pi_pos])] at hφ
          have hcos_shift : 0 ≤ Real.cos (φ - Real.pi) :=
            Real.cos_nonneg_of_mem_Icc ⟨by linarith [hφ.1], by linarith [hφ.2]⟩
          have hcos : Real.cos φ ≤ 0 := by
            linarith [Real.cos_sub_pi φ]
          dsimp [g_abs]
          rw [abs_of_nonpos hcos]
          ring
        have hsin3 : Real.sin (3 * Real.pi / 2) = -1 := by
          have : 3 * Real.pi / 2 = Real.pi / 2 + Real.pi := by ring
          rw [this, Real.sin_add_pi, Real.sin_pi_div_two]
        rw [intervalIntegral.integral_congr h_congr, intervalIntegral.integral_neg,
          h_sub_pos, Real.sin_pi_div_two, hsin3, intervalIntegral.integral_symm, neg_neg]
      have h_i3 : (∫ φ in (3 * Real.pi / 2)..(2 * Real.pi), g_abs φ) =
          ∫ s in (-1 : ℝ)..0, ψ s := by
        have h_congr : Set.EqOn g_abs (fun φ => ψ (Real.sin φ) * Real.cos φ)
            (Set.uIcc (3 * Real.pi / 2) (2 * Real.pi)) := by
          intro φ hφ
          rw [Set.uIcc_of_le (by linarith [Real.pi_pos])] at hφ
          have hcos_shift : 0 ≤ Real.cos (φ - 2 * Real.pi) :=
            Real.cos_nonneg_of_mem_Icc ⟨by linarith [Real.pi_pos, hφ.1],
              by linarith [Real.pi_pos, hφ.2]⟩
          have hcos : 0 ≤ Real.cos φ := by
            have : Real.cos φ = Real.cos (φ - 2 * Real.pi) := by
              have h2 : φ = (φ - 2 * Real.pi) + 2 * Real.pi := by ring
              conv_lhs => rw [h2, Real.cos_add_two_pi]
            linarith
          dsimp [g_abs]
          rw [abs_of_nonneg hcos, mul_comm]
        have hsin3 : Real.sin (3 * Real.pi / 2) = -1 := by
          have : 3 * Real.pi / 2 = Real.pi / 2 + Real.pi := by ring
          rw [this, Real.sin_add_pi, Real.sin_pi_div_two]
        rw [intervalIntegral.integral_congr h_congr, h_sub_pos, hsin3, Real.sin_two_pi]
      have h_comb_s := intervalIntegral.integral_add_adjacent_intervals (μ := MeasureTheory.volume)
        (f := ψ) (a := -1) (b := 0) (c := 1)
        (hψ_cont.intervalIntegrable _ _) (hψ_cont.intervalIntegrable _ _)
      linarith

    let μ_c : ℝ := (2 * Real.pi)⁻¹ * ∫ φ in (0 : ℝ)..(2 * Real.pi), τ_c φ
    have hμ_nonneg : 0 ≤ μ_c := by
      dsimp [μ_c]
      refine mul_nonneg (by positivity) ?_
      exact intervalIntegral.integral_nonneg (by positivity) (fun φ _ => hτ_nonneg φ)
    have hμ_lt_3δ : μ_c < 3 * δ_v := by
      have hpi3 : 3 < Real.pi := Real.pi_gt_three
      have h1 : 2 * Real.pi * μ_c ≤ 16 * δ_v := by
        dsimp [μ_c]
        have h2pi_ne : (2 * Real.pi : ℝ) ≠ 0 := by positivity
        calc 2 * Real.pi * ((2 * Real.pi)⁻¹ * ∫ φ in (0 : ℝ)..(2 * Real.pi), τ_c φ)
            = ∫ φ in (0 : ℝ)..(2 * Real.pi), τ_c φ := by field_simp [h2pi_ne]
          _ ≤ 16 * δ_v := h_int_τ_bound
      nlinarith
    have hμ_lt_ratio : μ_c < η_plus / (M_dip + η_plus) := by
      have : 3 * δ_v < η_plus / (M_dip + η_plus) := by
        have hsum_ne : M_dip + η_plus ≠ 0 := by positivity
        have := hδv_le_η
        have h8 : η_plus / (8 * (M_dip + η_plus)) = (1 / 8) * (η_plus / (M_dip + η_plus)) := by
          field_simp [hsum_ne]
        rw [h8] at this
        have hrat_pos : 0 < η_plus / (M_dip + η_plus) := by positivity
        linarith
      linarith
    have h1_sub_μ_gt : M_dip / (M_dip + η_plus) < 1 - μ_c := by
      have h_id : 1 - η_plus / (M_dip + η_plus) = M_dip / (M_dip + η_plus) := by
        have hne : M_dip + η_plus ≠ 0 := by positivity
        field_simp [hne]
        ring
      linarith
    have h1_sub_μ_pos : 0 < 1 - μ_c := lt_trans (by positivity) h1_sub_μ_gt

    let A_bump : ℝ := M_dip / (1 - μ_c)
    let c_top : ℝ := A_bump * μ_c
    let χ : ℝ → ℝ := fun φ => c_top - A_bump * τ_c φ
    have hA_pos : 0 < A_bump := div_pos hM_pos h1_sub_μ_pos
    have hA_lt : A_bump < M_dip + η_plus := by
      dsimp [A_bump]
      rw [div_lt_iff₀ h1_sub_μ_pos]
      have hsum_pos : 0 < M_dip + η_plus := by positivity
      have := (div_lt_iff₀ hsum_pos).mp h1_sub_μ_gt
      linarith
    have hctop_lt_η : c_top < η_plus := by
      dsimp [c_top, A_bump]
      have : M_dip * μ_c / (1 - μ_c) < η_plus ↔ M_dip * μ_c < η_plus * (1 - μ_c) :=
        div_lt_iff₀ h1_sub_μ_pos
      rw [div_mul_eq_mul_div, this]
      have hsum_pos : 0 < M_dip + η_plus := by positivity
      have hmul := (lt_div_iff₀ hsum_pos).mp hμ_lt_ratio
      linarith
    have hχ_cont : Continuous χ := continuous_const.sub (continuous_const.mul hτ_cont)
    have hχ_per : Function.Periodic χ (2 * Real.pi) := fun φ => by
      dsimp [χ]
      rw [hτ_per φ]
    have hχ_lo : ∀ φ : ℝ, -M_dip ≤ χ φ := by
      intro φ
      have hle : A_bump * τ_c φ ≤ A_bump := by nlinarith [hτ_le_one φ]
      have hbot : c_top - A_bump = -M_dip := by
        dsimp [c_top, A_bump]
        field_simp [h1_sub_μ_pos.ne']
        ring
      dsimp [χ]
      linarith
    have hχ_hi : ∀ φ : ℝ, χ φ ≤ η_plus := by
      intro φ
      have hge : 0 ≤ A_bump * τ_c φ := mul_nonneg hA_pos.le (hτ_nonneg φ)
      dsimp [χ]
      linarith
    have hχ_abs : ∀ φ : ℝ, |χ φ| ≤ max M_dip η_plus := by
      intro φ
      rw [abs_le]
      refine ⟨?_, le_trans (hχ_hi φ) (le_max_right _ _)⟩
      have := le_max_left M_dip η_plus
      linarith [hχ_lo φ]
    have hχ_mean : (∫ φ in (0 : ℝ)..(2 * Real.pi), χ φ) = 0 := by
      dsimp [χ]
      rw [intervalIntegral.integral_sub intervalIntegrable_const
          ((hτ_cont.const_mul A_bump).intervalIntegrable _ _),
        intervalIntegral.integral_const, intervalIntegral.integral_const_mul]
      dsimp [c_top, μ_c]
      have h2pi_ne : (2 * Real.pi : ℝ) ≠ 0 := by positivity
      simp only [sub_zero]
      field_simp [h2pi_ne]
      ring
    have hχ_lip : ∀ φ₁ φ₂ : ℝ, |χ φ₁ - χ φ₂| ≤ L_χ * |φ₁ - φ₂| := by
      intro φ₁ φ₂
      have hsub : χ φ₁ - χ φ₂ = -A_bump * (τ_c φ₁ - τ_c φ₂) := by dsimp [χ]; ring
      rw [hsub, abs_mul, abs_neg, abs_of_pos hA_pos]
      calc A_bump * |τ_c φ₁ - τ_c φ₂|
          ≤ A_bump * (|φ₁ - φ₂| / δ_v) := mul_le_mul_of_nonneg_left (hτ_lip φ₁ φ₂) hA_pos.le
        _ = (A_bump / δ_v) * |φ₁ - φ₂| := by ring
        _ ≤ L_χ * |φ₁ - φ₂| := by
            refine mul_le_mul_of_nonneg_right ?_ (abs_nonneg _)
            exact div_le_div_of_nonneg_right hA_lt.le hδv_pos.le

    let F_ker : ℂ → ℝ → ℂ := fun ζ φ =>
      (χ φ : ℂ) * ((r : ℂ) * ζ / (circleMap 0 1 φ - (r : ℂ) * ζ))
    let g : ℂ → ℂ := fun ζ =>
      (Complex.I / (Real.pi : ℂ)) * ∫ φ in (0 : ℝ)..(2 * Real.pi), F_ker ζ φ

    have hg_zero : g 0 = 0 := by
      simp [g, F_ker]

    have hg_holo : DifferentiableOn ℂ g (Metric.ball (0 : ℂ) (1 / r)) := by
      intro ζ₀ hζ₀
      have hζ₀_lt : ‖ζ₀‖ < 1 / r := by simpa using hζ₀
      have hrζ₀_lt : r * ‖ζ₀‖ < 1 := by linarith [(lt_div_iff₀ hr_pos).mp hζ₀_lt]
      let Δ : ℝ := 1 - r * ‖ζ₀‖
      have hΔ_pos : 0 < Δ := by dsimp [Δ]; linarith
      let ρ : ℝ := Δ / (2 * r)
      have hρ_pos : 0 < ρ := by positivity
      let F_der : ℂ → ℝ → ℂ := fun ζ φ =>
        (χ φ : ℂ) * ((r : ℂ) * circleMap 0 1 φ / (circleMap 0 1 φ - (r : ℂ) * ζ) ^ 2)
      let B_const : ℝ := max M_dip η_plus * r / (Δ / 2) ^ 2
      have h_den_ball : ∀ ζ ∈ Metric.ball ζ₀ ρ, ∀ φ : ℝ,
          Δ / 2 ≤ ‖circleMap 0 1 φ - (r : ℂ) * ζ‖ := by
        intro ζ hζ φ
        have hζ_dist : ‖ζ - ζ₀‖ < ρ := by simpa [dist_eq_norm] using hζ
        have hζ_norm : ‖ζ‖ < ‖ζ₀‖ + ρ := by
          have := norm_sub_norm_le ζ ζ₀
          linarith
        have hrζ_lt : ‖(r : ℂ) * ζ‖ < 1 - Δ / 2 := by
          rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg hr_pos.le]
          have : r * (‖ζ₀‖ + ρ) = 1 - Δ / 2 := by
            dsimp [ρ, Δ]
            field_simp [hr_pos.ne']
            ring
          nlinarith
        have h1 : 1 - ‖(r : ℂ) * ζ‖ ≤ ‖circleMap 0 1 φ - (r : ℂ) * ζ‖ := by
          have := norm_sub_norm_le (circleMap 0 1 φ) ((r : ℂ) * ζ)
          simpa [norm_circleMap_zero] using this
        linarith
      have hF_cont : ∀ ζ ∈ Metric.ball ζ₀ ρ, Continuous (F_ker ζ) := by
        intro ζ hζ
        refine (Complex.continuous_ofReal.comp hχ_cont).mul ?_
        refine continuous_const.div ?_ ?_
        · exact (continuous_circleMap 0 1).sub continuous_const
        · intro φ
          exact norm_pos_iff.mp (lt_of_lt_of_le (by positivity) (h_den_ball ζ hζ φ))
      have hF'_cont : Continuous (F_der ζ₀) := by
        refine (Complex.continuous_ofReal.comp hχ_cont).mul ?_
        refine (continuous_const.mul (continuous_circleMap 0 1)).div ?_ ?_
        · exact ((continuous_circleMap 0 1).sub continuous_const).pow 2
        · intro φ
          refine pow_ne_zero 2 (norm_pos_iff.mp ?_)
          exact lt_of_lt_of_le (by positivity)
            (h_den_ball ζ₀ (Metric.mem_ball_self hρ_pos) φ)
      have h_deriv_int := (intervalIntegral.hasDerivAt_integral_of_dominated_loc_of_deriv_le
        (𝕜 := ℂ) (μ := MeasureTheory.volume) (a := 0) (b := 2 * Real.pi) (bound := fun _ => B_const)
        (F := F_ker) (F' := F_der) (x₀ := ζ₀) (s := Metric.ball ζ₀ ρ)
        (Metric.ball_mem_nhds ζ₀ hρ_pos)
        (Filter.eventually_of_mem (Metric.ball_mem_nhds ζ₀ hρ_pos)
          (fun ζ hζ => (hF_cont ζ hζ).aestronglyMeasurable))
        ((hF_cont ζ₀ (Metric.mem_ball_self hρ_pos)).intervalIntegrable _ _)
        hF'_cont.aestronglyMeasurable
        (Filter.Eventually.of_forall fun φ _ ζ hζ => by
          have hden := h_den_ball ζ hζ φ
          have hden_sq : (Δ / 2) ^ 2 ≤ ‖circleMap 0 1 φ - (r : ℂ) * ζ‖ ^ 2 :=
            pow_le_pow_left₀ (by positivity) hden 2
          dsimp [F_der, B_const]
          rw [norm_mul, norm_div, norm_mul, norm_pow, Complex.norm_real, Real.norm_eq_abs,
            Complex.norm_real, Real.norm_of_nonneg hr_pos.le, norm_circleMap_zero, abs_one, mul_one,
            ← mul_div_assoc]
          have hχ_b := hχ_abs φ
          have hnum : |χ φ| * r ≤ max M_dip η_plus * r :=
            mul_le_mul_of_nonneg_right hχ_b hr_pos.le
          exact div_le_div₀ (by positivity) hnum (by positivity) hden_sq)
        intervalIntegrable_const
        (Filter.Eventually.of_forall fun φ _ ζ hζ => by
          set z : ℂ := circleMap 0 1 φ
          have hden_ne : z - (r : ℂ) * ζ ≠ 0 :=
            norm_pos_iff.mp (lt_of_lt_of_le (by positivity) (h_den_ball ζ hζ φ))
          exact ((((hasDerivAt_id ζ).const_mul (r : ℂ)).div
            ((hasDerivAt_const ζ z).sub ((hasDerivAt_id ζ).const_mul (r : ℂ)))
            hden_ne).const_mul (χ φ : ℂ)).congr_deriv (by dsimp [F_der, z]; ring))).2
      exact (h_deriv_int.const_mul (Complex.I / (Real.pi : ℂ))).differentiableAt.differentiableWithinAt

    have h_poisson_rep : ∀ ζ ∈ Metric.closedBall (0 : ℂ) 1,
        let w : ℂ := (r : ℂ) * ζ
        let K_w : ℝ → ℝ := fun φ => (1 - ‖w‖ ^ 2) / ‖circleMap 0 1 φ - w‖ ^ 2
        Continuous K_w ∧
        (∀ φ : ℝ, 0 ≤ K_w φ) ∧
        (2 * Real.pi)⁻¹ * (∫ φ in (0 : ℝ)..(2 * Real.pi), K_w φ) = 1 ∧
        (g ζ).im = (2 * Real.pi)⁻¹ * ∫ φ in (0 : ℝ)..(2 * Real.pi), χ φ * K_w φ := by
      intro ζ hζ
      dsimp only
      set w : ℂ := (r : ℂ) * ζ
      set K_w : ℝ → ℝ := fun φ => (1 - ‖w‖ ^ 2) / ‖circleMap 0 1 φ - w‖ ^ 2
      have hζ_le : ‖ζ‖ ≤ 1 := by simpa using hζ
      have hw_lt : ‖w‖ < 1 := by
        dsimp [w]
        rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg hr_pos.le]
        calc r * ‖ζ‖ ≤ r * 1 := mul_le_mul_of_nonneg_left hζ_le hr_pos.le
          _ = r := mul_one r
          _ < 1 := hr_lt
      have hw_den_pos : ∀ φ : ℝ, 0 < ‖circleMap 0 1 φ - w‖ := by
        intro φ
        have h1 := norm_sub_norm_le (circleMap 0 1 φ) w
        rw [norm_circleMap_zero, abs_one] at h1
        linarith
      have hK_cont : Continuous K_w := by
        refine continuous_const.div ?_ ?_
        · exact (continuous_norm.comp ((continuous_circleMap 0 1).sub continuous_const)).pow 2
        · intro φ
          exact pow_ne_zero 2 (hw_den_pos φ).ne'
      have hK_nonneg : ∀ φ : ℝ, 0 ≤ K_w φ := by
        intro φ
        dsimp [K_w]
        have : ‖w‖ ^ 2 ≤ 1 := by nlinarith [norm_nonneg w]
        exact div_nonneg (by linarith) (sq_nonneg _)
      have h_ker_cont : Continuous (fun φ : ℝ => w / (circleMap 0 1 φ - w)) :=
        continuous_const.div ((continuous_circleMap 0 1).sub continuous_const)
          (fun φ => norm_pos_iff.mp (hw_den_pos φ))
      have h_re_zero : (∫ φ in (0 : ℝ)..(2 * Real.pi),
          (w / (circleMap 0 1 φ - w)).re) = 0 := by
        have h1 := ContinuousLinearMap.intervalIntegral_comp_comm
          Complex.reCLM (h_ker_cont.intervalIntegrable (μ := MeasureTheory.volume) 0 (2 * Real.pi))
        change (∫ φ in (0 : ℝ)..(2 * Real.pi), (w / (circleMap 0 1 φ - w)).re) =
          (∫ φ in (0 : ℝ)..(2 * Real.pi), w / (circleMap 0 1 φ - w)).re at h1
        rw [h1, h_mean_kernel w hw_lt, Complex.zero_re]
      have h_re_eq : ∀ φ : ℝ,
          (w / (circleMap 0 1 φ - w)).re = (K_w φ - 1) / 2 := by
        intro φ
        exact h_poisson_re (circleMap 0 1 φ) w (by simp [norm_circleMap_zero]) hw_lt
      have hK_avg : (2 * Real.pi)⁻¹ * (∫ φ in (0 : ℝ)..(2 * Real.pi), K_w φ) = 1 := by
        have hsub : (∫ φ in (0 : ℝ)..(2 * Real.pi), (K_w φ - 1) / 2) = 0 := by
          simpa [h_re_eq] using h_re_zero
        have hlin : (∫ φ in (0 : ℝ)..(2 * Real.pi), (K_w φ - 1) / 2) =
            ((∫ φ in (0 : ℝ)..(2 * Real.pi), K_w φ) - 2 * Real.pi) / 2 := by
          have h_eq_fn : (fun φ : ℝ => (K_w φ - 1) / 2) = fun φ => (1 / 2 : ℝ) * (K_w φ - 1) := by
            ext φ; ring
          rw [h_eq_fn, intervalIntegral.integral_const_mul,
            intervalIntegral.integral_sub (hK_cont.intervalIntegrable _ _) intervalIntegrable_const,
            intervalIntegral.integral_const]
          simp only [sub_zero, smul_eq_mul, mul_one]
          ring
        have hint_eq : (∫ φ in (0 : ℝ)..(2 * Real.pi), K_w φ) = 2 * Real.pi := by linarith
        rw [hint_eq]
        have h2pi_ne : (2 * Real.pi : ℝ) ≠ 0 := by positivity
        field_simp [h2pi_ne]
      refine ⟨hK_cont, hK_nonneg, hK_avg, ?_⟩
      have hF_cont_ζ : Continuous (F_ker ζ) :=
        (Complex.continuous_ofReal.comp hχ_cont).mul h_ker_cont
      have h_im_mul : ∀ Z : ℂ, ((Complex.I / (Real.pi : ℂ)) * Z).im = Z.re / Real.pi := by
        intro Z
        simp [div_eq_mul_inv, mul_comm]
      have h_re_comm := ContinuousLinearMap.intervalIntegral_comp_comm
        Complex.reCLM (hF_cont_ζ.intervalIntegrable (μ := MeasureTheory.volume) 0 (2 * Real.pi))
      change (∫ φ in (0 : ℝ)..(2 * Real.pi), (F_ker ζ φ).re) =
        (∫ φ in (0 : ℝ)..(2 * Real.pi), F_ker ζ φ).re at h_re_comm
      have hF_re : ∀ φ : ℝ, (F_ker ζ φ).re = (1 / 2 : ℝ) * (χ φ * K_w φ - χ φ) := by
        intro φ
        have h1 : (F_ker ζ φ).re = χ φ * (w / (circleMap 0 1 φ - w)).re := by
          dsimp [F_ker]
          change ((χ φ : ℂ) * (w / (circleMap 0 1 φ - w))).re = _
          simp
        rw [h1, h_re_eq φ]
        ring
      dsimp [g]
      rw [h_im_mul, ← h_re_comm]
      simp_rw [hF_re]
      have hχK_cont' : Continuous (fun φ : ℝ => χ φ * K_w φ) := hχ_cont.mul hK_cont
      rw [intervalIntegral.integral_const_mul,
        intervalIntegral.integral_sub (hχK_cont'.intervalIntegrable _ _)
          (hχ_cont.intervalIntegrable _ _),
        hχ_mean, sub_zero]
      ring

    have hg_im_bounds : ∀ ζ ∈ Metric.closedBall (0 : ℂ) 1,
        -M_dip ≤ (g ζ).im ∧ (g ζ).im ≤ η_plus := by
      intro ζ hζ
      obtain ⟨hK_cont, hK_nonneg, hK_avg, hg_im⟩ := h_poisson_rep ζ hζ
      rw [hg_im]
      set K_w : ℝ → ℝ := fun φ =>
        (1 - ‖(r : ℂ) * ζ‖ ^ 2) / ‖circleMap 0 1 φ - (r : ℂ) * ζ‖ ^ 2
      have hχK_cont : Continuous (fun φ : ℝ => χ φ * K_w φ) := hχ_cont.mul hK_cont
      have h_lo_int := intervalIntegral.integral_mono_on (μ := MeasureTheory.volume)
        (by positivity : (0 : ℝ) ≤ 2 * Real.pi)
        ((show Continuous (fun φ => -M_dip * K_w φ) from hK_cont.const_mul (-M_dip)).intervalIntegrable _ _)
        (hχK_cont.intervalIntegrable _ _)
        (fun φ _ => mul_le_mul_of_nonneg_right (hχ_lo φ) (hK_nonneg φ))
      have h_hi_int := intervalIntegral.integral_mono_on (μ := MeasureTheory.volume)
        (by positivity : (0 : ℝ) ≤ 2 * Real.pi)
        (hχK_cont.intervalIntegrable _ _)
        ((show Continuous (fun φ => η_plus * K_w φ) from hK_cont.const_mul η_plus).intervalIntegrable _ _)
        (fun φ _ => mul_le_mul_of_nonneg_right (hχ_hi φ) (hK_nonneg φ))
      rw [intervalIntegral.integral_const_mul] at h_lo_int h_hi_int
      constructor
      · calc -M_dip = -M_dip * ((2 * Real.pi)⁻¹ * ∫ φ in (0 : ℝ)..(2 * Real.pi), K_w φ) := by
              rw [hK_avg, mul_one]
          _ = (2 * Real.pi)⁻¹ * (-M_dip * ∫ φ in (0 : ℝ)..(2 * Real.pi), K_w φ) := by ring
          _ ≤ (2 * Real.pi)⁻¹ * ∫ φ in (0 : ℝ)..(2 * Real.pi), χ φ * K_w φ :=
              mul_le_mul_of_nonneg_left h_lo_int (by positivity)
      · calc (2 * Real.pi)⁻¹ * (∫ φ in (0 : ℝ)..(2 * Real.pi), χ φ * K_w φ)
            ≤ (2 * Real.pi)⁻¹ * (η_plus * ∫ φ in (0 : ℝ)..(2 * Real.pi), K_w φ) :=
              mul_le_mul_of_nonneg_left h_hi_int (by positivity)
          _ = η_plus * ((2 * Real.pi)⁻¹ * ∫ φ in (0 : ℝ)..(2 * Real.pi), K_w φ) := by ring
          _ = η_plus := by rw [hK_avg, mul_one]

    have hg_sphere_norm : ∀ ζ ∈ Metric.sphere (0 : ℂ) 1, ‖g ζ‖ ≤ C_bump := by
      intro ζ hζ
      have h_img : ζ ∈ circleMap 0 1 '' Set.Ioc 0 (2 * Real.pi) := by
        rw [image_circleMap_Ioc]
        simpa using hζ
      obtain ⟨θ, _, rfl⟩ := h_img
      set ζ := circleMap 0 1 θ
      have hζ_norm : ‖ζ‖ = 1 := by simp [ζ, norm_circleMap_zero]
      have hζ_ne : ζ ≠ 0 := by intro h0; simp [h0] at hζ_norm
      have hrζ_lt : ‖(r : ℂ) * ζ‖ < 1 := by
        rw [norm_mul, hζ_norm, mul_one, Complex.norm_real, Real.norm_of_nonneg hr_pos.le]
        exact hr_lt
      have h_ker_cont : Continuous (fun φ : ℝ =>
          ((r : ℂ) * ζ) / (circleMap 0 1 φ - (r : ℂ) * ζ)) := by
        refine continuous_const.div ((continuous_circleMap 0 1).sub continuous_const) ?_
        intro φ
        have h1 := norm_sub_norm_le (circleMap 0 1 φ) ((r : ℂ) * ζ)
        rw [norm_circleMap_zero, abs_one] at h1
        exact norm_pos_iff.mp (by linarith)
      let G_diff : ℝ → ℂ := fun φ =>
        ((χ φ - χ θ : ℝ) : ℂ) * (((r : ℂ) * ζ) / (circleMap 0 1 φ - (r : ℂ) * ζ))
      have hG_per : Function.Periodic G_diff (2 * Real.pi) := by
        intro φ
        have hc_per : circleMap 0 1 (φ + 2 * Real.pi) = circleMap 0 1 φ := by
          rw [h_circle_add]
          simp [circleMap_zero, Complex.exp_two_pi_mul_I]
        simp only [G_diff, hχ_per φ, hc_per]
      have h_sub_mean : (∫ φ in (0 : ℝ)..(2 * Real.pi), F_ker ζ φ) =
          ∫ φ in (0 : ℝ)..(2 * Real.pi), G_diff φ := by
        have h_eq_fn : ∀ φ : ℝ, G_diff φ =
            F_ker ζ φ - (χ θ : ℂ) * (((r : ℂ) * ζ) / (circleMap 0 1 φ - (r : ℂ) * ζ)) := by
          intro φ
          dsimp [G_diff, F_ker]
          push_cast
          ring
        have hF_ζ_cont : Continuous (F_ker ζ) :=
          (Complex.continuous_ofReal.comp hχ_cont).mul h_ker_cont
        simp_rw [h_eq_fn]
        rw [intervalIntegral.integral_sub
            (hF_ζ_cont.intervalIntegrable _ _)
            ((h_ker_cont.const_mul _).intervalIntegrable _ _),
          intervalIntegral.integral_const_mul, h_mean_kernel ((r : ℂ) * ζ) hrζ_lt,
          mul_zero, sub_zero]
      have h_shifted := h_shift_ℂ G_diff θ hG_per
      have h_int_bound : ‖∫ u in (-Real.pi)..Real.pi, G_diff (θ + u)‖ ≤
          (Real.pi * L_χ) * |Real.pi - -Real.pi| := by
        refine intervalIntegral.norm_integral_le_of_norm_le_const ?_
        intro u hu
        rw [Set.uIoc_of_le (by linarith [Real.pi_pos])] at hu
        have hu_cc : u ∈ Set.Icc (-Real.pi) Real.pi := ⟨hu.1.le, hu.2⟩
        have h_jord := (h_jordan u r hu_cc hr_lo hr_lt).2
        have h_rot : ((r : ℂ) * ζ) / (circleMap 0 1 (θ + u) - (r : ℂ) * ζ) =
            (r : ℂ) / (circleMap 0 1 u - (r : ℂ)) := by
          have h_den : circleMap 0 1 (θ + u) - (r : ℂ) * ζ =
              ζ * (circleMap 0 1 u - (r : ℂ)) := by
            dsimp [ζ]
            rw [h_circle_add]
            ring
          rw [h_den, mul_comm (r : ℂ) ζ, mul_div_mul_left _ _ hζ_ne]
        dsimp [G_diff]
        rw [h_rot]
        by_cases hu0 : u = 0
        · subst hu0
          simp [mul_nonneg Real.pi_pos.le hLχ_pos.le]
        · have hu_pos : 0 < |u| := abs_pos.mpr hu0
          have h_j_pos : 0 < |u| / Real.pi := div_pos hu_pos Real.pi_pos
          rw [norm_mul, norm_div, Complex.norm_real, Real.norm_eq_abs, Complex.norm_real,
            Real.norm_of_nonneg hr_pos.le]
          have h_lip_u : |χ (θ + u) - χ θ| ≤ L_χ * |u| := by
            simpa using hχ_lip (θ + u) θ
          have h_num : |χ (θ + u) - χ θ| * r ≤ L_χ * |u| := by
            calc |χ (θ + u) - χ θ| * r ≤ (L_χ * |u|) * 1 :=
                  mul_le_mul h_lip_u hr_lt.le hr_pos.le (by positivity)
              _ = L_χ * |u| := mul_one _
          calc |χ (θ + u) - χ θ| * (r / ‖circleMap 0 1 u - (r : ℂ)‖)
              = (|χ (θ + u) - χ θ| * r) / ‖circleMap 0 1 u - (r : ℂ)‖ :=
                (mul_div_assoc _ _ _).symm
            _ ≤ (L_χ * |u|) / (|u| / Real.pi) :=
                div_le_div₀ (by positivity) h_num h_j_pos h_jord
            _ = Real.pi * L_χ := by
                field_simp [hu_pos.ne', Real.pi_pos.ne']
      rw [abs_of_pos (by linarith [Real.pi_pos] : (0 : ℝ) < Real.pi - -Real.pi)] at h_int_bound
      dsimp [g, C_bump]
      rw [h_sub_mean, h_shifted, norm_mul, norm_div, Complex.norm_I, Complex.norm_real,
        Real.norm_of_nonneg Real.pi_pos.le]
      calc (1 / Real.pi) * ‖∫ u in (-Real.pi)..Real.pi, G_diff (θ + u)‖
          ≤ (1 / Real.pi) * ((Real.pi * L_χ) * (Real.pi - -Real.pi)) :=
            mul_le_mul_of_nonneg_left h_int_bound (by positivity)
        _ = 2 * Real.pi * L_χ := by
            field_simp [Real.pi_pos.ne']
            ring

    have hg_ball_norm : ∀ ζ ∈ Metric.closedBall (0 : ℂ) 1, ‖g ζ‖ ≤ C_bump := by
      have h1_lt_inv : 1 < 1 / r := (one_lt_div hr_pos).mpr hr_lt
      have h_sub : Metric.closedBall (0 : ℂ) 1 ⊆ Metric.ball (0 : ℂ) (1 / r) :=
        Metric.closedBall_subset_ball h1_lt_inv
      have h_diffCont : DiffContOnCl ℂ g (Metric.ball (0 : ℂ) 1) := by
        refine (hg_holo.mono ?_).diffContOnCl
        rw [closure_ball (0 : ℂ) one_ne_zero]
        exact h_sub
      intro ζ hζ
      rw [← closure_ball (0 : ℂ) one_ne_zero] at hζ
      refine Complex.norm_le_of_forall_mem_frontier_norm_le Metric.isBounded_ball
        h_diffCont ?_ hζ
      rw [frontier_ball (0 : ℂ) one_ne_zero]
      exact hg_sphere_norm

    refine ⟨g, hg_holo, hg_zero, fun ζ hζ => ⟨hg_ball_norm ζ hζ, (hg_im_bounds ζ hζ).1,
      (hg_im_bounds ζ hζ).2⟩, ?_⟩
    intro ζ hζ h_collar
    have hζ_cb : ζ ∈ Metric.closedBall (0 : ℂ) 1 := Metric.sphere_subset_closedBall hζ
    refine ⟨by linarith [(hg_im_bounds ζ hζ_cb).1], ?_⟩
    have h_img : ζ ∈ circleMap 0 1 '' Set.Ioc 0 (2 * Real.pi) := by
      rw [image_circleMap_Ioc]
      simpa using hζ
    obtain ⟨θ, _, rfl⟩ := h_img
    set ζ := circleMap 0 1 θ
    have hζ_norm : ‖ζ‖ = 1 := by simp [ζ, norm_circleMap_zero]
    have hcζ_norm : ‖c + ζ‖ < 4 / 3 := by
      calc ‖c + ζ‖ ≤ ‖c‖ + ‖ζ‖ := norm_add_le c ζ
        _ < 1 / 3 + 1 := by linarith
        _ = 4 / 3 := by norm_num
    have hsin_y₀ : |Real.sin θ - y₀| < δ_v / 2 := by
      have him : (c + ζ).im = Real.sin θ - y₀ := by
        dsimp [ζ, y₀]
        simp [circleMap_zero]
        ring
      rw [← him]
      calc |(c + ζ).im| ≤ (6 / 5) * γ_steep * ‖c + ζ‖ := h_collar
        _ ≤ (6 / 5) * (δ_v / 4) * (4 / 3) := by
            have : γ_steep * ‖c + ζ‖ ≤ (δ_v / 4) * (4 / 3) :=
              mul_le_mul hγs_le_δv hcζ_norm.le (norm_nonneg _) (by positivity)
            linarith
        _ = (2 / 5) * δ_v := by ring
        _ < δ_v / 2 := by linarith
    obtain ⟨hK_cont, hK_nonneg, hK_avg, hg_im⟩ := h_poisson_rep ζ hζ_cb
    set K_w : ℝ → ℝ := fun φ =>
      (1 - ‖(r : ℂ) * ζ‖ ^ 2) / ‖circleMap 0 1 φ - (r : ℂ) * ζ‖ ^ 2
    let P_err : ℝ → ℝ := fun φ => (M_dip + χ φ) * K_w φ
    have hP_cont : Continuous P_err := (continuous_const.add hχ_cont).mul hK_cont
    have hP_per : Function.Periodic P_err (2 * Real.pi) := by
      intro φ
      have hc_per : circleMap 0 1 (φ + 2 * Real.pi) = circleMap 0 1 φ := by
        rw [h_circle_add]
        simp [circleMap_zero, Complex.exp_two_pi_mul_I]
      dsimp [P_err, K_w]
      rw [hχ_per φ, hc_per]
    have h_err_rep : M_dip + (g ζ).im =
        (2 * Real.pi)⁻¹ * ∫ u in (-Real.pi)..Real.pi, P_err (θ + u) := by
      rw [hg_im, ← h_shift_ℝ P_err θ hP_per]
      have h_add : ∀ φ : ℝ, P_err φ = M_dip * K_w φ + χ φ * K_w φ := by
        intro φ; dsimp [P_err]; ring
      have hχK_cont : Continuous (fun φ : ℝ => χ φ * K_w φ) := hχ_cont.mul hK_cont
      simp_rw [h_add]
      rw [intervalIntegral.integral_add
          ((hK_cont.const_mul M_dip).intervalIntegrable _ _)
          (hχK_cont.intervalIntegrable _ _),
        intervalIntegral.integral_const_mul]
      calc M_dip + (2 * Real.pi)⁻¹ * (∫ φ in (0 : ℝ)..(2 * Real.pi), χ φ * K_w φ)
          = M_dip * ((2 * Real.pi)⁻¹ * ∫ φ in (0 : ℝ)..(2 * Real.pi), K_w φ) +
              (2 * Real.pi)⁻¹ * (∫ φ in (0 : ℝ)..(2 * Real.pi), χ φ * K_w φ) := by
            rw [hK_avg, mul_one]
        _ = (2 * Real.pi)⁻¹ *
              (M_dip * (∫ φ in (0 : ℝ)..(2 * Real.pi), K_w φ) +
                ∫ φ in (0 : ℝ)..(2 * Real.pi), χ φ * K_w φ) := by ring
    have h_pt_bound : ∀ u ∈ Set.Icc (-Real.pi) Real.pi, P_err (θ + u) ≤ C_err * (1 - r) := by
      intro u hu
      by_cases hu_small : |u| ≤ δ_v / 2
      · have h_sin_u : |Real.sin (θ + u) - y₀| ≤ δ_v := by
          have h1 := Real.abs_sin_sub_sin_le (θ + u) θ
          have h2 : (θ + u) - θ = u := by ring
          rw [h2] at h1
          have h3 := abs_add_le (Real.sin (θ + u) - Real.sin θ) (Real.sin θ - y₀)
          have h4 : (Real.sin (θ + u) - Real.sin θ) + (Real.sin θ - y₀) =
              Real.sin (θ + u) - y₀ := by ring
          rw [h4] at h3
          linarith
        have hτ_one : τ_c (θ + u) = 1 := by
          dsimp [τ_c, ψ]
          have : |Real.sin (θ + u) - y₀| / δ_v ≤ 1 := (div_le_one hδv_pos).mpr h_sin_u
          have hmin : min 1 (2 - |Real.sin (θ + u) - y₀| / δ_v) = 1 :=
            min_eq_left (by linarith)
          rw [hmin, max_eq_right zero_le_one]
        have hχ_eq : M_dip + χ (θ + u) = 0 := by
          dsimp [χ, c_top, A_bump]
          rw [hτ_one]
          field_simp [h1_sub_μ_pos.ne']
          ring
        dsimp [P_err]
        rw [hχ_eq, zero_mul]
        exact mul_nonneg (by positivity) (by linarith)
      · push Not at hu_small
        have h_jord_sq := (h_jordan u r hu hr_lo hr_lt).1
        have h_rot_norm : ‖circleMap 0 1 (θ + u) - (r : ℂ) * ζ‖ =
            ‖circleMap 0 1 u - (r : ℂ)‖ := by
          have : circleMap 0 1 (θ + u) - (r : ℂ) * ζ =
              ζ * (circleMap 0 1 u - (r : ℂ)) := by
            dsimp [ζ]
            rw [h_circle_add]
            ring
          rw [this, norm_mul, hζ_norm, one_mul]
        have h_den_lo : δ_v ^ 2 / (2 * Real.pi ^ 2) ≤
            ‖circleMap 0 1 (θ + u) - (r : ℂ) * ζ‖ ^ 2 := by
          rw [h_rot_norm]
          have hu_sq : (δ_v / 2) ^ 2 ≤ u ^ 2 := by
            have := pow_le_pow_left₀ (by positivity) hu_small.le 2
            simpa [sq_abs] using this
          have h1 : 2 * (δ_v / 2) ^ 2 / Real.pi ^ 2 ≤ 2 * u ^ 2 / Real.pi ^ 2 := by
            refine div_le_div_of_nonneg_right ?_ (sq_nonneg _)
            linarith
          have h2 : δ_v ^ 2 / (2 * Real.pi ^ 2) = 2 * (δ_v / 2) ^ 2 / Real.pi ^ 2 := by ring
          linarith
        have h_num_hi : 1 - ‖(r : ℂ) * ζ‖ ^ 2 ≤ 2 * (1 - r) := by
          rw [norm_mul, hζ_norm, mul_one, Complex.norm_real, Real.norm_of_nonneg hr_pos.le]
          nlinarith
        have hK_hi : K_w (θ + u) ≤ 2 * (1 - r) / (δ_v ^ 2 / (2 * Real.pi ^ 2)) := by
          dsimp [K_w]
          exact div_le_div₀ (by linarith) h_num_hi (by positivity) h_den_lo
        have hMχ_hi : M_dip + χ (θ + u) ≤ M_dip + η_plus := by linarith [hχ_hi (θ + u)]
        calc P_err (θ + u)
            ≤ (M_dip + η_plus) * (2 * (1 - r) / (δ_v ^ 2 / (2 * Real.pi ^ 2))) :=
              mul_le_mul hMχ_hi hK_hi (hK_nonneg _) (by positivity)
          _ = C_err * (1 - r) := by
              dsimp [C_err]
              field_simp [Real.pi_pos.ne', hδv_pos.ne']
              ring
    rw [h_err_rep]
    have h_int_le := intervalIntegral.integral_mono_on (μ := MeasureTheory.volume)
      (by linarith [Real.pi_pos])
      ((hP_cont.comp (continuous_const.add continuous_id)).intervalIntegrable _ _)
      (intervalIntegrable_const (c := C_err * (1 - r)))
      (fun u hu => h_pt_bound u hu)
    rw [intervalIntegral.integral_const] at h_int_le
    simp only [smul_eq_mul] at h_int_le
    calc (2 * Real.pi)⁻¹ * (∫ u in (-Real.pi)..Real.pi, P_err (θ + u))
        ≤ (2 * Real.pi)⁻¹ * ((Real.pi - -Real.pi) * (C_err * (1 - r))) :=
