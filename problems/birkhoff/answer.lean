      (R_vert : Fin L_vert → ℝ)
      (_hR_pos : ∀ k : Fin L_vert, 0 < R_vert k)
      (N_vert D_vert : Fin L_vert → ℤ → Fin 2 → ℂ × ℂ → ℂ)
      (D_prod : Fin L_vert → ℂ × ℂ → ℂ),
      (∀ (k : Fin L_vert), ∀ q ∈ F_all, ∀ c : Fin 2,
