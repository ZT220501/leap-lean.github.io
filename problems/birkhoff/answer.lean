      linarith
    have hry_le : ry ≤ 3 * μ := by
      rw [Real.sqrt_le_left (by positivity)]
      nlinarith [sq_abs y, abs_nonneg y]
    have hxy_le : x * y ≤ 2 * h * μ := by
      have h1 : x * y ≤ |x * y| := le_abs_self _
      rw [abs_mul] at h1
      nlinarith [abs_nonneg x, abs_nonneg y]
    have hS_le : S ≤ (15 / 2 : ℝ) * h * μ := by
      have h_rxry : rx * ry ≤ ((3 / 2 : ℝ) * h) * (3 * μ) :=
