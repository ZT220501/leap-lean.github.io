  have hB_ge_4exp : 4 * Real.exp (6 * bG) ≤ B_base := le_max_right _ _
  have hB_ge_init : 1 + C_X0 ≤ B_base := le_max_left _ _
  have hB_ge_four : 4 ≤ B_base := by linarith
  have hB_nonneg : 0 ≤ B_base := by linarith
  have h_ind : ∀ m : ℕ, m ≤ T →
      sliceRunningPosMax S P y_seq m ≤ A_mult ^ (e_exp m) * B_base := by
    intro m
    induction m using Nat.strong_induction_on with
    | h m ih =>
        intro hm
        cases m with
        | zero =>
            dsimp only [e_exp]
            rw [pow_zero, one_mul]
            exact le_trans hR_zero hB_ge_init
        | succ k =>
            rcases le_total (1 + S_step (k + 1)) (sliceRunningPosMax S P y_seq k) with h_plat | h_rec
            · have h_eq_prev :
                  sliceRunningPosMax S P y_seq (k + 1) = sliceRunningPosMax S P y_seq k := by
                rw [hR_succ k, max_eq_right h_plat]
              rw [h_eq_prev]
              refine le_trans (ih k (Nat.lt_succ_self k) (Nat.le_of_succ_le hm)) ?_
              exact mul_le_mul_of_nonneg_right
                (pow_le_pow_right₀ hA_ge_one (he_mono (Nat.le_succ k))) hB_nonneg
            · have h_eq_rec :
                  sliceRunningPosMax S P y_seq (k + 1) = 1 + S_step (k + 1) := by
                rw [hR_succ k, max_eq_left h_rec]
              let a' : ℕ := a_last k
              have ha'_le_k : a' ≤ k := ha_le k
              have ha'_lt : a' < k + 1 := Nat.lt_succ_of_le ha'_le_k
              have ha'_le_T : a' ≤ T := le_trans ha'_lt.le hm
              let B_sup : ℝ :=
                2 * Real.exp r_star *
                    (sliceRunningPosMax S P y_seq a' + 2 * Real.exp (6 * bG)) +
                  4 * Real.exp (-bG / 3) * sliceRunningPosMax S P y_seq (k + 1)
              have hB_sup_nonneg : 0 ≤ B_sup := by
                have := hR_nonneg a'
                have := hR_nonneg (k + 1)
                dsimp only [B_sup]
                positivity
              have h_sup_all : ∀ k' : Fin P.N,
                  ‖sliceSupportSeq S P.N k'.val (y_seq (k + 1))‖ ≤ B_sup := fun k' =>
                h_const_interval ha'_lt.le hm k' (ha_const k k')
              have h_ang_all : ∀ k' : Fin P.N,
                  ‖sliceAngleSeq S P.N k'.val (y_seq (k + 1))‖ +
                    |Real.log ‖Complex.sin
                      (P.θ_seq k'.val (y_seq (k + 1)) -
                        sliceAngleSeq S P.N k'.val (y_seq (k + 1)))‖| ≤ 2 * r_star := by
                intro k'
                have hk' := hy_ang (k + 1) hm k'
                change ‖sliceAngleSeq S P.N k'.val (y_seq (k + 1))‖ +
                  |Real.log ‖Complex.sin (P.d0 k' (y_seq (k + 1)))‖| ≤ 2 * r_star
                linarith [hk'.1, hk'.2]
              have h_pos_all : ∀ j : Fin P.N,
                  ‖slicePosSeq S P.N j.val (y_seq (k + 1))‖ ≤
                    P.C_rec * Real.exp (P.C_rec * (2 * r_star)) * B_sup :=
                P.pos_reconstruction (y_seq (k + 1)) (hy_reg (k + 1) hm)
                  (2 * r_star) B_sup (by positivity) hB_sup_nonneg h_ang_all h_sup_all
              have hS_k1_le :
                  S_step (k + 1) ≤ P.C_rec * Real.exp (P.C_rec * (2 * r_star)) * B_sup :=
                Finset.sup'_le _ _ fun j _ => h_pos_all j
              have h_expand :
                  P.C_rec * Real.exp (P.C_rec * (2 * r_star)) * B_sup =
                    2 * P.C_rec * Real.exp ((2 * P.C_rec + 1) * r_star) *
                        (sliceRunningPosMax S P y_seq a' + 2 * Real.exp (6 * bG)) +
                      (4 * P.C_rec * Real.exp (2 * P.C_rec * r_star - bG / 3)) *
                        sliceRunningPosMax S P y_seq (k + 1) := by
                dsimp only [B_sup]
                have hexp1 :
                    Real.exp (P.C_rec * (2 * r_star)) * Real.exp r_star =
                      Real.exp ((2 * P.C_rec + 1) * r_star) := by
                  rw [← Real.exp_add]
                  congr 1
                  ring
                have hexp2 :
                    Real.exp (P.C_rec * (2 * r_star)) * Real.exp (-bG / 3) =
                      Real.exp (2 * P.C_rec * r_star - bG / 3) := by
                  rw [← Real.exp_add]
                  congr 1
                  ring
                calc
                  P.C_rec * Real.exp (P.C_rec * (2 * r_star)) *
                      (2 * Real.exp r_star *
                          (sliceRunningPosMax S P y_seq a' + 2 * Real.exp (6 * bG)) +
                        4 * Real.exp (-bG / 3) * sliceRunningPosMax S P y_seq (k + 1))
                      = 2 * P.C_rec * (Real.exp (P.C_rec * (2 * r_star)) * Real.exp r_star) *
                          (sliceRunningPosMax S P y_seq a' + 2 * Real.exp (6 * bG)) +
                        4 * P.C_rec * (Real.exp (P.C_rec * (2 * r_star)) * Real.exp (-bG / 3)) *
                          sliceRunningPosMax S P y_seq (k + 1) := by ring
                  _ = 2 * P.C_rec * Real.exp ((2 * P.C_rec + 1) * r_star) *
                          (sliceRunningPosMax S P y_seq a' + 2 * Real.exp (6 * bG)) +
                        (4 * P.C_rec * Real.exp (2 * P.C_rec * r_star - bG / 3)) *
                          sliceRunningPosMax S P y_seq (k + 1) := by
                        rw [hexp1, hexp2]
              have h_abs_term :
                  (4 * P.C_rec * Real.exp (2 * P.C_rec * r_star - bG / 3)) *
                      sliceRunningPosMax S P y_seq (k + 1) ≤
                    (1 / 2 : ℝ) * sliceRunningPosMax S P y_seq (k + 1) :=
                mul_le_mul_of_nonneg_right h_absorb (hR_nonneg (k + 1))
              have hR_k1_pre :
                  sliceRunningPosMax S P y_seq (k + 1) ≤
                    2 + 4 * P.C_rec * Real.exp ((2 * P.C_rec + 1) * r_star) *
                      (sliceRunningPosMax S P y_seq a' + 2 * Real.exp (6 * bG)) := by
                linarith [h_eq_rec, hS_k1_le, h_expand, h_abs_term]
              let Q : ℝ := A_mult ^ (e_exp a') * B_base
              have hR_a'_le : sliceRunningPosMax S P y_seq a' ≤ Q :=
                ih a' ha'_lt ha'_le_T
              have h_pow_ge_one : 1 ≤ A_mult ^ (e_exp a') := one_le_pow₀ hA_ge_one
              have hB_le_Q : B_base ≤ Q := by
                dsimp only [Q]
                nlinarith
              have hQ_ge_four : 4 ≤ Q := le_trans hB_ge_four hB_le_Q
              have hQ_nonneg : 0 ≤ Q := by linarith
              have h_two_le : 2 ≤ Real.exp ((2 * P.C_rec + 1) * r_star) * Q := by
                nlinarith
              have h_sum_le_Q :
                  sliceRunningPosMax S P y_seq a' + 2 * Real.exp (6 * bG) ≤ (3 / 2 : ℝ) * Q := by
                linarith [hR_a'_le, hB_ge_4exp, hB_le_Q]
              have h_second_le :
                  4 * P.C_rec * Real.exp ((2 * P.C_rec + 1) * r_star) *
                      (sliceRunningPosMax S P y_seq a' + 2 * Real.exp (6 * bG)) ≤
                    6 * P.C_rec * Real.exp ((2 * P.C_rec + 1) * r_star) * Q := by
                have h_coeff_nonneg : 0 ≤ 4 * P.C_rec * Real.exp ((2 * P.C_rec + 1) * r_star) := by
                  positivity
                calc
                  4 * P.C_rec * Real.exp ((2 * P.C_rec + 1) * r_star) *
                      (sliceRunningPosMax S P y_seq a' + 2 * Real.exp (6 * bG))
                      ≤ 4 * P.C_rec * Real.exp ((2 * P.C_rec + 1) * r_star) * ((3 / 2 : ℝ) * Q) :=
                        mul_le_mul_of_nonneg_left h_sum_le_Q h_coeff_nonneg
                  _ = 6 * P.C_rec * Real.exp ((2 * P.C_rec + 1) * r_star) * Q := by ring
              have h_exp_step : e_exp a' + 1 = e_exp (k + 1) :=
                congrArg (· + 1) (ha_exp k)
              calc
                sliceRunningPosMax S P y_seq (k + 1)
                    ≤ 2 + 4 * P.C_rec * Real.exp ((2 * P.C_rec + 1) * r_star) *
                        (sliceRunningPosMax S P y_seq a' + 2 * Real.exp (6 * bG)) := hR_k1_pre
                _ ≤ Real.exp ((2 * P.C_rec + 1) * r_star) * Q +
                      6 * P.C_rec * Real.exp ((2 * P.C_rec + 1) * r_star) * Q :=
                      add_le_add h_two_le h_second_le
                _ = A_mult * Q := by dsimp only [A_mult]; ring
                _ = A_mult ^ (e_exp a' + 1) * B_base := by
                      dsimp only [Q]; rw [pow_succ']; ring
                _ = A_mult ^ (e_exp (k + 1)) * B_base := by rw [h_exp_step]
  have he_T_le : e_exp T ≤ sliceJointSwitches S P bG y_seq T + 1 := by
    cases T with
    | zero => exact Nat.zero_le _
    | succ k =>
        dsimp only [e_exp]
        exact Nat.succ_le_succ (hN_sw_mono (Nat.le_succ k))
  exact le_trans (h_ind T le_rfl)
    (mul_le_mul_of_nonneg_right (pow_le_pow_right₀ hA_ge_one he_T_le) hB_nonneg)

theorem initial_sublinear_stopped_geometry (S : FiniteWallNonisotropicStrip)
    (hBudget : CriticalAngleBudgetData S) (P : OddPeriodicSliceData S) (C_clk : ℝ)
    (hBase : WalkBaseAndStopProp S P C_clk)
    (hLogDef : StoppedLogDeficitProp S P) :
    ∃ σ₀ : ℝ, 0 < σ₀ ∧ σ₀ < 1 ∧ HasUniformPowerGeometry S P σ₀ :=
by
  let ρ₀ : ℝ := hBudget.ρ
  have hρ₀_pos : 0 < ρ₀ := hBudget.ρ_pos
  have hρ₀_lt : ρ₀ < 1 := hBudget.ρ_lt_one
  let η : ℝ := (1 - ρ₀) / 10
  have hη_pos : 0 < η := by dsimp [η]; linarith
  let ρ₁ : ℝ := ρ₀ + η
  let ρ₂ : ℝ := ρ₀ + 2 * η
  let γ : ℝ := ρ₀ + 7 * η
  let σ₃ : ℝ := ρ₀ + 8 * η
  let σ₀ : ℝ := ρ₀ + 9 * η
  let b : ℝ := 1 / 100
  have hb_pos : 0 < b := by norm_num [b]
  have hσ₀_pos : 0 < σ₀ := by dsimp [σ₀, η]; linarith
  have hσ₀_lt : σ₀ < 1 := by dsimp [σ₀, η]; linarith
  refine ⟨σ₀, hσ₀_pos, hσ₀_lt, 1, le_rfl, ?_⟩
  have hAdmMono : ∀ {M₁ M₂ : ℝ} {ρ : ℂ → ℝ}, 2 ≤ M₁ → M₁ ≤ M₂ →
      IsScaleAdmissibleStep S P M₂ ρ → IsScaleAdmissibleStep S P M₁ ρ := by
    intro M₁ M₂ ρ hM₁ hM₁₂ h₂
    have h_sq : Real.exp (-M₂ ^ 2) ≤ Real.exp (-M₁ ^ 2) :=
      Real.exp_le_exp.mpr (neg_le_neg (pow_le_pow_left₀ (by linarith) hM₁₂ 2))
    have h_cube : Real.exp (-M₂ ^ 3) ≤ Real.exp (-M₁ ^ 3) :=
      Real.exp_le_exp.mpr (neg_le_neg (pow_le_pow_left₀ (by linarith) hM₁₂ 3))
    refine
      { scale_ge_two := hM₁
        measurable := h₂.measurable
        periodic := h₂.periodic
        cont_on := h₂.cont_on
        nonneg := h₂.nonneg
        pos_iff := h₂.pos_iff
        le_sing_dist := h₂.le_sing_dist
        small_shape_step := ?_
        jump_log_speed := h₂.jump_log_speed
        jump_log_sin_d0 := h₂.jump_log_sin_d0
        jump_log_chord := h₂.jump_log_chord
        jump_angle := h₂.jump_angle
        jump_pos := h₂.jump_pos
        taylor_impact := ?_
        taylor_angle := ?_
        taylor_pos₀ := ?_
        taylor_pos₁ := ?_
        taylor_support := ?_ }
    · intro y hy z hz j
      have h_step := h₂.small_shape_step y hy z hz j
      have h_depth_nonneg : 0 ≤ sliceShapeDepth S P j y := by
        have h_prod : 0 ≤ Real.exp (-M₂ ^ 2) * sliceShapeDepth S P j y :=
          le_trans (norm_nonneg _) h_step
        exact nonneg_of_mul_nonneg_right h_prod (Real.exp_pos _)
      exact le_trans h_step (mul_le_mul_of_nonneg_right h_sq h_depth_nonneg)
    · intro y hy z hz j
      refine le_trans (h₂.taylor_impact y hy z hz j) ?_
      have hρ : 0 ≤ ρ y := h₂.nonneg y
      nlinarith
    · intro y hy z hz j
      refine le_trans (h₂.taylor_angle y hy z hz j) ?_
      have hρ : 0 ≤ ρ y := h₂.nonneg y
      nlinarith
    · intro y hy z hz j
      refine le_trans (h₂.taylor_pos₀ y hy z hz j) ?_
      have hρ : 0 ≤ ρ y := h₂.nonneg y
      nlinarith
    · intro y hy z hz j
      refine le_trans (h₂.taylor_pos₁ y hy z hz j) ?_
      have hρ : 0 ≤ ρ y := h₂.nonneg y
      nlinarith
    · intro y hy z hz j
      refine le_trans (h₂.taylor_support y hy z hz j) ?_
      have hρ : 0 ≤ ρ y := h₂.nonneg y
      exact mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_left h_cube (by positivity)) hρ
  have hProbUnif : MeasureTheory.IsProbabilityMeasure unifTwoPiMeasure := by
    refine ⟨?_⟩
    simp only [unifTwoPiMeasure, MeasureTheory.Measure.smul_apply,
      MeasureTheory.Measure.restrict_apply_univ, smul_eq_mul, Real.volume_Ico, sub_zero]
    exact ENNReal.inv_mul_cancel
      (ENNReal.ofReal_pos.mpr Real.two_pi_pos).ne' ENNReal.ofReal_ne_top
  have hProbWalk : MeasureTheory.IsProbabilityMeasure walkMeasure := by
    dsimp only [walkMeasure]
    infer_instance
  let E_init : Set WalkSpace := {om : WalkSpace | om 0 ∉ Set.Ico (0 : ℝ) (2 * Real.pi)}
  have hE_init_zero : walkMeasure.real E_init = 0 := by
    have hmp := measurePreserving_eval_infinitePi (fun _ : ℕ => unifTwoPiMeasure) 0
    have h_eq : E_init = (Function.eval 0) ⁻¹' (Set.Ico (0 : ℝ) (2 * Real.pi))ᶜ := rfl
    have h_meas : walkMeasure E_init = 0 := by
      rw [h_eq, ← MeasureTheory.Measure.map_apply (measurable_pi_apply 0) measurableSet_Ico.compl]
      change (MeasureTheory.Measure.map (Function.eval 0)
        (MeasureTheory.Measure.infinitePi (fun _ : ℕ => unifTwoPiMeasure)))
        (Set.Ico (0 : ℝ) (2 * Real.pi))ᶜ = 0
      rw [hmp.map_eq]
      simp [unifTwoPiMeasure, MeasureTheory.Measure.restrict_apply, measurableSet_Ico.compl]
    simp [MeasureTheory.measureReal_def, h_meas]
  have hN_pos : 0 < (P.N : ℝ) := by
    exact_mod_cast (lt_of_lt_of_le (by norm_num : 0 < 3) P.N_ge_three)
  have ht₀_pos : 0 < sliceParamT0 P.N := by
    dsimp [sliceParamT0]
    exact div_pos Real.two_pi_pos hN_pos
  have ht₀_ball : (sliceParamT0 P.N : ℂ) ∈ Metric.ball (0 : ℂ) S.r_star := by
    rw [Metric.mem_ball, dist_zero_right, Complex.norm_real, Real.norm_eq_abs, abs_of_pos ht₀_pos]
    exact P.t₀_lt_r_star
  let h_sl : ℝ := sliceHeight S P.N
  have hh_sl_pos : 0 < h_sl :=
    lt_of_lt_of_le S.s_star_pos (S.h_X_bounds _ ht₀_ball).1
  have h_horiz_open : ∀ r : ℝ, IsOpen (horizStrip r) := fun r =>
    isOpen_Iio.preimage (continuous_abs.comp Complex.continuous_im)
  let Ω_reg : Set ℂ := horizStrip h_sl \ P.Z_all
  have h_real_in_reg : ∀ x : ℝ, (x : ℂ) ∈ Ω_reg := fun x =>
    ⟨by simp [horizStrip, hh_sl_pos], P.real_not_mem_Z_all x⟩
  have h_pair_maps : ∀ k : ℤ,
      Set.MapsTo
        (fun z : ℂ => (z + (k : ℂ) * (sliceParamT0 P.N : ℂ), (sliceParamT0 P.N : ℂ)))
        (horizStrip h_sl) (finiteWallTube S.r_star S.h_X) := by
    intro k z hz
    have hz_lt : -h_sl < z.im ∧ z.im < h_sl := abs_lt.mp hz
    have ht₀_norm : ‖(sliceParamT0 P.N : ℂ)‖ < S.r_star := by
      simpa [Metric.mem_ball, dist_zero_right] using ht₀_ball
    refine ⟨ht₀_norm, ?_, ?_⟩
    · simpa [sliceHeight, h_sl] using hz_lt.1
    · simpa [sliceHeight, h_sl] using hz_lt.2
  have h_impact_holo : ∀ k : ℤ, DifferentiableOn ℂ (sliceImpactSeq S P.N k) (horizStrip h_sl) := by
    intro k
    have h_pair_diff :
        DifferentiableOn ℂ
          (fun z : ℂ => (z + (k : ℂ) * (sliceParamT0 P.N : ℂ), (sliceParamT0 P.N : ℂ)))
          (horizStrip h_sl) :=
      (differentiableOn_id.add (differentiableOn_const _)).prodMk (differentiableOn_const _)
    exact S.𝔰_holo.comp h_pair_diff (h_pair_maps k)
  have h_impact_maps : ∀ k : ℤ, ∀ z ∈ horizStrip h_sl,
      sliceImpactSeq S P.N k z ∈ horizStrip S.H := fun k z hz =>
    S.𝔰_maps_to _ (h_pair_maps k hz)
  have hIcc_nonempty : (Set.Icc (0 : ℝ) (2 * Real.pi)).Nonempty :=
    ⟨0, Set.left_mem_Icc.mpr Real.two_pi_pos.le⟩
  have h_pos_bound_each : ∀ j : Fin P.N, ∃ C_j : ℝ, 0 ≤ C_j ∧
      ∀ x ∈ Set.Icc (0 : ℝ) (2 * Real.pi), ‖slicePosSeq S P.N j.val (x : ℂ)‖ ≤ C_j := by
    intro j
    have h_cont_coord : ∀ ι : Fin 2,
        Continuous (fun x : ℝ => slicePosSeq S P.N j.val (x : ℂ) ι) := by
      intro ι
      rw [continuous_iff_continuousAt]
      intro x
      have hx_reg : (x : ℂ) ∈ Ω_reg := h_real_in_reg x
      have hs_in_H : sliceImpactSeq S P.N j.val (x : ℂ) ∈ horizStrip S.H :=
        h_impact_maps j.val (x : ℂ) hx_reg.1
      have hf_ne : S.f (sliceImpactSeq S P.N j.val (x : ℂ)) ≠ 0 :=
        P.reg_speed_ne_zero (x : ℂ) hx_reg j
      have h_imp_diffAt : DifferentiableAt ℂ (sliceImpactSeq S P.N j.val) (x : ℂ) :=
        (h_impact_holo j.val).differentiableAt ((h_horiz_open h_sl).mem_nhds hx_reg.1)
      have hΓ_reg := S.Γ_reg_holo _ hs_in_H hf_ne
      have h_pos_diffAt : DifferentiableAt ℂ (fun z => slicePosSeq S P.N j.val z ι) (x : ℂ) := by
        fin_cases ι
        · exact DifferentiableAt.comp (x : ℂ) hΓ_reg.1 h_imp_diffAt
        · exact DifferentiableAt.comp (x : ℂ) hΓ_reg.2 h_imp_diffAt
      exact h_pos_diffAt.continuousAt.comp Complex.continuous_ofReal.continuousAt
    have h_cont : Continuous (fun x : ℝ => ‖slicePosSeq S P.N j.val (x : ℂ)‖) :=
      (continuous_pi h_cont_coord).norm
    obtain ⟨x_max, _, hx_max⟩ := isCompact_Icc.exists_isMaxOn hIcc_nonempty h_cont.continuousOn
    exact ⟨‖slicePosSeq S P.N j.val (x_max : ℂ)‖, norm_nonneg _, fun x hx => hx_max hx⟩
  choose C_X0_fn hC_X0_nonneg hC_X0_le using h_pos_bound_each
  let C_X0 : ℝ := Finset.univ.sup' Finset.univ_nonempty C_X0_fn
  have hC_X0_ge : 0 ≤ C_X0 := by
    obtain ⟨j₀, hj₀⟩ := (Finset.univ_nonempty : (Finset.univ : Finset (Fin P.N)).Nonempty)
    exact le_trans (hC_X0_nonneg j₀) (Finset.le_sup' C_X0_fn hj₀)
  have hC_X0_bound : ∀ x ∈ Set.Icc (0 : ℝ) (2 * Real.pi), ∀ j : Fin P.N,
      ‖slicePosSeq S P.N j.val (x : ℂ)‖ ≤ C_X0 := fun x hx j =>
    le_trans (hC_X0_le j x hx) (Finset.le_sup' C_X0_fn (Finset.mem_univ j))
  have h_chord_log_def : ∀ j : Fin P.N, ∃ C_g : ℝ, 0 < C_g ∧
      ∀ M B₀ B₁ : ℝ, 1 ≤ B₀ → 1 ≤ B₁ →
        ∀ ρ : ℂ → ℝ, IsScaleAdmissibleStep S P M ρ →
          walkMeasure.real {om : WalkSpace |
            ∃ m ≤ sliceStopTau S P ρ M om,
              (∀ l < m, Real.log ‖P.ℓ_slice j (walkPos ρ om l)‖ ≤ B₀) ∧
              Real.log ‖P.ℓ_slice j (walkPos ρ om m)‖ < -B₁} ≤
            C_g * (1 + B₀) / (1 + B₁) := by
    intro j
    have h_speed_holo : ∀ k : ℤ, DifferentiableOn ℂ (sliceSpeedSeq S P.N k) (horizStrip h_sl) :=
      fun k => S.f_holo.comp (h_impact_holo k) (h_impact_maps k)
    have h_den_holo : DifferentiableOn ℂ
        (fun y => sliceSpeedSeq S P.N j.val y * sliceSpeedSeq S P.N ((j.val : ℤ) + 1) y) Ω_reg :=
      ((h_speed_holo j.val).mul (h_speed_holo ((j.val : ℤ) + 1))).mono Set.sdiff_subset
    have h_den_ne : ∀ y ∈ Ω_reg,
        sliceSpeedSeq S P.N j.val y * sliceSpeedSeq S P.N ((j.val : ℤ) + 1) y ≠ 0 := by
      intro y hy h_zero
      have h_ne := P.reg_chord_ne_zero y hy j
      simp [h_zero] at h_ne
    have h_ell_holo : DifferentiableOn ℂ (P.ℓ_slice j) Ω_reg :=
      ((P.ℓ_num_holo j).mono Set.sdiff_subset).div h_den_holo h_den_ne
    have h_ell_ne : ∀ y ∈ Ω_reg, P.ℓ_slice j y ≠ 0 := fun y hy => P.reg_chord_ne_zero y hy j
    have h_ell_cont : Continuous (fun x : ℝ => P.ℓ_slice j (x : ℂ)) := by
      rw [continuous_iff_continuousAt]
      intro x
      exact (h_ell_holo.differentiableAt (P.reg_open.mem_nhds (h_real_in_reg x))).continuousAt.comp
        Complex.continuous_ofReal.continuousAt
    have h_log_cont : Continuous (fun x : ℝ => |Real.log ‖P.ℓ_slice j (x : ℂ)‖|) :=
      (h_ell_cont.norm.log fun x => norm_ne_zero_iff.mpr (h_ell_ne _ (h_real_in_reg x))).abs
