            ext p; simp
          rw [h_eq]; exact hp₁.mul (hjet_holo (emb M w))
      have hF_rel_holo : DifferentiableOn ℂ F_rel W := by
        dsimp only [F_rel]
        refine DifferentiableOn.fun_sum fun d _ => ?_
        exact (hMvHolo (Q₀ d)).mul (hz_holo.pow (d : ℕ))
      have hF_rel_VW : ∀ p ∈ V_W, F_rel p = 0 := by
        intro p hp
        rcases hVW_surj p hp with ⟨q, hq, rfl⟩
        dsimp only [F_rel]
        simp_rw [hQ₀_eval_eq]
        rw [← hR_eval q]
        exact hR_zero_on_U q hq
      refine ⟨M, D₀, hD₀_ge, Q₀, ?_, ?_⟩
      · intro p hpW
