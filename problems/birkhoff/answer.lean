      exact ⟨by linarith, by linarith⟩
    have hs_seq_succ : ∀ i : ℕ, s_seq (i + 1) = s_seq i - 20 * δ i := by
      intro i; dsimp [s_seq]; rw [Finset.sum_range_succ]; ring
    have hd_seq_succ : ∀ i : ℕ, d_seq (i + 1) = d_seq i - 20 * δ i := by
      intro i; dsimp [d_seq]; rw [Finset.sum_range_succ]; ring
    have hη_seq_bounds : ∀ i : ℕ, η_seq i ≤ G.η_adm / 2 := by
      intro i
      have hpow_pos : (0 : ℝ) < (1 / 4 : ℝ) ^ i := by positivity
      have hsum : ∑ r ∈ Finset.range i, stepBound r =
          G.C_step * K_B ^ B₀ * d₀ ^ 2 * ∑ r ∈ Finset.range i, (1 / 4 : ℝ) ^ r := by
        simp only [stepBound, ← Finset.mul_sum]
      dsimp [η_seq]
      rw [hsum, h_sum_quarter i]
      have hle1 : G.C_step * K_B ^ B₀ * d₀ ^ 2 * ((4 / 3 : ℝ) * (1 - (1 / 4 : ℝ) ^ i)) ≤
          (4 / 3 : ℝ) * G.C_step * K_B ^ B₀ * d₀ ^ 2 := by
        have hc0 : 0 ≤ G.C_step * K_B ^ B₀ * d₀ ^ 2 := by positivity
        nlinarith
      have hle2 : c_min ≤ G.η_adm / 4 := min_le_right _ _
      linarith
    have h_newton_ineqs : ∀ i : ℕ,
        0 < δ i ∧ δ i < d_seq i / 100 ∧
