      exact h_mul
    rw [← sq_le_sq₀ (norm_nonneg _) (Real.exp_nonneg _)]
    have h_exp_sq : (Real.exp (-H_star / 2)) ^ 2 = Real.exp (-H_star) := by
      rw [← Real.exp_nat_mul]
      exact congrArg Real.exp (by push_cast; ring)
    rw [h_exp_sq]
    have h_sin_pos : 0 < ‖Complex.sin (P.d0 j y)‖ :=
      norm_pos_iff.mpr (P.reg_sin_d0_ne_zero y hy j)
    have hV_norm_sq :
        ‖jacobiVDiag P.N S.c (fun i => sliceSpeedSeq S P.N i.val y) (fun i => P.d0 i y) j‖ ^ 2 =
          4 * (‖f_j‖ ^ 2) ^ 3 / (S.c ^ 2 * ‖Complex.sin (P.d0 j y)‖ ^ 2) := by
      dsimp only [jacobiVDiag, f_j]
      rw [norm_div, norm_mul, Complex.norm_ofNat, norm_pow, norm_mul, Complex.norm_real,
