        simpa [Function.comp, L_aff] using h_all0 h1_Ω₁
      · refine ⟨Ψ q₁, hΨ_maps q₁ hq₁_mem, ?_⟩
        rw [hQ₀_eval_eq]
        exact hQ_tilde_lead_ne
    
    rcases hGen with ⟨M, D₀, hD₀, Q₀, hQ₀_ann, hQ₀_lead⟩
    let σ₀ := σ M
    let envFn : σ₀ → ℂ × ℂ → ℂ := fun w => jetFn (emb M w)
    have henv_holo : ∀ w : σ₀, DifferentiableOn ℂ (envFn w) W := fun w => hjet_holo (emb M w)
    have hDom2D : ∀ (g₁ g₂ : ℂ × ℂ → ℂ),
