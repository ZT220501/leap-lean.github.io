          _ ≤ v := Nat.floor_le hv_nn
      have hv_lt_2k1 : v < (2 : ℝ) ^ (k + 1) := by
        have hp : m_v + 1 ≤ 2 ^ (k + 1) := Nat.lt_pow_succ_log_self (by norm_num) m_v
        calc v < (m_v : ℝ) + 1 := Nat.lt_floor_add_one v
          _ = ((m_v + 1 : ℕ) : ℝ) := by push_cast; ring
          _ ≤ ((2 ^ (k + 1) : ℕ) : ℝ) := Nat.cast_le.mpr hp
          _ = (2 : ℝ) ^ (k + 1) := by push_cast; rfl
      have hv_rpow : v ^ (9 / 8 : ℝ) ≤ ((2 : ℝ) ^ (k + 1)) ^ (9 / 8 : ℝ) :=
        Real.rpow_le_rpow hv_nn hv_lt_2k1.le (by norm_num)
      let Δ_k : ℝ := (3 / 4 : ℝ) * ((2 : ℝ) ^ k)
