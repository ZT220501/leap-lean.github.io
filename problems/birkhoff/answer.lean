              ≤ |h_seq j| + |(3 / 2 : ℝ) * (((R : ℝ) + 1) * ℓ_seq j) * Real.sin p.1| := abs_add_le _ _
            _ ≤ |h_seq j| + (3 / 2 : ℝ) * (((R : ℝ) + 1) * ℓ_seq j) := by linarith
