          (W.L_mero c).num (c_shift u.1) z * (G_u u c).den (c_wall u.1) z := by
    intro u c
    let q := u.1
    let δx := δ_x_u u
    let δt := δ_t_u u
    have hδx : 0 < δx := hδ_x_pos u
    have hδt : 0 < δt := hδ_t_pos u
    have hRw_u := hR_wall_le u
    have hRw_δx : R_wall ≤ δx := le_trans hRw_u (le_trans (min_le_right _ _) (min_le_left _ _))
    have hRw_radG : R_wall ≤ (G_u u c).rad (c_wall q) := by
      have h1 : R_wall ≤ min ((G_u u 0).rad (c_wall q)) ((G_u u 1).rad (c_wall q)) :=
        le_trans hRw_u (min_le_left _ _)
      fin_cases c
      · exact le_trans h1 (min_le_left _ _)
      · exact le_trans h1 (min_le_right _ _)
    let p_test : ℂ × ℂ :=
      (y_wall q - ((3 * δx / 4 : ℝ) : ℂ) * Complex.I, (t₂ : ℂ))
    have hp_test_im : p_test.1.im = H₂ - 3 * δx / 4 := by
      dsimp [p_test, y_wall]; simp [Complex.mul_im]
    have hp_test_dist : p_test.1 ∈ Metric.ball (y_wall q) δx := by
      rw [Metric.mem_ball, dist_eq_norm]
      have hsub : p_test.1 - y_wall q = -(((3 * δx / 4 : ℝ) : ℂ) * Complex.I) := by
        dsimp [p_test]; ring
      rw [hsub, norm_neg, norm_mul, Complex.norm_I, mul_one, Complex.norm_real,
