  have h_exp2_int : IntervalIntegrable (fun u => 8 * Real.exp (-2 * u))
      MeasureTheory.volume k₀ K :=
    (by fun_prop : Continuous fun u => 8 * Real.exp (-2 * u)).intervalIntegrable _ _
  have h_exp2_le : (∫ u in k₀..K, 8 * Real.exp (-2 * u)) ≤ 4 := by
