        apply Finset.sum_congr rfl
        intro q hq
        have hq_eq : q.1 + q.2 = l₀ := Finset.HasAntidiagonal.mem_antidiagonal.mp hq
        by_cases hq2 : d 0 + d 1 + q.2 < n
        · rw [hVB_Z_pow n d q.2 hq2, mul_zero, mul_zero]
        · have hq1_le : q.1 ≤ N - n := by omega
          apply congr_arg (fun x => x * PowerSeries.coeff q.2 (MvPowerSeries.coeff d (Z ^ n)))
          rw [PowerSeries.coeff_mk, pointRecJetSeq, PowerSeries.coeff_mk, map_sum, map_sum]
          refine Finset.sum_subset (Finset.range_mono (by omega)) ?_
          intro m _ hmq1
          rw [Finset.mem_range] at hmq1
          rw [PowerSeries.coeff_mul]
          apply Finset.sum_eq_zero
          intro r hr
          have hr_eq : r.1 + r.2 = q.1 := Finset.HasAntidiagonal.mem_antidiagonal.mp hr
