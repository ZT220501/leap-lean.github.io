            mul_le_mul_of_nonneg_left hsq_le (by positivity)
          calc r_c * r_c ^ K_p * ‖(γ θ - p.2)⁻¹‖ ^ 2 * ‖π₂‖
              ≤ r_c * r_c ^ K_p * ((r_τ_raw / 8)⁻¹ ^ 2) * 1 :=
                mul_le_mul h1 hπ₂_norm (norm_nonneg _) (by positivity)
            _ = r_c * r_c ^ K_p * ((r_τ_raw / 8)⁻¹ ^ 2) := mul_one _
        have hp_cir : (p.1, γ θ) ∈ K_cir := ⟨Metric.ball_subset_closedBall hp.1, hγ_sphere θ⟩
        have hd_le : ‖d_fn_c p θ‖ ≤ B_M :=
          le_trans (hB_M0 _ hp_cir) (le_max_left _ _)
        have hd'_le : ‖d'_fn p θ‖ ≤ B_dM := by
