          let ξ := fun z => (z + (ρ : ℂ) + e_X z) + (c : ℂ) * Y z
          DifferentiableOn ℂ ξ (horizStrip σ') ∧
          (∀ z ∈ horizStrip σ', ξ z ∈ horizStrip σ) ∧
          (∀ z ∈ horizStrip σ', ξ (z + 2 * Real.pi) = ξ z + 2 * Real.pi) ∧
          (∀ z ∈ horizStrip σ', ξ (starRingEnd ℂ z) = starRingEnd ℂ (ξ z)) ∧
          (∀ j : ℕ, 1 ≤ j → j ≤ p₀ → ∀ z ∈ horizStrip σ', ‖iteratedDeriv j ξ z‖ ≤ B_p) := by
        intro c hc
        have hc_abs : |c| ≤ 1 := abs_le.mpr ⟨by linarith [hc.1], hc.2⟩
        have hcY_raw := hCalc.holo_real_mul c (by positivity) hY
        have hcY : IsStripHoloSymBounded p₀ σ' ((2 : ℝ) ^ p₀) (fun z => (c : ℂ) * Y z) :=
          hCalc.holo_mono (mul_le_of_le_one_left (by positivity) hc_abs) hcY_raw
        have hg := hCalc.holo_add he hcY
        have hξ_eq : (fun z => (z + (ρ : ℂ) + e_X z) + (c : ℂ) * Y z) =
            (fun z => z + (ρ : ℂ) + (e_X z + (c : ℂ) * Y z)) := by ext z; ring
        refine ⟨?_, fun z hz => hMaps c hc z hz, ?_, ?_, ?_⟩
        · rw [hξ_eq]
          exact (differentiableOn_id.add (differentiableOn_const _)).add hg.1.1
        · intro z hz
          have h1 := he.2.1 z hz
          have h2 := hY.2.1 z hz
          dsimp; rw [h1, h2]; ring
        · intro z hz
          have h1 := he.2.2 z hz
          have h2 := hY.2.2 z hz
          dsimp; rw [h1, h2]; simp [map_add, map_mul, Complex.conj_ofReal]
