            have hηψ_d : MvPowerSeries.coeff d ηψ = (1 / 2 : ℂ) * (δη_m + δη_p) := by
              dsimp only [ηψ, lcJetMid2D, δη_m, δη_p]
              rw [MvPowerSeries.coeff_C_mul, map_add]
            have hηd_d : MvPowerSeries.coeff d ηd = (1 / 2 : ℂ) * (δη_p - δη_m) := by
              dsimp only [ηd, lcJetHalfStep2D, δη_m, δη_p]
              rw [MvPowerSeries.coeff_C_mul, map_sub]
            have htr_c0 : PowerSeries.coeff 0 (h_tr i) = h0 := by
              simp [h_tr, lcJetTrunc1D, h0]
            have htr_c1 : PowerSeries.coeff 1 (h_tr i) = h1 := by
