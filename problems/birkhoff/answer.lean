            have := mul_le_mul_of_nonneg_left hvw (le_of_lt hδm_pos)
            linarith
          exact le_trans htop_v (le_trans hstep hu₀_low)
        · exact isMaxOn_iff.mp hu₀_max v ⟨le_of_lt (lt_of_not_ge hv_mid), hv⟩
    have hu₀_ge_U₁ : U₁ ≤ u₀ :=
      le_trans (le_max_right W₁ U₁) (le_trans h1mη_w_ge_WU hu₀_mem.1)
    have hu₀_pos : 0 < u₀ := by linarith
    have hI2_nonempty : (Set.Icc u₀ ((1 + η) * u₀)).Nonempty :=
      Set.nonempty_Icc.mpr (by nlinarith)
    obtain ⟨u, hu_mem, hu_max⟩ :=
      isCompact_Icc.exists_isMaxOn hI2_nonempty hφp_cont.continuousOn
    have hu_low : -(1 + η / 4) * δ_plus * u₀ ≤ φ_plus u := by
      have hu₀_in : u₀ ∈ Set.Icc u₀ ((1 + η) * u₀) := ⟨le_rfl, by nlinarith⟩
      exact le_trans (hφp_top u₀ hu₀_ge_U₁).1 (isMaxOn_iff.mp hu_max u₀ hu₀_in)
    have hu_fut : ∀ v : ℝ, u₀ ≤ v → φ_plus v ≤ φ_plus u := by
      intro v hv
      by_cases hv_in : v ≤ (1 + η) * u₀
      · exact isMaxOn_iff.mp hu_max v ⟨hv, hv_in⟩
      · have hv_in' : (1 + η) * u₀ < v := lt_of_not_ge hv_in
        have hv_ge_U₁ : U₁ ≤ v := le_trans hu₀_ge_U₁ hv
        have htop_v := (hφp_top v hv_ge_U₁).2
        have huv : (1 + η / 4) * u₀ ≤ (1 - η / 4) * v := by nlinarith
        have hstep : -(1 - η / 4) * δ_plus * v ≤ -(1 + η / 4) * δ_plus * u₀ := by
          have := mul_le_mul_of_nonneg_left huv (le_of_lt hδp_pos)
          linarith
        exact le_trans htop_v (le_trans hstep hu_low)
    refine ⟨u, ?_, ?_⟩
    · refine ⟨by linarith [hu_mem.1], ?_, ?_⟩
      · intro v hvu
        by_cases hvu₀ : u₀ ≤ v
        · have hfp := hu_fut v hvu₀
          dsimp [φ_plus] at hfp
          nlinarith [hc₁, hP₁]
        · have hvu₀' : v < u₀ := lt_of_not_ge hvu₀
          have hfm := hu₀_past v (le_trans (le_of_lt hvu₀') hu₀_mem.2)
          have hfp := hu_fut u₀ le_rfl
          dsimp [φ_minus] at hfm
          dsimp [φ_plus] at hfp
          have hu₀u : u₀ ≤ u := hu_mem.1
          nlinarith [hc₁, hP₁]
      · intro v huv
        have hfp := hu_fut v (le_trans hu_mem.1 huv)
        dsimp [φ_plus] at hfp
        linarith
    · rw [abs_le]
      have hu1 : (1 - η) * w ≤ u := le_trans hu₀_mem.1 hu_mem.1
      have hu2 : u ≤ (1 + η) * w := by nlinarith [hu_mem.2, hu₀_mem.2]
      constructor <;> nlinarith
  exact ⟨hUpper, ⟨L₀, E, hL₀, fun u hu => hu.1, hDensity, hWit⟩⟩

theorem bad_tile_shadow_green_bound : BadTileShadowBoundProp :=
by
  
  
  
  have h_s1 : ∀ (N : ℕ) (x_T ρ_T : Fin N → ℝ), (∀ i : Fin N, 0 < ρ_T i) →
      ∃ S : Finset (Fin N),
        (∀ i ∈ S, ∀ j ∈ S, i ≠ j → (ρ_T i + ρ_T j) / 2 ≤ |x_T i - x_T j|) ∧
        MeasureTheory.volume.real
          (⋃ i : Fin N, Set.Icc (x_T i - ρ_T i / 2) (x_T i + ρ_T i / 2)) ≤
          3 * (∑ j ∈ S, ρ_T j) ∧
        (∀ m ∈ S, ∀ x : ℝ, |x - x_T m| ≤ ρ_T m / 8 →
          ∑ j ∈ S.erase m, ρ_T j / (x - x_T j) ^ 2 ≤ 6 / ρ_T m) := by
    intro N x_T ρ_T hρ_pos
    have h_vitali : ∀ (n : ℕ) (U : Finset (Fin N)), U.card = n →
        ∃ S ⊆ U,
          (∀ i ∈ S, ∀ j ∈ S, i ≠ j → (ρ_T i + ρ_T j) / 2 ≤ |x_T i - x_T j|) ∧
          (∀ i ∈ U, ∃ j ∈ S,
            Set.Icc (x_T i - ρ_T i / 2) (x_T i + ρ_T i / 2) ⊆
              Set.Icc (x_T j - 3 * ρ_T j / 2) (x_T j + 3 * ρ_T j / 2)) := by
      intro n
      induction n using Nat.strong_induction_on with
      | h n ih =>
        intro U hU_card
        by_cases hU : U.Nonempty
        · obtain ⟨j₀, hj₀_mem, hj₀_max⟩ := Finset.exists_max_image U ρ_T hU
          let C : Finset (Fin N) :=
            U.filter (fun i => |x_T i - x_T j₀| < (ρ_T i + ρ_T j₀) / 2)
          have hj₀_C : j₀ ∈ C := by
            rw [Finset.mem_filter]
            refine ⟨hj₀_mem, ?_⟩
            simp only [sub_self, abs_zero]
            linarith [hρ_pos j₀]
          have h_card_lt : (U \ C).card < n := by
            rw [← hU_card]
            exact Finset.card_lt_card
              ⟨Finset.sdiff_subset, fun h_sub => (Finset.mem_sdiff.mp (h_sub hj₀_mem)).2 hj₀_C⟩
          obtain ⟨S', hS'_sub, hS'_disj, hS'_cov⟩ := ih (U \ C).card h_card_lt (U \ C) rfl
          refine ⟨insert j₀ S',
            Finset.insert_subset_iff.mpr ⟨hj₀_mem, hS'_sub.trans Finset.sdiff_subset⟩, ?_, ?_⟩
          · intro i hi j hj hij
            rcases Finset.mem_insert.mp hi with rfl | hi'
            · rcases Finset.mem_insert.mp hj with rfl | hj'
              · exact False.elim (hij rfl)
              · have hj_sdiff := hS'_sub hj'
                rw [Finset.mem_sdiff, Finset.mem_filter] at hj_sdiff
                have h_not : ¬ (|x_T j - x_T i| < (ρ_T j + ρ_T i) / 2) :=
                  fun hlt => hj_sdiff.2 ⟨hj_sdiff.1, hlt⟩
                rw [abs_sub_comm]
                linarith
            · rcases Finset.mem_insert.mp hj with rfl | hj'
              · have hi_sdiff := hS'_sub hi'
                rw [Finset.mem_sdiff, Finset.mem_filter] at hi_sdiff
                have h_not : ¬ (|x_T i - x_T j| < (ρ_T i + ρ_T j) / 2) :=
                  fun hlt => hi_sdiff.2 ⟨hi_sdiff.1, hlt⟩
                linarith
              · exact hS'_disj i hi' j hj' hij
          · intro i hi
            by_cases hiC : i ∈ C
            · refine ⟨j₀, Finset.mem_insert_self j₀ S', ?_⟩
              rw [Finset.mem_filter] at hiC
              have h_le := hj₀_max i hi
              have h_abs := abs_lt.mp hiC.2
              intro t ht
              rw [Set.mem_Icc] at ht ⊢
              constructor <;> linarith
            · obtain ⟨j, hjS', hj_sub⟩ := hS'_cov i (Finset.mem_sdiff.mpr ⟨hi, hiC⟩)
              exact ⟨j, Finset.mem_insert_of_mem hjS', hj_sub⟩
        · rw [Finset.not_nonempty_iff_eq_empty] at hU
          subst hU
          refine ⟨∅, Finset.Subset.rfl, ?_, ?_⟩ <;> simp
    obtain ⟨S, -, hS_disj, hS_cov⟩ :=
      h_vitali (Finset.univ : Finset (Fin N)).card Finset.univ rfl
    have hS_meas : MeasureTheory.volume.real
        (⋃ i : Fin N, Set.Icc (x_T i - ρ_T i / 2) (x_T i + ρ_T i / 2)) ≤
        3 * (∑ j ∈ S, ρ_T j) := by
      let B : Set ℝ :=
        ⋃ j ∈ S, Set.Icc (x_T j - 3 * ρ_T j / 2) (x_T j + 3 * ρ_T j / 2)
      have hB_compact : IsCompact B := S.isCompact_biUnion (fun _ _ => isCompact_Icc)
      have hB_fin : MeasureTheory.volume B ≠ ⊤ := hB_compact.measure_lt_top.ne
      have h_sub_B : (⋃ i : Fin N, Set.Icc (x_T i - ρ_T i / 2) (x_T i + ρ_T i / 2)) ⊆ B := by
        intro t ht
        rw [Set.mem_iUnion] at ht
        obtain ⟨i, hti⟩ := ht
        obtain ⟨j, hjS, hj_sub⟩ := hS_cov i (Finset.mem_univ i)
        exact Set.mem_biUnion hjS (hj_sub hti)
      calc
        MeasureTheory.volume.real
            (⋃ i : Fin N, Set.Icc (x_T i - ρ_T i / 2) (x_T i + ρ_T i / 2)) ≤
            MeasureTheory.volume.real B := MeasureTheory.measureReal_mono h_sub_B hB_fin
        _ ≤ ∑ j ∈ S, MeasureTheory.volume.real
              (Set.Icc (x_T j - 3 * ρ_T j / 2) (x_T j + 3 * ρ_T j / 2)) :=
            MeasureTheory.measureReal_biUnion_finset_le S _
        _ = ∑ j ∈ S, (3 * ρ_T j) := by
            refine Finset.sum_congr rfl (fun j _ => ?_)
            rw [Real.volume_real_Icc_of_le (by linarith [hρ_pos j])]
            ring
        _ = 3 * (∑ j ∈ S, ρ_T j) := (Finset.mul_sum S _ 3).symm
    have h_tele : ∀ (n : ℕ) (T : Finset (Fin N)) (c_min : ℝ) (a_int b_int : Fin N → ℝ),
        T.card = n → 0 < c_min →
        (∀ j ∈ T, c_min ≤ a_int j ∧ a_int j < b_int j) →
        (∀ j ∈ T, ∀ l ∈ T, j ≠ l → b_int j ≤ a_int l ∨ b_int l ≤ a_int j) →
        ∑ j ∈ T, (1 / a_int j - 1 / b_int j) ≤ 1 / c_min := by
      intro n
      induction n using Nat.strong_induction_on with
      | h n ih =>
        intro T c_min a_int b_int hT_card hc_pos hab h_ord
        by_cases hT : T.Nonempty
        · obtain ⟨j₀, hj₀, hj₀_min⟩ := Finset.exists_min_image T a_int hT
          have h_card : (T.erase j₀).card < n := by
            rw [← hT_card]
            exact Finset.card_erase_lt_of_mem hj₀
          have ha₀_ge : c_min ≤ a_int j₀ := (hab j₀ hj₀).1
          have hab₀ : a_int j₀ < b_int j₀ := (hab j₀ hj₀).2
          have ha₀_pos : 0 < a_int j₀ := lt_of_lt_of_le hc_pos ha₀_ge
          have hb₀_pos : 0 < b_int j₀ := lt_trans ha₀_pos hab₀
          have h_rest : ∑ l ∈ T.erase j₀, (1 / a_int l - 1 / b_int l) ≤ 1 / b_int j₀ := by
            refine ih (T.erase j₀).card h_card (T.erase j₀) (b_int j₀) a_int b_int rfl hb₀_pos
              ?_ ?_
            · intro l hl
              obtain ⟨hl_ne, hl_mem⟩ := Finset.mem_erase.mp hl
              refine ⟨?_, (hab l hl_mem).2⟩
              rcases h_ord j₀ hj₀ l hl_mem (Ne.symm hl_ne) with h1 | h2
              · exact h1
              · linarith [hj₀_min l hl_mem, (hab l hl_mem).2]
            · intro j hj l hl hjl
              exact h_ord j (Finset.mem_of_mem_erase hj) l (Finset.mem_of_mem_erase hl) hjl
          have h_inv_le : 1 / a_int j₀ ≤ 1 / c_min := one_div_le_one_div_of_le hc_pos ha₀_ge
          rw [← Finset.add_sum_erase _ _ hj₀]
          linarith
        · rw [Finset.not_nonempty_iff_eq_empty] at hT
          subst hT
          simp only [Finset.sum_empty]
          positivity
    refine ⟨S, hS_disj, hS_meas, ?_⟩
    intro m hm x hx
    have hρm : 0 < ρ_T m := hρ_pos m
    let T_pos := (S.erase m).filter (fun j => x_T m < x_T j)
    let T_neg := (S.erase m).filter (fun j => ¬ x_T m < x_T j)
    have h_split : ∑ j ∈ S.erase m, ρ_T j / (x - x_T j) ^ 2 =
        (∑ j ∈ T_pos, ρ_T j / (x - x_T j) ^ 2) +
        (∑ j ∈ T_neg, ρ_T j / (x - x_T j) ^ 2) :=
      (Finset.sum_filter_add_sum_filter_not (S.erase m) (fun j => x_T m < x_T j) _).symm
    have h_pos_bound : ∑ j ∈ T_pos, ρ_T j / (x - x_T j) ^ 2 ≤ 8 / (3 * ρ_T m) := by
      let a_p : Fin N → ℝ := fun j => (x_T j - x) - ρ_T j / 2
      let b_p : Fin N → ℝ := fun j => (x_T j - x) + ρ_T j / 2
      have h_ab : ∀ j ∈ T_pos, 3 * ρ_T m / 8 ≤ a_p j ∧ a_p j < b_p j := by
        intro j hj
        obtain ⟨hj_er, hj_gt⟩ := Finset.mem_filter.mp hj
        obtain ⟨hj_ne, hj_S⟩ := Finset.mem_erase.mp hj_er
        have h_sep := hS_disj j hj_S m hm hj_ne
        rw [abs_of_pos (by linarith)] at h_sep
        have hx_ub : x - x_T m ≤ ρ_T m / 8 := (abs_le.mp hx).2
        constructor
        · dsimp [a_p]; linarith
        · dsimp [a_p, b_p]; linarith [hρ_pos j]
      have h_ord : ∀ j ∈ T_pos, ∀ l ∈ T_pos, j ≠ l → b_p j ≤ a_p l ∨ b_p l ≤ a_p j := by
        intro j hj l hl hjl
        have hj_S := Finset.mem_of_mem_erase (Finset.mem_of_mem_filter j hj)
        have hl_S := Finset.mem_of_mem_erase (Finset.mem_of_mem_filter l hl)
        have h_sep := hS_disj j hj_S l hl_S hjl
        rcases le_abs.mp h_sep with h1 | h2
        · right; dsimp [a_p, b_p]; linarith
        · left; dsimp [a_p, b_p]; linarith
      have h_term : ∀ j ∈ T_pos, ρ_T j / (x - x_T j) ^ 2 ≤ 1 / a_p j - 1 / b_p j := by
        intro j hj
        have ha_pos : 0 < a_p j := by linarith [(h_ab j hj).1]
        have hb_pos : 0 < b_p j := lt_trans ha_pos (h_ab j hj).2
        have h_prod_pos : 0 < a_p j * b_p j := mul_pos ha_pos hb_pos
        have h_prod_le : a_p j * b_p j ≤ (x - x_T j) ^ 2 := by
          have : (x - x_T j) ^ 2 - a_p j * b_p j = (ρ_T j / 2) ^ 2 := by
            dsimp [a_p, b_p]; ring
          nlinarith [sq_nonneg (ρ_T j / 2)]
        calc
          ρ_T j / (x - x_T j) ^ 2 ≤ ρ_T j / (a_p j * b_p j) :=
            div_le_div_of_nonneg_left (le_of_lt (hρ_pos j)) h_prod_pos h_prod_le
          _ = 1 / a_p j - 1 / b_p j := by
            have ha_ne : a_p j ≠ 0 := ne_of_gt ha_pos
            have hb_ne : b_p j ≠ 0 := ne_of_gt hb_pos
            field_simp [ha_ne, hb_ne]
            dsimp [a_p, b_p]; ring
      calc
        ∑ j ∈ T_pos, ρ_T j / (x - x_T j) ^ 2 ≤ ∑ j ∈ T_pos, (1 / a_p j - 1 / b_p j) :=
          Finset.sum_le_sum h_term
        _ ≤ 1 / (3 * ρ_T m / 8) :=
          h_tele T_pos.card T_pos (3 * ρ_T m / 8) a_p b_p rfl (by positivity) h_ab h_ord
        _ = 8 / (3 * ρ_T m) := by ring
    have h_neg_bound : ∑ j ∈ T_neg, ρ_T j / (x - x_T j) ^ 2 ≤ 8 / (3 * ρ_T m) := by
      let a_n : Fin N → ℝ := fun j => (x - x_T j) - ρ_T j / 2
      let b_n : Fin N → ℝ := fun j => (x - x_T j) + ρ_T j / 2
      have h_ab : ∀ j ∈ T_neg, 3 * ρ_T m / 8 ≤ a_n j ∧ a_n j < b_n j := by
        intro j hj
        obtain ⟨hj_er, hj_not_gt⟩ := Finset.mem_filter.mp hj
        obtain ⟨hj_ne, hj_S⟩ := Finset.mem_erase.mp hj_er
        have h_sep := hS_disj j hj_S m hm hj_ne
        have hj_lt : x_T j < x_T m := by
          rcases lt_trichotomy (x_T j) (x_T m) with hlt | heq | hgt
          · exact hlt
          · rw [heq, sub_self, abs_zero] at h_sep
            linarith [hρ_pos j]
          · exact False.elim (hj_not_gt hgt)
        rw [abs_of_neg (by linarith)] at h_sep
        have hx_lb : -(ρ_T m / 8) ≤ x - x_T m := (abs_le.mp hx).1
        constructor
        · dsimp [a_n]; linarith
        · dsimp [a_n, b_n]; linarith [hρ_pos j]
      have h_ord : ∀ j ∈ T_neg, ∀ l ∈ T_neg, j ≠ l → b_n j ≤ a_n l ∨ b_n l ≤ a_n j := by
        intro j hj l hl hjl
        have hj_S := Finset.mem_of_mem_erase (Finset.mem_of_mem_filter j hj)
        have hl_S := Finset.mem_of_mem_erase (Finset.mem_of_mem_filter l hl)
        have h_sep := hS_disj j hj_S l hl_S hjl
        rcases le_abs.mp h_sep with h1 | h2
        · left; dsimp [a_n, b_n]; linarith
        · right; dsimp [a_n, b_n]; linarith
      have h_term : ∀ j ∈ T_neg, ρ_T j / (x - x_T j) ^ 2 ≤ 1 / a_n j - 1 / b_n j := by
        intro j hj
        have ha_pos : 0 < a_n j := by linarith [(h_ab j hj).1]
        have hb_pos : 0 < b_n j := lt_trans ha_pos (h_ab j hj).2
        have h_prod_pos : 0 < a_n j * b_n j := mul_pos ha_pos hb_pos
        have h_prod_le : a_n j * b_n j ≤ (x - x_T j) ^ 2 := by
          have : (x - x_T j) ^ 2 - a_n j * b_n j = (ρ_T j / 2) ^ 2 := by
            dsimp [a_n, b_n]; ring
          nlinarith [sq_nonneg (ρ_T j / 2)]
        calc
          ρ_T j / (x - x_T j) ^ 2 ≤ ρ_T j / (a_n j * b_n j) :=
            div_le_div_of_nonneg_left (le_of_lt (hρ_pos j)) h_prod_pos h_prod_le
          _ = 1 / a_n j - 1 / b_n j := by
            have ha_ne : a_n j ≠ 0 := ne_of_gt ha_pos
            have hb_ne : b_n j ≠ 0 := ne_of_gt hb_pos
            field_simp [ha_ne, hb_ne]
            dsimp [a_n, b_n]; ring
      calc
        ∑ j ∈ T_neg, ρ_T j / (x - x_T j) ^ 2 ≤ ∑ j ∈ T_neg, (1 / a_n j - 1 / b_n j) :=
          Finset.sum_le_sum h_term
        _ ≤ 1 / (3 * ρ_T m / 8) :=
          h_tele T_neg.card T_neg (3 * ρ_T m / 8) a_n b_n rfl (by positivity) h_ab h_ord
        _ = 8 / (3 * ρ_T m) := by ring
    have h_16_3 : 16 / (3 * ρ_T m) ≤ 6 / ρ_T m := by
      have : 16 / (3 * ρ_T m) = (16 / 3 : ℝ) * (1 / ρ_T m) := by ring
      have : 6 / ρ_T m = (6 : ℝ) * (1 / ρ_T m) := by ring
      have : 0 < 1 / ρ_T m := by positivity
      linarith
    calc
      ∑ j ∈ S.erase m, ρ_T j / (x - x_T j) ^ 2 =
          (∑ j ∈ T_pos, ρ_T j / (x - x_T j) ^ 2) +
          (∑ j ∈ T_neg, ρ_T j / (x - x_T j) ^ 2) := h_split
      _ ≤ 8 / (3 * ρ_T m) + 8 / (3 * ρ_T m) := add_le_add h_pos_bound h_neg_bound
      _ = 16 / (3 * ρ_T m) := by ring
      _ ≤ 6 / ρ_T m := h_16_3

  
  
  
  have h_s2 : ∀ (a b K : ℝ), 1 ≤ a → a ≤ b → 0 < K →
      ∃ M_lat c_wit C_disk : ℝ, K + 1 < M_lat ∧ 0 < c_wit ∧ 0 < C_disk ∧
        ∀ (τ : ℝ) (N : ℕ) (x_T d_T ρ_T : Fin N → ℝ) (S : Finset (Fin N)),
          0 < τ → τ < 1 / 4 →
          (∀ j ∈ S, 0 < ρ_T j ∧ a * ρ_T j ≤ d_T j ∧ d_T j ≤ b * ρ_T j ∧
            d_T j ≤ 1 / 2 ∧ |x_T j| ≤ K ∧ τ < d_T j / 4) →
          (∀ j ∈ S, ∀ l ∈ S, j ≠ l → (ρ_T j + ρ_T l) / 2 ≤ |x_T j - x_T l|) →
          (∀ m ∈ S, ∀ x : ℝ, |x - x_T m| ≤ ρ_T m / 8 →
            ∑ j ∈ S.erase m, ρ_T j / (x - x_T j) ^ 2 ≤ 6 / ρ_T m) →
          ∃ V : ℂ → ℝ,
            ContinuousOn V
              ({ z : ℂ | |z.re| ≤ M_lat ∧ τ ≤ -z.im ∧ -z.im ≤ 2 } \
                ⋃ j ∈ S, Metric.ball ((x_T j : ℂ) - (d_T j : ℂ) * Complex.I) (ρ_T j / 8)) ∧
            (∀ z : ℂ, |z.re| ≤ M_lat → (-z.im = τ ∨ -z.im = 2) → V z ≤ 0) ∧
            (∀ z : ℂ, |z.re| = M_lat → τ ≤ -z.im → -z.im ≤ 2 → V z ≤ 0) ∧
            (∀ m ∈ S, ∀ z ∈ Metric.sphere ((x_T m : ℂ) - (d_T m : ℂ) * Complex.I) (ρ_T m / 8),
              V z ≤ C_disk) ∧
            c_wit * (∑ j ∈ S, ρ_T j) ≤ V (-Complex.I) ∧
            (∀ z₀ : ℂ, ∀ r : ℝ, 0 < r →
              Metric.closedBall z₀ r ⊆
                ({ z : ℂ | |z.re| < M_lat ∧ τ < -z.im ∧ -z.im < 2 } \
                  ⋃ j ∈ S,
                    Metric.closedBall ((x_T j : ℂ) - (d_T j : ℂ) * Complex.I) (ρ_T j / 8)) →
              Real.circleAverage V z₀ r = V z₀) := by
    intro a b K ha hab hK
    have ha_pos : 0 < a := by linarith
    have hb_ge_one : 1 ≤ b := le_trans ha hab
    have hb_pos : 0 < b := by linarith
