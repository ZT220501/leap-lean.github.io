      exact Real.sqrt_pos.mpr (by positivity)
    have hC_pos : 0 < C_sf := by positivity
    have hη_sq : η_sf ^ 2 ≤ δ_Q / 8 := by
      have hle : η_sf ≤ Real.sqrt (δ_Q / 8) := le_trans (min_le_left _ _) (min_le_left _ _)
