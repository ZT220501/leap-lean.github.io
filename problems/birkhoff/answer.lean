      have hCont_d : ContinuousAt (fun t : ℂ => iterDerivYT 1 0 F₁ (y_hit t, t)) 0 := by
        have hc0 : ContinuousAt (iterDerivYT 1 0 F₁) (y_hit 0, 0) := by
