    intro q hq
    have hzero := cancel_holo_of_ne_zero
      Metric.isOpen_ball (convex_ball p η).isPreconnected hΔ_holo
      Metric.isOpen_ball (convex_ball p (F.rad p)).isPreconnected
      (F.den_holo p hp_F) (F.den_ne_zero p hp_F)
      Metric.isOpen_ball ⟨p, Metric.mem_ball_self hη_pos⟩
      Set.Subset.rfl (Metric.ball_subset_ball hη_le_F)
      hprod_zero q hq
    exact sub_eq_zero.mp hzero

  · 
