        field_simp [hne]
      rw [h2, h1]
      field_simp [hne]
    have hm₀_lim : ∀ i : Fin k, Filter.Tendsto (fun δ : ℝ => m₀ δ i) φ (nhds (v_a : ℂ)) := by
      intro i
      have hF'_lim : Filter.Tendsto (fun δ : ℝ => deriv F (x₀ δ i.castSucc)) φ (nhds (v_a : ℂ)) := by
