      fun i m => (M.g_holo i m).deriv M.W_n_open
    have hg'_lt_p : ∀ i (m : Fin (J + 1)), (m : ℕ) < p → ∀ z ∈ M.W_n, deriv (M.g i m) z = 0 := by
      intro i m hm z hz
      have hev : M.g i m =ᶠ[nhds z] (fun _ => (0 : ℂ)) :=
        Filter.eventuallyEq_of_mem (M.W_n_open.mem_nhds hz) (fun w hw => M.g_lt_p i m hm w hw)
