          (fun z => z + ((η * c : ℝ) : ℂ) * H₁ z)
          (fun z => z + ((η * c : ℝ) : ℂ) * H₂ z)
          hOpenσ hConvσ (le_of_lt hM) hΔW_nn (by norm_num) hΔH hdW₁.1 hdW₂.1
