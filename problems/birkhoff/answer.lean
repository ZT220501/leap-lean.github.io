      have hExp : ‖Complex.exp (-2 * (W (X₀ + (s : ℂ) * ((t : ℂ) * Y₀)) - W X₀))‖ ≤
          Real.exp (4 * M₁) := by
        rw [Complex.norm_exp, Real.exp_le_exp]
        have hre := Complex.re_le_norm (-2 * (W (X₀ + (s : ℂ) * ((t : ℂ) * Y₀)) - W X₀))
        have hmul : ‖-2 * (W (X₀ + (s : ℂ) * ((t : ℂ) * Y₀)) - W X₀)‖ =
