          (fun r : ℝ => r * (2 * Real.pi * g z₀))
          (Set.Ioo (0 : ℝ) R) MeasureTheory.volume :=
        ((continuous_id.mul continuous_const).continuousOn.integrableOn_compact isCompact_Icc).mono_set
          Set.Ioo_subset_Icc_self
      have houter_le : (∫ r in Set.Ioo (0 : ℝ) R,
            ∫ θ in Set.Ioo (-Real.pi) Real.pi, r * g (circleMap z₀ r θ)) ≤
          (∫ r in Set.Ioo (0 : ℝ) R, r * (2 * Real.pi * g z₀)) :=
        MeasureTheory.setIntegral_mono_on h_lhs_int h_rhs_int measurableSet_Ioo hinner_le
      have hrhs_eval : (∫ r in Set.Ioo (0 : ℝ) R, r * (2 * Real.pi * g z₀)) =
