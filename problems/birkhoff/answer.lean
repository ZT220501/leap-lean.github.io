        dsimp [W_poly]
        exact ⟨Polynomial.monic_one, Polynomial.natDegree_one⟩
      | cons α L ih =>
        have hcons : W_poly (α :: L) = (Polynomial.X - Polynomial.C α) * W_poly L := by
          simp [W_poly]
        rw [hcons, List.length_cons]
        have hm_lin : (Polynomial.X - Polynomial.C α).Monic := Polynomial.monic_X_sub_C α
