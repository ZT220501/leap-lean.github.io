                ((n.centralBinom : ℝ) / (4 : ℝ) ^ n) := by
          rw [pow_succ]
          field_simp [hn1_ne, h4_ne]
          nlinarith [hrec_real]
        rw [hstep]
        push_cast
        have hfrac :
            (2 * ((n : ℝ) + 1) + 1) * ((2 * (n : ℝ) + 1) / (2 * (n : ℝ) + 2)) ^ 2 ≤
              2 * (n : ℝ) + 1 := by
          have hden_pos : (0 : ℝ) < (2 * (n : ℝ) + 2) ^ 2 := by positivity
          rw [div_pow, mul_div_assoc', div_le_iff₀ hden_pos]
          have h_expand :
              (2 * (n : ℝ) + 1) * (2 * (n : ℝ) + 2) ^ 2 -
