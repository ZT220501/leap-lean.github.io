      refine Real.exp_le_exp.mpr ?_
      dsimp only [sliceLogDepth] at h_log_depth
      linarith
    have h_sp_le : r_y * ‖deriv (sliceImpactSeq S P.N j.val) y‖ ≤ 2 * Real.exp (-H_star / 2) :=
      le_trans (h_sp_site j) (by linarith)
    let f_j : ℂ := sliceSpeedSeq S P.N j.val y
    have hf_j_ne : f_j ≠ 0 := P.reg_speed_ne_zero y hy j
    have hz_f2_eq : z j * f_j ^ 2 =
        (S.c : ℂ) * Complex.sin (P.d0 j y) * ((r_y : ℂ) * deriv (sliceImpactSeq S P.N j.val) y) := by
      have hf2_inv : f_j⁻¹ ^ 2 * f_j ^ 2 = 1 := by
        rw [← mul_pow, inv_mul_cancel₀ hf_j_ne, one_pow]
      change (r_y : ℂ) *
          ((S.c : ℂ) * Complex.sin (P.d0 j y) * f_j⁻¹ ^ 2 *
            deriv (sliceImpactSeq S P.N j.val) y) *
          f_j ^ 2 =
        (S.c : ℂ) * Complex.sin (P.d0 j y) * ((r_y : ℂ) * deriv (sliceImpactSeq S P.N j.val) y)
      calc
        (r_y : ℂ) *
            ((S.c : ℂ) * Complex.sin (P.d0 j y) * f_j⁻¹ ^ 2 *
