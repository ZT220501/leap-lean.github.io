    have hG_diffAt : ∀ s₀ ∈ R_box, DifferentiableAt ℂ G s₀ := by
      intro s₀ hs₀_box
      have hs₀_U : s₀ ∈ U := hRU hs₀_box
      by_cases hs₀_S : s₀ ∈ S_int
      · have hfs₀ : f s₀ = 0 := ((hS_mem s₀).mp hs₀_S).2
        obtain ⟨ha₀_ne, hf''_zero⟩ := hsimple s₀ hs₀_U hfs₀
        let a₀ : ℂ := deriv f s₀
        let g₁ : ℂ → ℂ := dslope f s₀
        let g₂ : ℂ → ℂ := dslope g₁ s₀
        let g₃ : ℂ → ℂ := dslope g₂ s₀
        have hg₁_diff : DifferentiableOn ℂ g₁ U :=
          (Complex.differentiableOn_dslope (hU.mem_nhds hs₀_U)).mpr hf
        have hg₂_diff : DifferentiableOn ℂ g₂ U :=
          (Complex.differentiableOn_dslope (hU.mem_nhds hs₀_U)).mpr hg₁_diff
        have hg₃_diff : DifferentiableOn ℂ g₃ U :=
          (Complex.differentiableOn_dslope (hU.mem_nhds hs₀_U)).mpr hg₂_diff
        have hg₁_s₀ : g₁ s₀ = a₀ := dslope_same f s₀
