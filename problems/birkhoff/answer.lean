      ring
    have h_signedJ_slit : ∀ (L : List ℂ) (hL : L ≠ []) (p : ℂ) (hp : p ∈ meshPolyTrace L)
        (q : ℂ) (hq : q ∈ meshPolyTrace L) (c₀ : ℂ),
        c₀ ≠ 0 →
        (∀ w ∈ meshPolyTrace L, 0 < (c₀ * (w - z₀)).re) →
