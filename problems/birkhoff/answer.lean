      have hYL_div : ΔY₀ δ i_L / ℓ₀ δ i_L = m₀ δ i_L / pculSlopeSpeed v_a (m₀ δ i_L) := by
        rw [hℓL_eq]; dsimp [m₀]; field_simp [hdxL_ne, (hσ_props _ hmL_b).2.1]
      have hYR_div : ΔY₀ δ i_R / ℓ₀ δ i_R = m₀ δ i_R / pculSlopeSpeed v_a (m₀ δ i_R) := by
        rw [hℓR_eq]; dsimp [m₀]; field_simp [hdxR_ne, (hσ_props _ hmR_b).2.1]
      have hgq := hgamma_quot_eq (m₀ δ i_L) hmL_b (m₀ δ i_R) hmR_b
      have hnumL :
          (1 + deriv F (x₀ δ i_L.succ) ^ 2 + ΔY₀ δ i_L * deriv (deriv F) (x₀ δ i_L.succ)) *
              (ℓ₀ δ i_L) ^ 2 -
            (Δx₀ δ i_L + ΔY₀ δ i_L * deriv F (x₀ δ i_L.succ)) ^ 2 =
          (ΔY₀ δ i_L - deriv F (x₀ δ i_L.succ) * Δx₀ δ i_L) ^ 2 +
            deriv (deriv F) (x₀ δ i_L.succ) * ΔY₀ δ i_L * (ℓ₀ δ i_L) ^ 2 := by
        rw [hℓL_sq]; ring
      have hnumR :
          (1 + deriv F (x₀ δ i_R.castSucc) ^ 2 -
              ΔY₀ δ i_R * deriv (deriv F) (x₀ δ i_R.castSucc)) * (ℓ₀ δ i_R) ^ 2 -
            (Δx₀ δ i_R + ΔY₀ δ i_R * deriv F (x₀ δ i_R.castSucc)) ^ 2 =
          (ΔY₀ δ i_R - deriv F (x₀ δ i_R.castSucc) * Δx₀ δ i_R) ^ 2 -
            deriv (deriv F) (x₀ δ i_R.castSucc) * ΔY₀ δ i_R * (ℓ₀ δ i_R) ^ 2 := by
        rw [hℓR_sq]; ring
      dsimp only [i_L, i_R] at hnumL hnumR hYL_div hYR_div ⊢
      change ((δ : ℂ)⁻¹) *
            ((ΔY₀ δ i_L - deriv F (x₀ δ i_L.succ) * Δx₀ δ i_L) ^ 2 / (ℓ₀ δ i_L) ^ 3) +
          ((δ : ℂ)⁻¹) *
            ((ΔY₀ δ i_R - deriv F (x₀ δ i_R.castSucc) * Δx₀ δ i_R) ^ 2 / (ℓ₀ δ i_R) ^ 3) +
          deriv (deriv F) (x₀ δ i_L.succ) *
            (((m₀ δ i_L - deriv F (x₀ δ i_L.succ)) / (δ : ℂ) -
                (m₀ δ i_R - deriv F (x₀ δ i_L.succ)) / (δ : ℂ)) *
              pculGammaQuot v_a (m₀ δ i_L) (m₀ δ i_R)) =
        ((δ : ℂ)⁻¹) *
          ((((1 + deriv F (x₀ δ i_L.succ) ^ 2 + ΔY₀ δ i_L * deriv (deriv F) (x₀ δ i_L.succ)) *
                (ℓ₀ δ i_L) ^ 2 -
              (Δx₀ δ i_L + ΔY₀ δ i_L * deriv F (x₀ δ i_L.succ)) ^ 2) / (ℓ₀ δ i_L) ^ 3) +
            (((1 + deriv F (x₀ δ i_R.castSucc) ^ 2 -
                  ΔY₀ δ i_R * deriv (deriv F) (x₀ δ i_R.castSucc)) * (ℓ₀ δ i_R) ^ 2 -
                (Δx₀ δ i_R + ΔY₀ δ i_R * deriv F (x₀ δ i_R.castSucc)) ^ 2) / (ℓ₀ δ i_R) ^ 3))
      rw [hnumL, hnumR, h_shared]
      have h_split :
          ((ΔY₀ δ i_L - deriv F (x₀ δ i_L.succ) * Δx₀ δ i_L) ^ 2 +
              deriv (deriv F) (x₀ δ i_L.succ) * ΔY₀ δ i_L * (ℓ₀ δ i_L) ^ 2) / (ℓ₀ δ i_L) ^ 3 +
          ((ΔY₀ δ i_R - deriv F (x₀ δ i_L.succ) * Δx₀ δ i_R) ^ 2 -
              deriv (deriv F) (x₀ δ i_L.succ) * ΔY₀ δ i_R * (ℓ₀ δ i_R) ^ 2) / (ℓ₀ δ i_R) ^ 3 =
          (ΔY₀ δ i_L - deriv F (x₀ δ i_L.succ) * Δx₀ δ i_L) ^ 2 / (ℓ₀ δ i_L) ^ 3 +
          (ΔY₀ δ i_R - deriv F (x₀ δ i_L.succ) * Δx₀ δ i_R) ^ 2 / (ℓ₀ δ i_R) ^ 3 +
          deriv (deriv F) (x₀ δ i_L.succ) * (ΔY₀ δ i_L / ℓ₀ δ i_L - ΔY₀ δ i_R / ℓ₀ δ i_R) := by
        field_simp [hℓL_ne, hℓR_ne]; ring
      rw [h_split, hYL_div, hYR_div, hgq]
      field_simp [hδ_ne]
      ring
    · simp only [hrs, ↓reduceIte]
      by_cases hsr1 : s.1 = r.1 + 1
      · simp only [hsr1, true_or, ↓reduceIte, mul_neg, mul_one, neg_neg]
        exact h_offdiag_edge i_R
      · simp only [hsr1, false_or, ↓reduceIte]
        by_cases hrs1 : r.1 = s.1 + 1
        · have h_ite : (if r.1 = s.1 + 1 then (-1 : ℂ) else 0) = -1 := by split_ifs; rfl
          rw [h_ite]
          simp only [mul_neg, mul_one, neg_neg]
          refine (h_offdiag_edge i_L).congr' (Filter.Eventually.of_forall fun δ => ?_)
          dsimp only [Δx₀, ΔY₀, i_L]
          split_ifs
          ring
        · simp [hrs1]

  
  
  
  · intro L_max u₀ b_hat b_lim hx₀_u₀ hu₀_lim hb_lim U_fam U_lim Z_lim x_τ ε_τ
    
    have hU_lim_cont : ∀ r : Fin (k + 1), Continuous (fun e : ℂ => U_lim e r) := by
      intro r
      dsimp only [U_lim]
      exact continuous_const.add
        (continuous_finsetSum _ fun m _ => (continuous_pow m).mul continuous_const)
    have hZ_lim_cont : ∀ i : Fin k, Continuous (fun e : ℂ => Z_lim e i) :=
      fun i => (hU_lim_cont i.succ).sub (hU_lim_cont i.castSucc)
    have hZ_lim_zero : ∀ i : Fin k, Z_lim 0 i = 1 / (k : ℂ) := by
      intro i
      have hU0 : ∀ r : Fin (k + 1), U_lim 0 r = ((r : ℕ) : ℂ) / (k : ℂ) := by
        intro r
        dsimp only [U_lim]
        have hsum0 : (∑ m ∈ Finset.Icc 1 L_max, (0 : ℂ) ^ m * b_lim m r) = 0 := by
          apply Finset.sum_eq_zero
          intro m hm
          rw [Finset.mem_Icc] at hm
          rw [zero_pow (by omega : m ≠ 0), zero_mul]
        rw [hsum0, add_zero]
      dsimp only [Z_lim]
      rw [hU0, hU0]
      simp only [Fin.val_succ, Fin.val_castSucc, Nat.cast_add, Nat.cast_one]
      ring
    have hZ_disk_ev : ∀ᶠ e in nhds (0 : ℂ), ∀ i : Fin k,
        ‖Z_lim e i - 1 / (k : ℂ)‖ < 1 / (8 * (k : ℝ)) ∧
        ‖(k : ℂ) ^ 2 * (Z_lim e i) ^ 2 - 1‖ < δ_sq / 2 := by
      rw [Filter.eventually_all]
      intro i
      have hc1 : ContinuousAt (fun e : ℂ => ‖Z_lim e i - 1 / (k : ℂ)‖) 0 :=
        ((hZ_lim_cont i).sub continuous_const).norm.continuousAt
      have hv1 : ‖Z_lim 0 i - 1 / (k : ℂ)‖ < 1 / (8 * (k : ℝ)) := by
        rw [hZ_lim_zero i, sub_self, norm_zero]
        positivity
      have hc2 : ContinuousAt (fun e : ℂ => ‖(k : ℂ) ^ 2 * (Z_lim e i) ^ 2 - 1‖) 0 :=
        ((continuous_const.mul ((hZ_lim_cont i).pow 2)).sub continuous_const).norm.continuousAt
      have hv2 : ‖(k : ℂ) ^ 2 * (Z_lim 0 i) ^ 2 - 1‖ < δ_sq / 2 := by
        rw [hZ_lim_zero i]
        have h1 : (k : ℂ) ^ 2 * (1 / (k : ℂ)) ^ 2 - 1 = 0 := by
          field_simp [hk_ne]; ring
        rw [h1, norm_zero]
        exact half_pos hδ_sq_pos
      exact (hc1.eventually (gt_mem_nhds hv1)).and (hc2.eventually (gt_mem_nhds hv2))
    obtain ⟨ρ₀, hρ₀_pos, hρ₀⟩ := Metric.mem_nhds_iff.mp hZ_disk_ev
    let ρ_e : ℝ := min (1 / 2) ρ₀
    have hρ_e_pos : 0 < ρ_e := lt_min (by norm_num) hρ₀_pos
    have hρ_e_lt_one : ρ_e < 1 := lt_of_le_of_lt (min_le_left _ _) (by norm_num)
    let D : Set ℂ := Metric.ball (0 : ℂ) ρ_e
    have hZ_lim_props : ∀ e ∈ D, ∀ i : Fin k,
        7 / (8 * (k : ℝ)) ≤ (Z_lim e i).re ∧
        7 / (8 * (k : ℝ)) ≤ ‖Z_lim e i‖ ∧
        Z_lim e i ≠ 0 ∧
        ‖(k : ℂ) ^ 2 * (Z_lim e i) ^ 2 - 1‖ < δ_sq / 2 := by
      intro e he i
      rcases hρ₀ (Metric.ball_subset_ball (min_le_right _ _) he) i with ⟨h1, h2⟩
      have hre_diff : |(Z_lim e i - 1 / (k : ℂ)).re| ≤ ‖Z_lim e i - 1 / (k : ℂ)‖ :=
        Complex.abs_re_le_norm _
      have hre_k : (1 / (k : ℂ)).re = 1 / (k : ℝ) := by
        have : (1 / (k : ℂ)) = ((1 / (k : ℝ) : ℝ) : ℂ) := by push_cast; rfl
        rw [this, Complex.ofReal_re]
      have hre_lb : 7 / (8 * (k : ℝ)) ≤ (Z_lim e i).re := by
        have h_lo := (abs_le.mp hre_diff).1
        rw [Complex.sub_re, hre_k] at h_lo
        have hk_id : 1 / (k : ℝ) - 1 / (8 * (k : ℝ)) = 7 / (8 * (k : ℝ)) := by ring
        linarith
      have hnorm_lb : 7 / (8 * (k : ℝ)) ≤ ‖Z_lim e i‖ :=
        le_trans hre_lb (le_trans (le_abs_self _) (Complex.abs_re_le_norm _))
      have hpos : (0 : ℝ) < 7 / (8 * (k : ℝ)) := by positivity
      have hne : Z_lim e i ≠ 0 := by
        intro h0
        rw [h0, norm_zero] at hnorm_lb
        linarith
      exact ⟨hre_lb, hnorm_lb, hne, h2⟩

    refine ⟨ρ_e, hρ_e_pos, fun e he i => (hZ_lim_props e he i).2.2.1, ?_⟩

    
    have u_const : ∀ c : ℂ, PculUnifBdd φ D (fun _ _ => c) (fun _ => c) := by
      intro c
      refine ⟨?_, ‖c‖, norm_nonneg c, fun _ _ => le_rfl⟩
      rw [Metric.tendstoUniformlyOn_iff]
      intro ε hε
      exact Filter.Eventually.of_forall fun _ _ _ => by simpa using hε
    have u_param : ∀ {a_τ : ℝ → ℂ} {a₀ : ℂ},
        Filter.Tendsto a_τ φ (nhds a₀) →
        PculUnifBdd φ D (fun τ _ => a_τ τ) (fun _ => a₀) := by
      intro a_τ a₀ ha
      refine ⟨?_, ‖a₀‖, norm_nonneg a₀, fun _ _ => le_rfl⟩
      rw [Metric.tendstoUniformlyOn_iff]
      intro ε hε
      exact (Metric.tendsto_nhds.mp ha ε hε).mono fun τ hτ _ _ => by
        rwa [dist_comm]
    have u_pow_e : ∀ m : ℕ, PculUnifBdd φ D (fun _ e => e ^ m) (fun e => e ^ m) := by
      intro m
      refine ⟨?_, 1, zero_le_one, fun e he => ?_⟩
      · rw [Metric.tendstoUniformlyOn_iff]
        intro ε hε
        exact Filter.Eventually.of_forall fun _ _ _ => by simpa using hε
      · rw [Metric.mem_ball, dist_zero_right] at he
        rw [norm_pow]
        exact pow_le_one₀ (norm_nonneg e) (le_of_lt (lt_trans he hρ_e_lt_one))
    have u_add : ∀ {A B : ℝ → ℂ → ℂ} {A₀ B₀ : ℂ → ℂ},
        PculUnifBdd φ D A A₀ → PculUnifBdd φ D B B₀ →
        PculUnifBdd φ D (fun τ e => A τ e + B τ e) (fun e => A₀ e + B₀ e) := by
      rintro A B A₀ B₀ ⟨hA, MA, hMA0, hMA⟩ ⟨hB, MB, hMB0, hMB⟩
      refine ⟨?_, MA + MB, add_nonneg hMA0 hMB0, fun e he =>
        le_trans (norm_add_le _ _) (add_le_add (hMA e he) (hMB e he))⟩
      rw [Metric.tendstoUniformlyOn_iff] at hA hB ⊢
      intro ε hε
      refine ((hA (ε / 2) (half_pos hε)).and (hB (ε / 2) (half_pos hε))).mono
        fun τ ⟨h1, h2⟩ e he => ?_
      have d1 := h1 e he
      have d2 := h2 e he
      rw [Complex.dist_eq] at d1 d2 ⊢
      have htri : ‖(A₀ e + B₀ e) - (A τ e + B τ e)‖ ≤
          ‖A₀ e - A τ e‖ + ‖B₀ e - B τ e‖ := by
        simpa [add_sub_add_comm] using norm_add_le (A₀ e - A τ e) (B₀ e - B τ e)
      linarith
    have u_neg : ∀ {A : ℝ → ℂ → ℂ} {A₀ : ℂ → ℂ},
        PculUnifBdd φ D A A₀ →
        PculUnifBdd φ D (fun τ e => -A τ e) (fun e => -A₀ e) := by
      rintro A A₀ ⟨hA, MA, hMA0, hMA⟩
      refine ⟨?_, MA, hMA0, fun e he => by simpa using hMA e he⟩
      rw [Metric.tendstoUniformlyOn_iff] at hA ⊢
      intro ε hε
      refine (hA ε hε).mono fun τ h1 e he => ?_
      have d1 := h1 e he
      rw [Complex.dist_eq] at d1 ⊢
      have heq : -A₀ e - -A τ e = -(A₀ e - A τ e) := by ring
      rw [heq, norm_neg]
      exact d1
    have u_sub : ∀ {A B : ℝ → ℂ → ℂ} {A₀ B₀ : ℂ → ℂ},
        PculUnifBdd φ D A A₀ → PculUnifBdd φ D B B₀ →
        PculUnifBdd φ D (fun τ e => A τ e - B τ e) (fun e => A₀ e - B₀ e) := by
      intro A B A₀ B₀ hA hB
      simpa only [sub_eq_add_neg] using u_add hA (u_neg hB)
    have u_mul : ∀ {A B : ℝ → ℂ → ℂ} {A₀ B₀ : ℂ → ℂ},
        PculUnifBdd φ D A A₀ → PculUnifBdd φ D B B₀ →
        PculUnifBdd φ D (fun τ e => A τ e * B τ e) (fun e => A₀ e * B₀ e) := by
      rintro A B A₀ B₀ ⟨hA, MA, hMA0, hMA⟩ ⟨hB, MB, hMB0, hMB⟩
      refine ⟨?_, MA * MB, mul_nonneg hMA0 hMB0, fun e he => ?_⟩
      · rw [Metric.tendstoUniformlyOn_iff] at hA hB ⊢
        intro ε hε
        let C : ℝ := MA + MB + 2
        have hC_pos : 0 < C := by dsimp [C]; linarith
        let η : ℝ := min 1 (ε / C)
        have hη_pos : 0 < η := lt_min zero_lt_one (div_pos hε hC_pos)
        refine ((hA η hη_pos).and (hB η hη_pos)).mono fun τ ⟨h1, h2⟩ e he => ?_
        have d1 := h1 e he
        have d2 := h2 e he
        rw [Complex.dist_eq] at d1 d2 ⊢
        have hAe_le : ‖A₀ e‖ ≤ MA := hMA e he
        have hBe_le : ‖B₀ e‖ ≤ MB := hMB e he
        have hη1 : η ≤ 1 := min_le_left _ _
        have hηC : η * (MA + MB + 1) < ε := by
          have hle : η ≤ ε / C := min_le_right _ _
          have hlt : (ε / C) * (MA + MB + 1) < ε := by
            rw [div_mul_eq_mul_div, div_lt_iff₀ hC_pos]
            dsimp [C]; nlinarith
          have hnn : 0 ≤ MA + MB + 1 := by linarith
          exact lt_of_le_of_lt (mul_le_mul_of_nonneg_right hle hnn) hlt
        have hBτ_le : ‖B τ e‖ ≤ MB + 1 := by
          have htri : ‖B τ e‖ ≤ ‖B₀ e‖ + ‖B₀ e - B τ e‖ := by
            have := norm_sub_le (B₀ e) (B₀ e - B τ e)
            simpa using this
          linarith
        have hsplit : A₀ e * B₀ e - A τ e * B τ e =
            (A₀ e - A τ e) * B τ e + A₀ e * (B₀ e - B τ e) := by ring
        rw [hsplit]
        calc ‖(A₀ e - A τ e) * B τ e + A₀ e * (B₀ e - B τ e)‖
            ≤ ‖(A₀ e - A τ e) * B τ e‖ + ‖A₀ e * (B₀ e - B τ e)‖ := norm_add_le _ _
          _ = ‖A₀ e - A τ e‖ * ‖B τ e‖ + ‖A₀ e‖ * ‖B₀ e - B τ e‖ := by
              rw [norm_mul, norm_mul]
          _ ≤ η * (MB + 1) + MA * η := by
              nlinarith [norm_nonneg (A₀ e - A τ e), norm_nonneg (B τ e),
                norm_nonneg (A₀ e), norm_nonneg (B₀ e - B τ e)]
          _ = η * (MA + MB + 1) := by ring
          _ < ε := hηC
      · rw [norm_mul]
        exact mul_le_mul (hMA e he) (hMB e he) (norm_nonneg _) hMA0
    have u_sum : ∀ {ι : Type} (s : Finset ι) (A : ι → ℝ → ℂ → ℂ) (A₀ : ι → ℂ → ℂ),
