      have hu_nn : ∀ n : ℕ, 0 ≤ L.c n * (ρ_star + δ / 2) ^ n :=
        fun n => mul_nonneg (L.c_nonneg n) (pow_nonneg (by positivity) n)
      let u_nn : ℕ → NNReal := fun n => ⟨L.c n * (ρ_star + δ / 2) ^ n, hu_nn n⟩
      have hu_coe : ∀ n : ℕ, (u_nn n : ENNReal) = ENNReal.ofReal (L.c n * (ρ_star + δ / 2) ^ n) := by
        intro n
        exact (ENNReal.ofReal_eq_coe_nnreal (hu_nn n)).symm
      have h_tsum_ne_top : (∑' n : ℕ, (u_nn n : ENNReal)) ≠ ⊤ := by
        have h_eq : (∑' n : ℕ, (u_nn n : ENNReal)) = ENNReal.ofReal (∑' k : ℕ, b_seq k) := by
          calc (∑' n : ℕ, (u_nn n : ENNReal))
              = ∑' n : ℕ, ∑' k : ℕ, T_mat k n := by
                  congr 1; ext n; rw [hu_coe n, h_col_eq n]
