                    rw [← Finset.mul_sum]
                _ = (‖t‖ * (C_J * B ^ 2 * ‖t‖ ^ 2)) * ∑ i ∈ Finset.range j, gP i := by
                    rw [h_refl_P]
                _ ≤ ((t.im / γ_steep) * (C_J * B ^ 2 * ‖t‖ ^ 2)) *
                      ∑ i ∈ Finset.range j, gP i := by
                    refine mul_le_mul_of_nonneg_right ?_
                      (Finset.sum_nonneg (fun i _ => Real.rpow_nonneg (by positivity) _))
                    exact mul_le_mul_of_nonneg_right ht_le_im (by positivity)
                _ = (C_J * B ^ 2 * ‖t‖ ^ 2 / γ_steep) *
                      (t.im * ∑ i ∈ Finset.range j, gP i) := by ring
                _ ≤ (C_J * B ^ 2 * ‖t‖ ^ 2 / γ_steep) *
                      ((D (j + 2)) ^ (1 - 2 * α) / (2 * α - 1)) :=
                    mul_le_mul_of_nonneg_left h_mesh_P (by positivity)
                _ = (C_J * (1 / ((2 * α - 1) * γ_steep))) * B ^ 2 * ‖t‖ ^ 2 *
                      (D (j + 2)) ^ (1 - 2 * α) := by
