        let i₀ : Fin L_vert := ⟨k, Nat.lt_of_succ_lt hk1⟩
        let i₁ : Fin L_vert := ⟨k + 1, hk1⟩
        obtain ⟨p_m1, ⟨hp_m1_B0, hp_m1_B1⟩, hp_m1_exc1⟩ :=
