    have hIntCont : Continuous (fun p : ℝ × ℝ × ℝ =>
        ∫ θ in (0 : ℝ)..1,
          (midpoint_ℝ w p.1 p.2.1 - p.2.2) *
            (Real.sin (primPhi_ℝ w (p.2.2 + θ * (midpoint_ℝ w p.1 p.2.1 - p.2.2)) -
                primPhi_ℝ w p.1) *
              Real.exp (-2 * w (p.2.2 + θ * (midpoint_ℝ w p.1 p.2.1 - p.2.2))))) :=
      (hParamContDiff 0
        (fun q : (ℝ × ℝ × ℝ) × ℝ =>
          (midpoint_ℝ w q.1.1 q.1.2.1 - q.1.2.2) *
            (Real.sin (primPhi_ℝ w (q.1.2.2 + q.2 * (midpoint_ℝ w q.1.1 q.1.2.1 - q.1.2.2)) -
                primPhi_ℝ w q.1.1) *
              Real.exp (-2 * w (q.1.2.2 + q.2 * (midpoint_ℝ w q.1.1 q.1.2.1 - q.1.2.2)))))
        (contDiff_zero.mpr (by fun_prop))).continuous
    fun_prop

  have hKp_cont : Continuous (fun p : ℝ × ℝ × ℝ => cellKernelPlus_ℝ w p.1 p.2.1 p.2.2) := by
    have hEq : (fun p : ℝ × ℝ × ℝ => cellKernelPlus_ℝ w p.1 p.2.1 p.2.2) =
        fun p : ℝ × ℝ × ℝ =>
          2 * (1 - Real.cos (primPhi_ℝ w p.2.1 - primPhi_ℝ w p.2.2)) * Real.exp (-2 * w p.2.2) -
            Real.exp (w p.2.2) * ∫ θ in (0 : ℝ)..1,
              (p.2.2 - midpoint_ℝ w p.1 p.2.1) *
                (Real.sin (primPhi_ℝ w p.2.1 -
                    primPhi_ℝ w (midpoint_ℝ w p.1 p.2.1 + θ * (p.2.2 - midpoint_ℝ w p.1 p.2.1))) *
                  Real.exp (-2 * w (midpoint_ℝ w p.1 p.2.1 +
                    θ * (p.2.2 - midpoint_ℝ w p.1 p.2.1)))) := by
      ext ⟨X, Y, z⟩
      dsimp [cellKernelPlus_ℝ]
      rw [hScaleIntegral (midpoint_ℝ w X Y) z
        (fun ζ => Real.sin (primPhi_ℝ w Y - primPhi_ℝ w ζ) * Real.exp (-2 * w ζ))
        (by have hw_c := hw_reg.continuous; fun_prop)]
    rw [hEq]
    have hw_c : Continuous w := hw_reg.continuous
    have hMu3 : Continuous (fun p : ℝ × ℝ × ℝ => midpoint_ℝ w p.1 p.2.1) :=
      hMu_cont.comp (continuous_fst.prodMk (continuous_fst.comp continuous_snd))
    have hMuQ : Continuous (fun q : (ℝ × ℝ × ℝ) × ℝ => midpoint_ℝ w q.1.1 q.1.2.1) :=
      hMu3.comp continuous_fst
    have hIntCont : Continuous (fun p : ℝ × ℝ × ℝ =>
        ∫ θ in (0 : ℝ)..1,
          (p.2.2 - midpoint_ℝ w p.1 p.2.1) *
            (Real.sin (primPhi_ℝ w p.2.1 -
                primPhi_ℝ w (midpoint_ℝ w p.1 p.2.1 + θ * (p.2.2 - midpoint_ℝ w p.1 p.2.1))) *
              Real.exp (-2 * w (midpoint_ℝ w p.1 p.2.1 +
                θ * (p.2.2 - midpoint_ℝ w p.1 p.2.1))))) :=
      (hParamContDiff 0
        (fun q : (ℝ × ℝ × ℝ) × ℝ =>
          (q.1.2.2 - midpoint_ℝ w q.1.1 q.1.2.1) *
            (Real.sin (primPhi_ℝ w q.1.2.1 -
                primPhi_ℝ w (midpoint_ℝ w q.1.1 q.1.2.1 + q.2 * (q.1.2.2 - midpoint_ℝ w q.1.1 q.1.2.1))) *
              Real.exp (-2 * w (midpoint_ℝ w q.1.1 q.1.2.1 +
                q.2 * (q.1.2.2 - midpoint_ℝ w q.1.1 q.1.2.1)))))
        (contDiff_zero.mpr (by fun_prop))).continuous
    fun_prop

  
  have hPhi_diff_shift : ∀ u₁ u₂ : ℝ,
      primPhi_ℝ w (u₁ + 2 * Real.pi) - primPhi_ℝ w (u₂ + 2 * Real.pi) =
        primPhi_ℝ w u₁ - primPhi_ℝ w u₂ := by
    intro u₁ u₂; rw [hPhi_shift u₁, hPhi_shift u₂]; ring
  have hDiagPer : ∀ X Y z : ℝ,
      midpoint_ℝ w (X + 2 * Real.pi) (Y + 2 * Real.pi) = midpoint_ℝ w X Y + 2 * Real.pi ∧
      cellKernelMinus_ℝ w (X + 2 * Real.pi) (Y + 2 * Real.pi) (z + 2 * Real.pi) =
        cellKernelMinus_ℝ w X Y z ∧
      cellKernelPlus_ℝ w (X + 2 * Real.pi) (Y + 2 * Real.pi) (z + 2 * Real.pi) =
        cellKernelPlus_ℝ w X Y z := by
    intro X Y z
    refine ⟨hMid_shift X Y, ?_, ?_⟩
    · dsimp [cellKernelMinus_ℝ]
      rw [hPhi_diff_shift z X, hw_per z, hMid_shift X Y,
        ← intervalIntegral.integral_comp_add_right]
      congr 2; apply intervalIntegral.integral_congr; intro ζ _; dsimp only
      rw [hPhi_diff_shift ζ X, hw_per ζ]
    · dsimp [cellKernelPlus_ℝ]
      rw [hPhi_diff_shift Y z, hw_per z, hMid_shift X Y,
        ← intervalIntegral.integral_comp_add_right]
      congr 2; apply intervalIntegral.integral_congr; intro ζ _; dsimp only
      rw [hPhi_diff_shift Y ζ, hw_per ζ]

  
  have hDerivX : ∀ X Y : ℝ,
      HasDerivAt (fun X' : ℝ => normAction_ℝ w X' Y) (normAction1_ℝ w X Y) X := by
    intro X Y
    let μ : ℝ → ℝ := fun X' => midpoint_ℝ w X' Y
    have hμ_c4 : ContDiff ℝ (4 : WithTop ℕ∞) μ :=
      hMu_c4.comp (contDiff_id.prodMk (contDiff_const (c := Y)))
    have hμ_deriv : HasDerivAt μ (deriv μ X) X :=
      (hμ_c4.differentiable (by decide) X).hasDerivAt
    let g_m : ℝ × ℝ → ℝ := fun q =>
      -(1 - Real.cos (primPhi_ℝ w q.2 - primPhi_ℝ w q.1)) * Real.exp (-2 * w q.2)
    let g_m1 : ℝ × ℝ → ℝ := fun q =>
      Real.sin (primPhi_ℝ w q.2 - primPhi_ℝ w q.1) * Real.exp (w q.1) * Real.exp (-2 * w q.2)
    let g_p : ℝ × ℝ → ℝ := fun q =>
      -(1 - Real.cos (primPhi_ℝ w Y - primPhi_ℝ w q.2)) * Real.exp (-2 * w q.2)
    have hw_c : Continuous w := hw_reg.continuous
    have hgm_cont : Continuous g_m := by dsimp [g_m]; fun_prop
    have hgm1_cont : Continuous g_m1 := by dsimp [g_m1]; fun_prop
    have hgp_cont : Continuous g_p := by dsimp [g_p]; fun_prop
    have hgm_deriv : ∀ s z : ℝ, HasDerivAt (fun τ : ℝ => g_m (τ, z)) (g_m1 (s, z)) s := by
      intro s z
      have h1 : HasDerivAt (fun τ : ℝ => primPhi_ℝ w z - primPhi_ℝ w τ)
          (-Real.exp (w s)) s := by
        have hsub := (hasDerivAt_const s (primPhi_ℝ w z)).sub (hPhi_deriv s)
        rw [zero_sub] at hsub
        exact hsub
      have h2 : HasDerivAt (fun τ : ℝ => -(1 - Real.cos (primPhi_ℝ w z - primPhi_ℝ w τ)))
          (Real.sin (primPhi_ℝ w z - primPhi_ℝ w s) * Real.exp (w s)) s := by
        have hc := h1.cos
        have hs : HasDerivAt (fun τ : ℝ => -(1 - Real.cos (primPhi_ℝ w z - primPhi_ℝ w τ)))
            (-(0 - -Real.sin (primPhi_ℝ w z - primPhi_ℝ w s) * -Real.exp (w s))) s :=
          ((hasDerivAt_const s (1 : ℝ)).sub hc).neg
        have hval : -(0 - -Real.sin (primPhi_ℝ w z - primPhi_ℝ w s) * -Real.exp (w s)) =
            Real.sin (primPhi_ℝ w z - primPhi_ℝ w s) * Real.exp (w s) := by ring
        rwa [hval] at hs
      simpa [g_m, g_m1] using h2.mul_const (Real.exp (-2 * w z))
    have hgp_deriv : ∀ s z : ℝ, HasDerivAt (fun τ : ℝ => g_p (τ, z)) 0 s :=
      fun s z => hasDerivAt_const s (g_p (s, z))
    have hActEq : (fun X' : ℝ => normAction_ℝ w X' Y) =
        fun X' : ℝ => (∫ z in X'..μ X', g_m (X', z)) + (∫ z in μ X'..Y, g_p (X', z)) := by
      ext X'
      dsimp [normAction_ℝ, g_m, g_p, μ]
      simp only [neg_mul, intervalIntegral.integral_neg, sub_eq_add_neg]
    rw [hActEq]
    have hL := hMovingLeibniz g_m g_m1 id μ 1 (deriv μ X) X
      hgm_cont hgm1_cont hgm_deriv (hasDerivAt_id X) hμ_deriv
    have hR := hMovingLeibniz g_p (fun _ => 0) μ (fun _ => Y) (deriv μ X) 0 X
      hgp_cont continuous_const hgp_deriv hμ_deriv (hasDerivAt_const X Y)
    have hSum : HasDerivAt
        (fun X' : ℝ => (∫ z in X'..μ X', g_m (X', z)) + (∫ z in μ X'..Y, g_p (X', z)))
        ((g_m (X, μ X) * deriv μ X - g_m (X, id X) * 1 + ∫ z in id X..μ X, g_m1 (X, z)) +
          (g_p (X, Y) * 0 - g_p (X, μ X) * deriv μ X + ∫ z in μ X..Y, 0)) X := hL.add hR
    have hgm_diag : g_m (X, id X) = 0 := by
      dsimp [g_m]; simp
    have hgp_mid : g_m (X, μ X) = g_p (X, μ X) := by
      dsimp [g_m, g_p, μ]
      have hm := hMid_eval X Y
      have hdiff : primPhi_ℝ w (midpoint_ℝ w X Y) - primPhi_ℝ w X =
          primPhi_ℝ w Y - primPhi_ℝ w (midpoint_ℝ w X Y) := by linarith
      rw [hdiff]
    have hIntEq : (∫ z in id X..μ X, g_m1 (X, z)) = normAction1_ℝ w X Y := by
      dsimp [g_m1, normAction1_ℝ, μ, id]
      have : (fun z : ℝ =>
          Real.sin (primPhi_ℝ w z - primPhi_ℝ w X) * Real.exp (w X) * Real.exp (-2 * w z)) =
          fun z : ℝ =>
            Real.exp (w X) * (Real.sin (primPhi_ℝ w z - primPhi_ℝ w X) * Real.exp (-2 * w z)) := by
        ext z; ring
      rw [this, intervalIntegral.integral_const_mul]
    have hVal : ((g_m (X, μ X) * deriv μ X - g_m (X, id X) * 1 + ∫ z in id X..μ X, g_m1 (X, z)) +
        (g_p (X, Y) * 0 - g_p (X, μ X) * deriv μ X + ∫ z in μ X..Y, 0)) =
        normAction1_ℝ w X Y := by
      rw [hgm_diag, hgp_mid, hIntEq, intervalIntegral.integral_zero]
      ring
    rwa [hVal] at hSum

  have hActAntisymm : ∀ X Y : ℝ, normAction_ℝ w X Y = -normAction_ℝ w Y X := by
    intro X Y
    dsimp [normAction_ℝ]
    rw [hMid_symm X Y]
    have h1 : (∫ z in Y..(midpoint_ℝ w X Y),
        (1 - Real.cos (primPhi_ℝ w z - primPhi_ℝ w Y)) * Real.exp (-2 * w z)) =
        -(∫ z in (midpoint_ℝ w X Y)..Y,
          (1 - Real.cos (primPhi_ℝ w Y - primPhi_ℝ w z)) * Real.exp (-2 * w z)) := by
      rw [intervalIntegral.integral_symm (midpoint_ℝ w X Y) Y]
      congr 1; apply intervalIntegral.integral_congr; intro z _
      dsimp only
      have : primPhi_ℝ w z - primPhi_ℝ w Y = -(primPhi_ℝ w Y - primPhi_ℝ w z) := by ring
      rw [this, Real.cos_neg]
    have h2 : (∫ z in (midpoint_ℝ w X Y)..X,
        (1 - Real.cos (primPhi_ℝ w X - primPhi_ℝ w z)) * Real.exp (-2 * w z)) =
        -(∫ z in X..(midpoint_ℝ w X Y),
          (1 - Real.cos (primPhi_ℝ w z - primPhi_ℝ w X)) * Real.exp (-2 * w z)) := by
      rw [intervalIntegral.integral_symm X (midpoint_ℝ w X Y)]
      congr 1; apply intervalIntegral.integral_congr; intro z _
      dsimp only
      have : primPhi_ℝ w X - primPhi_ℝ w z = -(primPhi_ℝ w z - primPhi_ℝ w X) := by ring
      rw [this, Real.cos_neg]
    rw [h1, h2]
    ring

  have hEndPartials : ∀ X Y : ℝ,
      HasDerivAt (fun X' : ℝ => normAction_ℝ w X' Y) (normAction1_ℝ w X Y) X ∧
      HasDerivAt (fun Y' : ℝ => normAction_ℝ w X Y') (-normAction1_ℝ w Y X) Y := by
    intro X Y
    refine ⟨hDerivX X Y, ?_⟩
    have hEq : (fun Y' : ℝ => normAction_ℝ w X Y') = fun Y' : ℝ => -normAction_ℝ w Y' X := by
      ext Y'; exact hActAntisymm X Y'
    rw [hEq]
    exact (hDerivX Y X).neg

  
  refine ⟨hMu_cont, hKm_cont, hKp_cont, hDiagPer, hEndPartials, ?_⟩
  intro v hv_per hv_reg
  obtain ⟨hPhi_tv_c4, hMu_tv_c4⟩ := hJointMidC4 w v hw_per hw_reg hv_per hv_reg

  
  have hAct_c2 : ContDiff ℝ (2 : WithTop ℕ∞)
      (fun p : ℝ × ℝ × ℝ => normAction_ℝ (fun z => w z + p.2.2 * v z) p.1 p.2.1) := by
    let phi_tv : ℝ × ℝ → ℝ := fun q => primPhi_ℝ (fun ζ => w ζ + q.1 * v ζ) q.2
    let mu_tv : ℝ × ℝ × ℝ → ℝ :=
      fun p => midpoint_ℝ (fun ζ => w ζ + p.2.2 * v ζ) p.1 p.2.1
    have hphi_c2 : ContDiff ℝ (2 : WithTop ℕ∞) phi_tv := hPhi_tv_c4.of_le (by decide)
    have hmu_c2 : ContDiff ℝ (2 : WithTop ℕ∞) mu_tv := hMu_tv_c4.of_le (by decide)
    have hw_c2 : ContDiff ℝ (2 : WithTop ℕ∞) w := hw_reg.of_le (by decide)
    have hv_c2 : ContDiff ℝ (2 : WithTop ℕ∞) v := hv_reg.of_le (by decide)
    let Gm : (ℝ × ℝ × ℝ) × ℝ → ℝ := fun q =>
      let X := q.1.1; let t := q.1.2.2; let μ := mu_tv q.1; let θ := q.2
      let z := X + θ * (μ - X)
      (μ - X) * ((1 - Real.cos (phi_tv (t, z) - phi_tv (t, X))) *
        Real.exp (-2 * (w z + t * v z)))
    let Gp : (ℝ × ℝ × ℝ) × ℝ → ℝ := fun q =>
      let Y := q.1.2.1; let t := q.1.2.2; let μ := mu_tv q.1; let θ := q.2
      let z := μ + θ * (Y - μ)
      (Y - μ) * ((1 - Real.cos (phi_tv (t, Y) - phi_tv (t, z))) *
        Real.exp (-2 * (w z + t * v z)))
    have hActScale : (fun p : ℝ × ℝ × ℝ => normAction_ℝ (fun z => w z + p.2.2 * v z) p.1 p.2.1) =
        fun p : ℝ × ℝ × ℝ =>
          -(∫ θ in (0 : ℝ)..1, Gm (p, θ)) - (∫ θ in (0 : ℝ)..1, Gp (p, θ)) := by
      ext ⟨X, Y, t⟩
      dsimp [normAction_ℝ, Gm, Gp, phi_tv, mu_tv]
      have hphi_t_cont : Continuous (primPhi_ℝ (fun ζ => w ζ + t * v ζ)) :=
        hPhi_tv_c4.continuous.comp (continuous_const.prodMk continuous_id)
      have hw_c : Continuous w := hw_reg.continuous
      have hv_c : Continuous v := hv_reg.continuous
      rw [hScaleIntegral X (midpoint_ℝ (fun ζ => w ζ + t * v ζ) X Y)
          (fun z => (1 - Real.cos (primPhi_ℝ (fun ζ => w ζ + t * v ζ) z -
            primPhi_ℝ (fun ζ => w ζ + t * v ζ) X)) * Real.exp (-2 * (w z + t * v z)))
          (by fun_prop),
        hScaleIntegral (midpoint_ℝ (fun ζ => w ζ + t * v ζ) X Y) Y
          (fun z => (1 - Real.cos (primPhi_ℝ (fun ζ => w ζ + t * v ζ) Y -
            primPhi_ℝ (fun ζ => w ζ + t * v ζ) z)) * Real.exp (-2 * (w z + t * v z)))
          (by fun_prop)]
    rw [hActScale]
    have hX_q : ContDiff ℝ (2 : WithTop ℕ∞) (fun q : (ℝ × ℝ × ℝ) × ℝ => q.1.1) :=
      contDiff_fst.comp contDiff_fst
    have hY_q : ContDiff ℝ (2 : WithTop ℕ∞) (fun q : (ℝ × ℝ × ℝ) × ℝ => q.1.2.1) :=
      contDiff_fst.comp (contDiff_snd.comp contDiff_fst)
    have ht_q : ContDiff ℝ (2 : WithTop ℕ∞) (fun q : (ℝ × ℝ × ℝ) × ℝ => q.1.2.2) :=
      contDiff_snd.comp (contDiff_snd.comp contDiff_fst)
    have hμ_q : ContDiff ℝ (2 : WithTop ℕ∞) (fun q : (ℝ × ℝ × ℝ) × ℝ => mu_tv q.1) :=
      hmu_c2.comp contDiff_fst
    have hzm_q : ContDiff ℝ (2 : WithTop ℕ∞)
        (fun q : (ℝ × ℝ × ℝ) × ℝ => q.1.1 + q.2 * (mu_tv q.1 - q.1.1)) :=
      hX_q.add (contDiff_snd.mul (hμ_q.sub hX_q))
    have hzp_q : ContDiff ℝ (2 : WithTop ℕ∞)
        (fun q : (ℝ × ℝ × ℝ) × ℝ => mu_tv q.1 + q.2 * (q.1.2.1 - mu_tv q.1)) :=
      hμ_q.add (contDiff_snd.mul (hY_q.sub hμ_q))
    have hGm_c2 : ContDiff ℝ (2 : WithTop ℕ∞) Gm :=
      (hμ_q.sub hX_q).mul
        (((contDiff_const (c := (1 : ℝ))).sub (Real.contDiff_cos.comp
            ((hphi_c2.comp (ht_q.prodMk hzm_q)).sub (hphi_c2.comp (ht_q.prodMk hX_q))))).mul
          (Real.contDiff_exp.comp
            ((contDiff_const (c := (-2 : ℝ))).mul
              ((hw_c2.comp hzm_q).add (ht_q.mul (hv_c2.comp hzm_q))))))
    have hGp_c2 : ContDiff ℝ (2 : WithTop ℕ∞) Gp :=
      (hY_q.sub hμ_q).mul
        (((contDiff_const (c := (1 : ℝ))).sub (Real.contDiff_cos.comp
            ((hphi_c2.comp (ht_q.prodMk hY_q)).sub (hphi_c2.comp (ht_q.prodMk hzp_q))))).mul
          (Real.contDiff_exp.comp
            ((contDiff_const (c := (-2 : ℝ))).mul
              ((hw_c2.comp hzp_q).add (ht_q.mul (hv_c2.comp hzp_q))))))
    exact (hParamContDiff 2 Gm hGm_c2).neg.sub (hParamContDiff 2 Gp hGp_c2)

  refine ⟨hAct_c2, ?_⟩

  
  intro X Y hXY
  obtain ⟨hX_lt_mu, hmu_lt_Y⟩ := hMid_ord X Y hXY
  refine ⟨hX_lt_mu, hmu_lt_Y, ?_⟩

  let wt : ℝ → ℝ → ℝ := fun t z => w z + t * v z
  let μt : ℝ → ℝ := fun t => midpoint_ℝ (wt t) X Y
  have hwt0 : wt 0 = w := by ext z; simp [wt]
  have hμt0 : μt 0 = midpoint_ℝ w X Y := by simp [μt, hwt0]
  have hμt_c4 : ContDiff ℝ (4 : WithTop ℕ∞) μt :=
    hMu_tv_c4.comp ((contDiff_const (c := X)).prodMk ((contDiff_const (c := Y)).prodMk contDiff_id))
  have hμt_deriv0 : HasDerivAt μt (deriv μt 0) 0 :=
    (hμt_c4.differentiable (by decide) 0).hasDerivAt
  have hw_c : Continuous w := hw_reg.continuous
  have hv_c : Continuous v := hv_reg.continuous
  have hPhi_tv_cont : Continuous (fun q : ℝ × ℝ => primPhi_ℝ (wt q.1) q.2) :=
    hPhi_tv_c4.continuous

  
  have hDeltaDeriv : ∀ u₁ u₂ t : ℝ,
      HasDerivAt (fun τ : ℝ => primPhi_ℝ (wt τ) u₂ - primPhi_ℝ (wt τ) u₁)
        (∫ z in u₁..u₂, Real.exp (wt t z) * v z) t := by
    intro u₁ u₂ t
    have hDiffEq : (fun τ : ℝ => primPhi_ℝ (wt τ) u₂ - primPhi_ℝ (wt τ) u₁) =
        fun τ : ℝ => ∫ z in u₁..u₂, Real.exp (wt τ z) := by
      ext τ
      dsimp [primPhi_ℝ, wt]
      have hi1 : IntervalIntegrable (fun z => Real.exp (w z + τ * v z))
          MeasureTheory.volume 0 u₁ := (by fun_prop : Continuous _).intervalIntegrable 0 u₁
      have hi2 : IntervalIntegrable (fun z => Real.exp (w z + τ * v z))
          MeasureTheory.volume u₁ u₂ := (by fun_prop : Continuous _).intervalIntegrable u₁ u₂
      linarith [intervalIntegral.integral_add_adjacent_intervals hi1 hi2]
    rw [hDiffEq]
    have hL := hMovingLeibniz
      (fun q : ℝ × ℝ => Real.exp (w q.2 + q.1 * v q.2))
      (fun q : ℝ × ℝ => Real.exp (w q.2 + q.1 * v q.2) * v q.2)
      (fun _ => u₁) (fun _ => u₂) 0 0 t
      (by fun_prop) (by fun_prop)
      (fun s z => by
        simpa [mul_comm] using
          (((hasDerivAt_id s).mul_const (v z)).const_add (w z)).exp)
      (hasDerivAt_const t u₁) (hasDerivAt_const t u₂)
    simpa [wt] using hL

  
  have hDeltaContLeft : ∀ u₀ : ℝ,
      Continuous (fun q : ℝ × ℝ => ∫ z in u₀..q.2, Real.exp (wt q.1 z) * v z) := by
    intro u₀
    have hEq : (fun q : ℝ × ℝ => ∫ z in u₀..q.2, Real.exp (wt q.1 z) * v z) =
        fun q : ℝ × ℝ => ∫ θ in (0 : ℝ)..1,
          (q.2 - u₀) * (Real.exp (wt q.1 (u₀ + θ * (q.2 - u₀))) * v (u₀ + θ * (q.2 - u₀))) := by
      ext ⟨t, ζ⟩
      exact hScaleIntegral u₀ ζ (fun z => Real.exp (w z + t * v z) * v z) (by fun_prop)
    rw [hEq]
    exact (hParamContDiff 0
      (fun r : (ℝ × ℝ) × ℝ =>
        (r.1.2 - u₀) * (Real.exp (w (u₀ + r.2 * (r.1.2 - u₀)) +
          r.1.1 * v (u₀ + r.2 * (r.1.2 - u₀))) * v (u₀ + r.2 * (r.1.2 - u₀))))
      (contDiff_zero.mpr (by fun_prop))).continuous

  have hDeltaContRight : ∀ u₀ : ℝ,
      Continuous (fun q : ℝ × ℝ => ∫ z in q.2..u₀, Real.exp (wt q.1 z) * v z) := by
    intro u₀
    have hEq : (fun q : ℝ × ℝ => ∫ z in q.2..u₀, Real.exp (wt q.1 z) * v z) =
        fun q : ℝ × ℝ => -(∫ z in u₀..q.2, Real.exp (wt q.1 z) * v z) := by
      ext ⟨t, ζ⟩; exact intervalIntegral.integral_symm u₀ ζ
    rw [hEq]
    exact (hDeltaContLeft u₀).neg

  
  let gm_t : ℝ × ℝ → ℝ := fun q =>
    -(1 - Real.cos (primPhi_ℝ (wt q.1) q.2 - primPhi_ℝ (wt q.1) X)) *
      Real.exp (-2 * wt q.1 q.2)
  let gm_t1 : ℝ × ℝ → ℝ := fun q =>
    2 * (1 - Real.cos (primPhi_ℝ (wt q.1) q.2 - primPhi_ℝ (wt q.1) X)) *
      Real.exp (-2 * wt q.1 q.2) * v q.2 -
    Real.sin (primPhi_ℝ (wt q.1) q.2 - primPhi_ℝ (wt q.1) X) *
      Real.exp (-2 * wt q.1 q.2) * (∫ z in X..q.2, Real.exp (wt q.1 z) * v z)

  let gp_t : ℝ × ℝ → ℝ := fun q =>
    -(1 - Real.cos (primPhi_ℝ (wt q.1) Y - primPhi_ℝ (wt q.1) q.2)) *
      Real.exp (-2 * wt q.1 q.2)
  let gp_t1 : ℝ × ℝ → ℝ := fun q =>
    2 * (1 - Real.cos (primPhi_ℝ (wt q.1) Y - primPhi_ℝ (wt q.1) q.2)) *
      Real.exp (-2 * wt q.1 q.2) * v q.2 -
    Real.sin (primPhi_ℝ (wt q.1) Y - primPhi_ℝ (wt q.1) q.2) *
      Real.exp (-2 * wt q.1 q.2) * (∫ z in q.2..Y, Real.exp (wt q.1 z) * v z)

  have hgm_t_cont : Continuous gm_t := by
    change Continuous (fun q : ℝ × ℝ =>
      -(1 - Real.cos (primPhi_ℝ (wt q.1) q.2 - primPhi_ℝ (wt q.1) X)) *
        Real.exp (-2 * (w q.2 + q.1 * v q.2)))
    have hPhiX : Continuous (fun q : ℝ × ℝ => primPhi_ℝ (wt q.1) X) :=
      hPhi_tv_cont.comp (continuous_fst.prodMk continuous_const)
    fun_prop

  have hgm_t1_cont : Continuous gm_t1 := by
    change Continuous (fun q : ℝ × ℝ =>
      2 * (1 - Real.cos (primPhi_ℝ (wt q.1) q.2 - primPhi_ℝ (wt q.1) X)) *
        Real.exp (-2 * (w q.2 + q.1 * v q.2)) * v q.2 -
      Real.sin (primPhi_ℝ (wt q.1) q.2 - primPhi_ℝ (wt q.1) X) *
        Real.exp (-2 * (w q.2 + q.1 * v q.2)) * (∫ z in X..q.2, Real.exp (wt q.1 z) * v z))
    have hPhiX : Continuous (fun q : ℝ × ℝ => primPhi_ℝ (wt q.1) X) :=
      hPhi_tv_cont.comp (continuous_fst.prodMk continuous_const)
    have hDL := hDeltaContLeft X
    fun_prop

  have hgp_t_cont : Continuous gp_t := by
    change Continuous (fun q : ℝ × ℝ =>
      -(1 - Real.cos (primPhi_ℝ (wt q.1) Y - primPhi_ℝ (wt q.1) q.2)) *
        Real.exp (-2 * (w q.2 + q.1 * v q.2)))
    have hPhiY : Continuous (fun q : ℝ × ℝ => primPhi_ℝ (wt q.1) Y) :=
      hPhi_tv_cont.comp (continuous_fst.prodMk continuous_const)
    fun_prop

  have hgp_t1_cont : Continuous gp_t1 := by
    change Continuous (fun q : ℝ × ℝ =>
      2 * (1 - Real.cos (primPhi_ℝ (wt q.1) Y - primPhi_ℝ (wt q.1) q.2)) *
        Real.exp (-2 * (w q.2 + q.1 * v q.2)) * v q.2 -
      Real.sin (primPhi_ℝ (wt q.1) Y - primPhi_ℝ (wt q.1) q.2) *
        Real.exp (-2 * (w q.2 + q.1 * v q.2)) * (∫ z in q.2..Y, Real.exp (wt q.1 z) * v z))
    have hPhiY : Continuous (fun q : ℝ × ℝ => primPhi_ℝ (wt q.1) Y) :=
      hPhi_tv_cont.comp (continuous_fst.prodMk continuous_const)
    have hDR := hDeltaContRight Y
    fun_prop

  have hgm_t_deriv : ∀ t ζ : ℝ, HasDerivAt (fun τ : ℝ => gm_t (τ, ζ)) (gm_t1 (t, ζ)) t := by
    intro t ζ
    have hf1 : HasDerivAt
        (fun τ : ℝ => -(1 - Real.cos (primPhi_ℝ (wt τ) ζ - primPhi_ℝ (wt τ) X)))
        (-Real.sin (primPhi_ℝ (wt t) ζ - primPhi_ℝ (wt t) X) *
          (∫ z in X..ζ, Real.exp (wt t z) * v z)) t := by
      have hc := (hDeltaDeriv X ζ t).cos
      have hs := ((hasDerivAt_const t (1 : ℝ)).sub hc).neg
      convert hs using 1; ring
    have hf2 : HasDerivAt (fun τ : ℝ => Real.exp (-2 * wt τ ζ))
        (Real.exp (-2 * wt t ζ) * (-2 * v ζ)) t := by
      have hexp : HasDerivAt (fun τ : ℝ => -2 * (w ζ + τ * v ζ)) (-2 * v ζ) t := by
        have h0 : HasDerivAt (fun τ : ℝ => -2 * (w ζ + τ * v ζ)) (-2 * (1 * v ζ)) t :=
          (((hasDerivAt_id t).mul_const (v ζ)).const_add (w ζ)).const_mul (-2)
        have hval : -2 * (1 * v ζ) = -2 * v ζ := by ring
        rwa [hval] at h0
      exact hexp.exp
    have hmul : HasDerivAt (fun τ : ℝ => gm_t (τ, ζ))
        ((-Real.sin (primPhi_ℝ (wt t) ζ - primPhi_ℝ (wt t) X) *
          (∫ z in X..ζ, Real.exp (wt t z) * v z)) * Real.exp (-2 * wt t ζ) +
          (-(1 - Real.cos (primPhi_ℝ (wt t) ζ - primPhi_ℝ (wt t) X))) *
            (Real.exp (-2 * wt t ζ) * (-2 * v ζ))) t := hf1.mul hf2
    have hval2 : ((-Real.sin (primPhi_ℝ (wt t) ζ - primPhi_ℝ (wt t) X) *
        (∫ z in X..ζ, Real.exp (wt t z) * v z)) * Real.exp (-2 * wt t ζ) +
        (-(1 - Real.cos (primPhi_ℝ (wt t) ζ - primPhi_ℝ (wt t) X))) *
          (Real.exp (-2 * wt t ζ) * (-2 * v ζ))) = gm_t1 (t, ζ) := by
      dsimp [gm_t1]; ring
    rwa [hval2] at hmul

  have hgp_t_deriv : ∀ t ζ : ℝ, HasDerivAt (fun τ : ℝ => gp_t (τ, ζ)) (gp_t1 (t, ζ)) t := by
    intro t ζ
    have hf1 : HasDerivAt
        (fun τ : ℝ => -(1 - Real.cos (primPhi_ℝ (wt τ) Y - primPhi_ℝ (wt τ) ζ)))
        (-Real.sin (primPhi_ℝ (wt t) Y - primPhi_ℝ (wt t) ζ) *
          (∫ z in ζ..Y, Real.exp (wt t z) * v z)) t := by
      have hc := (hDeltaDeriv ζ Y t).cos
      have hs : HasDerivAt
          (fun τ : ℝ => -(1 - Real.cos (primPhi_ℝ (wt τ) Y - primPhi_ℝ (wt τ) ζ)))
          (-(0 - -Real.sin (primPhi_ℝ (wt t) Y - primPhi_ℝ (wt t) ζ) *
            (∫ z in ζ..Y, Real.exp (wt t z) * v z))) t :=
        ((hasDerivAt_const t (1 : ℝ)).sub hc).neg
      have hval : -(0 - -Real.sin (primPhi_ℝ (wt t) Y - primPhi_ℝ (wt t) ζ) *
          (∫ z in ζ..Y, Real.exp (wt t z) * v z)) =
          -Real.sin (primPhi_ℝ (wt t) Y - primPhi_ℝ (wt t) ζ) *
            (∫ z in ζ..Y, Real.exp (wt t z) * v z) := by ring
      rwa [hval] at hs
    have hf2 : HasDerivAt (fun τ : ℝ => Real.exp (-2 * wt τ ζ))
        (Real.exp (-2 * wt t ζ) * (-2 * v ζ)) t := by
      have hexp : HasDerivAt (fun τ : ℝ => -2 * (w ζ + τ * v ζ)) (-2 * v ζ) t := by
        have h0 : HasDerivAt (fun τ : ℝ => -2 * (w ζ + τ * v ζ)) (-2 * (1 * v ζ)) t :=
          (((hasDerivAt_id t).mul_const (v ζ)).const_add (w ζ)).const_mul (-2)
        have hval : -2 * (1 * v ζ) = -2 * v ζ := by ring
        rwa [hval] at h0
      exact hexp.exp
    have hmul : HasDerivAt (fun τ : ℝ => gp_t (τ, ζ))
        ((-Real.sin (primPhi_ℝ (wt t) Y - primPhi_ℝ (wt t) ζ) *
          (∫ z in ζ..Y, Real.exp (wt t z) * v z)) * Real.exp (-2 * wt t ζ) +
          (-(1 - Real.cos (primPhi_ℝ (wt t) Y - primPhi_ℝ (wt t) ζ))) *
            (Real.exp (-2 * wt t ζ) * (-2 * v ζ))) t := hf1.mul hf2
    have hval2 : ((-Real.sin (primPhi_ℝ (wt t) Y - primPhi_ℝ (wt t) ζ) *
        (∫ z in ζ..Y, Real.exp (wt t z) * v z)) * Real.exp (-2 * wt t ζ) +
        (-(1 - Real.cos (primPhi_ℝ (wt t) Y - primPhi_ℝ (wt t) ζ))) *
          (Real.exp (-2 * wt t ζ) * (-2 * v ζ))) = gp_t1 (t, ζ) := by
      dsimp [gp_t1]; ring
    rwa [hval2] at hmul

  have hAct_t_eq : (fun t : ℝ => normAction_ℝ (fun z => w z + t * v z) X Y) =
      fun t : ℝ => (∫ ζ in X..μt t, gm_t (t, ζ)) + (∫ ζ in μt t..Y, gp_t (t, ζ)) := by
    ext t
    dsimp [normAction_ℝ, gm_t, gp_t, μt, wt]
    simp only [neg_mul, intervalIntegral.integral_neg, sub_eq_add_neg]
  rw [hAct_t_eq]

  have hLt := hMovingLeibniz gm_t gm_t1 (fun _ => X) μt 0 (deriv μt 0) 0
    hgm_t_cont hgm_t1_cont hgm_t_deriv (hasDerivAt_const 0 X) hμt_deriv0
  have hRt := hMovingLeibniz gp_t gp_t1 μt (fun _ => Y) (deriv μt 0) 0 0
    hgp_t_cont hgp_t1_cont hgp_t_deriv hμt_deriv0 (hasDerivAt_const 0 Y)
  have hSum_t : HasDerivAt
      (fun t : ℝ => (∫ ζ in X..μt t, gm_t (t, ζ)) + (∫ ζ in μt t..Y, gp_t (t, ζ)))
      ((gm_t (0, μt 0) * deriv μt 0 - gm_t (0, X) * 0 + ∫ ζ in X..μt 0, gm_t1 (0, ζ)) +
        (gp_t (0, Y) * 0 - gp_t (0, μt 0) * deriv μt 0 + ∫ ζ in μt 0..Y, gp_t1 (0, ζ))) 0 :=
    hLt.add hRt

  have hBdryCancel : gm_t (0, μt 0) = gp_t (0, μt 0) := by
    dsimp [gm_t, gp_t]
    rw [hwt0, hμt0]
    have hm := hMid_eval X Y
    have hdiff : primPhi_ℝ w (midpoint_ℝ w X Y) - primPhi_ℝ w X =
        primPhi_ℝ w Y - primPhi_ℝ w (midpoint_ℝ w X Y) := by linarith
    rw [hdiff]

  have hLeftCollapse : (∫ ζ in X..μt 0, gm_t1 (0, ζ)) =
      ∫ z in X..(midpoint_ℝ w X Y), cellKernelMinus_ℝ w X Y z * v z := by
    rw [hμt0]
    set μ := midpoint_ℝ w X Y
    have h1 : (fun ζ : ℝ => gm_t1 (0, ζ)) = fun ζ : ℝ =>
        2 * (1 - Real.cos (primPhi_ℝ w ζ - primPhi_ℝ w X)) * Real.exp (-2 * w ζ) * v ζ -
        (∫ z in X..ζ, Real.exp (w z) * v z) *
          (Real.sin (primPhi_ℝ w ζ - primPhi_ℝ w X) * Real.exp (-2 * w ζ)) := by
      ext ζ; dsimp [gm_t1]; rw [hwt0]; ring
    rw [h1]
    have hiA : IntervalIntegrable
        (fun ζ => 2 * (1 - Real.cos (primPhi_ℝ w ζ - primPhi_ℝ w X)) * Real.exp (-2 * w ζ) * v ζ)
        MeasureTheory.volume X μ := (by fun_prop : Continuous _).intervalIntegrable X μ
    have hiB : IntervalIntegrable
        (fun ζ => (∫ z in X..ζ, Real.exp (w z) * v z) *
          (Real.sin (primPhi_ℝ w ζ - primPhi_ℝ w X) * Real.exp (-2 * w ζ)))
        MeasureTheory.volume X μ := by
      have hIntC : Continuous (fun ζ : ℝ => ∫ z in X..ζ, Real.exp (w z) * v z) := by
        have hc0 : Continuous (fun ζ : ℝ => ((0 : ℝ), ζ)) := continuous_const.prodMk continuous_id
        simpa [Function.comp_def, hwt0] using (hDeltaContLeft X).comp hc0
      exact (by fun_prop : Continuous _).intervalIntegrable X μ
    rw [intervalIntegral.integral_sub hiA hiB,
      hTriSwapLeft X μ
        (fun ζ => Real.sin (primPhi_ℝ w ζ - primPhi_ℝ w X) * Real.exp (-2 * w ζ))
        (fun z => Real.exp (w z) * v z) (by fun_prop) (by fun_prop)]
    have hiB' : IntervalIntegrable
        (fun z => (Real.exp (w z) * v z) *
          (∫ ζ in z..μ, Real.sin (primPhi_ℝ w ζ - primPhi_ℝ w X) * Real.exp (-2 * w ζ)))
        MeasureTheory.volume X μ := by
      have hSubC : Continuous (fun z : ℝ =>
          ∫ ζ in z..μ, Real.sin (primPhi_ℝ w ζ - primPhi_ℝ w X) * Real.exp (-2 * w ζ)) := by
        have hEq : (fun z : ℝ =>
            ∫ ζ in z..μ, Real.sin (primPhi_ℝ w ζ - primPhi_ℝ w X) * Real.exp (-2 * w ζ)) =
            fun z : ℝ => -(∫ ζ in μ..z,
              Real.sin (primPhi_ℝ w ζ - primPhi_ℝ w X) * Real.exp (-2 * w ζ)) := by
          ext z; exact intervalIntegral.integral_symm μ z
        rw [hEq]
        have hf_c : Continuous (fun ζ : ℝ =>
            Real.sin (primPhi_ℝ w ζ - primPhi_ℝ w X) * Real.exp (-2 * w ζ)) := by fun_prop
        exact (Differentiable.continuous fun z => (intervalIntegral.integral_hasDerivAt_right
          (hf_c.intervalIntegrable μ z)
          (hf_c.stronglyMeasurableAtFilter MeasureTheory.volume (nhds z))
          hf_c.continuousAt).differentiableAt).neg
      exact (by fun_prop : Continuous _).intervalIntegrable X μ
    rw [← intervalIntegral.integral_sub hiA hiB']
    congr 1; ext z; dsimp [cellKernelMinus_ℝ, μ]; ring

  have hRightCollapse : (∫ ζ in μt 0..Y, gp_t1 (0, ζ)) =
      ∫ z in (midpoint_ℝ w X Y)..Y, cellKernelPlus_ℝ w X Y z * v z := by
    rw [hμt0]
    set μ := midpoint_ℝ w X Y
    have h1 : (fun ζ : ℝ => gp_t1 (0, ζ)) = fun ζ : ℝ =>
        2 * (1 - Real.cos (primPhi_ℝ w Y - primPhi_ℝ w ζ)) * Real.exp (-2 * w ζ) * v ζ -
        (∫ z in ζ..Y, Real.exp (w z) * v z) *
          (Real.sin (primPhi_ℝ w Y - primPhi_ℝ w ζ) * Real.exp (-2 * w ζ)) := by
      ext ζ; dsimp [gp_t1]; rw [hwt0]; ring
    rw [h1]
    have hiA : IntervalIntegrable
        (fun ζ => 2 * (1 - Real.cos (primPhi_ℝ w Y - primPhi_ℝ w ζ)) * Real.exp (-2 * w ζ) * v ζ)
        MeasureTheory.volume μ Y := (by fun_prop : Continuous _).intervalIntegrable μ Y
    have hiB : IntervalIntegrable
        (fun ζ => (∫ z in ζ..Y, Real.exp (w z) * v z) *
          (Real.sin (primPhi_ℝ w Y - primPhi_ℝ w ζ) * Real.exp (-2 * w ζ)))
        MeasureTheory.volume μ Y := by
      have hIntC : Continuous (fun ζ : ℝ => ∫ z in ζ..Y, Real.exp (w z) * v z) := by
        have hc0 : Continuous (fun ζ : ℝ => ((0 : ℝ), ζ)) := continuous_const.prodMk continuous_id
        simpa [Function.comp_def, hwt0] using (hDeltaContRight Y).comp hc0
      exact (by fun_prop : Continuous _).intervalIntegrable μ Y
    rw [intervalIntegral.integral_sub hiA hiB,
      hTriSwapRight μ Y
        (fun ζ => Real.sin (primPhi_ℝ w Y - primPhi_ℝ w ζ) * Real.exp (-2 * w ζ))
        (fun z => Real.exp (w z) * v z) (by fun_prop) (by fun_prop)]
    have hiB' : IntervalIntegrable
        (fun z => (Real.exp (w z) * v z) *
          (∫ ζ in μ..z, Real.sin (primPhi_ℝ w Y - primPhi_ℝ w ζ) * Real.exp (-2 * w ζ)))
        MeasureTheory.volume μ Y := by
      have hSubC : Continuous (fun z : ℝ =>
          ∫ ζ in μ..z, Real.sin (primPhi_ℝ w Y - primPhi_ℝ w ζ) * Real.exp (-2 * w ζ)) := by
        have hf_c : Continuous (fun ζ : ℝ =>
            Real.sin (primPhi_ℝ w Y - primPhi_ℝ w ζ) * Real.exp (-2 * w ζ)) := by fun_prop
        exact Differentiable.continuous fun z => (intervalIntegral.integral_hasDerivAt_right
          (hf_c.intervalIntegrable μ z)
          (hf_c.stronglyMeasurableAtFilter MeasureTheory.volume (nhds z))
          hf_c.continuousAt).differentiableAt
      exact (by fun_prop : Continuous _).intervalIntegrable μ Y
    rw [← intervalIntegral.integral_sub hiA hiB']
    congr 1; ext z; dsimp [cellKernelPlus_ℝ, μ]; ring

  have hVal_t :
      ((gm_t (0, μt 0) * deriv μt 0 - gm_t (0, X) * 0 + ∫ ζ in X..μt 0, gm_t1 (0, ζ)) +
        (gp_t (0, Y) * 0 - gp_t (0, μt 0) * deriv μt 0 + ∫ ζ in μt 0..Y, gp_t1 (0, ζ))) =
      (∫ z in X..(midpoint_ℝ w X Y), cellKernelMinus_ℝ w X Y z * v z) +
        (∫ z in (midpoint_ℝ w X Y)..Y, cellKernelPlus_ℝ w X Y z * v z) := by
    rw [hBdryCancel, hLeftCollapse, hRightCollapse]
    ring
  rwa [hVal_t] at hSum_t

theorem halfCell_inverse_system (m : ℕ) (M : ℝ)
    (hm : 2 ≤ m) (hM : 0 < M) (S : StationaryMeshSystem m (M + 1)) :
    Nonempty (HalfCellInverseSystem m M S) :=
by
  have _ := hm
  have _ := hM
  
  have hChooseSum : ∀ n : ℕ,
      (∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ)) = (2 : ℝ) ^ n := by
    intro n
    exact_mod_cast Nat.sum_range_choose n
  have hChooseSuccLe : ∀ n : ℕ,
      (∑ i ∈ Finset.range n, (n.choose (i + 1) : ℝ)) ≤ (2 : ℝ) ^ n := by
    intro n
    have hsplit := Finset.sum_range_succ' (fun j => (n.choose j : ℝ)) n
    rw [hChooseSum n, Nat.choose_zero_right, Nat.cast_one] at hsplit
    linarith
  have hSumProdBound : ∀ (n : ℕ) (c a b : ℕ → ℝ) (M_a M_b : ℝ),
      0 ≤ M_b →
      (∀ i ∈ Finset.range n, 0 ≤ c i) →
      (∀ i ∈ Finset.range n, |a i| ≤ M_a) →
      (∀ i ∈ Finset.range n, |b i| ≤ M_b) →
      |∑ i ∈ Finset.range n, c i * a i * b i| ≤
        (∑ i ∈ Finset.range n, c i) * (M_a * M_b) := by
    intro n c a b M_a M_b hMb hc ha hb
    calc
      |∑ i ∈ Finset.range n, c i * a i * b i|
          ≤ ∑ i ∈ Finset.range n, |c i * a i * b i| := Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ i ∈ Finset.range n, c i * (M_a * M_b) := by
          apply Finset.sum_le_sum
          intro i hi
          rw [abs_mul, abs_mul, abs_of_nonneg (hc i hi), mul_assoc]
          exact mul_le_mul_of_nonneg_left
            (mul_le_mul (ha i hi) (hb i hi) (abs_nonneg _)
              (le_trans (abs_nonneg (a i)) (ha i hi)))
            (hc i hi)
      _ = (∑ i ∈ Finset.range n, c i) * (M_a * M_b) := by
          rw [← Finset.sum_mul]
  
  have hStage2 : ∀ (p : ℕ) (ρ : ℝ) (e : ℝ → ℝ),
      1 ≤ p →
      Function.Periodic e (2 * Real.pi) →
      ContDiff ℝ ((p : ℕ) : WithTop ℕ∞) e →
      (∀ x : ℝ, |e x| ≤ 1 / 2 ∧ |deriv e x| ≤ 1 / 2) →
      ContDiff ℝ ((p : ℕ) : WithTop ℕ∞) (hcShiftPerturb ρ e) ∧
      ContDiff ℝ ((p : ℕ) : WithTop ℕ∞) (hcShiftInv ρ e) ∧
      ContDiff ℝ ((p : ℕ) : WithTop ℕ∞) (hcShiftInvDisp ρ e) ∧
      (∀ x : ℝ, hcShiftPerturb ρ e (x + 2 * Real.pi) = hcShiftPerturb ρ e x + 2 * Real.pi) ∧
      (∀ z : ℝ, hcShiftInv ρ e (z + 2 * Real.pi) = hcShiftInv ρ e z + 2 * Real.pi) ∧
      Function.LeftInverse (hcShiftInv ρ e) (hcShiftPerturb ρ e) ∧
      Function.RightInverse (hcShiftInv ρ e) (hcShiftPerturb ρ e) ∧
      (∀ x : ℝ, deriv (hcShiftInv ρ e) (hcShiftPerturb ρ e x) * deriv (hcShiftPerturb ρ e) x = 1) ∧
      (∀ z : ℝ, hcShiftInvDisp ρ e z = -e (hcShiftInv ρ e z)) ∧
      (∀ z : ℝ, (1 + deriv e (hcShiftInv ρ e z)) * deriv (hcShiftInvDisp ρ e) z =
        -deriv e (hcShiftInv ρ e z)) ∧
      (∀ z : ℝ, hcShiftInvDisp ρ e z = hcShiftInvDisp 0 e (z - ρ)) := by
    intro p ρ e hp he_per he_cd he_bnd
    have hp_ne : ((p : ℕ) : WithTop ℕ∞) ≠ 0 := by exact_mod_cast (by omega : p ≠ 0)
    have he_diff : Differentiable ℝ e := he_cd.differentiable hp_ne
    have hCore : ∀ ρ' : ℝ,
        StrictMono (hcShiftPerturb ρ' e) ∧
        ContDiff ℝ ((p : ℕ) : WithTop ℕ∞) (hcShiftPerturb ρ' e) ∧
        ContDiff ℝ ((p : ℕ) : WithTop ℕ∞) (hcShiftInv ρ' e) ∧
        ContDiff ℝ ((p : ℕ) : WithTop ℕ∞) (hcShiftInvDisp ρ' e) ∧
        (∀ x : ℝ, hcShiftPerturb ρ' e (x + 2 * Real.pi) = hcShiftPerturb ρ' e x + 2 * Real.pi) ∧
        (∀ z : ℝ, hcShiftInv ρ' e (z + 2 * Real.pi) = hcShiftInv ρ' e z + 2 * Real.pi) ∧
        Function.LeftInverse (hcShiftInv ρ' e) (hcShiftPerturb ρ' e) ∧
        Function.RightInverse (hcShiftInv ρ' e) (hcShiftPerturb ρ' e) ∧
