        taylor2D (fun q_ab => quotFn (Ψ_ab q_ab)) p₁_ab := by
    rw [(hKit.mvDeriv_rules.2 hU_ab_open hp₁_ab hA_ab_holo).1,
      (hKit.mvDeriv_rules.2 hU_ab_open hp₁_ab hpA_ab_holo).2]
    exact hKit.taylor2D_congr hU_ab_open hp₁_ab (fun q_ab hq_ab =>
      G.symplectic_mixed_deriv q_ab hq_ab)
  have hMixedAct : ∀ d : Fin 2 →₀ ℕ, 1 ≤ d 0 → 1 ≤ d 1 →
      MvPowerSeries.coeff d (taylor2D G.A_point_ab p₁_ab) ∈ K_pt := by
    refine hSer.mixed_of_derivAD_mem K_pt ?_
    rw [hderivAD_eq]
    exact hquot_pull_mem
  exact ⟨hEndJets, hMixedAct⟩

theorem point_core_vandermonde_jet_and_abscissa_elimination (Ω : Set Plane)
    (C : AnalyticGlancingCollar Ω)
    (B : BaseCollarAndCramerData C)
    (k : ℕ) (hk : 2 ≤ k)
    (G : PointGlancingChartData C B k)
    (hKit : Holo2DAndTaylorToolkit)
    (hSer : PointCoreSeriesToolkit)
    (a₁ δ₁ : ℝ)
    (ha₁ : a₁ ∈ Set.Ioo (G.a₀ - G.R / 4) (G.a₀ + G.R / 4))
    (hδ₁ : δ₁ ∈ Set.Ioo 0 G.δ_star)
    (K_base : Subfield ℂ)
    (hEndJets : ∀ m : ℕ,
      iteratedDeriv m G.F (a₁ : ℂ) ∈ K_base ∧
      iteratedDeriv m G.F ((a₁ : ℂ) + (δ₁ : ℂ)) ∈ K_base)
    (hMixedAct : ∀ d : Fin 2 →₀ ℕ, 1 ≤ d 0 → 1 ≤ d 1 →
      MvPowerSeries.coeff d (taylor2D G.A_point_ab ((a₁ : ℂ), (a₁ : ℂ) + (δ₁ : ℂ))) ∈
        K_base) :
    (∀ (r : Fin (k + 1)) (m : ℕ),
      iteratedDeriv m G.F (G.x_fn r ((a₁ : ℂ), (δ₁ : ℂ))) ∈
        Subfield.closure
          ((K_base : Set ℂ) ∪ Set.range (pointCoreTuple C B k G a₁ δ₁))) ∧
    (∀ (r : Fin (k + 1)) (d : Fin 2 →₀ ℕ),
      MvPowerSeries.coeff d
        (centeredTaylor2D (fun q_ab => G.x_fn r (q_ab.1, q_ab.2 - q_ab.1))
          ((a₁ : ℂ), (a₁ : ℂ) + (δ₁ : ℂ))) ∈
        Subfield.closure
          ((K_base : Set ℂ) ∪ Set.range (pointCoreTuple C B k G a₁ δ₁))) ∧
    (∀ d : Fin 2 →₀ ℕ,
      MvPowerSeries.coeff d (taylor2D G.A_point_ab ((a₁ : ℂ), (a₁ : ℂ) + (δ₁ : ℂ))) ∈
        Subfield.closure
          ((K_base : Set ℂ) ∪ Set.range (pointCoreTuple C B k G a₁ δ₁))) :=
by
  let p₁ : ℂ × ℂ := ((a₁ : ℂ), (δ₁ : ℂ))
  let p₁_ab : ℂ × ℂ := ((a₁ : ℂ), (a₁ : ℂ) + (δ₁ : ℂ))
  let σ_ab : ℂ × ℂ → ℂ × ℂ := fun q_ab => (q_ab.1, q_ab.2 - q_ab.1)
  let F_val : Subfield ℂ :=
    Subfield.closure ((K_base : Set ℂ) ∪ Set.range (pointCoreTuple C B k G a₁ δ₁))
  let x_base : Fin (k + 1) → ℂ := fun r => G.x_fn r p₁
  let ℓ_base : Fin k → ℂ := fun i => G.ℓ_fn i p₁
  let S_ser : PowerSeries ℂ := holoTaylor1D sqrt1p 0
  let I_ser : PowerSeries ℂ := holoTaylor1D pointCoreInvSqrt1p 0
  let F_ser : Fin (k + 1) → PowerSeries ℂ := fun r => holoTaylor1D G.F (x_base r)
  let β_ser : Fin (k + 1) → MvPowerSeries (Fin 2) ℂ :=
    fun r => centeredTaylor2D (fun q_ab => G.x_fn r (q_ab.1, q_ab.2 - q_ab.1)) p₁_ab
  
  have h_idx2D : ∀ a b : ℕ, pointCoreIdx2D a b 0 = a ∧ pointCoreIdx2D a b 1 = b :=
    fun _ _ => ⟨rfl, rfl⟩
  have h_idx_single0 : ∀ m : ℕ, pointCoreIdx2D m 0 = Finsupp.single 0 m := fun m =>
    Finsupp.ext (Fin.forall_fin_two.mpr
      ⟨by simp [(h_idx2D m 0).1], by simp [(h_idx2D m 0).2]⟩)
  have h_idx_single1 : ∀ m : ℕ, pointCoreIdx2D 0 m = Finsupp.single 1 m := fun m =>
    Finsupp.ext (Fin.forall_fin_two.mpr
      ⟨by simp [(h_idx2D 0 m).1], by simp [(h_idx2D 0 m).2]⟩)
  have h_deg0_eq : ∀ u : Fin 2 →₀ ℕ, u 0 + u 1 ≤ 0 → u = 0 := fun u hu =>
    Finsupp.ext (Fin.forall_fin_two.mpr ⟨by simp; omega, by simp; omega⟩)
  have hC2_ps : (MvPowerSeries.C (2 : ℂ) : MvPowerSeries (Fin 2) ℂ) = 2 := by
    rw [show (2 : ℂ) = 1 + 1 by norm_num, map_add, map_one]
    norm_num
  have h_sq_mem : ∀ (L : Subfield ℂ) {S : MvPowerSeries (Fin 2) ℂ},
      pointCoreCoeffsIn L S → pointCoreCoeffsIn L (S ^ 2) := by
    intro L S hS
    rw [sq]; exact hSer.mul_mem L hS hS
  have hX_10_0 : MvPowerSeries.coeff (pointCoreIdx2D 1 0)
      (MvPowerSeries.X (0 : Fin 2) : MvPowerSeries (Fin 2) ℂ) = 1 := by
    rw [MvPowerSeries.coeff_X, if_pos (h_idx_single0 1)]
  have hX_10_1 : MvPowerSeries.coeff (pointCoreIdx2D 1 0)
      (MvPowerSeries.X (1 : Fin 2) : MvPowerSeries (Fin 2) ℂ) = 0 := by
    rw [MvPowerSeries.coeff_X, if_neg]
    intro h; have h0 := congr_arg (fun u : Fin 2 →₀ ℕ => u 0) h
    simp [(h_idx2D 1 0).1] at h0
  have hX_01_0 : MvPowerSeries.coeff (pointCoreIdx2D 0 1)
      (MvPowerSeries.X (0 : Fin 2) : MvPowerSeries (Fin 2) ℂ) = 0 := by
    rw [MvPowerSeries.coeff_X, if_neg]
    intro h; have h1 := congr_arg (fun u : Fin 2 →₀ ℕ => u 1) h
    simp [(h_idx2D 0 1).2] at h1
  have hX_01_1 : MvPowerSeries.coeff (pointCoreIdx2D 0 1)
      (MvPowerSeries.X (1 : Fin 2) : MvPowerSeries (Fin 2) ℂ) = 1 := by
    rw [MvPowerSeries.coeff_X, if_pos (h_idx_single1 1)]
  have h_tay_const : ∀ {W : Set (ℂ × ℂ)} {p₀ : ℂ × ℂ},
      IsOpen W → p₀ ∈ W → ∀ c : ℂ, taylor2D (fun _ => c) p₀ = MvPowerSeries.C c := by
    intro W p₀ hW hp₀ c
    exact (hKit.taylor2D_algebra hW hp₀).1 c
  have h_tay_add : ∀ {W : Set (ℂ × ℂ)} {p₀ : ℂ × ℂ},
      IsOpen W → p₀ ∈ W → ∀ {f g : ℂ × ℂ → ℂ},
      DifferentiableOn ℂ f W → DifferentiableOn ℂ g W →
      taylor2D (fun p => f p + g p) p₀ = taylor2D f p₀ + taylor2D g p₀ := by
    intro W p₀ hW hp₀ f g hf hg
    exact ((hKit.taylor2D_algebra hW hp₀).2 hf hg).1
  have h_tay_sub : ∀ {W : Set (ℂ × ℂ)} {p₀ : ℂ × ℂ},
      IsOpen W → p₀ ∈ W → ∀ {f g : ℂ × ℂ → ℂ},
      DifferentiableOn ℂ f W → DifferentiableOn ℂ g W →
      taylor2D (fun p => f p - g p) p₀ = taylor2D f p₀ - taylor2D g p₀ := by
    intro W p₀ hW hp₀ f g hf hg
    exact ((hKit.taylor2D_algebra hW hp₀).2 hf hg).2.1
  have h_tay_mul : ∀ {W : Set (ℂ × ℂ)} {p₀ : ℂ × ℂ},
      IsOpen W → p₀ ∈ W → ∀ {f g : ℂ × ℂ → ℂ},
      DifferentiableOn ℂ f W → DifferentiableOn ℂ g W →
      taylor2D (fun p => f p * g p) p₀ = taylor2D f p₀ * taylor2D g p₀ := by
    intro W p₀ hW hp₀ f g hf hg
    exact ((hKit.taylor2D_algebra hW hp₀).2 hf hg).2.2
  have hd_const : ∀ (W : Set (ℂ × ℂ)) (c : ℂ),
      DifferentiableOn ℂ (fun _ => c) W :=
    fun _ c => differentiableOn_const c
  have hd_add : ∀ {W : Set (ℂ × ℂ)} {f g : ℂ × ℂ → ℂ},
      DifferentiableOn ℂ f W → DifferentiableOn ℂ g W →
      DifferentiableOn ℂ (fun p => f p + g p) W :=
    fun hf hg => hf.add hg
  have hd_sub : ∀ {W : Set (ℂ × ℂ)} {f g : ℂ × ℂ → ℂ},
      DifferentiableOn ℂ f W → DifferentiableOn ℂ g W →
      DifferentiableOn ℂ (fun p => f p - g p) W :=
    fun hf hg => hf.sub hg
  have hd_mul : ∀ {W : Set (ℂ × ℂ)} {f g : ℂ × ℂ → ℂ},
      DifferentiableOn ℂ f W → DifferentiableOn ℂ g W →
      DifferentiableOn ℂ (fun p => f p * g p) W :=
    fun hf hg => hf.mul hg
  have hd_sq : ∀ {W : Set (ℂ × ℂ)} {f : ℂ × ℂ → ℂ},
      DifferentiableOn ℂ f W → DifferentiableOn ℂ (fun p => (f p) ^ 2) W :=
    fun hf => hf.pow 2
  have hd_comp1 : ∀ {W : Set (ℂ × ℂ)} {B_s : Set ℂ} {g : ℂ → ℂ} {f : ℂ × ℂ → ℂ},
      DifferentiableOn ℂ g B_s → DifferentiableOn ℂ f W → (∀ p ∈ W, f p ∈ B_s) →
      DifferentiableOn ℂ (fun p => g (f p)) W :=
    fun hg hf hm => hg.comp hf hm
  have h_nat_mem : ∀ (L : Subfield ℂ) (n : ℕ), (n : ℂ) ∈ L := fun L n => by
    induction n with
    | zero => simpa using L.zero_mem
    | succ m ih => rw [Nat.cast_succ]; exact L.add_mem ih L.one_mem
  have hK_le : K_base ≤ F_val := fun z hz => Subfield.subset_closure (Or.inl hz)
  have h_coeff0_C : ∀ c : ℂ,
      MvPowerSeries.coeff (0 : Fin 2 →₀ ℕ) (MvPowerSeries.C c) = c := by
    intro c
    simp [MvPowerSeries.coeff_C]
  have h_coeff0_comp : ∀ (f : PowerSeries ℂ) (U : MvPowerSeries (Fin 2) ℂ),
      MvPowerSeries.coeff 0 U = 0 →
      MvPowerSeries.coeff 0 (compPowerSeries2D f U) = PowerSeries.coeff 0 f := by
    intro f U _
    rw [MvPowerSeries.coeff_apply]
    simp [compPowerSeries2D]
  have h_comp_C_mul : ∀ (c : ℂ) (f : PowerSeries ℂ) (U : MvPowerSeries (Fin 2) ℂ),
      compPowerSeries2D (PowerSeries.C c * f) U =
        MvPowerSeries.C c * compPowerSeries2D f U := by
    intro c f U
    ext u
    rw [MvPowerSeries.coeff_C_mul, MvPowerSeries.coeff_apply, MvPowerSeries.coeff_apply]
    simp only [compPowerSeries2D, PowerSeries.coeff_C_mul, Finset.mul_sum, mul_assoc]
  have h_vb_zero : ∀ S : MvPowerSeries (Fin 2) ℂ, pointCoreVanishesBelow 0 S := by
    intro S u hu; omega
  have h_vb_mono : ∀ {N₁ N₂ : ℕ} {S : MvPowerSeries (Fin 2) ℂ},
      N₁ ≤ N₂ → pointCoreVanishesBelow N₂ S → pointCoreVanishesBelow N₁ S :=
    fun hle hS u hu => hS u (lt_of_lt_of_le hu hle)
  have h_vb_add : ∀ {N : ℕ} {A B_s : MvPowerSeries (Fin 2) ℂ},
      pointCoreVanishesBelow N A → pointCoreVanishesBelow N B_s →
      pointCoreVanishesBelow N (A + B_s) := by
    intro N A B_s hA hB u hu
    rw [map_add, hA u hu, hB u hu, add_zero]
  have h_vb_sub : ∀ {N : ℕ} {A B_s : MvPowerSeries (Fin 2) ℂ},
      pointCoreVanishesBelow N A → pointCoreVanishesBelow N B_s →
      pointCoreVanishesBelow N (A - B_s) := by
    intro N A B_s hA hB u hu
    rw [map_sub, hA u hu, hB u hu, sub_self]
  have h_vb_C_mul : ∀ {N : ℕ} (c : ℂ) {A : MvPowerSeries (Fin 2) ℂ},
      pointCoreVanishesBelow N A → pointCoreVanishesBelow N (MvPowerSeries.C c * A) := by
    intro N c A hA u hu
    rw [MvPowerSeries.coeff_C_mul, hA u hu, mul_zero]
  have h_vb_pow_sub : ∀ (N m : ℕ) (U V : MvPowerSeries (Fin 2) ℂ),
      pointCoreVanishesBelow N (U - V) → pointCoreVanishesBelow N (U ^ m - V ^ m) := by
    intro N m U V hUV
    induction m with
    | zero =>
        intro u _
        simp
    | succ m ih =>
        have h_id : U ^ (m + 1) - V ^ (m + 1) = (U - V) * U ^ m + V * (U ^ m - V ^ m) := by
          ring
        rw [h_id]
        have h1 : pointCoreVanishesBelow N ((U - V) * U ^ m) := by
          simpa using hSer.vanishesBelow_mul hUV (h_vb_zero (U ^ m))
        have h2 : pointCoreVanishesBelow N (V * (U ^ m - V ^ m)) := by
          simpa using hSer.vanishesBelow_mul (h_vb_zero V) ih
        exact h_vb_add h1 h2
  have h_vb_comp_sub : ∀ (N : ℕ) (f : PowerSeries ℂ) (U V : MvPowerSeries (Fin 2) ℂ),
      pointCoreVanishesBelow N (U - V) →
      pointCoreVanishesBelow N (compPowerSeries2D f U - compPowerSeries2D f V) := by
    intro N f U V hUV u hu
    rw [map_sub, MvPowerSeries.coeff_apply, MvPowerSeries.coeff_apply]
    dsimp only [compPowerSeries2D]
    rw [← Finset.sum_sub_distrib]
    refine Finset.sum_eq_zero fun m _ => ?_
    rw [← mul_sub]
    have hm := h_vb_pow_sub N m U V hUV u hu
    rw [map_sub] at hm
    rw [hm, mul_zero]
  have h_comp_trunc1D : ∀ (K : ℕ) (f : PowerSeries ℂ) (U : MvPowerSeries (Fin 2) ℂ)
      (u : Fin 2 →₀ ℕ), u 0 + u 1 ≤ K →
      MvPowerSeries.coeff u (compPowerSeries2D (pcJetTrunc1D K f) U) =
        MvPowerSeries.coeff u (compPowerSeries2D f U) := by
    intro K f U u hu
    rw [MvPowerSeries.coeff_apply, MvPowerSeries.coeff_apply]
    dsimp only [compPowerSeries2D]
    refine Finset.sum_congr rfl fun m hm => ?_
    rw [Finset.mem_range] at hm
    have hmK : m ≤ K := by omega
    simp [pcJetTrunc1D, hmK]
  have h_comp_deriv_trunc1D : ∀ (K : ℕ) (f : PowerSeries ℂ) (U : MvPowerSeries (Fin 2) ℂ)
      (u : Fin 2 →₀ ℕ), u 0 + u 1 ≤ K →
      MvPowerSeries.coeff u (compPowerSeries2D (PowerSeries.derivative (pcJetTrunc1D (K + 1) f)) U) =
        MvPowerSeries.coeff u (compPowerSeries2D (PowerSeries.derivative f) U) := by
    intro K f U u hu
    rw [MvPowerSeries.coeff_apply, MvPowerSeries.coeff_apply]
    dsimp only [compPowerSeries2D]
    refine Finset.sum_congr rfl fun m hm => ?_
    rw [Finset.mem_range] at hm
    have hmK : m + 1 ≤ K + 1 := by omega
    congr 1
    rw [PowerSeries.coeff_derivative, PowerSeries.coeff_derivative]
    simp [pcJetTrunc1D, hmK]
  
  have h_deriv_holoTaylor1D : ∀ (g : ℂ → ℂ) (z₀ : ℂ),
      PowerSeries.derivative (holoTaylor1D g z₀) = holoTaylor1D (deriv g) z₀ := by
    intro g z₀
    ext n
    rw [PowerSeries.coeff_derivative]
    simp only [holoTaylor1D, PowerSeries.coeff_mk, iteratedDeriv_succ', Nat.factorial_succ,
      Nat.cast_mul]
    have hn1 : ((n : ℂ) + 1) ≠ 0 := Nat.cast_add_one_ne_zero n
    field_simp [hn1]
    push_cast
    ring
  let B₀ : Set ℂ := Metric.ball (0 : ℂ) (1 / 2)
  have hB₀_open : IsOpen B₀ := Metric.isOpen_ball
  have h0_mem_B₀ : (0 : ℂ) ∈ B₀ := Metric.mem_ball_self (by norm_num)
  have h_sqrt_zero : sqrt1p 0 = 1 := by
    simp [sqrt1p]
  have h_invSqrt_zero : pointCoreInvSqrt1p 0 = 1 := by
    simp [pointCoreInvSqrt1p, h_sqrt_zero]
  have h_sqrt_ne : ∀ w : ℂ, sqrt1p w ≠ 0 := fun _ => Complex.exp_ne_zero _
  have h_sqrt_mul_inv : ∀ w : ℂ, sqrt1p w * pointCoreInvSqrt1p w = 1 :=
    fun w => mul_inv_cancel₀ (h_sqrt_ne w)
  have h_sqrt_ball : ∀ w ∈ B₀,
      (sqrt1p w) ^ 2 = 1 + w ∧
      HasDerivAt sqrt1p ((1 / 2 : ℂ) * pointCoreInvSqrt1p w) w := by
    intro w hw
    rw [Metric.mem_ball, dist_zero_right] at hw
    have habs : |w.re| ≤ ‖w‖ := Complex.abs_re_le_norm w
    have hw_re : -1 / 2 < w.re := by linarith [(abs_le.mp habs).1]
    have h1w_re : 0 < (1 + w).re := by simp; linarith
    have h1w_slit : 1 + w ∈ Complex.slitPlane := Complex.mem_slitPlane_iff.mpr (Or.inl h1w_re)
    have h1w_ne : 1 + w ≠ 0 := by
      intro h0; rw [h0, Complex.zero_re] at h1w_re; exact lt_irrefl 0 h1w_re
    have h_sq : (sqrt1p w) ^ 2 = 1 + w := by
      unfold sqrt1p
      rw [sq, ← Complex.exp_add, add_halves, Complex.exp_log h1w_ne]
    refine ⟨h_sq, ?_⟩
    have hd_add : HasDerivAt (fun z : ℂ => 1 + z) 1 w := by
      simpa using (hasDerivAt_id w).const_add (1 : ℂ)
    have hd_log : HasDerivAt (fun z : ℂ => Complex.log (1 + z)) (1 / (1 + w)) w := by
      simpa using hd_add.clog h1w_slit
    have hd_div : HasDerivAt (fun z : ℂ => Complex.log (1 + z) / 2) ((1 / (1 + w)) / 2) w :=
      hd_log.div_const 2
    have hd_exp : HasDerivAt sqrt1p (sqrt1p w * ((1 / (1 + w)) / 2)) w :=
      hd_div.cexp
    have h_ne : sqrt1p w ≠ 0 := h_sqrt_ne w
    have h_val : sqrt1p w * ((1 / (1 + w)) / 2) = (1 / 2 : ℂ) * pointCoreInvSqrt1p w := by
      unfold pointCoreInvSqrt1p
      rw [← h_sq]
      field_simp [h_ne]
    exact h_val ▸ hd_exp
  have h_sqrt_holo : DifferentiableOn ℂ sqrt1p B₀ :=
    fun w hw => ((h_sqrt_ball w hw).2).differentiableAt.differentiableWithinAt
  have h_invSqrt_holo : DifferentiableOn ℂ pointCoreInvSqrt1p B₀ :=
    h_sqrt_holo.inv (fun w _ => h_sqrt_ne w)
  have h_deriv_sqrt_eq : ∀ w ∈ B₀, deriv sqrt1p w = (1 / 2 : ℂ) * pointCoreInvSqrt1p w :=
    fun w hw => ((h_sqrt_ball w hw).2).deriv
  have hS_c0 : PowerSeries.coeff 0 S_ser = 1 := by
    simp [S_ser, holoTaylor1D, h_sqrt_zero]
  have hS_c1 : PowerSeries.coeff 1 S_ser = 1 / 2 := by
    simp [S_ser, holoTaylor1D, iteratedDeriv_one, h_deriv_sqrt_eq 0 h0_mem_B₀, h_invSqrt_zero]
  have hI_c0 : PowerSeries.coeff 0 I_ser = 1 := by
    simp [I_ser, holoTaylor1D, h_invSqrt_zero]
  have h_comp_X0_coeff : ∀ (f : PowerSeries ℂ) (n : ℕ),
      MvPowerSeries.coeff (pointCoreIdx2D n 0) (compPowerSeries2D f (MvPowerSeries.X 0)) =
        PowerSeries.coeff n f := by
    intro f n
    rw [MvPowerSeries.coeff_apply]
    dsimp only [compPowerSeries2D]
    rw [(h_idx2D n 0).1, (h_idx2D n 0).2, add_zero]
    have h_single : ∀ m : ℕ, (pointCoreIdx2D n 0 = Finsupp.single 0 m) ↔ m = n := by
      intro m
      constructor
      · intro h
        have h0 := congr_arg (fun u : Fin 2 →₀ ℕ => u 0) h
        simpa [(h_idx2D n 0).1] using h0.symm
      · rintro rfl
        exact h_idx_single0 m
    simp [MvPowerSeries.coeff_X_pow, h_single]
  have hSI_pair :
      PowerSeries.derivative S_ser = PowerSeries.C (1 / 2 : ℂ) * I_ser ∧
      PowerSeries.coeff 1 I_ser = -(1 / 2 : ℂ) ∧
      (∀ (L : Subfield ℂ) (n : ℕ),
        PowerSeries.coeff n S_ser ∈ L ∧ PowerSeries.coeff n I_ser ∈ L) := by
    let U₀ : Set (ℂ × ℂ) := B₀ ×ˢ B₀
    have hU₀_open : IsOpen U₀ := hB₀_open.prod hB₀_open
    have h00_mem : ((0 : ℂ), (0 : ℂ)) ∈ U₀ := ⟨h0_mem_B₀, h0_mem_B₀⟩
    have hfst_holo : DifferentiableOn ℂ Prod.fst U₀ := differentiable_fst.differentiableOn
    have hfst_maps : ∀ p ∈ U₀, p.1 ∈ B₀ := fun _ hp => hp.1
    have hfst_tay : taylor2D Prod.fst ((0 : ℂ), (0 : ℂ)) = MvPowerSeries.X 0 := by
      have hc := hSer.centeredTaylor2D_fst ((0 : ℂ), (0 : ℂ))
      simpa [centeredTaylor2D] using hc
    have hS_tay : taylor2D (fun p : ℂ × ℂ => sqrt1p p.1) ((0 : ℂ), (0 : ℂ)) =
        compPowerSeries2D S_ser (MvPowerSeries.X 0) := by
      rw [hKit.taylor2D_comp_1D hU₀_open hB₀_open h00_mem hfst_holo h_sqrt_holo hfst_maps,
        hSer.centeredTaylor2D_fst]
    have hI_tay : taylor2D (fun p : ℂ × ℂ => pointCoreInvSqrt1p p.1) ((0 : ℂ), (0 : ℂ)) =
        compPowerSeries2D I_ser (MvPowerSeries.X 0) := by
      rw [hKit.taylor2D_comp_1D hU₀_open hB₀_open h00_mem hfst_holo h_invSqrt_holo hfst_maps,
        hSer.centeredTaylor2D_fst]
    have h_deriv_sqrt_holo : DifferentiableOn ℂ (deriv sqrt1p) B₀ :=
      ((differentiableOn_const (1 / 2 : ℂ)).mul h_invSqrt_holo).congr
        (fun w hw => h_deriv_sqrt_eq w hw)
    have h_deriv_S_eq : PowerSeries.derivative S_ser = PowerSeries.C (1 / 2 : ℂ) * I_ser := by
      rw [h_deriv_holoTaylor1D]
