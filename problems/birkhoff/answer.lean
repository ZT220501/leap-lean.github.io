      have hlin := Real.exp_le_exp.mp hexp_le
      rw [div_mul_eq_mul_div, le_div_iff₀ hlog2_pos]
      linarith
    refine ⟨q, N, a, G, hN_bound, h_sq_sub, hG_U₀.mono h_30_U₀, hG_nz,
      fun z hz => hG_cb z (h_30_cb hz), hGq_low, ?_⟩
    intro z hz_15
    have hz_U₀ : z ∈ U₀ := by
      rw [Metric.mem_closedBall] at hz_15
      rw [Metric.mem_ball]
      linarith
    rw [hFG_fac z hz_U₀, norm_mul, h_norm_prod]
    have hprod_low : (2 / (135 * ρ)) ^ N * (∏ i : Fin N, ‖z - a i‖) ≤
        ∏ i : Fin N, ‖B_fn (a i) z‖ := by
      calc (2 / (135 * ρ)) ^ N * (∏ i : Fin N, ‖z - a i‖)
          = (∏ _i : Fin N, (2 / (135 * ρ))) * (∏ i : Fin N, ‖z - a i‖) := by
              rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
        _ = ∏ i : Fin N, ((2 / (135 * ρ)) * ‖z - a i‖) := Finset.prod_mul_distrib.symm
        _ ≤ ∏ i : Fin N, ‖B_fn (a i) z‖ :=
            h_prod_le _ _ (fun _ => by positivity)
              (fun i => hB_lower (a i) (ha_mem i) z hz_15)
    rw [mul_assoc]
    exact mul_le_mul_of_nonneg_left hprod_low (norm_nonneg _)
  have finite_boutroux_cartan_covering
      (N : ℕ) (δ : ℝ) (hδ : 0 < δ) (a : Fin N → ℂ) :
      ∃ (r : Fin N → ℝ),
        (∀ j : Fin N, 0 ≤ r j) ∧
        (∑ j : Fin N, r j) ≤ 3 * δ ∧
        ∀ z : ℂ, (∀ j : Fin N, z ∉ Metric.ball (a j) (r j)) →
          (δ / Real.exp 1) ^ N ≤ ∏ i : Fin N, ‖z - a i‖ := by
    classical
    rcases Nat.eq_zero_or_pos N with rfl | hN_pos
    · refine ⟨fun _ => 0, fun j => Fin.elim0 j, by simp; positivity, ?_⟩
      intro _ _; simp
    · have hN_real : 0 < (N : ℝ) := Nat.cast_pos.mpr hN_pos
      let T_set : ℂ → ℕ → Finset (Fin N) := fun z i =>
        Finset.univ.filter (fun μ => ‖z - a μ‖ < δ * (i : ℝ) / (N : ℝ))
      have h_greedy : ∀ (n : ℕ) (S : Finset (Fin N)), S.card = n →
