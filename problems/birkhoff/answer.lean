                F k) +
            (∑ k ∈ Finset.range (α + β + 1),
              taylor2D (fun p =>
                webDiffCoeff (pderivA (ψ i)) (pderivD (ψ i)) (w i) α β k p *
                  pderivD (ψ i) p) p₁ * F (k + 1)) := by
              congr 1
              rw [Finset.sum_range_succ, hC_vanish i α β (α + β + 1) (by omega), hpderivD_zero,
                (hKit.taylor2D_algebra hU_inter hp₁).1 0, map_zero, zero_mul, add_zero]

  
  let C_diff : Fin m → Fin m × Fin m → ℂ × ℂ → ℂ :=
    fun r col p =>
      webDiffCoeff (pderivA (ψ col.1)) (pderivD (ψ col.1)) (w col.1)
        (m - r.val) r.val col.2.val p
  let K_mat : ℂ × ℂ → Fin m → Fin m × Fin m → ℂ :=
    fun p i col =>
      -∑ r : Fin m, (webVandermondeMat ψ w p)⁻¹ i r * C_diff r col p
  let d_vec : ℂ × ℂ → Fin m → ℂ :=
    fun p i =>
      ∑ r : Fin m, (webVandermondeMat ψ w p)⁻¹ i r *
        iterDerivYT (m - r.val) r.val B p
  let M_base : ℂ × ℂ → Fin m × Fin m → Fin m × Fin m → ℂ :=
    fun p idx col =>
      if h : idx.2.val + 1 < m then
        if col = (idx.1, ⟨idx.2.val + 1, h⟩) then 1 else 0
      else
        K_mat p idx.1 col
  let c_base : ℂ × ℂ → Fin m × Fin m → ℂ :=
    fun p idx =>
      if idx.2.val + 1 < m then 0 else d_vec p idx.1
  let M_a : ℂ × ℂ → Matrix (Fin m × Fin m) (Fin m × Fin m) ℂ :=
    fun p => Matrix.of fun idx col => pderivA (ψ idx.1) p * M_base p idx col
  let M_δ : ℂ × ℂ → Matrix (Fin m × Fin m) (Fin m × Fin m) ℂ :=
    fun p => Matrix.of fun idx col => pderivD (ψ idx.1) p * M_base p idx col
  let c_a : ℂ × ℂ → Fin m × Fin m → ℂ :=
    fun p idx => pderivA (ψ idx.1) p * c_base p idx
  let c_δ : ℂ × ℂ → Fin m × Fin m → ℂ :=
    fun p idx => pderivD (ψ idx.1) p * c_base p idx
  have hCdiff_ode : ∀ (r : Fin m) (col : Fin m × Fin m),
      DifferentiableOn ℂ (C_diff r col) (webODEDomain ψ w U₀ U_plus) :=
    fun r col => (hC_holo col.1 (m - r.val) r.val col.2.val).mono hode_inter
  have hBiter_ode : ∀ r : Fin m,
      DifferentiableOn ℂ (iterDerivYT (m - r.val) r.val B) (webODEDomain ψ w U₀ U_plus) :=
    fun r => (hKit.iterDerivYT_holo hU_plus hB_holo (m - r.val) r.val).mono hode_Up
  have hK_ode : ∀ (i : Fin m) (col : Fin m × Fin m),
