      have hω_eq : starRingEnd ℂ (ω_vec i (starRingEnd ℂ z)) = ω_vec i z := by
        fin_cases i <;>
          simp [ω_vec, hf_conj z hz.1, hϕ_conj z hz.1, ← Complex.sin_conj, ← Complex.cos_conj]
      rw [hω_eq] at hd1
      have h0 : ω_vec i z - ω_vec i z = 0 := sub_self _
      exact h0 ▸ hd1.sub hd2
    have hs_reg : s ∈ D_reg := by rw [hD_reg_eq]; exact ⟨hsD, hfs⟩
    have hconst := hD_reg_open.is_const_of_deriv_eq_zero hD_reg_pre
      (fun z hz => (hQi_deriv z hz).differentiableAt.differentiableWithinAt)
      (fun z hz => (hQi_deriv z hz).deriv) hs_reg h0_in_reg
    dsimp [Q_i] at hconst
    rw [map_zero, hΓ_0_conj i, sub_self] at hconst
    have heq := sub_eq_zero.mp hconst
    have heq' := congr_arg (starRingEnd ℂ) heq
    rwa [Complex.conj_conj] at heq'
  exact ⟨{
    a := a
    ϕ := ϕ
    f := f
    a_holo := ha_holo
    ϕ_holo := hϕ_holo
    f_holo := hf_holo
    a_ne_zero := ha_ne_zero
    deriv_ϕ := hderiv_ϕ
    exp_ϕ := hexp_ϕ
    deriv_a := hderiv_a
    base_ϕ_eq := hbase_ϕ_eq
    ϕ_quasiperiodic := hϕ_quasiperiodic
    f_periodic := hf_periodic
    a_periodic := ha_periodic
    ϕ_conj := hϕ_conj
    f_conj := hf_conj
    f_real_pos := hf_real_pos
    f_base_ne_zero := hf_base_ne_zero
    f_nonconstant := hf_nonconstant
    Γ := Γ
    Γ_mero := hΓ_mero
    Γ_reg_holo := fun s hs hfs =>
      ⟨(hΓ_hasDeriv s hs hfs 0).differentiableAt, (hΓ_hasDeriv s hs hfs 1).differentiableAt⟩
    Γ_deriv₀ := fun s hs hfs => (hΓ_hasDeriv s hs hfs 0).deriv
    Γ_deriv₁ := fun s hs hfs => (hΓ_hasDeriv s hs hfs 1).deriv
    Γ_periodic := hΓ_periodic
    Γ_conj := hΓ_conj
    Γ_base_eq := hΓ_base_eq
    Γ_slice_eq := fun s hs hsE _ => hΓ_reg_eq s hs hsE
    Γ_real_simple := fun x₁ x₂ hΓ => by
      rw [hΓ_base_eq x₁ (hreal_in_base x₁), hΓ_base_eq x₂ (hreal_in_base x₂)] at hΓ
      exact h_real_simple x₁ x₂ hΓ
    no_1d_patch_Γ := hno_1d_patch
    s_init := s_init
    r_init := r_init
    s_init_pos := hs_init_pos
    s_init_le := hs_init_le_base
    r_init_pos := hr_init_pos
    r_init_lt := hr_init_lt
    r_init_le := hr_init_le
    𝔰_init := 𝔰_init
    𝔰_init_holo := h𝔰_holo
    𝔰_init_maps_to := h𝔰_maps_to
    𝔰_init_ϕ := fun y t hy ht =>
      (hbase_ϕ_eq _ (h𝔰_maps_to y t hy ht)).1.trans (h𝔰_ϕ_ℂ y t hy ht)
    𝔰_init_impact := fun y t hy ht =>
      (h𝔰_impact y t hy ht).trans (hΓ_base_eq _ (h𝔰_maps_to y t hy ht)).symm
    𝔰_init_zero := h𝔰_zero
    𝔰_init_quasiperiodic := h𝔰_quasi
    𝔰_init_even := h𝔰_even
    𝔰_init_conj := h𝔰_conj
  }⟩

theorem regular_locus_and_sixth_root_system (Ω : Set Plane)
    (C : AnalyticGlancingCollar Ω)
    (M : MeromorphicCollarData C)
    (K : NonisotropicCurveData C M) :
    Nonempty (RegularCollarLocusData C M K) :=
by
  
  have hTool : rl6_Holo2DRegularToolkit := by
    have heq2D : ∀ {W : Set (ℂ × ℂ)} {f g : ℂ × ℂ → ℂ} {p₀ : ℂ × ℂ} {r₀ : ℝ},
        IsOpen W → IsPreconnected W → DifferentiableOn ℂ f W → DifferentiableOn ℂ g W →
        p₀ ∈ W → 0 < r₀ → Metric.ball p₀ r₀ ⊆ W →
        (∀ q ∈ Metric.ball p₀ r₀, f q = g q) → ∀ p ∈ W, f p = g p := by
      intro W f g p₀ r₀ hW_open hW_pre hf hg hp₀ hr₀ hball_sub heq_ball
      let h : ℂ × ℂ → ℂ := fun p => f p - g p
      have hh : DifferentiableOn ℂ h W := hf.sub hg
      let U₀ : Set (ℂ × ℂ) :=
        { p : ℂ × ℂ | ∃ r : ℝ, 0 < r ∧ Metric.ball p r ⊆ W ∧ ∀ q ∈ Metric.ball p r, h q = 0 }
      have hU₀_open : IsOpen U₀ := by
        rw [Metric.isOpen_iff]
        rintro p ⟨r, hr, hr_sub, hzero⟩
        refine ⟨r, hr, fun p' hp' => ?_⟩
        have hdist : dist p' p < r := Metric.mem_ball.mp hp'
        have hr' : 0 < r - dist p' p := sub_pos.mpr hdist
        have hsub' : Metric.ball p' (r - dist p' p) ⊆ Metric.ball p r :=
          Metric.ball_subset_ball' (by linarith)
        exact ⟨r - dist p' p, hr', hsub'.trans hr_sub, fun q hq => hzero q (hsub' hq)⟩
      have hU₀_ne : (W ∩ U₀).Nonempty :=
        ⟨p₀, hp₀, r₀, hr₀, hball_sub, fun q hq => sub_eq_zero.mpr (heq_ball q hq)⟩
      have hU₀_cl : closure U₀ ∩ W ⊆ U₀ := by
        rintro p₁ ⟨hp₁_cl, hp₁_W⟩
        obtain ⟨δ₂, hδ₂_pos, hδ₂_sub⟩ := Metric.isOpen_iff.mp hW_open p₁ hp₁_W
        let δ : ℝ := δ₂ / 2
        have hδ_pos : 0 < δ := half_pos hδ₂_pos
        have h2δ_sub : Metric.ball p₁ (2 * δ) ⊆ W := by
          have : 2 * δ = δ₂ := by ring
          rwa [this]
        obtain ⟨p₂, hp₂_U₀, hdist₁₂⟩ := Metric.mem_closure_iff.mp hp₁_cl δ hδ_pos
        obtain ⟨r₂, hr₂_pos, _, hzero₂⟩ := hp₂_U₀
        refine ⟨δ, hδ_pos, (Metric.ball_subset_ball (by linarith)).trans h2δ_sub, fun q hq => ?_⟩
        let γ : ℂ → ℂ × ℂ := fun z => (p₂.1 + z * (q.1 - p₂.1), p₂.2 + z * (q.2 - p₂.2))
        have hγ_diff : Differentiable ℂ γ :=
          ((differentiable_const p₂.1).add (differentiable_id.mul (differentiable_const _))).prodMk
            ((differentiable_const p₂.2).add (differentiable_id.mul (differentiable_const _)))
        have hγ0 : γ 0 = p₂ := by ext <;> simp [γ]
        have hγ1 : γ 1 = q := by ext <;> simp [γ]
        let D : Set ℂ := γ ⁻¹' Metric.ball p₁ (2 * δ)
        have hD_open : IsOpen D := Metric.isOpen_ball.preimage hγ_diff.continuous
        have h0_D : (0 : ℂ) ∈ D := by
          change γ 0 ∈ Metric.ball p₁ (2 * δ)
          rw [hγ0, Metric.mem_ball, dist_comm]
          linarith
        have h1_D : (1 : ℂ) ∈ D := by
          change γ 1 ∈ Metric.ball p₁ (2 * δ)
          rw [hγ1, Metric.mem_ball]
          have hq' : dist q p₁ < δ := Metric.mem_ball.mp hq
          linarith
        have hD_conv : Convex ℝ D := by
          intro z₁ hz₁ z₂ hz₂ u v hu hv huv
          change γ (u • z₁ + v • z₂) ∈ Metric.ball p₁ (2 * δ)
          have huv_ℂ : (u : ℂ) + (v : ℂ) = 1 := by exact_mod_cast huv
          have hγ_aff : γ (u • z₁ + v • z₂) = u • γ z₁ + v • γ z₂ := by
            ext <;> simp only [γ, Prod.smul_fst, Prod.smul_snd, Prod.fst_add, Prod.snd_add,
              Complex.real_smul]
            · calc p₂.1 + ((u : ℂ) * z₁ + (v : ℂ) * z₂) * (q.1 - p₂.1)
                  = ((u : ℂ) + (v : ℂ)) * p₂.1 + ((u : ℂ) * z₁ + (v : ℂ) * z₂) * (q.1 - p₂.1) := by
                    rw [huv_ℂ, one_mul]
                _ = (u : ℂ) * (p₂.1 + z₁ * (q.1 - p₂.1)) + (v : ℂ) * (p₂.1 + z₂ * (q.1 - p₂.1)) := by
                    ring
            · calc p₂.2 + ((u : ℂ) * z₁ + (v : ℂ) * z₂) * (q.2 - p₂.2)
                  = ((u : ℂ) + (v : ℂ)) * p₂.2 + ((u : ℂ) * z₁ + (v : ℂ) * z₂) * (q.2 - p₂.2) := by
                    rw [huv_ℂ, one_mul]
                _ = (u : ℂ) * (p₂.2 + z₁ * (q.2 - p₂.2)) + (v : ℂ) * (p₂.2 + z₂ * (q.2 - p₂.2)) := by
                    ring
          rw [hγ_aff]
          exact convex_ball p₁ (2 * δ) hz₁ hz₂ hu hv huv
        have hg_diff : DifferentiableOn ℂ (h ∘ γ) D :=
          hh.comp hγ_diff.differentiableOn (fun z hz => h2δ_sub hz)
        have hg_ana : AnalyticOnNhd ℂ (h ∘ γ) D := hg_diff.analyticOnNhd hD_open
        have hev : (h ∘ γ) =ᶠ[nhds 0] 0 := by
          have hnhds : γ ⁻¹' Metric.ball p₂ r₂ ∈ nhds (0 : ℂ) := by
            apply hγ_diff.continuous.continuousAt.preimage_mem_nhds
            rw [hγ0]
            exact Metric.ball_mem_nhds p₂ hr₂_pos
          filter_upwards [hnhds] with z hz
          exact hzero₂ (γ z) hz
        have h1_eq :=
          hg_ana.eqOn_zero_of_preconnected_of_eventuallyEq_zero hD_conv.isPreconnected h0_D hev h1_D
        simpa [Function.comp_def, hγ1] using h1_eq
      have hW_sub : W ⊆ U₀ :=
        hW_pre.subset_of_closure_inter_subset hU₀_open hU₀_ne hU₀_cl
      intro p hp
      obtain ⟨r, hr, _, hzero⟩ := hW_sub hp
      exact sub_eq_zero.mp (hzero p (Metric.mem_ball_self hr))
    let π₁ : (ℂ × ℂ) →L[ℂ] ℂ :=
      { toFun := Prod.fst
        map_add' := fun _ _ => rfl
        map_smul' := fun _ _ => rfl
        cont := continuous_fst }
    let π₂ : (ℂ × ℂ) →L[ℂ] ℂ :=
      { toFun := Prod.snd
        map_add' := fun _ _ => rfl
        map_smul' := fun _ _ => rfl
        cont := continuous_snd }
    have hπ₁_fderiv : ∀ p : ℂ × ℂ, HasFDerivAt Prod.fst π₁ p := fun p => π₁.hasFDerivAt
    have hπ₂_fderiv : ∀ p : ℂ × ℂ, HasFDerivAt Prod.snd π₂ p := fun p => π₂.hasFDerivAt
    have hpartialY_holo : ∀ {W : Set (ℂ × ℂ)} {f : ℂ × ℂ → ℂ},
        IsOpen W → DifferentiableOn ℂ f W → DifferentiableOn ℂ (iterDerivYT 1 0 f) W := by
      intro W f hW_open hf p₀ hp₀
      obtain ⟨R, hR_pos, hR_sub⟩ := Metric.isOpen_iff.mp hW_open p₀ hp₀
      let r : ℝ := R / 3
      have hr_pos : 0 < r := by positivity
      have h2r_pos : 0 < 2 * r := by positivity
      let y₀ : ℂ := p₀.1
      let t₀ : ℂ := p₀.2
      let K_box : Set (ℂ × ℂ) := Metric.closedBall y₀ (2 * r) ×ˢ Metric.closedBall t₀ (2 * r)
      have hK_sub : K_box ⊆ W := by
        intro q hq
        apply hR_sub
        rw [Metric.mem_ball, Prod.dist_eq]
        have h1 : dist q.1 y₀ ≤ 2 * r := Metric.mem_closedBall.mp hq.1
        have h2 : dist q.2 t₀ ≤ 2 * r := Metric.mem_closedBall.mp hq.2
        have hmax : max (dist q.1 y₀) (dist q.2 t₀) ≤ 2 * r := max_le h1 h2
        have hlt : 2 * r < R := by dsimp [r]; linarith
        exact lt_of_le_of_lt hmax hlt
      have hK_comp : IsCompact K_box :=
        (isCompact_closedBall y₀ (2 * r)).prod (isCompact_closedBall t₀ (2 * r))
      obtain ⟨M_raw, hM_raw⟩ :=
        (hK_comp.image_of_continuousOn ((hf.continuousOn.mono hK_sub).norm)).bddAbove
      let M : ℝ := max M_raw 0
      have hM_nonneg : 0 ≤ M := le_max_right _ _
      have hf_le_M : ∀ q ∈ K_box, ‖f q‖ ≤ M := by
        intro q hq
        exact le_trans (hM_raw ⟨q, hq, rfl⟩) (le_max_left _ _)
      let z : ℝ → ℂ := circleMap y₀ (2 * r)
      have hz_mem_K : ∀ θ : ℝ, ∀ w ∈ Metric.closedBall t₀ (2 * r), (z θ, w) ∈ K_box := by
        intro θ w hw
        refine ⟨?_, hw⟩
        exact Metric.sphere_subset_closedBall (circleMap_mem_sphere y₀ h2r_pos.le θ)
      have hz_sub_ge : ∀ θ : ℝ, ∀ p ∈ Metric.ball p₀ r, r ≤ ‖z θ - p.1‖ := by
        intro θ p hp
        have hz_norm : ‖z θ - y₀‖ = 2 * r := by
          rw [← dist_eq_norm]
          exact Metric.mem_sphere.mp (circleMap_mem_sphere y₀ h2r_pos.le θ)
        have hp1 : ‖p.1 - y₀‖ < r := by
          have hd : dist p p₀ < r := Metric.mem_ball.mp hp
          rw [Prod.dist_eq] at hd
          simpa [dist_eq_norm] using lt_of_le_of_lt (le_max_left _ _) hd
        have htri : ‖z θ - y₀‖ - ‖p.1 - y₀‖ ≤ ‖(z θ - y₀) - (p.1 - y₀)‖ :=
          norm_sub_norm_le _ _
        have heq_sub : (z θ - y₀) - (p.1 - y₀) = z θ - p.1 := by ring
        rw [heq_sub, hz_norm] at htri
        linarith
      have hz_ne : ∀ θ : ℝ, ∀ p ∈ Metric.ball p₀ r, z θ - p.1 ≠ 0 := by
        intro θ p hp hzero
        have hge := hz_sub_ge θ p hp
        rw [hzero, norm_zero] at hge
        linarith
      let F : ℂ × ℂ → ℝ → ℂ := fun p θ =>
        deriv z θ * (((z θ - p.1) ^ 2)⁻¹ * f (z θ, p.2))
      let F' : ℂ × ℂ → ℝ → (ℂ × ℂ) →L[ℂ] ℂ := fun p θ =>
        deriv z θ •
          (π₁.smulRight ((2 * (z θ - p.1) * (((z θ - p.1) ^ 2) ^ 2)⁻¹) * f (z θ, p.2)) +
            π₂.smulRight (((z θ - p.1) ^ 2)⁻¹ * deriv (fun w : ℂ => f (z θ, w)) p.2))
      have hF_cont : ∀ p ∈ Metric.ball p₀ r, Continuous (F p) := by
        intro p hp
        have hp2_cb : p.2 ∈ Metric.closedBall t₀ (2 * r) := by
          rw [Metric.mem_closedBall]
          have hd : dist p p₀ < r := Metric.mem_ball.mp hp
          rw [Prod.dist_eq] at hd
          have : dist p.2 t₀ < r := lt_of_le_of_lt (le_max_right _ _) hd
          linarith
        have hdz_cont : Continuous (deriv z) := by
          have hfun : deriv z = fun θ : ℝ => circleMap 0 (2 * r) θ * Complex.I := by
            ext θ
            exact deriv_circleMap y₀ (2 * r) θ
          rw [hfun]
          exact (continuous_circleMap 0 (2 * r)).mul continuous_const
        have hinv_cont : Continuous (fun θ : ℝ => ((z θ - p.1) ^ 2)⁻¹) :=
          (((continuous_circleMap y₀ (2 * r)).sub continuous_const).pow 2).inv₀
            (fun θ => pow_ne_zero 2 (hz_ne θ p hp))
        have hf_theta_cont : Continuous (fun θ : ℝ => f (z θ, p.2)) :=
          hf.continuousOn.comp_continuous
            ((continuous_circleMap y₀ (2 * r)).prodMk continuous_const)
            (fun θ => hK_sub (hz_mem_K θ p.2 hp2_cb))
        exact hdz_cont.mul (hinv_cont.mul hf_theta_cont)
      have hF_fderiv : ∀ θ : ℝ, ∀ p ∈ Metric.ball p₀ r,
          HasFDerivAt (fun q => F q θ) (F' p θ) p := by
        intro θ p hp
        have hp2 : dist p.2 t₀ < r := by
          have hd : dist p p₀ < r := Metric.mem_ball.mp hp
          rw [Prod.dist_eq] at hd
          exact lt_of_le_of_lt (le_max_right _ _) hd
        have hz_p_W : (z θ, p.2) ∈ W := by
          apply hK_sub (hz_mem_K θ p.2 ?_)
          rw [Metric.mem_closedBall]
          linarith
        have hw_diff : DifferentiableAt ℂ (fun w : ℂ => f (z θ, w)) p.2 := by
          have hcomp : DifferentiableOn ℂ (fun w : ℂ => f (z θ, w)) {w : ℂ | (z θ, w) ∈ W} :=
            hf.comp ((differentiable_const (z θ)).prodMk differentiable_id).differentiableOn
              (fun _ hw => hw)
          exact hcomp.differentiableAt
            ((hW_open.preimage (continuous_const.prodMk continuous_id)).mem_nhds hz_p_W)
        have h1_1d : HasDerivAt (fun u : ℂ => ((z θ - u) ^ 2)⁻¹)
            (2 * (z θ - p.1) * (((z θ - p.1) ^ 2) ^ 2)⁻¹) p.1 := by
          have hsub : HasDerivAt (fun u : ℂ => z θ - u) (-1) p.1 :=
            (hasDerivAt_id' p.1).const_sub (z θ)
          have hsq : HasDerivAt (fun u : ℂ => (z θ - u) ^ 2)
              ((2 : ℕ) * (z θ - p.1) ^ (2 - 1) * (-1)) p.1 := hsub.pow 2
          have hinv := hsq.inv (pow_ne_zero 2 (hz_ne θ p hp))
          refine hinv.congr_deriv ?_
          simp only [div_eq_mul_inv]
          push_cast
          ring
        have h1 : HasFDerivAt (fun q : ℂ × ℂ => ((z θ - q.1) ^ 2)⁻¹)
            ((2 * (z θ - p.1) * (((z θ - p.1) ^ 2) ^ 2)⁻¹) • π₁) p :=
          h1_1d.comp_hasFDerivAt p (hπ₁_fderiv p)
        have h2 : HasFDerivAt (fun q : ℂ × ℂ => f (z θ, q.2))
            (deriv (fun w : ℂ => f (z θ, w)) p.2 • π₂) p :=
          hw_diff.hasDerivAt.comp_hasFDerivAt p (hπ₂_fderiv p)
        have hprod := (h1.mul h2).const_mul (deriv z θ)
        refine hprod.congr_fderiv ?_
        apply ContinuousLinearMap.ext
        intro v
        simp only [F', π₁, π₂, _root_.add_apply, _root_.smul_apply,
          ContinuousLinearMap.smulRight_apply, ContinuousLinearMap.coe_mk', LinearMap.coe_mk,
          AddHom.coe_mk, smul_eq_mul]
        ring
      let B_const : ℝ :=
        2 * r * (‖π₁‖ * (2 * (r ^ 3)⁻¹ * M) + ‖π₂‖ * ((r ^ 2)⁻¹ * (M / r)))
      have hF'_bound : ∀ θ : ℝ, ∀ p ∈ Metric.ball p₀ r, ‖F' p θ‖ ≤ B_const := by
        intro θ p hp
        have hdz_norm : ‖deriv z θ‖ = 2 * r := by
          rw [deriv_circleMap, norm_mul, Complex.norm_I, mul_one, circleMap_zero, norm_mul,
            Complex.norm_real, Real.norm_eq_abs, abs_of_pos h2r_pos,
            Complex.norm_exp_ofReal_mul_I, mul_one]
        have hge : r ≤ ‖z θ - p.1‖ := hz_sub_ge θ p hp
        have hp2 : dist p.2 t₀ < r := by
          have hd : dist p p₀ < r := Metric.mem_ball.mp hp
          rw [Prod.dist_eq] at hd
          exact lt_of_le_of_lt (le_max_right _ _) hd
        have hp2_cb : p.2 ∈ Metric.closedBall t₀ (2 * r) := by
          rw [Metric.mem_closedBall]; linarith
        have hcb_sub_K : ∀ w ∈ Metric.closedBall p.2 r, (z θ, w) ∈ K_box := by
          intro w hw
          refine hz_mem_K θ w ?_
          rw [Metric.mem_closedBall] at hw ⊢
          calc dist w t₀ ≤ dist w p.2 + dist p.2 t₀ := dist_triangle w p.2 t₀
            _ ≤ r + r := by linarith
            _ = 2 * r := by ring
        have hft_diff : DifferentiableOn ℂ (fun w : ℂ => f (z θ, w)) (Metric.closedBall p.2 r) :=
          hf.comp ((differentiable_const (z θ)).prodMk differentiable_id).differentiableOn
            (fun w hw => hK_sub (hcb_sub_K w hw))
        have hft_dc : DiffContOnCl ℂ (fun w : ℂ => f (z θ, w)) (Metric.ball p.2 r) := by
          refine ⟨hft_diff.mono Metric.ball_subset_closedBall, ?_⟩
          exact hft_diff.continuousOn.mono (closure_ball_subset_closedBall)
        have hderiv_le : ‖deriv (fun w : ℂ => f (z θ, w)) p.2‖ ≤ M / r :=
          Complex.norm_deriv_le_of_forall_mem_sphere_norm_le hr_pos hft_dc
            (fun w hw => hf_le_M (z θ, w) (hcb_sub_K w (Metric.sphere_subset_closedBall hw)))
        have hf_le : ‖f (z θ, p.2)‖ ≤ M := hf_le_M (z θ, p.2) (hz_mem_K θ p.2 hp2_cb)
        have hinv1 : ‖z θ - p.1‖⁻¹ ≤ r⁻¹ := inv_anti₀ hr_pos hge
        have hterm1 : ‖2 * (z θ - p.1) * (((z θ - p.1) ^ 2) ^ 2)⁻¹‖ ≤ 2 * (r ^ 3)⁻¹ := by
          have hnz_norm : 0 < ‖z θ - p.1‖ := lt_of_lt_of_le hr_pos hge
          calc ‖2 * (z θ - p.1) * (((z θ - p.1) ^ 2) ^ 2)⁻¹‖
              = 2 * ‖z θ - p.1‖ * ((‖z θ - p.1‖ ^ 2) ^ 2)⁻¹ := by
                simp only [norm_mul, norm_inv, norm_pow, Complex.norm_ofNat]
            _ = 2 * (‖z θ - p.1‖⁻¹) ^ 3 := by
                field_simp [ne_of_gt hnz_norm]
            _ ≤ 2 * (r⁻¹) ^ 3 := by gcongr
            _ = 2 * (r ^ 3)⁻¹ := by rw [inv_pow]
        have hterm2 : ‖((z θ - p.1) ^ 2)⁻¹‖ ≤ (r ^ 2)⁻¹ := by
          rw [norm_inv, norm_pow, ← inv_pow, ← inv_pow]
          exact pow_le_pow_left₀ (by positivity) hinv1 2
        calc ‖F' p θ‖
            = ‖deriv z θ‖ *
                ‖π₁.smulRight ((2 * (z θ - p.1) * (((z θ - p.1) ^ 2) ^ 2)⁻¹) * f (z θ, p.2)) +
                  π₂.smulRight (((z θ - p.1) ^ 2)⁻¹ * deriv (fun w : ℂ => f (z θ, w)) p.2)‖ := by
              dsimp [F']; rw [norm_smul]
          _ ≤ (2 * r) *
                (‖π₁.smulRight ((2 * (z θ - p.1) * (((z θ - p.1) ^ 2) ^ 2)⁻¹) * f (z θ, p.2))‖ +
                  ‖π₂.smulRight (((z θ - p.1) ^ 2)⁻¹ * deriv (fun w : ℂ => f (z θ, w)) p.2)‖) := by
