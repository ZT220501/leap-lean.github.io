          simpa [g, g', mul_comm, mul_left_comm, mul_assoc] using hp
      have hg'_bound : ∀ (m : ℕ), ∀ y ∈ Metric.ball (0 : ℂ) R, ‖g' m y‖ ≤ u m := by
        intro m y hy
