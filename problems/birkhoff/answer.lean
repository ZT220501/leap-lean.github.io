                ring
          _ = 0 := by rw [haeval_sum, mul_zero]
      let R_poly : S_mv := ∑ d : Fin (D₀ + 1),
        MvPolynomial.rename Sum.inl (Q_tilde d) *
          (MvPolynomial.X (Sum.inr ()) : S_mv) ^ (d : ℕ)
      have hR_eval : ∀ q : ℂ × ℂ,
          evalFn R_poly q = ∑ d : Fin (D₀ + 1),
