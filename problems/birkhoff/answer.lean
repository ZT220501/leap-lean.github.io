    have hdϕ_ℂ_real : ∀ x : ℝ, deriv C.ϕ_ℂ (x : ℂ) = ((deriv C.ϕ x : ℝ) : ℂ) := by
      intro x
      have hmem : (x : ℂ) ∈ horizStrip (2 * C.s₀) := by simp [horizStrip, C.s₀_pos]
      have hd1 := ((C.ϕ_ℂ_holo.differentiableAt (h2s0_open.mem_nhds hmem)).hasDerivAt).scomp x
