      linarith
    have hp_test_ov : p_test ∈
        ({ y : ℂ | y ∈ Metric.ball (y_wall q) δx ∧ y.im < H₂ - δx / 2 } ×ˢ
          Metric.ball (t₂ : ℂ) δt) :=
