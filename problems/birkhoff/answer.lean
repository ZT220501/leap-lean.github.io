          H_exc ⟨k, hk⟩ p_curr ≠ 0 →
          0 < r_curr →
          Metric.ball p_curr r_curr ⊆ Ω_k ⟨k, hk⟩ →
          (∀ ι : Fin 2, DifferentiableOn ℂ (M_curr ι) (Metric.ball p_curr r_curr)) →
          (∀ ι : Fin 2, ∀ p ∈ Metric.ball p_curr r_curr,
            ∑ d : Fin (E_base.D_det ι + 1), C_cl ⟨k, hk⟩ ι d p * (M_curr ι p) ^ (d : ℕ) = 0) →
          ∃ (p_bot : ℂ × ℂ) (r_bot : ℝ) (M_bot : Fin 2 → ℂ × ℂ → ℂ),
