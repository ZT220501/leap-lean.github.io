      have hk_le : (k : ℝ) ≤ w.re / (2 * Real.pi) := Int.floor_le _
      have hk_lt : w.re / (2 * Real.pi) < (k : ℝ) + 1 := Int.lt_floor_add_one _
      have hx₀_lo : 0 ≤ x₀ := by have := (le_div_iff₀ h2pi_pos).mp hk_le; linarith
      have hx₀_hi : x₀ ≤ 2 * Real.pi := by have := (div_lt_iff₀ h2pi_pos).mp hk_lt; linarith
