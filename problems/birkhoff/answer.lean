        (le_of_lt hM) ?_ ?_ ?_
      · intro t ht
        refine hdW.1.continuousOn.comp ?_ (fun η hη =>
          hCalc.mem_horizStrip_of_tau_seg σ τ (η * c_fn t) z H₀ hτ
