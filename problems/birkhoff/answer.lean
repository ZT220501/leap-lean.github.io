      have hq_thick : (ζ, (T_c, w)) ∈ Metric.thickening δ_th K_prod := by
        rw [Metric.mem_thickening_iff]
        refine ⟨(ζ', (T_c, w')), ⟨hζ'_mem, hTc, hw'_mem⟩, ?_⟩
        simp only [Prod.dist_eq, dist_self]
        exact max_lt hζ_dist (max_lt hδ_th_pos hw_dist)
      have hq_map := hδ_th_sub hq_thick
      exact ⟨hq_map.1.1, hq_map.1.2, hq_map.2⟩
    let g_plus : ℂ → ℂ → ℂ → ℂ := fun ζ T_c w => Φ (ζ, w + G ζ - G T_c)
    let H_plus : ℂ → ℂ → ℂ → ℂ := fun T T_c w =>
      (2 * (Real.pi : ℂ) * Complex.I)⁻¹ *
        upperHalfDiskIntegral (fun ζ => g_plus ζ T_c w / (ζ - T))
    have hDeep_eq : ∀ T_c ∈ Metric.closedBall (0 : ℂ) ρ_star,
