      intro r hr
      have harg1 : r.1 + (q_idx v.1 : ℂ) * (-r.2) = r.1 - (q_idx v.1 : ℂ) * r.2 := by ring
      have harg2 : r.1 + (q_idx (neg_idx v.1) : ℂ) * r.2 = r.1 - (q_idx v.1 : ℂ) * r.2 := by
        rw [hneg v.1, Int.cast_neg]; ring
      rw [harg1, harg2]
      exact hDualLineEven (r.1 - (q_idx v.1 : ℂ) * r.2) r.2 hr.2 hr.1 v.2.1
    unfold symJetEnv
    rw [hIterYT_neg]
    congr 1
    exact hIterYT_congr hUa_open hEq v.2.2.1.1 v.2.2.2.1 hp_Ua
  
  let D_θ : Set (ℂ × ℂ) := { p : ℂ × ℂ | |p.1.im| < 3 * hDet.s_det ∧ ‖p.2‖ < 2 * hDet.r_det }
