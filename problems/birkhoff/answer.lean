                (Metric.ball 0 (R₀ / 2)) := by
              have hc := S.normAction1_holo.comp (hpt0_d.prodMk hptp_d) (fun ζ hζ =>
                ⟨(hMeshPt_strip z hz_s _ (h_in_ball ζ hζ).2.1).2,
