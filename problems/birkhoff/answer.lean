    rw [h_double_eq]
    change (2 * Real.pi)⁻¹ * ((∫ x in (0 : ℝ)..(2 * Real.pi), Φ x 0) +
      ∫ v in (0 : ℝ)..H_K, G_int v) = _
    rw [← h_split]
    dsimp [I₀]
    ring
  calc
    (2 * Real.pi)⁻¹ *
        (∫ x in (0 : ℝ)..(2 * Real.pi),
          ‖S.ϕ ((x : ℂ) + (H_K : ℂ) * Complex.I) -
            ((x : ℂ) + (H_K : ℂ) * Complex.I)‖ ^ 2)
        = (2 * Real.pi)⁻¹ * (∫ x in (0 : ℝ)..(2 * Real.pi), Φ x H_K) := rfl
    _ ≤ I₀ + I_bulk + (8 * hBudget.C_env * K ^ (2 * hBudget.ρ) + 4) := by
        rw [h_total_eq]; linarith
    _ ≤ C_eng * K ^ (2 * hBudget.ρ) := by
        dsimp [C_eng]
        nlinarith

 have h_part4 : ∀ (H_p : ℝ), 0 < H_p → H_p < S.H →
     let ψ : ℝ → ℝ := fun t =>
       ‖S.ϕ ((t : ℂ) + (H_p : ℂ) * Complex.I) -
         ((t : ℂ) + (H_p : ℂ) * Complex.I)‖ ^ 2
     let U : ℂ → ℝ := fun w =>
       if |w.im| < H_p then
         ∫ u : ℝ, ψ (w.re + u) * stripExitKernel H_p w.im u
       else
         ψ w.re
     (∃ B_U : ℝ, 0 ≤ B_U ∧ ∀ w ∈ horizStrip H_p, ‖S.ϕ w - w‖ ^ 2 ≤ U w ∧ U w ≤ B_U) ∧
     (∀ w : ℂ, U (w + 2 * Real.pi) = U w) ∧
     ((∫ x in (0 : ℝ)..(2 * Real.pi), U x) = ∫ x in (0 : ℝ)..(2 * Real.pi), ψ x) ∧
     (∃ F_ext : ℂ → ℂ, DifferentiableOn ℂ F_ext (horizStrip H_p) ∧
       ∀ w ∈ horizStrip H_p, U w = (F_ext w).re) := by
  intro H_p hHp_pos hHp_lt ψ U
  have h_open_H : IsOpen (horizStrip S.H) :=
    isOpen_Iio.preimage (continuous_abs.comp Complex.continuous_im)
  have h_open_Hp : IsOpen (horizStrip H_p) :=
    isOpen_Iio.preimage (continuous_abs.comp Complex.continuous_im)
  have h2pi_pos : 0 < 2 * Real.pi := Real.two_pi_pos
  let g : ℂ → ℂ := fun z => S.ϕ z - z
  have hg_holo : DifferentiableOn ℂ g (horizStrip S.H) :=
    S.ϕ_holo.sub differentiableOn_id
  have hg_cont : ContinuousOn g (horizStrip S.H) := hg_holo.continuousOn
  have hg_per_nat : ∀ z ∈ horizStrip S.H, ∀ n : ℕ,
      g (z + (n : ℂ) * (2 * (Real.pi : ℂ))) = g z := by
    intro z hz n
    induction n with
    | zero => simp
    | succ n ih =>
        have hz_n : z + (n : ℂ) * (2 * (Real.pi : ℂ)) ∈ horizStrip S.H := by
          simpa [horizStrip] using hz
        have h_eq : z + ((n + 1 : ℕ) : ℂ) * (2 * (Real.pi : ℂ)) =
            (z + (n : ℂ) * (2 * (Real.pi : ℂ))) + 2 * (Real.pi : ℂ) := by
          push_cast; ring
        rw [h_eq]
        have h1 : g ((z + (n : ℂ) * (2 * (Real.pi : ℂ))) + 2 * (Real.pi : ℂ)) =
            g (z + (n : ℂ) * (2 * (Real.pi : ℂ))) := by
          dsimp [g]; rw [S.ϕ_quasiperiodic _ hz_n]; ring
        rw [h1, ih]
  have hg_per_int : ∀ z ∈ horizStrip S.H, ∀ m : ℤ,
      g (z + (m : ℂ) * (2 * (Real.pi : ℂ))) = g z := by
    intro z hz m
    rcases Int.eq_nat_or_neg m with ⟨n, rfl | rfl⟩
    · exact_mod_cast hg_per_nat z hz n
    · have hz' : z - (n : ℂ) * (2 * (Real.pi : ℂ)) ∈ horizStrip S.H := by
        simpa [horizStrip] using hz
      have h1 := hg_per_nat (z - (n : ℂ) * (2 * (Real.pi : ℂ))) hz' n
      have h_eq1 : z + ((- (n : ℤ) : ℤ) : ℂ) * (2 * (Real.pi : ℂ)) =
          z - (n : ℂ) * (2 * (Real.pi : ℂ)) := by push_cast; ring
      have h_eq2 : z - (n : ℂ) * (2 * (Real.pi : ℂ)) + (n : ℂ) * (2 * (Real.pi : ℂ)) = z := by
        ring
      rw [h_eq2] at h1
      rw [h_eq1, h1.symm]
  have h_top_in_H : ∀ t : ℝ, (t : ℂ) + (H_p : ℂ) * Complex.I ∈ horizStrip S.H := by
    intro t; simpa [horizStrip, abs_of_pos hHp_pos] using hHp_lt
  have hψ_cont : Continuous ψ := by
