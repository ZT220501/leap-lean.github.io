    let α_trunc := lcJetTruncAngles (M - 1) α_ser
    let Δ : Fin (k + 1) → MvPowerSeries (Fin 2) ℂ := fun r => α_ser r - α_trunc r
    obtain ⟨hα_tr_c0, hα_tr_mem, hΔ_zero, hΔ_last, hΔ_vb, _⟩ :=
