        have h_lin : -(7 / 8 : ℝ) * Real.log D_v ≤
            Real.log ((1 / 2 : ℝ) * m_star j * C_tail) +
              Real.log (1 + v) * (-(5 / 8 : ℝ)) := by
          linarith
        have hm_v_le : m_approx n D_v ≤
            ((1 / 2 : ℝ) * m_star j * C_tail) * (1 + v) ^ (-(5 / 8 : ℝ)) := by
          have h_half_pos : 0 < (1 / 2 : ℝ) * m_star j * C_tail := by positivity
          calc
            m_approx n D_v ≤ Real.exp (-(7 / 8 : ℝ) * Real.log D_v) := hm_exp_78
            _ ≤ Real.exp (Real.log ((1 / 2 : ℝ) * m_star j * C_tail) +
                  Real.log (1 + v) * (-(5 / 8 : ℝ))) :=
              Real.exp_le_exp.mpr h_lin
            _ = Real.exp (Real.log ((1 / 2 : ℝ) * m_star j * C_tail)) *
                  Real.exp (Real.log (1 + v) * (-(5 / 8 : ℝ))) := Real.exp_add _ _
            _ = ((1 / 2 : ℝ) * m_star j * C_tail) * (1 + v) ^ (-(5 / 8 : ℝ)) := by
              rw [Real.exp_log h_half_pos, ← Real.rpow_def_of_pos h1v_pos]
        have hrpow_pos : 0 < (1 + v) ^ (-(5 / 8 : ℝ)) := Real.rpow_pos_of_pos h1v_pos _
        have hC_nonneg : 0 ≤ C_tail * (1 + v) ^ (-(5 / 8 : ℝ)) :=
          mul_nonneg hC_tail.le hrpow_pos.le
        calc
          m_approx n D_v ≤
              ((1 / 2 : ℝ) * m_star j * C_tail) * (1 + v) ^ (-(5 / 8 : ℝ)) := hm_v_le
          _ = (C_tail * (1 + v) ^ (-(5 / 8 : ℝ))) * ((1 / 2 : ℝ) * m_star j) := by ring
          _ ≤ (C_tail * (1 + v) ^ (-(5 / 8 : ℝ))) * m_approx n (D_star j) :=
            mul_le_mul_of_nonneg_left hm_ge hC_nonneg
          _ ≤ (3 * C_tail * (1 + v) ^ (-(5 / 8 : ℝ))) * m_approx n (D_star j) := by
            have h1 : C_tail * (1 + v) ^ (-(5 / 8 : ℝ)) ≤
                3 * C_tail * (1 + v) ^ (-(5 / 8 : ℝ)) := by
              nlinarith [hC_tail, hrpow_pos]
            exact mul_le_mul_of_nonneg_right h1 hm_approx_pos.le
    refine ⟨h_strip, ?_⟩
    rw [hy_eq, h_energy_ratio n hD_pos hDv_pos hm_approx_pos.ne']
    have hq_nonneg : 0 ≤ m_approx n D_v / m_approx n (D_star j) :=
      div_nonneg (hm_approx_nonneg n hDv_pos) hm_approx_pos.le
    have hrpow_sq : ((1 + v) ^ (-(5 / 8 : ℝ))) ^ 2 = (1 + v) ^ (-(5 / 4 : ℝ)) := by
      rw [Real.rpow_def_of_pos h1v_pos (-(5 / 8 : ℝ)),
        Real.rpow_def_of_pos h1v_pos (-(5 / 4 : ℝ)), sq, ← Real.exp_add]
      congr 1
      ring
    calc
      (m_approx n D_v / m_approx n (D_star j)) ^ 2 ≤
          (3 * C_tail * (1 + v) ^ (-(5 / 8 : ℝ))) ^ 2 := by
        nlinarith
      _ = 9 * C_tail ^ 2 * ((1 + v) ^ (-(5 / 8 : ℝ))) ^ 2 := by ring
      _ = C_tail' * (1 + v) ^ (-(5 / 4 : ℝ)) := by
        rw [hrpow_sq]
  exact ⟨C_tail', h_seq, ℓ_seq, m0_seq,
    ⟨by positivity, h_row_basic, hh_tendsto, hℓ_tendsto, hprod_tendsto,
      hratio_tendsto, h_unit_band, h_local_band, h_coarse_tail⟩⟩

theorem strip_cauchy_penalty_center_selection (S : FiniteWallNonisotropicStrip)
    (δ_b C_tail' : ℝ) (h_seq ℓ_seq m0_seq : ℕ → ℝ)
    (hδ_pos : 0 < δ_b) (hδ_lt : δ_b < S.H / 2)
    (hDiag : SteepDiagonalRowData S δ_b C_tail' h_seq ℓ_seq m0_seq) :
    ∃ x_seq m_seq : ℕ → ℝ,
      let ℱ_seq : ℕ → ℂ → ℂ := fun j Z =>
        ((m_seq j)⁻¹ : ℂ) *
          S.f ((x_seq j : ℂ) + (h_seq j : ℂ) * Complex.I + (ℓ_seq j : ℂ) * Z)
      let 𝒬_seq : ℕ → ℂ → ℂ := fun j Z =>
        (((m_seq j) ^ 2)⁻¹ : ℂ) *
          S.q ((x_seq j : ℂ) + (h_seq j : ℂ) * Complex.I + (ℓ_seq j : ℂ) * Z)
      (∀ j : ℕ, 0 < m_seq j) ∧
      Filter.Tendsto (fun j => ℓ_seq j * m_seq j) Filter.atTop Filter.atTop ∧
      (∀ j : ℕ, ‖ℱ_seq j 0‖ ^ 2 + ‖𝒬_seq j 0‖ = 1) ∧
      Filter.Tendsto
        (fun j => (2 * Real.pi)⁻¹ * ∫ θ in (0 : ℝ)..(2 * Real.pi),
          (‖Complex.exp (Complex.I * Complex.exp ((θ : ℂ) * Complex.I)) *
              ℱ_seq j (Complex.exp ((θ : ℂ) * Complex.I))‖ ^ 2 +
            ‖Complex.exp (2 * Complex.I * Complex.exp ((θ : ℂ) * Complex.I)) *
              𝒬_seq j (Complex.exp ((θ : ℂ) * Complex.I))‖))
        Filter.atTop (nhds 1) ∧
      (∀ R : ℕ, 1 ≤ R → ∃ M_R : ℝ, 0 < M_R ∧ ∃ N_R : ℕ, ∀ j ≥ N_R,
        (∀ Z ∈ Metric.ball (0 : ℂ) ((R : ℝ) + 2),
          (x_seq j : ℂ) + (h_seq j : ℂ) * Complex.I + (ℓ_seq j : ℂ) * Z ∈ horizStrip S.H) ∧
        (∀ Z ∈ Metric.closedBall (0 : ℂ) ((R : ℝ) + 1),
          ‖ℱ_seq j Z‖ ^ 2 + ‖𝒬_seq j Z‖ ≤ M_R)) ∧
      (∀ L : ℝ, 0 < L → ∃ C_L : ℝ, 0 < C_L ∧ ∃ N_L : ℕ, ∀ j ≥ N_L, ∀ s : ℂ,
        ℓ_seq j ≤ h_seq j - s.im →
        h_seq j - s.im ≤ δ_b →
        |s.re - x_seq j| ≤ L * (h_seq j - s.im) →
        shapeModulus S s ≤ C_L * m_seq j * (ℓ_seq j / (h_seq j - s.im)) ^ (9 / 16 : ℝ)) :=
by
  have h2pi_pos : (0 : ℝ) < 2 * Real.pi := Real.two_pi_pos
  have hle_2pi : (0 : ℝ) ≤ 2 * Real.pi := h2pi_pos.le
  have h2pi_ne : (2 * Real.pi : ℝ) ≠ 0 := h2pi_pos.ne'
  have him_rect : ∀ a b : ℝ, ((a : ℂ) + (b : ℂ) * Complex.I).im = b := fun a b => by
    simp only [Complex.add_im, Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im,
      Complex.I_re, Complex.I_im]
    ring
  have hnorm_c_inv : ∀ {x : ℝ}, 0 < x → ‖(x : ℂ)⁻¹‖ = x⁻¹ := fun hx => by
    rw [norm_inv, Complex.norm_real, Real.norm_of_nonneg hx.le]
  have hnorm_c_sq_inv : ∀ {x : ℝ}, 0 < x → ‖((x : ℂ) ^ 2)⁻¹‖ = (x ^ 2)⁻¹ := fun hx => by
    rw [norm_inv, norm_pow, Complex.norm_real, Real.norm_of_nonneg hx.le]
  obtain ⟨Φ, hΦ_def, hΦ_cont, hΦ_nonneg, hΦ_per⟩ : ∃ Φ : ℂ → ℝ,
      (∀ s : ℂ, Φ s = ‖S.f s‖ ^ 2 + ‖S.q s‖) ∧
      ContinuousOn Φ (horizStrip S.H) ∧
      (∀ s : ℂ, 0 ≤ Φ s) ∧
      (∀ s ∈ horizStrip S.H, Φ (s + 2 * Real.pi) = Φ s) := by
    refine ⟨fun s => ‖S.f s‖ ^ 2 + ‖S.q s‖, fun _ => rfl,
      (S.f_holo.continuousOn.norm.pow 2).add S.q_holo.continuousOn.norm,
      fun _ => by positivity, fun s hs => by dsimp only; rw [S.f_periodic s hs, S.q_periodic s hs]⟩
  have hE_Φ : ∀ y : ℝ, steepRowEnergy S y =
      (2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi), Φ ((x : ℂ) + (y : ℂ) * Complex.I) := by
    intro y
    dsimp only [steepRowEnergy]
    simp_rw [← hΦ_def]
  have h_fubini : ∀ F : ℝ → ℝ → ℝ, Continuous (Function.uncurry F) →
      (∫ x in (0 : ℝ)..(2 * Real.pi), ∫ θ in (0 : ℝ)..(2 * Real.pi), F x θ) =
        ∫ θ in (0 : ℝ)..(2 * Real.pi), ∫ x in (0 : ℝ)..(2 * Real.pi), F x θ := by
    intro F hF
    simp_rw [intervalIntegral.integral_of_le hle_2pi]
    have hint : MeasureTheory.Integrable (Function.uncurry F)
        ((MeasureTheory.volume.restrict (Set.Ioc 0 (2 * Real.pi))).prod
          (MeasureTheory.volume.restrict (Set.Ioc 0 (2 * Real.pi)))) := by
      rw [MeasureTheory.Measure.prod_restrict]
      exact (hF.continuousOn.integrableOn_compact
        (isCompact_Icc.prod isCompact_Icc)).mono_set
        (Set.prod_mono Set.Ioc_subset_Icc_self Set.Ioc_subset_Icc_self)
    have hswap := MeasureTheory.intervalIntegral_integral_swap (a := (0 : ℝ)) (b := 2 * Real.pi)
      (μ := MeasureTheory.volume.restrict (Set.Ioc 0 (2 * Real.pi))) (f := F)
      (by rwa [Set.uIoc_of_le hle_2pi])
    simpa only [intervalIntegral.integral_of_le hle_2pi] using hswap
  have h_per_shift : ∀ (g : ℝ → ℝ) (c : ℝ), Function.Periodic g (2 * Real.pi) →
      (∫ x in (0 : ℝ)..(2 * Real.pi), g (x + c)) = ∫ x in (0 : ℝ)..(2 * Real.pi), g x := by
    intro g c hg
    rw [intervalIntegral.integral_comp_add_right]
    simpa [zero_add, add_comm] using hg.intervalIntegral_add_eq c 0
  have h_int_le_const : ∀ (g : ℝ → ℝ) (C : ℝ), Continuous g →
      (∀ θ ∈ Set.Icc (0 : ℝ) (2 * Real.pi), g θ ≤ C) →
      (∫ θ in (0 : ℝ)..(2 * Real.pi), g θ) ≤ (2 * Real.pi) * C := by
    intro g C hg hpt
    have hm := intervalIntegral.integral_mono_on (μ := MeasureTheory.volume) hle_2pi
      (hg.intervalIntegrable 0 (2 * Real.pi)) intervalIntegrable_const hpt
    simpa [intervalIntegral.integral_const, sub_zero, smul_eq_mul] using hm

  
  obtain ⟨maj, hMaj⟩ : ∃ maj : ℝ → ℝ → ℝ → ℝ,
      ∀ y₀ r : ℝ, 0 < r → |y₀| + (3 / 2 : ℝ) * r < S.H →
        Continuous (maj y₀ r) ∧
        Function.Periodic (maj y₀ r) (2 * Real.pi) ∧
        (∀ x₀ : ℝ, 0 ≤ maj y₀ r x₀ ∧
          ∀ z ∈ Metric.closedBall ((x₀ : ℂ) + (y₀ : ℂ) * Complex.I) r, Φ z ≤ maj y₀ r x₀) ∧
        (2 * Real.pi)⁻¹ * (∫ x₀ in (0 : ℝ)..(2 * Real.pi), maj y₀ r x₀) =
          (3 / (2 * Real.pi)) * ∫ θ in (0 : ℝ)..(2 * Real.pi),
            steepRowEnergy S (y₀ + (3 / 2 : ℝ) * r * Real.sin θ) := by
    have h_outer_cauchy : ∀ (g : ℂ → ℂ) (w₀ z : ℂ) (r : ℝ),
        0 < r → DifferentiableOn ℂ g (horizStrip S.H) →
        Metric.closedBall w₀ ((3 / 2 : ℝ) * r) ⊆ horizStrip S.H →
        z ∈ Metric.closedBall w₀ r →
        ‖g z‖ ≤ (3 / (2 * Real.pi)) * ∫ θ in (0 : ℝ)..(2 * Real.pi),
          ‖g (circleMap w₀ ((3 / 2 : ℝ) * r) θ)‖ := by
      intro g w₀ z r hr hg hsub hz
      let ρ : ℝ := (3 / 2 : ℝ) * r
      have hρ_def : ρ = (3 / 2 : ℝ) * r := rfl
      have hρ_pos : 0 < ρ := by positivity
      have hz_ball : z ∈ Metric.ball w₀ ρ := by
        rw [Metric.mem_ball]
        calc dist z w₀ ≤ r := Metric.mem_closedBall.mp hz
          _ < (3 / 2 : ℝ) * r := by linarith
      have hcauchy : ∮ ζ in C(w₀, ρ), (ζ - z)⁻¹ • g ζ = (2 * ↑Real.pi * Complex.I) • g z :=
        (hg.mono hsub).circleIntegral_sub_inv_smul hz_ball
      rw [circleIntegral_def_Icc, MeasureTheory.integral_Icc_eq_integral_Ioc,
        ← intervalIntegral.integral_of_le hle_2pi] at hcauchy
      have hnorm_lhs : ‖(2 * ↑Real.pi * Complex.I : ℂ) • g z‖ = (2 * Real.pi) * ‖g z‖ := by
        rw [norm_smul, norm_mul, norm_mul, Complex.norm_ofNat, Complex.norm_real,
          Real.norm_of_nonneg Real.pi_pos.le, Complex.norm_I, mul_one]
      have hbound_pt : ∀ θ ∈ Set.Ioc (0 : ℝ) (2 * Real.pi),
          ‖deriv (circleMap w₀ ρ) θ • ((circleMap w₀ ρ θ - z)⁻¹ • g (circleMap w₀ ρ θ))‖ ≤
            3 * ‖g (circleMap w₀ ρ θ)‖ := by
        intro θ _
        rw [smul_eq_mul, smul_eq_mul, norm_mul, norm_mul, norm_inv]
        have hderiv : ‖deriv (circleMap w₀ ρ) θ‖ = ρ := by
          rw [deriv_circleMap, norm_mul, norm_circleMap_zero, Complex.norm_I, mul_one,
            abs_of_pos hρ_pos]
        have hdist : r / 2 ≤ ‖circleMap w₀ ρ θ - z‖ := by
          have h1 : circleMap w₀ ρ θ - z = circleMap 0 ρ θ - (z - w₀) := by
            calc circleMap w₀ ρ θ - z = (circleMap w₀ ρ θ - w₀) - (z - w₀) := by ring
              _ = circleMap 0 ρ θ - (z - w₀) := by rw [circleMap_sub_center]
          have h2 : ‖circleMap 0 ρ θ‖ - ‖z - w₀‖ ≤ ‖circleMap 0 ρ θ - (z - w₀)‖ :=
            norm_sub_norm_le _ _
          have h3 : ‖circleMap 0 ρ θ‖ = ρ := by rw [norm_circleMap_zero, abs_of_pos hρ_pos]
          have h4 : ‖z - w₀‖ ≤ r := by simpa [dist_eq_norm] using Metric.mem_closedBall.mp hz
          rw [h1]
          linarith
        have hinv : (‖circleMap w₀ ρ θ - z‖)⁻¹ ≤ 2 / r := by
          rw [inv_le_iff_one_le_mul₀ (by linarith)]
          have : 1 = (2 / r) * (r / 2) := by field_simp
          nlinarith
        rw [hderiv]
        calc ρ * ((‖circleMap w₀ ρ θ - z‖)⁻¹ * ‖g (circleMap w₀ ρ θ)‖)
            ≤ ρ * ((2 / r) * ‖g (circleMap w₀ ρ θ)‖) := by gcongr
          _ = 3 * ‖g (circleMap w₀ ρ θ)‖ := by
            have h3eq : ρ * (2 / r) = 3 := by rw [hρ_def]; field_simp
            rw [← mul_assoc, h3eq]
      have hint_rhs : IntervalIntegrable (fun θ => 3 * ‖g (circleMap w₀ ρ θ)‖)
          MeasureTheory.volume 0 (2 * Real.pi) := by
        have hcont_c : Continuous (circleMap w₀ ρ) := continuous_circleMap w₀ ρ
        have hmem_c : ∀ θ : ℝ, circleMap w₀ ρ θ ∈ Metric.closedBall w₀ ρ := fun θ =>
          circleMap_mem_closedBall w₀ hρ_pos.le θ
        have hcont_g : Continuous (fun θ => 3 * ‖g (circleMap w₀ ρ θ)‖) :=
          continuous_const.mul ((hg.continuousOn.mono hsub).comp_continuous hcont_c hmem_c).norm
        exact hcont_g.intervalIntegrable 0 (2 * Real.pi)
      have hint_ineq : ‖∫ θ in (0 : ℝ)..(2 * Real.pi),
          deriv (circleMap w₀ ρ) θ • ((circleMap w₀ ρ θ - z)⁻¹ • g (circleMap w₀ ρ θ))‖ ≤
          ∫ θ in (0 : ℝ)..(2 * Real.pi), 3 * ‖g (circleMap w₀ ρ θ)‖ :=
        intervalIntegral.norm_integral_le_of_norm_le hle_2pi
          (Filter.Eventually.of_forall fun θ hθ => hbound_pt θ hθ) hint_rhs
      rw [hcauchy, hnorm_lhs, intervalIntegral.integral_const_mul] at hint_ineq
      rw [div_mul_eq_mul_div, le_div_iff₀ h2pi_pos]
      linarith
    let maj_fn : ℝ → ℝ → ℝ → ℝ := fun y₀ r x₀ =>
