            refine Finset.sum_congr rfl (fun r hr => ?_)
            rw [ih hg' r.2 (hdeg_le_right r hr)]
          · rw [(hmv_taylor hU hp₀ hgψ_holo).2, htaylor2D_congr hU hp₀ hpD_comp,
              htaylor_mul hU hp₀ hψD hg'ψ_holo,
              (hmv_comp_AD (holoTaylor1D g (ψ p₀)) Ψ hΨ0).2, hΨ_dD, hderiv_holo1D g (ψ p₀),
              MvPowerSeries.coeff_mul, MvPowerSeries.coeff_mul]
            refine Finset.sum_congr rfl (fun r hr => ?_)
            rw [ih hg' r.2 (hdeg_le_right r hr)]
    ext d
    exact hind (d 0 + d 1) hg₀ d le_rfl
  obtain ⟨hmv_taylor, htaylor2D_mul, htaylor2D_comp_1D⟩ := htaylor_formal
  classical
  let ψ_loc : ℂ → (ℂ → ℂ) := fun z₀ =>
    if h : 0 < ‖z₀‖ ∧ ‖z₀‖ < S.δ₁ then
      HasStrictDerivAt.localInverse G.Z_loc (deriv G.Z_loc z₀) z₀
        (G.reg_on_punctured z₀ h.1 (lt_of_lt_of_le h.2 S.δ₁_le)).1.hasStrictDerivAt
        (S.deriv_Z_ne_zero z₀ h.1 h.2)
    else id
  let v_loc : ℂ → (ℂ × ℂ → ℂ) := fun z₀ p => ψ_loc z₀ (G.N_Z p / G.D_ZW p)
  let v_jet : ℕ → ℂ → ℂ := fun j z =>
    if j = 0 then 0
    else iteratedDeriv (2 * j) (fun t : ℂ => v_loc z (z, t) - z) 0 / ((2 * j).factorial : ℂ)
  have hv_jet_zero : ∀ z : ℂ, v_jet 0 z = 0 := by intro z; simp [v_jet]
  
  have h_z_lift : ∀ z₀ : ℂ, 0 < ‖z₀‖ → ‖z₀‖ < S.δ₁ →
      (∀ j : ℕ, AnalyticAt ℂ (v_jet j) z₀) ∧
      ∃ r_Z : ℝ,
        0 < r_Z ∧
        (∀ z : ℂ, ‖z - z₀‖ < 2 * r_Z → 0 < ‖z‖ ∧ ‖z‖ < S.δ₁) ∧
        2 * r_Z < G.δ₀ ∧
        DifferentiableOn ℂ (v_loc z₀)
          (Metric.ball z₀ (2 * r_Z) ×ˢ Metric.ball (0 : ℂ) (2 * r_Z)) ∧
        (∀ z t : ℂ, ‖z - z₀‖ < 2 * r_Z → ‖t‖ < 2 * r_Z →
          0 < ‖v_loc z₀ (z, t)‖ ∧ ‖v_loc z₀ (z, t)‖ < S.δ₁ ∧
          G.D_ZW (z, t) ≠ 0 ∧
          v_loc z₀ (z, -t) = v_loc z₀ (z, t) ∧
          G.N_Z (z, t) / G.D_ZW (z, t) = G.Z_loc (v_loc z₀ (z, t))) ∧
        (∀ z : ℂ, ‖z - z₀‖ < 2 * r_Z → v_loc z₀ (z, 0) = z) ∧
        (∀ z : ℂ, ‖z - z₀‖ < 2 * r_Z → ∀ k : ℕ,
          iteratedDeriv k (fun t : ℂ => v_loc z₀ (z, t) - z) 0 / (k.factorial : ℂ) =
            if Even k then v_jet (k / 2) z else 0) := by
    intro z₀ hz₀_pos hz₀_lt
    have hz₀_δ₀ : ‖z₀‖ < G.δ₀ := lt_of_lt_of_le hz₀_lt S.δ₁_le
    have hf_ana : AnalyticAt ℂ G.Z_loc z₀ := (G.reg_on_punctured z₀ hz₀_pos hz₀_δ₀).1
    have hf_strict : HasStrictDerivAt G.Z_loc (deriv G.Z_loc z₀) z₀ := hf_ana.hasStrictDerivAt
    have hf' : deriv G.Z_loc z₀ ≠ 0 := S.deriv_Z_ne_zero z₀ hz₀_pos hz₀_lt
    have hψ_eq : ψ_loc z₀ = HasStrictDerivAt.localInverse G.Z_loc (deriv G.Z_loc z₀) z₀ hf_strict hf' := by
      simp only [ψ_loc, hz₀_pos, hz₀_lt, and_self, ↓reduceDIte]
    set ρ₀ : ℝ := min (‖z₀‖ / 2) ((S.δ₁ - ‖z₀‖) / 2)
    have hρ₀_pos : 0 < ρ₀ := lt_min (half_pos hz₀_pos) (half_pos (sub_pos.mpr hz₀_lt))
    have hρ₀_punc : ∀ w : ℂ, ‖w - z₀‖ < ρ₀ → 0 < ‖w‖ ∧ ‖w‖ < S.δ₁ := by
      intro w hw
      have hw1 : ‖w - z₀‖ < ‖z₀‖ / 2 := lt_of_lt_of_le hw (min_le_left _ _)
      have hw2 : ‖w - z₀‖ < (S.δ₁ - ‖z₀‖) / 2 := lt_of_lt_of_le hw (min_le_right _ _)
      have htri1' : ‖z₀‖ ≤ ‖w‖ + ‖z₀ - w‖ := by
        simpa [add_comm] using norm_add_le w (z₀ - w)
      rw [norm_sub_rev] at htri1'
      have htri2 : ‖w‖ ≤ ‖z₀‖ + ‖w - z₀‖ := by
        simpa using norm_add_le z₀ (w - z₀)
      exact ⟨by linarith, by linarith⟩
    obtain ⟨ρ_L0, hρ_L0_pos, hρ_L0⟩ := Metric.mem_nhds_iff.mp (hf_strict.eventually_left_inverse hf')
    set ρ_L : ℝ := min ρ₀ ρ_L0
    have hρ_L_pos : 0 < ρ_L := lt_min hρ₀_pos hρ_L0_pos
    have hψ_left : ∀ w : ℂ, ‖w - z₀‖ < ρ_L → ψ_loc z₀ (G.Z_loc w) = w := by
      intro w hw
      rw [hψ_eq]
      exact hρ_L0 (Metric.mem_ball.mpr (by rw [dist_eq_norm]; exact lt_of_lt_of_le hw (min_le_right _ _)))
    set w₀ : ℂ := G.Z_loc z₀
    have hψ_w₀ : ψ_loc z₀ w₀ = z₀ := hψ_left z₀ (by simpa using hρ_L_pos)
    have hψ_ana : AnalyticAt ℂ (ψ_loc z₀) w₀ := by
      rw [hψ_eq]
      exact hf_ana.analyticAt_localInverse hf'
    have h_ev_y : ∀ᶠ y in nhds w₀,
        AnalyticAt ℂ (ψ_loc z₀) y ∧ G.Z_loc (ψ_loc z₀ y) = y ∧ ψ_loc z₀ y ∈ Metric.ball z₀ ρ_L := by
      have h1 := hψ_ana.eventually_analyticAt
      have h2 : ∀ᶠ y in nhds w₀, G.Z_loc (ψ_loc z₀ y) = y := by
        rw [hψ_eq]
        exact hf_strict.eventually_right_inverse hf'
      have h3 : ∀ᶠ y in nhds w₀, ψ_loc z₀ y ∈ Metric.ball z₀ ρ_L :=
        hψ_ana.continuousAt.eventually (hψ_w₀.symm ▸ Metric.ball_mem_nhds z₀ hρ_L_pos)
      exact h1.and (h2.and h3)
    obtain ⟨ρ_y, hρ_y_pos, hρ_y⟩ := Metric.mem_nhds_iff.mp h_ev_y
    have hψ_holo : DifferentiableOn ℂ (ψ_loc z₀) (Metric.ball w₀ ρ_y) :=
      fun y hy => (hρ_y hy).1.differentiableAt.differentiableWithinAt
    let B_δ₀ : Set (ℂ × ℂ) := Metric.ball (0 : ℂ) G.δ₀ ×ˢ Metric.ball (0 : ℂ) G.δ₀
    have hB_open : IsOpen B_δ₀ := Metric.isOpen_ball.prod Metric.isOpen_ball
    have hp₀_B : (z₀, (0 : ℂ)) ∈ B_δ₀ :=
      ⟨by simpa using hz₀_δ₀, Metric.mem_ball_self G.δ₀_pos⟩
    have hNZ_cont : ContinuousAt G.N_Z (z₀, 0) :=
      (G.N_Z_holo.differentiableAt (hB_open.mem_nhds hp₀_B)).continuousAt
    have hD_cont : ContinuousAt G.D_ZW (z₀, 0) :=
      (G.D_ZW_holo.differentiableAt (hB_open.mem_nhds hp₀_B)).continuousAt
    have hD_z₀ : G.D_ZW (z₀, 0) ≠ 0 := G.D_ZW_slice_ne_zero z₀ hz₀_pos hz₀_δ₀
    have hXZ_z₀ : G.N_Z (z₀, 0) / G.D_ZW (z₀, 0) = w₀ := by
      rw [G.slice_Z_eq z₀ hz₀_pos hz₀_δ₀, mul_div_cancel_right₀ _ hD_z₀]
    have hXZ_cont : ContinuousAt (fun p => G.N_Z p / G.D_ZW p) (z₀, 0) :=
      hNZ_cont.div hD_cont hD_z₀
    have h_ev_X : ∀ᶠ p in nhds (z₀, (0 : ℂ)),
        G.D_ZW p ≠ 0 ∧ G.N_Z p / G.D_ZW p ∈ Metric.ball w₀ ρ_y :=
      (hD_cont.eventually_ne hD_z₀).and
        (hXZ_cont.eventually (hXZ_z₀.symm ▸ Metric.ball_mem_nhds w₀ hρ_y_pos))
    obtain ⟨δ_X, hδ_X_pos, hδ_X⟩ := Metric.mem_nhds_iff.mp h_ev_X
    let m_Z : ℝ := min ρ_L (min δ_X G.δ₀)
    have hm_Z_pos : 0 < m_Z := lt_min hρ_L_pos (lt_min hδ_X_pos G.δ₀_pos)
    let r_Z : ℝ := m_Z / 4
    have hr_Z_def : r_Z = m_Z / 4 := rfl
    have hr_Z_pos : 0 < r_Z := by positivity
    have h2r_lt_ρL : 2 * r_Z < ρ_L := by
      have : m_Z ≤ ρ_L := min_le_left _ _
      linarith
    have h2r_lt_δX : 2 * r_Z < δ_X := by
      have : m_Z ≤ δ_X := le_trans (min_le_right _ _) (min_le_left _ _)
      linarith
    have h2r_lt_δ₀ : 2 * r_Z < G.δ₀ := by
      have : m_Z ≤ G.δ₀ := le_trans (min_le_right _ _) (min_le_right _ _)
      linarith
    have hz_ball_punc : ∀ z : ℂ, ‖z - z₀‖ < 2 * r_Z → 0 < ‖z‖ ∧ ‖z‖ < S.δ₁ :=
      fun z hz => hρ₀_punc z (lt_of_lt_of_le (lt_trans hz h2r_lt_ρL) (min_le_left _ _))
    let W_Z : Set (ℂ × ℂ) := Metric.ball z₀ (2 * r_Z) ×ˢ Metric.ball (0 : ℂ) (2 * r_Z)
    have hWZ_open : IsOpen W_Z := Metric.isOpen_ball.prod Metric.isOpen_ball
    have hWZ_sub_B : W_Z ⊆ B_δ₀ := by
      rintro ⟨z, t⟩ ⟨hz, ht⟩
      rw [Metric.mem_ball, dist_eq_norm] at hz
      rw [Metric.mem_ball, dist_zero_right] at ht
      have hz_lt : ‖z‖ < G.δ₀ := lt_of_lt_of_le (hz_ball_punc z hz).2 S.δ₁_le
      have ht_lt : ‖t‖ < G.δ₀ := lt_trans ht h2r_lt_δ₀
      exact ⟨Metric.mem_ball.mpr (by simpa using hz_lt),
        Metric.mem_ball.mpr (by simpa using ht_lt)⟩
    have hWZ_sub_δX : W_Z ⊆ Metric.ball (z₀, (0 : ℂ)) δ_X := by
      rintro ⟨z, t⟩ ⟨hz, ht⟩
      rw [Metric.mem_ball, Prod.dist_eq, max_lt_iff]
      exact ⟨lt_trans (Metric.mem_ball.mp hz) h2r_lt_δX,
        lt_trans (Metric.mem_ball.mp ht) h2r_lt_δX⟩
    have hXZ_WZ_holo : DifferentiableOn ℂ (fun p => G.N_Z p / G.D_ZW p) W_Z := by
      have hfn : (fun p => G.N_Z p / G.D_ZW p) = fun p => G.N_Z p * (G.D_ZW p)⁻¹ := by
        ext p; exact div_eq_mul_inv _ _
      rw [hfn]
      exact (G.N_Z_holo.mono hWZ_sub_B).mul
        ((G.D_ZW_holo.mono hWZ_sub_B).fun_inv (fun p hp => (hδ_X (hWZ_sub_δX hp)).1))
    have hv_holo : DifferentiableOn ℂ (v_loc z₀) W_Z :=
      hψ_holo.comp hXZ_WZ_holo (fun p hp => (hδ_X (hWZ_sub_δX hp)).2)
    have hv_props : ∀ z t : ℂ, ‖z - z₀‖ < 2 * r_Z → ‖t‖ < 2 * r_Z →
        0 < ‖v_loc z₀ (z, t)‖ ∧ ‖v_loc z₀ (z, t)‖ < S.δ₁ ∧
        G.D_ZW (z, t) ≠ 0 ∧
        v_loc z₀ (z, -t) = v_loc z₀ (z, t) ∧
        G.N_Z (z, t) / G.D_ZW (z, t) = G.Z_loc (v_loc z₀ (z, t)) := by
      intro z t hz ht
      have hp_WZ : (z, t) ∈ W_Z :=
        ⟨Metric.mem_ball.mpr (by rwa [dist_eq_norm]),
         Metric.mem_ball.mpr (by rwa [dist_zero_right])⟩
      have hpm_WZ : (z, -t) ∈ W_Z :=
        ⟨Metric.mem_ball.mpr (by rwa [dist_eq_norm]),
         Metric.mem_ball.mpr (by rw [dist_zero_right, norm_neg]; exact ht)⟩
      obtain ⟨hD_ne, hy_mem⟩ := hδ_X (hWZ_sub_δX hp_WZ)
      have hDm_ne : G.D_ZW (z, -t) ≠ 0 := (hδ_X (hWZ_sub_δX hpm_WZ)).1
      obtain ⟨_, hZ_right, hv_in_ρL⟩ := hρ_y hy_mem
      have hv_dist : ‖v_loc z₀ (z, t) - z₀‖ < ρ_L := by
        simpa [v_loc, dist_eq_norm] using Metric.mem_ball.mp hv_in_ρL
      have hv_punc := hρ₀_punc (v_loc z₀ (z, t)) (lt_of_lt_of_le hv_dist (min_le_left ρ₀ ρ_L0))
      have hz_δ₀ : ‖z‖ < G.δ₀ := lt_of_lt_of_le (hz_ball_punc z hz).2 S.δ₁_le
      have ht_δ₀ : ‖t‖ < G.δ₀ := lt_trans ht h2r_lt_δ₀
      have hfrac_even : G.N_Z (z, -t) / G.D_ZW (z, -t) = G.N_Z (z, t) / G.D_ZW (z, t) := by
        rw [div_eq_div_iff hDm_ne hD_ne]
        exact G.even_Z z t hz_δ₀ ht_δ₀
      refine ⟨hv_punc.1, hv_punc.2, hD_ne, ?_, hZ_right.symm⟩
      dsimp only [v_loc]
      rw [hfrac_even]
    have hv_zero : ∀ z : ℂ, ‖z - z₀‖ < 2 * r_Z → v_loc z₀ (z, 0) = z := by
      intro z hz
      obtain ⟨hz_pos, hz_lt⟩ := hz_ball_punc z hz
      have hz_δ₀ : ‖z‖ < G.δ₀ := lt_of_lt_of_le hz_lt S.δ₁_le
      have hD0 : G.D_ZW (z, 0) ≠ 0 := G.D_ZW_slice_ne_zero z hz_pos hz_δ₀
      dsimp only [v_loc]
      rw [G.slice_Z_eq z hz_pos hz_δ₀, mul_div_cancel_right₀ _ hD0]
      exact hψ_left z (lt_trans hz h2r_lt_ρL)
    have hv_jets : ∀ z : ℂ, ‖z - z₀‖ < 2 * r_Z → ∀ k : ℕ,
        iteratedDeriv k (fun t : ℂ => v_loc z₀ (z, t) - z) 0 / (k.factorial : ℂ) =
          if Even k then v_jet (k / 2) z else 0 := by
      intro z hz k
      let g_z : ℂ → ℂ := fun t => v_loc z₀ (z, t) - z
      split_ifs with heven
      · by_cases hk0 : k = 0
        · subst hk0
          simp [hv_zero z hz, hv_jet_zero z]
        · have hk_div : 2 * (k / 2) = k := Nat.mul_div_cancel' (even_iff_two_dvd.mp heven)
          set j : ℕ := k / 2
          have hj0 : j ≠ 0 := by omega
          obtain ⟨hz_pos, hz_lt⟩ := hz_ball_punc z hz
          have hz_δ₀ : ‖z‖ < G.δ₀ := lt_of_lt_of_le hz_lt S.δ₁_le
          have hfz_ana : AnalyticAt ℂ G.Z_loc z := (G.reg_on_punctured z hz_pos hz_δ₀).1
          have hfz_strict := hfz_ana.hasStrictDerivAt
          have hfz' : deriv G.Z_loc z ≠ 0 := S.deriv_Z_ne_zero z hz_pos hz_lt
          have hψz_eq : ψ_loc z = HasStrictDerivAt.localInverse G.Z_loc (deriv G.Z_loc z) z
              hfz_strict hfz' := by
            simp only [ψ_loc, hz_pos, hz_lt, and_self, ↓reduceDIte]
          have hψz_left : ∀ᶠ w in nhds z, ψ_loc z (G.Z_loc w) = w := by
            rw [hψz_eq]
            exact hfz_strict.eventually_left_inverse hfz'
          have hp_z0 : (z, (0 : ℂ)) ∈ W_Z :=
            ⟨Metric.mem_ball.mpr (by rwa [dist_eq_norm]),
             Metric.mem_ball_self (mul_pos zero_lt_two hr_Z_pos)⟩
          have hv_slice_cont : ContinuousAt (fun t : ℂ => v_loc z₀ (z, t)) 0 :=
            ((hv_holo.differentiableAt (hWZ_open.mem_nhds hp_z0)).comp (0 : ℂ)
              ((differentiableAt_const z).prodMk differentiableAt_id)).continuousAt
          have hev_eq : g_z =ᶠ[nhds (0 : ℂ)] (fun t : ℂ => v_loc z (z, t) - z) := by
            have ht_ball : ∀ᶠ t : ℂ in nhds 0, t ∈ Metric.ball (0 : ℂ) (2 * r_Z) :=
              Metric.ball_mem_nhds 0 (mul_pos zero_lt_two hr_Z_pos)
            have hv_tendsto : Filter.Tendsto (fun t : ℂ => v_loc z₀ (z, t)) (nhds 0) (nhds z) := by
              simpa only [hv_zero z hz] using hv_slice_cont.tendsto
            have hv_left_ev : ∀ᶠ t : ℂ in nhds 0,
