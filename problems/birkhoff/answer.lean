        (hSub.comp1D_mem F_val (fun m => (hSC_mem i m).1) (h_step_tr_c0 i) h_step_m) u
    
    let E_plus_low : Fin k → MvPowerSeries (Fin 2) ℂ := fun i =>
      lcJetEdgePlus2D (h_low i) (S_ser i) (C_ser i)
