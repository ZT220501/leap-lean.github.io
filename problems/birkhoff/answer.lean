by
  have hCalc : UniversalGlancingCalculus := complex_partial_and_diffop_calculus
  obtain ⟨A⟩ := normalized_action_calculus_and_taylor Ω B hCalc
  obtain ⟨O⟩ := glancing_scale_and_operator_props Ω B hCalc A
  obtain ⟨F⟩ := automatic_factorization_and_perturbation Ω B hCalc A O
  exact ⟨{
    s_act := O.s_act
    d_act := O.d_act
    η_adm := O.η_adm
