      exact hBndCongr (fun _ _ => by ring) hs
    have h3 := hCalc.comp_bnd m σ' (Real.exp R_W) (2 * M) V_W Complex.exp (fun z => 2 * W₁ z)
      Metric.isOpen_ball (Real.exp_nonneg _) (by linarith) hExpBall.1
      (fun j _ w hw => hExpBall.2 j w hw) h2W1_bnd.1
      (fun z hz => Metric.mem_ball.mpr (by rw [dist_zero_right]; linarith [hBndPt h2W1_bnd z hz]))
