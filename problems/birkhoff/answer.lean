        have hUs_eq : U_s = U0 + η_U := by dsimp only [η_U]; ring
        rw [hUs_eq]
        exact hSer.vanishesBelow_comp1D_taylor (by omega : 1 ≤ N₀) S_ser hU0_c0 hηU_vb
      have h_scalar_id :
          (MvPowerSeries.C (ℓ_base i) : MvPowerSeries (Fin 2) ℂ) *
            MvPowerSeries.C (1 / 2 : ℂ) *
            MvPowerSeries.C (((ℓ_base i) ^ 2)⁻¹) *
