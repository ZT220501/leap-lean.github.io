          |(t₂ - s₂) * (D₁ - D₂)| + |N₁ - N₂| := by
        have h_neg : -(t₂ - s₂) * (D₁ - D₂) - (N₁ - N₂) =
            -((t₂ - s₂) * (D₁ - D₂) + (N₁ - N₂)) := by ring
        rw [h_neg, abs_neg]
        exact abs_add_le _ _
      have h_alg : ((C_sec * C_den) / (q : ℝ) ^ 4) * M + (C_num / (q : ℝ) ^ 4) * M =
          (K_step / (q : ℝ) ^ 4) * M := by
        dsimp [K_step]; ring
      linarith
    have h_mul := mul_le_mul_of_nonneg_left h_prod (by positivity : 0 ≤ 8 * (q : ℝ) / 5)
    have h_lhs : (8 * (q : ℝ) / 5) * (|δ (j + 1) - δ j| * (5 / (8 * (q : ℝ)))) =
