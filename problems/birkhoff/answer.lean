    exact hcomp.sub (differentiableOn_const y)
  have hh_even : ∀ w ∈ Metric.ball (0 : ℂ) r, h_y (-w) = h_y w := by
    intro w hw
    have hw_neg : -w ∈ Metric.ball (0 : ℂ) r := by simpa using hw
    obtain ⟨hc1, hc2, hc3, hc4⟩ := hy_cone_mem w hw
    have hev := (hs_props (y, w) hc1 hc2 hc3 hc4).2.1
    dsimp [h_y] at hev ⊢
    rw [hev]
  have hy0_tube : (y, (0 : ℂ)) ∈ finiteWallTube S.r_star S.h_X := by
    refine ⟨?_, ?_, ?_⟩
    · simp [S.r_star_pos]
    · simp [S.h_X_zero]
      linarith [S.H_pos, hy_im_pos]
    · simp [S.h_X_zero, hy_im]
      exact hexp_pos
  have hBr_nhds : Metric.ball (0 : ℂ) r ∈ nhds (0 : ℂ) := Metric.ball_mem_nhds 0 hr_pos
  have hh_germ : h_y =ᶠ[nhds (0 : ℂ)] (fun w : ℂ => S.𝔰 (y, w) - y) := by
    have hcont : ContinuousAt (fun w : ℂ => (y, w)) 0 :=
