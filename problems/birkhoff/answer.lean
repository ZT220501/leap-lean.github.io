        _ ≤ ∑ t ∈ F₀, (H_hit t).card := Finset.card_biUnion_le
        _ ≤ F₀.card • 2 := Finset.sum_le_card_nsmul F₀ _ 2 (fun t _ => hH_card t)
        _ = 2 * m₀ := by dsimp [m₀]; ring
