        exact mul_ne_zero hlead_C_ne hB_prod_ne
      have hQ_tilde_ann_q₁ :
          ∑ d : Fin (D₀ + 1), ev_pt (Q_tilde d) * (zFn (Ψ q₁)) ^ (d : ℕ) = 0 := by
        have haeval_sum : ∑ d : Fin (D₀ + 1),
            ((p_alg.coeff (d : ℕ) : ↥K_pt) : ℂ) * (zFn (Ψ q₁)) ^ (d : ℕ) = 0 := by
          rw [Fin.sum_univ_eq_sum_range
            (fun d => ((p_alg.coeff d : ↥K_pt) : ℂ) * (zFn (Ψ q₁)) ^ d) (D₀ + 1)]
          rw [Polynomial.aeval_def, Polynomial.eval₂_eq_sum_range] at hp_aeval
          exact hp_aeval
        calc
          ∑ d : Fin (D₀ + 1), ev_pt (Q_tilde d) * (zFn (Ψ q₁)) ^ (d : ℕ)
