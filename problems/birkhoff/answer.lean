  let C₁ : ℝ := 4 * C_cp_anc
  have hD₁_pos : 0 < D₁ := by dsimp [D₁]; linarith
  have hC₁_pos : 0 < C₁ := by dsimp [C₁]; positivity
  let ε_anc : ℝ := 2 / u₀ ^ (3 : ℕ)
  have hε_anc_pos : 0 < ε_anc := by dsimp [ε_anc]; positivity
  have hε_anc_le : ε_anc ≤ ε₀_anc := by
    dsimp [ε_anc]
    rw [div_le_iff₀ (by positivity)]
    have h_le : 2 / ε₀_anc ≤ u₀ := le_max_right _ _
    have h_div := (div_le_iff₀ hε₀_anc_pos).mp h_le
    have hu₀_sq : 1 ≤ u₀ ^ (2 : ℕ) := by nlinarith
    calc (2 : ℝ) ≤ u₀ * ε₀_anc := h_div
