            (h_eqMod_refl j (lineArcFormalCos2D1D sin_d0 cos_d0 β_full i_R)))) j le_rfl
      rw [h_grad_fj]
      obtain ⟨_, h_midL_s0, h_midL_c0, _, _, h_sinL_s0, h_cosL_s0, h_midL_mod, h_sinL_mod, h_cosL_mod⟩ :=
        h_seg_perts sin_d0 cos_d0 β_full J i_L hβ0
      obtain ⟨_, h_midR_s0, h_midR_c0, _, _, h_sinR_s0, h_cosR_s0, h_midR_mod, h_sinR_mod, h_cosR_mod⟩ :=
        h_seg_perts sin_d0 cos_d0 β_full J i_R hβ0
      have hfj0 : ∀ i : Fin k, f_j i 0 = f_full i 0 := fun i => by simp [f_j, lineArcTruncSupport]
      let H_L := compPowerSeries2D (f_full i_L 0) (lineRecMid0 (β_full 0) i_L)
      let H'_L := compPowerSeries2D (PowerSeries.derivative (f_full i_L 0)) (lineRecMid0 (β_full 0) i_L)
      let H''_L := compPowerSeries2D (PowerSeries.derivative (PowerSeries.derivative (f_full i_L 0)))
        (lineRecMid0 (β_full 0) i_L)
      let H_R := compPowerSeries2D (f_full i_R 0) (lineRecMid0 (β_full 0) i_R)
      let H'_R := compPowerSeries2D (PowerSeries.derivative (f_full i_R 0)) (lineRecMid0 (β_full 0) i_R)
      let H''_R := compPowerSeries2D (PowerSeries.derivative (PowerSeries.derivative (f_full i_R 0)))
        (lineRecMid0 (β_full 0) i_R)
      let S_L := lineRecSin0 sin_d0 cos_d0 (β_full 0) i_L
      let C_L := lineRecCos0 sin_d0 cos_d0 (β_full 0) i_L
      let S_R := lineRecSin0 sin_d0 cos_d0 (β_full 0) i_R
      let C_R := lineRecCos0 sin_d0 cos_d0 (β_full 0) i_R
      have h_HL_mod : lineRecEqMod j
          (lineArcComp2D1D (f_j i_L) (lineArcFormalMid2D1D β_full i_L))
          (lineArcComp2D1D (f_j i_L) (lineArcFormalMid2D1D β_trunc i_L) +
            lineRecXeps j * lineRecIota0 (H'_L * lineRecMid0 β_top i_L)) := by
        refine h_eqMod_trans (h_comp_congr_Z j _ _ _ h_midL_mod) ?_
        have ha := h_comp_arg_split hj (f_j i_L) (lineArcFormalMid2D1D β_trunc i_L)
          (lineRecMid0 β_top i_L) (by rw [h_midL_s0]; exact h_midL_c0)
        rwa [hfj0, h_midL_s0] at ha
      have h_H'L_mod : lineRecEqMod j
          (lineArcComp2D1D (fun l => PowerSeries.derivative (f_j i_L l))
            (lineArcFormalMid2D1D β_full i_L))
          (lineArcComp2D1D (fun l => PowerSeries.derivative (f_j i_L l))
            (lineArcFormalMid2D1D β_trunc i_L) +
            lineRecXeps j * lineRecIota0 (H''_L * lineRecMid0 β_top i_L)) := by
        refine h_eqMod_trans (h_comp_congr_Z j _ _ _ h_midL_mod) ?_
        have ha := h_comp_arg_split hj (fun l => PowerSeries.derivative (f_j i_L l))
          (lineArcFormalMid2D1D β_trunc i_L) (lineRecMid0 β_top i_L)
          (by rw [h_midL_s0]; exact h_midL_c0)
        rwa [hfj0, h_midL_s0] at ha
      have h_HR_mod : lineRecEqMod j
          (lineArcComp2D1D (f_j i_R) (lineArcFormalMid2D1D β_full i_R))
          (lineArcComp2D1D (f_j i_R) (lineArcFormalMid2D1D β_trunc i_R) +
            lineRecXeps j * lineRecIota0 (H'_R * lineRecMid0 β_top i_R)) := by
        refine h_eqMod_trans (h_comp_congr_Z j _ _ _ h_midR_mod) ?_
        have ha := h_comp_arg_split hj (f_j i_R) (lineArcFormalMid2D1D β_trunc i_R)
          (lineRecMid0 β_top i_R) (by rw [h_midR_s0]; exact h_midR_c0)
        rwa [hfj0, h_midR_s0] at ha
      have h_H'R_mod : lineRecEqMod j
          (lineArcComp2D1D (fun l => PowerSeries.derivative (f_j i_R l))
            (lineArcFormalMid2D1D β_full i_R))
          (lineArcComp2D1D (fun l => PowerSeries.derivative (f_j i_R l))
            (lineArcFormalMid2D1D β_trunc i_R) +
            lineRecXeps j * lineRecIota0 (H''_R * lineRecMid0 β_top i_R)) := by
        refine h_eqMod_trans (h_comp_congr_Z j _ _ _ h_midR_mod) ?_
        have ha := h_comp_arg_split hj (fun l => PowerSeries.derivative (f_j i_R l))
          (lineArcFormalMid2D1D β_trunc i_R) (lineRecMid0 β_top i_R)
          (by rw [h_midR_s0]; exact h_midR_c0)
        rwa [hfj0, h_midR_s0] at ha
      have hp1 := h_eqMod_trans (h_eqMod_mul h_H'L_mod h_sinL_mod)
        (h_prod_pert hj _ _ _ _)
      have hp2 := h_eqMod_trans (h_eqMod_mul h_HL_mod h_cosL_mod)
        (h_prod_pert hj _ _ _ _)
      have hp3 := h_eqMod_trans (h_eqMod_mul h_H'R_mod h_sinR_mod)
        (h_prod_pert hj _ _ _ _)
      have hp4 := h_eqMod_trans (h_eqMod_mul h_HR_mod h_cosR_mod)
        (h_prod_pert hj _ _ _ _)
      have h_grad_mod := h_eqMod_sub (h_eqMod_add (h_eqMod_add hp1 hp2) hp3) hp4 j le_rfl
      unfold lineArcFormalGrad2D1D
      dsimp only
      change lineArcSlice2D1D j
          (lineArcComp2D1D (fun l => PowerSeries.derivative (f_j i_L l))
              (lineArcFormalMid2D1D β_full i_L) *
            lineArcFormalSin2D1D sin_d0 cos_d0 β_full i_L +
           lineArcComp2D1D (f_j i_L) (lineArcFormalMid2D1D β_full i_L) *
            lineArcFormalCos2D1D sin_d0 cos_d0 β_full i_L +
           lineArcComp2D1D (fun l => PowerSeries.derivative (f_j i_R l))
              (lineArcFormalMid2D1D β_full i_R) *
            lineArcFormalSin2D1D sin_d0 cos_d0 β_full i_R -
           lineArcComp2D1D (f_j i_R) (lineArcFormalMid2D1D β_full i_R) *
            lineArcFormalCos2D1D sin_d0 cos_d0 β_full i_R) = _
      rw [h_grad_mod]
      dsimp only [j, β_trunc, β_top] at *
      simp only [h_slice_add, h_slice_sub, h_slice_Xeps_eq, h_slice0_iota,
        h_comp_slice0, hfj0, h_midL_s0, h_midR_s0, h_sinL_s0, h_cosL_s0, h_sinR_s0, h_cosR_s0]
      let D_val : MvPowerSeries (Fin 2) ℂ :=
        ((H''_L - H_L) * MvPowerSeries.C (1 / 2 : ℂ) * S_L + H'_L * C_L) +
          ((H''_R - H_R) * MvPowerSeries.C (1 / 2 : ℂ) * S_R - H'_R * C_R)
      let U_val : MvPowerSeries (Fin 2) ℂ :=
        (H_R + H''_R) * MvPowerSeries.C (1 / 2 : ℂ) * S_R
      let B_val : MvPowerSeries (Fin 2) ℂ :=
        (H_L + H''_L) * MvPowerSeries.C (1 / 2 : ℂ) * S_L
      have h_hess_split : ∀ s : Fin (k - 1),
          lineRecHess0 sin_d0 cos_d0 (fun i => f_full i 0) (β_full 0) r s *
              β_top ⟨s.1 + 1, by have := s.2; omega⟩ =
            (if s = r then D_val * β_top ⟨s.1 + 1, by have := s.2; omega⟩ else 0) +
            (if s.1 = r.1 + 1 then U_val * β_top ⟨s.1 + 1, by have := s.2; omega⟩ else 0) +
            (if r.1 = s.1 + 1 then B_val * β_top ⟨s.1 + 1, by have := s.2; omega⟩ else 0) := by
        intro s
        unfold lineRecHess0
        change (if r.1 = s.1 then D_val else if s.1 = r.1 + 1 then U_val else if r.1 = s.1 + 1 then B_val else 0) *
            β_top ⟨s.1 + 1, by have := s.2; omega⟩ = _
        by_cases h1 : r.1 = s.1
        · have hsr : s = r := Fin.ext h1.symm
          have hn2 : ¬ (s.1 = r.1 + 1) := by omega
          have hn3 : ¬ (r.1 = s.1 + 1) := by omega
          rw [if_pos h1, if_pos hsr, if_neg hn2, if_neg hn3, add_zero, add_zero]
        · have hsr : s ≠ r := fun h => h1 (congr_arg Fin.val h.symm)
          rw [if_neg h1, if_neg hsr, zero_add]
          by_cases h2 : s.1 = r.1 + 1
          · have hn3 : ¬ (r.1 = s.1 + 1) := by omega
            rw [if_pos h2, if_pos h2, if_neg hn3, add_zero]
          · rw [if_neg h2, if_neg h2, zero_add]
            by_cases h3 : r.1 = s.1 + 1
            · rw [if_pos h3, if_pos h3]
            · rw [if_neg h3, if_neg h3, zero_mul]
      have h_sum_D :
          (∑ s : Fin (k - 1),
            if s = r then D_val * β_top ⟨s.1 + 1, by have := s.2; omega⟩ else 0) =
          D_val * β_top ⟨r.1 + 1, by have := r.2; omega⟩ := by
        rw [Finset.sum_eq_single r]
        · simp
        · intro s _ hne; rw [if_neg hne]
        · intro hnot; exact False.elim (hnot (Finset.mem_univ r))
      have h_sum_U :
          (∑ s : Fin (k - 1),
            if s.1 = r.1 + 1 then U_val * β_top ⟨s.1 + 1, by have := s.2; omega⟩ else 0) =
          U_val * β_top (i_R.succ) := by
        by_cases hr_top : r.1 + 1 < k - 1
        · let s_hi : Fin (k - 1) := ⟨r.1 + 1, hr_top⟩
          rw [Finset.sum_eq_single s_hi]
          · rw [if_pos rfl]
            rfl
          · intro s _ hne
            have hval_ne : s.1 ≠ r.1 + 1 := fun h => hne (Fin.ext h)
            rw [if_neg hval_ne]
          · intro hnot; exact False.elim (hnot (Finset.mem_univ s_hi))
        · have h_zero_sum : (∑ s : Fin (k - 1),
              if s.1 = r.1 + 1 then U_val * β_top ⟨s.1 + 1, by have := s.2; omega⟩ else 0) = 0 := by
            apply Finset.sum_eq_zero
            intro s _
            have hs_lt := s.2
            rw [if_neg (by omega)]
          have hiR_last : i_R.succ = Fin.last k := by
            ext; dsimp [i_R]; have := r.2; omega
          dsimp only [β_top, j]
          rw [h_zero_sum, hiR_last, (hβ_end J).2, mul_zero]
      have h_sum_B :
          (∑ s : Fin (k - 1),
            if r.1 = s.1 + 1 then B_val * β_top ⟨s.1 + 1, by have := s.2; omega⟩ else 0) =
          B_val * β_top (i_L.castSucc) := by
        by_cases hr_bot : 0 < r.1
        · let s_lo : Fin (k - 1) := ⟨r.1 - 1, by have := r.2; omega⟩
          rw [Finset.sum_eq_single s_lo]
          · have hs_eq : r.1 = s_lo.1 + 1 := by dsimp [s_lo]; omega
            rw [if_pos hs_eq]
            congr 2
            ext; dsimp [s_lo, i_L]; omega
          · intro s _ hne
            have hval_ne : r.1 ≠ s.1 + 1 := by
              intro h
              apply hne
              ext; dsimp [s_lo]; omega
            rw [if_neg hval_ne]
          · intro hnot; exact False.elim (hnot (Finset.mem_univ s_lo))
        · have h_zero_sum : (∑ s : Fin (k - 1),
              if r.1 = s.1 + 1 then B_val * β_top ⟨s.1 + 1, by have := s.2; omega⟩ else 0) = 0 := by
            apply Finset.sum_eq_zero
            intro s _
            rw [if_neg (by omega)]
          have hiL_zero : i_L.castSucc = 0 := by
            ext; dsimp [i_L]; omega
          dsimp only [β_top, j]
          rw [h_zero_sum, hiL_zero, (hβ_end J).1, mul_zero]
      have h_hess_tot :
          (∑ s : Fin (k - 1),
            lineRecHess0 sin_d0 cos_d0 (fun i => f_full i 0) (β_full 0) r s *
              β_top ⟨s.1 + 1, by have := s.2; omega⟩) =
          D_val * β_top ⟨r.1 + 1, by have := r.2; omega⟩ +
            U_val * β_top (i_R.succ) +
            B_val * β_top (i_L.castSucc) := by
        simp_rw [h_hess_split]
        rw [Finset.sum_add_distrib, Finset.sum_add_distrib, h_sum_D, h_sum_U, h_sum_B]
      rw [h_hess_tot]
      have h_one_half : MvPowerSeries.C (1 / 2 : ℂ) * (2 : MvPowerSeries (Fin 2) ℂ) = 1 := by
        have h2 : (2 : MvPowerSeries (Fin 2) ℂ) = MvPowerSeries.C (2 : ℂ) := by rw [map_ofNat]
        rw [h2, ← map_mul]; norm_num
      have hD_re : D_val =
          ((H''_L - H_L) * MvPowerSeries.C (1 / 2 : ℂ) * S_L +
            H'_L * C_L * (MvPowerSeries.C (1 / 2 : ℂ) * 2)) +
          ((H''_R - H_R) * MvPowerSeries.C (1 / 2 : ℂ) * S_R -
            H'_R * C_R * (MvPowerSeries.C (1 / 2 : ℂ) * 2)) := by
        dsimp only [D_val]
        rw [h_one_half, mul_one, mul_one]
      rw [hD_re]
      have hv_L_succ : i_L.succ = ⟨r.1 + 1, by have := r.2; omega⟩ := rfl
      have hv_R_cast : i_R.castSucc = ⟨r.1 + 1, by have := r.2; omega⟩ := rfl
      dsimp only [U_val, B_val, H_L, H'_L, H''_L, H_R, H'_R, H''_R, S_L, C_L, S_R, C_R, β_top, j]
      unfold lineRecMid0 lineRecHalfStep0
      rw [hv_L_succ, hv_R_cast]
      dsimp only [i_L, i_R]
      ring
  have hKF : E.K_end ≤ E.F_val := fun x hx => Subfield.subset_closure (Or.inl hx)
  obtain ⟨Φ, hΦ_K, hΦ_const, ⟨r₀, hr₀_ne⟩⟩ :=
    hAlg.formal_arc E.K_end E.N_core E.coreTuple hNonAlg
  obtain ⟨hLift_const, hLift_K, hLift_F⟩ :=
    hLift.liftArcFn_props E.K_end E.F_val Φ hKF hΦ_K hΦ_const
  obtain ⟨hLiftMv_C, hLiftMv_ring⟩ := hLift.liftMv2D_ring E.F_val Φ
  let p₁ : ℂ × ℂ := ((a₁ : ℂ), (δ₁ : ℂ))
  let U₀ : Set (ℂ × ℂ) := G.U_a ×ˢ G.U_d
  have hU₀_open : IsOpen U₀ := Metric.isOpen_ball.prod Metric.isOpen_ball
  have hq₁_trap : (a₁, δ₁) ∈ webTrapezoid G.a₀ G.R G.δ_star G.C₀ := by
    refine ⟨hδ₁.1, hδ₁.2, ?_⟩
    have ha₁_abs : |a₁ - G.a₀| < G.R / 4 :=
