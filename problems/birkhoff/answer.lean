        have hδ_le : δ2 ≤ h ^ 2 := min_le_right _ _
        rw [hμ_eq]
        calc |y - x| * δ2 ≤ |y - x| * h ^ 2 :=
              mul_le_mul_of_nonneg_left hδ_le (abs_nonneg _)
          _ ≤ h * (y - x) ^ 2 := by
