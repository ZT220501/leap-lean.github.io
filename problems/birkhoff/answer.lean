          have h_mid := le_trans h_sum_le2 h_piece2
          have h_comb :
              ‖t‖ ^ 2 * M_scale ^ 2 * (D (j + 2)) ^ (1 - 2 * α) +
                (C_J / ((2 * α - 1) * γ_steep)) *
                  ‖t‖ ^ 2 * M_scale ^ 2 * (D (j + 2)) ^ (1 - 2 * α) +
                C_J * ‖t‖ ^ 2 * M_scale ^ 2 * (D (j + 2)) ^ (1 - 2 * α) =
              C_st * ‖t‖ ^ 2 * M_scale ^ 2 * (D (j + 2)) ^ (1 - 2 * α) := by
            dsimp only [C_st]
            ring
          linarith only [h_norm_tel, h_piece1, h_mid, h_piece3, h_comb]
        exact ⟨ih_b, hb_top, hJ_all, h_contr_all, h_diff_all⟩
    obtain ⟨_, hN_b, _, hN_contr, _⟩ := h_ind N le_rfl
    refine ⟨hybot_S, hybot1_S, ?_, ?_⟩
    · have hpsi_eq : b N = refSteepPsi P s_init N y t := rfl
      rw [← hpsi_eq, ← hw_top]
      exact hN_b
    · intro m hm
      exact (hN_contr m hm).1
  have h_chain_holo : ∀ (N : ℕ) (V : Set (ℂ × ℂ)),
      IsOpen V → V ⊆ W_up →
      (∀ p ∈ V,
        δ_ceil - (31 / 32) * Δ_slab < h_ref - (p.1 - (N : ℂ) * p.2).im ∧
        h_ref - (p.1 - ((N : ℂ) + 1) * p.2).im < δ_ceil - (1 / 32) * Δ_slab) →
      DifferentiableOn ℂ (fun p : ℂ × ℂ => refSteepPsi P s_init N p.1 p.2) V := by
    intro N V hV_open hV_sub hV_slab
    have h_shear_diff : ∀ c : ℂ, DifferentiableOn ℂ (fun p : ℂ × ℂ => (p.1 - c * p.2, p.2)) V := by
      intro c
      let L_sh : (ℂ × ℂ) →L[ℂ] (ℂ × ℂ) :=
        { toFun := fun p => (p.1 - c * p.2, p.2)
          map_add' := fun p q => by
            apply Prod.ext
            · simp; ring
            · simp
          map_smul' := fun s p => by
            apply Prod.ext
            · simp; ring
            · simp
          cont := (continuous_fst.sub (continuous_const.mul continuous_snd)).prodMk continuous_snd }
