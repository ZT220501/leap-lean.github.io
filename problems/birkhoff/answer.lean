          continuous_const).continuousOn
    have hBoundL : ∀ l ∈ Set.Icc l_lo l_hi,
        (2 * Real.pi)⁻¹ * (2 * L_k * Real.exp (-l) * Φ_row (bootRowPt S l 0)) ≤
          2 * (A + 1) * Real.exp (2 * A + 1) * (rowMomentFull S l) ^ 2 := by
      intro l hl_m
      have hStripL : ∀ x : ℝ, bootRowPt S l x ∈ horizStrip S.H := hStripRowL l hl_m
      have hΦ_le : Φ_row (bootRowPt S l 0) ≤
          ∫ x in (0 : ℝ)..(2 * Real.pi),
            (‖S.f (bootRowPt S l x)‖ ^ 2 + ‖S.q (bootRowPt S l x)‖) := by
        dsimp only [Φ_row]
        rw [hBootIm]
        refine intervalIntegral.integral_mono_on (by positivity)
          (((hContShape.pow 2).comp_continuous (Complex.continuous_ofReal.add continuous_const)
            hStripL).intervalIntegrable _ _)
          ((((S.f_holo.continuousOn.norm.pow 2).add S.q_holo.continuousOn.norm).comp_continuous
            (Complex.continuous_ofReal.add continuous_const) hStripL).intervalIntegrable _ _)
          (fun x _ => ?_)
        have hmax : (shapeModulus S (bootRowPt S l x)) ^ 2 =
            max (‖S.f (bootRowPt S l x)‖ ^ 2) ‖S.q (bootRowPt S l x)‖ := by
          dsimp [shapeModulus]
          rcases le_total ‖S.f (bootRowPt S l x)‖ (Real.sqrt ‖S.q (bootRowPt S l x)‖) with h | h
          · have h2 := pow_le_pow_left₀ (norm_nonneg _) h 2
            rw [Real.sq_sqrt (norm_nonneg _)] at h2
            rw [max_eq_right h, Real.sq_sqrt (norm_nonneg _), max_eq_right h2]
          · have h2 := pow_le_pow_left₀ (Real.sqrt_nonneg _) h 2
            rw [Real.sq_sqrt (norm_nonneg _)] at h2
            rw [max_eq_left h, max_eq_left h2]
        change (shapeModulus S (bootRowPt S l x)) ^ 2 ≤ _
        rw [hmax]
        exact max_le (le_add_of_nonneg_right (norm_nonneg _)) (le_add_of_nonneg_left (sq_nonneg _))
      have hexp_lk : d_k * Real.exp l ≤ Real.exp (A + 1) := by
        dsimp [d_k]
        rw [← Real.exp_add]
        exact Real.exp_le_exp.mpr (by dsimp [l_hi] at hl_m; linarith [hl_m.2])
      have hMomEq := hRowMomSqEq l hl_m
      have hExpCancel : Real.exp (-l) * Real.exp (2 * l) = Real.exp l := by
        rw [← Real.exp_add]; ring_nf
      have hIntFQ_nn : 0 ≤ (2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi),
          (‖S.f (bootRowPt S l x)‖ ^ 2 + ‖S.q (bootRowPt S l x)‖) :=
        mul_nonneg (by positivity) (intervalIntegral.integral_nonneg (by positivity) fun _ _ => by positivity)
      have hMomInv : (2 * Real.pi)⁻¹ * (∫ x in (0 : ℝ)..(2 * Real.pi),
          (‖S.f (bootRowPt S l x)‖ ^ 2 + ‖S.q (bootRowPt S l x)‖)) =
          Real.exp (2 * l) * (rowMomentFull S l) ^ 2 := by
        rw [hMomEq, ← mul_assoc, ← Real.exp_add]
        norm_num
      calc (2 * Real.pi)⁻¹ * (2 * L_k * Real.exp (-l) * Φ_row (bootRowPt S l 0))
          ≤ (2 * Real.pi)⁻¹ * (2 * L_k * Real.exp (-l) *
              ∫ x in (0 : ℝ)..(2 * Real.pi),
                (‖S.f (bootRowPt S l x)‖ ^ 2 + ‖S.q (bootRowPt S l x)‖)) := by gcongr
        _ = 2 * L_k * Real.exp (-l) * ((2 * Real.pi)⁻¹ *
              ∫ x in (0 : ℝ)..(2 * Real.pi),
                (‖S.f (bootRowPt S l x)‖ ^ 2 + ‖S.q (bootRowPt S l x)‖)) := by ring
        _ = 2 * (A + 1) * Real.exp A * d_k * (Real.exp (-l) * Real.exp (2 * l)) *
              (rowMomentFull S l) ^ 2 := by rw [hMomInv]; dsimp [L_k]; ring
        _ = 2 * (A + 1) * Real.exp A * (d_k * Real.exp l) * (rowMomentFull S l) ^ 2 := by
              rw [hExpCancel]; ring
        _ ≤ 2 * (A + 1) * Real.exp A * Real.exp (A + 1) * (rowMomentFull S l) ^ 2 := by gcongr
        _ = 2 * (A + 1) * Real.exp (2 * A + 1) * (rowMomentFull S l) ^ 2 := by
              rw [mul_assoc (2 * (A + 1)), ← Real.exp_add]; ring_nf
    have hAvgRx : (2 * Real.pi)⁻¹ * (∫ x in (0 : ℝ)..(2 * Real.pi),
        ∫ w in R_x x, (shapeModulus S w) ^ 2) ≤
        2 * (A + 1) * Real.exp (2 * A + 1) *
          ∫ l in l_lo..l_hi, (rowMomentFull S l) ^ 2 := by
      rw [hSwapEq, ← intervalIntegral.integral_const_mul, ← intervalIntegral.integral_const_mul]
      exact intervalIntegral.integral_mono_on hl_le
        (hIntΦ_l.const_mul _) (hIntRowMomSq.const_mul _) hBoundL
    have hIntTileSq : IntervalIntegrable (fun x => (tileSupModulus S A k x) ^ 2)
        MeasureTheory.volume 0 (2 * Real.pi) :=
      (((hTileContPer A k hA0 hk).1).pow 2).intervalIntegrable _ _
    have hIntRxOfX : IntervalIntegrable
        (fun x => ∫ w in R_x x, (shapeModulus S w) ^ 2)
        MeasureTheory.volume 0 (2 * Real.pi) := by
      simp_rw [hRx_shift]
      apply ContinuousOn.intervalIntegrable
      rw [Set.uIcc_of_le (by positivity : (0 : ℝ) ≤ 2 * Real.pi)]
      have hUnif := (isCompact_Icc.prod hCompR0).uniformContinuousOn_of_continuous hContJoint
      rw [Metric.continuousOn_iff]
      intro x₀ hx₀ ε hε
      rw [Metric.uniformContinuousOn_iff] at hUnif
      obtain ⟨δ, hδ_pos, hδ⟩ := hUnif (ε / (2 * (MeasureTheory.volume.real R₀ + 1))) (by positivity)
      refine ⟨δ, hδ_pos, fun x₁ hx₁ hd => ?_⟩
      have hI₀ : MeasureTheory.IntegrableOn (fun ζ => (shapeModulus S ((x₀ : ℂ) + ζ)) ^ 2) R₀ MeasureTheory.volume :=
        (hContJoint.comp (Continuous.continuousOn (continuous_const.prodMk continuous_id))
          (fun ζ hζ => ⟨hx₀, hζ⟩)).integrableOn_compact hCompR0
      have hI₁ : MeasureTheory.IntegrableOn (fun ζ => (shapeModulus S ((x₁ : ℂ) + ζ)) ^ 2) R₀ MeasureTheory.volume :=
        (hContJoint.comp (Continuous.continuousOn (continuous_const.prodMk continuous_id))
          (fun ζ hζ => ⟨hx₁, hζ⟩)).integrableOn_compact hCompR0
      rw [Real.dist_eq, ← MeasureTheory.integral_sub hI₁ hI₀]
      have hle : ‖∫ ζ in R₀, ((shapeModulus S ((x₁ : ℂ) + ζ)) ^ 2 -
          (shapeModulus S ((x₀ : ℂ) + ζ)) ^ 2)‖ ≤
          ∫ _ in R₀, (ε / (2 * (MeasureTheory.volume.real R₀ + 1))) := by
        refine le_trans (MeasureTheory.norm_integral_le_integral_norm _) ?_
        refine MeasureTheory.setIntegral_mono_on (hI₁.sub hI₀).norm
          (MeasureTheory.integrableOn_const hCompR0.measure_lt_top.ne)
          ((isClosed_le continuous_const Complex.continuous_re).inter
            ((isClosed_le Complex.continuous_re continuous_const).inter
              ((isClosed_le continuous_const Complex.continuous_im).inter
                (isClosed_le Complex.continuous_im continuous_const)))).measurableSet
          (fun ζ hζ => le_of_lt (hδ (x₁, ζ) ⟨hx₁, hζ⟩ (x₀, ζ) ⟨hx₀, hζ⟩
            (by simpa [Prod.dist_eq] using hd)))
      rw [Real.norm_eq_abs, MeasureTheory.setIntegral_const, smul_eq_mul] at hle
      have hv_nn : 0 ≤ MeasureTheory.volume.real R₀ := MeasureTheory.measureReal_nonneg
      have hlt : MeasureTheory.volume.real R₀ * (ε / (2 * (MeasureTheory.volume.real R₀ + 1))) < ε := by
        have hden : 0 < 2 * (MeasureTheory.volume.real R₀ + 1) := by positivity
        rw [mul_div_assoc', div_lt_iff₀ hden]
        nlinarith
      linarith
    have hMainMono := intervalIntegral.integral_mono_on (by positivity : (0 : ℝ) ≤ 2 * Real.pi)
      hIntTileSq
      (intervalIntegrable_const.add (hIntRxOfX.const_mul _))
      (fun x _ => hTilePt x)
    rw [intervalIntegral.integral_add intervalIntegrable_const (hIntRxOfX.const_mul _),
        intervalIntegral.integral_const, smul_eq_mul, sub_zero,
        intervalIntegral.integral_const_mul] at hMainMono
    have hDiv2Pi := mul_le_mul_of_nonneg_left hMainMono (by positivity : (0 : ℝ) ≤ (2 * Real.pi)⁻¹)
    have hSimpLHS : (2 * Real.pi)⁻¹ * (2 * Real.pi * M_low ^ 2 +
        (4 * Real.exp (2 * A) / Real.pi) * ∫ x in (0 : ℝ)..(2 * Real.pi),
          ∫ w in R_x x, (shapeModulus S w) ^ 2) =
        M_low ^ 2 + (4 * Real.exp (2 * A) / Real.pi) * ((2 * Real.pi)⁻¹ *
          ∫ x in (0 : ℝ)..(2 * Real.pi), ∫ w in R_x x, (shapeModulus S w) ^ 2) := by
      have hpi : 2 * Real.pi ≠ 0 := by positivity
      field_simp [hpi]
    rw [hSimpLHS] at hDiv2Pi
    have hCoef : (4 * Real.exp (2 * A) / Real.pi) * (2 * (A + 1) * Real.exp (2 * A + 1)) =
        8 * (A + 1) * Real.exp (4 * A + 1) / Real.pi := by
      calc (4 * Real.exp (2 * A) / Real.pi) * (2 * (A + 1) * Real.exp (2 * A + 1))
          = 8 * (A + 1) * (Real.exp (2 * A) * Real.exp (2 * A + 1)) / Real.pi := by ring
        _ = 8 * (A + 1) * Real.exp (4 * A + 1) / Real.pi := by
              rw [← Real.exp_add]; ring_nf
    have hMomIntNN : 0 ≤ ∫ l in l_lo..l_hi, (rowMomentFull S l) ^ 2 :=
      intervalIntegral.integral_nonneg hl_le (fun _ _ => sq_nonneg _)
    have hCt2_a : M_low ^ 2 ≤ C_t2 := le_trans (le_max_left _ _) (le_max_right _ _)
    have hCt2_b : 8 * (A + 1) * Real.exp (4 * A + 1) / Real.pi ≤ C_t2 :=
      le_trans (le_max_right _ _) (le_max_right _ _)
    calc (2 * Real.pi)⁻¹ * (∫ x in (0 : ℝ)..(2 * Real.pi), (tileSupModulus S A k x) ^ 2)
        ≤ M_low ^ 2 + (4 * Real.exp (2 * A) / Real.pi) * ((2 * Real.pi)⁻¹ *
            ∫ x in (0 : ℝ)..(2 * Real.pi), ∫ w in R_x x, (shapeModulus S w) ^ 2) := hDiv2Pi
      _ ≤ M_low ^ 2 + (4 * Real.exp (2 * A) / Real.pi) *
            (2 * (A + 1) * Real.exp (2 * A + 1) *
              ∫ l in l_lo..l_hi, (rowMomentFull S l) ^ 2) := by gcongr
      _ = M_low ^ 2 + (8 * (A + 1) * Real.exp (4 * A + 1) / Real.pi) *
            ∫ l in l_lo..l_hi, (rowMomentFull S l) ^ 2 := by linear_combination hCoef * ∫ l in l_lo..l_hi, (rowMomentFull S l) ^ 2
      _ ≤ C_t2 + C_t2 * ∫ l in l_lo..l_hi, (rowMomentFull S l) ^ 2 :=
          add_le_add hCt2_a (mul_le_mul_of_nonneg_right hCt2_b hMomIntNN)
      _ = C_t2 * (1 + ∫ l in l_lo..l_hi, (rowMomentFull S l) ^ 2) := by ring

  exact
    { zero_row_mean_P := hRowMean
      real_axis_im_zero := hRealIm
      row_ball_from_V_sup := hRowBallSup
      row_cell_from_P_int := hRowCellInt
      disk_submean_modulus := hDiskSubmean
      tile_cont_per := hTileContPer
      tile_L2_from_rows := hTileL2 }

theorem ucb_quadratic_and_tile_bootstrap (S : FiniteWallNonisotropicStrip)
    (hInt : BootInteriorTransferProp S)
    (β a C_N C₁ : ℝ) (hβ0 : 0 ≤ β) (hβhalf : β < 1 / 2)
    (ha : 0 < a) (hCN : 1 ≤ C_N) (hC1 : 0 < C₁)
    (D : BootConeNegativePartData S β a C_N C₁) :
    ∃ C_quad C_p : ℝ, 0 < C_quad ∧ 0 < C_p ∧
      (∀ N : ℝ → ℝ, IsCriticalEnvelope S β a C_N C₁ N →
        ∀ k : ℝ, criticalDepthThreshold S ≤ k →
          rowMomentFull S k ≤ C_quad * N k ∧
          (2 * Real.pi)⁻¹ * (∫ x in (0 : ℝ)..(2 * Real.pi),
            Real.exp (-k) * |(S.V (bootRowPt S k x)).im|) ≤
            C_quad * (N k) ^ 2 ∧
          (2 * Real.pi)⁻¹ * (∫ x in (0 : ℝ)..(2 * Real.pi),
            (Real.exp (-k) * max ((S.V (bootRowPt S k x)).im) 0 / (N k) ^ 2) ^
              ((4 * a + 3) / (4 * a + 2))) ≤ C_p) ∧
      (∀ A : ℝ, 1 ≤ A → ∃ C_tile : ℝ, 0 < C_tile ∧
        ∀ N : ℝ → ℝ, IsCriticalEnvelope S β a C_N C₁ N →
          ∀ k : ℝ, criticalDepthThreshold S ≤ k →
            Real.sqrt ((2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi),
              (tileSupModulus S A k x) ^ 2) ≤ C_tile * N k) :=
by
  let k₀ : ℝ := criticalDepthThreshold S
  have hStrip_mem : ∀ l : ℝ, k₀ - 1 ≤ l →
      |S.H - Real.exp (-l)| < S.H ∧ ∀ u : ℝ, bootRowPt S l u ∈ horizStrip S.H := by
    intro l hl
    have hlog : -Real.log (S.H / 20) ≤ k₀ := le_max_right 1 (-Real.log (S.H / 20))
    have hl1 : -l - 1 ≤ Real.log (S.H / 20) := by linarith
    have hH20 : 0 < S.H / 20 := by linarith [S.H_pos]
    have hexp1 : Real.exp (-l - 1) ≤ S.H / 20 := by
      simpa [Real.exp_log hH20] using Real.exp_le_exp.mpr hl1
    have hexp_lt : Real.exp (-l) < S.H := by
      have hsplit : Real.exp (-l) = Real.exp (-l - 1) * Real.exp 1 := by
        rw [← Real.exp_add]
        ring_nf
      have he3 : Real.exp 1 < 3 := Real.exp_one_lt_three
      have hexp_pos : 0 < Real.exp (-l - 1) := Real.exp_pos _
      nlinarith [S.H_pos]
    have him_abs : |S.H - Real.exp (-l)| < S.H :=
      abs_lt.mpr ⟨by linarith [Real.exp_pos (-l), S.H_pos], by linarith [Real.exp_pos (-l)]⟩
    refine ⟨him_abs, fun u => ?_⟩
    simpa only [horizStrip, bootRowPt, Set.mem_setOf_eq, Complex.add_im, Complex.ofReal_im,
      Complex.mul_I_im, Complex.ofReal_re, zero_add] using him_abs
  have hFubini : ∀ (a₁ b₁ a₂ b₂ : ℝ), a₁ ≤ b₁ → a₂ ≤ b₂ →
      ∀ (g : ℝ → ℝ → ℝ), Continuous (Function.uncurry g) →
        (∫ x in a₁..b₁, ∫ y in a₂..b₂, g x y) = ∫ y in a₂..b₂, ∫ x in a₁..b₁, g x y := by
    intro a₁ b₁ a₂ b₂ ha₁ ha₂ g hg
    simp_rw [intervalIntegral.integral_of_le ha₁, intervalIntegral.integral_of_le ha₂]
    apply MeasureTheory.integral_integral_swap
    change MeasureTheory.Integrable (Function.uncurry g) _
    rw [MeasureTheory.Measure.prod_restrict, ← MeasureTheory.Measure.volume_eq_prod]
    exact (hg.continuousOn.integrableOn_compact (isCompact_Icc.prod isCompact_Icc)).mono_set
      (Set.prod_mono Set.Ioc_subset_Icc_self Set.Ioc_subset_Icc_self)
  have hEnv_window : ∀ (N : ℝ → ℝ), IsCriticalEnvelope S β a C_N C₁ N →
      ∀ (W k l : ℝ), 0 ≤ W → k₀ ≤ k → k₀ ≤ l → |l - k| ≤ W →
        N l ≤ C_N * N k * Real.exp (max β a * W) := by
    intro N hN W k l hW hk hl hdist
    have hNk_pos : 0 < N k := lt_of_lt_of_le zero_lt_one (hN.one_le k hk)
    have hCNk_nonneg : 0 ≤ C_N * N k := by positivity
    have habs := abs_sub_le_iff.mp hdist
    rcases le_total l k with hlk | hkl
    · calc N l ≤ C_N * N k * Real.exp (β * (k - l)) := hN.coarse_bound l k hl hlk
        _ ≤ C_N * N k * Real.exp (max β a * W) := by
          apply mul_le_mul_of_nonneg_left _ hCNk_nonneg
          apply Real.exp_le_exp.mpr
          exact mul_le_mul (le_max_left β a) habs.2 (by linarith)
            (le_trans hβ0 (le_max_left β a))
    · calc N l ≤ C_N * N k * Real.exp (a * (l - k)) := hN.fine_bound l k hk hkl
        _ ≤ C_N * N k * Real.exp (max β a * W) := by
          apply mul_le_mul_of_nonneg_left _ hCNk_nonneg
          apply Real.exp_le_exp.mpr
          exact mul_le_mul (le_max_right β a) habs.1 (by linarith)
            (le_trans (le_of_lt ha) (le_max_right β a))
  
  let l_clamp : ℝ → ℝ := fun l => max (k₀ - 1) l
  let F : ℝ → ℝ → ℝ := fun l u => Real.exp (-l) * |(S.V (bootRowPt S l u)).im|
  let F_ext : ℝ → ℝ → ℝ := fun l u => F (l_clamp l) u
  have hclamp_cont : Continuous l_clamp := continuous_const.max continuous_id
  have hF_ext_cont : Continuous (Function.uncurry F_ext) := by
    let φ : ℝ × ℝ → ℂ := fun p => bootRowPt S (l_clamp p.1) p.2
    have hφ_cont : Continuous φ := by
      dsimp [φ, bootRowPt]
      exact (Complex.continuous_ofReal.comp continuous_snd).add
        ((Complex.continuous_ofReal.comp
          (continuous_const.sub (Real.continuous_exp.comp (hclamp_cont.comp continuous_fst).neg))).mul
          continuous_const)
    have hφ_mem : ∀ p : ℝ × ℝ, φ p ∈ horizStrip S.H :=
      fun p => (hStrip_mem (l_clamp p.1) (le_max_left _ _)).2 p.2
    have hV_cont : Continuous (fun p : ℝ × ℝ => S.V (φ p)) :=
      S.V_holo.continuousOn.comp_continuous hφ_cont hφ_mem
    change Continuous (fun p : ℝ × ℝ => Real.exp (-l_clamp p.1) * |(S.V (φ p)).im|)
    exact (Real.continuous_exp.comp (hclamp_cont.comp continuous_fst).neg).mul
      (continuous_abs.comp (Complex.continuous_im.comp hV_cont))
  have hF_ext_eq : ∀ l u : ℝ, k₀ - 1 ≤ l → F_ext l u = F l u :=
    fun l u hl => by simp [F_ext, l_clamp, max_eq_right hl]
  have hF_ext_nonneg : ∀ l u : ℝ, 0 ≤ F_ext l u :=
    fun l u => mul_nonneg (Real.exp_nonneg _) (abs_nonneg _)
  have hF_ext_per : ∀ l : ℝ, Function.Periodic (F_ext l) (2 * Real.pi) := by
    intro l u
    have hmem : bootRowPt S (l_clamp l) u ∈ horizStrip S.H :=
      (hStrip_mem (l_clamp l) (le_max_left _ _)).2 u
    have hpt : bootRowPt S (l_clamp l) (u + 2 * Real.pi) =
        bootRowPt S (l_clamp l) u + 2 * Real.pi := by
      simp only [bootRowPt]
      push_cast
      ring
    dsimp [F_ext, F]
    rw [hpt, S.V_periodic _ hmem]
  let I_ext : ℝ → ℝ := fun l => (2 * Real.pi)⁻¹ * ∫ u in (0 : ℝ)..(2 * Real.pi), F_ext l u
  have hI_ext_cont : Continuous I_ext :=
    continuous_const.mul
      (intervalIntegral.continuous_parametric_intervalIntegral_of_continuous' hF_ext_cont
        0 (2 * Real.pi))
  have hI_ext_nonneg : ∀ l : ℝ, 0 ≤ I_ext l := fun l =>
    mul_nonneg (by positivity)
      (intervalIntegral.integral_nonneg (by positivity) (fun u _ => hF_ext_nonneg l u))
  obtain ⟨l_sh, _, hl_sh_max⟩ :=
    isCompact_Icc.exists_isMaxOn
      (⟨k₀, by linarith, le_rfl⟩ : (Set.Icc (k₀ - 1) k₀).Nonempty) hI_ext_cont.continuousOn
  let M_sh : ℝ := I_ext l_sh
  have hM_sh_nonneg : 0 ≤ M_sh := hI_ext_nonneg l_sh
  have hM_sh_bound : ∀ l ∈ Set.Icc (k₀ - 1) k₀, I_ext l ≤ M_sh :=
    fun l hl => isMaxOn_iff.mp hl_sh_max l hl
  obtain ⟨C_cell, hC_cell_pos, hCell⟩ := hInt.row_cell_from_P_int
  let C_row : ℝ := max (2 * C_cell * (1 + 4 * M_sh)) (8 * C_cell)
  have hC_row_pos : 0 < C_row := lt_of_lt_of_le (by positivity) (le_max_right _ _)
  have hRowSq : ∀ (k B : ℝ), k₀ ≤ k → 0 ≤ B →
      (∀ l : ℝ, k₀ ≤ l → |l - k| ≤ 1 →
        (2 * Real.pi)⁻¹ * (∫ u in (0 : ℝ)..(2 * Real.pi), F l u) ≤ B) →
      (rowMomentFull S k) ^ 2 ≤ C_row * (1 + B) := by
    intro k B hk hB hB_row
    let d_k : ℝ := Real.exp (-k)
    have hd_k_pos : 0 < d_k := Real.exp_pos (-k)
    have hk_m1 : k₀ - 1 ≤ k := by linarith
    have hrow_cont : Continuous (bootRowPt S k) :=
      Complex.continuous_ofReal.add continuous_const
    have hrow_mem : ∀ x : ℝ, bootRowPt S k x ∈ horizStrip S.H := (hStrip_mem k hk_m1).2
    have hf_row_cont : Continuous (fun x : ℝ => S.f (bootRowPt S k x)) :=
      S.f_holo.continuousOn.comp_continuous hrow_cont hrow_mem
    have hq_row_cont : Continuous (fun x : ℝ => S.q (bootRowPt S k x)) :=
      S.q_holo.continuousOn.comp_continuous hrow_cont hrow_mem
    have hsm_row_cont : Continuous (fun x : ℝ => shapeModulus S (bootRowPt S k x)) :=
      (continuous_norm.comp hf_row_cont).max
        (Real.continuous_sqrt.comp (continuous_norm.comp hq_row_cont))
    let h_fq : ℝ → ℝ := fun x => ‖S.f (bootRowPt S k x)‖ ^ 2 + ‖S.q (bootRowPt S k x)‖
    have h_fq_cont : Continuous h_fq :=
      ((continuous_norm.comp hf_row_cont).pow 2).add (continuous_norm.comp hq_row_cont)
    have h_fq_le : ∀ x : ℝ, d_k ^ 2 * h_fq x ≤ 2 * (d_k * shapeModulus S (bootRowPt S k x)) ^ 2 := by
      intro x
      have h1 : ‖S.f (bootRowPt S k x)‖ ≤ shapeModulus S (bootRowPt S k x) := le_max_left _ _
      have h2 : Real.sqrt ‖S.q (bootRowPt S k x)‖ ≤ shapeModulus S (bootRowPt S k x) := le_max_right _ _
      have hf2 : ‖S.f (bootRowPt S k x)‖ ^ 2 ≤ (shapeModulus S (bootRowPt S k x)) ^ 2 :=
