          · obtain ⟨q, hqV, hq_nz⟩ := h_mul_nz Metric.isOpen_ball
              (h_num_den_holo p hp a).2.continuousOn (h_ci_nz a) ih.1 V hV hV_ne hV_sub
            exact ⟨q, hqV, by rw [Finset.prod_insert ha]; exact hq_nz⟩
