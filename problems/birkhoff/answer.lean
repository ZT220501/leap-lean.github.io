    have hη_rb : η_sf ≤ r_b / 10 := le_trans (min_le_left _ _) (min_le_right _ _)
    have h_cauchy_bdd : ∀ (Q' : ℝ → ℂ) (a₀' a₁' : ℂ) (ρ' : ℝ),
        ContinuousOn Q' (Set.Icc (0 : ℝ) 1) →
        (∀ w ∈ Set.Icc (0 : ℝ) 1, ‖Q' w - Q₀ w‖ < δ_Q) →
