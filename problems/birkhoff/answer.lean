  let g_bar : ℕ → ℝ → ℝ := fun m x => ∫ u : ℝ, g (m + 1) (x + u) * κ m u
  have hgbar_meas : ∀ m < M, Measurable (g_bar m) := by
    intro m hm
    have hj : Measurable (fun p : ℝ × ℝ => g (m + 1) (p.1 + p.2) * κ m p.2) :=
      ((hg_cont (m + 1) (by omega)).measurable.comp measurable_add).mul
        ((hκ_cont m hm).measurable.comp measurable_snd)
    exact hj.stronglyMeasurable.integral_prod_right'.measurable
  have hgbar_bdd : ∀ m < M, ∀ x : ℝ, |g_bar m x| ≤ B := by
    intro m hm x; rw [← Real.norm_eq_abs]
    calc ‖∫ u : ℝ, g (m + 1) (x + u) * κ m u‖
