      have ha_bounds : ∀ n om, 0 ≤ a n om ∧ a n om ≤ 1 ∧ (a n om) ^ 2 = a n om := by
        intro n om
        by_cases h : om ∈ A_set n
        · simp [a, Set.indicator_of_mem h]
        · simp [a, Set.indicator_of_notMem h]
      have hClockCap : ∀ om : WalkSpace,
