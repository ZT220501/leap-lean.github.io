            (continuous_const.add (Complex.continuous_ofReal.mul continuous_const)).continuousOn
          have hγ_maps : Set.MapsTo (fun s : ℝ => X₀ + (s : ℂ) * ((θ : ℂ) * Y₀))
              (Set.Icc (0 : ℝ) 1) (horizStrip σ) := fun s hs => hPtMem θ hθ s hs
