      obtain ⟨η, hη_pos, hη_ball⟩ := Metric.mem_nhds_iff.mp h_mid_nhds
      let U₀ : Set ℂ := Metric.ball (0 : ℂ) η
      have hU₀_open : IsOpen U₀ := Metric.isOpen_ball
      have h0_mem : (0 : ℂ) ∈ U₀ := Metric.mem_ball_self hη_pos
      have hU₀_nhds : U₀ ∈ nhds (0 : ℂ) := hU₀_open.mem_nhds h0_mem
      let JetDiff (A B : ℂ → ℂ) (c : ℂ) : Prop :=
