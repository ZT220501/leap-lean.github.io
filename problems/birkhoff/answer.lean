  have h_conj_kernel_holo : ∀ w ∈ Metric.ball (0 : ℂ) 1,
      ∃ ρ_w : ℝ, 1 < ρ_w ∧ ρ_w ≤ 11 / 10 ∧
        DifferentiableOn ℂ (fun z : ℂ => w / (1 - w * z)) (Metric.ball (0 : ℂ) ρ_w) := by
    intro w hw
    have hwn : ‖w‖ < 1 := by simpa [Metric.mem_ball, dist_zero_right] using hw
    have hw_pos : 0 < 1 + ‖w‖ := by linarith [norm_nonneg w]
    let ρ_w : ℝ := min (11 / 10 : ℝ) (2 / (1 + ‖w‖))
    have h1_lt : 1 < ρ_w := by
