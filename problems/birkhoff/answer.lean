      have hj1 : j + 1 ≤ q := by omega
      let ρ : ℝ := 2 * Real.pi * (j : ℝ) / (q : ℝ)
      have he_X₁ : IsRealJetPerturb p ((4 * (q : ℝ))⁻¹) (d₁ j) :=
        hJet_mono hRq2_le_4q (hd₁.2.2.2.1 j hj0)
      have hτ_T₁ : IsRealJetPerturb p ((4 * (q : ℝ))⁻¹) (fun y => d₁ (j + 1) y - d₁ j y) :=
        hJet_mono hRq3_le_4q (hd₁.2.2.2.2 j hj)
      have he_X₂ : IsRealJetPerturb p ((4 * (q : ℝ))⁻¹) (d₂ j) :=
        hJet_mono hRq2_le_4q (hd₂.2.2.2.1 j hj0)
      have hτ_T₂ : IsRealJetPerturb p ((4 * (q : ℝ))⁻¹) (fun y => d₂ (j + 1) y - d₂ j y) :=
        hJet_mono hRq3_le_4q (hd₂.2.2.2.2 j hj)
      have hΔτ_eq : (fun y => (d₁ (j + 1) y - d₁ j y) - (d₂ (j + 1) y - d₂ j y)) =
          (fun y => (d₁ (j + 1) y - d₂ (j + 1) y) - (d₁ j y - d₂ j y)) := by
        funext y; ring
      have hmid_lip := J_R.midpoint_lip q ρ
        ((4 * C_force_lip * Δ_w) / (q : ℝ) ^ 2)
        ((4 * C_force_lip * Δ_w) / (q : ℝ) ^ 3)
        w₁ w₂ (d₁ j) (fun y => d₁ (j + 1) y - d₁ j y) (d₂ j) (fun y => d₂ (j + 1) y - d₂ j y)
        hq_jet (by positivity) (by positivity) hw₁ hw₂ he_X₁ hτ_T₁ he_X₂ hτ_T₂
        ((hd_diff_4L.2.2.2.1 j hj0).2.2)
        (by rw [hΔτ_eq]; exact (hd_diff_4L.2.2.2.2 j hj).2.2)
        k hk x
      have hμ_diff_eq : (fun y =>
          (midpoint_ℝ w₁ ((y + ρ + d₁ j y))
              ((y + ρ + d₁ j y) + (2 * Real.pi / (q : ℝ) + (d₁ (j + 1) y - d₁ j y))) -
            ((y + ρ + d₁ j y) + (2 * Real.pi / (q : ℝ) + (d₁ (j + 1) y - d₁ j y)) / 2)) -
          (midpoint_ℝ w₂ ((y + ρ + d₂ j y))
              ((y + ρ + d₂ j y) + (2 * Real.pi / (q : ℝ) + (d₂ (j + 1) y - d₂ j y))) -
            ((y + ρ + d₂ j y) + (2 * Real.pi / (q : ℝ) + (d₂ (j + 1) y - d₂ j y)) / 2))) =
          (fun y => realMidpointDisp q w₁ j y - realMidpointDisp q w₂ j y) := by
        funext y
        simp only [realMidpointDisp, hMesh₁_eval y j hj0, hMesh₁_eval y (j + 1) hj1,
          hMesh₂_eval y j hj0, hMesh₂_eval y (j + 1) hj1, ρ]
        have h1a : (y + 2 * Real.pi * (j : ℝ) / (q : ℝ) + d₁ j y) +
            (2 * Real.pi / (q : ℝ) + (d₁ (j + 1) y - d₁ j y)) =
            y + 2 * Real.pi * ((j + 1 : ℕ) : ℝ) / (q : ℝ) + d₁ (j + 1) y := by
          push_cast; ring
        have h1b : (y + 2 * Real.pi * ((j + 1 : ℕ) : ℝ) / (q : ℝ) + d₁ (j + 1) y) -
            (y + 2 * Real.pi * (j : ℝ) / (q : ℝ) + d₁ j y) =
            2 * Real.pi / (q : ℝ) + (d₁ (j + 1) y - d₁ j y) := by
          push_cast; ring
        have h2a : (y + 2 * Real.pi * (j : ℝ) / (q : ℝ) + d₂ j y) +
            (2 * Real.pi / (q : ℝ) + (d₂ (j + 1) y - d₂ j y)) =
            y + 2 * Real.pi * ((j + 1 : ℕ) : ℝ) / (q : ℝ) + d₂ (j + 1) y := by
          push_cast; ring
        have h2b : (y + 2 * Real.pi * ((j + 1 : ℕ) : ℝ) / (q : ℝ) + d₂ (j + 1) y) -
            (y + 2 * Real.pi * (j : ℝ) / (q : ℝ) + d₂ j y) =
            2 * Real.pi / (q : ℝ) + (d₂ (j + 1) y - d₂ j y) := by
          push_cast; ring
        rw [h1a, h1b, h2a, h2b]
      rw [hμ_diff_eq] at hmid_lip
      have h_rhs_le : J_R.C_mid_R *
          ((4 * C_force_lip * Δ_w) / (q : ℝ) ^ 2 +
            (q : ℝ) * ((4 * C_force_lip * Δ_w) / (q : ℝ) ^ 3) + Δ_w) ≤ R_real * Δ_w := by
        have h_eq : (4 * C_force_lip * Δ_w) / (q : ℝ) ^ 2 +
            (q : ℝ) * ((4 * C_force_lip * Δ_w) / (q : ℝ) ^ 3) + Δ_w =
            ((8 * C_force_lip) / (q : ℝ) ^ 2 + 1) * Δ_w := by
          field_simp [hq_nz]
          ring
        rw [h_eq, ← mul_assoc]
        have h8L_le2 : (8 * C_force_lip) / (q : ℝ) ^ 2 ≤ 2 :=
          (div_le_iff₀ (pow_pos hq_pos 2)).mpr (by linarith)
        have h_mid3 : J_R.C_mid_R * ((8 * C_force_lip) / (q : ℝ) ^ 2 + 1) ≤ 3 * J_R.C_mid_R := by
          nlinarith [J_R.C_mid_R_pos]
        exact mul_le_mul_of_nonneg_right (le_trans h_mid3 h3Mid_le_R) hΔ_w_nn
      exact le_trans hmid_lip h_rhs_le

theorem strip_dirichlet_inv_calculus : StripDirichletInvProp :=
by
  have h_bound_out : ∀ (q : ℕ) (f : ℕ → ℂ → ℂ),
      1 ≤ q →
      (∀ z : ℂ, dirichletInv_ℂ q f 0 z = 0 ∧ dirichletInv_ℂ q f q z = 0) ∧
      (∀ j : ℕ, q < j → ∀ z : ℂ, dirichletInv_ℂ q f j z = 0) := by
    intro q f hq
    have hq_ne_C : (q : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
    refine ⟨?_, ?_⟩
    · intro z
      refine ⟨?_, ?_⟩
      · simp only [dirichletInv_ℂ, Nat.zero_le q, ↓reduceIte, Finset.sum_range_zero]
      · simp only [dirichletInv_ℂ, le_rfl, ↓reduceIte, dirichletSlope_ℂ, Finset.sum_add_distrib,
          Finset.sum_const, Finset.card_range, nsmul_eq_mul, dirichletSlope0_ℂ]
        have hmul :
            (q : ℂ) * (-((q : ℂ)⁻¹) * ∑ r ∈ Finset.range q, dirichletPartSum_ℂ f r z) =
              -(∑ r ∈ Finset.range q, dirichletPartSum_ℂ f r z) := by
          calc
            (q : ℂ) * (-((q : ℂ)⁻¹) * ∑ r ∈ Finset.range q, dirichletPartSum_ℂ f r z)
              = -(((q : ℂ) * (q : ℂ)⁻¹) * ∑ r ∈ Finset.range q, dirichletPartSum_ℂ f r z) := by
                ring
            _ = -(1 * ∑ r ∈ Finset.range q, dirichletPartSum_ℂ f r z) := by
                rw [mul_inv_cancel₀ hq_ne_C]
            _ = -(∑ r ∈ Finset.range q, dirichletPartSum_ℂ f r z) := by
                ring
        rw [hmul]
        ring
    · intro j hj z
      have hnot : ¬ j ≤ q := not_le.mpr hj
      simp only [dirichletInv_ℂ, hnot, ↓reduceIte]
  have h_diff : ∀ (q : ℕ) (f : ℕ → ℂ → ℂ),
      1 ≤ q →
      (∀ j : ℕ, j < q → ∀ z : ℂ,
        dirichletInv_ℂ q f (j + 1) z - dirichletInv_ℂ q f j z = dirichletSlope_ℂ q f j z) ∧
      (∀ j : ℕ, j + 1 < q → ∀ z : ℂ,
        dirichletInv_ℂ q f (j + 2) z - 2 * dirichletInv_ℂ q f (j + 1) z +
          dirichletInv_ℂ q f j z = f (j + 1) z) := by
    intro q f _hq
    have h_diff1 : ∀ j : ℕ, j < q → ∀ z : ℂ,
        dirichletInv_ℂ q f (j + 1) z - dirichletInv_ℂ q f j z = dirichletSlope_ℂ q f j z := by
      intro j hj z
      have hj1_le : j + 1 ≤ q := hj
      have hj_le : j ≤ q := le_of_lt hj
      simp only [dirichletInv_ℂ, hj1_le, hj_le, ↓reduceIte, Finset.sum_range_succ]
      ring
    refine ⟨h_diff1, ?_⟩
    intro j hj1 z
    have hj : j < q := Nat.lt_of_succ_lt hj1
    have h2 : j + 2 = (j + 1) + 1 := rfl
    calc
      dirichletInv_ℂ q f (j + 2) z - 2 * dirichletInv_ℂ q f (j + 1) z + dirichletInv_ℂ q f j z
        = (dirichletInv_ℂ q f ((j + 1) + 1) z - dirichletInv_ℂ q f (j + 1) z) -
            (dirichletInv_ℂ q f (j + 1) z - dirichletInv_ℂ q f j z) := by
          rw [h2]
          ring
      _ = dirichletSlope_ℂ q f (j + 1) z - dirichletSlope_ℂ q f j z := by
          rw [h_diff1 (j + 1) hj1 z, h_diff1 j hj z]
      _ = dirichletPartSum_ℂ f (j + 1) z - dirichletPartSum_ℂ f j z := by
          simp only [dirichletSlope_ℂ]
          ring
      _ = f (j + 1) z := by
          simp only [dirichletPartSum_ℂ, Finset.sum_range_succ]
          ring
  have h_sub_eq : ∀ (q : ℕ) (f₁ f₂ : ℕ → ℂ → ℂ) (j : ℕ) (z : ℂ),
      dirichletInv_ℂ q f₁ j z - dirichletInv_ℂ q f₂ j z =
        dirichletInv_ℂ q (fun i ζ => f₁ i ζ - f₂ i ζ) j z := by
    intro q f₁ f₂ j z
    let f_sub : ℕ → ℂ → ℂ := fun i ζ => f₁ i ζ - f₂ i ζ
    have h_part : ∀ r : ℕ,
        dirichletPartSum_ℂ f₁ r z - dirichletPartSum_ℂ f₂ r z =
          dirichletPartSum_ℂ f_sub r z := by
      intro r
      simp only [dirichletPartSum_ℂ, f_sub, ← Finset.sum_sub_distrib]
    have h_slope0 :
        dirichletSlope0_ℂ q f₁ z - dirichletSlope0_ℂ q f₂ z =
          dirichletSlope0_ℂ q f_sub z := by
      simp only [dirichletSlope0_ℂ, ← mul_sub, ← Finset.sum_sub_distrib]
      congr 1
      refine Finset.sum_congr rfl ?_
      intro r _
      exact h_part r
    have h_slope : ∀ r : ℕ,
        dirichletSlope_ℂ q f₁ r z - dirichletSlope_ℂ q f₂ r z =
          dirichletSlope_ℂ q f_sub r z := by
      intro r
      calc
        dirichletSlope_ℂ q f₁ r z - dirichletSlope_ℂ q f₂ r z
          = (dirichletSlope0_ℂ q f₁ z - dirichletSlope0_ℂ q f₂ z) +
              (dirichletPartSum_ℂ f₁ r z - dirichletPartSum_ℂ f₂ r z) := by
            simp only [dirichletSlope_ℂ]
            ring
        _ = dirichletSlope0_ℂ q f_sub z + dirichletPartSum_ℂ f_sub r z := by
            rw [h_slope0, h_part r]
        _ = dirichletSlope_ℂ q f_sub r z := rfl
    by_cases hj : j ≤ q
    · simp only [dirichletInv_ℂ, hj, ↓reduceIte, ← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl ?_
      intro r _
      exact h_slope r
    · simp only [dirichletInv_ℂ, hj, ↓reduceIte, sub_self]
  have h_maps_to_ball : ∀ (p q : ℕ) (σ' M_f : ℝ) (f : ℕ → ℂ → ℂ),
      1 ≤ q →
      0 < σ' →
      0 ≤ M_f →
      (∀ j : ℕ, j + 1 < q → IsStripCJetBounded p σ' M_f (f (j + 1))) →
      IsStripMeshDispBall p q σ' (2 * (q : ℝ) ^ 4 * M_f) (dirichletInv_ℂ q f) := by
    intro p q σ' M_f f hq _hσ' hMf hf
    have hU_open : IsOpen (horizStrip σ') :=
      isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const
    have hq_pos : (0 : ℝ) < (q : ℝ) := by exact_mod_cast (show 0 < q by omega)
    have hq_ne_R : (q : ℝ) ≠ 0 := ne_of_gt hq_pos
    have hContDiffAt : ∀ {g : ℂ → ℂ}, DifferentiableOn ℂ g (horizStrip σ') →
        ∀ (k : ℕ) {z : ℂ}, z ∈ horizStrip σ' →
          ContDiffAt ℂ (k : WithTop ℕ∞) g z := by
      intro g hg k z hz
      exact (hg.contDiffOn hU_open).contDiffAt (hU_open.mem_nhds hz)
    have hJet_zero : ∀ {B : ℝ}, 0 ≤ B → IsStripCJetBounded p σ' B (fun _ => 0) := by
      intro B hB
      refine ⟨differentiableOn_const (0 : ℂ), ?_, ?_, ?_⟩
      · intro _ _
        rfl
      · intro _ _
        exact (map_zero (starRingEnd ℂ)).symm
      · intro k _ z _
        simp only [iteratedDeriv_const, ite_self, norm_zero]
        exact hB
    have hJet_mono : ∀ {B₁ B₂ : ℝ} {g : ℂ → ℂ},
        B₁ ≤ B₂ → IsStripCJetBounded p σ' B₁ g → IsStripCJetBounded p σ' B₂ g := by
      intro B₁ B₂ g hB hg
      exact ⟨hg.1, hg.2.1, hg.2.2.1, fun k hk z hz => le_trans (hg.2.2.2 k hk z hz) hB⟩
    have hJet_add : ∀ {B₁ B₂ : ℝ} {g₁ g₂ : ℂ → ℂ},
        IsStripCJetBounded p σ' B₁ g₁ →
        IsStripCJetBounded p σ' B₂ g₂ →
        IsStripCJetBounded p σ' (B₁ + B₂) (fun z => g₁ z + g₂ z) := by
      intro B₁ B₂ g₁ g₂ hg₁ hg₂
      refine ⟨hg₁.1.fun_add hg₂.1, ?_, ?_, ?_⟩
      · intro z hz
        simp only [hg₁.2.1 z hz, hg₂.2.1 z hz]
      · intro z hz
        simp only [hg₁.2.2.1 z hz, hg₂.2.2.1 z hz, map_add]
      · intro k hk z hz
        rw [iteratedDeriv_fun_add (hContDiffAt hg₁.1 k hz) (hContDiffAt hg₂.1 k hz)]
        exact le_trans (norm_add_le _ _) (add_le_add (hg₁.2.2.2 k hk z hz) (hg₂.2.2.2 k hk z hz))
    have hJet_sum : ∀ (n : ℕ) {B : ℝ} (G : ℕ → ℂ → ℂ),
        0 ≤ B →
        (∀ i : ℕ, i < n → IsStripCJetBounded p σ' B (G i)) →
        IsStripCJetBounded p σ' ((n : ℝ) * B) (fun z => ∑ i ∈ Finset.range n, G i z) := by
      intro n B G hB hG
      induction n with
      | zero =>
        have hfn : (fun z : ℂ => ∑ i ∈ Finset.range 0, G i z) = (fun _ => 0) := by
          ext z
          simp only [Finset.sum_range_zero]
        rw [hfn]
        simpa only [Nat.cast_zero, zero_mul] using hJet_zero (le_refl (0 : ℝ))
      | succ n ih =>
        have hfn : (fun z : ℂ => ∑ i ∈ Finset.range (n + 1), G i z) =
            (fun z : ℂ => (∑ i ∈ Finset.range n, G i z) + G n z) := by
          ext z
          simp only [Finset.sum_range_succ]
        have hBndEq : ((n + 1 : ℕ) : ℝ) * B = (n : ℝ) * B + B := by
          push_cast
          ring
        rw [hfn, hBndEq]
        exact hJet_add (ih (fun i hi => hG i (Nat.lt_succ_of_lt hi))) (hG n (Nat.lt_succ_self n))
    have hJet_neg_inv_q : ∀ {B : ℝ} {g : ℂ → ℂ},
        IsStripCJetBounded p σ' B g →
        IsStripCJetBounded p σ' ((q : ℝ)⁻¹ * B) (fun z => -((q : ℂ)⁻¹) * g z) := by
      intro B g hg
      refine ⟨hg.1.const_mul (-((q : ℂ)⁻¹)), ?_, ?_, ?_⟩
      · intro z hz
        simp only [hg.2.1 z hz]
      · intro z hz
        simp only [hg.2.2.1 z hz, map_mul, map_neg, map_inv₀, map_natCast]
      · intro k hk z hz
        rw [iteratedDeriv_const_mul (-((q : ℂ)⁻¹)) (hContDiffAt hg.1 k hz),
          norm_mul, norm_neg, norm_inv, Complex.norm_natCast]
        exact mul_le_mul_of_nonneg_left (hg.2.2.2 k hk z hz) (inv_nonneg.mpr (Nat.cast_nonneg q))
    have hPart : ∀ r : ℕ, r < q →
        IsStripCJetBounded p σ' ((q : ℝ) * M_f) (dirichletPartSum_ℂ f r) := by
      intro r hr
      have h_sum_r : IsStripCJetBounded p σ' ((r : ℝ) * M_f) (dirichletPartSum_ℂ f r) :=
        hJet_sum r (fun i => f (i + 1)) hMf (fun i hi => hf i (by omega))
      have hr_le : (r : ℝ) * M_f ≤ (q : ℝ) * M_f :=
        mul_le_mul_of_nonneg_right (Nat.cast_le.mpr (le_of_lt hr)) hMf
      exact hJet_mono hr_le h_sum_r
    have hqMf_nonneg : 0 ≤ (q : ℝ) * M_f := mul_nonneg (Nat.cast_nonneg q) hMf
    have hSlope0 : IsStripCJetBounded p σ' ((q : ℝ) * M_f) (dirichletSlope0_ℂ q f) := by
      have h_sum_q : IsStripCJetBounded p σ' ((q : ℝ) * ((q : ℝ) * M_f))
          (fun z => ∑ r ∈ Finset.range q, dirichletPartSum_ℂ f r z) :=
        hJet_sum q (dirichletPartSum_ℂ f) hqMf_nonneg hPart
      have h_scaled : IsStripCJetBounded p σ' ((q : ℝ)⁻¹ * ((q : ℝ) * ((q : ℝ) * M_f)))
          (dirichletSlope0_ℂ q f) :=
        hJet_neg_inv_q h_sum_q
      rwa [inv_mul_cancel_left₀ hq_ne_R] at h_scaled
    have hSlope : ∀ r : ℕ, r < q →
        IsStripCJetBounded p σ' (2 * (q : ℝ) * M_f) (dirichletSlope_ℂ q f r) := by
      intro r hr
      have h_add : IsStripCJetBounded p σ' ((q : ℝ) * M_f + (q : ℝ) * M_f)
          (dirichletSlope_ℂ q f r) :=
        hJet_add hSlope0 (hPart r hr)
      have hEq : (q : ℝ) * M_f + (q : ℝ) * M_f = 2 * (q : ℝ) * M_f := by ring
      rwa [hEq] at h_add
    have h2qMf_nonneg : 0 ≤ 2 * (q : ℝ) * M_f := by positivity
    have hInv : ∀ j : ℕ, j ≤ q →
        IsStripCJetBounded p σ' (2 * (q : ℝ) ^ 2 * M_f) (dirichletInv_ℂ q f j) := by
      intro j hj
      have hfn : dirichletInv_ℂ q f j =
          fun z => ∑ r ∈ Finset.range j, dirichletSlope_ℂ q f r z := by
        ext z
        simp only [dirichletInv_ℂ, hj, ↓reduceIte]
      have h_sum_j : IsStripCJetBounded p σ' ((j : ℝ) * (2 * (q : ℝ) * M_f))
          (dirichletInv_ℂ q f j) := by
        rw [hfn]
        exact hJet_sum j (dirichletSlope_ℂ q f) h2qMf_nonneg
          (fun r hr => hSlope r (lt_of_lt_of_le hr hj))
      have hj_le : (j : ℝ) * (2 * (q : ℝ) * M_f) ≤ 2 * (q : ℝ) ^ 2 * M_f := by
        calc
          (j : ℝ) * (2 * (q : ℝ) * M_f)
            ≤ (q : ℝ) * (2 * (q : ℝ) * M_f) :=
              mul_le_mul_of_nonneg_right (Nat.cast_le.mpr hj) h2qMf_nonneg
          _ = 2 * (q : ℝ) ^ 2 * M_f := by ring
      exact hJet_mono hj_le h_sum_j
    refine ⟨(h_bound_out q f hq).1, (h_bound_out q f hq).2, ?_, ?_⟩
    · intro j hj
      obtain ⟨h_holo, h_per, h_conj, h_bnd⟩ := hInv j hj
      refine ⟨h_holo, h_per, h_conj, ?_⟩
      intro k hk z hz
      calc
        (q : ℝ) ^ 2 * ‖iteratedDeriv k (dirichletInv_ℂ q f j) z‖
          ≤ (q : ℝ) ^ 2 * (2 * (q : ℝ) ^ 2 * M_f) :=
            mul_le_mul_of_nonneg_left (h_bnd k hk z hz) (sq_nonneg _)
        _ = 2 * (q : ℝ) ^ 4 * M_f := by ring
    · intro j hj k hk z hz
      have h_step_eq :
          (fun ζ : ℂ => dirichletInv_ℂ q f (j + 1) ζ - dirichletInv_ℂ q f j ζ) =
            dirichletSlope_ℂ q f j := by
        ext ζ
        exact (h_diff q f hq).1 j hj ζ
      rw [h_step_eq]
      calc
        (q : ℝ) ^ 3 * ‖iteratedDeriv k (dirichletSlope_ℂ q f j) z‖
          ≤ (q : ℝ) ^ 3 * (2 * (q : ℝ) * M_f) :=
            mul_le_mul_of_nonneg_left ((hSlope j hj).2.2.2 k hk z hz)
              (pow_nonneg (Nat.cast_nonneg q) 3)
        _ = 2 * (q : ℝ) ^ 4 * M_f := by ring
  exact {
    boundary_and_outside := h_bound_out
    diff_identities := h_diff
    sub_eq := h_sub_eq
    maps_to_ball := h_maps_to_ball
  }

theorem strip_forcing_bounds_and_lip (m : ℕ) (M₁ : ℝ)
    (hm : 2 ≤ m) (hM₁ : 0 < M₁)
    (J_C : StripHolomorphicJetData m M₁) :
    Nonempty (StripForcingBoundData m M₁ J_C) :=
by
  let p : ℕ := m + 2
  have hp_ge_one : 1 ≤ p := by omega
  let C_mul : ℝ := (2 : ℝ) ^ p
  let C_pow5 : ℝ := 5 * C_mul ^ 4
  let C_inv : ℝ := 2 * C_mul ^ p
  let C_inv_lip : ℝ := C_mul ^ 2 * C_inv ^ 2
  have hC_mul_ge_one : (1 : ℝ) ≤ C_mul := one_le_pow₀ (by norm_num : (1 : ℝ) ≤ 2)
  have hC_mul_pos : 0 < C_mul := by positivity
  have hC_pow5_pos : 0 < C_pow5 := by positivity
  have hC_inv_pos : 0 < C_inv := by positivity
