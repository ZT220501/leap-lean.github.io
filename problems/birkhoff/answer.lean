    have hΔW_nn := (hCalc.stripDiffSup_nonneg_and_le (m + 15) σ M w₁ w₂ W₁ W₂ hσ hW₁ hW₂).1
    let Δ := ΔH + stripDiffSup (m + 15) σ W₁ W₂
    have hΔ_nn : 0 ≤ Δ := add_nonneg hΔH hΔW_nn
    have hHP : PairBnd σ' Δ 1 1 H₁ H₂ :=
      ⟨hH₁, hH₂, hCalc.bnd_mono (by dsimp [Δ]; linarith) hHdiff⟩
    have hSl := (hSlopePair σ σ' τ c ΔH w₁ w₂ W₁ W₂ H₁ H₂ hσ hσ' hσ'σ hΔH hτ hc
      hW₁ hW₂ hH₁ hH₂ hSeg hHdiff).1
    have hκ_norm : ‖(κ : ℂ)‖ ≤ 2 := by simpa [Complex.norm_real, Real.norm_eq_abs] using hκ
    have hSwP := hPairConstMul (C := 2) rfl (by norm_num) hBsl_nn hLsl_nn hΔ_nn hκ_norm hSl
    have hVP := hPairMul hHP hSwP
    have hE1P := (hEnt_v σ' Δ _ _ hσ' hΔ_nn hVP).1
    exact hPairMul hSwP hE1P

  obtain ⟨B_rE, L_rE, hBrE_nn, hLrE_nn, hRE⟩ := hRE_ex

  
  have hRemPair_ex :
