    intro q₀ hq₀ p ⟨hp_q0, hp_col⟩
    have hp_W2 : p ∈ W₂ := hClG₂.1 hp_col
    obtain ⟨η, hη_pos, hη_le, hη_sub, hη_eq⟩ := hClG₂.2.2 p hp_col
    have hdist_p : dist p q₀ < G₂.rad q₀ := Metric.mem_ball.mp hp_q0
    let η₁ : ℝ := min η (G₂.rad q₀ - dist p q₀)
    have hη₁_pos : 0 < η₁ := lt_min hη_pos (sub_pos.mpr hdist_p)
    have hη₁_sub_η : Metric.ball p η₁ ⊆ Metric.ball p η :=
