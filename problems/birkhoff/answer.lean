          (∀ z ∈ horizStrip σ', ξ z ∈ horizStrip σ) ∧
          (∀ j : ℕ, 1 ≤ j → j ≤ p₀ → ∀ z ∈ horizStrip σ', ‖iteratedDeriv j ξ z‖ ≤ B_p) ∧
          IsStripHoloSymBounded p₀ σ' M_W (fun z => deriv W (ξ z)) ∧
          IsStripHoloSymBounded p₀ σ' (2 * M_W) (fun z => W (ξ z) - W (z + (ρ : ℂ) + e_X z)) ∧
          (∀ z ∈ horizStrip σ', W (ξ z) - W (z + (ρ : ℂ) + e_X z) ∈ Metric.ball (0 : ℂ) R_exp) ∧
