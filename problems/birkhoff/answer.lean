        have h_sum : |y₁ - y₂| + |σ * u₁ - σ * u₂| ≤ 2 * (q : ℝ) * M := by linarith
        have h_m := mul_le_mul_of_nonneg_left h_sum (le_of_lt hL₀)
        linarith
      have hu5_diff : |u₁ ^ 5 - u₂ ^ 5| ≤ (32805 / (q : ℝ) ^ 4) * M := by
