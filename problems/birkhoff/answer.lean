                (F_val.pow_mem (hℓ_mem i_L) 3)
            · exact F_val.zero_mem
          have hb_mem : ∀ r : Fin (k - 1), b_vec r ∈ F_val :=
            fun r => F_val.neg_mem (h_grad_ref_mem r)
          have hHz_eq : H_mat.mulVec z_vec = b_vec := by
