        ⟨?_, hJB.1 () trivial, fun k hk x => le_trans (hJB.2.2 () trivial k hk x) hBB_le⟩⟩
      · intro x; dsimp only; rw [hX_qp x, (hPeriodic w (x + ρ + e_X x) 0 hw).1]
      · intro x; dsimp only; rw [hX_qp x, hT_per x, (hPeriodic w (x + ρ + e_X x) _ hw).2]
    · intro q ρ sgn Δe Δτ w₁ w₂ e_X₁ τ_T₁ e_X₂ τ_T₂ hq hsgn hΔe hΔτ hw₁ hw₂ he₁ hτ₁ he₂ hτ₂ hde hdτ
      let J : JetTwoInput_rajcb m M₁ N₀ := {
        q := q, ρ := ρ, sgn := sgn, Δe := Δe, Δτ := Δτ,
        w₁ := w₁, w₂ := w₂, e_X₁ := e_X₁, τ_T₁ := τ_T₁, e_X₂ := e_X₂, τ_T₂ := τ_T₂,
        hq := hq, hsgn := hsgn, hΔe := hΔe, hΔτ := hΔτ,
        hw₁ := hw₁, hw₂ := hw₂, he₁ := he₁, hτ₁ := hτ₁, he₂ := he₂, hτ₂ := hτ₂,
        hde := hde, hdτ := hdτ
      }
      have hJA_lip := (hA J).2.2.2.2
      have hJB_lip := (hB J).2.2.2.2
      refine ⟨fun k hk x => ?_, fun k hk x => ?_⟩
      · exact le_trans (hJA_lip.2.2 () trivial k hk x)
          (mul_le_mul_of_nonneg_right hLA_le (hΔA1 J))
      · exact le_trans (hJB_lip.2.2 () trivial k hk x)
          (mul_le_mul_of_nonneg_right hLB_le (hΔB1 J))
  
  
  
  obtain ⟨B₀_jet, L₀_jet, hB₀_pos, hL₀_pos, hPtBounds⟩ := hPt
  obtain ⟨C_jet_R, N_jet, hC_pos, hN_ge4, hJetProps, hJetLip⟩ := hJet
  exact ⟨{
    C_jet_R := C_jet_R
    B₀_jet := B₀_jet
    L₀_jet := L₀_jet
    N_jet := N_jet
    C_jet_R_pos := hC_pos
    B₀_jet_pos := hB₀_pos
    L₀_jet_pos := hL₀_pos
    N_jet_ge_four := hN_ge4
    jet_pt_bounds := hPtBounds
    jet_props := hJetProps
    jet_lip := hJetLip
  }⟩

theorem real_candidate_mesh_uniqueness (m : ℕ) (M₁ : ℝ)
    (hm : 2 ≤ m) (hM₁ : 0 < M₁)
    (H_base : RealActionTaylorData m M₁)
    (H_jet : RealActionJetCompData m M₁) :
    ∃ N_uniq : ℕ, 4 ≤ N_uniq ∧
      ∀ (q : ℕ) (w : ℝ → ℝ),
        N_uniq ≤ q →
        IsPeriodicSmoothBounded (m + 15) M₁ w →
        ∀ (x : ℝ) (X₁ X₂ : ℕ → ℝ),
          IsStationaryRealMesh q w x X₁ →
          IsStationaryRealMesh q w x X₂ →
          X₁ = X₂ :=
by
  let B₀ : ℝ := H_jet.B₀_jet
  have hB₀ : 0 < B₀ := H_jet.B₀_jet_pos
  let L₀ : ℝ := H_jet.L₀_jet
  have hL₀ : 0 < L₀ := H_jet.L₀_jet_pos
  let C_sec : ℝ := 200000 * B₀
  let C_den : ℝ := 1 + 972 * B₀ + 2916 * L₀
  let C_num : ℝ := 65610 * B₀ + 236196 * L₀
  let K_step : ℝ := C_sec * C_den + C_num
  let C_tot : ℝ := 2 * K_step
  let N_uniq : ℕ := max 5 (max (Nat.ceil (2592 * B₀) + 1) (Nat.ceil (2 * C_tot) + 1))
  refine ⟨N_uniq, le_trans (by norm_num : 4 ≤ 5) (le_max_left 5 _), ?_⟩
  intro q w hq hw x X₁ X₂ hX₁ hX₂
  have hC_sec_pos : 0 < C_sec := by dsimp [C_sec]; positivity
  have hC_den_pos : 0 < C_den := by dsimp [C_den]; positivity
  have hC_num_pos : 0 < C_num := by dsimp [C_num]; positivity
  have hK_step_pos : 0 < K_step := by dsimp [K_step]; positivity
  have hC_tot_pos : 0 < C_tot := by dsimp [C_tot]; positivity
  have hq5_nat : 5 ≤ q := le_trans (le_max_left 5 _) hq
  have hq_pos_nat : 0 < q := by omega
  have hq5 : (5 : ℝ) ≤ (q : ℝ) := by exact_mod_cast hq5_nat
  have hq1 : (1 : ℝ) ≤ (q : ℝ) := by linarith
  have hq_pos : 0 < (q : ℝ) := by linarith
  have hq_nz : (q : ℝ) ≠ 0 := ne_of_gt hq_pos
  have hq2_pos : 0 < (q : ℝ) ^ 2 := by positivity
  have hq2_ge1 : (1 : ℝ) ≤ (q : ℝ) ^ 2 := by nlinarith
  have hq_le_q2 : (q : ℝ) ≤ (q : ℝ) ^ 2 := by nlinarith
  have hB₀_q2 : 2592 * B₀ ≤ (q : ℝ) ^ 2 := by
    have h1 : Nat.ceil (2592 * B₀) + 1 ≤ q :=
      le_trans (le_trans (le_max_left _ _) (le_max_right 5 _)) hq
    have h2 : Nat.ceil (2592 * B₀) ≤ q := by omega
    have h3 : (Nat.ceil (2592 * B₀) : ℝ) ≤ (q : ℝ) := by exact_mod_cast h2
    exact le_trans (Nat.le_ceil (2592 * B₀)) (le_trans h3 hq_le_q2)
  have hCtot_q2 : 2 * C_tot ≤ (q : ℝ) ^ 2 := by
    have h1 : Nat.ceil (2 * C_tot) + 1 ≤ q :=
      le_trans (le_trans (le_max_right _ _) (le_max_right 5 _)) hq
    have h2 : Nat.ceil (2 * C_tot) ≤ q := by omega
    have h3 : (Nat.ceil (2 * C_tot) : ℝ) ≤ (q : ℝ) := by exact_mod_cast h2
    exact le_trans (Nat.le_ceil (2 * C_tot)) (le_trans h3 hq_le_q2)
  obtain ⟨hX₁_0, hX₁_q, _, _, hX₁_tail⟩ := hX₁.1
  obtain ⟨hX₂_0, hX₂_q, _, _, hX₂_tail⟩ := hX₂.1
  let u : ℕ → ℝ := fun j => X₁ j - X₂ j
  let δ : ℕ → ℝ := fun r => u (r + 1) - u r
  have hu0 : u 0 = 0 := by simp [u, hX₁_0, hX₂_0]
  have huq : u q = 0 := by simp [u, hX₁_q, hX₂_q]
  have hu_sum : ∀ j : ℕ, ∑ r ∈ Finset.range j, δ r = u j := by
    intro j
    have htel := Finset.sum_range_sub u j
    dsimp [δ]
    linarith
  have hδ_mean : ∑ r ∈ Finset.range q, δ r = 0 := by
    rw [hu_sum q, huq]
  obtain ⟨r_star, hr_star_mem, hr_star_max⟩ :=
    Finset.exists_max_image (Finset.range q) (fun r => |δ r|)
      ⟨0, Finset.mem_range.mpr hq_pos_nat⟩
  have hr_star : r_star < q := Finset.mem_range.mp hr_star_mem
  let M : ℝ := |δ r_star|
  have hM_nonneg : 0 ≤ M := abs_nonneg _
  have hδ_le_M : ∀ r : ℕ, r < q → |δ r| ≤ M := by
    intro r hr
    exact hr_star_max r (Finset.mem_range.mpr hr)
  have h_pos_bnd : ∀ j : ℕ, j ≤ q → |X₁ j - X₂ j| ≤ (q : ℝ) * M := by
    intro j hj
    have heq : X₁ j - X₂ j = ∑ r ∈ Finset.range j, δ r := (hu_sum j).symm
    rw [heq]
    have h1 : |∑ r ∈ Finset.range j, δ r| ≤ ∑ r ∈ Finset.range j, |δ r| :=
      Finset.abs_sum_le_sum_abs _ _
    have h2 : ∑ r ∈ Finset.range j, |δ r| ≤ ∑ _r ∈ Finset.range j, M := by
      apply Finset.sum_le_sum
      intro r hr
      have hrj : r < j := Finset.mem_range.mp hr
      exact hδ_le_M r (lt_of_lt_of_le hrj hj)
    have h3 : ∑ _r ∈ Finset.range j, M = (j : ℝ) * M := by
      simp [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
    have hj_le_q : (j : ℝ) ≤ (q : ℝ) := Nat.cast_le.mpr hj
    exact le_trans h1 (le_trans h2 (by rw [h3]; exact mul_le_mul_of_nonneg_right hj_le_q hM_nonneg))
  have h_poincare : ∀ ε : ℝ, 0 ≤ ε →
      (∀ j : ℕ, j + 1 < q → |δ (j + 1) - δ j| ≤ ε) → M ≤ (q : ℝ) * ε := by
    intro ε hε hsec
    have h_add : ∀ d a : ℕ, a + d < q → |δ (a + d) - δ a| ≤ (d : ℝ) * ε := by
      intro d
      induction d with
      | zero =>
          intro a _
          simp
      | succ d ih =>
          intro a ha
          have had_lt : a + d < q := by omega
          have had1_lt : (a + d) + 1 < q := by omega
          have h_idx : a + (d + 1) = (a + d) + 1 := by omega
          rw [h_idx]
          have h_split : δ ((a + d) + 1) - δ a =
              (δ ((a + d) + 1) - δ (a + d)) + (δ (a + d) - δ a) := by ring
          rw [h_split]
          have h_tri := abs_add_le (δ ((a + d) + 1) - δ (a + d)) (δ (a + d) - δ a)
          have h_s1 := hsec (a + d) had1_lt
          have h_s2 := ih a had_lt
          push_cast
          linarith
    have h_pair : ∀ r s : ℕ, r < q → s < q → |δ r - δ s| ≤ (q : ℝ) * ε := by
      intro r s hr hs
      rcases le_total r s with hrs | hsr
      · obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hrs
        have hd_le : (d : ℝ) ≤ (q : ℝ) := by exact_mod_cast (by omega : d ≤ q)
        rw [abs_sub_comm]
        exact le_trans (h_add d r hs) (mul_le_mul_of_nonneg_right hd_le hε)
      · obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hsr
        have hd_le : (d : ℝ) ≤ (q : ℝ) := by exact_mod_cast (by omega : d ≤ q)
        exact le_trans (h_add d s hr) (mul_le_mul_of_nonneg_right hd_le hε)
    have h_sum_eq : ∑ s ∈ Finset.range q, (δ r_star - δ s) = (q : ℝ) * δ r_star := by
      rw [Finset.sum_sub_distrib, hδ_mean, sub_zero, Finset.sum_const, Finset.card_range,
        nsmul_eq_mul]
    have h_abs_lhs : |(q : ℝ) * δ r_star| = (q : ℝ) * M := by
      rw [abs_mul, abs_of_pos hq_pos]
    have h_sum_le : |(q : ℝ) * δ r_star| ≤ (q : ℝ) * ((q : ℝ) * ε) := by
      rw [← h_sum_eq]
      have h1 : |∑ s ∈ Finset.range q, (δ r_star - δ s)| ≤
          ∑ s ∈ Finset.range q, |δ r_star - δ s| :=
        Finset.abs_sum_le_sum_abs _ _
      have h2 : ∑ s ∈ Finset.range q, |δ r_star - δ s| ≤
          ∑ _s ∈ Finset.range q, ((q : ℝ) * ε) := by
        apply Finset.sum_le_sum
        intro s hs
        exact h_pair r_star s hr_star (Finset.mem_range.mp hs)
      have h3 : ∑ _s ∈ Finset.range q, ((q : ℝ) * ε) = (q : ℝ) * ((q : ℝ) * ε) := by
        simp [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
      exact le_trans h1 (by linarith)
    rw [h_abs_lhs] at h_sum_le
    exact le_of_mul_le_mul_left h_sum_le hq_pos
  let polyD : ℝ → ℝ → ℝ → ℝ := fun y t s =>
    (t + s) * (1 / 8 + (t ^ 2 + s ^ 2) * realJetA w y)
  let polyN : ℝ → ℝ → ℝ → ℝ := fun y t s =>
    t ^ 5 * realJetB w y t + s ^ 5 * realJetB w y (-s)
  have h_step_enc : ∀ X : ℕ → ℝ, IsStationaryRealMesh q w x X →
      ∀ r : ℕ, r < q →
        let h := X (r + 1) - X r
        5 / (q : ℝ) ≤ h ∧ h ≤ 9 / (q : ℝ) ∧ 0 ≤ h ∧ h ≤ 2 ∧ |h| ≤ 2 ∧ |-h| ≤ 2 := by
    intro X hStat r hr
    dsimp only
    obtain ⟨_, _, _, hXstep, _⟩ := hStat.1
    have h_cand := hXstep r hr
    rw [inv_eq_one_div] at h_cand
    obtain ⟨h_lo_raw, h_hi_raw⟩ := abs_le.mp h_cand
    have hpi_gt : (3 : ℝ) < Real.pi := Real.pi_gt_three
    have hpi_lt : Real.pi < 4 := Real.pi_lt_four
    have h_lo1 : 5 / (q : ℝ) ≤ 2 * Real.pi / (q : ℝ) - 1 / (q : ℝ) := by
      have h_eq : 2 * Real.pi / (q : ℝ) - 1 / (q : ℝ) = (2 * Real.pi - 1) / (q : ℝ) := by ring
      rw [h_eq]
      exact div_le_div_of_nonneg_right (by linarith) (le_of_lt hq_pos)
    have h_hi1 : 2 * Real.pi / (q : ℝ) + 1 / (q : ℝ) ≤ 9 / (q : ℝ) := by
      have h_eq : 2 * Real.pi / (q : ℝ) + 1 / (q : ℝ) = (2 * Real.pi + 1) / (q : ℝ) := by ring
      rw [h_eq]
      exact div_le_div_of_nonneg_right (by linarith) (le_of_lt hq_pos)
    have h5 : 5 / (q : ℝ) ≤ X (r + 1) - X r := by linarith
    have h9 : X (r + 1) - X r ≤ 9 / (q : ℝ) := by linarith
    have h0 : 0 ≤ X (r + 1) - X r := le_trans (by positivity) h5
    have h9_le_2 : 9 / (q : ℝ) ≤ 2 := (div_le_iff₀ hq_pos).mpr (by linarith)
    have h2 : X (r + 1) - X r ≤ 2 := le_trans h9 h9_le_2
    have habs : |X (r + 1) - X r| ≤ 2 := by
      rw [abs_of_nonneg h0]
      exact h2
    have habs_neg : |-(X (r + 1) - X r)| ≤ 2 := by
      rw [abs_neg]
      exact habs
    exact ⟨h5, h9, h0, h2, habs, habs_neg⟩
  have h_stat_props : ∀ X : ℕ → ℝ, IsStationaryRealMesh q w x X →
      ∀ j : ℕ, j + 1 < q →
        let y := X (j + 1)
        let t := X (j + 2) - X (j + 1)
        let s := X (j + 1) - X j
        (t - s) * polyD y t s + polyN y t s = 0 ∧
        5 / (8 * (q : ℝ)) ≤ polyD y t s ∧
        |t - s| ≤ C_sec / (q : ℝ) ^ 4 := by
    intro X hStat j hj
    dsimp only
    let y := X (j + 1)
    let t := X (j + 2) - X (j + 1)
    let s := X (j + 1) - X j
    have hj0 : j < q := by omega
    obtain ⟨ht5, ht9, ht0, _, ht_abs, _⟩ := h_step_enc X hStat (j + 1) hj
    obtain ⟨hs5, hs9, hs0, _, _, hms_abs⟩ := h_step_enc X hStat j hj0
    have h_el_raw := hStat.2 j hj
    have h_act1 : normAction1_ℝ w (X (j + 1)) (X (j + 2)) =
        t ^ 2 * (1 / 8 + realJetA w y * t ^ 2 + t ^ 3 * realJetB w y t) := by
      have h_eq : X (j + 2) = y + t := by dsimp [y, t]; ring
      rw [h_eq]
      exact H_base.action_factor w hw y t
    have h_act2 : normAction1_ℝ w (X (j + 1)) (X j) =
        (-s) ^ 2 * (1 / 8 + realJetA w y * (-s) ^ 2 + (-s) ^ 3 * realJetB w y (-s)) := by
      have h_eq : X j = y + (-s) := by dsimp [y, s]; ring
      rw [h_eq]
      exact H_base.action_factor w hw y (-s)
    rw [h_act1, h_act2] at h_el_raw
    have h_el : (t - s) * polyD y t s + polyN y t s = 0 := by
      dsimp [polyD, polyN]
      linear_combination h_el_raw
    obtain ⟨ha_bnd, hbt_bnd, _, _⟩ := H_jet.jet_pt_bounds w hw y y t (-s) ht_abs hms_abs
    obtain ⟨_, hbs_bnd, _, _⟩ := H_jet.jet_pt_bounds w hw y y (-s) t hms_abs ht_abs
    have hts_lo : 10 / (q : ℝ) ≤ t + s := by
      have : 5 / (q : ℝ) + 5 / (q : ℝ) = 10 / (q : ℝ) := by ring
      linarith
    have hts2_nonneg : 0 ≤ t ^ 2 + s ^ 2 := by positivity
    have hts2_hi : t ^ 2 + s ^ 2 ≤ 162 / (q : ℝ) ^ 2 := by
      have ht2 : t ^ 2 ≤ (9 / (q : ℝ)) ^ 2 := by gcongr
      have hs2 : s ^ 2 ≤ (9 / (q : ℝ)) ^ 2 := by gcongr
      have h_alg : (9 / (q : ℝ)) ^ 2 + (9 / (q : ℝ)) ^ 2 = 162 / (q : ℝ) ^ 2 := by ring
      linarith
    have h_pert_abs : |(t ^ 2 + s ^ 2) * realJetA w y| ≤ 1 / 16 := by
      rw [abs_mul, abs_of_nonneg hts2_nonneg]
      have h1 : (t ^ 2 + s ^ 2) * |realJetA w y| ≤ (162 / (q : ℝ) ^ 2) * B₀ :=
        mul_le_mul hts2_hi ha_bnd (abs_nonneg _) (by positivity)
      have h2 : (162 / (q : ℝ) ^ 2) * B₀ = (162 * B₀) / (q : ℝ) ^ 2 := by ring
      have h3 : (162 * B₀) / (q : ℝ) ^ 2 ≤ 1 / 16 :=
        (div_le_iff₀ hq2_pos).mpr (by linarith)
      linarith
    have h_brack_lo : 1 / 16 ≤ 1 / 8 + (t ^ 2 + s ^ 2) * realJetA w y := by
      have := (abs_le.mp h_pert_abs).1
      linarith
    have hD_lo : 5 / (8 * (q : ℝ)) ≤ polyD y t s := by
      dsimp [polyD]
      have h_mul : (10 / (q : ℝ)) * (1 / 16) ≤
          (t + s) * (1 / 8 + (t ^ 2 + s ^ 2) * realJetA w y) :=
        mul_le_mul hts_lo h_brack_lo (by norm_num) (le_trans (by positivity) hts_lo)
      have h_alg : (10 / (q : ℝ)) * (1 / 16 : ℝ) = 5 / (8 * (q : ℝ)) := by ring
      linarith
    have hD_pos : 0 < polyD y t s := lt_of_lt_of_le (by positivity) hD_lo
    have ht5_hi : t ^ 5 ≤ 59049 / (q : ℝ) ^ 5 := by
      have h1 : t ^ 5 ≤ (9 / (q : ℝ)) ^ 5 := by gcongr
      have h2 : (9 / (q : ℝ)) ^ 5 = 59049 / (q : ℝ) ^ 5 := by ring
      linarith
    have hs5_hi : s ^ 5 ≤ 59049 / (q : ℝ) ^ 5 := by
      have h1 : s ^ 5 ≤ (9 / (q : ℝ)) ^ 5 := by gcongr
      have h2 : (9 / (q : ℝ)) ^ 5 = 59049 / (q : ℝ) ^ 5 := by ring
      linarith
    have hN_hi : |polyN y t s| ≤ (118098 * B₀) / (q : ℝ) ^ 5 := by
      dsimp [polyN]
      have h_tri := abs_add_le (t ^ 5 * realJetB w y t) (s ^ 5 * realJetB w y (-s))
      rw [abs_mul, abs_mul, abs_of_nonneg (by positivity : 0 ≤ t ^ 5),
        abs_of_nonneg (by positivity : 0 ≤ s ^ 5)] at h_tri
      have h_t : t ^ 5 * |realJetB w y t| ≤ (59049 / (q : ℝ) ^ 5) * B₀ :=
        mul_le_mul ht5_hi hbt_bnd (abs_nonneg _) (by positivity)
      have h_s : s ^ 5 * |realJetB w y (-s)| ≤ (59049 / (q : ℝ) ^ 5) * B₀ :=
        mul_le_mul hs5_hi hbs_bnd (abs_nonneg _) (by positivity)
      have h_alg : (59049 / (q : ℝ) ^ 5) * B₀ + (59049 / (q : ℝ) ^ 5) * B₀ =
          (118098 * B₀) / (q : ℝ) ^ 5 := by ring
      linarith
    have h_prod_hi : |t - s| * (5 / (8 * (q : ℝ))) ≤ (118098 * B₀) / (q : ℝ) ^ 5 := by
      have h1 : |t - s| * (5 / (8 * (q : ℝ))) ≤ |t - s| * polyD y t s :=
        mul_le_mul_of_nonneg_left hD_lo (abs_nonneg _)
      have h2 : |t - s| * polyD y t s = |polyN y t s| := by
        have h_eq : (t - s) * polyD y t s = -polyN y t s := by linarith
        calc |t - s| * polyD y t s
            = |t - s| * |polyD y t s| := by rw [abs_of_pos hD_pos]
          _ = |(t - s) * polyD y t s| := (abs_mul _ _).symm
          _ = |-polyN y t s| := by rw [h_eq]
          _ = |polyN y t s| := abs_neg _
      linarith
    have h_sec : |t - s| ≤ C_sec / (q : ℝ) ^ 4 := by
      have h_mul := mul_le_mul_of_nonneg_left h_prod_hi (by positivity : 0 ≤ 8 * (q : ℝ) / 5)
      have h_lhs : (8 * (q : ℝ) / 5) * (|t - s| * (5 / (8 * (q : ℝ)))) = |t - s| := by
        field_simp [hq_nz]
      have h_rhs : (8 * (q : ℝ) / 5) * ((118098 * B₀) / (q : ℝ) ^ 5) =
          (944784 / 5 * B₀) / (q : ℝ) ^ 4 := by
        field_simp [hq_nz]; ring
      rw [h_lhs, h_rhs] at h_mul
      have h_coef : 944784 / 5 * B₀ ≤ C_sec := by
        dsimp [C_sec]
        linarith
      exact le_trans h_mul (div_le_div_of_nonneg_right h_coef (by positivity))
    exact ⟨h_el, hD_lo, h_sec⟩
  have h_sec_diff_bnd : ∀ j : ℕ, j + 1 < q →
      |δ (j + 1) - δ j| ≤ (C_tot / (q : ℝ) ^ 3) * M := by
    intro j hj
    have hj0 : j < q := by omega
    have hj1_le : j + 1 ≤ q := by omega
    let y₁ := X₁ (j + 1)
    let t₁ := X₁ (j + 2) - X₁ (j + 1)
    let s₁ := X₁ (j + 1) - X₁ j
    let y₂ := X₂ (j + 1)
    let t₂ := X₂ (j + 2) - X₂ (j + 1)
    let s₂ := X₂ (j + 1) - X₂ j
    let D₁ := polyD y₁ t₁ s₁
    let N₁ := polyN y₁ t₁ s₁
