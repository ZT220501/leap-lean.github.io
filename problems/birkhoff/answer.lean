        exact hΦ_holo.comp hmap (fun ζ hζ => (hDeep_mem ζ hζ T_c hTc w hw).2.2)
      exact hCauchyF W_conv (fun ζ => g_plus ζ T_c w) T hW_open hW_conv hW_sub hg_diff hT
    have hCollar_eq_Y : ∀ T_c ∈ Metric.closedBall (0 : ℂ) ρ_star,
