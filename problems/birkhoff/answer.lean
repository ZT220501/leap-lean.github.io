        rw [hTay1D_congr_nhds hev_grad, hsub.2, hmL.2, hnum_L.2, (hInvEdge_tay i_L).2,
          hmR.2, hnum_R.2, (hInvEdge_tay i_R).2]
        rfl
      simpa [pointArcEpsJet, holoTaylor1D] using congr_arg (PowerSeries.coeff m) heq_ps
  
