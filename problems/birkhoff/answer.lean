            intro z hz
            have hz_U₀ : z ∈ U₀ := h_cb_R₀_U₀ (Metric.sphere_subset_closedBall hz)
            have hmul := congrArg norm (hH₁_mul z hz_U₀)
            rw [norm_mul, hB_sphere a₀ ha₀ z hz, mul_one] at hmul
            rw [hmul]
            exact hH_sph z hz
          have hH₁_q : Real.exp M * (1 / 2 : ℝ) ^ n < ‖H₁ q‖ := by
            have hq_U₀ : q ∈ U₀ := Metric.mem_ball_self (by positivity)
            have hmul := congrArg norm (hH₁_mul q hq_U₀)
            rw [norm_mul] at hmul
            have hBc := hB_center a₀ ha₀
            have hle : ‖H q‖ ≤ ‖H₁ q‖ * (1 / 2) := by
              rw [← hmul]
              exact mul_le_mul_of_nonneg_left hBc (norm_nonneg _)
            rw [pow_succ] at hHq
            linarith
          obtain ⟨N', a', G, ha'_mem, hG_holo, hG_nz, hG_sph, hG_fac⟩ :=
            ih H₁ hH₁_holo hH₁_sph hH₁_q
          refine ⟨N' + 1, Fin.cons a₀ a', G, ?_, hG_holo, hG_nz, hG_sph, ?_⟩
          · intro i
            refine Fin.cases ?_ ?_ i
            · simpa using ha₀
            · intro j; simpa using ha'_mem j
          · intro z hz
            rw [Fin.prod_univ_succ]
            simp only [Fin.cons_zero, Fin.cons_succ]
            calc H z = H₁ z * B_fn a₀ z := (hH₁_mul z hz).symm
              _ = (G z * ∏ i : Fin N', B_fn (a' i) z) * B_fn a₀ z := by rw [hG_fac z hz]
              _ = G z * (B_fn a₀ z * ∏ i : Fin N', B_fn (a' i) z) := by ring
        · exact ⟨0, Fin.elim0, H, fun i => Fin.elim0 i, hH_holo,
            fun z hz hHz => hzero ⟨z, hz, hHz⟩, hH_sph, by simp⟩
    have hlog2_pos : 0 < Real.log 2 := Real.log_pos one_lt_two
    let fuel₀ : ℕ := Nat.floor (2 * T / Real.log 2) + 1
    have hF_U₀ : DifferentiableOn ℂ F U₀ := hF_holo.mono hU₀_sub
    have hF_sph : ∀ z ∈ Metric.sphere q R₀, ‖F z‖ ≤ Real.exp M :=
      fun z hz => hF_up z (hU₀_sub (h_cb_R₀_U₀ (Metric.sphere_subset_closedBall hz)))
    have h_half_pow : ∀ k : ℕ, (1 / 2 : ℝ) ^ k = Real.exp (-(k : ℝ) * Real.log 2) := by
      intro k
      have h12 : (1 / 2 : ℝ) = Real.exp (-Real.log 2) := by
        rw [Real.exp_neg, Real.exp_log zero_lt_two]
        norm_num
      rw [h12, ← Real.exp_nat_mul]
      ring_nf
    have hFq_fuel : Real.exp M * (1 / 2 : ℝ) ^ fuel₀ < ‖F q‖ := by
      have hlt_floor : 2 * T / Real.log 2 < (fuel₀ : ℝ) := by
        dsimp [fuel₀]
        exact_mod_cast Nat.lt_floor_add_one (2 * T / Real.log 2)
      have hlt_mul : 2 * T < (fuel₀ : ℝ) * Real.log 2 :=
        (div_lt_iff₀ hlog2_pos).mp hlt_floor
      have hexp_lt : Real.exp M * (1 / 2 : ℝ) ^ fuel₀ < Real.exp (M - 2 * T) := by
        rw [h_half_pow fuel₀, ← Real.exp_add]
        exact Real.exp_lt_exp.mpr (by linarith)
      exact hexp_lt.trans_le hFq
    obtain ⟨N, a, G, ha_mem, hG_U₀, hG_nz, hG_sph, hFG_fac⟩ :=
      h_fuel fuel₀ F hF_U₀ hF_sph hFq_fuel
    have hG_cb : ∀ z ∈ Metric.closedBall q R₀, ‖G z‖ ≤ Real.exp M :=
      h_max_mod G hG_U₀ hG_sph
    have h_30_U₀ : Metric.ball q (30 * ρ) ⊆ U₀ := by
      intro z hz; rw [Metric.mem_ball] at hz ⊢; linarith
    have h_30_cb : Metric.ball q (30 * ρ) ⊆ Metric.closedBall q R₀ := by
      intro z hz; rw [Metric.mem_ball] at hz; rw [Metric.mem_closedBall]; linarith
    have h_norm_prod : ∀ {m : ℕ} (f : Fin m → ℂ),
        ‖∏ i : Fin m, f i‖ = ∏ i : Fin m, ‖f i‖ := by
      intro m; induction' m with m ih <;> intro f
      · simp
      · rw [Fin.prod_univ_succ, Fin.prod_univ_succ, norm_mul, ih]
    have h_prod_le : ∀ {m : ℕ} (f g : Fin m → ℝ),
        (∀ i, 0 ≤ f i) → (∀ i, f i ≤ g i) → (∏ i : Fin m, f i) ≤ ∏ i : Fin m, g i := by
      intro m; induction' m with m ih <;> intro f g hf hg
      · simp
      · rw [Fin.prod_univ_succ, Fin.prod_univ_succ]
        exact mul_le_mul (hg 0) (ih _ _ (fun j => hf j.succ) (fun j => hg j.succ))
          (Finset.prod_nonneg fun j _ => hf j.succ) ((hf 0).trans (hg 0))
    have hq_U₀ : q ∈ U₀ := Metric.mem_ball_self (by positivity)
    have hFq_norm : ‖F q‖ = ‖G q‖ * ∏ i : Fin N, ‖B_fn (a i) q‖ := by
      rw [hFG_fac q hq_U₀, norm_mul, h_norm_prod]
    have hprod_q_half : (∏ i : Fin N, ‖B_fn (a i) q‖) ≤ (1 / 2 : ℝ) ^ N := by
      calc (∏ i : Fin N, ‖B_fn (a i) q‖)
          ≤ ∏ _i : Fin N, (1 / 2 : ℝ) :=
            h_prod_le _ _ (fun _ => norm_nonneg _) (fun i => hB_center (a i) (ha_mem i))
        _ = (1 / 2 : ℝ) ^ N := by simp
    have hprod_q_one : (∏ i : Fin N, ‖B_fn (a i) q‖) ≤ 1 :=
      hprod_q_half.trans (pow_le_one₀ (by positivity) (by norm_num))
    have hGq_low : Real.exp (M - 2 * T) ≤ ‖G q‖ := by
      calc Real.exp (M - 2 * T) ≤ ‖F q‖ := hFq
        _ = ‖G q‖ * ∏ i : Fin N, ‖B_fn (a i) q‖ := hFq_norm
        _ ≤ ‖G q‖ * 1 := mul_le_mul_of_nonneg_left hprod_q_one (norm_nonneg _)
        _ = ‖G q‖ := mul_one _
    have hGq_up : ‖G q‖ ≤ Real.exp M := hG_cb q (Metric.mem_closedBall_self hR₀_pos.le)
    have hN_bound : (N : ℝ) ≤ (2 / Real.log 2) * T := by
      have hexp_le : Real.exp (M - 2 * T) ≤ Real.exp (M + (-(N : ℝ) * Real.log 2)) := by
        rw [Real.exp_add, ← h_half_pow N]
        calc Real.exp (M - 2 * T) ≤ ‖F q‖ := hFq
          _ = ‖G q‖ * ∏ i : Fin N, ‖B_fn (a i) q‖ := hFq_norm
          _ ≤ Real.exp M * (1 / 2 : ℝ) ^ N :=
