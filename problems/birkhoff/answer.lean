          (fun w => if |g m (w m)| ≤ h then min ((g (m + 1) (w (m + 1)) - g m (w m)) ^ 2) (h ^ 2) else 0)
          (h ^ 2)
          (Measurable.ite (measurableSet_Iic.preimage (continuous_abs.measurable.comp (hMeasG m (by omega))))
            ((((hMeasG (m + 1) (by omega)).sub (hMeasG m (by omega))).pow_const 2).min measurable_const)
            measurable_const)
          (fun w => by
            split_ifs
            · rw [abs_of_nonneg (le_min (sq_nonneg _) (sq_nonneg _))]; exact min_le_right _ _
            · rw [abs_zero]; positivity))
    rw [h_sum_int]
    apply Finset.sum_congr rfl; intro m hm
    have hm' : m < M := Finset.mem_range.mp hm
    let H_occ : ℝ → ℝ → ℝ := fun x y =>
      if |g m x| ≤ h then min ((g (m + 1) y - g m x) ^ 2) (h ^ 2) else 0
    have h_step := hStepExpect2D m hm' H_occ (h ^ 2)
      (Measurable.ite
        (measurableSet_Iic.preimage (continuous_abs.comp ((hg_cont m (by omega)).comp continuous_fst)).measurable)
        (((((hg_cont (m + 1) (by omega)).comp continuous_snd).sub
          ((hg_cont m (by omega)).comp continuous_fst)).pow 2).min continuous_const).measurable
        measurable_const)
      (fun x y => by
        simp only [H_occ]; split_ifs
        · rw [abs_of_nonneg (le_min (sq_nonneg _) (sq_nonneg _))]; exact min_le_right _ _
        · rw [abs_zero]; positivity)
      (fun x y => by simp only [H_occ, hg_per m (by omega) x, hg_per (m + 1) (by omega) y])
    rw [h_step]
    congr 1; apply intervalIntegral.integral_congr; intro x _
    by_cases hgx : |g m x| ≤ h
    · simp [H_occ, hgx]
    · simp [H_occ, hgx]
  
  let Φ_tan : ℝ → ℝ := fun x => Real.sqrt (h ^ 2 + x ^ 2) + x
  let D_tan : ℝ → ℝ := fun x => x / Real.sqrt (h ^ 2 + x ^ 2) + 1
  have hΦ_cont : Continuous Φ_tan :=
    ((continuous_const.add (continuous_pow 2)).sqrt).add continuous_id
  have hD_cont : Continuous D_tan := by
    refine (continuous_id.div ((continuous_const.add (continuous_pow 2)).sqrt) ?_).add continuous_const
