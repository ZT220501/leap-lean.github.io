      · refine Set.union_subset ?_ ?_
        · rintro _ ⟨μ, ⟨hμ0, hμ1⟩, rfl⟩
          simpa [γ₂] using h_rad_step y.re t 0 μ hq.1 (by norm_num) hμ0 hμ1
        · rintro _ ⟨η, ⟨hη0, hη1⟩, rfl⟩
