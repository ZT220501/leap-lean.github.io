          (∀ z ∈ Metric.sphere q R₀, ‖G z‖ ≤ Real.exp M) ∧
          (∀ z ∈ U₀, H z = G z * ∏ i : Fin N, B_fn (a i) z) := by
      intro fuel
      induction' fuel with n ih
      · intro H hH_holo hH_sph hHq
        have hq_cb : q ∈ Metric.closedBall q R₀ := Metric.mem_closedBall_self hR₀_pos.le
        have hle := h_max_mod H hH_holo hH_sph q hq_cb
        simp at hHq
        linarith
      · intro H hH_holo hH_sph hHq
