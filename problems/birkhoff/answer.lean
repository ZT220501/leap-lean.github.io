        have hdf : HasFDerivAt (fun x : ℂ × ℂ => F x θ) (F' p θ) p :=
          hdmul.const_smul c
        refine ⟨hdf, ?_⟩
        have hw_norm : ‖w‖ = R_c := by simpa [Metric.mem_sphere, dist_zero_right] using hw_sph
        have hc_norm : ‖c‖ = R_c := by
          dsimp [c]
