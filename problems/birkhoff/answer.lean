      intro z₀ hz₀
      obtain ⟨R₀, hR₀_pos, hBall⟩ := Metric.isOpen_iff.mp (hOpenStrip σ') z₀ hz₀
      refine ⟨R₀, hR₀_pos, hBall, B, hB, ?_⟩
      intro t ht ζ hζ
