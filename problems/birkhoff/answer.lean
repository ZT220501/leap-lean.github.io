import Mathlib
set_option maxHeartbeats 4000000

/-!
# Rigidity of Smooth Billiards with a Continuous Caustic Collar (Definition 1.1 & Theorem 1.2)

Formal problem statement for **Definition 1.1** and **Theorem 1.2** from:
OpenAI, *Rigidity of Smooth Billiards with a Continuous Caustic Collar*,
September 24, 2026.
https://github.com/openai/math/blob/main/preprints/Rigidity-of-Smooth-Billiards-with-a-Continuous-Caustic-Collar-September-24-2026/paper.pdf

## Mathematical Statement (Section 1, p. 4)

**Definition 1.1 (A continuous caustic collar).**
Let $\Omega \subset \mathbb{R}^2$ be a bounded strictly convex domain whose boundary is a
$C^\infty$ simple closed regular curve with positive curvature. A *smooth closed convex caustic*
is a $C^\infty$ simple closed regular curve in $\Omega$, bounding a strictly convex set, such that
a billiard segment tangent to the curve remains tangent after reflection at either endpoint. Here
reflection of an incoming unit velocity $v$ at a boundary point with outward unit normal $n$ is
$$v \longmapsto v - 2(v \cdot n)n.$$
A *continuous caustic collar* consists of a relatively open set $A \subset \overline{\Omega}$
containing $\partial\Omega$ and a homeomorphism
$$H_0 : \mathbb{S}^1 \times [0, 1) \longrightarrow A$$
such that $H_0(\mathbb{S}^1 \times \{0\}) = \partial\Omega$, and
$H_0(\mathbb{S}^1 \times \{b\})$ is a smooth closed convex caustic for every $0 < b < 1$.

**Theorem 1.2.**
*If $\Omega$ has a continuous caustic collar, then $\Omega$ is an ellipse. Equivalently, there are
$c \in \mathbb{R}^2$ and a real symmetric positive-definite matrix $Q$ such that*
$$\Omega = \{x \in \mathbb{R}^2 : (x - c)^T Q (x - c) < 1\}.$$
*Circles are included.*
-/

open ContDiff Set Topology Metric Matrix

/-- The Euclidean plane `ℝ²`. -/
abbrev Plane : Type := EuclideanSpace ℝ (Fin 2)

/-- The unit circle `𝕊¹ ⊂ ℝ²`. -/
abbrev UnitCircle : Type := Metric.sphere (0 : Plane) 1

/-- The two-dimensional determinant (cross product) `det(u, v) = u₀ v₁ - u₁ v₀` of two planar
vectors `u, v ∈ ℝ²`. -/
def det2 (u v : Plane) : ℝ :=
  u 0 * v 1 - u 1 * v 0

/-- The signed curvature `κ_γ(t) = det(γ'(t), γ''(t)) / ‖γ'(t)‖³` of a plane curve `γ : ℝ → ℝ²`
at parameter `t ∈ ℝ`. -/
noncomputable def signedCurvature (γ : ℝ → Plane) (t : ℝ) : ℝ :=
  det2 (deriv γ t) (deriv (deriv γ) t) / ‖deriv γ t‖ ^ 3

/-- A map `γ : ℝ → ℝ²` is a `C^∞` simple closed regular parametrization of a curve `C ⊆ ℝ²`
with period `L > 0` if:
1. `0 < L`,
2. `γ` is `C^∞` smooth (`ContDiff ℝ ∞ γ`),
3. `γ` is `L`-periodic (`Function.Periodic γ L`),
4. `γ` is simple (injective on `ℝ / Lℤ`, i.e., `γ(t₁) = γ(t₂) → t₁ - t₂ ∈ Lℤ`),
5. `γ` is regular (`γ'(t) ≠ 0` for all `t ∈ ℝ`), and
6. the image of `γ` is `C` (`range γ = C`). -/
structure IsSmoothSimpleClosedRegularParam (γ : ℝ → Plane) (L : ℝ) (C : Set Plane) : Prop where
  /-- The period `L` is strictly positive. -/
  period_pos : 0 < L
  /-- `γ` is `C^∞` smooth on `ℝ`. -/
  smooth : ContDiff ℝ ∞ γ
  /-- `γ` has period `L`. -/
  periodic : Function.Periodic γ L
  /-- `γ` is injective modulo `L`. -/
  simple : ∀ t₁ t₂ : ℝ, γ t₁ = γ t₂ → ∃ k : ℤ, t₁ - t₂ = k * L
  /-- `γ` is regular everywhere (`γ'(t) ≠ 0`). -/
  regular : ∀ t : ℝ, deriv γ t ≠ 0
  /-- The image of `γ` is `C`. -/
  range_eq : Set.range γ = C

/-- A subset `C ⊆ ℝ²` is a `C^∞` simple closed regular curve with positive curvature if it admits
a (counterclockwise) `C^∞` simple closed regular parametrization `γ : ℝ → ℝ²` of some positive
period `L > 0` whose signed curvature `κ_γ(t) > 0` is strictly positive for all `t ∈ ℝ`. -/
def IsSmoothPositiveCurvatureCurve (C : Set Plane) : Prop :=
  ∃ (γ : ℝ → Plane) (L : ℝ),
    IsSmoothSimpleClosedRegularParam γ L C ∧ ∀ t : ℝ, 0 < signedCurvature γ t

/-- A subset `Ω ⊆ ℝ²` is a bounded strictly convex domain if it is open, nonempty, bounded,
convex, and for any two distinct points `x, y ∈ Ω̄`, the open line segment `(x, y)` lies in `Ω`. -/
structure IsBoundedStrictlyConvexDomain (Ω : Set Plane) : Prop where
  /-- `Ω` is an open subset of `ℝ²`. -/
  isOpen : IsOpen Ω
  /-- `Ω` is nonempty. -/
  nonempty : Ω.Nonempty
  /-- `Ω` is bounded. -/
  isBounded : Bornology.IsBounded Ω
  /-- `Ω` is convex. -/
  convex : Convex ℝ Ω
  /-- Strict convexity: for any distinct `x, y ∈ Ω̄`, the open segment `(x, y)` lies in `Ω`. -/
  openSegment_subset : ∀ x ∈ closure Ω, ∀ y ∈ closure Ω, x ≠ y → openSegment ℝ x y ⊆ Ω

/-- The standing geometric hypothesis on the billiard table `Ω ⊂ ℝ²` in **Definition 1.1**:
`Ω` is a bounded strictly convex domain whose boundary `∂Ω` (`frontier Ω`) is a `C^∞` simple
closed regular curve with positive curvature. -/
structure IsSmoothPositivelyCurvedBilliardDomain (Ω : Set Plane) : Prop where
  /-- `Ω` is a bounded strictly convex planar domain. -/
  domain : IsBoundedStrictlyConvexDomain Ω
  /-- `∂Ω` is a `C^∞` simple closed regular curve with positive curvature. -/
  boundary_smooth_pos_curvature : IsSmoothPositiveCurvatureCurve (frontier Ω)

/-- A vector `n ∈ ℝ²` is the outward unit normal to `Ω` at a boundary point `p ∈ ∂Ω` if:
1. `‖n‖ = 1` (`n` is a unit vector),
2. `⟨n, γ'(t)⟩ = 0` (`n` is normal/orthogonal to the boundary tangent `γ'(t)` at `p = γ(t)`), and
3. `⟨x - p, n⟩ ≤ 0` for all `x ∈ Ω` (`n` points outward from `Ω`). -/
def IsOutwardUnitNormal (Ω : Set Plane) (p n : Plane) : Prop :=
  ‖n‖ = 1 ∧
  (∃ (γ : ℝ → Plane) (L : ℝ) (t : ℝ),
    IsSmoothSimpleClosedRegularParam γ L (frontier Ω) ∧
    γ t = p ∧
    inner ℝ n (deriv γ t) = 0) ∧
  ∀ x ∈ Ω, inner ℝ (x - p) n ≤ 0

/-- Billiard reflection of an incoming unit velocity `v ∈ ℝ²` at a boundary point with outward
unit normal `n ∈ ℝ²` (**Definition 1.1**):
$$v \longmapsto v - 2(v \cdot n)n.$$ -/
noncomputable def billiardReflect (n v : Plane) : Plane :=
  v - (2 * inner ℝ v n) • n

/-- A billiard segment `[p, q]` (with endpoints `p, q ∈ ∂Ω`, `p ≠ q`) is tangent to a curve
parametrized by `α : ℝ → ℝ²` if `[p, q]` meets the curve at some point `α(t)` where the tangent
vector `α'(t)` is parallel to the segment direction `q - p`. -/
def IsBilliardSegmentTangentTo (α : ℝ → Plane) (p q : Plane) : Prop :=
  ∃ t : ℝ, α t ∈ segment ℝ p q ∧ ∃ c : ℝ, deriv α t = c • (q - p)

/-- **Definition 1.1** (Smooth closed convex caustic):
A *smooth closed convex caustic* in `Ω` is a `C^∞` simple closed regular curve `C ⊂ Ω`, bounding a
strictly convex set `U`, such that a billiard segment `[p, q]` (with `p, q ∈ ∂Ω`, `p ≠ q`) tangent
to `C` remains tangent to `C` after billiard reflection `v ↦ v - 2(v · n)n` at either endpoint
`q` or `p`. -/
def IsSmoothClosedConvexCaustic (Ω C : Set Plane) : Prop :=
  C ⊆ Ω ∧
  (∃ U : Set Plane, IsBoundedStrictlyConvexDomain U ∧ frontier U = C) ∧
  ∃ (α : ℝ → Plane) (L : ℝ),
    IsSmoothSimpleClosedRegularParam α L C ∧
    ∀ p ∈ frontier Ω, ∀ q ∈ frontier Ω, p ≠ q →
      IsBilliardSegmentTangentTo α p q →
      (∀ n_q : Plane, IsOutwardUnitNormal Ω q n_q →
        ∃ r ∈ frontier Ω, r ≠ q ∧
          (∃ s : ℝ, 0 < s ∧ r = q + s • billiardReflect n_q (‖q - p‖⁻¹ • (q - p))) ∧
          IsBilliardSegmentTangentTo α q r) ∧
      (∀ n_p : Plane, IsOutwardUnitNormal Ω p n_p →
        ∃ r ∈ frontier Ω, r ≠ p ∧
          (∃ s : ℝ, 0 < s ∧ r = p + s • billiardReflect n_p (‖p - q‖⁻¹ • (p - q))) ∧
          IsBilliardSegmentTangentTo α p r)

/-- The slice `H₀(𝕊¹ × {b}) ⊆ ℝ²` of a collar map `H₀ : 𝕊¹ × [0, 1) → A` at parameter
`b ∈ [0, 1)`. -/
def collarSlice {A : Set Plane} (H₀ : (UnitCircle × Set.Ico (0 : ℝ) 1) ≃ₜ A)
    (b : ℝ) (hb : b ∈ Set.Ico (0 : ℝ) 1) : Set Plane :=
  Set.range (fun θ : UnitCircle => (H₀ (θ, ⟨b, hb⟩) : Plane))

/-- **Definition 1.1** (A continuous caustic collar):
A *continuous caustic collar* of `Ω` consists of a relatively open set `A ⊂ Ω̄` containing `∂Ω`
and a homeomorphism `H₀ : 𝕊¹ × [0, 1) → A` such that `H₀(𝕊¹ × {0}) = ∂Ω`, and
`H₀(𝕊¹ × {b})` is a smooth closed convex caustic in `Ω` for every `0 < b < 1`. -/
def HasContinuousCausticCollar (Ω : Set Plane) : Prop :=
  ∃ A : Set Plane,
    A ⊆ closure Ω ∧
    frontier Ω ⊆ A ∧
    (∃ V : Set Plane, IsOpen V ∧ A = V ∩ closure Ω) ∧
    ∃ H₀ : (UnitCircle × Set.Ico (0 : ℝ) 1) ≃ₜ A,
      collarSlice H₀ 0 (by simp) = frontier Ω ∧
      ∀ b : ℝ, ∀ hb0 : 0 < b, ∀ hb1 : b < 1,
        IsSmoothClosedConvexCaustic Ω (collarSlice H₀ b ⟨le_of_lt hb0, hb1⟩)

/-- A planar domain `Ω ⊂ ℝ²` is an ellipse (with circles included) if there exist `c ∈ ℝ²` and a
real symmetric positive-definite `2 × 2` matrix `Q` such that
`Ω = {x ∈ ℝ² : (x - c)^T Q (x - c) < 1}` (**Theorem 1.2**). -/
def IsEllipse (Ω : Set Plane) : Prop :=
  ∃ c : Plane, ∃ Q : Matrix (Fin 2) (Fin 2) ℝ,
    Q.IsSymm ∧ Q.PosDef ∧
    Ω = { x : Plane | (x - c).ofLp ⬝ᵥ Q.mulVec (x - c).ofLp < 1 }

/-- **Theorem 1.2** (Near-boundary Birkhoff conjecture / physical-collar rigidity):
Let `Ω ⊂ ℝ²` be a bounded strictly convex domain whose boundary is a `C^∞` simple closed regular
curve with positive curvature. If `Ω` has a continuous caustic collar, then `Ω` is an ellipse:
there are `c ∈ ℝ²` and a real symmetric positive-definite matrix `Q` such that
`Ω = {x ∈ ℝ² : (x - c)^T Q (x - c) < 1}` (circles are included). -/
noncomputable def unitNormalVec (θ : ℝ) : Plane :=
  (WithLp.equiv 2 (Fin 2 → ℝ)).symm ![Real.cos θ, Real.sin θ]


noncomputable def unitTangentVec (θ : ℝ) : Plane :=
  (WithLp.equiv 2 (Fin 2 → ℝ)).symm ![-Real.sin θ, Real.cos θ]


noncomputable def supportAction1_ℂ (h_ℂ : ℂ → ℂ) (θ₁ θ₂ : ℂ) : ℂ :=
  deriv h_ℂ ((θ₁ + θ₂) / 2) * Complex.sin ((θ₂ - θ₁) / 2) -
    h_ℂ ((θ₁ + θ₂) / 2) * Complex.cos ((θ₂ - θ₁) / 2)


noncomputable def supportAction2_ℂ (h_ℂ : ℂ → ℂ) (θ₁ θ₂ : ℂ) : ℂ :=
  deriv h_ℂ ((θ₁ + θ₂) / 2) * Complex.sin ((θ₂ - θ₁) / 2) +
    h_ℂ ((θ₁ + θ₂) / 2) * Complex.cos ((θ₂ - θ₁) / 2)


def horizStrip (H : ℝ) : Set ℂ :=
  { s : ℂ | |s.im| < H }


def finiteWallTube (r_star : ℝ) (h_X : ℂ → ℝ) : Set (ℂ × ℂ) :=
  { p : ℂ × ℂ | ‖p.2‖ < r_star ∧ -h_X (starRingEnd ℂ p.2) < p.1.im ∧ p.1.im < h_X p.2 }


noncomputable def frozenFirstFieldG (z : ℂ) : ℂ :=
  if z = 0 then 1 else 3 * (Complex.sin z - z * Complex.cos z) / z ^ 3


structure SupportLazutkinData (Ω : Set Plane) where
  c₀ : Plane
  c₀_mem : c₀ ∈ Ω
  h : ℝ → ℝ
  h_smooth : ContDiff ℝ ∞ h
  h_periodic : Function.Periodic h (2 * Real.pi)
  h_pos : ∀ θ : ℝ, 0 < h θ
  r_pos : ∀ θ : ℝ, 0 < h θ + deriv (deriv h) θ
  frontier_eq : frontier Ω =
    Set.range (fun θ : ℝ => c₀ + h θ • unitNormalVec θ + deriv h θ • unitTangentVec θ)
  ϕ : ℝ → ℝ
  c : ℝ
  c_pos : 0 < c
  ϕ_smooth : ContDiff ℝ ∞ ϕ
  ϕ_deriv_pos : ∀ x : ℝ, 0 < deriv ϕ x
  ϕ_quasiperiodic : ∀ x : ℝ, ϕ (x + 2 * Real.pi) = ϕ x + 2 * Real.pi
  lazutkin_norm : ∀ x : ℝ, (h (ϕ x) + deriv (deriv h) (ϕ x)) * (deriv ϕ x) ^ 3 = c


def HasTrigSpeed {Ω : Set Plane} (L : SupportLazutkinData Ω) : Prop :=
  ∃ B₀ C₀ D₀ : ℝ, ∀ x : ℝ,
    (deriv L.ϕ x) ^ 2 = C₀ + B₀ * Real.cos (2 * L.ϕ x) + D₀ * Real.sin (2 * L.ϕ x)


structure AnalyticGlancingCollar (Ω : Set Plane) extends SupportLazutkinData Ω where
  s₀ : ℝ
  s_h : ℝ
  s₀_pos : 0 < s₀
  s_h_pos : 0 < s_h
  h_ℂ : ℂ → ℂ
  ϕ_ℂ : ℂ → ℂ
  h_ℂ_holo : DifferentiableOn ℂ h_ℂ (horizStrip (2 * s_h))
  ϕ_ℂ_holo : DifferentiableOn ℂ ϕ_ℂ (horizStrip (2 * s₀))
  ϕ_ℂ_maps_to : ∀ z ∈ horizStrip (2 * s₀), ϕ_ℂ z ∈ horizStrip (2 * s_h)
  h_ℂ_real : ∀ θ : ℝ, h_ℂ θ = h θ
  ϕ_ℂ_real : ∀ x : ℝ, ϕ_ℂ x = ϕ x
  h_ℂ_periodic : ∀ w ∈ horizStrip (2 * s_h), h_ℂ (w + 2 * Real.pi) = h_ℂ w
  h_ℂ_conj : ∀ w ∈ horizStrip (2 * s_h),
    h_ℂ (starRingEnd ℂ w) = starRingEnd ℂ (h_ℂ w)
  ϕ_ℂ_quasiperiodic : ∀ z ∈ horizStrip (2 * s₀),
    ϕ_ℂ (z + 2 * Real.pi) = ϕ_ℂ z + 2 * Real.pi
  ϕ_ℂ_conj : ∀ z ∈ horizStrip (2 * s₀),
    ϕ_ℂ (starRingEnd ℂ z) = starRingEnd ℂ (ϕ_ℂ z)
  ϕ_ℂ_deriv_ne_zero : ∀ z ∈ horizStrip (2 * s₀), deriv ϕ_ℂ z ≠ 0
  lazutkin_norm_ℂ : ∀ z ∈ horizStrip (2 * s₀),
    (h_ℂ (ϕ_ℂ z) + deriv (deriv h_ℂ) (ϕ_ℂ z)) * (deriv ϕ_ℂ z) ^ 3 = c
  s₁ : ℝ
  r₁ : ℝ
  r₁_pos : 0 < r₁
  r₁_lt_s₁ : r₁ < s₁
  s₁_le_s₀ : s₁ ≤ s₀
  U : ℂ × ℂ → ℂ
  A : ℂ → ℂ
  U_holo : DifferentiableOn ℂ U { p : ℂ × ℂ | |p.1.im| < 2 * s₁ ∧ ‖p.2‖ < r₁ }
  A_holo : DifferentiableOn ℂ A (Metric.ball (0 : ℂ) r₁)
  U_quasiperiodic : ∀ y t : ℂ, |y.im| < 2 * s₁ → ‖t‖ < r₁ →
    U (y + 2 * Real.pi, t) = U (y, t) + 2 * Real.pi
  U_even : ∀ y t : ℂ, |y.im| < 2 * s₁ → ‖t‖ < r₁ → U (y, -t) = U (y, t)
  U_zero : ∀ y : ℂ, |y.im| < 2 * s₁ → U (y, 0) = y
  U_conj : ∀ y t : ℂ, |y.im| < 2 * s₁ → ‖t‖ < r₁ →
    U (starRingEnd ℂ y, starRingEnd ℂ t) = starRingEnd ℂ (U (y, t))
  U_maps_to : ∀ y t : ℂ, |y.im| < s₁ + r₁ → ‖t‖ < r₁ → U (y, t) ∈ horizStrip (2 * s₀)
  U_real_deriv_pos : ∀ x t : ℝ, |t| < r₁ →
    0 < deriv (fun x' : ℝ => (U (x', t)).re) x
  U_real_step_pos : ∀ x t : ℝ, 0 < t → t < r₁ →
    0 < (U (x + t, t)).re - (U (x, t)).re ∧
    0 < ϕ ((U (x + t, t)).re) - ϕ ((U (x, t)).re) ∧
    ϕ ((U (x + t, t)).re) - ϕ ((U (x, t)).re) < Real.pi
  glancing_stationary : ∀ y t : ℂ, |y.im| < s₁ → ‖t‖ < r₁ →
    -supportAction1_ℂ h_ℂ (ϕ_ℂ (U (y, t))) (ϕ_ℂ (U (y + t, t))) =
      supportAction2_ℂ h_ℂ (ϕ_ℂ (U (y - t, t))) (ϕ_ℂ (U (y, t)))
  symplectic_jacobian : ∀ y t : ℂ, |y.im| < s₁ → ‖t‖ < r₁ →
    deriv (fun y' : ℂ => -supportAction1_ℂ h_ℂ (ϕ_ℂ (U (y', t))) (ϕ_ℂ (U (y' + t, t)))) y *
      deriv (fun t' : ℂ => ϕ_ℂ (U (y, t'))) t -
    deriv (fun t' : ℂ => -supportAction1_ℂ h_ℂ (ϕ_ℂ (U (y, t'))) (ϕ_ℂ (U (y + t', t')))) t *
      deriv (fun y' : ℂ => ϕ_ℂ (U (y', t))) y = A t
  A_odd : ∀ t ∈ Metric.ball (0 : ℂ) r₁, A (-t) = -A t
  A_conj : ∀ t ∈ Metric.ball (0 : ℂ) r₁, A (starRingEnd ℂ t) = starRingEnd ℂ (A t)
  A_deriv_zero : deriv A 0 = c / 4
  A_real_pos : ∀ t : ℝ, 0 < t → t < r₁ → 0 < (A t).re


structure EntireNonisotropicStrip where
  c : ℝ
  s_star : ℝ
  r_star : ℝ
  c_pos : 0 < c
  s_star_pos : 0 < s_star
  r_star_pos : 0 < r_star
  r_star_lt_half_s_star : r_star < s_star / 2
  r_star_lt_pi : r_star < Real.pi
  ϕ : ℂ → ℂ
  f : ℂ → ℂ
  q : ℂ → ℂ
  ϕ_entire : Differentiable ℂ ϕ
  f_entire : Differentiable ℂ f
  q_entire : Differentiable ℂ q
  deriv_ϕ : ∀ s : ℂ, deriv ϕ s = f s
  deriv2_f : ∀ s : ℂ, deriv (deriv f) s = q s * f s
  ϕ_quasiperiodic : ∀ s : ℂ, ϕ (s + 2 * Real.pi) = ϕ s + 2 * Real.pi
  f_periodic : ∀ s : ℂ, f (s + 2 * Real.pi) = f s
  q_periodic : ∀ s : ℂ, q (s + 2 * Real.pi) = q s
  ϕ_conj : ∀ s : ℂ, ϕ (starRingEnd ℂ s) = starRingEnd ℂ (ϕ s)
  f_conj : ∀ s : ℂ, f (starRingEnd ℂ s) = starRingEnd ℂ (f s)
  q_conj : ∀ s : ℂ, q (starRingEnd ℂ s) = starRingEnd ℂ (q s)
  f_real_pos : ∀ x : ℝ, 0 < (f x).re ∧ (f x).im = 0
  f_lower_strip_ne_zero : ∀ s ∈ horizStrip s_star, f s ≠ 0
  f_nonconstant : ∃ x : ℝ, deriv f x ≠ 0
  f_simple_zeros : ∀ s : ℂ, f s = 0 → deriv f s ≠ 0 ∧ deriv (deriv f) s = 0
  Γ0 : ℂ → (Fin 2 → ℂ)
  Γ0_holo : DifferentiableOn ℂ (fun s => Γ0 s 0) (horizStrip s_star) ∧
    DifferentiableOn ℂ (fun s => Γ0 s 1) (horizStrip s_star)
  Γ0_deriv₀ : ∀ s ∈ horizStrip s_star,
    deriv (fun z => Γ0 z 0) s = -c * (f s)⁻¹ ^ 2 * Complex.sin (ϕ s)
  Γ0_deriv₁ : ∀ s ∈ horizStrip s_star,
    deriv (fun z => Γ0 z 1) s = c * (f s)⁻¹ ^ 2 * Complex.cos (ϕ s)
  Γ0_periodic : ∀ s ∈ horizStrip s_star, Γ0 (s + 2 * Real.pi) = Γ0 s
  Γ0_conj : ∀ s ∈ horizStrip s_star, ∀ i : Fin 2,
    Γ0 (starRingEnd ℂ s) i = starRingEnd ℂ (Γ0 s i)
  T : Set (ℂ × ℂ)
  T_open : IsOpen T
  T_base_subset :
    ({ p : ℂ × ℂ | |p.1.im| < s_star ∧ ‖p.2‖ < r_star } ∪
      { p : ℂ × ℂ | p.2 = 0 }) ⊆ T
  T_param_subset : T ⊆ { p : ℂ × ℂ | ‖p.2‖ < r_star }
  T_vertically_star_shaped : ∀ y t : ℂ, (y, t) ∈ T → ∀ η : ℝ, 0 ≤ η → η ≤ 1 →
    ((y.re : ℂ) + ((η * y.im : ℝ) : ℂ) * Complex.I, t) ∈ T
  T_horiz_invariant : ∀ y t : ℂ, ∀ x : ℝ, (y, t) ∈ T → (y + x, t) ∈ T
  T_even : ∀ y t : ℂ, (y, t) ∈ T → (y, -t) ∈ T
  T_conj : ∀ y t : ℂ, (y, t) ∈ T → (starRingEnd ℂ y, starRingEnd ℂ t) ∈ T
  𝔰 : ℂ × ℂ → ℂ
  𝔰_holo : DifferentiableOn ℂ 𝔰 T
  𝔰_zero : ∀ y : ℂ, 𝔰 (y, 0) = y
  𝔰_quasiperiodic : ∀ y t : ℂ, (y, t) ∈ T →
    𝔰 (y + 2 * Real.pi, t) = 𝔰 (y, t) + 2 * Real.pi
  𝔰_even : ∀ y t : ℂ, (y, t) ∈ T → 𝔰 (y, -t) = 𝔰 (y, t)
  𝔰_conj : ∀ y t : ℂ, (y, t) ∈ T →
    𝔰 (starRingEnd ℂ y, starRingEnd ℂ t) = starRingEnd ℂ (𝔰 (y, t))
  𝔰_mean_zero : ∀ t : ℂ, ‖t‖ < r_star →
    (∫ x in (0 : ℝ)..(2 * Real.pi), (𝔰 (x, t) - x)) = 0
  𝔰_lower_strip_im : ∀ y t : ℂ, |y.im| < s_star / 2 → ‖t‖ < r_star →
    𝔰 (y, t) ∈ horizStrip s_star
  θ_edge : ℝ → ℝ → ℝ
  ℓ_chord : ℝ → ℝ → ℝ
  real_collar_reflection : ∀ x t : ℝ, 0 < t → t < r_star →
    0 < deriv (fun x' : ℝ => (𝔰 (x', t)).re) x ∧
    0 < (𝔰 (x + t, t)).re - (𝔰 (x, t)).re ∧
    θ_edge (x - t) t + θ_edge x t = 2 * (ϕ (𝔰 (x, t))).re ∧
    θ_edge (x + 2 * Real.pi) t = θ_edge x t + 2 * Real.pi ∧
    0 < θ_edge x t - (ϕ (𝔰 (x, t))).re ∧
    θ_edge x t - (ϕ (𝔰 (x, t))).re < Real.pi / 2 ∧
    0 < ℓ_chord x t ∧
    Γ0 (𝔰 (x + t, t)) 0 - Γ0 (𝔰 (x, t)) 0 = -ℓ_chord x t * Real.sin (θ_edge x t) ∧
    Γ0 (𝔰 (x + t, t)) 1 - Γ0 (𝔰 (x, t)) 1 = ℓ_chord x t * Real.cos (θ_edge x t)
  real_vertical_promotion : ∀ t₀ x₀ b : ℝ, |t₀| < r_star → 0 < b →
    (∃ W : Set (ℂ × ℂ), IsOpen W ∧
      (∀ η : ℝ, 0 ≤ η → η ≤ b → ((x₀ : ℂ) + (η : ℝ) * Complex.I, (t₀ : ℂ)) ∈ W) ∧
      ∃ s_tilde : ℂ × ℂ → ℂ, DifferentiableOn ℂ s_tilde W ∧
        ∃ δ₀ : ℝ, 0 < δ₀ ∧ ∀ y t : ℂ, ‖y - x₀‖ < δ₀ → ‖t - t₀‖ < δ₀ →
          (y, t) ∈ W ∧ s_tilde (y, t) = 𝔰 (y, t)) →
    ∃ δ : ℝ, 0 < δ ∧
      { p : ℂ × ℂ | |p.1.im| ≤ b ∧ ‖p.2 - (t₀ : ℂ)‖ < δ } ⊆ T


structure FiniteWallNonisotropicStrip where
  H : ℝ
  c : ℝ
  s_star : ℝ
  r_star : ℝ
  H_pos : 0 < H
  c_pos : 0 < c
  r_star_pos : 0 < r_star
  s_star_pos : 0 < s_star
  s_star_lt_H : s_star < H
  r_star_lt_half_s_star : r_star < s_star / 2
  r_star_lt_pi : r_star < Real.pi
  ϕ : ℂ → ℂ
  f : ℂ → ℂ
  q : ℂ → ℂ
  ϕ_holo : DifferentiableOn ℂ ϕ (horizStrip H)
  f_holo : DifferentiableOn ℂ f (horizStrip H)
  q_holo : DifferentiableOn ℂ q (horizStrip H)
  deriv_ϕ : ∀ s ∈ horizStrip H, deriv ϕ s = f s
  deriv2_f : ∀ s ∈ horizStrip H, deriv (deriv f) s = q s * f s
  ϕ_quasiperiodic : ∀ s ∈ horizStrip H, ϕ (s + 2 * Real.pi) = ϕ s + 2 * Real.pi
  f_periodic : ∀ s ∈ horizStrip H, f (s + 2 * Real.pi) = f s
  q_periodic : ∀ s ∈ horizStrip H, q (s + 2 * Real.pi) = q s
  ϕ_conj : ∀ s ∈ horizStrip H, ϕ (starRingEnd ℂ s) = starRingEnd ℂ (ϕ s)
  f_conj : ∀ s ∈ horizStrip H, f (starRingEnd ℂ s) = starRingEnd ℂ (f s)
  q_conj : ∀ s ∈ horizStrip H, q (starRingEnd ℂ s) = starRingEnd ℂ (q s)
  f_real_pos : ∀ x : ℝ, 0 < (f x).re ∧ (f x).im = 0
  f_lower_strip_ne_zero : ∀ s ∈ horizStrip s_star, f s ≠ 0
  f_nonconstant : ∃ x : ℝ, deriv f x ≠ 0
  f_simple_zeros : ∀ s ∈ horizStrip H, f s = 0 → deriv f s ≠ 0 ∧ deriv (deriv f) s = 0
  Γ : ℂ → (Fin 2 → ℂ)
  H0 : ℂ → ℂ
  Γ_mero : MeromorphicOn (fun s => Γ s 0) (horizStrip H) ∧
    MeromorphicOn (fun s => Γ s 1) (horizStrip H)
  H0_holo : DifferentiableOn ℂ H0 (horizStrip H)
  H0_periodic : ∀ s ∈ horizStrip H, H0 (s + 2 * Real.pi) = H0 s
  H0_conj : ∀ s ∈ horizStrip H, H0 (starRingEnd ℂ s) = starRingEnd ℂ (H0 s)
  Γ_reg_holo : ∀ s ∈ horizStrip H, f s ≠ 0 →
    DifferentiableAt ℂ (fun z => Γ z 0) s ∧ DifferentiableAt ℂ (fun z => Γ z 1) s
  Γ_deriv₀ : ∀ s ∈ horizStrip H, f s ≠ 0 →
    deriv (fun z => Γ z 0) s = -c * (f s)⁻¹ ^ 2 * Complex.sin (ϕ s)
  Γ_deriv₁ : ∀ s ∈ horizStrip H, f s ≠ 0 →
    deriv (fun z => Γ z 1) s = c * (f s)⁻¹ ^ 2 * Complex.cos (ϕ s)
  Γ_periodic : ∀ s ∈ horizStrip H, f s ≠ 0 → Γ (s + 2 * Real.pi) = Γ s
  Γ_conj : ∀ s ∈ horizStrip H, f s ≠ 0 → ∀ i : Fin 2,
    Γ (starRingEnd ℂ s) i = starRingEnd ℂ (Γ s i)
  H0_eq : ∀ s ∈ horizStrip H, f s ≠ 0 →
    H0 s = Γ s 0 * Complex.cos (ϕ s) + Γ s 1 * Complex.sin (ϕ s)
  H0_deriv : ∀ s ∈ horizStrip H, f s ≠ 0 →
    deriv H0 s = (-Γ s 0 * Complex.sin (ϕ s) + Γ s 1 * Complex.cos (ϕ s)) * f s
  h_X : ℂ → ℝ
  h_X_bounds : ∀ t ∈ Metric.ball (0 : ℂ) r_star, s_star ≤ h_X t ∧ h_X t ≤ H
  h_X_zero : h_X 0 = H
  h_X_even : ∀ t ∈ Metric.ball (0 : ℂ) r_star, h_X (-t) = h_X t
  h_X_lsc : LowerSemicontinuousOn h_X (Metric.ball (0 : ℂ) r_star)
  tube_open : IsOpen (finiteWallTube r_star h_X)
  deficit_subharmonic : ∀ t₀ : ℂ, ∀ ρ : ℝ, 0 < ρ → ‖t₀‖ + ρ < r_star →
    MeasureTheory.IntegrableOn
      (fun θ : ℝ => H - h_X (t₀ + (ρ : ℂ) * Complex.exp ((θ : ℂ) * Complex.I)))
      (Set.Icc 0 (2 * Real.pi)) MeasureTheory.volume ∧
    H - h_X t₀ ≤ (2 * Real.pi)⁻¹ *
      ∫ θ in (0 : ℝ)..(2 * Real.pi),
        (H - h_X (t₀ + (ρ : ℂ) * Complex.exp ((θ : ℂ) * Complex.I)))
  𝔰 : ℂ × ℂ → ℂ
  V : ℂ → ℂ
  A : ℂ → ℂ
  Θ_gl : ℂ × ℂ → ℂ
  p_gl : ℂ × ℂ → ℂ
  ℓ_chord : ℝ → ℝ → ℝ
  𝔰_holo : DifferentiableOn ℂ 𝔰 (finiteWallTube r_star h_X)
  𝔰_maps_to : ∀ p ∈ finiteWallTube r_star h_X, 𝔰 p ∈ horizStrip H
  𝔰_lower_strip_im : ∀ y t : ℂ, |y.im| < s_star / 2 → ‖t‖ < r_star →
    𝔰 (y, t) ∈ horizStrip s_star
  𝔰_zero : ∀ y ∈ horizStrip H, 𝔰 (y, 0) = y
  𝔰_quasiperiodic : ∀ p ∈ finiteWallTube r_star h_X,
    𝔰 (p.1 + 2 * Real.pi, p.2) = 𝔰 p + 2 * Real.pi
  𝔰_even : ∀ p ∈ finiteWallTube r_star h_X, 𝔰 (p.1, -p.2) = 𝔰 p
  𝔰_conj : ∀ p ∈ finiteWallTube r_star h_X,
    𝔰 (starRingEnd ℂ p.1, starRingEnd ℂ p.2) = starRingEnd ℂ (𝔰 p)
  𝔰_mean_zero : ∀ t : ℂ, ‖t‖ < r_star →
    (∫ x in (0 : ℝ)..(2 * Real.pi), (𝔰 (x, t) - x)) = 0
  V_holo : DifferentiableOn ℂ V (horizStrip H)
  V_periodic : ∀ s ∈ horizStrip H, V (s + 2 * Real.pi) = V s
  V_conj : ∀ s ∈ horizStrip H, V (starRingEnd ℂ s) = starRingEnd ℂ (V s)
  V_mean_zero : (∫ x in (0 : ℝ)..(2 * Real.pi), V x) = 0
  𝔰_deriv_t_zero : ∀ y ∈ horizStrip H, deriv (fun t : ℂ => 𝔰 (y, t)) 0 = 0
  𝔰_deriv2_t_zero : ∀ y ∈ horizStrip H, deriv (deriv (fun t : ℂ => 𝔰 (y, t))) 0 = 2 * V y
  V_deriv : ∀ s ∈ horizStrip H,
    deriv V s = (1 / 120 : ℂ) *
      (f s ^ 2 + 8 * q s -
        (2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi), (f x ^ 2 + 8 * q x))
  Θ_gl_holo : DifferentiableOn ℂ Θ_gl { p : ℂ × ℂ | |p.1.im| < s_star ∧ ‖p.2‖ < r_star }
  p_gl_holo : DifferentiableOn ℂ p_gl { p : ℂ × ℂ | |p.1.im| < s_star ∧ ‖p.2‖ < r_star }
  A_holo : DifferentiableOn ℂ A (Metric.ball (0 : ℂ) r_star)
  A_odd : ∀ t ∈ Metric.ball (0 : ℂ) r_star, A (-t) = -A t
  A_conj : ∀ t ∈ Metric.ball (0 : ℂ) r_star, A (starRingEnd ℂ t) = starRingEnd ℂ (A t)
  A_deriv_zero : deriv A 0 = c / 4
  A_real_pos : ∀ t : ℝ, 0 < t → t < r_star → 0 < (A t).re
  symplectic_gl : ∀ y t : ℂ, |y.im| < s_star → ‖t‖ < r_star →
    deriv (fun y' : ℂ => p_gl (y', t)) y * deriv (fun t' : ℂ => Θ_gl (y, t')) t -
    deriv (fun t' : ℂ => p_gl (y, t')) t * deriv (fun y' : ℂ => Θ_gl (y', t)) y = A t
  real_collar_chord : ∀ x t : ℝ, 0 < t → t < r_star →
    (Θ_gl (x + t / 2, t)).im = 0 ∧
    (p_gl (x + t / 2, t)).im = 0 ∧
    0 < deriv (fun x' : ℝ => (𝔰 (x', t)).re) x ∧
    0 < (𝔰 (x + t, t)).re - (𝔰 (x, t)).re ∧
    (Θ_gl (x - t / 2, t)).re + (Θ_gl (x + t / 2, t)).re = 2 * (ϕ (𝔰 (x, t))).re ∧
    (Θ_gl (x + 2 * Real.pi + t / 2, t)).re = (Θ_gl (x + t / 2, t)).re + 2 * Real.pi ∧
    0 < (Θ_gl (x + t / 2, t)).re - (ϕ (𝔰 (x, t))).re ∧
    (Θ_gl (x + t / 2, t)).re - (ϕ (𝔰 (x, t))).re < Real.pi / 2 ∧
    0 < ℓ_chord x t ∧
    Γ (𝔰 (x + t, t)) 0 - Γ (𝔰 (x, t)) 0 =
      -ℓ_chord x t * Real.sin ((Θ_gl (x + t / 2, t)).re) ∧
    Γ (𝔰 (x + t, t)) 1 - Γ (𝔰 (x, t)) 1 =
      ℓ_chord x t * Real.cos ((Θ_gl (x + t / 2, t)).re) ∧
    p_gl (x + t / 2, t) =
      Γ (𝔰 (x, t)) 0 * Real.cos ((Θ_gl (x + t / 2, t)).re) +
        Γ (𝔰 (x, t)) 1 * Real.sin ((Θ_gl (x + t / 2, t)).re)
  no_patch_at_real_wall : ∀ t₀ x₀ ε : ℝ, |t₀| < r_star → 0 < ε → ε < s_star →
    ¬ ∃ g : ℂ × ℂ → ℂ,
      DifferentiableOn ℂ g
        { p : ℂ × ℂ |
          ‖p.1 - ((x₀ : ℂ) + (h_X t₀ : ℂ) * Complex.I)‖ < ε ∧
          ‖p.2 - (t₀ : ℂ)‖ < ε } ∧
      (∀ p : ℂ × ℂ,
        ‖p.1 - ((x₀ : ℂ) + (h_X t₀ : ℂ) * Complex.I)‖ < ε →
        ‖p.2 - (t₀ : ℂ)‖ < ε → g p ∈ horizStrip H) ∧
      ∃ δ : ℝ, 0 < δ ∧ δ ≤ ε ∧
        ∀ p : ℂ × ℂ,
          |p.1.re - x₀| < ε / 4 →
          |p.1.im - (h_X t₀ - ε / 2)| < ε / 4 →
          ‖p.2 - (t₀ : ℂ)‖ < δ → g p = 𝔰 p
  no_full_scale_cone_passage : ∀ δ_star : ℝ, 0 < δ_star → δ_star < H - s_star →
    ∃ d₀ : ℝ, 0 < d₀ ∧ ∀ d x₀ : ℝ, 0 < d → d < d₀ →
      ¬ ∃ s_tilde : ℂ × ℂ → ℂ,
        DifferentiableOn ℂ s_tilde
          { p : ℂ × ℂ |
            d / 10 < H - p.1.im ∧ H - p.1.im < δ_star ∧
            |p.1.re - x₀| < 50 * (H - p.1.im) ∧ ‖p.2‖ < 2 * d } ∧
        (∀ p : ℂ × ℂ,
          d / 10 < H - p.1.im → H - p.1.im < δ_star →
          |p.1.re - x₀| < 50 * (H - p.1.im) → ‖p.2‖ < 2 * d →
          s_tilde p ∈ horizStrip H) ∧
        ∃ η : ℝ, 0 < η ∧
          ∀ p : ℂ × ℂ,
            d / 10 < H - p.1.im → H - p.1.im < δ_star →
            δ_star / 2 < H - p.1.im →
            |p.1.re - x₀| < 50 * (H - p.1.im) → ‖p.2‖ < η → ‖p.2‖ < 2 * d →
            s_tilde p = 𝔰 p


noncomputable def shapeModulus (S : FiniteWallNonisotropicStrip) (s : ℂ) : ℝ :=
  max ‖S.f s‖ (Real.sqrt ‖S.q s‖)


def wallDepth (S : FiniteWallNonisotropicStrip) (s : ℂ) : ℝ :=
  S.H - s.im


structure CriticalWallData (S : FiniteWallNonisotropicStrip) : Prop where
  critical_upper_bound : ∀ ε : ℝ, 0 < ε → ∃ K₀ : ℝ, ∀ k : ℝ, K₀ ≤ k → Real.exp (-k) < S.H →
    ∀ x : ℝ,
      shapeModulus S ((x : ℂ) + ((S.H - Real.exp (-k) : ℝ) : ℂ) * Complex.I) ≤
        Real.exp ((1 + ε) * k)
  critical_lower_unbounded : ∀ ε : ℝ, 0 < ε → ∀ K₀ : ℝ, ∃ k : ℝ, K₀ ≤ k ∧
    Real.exp (-k) < S.H ∧
    ∃ x ∈ Set.Icc (0 : ℝ) (2 * Real.pi),
      Real.exp ((1 - ε) * k) ≤
        shapeModulus S ((x : ℂ) + ((S.H - Real.exp (-k) : ℝ) : ℂ) * Complex.I)
  cone_passage : ∀ α m₀ δ_b : ℝ, 1 / 2 < α → α < 1 → 0 < m₀ → 0 < δ_b → δ_b < S.H / 2 →
    ∃ L δ_star : ℝ, 0 < L ∧ 0 < δ_star ∧ δ_star < δ_b ∧
      ∀ K : ℝ, 0 < K → ∃ C ε₀ d₀ : ℝ, 0 < C ∧ 0 < ε₀ ∧ 0 < d₀ ∧
        ∀ d x₀ r ε : ℝ, 0 < d → d < d₀ → 0 < r → r ≤ K * d → 0 < ε → ε ≤ ε₀ →
          (∀ s : ℂ, d / 10 ≤ wallDepth S s → wallDepth S s ≤ δ_b →
            |s.re - x₀| ≤ L * wallDepth S s →
            r * shapeModulus S s ≤ ε * (d / wallDepth S s) ^ α) →
          ∃ s_tilde : ℂ × ℂ → ℂ,
            DifferentiableOn ℂ s_tilde
              { p : ℂ × ℂ |
                d < S.H - p.1.im ∧ S.H - p.1.im < δ_star ∧
                |p.1.re - x₀| < m₀ * (S.H - p.1.im) ∧
                ‖p.2‖ < r * ((S.H - p.1.im) / d) ^ α } ∧
            (∀ p : ℂ × ℂ,
              d < S.H - p.1.im → S.H - p.1.im < δ_star →
              |p.1.re - x₀| < m₀ * (S.H - p.1.im) →
              ‖p.2‖ < r * ((S.H - p.1.im) / d) ^ α →
              s_tilde p ∈ horizStrip S.H ∧
              s_tilde (p.1, -p.2) = s_tilde p ∧
              ‖s_tilde p - p.1‖ ≤
                C * (1 + (ε / r) * d ^ α) ^ 2 * ‖p.2‖ ^ 2 * (S.H - p.1.im) ^ (1 - 2 * α) ∧
              (δ_star / 2 < S.H - p.1.im → p ∈ finiteWallTube S.r_star S.h_X) ∧
              (p ∈ finiteWallTube S.r_star S.h_X → s_tilde p = S.𝔰 p))
  deep_first_field_model : ∀ d_seq B_seq ξ_seq : ℕ → ℝ, ∀ α δ_b : ℝ, ∀ F : ℂ → ℂ,
    1 / 2 < α → α < 1 → 0 < δ_b → δ_b < S.H / 2 →
    DifferentiableOn ℂ F { Z : ℂ | Z.im < 0 } →
    (∀ n : ℕ, 0 < d_seq n ∧ 0 < B_seq n) →
    Filter.Tendsto d_seq Filter.atTop (nhds 0) →
    Filter.Tendsto B_seq Filter.atTop Filter.atTop →
    (∀ A : ℝ, 0 < A → ∃ C_A : ℝ, 0 < C_A ∧ ∃ N₀ : ℕ, ∀ n ≥ N₀, ∀ s : ℂ,
      d_seq n ≤ wallDepth S s → wallDepth S s ≤ δ_b →
      |s.re - ξ_seq n| ≤ A * wallDepth S s →
      (d_seq n / B_seq n) * shapeModulus S s ≤ C_A * (d_seq n / wallDepth S s) ^ α) →
    TendstoLocallyUniformlyOn
      (fun n Z =>
        ((d_seq n / B_seq n : ℝ) : ℂ) *
          S.f ((ξ_seq n : ℂ) + (S.H : ℂ) * Complex.I + (d_seq n : ℂ) * Z))
      F Filter.atTop { Z : ℂ | Z.im < 0 } →
    TendstoLocallyUniformlyOn
      (fun n Z =>
        ((d_seq n / B_seq n : ℝ) : ℂ) ^ 2 *
          S.q ((ξ_seq n : ℂ) + (S.H : ℂ) * Complex.I + (d_seq n : ℂ) * Z))
      (fun _ => 0) Filter.atTop { Z : ℂ | Z.im < 0 } →
    ∀ A₀ T₀ : ℝ, 0 < A₀ → 0 < T₀ →
      ∃ D₀ C₀ : ℝ, 0 < D₀ ∧ 0 < C₀ ∧
        ∃ S_lim : ℂ × ℂ → ℂ,
          DifferentiableOn ℂ S_lim
            { p : ℂ × ℂ | ‖p.1‖ < T₀ ∧ D₀ < -p.2.im ∧ |p.2.re| < A₀ * (-p.2.im) } ∧
          (∀ T Y : ℂ, ‖T‖ < T₀ → D₀ < -Y.im → |Y.re| < A₀ * (-Y.im) →
            (S_lim (T, Y)).im < 0 ∧
            S_lim (-T, Y) = S_lim (T, Y) ∧
            ‖S_lim (T, Y) - Y‖ ≤ C₀ * ‖T‖ ^ 2 * (-Y.im) ^ (1 - 2 * α) ∧
            (deriv (fun Y' : ℂ => S_lim (T, Y')) Y) ^ 3 *
              frozenFirstFieldG
                (T * F (S_lim (T, Y)) * deriv (fun Y' : ℂ => S_lim (T, Y')) Y / 2) = 1) ∧
          (∀ Y : ℂ, D₀ < -Y.im → |Y.re| < A₀ * (-Y.im) → S_lim (0, Y) = Y) ∧
          (∀ K : Set (ℂ × ℂ), IsCompact K →
            K ⊆ { p : ℂ × ℂ | ‖p.1‖ < T₀ ∧ D₀ < -p.2.im ∧ |p.2.re| < A₀ * (-p.2.im) } →
            ∀ ε : ℝ, 0 < ε → ∃ N₁ : ℕ, ∀ n ≥ N₁, ∀ p ∈ K,
              ((ξ_seq n : ℂ) + (S.H : ℂ) * Complex.I + (d_seq n : ℂ) * p.2,
                p.1 * (d_seq n : ℂ) / (B_seq n : ℂ)) ∈ finiteWallTube S.r_star S.h_X →
              ‖(S.𝔰 ((ξ_seq n : ℂ) + (S.H : ℂ) * Complex.I + (d_seq n : ℂ) * p.2,
                  p.1 * (d_seq n : ℂ) / (B_seq n : ℂ)) -
                (ξ_seq n : ℂ) - (S.H : ℂ) * Complex.I) / (d_seq n : ℂ) - S_lim p‖ < ε)
  exp_profile_obstruction : ∀ x_seq h_seq ℓ_seq m_seq : ℕ → ℝ, ∀ c₀ : ℂ, ∀ α₀ δ_b : ℝ,
    c₀ ≠ 0 → 1 / 2 < α₀ → α₀ < 1 → 0 < δ_b → δ_b < S.H / 2 →
    (∀ n : ℕ, h_seq n < S.H ∧ 0 < ℓ_seq n ∧ 0 < m_seq n) →
    Filter.Tendsto h_seq Filter.atTop (nhds S.H) →
    Filter.Tendsto ℓ_seq Filter.atTop (nhds 0) →
    Filter.Tendsto (fun n => ℓ_seq n * m_seq n) Filter.atTop Filter.atTop →
    Filter.Tendsto (fun n => (S.H - h_seq n) / ℓ_seq n) Filter.atTop Filter.atTop →
    ((TendstoLocallyUniformly
        (fun n Z =>
          ((m_seq n)⁻¹ : ℂ) *
            S.f ((x_seq n : ℂ) + (h_seq n : ℂ) * Complex.I + (ℓ_seq n : ℂ) * Z))
        (fun Z => c₀ * Complex.exp (-Complex.I * Z)) Filter.atTop ∧
      TendstoLocallyUniformly
        (fun n Z =>
          (((m_seq n) ^ 2)⁻¹ : ℂ) *
            S.q ((x_seq n : ℂ) + (h_seq n : ℂ) * Complex.I + (ℓ_seq n : ℂ) * Z))
        (fun _ => 0) Filter.atTop) ∨
     (TendstoLocallyUniformly
        (fun n Z =>
          ((m_seq n)⁻¹ : ℂ) *
            S.f ((x_seq n : ℂ) + (h_seq n : ℂ) * Complex.I + (ℓ_seq n : ℂ) * Z))
        (fun _ => 0) Filter.atTop ∧
      TendstoLocallyUniformly
        (fun n Z =>
          (((m_seq n) ^ 2)⁻¹ : ℂ) *
            S.q ((x_seq n : ℂ) + (h_seq n : ℂ) * Complex.I + (ℓ_seq n : ℂ) * Z))
        (fun Z => c₀ ^ 2 * Complex.exp (-2 * Complex.I * Z)) Filter.atTop)) →
    ¬ (∀ L : ℝ, 0 < L → ∃ C_L : ℝ, 0 < C_L ∧ ∃ N₀ : ℕ, ∀ n ≥ N₀, ∀ s : ℂ,
      ℓ_seq n ≤ h_seq n - s.im → h_seq n - s.im ≤ δ_b →
      |s.re - x_seq n| ≤ L * (h_seq n - s.im) →
      shapeModulus S s ≤ C_L * m_seq n * (ℓ_seq n / (h_seq n - s.im)) ^ α₀)
  log_deficit_bound : ∃ C_def : ℝ, 0 < C_def ∧
    ∀ z₀ : ℂ, ∀ Δ K : ℝ, 0 < Δ →
      Metric.closedBall z₀ Δ ⊆ horizStrip S.H →
      (∀ z ∈ Metric.closedBall z₀ Δ, ‖S.f z‖ ≤ Real.exp K) →
      MeasureTheory.IntegrableOn
        (fun w : ℂ => K - Real.log ‖S.f w‖) (Metric.ball z₀ Δ) MeasureTheory.volume ∧
      ∀ z ∈ Metric.ball z₀ (Δ / 4),
        Δ * Real.sqrt ‖S.q z‖ ≤
          C_def * (1 + (Real.pi * Δ ^ 2)⁻¹ *
            ∫ w in Metric.ball z₀ Δ, (K - Real.log ‖S.f w‖))
  poly_growth_witness : ∀ C_p A_p δ_p : ℝ, 0 < C_p → 0 < A_p → 0 < δ_p →
    (∀ s ∈ horizStrip S.H, wallDepth S s ≤ δ_p →
      wallDepth S s * shapeModulus S s ≤
        C_p * (1 + Real.log (1 / wallDepth S s)) ^ A_p) →
    ∃ L₀ C₁ C₂ c_star k_star : ℝ,
      0 < L₀ ∧ 0 < C₁ ∧ 0 < C₂ ∧ 0 < c_star ∧ 1 ≤ k_star ∧
      ∀ k x₀ : ℝ, k_star ≤ k →
        ∃ z ∈ horizStrip S.H,
          0 < z.im ∧
          |z.re - x₀| ≤ L₀ * wallDepth S z ∧
          k - C₁ * Real.log k ≤ -Real.log (wallDepth S z) ∧
          -Real.log (wallDepth S z) ≤ k + C₂ ∧
          c_star ≤ wallDepth S z * (‖S.f z‖ + Real.sqrt ‖S.q z‖)


noncomputable def rowMomentF (S : FiniteWallNonisotropicStrip) (k : ℝ) : ℝ :=
  Real.exp (-k) * Real.sqrt ((2 * Real.pi)⁻¹ *
    ∫ x in (0 : ℝ)..(2 * Real.pi),
      ‖S.f ((x : ℂ) + ((S.H - Real.exp (-k) : ℝ) : ℂ) * Complex.I)‖ ^ 2)


noncomputable def rowMomentFull (S : FiniteWallNonisotropicStrip) (k : ℝ) : ℝ :=
  Real.exp (-k) * Real.sqrt ((2 * Real.pi)⁻¹ *
    ∫ x in (0 : ℝ)..(2 * Real.pi),
      (‖S.f ((x : ℂ) + ((S.H - Real.exp (-k) : ℝ) : ℂ) * Complex.I)‖ ^ 2 +
        ‖S.q ((x : ℂ) + ((S.H - Real.exp (-k) : ℝ) : ℂ) * Complex.I)‖))


structure CriticalAngleBudgetData (S : FiniteWallNonisotropicStrip) where
  k₀ : ℝ
  C_env : ℝ
  ρ : ℝ
  k₀_ge_one : 1 ≤ k₀
  exp_neg_k₀_lt : Real.exp (-k₀) < S.H / 10
  C_env_pos : 0 < C_env
  ρ_pos : 0 < ρ
  ρ_lt_one : ρ < 1
  moment_poly_bound : ∀ k : ℝ, k₀ ≤ k → rowMomentFull S k ≤ C_env * (1 + k)
  row_sup_poly_bound : ∀ k : ℝ, k₀ ≤ k → ∀ x : ℝ,
    Real.exp (-k) *
      (‖S.f ((x : ℂ) + ((S.H - Real.exp (-k) : ℝ) : ℂ) * Complex.I)‖ +
        Real.sqrt ‖S.q ((x : ℂ) + ((S.H - Real.exp (-k) : ℝ) : ℂ) * Complex.I)‖) ≤
      C_env * (1 + k) ^ 2
  angle_budget : ∀ K : ℝ, k₀ ≤ K →
    MeasureTheory.IntegrableOn (fun v : ℝ => (rowMomentF S v) ^ 2)
      (Set.Icc k₀ K) MeasureTheory.volume ∧
    (∫ v in k₀..K, (rowMomentF S v) ^ 2) ≤ C_env * K ^ (2 * ρ)
  single_center_vanishing_exclusion :
    ∀ c_exp α₀ δ_b : ℝ,
      0 < c_exp → c_exp < 1 / 2 → 1 / 2 < α₀ → α₀ < 1 - c_exp →
      0 < δ_b → δ_b < S.H / 2 →
      ∃ L_star : ℝ, 0 < L_star ∧
        ∀ k_seq x_seq : ℕ → ℝ, ∀ C₀ C₁ : ℝ, 0 < C₀ → 0 < C₁ →
          (∀ n : ℕ, k₀ ≤ k_seq n) →
          Filter.Tendsto k_seq Filter.atTop Filter.atTop →
          Filter.Tendsto (fun n => rowMomentFull S (k_seq n)) Filter.atTop Filter.atTop →
          (∀ n : ℕ, ∀ l : ℝ, k₀ ≤ l →
            rowMomentFull S l ≤
              C₀ * rowMomentFull S (k_seq n) * Real.exp (c_exp * |l - k_seq n|)) →
          (∀ n : ℕ, ∀ s : ℂ,
            Real.exp (-k_seq n) ≤ wallDepth S s → wallDepth S s ≤ δ_b →
            |s.re - x_seq n| ≤ L_star * wallDepth S s →
            (Real.exp (-k_seq n) / rowMomentFull S (k_seq n)) * shapeModulus S s ≤
              C₁ * (Real.exp (-k_seq n) / wallDepth S s) ^ α₀) →
          ¬ (TendstoLocallyUniformlyOn
              (fun n Z =>
                ((Real.exp (-k_seq n) / rowMomentFull S (k_seq n) : ℝ) : ℂ) *
                  S.f ((x_seq n : ℂ) + (S.H : ℂ) * Complex.I +
                    (Real.exp (-k_seq n) : ℂ) * Z))
              (fun _ => 0) Filter.atTop { Z : ℂ | Z.im < 0 } ∧
            TendstoLocallyUniformlyOn
              (fun n Z =>
                ((Real.exp (-k_seq n) / rowMomentFull S (k_seq n) : ℝ) : ℂ) ^ 2 *
                  S.q ((x_seq n : ℂ) + (S.H : ℂ) * Complex.I +
                    (Real.exp (-k_seq n) : ℂ) * Z))
              (fun _ => 0) Filter.atTop { Z : ℂ | Z.im < 0 })
noncomputable def frozenSecondFieldG (w : ℂ) : ℂ :=
  (12 * ∑' m : ℕ, (4 : ℂ) ^ m * w ^ m / ((2 * m + 3).factorial : ℂ)) /
    (1 + ∑' m : ℕ, (4 : ℂ) ^ m * w ^ m / ((2 * m).factorial : ℂ))

def CriticalUpperBoundProp (S : FiniteWallNonisotropicStrip) : Prop :=
  ∀ ε : ℝ, 0 < ε → ∃ K₀ : ℝ, ∀ k : ℝ, K₀ ≤ k → Real.exp (-k) < S.H →
    ∀ x : ℝ,
      shapeModulus S ((x : ℂ) + ((S.H - Real.exp (-k) : ℝ) : ℂ) * Complex.I) ≤
        Real.exp ((1 + ε) * k)

def ConePassageProp (S : FiniteWallNonisotropicStrip) : Prop :=
  ∀ α m₀ δ_b : ℝ, 1 / 2 < α → α < 1 → 0 < m₀ → 0 < δ_b → δ_b < S.H / 2 →
    ∃ L δ_star : ℝ, 0 < L ∧ 0 < δ_star ∧ δ_star < δ_b ∧
      ∀ K : ℝ, 0 < K → ∃ C ε₀ d₀ : ℝ, 0 < C ∧ 0 < ε₀ ∧ 0 < d₀ ∧
        ∀ d x₀ r ε : ℝ, 0 < d → d < d₀ → 0 < r → r ≤ K * d → 0 < ε → ε ≤ ε₀ →
          (∀ s : ℂ, d / 10 ≤ wallDepth S s → wallDepth S s ≤ δ_b →
            |s.re - x₀| ≤ L * wallDepth S s →
            r * shapeModulus S s ≤ ε * (d / wallDepth S s) ^ α) →
          ∃ s_tilde : ℂ × ℂ → ℂ,
            DifferentiableOn ℂ s_tilde
              { p : ℂ × ℂ |
                d < S.H - p.1.im ∧ S.H - p.1.im < δ_star ∧
                |p.1.re - x₀| < m₀ * (S.H - p.1.im) ∧
                ‖p.2‖ < r * ((S.H - p.1.im) / d) ^ α } ∧
            (∀ p : ℂ × ℂ,
              d < S.H - p.1.im → S.H - p.1.im < δ_star →
              |p.1.re - x₀| < m₀ * (S.H - p.1.im) →
              ‖p.2‖ < r * ((S.H - p.1.im) / d) ^ α →
              s_tilde p ∈ horizStrip S.H ∧
              s_tilde (p.1, -p.2) = s_tilde p ∧
              ‖s_tilde p - p.1‖ ≤
                C * (1 + (ε / r) * d ^ α) ^ 2 * ‖p.2‖ ^ 2 * (S.H - p.1.im) ^ (1 - 2 * α) ∧
              (δ_star / 2 < S.H - p.1.im → p ∈ finiteWallTube S.r_star S.h_X) ∧
              (p ∈ finiteWallTube S.r_star S.h_X → s_tilde p = S.𝔰 p))

def DeepFirstFieldModelProp (S : FiniteWallNonisotropicStrip) : Prop :=
  ∀ d_seq B_seq ξ_seq : ℕ → ℝ, ∀ α δ_b : ℝ, ∀ F : ℂ → ℂ,
    1 / 2 < α → α < 1 → 0 < δ_b → δ_b < S.H / 2 →
    DifferentiableOn ℂ F { Z : ℂ | Z.im < 0 } →
    (∀ n : ℕ, 0 < d_seq n ∧ 0 < B_seq n) →
    Filter.Tendsto d_seq Filter.atTop (nhds 0) →
    Filter.Tendsto B_seq Filter.atTop Filter.atTop →
    (∀ A : ℝ, 0 < A → ∃ C_A : ℝ, 0 < C_A ∧ ∃ N₀ : ℕ, ∀ n ≥ N₀, ∀ s : ℂ,
      d_seq n ≤ wallDepth S s → wallDepth S s ≤ δ_b →
      |s.re - ξ_seq n| ≤ A * wallDepth S s →
      (d_seq n / B_seq n) * shapeModulus S s ≤ C_A * (d_seq n / wallDepth S s) ^ α) →
    TendstoLocallyUniformlyOn
      (fun n Z =>
        ((d_seq n / B_seq n : ℝ) : ℂ) *
          S.f ((ξ_seq n : ℂ) + (S.H : ℂ) * Complex.I + (d_seq n : ℂ) * Z))
      F Filter.atTop { Z : ℂ | Z.im < 0 } →
    TendstoLocallyUniformlyOn
      (fun n Z =>
        ((d_seq n / B_seq n : ℝ) : ℂ) ^ 2 *
          S.q ((ξ_seq n : ℂ) + (S.H : ℂ) * Complex.I + (d_seq n : ℂ) * Z))
      (fun _ => 0) Filter.atTop { Z : ℂ | Z.im < 0 } →
    ∀ A₀ T₀ : ℝ, 0 < A₀ → 0 < T₀ →
      ∃ D₀ C₀ : ℝ, 0 < D₀ ∧ 0 < C₀ ∧
        ∃ S_lim : ℂ × ℂ → ℂ,
          DifferentiableOn ℂ S_lim
            { p : ℂ × ℂ | ‖p.1‖ < T₀ ∧ D₀ < -p.2.im ∧ |p.2.re| < A₀ * (-p.2.im) } ∧
          (∀ T Y : ℂ, ‖T‖ < T₀ → D₀ < -Y.im → |Y.re| < A₀ * (-Y.im) →
            (S_lim (T, Y)).im < 0 ∧
            S_lim (-T, Y) = S_lim (T, Y) ∧
            ‖S_lim (T, Y) - Y‖ ≤ C₀ * ‖T‖ ^ 2 * (-Y.im) ^ (1 - 2 * α) ∧
            (deriv (fun Y' : ℂ => S_lim (T, Y')) Y) ^ 3 *
              frozenFirstFieldG
                (T * F (S_lim (T, Y)) * deriv (fun Y' : ℂ => S_lim (T, Y')) Y / 2) = 1) ∧
          (∀ Y : ℂ, D₀ < -Y.im → |Y.re| < A₀ * (-Y.im) → S_lim (0, Y) = Y) ∧
          (∀ K : Set (ℂ × ℂ), IsCompact K →
            K ⊆ { p : ℂ × ℂ | ‖p.1‖ < T₀ ∧ D₀ < -p.2.im ∧ |p.2.re| < A₀ * (-p.2.im) } →
            ∀ ε : ℝ, 0 < ε → ∃ N₁ : ℕ, ∀ n ≥ N₁, ∀ p ∈ K,
              ((ξ_seq n : ℂ) + (S.H : ℂ) * Complex.I + (d_seq n : ℂ) * p.2,
                p.1 * (d_seq n : ℂ) / (B_seq n : ℂ)) ∈ finiteWallTube S.r_star S.h_X →
              ‖(S.𝔰 ((ξ_seq n : ℂ) + (S.H : ℂ) * Complex.I + (d_seq n : ℂ) * p.2,
                  p.1 * (d_seq n : ℂ) / (B_seq n : ℂ)) -
                (ξ_seq n : ℂ) - (S.H : ℂ) * Complex.I) / (d_seq n : ℂ) - S_lim p‖ < ε)

def DeepSecondFieldModelProp (S : FiniteWallNonisotropicStrip) : Prop :=
  ∀ d_seq B_seq ξ_seq : ℕ → ℝ, ∀ α δ_b : ℝ, ∀ Q : ℂ → ℂ,
    1 / 2 < α → α < 1 → 0 < δ_b → δ_b < S.H / 2 →
    DifferentiableOn ℂ Q { Z : ℂ | Z.im < 0 } →
    (∀ n : ℕ, 0 < d_seq n ∧ 0 < B_seq n) →
    Filter.Tendsto d_seq Filter.atTop (nhds 0) →
    Filter.Tendsto B_seq Filter.atTop Filter.atTop →
    (∀ A : ℝ, 0 < A → ∃ C_A : ℝ, 0 < C_A ∧ ∃ N₀ : ℕ, ∀ n ≥ N₀, ∀ s : ℂ,
      d_seq n ≤ wallDepth S s → wallDepth S s ≤ δ_b →
      |s.re - ξ_seq n| ≤ A * wallDepth S s →
      (d_seq n / B_seq n) * shapeModulus S s ≤ C_A * (d_seq n / wallDepth S s) ^ α) →
    TendstoLocallyUniformlyOn
      (fun n Z =>
        ((d_seq n / B_seq n : ℝ) : ℂ) *
          S.f ((ξ_seq n : ℂ) + (S.H : ℂ) * Complex.I + (d_seq n : ℂ) * Z))
      (fun _ => 0) Filter.atTop { Z : ℂ | Z.im < 0 } →
    TendstoLocallyUniformlyOn
      (fun n Z =>
        ((d_seq n / B_seq n : ℝ) : ℂ) ^ 2 *
          S.q ((ξ_seq n : ℂ) + (S.H : ℂ) * Complex.I + (d_seq n : ℂ) * Z))
      Q Filter.atTop { Z : ℂ | Z.im < 0 } →
    ∀ A₀ T₀ : ℝ, 0 < A₀ → 0 < T₀ →
      ∃ D₀ C₀ : ℝ, 0 < D₀ ∧ 0 < C₀ ∧
        ∃ S_lim : ℂ × ℂ → ℂ,
          DifferentiableOn ℂ S_lim
            { p : ℂ × ℂ | ‖p.1‖ < T₀ ∧ D₀ < -p.2.im ∧ |p.2.re| < A₀ * (-p.2.im) } ∧
          (∀ T Y : ℂ, ‖T‖ < T₀ → D₀ < -Y.im → |Y.re| < A₀ * (-Y.im) →
            (S_lim (T, Y)).im < 0 ∧
            S_lim (-T, Y) = S_lim (T, Y) ∧
            ‖S_lim (T, Y) - Y‖ ≤ C₀ * ‖T‖ ^ 2 * (-Y.im) ^ (1 - 2 * α) ∧
            ‖(T / 2) ^ 2 * Q (S_lim (T, Y)) *
              (deriv (fun Y' : ℂ => S_lim (T, Y')) Y) ^ 2‖ < 2 ∧
            (deriv (fun Y' : ℂ => S_lim (T, Y')) Y) ^ 3 *
              frozenSecondFieldG
                ((T / 2) ^ 2 * Q (S_lim (T, Y)) *
                  (deriv (fun Y' : ℂ => S_lim (T, Y')) Y) ^ 2) = 1) ∧
          (∀ Y : ℂ, D₀ < -Y.im → |Y.re| < A₀ * (-Y.im) → S_lim (0, Y) = Y) ∧
          (∀ K : Set (ℂ × ℂ), IsCompact K →
            K ⊆ { p : ℂ × ℂ | ‖p.1‖ < T₀ ∧ D₀ < -p.2.im ∧ |p.2.re| < A₀ * (-p.2.im) } →
            ∀ ε : ℝ, 0 < ε → ∃ N₁ : ℕ, ∀ n ≥ N₁, ∀ p ∈ K,
              ((ξ_seq n : ℂ) + (S.H : ℂ) * Complex.I + (d_seq n : ℂ) * p.2,
                p.1 * (d_seq n : ℂ) / (B_seq n : ℂ)) ∈ finiteWallTube S.r_star S.h_X →
              ‖(S.𝔰 ((ξ_seq n : ℂ) + (S.H : ℂ) * Complex.I + (d_seq n : ℂ) * p.2,
                  p.1 * (d_seq n : ℂ) / (B_seq n : ℂ)) -
                (ξ_seq n : ℂ) - (S.H : ℂ) * Complex.I) / (d_seq n : ℂ) - S_lim p‖ < ε)

def ExpProfileObstructionProp (S : FiniteWallNonisotropicStrip) : Prop :=
  ∀ x_seq h_seq ℓ_seq m_seq : ℕ → ℝ, ∀ c₀ : ℂ, ∀ α₀ δ_b : ℝ,
    c₀ ≠ 0 → 1 / 2 < α₀ → α₀ < 1 → 0 < δ_b → δ_b < S.H / 2 →
    (∀ n : ℕ, h_seq n < S.H ∧ 0 < ℓ_seq n ∧ 0 < m_seq n) →
    Filter.Tendsto h_seq Filter.atTop (nhds S.H) →
    Filter.Tendsto ℓ_seq Filter.atTop (nhds 0) →
    Filter.Tendsto (fun n => ℓ_seq n * m_seq n) Filter.atTop Filter.atTop →
    Filter.Tendsto (fun n => (S.H - h_seq n) / ℓ_seq n) Filter.atTop Filter.atTop →
    ((TendstoLocallyUniformly
        (fun n Z =>
          ((m_seq n)⁻¹ : ℂ) *
            S.f ((x_seq n : ℂ) + (h_seq n : ℂ) * Complex.I + (ℓ_seq n : ℂ) * Z))
        (fun Z => c₀ * Complex.exp (-Complex.I * Z)) Filter.atTop ∧
      TendstoLocallyUniformly
        (fun n Z =>
          (((m_seq n) ^ 2)⁻¹ : ℂ) *
            S.q ((x_seq n : ℂ) + (h_seq n : ℂ) * Complex.I + (ℓ_seq n : ℂ) * Z))
        (fun _ => 0) Filter.atTop) ∨
     (TendstoLocallyUniformly
        (fun n Z =>
          ((m_seq n)⁻¹ : ℂ) *
            S.f ((x_seq n : ℂ) + (h_seq n : ℂ) * Complex.I + (ℓ_seq n : ℂ) * Z))
        (fun _ => 0) Filter.atTop ∧
      TendstoLocallyUniformly
        (fun n Z =>
          (((m_seq n) ^ 2)⁻¹ : ℂ) *
            S.q ((x_seq n : ℂ) + (h_seq n : ℂ) * Complex.I + (ℓ_seq n : ℂ) * Z))
        (fun Z => c₀ ^ 2 * Complex.exp (-2 * Complex.I * Z)) Filter.atTop)) →
    ¬ (∀ L : ℝ, 0 < L → ∃ C_L : ℝ, 0 < C_L ∧ ∃ N₀ : ℕ, ∀ n ≥ N₀, ∀ s : ℂ,
      ℓ_seq n ≤ h_seq n - s.im → h_seq n - s.im ≤ δ_b →
      |s.re - x_seq n| ≤ L * (h_seq n - s.im) →
      shapeModulus S s ≤ C_L * m_seq n * (ℓ_seq n / (h_seq n - s.im)) ^ α₀)

def EntireExpProfileObstructionProp (E : EntireNonisotropicStrip) : Prop :=
  ∀ x_seq h_seq ℓ_seq m_seq : ℕ → ℝ, ∀ c₀ : ℂ, ∀ α₀ C_ℓ C_cone : ℝ,
    c₀ ≠ 0 → 1 / 2 < α₀ → α₀ < 1 → 0 < C_ℓ → 0 < C_cone →
    (∀ n : ℕ, 0 < h_seq n ∧ 0 < ℓ_seq n ∧ ℓ_seq n ≤ C_ℓ ∧ 0 < m_seq n) →
    Filter.Tendsto h_seq Filter.atTop Filter.atTop →
    Filter.Tendsto (fun n => ℓ_seq n * m_seq n) Filter.atTop Filter.atTop →
    Filter.Tendsto
      (fun n => Real.log (1 + h_seq n / ℓ_seq n) / Real.log (m_seq n))
      Filter.atTop (nhds 0) →
    ((TendstoLocallyUniformly
        (fun n Z =>
          ((m_seq n)⁻¹ : ℂ) *
            E.f ((x_seq n : ℂ) + (h_seq n : ℂ) * Complex.I + (ℓ_seq n : ℂ) * Z))
        (fun Z => c₀ * Complex.exp (-Complex.I * Z)) Filter.atTop ∧
      TendstoLocallyUniformly
        (fun n Z =>
          (((m_seq n) ^ 2)⁻¹ : ℂ) *
            E.q ((x_seq n : ℂ) + (h_seq n : ℂ) * Complex.I + (ℓ_seq n : ℂ) * Z))
        (fun _ => 0) Filter.atTop) ∨
     (TendstoLocallyUniformly
        (fun n Z =>
          ((m_seq n)⁻¹ : ℂ) *
            E.f ((x_seq n : ℂ) + (h_seq n : ℂ) * Complex.I + (ℓ_seq n : ℂ) * Z))
        (fun _ => 0) Filter.atTop ∧
      TendstoLocallyUniformly
        (fun n Z =>
          (((m_seq n) ^ 2)⁻¹ : ℂ) *
            E.q ((x_seq n : ℂ) + (h_seq n : ℂ) * Complex.I + (ℓ_seq n : ℂ) * Z))
        (fun Z => c₀ ^ 2 * Complex.exp (-2 * Complex.I * Z)) Filter.atTop)) →
    ¬ (∃ N₀ : ℕ, ∀ n ≥ N₀, ∀ s : ℂ,
      ℓ_seq n ≤ h_seq n - s.im → h_seq n - s.im ≤ h_seq n →
      max ‖E.f s‖ (Real.sqrt ‖E.q s‖) ≤
        C_cone * m_seq n * (ℓ_seq n / (h_seq n - s.im)) ^ α₀)

def LogDeficitBoundProp (S : FiniteWallNonisotropicStrip) : Prop :=
  ∃ C_def : ℝ, 0 < C_def ∧
    ∀ z₀ : ℂ, ∀ Δ K : ℝ, 0 < Δ →
      Metric.closedBall z₀ Δ ⊆ horizStrip S.H →
      (∀ z ∈ Metric.closedBall z₀ Δ, ‖S.f z‖ ≤ Real.exp K) →
      MeasureTheory.IntegrableOn
        (fun w : ℂ => K - Real.log ‖S.f w‖) (Metric.ball z₀ Δ) MeasureTheory.volume ∧
      ∀ z ∈ Metric.ball z₀ (Δ / 4),
        Δ * Real.sqrt ‖S.q z‖ ≤
          C_def * (1 + (Real.pi * Δ ^ 2)⁻¹ *
            ∫ w in Metric.ball z₀ Δ, (K - Real.log ‖S.f w‖))

def HasFiniteUpperGrowthOrder (S : FiniteWallNonisotropicStrip) : Prop :=
  ∃ P K₀ : ℝ, 1 < P ∧ ∀ k : ℝ, K₀ ≤ k → Real.exp (-k) < S.H →
    ∀ x : ℝ,
      shapeModulus S ((x : ℂ) + ((S.H - Real.exp (-k) : ℝ) : ℂ) * Complex.I) ≤
        Real.exp (P * k)
noncomputable def glancingTheta {Ω : Set Plane} (C : AnalyticGlancingCollar Ω) (y t : ℂ) : ℂ :=
  C.ϕ_ℂ (C.U (y, t))

noncomputable def glancingOffset {Ω : Set Plane} (C : AnalyticGlancingCollar Ω) (y t : ℂ) : ℂ :=
  -supportAction1_ℂ C.h_ℂ (glancingTheta C y t) (glancingTheta C (y + t) t)

noncomputable def glancingDualLine {Ω : Set Plane} (C : AnalyticGlancingCollar Ω) (y t : ℂ) :
    Fin 2 → ℂ :=
  ![Complex.cos (glancingTheta C y t) / glancingOffset C y t,
    Complex.sin (glancingTheta C y t) / glancingOffset C y t]

noncomputable def glancingMidAngle {Ω : Set Plane} (C : AnalyticGlancingCollar Ω) (y t : ℂ) : ℂ :=
  (glancingTheta C (y - t / 2) t + glancingTheta C (y + t / 2) t) / 2

noncomputable def glancingImpact {Ω : Set Plane} (C : AnalyticGlancingCollar Ω) (y t : ℂ) :
    Fin 2 → ℂ :=
  ![C.h_ℂ (glancingMidAngle C y t) * Complex.cos (glancingMidAngle C y t) -
      deriv C.h_ℂ (glancingMidAngle C y t) * Complex.sin (glancingMidAngle C y t),
    C.h_ℂ (glancingMidAngle C y t) * Complex.sin (glancingMidAngle C y t) +
      deriv C.h_ℂ (glancingMidAngle C y t) * Complex.cos (glancingMidAngle C y t)]

noncomputable def glancingBoundaryCurve {Ω : Set Plane} (C : AnalyticGlancingCollar Ω) (s : ℂ) :
    Fin 2 → ℂ :=
  ![C.h_ℂ (C.ϕ_ℂ s) * Complex.cos (C.ϕ_ℂ s) -
      deriv C.h_ℂ (C.ϕ_ℂ s) * Complex.sin (C.ϕ_ℂ s),
    C.h_ℂ (C.ϕ_ℂ s) * Complex.sin (C.ϕ_ℂ s) +
      deriv C.h_ℂ (C.ϕ_ℂ s) * Complex.cos (C.ϕ_ℂ s)]

def horizStripENNR (H : ENNReal) : Set ℂ :=
  { s : ℂ | ENNReal.ofReal |s.im| < H }

def meroTubeENNR (r_base : ℝ) (h_W : ℂ → ENNReal) : Set (ℂ × ℂ) :=
  { p : ℂ × ℂ |
    ‖p.2‖ < r_base ∧
    ENNReal.ofReal (-p.1.im) < h_W (starRingEnd ℂ p.2) ∧
    ENNReal.ofReal p.1.im < h_W p.2 }

structure MeroOn2D (W : Set (ℂ × ℂ)) where
  rad : ℂ × ℂ → ℝ
  num : (ℂ × ℂ) → (ℂ × ℂ → ℂ)
  den : (ℂ × ℂ) → (ℂ × ℂ → ℂ)
  rad_pos : ∀ p ∈ W, 0 < rad p
  ball_sub : ∀ p ∈ W, Metric.ball p (rad p) ⊆ W
  num_holo : ∀ p ∈ W, DifferentiableOn ℂ (num p) (Metric.ball p (rad p))
  den_holo : ∀ p ∈ W, DifferentiableOn ℂ (den p) (Metric.ball p (rad p))
  den_ne_zero : ∀ p ∈ W, ∃ q ∈ Metric.ball p (rad p), den p q ≠ 0
  compat : ∀ p₁ ∈ W, ∀ p₂ ∈ W,
    ∀ q ∈ Metric.ball p₁ (rad p₁) ∩ Metric.ball p₂ (rad p₂),
      num p₁ q * den p₂ q = num p₂ q * den p₁ q

def MeroEqOn {W₁ W₂ : Set (ℂ × ℂ)} (F₁ : MeroOn2D W₁) (F₂ : MeroOn2D W₂)
    (U : Set (ℂ × ℂ)) : Prop :=
  U ⊆ W₁ ∩ W₂ ∧
  ∀ p ∈ U, ∀ q ∈ Metric.ball p (min (F₁.rad p) (F₂.rad p)),
    F₁.num p q * F₂.den p q = F₂.num p q * F₁.den p q

def MeroAgreesHolo {W : Set (ℂ × ℂ)} (F : MeroOn2D W) (f : ℂ × ℂ → ℂ)
    (U : Set (ℂ × ℂ)) : Prop :=
  U ⊆ W ∧
  ∀ p ∈ U, ∃ r : ℝ, 0 < r ∧ r ≤ F.rad p ∧ Metric.ball p r ⊆ U ∧
    ∀ q ∈ Metric.ball p r, F.num p q = f q * F.den p q

noncomputable def iterDerivY : ℕ → (ℂ × ℂ → ℂ) → (ℂ × ℂ → ℂ)
  | 0, f => f
  | m + 1, f => fun p => deriv (fun y' : ℂ => iterDerivY m f (y', p.2)) p.1

noncomputable def iterDerivYT (α β : ℕ) (f : ℂ × ℂ → ℂ) (p : ℂ × ℂ) : ℂ :=
  ((fun g : ℂ → ℂ => deriv g)^[β] (fun t' : ℂ => iterDerivY α f (p.1, t'))) p.2

noncomputable def iterDeriv1D (β : ℕ) (A : ℂ → ℂ) (t : ℂ) : ℂ :=
  ((fun g : ℂ → ℂ => deriv g)^[β] A) t

abbrev LineJetVar (M : ℕ) : Type :=
  Fin 2 × Fin 2 × Fin (M + 1) × Fin (M + 1)

abbrev PointJetVar (M : ℕ) : Type :=
  Sum (Fin 2 × Fin 2 × Fin (M + 1) × Fin (M + 1)) (Fin (M + 1))

noncomputable def lineJetEnv (M : ℕ) (E₀ E₁ : Fin 2 → ℂ × ℂ → ℂ) (p : ℂ × ℂ) :
    LineJetVar M → ℂ :=
  fun v =>
    if v.1 = 0 then
      iterDerivYT v.2.2.1.1 v.2.2.2.1 (E₀ v.2.1) p
    else
      iterDerivYT v.2.2.1.1 v.2.2.2.1 (E₁ v.2.1) p

noncomputable def pointJetEnv (M : ℕ) (P₀ P₁ : Fin 2 → ℂ × ℂ → ℂ) (A : ℂ → ℂ) (p : ℂ × ℂ) :
    PointJetVar M → ℂ
  | Sum.inl v =>
      if v.1 = 0 then
        iterDerivYT v.2.2.1.1 v.2.2.2.1 (P₀ v.2.1) p
      else
        iterDerivYT v.2.2.1.1 v.2.2.2.1 (P₁ v.2.1) p
  | Sum.inr β =>
      iterDeriv1D β.1 A p.2

structure EndpointDeterminationData {Ω : Set Plane} (C : AnalyticGlancingCollar Ω) where
  s_det : ℝ
  r_det : ℝ
  s_det_pos : 0 < s_det
  s_det_le_s₁ : s_det ≤ C.s₁ / 4
  s_det_le_s₀ : s_det ≤ C.s₀ / 2
  r_det_pos : 0 < r_det
  r_det_lt_s_det : r_det < s_det / 4
  r_det_lt_r₁ : r_det < C.r₁ / 2
  offset_ne_zero : ∀ y t : ℂ, |y.im| < 2 * s_det → ‖t‖ < 2 * r_det →
    glancingOffset C y t ≠ 0
  dualLine_holo : ∀ i : Fin 2,
    DifferentiableOn ℂ (fun p : ℂ × ℂ => glancingDualLine C p.1 p.2 i)
      { p : ℂ × ℂ | |p.1.im| < 2 * s_det ∧ ‖p.2‖ < 2 * r_det }
  impact_holo : ∀ i : Fin 2,
    DifferentiableOn ℂ (fun p : ℂ × ℂ => glancingImpact C p.1 p.2 i)
      { p : ℂ × ℂ | |p.1.im| < 2 * s_det ∧ ‖p.2‖ < 2 * r_det }
  line_determination :
    ∀ k : ℕ, 2 ≤ k → ∀ j : ℕ, 0 < j → j < k → ∀ ι : Fin 2,
      ∃ (M D : ℕ) (_hD : 1 ≤ D)
        (Q : Fin (D + 1) → MvPolynomial (LineJetVar M) ℂ)
        (Disc : MvPolynomial (LineJetVar M) ℂ),
        (∀ y t : ℂ, |y.im| < s_det → ‖t‖ < r_det / (k : ℝ) →
          ∑ d : Fin (D + 1),
            MvPolynomial.eval
              (lineJetEnv M
                (fun c q => glancingDualLine C q.1 q.2 c)
                (fun c q => glancingDualLine C (q.1 + (k : ℂ) * q.2) q.2 c)
                (y, t))
              (Q d) *
            (glancingDualLine C (y + (j : ℂ) * t) t ι) ^ (d : ℕ) = 0) ∧
        (∃ y t : ℂ, |y.im| < s_det ∧ ‖t‖ < r_det / (k : ℝ) ∧
          MvPolynomial.eval
            (lineJetEnv M
              (fun c q => glancingDualLine C q.1 q.2 c)
              (fun c q => glancingDualLine C (q.1 + (k : ℂ) * q.2) q.2 c)
              (y, t))
            (Q (Fin.last D)) ≠ 0 ∧
          MvPolynomial.eval
            (lineJetEnv M
              (fun c q => glancingDualLine C q.1 q.2 c)
              (fun c q => glancingDualLine C (q.1 + (k : ℂ) * q.2) q.2 c)
              (y, t))
            Disc ≠ 0) ∧
        (∀ (env : LineJetVar M → ℂ) (z : ℂ),
          MvPolynomial.eval env (Q (Fin.last D)) ≠ 0 →
          MvPolynomial.eval env Disc ≠ 0 →
          ∑ d : Fin (D + 1), MvPolynomial.eval env (Q d) * z ^ (d : ℕ) = 0 →
          ∑ d : Fin D,
            (((d : ℕ) + 1 : ℕ) : ℂ) * MvPolynomial.eval env (Q d.succ) * z ^ (d : ℕ) ≠ 0)
  point_determination :
    ∀ k : ℕ, 2 ≤ k → ∀ j : ℕ, 0 < j → j ≤ k → ∀ ι : Fin 2,
      ∃ (M D : ℕ) (_hD : 1 ≤ D)
        (Q : Fin (D + 1) → MvPolynomial (PointJetVar M) ℂ)
        (Disc : MvPolynomial (PointJetVar M) ℂ),
        (∀ y t : ℂ, |y.im| < s_det → ‖t‖ < r_det / ((k : ℝ) + 1) →
          ∑ d : Fin (D + 1),
            MvPolynomial.eval
              (pointJetEnv M
                (fun c q => glancingImpact C q.1 q.2 c)
                (fun c q => glancingImpact C (q.1 + (k : ℂ) * q.2) q.2 c)
                C.A (y, t))
              (Q d) *
            (glancingDualLine C (y + ((j : ℂ) - 1 / 2) * t) t ι) ^ (d : ℕ) = 0) ∧
        (∃ y t : ℂ, |y.im| < s_det ∧ ‖t‖ < r_det / ((k : ℝ) + 1) ∧
          MvPolynomial.eval
            (pointJetEnv M
              (fun c q => glancingImpact C q.1 q.2 c)
              (fun c q => glancingImpact C (q.1 + (k : ℂ) * q.2) q.2 c)
              C.A (y, t))
            (Q (Fin.last D)) ≠ 0 ∧
          MvPolynomial.eval
            (pointJetEnv M
              (fun c q => glancingImpact C q.1 q.2 c)
              (fun c q => glancingImpact C (q.1 + (k : ℂ) * q.2) q.2 c)
              C.A (y, t))
            Disc ≠ 0) ∧
        (∀ (env : PointJetVar M → ℂ) (z : ℂ),
          MvPolynomial.eval env (Q (Fin.last D)) ≠ 0 →
          MvPolynomial.eval env Disc ≠ 0 →
          ∑ d : Fin (D + 1), MvPolynomial.eval env (Q d) * z ^ (d : ℕ) = 0 →
          ∑ d : Fin D,
            (((d : ℕ) + 1 : ℕ) : ℂ) * MvPolynomial.eval env (Q d.succ) * z ^ (d : ℕ) ≠ 0)

structure MeromorphicCollarData {Ω : Set Plane} (C : AnalyticGlancingCollar Ω) where
  s_base : ℝ
  r_base : ℝ
  s_base_pos : 0 < s_base
  s_base_le_s₁ : s_base ≤ C.s₁ / 4
  s_base_le_s₀ : s_base ≤ C.s₀ / 2
  r_base_pos : 0 < r_base
  r_base_lt_s_base : r_base < s_base / 4
  r_base_lt_r₁ : r_base < C.r₁ / 2
  r_base_lt_pi : r_base < Real.pi
  offset_ne_zero : ∀ y t : ℂ, |y.im| < 2 * s_base → ‖t‖ < 2 * r_base →
    glancingOffset C y t ≠ 0
  h_X : ℂ → ENNReal
  h_L : ℂ → ENNReal
  h_X_ge : ∀ t ∈ Metric.ball (0 : ℂ) r_base, ENNReal.ofReal s_base ≤ h_X t
  h_L_eq : ∀ t ∈ Metric.ball (0 : ℂ) r_base,
    h_L t = h_X t + ENNReal.ofReal (|t.im| / 2)
  h_X_even : ∀ t ∈ Metric.ball (0 : ℂ) r_base, h_X (-t) = h_X t
  h_L_even : ∀ t ∈ Metric.ball (0 : ℂ) r_base, h_L (-t) = h_L t
  h_X_lsc : LowerSemicontinuousOn h_X (Metric.ball (0 : ℂ) r_base)
  h_L_lsc : LowerSemicontinuousOn h_L (Metric.ball (0 : ℂ) r_base)
  h_X_supermean : ∀ (t₀ : ℂ) (ρ : ℝ), 0 < ρ → ‖t₀‖ + ρ < r_base →
    ∀ q : ℝ → ℝ, Continuous q → Function.Periodic q (2 * Real.pi) →
      (∀ θ : ℝ, 0 ≤ q θ ∧
        ENNReal.ofReal (q θ) < h_X (t₀ + (ρ : ℂ) * Complex.exp ((θ : ℂ) * Complex.I))) →
      ENNReal.ofReal ((2 * Real.pi)⁻¹ * ∫ θ in (0 : ℝ)..(2 * Real.pi), q θ) ≤ h_X t₀
  L_mero : Fin 2 → MeroOn2D (meroTubeENNR r_base h_L)
  X_mero : Fin 2 → MeroOn2D (meroTubeENNR r_base h_X)
  L_agrees : ∀ i : Fin 2,
    MeroAgreesHolo (L_mero i) (fun p => glancingDualLine C p.1 p.2 i)
      { p : ℂ × ℂ | |p.1.im| < s_base ∧ ‖p.2‖ < r_base }
  X_agrees : ∀ i : Fin 2,
    MeroAgreesHolo (X_mero i) (fun p => glancingImpact C p.1 p.2 i)
      { p : ℂ × ℂ | |p.1.im| < s_base ∧ ‖p.2‖ < r_base }
  no_patch_X_at_real : ∀ t₀ x₀ H₁ ε : ℝ,
    |t₀| < r_base → h_X (t₀ : ℂ) = ENNReal.ofReal H₁ → 0 < ε → ε < s_base →
    ¬ ∃ g : Fin 2 → MeroOn2D
        { p : ℂ × ℂ |
          ‖p.1 - ((x₀ : ℂ) + (H₁ : ℂ) * Complex.I)‖ < ε ∧
          ‖p.2 - (t₀ : ℂ)‖ < ε },
      ∃ δ : ℝ, 0 < δ ∧ δ ≤ ε ∧
        ∀ i : Fin 2, MeroEqOn (g i) (X_mero i)
          { p : ℂ × ℂ |
            |p.1.re - x₀| < ε / 4 ∧
            |p.1.im - (H₁ - ε / 2)| < ε / 4 ∧
            ‖p.2 - (t₀ : ℂ)‖ < δ }
  no_patch_L_at_real : ∀ t₀ x₀ H₁ ε : ℝ,
    |t₀| < r_base → h_L (t₀ : ℂ) = ENNReal.ofReal H₁ → 0 < ε → ε < s_base →
    ¬ ∃ g : Fin 2 → MeroOn2D
        { p : ℂ × ℂ |
          ‖p.1 - ((x₀ : ℂ) + (H₁ : ℂ) * Complex.I)‖ < ε ∧
          ‖p.2 - (t₀ : ℂ)‖ < ε },
      ∃ δ : ℝ, 0 < δ ∧ δ ≤ ε ∧
        ∀ i : Fin 2, MeroEqOn (g i) (L_mero i)
          { p : ℂ × ℂ |
            |p.1.re - x₀| < ε / 4 ∧
            |p.1.im - (H₁ - ε / 2)| < ε / 4 ∧
            ‖p.2 - (t₀ : ℂ)‖ < δ }
  mero_disk_continuation :
    ∀ (r_w ρ R : ℝ) (w₀ : ℂ) (r₀ : ℝ),
      0 < r_w → 0 < ρ → ρ < R → 0 < r₀ →
      Metric.ball w₀ r₀ ⊆ Metric.ball (0 : ℂ) r_w →
      ∀ (F : MeroOn2D (Metric.ball (0 : ℂ) r_w ×ˢ { ζ : ℂ | ρ < ‖ζ‖ ∧ ‖ζ‖ < R }))
        (F₀ : MeroOn2D (Metric.ball w₀ r₀ ×ˢ Metric.ball (0 : ℂ) R)),
        MeroEqOn F F₀ (Metric.ball w₀ r₀ ×ˢ { ζ : ℂ | ρ < ‖ζ‖ ∧ ‖ζ‖ < R }) →
        ∃ F_ext : MeroOn2D (Metric.ball (0 : ℂ) r_w ×ˢ Metric.ball (0 : ℂ) R),
          MeroEqOn F_ext F (Metric.ball (0 : ℂ) r_w ×ˢ { ζ : ℂ | ρ < ‖ζ‖ ∧ ‖ζ‖ < R })
  Γ_slice : ℂ → (Fin 2 → ℂ)
  a_mero : ℂ → ℂ
  f_mero : ℂ → ℂ
  E_disc : Set ℂ
  E_disc_sub : E_disc ⊆ horizStripENNR (h_X 0)
  E_disc_base_disjoint : ∀ s ∈ horizStrip s_base, s ∉ E_disc
  E_disc_isolated : ∀ s ∈ horizStripENNR (h_X 0),
    ∃ r : ℝ, 0 < r ∧ Metric.ball s r ⊆ horizStripENNR (h_X 0) ∧
      ∀ z ∈ Metric.ball s r, z ≠ s → z ∉ E_disc
  Γ_mero : MeromorphicOn (fun s => Γ_slice s 0) (horizStripENNR (h_X 0)) ∧
    MeromorphicOn (fun s => Γ_slice s 1) (horizStripENNR (h_X 0))
  a_mero_mero : MeromorphicOn a_mero (horizStripENNR (h_X 0))
  f_mero_mero : MeromorphicOn f_mero (horizStripENNR (h_X 0))
  slice_base_eq : ∀ s ∈ horizStrip s_base,
    Γ_slice s = glancingBoundaryCurve C s ∧
    a_mero s = Complex.exp (Complex.I * C.ϕ_ℂ s) ∧
    f_mero s = deriv C.ϕ_ℂ s
  slice_reg : ∀ s ∈ horizStripENNR (h_X 0), s ∉ E_disc →
    AnalyticAt ℂ (fun z => Γ_slice z 0) s ∧
    AnalyticAt ℂ (fun z => Γ_slice z 1) s ∧
    AnalyticAt ℂ a_mero s ∧
    AnalyticAt ℂ f_mero s ∧
    a_mero s ≠ 0 ∧
    f_mero s ≠ 0 ∧
    deriv (fun z => Γ_slice z 0) s + Complex.I * deriv (fun z => Γ_slice z 1) s =
      Complex.I * C.c * a_mero s / (f_mero s) ^ 2 ∧
    deriv (fun z => Γ_slice z 0) s - Complex.I * deriv (fun z => Γ_slice z 1) s =
      -Complex.I * C.c / (a_mero s * (f_mero s) ^ 2) ∧
    deriv a_mero s = Complex.I * f_mero s * a_mero s ∧
    ∃ (r_s : ℝ) (X_loc : Fin 2 → ℂ × ℂ → ℂ),
      0 < r_s ∧
      Metric.ball (s, (0 : ℂ)) r_s ⊆ meroTubeENNR r_base h_X ∧
      (∀ z ∈ Metric.ball s r_s, z ∈ horizStripENNR (h_X 0) ∧ z ∉ E_disc) ∧
      (∀ i : Fin 2, DifferentiableOn ℂ (X_loc i) (Metric.ball (s, (0 : ℂ)) r_s)) ∧
      (∀ i : Fin 2, MeroAgreesHolo (X_mero i) (X_loc i) (Metric.ball (s, (0 : ℂ)) r_s)) ∧
      (∀ i : Fin 2, ∀ z ∈ Metric.ball s r_s, X_loc i (z, 0) = Γ_slice z i)
  no_1d_patch_Γ : ∀ (H₀ x_star sgn ε : ℝ),
    h_X 0 = ENNReal.ofReal H₀ → (sgn = 1 ∨ sgn = -1) → 0 < ε →
    ¬ ∃ g : Fin 2 → ℂ → ℂ,
      MeromorphicOn (g 0)
        (Metric.ball ((x_star : ℂ) + ((sgn * H₀ : ℝ) : ℂ) * Complex.I) ε) ∧
      MeromorphicOn (g 1)
        (Metric.ball ((x_star : ℂ) + ((sgn * H₀ : ℝ) : ℂ) * Complex.I) ε) ∧
      ∃ V_overlap : Set ℂ,
        IsOpen V_overlap ∧ V_overlap.Nonempty ∧
        V_overlap ⊆
          Metric.ball ((x_star : ℂ) + ((sgn * H₀ : ℝ) : ℂ) * Complex.I) ε ∩
            horizStrip H₀ ∧
        ∀ i : Fin 2, ∀ z ∈ V_overlap, g i z = Γ_slice z i

def HasIsotropicCenter {Ω : Set Plane} {C : AnalyticGlancingCollar Ω}
    (M : MeromorphicCollarData C) : Prop :=
  ∃ p ∈ horizStripENNR (M.h_X 0),
    ∃ (n : ℤ) (u : ℂ → ℂ),
      n ≠ 0 ∧ AnalyticAt ℂ u p ∧ u p ≠ 0 ∧
      ∀ᶠ z in nhdsWithin p {p}ᶜ, M.a_mero z = (z - p) ^ n * u z
noncomputable def signTestH1 (K : ℝ) : ℝ :=
  (1 / 2 : ℝ) * K ^ (1 / 200 : ℝ)

noncomputable def robustDiskRadius (K k : ℝ) : ℝ :=
  Real.exp (-k - signTestH1 K / 4)

noncomputable def upperRowPt (S : FiniteWallNonisotropicStrip) (k x : ℝ) : ℂ :=
  (x : ℂ) + ((S.H - Real.exp (-k) : ℝ) : ℂ) * Complex.I

noncomputable def lowerRowPt (S : FiniteWallNonisotropicStrip) (k x : ℝ) : ℂ :=
  (x : ℂ) - ((S.H - Real.exp (-k) : ℝ) : ℂ) * Complex.I

def HasRobustSignDisk (S : FiniteWallNonisotropicStrip) (K k x : ℝ) : Prop :=
  ((∀ ζ ∈ Metric.closedBall (upperRowPt S k x) (3 * robustDiskRadius K k),
      ‖S.f ζ‖ ≤ Real.exp (-signTestH1 K)) ∨
    (∀ ζ ∈ Metric.closedBall (upperRowPt S k x) (3 * robustDiskRadius K k),
      Real.exp (signTestH1 K) ≤ ‖S.f ζ‖)) ∧
  ((∀ ζ ∈ Metric.closedBall (lowerRowPt S k x) (3 * robustDiskRadius K k),
      ‖S.f ζ‖ ≤ Real.exp (-signTestH1 K)) ∨
    (∀ ζ ∈ Metric.closedBall (lowerRowPt S k x) (3 * robustDiskRadius K k),
      Real.exp (signTestH1 K) ≤ ‖S.f ζ‖))

def cycNext (N : ℕ) [NeZero N] (j : Fin N) : Fin N :=
  ⟨(j.val + 1) % N, Nat.mod_lt _ (NeZero.pos N)⟩

def cycPrev (N : ℕ) [NeZero N] (j : Fin N) : Fin N :=
  ⟨(j.val + N - 1) % N, Nat.mod_lt _ (NeZero.pos N)⟩

noncomputable def jacobiM0 (N : ℕ) [NeZero N] (ℓ_vec : Fin N → ℂ) : Matrix (Fin N) (Fin N) ℂ :=
  Matrix.of fun i k =>
    (if i = k then (ℓ_vec (cycPrev N i))⁻¹ + (ℓ_vec i)⁻¹ else 0) +
    (if k = cycNext N i then (ℓ_vec i)⁻¹ else 0) +
    (if i = cycNext N k then (ℓ_vec k)⁻¹ else 0)

noncomputable def jacobiVDiag (N : ℕ) (c : ℝ) (f_vec d0_vec : Fin N → ℂ) (j : Fin N) : ℂ :=
  2 * (f_vec j) ^ 3 / ((c : ℂ) * Complex.sin (d0_vec j))

noncomputable def jacobiH (N : ℕ) [NeZero N] (c : ℝ) (f_vec d0_vec ℓ_vec : Fin N → ℂ) :
    Matrix (Fin N) (Fin N) ℂ :=
  jacobiM0 N ℓ_vec - Matrix.diagonal (jacobiVDiag N c f_vec d0_vec)

noncomputable def modifiedJacobiB (N : ℕ) [NeZero N] (c : ℝ)
    (f_vec d0_vec ℓ_vec : Fin N → ℂ) (I F : Finset (Fin N)) : Matrix (Fin N) (Fin N) ℂ :=
  Matrix.of fun i k =>
    if i ∈ I ∪ F ∧ k ∈ I ∪ F then
      jacobiM0 N ℓ_vec i k - (if i = k ∧ i ∈ I then jacobiVDiag N c f_vec d0_vec i else 0)
    else if i = k then 1 else 0

noncomputable def jacobiNullVec (N : ℕ) (c : ℝ) (f_vec d0_vec sp_vec : Fin N → ℂ)
    (j : Fin N) : ℂ :=
  (c : ℂ) * Complex.sin (d0_vec j) * (f_vec j)⁻¹ ^ 2 * sp_vec j

noncomputable def sliceParamT0 (N : ℕ) : ℝ :=
  2 * Real.pi / (N : ℝ)

noncomputable def sliceHeight (S : FiniteWallNonisotropicStrip) (N : ℕ) : ℝ :=
  S.h_X (sliceParamT0 N : ℂ)

noncomputable def sliceImpactSeq (S : FiniteWallNonisotropicStrip) (N : ℕ)
    (j : ℤ) (y : ℂ) : ℂ :=
  S.𝔰 (y + (j : ℂ) * (sliceParamT0 N : ℂ), (sliceParamT0 N : ℂ))

noncomputable def sliceAngleSeq (S : FiniteWallNonisotropicStrip) (N : ℕ)
    (j : ℤ) (y : ℂ) : ℂ :=
  S.ϕ (sliceImpactSeq S N j y)

noncomputable def sliceSpeedSeq (S : FiniteWallNonisotropicStrip) (N : ℕ)
    (j : ℤ) (y : ℂ) : ℂ :=
  S.f (sliceImpactSeq S N j y)

noncomputable def sliceSupportSeq (S : FiniteWallNonisotropicStrip) (N : ℕ)
    (j : ℤ) (y : ℂ) : ℂ :=
  S.H0 (sliceImpactSeq S N j y)

noncomputable def slicePosSeq (S : FiniteWallNonisotropicStrip) (N : ℕ)
    (j : ℤ) (y : ℂ) : Fin 2 → ℂ :=
  S.Γ (sliceImpactSeq S N j y)

structure OddPeriodicSliceData (S : FiniteWallNonisotropicStrip) where
  N : ℕ
  instNeZero : NeZero N
  N_odd : Odd N
  N_ge_three : 3 ≤ N
  t₀_lt_r_star : sliceParamT0 N < S.r_star
  θ_seq : ℤ → ℂ → ℂ
  θ_holo : ∀ j : ℤ, DifferentiableOn ℂ (θ_seq j) (horizStrip (sliceHeight S N))
  θ_quasiperiodic : ∀ j : ℤ, ∀ y ∈ horizStrip (sliceHeight S N),
    θ_seq j (y + 2 * Real.pi) = θ_seq j y + 2 * Real.pi
  θ_shift_N : ∀ j : ℤ, ∀ y ∈ horizStrip (sliceHeight S N),
    θ_seq (j + (N : ℤ)) y = θ_seq j y + 2 * Real.pi
  θ_conj : ∀ j : ℤ, ∀ y ∈ horizStrip (sliceHeight S N),
    θ_seq j (starRingEnd ℂ y) = starRingEnd ℂ (θ_seq j y)
  θ_sum : ∀ j : ℤ, ∀ y ∈ horizStrip (sliceHeight S N),
    θ_seq (j - 1) y + θ_seq j y = 2 * sliceAngleSeq S N j y
  θ_real : ∀ j : ℤ, ∀ x : ℝ,
    θ_seq j x =
      S.Θ_gl ((x : ℂ) + ((((j : ℝ) + 1 / 2) * sliceParamT0 N : ℝ) : ℂ), (sliceParamT0 N : ℂ))
  ℓ_num : Fin N → ℂ → ℂ
  ℓ_num_holo : ∀ j : Fin N, DifferentiableOn ℂ (ℓ_num j) (horizStrip (sliceHeight S N))
  ℓ_num_periodic : ∀ j : Fin N, ∀ y ∈ horizStrip (sliceHeight S N),
    ℓ_num j (y + 2 * Real.pi) = ℓ_num j y
  ℓ_real : ∀ j : Fin N, ∀ x : ℝ,
    ℓ_num j x / (sliceSpeedSeq S N j.val x * sliceSpeedSeq S N ((j.val : ℤ) + 1) x) =
      (S.ℓ_chord (x + (j.val : ℝ) * sliceParamT0 N) (sliceParamT0 N) : ℂ)
  C_rec : ℝ
  C_rec_pos : 0 < C_rec
  Z_all : Set ℂ
  Z_all_subset : Z_all ⊆ horizStrip (sliceHeight S N)
  reg_open : IsOpen (horizStrip (sliceHeight S N) \ Z_all)
  real_not_mem_Z_all : ∀ x : ℝ, (x : ℂ) ∉ Z_all
  Z_all_periodic : ∀ y : ℂ, y ∈ Z_all ↔ y + 2 * Real.pi ∈ Z_all
  Z_all_compact_finite : ∀ ε : ℝ, 0 < ε → ε < sliceHeight S N →
    (Z_all ∩ {y : ℂ | y.re ∈ Set.Icc (0 : ℝ) (2 * Real.pi) ∧ |y.im| ≤ sliceHeight S N - ε}).Finite
  reg_speed_ne_zero : ∀ y ∈ horizStrip (sliceHeight S N) \ Z_all, ∀ j : Fin N,
    sliceSpeedSeq S N j.val y ≠ 0
  reg_sin_d0_ne_zero : ∀ y ∈ horizStrip (sliceHeight S N) \ Z_all, ∀ j : Fin N,
    Complex.sin (θ_seq j.val y - sliceAngleSeq S N j.val y) ≠ 0
  reg_chord_ne_zero : ∀ y ∈ horizStrip (sliceHeight S N) \ Z_all, ∀ j : Fin N,
    ℓ_num j y / (sliceSpeedSeq S N j.val y * sliceSpeedSeq S N ((j.val : ℤ) + 1) y) ≠ 0
  reg_chord_vec : ∀ y ∈ horizStrip (sliceHeight S N) \ Z_all, ∀ j : Fin N,
    slicePosSeq S N ((j.val : ℤ) + 1) y 0 - slicePosSeq S N j.val y 0 =
      -(ℓ_num j y / (sliceSpeedSeq S N j.val y * sliceSpeedSeq S N ((j.val : ℤ) + 1) y)) *
        Complex.sin (θ_seq j.val y) ∧
    slicePosSeq S N ((j.val : ℤ) + 1) y 1 - slicePosSeq S N j.val y 1 =
      (ℓ_num j y / (sliceSpeedSeq S N j.val y * sliceSpeedSeq S N ((j.val : ℤ) + 1) y)) *
        Complex.cos (θ_seq j.val y)
  reg_deriv_pos : ∀ y ∈ horizStrip (sliceHeight S N) \ Z_all, ∀ j : Fin N,
    deriv (fun z => slicePosSeq S N j.val z 0) y =
      -(S.c : ℂ) * (sliceSpeedSeq S N j.val y)⁻¹ ^ 2 *
        Complex.sin (sliceAngleSeq S N j.val y) * deriv (sliceImpactSeq S N j.val) y ∧
    deriv (fun z => slicePosSeq S N j.val z 1) y =
      (S.c : ℂ) * (sliceSpeedSeq S N j.val y)⁻¹ ^ 2 *
        Complex.cos (sliceAngleSeq S N j.val y) * deriv (sliceImpactSeq S N j.val) y
  reg_deriv_support : ∀ y ∈ horizStrip (sliceHeight S N) \ Z_all, ∀ j : Fin N,
    deriv (sliceSupportSeq S N j.val) y =
      (-slicePosSeq S N j.val y 0 * Complex.sin (sliceAngleSeq S N j.val y) +
        slicePosSeq S N j.val y 1 * Complex.cos (sliceAngleSeq S N j.val y)) *
      deriv (sliceAngleSeq S N j.val) y
  pos_reconstruction : ∀ y ∈ horizStrip (sliceHeight S N) \ Z_all,
    ∀ B_ang B_sup : ℝ, 0 ≤ B_ang → 0 ≤ B_sup →
      (∀ k : Fin N, ‖sliceAngleSeq S N k.val y‖ +
        |Real.log ‖Complex.sin (θ_seq k.val y - sliceAngleSeq S N k.val y)‖| ≤ B_ang) →
      (∀ k : Fin N, ‖sliceSupportSeq S N k.val y‖ ≤ B_sup) →
      ∀ j : Fin N, ‖slicePosSeq S N j.val y‖ ≤ C_rec * Real.exp (C_rec * B_ang) * B_sup
  jacobi_null : ∀ y ∈ horizStrip (sliceHeight S N) \ Z_all,
    (@jacobiH N instNeZero S.c
      (fun j => sliceSpeedSeq S N j.val y)
      (fun j => θ_seq j.val y - sliceAngleSeq S N j.val y)
      (fun j => ℓ_num j y /
        (sliceSpeedSeq S N j.val y * sliceSpeedSeq S N ((j.val : ℤ) + 1) y))).mulVec
      (jacobiNullVec N S.c
        (fun j => sliceSpeedSeq S N j.val y)
        (fun j => θ_seq j.val y - sliceAngleSeq S N j.val y)
        (fun j => deriv (sliceImpactSeq S N j.val) y)) = 0
  jacobi_M0_mulVec : ∀ y ∈ horizStrip (sliceHeight S N) \ Z_all, ∀ j : Fin N,
    2 * sliceSpeedSeq S N j.val y * deriv (sliceImpactSeq S N j.val) y =
      (@jacobiM0 N instNeZero
        (fun i => ℓ_num i y /
          (sliceSpeedSeq S N i.val y * sliceSpeedSeq S N ((i.val : ℤ) + 1) y))).mulVec
        (jacobiNullVec N S.c
          (fun i => sliceSpeedSeq S N i.val y)
          (fun i => θ_seq i.val y - sliceAngleSeq S N i.val y)
          (fun i => deriv (sliceImpactSeq S N i.val) y)) j
  modified_det_ne_zero : ∀ y ∈ horizStrip (sliceHeight S N) \ Z_all,
    ∀ I F : Finset (Fin N), I ⊂ Finset.univ → Disjoint I F →
      (@modifiedJacobiB N instNeZero S.c
        (fun i => sliceSpeedSeq S N i.val y)
        (fun i => θ_seq i.val y - sliceAngleSeq S N i.val y)
        (fun i => ℓ_num i y /
          (sliceSpeedSeq S N i.val y * sliceSpeedSeq S N ((i.val : ℤ) + 1) y))
        I F).det ≠ 0
  cofactor_norm : ∀ y ∈ horizStrip (sliceHeight S N) \ Z_all, ∀ j : Fin N,
    (jacobiNullVec N S.c
      (fun i => sliceSpeedSeq S N i.val y)
      (fun i => θ_seq i.val y - sliceAngleSeq S N i.val y)
      (fun i => deriv (sliceImpactSeq S N i.val) y) j) ^ 2 =
    (-1 : ℂ) ^ (N - 1) * (S.A (sliceParamT0 N : ℂ) / (N : ℂ)) *
      (∏ i : Fin N, (ℓ_num i y /
        (sliceSpeedSeq S N i.val y * sliceSpeedSeq S N ((i.val : ℤ) + 1) y))) *
      (@modifiedJacobiB N instNeZero S.c
        (fun i => sliceSpeedSeq S N i.val y)
        (fun i => θ_seq i.val y - sliceAngleSeq S N i.val y)
        (fun i => ℓ_num i y /
          (sliceSpeedSeq S N i.val y * sliceSpeedSeq S N ((i.val : ℤ) + 1) y))
        (Finset.univ.erase j) ∅).det
  boundary_contact : ∀ᵐ x : ℝ ∂MeasureTheory.volume,
    ∀ sgn : ℝ, (sgn = 1 ∨ sgn = -1) →
      ∃ s_lim : Fin N → ℂ,
        (∀ A_cone : ℝ, 0 < A_cone → ∀ j : Fin N,
          Filter.Tendsto (sliceImpactSeq S N j.val)
            (nhdsWithin ((x : ℂ) + ((sgn * sliceHeight S N : ℝ) : ℂ) * Complex.I)
              {y : ℂ | y ∈ horizStrip (sliceHeight S N) ∧
                |y.re - x| ≤ A_cone * (sliceHeight S N - |y.im|)})
            (nhds (s_lim j))) ∧
        ∃ j : Fin N, |(s_lim j).im| = S.H

instance instNeZeroOddSliceN (S : FiniteWallNonisotropicStrip) (P : OddPeriodicSliceData S) :
    NeZero P.N :=
  P.instNeZero

noncomputable def OddPeriodicSliceData.d0 {S : FiniteWallNonisotropicStrip}
    (P : OddPeriodicSliceData S) (j : Fin P.N) (y : ℂ) : ℂ :=
  P.θ_seq j.val y - sliceAngleSeq S P.N j.val y

noncomputable def OddPeriodicSliceData.ℓ_slice {S : FiniteWallNonisotropicStrip}
    (P : OddPeriodicSliceData S) (j : Fin P.N) (y : ℂ) : ℂ :=
  P.ℓ_num j y / (sliceSpeedSeq S P.N j.val y * sliceSpeedSeq S P.N ((j.val : ℤ) + 1) y)

noncomputable def OddPeriodicSliceData.B_mat {S : FiniteWallNonisotropicStrip}
    (P : OddPeriodicSliceData S) (I F : Finset (Fin P.N)) (y : ℂ) :
    Matrix (Fin P.N) (Fin P.N) ℂ :=
  modifiedJacobiB P.N S.c
    (fun i => sliceSpeedSeq S P.N i.val y)
    (fun i => P.d0 i y)
    (fun i => P.ℓ_slice i y) I F

noncomputable def OddPeriodicSliceData.w_vec {S : FiniteWallNonisotropicStrip}
    (P : OddPeriodicSliceData S) (y : ℂ) : Fin P.N → ℂ :=
  jacobiNullVec P.N S.c
    (fun i => sliceSpeedSeq S P.N i.val y)
    (fun i => P.d0 i y)
    (fun i => deriv (sliceImpactSeq S P.N i.val) y)

noncomputable def unifTwoPiMeasure : MeasureTheory.Measure ℝ :=
  (ENNReal.ofReal (2 * Real.pi))⁻¹ •
    MeasureTheory.volume.restrict (Set.Ico (0 : ℝ) (2 * Real.pi))

abbrev WalkSpace : Type := ℕ → ℝ

noncomputable def walkMeasure : MeasureTheory.Measure WalkSpace :=
  MeasureTheory.Measure.infinitePi (fun _ : ℕ => unifTwoPiMeasure)

noncomputable def walkPos (ρ : ℂ → ℝ) (om : WalkSpace) : ℕ → ℂ
  | 0 => (om 0 : ℂ)
  | m + 1 =>
      walkPos ρ om m + (ρ (walkPos ρ om m) : ℂ) * Complex.exp ((om (m + 1) : ℂ) * Complex.I)

noncomputable def sliceShapeDepth (S : FiniteWallNonisotropicStrip) (P : OddPeriodicSliceData S)
    (j : Fin P.N) (y : ℂ) : ℝ :=
  S.H - |(sliceImpactSeq S P.N j.val y).im|

noncomputable def sliceLogDepth (S : FiniteWallNonisotropicStrip) (P : OddPeriodicSliceData S)
    (j : Fin P.N) (y : ℂ) : ℝ :=
  -Real.log (sliceShapeDepth S P j y)

noncomputable def sliceGeomCost (S : FiniteWallNonisotropicStrip) (P : OddPeriodicSliceData S)
    (y : ℂ) : ℝ :=
  Finset.univ.sup' Finset.univ_nonempty fun j : Fin P.N =>
    ‖sliceAngleSeq S P.N j.val y‖ +
      Real.log (1 + ‖slicePosSeq S P.N j.val y‖) +
      |Real.log ‖Complex.sin (P.d0 j y)‖| +
      |Real.log ‖P.ℓ_slice j y‖|

noncomputable def sliceHistory (S : FiniteWallNonisotropicStrip) (P : OddPeriodicSliceData S)
    (ρ : ℂ → ℝ) (om : WalkSpace) (j : Fin P.N) (m : ℕ) : ℝ :=
  (Finset.range (m + 1)).sup' ⟨0, Finset.mem_range.mpr (Nat.zero_lt_succ m)⟩ fun n =>
    sliceLogDepth S P j (walkPos ρ om n)

noncomputable def sliceStopTau (S : FiniteWallNonisotropicStrip) (P : OddPeriodicSliceData S)
    (ρ : ℂ → ℝ) (L : ℝ) (om : WalkSpace) : ℕ :=
  @dite _
    (∃ m : ℕ, L ≤ Finset.univ.sup' Finset.univ_nonempty (fun j => sliceHistory S P ρ om j m))
    (Classical.propDecidable _)
    (fun h => @Nat.find _ (Classical.decPred _) h)
    (fun _ => 0)

noncomputable def sliceFirstHit (S : FiniteWallNonisotropicStrip) (P : OddPeriodicSliceData S)
    (ρ : ℂ → ℝ) (L d : ℝ) (j : Fin P.N) (om : WalkSpace) : ℕ :=
  @Nat.find
    (fun m : ℕ =>
      sliceStopTau S P ρ L om ≤ m ∨ sliceShapeDepth S P j (walkPos ρ om m) ≤ d)
    (Classical.decPred _)
    ⟨sliceStopTau S P ρ L om, Or.inl le_rfl⟩

noncomputable def sliceLastFirstHit (S : FiniteWallNonisotropicStrip) (P : OddPeriodicSliceData S)
    (ρ : ℂ → ℝ) (L d : ℝ) (J : Finset (Fin P.N)) (hJ : J.Nonempty) (om : WalkSpace) : ℕ :=
  J.sup' hJ fun j => sliceFirstHit S P ρ L d j om

noncomputable def sliceDiskExit (S : FiniteWallNonisotropicStrip) (P : OddPeriodicSliceData S)
    (ρ : ℂ → ℝ) (L d r_exit : ℝ) (J : Finset (Fin P.N)) (hJ : J.Nonempty) (i : Fin P.N)
    (om : WalkSpace) : ℕ :=
  @Nat.find
    (fun m : ℕ =>
      sliceLastFirstHit S P ρ L d J hJ om ≤ m ∧
        (sliceStopTau S P ρ L om ≤ m ∨
          r_exit < ‖sliceImpactSeq S P.N i.val (walkPos ρ om m) -
            sliceImpactSeq S P.N i.val (walkPos ρ om (sliceLastFirstHit S P ρ L d J hJ om))‖))
    (Classical.decPred _)
    ⟨max (sliceLastFirstHit S P ρ L d J hJ om) (sliceStopTau S P ρ L om),
      le_max_left _ _, Or.inl (le_max_right _ _)⟩

structure StoppedSliceGeometryData (S : FiniteWallNonisotropicStrip)
    (P : OddPeriodicSliceData S) where
  stepRadius : ℝ → ℂ → ℝ
  L_min : ℝ
  C_inv : ℝ
  C_hit : ℝ
  C_clk : ℝ
  C_rem : ℝ
  L_min_ge_two : 2 ≤ L_min
  C_inv_pos : 0 < C_inv
  C_hit_pos : 0 < C_hit
  C_clk_pos : 0 < C_clk
  C_rem_pos : 0 < C_rem
  stepRadius_measurable : ∀ L : ℝ, Measurable (stepRadius L)
  walk_in_reg_domain : ∀ L : ℝ, L_min ≤ L → ∀ om : WalkSpace, ∀ m : ℕ,
    walkPos (stepRadius L) om m ∈ horizStrip (sliceHeight S P.N) \ P.Z_all ∧
    0 < stepRadius L (walkPos (stepRadius L) om m)
  walk_small_step : ∀ L : ℝ, L_min ≤ L → ∀ om : WalkSpace, ∀ m : ℕ,
    m < sliceStopTau S P (stepRadius L) L om → ∀ j : Fin P.N,
      ‖sliceImpactSeq S P.N j.val (walkPos (stepRadius L) om (m + 1)) -
        sliceImpactSeq S P.N j.val (walkPos (stepRadius L) om m)‖ ≤
      Real.exp (-L ^ 2) * sliceShapeDepth S P j (walkPos (stepRadius L) om m)
  walk_stops_ae : ∀ L : ℝ, L_min ≤ L →
    ∀ᵐ om : WalkSpace ∂walkMeasure,
      ∃ m : ℕ, L ≤ Finset.univ.sup' Finset.univ_nonempty
        (fun j => sliceHistory S P (stepRadius L) om j m)
  walk_clock_bound : ∀ L : ℝ, L_min ≤ L →
    MeasureTheory.Integrable
      (fun om : WalkSpace => ∑ m ∈ Finset.range (sliceStopTau S P (stepRadius L) L om),
        (stepRadius L (walkPos (stepRadius L) om m)) ^ 2) walkMeasure ∧
    (∫ om, (∑ m ∈ Finset.range (sliceStopTau S P (stepRadius L) L om),
      (stepRadius L (walkPos (stepRadius L) om m)) ^ 2) ∂walkMeasure) ≤ C_clk
  all_power_geometry : ∀ σ δ : ℝ, 0 < σ → 0 < δ →
    ∃ L₁ : ℝ, L_min ≤ L₁ ∧ ∀ L : ℝ, L₁ ≤ L →
      walkMeasure.real {om : WalkSpace |
        ∃ m ≤ sliceStopTau S P (stepRadius L) L om,
          L ^ σ < sliceGeomCost S P (walkPos (stepRadius L) om m)} ≤ δ
  modified_inverse_bound : ∀ L U V : ℝ, L_min ≤ L → 1 ≤ U → U ≤ V →
    ∀ I F : Finset (Fin P.N), I ⊂ Finset.univ → Disjoint I F →
      ∃ E_bad : Set WalkSpace, MeasurableSet E_bad ∧
        walkMeasure.real E_bad ≤ C_inv * (1 + U) / (1 + V) ∧
        ∀ om : WalkSpace, om ∉ E_bad →
          ∀ m ≤ sliceStopTau S P (stepRadius L) L om,
            (∀ n ≤ m, sliceGeomCost S P (walkPos (stepRadius L) om n) ≤ U) →
            (∀ i ∈ I, sliceHistory S P (stepRadius L) om i m ≤ U) →
            ∃ B_inv : Matrix (Fin P.N) (Fin P.N) ℂ,
              P.B_mat I F (walkPos (stepRadius L) om m) * B_inv = 1 ∧
              B_inv * P.B_mat I F (walkPos (stepRadius L) om m) = 1 ∧
              ∀ r c : Fin P.N, ‖B_inv r c‖ ≤ Real.exp (C_inv * V)
  first_hit_interval_domination : ∀ L d r_int : ℝ, ∀ j : Fin P.N, ∀ E : Set ℝ,
    L_min ≤ L → 0 < d → d < S.H / 4 →
    100 * Real.exp (-L ^ 2) * d ≤ r_int →
    MeasurableSet E → (∀ x : ℝ, x ∈ E ↔ x + 2 * Real.pi ∈ E) →
    walkMeasure.real {om : WalkSpace |
      (∃ m ≤ sliceStopTau S P (stepRadius L) L om,
        sliceShapeDepth S P j (walkPos (stepRadius L) om m) ≤ d) ∧
      Set.Ioo
        ((sliceImpactSeq S P.N j.val
          (walkPos (stepRadius L) om (sliceFirstHit S P (stepRadius L) L d j om))).re - r_int)
        ((sliceImpactSeq S P.N j.val
          (walkPos (stepRadius L) om (sliceFirstHit S P (stepRadius L) L d j om))).re + r_int) ⊆
        E} ≤
    C_hit * MeasureTheory.volume.real (E ∩ Set.Icc (0 : ℝ) (2 * Real.pi))
  remaining_clock_tail : ∀ L d B : ℝ, ∀ j : Fin P.N,
    L_min ≤ L → 0 < d → d < S.H / 4 → 1 ≤ B → d * Real.exp (B / 4) < S.H / 4 →
    walkMeasure.real {om : WalkSpace |
      d ^ 2 * Real.exp B <
        ∑ m ∈ Finset.Ico (sliceFirstHit S P (stepRadius L) L d j om)
            (sliceStopTau S P (stepRadius L) L om),
          ‖deriv (sliceImpactSeq S P.N j.val) (walkPos (stepRadius L) om m)‖ ^ 2 *
            (stepRadius L (walkPos (stepRadius L) om m)) ^ 2} ≤
    C_rem * Real.exp (-B / 4)
  stopped_displacement_bound : ∀ L d r_exit q_K : ℝ,
    ∀ (J : Finset (Fin P.N)) (hJ : J.Nonempty) (i : Fin P.N),
    L_min ≤ L → i ∈ J → 0 < d → d < S.H / 4 → 0 < r_exit → 0 < q_K →
    walkMeasure.real {om : WalkSpace |
      (∑ m ∈ Finset.Ico (sliceLastFirstHit S P (stepRadius L) L d J hJ om)
          (sliceDiskExit S P (stepRadius L) L d r_exit J hJ i om),
        (2 * ‖deriv (sliceImpactSeq S P.N i.val) (walkPos (stepRadius L) om m)‖ ^ 2 +
          Real.exp (-2 * L ^ 3)) *
          (stepRadius L (walkPos (stepRadius L) om m)) ^ 2 ≤ q_K) ∧
      r_exit <
        ‖sliceImpactSeq S P.N i.val
            (walkPos (stepRadius L) om (sliceDiskExit S P (stepRadius L) L d r_exit J hJ i om)) -
          sliceImpactSeq S P.N i.val
            (walkPos (stepRadius L) om (sliceLastFirstHit S P (stepRadius L) L d J hJ om))‖} ≤
    2 * q_K / r_exit ^ 2
def criticalLowerHalfPlane : Set ℂ :=
  { z : ℂ | z.im < 0 }


noncomputable def criticalDepthThreshold (S : FiniteWallNonisotropicStrip) : ℝ :=
  max 1 (-Real.log (S.H / 20))


def upperStripTile (S : FiniteWallNonisotropicStrip) (A k x : ℝ) : Set ℂ :=
  { s : ℂ |
    0 ≤ s.im ∧
    Real.exp (-A) * Real.exp (-k) ≤ wallDepth S s ∧
    wallDepth S s ≤ min (S.H / 2) (Real.exp A * Real.exp (-k)) ∧
    |s.re - x| ≤ A * wallDepth S s }


noncomputable def tileSupModulus (S : FiniteWallNonisotropicStrip) (A k x : ℝ) : ℝ :=
  Real.exp (-k) * sSup (shapeModulus S '' upperStripTile S A k x)


noncomputable def periodicPoissonKernel (d_a u : ℝ) : ℝ :=
  Real.sinh d_a / (Real.cosh d_a - Real.cos u)


noncomputable def ancestorPoissonDensity (d_a : ℝ) (w : ℝ → ℝ) (x : ℝ) : ℝ :=
  (2 * Real.pi)⁻¹ * ∫ y in (0 : ℝ)..(2 * Real.pi), periodicPoissonKernel d_a (x - y) * w y


structure IsCriticalEnvelope (S : FiniteWallNonisotropicStrip)
    (β a C_N C₁ : ℝ) (N : ℝ → ℝ) : Prop where
  one_le : ∀ k : ℝ, criticalDepthThreshold S ≤ k → 1 ≤ N k
  coarse_bound : ∀ j k : ℝ, criticalDepthThreshold S ≤ j → j ≤ k →
    N j ≤ C_N * N k * Real.exp (β * (k - j))
  fine_bound : ∀ j k : ℝ, criticalDepthThreshold S ≤ k → k ≤ j →
    N j ≤ C_N * N k * Real.exp (a * (j - k))
  first_moment_bound : ∀ k : ℝ, criticalDepthThreshold S ≤ k →
    Real.exp (-k) * ((2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi),
      shapeModulus S ((x : ℂ) + ((S.H - Real.exp (-k) : ℝ) : ℂ) * Complex.I)) ≤ C₁ * N k
  finite_ratio : ∃ M_fin : ℝ, 0 < M_fin ∧
    ∀ k : ℝ, criticalDepthThreshold S ≤ k → rowMomentFull S k ≤ M_fin * N k


structure CriticalBootstrapPackage (S : FiniteWallNonisotropicStrip) : Prop where
  unweighted_bootstrap :
    ∀ β a C_N C₁ : ℝ, 0 ≤ β → β < 1 / 2 → 0 < a → 1 ≤ C_N → 0 < C₁ →
      ∃ C_boot η : ℝ, 0 < C_boot ∧ 0 < η ∧
        (∀ N : ℝ → ℝ, IsCriticalEnvelope S β a C_N C₁ N →
          (∀ k : ℝ, criticalDepthThreshold S ≤ k →
            rowMomentFull S k ≤ C_boot * N k ∧
            (2 * Real.pi)⁻¹ * (∫ x in (0 : ℝ)..(2 * Real.pi),
              Real.exp (-k) *
                |(S.V ((x : ℂ) + ((S.H - Real.exp (-k) : ℝ) : ℂ) * Complex.I)).im|) ≤
              C_boot * (N k) ^ 2 ∧
            (2 * Real.pi)⁻¹ * (∫ x in (0 : ℝ)..(2 * Real.pi),
              (Real.exp (-k) *
                shapeModulus S ((x : ℂ) + ((S.H - Real.exp (-k) : ℝ) : ℂ) * Complex.I) /
                N k) ^ (2 + η)) ≤
              C_boot ^ (2 + η)) ∧
          (MonotoneOn N (Set.Ici (criticalDepthThreshold S)) →
            ∀ k : ℝ, criticalDepthThreshold S ≤ k → ∀ x : ℝ,
              Real.exp (-k) *
                shapeModulus S ((x : ℂ) + ((S.H - Real.exp (-k) : ℝ) : ℂ) * Complex.I) ≤
                C_boot * (1 + k) * N k ∧
              Real.exp (-k) *
                |(S.V ((x : ℂ) + ((S.H - Real.exp (-k) : ℝ) : ℂ) * Complex.I)).im| ≤
                C_boot * (1 + k) ^ 2 * (N k) ^ 2)) ∧
        (∀ A : ℝ, 1 ≤ A → ∃ C_tile : ℝ, 0 < C_tile ∧
          ∀ N : ℝ → ℝ, IsCriticalEnvelope S β a C_N C₁ N →
            ∀ k : ℝ, criticalDepthThreshold S ≤ k →
              Real.sqrt ((2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi),
                (tileSupModulus S A k x) ^ 2) ≤ C_tile * N k)
  weighted_bootstrap :
    ∀ β a C_N C₁ A : ℝ, 0 ≤ β → β < 1 / 2 → 0 < a → 1 ≤ C_N → 0 < C₁ → 1 ≤ A →
      ∃ K_anc A_coarse : ℝ, criticalDepthThreshold S ≤ K_anc ∧ A ≤ A_coarse ∧
        ∀ M_coarse M_anc : ℝ, 0 < M_coarse → 0 < M_anc →
          ∃ C_w : ℝ, 0 < C_w ∧
            ∀ (N : ℝ → ℝ) (k_a : ℝ) (w : ℝ → ℝ),
              IsCriticalEnvelope S β a C_N C₁ N →
              K_anc ≤ k_a →
              Continuous w →
              Function.Periodic w (2 * Real.pi) →
              (∀ y : ℝ, 0 ≤ w y) →
              (2 * Real.pi)⁻¹ * (∫ y in (0 : ℝ)..(2 * Real.pi), w y) = 1 →
              (∀ j : ℝ, criticalDepthThreshold S ≤ j → j ≤ k_a + 3 →
                Real.sqrt ((2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi),
                  (tileSupModulus S A_coarse j x) ^ 2 *
                    ancestorPoissonDensity (Real.exp (-k_a)) w x) ≤
                  M_coarse * N j) →
              (2 * Real.pi)⁻¹ * (∫ y in (0 : ℝ)..(2 * Real.pi),
                |(S.V ((y : ℂ) + ((S.H - Real.exp (-k_a) : ℝ) : ℂ) * Complex.I)).im| * w y) ≤
                M_anc * (N k_a) ^ 2 / Real.exp (-k_a) →
              ∀ j : ℝ, criticalDepthThreshold S ≤ j →
                Real.sqrt ((2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi),
                  (tileSupModulus S A j x) ^ 2 *
                    ancestorPoissonDensity (Real.exp (-k_a)) w x) ≤
                  C_w * N j
  quiet_cone_exclusion :
    ∀ α δ_b : ℝ, 1 / 2 < α → α < 1 → 0 < δ_b → δ_b < S.H / 2 →
      ∃ L_star : ℝ, 0 < L_star ∧
        ∀ β a C₀ : ℝ, 0 ≤ β → β < 1 / 2 → 0 < a → 0 < C₀ →
          ∀ k_seq x_seq : ℕ → ℝ,
            (∀ n : ℕ, criticalDepthThreshold S ≤ k_seq n) →
            Filter.Tendsto k_seq Filter.atTop Filter.atTop →
            Filter.Tendsto (fun n => rowMomentFull S (k_seq n)) Filter.atTop Filter.atTop →
            (∀ n : ℕ, ∀ l : ℝ, criticalDepthThreshold S ≤ l →
              rowMomentFull S l ≤ C₀ * rowMomentFull S (k_seq n) *
                Real.exp (β * max (k_seq n - l) 0 + a * max (l - k_seq n) 0)) →
            ¬ (∀ c_depth ε : ℝ, 0 < c_depth → 0 < ε →
              ∃ N₀ : ℕ, ∀ n ≥ N₀, ∀ s : ℂ,
                c_depth * Real.exp (-k_seq n) ≤ wallDepth S s →
                wallDepth S s ≤ δ_b →
                |s.re - x_seq n| ≤ L_star * wallDepth S s →
                (Real.exp (-k_seq n) / rowMomentFull S (k_seq n)) *
                  shapeModulus S s * (wallDepth S s / Real.exp (-k_seq n)) ^ α ≤ ε)


def ProhibitedCriticalSequence (S : FiniteWallNonisotropicStrip) : Prop :=
  ∃ (k_seq k_anc_seq ε_seq : ℕ → ℝ) (w_seq : ℕ → ℝ → ℝ),
    (∀ n : ℕ, criticalDepthThreshold S ≤ k_anc_seq n ∧
      k_anc_seq n ≤ k_seq n ∧
      0 < ε_seq n ∧
      1 ≤ rowMomentFull S (k_seq n)) ∧
    Filter.Tendsto k_seq Filter.atTop Filter.atTop ∧
    Filter.Tendsto (fun n => rowMomentFull S (k_seq n)) Filter.atTop Filter.atTop ∧
    Filter.Tendsto ε_seq Filter.atTop (nhds 0) ∧
    (∀ n : ℕ, ∀ j : ℝ, criticalDepthThreshold S ≤ j →
      rowMomentFull S j ≤ rowMomentFull S (k_seq n) * Real.exp (ε_seq n * |j - k_seq n|)) ∧
    Filter.Tendsto k_anc_seq Filter.atTop Filter.atTop ∧
    Filter.Tendsto (fun n => k_seq n - k_anc_seq n) Filter.atTop Filter.atTop ∧
    (∀ n : ℕ, Continuous (w_seq n) ∧
      Function.Periodic (w_seq n) (2 * Real.pi) ∧
      (∀ y : ℝ, 0 ≤ w_seq n y) ∧
      (2 * Real.pi)⁻¹ * (∫ y in (0 : ℝ)..(2 * Real.pi), w_seq n y) = 1) ∧
    (∀ β A : ℝ, 0 < β → β < 1 / 2 → 1 ≤ A →
      ∃ C_βA : ℝ, 0 < C_βA ∧ ∃ N₀ : ℕ, ∀ n ≥ N₀,
        ∀ j : ℝ, criticalDepthThreshold S ≤ j → j ≤ k_anc_seq n + 3 →
          Real.sqrt ((2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi),
            (tileSupModulus S A j x) ^ 2 *
              ancestorPoissonDensity (Real.exp (-k_anc_seq n)) (w_seq n) x) ≤
            C_βA * rowMomentFull S (k_seq n) * Real.exp (β * (k_seq n - j))) ∧
    (∀ β : ℝ, 0 < β → β < 1 / 2 →
      ∃ C_β : ℝ, 0 < C_β ∧ ∃ N₀ : ℕ, ∀ n ≥ N₀,
        (2 * Real.pi)⁻¹ * (∫ y in (0 : ℝ)..(2 * Real.pi),
          |(S.V ((y : ℂ) + ((S.H - Real.exp (-k_anc_seq n) : ℝ) : ℂ) * Complex.I)).im| *
            w_seq n y) ≤
          C_β * (rowMomentFull S (k_seq n)) ^ 2 *
            Real.exp (2 * β * (k_seq n - k_anc_seq n)) / Real.exp (-k_anc_seq n)) ∧
    (∀ K : Set ℂ, IsCompact K → K.Nonempty → K ⊆ criticalLowerHalfPlane →
      Filter.Tendsto
        (fun n => (2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi),
          min 1 (sSup ((fun Z : ℂ =>
            (Real.exp (-k_seq n) / rowMomentFull S (k_seq n)) ^ 2 *
              ‖S.q ((x : ℂ) + (S.H : ℂ) * Complex.I +
                (Real.exp (-k_seq n) : ℂ) * Z)‖) '' K)) *
            ancestorPoissonDensity (Real.exp (-k_anc_seq n)) (w_seq n) x)
        Filter.atTop (nhds 0))


structure SecondScaleFirstFieldData (S : FiniteWallNonisotropicStrip) where
  F : ℂ → ℂ
  Q_lim : ℂ → ℂ
  L_lim : ℝ → ℝ
  lam : ℝ
  β : ℝ
  a : ℝ
  α : ℝ
  δ_b : ℝ
  C_env2 : ℝ
  K_seq : ℕ → ℝ
  ξ_seq : ℕ → ℝ
  F_holo : DifferentiableOn ℂ F criticalLowerHalfPlane
  Q_lim_holo : DifferentiableOn ℂ Q_lim criticalLowerHalfPlane
  F_nonzero : ∃ z ∈ criticalLowerHalfPlane, F z ≠ 0
  deriv2_F : ∀ z ∈ criticalLowerHalfPlane, deriv (deriv F) z = Q_lim z * F z
  one_le_lam : 1 ≤ lam
  β_pos : 0 < β
  β_lt_half : β < 1 / 2
  a_pos : 0 < a
  half_lt_α : 1 / 2 < α
  α_lt_one_sub_β : α < 1 - β
  δ_b_pos : 0 < δ_b
  δ_b_lt : δ_b < S.H / 2
  C_env2_pos : 0 < C_env2
  L_lim_cont : Continuous L_lim
  L_lim_zero : L_lim 0 = 0
  L_lim_slope_top : Filter.Tendsto (fun v => L_lim v / v) Filter.atTop (nhds lam)
  L_lim_slope_bot : Filter.Tendsto (fun v => L_lim v / v) Filter.atBot (nhds lam)
  K_seq_ge : ∀ n : ℕ, criticalDepthThreshold S ≤ K_seq n ∧ 1 ≤ rowMomentFull S (K_seq n)
  K_seq_tendsto : Filter.Tendsto K_seq Filter.atTop Filter.atTop
  B_seq_tendsto : Filter.Tendsto (fun n => rowMomentFull S (K_seq n)) Filter.atTop Filter.atTop
  moment_law_conv : TendstoLocallyUniformly
    (fun n v => Real.exp v * (rowMomentFull S (K_seq n + v) / rowMomentFull S (K_seq n)))
    (fun v => Real.exp (L_lim v)) Filter.atTop
  global_envelope : ∀ n : ℕ, ∀ l : ℝ, criticalDepthThreshold S ≤ l →
    rowMomentFull S l ≤ C_env2 * rowMomentFull S (K_seq n) *
      Real.exp (β * max (K_seq n - l) 0 + a * max (l - K_seq n) 0)
  cone_bound : ∀ A : ℝ, 0 < A → ∃ C_A : ℝ, 0 < C_A ∧ ∃ N₀ : ℕ, ∀ n ≥ N₀, ∀ s : ℂ,
    Real.exp (-K_seq n) ≤ wallDepth S s →
    wallDepth S s ≤ δ_b →
    |s.re - ξ_seq n| ≤ A * wallDepth S s →
    (Real.exp (-K_seq n) / rowMomentFull S (K_seq n)) * shapeModulus S s ≤
      C_A * (Real.exp (-K_seq n) / wallDepth S s) ^ α
  F_conv : TendstoLocallyUniformlyOn
    (fun n Z =>
      ((Real.exp (-K_seq n) / rowMomentFull S (K_seq n) : ℝ) : ℂ) *
        S.f ((ξ_seq n : ℂ) + (S.H : ℂ) * Complex.I + (Real.exp (-K_seq n) : ℂ) * Z))
    F Filter.atTop criticalLowerHalfPlane
  Q_conv : TendstoLocallyUniformlyOn
    (fun n Z =>
      ((Real.exp (-K_seq n) / rowMomentFull S (K_seq n) : ℝ) : ℂ) ^ 2 *
        S.q ((ξ_seq n : ℂ) + (S.H : ℂ) * Complex.I + (Real.exp (-K_seq n) : ℂ) * Z))
    (fun _ => 0) Filter.atTop criticalLowerHalfPlane


structure FirstFieldMeshHypotheses (F : ℂ → ℂ) (lam : ℝ) : Prop where
  upper_growth :
    ∀ R ε : ℝ, 0 < R → 0 < ε →
      ∃ v₀ : ℝ, 0 < v₀ ∧ ∀ v x : ℝ, v₀ ≤ v → |x| ≤ R →
        ‖F ((x : ℂ) - (Real.exp (-v) : ℂ) * Complex.I)‖ ≤ Real.exp ((lam + ε) * v)
  epochs_and_witnesses :
    ∃ (L₀ : ℝ) (E : Set ℝ),
      0 < L₀ ∧
      (∀ u ∈ E, 0 < u) ∧
      (∀ ε : ℝ, 0 < ε → ∃ v₀ : ℝ, 0 < v₀ ∧ ∀ v : ℝ, v₀ ≤ v → ∃ u ∈ E, |v - u| ≤ ε * v) ∧
      (∀ R ε : ℝ, 0 < R → 0 < ε →
        ∃ u₀ : ℝ, 0 < u₀ ∧ ∀ u ∈ E, u₀ ≤ u → ∀ x : ℝ, |x| ≤ R →
          ∃ p δ : ℝ, 0 < δ ∧ |p - x| ≤ L₀ * δ ∧
            |-Real.log δ - u| ≤ ε * u ∧
            Real.exp ((lam - ε) * u) ≤ ‖F ((p : ℂ) - (δ : ℂ) * Complex.I)‖)
noncomputable def supportAction1_ℝ (h : ℝ → ℝ) (θ₁ θ₂ : ℝ) : ℝ :=
  deriv h ((θ₁ + θ₂) / 2) * Real.sin ((θ₂ - θ₁) / 2) -
    h ((θ₁ + θ₂) / 2) * Real.cos ((θ₂ - θ₁) / 2)

noncomputable def supportAction2_ℝ (h : ℝ → ℝ) (θ₁ θ₂ : ℝ) : ℝ :=
  deriv h ((θ₁ + θ₂) / 2) * Real.sin ((θ₂ - θ₁) / 2) +
    h ((θ₁ + θ₂) / 2) * Real.cos ((θ₂ - θ₁) / 2)

def glancingDomain (ν s d : ℝ) : Set (ℂ × ℂ) :=
  { p : ℂ × ℂ | ‖p.2‖ < d ∧ |p.1.im| < s - ν * |p.2.im| }

def IsAdmissibleGlancingCand (s d η_adm : ℝ) (U : ℂ × ℂ → ℂ) : Prop :=
  DifferentiableOn ℂ U (glancingDomain 0 s d) ∧
  (∀ y t : ℂ, (y, t) ∈ glancingDomain 0 s d →
    U (y + 2 * Real.pi, t) = U (y, t) + 2 * Real.pi) ∧
  (∀ y t : ℂ, (y, t) ∈ glancingDomain 0 s d → U (y, -t) = U (y, t)) ∧
  (∀ y t : ℂ, (y, t) ∈ glancingDomain 0 s d →
    U (starRingEnd ℂ y, starRingEnd ℂ t) = starRingEnd ℂ (U (y, t))) ∧
  (∀ k : ℕ, k ≤ 3 → ∀ y t : ℂ, (y, t) ∈ glancingDomain 0 s d →
    ‖iteratedDeriv k (fun y' : ℂ => U (y', t) - y') y‖ ≤ η_adm)

structure RationalCollarData (Ω : Set Plane) extends SupportLazutkinData Ω where
  b₀ : ℝ
  δ_col : ℝ
  τ₀ : ℝ
  b₀_pos : 0 < b₀
  δ_col_pos : 0 < δ_col
  δ_col_lt_pi : δ_col < Real.pi
  τ₀_pos : 0 < τ₀
  F_col : ℝ → ℝ → ℝ
  F_col_cont : ContinuousOn (fun p : ℝ × ℝ => F_col p.1 p.2) (Set.Ioo 0 b₀ ×ˢ Set.univ)
  F_col_quasiperiodic : ∀ b ∈ Set.Ioo 0 b₀, ∀ x : ℝ,
    F_col b (x + 2 * Real.pi) = F_col b x + 2 * Real.pi
  F_col_strictMono_x : ∀ b ∈ Set.Ioo 0 b₀, StrictMono (F_col b)
  F_col_strictMono_b : ∀ b₁ b₂ : ℝ, 0 < b₁ → b₁ < b₂ → b₂ < b₀ → ∀ x : ℝ,
    F_col b₁ x < F_col b₂ x
  F_col_step_bounds : ∀ b ∈ Set.Ioo 0 b₀, ∀ x : ℝ,
    0 < F_col b x - x ∧ ϕ (F_col b x) - ϕ x < Real.pi
  F_col_tendsto_zero : ∀ ε : ℝ, 0 < ε → ∃ b₁ : ℝ, 0 < b₁ ∧ b₁ ≤ b₀ ∧
    ∀ b ∈ Set.Ioo 0 b₁, ∀ x : ℝ, F_col b x - x < ε
  F_col_stationary : ∀ b ∈ Set.Ioo 0 b₀, ∀ x : ℝ,
    -supportAction1_ℝ h (ϕ (F_col b x)) (ϕ (F_col b (F_col b x))) =
      supportAction2_ℝ h (ϕ x) (ϕ (F_col b x))
  collar_fills_steps : ∀ x₀ x₁ : ℝ, 0 < x₁ - x₀ → x₁ - x₀ < δ_col →
    ∃! b : ℝ, b ∈ Set.Ioo 0 b₀ ∧ F_col b x₀ = x₁
  forward_step_unique : ∀ x₀ x₁ x₂ x₂' : ℝ,
    0 < ϕ x₁ - ϕ x₀ → ϕ x₁ - ϕ x₀ < Real.pi →
    0 < ϕ x₂ - ϕ x₁ → ϕ x₂ - ϕ x₁ < Real.pi →
    0 < ϕ x₂' - ϕ x₁ → ϕ x₂' - ϕ x₁ < Real.pi →
    -supportAction1_ℝ h (ϕ x₁) (ϕ x₂) = supportAction2_ℝ h (ϕ x₀) (ϕ x₁) →
    -supportAction1_ℝ h (ϕ x₁) (ϕ x₂') = supportAction2_ℝ h (ϕ x₀) (ϕ x₁) →
    x₂ = x₂'
  rational_leaf_all_periodic : ∀ l q : ℕ, 0 < l → 0 < q → Nat.Coprime l q →
    (2 * Real.pi * (l : ℝ)) / (q : ℝ) < τ₀ →
    (∃ b ∈ Set.Ioo 0 b₀, ∀ x : ℝ, (F_col b)^[q] x = x + 2 * Real.pi * (l : ℝ)) ∧
    (∀ b ∈ Set.Ioo 0 b₀,
      (∃ x₀ : ℝ, (F_col b)^[q] x₀ = x₀ + 2 * Real.pi * (l : ℝ)) →
      ∀ x : ℝ, (F_col b)^[q] x = x + 2 * Real.pi * (l : ℝ))

def IsPeriodicSmoothBounded (r₀ : ℕ) (M : ℝ) (w : ℝ → ℝ) : Prop :=
  Function.Periodic w (2 * Real.pi) ∧
  ContDiff ℝ (r₀ : WithTop ℕ∞) w ∧
  ∀ k : ℕ, k ≤ r₀ → ∀ x : ℝ, |iteratedDeriv k w x| ≤ M

def IsBoundedStripExt (r₀ : ℕ) (σ M : ℝ) (w : ℝ → ℝ) (W : ℂ → ℂ) : Prop :=
  DifferentiableOn ℂ W (horizStrip σ) ∧
  (∀ x : ℝ, W x = w x) ∧
  (∀ z ∈ horizStrip σ, W (z + 2 * Real.pi) = W z) ∧
  (∀ z ∈ horizStrip σ, W (starRingEnd ℂ z) = starRingEnd ℂ (W z)) ∧
  (∀ k : ℕ, k ≤ r₀ → ∀ z ∈ horizStrip σ, ‖iteratedDeriv k W z‖ ≤ M)

structure HighFreqActionSystem (u_table : ℝ → ℝ) where
  C_coeff : ℤ → (ℝ → ℝ) → ℂ
  b_mult : ℤ → (ℝ → ℝ) → (ℝ → ℂ)
  N_vanish : ℕ
  N_vanish_pos : 1 ≤ N_vanish
  C_zero : ∀ n : ℤ, (N_vanish : ℤ) ≤ |n| → C_coeff n (fun _ => 0) = 0
  C_table_zero : ∀ n : ℤ, (N_vanish : ℤ) ≤ |n| → C_coeff n u_table = 0
  C_conj_symm : ∀ n : ℤ, ∀ w : ℝ → ℝ, C_coeff (-n) w = starRingEnd ℂ (C_coeff n w)
  b_mult_conj_symm : ∀ n : ℤ, ∀ w : ℝ → ℝ, ∀ x : ℝ,
    b_mult (-n) w x = starRingEnd ℂ (b_mult n w x)
  deriv_and_bounds : ∀ (m : ℕ) (M : ℝ), 2 ≤ m → 0 < M →
    ∃ (K : ℝ) (N_m : ℕ), 0 < K ∧ N_vanish ≤ N_m ∧
      (∀ (n : ℤ), (N_m : ℤ) ≤ |n| →
        (∀ (w : ℝ → ℝ), IsPeriodicSmoothBounded (m + 15) M w →
          ContDiff ℝ (m : WithTop ℕ∞) (b_mult n w) ∧
          Function.Periodic (b_mult n w) (2 * Real.pi) ∧
          (∀ (v : ℝ → ℝ), Function.Periodic v (2 * Real.pi) →
            ContDiff ℝ ((m + 15 : ℕ) : WithTop ℕ∞) v →
            HasDerivAt (fun t : ℝ => C_coeff n (fun x => w x + t * v x))
              (((2 * Real.pi : ℝ) : ℂ)⁻¹ *
                ∫ x in (0 : ℝ)..(2 * Real.pi),
                  Complex.exp (-Complex.I * (n : ℂ) * (x : ℂ)) * b_mult n w x * (v x : ℂ)) 0) ∧
          (∀ k : ℕ, k ≤ m → ∀ x : ℝ,
            ‖iteratedDeriv k (fun y : ℝ => b_mult n w y - 1) x‖ ≤ K / |(n : ℝ)|)) ∧
        (∀ (w₁ w₂ : ℝ → ℝ),
          IsPeriodicSmoothBounded (m + 15) M w₁ →
          IsPeriodicSmoothBounded (m + 15) M w₂ →
          ∀ k : ℕ, k ≤ m → ∀ x : ℝ,
            ‖iteratedDeriv k (fun y : ℝ => b_mult n w₁ y - b_mult n w₂ y) x‖ ≤
              (K / |(n : ℝ)|) *
                sSup { r : ℝ | ∃ j ≤ m + 15, ∃ y ∈ Set.Icc (0 : ℝ) (2 * Real.pi),
                  r = |iteratedDeriv j (w₁ - w₂) y| })) ∧
      (∀ (σ : ℝ) (n : ℤ), σ ∈ Set.Ioc (0 : ℝ) 1 → (N_m : ℤ) ≤ |n| →
        K / (n : ℝ) ^ 2 < 1 →
        (∀ (w : ℝ → ℝ) (W : ℂ → ℂ),
          IsPeriodicSmoothBounded (m + 15) M w →
          IsBoundedStripExt (m + 15) σ M w W →
          ∃ B : ℂ → ℂ,
            DifferentiableOn ℂ B (horizStrip ((1 - K / (n : ℝ) ^ 2) * σ)) ∧
            (∀ x : ℝ, B x = b_mult n w x) ∧
            (∀ z ∈ horizStrip ((1 - K / (n : ℝ) ^ 2) * σ), B (z + 2 * Real.pi) = B z) ∧
            (∀ k : ℕ, k ≤ m → ∀ z ∈ horizStrip ((1 - K / (n : ℝ) ^ 2) * σ),
              ‖iteratedDeriv k (fun ζ : ℂ => B ζ - 1) z‖ ≤ K / |(n : ℝ)|)) ∧
        (∀ (w₁ w₂ : ℝ → ℝ) (W₁ W₂ B₁ B₂ : ℂ → ℂ),
          IsPeriodicSmoothBounded (m + 15) M w₁ →
          IsPeriodicSmoothBounded (m + 15) M w₂ →
          IsBoundedStripExt (m + 15) σ M w₁ W₁ →
          IsBoundedStripExt (m + 15) σ M w₂ W₂ →
          DifferentiableOn ℂ B₁ (horizStrip ((1 - K / (n : ℝ) ^ 2) * σ)) →
          DifferentiableOn ℂ B₂ (horizStrip ((1 - K / (n : ℝ) ^ 2) * σ)) →
          (∀ x : ℝ, B₁ x = b_mult n w₁ x) →
          (∀ x : ℝ, B₂ x = b_mult n w₂ x) →
          ∀ k : ℕ, k ≤ m → ∀ z ∈ horizStrip ((1 - K / (n : ℝ) ^ 2) * σ),
            ‖iteratedDeriv k (fun ζ : ℂ => B₁ ζ - B₂ ζ) z‖ ≤
              (K / |(n : ℝ)|) *
                sSup { r : ℝ | ∃ j ≤ m + 15, ∃ ζ ∈ horizStrip σ,
                  r = ‖iteratedDeriv j (W₁ - W₂) ζ‖ }))

structure AnalyticBoundaryData (Ω : Set Plane) extends RationalCollarData Ω where
  s₀ : ℝ
  s_h : ℝ
  s₀_pos : 0 < s₀
  s_h_pos : 0 < s_h
  u_ℂ : ℂ → ℂ
  h_ℂ : ℂ → ℂ
  ϕ_ℂ : ℂ → ℂ
  u_ℂ_holo : DifferentiableOn ℂ u_ℂ (horizStrip (2 * s₀))
  u_ℂ_real : ∀ x : ℝ, u_ℂ x = Real.log (deriv ϕ x)
  u_ℂ_periodic : ∀ z ∈ horizStrip (2 * s₀), u_ℂ (z + 2 * Real.pi) = u_ℂ z
  u_ℂ_conj : ∀ z ∈ horizStrip (2 * s₀),
    u_ℂ (starRingEnd ℂ z) = starRingEnd ℂ (u_ℂ z)
  deriv_ϕ_ℂ_eq_exp : ∀ z ∈ horizStrip (2 * s₀), deriv ϕ_ℂ z = Complex.exp (u_ℂ z)
  h_ℂ_holo : DifferentiableOn ℂ h_ℂ (horizStrip (2 * s_h))
  ϕ_ℂ_holo : DifferentiableOn ℂ ϕ_ℂ (horizStrip (2 * s₀))
  ϕ_ℂ_maps_to : ∀ z ∈ horizStrip (2 * s₀), ϕ_ℂ z ∈ horizStrip (2 * s_h)
  h_ℂ_real : ∀ θ : ℝ, h_ℂ θ = h θ
  ϕ_ℂ_real : ∀ x : ℝ, ϕ_ℂ x = ϕ x
  h_ℂ_periodic : ∀ w ∈ horizStrip (2 * s_h), h_ℂ (w + 2 * Real.pi) = h_ℂ w
  h_ℂ_conj : ∀ w ∈ horizStrip (2 * s_h),
    h_ℂ (starRingEnd ℂ w) = starRingEnd ℂ (h_ℂ w)
  ϕ_ℂ_quasiperiodic : ∀ z ∈ horizStrip (2 * s₀),
    ϕ_ℂ (z + 2 * Real.pi) = ϕ_ℂ z + 2 * Real.pi
  ϕ_ℂ_conj : ∀ z ∈ horizStrip (2 * s₀),
    ϕ_ℂ (starRingEnd ℂ z) = starRingEnd ℂ (ϕ_ℂ z)
  ϕ_ℂ_deriv_ne_zero : ∀ z ∈ horizStrip (2 * s₀), deriv ϕ_ℂ z ≠ 0
  lazutkin_norm_ℂ : ∀ z ∈ horizStrip (2 * s₀),
    (h_ℂ (ϕ_ℂ z) + deriv (deriv h_ℂ) (ϕ_ℂ z)) * (deriv ϕ_ℂ z) ^ 3 = c

structure GlancingActionAndStepData {Ω : Set Plane} (B : AnalyticBoundaryData Ω) where
  s_act : ℝ
  d_act : ℝ
  η_adm : ℝ
  C_step : ℝ
  c_small : ℝ
  B₀ : ℕ
  s_act_pos : 0 < s_act
  s_act_le : s_act ≤ B.s₀
  d_act_pos : 0 < d_act
  d_act_lt : d_act < s_act / 2
  η_adm_pos : 0 < η_adm
  η_adm_le : η_adm ≤ 1 / 4
  C_step_pos : 0 < C_step
  c_small_pos : 0 < c_small
  c_small_le : c_small ≤ η_adm / 4
  E_op : (ℂ × ℂ → ℂ) → (ℂ × ℂ → ℂ)
  E_op_props : ∀ (s d : ℝ) (U : ℂ × ℂ → ℂ),
    0 < s → s ≤ s_act → 0 < d → d ≤ d_act → d < s / 2 →
    IsAdmissibleGlancingCand s d η_adm U →
    DifferentiableOn ℂ (E_op U) (glancingDomain 1 s d) ∧
    (∀ y t : ℂ, (y, t) ∈ glancingDomain 1 s d →
      E_op U (y + 2 * Real.pi, t) = E_op U (y, t) ∧
      E_op U (y, -t) = E_op U (y, t) ∧
      E_op U (starRingEnd ℂ y, starRingEnd ℂ t) = starRingEnd ℂ (E_op U (y, t))) ∧
    (∀ t : ℂ, ‖t‖ < d → (∫ x in (0 : ℝ)..(2 * Real.pi), E_op U (x, t)) = 0) ∧
    (∀ y : ℂ, |y.im| < s →
      E_op U (y, 0) =
        (1 / 4 : ℂ) * (deriv (fun y' : ℂ => U (y', 0)) y) ^ 2 *
          deriv (deriv (fun y' : ℂ => U (y', 0))) y)
  formal_perturbation :
    ∀ (s s' d η_prev η_next M_prev M_u : ℝ) (j : ℕ) (U_prev : ℂ × ℂ → ℂ) (u_j : ℂ → ℂ),
      0 < s' → s' < s → s ≤ s_act → 0 < d → d ≤ d_act → d < s / 2 →
      0 ≤ η_prev → η_prev < η_next → η_next ≤ η_adm →
      0 < M_prev → 0 < M_u → 1 ≤ j →
      IsAdmissibleGlancingCand s d η_prev U_prev →
      (∀ y : ℂ, |y.im| < s → U_prev (y, 0) = y) →
      (∀ p ∈ glancingDomain 1 s d, ‖E_op U_prev p‖ ≤ M_prev * ‖p.2‖ ^ (2 * j)) →
      DifferentiableOn ℂ u_j (horizStrip s) →
      (∀ y ∈ horizStrip s, u_j (y + 2 * Real.pi) = u_j y) →
      (∀ y ∈ horizStrip s, u_j (starRingEnd ℂ y) = starRingEnd ℂ (u_j y)) →
      (∀ y ∈ horizStrip s, ‖u_j y‖ ≤ M_u) →
      ∃ (d₁ M_next : ℝ), 0 < d₁ ∧ d₁ ≤ d ∧ d₁ < s' / 2 ∧ 0 < M_next ∧
        IsAdmissibleGlancingCand s' d₁ η_next
          (fun p => U_prev p + u_j p.1 * p.2 ^ (2 * j)) ∧
        (∀ p ∈ glancingDomain 1 s' d₁,
          ‖E_op (fun q => U_prev q + u_j q.1 * q.2 ^ (2 * j)) p -
            (E_op U_prev p +
              (1 / 4 : ℂ) * deriv (deriv u_j) p.1 * p.2 ^ (2 * j))‖ ≤
            M_next * ‖p.2‖ ^ (2 * j + 2))
  E_op_cont : ∀ (s d : ℝ) (U_seq : ℕ → ℂ × ℂ → ℂ) (U_lim : ℂ × ℂ → ℂ),
    0 < s → s ≤ s_act → 0 < d → d ≤ d_act → d < s / 2 →
    (∀ n : ℕ, IsAdmissibleGlancingCand s d η_adm (U_seq n)) →
    IsAdmissibleGlancingCand s d η_adm U_lim →
    (∀ k : ℕ, k ≤ 2 →
      TendstoUniformlyOn
        (fun (n : ℕ) (p : ℂ × ℂ) =>
          iteratedDeriv k (fun y' : ℂ => U_seq n (y', p.2) - U_lim (y', p.2)) p.1)
        (fun _ => (0 : ℂ)) Filter.atTop (glancingDomain 0 s d)) →
    ∀ p ∈ glancingDomain 1 s d,
      Filter.Tendsto (fun n : ℕ => E_op (U_seq n) p) Filter.atTop (nhds (E_op U_lim p))
  stationarity_equiv : ∀ (s d : ℝ) (U : ℂ × ℂ → ℂ),
    0 < s → s ≤ s_act → 0 < d → d ≤ d_act → d < s / 2 →
    IsAdmissibleGlancingCand s d η_adm U →
    (∀ y t : ℂ, |y.im| < s → ‖t‖ < d → U (y, t) ∈ horizStrip (2 * B.s₀)) →
    (∀ p ∈ glancingDomain 1 s d, E_op U p = 0) →
    ∀ y t : ℂ, |y.im| + ‖t‖ < s → ‖t‖ < d →
      -supportAction1_ℂ B.h_ℂ (B.ϕ_ℂ (U (y, t))) (B.ϕ_ℂ (U (y + t, t))) =
        supportAction2_ℂ B.h_ℂ (B.ϕ_ℂ (U (y - t, t))) (B.ϕ_ℂ (U (y, t)))
  newton_step : ∀ (s d δ ε : ℝ) (N : ℕ) (U : ℂ × ℂ → ℂ),
    0 < s → s ≤ s_act → 0 < d → d ≤ d_act → d < s / 2 →
    0 < δ → δ < d / 100 → 0 < ε → ε < 1 → 1 ≤ N →
    Real.exp (-(N : ℝ) * δ) ≤ ε →
    IsAdmissibleGlancingCand s d (3 * η_adm / 4) U →
    C_step * (1 + (N : ℝ) + δ⁻¹) ^ B₀ * ε ≤ c_small →
    (∀ p ∈ glancingDomain 1 s d, ‖E_op U p‖ ≤ ε) →
    ∃ ΔU : ℂ × ℂ → ℂ,
      DifferentiableOn ℂ ΔU (glancingDomain 0 (s - 20 * δ) (d - 20 * δ)) ∧
      (∀ y t : ℂ, (y, t) ∈ glancingDomain 0 (s - 20 * δ) (d - 20 * δ) →
        ΔU (y + 2 * Real.pi, t) = ΔU (y, t)) ∧
      (∀ y t : ℂ, (y, t) ∈ glancingDomain 0 (s - 20 * δ) (d - 20 * δ) →
        ΔU (y, -t) = ΔU (y, t)) ∧
      (∀ y t : ℂ, (y, t) ∈ glancingDomain 0 (s - 20 * δ) (d - 20 * δ) →
        ΔU (starRingEnd ℂ y, starRingEnd ℂ t) = starRingEnd ℂ (ΔU (y, t))) ∧
      (∀ k : ℕ, k ≤ 3 → ∀ y t : ℂ, (y, t) ∈ glancingDomain 0 (s - 20 * δ) (d - 20 * δ) →
        ‖iteratedDeriv k (fun y' : ℂ => ΔU (y', t)) y‖ ≤
          C_step * (1 + (N : ℝ) + δ⁻¹) ^ B₀ * ε) ∧
      (∀ p ∈ glancingDomain 1 (s - 20 * δ) (d - 20 * δ),
        ‖E_op (fun q => U q + ΔU q) p‖ ≤
          C_step * (1 + (N : ℝ) + δ⁻¹) ^ B₀ * ε ^ 2)
def lmLowerHalfPlane : Set ℂ :=
  { Z : ℂ | Z.im < 0 }

def lmCompactRect (r : ℕ) : Set ℂ :=
  { Z : ℂ |
    Z.re ∈ Set.Icc (-((r : ℝ) + 2)) ((r : ℝ) + 2) ∧
    Z.im ∈ Set.Icc (-((r : ℝ) + 3)) (-(1 / ((r : ℝ) + 2))) }

noncomputable def lmRescaledF (S : FiniteWallNonisotropicStrip) (k x : ℝ) (Z : ℂ) : ℂ :=
  ((Real.exp (-k) / rowMomentFull S k : ℝ) : ℂ) *
    S.f ((x : ℂ) + (S.H : ℂ) * Complex.I + (Real.exp (-k) : ℂ) * Z)

noncomputable def lmRescaledQ (S : FiniteWallNonisotropicStrip) (k x : ℝ) (Z : ℂ) : ℂ :=
  ((Real.exp (-k) / rowMomentFull S k : ℝ) : ℂ) ^ 2 *
    S.q ((x : ℂ) + (S.H : ℂ) * Complex.I + (Real.exp (-k) : ℂ) * Z)

noncomputable def lmRowModerateMeas (S : FiniteWallNonisotropicStrip) (K k : ℝ) : ℝ :=
  MeasureTheory.volume.real
    {x ∈ Set.Icc (0 : ℝ) (2 * Real.pi) |
      Real.exp (-K ^ (1 / 200 : ℝ)) ≤ ‖S.f (upperRowPt S k x)‖ ∧
      ‖S.f (upperRowPt S k x)‖ ≤ Real.exp (K ^ (1 / 200 : ℝ))}

noncomputable def lmBoxModerateFraction (S : FiniteWallNonisotropicStrip) (K k x : ℝ) : ℝ :=
  (1 / 2 : ℝ) * MeasureTheory.volume.real
    {p : ℝ × ℝ |
      p.1 ∈ Set.Icc (-1 : ℝ) 1 ∧
      p.2 ∈ Set.Icc (1 : ℝ) 2 ∧
      Real.exp (-K ^ (1 / 200 : ℝ)) ≤
        ‖S.f ((x : ℂ) + (S.H : ℂ) * Complex.I +
          (Real.exp (-k) : ℂ) * ((p.1 : ℂ) - (p.2 : ℂ) * Complex.I))‖ ∧
      ‖S.f ((x : ℂ) + (S.H : ℂ) * Complex.I +
        (Real.exp (-k) : ℂ) * ((p.1 : ℂ) - (p.2 : ℂ) * Complex.I))‖ ≤
        Real.exp (K ^ (1 / 200 : ℝ))}

structure NormalizedCenterEnvelope (S : FiniteWallNonisotropicStrip)
    (hBudget : CriticalAngleBudgetData S) (L_star C_cone : ℝ)
    (M_exhaust : ℕ → ℝ) (k_seq x_seq : ℕ → ℝ) : Prop where
  C_cone_pos : 0 < C_cone
  M_exhaust_pos : ∀ r : ℕ, 0 < M_exhaust r
  k_ge_k₀ : ∀ n : ℕ, hBudget.k₀ ≤ k_seq n
  k_tendsto : Filter.Tendsto k_seq Filter.atTop Filter.atTop
  moment_tendsto : Filter.Tendsto (fun n => rowMomentFull S (k_seq n)) Filter.atTop Filter.atTop
  normal_level : ∀ n : ℕ, ∀ l : ℝ, hBudget.k₀ ≤ l →
    rowMomentFull S l ≤
      rowMomentFull S (k_seq n) * Real.exp ((1 / 8 : ℝ) * |l - k_seq n|)
  cone_bound : ∀ n : ℕ, ∀ s : ℂ,
    Real.exp (-k_seq n) ≤ wallDepth S s →
    wallDepth S s ≤ Real.exp (-hBudget.k₀) / 8 →
    |s.re - x_seq n| ≤ L_star * wallDepth S s →
    (Real.exp (-k_seq n) / rowMomentFull S (k_seq n)) * shapeModulus S s ≤
      C_cone * (Real.exp (-k_seq n) / wallDepth S s) ^ (3 / 4 : ℝ)
  compact_exhaust_bound : ∀ r : ℕ, ∀ n : ℕ, r ≤ n → ∀ Z ∈ lmCompactRect r,
    (x_seq n : ℂ) + (S.H : ℂ) * Complex.I + (Real.exp (-k_seq n) : ℂ) * Z ∈ horizStrip S.H ∧
    ‖lmRescaledF S (k_seq n) (x_seq n) Z‖ ^ 2 +
      ‖lmRescaledQ S (k_seq n) (x_seq n) Z‖ ≤ M_exhaust r
inductive ExpProfileKind where
  | firstField
  | secondField

noncomputable def frozenActionP (kind : ExpProfileKind) (lam J : ℂ) : ℂ :=
  match kind with
  | .firstField =>
      ∑' m : ℕ, (-1 : ℂ) ^ m * J ^ (2 * m + 3) * lam ^ (2 * m) /
        ((2 : ℂ) ^ (2 * m + 2) * ((2 * m + 3).factorial : ℂ))
  | .secondField =>
      (∑' m : ℕ, ((2 * m + 2 : ℕ) : ℂ) * J ^ (2 * m + 3) * lam ^ (2 * m) /
        (8 * (4 : ℂ) ^ m * ((2 * m + 3).factorial : ℂ))) /
        Complex.cosh (lam * J / 2)

noncomputable def frozenEnergyE (kind : ExpProfileKind) (lam J : ℂ) : ℂ :=
  J * deriv (frozenActionP kind lam) J - frozenActionP kind lam J

def IsRegularFrozenState (kind : ExpProfileKind) (lam J : ℂ) : Prop :=
  match kind with
  | .firstField =>
      J ≠ 0 ∧ deriv (deriv (frozenActionP .firstField lam)) J ≠ 0
  | .secondField =>
      J ≠ 0 ∧ Complex.cosh (lam * J / 2) ≠ 0 ∧
        deriv (deriv (frozenActionP .secondField lam)) J ≠ 0

structure ExpStripData where
  c : ℝ
  s_star : ℝ
  r_star : ℝ
  D_strip : Set ℂ
  ϕ : ℂ → ℂ
  f : ℂ → ℂ
  q : ℂ → ℂ
  Γ_base : ℂ → (Fin 2 → ℂ)
  Tube : Set (ℂ × ℂ)
  𝔰 : ℂ × ℂ → ℂ
  θ_edge : ℝ → ℝ → ℝ
  ℓ_chord : ℝ → ℝ → ℝ

noncomputable def FiniteWallNonisotropicStrip.toExpStripData
    (S : FiniteWallNonisotropicStrip) : ExpStripData where
  c := S.c
  s_star := S.s_star
  r_star := S.r_star
  D_strip := horizStrip S.H
  ϕ := S.ϕ
  f := S.f
  q := S.q
  Γ_base := S.Γ
  Tube := finiteWallTube S.r_star S.h_X
  𝔰 := S.𝔰
  θ_edge := fun x t => (S.Θ_gl ((x : ℂ) + (t : ℂ) / 2, (t : ℂ))).re
  ℓ_chord := S.ℓ_chord

def EntireNonisotropicStrip.toExpStripData
    (E : EntireNonisotropicStrip) : ExpStripData where
  c := E.c
  s_star := E.s_star
  r_star := E.r_star
  D_strip := Set.univ
  ϕ := E.ϕ
  f := E.f
  q := E.q
  Γ_base := E.Γ0
  Tube := E.T
  𝔰 := E.𝔰
  θ_edge := E.θ_edge
  ℓ_chord := E.ℓ_chord

structure IsExpObstructionStrip (X : ExpStripData) : Prop where
  c_pos : 0 < X.c
  s_star_pos : 0 < X.s_star
  r_star_pos : 0 < X.r_star
  r_star_lt_half_s_star : X.r_star < X.s_star / 2
  r_star_lt_pi : X.r_star < Real.pi
  D_strip_open : IsOpen X.D_strip
  D_strip_convex : Convex ℝ X.D_strip
  base_strip_subset : horizStrip X.s_star ⊆ X.D_strip
  D_strip_add_real : ∀ s ∈ X.D_strip, ∀ x : ℝ, s + (x : ℂ) ∈ X.D_strip
  D_strip_conj : ∀ s ∈ X.D_strip, starRingEnd ℂ s ∈ X.D_strip
  D_strip_vert_balanced : ∀ s ∈ X.D_strip, ∀ y : ℝ, |y| ≤ |s.im| →
    (s.re : ℂ) + (y : ℂ) * Complex.I ∈ X.D_strip
  ϕ_holo : DifferentiableOn ℂ X.ϕ X.D_strip
  f_holo : DifferentiableOn ℂ X.f X.D_strip
  q_holo : DifferentiableOn ℂ X.q X.D_strip
  deriv_ϕ : ∀ s ∈ X.D_strip, deriv X.ϕ s = X.f s
  deriv2_f : ∀ s ∈ X.D_strip, deriv (deriv X.f) s = X.q s * X.f s
  ϕ_quasiperiodic : ∀ s ∈ X.D_strip, X.ϕ (s + 2 * Real.pi) = X.ϕ s + 2 * Real.pi
  f_periodic : ∀ s ∈ X.D_strip, X.f (s + 2 * Real.pi) = X.f s
  q_periodic : ∀ s ∈ X.D_strip, X.q (s + 2 * Real.pi) = X.q s
  ϕ_conj : ∀ s ∈ X.D_strip, X.ϕ (starRingEnd ℂ s) = starRingEnd ℂ (X.ϕ s)
  f_conj : ∀ s ∈ X.D_strip, X.f (starRingEnd ℂ s) = starRingEnd ℂ (X.f s)
  q_conj : ∀ s ∈ X.D_strip, X.q (starRingEnd ℂ s) = starRingEnd ℂ (X.q s)
  f_real_pos : ∀ x : ℝ, 0 < (X.f x).re ∧ (X.f x).im = 0
  f_lower_strip_ne_zero : ∀ s ∈ horizStrip X.s_star, X.f s ≠ 0
  Γ_base_holo : DifferentiableOn ℂ (fun s => X.Γ_base s 0) (horizStrip X.s_star) ∧
    DifferentiableOn ℂ (fun s => X.Γ_base s 1) (horizStrip X.s_star)
  Γ_base_deriv₀ : ∀ s ∈ horizStrip X.s_star,
    deriv (fun z => X.Γ_base z 0) s = -X.c * (X.f s)⁻¹ ^ 2 * Complex.sin (X.ϕ s)
  Γ_base_deriv₁ : ∀ s ∈ horizStrip X.s_star,
    deriv (fun z => X.Γ_base z 1) s = X.c * (X.f s)⁻¹ ^ 2 * Complex.cos (X.ϕ s)
  Γ_base_periodic : ∀ s ∈ horizStrip X.s_star, X.Γ_base (s + 2 * Real.pi) = X.Γ_base s
  Γ_base_conj : ∀ s ∈ horizStrip X.s_star, ∀ i : Fin 2,
    X.Γ_base (starRingEnd ℂ s) i = starRingEnd ℂ (X.Γ_base s i)
  Tube_open : IsOpen X.Tube
  Tube_base_subset :
    ({ p : ℂ × ℂ | |p.1.im| < X.s_star ∧ ‖p.2‖ < X.r_star } ∪
      { p : ℂ × ℂ | p.1 ∈ X.D_strip ∧ p.2 = 0 }) ⊆ X.Tube
  Tube_param_subset : X.Tube ⊆ { p : ℂ × ℂ | ‖p.2‖ < X.r_star }
  Tube_vertically_star_shaped : ∀ y t : ℂ, (y, t) ∈ X.Tube → ∀ η : ℝ, 0 ≤ η → η ≤ 1 →
    ((y.re : ℂ) + ((η * y.im : ℝ) : ℂ) * Complex.I, t) ∈ X.Tube
  Tube_horiz_invariant : ∀ y t : ℂ, ∀ x : ℝ, (y, t) ∈ X.Tube → (y + (x : ℂ), t) ∈ X.Tube
  Tube_even : ∀ y t : ℂ, (y, t) ∈ X.Tube → (y, -t) ∈ X.Tube
  Tube_conj : ∀ y t : ℂ, (y, t) ∈ X.Tube →
    (starRingEnd ℂ y, starRingEnd ℂ t) ∈ X.Tube
  𝔰_holo : DifferentiableOn ℂ X.𝔰 X.Tube
  𝔰_maps_to : ∀ p ∈ X.Tube, X.𝔰 p ∈ X.D_strip
  𝔰_lower_strip_im : ∀ y t : ℂ, |y.im| < X.s_star / 2 → ‖t‖ < X.r_star →
    X.𝔰 (y, t) ∈ horizStrip X.s_star
  𝔰_zero : ∀ y ∈ X.D_strip, X.𝔰 (y, 0) = y
  𝔰_quasiperiodic : ∀ y t : ℂ, (y, t) ∈ X.Tube →
    X.𝔰 (y + 2 * Real.pi, t) = X.𝔰 (y, t) + 2 * Real.pi
  𝔰_even : ∀ y t : ℂ, (y, t) ∈ X.Tube → X.𝔰 (y, -t) = X.𝔰 (y, t)
  𝔰_conj : ∀ y t : ℂ, (y, t) ∈ X.Tube →
    X.𝔰 (starRingEnd ℂ y, starRingEnd ℂ t) = starRingEnd ℂ (X.𝔰 (y, t))
  𝔰_mean_zero : ∀ t : ℂ, ‖t‖ < X.r_star →
    (∫ x in (0 : ℝ)..(2 * Real.pi), (X.𝔰 (x, t) - x)) = 0
  real_collar_reflection : ∀ x t : ℝ, 0 < t → t < X.r_star →
    0 < deriv (fun x' : ℝ => (X.𝔰 (x', t)).re) x ∧
    0 < (X.𝔰 (x + t, t)).re - (X.𝔰 (x, t)).re ∧
    X.θ_edge (x - t) t + X.θ_edge x t = 2 * (X.ϕ (X.𝔰 (x, t))).re ∧
    X.θ_edge (x + 2 * Real.pi) t = X.θ_edge x t + 2 * Real.pi ∧
    0 < X.θ_edge x t - (X.ϕ (X.𝔰 (x, t))).re ∧
    X.θ_edge x t - (X.ϕ (X.𝔰 (x, t))).re < Real.pi / 2 ∧
    0 < X.ℓ_chord x t ∧
    X.Γ_base (X.𝔰 (x + t, t)) 0 - X.Γ_base (X.𝔰 (x, t)) 0 =
      -X.ℓ_chord x t * Real.sin (X.θ_edge x t) ∧
    X.Γ_base (X.𝔰 (x + t, t)) 1 - X.Γ_base (X.𝔰 (x, t)) 1 =
      X.ℓ_chord x t * Real.cos (X.θ_edge x t)
  real_vertical_promotion : ∀ t₀ x₀ b : ℝ, |t₀| < X.r_star → 0 < b →
    (∃ W : Set (ℂ × ℂ), IsOpen W ∧
      (∀ η : ℝ, 0 ≤ η → η ≤ b → ((x₀ : ℂ) + (η : ℝ) * Complex.I, (t₀ : ℂ)) ∈ W) ∧
      ∃ s_tilde : ℂ × ℂ → ℂ, DifferentiableOn ℂ s_tilde W ∧
        (∀ p ∈ W, s_tilde p ∈ X.D_strip) ∧
        ∃ δ₀ : ℝ, 0 < δ₀ ∧ ∀ y t : ℂ, ‖y - x₀‖ < δ₀ → ‖t - t₀‖ < δ₀ →
          (y, t) ∈ W ∧ s_tilde (y, t) = X.𝔰 (y, t)) →
    ∃ δ : ℝ, 0 < δ ∧
      { p : ℂ × ℂ | |p.1.im| ≤ b ∧ ‖p.2 - (t₀ : ℂ)‖ < δ } ⊆ X.Tube

structure ExpSequenceData (X : ExpStripData) (kind : ExpProfileKind) where
  x_seq : ℕ → ℝ
  h_seq : ℕ → ℝ
  ℓ_seq : ℕ → ℝ
  m_seq : ℕ → ℝ
  c₀ : ℂ
  c₀_ne_zero : c₀ ≠ 0
  ℓ_pos : ∀ n : ℕ, 0 < ℓ_seq n
  m_pos : ∀ n : ℕ, 0 < m_seq n
  m_tendsto : Filter.Tendsto m_seq Filter.atTop Filter.atTop
  b_tendsto : Filter.Tendsto (fun n => ℓ_seq n * m_seq n) Filter.atTop Filter.atTop
  h_div_ℓ_tendsto : Filter.Tendsto (fun n => h_seq n / ℓ_seq n) Filter.atTop Filter.atTop
  exhausts_ℂ : ∀ R_exh : ℝ, 0 < R_exh → ∃ N_exh : ℕ, ∀ n ≥ N_exh, ∀ Z : ℂ,
    ‖Z‖ ≤ R_exh →
      (x_seq n : ℂ) + (h_seq n : ℂ) * Complex.I + (ℓ_seq n : ℂ) * Z ∈ X.D_strip
  f_conv : TendstoLocallyUniformly
    (fun n Z =>
      ((m_seq n)⁻¹ : ℂ) *
        X.f ((x_seq n : ℂ) + (h_seq n : ℂ) * Complex.I + (ℓ_seq n : ℂ) * Z))
    (match kind with
     | .firstField => fun Z => c₀ * Complex.exp (-Complex.I * Z)
     | .secondField => fun _ => 0)
    Filter.atTop
  q_conv : TendstoLocallyUniformly
    (fun n Z =>
      (((m_seq n) ^ 2)⁻¹ : ℂ) *
        X.q ((x_seq n : ℂ) + (h_seq n : ℂ) * Complex.I + (ℓ_seq n : ℂ) * Z))
    (match kind with
     | .firstField => fun _ => 0
     | .secondField => fun Z => c₀ ^ 2 * Complex.exp (-2 * Complex.I * Z))
    Filter.atTop

structure ChordActionPackage (X : ExpStripData) where
  p_act : ℂ → ℂ → ℂ → ℂ
  η_sf : ℝ
  C_sf : ℝ
  r_rec : ℝ
  η_sf_pos : 0 < η_sf
  C_sf_pos : 0 < C_sf
  r_rec_pos : 0 < r_rec
  r_rec_lt : r_rec < X.r_star
  p_act_zero : ∀ s J : ℂ, p_act s J 0 = J ^ 3 / 24
  small_field : ∀ (s₀ : ℂ) (r_s r_t M₀ : ℝ),
    0 < r_s → 0 < r_t → 4 * r_t ≤ r_s → 0 ≤ M₀ → r_t * M₀ ≤ η_sf →
    Metric.ball s₀ r_s ⊆ X.D_strip →
    (∀ w ∈ Metric.ball s₀ r_s, ‖X.f w‖ ≤ M₀ ∧ Real.sqrt ‖X.q w‖ ≤ M₀) →
    DifferentiableOn ℂ (fun q : ℂ × ℂ × ℂ => p_act q.1 q.2.1 q.2.2)
      { q : ℂ × ℂ × ℂ | ‖q.1 - s₀‖ < r_s / 4 ∧ ‖q.2.1 - 1‖ < 1 / 4 ∧ ‖q.2.2‖ < r_t } ∧
    (∀ s J t : ℂ, ‖s - s₀‖ < r_s / 8 → ‖J - 1‖ < 1 / 8 → ‖t‖ < r_t / 2 →
      p_act (s + t * J) J (-t) = p_act s J t) ∧
    (∀ s J t : ℂ, ‖s - s₀‖ < r_s / 4 → ‖J - 1‖ < 1 / 4 → ‖t‖ < r_t →
      ‖p_act s J t - J ^ 3 / 24‖ ≤ C_sf * ‖t‖ ^ 2 * M₀ ^ 2)
  base_recurrence : ∀ y t : ℂ, |y.im| < X.s_star / 3 → 0 < ‖t‖ → ‖t‖ < r_rec →
    let s_prev := X.𝔰 (y - t, t)
    let s_curr := X.𝔰 (y, t)
    let s_next := X.𝔰 (y + t, t)
    let J_prev := (s_curr - s_prev) / t
    let J_curr := (s_next - s_curr) / t
    deriv (fun J' => p_act s_curr J' t) J_curr -
      t * deriv (fun s' => p_act s' J_curr t) s_curr =
      deriv (fun J' => p_act s_prev J' t) J_prev
  frozen_conv : ∀ (kind : ExpProfileKind) (seq : ExpSequenceData X kind)
      (S₀ J₀ T₀ : ℂ),
    IsRegularFrozenState kind (T₀ * seq.c₀ * Complex.exp (-Complex.I * S₀)) J₀ →
    ∃ (δ_reg : ℝ) (N_reg : ℕ), 0 < δ_reg ∧
      (∀ n ≥ N_reg,
        DifferentiableOn ℂ
          (fun q : ℂ × ℂ × ℂ =>
            p_act
              ((seq.x_seq n : ℂ) + (seq.h_seq n : ℂ) * Complex.I +
                (seq.ℓ_seq n : ℂ) * q.1)
              q.2.1
              (q.2.2 / (seq.m_seq n : ℂ)))
          { q : ℂ × ℂ × ℂ |
            ‖q.1 - S₀‖ < δ_reg ∧ ‖q.2.1 - J₀‖ < δ_reg ∧ ‖q.2.2 - T₀‖ < δ_reg }) ∧
      TendstoUniformlyOn
        (fun (n : ℕ) (q : ℂ × ℂ × ℂ) =>
          p_act
            ((seq.x_seq n : ℂ) + (seq.h_seq n : ℂ) * Complex.I +
              (seq.ℓ_seq n : ℂ) * q.1)
            q.2.1
            (q.2.2 / (seq.m_seq n : ℂ)))
        (fun q : ℂ × ℂ × ℂ =>
          frozenActionP kind (q.2.2 * seq.c₀ * Complex.exp (-Complex.I * q.1)) q.2.1)
        Filter.atTop
        { q : ℂ × ℂ × ℂ |
          ‖q.1 - S₀‖ < δ_reg ∧ ‖q.2.1 - J₀‖ < δ_reg ∧ ‖q.2.2 - T₀‖ < δ_reg }

def DeepInitializedModelData (X : ExpStripData) (P : ChordActionPackage X)
    (kind : ExpProfileKind) (seq : ExpSequenceData X kind) : Prop :=
  ∀ T_max : ℝ, 0 < T_max →
    ∃ (D₀ C_deep α : ℝ) (S_deep : ℂ × ℂ → ℂ),
      0 < D₀ ∧ 0 < C_deep ∧ 1 / 2 < α ∧ α < 1 ∧
      DifferentiableOn ℂ S_deep { p : ℂ × ℂ | D₀ < -p.1.im ∧ ‖p.2‖ < T_max } ∧
      (∀ Y T : ℂ, D₀ < -Y.im → ‖T‖ < T_max →
        ‖S_deep (Y, T) - Y‖ ≤ C_deep * ‖T‖ ^ 2 * (-Y.im) ^ (1 - 2 * α) ∧
        S_deep (Y, -T) = S_deep (Y, T) ∧
        frozenEnergyE kind
          (T * seq.c₀ * Complex.exp (-Complex.I * S_deep (Y, T)))
          (deriv (fun Y' => S_deep (Y', T)) Y) = 1 / 12) ∧
      (∀ Y : ℂ, D₀ < -Y.im → S_deep (Y, 0) = Y) ∧
      (∀ A D_top : ℝ, 0 < A → D₀ + 2 < D_top →
        ∃ (N_init : ℕ) (U_phys : ℕ → Set (ℂ × ℂ))
          (s_tilde : ℕ → ℂ × ℂ → ℂ) (δ_base : ℕ → ℝ),
          (∀ n ≥ N_init,
            let s_n : ℂ := (seq.x_seq n : ℂ) + (seq.h_seq n : ℂ) * Complex.I
            let coneSet : Set (ℂ × ℂ) :=
              { p : ℂ × ℂ |
                D₀ < -p.1.im ∧ -p.1.im < D_top ∧
                |p.1.re| < A * (-p.1.im) ∧ ‖p.2‖ < T_max }
            IsOpen (U_phys n) ∧
            0 < δ_base n ∧
            (∀ y t : ℂ, (y, t) ∈ U_phys n → 0 ≤ y.im →
              ∀ τ : ℝ, 0 ≤ τ → τ ≤ y.im →
                ((y.re : ℂ) + (τ : ℂ) * Complex.I, t) ∈ U_phys n) ∧
            (∀ y t : ℂ, (y, t) ∈ U_phys n → (y, -t) ∈ U_phys n) ∧
            DifferentiableOn ℂ (s_tilde n) (U_phys n) ∧
            (∀ p ∈ U_phys n, s_tilde n p ∈ X.D_strip) ∧
            (∀ y t : ℂ, (y, t) ∈ U_phys n → s_tilde n (y, -t) = s_tilde n (y, t)) ∧
            (∀ y t : ℂ, |y.im| < δ_base n → ‖t‖ < T_max / seq.m_seq n →
              (y, t) ∈ U_phys n ∧ (y, t) ∈ X.Tube ∧ s_tilde n (y, t) = X.𝔰 (y, t)) ∧
            (∀ p ∈ coneSet,
              (s_n + (seq.ℓ_seq n : ℂ) * p.1, p.2 / (seq.m_seq n : ℂ)) ∈ U_phys n ∧
              0 < (s_n + (seq.ℓ_seq n : ℂ) * p.1).im) ∧
            (∀ Y T : ℂ, T ≠ 0 →
              (Y, T) ∈ coneSet →
              (Y - T / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ), T) ∈ coneSet →
              (Y + T / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ), T) ∈ coneSet →
              let t : ℂ := T / (seq.m_seq n : ℂ)
              let y : ℂ := s_n + (seq.ℓ_seq n : ℂ) * Y
              let s_prev : ℂ := s_tilde n (y - t, t)
              let s_curr : ℂ := s_tilde n (y, t)
              let s_next : ℂ := s_tilde n (y + t, t)
              let J_prev : ℂ := (s_curr - s_prev) / t
              let J_curr : ℂ := (s_next - s_curr) / t
              deriv (fun J' => P.p_act s_curr J' t) J_curr -
                t * deriv (fun s' => P.p_act s' J_curr t) s_curr =
                deriv (fun J' => P.p_act s_prev J' t) J_prev)) ∧
          (∀ K : Set (ℂ × ℂ), IsCompact K →
            K ⊆ { p : ℂ × ℂ |
              D₀ < -p.1.im ∧ -p.1.im < D_top ∧
              |p.1.re| < A * (-p.1.im) ∧ ‖p.2‖ < T_max } →
            ∀ ε : ℝ, 0 < ε → ∃ N₁ : ℕ, N_init ≤ N₁ ∧ ∀ n ≥ N₁, ∀ p ∈ K,
              let s_n : ℂ := (seq.x_seq n : ℂ) + (seq.h_seq n : ℂ) * Complex.I
              ‖(s_tilde n (s_n + (seq.ℓ_seq n : ℂ) * p.1, p.2 / (seq.m_seq n : ℂ)) - s_n) /
                  (seq.ℓ_seq n : ℂ) - S_deep p‖ < ε))

def branchSectorPlus (R ν θ δ_θ : ℝ) : Set ℂ :=
  { w : ℂ | 0 < w.re ∧ R * Real.exp (-4 * ν) < ‖w‖ ∧ ‖w‖ < R * Real.exp (2 * ν) ∧
    |Complex.arg w - θ| < 2 * δ_θ }

def branchSectorMinus (R ν θ δ_θ : ℝ) : Set ℂ :=
  { w : ℂ | 0 < w.re ∧ R * Real.exp (-4 * ν) < ‖w‖ ∧ ‖w‖ < R * Real.exp (2 * ν) ∧
    |Complex.arg w + θ| < 2 * δ_θ }

def branchInnerDomain (R ν θ δ_θ : ℝ) : Set ℂ :=
  Metric.ball (0 : ℂ) R ∪ branchSectorPlus R ν θ δ_θ ∪ branchSectorMinus R ν θ δ_θ

def branchOuterDomain (R ν θ δ_θ : ℝ) : Set ℂ :=
  { w : ℂ | 0 < w.re ∧ R < ‖w‖ ∧ ‖w‖ < R * Real.exp ν ∧
    |Complex.arg w| < θ + δ_θ }

structure BranchMonodromyPackage (kind : ExpProfileKind) where
  R : ℝ
  ν : ℝ
  θ : ℝ
  δ_θ : ℝ
  r_uniq : ℝ
  Δ_inner : ℂ → ℂ
  Δ_outer : ℂ → ℂ
  R_pos : 0 < R
  ν_pos : 0 < ν
  ν_lt_one : ν < 1
  θ_pos : 0 < θ
  θ_lt : θ < Real.pi / 4
  δ_θ_pos : 0 < δ_θ
  δ_θ_lt : δ_θ < θ / 2
  r_uniq_pos : 0 < r_uniq
  r_uniq_lt : r_uniq < R
  Δ_inner_holo : DifferentiableOn ℂ Δ_inner (branchInnerDomain R ν θ δ_θ)
  Δ_outer_holo : DifferentiableOn ℂ Δ_outer (branchOuterDomain R ν θ δ_θ)
  Δ_inner_zero : Δ_inner 0 = 0
  Δ_inner_even_ball : ∀ w ∈ Metric.ball (0 : ℂ) R, Δ_inner (-w) = Δ_inner w
  local_uniqueness : ∀ (w_coeff : ℂ) (D₁ : ℝ) (S_loc : ℂ → ℂ),
    0 < D₁ →
    DifferentiableOn ℂ S_loc { Y : ℂ | D₁ < -Y.im } →
    (∀ ε : ℝ, 0 < ε → ∃ D₂ : ℝ, D₁ < D₂ ∧ ∀ Y : ℂ, D₂ < -Y.im → ‖S_loc Y - Y‖ < ε) →
    (∀ Y : ℂ, D₁ < -Y.im → ‖w_coeff * Complex.exp (-Complex.I * Y)‖ < r_uniq) →
    (∀ Y : ℂ, D₁ < -Y.im →
      frozenEnergyE kind
        (w_coeff * Complex.exp (-Complex.I * S_loc Y))
        (deriv S_loc Y) = 1 / 12) →
    ∀ Y : ℂ, D₁ < -Y.im →
      S_loc Y = Y + Δ_inner (w_coeff * Complex.exp (-Complex.I * Y))
  inner_regular_energy : ∀ w ∈ branchInnerDomain R ν θ δ_θ,
    let lam := w * Complex.exp (-Complex.I * Δ_inner w)
    let J := 1 - Complex.I * w * deriv Δ_inner w
    frozenEnergyE kind lam J = 1 / 12 ∧ IsRegularFrozenState kind lam J
  outer_regular_energy : ∀ w ∈ branchOuterDomain R ν θ δ_θ,
    let lam := w * Complex.exp (-Complex.I * Δ_outer w)
    let J := 1 - Complex.I * w * deriv Δ_outer w
    frozenEnergyE kind lam J = 1 / 12 ∧ IsRegularFrozenState kind lam J
  overlap_plus_eq : ∀ w ∈ branchOuterDomain R ν θ δ_θ ∩ branchSectorPlus R ν θ δ_θ,
    Δ_outer w = Δ_inner w
  monodromy_minus_ne : ∀ u : ℝ, 0 < u → u < ν →
    let w_minus := (R : ℂ) * Complex.exp ((u : ℂ) - (θ : ℂ) * Complex.I)
    Δ_outer w_minus ≠ Δ_inner w_minus
noncomputable def shiftWidthENNR (w : ENNReal) (δ : ℝ) : ENNReal :=
  if w = ⊤ then ⊤ else ENNReal.ofReal (w.toReal + δ)

def shiftedMeroTube (r_star : ℝ) (h_X : ℂ → ENNReal) (b_shift : ℂ → ℂ) : Set (ℂ × ℂ) :=
  meroTubeENNR r_star (fun t => shiftWidthENNR (h_X t) (b_shift t).im)

def shiftedLiftMap (𝔰_raw : ℂ × ℂ → ℂ) (b_shift : ℂ → ℂ) (p : ℂ × ℂ) : ℂ :=
  𝔰_raw (p.1 - b_shift p.2, p.2)

noncomputable def shiftedGlancingTheta {Ω : Set Plane} (C : AnalyticGlancingCollar Ω)
    (b_shift : ℂ → ℂ) (p : ℂ × ℂ) : ℂ :=
  glancingTheta C (p.1 - b_shift p.2) p.2

noncomputable def shiftedGlancingOffset {Ω : Set Plane} (C : AnalyticGlancingCollar Ω)
    (b_shift : ℂ → ℂ) (p : ℂ × ℂ) : ℂ :=
  glancingOffset C (p.1 - b_shift p.2) p.2

structure NonisotropicCurveData {Ω : Set Plane} (C : AnalyticGlancingCollar Ω)
    (M : MeromorphicCollarData C) where
  a : ℂ → ℂ
  ϕ : ℂ → ℂ
  f : ℂ → ℂ
  a_holo : DifferentiableOn ℂ a (horizStripENNR (M.h_X 0))
  ϕ_holo : DifferentiableOn ℂ ϕ (horizStripENNR (M.h_X 0))
  f_holo : DifferentiableOn ℂ f (horizStripENNR (M.h_X 0))
  a_ne_zero : ∀ s ∈ horizStripENNR (M.h_X 0), a s ≠ 0
  deriv_ϕ : ∀ s ∈ horizStripENNR (M.h_X 0), deriv ϕ s = f s
  exp_ϕ : ∀ s ∈ horizStripENNR (M.h_X 0), Complex.exp (Complex.I * ϕ s) = a s
  deriv_a : ∀ s ∈ horizStripENNR (M.h_X 0), deriv a s = Complex.I * f s * a s
  base_ϕ_eq : ∀ s ∈ horizStrip M.s_base, ϕ s = C.ϕ_ℂ s ∧ f s = deriv C.ϕ_ℂ s
  ϕ_quasiperiodic : ∀ s ∈ horizStripENNR (M.h_X 0), ϕ (s + 2 * Real.pi) = ϕ s + 2 * Real.pi
  f_periodic : ∀ s ∈ horizStripENNR (M.h_X 0), f (s + 2 * Real.pi) = f s
  a_periodic : ∀ s ∈ horizStripENNR (M.h_X 0), a (s + 2 * Real.pi) = a s
  ϕ_conj : ∀ s ∈ horizStripENNR (M.h_X 0), ϕ (starRingEnd ℂ s) = starRingEnd ℂ (ϕ s)
  f_conj : ∀ s ∈ horizStripENNR (M.h_X 0), f (starRingEnd ℂ s) = starRingEnd ℂ (f s)
  f_real_pos : ∀ x : ℝ, 0 < (f x).re ∧ (f x).im = 0
  f_base_ne_zero : ∀ s ∈ horizStrip M.s_base, f s ≠ 0
  f_nonconstant : ∃ x : ℝ, deriv f x ≠ 0
  Γ : ℂ → (Fin 2 → ℂ)
  Γ_mero : MeromorphicOn (fun s => Γ s 0) (horizStripENNR (M.h_X 0)) ∧
    MeromorphicOn (fun s => Γ s 1) (horizStripENNR (M.h_X 0))
  Γ_reg_holo : ∀ s ∈ horizStripENNR (M.h_X 0), f s ≠ 0 →
    DifferentiableAt ℂ (fun z => Γ z 0) s ∧ DifferentiableAt ℂ (fun z => Γ z 1) s
  Γ_deriv₀ : ∀ s ∈ horizStripENNR (M.h_X 0), f s ≠ 0 →
    deriv (fun z => Γ z 0) s = -C.c * (f s)⁻¹ ^ 2 * Complex.sin (ϕ s)
  Γ_deriv₁ : ∀ s ∈ horizStripENNR (M.h_X 0), f s ≠ 0 →
    deriv (fun z => Γ z 1) s = C.c * (f s)⁻¹ ^ 2 * Complex.cos (ϕ s)
  Γ_periodic : ∀ s ∈ horizStripENNR (M.h_X 0), f s ≠ 0 → Γ (s + 2 * Real.pi) = Γ s
  Γ_conj : ∀ s ∈ horizStripENNR (M.h_X 0), f s ≠ 0 → ∀ i : Fin 2,
    Γ (starRingEnd ℂ s) i = starRingEnd ℂ (Γ s i)
  Γ_base_eq : ∀ s ∈ horizStrip M.s_base, Γ s = glancingBoundaryCurve C s
  Γ_slice_eq : ∀ s ∈ horizStripENNR (M.h_X 0), s ∉ M.E_disc → f s ≠ 0 → Γ s = M.Γ_slice s
  Γ_real_simple : ∀ x₁ x₂ : ℝ, Γ x₁ = Γ x₂ → ∃ k : ℤ, x₁ - x₂ = k * (2 * Real.pi)
  no_1d_patch_Γ : ∀ (H₀ x_star sgn ε : ℝ),
    M.h_X 0 = ENNReal.ofReal H₀ → (sgn = 1 ∨ sgn = -1) → 0 < ε →
    ¬ ∃ g : Fin 2 → ℂ → ℂ,
      MeromorphicOn (g 0)
        (Metric.ball ((x_star : ℂ) + ((sgn * H₀ : ℝ) : ℂ) * Complex.I) ε) ∧
      MeromorphicOn (g 1)
        (Metric.ball ((x_star : ℂ) + ((sgn * H₀ : ℝ) : ℂ) * Complex.I) ε) ∧
      ∃ V_overlap : Set ℂ,
        IsOpen V_overlap ∧ V_overlap.Nonempty ∧
        V_overlap ⊆
          Metric.ball ((x_star : ℂ) + ((sgn * H₀ : ℝ) : ℂ) * Complex.I) ε ∩
            horizStrip H₀ ∧
        ∀ i : Fin 2, ∀ z ∈ V_overlap, g i z = Γ z i
  s_init : ℝ
  r_init : ℝ
  s_init_pos : 0 < s_init
  s_init_le : s_init ≤ M.s_base / 2
  r_init_pos : 0 < r_init
  r_init_lt : r_init < s_init / 4
  r_init_le : r_init ≤ M.r_base / 2
  𝔰_init : ℂ × ℂ → ℂ
  𝔰_init_holo : DifferentiableOn ℂ 𝔰_init { p : ℂ × ℂ | |p.1.im| < s_init ∧ ‖p.2‖ < r_init }
  𝔰_init_maps_to : ∀ y t : ℂ, |y.im| < s_init → ‖t‖ < r_init →
    𝔰_init (y, t) ∈ horizStrip M.s_base
  𝔰_init_ϕ : ∀ y t : ℂ, |y.im| < s_init → ‖t‖ < r_init →
    ϕ (𝔰_init (y, t)) = glancingMidAngle C y t
  𝔰_init_impact : ∀ y t : ℂ, |y.im| < s_init → ‖t‖ < r_init →
    glancingImpact C y t = Γ (𝔰_init (y, t))
  𝔰_init_zero : ∀ y : ℂ, |y.im| < s_init → 𝔰_init (y, 0) = y
  𝔰_init_quasiperiodic : ∀ y t : ℂ, |y.im| < s_init → ‖t‖ < r_init →
    𝔰_init (y + 2 * Real.pi, t) = 𝔰_init (y, t) + 2 * Real.pi
  𝔰_init_even : ∀ y t : ℂ, |y.im| < s_init → ‖t‖ < r_init → 𝔰_init (y, -t) = 𝔰_init (y, t)
  𝔰_init_conj : ∀ y t : ℂ, |y.im| < s_init → ‖t‖ < r_init →
    𝔰_init (starRingEnd ℂ y, starRingEnd ℂ t) = starRingEnd ℂ (𝔰_init (y, t))

structure NormalizedGlobalLiftData {Ω : Set Plane} (C : AnalyticGlancingCollar Ω)
    (M : MeromorphicCollarData C) (K : NonisotropicCurveData C M) where
  𝔰_raw : ℂ × ℂ → ℂ
  𝔰_raw_holo : DifferentiableOn ℂ 𝔰_raw (meroTubeENNR M.r_base M.h_X)
  𝔰_raw_maps_to : ∀ p ∈ meroTubeENNR M.r_base M.h_X, 𝔰_raw p ∈ horizStripENNR (M.h_X 0)
  𝔰_raw_init_eq : ∀ y t : ℂ, |y.im| < K.s_init → ‖t‖ < K.r_init →
    𝔰_raw (y, t) = K.𝔰_init (y, t)
  𝔰_raw_zero : ∀ y ∈ horizStripENNR (M.h_X 0), 𝔰_raw (y, 0) = y
  𝔰_raw_quasiperiodic : ∀ p ∈ meroTubeENNR M.r_base M.h_X,
    𝔰_raw (p.1 + 2 * Real.pi, p.2) = 𝔰_raw p + 2 * Real.pi
  𝔰_raw_even : ∀ p ∈ meroTubeENNR M.r_base M.h_X, 𝔰_raw (p.1, -p.2) = 𝔰_raw p
  𝔰_raw_conj : ∀ p ∈ meroTubeENNR M.r_base M.h_X,
    𝔰_raw (starRingEnd ℂ p.1, starRingEnd ℂ p.2) = starRingEnd ℂ (𝔰_raw p)
  𝔰_raw_comp_X : ∀ p ∈ meroTubeENNR M.r_base M.h_X, K.f (𝔰_raw p) ≠ 0 →
    ∃ r : ℝ, 0 < r ∧ Metric.ball p r ⊆ meroTubeENNR M.r_base M.h_X ∧
      (∀ q ∈ Metric.ball p r, K.f (𝔰_raw q) ≠ 0) ∧
      ∀ i : Fin 2, MeroAgreesHolo (M.X_mero i) (fun q => K.Γ (𝔰_raw q) i) (Metric.ball p r)
  b_shift : ℂ → ℂ
  s_star : ℝ
  r_star : ℝ
  s_star_pos : 0 < s_star
  s_star_le : s_star ≤ K.s_init / 2
  r_star_pos : 0 < r_star
  r_star_lt_half_s_star : r_star < s_star / 2
  r_star_lt_pi : r_star < Real.pi
  r_star_le : r_star ≤ K.r_init / 2
  b_shift_holo : DifferentiableOn ℂ b_shift (Metric.ball (0 : ℂ) M.r_base)
  b_shift_zero : b_shift 0 = 0
  b_shift_even : ∀ t ∈ Metric.ball (0 : ℂ) M.r_base, b_shift (-t) = b_shift t
  b_shift_conj : ∀ t ∈ Metric.ball (0 : ℂ) M.r_base,
    b_shift (starRingEnd ℂ t) = starRingEnd ℂ (b_shift t)
  b_shift_small : ∀ t ∈ Metric.ball (0 : ℂ) r_star, ‖b_shift t‖ < s_star / 4
  T_norm_iff : ∀ p : ℂ × ℂ, p ∈ shiftedMeroTube r_star M.h_X b_shift ↔
    ‖p.2‖ < r_star ∧ (p.1 - b_shift p.2, p.2) ∈ meroTubeENNR M.r_base M.h_X
  𝔰_holo : DifferentiableOn ℂ (shiftedLiftMap 𝔰_raw b_shift)
    (shiftedMeroTube r_star M.h_X b_shift)
  𝔰_maps_to : ∀ p ∈ shiftedMeroTube r_star M.h_X b_shift,
    shiftedLiftMap 𝔰_raw b_shift p ∈ horizStripENNR (M.h_X 0)
  𝔰_lower_strip_im : ∀ y t : ℂ, |y.im| < s_star / 2 → ‖t‖ < r_star →
    shiftedLiftMap 𝔰_raw b_shift (y, t) ∈ horizStrip s_star
  𝔰_zero : ∀ y ∈ horizStripENNR (M.h_X 0), shiftedLiftMap 𝔰_raw b_shift (y, 0) = y
  𝔰_quasiperiodic : ∀ p ∈ shiftedMeroTube r_star M.h_X b_shift,
    shiftedLiftMap 𝔰_raw b_shift (p.1 + 2 * Real.pi, p.2) =
      shiftedLiftMap 𝔰_raw b_shift p + 2 * Real.pi
  𝔰_even : ∀ p ∈ shiftedMeroTube r_star M.h_X b_shift,
    shiftedLiftMap 𝔰_raw b_shift (p.1, -p.2) = shiftedLiftMap 𝔰_raw b_shift p
  𝔰_conj : ∀ p ∈ shiftedMeroTube r_star M.h_X b_shift,
    shiftedLiftMap 𝔰_raw b_shift (starRingEnd ℂ p.1, starRingEnd ℂ p.2) =
      starRingEnd ℂ (shiftedLiftMap 𝔰_raw b_shift p)
  𝔰_mean_zero : ∀ t : ℂ, ‖t‖ < r_star →
    (∫ x in (0 : ℝ)..(2 * Real.pi), (shiftedLiftMap 𝔰_raw b_shift (x, t) - x)) = 0
  zero_slice_nhd : ∀ y₀ ∈ horizStripENNR (M.h_X 0), ∃ δ_y δ_t : ℝ,
    0 < δ_y ∧ 0 < δ_t ∧ δ_t ≤ r_star ∧
    Metric.ball y₀ δ_y ×ˢ Metric.ball (0 : ℂ) δ_t ⊆ shiftedMeroTube r_star M.h_X b_shift
  Θ_gl_holo : DifferentiableOn ℂ (shiftedGlancingTheta C b_shift)
    { p : ℂ × ℂ | |p.1.im| < s_star ∧ ‖p.2‖ < r_star }
  p_gl_holo : DifferentiableOn ℂ (shiftedGlancingOffset C b_shift)
    { p : ℂ × ℂ | |p.1.im| < s_star ∧ ‖p.2‖ < r_star }
  symplectic_gl : ∀ y t : ℂ, |y.im| < s_star → ‖t‖ < r_star →
    deriv (fun y' : ℂ => shiftedGlancingOffset C b_shift (y', t)) y *
      deriv (fun t' : ℂ => shiftedGlancingTheta C b_shift (y, t')) t -
    deriv (fun t' : ℂ => shiftedGlancingOffset C b_shift (y, t')) t *
      deriv (fun y' : ℂ => shiftedGlancingTheta C b_shift (y', t)) y = C.A t

noncomputable abbrev NormalizedGlobalLiftData.h_X_ennr {Ω : Set Plane}
    {C : AnalyticGlancingCollar Ω} {M : MeromorphicCollarData C} {K : NonisotropicCurveData C M}
    (L : NormalizedGlobalLiftData C M K) (t : ℂ) : ENNReal :=
  shiftWidthENNR (M.h_X t) (L.b_shift t).im

abbrev NormalizedGlobalLiftData.T_norm {Ω : Set Plane}
    {C : AnalyticGlancingCollar Ω} {M : MeromorphicCollarData C} {K : NonisotropicCurveData C M}
    (L : NormalizedGlobalLiftData C M K) : Set (ℂ × ℂ) :=
  shiftedMeroTube L.r_star M.h_X L.b_shift

abbrev NormalizedGlobalLiftData.𝔰 {Ω : Set Plane}
    {C : AnalyticGlancingCollar Ω} {M : MeromorphicCollarData C} {K : NonisotropicCurveData C M}
    (L : NormalizedGlobalLiftData C M K) : ℂ × ℂ → ℂ :=
  shiftedLiftMap L.𝔰_raw L.b_shift

noncomputable abbrev NormalizedGlobalLiftData.Θ_gl {Ω : Set Plane}
    {C : AnalyticGlancingCollar Ω} {M : MeromorphicCollarData C} {K : NonisotropicCurveData C M}
    (L : NormalizedGlobalLiftData C M K) : ℂ × ℂ → ℂ :=
  shiftedGlancingTheta C L.b_shift

noncomputable abbrev NormalizedGlobalLiftData.p_gl {Ω : Set Plane}
    {C : AnalyticGlancingCollar Ω} {M : MeromorphicCollarData C} {K : NonisotropicCurveData C M}
    (L : NormalizedGlobalLiftData C M K) : ℂ × ℂ → ℂ :=
  shiftedGlancingOffset C L.b_shift

structure SpeedAndCollarPackage {Ω : Set Plane} (C : AnalyticGlancingCollar Ω)
    (M : MeromorphicCollarData C) (K : NonisotropicCurveData C M)
    (L : NormalizedGlobalLiftData C M K) where
  q : ℂ → ℂ
  H0 : ℂ → ℂ
  V : ℂ → ℂ
  ℓ_chord : ℝ → ℝ → ℝ
  f_simple_zeros : ∀ s ∈ horizStripENNR (M.h_X 0),
    K.f s = 0 → deriv K.f s ≠ 0 ∧ deriv (deriv K.f) s = 0
  q_holo : DifferentiableOn ℂ q (horizStripENNR (M.h_X 0))
  deriv2_f : ∀ s ∈ horizStripENNR (M.h_X 0), deriv (deriv K.f) s = q s * K.f s
  q_periodic : ∀ s ∈ horizStripENNR (M.h_X 0), q (s + 2 * Real.pi) = q s
  q_conj : ∀ s ∈ horizStripENNR (M.h_X 0), q (starRingEnd ℂ s) = starRingEnd ℂ (q s)
  H0_holo : DifferentiableOn ℂ H0 (horizStripENNR (M.h_X 0))
  H0_periodic : ∀ s ∈ horizStripENNR (M.h_X 0), H0 (s + 2 * Real.pi) = H0 s
  H0_conj : ∀ s ∈ horizStripENNR (M.h_X 0), H0 (starRingEnd ℂ s) = starRingEnd ℂ (H0 s)
  H0_eq : ∀ s ∈ horizStripENNR (M.h_X 0), K.f s ≠ 0 →
    H0 s = K.Γ s 0 * Complex.cos (K.ϕ s) + K.Γ s 1 * Complex.sin (K.ϕ s)
  H0_deriv : ∀ s ∈ horizStripENNR (M.h_X 0), K.f s ≠ 0 →
    deriv H0 s = (-K.Γ s 0 * Complex.sin (K.ϕ s) + K.Γ s 1 * Complex.cos (K.ϕ s)) * K.f s
  V_holo : DifferentiableOn ℂ V (horizStripENNR (M.h_X 0))
  V_periodic : ∀ s ∈ horizStripENNR (M.h_X 0), V (s + 2 * Real.pi) = V s
  V_conj : ∀ s ∈ horizStripENNR (M.h_X 0), V (starRingEnd ℂ s) = starRingEnd ℂ (V s)
  V_mean_zero : (∫ x in (0 : ℝ)..(2 * Real.pi), V x) = 0
  𝔰_deriv_t_zero : ∀ y ∈ horizStripENNR (M.h_X 0), deriv (fun t : ℂ => L.𝔰 (y, t)) 0 = 0
  𝔰_deriv2_t_zero : ∀ y ∈ horizStripENNR (M.h_X 0),
    deriv (deriv (fun t : ℂ => L.𝔰 (y, t))) 0 = 2 * V y
  V_deriv : ∀ s ∈ horizStripENNR (M.h_X 0),
    deriv V s = (1 / 120 : ℂ) *
      (K.f s ^ 2 + 8 * q s -
        (2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi), (K.f x ^ 2 + 8 * q x))
  real_collar_chord : ∀ x t : ℝ, 0 < t → t < L.r_star →
    (L.Θ_gl (x + t / 2, t)).im = 0 ∧
    (L.p_gl (x + t / 2, t)).im = 0 ∧
    0 < deriv (fun x' : ℝ => (L.𝔰 (x', t)).re) x ∧
    0 < (L.𝔰 (x + t, t)).re - (L.𝔰 (x, t)).re ∧
    (L.Θ_gl (x - t / 2, t)).re + (L.Θ_gl (x + t / 2, t)).re = 2 * (K.ϕ (L.𝔰 (x, t))).re ∧
    (L.Θ_gl (x + 2 * Real.pi + t / 2, t)).re = (L.Θ_gl (x + t / 2, t)).re + 2 * Real.pi ∧
    0 < (L.Θ_gl (x + t / 2, t)).re - (K.ϕ (L.𝔰 (x, t))).re ∧
    (L.Θ_gl (x + t / 2, t)).re - (K.ϕ (L.𝔰 (x, t))).re < Real.pi / 2 ∧
    0 < ℓ_chord x t ∧
    K.Γ (L.𝔰 (x + t, t)) 0 - K.Γ (L.𝔰 (x, t)) 0 =
      -ℓ_chord x t * Real.sin ((L.Θ_gl (x + t / 2, t)).re) ∧
    K.Γ (L.𝔰 (x + t, t)) 1 - K.Γ (L.𝔰 (x, t)) 1 =
      ℓ_chord x t * Real.cos ((L.Θ_gl (x + t / 2, t)).re) ∧
    L.p_gl (x + t / 2, t) =
      K.Γ (L.𝔰 (x, t)) 0 * Real.cos ((L.Θ_gl (x + t / 2, t)).re) +
        K.Γ (L.𝔰 (x, t)) 1 * Real.sin ((L.Θ_gl (x + t / 2, t)).re)

structure EntireTubeObstructionData {Ω : Set Plane} (C : AnalyticGlancingCollar Ω)
    (M : MeromorphicCollarData C) (K : NonisotropicCurveData C M)
    (L : NormalizedGlobalLiftData C M K) where
  T_open : IsOpen L.T_norm
  T_base_subset :
    ({ p : ℂ × ℂ | |p.1.im| < L.s_star ∧ ‖p.2‖ < L.r_star } ∪
      { p : ℂ × ℂ | p.2 = 0 }) ⊆ L.T_norm
  T_param_subset : L.T_norm ⊆ { p : ℂ × ℂ | ‖p.2‖ < L.r_star }
  T_vertically_star_shaped : ∀ y t : ℂ, (y, t) ∈ L.T_norm → ∀ η : ℝ, 0 ≤ η → η ≤ 1 →
    ((y.re : ℂ) + ((η * y.im : ℝ) : ℂ) * Complex.I, t) ∈ L.T_norm
  T_horiz_invariant : ∀ y t : ℂ, ∀ x : ℝ, (y, t) ∈ L.T_norm → (y + x, t) ∈ L.T_norm
  T_even : ∀ y t : ℂ, (y, t) ∈ L.T_norm → (y, -t) ∈ L.T_norm
  T_conj : ∀ y t : ℂ, (y, t) ∈ L.T_norm → (starRingEnd ℂ y, starRingEnd ℂ t) ∈ L.T_norm
  real_vertical_promotion : ∀ t₀ x₀ b : ℝ, |t₀| < L.r_star → 0 < b →
    (∃ W : Set (ℂ × ℂ), IsOpen W ∧
      (∀ η : ℝ, 0 ≤ η → η ≤ b → ((x₀ : ℂ) + (η : ℝ) * Complex.I, (t₀ : ℂ)) ∈ W) ∧
      ∃ s_tilde : ℂ × ℂ → ℂ, DifferentiableOn ℂ s_tilde W ∧
        ∃ δ₀ : ℝ, 0 < δ₀ ∧ ∀ y t : ℂ, ‖y - x₀‖ < δ₀ → ‖t - t₀‖ < δ₀ →
          (y, t) ∈ W ∧ s_tilde (y, t) = L.𝔰 (y, t)) →
    ∃ δ : ℝ, 0 < δ ∧
      { p : ℂ × ℂ | |p.1.im| ≤ b ∧ ‖p.2 - (t₀ : ℂ)‖ < δ } ⊆ L.T_norm

structure FiniteWallTubeObstructionData {Ω : Set Plane} (C : AnalyticGlancingCollar Ω)
    (M : MeromorphicCollarData C) (K : NonisotropicCurveData C M)
    (L : NormalizedGlobalLiftData C M K) (H : ℝ) where
  h_X : ℂ → ℝ
  tube_eq : finiteWallTube L.r_star h_X = L.T_norm
  H_pos : 0 < H
  s_star_lt_H : L.s_star < H
  h_X_bounds : ∀ t ∈ Metric.ball (0 : ℂ) L.r_star, L.s_star ≤ h_X t ∧ h_X t ≤ H
  h_X_zero : h_X 0 = H
  h_X_even : ∀ t ∈ Metric.ball (0 : ℂ) L.r_star, h_X (-t) = h_X t
  h_X_lsc : LowerSemicontinuousOn h_X (Metric.ball (0 : ℂ) L.r_star)
  tube_open : IsOpen (finiteWallTube L.r_star h_X)
  deficit_subharmonic : ∀ t₀ : ℂ, ∀ ρ : ℝ, 0 < ρ → ‖t₀‖ + ρ < L.r_star →
    MeasureTheory.IntegrableOn
      (fun θ : ℝ => H - h_X (t₀ + (ρ : ℂ) * Complex.exp ((θ : ℂ) * Complex.I)))
      (Set.Icc 0 (2 * Real.pi)) MeasureTheory.volume ∧
    H - h_X t₀ ≤ (2 * Real.pi)⁻¹ *
      ∫ θ in (0 : ℝ)..(2 * Real.pi),
        (H - h_X (t₀ + (ρ : ℂ) * Complex.exp ((θ : ℂ) * Complex.I)))
  no_patch_at_real_wall : ∀ t₀ x₀ ε : ℝ, |t₀| < L.r_star → 0 < ε → ε < L.s_star →
    ¬ ∃ g : ℂ × ℂ → ℂ,
      DifferentiableOn ℂ g
        { p : ℂ × ℂ |
          ‖p.1 - ((x₀ : ℂ) + (h_X t₀ : ℂ) * Complex.I)‖ < ε ∧
          ‖p.2 - (t₀ : ℂ)‖ < ε } ∧
      (∀ p : ℂ × ℂ,
        ‖p.1 - ((x₀ : ℂ) + (h_X t₀ : ℂ) * Complex.I)‖ < ε →
        ‖p.2 - (t₀ : ℂ)‖ < ε → g p ∈ horizStrip H) ∧
      ∃ δ : ℝ, 0 < δ ∧ δ ≤ ε ∧
        ∀ p : ℂ × ℂ,
          |p.1.re - x₀| < ε / 4 →
          |p.1.im - (h_X t₀ - ε / 2)| < ε / 4 →
          ‖p.2 - (t₀ : ℂ)‖ < δ → g p = L.𝔰 p
  no_full_scale_cone_passage : ∀ δ_star : ℝ, 0 < δ_star → δ_star < H - L.s_star →
    ∃ d₀ : ℝ, 0 < d₀ ∧ ∀ d x₀ : ℝ, 0 < d → d < d₀ →
      ¬ ∃ s_tilde : ℂ × ℂ → ℂ,
        DifferentiableOn ℂ s_tilde
          { p : ℂ × ℂ |
            d / 10 < H - p.1.im ∧ H - p.1.im < δ_star ∧
            |p.1.re - x₀| < 50 * (H - p.1.im) ∧ ‖p.2‖ < 2 * d } ∧
        (∀ p : ℂ × ℂ,
          d / 10 < H - p.1.im → H - p.1.im < δ_star →
          |p.1.re - x₀| < 50 * (H - p.1.im) → ‖p.2‖ < 2 * d →
          s_tilde p ∈ horizStrip H) ∧
        ∃ η : ℝ, 0 < η ∧
          ∀ p : ℂ × ℂ,
            d / 10 < H - p.1.im → H - p.1.im < δ_star →
            δ_star / 2 < H - p.1.im →
            |p.1.re - x₀| < 50 * (H - p.1.im) → ‖p.2‖ < η → ‖p.2‖ < 2 * d →
            s_tilde p = L.𝔰 p
def smallChordDomain (S : FiniteWallNonisotropicStrip) (η_SL : ℝ) : Set (ℂ × ℂ) :=
  { q : ℂ × ℂ |
    q.1 ∈ horizStrip S.H ∧ q.1 + q.2 ∈ horizStrip S.H ∧
    ‖q.2 * S.f q.1‖ < η_SL ∧
    ‖q.2 ^ 2 * deriv S.f q.1‖ < η_SL ∧
    ∀ w ∈ Set.Icc (0 : ℝ) 1, ‖q.2 ^ 2 * S.q (q.1 + (w : ℂ) * q.2)‖ < η_SL }

noncomputable def frozenPhiFirst (Λ : ℂ) : ℂ :=
  if Λ = 0 then (1 / 24 : ℂ)
  else (Λ / 2 - Complex.sin (Λ / 2)) / (4 * (Λ / 2) ^ 3)

noncomputable def frozenPhiSecond (μ : ℂ) : ℂ :=
  (∑' m : ℕ, ((2 * m + 1 : ℕ) : ℂ) * μ ^ m / ((2 * m + 3).factorial : ℂ)) /
    (2 * (1 + ∑' m : ℕ, μ ^ m / ((2 * m).factorial : ℂ)))

noncomputable def smallChordActionP (Phi : ℂ × ℂ → ℂ) (s J t : ℂ) : ℂ :=
  J ^ 3 * Phi (s, t * J)

structure SmallFieldChordActionData (S : FiniteWallNonisotropicStrip) where
  η_SL : ℝ
  C_SL : ℝ
  Phi : ℂ × ℂ → ℂ
  η_SL_pos : 0 < η_SL
  η_SL_lt : η_SL < 1 / 4
  C_SL_pos : 0 < C_SL
  domain_open : IsOpen (smallChordDomain S η_SL)
  Phi_holo : DifferentiableOn ℂ Phi (smallChordDomain S η_SL)
  Phi_zero : ∀ s ∈ horizStrip S.H, Phi (s, 0) = 1 / 24
  Phi_rev : ∀ s h : ℂ,
    (s, h) ∈ smallChordDomain S η_SL →
    (s + h, -h) ∈ smallChordDomain S η_SL →
    Phi (s + h, -h) = Phi (s, h)
  Phi_bound : ∀ s h : ℂ, ∀ M_q : ℝ,
    (s, h) ∈ smallChordDomain S η_SL →
    0 ≤ M_q →
    (∀ w ∈ Set.Icc (0 : ℝ) 1, ‖h ^ 2 * S.q (s + (w : ℂ) * h)‖ ≤ M_q) →
    ‖Phi (s, h) - 1 / 24‖ ≤
      C_SL * (M_q + ‖h * S.f s‖ ^ 2 + ‖h ^ 2 * deriv S.f s‖ ^ 2)
  Phi_approx_first : ∀ s h : ℂ, ∀ M_q : ℝ,
    (s, h) ∈ smallChordDomain S η_SL →
    0 ≤ M_q →
    (∀ w ∈ Set.Icc (0 : ℝ) 1, ‖h ^ 2 * S.q (s + (w : ℂ) * h)‖ ≤ M_q) →
    ‖Phi (s, h) - frozenPhiFirst (h * S.f s)‖ ≤
      C_SL * (M_q + ‖h ^ 2 * deriv S.f s‖)
  Phi_approx_second : ∀ s h μ : ℂ, ∀ M_diff : ℝ,
    (s, h) ∈ smallChordDomain S η_SL →
    ‖μ‖ < η_SL →
    0 ≤ M_diff →
    (∀ w ∈ Set.Icc (0 : ℝ) 1, ‖h ^ 2 * S.q (s + (w : ℂ) * h) - μ‖ ≤ M_diff) →
    ‖Phi (s, h) - frozenPhiSecond μ‖ ≤
      C_SL * (M_diff + ‖h * S.f s‖ + ‖h ^ 2 * deriv S.f s‖)
  exact_recurrence : ∀ H₁ : ℝ, 0 < H₁ → H₁ < S.H →
    ∃ r_sub : ℝ, 0 < r_sub ∧ r_sub < S.r_star ∧
      ∀ y t : ℂ, y ∈ horizStrip H₁ → ‖t‖ < r_sub →
        (y, t) ∈ finiteWallTube S.r_star S.h_X ∧
        (y + t, t) ∈ finiteWallTube S.r_star S.h_X ∧
        (y - t, t) ∈ finiteWallTube S.r_star S.h_X ∧
        (t ≠ 0 →
          let s_m := S.𝔰 (y - t, t)
          let s_0 := S.𝔰 (y, t)
          let s_p := S.𝔰 (y + t, t)
          let J_m := (s_0 - s_m) / t
          let J_p := (s_p - s_0) / t
          (s_m, s_0 - s_m) ∈ smallChordDomain S η_SL ∧
          (s_0, s_p - s_0) ∈ smallChordDomain S η_SL ∧
          ‖J_m - 1‖ < 1 / 16 ∧
          ‖J_p - 1‖ < 1 / 16 ∧
          deriv (fun J' => smallChordActionP Phi s_0 J' t) J_p -
            t * deriv (fun s' => smallChordActionP Phi s' J_p t) s_0 =
            deriv (fun J' => smallChordActionP Phi s_m J' t) J_m)

def SteepSectorPassageProp (S : FiniteWallNonisotropicStrip) : Prop :=
  ∀ α m_steep γ_steep δ_ceil δ_b : ℝ,
    1 / 2 < α → α < 1 → 0 < m_steep → 0 < γ_steep → γ_steep < 1 / 4 →
    0 < δ_ceil → δ_ceil < δ_b → δ_b < S.H / 2 →
    ∃ L : ℝ, m_steep ≤ L ∧
      ∀ K : ℝ, 0 < K → ∃ C_st ε_st d_st : ℝ, 0 < C_st ∧ 0 < ε_st ∧ 0 < d_st ∧
        ∀ d x₀ r ε : ℝ, 0 < d → d < d_st → 0 < r → r ≤ K * d → 0 < ε → ε ≤ ε_st →
          (∀ s : ℂ, d / 10 ≤ wallDepth S s → wallDepth S s ≤ δ_b →
            |s.re - x₀| ≤ L * wallDepth S s →
            r * shapeModulus S s ≤ ε * (d / wallDepth S s) ^ α) →
          ∃ s_steep : ℂ × ℂ → ℂ,
            DifferentiableOn ℂ s_steep
              { p : ℂ × ℂ |
                d / 2 < S.H - p.1.im ∧ S.H - p.1.im < δ_ceil ∧
                |p.1.re - x₀| < m_steep * (S.H - p.1.im) ∧
                ‖p.2‖ < 10 * r * ((S.H - p.1.im) / d) ^ α ∧
                γ_steep * ‖p.2‖ < |p.2.im| } ∧
            (∀ p : ℂ × ℂ,
              d / 2 < S.H - p.1.im → S.H - p.1.im < δ_ceil →
              |p.1.re - x₀| < m_steep * (S.H - p.1.im) →
              ‖p.2‖ < 10 * r * ((S.H - p.1.im) / d) ^ α →
              γ_steep * ‖p.2‖ < |p.2.im| →
              s_steep p ∈ horizStrip S.H ∧
              s_steep (p.1, -p.2) = s_steep p ∧
              ‖s_steep p - p.1‖ ≤
                C_st * (1 + (ε / r) * d ^ α) ^ 2 * ‖p.2‖ ^ 2 * (S.H - p.1.im) ^ (1 - 2 * α) ∧
              (p ∈ finiteWallTube S.r_star S.h_X → s_steep p = S.𝔰 p))
def UniversalDiskLogDeficitProp : Prop :=
  ∃ C_def : ℝ, 0 < C_def ∧
    ∀ (U : Set ℂ) (f q : ℂ → ℂ),
      IsOpen U →
      DifferentiableOn ℂ f U →
      DifferentiableOn ℂ q U →
      (∀ z ∈ U, deriv (deriv f) z = q z * f z) →
      (∀ z ∈ U, f z = 0 → deriv f z ≠ 0) →
      ∀ (z₀ : ℂ) (Δ K : ℝ), 0 < Δ →
        Metric.closedBall z₀ Δ ⊆ U →
        (∀ z ∈ Metric.closedBall z₀ Δ, ‖f z‖ ≤ Real.exp K) →
        MeasureTheory.IntegrableOn
          (fun w : ℂ => K - Real.log ‖f w‖) (Metric.ball z₀ Δ) MeasureTheory.volume ∧
        ∀ z ∈ Metric.ball z₀ (Δ / 4),
          Δ * Real.sqrt ‖q z‖ ≤
            C_def * (1 + (Real.pi * Δ ^ 2)⁻¹ *
              ∫ w in Metric.ball z₀ Δ, (K - Real.log ‖f w‖))

structure PeriodicShapeField (U : Set ℂ) (s_star : ℝ) (f q : ℂ → ℂ) : Prop where
  isOpen_U : IsOpen U
  s_star_pos : 0 < s_star
  lower_strip_subset : horizStrip s_star ⊆ U
  slab_mem : ∀ w ∈ U, ∀ z : ℂ, |z.im| ≤ |w.im| → z ∈ U
  f_holo : DifferentiableOn ℂ f U
  q_holo : DifferentiableOn ℂ q U
  deriv2_f : ∀ s ∈ U, deriv (deriv f) s = q s * f s
  f_periodic : ∀ s ∈ U, f (s + 2 * Real.pi) = f s
  f_conj : ∀ s ∈ U, f (starRingEnd ℂ s) = starRingEnd ℂ (f s)
  f_real_pos : ∀ x : ℝ, 0 < (f x).re ∧ (f x).im = 0
  f_lower_ne_zero : ∀ s ∈ horizStrip s_star, f s ≠ 0
  f_simple_zeros : ∀ s ∈ U, f s = 0 → deriv f s ≠ 0

noncomputable def rowLogSup (f : ℂ → ℂ) (y : ℝ) : ℝ :=
  Real.log (sSup ((fun x : ℝ => ‖f ((x : ℂ) + (y : ℂ) * Complex.I)‖) ''
    Set.Icc (0 : ℝ) (2 * Real.pi)))

def EntireScalePackage (ρ : ℝ → ℝ) : Prop :=
  ∃ (h_seq ℓ_seq m_seq : ℕ → ℝ) (C_ℓ C_h C_f : ℝ),
    0 < C_ℓ ∧ 0 < C_h ∧ 0 < C_f ∧
    (∀ n : ℕ, 0 < h_seq n ∧ 0 < ℓ_seq n ∧ ℓ_seq n ≤ C_ℓ ∧ 0 < m_seq n ∧
      m_seq n = Real.exp (ρ (h_seq n)) ∧ h_seq n ≤ C_h * ρ (h_seq n) ∧ 1 ≤ ρ (h_seq n)) ∧
    Filter.Tendsto h_seq Filter.atTop Filter.atTop ∧
    Filter.Tendsto (fun n => ρ (h_seq n)) Filter.atTop Filter.atTop ∧
    Filter.Tendsto (fun n => ℓ_seq n * m_seq n) Filter.atTop Filter.atTop ∧
    Filter.Tendsto (fun n => Real.log (1 + h_seq n / ℓ_seq n) / Real.log (m_seq n))
      Filter.atTop (nhds 0) ∧
    Filter.Tendsto (fun n => |Real.log (ℓ_seq n)| / ρ (h_seq n)) Filter.atTop (nhds 0) ∧
    (∀ M_u η : ℝ, 0 < M_u → 0 < η → ∃ N₀ : ℕ, ∀ n ≥ N₀, ∀ u : ℝ, |u| ≤ M_u →
      ρ (h_seq n + ℓ_seq n * u) ≤ ρ (h_seq n) + u + η) ∧
    (∃ N₁ : ℕ, ∀ n ≥ N₁, ∀ y : ℝ, ℓ_seq n ≤ h_seq n - y → h_seq n - y ≤ h_seq n →
      Real.exp (ρ y) ≤ C_f * m_seq n * (ℓ_seq n / (h_seq n - y)) ^ (3 / 4 : ℝ))

def FiniteWallScalePackage (H : ℝ) (ρ : ℝ → ℝ) : Prop :=
  ∃ (δ_b C_f : ℝ) (h_seq ℓ_seq m_seq : ℕ → ℝ),
    0 < δ_b ∧ δ_b < H / 2 ∧ 0 < C_f ∧
    (∀ n : ℕ, 0 < h_seq n ∧ h_seq n < H ∧ 0 < ℓ_seq n ∧ 0 < m_seq n ∧
      m_seq n = Real.exp (ρ (h_seq n)) ∧ 1 ≤ ρ (h_seq n)) ∧
    Filter.Tendsto h_seq Filter.atTop (nhds H) ∧
    Filter.Tendsto ℓ_seq Filter.atTop (nhds 0) ∧
    Filter.Tendsto (fun n => ρ (h_seq n)) Filter.atTop Filter.atTop ∧
    Filter.Tendsto (fun n => ℓ_seq n * m_seq n) Filter.atTop Filter.atTop ∧
    Filter.Tendsto (fun n => (H - h_seq n) / ℓ_seq n) Filter.atTop Filter.atTop ∧
    Filter.Tendsto (fun n => |Real.log (ℓ_seq n)| / ρ (h_seq n)) Filter.atTop (nhds 0) ∧
    (∀ M_u η : ℝ, 0 < M_u → 0 < η → ∃ N₀ : ℕ, ∀ n ≥ N₀, ∀ u : ℝ, |u| ≤ M_u →
      |h_seq n + ℓ_seq n * u| < H ∧ ρ (h_seq n + ℓ_seq n * u) ≤ ρ (h_seq n) + u + η) ∧
    (∃ N₁ : ℕ, ∀ n ≥ N₁, ∀ y : ℝ, ℓ_seq n ≤ h_seq n - y → h_seq n - y ≤ δ_b →
      0 < y ∧ y < H ∧
      Real.exp (ρ y) ≤ C_f * m_seq n * (ℓ_seq n / (h_seq n - y)) ^ (3 / 4 : ℝ))
def superlinearLowerHalfPlane : Set ℂ :=
  { Z : ℂ | Z.im < 0 }


noncomputable def superlinearRescaledF (S : FiniteWallNonisotropicStrip)
    (x d m : ℝ) (Z : ℂ) : ℂ :=
  ((m⁻¹ : ℝ) : ℂ) * S.f ((x : ℂ) + (S.H : ℂ) * Complex.I + (d : ℂ) * Z)


noncomputable def superlinearRescaledQ (S : FiniteWallNonisotropicStrip)
    (x d m : ℝ) (Z : ℂ) : ℂ :=
  (((m ^ 2)⁻¹ : ℝ) : ℂ) * S.q ((x : ℂ) + (S.H : ℂ) * Complex.I + (d : ℂ) * Z)


structure SuperlinearRecordScales (S : FiniteWallNonisotropicStrip) where
  α₁ : ℝ
  α₂ : ℝ
  P : ℝ
  k₀ : ℝ
  one_lt_α₁ : 1 < α₁
  α₁_lt_α₂ : α₁ < α₂
  α₂_lt_P : α₂ < P
  one_le_k₀ : 1 ≤ k₀
  exp_neg_k₀_le_half_H : Real.exp (-k₀) ≤ S.H / 2
  k_seq : ℕ → ℝ
  d_seq : ℕ → ℝ
  m_seq : ℕ → ℝ
  x_max : ℕ → ℝ
  k_seq_ge : ∀ n : ℕ, k₀ + (n : ℝ) ≤ k_seq n
  d_seq_eq : ∀ n : ℕ, d_seq n = Real.exp (-k_seq n)
  m_seq_pos : ∀ n : ℕ, 1 ≤ m_seq n
  m_seq_lower : ∀ n : ℕ, Real.exp (α₂ * k_seq n) ≤ m_seq n
  m_seq_upper : ∀ n : ℕ, m_seq n ≤ Real.exp (P * k_seq n)
  x_max_mem : ∀ n : ℕ, x_max n ∈ Set.Icc (0 : ℝ) (2 * Real.pi)
  x_max_attains : ∀ n : ℕ,
    shapeModulus S ((x_max n : ℂ) + ((S.H - d_seq n : ℝ) : ℂ) * Complex.I) = m_seq n
  coarse_tail_bound : ∀ n : ℕ, ∀ s : ℂ,
    d_seq n ≤ wallDepth S s → wallDepth S s ≤ Real.exp (-k₀) →
    shapeModulus S s ≤ m_seq n * (d_seq n / wallDepth S s) ^ α₁
  fine_cap_bound : ∀ n : ℕ, ∀ s : ℂ,
    0 < wallDepth S s → wallDepth S s ≤ d_seq n →
    shapeModulus S s ≤ m_seq n * (d_seq n / wallDepth S s) ^ P


def SuperlinearPureExtractionProp (S : FiniteWallNonisotropicStrip)
    (R : SuperlinearRecordScales S) : Prop :=
  ∀ (φ : ℕ → ℕ), StrictMono φ → ∀ (x_seq : ℕ → ℝ),
    ∃ (ψ : ℕ → ℕ) (F Q : ℂ → ℂ),
      StrictMono ψ ∧
      DifferentiableOn ℂ F superlinearLowerHalfPlane ∧
      DifferentiableOn ℂ Q superlinearLowerHalfPlane ∧
      TendstoLocallyUniformlyOn
        (fun k Z => superlinearRescaledF S (x_seq (ψ k))
          (R.d_seq (φ (ψ k))) (R.m_seq (φ (ψ k))) Z)
        F Filter.atTop superlinearLowerHalfPlane ∧
      TendstoLocallyUniformlyOn
        (fun k Z => superlinearRescaledQ S (x_seq (ψ k))
          (R.d_seq (φ (ψ k))) (R.m_seq (φ (ψ k))) Z)
        Q Filter.atTop superlinearLowerHalfPlane ∧
      ((∀ Z ∈ superlinearLowerHalfPlane, F Z = 0) ∨
        (∀ Z ∈ superlinearLowerHalfPlane, Q Z = 0)) ∧
      (∀ Z ∈ superlinearLowerHalfPlane, 1 ≤ -Z.im →
        max ‖F Z‖ (Real.sqrt ‖Q Z‖) ≤ (-Z.im) ^ (-R.α₁))


structure SuperlinearLimitingLiftData (α₁ : ℝ) where
  D₁ : ℝ
  C₁ : ℝ
  D₀ : ℝ
  D₁_pos : 0 < D₁
  C₁_pos : 0 < C₁
  D₀_pos : 0 < D₀
  S_inf : ℂ → ℂ
  S_inf_holo : DifferentiableOn ℂ S_inf superlinearLowerHalfPlane
  S_inf_maps_to : ∀ Y ∈ superlinearLowerHalfPlane, S_inf Y ∈ superlinearLowerHalfPlane
  S_inf_anchor : ∀ x D : ℝ, D₁ ≤ D →
    ‖S_inf ((x : ℂ) - (D : ℂ) * Complex.I) - ((x : ℂ) - (D : ℂ) * Complex.I)‖ ≤
      C₁ * D ^ (-(1 / 2 : ℝ))
  pure_energy_branch :
    (∃ F : ℂ → ℂ,
      DifferentiableOn ℂ F superlinearLowerHalfPlane ∧
      ‖F (-Complex.I)‖ = 1 ∧
      (∀ Z ∈ superlinearLowerHalfPlane, 1 ≤ -Z.im → ‖F Z‖ ≤ (-Z.im) ^ (-α₁)) ∧
      (∀ Y : ℂ, D₀ < -Y.im → |Y.re| < -Y.im →
        (deriv S_inf Y) ^ 3 *
          frozenFirstFieldG (F (S_inf Y) * deriv S_inf Y / 2) = 1)) ∨
    (∃ Q : ℂ → ℂ,
      DifferentiableOn ℂ Q superlinearLowerHalfPlane ∧
      Real.sqrt ‖Q (-Complex.I)‖ = 1 ∧
      (∀ Z ∈ superlinearLowerHalfPlane, 1 ≤ -Z.im → Real.sqrt ‖Q Z‖ ≤ (-Z.im) ^ (-α₁)) ∧
      (∀ Y : ℂ, D₀ < -Y.im → |Y.re| < -Y.im →
        (deriv S_inf Y) ^ 3 *
          frozenSecondFieldG ((1 / 2 : ℂ) ^ 2 * Q (S_inf Y) * (deriv S_inf Y) ^ 2) = 1))
noncomputable def stripSymDepth (S : FiniteWallNonisotropicStrip) (z : ℂ) : ℝ :=
  S.H - |z.im|

noncomputable def localAmp (S : FiniteWallNonisotropicStrip) (z : ℂ) : ℝ :=
  Real.log (‖S.f z‖ + stripSymDepth S z * ‖deriv S.f z‖)

noncomputable def truncLogSpeed (S : FiniteWallNonisotropicStrip) (ε : ℝ) (z : ℂ) : ℝ :=
  Real.log (max ‖S.f z‖ ε)

noncomputable def tileCurvBound (S : FiniteWallNonisotropicStrip) (x d : ℝ) : ℝ :=
  1 + sSup ((fun z : ℂ => stripSymDepth S z * Real.sqrt ‖S.q z‖) ''
    Metric.closedBall ((x : ℂ) + ((S.H - d : ℝ) : ℂ) * Complex.I) (d / 2))

noncomputable def stripExitKernel (H_p y₀ u : ℝ) : ℝ :=
  (2 * H_p)⁻¹ *
    (Real.cosh (Real.pi * u / (2 * H_p)) * Real.cos (Real.pi * y₀ / (2 * H_p))) /
    (Real.cosh (Real.pi * u / (2 * H_p)) ^ 2 - Real.sin (Real.pi * y₀ / (2 * H_p)) ^ 2)

noncomputable def rowOccupDensity (S : FiniteWallNonisotropicStrip)
    (ε h₀ x v : ℝ) : ℝ :=
  if |truncLogSpeed S ε (upperRowPt S v x)| ≤ h₀ then
    ∫ s in (2 : ℝ)..(4 : ℝ),
      ∫ u : ℝ,
        min ((truncLogSpeed S ε (upperRowPt S (v + s) (x + u)) -
          truncLogSpeed S ε (upperRowPt S v x)) ^ 2) (h₀ ^ 2) *
        stripExitKernel (S.H - Real.exp (-(v + s))) (S.H - Real.exp (-v)) u
  else 0

def DiscreteTanakaProp : Prop :=
  ∀ (M : ℕ) (h R : ℝ) (g : ℕ → ℝ → ℝ) (κ : ℕ → ℝ → ℝ),
    0 < h → h < R →
    (∀ m ≤ M, Continuous (g m)) →
    (∀ m ≤ M, Function.Periodic (g m) (2 * Real.pi)) →
    (∀ m < M, Continuous (κ m)) →
    (∀ m < M, ∀ u : ℝ, 0 ≤ κ m u) →
    (∀ m < M, MeasureTheory.Integrable (κ m) MeasureTheory.volume) →
    (∀ m < M, (∫ u : ℝ, κ m u) = 1) →
    (∀ m < M, ∀ x : ℝ, g m x ≤ ∫ u : ℝ, g (m + 1) (x + u) * κ m u) →
    (∑ m ∈ Finset.range M,
      (2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi),
        (if |g m x| ≤ h then
          ∫ u : ℝ, min ((g (m + 1) (x + u) - g m x) ^ 2) (h ^ 2) * κ m u
        else 0)) ≤
      25 * h * (h + 2 * R + 2 * Real.sqrt
        (∑ m ∈ Finset.range M,
          (2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi),
            (∫ u : ℝ, (g (m + 1) (x + u) - g m x) ^ 2 * κ m u))) +
      (M : ℝ) * h ^ 2 *
        (∑ m ∈ Finset.range M,
          (2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi),
            (∫ u : ℝ, (g (m + 1) (x + u) - g m x) ^ 2 * κ m u)) /
        (R - h) ^ 2

structure StripExitKernelData (S : FiniteWallNonisotropicStrip) : Prop where
  kernel_cont : ∀ d d' : ℝ, 0 < d' → d' < d → d < S.H →
    Continuous (stripExitKernel (S.H - d') (S.H - d))
  kernel_pos : ∀ d d' : ℝ, 0 < d' → d' < d → d < S.H →
    ∀ u : ℝ, 0 < stripExitKernel (S.H - d') (S.H - d) u
  kernel_integrable : ∀ d d' : ℝ, 0 < d' → d' < d → d < S.H →
    MeasureTheory.Integrable (stripExitKernel (S.H - d') (S.H - d)) MeasureTheory.volume
  kernel_integral_one : ∀ d d' : ℝ, 0 < d' → d' < d → d < S.H →
    (∫ u : ℝ, stripExitKernel (S.H - d') (S.H - d) u) = 1
  kernel_tail_le : ∀ d d' R : ℝ, 0 < d' → d' < d → d < S.H → 0 < R →
    (∫ u in {u : ℝ | R * d < |u|}, stripExitKernel (S.H - d') (S.H - d) u) ≤ 1 / R
  kernel_core_ge : ∀ d s u : ℝ, 0 < d → d < S.H / 4 →
    s ∈ Set.Icc (2 : ℝ) (4 : ℝ) → |u| ≤ 2 * d →
    (120 * d)⁻¹ ≤ stripExitKernel (S.H - Real.exp (-s) * d) (S.H - d) u
  trunc_submean : ∀ ε v v' x : ℝ, 0 < ε → v < v' → Real.exp (-v) < S.H →
    truncLogSpeed S ε (upperRowPt S v x) ≤
      ∫ u : ℝ, truncLogSpeed S ε (upperRowPt S v' (x + u)) *
        stripExitKernel (S.H - Real.exp (-v')) (S.H - Real.exp (-v)) u

structure AmplitudeDeficitData (S : FiniteWallNonisotropicStrip)
    (hBudget : CriticalAngleBudgetData S) where
  C_amp : ℝ
  C_glob : ℝ
  K_amp : ℝ
  one_le_C_amp : 1 ≤ C_amp
  one_le_C_glob : 1 ≤ C_glob
  K_amp_ge : max hBudget.k₀ 200 ≤ K_amp
  tile_amp_osc : ∀ x d : ℝ, 0 < d → d < S.H / 4 →
    ∀ z ∈ Metric.closedBall ((x : ℂ) + ((S.H - d : ℝ) : ℂ) * Complex.I) (3 * d / 8),
      |localAmp S z - localAmp S ((x : ℂ) + ((S.H - d : ℝ) : ℂ) * Complex.I)| ≤
        C_amp * tileCurvBound S x d
  disk_raw_and_trunc_l2 : ∀ x d r ε : ℝ,
    0 < d → d < S.H / 4 → d / 16 ≤ r → r ≤ d / 8 → 0 < ε →
    (∀ z ∈ Metric.closedBall ((x : ℂ) + ((S.H - d : ℝ) : ℂ) * Complex.I) (d / 2),
      Real.log ε ≤ localAmp S z) →
    MeasureTheory.IntegrableOn
      (fun ζ : ℂ => (localAmp S ζ - Real.log ‖S.f ζ‖) ^ 2)
      (Metric.ball ((x : ℂ) + ((S.H - d : ℝ) : ℂ) * Complex.I) r) MeasureTheory.volume ∧
    MeasureTheory.IntegrableOn
      (fun ζ : ℂ => (localAmp S ζ - truncLogSpeed S ε ζ) ^ 2)
      (Metric.ball ((x : ℂ) + ((S.H - d : ℝ) : ℂ) * Complex.I) r) MeasureTheory.volume ∧
    (Real.pi * r ^ 2)⁻¹ *
      (∫ ζ in Metric.ball ((x : ℂ) + ((S.H - d : ℝ) : ℂ) * Complex.I) r,
        (localAmp S ζ - Real.log ‖S.f ζ‖) ^ 2) ≤
      C_amp * (tileCurvBound S x d) ^ 2 ∧
    (Real.pi * r ^ 2)⁻¹ *
      (∫ ζ in Metric.ball ((x : ℂ) + ((S.H - d : ℝ) : ℂ) * Complex.I) r,
        (localAmp S ζ - truncLogSpeed S ε ζ) ^ 2) ≤
      C_amp * (tileCurvBound S x d) ^ 2
  global_amp_poly_bound : ∀ K : ℝ, K_amp ≤ K →
    ∀ z : ℂ, |z.im| ≤ S.H - Real.exp (-(41 / 20 : ℝ) * K) →
      |localAmp S z| ≤ C_glob * K ^ (3 : ℕ)
  small_moment_row_l2 : ∀ K : ℝ, K_amp ≤ K →
    (∀ v ∈ Set.Icc ((9 / 10 : ℝ) * K) ((21 / 10 : ℝ) * K),
      rowMomentFull S v ≤ K ^ (1 / 100 : ℝ)) →
    ∀ w ∈ Set.Icc K (2 * K),
      MeasureTheory.IntegrableOn
        (fun x : ℝ => (tileCurvBound S x (Real.exp (-w))) ^ 2)
        (Set.Icc (0 : ℝ) (2 * Real.pi)) MeasureTheory.volume ∧
      MeasureTheory.IntegrableOn
        (fun x : ℝ => (localAmp S (upperRowPt S w x) -
          truncLogSpeed S (Real.exp (-C_glob * K ^ (3 : ℕ) - 10 * K))
            (upperRowPt S w x)) ^ 2)
        (Set.Icc (0 : ℝ) (2 * Real.pi)) MeasureTheory.volume ∧
      (2 * Real.pi)⁻¹ *
        (∫ x in (0 : ℝ)..(2 * Real.pi), (tileCurvBound S x (Real.exp (-w))) ^ 2) ≤
        C_amp * K ^ (1 / 50 : ℝ) ∧
      (2 * Real.pi)⁻¹ *
        (∫ x in (0 : ℝ)..(2 * Real.pi),
          (localAmp S (upperRowPt S w x) -
            truncLogSpeed S (Real.exp (-C_glob * K ^ (3 : ℕ) - 10 * K))
              (upperRowPt S w x)) ^ 2) ≤
        C_amp * K ^ (1 / 50 : ℝ)

noncomputable def AmplitudeDeficitData.epsK {S : FiniteWallNonisotropicStrip}
    {hBudget : CriticalAngleBudgetData S} (A : AmplitudeDeficitData S hBudget) (K : ℝ) : ℝ :=
  Real.exp (-A.C_glob * K ^ (3 : ℕ) - 10 * K)

def SmallMomentOccupationBound (S : FiniteWallNonisotropicStrip)
    {hBudget : CriticalAngleBudgetData S} (A : AmplitudeDeficitData S hBudget) : Prop :=
  ∃ C_occ K_occ : ℝ, 0 < C_occ ∧ A.K_amp ≤ K_occ ∧
    ∀ K : ℝ, K_occ ≤ K →
      (∀ v ∈ Set.Icc ((9 / 10 : ℝ) * K) ((21 / 10 : ℝ) * K),
        rowMomentFull S v ≤ K ^ (1 / 100 : ℝ)) →
      MeasureTheory.IntegrableOn
        (fun p : ℝ × ℝ => rowOccupDensity S (A.epsK K) (K ^ (3 / 50 : ℝ)) p.1 p.2)
        (Set.Icc (0 : ℝ) (2 * Real.pi) ×ˢ Set.Icc ((11 / 10 : ℝ) * K) ((19 / 10 : ℝ) * K))
        MeasureTheory.volume ∧
      (∫ p in Set.Icc (0 : ℝ) (2 * Real.pi) ×ˢ
          Set.Icc ((11 / 10 : ℝ) * K) ((19 / 10 : ℝ) * K),
        rowOccupDensity S (A.epsK K) (K ^ (3 / 50 : ℝ)) p.1 p.2) ≤
        C_occ * K ^ (47 / 50 : ℝ)
def IsProhibitedCriticalTuple (S : FiniteWallNonisotropicStrip)
    (k_seq k_anc_seq ε_seq : ℕ → ℝ) (w_seq : ℕ → ℝ → ℝ) : Prop :=
  (∀ n : ℕ, criticalDepthThreshold S ≤ k_anc_seq n ∧
    k_anc_seq n ≤ k_seq n ∧
    0 < ε_seq n ∧
    1 ≤ rowMomentFull S (k_seq n)) ∧
  Filter.Tendsto k_seq Filter.atTop Filter.atTop ∧
  Filter.Tendsto (fun n => rowMomentFull S (k_seq n)) Filter.atTop Filter.atTop ∧
  Filter.Tendsto ε_seq Filter.atTop (nhds 0) ∧
  (∀ n : ℕ, ∀ j : ℝ, criticalDepthThreshold S ≤ j →
    rowMomentFull S j ≤ rowMomentFull S (k_seq n) * Real.exp (ε_seq n * |j - k_seq n|)) ∧
  Filter.Tendsto k_anc_seq Filter.atTop Filter.atTop ∧
  Filter.Tendsto (fun n => k_seq n - k_anc_seq n) Filter.atTop Filter.atTop ∧
  (∀ n : ℕ, Continuous (w_seq n) ∧
    Function.Periodic (w_seq n) (2 * Real.pi) ∧
    (∀ y : ℝ, 0 ≤ w_seq n y) ∧
    (2 * Real.pi)⁻¹ * (∫ y in (0 : ℝ)..(2 * Real.pi), w_seq n y) = 1) ∧
  (∀ β A : ℝ, 0 < β → β < 1 / 2 → 1 ≤ A →
    ∃ C_βA : ℝ, 0 < C_βA ∧ ∃ N₀ : ℕ, ∀ n ≥ N₀,
      ∀ j : ℝ, criticalDepthThreshold S ≤ j → j ≤ k_anc_seq n + 3 →
        Real.sqrt ((2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi),
          (tileSupModulus S A j x) ^ 2 *
            ancestorPoissonDensity (Real.exp (-k_anc_seq n)) (w_seq n) x) ≤
          C_βA * rowMomentFull S (k_seq n) * Real.exp (β * (k_seq n - j))) ∧
  (∀ β : ℝ, 0 < β → β < 1 / 2 →
    ∃ C_β : ℝ, 0 < C_β ∧ ∃ N₀ : ℕ, ∀ n ≥ N₀,
      (2 * Real.pi)⁻¹ * (∫ y in (0 : ℝ)..(2 * Real.pi),
        |(S.V ((y : ℂ) + ((S.H - Real.exp (-k_anc_seq n) : ℝ) : ℂ) * Complex.I)).im| *
          w_seq n y) ≤
        C_β * (rowMomentFull S (k_seq n)) ^ 2 *
          Real.exp (2 * β * (k_seq n - k_anc_seq n)) / Real.exp (-k_anc_seq n)) ∧
  (∀ K : Set ℂ, IsCompact K → K.Nonempty → K ⊆ criticalLowerHalfPlane →
    Filter.Tendsto
      (fun n => (2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi),
        min 1 (sSup ((fun Z : ℂ =>
          (Real.exp (-k_seq n) / rowMomentFull S (k_seq n)) ^ 2 *
            ‖S.q ((x : ℂ) + (S.H : ℂ) * Complex.I +
              (Real.exp (-k_seq n) : ℂ) * Z)‖) '' K)) *
          ancestorPoissonDensity (Real.exp (-k_anc_seq n)) (w_seq n) x)
      Filter.atTop (nhds 0))

structure MomentLawSteepBranch (m : ℝ → ℝ) : Prop where
  exists_data :
    ∃ (x_seq P_seq : ℕ → ℝ) (C_tail : ℝ),
      0 < C_tail ∧
      (∀ j : ℕ, 0 ≤ x_seq j ∧ 1 ≤ P_seq j) ∧
      Filter.Tendsto x_seq Filter.atTop Filter.atTop ∧
      Filter.Tendsto P_seq Filter.atTop Filter.atTop ∧
      TendstoLocallyUniformly
        (fun j u =>
          m (Real.exp (x_seq j) * (1 - u / P_seq j)) / m (Real.exp (x_seq j)))
        Real.exp Filter.atTop ∧
      (∀ j : ℕ, ∀ v : ℝ, 0 ≤ v →
        m (Real.exp (x_seq j) * (1 + v / P_seq j)) / m (Real.exp (x_seq j)) ≤
          C_tail * (1 + v) ^ (-(5 / 8 : ℝ)))

structure MomentLawBoundedBranch (m : ℝ → ℝ) : Prop where
  exists_data :
    ∃ (x_seq : ℕ → ℝ) (ρ_star : ℝ → ℝ) (lam C_env P' : ℝ),
      1 ≤ lam ∧
      0 < C_env ∧
      1 ≤ P' ∧
      (∀ j : ℕ, 0 ≤ x_seq j) ∧
      Filter.Tendsto x_seq Filter.atTop Filter.atTop ∧
      Continuous ρ_star ∧
      ρ_star 0 = 0 ∧
      Filter.Tendsto (fun u => ρ_star u / u) Filter.atTop (nhds lam) ∧
      Filter.Tendsto (fun u => ρ_star u / u) Filter.atBot (nhds lam) ∧
      TendstoLocallyUniformly
        (fun j u =>
          (-Real.log (m (Real.exp (x_seq j + u)))) -
            (-Real.log (m (Real.exp (x_seq j)))))
        ρ_star Filter.atTop ∧
      (∀ j : ℕ, ∀ v : ℝ, x_seq j ≤ v →
        -Real.log (m (Real.exp (x_seq j))) + (3 / 4 : ℝ) * (v - x_seq j) - C_env ≤
          -Real.log (m (Real.exp v))) ∧
      (∀ j : ℕ, ∀ v : ℝ, v ≤ x_seq j →
        -Real.log (m (Real.exp (x_seq j))) - P' * (x_seq j - v) - C_env ≤
          -Real.log (m (Real.exp v))) ∧
      (∀ j : ℕ, -Real.log (m (Real.exp (x_seq j))) ≤ C_env * (1 + x_seq j))
structure LocalPositiveCenterGerm (n : ℕ) where
  c : ℝ
  δ₀ : ℝ
  c_pos : 0 < c
  δ₀_pos : 0 < δ₀
  Z_loc : ℂ → ℂ
  W_loc : ℂ → ℂ
  a_loc : ℂ → ℂ
  f_loc : ℂ → ℂ
  u_a : ℂ → ℂ
  N_Z : ℂ × ℂ → ℂ
  N_W : ℂ × ℂ → ℂ
  D_ZW : ℂ × ℂ → ℂ
  Z_mero : MeromorphicAt Z_loc 0
  W_mero : MeromorphicAt W_loc 0
  u_a_analytic : AnalyticAt ℂ u_a 0
  u_a_ne_zero : u_a 0 ≠ 0
  a_eq : ∀ z : ℂ, 0 < ‖z‖ → ‖z‖ < δ₀ → a_loc z = z ^ n * u_a z
  reg_on_punctured : ∀ z : ℂ, 0 < ‖z‖ → ‖z‖ < δ₀ →
    AnalyticAt ℂ Z_loc z ∧
    AnalyticAt ℂ W_loc z ∧
    AnalyticAt ℂ a_loc z ∧
    AnalyticAt ℂ f_loc z ∧
    a_loc z ≠ 0 ∧
    f_loc z ≠ 0 ∧
    deriv Z_loc z = Complex.I * (c : ℂ) * a_loc z / (f_loc z) ^ 2 ∧
    deriv W_loc z = -Complex.I * (c : ℂ) / (a_loc z * (f_loc z) ^ 2) ∧
    deriv a_loc z = Complex.I * f_loc z * a_loc z
  N_Z_holo : DifferentiableOn ℂ N_Z (Metric.ball (0 : ℂ) δ₀ ×ˢ Metric.ball (0 : ℂ) δ₀)
  N_W_holo : DifferentiableOn ℂ N_W (Metric.ball (0 : ℂ) δ₀ ×ˢ Metric.ball (0 : ℂ) δ₀)
  D_ZW_holo : DifferentiableOn ℂ D_ZW (Metric.ball (0 : ℂ) δ₀ ×ˢ Metric.ball (0 : ℂ) δ₀)
  D_ZW_slice_ne_zero : ∀ z : ℂ, 0 < ‖z‖ → ‖z‖ < δ₀ → D_ZW (z, 0) ≠ 0
  slice_Z_eq : ∀ z : ℂ, 0 < ‖z‖ → ‖z‖ < δ₀ → N_Z (z, 0) = Z_loc z * D_ZW (z, 0)
  slice_W_eq : ∀ z : ℂ, 0 < ‖z‖ → ‖z‖ < δ₀ → N_W (z, 0) = W_loc z * D_ZW (z, 0)
  even_Z : ∀ z t : ℂ, ‖z‖ < δ₀ → ‖t‖ < δ₀ →
    N_Z (z, -t) * D_ZW (z, t) = N_Z (z, t) * D_ZW (z, -t)
  even_W : ∀ z t : ℂ, ‖z‖ < δ₀ → ‖t‖ < δ₀ →
    N_W (z, -t) * D_ZW (z, t) = N_W (z, t) * D_ZW (z, -t)
  rank_one_punc : ∀ z₀ : ℂ, 0 < ‖z₀‖ → ‖z₀‖ < δ₀ →
    ∃ r : ℝ, 0 < r ∧ ∀ z t : ℂ, ‖z - z₀‖ < r → ‖t‖ < r →
      D_ZW (z, t) ≠ 0 ∧
      deriv (fun z' => N_Z (z', t) / D_ZW (z', t)) z *
        deriv (fun t' => N_W (z, t') / D_ZW (z, t')) t =
      deriv (fun t' => N_Z (z, t') / D_ZW (z, t')) t *
        deriv (fun z' => N_W (z', t) / D_ZW (z', t)) z
  iso_reflect_punc : ∀ z₀ : ℂ, 0 < ‖z₀‖ → ‖z₀‖ < δ₀ →
    ∃ r : ℝ, 0 < r ∧ ∀ z t : ℂ, ‖z - z₀‖ < r → ‖t‖ < r →
      D_ZW (z, t) ≠ 0 ∧ D_ZW (z - t, t) ≠ 0 ∧ D_ZW (z + t, t) ≠ 0 ∧
      (N_Z (z, t) / D_ZW (z, t) - N_Z (z - t, t) / D_ZW (z - t, t)) *
        (N_Z (z + t, t) / D_ZW (z + t, t) - N_Z (z, t) / D_ZW (z, t)) *
        (deriv (fun z' => N_W (z', t) / D_ZW (z', t)) z) ^ 2 =
      (N_W (z, t) / D_ZW (z, t) - N_W (z - t, t) / D_ZW (z - t, t)) *
        (N_W (z + t, t) / D_ZW (z + t, t) - N_W (z, t) / D_ZW (z, t)) *
        (deriv (fun z' => N_Z (z', t) / D_ZW (z', t)) z) ^ 2

structure RationalProfileData {n : ℕ} (G : LocalPositiveCenterGerm n) where
  ne_three : n ≠ 3
  Z₀ : ℂ
  W₀ : ℂ
  u_Z : ℂ → ℂ
  u_W : ℂ → ℂ
  δ₁ : ℝ
  δ₁_pos : 0 < δ₁
  δ₁_le : δ₁ ≤ G.δ₀
  u_Z_analytic : AnalyticAt ℂ u_Z 0
  u_W_analytic : AnalyticAt ℂ u_W 0
  u_Z_ne_zero : u_Z 0 ≠ 0
  u_W_ne_zero : u_W 0 ≠ 0
  Z_expansion : ∀ z : ℂ, 0 < ‖z‖ → ‖z‖ < δ₁ → G.Z_loc z - Z₀ = z ^ (n + 3) * u_Z z
  W_expansion : ∀ z : ℂ, 0 < ‖z‖ → ‖z‖ < δ₁ →
    G.W_loc z - W₀ = z ^ ((3 : ℤ) - (n : ℤ)) * u_W z
  R₀ : ℝ
  R₀_pos : 0 < R₀
  U_germ : ℂ → ℂ
  U_germ_analytic : AnalyticAt ℂ U_germ 0
  U_germ_zero : U_germ 0 = 1
  ξ : ℂ → ℂ
  ξ_def : ∀ w : ℂ, R₀ < ‖w‖ → ξ w = w * U_germ w⁻¹ ∧ ξ w ≠ 0
  poly_power_rational : ∀ (Q : MvPolynomial (Fin 2) ℂ) (b : ℤ) (u_Q : ℂ → ℂ),
    AnalyticAt ℂ u_Q 0 → u_Q 0 ≠ 0 →
    (∀ᶠ z in nhdsWithin (0 : ℂ) {(0 : ℂ)}ᶜ,
      MvPolynomial.eval ![G.Z_loc z, G.W_loc z] Q = z ^ b * u_Q z) →
    ∃ (P_rat Q_rat : Polynomial ℂ) (R_Q : ℝ),
      Q_rat ≠ 0 ∧ R₀ < R_Q ∧
      ∀ w : ℂ, R_Q < ‖w‖ → Q_rat.eval w ≠ 0 ∧ (ξ w) ^ b * Q_rat.eval w = P_rat.eval w
  profile_reflection_eq : ∀ w : ℂ, R₀ + 1 < ‖w‖ →
    ((3 - (n : ℤ) : ℤ) : ℂ) ^ 2 *
      ((ξ (w + 1)) ^ ((n : ℤ) + 3) - (ξ w) ^ ((n : ℤ) + 3)) *
      ((ξ (w - 1)) ^ ((n : ℤ) + 3) - (ξ w) ^ ((n : ℤ) + 3)) =
    (((n : ℤ) + 3 : ℤ) : ℂ) ^ 2 *
      (ξ w) ^ (2 * (((n : ℤ) + 3) - (3 - (n : ℤ)))) *
      ((ξ (w + 1)) ^ (3 - (n : ℤ)) - (ξ w) ^ (3 - (n : ℤ))) *
      ((ξ (w - 1)) ^ (3 - (n : ℤ)) - (ξ w) ^ (3 - (n : ℤ)))

structure CollarIsotropicBridge {Ω : Set Plane} (C : AnalyticGlancingCollar Ω)
    (M : MeromorphicCollarData C) where
  real_base : ∀ x : ℝ,
    (x : ℂ) ∈ horizStripENNR (M.h_X 0) ∧
    (x : ℂ) ∉ M.E_disc ∧
    M.a_mero x = Complex.exp (Complex.I * C.ϕ x)
  a_periodic_reg : ∀ s ∈ horizStripENNR (M.h_X 0),
    s ∉ M.E_disc →
    s + 2 * Real.pi ∈ horizStripENNR (M.h_X 0) →
    s + 2 * Real.pi ∉ M.E_disc →
    M.a_mero (s + 2 * Real.pi) = M.a_mero s
  a_conj_reg : ∀ s ∈ horizStripENNR (M.h_X 0),
    s ∉ M.E_disc →
    starRingEnd ℂ s ∈ horizStripENNR (M.h_X 0) →
    starRingEnd ℂ s ∉ M.E_disc →
    M.a_mero (starRingEnd ℂ s) * starRingEnd ℂ (M.a_mero s) = 1
  order_ne_top : ∀ q ∈ horizStripENNR (M.h_X 0),
    meromorphicOrderAt M.a_mero q ≠ ⊤
  positive_germ_of_center : ∀ p ∈ horizStripENNR (M.h_X 0),
    ∀ (n : ℤ) (u : ℂ → ℂ),
      n ≠ 0 → AnalyticAt ℂ u p → u p ≠ 0 →
      (∀ᶠ z in nhdsWithin p {p}ᶜ, M.a_mero z = (z - p) ^ n * u z) →
      ∃ G : LocalPositiveCenterGerm n.natAbs,
        ∀ ε : ℝ, 0 < ε → ε ≤ G.δ₀ →
          (∀ z : ℂ, 0 < ‖z‖ → ‖z‖ < ε →
            G.Z_loc (-z) = G.Z_loc z ∧ G.W_loc (-z) = G.W_loc z ∧ G.a_loc (-z) = -G.a_loc z) →
          M.h_X 0 = ⊤ ∧
          ∀ s : ℂ, s ∉ M.E_disc → 2 * p - s ∉ M.E_disc → M.a_mero (2 * p - s) = -M.a_mero s
noncomputable def r_ℂ {Ω : Set Plane} (B : AnalyticBoundaryData Ω) (w : ℂ) : ℂ :=
  B.h_ℂ w + deriv (deriv B.h_ℂ) w

noncomputable def normAction1_ℂ {Ω : Set Plane} (B : AnalyticBoundaryData Ω) (X Y : ℂ) : ℂ :=
  (deriv B.ϕ_ℂ X / (B.c : ℂ)) *
    (supportAction1_ℂ B.h_ℂ (B.ϕ_ℂ X) (B.ϕ_ℂ Y) + B.h_ℂ (B.ϕ_ℂ X))

noncomputable def normAction2_ℂ {Ω : Set Plane} (B : AnalyticBoundaryData Ω) (X Y : ℂ) : ℂ :=
  (deriv B.ϕ_ℂ Y / (B.c : ℂ)) *
    (supportAction2_ℂ B.h_ℂ (B.ϕ_ℂ X) (B.ϕ_ℂ Y) - B.h_ℂ (B.ϕ_ℂ Y))

noncomputable def normAction12_ℂ {Ω : Set Plane} (B : AnalyticBoundaryData Ω) (X Y : ℂ) : ℂ :=
  (deriv B.ϕ_ℂ X * deriv B.ϕ_ℂ Y / (2 * (B.c : ℂ))) *
    r_ℂ B ((B.ϕ_ℂ X + B.ϕ_ℂ Y) / 2) *
    Complex.sin ((B.ϕ_ℂ Y - B.ϕ_ℂ X) / 2)

noncomputable def normActionRem_ℂ {Ω : Set Plane} (B : AnalyticBoundaryData Ω) (X b : ℂ) : ℂ :=
  (1 / 6 : ℂ) * ∫ τ in (0 : ℝ)..(1 : ℝ),
    ((1 - τ : ℝ) : ℂ) ^ 3 *
      iteratedDeriv 4 (fun b' : ℂ => normAction1_ℂ B X (X + b')) ((τ : ℂ) * b)

noncomputable def sinc_ℂ (z : ℂ) : ℂ :=
  ∫ τ in (0 : ℝ)..(1 : ℝ), Complex.cos ((τ : ℂ) * z)

noncomputable def fourierDiffMult (n : ℤ) (t : ℂ) : ℂ :=
  Complex.I * (n : ℂ) * sinc_ℂ ((n : ℂ) * t / 2)

noncomputable def fourierCoeff_ℂ (F : ℂ × ℂ → ℂ) (n : ℤ) (t : ℂ) : ℂ :=
  ((2 * Real.pi : ℝ) : ℂ)⁻¹ *
    ∫ x in (0 : ℝ)..(2 * Real.pi),
      Complex.exp (-Complex.I * (n : ℂ) * (x : ℂ)) * F ((x : ℂ), t)

noncomputable def glancingDiffOp (v : ℂ × ℂ → ℂ) (p : ℂ × ℂ) : ℂ :=
  ∫ μ in (-1 / 2 : ℝ)..(1 / 2 : ℝ),
    deriv (fun y' : ℂ => v (y', p.2)) (p.1 + (μ : ℂ) * p.2)

noncomputable def glancingAvgPlus (U : ℂ × ℂ → ℂ) (y t : ℂ) : ℂ :=
  ∫ lam in (0 : ℝ)..(1 : ℝ), deriv (fun y' : ℂ => U (y', t)) (y + (lam : ℂ) * t)

noncomputable def glancingAvgMinus (U : ℂ × ℂ → ℂ) (y t : ℂ) : ℂ :=
  ∫ lam in (0 : ℝ)..(1 : ℝ), deriv (fun y' : ℂ => U (y', t)) (y - (lam : ℂ) * t)

noncomputable def glancingSecondAvg (U : ℂ × ℂ → ℂ) (y t : ℂ) : ℂ :=
  ∫ lam in (0 : ℝ)..(1 : ℝ),
    (∫ μ in (-lam)..lam, deriv (deriv (fun y' : ℂ => U (y', t))) (y + (μ : ℂ) * t))

noncomputable def glancingResidualOp {Ω : Set Plane} (B : AnalyticBoundaryData Ω)
    (U : ℂ × ℂ → ℂ) (p : ℂ × ℂ) : ℂ :=
  let y := p.1
  let t := p.2
  let Up := deriv (fun y' : ℂ => U (y', t)) y
  let A_p := glancingAvgPlus U y t
  let A_m := glancingAvgMinus U y t
  let C_pm := glancingSecondAvg U y t
  (1 / 8 : ℂ) * Up * (A_p + A_m) * C_pm +
    t * Up *
      (A_p ^ 4 * normActionRem_ℂ B (U (y, t)) (t * A_p) -
        A_m ^ 4 * normActionRem_ℂ B (U (y, t)) (-t * A_m))

noncomputable def glancingPhaseSlope {Ω : Set Plane} (B : AnalyticBoundaryData Ω)
    (U : ℂ × ℂ → ℂ) (y t : ℂ) : ℂ :=
  (1 / 2 : ℂ) * ∫ μ in (-1 / 2 : ℝ)..(1 / 2 : ℝ),
    deriv B.ϕ_ℂ (U (y + (μ : ℂ) * t, t)) *
      deriv (fun y' : ℂ => U (y', t)) (y + (μ : ℂ) * t)

noncomputable def glancingLinCoeff {Ω : Set Plane} (B : AnalyticBoundaryData Ω)
    (U : ℂ × ℂ → ℂ) (p : ℂ × ℂ) : ℂ :=
  let y := p.1
  let t := p.2
  let U_m := U (y - t / 2, t)
  let U_p := U (y + t / 2, t)
  let W := glancingPhaseSlope B U y t
  (deriv B.ϕ_ℂ U_m * deriv B.ϕ_ℂ U_p / (2 * (B.c : ℂ))) *
    r_ℂ B ((B.ϕ_ℂ U_m + B.ϕ_ℂ U_p) / 2) *
    W * sinc_ℂ (t * W) *
    deriv (fun y' : ℂ => U (y', t)) (y - t / 2) *
    deriv (fun y' : ℂ => U (y', t)) (y + t / 2)

structure GlancingScalePackage {Ω : Set Plane} (B : AnalyticBoundaryData Ω) where
  s_act : ℝ
  d_act : ℝ
  η_adm : ℝ
  M_act : ℝ
  M_E : ℝ
  C_quad : ℝ
  s_act_pos : 0 < s_act
  s_act_le_half_s₀ : s_act ≤ B.s₀ / 2
  s_act_le_one : s_act ≤ 1
  d_act_pos : 0 < d_act
  d_act_lt_half_s_act : d_act < s_act / 2
  d_act_lt_one : d_act < 1
  d_act_lt_half_δ_col : d_act < B.δ_col / 2
  d_act_lt_half_τ₀ : d_act < B.τ₀ / 2
  η_adm_pos : 0 < η_adm
  η_adm_le_inv32 : η_adm ≤ 1 / 32
  η_adm_le_quarter_s₀ : η_adm ≤ B.s₀ / 4
  M_act_pos : 0 < M_act
  M_E_pos : 0 < M_E
  C_quad_pos : 0 < C_quad
  partial_y_holo : ∀ (W : Set (ℂ × ℂ)) (U : ℂ × ℂ → ℂ),
    IsOpen W → DifferentiableOn ℂ U W →
    DifferentiableOn ℂ (fun p : ℂ × ℂ => deriv (fun y' : ℂ => U (y', p.2)) p.1) W
  partial_t_holo : ∀ (W : Set (ℂ × ℂ)) (U : ℂ × ℂ → ℂ),
    IsOpen W → DifferentiableOn ℂ U W →
    DifferentiableOn ℂ (fun p : ℂ × ℂ => deriv (fun t' : ℂ => U (p.1, t')) p.2) W
  real_step_collar : ∀ x₀ x₁ : ℝ,
    0 < x₁ - x₀ → x₁ - x₀ ≤ (3 / 2 : ℝ) * d_act →
    x₁ - x₀ < B.δ_col ∧ 0 < B.ϕ x₁ - B.ϕ x₀ ∧ B.ϕ x₁ - B.ϕ x₀ < Real.pi
  E_op_props : ∀ (s d : ℝ) (U : ℂ × ℂ → ℂ),
    0 < s → s ≤ s_act → 0 < d → d ≤ d_act → d < s / 2 →
    IsAdmissibleGlancingCand s d η_adm U →
    DifferentiableOn ℂ (glancingResidualOp B U) (glancingDomain 1 s d) ∧
    (∀ y t : ℂ, (y, t) ∈ glancingDomain 1 s d →
      glancingResidualOp B U (y + 2 * Real.pi, t) = glancingResidualOp B U (y, t) ∧
      glancingResidualOp B U (y, -t) = glancingResidualOp B U (y, t) ∧
      glancingResidualOp B U (starRingEnd ℂ y, starRingEnd ℂ t) =
        starRingEnd ℂ (glancingResidualOp B U (y, t))) ∧
    (∀ t : ℂ, ‖t‖ < d → (∫ x in (0 : ℝ)..(2 * Real.pi), glancingResidualOp B U (x, t)) = 0) ∧
    (∀ y : ℂ, |y.im| < s →
      glancingResidualOp B U (y, 0) =
        (1 / 4 : ℂ) * (deriv (fun y' : ℂ => U (y', 0)) y) ^ 2 *
          deriv (deriv (fun y' : ℂ => U (y', 0))) y)
  formal_perturbation :
    ∀ (s s' d η_prev η_next M_prev M_u : ℝ) (j : ℕ) (U_prev : ℂ × ℂ → ℂ) (u_j : ℂ → ℂ),
      0 < s' → s' < s → s ≤ s_act → 0 < d → d ≤ d_act → d < s / 2 →
      0 ≤ η_prev → η_prev < η_next → η_next ≤ η_adm →
      0 < M_prev → 0 < M_u → 1 ≤ j →
      IsAdmissibleGlancingCand s d η_prev U_prev →
      (∀ y : ℂ, |y.im| < s → U_prev (y, 0) = y) →
      (∀ p ∈ glancingDomain 1 s d, ‖glancingResidualOp B U_prev p‖ ≤ M_prev * ‖p.2‖ ^ (2 * j)) →
      DifferentiableOn ℂ u_j (horizStrip s) →
      (∀ y ∈ horizStrip s, u_j (y + 2 * Real.pi) = u_j y) →
      (∀ y ∈ horizStrip s, u_j (starRingEnd ℂ y) = starRingEnd ℂ (u_j y)) →
      (∀ y ∈ horizStrip s, ‖u_j y‖ ≤ M_u) →
      ∃ (d₁ M_next : ℝ), 0 < d₁ ∧ d₁ ≤ d ∧ d₁ < s' / 2 ∧ 0 < M_next ∧
        IsAdmissibleGlancingCand s' d₁ η_next
          (fun p => U_prev p + u_j p.1 * p.2 ^ (2 * j)) ∧
        (∀ p ∈ glancingDomain 1 s' d₁,
          ‖glancingResidualOp B (fun q => U_prev q + u_j q.1 * q.2 ^ (2 * j)) p -
            (glancingResidualOp B U_prev p +
              (1 / 4 : ℂ) * deriv (deriv u_j) p.1 * p.2 ^ (2 * j))‖ ≤
            M_next * ‖p.2‖ ^ (2 * j + 2))
  E_op_cont : ∀ (s d : ℝ) (U_seq : ℕ → ℂ × ℂ → ℂ) (U_lim : ℂ × ℂ → ℂ),
    0 < s → s ≤ s_act → 0 < d → d ≤ d_act → d < s / 2 →
    (∀ n : ℕ, IsAdmissibleGlancingCand s d η_adm (U_seq n)) →
    IsAdmissibleGlancingCand s d η_adm U_lim →
    (∀ k : ℕ, k ≤ 2 →
      TendstoUniformlyOn
        (fun (n : ℕ) (p : ℂ × ℂ) =>
          iteratedDeriv k (fun y' : ℂ => U_seq n (y', p.2) - U_lim (y', p.2)) p.1)
        (fun _ => (0 : ℂ)) Filter.atTop (glancingDomain 0 s d)) →
    ∀ p ∈ glancingDomain 1 s d,
      Filter.Tendsto (fun n : ℕ => glancingResidualOp B (U_seq n) p)
        Filter.atTop (nhds (glancingResidualOp B U_lim p))
  stationarity_equiv : ∀ (s d : ℝ) (U : ℂ × ℂ → ℂ),
    0 < s → s ≤ s_act → 0 < d → d ≤ d_act → d < s / 2 →
    IsAdmissibleGlancingCand s d η_adm U →
    (∀ y t : ℂ, |y.im| < s → ‖t‖ < d → U (y, t) ∈ horizStrip (2 * B.s₀)) →
    (∀ p ∈ glancingDomain 1 s d, glancingResidualOp B U p = 0) →
    ∀ y t : ℂ, |y.im| + ‖t‖ < s → ‖t‖ < d →
      -supportAction1_ℂ B.h_ℂ (B.ϕ_ℂ (U (y, t))) (B.ϕ_ℂ (U (y + t, t))) =
        supportAction2_ℂ B.h_ℂ (B.ϕ_ℂ (U (y - t, t))) (B.ϕ_ℂ (U (y, t)))
  normAction1_holo : DifferentiableOn ℂ (fun q : ℂ × ℂ => normAction1_ℂ B q.1 q.2)
    (horizStrip (3 * B.s₀ / 2) ×ˢ horizStrip (3 * B.s₀ / 2))
  normAction2_holo : DifferentiableOn ℂ (fun q : ℂ × ℂ => normAction2_ℂ B q.1 q.2)
    (horizStrip (3 * B.s₀ / 2) ×ˢ horizStrip (3 * B.s₀ / 2))
  normAction12_holo : DifferentiableOn ℂ (fun q : ℂ × ℂ => normAction12_ℂ B q.1 q.2)
    (horizStrip (3 * B.s₀ / 2) ×ˢ horizStrip (3 * B.s₀ / 2))
  normAction_diag_periodic : ∀ X Y : ℂ,
    X ∈ horizStrip (3 * B.s₀ / 2) → Y ∈ horizStrip (3 * B.s₀ / 2) →
    normAction1_ℂ B (X + 2 * Real.pi) (Y + 2 * Real.pi) = normAction1_ℂ B X Y ∧
    normAction2_ℂ B (X + 2 * Real.pi) (Y + 2 * Real.pi) = normAction2_ℂ B X Y ∧
    normAction12_ℂ B (X + 2 * Real.pi) (Y + 2 * Real.pi) = normAction12_ℂ B X Y
  normAction_conj : ∀ X Y : ℂ,
    X ∈ horizStrip (3 * B.s₀ / 2) → Y ∈ horizStrip (3 * B.s₀ / 2) →
    normAction1_ℂ B (starRingEnd ℂ X) (starRingEnd ℂ Y) =
      starRingEnd ℂ (normAction1_ℂ B X Y) ∧
    normAction2_ℂ B (starRingEnd ℂ X) (starRingEnd ℂ Y) =
      starRingEnd ℂ (normAction2_ℂ B X Y) ∧
    normAction12_ℂ B (starRingEnd ℂ X) (starRingEnd ℂ Y) =
      starRingEnd ℂ (normAction12_ℂ B X Y)
  normAction2_eq_neg_swap : ∀ X Y : ℂ, normAction2_ℂ B X Y = -normAction1_ℂ B Y X
  deriv_normAction1_right : ∀ X Y : ℂ,
    X ∈ horizStrip (3 * B.s₀ / 2) → Y ∈ horizStrip (3 * B.s₀ / 2) →
    deriv (fun Y' : ℂ => normAction1_ℂ B X Y') Y = normAction12_ℂ B X Y
  deriv_normAction2_left : ∀ X Y : ℂ,
    X ∈ horizStrip (3 * B.s₀ / 2) → Y ∈ horizStrip (3 * B.s₀ / 2) →
    deriv (fun X' : ℂ => normAction2_ℂ B X' Y) X = normAction12_ℂ B X Y
  normAction_real_stationary_iff : ∀ x₀ x₁ x₂ : ℝ,
    normAction1_ℂ B (x₁ : ℂ) (x₂ : ℂ) + normAction2_ℂ B (x₀ : ℂ) (x₁ : ℂ) = 0 ↔
      -supportAction1_ℝ B.h (B.ϕ x₁) (B.ϕ x₂) = supportAction2_ℝ B.h (B.ϕ x₀) (B.ϕ x₁)
  normAction_bound : ∀ X Y : ℂ,
    X ∈ horizStrip (5 * B.s₀ / 4) → Y ∈ horizStrip (5 * B.s₀ / 4) →
    ‖normAction1_ℂ B X Y‖ ≤ M_act ∧
    ‖normAction2_ℂ B X Y‖ ≤ M_act ∧
    ‖normAction12_ℂ B X Y‖ ≤ M_act
  residual_and_linCoeff_ne_zero : ∀ (σ : ℝ) (t : ℂ) (u : ℂ → ℂ),
    0 < σ → σ ≤ s_act → t ≠ 0 → ‖t‖ < d_act →
    DifferentiableOn ℂ u (horizStrip σ) →
    (∀ k : ℕ, k ≤ 2 → ∀ z ∈ horizStrip σ,
      ‖iteratedDeriv k (fun y' : ℂ => u y' - y') z‖ ≤ 5 * η_adm / 4) →
    (∀ y : ℂ, |y.im| + |t.im| < σ →
      glancingResidualOp B (fun q => u q.1) (y, t) =
        t⁻¹ ^ 3 * deriv u y *
          (normAction1_ℂ B (u y) (u (y + t)) + normAction2_ℂ B (u (y - t)) (u y))) ∧
    (∀ y : ℂ, |y.im| + |t.im| / 2 < σ →
      glancingLinCoeff B (fun q => u q.1) (y, t) =
        t⁻¹ * normAction12_ℂ B (u (y - t / 2)) (u (y + t / 2)) *
          deriv u (y - t / 2) * deriv u (y + t / 2))
  enlarged_holo_and_bounds : ∀ (σ : ℝ) (V_t : Set ℂ) (U : ℂ × ℂ → ℂ),
    0 < σ → σ ≤ s_act → IsOpen V_t → V_t ⊆ Metric.ball (0 : ℂ) d_act →
    DifferentiableOn ℂ U (horizStrip σ ×ˢ V_t) →
    (∀ k : ℕ, k ≤ 2 → ∀ z ∈ horizStrip σ, ∀ t ∈ V_t,
      ‖iteratedDeriv k (fun y' : ℂ => U (y', t) - y') z‖ ≤ 5 * η_adm / 4) →
    DifferentiableOn ℂ (glancingResidualOp B U)
      { p : ℂ × ℂ | p.2 ∈ V_t ∧ |p.1.im| + |p.2.im| < σ } ∧
    (∀ p : ℂ × ℂ, p.2 ∈ V_t → |p.1.im| + |p.2.im| < σ →
      ‖glancingResidualOp B U p‖ ≤ M_E) ∧
    DifferentiableOn ℂ (glancingLinCoeff B U)
      { p : ℂ × ℂ | p.2 ∈ V_t ∧ |p.1.im| + |p.2.im| / 2 < σ } ∧
    (∀ p : ℂ × ℂ, p.2 ∈ V_t → |p.1.im| + |p.2.im| / 2 < σ →
      ‖4 * glancingLinCoeff B U p - 1‖ ≤ 1 / 4)
  linCoeff_props : ∀ (s d : ℝ) (U : ℂ × ℂ → ℂ),
    0 < s → s ≤ s_act → 0 < d → d ≤ d_act → d < s / 2 →
    IsAdmissibleGlancingCand s d η_adm U →
    DifferentiableOn ℂ (glancingLinCoeff B U) (glancingDomain (1 / 2) s d) ∧
    (∀ y t : ℂ, (y, t) ∈ glancingDomain (1 / 2) s d →
      glancingLinCoeff B U (y + 2 * Real.pi, t) = glancingLinCoeff B U (y, t) ∧
      glancingLinCoeff B U (y, -t) = glancingLinCoeff B U (y, t) ∧
      glancingLinCoeff B U (starRingEnd ℂ y, starRingEnd ℂ t) =
        starRingEnd ℂ (glancingLinCoeff B U (y, t)) ∧
      ‖4 * glancingLinCoeff B U (y, t) - 1‖ ≤ 1 / 4)
  slice_quad_approx : ∀ (σ ρ : ℝ) (y t : ℂ) (u v : ℂ → ℂ),
    0 < σ → σ ≤ s_act → ‖t‖ < d_act → |y.im| + |t.im| < σ →
    0 ≤ ρ → ρ ≤ η_adm / 8 →
    DifferentiableOn ℂ u (horizStrip σ) →
    DifferentiableOn ℂ v (horizStrip σ) →
    (∀ k : ℕ, k ≤ 2 → ∀ z ∈ horizStrip σ,
      ‖iteratedDeriv k (fun z' : ℂ => u z' - z') z‖ ≤ η_adm) →
    (∀ k : ℕ, k ≤ 2 → ∀ z ∈ horizStrip σ,
      ‖iteratedDeriv k (fun z' : ℂ => deriv u z' * v z') z‖ ≤ ρ) →
    ‖glancingResidualOp B (fun q => u q.1 + deriv u q.1 * v q.1) (y, t) -
      glancingResidualOp B (fun q => u q.1) (y, t) -
      (glancingDiffOp
        (fun q =>
          glancingLinCoeff B (fun r => u r.1) (q.1, t) *
            glancingDiffOp (fun r => v r.1) (q.1, t))
        (y, t) +
        deriv
          (fun z : ℂ => glancingResidualOp B (fun r => u r.1) (z, t) * v z)
          y)‖ ≤ C_quad * ρ ^ 2
  exact_jet_deriv : ∀ (t₀ σ σ' r_t : ℝ) (U_cand : ℂ × ℂ → ℂ),
    0 < t₀ → 0 < r_t → t₀ + r_t ≤ d_act →
    0 < σ' → σ' + r_t ≤ σ → σ ≤ s_act →
    DifferentiableOn ℂ U_cand (horizStrip σ ×ˢ Metric.ball (t₀ : ℂ) r_t) →
    (∀ k : ℕ, k ≤ 2 → ∀ z ∈ horizStrip σ, ∀ t ∈ Metric.ball (t₀ : ℂ) r_t,
      ‖iteratedDeriv k (fun y' : ℂ => U_cand (y', t) - y') z‖ ≤ 5 * η_adm / 4) →
    (∀ z ∈ horizStrip σ, glancingResidualOp B U_cand (z, (t₀ : ℂ)) = 0) →
    ∀ y ∈ horizStrip σ',
      let u_star : ℂ → ℂ := fun z => U_cand (z, (t₀ : ℂ))
      let z_jet : ℂ → ℂ :=
        fun z => deriv (fun t : ℂ => U_cand (z, t)) (t₀ : ℂ) / deriv u_star z
      deriv (fun t : ℂ => glancingResidualOp B U_cand (y, t)) (t₀ : ℂ) =
        glancingDiffOp
          (fun q =>
            glancingLinCoeff B U_cand (q.1, (t₀ : ℂ)) *
              (glancingDiffOp (fun r => z_jet r.1) (q.1, (t₀ : ℂ)) + ((t₀ : ℂ))⁻¹))
          (y, (t₀ : ℂ))

def RationalCompatProp {Ω : Set Plane} (B : AnalyticBoundaryData Ω)
    (S : GlancingScalePackage B) : Prop :=
  ∃ (C_rat : ℝ) (B_rat : ℕ), 0 < C_rat ∧
    ∀ (s d δ ε : ℝ) (N : ℕ) (U : ℂ × ℂ → ℂ),
      0 < s → s ≤ S.s_act → 0 < d → d ≤ S.d_act → d < s / 2 →
      0 < δ → δ < d / 100 → 0 < ε → ε < 1 → 1 ≤ N →
      IsAdmissibleGlancingCand s d (3 * S.η_adm / 4) U →
      C_rat * (1 + (N : ℝ) + δ⁻¹) ^ B_rat * ε ≤ 1 →
      (∀ p ∈ glancingDomain 1 s d, ‖glancingResidualOp B U p‖ ≤ ε) →
      ∀ (l : ℤ) (q : ℕ),
        l ≠ 0 → 1 ≤ q → q ≤ N → Nat.Coprime l.natAbs q →
        let t₀ : ℝ := (2 * Real.pi * (l : ℝ)) / (q : ℝ)
        |t₀| < d - 2 * δ →
        ∃ W_jet : ℂ × ℂ → ℂ,
          DifferentiableOn ℂ W_jet
            (horizStrip (s - 8 * δ) ×ˢ Metric.ball (t₀ : ℂ) (δ / 8)) ∧
          (∀ y ∈ horizStrip (s - 8 * δ), ∀ t ∈ Metric.ball (t₀ : ℂ) (δ / 8),
            W_jet (y + 2 * Real.pi, t) = W_jet (y, t)) ∧
          (let Q := 1 + (N : ℝ) + δ⁻¹
           let g_jet : ℂ × ℂ → ℂ := fun p => glancingLinCoeff B U p * glancingDiffOp W_jet p
           DifferentiableOn ℂ g_jet
             (horizStrip (s - 9 * δ) ×ˢ Metric.ball (t₀ : ℂ) (δ / 8)) ∧
           (∀ y ∈ horizStrip (s - 9 * δ), ∀ t ∈ Metric.ball (t₀ : ℂ) (δ / 8),
             g_jet (y + 2 * Real.pi, t) = g_jet (y, t) ∧
             ‖g_jet (y, t)‖ ≤ C_rat * Q ^ B_rat * ε ∧
             ‖glancingDiffOp W_jet (y, t)‖ ≤ C_rat * Q ^ B_rat * ε) ∧
           DifferentiableOn ℂ
             (fun p : ℂ × ℂ => glancingResidualOp B U p + glancingDiffOp g_jet p)
             (horizStrip (s - 10 * δ) ×ˢ Metric.ball (t₀ : ℂ) (δ / 8)) ∧
           DifferentiableOn ℂ
             (fun y : ℂ =>
               deriv
                 (fun t : ℂ => glancingResidualOp B U (y, t) + glancingDiffOp g_jet (y, t))
                 (t₀ : ℂ))
             (horizStrip (s - 10 * δ)) ∧
           (∀ y ∈ horizStrip (s - 10 * δ),
             ‖glancingResidualOp B U (y, (t₀ : ℂ)) + glancingDiffOp g_jet (y, (t₀ : ℂ))‖ ≤
               C_rat * Q ^ B_rat * ε ^ 2 ∧
             ‖deriv
                 (fun t : ℂ => glancingResidualOp B U (y, t) + glancingDiffOp g_jet (y, t))
                 (t₀ : ℂ)‖ ≤
               C_rat * Q ^ B_rat * ε ^ 2))

def BufferedFourierDivProp : Prop :=
  (∀ (σ M : ℝ) (G : ℂ → ℂ),
    0 < σ → 0 ≤ M → DifferentiableOn ℂ G (horizStrip σ) →
    (∀ z ∈ horizStrip σ, G (z + 2 * Real.pi) = G z ∧ ‖G z‖ ≤ M) →
    (∀ n : ℤ, ‖fourierCoeff_ℂ (fun p => G p.1) n 0‖ ≤ M * Real.exp (-|(n : ℝ)| * σ)) ∧
    (∀ y ∈ horizStrip σ,
      HasSum
        (fun n : ℤ =>
          fourierCoeff_ℂ (fun p => G p.1) n 0 * Complex.exp (Complex.I * (n : ℂ) * y))
        (G y))) ∧
  (∀ (σ : ℝ) (t : ℂ) (G : ℂ × ℂ → ℂ),
    |t.im| / 2 < σ →
    DifferentiableOn ℂ (fun y : ℂ => G (y, t)) (horizStrip σ) →
    (∀ y ∈ horizStrip σ, G (y + 2 * Real.pi, t) = G (y, t)) →
    ∀ n : ℤ,
      fourierCoeff_ℂ (glancingDiffOp G) n t = fourierDiffMult n t * fourierCoeff_ℂ G n t) ∧
  ∃ (C_div : ℝ) (B_div : ℕ), 0 < C_div ∧
    ∀ (s d δ ν M η : ℝ) (N j₀ a b J : ℕ) (F : ℂ × ℂ → ℂ),
      0 < s → 0 < d → d < 1 → d < s / 2 → 0 < δ → δ < d / 100 →
      (ν = 1 / 2 ∨ ν = 1) → 1 ≤ N →
      j₀ ≤ a → j₀ + 1 ≤ b → max a (b + 1) + 1 ≤ J → J ≤ 20 →
      0 ≤ M → 0 ≤ η →
      DifferentiableOn ℂ F (glancingDomain ν (s - (j₀ : ℝ) * δ) (d - (j₀ : ℝ) * δ)) →
      (∀ y t : ℂ, (y, t) ∈ glancingDomain ν (s - (j₀ : ℝ) * δ) (d - (j₀ : ℝ) * δ) →
        F (y + 2 * Real.pi, t) = F (y, t) ∧
        F (y, -t) = F (y, t) ∧
        F (starRingEnd ℂ y, starRingEnd ℂ t) = starRingEnd ℂ (F (y, t)) ∧
        ‖F (y, t)‖ ≤ M) →
      (∀ t : ℂ, ‖t‖ < d - (j₀ : ℝ) * δ →
        (∫ x in (0 : ℝ)..(2 * Real.pi), F ((x : ℂ), t)) = 0) →
      (∀ (n : ℤ) (j : ℤ),
        1 ≤ |n| → |n| ≤ (N : ℤ) → j ≠ 0 →
        |(2 * Real.pi * (j : ℝ)) / (n : ℝ)| < d - (b : ℝ) * δ →
        ‖fourierCoeff_ℂ F n (((2 * Real.pi * (j : ℝ)) / (n : ℝ) : ℝ) : ℂ)‖ ≤
          η * Real.exp (-|(n : ℝ)| * (s - (a : ℝ) * δ))) →
      ∃ (H_mode R_mode : ℤ → ℂ → ℂ),
        (∀ n : ℤ, n = 0 ∨ (N : ℤ) < |n| → ∀ t : ℂ, H_mode n t = 0 ∧ R_mode n t = 0) ∧
        (∀ n : ℤ, 1 ≤ |n| → |n| ≤ (N : ℤ) →
          DifferentiableOn ℂ (H_mode n)
            (Metric.ball (0 : ℂ) (d - ((b + 1 : ℕ) : ℝ) * δ)) ∧
          Differentiable ℂ (R_mode n) ∧
          (∀ t ∈ Metric.ball (0 : ℂ) (d - ((b + 1 : ℕ) : ℝ) * δ),
            fourierDiffMult n t * H_mode n t = fourierCoeff_ℂ F n t - R_mode n t ∧
            ‖R_mode n t‖ + ((N : ℝ))⁻¹ * ‖deriv (R_mode n) t‖ ≤
              C_div * (1 + (N : ℝ) + δ⁻¹) ^ B_div * η *
                Real.exp (-|(n : ℝ)| * (s - (a : ℝ) * δ - |t.im| / 2)))) ∧
        (let H : ℂ × ℂ → ℂ :=
          fun p =>
            ∑ n ∈ Finset.Icc (-(N : ℤ)) (N : ℤ),
              H_mode n p.2 * Complex.exp (Complex.I * (n : ℂ) * p.1)
         let Q := 1 + (N : ℝ) + δ⁻¹
         DifferentiableOn ℂ H
           (glancingDomain 0 (s - (J : ℝ) * δ) (d - ((b + 1 : ℕ) : ℝ) * δ)) ∧
         (∀ y t : ℂ, ‖t‖ < d - ((b + 1 : ℕ) : ℝ) * δ →
           H (y + 2 * Real.pi, t) = H (y, t) ∧
           H (y, -t) = H (y, t) ∧
           H (starRingEnd ℂ y, starRingEnd ℂ t) = starRingEnd ℂ (H (y, t)) ∧
           (∫ x in (0 : ℝ)..(2 * Real.pi), H ((x : ℂ), t)) = 0) ∧
         (∀ p ∈ glancingDomain (ν - 1 / 2) (s - (J : ℝ) * δ) (d - (J : ℝ) * δ),
           ‖H p‖ ≤ C_div * Q ^ B_div * (M + η)) ∧
         (∀ p ∈ glancingDomain ν (s - (J : ℝ) * δ) (d - (J : ℝ) * δ),
           ‖glancingDiffOp H p - F p‖ ≤
             C_div * Q ^ B_div * (η + M * Real.exp (-(N : ℝ) * δ))))
noncomputable def supportBoundaryPt (c₀ : Plane) (h : ℝ → ℝ) (θ : ℝ) : Plane :=
  c₀ + h θ • unitNormalVec θ + deriv h θ • unitTangentVec θ

def phaseStrip (h : ℝ → ℝ) : Set (ℝ × ℝ) :=
  { z : ℝ × ℝ | -h (z.1 + Real.pi) < z.2 ∧ z.2 < h z.1 }

structure SupportBoundaryPackage (Ω : Set Plane) extends SupportLazutkinData Ω where
  r₀ : ℝ
  r₀_pos : 0 < r₀
  closedBall_subset : Metric.closedBall c₀ (2 * r₀) ⊆ Ω
  two_r₀_le_h : ∀ θ : ℝ, 2 * r₀ ≤ h θ
  Γ_mem_frontier : ∀ θ : ℝ, supportBoundaryPt c₀ h θ ∈ frontier Ω
  Γ_inj_mod_two_pi : ∀ θ₁ θ₂ : ℝ,
    supportBoundaryPt c₀ h θ₁ = supportBoundaryPt c₀ h θ₂ →
    ∃ k : ℤ, θ₁ - θ₂ = k * (2 * Real.pi)
  Γ_outward_normal : ∀ θ : ℝ,
    IsOutwardUnitNormal Ω (supportBoundaryPt c₀ h θ) (unitNormalVec θ)
  support_bound_closure : ∀ θ : ℝ, ∀ x ∈ closure Ω,
    inner ℝ (x - c₀) (unitNormalVec θ) ≤ h θ

structure SupportPhaseMapData (Ω : Set Plane) (B : SupportBoundaryPackage Ω) where
  Theta_plus : ℝ → ℝ → ℝ
  P_plus : ℝ → ℝ → ℝ
  Theta_minus : ℝ → ℝ → ℝ
  P_minus : ℝ → ℝ → ℝ
  Theta_plus_cont : ContinuousOn (fun z : ℝ × ℝ => Theta_plus z.1 z.2) (phaseStrip B.h)
  Theta_minus_cont : ContinuousOn (fun z : ℝ × ℝ => Theta_minus z.1 z.2) (phaseStrip B.h)
  Theta_plus_bounds : ∀ θ p : ℝ, (θ, p) ∈ phaseStrip B.h →
    θ < Theta_plus θ p ∧ Theta_plus θ p < θ + 2 * Real.pi
  Theta_minus_bounds : ∀ θ p : ℝ, (θ, p) ∈ phaseStrip B.h →
    θ - 2 * Real.pi < Theta_minus θ p ∧ Theta_minus θ p < θ
  Theta_plus_quasiperiodic : ∀ θ p : ℝ, (θ, p) ∈ phaseStrip B.h →
    Theta_plus (θ + 2 * Real.pi) p = Theta_plus θ p + 2 * Real.pi
  Theta_plus_strictAnti_p : ∀ θ p₁ p₂ : ℝ,
    (θ, p₁) ∈ phaseStrip B.h → (θ, p₂) ∈ phaseStrip B.h → p₁ < p₂ →
    Theta_plus θ p₂ < Theta_plus θ p₁
  Theta_plus_tendsto_zero : ∀ ε : ℝ, 0 < ε → ∃ δ_p : ℝ, 0 < δ_p ∧
    ∀ θ p : ℝ, (θ, p) ∈ phaseStrip B.h → B.h θ - p < δ_p →
      Theta_plus θ p - θ < ε ∧ B.r₀ < P_plus θ p
  Theta_minus_tendsto_zero : ∀ ε : ℝ, 0 < ε → ∃ δ_p : ℝ, 0 < δ_p ∧
    ∀ θ p : ℝ, (θ, p) ∈ phaseStrip B.h → B.h θ - p < δ_p →
      θ - Theta_minus θ p < ε ∧ B.r₀ < P_minus θ p
  Theta_plus_eq : ∀ θ p : ℝ, (θ, p) ∈ phaseStrip B.h →
    -supportAction1_ℝ B.h θ (Theta_plus θ p) = p ∧
    P_plus θ p = supportAction2_ℝ B.h θ (Theta_plus θ p)
  P_minus_eq : ∀ θ p : ℝ, (θ, p) ∈ phaseStrip B.h →
    P_minus θ p = -supportAction1_ℝ B.h (Theta_minus θ p) θ
  Phi_maps_to : ∀ θ p : ℝ, (θ, p) ∈ phaseStrip B.h →
    (Theta_plus θ p, P_plus θ p) ∈ phaseStrip B.h ∧
    (Theta_minus θ p, P_minus θ p) ∈ phaseStrip B.h
  Phi_left_inv : ∀ θ p : ℝ, (θ, p) ∈ phaseStrip B.h →
    Theta_minus (Theta_plus θ p) (P_plus θ p) = θ ∧
    P_minus (Theta_plus θ p) (P_plus θ p) = p
  Phi_right_inv : ∀ θ p : ℝ, (θ, p) ∈ phaseStrip B.h →
    Theta_plus (Theta_minus θ p) (P_minus θ p) = θ ∧
    P_plus (Theta_minus θ p) (P_minus θ p) = p
  Phi_measure_preserving : ∀ S : Set (ℝ × ℝ), MeasurableSet S → S ⊆ phaseStrip B.h →
    MeasureTheory.volume ((fun z : ℝ × ℝ => (Theta_plus z.1 z.2, P_plus z.1 z.2)) '' S) =
      MeasureTheory.volume S
  forward_step_unique : ∀ x₀ x₁ x₂ x₂' : ℝ,
    0 < B.ϕ x₁ - B.ϕ x₀ → B.ϕ x₁ - B.ϕ x₀ < Real.pi →
    0 < B.ϕ x₂ - B.ϕ x₁ → B.ϕ x₂ - B.ϕ x₁ < Real.pi →
    0 < B.ϕ x₂' - B.ϕ x₁ → B.ϕ x₂' - B.ϕ x₁ < Real.pi →
    -supportAction1_ℝ B.h (B.ϕ x₁) (B.ϕ x₂) = supportAction2_ℝ B.h (B.ϕ x₀) (B.ϕ x₁) →
    -supportAction1_ℝ B.h (B.ϕ x₁) (B.ϕ x₂') = supportAction2_ℝ B.h (B.ϕ x₀) (B.ϕ x₁) →
    x₂ = x₂'
  chord_reflection : ∀ θ p : ℝ, (θ, p) ∈ phaseStrip B.h →
    ∃ P Q : Plane, P ∈ frontier Ω ∧ Q ∈ frontier Ω ∧ P ≠ Q ∧
      Q - P = ‖Q - P‖ • unitTangentVec θ ∧
      (∀ y ∈ Ω, inner ℝ (y - B.c₀) (unitNormalVec θ) = p → y ∈ segment ℝ P Q) ∧
      (∃ n_Q : Plane, IsOutwardUnitNormal Ω Q n_Q ∧
        ∀ R ∈ frontier Ω, R ≠ Q →
          (∃ s : ℝ, 0 < s ∧ R = Q + s • billiardReflect n_Q (‖Q - P‖⁻¹ • (Q - P))) →
          (∀ y ∈ segment ℝ Q R,
            inner ℝ (y - B.c₀) (unitNormalVec (Theta_plus θ p)) = P_plus θ p) ∧
          R - Q = ‖R - Q‖ • unitTangentVec (Theta_plus θ p)) ∧
      (∃ n_P : Plane, IsOutwardUnitNormal Ω P n_P ∧
        ∀ R' ∈ frontier Ω, R' ≠ P →
          (∃ s : ℝ, 0 < s ∧ R' = P + s • billiardReflect n_P (‖P - Q‖⁻¹ • (P - Q))) →
          (∀ y ∈ segment ℝ P R',
            inner ℝ (y - B.c₀) (unitNormalVec (Theta_minus θ p)) = P_minus θ p) ∧
          P - R' = ‖P - R'‖ • unitTangentVec (Theta_minus θ p))

structure PhaseCollarGraphData (Ω : Set Plane) (B : SupportBoundaryPackage Ω)
    (P : SupportPhaseMapData Ω B) where
  b_init : ℝ
  b_init_pos : 0 < b_init
  g_col : ℝ → ℝ → ℝ
  g_col_cont : ContinuousOn (fun z : ℝ × ℝ => g_col z.1 z.2) (Set.Ioo 0 b_init ×ˢ Set.univ)
  g_col_periodic : ∀ b ∈ Set.Ioo 0 b_init, Function.Periodic (g_col b) (2 * Real.pi)
  g_col_bounds : ∀ b ∈ Set.Ioo 0 b_init, ∀ θ : ℝ, B.r₀ < g_col b θ ∧ g_col b θ < B.h θ
  g_col_strictAnti_b : ∀ b₁ b₂ : ℝ, 0 < b₁ → b₁ < b₂ → b₂ < b_init → ∀ θ : ℝ,
    g_col b₂ θ < g_col b₁ θ
  g_col_tendsto_h : ∀ ε : ℝ, 0 < ε → ∃ b₁ : ℝ, 0 < b₁ ∧ b₁ ≤ b_init ∧
    ∀ b ∈ Set.Ioo 0 b₁, ∀ θ : ℝ, B.h θ - g_col b θ < ε
  g_col_invariant : ∀ b ∈ Set.Ioo 0 b_init, ∀ θ : ℝ,
    P.P_plus θ (g_col b θ) = g_col b (P.Theta_plus θ (g_col b θ))
  F_raw_strictMono_θ : ∀ b ∈ Set.Ioo 0 b_init,
    StrictMono (fun θ : ℝ => P.Theta_plus θ (g_col b θ))
  F_raw_step_lt_pi : ∀ b ∈ Set.Ioo 0 b_init, ∀ θ : ℝ,
    P.Theta_plus θ (g_col b θ) - θ < Real.pi
def MeroDiskContinuationProp : Prop :=
  ∀ (r_w ρ R : ℝ) (w₀ : ℂ) (r₀ : ℝ),
    0 < r_w → 0 < ρ → ρ < R → 0 < r₀ →
    Metric.ball w₀ r₀ ⊆ Metric.ball (0 : ℂ) r_w →
    ∀ (F : MeroOn2D (Metric.ball (0 : ℂ) r_w ×ˢ { ζ : ℂ | ρ < ‖ζ‖ ∧ ‖ζ‖ < R }))
      (F₀ : MeroOn2D (Metric.ball w₀ r₀ ×ˢ Metric.ball (0 : ℂ) R)),
      MeroEqOn F F₀ (Metric.ball w₀ r₀ ×ˢ { ζ : ℂ | ρ < ‖ζ‖ ∧ ‖ζ‖ < R }) →
      ∃ F_ext : MeroOn2D (Metric.ball (0 : ℂ) r_w ×ˢ Metric.ball (0 : ℂ) R),
        MeroEqOn F_ext F (Metric.ball (0 : ℂ) r_w ×ˢ { ζ : ℂ | ρ < ‖ζ‖ ∧ ‖ζ‖ < R })

structure CollarWidthTubeData {Ω : Set Plane} (C : AnalyticGlancingCollar Ω)
    (hDet : EndpointDeterminationData C) where
  s_base : ℝ
  r_base : ℝ
  s_base_pos : 0 < s_base
  s_base_le_det : s_base ≤ hDet.s_det
  s_base_le_s₁ : s_base ≤ C.s₁ / 4
  s_base_le_s₀ : s_base ≤ C.s₀ / 2
  r_base_pos : 0 < r_base
  r_base_le_det : r_base ≤ hDet.r_det
  r_base_lt_s_base : r_base < s_base / 4
  r_base_lt_r₁ : r_base < C.r₁ / 2
  r_base_lt_pi : r_base < Real.pi
  offset_ne_zero : ∀ y t : ℂ, |y.im| < 2 * s_base → ‖t‖ < 2 * r_base →
    glancingOffset C y t ≠ 0
  h_X : ℂ → ENNReal
  h_L : ℂ → ENNReal
  h_X_ge_two : ∀ t ∈ Metric.ball (0 : ℂ) r_base, ENNReal.ofReal (2 * s_base) ≤ h_X t
  h_L_eq : ∀ t ∈ Metric.ball (0 : ℂ) r_base,
    h_L t = h_X t + ENNReal.ofReal (|t.im| / 2)
  h_X_even : ∀ t ∈ Metric.ball (0 : ℂ) r_base, h_X (-t) = h_X t
  h_L_even : ∀ t ∈ Metric.ball (0 : ℂ) r_base, h_L (-t) = h_L t
  h_X_lsc : LowerSemicontinuousOn h_X (Metric.ball (0 : ℂ) r_base)
  h_L_lsc : LowerSemicontinuousOn h_L (Metric.ball (0 : ℂ) r_base)
  h_X_supermean : ∀ (t₀ : ℂ) (ρ : ℝ), 0 < ρ → ‖t₀‖ + ρ < r_base →
    ∀ q : ℝ → ℝ, Continuous q → Function.Periodic q (2 * Real.pi) →
      (∀ θ : ℝ, 0 ≤ q θ ∧
        ENNReal.ofReal (q θ) < h_X (t₀ + (ρ : ℂ) * Complex.exp ((θ : ℂ) * Complex.I))) →
      ENNReal.ofReal ((2 * Real.pi)⁻¹ * ∫ θ in (0 : ℝ)..(2 * Real.pi), q θ) ≤ h_X t₀
  L_mero : Fin 2 → MeroOn2D (meroTubeENNR r_base h_L)
  X_mero : Fin 2 → MeroOn2D (meroTubeENNR r_base h_X)
  L_agrees_two : ∀ i : Fin 2,
    MeroAgreesHolo (L_mero i) (fun p => glancingDualLine C p.1 p.2 i)
      { p : ℂ × ℂ | |p.1.im| < 2 * s_base ∧ ‖p.2‖ < r_base }
  X_agrees_two : ∀ i : Fin 2,
    MeroAgreesHolo (X_mero i) (fun p => glancingImpact C p.1 p.2 i)
      { p : ℂ × ℂ | |p.1.im| < 2 * s_base ∧ ‖p.2‖ < r_base }
  h_L_maximal : ∀ (t : ℂ) (b δ : ℝ),
    t ∈ Metric.ball (0 : ℂ) r_base → s_base < b → 0 < δ →
    Metric.ball t δ ⊆ Metric.ball (0 : ℂ) r_base →
    ∀ G : Fin 2 → MeroOn2D ({ y : ℂ | -s_base < y.im ∧ y.im < b } ×ˢ Metric.ball t δ),
      (∀ i : Fin 2, MeroAgreesHolo (G i) (fun p => glancingDualLine C p.1 p.2 i)
        ({ y : ℂ | |y.im| < s_base } ×ˢ Metric.ball t δ)) →
      ENNReal.ofReal b ≤ h_L t
  real_interval_countable_transfer : ∀ (t₀ δ_star M : ℝ) (E_cnt : Set ℝ),
    0 < δ_star → |t₀| + δ_star < r_base → E_cnt.Countable →
    (∀ t ∈ Set.Ioo (t₀ - δ_star) (t₀ + δ_star) \ E_cnt,
      ENNReal.ofReal M ≤ h_L (t : ℂ)) →
    ENNReal.ofReal M ≤ h_L (t₀ : ℂ)

def NoPatchAtRealProp {Ω : Set Plane} {C : AnalyticGlancingCollar Ω}
    {hDet : EndpointDeterminationData C} (W : CollarWidthTubeData C hDet) : Prop :=
  (∀ t₀ x₀ H₁ ε : ℝ,
    |t₀| < W.r_base → W.h_X (t₀ : ℂ) = ENNReal.ofReal H₁ → 0 < ε → ε < W.s_base →
    ¬ ∃ g : Fin 2 → MeroOn2D
        { p : ℂ × ℂ |
          ‖p.1 - ((x₀ : ℂ) + (H₁ : ℂ) * Complex.I)‖ < ε ∧
          ‖p.2 - (t₀ : ℂ)‖ < ε },
      ∃ δ : ℝ, 0 < δ ∧ δ ≤ ε ∧
        ∀ i : Fin 2, MeroEqOn (g i) (W.X_mero i)
          { p : ℂ × ℂ |
            |p.1.re - x₀| < ε / 4 ∧
            |p.1.im - (H₁ - ε / 2)| < ε / 4 ∧
            ‖p.2 - (t₀ : ℂ)‖ < δ }) ∧
  (∀ t₀ x₀ H₁ ε : ℝ,
    |t₀| < W.r_base → W.h_L (t₀ : ℂ) = ENNReal.ofReal H₁ → 0 < ε → ε < W.s_base →
    ¬ ∃ g : Fin 2 → MeroOn2D
        { p : ℂ × ℂ |
          ‖p.1 - ((x₀ : ℂ) + (H₁ : ℂ) * Complex.I)‖ < ε ∧
          ‖p.2 - (t₀ : ℂ)‖ < ε },
      ∃ δ : ℝ, 0 < δ ∧ δ ≤ ε ∧
        ∀ i : Fin 2, MeroEqOn (g i) (W.L_mero i)
          { p : ℂ × ℂ |
            |p.1.re - x₀| < ε / 4 ∧
            |p.1.im - (H₁ - ε / 2)| < ε / 4 ∧
            ‖p.2 - (t₀ : ℂ)‖ < δ })

structure ZeroSliceCollarData {Ω : Set Plane} {C : AnalyticGlancingCollar Ω}
    {hDet : EndpointDeterminationData C} (W : CollarWidthTubeData C hDet) where
  Γ_slice : ℂ → (Fin 2 → ℂ)
  a_mero : ℂ → ℂ
  f_mero : ℂ → ℂ
  E_disc : Set ℂ
  E_disc_sub : E_disc ⊆ horizStripENNR (W.h_X 0)
  E_disc_base_disjoint : ∀ s ∈ horizStrip W.s_base, s ∉ E_disc
  E_disc_isolated : ∀ s ∈ horizStripENNR (W.h_X 0),
    ∃ r : ℝ, 0 < r ∧ Metric.ball s r ⊆ horizStripENNR (W.h_X 0) ∧
      ∀ z ∈ Metric.ball s r, z ≠ s → z ∉ E_disc
  Γ_mero : MeromorphicOn (fun s => Γ_slice s 0) (horizStripENNR (W.h_X 0)) ∧
    MeromorphicOn (fun s => Γ_slice s 1) (horizStripENNR (W.h_X 0))
  a_mero_mero : MeromorphicOn a_mero (horizStripENNR (W.h_X 0))
  f_mero_mero : MeromorphicOn f_mero (horizStripENNR (W.h_X 0))
  slice_base_eq : ∀ s ∈ horizStrip W.s_base,
    Γ_slice s = glancingBoundaryCurve C s ∧
    a_mero s = Complex.exp (Complex.I * C.ϕ_ℂ s) ∧
    f_mero s = deriv C.ϕ_ℂ s
  slice_reg : ∀ s ∈ horizStripENNR (W.h_X 0), s ∉ E_disc →
    AnalyticAt ℂ (fun z => Γ_slice z 0) s ∧
    AnalyticAt ℂ (fun z => Γ_slice z 1) s ∧
    AnalyticAt ℂ a_mero s ∧
    AnalyticAt ℂ f_mero s ∧
    a_mero s ≠ 0 ∧
    f_mero s ≠ 0 ∧
    deriv (fun z => Γ_slice z 0) s + Complex.I * deriv (fun z => Γ_slice z 1) s =
      Complex.I * C.c * a_mero s / (f_mero s) ^ 2 ∧
    deriv (fun z => Γ_slice z 0) s - Complex.I * deriv (fun z => Γ_slice z 1) s =
      -Complex.I * C.c / (a_mero s * (f_mero s) ^ 2) ∧
    deriv a_mero s = Complex.I * f_mero s * a_mero s ∧
    ∃ (r_s : ℝ) (X_loc : Fin 2 → ℂ × ℂ → ℂ),
      0 < r_s ∧
      Metric.ball (s, (0 : ℂ)) r_s ⊆ meroTubeENNR W.r_base W.h_X ∧
      (∀ z ∈ Metric.ball s r_s, z ∈ horizStripENNR (W.h_X 0) ∧ z ∉ E_disc) ∧
      (∀ i : Fin 2, DifferentiableOn ℂ (X_loc i) (Metric.ball (s, (0 : ℂ)) r_s)) ∧
      (∀ i : Fin 2, MeroAgreesHolo (W.X_mero i) (X_loc i) (Metric.ball (s, (0 : ℂ)) r_s)) ∧
      (∀ i : Fin 2, ∀ z ∈ Metric.ball s r_s, X_loc i (z, 0) = Γ_slice z i)
  no_1d_patch_Γ : ∀ (H₀ x_star sgn ε : ℝ),
    W.h_X 0 = ENNReal.ofReal H₀ → (sgn = 1 ∨ sgn = -1) → 0 < ε →
    ¬ ∃ g : Fin 2 → ℂ → ℂ,
      MeromorphicOn (g 0)
        (Metric.ball ((x_star : ℂ) + ((sgn * H₀ : ℝ) : ℂ) * Complex.I) ε) ∧
      MeromorphicOn (g 1)
        (Metric.ball ((x_star : ℂ) + ((sgn * H₀ : ℝ) : ℂ) * Complex.I) ε) ∧
      ∃ V_overlap : Set ℂ,
        IsOpen V_overlap ∧ V_overlap.Nonempty ∧
        V_overlap ⊆
          Metric.ball ((x_star : ℂ) + ((sgn * H₀ : ℝ) : ℂ) * Complex.I) ε ∩
            horizStrip H₀ ∧
        ∀ i : Fin 2, ∀ z ∈ V_overlap, g i z = Γ_slice z i
noncomputable def primPhi_ℝ (w : ℝ → ℝ) (z : ℝ) : ℝ :=
  ∫ ζ in (0 : ℝ)..z, Real.exp (w ζ)

noncomputable def midpoint_ℝ (w : ℝ → ℝ) (X Y : ℝ) : ℝ :=
  Function.invFun (primPhi_ℝ w) ((primPhi_ℝ w X + primPhi_ℝ w Y) / 2)

noncomputable def normAction_ℝ (w : ℝ → ℝ) (X Y : ℝ) : ℝ :=
  -(∫ z in X..(midpoint_ℝ w X Y),
      (1 - Real.cos (primPhi_ℝ w z - primPhi_ℝ w X)) * Real.exp (-2 * w z)) -
    (∫ z in (midpoint_ℝ w X Y)..Y,
      (1 - Real.cos (primPhi_ℝ w Y - primPhi_ℝ w z)) * Real.exp (-2 * w z))

noncomputable def normAction1_ℝ (w : ℝ → ℝ) (X Y : ℝ) : ℝ :=
  Real.exp (w X) * ∫ z in X..(midpoint_ℝ w X Y),
    Real.sin (primPhi_ℝ w z - primPhi_ℝ w X) * Real.exp (-2 * w z)

def IsCandidateRealMesh (q : ℕ) (x : ℝ) (X : ℕ → ℝ) : Prop :=
  X 0 = x ∧
  X q = x + 2 * Real.pi ∧
  (∀ j : ℕ, j ≤ q →
    |X j - (x + 2 * Real.pi * (j : ℝ) / (q : ℝ))| ≤ (q : ℝ)⁻¹) ∧
  (∀ j : ℕ, j < q →
    |(X (j + 1) - X j) - 2 * Real.pi / (q : ℝ)| ≤ (q : ℝ)⁻¹) ∧
  (∀ j : ℕ, q < j → X j = 0)

def IsStationaryRealMesh (q : ℕ) (w : ℝ → ℝ) (x : ℝ) (X : ℕ → ℝ) : Prop :=
  IsCandidateRealMesh q x X ∧
  ∀ j : ℕ, j + 1 < q →
    normAction1_ℝ w (X (j + 1)) (X (j + 2)) - normAction1_ℝ w (X (j + 1)) (X j) = 0

def HasUniqueGlobalMesh (q : ℕ) (w : ℝ → ℝ) : Prop :=
  4 ≤ q ∧
  Function.Periodic w (2 * Real.pi) ∧
  ContDiff ℝ (4 : WithTop ℕ∞) w ∧
  ∀ x : ℝ, ∃! X : ℕ → ℝ, IsStationaryRealMesh q w x X

open Classical in
noncomputable def realMesh (q : ℕ) (w : ℝ → ℝ) (x : ℝ) : ℕ → ℝ :=
  if h : HasUniqueGlobalMesh q w then Classical.choose (h.2.2.2 x).exists else fun _ => 0

noncomputable def critAction_ℝ (q : ℕ) (w : ℝ → ℝ) (x : ℝ) : ℝ :=
  ∑ j ∈ Finset.range q, normAction_ℝ w (realMesh q w x j) (realMesh q w x (j + 1))

open Classical in
noncomputable def globalC_coeff (n : ℤ) (w : ℝ → ℝ) : ℂ :=
  if n = 0 then 0
  else if HasUniqueGlobalMesh n.natAbs w then
    -(((n.natAbs : ℝ) ^ 2 / (6 * Real.pi) : ℝ) : ℂ) *
      (((2 * Real.pi : ℝ) : ℂ)⁻¹ *
        ∫ x in (0 : ℝ)..(2 * Real.pi),
          Complex.exp (-Complex.I * (n : ℂ) * (x : ℂ)) * (critAction_ℝ n.natAbs w x : ℂ))
  else 0

noncomputable def cellKernelMinus_ℝ (w : ℝ → ℝ) (X Y z : ℝ) : ℝ :=
  2 * (1 - Real.cos (primPhi_ℝ w z - primPhi_ℝ w X)) * Real.exp (-2 * w z) -
    Real.exp (w z) * ∫ ζ in z..(midpoint_ℝ w X Y),
      Real.sin (primPhi_ℝ w ζ - primPhi_ℝ w X) * Real.exp (-2 * w ζ)

noncomputable def cellKernelPlus_ℝ (w : ℝ → ℝ) (X Y z : ℝ) : ℝ :=
  2 * (1 - Real.cos (primPhi_ℝ w Y - primPhi_ℝ w z)) * Real.exp (-2 * w z) -
    Real.exp (w z) * ∫ ζ in (midpoint_ℝ w X Y)..z,
      Real.sin (primPhi_ℝ w Y - primPhi_ℝ w ζ) * Real.exp (-2 * w ζ)

noncomputable def halfCellMinus_ℝ (q : ℕ) (w : ℝ → ℝ) (j : ℕ) (α x : ℝ) : ℝ :=
  realMesh q w x j +
    α * (midpoint_ℝ w (realMesh q w x j) (realMesh q w x (j + 1)) - realMesh q w x j)

noncomputable def halfCellPlus_ℝ (q : ℕ) (w : ℝ → ℝ) (j : ℕ) (α x : ℝ) : ℝ :=
  midpoint_ℝ w (realMesh q w x j) (realMesh q w x (j + 1)) +
    α * (realMesh q w x (j + 1) - midpoint_ℝ w (realMesh q w x j) (realMesh q w x (j + 1)))

noncomputable def halfCellInvMinus_ℝ (q : ℕ) (w : ℝ → ℝ) (j : ℕ) (α z : ℝ) : ℝ :=
  Function.invFun (halfCellMinus_ℝ q w j α) z

noncomputable def halfCellInvPlus_ℝ (q : ℕ) (w : ℝ → ℝ) (j : ℕ) (α z : ℝ) : ℝ :=
  Function.invFun (halfCellPlus_ℝ q w j α) z

open Classical in
noncomputable def globalB_mult (n : ℤ) (w : ℝ → ℝ) (z : ℝ) : ℂ :=
  if n = 0 then 1
  else if HasUniqueGlobalMesh n.natAbs w then
    -(((n.natAbs : ℝ) ^ 2 / (6 * Real.pi) : ℝ) : ℂ) *
      ∑ j ∈ Finset.range n.natAbs,
        ∫ α in (0 : ℝ)..1,
          (let x_m := halfCellInvMinus_ℝ n.natAbs w j α z
           let X_m := realMesh n.natAbs w x_m j
           let Y_m := realMesh n.natAbs w x_m (j + 1)
           let μ_m := midpoint_ℝ w X_m Y_m
           let term_m : ℂ :=
             ((cellKernelMinus_ℝ w X_m Y_m z * (μ_m - X_m) *
               deriv (halfCellInvMinus_ℝ n.natAbs w j α) z : ℝ) : ℂ) *
               Complex.exp (-Complex.I * (n : ℂ) * ((x_m - z : ℝ) : ℂ))
           let x_p := halfCellInvPlus_ℝ n.natAbs w j α z
           let X_p := realMesh n.natAbs w x_p j
           let Y_p := realMesh n.natAbs w x_p (j + 1)
           let μ_p := midpoint_ℝ w X_p Y_p
           let term_p : ℂ :=
             ((cellKernelPlus_ℝ w X_p Y_p z * (Y_p - μ_p) *
               deriv (halfCellInvPlus_ℝ n.natAbs w j α) z : ℝ) : ℂ) *
               Complex.exp (-Complex.I * (n : ℂ) * ((x_p - z : ℝ) : ℂ))
           term_m + term_p)
  else 1

noncomputable def realDiffSup (r₀ : ℕ) (w₁ w₂ : ℝ → ℝ) : ℝ :=
  sSup { r : ℝ | ∃ j ≤ r₀, ∃ y ∈ Set.Icc (0 : ℝ) (2 * Real.pi),
    r = |iteratedDeriv j (w₁ - w₂) y| }

noncomputable def stripDiffSup (r₀ : ℕ) (σ : ℝ) (W₁ W₂ : ℂ → ℂ) : ℝ :=
  sSup { r : ℝ | ∃ j ≤ r₀, ∃ ζ ∈ horizStrip σ,
    r = ‖iteratedDeriv j (W₁ - W₂) ζ‖ }

noncomputable def realMeshDisp (q : ℕ) (w : ℝ → ℝ) (j : ℕ) (x : ℝ) : ℝ :=
  realMesh q w x j - (x + 2 * Real.pi * (j : ℝ) / (q : ℝ))

noncomputable def realMidpointDisp (q : ℕ) (w : ℝ → ℝ) (j : ℕ) (x : ℝ) : ℝ :=
  midpoint_ℝ w (realMesh q w x j) (realMesh q w x (j + 1)) -
    (realMesh q w x j + (realMesh q w x (j + 1) - realMesh q w x j) / 2)

structure StationaryMeshSystem (m : ℕ) (M₁ : ℝ) where
  R_mesh : ℝ
  K_mesh : ℝ
  N_mesh : ℕ
  R_mesh_pos : 0 < R_mesh
  K_mesh_pos : 0 < K_mesh
  N_mesh_ge_four : 4 ≤ N_mesh
  real_mesh_props : ∀ (q : ℕ) (w : ℝ → ℝ),
    N_mesh ≤ q →
    IsPeriodicSmoothBounded (m + 15) M₁ w →
    HasUniqueGlobalMesh q w ∧
    realMeshDisp q w 0 = 0 ∧
    realMeshDisp q w q = 0 ∧
    (∀ j : ℕ, j ≤ q →
      Function.Periodic (realMeshDisp q w j) (2 * Real.pi) ∧
      ContDiff ℝ ((m + 2 : ℕ) : WithTop ℕ∞) (realMeshDisp q w j) ∧
      ∀ k : ℕ, k ≤ m + 2 → ∀ x : ℝ,
        (q : ℝ) ^ 2 * |iteratedDeriv k (realMeshDisp q w j) x| ≤ R_mesh) ∧
    (∀ j : ℕ, j < q →
      Function.Periodic (realMidpointDisp q w j) (2 * Real.pi) ∧
      ContDiff ℝ ((m + 2 : ℕ) : WithTop ℕ∞) (realMidpointDisp q w j) ∧
      (∀ k : ℕ, k ≤ m + 2 → ∀ x : ℝ,
        (q : ℝ) ^ 3 *
          |iteratedDeriv k (fun y : ℝ => realMeshDisp q w (j + 1) y - realMeshDisp q w j y) x| ≤
          R_mesh) ∧
      (∀ k : ℕ, k ≤ m + 2 → ∀ x : ℝ,
        (q : ℝ) ^ 2 * |iteratedDeriv k (realMidpointDisp q w j) x| ≤ R_mesh))
  real_mesh_lip : ∀ (q : ℕ) (w₁ w₂ : ℝ → ℝ),
    N_mesh ≤ q →
    IsPeriodicSmoothBounded (m + 15) M₁ w₁ →
    IsPeriodicSmoothBounded (m + 15) M₁ w₂ →
    (∀ j : ℕ, j ≤ q → ∀ k : ℕ, k ≤ m + 2 → ∀ x : ℝ,
      (q : ℝ) ^ 2 *
        |iteratedDeriv k (fun y : ℝ => realMeshDisp q w₁ j y - realMeshDisp q w₂ j y) x| ≤
        R_mesh * realDiffSup (m + 15) w₁ w₂) ∧
    (∀ j : ℕ, j < q → ∀ k : ℕ, k ≤ m + 2 → ∀ x : ℝ,
      (q : ℝ) ^ 3 *
        |iteratedDeriv k (fun y : ℝ =>
          (realMeshDisp q w₁ (j + 1) y - realMeshDisp q w₁ j y) -
            (realMeshDisp q w₂ (j + 1) y - realMeshDisp q w₂ j y)) x| ≤
        R_mesh * realDiffSup (m + 15) w₁ w₂) ∧
    (∀ j : ℕ, j < q → ∀ k : ℕ, k ≤ m + 2 → ∀ x : ℝ,
      (q : ℝ) ^ 2 *
        |iteratedDeriv k (fun y : ℝ => realMidpointDisp q w₁ j y - realMidpointDisp q w₂ j y) x| ≤
        R_mesh * realDiffSup (m + 15) w₁ w₂)
  strip_mesh_ext : ∀ (σ : ℝ) (q : ℕ) (w : ℝ → ℝ) (W : ℂ → ℂ),
    σ ∈ Set.Ioc (0 : ℝ) 1 →
    N_mesh ≤ q →
    K_mesh / (q : ℝ) ^ 2 < 1 →
    IsPeriodicSmoothBounded (m + 15) M₁ w →
    IsBoundedStripExt (m + 15) σ M₁ w W →
    ∃ (X_ℂ μ_ℂ : ℕ → ℂ → ℂ),
      (∀ z ∈ horizStrip ((1 - K_mesh / (q : ℝ) ^ 2) * σ),
        X_ℂ 0 z = z ∧ X_ℂ q z = z + ((2 * Real.pi : ℝ) : ℂ)) ∧
      (∀ j : ℕ, j ≤ q →
        DifferentiableOn ℂ (X_ℂ j) (horizStrip ((1 - K_mesh / (q : ℝ) ^ 2) * σ)) ∧
        (∀ x : ℝ, X_ℂ j x = realMesh q w x j) ∧
        (∀ z ∈ horizStrip ((1 - K_mesh / (q : ℝ) ^ 2) * σ),
          X_ℂ j (z + 2 * Real.pi) = X_ℂ j z + 2 * Real.pi) ∧
        (∀ z ∈ horizStrip ((1 - K_mesh / (q : ℝ) ^ 2) * σ),
          X_ℂ j (starRingEnd ℂ z) = starRingEnd ℂ (X_ℂ j z)) ∧
        (∀ z ∈ horizStrip ((1 - K_mesh / (q : ℝ) ^ 2) * σ),
          X_ℂ j z ∈ horizStrip σ) ∧
        (∀ k : ℕ, k ≤ m + 2 → ∀ z ∈ horizStrip ((1 - K_mesh / (q : ℝ) ^ 2) * σ),
          (q : ℝ) ^ 2 *
            ‖iteratedDeriv k
              (fun ζ : ℂ => X_ℂ j ζ - (ζ + ((2 * Real.pi * (j : ℝ) / (q : ℝ) : ℝ) : ℂ))) z‖ ≤
            R_mesh)) ∧
      (∀ j : ℕ, j < q →
        DifferentiableOn ℂ (μ_ℂ j) (horizStrip ((1 - K_mesh / (q : ℝ) ^ 2) * σ)) ∧
        (∀ x : ℝ, μ_ℂ j x = midpoint_ℝ w (realMesh q w x j) (realMesh q w x (j + 1))) ∧
        (∀ z ∈ horizStrip ((1 - K_mesh / (q : ℝ) ^ 2) * σ),
          μ_ℂ j (z + 2 * Real.pi) = μ_ℂ j z + 2 * Real.pi) ∧
        (∀ z ∈ horizStrip ((1 - K_mesh / (q : ℝ) ^ 2) * σ),
          μ_ℂ j (starRingEnd ℂ z) = starRingEnd ℂ (μ_ℂ j z)) ∧
        (∀ z ∈ horizStrip ((1 - K_mesh / (q : ℝ) ^ 2) * σ),
          μ_ℂ j z ∈ horizStrip σ) ∧
        (∀ k : ℕ, k ≤ m + 2 → ∀ z ∈ horizStrip ((1 - K_mesh / (q : ℝ) ^ 2) * σ),
          (q : ℝ) ^ 3 *
            ‖iteratedDeriv k
              (fun ζ : ℂ =>
                (X_ℂ (j + 1) ζ - X_ℂ j ζ) - ((2 * Real.pi / (q : ℝ) : ℝ) : ℂ)) z‖ ≤
            R_mesh) ∧
        (∀ k : ℕ, k ≤ m + 2 → ∀ z ∈ horizStrip ((1 - K_mesh / (q : ℝ) ^ 2) * σ),
          (q : ℝ) ^ 2 *
            ‖iteratedDeriv k
              (fun ζ : ℂ => μ_ℂ j ζ - (X_ℂ j ζ + (X_ℂ (j + 1) ζ - X_ℂ j ζ) / 2)) z‖ ≤
            R_mesh))
  strip_mesh_lip : ∀ (σ : ℝ) (q : ℕ) (w₁ w₂ : ℝ → ℝ) (W₁ W₂ : ℂ → ℂ)
      (X_ℂ₁ μ_ℂ₁ X_ℂ₂ μ_ℂ₂ : ℕ → ℂ → ℂ),
    σ ∈ Set.Ioc (0 : ℝ) 1 →
    N_mesh ≤ q →
    K_mesh / (q : ℝ) ^ 2 < 1 →
    IsPeriodicSmoothBounded (m + 15) M₁ w₁ →
    IsPeriodicSmoothBounded (m + 15) M₁ w₂ →
    IsBoundedStripExt (m + 15) σ M₁ w₁ W₁ →
    IsBoundedStripExt (m + 15) σ M₁ w₂ W₂ →
    (∀ j : ℕ, j ≤ q →
      DifferentiableOn ℂ (X_ℂ₁ j) (horizStrip ((1 - K_mesh / (q : ℝ) ^ 2) * σ)) ∧
      DifferentiableOn ℂ (X_ℂ₂ j) (horizStrip ((1 - K_mesh / (q : ℝ) ^ 2) * σ)) ∧
      (∀ x : ℝ, X_ℂ₁ j x = realMesh q w₁ x j) ∧
      (∀ x : ℝ, X_ℂ₂ j x = realMesh q w₂ x j)) →
    (∀ j : ℕ, j < q →
      DifferentiableOn ℂ (μ_ℂ₁ j) (horizStrip ((1 - K_mesh / (q : ℝ) ^ 2) * σ)) ∧
      DifferentiableOn ℂ (μ_ℂ₂ j) (horizStrip ((1 - K_mesh / (q : ℝ) ^ 2) * σ)) ∧
      (∀ x : ℝ, μ_ℂ₁ j x = midpoint_ℝ w₁ (realMesh q w₁ x j) (realMesh q w₁ x (j + 1))) ∧
      (∀ x : ℝ, μ_ℂ₂ j x = midpoint_ℝ w₂ (realMesh q w₂ x j) (realMesh q w₂ x (j + 1)))) →
    (∀ j : ℕ, j ≤ q → ∀ k : ℕ, k ≤ m + 2 →
      ∀ z ∈ horizStrip ((1 - K_mesh / (q : ℝ) ^ 2) * σ),
        (q : ℝ) ^ 2 * ‖iteratedDeriv k (fun ζ : ℂ => X_ℂ₁ j ζ - X_ℂ₂ j ζ) z‖ ≤
          R_mesh * stripDiffSup (m + 15) σ W₁ W₂) ∧
    (∀ j : ℕ, j < q → ∀ k : ℕ, k ≤ m + 2 →
      ∀ z ∈ horizStrip ((1 - K_mesh / (q : ℝ) ^ 2) * σ),
        (q : ℝ) ^ 3 *
          ‖iteratedDeriv k (fun ζ : ℂ =>
            (X_ℂ₁ (j + 1) ζ - X_ℂ₁ j ζ) - (X_ℂ₂ (j + 1) ζ - X_ℂ₂ j ζ)) z‖ ≤
          R_mesh * stripDiffSup (m + 15) σ W₁ W₂) ∧
    (∀ j : ℕ, j < q → ∀ k : ℕ, k ≤ m + 2 →
      ∀ z ∈ horizStrip ((1 - K_mesh / (q : ℝ) ^ 2) * σ),
        (q : ℝ) ^ 2 *
          ‖iteratedDeriv k (fun ζ : ℂ =>
            (μ_ℂ₁ j ζ - (X_ℂ₁ j ζ + (X_ℂ₁ (j + 1) ζ - X_ℂ₁ j ζ) / 2)) -
              (μ_ℂ₂ j ζ - (X_ℂ₂ j ζ + (X_ℂ₂ (j + 1) ζ - X_ℂ₂ j ζ) / 2))) z‖ ≤
          R_mesh * stripDiffSup (m + 15) σ W₁ W₂)
noncomputable def periodicFourierCoeff (f : ℝ → ℂ) (k : ℤ) : ℂ :=
  ((2 * Real.pi : ℝ) : ℂ)⁻¹ *
    ∫ x in (0 : ℝ)..(2 * Real.pi), Complex.exp (-Complex.I * (k : ℂ) * (x : ℂ)) * f x

noncomputable def fourierSeriesℂ (c : ℤ → ℂ) (z : ℂ) : ℂ :=
  ∑' k : ℤ, c k * Complex.exp (Complex.I * (k : ℂ) * z)

noncomputable def fourierSeriesℝ (c : ℤ → ℂ) (x : ℝ) : ℝ :=
  (fourierSeriesℂ c (x : ℂ)).re

noncomputable def uTable {Ω : Set Plane} (R : RationalCollarData Ω) (x : ℝ) : ℝ :=
  Real.log (deriv R.ϕ x)

noncomputable def uTableCoeff {Ω : Set Plane} (R : RationalCollarData Ω) (k : ℤ) : ℂ :=
  periodicFourierCoeff (fun x => (uTable R x : ℂ)) k

noncomputable def uTableBound {Ω : Set Plane} (R : RationalCollarData Ω) : ℝ :=
  8 * Real.exp 1 * (1 + ∑' k : ℤ, (1 + |(k : ℝ)|) ^ 53 * ‖uTableCoeff R k‖)

noncomputable def uTruncCoeff {Ω : Set Plane} (R : RationalCollarData Ω) (P : ℕ) (k : ℤ) : ℂ :=
  if |k| ≤ (P : ℤ) then uTableCoeff R k else 0

structure WienerHighModeAt {Ω : Set Plane} (R : RationalCollarData Ω)
    (H_sys : HighFreqActionSystem (uTable R)) (N : ℕ) where
  N_pos : 1 ≤ N
  C_quad : ℝ
  C_lip : ℝ
  C_quad_ge_one : 1 ≤ C_quad
  C_lip_pos : 0 < C_lip
  solve_high : ∀ (σ ε : ℝ) (w : ℝ → ℝ) (W : ℂ → ℂ) (y : ℤ → ℂ),
    σ ∈ Set.Ioc (0 : ℝ) 1 →
    0 ≤ ε →
    IsPeriodicSmoothBounded 17 (3 * uTableBound R / 4) w →
    IsBoundedStripExt 17 σ (3 * uTableBound R / 4) w W →
    (∀ n : ℤ, (N : ℤ) ≤ |n| → y (-n) = starRingEnd ℂ (y n)) →
    Summable (fun n : ℤ => if (N : ℤ) ≤ |n| then ‖y n‖ * Real.exp (σ * |(n : ℝ)|) else 0) →
    (∑' n : ℤ, if (N : ℤ) ≤ |n| then ‖y n‖ * Real.exp (σ * |(n : ℝ)|) else 0) ≤ ε →
    ∃ c : ℤ → ℂ,
      (∀ k : ℤ, c (-k) = starRingEnd ℂ (c k)) ∧
      (∀ k : ℤ, |k| < (N : ℤ) → c k = 0) ∧
      Summable (fun k : ℤ => ‖c k‖ * Real.exp (σ * |(k : ℝ)|)) ∧
      (∑' k : ℤ, ‖c k‖ * Real.exp (σ * |(k : ℝ)|)) ≤ 2 * ε ∧
      (∀ n : ℤ, (N : ℤ) ≤ |n| →
        ((2 * Real.pi : ℝ) : ℂ)⁻¹ *
          (∫ x in (0 : ℝ)..(2 * Real.pi),
            Complex.exp (-Complex.I * (n : ℂ) * (x : ℂ)) * H_sys.b_mult n w x *
              (fourierSeriesℝ c x : ℂ)) = -y n)
  taylor_rem_wiener : ∀ (σ' D_η B_c : ℝ) (w : ℝ → ℝ) (W H : ℂ → ℂ) (c : ℤ → ℂ),
    σ' ∈ Set.Ioc (0 : ℝ) 1 →
    0 ≤ D_η →
    D_η ≤ uTableBound R / 4 →
    0 ≤ B_c →
    IsPeriodicSmoothBounded 17 (uTableBound R / 2) w →
    IsBoundedStripExt 17 σ' (uTableBound R / 2) w W →
    (∀ k : ℤ, c (-k) = starRingEnd ℂ (c k)) →
    Summable (fun k : ℤ => ‖c k‖ * Real.exp (σ' * |(k : ℝ)|)) →
    (∑' k : ℤ, ‖c k‖ * Real.exp (σ' * |(k : ℝ)|)) ≤ B_c →
    IsPeriodicSmoothBounded 17 D_η (fourierSeriesℝ c) →
    IsBoundedStripExt 17 σ' D_η (fourierSeriesℝ c) H →
    let rem : ℤ → ℂ := fun n : ℤ =>
      H_sys.C_coeff n (fun x => w x + fourierSeriesℝ c x) - H_sys.C_coeff n w -
        ((2 * Real.pi : ℝ) : ℂ)⁻¹ *
          ∫ x in (0 : ℝ)..(2 * Real.pi),
            Complex.exp (-Complex.I * (n : ℂ) * (x : ℂ)) * H_sys.b_mult n w x *
              (fourierSeriesℝ c x : ℂ)
    Summable (fun n : ℤ => if (N : ℤ) ≤ |n| then ‖rem n‖ * Real.exp (σ' * |(n : ℝ)|) else 0) ∧
    (∑' n : ℤ, if (N : ℤ) ≤ |n| then ‖rem n‖ * Real.exp (σ' * |(n : ℝ)|) else 0) ≤
      C_quad * D_η * B_c
  C_coeff_lip : ∀ (n : ℤ), (N : ℤ) ≤ |n| →
    ∀ (w₁ w₂ : ℝ → ℝ) (D : ℝ),
      0 ≤ D →
      IsPeriodicSmoothBounded 17 (3 * uTableBound R / 4) w₁ →
      IsPeriodicSmoothBounded 17 (3 * uTableBound R / 4) w₂ →
      (∀ x : ℝ, |w₁ x - w₂ x| ≤ D) →
      ‖H_sys.C_coeff n w₁ - H_sys.C_coeff n w₂‖ ≤ C_lip * D
  real_uniqueness : ∀ (c_star : ℤ → ℂ),
    IsPeriodicSmoothBounded 17 (uTableBound R / 4) (uTable R) →
    Summable (fun k : ℤ => ‖uTableCoeff R k‖) →
    (∀ x : ℝ, fourierSeriesℝ (uTableCoeff R) x = uTable R x) →
    (∀ k : ℤ, c_star (-k) = starRingEnd ℂ (c_star k)) →
    Summable (fun k : ℤ => ‖c_star k‖) →
    (∀ k : ℤ, |k| < (N : ℤ) → c_star k = uTableCoeff R k) →
    IsPeriodicSmoothBounded 17 (3 * uTableBound R / 4) (fourierSeriesℝ c_star) →
    (∀ n : ℤ, (N : ℤ) ≤ |n| → H_sys.C_coeff n (fourierSeriesℝ c_star) = 0) →
    ∀ x : ℝ, fourierSeriesℝ c_star x = uTable R x

def InitialTruncationAt {Ω : Set Plane} (R : RationalCollarData Ω)
    (H_sys : HighFreqActionSystem (uTable R)) (N : ℕ) : Prop :=
  IsPeriodicSmoothBounded 17 (uTableBound R / 4) (uTable R) ∧
  (∀ k : ℤ, uTableCoeff R (-k) = starRingEnd ℂ (uTableCoeff R k)) ∧
  Summable (fun k : ℤ => ‖uTableCoeff R k‖) ∧
  (∀ x : ℝ, fourierSeriesℝ (uTableCoeff R) x = uTable R x) ∧
  ∃ P₀ : ℕ, N < P₀ ∧ ∀ P : ℕ, P₀ ≤ P →
    IsPeriodicSmoothBounded 17 (uTableBound R / 4) (fourierSeriesℝ (uTruncCoeff R P)) ∧
    IsBoundedStripExt 17 (1 / (P : ℝ)) (uTableBound R / 4)
      (fourierSeriesℝ (uTruncCoeff R P)) (fourierSeriesℂ (uTruncCoeff R P)) ∧
    Summable (fun n : ℤ =>
      if (N : ℤ) ≤ |n| then
        ‖H_sys.C_coeff n (fourierSeriesℝ (uTruncCoeff R P))‖ *
          Real.exp ((1 / (P : ℝ)) * |(n : ℝ)|)
      else 0) ∧
    (∑' n : ℤ,
      if (N : ℤ) ≤ |n| then
        ‖H_sys.C_coeff n (fourierSeriesℝ (uTruncCoeff R P))‖ *
          Real.exp ((1 / (P : ℝ)) * |(n : ℝ)|)
      else 0) ≤ 1 / (P : ℝ) ^ 34

structure AnalyticLogSpeedData {Ω : Set Plane} (R : RationalCollarData Ω) where
  σ_raw : ℝ
  M_raw : ℝ
  σ_raw_pos : 0 < σ_raw
  M_raw_pos : 0 < M_raw
  u_raw : ℂ → ℂ
  u_raw_holo : DifferentiableOn ℂ u_raw (horizStrip σ_raw)
  u_raw_real : ∀ x : ℝ, u_raw x = Real.log (deriv R.ϕ x)
  u_raw_periodic : ∀ z ∈ horizStrip σ_raw, u_raw (z + 2 * Real.pi) = u_raw z
  u_raw_conj : ∀ z ∈ horizStrip σ_raw, u_raw (starRingEnd ℂ z) = starRingEnd ℂ (u_raw z)
  u_raw_bound : ∀ z ∈ horizStrip σ_raw, ‖u_raw z‖ ≤ M_raw ∧ ‖deriv u_raw z‖ ≤ M_raw
def meshClosedSquare (c : ℂ) (ρ : ℝ) : Set ℂ :=
  { z : ℂ | |(z - c).re| ≤ ρ / 2 ∧ |(z - c).im| ≤ ρ / 2 }

def meshPolyTrace : List ℂ → Set ℂ
  | [] => ∅
  | [a] => {a}
  | a :: b :: rest => segment ℝ a b ∪ meshPolyTrace (b :: rest)

noncomputable def meshPolyLength : List ℂ → ℝ
  | [] => 0
  | [_] => 0
  | a :: b :: rest => ‖b - a‖ + meshPolyLength (b :: rest)

def meshGridAdj4 {W H : ℕ} (p q : Fin W × Fin H) : Prop :=
  |(p.1.val : ℤ) - (q.1.val : ℤ)| + |(p.2.val : ℤ) - (q.2.val : ℤ)| = 1

def meshGridAdj8 {W H : ℕ} (p q : Fin W × Fin H) : Prop :=
  max |(p.1.val : ℤ) - (q.1.val : ℤ)| |(p.2.val : ℤ) - (q.2.val : ℤ)| ≤ 1

def BadTileShadowBoundProp : Prop :=
  ∀ a b K : ℝ, 1 ≤ a → a ≤ b → 0 < K →
    ∃ M_lat C_shad : ℝ, K + 1 < M_lat ∧ 0 < C_shad ∧
      ∀ (p d τ M_top U₀ H_def : ℝ) (F : ℂ → ℂ) (U_open : Set ℂ)
        (N : ℕ) (x_T d_T ρ_T : Fin N → ℝ),
        0 < d → 0 < τ → τ < d / 4 → 0 ≤ U₀ → 0 < H_def →
        (∀ i : Fin N, 0 < ρ_T i ∧ a * ρ_T i ≤ d_T i ∧ d_T i ≤ b * ρ_T i ∧
          d_T i ≤ d / 2 ∧ |x_T i - p| ≤ K * d ∧ τ < d_T i / 4) →
        IsOpen U_open →
        { z : ℂ | |z.re - p| ≤ M_lat * d ∧ τ ≤ -z.im ∧ -z.im ≤ 2 * d } ⊆ U_open →
        DifferentiableOn ℂ F U_open →
        (∀ z : ℂ, |z.re - p| ≤ M_lat * d → τ ≤ -z.im → -z.im ≤ 2 * d →
          ‖F z‖ ≤ Real.exp M_top) →
        Real.exp (M_top - U₀) ≤ ‖F ((p : ℂ) - (d : ℂ) * Complex.I)‖ →
        (∀ i : Fin N, ∀ z ∈ Metric.closedBall ((x_T i : ℂ) - (d_T i : ℂ) * Complex.I) (ρ_T i / 8),
          ‖F z‖ ≤ Real.exp (M_top - H_def)) →
        MeasureTheory.volume.real
          (⋃ i : Fin N, Set.Icc (x_T i - ρ_T i / 2) (x_T i + ρ_T i / 2)) ≤
          C_shad * d * (U₀ / H_def)

def GoodChainRoutingProp : Prop :=
  ∃ C_route C_len : ℝ, 0 < C_route ∧ 0 < C_len ∧
    ∀ (m : ℕ) (c : Fin (m + 1) → ℂ) (ρ : Fin (m + 1) → ℝ)
      (F : ℂ → ℂ) (M T : ℝ),
      0 < T →
      (∀ k : Fin (m + 1), 0 < ρ k) →
      (∀ k : Fin m,
        (meshClosedSquare (c k.castSucc) (ρ k.castSucc) ∩
          meshClosedSquare (c k.succ) (ρ k.succ)).Nonempty ∧
        ρ k.castSucc / 2 ≤ ρ k.succ ∧ ρ k.succ ≤ 2 * ρ k.castSucc) →
      (∀ k : Fin (m + 1),
        DifferentiableOn ℂ F (Metric.ball (c k) (100 * ρ k)) ∧
        (∀ z ∈ Metric.ball (c k) (100 * ρ k), ‖F z‖ ≤ Real.exp M) ∧
        (∃ q ∈ meshClosedSquare (c k) (ρ k), Real.exp (M - 2 * T) ≤ ‖F q‖)) →
      ∃ (γ : List ℂ) (hγ : γ ≠ []),
        γ.head hγ ∈ meshClosedSquare (c 0) (ρ 0) ∧
        γ.getLast hγ ∈ meshClosedSquare (c (Fin.last m)) (ρ (Fin.last m)) ∧
        meshPolyTrace γ ⊆ (⋃ k : Fin (m + 1), meshClosedSquare (c k) (9 * ρ k)) ∧
        meshPolyLength γ ≤ C_len * (∑ k : Fin (m + 1), ρ k) ∧
        ∀ z ∈ meshPolyTrace γ, Real.exp (M - C_route * T) ≤ ‖F z‖

def GridFourEightDualityProp : Prop :=
  ∀ (W H : ℕ), 1 ≤ W → 1 ≤ H → ∀ (good : Fin W × Fin H → Bool),
    (∃ (L : List (Fin W × Fin H)) (hL : L ≠ []),
      (∀ p ∈ L, good p = true) ∧
      List.IsChain meshGridAdj4 L ∧
      (L.head hL).1.val = 0 ∧
      (L.getLast hL).1.val = W - 1) ∨
    (∃ (B : List (Fin W × Fin H)) (hB : B ≠ []),
      (∀ p ∈ B, good p = false) ∧
      List.IsChain meshGridAdj8 B ∧
      (B.head hB).2.val = 0 ∧
      (B.getLast hB).2.val = H - 1)

structure HighModulusPolygonalMesh (F : ℂ → ℂ) (lam : ℝ) : Prop where
  exists_mesh :
    ∃ (u A B η : ℕ → ℝ) (γ σ_left σ_right : ℕ → List ℂ)
      (hγ : ∀ j : ℕ, γ j ≠ [])
      (hσL : ∀ j : ℕ, σ_left j ≠ [])
      (hσR : ∀ j : ℕ, σ_right j ≠ []),
      (∀ j : ℕ, 1 ≤ u j ∧ u j + 1 ≤ u (j + 1)) ∧
      Filter.Tendsto u Filter.atTop Filter.atTop ∧
      (∀ j : ℕ, 0 < A j ∧ A j < B j ∧ B (j + 1) < A j) ∧
      Filter.Tendsto B Filter.atTop (nhds 0) ∧
      (∀ j : ℕ, 0 < η j) ∧
      Antitone η ∧
      Filter.Tendsto η Filter.atTop (nhds 0) ∧
      (∀ j : ℕ,
        (∀ w ∈ meshPolyTrace (γ j),
          -4 ≤ w.re ∧ w.re ≤ 4 ∧ A j < -w.im ∧ -w.im < B j) ∧
        ((γ j).head (hγ j)).re ≤ -2.5 ∧
        2.5 ≤ ((γ j).getLast (hγ j)).re ∧
        (∀ w ∈ meshPolyTrace (σ_left j),
          -2.4 < w.re ∧ w.re < -1.1 ∧ 0 < -w.im) ∧
        B j ≤ -((σ_left j).head (hσL j)).im ∧
        -((σ_left j).getLast (hσL j)).im ≤ A (j + 2) ∧
        (∀ w ∈ meshPolyTrace (σ_right j),
          1.1 < w.re ∧ w.re < 2.4 ∧ 0 < -w.im) ∧
        B j ≤ -((σ_right j).head (hσR j)).im ∧
        -((σ_right j).getLast (hσR j)).im ≤ A (j + 2) ∧
        meshPolyLength (γ j) ≤ Real.exp (η j * u j) ∧
        meshPolyLength (σ_left j) ≤ Real.exp (η j * u j) ∧
        meshPolyLength (σ_right j) ≤ Real.exp (η j * u j) ∧
        (∀ w ∈ meshPolyTrace (γ j) ∪ meshPolyTrace (σ_left j) ∪ meshPolyTrace (σ_right j),
          Real.exp ((lam - η j) * u j) ≤ ‖F w‖ ∧
          ‖F w‖ ≤ Real.exp ((lam + η j) * u j)))
structure LogDeficitTransferPackage (S : FiniteWallNonisotropicStrip) : Prop where
  sqrt_q_first_moment :
    ∃ C_q : ℝ, 0 < C_q ∧
      ∀ k : ℝ, criticalDepthThreshold S ≤ k →
        Real.exp (-k) * ((2 * Real.pi)⁻¹ *
          ∫ x in (0 : ℝ)..(2 * Real.pi),
            Real.sqrt ‖S.q ((x : ℂ) + ((S.H - Real.exp (-k) : ℝ) : ℂ) * Complex.I)‖) ≤
          C_q * (1 + k)
  disk_chain_q_bound :
    ∀ (K : Set ℂ) (A : ℝ),
      IsCompact K → K.Nonempty → K ⊆ criticalLowerHalfPlane → 1 ≤ A →
      ∃ C_margin C_chain : ℝ, 0 < C_margin ∧ 0 < C_chain ∧
        ∀ (κ k_a k_n y₀ U D₀ : ℝ),
          criticalDepthThreshold S + C_margin ≤ min κ (min k_a k_n) →
          0 ≤ U → 0 ≤ D₀ →
          (∀ z : ℂ,
            Real.exp (-(max κ (max k_a k_n) + C_margin)) ≤ wallDepth S z →
            wallDepth S z ≤ Real.exp (-(min κ (min k_a k_n) - C_margin)) →
            ‖S.f z‖ ≤ Real.exp U) →
          Real.exp (U - D₀) ≤
            ‖S.f ((y₀ : ℂ) + ((S.H - Real.exp (-κ) : ℝ) : ℂ) * Complex.I)‖ →
          ∀ x : ℝ, |x - y₀| ≤ A * Real.exp (-k_a) →
            ∀ Z ∈ K,
              Real.exp (-k_n) *
                Real.sqrt ‖S.q ((x : ℂ) + (S.H : ℂ) * Complex.I +
                  (Real.exp (-k_n) : ℂ) * Z)‖ ≤
                C_chain * (1 + D₀) *
                  Real.exp (C_chain * (1 + |κ - k_a| + |k_n - k_a|))
  poisson_q_bound :
    ∀ K : Set ℂ, IsCompact K → K.Nonempty → K ⊆ criticalLowerHalfPlane →
      ∃ C_margin C_har : ℝ, 0 < C_margin ∧ 0 < C_har ∧
        ∀ (k_a k_n K_top D_a : ℝ) (w : ℝ → ℝ),
          criticalDepthThreshold S + C_margin ≤ k_a →
          k_a + C_margin ≤ k_n →
          0 ≤ K_top → 0 ≤ D_a →
          Continuous w →
          Function.Periodic w (2 * Real.pi) →
          (∀ y : ℝ, 0 ≤ w y) →
          (2 * Real.pi)⁻¹ * (∫ y in (0 : ℝ)..(2 * Real.pi), w y) = 1 →
          (∀ z : ℂ, 0 ≤ z.im → z.im ≤ S.H - Real.exp (-(k_n + C_margin)) →
            ‖S.f z‖ ≤ Real.exp K_top) →
          (∀ y : ℝ, 0 < w y →
            Real.exp (K_top - D_a) ≤
              ‖S.f ((y : ℂ) + ((S.H - Real.exp (-k_a) : ℝ) : ℂ) * Complex.I)‖) →
          (2 * Real.pi)⁻¹ * (∫ x in (0 : ℝ)..(2 * Real.pi),
            sSup ((fun Z : ℂ =>
              Real.exp (-k_n) *
                Real.sqrt ‖S.q ((x : ℂ) + (S.H : ℂ) * Complex.I +
                  (Real.exp (-k_n) : ℂ) * Z)‖) '' K) *
              ancestorPoissonDensity (Real.exp (-k_a)) w x) ≤
            C_har * (1 + D_a + Real.exp (-k_a) * (1 + K_top))

