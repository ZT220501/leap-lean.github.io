      exact le_trans (hp_max ⟨⟨hx₀_lo, hx₀_hi⟩, abs_le.mp hw⟩) (le_max_left _ _)
    let r_t_sub : ℝ := min (η / 4) (P.η_sf / M_slab)
    have hr_t_sub_pos : 0 < r_t_sub := lt_min (by positivity) (div_pos P.η_sf_pos (by positivity))
    let ρ_sub : ℝ :=
