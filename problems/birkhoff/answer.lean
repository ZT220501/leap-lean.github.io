      have hle : N + j + 1 ≤ 2 * N := by omega
      have hsub : 2 * N - (N + j + 1) = N - 1 - j := by omega
      rw [← hsub]
      exact Nat.choose_symm hle
    have h_row_sum_nat :
        2 * (∑ j ∈ Finset.range N, (2 * N).choose (N + j + 1)) + N.centralBinom = 4 ^ N := by
      have hsum := Nat.sum_range_choose (2 * N)
      have hpow : 2 ^ (2 * N) = 4 ^ N := by
        rw [pow_mul]
        norm_num
      rw [hpow, h_range_split N (fun m => (2 * N).choose m)] at hsum
      have hlow :
