        refine (hx₀_ball_ev.and hΔx₀_ball_ev).mono fun δ ⟨hx_b, hdx_b⟩ => ?_
        have hadd : x₀ δ i.succ + (-Δx₀ δ i) = x₀ δ i.castSucc := by dsimp [Δx₀]; ring
        have ht := htaylor2_eq (x₀ δ i.succ) (hx_b i.succ) (-Δx₀ δ i) (hdx_b i).2
        rw [hadd] at ht
