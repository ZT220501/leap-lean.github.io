          exact sub_eq_zero.mp (norm_le_zero_iff.mp this)
        have hp_eq : w_p' = w_p := by
          have : ‖w_p' - w_p‖ ≤ 0 :=
            hδw_zero ▸ le_trans (le_max_right _ _) (le_max_right _ _)
          exact sub_eq_zero.mp (norm_le_zero_iff.mp this)
        rw [hm_eq, h0_eq, hp_eq, sub_self, norm_zero]
        have hC_hess_pos : 0 ≤ C_hess := by
          dsimp [C_hess]
          positivity [S.M_act_pos]
        positivity
      · have hδw_pos : 0 < δ_w := lt_of_le_of_ne hδw_nonneg (Ne.symm hδw_zero)
        have hδw_c_ne : (δ_w : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (ne_of_gt hδw_pos)
        have hδw_c_norm : ‖(δ_w : ℂ)‖ = δ_w := by
          rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos hδw_pos]
        let v_m : ℂ := (w_m' - w_m) / (δ_w : ℂ)
        let v_0 : ℂ := (w_0' - w_0) / (δ_w : ℂ)
        let v_p : ℂ := (w_p' - w_p) / (δ_w : ℂ)
        have hvm_norm : ‖v_m‖ ≤ 1 := by
