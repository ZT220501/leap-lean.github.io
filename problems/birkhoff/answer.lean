      exact Real.sqrt_le_sqrt (by nlinarith)
    have hx_bounds : -rx ≤ x ∧ x ≤ rx := abs_le.mp hx_le_rx
    have hΦ_nn : 0 ≤ Φ_tan x := by change 0 ≤ rx + x; linarith
    have hD_nn : 0 ≤ D_tan x := by
