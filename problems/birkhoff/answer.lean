    let M_c : Fin (m + 1) → ℂ := fun k =>
      (((P k.succ).re : ℝ) : ℂ) + (((P k.castSucc).im : ℝ) : ℂ) * Complex.I
    have hM_re : ∀ k, (M_c k).re = (P k.succ).re := by intro k; simp [M_c]
    have hM_im : ∀ k, (M_c k).im = (P k.castSucc).im := by intro k; simp [M_c]
    have hM_sq : ∀ k : Fin (m + 1), M_c k ∈ meshClosedSquare (c k) (9 * ρ k) := by
      intro k
      refine ⟨?_, ?_⟩
      · simpa [Complex.sub_re, hM_re k] using (hB_props k).1.1
      · simpa [Complex.sub_im, hM_im k] using (hA_props k).1.2
