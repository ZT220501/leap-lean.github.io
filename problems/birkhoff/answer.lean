      IsStripBounded p σ' B₂ v →
      IsStripBounded p σ' (C_mul * B₁ * B₂) (fun z => u z * v z) := by
    intro σ' B₁ B₂ u v hu hv
    refine ⟨hu.1.fun_mul hv.1, ?_⟩
    intro k hk z hz
    have hB₁_nonneg : 0 ≤ B₁ := le_trans (norm_nonneg _) (hu.2 0 (Nat.zero_le p) z hz)
    have hB₂_nonneg : 0 ≤ B₂ := le_trans (norm_nonneg _) (hv.2 0 (Nat.zero_le p) z hz)
    rw [iteratedDeriv_fun_mul (hContDiffAt hu.1 hz k) (hContDiffAt hv.1 hz k)]
    calc
      ‖∑ i ∈ Finset.range (k + 1),
          (k.choose i : ℂ) * iteratedDeriv i u z * iteratedDeriv (k - i) v z‖
        ≤ ∑ i ∈ Finset.range (k + 1),
            ‖(k.choose i : ℂ) * iteratedDeriv i u z * iteratedDeriv (k - i) v z‖ :=
          norm_sum_le _ _
      _ ≤ ∑ i ∈ Finset.range (k + 1), (k.choose i : ℝ) * (B₁ * B₂) := by
          apply Finset.sum_le_sum
          intro i hi
          have hik : i ≤ k := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
          have hip : i ≤ p := le_trans hik hk
          have hkip : k - i ≤ p := le_trans (Nat.sub_le k i) hk
          rw [mul_assoc, norm_mul, norm_mul, Complex.norm_natCast]
          exact mul_le_mul_of_nonneg_left
            (mul_le_mul (hu.2 i hip z hz) (hv.2 (k - i) hkip z hz) (norm_nonneg _) hB₁_nonneg)
            (Nat.cast_nonneg _)
      _ = ((∑ i ∈ Finset.range (k + 1), k.choose i : ℕ) : ℝ) * (B₁ * B₂) := by
          rw [← Finset.sum_mul]
          push_cast
          rfl
