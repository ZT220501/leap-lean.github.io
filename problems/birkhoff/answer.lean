      let g₁ : ℂ → ℂ := fun w => (Ψ (z, w)).1
      let g₂ : ℂ → ℂ := fun w => (Ψ (z, w)).2
      have hΨ_at : DifferentiableAt ℂ Ψ (z, 0) := hΨ_holo.differentiableAt (hU₀_open.mem_nhds hqz_U₀)
      have hin_z0 : DifferentiableAt ℂ (fun w : ℂ => (z, w)) 0 :=
