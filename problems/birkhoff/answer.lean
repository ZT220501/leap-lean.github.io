            D_vert i_top q c p ≠ 0 →
            N_vert i_top q c p / D_vert i_top q c p = F_anc q c p) := by
    let S_all : ℕ := F_all.sup (fun q : ℤ => q.natAbs)
    let J_all : ℝ := wallAllJBound K q_idx
    have hJ_eq : J_all = (S_all : ℝ) + 2 := rfl
    have hS_nonneg : (0 : ℝ) ≤ (S_all : ℝ) := Nat.cast_nonneg S_all
    have hJ_ge_two : (2 : ℝ) ≤ J_all := by linarith
    have hJ_pos : 0 < J_all := by linarith
    have h2J_pos : 0 < 2 * J_all := by linarith
    have hH₂_pos : 0 < H₂ := by linarith [W.s_base_pos, hH₂_ge]
    have hH₂_sub_pos : 0 < H₂ - ρ := by linarith [W.s_base_pos, hH₂_ge, hρ_lt]
    have hq_abs_le : ∀ q ∈ F_all, |(q : ℝ)| ≤ (S_all : ℝ) := by
      intro q hq
      have h_nat : q.natAbs ≤ S_all :=
        Finset.le_sup (f := fun z : ℤ => z.natAbs) hq
      have h_cast : ((q.natAbs : ℕ) : ℝ) ≤ (S_all : ℝ) := Nat.cast_le.mpr h_nat
      have h_abs : |(q : ℝ)| = ((q.natAbs : ℕ) : ℝ) := by
        rcases Int.natAbs_eq q with h | h
        · have hR := congrArg (Int.cast (R := ℝ)) h
          rw [Int.cast_natCast] at hR
          rw [hR, abs_of_nonneg (Nat.cast_nonneg _)]
        · have hR := congrArg (Int.cast (R := ℝ)) h
          rw [Int.cast_neg, Int.cast_natCast] at hR
          rw [hR, abs_neg, abs_of_nonneg (Nat.cast_nonneg _)]
      linarith
    have hShift_diff : ∀ q : ℤ, Differentiable ℂ (wallShiftPair q) := fun q =>
      (differentiable_fst.add ((differentiable_const _).mul differentiable_snd)).prodMk
        differentiable_snd
    have hShift_inv : ∀ (q : ℤ) (w : ℂ × ℂ),
        wallShiftPair q (wallShiftPair (-q) w) = w := by
      intro q w
      ext
      · dsimp [wallShiftPair]
        push_cast
        ring
      · rfl
    have hShift_lip : ∀ q ∈ F_all, ∀ (p₁ p₂ : ℂ × ℂ) (R : ℝ),
