        have hexpB := h_iter_exp F z₀ (B ε) l
        rw [h_split_range, Finset.sum_insert (by simp), Finset.sum_insert (by simp)] at hexpA hexpB
        have hd1 : lineCoalescingDslopeIter F z₀ 1 z₀ = deriv F z₀ := dslope_same F z₀
        have h_mid_sum :
