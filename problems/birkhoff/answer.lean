        _ ≤ 2 * M.ρ_1 := by linarith
    have hfU_deriv_bd : ∀ z ∈ Metric.ball t₀ (R / 3), ‖deriv f_U z‖ ≤ 4 * M.ρ_1 / R := by
      intro z hz
      have hsub : Metric.closedBall z (R / 2) ⊆ Metric.ball t₀ R := by
        intro w hw
        rw [Metric.mem_closedBall] at hw
        rw [Metric.mem_ball] at hz ⊢
        calc dist w t₀ ≤ dist w z + dist z t₀ := dist_triangle w z t₀
          _ < R / 2 + R / 3 := by linarith
          _ < R := by linarith
      have hle := Complex.norm_deriv_le_of_forall_mem_sphere_norm_le (half_pos hR_pos)
        (hfU_holo.diffContOnCl_ball hsub)
        (fun w hw => hfU_bd w (hsub (Metric.sphere_subset_closedBall hw)))
      calc ‖deriv f_U z‖ ≤ (2 * M.ρ_1) / (R / 2) := hle
