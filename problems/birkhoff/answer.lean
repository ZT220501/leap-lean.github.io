          compPowerSeries2D V (MvPowerSeries.X 0 + MvPowerSeries.X 1) = 0 →
        U = 0 ∧ V = 0 := by
      intro U V hU0 hsum
      let π : Fin 2 → MvPowerSeries (Fin 2) ℂ → PowerSeries ℂ :=
        fun i Ψ => PowerSeries.mk (fun m => MvPowerSeries.coeff (Finsupp.single i m) Ψ)
      have hπ_add : ∀ (i : Fin 2) (A B : MvPowerSeries (Fin 2) ℂ),
          π i (A + B) = π i A + π i B := by
        intro i A B; ext m
        simp [π]
      have hπ_mul : ∀ (i : Fin 2) (A B : MvPowerSeries (Fin 2) ℂ),
          π i (A * B) = π i A * π i B := by
        intro i A B; ext m
        have hmul_ps : PowerSeries.coeff m (π i A * π i B) =
            ∑ a ∈ Finset.range (m + 1),
              PowerSeries.coeff a (π i A) * PowerSeries.coeff (m - a) (π i B) := by
          rw [PowerSeries.coeff_mul]
          exact Finset.Nat.sum_antidiagonal_eq_sum_range_succ
            (fun a b => PowerSeries.coeff a (π i A) * PowerSeries.coeff b (π i B)) m
        rw [PowerSeries.coeff_mk, MvPowerSeries.coeff_mul, hmul_ps]
        simp only [π, PowerSeries.coeff_mk]
        let e : ℕ → (Fin 2 →₀ ℕ) × (Fin 2 →₀ ℕ) :=
          fun a => (Finsupp.single i a, Finsupp.single i (m - a))
        symm
        refine Finset.sum_bij (fun a _ => e a) ?_ ?_ ?_ ?_
        · intro a ha
          rw [Finset.HasAntidiagonal.mem_antidiagonal]
          have ham : a ≤ m := Nat.lt_succ_iff.mp (Finset.mem_range.mp ha)
          dsimp only [e]
          rw [← Finsupp.single_add, Nat.add_sub_of_le ham]
        · intro a₁ _ a₂ _ heq
          have h1 := congr_arg Prod.fst heq
          have h2 := Finsupp.ext_iff.mp h1 i
          simpa [e] using h2
        · intro p hp
          have hp_eq : p.1 + p.2 = Finsupp.single i m :=
            Finset.HasAntidiagonal.mem_antidiagonal.mp hp
          refine ⟨p.1 i, Finset.mem_range.mpr ?_, ?_⟩
          · have hi : p.1 i + p.2 i = m := by
              have := Finsupp.ext_iff.mp hp_eq i
              simpa using this
