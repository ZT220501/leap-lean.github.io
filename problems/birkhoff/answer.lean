    fun hf => ⟨hf.1, hf.2.2.2⟩
  have hBnd_congr : ∀ {σ' B : ℝ} {f g : ℂ → ℂ},
      IsStripBounded p σ' B f →
      (∀ z ∈ horizStrip σ', g z = f z) →
      IsStripBounded p σ' B g := by
    intro σ' B f g hf hfg
    refine ⟨hf.1.congr hfg, ?_⟩
    intro k hk z hz
