    obtain ⟨η₀, hη₀_pos, hη₀⟩ := Metric.eventually_nhds_iff_ball.mp hEv_all
    let t_real : ℝ := min (η₀ / 2) (min (δ₁ / 2) (C.r₁ / 2))
