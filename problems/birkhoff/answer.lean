      rw [hsum_lift, map_sum]
      apply Finset.sum_congr rfl
      intro s _
      rw [PowerSeries.coeff_mk, div_eq_inv_mul (H_star s),
        h_lift_mul F Φ (F.mul_mem (inv_mem (natCast_mem F s.factorial)) (hH s))
