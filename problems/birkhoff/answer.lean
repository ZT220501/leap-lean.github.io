        field_simp
      linarith
    let δ : ℕ → ℝ := fun i => (d₀ / 400) * (1 / 2 : ℝ) ^ i
    let s_seq : ℕ → ℝ := fun i => s_init - 20 * ∑ r ∈ Finset.range i, δ r
    let d_seq : ℕ → ℝ := fun i => d₀ - 20 * ∑ r ∈ Finset.range i, δ r
    let ε_bar : ℕ → ℝ := fun i => (d₀ / (2 : ℝ) ^ i) ^ A_exp
    let N_seq : ℕ → ℕ := fun i => 1 + Nat.ceil ((δ i)⁻¹ * Real.log (1 / ε_bar i))
    let stepBound : ℕ → ℝ := fun i => G.C_step * K_B ^ B₀ * d₀ ^ 2 * (1 / 4 : ℝ) ^ i
    let η_seq : ℕ → ℝ := fun i => G.η_adm / 4 + ∑ r ∈ Finset.range i, stepBound r
    let s_lim : ℝ := s_init - d₀ / 10
    let d_lim : ℝ := (9 / 10 : ℝ) * d₀
    have hs_lim_eq : s_lim = s_init - d₀ / 10 := rfl
    have hd_lim_eq : d_lim = (9 / 10 : ℝ) * d₀ := rfl
    have hs_lim_pos : 0 < s_lim := by linarith
    have hs_lim_le : s_lim ≤ G.s_act := by linarith
    have hd_lim_pos : 0 < d_lim := by positivity
    have hd_lim_le : d_lim ≤ G.d_act := by linarith
    have hd_lim_lt : d_lim < s_lim / 2 := by linarith
    have h_sum_half : ∀ i : ℕ, ∑ r ∈ Finset.range i, (1 / 2 : ℝ) ^ r = 2 - 2 * (1 / 2 : ℝ) ^ i := by
      intro i; induction i with
      | zero => norm_num
      | succ i ih => rw [Finset.sum_range_succ, ih]; ring
    have h_sum_quarter : ∀ i : ℕ,
