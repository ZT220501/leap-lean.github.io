                have hexp_re : (Complex.I * (n : ℂ) * y).re ≤ |(n : ℝ)| * |y.im| := by
                  have hre : (Complex.I * (n : ℂ) * y).re = -(n : ℝ) * y.im := by
                    simp [Complex.mul_re]
                  rw [hre]
                  have := le_abs_self (-(n : ℝ) * y.im)
                  rwa [abs_mul, abs_neg] at this
                calc ‖R_mode n t‖ * Real.exp (Complex.I * (n : ℂ) * y).re
                    ≤ (3 * Q * η * Real.exp (-|(n : ℝ)| * (s - (a : ℝ) * δ - |t.im| / 2))) *
                        Real.exp (|(n : ℝ)| * |y.im|) :=
                      mul_le_mul hR_n (Real.exp_le_exp.mpr hexp_re)
                        (Real.exp_nonneg _) (by positivity)
                  _ = 3 * Q * η *
                        Real.exp (-|(n : ℝ)| * (s - (a : ℝ) * δ - |t.im| / 2 - |y.im|)) := by
                      rw [mul_assoc, ← Real.exp_add]; congr 2; ring
                  _ ≤ 3 * Q * η * Real.exp (-|(n : ℝ)| * δ) := by
                      refine mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr ?_) (by positivity)
                      exact mul_le_mul_of_nonpos_left h_exc_R (by linarith [abs_nonneg (n : ℝ)])
            _ ≤ 6 * Q ^ 2 * η := by
                have : 2 * (3 * Q * η) * δ⁻¹ = 6 * (Q * δ⁻¹) * η := by ring
                rw [this]
                refine mul_le_mul_of_nonneg_right ?_ hη
                have : Q * δ⁻¹ ≤ Q ^ 2 := by
                  calc Q * δ⁻¹ ≤ Q * Q := mul_le_mul_of_nonneg_left hδinv_le_Q hQ_pos.le
                    _ = Q ^ 2 := by ring
                linarith
        have h_tail_bound :
            ‖∑' x : ↥(S_fin : Set ℤ)ᶜ,
                fourierCoeff_ℂ F (x : ℤ) t * Complex.exp (Complex.I * ((x : ℤ) : ℂ) * y)‖ ≤
              2 * Q * M * Real.exp (-(N : ℝ) * δ) := by
          have h_exc_F : δ ≤ s - (j₀ : ℝ) * δ - ν * |t.im| - |y.im| := by nlinarith
          have h_sub_sum : Summable (fun x : ↥(S_fin : Set ℤ)ᶜ =>
              ‖fourierCoeff_ℂ F (x : ℤ) t * Complex.exp (Complex.I * ((x : ℤ) : ℂ) * y)‖) :=
            (hF_hasSum.summable.subtype _).norm
          calc ‖∑' x : ↥(S_fin : Set ℤ)ᶜ,
                  fourierCoeff_ℂ F (x : ℤ) t * Complex.exp (Complex.I * ((x : ℤ) : ℂ) * y)‖
              ≤ ∑' x : ↥(S_fin : Set ℤ)ᶜ,
                  ‖fourierCoeff_ℂ F (x : ℤ) t * Complex.exp (Complex.I * ((x : ℤ) : ℂ) * y)‖ :=
                norm_tsum_le_tsum_norm h_sub_sum
            _ ≤ 2 * (M * Real.exp (-(N : ℝ) * δ)) * δ⁻¹ := by
                refine h_sub_sum.tsum_le_of_sum_le fun A => ?_
                let A_int : Finset ℤ := A.map ⟨Subtype.val, Subtype.val_injective⟩
                let K : ℕ := A_int.sup Int.natAbs
                let S_tp : Finset ℤ :=
                  (Finset.range (K - N)).image (fun k : ℕ => ((N : ℤ) + (k : ℤ) + 1))
                let S_tn : Finset ℤ :=
                  (Finset.range (K - N)).image (fun k : ℕ => -((N : ℤ) + (k : ℤ) + 1))
                have hdisj_t : Disjoint S_tp S_tn := by
                  rw [Finset.disjoint_left]
                  intro n hn_p hn_n
                  obtain ⟨k₁, _, rfl⟩ := Finset.mem_image.mp hn_p
                  obtain ⟨k₂, _, heq⟩ := Finset.mem_image.mp hn_n
                  omega
                have hinj_tp : Set.InjOn (fun k : ℕ => ((N : ℤ) + (k : ℤ) + 1))
                    ↑(Finset.range (K - N)) := by
                  intro k₁ _ k₂ _ heq; dsimp at heq; omega
                have hinj_tn : Set.InjOn (fun k : ℕ => -((N : ℤ) + (k : ℤ) + 1))
                    ↑(Finset.range (K - N)) := by
                  intro k₁ _ k₂ _ heq; dsimp at heq; omega
                have hA_sub : A_int ⊆ S_tp ∪ S_tn := by
                  intro n hn
                  obtain ⟨x, hxA, rfl⟩ := Finset.mem_map.mp hn
                  change (x : ℤ) ∈ S_tp ∪ S_tn
                  have hx_not : (x : ℤ) ∉ S_fin := Finset.mem_coe.not.mp x.2
                  rw [Finset.mem_Icc] at hx_not
                  have hle_K : (x : ℤ).natAbs ≤ K :=
                    Finset.le_sup (f := Int.natAbs) (Finset.mem_map_of_mem _ hxA)
                  rw [Finset.mem_union]
                  rcases lt_or_ge (x : ℤ) 0 with hlt | hge
                  · right
                    rw [Finset.mem_image]
                    refine ⟨(-(x : ℤ) - (N : ℤ) - 1).toNat,
                      Finset.mem_range.mpr (by omega), by omega⟩
                  · left
                    rw [Finset.mem_image]
                    refine ⟨((x : ℤ) - (N : ℤ) - 1).toNat,
                      Finset.mem_range.mpr (by omega), by omega⟩
                set g_tail : ℤ → ℝ := fun n =>
                  ‖fourierCoeff_ℂ F n t * Complex.exp (Complex.I * (n : ℂ) * y)‖
                have hg_bound : ∀ n : ℤ, g_tail n ≤ M * Real.exp (-|(n : ℝ)| * δ) := by
                  intro n
                  dsimp [g_tail]
                  rw [norm_mul, Complex.norm_exp]
                  have hexp_re : (Complex.I * (n : ℂ) * y).re ≤ |(n : ℝ)| * |y.im| := by
                    have hre : (Complex.I * (n : ℂ) * y).re = -(n : ℝ) * y.im := by
                      simp [Complex.mul_re]
                    rw [hre]
                    have := le_abs_self (-(n : ℝ) * y.im)
                    rwa [abs_mul, abs_neg] at this
                  calc ‖fourierCoeff_ℂ F n t‖ * Real.exp (Complex.I * (n : ℂ) * y).re
                      ≤ (M * Real.exp (-|(n : ℝ)| * (s - (j₀ : ℝ) * δ - ν * |t.im|))) *
                          Real.exp (|(n : ℝ)| * |y.im|) :=
                        mul_le_mul ((hFn_strip t ht_B0).1 n) (Real.exp_le_exp.mpr hexp_re)
                          (Real.exp_nonneg _) (by positivity)
                    _ = M * Real.exp (-|(n : ℝ)| * (s - (j₀ : ℝ) * δ - ν * |t.im| - |y.im|)) := by
                        rw [mul_assoc, ← Real.exp_add]; congr 2; ring
                    _ ≤ M * Real.exp (-|(n : ℝ)| * δ) := by
                        refine mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr ?_) hM
                        exact mul_le_mul_of_nonpos_left h_exc_F (by linarith [abs_nonneg (n : ℝ)])
                have h_map_eq :
                    (∑ x ∈ A, g_tail (x : ℤ)) = ∑ n ∈ A_int, g_tail n := by
                  simp [A_int]
                rw [h_map_eq]
                calc (∑ n ∈ A_int, g_tail n)
                    ≤ ∑ n ∈ S_tp ∪ S_tn, g_tail n :=
                      Finset.sum_le_sum_of_subset_of_nonneg hA_sub (fun _ _ _ => norm_nonneg _)
                  _ = (∑ n ∈ S_tp, g_tail n) + (∑ n ∈ S_tn, g_tail n) :=
                      Finset.sum_union hdisj_t
                  _ = (∑ k ∈ Finset.range (K - N), g_tail ((N : ℤ) + (k : ℤ) + 1)) +
                        (∑ k ∈ Finset.range (K - N), g_tail (-((N : ℤ) + (k : ℤ) + 1))) := by
                      rw [Finset.sum_image hinj_tp, Finset.sum_image hinj_tn]
                  _ ≤ (M * Real.exp (-(N : ℝ) * δ)) * δ⁻¹ +
                        (M * Real.exp (-(N : ℝ) * δ)) * δ⁻¹ := by
                      have h_tp : (∑ k ∈ Finset.range (K - N), g_tail ((N : ℤ) + (k : ℤ) + 1)) ≤
                          (M * Real.exp (-(N : ℝ) * δ)) * δ⁻¹ := by
                        calc (∑ k ∈ Finset.range (K - N), g_tail ((N : ℤ) + (k : ℤ) + 1))
                            ≤ ∑ k ∈ Finset.range (K - N),
                                (M * Real.exp (-(N : ℝ) * δ)) * Real.exp (-(((k : ℝ) + 1) * δ)) := by
                              refine Finset.sum_le_sum fun k _ => ?_
                              refine (hg_bound _).trans_eq ?_
                              have habsR : |(((N : ℤ) + (k : ℤ) + 1 : ℤ) : ℝ)| =
                                  (N : ℝ) + (k : ℝ) + 1 := by
                                push_cast; exact abs_of_pos (by positivity)
                              rw [habsR, mul_assoc, ← Real.exp_add]
                              congr 2; ring
                          _ = (M * Real.exp (-(N : ℝ) * δ)) *
                                ∑ k ∈ Finset.range (K - N), Real.exp (-(((k : ℝ) + 1) * δ)) := by
                              rw [← Finset.mul_sum]
                          _ ≤ (M * Real.exp (-(N : ℝ) * δ)) * δ⁻¹ :=
                              mul_le_mul_of_nonneg_left
                                (exp_geom_range_le_inv δ hδ0 (K - N)) (by positivity)
                      have h_tn : (∑ k ∈ Finset.range (K - N), g_tail (-((N : ℤ) + (k : ℤ) + 1))) ≤
                          (M * Real.exp (-(N : ℝ) * δ)) * δ⁻¹ := by
                        calc (∑ k ∈ Finset.range (K - N), g_tail (-((N : ℤ) + (k : ℤ) + 1)))
                            ≤ ∑ k ∈ Finset.range (K - N),
                                (M * Real.exp (-(N : ℝ) * δ)) * Real.exp (-(((k : ℝ) + 1) * δ)) := by
                              refine Finset.sum_le_sum fun k _ => ?_
                              refine (hg_bound _).trans_eq ?_
                              have habsR : |((-((N : ℤ) + (k : ℤ) + 1) : ℤ) : ℝ)| =
                                  (N : ℝ) + (k : ℝ) + 1 := by
                                push_cast; rw [abs_neg]; exact abs_of_pos (by positivity)
                              rw [habsR, mul_assoc, ← Real.exp_add]
                              congr 2; ring
                          _ = (M * Real.exp (-(N : ℝ) * δ)) *
                                ∑ k ∈ Finset.range (K - N), Real.exp (-(((k : ℝ) + 1) * δ)) := by
                              rw [← Finset.mul_sum]
                          _ ≤ (M * Real.exp (-(N : ℝ) * δ)) * δ⁻¹ :=
                              mul_le_mul_of_nonneg_left
                                (exp_geom_range_le_inv δ hδ0 (K - N)) (by positivity)
                      exact add_le_add h_tp h_tn
                  _ = 2 * (M * Real.exp (-(N : ℝ) * δ)) * δ⁻¹ := by ring
            _ ≤ 2 * Q * M * Real.exp (-(N : ℝ) * δ) := by
                have : 2 * (M * Real.exp (-(N : ℝ) * δ)) * δ⁻¹ =
                    2 * δ⁻¹ * (M * Real.exp (-(N : ℝ) * δ)) := by ring
                rw [this]
                have : 2 * δ⁻¹ ≤ 2 * Q := by linarith
                calc 2 * δ⁻¹ * (M * Real.exp (-(N : ℝ) * δ))
                    ≤ (2 * Q) * (M * Real.exp (-(N : ℝ) * δ)) :=
                      mul_le_mul_of_nonneg_right this (by positivity)
                  _ = 2 * Q * M * Real.exp (-(N : ℝ) * δ) := by ring
        have h_res_neg : glancingDiffOp H (y, t) - F (y, t) =
            -((∑ n ∈ S_fin,
                R_mode n t * Complex.exp (Complex.I * (n : ℂ) * y)) +
              (∑' x : ↥(S_fin : Set ℤ)ᶜ,
                fourierCoeff_ℂ F (x : ℤ) t * Complex.exp (Complex.I * ((x : ℤ) : ℂ) * y))) := by
          rw [h_res_eq]; ring
        rw [h_res_neg, norm_neg]
        calc ‖(∑ n ∈ S_fin,
                  R_mode n t * Complex.exp (Complex.I * (n : ℂ) * y)) +
                (∑' x : ↥(S_fin : Set ℤ)ᶜ,
                  fourierCoeff_ℂ F (x : ℤ) t * Complex.exp (Complex.I * ((x : ℤ) : ℂ) * y))‖
            ≤ ‖∑ n ∈ S_fin,
                  R_mode n t * Complex.exp (Complex.I * (n : ℂ) * y)‖ +
                ‖∑' x : ↥(S_fin : Set ℤ)ᶜ,
                  fourierCoeff_ℂ F (x : ℤ) t * Complex.exp (Complex.I * ((x : ℤ) : ℂ) * y)‖ :=
              norm_add_le _ _
          _ ≤ 6 * Q ^ 2 * η + 2 * Q * M * Real.exp (-(N : ℝ) * δ) :=
              add_le_add h_ret_bound h_tail_bound
          _ ≤ 648 * Q ^ 3 * (η + M * Real.exp (-(N : ℝ) * δ)) := by
              have h1 : 6 * Q ^ 2 * η ≤ 648 * Q ^ 3 * η :=
                mul_le_mul_of_nonneg_right (by linarith) hη
              have h2 : 2 * Q * (M * Real.exp (-(N : ℝ) * δ)) ≤
                  648 * Q ^ 3 * (M * Real.exp (-(N : ℝ) * δ)) :=
                mul_le_mul_of_nonneg_right (by linarith) (by positivity)
              linarith
  exact ⟨hStrip.1, hStrip.2, hMain⟩

theorem two_step_resonant_newton_assembly (Ω : Set Plane)
    (B : AnalyticBoundaryData Ω)
    (S : GlancingScalePackage B)
    (hRat : RationalCompatProp B S)
    (hDiv : BufferedFourierDivProp) :
    Nonempty (GlancingActionAndStepData B) :=
by
  
  
  
  have h_open_strip : ∀ σ : ℝ, IsOpen (horizStrip σ) := by
    intro σ
    exact isOpen_lt (Complex.continuous_im.abs) continuous_const
  have h_open_dom : ∀ ν σ r : ℝ, IsOpen (glancingDomain ν σ r) := by
    intro ν σ r
    exact (isOpen_lt continuous_snd.norm continuous_const).inter
      (isOpen_lt (Complex.continuous_im.comp continuous_fst).abs
        (continuous_const.sub (continuous_const.mul (Complex.continuous_im.comp continuous_snd).abs)))
  have h_dom_mono : ∀ {ν₁ ν₂ σ₁ σ₂ r₁ r₂ : ℝ} {p : ℂ × ℂ},
      ν₁ ≤ ν₂ → σ₂ ≤ σ₁ → r₂ ≤ r₁ →
      p ∈ glancingDomain ν₂ σ₂ r₂ → p ∈ glancingDomain ν₁ σ₁ r₁ := by
    intro ν₁ ν₂ σ₁ σ₂ r₁ r₂ p hν hσ hr hp
    refine ⟨lt_of_lt_of_le hp.1 hr, lt_of_lt_of_le hp.2 ?_⟩
    have him : 0 ≤ |p.2.im| := abs_nonneg _
    nlinarith
  have h_adm_mono : ∀ {s d η₁ η₂ : ℝ} {U : ℂ × ℂ → ℂ},
      η₁ ≤ η₂ → IsAdmissibleGlancingCand s d η₁ U → IsAdmissibleGlancingCand s d η₂ U := by
    intro s d η₁ η₂ U hη hU
    exact ⟨hU.1, hU.2.1, hU.2.2.1, hU.2.2.2.1, fun k hk y t hyt => (hU.2.2.2.2 k hk y t hyt).trans hη⟩
  have h_diffOp_per : ∀ {σ : ℝ} {t : ℂ} {G : ℂ × ℂ → ℂ},
      (∀ z ∈ horizStrip σ, G (z + 2 * Real.pi, t) = G (z, t)) →
      ∀ y : ℂ, |y.im| + |t.im| / 2 < σ →
        glancingDiffOp G (y + 2 * Real.pi, t) = glancingDiffOp G (y, t) := by
    intro σ t G hper y hy
    simp only [glancingDiffOp]
    refine intervalIntegral.integral_congr (fun μ hμ => ?_)
    have hμ_abs : |μ| ≤ 1 / 2 := by
      rw [Set.uIcc_of_le (by norm_num : (-1 / 2 : ℝ) ≤ 1 / 2)] at hμ
      exact abs_le.mpr ⟨by linarith [hμ.1], hμ.2⟩
    have hz_mem : y + (μ : ℂ) * t ∈ horizStrip σ := by
      show |(y + (μ : ℂ) * t).im| < σ
      have him_eq : (y + (μ : ℂ) * t).im = y.im + μ * t.im := by simp
      rw [him_eq]
      calc |y.im + μ * t.im|
          ≤ |y.im| + |μ * t.im| := abs_add_le _ _
        _ = |y.im| + |μ| * |t.im| := by rw [abs_mul]
        _ ≤ |y.im| + (1 / 2) * |t.im| := by gcongr
        _ < σ := by linarith
    have heq_loc : (fun y' : ℂ => G (y' + 2 * Real.pi, t)) =ᶠ[nhds (y + (μ : ℂ) * t)]
        (fun y' : ℂ => G (y', t)) := by
      filter_upwards [(h_open_strip σ).mem_nhds hz_mem] with y' hy'
      exact hper y' hy'
    have h_shift : y + 2 * (Real.pi : ℂ) + (μ : ℂ) * t = (y + (μ : ℂ) * t) + 2 * Real.pi := by ring
    rw [h_shift, ← deriv_comp_add_const (fun y' : ℂ => G (y', t)) (2 * Real.pi)]
    exact heq_loc.deriv_eq
  have h_param_deriv : ∀ {σ : ℝ} {W_t : Set ℂ} {Φ : ℂ × ℂ → ℂ} {t_pt : ℂ},
      0 < σ → IsOpen W_t → t_pt ∈ W_t →
      DifferentiableOn ℂ Φ (horizStrip σ ×ˢ W_t) →
      HasDerivAt (fun t : ℂ => ∫ x in (0 : ℝ)..(2 * Real.pi), Φ ((x : ℂ), t))
        (∫ x in (0 : ℝ)..(2 * Real.pi), deriv (fun w : ℂ => Φ ((x : ℂ), w)) t_pt) t_pt := by
    intro σ W_t Φ t_pt hσ hW_open ht_pt hΦ_holo
    let U_prod : Set (ℂ × ℂ) := horizStrip σ ×ˢ W_t
    have hU_open : IsOpen U_prod := (h_open_strip σ).prod hW_open
    let Φ_t : ℂ × ℂ → ℂ := fun p => deriv (fun w : ℂ => Φ (p.1, w)) p.2
    have hΦ_t_holo : DifferentiableOn ℂ Φ_t U_prod := S.partial_t_holo U_prod Φ hU_open hΦ_holo
    have hΦ_cont : ContinuousOn Φ U_prod := hΦ_holo.continuousOn
    have hΦ_t_cont : ContinuousOn Φ_t U_prod := hΦ_t_holo.continuousOn
    obtain ⟨r, hr_pos, hr_sub⟩ := Metric.isOpen_iff.mp hW_open t_pt ht_pt
    let r₂ : ℝ := r / 2
    have hr₂_pos : 0 < r₂ := half_pos hr_pos
    have h_cb_sub : Metric.closedBall t_pt r₂ ⊆ W_t :=
      (Metric.closedBall_subset_ball (half_lt_self hr_pos)).trans hr_sub
    let K_box : Set (ℂ × ℂ) :=
      (Complex.ofReal '' Set.Icc (0 : ℝ) (2 * Real.pi)) ×ˢ Metric.closedBall t_pt r₂
    have hK_comp : IsCompact K_box :=
      (isCompact_Icc.image Complex.continuous_ofReal).prod (isCompact_closedBall t_pt r₂)
    have hK_sub : K_box ⊆ U_prod := by
      rintro ⟨y, t⟩ ⟨⟨x, _, rfl⟩, ht⟩
      refine ⟨?_, h_cb_sub ht⟩
      show |(x : ℂ).im| < σ
      simpa using hσ
    obtain ⟨B_dom, hB_dom⟩ := hK_comp.exists_bound_of_continuousOn (hΦ_t_cont.mono hK_sub)
    have h_real_mem : ∀ (x : ℝ) {t : ℂ}, t ∈ W_t → ((x : ℂ), t) ∈ U_prod := by
      intro x t ht
      exact ⟨by show |(x : ℂ).im| < σ; simpa using hσ, ht⟩
    have h_cont_x : ∀ {t : ℂ}, t ∈ W_t → Continuous (fun x : ℝ => Φ ((x : ℂ), t)) := by
      intro t ht
      exact hΦ_cont.comp_continuous (Complex.continuous_ofReal.prodMk continuous_const)
        (fun x => h_real_mem x ht)
    have h_cont_xt : Continuous (fun x : ℝ => Φ_t ((x : ℂ), t_pt)) :=
      hΦ_t_cont.comp_continuous (Complex.continuous_ofReal.prodMk continuous_const)
        (fun x => h_real_mem x ht_pt)
    exact (intervalIntegral.hasDerivAt_integral_of_dominated_loc_of_deriv_le
      (F := fun t x => Φ ((x : ℂ), t))
      (F' := fun t x => Φ_t ((x : ℂ), t))
      (bound := fun _ => max B_dom 0)
      (s := Metric.ball t_pt r₂)
      (Metric.ball_mem_nhds t_pt hr₂_pos)
      (Filter.eventually_of_mem (hW_open.mem_nhds ht_pt)
        (fun t ht => (h_cont_x ht).aestronglyMeasurable))
      ((h_cont_x ht_pt).intervalIntegrable _ _)
      h_cont_xt.aestronglyMeasurable
      (Filter.Eventually.of_forall fun x hx t ht => by
        rw [Set.uIoc_of_le (by positivity : (0 : ℝ) ≤ 2 * Real.pi)] at hx
        have hx_icc : x ∈ Set.Icc (0 : ℝ) (2 * Real.pi) := ⟨le_of_lt hx.1, hx.2⟩
        exact (hB_dom ((x : ℂ), t) ⟨⟨x, hx_icc, rfl⟩, Metric.ball_subset_closedBall ht⟩).trans
          (le_max_left _ _))
      intervalIntegrable_const
      (Filter.Eventually.of_forall fun x _ t ht => by
        have ht_W : t ∈ W_t := h_cb_sub (Metric.ball_subset_closedBall ht)
        have h_slice : DifferentiableOn ℂ (fun w : ℂ => Φ ((x : ℂ), w)) W_t :=
          hΦ_holo.comp (differentiableOn_const (x : ℂ) |>.prodMk differentiableOn_id)
            (fun w hw => h_real_mem x hw)
        exact (h_slice.differentiableAt (hW_open.mem_nhds ht_W)).hasDerivAt)).2

  
  
  
  have h_sinc_mul : ∀ z : ℂ, z * sinc_ℂ z = Complex.sin z := by
    intro z
    simp only [sinc_ℂ, ← intervalIntegral.integral_const_mul]
    have h_deriv : ∀ τ ∈ Set.uIcc (0 : ℝ) (1 : ℝ),
        HasDerivAt (fun τ' : ℝ => Complex.sin ((τ' : ℂ) * z))
          (z * Complex.cos ((τ : ℂ) * z)) τ := by
      intro τ _
      have hw0 := (Complex.hasDerivAt_sin ((τ : ℂ) * z)).comp (τ : ℂ)
        ((hasDerivAt_id (τ : ℂ)).mul_const z)
      have hw : HasDerivAt (fun w : ℂ => Complex.sin (w * z))
          (z * Complex.cos ((τ : ℂ) * z)) (τ : ℂ) := by
        convert hw0 using 1
        · ext w; simp [mul_comm]
        · ring
      exact hw.comp_ofReal
    have h_int : IntervalIntegrable (fun τ : ℝ => z * Complex.cos ((τ : ℂ) * z))
        MeasureTheory.volume (0 : ℝ) (1 : ℝ) :=
      (continuous_const.mul (Complex.continuous_cos.comp
        (Complex.continuous_ofReal.mul continuous_const))).intervalIntegrable _ _
    rw [intervalIntegral.integral_eq_sub_of_hasDerivAt h_deriv h_int]
    simp
