    obtain ⟨A_K, B_K, hBez_K⟩ := (Polynomial.separable_def' W_sf).mp hWsf_sep
    obtain ⟨Q₁_K, hQ₁_K⟩ := UniqueFactorizationMonoid.radical_dvd_self (a := W_K)
    have h_dvd_rad_pow :
        ∀ (d : ℕ) (P : Polynomial K_t), P ≠ 0 → P.natDegree ≤ d →
          P ∣ (UniqueFactorizationMonoid.radical P) ^ d := by
      intro d
      induction d with
      | zero =>
        intro P hP_ne hdeg0
        have hdeg_eq : P.natDegree = 0 := Nat.eq_zero_of_le_zero hdeg0
        have hP_C : P = Polynomial.C (P.coeff 0) := Polynomial.eq_C_of_natDegree_eq_zero hdeg_eq
        have hc0_ne : P.coeff 0 ≠ 0 := by
          intro h0; apply hP_ne; rw [hP_C, h0, map_zero]
        rw [hP_C]
        exact (Polynomial.isUnit_C.mpr (isUnit_iff_ne_zero.mpr hc0_ne)).dvd
      | succ d ih =>
        intro P hP_ne hdeg
        by_cases hunit : IsUnit P
        · exact hunit.dvd
        · obtain ⟨q, hq_irr, Q, hPqQ⟩ := WfDvdMonoid.exists_irreducible_factor hunit hP_ne
          have hq_ne : q ≠ 0 := hq_irr.ne_zero
          have hQ_ne : Q ≠ 0 := fun h0 => hP_ne (by rw [hPqQ, h0, mul_zero])
          have hq_pos : 0 < q.natDegree := hq_irr.natDegree_pos
          have hdeg_mul : P.natDegree = q.natDegree + Q.natDegree := by
            rw [hPqQ, Polynomial.natDegree_mul hq_ne hQ_ne]
          have hQ_deg : Q.natDegree ≤ d := by omega
          have hQ_dvd_radQ : Q ∣ (UniqueFactorizationMonoid.radical Q) ^ d :=
            ih Q hQ_ne hQ_deg
          have hradQ_dvd_radP :
              UniqueFactorizationMonoid.radical Q ∣ UniqueFactorizationMonoid.radical P :=
            UniqueFactorizationMonoid.radical_dvd_radical ⟨q, by rw [hPqQ, mul_comm]⟩ hP_ne
          have hQ_dvd : Q ∣ (UniqueFactorizationMonoid.radical P) ^ d :=
            dvd_trans hQ_dvd_radQ (pow_dvd_pow_of_dvd hradQ_dvd_radP d)
          have hq_dvd : q ∣ UniqueFactorizationMonoid.radical P :=
            (UniqueFactorizationMonoid.dvd_radical_iff hq_irr.squarefree.isRadical hP_ne).mpr
              ⟨Q, hPqQ⟩
          conv_lhs => rw [hPqQ]
          rw [pow_succ']
          exact mul_dvd_mul hq_dvd hQ_dvd
    obtain ⟨Q₂_K, hQ₂_K⟩ := h_dvd_rad_pow m W_K hWK_ne (le_of_eq hWK_deg)
    have h_clear_denom :
        ∀ F : Polynomial K_t, ∃ (s : R) (F_R : Polynomial R),
          s ≠ 0 ∧ Polynomial.C (algebraMap R K_t s) * F = F_R.map (algebraMap R K_t) := by
      intro F
      refine Polynomial.induction_on' F ?_ ?_
      · intro p q ⟨sp, pR, hsp, hp_eq⟩ ⟨sq, qR, hsq, hq_eq⟩
        refine ⟨sp * sq, Polynomial.C sq * pR + Polynomial.C sp * qR, mul_ne_zero hsp hsq, ?_⟩
        simp only [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_C, map_mul]
        rw [← hp_eq, ← hq_eq]
        ring
      · intro n a
        obtain ⟨num, den, hden_mem, ha_eq⟩ := IsFractionRing.div_surjective (A := R) a
        have hden_ne : (den : R) ≠ 0 := mem_nonZeroDivisors_iff_ne_zero.mp hden_mem
        have hden_K_ne : algebraMap R K_t den ≠ 0 :=
          fun h0 => hden_ne (IsFractionRing.injective R K_t (by rwa [map_zero]))
        refine ⟨den, Polynomial.monomial n num, hden_ne, ?_⟩
        rw [Polynomial.C_mul_monomial, Polynomial.map_monomial, ← ha_eq,
          mul_div_cancel₀ _ hden_K_ne]
    obtain ⟨s₀, P_sf, hs₀_ne, hPsf_eq⟩ := h_clear_denom W_sf
    obtain ⟨sA, A_R, hsA_ne, hAR_eq⟩ := h_clear_denom A_K
    obtain ⟨sB, B_R, hsB_ne, hBR_eq⟩ := h_clear_denom B_K
    obtain ⟨s₁, Q₁_R, hs₁_ne, hQ₁R_eq⟩ := h_clear_denom Q₁_K
    obtain ⟨s₂, Q₂_R, hs₂_ne, hQ₂R_eq⟩ := h_clear_denom Q₂_K
    have hmap_inj : Function.Injective (Polynomial.map (algebraMap R K_t)) :=
      Polynomial.map_injective _ (IsFractionRing.injective R K_t)
    have hBez_R :
        (Polynomial.C sB * A_R) * P_sf +
          (Polynomial.C sA * B_R) * Polynomial.derivative P_sf =
        Polynomial.C (sA * sB * s₀) := by
      apply hmap_inj
      simp only [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_C, map_mul,
        ← Polynomial.derivative_map, ← hPsf_eq, ← hAR_eq, ← hBR_eq,
        Polynomial.derivative_C_mul]
      calc (Polynomial.C (algebraMap R K_t sB) * (Polynomial.C (algebraMap R K_t sA) * A_K)) *
              (Polynomial.C (algebraMap R K_t s₀) * W_sf) +
            (Polynomial.C (algebraMap R K_t sA) * (Polynomial.C (algebraMap R K_t sB) * B_K)) *
              (Polynomial.C (algebraMap R K_t s₀) * Polynomial.derivative W_sf)
          = Polynomial.C (algebraMap R K_t sA) * Polynomial.C (algebraMap R K_t sB) *
              Polynomial.C (algebraMap R K_t s₀) *
              (A_K * W_sf + B_K * Polynomial.derivative W_sf) := by ring
        _ = Polynomial.C (algebraMap R K_t sA) * Polynomial.C (algebraMap R K_t sB) *
              Polynomial.C (algebraMap R K_t s₀) := by rw [hBez_K, mul_one]
    have hDiv₁_R : Polynomial.C (s₀ * s₁) * W_R = P_sf * Q₁_R := by
      apply hmap_inj
      simp only [Polynomial.map_mul, Polynomial.map_C, map_mul, ← hPsf_eq, ← hQ₁R_eq]
      change Polynomial.C (algebraMap R K_t s₀) * Polynomial.C (algebraMap R K_t s₁) * W_K = _
      rw [hQ₁_K]
      ring
    have hDiv₂_R : Polynomial.C s₂ * P_sf ^ m = W_R * (Polynomial.C (s₀ ^ m) * Q₂_R) := by
      apply hmap_inj
      simp only [Polynomial.map_mul, Polynomial.map_pow, Polynomial.map_C, map_pow,
        ← hPsf_eq, ← hQ₂R_eq]
      change Polynomial.C (algebraMap R K_t s₂) * (Polynomial.C (algebraMap R K_t s₀) * W_sf) ^ m =
        W_K * (Polynomial.C (algebraMap R K_t s₀) ^ m *
          (Polynomial.C (algebraMap R K_t s₂) * Q₂_K))
      rw [mul_pow, mul_left_comm (Polynomial.C (algebraMap R K_t s₂)), hQ₂_K]
      ring
    let δ_elem : R := s₀ * sA * sB * s₁ * s₂
    have hδ_elem_ne : δ_elem ≠ 0 :=
      mul_ne_zero (mul_ne_zero (mul_ne_zero (mul_ne_zero hs₀_ne hsA_ne) hsB_ne) hs₁_ne) hs₂_ne
    obtain ⟨Δ_bad, hΔ_holo, hΔ_eq⟩ := δ_elem.2
    have hΔ_nz : ∃ t_nz ∈ D_t, Δ_bad t_nz ≠ 0 := by
      have h_ex : ∃ x : ↥D_t, δ_elem.1 x ≠ 0 := by
        by_contra h_all
        push Not at h_all
        exact hδ_elem_ne (Subtype.ext (funext h_all))
      obtain ⟨x, hx⟩ := h_ex
      exact ⟨x.1, x.2, by rw [hΔ_eq x]; exact hx⟩
    let ev_R : ↥D_t → (R →+* ℂ) := fun x =>
      { toFun := fun r => r.1 x
        map_one' := rfl
        map_mul' := fun _ _ => rfl
        map_zero' := rfl
        map_add' := fun _ _ => rfl }
    have h_ev_good :
        ∀ (x : ↥D_t), Δ_bad x.1 ≠ 0 → ∀ (Y : ℂ),
          let p_t : Polynomial ℂ := P_sf.map (ev_R x)
          let W_val : ℂ := Y ^ m + ∑ k : Fin m, c k x.1 * Y ^ (k : ℕ)
          (p_t.eval Y = 0 ↔ W_val = 0) ∧
          (p_t.eval Y = 0 → (Polynomial.derivative p_t).eval Y ≠ 0) := by
      intro x hΔx Y p_t W_val
      have hδx : s₀.1 x * sA.1 x * sB.1 x * s₁.1 x * s₂.1 x ≠ 0 := by
        change δ_elem.1 x ≠ 0
        rwa [← hΔ_eq x]
      have hs₂x : s₂.1 x ≠ 0 := right_ne_zero_of_mul hδx
      have hδx4 : s₀.1 x * sA.1 x * sB.1 x * s₁.1 x ≠ 0 := left_ne_zero_of_mul hδx
      have hs₁x : s₁.1 x ≠ 0 := right_ne_zero_of_mul hδx4
      have hδx3 : s₀.1 x * sA.1 x * sB.1 x ≠ 0 := left_ne_zero_of_mul hδx4
      have hsBx : sB.1 x ≠ 0 := right_ne_zero_of_mul hδx3
      have hδx2 : s₀.1 x * sA.1 x ≠ 0 := left_ne_zero_of_mul hδx3
      have hsAx : sA.1 x ≠ 0 := right_ne_zero_of_mul hδx2
      have hs₀x : s₀.1 x ≠ 0 := left_ne_zero_of_mul hδx2
      have hWR_eval : (W_R.map (ev_R x)).eval Y = W_val := by
        dsimp only [W_R, p_low, W_val]
        simp only [Polynomial.map_add, Polynomial.map_pow, Polynomial.map_X,
          Polynomial.map_sum, Polynomial.map_mul, Polynomial.map_C,
          Polynomial.eval_add, Polynomial.eval_pow, Polynomial.eval_X,
          Polynomial.eval_finsetSum, Polynomial.eval_mul, Polynomial.eval_C]
        rfl
      have h1 := congr_arg (fun P : Polynomial R => (P.map (ev_R x)).eval Y) hBez_R
      simp only [Polynomial.map_add, Polynomial.map_mul, Polynomial.map_C,
        ← Polynomial.derivative_map, Polynomial.eval_add, Polynomial.eval_mul,
        Polynomial.eval_C] at h1
      have h2 := congr_arg (fun P : Polynomial R => (P.map (ev_R x)).eval Y) hDiv₁_R
      simp only [Polynomial.map_mul, Polynomial.map_C, Polynomial.eval_mul,
        Polynomial.eval_C, hWR_eval] at h2
      have h3 := congr_arg (fun P : Polynomial R => (P.map (ev_R x)).eval Y) hDiv₂_R
      simp only [Polynomial.map_mul, Polynomial.map_pow, Polynomial.map_C,
        Polynomial.eval_mul, Polynomial.eval_pow, Polynomial.eval_C, hWR_eval] at h3
      change (_ * _ * p_t.eval Y + _ * _ * (Polynomial.derivative p_t).eval Y =
        sA.1 x * sB.1 x * s₀.1 x) at h1
      change (s₀.1 x * s₁.1 x) * W_val = p_t.eval Y * _ at h2
      change s₂.1 x * (p_t.eval Y) ^ m = W_val * _ at h3
      refine ⟨⟨?_, ?_⟩, ?_⟩
      · intro hp0
        rw [hp0, zero_mul] at h2
        exact (mul_eq_zero.mp h2).resolve_left (mul_ne_zero hs₀x hs₁x)
      · intro hW0
        rw [hW0, zero_mul] at h3
        exact (pow_eq_zero_iff (by omega : m ≠ 0)).mp ((mul_eq_zero.mp h3).resolve_left hs₂x)
      · intro hp0 hderiv0
        rw [hp0, hderiv0, mul_zero, mul_zero, add_zero] at h1
        exact mul_ne_zero (mul_ne_zero hsAx hsBx) hs₀x h1.symm
    let D_sf : ℕ := P_sf.natDegree
    choose a_d ha_d_holo ha_d_eq using fun d : ℕ => (P_sf.coeff d).2
    let P₂ : ℂ × ℂ → ℂ := fun q =>
      ∑ d ∈ Finset.range (D_sf + 1), a_d d q.1 * q.2 ^ d
    let ν : ℂ × ℂ → ℂ := fun q =>
      ∑ d ∈ Finset.range D_sf, ((d + 1 : ℕ) : ℂ) * a_d (d + 1) q.1 * q.2 ^ d
    let μ : ℂ × ℂ → ℂ := fun q =>
      ∑ d ∈ Finset.range (D_sf + 1), deriv (a_d d) q.1 * q.2 ^ d
    have hP₂_eq_eval : ∀ (x : ↥D_t) (Y : ℂ), P₂ (x.1, Y) = (P_sf.map (ev_R x)).eval Y := by
      intro x Y
      rw [Polynomial.eval_eq_sum_range'
        (lt_of_le_of_lt Polynomial.natDegree_map_le (Nat.lt_succ_self D_sf))]
      refine Finset.sum_congr rfl fun d _ => ?_
      rw [Polynomial.coeff_map]
      change a_d d x.1 * Y ^ d = (P_sf.coeff d).1 x * Y ^ d
      rw [ha_d_eq d x]
    have hν_eq_deriv_eval :
        ∀ (x : ↥D_t) (Y : ℂ),
          ν (x.1, Y) = (Polynomial.derivative (P_sf.map (ev_R x))).eval Y := by
      intro x Y
      have hd1 : HasDerivAt (fun y : ℂ => P₂ (x.1, y))
          ((Polynomial.derivative (P_sf.map (ev_R x))).eval Y) Y := by
        have hfn : (fun y : ℂ => P₂ (x.1, y)) = fun y : ℂ => (P_sf.map (ev_R x)).eval y := by
          ext y; exact hP₂_eq_eval x y
        rw [hfn]
        exact (P_sf.map (ev_R x)).hasDerivAt Y
      have hd2 : HasDerivAt (fun y : ℂ => P₂ (x.1, y)) (ν (x.1, Y)) Y := by
        have hsum : HasDerivAt (fun y : ℂ => ∑ d ∈ Finset.range (D_sf + 1), a_d d x.1 * y ^ d)
            (∑ d ∈ Finset.range (D_sf + 1), a_d d x.1 * ((d : ℂ) * Y ^ (d - 1))) Y :=
          HasDerivAt.fun_sum fun d _ => (hasDerivAt_pow d Y).const_mul (a_d d x.1)
        refine hsum.congr_deriv ?_
        rw [Finset.sum_range_succ']
        simp only [Nat.cast_zero, zero_mul, mul_zero, add_zero]
        refine Finset.sum_congr rfl fun d _ => ?_
        simp only [Nat.add_sub_cancel]
        ring
      exact hd2.unique hd1
    refine ⟨Δ_bad, hΔ_holo, hΔ_nz, ?_⟩
    intro t₀ ht₀ hΔ_t₀ y_star hy_star
    let Y_star : ℂ := y_star - y₀
    have hY_star_norm : ‖Y_star‖ < r_y / 2 := by
      simpa [Y_star, Metric.mem_ball, dist_eq_norm] using hy_star
    let W_fn : ℂ × ℂ → ℂ := fun q =>
      (q.2 - y₀) ^ m + ∑ k : Fin m, c k q.1 * (q.2 - y₀) ^ (k : ℕ)
    by_cases hW_zero : W_fn (t₀, y_star) = 0
    · let x₀ : ↥D_t := ⟨t₀, ht₀⟩
      have hP₂_zero : P₂ (t₀, Y_star) = 0 := by
        rw [hP₂_eq_eval x₀ Y_star]
        exact (h_ev_good x₀ hΔ_t₀ Y_star).1.mpr hW_zero
      have hν_nz₀ : ν (t₀, Y_star) ≠ 0 := by
        rw [hν_eq_deriv_eval x₀ Y_star]
        refine (h_ev_good x₀ hΔ_t₀ Y_star).2 ?_
        rw [← hP₂_eq_eval x₀ Y_star]
        exact hP₂_zero
      let π₁ : (ℂ × ℂ) →L[ℂ] ℂ :=
        { toLinearMap :=
            { toFun := Prod.fst
              map_add' := fun _ _ => rfl
              map_smul' := fun _ _ => rfl }
          cont := continuous_fst }
      let π₂ : (ℂ × ℂ) →L[ℂ] ℂ :=
        { toLinearMap :=
            { toFun := Prod.snd
              map_add' := fun _ _ => rfl
              map_smul' := fun _ _ => rfl }
          cont := continuous_snd }
      have hπ₁_apply : ∀ q : ℂ × ℂ, π₁ q = q.1 := fun _ => rfl
      have hπ₂_apply : ∀ q : ℂ × ℂ, π₂ q = q.2 := fun _ => rfl
      let Ψ : ℂ × ℂ → ℂ × ℂ := fun q => (q.1, P₂ q)
      let L_Ψ : (ℂ × ℂ) → ((ℂ × ℂ) →L[ℂ] (ℂ × ℂ)) :=
        fun q => π₁.prod (π₁.smulRight (μ q) + π₂.smulRight (ν q))
      have hLΨ_apply : ∀ (q v : ℂ × ℂ),
          L_Ψ q v = (v.1, μ q * v.1 + ν q * v.2) := by
        intro q v
        ext <;> simp [L_Ψ, hπ₁_apply, hπ₂_apply, mul_comm]
      have hΨ_fderiv : ∀ q : ℂ × ℂ, q.1 ∈ D_t → HasFDerivAt Ψ (L_Ψ q) q := by
        intro q hq1
        have hterm : ∀ d : ℕ,
            HasFDerivAt (fun p : ℂ × ℂ => a_d d p.1 * p.2 ^ d)
              (π₁.smulRight (deriv (a_d d) q.1 * q.2 ^ d) +
                π₂.smulRight (a_d d q.1 * ((d : ℂ) * q.2 ^ (d - 1)))) q := by
          intro d
          have had : HasFDerivAt (fun p : ℂ × ℂ => a_d d p.1)
              (π₁.smulRight (deriv (a_d d) q.1)) q := by
            have h1d := ((ha_d_holo d).differentiableAt (Metric.isOpen_ball.mem_nhds hq1)).hasDerivAt
            refine (h1d.comp_hasFDerivAt q π₁.hasFDerivAt).congr_fderiv ?_
            refine ContinuousLinearMap.ext fun ⟨v₁, v₂⟩ => ?_
            simp [hπ₁_apply, mul_comm]
          have hpow : HasFDerivAt (fun p : ℂ × ℂ => p.2 ^ d)
              (π₂.smulRight ((d : ℂ) * q.2 ^ (d - 1))) q := by
            refine ((hasDerivAt_pow d q.2).comp_hasFDerivAt q π₂.hasFDerivAt).congr_fderiv ?_
            refine ContinuousLinearMap.ext fun ⟨v₁, v₂⟩ => ?_
            simp [hπ₂_apply, mul_comm]
          refine (had.mul hpow).congr_fderiv ?_
          refine ContinuousLinearMap.ext fun ⟨v₁, v₂⟩ => ?_
          simp only [_root_.add_apply, _root_.smul_apply,
            ContinuousLinearMap.smulRight_apply, hπ₁_apply, hπ₂_apply, smul_eq_mul]
          ring
        have hP₂_fd : HasFDerivAt P₂ (π₁.smulRight (μ q) + π₂.smulRight (ν q)) q := by
          refine (HasFDerivAt.fun_sum fun d _ => hterm d).congr_fderiv ?_
          refine ContinuousLinearMap.ext fun ⟨v₁, v₂⟩ => ?_
          simp only [_root_.sum_apply, _root_.add_apply,
            ContinuousLinearMap.smulRight_apply, hπ₁_apply, hπ₂_apply, smul_eq_mul,
            Finset.sum_add_distrib]
          congr 1
          · simp [μ, Finset.mul_sum]
          · rw [Finset.sum_range_succ']
            simp only [Nat.cast_zero, zero_mul, mul_zero, add_zero, Nat.add_sub_cancel]
            simp only [ν, Finset.mul_sum]
            refine Finset.sum_congr rfl fun d _ => by push_cast; ring
        exact (π₁.hasFDerivAt.prodMk hP₂_fd).congr_fderiv
          (ContinuousLinearMap.ext fun _ => rfl)
      have hμ_cont : ContinuousOn μ (D_t ×ˢ Set.univ) := by
        refine continuousOn_finsetSum _ fun d _ => ?_
        have hd_holo : DifferentiableOn ℂ (deriv (a_d d)) D_t :=
          (ha_d_holo d).deriv Metric.isOpen_ball
        exact (hd_holo.continuousOn.comp continuousOn_fst (fun q hq => hq.1)).mul
          (continuousOn_snd.pow d)
      have hν_cont : ContinuousOn ν (D_t ×ˢ Set.univ) := by
        refine continuousOn_finsetSum _ fun d _ => ?_
        exact (continuousOn_const.mul
          ((ha_d_holo (d + 1)).continuousOn.comp continuousOn_fst (fun q hq => hq.1))).mul
          (continuousOn_snd.pow d)
      have hLΨ_contAt : ContinuousAt L_Ψ (t₀, Y_star) := by
        rw [Metric.continuousAt_iff]
        intro ε hε
        have hmem₀ : (t₀, Y_star) ∈ D_t ×ˢ (Set.univ : Set ℂ) := ⟨ht₀, trivial⟩
        have hopen_dom : IsOpen (D_t ×ˢ (Set.univ : Set ℂ)) :=
          Metric.isOpen_ball.prod isOpen_univ
        have hμ_c : ContinuousAt μ (t₀, Y_star) :=
          (hμ_cont (t₀, Y_star) hmem₀).continuousAt (hopen_dom.mem_nhds hmem₀)
        have hν_c : ContinuousAt ν (t₀, Y_star) :=
          (hν_cont (t₀, Y_star) hmem₀).continuousAt (hopen_dom.mem_nhds hmem₀)
        obtain ⟨δ₁, hδ₁, hb₁⟩ := Metric.continuousAt_iff.mp hμ_c (ε / 2) (by positivity)
        obtain ⟨δ₂, hδ₂, hb₂⟩ := Metric.continuousAt_iff.mp hν_c (ε / 2) (by positivity)
        refine ⟨min δ₁ δ₂, lt_min hδ₁ hδ₂, fun q hq => ?_⟩
        have hdμ : ‖μ q - μ (t₀, Y_star)‖ < ε / 2 :=
          dist_eq_norm (μ q) _ ▸ hb₁ (lt_of_lt_of_le hq (min_le_left _ _))
        have hdν : ‖ν q - ν (t₀, Y_star)‖ < ε / 2 :=
          dist_eq_norm (ν q) _ ▸ hb₂ (lt_of_lt_of_le hq (min_le_right _ _))
        rw [dist_eq_norm]
        have hop_le : ‖L_Ψ q - L_Ψ (t₀, Y_star)‖ ≤
            ‖μ q - μ (t₀, Y_star)‖ + ‖ν q - ν (t₀, Y_star)‖ := by
          refine ContinuousLinearMap.opNorm_le_bound _ (by positivity) fun v => ?_
          have happ : (L_Ψ q - L_Ψ (t₀, Y_star)) v =
              (0, (μ q - μ (t₀, Y_star)) * v.1 + (ν q - ν (t₀, Y_star)) * v.2) := by
            rw [_root_.sub_apply, hLΨ_apply, hLΨ_apply]
            ext
            · simp
            · simp only [Prod.snd_sub]; ring
          rw [happ, Prod.norm_def, norm_zero, max_eq_right (norm_nonneg _)]
          calc ‖(μ q - μ (t₀, Y_star)) * v.1 + (ν q - ν (t₀, Y_star)) * v.2‖
