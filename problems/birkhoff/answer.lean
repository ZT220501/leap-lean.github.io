        exact (Finset.prod_ne_zero_iff.mp hp_nz) ci (Finset.mem_univ ci)
      let f₀ : Fin 2 → ℂ × ℂ → ℂ := fun i q => (E₀ i).num p₁ q * ((E₀ i).den p₁ q)⁻¹
