          intro n
          have ht_in : dist (p₀.2 + h_seq n) p₀.2 < 3 * r := by
            rw [dist_eq_norm, add_sub_cancel_left]
            have hnorm : ‖h_seq n‖ = r / ((n : ℝ) + 2) := by
