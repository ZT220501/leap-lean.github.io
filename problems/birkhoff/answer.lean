            intro r
            have h_eq : MvPowerSeries.coeff d (lcJetGrad2D h_tr S_ser C_ser α_ser r) =
                MvPowerSeries.coeff d (lcJetGrad2D h_ser S_ser C_ser α_ser r) := by
              unfold lcJetGrad2D lcJetEdgePlus2D lcJetEdgeMinus2D
              simp only [map_add, map_sub]
              have h_prod_eq : ∀ (A₁ A₂ B_ser : MvPowerSeries (Fin 2) ℂ),
