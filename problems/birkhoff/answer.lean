          field_simp [hne]
          ring
        rw [h_id]
        positivity
      let ψ : ℝ × ℝ → ℂ := fun p => Φ p.1 p.2
      have hψ_cont : Continuous ψ := by fun_prop
      have hψ_maps : Set.MapsTo ψ U2 (horizStrip Y) := fun p hp => hΦ_mem p.1 p.2 hp
      have hz_cont : ContinuousOn (fun p : ℝ × ℝ => z p.1 p.2) U2 := by
        have h1 : (fun p : ℝ × ℝ => z p.1 p.2) = f ∘ ψ := by funext p; exact hz_eq p.1 p.2
        rw [h1]
        exact hf_strip.continuousOn.comp hψ_cont.continuousOn hψ_maps
      have hw_cont : ContinuousOn (fun p : ℝ × ℝ => w p.1 p.2) U2 := by
        have h1 : (fun p : ℝ × ℝ => w p.1 p.2) = deriv f ∘ ψ := by funext p; exact hw_eq p.1 p.2
        rw [h1]
        exact hf1_strip.continuousOn.comp hψ_cont.continuousOn hψ_maps
      have hv_cont : ContinuousOn (fun p : ℝ × ℝ => v p.1 p.2) U2 := by
        have h1 : (fun p : ℝ × ℝ => v p.1 p.2) = deriv (deriv f) ∘ ψ := by
          funext p
          exact hv_eq p.1 p.2
        rw [h1]
        exact hf2_strip.continuousOn.comp hψ_cont.continuousOn hψ_maps
      have hz_re_c : ContinuousOn (fun p : ℝ × ℝ => (z p.1 p.2).re) U2 :=
        Complex.continuous_re.comp_continuousOn hz_cont
      have hz_im_c : ContinuousOn (fun p : ℝ × ℝ => (z p.1 p.2).im) U2 :=
        Complex.continuous_im.comp_continuousOn hz_cont
      have hw_re_c : ContinuousOn (fun p : ℝ × ℝ => (w p.1 p.2).re) U2 :=
        Complex.continuous_re.comp_continuousOn hw_cont
      have hw_im_c : ContinuousOn (fun p : ℝ × ℝ => (w p.1 p.2).im) U2 :=
        Complex.continuous_im.comp_continuousOn hw_cont
      have hv_re_c : ContinuousOn (fun p : ℝ × ℝ => (v p.1 p.2).re) U2 :=
        Complex.continuous_re.comp_continuousOn hv_cont
      have hv_im_c : ContinuousOn (fun p : ℝ × ℝ => (v p.1 p.2).im) U2 :=
        Complex.continuous_im.comp_continuousOn hv_cont
      have hS_cont : ContinuousOn (fun p : ℝ × ℝ => S p.1 p.2) U2 :=
        ((hz_re_c.pow 2).add (hz_im_c.pow 2)).add continuousOn_const
      have h2S_ne : ∀ p ∈ U2, 2 * S p.1 p.2 ≠ 0 := fun p _ => by linarith [hS_pos p.1 p.2]
      have h2S2_ne : ∀ p ∈ U2, 2 * (S p.1 p.2) ^ 2 ≠ 0 := fun p _ => by positivity
      have hu_cont : ContinuousOn (fun p : ℝ × ℝ => u p.1 p.2) U2 :=
        continuousOn_const.mul (hS_cont.log (fun p _ => (hS_pos p.1 p.2).ne'))
      have huxx_cont : ContinuousOn (fun p : ℝ × ℝ => u_xx p.1 p.2) U2 := by
        have hSx_c : ContinuousOn (fun p : ℝ × ℝ => S_x p.1 p.2) U2 :=
          continuousOn_const.mul ((hz_re_c.mul hw_re_c).add (hz_im_c.mul hw_im_c))
        have hSxx_c : ContinuousOn (fun p : ℝ × ℝ => S_xx p.1 p.2) U2 :=
          continuousOn_const.mul
            ((((hw_re_c.pow 2).add (hw_im_c.pow 2)).add (hz_re_c.mul hv_re_c)).add
              (hz_im_c.mul hv_im_c))
