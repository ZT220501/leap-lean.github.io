          ((fun g : ℂ → ℂ => deriv g)^[m] (fun t' : ℂ => iterDerivY α f₂ (q.1, t'))) t := by
      intro m
      induction m with
      | zero => intro t ht; exact hY α ht
      | succ m ih =>
        intro t ht
        rw [Function.iterate_succ_apply', Function.iterate_succ_apply']
