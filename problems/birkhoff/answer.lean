      exact ⟨hd_cont, hd_nonneg, hmass_le⟩
    have hq_sup : ∀ (K : Set ℂ) (d B : ℝ),
        IsCompact K → K.Nonempty → 0 < d → 0 < B →
        (∀ x : ℝ, ∀ Z ∈ K,
          (x : ℂ) + (S.H : ℂ) * Complex.I + (d : ℂ) * Z ∈ horizStrip S.H) →
        Continuous (fun x : ℝ =>
          sSup ((fun Z : ℂ =>
            d * Real.sqrt ‖S.q ((x : ℂ) + (S.H : ℂ) * Complex.I + (d : ℂ) * Z)‖) '' K)) ∧
        (∀ x : ℝ,
          0 ≤ min 1 (sSup ((fun Z : ℂ =>
            (d / B) ^ 2 * ‖S.q ((x : ℂ) + (S.H : ℂ) * Complex.I + (d : ℂ) * Z)‖) '' K)) ∧
          min 1 (sSup ((fun Z : ℂ =>
            (d / B) ^ 2 * ‖S.q ((x : ℂ) + (S.H : ℂ) * Complex.I + (d : ℂ) * Z)‖) '' K)) ≤
            B⁻¹ * sSup ((fun Z : ℂ =>
              d * Real.sqrt ‖S.q ((x : ℂ) + (S.H : ℂ) * Complex.I + (d : ℂ) * Z)‖) '' K)) := by
      intro K d B hK_comp hK_ne hd_pos hB_pos h_in_strip
      have : CompactSpace ↥K := isCompact_iff_compactSpace.mp hK_comp
      let Φ_K : ℝ × ↥K → ℂ := fun p =>
        (p.1 : ℂ) + (S.H : ℂ) * Complex.I + (d : ℂ) * (p.2 : ℂ)
      have hΦK_cont : Continuous Φ_K := by dsimp [Φ_K]; fun_prop
      have hqK_cont : Continuous (fun p : ℝ × ↥K => S.q (Φ_K p)) :=
        S.q_holo.continuousOn.comp_continuous hΦK_cont (fun p => h_in_strip p.1 p.2.1 p.2.2)
      have hgK_cont : Continuous (Function.uncurry (fun (x : ℝ) (z : ↥K) =>
          d * Real.sqrt ‖S.q (Φ_K (x, z))‖)) :=
        continuous_const.mul (Real.continuous_sqrt.comp (continuous_norm.comp hqK_cont))
      have hsup_sub : Continuous (fun x : ℝ =>
          sSup ((fun z : ↥K => d * Real.sqrt ‖S.q (Φ_K (x, z))‖) '' Set.univ)) := by
        simpa only [Set.image_eta] using isCompact_univ.continuous_sSup hgK_cont
      have himg_eq : (fun x : ℝ =>
          sSup ((fun Z : ℂ =>
            d * Real.sqrt ‖S.q ((x : ℂ) + (S.H : ℂ) * Complex.I + (d : ℂ) * Z)‖) '' K)) =
          (fun x : ℝ =>
            sSup ((fun z : ↥K => d * Real.sqrt ‖S.q (Φ_K (x, z))‖) '' Set.univ)) := by
        ext x; congr 1; ext y; simp [Φ_K]
      refine ⟨himg_eq.symm ▸ hsup_sub, ?_⟩
      intro x
      let f_tr : ℂ → ℝ := fun Z =>
        (d / B) ^ 2 * ‖S.q ((x : ℂ) + (S.H : ℂ) * Complex.I + (d : ℂ) * Z)‖
      let f_raw : ℂ → ℝ := fun Z =>
        d * Real.sqrt ‖S.q ((x : ℂ) + (S.H : ℂ) * Complex.I + (d : ℂ) * Z)‖
      have hq_x_cont : ContinuousOn (fun Z : ℂ =>
          S.q ((x : ℂ) + (S.H : ℂ) * Complex.I + (d : ℂ) * Z)) K :=
        S.q_holo.continuousOn.comp
          ((continuous_const.add (continuous_const.mul continuous_id)).continuousOn)
          (fun Z hZ => h_in_strip x Z hZ)
      have htr_bdd : BddAbove (f_tr '' K) :=
        (hK_comp.image_of_continuousOn
          (continuousOn_const.mul (continuous_norm.comp_continuousOn hq_x_cont))).bddAbove
      have hraw_bdd : BddAbove (f_raw '' K) :=
        (hK_comp.image_of_continuousOn
          (continuousOn_const.mul (Real.continuous_sqrt.comp_continuousOn
            (continuous_norm.comp_continuousOn hq_x_cont)))).bddAbove
      obtain ⟨Z₀, hZ₀⟩ := hK_ne
      have htr_nn : 0 ≤ sSup (f_tr '' K) :=
        le_trans (by dsimp [f_tr]; positivity) (le_csSup htr_bdd ⟨Z₀, hZ₀, rfl⟩)
      have hraw_nn : 0 ≤ sSup (f_raw '' K) :=
        le_trans (by dsimp [f_raw]; positivity) (le_csSup hraw_bdd ⟨Z₀, hZ₀, rfl⟩)
      refine ⟨le_min zero_le_one htr_nn, ?_⟩
      let u : ℝ := B⁻¹ * sSup (f_raw '' K)
      have hu_nn : 0 ≤ u := mul_nonneg (inv_nonneg.mpr (le_of_lt hB_pos)) hraw_nn
      have htr_le_sq : sSup (f_tr '' K) ≤ u ^ 2 := by
        have htr_ne : (f_tr '' K).Nonempty := ⟨f_tr Z₀, ⟨Z₀, hZ₀, rfl⟩⟩
        apply csSup_le htr_ne
        rintro y ⟨Z, hZ, rfl⟩
        have hZ_le : f_raw Z ≤ sSup (f_raw '' K) := le_csSup hraw_bdd ⟨Z, hZ, rfl⟩
        have hZ_nn : 0 ≤ f_raw Z := by dsimp [f_raw]; positivity
        have hdiv_le : B⁻¹ * f_raw Z ≤ u :=
          mul_le_mul_of_nonneg_left hZ_le (inv_nonneg.mpr (le_of_lt hB_pos))
        have htr_eq : f_tr Z = (B⁻¹ * f_raw Z) ^ 2 := by
          dsimp [f_tr, f_raw]
          have hsq : Real.sqrt ‖S.q ((x : ℂ) + (S.H : ℂ) * Complex.I + (d : ℂ) * Z)‖ ^ 2 =
              ‖S.q ((x : ℂ) + (S.H : ℂ) * Complex.I + (d : ℂ) * Z)‖ :=
            Real.sq_sqrt (norm_nonneg _)
