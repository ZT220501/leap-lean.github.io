    have hb_m : IsRealJetPerturb p J_R.C_jet_R
        (fun x => J_R.b_R w (x + ρ + d (j + 1) x)
          (-(2 * Real.pi / (q : ℝ) + (d (j + 1) x - d j x)))) :=
      hJet_congr (fun x => by congr 1; ring) hb_m_raw
    have hg₁ : IsRealJetPerturb p (1 / 2)
        (fun x => ((q : ℝ) / (4 * Real.pi)) *
          ((d (j + 2) x - d (j + 1) x) + (d (j + 1) x - d j x))) := by
      have hsum_τ := hJet_add (hd.2.2.2.2 (j + 1) hj) (hd.2.2.2.2 j (by omega))
      have hmul_τ := hJet_const_mul ((q : ℝ) / (4 * Real.pi)) hsum_τ
      refine hJet_mono ?_ hmul_τ
      rw [abs_of_pos (div_pos hq_pos (by positivity))]
      have h_eq : ((q : ℝ) / (4 * Real.pi)) * (R / (q : ℝ) ^ 3 + R / (q : ℝ) ^ 3) =
          R / (2 * Real.pi * (q : ℝ) ^ 2) := by
        field_simp [hq_nz, hpi_nz]
        ring
      rw [h_eq, div_le_div_iff₀ (by positivity) (by norm_num : (0 : ℝ) < 2)]
      nlinarith [Real.pi_gt_three, sq_nonneg ((q : ℝ) - 1)]
    have hg₂ : IsRealJetPerturb p (1 / 2)
        (fun x => 8 *
