        have hy_n : walkPos ρ om n ∈ Ω_reg := h_walk_reg om n
        have h_sup_le : Finset.univ.sup' Finset.univ_nonempty
            (fun i : Fin P.N => ‖sliceAngleSeq S P.N i.val (walkPos ρ om n)‖) ≤ M ^ ρ₁ :=
          Finset.sup'_le _ _ fun i _ => h_ang_le_ρ₁ n hn i
        have hd0_le : ‖P.d0 k (walkPos ρ om n)‖ ≤ B₀ := by
          refine le_trans (hStrip.odd_cycle_d0_bound _ hy_n k) ?_
          dsimp only [B₀]
          nlinarith [hN_pos]
        have h_sin_le : ‖Complex.sin (P.d0 k (walkPos ρ om n))‖ ≤ Real.exp B₀ :=
          le_trans (h_euler_sin _) (Real.exp_le_exp.mpr hd0_le)
        have h_sin_pos : 0 < ‖Complex.sin (P.d0 k (walkPos ρ om n))‖ :=
          norm_pos_iff.mpr (P.reg_sin_d0_ne_zero _ hy_n k)
        simpa only [Real.log_exp] using Real.log_le_log h_sin_pos h_sin_le
      rcases h_viol with h_ang_gt | h_sin_abs_gt
      · exfalso
        have h_le : ‖sliceAngleSeq S P.N j_bad.val (walkPos ρ om m_bad)‖ ≤ M ^ ρ₂ :=
          le_trans (h_ang_le_ρ₁ m_bad hm_bad_le j_bad) hM_ρ₁_le_ρ₂
        linarith
      · have h_up : Real.log ‖Complex.sin (P.d0 j_bad (walkPos ρ om m_bad))‖ ≤ M ^ ρ₂ :=
          le_trans (h_log_sin_upper m_bad hm_bad_le j_bad) hB₀_le_ρ₂
        have h_low : Real.log ‖Complex.sin (P.d0 j_bad (walkPos ρ om m_bad))‖ < -M ^ ρ₂ := by
          rcases lt_abs.mp h_sin_abs_gt with h1 | h2
          · linarith
          · linarith
        exact Set.mem_biUnion (Finset.mem_univ j_bad)
          ⟨m_bad, hm_bad_le,
            fun l hl => h_log_sin_upper l (le_trans hl.le hm_bad_le) j_bad, h_low⟩
  calc
    walkMeasure.real {om : WalkSpace |
        ∃ m ≤ sliceStopTau S P ρ M om, ∃ j : Fin P.N,
          M ^ ρ₂ < ‖sliceAngleSeq S P.N j.val (walkPos ρ om m)‖ ∨
          M ^ ρ₂ < |Real.log ‖Complex.sin (P.d0 j (walkPos ρ om m))‖|}
        ≤ walkMeasure.real
            (E_ang_bad ∪ (⋃ j ∈ (Finset.univ : Finset (Fin P.N)), E_sin j)) :=
          MeasureTheory.measureReal_mono h_target_sub
    _ ≤ walkMeasure.real E_ang_bad +
          walkMeasure.real (⋃ j ∈ (Finset.univ : Finset (Fin P.N)), E_sin j) :=
        MeasureTheory.measureReal_union_le _ _
    _ ≤ δ / 2 + δ / 2 := add_le_add hE_ang_bad_le hE_sin_union_le
    _ = δ := by ring

theorem hysteresis_switches_and_masked_martingales (S : FiniteWallNonisotropicStrip)
    (hBudget : CriticalAngleBudgetData S) (P : OddPeriodicSliceData S)
    (C_clk ρ₂ γ η b δ : ℝ)
    (hStrip : StripAngleAndAmplitudeData S hBudget P)
    (hBase : WalkBaseAndStopProp S P C_clk)
    (hρ₂_pos : 0 < ρ₂) (hρ₂_lt : ρ₂ < γ) (hγ_lt : γ < 1)
    (hη_pos : 0 < η) (hb_pos : 0 < b) (hδ_pos : 0 < δ) :
    ∃ M₂ : ℝ, 2 ≤ M₂ ∧
      ∀ M : ℝ, M₂ ≤ M →
        ∀ ρ : ℂ → ℝ, IsScaleAdmissibleStep S P M ρ →
          walkMeasure.real {om : WalkSpace |
            M ^ (1 + η - γ) <
              (sliceJointSwitches S P (b * M ^ γ) (walkPos ρ om)
                (sliceStopTau S P ρ M om) : ℝ) ∨
            ∃ m ≤ sliceStopTau S P ρ M om, ∃ j : Fin P.N,
              (∃ ι : Fin 2,
                (1 / 2 : ℝ) * Real.exp (6 * (b * M ^ γ)) <
                  ‖sliceModPosMart S P (b * M ^ γ) (M ^ ρ₂) j ι (walkPos ρ om) m‖) ∨
              Real.exp (-(b * M ^ γ) / 3) <
                ‖sliceTinySupMart S P (b * M ^ γ) (M ^ ρ₂) j (walkPos ρ om) m‖} ≤ δ :=
by
  classical
  have hSH_pos : 0 < S.H := S.H_pos
  have hSc_pos : 0 < S.c := S.c_pos
  
  
  
  have hProbUnif : MeasureTheory.IsProbabilityMeasure unifTwoPiMeasure := by
    refine ⟨?_⟩
    simp only [unifTwoPiMeasure, MeasureTheory.Measure.smul_apply,
      MeasureTheory.Measure.restrict_apply_univ, smul_eq_mul, Real.volume_Ico, sub_zero]
    exact ENNReal.inv_mul_cancel
      (ENNReal.ofReal_pos.mpr Real.two_pi_pos).ne' ENNReal.ofReal_ne_top
  have hProbWalk : MeasureTheory.IsProbabilityMeasure walkMeasure := by
    dsimp only [walkMeasure]
    infer_instance
  let A₀ : Set WalkSpace := {om : WalkSpace | om 0 ∈ Set.Ico (0 : ℝ) (2 * Real.pi)}
  have hA₀_meas : MeasurableSet A₀ :=
    measurableSet_Ico.preimage (measurable_pi_apply 0)
  have hA₀_compl_null : walkMeasure A₀ᶜ = 0 := by
    have h_pre : A₀ᶜ = (fun om : WalkSpace => om 0) ⁻¹' (Set.Ico (0 : ℝ) (2 * Real.pi))ᶜ := rfl
    rw [h_pre, ← MeasureTheory.Measure.map_apply (measurable_pi_apply 0) measurableSet_Ico.compl]
    have h_eval : walkMeasure.map (fun om : WalkSpace => om 0) = unifTwoPiMeasure :=
      MeasureTheory.Measure.infinitePi_map_eval (fun _ : ℕ => unifTwoPiMeasure) 0
    rw [h_eval]
    simp [unifTwoPiMeasure, MeasureTheory.Measure.restrict_apply measurableSet_Ico.compl]
  have hA₀_compl_real : walkMeasure.real A₀ᶜ = 0 := by
    simp [MeasureTheory.measureReal_def, hA₀_compl_null]

  
  
  
  have h_tiny_inv : ∀ (bG : ℝ) (j : Fin P.N) (y_seq : ℕ → ℂ) (n : ℕ),
      0 < bG →
      sliceIsTiny S P bG j y_seq n = true →
      Real.log ‖sliceSpeedSeq S P.N j.val (y_seq n)‖ < -bG := by
    intro bG j y_seq n hbG
    induction n with
    | zero =>
        simp [sliceIsTiny]
    | succ k _ =>
        simp only [sliceIsTiny]
        cases ht : sliceIsTiny S P bG j y_seq k
        · simp only [Bool.false_eq_true, ↓reduceIte]
          intro h_dec
          have h_le : Real.log ‖sliceSpeedSeq S P.N j.val (y_seq (k + 1))‖ ≤ -2 * bG :=
            of_decide_eq_true h_dec
          linarith
        · simp only [↓reduceIte]
          exact fun h_dec => of_decide_eq_true h_dec

  have h_mod_inv : ∀ (bG : ℝ) (j : Fin P.N) (y_seq : ℕ → ℂ) (n : ℕ),
      0 < bG →
      -2 * bG < Real.log ‖sliceSpeedSeq S P.N j.val (y_seq 0)‖ →
      sliceIsTiny S P bG j y_seq n = false →
      -2 * bG < Real.log ‖sliceSpeedSeq S P.N j.val (y_seq n)‖ := by
    intro bG j y_seq n hbG h0
    induction n with
    | zero =>
        intro _
        exact h0
    | succ k _ =>
        simp only [sliceIsTiny]
        cases ht : sliceIsTiny S P bG j y_seq k
        · simp only [Bool.false_eq_true, ↓reduceIte]
          intro h_dec
          have h_nle : ¬ (Real.log ‖sliceSpeedSeq S P.N j.val (y_seq (k + 1))‖ ≤ -2 * bG) :=
            of_decide_eq_false h_dec
          linarith
        · simp only [↓reduceIte]
          intro h_dec
          have h_nlt : ¬ (Real.log ‖sliceSpeedSeq S P.N j.val (y_seq (k + 1))‖ < -bG) :=
            of_decide_eq_false h_dec
          linarith

  have h_switches_le : ∀ (bG U_max C_init : ℝ) (y_seq : ℕ → ℂ) (K : ℕ),
      0 < bG → 0 ≤ U_max →
      (∀ j : Fin P.N, -C_init ≤ Real.log ‖sliceSpeedSeq S P.N j.val (y_seq 0)‖) →
      (∀ j : Fin P.N, Real.log ‖sliceSpeedSeq S P.N j.val (y_seq K)‖ ≤ U_max) →
      bG * (sliceJointSwitches S P bG y_seq K : ℝ) ≤
        2 * (∑ j : Fin P.N, ∑ n ∈ Finset.range K,
          if !sliceIsTiny S P bG j y_seq n then
            -Real.log ‖sliceSpeedSeq S P.N j.val (y_seq (n + 1))‖ +
              Real.log ‖sliceSpeedSeq S P.N j.val (y_seq n)‖
          else 0) +
        2 * (P.N : ℝ) * (U_max + C_init) := by
    intro bG U_max C_init y_seq K hbG hU_nn h_init_lo h_term_hi
    let a_seq : Fin P.N → ℕ → ℝ := fun j n =>
      Real.log ‖sliceSpeedSeq S P.N j.val (y_seq n)‖
    let t_seq : Fin P.N → ℕ → Bool := fun j n =>
      sliceIsTiny S P bG j y_seq n
    let M_hold : Fin P.N → ℕ → ℝ := fun j k =>
      ∑ n ∈ Finset.range k,
        if !t_seq j n then -a_seq j (n + 1) + a_seq j n else 0
    let S_all : Fin P.N → ℕ → ℝ := fun j k =>
      ∑ n ∈ Finset.range k,
        if t_seq j n ≠ t_seq j (n + 1) then (1 : ℝ) else 0
    have h_site : ∀ j : Fin P.N,
        bG * S_all j K ≤ 2 * M_hold j K + 2 * (U_max + C_init) := by
      intro j
      let Φ : ℕ → ℝ := fun k =>
        2 * M_hold j k - bG * S_all j k +
          (if t_seq j k then -bG else 2 * (a_seq j k + bG))
      have hΦ_mono : ∀ k : ℕ, Φ 0 ≤ Φ k := by
        intro k
        induction k with
        | zero => exact le_rfl
        | succ n ih =>
            refine le_trans ih ?_
            have hM_step : M_hold j (n + 1) = M_hold j n +
                (if !t_seq j n then -a_seq j (n + 1) + a_seq j n else 0) :=
              Finset.sum_range_succ _ n
            have hS_step : S_all j (n + 1) = S_all j n +
                (if t_seq j n ≠ t_seq j (n + 1) then (1 : ℝ) else 0) :=
              Finset.sum_range_succ _ n
            dsimp only [Φ]
            rw [hM_step, hS_step]
            have ht_succ : t_seq j (n + 1) =
                (if t_seq j n then decide (a_seq j (n + 1) < -bG)
                 else decide (a_seq j (n + 1) ≤ -2 * bG)) := rfl
            cases htn : t_seq j n <;> cases htn1 : t_seq j (n + 1)
            · simp only [Bool.not_false, Bool.false_eq_true, ↓reduceIte, ne_eq, not_true_eq_false]
              linarith
            · have h_dec : decide (a_seq j (n + 1) ≤ -2 * bG) = true := by
                simpa [htn, htn1] using ht_succ.symm
              have ha_le : a_seq j (n + 1) ≤ -2 * bG := of_decide_eq_true h_dec
              simp only [Bool.not_false, Bool.false_eq_true, ↓reduceIte, ne_eq, not_false_eq_true]
              linarith
            · have h_dec : decide (a_seq j (n + 1) < -bG) = false := by
                simpa [htn, htn1] using ht_succ.symm
              have ha_ge : ¬ (a_seq j (n + 1) < -bG) := of_decide_eq_false h_dec
              simp only [Bool.not_true, Bool.false_eq_true, Bool.true_eq_false, ↓reduceIte, ne_eq,
                not_false_eq_true]
              linarith
            · simp only [Bool.not_true, Bool.false_eq_true, ↓reduceIte, ne_eq, not_true_eq_false]
              linarith
      have hΦ0 : Φ 0 = 2 * (a_seq j 0 + bG) := by
        simp [Φ, M_hold, S_all, t_seq, sliceIsTiny]
      have hΦK := hΦ_mono K
      rw [hΦ0] at hΦK
      dsimp only [Φ] at hΦK
      have ha0 : -C_init ≤ a_seq j 0 := h_init_lo j
      have haK : a_seq j K ≤ U_max := h_term_hi j
      cases htK : t_seq j K
      · simp only [htK, Bool.false_eq_true, ↓reduceIte] at hΦK
        linarith
      · simp only [htK, ↓reduceIte] at hΦK
        linarith
    have h_card_le : (sliceJointSwitches S P bG y_seq K : ℝ) ≤ ∑ j : Fin P.N, S_all j K := by
      classical
      have h_sub :
          ((Finset.range K).filter fun n => ∃ j : Fin P.N, t_seq j n ≠ t_seq j (n + 1)) ⊆
          Finset.univ.biUnion (fun j : Fin P.N =>
            (Finset.range K).filter fun n => t_seq j n ≠ t_seq j (n + 1)) := by
        intro n hn
        simp only [Finset.mem_filter, Finset.mem_biUnion, Finset.mem_univ, true_and] at hn ⊢
        rcases hn with ⟨hn_r, j, hj⟩
        exact ⟨j, hn_r, hj⟩
      have h_nat : sliceJointSwitches S P bG y_seq K ≤
          ∑ j : Fin P.N, ((Finset.range K).filter fun n => t_seq j n ≠ t_seq j (n + 1)).card := by
        dsimp only [sliceJointSwitches]
        have h_fc : ((Finset.range K).filter fun n =>
              ∃ j : Fin P.N, sliceIsTiny S P bG j y_seq n ≠ sliceIsTiny S P bG j y_seq (n + 1)) =
            ((Finset.range K).filter fun n => ∃ j : Fin P.N, t_seq j n ≠ t_seq j (n + 1)) := by
          ext n; simp [t_seq]
        rw [h_fc]
        exact le_trans (Finset.card_le_card h_sub) Finset.card_biUnion_le
      calc
        (sliceJointSwitches S P bG y_seq K : ℝ)
          ≤ ((∑ j : Fin P.N,
              ((Finset.range K).filter fun n => t_seq j n ≠ t_seq j (n + 1)).card : ℕ) : ℝ) :=
            Nat.cast_le.mpr h_nat
        _ = ∑ j : Fin P.N, S_all j K := by
            push_cast
            refine Finset.sum_congr rfl fun j _ => ?_
            dsimp only [S_all]
            rw [Finset.card_filter, Nat.cast_sum]
            refine Finset.sum_congr rfl fun n _ => ?_
            split_ifs <;> simp
    calc
      bG * (sliceJointSwitches S P bG y_seq K : ℝ)
        ≤ bG * ∑ j : Fin P.N, S_all j K := mul_le_mul_of_nonneg_left h_card_le hbG.le
      _ = ∑ j : Fin P.N, bG * S_all j K := Finset.mul_sum _ _ _
      _ ≤ ∑ j : Fin P.N, (2 * M_hold j K + 2 * (U_max + C_init)) :=
          Finset.sum_le_sum fun j _ => h_site j
      _ = 2 * (∑ j : Fin P.N, M_hold j K) + 2 * (P.N : ℝ) * (U_max + C_init) := by
          rw [Finset.sum_add_distrib, ← Finset.mul_sum, Finset.sum_const, Finset.card_univ,
            Fintype.card_fin, nsmul_eq_mul]
          ring

  
  
  
  let h_sl : ℝ := sliceHeight S P.N
  let Ω_reg : Set ℂ := horizStrip h_sl \ P.Z_all
  have hN_pos : (0 : ℝ) < P.N := by
    exact_mod_cast lt_of_lt_of_le (by decide : 0 < 3) P.N_ge_three
  have ht₀_pos : 0 < sliceParamT0 P.N := div_pos Real.two_pi_pos hN_pos
  have ht₀_ball : (sliceParamT0 P.N : ℂ) ∈ Metric.ball (0 : ℂ) S.r_star := by
    rw [Metric.mem_ball, dist_zero_right, Complex.norm_real, Real.norm_eq_abs, abs_of_pos ht₀_pos]
    exact P.t₀_lt_r_star
  have hh_sl_pos : 0 < h_sl :=
    lt_of_lt_of_le S.s_star_pos (S.h_X_bounds _ ht₀_ball).1
  have h_horiz_open : ∀ r : ℝ, IsOpen (horizStrip r) := fun r =>
    isOpen_Iio.preimage (continuous_abs.comp Complex.continuous_im)
  have h_real_in_reg : ∀ x : ℝ, (x : ℂ) ∈ Ω_reg := fun x =>
    ⟨by simp [horizStrip, hh_sl_pos], P.real_not_mem_Z_all x⟩
  have h_pair_maps : ∀ k : ℤ,
      Set.MapsTo
        (fun z : ℂ => (z + (k : ℂ) * (sliceParamT0 P.N : ℂ), (sliceParamT0 P.N : ℂ)))
        (horizStrip h_sl) (finiteWallTube S.r_star S.h_X) := by
    intro k z hz
    have hz_lt : -h_sl < z.im ∧ z.im < h_sl := abs_lt.mp hz
    have ht₀_norm : ‖(sliceParamT0 P.N : ℂ)‖ < S.r_star := by
      simpa [Metric.mem_ball, dist_zero_right] using ht₀_ball
    refine ⟨ht₀_norm, ?_, ?_⟩
    · simpa [sliceHeight, h_sl] using hz_lt.1
    · simpa [sliceHeight, h_sl] using hz_lt.2
  have h_impact_holo : ∀ k : ℤ, DifferentiableOn ℂ (sliceImpactSeq S P.N k) (horizStrip h_sl) := by
    intro k
    have h_pair_diff :
        DifferentiableOn ℂ
          (fun z : ℂ => (z + (k : ℂ) * (sliceParamT0 P.N : ℂ), (sliceParamT0 P.N : ℂ)))
          (horizStrip h_sl) :=
      (differentiableOn_id.add (differentiableOn_const _)).prodMk (differentiableOn_const _)
    exact S.𝔰_holo.comp h_pair_diff (h_pair_maps k)
  have h_impact_maps : ∀ k : ℤ, ∀ z ∈ horizStrip h_sl,
      sliceImpactSeq S P.N k z ∈ horizStrip S.H := fun k z hz =>
    S.𝔰_maps_to _ (h_pair_maps k hz)
  have h_speed_holo : ∀ j : Fin P.N, DifferentiableOn ℂ (sliceSpeedSeq S P.N j.val) Ω_reg :=
    fun j => (S.f_holo.comp (h_impact_holo j.val) (h_impact_maps j.val)).mono Set.sdiff_subset
  have h_angle_holo : ∀ j : Fin P.N, DifferentiableOn ℂ (sliceAngleSeq S P.N j.val) Ω_reg :=
    fun j => (S.ϕ_holo.comp (h_impact_holo j.val) (h_impact_maps j.val)).mono Set.sdiff_subset
  have h_support_holo : ∀ j : Fin P.N, DifferentiableOn ℂ (sliceSupportSeq S P.N j.val) Ω_reg :=
    fun j => (S.H0_holo.comp (h_impact_holo j.val) (h_impact_maps j.val)).mono Set.sdiff_subset
  have h_pos_diffAt : ∀ (j : Fin P.N) (ι : Fin 2), ∀ y ∈ Ω_reg,
      DifferentiableAt ℂ (fun w => slicePosSeq S P.N j.val w ι) y := by
    intro j ι y hy
    have hs_in_H : sliceImpactSeq S P.N j.val y ∈ horizStrip S.H := h_impact_maps j.val y hy.1
    have hf_ne : S.f (sliceImpactSeq S P.N j.val y) ≠ 0 := P.reg_speed_ne_zero y hy j
    have h_imp_da : DifferentiableAt ℂ (sliceImpactSeq S P.N j.val) y :=
      (h_impact_holo j.val).differentiableAt ((h_horiz_open h_sl).mem_nhds hy.1)
    have hΓ_da := S.Γ_reg_holo _ hs_in_H hf_ne
    fin_cases ι
    · exact DifferentiableAt.comp y hΓ_da.1 h_imp_da
    · exact DifferentiableAt.comp y hΓ_da.2 h_imp_da
  have h_pos_holo : ∀ (j : Fin P.N) (ι : Fin 2),
      DifferentiableOn ℂ (fun w => slicePosSeq S P.N j.val w ι) Ω_reg :=
    fun j ι y hy => (h_pos_diffAt j ι y hy).differentiableWithinAt
  have h_pos_norm_cont : ∀ j : Fin P.N,
      ContinuousOn (fun w => ‖slicePosSeq S P.N j.val w‖) Ω_reg :=
    fun j => (continuousOn_pi.mpr fun ι => (h_pos_holo j ι).continuousOn).norm
  have h_logSpeed_cont : ∀ j : Fin P.N,
      ContinuousOn (fun y => Real.log ‖sliceSpeedSeq S P.N j.val y‖) Ω_reg :=
    fun j => (h_speed_holo j).continuousOn.norm.log fun y hy =>
      norm_ne_zero_iff.mpr (P.reg_speed_ne_zero y hy j)
  have h_logDepth_cont : ∀ j : Fin P.N, ContinuousOn (sliceLogDepth S P j) Ω_reg := by
    intro j
    have h_depth_cont : ContinuousOn (sliceShapeDepth S P j) Ω_reg :=
      continuousOn_const.sub
        (continuous_abs.comp_continuousOn
          (Complex.continuous_im.comp_continuousOn
            ((h_impact_holo j.val).continuousOn.mono Set.sdiff_subset)))
    refine (h_depth_cont.log fun y hy => ?_).neg
    have hs_H : |(sliceImpactSeq S P.N j.val y).im| < S.H := h_impact_maps j.val y hy.1
    dsimp [sliceShapeDepth]
    linarith

  
  have hIcc_ne : (Set.Icc (0 : ℝ) (2 * Real.pi)).Nonempty :=
    ⟨0, Set.left_mem_Icc.mpr Real.two_pi_pos.le⟩
  have h_init_each : ∀ j : Fin P.N, ∃ C_j : ℝ, 0 ≤ C_j ∧
      ∀ x ∈ Set.Icc (0 : ℝ) (2 * Real.pi),
        -C_j ≤ Real.log ‖sliceSpeedSeq S P.N j.val (x : ℂ)‖ ∧
        Real.log ‖sliceSpeedSeq S P.N j.val (x : ℂ)‖ ≤ C_j := by
    intro j
    have h_cont_abs : Continuous (fun x : ℝ =>
        |Real.log ‖sliceSpeedSeq S P.N j.val (x : ℂ)‖|) :=
      ((h_logSpeed_cont j).comp_continuous Complex.continuous_ofReal h_real_in_reg).abs
    obtain ⟨x_m, _, hx_m⟩ := isCompact_Icc.exists_isMaxOn hIcc_ne h_cont_abs.continuousOn
    exact ⟨|Real.log ‖sliceSpeedSeq S P.N j.val (x_m : ℂ)‖|, abs_nonneg _,
      fun x hx => abs_le.mp (hx_m hx)⟩
  choose C_init_fn hC_init_nn hC_init_bd using h_init_each
  let C_init : ℝ := Finset.univ.sup' Finset.univ_nonempty C_init_fn
  have hC_init_ge : 0 ≤ C_init := by
    obtain ⟨j₀, hj₀⟩ := (Finset.univ_nonempty : (Finset.univ : Finset (Fin P.N)).Nonempty)
    exact le_trans (hC_init_nn j₀) (Finset.le_sup' C_init_fn hj₀)
  have hC_init_real : ∀ x ∈ Set.Icc (0 : ℝ) (2 * Real.pi), ∀ j : Fin P.N,
      -C_init ≤ Real.log ‖sliceSpeedSeq S P.N j.val (x : ℂ)‖ ∧
      Real.log ‖sliceSpeedSeq S P.N j.val (x : ℂ)‖ ≤ C_init := by
    intro x hx j
    have h_le : C_init_fn j ≤ C_init := Finset.le_sup' C_init_fn (Finset.mem_univ j)
    have h_bd := hC_init_bd j x hx
    exact ⟨by linarith, by linarith⟩

  
  obtain ⟨C_f, hC_f_ge_one, h_speed_cap⟩ := hStrip.speed_amp_cap

  
  have h_adm_cball : ∀ {M : ℝ} {ρ : ℂ → ℝ}, IsScaleAdmissibleStep S P M ρ →
      ∀ y ∈ Ω_reg, ρ y ≤ 1 / 100 ∧ Metric.closedBall y (ρ y) ⊆ Ω_reg := by
    intro M ρ hAdm y hy
    have hρ_pos : 0 < ρ y := (hAdm.pos_iff y).mpr hy
    have h_le := hAdm.le_sing_dist y
    have hρ_100 : ρ y ≤ 1 / 100 := by
      have : min 1 (sliceSingDist S P y) ≤ 1 := min_le_left _ _
      linarith
    have hρ_sing : ρ y ≤ (1 / 100 : ℝ) * sliceSingDist S P y := by
      have : min 1 (sliceSingDist S P y) ≤ sliceSingDist S P y := min_le_right _ _
      linarith
    refine ⟨hρ_100, fun ζ hζ => ?_⟩
    rw [Metric.mem_closedBall, dist_comm] at hζ
    by_contra h_not
    have h_inf : sliceSingDist S P y ≤ dist y ζ := Metric.infDist_le_dist_of_mem h_not
    linarith

  have h_depth_speed_upper : ∀ {M : ℝ} {ρ : ℂ → ℝ}, IsScaleAdmissibleStep S P M ρ →
      ∀ y ∈ Ω_reg, ∀ z : ℂ, ‖z‖ ≤ ρ y → ∀ j : Fin P.N,
        sliceLogDepth S P j y ≤ M →
        Real.log ‖sliceSpeedSeq S P.N j.val (y + z)‖ ≤ C_f * (M + 2) := by
    intro M ρ hAdm y hy z hz j h_ld
    have hM2 : 2 ≤ M := hAdm.scale_ge_two
    have hyz_reg : y + z ∈ Ω_reg := by
      apply (h_adm_cball hAdm y hy).2
      simpa [Metric.mem_closedBall, dist_eq_norm] using hz
    let d_y := sliceShapeDepth S P j y
    let d_yz := sliceShapeDepth S P j (y + z)
    have hd_y_pos : 0 < d_y := by
      have hs_H : |(sliceImpactSeq S P.N j.val y).im| < S.H := h_impact_maps j.val y hy.1
      dsimp [d_y, sliceShapeDepth]; linarith
    have h_exp_M : Real.exp (-M) ≤ d_y := by
      have h_log_ge : -M ≤ Real.log d_y := by
        dsimp [sliceLogDepth, d_y] at h_ld; linarith
      simpa [Real.exp_log hd_y_pos] using Real.exp_le_exp.mpr h_log_ge
    have h_step := hAdm.small_shape_step y hy z hz j
    have h_im_diff : |(sliceImpactSeq S P.N j.val (y + z)).im| -
        |(sliceImpactSeq S P.N j.val y).im| ≤ Real.exp (-M ^ 2) * d_y := by
      calc
        |(sliceImpactSeq S P.N j.val (y + z)).im| - |(sliceImpactSeq S P.N j.val y).im|
          ≤ |(sliceImpactSeq S P.N j.val (y + z)).im - (sliceImpactSeq S P.N j.val y).im| :=
            abs_sub_abs_le_abs_sub _ _
        _ = |(sliceImpactSeq S P.N j.val (y + z) - sliceImpactSeq S P.N j.val y).im| := by simp
        _ ≤ ‖sliceImpactSeq S P.N j.val (y + z) - sliceImpactSeq S P.N j.val y‖ :=
            Complex.abs_im_le_norm _
        _ ≤ Real.exp (-M ^ 2) * d_y := h_step
    have hd_yz_ge : (1 - Real.exp (-M ^ 2)) * d_y ≤ d_yz := by
      dsimp [d_y, d_yz, sliceShapeDepth] at h_im_diff ⊢
      linarith
    have he_neg1 : Real.exp (-1) ≤ 1 / 2 := by
      have he1 : 2 ≤ Real.exp 1 := by linarith [Real.add_one_le_exp (1 : ℝ)]
      have h_mul : Real.exp (-1) * Real.exp 1 ≤ (1 / 2 : ℝ) * Real.exp 1 := by
        rw [← Real.exp_add]; norm_num; linarith
      exact le_of_mul_le_mul_right h_mul (Real.exp_pos 1)
    have he_negM2 : Real.exp (-M ^ 2) ≤ 1 / 5 := by
      have he4 : 5 ≤ Real.exp 4 := by linarith [Real.add_one_le_exp (4 : ℝ)]
      have he_neg4 : Real.exp (-4) ≤ 1 / 5 := by
        have h_mul : Real.exp (-4) * Real.exp 4 ≤ (1 / 5 : ℝ) * Real.exp 4 := by
          rw [← Real.exp_add]; norm_num; linarith
        exact le_of_mul_le_mul_right h_mul (Real.exp_pos 4)
      exact le_trans (Real.exp_le_exp.mpr (by nlinarith)) he_neg4
    have hd_yz_exp : Real.exp (-(M + 1)) ≤ d_yz := by
      have h_fac : Real.exp (-1) ≤ 1 - Real.exp (-M ^ 2) := by linarith
      calc
        Real.exp (-(M + 1))
          = Real.exp (-1) * Real.exp (-M) := by rw [← Real.exp_add]; ring_nf
        _ ≤ (1 - Real.exp (-M ^ 2)) * d_y :=
            mul_le_mul h_fac h_exp_M (Real.exp_pos _).le (by linarith)
        _ ≤ d_yz := hd_yz_ge
    have hd_yz_pos : 0 < d_yz := lt_of_lt_of_le (Real.exp_pos _) hd_yz_exp
    have h_log_dyz : -Real.log d_yz ≤ M + 1 := by
      have := Real.log_le_log (Real.exp_pos _) hd_yz_exp
      rw [Real.log_exp] at this
      linarith
    have h_max_le : max (-Real.log d_yz) 0 ≤ M + 1 :=
      max_le h_log_dyz (by linarith)
    have hs_yz : sliceImpactSeq S P.N j.val (y + z) ∈ horizStrip S.H :=
      h_impact_maps j.val (y + z) hyz_reg.1
    have hf_cap := h_speed_cap _ hs_yz
    have hf_le : ‖sliceSpeedSeq S P.N j.val (y + z)‖ ≤ Real.exp (C_f * (M + 2)) := by
      refine le_trans hf_cap (Real.exp_le_exp.mpr ?_)
      change C_f * (1 + max (-Real.log d_yz) 0) ≤ C_f * (M + 2)
      nlinarith
    have hf_pos : 0 < ‖sliceSpeedSeq S P.N j.val (y + z)‖ :=
      norm_pos_iff.mpr (P.reg_speed_ne_zero _ hyz_reg j)
    simpa only [Real.log_exp] using Real.log_le_log hf_pos hf_le

  
  have h_avg_logSpeed : ∀ {M : ℝ} {ρ : ℂ → ℝ}, IsScaleAdmissibleStep S P M ρ →
      ∀ j : Fin P.N, ∀ y ∈ Ω_reg,
        Real.circleAverage (fun w => Real.log ‖sliceSpeedSeq S P.N j.val w‖) y (ρ y) =
          Real.log ‖sliceSpeedSeq S P.N j.val y‖ := by
    intro M ρ hAdm j y hy
    have hr : 0 ≤ ρ y := hAdm.nonneg y
    have hcb : Metric.closedBall y |ρ y| ⊆ Ω_reg := by
      simpa [abs_of_nonneg hr] using (h_adm_cball hAdm y hy).2
    have h_ana : AnalyticOnNhd ℂ (sliceSpeedSeq S P.N j.val) (Metric.closedBall y |ρ y|) :=
      ((h_speed_holo j).analyticOnNhd P.reg_open).mono hcb
    exact h_ana.circleAverage_log_norm_of_ne_zero fun z hz => P.reg_speed_ne_zero z (hcb hz) j

  have h_avg_pos : ∀ {M : ℝ} {ρ : ℂ → ℝ}, IsScaleAdmissibleStep S P M ρ →
      ∀ (j : Fin P.N) (ι : Fin 2), ∀ y ∈ Ω_reg,
        Real.circleAverage (fun w => slicePosSeq S P.N j.val w ι) y (ρ y) =
          slicePosSeq S P.N j.val y ι := by
    intro M ρ hAdm j ι y hy
    have hr : 0 ≤ ρ y := hAdm.nonneg y
    have hcb : Metric.closedBall y |ρ y| ⊆ Ω_reg := by
      simpa [abs_of_nonneg hr] using (h_adm_cball hAdm y hy).2
    exact circleAverage_of_differentiable_on_off_countable Set.countable_empty
      ((h_pos_holo j ι).continuousOn.mono hcb) fun z hz =>
        h_pos_diffAt j ι z (hcb (Metric.ball_subset_closedBall hz.1))

  have h_avg_support : ∀ {M : ℝ} {ρ : ℂ → ℝ}, IsScaleAdmissibleStep S P M ρ →
      ∀ j : Fin P.N, ∀ y ∈ Ω_reg,
        Real.circleAverage (sliceSupportSeq S P.N j.val) y (ρ y) =
          sliceSupportSeq S P.N j.val y := by
    intro M ρ hAdm j y hy
    have hr : 0 ≤ ρ y := hAdm.nonneg y
    have hcb : Metric.closedBall y |ρ y| ⊆ Ω_reg := by
      simpa [abs_of_nonneg hr] using (h_adm_cball hAdm y hy).2
    exact circleAverage_of_differentiable_on_off_countable Set.countable_empty
      ((h_support_holo j).continuousOn.mono hcb) fun z hz =>
        (h_support_holo j).differentiableAt
          (P.reg_open.mem_nhds (hcb (Metric.ball_subset_closedBall hz.1)))

  
  have h_sin_le : ∀ w : ℂ, ‖Complex.sin w‖ ≤ Real.exp ‖w‖ := by
    intro w
    rw [Complex.sin, norm_div, norm_mul, Complex.norm_I, mul_one, RCLike.norm_ofNat]
    have h1 : ‖Complex.exp (-w * Complex.I)‖ ≤ Real.exp ‖w‖ := by
      rw [Complex.norm_exp]
      apply Real.exp_le_exp.mpr
      have hre : (-w * Complex.I).re = w.im := by simp
      rw [hre]
      exact le_trans (le_abs_self _) (Complex.abs_im_le_norm w)
    have h2 : ‖Complex.exp (w * Complex.I)‖ ≤ Real.exp ‖w‖ := by
      rw [Complex.norm_exp]
      apply Real.exp_le_exp.mpr
      have hre : (w * Complex.I).re = -w.im := by simp
      rw [hre]
      exact le_trans (neg_le_abs _) (Complex.abs_im_le_norm w)
    have h_sub := norm_sub_le (Complex.exp (-w * Complex.I)) (Complex.exp (w * Complex.I))
    linarith

  have h_cos_le : ∀ w : ℂ, ‖Complex.cos w‖ ≤ Real.exp ‖w‖ := by
    intro w
    rw [Complex.cos, norm_div, RCLike.norm_ofNat]
    have h1 : ‖Complex.exp (w * Complex.I)‖ ≤ Real.exp ‖w‖ := by
      rw [Complex.norm_exp]
      apply Real.exp_le_exp.mpr
      have hre : (w * Complex.I).re = -w.im := by simp
      rw [hre]
      exact le_trans (neg_le_abs _) (Complex.abs_im_le_norm w)
    have h2 : ‖Complex.exp (-w * Complex.I)‖ ≤ Real.exp ‖w‖ := by
      rw [Complex.norm_exp]
      apply Real.exp_le_exp.mpr
      have hre : (-w * Complex.I).re = w.im := by simp
      rw [hre]
      exact le_trans (le_abs_self _) (Complex.abs_im_le_norm w)
    have h_add := norm_add_le (Complex.exp (w * Complex.I)) (Complex.exp (-w * Complex.I))
    linarith

  have h_imp_lin_le : ∀ {M : ℝ} {ρ : ℂ → ℝ}, IsScaleAdmissibleStep S P M ρ →
      ∀ y ∈ Ω_reg, ∀ z : ℂ, ‖z‖ ≤ ρ y → ∀ j : Fin P.N,
        ‖deriv (sliceImpactSeq S P.N j.val) y * z‖ ≤
          ‖sliceImpactSeq S P.N j.val (y + z) - sliceImpactSeq S P.N j.val y‖ +
            (1 / 2 : ℝ) * Real.exp (-M ^ 3) * ρ y := by
    intro M ρ hAdm y hy z hz j
    let ds := sliceImpactSeq S P.N j.val (y + z) - sliceImpactSeq S P.N j.val y
    let lin := deriv (sliceImpactSeq S P.N j.val) y * z
    have h_tay : ‖ds - lin‖ ≤ (1 / 2 : ℝ) * Real.exp (-M ^ 3) * ρ y :=
      hAdm.taylor_impact y hy z hz j
    have h_eq : lin = ds - (ds - lin) := by ring
    calc
      ‖lin‖ = ‖ds - (ds - lin)‖ := congrArg norm h_eq
      _ ≤ ‖ds‖ + ‖ds - lin‖ := norm_sub_le _ _
      _ ≤ ‖ds‖ + (1 / 2 : ℝ) * Real.exp (-M ^ 3) * ρ y := by linarith

  have h_mod_step_sq : ∀ {M bG r_star : ℝ} {ρ : ℂ → ℝ}, IsScaleAdmissibleStep S P M ρ →
      S.c * Real.exp r_star ≤ (1 / 2 : ℝ) * Real.exp bG →
      5 * bG ≤ M ^ 3 →
      ∀ y ∈ Ω_reg, ∀ z : ℂ, ‖z‖ ≤ ρ y → ∀ (j : Fin P.N) (ι : Fin 2),
        ‖sliceAngleSeq S P.N j.val y‖ ≤ r_star →
        -2 * bG < Real.log ‖sliceSpeedSeq S P.N j.val y‖ →
        ‖slicePosSeq S P.N j.val (y + z) ι - slicePosSeq S P.N j.val y ι‖ ^ 2 ≤
          (1 / 2 : ℝ) * Real.exp (10 * bG) *
            ‖sliceImpactSeq S P.N j.val (y + z) - sliceImpactSeq S P.N j.val y‖ ^ 2 +
          (1 / 2 : ℝ) * (ρ y) ^ 2 := by
    intro M bG r_star ρ hAdm hc_le h5bG y hy z hz j ι h_ang h_mod
    have hM2 : 2 ≤ M := hAdm.scale_ge_two
    have hρ_nn : 0 ≤ ρ y := hAdm.nonneg y
    have hf_pos : 0 < ‖sliceSpeedSeq S P.N j.val y‖ :=
      norm_pos_iff.mpr (P.reg_speed_ne_zero y hy j)
    have hf_gt : Real.exp (-2 * bG) < ‖sliceSpeedSeq S P.N j.val y‖ := by
      simpa [Real.exp_log hf_pos] using Real.exp_lt_exp.mpr h_mod
    have hf_inv_le : ‖sliceSpeedSeq S P.N j.val y‖⁻¹ ≤ Real.exp (2 * bG) := by
      have h_mul : ‖sliceSpeedSeq S P.N j.val y‖⁻¹ * ‖sliceSpeedSeq S P.N j.val y‖ ≤
          Real.exp (2 * bG) * ‖sliceSpeedSeq S P.N j.val y‖ := by
        rw [inv_mul_cancel₀ hf_pos.ne']
        calc
          (1 : ℝ) = Real.exp (2 * bG) * Real.exp (-2 * bG) := by rw [← Real.exp_add]; norm_num
          _ ≤ Real.exp (2 * bG) * ‖sliceSpeedSeq S P.N j.val y‖ :=
              mul_le_mul_of_nonneg_left hf_gt.le (Real.exp_pos _).le
      exact le_of_mul_le_mul_right h_mul hf_pos
    have hf_inv_sq : ‖(sliceSpeedSeq S P.N j.val y)⁻¹ ^ 2‖ ≤ Real.exp (4 * bG) := by
      rw [norm_pow, norm_inv]
      calc
        (‖sliceSpeedSeq S P.N j.val y‖⁻¹) ^ 2
          ≤ (Real.exp (2 * bG)) ^ 2 := pow_le_pow_left₀ (by positivity) hf_inv_le 2
        _ = Real.exp (4 * bG) := by rw [sq, ← Real.exp_add]; ring_nf
    have h_deriv_coeff :
        ‖deriv (fun w => slicePosSeq S P.N j.val w ι) y * z‖ ≤
          (1 / 2 : ℝ) * Real.exp (5 * bG) * ‖deriv (sliceImpactSeq S P.N j.val) y * z‖ := by
      have h_trig : ‖if ι = 0 then Complex.sin (sliceAngleSeq S P.N j.val y)
          else Complex.cos (sliceAngleSeq S P.N j.val y)‖ ≤ Real.exp r_star := by
        split_ifs
        · exact le_trans (h_sin_le _) (Real.exp_le_exp.mpr h_ang)
        · exact le_trans (h_cos_le _) (Real.exp_le_exp.mpr h_ang)
      have h_dp := P.reg_deriv_pos y hy j
      have h_norm_dp : ‖deriv (fun w => slicePosSeq S P.N j.val w ι) y * z‖ ≤
          S.c * Real.exp (4 * bG) * Real.exp r_star *
            ‖deriv (sliceImpactSeq S P.N j.val) y * z‖ := by
        fin_cases ι
        · change ‖deriv (fun w => slicePosSeq S P.N j.val w 0) y * z‖ ≤ _
          rw [h_dp.1]
          have h_sin_r : ‖Complex.sin (sliceAngleSeq S P.N j.val y)‖ ≤ Real.exp r_star := by
            simpa using h_trig
          calc
            ‖-(S.c : ℂ) * (sliceSpeedSeq S P.N j.val y)⁻¹ ^ 2 *
                Complex.sin (sliceAngleSeq S P.N j.val y) *
                deriv (sliceImpactSeq S P.N j.val) y * z‖
              = ‖(S.c : ℂ)‖ * ‖(sliceSpeedSeq S P.N j.val y)⁻¹ ^ 2‖ *
                  ‖Complex.sin (sliceAngleSeq S P.N j.val y)‖ *
                  ‖deriv (sliceImpactSeq S P.N j.val) y * z‖ := by
                rw [mul_assoc _ (deriv _ y) z, norm_mul, norm_mul, norm_mul, norm_neg]
            _ = S.c * ‖(sliceSpeedSeq S P.N j.val y)⁻¹ ^ 2‖ *
                  ‖Complex.sin (sliceAngleSeq S P.N j.val y)‖ *
                  ‖deriv (sliceImpactSeq S P.N j.val) y * z‖ := by
                rw [Complex.norm_real, Real.norm_of_nonneg S.c_pos.le]
            _ ≤ S.c * Real.exp (4 * bG) * Real.exp r_star *
                  ‖deriv (sliceImpactSeq S P.N j.val) y * z‖ := by
                refine mul_le_mul_of_nonneg_right ?_ (norm_nonneg _)
                exact mul_le_mul
                  (mul_le_mul_of_nonneg_left hf_inv_sq S.c_pos.le)
                  h_sin_r (norm_nonneg _) (by positivity)
        · change ‖deriv (fun w => slicePosSeq S P.N j.val w 1) y * z‖ ≤ _
          rw [h_dp.2]
          have h_cos_r : ‖Complex.cos (sliceAngleSeq S P.N j.val y)‖ ≤ Real.exp r_star := by
            simpa using h_trig
          calc
            ‖(S.c : ℂ) * (sliceSpeedSeq S P.N j.val y)⁻¹ ^ 2 *
                Complex.cos (sliceAngleSeq S P.N j.val y) *
                deriv (sliceImpactSeq S P.N j.val) y * z‖
              = S.c * ‖(sliceSpeedSeq S P.N j.val y)⁻¹ ^ 2‖ *
                  ‖Complex.cos (sliceAngleSeq S P.N j.val y)‖ *
                  ‖deriv (sliceImpactSeq S P.N j.val) y * z‖ := by
                rw [mul_assoc _ (deriv _ y) z, norm_mul, norm_mul, norm_mul,
                  Complex.norm_real, Real.norm_of_nonneg S.c_pos.le]
            _ ≤ S.c * Real.exp (4 * bG) * Real.exp r_star *
                  ‖deriv (sliceImpactSeq S P.N j.val) y * z‖ := by
                refine mul_le_mul_of_nonneg_right ?_ (norm_nonneg _)
                exact mul_le_mul
                  (mul_le_mul_of_nonneg_left hf_inv_sq S.c_pos.le)
                  h_cos_r (norm_nonneg _) (by positivity)
      refine le_trans h_norm_dp ?_
      have h_coeff : S.c * Real.exp (4 * bG) * Real.exp r_star ≤ (1 / 2 : ℝ) * Real.exp (5 * bG) := by
        calc
          S.c * Real.exp (4 * bG) * Real.exp r_star
            = (S.c * Real.exp r_star) * Real.exp (4 * bG) := by ring
          _ ≤ ((1 / 2 : ℝ) * Real.exp bG) * Real.exp (4 * bG) :=
              mul_le_mul_of_nonneg_right hc_le (Real.exp_pos _).le
          _ = (1 / 2 : ℝ) * Real.exp (5 * bG) := by
              rw [mul_assoc, ← Real.exp_add]; ring_nf
      exact mul_le_mul_of_nonneg_right h_coeff (norm_nonneg _)
    have h_tay_pos :
        ‖slicePosSeq S P.N j.val (y + z) ι - slicePosSeq S P.N j.val y ι -
            deriv (fun w => slicePosSeq S P.N j.val w ι) y * z‖ ≤
          (1 / 4 : ℝ) * Real.exp (-M ^ 3) * ρ y := by
      fin_cases ι
      · exact hAdm.taylor_pos₀ y hy z hz j
      · exact hAdm.taylor_pos₁ y hy z hz j
    let dX := slicePosSeq S P.N j.val (y + z) ι - slicePosSeq S P.N j.val y ι
    let linX := deriv (fun w => slicePosSeq S P.N j.val w ι) y * z
    let ds := sliceImpactSeq S P.N j.val (y + z) - sliceImpactSeq S P.N j.val y
    have hdX_eq : dX = linX + (dX - linX) := by ring
    have he1 : Real.exp (5 * bG) * Real.exp (-M ^ 3) ≤ 1 := by
      rw [← Real.exp_add]
      exact Real.exp_le_one_iff.mpr (by linarith)
    have he2 : Real.exp (-M ^ 3) ≤ 1 := by
      have hM3_nn : 0 ≤ M ^ 3 := by positivity
      exact Real.exp_le_one_iff.mpr (by linarith)
    have h_imp_lin := h_imp_lin_le hAdm y hy z hz j
    have hdX_norm : ‖dX‖ ≤ (1 / 2 : ℝ) * Real.exp (5 * bG) * ‖ds‖ + (1 / 2 : ℝ) * ρ y := by
      have h1 : ‖dX‖ ≤ ‖linX‖ + ‖dX - linX‖ :=
        (congrArg norm hdX_eq).trans_le (norm_add_le linX (dX - linX))
      have h2 : (1 / 2 : ℝ) * Real.exp (5 * bG) *
          (‖ds‖ + (1 / 2 : ℝ) * Real.exp (-M ^ 3) * ρ y) +
          (1 / 4 : ℝ) * Real.exp (-M ^ 3) * ρ y ≤
          (1 / 2 : ℝ) * Real.exp (5 * bG) * ‖ds‖ + (1 / 2 : ℝ) * ρ y := by
        have h_p1 : (Real.exp (5 * bG) * Real.exp (-M ^ 3)) * ρ y ≤ 1 * ρ y :=
          mul_le_mul_of_nonneg_right he1 hρ_nn
        have h_p2 : Real.exp (-M ^ 3) * ρ y ≤ 1 * ρ y :=
          mul_le_mul_of_nonneg_right he2 hρ_nn
        linarith
      have h3 : ‖linX‖ ≤ (1 / 2 : ℝ) * Real.exp (5 * bG) *
          (‖ds‖ + (1 / 2 : ℝ) * Real.exp (-M ^ 3) * ρ y) :=
        le_trans h_deriv_coeff (mul_le_mul_of_nonneg_left h_imp_lin (by positivity))
      linarith
    calc
      ‖dX‖ ^ 2
        ≤ ((1 / 2 : ℝ) * Real.exp (5 * bG) * ‖ds‖ + (1 / 2 : ℝ) * ρ y) ^ 2 :=
          pow_le_pow_left₀ (norm_nonneg _) hdX_norm 2
      _ ≤ 2 * ((1 / 2 : ℝ) * Real.exp (5 * bG) * ‖ds‖) ^ 2 +
            2 * ((1 / 2 : ℝ) * ρ y) ^ 2 := by
          nlinarith [sq_nonneg ((1 / 2 : ℝ) * Real.exp (5 * bG) * ‖ds‖ - (1 / 2 : ℝ) * ρ y)]
      _ = (1 / 2 : ℝ) * (Real.exp (5 * bG)) ^ 2 * ‖ds‖ ^ 2 + (1 / 2 : ℝ) * (ρ y) ^ 2 := by ring
      _ = (1 / 2 : ℝ) * Real.exp (10 * bG) * ‖ds‖ ^ 2 + (1 / 2 : ℝ) * (ρ y) ^ 2 := by
          rw [sq (Real.exp (5 * bG)), ← Real.exp_add]; ring_nf

  have h_tiny_step_linear : ∀ {M bG r_star R : ℝ} {ρ : ℂ → ℝ}, IsScaleAdmissibleStep S P M ρ →
      ∀ y ∈ Ω_reg, ∀ z : ℂ, ‖z‖ ≤ ρ y → ∀ j : Fin P.N,
        1 + ‖slicePosSeq S P.N j.val y‖ ≤ R →
        ‖sliceAngleSeq S P.N j.val y‖ ≤ r_star →
        Real.log ‖sliceSpeedSeq S P.N j.val y‖ < -bG →
        ‖(R : ℂ)⁻¹ *
            (sliceSupportSeq S P.N j.val (y + z) - sliceSupportSeq S P.N j.val y)‖ ≤
          2 * Real.exp (r_star - bG) *
            ‖sliceImpactSeq S P.N j.val (y + z) - sliceImpactSeq S P.N j.val y‖ +
          (Real.exp (r_star - bG) + 1 / 2) * Real.exp (-M ^ 3) * ρ y := by
    intro M bG r_star R ρ hAdm y hy z hz j hR h_ang h_tiny
    have hR_pos : 0 < R := lt_of_lt_of_le (by positivity) hR
    have hρ_nn : 0 ≤ ρ y := hAdm.nonneg y
    have hf_pos : 0 < ‖sliceSpeedSeq S P.N j.val y‖ :=
      norm_pos_iff.mpr (P.reg_speed_ne_zero y hy j)
    have hf_le : ‖sliceSpeedSeq S P.N j.val y‖ ≤ Real.exp (-bG) := by
      exact le_of_lt (by simpa [Real.exp_log hf_pos] using Real.exp_lt_exp.mpr h_tiny)
    have hs_in_H : sliceImpactSeq S P.N j.val y ∈ horizStrip S.H := h_impact_maps j.val y hy.1
    have h_imp_da : DifferentiableAt ℂ (sliceImpactSeq S P.N j.val) y :=
      (h_impact_holo j.val).differentiableAt ((h_horiz_open h_sl).mem_nhds hy.1)
    have h_ϕ_da : DifferentiableAt ℂ S.ϕ (sliceImpactSeq S P.N j.val y) :=
      S.ϕ_holo.differentiableAt ((h_horiz_open S.H).mem_nhds hs_in_H)
    have h_ang_deriv : deriv (sliceAngleSeq S P.N j.val) y =
        sliceSpeedSeq S P.N j.val y * deriv (sliceImpactSeq S P.N j.val) y := by
      change deriv (S.ϕ ∘ sliceImpactSeq S P.N j.val) y = _
      rw [deriv_comp y h_ϕ_da h_imp_da, S.deriv_ϕ _ hs_in_H]
      rfl
    have hX0_le : ‖slicePosSeq S P.N j.val y 0‖ ≤ R :=
      le_trans (norm_le_pi_norm (slicePosSeq S P.N j.val y) 0) (by linarith)
    have hX1_le : ‖slicePosSeq S P.N j.val y 1‖ ≤ R :=
      le_trans (norm_le_pi_norm (slicePosSeq S P.N j.val y) 1) (by linarith)
    have h_sin_r : ‖Complex.sin (sliceAngleSeq S P.N j.val y)‖ ≤ Real.exp r_star :=
      le_trans (h_sin_le _) (Real.exp_le_exp.mpr h_ang)
    have h_cos_r : ‖Complex.cos (sliceAngleSeq S P.N j.val y)‖ ≤ Real.exp r_star :=
      le_trans (h_cos_le _) (Real.exp_le_exp.mpr h_ang)
    have h_comb_le :
        ‖-slicePosSeq S P.N j.val y 0 * Complex.sin (sliceAngleSeq S P.N j.val y) +
            slicePosSeq S P.N j.val y 1 * Complex.cos (sliceAngleSeq S P.N j.val y)‖ ≤
          2 * R * Real.exp r_star := by
      have ht1 : ‖-slicePosSeq S P.N j.val y 0 * Complex.sin (sliceAngleSeq S P.N j.val y)‖ ≤
          R * Real.exp r_star := by
        rw [norm_mul, norm_neg]
        exact mul_le_mul hX0_le h_sin_r (norm_nonneg _) hR_pos.le
      have ht2 : ‖slicePosSeq S P.N j.val y 1 * Complex.cos (sliceAngleSeq S P.N j.val y)‖ ≤
          R * Real.exp r_star := by
        rw [norm_mul]
        exact mul_le_mul hX1_le h_cos_r (norm_nonneg _) hR_pos.le
      have h_add := norm_add_le
        (-slicePosSeq S P.N j.val y 0 * Complex.sin (sliceAngleSeq S P.N j.val y))
        (slicePosSeq S P.N j.val y 1 * Complex.cos (sliceAngleSeq S P.N j.val y))
      linarith
    have h_sup_lin :
        ‖deriv (sliceSupportSeq S P.N j.val) y * z‖ ≤
          2 * R * Real.exp (r_star - bG) * ‖deriv (sliceImpactSeq S P.N j.val) y * z‖ := by
      have h_eq_d : deriv (sliceSupportSeq S P.N j.val) y * z =
          (-slicePosSeq S P.N j.val y 0 * Complex.sin (sliceAngleSeq S P.N j.val y) +
            slicePosSeq S P.N j.val y 1 * Complex.cos (sliceAngleSeq S P.N j.val y)) *
          (sliceSpeedSeq S P.N j.val y * (deriv (sliceImpactSeq S P.N j.val) y * z)) := by
        rw [P.reg_deriv_support y hy j, h_ang_deriv]; ring
      rw [h_eq_d, norm_mul, norm_mul]
      calc
        ‖-slicePosSeq S P.N j.val y 0 * Complex.sin (sliceAngleSeq S P.N j.val y) +
            slicePosSeq S P.N j.val y 1 * Complex.cos (sliceAngleSeq S P.N j.val y)‖ *
          (‖sliceSpeedSeq S P.N j.val y‖ * ‖deriv (sliceImpactSeq S P.N j.val) y * z‖)
          ≤ (2 * R * Real.exp r_star) *
              (Real.exp (-bG) * ‖deriv (sliceImpactSeq S P.N j.val) y * z‖) := by
            refine mul_le_mul h_comb_le ?_ (by positivity) (by positivity)
            exact mul_le_mul_of_nonneg_right hf_le (norm_nonneg _)
        _ = 2 * R * (Real.exp r_star * Real.exp (-bG)) *
              ‖deriv (sliceImpactSeq S P.N j.val) y * z‖ := by ring
        _ = 2 * R * Real.exp (r_star - bG) *
              ‖deriv (sliceImpactSeq S P.N j.val) y * z‖ := by
            rw [← Real.exp_add, sub_eq_add_neg]
    let dH := sliceSupportSeq S P.N j.val (y + z) - sliceSupportSeq S P.N j.val y
    let linH := deriv (sliceSupportSeq S P.N j.val) y * z
    let ds := sliceImpactSeq S P.N j.val (y + z) - sliceImpactSeq S P.N j.val y
    have h_tay_sup : ‖dH - linH‖ ≤ (1 / 2 : ℝ) * R * Real.exp (-M ^ 3) * ρ y := by
      refine le_trans (hAdm.taylor_support y hy z hz j) ?_
      exact mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hR (by norm_num))
          (Real.exp_pos _).le) hρ_nn
    have hdH_eq : dH = linH + (dH - linH) := by ring
    have h_imp_lin := h_imp_lin_le hAdm y hy z hz j
    have hdH_norm :
        ‖dH‖ ≤ R * (2 * Real.exp (r_star - bG) * ‖ds‖ +
          (Real.exp (r_star - bG) + 1 / 2) * Real.exp (-M ^ 3) * ρ y) := by
      have h1 : ‖dH‖ ≤ ‖linH‖ + ‖dH - linH‖ :=
        (congrArg norm hdH_eq).trans_le (norm_add_le linH (dH - linH))
      have h2 : ‖linH‖ ≤ 2 * R * Real.exp (r_star - bG) *
          (‖ds‖ + (1 / 2 : ℝ) * Real.exp (-M ^ 3) * ρ y) :=
        le_trans h_sup_lin (mul_le_mul_of_nonneg_left h_imp_lin (by positivity))
      linarith
    rw [norm_mul, norm_inv, Complex.norm_real, Real.norm_of_nonneg hR_pos.le]
    calc
      R⁻¹ * ‖dH‖
        ≤ R⁻¹ * (R * (2 * Real.exp (r_star - bG) * ‖ds‖ +
            (Real.exp (r_star - bG) + 1 / 2) * Real.exp (-M ^ 3) * ρ y)) :=
          mul_le_mul_of_nonneg_left hdH_norm (inv_nonneg.mpr hR_pos.le)
      _ = 2 * Real.exp (r_star - bG) * ‖ds‖ +
            (Real.exp (r_star - bG) + 1 / 2) * Real.exp (-M ^ 3) * ρ y :=
          inv_mul_cancel_left₀ hR_pos.ne' _

  have h_tiny_step_norm : ∀ {M bG r_star R : ℝ} {ρ : ℂ → ℝ}, IsScaleAdmissibleStep S P M ρ →
      ∀ y ∈ Ω_reg, ∀ z : ℂ, ‖z‖ ≤ ρ y → ∀ j : Fin P.N,
        1 + ‖slicePosSeq S P.N j.val y‖ ≤ R →
        ‖sliceAngleSeq S P.N j.val y‖ ≤ r_star →
        Real.log ‖sliceSpeedSeq S P.N j.val y‖ < -bG →
        ‖(R : ℂ)⁻¹ *
            (sliceSupportSeq S P.N j.val (y + z) - sliceSupportSeq S P.N j.val y)‖ ≤
          2 * Real.exp (r_star - bG) * (S.H + 1) + 1 := by
    intro M bG r_star R ρ hAdm y hy z hz j hR h_ang h_tiny
    have hM2 : 2 ≤ M := hAdm.scale_ge_two
    have h_lin := h_tiny_step_linear hAdm y hy z hz j hR h_ang h_tiny
    have hρ_le_one : ρ y ≤ 1 := le_trans (h_adm_cball hAdm y hy).1 (by norm_num)
    have hρ_nn : 0 ≤ ρ y := hAdm.nonneg y
    have heM2 : Real.exp (-M ^ 2) ≤ 1 := Real.exp_le_one_iff.mpr (by nlinarith)
    have heM3 : Real.exp (-M ^ 3) ≤ 1 := by
      have hM3_nn : 0 ≤ M ^ 3 := by positivity
      exact Real.exp_le_one_iff.mpr (by linarith)
    have hd_le_H : sliceShapeDepth S P j y ≤ S.H := by
      dsimp [sliceShapeDepth]; linarith [abs_nonneg (sliceImpactSeq S P.N j.val y).im]
    have hd_nn : 0 ≤ sliceShapeDepth S P j y := by
      have hs_H : |(sliceImpactSeq S P.N j.val y).im| < S.H := h_impact_maps j.val y hy.1
      dsimp [sliceShapeDepth]; linarith
    have hds_le : ‖sliceImpactSeq S P.N j.val (y + z) - sliceImpactSeq S P.N j.val y‖ ≤ S.H := by
      calc
        ‖sliceImpactSeq S P.N j.val (y + z) - sliceImpactSeq S P.N j.val y‖
          ≤ Real.exp (-M ^ 2) * sliceShapeDepth S P j y := hAdm.small_shape_step y hy z hz j
        _ ≤ 1 * S.H := mul_le_mul heM2 hd_le_H hd_nn zero_le_one
        _ = S.H := one_mul _
    have h_rem_le : (Real.exp (r_star - bG) + 1 / 2) * Real.exp (-M ^ 3) * ρ y ≤
        Real.exp (r_star - bG) + 1 / 2 := by
      have h_prod1 : Real.exp (-M ^ 3) * ρ y ≤ 1 :=
        le_trans (mul_le_mul heM3 hρ_le_one hρ_nn zero_le_one) (by norm_num)
      calc
        (Real.exp (r_star - bG) + 1 / 2) * Real.exp (-M ^ 3) * ρ y
          = (Real.exp (r_star - bG) + 1 / 2) * (Real.exp (-M ^ 3) * ρ y) := by ring
        _ ≤ (Real.exp (r_star - bG) + 1 / 2) * 1 :=
            mul_le_mul_of_nonneg_left h_prod1 (by positivity)
        _ = Real.exp (r_star - bG) + 1 / 2 := mul_one _
    have h_main_le :
        2 * Real.exp (r_star - bG) *
          ‖sliceImpactSeq S P.N j.val (y + z) - sliceImpactSeq S P.N j.val y‖ ≤
        2 * Real.exp (r_star - bG) * S.H :=
      mul_le_mul_of_nonneg_left hds_le (by positivity)
    have h_exp_pos : 0 < Real.exp (r_star - bG) := Real.exp_pos _
    linarith

  have h_tiny_step_sq : ∀ {M bG r_star R : ℝ} {ρ : ℂ → ℝ}, IsScaleAdmissibleStep S P M ρ →
      0 < bG →
      2 * Real.exp (r_star - bG) ≤ (1 / 2 : ℝ) * Real.exp (-bG / 2) →
      Real.exp (-M ^ 3) ≤ (1 / 2 : ℝ) * Real.exp (-bG / 2) →
      ∀ y ∈ Ω_reg, ∀ z : ℂ, ‖z‖ ≤ ρ y → ∀ j : Fin P.N,
        1 + ‖slicePosSeq S P.N j.val y‖ ≤ R →
        ‖sliceAngleSeq S P.N j.val y‖ ≤ r_star →
        Real.log ‖sliceSpeedSeq S P.N j.val y‖ < -bG →
        ‖(R : ℂ)⁻¹ *
            (sliceSupportSeq S P.N j.val (y + z) - sliceSupportSeq S P.N j.val y)‖ ^ 2 ≤
          Real.exp (-bG) *
            ((1 / 2 : ℝ) *
              ‖sliceImpactSeq S P.N j.val (y + z) - sliceImpactSeq S P.N j.val y‖ ^ 2 +
             (1 / 2 : ℝ) * (ρ y) ^ 2) := by
    intro M bG r_star R ρ hAdm hbG h_exp1 h_exp2 y hy z hz j hR h_ang h_tiny
    have hρ_nn : 0 ≤ ρ y := hAdm.nonneg y
    have h_lin := h_tiny_step_linear hAdm y hy z hz j hR h_ang h_tiny
    have he_half_le : Real.exp (-bG / 2) ≤ 1 :=
      Real.exp_le_one_iff.mpr (by linarith)
    have h_coeff_one : Real.exp (r_star - bG) + 1 / 2 ≤ 1 := by linarith
    let ds := sliceImpactSeq S P.N j.val (y + z) - sliceImpactSeq S P.N j.val y
    have h_step_half :
        ‖(R : ℂ)⁻¹ * (sliceSupportSeq S P.N j.val (y + z) - sliceSupportSeq S P.N j.val y)‖ ≤
          (1 / 2 : ℝ) * Real.exp (-bG / 2) * (‖ds‖ + ρ y) := by
      have ht1 : 2 * Real.exp (r_star - bG) * ‖ds‖ ≤
          (1 / 2 : ℝ) * Real.exp (-bG / 2) * ‖ds‖ :=
        mul_le_mul_of_nonneg_right h_exp1 (norm_nonneg _)
      have ht2 : (Real.exp (r_star - bG) + 1 / 2) * Real.exp (-M ^ 3) * ρ y ≤
          (1 / 2 : ℝ) * Real.exp (-bG / 2) * ρ y := by
        calc
          (Real.exp (r_star - bG) + 1 / 2) * Real.exp (-M ^ 3) * ρ y
            ≤ 1 * ((1 / 2 : ℝ) * Real.exp (-bG / 2)) * ρ y := by
              refine mul_le_mul_of_nonneg_right ?_ hρ_nn
              exact mul_le_mul h_coeff_one h_exp2 (Real.exp_pos _).le zero_le_one
          _ = (1 / 2 : ℝ) * Real.exp (-bG / 2) * ρ y := by ring
      linarith
    calc
      ‖(R : ℂ)⁻¹ * (sliceSupportSeq S P.N j.val (y + z) - sliceSupportSeq S P.N j.val y)‖ ^ 2
        ≤ ((1 / 2 : ℝ) * Real.exp (-bG / 2) * (‖ds‖ + ρ y)) ^ 2 :=
          pow_le_pow_left₀ (norm_nonneg _) h_step_half 2
      _ = (1 / 4 : ℝ) * (Real.exp (-bG / 2)) ^ 2 * (‖ds‖ + ρ y) ^ 2 := by ring
      _ ≤ (1 / 4 : ℝ) * (Real.exp (-bG / 2)) ^ 2 * (2 * ‖ds‖ ^ 2 + 2 * (ρ y) ^ 2) := by
          refine mul_le_mul_of_nonneg_left ?_ (by positivity)
          nlinarith [sq_nonneg (‖ds‖ - ρ y)]
      _ = (Real.exp (-bG / 2)) ^ 2 * ((1 / 2 : ℝ) * ‖ds‖ ^ 2 + (1 / 2 : ℝ) * (ρ y) ^ 2) := by ring
      _ = Real.exp (-bG) * ((1 / 2 : ℝ) * ‖ds‖ ^ 2 + (1 / 2 : ℝ) * (ρ y) ^ 2) := by
          rw [sq (Real.exp (-bG / 2)), ← Real.exp_add]; ring_nf

  
  
  
  let η₀ : ℝ := min η (min (γ - ρ₂) γ)
  have hη₀_pos : 0 < η₀ :=
    lt_min hη_pos (lt_min (sub_pos.mpr hρ₂_lt) (lt_trans hρ₂_pos hρ₂_lt))
  let C_log : ℝ := max 0 (Real.log (max 4 (2 * S.c)))
  have hC_log_nn : 0 ≤ C_log := le_max_left _ _
  have hlog2_pos : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hC_clk_pos : 0 < C_clk := hBase.C_clk_pos
  let D_big : ℝ :=
    1 + (C_init + 1) / b +
      6 * (P.N : ℝ) * (3 * C_f + 2 * C_init) / (b * δ) +
      (2 + 2 * C_log) / b +
      (5 * b + Real.log 2) +
      3 * (P.N : ℝ) * (4 * S.H ^ 2 + 2 * C_clk) / (b * δ) +
      9 * (P.N : ℝ) * (S.H ^ 2 + (1 / 2 : ℝ) * C_clk) / (b * δ)
  have hD_big_ge_one : 1 ≤ D_big := by
    have t1 : 0 ≤ (C_init + 1) / b := by positivity
    have t2 : 0 ≤ 6 * (P.N : ℝ) * (3 * C_f + 2 * C_init) / (b * δ) := by positivity
    have t3 : 0 ≤ (2 + 2 * C_log) / b := by positivity
    have t4 : 0 ≤ 5 * b + Real.log 2 := by positivity
    have t5 : 0 ≤ 3 * (P.N : ℝ) * (4 * S.H ^ 2 + 2 * C_clk) / (b * δ) := by positivity
    have t6 : 0 ≤ 9 * (P.N : ℝ) * (S.H ^ 2 + (1 / 2 : ℝ) * C_clk) / (b * δ) := by positivity
    dsimp [D_big]; linarith
  have hD_big_pos : 0 < D_big := lt_of_lt_of_le zero_lt_one hD_big_ge_one
  let ε_star : ℝ := D_big⁻¹
  have hε_star_pos : 0 < ε_star := inv_pos.mpr hD_big_pos
  have h_le_of_le_D : ∀ K_req : ℝ, K_req ≤ D_big → K_req * ε_star ≤ 1 := by
    intro K_req hK
    calc
      K_req * ε_star ≤ D_big * D_big⁻¹ :=
        mul_le_mul_of_nonneg_right hK (inv_nonneg.mpr hD_big_pos.le)
      _ = 1 := mul_inv_cancel₀ hD_big_pos.ne'
  have h_le_mul_of_div : ∀ {A B : ℝ}, 0 < B → A / B ≤ D_big → A * ε_star ≤ B := by
    intro A B hB hAB
    have hk : (A / B) * ε_star ≤ 1 := h_le_of_le_D (A / B) hAB
    calc
      A * ε_star = ((A / B) * ε_star) * B := by
        rw [div_eq_mul_inv, mul_right_comm (A * B⁻¹) ε_star B, mul_assoc A B⁻¹ B,
          inv_mul_cancel₀ hB.ne', mul_one]
      _ ≤ 1 * B := mul_le_mul_of_nonneg_right hk hB.le
      _ = B := one_mul B
  obtain ⟨M_eps, hM_eps⟩ :=
    Filter.eventually_atTop.mp
      ((tendsto_rpow_neg_atTop hη₀_pos).eventually (ge_mem_nhds hε_star_pos))
  refine ⟨max 2 M_eps, le_max_left _ _, ?_⟩
  intro M hM₂_le ρ hAdm
  have hM_ge_two : 2 ≤ M := le_trans (le_max_left _ _) hM₂_le
  have hMeps_le : M_eps ≤ M := le_trans (le_max_right _ _) hM₂_le
  have hM_pos : 0 < M := by linarith
  have hM_ge_one : 1 ≤ M := by linarith
  have hM_neg_η₀ : M ^ (-η₀) ≤ ε_star := hM_eps M hMeps_le
  have h_gap : ∀ α β : ℝ, α + η₀ ≤ β → M ^ α ≤ ε_star * M ^ β := by
    intro α β hαβ
    have h1 : M ^ (α - β) ≤ M ^ (-η₀) :=
      Real.rpow_le_rpow_of_exponent_le hM_ge_one (by linarith)
    have h2 : M ^ (α - β) ≤ ε_star := le_trans h1 hM_neg_η₀
    have h3 := mul_le_mul_of_nonneg_right h2 (Real.rpow_nonneg hM_pos.le β)
    rwa [← Real.rpow_add hM_pos, sub_add_cancel] at h3

  let G_scale : ℝ := M ^ γ
  let bG : ℝ := b * G_scale
  let r_star : ℝ := M ^ ρ₂
  have hγ_pos : 0 < γ := lt_trans hρ₂_pos hρ₂_lt
  have hG_ge_one : 1 ≤ G_scale := Real.one_le_rpow hM_ge_one hγ_pos.le
  have hbG_pos : 0 < bG := mul_pos hb_pos (lt_of_lt_of_le zero_lt_one hG_ge_one)
  have h_one_le_eps_G : 1 ≤ ε_star * G_scale := by
    have h0 : η₀ ≤ γ := le_trans (min_le_right _ _) (min_le_right _ _)
    simpa [G_scale] using h_gap 0 γ (by linarith)
  have hr_star_le_eps_G : r_star ≤ ε_star * G_scale := by
    have h1 : η₀ ≤ γ - ρ₂ := le_trans (min_le_right _ _) (min_le_left _ _)
    exact h_gap ρ₂ γ (by linarith)
  have hG_le_eps_M3 : G_scale ≤ ε_star * M ^ (3 : ℕ) := by
    have h1 : η₀ ≤ γ := le_trans (min_le_right _ _) (min_le_right _ _)
    have h_rpow : G_scale ≤ ε_star * M ^ (3 : ℝ) := h_gap γ 3 (by linarith)
    simpa [Real.rpow_natCast] using h_rpow
  have hM_neg_η : M ^ (-η) ≤ ε_star := by
    have h1 : η₀ ≤ η := min_le_left _ _
    exact le_trans (Real.rpow_le_rpow_of_exponent_le hM_ge_one (by linarith)) hM_neg_η₀

  
  have h_mod_init_cond : -2 * bG < -C_init := by
    have h_mul : (C_init + 1) * ε_star ≤ b := by
      apply h_le_mul_of_div hb_pos
      have t2 : 0 ≤ 6 * (P.N : ℝ) * (3 * C_f + 2 * C_init) / (b * δ) := by positivity
      have t3 : 0 ≤ (2 + 2 * C_log) / b := by positivity
      have t4 : 0 ≤ 5 * b + Real.log 2 := by positivity
      have t5 : 0 ≤ 3 * (P.N : ℝ) * (4 * S.H ^ 2 + 2 * C_clk) / (b * δ) := by positivity
      have t6 : 0 ≤ 9 * (P.N : ℝ) * (S.H ^ 2 + (1 / 2 : ℝ) * C_clk) / (b * δ) := by positivity
      dsimp [D_big]; linarith
    have hbG_ge : C_init + 1 ≤ bG := by
      calc
        C_init + 1 ≤ (C_init + 1) * (ε_star * G_scale) :=
          le_mul_of_one_le_right (by positivity) h_one_le_eps_G
        _ = ((C_init + 1) * ε_star) * G_scale := by ring
        _ ≤ b * G_scale := mul_le_mul_of_nonneg_right h_mul (by positivity)
    linarith

  have h_rstar_Clog_le : r_star + C_log ≤ bG / 2 := by
    have h_mul : (2 + 2 * C_log) * ε_star ≤ b := by
      apply h_le_mul_of_div hb_pos
      have t1 : 0 ≤ (C_init + 1) / b := by positivity
      have t2 : 0 ≤ 6 * (P.N : ℝ) * (3 * C_f + 2 * C_init) / (b * δ) := by positivity
      have t4 : 0 ≤ 5 * b + Real.log 2 := by positivity
      have t5 : 0 ≤ 3 * (P.N : ℝ) * (4 * S.H ^ 2 + 2 * C_clk) / (b * δ) := by positivity
      have t6 : 0 ≤ 9 * (P.N : ℝ) * (S.H ^ 2 + (1 / 2 : ℝ) * C_clk) / (b * δ) := by positivity
      dsimp [D_big]; linarith
    have ht1 : C_log ≤ C_log * (ε_star * G_scale) :=
      le_mul_of_one_le_right hC_log_nn h_one_le_eps_G
    have ht2 : ((2 + 2 * C_log) * ε_star) * G_scale ≤ b * G_scale :=
      mul_le_mul_of_nonneg_right h_mul (by positivity)
    dsimp [bG]
    linarith

  have h_Sc_exp_cond : S.c * Real.exp r_star ≤ (1 / 2 : ℝ) * Real.exp bG := by
    have h_2Sc : 2 * S.c ≤ Real.exp C_log := by
      have h_max_pos : 0 < max 4 (2 * S.c) := lt_of_lt_of_le (by norm_num) (le_max_left _ _)
      calc
        2 * S.c ≤ max 4 (2 * S.c) := le_max_right _ _
        _ = Real.exp (Real.log (max 4 (2 * S.c))) := (Real.exp_log h_max_pos).symm
        _ ≤ Real.exp C_log := Real.exp_le_exp.mpr (le_max_right _ _)
    have h_prod : 2 * S.c * Real.exp r_star ≤ Real.exp bG := by
      calc
        2 * S.c * Real.exp r_star
          ≤ Real.exp C_log * Real.exp r_star :=
            mul_le_mul_of_nonneg_right h_2Sc (Real.exp_pos _).le
        _ = Real.exp (r_star + C_log) := by rw [← Real.exp_add, add_comm]
        _ ≤ Real.exp bG := Real.exp_le_exp.mpr (by linarith)
    linarith

  have h_tiny_exp1_cond : 2 * Real.exp (r_star - bG) ≤ (1 / 2 : ℝ) * Real.exp (-bG / 2) := by
    have h_4 : (4 : ℝ) ≤ Real.exp C_log := by
      have h_max_pos : 0 < max 4 (2 * S.c) := lt_of_lt_of_le (by norm_num) (le_max_left _ _)
      calc
        (4 : ℝ) ≤ max 4 (2 * S.c) := le_max_left _ _
        _ = Real.exp (Real.log (max 4 (2 * S.c))) := (Real.exp_log h_max_pos).symm
        _ ≤ Real.exp C_log := Real.exp_le_exp.mpr (le_max_right _ _)
    have h_prod : 4 * Real.exp (r_star - bG) ≤ Real.exp (-bG / 2) := by
      calc
        4 * Real.exp (r_star - bG)
          ≤ Real.exp C_log * Real.exp (r_star - bG) :=
            mul_le_mul_of_nonneg_right h_4 (Real.exp_pos _).le
        _ = Real.exp (r_star + C_log - bG) := by rw [← Real.exp_add]; ring_nf
        _ ≤ Real.exp (-bG / 2) := Real.exp_le_exp.mpr (by linarith)
    linarith

  have h_5bG_M3_both : 5 * bG + Real.log 2 ≤ M ^ 3 := by
    have h_mul : (5 * b + Real.log 2) * ε_star ≤ 1 := by
      apply h_le_of_le_D
      have t1 : 0 ≤ (C_init + 1) / b := by positivity
      have t2 : 0 ≤ 6 * (P.N : ℝ) * (3 * C_f + 2 * C_init) / (b * δ) := by positivity
      have t3 : 0 ≤ (2 + 2 * C_log) / b := by positivity
      have t5 : 0 ≤ 3 * (P.N : ℝ) * (4 * S.H ^ 2 + 2 * C_clk) / (b * δ) := by positivity
      have t6 : 0 ≤ 9 * (P.N : ℝ) * (S.H ^ 2 + (1 / 2 : ℝ) * C_clk) / (b * δ) := by positivity
      dsimp [D_big]; linarith
    calc
      5 * bG + Real.log 2
        ≤ 5 * b * G_scale + Real.log 2 * G_scale := by
          dsimp [bG]
          linarith [le_mul_of_one_le_right hlog2_pos.le hG_ge_one]
      _ = (5 * b + Real.log 2) * G_scale := by ring
      _ ≤ (5 * b + Real.log 2) * (ε_star * M ^ 3) :=
          mul_le_mul_of_nonneg_left hG_le_eps_M3 (by positivity)
      _ = ((5 * b + Real.log 2) * ε_star) * M ^ 3 := by ring
      _ ≤ 1 * M ^ 3 := mul_le_mul_of_nonneg_right h_mul (by positivity)
      _ = M ^ 3 := one_mul _

  have h_5bG_cond : 5 * bG ≤ M ^ 3 := by linarith
  have h_tiny_exp2_cond : Real.exp (-M ^ 3) ≤ (1 / 2 : ℝ) * Real.exp (-bG / 2) := by
    have h_arg : -M ^ 3 ≤ -Real.log 2 + (-bG / 2) := by linarith
    calc
      Real.exp (-M ^ 3)
        ≤ Real.exp (-Real.log 2 + (-bG / 2)) := Real.exp_le_exp.mpr h_arg
      _ = (Real.exp (Real.log 2))⁻¹ * Real.exp (-bG / 2) := by
          rw [Real.exp_add, Real.exp_neg]
      _ = (1 / 2 : ℝ) * Real.exp (-bG / 2) := by
          rw [Real.exp_log (by norm_num : (0 : ℝ) < 2)]; norm_num

  
  
  
  have hρ_meas : Measurable ρ := hAdm.measurable
  have hρ_nn : ∀ y : ℂ, 0 ≤ ρ y := hAdm.nonneg
  have h_walk_reg : ∀ om : WalkSpace, ∀ k : ℕ, walkPos ρ om k ∈ Ω_reg :=
    fun om k => (hBase.walk_in_reg M ρ hAdm om k).1
  have h_cball : ∀ y ∈ Ω_reg, Metric.closedBall y (ρ y) ⊆ Ω_reg :=
    fun y hy => (h_adm_cball hAdm y hy).2

  let prefDet : ∀ {α : Type}, ℕ → (WalkSpace → α) → Prop :=
    fun n F => ∀ om₁ om₂ : WalkSpace, (∀ k ≤ n, om₁ k = om₂ k) → F om₁ = F om₂

  have h_walk_mp : ∀ m : ℕ,
      Measurable (fun om : WalkSpace => walkPos ρ om m) ∧
      prefDet m (fun om : WalkSpace => walkPos ρ om m) := by
    intro m
    induction m with
    | zero =>
        refine ⟨Complex.measurable_ofReal.comp (measurable_pi_apply 0), ?_⟩
        intro om₁ om₂ h_eq
        simp [walkPos, h_eq 0 le_rfl]
    | succ n ih =>
        rcases ih with ⟨hm_n, hp_n⟩
        have h_exp : Measurable (fun om : WalkSpace =>
            Complex.exp ((om (n + 1) : ℂ) * Complex.I)) :=
          Complex.continuous_exp.measurable.comp
            ((Complex.measurable_ofReal.comp (measurable_pi_apply (n + 1))).mul measurable_const)
        refine ⟨hm_n.add ((Complex.measurable_ofReal.comp (hρ_meas.comp hm_n)).mul h_exp), ?_⟩
        intro om₁ om₂ h_eq
        have hn_eq : walkPos ρ om₁ n = walkPos ρ om₂ n :=
          hp_n om₁ om₂ fun k hk => h_eq k (Nat.le_succ_of_le hk)
        simp [walkPos, hn_eq, h_eq (n + 1) le_rfl]

  have h_obs : ∀ {E : Type} [TopologicalSpace E] [MeasurableSpace E] [BorelSpace E]
      (F : ℂ → E) (m : ℕ),
      ContinuousOn F Ω_reg →
      Measurable (fun om : WalkSpace => F (walkPos ρ om m)) ∧
      prefDet m (fun om : WalkSpace => F (walkPos ρ om m)) := by
    intro E _ _ _ F m hF
    have h_dom : Continuous (Ω_reg.domRestrict F) :=
      continuousOn_iff_continuous_domRestrict.mp hF
    have h_sub : Measurable (fun om : WalkSpace =>
        (⟨walkPos ρ om m, h_walk_reg om m⟩ : Ω_reg)) :=
      (h_walk_mp m).1.subtype_mk
    refine ⟨h_dom.measurable.comp h_sub, ?_⟩
    intro om₁ om₂ h_eq
    exact congrArg F ((h_walk_mp m).2 om₁ om₂ h_eq)

  have h_decide_meas : ∀ (p : WalkSpace → Prop) {inst : DecidablePred p},
      MeasurableSet {om : WalkSpace | p om} →
      Measurable (fun om => @decide (p om) (inst om)) := by
    intro p inst hp
    refine measurable_to_countable' fun b_val => ?_
    cases b_val
    · have : (fun om => @decide (p om) (inst om)) ⁻¹' {false} = {om | p om}ᶜ := by
        ext om; simp
      rw [this]; exact hp.compl
    · have : (fun om => @decide (p om) (inst om)) ⁻¹' {true} = {om | p om} := by
        ext om; simp
      rw [this]; exact hp

  let extZero : (n : ℕ) → (Finset.range (n + 1) → ℝ) → WalkSpace :=
    fun n u k => if hk : k ∈ Finset.range (n + 1) then u ⟨k, hk⟩ else 0
  have h_extZero_meas : ∀ n : ℕ, Measurable (extZero n) := by
    intro n
    refine Measurable.of_eval fun k => ?_
    by_cases hk : k ∈ Finset.range (n + 1)
    · simp only [extZero, dif_pos hk]
      exact measurable_pi_apply (⟨k, hk⟩ : Finset.range (n + 1))
    · simp only [extZero, dif_neg hk]
      exact measurable_const
  have h_extZero_restrict : ∀ (n : ℕ) (om : WalkSpace) (k : ℕ), k ≤ n →
      extZero n ((Finset.range (n + 1)).restrict om) k = om k := by
    intro n om k hk
    have hk' : k ∈ Finset.range (n + 1) := Finset.mem_range.mpr (Nat.lt_succ_of_le hk)
    dsimp only [extZero]
    rw [dif_pos hk']
    rfl

  have h_one_step_complex : ∀ (n : ℕ) (C : ℝ) (Φ : WalkSpace → ℂ) (H : ℂ → ℂ),
      0 ≤ C →
      Measurable Φ → prefDet n Φ →
      ContinuousOn H Ω_reg →
      (∀ y ∈ Ω_reg, Real.circleAverage H y (ρ y) = H y) →
      (∀ om : WalkSpace,
        ‖Φ om * (H (walkPos ρ om (n + 1)) - H (walkPos ρ om n))‖ ≤ C) →
      MeasureTheory.Integrable
        (fun om : WalkSpace => Φ om * (H (walkPos ρ om (n + 1)) - H (walkPos ρ om n)))
        walkMeasure ∧
      (∫ om, Φ om * (H (walkPos ρ om (n + 1)) - H (walkPos ρ om n)) ∂walkMeasure) = 0 := by
    intro n C Φ H hC hΦ_meas hΦ_pref hH_cont hH_avg h_bound
    let S_idx : Finset ℕ := Finset.range (n + 1)
    let X_pref : WalkSpace → (S_idx → ℝ) := S_idx.restrict
    let X_next : WalkSpace → ℝ := fun om => om (n + 1)
    have hX_pref_meas : Measurable X_pref :=
      Measurable.of_eval fun i => measurable_pi_apply i.1
    have hX_next_meas : Measurable X_next := measurable_pi_apply (n + 1)
    have hH_dom : Continuous (Ω_reg.domRestrict H) :=
      continuousOn_iff_continuous_domRestrict.mp hH_cont
    let y_fn : (S_idx → ℝ) → ℂ := fun u => walkPos ρ (extZero n u) n
    have hy_meas : Measurable y_fn := (h_walk_mp n).1.comp (h_extZero_meas n)
    have hy_reg : ∀ u : S_idx → ℝ, y_fn u ∈ Ω_reg := fun u => h_walk_reg (extZero n u) n
    have h_cmap_reg : ∀ q : (S_idx → ℝ) × ℝ,
        circleMap (y_fn q.1) (ρ (y_fn q.1)) q.2 ∈ Ω_reg := by
      intro q
      apply h_cball _ (hy_reg q.1)
      have hr : 0 ≤ ρ (y_fn q.1) := hρ_nn _
      simp [Metric.mem_closedBall, dist_eq_norm, circleMap, abs_of_nonneg hr]
    let F_prod : (S_idx → ℝ) × ℝ → ℂ := fun q =>
      Φ (extZero n q.1) *
        (H (circleMap (y_fn q.1) (ρ (y_fn q.1)) q.2) - H (y_fn q.1))
    have hF_prod_meas : Measurable F_prod := by
      have h1 : Measurable (fun q : (S_idx → ℝ) × ℝ => Φ (extZero n q.1)) :=
        (hΦ_meas.comp (h_extZero_meas n)).comp measurable_fst
      have h_cm : Measurable (fun q : (S_idx → ℝ) × ℝ =>
          circleMap (y_fn q.1) (ρ (y_fn q.1)) q.2) := by
        simp only [circleMap]
        have hy1 : Measurable (fun q : (S_idx → ℝ) × ℝ => y_fn q.1) :=
          hy_meas.comp measurable_fst
        exact hy1.add
          ((Complex.measurable_ofReal.comp (hρ_meas.comp hy1)).mul
            (Complex.continuous_exp.measurable.comp
              ((Complex.measurable_ofReal.comp measurable_snd).mul measurable_const)))
      have h2 : Measurable (fun q : (S_idx → ℝ) × ℝ =>
          H (circleMap (y_fn q.1) (ρ (y_fn q.1)) q.2)) :=
        hH_dom.measurable.comp (h_cm.subtype_mk (h := h_cmap_reg))
      have h3 : Measurable (fun q : (S_idx → ℝ) × ℝ => H (y_fn q.1)) :=
        hH_dom.measurable.comp ((hy_meas.comp measurable_fst).subtype_mk (h := fun q => hy_reg q.1))
      exact h1.mul (h2.sub h3)
    have hF_prod_eq_upd : ∀ (u : S_idx → ℝ) (θ : ℝ),
        F_prod (u, θ) =
          let om' := Function.update (extZero n u) (n + 1) θ
          Φ om' * (H (walkPos ρ om' (n + 1)) - H (walkPos ρ om' n)) := by
      intro u θ
      let om' := Function.update (extZero n u) (n + 1) θ
      have h_le : ∀ k ≤ n, om' k = extZero n u k := by
        intro k hk
        exact Function.update_of_ne (by omega) _ _
      have hΦ_eq : Φ om' = Φ (extZero n u) := hΦ_pref om' (extZero n u) h_le
      have hy_eq : walkPos ρ om' n = y_fn u := (h_walk_mp n).2 om' (extZero n u) h_le
      have hy1_eq : walkPos ρ om' (n + 1) = circleMap (y_fn u) (ρ (y_fn u)) θ := by
        simp [walkPos, circleMap, hy_eq, om']
      dsimp only [F_prod]
      rw [← hΦ_eq, ← hy1_eq, ← hy_eq]
    have hF_prod_bound : ∀ q : (S_idx → ℝ) × ℝ, ‖F_prod q‖ ≤ C := by
      intro ⟨u, θ⟩
      rw [hF_prod_eq_upd u θ]
      exact h_bound _
    have hF_comp : ∀ om : WalkSpace,
        F_prod (X_pref om, X_next om) =
          Φ om * (H (walkPos ρ om (n + 1)) - H (walkPos ρ om n)) := by
      intro om
      have h_le : ∀ k ≤ n, extZero n (X_pref om) k = om k := h_extZero_restrict n om
      have hΦ_eq : Φ (extZero n (X_pref om)) = Φ om := hΦ_pref _ _ h_le
      have hy_eq : y_fn (X_pref om) = walkPos ρ om n := (h_walk_mp n).2 _ _ h_le
      have hy1_eq : circleMap (y_fn (X_pref om)) (ρ (y_fn (X_pref om))) (X_next om) =
          walkPos ρ om (n + 1) := by
        simp [walkPos, circleMap, hy_eq, X_next]
      dsimp only [F_prod]
      rw [hΦ_eq, hy1_eq, hy_eq]
    have h_step_meas : Measurable (fun om : WalkSpace =>
        Φ om * (H (walkPos ρ om (n + 1)) - H (walkPos ρ om n))) := by
      have : (fun om : WalkSpace => Φ om * (H (walkPos ρ om (n + 1)) - H (walkPos ρ om n))) =
          fun om => F_prod (X_pref om, X_next om) := by
        funext om; exact (hF_comp om).symm
      rw [this]
      exact hF_prod_meas.comp (hX_pref_meas.prodMk hX_next_meas)
    have h_step_int : MeasureTheory.Integrable
        (fun om : WalkSpace => Φ om * (H (walkPos ρ om (n + 1)) - H (walkPos ρ om n)))
        walkMeasure :=
      MeasureTheory.Integrable.of_bound h_step_meas.aestronglyMeasurable C
        (Filter.Eventually.of_forall h_bound)
    refine ⟨h_step_int, ?_⟩
    have h_indep : ProbabilityTheory.iIndepFun (fun (i : ℕ) (om : WalkSpace) => om i)
        walkMeasure :=
      ProbabilityTheory.iIndepFun_infinitePi (X := fun _ => id) (fun _ => measurable_id)
    have h_disj : Disjoint S_idx ({n + 1} : Finset ℕ) := by simp [S_idx]
    have h_fin := h_indep.indepFun_finset S_idx {n + 1} h_disj
      (fun _ => measurable_pi_apply _)
    have h_pair : ProbabilityTheory.IndepFun X_pref X_next walkMeasure := by
      have hp0 := h_fin.comp measurable_id
        (measurable_pi_apply ⟨n + 1, Finset.mem_singleton_self _⟩)
      have h_eq1 : (id ∘ fun (a : WalkSpace) (i : S_idx) => a ↑i) = X_pref := rfl
      have h_eq2 : ((fun f : ({n + 1} : Finset ℕ) → ℝ =>
          f ⟨n + 1, Finset.mem_singleton_self _⟩) ∘
          fun (a : WalkSpace) (i : ({n + 1} : Finset ℕ)) => a ↑i) = X_next := rfl
      rwa [h_eq1, h_eq2] at hp0
    let μ_pref := walkMeasure.map X_pref
    have hProbPref : MeasureTheory.IsProbabilityMeasure μ_pref :=
      ⟨by rw [MeasureTheory.Measure.map_apply hX_pref_meas MeasurableSet.univ]; simp⟩
    have h_map_prod : walkMeasure.map (fun om => (X_pref om, X_next om)) =
        μ_pref.prod unifTwoPiMeasure := by
      rw [(ProbabilityTheory.indepFun_iff_map_prod_eq_prod_map_map
        hX_pref_meas.aemeasurable hX_next_meas.aemeasurable).mp h_pair]
      congr 1
      exact MeasureTheory.Measure.infinitePi_map_eval (fun _ : ℕ => unifTwoPiMeasure) (n + 1)
    have hF_int_prod : MeasureTheory.Integrable F_prod (μ_pref.prod unifTwoPiMeasure) :=
      MeasureTheory.Integrable.of_bound hF_prod_meas.aestronglyMeasurable C
        (Filter.Eventually.of_forall hF_prod_bound)
    have h_eq_int : (∫ om, Φ om * (H (walkPos ρ om (n + 1)) - H (walkPos ρ om n)) ∂walkMeasure) =
        ∫ q, F_prod q ∂(walkMeasure.map (fun om => (X_pref om, X_next om))) := by
      have h_lhs : (fun om : WalkSpace => Φ om * (H (walkPos ρ om (n + 1)) - H (walkPos ρ om n))) =
          fun om => F_prod (X_pref om, X_next om) := by
        funext om; exact (hF_comp om).symm
      rw [h_lhs]
      exact (MeasureTheory.integral_map (hX_pref_meas.prodMk hX_next_meas).aemeasurable
        hF_prod_meas.aestronglyMeasurable).symm
    rw [h_eq_int, h_map_prod, MeasureTheory.integral_prod _ hF_int_prod]
    have h_inner : ∀ u : S_idx → ℝ, (∫ θ, F_prod (u, θ) ∂unifTwoPiMeasure) = 0 := by
      intro u
      let y := y_fn u
      have hy : y ∈ Ω_reg := hy_reg u
      have hy_cb : Metric.closedBall y (ρ y) ⊆ Ω_reg := h_cball y hy
      have hr : 0 ≤ ρ y := hρ_nn y
      have h_cm_mem : ∀ θ : ℝ, circleMap y (ρ y) θ ∈ Metric.closedBall y (ρ y) := by
        intro θ
        simp [Metric.mem_closedBall, dist_eq_norm, circleMap, abs_of_nonneg hr]
      have h_cm_cont : Continuous (fun θ : ℝ => H (circleMap y (ρ y) θ)) :=
        (hH_cont.mono hy_cb).comp_continuous (continuous_circleMap y (ρ y)) h_cm_mem
      obtain ⟨M_H, hM_H⟩ :=
        (isCompact_closedBall y (ρ y)).exists_bound_of_continuousOn (hH_cont.mono hy_cb)
      have h_cm_int : MeasureTheory.Integrable
          (fun θ : ℝ => H (circleMap y (ρ y) θ)) unifTwoPiMeasure :=
        MeasureTheory.Integrable.of_bound h_cm_cont.measurable.aestronglyMeasurable M_H
          (Filter.Eventually.of_forall fun θ => hM_H _ (h_cm_mem θ))
      change (∫ θ, Φ (extZero n u) * (H (circleMap y (ρ y) θ) - H y) ∂unifTwoPiMeasure) = 0
      rw [MeasureTheory.integral_const_mul,
        MeasureTheory.integral_sub h_cm_int (MeasureTheory.integrable_const (H y))]
      have h_c_int : (∫ θ, H (circleMap y (ρ y) θ) ∂unifTwoPiMeasure) = H y := by
        rw [unifTwoPiMeasure, MeasureTheory.integral_smul_measure,
          MeasureTheory.restrict_Ico_eq_restrict_Ioc]
        have h_toR : ((ENNReal.ofReal (2 * Real.pi))⁻¹).toReal = (2 * Real.pi)⁻¹ := by
          rw [ENNReal.toReal_inv, ENNReal.toReal_ofReal Real.two_pi_pos.le]
        rw [h_toR, ← intervalIntegral.integral_of_le Real.two_pi_pos.le]
        simpa [Real.circleAverage_def] using hH_avg y hy
      have h_const : (∫ _ : ℝ, H y ∂unifTwoPiMeasure) = H y := by simp
      rw [h_c_int, h_const, sub_self, mul_zero]
    simp [h_inner]

  have h_zero_mean_real : ∀ (N_cap : ℕ) (B_step : ℝ) (mask : ℕ → WalkSpace → Bool) (g : ℂ → ℝ),
      0 ≤ B_step →
      ContinuousOn g Ω_reg →
      (∀ y ∈ Ω_reg, Real.circleAverage g y (ρ y) = g y) →
      (∀ n < N_cap, Measurable (mask n) ∧ prefDet n (mask n)) →
      (∀ om : WalkSpace, ∀ n < N_cap, mask n om = true →
        |g (walkPos ρ om (n + 1)) - g (walkPos ρ om n)| ≤ B_step) →
      MeasureTheory.Integrable
        (fun om : WalkSpace => ∑ n ∈ Finset.range N_cap,
          if mask n om then -g (walkPos ρ om (n + 1)) + g (walkPos ρ om n) else 0)
        walkMeasure ∧
      (∫ om, (∑ n ∈ Finset.range N_cap,
        if mask n om then -g (walkPos ρ om (n + 1)) + g (walkPos ρ om n) else 0)
        ∂walkMeasure) = 0 := by
    intro N_cap B_step mask g hB_nn hg_cont hg_avg hmask h_step_bd
    let gC : ℂ → ℂ := fun w => (g w : ℂ)
    have hgC_cont : ContinuousOn gC Ω_reg :=
      Complex.continuous_ofReal.comp_continuousOn hg_cont
    have hgC_avg : ∀ y ∈ Ω_reg, Real.circleAverage gC y (ρ y) = gC y := by
      intro y hy
      have hr : 0 ≤ ρ y := hρ_nn y
      have hy_cb : Metric.closedBall y (ρ y) ⊆ Ω_reg := h_cball y hy
      have h_cm_mem : ∀ θ : ℝ, circleMap y (ρ y) θ ∈ Metric.closedBall y (ρ y) := by
        intro θ
        simp [Metric.mem_closedBall, dist_eq_norm, circleMap, abs_of_nonneg hr]
      have h_cm_cont : Continuous (fun θ : ℝ => g (circleMap y (ρ y) θ)) :=
        (hg_cont.mono hy_cb).comp_continuous (continuous_circleMap y (ρ y)) h_cm_mem
      have h_ii : IntervalIntegrable (fun θ : ℝ => g (circleMap y (ρ y) θ))
          MeasureTheory.volume 0 (2 * Real.pi) :=
        h_cm_cont.intervalIntegrable _ _
      let I_real : ℝ := ∫ θ in (0 : ℝ)..(2 * Real.pi), g (circleMap y (ρ y) θ)
      have h_comm0 :
          (∫ θ in (0 : ℝ)..(2 * Real.pi), Complex.ofRealCLM (g (circleMap y (ρ y) θ))) =
            Complex.ofRealCLM I_real :=
        Complex.ofRealCLM.intervalIntegral_comp_comm
          (f := fun θ => g (circleMap y (ρ y) θ)) h_ii
      have h_comm : (∫ θ in (0 : ℝ)..(2 * Real.pi), (g (circleMap y (ρ y) θ) : ℂ)) =
          (I_real : ℂ) := by
        simpa only [Complex.ofRealCLM_apply] using h_comm0
      calc
        Real.circleAverage gC y (ρ y)
          = (2 * Real.pi)⁻¹ • ∫ θ in (0 : ℝ)..(2 * Real.pi), (g (circleMap y (ρ y) θ) : ℂ) :=
            Real.circleAverage_def
        _ = (2 * Real.pi)⁻¹ • (I_real : ℂ) := by rw [h_comm]
        _ = Complex.ofReal ((2 * Real.pi)⁻¹ * I_real) := by
            rw [Complex.real_smul, Complex.ofReal_mul]
        _ = Complex.ofReal (Real.circleAverage g y (ρ y)) := by
            dsimp only [I_real]
            rw [Real.circleAverage_def, smul_eq_mul]
        _ = gC y := by rw [hg_avg y hy]
    have h_each : ∀ n ∈ Finset.range N_cap,
        MeasureTheory.Integrable
          (fun om : WalkSpace =>
            if mask n om then -g (walkPos ρ om (n + 1)) + g (walkPos ρ om n) else 0)
          walkMeasure ∧
        (∫ om, (if mask n om then -g (walkPos ρ om (n + 1)) + g (walkPos ρ om n) else 0)
          ∂walkMeasure) = 0 := by
      intro n hn
      have hn_lt : n < N_cap := Finset.mem_range.mp hn
      let Φ_n : WalkSpace → ℂ := fun om => if mask n om then (-1 : ℂ) else 0
      have hΦ_meas : Measurable Φ_n :=
        (measurable_of_countable (fun b_val : Bool => if b_val then (-1 : ℂ) else 0)).comp
          (hmask n hn_lt).1
      have hΦ_pref : prefDet n Φ_n := by
        intro om₁ om₂ h_eq
        simp [Φ_n, (hmask n hn_lt).2 om₁ om₂ h_eq]
      have hΦ_bd : ∀ om : WalkSpace,
          ‖Φ_n om * (gC (walkPos ρ om (n + 1)) - gC (walkPos ρ om n))‖ ≤ B_step := by
        intro om
        cases h_b : mask n om
        · simp [Φ_n, h_b, hB_nn]
        · have h_abs := h_step_bd om n hn_lt h_b
          have h_norm : ‖Φ_n om * (gC (walkPos ρ om (n + 1)) - gC (walkPos ρ om n))‖ =
              |g (walkPos ρ om (n + 1)) - g (walkPos ρ om n)| := by
            simp [Φ_n, h_b, gC, ← Complex.ofReal_sub, Complex.norm_real]
          linarith
      rcases h_one_step_complex n B_step Φ_n gC hB_nn hΦ_meas hΦ_pref hgC_cont hgC_avg hΦ_bd with
        ⟨h_int_C, h_zero_C⟩
      have h_re_eq : (fun om : WalkSpace =>
            if mask n om then -g (walkPos ρ om (n + 1)) + g (walkPos ρ om n) else 0) =
          fun om => Complex.reCLM (Φ_n om * (gC (walkPos ρ om (n + 1)) - gC (walkPos ρ om n))) := by
        funext om
        cases h_b : mask n om <;> simp [Φ_n, h_b, gC] <;> ring
      rw [h_re_eq]
      refine ⟨Complex.reCLM.integrable_comp h_int_C, ?_⟩
      rw [Complex.reCLM.integral_comp_comm h_int_C, h_zero_C, map_zero]
    refine ⟨MeasureTheory.integrable_finset_sum _ fun n hn => (h_each n hn).1, ?_⟩
    rw [MeasureTheory.integral_finset_sum _ fun n hn => (h_each n hn).1]
    exact Finset.sum_eq_zero fun n hn => (h_each n hn).2

  have h_l2_maximal : ∀ (N_cap : ℕ) (B_step lam : ℝ) (coeff : ℕ → WalkSpace → ℂ) (G : ℂ → ℂ),
      0 ≤ B_step → 0 < lam →
      ContinuousOn G Ω_reg →
      (∀ y ∈ Ω_reg, Real.circleAverage G y (ρ y) = G y) →
      (∀ n < N_cap, Measurable (coeff n) ∧ prefDet n (coeff n)) →
      (∀ om : WalkSpace, ∀ n < N_cap,
        ‖coeff n om * (G (walkPos ρ om (n + 1)) - G (walkPos ρ om n))‖ ≤ B_step) →
      walkMeasure.real {om : WalkSpace |
        ∃ m ≤ N_cap,
          lam < ‖∑ n ∈ Finset.range m,
            coeff n om * (G (walkPos ρ om (n + 1)) - G (walkPos ρ om n))‖} ≤
        (∑ n ∈ Finset.range N_cap,
          ∫ om, ‖coeff n om * (G (walkPos ρ om (n + 1)) - G (walkPos ρ om n))‖ ^ 2
            ∂walkMeasure) / lam ^ 2 := by
    intro N_cap B_step lam coeff G hB_nn hlam hG_cont hG_avg hcoeff h_step_bd
    let Δ : ℕ → WalkSpace → ℂ := fun n om =>
      coeff n om * (G (walkPos ρ om (n + 1)) - G (walkPos ρ om n))
    let W : ℕ → WalkSpace → ℂ := fun m om => ∑ n ∈ Finset.range m, Δ n om
    have hΔ_mp : ∀ n < N_cap, Measurable (Δ n) ∧ prefDet (n + 1) (Δ n) := by
      intro n hn
      have h1 := h_obs G (n + 1) hG_cont
      have h0 := h_obs G n hG_cont
      refine ⟨(hcoeff n hn).1.mul (h1.1.sub h0.1), ?_⟩
      intro om₁ om₂ h_eq
      have hc : coeff n om₁ = coeff n om₂ :=
        (hcoeff n hn).2 om₁ om₂ fun k hk => h_eq k (Nat.le_succ_of_le hk)
      have hg1 : G (walkPos ρ om₁ (n + 1)) = G (walkPos ρ om₂ (n + 1)) := h1.2 om₁ om₂ h_eq
      have hg0 : G (walkPos ρ om₁ n) = G (walkPos ρ om₂ n) :=
        h0.2 om₁ om₂ fun k hk => h_eq k (Nat.le_succ_of_le hk)
      simp [Δ, hc, hg1, hg0]
    have hW_mp : ∀ m ≤ N_cap,
        Measurable (W m) ∧ prefDet m (W m) ∧
        ∀ om : WalkSpace, ‖W m om‖ ≤ (m : ℝ) * B_step := by
      intro m hm
      refine ⟨?_, ?_, ?_⟩
      · exact Finset.measurable_sum _ fun n hn =>
          (hΔ_mp n (lt_of_lt_of_le (Finset.mem_range.mp hn) hm)).1
      · intro om₁ om₂ h_eq
        refine Finset.sum_congr rfl fun n hn => ?_
        have hn_lt : n < m := Finset.mem_range.mp hn
        exact (hΔ_mp n (lt_of_lt_of_le hn_lt hm)).2 om₁ om₂ fun k hk =>
          h_eq k (le_trans hk hn_lt)
      · intro om
        calc
          ‖∑ n ∈ Finset.range m, Δ n om‖
            ≤ ∑ n ∈ Finset.range m, ‖Δ n om‖ := norm_sum_le _ _
          _ ≤ ∑ _n ∈ Finset.range m, B_step :=
              Finset.sum_le_sum fun n hn =>
                h_step_bd om n (lt_of_lt_of_le (Finset.mem_range.mp hn) hm)
          _ = (m : ℝ) * B_step := by simp
    let notHit : ℕ → WalkSpace → Bool := fun n om =>
      decide (∀ l ∈ Finset.range (n + 1), ‖W l om‖ ≤ lam)
    have h_notHit_mp : ∀ n < N_cap, Measurable (notHit n) ∧ prefDet n (notHit n) := by
      intro n hn
      have h_set_eq : {om : WalkSpace | ∀ l ∈ Finset.range (n + 1), ‖W l om‖ ≤ lam} =
          ⋂ l ∈ Finset.range (n + 1), {om : WalkSpace | ‖W l om‖ ≤ lam} := by
        ext om; simp
      have h_ms : MeasurableSet {om : WalkSpace | ∀ l ∈ Finset.range (n + 1), ‖W l om‖ ≤ lam} := by
        rw [h_set_eq]
        refine Finset.measurableSet_biInter _ fun l hl => ?_
        have hl_le : l ≤ N_cap := le_trans (Nat.lt_succ_iff.mp (Finset.mem_range.mp hl)) hn.le
        exact isClosed_Iic.measurableSet.preimage (hW_mp l hl_le).1.norm
      refine ⟨h_decide_meas _ h_ms, ?_⟩
      intro om₁ om₂ h_eq
      have h_iff : (∀ l ∈ Finset.range (n + 1), ‖W l om₁‖ ≤ lam) ↔
          (∀ l ∈ Finset.range (n + 1), ‖W l om₂‖ ≤ lam) := by
        refine forall₂_congr fun l hl => ?_
        have hl_le_n : l ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp hl)
        have hl_le_N : l ≤ N_cap := le_trans hl_le_n hn.le
        rw [(hW_mp l hl_le_N).2.1 om₁ om₂ fun k hk => h_eq k (le_trans hk hl_le_n)]
      dsimp only [notHit]
      exact decide_eq_decide.mpr h_iff
    let Δ_tilde : ℕ → WalkSpace → ℂ := fun n om =>
      if notHit n om then Δ n om else 0
    let W_tilde : ℕ → WalkSpace → ℂ := fun m om => ∑ n ∈ Finset.range m, Δ_tilde n om
    have hΔ_tilde_mp : ∀ n < N_cap,
        Measurable (Δ_tilde n) ∧ prefDet (n + 1) (Δ_tilde n) ∧
        ∀ om : WalkSpace, ‖Δ_tilde n om‖ ≤ B_step := by
      intro n hn
      have h_meas : Measurable (Δ_tilde n) := by
        have h_eq : Δ_tilde n = fun om =>
            (if notHit n om then (1 : ℂ) else 0) * Δ n om := by
          funext om; dsimp only [Δ_tilde]; cases notHit n om <;> simp
        rw [h_eq]
        exact ((measurable_of_countable (fun b_val : Bool => if b_val then (1 : ℂ) else 0)).comp
          (h_notHit_mp n hn).1).mul (hΔ_mp n hn).1
      refine ⟨h_meas, ?_, ?_⟩
      · intro om₁ om₂ h_eq
        have h1 : notHit n om₁ = notHit n om₂ :=
          (h_notHit_mp n hn).2 om₁ om₂ fun k hk => h_eq k (Nat.le_succ_of_le hk)
        have h2 : Δ n om₁ = Δ n om₂ := (hΔ_mp n hn).2 om₁ om₂ h_eq
        simp [Δ_tilde, h1, h2]
      · intro om
        cases h_b : notHit n om
        · simp [Δ_tilde, h_b, hB_nn]
        · have h_eq_d : Δ_tilde n om = Δ n om := by simp [Δ_tilde, h_b]
          rw [h_eq_d]
          exact h_step_bd om n hn
    have hW_tilde_mp : ∀ m ≤ N_cap,
        Measurable (W_tilde m) ∧ prefDet m (W_tilde m) ∧
        ∀ om : WalkSpace, ‖W_tilde m om‖ ≤ (m : ℝ) * B_step := by
      intro m hm
      refine ⟨?_, ?_, ?_⟩
      · exact Finset.measurable_sum _ fun n hn =>
          (hΔ_tilde_mp n (lt_of_lt_of_le (Finset.mem_range.mp hn) hm)).1
      · intro om₁ om₂ h_eq
        refine Finset.sum_congr rfl fun n hn => ?_
        have hn_lt : n < m := Finset.mem_range.mp hn
        exact (hΔ_tilde_mp n (lt_of_lt_of_le hn_lt hm)).2.1 om₁ om₂ fun k hk =>
          h_eq k (le_trans hk hn_lt)
      · intro om
        calc
          ‖∑ n ∈ Finset.range m, Δ_tilde n om‖
            ≤ ∑ n ∈ Finset.range m, ‖Δ_tilde n om‖ := norm_sum_le _ _
          _ ≤ ∑ _n ∈ Finset.range m, B_step :=
              Finset.sum_le_sum fun n hn =>
                (hΔ_tilde_mp n (lt_of_lt_of_le (Finset.mem_range.mp hn) hm)).2.2 om
          _ = (m : ℝ) * B_step := by simp
    have h_orth : ∀ m ≤ N_cap,
        MeasureTheory.Integrable (fun om => ‖W_tilde m om‖ ^ 2) walkMeasure ∧
        (∫ om, ‖W_tilde m om‖ ^ 2 ∂walkMeasure) =
          ∑ n ∈ Finset.range m, ∫ om, ‖Δ_tilde n om‖ ^ 2 ∂walkMeasure := by
      intro m
      induction m with
      | zero =>
          intro _
          have h_zero_fn : (fun om : WalkSpace => ‖W_tilde 0 om‖ ^ 2) = fun _ => 0 := by
            funext om; simp [W_tilde]
          rw [h_zero_fn]
          simp
      | succ n ih =>
          intro hn_succ
          have hn : n < N_cap := Nat.lt_of_succ_le hn_succ
          rcases ih hn.le with ⟨hInt_W, hEq_W⟩
          have hΔ_sq_int : MeasureTheory.Integrable
              (fun om => ‖Δ_tilde n om‖ ^ 2) walkMeasure := by
            have hm_sq : Measurable (fun om => ‖Δ_tilde n om‖ ^ 2) :=
              ((hΔ_tilde_mp n hn).1.norm).pow_const 2
            refine MeasureTheory.Integrable.of_bound hm_sq.aestronglyMeasurable (B_step ^ 2)
              (Filter.Eventually.of_forall fun om => ?_)
            rw [Real.norm_of_nonneg (sq_nonneg _)]
            exact pow_le_pow_left₀ (norm_nonneg _) ((hΔ_tilde_mp n hn).2.2 om) 2
          let Φ_cross : WalkSpace → ℂ := fun om =>
            (if notHit n om then coeff n om else 0) * starRingEnd ℂ (W_tilde n om)
          have hΦ_cross_meas : Measurable Φ_cross := by
            have h_c : Measurable (fun om : WalkSpace => if notHit n om then coeff n om else 0) := by
              have : (fun om : WalkSpace => if notHit n om then coeff n om else 0) =
                  fun om => (if notHit n om then (1 : ℂ) else 0) * coeff n om := by
                funext om; cases notHit n om <;> simp
              rw [this]
              exact ((measurable_of_countable (fun b_val : Bool => if b_val then (1 : ℂ) else 0)).comp
                (h_notHit_mp n hn).1).mul (hcoeff n hn).1
            exact h_c.mul (Complex.continuous_conj.measurable.comp (hW_tilde_mp n hn.le).1)
          have hΦ_cross_pref : prefDet n Φ_cross := by
            intro om₁ om₂ h_eq
            simp [Φ_cross, (h_notHit_mp n hn).2 om₁ om₂ h_eq,
              (hcoeff n hn).2 om₁ om₂ h_eq, (hW_tilde_mp n hn.le).2.1 om₁ om₂ h_eq]
          have hΦ_cross_bd : ∀ om : WalkSpace,
              ‖Φ_cross om * (G (walkPos ρ om (n + 1)) - G (walkPos ρ om n))‖ ≤
                (n : ℝ) * B_step ^ 2 := by
            intro om
            have h_prod_eq : Φ_cross om * (G (walkPos ρ om (n + 1)) - G (walkPos ρ om n)) =
                Δ_tilde n om * starRingEnd ℂ (W_tilde n om) := by
              cases h_b : notHit n om <;>
                simp [Φ_cross, Δ_tilde, Δ, h_b, mul_assoc, mul_left_comm, mul_comm]
            rw [h_prod_eq, norm_mul, RCLike.norm_conj]
            calc
              ‖Δ_tilde n om‖ * ‖W_tilde n om‖
                ≤ B_step * ((n : ℝ) * B_step) :=
                  mul_le_mul ((hΔ_tilde_mp n hn).2.2 om) ((hW_tilde_mp n hn.le).2.2 om)
                    (norm_nonneg _) hB_nn
              _ = (n : ℝ) * B_step ^ 2 := by ring
          rcases h_one_step_complex n ((n : ℝ) * B_step ^ 2) Φ_cross G (by positivity)
            hΦ_cross_meas hΦ_cross_pref hG_cont hG_avg hΦ_cross_bd with ⟨hInt_C, hZero_C⟩
          let cross_re : WalkSpace → ℝ := fun om =>
            2 * Complex.reCLM (Φ_cross om * (G (walkPos ρ om (n + 1)) - G (walkPos ρ om n)))
          have h_cross_int : MeasureTheory.Integrable cross_re walkMeasure :=
            (Complex.reCLM.integrable_comp hInt_C).const_mul 2
          have h_cross_zero : (∫ om, cross_re om ∂walkMeasure) = 0 := by
            dsimp only [cross_re]
            rw [MeasureTheory.integral_const_mul, Complex.reCLM.integral_comp_comm hInt_C,
              hZero_C, map_zero, mul_zero]
          have h_expand : (fun om : WalkSpace => ‖W_tilde (n + 1) om‖ ^ 2) =
              fun om => (‖W_tilde n om‖ ^ 2 + cross_re om) + ‖Δ_tilde n om‖ ^ 2 := by
            funext om
            have h_sum : W_tilde (n + 1) om = W_tilde n om + Δ_tilde n om :=
              Finset.sum_range_succ _ n
            have h_inner_eq : inner ℝ (W_tilde n om) (Δ_tilde n om) =
                Complex.reCLM (Φ_cross om * (G (walkPos ρ om (n + 1)) - G (walkPos ρ om n))) := by
              have h_prod_eq : Φ_cross om * (G (walkPos ρ om (n + 1)) - G (walkPos ρ om n)) =
                  Δ_tilde n om * starRingEnd ℂ (W_tilde n om) := by
                cases h_b : notHit n om <;>
                  simp [Φ_cross, Δ_tilde, Δ, h_b, mul_assoc, mul_left_comm, mul_comm]
              rw [h_prod_eq]
              simp [Complex.inner]
            rw [h_sum, norm_add_sq_real, h_inner_eq]
          rw [h_expand]
          have hInt_W_cr : MeasureTheory.Integrable
              (fun om => ‖W_tilde n om‖ ^ 2 + cross_re om) walkMeasure :=
            hInt_W.add h_cross_int
          refine ⟨hInt_W_cr.add hΔ_sq_int, ?_⟩
          rw [MeasureTheory.integral_add hInt_W_cr hΔ_sq_int,
            MeasureTheory.integral_add hInt_W h_cross_int,
            hEq_W, h_cross_zero, add_zero, Finset.sum_range_succ]
    have h_var_le : (∫ om, ‖W_tilde N_cap om‖ ^ 2 ∂walkMeasure) ≤
        ∑ n ∈ Finset.range N_cap, ∫ om, ‖Δ n om‖ ^ 2 ∂walkMeasure := by
      rw [(h_orth N_cap le_rfl).2]
      refine Finset.sum_le_sum fun n hn => ?_
      have hn_lt : n < N_cap := Finset.mem_range.mp hn
      have hInt1 : MeasureTheory.Integrable (fun om => ‖Δ_tilde n om‖ ^ 2) walkMeasure := by
        have hm_sq : Measurable (fun om => ‖Δ_tilde n om‖ ^ 2) :=
          ((hΔ_tilde_mp n hn_lt).1.norm).pow_const 2
        refine MeasureTheory.Integrable.of_bound hm_sq.aestronglyMeasurable (B_step ^ 2)
          (Filter.Eventually.of_forall fun om => ?_)
        rw [Real.norm_of_nonneg (sq_nonneg _)]
        exact pow_le_pow_left₀ (norm_nonneg _) ((hΔ_tilde_mp n hn_lt).2.2 om) 2
      have hInt2 : MeasureTheory.Integrable (fun om => ‖Δ n om‖ ^ 2) walkMeasure := by
        have hm_sq : Measurable (fun om => ‖Δ n om‖ ^ 2) :=
          ((hΔ_mp n hn_lt).1.norm).pow_const 2
        refine MeasureTheory.Integrable.of_bound hm_sq.aestronglyMeasurable (B_step ^ 2)
          (Filter.Eventually.of_forall fun om => ?_)
        rw [Real.norm_of_nonneg (sq_nonneg _)]
        exact pow_le_pow_left₀ (norm_nonneg _) (h_step_bd om n hn_lt) 2
      refine MeasureTheory.integral_mono hInt1 hInt2 fun om => ?_
      cases h_b : notHit n om
      · simp [Δ_tilde, h_b, sq_nonneg]
      · simp [Δ_tilde, h_b]
    let E_max : Set WalkSpace := {om : WalkSpace | ∃ m ≤ N_cap, lam < ‖W m om‖}
    have hE_max_eq : E_max =
        ⋃ m ∈ Finset.range (N_cap + 1), {om : WalkSpace | lam < ‖W m om‖} := by
      ext om; simp [E_max, Nat.lt_succ_iff]
    have hE_max_meas : MeasurableSet E_max := by
      rw [hE_max_eq]
      refine Finset.measurableSet_biUnion _ fun m hm => ?_
      have hm_le : m ≤ N_cap := Nat.lt_succ_iff.mp (Finset.mem_range.mp hm)
      exact isOpen_Ioi.measurableSet.preimage (hW_mp m hm_le).1.norm
    have h_ind_le : ∀ om : WalkSpace,
        E_max.indicator (fun _ => lam ^ 2) om ≤ ‖W_tilde N_cap om‖ ^ 2 := by
      intro om
      by_cases hom : om ∈ E_max
      · rw [Set.indicator_of_mem hom]
        classical
        let m_star := Nat.find hom
        have hm_spec : m_star ≤ N_cap ∧ lam < ‖W m_star om‖ := Nat.find_spec hom
        have h_eq_stop : W_tilde N_cap om = W m_star om := by
          dsimp only [W_tilde, W]
          rw [← Finset.sum_subset (Finset.range_mono hm_spec.1)]
          · refine Finset.sum_congr rfl fun n hn => ?_
            have hn_lt : n < m_star := Finset.mem_range.mp hn
            have h_nh : notHit n om = true := by
              simp only [notHit, decide_eq_true_eq]
              intro l hl
              have hl_lt : l < m_star := lt_of_lt_of_le (Finset.mem_range.mp hl) hn_lt
              have hl_le_N : l ≤ N_cap := le_trans hl_lt.le hm_spec.1
              have h_min := Nat.find_min hom hl_lt
              by_contra h_gt
              exact h_min ⟨hl_le_N, lt_of_not_ge h_gt⟩
            simp [Δ_tilde, h_nh]
          · intro n _ hn_not_m
            have hm_le_n : m_star ≤ n := le_of_not_gt (Finset.mem_range.not.mp hn_not_m)
            have h_nh : notHit n om = false := by
              simp only [notHit, decide_eq_false_iff_not, not_forall]
              exact ⟨m_star, Finset.mem_range.mpr (Nat.lt_succ_of_le hm_le_n),
                not_le_of_gt hm_spec.2⟩
            simp [Δ_tilde, h_nh]
        rw [h_eq_stop]
        exact pow_le_pow_left₀ hlam.le hm_spec.2.le 2
      · rw [Set.indicator_of_notMem hom]
        exact sq_nonneg _
    have h_ind_int : MeasureTheory.Integrable (E_max.indicator fun _ => lam ^ 2) walkMeasure :=
      (MeasureTheory.integrable_const _).indicator hE_max_meas
    have h_cheb : lam ^ 2 * walkMeasure.real E_max ≤ ∫ om, ‖W_tilde N_cap om‖ ^ 2 ∂walkMeasure := by
      have h_int_ind : (∫ om, E_max.indicator (fun _ => lam ^ 2) om ∂walkMeasure) =
          walkMeasure.real E_max * lam ^ 2 := by
        rw [MeasureTheory.integral_indicator_const _ hE_max_meas, smul_eq_mul,
          MeasureTheory.measureReal_def]
      have h_mono := MeasureTheory.integral_mono h_ind_int (h_orth N_cap le_rfl).1 h_ind_le
      linarith
    rw [le_div_iff₀ (sq_pos_of_pos hlam)]
    linarith

  
  
  
  let mask₀ : WalkSpace → Bool := fun om => decide (om ∈ A₀)
  have h_mask₀_mp : ∀ n : ℕ, Measurable mask₀ ∧ prefDet n mask₀ := by
    intro n
    refine ⟨h_decide_meas _ hA₀_meas, ?_⟩
    intro om₁ om₂ h_eq
    have h0 : om₁ 0 = om₂ 0 := h_eq 0 (Nat.zero_le n)
    simp [mask₀, A₀, h0]

  
  let H_sup : WalkSpace → ℕ → ℝ := fun om n =>
    Finset.univ.sup' Finset.univ_nonempty (fun k => sliceHistory S P ρ om k n)
  have hH_sup_mono : ∀ (om : WalkSpace) {m₁ m₂ : ℕ}, m₁ ≤ m₂ → H_sup om m₁ ≤ H_sup om m₂ := by
    intro om m₁ m₂ hm
    refine Finset.sup'_le _ _ fun k _ => ?_
    refine le_trans ?_ (Finset.le_sup' (fun i => sliceHistory S P ρ om i m₂) (Finset.mem_univ k))
    dsimp [sliceHistory]
    exact Finset.sup'_mono _ (Finset.range_mono (Nat.succ_le_succ hm)) _

  have h_sup_meas : ∀ {ι : Type} (s : Finset ι) (hs : s.Nonempty) (F : ι → WalkSpace → ℝ),
      (∀ i ∈ s, Measurable (F i)) → Measurable (fun om => s.sup' hs (fun i => F i om)) := by
    intro ι s hs F hF
    have h_fn : (fun om => s.sup' hs (fun i => F i om)) = s.sup' hs F := by
      funext om; exact (Finset.sup'_apply hs F om).symm
    rw [h_fn]
    exact Finset.sup'_induction (p := Measurable) hs F
      (fun g₁ hg₁ g₂ hg₂ => continuous_max.measurable.comp (hg₁.prodMk hg₂)) hF

  have hH_sup_mp : ∀ n : ℕ,
      Measurable (fun om => H_sup om n) ∧ prefDet n (fun om => H_sup om n) := by
    intro n
    refine ⟨?_, ?_⟩
    · refine h_sup_meas Finset.univ Finset.univ_nonempty _ fun k _ => ?_
      dsimp [sliceHistory]
      refine h_sup_meas (Finset.range (n + 1)) ⟨0, Finset.mem_range.mpr (Nat.zero_lt_succ n)⟩ _
        fun l _ => (h_obs (sliceLogDepth S P k) l (h_logDepth_cont k)).1
    · intro om₁ om₂ h_eq
      dsimp only [H_sup, sliceHistory]
      refine Finset.sup'_congr Finset.univ_nonempty rfl fun k _ => ?_
      refine Finset.sup'_congr _ rfl fun l hl => ?_
      have hl_le : l ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp hl)
      exact (h_obs (sliceLogDepth S P k) l (h_logDepth_cont k)).2 om₁ om₂
        fun r hr => h_eq r (le_trans hr hl_le)

  let activeM : ℕ → WalkSpace → Bool := fun n om => decide (H_sup om n < M)
  have h_activeM_mp : ∀ n : ℕ, Measurable (activeM n) ∧ prefDet n (activeM n) := by
    intro n
    have h_ms : MeasurableSet {om : WalkSpace | H_sup om n < M} :=
      isOpen_Iio.measurableSet.preimage (hH_sup_mp n).1
    refine ⟨h_decide_meas _ h_ms, ?_⟩
    intro om₁ om₂ h_eq
    simp [activeM, (hH_sup_mp n).2 om₁ om₂ h_eq]

  have h_tiny_mp : ∀ (j : Fin P.N) (n : ℕ),
      Measurable (fun om : WalkSpace => sliceIsTiny S P bG j (walkPos ρ om) n) ∧
      prefDet n (fun om : WalkSpace => sliceIsTiny S P bG j (walkPos ρ om) n) := by
    intro j n
    induction n with
    | zero =>
        refine ⟨measurable_const, fun _ _ _ => rfl⟩
    | succ k ih =>
        have h_log_k1 := h_obs (fun y => Real.log ‖sliceSpeedSeq S P.N j.val y‖) (k + 1)
          (h_logSpeed_cont j)
        have hd1 : Measurable (fun om : WalkSpace =>
            decide (Real.log ‖sliceSpeedSeq S P.N j.val (walkPos ρ om (k + 1))‖ < -bG)) :=
          h_decide_meas _ (isOpen_Iio.measurableSet.preimage h_log_k1.1)
        have hd2 : Measurable (fun om : WalkSpace =>
            decide (Real.log ‖sliceSpeedSeq S P.N j.val (walkPos ρ om (k + 1))‖ ≤ -2 * bG)) :=
          h_decide_meas _ (isClosed_Iic.measurableSet.preimage h_log_k1.1)
        have h_meas_succ : Measurable (fun om : WalkSpace =>
            sliceIsTiny S P bG j (walkPos ρ om) (k + 1)) := by
          have h_eq : (fun om : WalkSpace => sliceIsTiny S P bG j (walkPos ρ om) (k + 1)) =
              (fun p : Bool × Bool × Bool => if p.1 then p.2.1 else p.2.2) ∘
              (fun om => (sliceIsTiny S P bG j (walkPos ρ om) k,
                (decide (Real.log ‖sliceSpeedSeq S P.N j.val (walkPos ρ om (k + 1))‖ < -bG),
                 decide (Real.log ‖sliceSpeedSeq S P.N j.val (walkPos ρ om (k + 1))‖ ≤ -2 * bG)))) := by
            funext om; simp [sliceIsTiny]
          rw [h_eq]
          exact (measurable_of_countable _).comp (ih.1.prodMk (hd1.prodMk hd2))
        refine ⟨h_meas_succ, ?_⟩
        intro om₁ om₂ h_eq
        have h_prev : sliceIsTiny S P bG j (walkPos ρ om₁) k =
            sliceIsTiny S P bG j (walkPos ρ om₂) k :=
          ih.2 om₁ om₂ fun r hr => h_eq r (Nat.le_succ_of_le hr)
        have h_cur := h_log_k1.2 om₁ om₂ h_eq
        simp [sliceIsTiny, h_prev, h_cur]

  have h_angCut_mp : ∀ n : ℕ,
      Measurable (fun om : WalkSpace => sliceAngCutOK S P r_star (walkPos ρ om) n) ∧
      prefDet n (fun om : WalkSpace => sliceAngCutOK S P r_star (walkPos ρ om) n) := by
    intro n
    have h_eq_set :
        {om : WalkSpace | ∀ l ≤ n, ∀ k : Fin P.N,
          ‖sliceAngleSeq S P.N k.val (walkPos ρ om l)‖ ≤ r_star} =
        ⋂ l ∈ Finset.range (n + 1), ⋂ k ∈ (Finset.univ : Finset (Fin P.N)),
          {om : WalkSpace | ‖sliceAngleSeq S P.N k.val (walkPos ρ om l)‖ ≤ r_star} := by
      ext om; simp [Nat.lt_succ_iff]
    have h_ms : MeasurableSet
        {om : WalkSpace | ∀ l ≤ n, ∀ k : Fin P.N,
          ‖sliceAngleSeq S P.N k.val (walkPos ρ om l)‖ ≤ r_star} := by
      rw [h_eq_set]
      refine Finset.measurableSet_biInter _ fun l _ => ?_
      refine Finset.measurableSet_biInter _ fun k _ => ?_
      exact isClosed_Iic.measurableSet.preimage
        (h_obs (sliceAngleSeq S P.N k.val) l (h_angle_holo k).continuousOn).1.norm
    have h_meas_ac : Measurable (fun om : WalkSpace => sliceAngCutOK S P r_star (walkPos ρ om) n) := by
      dsimp only [sliceAngCutOK]
      exact h_decide_meas _ h_ms
    refine ⟨h_meas_ac, ?_⟩
    intro om₁ om₂ h_eq
    have h_iff :
        (∀ l ≤ n, ∀ k : Fin P.N, ‖sliceAngleSeq S P.N k.val (walkPos ρ om₁ l)‖ ≤ r_star) ↔
        (∀ l ≤ n, ∀ k : Fin P.N, ‖sliceAngleSeq S P.N k.val (walkPos ρ om₂ l)‖ ≤ r_star) := by
      refine forall₂_congr fun l hl => forall_congr' fun k => ?_
      have h_ang_eq : sliceAngleSeq S P.N k.val (walkPos ρ om₁ l) =
          sliceAngleSeq S P.N k.val (walkPos ρ om₂ l) :=
        (h_obs (sliceAngleSeq S P.N k.val) l (h_angle_holo k).continuousOn).2 om₁ om₂
          fun r hr => h_eq r (le_trans hr hl)
      rw [h_ang_eq]
    simp [sliceAngCutOK, h_iff]

  have h_runMax_mp : ∀ n : ℕ,
      Measurable (fun om : WalkSpace => sliceRunningPosMax S P (walkPos ρ om) n) ∧
      prefDet n (fun om : WalkSpace => sliceRunningPosMax S P (walkPos ρ om) n) := by
    intro n
    refine ⟨?_, ?_⟩
    · dsimp only [sliceRunningPosMax]
      refine measurable_const.add ?_
      refine h_sup_meas (Finset.range (n + 1)) ⟨0, Finset.mem_range.mpr (Nat.zero_lt_succ n)⟩ _
        fun l _ => ?_
      exact h_sup_meas Finset.univ Finset.univ_nonempty _ fun k _ =>
        (h_obs (fun w => ‖slicePosSeq S P.N k.val w‖) l (h_pos_norm_cont k)).1
    · intro om₁ om₂ h_eq
      dsimp only [sliceRunningPosMax]
      congr 1
      refine Finset.sup'_congr _ rfl fun l hl => ?_
      have hl_le : l ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp hl)
      refine Finset.sup'_congr Finset.univ_nonempty rfl fun k _ => ?_
      exact (h_obs (fun w => ‖slicePosSeq S P.N k.val w‖) l (h_pos_norm_cont k)).2 om₁ om₂
        fun r hr => h_eq r (le_trans hr hl_le)

  
  let E_stops : Set WalkSpace := {om : WalkSpace | ∃ m : ℕ, M ≤ H_sup om m}
  have hE_stops_ae : ∀ᵐ om : WalkSpace ∂walkMeasure, om ∈ E_stops :=
    hBase.walk_stops M ρ hAdm
  have hE_stops_compl_null : walkMeasure E_stopsᶜ = 0 :=
    MeasureTheory.ae_iff.mp hE_stops_ae
  have hE_stops_compl_real : walkMeasure.real E_stopsᶜ = 0 := by
    simp [MeasureTheory.measureReal_def, hE_stops_compl_null]

  have h_active_iff_tau : ∀ om ∈ E_stops, ∀ n : ℕ,
      (activeM n om = true ↔ n < sliceStopTau S P ρ M om) := by
    intro om hom n
    have hom' : ∃ m : ℕ, M ≤ Finset.univ.sup' Finset.univ_nonempty
        (fun j => sliceHistory S P ρ om j m) := hom
    have h_tau_eq : sliceStopTau S P ρ M om =
        @Nat.find _ (Classical.decPred _) hom' := by
      dsimp only [sliceStopTau]
      rw [dif_pos hom']
    rw [h_tau_eq]
    simp only [activeM, decide_eq_true_eq]
    refine ⟨fun h_lt => ?_, fun hn_lt => ?_⟩
    · by_contra h_ge
      have h_le : @Nat.find _ (Classical.decPred _) hom' ≤ n := not_lt.mp h_ge
      have h_spec : M ≤ H_sup om (@Nat.find _ (Classical.decPred _) hom') :=
        @Nat.find_spec _ (Classical.decPred _) hom'
      have h_m := hH_sup_mono om h_le
      linarith
    · have h_min := @Nat.find_min _ (Classical.decPred _) hom' n hn_lt
      linarith

  
  let τ_tr : ℕ → WalkSpace → ℕ := fun N_cap om =>
    @Nat.find (fun m : ℕ => N_cap ≤ m ∨ M ≤ H_sup om m) (Classical.decPred _)
      ⟨N_cap, Or.inl le_rfl⟩
  have hτ_tr_le : ∀ (N_cap : ℕ) (om : WalkSpace), τ_tr N_cap om ≤ N_cap :=
    fun N_cap om => @Nat.find_min' _ (Classical.decPred _) _ N_cap (Or.inl le_rfl)
  have hτ_tr_lt_iff : ∀ (N_cap n : ℕ) (om : WalkSpace), n < N_cap →
      (n < τ_tr N_cap om ↔ activeM n om = true) := by
    intro N_cap n om hn_N
    simp only [activeM, decide_eq_true_eq]
    refine ⟨fun hn_lt => ?_, fun h_lt => ?_⟩
    · have h_min := @Nat.find_min (fun m : ℕ => N_cap ≤ m ∨ M ≤ H_sup om m)
        (Classical.decPred _) ⟨N_cap, Or.inl le_rfl⟩ n hn_lt
      push_neg at h_min
      exact h_min.2
    · by_contra h_ge
      have h_le : τ_tr N_cap om ≤ n := not_lt.mp h_ge
      have h_spec := @Nat.find_spec (fun m : ℕ => N_cap ≤ m ∨ M ≤ H_sup om m)
        (Classical.decPred _) ⟨N_cap, Or.inl le_rfl⟩
      change N_cap ≤ τ_tr N_cap om ∨ M ≤ H_sup om (τ_tr N_cap om) at h_spec
      rcases h_spec with hN_le | hM_le
      · omega
      · linarith [hH_sup_mono om h_le]
  have hτ_tr_le_iff : ∀ (N_cap k : ℕ) (om : WalkSpace),
      τ_tr N_cap om ≤ k ↔ (N_cap ≤ k ∨ M ≤ H_sup om k) := by
    intro N_cap k om
    refine ⟨fun hk => ?_, fun hk => @Nat.find_min' _ (Classical.decPred _) _ k hk⟩
    have h_spec := @Nat.find_spec (fun m : ℕ => N_cap ≤ m ∨ M ≤ H_sup om m)
      (Classical.decPred _) ⟨N_cap, Or.inl le_rfl⟩
    rcases h_spec with hN | hM
    · exact Or.inl (le_trans hN hk)
    · exact Or.inr (le_trans hM (hH_sup_mono om hk))
  have hτ_tr_meas : ∀ N_cap : ℕ, Measurable (τ_tr N_cap) := by
    intro N_cap
    have h_le_ms : ∀ k : ℕ, MeasurableSet {om : WalkSpace | τ_tr N_cap om ≤ k} := by
      intro k
      have h_eq : {om : WalkSpace | τ_tr N_cap om ≤ k} =
          {om | N_cap ≤ k} ∪ {om | M ≤ H_sup om k} := by
        ext om; exact hτ_tr_le_iff N_cap k om
      rw [h_eq]
      exact (MeasurableSet.const _).union (isClosed_Ici.measurableSet.preimage (hH_sup_mp k).1)
    refine measurable_to_countable' fun k => ?_
    cases k with
    | zero =>
        have : τ_tr N_cap ⁻¹' {0} = {om | τ_tr N_cap om ≤ 0} := by ext om; simp
        rw [this]; exact h_le_ms 0
    | succ r =>
        have : τ_tr N_cap ⁻¹' {r + 1} =
            {om | τ_tr N_cap om ≤ r + 1} \ {om | τ_tr N_cap om ≤ r} := by
          ext om; simp; omega
        rw [this]; exact (h_le_ms (r + 1)).diff (h_le_ms r)
  have hτ_tr_mono : ∀ {N₁ N₂ : ℕ}, N₁ ≤ N₂ → ∀ om : WalkSpace, τ_tr N₁ om ≤ τ_tr N₂ om := by
    intro N₁ N₂ hN om
    rw [hτ_tr_le_iff]
    have h_spec := @Nat.find_spec (fun m : ℕ => N₂ ≤ m ∨ M ≤ H_sup om m)
      (Classical.decPred _) ⟨N₂, Or.inl le_rfl⟩
    rcases h_spec with hN₂ | hM
    · exact Or.inl (le_trans hN hN₂)
    · exact Or.inr hM
  have hτ_tr_eq_tau : ∀ om ∈ E_stops,
      τ_tr (sliceStopTau S P ρ M om) om = sliceStopTau S P ρ M om := by
    intro om hom
    apply le_antisymm (hτ_tr_le _ om)
    by_contra h_lt
    push_neg at h_lt
    have h_act : activeM (τ_tr (sliceStopTau S P ρ M om) om) om = true :=
      (h_active_iff_tau om hom _).mpr h_lt
    simp only [activeM, decide_eq_true_eq] at h_act
    have h_spec := @Nat.find_spec
      (fun m : ℕ => sliceStopTau S P ρ M om ≤ m ∨ M ≤ H_sup om m)
      (Classical.decPred _) ⟨sliceStopTau S P ρ M om, Or.inl le_rfl⟩
    change sliceStopTau S P ρ M om ≤ τ_tr (sliceStopTau S P ρ M om) om ∨
      M ≤ H_sup om (τ_tr (sliceStopTau S P ρ M om) om) at h_spec
    rcases h_spec with h_ge | h_M
    · omega
    · linarith

  
  let Λ_sw : ℝ := M ^ (1 + η - γ)
  have hΛ_sw_pos : 0 < Λ_sw := Real.rpow_pos_of_pos hM_pos _
  let E_sw : Set WalkSpace :=
    {om : WalkSpace |
      Λ_sw < (sliceJointSwitches S P bG (walkPos ρ om) (sliceStopTau S P ρ M om) : ℝ)}
  have hE_sw_le : walkMeasure.real E_sw ≤ δ / 3 := by
    let U_max : ℝ := C_f * (M + 2) + C_init
    have hU_max_nn : 0 ≤ U_max := by positivity
    let B_sw : ℕ → Set WalkSpace := fun N_cap =>
      A₀ ∩ {om : WalkSpace |
        Λ_sw < (sliceJointSwitches S P bG (walkPos ρ om) (τ_tr N_cap om) : ℝ)}
    have hB_sw_meas : ∀ N_cap : ℕ, MeasurableSet (B_sw N_cap) := by
      intro N_cap
      have h_eq : B_sw N_cap = A₀ ∩ ⋃ k ∈ Finset.range (N_cap + 1),
          ({om | τ_tr N_cap om = k} ∩
            {om | Λ_sw < (sliceJointSwitches S P bG (walkPos ρ om) k : ℝ)}) := by
        ext om
        simp only [B_sw, Set.mem_inter_iff, Set.mem_iUnion, Finset.mem_range, Nat.lt_succ_iff,
          Set.mem_setOf_eq]
        refine ⟨fun ⟨hA, hgt⟩ => ⟨hA, τ_tr N_cap om, hτ_tr_le N_cap om, rfl, hgt⟩,
          fun ⟨hA, k, _, hk, hgt⟩ => ⟨hA, hk ▸ hgt⟩⟩
      rw [h_eq]
      refine hA₀_meas.inter (Finset.measurableSet_biUnion _ fun k _ => ?_)
      have h1 : MeasurableSet {om : WalkSpace | τ_tr N_cap om = k} :=
        (hτ_tr_meas N_cap) (MeasurableSet.singleton k)
      have h_sw_meas : Measurable (fun om : WalkSpace =>
          (sliceJointSwitches S P bG (walkPos ρ om) k : ℝ)) := by
        have h_sum_eq : (fun om : WalkSpace =>
              (sliceJointSwitches S P bG (walkPos ρ om) k : ℝ)) =
            fun om => ∑ n ∈ Finset.range k,
              if decide (∃ j : Fin P.N,
                  sliceIsTiny S P bG j (walkPos ρ om) n ≠
                    sliceIsTiny S P bG j (walkPos ρ om) (n + 1)) then (1 : ℝ) else 0 := by
          funext om
          dsimp only [sliceJointSwitches]
          rw [Finset.card_filter, Nat.cast_sum]
          refine Finset.sum_congr rfl fun n _ => ?_
          split_ifs with h1 h2 h2 <;> simp_all
        rw [h_sum_eq]
        refine Finset.measurable_sum _ fun n _ => ?_
        have h_ex_eq : {om : WalkSpace | ∃ j : Fin P.N,
              sliceIsTiny S P bG j (walkPos ρ om) n ≠
                sliceIsTiny S P bG j (walkPos ρ om) (n + 1)} =
            ⋃ j ∈ (Finset.univ : Finset (Fin P.N)),
              {om | sliceIsTiny S P bG j (walkPos ρ om) n ≠
                sliceIsTiny S P bG j (walkPos ρ om) (n + 1)} := by
          ext om; simp
        have h_ex_ms : MeasurableSet {om : WalkSpace | ∃ j : Fin P.N,
            sliceIsTiny S P bG j (walkPos ρ om) n ≠
              sliceIsTiny S P bG j (walkPos ρ om) (n + 1)} := by
          rw [h_ex_eq]
          refine Finset.measurableSet_biUnion _ fun j _ => ?_
          have h_pair_t : Measurable (fun om : WalkSpace =>
              (sliceIsTiny S P bG j (walkPos ρ om) n,
               sliceIsTiny S P bG j (walkPos ρ om) (n + 1))) :=
            (h_tiny_mp j n).1.prodMk (h_tiny_mp j (n + 1)).1
          exact h_pair_t (MeasurableSet.of_discrete (s := {p : Bool × Bool | p.1 ≠ p.2}))
        exact (measurable_of_countable (fun b_val : Bool => if b_val then (1 : ℝ) else 0)).comp
          (h_decide_meas _ h_ex_ms)
      exact h1.inter (isOpen_Ioi.measurableSet.preimage h_sw_meas)

    have hB_sw_bound : ∀ N_cap : ℕ,
        walkMeasure (B_sw N_cap) ≤
          ENNReal.ofReal (2 * (P.N : ℝ) * (U_max + C_init) / (bG * Λ_sw)) := by
      intro N_cap
      let mask_j : Fin P.N → ℕ → WalkSpace → Bool := fun j n om =>
        (mask₀ om && activeM n om) && !sliceIsTiny S P bG j (walkPos ρ om) n
      let Z_j : Fin P.N → WalkSpace → ℝ := fun j om =>
        ∑ n ∈ Finset.range N_cap,
          if mask_j j n om then
            -Real.log ‖sliceSpeedSeq S P.N j.val (walkPos ρ om (n + 1))‖ +
              Real.log ‖sliceSpeedSeq S P.N j.val (walkPos ρ om n)‖
          else 0
      have hZ_j_int_zero : ∀ j : Fin P.N,
          MeasureTheory.Integrable (Z_j j) walkMeasure ∧
          (∫ om, Z_j j om ∂walkMeasure) = 0 := by
        intro j
        refine h_zero_mean_real N_cap 1 (mask_j j)
          (fun y => Real.log ‖sliceSpeedSeq S P.N j.val y‖) zero_le_one
          (h_logSpeed_cont j) (h_avg_logSpeed hAdm j) (fun n _ => ?_) (fun om n _ _ => ?_)
        · have hm0 := h_mask₀_mp n
          have hm1 := h_activeM_mp n
          have hm2 := h_tiny_mp j n
          have h_m : Measurable (mask_j j n) := by
            have : mask_j j n =
                (fun p : Bool × Bool × Bool => (p.1 && p.2.1) && !p.2.2) ∘
                (fun om => (mask₀ om, (activeM n om, sliceIsTiny S P bG j (walkPos ρ om) n))) := rfl
            rw [this]
            exact (measurable_of_countable _).comp (hm0.1.prodMk (hm1.1.prodMk hm2.1))
          refine ⟨h_m, fun om₁ om₂ h_eq => ?_⟩
          simp [mask_j, hm0.2 om₁ om₂ h_eq, hm1.2 om₁ om₂ h_eq, hm2.2 om₁ om₂ h_eq]
        · let z_step : ℂ :=
            (ρ (walkPos ρ om n) : ℂ) * Complex.exp ((om (n + 1) : ℂ) * Complex.I)
          have hz_le : ‖z_step‖ ≤ ρ (walkPos ρ om n) := by
            simp [z_step, abs_of_nonneg (hρ_nn _)]
          simpa [walkPos, z_step] using hAdm.jump_log_speed _ (h_walk_reg om n) z_step hz_le j
      let Y_sw : WalkSpace → ℝ := fun om =>
        2 * (∑ j : Fin P.N, Z_j j om) + 2 * (P.N : ℝ) * (U_max + C_init)
      have hY_int : MeasureTheory.Integrable Y_sw walkMeasure :=
        ((MeasureTheory.integrable_finset_sum _ fun j _ => (hZ_j_int_zero j).1).const_mul 2).add
          (MeasureTheory.integrable_const _)
      have hY_exp : (∫ om, Y_sw om ∂walkMeasure) = 2 * (P.N : ℝ) * (U_max + C_init) := by
        dsimp only [Y_sw]
        rw [MeasureTheory.integral_add
          ((MeasureTheory.integrable_finset_sum _ fun j _ => (hZ_j_int_zero j).1).const_mul 2)
          (MeasureTheory.integrable_const _),
          MeasureTheory.integral_const_mul,
          MeasureTheory.integral_finset_sum _ fun j _ => (hZ_j_int_zero j).1]
        have h_sum0 : (∑ j : Fin P.N, ∫ om, Z_j j om ∂walkMeasure) = 0 :=
          Finset.sum_eq_zero fun j _ => (hZ_j_int_zero j).2
        rw [h_sum0, mul_zero, zero_add]
        simp
      have h_dom_Y : ∀ om : WalkSpace,
          (B_sw N_cap).indicator (fun _ => bG * Λ_sw) om ≤ Y_sw om := by
        intro om
        by_cases hA : om ∈ A₀
        · have hm0_t : mask₀ om = true := decide_eq_true hA
          let K := τ_tr N_cap om
          have hK_le_N : K ≤ N_cap := hτ_tr_le N_cap om
          have h_Z_eq_hold : ∀ j : Fin P.N,
              Z_j j om = ∑ n ∈ Finset.range K,
                if !sliceIsTiny S P bG j (walkPos ρ om) n then
                  -Real.log ‖sliceSpeedSeq S P.N j.val (walkPos ρ om (n + 1))‖ +
                    Real.log ‖sliceSpeedSeq S P.N j.val (walkPos ρ om n)‖
                else 0 := by
            intro j
            dsimp only [Z_j]
            rw [← Finset.sum_subset (Finset.range_mono hK_le_N)]
            · refine Finset.sum_congr rfl fun n hn => ?_
              have hn_K : n < K := Finset.mem_range.mp hn
              have hn_N : n < N_cap := lt_of_lt_of_le hn_K hK_le_N
              have h_act : activeM n om = true := (hτ_tr_lt_iff N_cap n om hn_N).mp hn_K
              simp [mask_j, hm0_t, h_act]
            · intro n hn_N hn_not_K
              have hn_lt_N : n < N_cap := Finset.mem_range.mp hn_N
              have h_not_lt : ¬ (n < K) := Finset.mem_range.not.mp hn_not_K
              have h_act_f : activeM n om = false := by
                cases hb : activeM n om
                · rfl
                · exfalso; exact h_not_lt ((hτ_tr_lt_iff N_cap n om hn_lt_N).mpr hb)
              simp [mask_j, h_act_f]
          have h_init_j : ∀ j : Fin P.N,
              -C_init ≤ Real.log ‖sliceSpeedSeq S P.N j.val (walkPos ρ om 0)‖ :=
            fun j => (hC_init_real (om 0) ⟨hA.1, hA.2.le⟩ j).1
          have h_term_j : ∀ j : Fin P.N,
              Real.log ‖sliceSpeedSeq S P.N j.val (walkPos ρ om K)‖ ≤ U_max := by
            intro j
            cases hK_eq : K with
            | zero =>
                have h_up := (hC_init_real (om 0) ⟨hA.1, hA.2.le⟩ j).2
                have : C_f * (M + 2) ≥ 0 := by positivity
                dsimp [walkPos, U_max]; linarith
            | succ r =>
                have hr_lt_K : r < K := by omega
                have hr_lt_N : r < N_cap := lt_of_lt_of_le hr_lt_K hK_le_N
                have h_act_r : activeM r om = true := (hτ_tr_lt_iff N_cap r om hr_lt_N).mp hr_lt_K
                simp only [activeM, decide_eq_true_eq] at h_act_r
                have h_ld_r : sliceLogDepth S P j (walkPos ρ om r) ≤ M := by
                  have h1 : sliceHistory S P ρ om j r ≤ H_sup om r :=
                    Finset.le_sup' (fun i => sliceHistory S P ρ om i r) (Finset.mem_univ j)
                  have h2 : sliceLogDepth S P j (walkPos ρ om r) ≤ sliceHistory S P ρ om j r :=
                    Finset.le_sup' (fun l => sliceLogDepth S P j (walkPos ρ om l))
                      (Finset.mem_range.mpr (Nat.lt_succ_self r))
                  linarith
                let z_step : ℂ :=
                  (ρ (walkPos ρ om r) : ℂ) * Complex.exp ((om (r + 1) : ℂ) * Complex.I)
                have hz_le : ‖z_step‖ ≤ ρ (walkPos ρ om r) := by
                  simp [z_step, abs_of_nonneg (hρ_nn _)]
                have h_up : Real.log ‖sliceSpeedSeq S P.N j.val (walkPos ρ om (r + 1))‖ ≤
                    C_f * (M + 2) := by
                  simpa [walkPos, z_step] using
                    h_depth_speed_upper hAdm (walkPos ρ om r) (h_walk_reg om r) z_step hz_le j h_ld_r
                dsimp [U_max]; linarith
          have h_pot := h_switches_le bG U_max C_init (walkPos ρ om) K hbG_pos hU_max_nn
            h_init_j h_term_j
          have hY_ge_sw : bG * (sliceJointSwitches S P bG (walkPos ρ om) K : ℝ) ≤ Y_sw om := by
            dsimp only [Y_sw]
            have h_sum_eq : (∑ j : Fin P.N, Z_j j om) =
                ∑ j : Fin P.N, ∑ n ∈ Finset.range K,
                  if !sliceIsTiny S P bG j (walkPos ρ om) n then
                    -Real.log ‖sliceSpeedSeq S P.N j.val (walkPos ρ om (n + 1))‖ +
                      Real.log ‖sliceSpeedSeq S P.N j.val (walkPos ρ om n)‖
                  else 0 := Finset.sum_congr rfl fun j _ => h_Z_eq_hold j
            rw [h_sum_eq]
            exact h_pot
          by_cases hB : om ∈ B_sw N_cap
          · rw [Set.indicator_of_mem hB]
            have h_gt : Λ_sw < (sliceJointSwitches S P bG (walkPos ρ om) K : ℝ) := hB.2
            exact le_trans (mul_le_mul_of_nonneg_left h_gt.le hbG_pos.le) hY_ge_sw
          · rw [Set.indicator_of_notMem hB]
            exact le_trans (by positivity) hY_ge_sw
        · have hm0_f : mask₀ om = false := decide_eq_false hA
          have h_nB : om ∉ B_sw N_cap := fun h => hA h.1
          rw [Set.indicator_of_notMem h_nB]
          have hZ0 : ∀ j : Fin P.N, Z_j j om = 0 := by
            intro j; simp [Z_j, mask_j, hm0_f]
          dsimp only [Y_sw]
          simp only [hZ0, Finset.sum_const_zero, mul_zero, zero_add]
          positivity
      have h_ind_int : MeasureTheory.Integrable
          ((B_sw N_cap).indicator fun _ => bG * Λ_sw) walkMeasure :=
        (MeasureTheory.integrable_const _).indicator (hB_sw_meas N_cap)
      have h_markov : (bG * Λ_sw) * walkMeasure.real (B_sw N_cap) ≤
          2 * (P.N : ℝ) * (U_max + C_init) := by
        have h_ii : (∫ om, (B_sw N_cap).indicator (fun _ => bG * Λ_sw) om ∂walkMeasure) =
            walkMeasure.real (B_sw N_cap) * (bG * Λ_sw) := by
          rw [MeasureTheory.integral_indicator_const _ (hB_sw_meas N_cap), smul_eq_mul,
            MeasureTheory.measureReal_def]
        have hm := MeasureTheory.integral_mono h_ind_int hY_int h_dom_Y
        linarith
      have h_real_le : walkMeasure.real (B_sw N_cap) ≤
          2 * (P.N : ℝ) * (U_max + C_init) / (bG * Λ_sw) := by
        rw [le_div_iff₀ (mul_pos hbG_pos hΛ_sw_pos)]
        linarith
      rw [MeasureTheory.measureReal_def] at h_real_le
      rw [← ENNReal.ofReal_toReal (MeasureTheory.measure_ne_top _ _)]
      exact ENNReal.ofReal_le_ofReal h_real_le

    have hB_sw_mono : Monotone B_sw := by
      intro N₁ N₂ hN om ⟨hA, hgt⟩
      refine ⟨hA, ?_⟩
      change Λ_sw < (sliceJointSwitches S P bG (walkPos ρ om) (τ_tr N₂ om) : ℝ)
      exact lt_of_lt_of_le hgt (Nat.cast_le.mpr (Finset.card_le_card
        (Finset.filter_subset_filter _ (Finset.range_mono (hτ_tr_mono hN om)))))
    have h_sub_sw : E_sw ⊆ (⋃ N_cap : ℕ, B_sw N_cap) ∪ A₀ᶜ ∪ E_stopsᶜ := by
      intro om hom
      by_cases hA : om ∈ A₀
      · by_cases hS : om ∈ E_stops
        · refine Or.inl (Or.inl (Set.mem_iUnion.mpr ⟨sliceStopTau S P ρ M om, hA, ?_⟩))
          dsimp only [E_sw] at hom
          simpa [hτ_tr_eq_tau om hS] using hom
        · exact Or.inr hS
      · exact Or.inl (Or.inr hA)
    have h_meas_sw : walkMeasure E_sw ≤
        ENNReal.ofReal (2 * (P.N : ℝ) * (U_max + C_init) / (bG * Λ_sw)) := by
      calc
        walkMeasure E_sw
          ≤ walkMeasure ((⋃ N_cap : ℕ, B_sw N_cap) ∪ A₀ᶜ ∪ E_stopsᶜ) :=
            MeasureTheory.measure_mono h_sub_sw
        _ ≤ walkMeasure ((⋃ N_cap : ℕ, B_sw N_cap) ∪ A₀ᶜ) + walkMeasure E_stopsᶜ :=
            MeasureTheory.measure_union_le _ _
        _ ≤ walkMeasure (⋃ N_cap : ℕ, B_sw N_cap) + walkMeasure A₀ᶜ + walkMeasure E_stopsᶜ :=
            add_le_add (MeasureTheory.measure_union_le _ _) le_rfl
        _ = walkMeasure (⋃ N_cap : ℕ, B_sw N_cap) := by
            rw [hA₀_compl_null, hE_stops_compl_null, add_zero, add_zero]
        _ ≤ ENNReal.ofReal (2 * (P.N : ℝ) * (U_max + C_init) / (bG * Λ_sw)) := by
            rw [hB_sw_mono.measure_iUnion]
            exact iSup_le hB_sw_bound
    have h_sw_real : walkMeasure.real E_sw ≤
        2 * (P.N : ℝ) * (U_max + C_init) / (bG * Λ_sw) := by
      rw [MeasureTheory.measureReal_def]
      have h_nn : 0 ≤ 2 * (P.N : ℝ) * (U_max + C_init) / (bG * Λ_sw) := by positivity
      calc
        (walkMeasure E_sw).toReal
          ≤ (ENNReal.ofReal (2 * (P.N : ℝ) * (U_max + C_init) / (bG * Λ_sw))).toReal :=
            ENNReal.toReal_mono ENNReal.ofReal_ne_top h_meas_sw
        _ = 2 * (P.N : ℝ) * (U_max + C_init) / (bG * Λ_sw) := ENNReal.toReal_ofReal h_nn
    refine le_trans h_sw_real ?_
    
    have h_mul_D : (6 * (P.N : ℝ) * (3 * C_f + 2 * C_init)) * ε_star ≤ b * δ := by
      apply h_le_mul_of_div (mul_pos hb_pos hδ_pos)
      have t1 : 0 ≤ (C_init + 1) / b := by positivity
      have t3 : 0 ≤ (2 + 2 * C_log) / b := by positivity
      have t4 : 0 ≤ 5 * b + Real.log 2 := by positivity
      have t5 : 0 ≤ 3 * (P.N : ℝ) * (4 * S.H ^ 2 + 2 * C_clk) / (b * δ) := by positivity
      have t6 : 0 ≤ 9 * (P.N : ℝ) * (S.H ^ 2 + (1 / 2 : ℝ) * C_clk) / (b * δ) := by positivity
      dsimp [D_big]; linarith
    have h_denom : bG * Λ_sw = b * M ^ (1 + η) := by
      dsimp only [bG, G_scale, Λ_sw]
      rw [mul_assoc, ← Real.rpow_add hM_pos]
      ring_nf
    have h_num_le : U_max + C_init ≤ (3 * C_f + 2 * C_init) * M := by
      dsimp only [U_max]
      nlinarith [hM_ge_two, hC_f_ge_one, hC_init_ge]
    have h_M_div : M / M ^ (1 + η) = M ^ (-η) := by
      have h_id : M = M ^ (1 : ℝ) := (Real.rpow_one M).symm
      conv_lhs => enter [1]; rw [h_id]
      rw [← Real.rpow_sub hM_pos]
      ring_nf
    calc
      2 * (P.N : ℝ) * (U_max + C_init) / (bG * Λ_sw)
        ≤ 2 * (P.N : ℝ) * ((3 * C_f + 2 * C_init) * M) / (b * M ^ (1 + η)) := by
          rw [h_denom]
          exact div_le_div_of_nonneg_right
            (mul_le_mul_of_nonneg_left h_num_le (by positivity)) (by positivity)
      _ = (2 * (P.N : ℝ) * (3 * C_f + 2 * C_init) / b) * (M / M ^ (1 + η)) := by ring
      _ = (2 * (P.N : ℝ) * (3 * C_f + 2 * C_init) / b) * M ^ (-η) := by rw [h_M_div]
      _ ≤ (2 * (P.N : ℝ) * (3 * C_f + 2 * C_init) / b) * ε_star :=
          mul_le_mul_of_nonneg_left hM_neg_η (by positivity)
      _ = ((6 * (P.N : ℝ) * (3 * C_f + 2 * C_init)) * ε_star) / (3 * b) := by ring
      _ ≤ (b * δ) / (3 * b) :=
          div_le_div_of_nonneg_right h_mul_D (by positivity)
      _ = δ / 3 := by field_simp

  
  let lam_mod : ℝ := (1 / 2 : ℝ) * Real.exp (6 * bG)
  have hlam_mod_pos : 0 < lam_mod := by positivity
  let E_mod : Fin P.N → Fin 2 → Set WalkSpace := fun j ι =>
    {om : WalkSpace |
      ∃ m ≤ sliceStopTau S P ρ M om,
        lam_mod < ‖sliceModPosMart S P bG r_star j ι (walkPos ρ om) m‖}
  have hE_mod_each : ∀ (j : Fin P.N) (ι : Fin 2),
      walkMeasure.real (E_mod j ι) ≤
        (Real.exp (10 * bG) * S.H ^ 2 + (1 / 2 : ℝ) * C_clk) / lam_mod ^ 2 := by
    intro j ι
    let B_mod : ℕ → Set WalkSpace := fun N_cap =>
      {om : WalkSpace |
        om ∈ A₀ ∧ om ∈ E_stops ∧ sliceStopTau S P ρ M om ≤ N_cap ∧
        ∃ m ≤ sliceStopTau S P ρ M om,
          lam_mod < ‖sliceModPosMart S P bG r_star j ι (walkPos ρ om) m‖}
    have hB_mod_bound : ∀ N_cap : ℕ,
        walkMeasure (B_mod N_cap) ≤
          ENNReal.ofReal
            ((Real.exp (10 * bG) * S.H ^ 2 + (1 / 2 : ℝ) * C_clk) / lam_mod ^ 2) := by
      intro N_cap
      let coeff_mod : ℕ → WalkSpace → ℂ := fun n om =>
        if (mask₀ om && activeM n om) &&
            (sliceAngCutOK S P r_star (walkPos ρ om) n &&
              !sliceIsTiny S P bG j (walkPos ρ om) n) then (1 : ℂ) else 0
      have hc_mp : ∀ n < N_cap, Measurable (coeff_mod n) ∧ prefDet n (coeff_mod n) := by
        intro n _
        have hm0 := h_mask₀_mp n
        have hm1 := h_activeM_mp n
        have hm2 := h_angCut_mp n
        have hm3 := h_tiny_mp j n
        have h_m : Measurable (coeff_mod n) := by
          have : coeff_mod n =
              (fun p : Bool × Bool × Bool × Bool =>
                if (p.1 && p.2.1) && (p.2.2.1 && !p.2.2.2) then (1 : ℂ) else 0) ∘
              (fun om => (mask₀ om, (activeM n om,
                (sliceAngCutOK S P r_star (walkPos ρ om) n,
                 sliceIsTiny S P bG j (walkPos ρ om) n)))) := rfl
          rw [this]
          exact (measurable_of_countable _).comp
            (hm0.1.prodMk (hm1.1.prodMk (hm2.1.prodMk hm3.1)))
        refine ⟨h_m, fun om₁ om₂ h_eq => ?_⟩
        simp [coeff_mod, hm0.2 om₁ om₂ h_eq, hm1.2 om₁ om₂ h_eq,
          hm2.2 om₁ om₂ h_eq, hm3.2 om₁ om₂ h_eq]
      have hc_step_bd : ∀ om : WalkSpace, ∀ n < N_cap,
          ‖coeff_mod n om *
            (slicePosSeq S P.N j.val (walkPos ρ om (n + 1)) ι -
              slicePosSeq S P.N j.val (walkPos ρ om n) ι)‖ ≤ 1 := by
        intro om n _
        dsimp only [coeff_mod]
        split_ifs
        · rw [one_mul]
          let z_step : ℂ :=
            (ρ (walkPos ρ om n) : ℂ) * Complex.exp ((om (n + 1) : ℂ) * Complex.I)
          have hz_le : ‖z_step‖ ≤ ρ (walkPos ρ om n) := by
            simp [z_step, abs_of_nonneg (hρ_nn _)]
          have h_pi := norm_le_pi_norm
            (slicePosSeq S P.N j.val (walkPos ρ om (n + 1)) -
              slicePosSeq S P.N j.val (walkPos ρ om n)) ι
          have h_jp : ‖slicePosSeq S P.N j.val (walkPos ρ om (n + 1)) -
              slicePosSeq S P.N j.val (walkPos ρ om n)‖ ≤ 1 := by
            simpa [walkPos, z_step] using hAdm.jump_pos _ (h_walk_reg om n) z_step hz_le j
          exact le_trans h_pi h_jp
        · simp
      have h_l2 := h_l2_maximal N_cap 1 lam_mod coeff_mod
        (fun w => slicePosSeq S P.N j.val w ι) zero_le_one hlam_mod_pos
        (h_pos_holo j ι).continuousOn (h_avg_pos hAdm j ι) hc_mp hc_step_bd
      
      let Δ_sq : ℕ → WalkSpace → ℝ := fun n om =>
        ‖coeff_mod n om *
          (slicePosSeq S P.N j.val (walkPos ρ om (n + 1)) ι -
            slicePosSeq S P.N j.val (walkPos ρ om n) ι)‖ ^ 2
      have hΔ_sq_int : ∀ n < N_cap, MeasureTheory.Integrable (Δ_sq n) walkMeasure := by
        intro n hn
        have hm : Measurable (Δ_sq n) :=
          (((hc_mp n hn).1.mul
            ((h_obs (fun w => slicePosSeq S P.N j.val w ι) (n + 1) (h_pos_holo j ι).continuousOn).1.sub
             (h_obs (fun w => slicePosSeq S P.N j.val w ι) n (h_pos_holo j ι).continuousOn).1)).norm).pow_const 2
        refine MeasureTheory.Integrable.of_bound hm.aestronglyMeasurable 1
          (Filter.Eventually.of_forall fun om => ?_)
        rw [Real.norm_of_nonneg (sq_nonneg _)]
        have hb := hc_step_bd om n hn
        nlinarith [norm_nonneg (coeff_mod n om *
          (slicePosSeq S P.N j.val (walkPos ρ om (n + 1)) ι -
            slicePosSeq S P.N j.val (walkPos ρ om n) ι))]
      have h_sum_int : MeasureTheory.Integrable
          (fun om => ∑ n ∈ Finset.range N_cap, Δ_sq n om) walkMeasure :=
        MeasureTheory.integrable_finset_sum _ fun n hn => hΔ_sq_int n (Finset.mem_range.mp hn)
      let V_dom : WalkSpace → ℝ := fun om =>
        (1 / 2 : ℝ) * Real.exp (10 * bG) *
          (∑ n ∈ Finset.range (sliceStopTau S P ρ M om),
            ‖sliceImpactSeq S P.N j.val (walkPos ρ om (n + 1)) -
              sliceImpactSeq S P.N j.val (walkPos ρ om n)‖ ^ 2) +
        (1 / 2 : ℝ) *
          (∑ n ∈ Finset.range (sliceStopTau S P ρ M om), (ρ (walkPos ρ om n)) ^ 2)
      have h_imp_int := hBase.impact_sq_sum M ρ hAdm j
      have h_clk_int := hBase.walk_clock M ρ hAdm
      have hV_dom_int : MeasureTheory.Integrable V_dom walkMeasure :=
        (h_imp_int.1.const_mul _).add (h_clk_int.1.const_mul _)
      have h_ae_le : (fun om => ∑ n ∈ Finset.range N_cap, Δ_sq n om) ≤ᵐ[walkMeasure] V_dom := by
        filter_upwards [hE_stops_ae] with om hom_stops
        have h_each_n : ∀ n ∈ Finset.range N_cap,
            Δ_sq n om ≤
              if n < sliceStopTau S P ρ M om then
                (1 / 2 : ℝ) * Real.exp (10 * bG) *
                  ‖sliceImpactSeq S P.N j.val (walkPos ρ om (n + 1)) -
                    sliceImpactSeq S P.N j.val (walkPos ρ om n)‖ ^ 2 +
                (1 / 2 : ℝ) * (ρ (walkPos ρ om n)) ^ 2
              else 0 := by
          intro n _
          dsimp only [Δ_sq, coeff_mod]
          split_ifs with h_cond h_tau h_tau
          · simp only [Bool.and_eq_true, Bool.not_eq_true'] at h_cond
            rcases h_cond with ⟨⟨hm0_t, _⟩, ⟨h_ac, h_not_tiny⟩⟩
            have hA : om ∈ A₀ := of_decide_eq_true hm0_t
            have h0_mod : -2 * bG < Real.log ‖sliceSpeedSeq S P.N j.val (walkPos ρ om 0)‖ :=
              lt_of_lt_of_le h_mod_init_cond (hC_init_real (om 0) ⟨hA.1, hA.2.le⟩ j).1
            have hn_mod : -2 * bG < Real.log ‖sliceSpeedSeq S P.N j.val (walkPos ρ om n)‖ :=
              h_mod_inv bG j (walkPos ρ om) n hbG_pos h0_mod h_not_tiny
            have hn_ang : ‖sliceAngleSeq S P.N j.val (walkPos ρ om n)‖ ≤ r_star :=
              (of_decide_eq_true h_ac) n le_rfl j
            rw [one_mul]
            let z_step : ℂ :=
              (ρ (walkPos ρ om n) : ℂ) * Complex.exp ((om (n + 1) : ℂ) * Complex.I)
            have hz_le : ‖z_step‖ ≤ ρ (walkPos ρ om n) := by
              simp [z_step, abs_of_nonneg (hρ_nn _)]
            simpa [walkPos, z_step] using h_mod_step_sq hAdm h_Sc_exp_cond h_5bG_cond
              (walkPos ρ om n) (h_walk_reg om n) z_step hz_le j ι hn_ang hn_mod
          · simp only [Bool.and_eq_true] at h_cond
            exfalso
            exact h_tau ((h_active_iff_tau om hom_stops n).mp h_cond.1.2)
          · simp only [zero_mul, norm_zero, ne_eq, OfNat.ofNat_ne_zero, not_false_eq_true, zero_pow]
            positivity
          · simp
        calc
          (∑ n ∈ Finset.range N_cap, Δ_sq n om)
            ≤ ∑ n ∈ Finset.range N_cap,
                (if n < sliceStopTau S P ρ M om then
                  (1 / 2 : ℝ) * Real.exp (10 * bG) *
                    ‖sliceImpactSeq S P.N j.val (walkPos ρ om (n + 1)) -
                      sliceImpactSeq S P.N j.val (walkPos ρ om n)‖ ^ 2 +
                  (1 / 2 : ℝ) * (ρ (walkPos ρ om n)) ^ 2
                else 0) := Finset.sum_le_sum h_each_n
          _ = ∑ n ∈ (Finset.range N_cap).filter (· < sliceStopTau S P ρ M om),
                ((1 / 2 : ℝ) * Real.exp (10 * bG) *
                  ‖sliceImpactSeq S P.N j.val (walkPos ρ om (n + 1)) -
                    sliceImpactSeq S P.N j.val (walkPos ρ om n)‖ ^ 2 +
                (1 / 2 : ℝ) * (ρ (walkPos ρ om n)) ^ 2) := (Finset.sum_filter _ _).symm
          _ ≤ ∑ n ∈ Finset.range (sliceStopTau S P ρ M om),
                ((1 / 2 : ℝ) * Real.exp (10 * bG) *
                  ‖sliceImpactSeq S P.N j.val (walkPos ρ om (n + 1)) -
                    sliceImpactSeq S P.N j.val (walkPos ρ om n)‖ ^ 2 +
                (1 / 2 : ℝ) * (ρ (walkPos ρ om n)) ^ 2) := by
              refine Finset.sum_le_sum_of_subset_of_nonneg ?_ (fun _ _ _ => by positivity)
              intro n hn
              exact Finset.mem_range.mpr (Finset.mem_filter.mp hn).2
          _ = V_dom om := by
              dsimp only [V_dom]
              rw [Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.mul_sum]
      have h_var_total : (∑ n ∈ Finset.range N_cap, ∫ om, Δ_sq n om ∂walkMeasure) ≤
          Real.exp (10 * bG) * S.H ^ 2 + (1 / 2 : ℝ) * C_clk := by
        rw [← MeasureTheory.integral_finset_sum _ fun n hn => hΔ_sq_int n (Finset.mem_range.mp hn)]
        calc
          (∫ om, (∑ n ∈ Finset.range N_cap, Δ_sq n om) ∂walkMeasure)
            ≤ ∫ om, V_dom om ∂walkMeasure :=
              MeasureTheory.integral_mono_ae h_sum_int hV_dom_int h_ae_le
          _ = (1 / 2 : ℝ) * Real.exp (10 * bG) *
                (∫ om, (∑ n ∈ Finset.range (sliceStopTau S P ρ M om),
                  ‖sliceImpactSeq S P.N j.val (walkPos ρ om (n + 1)) -
                    sliceImpactSeq S P.N j.val (walkPos ρ om n)‖ ^ 2) ∂walkMeasure) +
              (1 / 2 : ℝ) *
                (∫ om, (∑ n ∈ Finset.range (sliceStopTau S P ρ M om),
                  (ρ (walkPos ρ om n)) ^ 2) ∂walkMeasure) := by
              dsimp only [V_dom]
              rw [MeasureTheory.integral_add (h_imp_int.1.const_mul _) (h_clk_int.1.const_mul _),
                MeasureTheory.integral_const_mul, MeasureTheory.integral_const_mul]
          _ ≤ (1 / 2 : ℝ) * Real.exp (10 * bG) * (2 * S.H ^ 2) + (1 / 2 : ℝ) * C_clk := by
              refine add_le_add
                (mul_le_mul_of_nonneg_left h_imp_int.2 (by positivity))
                (mul_le_mul_of_nonneg_left h_clk_int.2 (by positivity))
          _ = Real.exp (10 * bG) * S.H ^ 2 + (1 / 2 : ℝ) * C_clk := by ring
      have hB_sub : B_mod N_cap ⊆
          {om : WalkSpace | ∃ m ≤ N_cap,
            lam_mod < ‖∑ n ∈ Finset.range m,
              coeff_mod n om *
                (slicePosSeq S P.N j.val (walkPos ρ om (n + 1)) ι -
                  slicePosSeq S P.N j.val (walkPos ρ om n) ι)‖} := by
        intro om ⟨hA, hS, h_tau_N, m, hm_tau, hgt⟩
        refine ⟨m, le_trans hm_tau h_tau_N, ?_⟩
        have hm0_t : mask₀ om = true := decide_eq_true hA
        have h_eq_mart :
            (∑ n ∈ Finset.range m,
              coeff_mod n om *
                (slicePosSeq S P.N j.val (walkPos ρ om (n + 1)) ι -
                  slicePosSeq S P.N j.val (walkPos ρ om n) ι)) =
            sliceModPosMart S P bG r_star j ι (walkPos ρ om) m := by
          dsimp only [sliceModPosMart, coeff_mod]
          refine Finset.sum_congr rfl fun n hn => ?_
          have hn_tau : n < sliceStopTau S P ρ M om := lt_of_lt_of_le (Finset.mem_range.mp hn) hm_tau
          have h_act : activeM n om = true := (h_active_iff_tau om hS n).mpr hn_tau
          cases sliceAngCutOK S P r_star (walkPos ρ om) n <;>
            cases sliceIsTiny S P bG j (walkPos ρ om) n <;>
            simp [hm0_t, h_act]
        rwa [h_eq_mart]
      have h_real_B : walkMeasure.real (B_mod N_cap) ≤
          (Real.exp (10 * bG) * S.H ^ 2 + (1 / 2 : ℝ) * C_clk) / lam_mod ^ 2 :=
        le_trans (MeasureTheory.measureReal_mono hB_sub)
          (le_trans h_l2 (div_le_div_of_nonneg_right h_var_total (sq_nonneg _)))
      rw [MeasureTheory.measureReal_def] at h_real_B
      rw [← ENNReal.ofReal_toReal (MeasureTheory.measure_ne_top _ _)]
      exact ENNReal.ofReal_le_ofReal h_real_B

    have hB_mod_mono : Monotone B_mod := by
      intro N₁ N₂ hN om ⟨hA, hS, h_tau, hex⟩
      exact ⟨hA, hS, le_trans h_tau hN, hex⟩
    have h_sub_mod : E_mod j ι ⊆ (⋃ N_cap : ℕ, B_mod N_cap) ∪ A₀ᶜ ∪ E_stopsᶜ := by
      intro om hom
      by_cases hA : om ∈ A₀
      · by_cases hS : om ∈ E_stops
        · exact Or.inl (Or.inl (Set.mem_iUnion.mpr ⟨sliceStopTau S P ρ M om, hA, hS, le_rfl, hom⟩))
        · exact Or.inr hS
      · exact Or.inl (Or.inr hA)
    have h_meas_mod : walkMeasure (E_mod j ι) ≤
        ENNReal.ofReal
          ((Real.exp (10 * bG) * S.H ^ 2 + (1 / 2 : ℝ) * C_clk) / lam_mod ^ 2) := by
      calc
        walkMeasure (E_mod j ι)
          ≤ walkMeasure ((⋃ N_cap : ℕ, B_mod N_cap) ∪ A₀ᶜ ∪ E_stopsᶜ) :=
            MeasureTheory.measure_mono h_sub_mod
        _ ≤ walkMeasure ((⋃ N_cap : ℕ, B_mod N_cap) ∪ A₀ᶜ) + walkMeasure E_stopsᶜ :=
            MeasureTheory.measure_union_le _ _
        _ ≤ walkMeasure (⋃ N_cap : ℕ, B_mod N_cap) + walkMeasure A₀ᶜ + walkMeasure E_stopsᶜ :=
            add_le_add (MeasureTheory.measure_union_le _ _) le_rfl
        _ = walkMeasure (⋃ N_cap : ℕ, B_mod N_cap) := by
            rw [hA₀_compl_null, hE_stops_compl_null, add_zero, add_zero]
        _ ≤ ENNReal.ofReal
              ((Real.exp (10 * bG) * S.H ^ 2 + (1 / 2 : ℝ) * C_clk) / lam_mod ^ 2) := by
            rw [hB_mod_mono.measure_iUnion]
            exact iSup_le hB_mod_bound
    rw [MeasureTheory.measureReal_def]
    have h_nn : 0 ≤ (Real.exp (10 * bG) * S.H ^ 2 + (1 / 2 : ℝ) * C_clk) / lam_mod ^ 2 := by
      positivity
    calc
      (walkMeasure (E_mod j ι)).toReal
        ≤ (ENNReal.ofReal
            ((Real.exp (10 * bG) * S.H ^ 2 + (1 / 2 : ℝ) * C_clk) / lam_mod ^ 2)).toReal :=
          ENNReal.toReal_mono ENNReal.ofReal_ne_top h_meas_mod
      _ = (Real.exp (10 * bG) * S.H ^ 2 + (1 / 2 : ℝ) * C_clk) / lam_mod ^ 2 :=
          ENNReal.toReal_ofReal h_nn

  have hE_mod_union_le :
      walkMeasure.real
        (⋃ j ∈ (Finset.univ : Finset (Fin P.N)),
          ⋃ ι ∈ (Finset.univ : Finset (Fin 2)), E_mod j ι) ≤ δ / 3 := by
    have h_single_le :
        (Real.exp (10 * bG) * S.H ^ 2 + (1 / 2 : ℝ) * C_clk) / lam_mod ^ 2 ≤
          ((4 * S.H ^ 2 + 2 * C_clk) / (2 * b)) * ε_star := by
      have he10 : 1 ≤ Real.exp (10 * bG) := Real.one_le_exp (by positivity)
      have h_num : Real.exp (10 * bG) * S.H ^ 2 + (1 / 2 : ℝ) * C_clk ≤
          Real.exp (10 * bG) * (S.H ^ 2 + (1 / 2 : ℝ) * C_clk) := by nlinarith
      have h_lam_sq : lam_mod ^ 2 = (1 / 4 : ℝ) * Real.exp (12 * bG) := by
        dsimp only [lam_mod]
        rw [mul_pow, sq (Real.exp (6 * bG)), ← Real.exp_add]
        ring_nf
      have h_exp2 : 2 * bG ≤ Real.exp (2 * bG) :=
        le_trans (by linarith) (Real.add_one_le_exp (2 * bG))
      have h_inv_2bG : (2 * bG)⁻¹ ≤ ε_star / (2 * b) := by
        rw [inv_le_iff_one_le_mul₀ (by positivity)]
        calc
          (1 : ℝ) ≤ ε_star * G_scale := h_one_le_eps_G
          _ = (ε_star / (2 * b)) * (2 * bG) := by dsimp [bG]; field_simp
      calc
        (Real.exp (10 * bG) * S.H ^ 2 + (1 / 2 : ℝ) * C_clk) / lam_mod ^ 2
          ≤ (Real.exp (10 * bG) * (S.H ^ 2 + (1 / 2 : ℝ) * C_clk)) /
              ((1 / 4 : ℝ) * Real.exp (12 * bG)) := by
            rw [h_lam_sq]
            exact div_le_div_of_nonneg_right h_num (by positivity)
        _ = (4 * S.H ^ 2 + 2 * C_clk) * (Real.exp (10 * bG) / Real.exp (12 * bG)) := by ring
        _ = (4 * S.H ^ 2 + 2 * C_clk) * (Real.exp (2 * bG))⁻¹ := by
            congr 1
            rw [← Real.exp_sub, show 10 * bG - 12 * bG = -(2 * bG) by ring, Real.exp_neg]
        _ ≤ (4 * S.H ^ 2 + 2 * C_clk) * (2 * bG)⁻¹ :=
            mul_le_mul_of_nonneg_left
              (inv_anti₀ (by positivity) h_exp2) (by positivity)
        _ ≤ (4 * S.H ^ 2 + 2 * C_clk) * (ε_star / (2 * b)) :=
            mul_le_mul_of_nonneg_left h_inv_2bG (by positivity)
        _ = ((4 * S.H ^ 2 + 2 * C_clk) / (2 * b)) * ε_star := by ring
    have h_mul_D : (3 * (P.N : ℝ) * (4 * S.H ^ 2 + 2 * C_clk)) * ε_star ≤ b * δ := by
      apply h_le_mul_of_div (mul_pos hb_pos hδ_pos)
      have t1 : 0 ≤ (C_init + 1) / b := by positivity
      have t2 : 0 ≤ 6 * (P.N : ℝ) * (3 * C_f + 2 * C_init) / (b * δ) := by positivity
      have t3 : 0 ≤ (2 + 2 * C_log) / b := by positivity
      have t4 : 0 ≤ 5 * b + Real.log 2 := by positivity
      have t6 : 0 ≤ 9 * (P.N : ℝ) * (S.H ^ 2 + (1 / 2 : ℝ) * C_clk) / (b * δ) := by positivity
      dsimp [D_big]; linarith
    calc
      walkMeasure.real
          (⋃ j ∈ (Finset.univ : Finset (Fin P.N)),
            ⋃ ι ∈ (Finset.univ : Finset (Fin 2)), E_mod j ι)
        ≤ ∑ j ∈ (Finset.univ : Finset (Fin P.N)),
            walkMeasure.real (⋃ ι ∈ (Finset.univ : Finset (Fin 2)), E_mod j ι) :=
          MeasureTheory.measureReal_biUnion_finset_le _ _
      _ ≤ ∑ j ∈ (Finset.univ : Finset (Fin P.N)),
            ∑ ι ∈ (Finset.univ : Finset (Fin 2)), walkMeasure.real (E_mod j ι) :=
          Finset.sum_le_sum fun j _ => MeasureTheory.measureReal_biUnion_finset_le _ _
      _ ≤ ∑ _j ∈ (Finset.univ : Finset (Fin P.N)),
            ∑ _ι ∈ (Finset.univ : Finset (Fin 2)),
              (((4 * S.H ^ 2 + 2 * C_clk) / (2 * b)) * ε_star) :=
          Finset.sum_le_sum fun j _ => Finset.sum_le_sum fun ι _ =>
            le_trans (hE_mod_each j ι) h_single_le
      _ = (P.N : ℝ) * (2 * (((4 * S.H ^ 2 + 2 * C_clk) / (2 * b)) * ε_star)) := by
          simp [Finset.sum_const, nsmul_eq_mul]
      _ = ((3 * (P.N : ℝ) * (4 * S.H ^ 2 + 2 * C_clk)) * ε_star) / (3 * b) := by ring
      _ ≤ (b * δ) / (3 * b) := div_le_div_of_nonneg_right h_mul_D (by positivity)
      _ = δ / 3 := by field_simp

  
  let lam_tiny : ℝ := Real.exp (-bG / 3)
  have hlam_tiny_pos : 0 < lam_tiny := Real.exp_pos _
  let E_tiny : Fin P.N → Set WalkSpace := fun j =>
    {om : WalkSpace |
      ∃ m ≤ sliceStopTau S P ρ M om,
        lam_tiny < ‖sliceTinySupMart S P bG r_star j (walkPos ρ om) m‖}
  have hE_tiny_each : ∀ j : Fin P.N,
      walkMeasure.real (E_tiny j) ≤
        Real.exp (-bG) * (S.H ^ 2 + (1 / 2 : ℝ) * C_clk) / lam_tiny ^ 2 := by
    intro j
    let B_tiny : ℕ → Set WalkSpace := fun N_cap =>
      {om : WalkSpace |
        om ∈ E_stops ∧ sliceStopTau S P ρ M om ≤ N_cap ∧
        ∃ m ≤ sliceStopTau S P ρ M om,
          lam_tiny < ‖sliceTinySupMart S P bG r_star j (walkPos ρ om) m‖}
    let B_step_tiny : ℝ := 2 * Real.exp (r_star - bG) * (S.H + 1) + 1
    have hB_step_tiny_nn : 0 ≤ B_step_tiny := by positivity
    have hB_tiny_bound : ∀ N_cap : ℕ,
        walkMeasure (B_tiny N_cap) ≤
          ENNReal.ofReal
            (Real.exp (-bG) * (S.H ^ 2 + (1 / 2 : ℝ) * C_clk) / lam_tiny ^ 2) := by
      intro N_cap
      let coeff_tiny : ℕ → WalkSpace → ℂ := fun n om =>
        if activeM n om &&
            (sliceAngCutOK S P r_star (walkPos ρ om) n &&
              sliceIsTiny S P bG j (walkPos ρ om) n) then
          ((sliceRunningPosMax S P (walkPos ρ om) n : ℂ))⁻¹
        else 0
      have hc_mp : ∀ n < N_cap, Measurable (coeff_tiny n) ∧ prefDet n (coeff_tiny n) := by
        intro n _
        have hm1 := h_activeM_mp n
        have hm2 := h_angCut_mp n
        have hm3 := h_tiny_mp j n
        have hmR := h_runMax_mp n
        have h_ind_m : Measurable (fun om : WalkSpace =>
            if activeM n om &&
                (sliceAngCutOK S P r_star (walkPos ρ om) n &&
                  sliceIsTiny S P bG j (walkPos ρ om) n) then (1 : ℂ) else 0) := by
          have : (fun om : WalkSpace =>
                if activeM n om &&
                    (sliceAngCutOK S P r_star (walkPos ρ om) n &&
                      sliceIsTiny S P bG j (walkPos ρ om) n) then (1 : ℂ) else 0) =
              (fun p : Bool × Bool × Bool => if p.1 && (p.2.1 && p.2.2) then (1 : ℂ) else 0) ∘
              (fun om => (activeM n om,
                (sliceAngCutOK S P r_star (walkPos ρ om) n,
                 sliceIsTiny S P bG j (walkPos ρ om) n))) := rfl
          rw [this]
          exact (measurable_of_countable _).comp (hm1.1.prodMk (hm2.1.prodMk hm3.1))
        have h_inv_m : Measurable (fun om : WalkSpace =>
            ((sliceRunningPosMax S P (walkPos ρ om) n : ℂ))⁻¹) :=
          (Complex.measurable_ofReal.comp hmR.1).inv
        have h_m : Measurable (coeff_tiny n) := by
          have : coeff_tiny n = fun om =>
              (if activeM n om &&
                  (sliceAngCutOK S P r_star (walkPos ρ om) n &&
                    sliceIsTiny S P bG j (walkPos ρ om) n) then (1 : ℂ) else 0) *
                ((sliceRunningPosMax S P (walkPos ρ om) n : ℂ))⁻¹ := by
            funext om
            dsimp only [coeff_tiny]
            split_ifs <;> simp
          rw [this]
          exact h_ind_m.mul h_inv_m
        refine ⟨h_m, fun om₁ om₂ h_eq => ?_⟩
        simp [coeff_tiny, hm1.2 om₁ om₂ h_eq, hm2.2 om₁ om₂ h_eq,
          hm3.2 om₁ om₂ h_eq, hmR.2 om₁ om₂ h_eq]
      have h_pos_le_R : ∀ (om : WalkSpace) (n : ℕ),
          1 + ‖slicePosSeq S P.N j.val (walkPos ρ om n)‖ ≤
            sliceRunningPosMax S P (walkPos ρ om) n := by
        intro om n
        dsimp only [sliceRunningPosMax]
        have h1 : ‖slicePosSeq S P.N j.val (walkPos ρ om n)‖ ≤
            Finset.univ.sup' Finset.univ_nonempty
              (fun k : Fin P.N => ‖slicePosSeq S P.N k.val (walkPos ρ om n)‖) :=
          Finset.le_sup' (fun k : Fin P.N => ‖slicePosSeq S P.N k.val (walkPos ρ om n)‖)
            (Finset.mem_univ j)
        have h2 := Finset.le_sup'
          (fun l => Finset.univ.sup' Finset.univ_nonempty
            fun k : Fin P.N => ‖slicePosSeq S P.N k.val (walkPos ρ om l)‖)
          (Finset.mem_range.mpr (Nat.lt_succ_self n))
        linarith
      have hc_step_bd : ∀ om : WalkSpace, ∀ n < N_cap,
          ‖coeff_tiny n om *
            (sliceSupportSeq S P.N j.val (walkPos ρ om (n + 1)) -
              sliceSupportSeq S P.N j.val (walkPos ρ om n))‖ ≤ B_step_tiny := by
        intro om n _
        dsimp only [coeff_tiny]
        split_ifs with h_cond
        · simp only [Bool.and_eq_true] at h_cond
          rcases h_cond with ⟨_, h_ac, h_is_tiny⟩
          have hn_tiny : Real.log ‖sliceSpeedSeq S P.N j.val (walkPos ρ om n)‖ < -bG :=
            h_tiny_inv bG j (walkPos ρ om) n hbG_pos h_is_tiny
          have hn_ang : ‖sliceAngleSeq S P.N j.val (walkPos ρ om n)‖ ≤ r_star :=
            (of_decide_eq_true h_ac) n le_rfl j
          let z_step : ℂ :=
            (ρ (walkPos ρ om n) : ℂ) * Complex.exp ((om (n + 1) : ℂ) * Complex.I)
          have hz_le : ‖z_step‖ ≤ ρ (walkPos ρ om n) := by
            simp [z_step, abs_of_nonneg (hρ_nn _)]
          simpa [walkPos, z_step, B_step_tiny] using h_tiny_step_norm hAdm
            (walkPos ρ om n) (h_walk_reg om n) z_step hz_le j (h_pos_le_R om n) hn_ang hn_tiny
        · simp [hB_step_tiny_nn]
      have h_l2 := h_l2_maximal N_cap B_step_tiny lam_tiny coeff_tiny
        (sliceSupportSeq S P.N j.val) hB_step_tiny_nn hlam_tiny_pos
        (h_support_holo j).continuousOn (h_avg_support hAdm j) hc_mp hc_step_bd
      let Δ_sq : ℕ → WalkSpace → ℝ := fun n om =>
        ‖coeff_tiny n om *
          (sliceSupportSeq S P.N j.val (walkPos ρ om (n + 1)) -
            sliceSupportSeq S P.N j.val (walkPos ρ om n))‖ ^ 2
      have hΔ_sq_int : ∀ n < N_cap, MeasureTheory.Integrable (Δ_sq n) walkMeasure := by
        intro n hn
        have hm : Measurable (Δ_sq n) :=
          (((hc_mp n hn).1.mul
            ((h_obs (sliceSupportSeq S P.N j.val) (n + 1) (h_support_holo j).continuousOn).1.sub
             (h_obs (sliceSupportSeq S P.N j.val) n (h_support_holo j).continuousOn).1)).norm).pow_const 2
        refine MeasureTheory.Integrable.of_bound hm.aestronglyMeasurable (B_step_tiny ^ 2)
          (Filter.Eventually.of_forall fun om => ?_)
        rw [Real.norm_of_nonneg (sq_nonneg _)]
        exact pow_le_pow_left₀ (norm_nonneg _) (hc_step_bd om n hn) 2
      have h_sum_int : MeasureTheory.Integrable
          (fun om => ∑ n ∈ Finset.range N_cap, Δ_sq n om) walkMeasure :=
        MeasureTheory.integrable_finset_sum _ fun n hn => hΔ_sq_int n (Finset.mem_range.mp hn)
      let V_dom : WalkSpace → ℝ := fun om =>
        Real.exp (-bG) * (1 / 2 : ℝ) *
          (∑ n ∈ Finset.range (sliceStopTau S P ρ M om),
            ‖sliceImpactSeq S P.N j.val (walkPos ρ om (n + 1)) -
              sliceImpactSeq S P.N j.val (walkPos ρ om n)‖ ^ 2) +
        Real.exp (-bG) * (1 / 2 : ℝ) *
          (∑ n ∈ Finset.range (sliceStopTau S P ρ M om), (ρ (walkPos ρ om n)) ^ 2)
      have h_imp_int := hBase.impact_sq_sum M ρ hAdm j
      have h_clk_int := hBase.walk_clock M ρ hAdm
      have hV_dom_int : MeasureTheory.Integrable V_dom walkMeasure :=
        (h_imp_int.1.const_mul _).add (h_clk_int.1.const_mul _)
      have h_ae_le : (fun om => ∑ n ∈ Finset.range N_cap, Δ_sq n om) ≤ᵐ[walkMeasure] V_dom := by
        filter_upwards [hE_stops_ae] with om hom_stops
        have h_each_n : ∀ n ∈ Finset.range N_cap,
            Δ_sq n om ≤
              if n < sliceStopTau S P ρ M om then
                Real.exp (-bG) *
                  ((1 / 2 : ℝ) *
                    ‖sliceImpactSeq S P.N j.val (walkPos ρ om (n + 1)) -
                      sliceImpactSeq S P.N j.val (walkPos ρ om n)‖ ^ 2 +
                   (1 / 2 : ℝ) * (ρ (walkPos ρ om n)) ^ 2)
              else 0 := by
          intro n _
          dsimp only [Δ_sq, coeff_tiny]
          split_ifs with h_cond h_tau h_tau
          · simp only [Bool.and_eq_true] at h_cond
            rcases h_cond with ⟨_, h_ac, h_is_tiny⟩
            have hn_tiny : Real.log ‖sliceSpeedSeq S P.N j.val (walkPos ρ om n)‖ < -bG :=
              h_tiny_inv bG j (walkPos ρ om) n hbG_pos h_is_tiny
            have hn_ang : ‖sliceAngleSeq S P.N j.val (walkPos ρ om n)‖ ≤ r_star :=
              (of_decide_eq_true h_ac) n le_rfl j
            let z_step : ℂ :=
              (ρ (walkPos ρ om n) : ℂ) * Complex.exp ((om (n + 1) : ℂ) * Complex.I)
            have hz_le : ‖z_step‖ ≤ ρ (walkPos ρ om n) := by
              simp [z_step, abs_of_nonneg (hρ_nn _)]
            simpa [walkPos, z_step] using h_tiny_step_sq hAdm hbG_pos h_tiny_exp1_cond
              h_tiny_exp2_cond (walkPos ρ om n) (h_walk_reg om n) z_step hz_le j
              (h_pos_le_R om n) hn_ang hn_tiny
          · simp only [Bool.and_eq_true] at h_cond
            exfalso
            exact h_tau ((h_active_iff_tau om hom_stops n).mp h_cond.1)
          · simp only [zero_mul, norm_zero, ne_eq, OfNat.ofNat_ne_zero, not_false_eq_true, zero_pow]
            positivity
          · simp
        calc
          (∑ n ∈ Finset.range N_cap, Δ_sq n om)
            ≤ ∑ n ∈ Finset.range N_cap,
                (if n < sliceStopTau S P ρ M om then
                  Real.exp (-bG) *
                    ((1 / 2 : ℝ) *
                      ‖sliceImpactSeq S P.N j.val (walkPos ρ om (n + 1)) -
                        sliceImpactSeq S P.N j.val (walkPos ρ om n)‖ ^ 2 +
                     (1 / 2 : ℝ) * (ρ (walkPos ρ om n)) ^ 2)
                else 0) := Finset.sum_le_sum h_each_n
          _ = ∑ n ∈ (Finset.range N_cap).filter (· < sliceStopTau S P ρ M om),
                (Real.exp (-bG) *
                  ((1 / 2 : ℝ) *
                    ‖sliceImpactSeq S P.N j.val (walkPos ρ om (n + 1)) -
                      sliceImpactSeq S P.N j.val (walkPos ρ om n)‖ ^ 2 +
                   (1 / 2 : ℝ) * (ρ (walkPos ρ om n)) ^ 2)) := (Finset.sum_filter _ _).symm
          _ ≤ ∑ n ∈ Finset.range (sliceStopTau S P ρ M om),
                (Real.exp (-bG) *
                  ((1 / 2 : ℝ) *
                    ‖sliceImpactSeq S P.N j.val (walkPos ρ om (n + 1)) -
                      sliceImpactSeq S P.N j.val (walkPos ρ om n)‖ ^ 2 +
                   (1 / 2 : ℝ) * (ρ (walkPos ρ om n)) ^ 2)) := by
              refine Finset.sum_le_sum_of_subset_of_nonneg ?_ (fun _ _ _ => by positivity)
              intro n hn
              exact Finset.mem_range.mpr (Finset.mem_filter.mp hn).2
          _ = V_dom om := by
              dsimp only [V_dom]
              have h_dist : ∀ n, Real.exp (-bG) *
                  ((1 / 2 : ℝ) *
                    ‖sliceImpactSeq S P.N j.val (walkPos ρ om (n + 1)) -
                      sliceImpactSeq S P.N j.val (walkPos ρ om n)‖ ^ 2 +
                   (1 / 2 : ℝ) * (ρ (walkPos ρ om n)) ^ 2) =
                  Real.exp (-bG) * (1 / 2 : ℝ) *
                    ‖sliceImpactSeq S P.N j.val (walkPos ρ om (n + 1)) -
                      sliceImpactSeq S P.N j.val (walkPos ρ om n)‖ ^ 2 +
                  Real.exp (-bG) * (1 / 2 : ℝ) * (ρ (walkPos ρ om n)) ^ 2 := fun _ => by ring
              simp_rw [h_dist, Finset.sum_add_distrib, ← Finset.mul_sum]
      have h_var_total : (∑ n ∈ Finset.range N_cap, ∫ om, Δ_sq n om ∂walkMeasure) ≤
          Real.exp (-bG) * (S.H ^ 2 + (1 / 2 : ℝ) * C_clk) := by
        rw [← MeasureTheory.integral_finset_sum _ fun n hn => hΔ_sq_int n (Finset.mem_range.mp hn)]
        calc
          (∫ om, (∑ n ∈ Finset.range N_cap, Δ_sq n om) ∂walkMeasure)
            ≤ ∫ om, V_dom om ∂walkMeasure :=
              MeasureTheory.integral_mono_ae h_sum_int hV_dom_int h_ae_le
          _ = Real.exp (-bG) * (1 / 2 : ℝ) *
                (∫ om, (∑ n ∈ Finset.range (sliceStopTau S P ρ M om),
                  ‖sliceImpactSeq S P.N j.val (walkPos ρ om (n + 1)) -
                    sliceImpactSeq S P.N j.val (walkPos ρ om n)‖ ^ 2) ∂walkMeasure) +
              Real.exp (-bG) * (1 / 2 : ℝ) *
                (∫ om, (∑ n ∈ Finset.range (sliceStopTau S P ρ M om),
                  (ρ (walkPos ρ om n)) ^ 2) ∂walkMeasure) := by
              dsimp only [V_dom]
              rw [MeasureTheory.integral_add (h_imp_int.1.const_mul _) (h_clk_int.1.const_mul _),
                MeasureTheory.integral_const_mul, MeasureTheory.integral_const_mul]
          _ ≤ Real.exp (-bG) * (1 / 2 : ℝ) * (2 * S.H ^ 2) +
              Real.exp (-bG) * (1 / 2 : ℝ) * C_clk := by
              refine add_le_add
                (mul_le_mul_of_nonneg_left h_imp_int.2 (by positivity))
                (mul_le_mul_of_nonneg_left h_clk_int.2 (by positivity))
          _ = Real.exp (-bG) * (S.H ^ 2 + (1 / 2 : ℝ) * C_clk) := by ring
      have hB_sub : B_tiny N_cap ⊆
          {om : WalkSpace | ∃ m ≤ N_cap,
            lam_tiny < ‖∑ n ∈ Finset.range m,
              coeff_tiny n om *
                (sliceSupportSeq S P.N j.val (walkPos ρ om (n + 1)) -
                  sliceSupportSeq S P.N j.val (walkPos ρ om n))‖} := by
        intro om ⟨hS, h_tau_N, m, hm_tau, hgt⟩
        refine ⟨m, le_trans hm_tau h_tau_N, ?_⟩
        have h_eq_mart :
            (∑ n ∈ Finset.range m,
              coeff_tiny n om *
                (sliceSupportSeq S P.N j.val (walkPos ρ om (n + 1)) -
                  sliceSupportSeq S P.N j.val (walkPos ρ om n))) =
            sliceTinySupMart S P bG r_star j (walkPos ρ om) m := by
          dsimp only [sliceTinySupMart, coeff_tiny]
          refine Finset.sum_congr rfl fun n hn => ?_
          have hn_tau : n < sliceStopTau S P ρ M om := lt_of_lt_of_le (Finset.mem_range.mp hn) hm_tau
          have h_act : activeM n om = true := (h_active_iff_tau om hS n).mpr hn_tau
          cases sliceAngCutOK S P r_star (walkPos ρ om) n <;>
            cases sliceIsTiny S P bG j (walkPos ρ om) n <;>
            simp [h_act]
        rwa [h_eq_mart]
      have h_real_B : walkMeasure.real (B_tiny N_cap) ≤
          Real.exp (-bG) * (S.H ^ 2 + (1 / 2 : ℝ) * C_clk) / lam_tiny ^ 2 :=
        le_trans (MeasureTheory.measureReal_mono hB_sub)
          (le_trans h_l2 (div_le_div_of_nonneg_right h_var_total (sq_nonneg _)))
      rw [MeasureTheory.measureReal_def] at h_real_B
      rw [← ENNReal.ofReal_toReal (MeasureTheory.measure_ne_top _ _)]
      exact ENNReal.ofReal_le_ofReal h_real_B

    have hB_tiny_mono : Monotone B_tiny := by
      intro N₁ N₂ hN om ⟨hS, h_tau, hex⟩
      exact ⟨hS, le_trans h_tau hN, hex⟩
    have h_sub_tiny : E_tiny j ⊆ (⋃ N_cap : ℕ, B_tiny N_cap) ∪ E_stopsᶜ := by
      intro om hom
      by_cases hS : om ∈ E_stops
      · exact Or.inl (Set.mem_iUnion.mpr ⟨sliceStopTau S P ρ M om, hS, le_rfl, hom⟩)
      · exact Or.inr hS
    have h_meas_tiny : walkMeasure (E_tiny j) ≤
        ENNReal.ofReal
          (Real.exp (-bG) * (S.H ^ 2 + (1 / 2 : ℝ) * C_clk) / lam_tiny ^ 2) := by
      calc
        walkMeasure (E_tiny j)
          ≤ walkMeasure ((⋃ N_cap : ℕ, B_tiny N_cap) ∪ E_stopsᶜ) :=
            MeasureTheory.measure_mono h_sub_tiny
        _ ≤ walkMeasure (⋃ N_cap : ℕ, B_tiny N_cap) + walkMeasure E_stopsᶜ :=
            MeasureTheory.measure_union_le _ _
        _ = walkMeasure (⋃ N_cap : ℕ, B_tiny N_cap) := by rw [hE_stops_compl_null, add_zero]
        _ ≤ ENNReal.ofReal
              (Real.exp (-bG) * (S.H ^ 2 + (1 / 2 : ℝ) * C_clk) / lam_tiny ^ 2) := by
            rw [hB_tiny_mono.measure_iUnion]
            exact iSup_le hB_tiny_bound
    rw [MeasureTheory.measureReal_def]
    have h_nn : 0 ≤ Real.exp (-bG) * (S.H ^ 2 + (1 / 2 : ℝ) * C_clk) / lam_tiny ^ 2 := by
      positivity
    calc
      (walkMeasure (E_tiny j)).toReal
        ≤ (ENNReal.ofReal
            (Real.exp (-bG) * (S.H ^ 2 + (1 / 2 : ℝ) * C_clk) / lam_tiny ^ 2)).toReal :=
          ENNReal.toReal_mono ENNReal.ofReal_ne_top h_meas_tiny
      _ = Real.exp (-bG) * (S.H ^ 2 + (1 / 2 : ℝ) * C_clk) / lam_tiny ^ 2 :=
          ENNReal.toReal_ofReal h_nn

  have hE_tiny_union_le :
      walkMeasure.real (⋃ j ∈ (Finset.univ : Finset (Fin P.N)), E_tiny j) ≤ δ / 3 := by
    have h_single_le :
        Real.exp (-bG) * (S.H ^ 2 + (1 / 2 : ℝ) * C_clk) / lam_tiny ^ 2 ≤
          (3 * (S.H ^ 2 + (1 / 2 : ℝ) * C_clk) / b) * ε_star := by
      have h_lam_sq : lam_tiny ^ 2 = Real.exp (-2 * bG / 3) := by
        dsimp only [lam_tiny]
        rw [sq, ← Real.exp_add]
        ring_nf
      have h_exp3 : bG / 3 ≤ Real.exp (bG / 3) :=
        le_trans (by linarith) (Real.add_one_le_exp (bG / 3))
      have h_inv_3 : (bG / 3)⁻¹ ≤ (3 / b) * ε_star := by
        rw [inv_le_iff_one_le_mul₀ (by positivity)]
        calc
          (1 : ℝ) ≤ ε_star * G_scale := h_one_le_eps_G
          _ = ((3 / b) * ε_star) * (bG / 3) := by dsimp [bG]; field_simp
      calc
        Real.exp (-bG) * (S.H ^ 2 + (1 / 2 : ℝ) * C_clk) / lam_tiny ^ 2
          = (S.H ^ 2 + (1 / 2 : ℝ) * C_clk) * (Real.exp (-bG) / Real.exp (-2 * bG / 3)) := by
            rw [h_lam_sq]; ring
        _ = (S.H ^ 2 + (1 / 2 : ℝ) * C_clk) * (Real.exp (bG / 3))⁻¹ := by
            congr 1
            rw [← Real.exp_sub, show -bG - (-2 * bG / 3) = -(bG / 3) by ring, Real.exp_neg]
        _ ≤ (S.H ^ 2 + (1 / 2 : ℝ) * C_clk) * (bG / 3)⁻¹ :=
            mul_le_mul_of_nonneg_left (inv_anti₀ (by positivity) h_exp3) (by positivity)
        _ ≤ (S.H ^ 2 + (1 / 2 : ℝ) * C_clk) * ((3 / b) * ε_star) :=
            mul_le_mul_of_nonneg_left h_inv_3 (by positivity)
        _ = (3 * (S.H ^ 2 + (1 / 2 : ℝ) * C_clk) / b) * ε_star := by ring
    have h_mul_D : (9 * (P.N : ℝ) * (S.H ^ 2 + (1 / 2 : ℝ) * C_clk)) * ε_star ≤ b * δ := by
      apply h_le_mul_of_div (mul_pos hb_pos hδ_pos)
      have t1 : 0 ≤ (C_init + 1) / b := by positivity
      have t2 : 0 ≤ 6 * (P.N : ℝ) * (3 * C_f + 2 * C_init) / (b * δ) := by positivity
      have t3 : 0 ≤ (2 + 2 * C_log) / b := by positivity
      have t4 : 0 ≤ 5 * b + Real.log 2 := by positivity
      have t5 : 0 ≤ 3 * (P.N : ℝ) * (4 * S.H ^ 2 + 2 * C_clk) / (b * δ) := by positivity
      dsimp [D_big]; linarith
    calc
      walkMeasure.real (⋃ j ∈ (Finset.univ : Finset (Fin P.N)), E_tiny j)
        ≤ ∑ j ∈ (Finset.univ : Finset (Fin P.N)), walkMeasure.real (E_tiny j) :=
          MeasureTheory.measureReal_biUnion_finset_le _ _
      _ ≤ ∑ _j ∈ (Finset.univ : Finset (Fin P.N)),
            ((3 * (S.H ^ 2 + (1 / 2 : ℝ) * C_clk) / b) * ε_star) :=
          Finset.sum_le_sum fun j _ => le_trans (hE_tiny_each j) h_single_le
      _ = (P.N : ℝ) * ((3 * (S.H ^ 2 + (1 / 2 : ℝ) * C_clk) / b) * ε_star) := by
          simp [Finset.sum_const, nsmul_eq_mul]
      _ = ((9 * (P.N : ℝ) * (S.H ^ 2 + (1 / 2 : ℝ) * C_clk)) * ε_star) / (3 * b) := by ring
      _ ≤ (b * δ) / (3 * b) := div_le_div_of_nonneg_right h_mul_D (by positivity)
      _ = δ / 3 := by field_simp

  
  have h_target_sub :
      {om : WalkSpace |
        M ^ (1 + η - γ) <
          (sliceJointSwitches S P (b * M ^ γ) (walkPos ρ om)
            (sliceStopTau S P ρ M om) : ℝ) ∨
        ∃ m ≤ sliceStopTau S P ρ M om, ∃ j : Fin P.N,
          (∃ ι : Fin 2,
            (1 / 2 : ℝ) * Real.exp (6 * (b * M ^ γ)) <
              ‖sliceModPosMart S P (b * M ^ γ) (M ^ ρ₂) j ι (walkPos ρ om) m‖) ∨
          Real.exp (-(b * M ^ γ) / 3) <
            ‖sliceTinySupMart S P (b * M ^ γ) (M ^ ρ₂) j (walkPos ρ om) m‖} ⊆
      (E_sw ∪
        (⋃ j ∈ (Finset.univ : Finset (Fin P.N)),
          ⋃ ι ∈ (Finset.univ : Finset (Fin 2)), E_mod j ι)) ∪
        (⋃ j ∈ (Finset.univ : Finset (Fin P.N)), E_tiny j) := by
    intro om hom
    rcases hom with h_sw | ⟨m, hm, j, h_mart⟩
    · exact Or.inl (Or.inl h_sw)
    · rcases h_mart with ⟨ι, h_mod_gt⟩ | h_tiny_gt
      · refine Or.inl (Or.inr ?_)
        exact Set.mem_biUnion (Finset.mem_univ j)
          (Set.mem_biUnion (Finset.mem_univ ι) ⟨m, hm, h_mod_gt⟩)
      · refine Or.inr ?_
        exact Set.mem_biUnion (Finset.mem_univ j) ⟨m, hm, h_tiny_gt⟩

  calc
    walkMeasure.real {om : WalkSpace |
        M ^ (1 + η - γ) <
          (sliceJointSwitches S P (b * M ^ γ) (walkPos ρ om)
            (sliceStopTau S P ρ M om) : ℝ) ∨
        ∃ m ≤ sliceStopTau S P ρ M om, ∃ j : Fin P.N,
          (∃ ι : Fin 2,
            (1 / 2 : ℝ) * Real.exp (6 * (b * M ^ γ)) <
              ‖sliceModPosMart S P (b * M ^ γ) (M ^ ρ₂) j ι (walkPos ρ om) m‖) ∨
          Real.exp (-(b * M ^ γ) / 3) <
            ‖sliceTinySupMart S P (b * M ^ γ) (M ^ ρ₂) j (walkPos ρ om) m‖}
      ≤ walkMeasure.real
          ((E_sw ∪
            (⋃ j ∈ (Finset.univ : Finset (Fin P.N)),
              ⋃ ι ∈ (Finset.univ : Finset (Fin 2)), E_mod j ι)) ∪
            (⋃ j ∈ (Finset.univ : Finset (Fin P.N)), E_tiny j)) :=
        MeasureTheory.measureReal_mono h_target_sub
    _ ≤ walkMeasure.real
          (E_sw ∪
            (⋃ j ∈ (Finset.univ : Finset (Fin P.N)),
              ⋃ ι ∈ (Finset.univ : Finset (Fin 2)), E_mod j ι)) +
        walkMeasure.real (⋃ j ∈ (Finset.univ : Finset (Fin P.N)), E_tiny j) :=
        MeasureTheory.measureReal_union_le _ _
    _ ≤ (walkMeasure.real E_sw +
          walkMeasure.real
            (⋃ j ∈ (Finset.univ : Finset (Fin P.N)),
              ⋃ ι ∈ (Finset.univ : Finset (Fin 2)), E_mod j ι)) +
        walkMeasure.real (⋃ j ∈ (Finset.univ : Finset (Fin P.N)), E_tiny j) :=
        add_le_add (MeasureTheory.measureReal_union_le _ _) le_rfl
    _ ≤ (δ / 3 + δ / 3) + δ / 3 :=
        add_le_add (add_le_add hE_sw_le hE_mod_union_le) hE_tiny_union_le
    _ = δ := by ring

theorem deterministic_abel_position_reconstruction (S : FiniteWallNonisotropicStrip)
    (P : OddPeriodicSliceData S) (bG r_star C_X0 : ℝ) (T : ℕ) (y_seq : ℕ → ℂ)
    (hbG : 0 < bG) (hr_star : 1 ≤ r_star) (hC_X0 : 0 ≤ C_X0)
    (hy_reg : ∀ m ≤ T, y_seq m ∈ horizStrip (sliceHeight S P.N) \ P.Z_all)
    (hy_init : ∀ j : Fin P.N, ‖slicePosSeq S P.N j.val (y_seq 0)‖ ≤ C_X0)
    (hy_ang : ∀ m ≤ T, ∀ j : Fin P.N,
      ‖sliceAngleSeq S P.N j.val (y_seq m)‖ ≤ r_star ∧
      |Real.log ‖Complex.sin (P.d0 j (y_seq m))‖| ≤ r_star)
    (hy_mart : ∀ m ≤ T, ∀ j : Fin P.N,
      (∀ ι : Fin 2,
        ‖sliceModPosMart S P bG r_star j ι y_seq m‖ ≤
          (1 / 2 : ℝ) * Real.exp (6 * bG)) ∧
      ‖sliceTinySupMart S P bG r_star j y_seq m‖ ≤ Real.exp (-bG / 3))
    (h_absorb : 4 * P.C_rec * Real.exp (2 * P.C_rec * r_star - bG / 3) ≤ 1 / 2) :
    sliceRunningPosMax S P y_seq T ≤
      ((1 + 6 * P.C_rec) * Real.exp ((2 * P.C_rec + 1) * r_star)) ^
        (sliceJointSwitches S P bG y_seq T + 1) *
      max (1 + C_X0) (4 * Real.exp (6 * bG)) :=
by
  classical
  let S_step : ℕ → ℝ := fun l =>
    Finset.univ.sup' Finset.univ_nonempty fun k : Fin P.N =>
      ‖slicePosSeq S P.N k.val (y_seq l)‖
  have hR_eq : ∀ n : ℕ,
      sliceRunningPosMax S P y_seq n =
        1 + (Finset.range (n + 1)).sup' ⟨0, Finset.mem_range.mpr (Nat.zero_lt_succ n)⟩ S_step :=
    fun _ => rfl
  have hPos_le_step : ∀ (l : ℕ) (j : Fin P.N),
      ‖slicePosSeq S P.N j.val (y_seq l)‖ ≤ S_step l := fun l j =>
    Finset.le_sup' (fun k : Fin P.N => ‖slicePosSeq S P.N k.val (y_seq l)‖) (Finset.mem_univ j)
  have hS_step_nonneg : ∀ l : ℕ, 0 ≤ S_step l := by
    intro l
    obtain ⟨j₀, _⟩ := (Finset.univ_nonempty : (Finset.univ : Finset (Fin P.N)).Nonempty)
    exact le_trans (norm_nonneg _) (hPos_le_step l j₀)
  have hStep_le_sup : ∀ {l n : ℕ}, l ≤ n →
      S_step l ≤ (Finset.range (n + 1)).sup' ⟨0, Finset.mem_range.mpr (Nat.zero_lt_succ n)⟩ S_step := by
    intro l n hln
    exact Finset.le_sup' S_step (Finset.mem_range.mpr (Nat.lt_succ_of_le hln))
  have hPos_le_R : ∀ {l n : ℕ}, l ≤ n → ∀ j : Fin P.N,
      ‖slicePosSeq S P.N j.val (y_seq l)‖ ≤ sliceRunningPosMax S P y_seq n := by
    intro l n hln j
    rw [hR_eq]
    linarith [hPos_le_step l j, hStep_le_sup hln]
  have hR_ge_one : ∀ n : ℕ, 1 ≤ sliceRunningPosMax S P y_seq n := by
    intro n
    rw [hR_eq]
    linarith [hS_step_nonneg 0, hStep_le_sup (Nat.zero_le n)]
  have hR_pos : ∀ n : ℕ, 0 < sliceRunningPosMax S P y_seq n := fun n =>
    lt_of_lt_of_le zero_lt_one (hR_ge_one n)
  have hR_nonneg : ∀ n : ℕ, 0 ≤ sliceRunningPosMax S P y_seq n := fun n =>
    (hR_pos n).le
  have hR_ne_zero_ℂ : ∀ n : ℕ, (sliceRunningPosMax S P y_seq n : ℂ) ≠ 0 := fun n =>
    Complex.ofReal_ne_zero.mpr (hR_pos n).ne'
  have hR_mono : ∀ {n₁ n₂ : ℕ}, n₁ ≤ n₂ →
      sliceRunningPosMax S P y_seq n₁ ≤ sliceRunningPosMax S P y_seq n₂ := by
    intro n₁ n₂ hn
    rw [hR_eq n₁, hR_eq n₂]
    have hsub : Finset.range (n₁ + 1) ⊆ Finset.range (n₂ + 1) :=
      Finset.range_mono (Nat.succ_le_succ hn)
    linarith [Finset.sup'_mono S_step hsub ⟨0, Finset.mem_range.mpr (Nat.zero_lt_succ n₁)⟩]
  have hR_zero : sliceRunningPosMax S P y_seq 0 ≤ 1 + C_X0 := by
    rw [hR_eq 0]
    have h0 : (Finset.range 1).sup' ⟨0, Finset.mem_range.mpr (Nat.zero_lt_succ 0)⟩ S_step ≤ C_X0 := by
      refine Finset.sup'_le _ _ fun l hl => ?_
      have hl0 : l = 0 := Nat.lt_one_iff.mp (Finset.mem_range.mp hl)
      subst hl0
      exact Finset.sup'_le _ _ fun j _ => hy_init j
    linarith
  have hR_succ : ∀ k : ℕ,
      sliceRunningPosMax S P y_seq (k + 1) =
        max (1 + S_step (k + 1)) (sliceRunningPosMax S P y_seq k) := by
    intro k
    apply le_antisymm
    · rw [hR_eq (k + 1)]
      have hsup_le :
          (Finset.range (k + 2)).sup' ⟨0, Finset.mem_range.mpr (Nat.zero_lt_succ (k + 1))⟩ S_step ≤
            max (S_step (k + 1))
              ((Finset.range (k + 1)).sup' ⟨0, Finset.mem_range.mpr (Nat.zero_lt_succ k)⟩ S_step) := by
        refine Finset.sup'_le _ _ fun l hl => ?_
        have hlt : l < k + 2 := Finset.mem_range.mp hl
        rcases Nat.lt_succ_iff_lt_or_eq.mp hlt with hlk | rfl
        · exact le_trans (Finset.le_sup' S_step (Finset.mem_range.mpr hlk)) (le_max_right _ _)
        · exact le_max_left _ _
      rcases le_max_iff.mp hsup_le with h1 | h2
      · exact le_trans (by linarith) (le_max_left _ _)
      · rw [hR_eq k]
        exact le_trans (by linarith) (le_max_right _ _)
    · refine max_le ?_ (hR_mono (Nat.le_succ k))
      rw [hR_eq (k + 1)]
      linarith [hStep_le_sup (le_rfl : k + 1 ≤ k + 1)]
  have hAngCut : ∀ {n : ℕ}, n ≤ T → sliceAngCutOK S P r_star y_seq n = true := by
    intro n hn
    unfold sliceAngCutOK
    exact decide_eq_true fun l hl k => (hy_ang l (le_trans hl hn) k).1
  have h_cos_bound : ∀ w : ℂ, ‖Complex.cos w‖ ≤ Real.exp ‖w‖ := by
    intro w
    rw [Complex.cos]
    have h1 : ‖Complex.exp (w * Complex.I)‖ ≤ Real.exp ‖w‖ := by
      rw [Complex.norm_exp]
      exact Real.exp_le_exp.mpr (le_trans (Complex.re_le_norm _) (by simp))
    have h2 : ‖Complex.exp (-w * Complex.I)‖ ≤ Real.exp ‖w‖ := by
      rw [Complex.norm_exp]
      exact Real.exp_le_exp.mpr (le_trans (Complex.re_le_norm _) (by simp))
    calc
      ‖(Complex.exp (w * Complex.I) + Complex.exp (-w * Complex.I)) / 2‖
          = ‖Complex.exp (w * Complex.I) + Complex.exp (-w * Complex.I)‖ / 2 := by
            rw [norm_div, Complex.norm_ofNat]
      _ ≤ (‖Complex.exp (w * Complex.I)‖ + ‖Complex.exp (-w * Complex.I)‖) / 2 := by
            gcongr; exact norm_add_le _ _
      _ ≤ (Real.exp ‖w‖ + Real.exp ‖w‖) / 2 := by linarith
      _ = Real.exp ‖w‖ := by ring
  have h_sin_bound : ∀ w : ℂ, ‖Complex.sin w‖ ≤ Real.exp ‖w‖ := by
    intro w
    rw [Complex.sin]
    have h1 : ‖Complex.exp (w * Complex.I)‖ ≤ Real.exp ‖w‖ := by
      rw [Complex.norm_exp]
      exact Real.exp_le_exp.mpr (le_trans (Complex.re_le_norm _) (by simp))
    have h2 : ‖Complex.exp (-w * Complex.I)‖ ≤ Real.exp ‖w‖ := by
      rw [Complex.norm_exp]
      exact Real.exp_le_exp.mpr (le_trans (Complex.re_le_norm _) (by simp))
    calc
      ‖(Complex.exp (-w * Complex.I) - Complex.exp (w * Complex.I)) * Complex.I / 2‖
          = ‖Complex.exp (-w * Complex.I) - Complex.exp (w * Complex.I)‖ / 2 := by
            rw [norm_div, norm_mul, Complex.norm_I, mul_one, Complex.norm_ofNat]
      _ ≤ (‖Complex.exp (-w * Complex.I)‖ + ‖Complex.exp (w * Complex.I)‖) / 2 := by
            gcongr; exact norm_sub_le _ _
      _ ≤ (Real.exp ‖w‖ + Real.exp ‖w‖) / 2 := by linarith
      _ = Real.exp ‖w‖ := by ring
  have hN_pos : 0 < (P.N : ℝ) := by
    exact_mod_cast (lt_of_lt_of_le (by norm_num : 0 < 3) P.N_ge_three)
  have ht₀_pos : 0 < sliceParamT0 P.N := div_pos Real.two_pi_pos hN_pos
  have ht₀_norm : ‖(sliceParamT0 P.N : ℂ)‖ < S.r_star := by
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos ht₀_pos]
    exact P.t₀_lt_r_star
  have h_sup_pt : ∀ {m : ℕ}, m ≤ T → ∀ j : Fin P.N,
      ‖sliceSupportSeq S P.N j.val (y_seq m)‖ ≤
        2 * Real.exp r_star * ‖slicePosSeq S P.N j.val (y_seq m)‖ := by
    intro m hm j
    have hy : y_seq m ∈ horizStrip (sliceHeight S P.N) \ P.Z_all := hy_reg m hm
    have hy_im : -sliceHeight S P.N < (y_seq m).im ∧ (y_seq m).im < sliceHeight S P.N :=
      abs_lt.mp hy.1
    have h_tube :
        (y_seq m + ((j.val : ℤ) : ℂ) * (sliceParamT0 P.N : ℂ), (sliceParamT0 P.N : ℂ)) ∈
          finiteWallTube S.r_star S.h_X := by
      refine ⟨ht₀_norm, ?_, ?_⟩
      · simpa [sliceHeight] using hy_im.1
      · simpa [sliceHeight] using hy_im.2
    have hs_in_H : sliceImpactSeq S P.N j.val (y_seq m) ∈ horizStrip S.H :=
      S.𝔰_maps_to _ h_tube
    have hf_ne : S.f (sliceImpactSeq S P.N j.val (y_seq m)) ≠ 0 :=
      P.reg_speed_ne_zero (y_seq m) hy j
    have hH0 : sliceSupportSeq S P.N j.val (y_seq m) =
        slicePosSeq S P.N j.val (y_seq m) 0 * Complex.cos (sliceAngleSeq S P.N j.val (y_seq m)) +
          slicePosSeq S P.N j.val (y_seq m) 1 * Complex.sin (sliceAngleSeq S P.N j.val (y_seq m)) :=
      S.H0_eq _ hs_in_H hf_ne
    have h_ang_le : Real.exp ‖sliceAngleSeq S P.N j.val (y_seq m)‖ ≤ Real.exp r_star :=
      Real.exp_le_exp.mpr (hy_ang m hm j).1
    have h_c : ‖Complex.cos (sliceAngleSeq S P.N j.val (y_seq m))‖ ≤ Real.exp r_star :=
      le_trans (h_cos_bound _) h_ang_le
