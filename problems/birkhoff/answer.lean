      let h₂ : ℂ → ℂ := dslope h₁ 0
      have hball_nhds : Metric.ball (0 : ℂ) ρ₀ ∈ nhds (0 : ℂ) :=
        Metric.isOpen_ball.mem_nhds (Metric.mem_ball_self hρ₀_pos)
      have hh₁_holo : DifferentiableOn ℂ h₁ (Metric.ball (0 : ℂ) ρ₀) :=
        (Complex.differentiableOn_dslope hball_nhds).mpr hg_holo
      have hh₂_holo : DifferentiableOn ℂ h₂ (Metric.ball (0 : ℂ) ρ₀) :=
        (Complex.differentiableOn_dslope hball_nhds).mpr hh₁_holo
      have hh₁0 : h₁ 0 = 0 := by
        dsimp [h₁]
        rw [dslope_same, hderiv_g0]
      have h_mul : ∀ τ : ℂ, τ ^ 2 * h₂ τ = g τ := by
        intro τ
        have e1 := sub_smul_dslope g 0 τ
        have e2 := sub_smul_dslope h₁ 0 τ
        simp only [sub_zero, hg0, hh₁0, smul_eq_mul] at e1 e2
