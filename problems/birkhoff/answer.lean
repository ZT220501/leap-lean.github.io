    rw [h_tay_mul (differentiableOn_const c) hg, hJet.taylor2D_const]
  have h_tay_mulc : ∀ {f : ℂ × ℂ → ℂ} (c : ℂ),
      DifferentiableOn ℂ f U₀ →
      taylor2D (fun q => f q * c) p₁ = taylor2D f p₁ * MvPowerSeries.C c := by
    intro f c hf
    change taylor2D (fun q => f q * (fun _ => c) q) p₁ = _
    rw [h_tay_mul hf (differentiableOn_const c), hJet.taylor2D_const]
  have hψ_holo : ∀ i : Fin k, DifferentiableOn ℂ (G.ψ_fn i) U₀ := by
    intro i
    exact (h_diff_mulc (1 / 2 : ℂ) (h_diff_add (G.α_holo i.castSucc) (G.α_holo i.succ))).congr
