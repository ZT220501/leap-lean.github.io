  have hRefl_log_holo : ∀ ι : Fin 2,
      DifferentiableOn ℂ (homReflectRes E_log M_log ι) U_log := by
    have hdy : ∀ k : Fin 3, DifferentiableOn ℂ (iterDerivYT 1 0 (W_log k)) U_log :=
      fun k => hKit.iterDerivYT_holo hU_log_open (hW_log_holo k) 1 0
    have hT0 : DifferentiableOn ℂ
        (fun p => W_log 2 p * iterDerivYT 1 0 (W_log 0) p -
          W_log 0 p * iterDerivYT 1 0 (W_log 2) p) U_log :=
      ((hW_log_holo 2).mul (hdy 0)).sub ((hW_log_holo 0).mul (hdy 2))
    have hT1 : DifferentiableOn ℂ
        (fun p => W_log 2 p * iterDerivYT 1 0 (W_log 1) p -
          W_log 1 p * iterDerivYT 1 0 (W_log 2) p) U_log :=
      ((hW_log_holo 2).mul (hdy 1)).sub ((hW_log_holo 1).mul (hdy 2))
    have hV_holo : ∀ j : Fin 2, DifferentiableOn ℂ (homReflectOut E_log W_log j) U_log := by
      intro j
      have hN0 := hT1
      have hN1 := hT0.neg
      have hdotLN := ((hE_log_holo 0).mul hN0).add ((hE_log_holo 1).mul hN1)
      have hdotNN := (hN0.mul hN0).add (hN1.mul hN1)
      have hNj : DifferentiableOn ℂ
          (fun p => if j = 0 then
            W_log 2 p * iterDerivYT 1 0 (W_log 1) p - W_log 1 p * iterDerivYT 1 0 (W_log 2) p
          else
            -(W_log 2 p * iterDerivYT 1 0 (W_log 0) p -
              W_log 0 p * iterDerivYT 1 0 (W_log 2) p)) U_log := by
        fin_cases j
        · simp only [Fin.zero_eta, ↓reduceIte]
          exact hN0
        · have h1_ne : (1 : Fin 2) ≠ 0 := by decide
          simp only [Fin.mk_one, h1_ne, ↓reduceIte]
          exact hN1
      exact (((differentiableOn_const (2 : ℂ)).mul hdotLN).mul hNj).sub
        (hdotNN.mul (hE_log_holo j))
    intro ι
    exact ((hW_log_holo 2).mul (hV_holo ι)).sub
      ((((hV_holo 0).mul (hW_log_holo 0)).add ((hV_holo 1).mul (hW_log_holo 1))).mul
        (hM_log_holo ι))

  have hDet_end : ∀ p ∈ B_end,
      homRankOneDet (homIntersect (dualLineShift C 0) Br.M₁_end) p = 0 :=
    Br.fwd_rank_one B_col.primary_rank_one
  have hRefl_end : ∀ p ∈ B_end, ∀ ι : Fin 2,
      homReflectRes (dualLineShift C 0) Br.M₁_end ι p = 0 :=
    Br.fwd_reflect B_col.primary_reflect
  have hDet_Refl_B_log : ∀ p ∈ Metric.ball p_log_end r_log_end,
      homRankOneDet W_log p = 0 ∧ ∀ ι : Fin 2, homReflectRes E_log M_log ι p = 0 := by
    intro p hp
    have hp_prod : p ∈ Metric.ball (Br.y₀ : ℂ) r_log_end ×ˢ Metric.ball w_end r_log_end := by
      rwa [ball_prod_same]
    obtain ⟨h1, h2⟩ := hChain_snd
      (E_old := dualLineShift C 0) (F_old := Br.M₁_end)
      (E_new := E_log) (F_new := M_log)
      Metric.isOpen_ball Metric.isOpen_ball Metric.isOpen_ball
      hp_prod.1 hp_prod.2 (Complex.differentiable_exp p.2)
      (fun ι => (hDualShift_holo_dom 0 (by norm_num) ι).mono hB_end_sub_dom)
      Br.M₁_end_holo
      (fun y' hy' u' hu' => by
        have hq : (y', u') ∈ Metric.ball p_log_end r_log_end := by
          rw [← ball_prod_same]; exact ⟨hy', hu'⟩
        exact ⟨hexp_maps_end (y', u') hq, fun _ => rfl,
          fun ι => hM_log_eq_end ι (y', u') hq⟩)
    refine ⟨?_, fun ι => ?_⟩
    · rw [h1, hDet_end (E_exp p) (hexp_maps_end p hp), mul_zero]
    · rw [h2 ι, hRefl_end (E_exp p) (hexp_maps_end p hp) ι]
  have hDet_U_log : ∀ p ∈ U_log, homRankOneDet W_log p = 0 :=
    hKit.eqOn_zero_of_preconnected_2D hU_log_open hU_log_preconn
      Metric.isOpen_ball ⟨p_log_end, Metric.mem_ball_self hr_log_end_pos⟩
      hB_log_end_sub hDet_log_holo (fun p hp => (hDet_Refl_B_log p hp).1)
  have hRefl_U_log : ∀ ι : Fin 2, ∀ p ∈ U_log, homReflectRes E_log M_log ι p = 0 :=
    fun ι => hKit.eqOn_zero_of_preconnected_2D hU_log_open hU_log_preconn
      Metric.isOpen_ball ⟨p_log_end, Metric.mem_ball_self hr_log_end_pos⟩
      hB_log_end_sub (hRefl_log_holo ι) (fun p hp => (hDet_Refl_B_log p hp).2 ι)

  have hpuis_rank_one_and_reflect :
      ∀ p ∈ B_puis_punc,
        homRankOneDet (homIntersect (puisDualLine0 C d) M_puis) p = 0 ∧
        ∀ ι : Fin 2, homReflectRes (puisDualLine0 C d) M_puis ι p = 0 := by
    intro p hp
    obtain ⟨O_τ, ℓ, hO_open, hp2_O, hℓ_diff, hℓ_props⟩ := hM_puis_lift p hp
    obtain ⟨h1, h2⟩ := hChain_snd
      (E_old := E_log) (F_old := M_log)
      (E_new := puisDualLine0 C d) (F_new := M_puis)
      hU_log_open Metric.isOpen_ball hO_open hp.1 hp2_O hℓ_diff
      hE_log_holo hM_log_holo
      (fun y' hy' ζ hζ => by
        obtain ⟨hU, hexp, hMp⟩ := hℓ_props y' hy' ζ hζ
        refine ⟨hU, fun ι => ?_, hMp⟩
        change dualLineShift C 0 ι (y', ζ ^ d) = dualLineShift C 0 ι (y', Complex.exp (ℓ ζ))
        rw [hexp])
    refine ⟨?_, fun ι => ?_⟩
    · rw [h1, hDet_U_log (p.1, ℓ p.2) (hℓ_props p.1 hp.1 p.2 hp2_O).1, mul_zero]
    · rw [h2 ι, hRefl_U_log ι (p.1, ℓ p.2) (hℓ_props p.1 hp.1 p.2 hp2_O).1]

  
  have hVanish_puis_to_end : ∀ (H : (ℂ × ℂ) → ℂ → ℂ → ℂ) (V : Set (ℂ × ℂ)),
      DifferentiableOn ℂ (fun p => H (E_exp p) (M_log 0 p) (M_log 1 p)) U_log →
      DifferentiableOn ℂ (fun p => H p (Br.M₁_end 0 p) (Br.M₁_end 1 p)) B_end →
      IsOpen V → V.Nonempty → V ⊆ B_puis_punc →
      (∀ q ∈ V, H (q.1, q.2 ^ d) (M_puis 0 q) (M_puis 1 q) = 0) →
      ∀ p ∈ B_end, H p (Br.M₁_end 0 p) (Br.M₁_end 1 p) = 0 := by
    intro H V hf_log_holo hf_end_holo hV_open ⟨q₀, hq₀⟩ hV_sub hV_zero
    let Pi_d : ℂ × ℂ → ℂ × ℂ := fun p => (p.1, Complex.exp (p.2 / (d : ℂ)))
    have hPi_d_cont : Continuous Pi_d :=
      continuous_fst.prodMk
        (Complex.continuous_exp.comp (continuous_snd.div_const (d : ℂ)))
    let U_pull : Set (ℂ × ℂ) :=
      Metric.ball (Br.y₀ : ℂ) r_yp ×ˢ { w : ℂ | w.re < (d : ℝ) * Real.log r_τ }
    let V_log : Set (ℂ × ℂ) := U_pull ∩ Pi_d ⁻¹' V
    have hV_log_open : IsOpen V_log :=
      (Metric.isOpen_ball.prod (hHalf_open _)).inter (hV_open.preimage hPi_d_cont)
    have hq₀_punc : q₀ ∈ B_puis_punc := hV_sub hq₀
    let w₀ : ℂ := (d : ℂ) * Complex.log q₀.2
    have hw₀_V_log : (q₀.1, w₀) ∈ V_log := by
      refine ⟨⟨hq₀_punc.1, ?_⟩, ?_⟩
      · change ((d : ℂ) * Complex.log q₀.2).re < (d : ℝ) * Real.log r_τ
        have hre : ((d : ℂ) * Complex.log q₀.2).re = (d : ℝ) * Real.log ‖q₀.2‖ := by
          simp [Complex.mul_re, Complex.log_re]
        rw [hre]
        have hnorm_lt : ‖q₀.2‖ < r_τ := by
          simpa [Metric.mem_ball, dist_zero_right] using hq₀_punc.2.1
        exact mul_lt_mul_of_pos_left
          (Real.log_lt_log (norm_pos_iff.mpr hq₀_punc.2.2) hnorm_lt) hd_pos_R
      · change (q₀.1, Complex.exp (w₀ / (d : ℂ))) ∈ V
        have hdiv : w₀ / (d : ℂ) = Complex.log q₀.2 := mul_div_cancel_left₀ _ hd_ne_C
        rw [hdiv, Complex.exp_log hq₀_punc.2.2]
        exact hq₀
    have hV_log_sub : V_log ⊆ U_log :=
      fun p hp => (hpullback_exp_div_d p.1 hp.1.1 p.2 hp.1.2).1
    have hf_log_zero_V : ∀ p ∈ V_log, H (E_exp p) (M_log 0 p) (M_log 1 p) = 0 := by
      intro p hp
      obtain ⟨_, _, hpow, hMp⟩ := hpullback_exp_div_d p.1 hp.1.1 p.2 hp.1.2
      have h1 : E_exp p = ((Pi_d p).1, (Pi_d p).2 ^ d) := Prod.ext rfl hpow.symm
      rw [h1, ← hMp 0, ← hMp 1]
      exact hV_zero (Pi_d p) hp.2
    have hf_log_zero : ∀ p ∈ U_log, H (E_exp p) (M_log 0 p) (M_log 1 p) = 0 :=
      hKit.eqOn_zero_of_preconnected_2D hU_log_open hU_log_preconn
        hV_log_open ⟨(q₀.1, w₀), hw₀_V_log⟩ hV_log_sub hf_log_holo hf_log_zero_V
    let L_map : ℂ × ℂ → ℂ × ℂ := fun p => (p.1, Complex.log p.2)
    have ht_end_slit : (Br.t_end : ℂ) ∈ Complex.slitPlane :=
      Complex.mem_slitPlane_iff.mpr (Or.inl (by simpa using Br.t_end_pos))
    have hL_q_end : L_map q_end = p_log_end :=
      Prod.ext rfl (Complex.ofReal_log Br.t_end_pos.le).symm
    have hL_contAt : ContinuousAt L_map q_end :=
      continuousAt_fst.prodMk
        (ContinuousAt.comp (g := Complex.log) (f := Prod.snd)
          (Complex.differentiableAt_log ht_end_slit).continuousAt continuousAt_snd)
    have h_nhds_end :
        B_end ∩ (Prod.snd ⁻¹' Complex.slitPlane) ∩ (L_map ⁻¹' Metric.ball p_log_end r_log_end) ∈
          nhds q_end :=
      Filter.inter_mem
        (Filter.inter_mem
          (Metric.ball_mem_nhds q_end Br.r_end_pos)
          ((Complex.isOpen_slitPlane.preimage continuous_snd).mem_nhds ht_end_slit))
        (hL_contAt.preimage_mem_nhds
          (hL_q_end.symm ▸ Metric.ball_mem_nhds p_log_end hr_log_end_pos))
    obtain ⟨δ_e, hδ_e_pos, hδ_e_sub⟩ := Metric.mem_nhds_iff.mp h_nhds_end
    have hf_end_zero_ball : ∀ p ∈ Metric.ball q_end δ_e,
        H p (Br.M₁_end 0 p) (Br.M₁_end 1 p) = 0 := by
      intro p hp
      obtain ⟨⟨_, hp_slit⟩, hp_L⟩ := hδ_e_sub hp
      have hp2_ne : p.2 ≠ 0 := Complex.slitPlane_ne_zero hp_slit
      have hexp_L : E_exp (L_map p) = p := Prod.ext rfl (Complex.exp_log hp2_ne)
      have hM0 : M_log 0 (L_map p) = Br.M₁_end 0 p := by
        have h1 := hM_log_eq_end 0 (L_map p) hp_L
        change M_log 0 (L_map p) = Br.M₁_end 0 (E_exp (L_map p)) at h1
        rwa [hexp_L] at h1
      have hM1 : M_log 1 (L_map p) = Br.M₁_end 1 p := by
        have h1 := hM_log_eq_end 1 (L_map p) hp_L
        change M_log 1 (L_map p) = Br.M₁_end 1 (E_exp (L_map p)) at h1
        rwa [hexp_L] at h1
      rw [← hM0, ← hM1]
      simpa only [hexp_L] using hf_log_zero (L_map p) (hB_log_end_sub hp_L)
    exact hKit.eqOn_zero_of_preconnected_2D Metric.isOpen_ball (convex_ball _ _).isPreconnected
      Metric.isOpen_ball ⟨q_end, Metric.mem_ball_self hδ_e_pos⟩
      (fun p hp => ((hδ_e_sub hp).1).1) hf_end_holo hf_end_zero_ball

  let r_wit : ℝ := min (W.s_base / 2) (W.r_base / 2)
  have hr_wit_pos : 0 < r_wit :=
    lt_min (by positivity [W.s_base_pos]) (by positivity [W.r_base_pos])
  have hr_wit_le_det : r_wit ≤ min (hDet.s_det / 2) (hDet.r_det / 2) :=
    min_le_min (by linarith [W.s_base_le_det]) (by linarith [W.r_base_le_det])
  have hwit_mem_dom : ∀ p : ℂ × ℂ,
      |p.1.im| < r_wit → ‖p.2‖ < r_wit → p.2.im = 0 →
        p ∈ symCollarDom W.s_base W.r_base q_idx := by
    intro p hp1 hp2 hp2_im
    let S_nat : ℕ := Finset.univ.sup fun a : Fin N_idx => (q_idx a).natAbs
    have h2J_pos : (0 : ℝ) < 2 * ((S_nat : ℝ) + 2) := by positivity
    refine ⟨lt_of_lt_of_le hp1 (min_le_left _ _),
      lt_of_lt_of_le hp2 (le_trans (min_le_right _ _) (by linarith [W.r_base_pos])), ?_⟩
    rw [hp2_im, abs_zero]
    exact div_pos W.s_base_pos h2J_pos

  have hB_puis_punc_open : IsOpen B_puis_punc :=
    Metric.isOpen_ball.prod (Metric.isOpen_ball.inter isOpen_compl_singleton)
  have hB_puis_punc_ne : B_puis_punc.Nonempty := by
    refine ⟨((Br.y₀ : ℂ), ((r_τ / 2 : ℝ) : ℂ)), Metric.mem_ball_self hr_yp_pos, ?_, ?_⟩
    · rw [Metric.mem_ball, dist_zero_right, Complex.norm_real, Real.norm_eq_abs,
        abs_of_pos (by positivity)]
      linarith
    · exact Complex.ofReal_ne_zero.mpr (by linarith)

  have hnot_w2_zero :
      ¬ ∀ p ∈ B_puis_punc, homIntersect (puisDualLine0 C d) M_puis 2 p = 0 := by
    intro hAll
    let H_w2 : (ℂ × ℂ) → ℂ → ℂ → ℂ :=
      fun p z₀ z₁ => dualLineShift C 0 0 p * z₁ - dualLineShift C 0 1 p * z₀
    have hend : ∀ p ∈ B_end, homIntersect (dualLineShift C 0) Br.M₁_end 2 p = 0 :=
      hVanish_puis_to_end H_w2 B_puis_punc
        (((hE_log_holo 0).mul (hM_log_holo 1)).sub ((hE_log_holo 1).mul (hM_log_holo 0)))
        ((((hDualShift_holo_dom 0 (by norm_num) 0).mono hB_end_sub_dom).mul (Br.M₁_end_holo 1)).sub
          (((hDualShift_holo_dom 0 (by norm_num) 1).mono hB_end_sub_dom).mul (Br.M₁_end_holo 0)))
        hB_puis_punc_open hB_puis_punc_ne Set.Subset.rfl hAll
    have hdom := Br.rev_w2_zero hend
    obtain ⟨p_w, hp1, hp2, hp_im, hp_nz⟩ :=
      B_col.primary_w2_ne_zero r_wit hr_wit_pos hr_wit_le_det
    exact hp_nz (hdom p_w (hwit_mem_dom p_w hp1 hp2 hp_im))

  have hnot_iso_line : ∀ (V : Set (ℂ × ℂ)) (s_iso c_star : ℂ),
      IsOpen V → V.Nonempty → V ⊆ B_puis_punc → (s_iso = 1 ∨ s_iso = -1) →
      ¬ ∀ p ∈ V,
          homIntersect (puisDualLine0 C d) M_puis 0 p +
            s_iso * Complex.I * homIntersect (puisDualLine0 C d) M_puis 1 p -
            c_star * homIntersect (puisDualLine0 C d) M_puis 2 p = 0 := by
    intro V s_iso c_star hVo hVne hVsub hs_iso hAll
    let H_iso : (ℂ × ℂ) → ℂ → ℂ → ℂ := fun p z₀ z₁ =>
      (z₁ - dualLineShift C 0 1 p) +
        s_iso * Complex.I * (dualLineShift C 0 0 p - z₀) -
        c_star * (dualLineShift C 0 0 p * z₁ - dualLineShift C 0 1 p * z₀)
    have hL0_end : ∀ j : Fin 2, DifferentiableOn ℂ (dualLineShift C 0 j) B_end :=
      fun j => (hDualShift_holo_dom 0 (by norm_num) j).mono hB_end_sub_dom
    have hend := hVanish_puis_to_end H_iso V
      ((((hM_log_holo 1).sub (hE_log_holo 1)).add
        ((differentiableOn_const (s_iso * Complex.I)).mul
          ((hE_log_holo 0).sub (hM_log_holo 0)))).sub
        ((differentiableOn_const c_star).mul
          (((hE_log_holo 0).mul (hM_log_holo 1)).sub ((hE_log_holo 1).mul (hM_log_holo 0)))))
      ((((Br.M₁_end_holo 1).sub (hL0_end 1)).add
        ((differentiableOn_const (s_iso * Complex.I)).mul
          ((hL0_end 0).sub (Br.M₁_end_holo 0)))).sub
        ((differentiableOn_const c_star).mul
          (((hL0_end 0).mul (Br.M₁_end_holo 1)).sub ((hL0_end 1).mul (Br.M₁_end_holo 0)))))
      hVo hVne hVsub hAll
    have hdom := Br.rev_iso_line s_iso c_star hend
    obtain ⟨p_w, hp1, hp2, hp_im, hp_nz⟩ :=
      B_col.primary_not_isotropic_line r_wit s_iso c_star hr_wit_pos hr_wit_le_det hs_iso
    exact hp_nz (hdom p_w (hwit_mem_dom p_w hp1 hp2 hp_im))

  have hnot_prev_eq : ∀ (V : Set (ℂ × ℂ)),
      IsOpen V → V.Nonempty → V ⊆ B_puis_punc →
      ¬ ∀ p ∈ V,
          let W₁ := homIntersect (puisDualLine0 C d) M_puis
          let W₀ : Fin 3 → ℂ × ℂ → ℂ := fun k q =>
            homIntersect (dualLineShift C (-1)) (dualLineShift C 0) k (q.1, q.2 ^ d)
          W₁ 0 p * W₀ 2 p - W₀ 0 p * W₁ 2 p = 0 ∧
          W₁ 1 p * W₀ 2 p - W₀ 1 p * W₁ 2 p = 0 := by
    intro V hVo hVne hVsub hAll
    let W₀_base : Fin 3 → ℂ × ℂ → ℂ := homIntersect (dualLineShift C (-1)) (dualLineShift C 0)
    have hW₀_dom : ∀ k : Fin 3,
        DifferentiableOn ℂ (W₀_base k) (symCollarDom W.s_base W.r_base q_idx) := by
      have hm1 := hDualShift_holo_dom (-1) (by norm_num)
      have h0 := hDualShift_holo_dom 0 (by norm_num)
      intro k
      fin_cases k
      · exact (h0 1).sub (hm1 1)
      · exact (hm1 0).sub (h0 0)
      · exact ((hm1 0).mul (h0 1)).sub ((hm1 1).mul (h0 0))
    have hW₀_log : ∀ k : Fin 3, DifferentiableOn ℂ (fun p => W₀_base k (E_exp p)) U_log := by
      intro k
      change DifferentiableOn ℂ ((W₀_base k) ∘ E_exp) U_log
      exact (hW₀_dom k).comp hE_exp_diff.differentiableOn hU_log_maps_dom
    have hW₀_end : ∀ k : Fin 3, DifferentiableOn ℂ (W₀_base k) B_end :=
      fun k => (hW₀_dom k).mono hB_end_sub_dom
    have hL0_end : ∀ j : Fin 2, DifferentiableOn ℂ (dualLineShift C 0 j) B_end :=
      fun j => (hDualShift_holo_dom 0 (by norm_num) j).mono hB_end_sub_dom
    let H_prev0 : (ℂ × ℂ) → ℂ → ℂ → ℂ := fun p z₀ z₁ =>
      (z₁ - dualLineShift C 0 1 p) * W₀_base 2 p -
        W₀_base 0 p * (dualLineShift C 0 0 p * z₁ - dualLineShift C 0 1 p * z₀)
    let H_prev1 : (ℂ × ℂ) → ℂ → ℂ → ℂ := fun p z₀ z₁ =>
      (dualLineShift C 0 0 p - z₀) * W₀_base 2 p -
        W₀_base 1 p * (dualLineShift C 0 0 p * z₁ - dualLineShift C 0 1 p * z₀)
    have hend0 := hVanish_puis_to_end H_prev0 V
      ((((hM_log_holo 1).sub (hE_log_holo 1)).mul (hW₀_log 2)).sub
        ((hW₀_log 0).mul (((hE_log_holo 0).mul (hM_log_holo 1)).sub
          ((hE_log_holo 1).mul (hM_log_holo 0)))))
      ((((Br.M₁_end_holo 1).sub (hL0_end 1)).mul (hW₀_end 2)).sub
        ((hW₀_end 0).mul (((hL0_end 0).mul (Br.M₁_end_holo 1)).sub
          ((hL0_end 1).mul (Br.M₁_end_holo 0)))))
      hVo hVne hVsub (fun q hq => (hAll q hq).1)
    have hend1 := hVanish_puis_to_end H_prev1 V
      ((((hE_log_holo 0).sub (hM_log_holo 0)).mul (hW₀_log 2)).sub
        ((hW₀_log 1).mul (((hE_log_holo 0).mul (hM_log_holo 1)).sub
          ((hE_log_holo 1).mul (hM_log_holo 0)))))
      ((((hL0_end 0).sub (Br.M₁_end_holo 0)).mul (hW₀_end 2)).sub
        ((hW₀_end 1).mul (((hL0_end 0).mul (Br.M₁_end_holo 1)).sub
          ((hL0_end 1).mul (Br.M₁_end_holo 0)))))
      hVo hVne hVsub (fun q hq => (hAll q hq).2)
    have hdom := Br.rev_prev_eq (fun p hp => ⟨hend0 p hp, hend1 p hp⟩)
    obtain ⟨p_w, hp1, hp2, hp_im, hp_or⟩ :=
      B_col.primary_step_distinct r_wit hr_wit_pos hr_wit_le_det
    obtain ⟨h0_z, h1_z⟩ := hdom p_w (hwit_mem_dom p_w hp1 hp2 hp_im)
    exact hp_or.elim (fun hne => hne h0_z) (fun hne => hne h1_z)

  have hnot_primary : ∀ (V : Set (ℂ × ℂ)),
      IsOpen V → V.Nonempty → V ⊆ B_puis_punc →
      ¬ ∀ p ∈ V, ∀ ι : Fin 2, M_puis ι p = dualLineShift C 1 ι (p.1, p.2 ^ d) := by
    intro V hVo hVne hVsub hAll
    obtain ⟨ι_def, p_def, hp_def, hne_def⟩ := Br.M₁_ne_primary
    let H_pr : (ℂ × ℂ) → ℂ → ℂ → ℂ := fun p z₀ z₁ =>
      (if ι_def = 0 then z₀ else z₁) - dualLineShift C 1 ι_def p
    have hsel_log : DifferentiableOn ℂ
        (fun p => if ι_def = 0 then M_log 0 p else M_log 1 p) U_log := by
      fin_cases ι_def
      · simpa only [Fin.zero_eta, ↓reduceIte] using hM_log_holo 0
      · have h1_ne : (1 : Fin 2) ≠ 0 := by decide
        simpa only [Fin.mk_one, h1_ne, ↓reduceIte] using hM_log_holo 1
    have hsel_end : DifferentiableOn ℂ
        (fun p => if ι_def = 0 then Br.M₁_end 0 p else Br.M₁_end 1 p) B_end := by
      fin_cases ι_def
      · simpa only [Fin.zero_eta, ↓reduceIte] using Br.M₁_end_holo 0
      · have h1_ne : (1 : Fin 2) ≠ 0 := by decide
        simpa only [Fin.mk_one, h1_ne, ↓reduceIte] using Br.M₁_end_holo 1
    have hL1_log : DifferentiableOn ℂ (fun p => dualLineShift C 1 ι_def (E_exp p)) U_log := by
      change DifferentiableOn ℂ ((dualLineShift C 1 ι_def) ∘ E_exp) U_log
      exact (hDualShift_holo_dom 1 (by norm_num) ι_def).comp hE_exp_diff.differentiableOn
        hU_log_maps_dom
    have hL1_end : DifferentiableOn ℂ (dualLineShift C 1 ι_def) B_end :=
      (hDualShift_holo_dom 1 (by norm_num) ι_def).mono hB_end_sub_dom
    have hend := hVanish_puis_to_end H_pr V
      (hsel_log.sub hL1_log) (hsel_end.sub hL1_end) hVo hVne hVsub
      (fun q hq => by
        dsimp [H_pr]
        fin_cases ι_def <;> simp [hAll q hq])
    have h_at := hend p_def hp_def
    dsimp [H_pr] at h_at
    fin_cases ι_def <;> simp only [Fin.zero_eta, Fin.mk_one, ↓reduceIte, sub_eq_zero] at h_at hne_def <;>
      exact hne_def h_at

  
  have hEval_holo : ∀ (M : ℕ) (P : MvPolynomial (SymJetVar N_idx M) ℂ),
      DifferentiableOn ℂ (fun q => MvPolynomial.eval (symJetEnv C q_idx M q) P)
        (symCollarDom W.s_base W.r_base q_idx) := by
    intro M
    let S_nat : ℕ := Finset.univ.sup fun a : Fin N_idx => (q_idx a).natAbs
    let J_bound : ℝ := (S_nat : ℝ) + 2
    have h2J_pos : (0 : ℝ) < 2 * J_bound := by dsimp [J_bound]; positivity
    have hJet_holo : ∀ v : SymJetVar N_idx M,
        DifferentiableOn ℂ (fun q => symJetEnv C q_idx M q v)
          (symCollarDom W.s_base W.r_base q_idx) := by
      intro v
      have hAff_diff : Differentiable ℂ
          (fun r : ℂ × ℂ => (r.1 + (q_idx v.1 : ℂ) * r.2, r.2)) :=
        (differentiable_fst.add ((differentiable_const _).mul differentiable_snd)).prodMk
          differentiable_snd
      have hAff_maps : Set.MapsTo
          (fun r : ℂ × ℂ => (r.1 + (q_idx v.1 : ℂ) * r.2, r.2))
          (symCollarDom W.s_base W.r_base q_idx)
          { w : ℂ × ℂ | |w.1.im| < 2 * hDet.s_det ∧ ‖w.2‖ < 2 * hDet.r_det } := by
        intro q ⟨hq1, hq2, hq3⟩
        have ha_nat : (q_idx v.1).natAbs ≤ S_nat :=
          Finset.le_sup (f := fun b : Fin N_idx => (q_idx b).natAbs) (Finset.mem_univ v.1)
        have ha_cast : (((q_idx v.1).natAbs : ℕ) : ℝ) ≤ (S_nat : ℝ) := Nat.cast_le.mpr ha_nat
        have ha_abs : |(q_idx v.1 : ℝ)| = (((q_idx v.1).natAbs : ℕ) : ℝ) := by
          rcases Int.natAbs_eq (q_idx v.1) with h | h
          · have hR := congrArg (Int.cast (R := ℝ)) h
            rw [Int.cast_natCast] at hR
            rw [hR, abs_of_nonneg (Nat.cast_nonneg _)]
          · have hR := congrArg (Int.cast (R := ℝ)) h
            rw [Int.cast_neg, Int.cast_natCast] at hR
            rw [hR, abs_neg, abs_of_nonneg (Nat.cast_nonneg _)]
        have ha_le_J : |(q_idx v.1 : ℝ)| ≤ J_bound := by
          dsimp [J_bound]; linarith
        have hq3_mul : |q.2.im| * (2 * J_bound) < W.s_base :=
          (lt_div_iff₀ h2J_pos).mp hq3
        have hqa_im : |((q_idx v.1 : ℂ) * q.2).im| < W.s_base / 2 := by
          have him_eq : ((q_idx v.1 : ℂ) * q.2).im = (q_idx v.1 : ℝ) * q.2.im := by
            simp [Complex.mul_im]
          rw [him_eq, abs_mul]
          have h1 : |(q_idx v.1 : ℝ)| * |q.2.im| ≤ J_bound * |q.2.im| :=
            mul_le_mul_of_nonneg_right ha_le_J (abs_nonneg _)
          linarith
        have h_add : |(q.1 + (q_idx v.1 : ℂ) * q.2).im| ≤
            |q.1.im| + |((q_idx v.1 : ℂ) * q.2).im| := by
          simpa only [Complex.add_im] using abs_add_le q.1.im ((q_idx v.1 : ℂ) * q.2).im
        exact ⟨by linarith [W.s_base_le_det, hDet.s_det_pos],
          by linarith [W.r_base_le_det, hDet.r_det_pos]⟩
      have hShift_holo : DifferentiableOn ℂ
          (fun r : ℂ × ℂ => glancingDualLine C (r.1 + (q_idx v.1 : ℂ) * r.2) r.2 v.2.1)
          (symCollarDom W.s_base W.r_base q_idx) := by
        change DifferentiableOn ℂ
          ((fun w : ℂ × ℂ => glancingDualLine C w.1 w.2 v.2.1) ∘
            (fun r : ℂ × ℂ => (r.1 + (q_idx v.1 : ℂ) * r.2, r.2)))
          (symCollarDom W.s_base W.r_base q_idx)
        exact (hDet.dualLine_holo v.2.1).comp hAff_diff.differentiableOn hAff_maps
      exact hKit.iterDerivYT_holo hDom_open hShift_holo v.2.2.1.1 v.2.2.2.1
    intro P
    refine MvPolynomial.induction_on
      (motive := fun Q_p => DifferentiableOn ℂ
        (fun q => MvPolynomial.eval (symJetEnv C q_idx M q) Q_p)
        (symCollarDom W.s_base W.r_base q_idx))
      P
      (fun c => by
        simpa only [MvPolynomial.eval_C] using
          (differentiableOn_const c :
            DifferentiableOn ℂ (fun _ : ℂ × ℂ => c) (symCollarDom W.s_base W.r_base q_idx)))
      (fun P₁ P₂ ih₁ ih₂ => by
        have hfn :
            (fun q => MvPolynomial.eval (symJetEnv C q_idx M q) (P₁ + P₂)) =
              (fun q => MvPolynomial.eval (symJetEnv C q_idx M q) P₁ +
                MvPolynomial.eval (symJetEnv C q_idx M q) P₂) := by
          ext q; exact map_add _ P₁ P₂
        rw [hfn]; exact ih₁.add ih₂)
      (fun P₁ v ih => by
        have hfn :
            (fun q => MvPolynomial.eval (symJetEnv C q_idx M q) (P₁ * MvPolynomial.X v)) =
              (fun q => MvPolynomial.eval (symJetEnv C q_idx M q) P₁ *
                symJetEnv C q_idx M q v) := by
          ext q; simp only [map_mul, MvPolynomial.eval_X]
        rw [hfn]; exact ih.mul (hJet_holo v))

  have hPolySum_holo : ∀ {U_s : Set (ℂ × ℂ)} {φ_map : ℂ × ℂ → ℂ × ℂ} {g_fn : ℂ × ℂ → ℂ}
      (M D : ℕ) (P_coeff : Fin (D + 1) → MvPolynomial (SymJetVar N_idx M) ℂ),
      DifferentiableOn ℂ φ_map U_s →
      Set.MapsTo φ_map U_s (symCollarDom W.s_base W.r_base q_idx) →
      DifferentiableOn ℂ g_fn U_s →
      DifferentiableOn ℂ
        (fun q => ∑ deg : Fin (D + 1),
          MvPolynomial.eval (symJetEnv C q_idx M (φ_map q)) (P_coeff deg) *
            (g_fn q) ^ (deg : ℕ)) U_s := by
    intro U_s φ_map g_fn M D P_coeff hφ_holo hφ_maps hg_holo
    have h_fin : ∀ s : Finset (Fin (D + 1)),
        DifferentiableOn ℂ
          (fun q => ∑ deg ∈ s,
            MvPolynomial.eval (symJetEnv C q_idx M (φ_map q)) (P_coeff deg) *
              (g_fn q) ^ (deg : ℕ)) U_s := by
      intro s
      induction s using Finset.induction_on with
      | empty =>
        have h0 :
            (fun q : ℂ × ℂ => ∑ deg ∈ (∅ : Finset (Fin (D + 1))),
              MvPolynomial.eval (symJetEnv C q_idx M (φ_map q)) (P_coeff deg) *
                (g_fn q) ^ (deg : ℕ)) = fun _ => 0 := by
          ext q; exact Finset.sum_empty
        rw [h0]; exact differentiableOn_const 0
      | @insert deg s hdeg ih =>
        have hev_comp : DifferentiableOn ℂ
            (fun q => MvPolynomial.eval (symJetEnv C q_idx M (φ_map q)) (P_coeff deg)) U_s := by
          change DifferentiableOn ℂ
            ((fun w => MvPolynomial.eval (symJetEnv C q_idx M w) (P_coeff deg)) ∘ φ_map) U_s
          exact (hEval_holo M (P_coeff deg)).comp hφ_holo hφ_maps
        have hterm : DifferentiableOn ℂ
            (fun q => MvPolynomial.eval (symJetEnv C q_idx M (φ_map q)) (P_coeff deg) *
              (g_fn q) ^ (deg : ℕ)) U_s :=
          hev_comp.mul (hg_holo.pow (deg : ℕ))
        have hfn :
            (fun q => ∑ j ∈ insert deg s,
              MvPolynomial.eval (symJetEnv C q_idx M (φ_map q)) (P_coeff j) *
                (g_fn q) ^ (j : ℕ)) =
            (fun q =>
              MvPolynomial.eval (symJetEnv C q_idx M (φ_map q)) (P_coeff deg) *
                (g_fn q) ^ (deg : ℕ) +
              ∑ j ∈ s,
                MvPolynomial.eval (symJetEnv C q_idx M (φ_map q)) (P_coeff j) *
                  (g_fn q) ^ (j : ℕ)) := by
          ext q; exact Finset.sum_insert hdeg
        rw [hfn]; exact hterm.add ih
    exact h_fin Finset.univ

  have hpuis_poly_transfer : ∀ (y_m t_m r_m : ℝ) (M_cand : Fin 2 → ℂ × ℂ → ℂ),
      0 < t_m → 0 < r_m →
      Metric.ball ((y_m : ℂ), (t_m : ℂ)) r_m ⊆ symCollarDom W.s_base W.r_base q_idx →
      (∀ ι : Fin 2, DifferentiableOn ℂ (M_cand ι) (Metric.ball ((y_m : ℂ), (t_m : ℂ)) r_m)) →
      (∃ V_τ : Set (ℂ × ℂ), IsOpen V_τ ∧ V_τ.Nonempty ∧ V_τ ⊆ B_puis_punc ∧
        (∀ q ∈ V_τ, (q.1, q.2 ^ d) ∈ Metric.ball ((y_m : ℂ), (t_m : ℂ)) r_m ∧
          ∀ ι : Fin 2, M_puis ι q = M_cand ι (q.1, q.2 ^ d))) →
      ∀ (M D : ℕ) (ι_star : Fin 2)
        (P_coeff : Fin (D + 1) → MvPolynomial (SymJetVar N_idx M) ℂ),
        (∀ p ∈ B_end,
          ∑ deg : Fin (D + 1),
            MvPolynomial.eval (symJetEnv C q_idx M p) (P_coeff deg) *
              (Br.M₁_end ι_star p) ^ (deg : ℕ) = 0) ↔
        (∀ p ∈ Metric.ball ((y_m : ℂ), (t_m : ℂ)) r_m,
          ∑ deg : Fin (D + 1),
            MvPolynomial.eval (symJetEnv C q_idx M p) (P_coeff deg) *
              (M_cand ι_star p) ^ (deg : ℕ) = 0) := by
    intro y_m t_m r_m M_cand _ hr_m_pos hBm_sub hMcand_holo
      ⟨V_τ, hVτ_open, hVτ_ne, hVτ_sub, hVτ_cand⟩ M D ι_star P_coeff
    let B_m : Set (ℂ × ℂ) := Metric.ball ((y_m : ℂ), (t_m : ℂ)) r_m
    let H_poly : (ℂ × ℂ) → ℂ → ℂ → ℂ := fun p z₀ z₁ =>
      ∑ deg : Fin (D + 1),
        MvPolynomial.eval (symJetEnv C q_idx M p) (P_coeff deg) *
          (if ι_star = 0 then z₀ else z₁) ^ (deg : ℕ)
    have hsel_eq : ∀ (F_fn : Fin 2 → ℂ × ℂ → ℂ) (q : ℂ × ℂ),
        (if ι_star = 0 then F_fn 0 q else F_fn 1 q) = F_fn ι_star q := by
      intro F_fn q; fin_cases ι_star <;> rfl
    have hf_log_holo : DifferentiableOn ℂ
        (fun p => H_poly (E_exp p) (M_log 0 p) (M_log 1 p)) U_log := by
      have hfn : (fun p => H_poly (E_exp p) (M_log 0 p) (M_log 1 p)) =
          (fun p => ∑ deg : Fin (D + 1),
            MvPolynomial.eval (symJetEnv C q_idx M (E_exp p)) (P_coeff deg) *
              (M_log ι_star p) ^ (deg : ℕ)) := by
        ext p; dsimp [H_poly]; rw [hsel_eq]
      rw [hfn]
      exact hPolySum_holo M D P_coeff hE_exp_diff.differentiableOn hU_log_maps_dom
        (hM_log_holo ι_star)
    have hf_end_holo : DifferentiableOn ℂ
        (fun p => H_poly p (Br.M₁_end 0 p) (Br.M₁_end 1 p)) B_end := by
      have hfn : (fun p => H_poly p (Br.M₁_end 0 p) (Br.M₁_end 1 p)) =
          (fun p => ∑ deg : Fin (D + 1),
            MvPolynomial.eval (symJetEnv C q_idx M p) (P_coeff deg) *
              (Br.M₁_end ι_star p) ^ (deg : ℕ)) := by
        ext p; dsimp [H_poly]; rw [hsel_eq]
      rw [hfn]
      exact hPolySum_holo M D P_coeff differentiableOn_id hB_end_sub_dom
        (Br.M₁_end_holo ι_star)
    have hf_cand_holo : DifferentiableOn ℂ
        (fun p => ∑ deg : Fin (D + 1),
          MvPolynomial.eval (symJetEnv C q_idx M p) (P_coeff deg) *
            (M_cand ι_star p) ^ (deg : ℕ)) B_m :=
      hPolySum_holo M D P_coeff differentiableOn_id hBm_sub (hMcand_holo ι_star)
    constructor
    · intro hEnd
      have hf_log_zero_B : ∀ p ∈ Metric.ball p_log_end r_log_end,
          H_poly (E_exp p) (M_log 0 p) (M_log 1 p) = 0 := by
        intro p hp
        dsimp [H_poly]
        rw [hsel_eq, hM_log_eq_end ι_star p hp]
        exact hEnd (E_exp p) (hexp_maps_end p hp)
      have hf_log_zero : ∀ p ∈ U_log, H_poly (E_exp p) (M_log 0 p) (M_log 1 p) = 0 :=
        hKit.eqOn_zero_of_preconnected_2D hU_log_open hU_log_preconn
          Metric.isOpen_ball ⟨p_log_end, Metric.mem_ball_self hr_log_end_pos⟩
          hB_log_end_sub hf_log_holo hf_log_zero_B
      have hf_puis_zero : ∀ q ∈ B_puis_punc,
          ∑ deg : Fin (D + 1),
            MvPolynomial.eval (symJetEnv C q_idx M (q.1, q.2 ^ d)) (P_coeff deg) *
              (M_puis ι_star q) ^ (deg : ℕ) = 0 := by
        intro q hq
        obtain ⟨hq_log, hq_exp, hq_Mp⟩ := hM_puis_def q hq
        have h0 := hf_log_zero (q.1, (d : ℂ) * Complex.log q.2) hq_log
        dsimp [H_poly, E_exp] at h0
        rw [hsel_eq, hq_exp, ← hq_Mp ι_star] at h0
        exact h0
      obtain ⟨q₀, hq₀_V⟩ := hVτ_ne
      have hq₀_punc : q₀ ∈ B_puis_punc := hVτ_sub hq₀_V
      let τ'₀ : ℂ := q₀.2
      have hτ'₀_ne : τ'₀ ≠ 0 := hq₀_punc.2.2
      let t'₀ : ℂ := τ'₀ ^ d
      have ht'₀_ne : t'₀ ≠ 0 := pow_ne_zero d hτ'₀_ne
      let p'₀ : ℂ × ℂ := (q₀.1, t'₀)
      have hp'₀_Bm : p'₀ ∈ B_m := (hVτ_cand q₀ hq₀_V).1
      let ℓ_root : ℂ → ℂ :=
        fun t => τ'₀ * Complex.exp (Complex.log (t / t'₀) / (d : ℂ))
      have hℓ_at_t'₀ : ℓ_root t'₀ = τ'₀ := by
        dsimp [ℓ_root]
        rw [div_self ht'₀_ne, Complex.log_one, zero_div, Complex.exp_zero, mul_one]
      have hdiv_slit : t'₀ / t'₀ ∈ Complex.slitPlane := by
        rw [div_self ht'₀_ne]; exact Complex.one_mem_slitPlane
      have hlog_div_contAt : ContinuousAt (fun t : ℂ => Complex.log (t / t'₀)) t'₀ :=
        ContinuousAt.comp (g := Complex.log) (f := fun t : ℂ => t / t'₀)
          (Complex.differentiableAt_log hdiv_slit).continuousAt
          (continuousAt_id.div_const t'₀)
      have hexp_div_contAt :
          ContinuousAt (fun t : ℂ => Complex.exp (Complex.log (t / t'₀) / (d : ℂ))) t'₀ :=
        ContinuousAt.comp (g := Complex.exp)
          (f := fun t : ℂ => Complex.log (t / t'₀) / (d : ℂ))
          Complex.continuous_exp.continuousAt (hlog_div_contAt.div_const (d : ℂ))
      have hℓ_contAt : ContinuousAt ℓ_root t'₀ :=
        continuousAt_const.mul hexp_div_contAt
      let Φ_sec : ℂ × ℂ → ℂ × ℂ := fun p => (p.1, ℓ_root p.2)
      have hΦ_at_p'₀ : Φ_sec p'₀ = q₀ := Prod.ext rfl hℓ_at_t'₀
      have hΦ_contAt : ContinuousAt Φ_sec p'₀ :=
        continuousAt_fst.prodMk
          (ContinuousAt.comp (g := ℓ_root) (f := Prod.snd) hℓ_contAt continuousAt_snd)
      have hdiv2_open : IsOpen ((fun p : ℂ × ℂ => p.2 / t'₀) ⁻¹' Complex.slitPlane) :=
        Complex.isOpen_slitPlane.preimage (continuous_snd.div_const t'₀)
      have h_nhds_m :
          B_m ∩ ((fun p : ℂ × ℂ => p.2 / t'₀) ⁻¹' Complex.slitPlane) ∩ (Φ_sec ⁻¹' V_τ) ∈
            nhds p'₀ :=
        Filter.inter_mem
          (Filter.inter_mem
            (Metric.isOpen_ball.mem_nhds hp'₀_Bm)
            (hdiv2_open.mem_nhds hdiv_slit))
          (hΦ_contAt.preimage_mem_nhds (hΦ_at_p'₀.symm ▸ hVτ_open.mem_nhds hq₀_V))
      obtain ⟨δ_m, hδ_m_pos, hδ_m_sub⟩ := Metric.mem_nhds_iff.mp h_nhds_m
      have hf_cand_ball : ∀ p ∈ Metric.ball p'₀ δ_m,
          ∑ deg : Fin (D + 1),
            MvPolynomial.eval (symJetEnv C q_idx M p) (P_coeff deg) *
              (M_cand ι_star p) ^ (deg : ℕ) = 0 := by
        intro p hp
        obtain ⟨⟨_, hp_slit⟩, hp_Φ⟩ := hδ_m_sub hp
        have hdiv_ne : p.2 / t'₀ ≠ 0 := Complex.slitPlane_ne_zero hp_slit
        have hℓ_pow : (ℓ_root p.2) ^ d = p.2 := by
          dsimp [ℓ_root]
          rw [mul_pow, ← Complex.exp_nat_mul, mul_div_cancel₀ _ hd_ne_C,
            Complex.exp_log hdiv_ne]
          dsimp [t'₀]
          exact mul_div_cancel₀ p.2 ht'₀_ne
        have hΦ_pow : ((Φ_sec p).1, (Φ_sec p).2 ^ d) = p := Prod.ext rfl hℓ_pow
        have hcand_eq : M_cand ι_star p = M_puis ι_star (Φ_sec p) := by
          have h1 := (hVτ_cand (Φ_sec p) hp_Φ).2 ι_star
          rw [hΦ_pow] at h1
          exact h1.symm
        rw [hcand_eq]
        simpa only [hΦ_pow] using hf_puis_zero (Φ_sec p) (hVτ_sub hp_Φ)
      exact hKit.eqOn_zero_of_preconnected_2D Metric.isOpen_ball
        (convex_ball _ _).isPreconnected Metric.isOpen_ball
        ⟨p'₀, Metric.mem_ball_self hδ_m_pos⟩
        (fun p hp => ((hδ_m_sub hp).1).1) hf_cand_holo hf_cand_ball
    · intro hCand
      have hEnd := hVanish_puis_to_end H_poly V_τ hf_log_holo hf_end_holo
        hVτ_open hVτ_ne hVτ_sub
        (fun q hq => by
          dsimp [H_poly]
          rw [hsel_eq, (hVτ_cand q hq).2 ι_star]
          exact hCand (q.1, q.2 ^ d) (hVτ_cand q hq).1)
      intro p hp
      have h0 := hEnd p hp
      dsimp [H_poly] at h0
      rwa [hsel_eq] at h0

  
  
  
  exact ⟨{
    d := d
    d_pos := hd_pos
    r_yp := r_yp
    r_τ := r_τ
    K_p := K_p
    r_yp_pos := hr_yp_pos
    r_yp_le := hr_yp_le
    r_τ_pos := hr_τ_pos
    r_τ_pow_lt := hr_τ_pow_lt
    M_puis := M_puis
    N_puis := N_puis
    M_puis_holo := hM_puis_holo
    N_puis_holo := hN_puis_holo
    N_puis_eq := hN_puis_eq
    puis_rank_one := fun p hp => (hpuis_rank_one_and_reflect p hp).1
    puis_reflect := fun p hp => (hpuis_rank_one_and_reflect p hp).2
    not_w2_zero := hnot_w2_zero
    not_iso_line := hnot_iso_line
    not_prev_eq := hnot_prev_eq
    not_primary := hnot_primary
    puis_poly_transfer := hpuis_poly_transfer
  }⟩

theorem wronskian_tau_reduction_and_regular_slice (Ω : Set Plane)
    (C : AnalyticGlancingCollar Ω)
    (hDet : EndpointDeterminationData C)
    (W : CollarWidthTubeData C hDet)
    (hKit : Holo2DAndTaylorToolkit)
    (t₂ : ℝ)
    (D_wall : AlignedWallDefectData W t₂)
    (N_idx : ℕ)
    (q_idx : Fin N_idx → ℤ)
    (Br : PuncturedGlancingBridgeData W t₂ D_wall q_idx)
    (G : PuiseuxCoverGermData W t₂ D_wall q_idx Br) :
    Nonempty (RegularAffineIntersectionData W t₂ D_wall q_idx Br G) :=
by
  classical
  
  have h_tau_extract :
      ∀ (y_c : ℂ) (r_y r_τ : ℝ), 0 < r_y → 0 < r_τ →
        ∀ (K : ℕ) (F : Fin K → ℂ × ℂ → ℂ),
          (∀ k : Fin K, DifferentiableOn ℂ (F k) (Metric.ball y_c r_y ×ˢ Metric.ball (0 : ℂ) r_τ)) →
          (∃ k_nz : Fin K, ∃ p_star ∈ Metric.ball y_c r_y ×ˢ Metric.ball (0 : ℂ) r_τ,
            F k_nz p_star ≠ 0) →
          ∃ (m : ℕ) (F_div : Fin K → ℂ × ℂ → ℂ),
            (∀ k : Fin K,
              DifferentiableOn ℂ (F_div k) (Metric.ball y_c r_y ×ˢ Metric.ball (0 : ℂ) r_τ)) ∧
            (∀ k : Fin K, ∀ p ∈ Metric.ball y_c r_y ×ˢ Metric.ball (0 : ℂ) r_τ,
              F k p = p.2 ^ m * F_div k p) ∧
            (∃ k₀ : Fin K, ∃ y₀ ∈ Metric.ball y_c r_y, F_div k₀ (y₀, 0) ≠ 0) := by
    intro y_c r_y r_τ hr_y hr_τ K F hF_holo hF_nz
    let U_y : Set ℂ := Metric.ball y_c r_y
    let B : Set (ℂ × ℂ) := U_y ×ˢ Metric.ball (0 : ℂ) r_τ
    have hB_open : IsOpen B := Metric.isOpen_ball.prod Metric.isOpen_ball
    let π₁ : (ℂ × ℂ) →L[ℂ] ℂ :=
      { toLinearMap := { toFun := Prod.fst, map_add' := fun _ _ => rfl, map_smul' := fun _ _ => rfl }
        cont := continuous_fst }
    let π₂ : (ℂ × ℂ) →L[ℂ] ℂ :=
      { toLinearMap := { toFun := Prod.snd, map_add' := fun _ _ => rfl, map_smul' := fun _ _ => rfl }
        cont := continuous_snd }
    have hπ₁_apply : ∀ q : ℂ × ℂ, π₁ q = q.1 := fun _ => rfl
    have hπ₂_apply : ∀ q : ℂ × ℂ, π₂ q = q.2 := fun _ => rfl
    have hπ₁_norm : ‖π₁‖ ≤ 1 :=
      ContinuousLinearMap.opNorm_le_bound π₁ zero_le_one
        (fun q => by simpa [hπ₁_apply] using norm_fst_le q)
    have hπ₂_norm : ‖π₂‖ ≤ 1 :=
      ContinuousLinearMap.opNorm_le_bound π₂ zero_le_one
        (fun q => by simpa [hπ₂_apply] using norm_snd_le q)
    have hfderiv_decomp : ∀ {g : ℂ × ℂ → ℂ}, DifferentiableOn ℂ g B → ∀ q ∈ B,
        HasFDerivAt g (pderivA g q • π₁ + pderivD g q • π₂) q := by
      intro g hg q hq
      have hL : HasFDerivAt g (fderiv ℂ g q) q :=
        (hg.differentiableAt (hB_open.mem_nhds hq)).hasFDerivAt
      have hinj1 : HasDerivAt (fun z : ℂ => (z, q.2)) (1, 0) q.1 :=
        (hasDerivAt_id q.1).prodMk (hasDerivAt_const q.1 q.2)
      have hinj2 : HasDerivAt (fun w : ℂ => (q.1, w)) (0, 1) q.2 :=
        (hasDerivAt_const q.2 q.1).prodMk (hasDerivAt_id q.2)
      have hpA : pderivA g q = (fderiv ℂ g q) (1, 0) := (hL.comp_hasDerivAt q.1 hinj1).deriv
      have hpD : pderivD g q = (fderiv ℂ g q) (0, 1) := (hL.comp_hasDerivAt q.2 hinj2).deriv
      refine hL.congr_fderiv ?_
      refine ContinuousLinearMap.ext fun ⟨u, v⟩ => ?_
      have huv : (u, v) = u • ((1 : ℂ), (0 : ℂ)) + v • ((0 : ℂ), (1 : ℂ)) := by
        refine Prod.ext ?_ ?_ <;> (change _ = u * _ + v * _; ring)
      conv_lhs => rw [huv, map_add, map_smul, map_smul]
      rw [← hpA, ← hpD]
      change u * pderivA g q + v * pderivD g q = pderivA g q * u + pderivD g q * v
      ring
    have hparam_int01_holo : ∀ (p₀ : ℂ × ℂ) (r B_bnd : ℝ), 0 < r →
        ∀ (g : ℂ × ℂ → ℂ) (Φ : (ℂ × ℂ) → ℝ → ℂ) (Φ' : (ℂ × ℂ) → ℝ → ((ℂ × ℂ) →L[ℂ] ℂ)),
        (∀ p ∈ Metric.ball p₀ r, g p = ∫ s in (0 : ℝ)..1, Φ p s) →
        (∀ p ∈ Metric.ball p₀ r, ContinuousOn (Φ p) (Set.Icc 0 1)) →
        ContinuousOn (Φ' p₀) (Set.Icc 0 1) →
        (∀ s ∈ Set.Icc (0 : ℝ) 1, ∀ p ∈ Metric.ball p₀ r, ‖Φ' p s‖ ≤ B_bnd) →
        (∀ s ∈ Set.Icc (0 : ℝ) 1, ∀ p ∈ Metric.ball p₀ r, HasFDerivAt (fun q => Φ q s) (Φ' p s) p) →
        DifferentiableAt ℂ g p₀ := by
      intro p₀ r B_bnd hr g Φ Φ' hrep hcont hcont' hbnd hfderiv
      have huIoc : Set.uIoc (0 : ℝ) 1 = Set.Ioc 0 1 := Set.uIoc_of_le zero_le_one
      have hint : HasFDerivAt (fun p => ∫ s in (0 : ℝ)..1, Φ p s)
          (∫ s in (0 : ℝ)..1, Φ' p₀ s) p₀ :=
        intervalIntegral.hasFDerivAt_integral_of_dominated_of_fderiv_le (𝕜 := ℂ)
          (Metric.ball_mem_nhds p₀ hr)
          (by filter_upwards [Metric.ball_mem_nhds p₀ hr] with p hp
              rw [huIoc]
              exact ((hcont p hp).mono Set.Ioc_subset_Icc_self).aestronglyMeasurable measurableSet_Ioc)
          ((hcont p₀ (Metric.mem_ball_self hr)).intervalIntegrable_of_Icc zero_le_one)
          (by rw [huIoc]
              exact (hcont'.mono Set.Ioc_subset_Icc_self).aestronglyMeasurable measurableSet_Ioc)
          (Filter.Eventually.of_forall fun s hs p hp =>
            hbnd s (Set.Ioc_subset_Icc_self (huIoc ▸ hs)) p hp)
          intervalIntegrable_const
          (Filter.Eventually.of_forall fun s hs p hp =>
            hfderiv s (Set.Ioc_subset_Icc_self (huIoc ▸ hs)) p hp)
      exact hint.differentiableAt.congr_of_eventuallyEq
        (Filter.eventuallyEq_of_mem (Metric.ball_mem_nhds p₀ hr) hrep)
    let divTauStep : (ℂ × ℂ → ℂ) → (ℂ × ℂ → ℂ) :=
      fun g p => ∫ s in (0 : ℝ)..1, pderivD g (p.1, (s : ℂ) * p.2)
    have hstep_holo : ∀ {g : ℂ × ℂ → ℂ},
        DifferentiableOn ℂ g B → DifferentiableOn ℂ (divTauStep g) B := by
      intro g hg p₀ hp₀
      apply DifferentiableAt.differentiableWithinAt
      let h : ℂ × ℂ → ℂ := pderivD g
      have hh : DifferentiableOn ℂ h B := (hKit.pderiv_holo hB_open hg).2
      obtain ⟨hhA, hhD⟩ := hKit.pderiv_holo hB_open hh
      have hy₀ : dist p₀.1 y_c < r_y := Metric.mem_ball.mp hp₀.1
      have hτ₀ : ‖p₀.2‖ < r_τ := by simpa [Metric.mem_ball, dist_zero_right] using hp₀.2
      let r : ℝ := min ((r_y - dist p₀.1 y_c) / 2) ((r_τ - ‖p₀.2‖) / 2)
      have hr : 0 < r := lt_min (by linarith) (by linarith)
      have hr_y_le : r ≤ (r_y - dist p₀.1 y_c) / 2 := min_le_left _ _
      have hr_τ_le : r ≤ (r_τ - ‖p₀.2‖) / 2 := min_le_right _ _
      let R_τ : ℝ := ‖p₀.2‖ + r
      have hR_τ_lt : R_τ < r_τ := by dsimp [R_τ]; linarith
      let K_box : Set (ℂ × ℂ) := Metric.closedBall p₀.1 r ×ˢ Metric.closedBall (0 : ℂ) R_τ
      have hK_compact : IsCompact K_box :=
        (ProperSpace.isCompact_closedBall p₀.1 r).prod
          (ProperSpace.isCompact_closedBall (0 : ℂ) R_τ)
      have hK_sub : K_box ⊆ B := by
        intro q hq
        refine ⟨Metric.mem_ball.mpr ?_, Metric.mem_ball.mpr ?_⟩
        · have hq1 : dist q.1 p₀.1 ≤ r := Metric.mem_closedBall.mp hq.1
          linarith [dist_triangle q.1 p₀.1 y_c]
        · have hq2 : dist q.2 0 ≤ R_τ := Metric.mem_closedBall.mp hq.2
          linarith
      obtain ⟨M_A0, hM_A0⟩ := hK_compact.exists_bound_of_continuousOn (hhA.continuousOn.mono hK_sub)
      obtain ⟨M_D0, hM_D0⟩ := hK_compact.exists_bound_of_continuousOn (hhD.continuousOn.mono hK_sub)
      let M_A : ℝ := max M_A0 0
      let M_D : ℝ := max M_D0 0
      have hM_A_nonneg : 0 ≤ M_A := le_max_right _ _
      have hM_D_nonneg : 0 ≤ M_D := le_max_right _ _
      let B_bnd : ℝ := M_A + M_D
      have hscale_mem : ∀ s ∈ Set.Icc (0 : ℝ) 1, ∀ p ∈ Metric.ball p₀ r,
          (p.1, (s : ℂ) * p.2) ∈ K_box := by
        intro s hs p hp
        rw [Metric.mem_ball, Prod.dist_eq, max_lt_iff] at hp
        refine ⟨Metric.mem_closedBall.mpr (le_of_lt hp.1), ?_⟩
        rw [Metric.mem_closedBall, dist_zero_right, norm_mul, Complex.norm_real, Real.norm_eq_abs,
          abs_of_nonneg hs.1]
        have hp2_norm : ‖p.2‖ ≤ R_τ := by
          have htri : ‖p.2‖ ≤ ‖p.2 - p₀.2‖ + ‖p₀.2‖ := by
            simpa using norm_add_le (p.2 - p₀.2) p₀.2
          have hd : ‖p.2 - p₀.2‖ < r := by simpa [dist_eq_norm] using hp.2
          dsimp [R_τ]; linarith
        calc s * ‖p.2‖ ≤ 1 * R_τ := mul_le_mul hs.2 hp2_norm (norm_nonneg _) zero_le_one
          _ = R_τ := one_mul R_τ
      let L_s : ℝ → ((ℂ × ℂ) →L[ℂ] (ℂ × ℂ)) := fun s =>
        { toLinearMap :=
            { toFun := fun q => (q.1, (s : ℂ) * q.2)
              map_add' := fun q₁ q₂ => Prod.ext rfl (mul_add (s : ℂ) q₁.2 q₂.2)
              map_smul' := fun c q => Prod.ext rfl (by
                change (s : ℂ) * (c * q.2) = c * ((s : ℂ) * q.2); ring) }
          cont := continuous_fst.prodMk (continuous_const.mul continuous_snd) }
      let Φ : (ℂ × ℂ) → ℝ → ℂ := fun p s => h (p.1, (s : ℂ) * p.2)
      let Φ' : (ℂ × ℂ) → ℝ → ((ℂ × ℂ) →L[ℂ] ℂ) := fun p s =>
        pderivA h (p.1, (s : ℂ) * p.2) • π₁ + ((s : ℂ) * pderivD h (p.1, (s : ℂ) * p.2)) • π₂
      refine hparam_int01_holo p₀ r B_bnd hr (divTauStep g) Φ Φ' (fun _ _ => rfl) ?_ ?_ ?_ ?_
      · intro p hp
        have hpath : Continuous (fun s : ℝ => (p.1, (s : ℂ) * p.2)) :=
          continuous_const.prodMk (Complex.continuous_ofReal.mul continuous_const)
        exact hh.continuousOn.comp hpath.continuousOn (fun s hs => hK_sub (hscale_mem s hs p hp))
      · have hp₀_mem : p₀ ∈ Metric.ball p₀ r := Metric.mem_ball_self hr
        have hpath : Continuous (fun s : ℝ => (p₀.1, (s : ℂ) * p₀.2)) :=
          continuous_const.prodMk (Complex.continuous_ofReal.mul continuous_const)
        have hcA : ContinuousOn (fun s : ℝ => pderivA h (p₀.1, (s : ℂ) * p₀.2)) (Set.Icc 0 1) :=
          hhA.continuousOn.comp hpath.continuousOn (fun s hs => hK_sub (hscale_mem s hs p₀ hp₀_mem))
        have hcD : ContinuousOn (fun s : ℝ => (s : ℂ) * pderivD h (p₀.1, (s : ℂ) * p₀.2))
            (Set.Icc 0 1) :=
          Complex.continuous_ofReal.continuousOn.mul
            (hhD.continuousOn.comp hpath.continuousOn
              (fun s hs => hK_sub (hscale_mem s hs p₀ hp₀_mem)))
        exact (hcA.smul continuousOn_const).add (hcD.smul continuousOn_const)
      · intro s hs p hp
        have hqK : (p.1, (s : ℂ) * p.2) ∈ K_box := hscale_mem s hs p hp
        have hbA : ‖pderivA h (p.1, (s : ℂ) * p.2)‖ ≤ M_A :=
          (hM_A0 _ hqK).trans (le_max_left _ _)
        have hbD : ‖pderivD h (p.1, (s : ℂ) * p.2)‖ ≤ M_D :=
          (hM_D0 _ hqK).trans (le_max_left _ _)
        have hs_abs : ‖(s : ℂ)‖ ≤ 1 := by
          rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hs.1]
          exact hs.2
        calc ‖Φ' p s‖
            ≤ ‖pderivA h (p.1, (s : ℂ) * p.2) • π₁‖ +
                ‖((s : ℂ) * pderivD h (p.1, (s : ℂ) * p.2)) • π₂‖ := norm_add_le _ _
          _ = ‖pderivA h (p.1, (s : ℂ) * p.2)‖ * ‖π₁‖ +
                (‖(s : ℂ)‖ * ‖pderivD h (p.1, (s : ℂ) * p.2)‖) * ‖π₂‖ := by
                rw [norm_smul, norm_smul, norm_mul]
          _ ≤ M_A * 1 + (1 * M_D) * 1 := by gcongr
          _ = B_bnd := by dsimp [B_bnd]; ring
      · intro s hs p hp
        have hqB : (L_s s) p ∈ B := hK_sub (hscale_mem s hs p hp)
        have hh_fd := (hfderiv_decomp hh ((L_s s) p) hqB).comp p (L_s s).hasFDerivAt
        refine hh_fd.congr_fderiv ?_
        refine ContinuousLinearMap.ext fun ⟨u, v⟩ => ?_
        change pderivA h (p.1, (s : ℂ) * p.2) * u + pderivD h (p.1, (s : ℂ) * p.2) * ((s : ℂ) * v) =
          pderivA h (p.1, (s : ℂ) * p.2) * u + ((s : ℂ) * pderivD h (p.1, (s : ℂ) * p.2)) * v
        ring
    have hstep_ftc : ∀ {g : ℂ × ℂ → ℂ}, DifferentiableOn ℂ g B →
        (∀ y ∈ U_y, g (y, 0) = 0) → ∀ p ∈ B, g p = p.2 * divTauStep g p := by
      intro g hg hg0 p hp
      have hpD_holo : DifferentiableOn ℂ (pderivD g) B := (hKit.pderiv_holo hB_open hg).2
      let φ : ℝ → ℂ := fun s => g (p.1, (s : ℂ) * p.2)
      let φ' : ℝ → ℂ := fun s => p.2 * pderivD g (p.1, (s : ℂ) * p.2)
      have hmem_seg : ∀ s ∈ Set.Icc (0 : ℝ) 1, (p.1, (s : ℂ) * p.2) ∈ B := by
        intro s hs
        refine ⟨hp.1, ?_⟩
        have hp2 : ‖p.2‖ < r_τ := by simpa [Metric.mem_ball, dist_zero_right] using hp.2
        rw [Metric.mem_ball, dist_zero_right, norm_mul, Complex.norm_real, Real.norm_eq_abs,
          abs_of_nonneg hs.1]
        calc s * ‖p.2‖ ≤ 1 * ‖p.2‖ := mul_le_mul_of_nonneg_right hs.2 (norm_nonneg _)
          _ < r_τ := by linarith
      have huIcc : Set.uIcc (0 : ℝ) 1 = Set.Icc 0 1 := Set.uIcc_of_le zero_le_one
      have hderiv_seg : ∀ s ∈ Set.uIcc (0 : ℝ) 1, HasDerivAt φ (φ' s) s := by
        intro s hs
        have hs' : s ∈ Set.Icc (0 : ℝ) 1 := huIcc ▸ hs
        have hqs : (p.1, (s : ℂ) * p.2) ∈ B := hmem_seg s hs'
        have hslice : DifferentiableAt ℂ (fun w : ℂ => g (p.1, w)) ((s : ℂ) * p.2) :=
          (hg.differentiableAt (hB_open.mem_nhds hqs)).comp ((s : ℂ) * p.2)
            ((differentiableAt_const p.1).prodMk differentiableAt_id)
        have hw : HasDerivAt (fun w : ℂ => g (p.1, w))
            (pderivD g (p.1, (s : ℂ) * p.2)) ((s : ℂ) * p.2) :=
          hslice.hasDerivAt
        have hlin : HasDerivAt (fun t : ℝ => (t : ℂ) * p.2) p.2 s := by
          simpa using (Complex.ofRealCLM.hasDerivAt (x := s)).mul_const p.2
        simpa [φ, φ', Function.comp_def, smul_eq_mul] using hw.scomp s hlin
      have hφ'_cont : ContinuousOn φ' (Set.Icc 0 1) := by
        have hpath : Continuous (fun s : ℝ => (p.1, (s : ℂ) * p.2)) :=
          continuous_const.prodMk (Complex.continuous_ofReal.mul continuous_const)
        exact continuousOn_const.mul (hpD_holo.continuousOn.comp hpath.continuousOn hmem_seg)
      have hint_eq := intervalIntegral.integral_eq_sub_of_hasDerivAt hderiv_seg
        (hφ'_cont.intervalIntegrable_of_Icc zero_le_one)
      have h1 : φ 1 = g p := by dsimp [φ]; simp
      have h0 : φ 0 = 0 := by dsimp [φ]; simp [hg0 p.1 hp.1]
      rw [h1, h0, sub_zero] at hint_eq
      dsimp only [φ', divTauStep] at hint_eq ⊢
      rw [intervalIntegral.integral_const_mul] at hint_eq
      exact hint_eq.symm
    let divTauSeq : (ℂ × ℂ → ℂ) → ℕ → (ℂ × ℂ → ℂ) := fun g n => (divTauStep^[n]) g
    have hseq_holo : ∀ (k : Fin K) (n : ℕ), DifferentiableOn ℂ (divTauSeq (F k) n) B := by
      intro k n
      induction n with
      | zero => exact hF_holo k
      | succ n ih =>
        dsimp only [divTauSeq]
        rw [Function.iterate_succ_apply']
        exact hstep_holo ih
    have hseq_factor : ∀ (k : Fin K) (n : ℕ),
        (∀ j < n, ∀ y ∈ U_y, divTauSeq (F k) j (y, 0) = 0) →
        ∀ p ∈ B, F k p = p.2 ^ n * divTauSeq (F k) n p := by
      intro k n
      induction n with
      | zero => intro _ p _; simp [divTauSeq]
      | succ n ih =>
        intro hzero p hp
        have hprev := ih (fun j hj => hzero j (Nat.lt_succ_of_lt hj)) p hp
        have hstep_n : divTauSeq (F k) n p = p.2 * divTauSeq (F k) (n + 1) p := by
          dsimp only [divTauSeq]
          rw [Function.iterate_succ_apply']
          exact hstep_ftc (hseq_holo k n) (hzero n (Nat.lt_succ_self n)) p hp
        rw [hprev, hstep_n]
        ring
    have hex : ∃ n : ℕ, ∃ k : Fin K, ∃ y ∈ U_y, divTauSeq (F k) n (y, 0) ≠ 0 := by
      by_contra hAllZero
      have hAllZero' : ∀ (n : ℕ) (k : Fin K), ∀ y ∈ U_y, divTauSeq (F k) n (y, 0) = 0 :=
        fun n k y hy => by_contra fun hne => hAllZero ⟨n, k, y, hy, hne⟩
      obtain ⟨k_nz, p_star, hp_star, hp_star_nz⟩ := hF_nz
      have hy_star : p_star.1 ∈ U_y := hp_star.1
      have hτ_star : ‖p_star.2‖ < r_τ := by simpa [Metric.mem_ball, dist_zero_right] using hp_star.2
      let R : ℝ := (‖p_star.2‖ + r_τ) / 2
      have hR_pos : 0 < R := by dsimp [R]; linarith [norm_nonneg p_star.2]
      have hτ_lt_R : ‖p_star.2‖ < R := by dsimp [R]; linarith
      have hR_lt_rτ : R < r_τ := by dsimp [R]; linarith
      have hcl_sub : Metric.closedBall (0 : ℂ) R ⊆ Metric.ball (0 : ℂ) r_τ :=
        Metric.closedBall_subset_ball hR_lt_rτ
      have hsliceF_cont :
          ContinuousOn (fun ζ : ℂ => F k_nz (p_star.1, ζ)) (Metric.closedBall (0 : ℂ) R) := by
        have hemb : Continuous (fun ζ : ℂ => (p_star.1, ζ)) := continuous_const.prodMk continuous_id
        exact (hF_holo k_nz).continuousOn.comp hemb.continuousOn (fun ζ hζ => ⟨hy_star, hcl_sub hζ⟩)
      obtain ⟨M₀, hM₀⟩ :=
        (ProperSpace.isCompact_closedBall (0 : ℂ) R).exists_bound_of_continuousOn hsliceF_cont
      let M : ℝ := max M₀ 0
      have hbound_n : ∀ n : ℕ, ‖F k_nz p_star‖ ≤ M * (‖p_star.2‖ / R) ^ n := by
        intro n
        let q_n : ℂ → ℂ := fun ζ => divTauSeq (F k_nz) n (p_star.1, ζ)
        have hq_holo : DifferentiableOn ℂ q_n (Metric.ball (0 : ℂ) r_τ) := by
          have hemb : Differentiable ℂ (fun ζ : ℂ => (p_star.1, ζ)) :=
            (differentiable_const p_star.1).prodMk differentiable_id
          exact (hseq_holo k_nz n).comp hemb.differentiableOn (fun ζ hζ => ⟨hy_star, hζ⟩)
        have hdcc : DiffContOnCl ℂ q_n (Metric.ball (0 : ℂ) R) := hq_holo.diffContOnCl_ball hcl_sub
        have hfront : ∀ ζ ∈ frontier (Metric.ball (0 : ℂ) R), ‖q_n ζ‖ ≤ M / R ^ n := by
          intro ζ hζ
          rw [frontier_ball (0 : ℂ) hR_pos.ne'] at hζ
          have hζ_norm : ‖ζ‖ = R := by simpa [Metric.mem_sphere, dist_zero_right] using hζ
          have hζ_cl : ζ ∈ Metric.closedBall (0 : ℂ) R := Metric.sphere_subset_closedBall hζ
          have hζ_B : (p_star.1, ζ) ∈ B := ⟨hy_star, hcl_sub hζ_cl⟩
          have hfac := hseq_factor k_nz n (fun j _ y hy => hAllZero' j k_nz y hy) (p_star.1, ζ) hζ_B
          have hnorm_eq : R ^ n * ‖q_n ζ‖ = ‖F k_nz (p_star.1, ζ)‖ := by
            calc R ^ n * ‖q_n ζ‖ = ‖ζ‖ ^ n * ‖q_n ζ‖ := by rw [hζ_norm]
              _ = ‖ζ ^ n * q_n ζ‖ := by rw [norm_mul, norm_pow]
              _ = ‖F k_nz (p_star.1, ζ)‖ := by rw [← hfac]
          have hle_M : ‖F k_nz (p_star.1, ζ)‖ ≤ M := (hM₀ ζ hζ_cl).trans (le_max_left _ _)
          rw [le_div_iff₀' (pow_pos hR_pos n), hnorm_eq]
          exact hle_M
        have hτ_cl : p_star.2 ∈ closure (Metric.ball (0 : ℂ) R) :=
          subset_closure (by simpa [Metric.mem_ball, dist_zero_right] using hτ_lt_R)
        have hq_star : ‖q_n p_star.2‖ ≤ M / R ^ n :=
          Complex.norm_le_of_forall_mem_frontier_norm_le Metric.isBounded_ball hdcc hfront hτ_cl
        have hfac_star := hseq_factor k_nz n (fun j _ y hy => hAllZero' j k_nz y hy) p_star hp_star
        calc ‖F k_nz p_star‖
            = ‖p_star.2 ^ n * q_n p_star.2‖ := by rw [← hfac_star]
          _ = ‖p_star.2‖ ^ n * ‖q_n p_star.2‖ := by rw [norm_mul, norm_pow]
          _ ≤ ‖p_star.2‖ ^ n * (M / R ^ n) :=
              mul_le_mul_of_nonneg_left hq_star (pow_nonneg (norm_nonneg _) n)
          _ = M * (‖p_star.2‖ / R) ^ n := by
              rw [div_pow ‖p_star.2‖ R n, mul_div_left_comm]
      have hr_nonneg : 0 ≤ ‖p_star.2‖ / R := div_nonneg (norm_nonneg _) hR_pos.le
      have hr_lt_one : ‖p_star.2‖ / R < 1 := (div_lt_one hR_pos).mpr hτ_lt_R
      have htend : Filter.Tendsto (fun n : ℕ => M * (‖p_star.2‖ / R) ^ n) Filter.atTop (nhds 0) := by
        simpa using tendsto_const_nhds.mul (tendsto_pow_atTop_nhds_zero_of_lt_one hr_nonneg hr_lt_one)
      have hle0 : ‖F k_nz p_star‖ ≤ 0 :=
        ge_of_tendsto htend (Filter.Eventually.of_forall hbound_n)
      exact not_lt_of_ge hle0 (norm_pos_iff.mpr hp_star_nz)
    let m : ℕ := Nat.find hex
    refine ⟨m, fun k => divTauSeq (F k) m, fun k => hseq_holo k m, ?_, Nat.find_spec hex⟩
    intro k p hp
    exact hseq_factor k m (fun j hj y hy => by
      by_contra hne
      exact Nat.find_min hex hj ⟨k, y, hy, hne⟩) p hp

  
  have h_wronsk_scale :
      ∀ {U : Set (ℂ × ℂ)}, IsOpen U → ∀ (ψ : ℂ × ℂ → ℂ) (F G_fn : Fin 3 → ℂ × ℂ → ℂ),
        DifferentiableOn ℂ ψ U →
        (∀ k : Fin 3, DifferentiableOn ℂ (F k) U) →
        (∀ k : Fin 3, ∀ q ∈ U, G_fn k q = ψ q * F k q) →
        ∀ p ∈ U, homRankOneDet G_fn p = (ψ p) ^ 3 * homRankOneDet F p := by
    intro U hU ψ F G_fn hψ hF hG_eq p hp
    have hdA : ∀ k : Fin 3,
        iterDerivYT 1 0 (G_fn k) p = pderivA ψ p * F k p + ψ p * iterDerivYT 1 0 (F k) p := by
      intro k
      have hopen_A : IsOpen {z : ℂ | (z, p.2) ∈ U} :=
        hU.preimage (continuous_id.prodMk continuous_const)
      have hev : (fun z : ℂ => G_fn k (z, p.2)) =ᶠ[nhds p.1]
          (fun z : ℂ => ψ (z, p.2) * F k (z, p.2)) := by
        filter_upwards [hopen_A.mem_nhds hp] with z hz
        exact hG_eq k (z, p.2) hz
      have hψ_at : DifferentiableAt ℂ (fun z : ℂ => ψ (z, p.2)) p.1 :=
        (hψ.differentiableAt (hU.mem_nhds hp)).comp p.1
          (differentiableAt_id.prodMk (differentiableAt_const p.2))
      have hF_at : DifferentiableAt ℂ (fun z : ℂ => F k (z, p.2)) p.1 :=
        ((hF k).differentiableAt (hU.mem_nhds hp)).comp p.1
          (differentiableAt_id.prodMk (differentiableAt_const p.2))
      change deriv (fun z : ℂ => G_fn k (z, p.2)) p.1 = _
      rw [hev.deriv_eq]
      exact (hψ_at.hasDerivAt.mul hF_at.hasDerivAt).deriv
    have hdD : ∀ k : Fin 3,
        iterDerivYT 0 1 (G_fn k) p = pderivD ψ p * F k p + ψ p * iterDerivYT 0 1 (F k) p := by
      intro k
      have hopen_D : IsOpen {w : ℂ | (p.1, w) ∈ U} :=
        hU.preimage (continuous_const.prodMk continuous_id)
      have hev : (fun w : ℂ => G_fn k (p.1, w)) =ᶠ[nhds p.2]
          (fun w : ℂ => ψ (p.1, w) * F k (p.1, w)) := by
        filter_upwards [hopen_D.mem_nhds hp] with w hw
        exact hG_eq k (p.1, w) hw
      have hψ_at : DifferentiableAt ℂ (fun w : ℂ => ψ (p.1, w)) p.2 :=
        (hψ.differentiableAt (hU.mem_nhds hp)).comp p.2
          ((differentiableAt_const p.1).prodMk differentiableAt_id)
      have hF_at : DifferentiableAt ℂ (fun w : ℂ => F k (p.1, w)) p.2 :=
        ((hF k).differentiableAt (hU.mem_nhds hp)).comp p.2
          ((differentiableAt_const p.1).prodMk differentiableAt_id)
      change deriv (fun w : ℂ => G_fn k (p.1, w)) p.2 = _
      rw [hev.deriv_eq]
      exact (hψ_at.hasDerivAt.mul hF_at.hasDerivAt).deriv
    dsimp only [homRankOneDet]
    rw [hG_eq 0 p hp, hG_eq 1 p hp, hG_eq 2 p hp, hdA 0, hdA 1, hdA 2, hdD 0, hdD 1, hdD 2]
    ring

  have h_wronsk_quotient :
      ∀ {U : Set (ℂ × ℂ)}, IsOpen U → ∀ (F : Fin 3 → ℂ × ℂ → ℂ) (Z : Fin 2 → ℂ × ℂ → ℂ),
        (∀ k : Fin 3, DifferentiableOn ℂ (F k) U) →
        (∀ p ∈ U, F 2 p ≠ 0) →
        (∀ p ∈ U, homRankOneDet F p = 0) →
        (∀ ι : Fin 2, ∀ p ∈ U, Z ι p = F ι.castSucc p / F 2 p) →
        ∀ p ∈ U, pderivA (Z 0) p * pderivD (Z 1) p = pderivD (Z 0) p * pderivA (Z 1) p := by
    intro U hU F Z hF hF2_nz hdet hZ_eq
    have hZ_holo : ∀ ι : Fin 2, DifferentiableOn ℂ (Z ι) U := fun ι =>
      (((hF ι.castSucc).mul ((hF 2).fun_inv hF2_nz)).congr
        (fun q hq => by rw [hZ_eq ι q hq, div_eq_mul_inv]; rfl))
    let F_Z : Fin 3 → ℂ × ℂ → ℂ :=
      fun k => if k = 0 then Z 0 else if k = 1 then Z 1 else fun _ => (1 : ℂ)
    have hFZ_holo : ∀ k : Fin 3, DifferentiableOn ℂ (F_Z k) U := by
      intro k; fin_cases k
      · exact hZ_holo 0
      · exact hZ_holo 1
      · exact differentiableOn_const (1 : ℂ)
    have hF_scale : ∀ k : Fin 3, ∀ q ∈ U, F k q = F 2 q * F_Z k q := by
      intro k q hq; fin_cases k
      · change F 0 q = F 2 q * Z 0 q
        rw [hZ_eq 0 q hq]; exact (mul_div_cancel₀ _ (hF2_nz q hq)).symm
      · change F 1 q = F 2 q * Z 1 q
        rw [hZ_eq 1 q hq]; exact (mul_div_cancel₀ _ (hF2_nz q hq)).symm
      · change F 2 q = F 2 q * 1
        exact (mul_one _).symm
    intro p hp
    have hscale := h_wronsk_scale hU (F 2) F_Z F (hF 2) hFZ_holo hF_scale p hp
    rw [hdet p hp] at hscale
    have hFZ_det : homRankOneDet F_Z p = 0 :=
      (mul_eq_zero.mp hscale.symm).resolve_left (pow_ne_zero 3 (hF2_nz p hp))
    have hcA : iterDerivYT 1 0 (fun _ : ℂ × ℂ => (1 : ℂ)) p = 0 := deriv_const p.1 (1 : ℂ)
    have hcD : iterDerivYT 0 1 (fun _ : ℂ × ℂ => (1 : ℂ)) p = 0 := deriv_const p.2 (1 : ℂ)
    have hFZ0 : F_Z 0 = Z 0 := rfl
    have hFZ1 : F_Z 1 = Z 1 := rfl
    have hFZ2 : F_Z 2 = fun _ => (1 : ℂ) := rfl
    dsimp only [homRankOneDet] at hFZ_det
    rw [hFZ0, hFZ1, hFZ2, hcA, hcD] at hFZ_det
    change Z 0 p * (pderivA (Z 1) p * 0 - pderivD (Z 1) p * 0) -
        Z 1 p * (pderivA (Z 0) p * 0 - pderivD (Z 0) p * 0) +
        1 * (pderivA (Z 0) p * pderivD (Z 1) p - pderivD (Z 0) p * pderivA (Z 1) p) = 0 at hFZ_det
    linear_combination hFZ_det

  have h_wronsk_tau_obs :
      ∀ (y_c : ℂ) (r_y r_τ : ℝ), 0 < r_y → 0 < r_τ →
        ∀ (m : ℕ) (F : Fin 3 → ℂ × ℂ → ℂ) (u₂ : ℂ × ℂ → ℂ),
          (∀ k : Fin 3,
            DifferentiableOn ℂ (F k) (Metric.ball y_c r_y ×ˢ Metric.ball (0 : ℂ) r_τ)) →
          DifferentiableOn ℂ u₂ (Metric.ball y_c r_y ×ˢ Metric.ball (0 : ℂ) r_τ) →
          (∀ p ∈ Metric.ball y_c r_y ×ˢ Metric.ball (0 : ℂ) r_τ,
            F 2 p = p.2 ^ (m + 1) * u₂ p) →
          (∀ p ∈ Metric.ball y_c r_y ×ˢ Metric.ball (0 : ℂ) r_τ, homRankOneDet F p = 0) →
          ∀ y ∈ Metric.ball y_c r_y,
            ((m + 1 : ℕ) : ℂ) * u₂ (y, 0) *
              (F 0 (y, 0) * pderivA (F 1) (y, 0) - F 1 (y, 0) * pderivA (F 0) (y, 0)) = 0 := by
    intro y_c r_y r_τ hr_y hr_τ m F u₂ hF hu₂ hF2 hdet
    let B : Set (ℂ × ℂ) := Metric.ball y_c r_y ×ˢ Metric.ball (0 : ℂ) r_τ
    have hB_open : IsOpen B := Metric.isOpen_ball.prod Metric.isOpen_ball
    obtain ⟨hF0A, hF0D⟩ := hKit.pderiv_holo hB_open (hF 0)
    obtain ⟨hF1A, hF1D⟩ := hKit.pderiv_holo hB_open (hF 1)
    obtain ⟨hu₂A, hu₂D⟩ := hKit.pderiv_holo hB_open hu₂
    let R_rem : ℂ × ℂ → ℂ := fun p =>
      F 0 p * (pderivA (F 1) p * (((m + 1 : ℕ) : ℂ) * u₂ p + p.2 * pderivD u₂ p) -
        pderivD (F 1) p * (p.2 * pderivA u₂ p)) -
      F 1 p * (pderivA (F 0) p * (((m + 1 : ℕ) : ℂ) * u₂ p + p.2 * pderivD u₂ p) -
        pderivD (F 0) p * (p.2 * pderivA u₂ p)) +
      (p.2 * u₂ p) * (pderivA (F 0) p * pderivD (F 1) p - pderivD (F 0) p * pderivA (F 1) p)
    have hτ_holo : DifferentiableOn ℂ Prod.snd B := differentiable_snd.differentiableOn
    have hterm_u : DifferentiableOn ℂ (fun p => ((m + 1 : ℕ) : ℂ) * u₂ p + p.2 * pderivD u₂ p) B :=
      ((differentiableOn_const _).mul hu₂).add (hτ_holo.mul hu₂D)
    have hR_holo : DifferentiableOn ℂ R_rem B :=
      (((hF 0).mul ((hF1A.mul hterm_u).sub (hF1D.mul (hτ_holo.mul hu₂A)))).sub
        ((hF 1).mul ((hF0A.mul hterm_u).sub (hF0D.mul (hτ_holo.mul hu₂A))))).add
        ((hτ_holo.mul hu₂).mul ((hF0A.mul hF1D).sub (hF0D.mul hF1A)))
    have hmul_zero : ∀ p ∈ B, p.2 ^ m * R_rem p = 0 := by
      intro p hp
      have hdA : iterDerivYT 1 0 (F 2) p = p.2 ^ (m + 1) * pderivA u₂ p := by
        have hopen_A : IsOpen {z : ℂ | (z, p.2) ∈ B} :=
          hB_open.preimage (continuous_id.prodMk continuous_const)
        have hev : (fun z : ℂ => F 2 (z, p.2)) =ᶠ[nhds p.1]
            (fun z : ℂ => p.2 ^ (m + 1) * u₂ (z, p.2)) := by
          filter_upwards [hopen_A.mem_nhds hp] with z hz
          exact hF2 (z, p.2) hz
        have hu_at : DifferentiableAt ℂ (fun z : ℂ => u₂ (z, p.2)) p.1 :=
          (hu₂.differentiableAt (hB_open.mem_nhds hp)).comp p.1
            (differentiableAt_id.prodMk (differentiableAt_const p.2))
        change deriv (fun z : ℂ => F 2 (z, p.2)) p.1 = _
        rw [hev.deriv_eq]
        exact (hu_at.hasDerivAt.const_mul (p.2 ^ (m + 1))).deriv
      have hdD : iterDerivYT 0 1 (F 2) p =
          p.2 ^ m * (((m + 1 : ℕ) : ℂ) * u₂ p + p.2 * pderivD u₂ p) := by
        have hopen_D : IsOpen {w : ℂ | (p.1, w) ∈ B} :=
          hB_open.preimage (continuous_const.prodMk continuous_id)
        have hev : (fun w : ℂ => F 2 (p.1, w)) =ᶠ[nhds p.2]
            (fun w : ℂ => w ^ (m + 1) * u₂ (p.1, w)) := by
          filter_upwards [hopen_D.mem_nhds hp] with w hw
          exact hF2 (p.1, w) hw
        have hu_at : DifferentiableAt ℂ (fun w : ℂ => u₂ (p.1, w)) p.2 :=
          (hu₂.differentiableAt (hB_open.mem_nhds hp)).comp p.2
            ((differentiableAt_const p.1).prodMk differentiableAt_id)
        have hpow_at : HasDerivAt (fun w : ℂ => w ^ (m + 1)) (((m + 1 : ℕ) : ℂ) * p.2 ^ m) p.2 := by
          simpa using hasDerivAt_pow (m + 1) p.2
        have hprod_d : deriv (fun w : ℂ => w ^ (m + 1) * u₂ (p.1, w)) p.2 =
            ((m + 1 : ℕ) : ℂ) * p.2 ^ m * u₂ p + p.2 ^ (m + 1) * pderivD u₂ p :=
          (hpow_at.mul hu_at.hasDerivAt).deriv
        change deriv (fun w : ℂ => F 2 (p.1, w)) p.2 = _
        rw [hev.deriv_eq, hprod_d]
        ring
      have h0 := hdet p hp
      dsimp only [homRankOneDet] at h0
      rw [hF2 p hp, hdA, hdD] at h0
      change F 0 p *
          (pderivA (F 1) p * (p.2 ^ m * (((m + 1 : ℕ) : ℂ) * u₂ p + p.2 * pderivD u₂ p)) -
            pderivD (F 1) p * (p.2 ^ (m + 1) * pderivA u₂ p)) -
        F 1 p *
          (pderivA (F 0) p * (p.2 ^ m * (((m + 1 : ℕ) : ℂ) * u₂ p + p.2 * pderivD u₂ p)) -
            pderivD (F 0) p * (p.2 ^ (m + 1) * pderivA u₂ p)) +
        p.2 ^ (m + 1) * u₂ p *
          (pderivA (F 0) p * pderivD (F 1) p - pderivD (F 0) p * pderivA (F 1) p) = 0 at h0
      dsimp only [R_rem]
      linear_combination h0
    let V : Set (ℂ × ℂ) := Metric.ball y_c r_y ×ˢ (Metric.ball (0 : ℂ) r_τ \ {0})
    have hV_open : IsOpen V :=
      Metric.isOpen_ball.prod (Metric.isOpen_ball.inter isOpen_compl_singleton)
    have hV_ne : V.Nonempty := by
      refine ⟨(y_c, ((r_τ / 2 : ℝ) : ℂ)), Metric.mem_ball_self hr_y, ?_, ?_⟩
      · rw [Metric.mem_ball, dist_zero_right, Complex.norm_real, Real.norm_eq_abs,
          abs_of_pos (half_pos hr_τ)]
        linarith
      · exact Complex.ofReal_ne_zero.mpr (half_pos hr_τ).ne'
    have hV_sub : V ⊆ B := Set.prod_mono Set.Subset.rfl Set.inter_subset_left
    have hR_V : ∀ p ∈ V, R_rem p = 0 := fun p hp =>
      (mul_eq_zero.mp (hmul_zero p (hV_sub hp))).resolve_left (pow_ne_zero m hp.2.2)
    have hB_preconn : IsPreconnected B :=
      (convex_ball y_c r_y).isPreconnected.prod (convex_ball (0 : ℂ) r_τ).isPreconnected
    have hR_B : ∀ p ∈ B, R_rem p = 0 :=
      hKit.eqOn_zero_of_preconnected_2D hB_open hB_preconn hV_open hV_ne hV_sub hR_holo hR_V
    intro y hy
    have hval := hR_B (y, 0) ⟨hy, Metric.mem_ball_self hr_τ⟩
    dsimp only [R_rem] at hval
    linear_combination hval

  
  have h_glancing_inf_obs :
      ∀ (y_c : ℂ) (R : ℝ) (θ w₀ w₁ v₂ : ℂ → ℂ),
        DifferentiableOn ℂ θ (Metric.ball y_c R) →
        DifferentiableOn ℂ w₀ (Metric.ball y_c R) →
        DifferentiableOn ℂ w₁ (Metric.ball y_c R) →
        DifferentiableOn ℂ v₂ (Metric.ball y_c R) →
        (∀ y ∈ Metric.ball y_c R, deriv θ y ≠ 0) →
        (∀ y ∈ Metric.ball y_c R, Complex.cos (θ y) * w₀ y + Complex.sin (θ y) * w₁ y = 0) →
        (∃ y_star ∈ Metric.ball y_c R, w₀ y_star ≠ 0 ∨ w₁ y_star ≠ 0) →
        (∃ y_u ∈ Metric.ball y_c R, v₂ y_u ≠ 0) →
        (∀ y ∈ Metric.ball y_c R, v₂ y * (w₀ y * deriv w₁ y - w₁ y * deriv w₀ y) = 0) →
        False := by
    intro y_c R θ w₀ w₁ v₂ hθ hw₀ hw₁ hv₂ hθ_deriv hinc hw_nz hv₂_nz hwronsk
    let U_loc : Set ℂ := Metric.ball y_c R
    let α : ℂ → ℂ := fun y => -Complex.sin (θ y) * w₀ y + Complex.cos (θ y) * w₁ y
    have hα_holo : DifferentiableOn ℂ α U_loc :=
      (((Complex.differentiable_sin.comp_differentiableOn hθ).neg).mul hw₀).add
        ((Complex.differentiable_cos.comp_differentiableOn hθ).mul hw₁)
    have hw_rec : ∀ y ∈ U_loc,
        w₀ y = -α y * Complex.sin (θ y) ∧ w₁ y = α y * Complex.cos (θ y) := by
      intro y hy
      have hcs := Complex.cos_sq_add_sin_sq (θ y)
      have h1 := hinc y hy
      have h2 : -Complex.sin (θ y) * w₀ y + Complex.cos (θ y) * w₁ y = α y := rfl
      constructor
      · linear_combination -(w₀ y) * hcs + Complex.cos (θ y) * h1 - Complex.sin (θ y) * h2
      · linear_combination -(w₁ y) * hcs + Complex.sin (θ y) * h1 + Complex.cos (θ y) * h2
    obtain ⟨y_star, hy_star, hw_star⟩ := hw_nz
    have hα_star_nz : α y_star ≠ 0 := by
      intro h0
      obtain ⟨hw0_eq, hw1_eq⟩ := hw_rec y_star hy_star
      rw [h0] at hw0_eq hw1_eq
      rcases hw_star with hnz | hnz
      · exact hnz (by linear_combination hw0_eq)
      · exact hnz (by linear_combination hw1_eq)
    have hwronsk_id : ∀ y ∈ U_loc,
        w₀ y * deriv w₁ y - w₁ y * deriv w₀ y = (α y) ^ 2 * deriv θ y := by
      intro y hy
      have hα_at : HasDerivAt α (deriv α y) y :=
        (hα_holo.differentiableAt (Metric.isOpen_ball.mem_nhds hy)).hasDerivAt
      have hθ_at : HasDerivAt θ (deriv θ y) y :=
        (hθ.differentiableAt (Metric.isOpen_ball.mem_nhds hy)).hasDerivAt
      have hsin_at : HasDerivAt (fun z => Complex.sin (θ z)) (Complex.cos (θ y) * deriv θ y) y :=
        (Complex.hasDerivAt_sin (θ y)).comp y hθ_at
      have hcos_at : HasDerivAt (fun z => Complex.cos (θ z)) (-Complex.sin (θ y) * deriv θ y) y :=
        (Complex.hasDerivAt_cos (θ y)).comp y hθ_at
      have hw₀_ev : w₀ =ᶠ[nhds y] (fun z => -α z * Complex.sin (θ z)) := by
        filter_upwards [Metric.isOpen_ball.mem_nhds hy] with z hz
        exact (hw_rec z hz).1
      have hw₁_ev : w₁ =ᶠ[nhds y] (fun z => α z * Complex.cos (θ z)) := by
        filter_upwards [Metric.isOpen_ball.mem_nhds hy] with z hz
        exact (hw_rec z hz).2
      have hdw₀ : deriv w₀ y =
          -deriv α y * Complex.sin (θ y) + (-α y) * (Complex.cos (θ y) * deriv θ y) := by
        rw [hw₀_ev.deriv_eq]
        exact (hα_at.neg.mul hsin_at).deriv
      have hdw₁ : deriv w₁ y =
          deriv α y * Complex.cos (θ y) + α y * (-Complex.sin (θ y) * deriv θ y) := by
        rw [hw₁_ev.deriv_eq]
        exact (hα_at.mul hcos_at).deriv
      obtain ⟨hw0_y, hw1_y⟩ := hw_rec y hy
      have hcs := Complex.cos_sq_add_sin_sq (θ y)
      rw [hw0_y, hw1_y, hdw₀, hdw₁]
      linear_combination (α y) ^ 2 * deriv θ y * hcs
    have hv₂_mul_zero : ∀ y ∈ U_loc, v₂ y * (α y) ^ 2 = 0 := by
      intro y hy
      have h0 := hwronsk y hy
      rw [hwronsk_id y hy, ← mul_assoc] at h0
      exact (mul_eq_zero.mp h0).resolve_right (hθ_deriv y hy)
    have hα_cont : ContinuousAt α y_star :=
      hα_holo.continuousOn.continuousAt (Metric.isOpen_ball.mem_nhds hy_star)
    have hv₂_ev0 : v₂ =ᶠ[nhds y_star] 0 := by
      filter_upwards [Metric.isOpen_ball.mem_nhds hy_star, hα_cont.eventually_ne hα_star_nz]
        with z hz hαz
      exact (mul_eq_zero.mp (hv₂_mul_zero z hz)).resolve_right (pow_ne_zero 2 hαz)
    have hv₂_ana : AnalyticOnNhd ℂ v₂ U_loc :=
      (Complex.analyticOnNhd_iff_differentiableOn Metric.isOpen_ball).mpr hv₂
    obtain ⟨y_u, hy_u, hy_u_nz⟩ := hv₂_nz
    exact hy_u_nz (hv₂_ana.eqOn_zero_of_preconnected_of_eventuallyEq_zero
      (convex_ball y_c R).isPreconnected hy_star hv₂_ev0 hy_u)

  have h_real_slice_nz :
      ∀ (y₀ R r : ℝ), 0 < r → r ≤ R → ∀ (f : ℂ → ℂ),
        DifferentiableOn ℂ f (Metric.ball (y₀ : ℂ) R) →
        (∃ z_star ∈ Metric.ball (y₀ : ℂ) R, f z_star ≠ 0) →
        ∃ y₁ ∈ Set.Ioo (y₀ - r) (y₀ + r), f (y₁ : ℂ) ≠ 0 := by
    intro y₀ R r hr_pos hr_le f hf hf_nz
    by_contra hAllZero
    have hAllZero' : ∀ x ∈ Set.Ioo (y₀ - r) (y₀ + r), f (x : ℂ) = 0 :=
      fun x hx => by_contra fun hne => hAllZero ⟨x, hx, hne⟩
    have hR_pos : 0 < R := lt_of_lt_of_le hr_pos hr_le
    have hf_ana : AnalyticOnNhd ℂ f (Metric.ball (y₀ : ℂ) R) :=
      (Complex.analyticOnNhd_iff_differentiableOn Metric.isOpen_ball).mpr hf
    let x_seq : ℕ → ℝ := fun n => y₀ + r / (2 * ((n : ℝ) + 1))
    have hx_mem : ∀ n : ℕ, x_seq n ∈ Set.Ioo (y₀ - r) (y₀ + r) ∧ (x_seq n : ℂ) ≠ (y₀ : ℂ) := by
      intro n
      have hn_pos : (0 : ℝ) < 2 * ((n : ℝ) + 1) := by positivity
      have hd_pos : 0 < r / (2 * ((n : ℝ) + 1)) := div_pos hr_pos hn_pos
      have hd_le : r / (2 * ((n : ℝ) + 1)) ≤ r / 2 :=
        div_le_div_of_nonneg_left hr_pos.le (by positivity)
          (by linarith [Nat.cast_nonneg (α := ℝ) n])
      refine ⟨⟨by dsimp [x_seq]; linarith, by dsimp [x_seq]; linarith⟩, ?_⟩
      intro heq
      have hre := congr_arg Complex.re heq
      simp only [Complex.ofReal_re] at hre
      dsimp [x_seq] at hre
      linarith
    have hx_tendsto : Filter.Tendsto (fun n : ℕ => (x_seq n : ℂ))
        Filter.atTop (nhdsWithin (y₀ : ℂ) {(y₀ : ℂ)}ᶜ) := by
      rw [tendsto_nhdsWithin_iff]
      refine ⟨?_, Filter.Eventually.of_forall (fun n => (hx_mem n).2)⟩
      have hreal : Filter.Tendsto x_seq Filter.atTop (nhds y₀) := by
        have hden : Filter.Tendsto (fun n : ℕ => 2 * ((n : ℝ) + 1)) Filter.atTop Filter.atTop :=
          Filter.Tendsto.const_mul_atTop (by norm_num)
            (Filter.tendsto_atTop_add_const_right _ 1 tendsto_natCast_atTop_atTop)
        simpa [x_seq] using Filter.Tendsto.const_add y₀ (tendsto_const_nhds.div_atTop hden)
      exact (Complex.continuous_ofReal.tendsto y₀).comp hreal
    have hfreq : ∃ᶠ z in nhdsWithin (y₀ : ℂ) {(y₀ : ℂ)}ᶜ, f z = 0 :=
      hx_tendsto.frequently
        ((Filter.Eventually.of_forall (fun n => hAllZero' (x_seq n) (hx_mem n).1)).frequently)
    obtain ⟨z_star, hz_star, hz_nz⟩ := hf_nz
    exact hz_nz (hf_ana.eqOn_zero_of_preconnected_of_frequently_eq_zero
      (convex_ball (y₀ : ℂ) R).isPreconnected (Metric.mem_ball_self hR_pos) hfreq hz_star)

  
  let U_y : Set ℂ := Metric.ball (Br.y₀ : ℂ) G.r_yp
  let B_puis : Set (ℂ × ℂ) := U_y ×ˢ Metric.ball (0 : ℂ) G.r_τ
  let B_punc : Set (ℂ × ℂ) := U_y ×ˢ (Metric.ball (0 : ℂ) G.r_τ \ {0})
  have hBpuis_open : IsOpen B_puis := Metric.isOpen_ball.prod Metric.isOpen_ball
  have hBpunc_open : IsOpen B_punc :=
    Metric.isOpen_ball.prod (Metric.isOpen_ball.inter isOpen_compl_singleton)
  have hBpunc_sub : B_punc ⊆ B_puis := Set.prod_mono Set.Subset.rfl Set.inter_subset_left
  have hBpuis_preconn : IsPreconnected B_puis :=
    (convex_ball (Br.y₀ : ℂ) G.r_yp).isPreconnected.prod
      (convex_ball (0 : ℂ) G.r_τ).isPreconnected
  have hBpunc_ne : B_punc.Nonempty := by
    refine ⟨((Br.y₀ : ℂ), ((G.r_τ / 2 : ℝ) : ℂ)), Metric.mem_ball_self G.r_yp_pos, ?_, ?_⟩
    · rw [Metric.mem_ball, dist_zero_right, Complex.norm_real, Real.norm_eq_abs,
        abs_of_pos (half_pos G.r_τ_pos)]
      linarith [G.r_τ_pos]
    · exact Complex.ofReal_ne_zero.mpr (half_pos G.r_τ_pos).ne'
  have hd_ne : G.d ≠ 0 := Nat.ne_of_gt G.d_pos
  let powMap : ℂ × ℂ → ℂ × ℂ := fun p => (p.1, p.2 ^ G.d)
  have hpow_maps_dom : ∀ p ∈ B_puis, powMap p ∈ symCollarDom W.s_base W.r_base q_idx := by
    intro p hp
    apply Br.bidisk_sub_dom
    refine ⟨Metric.ball_subset_ball (by linarith [G.r_yp_le, Br.r_y_pos]) hp.1, ?_⟩
    rw [Metric.mem_ball, dist_zero_right, norm_pow]
    have hp2 : ‖p.2‖ < G.r_τ := by simpa [Metric.mem_ball, dist_zero_right] using hp.2
    have hpow_lt : ‖p.2‖ ^ G.d < G.r_τ ^ G.d := pow_lt_pow_left₀ hp2 (norm_nonneg _) hd_ne
    linarith [G.r_τ_pow_lt, Br.r_t_pos]
  have hDom_bounds : ∀ q ∈ symCollarDom W.s_base W.r_base q_idx,
      |q.1.im| < 2 * hDet.s_det ∧ ‖q.2‖ < 2 * hDet.r_det :=
    fun q hq => ⟨by linarith [hq.1, W.s_base_le_det, hDet.s_det_pos],
      by linarith [hq.2.1, W.r_base_le_det, hDet.r_det_pos]⟩
  let L_puis : Fin 2 → ℂ × ℂ → ℂ := puisDualLine0 C G.d
  have hLpuis_eq : ∀ (ι : Fin 2) (p : ℂ × ℂ),
      L_puis ι p = glancingDualLine C p.1 (p.2 ^ G.d) ι := by
    intro ι p
    change glancingDualLine C (p.1 + ((0 : ℤ) : ℂ) * (p.2 ^ G.d)) (p.2 ^ G.d) ι = _
    have h0 : p.1 + ((0 : ℤ) : ℂ) * (p.2 ^ G.d) = p.1 := by push_cast; ring
    rw [h0]
  have hpuisDual0_holo : ∀ ι : Fin 2, DifferentiableOn ℂ (L_puis ι) B_puis := by
    intro ι
    have hfn : L_puis ι = (fun w : ℂ × ℂ => glancingDualLine C w.1 w.2 ι) ∘ powMap := by
      ext p; exact hLpuis_eq ι p
    rw [hfn]
    exact (hDet.dualLine_holo ι).comp
      (differentiable_fst.prodMk (differentiable_snd.pow G.d)).differentiableOn
      (fun p hp => hDom_bounds (powMap p) (hpow_maps_dom p hp))
  have hUy_im : ∀ y ∈ U_y, |y.im| < W.s_base / 2 :=
    fun y hy => (hpow_maps_dom (y, 0) ⟨hy, Metric.mem_ball_self G.r_τ_pos⟩).1

  let W₁_puis : Fin 3 → ℂ × ℂ → ℂ := homIntersect L_puis G.M_puis
  let W_raw : Fin 3 → ℂ × ℂ → ℂ := fun k p =>
    if k = 0 then G.N_puis 1 p - p.2 ^ G.K_p * L_puis 1 p
    else if k = 1 then p.2 ^ G.K_p * L_puis 0 p - G.N_puis 0 p
    else L_puis 0 p * G.N_puis 1 p - L_puis 1 p * G.N_puis 0 p
  have hτK_holo : DifferentiableOn ℂ (fun p : ℂ × ℂ => p.2 ^ G.K_p) B_puis :=
    (differentiable_snd.pow G.K_p).differentiableOn
  have hW_raw_holo : ∀ k : Fin 3, DifferentiableOn ℂ (W_raw k) B_puis := by
    intro k; fin_cases k
    · exact (G.N_puis_holo 1).sub (hτK_holo.mul (hpuisDual0_holo 1))
    · exact (hτK_holo.mul (hpuisDual0_holo 0)).sub (G.N_puis_holo 0)
    · exact ((hpuisDual0_holo 0).mul (G.N_puis_holo 1)).sub
        ((hpuisDual0_holo 1).mul (G.N_puis_holo 0))
  have hW_raw_punc : ∀ k : Fin 3, ∀ p ∈ B_punc, W_raw k p = p.2 ^ G.K_p * W₁_puis k p := by
    intro k p hp
    have hN0 := G.N_puis_eq 0 p (hBpunc_sub hp) hp.2.2
    have hN1 := G.N_puis_eq 1 p (hBpunc_sub hp) hp.2.2
    fin_cases k
    · change G.N_puis 1 p - p.2 ^ G.K_p * L_puis 1 p = p.2 ^ G.K_p * (G.M_puis 1 p - L_puis 1 p)
      rw [hN1]; ring
    · change p.2 ^ G.K_p * L_puis 0 p - G.N_puis 0 p = p.2 ^ G.K_p * (L_puis 0 p - G.M_puis 0 p)
      rw [hN0]; ring
    · change L_puis 0 p * G.N_puis 1 p - L_puis 1 p * G.N_puis 0 p =
        p.2 ^ G.K_p * (L_puis 0 p * G.M_puis 1 p - L_puis 1 p * G.M_puis 0 p)
      rw [hN0, hN1]; ring
  have hW_raw_inc : ∀ p : ℂ × ℂ,
      L_puis 0 p * W_raw 0 p + L_puis 1 p * W_raw 1 p = W_raw 2 p := by
    intro p
    change L_puis 0 p * (G.N_puis 1 p - p.2 ^ G.K_p * L_puis 1 p) +
        L_puis 1 p * (p.2 ^ G.K_p * L_puis 0 p - G.N_puis 0 p) =
      L_puis 0 p * G.N_puis 1 p - L_puis 1 p * G.N_puis 0 p
    ring
  have hex_pstar : ∃ p_star ∈ B_punc, W₁_puis 2 p_star ≠ 0 := by
    by_contra hAll
    exact G.not_w2_zero (fun p hp => by_contra fun hne => hAll ⟨p, hp, hne⟩)
  obtain ⟨p_star, hp_star_punc, hW1_2_pstar_nz⟩ := hex_pstar
  have hp_star_puis : p_star ∈ B_puis := hBpunc_sub hp_star_punc
  have hW_raw_2_pstar_nz : W_raw 2 p_star ≠ 0 := by
    rw [hW_raw_punc 2 p_star hp_star_punc]
    exact mul_ne_zero (pow_ne_zero G.K_p hp_star_punc.2.2) hW1_2_pstar_nz

  obtain ⟨m_star, W_tilde, hWt_holo, hWt_eq_raw, hWt_zero_nz⟩ :=
    h_tau_extract (Br.y₀ : ℂ) G.r_yp G.r_τ G.r_yp_pos G.r_τ_pos 3 W_raw hW_raw_holo
      ⟨2, p_star, hp_star_puis, hW_raw_2_pstar_nz⟩
  have hWt2_pstar_nz : W_tilde 2 p_star ≠ 0 := by
    intro h0
    have hraw := hWt_eq_raw 2 p_star hp_star_puis
    rw [h0, mul_zero] at hraw
    exact hW_raw_2_pstar_nz hraw
  have hWt_puis_eq : ∀ p ∈ B_puis, p.2 ≠ 0 → ∀ k : Fin 3,
      p.2 ^ m_star * W_tilde k p = p.2 ^ G.K_p * W₁_puis k p := by
    intro p hp hp2 k
    rw [← hWt_eq_raw k p hp]
    exact hW_raw_punc k p ⟨hp.1, hp.2, hp2⟩

  let Δ_inc : ℂ × ℂ → ℂ :=
    fun p => L_puis 0 p * W_tilde 0 p + L_puis 1 p * W_tilde 1 p - W_tilde 2 p
  have hΔ_inc_holo : DifferentiableOn ℂ Δ_inc B_puis :=
    (((hpuisDual0_holo 0).mul (hWt_holo 0)).add ((hpuisDual0_holo 1).mul (hWt_holo 1))).sub
      (hWt_holo 2)
  have hΔ_inc_punc : ∀ p ∈ B_punc, Δ_inc p = 0 := by
    intro p hp
    have hp_puis := hBpunc_sub hp
    have hmul : p.2 ^ m_star * Δ_inc p = 0 := by
      dsimp only [Δ_inc]
      calc p.2 ^ m_star * (L_puis 0 p * W_tilde 0 p + L_puis 1 p * W_tilde 1 p - W_tilde 2 p)
          = L_puis 0 p * (p.2 ^ m_star * W_tilde 0 p) +
              L_puis 1 p * (p.2 ^ m_star * W_tilde 1 p) -
              (p.2 ^ m_star * W_tilde 2 p) := by ring
        _ = L_puis 0 p * W_raw 0 p + L_puis 1 p * W_raw 1 p - W_raw 2 p := by
            rw [← hWt_eq_raw 0 p hp_puis, ← hWt_eq_raw 1 p hp_puis, ← hWt_eq_raw 2 p hp_puis]
        _ = 0 := by rw [hW_raw_inc p, sub_self]
    exact (mul_eq_zero.mp hmul).resolve_left (pow_ne_zero m_star hp.2.2)
  have hΔ_inc_zero : ∀ p ∈ B_puis, Δ_inc p = 0 :=
    hKit.eqOn_zero_of_preconnected_2D hBpuis_open hBpuis_preconn hBpunc_open hBpunc_ne
      hBpunc_sub hΔ_inc_holo hΔ_inc_punc

  have hW₁_punc_holo : ∀ k : Fin 3, DifferentiableOn ℂ (W₁_puis k) B_punc := by
    intro k; fin_cases k
    · exact (G.M_puis_holo 1).sub ((hpuisDual0_holo 1).mono hBpunc_sub)
    · exact ((hpuisDual0_holo 0).mono hBpunc_sub).sub (G.M_puis_holo 0)
    · exact (((hpuisDual0_holo 0).mono hBpunc_sub).mul (G.M_puis_holo 1)).sub
        (((hpuisDual0_holo 1).mono hBpunc_sub).mul (G.M_puis_holo 0))
  have hWt_det_punc : ∀ p ∈ B_punc, homRankOneDet W_tilde p = 0 := by
    intro p hp
    have hraw_det1 := h_wronsk_scale hBpunc_open (fun q : ℂ × ℂ => q.2 ^ G.K_p) W₁_puis W_raw
      (differentiable_snd.pow G.K_p).differentiableOn hW₁_punc_holo hW_raw_punc p hp
    rw [G.puis_rank_one p hp, mul_zero] at hraw_det1
    have hraw_det2 := h_wronsk_scale hBpunc_open (fun q : ℂ × ℂ => q.2 ^ m_star) W_tilde W_raw
      (differentiable_snd.pow m_star).differentiableOn
      (fun k => (hWt_holo k).mono hBpunc_sub)
      (fun k q hq => hWt_eq_raw k q (hBpunc_sub hq)) p hp
    rw [hraw_det1] at hraw_det2
    exact (mul_eq_zero.mp hraw_det2.symm).resolve_left (pow_ne_zero 3 (pow_ne_zero m_star hp.2.2))
  have hWt_det_holo : DifferentiableOn ℂ (homRankOneDet W_tilde) B_puis := by
    have hA : ∀ k : Fin 3, DifferentiableOn ℂ (iterDerivYT 1 0 (W_tilde k)) B_puis :=
      fun k => hKit.iterDerivYT_holo hBpuis_open (hWt_holo k) 1 0
    have hD : ∀ k : Fin 3, DifferentiableOn ℂ (iterDerivYT 0 1 (W_tilde k)) B_puis :=
      fun k => hKit.iterDerivYT_holo hBpuis_open (hWt_holo k) 0 1
    exact (((hWt_holo 0).mul (((hA 1).mul (hD 2)).sub ((hD 1).mul (hA 2)))).sub
      ((hWt_holo 1).mul (((hA 0).mul (hD 2)).sub ((hD 0).mul (hA 2))))).add
      ((hWt_holo 2).mul (((hA 0).mul (hD 1)).sub ((hD 0).mul (hA 1))))
  have hWt_det_zero : ∀ p ∈ B_puis, homRankOneDet W_tilde p = 0 :=
    hKit.eqOn_zero_of_preconnected_2D hBpuis_open hBpuis_preconn hBpunc_open hBpunc_ne
      hBpunc_sub hWt_det_holo hWt_det_punc

  have hex_zstar : ∃ z_star ∈ U_y, W_tilde 2 (z_star, 0) ≠ 0 := by
    by_contra hNoZ
    have hW2_slice0 : ∀ y ∈ U_y, W_tilde 2 (y, 0) = 0 :=
      fun y hy => by_contra fun hne => hNoZ ⟨y, hy, hne⟩
    obtain ⟨m', u_tup, hu_tup_holo, hu_tup_eq, ⟨k₁, y_u, hy_u, hu_yu_nz⟩⟩ :=
      h_tau_extract (Br.y₀ : ℂ) G.r_yp G.r_τ G.r_yp_pos G.r_τ_pos 1 (fun _ => W_tilde 2)
        (fun _ => hWt_holo 2) ⟨0, p_star, hp_star_puis, hWt2_pstar_nz⟩
    let u₂ : ℂ × ℂ → ℂ := u_tup 0
    have hu₂_holo : DifferentiableOn ℂ u₂ B_puis := hu_tup_holo 0
    have hu₂_eq : ∀ p ∈ B_puis, W_tilde 2 p = p.2 ^ m' * u₂ p := hu_tup_eq 0
    have hu₂_yu_nz : u₂ (y_u, 0) ≠ 0 := by
      have hk : k₁ = 0 := Subsingleton.elim k₁ 0
      simpa [u₂, hk] using hu_yu_nz
    have hm'_ne : m' ≠ 0 := by
      intro hm0
      have heq := hu₂_eq (y_u, 0) ⟨hy_u, Metric.mem_ball_self G.r_τ_pos⟩
      rw [hm0, pow_zero, one_mul, hW2_slice0 y_u hy_u] at heq
      exact hu₂_yu_nz heq.symm
    obtain ⟨m, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hm'_ne
    have hobs_m := h_wronsk_tau_obs (Br.y₀ : ℂ) G.r_yp G.r_τ G.r_yp_pos G.r_τ_pos
      m W_tilde u₂ hWt_holo hu₂_holo hu₂_eq hWt_det_zero
    have hm1_ne : ((m + 1 : ℕ) : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.succ_ne_zero m)
    have hwronsk_1d : ∀ y ∈ U_y,
        u₂ (y, 0) *
          (W_tilde 0 (y, 0) * deriv (fun z => W_tilde 1 (z, 0)) y -
            W_tilde 1 (y, 0) * deriv (fun z => W_tilde 0 (z, 0)) y) = 0 := by
      intro y hy
      have h0 := hobs_m y hy
      rw [mul_assoc] at h0
      exact (mul_eq_zero.mp h0).resolve_left hm1_ne
    have hUy_strip : U_y ⊆ horizStrip (2 * C.s₀) := by
      intro y hy
      change |y.im| < 2 * C.s₀
      linarith [hUy_im y hy, W.s_base_le_s₀, C.s₀_pos]
    have hϕ_holo_Uy : DifferentiableOn ℂ C.ϕ_ℂ U_y := C.ϕ_ℂ_holo.mono hUy_strip
    have hϕ_deriv_Uy : ∀ y ∈ U_y, deriv C.ϕ_ℂ y ≠ 0 :=
      fun y hy => C.ϕ_ℂ_deriv_ne_zero y (hUy_strip hy)
    have hslice0_maps : Set.MapsTo (fun y : ℂ => (y, (0 : ℂ))) U_y B_puis :=
      fun y hy => ⟨hy, Metric.mem_ball_self G.r_τ_pos⟩
    have hslice0_diff : Differentiable ℂ (fun y : ℂ => (y, (0 : ℂ))) :=
      differentiable_id.prodMk (differentiable_const 0)
    have hw₀_holo : DifferentiableOn ℂ (fun y => W_tilde 0 (y, 0)) U_y :=
      (hWt_holo 0).comp hslice0_diff.differentiableOn hslice0_maps
    have hw₁_holo : DifferentiableOn ℂ (fun y => W_tilde 1 (y, 0)) U_y :=
      (hWt_holo 1).comp hslice0_diff.differentiableOn hslice0_maps
    have hv₂_holo : DifferentiableOn ℂ (fun y => u₂ (y, 0)) U_y :=
      hu₂_holo.comp hslice0_diff.differentiableOn hslice0_maps
    have hinc_1d : ∀ y ∈ U_y,
        Complex.cos (C.ϕ_ℂ y) * W_tilde 0 (y, 0) +
          Complex.sin (C.ϕ_ℂ y) * W_tilde 1 (y, 0) = 0 := by
      intro y hy
      have hy_im : |y.im| < W.s_base / 2 := hUy_im y hy
      have hy_s1 : |y.im| < 2 * C.s₁ := by
        linarith [hy_im, W.s_base_le_s₁, C.r₁_pos, C.r₁_lt_s₁]
      have hθ_zero : glancingTheta C y 0 = C.ϕ_ℂ y := by
        dsimp [glancingTheta]
        rw [C.U_zero y hy_s1]
      have hoff : glancingOffset C y 0 ≠ 0 :=
        W.offset_ne_zero y 0 (by linarith [W.s_base_pos]) (by rw [norm_zero]; linarith [W.r_base_pos])
      have h0_pow : (0 : ℂ) ^ G.d = 0 := zero_pow hd_ne
      have hinc0 := hΔ_inc_zero (y, 0) ⟨hy, Metric.mem_ball_self G.r_τ_pos⟩
      dsimp only [Δ_inc] at hinc0
      rw [hW2_slice0 y hy, sub_zero, hLpuis_eq 0 (y, 0), hLpuis_eq 1 (y, 0)] at hinc0
      dsimp only at hinc0
      rw [h0_pow] at hinc0
      simp only [glancingDualLine, Matrix.cons_val_zero, Matrix.cons_val_one, hθ_zero] at hinc0
      have hmul := congr_arg (· * glancingOffset C y 0) hinc0
      rw [zero_mul, add_mul, div_mul_eq_mul_div, div_mul_cancel₀ _ hoff,
        div_mul_eq_mul_div, div_mul_cancel₀ _ hoff] at hmul
      exact hmul
    obtain ⟨k₀, y_star, hy_star, hk₀_nz⟩ := hWt_zero_nz
    have hw_nz_1d : ∃ y_s ∈ U_y, W_tilde 0 (y_s, 0) ≠ 0 ∨ W_tilde 1 (y_s, 0) ≠ 0 := by
      refine ⟨y_star, hy_star, ?_⟩
      fin_cases k₀
      · exact Or.inl hk₀_nz
      · exact Or.inr hk₀_nz
      · exact False.elim (hk₀_nz (hW2_slice0 y_star hy_star))
    exact h_glancing_inf_obs (Br.y₀ : ℂ) G.r_yp C.ϕ_ℂ
      (fun y => W_tilde 0 (y, 0)) (fun y => W_tilde 1 (y, 0)) (fun y => u₂ (y, 0))
      hϕ_holo_Uy hw₀_holo hw₁_holo hv₂_holo hϕ_deriv_Uy hinc_1d hw_nz_1d
      ⟨y_u, hy_u, hu₂_yu_nz⟩ hwronsk_1d

  have hw₂_slice_holo : DifferentiableOn ℂ (fun y => W_tilde 2 (y, 0)) U_y :=
    (hWt_holo 2).comp (differentiable_id.prodMk (differentiable_const 0)).differentiableOn
      (fun y hy => ⟨hy, Metric.mem_ball_self G.r_τ_pos⟩)
  obtain ⟨y₁, hy₁_Ioo, hy₁_nz⟩ :=
    h_real_slice_nz Br.y₀ G.r_yp (G.r_yp / 2) (half_pos G.r_yp_pos)
      (by linarith [G.r_yp_pos]) (fun y => W_tilde 2 (y, 0)) hw₂_slice_holo hex_zstar
  have hy₁_dist : dist (y₁ : ℂ) (Br.y₀ : ℂ) < G.r_yp / 2 := by
    rw [dist_eq_norm, ← Complex.ofReal_sub, Complex.norm_real, Real.norm_eq_abs, abs_lt]
    exact ⟨by linarith [hy₁_Ioo.1], by linarith [hy₁_Ioo.2]⟩
  let p₁ : ℂ × ℂ := ((y₁ : ℂ), (0 : ℂ))
  have hp₁_mem : p₁ ∈ B_puis :=
    ⟨Metric.mem_ball.mpr (by linarith [G.r_yp_pos]), Metric.mem_ball_self G.r_τ_pos⟩
  let O_w2 : Set (ℂ × ℂ) := B_puis ∩ (W_tilde 2) ⁻¹' {(0 : ℂ)}ᶜ
  have hO_w2_open : IsOpen O_w2 :=
    (hWt_holo 2).continuousOn.isOpen_inter_preimage hBpuis_open isOpen_compl_singleton
  obtain ⟨δ_nz, hδ_nz_pos, hδ_nz_sub⟩ :=
    Metric.isOpen_iff.mp hO_w2_open p₁ ⟨hp₁_mem, hy₁_nz⟩

  let ρ₁ : ℝ := min δ_nz (min (G.r_yp / 2) G.r_τ)
  have hρ₁_pos : 0 < ρ₁ := lt_min hδ_nz_pos (lt_min (half_pos G.r_yp_pos) G.r_τ_pos)
  have hρ₁_le_half : ρ₁ ≤ G.r_yp / 2 := le_trans (min_le_right _ _) (min_le_left _ _)
  have hρ₁_le_τ : ρ₁ ≤ G.r_τ := le_trans (min_le_right _ _) (min_le_right _ _)
  have hball_y₁_sub : Metric.ball (y₁ : ℂ) ρ₁ ⊆ U_y := by
    intro z hz
    rw [Metric.mem_ball] at hz ⊢
    linarith [dist_triangle z (y₁ : ℂ) (Br.y₀ : ℂ)]
  let B₁ : Set (ℂ × ℂ) := Metric.ball (y₁ : ℂ) ρ₁ ×ˢ Metric.ball (0 : ℂ) ρ₁
  have hB₁_open : IsOpen B₁ := Metric.isOpen_ball.prod Metric.isOpen_ball
  have hB₁_sub_O : B₁ ⊆ O_w2 := by
    intro p hp
    apply hδ_nz_sub
    have hp_ball : p ∈ Metric.ball p₁ ρ₁ := by
      dsimp only [B₁, p₁] at hp ⊢
      rwa [← ball_prod_same]
    exact Metric.ball_subset_ball (min_le_left _ _) hp_ball
  have hB₁_sub_Bpuis : B₁ ⊆ B_puis := fun p hp => (hB₁_sub_O hp).1
  have hWt2_B₁_nz : ∀ p ∈ B₁, W_tilde 2 p ≠ 0 := fun p hp => (hB₁_sub_O hp).2
  have hWt_B₁ : ∀ k : Fin 3, DifferentiableOn ℂ (W_tilde k) B₁ :=
    fun k => (hWt_holo k).mono hB₁_sub_Bpuis
  let Z : Fin 2 → ℂ × ℂ → ℂ := fun ι p => W_tilde ι.castSucc p / W_tilde 2 p
  have hZ_B₁_holo : ∀ ι : Fin 2, DifferentiableOn ℂ (Z ι) B₁ := fun ι =>
    (((hWt_B₁ ι.castSucc).mul ((hWt_B₁ 2).fun_inv hWt2_B₁_nz)).congr
      (fun p _ => by dsimp [Z]; rw [div_eq_mul_inv]))
  have hZ_inc : ∀ p ∈ B₁, L_puis 0 p * Z 0 p + L_puis 1 p * Z 1 p = 1 := by
    intro p hp
    have h0 := hΔ_inc_zero p (hB₁_sub_Bpuis hp)
    have hne : W_tilde 2 p ≠ 0 := hWt2_B₁_nz p hp
    have hsum : L_puis 0 p * W_tilde 0 p + L_puis 1 p * W_tilde 1 p = W_tilde 2 p :=
      sub_eq_zero.mp h0
    change L_puis 0 p * (W_tilde 0 p / W_tilde 2 p) +
      L_puis 1 p * (W_tilde 1 p / W_tilde 2 p) = 1
    calc L_puis 0 p * (W_tilde 0 p / W_tilde 2 p) + L_puis 1 p * (W_tilde 1 p / W_tilde 2 p)
        = (L_puis 0 p * W_tilde 0 p + L_puis 1 p * W_tilde 1 p) / W_tilde 2 p := by ring
      _ = W_tilde 2 p / W_tilde 2 p := by rw [hsum]
      _ = 1 := div_self hne
  have hZ_rank_one : ∀ p ∈ B₁,
      pderivA (Z 0) p * pderivD (Z 1) p = pderivD (Z 0) p * pderivA (Z 1) p :=
    h_wronsk_quotient hB₁_open W_tilde Z hWt_B₁ hWt2_B₁_nz
      (fun p hp => hWt_det_zero p (hB₁_sub_Bpuis hp)) (fun _ _ _ => rfl)

  exact ⟨{
    y₁ := y₁
    ρ₁ := ρ₁
    m_star := m_star
    ρ₁_pos := hρ₁_pos
    ball_y₁_sub := hball_y₁_sub
    ρ₁_le_τ := hρ₁_le_τ
    W_tilde := W_tilde
    Z := Z
    W_tilde_holo := hWt_B₁
    W_tilde_puis_eq := fun p hp hp2 k => hWt_puis_eq p (hB₁_sub_Bpuis hp) hp2 k
    W_tilde_two_ne_zero := hWt2_B₁_nz
    Z_eq := fun _ _ _ => rfl
    Z_holo := hZ_B₁_holo
    Z_incidence := hZ_inc
    Z_rank_one := hZ_rank_one
  }⟩

theorem rank_one_arc_factorization_and_transversality (Ω : Set Plane)
    (C : AnalyticGlancingCollar Ω)
    (hDet : EndpointDeterminationData C)
    (W : CollarWidthTubeData C hDet)
    (hKit : Holo2DAndTaylorToolkit)
    (B_cr : BaseCollarAndCramerData C)
    (t₂ : ℝ)
    (D_wall : AlignedWallDefectData W t₂)
    (N_idx : ℕ)
    (q_idx : Fin N_idx → ℤ)
    (B_col : BaseCollarBilliardData C hDet)
    (Br : PuncturedGlancingBridgeData W t₂ D_wall q_idx)
    (G : PuiseuxCoverGermData W t₂ D_wall q_idx Br)
    (R : RegularAffineIntersectionData W t₂ D_wall q_idx Br G) :
    Nonempty (TransverseNonisotropicArcData W t₂ D_wall q_idx Br G R) :=
by
  have isOpen_horizStrip : ∀ H : ℝ, IsOpen (horizStrip H) :=
    fun _ => isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const

  
  
  have h_real_witness :
      ∀ (y_c R_b r_in : ℝ) (f : ℂ → ℂ),
        0 < R_b → 0 < r_in → r_in ≤ R_b →
        DifferentiableOn ℂ f (Metric.ball (y_c : ℂ) R_b) →
        (∃ z_star ∈ Metric.ball (y_c : ℂ) R_b, f z_star ≠ 0) →
        ∃ x ∈ Set.Ioo (y_c - r_in) (y_c + r_in), f (x : ℂ) ≠ 0 := by
    intro y_c R_b r_in f hR_b hr_in _hr_le hf_holo ⟨z_star, hz_star_mem, hz_star_nz⟩
    by_contra hAllRealZero
    have hAllRealZero' : ∀ x ∈ Set.Ioo (y_c - r_in) (y_c + r_in), f (x : ℂ) = 0 :=
      fun x hx => by_contra fun hne => hAllRealZero ⟨x, hx, hne⟩
    have hf_ana : AnalyticOnNhd ℂ f (Metric.ball (y_c : ℂ) R_b) :=
      (Complex.analyticOnNhd_iff_differentiableOn Metric.isOpen_ball).mpr hf_holo
    let x_seq : ℕ → ℝ := fun n => y_c + r_in / (2 * ((n : ℝ) + 1))
    have hx_seq_mem : ∀ n : ℕ,
        x_seq n ∈ Set.Ioo (y_c - r_in) (y_c + r_in) ∧ (x_seq n : ℂ) ≠ (y_c : ℂ) := by
      intro n
      have hn_pos : (0 : ℝ) < 2 * ((n : ℝ) + 1) := by positivity
      have hd_pos : 0 < r_in / (2 * ((n : ℝ) + 1)) := div_pos hr_in hn_pos
      have hd_le : r_in / (2 * ((n : ℝ) + 1)) ≤ r_in / 2 :=
        div_le_div_of_nonneg_left hr_in.le (by positivity)
          (by linarith [Nat.cast_nonneg (α := ℝ) n])
      refine ⟨⟨by dsimp [x_seq]; linarith, by dsimp [x_seq]; linarith⟩, ?_⟩
      intro heq
      have hre := congr_arg Complex.re heq
      simp only [Complex.ofReal_re] at hre
      dsimp [x_seq] at hre
      linarith
    have hx_tendsto : Filter.Tendsto (fun n : ℕ => (x_seq n : ℂ))
        Filter.atTop (nhdsWithin (y_c : ℂ) {(y_c : ℂ)}ᶜ) := by
      rw [tendsto_nhdsWithin_iff]
      refine ⟨?_, Filter.Eventually.of_forall (fun n => (hx_seq_mem n).2)⟩
      have hreal : Filter.Tendsto x_seq Filter.atTop (nhds y_c) := by
        have hden : Filter.Tendsto (fun n : ℕ => 2 * ((n : ℝ) + 1)) Filter.atTop Filter.atTop :=
          Filter.Tendsto.const_mul_atTop (by norm_num)
            (Filter.tendsto_atTop_add_const_right _ 1 tendsto_natCast_atTop_atTop)
        simpa [x_seq] using Filter.Tendsto.const_add y_c (tendsto_const_nhds.div_atTop hden)
      exact (Complex.continuous_ofReal.tendsto y_c).comp hreal
    have h_freq : ∃ᶠ z in nhdsWithin (y_c : ℂ) {(y_c : ℂ)}ᶜ, f z = 0 :=
      hx_tendsto.frequently ((Filter.Eventually.of_forall
        (fun n => hAllRealZero' (x_seq n) (hx_seq_mem n).1)).frequently)
    have hzero_all := hf_ana.eqOn_zero_of_preconnected_of_frequently_eq_zero
      (convex_ball (y_c : ℂ) R_b).isPreconnected (Metric.mem_ball_self hR_b) h_freq hz_star_mem
    exact hz_star_nz hzero_all

  
  
  
  have hd_ne_zero : G.d ≠ 0 := Nat.ne_of_gt G.d_pos
  have h0_pow_d : (0 : ℂ) ^ G.d = 0 := zero_pow hd_ne_zero
  let U₁ : Set ℂ := Metric.ball (R.y₁ : ℂ) R.ρ₁
  let B₁ : Set (ℂ × ℂ) := U₁ ×ˢ Metric.ball (0 : ℂ) R.ρ₁
  let Z_zero : Fin 2 → ℂ → ℂ := fun ι s => R.Z ι (s, 0)

  have hZ0_holo : ∀ ι : Fin 2, DifferentiableOn ℂ (Z_zero ι) U₁ := by
    intro ι
    have hemb : Differentiable ℂ (fun s : ℂ => (s, (0 : ℂ))) :=
      differentiable_id.prodMk (differentiable_const 0)
    exact (R.Z_holo ι).comp hemb.differentiableOn
      (fun s hs => ⟨hs, Metric.mem_ball_self R.ρ₁_pos⟩)

  have hZ0_inc : ∀ s ∈ U₁,
      dualLineShift C 0 0 (s, 0) * Z_zero 0 s + dualLineShift C 0 1 (s, 0) * Z_zero 1 s = 1 := by
    intro s hs
    have hinc := R.Z_incidence (s, 0) ⟨hs, Metric.mem_ball_self R.ρ₁_pos⟩
    simpa only [puisDualLine0, h0_pow_d, Z_zero] using hinc

  have hU₁_bounds : ∀ s ∈ U₁, |s.im| < W.s_base / 2 := by
    intro s hs
    have hs_yp : s ∈ Metric.ball (Br.y₀ : ℂ) G.r_yp := R.ball_y₁_sub hs
    have hs_ry : s ∈ Metric.ball (Br.y₀ : ℂ) Br.r_y :=
      Metric.ball_subset_ball (by linarith [G.r_yp_le, Br.r_y_pos]) hs_yp
    have hp_bidisk : (s, (0 : ℂ)) ∈ Metric.ball (Br.y₀ : ℂ) Br.r_y ×ˢ Metric.ball (0 : ℂ) Br.r_t :=
      ⟨hs_ry, Metric.mem_ball_self Br.r_t_pos⟩
    exact (Br.bidisk_sub_dom hp_bidisk).1

  have hU₁_s₁ : ∀ s ∈ U₁, |s.im| < 2 * C.s₁ :=
    fun s hs => by linarith [hU₁_bounds s hs, W.s_base_pos, W.s_base_le_s₁]
  have hU₁_s₀ : ∀ s ∈ U₁, s ∈ horizStrip (2 * C.s₀) :=
    fun s hs => by
      change |s.im| < 2 * C.s₀
      linarith [hU₁_bounds s hs, W.s_base_pos, W.s_base_le_s₀]
  have hU₁_sh : ∀ s ∈ U₁, C.ϕ_ℂ s ∈ horizStrip (2 * C.s_h) :=
    fun s hs => C.ϕ_ℂ_maps_to s (hU₁_s₀ s hs)
  have hU₁_det : ∀ s ∈ U₁, |s.im| < 2 * hDet.s_det :=
    fun s hs => by linarith [hU₁_bounds s hs, W.s_base_pos, W.s_base_le_det]

  have hoff_eq : ∀ s ∈ U₁, glancingOffset C s 0 = C.h_ℂ (C.ϕ_ℂ s) := by
    intro s hs
    dsimp [glancingOffset, supportAction1_ℂ, glancingTheta]
    rw [add_zero, C.U_zero s (hU₁_s₁ s hs)]
    have hsub : (C.ϕ_ℂ s - C.ϕ_ℂ s) / 2 = 0 := by ring
    have hadd : (C.ϕ_ℂ s + C.ϕ_ℂ s) / 2 = C.ϕ_ℂ s := by ring
    rw [hsub, hadd, Complex.sin_zero, Complex.cos_zero]
    ring

  have hh_ne_zero : ∀ s ∈ U₁, C.h_ℂ (C.ϕ_ℂ s) ≠ 0 := by
    intro s hs
    rw [← hoff_eq s hs]
    refine W.offset_ne_zero s 0 ?_ ?_
    · linarith [hU₁_bounds s hs, W.s_base_pos]
    · rw [norm_zero]; linarith [W.r_base_pos]

  have hL₀_zero : ∀ s ∈ U₁,
      dualLineShift C 0 0 (s, 0) = Complex.cos (C.ϕ_ℂ s) / C.h_ℂ (C.ϕ_ℂ s) ∧
      dualLineShift C 0 1 (s, 0) = Complex.sin (C.ϕ_ℂ s) / C.h_ℂ (C.ϕ_ℂ s) := by
    intro s hs
    have h0 : s + ((0 : ℤ) : ℂ) * (0 : ℂ) = s := by simp
    refine ⟨?_, ?_⟩
    · change glancingDualLine C (s + ((0 : ℤ) : ℂ) * 0) 0 0 = _
      rw [h0]
      simp only [glancingDualLine, Matrix.cons_val_zero, hoff_eq s hs, glancingTheta,
        C.U_zero s (hU₁_s₁ s hs)]
    · change glancingDualLine C (s + ((0 : ℤ) : ℂ) * 0) 0 1 = _
      rw [h0]
      simp only [glancingDualLine, Matrix.cons_val_one, Matrix.cons_val_zero, hoff_eq s hs,
        glancingTheta, C.U_zero s (hU₁_s₁ s hs)]

  have hSupport_eq : ∀ s ∈ U₁,
      Complex.cos (C.ϕ_ℂ s) * Z_zero 0 s + Complex.sin (C.ϕ_ℂ s) * Z_zero 1 s =
        C.h_ℂ (C.ϕ_ℂ s) := by
    intro s hs
    have hinc := hZ0_inc s hs
    rw [(hL₀_zero s hs).1, (hL₀_zero s hs).2] at hinc
    have h1 : (Complex.cos (C.ϕ_ℂ s) * Z_zero 0 s +
        Complex.sin (C.ϕ_ℂ s) * Z_zero 1 s) / C.h_ℂ (C.ϕ_ℂ s) = 1 := by
      rw [← hinc]; ring
    simpa only [one_mul] using (div_eq_iff (hh_ne_zero s hs)).mp h1

  have hEnv_id : ∀ (y_c : ℂ) (δ : ℝ), 0 < δ → Metric.ball y_c δ ⊆ U₁ →
      (∀ s ∈ Metric.ball y_c δ,
        dualLineShift C 0 0 (s, 0) * deriv (Z_zero 0) s +
          dualLineShift C 0 1 (s, 0) * deriv (Z_zero 1) s = 0) →
      ∀ s ∈ Metric.ball y_c δ, ∀ ι : Fin 2, Z_zero ι s = glancingBoundaryCurve C s ι := by
    intro y_c δ _hδ hsub htan s hs ι
    have hs_U₁ : s ∈ U₁ := hsub hs
    have htan_s := htan s hs
    rw [(hL₀_zero s hs_U₁).1, (hL₀_zero s hs_U₁).2] at htan_s
    have htan_clear :
        Complex.cos (C.ϕ_ℂ s) * deriv (Z_zero 0) s +
          Complex.sin (C.ϕ_ℂ s) * deriv (Z_zero 1) s = 0 := by
      have h1 : (Complex.cos (C.ϕ_ℂ s) * deriv (Z_zero 0) s +
          Complex.sin (C.ϕ_ℂ s) * deriv (Z_zero 1) s) / C.h_ℂ (C.ϕ_ℂ s) = 0 := by
        rw [← htan_s]; ring
      exact (div_eq_zero_iff.mp h1).resolve_right (hh_ne_zero s hs_U₁)
    have hϕ_d : HasDerivAt C.ϕ_ℂ (deriv C.ϕ_ℂ s) s :=
      (C.ϕ_ℂ_holo.differentiableAt ((isOpen_horizStrip _).mem_nhds (hU₁_s₀ s hs_U₁))).hasDerivAt
    have hh_d : HasDerivAt C.h_ℂ (deriv C.h_ℂ (C.ϕ_ℂ s)) (C.ϕ_ℂ s) :=
      (C.h_ℂ_holo.differentiableAt ((isOpen_horizStrip _).mem_nhds (hU₁_sh s hs_U₁))).hasDerivAt
    have hZ0_d0 : HasDerivAt (Z_zero 0) (deriv (Z_zero 0) s) s :=
      ((hZ0_holo 0).differentiableAt (Metric.isOpen_ball.mem_nhds hs_U₁)).hasDerivAt
    have hZ0_d1 : HasDerivAt (Z_zero 1) (deriv (Z_zero 1) s) s :=
      ((hZ0_holo 1).differentiableAt (Metric.isOpen_ball.mem_nhds hs_U₁)).hasDerivAt
    have hcos_d : HasDerivAt (fun z => Complex.cos (C.ϕ_ℂ z))
        (-Complex.sin (C.ϕ_ℂ s) * deriv C.ϕ_ℂ s) s :=
      (Complex.hasDerivAt_cos (C.ϕ_ℂ s)).comp s hϕ_d
    have hsin_d : HasDerivAt (fun z => Complex.sin (C.ϕ_ℂ z))
        (Complex.cos (C.ϕ_ℂ s) * deriv C.ϕ_ℂ s) s :=
      (Complex.hasDerivAt_sin (C.ϕ_ℂ s)).comp s hϕ_d
    have hLHS_d := (hcos_d.mul hZ0_d0).add (hsin_d.mul hZ0_d1)
    change HasDerivAt
      (fun z => Complex.cos (C.ϕ_ℂ z) * Z_zero 0 z + Complex.sin (C.ϕ_ℂ z) * Z_zero 1 z) _ s
      at hLHS_d
    have hRHS_d : HasDerivAt (fun z => C.h_ℂ (C.ϕ_ℂ z))
        (deriv C.h_ℂ (C.ϕ_ℂ s) * deriv C.ϕ_ℂ s) s :=
      hh_d.comp s hϕ_d
    have hev_supp : (fun z => Complex.cos (C.ϕ_ℂ z) * Z_zero 0 z +
        Complex.sin (C.ϕ_ℂ z) * Z_zero 1 z) =ᶠ[nhds s] (fun z => C.h_ℂ (C.ϕ_ℂ z)) := by
      filter_upwards [Metric.isOpen_ball.mem_nhds hs_U₁] with z hz
      exact hSupport_eq z hz
    have hderiv_eq :
        ((-Complex.sin (C.ϕ_ℂ s) * deriv C.ϕ_ℂ s) * Z_zero 0 s +
          Complex.cos (C.ϕ_ℂ s) * deriv (Z_zero 0) s) +
        ((Complex.cos (C.ϕ_ℂ s) * deriv C.ϕ_ℂ s) * Z_zero 1 s +
          Complex.sin (C.ϕ_ℂ s) * deriv (Z_zero 1) s) =
        deriv C.h_ℂ (C.ϕ_ℂ s) * deriv C.ϕ_ℂ s := by
      rw [← hLHS_d.deriv, hev_supp.deriv_eq, hRHS_d.deriv]
    have hmul_orth :
        deriv C.ϕ_ℂ s *
          (-Complex.sin (C.ϕ_ℂ s) * Z_zero 0 s +
            Complex.cos (C.ϕ_ℂ s) * Z_zero 1 s - deriv C.h_ℂ (C.ϕ_ℂ s)) = 0 := by
      linear_combination hderiv_eq - htan_clear
    have hϕ_nz : deriv C.ϕ_ℂ s ≠ 0 := C.ϕ_ℂ_deriv_ne_zero s (hU₁_s₀ s hs_U₁)
    have hOrth_eq :
        -Complex.sin (C.ϕ_ℂ s) * Z_zero 0 s + Complex.cos (C.ϕ_ℂ s) * Z_zero 1 s =
          deriv C.h_ℂ (C.ϕ_ℂ s) :=
      sub_eq_zero.mp ((mul_eq_zero.mp hmul_orth).resolve_left hϕ_nz)
    have hsupp_s := hSupport_eq s hs_U₁
    have hcs := Complex.cos_sq_add_sin_sq (C.ϕ_ℂ s)
    fin_cases ι
    · simp only [Fin.zero_eta, glancingBoundaryCurve, Matrix.cons_val_zero]
      linear_combination
        Complex.cos (C.ϕ_ℂ s) * hsupp_s - Complex.sin (C.ϕ_ℂ s) * hOrth_eq - Z_zero 0 s * hcs
    · simp only [Fin.mk_one, glancingBoundaryCurve, Matrix.cons_val_one, Matrix.cons_val_zero]
      linear_combination
        Complex.sin (C.ϕ_ℂ s) * hsupp_s + Complex.cos (C.ϕ_ℂ s) * hOrth_eq - Z_zero 1 s * hcs

  have hex_c_z : ∃ (c : Fin 2) (z_star : ℂ), z_star ∈ U₁ ∧ deriv (Z_zero c) z_star ≠ 0 := by
    by_contra hNone
    have hAll0 : ∀ (ι : Fin 2), ∀ s ∈ U₁, deriv (Z_zero ι) s = 0 :=
      fun ι s hs => by_contra fun hne => hNone ⟨ι, s, hs, hne⟩
    have hZ_eq_Γ : ∀ s ∈ U₁, ∀ ι : Fin 2, Z_zero ι s = glancingBoundaryCurve C s ι :=
      hEnv_id (R.y₁ : ℂ) R.ρ₁ R.ρ₁_pos Set.Subset.rfl
        (fun s hs => by simp [hAll0 0 s hs, hAll0 1 s hs])
    let s₁ : ℂ := (R.y₁ : ℂ)
    have hs₁_U₁ : s₁ ∈ U₁ := Metric.mem_ball_self R.ρ₁_pos
    let θ₁ : ℂ := C.ϕ_ℂ s₁
    have hϕ_d1 : HasDerivAt C.ϕ_ℂ (deriv C.ϕ_ℂ s₁) s₁ :=
      (C.ϕ_ℂ_holo.differentiableAt ((isOpen_horizStrip _).mem_nhds (hU₁_s₀ s₁ hs₁_U₁))).hasDerivAt
    have hh_d1 : HasDerivAt C.h_ℂ (deriv C.h_ℂ θ₁) θ₁ :=
      (C.h_ℂ_holo.differentiableAt ((isOpen_horizStrip _).mem_nhds (hU₁_sh s₁ hs₁_U₁))).hasDerivAt
    have hh'_holo : DifferentiableOn ℂ (deriv C.h_ℂ) (horizStrip (2 * C.s_h)) :=
      C.h_ℂ_holo.deriv (isOpen_horizStrip _)
    have hh'_d1 : HasDerivAt (deriv C.h_ℂ) (deriv (deriv C.h_ℂ) θ₁) θ₁ :=
      (hh'_holo.differentiableAt ((isOpen_horizStrip _).mem_nhds (hU₁_sh s₁ hs₁_U₁))).hasDerivAt
    have hcos_d1 : HasDerivAt (fun z => Complex.cos (C.ϕ_ℂ z))
        (-Complex.sin θ₁ * deriv C.ϕ_ℂ s₁) s₁ :=
      (Complex.hasDerivAt_cos θ₁).comp s₁ hϕ_d1
    have hsin_d1 : HasDerivAt (fun z => Complex.sin (C.ϕ_ℂ z))
        (Complex.cos θ₁ * deriv C.ϕ_ℂ s₁) s₁ :=
      (Complex.hasDerivAt_sin θ₁).comp s₁ hϕ_d1
    have hh_comp : HasDerivAt (fun z => C.h_ℂ (C.ϕ_ℂ z))
        (deriv C.h_ℂ θ₁ * deriv C.ϕ_ℂ s₁) s₁ :=
      hh_d1.comp s₁ hϕ_d1
    have hh'_comp : HasDerivAt (fun z => deriv C.h_ℂ (C.ϕ_ℂ z))
        (deriv (deriv C.h_ℂ) θ₁ * deriv C.ϕ_ℂ s₁) s₁ :=
      hh'_d1.comp s₁ hϕ_d1
    have hΓ0_d := (hh_comp.mul hcos_d1).sub (hh'_comp.mul hsin_d1)
    change HasDerivAt
      (fun z => C.h_ℂ (C.ϕ_ℂ z) * Complex.cos (C.ϕ_ℂ z) -
        deriv C.h_ℂ (C.ϕ_ℂ z) * Complex.sin (C.ϕ_ℂ z)) _ s₁ at hΓ0_d
    have hΓ1_d := (hh_comp.mul hsin_d1).add (hh'_comp.mul hcos_d1)
    change HasDerivAt
      (fun z => C.h_ℂ (C.ϕ_ℂ z) * Complex.sin (C.ϕ_ℂ z) +
        deriv C.h_ℂ (C.ϕ_ℂ z) * Complex.cos (C.ϕ_ℂ z)) _ s₁ at hΓ1_d
    have hev0 : Z_zero 0 =ᶠ[nhds s₁]
        (fun z => C.h_ℂ (C.ϕ_ℂ z) * Complex.cos (C.ϕ_ℂ z) -
          deriv C.h_ℂ (C.ϕ_ℂ z) * Complex.sin (C.ϕ_ℂ z)) := by
      filter_upwards [Metric.isOpen_ball.mem_nhds hs₁_U₁] with z hz
      simpa only [glancingBoundaryCurve, Matrix.cons_val_zero] using hZ_eq_Γ z hz 0
    have hev1 : Z_zero 1 =ᶠ[nhds s₁]
        (fun z => C.h_ℂ (C.ϕ_ℂ z) * Complex.sin (C.ϕ_ℂ z) +
          deriv C.h_ℂ (C.ϕ_ℂ z) * Complex.cos (C.ϕ_ℂ z)) := by
      filter_upwards [Metric.isOpen_ball.mem_nhds hs₁_U₁] with z hz
      simpa only [glancingBoundaryCurve, Matrix.cons_val_one, Matrix.cons_val_zero] using
        hZ_eq_Γ z hz 1
    have hd0_raw :
        ((deriv C.h_ℂ θ₁ * deriv C.ϕ_ℂ s₁) * Complex.cos θ₁ +
          C.h_ℂ θ₁ * (-Complex.sin θ₁ * deriv C.ϕ_ℂ s₁)) -
        ((deriv (deriv C.h_ℂ) θ₁ * deriv C.ϕ_ℂ s₁) * Complex.sin θ₁ +
          deriv C.h_ℂ θ₁ * (Complex.cos θ₁ * deriv C.ϕ_ℂ s₁)) = 0 := by
      rw [← hΓ0_d.deriv, ← hev0.deriv_eq, hAll0 0 s₁ hs₁_U₁]
    have hd1_raw :
        ((deriv C.h_ℂ θ₁ * deriv C.ϕ_ℂ s₁) * Complex.sin θ₁ +
          C.h_ℂ θ₁ * (Complex.cos θ₁ * deriv C.ϕ_ℂ s₁)) +
        ((deriv (deriv C.h_ℂ) θ₁ * deriv C.ϕ_ℂ s₁) * Complex.cos θ₁ +
          deriv C.h_ℂ θ₁ * (-Complex.sin θ₁ * deriv C.ϕ_ℂ s₁)) = 0 := by
      rw [← hΓ1_d.deriv, ← hev1.deriv_eq, hAll0 1 s₁ hs₁_U₁]
    have hd0 : -(C.h_ℂ θ₁ + deriv (deriv C.h_ℂ) θ₁) * deriv C.ϕ_ℂ s₁ * Complex.sin θ₁ = 0 := by
      linear_combination hd0_raw
    have hd1 : (C.h_ℂ θ₁ + deriv (deriv C.h_ℂ) θ₁) * deriv C.ϕ_ℂ s₁ * Complex.cos θ₁ = 0 := by
      linear_combination hd1_raw
    have hcs1 := Complex.cos_sq_add_sin_sq θ₁
    have hlaz := C.lazutkin_norm_ℂ s₁ (hU₁_s₀ s₁ hs₁_U₁)
    have hc_sq_zero : (C.c : ℂ) ^ 2 = 0 := by
      calc (C.c : ℂ) ^ 2
          = ((C.h_ℂ θ₁ + deriv (deriv C.h_ℂ) θ₁) * (deriv C.ϕ_ℂ s₁) ^ 3) ^ 2 := by rw [← hlaz]
        _ = (deriv C.ϕ_ℂ s₁) ^ 4 *
              (((C.h_ℂ θ₁ + deriv (deriv C.h_ℂ) θ₁) * deriv C.ϕ_ℂ s₁) ^ 2 * 1) := by ring
        _ = (deriv C.ϕ_ℂ s₁) ^ 4 *
              (((C.h_ℂ θ₁ + deriv (deriv C.h_ℂ) θ₁) * deriv C.ϕ_ℂ s₁) ^ 2 *
                (Complex.cos θ₁ ^ 2 + Complex.sin θ₁ ^ 2)) := by rw [hcs1]
        _ = (deriv C.ϕ_ℂ s₁) ^ 4 *
              ((-(C.h_ℂ θ₁ + deriv (deriv C.h_ℂ) θ₁) * deriv C.ϕ_ℂ s₁ * Complex.sin θ₁) ^ 2 +
               ((C.h_ℂ θ₁ + deriv (deriv C.h_ℂ) θ₁) * deriv C.ϕ_ℂ s₁ * Complex.cos θ₁) ^ 2) := by
              ring
        _ = 0 := by rw [hd0, hd1]; ring
    have hc_zero : (C.c : ℂ) = 0 := by
      rcases mul_eq_zero.mp (by rwa [sq] at hc_sq_zero) with h | h <;> exact h
    exact Complex.ofReal_ne_zero.mpr C.c_pos.ne' hc_zero

  obtain ⟨c, z_reg_star, hz_reg_mem, hz_reg_nz⟩ := hex_c_z
  obtain ⟨y₁', hy₁'_Ioo, hc_reg⟩ :=
    h_real_witness R.y₁ R.ρ₁ (R.ρ₁ / 2) (deriv (Z_zero c))
      R.ρ₁_pos (by linarith [R.ρ₁_pos]) (by linarith [R.ρ₁_pos])
      ((hZ0_holo c).deriv Metric.isOpen_ball) ⟨z_reg_star, hz_reg_mem, hz_reg_nz⟩

  
  
  
  let s₁' : ℂ := (y₁' : ℂ)
  let ρ' : ℝ := R.ρ₁ / 2
  have hρ'_pos : 0 < ρ' := by dsimp [ρ']; linarith [R.ρ₁_pos]
  have hy₁'_abs : |y₁' - R.y₁| < R.ρ₁ / 2 :=
    abs_lt.mpr ⟨by linarith [hy₁'_Ioo.1], by linarith [hy₁'_Ioo.2]⟩
  let U₀ : Set ℂ := Metric.ball s₁' ρ'
  let B₀ : Set (ℂ × ℂ) := U₀ ×ˢ Metric.ball (0 : ℂ) ρ'
  have hU₀_sub_U₁ : U₀ ⊆ U₁ := by
    intro z hz
    rw [Metric.mem_ball, dist_eq_norm] at hz ⊢
    have hdiff : ‖s₁' - (R.y₁ : ℂ)‖ = |y₁' - R.y₁| := by
      dsimp [s₁']
      rw [← Complex.ofReal_sub, Complex.norm_real, Real.norm_eq_abs]
    have htri : ‖z - (R.y₁ : ℂ)‖ ≤ ‖z - s₁'‖ + ‖s₁' - (R.y₁ : ℂ)‖ := by
      simpa using norm_add_le (z - s₁') (s₁' - (R.y₁ : ℂ))
    dsimp [ρ'] at hz
    linarith
  have hB₀_sub_B₁ : B₀ ⊆ B₁ :=
    Set.prod_mono hU₀_sub_U₁ (Metric.ball_subset_ball (by dsimp [ρ']; linarith [R.ρ₁_pos]))
  have hs₁'_U₀ : s₁' ∈ U₀ := Metric.mem_ball_self hρ'_pos

  have hf_ana : AnalyticAt ℂ (Z_zero c) s₁' :=
    (hZ0_holo c).analyticAt (Metric.isOpen_ball.mem_nhds (hU₀_sub_U₁ hs₁'_U₀))
  let hf_strict : HasStrictDerivAt (Z_zero c) (deriv (Z_zero c) s₁') s₁' :=
    hf_ana.hasStrictDerivAt
  let w₀ : ℂ := Z_zero c s₁'
  let ψ_inv : ℂ → ℂ :=
    HasStrictDerivAt.localInverse (Z_zero c) (deriv (Z_zero c) s₁') s₁' hf_strict hc_reg
  have hψ_ana : AnalyticAt ℂ ψ_inv w₀ := hf_ana.analyticAt_localInverse hc_reg
  obtain ⟨r_w0, hr_w0_pos, hψ_ana_ball⟩ := hψ_ana.exists_ball_analyticOnNhd
  have hψ_holo0 : DifferentiableOn ℂ ψ_inv (Metric.ball w₀ r_w0) := hψ_ana_ball.differentiableOn
  have h_linv_ev : ∀ᶠ y in nhds s₁', ψ_inv (Z_zero c y) = y :=
    hf_strict.eventually_left_inverse hc_reg
  have h_rinv_ev : ∀ᶠ w in nhds w₀, Z_zero c (ψ_inv w) = w :=
    hf_strict.eventually_right_inverse hc_reg
  have hψ_w₀ : ψ_inv w₀ = s₁' := h_linv_ev.self_of_nhds
  have hψ_cont_w₀ : ContinuousAt ψ_inv w₀ :=
    hψ_holo0.continuousOn.continuousAt (Metric.isOpen_ball.mem_nhds (Metric.mem_ball_self hr_w0_pos))
  have hw_nhds :
      Metric.ball w₀ r_w0 ∩ ψ_inv ⁻¹' U₀ ∩ {w : ℂ | Z_zero c (ψ_inv w) = w} ∈ nhds w₀ :=
    Filter.inter_mem
      (Filter.inter_mem (Metric.ball_mem_nhds w₀ hr_w0_pos)
        (hψ_cont_w₀.preimage_mem_nhds (hψ_w₀.symm ▸ Metric.ball_mem_nhds s₁' hρ'_pos)))
      h_rinv_ev
  obtain ⟨r_w, hr_w_pos, hr_w_sub⟩ := Metric.mem_nhds_iff.mp hw_nhds
  let W_w : Set ℂ := Metric.ball w₀ r_w
  have hψ_holo : DifferentiableOn ℂ ψ_inv W_w :=
    hψ_holo0.mono (fun w hw => ((hr_w_sub hw).1).1)
  have hψ_props : ∀ w ∈ W_w, ψ_inv w ∈ U₀ ∧ Z_zero c (ψ_inv w) = w :=
    fun w hw => ⟨((hr_w_sub hw).1).2, (hr_w_sub hw).2⟩

  have hderiv_c_cont : ContinuousAt (deriv (Z_zero c)) s₁' :=
    ((hZ0_holo c).deriv Metric.isOpen_ball).continuousOn.continuousAt
      (Metric.isOpen_ball.mem_nhds (hU₀_sub_U₁ hs₁'_U₀))
  have hy_nhds :
      {y : ℂ | ψ_inv (Z_zero c y) = y} ∩ {y : ℂ | deriv (Z_zero c) y ≠ 0} ∈ nhds s₁' :=
    Filter.inter_mem h_linv_ev (hderiv_c_cont.eventually_ne hc_reg)
  obtain ⟨δ_a1, hδ_a1_pos, hδ_a1_sub⟩ := Metric.mem_nhds_iff.mp hy_nhds

  have hp₁'_B₁ : (s₁', (0 : ℂ)) ∈ B₁ :=
    hB₀_sub_B₁ ⟨hs₁'_U₀, Metric.mem_ball_self hρ'_pos⟩
  have hZc_cont : ContinuousAt (R.Z c) (s₁', (0 : ℂ)) :=
    (R.Z_holo c).continuousOn.continuousAt
      ((Metric.isOpen_ball.prod Metric.isOpen_ball).mem_nhds hp₁'_B₁)
  have hZc_nhds : (R.Z c) ⁻¹' W_w ∈ nhds (s₁', (0 : ℂ)) :=
    hZc_cont.preimage_mem_nhds (Metric.ball_mem_nhds w₀ hr_w_pos)
  obtain ⟨δ_a2, hδ_a2_pos, hδ_a2_sub⟩ := Metric.mem_nhds_iff.mp hZc_nhds

  let δ_a : ℝ := min ρ' (min δ_a1 δ_a2)
  have hδ_a_pos : 0 < δ_a := lt_min hρ'_pos (lt_min hδ_a1_pos hδ_a2_pos)
  have hδ_a_le_ρ' : δ_a ≤ ρ' := min_le_left _ _
  let U_a : Set ℂ := Metric.ball s₁' δ_a
  let B_a : Set (ℂ × ℂ) := U_a ×ˢ Metric.ball (0 : ℂ) δ_a
  have hBa_eq_ball : B_a = Metric.ball (s₁', (0 : ℂ)) δ_a := ball_prod_same s₁' 0 δ_a
  have hBa_open : IsOpen B_a := Metric.isOpen_ball.prod Metric.isOpen_ball
  have hUa_sub_U₀ : U_a ⊆ U₀ := Metric.ball_subset_ball hδ_a_le_ρ'
  have hUa_sub_U₁ : U_a ⊆ U₁ := Set.Subset.trans hUa_sub_U₀ hU₀_sub_U₁
  have hBa_sub_B₀ : B_a ⊆ B₀ :=
    Set.prod_mono hUa_sub_U₀ (Metric.ball_subset_ball hδ_a_le_ρ')
  have hBa_sub_B₁ : B_a ⊆ B₁ := Set.Subset.trans hBa_sub_B₀ hB₀_sub_B₁
  have hZc_maps_Ww : Set.MapsTo (R.Z c) B_a W_w := by
    intro p hp
    apply hδ_a2_sub
    rw [hBa_eq_ball] at hp
    exact Metric.ball_subset_ball
      (le_trans (min_le_right _ _) (min_le_right _ _)) hp

  let σ : ℂ × ℂ → ℂ := fun p => ψ_inv (R.Z c p)
  have hσ_holo_a : DifferentiableOn ℂ σ B_a :=
    hψ_holo.comp ((R.Z_holo c).mono hBa_sub_B₁) hZc_maps_Ww
  have hσ_maps_U₁ : ∀ p ∈ B_a, σ p ∈ U₁ :=
    fun p hp => hU₀_sub_U₁ (hψ_props (R.Z c p) (hZc_maps_Ww hp)).1
  have hZc_comp_a : ∀ p ∈ B_a, Z_zero c (σ p) = R.Z c p :=
    fun p hp => (hψ_props (R.Z c p) (hZc_maps_Ww hp)).2
  have hσ_zero_a : ∀ y ∈ U_a, σ (y, 0) = y := by
    intro y hy
    have hy1 : y ∈ Metric.ball s₁' δ_a1 :=
      Metric.ball_subset_ball (le_trans (min_le_right _ _) (min_le_left _ _)) hy
    exact (hδ_a1_sub hy1).1
  have hderiv_c_nz : ∀ y ∈ U_a, deriv (Z_zero c) y ≠ 0 := by
    intro y hy
    have hy1 : y ∈ Metric.ball s₁' δ_a1 :=
      Metric.ball_subset_ball (le_trans (min_le_right _ _) (min_le_left _ _)) hy
    exact (hδ_a1_sub hy1).2

  have hcoeff_tay : ∀ (d : Fin 2 →₀ ℕ) (g : ℂ × ℂ → ℂ) (q : ℂ × ℂ),
      MvPowerSeries.coeff d (taylor2D g q) =
        iterDerivYT (d 0) (d 1) g q / (((d 0).factorial : ℂ) * ((d 1).factorial : ℂ)) :=
    fun _ _ _ => rfl

  have hZ_comp_a : ∀ ι : Fin 2, ∀ p ∈ B_a, R.Z ι p = Z_zero ι (σ p) := by
    intro ι
    let G_ι : ℂ × ℂ → ℂ := fun p => Z_zero ι (σ p)
    let F : ℂ × ℂ → ℂ := fun p => R.Z ι p - G_ι p
    have hGι_holo : DifferentiableOn ℂ G_ι B_a :=
      (hZ0_holo ι).comp hσ_holo_a hσ_maps_U₁
    have hF_holo : DifferentiableOn ℂ F B_a :=
      ((R.Z_holo ι).mono hBa_sub_B₁).sub hGι_holo
    have hcomp_pderiv : ∀ (j : Fin 2), ∀ p ∈ B_a,
        pderivA (fun q => Z_zero j (σ q)) p = deriv (Z_zero j) (σ p) * pderivA σ p ∧
        pderivD (fun q => Z_zero j (σ q)) p = deriv (Z_zero j) (σ p) * pderivD σ p := by
      intro j p hp
      have hZ_d : HasDerivAt (Z_zero j) (deriv (Z_zero j) (σ p)) (σ p) :=
        ((hZ0_holo j).differentiableAt (Metric.isOpen_ball.mem_nhds (hσ_maps_U₁ p hp))).hasDerivAt
      have hσ_diff_p : DifferentiableAt ℂ σ p :=
        hσ_holo_a.differentiableAt (hBa_open.mem_nhds hp)
      have hembA : DifferentiableAt ℂ (fun z : ℂ => (z, p.2)) p.1 :=
        differentiableAt_id.prodMk (differentiableAt_const p.2)
      have hembD : DifferentiableAt ℂ (fun z : ℂ => (p.1, z)) p.2 :=
        (differentiableAt_const p.1).prodMk differentiableAt_id
      have hσ_A : HasDerivAt (fun z : ℂ => σ (z, p.2)) (pderivA σ p) p.1 :=
        (DifferentiableAt.comp (g := σ) p.1 hσ_diff_p hembA).hasDerivAt
      have hσ_D : HasDerivAt (fun z : ℂ => σ (p.1, z)) (pderivD σ p) p.2 :=
        (DifferentiableAt.comp (g := σ) p.2 hσ_diff_p hembD).hasDerivAt
      have hcomp_A : HasDerivAt ((Z_zero j) ∘ (fun z : ℂ => σ (z, p.2)))
          (deriv (Z_zero j) (σ p) * pderivA σ p) p.1 :=
        HasDerivAt.comp (h₂ := Z_zero j) (h := fun z : ℂ => σ (z, p.2)) p.1 hZ_d hσ_A
      have hcomp_D : HasDerivAt ((Z_zero j) ∘ (fun z : ℂ => σ (p.1, z)))
          (deriv (Z_zero j) (σ p) * pderivD σ p) p.2 :=
        HasDerivAt.comp (h₂ := Z_zero j) (h := fun z : ℂ => σ (p.1, z)) p.2 hZ_d hσ_D
      exact ⟨hcomp_A.deriv, hcomp_D.deriv⟩
    have hZc_pderiv : ∀ p ∈ B_a,
        pderivA (R.Z c) p = deriv (Z_zero c) (σ p) * pderivA σ p ∧
        pderivD (R.Z c) p = deriv (Z_zero c) (σ p) * pderivD σ p := by
      intro p hp
      obtain ⟨hcA, hcD⟩ := hcomp_pderiv c p hp
      have hevA : (fun z : ℂ => R.Z c (z, p.2)) =ᶠ[nhds p.1]
          (fun z : ℂ => Z_zero c (σ (z, p.2))) := by
        filter_upwards [Metric.isOpen_ball.mem_nhds hp.1] with z hz
        exact (hZc_comp_a (z, p.2) ⟨hz, hp.2⟩).symm
      have hevD : (fun z : ℂ => R.Z c (p.1, z)) =ᶠ[nhds p.2]
          (fun z : ℂ => Z_zero c (σ (p.1, z))) := by
        filter_upwards [Metric.isOpen_ball.mem_nhds hp.2] with z hz
        exact (hZc_comp_a (p.1, z) ⟨hp.1, hz⟩).symm
      exact ⟨(hevA.deriv_eq).trans hcA, (hevD.deriv_eq).trans hcD⟩
    have hPDE : ∀ p ∈ B_a,
        pderivA (R.Z c) p * pderivD F p = pderivD (R.Z c) p * pderivA F p := by
      intro p hp
      have hZi_diff : DifferentiableAt ℂ (R.Z ι) p :=
        (R.Z_holo ι).differentiableAt
          ((Metric.isOpen_ball.prod Metric.isOpen_ball).mem_nhds (hBa_sub_B₁ hp))
      have hGi_diff : DifferentiableAt ℂ G_ι p :=
        hGι_holo.differentiableAt (hBa_open.mem_nhds hp)
      have hembA : DifferentiableAt ℂ (fun z : ℂ => (z, p.2)) p.1 :=
        differentiableAt_id.prodMk (differentiableAt_const p.2)
      have hembD : DifferentiableAt ℂ (fun z : ℂ => (p.1, z)) p.2 :=
        (differentiableAt_const p.1).prodMk differentiableAt_id
      have hZi_A : HasDerivAt (fun z : ℂ => R.Z ι (z, p.2)) (pderivA (R.Z ι) p) p.1 :=
        (DifferentiableAt.comp (g := R.Z ι) p.1 hZi_diff hembA).hasDerivAt
      have hZi_D : HasDerivAt (fun z : ℂ => R.Z ι (p.1, z)) (pderivD (R.Z ι) p) p.2 :=
        (DifferentiableAt.comp (g := R.Z ι) p.2 hZi_diff hembD).hasDerivAt
      have hGi_A : HasDerivAt (fun z : ℂ => G_ι (z, p.2)) (pderivA G_ι p) p.1 :=
        (DifferentiableAt.comp (g := G_ι) p.1 hGi_diff hembA).hasDerivAt
      have hGi_D : HasDerivAt (fun z : ℂ => G_ι (p.1, z)) (pderivD G_ι p) p.2 :=
        (DifferentiableAt.comp (g := G_ι) p.2 hGi_diff hembD).hasDerivAt
      have hFA : pderivA F p = pderivA (R.Z ι) p - pderivA G_ι p := (hZi_A.sub hGi_A).deriv
      have hFD : pderivD F p = pderivD (R.Z ι) p - pderivD G_ι p := (hZi_D.sub hGi_D).deriv
      obtain ⟨hGA, hGD⟩ := hcomp_pderiv ι p hp
      obtain ⟨hZA, hZD⟩ := hZc_pderiv p hp
      have hG_rel : pderivA (R.Z c) p * pderivD G_ι p = pderivD (R.Z c) p * pderivA G_ι p := by
        change pderivA (R.Z c) p * pderivD (fun q => Z_zero ι (σ q)) p =
          pderivD (R.Z c) p * pderivA (fun q => Z_zero ι (σ q)) p
        rw [hZA, hZD, hGA, hGD]
        ring
      have hZ_rel :
          pderivA (R.Z c) p * pderivD (R.Z ι) p = pderivD (R.Z c) p * pderivA (R.Z ι) p := by
        have hr1 := R.Z_rank_one p (hBa_sub_B₁ hp)
        fin_cases c <;> fin_cases ι <;> simp only [Fin.zero_eta, Fin.mk_one]
        · ring
        · exact hr1
        · linear_combination -hr1
        · ring
      rw [hFA, hFD]
      linear_combination hZ_rel - hG_rel
    obtain ⟨hZcA_holo, hZcD_holo⟩ :=
      hKit.pderiv_holo hBa_open ((R.Z_holo c).mono hBa_sub_B₁)
    obtain ⟨hFA_holo, hFD_holo⟩ := hKit.pderiv_holo hBa_open hF_holo
    have h_tau_vanish : ∀ β : ℕ, ∀ y ∈ U_a, iterDerivYT 0 β F (y, 0) = 0 := by
      intro β
      induction β using Nat.strong_induction_on with
      | h β ih =>
        cases β with
        | zero =>
          intro y hy
          change F (y, 0) = 0
          dsimp [F, G_ι, Z_zero]
          rw [hσ_zero_a y hy, sub_self]
        | succ n =>
          intro y hy
          let p_y : ℂ × ℂ := (y, (0 : ℂ))
          have hp_y : p_y ∈ B_a := ⟨hy, Metric.mem_ball_self hδ_a_pos⟩
          have h_pA_vanish : ∀ j ≤ n, iterDerivYT 0 j (pderivA F) p_y = 0 := by
            intro j hj
            have hj_lt : j < n + 1 := Nat.lt_succ_of_le hj
            have hstep := hKit.iterDerivYT_step hBa_open hF_holo 0 j p_y hp_y
            rw [← hstep.1, ← hstep.2.2.1]
            change deriv (fun z : ℂ => iterDerivYT 0 j F (z, 0)) y = 0
            have hev : (fun z : ℂ => iterDerivYT 0 j F (z, 0)) =ᶠ[nhds y]
                (fun _ : ℂ => (0 : ℂ)) := by
              filter_upwards [Metric.isOpen_ball.mem_nhds hy] with z hz
              exact ih j hj_lt z hz
            rw [hev.deriv_eq, deriv_const]
          have htay_eq :
              taylor2D (pderivA (R.Z c)) p_y * taylor2D (pderivD F) p_y =
                taylor2D (pderivD (R.Z c)) p_y * taylor2D (pderivA F) p_y := by
            have hcongr := hKit.taylor2D_congr hBa_open hp_y hPDE
            have hmul1 := ((hKit.taylor2D_algebra hBa_open hp_y).2 hZcA_holo hFD_holo).2.2
            have hmul2 := ((hKit.taylor2D_algebra hBa_open hp_y).2 hZcD_holo hFA_holo).2.2
            rw [← hmul1, ← hmul2]
            exact hcongr
          let d_n : Fin 2 →₀ ℕ := Finsupp.single 1 n
          have hd_n_0 : d_n 0 = 0 := by simp [d_n]
          have hd_n_1 : d_n 1 = n := by simp [d_n]
          have hcoeff_eq := congr_arg (MvPowerSeries.coeff d_n) htay_eq
          rw [MvPowerSeries.coeff_mul, MvPowerSeries.coeff_mul] at hcoeff_eq
          have hRHS_zero :
              (∑ r ∈ Finset.HasAntidiagonal.antidiagonal d_n,
                MvPowerSeries.coeff r.1 (taylor2D (pderivD (R.Z c)) p_y) *
                  MvPowerSeries.coeff r.2 (taylor2D (pderivA F) p_y)) = 0 := by
            refine Finset.sum_eq_zero (fun r hr => ?_)
            have hr_add : r.1 + r.2 = d_n := Finset.HasAntidiagonal.mem_antidiagonal.mp hr
            have hr0 : r.1 0 + r.2 0 = 0 := by
              have h := congr_arg (fun u : Fin 2 →₀ ℕ => u 0) hr_add
              simpa [Finsupp.add_apply, hd_n_0] using h
            have hr1 : r.1 1 + r.2 1 = n := by
              have h := congr_arg (fun u : Fin 2 →₀ ℕ => u 1) hr_add
              simpa [Finsupp.add_apply, hd_n_1] using h
            have hr2_0 : r.2 0 = 0 := by omega
            have hr2_le : r.2 1 ≤ n := by omega
            rw [hcoeff_tay r.2 (pderivA F) p_y, hr2_0, h_pA_vanish (r.2 1) hr2_le,
              zero_div, mul_zero]
          let r₀ : (Fin 2 →₀ ℕ) × (Fin 2 →₀ ℕ) := (0, d_n)
          have hLHS_single :
              (∑ r ∈ Finset.HasAntidiagonal.antidiagonal d_n,
                MvPowerSeries.coeff r.1 (taylor2D (pderivA (R.Z c)) p_y) *
                  MvPowerSeries.coeff r.2 (taylor2D (pderivD F) p_y)) =
              MvPowerSeries.coeff 0 (taylor2D (pderivA (R.Z c)) p_y) *
                MvPowerSeries.coeff d_n (taylor2D (pderivD F) p_y) := by
            refine Finset.sum_eq_single r₀ (fun r hr hne => ?_) (fun hnotmem => ?_)
            · have hr_add : r.1 + r.2 = d_n := Finset.HasAntidiagonal.mem_antidiagonal.mp hr
              have hr0 : r.1 0 + r.2 0 = 0 := by
                have h := congr_arg (fun u : Fin 2 →₀ ℕ => u 0) hr_add
                simpa [Finsupp.add_apply, hd_n_0] using h
              have hr1 : r.1 1 + r.2 1 = n := by
                have h := congr_arg (fun u : Fin 2 →₀ ℕ => u 1) hr_add
                simpa [Finsupp.add_apply, hd_n_1] using h
              have hr2_0 : r.2 0 = 0 := by omega
              have hr2_lt : r.2 1 < n := by
                by_contra hnot_lt
                have hr2_1 : r.2 1 = n := by omega
                have hr1_1 : r.1 1 = 0 := by omega
                apply hne
                refine Prod.ext ?_ ?_
                · ext i
                  fin_cases i
                  · simp [r₀]; omega
                  · simp [r₀, hr1_1]
                · ext i
                  fin_cases i
                  · simp [r₀, hd_n_0]; omega
                  · simp [r₀, hd_n_1, hr2_1]
              have hstep_D := (hKit.iterDerivYT_step hBa_open hF_holo 0 (r.2 1) p_y hp_y).2.1
              have hvan : iterDerivYT 0 (r.2 1) (pderivD F) p_y = 0 := by
                rw [← hstep_D]
                exact ih (r.2 1 + 1) (Nat.add_lt_add_right hr2_lt 1) y hy
              rw [hcoeff_tay r.2 (pderivD F) p_y, hr2_0, hvan, zero_div, mul_zero]
            · exfalso
              apply hnotmem
              rw [Finset.HasAntidiagonal.mem_antidiagonal]
              exact zero_add d_n
          rw [hLHS_single, hRHS_zero] at hcoeff_eq
          rw [hcoeff_tay 0 (pderivA (R.Z c)) p_y, hcoeff_tay d_n (pderivD F) p_y] at hcoeff_eq
          simp only [Finsupp.coe_zero, Pi.zero_apply, hd_n_0, hd_n_1, Nat.factorial_zero,
            Nat.cast_one, one_mul, div_one] at hcoeff_eq
          have hZc_at_0 : iterDerivYT 0 0 (pderivA (R.Z c)) p_y = deriv (Z_zero c) y := rfl
          have hstep_n := (hKit.iterDerivYT_step hBa_open hF_holo 0 n p_y hp_y).2.1
          rw [hZc_at_0, ← hstep_n] at hcoeff_eq
          have hdiv0 : iterDerivYT 0 (n + 1) F p_y / (n.factorial : ℂ) = 0 :=
            (mul_eq_zero.mp hcoeff_eq).resolve_left (hderiv_c_nz y hy)
          have hfact_ne : (n.factorial : ℂ) ≠ 0 :=
            Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero n)
          exact (div_eq_zero_iff.mp hdiv0).resolve_right hfact_ne
    have h_all_vanish : ∀ α β : ℕ, ∀ y ∈ U_a, iterDerivYT α β F (y, 0) = 0 := by
      intro α
      induction α with
      | zero => exact h_tau_vanish
      | succ α ihα =>
        intro β y hy
        have hp_y : (y, (0 : ℂ)) ∈ B_a := ⟨hy, Metric.mem_ball_self hδ_a_pos⟩
        have hstep := (hKit.iterDerivYT_step hBa_open hF_holo α β (y, 0) hp_y).2.2.1
        rw [← hstep]
        change deriv (fun z : ℂ => iterDerivYT α β F (z, 0)) y = 0
        have hev : (fun z : ℂ => iterDerivYT α β F (z, 0)) =ᶠ[nhds y]
            (fun _ : ℂ => (0 : ℂ)) := by
          filter_upwards [Metric.isOpen_ball.mem_nhds hy] with z hz
          exact ihα β z hz
        rw [hev.deriv_eq, deriv_const]
    have hp₁'_Ba : (s₁', (0 : ℂ)) ∈ B_a :=
      ⟨Metric.mem_ball_self hδ_a_pos, Metric.mem_ball_self hδ_a_pos⟩
    have htay0 : taylor2D F (s₁', (0 : ℂ)) = 0 := by
      ext d
      rw [hcoeff_tay, h_all_vanish (d 0) (d 1) s₁' (Metric.mem_ball_self hδ_a_pos), zero_div,
        MvPowerSeries.coeff_zero]
    have hBa_preconn : IsPreconnected B_a :=
      (convex_ball s₁' δ_a).isPreconnected.prod (convex_ball (0 : ℂ) δ_a).isPreconnected
    have hF_zero : ∀ p ∈ B_a, F p = 0 :=
      hKit.eqOn_zero_of_taylor2D_zero hBa_open hBa_preconn hp₁'_Ba hF_holo htay0
    intro p hp
    exact sub_eq_zero.mp (hF_zero p hp)

  have hp₁'_Ba_main : (s₁', (0 : ℂ)) ∈ B_a :=
    ⟨Metric.mem_ball_self hδ_a_pos, Metric.mem_ball_self hδ_a_pos⟩
  have hσ_cont_p₁' : ContinuousAt σ (s₁', (0 : ℂ)) :=
    hσ_holo_a.continuousOn.continuousAt (hBa_open.mem_nhds hp₁'_Ba_main)
  have hσ_p₁'_eq : σ (s₁', (0 : ℂ)) = s₁' :=
    hσ_zero_a s₁' (Metric.mem_ball_self hδ_a_pos)
  have hσ_Ua_nhds : σ ⁻¹' U_a ∈ nhds (s₁', (0 : ℂ)) :=
    hσ_cont_p₁'.preimage_mem_nhds (hσ_p₁'_eq.symm ▸ Metric.ball_mem_nhds s₁' hδ_a_pos)
  obtain ⟨δ_b_raw, hδ_b_raw_pos, hδ_b_raw_sub⟩ := Metric.mem_nhds_iff.mp hσ_Ua_nhds
  let δ_b : ℝ := min δ_b_raw δ_a
  have hδ_b_pos : 0 < δ_b := lt_min hδ_b_raw_pos hδ_a_pos
  have hδ_b_le_a : δ_b ≤ δ_a := min_le_right _ _
  let B_b : Set (ℂ × ℂ) := Metric.ball s₁' δ_b ×ˢ Metric.ball (0 : ℂ) δ_b
  have hBb_eq_ball : B_b = Metric.ball (s₁', (0 : ℂ)) δ_b := ball_prod_same s₁' 0 δ_b
  have hBb_open : IsOpen B_b := Metric.isOpen_ball.prod Metric.isOpen_ball
  have hBb_sub_Ba : B_b ⊆ B_a :=
    Set.prod_mono (Metric.ball_subset_ball hδ_b_le_a) (Metric.ball_subset_ball hδ_b_le_a)
  have hBb_sub_B₁ : B_b ⊆ B₁ := Set.Subset.trans hBb_sub_Ba hBa_sub_B₁
  have hσ_holo_b : DifferentiableOn ℂ σ B_b := hσ_holo_a.mono hBb_sub_Ba
  have hσ_maps_a : ∀ p ∈ B_b, σ p ∈ U_a := by
    intro p hp
    apply hδ_b_raw_sub
    rw [hBb_eq_ball] at hp
    exact Metric.ball_subset_ball (min_le_left _ _) hp
  have hσ_zero_b : ∀ y ∈ Metric.ball s₁' δ_b, σ (y, 0) = y :=
    fun y hy => hσ_zero_a y (Metric.ball_subset_ball hδ_b_le_a hy)
  have hZ_comp_b : ∀ ι : Fin 2, ∀ p ∈ B_b, R.Z ι p = Z_zero ι (σ p) :=
    fun ι p hp => hZ_comp_a ι p (hBb_sub_Ba hp)

  
  
  
  let W₁ : Fin 3 → ℂ × ℂ → ℂ := homIntersect (puisDualLine0 C G.d) G.M_puis
  have hBb_punc_sub_G : ∀ p ∈ B_b, p.2 ≠ 0 →
      p ∈ Metric.ball (Br.y₀ : ℂ) G.r_yp ×ˢ (Metric.ball (0 : ℂ) G.r_τ \ {0}) := by
    intro p hp hp2
    have hp₁ := hBb_sub_B₁ hp
    exact ⟨R.ball_y₁_sub hp₁.1, ⟨Metric.ball_subset_ball R.ρ₁_le_τ hp₁.2, hp2⟩⟩

  have hW₁_rel : ∀ p ∈ B_b, p.2 ≠ 0 →
      W₁ 2 p ≠ 0 ∧ ∀ ι : Fin 2, W₁ ι.castSucc p = W₁ 2 p * Z_zero ι (σ p) := by
    intro p hp hp2
    have hp₁ := hBb_sub_B₁ hp
    have hpeq := R.W_tilde_puis_eq p hp₁ hp2
    have hW2_tilde_ne : R.W_tilde 2 p ≠ 0 := R.W_tilde_two_ne_zero p hp₁
    have hpow_m_ne : p.2 ^ R.m_star ≠ 0 := pow_ne_zero R.m_star hp2
    have hpow_K_ne : p.2 ^ G.K_p ≠ 0 := pow_ne_zero G.K_p hp2
    have hW1_2_ne : W₁ 2 p ≠ 0 := by
      intro h0
      have hmul := hpeq 2
      change p.2 ^ R.m_star * R.W_tilde 2 p = p.2 ^ G.K_p * W₁ 2 p at hmul
      rw [h0, mul_zero] at hmul
      exact mul_ne_zero hpow_m_ne hW2_tilde_ne hmul
    refine ⟨hW1_2_ne, fun ι => ?_⟩
    have hmul_ι : p.2 ^ R.m_star * R.W_tilde ι.castSucc p =
        p.2 ^ G.K_p * W₁ ι.castSucc p := hpeq ι.castSucc
    have hmul_2 : p.2 ^ R.m_star * R.W_tilde 2 p = p.2 ^ G.K_p * W₁ 2 p := hpeq 2
    have hZ_eq : R.Z ι p = R.W_tilde ι.castSucc p / R.W_tilde 2 p := R.Z_eq ι p hp₁
    have hW_tilde_ι : R.W_tilde ι.castSucc p = R.W_tilde 2 p * R.Z ι p := by
      rw [hZ_eq, mul_div_cancel₀ _ hW2_tilde_ne]
    rw [hW_tilde_ι] at hmul_ι
    have h_scaled :
        p.2 ^ G.K_p * W₁ ι.castSucc p =
          p.2 ^ G.K_p * (W₁ 2 p * Z_zero ι (σ p)) := by
      rw [← hZ_comp_b ι p hp, ← hmul_ι,
        show p.2 ^ R.m_star * (R.W_tilde 2 p * R.Z ι p) =
          (p.2 ^ R.m_star * R.W_tilde 2 p) * R.Z ι p by ring,
        hmul_2]
      ring
    exact mul_left_cancel₀ hpow_K_ne h_scaled

  
  have h_iso_witness :
      ∃ z ∈ U_a, (deriv (Z_zero 0) z) ^ 2 + (deriv (Z_zero 1) z) ^ 2 ≠ 0 := by
    by_contra hNoIso
    have hIso0 : ∀ z ∈ U_a, (deriv (Z_zero 0) z) ^ 2 + (deriv (Z_zero 1) z) ^ 2 = 0 :=
      fun z hz => by_contra fun hne => hNoIso ⟨z, hz, hne⟩
    let g_plus : ℂ → ℂ := fun z => Z_zero 0 z + Complex.I * Z_zero 1 z
    let g_minus : ℂ → ℂ := fun z => Z_zero 0 z - Complex.I * Z_zero 1 z
    have hg_plus_holo : DifferentiableOn ℂ g_plus U_a :=
      ((hZ0_holo 0).mono hUa_sub_U₁).add
        ((differentiableOn_const Complex.I).mul ((hZ0_holo 1).mono hUa_sub_U₁))
    have hg_minus_holo : DifferentiableOn ℂ g_minus U_a :=
      ((hZ0_holo 0).mono hUa_sub_U₁).sub
        ((differentiableOn_const Complex.I).mul ((hZ0_holo 1).mono hUa_sub_U₁))
    have hg_deriv_mul : ∀ z ∈ U_a, deriv g_plus z * deriv g_minus z = 0 := by
      intro z hz
      have h0d : HasDerivAt (Z_zero 0) (deriv (Z_zero 0) z) z :=
        ((hZ0_holo 0).differentiableAt (Metric.isOpen_ball.mem_nhds (hUa_sub_U₁ hz))).hasDerivAt
      have h1d : HasDerivAt (Z_zero 1) (deriv (Z_zero 1) z) z :=
        ((hZ0_holo 1).differentiableAt (Metric.isOpen_ball.mem_nhds (hUa_sub_U₁ hz))).hasDerivAt
      have hp_d : deriv g_plus z = deriv (Z_zero 0) z + Complex.I * deriv (Z_zero 1) z :=
        (h0d.add (h1d.const_mul Complex.I)).deriv
      have hm_d : deriv g_minus z = deriv (Z_zero 0) z - Complex.I * deriv (Z_zero 1) z :=
        (h0d.sub (h1d.const_mul Complex.I)).deriv
      rw [hp_d, hm_d]
      calc (deriv (Z_zero 0) z + Complex.I * deriv (Z_zero 1) z) *
              (deriv (Z_zero 0) z - Complex.I * deriv (Z_zero 1) z)
          = (deriv (Z_zero 0) z) ^ 2 - Complex.I ^ 2 * (deriv (Z_zero 1) z) ^ 2 := by ring
        _ = (deriv (Z_zero 0) z) ^ 2 + (deriv (Z_zero 1) z) ^ 2 := by rw [Complex.I_sq]; ring
        _ = 0 := hIso0 z hz
    have h_factor_zero :
        ∃ s_iso : ℂ, (s_iso = 1 ∨ s_iso = -1) ∧
          ∀ z ∈ U_a, deriv (fun w => Z_zero 0 w + s_iso * Complex.I * Z_zero 1 w) z = 0 := by
      by_cases hgp : ∀ z ∈ U_a, deriv g_plus z = 0
      · refine ⟨1, Or.inl rfl, fun z hz => ?_⟩
        simpa only [one_mul] using hgp z hz
      · obtain ⟨z₁, hz₁⟩ := not_forall.mp hgp
        obtain ⟨hz₁_Ua, hz₁_nz⟩ := not_imp.mp hz₁
        have hgp'_cont : ContinuousAt (deriv g_plus) z₁ :=
          (hg_plus_holo.deriv Metric.isOpen_ball).continuousOn.continuousAt
            (Metric.isOpen_ball.mem_nhds hz₁_Ua)
        have hgm'_ana : AnalyticOnNhd ℂ (deriv g_minus) U_a :=
          (Complex.analyticOnNhd_iff_differentiableOn Metric.isOpen_ball).mpr
            (hg_minus_holo.deriv Metric.isOpen_ball)
        have hev_gm0 : deriv g_minus =ᶠ[nhds z₁] 0 := by
          filter_upwards [Metric.isOpen_ball.mem_nhds hz₁_Ua,
            hgp'_cont.eventually_ne hz₁_nz] with z hz hne
          exact (mul_eq_zero.mp (hg_deriv_mul z hz)).resolve_left hne
        have hgm_all0 : ∀ z ∈ U_a, deriv g_minus z = 0 :=
          fun z hz => hgm'_ana.eqOn_zero_of_preconnected_of_eventuallyEq_zero
            (convex_ball s₁' δ_a).isPreconnected hz₁_Ua hev_gm0 hz
        refine ⟨-1, Or.inr rfl, fun z hz => ?_⟩
        have hfn : (fun w => Z_zero 0 w + (-1 : ℂ) * Complex.I * Z_zero 1 w) = g_minus := by
          ext w; dsimp [g_minus]; ring
        rw [hfn]
        exact hgm_all0 z hz
    obtain ⟨s_iso, hs_iso, hderiv_iso0⟩ := h_factor_zero
    let g_iso : ℂ → ℂ := fun w => Z_zero 0 w + s_iso * Complex.I * Z_zero 1 w
    have hg_iso_diff : ∀ z ∈ U_a, DifferentiableAt ℂ g_iso z := by
      intro z hz
      have h0 := (hZ0_holo 0).differentiableAt (Metric.isOpen_ball.mem_nhds (hUa_sub_U₁ hz))
      have h1 := (hZ0_holo 1).differentiableAt (Metric.isOpen_ball.mem_nhds (hUa_sub_U₁ hz))
      exact h0.add (h1.const_mul (s_iso * Complex.I))
    let c_star : ℂ := g_iso s₁'
    have hg_iso_const : ∀ z ∈ U_a, g_iso z = c_star := by
      intro z hz
      have hnorm0 : ‖g_iso z - g_iso s₁'‖ ≤ (0 : ℝ) * ‖z - s₁'‖ :=
        Convex.norm_image_sub_le_of_norm_deriv_le hg_iso_diff
          (fun w hw => by rw [hderiv_iso0 w hw, norm_zero])
          (convex_ball s₁' δ_a) (Metric.mem_ball_self hδ_a_pos) hz
      rw [zero_mul, norm_le_zero_iff, sub_eq_zero] at hnorm0
      exact hnorm0
    let V_b : Set (ℂ × ℂ) := Metric.ball s₁' δ_b ×ˢ (Metric.ball (0 : ℂ) δ_b \ {0})
    have hVb_open : IsOpen V_b :=
      Metric.isOpen_ball.prod (Metric.isOpen_ball.inter isOpen_compl_singleton)
    have hVb_ne : V_b.Nonempty := by
      refine ⟨(s₁', ((δ_b / 2 : ℝ) : ℂ)), Metric.mem_ball_self hδ_b_pos, ?_, ?_⟩
      · rw [Metric.mem_ball, dist_zero_right, Complex.norm_real, Real.norm_eq_abs,
          abs_of_pos (by linarith)]
        linarith
      · exact Complex.ofReal_ne_zero.mpr (by linarith)
    have hVb_sub : V_b ⊆ Metric.ball (Br.y₀ : ℂ) G.r_yp ×ˢ (Metric.ball (0 : ℂ) G.r_τ \ {0}) :=
      fun p hp => hBb_punc_sub_G p ⟨hp.1, hp.2.1⟩ hp.2.2
    refine G.not_iso_line V_b s_iso c_star hVb_open hVb_ne hVb_sub hs_iso (fun p hp => ?_)
    obtain ⟨_, hW_vals⟩ := hW₁_rel p ⟨hp.1, hp.2.1⟩ hp.2.2
    have hW0 : W₁ 0 p = W₁ 2 p * Z_zero 0 (σ p) := hW_vals 0
    have hW1 : W₁ 1 p = W₁ 2 p * Z_zero 1 (σ p) := hW_vals 1
    change W₁ 0 p + s_iso * Complex.I * W₁ 1 p - c_star * W₁ 2 p = 0
    rw [hW0, hW1]
    have hconst_p : Z_zero 0 (σ p) + s_iso * Complex.I * Z_zero 1 (σ p) = c_star :=
      hg_iso_const (σ p) (hσ_maps_a p ⟨hp.1, hp.2.1⟩)
    linear_combination W₁ 2 p * hconst_p

  
  have h_tr_witness :
      ∃ z ∈ U_a,
        dualLineShift C 0 0 (z, 0) * deriv (Z_zero 0) z +
          dualLineShift C 0 1 (z, 0) * deriv (Z_zero 1) z ≠ 0 := by
    by_contra hNoTr
    have hTr0 : ∀ s ∈ U_a,
        dualLineShift C 0 0 (s, 0) * deriv (Z_zero 0) s +
          dualLineShift C 0 1 (s, 0) * deriv (Z_zero 1) s = 0 :=
      fun s hs => by_contra fun hne => hNoTr ⟨s, hs, hne⟩
    have hBoundary : ∀ s ∈ U_a, ∀ ι : Fin 2, Z_zero ι s = glancingBoundaryCurve C s ι :=
      hEnv_id s₁' δ_a hδ_a_pos hUa_sub_U₁ hTr0
    obtain ⟨r_s, r_env, s_minus, s_plus, Q_inc, hr_env_pos, hr_env_le_rs, _hrs_lt,
      hs_minus_holo, hs_plus_holo, hs_pm_props, hQ_inc_factor, hEnv_uniq⟩ :=
      B_col.envelope_quad_factor y₁'
    have hrs_pos : 0 < r_s := lt_of_lt_of_le hr_env_pos hr_env_le_rs
    have hσ_rs_nhds : σ ⁻¹' (Metric.ball s₁' r_s) ∈ nhds (s₁', (0 : ℂ)) :=
      hσ_cont_p₁'.preimage_mem_nhds (hσ_p₁'_eq.symm ▸ Metric.ball_mem_nhds s₁' hrs_pos)
    obtain ⟨r_σ, hr_σ_pos, hr_σ_sub⟩ := Metric.mem_nhds_iff.mp hσ_rs_nhds
    let δ_env : ℝ :=
      min δ_b (min r_σ (min 1 (min r_env (min B_cr.s_det B_cr.r_det))))
    have hδ_env_pos : 0 < δ_env :=
      lt_min hδ_b_pos
        (lt_min hr_σ_pos
          (lt_min one_pos
            (lt_min hr_env_pos (lt_min B_cr.s_det_pos B_cr.r_det_pos))))
    have hδ_env_le_b : δ_env ≤ δ_b := min_le_left _ _
    have hδ_env_le_rσ : δ_env ≤ r_σ := le_trans (min_le_right _ _) (min_le_left _ _)
    have hδ_env_le_one : δ_env ≤ 1 :=
      le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_left _ _))
    have hδ_env_le_renv : δ_env ≤ r_env :=
      le_trans (min_le_right _ _)
        (le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_left _ _)))
    have hδ_env_le_sdet : δ_env ≤ B_cr.s_det :=
      le_trans (min_le_right _ _)
        (le_trans (min_le_right _ _)
          (le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_left _ _))))
    have hδ_env_le_rdet : δ_env ≤ B_cr.r_det :=
      le_trans (min_le_right _ _)
        (le_trans (min_le_right _ _)
          (le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_right _ _))))
    let B_env : Set (ℂ × ℂ) := Metric.ball s₁' δ_env ×ˢ Metric.ball (0 : ℂ) δ_env
    have hB_env_eq_ball : B_env = Metric.ball (s₁', (0 : ℂ)) δ_env :=
      ball_prod_same s₁' 0 δ_env
    have hB_env_open : IsOpen B_env := Metric.isOpen_ball.prod Metric.isOpen_ball
    have hB_env_preconn : IsPreconnected B_env :=
      (convex_ball s₁' δ_env).isPreconnected.prod (convex_ball (0 : ℂ) δ_env).isPreconnected
    have hB_env_sub_Bb : B_env ⊆ B_b :=
      Set.prod_mono (Metric.ball_subset_ball hδ_env_le_b) (Metric.ball_subset_ball hδ_env_le_b)
    let powMap : ℂ × ℂ → ℂ × ℂ := fun p => (p.1, p.2 ^ G.d)
    have hpowMap_diff : Differentiable ℂ powMap :=
      differentiable_fst.prodMk (differentiable_snd.pow G.d)
    have hpowMap_B_env : ∀ p ∈ B_env,
        ‖p.2 ^ G.d‖ < δ_env ∧
        powMap p ∈ Metric.ball s₁' r_env ×ˢ Metric.ball (0 : ℂ) r_env ∧
        |p.1.im| < B_cr.s_det ∧
        ‖p.2 ^ G.d‖ < B_cr.r_det := by
      intro p hp
      have hp2_lt : ‖p.2‖ < δ_env := by simpa [Metric.mem_ball, dist_zero_right] using hp.2
      have hp2_le_one : ‖p.2‖ ≤ 1 := le_of_lt (lt_of_lt_of_le hp2_lt hδ_env_le_one)
      have hpow_le : ‖p.2 ^ G.d‖ ≤ ‖p.2‖ := by
        rw [norm_pow]
        exact pow_le_of_le_one (norm_nonneg p.2) hp2_le_one hd_ne_zero
      have hpow_lt : ‖p.2 ^ G.d‖ < δ_env := lt_of_le_of_lt hpow_le hp2_lt
      have hp1_im : |p.1.im| < B_cr.s_det := by
        have hp1_norm : ‖p.1 - s₁'‖ < δ_env := by simpa [Metric.mem_ball, dist_eq_norm] using hp.1
        have him_eq : (p.1 - s₁').im = p.1.im := by simp [s₁']
        have him_le : |p.1.im| ≤ ‖p.1 - s₁'‖ := by
          rw [← him_eq]
          exact Complex.abs_im_le_norm (p.1 - s₁')
        exact lt_of_le_of_lt him_le (lt_of_lt_of_le hp1_norm hδ_env_le_sdet)
      refine ⟨hpow_lt, ⟨Metric.ball_subset_ball hδ_env_le_renv hp.1, ?_⟩, hp1_im,
        lt_of_lt_of_le hpow_lt hδ_env_le_rdet⟩
      rw [Metric.mem_ball, dist_zero_right]
      exact lt_of_lt_of_le hpow_lt hδ_env_le_renv
    have hσ_rs_on_env : ∀ p ∈ B_env, σ p ∈ Metric.ball s₁' r_s := by
      intro p hp
      apply hr_σ_sub
      rw [hB_env_eq_ball] at hp
      exact Metric.ball_subset_ball hδ_env_le_rσ hp
    let f_minus : ℂ × ℂ → ℂ := fun p => σ p - s_minus (powMap p)
    let f_plus : ℂ × ℂ → ℂ := fun p => σ p - s_plus (powMap p)
    have hf_minus_holo : DifferentiableOn ℂ f_minus B_env :=
      (hσ_holo_b.mono hB_env_sub_Bb).sub
        (hs_minus_holo.comp hpowMap_diff.differentiableOn (fun p hp => (hpowMap_B_env p hp).2.1))
    have hf_plus_holo : DifferentiableOn ℂ f_plus B_env :=
      (hσ_holo_b.mono hB_env_sub_Bb).sub
        (hs_plus_holo.comp hpowMap_diff.differentiableOn (fun p hp => (hpowMap_B_env p hp).2.1))
    have hprod_zero : ∀ p ∈ B_env, f_minus p * f_plus p = 0 := by
      intro p hp
      have hp_Bb := hB_env_sub_Bb hp
      have hp_B₁ := hBb_sub_B₁ hp_Bb
      have hinc := R.Z_incidence p hp_B₁
      rw [hZ_comp_b 0 p hp_Bb, hZ_comp_b 1 p hp_Bb,
        hBoundary (σ p) (hσ_maps_a p hp_Bb) 0,
        hBoundary (σ p) (hσ_maps_a p hp_Bb) 1] at hinc
      change dualLineShift C 0 0 (powMap p) * glancingBoundaryCurve C (σ p) 0 +
        dualLineShift C 0 1 (powMap p) * glancingBoundaryCurve C (σ p) 1 = 1 at hinc
      obtain ⟨hQ_nz, hQ_eq⟩ :=
        hQ_inc_factor (σ p) (hσ_rs_on_env p hp) (powMap p) (hpowMap_B_env p hp).2.1
      have hmul0 : (f_minus p * f_plus p) * Q_inc (σ p) (powMap p) = 0 := by
        dsimp [f_minus, f_plus]
        rw [← hQ_eq, hinc, sub_self]
      exact (mul_eq_zero.mp hmul0).resolve_right hQ_nz
    have h_branch_split :
        (∀ p ∈ B_env, σ p = s_minus (powMap p)) ∨
        (∀ p ∈ B_env, σ p = s_plus (powMap p)) := by
      by_cases hfm : ∀ p ∈ B_env, f_minus p = 0
      · exact Or.inl (fun p hp => sub_eq_zero.mp (hfm p hp))
      · obtain ⟨p_nz, hp_nz⟩ := not_forall.mp hfm
        obtain ⟨hp_nz_mem, hp_nz_val⟩ := not_imp.mp hp_nz
        let V_nz : Set (ℂ × ℂ) := B_env ∩ f_minus ⁻¹' {(0 : ℂ)}ᶜ
        have hV_nz_open : IsOpen V_nz :=
          hf_minus_holo.continuousOn.isOpen_inter_preimage hB_env_open isOpen_compl_singleton
        have hV_nz_ne : V_nz.Nonempty := ⟨p_nz, hp_nz_mem, hp_nz_val⟩
        have hfp_on_V : ∀ q ∈ V_nz, f_plus q = 0 :=
          fun q hq => (mul_eq_zero.mp (hprod_zero q hq.1)).resolve_left hq.2
        have hfp_all : ∀ p ∈ B_env, f_plus p = 0 :=
          hKit.eqOn_zero_of_preconnected_2D hB_env_open hB_env_preconn
            hV_nz_open hV_nz_ne Set.inter_subset_left hf_plus_holo hfp_on_V
        exact Or.inr (fun p hp => sub_eq_zero.mp (hfp_all p hp))
    let V_env : Set (ℂ × ℂ) := Metric.ball s₁' δ_env ×ˢ (Metric.ball (0 : ℂ) δ_env \ {0})
    have hV_env_open : IsOpen V_env :=
      Metric.isOpen_ball.prod (Metric.isOpen_ball.inter isOpen_compl_singleton)
    have hV_env_ne : V_env.Nonempty := by
      refine ⟨(s₁', ((δ_env / 2 : ℝ) : ℂ)), Metric.mem_ball_self hδ_env_pos, ?_, ?_⟩
      · rw [Metric.mem_ball, dist_zero_right, Complex.norm_real, Real.norm_eq_abs,
          abs_of_pos (by linarith)]
        linarith
      · exact Complex.ofReal_ne_zero.mpr (by linarith)
    have hV_env_sub_G :
        V_env ⊆ Metric.ball (Br.y₀ : ℂ) G.r_yp ×ˢ (Metric.ball (0 : ℂ) G.r_τ \ {0}) :=
      fun p hp => hBb_punc_sub_G p (hB_env_sub_Bb ⟨hp.1, hp.2.1⟩) hp.2.2

    rcases h_branch_split with h_eq_minus | h_eq_plus
    · 
      refine G.not_prev_eq V_env hV_env_open hV_env_ne hV_env_sub_G (fun p hp => ?_)
      have hp_env : p ∈ B_env := ⟨hp.1, hp.2.1⟩
      have hp_Bb : p ∈ B_b := hB_env_sub_Bb hp_env
      obtain ⟨_, hpow_renv, hy_sdet, ht_rdet⟩ := hpowMap_B_env p hp_env
      let y : ℂ := p.1
      let t : ℂ := p.2 ^ G.d
      have hZ_eq_X₀ : ∀ ι : Fin 2, Z_zero ι (σ p) = glancingImpact C (y - t / 2) t ι := by
        intro ι
        rw [hBoundary (σ p) (hσ_maps_a p hp_Bb) ι, h_eq_minus p hp_env]
        exact congr_fun (hs_pm_props (y, t) hpow_renv).2.2.1 ι
      have hy_im1 : |y.im| < B_cr.s_det + B_cr.r_det := by linarith [B_cr.r_det_pos]
      have hyt_im2 : |(y - t).im| < B_cr.s_det + B_cr.r_det := by
        have htri : |(y - t).im| ≤ |y.im| + |t.im| := by
          rw [Complex.sub_im, sub_eq_add_neg]
          simpa only [abs_neg] using abs_add_le y.im (-t.im)
        have htim : |t.im| ≤ ‖t‖ := Complex.abs_im_le_norm t
        linarith
      have hcram1 := (B_cr.cramer_edge_identities y t hy_im1 ht_rdet).1.1
      have hcram2_raw := (B_cr.cramer_edge_identities (y - t) t hyt_im2 ht_rdet).1.2
      have hshift_half : (y - t) + t / 2 = y - t / 2 := by ring
      rw [hshift_half] at hcram2_raw
      have hL0_shift : ∀ ι : Fin 2,
          dualLineShift C 0 ι (y, t) = glancingDualLine C y t ι := by
        intro ι
        change glancingDualLine C (y + ((0 : ℤ) : ℂ) * t) t ι = _
        have h0 : y + ((0 : ℤ) : ℂ) * t = y := by push_cast; ring
        rw [h0]
      have hLm1_shift : ∀ ι : Fin 2,
          dualLineShift C (-1) ι (y, t) = glancingDualLine C (y - t) t ι := by
        intro ι
        change glancingDualLine C (y + ((-1 : ℤ) : ℂ) * t) t ι = _
        have hm1 : y + ((-1 : ℤ) : ℂ) * t = y - t := by push_cast; ring
        rw [hm1]
      let W₀_fn : Fin 3 → ℂ × ℂ → ℂ := fun k q =>
        homIntersect (dualLineShift C (-1)) (dualLineShift C 0) k (q.1, q.2 ^ G.d)
      have hW₀_0 : W₀_fn 0 p = W₀_fn 2 p * glancingImpact C (y - t / 2) t 0 := by
        dsimp only [W₀_fn, homIntersect]
        change dualLineShift C 0 1 (y, t) - dualLineShift C (-1) 1 (y, t) =
          (dualLineShift C (-1) 0 (y, t) * dualLineShift C 0 1 (y, t) -
            dualLineShift C (-1) 1 (y, t) * dualLineShift C 0 0 (y, t)) *
            glancingImpact C (y - t / 2) t 0
        rw [hL0_shift 0, hL0_shift 1, hLm1_shift 0, hLm1_shift 1]
        linear_combination
          -glancingDualLine C y t 1 * hcram2_raw + glancingDualLine C (y - t) t 1 * hcram1
      have hW₀_1 : W₀_fn 1 p = W₀_fn 2 p * glancingImpact C (y - t / 2) t 1 := by
        dsimp only [W₀_fn, homIntersect]
        change dualLineShift C (-1) 0 (y, t) - dualLineShift C 0 0 (y, t) =
          (dualLineShift C (-1) 0 (y, t) * dualLineShift C 0 1 (y, t) -
            dualLineShift C (-1) 1 (y, t) * dualLineShift C 0 0 (y, t)) *
            glancingImpact C (y - t / 2) t 1
        rw [hL0_shift 0, hL0_shift 1, hLm1_shift 0, hLm1_shift 1]
        linear_combination
          -glancingDualLine C (y - t) t 0 * hcram1 + glancingDualLine C y t 0 * hcram2_raw
      obtain ⟨_, hW1_vals⟩ := hW₁_rel p hp_Bb hp.2.2
      have hW1_0 : W₁ 0 p = W₁ 2 p * glancingImpact C (y - t / 2) t 0 := by
        have h0 : W₁ 0 p = W₁ 2 p * Z_zero 0 (σ p) := hW1_vals 0
        rwa [hZ_eq_X₀ 0] at h0
      have hW1_1 : W₁ 1 p = W₁ 2 p * glancingImpact C (y - t / 2) t 1 := by
        have h1 : W₁ 1 p = W₁ 2 p * Z_zero 1 (σ p) := hW1_vals 1
        rwa [hZ_eq_X₀ 1] at h1
      change W₁ 0 p * W₀_fn 2 p - W₀_fn 0 p * W₁ 2 p = 0 ∧
        W₁ 1 p * W₀_fn 2 p - W₀_fn 1 p * W₁ 2 p = 0
      rw [hW1_0, hW1_1, hW₀_0, hW₀_1]
      exact ⟨by ring, by ring⟩

    · 
      let τ₀ : ℝ := δ_env / 2
      have hτ₀_pos : 0 < τ₀ := by dsimp [τ₀]; linarith
      have hτ₀_lt_env : τ₀ < δ_env := by dsimp [τ₀]; linarith
      let t₀ : ℝ := τ₀ ^ G.d
      have ht₀_pos : 0 < t₀ := pow_pos hτ₀_pos G.d
      have ht₀_le_τ₀ : t₀ ≤ τ₀ :=
        pow_le_of_le_one hτ₀_pos.le (by dsimp [τ₀]; linarith) hd_ne_zero
      have ht₀_lt_renv : t₀ < r_env :=
        lt_of_le_of_lt ht₀_le_τ₀ (lt_of_lt_of_le hτ₀_lt_env hδ_env_le_renv)
      have hd_C_ne : (G.d : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr hd_ne_zero
      let τ_plus : ℂ → ℂ := fun t => Complex.exp (Complex.log t / (G.d : ℂ))
      have hτ_plus_diff : ∀ t ∈ Complex.slitPlane, DifferentiableAt ℂ τ_plus t :=
        fun t ht => ((Complex.differentiableAt_log ht).div_const (G.d : ℂ)).cexp
      have hτ_plus_pow : ∀ t ∈ Complex.slitPlane, (τ_plus t) ^ G.d = t := by
        intro t ht
        dsimp only [τ_plus]
        rw [← Complex.exp_nat_mul, mul_div_cancel₀ _ hd_C_ne]
        have ht_ne : t ≠ 0 := by
          rintro rfl
          simp [Complex.mem_slitPlane_iff] at ht
        exact Complex.exp_log ht_ne
      have hτ_plus_t₀ : τ_plus (t₀ : ℂ) = (τ₀ : ℂ) := by
        dsimp only [τ_plus]
        rw [← Complex.ofReal_log ht₀_pos.le]
        dsimp only [t₀]
        rw [Real.log_pow, Complex.ofReal_mul, Complex.ofReal_natCast,
          mul_div_cancel_left₀ _ hd_C_ne, ← Complex.ofReal_exp, Real.exp_log hτ₀_pos]
      have ht₀_slit : (t₀ : ℂ) ∈ Complex.slitPlane :=
        Complex.ofReal_mem_slitPlane.mpr ht₀_pos
      have hpt_t₀_renv : (s₁', (t₀ : ℂ)) ∈ Metric.ball s₁' r_env ×ˢ Metric.ball (0 : ℂ) r_env := by
        refine ⟨Metric.mem_ball_self hr_env_pos, ?_⟩
        rw [Metric.mem_ball, dist_zero_right, Complex.norm_real, Real.norm_eq_abs,
          abs_of_pos ht₀_pos]
        exact ht₀_lt_renv
      have hp₀_V_env : (s₁', (τ₀ : ℂ)) ∈ V_env := by
        refine ⟨Metric.mem_ball_self hδ_env_pos, ?_, Complex.ofReal_ne_zero.mpr hτ₀_pos.ne'⟩
        rw [Metric.mem_ball, dist_zero_right, Complex.norm_real, Real.norm_eq_abs,
          abs_of_pos hτ₀_pos]
        exact hτ₀_lt_env
      let liftMap : ℂ × ℂ → ℂ × ℂ := fun q => (q.1, τ_plus q.2)
      have hlift_pt : liftMap (s₁', (t₀ : ℂ)) = (s₁', (τ₀ : ℂ)) :=
        Prod.ext rfl hτ_plus_t₀
      have hlift_cont : ContinuousAt liftMap (s₁', (t₀ : ℂ)) :=
        continuousAt_fst.prodMk
          (ContinuousAt.comp (g := τ_plus) (f := Prod.snd)
            (hτ_plus_diff (t₀ : ℂ) ht₀_slit).continuousAt continuousAt_snd)
      have hplus_nhds :
          (Metric.ball s₁' r_env ×ˢ Metric.ball (0 : ℂ) r_env) ∩
            (Set.univ ×ˢ Complex.slitPlane) ∩
            liftMap ⁻¹' V_env ∈ nhds (s₁', (t₀ : ℂ)) :=
        Filter.inter_mem
          (Filter.inter_mem
            ((Metric.isOpen_ball.prod Metric.isOpen_ball).mem_nhds hpt_t₀_renv)
            ((isOpen_univ.prod Complex.isOpen_slitPlane).mem_nhds ⟨trivial, ht₀_slit⟩))
          (hlift_cont.preimage_mem_nhds (hlift_pt.symm ▸ hV_env_open.mem_nhds hp₀_V_env))
      obtain ⟨r_plus, hr_plus_pos, hr_plus_sub⟩ := Metric.mem_nhds_iff.mp hplus_nhds
      let B_plus : Set (ℂ × ℂ) := Metric.ball (s₁', (t₀ : ℂ)) r_plus
      have hB_plus_open : IsOpen B_plus := Metric.isOpen_ball
      have hB_plus_sub_renv : B_plus ⊆ Metric.ball s₁' r_env ×ˢ Metric.ball (0 : ℂ) r_env :=
        fun q hq => ((hr_plus_sub hq).1).1
      have hB_plus_slit : ∀ q ∈ B_plus, q.2 ∈ Complex.slitPlane :=
        fun q hq => (((hr_plus_sub hq).1).2).2
      have hB_plus_lift_V : ∀ q ∈ B_plus, liftMap q ∈ V_env :=
        fun q hq => (hr_plus_sub hq).2

      let F_cand : Fin 2 → ℂ × ℂ → ℂ := fun ι q => G.M_puis ι (liftMap q)
      have hlift_holo : DifferentiableOn ℂ liftMap B_plus := by
        intro q hq
        exact (differentiableAt_fst.prodMk
          ((hτ_plus_diff q.2 (hB_plus_slit q hq)).comp q differentiableAt_snd)).differentiableWithinAt
      have hF_cand_holo : ∀ ι : Fin 2, DifferentiableOn ℂ (F_cand ι) B_plus :=
        fun ι => (G.M_puis_holo ι).comp hlift_holo
          (fun q hq => hV_env_sub_G (hB_plus_lift_V q hq))
      have hL₀_lift_eq : ∀ q ∈ B_plus, ∀ ι : Fin 2,
          dualLineShift C 0 ι q = puisDualLine0 C G.d ι (liftMap q) := by
        intro q hq ι
        change dualLineShift C 0 ι (q.1, q.2) =
          dualLineShift C 0 ι (q.1, (τ_plus q.2) ^ G.d)
        rw [hτ_plus_pow q.2 (hB_plus_slit q hq)]
      let W_cand : Fin 3 → ℂ × ℂ → ℂ := homIntersect (dualLineShift C 0) F_cand
      have hW_cand_eq : ∀ q ∈ B_plus, ∀ k : Fin 3, W_cand k q = W₁ k (liftMap q) := by
        intro q hq k
        fin_cases k <;>
          simp only [W_cand, W₁, homIntersect, F_cand, hL₀_lift_eq q hq 0, hL₀_lift_eq q hq 1]
      have hF_cand_eq_L1 : ∀ q ∈ B_plus, ∀ ι : Fin 2, F_cand ι q = dualLineShift C 1 ι q := by
        refine hEnv_uniq B_plus F_cand hB_plus_open hB_plus_sub_renv hF_cand_holo (fun q hq => ?_)
        let p_q : ℂ × ℂ := liftMap q
        have hp_q_V : p_q ∈ V_env := hB_plus_lift_V q hq
        have hp_q_env : p_q ∈ B_env := ⟨hp_q_V.1, hp_q_V.2.1⟩
        have hp_q_Bb : p_q ∈ B_b := hB_env_sub_Bb hp_q_env
        have hpow_pq : powMap p_q = q :=
          Prod.ext rfl (hτ_plus_pow q.2 (hB_plus_slit q hq))
        obtain ⟨hW1_2_ne, hW1_vals⟩ := hW₁_rel p_q hp_q_Bb hp_q_V.2.2
        have hZ_pq : ∀ ι : Fin 2,
            Z_zero ι (σ p_q) = glancingImpact C (q.1 + q.2 / 2) q.2 ι := by
          intro ι
          rw [hBoundary (σ p_q) (hσ_maps_a p_q hp_q_Bb) ι,
            h_eq_plus p_q hp_q_env, hpow_pq]
          exact congr_fun (hs_pm_props q (hB_plus_sub_renv hq)).2.2.2 ι
        have hWc_2_ne : W_cand 2 q ≠ 0 := by
          rw [hW_cand_eq q hq 2]; exact hW1_2_ne
        have hWc_0 : W_cand 0 q = W_cand 2 q * glancingImpact C (q.1 + q.2 / 2) q.2 0 := by
          rw [hW_cand_eq q hq 0, hW_cand_eq q hq 2, ← hZ_pq 0]
          exact hW1_vals 0
        have hWc_1 : W_cand 1 q = W_cand 2 q * glancingImpact C (q.1 + q.2 / 2) q.2 1 := by
          rw [hW_cand_eq q hq 1, hW_cand_eq q hq 2, ← hZ_pq 1]
          exact hW1_vals 1
        have hWc_deriv_y : ∀ k : Fin 3,
            iterDerivYT 1 0 (W_cand k) q = iterDerivYT 1 0 (W₁ k) p_q := by
          intro k
          change deriv (fun y' : ℂ => W_cand k (y', q.2)) q.1 =
            deriv (fun y' : ℂ => W₁ k (y', τ_plus q.2)) q.1
          have hemb_cont : Continuous (fun y' : ℂ => (y', q.2)) :=
            continuous_id.prodMk continuous_const
          have hev : (fun y' : ℂ => W_cand k (y', q.2)) =ᶠ[nhds q.1]
              (fun y' : ℂ => W₁ k (y', τ_plus q.2)) := by
            filter_upwards [(hB_plus_open.preimage hemb_cont).mem_nhds hq] with y' hy'
            exact hW_cand_eq (y', q.2) hy' k
          exact hev.deriv_eq
        refine ⟨hWc_2_ne, hWc_0, hWc_1, fun ι => ?_⟩
        change W_cand 2 q * homReflectOut (dualLineShift C 0) W_cand ι q -
            (homReflectOut (dualLineShift C 0) W_cand 0 q * W_cand 0 q +
              homReflectOut (dualLineShift C 0) W_cand 1 q * W_cand 1 q) * F_cand ι q = 0
        have hOut_eq : ∀ j : Fin 2,
            homReflectOut (dualLineShift C 0) W_cand j q =
              homReflectOut (puisDualLine0 C G.d) W₁ j p_q := by
          intro j
          dsimp only [homReflectOut]
          rw [hW_cand_eq q hq 0, hW_cand_eq q hq 1, hW_cand_eq q hq 2,
            hWc_deriv_y 0, hWc_deriv_y 1, hWc_deriv_y 2,
            hL₀_lift_eq q hq 0, hL₀_lift_eq q hq 1, hL₀_lift_eq q hq j]
        rw [hW_cand_eq q hq 0, hW_cand_eq q hq 1, hW_cand_eq q hq 2,
          hOut_eq 0, hOut_eq 1, hOut_eq ι]
        exact G.puis_reflect p_q (hV_env_sub_G hp_q_V) ι

      let p₀ : ℂ × ℂ := (s₁', (τ₀ : ℂ))
      have hτ₀_slit : (τ₀ : ℂ) ∈ Complex.slitPlane :=
        Complex.ofReal_mem_slitPlane.mpr hτ₀_pos
      let imLogMap : ℂ × ℂ → ℝ := fun p => ((G.d : ℂ) * Complex.log p.2).im
      have himLog_p₀ : imLogMap p₀ ∈ Set.Ioo (-Real.pi) Real.pi := by
        dsimp only [imLogMap, p₀]
        rw [← Complex.ofReal_log hτ₀_pos.le, ← Complex.ofReal_natCast, ← Complex.ofReal_mul,
          Complex.ofReal_im]
        exact ⟨by linarith [Real.pi_pos], Real.pi_pos⟩
      have himLog_cont : ContinuousAt imLogMap p₀ := by
        have hlog_snd : ContinuousAt (fun p : ℂ × ℂ => Complex.log p.2) p₀ :=
          ContinuousAt.comp (g := Complex.log) (f := Prod.snd)
            (Complex.differentiableAt_log hτ₀_slit).continuousAt continuousAt_snd
        exact Complex.continuous_im.continuousAt.comp (continuousAt_const.mul hlog_snd)
      have hpow_p₀ : powMap p₀ ∈ B_plus := by
        have heq : powMap p₀ = (s₁', (t₀ : ℂ)) := by
          refine Prod.ext rfl ?_
          dsimp only [powMap, p₀, t₀]
          exact (Complex.ofReal_pow τ₀ G.d).symm
        rw [heq]
        exact Metric.mem_ball_self hr_plus_pos
      have hV_plus_nhds :
          V_env ∩ (Set.univ ×ˢ Complex.slitPlane) ∩
            imLogMap ⁻¹' (Set.Ioo (-Real.pi) Real.pi) ∩
            powMap ⁻¹' B_plus ∈ nhds p₀ :=
        Filter.inter_mem
          (Filter.inter_mem
            (Filter.inter_mem
              (hV_env_open.mem_nhds hp₀_V_env)
              ((isOpen_univ.prod Complex.isOpen_slitPlane).mem_nhds ⟨trivial, hτ₀_slit⟩))
            (himLog_cont.preimage_mem_nhds (isOpen_Ioo.mem_nhds himLog_p₀)))
          (hpowMap_diff.continuous.continuousAt.preimage_mem_nhds
            (hB_plus_open.mem_nhds hpow_p₀))
      obtain ⟨r_vp, hr_vp_pos, hr_vp_sub⟩ := Metric.mem_nhds_iff.mp hV_plus_nhds
      let V_plus : Set (ℂ × ℂ) := Metric.ball p₀ r_vp
      have hVp_sub_V_env : V_plus ⊆ V_env := fun p hp => (((hr_vp_sub hp).1).1).1
      refine G.not_primary V_plus Metric.isOpen_ball ⟨p₀, Metric.mem_ball_self hr_vp_pos⟩
        (Set.Subset.trans hVp_sub_V_env hV_env_sub_G) (fun p hp ι => ?_)
      have hp_slit : p.2 ∈ Complex.slitPlane := ((((hr_vp_sub hp).1).1).2).2
      have hp_im : imLogMap p ∈ Set.Ioo (-Real.pi) Real.pi := ((hr_vp_sub hp).1).2
      have hp_pow : powMap p ∈ B_plus := (hr_vp_sub hp).2
      have hp2_ne : p.2 ≠ 0 := (hVp_sub_V_env hp).2.2
      have hτ_inv : τ_plus (p.2 ^ G.d) = p.2 := by
        have hpow_exp : p.2 ^ G.d = Complex.exp ((G.d : ℂ) * Complex.log p.2) := by
          rw [Complex.exp_nat_mul, Complex.exp_log hp2_ne]
        dsimp only [τ_plus]
        rw [hpow_exp, Complex.log_exp hp_im.1 (le_of_lt hp_im.2),
          mul_div_cancel_left₀ _ hd_C_ne, Complex.exp_log hp2_ne]
      have hlift_pow : liftMap (powMap p) = p := Prod.ext rfl hτ_inv
      have hcand := hF_cand_eq_L1 (powMap p) hp_pow ι
      dsimp only [F_cand] at hcand
      rwa [hlift_pow] at hcand

  
  
  
  let F_iso : ℂ → ℂ := fun z => (deriv (Z_zero 0) z) ^ 2 + (deriv (Z_zero 1) z) ^ 2
  let F_tr : ℂ → ℂ := fun z =>
    dualLineShift C 0 0 (z, 0) * deriv (Z_zero 0) z +
      dualLineShift C 0 1 (z, 0) * deriv (Z_zero 1) z
  let H_good : ℂ → ℂ := fun z => F_iso z * F_tr z

  have hZ0_deriv_holo : ∀ ι : Fin 2, DifferentiableOn ℂ (deriv (Z_zero ι)) U_a :=
    fun ι => ((hZ0_holo ι).deriv Metric.isOpen_ball).mono hUa_sub_U₁
  have hL₀_slice_holo : ∀ ι : Fin 2,
      DifferentiableOn ℂ (fun z : ℂ => dualLineShift C 0 ι (z, 0)) U_a := by
    intro ι
    have hfn : (fun z : ℂ => dualLineShift C 0 ι (z, 0)) =
        (fun w : ℂ × ℂ => glancingDualLine C w.1 w.2 ι) ∘ (fun z : ℂ => (z, (0 : ℂ))) := by
      ext z
      change glancingDualLine C (z + ((0 : ℤ) : ℂ) * 0) 0 ι = glancingDualLine C z 0 ι
      simp
    rw [hfn]
    have hemb : Differentiable ℂ (fun z : ℂ => (z, (0 : ℂ))) :=
      differentiable_id.prodMk (differentiable_const 0)
    refine (hDet.dualLine_holo ι).comp hemb.differentiableOn (fun z hz => ⟨?_, ?_⟩)
    · exact hU₁_det z (hUa_sub_U₁ hz)
    · rw [norm_zero]; linarith [hDet.r_det_pos]
  have hF_iso_holo : DifferentiableOn ℂ F_iso U_a :=
    ((hZ0_deriv_holo 0).pow 2).add ((hZ0_deriv_holo 1).pow 2)
  have hF_tr_holo : DifferentiableOn ℂ F_tr U_a :=
    ((hL₀_slice_holo 0).mul (hZ0_deriv_holo 0)).add
      ((hL₀_slice_holo 1).mul (hZ0_deriv_holo 1))
  have hH_good_holo : DifferentiableOn ℂ H_good U_a :=
    hF_iso_holo.mul hF_tr_holo

  have hH_good_witness : ∃ z_star ∈ U_a, H_good z_star ≠ 0 := by
    by_contra hAll0
    have hAll0' : ∀ z ∈ U_a, H_good z = 0 :=
      fun z hz => by_contra fun hne => hAll0 ⟨z, hz, hne⟩
    obtain ⟨z_iso, hz_iso_mem, hz_iso_nz⟩ := h_iso_witness
    obtain ⟨z_tr, hz_tr_mem, hz_tr_nz⟩ := h_tr_witness
    have hF_iso_cont : ContinuousAt F_iso z_iso :=
      hF_iso_holo.continuousOn.continuousAt (Metric.isOpen_ball.mem_nhds hz_iso_mem)
    have hF_tr_ana : AnalyticOnNhd ℂ F_tr U_a :=
      (Complex.analyticOnNhd_iff_differentiableOn Metric.isOpen_ball).mpr hF_tr_holo
    have hev_tr0 : F_tr =ᶠ[nhds z_iso] 0 := by
      filter_upwards [Metric.isOpen_ball.mem_nhds hz_iso_mem,
        hF_iso_cont.eventually_ne hz_iso_nz] with z hz hne
      exact (mul_eq_zero.mp (hAll0' z hz)).resolve_left hne
    have htr_z := hF_tr_ana.eqOn_zero_of_preconnected_of_eventuallyEq_zero
      (convex_ball s₁' δ_a).isPreconnected hz_iso_mem hev_tr0 hz_tr_mem
    exact hz_tr_nz htr_z

  let δ_s : ℝ := δ_b / 2
  have hδ_s_pos : 0 < δ_s := by dsimp [δ_s]; linarith
  have hδ_s_le_a : δ_s ≤ δ_a := by dsimp [δ_s]; linarith
  obtain ⟨y₂, hy₂_Ioo, hH_y₂_nz⟩ :=
    h_real_witness y₁' δ_a δ_s H_good hδ_a_pos hδ_s_pos hδ_s_le_a hH_good_holo hH_good_witness
  obtain ⟨hZ0_noniso_y₂, hZ0_trans_y₂⟩ := mul_ne_zero_iff.mp hH_y₂_nz

  have hy₂_abs : |y₂ - y₁'| < δ_b / 2 :=
    abs_lt.mpr ⟨by dsimp [δ_s] at hy₂_Ioo; linarith [hy₂_Ioo.1],
      by dsimp [δ_s] at hy₂_Ioo; linarith [hy₂_Ioo.2]⟩
  have hball_y₂_sub_b : Metric.ball (y₂ : ℂ) δ_s ⊆ Metric.ball s₁' δ_b := by
    intro z hz
    rw [Metric.mem_ball, dist_eq_norm] at hz ⊢
    have hdiff : ‖(y₂ : ℂ) - s₁'‖ = |y₂ - y₁'| := by
      dsimp [s₁']
      rw [← Complex.ofReal_sub, Complex.norm_real, Real.norm_eq_abs]
    have htri : ‖z - s₁'‖ ≤ ‖z - (y₂ : ℂ)‖ + ‖(y₂ : ℂ) - s₁'‖ := by
      simpa using norm_add_le (z - (y₂ : ℂ)) ((y₂ : ℂ) - s₁')
    dsimp [δ_s] at hz
    linarith
  have hball_y₂_s_sub : Metric.ball (y₂ : ℂ) δ_s ⊆ U₁ :=
    Set.Subset.trans hball_y₂_sub_b
      (Set.Subset.trans (Metric.ball_subset_ball hδ_b_le_a) hUa_sub_U₁)

  let q₂ : ℂ × ℂ := ((y₂ : ℂ), (0 : ℂ))
  have hy₂_in_b : (y₂ : ℂ) ∈ Metric.ball s₁' δ_b :=
    hball_y₂_sub_b (Metric.mem_ball_self hδ_s_pos)
  have hq₂_Bb : q₂ ∈ B_b := ⟨hy₂_in_b, Metric.mem_ball_self hδ_b_pos⟩
  have hσ_q₂ : σ q₂ = (y₂ : ℂ) := hσ_zero_b (y₂ : ℂ) hy₂_in_b
  have hpderivA_σ_q₂ : pderivA σ q₂ = 1 := by
    change deriv (fun z : ℂ => σ (z, 0)) (y₂ : ℂ) = 1
    have hev : (fun z : ℂ => σ (z, 0)) =ᶠ[nhds (y₂ : ℂ)] (fun z : ℂ => z) := by
      filter_upwards [Metric.isOpen_ball.mem_nhds hy₂_in_b] with z hz
      exact hσ_zero_b z hz
    rw [hev.deriv_eq, deriv_id'']
  have hpderivA_σ_holo : DifferentiableOn ℂ (pderivA σ) B_b :=
    (hKit.pderiv_holo hBb_open hσ_holo_b).1
  have hσ_cont_q₂ : ContinuousAt σ q₂ :=
    hσ_holo_b.continuousOn.continuousAt (hBb_open.mem_nhds hq₂_Bb)
  have hpderivA_cont_q₂ : ContinuousAt (pderivA σ) q₂ :=
    hpderivA_σ_holo.continuousOn.continuousAt (hBb_open.mem_nhds hq₂_Bb)
  have hq₂_nhds :
      B_b ∩ σ ⁻¹' (Metric.ball (y₂ : ℂ) δ_s) ∩ {p : ℂ × ℂ | pderivA σ p ≠ 0} ∈ nhds q₂ :=
    Filter.inter_mem
      (Filter.inter_mem (hBb_open.mem_nhds hq₂_Bb)
        (hσ_cont_q₂.preimage_mem_nhds (hσ_q₂.symm ▸ Metric.ball_mem_nhds (y₂ : ℂ) hδ_s_pos)))
      (hpderivA_cont_q₂.eventually_ne (by rw [hpderivA_σ_q₂]; exact one_ne_zero))
  obtain ⟨r_σ2, hr_σ2_pos, hr_σ2_sub⟩ := Metric.mem_nhds_iff.mp hq₂_nhds
  let δ₂ : ℝ := min r_σ2 δ_s
  have hδ₂_pos : 0 < δ₂ := lt_min hr_σ2_pos hδ_s_pos
  have hδ₂_le_s : δ₂ ≤ δ_s := min_le_right _ _
  have hδ₂_le_ρ₁ : δ₂ ≤ R.ρ₁ := by
    dsimp [ρ'] at hδ_a_le_ρ'
    linarith [hδ₂_le_s, hδ_s_le_a, hδ_a_le_ρ', R.ρ₁_pos]
  let B₂ : Set (ℂ × ℂ) := Metric.ball (y₂ : ℂ) δ₂ ×ˢ Metric.ball (0 : ℂ) δ₂
  have hB₂_sub_rσ2 : B₂ ⊆ Metric.ball q₂ r_σ2 := by
    dsimp only [B₂, q₂]
    rw [ball_prod_same]
    exact Metric.ball_subset_ball (min_le_left _ _)
  have hB₂_sub_Bb : B₂ ⊆ B_b := fun p hp => ((hr_σ2_sub (hB₂_sub_rσ2 hp)).1).1

  exact ⟨{
    y₂ := y₂
    δ_s := δ_s
    δ₂ := δ₂
    δ_s_pos := hδ_s_pos
    δ₂_pos := hδ₂_pos
    δ₂_le_s := hδ₂_le_s
    ball_y₂_s_sub := hball_y₂_s_sub
    δ₂_le_ρ₁ := hδ₂_le_ρ₁
    Z_zero := Z_zero
    σ := σ
    Z_zero_holo := fun ι => (hZ0_holo ι).mono hball_y₂_s_sub
    Z_zero_incidence_zero := fun s hs => hZ0_inc s (hball_y₂_s_sub hs)
    Z_zero_nonisotropic_at := hZ0_noniso_y₂
    Z_zero_transverse_at := hZ0_trans_y₂
    σ_holo := hσ_holo_b.mono hB₂_sub_Bb
    σ_maps_to := fun p hp => ((hr_σ2_sub (hB₂_sub_rσ2 hp)).1).2
    σ_at_zero := fun y hy => hσ_zero_b y (hball_y₂_sub_b (Metric.ball_subset_ball hδ₂_le_s hy))
    σ_pderivA_ne_zero := fun p hp => (hr_σ2_sub (hB₂_sub_rσ2 hp)).2
    Z_eq_comp_σ := fun ι p hp => hZ_comp_b ι p (hB₂_sub_Bb hp)
  }⟩

theorem puiseux_wronskian_compact_annulus_evenness (Ω : Set Plane)
    (C : AnalyticGlancingCollar Ω)
    (hDet : EndpointDeterminationData C)
    (W : CollarWidthTubeData C hDet)
    (hKit : Holo2DAndTaylorToolkit)
    (t₂ : ℝ)
    (D_wall : AlignedWallDefectData W t₂)
    (N_idx : ℕ)
    (q_idx : Fin N_idx → ℤ)
    (B_col : BaseCollarBilliardData C hDet)
    (Br : PuncturedGlancingBridgeData W t₂ D_wall q_idx) :
    Nonempty (CompactAnnulusEvenData W t₂ D_wall q_idx Br) :=
by
  have hSepCont : SeparableRectRootContProp := separable_poly_rect_root_continuation
  obtain ⟨B_cr⟩ := base_collar_and_cramer_data Ω C
  obtain ⟨G⟩ :=
    puiseux_log_cover_and_removable_germ Ω C hDet W hKit hSepCont t₂ D_wall N_idx q_idx B_col Br
  obtain ⟨R⟩ := wronskian_tau_reduction_and_regular_slice Ω C hDet W hKit t₂ D_wall N_idx q_idx Br G
  obtain ⟨T⟩ :=
    rank_one_arc_factorization_and_transversality Ω C hDet W hKit B_cr t₂ D_wall N_idx q_idx
      B_col Br G R

  
  let s₀ : ℂ := (T.y₂ : ℂ)
  let q₀ : ℂ × ℂ := (s₀, (0 : ℂ))
  let U_col : Set (ℂ × ℂ) := Metric.ball s₀ T.δ_s ×ˢ Metric.ball (0 : ℂ) Br.r_t
  have hU_col_open : IsOpen U_col := Metric.isOpen_ball.prod Metric.isOpen_ball
  have h_ball_s_yp : Metric.ball s₀ T.δ_s ⊆ Metric.ball (Br.y₀ : ℂ) G.r_yp :=
    Set.Subset.trans T.ball_y₂_s_sub R.ball_y₁_sub
  have h_ball_s_ry : Metric.ball s₀ T.δ_s ⊆ Metric.ball (Br.y₀ : ℂ) Br.r_y :=
    Set.Subset.trans h_ball_s_yp (Metric.ball_subset_ball (by linarith [G.r_yp_le, Br.r_y_pos]))
  have hU_col_sub_dom : U_col ⊆ symCollarDom W.s_base W.r_base q_idx :=
    Set.Subset.trans (Set.prod_mono h_ball_s_ry Set.Subset.rfl) Br.bidisk_sub_dom
  have hDom_bounds : ∀ q ∈ symCollarDom W.s_base W.r_base q_idx,
      |q.1.im| < 2 * hDet.s_det ∧ ‖q.2‖ < 2 * hDet.r_det := by
    intro q hq
    exact ⟨by linarith [hq.1, W.s_base_le_det, hDet.s_det_pos],
      by linarith [hq.2.1, W.r_base_le_det, hDet.r_det_pos]⟩
  let L₀ : Fin 2 → ℂ × ℂ → ℂ := dualLineShift C 0
  have hL₀_eq : ∀ (ι : Fin 2) (q : ℂ × ℂ), L₀ ι q = glancingDualLine C q.1 q.2 ι := by
    intro ι q
    change glancingDualLine C (q.1 + ((0 : ℤ) : ℂ) * q.2) q.2 ι = glancingDualLine C q.1 q.2 ι
    have h0 : q.1 + ((0 : ℤ) : ℂ) * q.2 = q.1 := by push_cast; ring
    rw [h0]
  have hL₀_holo : ∀ ι : Fin 2, DifferentiableOn ℂ (L₀ ι) U_col := by
    intro ι
    have hfn : L₀ ι = fun q : ℂ × ℂ => glancingDualLine C q.1 q.2 ι := by
      ext q; exact hL₀_eq ι q
    rw [hfn]
    exact (hDet.dualLine_holo ι).mono (fun q hq => hDom_bounds q (hU_col_sub_dom hq))
  have hL₀_even : ∀ q ∈ U_col, ∀ ι : Fin 2, L₀ ι (q.1, -q.2) = L₀ ι q := by
    intro q hq ι
    rw [hL₀_eq, hL₀_eq]
    have hb := hDom_bounds q (hU_col_sub_dom hq)
    exact B_col.dualLine_even q.1 q.2 hb.1 hb.2 ι
  have hq₀_mem_U_col : q₀ ∈ U_col :=
    ⟨Metric.mem_ball_self T.δ_s_pos, Metric.mem_ball_self Br.r_t_pos⟩
  have hL₀_sq_ne_zero : (L₀ 0 q₀) ^ 2 + (L₀ 1 q₀) ^ 2 ≠ 0 := by
    rw [hL₀_eq, hL₀_eq]
    have hs₀_im : |s₀.im| < 2 * W.s_base := by
      simp only [s₀, Complex.ofReal_im, abs_zero]
      linarith [W.s_base_pos]
    have h0_norm : ‖(0 : ℂ)‖ < 2 * W.r_base := by
      rw [norm_zero]; linarith [W.r_base_pos]
    have hoff_ne : glancingOffset C s₀ 0 ≠ 0 := W.offset_ne_zero s₀ 0 hs₀_im h0_norm
    have hcs : Complex.cos (glancingTheta C s₀ 0) ^ 2 +
        Complex.sin (glancingTheta C s₀ 0) ^ 2 = 1 :=
      Complex.cos_sq_add_sin_sq (glancingTheta C s₀ 0)
    have hsum :
        (glancingDualLine C s₀ 0 0) ^ 2 + (glancingDualLine C s₀ 0 1) ^ 2 =
          (glancingOffset C s₀ 0 ^ 2)⁻¹ := by
      simp only [glancingDualLine, Matrix.cons_val_zero, Matrix.cons_val_one]
      field_simp [hoff_ne]
      exact hcs
    rw [hsum]
    exact inv_ne_zero (pow_ne_zero 2 hoff_ne)

  
  let π₁ : (ℂ × ℂ) →L[ℂ] ℂ :=
    { toLinearMap :=
        { toFun := Prod.fst
          map_add' := fun _ _ => rfl
          map_smul' := fun _ _ => rfl }
      cont := continuous_fst }
  let π₂ : (ℂ × ℂ) →L[ℂ] ℂ :=
    { toLinearMap :=
        { toFun := Prod.snd
          map_add' := fun _ _ => rfl
          map_smul' := fun _ _ => rfl }
      cont := continuous_snd }
  let j₁ : ℂ →L[ℂ] (ℂ × ℂ) :=
    { toLinearMap :=
        { toFun := fun z => (z, 0)
          map_add' := fun _ _ => Prod.ext rfl (by simp)
          map_smul' := fun _ _ => Prod.ext rfl (by simp) }
      cont := continuous_id.prodMk continuous_const }
  let j₂ : ℂ →L[ℂ] (ℂ × ℂ) :=
    { toLinearMap :=
        { toFun := fun z => (0, z)
          map_add' := fun _ _ => Prod.ext (by simp) rfl
          map_smul' := fun _ _ => Prod.ext (by simp) rfl }
      cont := continuous_const.prodMk continuous_id }
  have hStrict2D : ∀ (g : ℂ × ℂ → ℂ), DifferentiableOn ℂ g U_col →
      ∀ q_s ∈ U_col,
        HasStrictFDerivAt g (pderivA g q_s • π₁ + pderivD g q_s • π₂) q_s := by
    intro g hg q_s hq_s
    obtain ⟨hpA_holo, hpD_holo⟩ := hKit.pderiv_holo hU_col_open hg
    have hpA_cont : ContinuousAt (pderivA g) q_s :=
      hpA_holo.continuousOn.continuousAt (hU_col_open.mem_nhds hq_s)
    have hpD_cont : ContinuousAt (pderivD g) q_s :=
      hpD_holo.continuousOn.continuousAt (hU_col_open.mem_nhds hq_s)
    have hfderiv_on : ∀ q ∈ U_col,
        HasFDerivAt g (pderivA g q • π₁ + pderivD g q • π₂) q := by
      intro q hq
      have hgd : HasFDerivAt g (fderiv ℂ g q) q :=
        (hg.differentiableAt (hU_col_open.mem_nhds hq)).hasFDerivAt
      have hι₁ : HasDerivAt (fun z : ℂ => (z, q.2)) (1, 0) q.1 := by
        simpa [j₁] using (j₁.hasDerivAt (x := q.1)).add_const ((0 : ℂ), q.2)
      have hι₂ : HasDerivAt (fun z : ℂ => (q.1, z)) (0, 1) q.2 := by
        simpa [j₂] using (j₂.hasDerivAt (x := q.2)).add_const (q.1, (0 : ℂ))
      have hpA : pderivA g q = (fderiv ℂ g q) (1, 0) :=
        (hgd.comp_hasDerivAt q.1 hι₁).deriv
      have hpD : pderivD g q = (fderiv ℂ g q) (0, 1) :=
        (hgd.comp_hasDerivAt q.2 hι₂).deriv
      have hu_decomp : ∀ u : ℂ × ℂ,
          u = u.1 • ((1 : ℂ), (0 : ℂ)) + u.2 • ((0 : ℂ), (1 : ℂ)) := by
        intro u
        refine Prod.ext ?_ ?_
        · change u.1 = u.1 * 1 + u.2 * 0; ring
        · change u.2 = u.1 * 0 + u.2 * 1; ring
      have h_eq : fderiv ℂ g q = pderivA g q • π₁ + pderivD g q • π₂ := by
        refine ContinuousLinearMap.ext (fun u => ?_)
        conv_lhs => rw [hu_decomp u]
        rw [map_add, map_smul, map_smul, ← hpA, ← hpD]
        change u.1 * pderivA g q + u.2 * pderivD g q =
          pderivA g q * u.1 + pderivD g q * u.2
        ring
      rwa [← h_eq]
    have h_ev : ∀ᶠ q in nhds q_s, HasFDerivAt g (pderivA g q • π₁ + pderivD g q • π₂) q :=
      Filter.eventually_of_mem (hU_col_open.mem_nhds hq_s) hfderiv_on
    have h_cont : ContinuousAt (fun q => pderivA g q • π₁ + pderivD g q • π₂) q_s :=
      (hpA_cont.smul continuousAt_const).add (hpD_cont.smul continuousAt_const)
    exact hasStrictFDerivAt_of_hasFDerivAt_of_continuousAt h_ev h_cont

  let p_q : ((ℂ × ℂ) × ℂ) →L[ℂ] (ℂ × ℂ) :=
    { toLinearMap :=
        { toFun := Prod.fst
          map_add' := fun _ _ => rfl
          map_smul' := fun _ _ => rfl }
      cont := continuous_fst }
  let p_z : ((ℂ × ℂ) × ℂ) →L[ℂ] ℂ :=
    { toLinearMap :=
        { toFun := Prod.snd
          map_add' := fun _ _ => rfl
          map_smul' := fun _ _ => rfl }
      cont := continuous_snd }
  let ι₀_CLM : (ℂ × ℂ) →L[ℂ] ((ℂ × ℂ) × ℂ) :=
    { toLinearMap :=
        { toFun := fun q => (q, 0)
          map_add' := fun _ _ => Prod.ext rfl (by simp)
          map_smul' := fun _ _ => Prod.ext rfl (by simp) }
      cont := continuous_id.prodMk continuous_const }
  let F_inc : ℂ × ℂ → ℂ → ℂ :=
    fun q s => L₀ 0 q * T.Z_zero 0 s + L₀ 1 q * T.Z_zero 1 s - 1
  let Fz_inc : ℂ × ℂ → ℂ → ℂ :=
    fun q s => L₀ 0 q * deriv (T.Z_zero 0) s + L₀ 1 q * deriv (T.Z_zero 1) s
  let Φ_fn : (ℂ × ℂ) × ℂ → (ℂ × ℂ) × ℂ := fun x => (x.1, F_inc x.1 x.2)
  have hZ_zero_deriv_holo : ∀ ι : Fin 2,
      DifferentiableOn ℂ (deriv (T.Z_zero ι)) (Metric.ball s₀ T.δ_s) :=
    fun ι => (T.Z_zero_holo ι).deriv Metric.isOpen_ball
  have hΦ_strict : ∀ q ∈ U_col, ∀ s ∈ Metric.ball s₀ T.δ_s, Fz_inc q s ≠ 0 →
      ∃ L_Φ : ((ℂ × ℂ) × ℂ) ≃L[ℂ] ((ℂ × ℂ) × ℂ),
        HasStrictFDerivAt Φ_fn (L_Φ : ((ℂ × ℂ) × ℂ) →L[ℂ] ((ℂ × ℂ) × ℂ)) (q, s) := by
    intro q hq s hs hlam
    let dL₀ : Fin 2 → (ℂ × ℂ) →L[ℂ] ℂ :=
      fun ι => pderivA (L₀ ι) q • π₁ + pderivD (L₀ ι) q • π₂
    let L_q : (ℂ × ℂ) →L[ℂ] ℂ := T.Z_zero 0 s • dL₀ 0 + T.Z_zero 1 s • dL₀ 1
    let lam : ℂ := Fz_inc q s
    let L_Φ : ((ℂ × ℂ) × ℂ) ≃L[ℂ] ((ℂ × ℂ) × ℂ) :=
      ContinuousLinearEquiv.mk
        { toFun := fun x => (x.1, L_q x.1 + lam * x.2)
          invFun := fun y => (y.1, lam⁻¹ * (y.2 - L_q y.1))
          left_inv := fun ⟨u, w⟩ =>
            Prod.ext rfl (by dsimp; rw [add_sub_cancel_left, inv_mul_cancel_left₀ hlam])
          right_inv := fun ⟨u, v⟩ =>
            Prod.ext rfl (by dsimp; rw [mul_inv_cancel_left₀ hlam, add_sub_cancel])
          map_add' := fun ⟨u₁, w₁⟩ ⟨u₂, w₂⟩ =>
            Prod.ext rfl (by dsimp; rw [map_add]; ring)
          map_smul' := fun c ⟨u, w⟩ =>
            Prod.ext rfl (by
              change L_q (c • u) + lam * (c * w) = c * (L_q u + lam * w)
              rw [map_smul, smul_eq_mul]
              ring) }
        (continuous_fst.prodMk
          ((L_q.continuous.comp continuous_fst).add (continuous_const.mul continuous_snd)))
        (continuous_fst.prodMk
          (continuous_const.mul (continuous_snd.sub (L_q.continuous.comp continuous_fst))))
    have hL_st : ∀ ι : Fin 2,
        HasStrictFDerivAt (fun x : (ℂ × ℂ) × ℂ => L₀ ι x.1)
          ((dL₀ ι).comp p_q) (q, s) :=
      fun ι => (hStrict2D (L₀ ι) (hL₀_holo ι) q hq).comp (q, s) (p_q.hasStrictFDerivAt)
    have hZ_st : ∀ ι : Fin 2,
        HasStrictFDerivAt (fun x : (ℂ × ℂ) × ℂ => T.Z_zero ι x.2)
          (deriv (T.Z_zero ι) s • p_z) (q, s) := fun ι =>
      (((T.Z_zero_holo ι).analyticAt (Metric.isOpen_ball.mem_nhds hs)).hasStrictDerivAt).comp_hasStrictFDerivAt
        (q, s) p_z.hasStrictFDerivAt
    have hF_st :=
      (((hL_st 0).mul (hZ_st 0)).add ((hL_st 1).mul (hZ_st 1))).sub
        (hasStrictFDerivAt_const (1 : ℂ) (q, s))
    have hΦ_raw := (p_q.hasStrictFDerivAt (x := (q, s))).prodMk hF_st
    have h_clm_eq :
        p_q.prod
          ((L₀ 0 q • (deriv (T.Z_zero 0) s • p_z) + T.Z_zero 0 s • ((dL₀ 0).comp p_q) +
            (L₀ 1 q • (deriv (T.Z_zero 1) s • p_z) + T.Z_zero 1 s • ((dL₀ 1).comp p_q))) - 0) =
        (L_Φ : ((ℂ × ℂ) × ℂ) →L[ℂ] ((ℂ × ℂ) × ℂ)) := by
      refine ContinuousLinearMap.ext (fun ⟨u, w⟩ => ?_)
      refine Prod.ext rfl ?_
      change (L₀ 0 q * (deriv (T.Z_zero 0) s * w) + T.Z_zero 0 s * dL₀ 0 u +
        (L₀ 1 q * (deriv (T.Z_zero 1) s * w) + T.Z_zero 1 s * dL₀ 1 u)) - 0 =
        (T.Z_zero 0 s * dL₀ 0 u + T.Z_zero 1 s * dL₀ 1 u) +
          (L₀ 0 q * deriv (T.Z_zero 0) s + L₀ 1 q * deriv (T.Z_zero 1) s) * w
      ring
    refine ⟨L_Φ, ?_⟩
    rw [← h_clm_eq]
    exact hΦ_raw

  have hs₀_mem : s₀ ∈ Metric.ball s₀ T.δ_s := Metric.mem_ball_self T.δ_s_pos
  have hF_q₀s₀ : F_inc q₀ s₀ = 0 := by
    dsimp [F_inc, L₀, q₀, s₀]
    rw [T.Z_zero_incidence_zero (T.y₂ : ℂ) hs₀_mem, sub_self]
  have hFz_q₀s₀ : Fz_inc q₀ s₀ ≠ 0 := T.Z_zero_transverse_at
  obtain ⟨L_Φ₀, hf₀⟩ := hΦ_strict q₀ hq₀_mem_U_col s₀ hs₀_mem hFz_q₀s₀
  have hΦ_pt₀ : Φ_fn (q₀, s₀) = (q₀, 0) := Prod.ext rfl hF_q₀s₀
  obtain ⟨e, he_coe, hx_src, hy_tgt⟩ :
      ∃ e : OpenPartialHomeomorph ((ℂ × ℂ) × ℂ) ((ℂ × ℂ) × ℂ),
        (e : (ℂ × ℂ) × ℂ → (ℂ × ℂ) × ℂ) = Φ_fn ∧
        (q₀, s₀) ∈ e.source ∧
        (q₀, (0 : ℂ)) ∈ e.target :=
    ⟨hf₀.toOpenPartialHomeomorph Φ_fn,
     hf₀.toOpenPartialHomeomorph_coe,
     hf₀.mem_toOpenPartialHomeomorph_source,
     hΦ_pt₀ ▸ hf₀.image_mem_toOpenPartialHomeomorph_target⟩
  have he_symm_pt : e.symm (q₀, 0) = (q₀, s₀) := by
    have h_eq : e (q₀, s₀) = (q₀, 0) := by rw [he_coe]; exact hΦ_pt₀
    rw [← h_eq]
    exact e.left_inv hx_src
  have hFz_cont : ContinuousOn (fun x : (ℂ × ℂ) × ℂ => Fz_inc x.1 x.2)
      (U_col ×ˢ Metric.ball s₀ T.δ_s) := by
    have hL0c : ContinuousOn (fun x : (ℂ × ℂ) × ℂ => L₀ 0 x.1) (U_col ×ˢ Metric.ball s₀ T.δ_s) :=
      (hL₀_holo 0).continuousOn.comp continuousOn_fst (fun _ hx => hx.1)
    have hL1c : ContinuousOn (fun x : (ℂ × ℂ) × ℂ => L₀ 1 x.1) (U_col ×ˢ Metric.ball s₀ T.δ_s) :=
      (hL₀_holo 1).continuousOn.comp continuousOn_fst (fun _ hx => hx.1)
    have hZ0c : ContinuousOn (fun x : (ℂ × ℂ) × ℂ => deriv (T.Z_zero 0) x.2)
        (U_col ×ˢ Metric.ball s₀ T.δ_s) :=
      (hZ_zero_deriv_holo 0).continuousOn.comp continuousOn_snd (fun _ hx => hx.2)
    have hZ1c : ContinuousOn (fun x : (ℂ × ℂ) × ℂ => deriv (T.Z_zero 1) x.2)
        (U_col ×ˢ Metric.ball s₀ T.δ_s) :=
      (hZ_zero_deriv_holo 1).continuousOn.comp continuousOn_snd (fun _ hx => hx.2)
    exact (hL0c.mul hZ0c).add (hL1c.mul hZ1c)
  let O_src : Set ((ℂ × ℂ) × ℂ) :=
    ((U_col ×ˢ Metric.ball s₀ T.δ_s) ∩ (fun x => Fz_inc x.1 x.2) ⁻¹' {(0 : ℂ)}ᶜ) ∩ e.source
  have hO_src_open : IsOpen O_src :=
    (hFz_cont.isOpen_inter_preimage (hU_col_open.prod Metric.isOpen_ball)
      isOpen_compl_singleton).inter e.open_source
  obtain ⟨δ_src, hδ_src_pos, hδ_src_sub⟩ :=
    Metric.isOpen_iff.mp hO_src_open (q₀, s₀) ⟨⟨⟨hq₀_mem_U_col, hs₀_mem⟩, hFz_q₀s₀⟩, hx_src⟩
  let δ'_s : ℝ := min δ_src T.δ_s
  have hδ'_s_pos : 0 < δ'_s := lt_min hδ_src_pos T.δ_s_pos
  have hδ'_s_le : δ'_s ≤ T.δ_s := min_le_right _ _
  have hδ'_s_sub : Metric.ball (q₀, s₀) δ'_s ⊆ O_src :=
    Set.Subset.trans (Metric.ball_subset_ball (min_le_left _ _)) hδ_src_sub
  have h_tgt_nhds : e.target ∩ e.symm ⁻¹' Metric.ball (q₀, s₀) δ'_s ∈ nhds (q₀, (0 : ℂ)) :=
    Filter.inter_mem (e.open_target.mem_nhds hy_tgt)
      ((e.continuousAt_symm hy_tgt).preimage_mem_nhds
        (he_symm_pt.symm ▸ Metric.ball_mem_nhds (q₀, s₀) hδ'_s_pos))
  have h_q_nhds :
      (ι₀_CLM ⁻¹' (e.target ∩ e.symm ⁻¹' Metric.ball (q₀, s₀) δ'_s)) ∩
        Metric.ball q₀ δ'_s ∈ nhds q₀ :=
    Filter.inter_mem (ι₀_CLM.continuous.continuousAt.preimage_mem_nhds h_tgt_nhds)
      (Metric.ball_mem_nhds q₀ hδ'_s_pos)
  obtain ⟨δ_q_raw, hδ_q_raw_pos, hδ_q_raw_sub⟩ := Metric.mem_nhds_iff.mp h_q_nhds
  let δ_tr : ℝ := min δ_q_raw (min T.δ₂ (Br.r_t / 2))
  have hδ_tr_pos : 0 < δ_tr :=
    lt_min hδ_q_raw_pos (lt_min T.δ₂_pos (by linarith [Br.r_t_pos]))
  let B_tr : Set (ℂ × ℂ) := Metric.ball s₀ δ_tr ×ˢ Metric.ball (0 : ℂ) δ_tr
  have hB_tr_eq_ball : B_tr = Metric.ball q₀ δ_tr := ball_prod_same s₀ 0 δ_tr
  have hB_tr_open : IsOpen B_tr := Metric.isOpen_ball.prod Metric.isOpen_ball
  have hB_tr_sub_U_col : B_tr ⊆ U_col := by
    refine Set.prod_mono (Metric.ball_subset_ball ?_) (Metric.ball_subset_ball ?_)
    · exact le_trans (le_trans (min_le_right _ _) (min_le_left _ _)) T.δ₂_le_s
    · have : δ_tr ≤ Br.r_t / 2 := le_trans (min_le_right _ _) (min_le_right _ _)
      linarith [Br.r_t_pos]
  let s_trans : ℂ × ℂ → ℂ := fun q => p_z (e.symm (ι₀_CLM q))
  have hs_trans_props : ∀ q ∈ B_tr,
      e.symm (ι₀_CLM q) = (q, s_trans q) ∧
      s_trans q ∈ Metric.ball s₀ δ'_s ∧
      F_inc q (s_trans q) = 0 := by
    intro q hq
    have hq_raw : q ∈ Metric.ball q₀ δ_q_raw :=
      Metric.ball_subset_ball (min_le_left _ _) (hB_tr_eq_ball ▸ hq)
    obtain ⟨⟨hq_tgt, hq_symm_ball⟩, _⟩ := hδ_q_raw_sub hq_raw
    have h_rinv : Φ_fn (e.symm (ι₀_CLM q)) = ι₀_CLM q := by
      rw [← he_coe]
      exact e.right_inv hq_tgt
    have h_fst : (e.symm (ι₀_CLM q)).1 = q := congr_arg Prod.fst h_rinv
    have h_snd : F_inc (e.symm (ι₀_CLM q)).1 (s_trans q) = 0 := congr_arg Prod.snd h_rinv
    rw [h_fst] at h_snd
    rw [← ball_prod_same] at hq_symm_ball
    exact ⟨Prod.ext h_fst rfl, hq_symm_ball.2, h_snd⟩
  have hs_trans_holo : DifferentiableOn ℂ s_trans B_tr := by
    intro q hq
    have hq_raw : q ∈ Metric.ball q₀ δ_q_raw :=
      Metric.ball_subset_ball (min_le_left _ _) (hB_tr_eq_ball ▸ hq)
    obtain ⟨⟨hq_tgt, hq_symm_ball⟩, _⟩ := hδ_q_raw_sub hq_raw
    obtain ⟨he_symm_eq, _, _⟩ := hs_trans_props q hq
    have h_in_O : (q, s_trans q) ∈ O_src := hδ'_s_sub (he_symm_eq ▸ hq_symm_ball)
    obtain ⟨⟨⟨hq_U, hs_U⟩, hFz_ne⟩, _⟩ := h_in_O
    obtain ⟨L_eqv, hf_q⟩ := hΦ_strict q hq_U (s_trans q) hs_U hFz_ne
    have hf_e : HasStrictFDerivAt e
        (L_eqv : ((ℂ × ℂ) × ℂ) →L[ℂ] ((ℂ × ℂ) × ℂ)) (e.symm (ι₀_CLM q)) := by
      rwa [he_coe, he_symm_eq]
    have h_symm_diff : DifferentiableAt ℂ e.symm (ι₀_CLM q) :=
      (e.hasStrictFDerivAt_symm hq_tgt hf_e).differentiableAt
    exact ((p_z.differentiableAt.comp (ι₀_CLM q) h_symm_diff).comp
      q ι₀_CLM.differentiableAt).differentiableWithinAt
  have hs_trans_q₀ : s_trans q₀ = s₀ := by
    change (e.symm (q₀, 0)).2 = s₀
    rw [he_symm_pt]
  have hs_trans_uniq : ∀ q ∈ B_tr, ∀ s ∈ Metric.ball s₀ δ'_s,
      F_inc q s = 0 → s = s_trans q := by
    intro q hq s hs_ball hs_sol
    have hq_raw : q ∈ Metric.ball q₀ δ_q_raw :=
      Metric.ball_subset_ball (min_le_left _ _) (hB_tr_eq_ball ▸ hq)
    have hq_b : q ∈ Metric.ball q₀ δ'_s := (hδ_q_raw_sub hq_raw).2
    have hqs_ball : (q, s) ∈ Metric.ball (q₀, s₀) δ'_s := by
      rw [← ball_prod_same]
      exact ⟨hq_b, hs_ball⟩
    have hqs_src : (q, s) ∈ e.source := (hδ'_s_sub hqs_ball).2
    have he_qs : e (q, s) = ι₀_CLM q := by
      rw [he_coe]
      exact Prod.ext rfl hs_sol
    have h_linv : e.symm (e (q, s)) = (q, s) := e.left_inv hqs_src
    rw [he_qs] at h_linv
    exact (congr_arg Prod.snd h_linv).symm

  
  have hB_tr_neg : ∀ q ∈ B_tr, (q.1, -q.2) ∈ B_tr := by
    intro q hq
    exact ⟨hq.1, by simpa only [Metric.mem_ball, dist_zero_right, norm_neg] using hq.2⟩
  have hs_trans_even : ∀ q ∈ B_tr, s_trans (q.1, -q.2) = s_trans q := by
    intro q hq
    have hq_neg : (q.1, -q.2) ∈ B_tr := hB_tr_neg q hq
    obtain ⟨_, hs_mem, hF_sol⟩ := hs_trans_props q hq
    have hF_neg : F_inc (q.1, -q.2) (s_trans q) = 0 := by
      dsimp only [F_inc] at hF_sol ⊢
      rw [hL₀_even q (hB_tr_sub_U_col hq) 0, hL₀_even q (hB_tr_sub_U_col hq) 1]
      exact hF_sol
    exact (hs_trans_uniq (q.1, -q.2) hq_neg (s_trans q) hs_mem hF_neg).symm

  have hd_ne_zero : G.d ≠ 0 := Nat.ne_of_gt G.d_pos
  have h0_pow_d : (0 : ℂ) ^ G.d = 0 := zero_pow hd_ne_zero
  let powMap : ℂ × ℂ → ℂ × ℂ := fun p => (p.1, p.2 ^ G.d)
  have hpowMap_cont : Continuous powMap :=
    continuous_fst.prodMk (continuous_snd.pow G.d)
  have hq₀_in_B₂ : q₀ ∈ Metric.ball s₀ T.δ₂ ×ˢ Metric.ball (0 : ℂ) T.δ₂ :=
    ⟨Metric.mem_ball_self T.δ₂_pos, Metric.mem_ball_self T.δ₂_pos⟩
  have hσ_cont_q₀ : ContinuousAt T.σ q₀ :=
    T.σ_holo.continuousOn.continuousAt
      ((Metric.isOpen_ball.prod Metric.isOpen_ball).mem_nhds hq₀_in_B₂)
  have hσ_q₀ : T.σ q₀ = s₀ := T.σ_at_zero s₀ (Metric.mem_ball_self T.δ₂_pos)
  have hpow_q₀ : powMap q₀ = q₀ := Prod.ext rfl h0_pow_d
  have hq₀_B_tr : q₀ ∈ B_tr :=
    ⟨Metric.mem_ball_self hδ_tr_pos, Metric.mem_ball_self hδ_tr_pos⟩
  have hτ_nhds :
      (Metric.ball s₀ T.δ₂ ×ˢ Metric.ball (0 : ℂ) T.δ₂) ∩
        powMap ⁻¹' B_tr ∩ T.σ ⁻¹' Metric.ball s₀ δ'_s ∈ nhds q₀ :=
    Filter.inter_mem
      (Filter.inter_mem
        ((Metric.isOpen_ball.prod Metric.isOpen_ball).mem_nhds hq₀_in_B₂)
        (hpowMap_cont.continuousAt.preimage_mem_nhds (hpow_q₀.symm ▸ hB_tr_open.mem_nhds hq₀_B_tr)))
      (hσ_cont_q₀.preimage_mem_nhds (hσ_q₀.symm ▸ Metric.ball_mem_nhds s₀ hδ'_s_pos))
  obtain ⟨δ_τ_raw, hδ_τ_raw_pos, hδ_τ_raw_sub⟩ := Metric.mem_nhds_iff.mp hτ_nhds
  let δ_τ2 : ℝ := min δ_τ_raw T.δ₂
  have hδ_τ2_pos : 0 < δ_τ2 := lt_min hδ_τ_raw_pos T.δ₂_pos
  let B_τ2 : Set (ℂ × ℂ) := Metric.ball s₀ δ_τ2 ×ˢ Metric.ball (0 : ℂ) δ_τ2
  have hB_τ2_sub_raw : B_τ2 ⊆ Metric.ball q₀ δ_τ_raw := by
    dsimp only [B_τ2, q₀]
    rw [ball_prod_same]
    exact Metric.ball_subset_ball (min_le_left _ _)
  have hB_τ2_sub_B₂ : B_τ2 ⊆ Metric.ball s₀ T.δ₂ ×ˢ Metric.ball (0 : ℂ) T.δ₂ :=
    fun p hp => ((hδ_τ_raw_sub (hB_τ2_sub_raw hp)).1).1
  have hB_τ2_sub_B₁ : B_τ2 ⊆ Metric.ball (R.y₁ : ℂ) R.ρ₁ ×ˢ Metric.ball (0 : ℂ) R.ρ₁ := by
    intro p hp
    have hp₂ := hB_τ2_sub_B₂ hp
    exact ⟨T.ball_y₂_s_sub (Metric.ball_subset_ball T.δ₂_le_s hp₂.1),
      Metric.ball_subset_ball T.δ₂_le_ρ₁ hp₂.2⟩
  have hB_τ2_pow_tr : ∀ p ∈ B_τ2, powMap p ∈ B_tr :=
    fun p hp => ((hδ_τ_raw_sub (hB_τ2_sub_raw hp)).1).2
  have hσ_eq_s_trans : ∀ p ∈ B_τ2, T.σ p = s_trans (powMap p) := by
    intro p hp
    have hσ_mem : T.σ p ∈ Metric.ball s₀ δ'_s := (hδ_τ_raw_sub (hB_τ2_sub_raw hp)).2
    have hp₂ := hB_τ2_sub_B₂ hp
    have hp₁ := hB_τ2_sub_B₁ hp
    have hinc := R.Z_incidence p hp₁
    have hF_σ : F_inc (powMap p) (T.σ p) = 0 := by
      dsimp only [F_inc, powMap, L₀]
      rw [← T.Z_eq_comp_σ 0 p hp₂, ← T.Z_eq_comp_σ 1 p hp₂]
      change puisDualLine0 C G.d 0 p * R.Z 0 p + puisDualLine0 C G.d 1 p * R.Z 1 p - 1 = 0
      rw [hinc, sub_self]
    exact hs_trans_uniq (powMap p) (hB_τ2_pow_tr p hp) (T.σ p) hσ_mem hF_σ

  
  let X_tr : Fin 2 → ℂ × ℂ → ℂ := fun ι q => T.Z_zero ι (s_trans q)
  let T_tr : Fin 2 → ℂ × ℂ → ℂ := fun ι q => deriv (T.Z_zero ι) (s_trans q)
  let N_tr0 : ℂ × ℂ → ℂ := fun q => T_tr 1 q
  let N_tr1 : ℂ × ℂ → ℂ := fun q => -T_tr 0 q
  let V_tr : Fin 2 → ℂ × ℂ → ℂ := fun ι q =>
    2 * (L₀ 0 q * N_tr0 q + L₀ 1 q * N_tr1 q) * (if ι = 0 then N_tr0 q else N_tr1 q) -
      (N_tr0 q * N_tr0 q + N_tr1 q * N_tr1 q) * L₀ ι q
  let D_tr : ℂ × ℂ → ℂ := fun q => V_tr 0 q * X_tr 0 q + V_tr 1 q * X_tr 1 q
  have hs_trans_maps_s : ∀ q ∈ B_tr, s_trans q ∈ Metric.ball s₀ T.δ_s :=
    fun q hq => Metric.ball_subset_ball hδ'_s_le (hs_trans_props q hq).2.1
  have hX_tr_holo : ∀ ι : Fin 2, DifferentiableOn ℂ (X_tr ι) B_tr :=
    fun ι => (T.Z_zero_holo ι).comp hs_trans_holo hs_trans_maps_s
  have hT_tr_holo : ∀ ι : Fin 2, DifferentiableOn ℂ (T_tr ι) B_tr :=
    fun ι => (hZ_zero_deriv_holo ι).comp hs_trans_holo hs_trans_maps_s
  have hV_tr_holo : ∀ ι : Fin 2, DifferentiableOn ℂ (V_tr ι) B_tr := by
    intro ι
    have hL₀_B : ∀ j : Fin 2, DifferentiableOn ℂ (L₀ j) B_tr :=
      fun j => (hL₀_holo j).mono hB_tr_sub_U_col
    have hN0 : DifferentiableOn ℂ N_tr0 B_tr := hT_tr_holo 1
    have hN1 : DifferentiableOn ℂ N_tr1 B_tr := (hT_tr_holo 0).neg
    have hdotLN : DifferentiableOn ℂ (fun q => L₀ 0 q * N_tr0 q + L₀ 1 q * N_tr1 q) B_tr :=
      ((hL₀_B 0).mul hN0).add ((hL₀_B 1).mul hN1)
    have hdotNN : DifferentiableOn ℂ (fun q => N_tr0 q * N_tr0 q + N_tr1 q * N_tr1 q) B_tr :=
      (hN0.mul hN0).add (hN1.mul hN1)
    have hNι : DifferentiableOn ℂ (fun q => if ι = 0 then N_tr0 q else N_tr1 q) B_tr := by
      fin_cases ι <;> simp [hN0, hN1]
    exact (((differentiableOn_const (2 : ℂ)).mul hdotLN).mul hNι).sub (hdotNN.mul (hL₀_B ι))
  have hD_tr_holo : DifferentiableOn ℂ D_tr B_tr :=
    ((hV_tr_holo 0).mul (hX_tr_holo 0)).add ((hV_tr_holo 1).mul (hX_tr_holo 1))
  have hV_tr_even : ∀ q ∈ B_tr, ∀ ι : Fin 2, V_tr ι (q.1, -q.2) = V_tr ι q := by
    intro q hq ι
    dsimp only [V_tr, N_tr0, N_tr1, T_tr]
    rw [hs_trans_even q hq, hL₀_even q (hB_tr_sub_U_col hq) 0,
      hL₀_even q (hB_tr_sub_U_col hq) 1, hL₀_even q (hB_tr_sub_U_col hq) ι]
  have hD_tr_even : ∀ q ∈ B_tr, D_tr (q.1, -q.2) = D_tr q := by
    intro q hq
    dsimp only [D_tr, X_tr]
    rw [hV_tr_even q hq 0, hV_tr_even q hq 1, hs_trans_even q hq]

  let W₁_puis : Fin 3 → ℂ × ℂ → ℂ := homIntersect (puisDualLine0 C G.d) G.M_puis
  have hB_τ2_punc_sub_G : ∀ p ∈ B_τ2, p.2 ≠ 0 →
      p ∈ Metric.ball (Br.y₀ : ℂ) G.r_yp ×ˢ (Metric.ball (0 : ℂ) G.r_τ \ {0}) := by
    intro p hp hp2
    have hp₁ := hB_τ2_sub_B₁ hp
    exact ⟨R.ball_y₁_sub hp₁.1, ⟨Metric.ball_subset_ball R.ρ₁_le_τ hp₁.2, hp2⟩⟩
  have hW₁_rel : ∀ q ∈ B_τ2, q.2 ≠ 0 →
      W₁_puis 2 q ≠ 0 ∧ ∀ ι : Fin 2, W₁_puis ι.castSucc q = W₁_puis 2 q * T.Z_zero ι (T.σ q) := by
    intro q hq hq2
    have hq₁ := hB_τ2_sub_B₁ hq
    have hq₂ := hB_τ2_sub_B₂ hq
    have hpeq := R.W_tilde_puis_eq q hq₁ hq2
    have hW2_tilde_ne : R.W_tilde 2 q ≠ 0 := R.W_tilde_two_ne_zero q hq₁
    have hpow_m_ne : q.2 ^ R.m_star ≠ 0 := pow_ne_zero R.m_star hq2
    have hpow_K_ne : q.2 ^ G.K_p ≠ 0 := pow_ne_zero G.K_p hq2
    have hW1_2_ne : W₁_puis 2 q ≠ 0 := by
      intro h0
      have hmul := hpeq 2
      change q.2 ^ R.m_star * R.W_tilde 2 q = q.2 ^ G.K_p * W₁_puis 2 q at hmul
      rw [h0, mul_zero] at hmul
      exact mul_ne_zero hpow_m_ne hW2_tilde_ne hmul
    refine ⟨hW1_2_ne, fun ι => ?_⟩
    have hmul_ι : q.2 ^ R.m_star * R.W_tilde ι.castSucc q =
        q.2 ^ G.K_p * W₁_puis ι.castSucc q := hpeq ι.castSucc
    have hmul_2 : q.2 ^ R.m_star * R.W_tilde 2 q = q.2 ^ G.K_p * W₁_puis 2 q := hpeq 2
    have hZ_eq : R.Z ι q = R.W_tilde ι.castSucc q / R.W_tilde 2 q := R.Z_eq ι q hq₁
    have hW_tilde_ι : R.W_tilde ι.castSucc q = R.W_tilde 2 q * R.Z ι q := by
      rw [hZ_eq, mul_div_cancel₀ _ hW2_tilde_ne]
    rw [hW_tilde_ι] at hmul_ι
    have h_scaled :
        q.2 ^ G.K_p * W₁_puis ι.castSucc q =
          q.2 ^ G.K_p * (W₁_puis 2 q * T.Z_zero ι (T.σ q)) := by
      rw [← T.Z_eq_comp_σ ι q hq₂, ← hmul_ι,
        show q.2 ^ R.m_star * (R.W_tilde 2 q * R.Z ι q) =
          (q.2 ^ R.m_star * R.W_tilde 2 q) * R.Z ι q by ring,
        hmul_2]
      ring
    exact mul_left_cancel₀ hpow_K_ne h_scaled

  have hpuisDual0_holo_G : ∀ ι : Fin 2,
      DifferentiableOn ℂ (puisDualLine0 C G.d ι)
        (Metric.ball (Br.y₀ : ℂ) G.r_yp ×ˢ Metric.ball (0 : ℂ) G.r_τ) := by
    intro ι
    have hfn : puisDualLine0 C G.d ι =
        (fun w : ℂ × ℂ => glancingDualLine C w.1 w.2 ι) ∘ powMap := by
      ext p
      change L₀ ι (powMap p) = glancingDualLine C p.1 (p.2 ^ G.d) ι
      exact hL₀_eq ι (powMap p)
    rw [hfn]
    have hpow_diff : Differentiable ℂ powMap :=
      differentiable_fst.prodMk (differentiable_snd.pow G.d)
    refine (hDet.dualLine_holo ι).comp hpow_diff.differentiableOn ?_
    intro p hp
    apply hDom_bounds
    apply Br.bidisk_sub_dom
    refine ⟨Metric.ball_subset_ball (by linarith [G.r_yp_le, Br.r_y_pos]) hp.1, ?_⟩
    rw [Metric.mem_ball, dist_zero_right, norm_pow]
    have hp2 : ‖p.2‖ < G.r_τ := by simpa [Metric.mem_ball, dist_zero_right] using hp.2
    have hpow_lt : ‖p.2‖ ^ G.d < G.r_τ ^ G.d :=
      pow_lt_pow_left₀ hp2 (norm_nonneg _) hd_ne_zero
    linarith [G.r_τ_pow_lt, Br.r_t_pos]

  have hReflect_eq : ∀ p ∈ B_τ2, p.2 ≠ 0 → ∀ ι : Fin 2,
      D_tr (powMap p) * G.M_puis ι p = V_tr ι (powMap p) := by
    intro p hp hp2 ι
    have hp_G := hB_τ2_punc_sub_G p hp hp2
    have hW₁_2_holo_y : DifferentiableAt ℂ (fun y' : ℂ => W₁_puis 2 (y', p.2)) p.1 := by
      let U_punc := Metric.ball (Br.y₀ : ℂ) G.r_yp ×ˢ (Metric.ball (0 : ℂ) G.r_τ \ {0})
      have hUp_open : IsOpen U_punc :=
        Metric.isOpen_ball.prod (Metric.isOpen_ball.inter isOpen_compl_singleton)
      have hW2_holo : DifferentiableOn ℂ (W₁_puis 2) U_punc :=
        (((hpuisDual0_holo_G 0).mono (Set.prod_mono Set.Subset.rfl Set.inter_subset_left)).mul
          (G.M_puis_holo 1)).sub
        (((hpuisDual0_holo_G 1).mono (Set.prod_mono Set.Subset.rfl Set.inter_subset_left)).mul
          (G.M_puis_holo 0))
      have hemb : DifferentiableAt ℂ (fun y' : ℂ => (y', p.2)) p.1 :=
        differentiableAt_id.prodMk (differentiableAt_const p.2)
      exact (hW2_holo.differentiableAt (hUp_open.mem_nhds hp_G)).comp p.1 hemb
    have hT_ι : ∀ j : Fin 2,
        W₁_puis 2 p * iterDerivYT 1 0 (W₁_puis j.castSucc) p -
          W₁_puis j.castSucc p * iterDerivYT 1 0 (W₁_puis 2) p =
          ((W₁_puis 2 p) ^ 2 * pderivA T.σ p) * T_tr j (powMap p) := by
      intro j
      have hp₂ := hB_τ2_sub_B₂ hp
      have hσ_y_diff : DifferentiableAt ℂ (fun y' : ℂ => T.σ (y', p.2)) p.1 := by
        have hemb : DifferentiableAt ℂ (fun y' : ℂ => (y', p.2)) p.1 :=
          differentiableAt_id.prodMk (differentiableAt_const p.2)
        exact (T.σ_holo.differentiableAt
          ((Metric.isOpen_ball.prod Metric.isOpen_ball).mem_nhds hp₂)).comp p.1 hemb
      have hσ_y_deriv : HasDerivAt (fun y' : ℂ => T.σ (y', p.2)) (pderivA T.σ p) p.1 :=
        hσ_y_diff.hasDerivAt
      have hZ_diff : DifferentiableAt ℂ (T.Z_zero j) (T.σ p) :=
        (T.Z_zero_holo j).differentiableAt (Metric.isOpen_ball.mem_nhds (T.σ_maps_to p hp₂))
      have hcomp_deriv : HasDerivAt (fun y' : ℂ => T.Z_zero j (T.σ (y', p.2)))
          (deriv (T.Z_zero j) (T.σ p) * pderivA T.σ p) p.1 :=
        hZ_diff.hasDerivAt.comp p.1 hσ_y_deriv
      have hprod_deriv : HasDerivAt
          (fun y' : ℂ => W₁_puis 2 (y', p.2) * T.Z_zero j (T.σ (y', p.2)))
          (iterDerivYT 1 0 (W₁_puis 2) p * T.Z_zero j (T.σ p) +
            W₁_puis 2 p * (deriv (T.Z_zero j) (T.σ p) * pderivA T.σ p)) p.1 :=
        hW₁_2_holo_y.hasDerivAt.mul hcomp_deriv
      have hev_eq : (fun y' : ℂ => W₁_puis j.castSucc (y', p.2)) =ᶠ[nhds p.1]
          (fun y' : ℂ => W₁_puis 2 (y', p.2) * T.Z_zero j (T.σ (y', p.2))) := by
        filter_upwards [Metric.isOpen_ball.mem_nhds hp.1] with y' hy'
        exact (hW₁_rel (y', p.2) ⟨hy', hp.2⟩ hp2).2 j
      have hder_idx : iterDerivYT 1 0 (W₁_puis j.castSucc) p =
          iterDerivYT 1 0 (W₁_puis 2) p * T.Z_zero j (T.σ p) +
            W₁_puis 2 p * (deriv (T.Z_zero j) (T.σ p) * pderivA T.σ p) :=
        (hprod_deriv.congr_of_eventuallyEq hev_eq).deriv
      have hval_idx : W₁_puis j.castSucc p = W₁_puis 2 p * T.Z_zero j (T.σ p) :=
        (hW₁_rel p hp hp2).2 j
      rw [hder_idx, hval_idx]
      dsimp only [T_tr]
      rw [← hσ_eq_s_trans p hp]
      ring
    have hT0 : W₁_puis 2 p * iterDerivYT 1 0 (W₁_puis 0) p -
        W₁_puis 0 p * iterDerivYT 1 0 (W₁_puis 2) p =
        ((W₁_puis 2 p) ^ 2 * pderivA T.σ p) * T_tr 0 (powMap p) := hT_ι 0
    have hT1 : W₁_puis 2 p * iterDerivYT 1 0 (W₁_puis 1) p -
        W₁_puis 1 p * iterDerivYT 1 0 (W₁_puis 2) p =
        ((W₁_puis 2 p) ^ 2 * pderivA T.σ p) * T_tr 1 (powMap p) := hT_ι 1
    have h1_ne : (1 : Fin 2) ≠ 0 := by decide
    obtain ⟨hW1_2_ne, hW1_vals⟩ := hW₁_rel p hp hp2
    have hW1_0 : W₁_puis 0 p = W₁_puis 2 p * X_tr 0 (powMap p) := by
      have h0 := hW1_vals 0
      change W₁_puis 0 p = W₁_puis 2 p * T.Z_zero 0 (T.σ p) at h0
      simpa only [X_tr, ← hσ_eq_s_trans p hp] using h0
    have hW1_1 : W₁_puis 1 p = W₁_puis 2 p * X_tr 1 (powMap p) := by
      have h1 := hW1_vals 1
      change W₁_puis 1 p = W₁_puis 2 p * T.Z_zero 1 (T.σ p) at h1
      simpa only [X_tr, ← hσ_eq_s_trans p hp] using h1
    have hres0 := G.puis_reflect p hp_G ι
    let μ : ℂ := (W₁_puis 2 p) ^ 2 * pderivA T.σ p
    have hμ_ne : μ ≠ 0 :=
      mul_ne_zero (pow_ne_zero 2 hW1_2_ne) (T.σ_pderivA_ne_zero p (hB_τ2_sub_B₂ hp))
    have hfactor : homReflectRes (puisDualLine0 C G.d) G.M_puis ι p =
        W₁_puis 2 p * μ ^ 2 * (V_tr ι (powMap p) - D_tr (powMap p) * G.M_puis ι p) := by
      change W₁_puis 2 p * homReflectOut (puisDualLine0 C G.d) W₁_puis ι p -
          (homReflectOut (puisDualLine0 C G.d) W₁_puis 0 p * W₁_puis 0 p +
            homReflectOut (puisDualLine0 C G.d) W₁_puis 1 p * W₁_puis 1 p) *
            G.M_puis ι p =
        W₁_puis 2 p * μ ^ 2 * (V_tr ι (powMap p) - D_tr (powMap p) * G.M_puis ι p)
      dsimp only [homReflectOut]
      rw [hT0, hT1, hW1_0, hW1_1]
      dsimp only [V_tr, D_tr, N_tr0, N_tr1, puisDualLine0, L₀, powMap, μ]
      fin_cases ι
      · simp only [Fin.zero_eta, ↓reduceIte, h1_ne]
        ring
      · simp only [Fin.mk_one, ↓reduceIte, h1_ne]
        ring
    rw [hfactor] at hres0
    have hnz : W₁_puis 2 p * μ ^ 2 ≠ 0 := mul_ne_zero hW1_2_ne (pow_ne_zero 2 hμ_ne)
    have hsub := (mul_eq_zero.mp hres0).resolve_left hnz
    exact (sub_eq_zero.mp hsub).symm

  
  let δ_y2 : ℝ := min δ_tr δ_τ2 / 2
  have hδ_y2_pos : 0 < δ_y2 := by positivity
  let δ_t2 : ℝ := min δ_tr ((δ_τ2 / 2) ^ G.d) / 2
  have hδ_t2_pos : 0 < δ_t2 := by
    have h1 : 0 < (δ_τ2 / 2) ^ G.d := pow_pos (by linarith) G.d
    exact div_pos (lt_min hδ_tr_pos h1) (by norm_num)
  let B_tr2 : Set (ℂ × ℂ) := Metric.ball s₀ δ_y2 ×ˢ Metric.ball (0 : ℂ) δ_t2
  have hB_tr2_open : IsOpen B_tr2 := Metric.isOpen_ball.prod Metric.isOpen_ball
  have hB_tr2_sub_B_tr : B_tr2 ⊆ B_tr := by
    refine Set.prod_mono (Metric.ball_subset_ball ?_) (Metric.ball_subset_ball ?_)
    · have : min δ_tr δ_τ2 ≤ δ_tr := min_le_left _ _
      dsimp only [δ_y2]; linarith
    · have : min δ_tr ((δ_τ2 / 2) ^ G.d) ≤ δ_tr := min_le_left _ _
      dsimp only [δ_t2]; linarith
  have hq₀_B_tr2 : q₀ ∈ B_tr2 :=
    ⟨Metric.mem_ball_self hδ_y2_pos, Metric.mem_ball_self hδ_t2_pos⟩

  have hD_tr_exists_nz : ∃ q_star ∈ B_tr2, D_tr q_star ≠ 0 := by
    by_contra hAllZero
    have hAllZero' : ∀ q ∈ B_tr2, D_tr q = 0 :=
      fun q hq => by_contra fun hne => hAllZero ⟨q, hq, hne⟩
    have hB_tr_preconn : IsPreconnected B_tr :=
      (convex_ball s₀ δ_tr).isPreconnected.prod (convex_ball (0 : ℂ) δ_tr).isPreconnected
    have hZero_B_tr : ∀ q ∈ B_tr, D_tr q = 0 :=
      hKit.eqOn_zero_of_preconnected_2D hB_tr_open hB_tr_preconn
        hB_tr2_open ⟨q₀, hq₀_B_tr2⟩ hB_tr2_sub_B_tr hD_tr_holo hAllZero'
    let τ_seq : ℕ → ℂ := fun n => ((δ_τ2 / (2 * ((n : ℝ) + 1)) : ℝ) : ℂ)
    have hτ_seq_props : ∀ n : ℕ, (s₀, τ_seq n) ∈ B_τ2 ∧ τ_seq n ≠ 0 := by
      intro n
      have hn_pos : (0 : ℝ) < 2 * ((n : ℝ) + 1) := by positivity
      have hr_pos : 0 < δ_τ2 / (2 * ((n : ℝ) + 1)) := div_pos hδ_τ2_pos hn_pos
      have hr_le : δ_τ2 / (2 * ((n : ℝ) + 1)) ≤ δ_τ2 / 2 :=
        div_le_div_of_nonneg_left hδ_τ2_pos.le (by positivity)
          (by linarith [Nat.cast_nonneg (α := ℝ) n])
      refine ⟨⟨Metric.mem_ball_self hδ_τ2_pos, ?_⟩, Complex.ofReal_ne_zero.mpr hr_pos.ne'⟩
      rw [Metric.mem_ball, dist_zero_right]
      change ‖((δ_τ2 / (2 * ((n : ℝ) + 1)) : ℝ) : ℂ)‖ < δ_τ2
      rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos hr_pos]
      linarith
    have hτ_tendsto : Filter.Tendsto τ_seq Filter.atTop (nhds 0) := by
      have hreal : Filter.Tendsto (fun n : ℕ => δ_τ2 / (2 * ((n : ℝ) + 1)))
          Filter.atTop (nhds 0) := by
        have hden : Filter.Tendsto (fun n : ℕ => 2 * ((n : ℝ) + 1)) Filter.atTop Filter.atTop :=
          Filter.Tendsto.const_mul_atTop (by norm_num)
            (Filter.tendsto_atTop_add_const_right _ 1 tendsto_natCast_atTop_atTop)
        exact tendsto_const_nhds.div_atTop hden
      simpa [τ_seq, Function.comp_def] using (Complex.continuous_ofReal.tendsto 0).comp hreal
    have hpow_seq_tendsto :
        Filter.Tendsto (fun n : ℕ => powMap (s₀, τ_seq n)) Filter.atTop (nhds q₀) := by
      have hp_t : Filter.Tendsto (fun n : ℕ => (τ_seq n) ^ G.d) Filter.atTop (nhds 0) := by
        simpa only [h0_pow_d] using hτ_tendsto.pow G.d
      exact tendsto_const_nhds.prodMk_nhds hp_t
    have hV_q₀_zero : ∀ ι : Fin 2, V_tr ι q₀ = 0 := by
      intro ι
      have hV_cont : ContinuousAt (V_tr ι) q₀ :=
        (hV_tr_holo ι).continuousOn.continuousAt (hB_tr_open.mem_nhds hq₀_B_tr)
      have h_lim1 : Filter.Tendsto (fun n : ℕ => V_tr ι (powMap (s₀, τ_seq n)))
          Filter.atTop (nhds (V_tr ι q₀)) :=
        hV_cont.tendsto.comp hpow_seq_tendsto
      have h_all0 : (fun n : ℕ => V_tr ι (powMap (s₀, τ_seq n))) = fun _ => 0 := by
        ext n
        obtain ⟨hp_in, hp_nz⟩ := hτ_seq_props n
        rw [← hReflect_eq (s₀, τ_seq n) hp_in hp_nz ι,
          hZero_B_tr (powMap (s₀, τ_seq n)) (hB_τ2_pow_tr _ hp_in), zero_mul]
      rw [h_all0] at h_lim1
      exact tendsto_nhds_unique h_lim1 tendsto_const_nhds
    have hV_norm_id :
        (V_tr 0 q₀) ^ 2 + (V_tr 1 q₀) ^ 2 =
          ((deriv (T.Z_zero 0) s₀) ^ 2 + (deriv (T.Z_zero 1) s₀) ^ 2) ^ 2 *
            ((L₀ 0 q₀) ^ 2 + (L₀ 1 q₀) ^ 2) := by
      have h1_ne : (1 : Fin 2) ≠ 0 := by decide
      dsimp only [V_tr, N_tr0, N_tr1, T_tr]
      simp only [↓reduceIte, h1_ne, hs_trans_q₀]
      ring
    have hLHS_zero : (V_tr 0 q₀) ^ 2 + (V_tr 1 q₀) ^ 2 = 0 := by
      rw [hV_q₀_zero 0, hV_q₀_zero 1]; ring
    have hRHS_ne :
        ((deriv (T.Z_zero 0) s₀) ^ 2 + (deriv (T.Z_zero 1) s₀) ^ 2) ^ 2 *
          ((L₀ 0 q₀) ^ 2 + (L₀ 1 q₀) ^ 2) ≠ 0 :=
      mul_ne_zero (pow_ne_zero 2 T.Z_zero_nonisotropic_at) hL₀_sq_ne_zero
    exact hRHS_ne (hV_norm_id ▸ hLHS_zero)

  obtain ⟨⟨y_star, t_star⟩, ⟨hy_star, ht_star⟩, hD_star_nz⟩ := hD_tr_exists_nz
  have hex_y_ann :
      ∃ y_ann ∈ Set.Ioo (T.y₂ - δ_y2 / 2) (T.y₂ + δ_y2 / 2),
        D_tr ((y_ann : ℂ), t_star) ≠ 0 := by
    by_contra hAllRealZero
    have hAllRealZero' :
        ∀ x ∈ Set.Ioo (T.y₂ - δ_y2 / 2) (T.y₂ + δ_y2 / 2), D_tr ((x : ℂ), t_star) = 0 :=
      fun x hx => by_contra fun hne => hAllRealZero ⟨x, hx, hne⟩
    let f_y : ℂ → ℂ := fun y => D_tr (y, t_star)
    have hf_y_holo : DifferentiableOn ℂ f_y (Metric.ball s₀ δ_y2) := by
      have hemb : Differentiable ℂ (fun y : ℂ => (y, t_star)) :=
        differentiable_id.prodMk (differentiable_const t_star)
      exact (hD_tr_holo.mono hB_tr2_sub_B_tr).comp hemb.differentiableOn
        (fun y hy => ⟨hy, ht_star⟩)
    have hf_y_ana : AnalyticOnNhd ℂ f_y (Metric.ball s₀ δ_y2) :=
      (Complex.analyticOnNhd_iff_differentiableOn Metric.isOpen_ball).mpr hf_y_holo
    let x_seq : ℕ → ℝ := fun n => T.y₂ + δ_y2 / (4 * ((n : ℝ) + 1))
    have hx_seq_mem : ∀ n : ℕ,
        x_seq n ∈ Set.Ioo (T.y₂ - δ_y2 / 2) (T.y₂ + δ_y2 / 2) ∧ (x_seq n : ℂ) ≠ s₀ := by
      intro n
      have hn_pos : (0 : ℝ) < 4 * ((n : ℝ) + 1) := by positivity
      have hd_pos : 0 < δ_y2 / (4 * ((n : ℝ) + 1)) := div_pos hδ_y2_pos hn_pos
      have hd_le : δ_y2 / (4 * ((n : ℝ) + 1)) ≤ δ_y2 / 4 :=
        div_le_div_of_nonneg_left hδ_y2_pos.le (by positivity)
          (by linarith [Nat.cast_nonneg (α := ℝ) n])
      refine ⟨⟨by dsimp [x_seq]; linarith, by dsimp [x_seq]; linarith⟩, ?_⟩
      intro heq
      have hre := congr_arg Complex.re heq
      simp only [Complex.ofReal_re, s₀] at hre
      dsimp [x_seq] at hre
      linarith
    have hx_tendsto : Filter.Tendsto (fun n : ℕ => (x_seq n : ℂ))
        Filter.atTop (nhdsWithin s₀ {s₀}ᶜ) := by
      rw [tendsto_nhdsWithin_iff]
      refine ⟨?_, Filter.Eventually.of_forall (fun n => (hx_seq_mem n).2)⟩
      have hreal : Filter.Tendsto x_seq Filter.atTop (nhds T.y₂) := by
        have hden : Filter.Tendsto (fun n : ℕ => 4 * ((n : ℝ) + 1)) Filter.atTop Filter.atTop :=
          Filter.Tendsto.const_mul_atTop (by norm_num)
            (Filter.tendsto_atTop_add_const_right _ 1 tendsto_natCast_atTop_atTop)
        simpa [x_seq] using Filter.Tendsto.const_add T.y₂ (tendsto_const_nhds.div_atTop hden)
      exact (Complex.continuous_ofReal.tendsto T.y₂).comp hreal
    have h_freq : ∃ᶠ z in nhdsWithin s₀ {s₀}ᶜ, f_y z = 0 :=
      hx_tendsto.frequently ((Filter.Eventually.of_forall
        (fun n => hAllRealZero' (x_seq n) (hx_seq_mem n).1)).frequently)
    have hzero_all := hf_y_ana.eqOn_zero_of_preconnected_of_frequently_eq_zero
      (convex_ball s₀ δ_y2).isPreconnected (Metric.mem_ball_self hδ_y2_pos) h_freq hy_star
    exact hD_star_nz hzero_all

  obtain ⟨y_ann, hy_ann_Ioo, hD_y_ann_nz⟩ := hex_y_ann
  have hy_ann_abs : |y_ann - T.y₂| < δ_y2 / 2 :=
    abs_lt.mpr ⟨by linarith [hy_ann_Ioo.1], by linarith [hy_ann_Ioo.2]⟩
  have hy_ann_ball : (y_ann : ℂ) ∈ Metric.ball s₀ δ_y2 := by
    rw [Metric.mem_ball, dist_eq_norm]
    have hnorm : ‖(y_ann : ℂ) - s₀‖ = |y_ann - T.y₂| := by
      dsimp [s₀]
      rw [← Complex.ofReal_sub, Complex.norm_real, Real.norm_eq_abs]
    rw [hnorm]
    linarith

  let g_t : ℂ → ℂ := fun t => D_tr ((y_ann : ℂ), t)
  have hg_t_holo : DifferentiableOn ℂ g_t (Metric.ball (0 : ℂ) δ_t2) := by
    have hemb : Differentiable ℂ (fun t : ℂ => ((y_ann : ℂ), t)) :=
      (differentiable_const (y_ann : ℂ)).prodMk differentiable_id
    exact (hD_tr_holo.mono hB_tr2_sub_B_tr).comp hemb.differentiableOn
      (fun t ht => ⟨hy_ann_ball, ht⟩)
  have hg_t_ana : AnalyticOnNhd ℂ g_t (Metric.ball (0 : ℂ) δ_t2) :=
    (Complex.analyticOnNhd_iff_differentiableOn Metric.isOpen_ball).mpr hg_t_holo
  have hg_t_ana0 : AnalyticAt ℂ g_t 0 := hg_t_ana 0 (Metric.mem_ball_self hδ_t2_pos)
  have hg_t_ev_nz : ∀ᶠ t in nhdsWithin (0 : ℂ) {(0 : ℂ)}ᶜ, g_t t ≠ 0 := by
    rcases hg_t_ana0.eventually_eq_zero_or_eventually_ne_zero with hev0 | hev_nz
    · exfalso
      have h0_star := hg_t_ana.eqOn_zero_of_preconnected_of_eventuallyEq_zero
        (convex_ball (0 : ℂ) δ_t2).isPreconnected (Metric.mem_ball_self hδ_t2_pos) hev0 ht_star
      exact hD_y_ann_nz h0_star
    · exact hev_nz
  obtain ⟨δ_c0, hδ_c0_pos, hδ_c0_nz⟩ :=
    Metric.eventually_nhds_iff.mp (eventually_nhdsWithin_iff.mp hg_t_ev_nz)
  let δ_clean : ℝ := min δ_c0 (min δ_t2 (Br.r_t / 2))
  have hδ_clean_pos : 0 < δ_clean :=
    lt_min hδ_c0_pos (lt_min hδ_t2_pos (by linarith [Br.r_t_pos]))
  let t_near : ℝ := δ_clean / 2
  have ht_near_pos : 0 < t_near := by dsimp [t_near]; linarith

  let K_t : Set ℂ := { t : ℂ | t_near / 2 ≤ ‖t‖ ∧ ‖t‖ ≤ 3 * t_near / 2 }
  have hK_t_compact : IsCompact K_t := by
    refine IsCompact.of_isClosed_subset
      (ProperSpace.isCompact_closedBall (0 : ℂ) (3 * t_near / 2))
      ((isClosed_le continuous_const continuous_norm).inter
        (isClosed_le continuous_norm continuous_const)) ?_
    intro t ht
    simpa [Metric.mem_closedBall, dist_zero_right] using ht.2
  let K_ann : Set (ℂ × ℂ) := {(y_ann : ℂ)} ×ˢ K_t
  have hK_ann_compact : IsCompact K_ann := isCompact_singleton.prod hK_t_compact
  let O_nz : Set (ℂ × ℂ) := B_tr2 ∩ D_tr ⁻¹' {(0 : ℂ)}ᶜ
  have hO_nz_open : IsOpen O_nz :=
    (hD_tr_holo.mono hB_tr2_sub_B_tr).continuousOn.isOpen_inter_preimage
      hB_tr2_open isOpen_compl_singleton
  have hK_ann_sub_O : K_ann ⊆ O_nz := by
    intro p ⟨hp1, hp2_lo, hp2_hi⟩
    rw [Set.mem_singleton_iff] at hp1
    have hp2_lt_clean : ‖p.2‖ < δ_clean := by dsimp [t_near] at hp2_hi; linarith
    have hp2_lt_t2 : ‖p.2‖ < δ_t2 :=
      lt_of_lt_of_le hp2_lt_clean (le_trans (min_le_right _ _) (min_le_left _ _))
    have hp2_lt_c0 : ‖p.2‖ < δ_c0 := lt_of_lt_of_le hp2_lt_clean (min_le_left _ _)
    have hp2_ne0 : p.2 ≠ 0 := by
      intro h0; rw [h0, norm_zero] at hp2_lo; linarith
    refine ⟨⟨hp1 ▸ hy_ann_ball, by simpa [Metric.mem_ball, dist_zero_right] using hp2_lt_t2⟩, ?_⟩
    change D_tr (p.1, p.2) ≠ 0
    rw [hp1]
    exact hδ_c0_nz (by simpa [dist_zero_right] using hp2_lt_c0) hp2_ne0
  obtain ⟨ε_th, hε_th_pos, hε_th_sub⟩ :=
    hK_ann_compact.exists_thickening_subset_open hO_nz_open hK_ann_sub_O

  let δ_y : ℝ := min ε_th (δ_y2 / 2)
  have hδ_y_pos : 0 < δ_y := lt_min hε_th_pos (by linarith)
  let r_match : ℝ := min δ_y (t_near / 4)
  have hr_match_pos : 0 < r_match := lt_min hδ_y_pos (by linarith)
  let A_t : Set ℂ := { t : ℂ | t_near / 2 < ‖t‖ ∧ ‖t‖ < 3 * t_near / 2 }
  let U_ann : Set (ℂ × ℂ) := Metric.ball (y_ann : ℂ) δ_y ×ˢ A_t
  let M_even : Fin 2 → ℂ × ℂ → ℂ := fun ι p => V_tr ι p / D_tr p

  have hU_ann_sub_O : U_ann ⊆ O_nz := by
    intro p ⟨hp1, hp2_lo, hp2_hi⟩
    apply hε_th_sub
    rw [Metric.mem_thickening_iff]
    refine ⟨((y_ann : ℂ), p.2), ⟨rfl, le_of_lt hp2_lo, le_of_lt hp2_hi⟩, ?_⟩
    rw [Prod.dist_eq, dist_self]
    have hd1 : dist p.1 (y_ann : ℂ) < ε_th :=
      lt_of_lt_of_le (Metric.mem_ball.mp hp1) (min_le_left _ _)
    exact max_lt hd1 hε_th_pos
  have hU_ann_sub_B_tr : U_ann ⊆ B_tr :=
    fun p hp => hB_tr2_sub_B_tr (hU_ann_sub_O hp).1
  have hU_ann_D_nz : ∀ p ∈ U_ann, D_tr p ≠ 0 :=
    fun p hp => (hU_ann_sub_O hp).2
  have hann_sub_dom : U_ann ⊆ symCollarDom W.s_base W.r_base q_idx := by
    intro p hp
    apply Br.bidisk_sub_dom
    have hp_B2 : p ∈ B_tr2 := (hU_ann_sub_O hp).1
    refine ⟨h_ball_s_ry (Metric.ball_subset_ball ?_ hp_B2.1), ?_⟩
    · have h1 : δ_y2 ≤ δ_tr / 2 := div_le_div_of_nonneg_right (min_le_left _ _) (by norm_num)
      have h2 : δ_tr ≤ T.δ₂ := le_trans (min_le_right _ _) (min_le_left _ _)
      linarith [T.δ₂_le_s, hδ_tr_pos]
    · rw [Metric.mem_ball, dist_zero_right]
      have hp2_hi : ‖p.2‖ < 3 * t_near / 2 := hp.2.2
      have h_clean_rt : δ_clean ≤ Br.r_t / 2 :=
        le_trans (min_le_right _ _) (min_le_right _ _)
      dsimp [t_near] at hp2_hi
      linarith [Br.r_t_pos]
  have hmatch_ball_sub :
      Metric.ball ((y_ann : ℂ), (t_near : ℂ)) r_match ⊆ U_ann := by
    intro p hp
    rw [Metric.mem_ball, Prod.dist_eq, max_lt_iff] at hp
    refine ⟨Metric.mem_ball.mpr (lt_of_lt_of_le hp.1 (min_le_left _ _)), ?_, ?_⟩
    · have hd2 : ‖p.2 - (t_near : ℂ)‖ < t_near / 4 := by
        simpa [dist_eq_norm] using lt_of_lt_of_le hp.2 (min_le_right _ _)
      have htn_norm : ‖(t_near : ℂ)‖ = t_near := by
        rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos ht_near_pos]
      have htri : ‖(t_near : ℂ)‖ ≤ ‖p.2‖ + ‖(t_near : ℂ) - p.2‖ := by
        simpa using norm_add_le p.2 ((t_near : ℂ) - p.2)
      rw [norm_sub_rev] at hd2
      linarith
    · have hd2 : ‖p.2 - (t_near : ℂ)‖ < t_near / 4 := by
        simpa [dist_eq_norm] using lt_of_lt_of_le hp.2 (min_le_right _ _)
      have htn_norm : ‖(t_near : ℂ)‖ = t_near := by
        rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos ht_near_pos]
      have htri : ‖p.2‖ ≤ ‖p.2 - (t_near : ℂ)‖ + ‖(t_near : ℂ)‖ := by
        simpa using norm_add_le (p.2 - (t_near : ℂ)) (t_near : ℂ)
      linarith
  have hM_even_holo : ∀ ι : Fin 2, DifferentiableOn ℂ (M_even ι) U_ann := by
    intro ι
    have hfn : M_even ι = fun p => V_tr ι p * (D_tr p)⁻¹ := by
      ext p; exact div_eq_mul_inv (V_tr ι p) (D_tr p)
    rw [hfn]
    exact ((hV_tr_holo ι).mono hU_ann_sub_B_tr).mul
      ((hD_tr_holo.mono hU_ann_sub_B_tr).fun_inv hU_ann_D_nz)
  have hM_even_symm : ∀ ι : Fin 2, ∀ p ∈ U_ann, M_even ι (p.1, -p.2) = M_even ι p := by
    intro ι p hp
    dsimp only [M_even]
    rw [hV_tr_even p (hU_ann_sub_B_tr hp) ι, hD_tr_even p (hU_ann_sub_B_tr hp)]

  
  have hpoly_transfer : ∀ (M D : ℕ) (ι_star : Fin 2)
      (P_coeff : Fin (D + 1) → MvPolynomial (SymJetVar N_idx M) ℂ),
    (∀ p ∈ Metric.ball ((Br.y₀ : ℂ), (Br.t_end : ℂ)) Br.r_end,
      ∑ d : Fin (D + 1),
        MvPolynomial.eval (symJetEnv C q_idx M p) (P_coeff d) *
          (Br.M₁_end ι_star p) ^ (d : ℕ) = 0) ↔
    (∀ p ∈ Metric.ball ((y_ann : ℂ), (t_near : ℂ)) r_match,
      ∑ d : Fin (D + 1),
        MvPolynomial.eval (symJetEnv C q_idx M p) (P_coeff d) *
          (M_even ι_star p) ^ (d : ℕ) = 0) := by
    let τ_near : ℝ := t_near ^ ((G.d : ℝ)⁻¹)
    have hτ_near_pos : 0 < τ_near := Real.rpow_pos_of_pos ht_near_pos _
    have hd_cast_ne : (G.d : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr hd_ne_zero
    have hτ_near_pow : τ_near ^ G.d = t_near := by
      dsimp only [τ_near]
      rw [← Real.rpow_natCast, ← Real.rpow_mul ht_near_pos.le,
        inv_mul_cancel₀ hd_cast_ne, Real.rpow_one]
    have hτ_near_lt : τ_near < δ_τ2 / 2 := by
      by_contra hnot
      have hge : δ_τ2 / 2 ≤ τ_near := not_lt.mp hnot
      have hpow_le : (δ_τ2 / 2) ^ G.d ≤ τ_near ^ G.d :=
        pow_le_pow_left₀ (by linarith) hge G.d
      rw [hτ_near_pow] at hpow_le
      have ht_lt : t_near < δ_t2 := by
        have : δ_clean ≤ δ_t2 := le_trans (min_le_right _ _) (min_le_left _ _)
        dsimp [t_near]; linarith
      have ht2_lt : δ_t2 < (δ_τ2 / 2) ^ G.d := by
        have h1 : 0 < (δ_τ2 / 2) ^ G.d := pow_pos (by linarith) G.d
        have h2 : min δ_tr ((δ_τ2 / 2) ^ G.d) ≤ (δ_τ2 / 2) ^ G.d := min_le_right _ _
        dsimp [δ_t2]; linarith
      linarith
    let V_τ : Set (ℂ × ℂ) :=
      (Metric.ball s₀ δ_τ2 ×ˢ (Metric.ball (0 : ℂ) δ_τ2 \ {0})) ∩
        powMap ⁻¹' Metric.ball ((y_ann : ℂ), (t_near : ℂ)) r_match
    have hV_τ_open : IsOpen V_τ :=
      (Metric.isOpen_ball.prod (Metric.isOpen_ball.inter isOpen_compl_singleton)).inter
        (Metric.isOpen_ball.preimage hpowMap_cont)
    have hq_near_mem : ((y_ann : ℂ), (τ_near : ℂ)) ∈ V_τ := by
      refine ⟨⟨?_, ?_, Complex.ofReal_ne_zero.mpr hτ_near_pos.ne'⟩, ?_⟩
      · refine Metric.ball_subset_ball ?_ hy_ann_ball
        have : min δ_tr δ_τ2 ≤ δ_τ2 := min_le_right _ _
        dsimp [δ_y2]; linarith
      · rw [Metric.mem_ball, dist_zero_right, Complex.norm_real, Real.norm_eq_abs,
          abs_of_pos hτ_near_pos]
        linarith
      · change ((y_ann : ℂ), (τ_near : ℂ) ^ G.d) ∈
          Metric.ball ((y_ann : ℂ), (t_near : ℂ)) r_match
        have hp_eq : ((τ_near : ℂ) ^ G.d) = (t_near : ℂ) := by
          rw [← Complex.ofReal_pow, hτ_near_pow]
        rw [hp_eq]
        exact Metric.mem_ball_self hr_match_pos
    exact G.puis_poly_transfer y_ann t_near r_match M_even ht_near_pos hr_match_pos
      (Set.Subset.trans hmatch_ball_sub hann_sub_dom)
      (fun ι => (hM_even_holo ι).mono hmatch_ball_sub)
      ⟨V_τ, hV_τ_open, ⟨((y_ann : ℂ), (τ_near : ℂ)), hq_near_mem⟩,
        fun q hq => hB_τ2_punc_sub_G q ⟨hq.1.1, hq.1.2.1⟩ hq.1.2.2,
        fun q hq => ⟨hq.2, fun ι => by
          have hD_nz : D_tr (powMap q) ≠ 0 := hU_ann_D_nz (powMap q) (hmatch_ball_sub hq.2)
          have href := hReflect_eq q ⟨hq.1.1, hq.1.2.1⟩ hq.1.2.2 ι
          dsimp only [M_even, powMap] at href ⊢
          exact (eq_div_iff hD_nz).mpr (by rw [mul_comm]; exact href)⟩⟩

  exact ⟨{
    y_ann := y_ann
    δ_y := δ_y
    t_near := t_near
    r_match := r_match
    δ_y_pos := hδ_y_pos
    t_near_pos := ht_near_pos
    r_match_pos := hr_match_pos
    ann_sub_dom := hann_sub_dom
    match_ball_sub := hmatch_ball_sub
    M_even := M_even
    M_even_holo := hM_even_holo
    M_even_symm := hM_even_symm
    poly_transfer := hpoly_transfer
  }⟩

theorem loop_involution_polynomial_reflection (Ω : Set Plane)
    (C : AnalyticGlancingCollar Ω)
    (hDet : EndpointDeterminationData C)
    (W : CollarWidthTubeData C hDet)
    (t₂ : ℝ)
    (D_wall : AlignedWallDefectData W t₂) :
    PolyReflectionProp C W.s_base W.r_base D_wall.K :=
by
  intro N_idx M D q_idx ι_star Q hSym J_bound V_dom hPolyPlus p hp
  change p ∈ symCollarDom W.s_base W.r_base q_idx at hp
  have hKit : Holo2DAndTaylorToolkit := holo_2d_and_taylor_toolkit
  obtain ⟨B_col⟩ := base_collar_billiard_reflection_and_envelope Ω C hDet hKit
  obtain ⟨Br⟩ :=
    wall_loop_descent_to_punctured_collar Ω C hDet W hKit t₂ D_wall N_idx q_idx
      (fun a => (hSym a).1)
  obtain ⟨Ann⟩ :=
    puiseux_wronskian_compact_annulus_evenness Ω C hDet W hKit t₂ D_wall N_idx q_idx B_col Br
  let S_nat : ℕ := Finset.univ.sup fun a : Fin N_idx => (q_idx a).natAbs
  have hJ_eq : J_bound = (S_nat : ℝ) + 2 := rfl
  have hS_nonneg : (0 : ℝ) ≤ (S_nat : ℝ) := Nat.cast_nonneg S_nat
  have hJ_ge_two : (2 : ℝ) ≤ J_bound := by linarith [hJ_eq, hS_nonneg]
  have hJ_pos : (0 : ℝ) < J_bound := by linarith
  have h2J_pos : (0 : ℝ) < 2 * J_bound := by linarith
  have hDom_neg : ∀ q : ℂ × ℂ, q ∈ symCollarDom W.s_base W.r_base q_idx →
      (q.1, -q.2) ∈ symCollarDom W.s_base W.r_base q_idx := by
    intro q hq
    rcases hq with ⟨hq1, hq2, hq3⟩
    refine ⟨hq1, ?_, ?_⟩
    · simpa only [norm_neg] using hq2
    · simpa only [Complex.neg_im, abs_neg] using hq3
  have hDom_t : ∀ q : ℂ × ℂ, q ∈ symCollarDom W.s_base W.r_base q_idx →
      ‖q.2‖ < 2 * hDet.r_det := by
    intro q hq
    linarith [hq.2.1, W.r_base_le_det, hDet.r_det_pos]
  have hDom_shift : ∀ q : ℂ × ℂ, q ∈ symCollarDom W.s_base W.r_base q_idx →
      ∀ a : Fin N_idx,
        |(q.1 + (q_idx a : ℂ) * q.2).im| < 2 * hDet.s_det ∧
        |(q.1 - (q_idx a : ℂ) * q.2).im| < 2 * hDet.s_det := by
    intro q hq a
    rcases hq with ⟨hq1, _, hq3⟩
    have ha_nat : (q_idx a).natAbs ≤ S_nat :=
      Finset.le_sup (f := fun b : Fin N_idx => (q_idx b).natAbs) (Finset.mem_univ a)
    have ha_cast : (((q_idx a).natAbs : ℕ) : ℝ) ≤ (S_nat : ℝ) := Nat.cast_le.mpr ha_nat
    have ha_abs : |(q_idx a : ℝ)| = (((q_idx a).natAbs : ℕ) : ℝ) := by
      rcases Int.natAbs_eq (q_idx a) with h | h
      · have hR := congrArg (Int.cast (R := ℝ)) h
        rw [Int.cast_natCast] at hR
        rw [hR, abs_of_nonneg (Nat.cast_nonneg _)]
      · have hR := congrArg (Int.cast (R := ℝ)) h
        rw [Int.cast_neg, Int.cast_natCast] at hR
        rw [hR, abs_neg, abs_of_nonneg (Nat.cast_nonneg _)]
    have ha_le_J : |(q_idx a : ℝ)| ≤ J_bound := by linarith [ha_abs, ha_cast, hJ_eq]
    have hq3_mul : |q.2.im| * (2 * J_bound) < W.s_base :=
      (lt_div_iff₀ h2J_pos).mp hq3
    have hJ_im : J_bound * |q.2.im| < W.s_base / 2 := by linarith
    have hqa_im : |((q_idx a : ℂ) * q.2).im| < W.s_base / 2 := by
      have him_eq : ((q_idx a : ℂ) * q.2).im = (q_idx a : ℝ) * q.2.im := by
        simp [Complex.mul_im]
      rw [him_eq, abs_mul]
      exact lt_of_le_of_lt (mul_le_mul_of_nonneg_right ha_le_J (abs_nonneg _)) hJ_im
    have h_add : |(q.1 + (q_idx a : ℂ) * q.2).im| ≤ |q.1.im| + |((q_idx a : ℂ) * q.2).im| := by
      simpa only [Complex.add_im] using abs_add_le q.1.im ((q_idx a : ℂ) * q.2).im
    have h_sub : |(q.1 - (q_idx a : ℂ) * q.2).im| ≤ |q.1.im| + |((q_idx a : ℂ) * q.2).im| := by
      rw [Complex.sub_im, sub_eq_add_neg]
      simpa only [abs_neg] using abs_add_le q.1.im (-((q_idx a : ℂ) * q.2).im)
    exact ⟨by linarith [W.s_base_le_det, hDet.s_det_pos],
      by linarith [W.s_base_le_det, hDet.s_det_pos]⟩
  let neg_idx : Fin N_idx → Fin N_idx := fun a => Classical.choose (hSym a).2
  have hneg_idx : ∀ a : Fin N_idx, q_idx (neg_idx a) = -q_idx a :=
    fun a => Classical.choose_spec (hSym a).2
  let σ_bind : SymJetVar N_idx M → MvPolynomial (SymJetVar N_idx M) ℂ :=
    fun v => MvPolynomial.C ((-1 : ℂ) ^ v.2.2.2.1) *
      MvPolynomial.X (neg_idx v.1, v.2.1, v.2.2.1, v.2.2.2)
  let Q_refl : Fin (D + 1) → MvPolynomial (SymJetVar N_idx M) ℂ :=
    fun d => MvPolynomial.bind₁ σ_bind (Q d)
  have hEvalRefl : ∀ q ∈ symCollarDom W.s_base W.r_base q_idx,
      ∀ P : MvPolynomial (SymJetVar N_idx M) ℂ,
        MvPolynomial.eval (symJetEnv C q_idx M (q.1, -q.2)) P =
          MvPolynomial.eval (symJetEnv C q_idx M q) (MvPolynomial.bind₁ σ_bind P) := by
    intro q hq P
    have h_env :
        (fun v : SymJetVar N_idx M =>
          (MvPolynomial.eval₂Hom (RingHom.id ℂ) (symJetEnv C q_idx M q)) (σ_bind v)) =
        symJetEnv C q_idx M (q.1, -q.2) := by
      funext v
      change MvPolynomial.eval (symJetEnv C q_idx M q) (σ_bind v) =
        symJetEnv C q_idx M (q.1, -q.2) v
      simp only [σ_bind, map_mul, MvPolynomial.eval_C, MvPolynomial.eval_X]
      exact (B_col.symJet_neg_t q_idx neg_idx M q hneg_idx (hDom_t q hq) (hDom_shift q hq) v).symm
    change (MvPolynomial.eval₂Hom (RingHom.id ℂ) (symJetEnv C q_idx M (q.1, -q.2))) P =
      (MvPolynomial.eval₂Hom (RingHom.id ℂ) (symJetEnv C q_idx M q))
        (MvPolynomial.bind₁ σ_bind P)
    rw [MvPolynomial.eval₂Hom_bind₁, h_env]
  have hPlusShift : ∀ q ∈ symCollarDom W.s_base W.r_base q_idx,
      ∑ d : Fin (D + 1),
        MvPolynomial.eval (symJetEnv C q_idx M q) (Q d) *
          (dualLineShift C 1 ι_star q) ^ (d : ℕ) = 0 := by
    intro q hq
    have h_arg : q.1 + ((1 : ℤ) : ℂ) * q.2 = q.1 + q.2 := by push_cast; ring
    simpa only [dualLineShift, h_arg] using hPolyPlus q hq
  have hOnBPlus_Q :
      ∀ q ∈ Metric.ball ((Ann.y_ann : ℂ), (Ann.t_near : ℂ)) Ann.r_match,
        ∑ d : Fin (D + 1),
          MvPolynomial.eval (symJetEnv C q_idx M q) (Q d) *
            (Ann.M_even ι_star q) ^ (d : ℕ) = 0 :=
    (Ann.poly_transfer M D ι_star Q).mp ((Br.poly_transfer M D ι_star Q).mp hPlusShift)
  let A_t : Set ℂ := { t : ℂ | Ann.t_near / 2 < ‖t‖ ∧ ‖t‖ < 3 * Ann.t_near / 2 }
  let U_ann : Set (ℂ × ℂ) := Metric.ball (Ann.y_ann : ℂ) Ann.δ_y ×ˢ A_t
  let B_minus : Set (ℂ × ℂ) :=
    Metric.ball ((Ann.y_ann : ℂ), -(Ann.t_near : ℂ)) Ann.r_match
  let Φ_refl : ℂ × ℂ → ℂ := fun q =>
    ∑ d : Fin (D + 1),
      MvPolynomial.eval (symJetEnv C q_idx M q) (Q_refl d) *
        (Ann.M_even ι_star q) ^ (d : ℕ)
  have hB_minus_neg_mem : ∀ q ∈ B_minus,
      (q.1, -q.2) ∈ Metric.ball ((Ann.y_ann : ℂ), (Ann.t_near : ℂ)) Ann.r_match := by
    intro q hq
    rw [Metric.mem_ball, Prod.dist_eq] at hq ⊢
    refine max_lt (lt_of_le_of_lt (le_max_left _ _) hq) ?_
    have hdist : dist (-q.2) (Ann.t_near : ℂ) = dist q.2 (-(Ann.t_near : ℂ)) := by
      simp only [dist_eq_norm]
      rw [show -q.2 - (Ann.t_near : ℂ) = -(q.2 - -(Ann.t_near : ℂ)) by ring, norm_neg]
    rw [hdist]
    exact lt_of_le_of_lt (le_max_right _ _) hq
  have hB_minus_sub : B_minus ⊆ U_ann := by
    intro q hq
    have hq_neg : (q.1, -q.2) ∈ U_ann := Ann.match_ball_sub (hB_minus_neg_mem q hq)
    exact ⟨hq_neg.1,
      ⟨by simpa only [norm_neg] using hq_neg.2.1,
       by simpa only [norm_neg] using hq_neg.2.2⟩⟩
  have hΦ_zero_B_minus : ∀ q ∈ B_minus, Φ_refl q = 0 := by
    intro q hq
    have hq_ann : q ∈ U_ann := hB_minus_sub hq
    have hq_dom : q ∈ symCollarDom W.s_base W.r_base q_idx := Ann.ann_sub_dom hq_ann
    have h_neg := hOnBPlus_Q (q.1, -q.2) (hB_minus_neg_mem q hq)
    have h_eq :
        (∑ d : Fin (D + 1),
          MvPolynomial.eval (symJetEnv C q_idx M (q.1, -q.2)) (Q d) *
            (Ann.M_even ι_star (q.1, -q.2)) ^ (d : ℕ)) = Φ_refl q := by
      refine Finset.sum_congr rfl (fun d _ => ?_)
      rw [hEvalRefl q hq_dom (Q d), Ann.M_even_symm ι_star q hq_ann]
    rw [← h_eq]
    exact h_neg
  have hDom_open : IsOpen (symCollarDom W.s_base W.r_base q_idx) := by
    refine IsOpen.inter ?_ (IsOpen.inter ?_ ?_)
    · exact isOpen_lt (continuous_abs.comp (Complex.continuous_im.comp continuous_fst))
        continuous_const
    · exact isOpen_lt (continuous_norm.comp continuous_snd) continuous_const
    · exact isOpen_lt (continuous_abs.comp (Complex.continuous_im.comp continuous_snd))
        continuous_const
  have hJet_holo : ∀ v : SymJetVar N_idx M,
      DifferentiableOn ℂ (fun q => symJetEnv C q_idx M q v)
        (symCollarDom W.s_base W.r_base q_idx) := by
    intro v
    have hAff_diff : Differentiable ℂ
        (fun r : ℂ × ℂ => (r.1 + (q_idx v.1 : ℂ) * r.2, r.2)) :=
      (differentiable_fst.add ((differentiable_const _).mul differentiable_snd)).prodMk
        differentiable_snd
    have hAff_maps : Set.MapsTo
        (fun r : ℂ × ℂ => (r.1 + (q_idx v.1 : ℂ) * r.2, r.2))
        (symCollarDom W.s_base W.r_base q_idx)
        { w : ℂ × ℂ | |w.1.im| < 2 * hDet.s_det ∧ ‖w.2‖ < 2 * hDet.r_det } := by
      intro r hr
      exact ⟨(hDom_shift r hr v.1).1, hDom_t r hr⟩
    have hShift_holo : DifferentiableOn ℂ
        (fun r : ℂ × ℂ => glancingDualLine C (r.1 + (q_idx v.1 : ℂ) * r.2) r.2 v.2.1)
        (symCollarDom W.s_base W.r_base q_idx) := by
      change DifferentiableOn ℂ
        ((fun w : ℂ × ℂ => glancingDualLine C w.1 w.2 v.2.1) ∘
          (fun r : ℂ × ℂ => (r.1 + (q_idx v.1 : ℂ) * r.2, r.2)))
        (symCollarDom W.s_base W.r_base q_idx)
      exact (hDet.dualLine_holo v.2.1).comp hAff_diff.differentiableOn hAff_maps
    exact hKit.iterDerivYT_holo hDom_open hShift_holo v.2.2.1.1 v.2.2.2.1
  have hEval_holo : ∀ P : MvPolynomial (SymJetVar N_idx M) ℂ,
      DifferentiableOn ℂ (fun q => MvPolynomial.eval (symJetEnv C q_idx M q) P)
        (symCollarDom W.s_base W.r_base q_idx) := by
    intro P
    refine MvPolynomial.induction_on
      (motive := fun Q_p => DifferentiableOn ℂ
        (fun q => MvPolynomial.eval (symJetEnv C q_idx M q) Q_p)
        (symCollarDom W.s_base W.r_base q_idx))
      P
      (fun c => by
        simpa only [MvPolynomial.eval_C] using
          (differentiableOn_const c :
            DifferentiableOn ℂ (fun _ : ℂ × ℂ => c) (symCollarDom W.s_base W.r_base q_idx)))
      (fun P₁ P₂ ih₁ ih₂ => by
        have hfn :
            (fun q => MvPolynomial.eval (symJetEnv C q_idx M q) (P₁ + P₂)) =
              (fun q => MvPolynomial.eval (symJetEnv C q_idx M q) P₁ +
                MvPolynomial.eval (symJetEnv C q_idx M q) P₂) := by
          ext q
          exact map_add _ P₁ P₂
        rw [hfn]
        exact ih₁.add ih₂)
      (fun P₁ v ih => by
        have hfn :
            (fun q => MvPolynomial.eval (symJetEnv C q_idx M q) (P₁ * MvPolynomial.X v)) =
              (fun q => MvPolynomial.eval (symJetEnv C q_idx M q) P₁ *
                symJetEnv C q_idx M q v) := by
          ext q
          simp only [map_mul, MvPolynomial.eval_X]
        rw [hfn]
        exact ih.mul (hJet_holo v))
  have hΦ_holo : DifferentiableOn ℂ Φ_refl U_ann := by
    have h_sum : ∀ s : Finset (Fin (D + 1)),
        DifferentiableOn ℂ
          (fun q => ∑ d ∈ s,
            MvPolynomial.eval (symJetEnv C q_idx M q) (Q_refl d) *
              (Ann.M_even ι_star q) ^ (d : ℕ)) U_ann := by
      intro s
      induction s using Finset.induction_on with
      | empty =>
        have h_fn0 :
            (fun q : ℂ × ℂ => ∑ d ∈ (∅ : Finset (Fin (D + 1))),
              MvPolynomial.eval (symJetEnv C q_idx M q) (Q_refl d) *
                (Ann.M_even ι_star q) ^ (d : ℕ)) =
            (fun _ : ℂ × ℂ => (0 : ℂ)) := by
          ext q
          exact Finset.sum_empty
        rw [h_fn0]
        exact differentiableOn_const (0 : ℂ)
      | @insert d s hd ih =>
        have h_term : DifferentiableOn ℂ
            (fun q => MvPolynomial.eval (symJetEnv C q_idx M q) (Q_refl d) *
              (Ann.M_even ι_star q) ^ (d : ℕ)) U_ann :=
          ((hEval_holo (Q_refl d)).mono Ann.ann_sub_dom).mul
            ((Ann.M_even_holo ι_star).pow (d : ℕ))
        have h_fn :
            (fun q => ∑ j ∈ insert d s,
              MvPolynomial.eval (symJetEnv C q_idx M q) (Q_refl j) *
                (Ann.M_even ι_star q) ^ (j : ℕ)) =
            (fun q =>
              MvPolynomial.eval (symJetEnv C q_idx M q) (Q_refl d) *
                (Ann.M_even ι_star q) ^ (d : ℕ) +
              ∑ j ∈ s,
                MvPolynomial.eval (symJetEnv C q_idx M q) (Q_refl j) *
                  (Ann.M_even ι_star q) ^ (j : ℕ)) := by
          ext q
          exact Finset.sum_insert hd
        rw [h_fn]
        exact h_term.add ih
    exact h_sum Finset.univ
  have hU_ann_open : IsOpen U_ann := by
    refine Metric.isOpen_ball.prod (IsOpen.inter ?_ ?_)
    · exact isOpen_lt continuous_const continuous_norm
    · exact isOpen_lt continuous_norm continuous_const
  have hA_t_preconn : IsPreconnected A_t := by
    let φ_pol : ℝ × ℝ → ℂ := fun x => (x.1 : ℂ) * Complex.exp (Complex.I * (x.2 : ℂ))
    let S_pol : Set (ℝ × ℝ) :=
      Set.Ioo (Ann.t_near / 2) (3 * Ann.t_near / 2) ×ˢ (Set.univ : Set ℝ)
    have hS_preconn : IsPreconnected S_pol :=
      ((convex_Ioo (Ann.t_near / 2) (3 * Ann.t_near / 2)).prod convex_univ).isPreconnected
    have hφ_cont : Continuous φ_pol :=
      (Complex.continuous_ofReal.comp continuous_fst).mul
        (Complex.continuous_exp.comp
          (continuous_const.mul (Complex.continuous_ofReal.comp continuous_snd)))
    have h_img : φ_pol '' S_pol = A_t := by
      ext t
      constructor
      · rintro ⟨⟨r, θ⟩, ⟨⟨hr1, hr2⟩, -⟩, rfl⟩
        have hr_pos : 0 < r := by linarith [Ann.t_near_pos]
        have hnorm : ‖φ_pol (r, θ)‖ = r := by
          dsimp [φ_pol]
          rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hr_pos,
            Complex.norm_exp_I_mul_ofReal, mul_one]
        exact ⟨by simpa only [hnorm] using hr1, by simpa only [hnorm] using hr2⟩
      · intro ⟨ht1, ht2⟩
        refine ⟨(‖t‖, t.arg), ⟨⟨ht1, ht2⟩, trivial⟩, ?_⟩
        dsimp [φ_pol]
        rw [mul_comm Complex.I (t.arg : ℂ)]
        exact Complex.norm_mul_exp_arg_mul_I t
    rw [← h_img]
    exact hS_preconn.image φ_pol hφ_cont.continuousOn
  have hU_ann_preconn : IsPreconnected U_ann :=
    (convex_ball (Ann.y_ann : ℂ) Ann.δ_y).isPreconnected.prod hA_t_preconn
  have hΦ_zero_ann : ∀ q ∈ U_ann, Φ_refl q = 0 :=
    hKit.eqOn_zero_of_preconnected_2D hU_ann_open hU_ann_preconn
      Metric.isOpen_ball (Metric.nonempty_ball.mpr Ann.r_match_pos)
      hB_minus_sub hΦ_holo hΦ_zero_B_minus
  have hOnBPlus_Qrefl :
      ∀ q ∈ Metric.ball ((Ann.y_ann : ℂ), (Ann.t_near : ℂ)) Ann.r_match,
        ∑ d : Fin (D + 1),
          MvPolynomial.eval (symJetEnv C q_idx M q) (Q_refl d) *
            (Ann.M_even ι_star q) ^ (d : ℕ) = 0 :=
    fun q hq => hΦ_zero_ann q (Ann.match_ball_sub hq)
  have hReflShift :
      ∀ q ∈ symCollarDom W.s_base W.r_base q_idx,
        ∑ d : Fin (D + 1),
          MvPolynomial.eval (symJetEnv C q_idx M q) (Q_refl d) *
            (dualLineShift C 1 ι_star q) ^ (d : ℕ) = 0 :=
    (Br.poly_transfer M D ι_star Q_refl).mpr
      ((Ann.poly_transfer M D ι_star Q_refl).mpr hOnBPlus_Qrefl)
  have hp_neg : (p.1, -p.2) ∈ symCollarDom W.s_base W.r_base q_idx := hDom_neg p hp
  have h_at_neg := hReflShift (p.1, -p.2) hp_neg
  have h_sub_im : |(p.1 - p.2).im| < 2 * hDet.s_det := by
    rcases hp with ⟨hp1, _, hp3⟩
    have hp3_mul : |p.2.im| * (2 * J_bound) < W.s_base := (lt_div_iff₀ h2J_pos).mp hp3
    have h4_le : 4 * |p.2.im| ≤ |p.2.im| * (2 * J_bound) := by nlinarith [abs_nonneg p.2.im]
    have hp3_quarter : |p.2.im| < W.s_base / 4 := by linarith
    have h_tri : |(p.1 - p.2).im| ≤ |p.1.im| + |p.2.im| := by
      rw [Complex.sub_im, sub_eq_add_neg]
      simpa only [abs_neg] using abs_add_le p.1.im (-p.2.im)
    linarith [W.s_base_le_det, hDet.s_det_pos]
  have h_dual_neg :
      dualLineShift C 1 ι_star (p.1, -p.2) = glancingDualLine C (p.1 - p.2) p.2 ι_star := by
    change glancingDualLine C (p.1 + ((1 : ℤ) : ℂ) * (-p.2)) (-p.2) ι_star =
      glancingDualLine C (p.1 - p.2) p.2 ι_star
    have h_arg : p.1 + ((1 : ℤ) : ℂ) * (-p.2) = p.1 - p.2 := by push_cast; ring
    rw [h_arg]
    exact B_col.dualLine_even (p.1 - p.2) p.2 h_sub_im (hDom_t p hp) ι_star
  have h_sum_eq :
      (∑ d : Fin (D + 1),
        MvPolynomial.eval (symJetEnv C q_idx M (p.1, -p.2)) (Q_refl d) *
          (dualLineShift C 1 ι_star (p.1, -p.2)) ^ (d : ℕ)) =
      ∑ d : Fin (D + 1),
        MvPolynomial.eval (symJetEnv C q_idx M p) (Q d) *
          (glancingDualLine C (p.1 - p.2) p.2 ι_star) ^ (d : ℕ) := by
    refine Finset.sum_congr rfl (fun d _ => ?_)
    have h_eval_back :
        MvPolynomial.eval (symJetEnv C q_idx M (p.1, -p.2)) (Q_refl d) =
          MvPolynomial.eval (symJetEnv C q_idx M p) (Q d) := by
      have h1 := hEvalRefl (p.1, -p.2) hp_neg (Q d)
      simpa only [neg_neg, Prod.mk.eta] using h1.symm
    rw [h_eval_back, h_dual_neg]
  rw [← h_sum_eq]
  exact h_at_neg

theorem differential_shear_root_contradiction (Ω : Set Plane)
    (C : AnalyticGlancingCollar Ω)
    (hDet : EndpointDeterminationData C)
    (s_b r_b : ℝ)
    (hs_pos : 0 < s_b)
    (hs_le : s_b ≤ hDet.s_det)
    (hr_pos : 0 < r_b)
    (hr_le : r_b ≤ hDet.r_det)
    (hr_lt : r_b < s_b / 4)
    (K : ℕ)
    (hRefl : PolyReflectionProp C s_b r_b K) :
    False :=
by
  let _ := hr_lt
  
  obtain ⟨k_pderiv_holo, k_iterYT_holo, k_iterYT_step, k_taylor2D_congr,
      k_eqOn_preconn, k_eqOn_taylor0, k_taylor_alg, k_mv_leib, k_mv_taylor⟩ :
    (∀ {U : Set (ℂ × ℂ)}, IsOpen U → ∀ {f : ℂ × ℂ → ℂ},
      DifferentiableOn ℂ f U →
      DifferentiableOn ℂ (pderivA f) U ∧ DifferentiableOn ℂ (pderivD f) U) ∧
    (∀ {U : Set (ℂ × ℂ)}, IsOpen U → ∀ {f : ℂ × ℂ → ℂ},
      DifferentiableOn ℂ f U → ∀ α β : ℕ, DifferentiableOn ℂ (iterDerivYT α β f) U) ∧
    (∀ {U : Set (ℂ × ℂ)}, IsOpen U → ∀ {f : ℂ × ℂ → ℂ},
      DifferentiableOn ℂ f U → ∀ (α β : ℕ), ∀ p ∈ U,
        iterDerivYT (α + 1) β f p = iterDerivYT α β (pderivA f) p ∧
        iterDerivYT α (β + 1) f p = iterDerivYT α β (pderivD f) p ∧
        pderivA (iterDerivYT α β f) p = iterDerivYT (α + 1) β f p ∧
        pderivD (iterDerivYT α β f) p = iterDerivYT α (β + 1) f p) ∧
    (∀ {U : Set (ℂ × ℂ)}, IsOpen U → ∀ {p₀ : ℂ × ℂ}, p₀ ∈ U →
      ∀ {f₁ f₂ : ℂ × ℂ → ℂ}, (∀ p ∈ U, f₁ p = f₂ p) → taylor2D f₁ p₀ = taylor2D f₂ p₀) ∧
    (∀ {W V : Set (ℂ × ℂ)},
      IsOpen W → IsPreconnected W → IsOpen V → V.Nonempty → V ⊆ W →
      ∀ {f : ℂ × ℂ → ℂ}, DifferentiableOn ℂ f W → (∀ p ∈ V, f p = 0) → ∀ p ∈ W, f p = 0) ∧
    (∀ {W : Set (ℂ × ℂ)},
      IsOpen W → IsPreconnected W → ∀ {p₀ : ℂ × ℂ}, p₀ ∈ W →
      ∀ {f : ℂ × ℂ → ℂ}, DifferentiableOn ℂ f W → taylor2D f p₀ = 0 → ∀ p ∈ W, f p = 0) ∧
    (∀ {U : Set (ℂ × ℂ)}, IsOpen U → ∀ {p₀ : ℂ × ℂ}, p₀ ∈ U →
      (∀ c : ℂ, taylor2D (fun _ => c) p₀ = MvPowerSeries.C c) ∧
      (∀ {f g : ℂ × ℂ → ℂ}, DifferentiableOn ℂ f U → DifferentiableOn ℂ g U →
        taylor2D (fun p => f p + g p) p₀ = taylor2D f p₀ + taylor2D g p₀ ∧
        taylor2D (fun p => f p - g p) p₀ = taylor2D f p₀ - taylor2D g p₀ ∧
        taylor2D (fun p => f p * g p) p₀ = taylor2D f p₀ * taylor2D g p₀)) ∧
    ((∀ Φ Ψ : MvPowerSeries (Fin 2) ℂ,
        mvDerivA (Φ + Ψ) = mvDerivA Φ + mvDerivA Ψ ∧
        mvDerivD (Φ + Ψ) = mvDerivD Φ + mvDerivD Ψ ∧
        mvDerivA (Φ * Ψ) = mvDerivA Φ * Ψ + Φ * mvDerivA Ψ ∧
        mvDerivD (Φ * Ψ) = mvDerivD Φ * Ψ + Φ * mvDerivD Ψ) ∧
      (∀ {U : Set (ℂ × ℂ)}, IsOpen U → ∀ {p₀ : ℂ × ℂ}, p₀ ∈ U →
        ∀ {f : ℂ × ℂ → ℂ}, DifferentiableOn ℂ f U →
          mvDerivA (taylor2D f p₀) = taylor2D (pderivA f) p₀ ∧
          mvDerivD (taylor2D f p₀) = taylor2D (pderivD f) p₀)) := by
    let π₁ : (ℂ × ℂ) →L[ℂ] ℂ := ContinuousLinearMap.fst ℂ ℂ ℂ
    let π₂ : (ℂ × ℂ) →L[ℂ] ℂ := ContinuousLinearMap.snd ℂ ℂ ℂ
    have hπ₁_norm : ‖π₁‖ ≤ 1 :=
      ContinuousLinearMap.opNorm_le_bound π₁ zero_le_one (fun q => by simpa [π₁] using norm_fst_le q)
    have hπ₂_norm : ‖π₂‖ ≤ 1 :=
      ContinuousLinearMap.opNorm_le_bound π₂ zero_le_one (fun q => by simpa [π₂] using norm_snd_le q)
    have hparam_int_holo : ∀ (p₀ : ℂ × ℂ) (r B : ℝ), 0 < r → ∀ (c : ℂ) (g : ℂ × ℂ → ℂ)
