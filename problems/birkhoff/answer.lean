      let B_const : ℝ := (2 * r * (r⁻¹ * r⁻¹)) * (M / r) + M * (2 * r * (2 * (r⁻¹ ^ 3)))
      have hF'_bnd : ∀ θ : ℝ, ∀ p ∈ Metric.ball p₀ r, ‖F' p θ‖ ≤ B_const := by
        intro θ p hp
        obtain ⟨_, hp2⟩ := hp_ball hp
        have hsep : r ≤ ‖γ θ - p.1‖ := le_of_lt (hp_sep p hp θ)
        have hinv_le : ‖(γ θ - p.1)⁻¹‖ ≤ r⁻¹ := by
