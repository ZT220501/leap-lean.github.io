    have hc_step : IsRealJetPerturb p (8 / (q : ℝ)) (fun _ => 2 * Real.pi / (q : ℝ)) := by
      refine hJet_mono ?_ (hJet_const (2 * Real.pi / (q : ℝ)))
      rw [abs_of_pos (div_pos (by positivity) hq_pos)]
      exact div_le_div_of_nonneg_right (by linarith [Real.pi_lt_four]) (le_of_lt hq_pos)
    have ht : IsRealJetPerturb p (9 / (q : ℝ))
