      intro x
      have hx_mem : (x : ℂ) ∈ horizStrip (2 * C.s₀) := by simp [horizStrip, C.s₀_pos]
      have hanal_x : AnalyticAt ℂ C.ϕ_ℂ (x : ℂ) := hϕ_anal (x : ℂ) hx_mem
      have hne_x : deriv C.ϕ_ℂ (x : ℂ) ≠ 0 := C.ϕ_ℂ_deriv_ne_zero (x : ℂ) hx_mem
