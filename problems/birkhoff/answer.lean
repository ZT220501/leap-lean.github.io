      h_it_tay a b h₁ p, h_it_tay a b h₂ p]
    ring
  have h_it_shear : ∀ {U : Set (ℂ × ℂ)}, IsOpen U → ∀ (m : ℤ) (β α : ℕ) {f : ℂ × ℂ → ℂ},
      DifferentiableOn ℂ f U → ∀ {p : ℂ × ℂ}, σ m p ∈ U →
        iterDerivYT α β f (σ m p) =
          ∑ r ∈ Finset.range (β + 1),
            (β.choose r : ℂ) * (-(m : ℂ)) ^ (β - r) *
              iterDerivYT (α + β - r) r (f ∘ σ m) p := by
    intro U hU m β
    have hUm : IsOpen ((σ m) ⁻¹' U) := hU.preimage (hσ_cont m)
