  have hRealMem : ∀ {σ' : ℝ}, 0 < σ' → ∀ x : ℝ, (x : ℂ) ∈ horizStrip σ' := by
    intro σ' hσ' x
    change |(x : ℂ).im| < σ'
    simpa using hσ'
