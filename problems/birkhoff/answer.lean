      refine (hδ_pos_ev.and hpos_ev).mono fun δ ⟨hδ, hre⟩ => ?_
      have hδ_ne : (δ : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (ne_of_gt hδ)
      have h_id : Δx₀ δ i = (δ : ℂ) * (Δx₀ δ i / (δ : ℂ)) := (mul_div_cancel₀ _ hδ_ne).symm
      have hre_pos : 0 < (Δx₀ δ i).re := by
