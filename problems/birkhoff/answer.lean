    have hOpenStrip_i : ∀ i : ℕ, IsOpen (horizStrip (s_seq i)) :=
      fun i => isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const
    let D_inf : ℕ → ℂ → ℂ → ℂ := fun k t y =>
      ∑' i : ℕ, iteratedDeriv k (fun y' : ℂ => ΔU_seq i (y', t)) y
    have hΔ_y_holo : ∀ (i k : ℕ) (t : ℂ), ‖t‖ < d_lim →
        DifferentiableOn ℂ (iteratedDeriv k (fun y' : ℂ => ΔU_seq i (y', t))) (horizStrip s_lim) ∧
        (∀ y ∈ horizStrip s_lim,
          HasDerivAt (iteratedDeriv k (fun y' : ℂ => ΔU_seq i (y', t)))
            (iteratedDeriv (k + 1) (fun y' : ℂ => ΔU_seq i (y', t)) y) y) := by
      intro i k t ht
      let g : ℂ → ℂ := fun y' => ΔU_seq i (y', t)
      have hg_holo : DifferentiableOn ℂ g (horizStrip (s_seq (i + 1))) := by
        refine (hΔU_spec i).1.comp (differentiable_id.prodMk (differentiable_const t)).differentiableOn ?_
        intro y' hy'
        exact ⟨ht.trans (hd_seq_bounds (i + 1)).1, by change |y'.im| < s_seq (i + 1) at hy'; simpa using hy'⟩
      have h_iter_diff : ∀ m : ℕ, DifferentiableOn ℂ (iteratedDeriv m g) (horizStrip (s_seq (i + 1))) := by
        intro m; induction m with
        | zero => simpa [iteratedDeriv_zero] using hg_holo
        | succ m ihm =>
            rw [iteratedDeriv_succ]
            exact ihm.deriv (hOpenStrip_i (i + 1))
      have hsub_strip : horizStrip s_lim ⊆ horizStrip (s_seq (i + 1)) :=
        fun y hy => lt_trans hy (hs_seq_bounds (i + 1)).1
      refine ⟨(h_iter_diff k).mono hsub_strip, fun y hy => ?_⟩
      have hda : DifferentiableAt ℂ (iteratedDeriv k g) y :=
        (h_iter_diff k).differentiableAt ((hOpenStrip_i (i + 1)).mem_nhds (hsub_strip hy))
      rw [iteratedDeriv_succ]
      exact hda.hasDerivAt
    have hS_iter_eq : ∀ (k : ℕ), k ≤ 3 → ∀ (t : ℂ), ‖t‖ < d_lim → ∀ y ∈ horizStrip s_lim,
        iteratedDeriv k (fun y' : ℂ => S_inf (y', t)) y = D_inf k t y := by
      intro k hk; induction k with
      | zero =>
          intro t _ y _
          simp [D_inf, S_inf, iteratedDeriv_zero]
      | succ k ih =>
          intro t ht y hy
          have hk_le : k ≤ 3 := by omega
          have hk1_le : k + 1 ≤ 3 := hk
          let f_part : ℕ → ℂ → ℂ := fun n z =>
            ∑ i ∈ Finset.range n, iteratedDeriv k (fun y' : ℂ => ΔU_seq i (y', t)) z
          have hbound_k : ∀ (i : ℕ), ∀ z ∈ horizStrip s_lim,
              ‖iteratedDeriv k (fun y' : ℂ => ΔU_seq i (y', t)) z‖ ≤ stepBound i :=
            fun i z hz => (hΔU_spec i).2.2.2.2 k hk_le z t
              (hΩ_sub_i (i + 1) ⟨ht, by change |z.im| < s_lim at hz; simpa using hz⟩)
          have hbound_k1 : ∀ (i : ℕ), ∀ z ∈ horizStrip s_lim,
              ‖iteratedDeriv (k + 1) (fun y' : ℂ => ΔU_seq i (y', t)) z‖ ≤ stepBound i :=
            fun i z hz => (hΔU_spec i).2.2.2.2 (k + 1) hk1_le z t
              (hΩ_sub_i (i + 1) ⟨ht, by change |z.im| < s_lim at hz; simpa using hz⟩)
          have hf_unif : TendstoUniformlyOn f_part (D_inf k t) Filter.atTop (horizStrip s_lim) :=
            tendstoUniformlyOn_tsum_nat hSummable_sb hbound_k
          have hderiv_unif_raw : TendstoUniformlyOn
              (fun n z => ∑ i ∈ Finset.range n, iteratedDeriv (k + 1) (fun y' : ℂ => ΔU_seq i (y', t)) z)
              (D_inf (k + 1) t) Filter.atTop (horizStrip s_lim) :=
            tendstoUniformlyOn_tsum_nat hSummable_sb hbound_k1
          have hderiv_unif : TendstoUniformlyOn (deriv ∘ f_part) (D_inf (k + 1) t)
              Filter.atTop (horizStrip s_lim) := by
            refine hderiv_unif_raw.congr (Filter.Eventually.of_forall fun n z hz => ?_)
            simp only [Function.comp_apply, f_part]
            exact ((HasDerivAt.fun_sum fun i _ => (hΔ_y_holo i k t ht).2 z hz).deriv).symm
          have hf_holo : ∀ᶠ n : ℕ in Filter.atTop, DifferentiableOn ℂ (f_part n) (horizStrip s_lim) :=
            Filter.Eventually.of_forall fun n z hz =>
              (DifferentiableAt.fun_sum fun i _ =>
                ((hΔ_y_holo i k t ht).2 z hz).differentiableAt).differentiableWithinAt
          have hf_pt : ∀ z ∈ horizStrip s_lim,
              Filter.Tendsto (fun n => f_part n z) Filter.atTop (nhds (D_inf k t z)) :=
            fun z hz => hf_unif.tendsto_at hz
          have hHasD : HasDerivAt (D_inf k t) (D_inf (k + 1) t y) y :=
            hasDerivAt_of_tendsto_locally_uniformly_on' hOpenStripLim
              hderiv_unif.tendstoLocallyUniformlyOn hf_holo hf_pt hy
          have h_eq_nhds : iteratedDeriv k (fun y' : ℂ => S_inf (y', t)) =ᶠ[nhds y] D_inf k t := by
            filter_upwards [hOpenStripLim.mem_nhds hy] with z hz
            exact ih hk_le t ht z hz
          rw [iteratedDeriv_succ, h_eq_nhds.deriv_eq, hHasD.deriv]
    have hU_lim_norm : ∀ k : ℕ, k ≤ 3 → ∀ y t : ℂ, (y, t) ∈ Ω_lim →
        ‖iteratedDeriv k (fun y' : ℂ => U_lim (y', t) - y') y‖ ≤ G.η_adm / 2 := by
      intro k hk y t hyt
      have ht : ‖t‖ < d_lim := hyt.1
      have hy : y ∈ horizStrip s_lim := by
        change |y.im| < s_lim; have := hyt.2; simp at this; exact this
      let f0 : ℂ → ℂ := fun y' => U_init (y', t) - y'
      let fS : ℂ → ℂ := fun y' => S_inf (y', t)
      have hf0_holo : DifferentiableOn ℂ f0 (horizStrip s_lim) := by
        refine (hAdm_init.1.comp (differentiable_id.prodMk (differentiable_const t)).differentiableOn ?_).sub
          differentiableOn_id
        intro y' hy'
        exact hU_init_sub ⟨ht, by change |y'.im| < s_lim at hy'; simpa using hy'⟩
      have hfS_holo : DifferentiableOn ℂ fS (horizStrip s_lim) := by
        refine hS_holo.comp (differentiable_id.prodMk (differentiable_const t)).differentiableOn ?_
        intro y' hy'
        exact ⟨ht, by change |y'.im| < s_lim at hy'; simpa using hy'⟩
      have hf0_cd : ContDiffAt ℂ (k : WithTop ℕ∞) f0 y :=
        (hf0_holo.contDiffOn hOpenStripLim).contDiffAt (hOpenStripLim.mem_nhds hy)
      have hfS_cd : ContDiffAt ℂ (k : WithTop ℕ∞) fS y :=
        (hfS_holo.contDiffOn hOpenStripLim).contDiffAt (hOpenStripLim.mem_nhds hy)
      have hfun_eq : (fun y' : ℂ => U_lim (y', t) - y') = (fun y' => f0 y' + fS y') := by
        ext y'; dsimp [U_lim, f0, fS]; ring
      rw [hfun_eq, iteratedDeriv_fun_add hf0_cd hfS_cd, hS_iter_eq k hk t ht y hy]
      have hbound_i : ∀ i : ℕ, ‖iteratedDeriv k (fun y' : ℂ => ΔU_seq i (y', t)) y‖ ≤ stepBound i :=
        fun i => (hΔU_spec i).2.2.2.2 k hk y t (hΩ_sub_i (i + 1) hyt)
      have hsum_norm : Summable (fun i : ℕ => ‖iteratedDeriv k (fun y' : ℂ => ΔU_seq i (y', t)) y‖) :=
        Summable.of_nonneg_of_le (fun _ => norm_nonneg _) hbound_i hSummable_sb
      have htsum_le : ‖D_inf k t y‖ ≤ ∑' i : ℕ, stepBound i :=
        (norm_tsum_le_tsum_norm hsum_norm).trans (hsum_norm.tsum_le_tsum hbound_i hSummable_sb)
      have h0_le : ‖iteratedDeriv k f0 y‖ ≤ G.η_adm / 4 :=
        hAdm_init.2.2.2.2 k hk y t (hU_init_sub hyt)
      calc ‖iteratedDeriv k f0 y + D_inf k t y‖
          ≤ ‖iteratedDeriv k f0 y‖ + ‖D_inf k t y‖ := norm_add_le _ _
        _ ≤ G.η_adm / 4 + G.η_adm / 4 := add_le_add h0_le (htsum_le.trans h_tsum_sb)
        _ = G.η_adm / 2 := by ring
    have hAdm_lim : IsAdmissibleGlancingCand s_lim d_lim (G.η_adm / 2) U_lim :=
      ⟨hU_lim_holo, hU_lim_qp, hU_lim_even, hU_lim_conj, hU_lim_norm⟩
    have hAdm_seq_full : ∀ n : ℕ, IsAdmissibleGlancingCand s_lim d_lim G.η_adm (U_seq n) := by
      intro n
      have hgn := (hU_seq_good n).1
      have hsub := hΩ_sub_i n
      have hη_le_full : η_seq n ≤ G.η_adm := (hη_seq_bounds n).trans (by linarith)
      exact ⟨hgn.1.mono hsub,
        fun y t hyt => hgn.2.1 y t (hsub hyt),
        fun y t hyt => hgn.2.2.1 y t (hsub hyt),
        fun y t hyt => hgn.2.2.2.1 y t (hsub hyt),
        fun k hk y t hyt => (hgn.2.2.2.2 k hk y t (hsub hyt)).trans hη_le_full⟩
    have hAdm_lim_full : IsAdmissibleGlancingCand s_lim d_lim G.η_adm U_lim :=
      ⟨hAdm_lim.1, hAdm_lim.2.1, hAdm_lim.2.2.1, hAdm_lim.2.2.2.1,
        fun k hk y t hyt => (hAdm_lim.2.2.2.2 k hk y t hyt).trans (by linarith)⟩
    have hUnif_diff : ∀ k : ℕ, k ≤ 2 →
        TendstoUniformlyOn
          (fun (n : ℕ) (p : ℂ × ℂ) =>
            iteratedDeriv k (fun y' : ℂ => U_seq n (y', p.2) - U_lim (y', p.2)) p.1)
          (fun _ => (0 : ℂ)) Filter.atTop Ω_lim := by
      intro k hk
      have hk3 : k ≤ 3 := by omega
      have h2d_bound : ∀ (i : ℕ), ∀ p ∈ Ω_lim,
          ‖iteratedDeriv k (fun y' : ℂ => ΔU_seq i (y', p.2)) p.1‖ ≤ stepBound i :=
        fun i p hp => (hΔU_spec i).2.2.2.2 k hk3 p.1 p.2 (hΩ_sub_i (i + 1) hp)
      have h2d_unif : TendstoUniformlyOn
          (fun (n : ℕ) (p : ℂ × ℂ) =>
            ∑ i ∈ Finset.range n, iteratedDeriv k (fun y' : ℂ => ΔU_seq i (y', p.2)) p.1)
          (fun p : ℂ × ℂ => D_inf k p.2 p.1) Filter.atTop Ω_lim :=
        tendstoUniformlyOn_tsum_nat hSummable_sb h2d_bound
      have h_iter_diff_eq : ∀ (n : ℕ), ∀ p ∈ Ω_lim,
          iteratedDeriv k (fun y' : ℂ => U_seq n (y', p.2) - U_lim (y', p.2)) p.1 =
            (∑ i ∈ Finset.range n, iteratedDeriv k (fun y' : ℂ => ΔU_seq i (y', p.2)) p.1) -
              D_inf k p.2 p.1 := by
        intro n p hp
        have ht : ‖p.2‖ < d_lim := hp.1
        have hy : p.1 ∈ horizStrip s_lim := by
          change |p.1.im| < s_lim; have := hp.2; simp at this; exact this
        let fn : ℂ → ℂ := fun y' => S_part n (y', p.2)
        let fS : ℂ → ℂ := fun y' => S_inf (y', p.2)
        have hfn_holo : DifferentiableOn ℂ fn (horizStrip s_lim) := by
          intro z hz
          exact (DifferentiableAt.fun_sum fun i _ =>
            ((hΔ_y_holo i 0 p.2 ht).2 z hz).differentiableAt).differentiableWithinAt
        have hfS_holo : DifferentiableOn ℂ fS (horizStrip s_lim) := by
          refine hS_holo.comp (differentiable_id.prodMk (differentiable_const p.2)).differentiableOn ?_
          intro y' hy'
          exact ⟨ht, by change |y'.im| < s_lim at hy'; simpa using hy'⟩
        have hfn_cd : ContDiffAt ℂ (k : WithTop ℕ∞) fn p.1 :=
          (hfn_holo.contDiffOn hOpenStripLim).contDiffAt (hOpenStripLim.mem_nhds hy)
        have hfS_cd : ContDiffAt ℂ (k : WithTop ℕ∞) fS p.1 :=
          (hfS_holo.contDiffOn hOpenStripLim).contDiffAt (hOpenStripLim.mem_nhds hy)
        have hfun_eq : (fun y' : ℂ => U_seq n (y', p.2) - U_lim (y', p.2)) =
            (fun y' => fn y' + (-fS y')) := by
          ext y'
          dsimp [U_lim, fn, fS, S_part]
          rw [hU_seq_sum n (y', p.2)]
          ring
        have hfn_iter : iteratedDeriv k fn p.1 =
            ∑ i ∈ Finset.range n, iteratedDeriv k (fun y' : ℂ => ΔU_seq i (y', p.2)) p.1 := by
          clear hfun_eq hfn_cd hfS_cd
          induction n with
          | zero =>
              have : fn = fun _ => 0 := by ext y'; simp [fn, S_part]
              rw [this]; simp
          | succ n ihn =>
              let fn0 : ℂ → ℂ := fun y' => S_part n (y', p.2)
              let gn : ℂ → ℂ := fun y' => ΔU_seq n (y', p.2)
              have hfn0_holo : DifferentiableOn ℂ fn0 (horizStrip s_lim) := by
                intro z hz
                exact (DifferentiableAt.fun_sum fun i _ =>
                  ((hΔ_y_holo i 0 p.2 ht).2 z hz).differentiableAt).differentiableWithinAt
              have hgn_holo : DifferentiableOn ℂ gn (horizStrip s_lim) := by
                simpa [gn, iteratedDeriv_zero] using (hΔ_y_holo n 0 p.2 ht).1
              have hfn0_cd : ContDiffAt ℂ (k : WithTop ℕ∞) fn0 p.1 :=
                (hfn0_holo.contDiffOn hOpenStripLim).contDiffAt (hOpenStripLim.mem_nhds hy)
              have hgn_cd : ContDiffAt ℂ (k : WithTop ℕ∞) gn p.1 :=
                (hgn_holo.contDiffOn hOpenStripLim).contDiffAt (hOpenStripLim.mem_nhds hy)
              have hsplit : fn = fun y' => fn0 y' + gn y' := by
                ext y'; simp [fn, fn0, gn, S_part, Finset.sum_range_succ]
              rw [hsplit, iteratedDeriv_fun_add hfn0_cd hgn_cd, Finset.sum_range_succ, ihn hfn0_holo]
        rw [hfun_eq, iteratedDeriv_fun_add hfn_cd hfS_cd.neg, iteratedDeriv_fun_neg,
          hfn_iter, hS_iter_eq k hk3 p.2 ht p.1 hy]
        ring
      rw [Metric.tendstoUniformlyOn_iff] at h2d_unif ⊢
      intro ε hε
      filter_upwards [h2d_unif ε hε] with n hn p hp
      rw [h_iter_diff_eq n p hp, dist_zero_left, ← dist_eq_norm, dist_comm]
      exact hn p hp
    have hE_zero : ∀ p ∈ glancingDomain 1 s_lim d_lim, G.E_op U_lim p = 0 := by
      intro p hp
      have h_tend_lim : Filter.Tendsto (fun n : ℕ => G.E_op (U_seq n) p)
          Filter.atTop (nhds (G.E_op U_lim p)) :=
        G.E_op_cont s_lim d_lim U_seq U_lim
          hs_lim_pos hs_lim_le hd_lim_pos hd_lim_le hd_lim_lt
          hAdm_seq_full hAdm_lim_full hUnif_diff p hp
      have h_ε_tend : Filter.Tendsto ε_bar Filter.atTop (nhds 0) := by
        have h_eq : ε_bar = fun n : ℕ => d₀ ^ A_exp * ((1 / 2 : ℝ) ^ A_exp) ^ n := by
          ext n; dsimp [ε_bar]
          rw [div_eq_mul_inv, mul_pow, ← _root_.inv_pow, ← pow_mul, mul_comm n A_exp, pow_mul,
            ← one_div]
        rw [h_eq]
        have hpow_lt1 : (1 / 2 : ℝ) ^ A_exp < 1 :=
          pow_lt_one₀ (by norm_num) (by norm_num) hA_pos.ne'
        simpa using (tendsto_pow_atTop_nhds_zero_of_lt_one (by positivity) hpow_lt1).const_mul (d₀ ^ A_exp)
      have h_tend_zero : Filter.Tendsto (fun n : ℕ => G.E_op (U_seq n) p)
          Filter.atTop (nhds 0) := by
        refine squeeze_zero_norm (fun n => ?_) h_ε_tend
        have hp_n : p ∈ glancingDomain 1 (s_seq n) (d_seq n) :=
          ⟨hp.1.trans (hd_seq_bounds n).1, lt_of_lt_of_le hp.2 (by linarith [(hs_seq_bounds n).1])⟩
        exact (hU_seq_good n).2 p hp_n
      exact tendsto_nhds_unique h_tend_lim h_tend_zero
    exact ⟨s_lim, d_lim, U_lim, hs_lim_pos, hs_lim_le, hd_lim_pos, hd_lim_le, hd_lim_lt,
      hAdm_lim, hE_zero⟩
  
  have h_stage3 : ∀ (s_lim d_lim : ℝ) (U_lim : ℂ × ℂ → ℂ),
      0 < s_lim → s_lim ≤ G.s_act →
      0 < d_lim → d_lim ≤ G.d_act → d_lim < s_lim / 2 →
      IsAdmissibleGlancingCand s_lim d_lim (G.η_adm / 2) U_lim →
      (∀ p ∈ glancingDomain 1 s_lim d_lim, G.E_op U_lim p = 0) →
      Nonempty (NormalizedGlancingData B) := by
    clear h_stage1 h_stage2
    intro s_lim d_lim U_lim hs_pos hs_le hd_pos hd_le hd_lt hAdm hZero
    have hη_pos : 0 < G.η_adm := G.η_adm_pos
    have hη_le : G.η_adm ≤ 1 / 4 := G.η_adm_le
    have hs₀_pos : 0 < B.s₀ := B.s₀_pos
    have hs_le_s₀ : s_lim ≤ B.s₀ := hs_le.trans G.s_act_le
    have hAdm_full : IsAdmissibleGlancingCand s_lim d_lim G.η_adm U_lim := by
      refine ⟨hAdm.1, hAdm.2.1, hAdm.2.2.1, hAdm.2.2.2.1, fun k hk y t hyt => ?_⟩
      exact (hAdm.2.2.2.2 k hk y t hyt).trans (by linarith)
    have hOpenStrip : IsOpen (horizStrip s_lim) :=
      isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const
    have hConvStrip : Convex ℝ (horizStrip s_lim) := by
      intro z₁ hz₁ z₂ hz₂ a b ha hb hab
      change |z₁.im| < s_lim at hz₁
      change |z₂.im| < s_lim at hz₂
      change |(a • z₁ + b • z₂).im| < s_lim
      calc |(a • z₁ + b • z₂).im|
          = |a * z₁.im + b * z₂.im| := by simp [Complex.add_im, Complex.real_smul]
        _ ≤ |a * z₁.im| + |b * z₂.im| := abs_add_le _ _
        _ = a * |z₁.im| + b * |z₂.im| := by
            rw [abs_mul, abs_mul, abs_of_nonneg ha, abs_of_nonneg hb]
        _ < a * s_lim + b * s_lim := by
            rcases lt_or_eq_of_le ha with ha' | rfl
            · exact add_lt_add_of_lt_of_le (mul_lt_mul_of_pos_left hz₁ ha')
                (mul_le_mul_of_nonneg_left (le_of_lt hz₂) hb)
            · simp only [zero_add] at hab; subst hab; simp [hz₂]
        _ = s_lim := by rw [← add_mul, hab, one_mul]
    let f₀ : ℂ → ℂ := fun y => U_lim (y, 0)
    have hf₀_holo : DifferentiableOn ℂ f₀ (horizStrip s_lim) := by
      refine hAdm.1.comp (differentiable_id.prodMk (differentiable_const (0 : ℂ))).differentiableOn ?_
      intro y hy
      simp [glancingDomain, hd_pos, horizStrip] at hy ⊢
      linarith
    have hE0 := (G.E_op_props s_lim d_lim U_lim hs_pos hs_le hd_pos hd_le hd_lt hAdm_full).2.2.2
    have hf₀_deriv2 : ∀ y ∈ horizStrip s_lim, deriv (deriv f₀) y = 0 := by
      intro y hy
      have hy0_mem : (y, (0 : ℂ)) ∈ glancingDomain 1 s_lim d_lim := by
        simp [glancingDomain, hd_pos]; exact hy
      have hEq0 : (1 / 4 : ℂ) * (deriv f₀ y) ^ 2 * deriv (deriv f₀) y = 0 := by
        rw [← hE0 y hy, hZero (y, 0) hy0_mem]
      have hf₀_diffAt : DifferentiableAt ℂ f₀ y := hf₀_holo.differentiableAt (hOpenStrip.mem_nhds hy)
      have h_iter1 : iteratedDeriv 1 (fun y' : ℂ => U_lim (y', 0) - y') y = deriv f₀ y - 1 := by
        rw [iteratedDeriv_one]
        exact ((hf₀_diffAt.hasDerivAt.sub (hasDerivAt_id y)).deriv)
      have hy0_d0 : (y, (0 : ℂ)) ∈ glancingDomain 0 s_lim d_lim := by
        simp [glancingDomain, hd_pos]; linarith [show |y.im| < s_lim from hy]
      have hnorm1 : ‖deriv f₀ y - 1‖ ≤ G.η_adm / 2 := by
        rw [← h_iter1]; exact hAdm.2.2.2.2 1 (by omega) y 0 hy0_d0
      have hdf₀_ne : deriv f₀ y ≠ 0 := by
        intro hzero
        rw [hzero] at hnorm1
        simp at hnorm1
        linarith
      rcases mul_eq_zero.mp hEq0 with hleft | hright
      · exfalso
        rcases mul_eq_zero.mp hleft with hquarter | hsq
        · norm_num at hquarter
        · exact pow_ne_zero 2 hdf₀_ne hsq
      · exact hright
    have hdf₀_holo : DifferentiableOn ℂ (deriv f₀) (horizStrip s_lim) :=
      hf₀_holo.deriv hOpenStrip
    have hdf₀_const : ∀ y ∈ horizStrip s_lim, deriv f₀ y = deriv f₀ 0 := by
      intro y hy
      exact hOpenStrip.is_const_of_deriv_eq_zero hConvStrip.isPreconnected hdf₀_holo
        (fun z hz => hf₀_deriv2 z hz) hy (by simp [horizStrip, hs_pos])
    let g₀ : ℂ → ℂ := fun y => f₀ y - y
    have hg₀_holo : DifferentiableOn ℂ g₀ (horizStrip s_lim) :=
      hf₀_holo.sub differentiableOn_id
    let hlin : ℂ → ℂ := fun y => g₀ y - (deriv f₀ 0 - 1) * y
    have hhlin_holo : DifferentiableOn ℂ hlin (horizStrip s_lim) :=
      hg₀_holo.sub (differentiableOn_id.const_mul _)
    have hhlin_deriv : ∀ y ∈ horizStrip s_lim, deriv hlin y = 0 := by
      intro y hy
      have hf₀_da : DifferentiableAt ℂ f₀ y := hf₀_holo.differentiableAt (hOpenStrip.mem_nhds hy)
      have hd : HasDerivAt hlin ((deriv f₀ y - 1) - (deriv f₀ 0 - 1) * 1) y :=
        (hf₀_da.hasDerivAt.sub (hasDerivAt_id y)).sub ((hasDerivAt_id y).const_mul (deriv f₀ 0 - 1))
      rw [hd.deriv, hdf₀_const y hy]
      ring
    have hhlin_const : ∀ y ∈ horizStrip s_lim, hlin y = hlin 0 := by
      intro y hy
      exact hOpenStrip.is_const_of_deriv_eq_zero hConvStrip.isPreconnected hhlin_holo
        (fun z hz => hhlin_deriv z hz) hy (by simp [horizStrip, hs_pos])
    have hc1_eq : deriv f₀ 0 = 1 := by
      have h2pi_mem : (2 * Real.pi : ℂ) ∈ horizStrip s_lim := by simp [horizStrip, hs_pos]
      have hqp := hAdm.2.1 0 0 (by simp [glancingDomain, hd_pos, hs_pos])
      have hg₀_2pi : g₀ (2 * Real.pi) = g₀ 0 := by
        simp only [g₀, f₀]
        have : (0 : ℂ) + 2 * Real.pi = 2 * Real.pi := by ring
        rw [← this, hqp]
        ring
      have hh := hhlin_const (2 * Real.pi) h2pi_mem
      simp only [hlin, hg₀_2pi, mul_zero, sub_zero] at hh
      have hmul : (deriv f₀ 0 - 1) * (2 * Real.pi : ℂ) = 0 := by linear_combination -hh
      rcases mul_eq_zero.mp hmul with hsub | h2pi
      · exact sub_eq_zero.mp hsub
      · exfalso
        have : (2 * Real.pi : ℝ) ≠ 0 := by positivity
        exact this (by exact_mod_cast h2pi)
    let c_shift : ℝ := (U_lim (0, 0)).re
    have hc_shift_eq : U_lim (0, 0) = (c_shift : ℂ) := by
      have hconj0 := hAdm.2.2.2.1 0 0 (by simp [glancingDomain, hd_pos, hs_pos])
      simp only [map_zero] at hconj0
      apply Complex.ext
      · simp [c_shift]
      · have him := congr_arg Complex.im hconj0
        simp at him ⊢
        linarith
    have hU_lim_zero : ∀ y ∈ horizStrip s_lim, U_lim (y, 0) = y + (c_shift : ℂ) := by
      intro y hy
      have hh := hhlin_const y hy
      simp only [hlin, hc1_eq, sub_self, zero_mul, sub_zero, g₀, f₀] at hh
      rw [sub_eq_iff_eq_add.mp hh, hc_shift_eq]
      ring
    have hLip_t : ∀ y t : ℂ, |y.im| < s_lim → ‖t‖ < d_lim →
        ‖U_lim (y, t) - U_lim (y, 0)‖ ≤ (G.η_adm / d_lim) * ‖t‖ := by
      intro y t hy ht
      let gt : ℂ → ℂ := fun τ => U_lim (y, τ)
      have hgt_holo : DifferentiableOn ℂ gt (Metric.ball 0 d_lim) := by
        refine hAdm.1.comp ((differentiable_const y).prodMk differentiable_id).differentiableOn ?_
        intro τ hτ
        simp [Metric.mem_ball, glancingDomain] at hτ ⊢
        exact ⟨hτ, by linarith⟩
      have hgt_maps : Set.MapsTo gt (Metric.ball 0 d_lim) (Metric.closedBall (gt 0) G.η_adm) := by
        intro τ hτ
        simp only [Metric.mem_ball, dist_zero_right] at hτ
        rw [Metric.mem_closedBall, dist_eq_norm]
        have h1 : ‖U_lim (y, τ) - y‖ ≤ G.η_adm / 2 := by
          simpa [iteratedDeriv_zero] using hAdm.2.2.2.2 0 (by omega) y τ
            (by simp [glancingDomain, hτ]; linarith)
        have h2 : ‖U_lim (y, 0) - y‖ ≤ G.η_adm / 2 := by
          simpa [iteratedDeriv_zero] using hAdm.2.2.2.2 0 (by omega) y 0
            (by simp [glancingDomain, hd_pos]; linarith)
        calc ‖U_lim (y, τ) - U_lim (y, 0)‖
            = ‖(U_lim (y, τ) - y) - (U_lim (y, 0) - y)‖ := by ring_nf
          _ ≤ ‖U_lim (y, τ) - y‖ + ‖U_lim (y, 0) - y‖ := norm_sub_le _ _
          _ ≤ G.η_adm := by linarith
      have hdslope_le : ‖dslope gt 0 t‖ ≤ G.η_adm / d_lim :=
        Complex.norm_dslope_le_div_of_mapsTo_ball hgt_holo hgt_maps (by simp [ht])
      have hsub := sub_smul_dslope gt 0 t
      simp only [sub_zero, smul_eq_mul] at hsub
      calc ‖U_lim (y, t) - U_lim (y, 0)‖
          = ‖t * dslope gt 0 t‖ := by rw [hsub]
        _ = ‖t‖ * ‖dslope gt 0 t‖ := norm_mul _ _
        _ ≤ ‖t‖ * (G.η_adm / d_lim) := mul_le_mul_of_nonneg_left hdslope_le (norm_nonneg t)
        _ = (G.η_adm / d_lim) * ‖t‖ := mul_comm _ _
    let d_stat : ℝ := min (d_lim / 2) ((B.s₀ * d_lim) / (2 * G.η_adm))
    have hd_stat_pos : 0 < d_stat := lt_min (by linarith) (by positivity)
    have hd_stat_lt_d : d_stat < d_lim :=
      lt_of_le_of_lt (min_le_left _ _) (by linarith)
    have hU_lim_maps : ∀ y t : ℂ, |y.im| < s_lim → ‖t‖ < d_stat →
        U_lim (y, t) ∈ horizStrip (2 * B.s₀) := by
      intro y t hy ht
      have ht_lim : ‖t‖ < d_lim := ht.trans hd_stat_lt_d
      have hlip := hLip_t y t hy ht_lim
      have ht_bound : ‖t‖ < (B.s₀ * d_lim) / (2 * G.η_adm) :=
        lt_of_lt_of_le ht (min_le_right _ _)
      have hdiff_lt : (G.η_adm / d_lim) * ‖t‖ < B.s₀ / 2 := by
        calc (G.η_adm / d_lim) * ‖t‖
            < (G.η_adm / d_lim) * ((B.s₀ * d_lim) / (2 * G.η_adm)) :=
              mul_lt_mul_of_pos_left ht_bound (by positivity)
          _ = B.s₀ / 2 := by field_simp
      have hy0 := hU_lim_zero y hy
      have him0 : (U_lim (y, 0)).im = y.im := by rw [hy0]; simp
      change |(U_lim (y, t)).im| < 2 * B.s₀
      have him_split : (U_lim (y, t)).im = (U_lim (y, 0)).im + (U_lim (y, t) - U_lim (y, 0)).im := by
        rw [← Complex.add_im]; ring_nf
      have him_le : |(U_lim (y, t)).im| ≤ |y.im| + ‖U_lim (y, t) - U_lim (y, 0)‖ := by
        calc |(U_lim (y, t)).im|
            = |(U_lim (y, 0)).im + (U_lim (y, t) - U_lim (y, 0)).im| := by rw [him_split]
          _ ≤ |(U_lim (y, 0)).im| + |(U_lim (y, t) - U_lim (y, 0)).im| := abs_add_le _ _
          _ ≤ |y.im| + ‖U_lim (y, t) - U_lim (y, 0)‖ := by
              rw [him0]; gcongr; exact Complex.abs_im_le_norm _
      linarith
    have hAdm_stat : IsAdmissibleGlancingCand s_lim d_stat G.η_adm U_lim := by
      have hsub : glancingDomain 0 s_lim d_stat ⊆ glancingDomain 0 s_lim d_lim := by
        intro p hp; exact ⟨hp.1.trans hd_stat_lt_d, hp.2⟩
      exact ⟨hAdm_full.1.mono hsub,
        fun y t hyt => hAdm_full.2.1 y t (hsub hyt),
        fun y t hyt => hAdm_full.2.2.1 y t (hsub hyt),
        fun y t hyt => hAdm_full.2.2.2.1 y t (hsub hyt),
        fun k hk y t hyt => hAdm_full.2.2.2.2 k hk y t (hsub hyt)⟩
    have hStat_lim := G.stationarity_equiv s_lim d_stat U_lim
      hs_pos hs_le hd_stat_pos (hd_stat_lt_d.le.trans hd_le) (hd_stat_lt_d.trans hd_lt)
      hAdm_stat hU_lim_maps
      (fun p hp => hZero p ⟨hp.1.trans hd_stat_lt_d, hp.2⟩)
    let s₁ : ℝ := s_lim / 3
    have hs₁_eq : s₁ = s_lim / 3 := rfl
    have hs₁_pos : 0 < s₁ := by positivity
    have hs₁_le_s₀ : s₁ ≤ B.s₀ := by linarith
    let U : ℂ × ℂ → ℂ := fun p => U_lim (p.1 - (c_shift : ℂ), p.2)
    have h1_le_infty : (1 : WithTop ℕ∞) ≤ ∞ := by simp
    have h_infty_ne_zero : (∞ : WithTop ℕ∞) ≠ 0 := by simp
    have hϕ'_cont : Continuous (deriv B.ϕ) := B.ϕ_smooth.continuous_deriv h1_le_infty
    have hϕ'_per : Function.Periodic (deriv B.ϕ) (2 * Real.pi) := by
      intro x
      have hd1 : HasDerivAt (B.ϕ ∘ fun z => z + 2 * Real.pi) (deriv B.ϕ (x + 2 * Real.pi) * 1) x :=
        (B.ϕ_smooth.differentiable h_infty_ne_zero (x + 2 * Real.pi)).hasDerivAt.comp x
          ((hasDerivAt_id x).add_const (2 * Real.pi))
      rw [mul_one] at hd1
      have hd2 : HasDerivAt (fun z => B.ϕ z + 2 * Real.pi) (deriv B.ϕ x) x :=
        (B.ϕ_smooth.differentiable h_infty_ne_zero x).hasDerivAt.add_const (2 * Real.pi)
      have heq : (B.ϕ ∘ fun z => z + 2 * Real.pi) = (fun z => B.ϕ z + 2 * Real.pi) :=
        funext B.ϕ_quasiperiodic
      rw [heq] at hd1
      exact hd1.unique hd2
    obtain ⟨x_max, -, hx_max⟩ := isCompact_Icc.exists_isMaxOn
      (Set.nonempty_Icc.mpr (by positivity : (0 : ℝ) ≤ 2 * Real.pi))
      (continuous_abs.comp hϕ'_cont).continuousOn
    let M_ϕ : ℝ := 1 + |deriv B.ϕ x_max|
    have hM_ϕ_pos : 0 < M_ϕ := by positivity
    have hϕ'_bound : ∀ x : ℝ, |deriv B.ϕ x| ≤ M_ϕ := by
      intro x
      have h2pi_pos : (0 : ℝ) < 2 * Real.pi := by positivity
      let k : ℤ := Int.floor (x / (2 * Real.pi))
      let x₀ : ℝ := x - k * (2 * Real.pi)
      have hx₀_mem : x₀ ∈ Set.Icc (0 : ℝ) (2 * Real.pi) := by
        refine ⟨?_, ?_⟩
        · have := Int.floor_le (x / (2 * Real.pi))
          have := (le_div_iff₀ h2pi_pos).mp this
          linarith
        · have := Int.lt_floor_add_one (x / (2 * Real.pi))
          have := (div_lt_iff₀ h2pi_pos).mp this
          linarith
      have hper_k : deriv B.ϕ x = deriv B.ϕ x₀ := by
        have : x = x₀ + k • (2 * Real.pi) := by simp [x₀, zsmul_eq_mul]
        rw [this, hϕ'_per.zsmul k x₀]
      rw [hper_k]
      have hle : |deriv B.ϕ x₀| ≤ |deriv B.ϕ x_max| := hx_max hx₀_mem
      linarith
    let r_raw : ℝ := min (s₁ / 4) (min d_stat (Real.pi / (2 * M_ϕ)))
    have hr_raw_pos : 0 < r_raw := lt_min (by positivity) (lt_min hd_stat_pos (by positivity))
    let r_in : ℝ := (1 / 2 : ℝ) * r_raw
    have hr_in_eq : r_in = (1 / 2 : ℝ) * r_raw := rfl
    have hr_in_pos : 0 < r_in := mul_pos (by norm_num) hr_raw_pos
    have hr_in_lt_quarter : r_in < s₁ / 4 := by
      have : r_raw ≤ s₁ / 4 := min_le_left _ _
      linarith
    have hr_in_lt_stat : r_in < d_stat := by
      have h1 : r_raw ≤ min d_stat (Real.pi / (2 * M_ϕ)) := min_le_right _ _
      have h2 : min d_stat (Real.pi / (2 * M_ϕ)) ≤ d_stat := min_le_left _ _
      linarith
    have hr_in_lt_pi : r_in < Real.pi / (2 * M_ϕ) := by
      have h1 : r_raw ≤ min d_stat (Real.pi / (2 * M_ϕ)) := min_le_right _ _
      have h2 : min d_stat (Real.pi / (2 * M_ϕ)) ≤ Real.pi / (2 * M_ϕ) := min_le_right _ _
      linarith
    have hshift_mem_d0 : ∀ y t : ℂ, |y.im| < 2 * s₁ → ‖t‖ < r_in →
        (y - (c_shift : ℂ), t) ∈ glancingDomain 0 s_lim d_lim := by
      intro y t hy ht
      refine ⟨ht.trans (hr_in_lt_stat.trans hd_stat_lt_d), ?_⟩
      simp only [Complex.sub_im, Complex.ofReal_im, sub_zero, zero_mul, sub_zero]
      linarith
    have hU_holo : DifferentiableOn ℂ U { p : ℂ × ℂ | |p.1.im| < 2 * s₁ ∧ ‖p.2‖ < r_in } := by
      refine hAdm.1.comp
        ((differentiable_fst.sub_const (c_shift : ℂ)).prodMk differentiable_snd).differentiableOn ?_
      intro p hp
      exact hshift_mem_d0 p.1 p.2 hp.1 hp.2
    have hU_deriv_re : ∀ x t : ℝ, |t| < r_in →
        HasDerivAt (fun x' : ℝ => (U (x', t)).re)
          (deriv (fun y' : ℂ => U_lim (y', t)) ((x : ℂ) - (c_shift : ℂ))).re x ∧
        (7 / 8 : ℝ) ≤ (deriv (fun y' : ℂ => U_lim (y', t)) ((x : ℂ) - (c_shift : ℂ))).re ∧
        (deriv (fun y' : ℂ => U_lim (y', t)) ((x : ℂ) - (c_shift : ℂ))).re ≤ 9 / 8 := by
      intro x t ht
      have ht_norm : ‖(t : ℂ)‖ < r_in := by simpa [Complex.norm_real] using ht
      let gt : ℂ → ℂ := fun y' => U_lim (y', (t : ℂ))
      have hgt_holo : DifferentiableOn ℂ gt (horizStrip s_lim) := by
        refine hAdm.1.comp (differentiable_id.prodMk (differentiable_const (t : ℂ))).differentiableOn ?_
        intro y' hy'
        exact ⟨ht_norm.trans (hr_in_lt_stat.trans hd_stat_lt_d), by simpa [horizStrip] using hy'⟩
      have hx_mem : (x : ℂ) - (c_shift : ℂ) ∈ horizStrip s_lim := by simp [horizStrip, hs_pos]
      have hgt_da : DifferentiableAt ℂ gt ((x : ℂ) - (c_shift : ℂ)) :=
        hgt_holo.differentiableAt (hOpenStrip.mem_nhds hx_mem)
      have hcomp_c : HasDerivAt (gt ∘ fun y' : ℂ => y' - (c_shift : ℂ))
          (deriv gt ((x : ℂ) - (c_shift : ℂ)) * 1) (x : ℂ) :=
        hgt_da.hasDerivAt.comp (x : ℂ) ((hasDerivAt_id (x : ℂ)).sub_const (c_shift : ℂ))
      rw [mul_one] at hcomp_c
      have hreal : HasDerivAt (fun x' : ℝ => (U (x', t)).re)
          (deriv gt ((x : ℂ) - (c_shift : ℂ))).re x :=
        hcomp_c.real_of_complex
      have h_iter1 : iteratedDeriv 1 (fun y' : ℂ => gt y' - y') ((x : ℂ) - (c_shift : ℂ)) =
          deriv gt ((x : ℂ) - (c_shift : ℂ)) - 1 := by
        rw [iteratedDeriv_one]
        exact (hgt_da.hasDerivAt.sub (hasDerivAt_id _)).deriv
      have hnorm1 : ‖deriv gt ((x : ℂ) - (c_shift : ℂ)) - 1‖ ≤ 1 / 8 := by
        rw [← h_iter1]
        exact (hAdm.2.2.2.2 1 (by omega) ((x : ℂ) - (c_shift : ℂ)) (t : ℂ)
          (hshift_mem_d0 x t (by simp [hs₁_pos]) ht_norm)).trans (by linarith)
      have hre_abs : |(deriv gt ((x : ℂ) - (c_shift : ℂ))).re - 1| ≤ 1 / 8 := by
        have : (deriv gt ((x : ℂ) - (c_shift : ℂ))).re - 1 =
            (deriv gt ((x : ℂ) - (c_shift : ℂ)) - 1).re := by simp
        rw [this]
        exact (Complex.abs_re_le_norm _).trans hnorm1
      rw [abs_le] at hre_abs
      exact ⟨hreal, by linarith, by linarith⟩
    refine ⟨{
      s₁ := s₁
      r_in := r_in
      s₁_pos := hs₁_pos
      s₁_le_s₀ := hs₁_le_s₀
      r_in_pos := hr_in_pos
      r_in_lt_quarter_s₁ := hr_in_lt_quarter
      U := U
      U_holo := hU_holo
      U_quasiperiodic := fun y t hy ht => by
        simp only [U]
        have harg : y + 2 * Real.pi - (c_shift : ℂ) = (y - (c_shift : ℂ)) + 2 * Real.pi := by ring
        rw [harg]
        exact hAdm.2.1 (y - c_shift) t (hshift_mem_d0 y t hy ht)
      U_even := fun y t hy ht => hAdm.2.2.1 (y - c_shift) t (hshift_mem_d0 y t hy ht)
      U_zero := fun y hy => by
        simp only [U]
        have hy_mem : y - (c_shift : ℂ) ∈ horizStrip s_lim := by
          change |(y - (c_shift : ℂ)).im| < s_lim
          simp only [Complex.sub_im, Complex.ofReal_im, sub_zero]
          linarith
        rw [hU_lim_zero (y - c_shift) hy_mem]
        ring
      U_conj := fun y t hy ht => by
        simp only [U]
        have hconj_sub : starRingEnd ℂ y - (c_shift : ℂ) = starRingEnd ℂ (y - (c_shift : ℂ)) := by
          simp
        rw [hconj_sub]
        exact hAdm.2.2.2.1 (y - c_shift) t (hshift_mem_d0 y t hy ht)
      U_maps_to_wide := fun y t hy ht => by
        refine hU_lim_maps (y - c_shift) t ?_ (ht.trans hr_in_lt_stat)
        simp only [Complex.sub_im, Complex.ofReal_im, sub_zero]
        linarith
      U_real_deriv_pos := fun x t ht => by
        obtain ⟨hderiv, hlo, -⟩ := hU_deriv_re x t ht
        rw [hderiv.deriv]
        linarith
      U_real_step_pos := fun x t ht0 ht => by
        have ht_abs : |t| < r_in := by rw [abs_of_pos ht0]; exact ht
        let u_t : ℝ → ℝ := fun x' => (U (x', t)).re
        have hu_deriv_pos : ∀ x' : ℝ, 0 < deriv u_t x' := by
          intro x'
          obtain ⟨hderiv, hlo, -⟩ := hU_deriv_re x' t ht_abs
          rw [hderiv.deriv]; linarith
        have hu_diff : Differentiable ℝ u_t := fun x' =>
          (hU_deriv_re x' t ht_abs).1.differentiableAt
        have hu_strict : StrictMono u_t := strictMono_of_deriv_pos hu_deriv_pos
        have hstep_u : 0 < u_t (x + t) - u_t x := sub_pos.mpr (hu_strict (by linarith))
        have hϕ_strict : StrictMono B.ϕ := strictMono_of_deriv_pos B.ϕ_deriv_pos
        have hstep_ϕ_pos : 0 < B.ϕ (u_t (x + t)) - B.ϕ (u_t x) :=
          sub_pos.mpr (hϕ_strict (hu_strict (by linarith)))
        have hu_lip : ‖u_t (x + t) - u_t x‖ ≤ (9 / 8 : ℝ) * ‖(x + t) - x‖ := by
          refine Convex.norm_image_sub_le_of_norm_deriv_le (fun z _ => hu_diff z)
            (fun z _ => ?_) convex_univ (Set.mem_univ _) (Set.mem_univ _)
          obtain ⟨hderiv, hlo, hhi⟩ := hU_deriv_re z t ht_abs
          rw [hderiv.deriv, Real.norm_eq_abs, abs_of_nonneg (by linarith)]
          exact hhi
        have hu_diff_le : u_t (x + t) - u_t x ≤ (9 / 8 : ℝ) * t := by
          have h1 : u_t (x + t) - u_t x ≤ ‖u_t (x + t) - u_t x‖ := le_abs_self _
          have h2 : ‖(x + t) - x‖ = t := by
            have : (x + t) - x = t := by ring
            rw [this, Real.norm_eq_abs, abs_of_pos ht0]
          linarith
        have hϕ_diff : Differentiable ℝ B.ϕ := B.ϕ_smooth.differentiable h_infty_ne_zero
        have hϕ_lip : ‖B.ϕ (u_t (x + t)) - B.ϕ (u_t x)‖ ≤ M_ϕ * ‖u_t (x + t) - u_t x‖ := by
          refine Convex.norm_image_sub_le_of_norm_deriv_le (fun z _ => hϕ_diff z)
            (fun z _ => hϕ'_bound z) convex_univ (Set.mem_univ _) (Set.mem_univ _)
        have hϕ_lt_pi : B.ϕ (u_t (x + t)) - B.ϕ (u_t x) < Real.pi := by
          have h1 : B.ϕ (u_t (x + t)) - B.ϕ (u_t x) ≤ ‖B.ϕ (u_t (x + t)) - B.ϕ (u_t x)‖ :=
            le_abs_self _
          have h2 : ‖u_t (x + t) - u_t x‖ = u_t (x + t) - u_t x :=
            abs_of_pos hstep_u
          rw [h2] at hϕ_lip
          have h3 : M_ϕ * (u_t (x + t) - u_t x) ≤ M_ϕ * ((9 / 8 : ℝ) * t) :=
            mul_le_mul_of_nonneg_left hu_diff_le hM_ϕ_pos.le
          have h4 : M_ϕ * ((9 / 8 : ℝ) * t) < M_ϕ * ((9 / 8 : ℝ) * (Real.pi / (2 * M_ϕ))) :=
            mul_lt_mul_of_pos_left (mul_lt_mul_of_pos_left (ht.trans hr_in_lt_pi) (by norm_num)) hM_ϕ_pos
          have h5 : M_ϕ * ((9 / 8 : ℝ) * (Real.pi / (2 * M_ϕ))) = (9 / 16 : ℝ) * Real.pi := by
            field_simp; ring
          linarith [Real.pi_pos]
        have hu_add : u_t (x + t) = (U ((x : ℂ) + (t : ℂ), (t : ℂ))).re := by
          simp [u_t, Complex.ofReal_add]
        exact ⟨by simpa [u_t, hu_add] using hstep_u,
          by simpa [u_t, hu_add] using hstep_ϕ_pos,
          by simpa [u_t, hu_add] using hϕ_lt_pi⟩
      glancing_stationary_wide := fun y t hy ht => by
        have hstat := hStat_lim (y - c_shift) t ?_ (ht.trans hr_in_lt_stat)
        · simp only [U]
          have hadd : y + t - (c_shift : ℂ) = y - (c_shift : ℂ) + t := by ring
          have hsub : y - t - (c_shift : ℂ) = y - (c_shift : ℂ) - t := by ring
          rw [hadd, hsub]
          exact hstat
        · simp only [Complex.sub_im, Complex.ofReal_im, sub_zero]
          linarith [hr_in_lt_quarter]
    }⟩
  
  have h_stage4 : ∀ (N : NormalizedGlancingData B),
      ∃ (r₁ : ℝ) (A : ℂ → ℂ),
        0 < r₁ ∧ r₁ ≤ N.r_in ∧
        DifferentiableOn ℂ A (Metric.ball (0 : ℂ) r₁) ∧
        (∀ y t : ℂ, |y.im| < N.s₁ → ‖t‖ < r₁ →
          deriv (fun y' : ℂ =>
              -supportAction1_ℂ B.h_ℂ (B.ϕ_ℂ (N.U (y', t))) (B.ϕ_ℂ (N.U (y' + t, t)))) y *
            deriv (fun t' : ℂ => B.ϕ_ℂ (N.U (y, t'))) t -
          deriv (fun t' : ℂ =>
              -supportAction1_ℂ B.h_ℂ (B.ϕ_ℂ (N.U (y, t'))) (B.ϕ_ℂ (N.U (y + t', t')))) t *
            deriv (fun y' : ℂ => B.ϕ_ℂ (N.U (y', t))) y = A t) ∧
        (∀ t ∈ Metric.ball (0 : ℂ) r₁, A (-t) = -A t) ∧
        (∀ t ∈ Metric.ball (0 : ℂ) r₁, A (starRingEnd ℂ t) = starRingEnd ℂ (A t)) ∧
        deriv A 0 = B.c / 4 ∧
        (∀ t : ℝ, 0 < t → t < r₁ → 0 < (A t).re) := by
    clear h_stage1 h_stage2 h_stage3 G
    intro N
    have hs₁_pos : 0 < N.s₁ := N.s₁_pos
    have hr_in_pos : 0 < N.r_in := N.r_in_pos
    have hr_in_lt_s₁4 : N.r_in < N.s₁ / 4 := N.r_in_lt_quarter_s₁
    have hs₀_pos : 0 < B.s₀ := B.s₀_pos
    have hs_h_pos : 0 < B.s_h := B.s_h_pos
    have hOpenStrip : ∀ H : ℝ, IsOpen (horizStrip H) :=
      fun H => isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const
    have hConvStrip : ∀ H : ℝ, Convex ℝ (horizStrip H) := by
      intro H z₁ hz₁ z₂ hz₂ a b ha hb hab
      change |z₁.im| < H at hz₁
      change |z₂.im| < H at hz₂
      change |(a • z₁ + b • z₂).im| < H
      calc |(a • z₁ + b • z₂).im|
          = |a * z₁.im + b * z₂.im| := by simp [Complex.add_im, Complex.real_smul]
        _ ≤ |a * z₁.im| + |b * z₂.im| := abs_add_le _ _
        _ = a * |z₁.im| + b * |z₂.im| := by
            rw [abs_mul, abs_mul, abs_of_nonneg ha, abs_of_nonneg hb]
        _ < a * H + b * H := by
            rcases lt_or_eq_of_le ha with ha' | rfl
            · exact add_lt_add_of_lt_of_le (mul_lt_mul_of_pos_left hz₁ ha')
                (mul_le_mul_of_nonneg_left hz₂.le hb)
            · simp only [zero_add] at hab; subst hab; simp [hz₂]
        _ = H := by rw [← add_mul, hab, one_mul]
    have hHolo_derivY : ∀ (W : Set (ℂ × ℂ)) (F : ℂ × ℂ → ℂ),
        IsOpen W → DifferentiableOn ℂ F W →
        DifferentiableOn ℂ (fun p : ℂ × ℂ => deriv (fun y' : ℂ => F (y', p.2)) p.1) W := by
      intro W F hOpenW hF p₀ hp₀
      obtain ⟨r₀, hr₀_pos, hr₀_sub⟩ := Metric.mem_nhds_iff.mp (hOpenW.mem_nhds hp₀)
      let r : ℝ := r₀ / 4
      have hr_eq : r = r₀ / 4 := rfl
      have hr_pos : 0 < r := by positivity
      have hcb_sub : Metric.closedBall p₀ (3 * r) ⊆ W :=
        (Metric.closedBall_subset_ball (by linarith)).trans hr₀_sub
      obtain ⟨q_max, -, hq_max⟩ := (isCompact_closedBall p₀ (3 * r)).exists_isMaxOn
        (Metric.nonempty_closedBall.mpr (by positivity))
        (continuous_norm.comp_continuousOn (hF.continuousOn.mono hcb_sub))
      let B_F : ℝ := 2 * (1 + ‖F q_max‖)
      have hB_F_pos : 0 < B_F := by positivity
      let derivY : ℂ × ℂ → ℂ := fun p => deriv (fun y' : ℂ => F (y', p.2)) p.1
      have hdslope_approx : ∀ p ∈ Metric.ball p₀ (3 * r / 2), ∀ y' ∈ Metric.ball p.1 r,
          ‖dslope (fun z : ℂ => F (z, p.2)) p.1 y' - derivY p‖ ≤
            (2 * B_F / r ^ 2) * ‖y' - p.1‖ := by
        intro p hp y' hy'
        let gp : ℂ → ℂ := fun z => F (z, p.2)
        have hgp_mem : ∀ z ∈ Metric.ball p.1 r, (z, p.2) ∈ Metric.closedBall p₀ (3 * r) := by
          intro z hz
          rw [Metric.mem_closedBall]
          have hdist_zp : dist (z, p.2) p < r := by
            rw [Prod.dist_eq, dist_self, max_eq_left dist_nonneg]
            exact hz
          have hp_dist : dist p p₀ < 3 * r / 2 := hp
          calc dist (z, p.2) p₀ ≤ dist (z, p.2) p + dist p p₀ := dist_triangle _ _ _
            _ ≤ r + 3 * r / 2 := add_le_add hdist_zp.le hp_dist.le
            _ ≤ 3 * r := by linarith
        have hgp_holo : DifferentiableOn ℂ gp (Metric.ball p.1 r) := by
          refine hF.comp (differentiable_id.prodMk (differentiable_const p.2)).differentiableOn ?_
          intro z hz; exact hcb_sub (hgp_mem z hz)
        have hgp_maps : Set.MapsTo gp (Metric.ball p.1 r) (Metric.closedBall (gp p.1) B_F) := by
          intro z hz
          rw [Metric.mem_closedBall, dist_eq_norm]
          have h1 : ‖F (z, p.2)‖ ≤ ‖F q_max‖ := hq_max (hgp_mem z hz)
          have h2 : ‖F p‖ ≤ ‖F q_max‖ :=
            hq_max (Metric.ball_subset_closedBall (Metric.ball_subset_ball (by linarith) hp))
          dsimp [gp, B_F]
          calc ‖F (z, p.2) - F p‖ ≤ ‖F (z, p.2)‖ + ‖F p‖ := norm_sub_le _ _
            _ ≤ B_F := by dsimp [B_F]; linarith
        let d1 : ℂ → ℂ := dslope gp p.1
        have hd1_holo : DifferentiableOn ℂ d1 (Metric.ball p.1 r) :=
          (Complex.differentiableOn_dslope (Metric.ball_mem_nhds p.1 hr_pos)).mpr hgp_holo
        have hd1_bd : ∀ z ∈ Metric.ball p.1 r, ‖d1 z‖ ≤ B_F / r :=
          fun z hz => Complex.norm_dslope_le_div_of_mapsTo_ball hgp_holo hgp_maps hz
        have hd1_maps : Set.MapsTo d1 (Metric.ball p.1 r)
            (Metric.closedBall (d1 p.1) (2 * (B_F / r))) := by
          intro z hz
          rw [Metric.mem_closedBall, dist_eq_norm]
          calc ‖d1 z - d1 p.1‖ ≤ ‖d1 z‖ + ‖d1 p.1‖ := norm_sub_le _ _
            _ ≤ B_F / r + B_F / r := add_le_add (hd1_bd z hz) (hd1_bd p.1 (Metric.mem_ball_self hr_pos))
            _ = 2 * (B_F / r) := by ring
        have hd2 := Complex.norm_dslope_le_div_of_mapsTo_ball hd1_holo hd1_maps hy'
        have hsub := sub_smul_dslope d1 p.1 y'
        simp only [smul_eq_mul] at hsub
        have hd1_same : d1 p.1 = derivY p := dslope_same gp p.1
        calc ‖d1 y' - derivY p‖ = ‖(y' - p.1) * dslope d1 p.1 y'‖ := by rw [← hd1_same, hsub]
          _ = ‖y' - p.1‖ * ‖dslope d1 p.1 y'‖ := norm_mul _ _
          _ ≤ ‖y' - p.1‖ * ((2 * (B_F / r)) / r) := mul_le_mul_of_nonneg_left hd2 (norm_nonneg _)
          _ = (2 * B_F / r ^ 2) * ‖y' - p.1‖ := by ring
      let h_dyad : ℕ → ℝ := fun k => (r / 2) * (1 / 2 : ℝ) ^ k
      have hh_pos : ∀ k : ℕ, 0 < h_dyad k := fun k => by dsimp [h_dyad]; positivity
      have hh_lt_r : ∀ k : ℕ, h_dyad k < r := by
        intro k; dsimp [h_dyad]
        have : (1 / 2 : ℝ) ^ k ≤ 1 := pow_le_one₀ (by norm_num) (by norm_num)
        nlinarith
      let D_dyad : ℕ → ℂ × ℂ → ℂ := fun k p =>
        ((h_dyad k : ℂ))⁻¹ * (F (p.1 + (h_dyad k : ℂ), p.2) - F p)
      have hD_holo : ∀ k : ℕ, DifferentiableOn ℂ (D_dyad k) (Metric.ball p₀ (3 * r / 2)) := by
        intro k
        have hshift_sub : Set.MapsTo (fun p : ℂ × ℂ => (p.1 + (h_dyad k : ℂ), p.2))
            (Metric.ball p₀ (3 * r / 2)) W := by
          intro p hp
          apply hcb_sub
          rw [Metric.mem_closedBall]
          have hdist1 : dist (p.1 + (h_dyad k : ℂ), p.2) p = h_dyad k := by
            rw [Prod.dist_eq, dist_self, max_eq_left dist_nonneg, dist_eq_norm, add_sub_cancel_left,
              Complex.norm_real, Real.norm_eq_abs, abs_of_pos (hh_pos k)]
          calc dist (p.1 + (h_dyad k : ℂ), p.2) p₀
              ≤ dist (p.1 + (h_dyad k : ℂ), p.2) p + dist p p₀ := dist_triangle _ _ _
            _ ≤ r + 3 * r / 2 := add_le_add (by rw [hdist1]; exact (hh_lt_r k).le) hp.le
            _ ≤ 3 * r := by linarith
        have hself_sub : Metric.ball p₀ (3 * r / 2) ⊆ W :=
          (Metric.ball_subset_closedBall).trans ((Metric.closedBall_subset_closedBall (by linarith)).trans hcb_sub)
        exact ((hF.comp ((differentiable_fst.add_const _).prodMk differentiable_snd).differentiableOn
          hshift_sub).sub (hF.mono hself_sub)).const_mul _
      have hD_err : ∀ (k : ℕ), ∀ p ∈ Metric.ball p₀ (3 * r / 2),
          ‖D_dyad k p - derivY p‖ ≤ (B_F / r) * (1 / 2 : ℝ) ^ k := by
        intro k p hp
        have hne : (h_dyad k : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (hh_pos k).ne'
        have hy'_ne : p.1 + (h_dyad k : ℂ) ≠ p.1 :=
          fun heq => hne (add_left_cancel (heq.trans (add_zero p.1).symm))
        have hy'_ball : p.1 + (h_dyad k : ℂ) ∈ Metric.ball p.1 r := by
          rw [Metric.mem_ball, dist_eq_norm, add_sub_cancel_left,
            Complex.norm_real, Real.norm_eq_abs, abs_of_pos (hh_pos k)]
          exact hh_lt_r k
        have hd_eq : D_dyad k p = dslope (fun z : ℂ => F (z, p.2)) p.1 (p.1 + (h_dyad k : ℂ)) := by
          rw [dslope_of_ne _ hy'_ne, slope_def_field]
          dsimp [D_dyad]
          rw [add_sub_cancel_left, div_eq_inv_mul]
        rw [hd_eq]
        have happr := hdslope_approx p hp (p.1 + (h_dyad k : ℂ)) hy'_ball
        have hnorm_h : ‖(p.1 + (h_dyad k : ℂ)) - p.1‖ = h_dyad k := by
          rw [add_sub_cancel_left, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (hh_pos k)]
        rw [hnorm_h] at happr
        calc ‖dslope (fun z : ℂ => F (z, p.2)) p.1 (p.1 + (h_dyad k : ℂ)) - derivY p‖
            ≤ (2 * B_F / r ^ 2) * h_dyad k := happr
          _ = (B_F / r) * (1 / 2 : ℝ) ^ k := by dsimp [h_dyad]; field_simp [hr_pos.ne']
      let ΔD : ℕ → ℂ × ℂ → ℂ := fun k p => D_dyad (k + 1) p - D_dyad k p
      let stepD : ℕ → ℝ := fun k => (3 * B_F / (2 * r)) * (1 / 2 : ℝ) ^ k
      have hΔD_bd' : ∀ (k : ℕ), ∀ p ∈ Metric.ball p₀ (3 * r / 2), ‖ΔD k p‖ ≤ stepD k := by
        intro k p hp
        have hsplit : ΔD k p = (D_dyad (k + 1) p - derivY p) - (D_dyad k p - derivY p) := by
          dsimp [ΔD]; ring
        rw [hsplit]
        calc ‖(D_dyad (k + 1) p - derivY p) - (D_dyad k p - derivY p)‖
            ≤ ‖D_dyad (k + 1) p - derivY p‖ + ‖D_dyad k p - derivY p‖ := norm_sub_le _ _
          _ ≤ (B_F / r) * (1 / 2 : ℝ) ^ (k + 1) + (B_F / r) * (1 / 2 : ℝ) ^ k :=
              add_le_add (hD_err (k + 1) p hp) (hD_err k p hp)
          _ = stepD k := by dsimp [stepD]; rw [pow_succ]; ring
      have hSumD : Summable stepD :=
        (summable_geometric_of_lt_one (by norm_num) (by norm_num)).mul_left (3 * B_F / (2 * r))
      let S_part : ℕ → ℂ × ℂ → ℂ := fun n p => ∑ k ∈ Finset.range n, ΔD k p
      let S_inf : ℂ × ℂ → ℂ := fun p => ∑' k : ℕ, ΔD k p
      have hS_unif : TendstoUniformlyOn S_part S_inf Filter.atTop (Metric.ball p₀ (3 * r / 2)) :=
        tendstoUniformlyOn_tsum_nat hSumD hΔD_bd'
      have h_tele : ∀ (n : ℕ) (p : ℂ × ℂ), D_dyad 0 p + S_part n p = D_dyad n p := by
        intro n; induction n with
        | zero => intro p; simp [S_part]
        | succ n ih =>
            intro p; dsimp [S_part]
            rw [Finset.sum_range_succ, ← add_assoc, ih p]
            dsimp [ΔD]; ring
      have hderivY_eq : ∀ p ∈ Metric.ball p₀ (3 * r / 2), derivY p = D_dyad 0 p + S_inf p := by
        intro p hp
        have ht1 : Filter.Tendsto (fun n => D_dyad 0 p + S_part n p) Filter.atTop
            (nhds (D_dyad 0 p + S_inf p)) :=
          (hS_unif.tendsto_at hp).const_add (D_dyad 0 p)
        have ht2 : Filter.Tendsto (fun n => D_dyad n p) Filter.atTop (nhds (derivY p)) := by
          rw [tendsto_iff_norm_sub_tendsto_zero]
          have hgeom0 : Filter.Tendsto (fun n : ℕ => (B_F / r) * (1 / 2 : ℝ) ^ n)
              Filter.atTop (nhds 0) := by
            simpa only [mul_zero] using
              (tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num)
                (by norm_num : (1 / 2 : ℝ) < 1)).const_mul (B_F / r)
          refine squeeze_zero_norm (fun n => ?_) hgeom0
          rw [norm_norm]
          exact hD_err n p hp
        exact (tendsto_nhds_unique ht1 (by simpa [h_tele] using ht2)).symm
      have hr2_pos : 0 < r / 2 := by positivity
      have hΔD_fd_le : ∀ (k : ℕ), ∀ q ∈ Metric.ball p₀ (r / 2),
          ‖fderiv ℂ (ΔD k) q‖ ≤ (4 / r) * stepD k := by
        intro k q hq
        have hq_sub : Metric.ball q (r / 2) ⊆ Metric.ball p₀ (3 * r / 2) := by
          intro z hz
          rw [Metric.mem_ball] at hq hz ⊢
          calc dist z p₀ ≤ dist z q + dist q p₀ := dist_triangle _ _ _
            _ < r / 2 + r / 2 := add_lt_add hz hq
            _ < 3 * r / 2 := by linarith
        have hΔ_holo : DifferentiableOn ℂ (ΔD k) (Metric.ball q (r / 2)) :=
          ((hD_holo (k + 1)).sub (hD_holo k)).mono hq_sub
        have hmaps : Set.MapsTo (ΔD k) (Metric.ball q (r / 2))
            (Metric.closedBall (ΔD k q) (2 * stepD k)) := by
          intro z hz
          rw [Metric.mem_closedBall, dist_eq_norm]
          calc ‖ΔD k z - ΔD k q‖ ≤ ‖ΔD k z‖ + ‖ΔD k q‖ := norm_sub_le _ _
            _ ≤ stepD k + stepD k := add_le_add (hΔD_bd' k z (hq_sub hz))
                (hΔD_bd' k q (hq_sub (Metric.mem_ball_self hr2_pos)))
            _ = 2 * stepD k := by ring
        have hfd := Complex.norm_fderiv_le_div_of_mapsTo_ball hΔ_holo hmaps hr2_pos
        calc ‖fderiv ℂ (ΔD k) q‖ ≤ (2 * stepD k) / (r / 2) := hfd
          _ = (4 / r) * stepD k := by field_simp [hr_pos.ne']; ring
      have hfd_unif_raw : TendstoUniformlyOn
          (fun n q => ∑ k ∈ Finset.range n, fderiv ℂ (ΔD k) q)
          (fun q => ∑' k : ℕ, fderiv ℂ (ΔD k) q) Filter.atTop (Metric.ball p₀ (r / 2)) :=
        tendstoUniformlyOn_tsum_nat (hSumD.mul_left (4 / r)) hΔD_fd_le
      have hΔD_da : ∀ (k : ℕ), ∀ q ∈ Metric.ball p₀ (r / 2), DifferentiableAt ℂ (ΔD k) q := by
        intro k q hq
        have hq3 : q ∈ Metric.ball p₀ (3 * r / 2) := Metric.ball_subset_ball (by linarith) hq
        exact ((hD_holo (k + 1)).sub (hD_holo k)).differentiableAt (isOpen_ball.mem_nhds hq3)
      have hfd_unif : TendstoUniformlyOn (fderiv ℂ ∘ S_part)
          (fun q => ∑' k : ℕ, fderiv ℂ (ΔD k) q) Filter.atTop (Metric.ball p₀ (r / 2)) := by
        refine hfd_unif_raw.congr (Filter.Eventually.of_forall fun n q hq => ?_)
        simp only [Function.comp_apply, S_part]
        exact ((HasFDerivAt.fun_sum fun k _ => (hΔD_da k q hq).hasFDerivAt).fderiv).symm
      have hS_part_holo : ∀ n : ℕ, DifferentiableOn ℂ (S_part n) (Metric.ball p₀ (r / 2)) :=
        fun n q hq => (DifferentiableAt.fun_sum fun k _ => hΔD_da k q hq).differentiableWithinAt
      have hS_pt : ∀ q ∈ Metric.ball p₀ (r / 2),
          Filter.Tendsto (fun n => S_part n q) Filter.atTop (nhds (S_inf q)) :=
        fun q hq => hS_unif.tendsto_at (Metric.ball_subset_ball (by linarith) hq)
      have hS_hasFD := hasFDerivAt_of_tendsto_locally_uniformly_on' isOpen_ball
        hfd_unif.tendstoLocallyUniformlyOn hS_part_holo hS_pt (Metric.mem_ball_self hr2_pos)
      have hD0_da : DifferentiableAt ℂ (D_dyad 0) p₀ :=
        (hD_holo 0).differentiableAt (isOpen_ball.mem_nhds (Metric.mem_ball_self (by positivity)))
      have h_eq_nhds : derivY =ᶠ[nhds p₀] fun p => D_dyad 0 p + S_inf p := by
        filter_upwards [isOpen_ball.mem_nhds (Metric.mem_ball_self (by positivity : 0 < 3 * r / 2))]
          with p hp
        exact hderivY_eq p hp
      exact ((hD0_da.add hS_hasFD.differentiableAt).congr_of_eventuallyEq h_eq_nhds).differentiableWithinAt
    have hHolo_derivT : ∀ (W : Set (ℂ × ℂ)) (F : ℂ × ℂ → ℂ),
        IsOpen W → DifferentiableOn ℂ F W →
        DifferentiableOn ℂ (fun p : ℂ × ℂ => deriv (fun t' : ℂ => F (p.1, t')) p.2) W := by
      intro W F hOpenW hF
      let W_sw : Set (ℂ × ℂ) := Prod.swap ⁻¹' W
      have hOpen_sw : IsOpen W_sw := hOpenW.preimage continuous_swap
      have hF_sw : DifferentiableOn ℂ (F ∘ Prod.swap) W_sw :=
        hF.comp (differentiable_snd.prodMk differentiable_fst).differentiableOn (fun _ hp => hp)
      have hY_sw := hHolo_derivY W_sw (F ∘ Prod.swap) hOpen_sw hF_sw
      exact hY_sw.comp (differentiable_snd.prodMk differentiable_fst).differentiableOn
        (fun p hp => by simpa [W_sw] using hp)
    have hSlice_da : ∀ (W : Set (ℂ × ℂ)) (F : ℂ × ℂ → ℂ) (y t : ℂ),
        IsOpen W → DifferentiableOn ℂ F W → (y, t) ∈ W →
        DifferentiableAt ℂ (fun y' => F (y', t)) y ∧
        DifferentiableAt ℂ (fun t' => F (y, t')) t := by
      intro W F y t hOpenW hF hmem
      have hda : DifferentiableAt ℂ F (y, t) := hF.differentiableAt (hOpenW.mem_nhds hmem)
      have hy_da : DifferentiableAt ℂ (F ∘ fun y' : ℂ => (y', t)) y :=
        hda.comp y (differentiableAt_id.prodMk (differentiableAt_const t))
      have ht_da : DifferentiableAt ℂ (F ∘ fun t' : ℂ => (y, t')) t :=
        hda.comp t ((differentiableAt_const y).prodMk differentiableAt_id)
      exact ⟨hy_da, ht_da⟩
    let Ω_Θ : Set (ℂ × ℂ) := { p : ℂ × ℂ | |p.1.im| < (7 / 4 : ℝ) * N.s₁ ∧ ‖p.2‖ < N.r_in }
    let Ω_p : Set (ℂ × ℂ) := { p : ℂ × ℂ | |p.1.im| < (3 / 2 : ℝ) * N.s₁ ∧ ‖p.2‖ < N.r_in }
    have hOpen_Θ : IsOpen Ω_Θ :=
      (isOpen_lt (continuous_abs.comp (Complex.continuous_im.comp continuous_fst)) continuous_const).inter
        (isOpen_lt (continuous_norm.comp continuous_snd) continuous_const)
    have hOpen_p : IsOpen Ω_p :=
      (isOpen_lt (continuous_abs.comp (Complex.continuous_im.comp continuous_fst)) continuous_const).inter
        (isOpen_lt (continuous_norm.comp continuous_snd) continuous_const)
    have hp_sub_Θ : Ω_p ⊆ Ω_Θ := fun p hp => ⟨by linarith [hp.1], hp.2⟩
    have hshear_maps_Θ : ∀ p ∈ Ω_p, (p.1 + p.2, p.2) ∈ Ω_Θ := by
      intro p hp
      refine ⟨?_, hp.2⟩
      have him : |(p.1 + p.2).im| ≤ |p.1.im| + ‖p.2‖ := by
        calc |(p.1 + p.2).im| = |p.1.im + p.2.im| := by simp
          _ ≤ |p.1.im| + |p.2.im| := abs_add_le _ _
          _ ≤ |p.1.im| + ‖p.2‖ := by gcongr; exact Complex.abs_im_le_norm p.2
      linarith [hp.1, hp.2]
    let Θ₀ : ℂ × ℂ → ℂ := fun p => B.ϕ_ℂ (N.U p)
    let Θ₁ : ℂ × ℂ → ℂ := fun p => B.ϕ_ℂ (N.U (p.1 + p.2, p.2))
    let p_act : ℂ × ℂ → ℂ := fun p => -supportAction1_ℂ B.h_ℂ (Θ₀ p) (Θ₁ p)
    let B₀_jac : ℂ × ℂ → ℂ := fun p =>
      deriv (fun y' : ℂ => p_act (y', p.2)) p.1 * deriv (fun t' : ℂ => Θ₀ (p.1, t')) p.2 -
      deriv (fun t' : ℂ => p_act (p.1, t')) p.2 * deriv (fun y' : ℂ => Θ₀ (y', p.2)) p.1
    have hΘ₀_holo : DifferentiableOn ℂ Θ₀ Ω_Θ := by
      refine B.ϕ_ℂ_holo.comp (N.U_holo.mono ?_) ?_
      · intro p hp; exact ⟨by linarith [hp.1], hp.2⟩
      · intro p hp; exact N.U_maps_to_wide p.1 p.2 hp.1 hp.2
    have hΘ₀_maps : ∀ p ∈ Ω_Θ, Θ₀ p ∈ horizStrip (2 * B.s_h) :=
      fun p hp => B.ϕ_ℂ_maps_to (N.U p) (N.U_maps_to_wide p.1 p.2 hp.1 hp.2)
    have hΘ₁_holo : DifferentiableOn ℂ Θ₁ Ω_p :=
      hΘ₀_holo.comp ((differentiable_fst.add differentiable_snd).prodMk differentiable_snd).differentiableOn
        hshear_maps_Θ
    have hΘ₁_maps : ∀ p ∈ Ω_p, Θ₁ p ∈ horizStrip (2 * B.s_h) :=
      fun p hp => hΘ₀_maps (p.1 + p.2, p.2) (hshear_maps_Θ p hp)
    have hMid_maps : ∀ p ∈ Ω_p, (Θ₀ p + Θ₁ p) / 2 ∈ horizStrip (2 * B.s_h) := by
      intro p hp
      have h0 := hΘ₀_maps p (hp_sub_Θ hp)
      have h1 := hΘ₁_maps p hp
      have hconv := hConvStrip (2 * B.s_h) h0 h1 (a := (1 / 2 : ℝ)) (b := (1 / 2 : ℝ))
        (by norm_num) (by norm_num) (by norm_num)
      have heq : (1 / 2 : ℝ) • Θ₀ p + (1 / 2 : ℝ) • Θ₁ p = (Θ₀ p + Θ₁ p) / 2 := by
        simp [Complex.real_smul]; ring
      rwa [heq] at hconv
    have hh1_holo : DifferentiableOn ℂ (deriv B.h_ℂ) (horizStrip (2 * B.s_h)) :=
      B.h_ℂ_holo.deriv (hOpenStrip (2 * B.s_h))
    have hh2_holo : DifferentiableOn ℂ (deriv (deriv B.h_ℂ)) (horizStrip (2 * B.s_h)) :=
      hh1_holo.deriv (hOpenStrip (2 * B.s_h))
    have hp_act_holo : DifferentiableOn ℂ p_act Ω_p := by
      have hmid_holo : DifferentiableOn ℂ (fun p => (Θ₀ p + Θ₁ p) / 2) Ω_p :=
        (((hΘ₀_holo.mono hp_sub_Θ).add hΘ₁_holo).const_mul (2 : ℂ)⁻¹).congr
          (fun p _ => by simp only [Pi.add_apply]; ring)
      have hdel_holo : DifferentiableOn ℂ (fun p => (Θ₁ p - Θ₀ p) / 2) Ω_p :=
        ((hΘ₁_holo.sub (hΘ₀_holo.mono hp_sub_Θ)).const_mul (2 : ℂ)⁻¹).congr
          (fun p _ => by simp only [Pi.sub_apply]; ring)
      have ht1 : DifferentiableOn ℂ
          (fun p => deriv B.h_ℂ ((Θ₀ p + Θ₁ p) / 2) * Complex.sin ((Θ₁ p - Θ₀ p) / 2)) Ω_p :=
        (hh1_holo.comp hmid_holo hMid_maps).mul (Complex.differentiable_sin.comp_differentiableOn hdel_holo)
      have ht2 : DifferentiableOn ℂ
          (fun p => B.h_ℂ ((Θ₀ p + Θ₁ p) / 2) * Complex.cos ((Θ₁ p - Θ₀ p) / 2)) Ω_p :=
        (B.h_ℂ_holo.comp hmid_holo hMid_maps).mul (Complex.differentiable_cos.comp_differentiableOn hdel_holo)
      exact (ht1.sub ht2).neg
    have hB₀_holo : DifferentiableOn ℂ B₀_jac Ω_p :=
      ((hHolo_derivY Ω_p p_act hOpen_p hp_act_holo).mul
        (hHolo_derivT Ω_p Θ₀ hOpen_p (hΘ₀_holo.mono hp_sub_Θ))).sub
      ((hHolo_derivT Ω_p p_act hOpen_p hp_act_holo).mul
        (hHolo_derivY Ω_p Θ₀ hOpen_p (hΘ₀_holo.mono hp_sub_Θ)))
    let S₁₂ : ℂ → ℂ → ℂ := fun θ₁ θ₂ =>
      (1 / 2 : ℂ) * (B.h_ℂ ((θ₁ + θ₂) / 2) + deriv (deriv B.h_ℂ) ((θ₁ + θ₂) / 2)) *
        Complex.sin ((θ₂ - θ₁) / 2)
    let S₁₁ : ℂ → ℂ → ℂ := fun θ₁ θ₂ =>
      (1 / 2 : ℂ) * (deriv (deriv B.h_ℂ) ((θ₁ + θ₂) / 2) - B.h_ℂ ((θ₁ + θ₂) / 2)) *
        Complex.sin ((θ₂ - θ₁) / 2) - deriv B.h_ℂ ((θ₁ + θ₂) / 2) * Complex.cos ((θ₂ - θ₁) / 2)
    let S₂₂ : ℂ → ℂ → ℂ := fun θ₁ θ₂ =>
      (1 / 2 : ℂ) * (deriv (deriv B.h_ℂ) ((θ₁ + θ₂) / 2) - B.h_ℂ ((θ₁ + θ₂) / 2)) *
        Complex.sin ((θ₂ - θ₁) / 2) + deriv B.h_ℂ ((θ₁ + θ₂) / 2) * Complex.cos ((θ₂ - θ₁) / 2)
    have hChain_S : ∀ (θ₀ θ₁ : ℂ → ℂ) (z d₀ d₁ : ℂ),
        HasDerivAt θ₀ d₀ z → HasDerivAt θ₁ d₁ z →
        (θ₀ z + θ₁ z) / 2 ∈ horizStrip (2 * B.s_h) →
        HasDerivAt (fun w => -supportAction1_ℂ B.h_ℂ (θ₀ w) (θ₁ w))
          (-S₁₁ (θ₀ z) (θ₁ z) * d₀ - S₁₂ (θ₀ z) (θ₁ z) * d₁) z ∧
        HasDerivAt (fun w => supportAction2_ℂ B.h_ℂ (θ₀ w) (θ₁ w))
          (S₁₂ (θ₀ z) (θ₁ z) * d₀ + S₂₂ (θ₀ z) (θ₁ z) * d₁) z := by
      intro θ₀ θ₁ z d₀ d₁ hd₀ hd₁ hmid_mem
      let μ := (θ₀ z + θ₁ z) / 2
      let Δ := (θ₁ z - θ₀ z) / 2
      have hμ_nhds : horizStrip (2 * B.s_h) ∈ nhds μ :=
        (hOpenStrip (2 * B.s_h)).mem_nhds hmid_mem
      have hh_da : HasDerivAt B.h_ℂ (deriv B.h_ℂ μ) μ :=
        (B.h_ℂ_holo.differentiableAt hμ_nhds).hasDerivAt
      have hh'_da : HasDerivAt (deriv B.h_ℂ) (deriv (deriv B.h_ℂ) μ) μ :=
        (hh1_holo.differentiableAt hμ_nhds).hasDerivAt
      have hμ_d : HasDerivAt (fun w => (θ₀ w + θ₁ w) / 2) ((d₀ + d₁) / 2) z :=
        (hd₀.add hd₁).div_const 2
      have hΔ_d : HasDerivAt (fun w => (θ₁ w - θ₀ w) / 2) ((d₁ - d₀) / 2) z :=
        (hd₁.sub hd₀).div_const 2
      have h_hμ : HasDerivAt (B.h_ℂ ∘ fun w => (θ₀ w + θ₁ w) / 2)
          (deriv B.h_ℂ μ * ((d₀ + d₁) / 2)) z := hh_da.comp z hμ_d
      have h_h'μ : HasDerivAt (deriv B.h_ℂ ∘ fun w => (θ₀ w + θ₁ w) / 2)
          (deriv (deriv B.h_ℂ) μ * ((d₀ + d₁) / 2)) z := hh'_da.comp z hμ_d
      have h_sinΔ : HasDerivAt (Complex.sin ∘ fun w => (θ₁ w - θ₀ w) / 2)
          (Complex.cos Δ * ((d₁ - d₀) / 2)) z := (Complex.hasDerivAt_sin Δ).comp z hΔ_d
      have h_cosΔ : HasDerivAt (Complex.cos ∘ fun w => (θ₁ w - θ₀ w) / 2)
          (-Complex.sin Δ * ((d₁ - d₀) / 2)) z := (Complex.hasDerivAt_cos Δ).comp z hΔ_d
      have hs1 := ((h_h'μ.mul h_sinΔ).sub (h_hμ.mul h_cosΔ)).neg
      have hs2 := (h_h'μ.mul h_sinΔ).add (h_hμ.mul h_cosΔ)
      refine ⟨?_, ?_⟩
      · have hd_eq : -(deriv (deriv B.h_ℂ) μ * ((d₀ + d₁) / 2) * Complex.sin Δ +
              deriv B.h_ℂ μ * (Complex.cos Δ * ((d₁ - d₀) / 2)) -
            (deriv B.h_ℂ μ * ((d₀ + d₁) / 2) * Complex.cos Δ +
              B.h_ℂ μ * (-Complex.sin Δ * ((d₁ - d₀) / 2)))) =
            -S₁₁ (θ₀ z) (θ₁ z) * d₀ - S₁₂ (θ₀ z) (θ₁ z) * d₁ := by
          dsimp [S₁₁, S₁₂, μ, Δ]; ring
        rw [← hd_eq]
        exact hs1
      · have hd_eq : deriv (deriv B.h_ℂ) μ * ((d₀ + d₁) / 2) * Complex.sin Δ +
            deriv B.h_ℂ μ * (Complex.cos Δ * ((d₁ - d₀) / 2)) +
            (deriv B.h_ℂ μ * ((d₀ + d₁) / 2) * Complex.cos Δ +
              B.h_ℂ μ * (-Complex.sin Δ * ((d₁ - d₀) / 2))) =
            S₁₂ (θ₀ z) (θ₁ z) * d₀ + S₂₂ (θ₀ z) (θ₁ z) * d₁ := by
          dsimp [S₁₂, S₂₂, μ, Δ]; ring
        rw [← hd_eq]
        exact hs2
    have hB₀_factor : ∀ y t : ℂ, (y, t) ∈ Ω_p →
        B₀_jac (y, t) = S₁₂ (Θ₀ (y, t)) (Θ₁ (y, t)) *
          (deriv (fun y' => Θ₀ (y', t)) y * deriv (fun t' => Θ₁ (y, t')) t -
            deriv (fun t' => Θ₀ (y, t')) t * deriv (fun y' => Θ₁ (y', t)) y) := by
      intro y t hyt
      obtain ⟨hΘ₀_da_y, hΘ₀_da_t⟩ := hSlice_da Ω_p Θ₀ y t hOpen_p (hΘ₀_holo.mono hp_sub_Θ) hyt
      obtain ⟨hΘ₁_da_y, hΘ₁_da_t⟩ := hSlice_da Ω_p Θ₁ y t hOpen_p hΘ₁_holo hyt
      have hpy := (hChain_S (fun y' => Θ₀ (y', t)) (fun y' => Θ₁ (y', t)) y _ _
        hΘ₀_da_y.hasDerivAt hΘ₁_da_y.hasDerivAt (hMid_maps (y, t) hyt)).1.deriv
      have hpt := (hChain_S (fun t' => Θ₀ (y, t')) (fun t' => Θ₁ (y, t')) t _ _
        hΘ₀_da_t.hasDerivAt hΘ₁_da_t.hasDerivAt (hMid_maps (y, t) hyt)).1.deriv
      dsimp only [B₀_jac, p_act]
      rw [hpy, hpt]
      ring
    have hShear_deriv : ∀ (g : ℂ × ℂ → ℂ) (y t : ℂ), (y + t, t) ∈ Ω_p →
        DifferentiableOn ℂ g Ω_p →
        deriv (fun y' : ℂ => g (y' + t, t)) y = deriv (fun y' : ℂ => g (y', t)) (y + t) ∧
        deriv (fun t' : ℂ => g (y + t', t')) t =
          deriv (fun y' : ℂ => g (y', t)) (y + t) + deriv (fun t' : ℂ => g (y + t, t')) t := by
      intro g y t hmem hg
      have hg_da : DifferentiableAt ℂ g (y + t, t) := hg.differentiableAt (hOpen_p.mem_nhds hmem)
      let L := fderiv ℂ g (y + t, t)
      have hfd : HasFDerivAt g L (y + t, t) := hg_da.hasFDerivAt
      have h1 : HasDerivAt (g ∘ fun y' : ℂ => (y', t)) (L (1, 0)) (y + t) :=
        hfd.comp_hasDerivAt (y + t) ((hasDerivAt_id (y + t)).prodMk (hasDerivAt_const (y + t) t))
      have h2 : HasDerivAt (g ∘ fun t' : ℂ => (y + t, t')) (L (0, 1)) t :=
        hfd.comp_hasDerivAt t ((hasDerivAt_const t (y + t)).prodMk (hasDerivAt_id t))
      have h1_sh : HasDerivAt (g ∘ fun y' : ℂ => (y' + t, t)) (L (1, 0)) y :=
        hfd.comp_hasDerivAt y (((hasDerivAt_id y).add_const t).prodMk (hasDerivAt_const y t))
      have h2_sh : HasDerivAt (g ∘ fun t' : ℂ => (y + t', t')) (L (1, 1)) t :=
        HasFDerivAt.comp_hasDerivAt (f := fun t' : ℂ => (y + t', t')) t hfd
          (((hasDerivAt_id t).const_add y).prodMk (hasDerivAt_id t))
      have hL_add : L (1, 1) = L (1, 0) + L (0, 1) := by
        have : ((1 : ℂ), (1 : ℂ)) = (1, 0) + (0, 1) := by ext <;> simp
        rw [this, L.map_add]
      have hd1 : deriv (fun y' : ℂ => g (y', t)) (y + t) = L (1, 0) := h1.deriv
      have hd2 : deriv (fun t' : ℂ => g (y + t, t')) t = L (0, 1) := h2.deriv
      have hd1_sh : deriv (fun y' : ℂ => g (y' + t, t)) y = L (1, 0) := h1_sh.deriv
      have hd2_sh : deriv (fun t' : ℂ => g (y + t', t')) t = L (1, 1) := h2_sh.deriv
      rw [hd1_sh, hd1, hd2_sh, hd2, hL_add]
      exact ⟨rfl, rfl⟩
    have hShear_inv : ∀ y t : ℂ, |y.im| < (5 / 4 : ℝ) * N.s₁ → ‖t‖ < N.r_in →
        B₀_jac (y + t, t) = B₀_jac (y, t) := by
      intro y t hy ht
      have hyt_p : (y, t) ∈ Ω_p := ⟨by linarith, ht⟩
      have hshift_p : (y + t, t) ∈ Ω_p := by
        refine ⟨?_, ht⟩
        have him : |(y + t).im| ≤ |y.im| + ‖t‖ := by
          calc |(y + t).im| = |y.im + t.im| := by simp
            _ ≤ |y.im| + |t.im| := abs_add_le _ _
            _ ≤ |y.im| + ‖t‖ := by gcongr; exact Complex.abs_im_le_norm t
        linarith
      let p₁ : ℂ × ℂ → ℂ := fun q => p_act (q.1 + q.2, q.2)
      let S₂_comp : ℂ × ℂ → ℂ := fun q => supportAction2_ℂ B.h_ℂ (Θ₀ q) (Θ₁ q)
      let W_sh : Set (ℂ × ℂ) :=
        { q : ℂ × ℂ | |(q.1 + q.2).im| < (3 / 2 : ℝ) * N.s₁ ∧ ‖q.2‖ < N.r_in }
      have hW_sh_open : IsOpen W_sh :=
        (isOpen_lt (continuous_abs.comp (Complex.continuous_im.comp
          (continuous_fst.add continuous_snd))) continuous_const).inter
          (isOpen_lt (continuous_norm.comp continuous_snd) continuous_const)
      have hyt_W : (y, t) ∈ W_sh := ⟨hshift_p.1, ht⟩
      have hp₁_eq_S₂ : p₁ =ᶠ[nhds (y, t)] S₂_comp := by
        filter_upwards [hW_sh_open.mem_nhds hyt_W] with q hq
        dsimp [p₁, p_act, S₂_comp, Θ₀, Θ₁]
        have hstat := N.glancing_stationary_wide (q.1 + q.2) q.2 hq.1 hq.2
        have hsub_cancel : q.1 + q.2 - q.2 = q.1 := by ring
        rw [hsub_cancel] at hstat
        exact hstat
      have hp₁_y_eq : (fun y' => p₁ (y', t)) =ᶠ[nhds y] (fun y' => S₂_comp (y', t)) :=
        hp₁_eq_S₂.comp_tendsto ((continuous_id.prodMk continuous_const).tendsto y)
      have hp₁_t_eq : (fun t' => p₁ (y, t')) =ᶠ[nhds t] (fun t' => S₂_comp (y, t')) :=
        hp₁_eq_S₂.comp_tendsto ((continuous_const.prodMk continuous_id).tendsto t)
      obtain ⟨hp_sh_y, hp_sh_t⟩ := hShear_deriv p_act y t hshift_p hp_act_holo
      obtain ⟨hΘ_sh_y, hΘ_sh_t⟩ := hShear_deriv Θ₀ y t hshift_p (hΘ₀_holo.mono hp_sub_Θ)
      obtain ⟨hΘ₀_da_y, hΘ₀_da_t⟩ := hSlice_da Ω_p Θ₀ y t hOpen_p (hΘ₀_holo.mono hp_sub_Θ) hyt_p
      obtain ⟨hΘ₁_da_y, hΘ₁_da_t⟩ := hSlice_da Ω_p Θ₁ y t hOpen_p hΘ₁_holo hyt_p
      have hS₂_y := (hChain_S (fun y' => Θ₀ (y', t)) (fun y' => Θ₁ (y', t)) y _ _
        hΘ₀_da_y.hasDerivAt hΘ₁_da_y.hasDerivAt (hMid_maps (y, t) hyt_p)).2.deriv
      have hS₂_t := (hChain_S (fun t' => Θ₀ (y, t')) (fun t' => Θ₁ (y, t')) t _ _
        hΘ₀_da_t.hasDerivAt hΘ₁_da_t.hasDerivAt (hMid_maps (y, t) hyt_p)).2.deriv
      have hLHS : deriv (fun y' => p₁ (y', t)) y * deriv (fun t' => Θ₁ (y, t')) t -
          deriv (fun t' => p₁ (y, t')) t * deriv (fun y' => Θ₁ (y', t)) y = B₀_jac (y + t, t) := by
        dsimp only [p₁, Θ₁, B₀_jac]
        change deriv (fun y' => p_act (y' + t, t)) y * deriv (fun t' => Θ₀ (y + t', t')) t -
          deriv (fun t' => p_act (y + t', t')) t * deriv (fun y' => Θ₀ (y' + t, t)) y = _
        rw [hp_sh_y, hp_sh_t, hΘ_sh_y, hΘ_sh_t]
        ring
      have hRHS : deriv (fun y' => p₁ (y', t)) y * deriv (fun t' => Θ₁ (y, t')) t -
          deriv (fun t' => p₁ (y, t')) t * deriv (fun y' => Θ₁ (y', t)) y = B₀_jac (y, t) := by
        rw [hp₁_y_eq.deriv_eq, hp₁_t_eq.deriv_eq]
        dsimp only [S₂_comp]
        rw [hS₂_y, hS₂_t, hB₀_factor y t hyt_p]
        ring
      exact hLHS.symm.trans hRHS
    have hIterD_holo : ∀ (n : ℕ) (R : ℝ) (g : ℂ → ℂ), 0 < R →
        DifferentiableOn ℂ g (Metric.ball 0 R) →
        DifferentiableOn ℂ (glancingIterDslopeAtZero n g) (Metric.ball 0 R) := by
      intro n R g hR hg
      induction n with
      | zero => exact hg
      | succ n ih => exact (Complex.differentiableOn_dslope (Metric.ball_mem_nhds 0 hR)).mpr ih
    have hIterD_gen_bd : ∀ (n : ℕ) (R M : ℝ) (g : ℂ → ℂ), 0 < R → 0 ≤ M →
        DifferentiableOn ℂ g (Metric.ball 0 R) →
        (∀ z ∈ Metric.ball 0 R, ‖g z‖ ≤ M) →
        ∀ z ∈ Metric.ball 0 R, ‖glancingIterDslopeAtZero n g z‖ ≤ M * (2 / R) ^ n := by
      intro n R M g hR hM hg hbd
      induction n with
      | zero => intro z hz; simpa [glancingIterDslopeAtZero] using hbd z hz
      | succ n ih =>
          intro z hz
          have hn_holo := hIterD_holo n R g hR hg
          have hmaps : Set.MapsTo (glancingIterDslopeAtZero n g) (Metric.ball 0 R)
              (Metric.closedBall (glancingIterDslopeAtZero n g 0) (2 * (M * (2 / R) ^ n))) := by
            intro w hw
            rw [Metric.mem_closedBall, dist_eq_norm]
            calc ‖glancingIterDslopeAtZero n g w - glancingIterDslopeAtZero n g 0‖
                ≤ ‖glancingIterDslopeAtZero n g w‖ + ‖glancingIterDslopeAtZero n g 0‖ := norm_sub_le _ _
              _ ≤ M * (2 / R) ^ n + M * (2 / R) ^ n :=
                  add_le_add (ih w hw) (ih 0 (Metric.mem_ball_self hR))
              _ = 2 * (M * (2 / R) ^ n) := by ring
          have hd := Complex.norm_dslope_le_div_of_mapsTo_ball hn_holo hmaps hz
          calc ‖glancingIterDslopeAtZero (n + 1) g z‖
              ≤ (2 * (M * (2 / R) ^ n)) / R := hd
            _ = M * (2 / R) ^ (n + 1) := by rw [pow_succ]; ring
    let Q_fn : ℕ → ℂ → ℂ → ℂ := fun n y τ => glancingIterDslopeAtZero n (fun z => B₀_jac (y, z)) τ
    let R_loc : ℝ := (3 / 4 : ℝ) * N.r_in
    have hR_loc_pos : 0 < R_loc := by positivity
    have hR_loc_lt : R_loc < N.r_in := by dsimp [R_loc]; linarith
    have hB₀_y_holo : ∀ y : ℂ, |y.im| < (3 / 2 : ℝ) * N.s₁ →
        DifferentiableOn ℂ (fun τ => B₀_jac (y, τ)) (Metric.ball 0 N.r_in) := by
      intro y hy
      refine hB₀_holo.comp ((differentiable_const y).prodMk differentiable_id).differentiableOn ?_
      intro τ hτ
      exact ⟨hy, by simpa using hτ⟩
    have hQ_loc_bd : ∀ y₀ ∈ horizStrip ((5 / 4 : ℝ) * N.s₁),
        ∃ (ρ M_loc : ℝ), 0 < ρ ∧ 0 < M_loc ∧
          Metric.ball y₀ ρ ⊆ horizStrip ((5 / 4 : ℝ) * N.s₁) ∧
          (∀ (n : ℕ) (y' : ℂ), y' ∈ Metric.ball y₀ ρ → ∀ τ ∈ Metric.ball (0 : ℂ) R_loc,
            ‖Q_fn n y' τ‖ ≤ M_loc * (2 / R_loc) ^ n) := by
      intro y₀ hy₀
      change |y₀.im| < (5 / 4 : ℝ) * N.s₁ at hy₀
      let ρ : ℝ := ((5 / 4 : ℝ) * N.s₁ - |y₀.im|) / 2
      have hρ_pos : 0 < ρ := by dsimp [ρ]; linarith
      have hball_sub_54 : Metric.ball y₀ ρ ⊆ horizStrip ((5 / 4 : ℝ) * N.s₁) := by
        intro y' hy'
        change |y'.im| < (5 / 4 : ℝ) * N.s₁
        rw [Metric.mem_ball, dist_eq_norm] at hy'
        have him : |y'.im| ≤ |y₀.im| + ‖y' - y₀‖ := by
          calc |y'.im| = |y₀.im + (y' - y₀).im| := by rw [← Complex.add_im]; ring_nf
            _ ≤ |y₀.im| + |(y' - y₀).im| := abs_add_le _ _
            _ ≤ |y₀.im| + ‖y' - y₀‖ := by gcongr; exact Complex.abs_im_le_norm _
        dsimp [ρ] at hy'
        linarith
