        have hsub : x₀ - ρ_star = -(δ / 2) := by dsimp [x₀]; ring
        rw [hsub, abs_neg, abs_of_pos (by positivity)]
        linarith
      have hx₀_in_ρ : (x₀ : ℂ) ∈ Metric.ball (0 : ℂ) ρ_star := by
        rw [Metric.mem_ball, dist_zero_right, Complex.norm_real, Real.norm_eq_abs,
          abs_of_pos hx₀_pos]
        exact hx₀_mem_Ioo.2
      have hg_ana_x₀ : AnalyticAt ℂ g (x₀ : ℂ) :=
        ((Complex.analyticOnNhd_iff_differentiableOn Metric.isOpen_ball).mpr hg_holo)
          (x₀ : ℂ) hx₀_in_rg
      have hS_ana_x₀ : AnalyticAt ℂ S (x₀ : ℂ) :=
        ((Complex.analyticOnNhd_iff_differentiableOn Metric.isOpen_ball).mpr hS_holo)
          (x₀ : ℂ) hx₀_in_ρ
      have hg_ev_S : g =ᶠ[nhds (x₀ : ℂ)] S := by
        refine (hg_ana_x₀.frequently_eq_iff_eventually_eq hS_ana_x₀).mp ?_
        let z_seq : ℕ → ℂ := fun m => ((x₀ + (δ / 4) / ((m : ℝ) + 1) : ℝ) : ℂ)
        have hz_tend_r : Filter.Tendsto (fun m : ℕ => x₀ + (δ / 4) / ((m : ℝ) + 1))
            Filter.atTop (nhds x₀) := by
          have h0 : Filter.Tendsto (fun m : ℕ => (δ / 4) / ((m : ℝ) + 1)) Filter.atTop (nhds 0) :=
