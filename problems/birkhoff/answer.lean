            _ = (q ^ 2) ^ m := pow_mul q 2 m
        have hg_bound : ∀ z ∈ Metric.ball (0 : ℂ) R, ∀ m : ℕ,
            ‖(c m : ℂ) * z ^ (2 * m)‖ ≤ C * (q ^ 2) ^ m := by
          intro z hz m
          have hzR : ‖z‖ ≤ R := le_of_lt (by simpa using hz)
          calc ‖(c m : ℂ) * z ^ (2 * m)‖
