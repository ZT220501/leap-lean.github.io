      ring
    have hu_zero_deriv : ∀ w ∈ B_punc,
        HasDerivAt (fun z => u_tan z + ((C.c : ℂ) / α ^ 2) * (z - s₀)⁻¹ - U_prim z) 0 w := by
      rintro w ⟨hwB, hw_ne⟩
      have hwD : w ∈ D_H := hB_sub hwB
      have hsub_ne : w - s₀ ≠ 0 := sub_ne_zero.mpr hw_ne
      have hgw_ne : g₁ w ≠ 0 := hg₁_ne w hwB
      have hfw_ne : K.f w ≠ 0 := by rw [hf_fac w]; exact mul_ne_zero hsub_ne hgw_ne
      have hΓ₀ : HasDerivAt (fun z => K.Γ z 0)
          (-(C.c : ℂ) * (K.f w)⁻¹ ^ 2 * Complex.sin (K.ϕ w)) w := by
        rw [← K.Γ_deriv₀ w hwD hfw_ne]
        exact (K.Γ_reg_holo w hwD hfw_ne).1.hasDerivAt
      have hΓ₁ : HasDerivAt (fun z => K.Γ z 1)
          ((C.c : ℂ) * (K.f w)⁻¹ ^ 2 * Complex.cos (K.ϕ w)) w := by
        rw [← K.Γ_deriv₁ w hwD hfw_ne]
        exact (K.Γ_reg_holo w hwD hfw_ne).2.hasDerivAt
      have hΓ₀_neg : HasDerivAt (fun z => -K.Γ z 0)
          (-(-(C.c : ℂ) * (K.f w)⁻¹ ^ 2 * Complex.sin (K.ϕ w))) w := hΓ₀.neg
      have hu_d : HasDerivAt u_tan
          (((C.c : ℂ) / α ^ 2) / (w - s₀) ^ 2 + (C.c : ℂ) * h_u w) w := by
        convert (hΓ₀_neg.mul_const (Complex.sin ϕ₀)).add (hΓ₁.mul_const (Complex.cos ϕ₀)) using 1
        have hc : Complex.cos (K.ϕ w - ϕ₀) = (g₁ w) ^ 2 * (α⁻¹ ^ 2 + (w - s₀) ^ 2 * h_u w) := by
          have hcf := hcos_fac w
