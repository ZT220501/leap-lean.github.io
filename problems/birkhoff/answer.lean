    have hw_real_tendsto : Filter.Tendsto (idpluWReal I)
        (nhdsWithin I.v_c (Set.Iio I.v_c)) (nhds (idpluRadius I)) := by
      rw [Metric.tendsto_nhds]
      intro ε hε
      have hlt_sup : idpluRadius I - ε < idpluRadius I := by linarith
      obtain ⟨_, ⟨r₀, hr₀_mem, rfl⟩, hr₀_gt⟩ := (lt_csSup_iff hIm_bdd hIm_ne).mp hlt_sup
      have hev : Set.Ioo r₀ I.v_c ∈ nhdsWithin I.v_c (Set.Iio I.v_c) := by
        rw [mem_nhdsWithin_iff_exists_mem_nhds_inter]
        exact ⟨Set.Ioi r₀, isOpen_Ioi.mem_nhds hr₀_mem.2, fun x hx => ⟨hx.1, hx.2⟩⟩
      refine Filter.Eventually.mp hev (Filter.Eventually.of_forall ?_)
      intro r hr
      have hr_ico : r ∈ Set.Ico (0 : ℝ) I.v_c := ⟨le_trans hr₀_mem.1 hr.1.le, hr.2⟩
      have hmono : idpluWReal I r₀ < idpluWReal I r :=
