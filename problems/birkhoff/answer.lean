        DifferentiableOn ℂ (fun ε => ∑ i ∈ S, F i ε) U := by
      intro ι S F U hS
      classical
      induction S using Finset.induction_on with
      | empty =>
        simp only [Finset.sum_empty]
        exact differentiableOn_const (0 : ℂ)
      | insert i₀ S' hi₀ ih =>
        simp only [Finset.sum_insert hi₀]
        exact (hS i₀ (Finset.mem_insert_self i₀ S')).add
          (ih fun j hj => hS j (Finset.mem_insert_of_mem hj))
    have iterDeriv_sum : ∀ {ι : Type} (S : Finset ι) (F : ι → ℂ → ℂ) (q : ℕ),
