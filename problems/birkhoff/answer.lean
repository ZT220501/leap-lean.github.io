        linarith
      let x₀ : ℝ := ρ_star - δ / 2
      have hx₀_pos : 0 < x₀ := by dsimp [x₀]; linarith
      have hx₀_mem_Ioo : x₀ ∈ Set.Ioo x_lo ρ_star := ⟨by dsimp [x₀]; linarith, by dsimp [x₀]; linarith⟩
      have hx₀_mem_ρ : x₀ ∈ Set.Ioo (0 : ℝ) ρ_star := ⟨hx₀_pos, hx₀_mem_Ioo.2⟩
      have hx₀_in_rg : (x₀ : ℂ) ∈ Metric.ball (ρ_star : ℂ) r_g := by
        rw [Metric.mem_ball, Complex.dist_eq, ← Complex.ofReal_sub, Complex.norm_real,
