    have h_ball_deficit_le : ∀ (K B : ℝ) (z₀ : ℂ) (Δ : ℝ),
        0 ≤ K → 0 ≤ B → 0 < Δ →
        Metric.closedBall z₀ Δ ⊆ horizStrip S.H →
        (∀ z ∈ Metric.closedBall z₀ Δ, ‖S.f z‖ ≤ Real.exp K) →
        MeasureTheory.IntegrableOn (fun w : ℂ => K - Real.log ‖S.f w‖)
          (Metric.ball z₀ Δ) MeasureTheory.volume →
        (∀ m : ℕ, (∫ w in Metric.ball z₀ Δ, ldtTruncDeficit S K m w) ≤ B) →
        (∫ w in Metric.ball z₀ Δ, (K - Real.log ‖S.f w‖)) ≤ B := by
      intro K B z₀ Δ hK hB hΔ hcb hnorm hint htrunc
      let μ := MeasureTheory.volume.restrict (Metric.ball z₀ Δ)
      have hraw_nonneg : ∀ w ∈ Metric.ball z₀ Δ, 0 ≤ K - Real.log ‖S.f w‖ := by
        intro w hw
        by_cases hfw : S.f w = 0
        · simp [hfw, hK]
        · have hpos : 0 < ‖S.f w‖ := norm_pos_iff.mpr hfw
          have hle : Real.log ‖S.f w‖ ≤ K :=
            (Real.log_le_iff_le_exp hpos).mpr (hnorm w (Metric.ball_subset_closedBall hw))
          linarith
