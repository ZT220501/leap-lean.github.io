                  ext n; simp only [Finset.mem_filter, Finset.mem_range]; omega
                rw [hfilt]
          _ = ∑ s ∈ Finset.range (N + 1),
                MvPowerSeries.C (PowerSeries.C (1 / (s.factorial : ℂ)) * A s) * Ψ_lift ^ s := by
                apply Finset.sum_congr rfl
                intro s _
                have hZ_sub : Z + MvPowerSeries.C (-Δ) = Ψ_lift := by
