            (∀ j : Fin N, j ∉ S → r j = 0) ∧
            (∀ j : Fin N, 0 ≤ r j) ∧
            (∑ j ∈ S, r j) ≤ (3 * δ / (N : ℝ)) * (S.card : ℝ) ∧
            (∀ z : ℂ, (∀ j ∈ S, z ∉ Metric.ball (a j) (r j)) →
              ∀ i : ℕ, 1 ≤ i → i ≤ N → T_set z i ⊆ S → (T_set z i).card < i) := by
        intro n
        induction' n using Nat.strong_induction_on with n ih
        intro S hn
        subst hn
        rcases S.eq_empty_or_nonempty with rfl | hS_ne
        · refine ⟨fun _ => 0, fun _ _ => rfl, fun _ => le_rfl, by simp, ?_⟩
          intro z _ i hi1 _ hsub
          have hemp : T_set z i = ∅ := Finset.subset_empty.mp hsub
          rw [hemp, Finset.card_empty]
          omega
        · let qualifies : ℕ → Prop := fun k =>
            ∃ ν ∈ S, k ≤ (S.filter (fun μ => ‖a μ - a ν‖ < 2 * δ * (k : ℝ) / (N : ℝ))).card
          let K_qual : Finset ℕ := (Finset.Icc 1 S.card).filter qualifies
          have h1_mem : 1 ∈ K_qual := by
            obtain ⟨ν₀, hν₀⟩ := hS_ne
            rw [Finset.mem_filter, Finset.mem_Icc]
            refine ⟨⟨le_rfl, Finset.Nonempty.card_pos ⟨ν₀, hν₀⟩⟩, ν₀, hν₀, ?_⟩
            have hself : ν₀ ∈ S.filter (fun μ => ‖a μ - a ν₀‖ < 2 * δ * ((1 : ℕ) : ℝ) / (N : ℝ)) := by
              rw [Finset.mem_filter]
              exact ⟨hν₀, by simp; positivity⟩
            exact Finset.card_pos.mpr ⟨ν₀, hself⟩
          have hK_ne : K_qual.Nonempty := ⟨1, h1_mem⟩
          let k_star : ℕ := K_qual.max' hK_ne
          have hk_mem : k_star ∈ K_qual := K_qual.max'_mem hK_ne
          rw [Finset.mem_filter, Finset.mem_Icc] at hk_mem
          obtain ⟨⟨hk_ge1, _⟩, ν_star, hν_star, hk_card⟩ := hk_mem
          let A_star : Finset (Fin N) :=
            S.filter (fun μ => ‖a μ - a ν_star‖ < 2 * δ * (k_star : ℝ) / (N : ℝ))
          have hk_card' : k_star ≤ A_star.card := hk_card
          have hA_sub : A_star ⊆ S := Finset.filter_subset _ _
          have hν_in_A : ν_star ∈ A_star := by
            rw [Finset.mem_filter]
            refine ⟨hν_star, ?_⟩
            have hk_pos : (0 : ℝ) < (k_star : ℝ) := Nat.cast_pos.mpr (by omega)
            simp only [sub_self, norm_zero]
            positivity
          let S' : Finset (Fin N) := S \ A_star
          have hS'_disj : Disjoint S' A_star :=
            Finset.disjoint_left.mpr (fun _ hxS' hxA => (Finset.mem_sdiff.mp hxS').2 hxA)
          have hS'_union : S' ∪ A_star = S := Finset.sdiff_union_of_subset hA_sub
          have hcard_add : S'.card + A_star.card = S.card := by
            rw [← Finset.card_union_of_disjoint hS'_disj, hS'_union]
          have hS'_lt : S'.card < S.card := by omega
