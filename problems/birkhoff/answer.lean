                  mul_le_mul_of_nonneg_right hc1 hSpos_nonneg
              _ = (C_J / γ_steep * ‖t‖ ^ 2 * M_scale ^ 2) * (t.im * S_pos) := by ring
              _ ≤ (C_J / γ_steep * ‖t‖ ^ 2 * M_scale ^ 2) *
                    ((D (j + 2)) ^ (1 - 2 * α) / (2 * α - 1)) :=
                  mul_le_mul_of_nonneg_left h_mesh_pos (by positivity)
              _ = (C_J / ((2 * α - 1) * γ_steep)) *
                    ‖t‖ ^ 2 * M_scale ^ 2 * (D (j + 2)) ^ (1 - 2 * α) := by
                  have hne1 : γ_steep ≠ 0 := hγ1.ne'
                  have hne2 : 2 * α - 1 ≠ 0 := h2α_sub_pos.ne'
