      have hG_cont : ContinuousOn (fun x : (ℂ × ℂ) × ℝ × ℝ => G x.1 x.2.1 x.2.2) D_prod := by
        let φ_tor : (ℂ × ℂ) × ℝ × ℝ → (ℂ × ℂ) × (ℂ × ℂ) :=
