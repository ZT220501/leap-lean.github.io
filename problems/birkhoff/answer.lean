        dsimp [R₀, ε]
        field_simp [hr_pos.ne']
        ring
      linarith
    have hd_cancel : (d ^ α₁) ^ 2 * (S.H - y.im) ^ (1 - 2 * α₁) ≤ Real.exp (-k) := by
      have hd_sq : (d ^ α₁) ^ 2 = d ^ (2 * α₁) := by
        calc
          (d ^ α₁) ^ 2 = (d ^ α₁) ^ ((2 : ℕ) : ℝ) := (Real.rpow_natCast (d ^ α₁) 2).symm
          _ = d ^ (α₁ * ((2 : ℕ) : ℝ)) := (Real.rpow_mul hd_pos.le α₁ 2).symm
          _ = d ^ (2 * α₁) := by ring_nf
      have hy_rpow : (S.H - y.im) ^ (1 - 2 * α₁) =
          (2 : ℝ) ^ (1 - 2 * α₁) * d ^ (1 - 2 * α₁) := by
        have h2d : S.H - y.im = 2 * d := by rw [hy_depth]; dsimp [d]; ring
        rw [h2d, Real.mul_rpow (by norm_num) hd_pos.le]
      have h2_le_one : (2 : ℝ) ^ (1 - 2 * α₁) ≤ 1 := by
        calc
          (2 : ℝ) ^ (1 - 2 * α₁) ≤ (2 : ℝ) ^ (0 : ℝ) :=
            Real.rpow_le_rpow_of_exponent_le (by norm_num) (by linarith)
          _ = 1 := Real.rpow_zero 2
      have hd_sum : d ^ (2 * α₁) * d ^ (1 - 2 * α₁) = d := by
        calc
          d ^ (2 * α₁) * d ^ (1 - 2 * α₁) = d ^ (2 * α₁ + (1 - 2 * α₁)) :=
            (Real.rpow_add hd_pos _ _).symm
          _ = d ^ (1 : ℝ) := by ring_nf
          _ = d := Real.rpow_one d
      calc
        (d ^ α₁) ^ 2 * (S.H - y.im) ^ (1 - 2 * α₁)
            = (2 : ℝ) ^ (1 - 2 * α₁) * (d ^ (2 * α₁) * d ^ (1 - 2 * α₁)) := by
              rw [hd_sq, hy_rpow]; ring
        _ = (2 : ℝ) ^ (1 - 2 * α₁) * d := by rw [hd_sum]
        _ ≤ 1 * d := mul_le_mul_of_nonneg_right h2_le_one hd_pos.le
        _ = Real.exp (-k) / 2 := one_mul d
        _ ≤ Real.exp (-k) := by linarith
    have hy_rpow_nn : 0 ≤ (S.H - y.im) ^ (1 - 2 * α₁) :=
      Real.rpow_nonneg (by rw [hy_depth]; exact hexp_pos.le) _
    calc
      ‖h_y w‖ = ‖s_tilde (y, w) - y‖ := rfl
      _ ≤ C_cp * ((1 + (ε / r) * d ^ α₁) ^ 2 * ‖w‖ ^ 2) * (S.H - y.im) ^ (1 - 2 * α₁) := by
          linarith [hraw]
      _ ≤ C_cp * (9 * c₀ ^ 2 * (d ^ α₁) ^ 2) * (S.H - y.im) ^ (1 - 2 * α₁) := by
          exact mul_le_mul_of_nonneg_right
            (mul_le_mul_of_nonneg_left hsq_factor hCcp_pos.le) hy_rpow_nn
      _ = 9 * C_cp * c₀ ^ 2 * ((d ^ α₁) ^ 2 * (S.H - y.im) ^ (1 - 2 * α₁)) := by ring
      _ ≤ 9 * C_cp * c₀ ^ 2 * Real.exp (-k) :=
          mul_le_mul_of_nonneg_left hd_cancel (by positivity)

  
  let V₀ : ℂ := S.V y
  have hV₀_bound : R₀ ^ 2 * ‖V₀‖ ≤ M_err := by
    have hdc : DiffContOnCl ℂ h_y (Metric.ball (0 : ℂ) R₀) :=
