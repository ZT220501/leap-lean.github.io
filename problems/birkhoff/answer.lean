    exact ⟨ψ, S_star, hψ_mono, hS_holo_C₂, hS_loc_C₂, hS_deriv_loc_C₂, hS_disp_C₂⟩
  
  have h_s3 : ∀ (C_star : ℝ), 0 < C_star →
