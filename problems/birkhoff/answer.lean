      have hci2 : CircleIntegrable (fun _ : ℂ => sliceImpactSeq S P.N i.val y) y (ρ y) :=
        continuousOn_const.circleIntegrable hρ_pos.le
      change Real.circleAverage (sliceImpactSeq S P.N i.val -
          fun _ => sliceImpactSeq S P.N i.val y) y (ρ y) = 0
      rw [Real.circleAverage_sub hci1 hci2, hAvgS, Real.circleAverage_const, sub_self]
    let σ_pure : ℕ → Fin P.N → WalkSpace → ℕ := fun N_cap j om =>
      @Nat.find (fun m => N_cap ≤ m ∨ sliceShapeDepth S P j (walkPos ρ om m) ≤ d)
        (Classical.decPred _) ⟨N_cap, Or.inl le_rfl⟩
    let T_pure : ℕ → WalkSpace → ℕ := fun N_cap om =>
      J.sup' hJ (fun j => σ_pure N_cap j om)
    let η_pure : ℕ → WalkSpace → ℕ := fun N_cap om =>
      @Nat.find (fun m => T_pure N_cap om ≤ m ∧
        (N_cap ≤ m ∨ r_exit < ‖sliceImpactSeq S P.N i.val (walkPos ρ om m) -
          sliceImpactSeq S P.N i.val (walkPos ρ om (T_pure N_cap om))‖))
        (Classical.decPred _)
        ⟨N_cap, Finset.sup'_le hJ _ (fun j _ => hFindMin' _ (Or.inl le_rfl)), Or.inl le_rfl⟩
