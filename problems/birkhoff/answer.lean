        (-1 : ℂ) ^ β * ((fun g : ℂ → ℂ => deriv g)^[β] h) (-z) := by
    intro β h z
    induction β generalizing z with
    | zero => simp
    | succ β ih =>
      rw [Function.iterate_succ_apply', Function.iterate_succ_apply']
