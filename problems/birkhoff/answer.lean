    have hIntHolo : DifferentiableOn ℂ (fun z => ∫ t in (0 : ℝ)..1, F t z) (horizStrip σ') :=
      fun z hz => (hStep0.2.2.2 z hz).differentiableAt.differentiableWithinAt
    have hIterAll : ∀ k : ℕ,
        (∀ z ∈ horizStrip σ',
          ContinuousOn (fun t => iteratedDeriv k (F t) z) (Set.Icc (0 : ℝ) 1)) ∧
        (∀ t ∈ Set.Icc (0 : ℝ) 1,
          DifferentiableOn ℂ (iteratedDeriv k (F t)) (horizStrip σ')) ∧
