          Set.Ioo (0 : ℝ) R ×ˢ Set.Ioo (-Real.pi) Real.pi := by
        ext p
        simp only [Set.mem_inter_iff, Set.mem_prod, Set.mem_Ioi, Set.mem_Ioo]
        tauto
