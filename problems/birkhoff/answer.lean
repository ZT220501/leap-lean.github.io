      have h_term : q_raw n j m_idx ξ / δ_q j m_idx ≤ G3 ξ :=
        Finset.single_le_sum (f := fun m' => q_raw n j m' ξ / δ_q j m')
          (fun m' hm' => div_nonneg ((hq_props m' hm').2.1 ξ) (hδ_q_pos j m').le) hm
      have h_lt1 : q_raw n j m_idx ξ / δ_q j m_idx < 1 := by
        dsimp [G_j] at hξ_lt
        linarith [hG1_nn ξ, hG2_nn ξ]
      have hq_lt : q_raw n j m_idx ξ < δ_q j m_idx :=
        (div_lt_one (hδ_q_pos j m_idx)).mp h_lt1
      exact (hq_props m_idx hm).2.2 ξ hq_lt Z hZ
  choose ξ_diag hξ_diag using h_center_each_j
  refine ⟨n_sel, ξ_diag, hn_sel_strict, hn_sel_ge_env, ?_, ?_, ?_⟩
  · intro L hL
    refine ⟨Real.sqrt (A_cone L), Real.sqrt_pos.mpr (hA_cone_pos L), ?_⟩
    intro j hj s h1 h2 h3
    have hL_mem : L ∈ Finset.Icc 2 (j + 2) := Finset.mem_Icc.mpr ⟨hL, by omega⟩
    exact (hξ_diag j).1 L hL_mem s h1 h2 h3
  · intro m_idx hm
    refine ⟨Real.sqrt (B_rect m_idx), Real.sqrt_pos.mpr (hB_rect_pos m_idx), ?_⟩
    intro j hj W hW
    have hm_mem : m_idx ∈ Finset.Icc 1 (j + 1) := Finset.mem_Icc.mpr ⟨hm, by omega⟩
    exact (hξ_diag j).2.1 m_idx hm_mem W hW
  · intro m_idx hm j hj Z hZ
    have hm_mem : m_idx ∈ Finset.Icc 1 (j + 1) := Finset.mem_Icc.mpr ⟨hm, by omega⟩
    exact (hξ_diag j).2.2 m_idx hm_mem Z hZ

theorem halfplane_normal_family_and_quotient_regularity (S : FiniteWallNonisotropicStrip)
    (hBoot : CriticalBootstrapPackage S)
    (L_lim : ℝ → ℝ) (lam P' C_env2 : ℝ) (K_diag ξ_diag : ℕ → ℝ)
    (hlam : 1 ≤ lam)
    (hP' : 1 ≤ P')
    (hC_env2 : 0 < C_env2)
    (hL_cont : Continuous L_lim)
    (hL_zero : L_lim 0 = 0)
    (hL_top : Filter.Tendsto (fun v => L_lim v / v) Filter.atTop (nhds lam))
    (hL_bot : Filter.Tendsto (fun v => L_lim v / v) Filter.atBot (nhds lam))
    (hK_basic : ∀ j : ℕ,
      criticalDepthThreshold S ≤ K_diag j ∧
      (j : ℝ) + 1 ≤ K_diag j ∧
      2 * ((j : ℝ) + 2) * Real.exp (-K_diag j) ≤
        (1 / 4 : ℝ) * Real.exp (-criticalDepthThreshold S) ∧
      (j : ℝ) + 1 ≤ rowMomentFull S (K_diag j))
    (h_mom : TendstoLocallyUniformly
      (fun j v =>
        Real.exp v * (rowMomentFull S (K_diag j + v) / rowMomentFull S (K_diag j)))
      (fun v => Real.exp (L_lim v)) Filter.atTop)
    (h_env : ∀ j : ℕ, ∀ l : ℝ, criticalDepthThreshold S ≤ l →
      rowMomentFull S l ≤
        C_env2 * rowMomentFull S (K_diag j) *
          Real.exp ((3 / 8 : ℝ) * max (K_diag j - l) 0 + P' * max (l - K_diag j) 0))
    (h_cone : ∀ L : ℕ, 2 ≤ L → ∃ C_L : ℝ, 0 < C_L ∧
      ∀ j : ℕ, L ≤ j → ∀ s : ℂ,
        Real.exp (-K_diag j) ≤ wallDepth S s →
        wallDepth S s ≤ (1 / 4 : ℝ) * Real.exp (-criticalDepthThreshold S) →
        |s.re - ξ_diag j| ≤ (L : ℝ) * wallDepth S s →
        (Real.exp (-K_diag j) / rowMomentFull S (K_diag j)) * shapeModulus S s ≤
          C_L * (Real.exp (-K_diag j) / wallDepth S s) ^ (9 / 16 : ℝ))
    (hF_bdd : ∀ m : ℕ, 1 ≤ m → ∃ M_m : ℝ, 0 < M_m ∧
      ∀ j : ℕ, m ≤ j → ∀ W ∈ secondScaleCompactRect (2 * m),
        ‖((Real.exp (-K_diag j) / rowMomentFull S (K_diag j) : ℝ) : ℂ) *
          S.f ((ξ_diag j : ℂ) + (S.H : ℂ) * Complex.I +
            (Real.exp (-K_diag j) : ℂ) * W)‖ ≤ M_m)
    (hQ_vanish : ∀ m : ℕ, 1 ≤ m → ∀ j : ℕ, m ≤ j → ∀ Z ∈ secondScaleCompactRect m,
      ‖((Real.exp (-K_diag j) / rowMomentFull S (K_diag j) : ℝ) : ℂ) ^ 2 *
        S.q ((ξ_diag j : ℂ) + (S.H : ℂ) * Complex.I +
          (Real.exp (-K_diag j) : ℂ) * Z)‖ ≤ 1 / ((j : ℝ) + 1)) :
    Nonempty (SecondScaleFirstFieldData S) :=
by
  let k₀ : ℝ := criticalDepthThreshold S
  let δ_b : ℝ := (1 / 4 : ℝ) * Real.exp (-k₀)
  let U_strip : ℕ → Set ℂ := fun m => { Z : ℂ | -2 * (m : ℝ) < Z.im ∧ Z.im < 0 }
  let φ_diag : ℕ → ℂ → ℂ := fun j Z =>
    (ξ_diag j : ℂ) + (S.H : ℂ) * Complex.I + (Real.exp (-K_diag j) : ℂ) * Z
  let F_diag : ℕ → ℂ → ℂ := fun j Z =>
    ((Real.exp (-K_diag j) / rowMomentFull S (K_diag j) : ℝ) : ℂ) * S.f (φ_diag j Z)
  let Q_diag : ℕ → ℂ → ℂ := fun j Z =>
    ((Real.exp (-K_diag j) / rowMomentFull S (K_diag j) : ℝ) : ℂ) ^ 2 * S.q (φ_diag j Z)
  let q_diag : ℕ → ℂ → ℂ := fun j Z =>
    ((Real.exp (-K_diag j) : ℝ) : ℂ) ^ 2 * S.q (φ_diag j Z)
  
  have hδ_pos : 0 < δ_b := by positivity
  have hδ_80 : δ_b ≤ S.H / 80 := by
    have h_log_le : -Real.log (S.H / 20) ≤ k₀ := le_max_right 1 (-Real.log (S.H / 20))
    have h_exp_le : Real.exp (-k₀) ≤ S.H / 20 := by
      calc Real.exp (-k₀) ≤ Real.exp (Real.log (S.H / 20)) :=
            Real.exp_le_exp.mpr (by linarith)
        _ = S.H / 20 := Real.exp_log (by linarith [S.H_pos])
    dsimp only [δ_b]
    linarith
  have hδ_lt : δ_b < S.H / 2 := by linarith [S.H_pos, hδ_80]
  have isOpen_horiz : IsOpen (horizStrip S.H) :=
    isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const
  have isOpen_H : IsOpen criticalLowerHalfPlane :=
    isOpen_lt Complex.continuous_im continuous_const
  have isOpen_U : ∀ m : ℕ, IsOpen (U_strip m) := fun m =>
    (isOpen_lt continuous_const Complex.continuous_im).inter
      (isOpen_lt Complex.continuous_im continuous_const)
  have h_strip : ∀ m : ℕ, 1 ≤ m → ∀ j : ℕ, m ≤ j →
      DifferentiableOn ℂ (F_diag j) (U_strip m) ∧
      DifferentiableOn ℂ (q_diag j) (U_strip m) ∧
      ∀ Z ∈ U_strip m, deriv (deriv (F_diag j)) Z = q_diag j Z * F_diag j Z := by
    intro m _hm j hj
    have h_maps : Set.MapsTo (φ_diag j) (U_strip m) (horizStrip S.H) := by
      intro W hW
      rcases hW with ⟨hW_lo, hW_hi⟩
      have hd_pos : 0 < Real.exp (-K_diag j) := Real.exp_pos _
      have h_im : (φ_diag j W).im = S.H + Real.exp (-K_diag j) * W.im := by
        simp only [φ_diag, Complex.add_im, Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im,
          Complex.I_re, Complex.I_im, mul_one, mul_zero, zero_mul, zero_add, add_zero]
      have h_upper : (φ_diag j W).im < S.H := by
        rw [h_im]
        nlinarith
      have h_mj : (m : ℝ) ≤ (j : ℝ) := Nat.cast_le.mpr hj
      have h_depth : Real.exp (-K_diag j) * (-W.im) ≤ δ_b := by
        have h1 : Real.exp (-K_diag j) * (-W.im) ≤ 2 * ((j : ℝ) + 2) * Real.exp (-K_diag j) := by
          nlinarith
        exact le_trans h1 (hK_basic j).2.2.1
      have h_lower : -S.H < (φ_diag j W).im := by
        rw [h_im]
        linarith [S.H_pos, hδ_80, h_depth]
      exact abs_lt.mpr ⟨h_lower, h_upper⟩
    have hφ_deriv : ∀ W : ℂ, HasDerivAt (φ_diag j) ((Real.exp (-K_diag j) : ℝ) : ℂ) W := by
      intro W
      simpa [φ_diag, mul_one] using
        (((hasDerivAt_id W).const_mul ((Real.exp (-K_diag j) : ℝ) : ℂ)).const_add
          ((ξ_diag j : ℂ) + (S.H : ℂ) * Complex.I))
    have hφ_diff : Differentiable ℂ (φ_diag j) := fun W => (hφ_deriv W).differentiableAt
    have hF_diff : DifferentiableOn ℂ (F_diag j) (U_strip m) :=
      (S.f_holo.comp hφ_diff.differentiableOn h_maps).const_mul _
    have hq_diff : DifferentiableOn ℂ (q_diag j) (U_strip m) :=
      (S.q_holo.comp hφ_diff.differentiableOn h_maps).const_mul _
    refine ⟨hF_diff, hq_diff, ?_⟩
    let c : ℂ := ((Real.exp (-K_diag j) / rowMomentFull S (K_diag j) : ℝ) : ℂ)
    let d_c : ℂ := ((Real.exp (-K_diag j) : ℝ) : ℂ)
    have h_deriv1 : ∀ W ∈ U_strip m,
        deriv (F_diag j) W = (c * d_c) * deriv S.f (φ_diag j W) := by
      intro W hW
      have hf_at : HasDerivAt S.f (deriv S.f (φ_diag j W)) (φ_diag j W) :=
        (S.f_holo.differentiableAt (isOpen_horiz.mem_nhds (h_maps hW))).hasDerivAt
      have hcomp : HasDerivAt (F_diag j) (c * (deriv S.f (φ_diag j W) * d_c)) W :=
        (hf_at.comp W (hφ_deriv W)).const_mul c
      rw [hcomp.deriv]
      ring
    intro Z hZ
    have h_ev : deriv (F_diag j) =ᶠ[nhds Z] fun W => (c * d_c) * deriv S.f (φ_diag j W) :=
      Filter.eventuallyEq_of_mem ((isOpen_U m).mem_nhds hZ) h_deriv1
    rw [h_ev.deriv_eq]
    have hdf_holo : DifferentiableOn ℂ (deriv S.f) (horizStrip S.H) :=
      S.f_holo.deriv isOpen_horiz
    have hdf_at : HasDerivAt (deriv S.f) (deriv (deriv S.f) (φ_diag j Z)) (φ_diag j Z) :=
      (hdf_holo.differentiableAt (isOpen_horiz.mem_nhds (h_maps hZ))).hasDerivAt
    have hcomp2 : HasDerivAt (fun W => (c * d_c) * deriv S.f (φ_diag j W))
        ((c * d_c) * (deriv (deriv S.f) (φ_diag j Z) * d_c)) Z :=
      (hdf_at.comp Z (hφ_deriv Z)).const_mul (c * d_c)
    rw [hcomp2.deriv, S.deriv2_f (φ_diag j Z) (h_maps hZ)]
    dsimp only [q_diag, F_diag, c, d_c]
    ring
  
  have hK_compact : ∀ m : ℕ, 1 ≤ m → IsCompact (secondScaleCompactRect m) := by
    intro m hm
    have h_closed : IsClosed (secondScaleCompactRect m) :=
      (isClosed_le (continuous_abs.comp Complex.continuous_re) continuous_const).inter
        ((isClosed_le continuous_const Complex.continuous_im).inter
          (isClosed_le Complex.continuous_im continuous_const))
    have h_bdd : Bornology.IsBounded (secondScaleCompactRect m) := by
      rw [Metric.isBounded_iff_subset_closedBall (0 : ℂ)]
      refine ⟨2 * (m : ℝ), fun Z hZ => ?_⟩
      rcases hZ with ⟨h_re, h_im_lo, h_im_hi⟩
      have hm_nonneg : (0 : ℝ) ≤ (m : ℝ) := Nat.cast_nonneg m
      have h_inv_nonneg : (0 : ℝ) ≤ ((m : ℝ))⁻¹ := inv_nonneg.mpr hm_nonneg
      have h_im_abs : |Z.im| ≤ (m : ℝ) := abs_le.mpr ⟨h_im_lo, by linarith⟩
      rw [Metric.mem_closedBall, dist_zero_right]
      linarith [Complex.norm_le_abs_re_add_abs_im Z]
    exact Metric.isCompact_of_isClosed_isBounded h_closed h_bdd
  have hK_convex : ∀ m : ℕ, Convex ℝ (secondScaleCompactRect m) := by
    intro m Z₁ hZ₁ Z₂ hZ₂ a b ha hb hab
    rcases hZ₁ with ⟨h1_re, h1_lo, h1_hi⟩
    rcases hZ₂ with ⟨h2_re, h2_lo, h2_hi⟩
    refine ⟨?_, ?_, ?_⟩
    · simp only [Complex.add_re, Complex.real_smul, Complex.mul_re, Complex.ofReal_re,
        Complex.ofReal_im, zero_mul, sub_zero]
      calc |a * Z₁.re + b * Z₂.re|
          ≤ |a * Z₁.re| + |b * Z₂.re| := abs_add_le _ _
        _ = a * |Z₁.re| + b * |Z₂.re| := by
            rw [abs_mul, abs_mul, abs_of_nonneg ha, abs_of_nonneg hb]
        _ ≤ a * (m : ℝ) + b * (m : ℝ) := by nlinarith
        _ = (m : ℝ) := by nlinarith
    · simp only [Complex.add_im, Complex.real_smul, Complex.mul_im, Complex.ofReal_re,
        Complex.ofReal_im, zero_mul, add_zero]
      nlinarith
    · simp only [Complex.add_im, Complex.real_smul, Complex.mul_im, Complex.ofReal_re,
        Complex.ofReal_im, zero_mul, add_zero]
      nlinarith
  have h_cushion : ∀ m : ℕ, 1 ≤ m → ∀ Z ∈ secondScaleCompactRect m,
      Metric.closedBall Z (1 / (2 * (m : ℝ))) ⊆ secondScaleCompactRect (2 * m) ∧
      Metric.closedBall Z (1 / (2 * (m : ℝ))) ⊆ U_strip m := by
    intro m hm Z hZ
    rcases hZ with ⟨hZ_re, hZ_lo, hZ_hi⟩
    have hm_ge : (1 : ℝ) ≤ (m : ℝ) := Nat.one_le_cast.mpr hm
    have hm_pos : (0 : ℝ) < (m : ℝ) := by linarith
    have hr_le_half : 1 / (2 * (m : ℝ)) ≤ 1 / 2 := by
      rw [div_le_div_iff₀ (by positivity) (by positivity)]
      linarith
    constructor
    · intro W hW
      rw [Metric.mem_closedBall, dist_eq_norm] at hW
      have h_re_diff := abs_le.mp (le_trans (Complex.abs_re_le_norm (W - Z)) hW)
      have h_im_diff := abs_le.mp (le_trans (Complex.abs_im_le_norm (W - Z)) hW)
      have hZ_re_bds := abs_le.mp hZ_re
      simp only [Complex.sub_re] at h_re_diff
      simp only [Complex.sub_im] at h_im_diff
      refine ⟨?_, ?_, ?_⟩
      · rw [Nat.cast_mul, Nat.cast_ofNat]
        exact abs_le.mpr ⟨by linarith, by linarith⟩
      · rw [Nat.cast_mul, Nat.cast_ofNat]
        linarith
      · rw [Nat.cast_mul, Nat.cast_ofNat]
        have h_top : -((m : ℝ)⁻¹) + 1 / (2 * (m : ℝ)) = -((2 * (m : ℝ))⁻¹) := by
          field_simp [hm_pos.ne']
          ring
        linarith
    · intro W hW
      rw [Metric.mem_closedBall, dist_eq_norm] at hW
      have h_im_diff := abs_le.mp (le_trans (Complex.abs_im_le_norm (W - Z)) hW)
      simp only [Complex.sub_im] at h_im_diff
      have h_top : -((m : ℝ)⁻¹) + 1 / (2 * (m : ℝ)) = -((2 * (m : ℝ))⁻¹) := by
        field_simp [hm_pos.ne']
        ring
      have h_inv_pos : (0 : ℝ) < (2 * (m : ℝ))⁻¹ := by positivity
      exact ⟨by linarith, by linarith⟩
  have h_step : ∀ (k : ℕ) (φ : ℕ → ℕ), StrictMono φ →
      ∃ ψ : ℕ → ℕ, StrictMono ψ ∧ ∃ L_m : ℂ → ℂ,
        TendstoUniformlyOn (fun n Z => F_diag (φ (ψ n)) Z) L_m Filter.atTop
          (secondScaleCompactRect (k + 1)) := by
    intro k φ hφ
    let m : ℕ := k + 1
    have hm : 1 ≤ m := Nat.succ_le_succ (Nat.zero_le k)
    have hm_pos : (0 : ℝ) < (m : ℝ) := Nat.cast_pos.mpr (by omega)
    let r_m : ℝ := 1 / (2 * (m : ℝ))
    have hr_pos : 0 < r_m := by positivity
    obtain ⟨M_m, hMm_pos, hMm_bdd⟩ := hF_bdd m hm
    let L_lip : ℝ := 2 * (m : ℝ) * M_m
    have hL_nonneg : 0 ≤ L_lip := by positivity
    have h_lip_ge : ∀ j : ℕ, m ≤ j →
        ∀ Z₁ ∈ secondScaleCompactRect m, ∀ Z₂ ∈ secondScaleCompactRect m,
          ‖F_diag j Z₂ - F_diag j Z₁‖ ≤ L_lip * ‖Z₂ - Z₁‖ := by
      intro j hj Z₁ hZ₁ Z₂ hZ₂
      have hF_diff_j : DifferentiableOn ℂ (F_diag j) (U_strip m) := (h_strip m hm j hj).1
      have hKm_sub_Um : secondScaleCompactRect m ⊆ U_strip m := fun Z hZ =>
        (h_cushion m hm Z hZ).2 (Metric.mem_closedBall_self hr_pos.le)
      have h_diff_at : ∀ Z ∈ secondScaleCompactRect m, DifferentiableAt ℂ (F_diag j) Z :=
        fun Z hZ => hF_diff_j.differentiableAt ((isOpen_U m).mem_nhds (hKm_sub_Um hZ))
      have h_deriv_le : ∀ Z ∈ secondScaleCompactRect m, ‖deriv (F_diag j) Z‖ ≤ L_lip := by
        intro Z hZ
        have h_cush := h_cushion m hm Z hZ
        have h_dc : DiffContOnCl ℂ (F_diag j) (Metric.ball Z r_m) := by
          refine (hF_diff_j.mono ?_).diffContOnCl
          rw [closure_ball Z hr_pos.ne']
          exact h_cush.2
        have h_sph : ∀ W ∈ Metric.sphere Z r_m, ‖F_diag j W‖ ≤ M_m := fun W hW =>
          hMm_bdd j hj W (h_cush.1 (Metric.sphere_subset_closedBall hW))
        have h_est := Complex.norm_deriv_le_of_forall_mem_sphere_norm_le hr_pos h_dc h_sph
        have h_div_eq : M_m / r_m = L_lip := by
          dsimp only [r_m, L_lip]
          field_simp [hm_pos.ne']
        rwa [h_div_eq] at h_est
      exact Convex.norm_image_sub_le_of_norm_deriv_le h_diff_at h_deriv_le (hK_convex m) hZ₁ hZ₂
    have : CompactSpace ↥(secondScaleCompactRect m) :=
      isCompact_iff_compactSpace.mp (hK_compact m hm)
    let G_sub : ℕ → ↥(secondScaleCompactRect m) → ℂ :=
      fun j x => if m ≤ j then F_diag j x.1 else 0
    have hG_lip : ∀ j : ℕ, LipschitzWith L_lip.toNNReal (G_sub j) := by
      intro j
      refine LipschitzWith.of_dist_le' fun x y => ?_
      dsimp only [G_sub]
      split_ifs with hj
      · rw [Subtype.dist_eq, dist_eq_norm, dist_eq_norm]
        exact h_lip_ge j hj y.1 y.2 x.1 x.2
      · rw [dist_self]
        positivity
    have hG_mem : ∀ j : ℕ, ∀ x : ↥(secondScaleCompactRect m),
        G_sub j x ∈ Metric.closedBall (0 : ℂ) M_m := by
      intro j x
      rw [Metric.mem_closedBall, dist_zero_right]
      dsimp only [G_sub]
      split_ifs with hj
      · exact hMm_bdd j hj x.1 ((h_cushion m hm x.1 x.2).1 (Metric.mem_closedBall_self hr_pos.le))
      · rw [norm_zero]
        exact hMm_pos.le
    let g_bcf : ℕ → BoundedContinuousFunction ↥(secondScaleCompactRect m) ℂ :=
      fun j => BoundedContinuousFunction.mkOfCompact ⟨G_sub j, (hG_lip j).continuous⟩
    have hg_coe : ∀ j : ℕ, (g_bcf j : ↥(secondScaleCompactRect m) → ℂ) = G_sub j := by
      intro j
      ext x
      simp [g_bcf]
    let A_set : Set (BoundedContinuousFunction ↥(secondScaleCompactRect m) ℂ) :=
      Set.range (fun n => g_bcf (φ n))
    have hA_comp : IsCompact (closure A_set) := by
      refine BoundedContinuousFunction.arzela_ascoli
        (Metric.closedBall (0 : ℂ) M_m) (isCompact_closedBall (0 : ℂ) M_m) A_set ?_ ?_
      · rintro _ x ⟨n, rfl⟩
        rw [hg_coe]
        exact hG_mem (φ n) x
      · refine (LipschitzWith.uniformEquicontinuous
          (fun a : A_set => (a.1 : ↥(secondScaleCompactRect m) → ℂ)) L_lip.toNNReal ?_).equicontinuous
        rintro ⟨_, ⟨n, rfl⟩⟩
        rw [hg_coe]
        exact hG_lip (φ n)
    obtain ⟨g_lim, _, ψ, hψ, h_tendsto⟩ :=
      hA_comp.tendsto_subseq (fun n => subset_closure (Set.mem_range_self n))
    let L_m : ℂ → ℂ := fun z =>
      @dite _ (z ∈ secondScaleCompactRect m) (Classical.propDecidable _)
        (fun hz => g_lim ⟨z, hz⟩) (fun _ => 0)
    refine ⟨ψ, hψ, L_m, ?_⟩
    have h_unif_sub : TendstoUniformly (fun n => G_sub (φ (ψ n))) (L_m ∘ Subtype.val) Filter.atTop := by
      have h1 := BoundedContinuousFunction.tendsto_iff_tendstoUniformly.mp h_tendsto
      have h_eq1 : (fun n => (g_bcf (φ (ψ n)) : ↥(secondScaleCompactRect m) → ℂ)) =
          fun n => G_sub (φ (ψ n)) := funext fun n => hg_coe (φ (ψ n))
      have h_eq2 : (g_lim : ↥(secondScaleCompactRect m) → ℂ) = L_m ∘ Subtype.val := by
        ext ⟨z, hz⟩
        dsimp only [Function.comp_apply, L_m]
        split_ifs
        rfl
      simpa only [Function.comp_apply, h_eq1, h_eq2] using h1
    have h_unif_G : TendstoUniformlyOn (fun n z => if m ≤ φ (ψ n) then F_diag (φ (ψ n)) z else 0)
        L_m Filter.atTop (secondScaleCompactRect m) :=
      tendstoUniformlyOn_iff_tendstoUniformly_comp_coe.mpr h_unif_sub
    rw [Metric.tendstoUniformlyOn_iff] at h_unif_G ⊢
    intro ε hε
    filter_upwards [h_unif_G ε hε, Filter.eventually_ge_atTop m] with n hn hm_le_n z hz
    have hm_le_idx : m ≤ φ (ψ n) :=
      le_trans hm_le_n (le_trans (hψ.id_le n) (hφ.id_le (ψ n)))
    have h_ite : (if m ≤ φ (ψ n) then F_diag (φ (ψ n)) z else 0) = F_diag (φ (ψ n)) z := by
