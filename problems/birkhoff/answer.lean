      have hh_le : B.h ϑ ≤ B.h θ_max := by
        rw [hh_eq]
        exact hθ_max ⟨hu0, hu_lt.le⟩
      exact ⟨lt_trans B.r₀_pos hlo, by dsimp [M_h]; linarith⟩
    
    let W : Set (ℝ × ℝ) :=
      { z : ℝ × ℝ | -δ < z.1 ∧ z.1 < δ ∧ C_gr.g_col b₂' z.1 < z.2 ∧ z.2 < C_gr.g_col b₁' z.1 }
    have hg_slice_cont : ∀ {b : ℝ}, b ∈ I → Continuous (C_gr.g_col b) := by
      intro b hb
      rw [← continuousOn_univ]
      exact C_gr.g_col_cont.comp (continuous_const.prodMk continuous_id).continuousOn
        (fun θ _ => ⟨hb, trivial⟩)
    have hW_open : IsOpen W := by
      have hW_eq : W = ({ z : ℝ × ℝ | -δ < z.1 } ∩ { z : ℝ × ℝ | z.1 < δ }) ∩
          ({ z : ℝ × ℝ | C_gr.g_col b₂' z.1 < z.2 } ∩
            { z : ℝ × ℝ | z.2 < C_gr.g_col b₁' z.1 }) := by
        ext z; simp [W, and_assoc]
      rw [hW_eq]
      exact ((isOpen_lt continuous_const continuous_fst).inter
        (isOpen_lt continuous_fst continuous_const)).inter
        ((isOpen_lt ((hg_slice_cont hb₂'_I).comp continuous_fst) continuous_snd).inter
          (isOpen_lt continuous_snd ((hg_slice_cont hb₁'_I).comp continuous_fst)))
    have hW_sub : W ⊆ phaseStrip B.h := by
      intro z hz
      obtain ⟨_, _, hz_lo, hz_hi⟩ := hz
      obtain ⟨hb2_lo, _⟩ := C_gr.g_col_bounds b₂' hb₂'_I z.1
      obtain ⟨_, hb1_hi⟩ := C_gr.g_col_bounds b₁' hb₁'_I z.1
      exact ⟨by linarith [B.r₀_pos, B.h_pos (z.1 + Real.pi)], lt_trans hz_hi hb1_hi⟩
    have hW_ne : W.Nonempty := by
      have hg0_lt : C_gr.g_col b₂' 0 < C_gr.g_col b₁' 0 :=
        C_gr.g_col_strictAnti_b b₁' b₂' hb₁'_I.1 hb'_ord.2.1 hb₂'_I.2 0
      refine ⟨(0, (C_gr.g_col b₁' 0 + C_gr.g_col b₂' 0) / 2), ?_⟩
      exact ⟨by linarith, hδ_pos, by linarith, by linarith⟩
    have hW_foliate : ∀ z ∈ W, ∃ b ∈ Set.Icc b₁' b₂', C_gr.g_col b z.1 = z.2 := by
      intro z hz
      obtain ⟨_, _, hz_lo, hz_hi⟩ := hz
      have hg_b_cont : ContinuousOn (fun b : ℝ => C_gr.g_col b z.1) (Set.Icc b₁' b₂') :=
        C_gr.g_col_cont.comp (continuous_id.prodMk continuous_const).continuousOn
          (fun b hb => ⟨⟨lt_of_lt_of_le hb₁'_I.1 hb.1, lt_of_le_of_lt hb.2 hb₂'_I.2⟩, trivial⟩)
      exact intermediate_value_Icc' (le_of_lt hb'_ord.2.1) hg_b_cont ⟨hz_lo.le, hz_hi.le⟩
    
    have h_norm_fp : ∀ b ∈ Set.Icc b₁' b₂', ∃ γ : ℝ, 0 ≤ γ ∧ γ < 2 * Real.pi ∧ G b γ = γ := by
      intro b hb
      have hb_sub : b ∈ Set.Icc b₁ b₂ :=
        ⟨le_trans (le_of_lt hb'_ord.1) hb.1, le_trans hb.2 (le_of_lt hb'_ord.2.2)⟩
      have hb_I : b ∈ I := h_sub_I hb_sub
      obtain ⟨ϑ, hϑ⟩ := h_per_all b hb_sub
      let k : ℤ := Int.floor (ϑ / (2 * Real.pi))
      let γ : ℝ := ϑ - (k : ℝ) * (2 * Real.pi)
      have hγ0 : 0 ≤ γ := by
        have := (le_div_iff₀ h2pi_pos).mp (Int.floor_le (ϑ / (2 * Real.pi)))
        dsimp [γ]; linarith
      have hγ_lt : γ < 2 * Real.pi := by
        have := (div_lt_iff₀ h2pi_pos).mp (Int.lt_floor_add_one (ϑ / (2 * Real.pi)))
        dsimp [γ]; linarith
      have hGγ : G b γ = γ := by
        have h_eq : ϑ = γ + (k : ℝ) * (2 * Real.pi) := by dsimp [γ]; ring
        rw [h_eq, hG_qp_int hb_I k γ] at hϑ
        linarith
      exact ⟨γ, hγ0, hγ_lt, hGγ⟩
    
    have h_1d_trap : ∃ θ_lo θ_hi : ℝ,
        ∀ b ∈ Set.Icc b₁' b₂', ∀ θ ∈ Set.Ioo (-δ) δ,
          (∀ m : ℕ, (G b)^[m] θ ∈ Set.Ioo θ_lo θ_hi) ∧
          (∀ m : ℕ, 1 ≤ m → ¬ (-δ < (G b)^[m] θ ∧ (G b)^[m] θ < δ)) := by
      rcases lt_or_gt_of_ne hG_ne with hG_neg | hG_pos
      · 
        refine ⟨-2 * Real.pi, δ, ?_⟩
        intro b hb θ hθ
        have hb_I : b ∈ I :=
          ⟨lt_of_lt_of_le hb₁'_I.1 hb.1, lt_of_le_of_lt hb.2 hb₂'_I.2⟩
        have hG_lt_neg_δ : ∀ u ∈ Set.Icc (-δ) δ, G b u < -δ := by
          intro u hu
          have h_close := hG_box_close b hb u hu
          have hη_eq : η = -G b_bar 0 / 2 := by dsimp [η]; rw [abs_of_neg hG_neg]
          linarith [abs_lt.mp h_close]
        obtain ⟨γ, hγ0, hγ_lt, hGγ⟩ := h_norm_fp b hb
        have hγ_pos : 0 < γ := by
          rcases eq_or_lt_of_le hγ0 with rfl | hpos
          · exfalso
            have := hG_lt_neg_δ 0 ⟨by linarith, hδ_pos.le⟩
            linarith
          · exact hpos
        let γ' : ℝ := γ - 2 * Real.pi
        have hγ'_gt : -2 * Real.pi < γ' := by dsimp [γ']; linarith
        have hγ'_neg : γ' < 0 := by dsimp [γ']; linarith
        have hGγ' : G b γ' = γ' := by
          have h_eq : γ' = γ + ((-1 : ℤ) : ℝ) * (2 * Real.pi) := by dsimp [γ']; push_cast; ring
          rw [h_eq, hG_qp_int hb_I (-1) γ, hGγ]
        have hγ'_lt_neg_δ : γ' < -δ := by
          rcases lt_or_ge γ' (-δ) with hlt | h_ge
          · exact hlt
          · exfalso
            have := hG_lt_neg_δ γ' ⟨h_ge, by linarith⟩
            linarith
        have h_pos_iter : ∀ k : ℕ, γ' < (G b)^[k + 1] θ ∧ (G b)^[k + 1] θ < -δ := by
          intro k
          induction k with
          | zero =>
            simp only [ zero_add, Function.iterate_one ]
            refine ⟨?_, hG_lt_neg_δ θ ⟨hθ.1.le, hθ.2.le⟩⟩
            rw [← hGγ']
            exact hG_strictMono hb_I (lt_trans hγ'_lt_neg_δ hθ.1)
          | succ k ih =>
            rw [Function.iterate_succ_apply' (G b) (k + 1)]
            refine ⟨?_, ?_⟩
            · rw [← hGγ']
              exact hG_strictMono hb_I ih.1
            · exact lt_trans (hG_strictMono hb_I ih.2)
                (hG_lt_neg_δ (-δ) ⟨le_rfl, by linarith⟩)
        refine ⟨?_, ?_⟩
        · intro m
          rcases m with _ | k
          · simp only [Function.iterate_zero_apply]
            exact ⟨by linarith [hθ.1], hθ.2⟩
          · obtain ⟨h1, h2⟩ := h_pos_iter k
            exact ⟨lt_trans hγ'_gt h1, lt_trans h2 (by linarith)⟩
        · intro m hm h_in
          rcases m with _ | k
          · cases Nat.not_succ_le_zero 0 hm
          · linarith [(h_pos_iter k).2, h_in.1]
      · 
        refine ⟨-δ, 2 * Real.pi, ?_⟩
        intro b hb θ hθ
        have hb_I : b ∈ I :=
          ⟨lt_of_lt_of_le hb₁'_I.1 hb.1, lt_of_le_of_lt hb.2 hb₂'_I.2⟩
        have hG_gt_δ : ∀ u ∈ Set.Icc (-δ) δ, δ < G b u := by
          intro u hu
          have h_close := hG_box_close b hb u hu
          have hη_eq : η = G b_bar 0 / 2 := by dsimp [η]; rw [abs_of_pos hG_pos]
          linarith [abs_lt.mp h_close]
        obtain ⟨γ, hγ0, hγ_lt, hGγ⟩ := h_norm_fp b hb
        have hδ_lt_γ : δ < γ := by
          rcases lt_or_ge δ γ with hlt | h_le
          · exact hlt
          · exfalso
            have := hG_gt_δ γ ⟨by linarith, h_le⟩
            linarith
        have h_pos_iter : ∀ k : ℕ, δ < (G b)^[k + 1] θ ∧ (G b)^[k + 1] θ < γ := by
          intro k
          induction k with
          | zero =>
            simp only [zero_add, Function.iterate_one]
            refine ⟨hG_gt_δ θ ⟨hθ.1.le, hθ.2.le⟩, ?_⟩
            rw [← hGγ]
            exact hG_strictMono hb_I (lt_trans hθ.2 hδ_lt_γ)
          | succ k ih =>
            rw [Function.iterate_succ_apply' (G b) (k + 1)]
            refine ⟨?_, ?_⟩
            · exact lt_trans (hG_gt_δ δ ⟨by linarith, le_rfl⟩)
                (hG_strictMono hb_I ih.1)
            · rw [← hGγ]
              exact hG_strictMono hb_I ih.2
        refine ⟨?_, ?_⟩
        · intro m
          rcases m with _ | k
          · simp only [Function.iterate_zero_apply]
            exact ⟨hθ.1, lt_trans hθ.2 hδ_lt_2pi⟩
          · obtain ⟨h1, h2⟩ := h_pos_iter k
            exact ⟨lt_trans (by linarith) h1, lt_trans h2 hγ_lt⟩
        · intro m hm h_in
          rcases m with _ | k
          · cases Nat.not_succ_le_zero 0 hm
          · linarith [(h_pos_iter k).1, h_in.2]
    obtain ⟨θ_lo, θ_hi, h_trap⟩ := h_1d_trap
    refine h_no_wandering l q W θ_lo θ_hi 0 M_h hW_sub hW_open hW_ne ?_ ?_
    · intro z hz m
      obtain ⟨b, hb, hgb⟩ := hW_foliate z hz
      have hb_I : b ∈ I := ⟨lt_of_lt_of_le hb₁'_I.1 hb.1, lt_of_le_of_lt hb.2 hb₂'_I.2⟩
      have hz_eq : z = (z.1, C_gr.g_col b z.1) := Prod.ext rfl hgb.symm
      rw [hz_eq, hΨ_graph hb_I m z.1]
      exact ⟨(h_trap b hb z.1 ⟨hz.1, hz.2.1⟩).1 m, hg_in_p_box hb_I ((G b)^[m] z.1)⟩
    · intro z hz m hm hz_in
      obtain ⟨b, hb, hgb⟩ := hW_foliate z hz
      have hb_I : b ∈ I := ⟨lt_of_lt_of_le hb₁'_I.1 hb.1, lt_of_le_of_lt hb.2 hb₂'_I.2⟩
      have hz_eq : z = (z.1, C_gr.g_col b z.1) := Prod.ext rfl hgb.symm
      rw [hz_eq, hΨ_graph hb_I m z.1] at hz_in
      exact (h_trap b hb z.1 ⟨hz.1, hz.2.1⟩).2 m hm ⟨hz_in.1, hz_in.2.1⟩
  
  have h_all_per : ∀ {b_star : ℝ}, b_star ∈ I → ∀ (l q : ℕ), 0 < q →
      τ_hat b_star = (l : ℝ) / (q : ℝ) →
      ∀ θ : ℝ, (F_raw b_star)^[q] θ = θ + 2 * Real.pi * (l : ℝ) := by
    intro b_star hb_star l q hq hτ_star
    refine hτ_pinch hb_star l q hq ?_ ?_
    · intro b_lo hb_lo
      have hb_lo_I : b_lo ∈ I := ⟨hb_lo.1, lt_trans hb_lo.2 hb_star.2⟩
      have h_le : τ_hat b_lo ≤ (l : ℝ) / (q : ℝ) := by
        rw [← hτ_star]; exact hτ_mono hb_lo_I hb_star hb_lo.2.le
      exact lt_of_le_of_ne h_le
        (fun h_eq => h_no_plateau l q hq hb_lo.1 hb_lo.2 hb_star.2 h_eq hτ_star)
    · intro b_hi hb_hi
      have hb_hi_I : b_hi ∈ I := ⟨lt_trans hb_star.1 hb_hi.1, hb_hi.2⟩
      have h_ge : (l : ℝ) / (q : ℝ) ≤ τ_hat b_hi := by
        rw [← hτ_star]; exact hτ_mono hb_star hb_hi_I hb_hi.1.le
      exact lt_of_le_of_ne h_ge
        (fun h_eq => h_no_plateau l q hq hb_star.1 hb_hi.1 hb_hi.2 hτ_star h_eq.symm)
  let b₀ : ℝ := C_gr.b_init / 2
  have hb₀_pos : 0 < b₀ := by dsimp [b₀]; linarith [C_gr.b_init_pos]
  have hb₀_lt_init : b₀ < C_gr.b_init := by dsimp [b₀]; linarith [C_gr.b_init_pos]
  have hb₀_I : b₀ ∈ I := ⟨hb₀_pos, hb₀_lt_init⟩
  refine ⟨2 * Real.pi * τ_hat b₀, mul_pos h2pi_pos (hτ_pos hb₀_I), ?_⟩
  intro l q hl hq _hcop h_lt_τ₀
  have hq_pos_real : (0 : ℝ) < (q : ℝ) := Nat.cast_pos.mpr hq
  have hl_pos_real : (0 : ℝ) < (l : ℝ) := Nat.cast_pos.mpr hl
  have h_rat_pos : 0 < (l : ℝ) / (q : ℝ) := div_pos hl_pos_real hq_pos_real
  have h_rat_lt_b₀ : (l : ℝ) / (q : ℝ) < τ_hat b₀ := by
    have h1 := (div_lt_iff₀ hq_pos_real).mp h_lt_τ₀
    exact (div_lt_iff₀ hq_pos_real).mpr (by nlinarith)
  refine ⟨?_, ?_⟩
  · obtain ⟨b₁, hb₁_pos, _, hb₁⟩ := hτ_lim0 ((l : ℝ) / (q : ℝ)) h_rat_pos
    let b_low : ℝ := min (b₁ / 2) (b₀ / 2)
    have hb_low_pos : 0 < b_low := lt_min (by positivity) (by positivity)
    have hb_low_lt_b₀ : b_low < b₀ :=
      lt_of_le_of_lt (min_le_right _ _) (by linarith)
    have hb_low_lt_b₁ : b_low < b₁ :=
      lt_of_le_of_lt (min_le_left _ _) (by linarith)
    have hτ_low_lt : τ_hat b_low < (l : ℝ) / (q : ℝ) := hb₁ b_low ⟨hb_low_pos, hb_low_lt_b₁⟩
    have hτ_cont_sub : ContinuousOn τ_hat (Set.Icc b_low b₀) :=
      hτ_cont.mono (fun b hb => ⟨lt_of_lt_of_le hb_low_pos hb.1,
        lt_of_le_of_lt hb.2 hb₀_lt_init⟩)
    obtain ⟨b_star, hb_star_mem, hb_star_eq⟩ := intermediate_value_Icc
      hb_low_lt_b₀.le hτ_cont_sub ⟨hτ_low_lt.le, h_rat_lt_b₀.le⟩
    have hb_star_ne_b₀ : b_star ≠ b₀ := by
      intro h_eq
      rw [h_eq] at hb_star_eq
      linarith
    have hb_star_Ioo : b_star ∈ Set.Ioo 0 b₀ :=
      ⟨lt_of_lt_of_le hb_low_pos hb_star_mem.1, lt_of_le_of_ne hb_star_mem.2 hb_star_ne_b₀⟩
    exact ⟨b_star, hb_star_Ioo,
      h_all_per ⟨hb_star_Ioo.1, lt_trans hb_star_Ioo.2 hb₀_lt_init⟩ l q hq hb_star_eq⟩
  · intro b hb ⟨θ₀, hθ₀⟩
    have hb_I : b ∈ I := ⟨hb.1, lt_trans hb.2 hb₀_lt_init⟩
    exact h_all_per hb_I l q hq ((hτ_rat_iff hb_I l q hq).mpr ⟨θ₀, hθ₀⟩)

theorem rational_caustic_collar_graphs (Ω : Set Plane)
    (hΩ : IsSmoothPositivelyCurvedBilliardDomain Ω)
    (hCollar : HasContinuousCausticCollar Ω) :
    Nonempty (RationalCollarData Ω) :=
by
  obtain ⟨B⟩ := support_lazutkin_boundary_package Ω hΩ
  obtain ⟨P⟩ := support_phase_billiard_map Ω hΩ B
  obtain ⟨C_gr⟩ := caustic_collar_invariant_graphs Ω hΩ hCollar B P
  obtain ⟨τ₀, hτ₀_pos, hRat⟩ := rational_plateau_exclusion_and_periodicity Ω B P C_gr
  have h2pi_pos : 0 < 2 * Real.pi := by linarith [Real.pi_gt_three]
  have hϕ_mono : StrictMono B.ϕ := strictMono_of_deriv_pos B.ϕ_deriv_pos
  have hϕ_cont : Continuous B.ϕ := B.ϕ_smooth.continuous
  have hϕ_shift_nat : ∀ (n : ℕ) (x : ℝ),
      B.ϕ (x + (n : ℝ) * (2 * Real.pi)) = B.ϕ x + (n : ℝ) * (2 * Real.pi) := by
    intro n
    induction n with
    | zero => intro x; simp
    | succ n ih =>
      intro x
      have heq : x + ((n + 1 : ℕ) : ℝ) * (2 * Real.pi) =
          (x + (n : ℝ) * (2 * Real.pi)) + 2 * Real.pi := by push_cast; ring
      rw [heq, B.ϕ_quasiperiodic, ih x]
      push_cast; ring
  have hϕ_sub_nat : ∀ (n : ℕ) (x : ℝ),
      B.ϕ (x - (n : ℝ) * (2 * Real.pi)) = B.ϕ x - (n : ℝ) * (2 * Real.pi) := by
    intro n x
    have h1 := hϕ_shift_nat n (x - (n : ℝ) * (2 * Real.pi))
    have h2 : (x - (n : ℝ) * (2 * Real.pi)) + (n : ℝ) * (2 * Real.pi) = x := by ring
    rw [h2] at h1
    linarith
  have hϕ_surj : Function.Surjective B.ϕ := by
    intro y
    obtain ⟨N, hN⟩ := exists_nat_gt |y - B.ϕ 0|
    have hpi : 3 < Real.pi := Real.pi_gt_three
    have hN_nonneg : (0 : ℝ) ≤ (N : ℝ) := Nat.cast_nonneg N
    let a : ℝ := -((N : ℝ) * (2 * Real.pi))
    let b : ℝ := (N : ℝ) * (2 * Real.pi)
    have h_le_ab : a ≤ b := by dsimp [a, b]; nlinarith
    have h_low : B.ϕ a ≤ y := by
      have hsub := hϕ_sub_nat N 0
      simp only [zero_sub] at hsub
      have habs := neg_abs_le (y - B.ϕ 0)
      dsimp [a]; nlinarith
    have h_high : y ≤ B.ϕ b := by
      have hadd := hϕ_shift_nat N 0
      simp only [zero_add] at hadd
      have habs := le_abs_self (y - B.ϕ 0)
      dsimp [b]; nlinarith
    obtain ⟨x, _, hx⟩ := intermediate_value_Icc h_le_ab hϕ_cont.continuousOn ⟨h_low, h_high⟩
    exact ⟨x, hx⟩
  let ϕ_iso : ℝ ≃o ℝ := StrictMono.orderIsoOfSurjective B.ϕ hϕ_mono hϕ_surj
  let ϕ_inv : ℝ → ℝ := ϕ_iso.symm
  have hϕ_left_inv : ∀ x : ℝ, ϕ_inv (B.ϕ x) = x := fun x => ϕ_iso.symm_apply_apply x
  have hϕ_right_inv : ∀ θ : ℝ, B.ϕ (ϕ_inv θ) = θ := fun θ => ϕ_iso.apply_symm_apply θ
  have hϕ_inv_mono : StrictMono ϕ_inv := ϕ_iso.symm.strictMono
  have hϕ_inv_cont : Continuous ϕ_inv := ϕ_iso.toHomeomorph.symm.continuous
  have hϕ_inv_qp : ∀ θ : ℝ, ϕ_inv (θ + 2 * Real.pi) = ϕ_inv θ + 2 * Real.pi := by
    intro θ
    apply hϕ_mono.injective
    rw [hϕ_right_inv, B.ϕ_quasiperiodic, hϕ_right_inv]
  have hϕ_inv_shift_nat : ∀ (n : ℕ) (θ : ℝ),
      ϕ_inv (θ + (n : ℝ) * (2 * Real.pi)) = ϕ_inv θ + (n : ℝ) * (2 * Real.pi) := by
    intro n
    induction n with
    | zero => intro θ; simp
    | succ n ih =>
      intro θ
      have heq : θ + ((n + 1 : ℕ) : ℝ) * (2 * Real.pi) =
          (θ + (n : ℝ) * (2 * Real.pi)) + 2 * Real.pi := by push_cast; ring
      rw [heq, hϕ_inv_qp, ih θ]
      push_cast; ring
  have hϕ_inv_shift_int : ∀ (k : ℤ) (θ : ℝ),
      ϕ_inv (θ + (k : ℝ) * (2 * Real.pi)) = ϕ_inv θ + (k : ℝ) * (2 * Real.pi) := by
    intro k θ
    rcases Int.eq_nat_or_neg k with ⟨n, rfl | rfl⟩
    · simpa using hϕ_inv_shift_nat n θ
    · have h1 := hϕ_inv_shift_nat n (θ + ((-(n : ℤ) : ℤ) : ℝ) * (2 * Real.pi))
      have h2 : (θ + ((-(n : ℤ) : ℤ) : ℝ) * (2 * Real.pi)) + (n : ℝ) * (2 * Real.pi) = θ := by
        push_cast; ring
      rw [h2] at h1
      push_cast at h1 ⊢
      linarith
  have hϕ_inv_unif : ∀ ε : ℝ, 0 < ε → ∃ δ_θ : ℝ, 0 < δ_θ ∧
      ∀ θ₁ θ₂ : ℝ, 0 ≤ θ₂ - θ₁ → θ₂ - θ₁ < δ_θ → ϕ_inv θ₂ - ϕ_inv θ₁ < ε := by
    intro ε hε
    have huc : UniformContinuousOn ϕ_inv (Set.Icc (0 : ℝ) (4 * Real.pi)) :=
      isCompact_Icc.uniformContinuousOn_of_continuous hϕ_inv_cont.continuousOn
    rw [Metric.uniformContinuousOn_iff] at huc
    obtain ⟨δ₁, hδ₁_pos, hδ₁⟩ := huc ε hε
    refine ⟨min δ₁ (2 * Real.pi), lt_min hδ₁_pos h2pi_pos, ?_⟩
    intro θ₁ θ₂ h_nonneg h_lt
    let k : ℤ := Int.floor (θ₁ / (2 * Real.pi))
    let a : ℝ := θ₁ - (k : ℝ) * (2 * Real.pi)
    let b : ℝ := θ₂ - (k : ℝ) * (2 * Real.pi)
    have hk_le : (k : ℝ) ≤ θ₁ / (2 * Real.pi) := Int.floor_le (θ₁ / (2 * Real.pi))
    have hk_lt : θ₁ / (2 * Real.pi) < (k : ℝ) + 1 := Int.lt_floor_add_one (θ₁ / (2 * Real.pi))
    have ha0 : 0 ≤ a := by
      have := (le_div_iff₀ h2pi_pos).mp hk_le
      dsimp [a]; linarith
    have ha_lt : a < 2 * Real.pi := by
      have := (div_lt_iff₀ h2pi_pos).mp hk_lt
      dsimp [a]; linarith
    have hb0 : 0 ≤ b := by dsimp [a, b] at *; linarith
    have hb_lt : b < 4 * Real.pi := by
      have : θ₂ - θ₁ < 2 * Real.pi := lt_of_lt_of_le h_lt (min_le_right _ _)
      dsimp [a, b] at *; linarith
    have hdist : dist a b < δ₁ := by
      rw [Real.dist_eq, show a - b = -(θ₂ - θ₁) by dsimp [a, b]; ring, abs_neg,
        abs_of_nonneg h_nonneg]
      exact lt_of_lt_of_le h_lt (min_le_left _ _)
    have h_close := hδ₁ a ⟨ha0, by linarith⟩ b ⟨hb0, le_of_lt hb_lt⟩ hdist
    rw [Real.dist_eq] at h_close
    have h_eq₁ : θ₁ = a + (k : ℝ) * (2 * Real.pi) := by dsimp [a]; ring
    have h_eq₂ : θ₂ = b + (k : ℝ) * (2 * Real.pi) := by dsimp [b]; ring
    rw [h_eq₁, h_eq₂, hϕ_inv_shift_int k a, hϕ_inv_shift_int k b]
    linarith [abs_sub_comm (ϕ_inv a) (ϕ_inv b), le_abs_self (ϕ_inv b - ϕ_inv a)]
  let b₀ : ℝ := C_gr.b_init / 2
  have hb₀_pos : 0 < b₀ := by dsimp [b₀]; linarith [C_gr.b_init_pos]
  have hb₀_lt_init : b₀ < C_gr.b_init := by dsimp [b₀]; linarith [C_gr.b_init_pos]
  have hb₀_mem_init : b₀ ∈ Set.Ioo 0 C_gr.b_init := ⟨hb₀_pos, hb₀_lt_init⟩
  have h_sub_init : ∀ {b : ℝ}, b ∈ Set.Ioo 0 b₀ → b ∈ Set.Ioo 0 C_gr.b_init := by
    intro b hb
    exact ⟨hb.1, lt_trans hb.2 hb₀_lt_init⟩
  have hg_mem_strip : ∀ {b : ℝ}, b ∈ Set.Ioo 0 C_gr.b_init → ∀ θ : ℝ,
      (θ, C_gr.g_col b θ) ∈ phaseStrip B.h := by
    intro b hb θ
    obtain ⟨h_lo, h_hi⟩ := C_gr.g_col_bounds b hb θ
    refine ⟨?_, h_hi⟩
    linarith [B.r₀_pos, B.h_pos (θ + Real.pi)]
  let F_raw : ℝ → ℝ → ℝ := fun b θ => P.Theta_plus θ (C_gr.g_col b θ)
  let F_col : ℝ → ℝ → ℝ := fun b x => ϕ_inv (F_raw b (B.ϕ x))
  have hF_raw_cont_init : ContinuousOn (fun q : ℝ × ℝ => F_raw q.1 q.2)
      (Set.Ioo 0 C_gr.b_init ×ˢ Set.univ) := by
    have h_pair : ContinuousOn (fun q : ℝ × ℝ => (q.2, C_gr.g_col q.1 q.2))
        (Set.Ioo 0 C_gr.b_init ×ˢ Set.univ) :=
      continuousOn_snd.prodMk C_gr.g_col_cont
    exact P.Theta_plus_cont.comp h_pair (fun q hq => hg_mem_strip hq.1 q.2)
  have hF_col_cont_init : ContinuousOn (fun p : ℝ × ℝ => F_col p.1 p.2)
      (Set.Ioo 0 C_gr.b_init ×ˢ Set.univ) := by
    have h_arg : Continuous (fun p : ℝ × ℝ => (p.1, B.ϕ p.2)) :=
      continuous_fst.prodMk (hϕ_cont.comp continuous_snd)
    have h_comp : ContinuousOn (fun p : ℝ × ℝ => F_raw p.1 (B.ϕ p.2))
        (Set.Ioo 0 C_gr.b_init ×ˢ Set.univ) :=
      hF_raw_cont_init.comp h_arg.continuousOn (fun p hp => ⟨hp.1, trivial⟩)
    exact hϕ_inv_cont.comp_continuousOn h_comp
  have hF_col_cont : ContinuousOn (fun p : ℝ × ℝ => F_col p.1 p.2)
      (Set.Ioo 0 b₀ ×ˢ Set.univ) :=
    hF_col_cont_init.mono (fun p hp => ⟨h_sub_init hp.1, trivial⟩)
  have hF_raw_qp : ∀ {b : ℝ}, b ∈ Set.Ioo 0 C_gr.b_init → ∀ θ : ℝ,
      F_raw b (θ + 2 * Real.pi) = F_raw b θ + 2 * Real.pi := by
    intro b hb θ
    dsimp [F_raw]
    rw [C_gr.g_col_periodic b hb θ, P.Theta_plus_quasiperiodic θ (C_gr.g_col b θ) (hg_mem_strip hb θ)]
  have hF_col_qp_init : ∀ {b : ℝ}, b ∈ Set.Ioo 0 C_gr.b_init → ∀ x : ℝ,
      F_col b (x + 2 * Real.pi) = F_col b x + 2 * Real.pi := by
    intro b hb x
    dsimp [F_col]
    rw [B.ϕ_quasiperiodic x, hF_raw_qp hb (B.ϕ x), hϕ_inv_qp]
  have hF_col_step_init : ∀ {b : ℝ}, b ∈ Set.Ioo 0 C_gr.b_init → ∀ x : ℝ,
      0 < F_col b x - x ∧ B.ϕ (F_col b x) - B.ϕ x < Real.pi := by
    intro b hb x
    have h_theta_lt : B.ϕ x < F_raw b (B.ϕ x) :=
      (P.Theta_plus_bounds (B.ϕ x) (C_gr.g_col b (B.ϕ x)) (hg_mem_strip hb (B.ϕ x))).1
    have hx_lt : x < F_col b x := by
      have := hϕ_inv_mono h_theta_lt
      rwa [hϕ_left_inv x] at this
    refine ⟨sub_pos.mpr hx_lt, ?_⟩
    dsimp [F_col]
    rw [hϕ_right_inv]
    exact C_gr.F_raw_step_lt_pi b hb (B.ϕ x)
  have hF_col_strictMono_b_init : ∀ b₁ b₂ : ℝ, 0 < b₁ → b₁ < b₂ → b₂ < C_gr.b_init →
      ∀ x : ℝ, F_col b₁ x < F_col b₂ x := by
    intro b₁ b₂ hb₁ hb₁₂ hb₂ x
    have hb₁_mem : b₁ ∈ Set.Ioo 0 C_gr.b_init := ⟨hb₁, lt_trans hb₁₂ hb₂⟩
    have hb₂_mem : b₂ ∈ Set.Ioo 0 C_gr.b_init := ⟨lt_trans hb₁ hb₁₂, hb₂⟩
    have hg_lt := C_gr.g_col_strictAnti_b b₁ b₂ hb₁ hb₁₂ hb₂ (B.ϕ x)
    have hθ_lt := P.Theta_plus_strictAnti_p (B.ϕ x)
      (C_gr.g_col b₂ (B.ϕ x)) (C_gr.g_col b₁ (B.ϕ x))
      (hg_mem_strip hb₂_mem (B.ϕ x)) (hg_mem_strip hb₁_mem (B.ϕ x)) hg_lt
    exact hϕ_inv_mono hθ_lt
  have hF_col_tendsto_zero : ∀ ε : ℝ, 0 < ε → ∃ b₁ : ℝ, 0 < b₁ ∧ b₁ ≤ b₀ ∧
      ∀ b ∈ Set.Ioo 0 b₁, ∀ x : ℝ, F_col b x - x < ε := by
    intro ε hε
    obtain ⟨δ_θ, hδ_θ_pos, hδ_θ⟩ := hϕ_inv_unif ε hε
    obtain ⟨δ_p, hδ_p_pos, hδ_p⟩ := P.Theta_plus_tendsto_zero δ_θ hδ_θ_pos
    obtain ⟨b₁_raw, hb₁_raw_pos, hb₁_raw_le, hb₁_raw⟩ := C_gr.g_col_tendsto_h δ_p hδ_p_pos
    refine ⟨min b₁_raw b₀, lt_min hb₁_raw_pos hb₀_pos, min_le_right _ _, ?_⟩
    intro b hb x
    have hb_raw : b ∈ Set.Ioo 0 b₁_raw := ⟨hb.1, lt_of_lt_of_le hb.2 (min_le_left _ _)⟩
    have hb_init : b ∈ Set.Ioo 0 C_gr.b_init := ⟨hb.1, lt_of_lt_of_le hb_raw.2 hb₁_raw_le⟩
    let θ := B.ϕ x
    have hg_close : B.h θ - C_gr.g_col b θ < δ_p := hb₁_raw b hb_raw θ
    have h_step_lt : F_raw b θ - θ < δ_θ :=
      (hδ_p θ (C_gr.g_col b θ) (hg_mem_strip hb_init θ) hg_close).1
    have h_step_pos : θ < F_raw b θ :=
      (P.Theta_plus_bounds θ (C_gr.g_col b θ) (hg_mem_strip hb_init θ)).1
    have h_x_eq : x = ϕ_inv θ := (hϕ_left_inv x).symm
    have h_res := hδ_θ θ (F_raw b θ) (le_of_lt (sub_pos.mpr h_step_pos)) h_step_lt
    dsimp [F_col, θ] at h_res ⊢
    linarith [hϕ_left_inv x]
  
  let d_b₀ : ℝ → ℝ := fun x => F_col b₀ x - x
  have hd_b₀_cont : Continuous d_b₀ := by
    have h_open : IsOpen (Set.Ioo 0 C_gr.b_init ×ˢ (Set.univ : Set ℝ)) :=
      isOpen_Ioo.prod isOpen_univ
    have h_b₀_x : Continuous (fun x : ℝ => F_col b₀ x) := by
      rw [continuous_iff_continuousAt]
      intro x
      have h_at : ContinuousAt (fun p : ℝ × ℝ => F_col p.1 p.2) (b₀, x) :=
        hF_col_cont_init.continuousAt (h_open.mem_nhds ⟨hb₀_mem_init, trivial⟩)
      exact h_at.comp (continuous_const.prodMk continuous_id).continuousAt
    exact h_b₀_x.sub continuous_id
  have hd_b₀_per : Function.Periodic d_b₀ (2 * Real.pi) := by
    intro x
    dsimp [d_b₀]
    rw [hF_col_qp_init hb₀_mem_init x]
    ring
  obtain ⟨x_min, _, hx_min⟩ := isCompact_Icc.exists_isMinOn
    ⟨0, ⟨le_rfl, le_of_lt h2pi_pos⟩⟩ hd_b₀_cont.continuousOn
  let m₀ : ℝ := d_b₀ x_min
  have hm₀_pos : 0 < m₀ := (hF_col_step_init hb₀_mem_init x_min).1
  have hm₀_le_all : ∀ x : ℝ, m₀ ≤ F_col b₀ x - x := by
    intro x
    let k : ℤ := Int.floor (x / (2 * Real.pi))
    let y : ℝ := x - (k : ℝ) * (2 * Real.pi)
    have hy0 : 0 ≤ y := by
      have := (le_div_iff₀ h2pi_pos).mp (Int.floor_le (x / (2 * Real.pi)))
      dsimp [y]; linarith
    have hy_lt : y < 2 * Real.pi := by
      have := (div_lt_iff₀ h2pi_pos).mp (Int.lt_floor_add_one (x / (2 * Real.pi)))
      dsimp [y]; linarith
    have hper_int : d_b₀ x = d_b₀ y := by
      have hx_eq : x = y + (k : ℝ) * (2 * Real.pi) := by dsimp [y]; ring
      rw [hx_eq]
      simpa [mul_comm] using hd_b₀_per.int_mul k y
    change m₀ ≤ d_b₀ x
    rw [hper_int]
    exact hx_min ⟨hy0, le_of_lt hy_lt⟩
  let δ_col : ℝ := min m₀ (Real.pi / 2)
  have hδ_col_pos : 0 < δ_col := by
    exact lt_min hm₀_pos (by linarith [Real.pi_gt_three])
  have hδ_col_lt_pi : δ_col < Real.pi := by
    exact lt_of_le_of_lt (min_le_right _ _) (by linarith [Real.pi_gt_three])
  have hF_col_iter : ∀ (b : ℝ) (n : ℕ) (x : ℝ),
      (F_col b)^[n] x = ϕ_inv ((F_raw b)^[n] (B.ϕ x)) := by
    intro b n
    induction n with
    | zero =>
      intro x
      simp [hϕ_left_inv x]
    | succ n ih =>
      intro x
      rw [Function.iterate_succ_apply', Function.iterate_succ_apply', ih x]
      dsimp [F_col]
      rw [hϕ_right_inv]
  refine ⟨{
    toSupportLazutkinData := B.toSupportLazutkinData
    b₀ := b₀
    δ_col := δ_col
    τ₀ := τ₀
    b₀_pos := hb₀_pos
    δ_col_pos := hδ_col_pos
    δ_col_lt_pi := hδ_col_lt_pi
    τ₀_pos := hτ₀_pos
    F_col := F_col
    F_col_cont := hF_col_cont
    F_col_quasiperiodic := fun b hb x => hF_col_qp_init (h_sub_init hb) x
    F_col_strictMono_x := fun b hb =>
      hϕ_inv_mono.comp ((C_gr.F_raw_strictMono_θ b (h_sub_init hb)).comp hϕ_mono)
    F_col_strictMono_b := fun b₁ b₂ hb₁ hb₁₂ hb₂ x =>
      hF_col_strictMono_b_init b₁ b₂ hb₁ hb₁₂ (lt_trans hb₂ hb₀_lt_init) x
    F_col_step_bounds := fun b hb x => hF_col_step_init (h_sub_init hb) x
    F_col_tendsto_zero := hF_col_tendsto_zero
    F_col_stationary := ?_
    collar_fills_steps := ?_
    forward_step_unique := P.forward_step_unique
    rational_leaf_all_periodic := ?_
  }⟩
  · 
    intro b hb x
    have hb' : b ∈ Set.Ioo 0 C_gr.b_init := h_sub_init hb
    let θ₀ : ℝ := B.ϕ x
    let θ₁ : ℝ := F_raw b θ₀
    have hθ₁_eq : B.ϕ (F_col b x) = θ₁ := by
      dsimp [F_col, θ₁, θ₀]
      exact hϕ_right_inv _
    have hθ₂_eq : B.ϕ (F_col b (F_col b x)) = F_raw b θ₁ := by
      dsimp [F_col]
      rw [hϕ_right_inv, hθ₁_eq]
    rw [hθ₁_eq, hθ₂_eq]
    have h1 := (P.Theta_plus_eq θ₁ (C_gr.g_col b θ₁) (hg_mem_strip hb' θ₁)).1
    have h2 := C_gr.g_col_invariant b hb' θ₀
    have h3 := (P.Theta_plus_eq θ₀ (C_gr.g_col b θ₀) (hg_mem_strip hb' θ₀)).2
    dsimp [F_raw, θ₁] at h1 h2 h3 ⊢
    linarith
  · 
    intro x₀ x₁ hx_pos hx_lt_δ
    have hx₀_lt_x₁ : x₀ < x₁ := sub_pos.mp hx_pos
    have hx₁_lt_top : x₁ < F_col b₀ x₀ := by
      have hm₀_le := hm₀_le_all x₀
      have hδ_le : δ_col ≤ m₀ := min_le_left _ _
      linarith
    let γ : ℝ → ℝ := fun b => if b ≤ 0 then x₀ else F_col b x₀
    have hγ0 : γ 0 = x₀ := by simp [γ]
    have hγ_b₀ : γ b₀ = F_col b₀ x₀ := by simp [γ, not_le.mpr hb₀_pos]
    have hγ_cont : ContinuousOn γ (Set.Icc 0 b₀) := by
      intro b hb
      rcases eq_or_lt_of_le hb.1 with rfl | hb_pos
      · rw [Metric.continuousWithinAt_iff]
        intro ε hε
        obtain ⟨b₁, hb₁_pos, hb₁_le, hb₁⟩ := hF_col_tendsto_zero ε hε
        refine ⟨b₁, hb₁_pos, ?_⟩
        intro b' hb' hdist
        rcases eq_or_lt_of_le hb'.1 with rfl | hb'_pos
        · simp [hγ0, hε]
        · have hb'_lt_b₁ : b' < b₁ := by
            rw [Real.dist_eq, sub_zero, abs_of_pos hb'_pos] at hdist
            exact hdist
          have hb'_mem : b' ∈ Set.Ioo 0 b₁ := ⟨hb'_pos, hb'_lt_b₁⟩
          have hb'_init : b' ∈ Set.Ioo 0 C_gr.b_init :=
            ⟨hb'_pos, lt_trans (lt_of_lt_of_le hb'_lt_b₁ hb₁_le) hb₀_lt_init⟩
          have h_step_pos : 0 < F_col b' x₀ - x₀ := (hF_col_step_init hb'_init x₀).1
          have h_step_lt : F_col b' x₀ - x₀ < ε := hb₁ b' hb'_mem x₀
          have hγ_b' : γ b' = F_col b' x₀ := by simp [γ, not_le.mpr hb'_pos]
          rw [hγ_b', hγ0, Real.dist_eq, abs_of_pos h_step_pos]
          exact h_step_lt
      · have hb_init : b ∈ Set.Ioo 0 C_gr.b_init := ⟨hb_pos, lt_of_le_of_lt hb.2 hb₀_lt_init⟩
        have h_open_prod : IsOpen (Set.Ioo 0 C_gr.b_init ×ˢ (Set.univ : Set ℝ)) :=
          isOpen_Ioo.prod isOpen_univ
        have hF_at : ContinuousAt (fun b' : ℝ => F_col b' x₀) b := by
          have h_at2 : ContinuousAt (fun p : ℝ × ℝ => F_col p.1 p.2) (b, x₀) :=
            hF_col_cont_init.continuousAt (h_open_prod.mem_nhds ⟨hb_init, trivial⟩)
          have h_map : Continuous (fun b' : ℝ => (b', x₀)) :=
            continuous_id.prodMk continuous_const
          exact ContinuousAt.comp (g := fun p : ℝ × ℝ => F_col p.1 p.2)
            (f := fun b' : ℝ => (b', x₀)) h_at2 h_map.continuousAt
        have h_eq : γ =ᶠ[nhds b] (fun b' : ℝ => F_col b' x₀) := by
          filter_upwards [isOpen_Ioo.mem_nhds hb_init] with b' hb'
          simp [γ, not_le.mpr hb'.1]
        exact (hF_at.congr h_eq.symm).continuousWithinAt
    have hx₁_mem : x₁ ∈ Set.Icc (γ 0) (γ b₀) :=
      ⟨by rw [hγ0]; exact le_of_lt hx₀_lt_x₁, by rw [hγ_b₀]; exact le_of_lt hx₁_lt_top⟩
    obtain ⟨b, hb_mem, hb_eq⟩ := intermediate_value_Icc (le_of_lt hb₀_pos) hγ_cont hx₁_mem
    have hb_ne_zero : b ≠ 0 := by
      intro h0
      rw [h0, hγ0] at hb_eq
      linarith
    have hb_ne_b₀ : b ≠ b₀ := by
      intro hb0
      rw [hb0, hγ_b₀] at hb_eq
      linarith
    have hb_pos : 0 < b := lt_of_le_of_ne hb_mem.1 (Ne.symm hb_ne_zero)
    have hb_lt_b₀ : b < b₀ := lt_of_le_of_ne hb_mem.2 hb_ne_b₀
    have hF_b : F_col b x₀ = x₁ := by
      have hγ_b : γ b = F_col b x₀ := by simp [γ, not_le.mpr hb_pos]
      rwa [hγ_b] at hb_eq
    refine ⟨b, ⟨⟨hb_pos, hb_lt_b₀⟩, hF_b⟩, ?_⟩
    rintro b' ⟨hb'_mem, hF_b'⟩
    rcases lt_trichotomy b' b with hlt | rfl | hgt
    · exfalso
      have := hF_col_strictMono_b_init b' b hb'_mem.1 hlt (lt_trans hb_lt_b₀ hb₀_lt_init) x₀
      linarith
    · rfl
    · exfalso
      have := hF_col_strictMono_b_init b b' hb_pos hgt (lt_trans hb'_mem.2 hb₀_lt_init) x₀
      linarith
  · 
    intro l q hl hq hcop hlt
    obtain ⟨⟨b, hb, h_all⟩, h_any⟩ := hRat l q hl hq hcop hlt
    refine ⟨⟨b, hb, ?_⟩, ?_⟩
    · intro x
      rw [hF_col_iter b q x, h_all (B.ϕ x)]
      have h_comm : B.ϕ x + 2 * Real.pi * (l : ℝ) = B.ϕ x + (l : ℝ) * (2 * Real.pi) := by ring
      rw [h_comm, hϕ_inv_shift_nat l (B.ϕ x), hϕ_left_inv x]
      ring
    · intro b' hb' ⟨x₀, hx₀⟩
      have h_θ₀ : (F_raw b')^[q] (B.ϕ x₀) = B.ϕ x₀ + 2 * Real.pi * (l : ℝ) := by
        have h_it := hF_col_iter b' q x₀
        rw [hx₀] at h_it
        have h_ap := congrArg B.ϕ h_it
        rw [hϕ_right_inv] at h_ap
        have h_comm : x₀ + 2 * Real.pi * (l : ℝ) = x₀ + (l : ℝ) * (2 * Real.pi) := by ring
        rw [h_comm, hϕ_shift_nat l x₀] at h_ap
        linarith
      have h_all' := h_any b' hb' ⟨B.ϕ x₀, h_θ₀⟩
      intro x
      rw [hF_col_iter b' q x, h_all' (B.ϕ x)]
      have h_comm : B.ϕ x + 2 * Real.pi * (l : ℝ) = B.ϕ x + (l : ℝ) * (2 * Real.pi) := by ring
      rw [h_comm, hϕ_inv_shift_nat l (B.ϕ x), hϕ_left_inv x]
      ring

theorem table_and_zero_action_vanishing (Ω : Set Plane)
    (R : RationalCollarData Ω) :
    ∃ N_vanish : ℕ, 1 ≤ N_vanish ∧
      (∀ n : ℤ, (N_vanish : ℤ) ≤ |n| →
        globalC_coeff n (fun _ => 0) = 0 ∧
        globalC_coeff n (fun x : ℝ => Real.log (deriv R.ϕ x)) = 0) :=
by
  have h_two_pi_pos : 0 < 2 * Real.pi := by linarith [Real.pi_gt_three]
  
  have h_fourier_const : ∀ (n : ℤ) (w : ℝ → ℝ), n ≠ 0 →
      (HasUniqueGlobalMesh n.natAbs w →
        ∀ x : ℝ, critAction_ℝ n.natAbs w x = critAction_ℝ n.natAbs w 0) →
      globalC_coeff n w = 0 := by
    intro n w hn hconst
    by_cases hMesh : HasUniqueGlobalMesh n.natAbs w
    · have h_eq : (fun x : ℝ =>
          Complex.exp (-Complex.I * (n : ℂ) * (x : ℂ)) * (critAction_ℝ n.natAbs w x : ℂ)) =
          (fun x : ℝ =>
            Complex.exp (-Complex.I * (n : ℂ) * (x : ℂ)) * (critAction_ℝ n.natAbs w 0 : ℂ)) := by
        ext x
        rw [hconst hMesh x]
      simp only [globalC_coeff, hn, hMesh, ↓reduceIte]
      rw [h_eq, intervalIntegral.integral_mul_const]
      set α : ℂ := -Complex.I * (n : ℂ)
      have hα : α ≠ 0 := by simp [α, hn, Complex.I_ne_zero]
