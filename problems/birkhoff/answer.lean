                      PowerSeries.coeff n (pointRecJetSeq A Δ l))) * Z ^ n))) := rfl
        rw [hdef, PowerSeries.coeff_mk, map_sum, map_sum, map_sum, map_sum]
        apply Finset.sum_congr rfl
        intro n hn
        have hn_le : n ≤ N := Nat.lt_succ_iff.mp (Finset.mem_range.mp hn)
        rw [MvPowerSeries.coeff_C_mul, ← Finset.sum_mul,
          ← map_sum (MvPowerSeries.C (R := PowerSeries ℂ)),
