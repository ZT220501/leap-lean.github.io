        ∀ w ∈ Metric.ball ((Y.re : ℂ) - (D_deep : ℂ) * Complex.I) (1 / 4),
          ζ ∈ V_G ∧ T_c ∈ V_G ∧ (ζ, w + G ζ - G T_c) ∈ U) →
      ∃ (V_real : Set ℂ) (Ψ_plus : ℂ → ℂ),
        IsOpen V_real ∧
        { T ∈ Metric.ball (0 : ℂ) ρ_star | T.im = 0 } ⊆ V_real ∧
        DifferentiableOn ℂ Ψ_plus
          (Metric.ball (0 : ℂ) ρ_star ∩ (upperHalfDiskOpen ∪ V_real)) ∧
        (∀ T ∈ Metric.ball (0 : ℂ) ρ_star ∩ upperHalfDiskOpen, (Ψ_plus T).im < 0) ∧
        (∀ T ∈ Metric.ball (0 : ℂ) ρ_star ∩ V_real, (T, Y) ∈ U ∧ Ψ_plus T = Φ (T, Y)) := by
    intro ρ_star D_deep δ₀ Y U Φ V_G G hρ_lt hδ₀ hY_lt_deep hU_open hΦ_holo hΦ_im
      hVG_open hG_holo hBdry_mem hDeep_mem
    obtain ⟨hCauchyF, hCauchyP⟩ := h_s2
    have hOpen_hd : IsOpen upperHalfDiskOpen :=
      (isOpen_lt continuous_norm continuous_const).inter
        (isOpen_lt continuous_const Complex.continuous_im)
    have hCompact_bdry : IsCompact upperHalfDiskBdry := by
      rw [Metric.isCompact_iff_isClosed_bounded]
      refine ⟨?_, ?_⟩
      · exact ((isClosed_eq Complex.continuous_im continuous_const).inter
          (isClosed_le (continuous_abs.comp Complex.continuous_re) continuous_const)).union
          ((isClosed_eq continuous_norm continuous_const).inter
            (isClosed_le continuous_const Complex.continuous_im))
      · refine Metric.isBounded_closedBall (x := (0 : ℂ)) (r := t₀) |>.subset (fun ζ hζ => ?_)
        rw [Metric.mem_closedBall, dist_zero_right]
        rcases hζ with ⟨him, hre⟩ | ⟨hnorm, _⟩
        · have hζ_eq : ζ = (ζ.re : ℂ) := by apply Complex.ext <;> simp [him]
          rw [hζ_eq, Complex.norm_real, Real.norm_eq_abs]
          exact hre
        · exact le_of_eq hnorm
    have hNonempty_bdry : upperHalfDiskBdry.Nonempty :=
      ⟨0, Or.inl ⟨by simp, by simp [ht₀.le]⟩⟩
    have hDisjoint_bdry : ∀ ζ ∈ upperHalfDiskBdry, ∀ T ∈ upperHalfDiskOpen, ζ - T ≠ 0 := by
      intro ζ hζ T hT h0
      have heq : ζ = T := sub_eq_zero.mp h0
      rw [heq] at hζ
      rcases hζ with ⟨him, _⟩ | ⟨hnorm, _⟩ <;> linarith [hT.1, hT.2]
    let γ_seg : ℝ → ℂ := fun y => (Y.re : ℂ) - (y : ℂ) * Complex.I
    let K_seg : Set ℂ := γ_seg '' Set.Icc (-Y.im) D_deep
    have hK_seg_compact : IsCompact K_seg :=
      isCompact_Icc.image (continuous_const.sub (Complex.continuous_ofReal.mul continuous_const))
    let w₀ : ℂ := (Y.re : ℂ) - (D_deep : ℂ) * Complex.I
    let Ω_base : Set (ℂ × (ℂ × ℂ)) := { q | q.1 ∈ V_G ∧ q.2.1 ∈ V_G }
    have hΩ_base_open : IsOpen Ω_base :=
      (hVG_open.preimage continuous_fst).inter
        (hVG_open.preimage (continuous_fst.comp continuous_snd))
    let F_map : ℂ × (ℂ × ℂ) → ℂ × ℂ := fun q => (q.1, q.2.2 + G q.1 - G q.2.1)
    have hF_map_cont : ContinuousOn F_map Ω_base :=
      continuousOn_fst.prodMk
        (((continuous_snd.comp continuous_snd).continuousOn.add
          (hG_holo.continuousOn.comp continuousOn_fst (fun _ hq => hq.1))).sub
          (hG_holo.continuousOn.comp (continuous_fst.comp continuous_snd).continuousOn
