          fun z hz => by
            have h1 := hX_per z hz; dsimp at h1 ⊢
            rw [h1, hW0.2.1 _ (hX_maps z hz)],
          fun z hz => by
            have h1 := hX_conj z hz; dsimp at h1 ⊢
            rw [h1, hW0.2.2.1 _ (hX_maps z hz)]⟩
      have hPart1 : ∀ c ∈ Set.Icc (0 : ℝ) 1,
          let ξ := fun z => (z + (ρ : ℂ) + e_X z) + (c : ℂ) * Y z
