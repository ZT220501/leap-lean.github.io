      (hRN0_holo.mul hRD1_holo).sub ((hRN1_holo.mul hRD0_holo).const_mul Complex.I)
    have hDZW_slice_nz : ∀ z : ℂ, 0 < ‖z‖ → ‖z‖ < δ₀ → D_ZW_raw (z, 0) ≠ 0 := by
      intro z hz_pos hz_lt
      have hpz_pos : 0 < ‖(p + z) - p‖ := by simpa using hz_pos
      have hpz_lt : ‖(p + z) - p‖ < R.δ := by simpa using lt_of_lt_of_le hz_lt hδ₀_R
      exact mul_ne_zero (R.D_slice_ne_zero 0 (p + z) hpz_pos hpz_lt)
        (R.D_slice_ne_zero 1 (p + z) hpz_pos hpz_lt)
    have h_slice_Z_raw : ∀ z : ℂ, 0 < ‖z‖ → ‖z‖ < δ₀ →
        N_Z_raw (z, 0) = Z_raw z * D_ZW_raw (z, 0) := by
      intro z hz_pos hz_lt
      have hpz_pos : 0 < ‖(p + z) - p‖ := by simpa using hz_pos
      have hpz_lt : ‖(p + z) - p‖ < R.δ := by simpa using lt_of_lt_of_le hz_lt hδ₀_R
      dsimp [N_Z_raw, Z_raw, D_ZW_raw]
      rw [R.slice_eq 0 (p + z) hpz_pos hpz_lt, R.slice_eq 1 (p + z) hpz_pos hpz_lt]
      ring
    have h_slice_W_raw : ∀ z : ℂ, 0 < ‖z‖ → ‖z‖ < δ₀ →
        N_W_raw (z, 0) = W_raw z * D_ZW_raw (z, 0) := by
      intro z hz_pos hz_lt
      have hpz_pos : 0 < ‖(p + z) - p‖ := by simpa using hz_pos
      have hpz_lt : ‖(p + z) - p‖ < R.δ := by simpa using lt_of_lt_of_le hz_lt hδ₀_R
      dsimp [N_W_raw, W_raw, D_ZW_raw]
      rw [R.slice_eq 0 (p + z) hpz_pos hpz_lt, R.slice_eq 1 (p + z) hpz_pos hpz_lt]
      ring
    have h_even_Z_raw : ∀ z t : ℂ, ‖z‖ < δ₀ → ‖t‖ < δ₀ →
        N_Z_raw (z, -t) * D_ZW_raw (z, t) = N_Z_raw (z, t) * D_ZW_raw (z, -t) := by
      intro z t hz ht
      have hzR : ‖(p + z) - p‖ < R.δ := by simpa using lt_of_lt_of_le hz hδ₀_R
      have htR : ‖t‖ < R.δ := lt_of_lt_of_le ht hδ₀_R
      have e0 := R.even_eq 0 (p + z) t hzR htR
      have e1 := R.even_eq 1 (p + z) t hzR htR
      dsimp [N_Z_raw, D_ZW_raw]
      linear_combination R.D 1 (p + z, -t) * R.D 1 (p + z, t) * e0 +
        Complex.I * R.D 0 (p + z, -t) * R.D 0 (p + z, t) * e1
    have h_even_W_raw : ∀ z t : ℂ, ‖z‖ < δ₀ → ‖t‖ < δ₀ →
        N_W_raw (z, -t) * D_ZW_raw (z, t) = N_W_raw (z, t) * D_ZW_raw (z, -t) := by
      intro z t hz ht
      have hzR : ‖(p + z) - p‖ < R.δ := by simpa using lt_of_lt_of_le hz hδ₀_R
      have htR : ‖t‖ < R.δ := lt_of_lt_of_le ht hδ₀_R
      have e0 := R.even_eq 0 (p + z) t hzR htR
      have e1 := R.even_eq 1 (p + z) t hzR htR
      dsimp [N_W_raw, D_ZW_raw]
      linear_combination R.D 1 (p + z, -t) * R.D 1 (p + z, t) * e0 -
        Complex.I * R.D 0 (p + z, -t) * R.D 0 (p + z, t) * e1
    let X_R : Fin 2 → ℂ × ℂ → ℂ := fun i w => R.N i w / R.D i w
    have h_local_punc_ball : ∀ z₀ : ℂ, 0 < ‖z₀‖ → ‖z₀‖ < δ₀ →
        ∃ r : ℝ, 0 < r ∧ ∀ z t : ℂ, ‖z - z₀‖ < r → ‖t‖ < r →
          D_ZW_raw (z, t) ≠ 0 ∧
          D_ZW_raw (z - t, t) ≠ 0 ∧
          D_ZW_raw (z + t, t) ≠ 0 ∧
          N_Z_raw (z, t) / D_ZW_raw (z, t) = pairIsoZ X_R (p + z, t) ∧
          N_Z_raw (z - t, t) / D_ZW_raw (z - t, t) = pairIsoZ X_R (p + z - t, t) ∧
          N_Z_raw (z + t, t) / D_ZW_raw (z + t, t) = pairIsoZ X_R (p + z + t, t) ∧
          N_W_raw (z, t) / D_ZW_raw (z, t) = pairIsoW X_R (p + z, t) ∧
          N_W_raw (z - t, t) / D_ZW_raw (z - t, t) = pairIsoW X_R (p + z - t, t) ∧
          N_W_raw (z + t, t) / D_ZW_raw (z + t, t) = pairIsoW X_R (p + z + t, t) ∧
          deriv (fun z' => N_Z_raw (z', t) / D_ZW_raw (z', t)) z *
            deriv (fun t' => N_W_raw (z, t') / D_ZW_raw (z, t')) t =
          deriv (fun t' => N_Z_raw (z, t') / D_ZW_raw (z, t')) t *
            deriv (fun z' => N_W_raw (z', t) / D_ZW_raw (z', t)) z ∧
          (N_Z_raw (z, t) / D_ZW_raw (z, t) - N_Z_raw (z - t, t) / D_ZW_raw (z - t, t)) *
            (N_Z_raw (z + t, t) / D_ZW_raw (z + t, t) - N_Z_raw (z, t) / D_ZW_raw (z, t)) *
            (deriv (fun z' => N_W_raw (z', t) / D_ZW_raw (z', t)) z) ^ 2 =
          (N_W_raw (z, t) / D_ZW_raw (z, t) - N_W_raw (z - t, t) / D_ZW_raw (z - t, t)) *
            (N_W_raw (z + t, t) / D_ZW_raw (z + t, t) - N_W_raw (z, t) / D_ZW_raw (z, t)) *
            (deriv (fun z' => N_Z_raw (z', t) / D_ZW_raw (z', t)) z) ^ 2 := by
      intro z₀ hz₀_pos hz₀_lt
      have hz₀_B₀ : (z₀, (0 : ℂ)) ∈ B₀ :=
        ⟨by rwa [Metric.mem_ball, dist_zero_right], Metric.mem_ball_self hδ₀_pos⟩
      have hc_D : ContinuousAt D_ZW_raw (z₀, 0) :=
        (hDZW_holo.differentiableAt ((isOpen_ball.prod isOpen_ball).mem_nhds hz₀_B₀)).continuousAt
      obtain ⟨r_c, hrc_pos, hrc_nz⟩ := Metric.mem_nhds_iff.mp
        (hc_D.eventually_ne (hDZW_slice_nz z₀ hz₀_pos hz₀_lt))
      let r₁ := min r_c (δ₀ - ‖z₀‖)
      have hr₁_pos : 0 < r₁ := lt_min hrc_pos (sub_pos.mpr hz₀_lt)
      have h_on_r1 : ∀ w t' : ℂ, ‖w - z₀‖ < r₁ → ‖t'‖ < r₁ →
          D_ZW_raw (w, t') ≠ 0 ∧
          (p + w, t') ∈ Metric.ball p R.δ ×ˢ Metric.ball (0 : ℂ) R.δ ∧
          (∀ i : Fin 2, R.D i (p + w, t') ≠ 0) ∧
          N_Z_raw (w, t') / D_ZW_raw (w, t') = pairIsoZ X_R (p + w, t') ∧
          N_W_raw (w, t') / D_ZW_raw (w, t') = pairIsoW X_R (p + w, t') := by
        intro w t' hw ht'
        have h_rc : (w, t') ∈ Metric.ball (z₀, (0 : ℂ)) r_c := by
          rw [Metric.mem_ball, Prod.dist_eq]
          have h_r1_rc : r₁ ≤ r_c := min_le_left r_c (δ₀ - ‖z₀‖)
          have hw' : dist w z₀ < r₁ := by rwa [dist_eq_norm]
          have ht'' : dist t' 0 < r₁ := by rwa [dist_zero_right]
          exact max_lt (lt_of_lt_of_le hw' h_r1_rc) (lt_of_lt_of_le ht'' h_r1_rc)
        have hD_ne : D_ZW_raw (w, t') ≠ 0 := hrc_nz h_rc
        have hD0_ne : R.D 0 (p + w, t') ≠ 0 := left_ne_zero_of_mul hD_ne
        have hD1_ne : R.D 1 (p + w, t') ≠ 0 := right_ne_zero_of_mul hD_ne
        have h_r1_sub : r₁ ≤ δ₀ - ‖z₀‖ := min_le_right r_c (δ₀ - ‖z₀‖)
        have hw_norm : ‖w‖ < δ₀ := by
          have h_tri : ‖w‖ ≤ ‖w - z₀‖ + ‖z₀‖ := by simpa using norm_add_le (w - z₀) z₀
          linarith
        have ht'_norm : ‖t'‖ < δ₀ := by
          linarith [norm_nonneg z₀]
        have h_mem_R : (p + w, t') ∈ Metric.ball p R.δ ×ˢ Metric.ball (0 : ℂ) R.δ :=
          h_sh2_maps (w, t') ⟨by rwa [Metric.mem_ball, dist_zero_right],
            by rwa [Metric.mem_ball, dist_zero_right]⟩
        have hDi : ∀ i : Fin 2, R.D i (p + w, t') ≠ 0 := fun i => by
          fin_cases i <;> [exact hD0_ne; exact hD1_ne]
        have hqZ : N_Z_raw (w, t') / D_ZW_raw (w, t') = pairIsoZ X_R (p + w, t') := by
          dsimp [N_Z_raw, D_ZW_raw, pairIsoZ, X_R]
          field_simp [hD0_ne, hD1_ne]
        have hqW : N_W_raw (w, t') / D_ZW_raw (w, t') = pairIsoW X_R (p + w, t') := by
          dsimp [N_W_raw, D_ZW_raw, pairIsoW, X_R]
          field_simp [hD0_ne, hD1_ne]
        exact ⟨hD_ne, h_mem_R, hDi, hqZ, hqW⟩
      refine ⟨r₁ / 2, half_pos hr₁_pos, fun z t hz ht => ?_⟩
      have hz_r1 : ‖z - z₀‖ < r₁ := by linarith
      have ht_r1 : ‖t‖ < r₁ := by linarith
      have hzm_r1 : ‖(z - t) - z₀‖ < r₁ := by
        have : ‖(z - t) - z₀‖ ≤ ‖z - z₀‖ + ‖t‖ := by
          have h := norm_add_le (z - z₀) (-t)
          simpa [sub_eq_add_neg, add_right_comm] using h
        linarith
      have hzp_r1 : ‖(z + t) - z₀‖ < r₁ := by
        have : ‖(z + t) - z₀‖ ≤ ‖z - z₀‖ + ‖t‖ := by
          have h := norm_add_le (z - z₀) t
          simpa [sub_eq_add_neg, add_right_comm] using h
        linarith
      obtain ⟨hD0, hmem0, hDi0, hqZ0, hqW0⟩ := h_on_r1 z t hz_r1 ht_r1
      obtain ⟨hDm, hmemm, hDim, hqZm, hqWm⟩ := h_on_r1 (z - t) t hzm_r1 ht_r1
      obtain ⟨hDp, hmemp, hDip, hqZp, hqWp⟩ := h_on_r1 (z + t) t hzp_r1 ht_r1
      have h_add_m : p + (z - t) = p + z - t := by ring
      have h_add_p : p + (z + t) = p + z + t := by ring
      rw [h_add_m] at hmemm hDim hqZm hqWm
      rw [h_add_p] at hmemp hDip hqZp hqWp
      have hdZz : deriv (fun z' => N_Z_raw (z', t) / D_ZW_raw (z', t)) z =
          deriv (fun y' => pairIsoZ X_R (y', t)) (p + z) := by
        have hev : (fun z' => N_Z_raw (z', t) / D_ZW_raw (z', t)) =ᶠ[nhds z]
            fun z' => pairIsoZ X_R (p + z', t) := by
          filter_upwards [isOpen_ball.mem_nhds (by rwa [Metric.mem_ball, dist_eq_norm] :
            z ∈ Metric.ball z₀ r₁)] with z' hz'
          exact (h_on_r1 z' t (by simpa [Metric.mem_ball, dist_eq_norm] using hz') ht_r1).2.2.2.1
        rw [hev.deriv_eq, deriv_comp_const_add (fun y' => pairIsoZ X_R (y', t)) p z]
      have hdWz : deriv (fun z' => N_W_raw (z', t) / D_ZW_raw (z', t)) z =
          deriv (fun y' => pairIsoW X_R (y', t)) (p + z) := by
        have hev : (fun z' => N_W_raw (z', t) / D_ZW_raw (z', t)) =ᶠ[nhds z]
            fun z' => pairIsoW X_R (p + z', t) := by
          filter_upwards [isOpen_ball.mem_nhds (by rwa [Metric.mem_ball, dist_eq_norm] :
            z ∈ Metric.ball z₀ r₁)] with z' hz'
          exact (h_on_r1 z' t (by simpa [Metric.mem_ball, dist_eq_norm] using hz') ht_r1).2.2.2.2
        rw [hev.deriv_eq, deriv_comp_const_add (fun y' => pairIsoW X_R (y', t)) p z]
      have hdZt : deriv (fun t' => N_Z_raw (z, t') / D_ZW_raw (z, t')) t =
          deriv (fun t' => pairIsoZ X_R (p + z, t')) t := by
        have hev : (fun t' => N_Z_raw (z, t') / D_ZW_raw (z, t')) =ᶠ[nhds t]
            fun t' => pairIsoZ X_R (p + z, t') := by
          filter_upwards [isOpen_ball.mem_nhds (by rwa [Metric.mem_ball, dist_zero_right] :
            t ∈ Metric.ball (0 : ℂ) r₁)] with t' ht'
          exact (h_on_r1 z t' hz_r1 (by simpa [Metric.mem_ball, dist_zero_right] using ht')).2.2.2.1
        exact hev.deriv_eq
      have hdWt : deriv (fun t' => N_W_raw (z, t') / D_ZW_raw (z, t')) t =
          deriv (fun t' => pairIsoW X_R (p + z, t')) t := by
        have hev : (fun t' => N_W_raw (z, t') / D_ZW_raw (z, t')) =ᶠ[nhds t]
            fun t' => pairIsoW X_R (p + z, t') := by
          filter_upwards [isOpen_ball.mem_nhds (by rwa [Metric.mem_ball, dist_zero_right] :
            t ∈ Metric.ball (0 : ℂ) r₁)] with t' ht'
          exact (h_on_r1 z t' hz_r1 (by simpa [Metric.mem_ball, dist_zero_right] using ht')).2.2.2.2
        exact hev.deriv_eq
      have h_rk := R.rank_one_on_reg (p + z, t) hmem0 hDi0
      have h_rf := R.iso_reflect_on_reg (p + z, t) hmem0 hmemm hmemp
        (fun i => ⟨hDi0 i, hDim i, hDip i⟩)
      dsimp [SatisfiesRankOneAt] at h_rk
      dsimp [SatisfiesIsoReflectAt] at h_rf
      refine ⟨hD0, hDm, hDp, hqZ0, hqZm, hqZp, hqW0, hqWm, hqWp, ?_, ?_⟩
      · rwa [hdZz, hdWt, hdZt, hdWz]
      · rwa [hqZ0, hqZm, hqZp, hqW0, hqWm, hqWp, hdWz, hdZz]
    have h_unflip_Γ : ∀ z : ℂ, Z_raw (-z) = Z_raw z → W_raw (-z) = W_raw z →
        ∀ i : Fin 2, M.Γ_slice (p - z) i = M.Γ_slice (p + z) i := by
      intro z hZ hW i
      have hp_sub : p + -z = p - z := (sub_eq_add_neg p z).symm
      dsimp [Z_raw, W_raw] at hZ hW
      rw [hp_sub] at hZ hW
      fin_cases i
      · change M.Γ_slice (p - z) 0 = M.Γ_slice (p + z) 0
        linear_combination (1 / 2 : ℂ) * hZ + (1 / 2 : ℂ) * hW
      · change M.Γ_slice (p - z) 1 = M.Γ_slice (p + z) 1
        apply mul_left_cancel₀ Complex.I_ne_zero
        linear_combination (1 / 2 : ℂ) * hZ - (1 / 2 : ℂ) * hW
    have hd_neg_fn : ∀ (g : ℂ → ℂ) (w : ℂ), deriv (fun x => -g x) w = -deriv g w :=
      fun _ _ => deriv.neg
    rcases lt_or_gt_of_ne hn with hn_neg | hn_pos
    · have hn_abs : (n.natAbs : ℤ) = -n := Int.ofNat_natAbs_of_nonpos (le_of_lt hn_neg)
      have hn_eq : n = -(n.natAbs : ℤ) := by omega
      let G_neg : LocalPositiveCenterGerm n.natAbs :=
        { c := C.c
          δ₀ := δ₀
          c_pos := C.c_pos
          δ₀_pos := hδ₀_pos
          Z_loc := fun z => -W_raw z
          W_loc := fun z => -Z_raw z
          a_loc := fun z => (a_raw z)⁻¹
          f_loc := fun z => -f_raw z
          u_a := fun z => (u_raw z)⁻¹
          N_Z := fun q => -N_W_raw q
          N_W := fun q => -N_Z_raw q
          D_ZW := D_ZW_raw
          Z_mero := hWraw_mero.neg
          W_mero := hZraw_mero.neg
          u_a_analytic := huraw_ana0.inv huraw_ne0
          u_a_ne_zero := inv_ne_zero huraw_ne0
          a_eq := fun z hz_pos hz_lt => by
            have h_pow : z ^ n = (z ^ n.natAbs)⁻¹ := by
              nth_rw 1 [hn_eq]
              rw [_root_.zpow_neg, zpow_natCast]
            rw [haraw_eq z hz_pos hz_lt, h_pow, mul_inv, inv_inv]
          reg_on_punctured := fun z hz_pos hz_lt => by
            obtain ⟨hZa, hWa, haa, hfa, ha_ne, hf_ne, hdZ, hdW, hda⟩ :=
              h_punc_reg_raw z hz_pos hz_lt
            have hd_Zloc : deriv (fun w => -W_raw w) z =
                Complex.I * (C.c : ℂ) * (a_raw z)⁻¹ / (-f_raw z) ^ 2 := by
              rw [hd_neg_fn, hdW]
              field_simp [ha_ne, hf_ne]
            have hd_Wloc : deriv (fun w => -Z_raw w) z =
                -Complex.I * (C.c : ℂ) / ((a_raw z)⁻¹ * (-f_raw z) ^ 2) := by
              rw [hd_neg_fn, hdZ]
              field_simp [ha_ne, hf_ne]
            have hd_aloc : deriv (fun w => (a_raw w)⁻¹) z =
                Complex.I * (-f_raw z) * (a_raw z)⁻¹ := by
              have hd_inv := (haa.differentiableAt.hasDerivAt.inv ha_ne).deriv
              change deriv (fun w => (a_raw w)⁻¹) z = _ at hd_inv
              rw [hd_inv, hda]
              field_simp [ha_ne]
            exact ⟨hWa.neg, hZa.neg, haa.inv ha_ne, hfa.neg,
              inv_ne_zero ha_ne, neg_ne_zero.mpr hf_ne, hd_Zloc, hd_Wloc, hd_aloc⟩
          N_Z_holo := hNW_holo.neg
          N_W_holo := hNZ_holo.neg
          D_ZW_holo := hDZW_holo
          D_ZW_slice_ne_zero := hDZW_slice_nz
          slice_Z_eq := fun z hz_pos hz_lt => by
            rw [h_slice_W_raw z hz_pos hz_lt]; ring
          slice_W_eq := fun z hz_pos hz_lt => by
            rw [h_slice_Z_raw z hz_pos hz_lt]; ring
          even_Z := fun z t hz ht => by
            linear_combination -(h_even_W_raw z t hz ht)
          even_W := fun z t hz ht => by
            linear_combination -(h_even_Z_raw z t hz ht)
          rank_one_punc := fun z₀ hz₀_pos hz₀_lt => by
            obtain ⟨r, hr_pos, hr_spec⟩ := h_local_punc_ball z₀ hz₀_pos hz₀_lt
            refine ⟨r, hr_pos, fun z t hz ht => ?_⟩
            obtain ⟨hD0, -, -, -, -, -, -, -, -, hrk, -⟩ := hr_spec z t hz ht
            refine ⟨hD0, ?_⟩
            simp only [neg_div, hd_neg_fn]
            linear_combination -hrk
          iso_reflect_punc := fun z₀ hz₀_pos hz₀_lt => by
            obtain ⟨r, hr_pos, hr_spec⟩ := h_local_punc_ball z₀ hz₀_pos hz₀_lt
            refine ⟨r, hr_pos, fun z t hz ht => ?_⟩
            obtain ⟨hD0, hDm, hDp, -, -, -, -, -, -, -, hrf⟩ := hr_spec z t hz ht
            refine ⟨hD0, hDm, hDp, ?_⟩
            simp only [neg_div, hd_neg_fn]
            linear_combination -hrf }
      refine ⟨G_neg, fun ε hε_pos _ h_symm => ⟨ε, hε_pos, fun z hz_pos hz_lt => ?_⟩⟩
      obtain ⟨hZ_ev, hW_ev, ha_odd⟩ := h_symm z hz_pos hz_lt
      dsimp [G_neg] at hZ_ev hW_ev ha_odd
      have hW_raw_ev : W_raw (-z) = W_raw z := neg_inj.mp hZ_ev
      have hZ_raw_ev : Z_raw (-z) = Z_raw z := neg_inj.mp hW_ev
      have ha_raw_odd : M.a_mero (p - z) = -M.a_mero (p + z) := by
        have h_inv : (a_raw (-z))⁻¹ = (-a_raw z)⁻¹ := by rwa [inv_neg]
        have h_eq := inv_inj.mp h_inv
        simpa [a_raw, sub_eq_add_neg] using h_eq
      exact ⟨h_unflip_Γ z hZ_raw_ev hW_raw_ev, ha_raw_odd⟩
    · have hn_abs : (n.natAbs : ℤ) = n := Int.natAbs_of_nonneg (le_of_lt hn_pos)
      let G_pos : LocalPositiveCenterGerm n.natAbs :=
        { c := C.c
          δ₀ := δ₀
          c_pos := C.c_pos
          δ₀_pos := hδ₀_pos
          Z_loc := Z_raw
          W_loc := W_raw
          a_loc := a_raw
          f_loc := f_raw
          u_a := u_raw
          N_Z := N_Z_raw
          N_W := N_W_raw
          D_ZW := D_ZW_raw
          Z_mero := hZraw_mero
          W_mero := hWraw_mero
          u_a_analytic := huraw_ana0
          u_a_ne_zero := huraw_ne0
          a_eq := fun z hz_pos hz_lt => by
            have h_pow : z ^ n = z ^ n.natAbs := by
              nth_rw 1 [← hn_abs]
              rw [zpow_natCast]
            rw [haraw_eq z hz_pos hz_lt, h_pow]
          reg_on_punctured := h_punc_reg_raw
          N_Z_holo := hNZ_holo
          N_W_holo := hNW_holo
          D_ZW_holo := hDZW_holo
          D_ZW_slice_ne_zero := hDZW_slice_nz
          slice_Z_eq := h_slice_Z_raw
          slice_W_eq := h_slice_W_raw
          even_Z := h_even_Z_raw
          even_W := h_even_W_raw
          rank_one_punc := fun z₀ hz₀_pos hz₀_lt => by
            obtain ⟨r, hr_pos, hr_spec⟩ := h_local_punc_ball z₀ hz₀_pos hz₀_lt
            exact ⟨r, hr_pos, fun z t hz ht =>
              ⟨(hr_spec z t hz ht).1, (hr_spec z t hz ht).2.2.2.2.2.2.2.2.2.1⟩⟩
          iso_reflect_punc := fun z₀ hz₀_pos hz₀_lt => by
            obtain ⟨r, hr_pos, hr_spec⟩ := h_local_punc_ball z₀ hz₀_pos hz₀_lt
            exact ⟨r, hr_pos, fun z t hz ht => by
              obtain ⟨hD0, hDm, hDp, -, -, -, -, -, -, -, hrf⟩ := hr_spec z t hz ht
              exact ⟨hD0, hDm, hDp, hrf⟩⟩ }
      refine ⟨G_pos, fun ε hε_pos _ h_symm => ⟨ε, hε_pos, fun z hz_pos hz_lt => ?_⟩⟩
      obtain ⟨hZ_ev, hW_ev, ha_odd⟩ := h_symm z hz_pos hz_lt
      dsimp [G_pos] at hZ_ev hW_ev ha_odd
      exact ⟨h_unflip_Γ z hZ_ev hW_ev, by simpa [a_raw, sub_eq_add_neg] using ha_odd⟩
  obtain ⟨hT_open, hT_preconn, hT_even, hTsh_open, hTsh_preconn,
    hBase_open, hBase_ne, hBase_sub_T, hBase_even,
    hHalf_open, hHalf_ne, hHalf_sub_shBase, hSlice_mem⟩ := h_s4
  obtain ⟨hImp_holo, hImp_even, hRank1, hRefl⟩ := h_s2
  refine ⟨{
    real_base := h_s1.real_base
    a_periodic_reg := h_s1.a_periodic_reg
    a_conj_reg := h_s1.a_conj_reg
    order_ne_top := h_s1.order_ne_top
    positive_germ_of_center := fun p hp n u hn hu_ana hu_ne ha_p => by
      obtain ⟨r₀, hr₀_pos, hr₀_sub, hr₀_disc⟩ := M.E_disc_isolated p hp
      have h_slice_punc : ∀ y : ℂ, 0 < ‖y - p‖ → ‖y - p‖ < r₀ →
          ∃ (r_y : ℝ) (X_y : Fin 2 → ℂ × ℂ → ℂ),
            0 < r_y ∧
            Metric.ball (y, (0 : ℂ)) r_y ⊆ meroTubeENNR M.r_base M.h_X ∧
            (∀ i : Fin 2, DifferentiableOn ℂ (X_y i) (Metric.ball (y, (0 : ℂ)) r_y)) ∧
            (∀ i : Fin 2, MeroAgreesHolo (M.X_mero i) (X_y i) (Metric.ball (y, (0 : ℂ)) r_y)) ∧
            (∀ i : Fin 2, X_y i (y, 0) = M.Γ_slice y i) := by
        intro y hy_pos hy_lt
        have hy_ball : y ∈ Metric.ball p r₀ := by rwa [Metric.mem_ball, dist_eq_norm]
        have hy_ne : y ≠ p := sub_ne_zero.mp (norm_pos_iff.mp hy_pos)
        obtain ⟨r_y, X_loc, hry_pos, hry_sub, -, hX_holo, hX_agr, hX_val⟩ :=
          (M.slice_reg y (hr₀_sub hy_ball) (hr₀_disc y hy_ball hy_ne)).2.2.2.2.2.2.2.2.2
        exact ⟨r_y, X_loc, hry_pos, hry_sub, hX_holo, hX_agr,
          fun i => hX_val i y (Metric.mem_ball_self hry_pos)⟩
      obtain ⟨R⟩ := h_s3
        (meroTubeENNR M.r_base M.h_X)
        (collarBaseBox M)
        (collarHalfBaseBox M)
        M.X_mero
        (fun i q => glancingImpact C q.1 q.2 i)
        (fun i s => M.Γ_slice s i)
        p r₀
        hT_open hT_preconn hT_even hTsh_open hTsh_preconn
        hBase_open hBase_ne hBase_sub_T hBase_even
        hHalf_open hHalf_ne hHalf_sub_shBase
        hImp_holo M.X_agrees (fun i q hq => hImp_even i q hq) hRank1 hRefl
        (hSlice_mem p hp) hr₀_pos h_slice_punc
      obtain ⟨G, hG_unflip⟩ := h_s5 p hp n u R hn hu_ana hu_ne ha_p
      refine ⟨G, fun ε hε_pos hε_le h_symm => ?_⟩
      obtain ⟨ε', hε'_pos, h_raw_symm⟩ := hG_unflip ε hε_pos hε_le h_symm
      have hp_im : p.im ≠ 0 := h_s1.center_im_ne_zero p hp n u hn hu_ana hu_ne ha_p
      exact h_s1.wall_top_and_global_odd p hp hp_im ε' hε'_pos h_raw_symm
  }⟩

theorem zero_slice_laurent_and_diff_quotients (n : ℕ) (hn : 1 ≤ n)
    (G : LocalPositiveCenterGerm n) :
    Nonempty (ZeroSliceCenterData G) :=
by
  have isOpen_puncBall : ∀ r : ℝ, IsOpen { w : ℂ | 0 < ‖w‖ ∧ ‖w‖ < r } :=
    fun r => (isOpen_lt continuous_const continuous_norm).inter
      (isOpen_lt continuous_norm continuous_const)
  have analytic_ne_zero_ball :
      ∀ (φ : ℂ → ℂ), AnalyticAt ℂ φ 0 → φ 0 ≠ 0 →
        ∃ r : ℝ, 0 < r ∧ ∀ z : ℂ, ‖z‖ < r → AnalyticAt ℂ φ z ∧ φ z ≠ 0 := by
    intro φ hφ_ana hφ_ne
    obtain ⟨r, hr_pos, hr⟩ := Metric.eventually_nhds_iff_ball.mp
      (hφ_ana.eventually_analyticAt.and (hφ_ana.continuousAt.eventually_ne hφ_ne))
    exact ⟨r, hr_pos, fun z hz => hr z (by simpa [Metric.mem_ball] using hz)⟩
  
  let f_tilde : ℂ → ℂ := fun z => -Complex.I * ((n : ℂ) + z * deriv G.u_a z / G.u_a z)
  let g_plus : ℂ → ℂ := fun z => Complex.I * (G.c : ℂ) * G.u_a z / (f_tilde z) ^ 2
  let g_minus : ℂ → ℂ := fun z => -Complex.I * (G.c : ℂ) / (G.u_a z * (f_tilde z) ^ 2)
  have hf_tilde_zero : f_tilde 0 = -Complex.I * (n : ℂ) := by
    simp [f_tilde]
  have hn_ne : (n : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
  have hc_ne : (G.c : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (ne_of_gt G.c_pos)
  have hf_tilde_0_ne : f_tilde 0 ≠ 0 := by
    rw [hf_tilde_zero]
    exact mul_ne_zero (neg_ne_zero.mpr Complex.I_ne_zero) hn_ne
  have hf_tilde_0_ana : AnalyticAt ℂ f_tilde 0 := by
    have h1 : AnalyticAt ℂ (fun _ : ℂ => -Complex.I) 0 := analyticAt_const
    have h2 : AnalyticAt ℂ (fun _ : ℂ => (n : ℂ)) 0 := analyticAt_const
    have h3 : AnalyticAt ℂ (fun z : ℂ => z * deriv G.u_a z) 0 :=
      analyticAt_id.mul G.u_a_analytic.deriv
    exact h1.mul (h2.add (h3.div G.u_a_analytic G.u_a_ne_zero))
  have hg_plus_0_ana : AnalyticAt ℂ g_plus 0 := by
    have h1 : AnalyticAt ℂ (fun _ : ℂ => Complex.I * (G.c : ℂ)) 0 := analyticAt_const
    exact (h1.mul G.u_a_analytic).div (hf_tilde_0_ana.pow 2) (pow_ne_zero 2 hf_tilde_0_ne)
  have hg_plus_0_ne : g_plus 0 ≠ 0 :=
    div_ne_zero (mul_ne_zero (mul_ne_zero Complex.I_ne_zero hc_ne) G.u_a_ne_zero)
      (pow_ne_zero 2 hf_tilde_0_ne)
  have hg_minus_0_ana : AnalyticAt ℂ g_minus 0 := by
    have h1 : AnalyticAt ℂ (fun _ : ℂ => -Complex.I * (G.c : ℂ)) 0 := analyticAt_const
    exact h1.div (G.u_a_analytic.mul (hf_tilde_0_ana.pow 2))
      (mul_ne_zero G.u_a_ne_zero (pow_ne_zero 2 hf_tilde_0_ne))
  have hg_minus_0_ne : g_minus 0 ≠ 0 :=
    div_ne_zero (mul_ne_zero (neg_ne_zero.mpr Complex.I_ne_zero) hc_ne)
      (mul_ne_zero G.u_a_ne_zero (pow_ne_zero 2 hf_tilde_0_ne))
  obtain ⟨r_ua, hr_ua_pos, hr_ua⟩ := analytic_ne_zero_ball G.u_a G.u_a_analytic G.u_a_ne_zero
  obtain ⟨r_ft, hr_ft_pos, hr_ft⟩ := analytic_ne_zero_ball f_tilde hf_tilde_0_ana hf_tilde_0_ne
  obtain ⟨r_gp, hr_gp_pos, hr_gp⟩ := analytic_ne_zero_ball g_plus hg_plus_0_ana hg_plus_0_ne
  obtain ⟨r_gm, hr_gm_pos, hr_gm⟩ := analytic_ne_zero_ball g_minus hg_minus_0_ana hg_minus_0_ne
  let δ_a : ℝ := min G.δ₀ (min (min r_ua r_ft) (min r_gp r_gm))
  have hδ_a_pos : 0 < δ_a :=
    lt_min G.δ₀_pos (lt_min (lt_min hr_ua_pos hr_ft_pos) (lt_min hr_gp_pos hr_gm_pos))
  have hδ_a_le : δ_a ≤ G.δ₀ := min_le_left _ _
  have hu_a_ball_a : ∀ z : ℂ, ‖z‖ < δ_a → AnalyticAt ℂ G.u_a z ∧ G.u_a z ≠ 0 :=
    fun z hz => hr_ua z (lt_of_lt_of_le hz (le_trans (min_le_right _ _)
      (le_trans (min_le_left _ _) (min_le_left _ _))))
  have hf_tilde_ball_a : ∀ z : ℂ, ‖z‖ < δ_a → AnalyticAt ℂ f_tilde z ∧ f_tilde z ≠ 0 :=
    fun z hz => hr_ft z (lt_of_lt_of_le hz (le_trans (min_le_right _ _)
      (le_trans (min_le_left _ _) (min_le_right _ _))))
  have hg_plus_ball_a : ∀ z : ℂ, ‖z‖ < δ_a → AnalyticAt ℂ g_plus z ∧ g_plus z ≠ 0 :=
    fun z hz => hr_gp z (lt_of_lt_of_le hz (le_trans (min_le_right _ _)
      (le_trans (min_le_right _ _) (min_le_left _ _))))
  have hg_minus_ball_a : ∀ z : ℂ, ‖z‖ < δ_a → AnalyticAt ℂ g_minus z ∧ g_minus z ≠ 0 :=
    fun z hz => hr_gm z (lt_of_lt_of_le hz (le_trans (min_le_right _ _)
      (le_trans (min_le_right _ _) (min_le_right _ _))))
  have hf_exp_a : ∀ z : ℂ, 0 < ‖z‖ → ‖z‖ < δ_a → G.f_loc z = z⁻¹ * f_tilde z := by
    intro z hz_pos hz_lt
    have hz_ne : z ≠ 0 := norm_pos_iff.mp hz_pos
    have hz_δ₀ : ‖z‖ < G.δ₀ := lt_of_lt_of_le hz_lt hδ_a_le
    have hu_z := hu_a_ball_a z hz_lt
    have hu_ne : G.u_a z ≠ 0 := hu_z.2
    have h_eq_nhds : G.a_loc =ᶠ[nhds z] fun w => w ^ n * G.u_a w :=
      Filter.eventuallyEq_of_mem ((isOpen_puncBall δ_a).mem_nhds ⟨hz_pos, hz_lt⟩)
        (fun w hw => G.a_eq w hw.1 (lt_of_lt_of_le hw.2 hδ_a_le))
    have h_deriv_prod :
        deriv G.a_loc z = (n : ℂ) * z ^ (n - 1) * G.u_a z + z ^ n * deriv G.u_a z := by
      rw [h_eq_nhds.deriv_eq]
      exact ((hasDerivAt_pow n z).mul hu_z.1.differentiableAt.hasDerivAt).deriv
    have h_da :
        Complex.I * G.f_loc z * (z ^ n * G.u_a z) =
          (n : ℂ) * z ^ (n - 1) * G.u_a z + z ^ n * deriv G.u_a z := by
      rw [← G.a_eq z hz_pos hz_δ₀, ← (G.reg_on_punctured z hz_pos hz_δ₀).2.2.2.2.2.2.2.2,
        h_deriv_prod]
    have hzn : z * z ^ (n - 1) = z ^ n := by
      rw [mul_comm, ← pow_succ, Nat.sub_add_cancel hn]
    have h_mul_z :
        (Complex.I * (z * G.f_loc z) * G.u_a z) * z ^ n =
          ((n : ℂ) * G.u_a z + z * deriv G.u_a z) * z ^ n := by
      calc
        (Complex.I * (z * G.f_loc z) * G.u_a z) * z ^ n
            = z * (Complex.I * G.f_loc z * (z ^ n * G.u_a z)) := by ring
        _ = z * ((n : ℂ) * z ^ (n - 1) * G.u_a z + z ^ n * deriv G.u_a z) := by rw [h_da]
        _ = (n : ℂ) * (z * z ^ (n - 1)) * G.u_a z + (z * deriv G.u_a z) * z ^ n := by ring
        _ = ((n : ℂ) * G.u_a z + z * deriv G.u_a z) * z ^ n := by rw [hzn]; ring
    have h_canc : Complex.I * (z * G.f_loc z) * G.u_a z = (n : ℂ) * G.u_a z + z * deriv G.u_a z :=
      mul_right_cancel₀ (pow_ne_zero n hz_ne) h_mul_z
    have h_zf : z * G.f_loc z * G.u_a z = f_tilde z * G.u_a z := by
      dsimp [f_tilde]
      have h_div : ((n : ℂ) + z * deriv G.u_a z / G.u_a z) * G.u_a z =
          (n : ℂ) * G.u_a z + z * deriv G.u_a z := by
        rw [add_mul, div_mul_cancel₀ _ hu_ne]
      calc
        z * G.f_loc z * G.u_a z
            = -Complex.I * (Complex.I * (z * G.f_loc z) * G.u_a z) := by
                rw [show -Complex.I * (Complex.I * (z * G.f_loc z) * G.u_a z) =
                  -(Complex.I * Complex.I) * (z * G.f_loc z * G.u_a z) by ring,
                  Complex.I_mul_I]
                ring
        _ = -Complex.I * ((n : ℂ) * G.u_a z + z * deriv G.u_a z) := by rw [h_canc]
        _ = -Complex.I * (((n : ℂ) + z * deriv G.u_a z / G.u_a z) * G.u_a z) := by rw [h_div]
        _ = -Complex.I * ((n : ℂ) + z * deriv G.u_a z / G.u_a z) * G.u_a z := by ring
    have h_zf' : z * G.f_loc z = f_tilde z := mul_right_cancel₀ hu_ne h_zf
    calc
      G.f_loc z = z⁻¹ * (z * G.f_loc z) := by rw [inv_mul_cancel_left₀ hz_ne]
      _ = z⁻¹ * f_tilde z := by rw [h_zf']
  have hZ_deriv_a : ∀ z : ℂ, 0 < ‖z‖ → ‖z‖ < δ_a →
      deriv G.Z_loc z = z ^ ((n : ℤ) + 2) * g_plus z := by
    intro z hz_pos hz_lt
    have hz_ne : z ≠ 0 := norm_pos_iff.mp hz_pos
    have hz_δ₀ : ‖z‖ < G.δ₀ := lt_of_lt_of_le hz_lt hδ_a_le
    have hf_ne : f_tilde z ≠ 0 := (hf_tilde_ball_a z hz_lt).2
    rw [(G.reg_on_punctured z hz_pos hz_δ₀).2.2.2.2.2.2.1,
      G.a_eq z hz_pos hz_δ₀, hf_exp_a z hz_pos hz_lt,
      show (n : ℤ) + 2 = ((n + 2 : ℕ) : ℤ) by omega, zpow_natCast, pow_add]
    dsimp [g_plus]
    field_simp [hz_ne, hf_ne]
  have hW_deriv_a : ∀ z : ℂ, 0 < ‖z‖ → ‖z‖ < δ_a →
      deriv G.W_loc z = z ^ ((2 : ℤ) - (n : ℤ)) * g_minus z := by
    intro z hz_pos hz_lt
    have hz_ne : z ≠ 0 := norm_pos_iff.mp hz_pos
    have hz_δ₀ : ‖z‖ < G.δ₀ := lt_of_lt_of_le hz_lt hδ_a_le
    have hu_ne : G.u_a z ≠ 0 := (hu_a_ball_a z hz_lt).2
    have hf_ne : f_tilde z ≠ 0 := (hf_tilde_ball_a z hz_lt).2
    rw [(G.reg_on_punctured z hz_pos hz_δ₀).2.2.2.2.2.2.2.1,
      G.a_eq z hz_pos hz_δ₀, hf_exp_a z hz_pos hz_lt,
      zpow_sub₀ hz_ne, show (2 : ℤ) = ((2 : ℕ) : ℤ) by rfl, zpow_natCast, zpow_natCast]
    dsimp [g_minus]
    field_simp [hz_ne, pow_ne_zero n hz_ne, hu_ne, hf_ne]
  
  have mero_prim_helper :
      ∀ (F : ℂ → ℂ) (d : ℤ) (g : ℂ → ℂ),
        MeromorphicAt F 0 →
        (∀ z : ℂ, ‖z‖ < δ_a → AnalyticAt ℂ g z ∧ g z ≠ 0) →
        (∀ z : ℂ, 0 < ‖z‖ → ‖z‖ < δ_a → deriv F z = z ^ d * g z) →
        d ≠ -1 ∧ ∃ (F₀ : ℂ) (u_F : ℂ → ℂ) (r_F : ℝ),
          0 < r_F ∧ r_F ≤ δ_a ∧
          (∀ z : ℂ, ‖z‖ < r_F → AnalyticAt ℂ u_F z ∧ u_F z ≠ 0) ∧
          (∀ z : ℂ, 0 < ‖z‖ → ‖z‖ < r_F → F z - F₀ = z ^ (d + 1) * u_F z) := by
    intro F d g hF hg_ball hderiv
    have hg0 := hg_ball 0 (by simpa using hδ_a_pos)
    have h_dF_eq_punc : deriv F =ᶠ[nhdsWithin 0 {0}ᶜ] fun z => (z - 0) ^ d • g z := by
      rw [eventuallyEq_nhdsWithin_iff]
      filter_upwards [Metric.ball_mem_nhds (0 : ℂ) hδ_a_pos] with z hz hz_ne
      have hz_pos : 0 < ‖z‖ := norm_pos_iff.mpr hz_ne
      have hz_lt : ‖z‖ < δ_a := by simpa [Metric.mem_ball] using hz
      simpa [smul_eq_mul] using hderiv z hz_pos hz_lt
    have h_ord_dF : meromorphicOrderAt (deriv F) 0 = (d : WithTop ℤ) :=
      (meromorphicOrderAt_eq_int_iff hF.deriv).mpr ⟨g, hg0.1, hg0.2, h_dF_eq_punc⟩
    cases h_ord_F : meromorphicOrderAt F 0 with
    | top =>
      have h_ev0 : F =ᶠ[nhdsWithin 0 {0}ᶜ] 0 := meromorphicOrderAt_eq_top_iff.mp h_ord_F
      obtain ⟨r₀, hr₀_pos, hr₀⟩ :=
        Metric.eventually_nhds_iff_ball.mp (eventually_nhdsWithin_iff.mp h_ev0)
      let ρ : ℝ := min r₀ δ_a
      have hρ_pos : 0 < ρ := lt_min hr₀_pos hδ_a_pos
      let z_s : ℂ := ((ρ / 2 : ℝ) : ℂ)
      have hz_s_norm : ‖z_s‖ = ρ / 2 := by
        simp [z_s, Complex.norm_real, le_of_lt hρ_pos]
      have hz_s_pos : 0 < ‖z_s‖ := by rw [hz_s_norm]; linarith
      have hz_s_lt_ρ : ‖z_s‖ < ρ := by rw [hz_s_norm]; linarith
      have hz_s_lt_a : ‖z_s‖ < δ_a := lt_of_lt_of_le hz_s_lt_ρ (min_le_right _ _)
      have hF_nhds : F =ᶠ[nhds z_s] fun _ : ℂ => 0 := by
        refine Filter.eventuallyEq_of_mem ((isOpen_puncBall ρ).mem_nhds ⟨hz_s_pos, hz_s_lt_ρ⟩) ?_
        intro w hw
        exact hr₀ w (by simpa [Metric.mem_ball] using lt_of_lt_of_le hw.2 (min_le_left _ _))
          (norm_pos_iff.mp hw.1)
      have hdF_zero : deriv F z_s = 0 := by
        rw [hF_nhds.deriv_eq, deriv_const]
      have hdF_ne : deriv F z_s ≠ 0 := by
        rw [hderiv z_s hz_s_pos hz_s_lt_a]
        exact mul_ne_zero (zpow_ne_zero d (norm_pos_iff.mp hz_s_pos))
          (hg_ball z_s hz_s_lt_a).2
      exact absurd hdF_zero hdF_ne
    | coe m =>
      obtain ⟨h, hh_ana, hh_ne, hh_eq⟩ := (meromorphicOrderAt_eq_int_iff hF).mp h_ord_F
      obtain ⟨r_h, hr_h_pos, hr_h⟩ := analytic_ne_zero_ball h hh_ana hh_ne
      obtain ⟨r_eq, hr_eq_pos, hr_eq⟩ :=
        Metric.eventually_nhds_iff_ball.mp (eventually_nhdsWithin_iff.mp hh_eq)
      let r₁ : ℝ := min δ_a (min r_h r_eq)
      have hr₁_pos : 0 < r₁ := lt_min hδ_a_pos (lt_min hr_h_pos hr_eq_pos)
      have hr₁_le : r₁ ≤ δ_a := min_le_left _ _
      have hh_ball₁ : ∀ z : ℂ, ‖z‖ < r₁ → AnalyticAt ℂ h z ∧ h z ≠ 0 :=
        fun z hz => hr_h z (lt_of_lt_of_le hz (le_trans (min_le_right _ _) (min_le_left _ _)))
      have hF_eq₁ : ∀ z : ℂ, 0 < ‖z‖ → ‖z‖ < r₁ → F z = z ^ m * h z := by
        intro z hz_pos hz_lt
        have hz_eq := hr_eq z
          (by simpa [Metric.mem_ball] using
            lt_of_lt_of_le hz_lt (le_trans (min_le_right _ _) (min_le_right _ _)))
          (norm_pos_iff.mp hz_pos)
        simpa [smul_eq_mul] using hz_eq
      by_cases hm : m < 0
      · let h_tilde : ℂ → ℂ := fun z => (m : ℂ) * h z + z * deriv h z
        have hh_tilde_ana : AnalyticAt ℂ h_tilde 0 :=
          (analyticAt_const.mul hh_ana).add (analyticAt_id.mul hh_ana.deriv)
        have hh_tilde_ne : h_tilde 0 ≠ 0 := by
          dsimp [h_tilde]
          simp only [zero_mul, add_zero]
          exact mul_ne_zero (Int.cast_ne_zero.mpr (by omega)) hh_ne
        have hdF_eq_m : deriv F =ᶠ[nhdsWithin 0 {0}ᶜ] fun z => (z - 0) ^ (m - 1) • h_tilde z := by
          rw [eventuallyEq_nhdsWithin_iff]
          filter_upwards [Metric.ball_mem_nhds (0 : ℂ) hr₁_pos] with z hz hz_ne
