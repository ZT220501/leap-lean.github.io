      IsOpen U_A → DifferentiableOn ℂ A U_A → (∀ q ∈ Ω_dom, q.2 ∈ U_A) →
      (∀ i : Fin 2, DifferentiableOn ℂ (g₀ i) B_base ∧ DifferentiableOn ℂ (g₁ i) B_base) →
      (∀ i : Fin 2, MeroAgreesHolo (E₀ i) (g₀ i) B_base ∧ MeroAgreesHolo (E₁ i) (g₁ i) B_base) →
      SsbpcMeroJetClearedProp B_base E₀ E₁ g₀ g₁ A := by
    intro Ω_dom B_base U_A A E₀ E₁ g₀ g₁
      hΩ_open hΩ_conv hB_open hB_ne hB_sub hUA_open hA_holo hA_maps hg_holo h_agrees
    have h_ci_rad_le : ∀ (p : ℂ × ℂ) (ci : Fin 2 × Fin 2),
        ssbpcPairChartRad E₀ E₁ p ≤
          (if ci.1 = 0 then (E₀ ci.2).rad p else (E₁ ci.2).rad p) := by
      intro p ⟨c, i⟩
      fin_cases c <;> fin_cases i
      · exact le_trans (min_le_left _ _) (min_le_left _ _)
      · exact le_trans (min_le_left _ _) (min_le_right _ _)
      · exact le_trans (min_le_right _ _) (min_le_left _ _)
      · exact le_trans (min_le_right _ _) (min_le_right _ _)
    have h_rad_pos : ∀ p ∈ Ω_dom, 0 < ssbpcPairChartRad E₀ E₁ p ∧
        Metric.ball p (ssbpcPairChartRad E₀ E₁ p) ⊆ Ω_dom := by
      intro p hp
      refine ⟨lt_min (lt_min ((E₀ 0).rad_pos p hp) ((E₀ 1).rad_pos p hp))
        (lt_min ((E₁ 0).rad_pos p hp) ((E₁ 1).rad_pos p hp)), ?_⟩
      exact Set.Subset.trans
        (Metric.ball_subset_ball (le_trans (min_le_left _ _) (min_le_left _ _)))
