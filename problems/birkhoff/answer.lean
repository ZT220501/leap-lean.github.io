        have hG := G.compat p₁ hp₁ p₂ hp₂ q
          ⟨Metric.ball_subset_ball (min_le_right _ _) hq.1,
           Metric.ball_subset_ball (min_le_right _ _) hq.2⟩
        linear_combination G.den p₁ q * G.den p₂ q * hF + F.den p₁ q * F.den p₂ q * hG
    }, fun U f g hAF hAG => ⟨hAF.1, fun p hp => by
      obtain ⟨r₁, hr₁_pos, hr₁_le, hr₁_sub, hr₁_eq⟩ := hAF.2 p hp
      obtain ⟨r₂, hr₂_pos, hr₂_le, _, hr₂_eq⟩ := hAG.2 p hp
      refine ⟨min r₁ r₂, lt_min hr₁_pos hr₂_pos, min_le_min hr₁_le hr₂_le,
        Set.Subset.trans (Metric.ball_subset_ball (min_le_left _ _)) hr₁_sub, fun q hq => ?_⟩
      dsimp only
      rw [hr₁_eq q (Metric.ball_subset_ball (min_le_left _ _) hq),
          hr₂_eq q (Metric.ball_subset_ball (min_le_right _ _) hq)]
      ring⟩⟩
  have h_sub : ∀ {W' : Set (ℂ × ℂ)} (F G : MeroOn2D W'),
