    have h_union_sub : (⋃ m ∈ (Finset.univ : Finset (Fin N)), A n ∩ I_m m) ⊆
        Set.Icc (-1 : ℝ) 1 := by
      intro u hu
      obtain ⟨m, _, _, hm⟩ := Set.mem_iUnion₂.mp hu
      exact ⟨le_trans (h_am_ge m) hm.1, le_trans hm.2 (h_bm_le m)⟩
    have h_union_fin : MeasureTheory.volume
        (⋃ m ∈ (Finset.univ : Finset (Fin N)), A n ∩ I_m m) ≠ ⊤ :=
      ne_top_of_le_ne_top (by rw [Real.volume_Icc]; exact ENNReal.ofReal_ne_top)
        (MeasureTheory.measure_mono h_union_sub)
    have h_sub_union : A n ∩ Set.Icc (-1 : ℝ) 1 ⊆
        ⋃ m ∈ (Finset.univ : Finset (Fin N)), A n ∩ I_m m := by
      intro u ⟨huA, huI⟩
      obtain ⟨m, _, hm⟩ := Set.mem_iUnion₂.mp (h_cover huI)
      exact Set.mem_iUnion₂.mpr ⟨m, Finset.mem_univ m, huA, hm⟩
    have h_tot_le : MeasureTheory.volume.real (A n ∩ Set.Icc (-1 : ℝ) 1) ≤
        ∑ m ∈ (Finset.univ : Finset (Fin N)), MeasureTheory.volume.real (A n ∩ I_m m) :=
      le_trans (MeasureTheory.measureReal_mono h_sub_union h_union_fin)
        (MeasureTheory.measureReal_biUnion_finset_le Finset.univ (fun m => A n ∩ I_m m))
    have h_split : ∑ m ∈ (Finset.univ : Finset (Fin N)), MeasureTheory.volume.real (A n ∩ I_m m) =
