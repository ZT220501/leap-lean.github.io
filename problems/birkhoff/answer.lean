      | succ i ih => rw [Finset.sum_range_succ, ih]; ring
    have h_sum_δ_lt : ∀ i : ℕ, 20 * ∑ r ∈ Finset.range i, δ r < d₀ / 10 := by
      intro i
      have hpow_pos : (0 : ℝ) < (1 / 2 : ℝ) ^ i := by positivity
