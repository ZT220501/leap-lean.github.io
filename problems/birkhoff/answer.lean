          exact (hg₁_holo.differentiableAt hD_nhds).hasDerivAt
        convert hg₁_d.mul hg₁_d using 1
        · ext w; simp [sq]
        · ring
      have hD_ne : (g₁ s₀) ^ 2 ≠ 0 := pow_ne_zero 2 hg₁_ne_s₀
      have hdiv : HasDerivAt (fun w => Complex.cos (K.ϕ w - ϕ₀) / (g₁ w) ^ 2) 0 s₀ := by
        convert hN.div hD hD_ne using 1
        ring
      exact (hdiv.sub_const (α⁻¹ ^ 2)).deriv
    obtain ⟨h_u, hh_u_holo, hh_u_eq⟩ := hdslope2 q_u hq_u_holo hq_u_zero hq_u_deriv
    have hcos_fac : ∀ w : ℂ,
        Complex.cos (K.ϕ w - ϕ₀) / (g₁ w) ^ 2 = α⁻¹ ^ 2 + (w - s₀) ^ 2 * h_u w := by
      intro w
      have h1 := hh_u_eq w
      dsimp [q_u] at h1
      linear_combination h1
    let B_punc : Set ℂ := B \ {s₀}
    have hBp_open : IsOpen B_punc := Metric.isOpen_ball.sdiff isClosed_singleton
    have hBp_preconn : IsPreconnected B_punc := by
      let U_pos : Set ℂ := B ∩ (⇑Complex.reCLM.toLinearMap ⁻¹' Set.Ioi s₀.re)
      let U_neg : Set ℂ := B ∩ (⇑Complex.reCLM.toLinearMap ⁻¹' Set.Iio s₀.re)
      let V_pos : Set ℂ := B ∩ (⇑Complex.imCLM.toLinearMap ⁻¹' Set.Ioi s₀.im)
      let V_neg : Set ℂ := B ∩ (⇑Complex.imCLM.toLinearMap ⁻¹' Set.Iio s₀.im)
      have hU_pos : IsPreconnected U_pos :=
        ((convex_ball s₀ ρ).inter
          ((convex_Ioi s₀.re).linear_preimage Complex.reCLM.toLinearMap)).isPreconnected
      have hU_neg : IsPreconnected U_neg :=
        ((convex_ball s₀ ρ).inter
          ((convex_Iio s₀.re).linear_preimage Complex.reCLM.toLinearMap)).isPreconnected
      have hV_pos : IsPreconnected V_pos :=
        ((convex_ball s₀ ρ).inter
          ((convex_Ioi s₀.im).linear_preimage Complex.imCLM.toLinearMap)).isPreconnected
      have hV_neg : IsPreconnected V_neg :=
        ((convex_ball s₀ ρ).inter
          ((convex_Iio s₀.im).linear_preimage Complex.imCLM.toLinearMap)).isPreconnected
      let δ : ℝ := ρ / 3
      have hδ : 0 < δ := by positivity
      have hnorm_δ : ∀ s₁ s₂ : ℂ, ‖s₁‖ ≤ 1 → ‖s₂‖ ≤ 1 →
          s₀ + (δ : ℂ) * s₁ + (δ : ℂ) * s₂ ∈ B := by
        intro s₁ s₂ hs₁ hs₂
        rw [Metric.mem_ball, dist_eq_norm]
        have heq : s₀ + (δ : ℂ) * s₁ + (δ : ℂ) * s₂ - s₀ = (δ : ℂ) * s₁ + (δ : ℂ) * s₂ := by ring
        rw [heq]
        calc
