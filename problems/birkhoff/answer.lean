    have h2pi_pos : (0 : ℝ) < 2 * Real.pi := by positivity
    have h_disp_mod : ∀ (y t : ℂ), |y.im| < H₃ → ‖t‖ < ρ₀ →
        ∃ x₀ ∈ Set.Icc (0 : ℝ) (2 * Real.pi),
