    obtain ⟨hvA_W₁, hvD_W₁⟩ := hpderiv_holo hW₁_open hv_W₁
    obtain ⟨hΔA_W₁, hΔD_W₁⟩ := hpderiv_holo hW₁_open hΔ_W₁
    let Φ_v : MvPowerSeries (Fin 2) ℂ := taylor2D v (z₀, 0)
