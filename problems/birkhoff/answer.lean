        change deriv (F_Z ∘ fun y' => glancingMidAngle C y' t) y = _
        exact deriv_comp y hFZ_diff hMid_y
      have hZt : deriv (fun t' => pairIsoZ (fun i w => glancingImpact C w.1 w.2 i) (y, t')) t =
