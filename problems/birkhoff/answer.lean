      let B0 := compPowerSeries2D (S_ser i) d0
      let B1 := compPowerSeries2D (C_ser i) d0
      have hRA_vb : lineCoreVanishesBelow (2 * (M - 1)) (A - A0 - A1 * Δψ) :=
