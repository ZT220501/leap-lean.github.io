    intro α
    induction α with
    | zero => intro f q; rfl
    | succ α ih =>
      intro f q
      simp only [iterDerivY, ih]
  have hIter1D_neg : ∀ (β : ℕ) (h : ℂ → ℂ) (z : ℂ),
