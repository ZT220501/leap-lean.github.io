      have hR_pos : 0 < R := by positivity
      have hFy_holo : ∀ y ∈ horizStrip s_mid, DifferentiableOn ℂ (fun τ => F (y, τ)) (Metric.ball 0 R) := by
        intro y hy
        refine hF_holo.comp ((differentiable_const y).prodMk differentiable_id).differentiableOn ?_
        intro τ hτ
        exact (hF_bd y hy τ (by simpa [R] using hτ)).1
