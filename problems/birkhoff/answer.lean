      (|x| ≤ h → min ((y - x) ^ 2) (h ^ 2) / (25 * h) ≤ Φ_tan y - Φ_tan x - D_tan x * (y - x)) := by
    intro x y
    set rx := Real.sqrt (h ^ 2 + x ^ 2)
    set ry := Real.sqrt (h ^ 2 + y ^ 2)
    have hrx_pos : 0 < rx := Real.sqrt_pos.mpr (by positivity)
    have hry_pos : 0 < ry := Real.sqrt_pos.mpr (by positivity)
    have hrx_sq : rx ^ 2 = h ^ 2 + x ^ 2 := Real.sq_sqrt (by positivity)
    have hry_sq : ry ^ 2 = h ^ 2 + y ^ 2 := Real.sq_sqrt (by positivity)
    have hx_le_rx : |x| ≤ rx := by
