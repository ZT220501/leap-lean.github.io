    have hy_im : |y.im| < s - (11 / 2 : ℝ) * δ := hy
    have hy_t_im : |y.im| + |t.im| < s - 5 * δ := by linarith
    let u : ℂ → ℂ := fun z => U (z, t)
    let v : ℂ → ℂ := fun z => v₀ (z, t)
    have hu_holo : DifferentiableOn ℂ u Y5 :=
      slice_fst_holo t hU.1 fun z hz => hY5B4_sub_dom0 ⟨hz, ht⟩
    have hv_holo : DifferentiableOn ℂ v Y5 :=
      slice_fst_holo t hv₀_holo fun z hz => ⟨hz, ht⟩
    have hu_jet : ∀ k : ℕ, k ≤ 2 → ∀ z ∈ Y5,
         ‖iteratedDeriv k (fun z' : ℂ => u z' - z') z‖ ≤ S.η_adm :=
      fun k hk z hz => hU_adm.2.2.2.2 k (by omega) z t (hY5B4_sub_dom0 ⟨hz, ht⟩)
    have huv_eq_on : ∀ z' ∈ Y5, deriv u z' * v z' = Δ₀ z' := by
      intro z' hz'
      have hUp_ne := (hUp_props z' t (hY5B4_sub_dom0 ⟨hz', ht⟩)).2.1
      exact mul_div_cancel₀ (Δ₀ z') hUp_ne
    have huv_jet : ∀ k : ℕ, k ≤ 2 → ∀ z ∈ Y5,
        ‖iteratedDeriv k (fun z' : ℂ => deriv u z' * v z') z‖ ≤ η_slice := by
      intro k hk z hz
      have hev : (fun z' : ℂ => deriv u z' * v z') =ᶠ[nhds z] Δ₀ :=
        Filter.eventually_of_mem ((isOpen_horizStrip _).mem_nhds hz) huv_eq_on
      rw [hev.iteratedDeriv_eq k]
      exact hΔ₀_jet k hk z hz
    have hquad :=
      S.slice_quad_approx (s - 5 * δ) η_slice y t u v
        hs5_pos hs5_le_act ht_d_act hy_t_im hη_slice0 hη_slice_adm
        hu_holo hv_holo hu_jet huv_jet
    have hterm1 : glancingResidualOp B (fun q => u q.1 + deriv u q.1 * v q.1) (y, t) =
        glancingResidualOp B U_pre (y, t) :=
      glancingResidualOp_congr_strip (s - 5 * δ)
        (fun q => u q.1 + deriv u q.1 * v q.1) U_pre y t hy_t_im fun z hz => by
        dsimp [U_pre, glancingPrelimLift]
        rw [huv_eq_on z hz]
    have hterm2 : glancingResidualOp B (fun q => u q.1) (y, t) =
        glancingResidualOp B U (y, t) :=
      glancingResidualOp_slice_eq (fun q => u q.1) U y t (fun _ => rfl)
    have hterm3 : glancingDiffOp
          (fun q => glancingLinCoeff B (fun r => u r.1) (q.1, t) *
            glancingDiffOp (fun r => v r.1) (q.1, t))
          (y, t) = glancingDiffOp g₀ (y, t) :=
      glancingDiffOp_slice_eq _ g₀ y t fun z => by
        have ha_eq : glancingLinCoeff B (fun r => u r.1) (z, t) = glancingLinCoeff B U (z, t) :=
          glancingLinCoeff_slice_eq (fun r => u r.1) U z t (fun _ => rfl)
        dsimp [g₀]
        rw [ha_eq]
        rfl
    let Φ_t : ℂ → ℂ := fun z => glancingResidualOp B U (z, t) * v₀ (z, t)
    have hterm4 : deriv (fun z : ℂ => glancingResidualOp B (fun r => u r.1) (z, t) * v z) y =
        deriv Φ_t y := by
      have hfun : (fun z : ℂ => glancingResidualOp B (fun r => u r.1) (z, t) * v z) = Φ_t :=
        funext fun z => by
          dsimp [Φ_t, v]
          rw [glancingResidualOp_slice_eq (fun r => u r.1) U z t (fun _ => rfl)]
      rw [hfun]
    rw [hterm1, hterm2, hterm3, hterm4] at hquad
    have hΦ_holo : DifferentiableOn ℂ Φ_t Y5 :=
      (slice_fst_holo t hE_U_holo fun z hz => hY5B4_sub_dom1 ⟨hz, ht⟩).mul hv_holo
    have hcl_sub_Y5 : Metric.closedBall y (δ / 4) ⊆ Y5 := by
      intro z hz
      rw [Metric.mem_closedBall, dist_eq_norm] at hz
      have him_diff : |(z - y).im| ≤ δ / 4 := le_trans (Complex.abs_im_le_norm _) hz
      have htri : |z.im| ≤ |y.im| + |(z - y).im| := by
        have heq : z.im = y.im + (z - y).im := by simp
        rw [heq]
        exact abs_add_le _ _
      change |z.im| < s - 5 * δ
      linarith
    have hΦ_deriv_raw : ‖deriv Φ_t y‖ ≤ ((4 / 3 : ℝ) * ε * η_slice) / (δ / 4) :=
      Complex.norm_deriv_le_of_forall_mem_sphere_norm_le hδ4_pos
        (hΦ_holo.diffContOnCl_ball hcl_sub_Y5) fun z hz => by
          have hz_Y5 : z ∈ Y5 := hcl_sub_Y5 (Metric.sphere_subset_closedBall hz)
          dsimp [Φ_t]
          rw [norm_mul]
          calc
            ‖glancingResidualOp B U (z, t)‖ * ‖v₀ (z, t)‖
                ≤ ε * ((4 / 3 : ℝ) * η_slice) :=
              mul_le_mul (hRes (z, t) (hY5B4_sub_dom1 ⟨hz_Y5, ht⟩))
                (hv₀_per_bnd z hz_Y5 t ht).2 (norm_nonneg _) (le_of_lt hε0)
            _ = (4 / 3 : ℝ) * ε * η_slice := by ring
    have hQ2_η_nonneg : 0 ≤ Q ^ 2 * η_slice := by positivity
    have hΦ_deriv_bnd : ‖deriv Φ_t y‖ ≤ 6 * Q ^ 2 * η_slice := by
      have hsimp : ((4 / 3 : ℝ) * ε * η_slice) / (δ / 4) =
          (16 / 3 : ℝ) * (δ⁻¹ * ε * η_slice) := by
        field_simp [ne_of_gt hδ0]
        ring
      rw [hsimp] at hΦ_deriv_raw
      have hQ_le_sq : Q ≤ Q ^ 2 := by nlinarith
      have hδ_le_sq : δ⁻¹ ≤ Q ^ 2 := le_trans hδ_inv_le_Q hQ_le_sq
      have hε_le : δ⁻¹ * ε ≤ δ⁻¹ * 1 :=
        mul_le_mul_of_nonneg_left (le_of_lt hε1) (le_of_lt hδ_inv_pos)
      have hprod : δ⁻¹ * ε * η_slice ≤ Q ^ 2 * η_slice :=
        mul_le_mul_of_nonneg_right (by linarith) hη_slice0
      linarith
    have hE_U_bnd : ‖glancingResidualOp B U (y, t)‖ ≤ ε :=
      hRes (y, t) (hY5B4_sub_dom1 ⟨hY21_4_sub_Y5 (hY11_2_sub_Y21_4 hy), ht⟩)
    have hdg_bnd := hdg₀_bnd y hy t ht
    let Rem := glancingResidualOp B U_pre (y, t) - glancingResidualOp B U (y, t) -
      (glancingDiffOp g₀ (y, t) + deriv Φ_t y)
    have hdecomp : glancingResidualOp B U_pre (y, t) =
        ((Rem + glancingResidualOp B U (y, t)) + glancingDiffOp g₀ (y, t)) + deriv Φ_t y := by
      dsimp [Rem]
      ring
    have htri_all : ‖glancingResidualOp B U_pre (y, t)‖ ≤
        ‖Rem‖ + ‖glancingResidualOp B U (y, t)‖ + ‖glancingDiffOp g₀ (y, t)‖ + ‖deriv Φ_t y‖ := by
      rw [hdecomp]
      have h1 :=
        norm_add_le ((Rem + glancingResidualOp B U (y, t)) + glancingDiffOp g₀ (y, t))
          (deriv Φ_t y)
      have h2 := norm_add_le (Rem + glancingResidualOp B U (y, t)) (glancingDiffOp g₀ (y, t))
      have h3 := norm_add_le Rem (glancingResidualOp B U (y, t))
      linarith
    have hquad_Q : S.C_quad * η_slice ^ 2 ≤ S.C_quad * (Q ^ 2 * η_slice) :=
      mul_le_mul_of_nonneg_left hη_slice_sq_le (le_of_lt hC_quad_pos)
    have hε_Q : ε ≤ C_pre * Q ^ 2 * ε := by
      have h1 : (1 : ℝ) ≤ C_pre * Q ^ 2 := by nlinarith
      nlinarith
    have hslice_Q : (113 + S.C_quad) * (Q ^ 2 * η_slice) ≤ C_pre * Q ^ 2 * η_slice := by
      dsimp [C_pre]
      nlinarith
    have htot_eq : C_pre * Q ^ 2 * ε + C_pre * Q ^ 2 * η_slice = C_pre * Q ^ 2 * η_tot := by
      change C_pre * Q ^ 2 * ε + C_pre * Q ^ 2 * η_slice = C_pre * Q ^ 2 * (ε + η_slice)
      ring
    change ‖Rem‖ ≤ S.C_quad * η_slice ^ 2 at hquad
    linarith

  
  let E_dot : ℂ → ℂ := fun y => deriv (fun t : ℂ => glancingResidualOp B U_pre (y, t)) (t₀ : ℂ)
  let M_dot : ℝ := 8 * C_pre * Q ^ 3 * η_tot
  have hM_dot_nonneg : 0 ≤ M_dot := by positivity

  have hE_dot_holo : DifferentiableOn ℂ E_dot Y6 :=
    partial_t_slice_holo (t₀ : ℂ) ((isOpen_horizStrip _).prod Metric.isOpen_ball)
      hE_pre_holo fun y hy => ⟨hY6_sub_Y11_2 hy, ht₀_mem_B4⟩

  have hE_dot_bnd : ∀ y ∈ Y6, ‖E_dot y‖ ≤ M_dot := by
    intro y hy
    have hy11_2 : y ∈ Y11_2 := hY6_sub_Y11_2 hy
    have hfy_holo : DifferentiableOn ℂ (fun t : ℂ => glancingResidualOp B U_pre (y, t)) B4 :=
      slice_snd_holo y hE_pre_holo fun t ht => ⟨hy11_2, ht⟩
    have hcl_sub_B4 : Metric.closedBall (t₀ : ℂ) (δ / 8) ⊆ B4 :=
      Metric.closedBall_subset_ball (by linarith)
    have hraw : ‖E_dot y‖ ≤ (C_pre * Q ^ 2 * η_tot) / (δ / 8) :=
      Complex.norm_deriv_le_of_forall_mem_sphere_norm_le (by positivity)
        (hfy_holo.diffContOnCl_ball hcl_sub_B4) fun t ht =>
          hE_pre_bnd y hy11_2 t (hcl_sub_B4 (Metric.sphere_subset_closedBall ht))
    have hsimp : (C_pre * Q ^ 2 * η_tot) / (δ / 8) =
        8 * δ⁻¹ * (C_pre * Q ^ 2 * η_tot) := by
      field_simp [ne_of_gt hδ0]
    rw [hsimp] at hraw
    have hle_Q : 8 * δ⁻¹ * (C_pre * Q ^ 2 * η_tot) ≤ 8 * Q * (C_pre * Q ^ 2 * η_tot) :=
      mul_le_mul_of_nonneg_right (by linarith) (by positivity)
    calc
      ‖E_dot y‖ ≤ 8 * Q * (C_pre * Q ^ 2 * η_tot) := le_trans hraw hle_Q
      _ = M_dot := by dsimp [M_dot]; ring

  
  have hE_pre_zero : ∀ z ∈ Y5, glancingResidualOp B U_pre (z, (t₀ : ℂ)) = 0 := by
    intro z hz
    rw [glancingResidualOp_slice_eq U_pre (fun p => U_star p.1) z (t₀ : ℂ) hU_pre_slice_pt]
    exact hU_star_res z hz

  let U_dot : ℂ → ℂ := fun w => deriv (fun t : ℂ => U (w, t)) (t₀ : ℂ)
  let z₀ : ℂ → ℂ := fun w => U_dot w / deriv U_star w
  let g_init : ℂ → ℂ :=
    fun w => a_star w * (glancingDiffOp (fun r => z₀ r.1) (w, (t₀ : ℂ)) + ((t₀ : ℂ))⁻¹)

  have hE_dot_eq : ∀ y ∈ Y6, E_dot y = glancingDiffOp (fun q => g_init q.1) (y, (t₀ : ℂ)) := by
    intro y hy
    have hex :=
      S.exact_jet_deriv t₀ (s - 5 * δ) (s - 6 * δ) (δ / 4) U_pre
        ht₀_pos hδ4_pos ht₀_add_δ4_le hs6_pos (by linarith) hs5_le_act
        hU_pre_holo hU_pre_jet54 hE_pre_zero y hy
    have hz_jet_eq :
        (fun z : ℂ =>
          deriv (fun t : ℂ => U_pre (z, t)) (t₀ : ℂ) /
            deriv (fun z' : ℂ => U_pre (z', (t₀ : ℂ))) z) = z₀ := by
      funext z
      have hdt : deriv (fun t : ℂ => U_pre (z, t)) (t₀ : ℂ) = U_dot z := by
        change deriv (fun t : ℂ => U (z, t) + Δ₀ z) (t₀ : ℂ) = U_dot z
        exact deriv_add_const (Δ₀ z)
      rw [hdt, hU_pre_slice]
    have hz_jet_r :
        (fun r : ℂ × ℂ =>
          deriv (fun t : ℂ => U_pre (r.1, t)) (t₀ : ℂ) /
            deriv (fun z' : ℂ => U_pre (z', (t₀ : ℂ))) r.1) = fun r : ℂ × ℂ => z₀ r.1 :=
      funext fun r => congr_fun hz_jet_eq r.1
    have hg_eq :
        (fun q : ℂ × ℂ =>
          glancingLinCoeff B U_pre (q.1, (t₀ : ℂ)) *
            (glancingDiffOp
              (fun r =>
                deriv (fun t : ℂ => U_pre (r.1, t)) (t₀ : ℂ) /
                  deriv (fun z' : ℂ => U_pre (z', (t₀ : ℂ))) r.1)
              (q.1, (t₀ : ℂ)) + ((t₀ : ℂ))⁻¹)) = fun q : ℂ × ℂ => g_init q.1 := by
      funext q
      dsimp only [g_init]
      rw [← ha_star_eq q.1, hz_jet_r]
    change E_dot y =
      glancingDiffOp
        (fun q =>
          glancingLinCoeff B U_pre (q.1, (t₀ : ℂ)) *
            (glancingDiffOp
              (fun r =>
                deriv (fun t : ℂ => U_pre (r.1, t)) (t₀ : ℂ) /
                  deriv (fun z' : ℂ => U_pre (z', (t₀ : ℂ))) r.1)
              (q.1, (t₀ : ℂ)) + ((t₀ : ℂ))⁻¹))
        (y, (t₀ : ℂ)) at hex
    rw [hg_eq] at hex
    exact hex

  
  have hU_dot_holo : DifferentiableOn ℂ U_dot Y5 :=
    partial_t_slice_holo (t₀ : ℂ) isOpen_glancingDomain0 hU.1
      fun w hw => hY5B4_sub_dom0 ⟨hw, ht₀_mem_B4⟩

  have hU_dot_per : ∀ w ∈ Y5, U_dot (w + 2 * Real.pi) = U_dot w := by
    intro w hw
    have hev : (fun t : ℂ => U (w + 2 * Real.pi, t)) =ᶠ[nhds (t₀ : ℂ)]
        (fun t : ℂ => U (w, t) + 2 * Real.pi) :=
      Filter.eventually_of_mem (Metric.ball_mem_nhds (t₀ : ℂ) hδ4_pos) fun t ht =>
        hU.2.1 w t (hY5B4_sub_dom0 ⟨hw, ht⟩)
    dsimp [U_dot]
    rw [hev.deriv_eq, deriv_add_const]

  have hz₀_holo5 : DifferentiableOn ℂ z₀ Y5 :=
    (hU_dot_holo.mul (hU_star_deriv_holo.inv hU_star_deriv_ne)).congr fun w _ =>
      div_eq_mul_inv (U_dot w) (deriv U_star w)
  have hz₀_holo6 : DifferentiableOn ℂ z₀ Y6 := hz₀_holo5.mono hY6_sub_Y5

  have hz₀_per5 : ∀ w ∈ Y5, z₀ (w + 2 * Real.pi) = z₀ w := by
    intro w hw
    dsimp [z₀]
    rw [hU_dot_per w hw, hU_star_deriv_per w hw]

  have hg_init_holo5 : DifferentiableOn ℂ g_init Y5 :=
    ha_star_holo.mul
      ((glancingDiffOp_real_slice_holo (s - 5 * δ) z₀ hz₀_holo5).add
        (differentiableOn_const ((t₀ : ℂ))⁻¹))
  have hg_init_holo6 : DifferentiableOn ℂ g_init Y6 := hg_init_holo5.mono hY6_sub_Y5

  have hg_init_per5 : ∀ w ∈ Y5, g_init (w + 2 * Real.pi) = g_init w := by
    intro w hw
    dsimp [g_init]
    rw [ha_star_per w hw,
      glancingDiffOp_real_slice_per (s - 5 * δ) z₀ hz₀_holo5 hz₀_per5 w hw]
  have hg_init_per6 : ∀ w ∈ Y6, g_init (w + 2 * Real.pi) = g_init w :=
    fun w hw => hg_init_per5 w (hY6_sub_Y5 hw)

  have hE_dot_per : ∀ y ∈ Y6, E_dot (y + 2 * Real.pi) = E_dot y := by
    intro y hy
    have hy_2pi : y + 2 * Real.pi ∈ Y6 := hstrip_shift_2pi hy
    rw [hE_dot_eq (y + 2 * Real.pi) hy_2pi, hE_dot_eq y hy]
    exact glancingDiffOp_real_slice_per (s - 6 * δ) g_init hg_init_holo6 hg_init_per6 y hy

  
  obtain ⟨hDiff_add, hSolve_cyc⟩ :=
    hCyclic (s - 6 * δ) t₀ M_dot l q a_star E_dot g_init
      hs6_pos ht₀_pos hM_dot_nonneg hl1 hq1 hqt₀_eq

  have ha_star_holo6 : DifferentiableOn ℂ a_star Y6 := ha_star_holo.mono hY6_sub_Y5

  obtain ⟨z, hz_holo, hz_per, hz_norm_raw, hz_eq⟩ :=
    hSolve_cyc
      ha_star_holo6
      hE_dot_holo
      hg_init_holo6
      (fun y hy => ⟨ha_star_per y (hY6_sub_Y5 hy), ha_star_bnd y (hY6_sub_Y5 hy)⟩)
      (fun y hy => ⟨hE_dot_per y hy, hE_dot_bnd y hy⟩)
      hg_init_per6
      hE_dot_eq

  refine ⟨z, hz_holo, hz_per, ?_, ?_⟩
  · intro y hy
    have hraw := hz_norm_raw y hy
    have hmul : (q : ℝ) ^ 2 * t₀ ^ 2 * M_dot ≤ Q ^ 2 * M_dot :=
      mul_le_mul_of_nonneg_right hqt₀_sq_le hM_dot_nonneg
    calc
      ‖z y‖ ≤ 24 * ((q : ℝ) ^ 2 * t₀ ^ 2 * M_dot) := by linarith
      _ ≤ 24 * (Q ^ 2 * M_dot) := mul_le_mul_of_nonneg_left hmul (by norm_num)
      _ = C_z * Q ^ 5 * η_tot := by dsimp [C_z, M_dot]; ring
  · intro y hy
    let g_z : ℂ → ℂ := fun w => a_star w * glancingDiffOp (fun r => z r.1) (w, (t₀ : ℂ))
    let g_comb : ℂ → ℂ :=
      fun w => a_star w * (glancingDiffOp (fun r => z₀ r.1 + z r.1) (w, (t₀ : ℂ)) + ((t₀ : ℂ))⁻¹)
    have hg_z_holo6 : DifferentiableOn ℂ g_z Y6 :=
      ha_star_holo6.mul (glancingDiffOp_real_slice_holo (s - 6 * δ) z hz_holo)
    have hg_comb_eq : ∀ w ∈ Y6, g_comb w = g_init w + g_z w := by
      intro w hw
      dsimp [g_comb, g_init, g_z]
      rw [hDiff_add z₀ z hz₀_holo6 hz_holo w hw]
      ring
    change glancingDiffOp (fun p => g_comb p.1) (y, (t₀ : ℂ)) = 0
    calc
      glancingDiffOp (fun p => g_comb p.1) (y, (t₀ : ℂ))
          = glancingDiffOp (fun p => g_init p.1 + g_z p.1) (y, (t₀ : ℂ)) :=
        glancingDiffOp_congr_real_slice (s - 6 * δ) g_comb (fun w => g_init w + g_z w) y hy
          hg_comb_eq
      _ = glancingDiffOp (fun p => g_init p.1) (y, (t₀ : ℂ)) +
            glancingDiffOp (fun p => g_z p.1) (y, (t₀ : ℂ)) :=
        hDiff_add g_init g_z hg_init_holo6 hg_z_holo6 y hy
      _ = E_dot y + (-E_dot y) := by
        rw [← hE_dot_eq y hy, hz_eq y hy]
      _ = 0 := add_neg_cancel (E_dot y)

theorem affine_jet_regularity_and_linear_bounds (Ω : Set Plane)
    (B : AnalyticBoundaryData Ω)
    (S : GlancingScalePackage B) :
    AffineJetRegularityProp B S :=
by
  intro hCyc s d δ η_slice M_z t₀ l q U U_star z
    hs0 hs_act hd0 hd_act hd_half hδ0 hδ_lt hη_slice0 hM_z0
    hU ht₀_pos ht₀_lt ht₀_eq hU_star hz_holo hz_per_bnd
    Q₀ ρ_jet U_tilde W_plus g_plus H_plus hρ_adm
  have isOpen_horizStrip : ∀ σ : ℝ, IsOpen (horizStrip σ) :=
    fun _ => isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const
  have horizStrip_mono : ∀ {σ₁ σ₂ : ℝ}, σ₁ ≤ σ₂ → horizStrip σ₁ ⊆ horizStrip σ₂ :=
    fun h _ hz => lt_of_lt_of_le hz h
  have isOpen_glancingDomain : ∀ ν : ℝ, IsOpen (glancingDomain ν s d) :=
    fun _ =>
      (isOpen_lt (continuous_norm.comp continuous_snd) continuous_const).inter
        (isOpen_lt (continuous_abs.comp (Complex.continuous_im.comp continuous_fst))
          (continuous_const.sub
            (continuous_const.mul (continuous_abs.comp (Complex.continuous_im.comp continuous_snd)))))
  have hη_adm_pos : 0 < S.η_adm := S.η_adm_pos
  have hη_adm_le32 : S.η_adm ≤ 1 / 32 := S.η_adm_le_inv32
  have hd_lt_one : d < 1 := lt_of_le_of_lt hd_act S.d_act_lt_one
  have hδ_inv_pos : 0 < δ⁻¹ := inv_pos.mpr hδ0
  have hQ₀_gt_one : 1 < Q₀ := by change 1 < 1 + δ⁻¹; linarith
  have hδ_inv_le_Q₀ : δ⁻¹ ≤ Q₀ := by change δ⁻¹ ≤ 1 + δ⁻¹; linarith
  have hQ₀_le_sq : Q₀ ≤ Q₀ ^ 2 := by nlinarith
  have h_one_le_Q₀_sq : 1 ≤ Q₀ ^ 2 := by nlinarith
  have hδ_inv_le_Q₀_sq : δ⁻¹ ≤ Q₀ ^ 2 := le_trans hδ_inv_le_Q₀ hQ₀_le_sq
  have hδ_inv_sq_le : (δ⁻¹) ^ 2 ≤ Q₀ ^ 2 :=
    pow_le_pow_left₀ (le_of_lt hδ_inv_pos) hδ_inv_le_Q₀ 2
  have hMz_term_nonneg : 0 ≤ 10 * Q₀ ^ 2 * M_z := by positivity
  have hρ_jet_nonneg : 0 ≤ ρ_jet := by
    change 0 ≤ η_slice + 10 * Q₀ ^ 2 * M_z
    linarith
  have hη_slice_adm8 : η_slice ≤ S.η_adm / 8 := by
    have hle : η_slice ≤ ρ_jet := by
      change η_slice ≤ η_slice + 10 * Q₀ ^ 2 * M_z
      linarith
    exact le_trans hle hρ_adm
  let B_4 : Set ℂ := Metric.ball (t₀ : ℂ) (δ / 4)
  let B_8 : Set ℂ := Metric.ball (t₀ : ℂ) (δ / 8)
