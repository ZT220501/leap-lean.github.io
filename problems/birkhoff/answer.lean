            (fun z => Complex.exp (W (ξ z) - W (z + (ρ : ℂ) + e_X z))) :=
          hCalc.comp_bound p₀ σ' (Real.exp R_exp) (2 * M_W) (Metric.ball (0 : ℂ) R_exp)
            Complex.exp _ Metric.isOpen_ball (Real.exp_nonneg _) (by positivity)
            hExpBall.1 (fun j _ u hu => hExpBall.2.2 j u hu)
            hD.1.1 hD_ball (fun j _ hj2 z hz => hD.1.2 j hj2 z hz)
        have hE : IsStripHoloSymBounded p₀ σ' M_E
            (fun z => Complex.exp (W (ξ z) - W (z + (ρ : ℂ) + e_X z))) :=
          ⟨hE_bdd,
            fun z hz => by
              have h1 := hD.2.1 z hz; dsimp [ξ] at h1 ⊢
              exact congrArg Complex.exp h1,
            fun z hz => by
              have h1 := hD.2.2 z hz; dsimp [ξ] at h1 ⊢
              rw [← hExpBall.2.1]
              exact congrArg Complex.exp h1⟩
        exact ⟨hξ_holo, hξ_maps, hξ_deriv, hA, hD, hD_ball, hE, hCalc.holo_mul hA hE⟩
      have hPart2 : ∀ z ∈ horizStrip σ',
          (∀ θ ∈ Set.Icc (0 : ℝ) 1,
            ContinuousOn
              (fun s : ℝ =>
                deriv W ((z + (ρ : ℂ) + e_X z) + (s : ℂ) * ((θ : ℂ) * Y z)) *
                  Complex.exp
                    (W ((z + (ρ : ℂ) + e_X z) + (s : ℂ) * ((θ : ℂ) * Y z)) -
                      W (z + (ρ : ℂ) + e_X z)))
              (Set.Icc (0 : ℝ) 1)) ∧
