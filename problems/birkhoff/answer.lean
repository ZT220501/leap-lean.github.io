        = ∫ p : ℝ × ℝ, χ n p ∂MeasureTheory.volume :=
          (MeasureTheory.integral_indicator_one (hE_meas n)).symm
      _ = ∫ p : ℝ × ℝ, χ n p ∂(MeasureTheory.volume.prod MeasureTheory.volume) := by
          rw [MeasureTheory.Measure.volume_eq_prod]
      _ = ∫ D : ℝ, g_slice n D ∂MeasureTheory.volume :=
          MeasureTheory.integral_prod_symm (χ n) (hχ_int n)
  let S_row : ℕ → ℝ → Set ℝ := fun n D => (fun u : ℝ => (u, D)) ⁻¹' (E n)
  have hS_meas : ∀ n : ℕ, ∀ D : ℝ, MeasurableSet (S_row n D) := fun n D =>
    (continuous_id.prodMk continuous_const).measurable (hE_meas n)
  have hg_eq_vol : ∀ n : ℕ, ∀ D : ℝ,
      g_slice n D = MeasureTheory.volume.real (S_row n D) := by
    intro n D
    have h_ind : (fun u : ℝ => χ n (u, D)) = (S_row n D).indicator (fun _ => (1 : ℝ)) := by
      ext u
      by_cases h : (u, D) ∈ E n <;> simp [χ, S_row, h]
    dsimp [g_slice]
    rw [h_ind]
    exact MeasureTheory.integral_indicator_one (hS_meas n D)
  have hg_out : ∀ n : ℕ, ∀ D : ℝ, D ∉ Set.Icc (1 : ℝ) 2 → g_slice n D = 0 := by
    intro n D hD
    rw [hg_eq_vol]
    have hempty : S_row n D = ∅ := by
      ext u
      simp only [S_row, Set.mem_preimage, Set.mem_empty_iff_false, iff_false]
      intro h
      exact hD h.2.1
    rw [hempty, MeasureTheory.measureReal_empty]
  let bound : ℝ → ℝ := (Set.Icc (1 : ℝ) 2).indicator (fun _ => (2 : ℝ))
  have h_bound_int : MeasureTheory.Integrable bound MeasureTheory.volume := by
    refine (MeasureTheory.integrable_indicator_iff measurableSet_Icc).mpr ?_
    refine MeasureTheory.integrableOn_const ?_
    rw [Real.volume_Icc]
    exact ENNReal.ofReal_ne_top
  have h_dom : ∀ n : ℕ, ∀ᵐ D : ℝ ∂MeasureTheory.volume, ‖g_slice n D‖ ≤ bound D := by
    intro n
    refine Filter.Eventually.of_forall (fun D => ?_)
    by_cases hD : D ∈ Set.Icc (1 : ℝ) 2
    · rw [hg_eq_vol, Real.norm_eq_abs, abs_of_nonneg MeasureTheory.measureReal_nonneg]
      have hb : bound D = 2 := Set.indicator_of_mem hD _
      rw [hb]
      have h_sub : S_row n D ⊆ Set.Icc (-1 : ℝ) 1 := fun u hu => hu.1
      have h_fin : MeasureTheory.volume (Set.Icc (-1 : ℝ) 1) ≠ ⊤ := by
        rw [Real.volume_Icc]; exact ENNReal.ofReal_ne_top
      calc MeasureTheory.volume.real (S_row n D)
          ≤ MeasureTheory.volume.real (Set.Icc (-1 : ℝ) 1) :=
            MeasureTheory.measureReal_mono h_sub h_fin
        _ = 1 - (-1) := Real.volume_real_Icc_of_le (by norm_num)
        _ = 2 := by norm_num
    · rw [hg_out n D hD, norm_zero]
      have hb : bound D = 0 := Set.indicator_of_notMem hD _
      rw [hb]
  have h_ae_not_deg : ∀ᵐ D : ℝ ∂MeasureTheory.volume, D ∉ D_deg := by
    rw [MeasureTheory.ae_iff]
    have h_eq : {D : ℝ | ¬ D ∉ D_deg} = D_deg := by ext D; simp
    rw [h_eq]
    exact Set.Finite.measure_zero hQ_deg_rows MeasureTheory.volume
  have h_ae_lim : ∀ᵐ D : ℝ ∂MeasureTheory.volume,
      Filter.Tendsto (fun n => g_slice n D) Filter.atTop (nhds 0) := by
    refine h_ae_not_deg.mono (fun D hD_ndeg => ?_)
    by_cases hD : D ∈ Set.Icc (1 : ℝ) 2
    · have h_eq_fn : (fun n => g_slice n D) =
          (fun n => MeasureTheory.volume.real
            {u ∈ Set.Icc (-1 : ℝ) 1 |
              Real.exp (-(K_seq n) ^ (1 / 200 : ℝ)) ≤
                ‖S.f ((x_seq n : ℂ) + (S.H : ℂ) * Complex.I +
                  (Real.exp (-k_seq n) : ℂ) * ((u : ℂ) - (D : ℂ) * Complex.I))‖ ∧
              ‖S.f ((x_seq n : ℂ) + (S.H : ℂ) * Complex.I +
                (Real.exp (-k_seq n) : ℂ) * ((u : ℂ) - (D : ℂ) * Complex.I))‖ ≤
                Real.exp ((K_seq n) ^ (1 / 200 : ℝ))}) := by
        ext n
        rw [hg_eq_vol]
        congr 1
        ext u
        exact ⟨fun ⟨h1, _, h3, h4⟩ => ⟨h1, h3, h4⟩, fun ⟨h1, h3, h4⟩ => ⟨h1, hD, h3, h4⟩⟩
      rw [h_eq_fn]
      exact h_row_ext D hD hD_ndeg
    · have h_zero : (fun n => g_slice n D) = fun _ => 0 := by
        ext n; exact hg_out n D hD
      rw [h_zero]
      exact tendsto_const_nhds
  have h_tendsto_vol : Filter.Tendsto (fun n => MeasureTheory.volume.real (E n))
      Filter.atTop (nhds 0) := by
    have h_int_lim :=
      MeasureTheory.tendsto_integral_of_dominated_convergence bound
        (fun n => (hχ_int n).integral_prod_right.aestronglyMeasurable)
        h_bound_int h_dom h_ae_lim
    simp only [MeasureTheory.integral_zero] at h_int_lim
    exact Filter.Tendsto.congr' (Filter.Eventually.of_forall fun n => (h_vol_eq n).symm) h_int_lim
  have h_half := h_tendsto_vol.const_mul (1 / 2 : ℝ)
  rw [mul_zero] at h_half
  exact h_half

theorem large_moment_row_sign_test (S : FiniteWallNonisotropicStrip)
    (hBudget : CriticalAngleBudgetData S) :
    ∀ ε : ℝ, 0 < ε →
      ∃ K₁ : ℝ, hBudget.k₀ ≤ K₁ ∧
        ∀ K : ℝ, K₁ ≤ K →
          (∃ j ∈ Set.Icc ((9 / 10 : ℝ) * K) ((21 / 10 : ℝ) * K),
            K ^ (1 / 100 : ℝ) ≤ rowMomentFull S j) →
          ∃ k ∈ Set.Icc ((4 / 5 : ℝ) * K) ((11 / 5 : ℝ) * K),
            MeasureTheory.volume.real
              {x ∈ Set.Icc (0 : ℝ) (2 * Real.pi) |
                Real.exp (-K ^ (1 / 200 : ℝ)) ≤ ‖S.f (upperRowPt S k x)‖ ∧
                ‖S.f (upperRowPt S k x)‖ ≤ Real.exp (K ^ (1 / 200 : ℝ))} ≤ ε :=
by
  intro ε hε
  by_contra h_not
  have h_ex : ∀ n : ℕ, ∃ K : ℝ,
      max (10240000 * max hBudget.C_env 1) (2 * hBudget.k₀ + 4 * (n : ℝ) + 40) ≤ K ∧
      ∃ j : ℝ,
        (j ∈ Set.Icc ((9 / 10 : ℝ) * K) ((21 / 10 : ℝ) * K) ∧
          K ^ (1 / 100 : ℝ) ≤ rowMomentFull S j) ∧
        ∀ k ∈ Set.Icc ((4 / 5 : ℝ) * K) ((11 / 5 : ℝ) * K),
          ε ≤ lmRowModerateMeas S K k := by
    intro n
    let K₁ : ℝ := max (10240000 * max hBudget.C_env 1) (2 * hBudget.k₀ + 4 * (n : ℝ) + 40)
    have hK₁_ge : hBudget.k₀ ≤ K₁ := by
      have hk₀ : 1 ≤ hBudget.k₀ := hBudget.k₀_ge_one
      have hn : (0 : ℝ) ≤ (n : ℝ) := Nat.cast_nonneg n
      have h_lin : hBudget.k₀ ≤ 2 * hBudget.k₀ + 4 * (n : ℝ) + 40 := by linarith
      exact le_trans h_lin (le_max_right _ _)
    by_contra h_none
    apply h_not
    refine ⟨K₁, hK₁_ge, ?_⟩
    intro K hK ⟨j, hj_mem, hj_mom⟩
    by_contra hk_none
    apply h_none
    refine ⟨K, hK, j, ⟨hj_mem, hj_mom⟩, ?_⟩
    intro k hk_mem
    by_contra h_lt
    exact hk_none ⟨k, hk_mem, le_of_not_ge h_lt⟩
  choose K_seq hK_spec using h_ex
  choose j_seq hj_spec using fun n => (hK_spec n).2
  have hK_tendsto : Filter.Tendsto K_seq Filter.atTop Filter.atTop := by
    rw [Filter.tendsto_atTop_atTop]
    intro b
    obtain ⟨N, hN⟩ := exists_nat_ge b
    refine ⟨N, fun n hn => ?_⟩
    have hN_le : (N : ℝ) ≤ (n : ℝ) := Nat.cast_le.mpr hn
    have hk₀ : 1 ≤ hBudget.k₀ := hBudget.k₀_ge_one
    have h_rhs : 2 * hBudget.k₀ + 4 * (n : ℝ) + 40 ≤ K_seq n :=
      le_trans (le_max_right _ _) (hK_spec n).1
    linarith
  have h_H_pos : 0 < S.H := S.H_pos
  have h_exp_k₀_pos : 0 < Real.exp (-hBudget.k₀) := Real.exp_pos _
  have h_exp_k₀_lt : Real.exp (-hBudget.k₀) < S.H / 10 := hBudget.exp_neg_k₀_lt
  obtain ⟨L_star, hL_star, hL_excl⟩ :=
    hBudget.single_center_vanishing_exclusion
      (1 / 8 : ℝ) (3 / 4 : ℝ) (Real.exp (-hBudget.k₀) / 8)
      (by norm_num) (by norm_num) (by norm_num) (by norm_num)
      (by linarith) (by linarith)
  obtain ⟨k_seq, x_seq, C_cone, M_exhaust, hEnv, h_sel⟩ :=
    large_moment_normal_center_selection S hBudget ε L_star hε hL_star K_seq j_seq
      hK_tendsto (fun n => (hK_spec n).1) (fun n => (hj_spec n).1) (fun n => (hj_spec n).2)
  obtain ⟨ϕ, F, Q, hϕ_mono, _hF_holo, hQ_holo, hF_conv, hQ_conv, h_dichot⟩ :=
    rescaled_strip_montel_dichotomy S hBudget L_star C_cone M_exhaust k_seq x_seq
      hL_star hL_excl hEnv
  have hK_sub_tendsto : Filter.Tendsto (fun n => K_seq (ϕ n)) Filter.atTop Filter.atTop :=
    hK_tendsto.comp hϕ_mono.tendsto_atTop
  have h_sub_scales : ∀ n : ℕ,
      1 ≤ K_seq (ϕ n) ∧
      (17 / 20 : ℝ) * K_seq (ϕ n) ≤ k_seq (ϕ n) ∧
      Real.exp (-k_seq (ϕ n)) < S.H / 10 ∧
      (K_seq (ϕ n)) ^ (1 / 100 : ℝ) ≤ rowMomentFull S (k_seq (ϕ n)) := by
    intro n
    have hk₀ : 1 ≤ hBudget.k₀ := hBudget.k₀_ge_one
    have hn_nonneg : (0 : ℝ) ≤ (ϕ n : ℝ) := Nat.cast_nonneg _
    have h_rhs : 2 * hBudget.k₀ + 4 * (ϕ n : ℝ) + 40 ≤ K_seq (ϕ n) :=
      le_trans (le_max_right _ _) (hK_spec (ϕ n)).1
    have hK_ge_one : 1 ≤ K_seq (ϕ n) := by linarith
    have hk_ge_k₀ : hBudget.k₀ ≤ k_seq (ϕ n) := hEnv.k_ge_k₀ (ϕ n)
    have h_exp_le : Real.exp (-k_seq (ϕ n)) ≤ Real.exp (-hBudget.k₀) :=
      Real.exp_le_exp.mpr (by linarith)
    exact ⟨hK_ge_one, (h_sel (ϕ n)).2.1, lt_of_le_of_lt h_exp_le h_exp_k₀_lt, (h_sel (ϕ n)).1⟩
  have h_tendsto_zero :
      Filter.Tendsto
        (fun n => lmBoxModerateFraction S (K_seq (ϕ n)) (k_seq (ϕ n)) (x_seq (ϕ n)))
        Filter.atTop (nhds 0) := by
    rcases h_dichot with hBranchF | ⟨hQ_deg, hQ_row⟩
    · exact nonzero_first_field_box_extinction S
        (fun n => K_seq (ϕ n)) (fun n => k_seq (ϕ n)) (fun n => x_seq (ϕ n)) F
        hK_sub_tendsto h_sub_scales hF_conv hBranchF
    · exact nonconstant_second_field_wkb_box_extinction S
        (fun n => K_seq (ϕ n)) (fun n => k_seq (ϕ n)) (fun n => x_seq (ϕ n)) Q
        hK_sub_tendsto h_sub_scales hQ_holo hQ_conv hQ_deg hQ_row
  have h_pos : 0 < ε / (4 * Real.pi) := by
    exact div_pos hε (mul_pos (by norm_num) Real.pi_pos)
  obtain ⟨N, hN⟩ :=
    Filter.eventually_atTop.mp (Metric.tendsto_nhds.mp h_tendsto_zero (ε / (4 * Real.pi)) h_pos)
  have h_dist := hN N le_rfl
  rw [Real.dist_eq, sub_zero] at h_dist
  have h_ge : ε / (4 * Real.pi) ≤ lmBoxModerateFraction S (K_seq (ϕ N)) (k_seq (ϕ N)) (x_seq (ϕ N)) :=
    (h_sel (ϕ N)).2.2
  have h_lt : lmBoxModerateFraction S (K_seq (ϕ N)) (k_seq (ϕ N)) (x_seq (ϕ N)) < ε / (4 * Real.pi) :=
    lt_of_le_of_lt (le_abs_self _) h_dist
  linarith

theorem discrete_tanaka_periodic_chain : DiscreteTanakaProp :=
by
  intro M h R g κ hh hR hg_cont hg_per hκ_cont hκ_nonneg hκ_int hκ_one h_sub
  have hR_pos : 0 < R := lt_trans hh hR
  have hRh_pos : 0 < R - h := sub_pos.mpr hR
  
  have hg_bdd_ex : ∃ B : ℝ, 1 ≤ B ∧ ∀ m ≤ M, ∀ x : ℝ, |g m x| ≤ B := by
    have h_each : ∀ m : ℕ, ∃ C : ℝ, m ≤ M → ∀ x : ℝ, |g m x| ≤ C := by
      intro m
      by_cases hm : m ≤ M
      · obtain ⟨C, hC⟩ := isCompact_Icc.exists_bound_of_continuousOn (hg_cont m hm).continuousOn
        refine ⟨C, fun _ x => ?_⟩
        obtain ⟨y, hy_mem, hxy⟩ := (hg_per m hm).exists_mem_Ico₀ Real.two_pi_pos x
        rw [hxy, ← Real.norm_eq_abs]
        exact hC y (Set.Ico_subset_Icc_self hy_mem)
      · exact ⟨0, fun h' => False.elim (hm h')⟩
    choose C_fn hC_fn using h_each
    refine ⟨1 + ∑ m ∈ Finset.range (M + 1), max (C_fn m) 0, ?_, ?_⟩
    · have h_nn : 0 ≤ ∑ m ∈ Finset.range (M + 1), max (C_fn m) 0 :=
        Finset.sum_nonneg (fun _ _ => le_max_right _ _)
      linarith
    · intro m hm x
      have h1 : |g m x| ≤ C_fn m := hC_fn m hm x
      have h2 : C_fn m ≤ max (C_fn m) 0 := le_max_left _ _
      have h3 : max (C_fn m) 0 ≤ ∑ j ∈ Finset.range (M + 1), max (C_fn j) 0 :=
        Finset.single_le_sum (fun _ _ => le_max_right _ _) (Finset.mem_range.mpr (by omega))
      linarith
  obtain ⟨B, hB_ge_one, hg_bdd⟩ := hg_bdd_ex
  have hB_pos : 0 < B := by linarith
  have hB_nn : 0 ≤ B := le_of_lt hB_pos
  
  have hStepProb : ∀ m < M, MeasureTheory.IsProbabilityMeasure (dtpcStepMeasure κ m) := by
    intro m hm
    rw [MeasureTheory.isProbabilityMeasure_iff]
    simp only [dtpcStepMeasure, MeasureTheory.withDensity_apply _ MeasurableSet.univ,
      MeasureTheory.Measure.restrict_univ]
    rw [← MeasureTheory.ofReal_integral_eq_lintegral_ofReal (hκ_int m hm)
      (Filter.Eventually.of_forall (hκ_nonneg m hm)), hκ_one m hm, ENNReal.ofReal_one]
  have hStepIntEq : ∀ m < M, ∀ f : ℝ → ℝ,
      (∫ u, f u ∂dtpcStepMeasure κ m) = ∫ u : ℝ, f u * κ m u := by
    intro m hm f
    rw [dtpcStepMeasure, integral_withDensity_eq_integral_toReal_smul
      (hκ_cont m hm).measurable.ennreal_ofReal
      (Filter.Eventually.of_forall (fun _ => ENNReal.ofReal_lt_top)) f]
    congr 1; ext u
    rw [ENNReal.toReal_ofReal (hκ_nonneg m hm u), smul_eq_mul, mul_comm]
  have hChainProb : ∀ n ≤ M, MeasureTheory.IsProbabilityMeasure (dtpcChainMeasure κ n) := by
    intro n hn
    induction n with
    | zero =>
      change MeasureTheory.IsProbabilityMeasure
        (ENNReal.ofReal (2 * Real.pi)⁻¹ •
          MeasureTheory.volume.restrict (Set.Ioc (0 : ℝ) (2 * Real.pi)))
      rw [MeasureTheory.isProbabilityMeasure_iff, MeasureTheory.Measure.smul_apply,
        MeasureTheory.Measure.restrict_apply_univ, smul_eq_mul, Real.volume_Ioc, sub_zero,
        ← ENNReal.ofReal_mul (by positivity), inv_mul_cancel₀ Real.two_pi_pos.ne',
        ENNReal.ofReal_one]
    | succ n ih =>
      have : MeasureTheory.IsProbabilityMeasure (dtpcChainMeasure κ n) := ih (by omega)
      have : MeasureTheory.IsProbabilityMeasure (dtpcStepMeasure κ n) := hStepProb n (by omega)
      change MeasureTheory.IsProbabilityMeasure ((dtpcChainMeasure κ n).prod (dtpcStepMeasure κ n))
      infer_instance
  have hProbM : MeasureTheory.IsProbabilityMeasure (dtpcChainMeasure κ M) := hChainProb M le_rfl
  have hPathMeas : ∀ n : ℕ, Measurable (dtpcChainPath n) := by
    intro n
    induction n with
    | zero =>
      rw [measurable_pi_iff]; intro k
      change Measurable (id : ℝ → ℝ)
      exact measurable_id
    | succ n ih =>
      rw [measurable_pi_iff]; intro k
      by_cases hk : k ≤ n
      · simp only [dtpcChainPath, hk, ↓reduceIte]
        exact ((measurable_pi_apply k).comp ih).comp measurable_fst
      · simp only [dtpcChainPath, hk, ↓reduceIte]
        exact (((measurable_pi_apply n).comp ih).comp measurable_fst).add measurable_snd
  have hStepExtMeas : ∀ m : ℕ, Measurable (fun p : (ℕ → ℝ) × ℝ => dtpcStepExtend m p.1 p.2) := by
    intro m
    rw [measurable_pi_iff]; intro k
    by_cases hk : k ≤ m
    · simp only [dtpcStepExtend, hk, ↓reduceIte]
      exact (measurable_pi_apply k).comp measurable_fst
    · simp only [dtpcStepExtend, hk, ↓reduceIte]
      exact ((measurable_pi_apply m).comp measurable_fst).add measurable_snd
  have hChainIntOfBdd : ∀ (n : ℕ), n ≤ M → ∀ (Φ : (ℕ → ℝ) → ℝ) (C : ℝ),
      Measurable Φ → (∀ w, |Φ w| ≤ C) →
      MeasureTheory.Integrable (fun om => Φ (dtpcChainPath n om)) (dtpcChainMeasure κ n) := by
    intro n hn Φ C hΦ hC
    have : MeasureTheory.IsProbabilityMeasure (dtpcChainMeasure κ n) := hChainProb n hn
    exact MeasureTheory.Integrable.of_bound (hΦ.comp (hPathMeas n)).aestronglyMeasurable C
      (Filter.Eventually.of_forall (fun om => by rw [Real.norm_eq_abs]; exact hC _))
  have hChainProj : ∀ (r N : ℕ), r ≤ N → N ≤ M → ∀ (Φ : (ℕ → ℝ) → ℝ),
      dtpcDependsUpTo r Φ →
      (∫ om, Φ (dtpcChainPath N om) ∂dtpcChainMeasure κ N) =
        ∫ om, Φ (dtpcChainPath r om) ∂dtpcChainMeasure κ r := by
    intro r N hrN hNM Φ hdep
    induction N with
    | zero =>
      have hr0 : r = 0 := Nat.eq_zero_of_le_zero hrN
      subst hr0; rfl
    | succ n ih =>
      by_cases hrn : r = n + 1
      · subst hrn; rfl
      · have hr_le_n : r ≤ n := by omega
        have : MeasureTheory.IsProbabilityMeasure (dtpcChainMeasure κ n) := hChainProb n (by omega)
        have : MeasureTheory.IsProbabilityMeasure (dtpcStepMeasure κ n) := hStepProb n (by omega)
        have h_pt : ∀ p : dtpcChainSpace (n + 1),
            Φ (dtpcChainPath (n + 1) p) = Φ (dtpcChainPath n p.1) * (1 : ℝ) := by
          intro p
          rw [mul_one]
          apply hdep
          intro k hk
          have hk_n : k ≤ n := le_trans hk hr_le_n
          simp [dtpcChainPath, hk_n]
        calc (∫ p, Φ (dtpcChainPath (n + 1) p) ∂dtpcChainMeasure κ (n + 1))
            = ∫ p : dtpcChainSpace n × ℝ, Φ (dtpcChainPath n p.1) * (1 : ℝ)
                 ∂(dtpcChainMeasure κ n).prod (dtpcStepMeasure κ n) :=
              MeasureTheory.integral_congr_ae (Filter.Eventually.of_forall h_pt)
          _ = (∫ q, Φ (dtpcChainPath n q) ∂dtpcChainMeasure κ n) *
                (∫ _ : ℝ, (1 : ℝ) ∂dtpcStepMeasure κ n) :=
              MeasureTheory.integral_prod_mul (fun q => Φ (dtpcChainPath n q)) (fun _ => (1 : ℝ))
          _ = ∫ q, Φ (dtpcChainPath n q) ∂dtpcChainMeasure κ n := by
              rw [MeasureTheory.integral_const, MeasureTheory.probReal_univ, one_smul, mul_one]
          _ = ∫ om, Φ (dtpcChainPath r om) ∂dtpcChainMeasure κ r :=
              ih hr_le_n (by omega)
  have hChainCondStep : ∀ (m : ℕ), m < M → ∀ (Φ : (ℕ → ℝ) → ℝ) (C : ℝ),
      Measurable Φ → (∀ w, |Φ w| ≤ C) → dtpcDependsUpTo (m + 1) Φ →
      (∫ om, Φ (dtpcChainPath M om) ∂dtpcChainMeasure κ M) =
        (∫ hist, (∫ u : ℝ, Φ (dtpcStepExtend m (dtpcChainPath m hist) u) * κ m u)
          ∂dtpcChainMeasure κ m) ∧
      Measurable (fun w : ℕ → ℝ => ∫ u : ℝ, Φ (dtpcStepExtend m w u) * κ m u) ∧
      (∀ w : ℕ → ℝ, |∫ u : ℝ, Φ (dtpcStepExtend m w u) * κ m u| ≤ max C 0) := by
    intro m hm Φ C hΦ_meas hΦ_bdd hΦ_dep
    have h_meas_inner : Measurable (fun w : ℕ → ℝ => ∫ u : ℝ, Φ (dtpcStepExtend m w u) * κ m u) := by
      have h_joint : Measurable (fun p : (ℕ → ℝ) × ℝ => Φ (dtpcStepExtend m p.1 p.2) * κ m p.2) :=
        (hΦ_meas.comp (hStepExtMeas m)).mul ((hκ_cont m hm).measurable.comp measurable_snd)
      exact h_joint.stronglyMeasurable.integral_prod_right'.measurable
    have h_bdd_inner : ∀ w : ℕ → ℝ, |∫ u : ℝ, Φ (dtpcStepExtend m w u) * κ m u| ≤ max C 0 := by
      intro w
      rw [← Real.norm_eq_abs]
      calc ‖∫ u : ℝ, Φ (dtpcStepExtend m w u) * κ m u‖
          ≤ ∫ u : ℝ, max C 0 * κ m u := by
            apply MeasureTheory.norm_integral_le_of_norm_le ((hκ_int m hm).const_mul (max C 0))
            exact Filter.Eventually.of_forall (fun u => by
              rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (hκ_nonneg m hm u)]
              exact mul_le_mul_of_nonneg_right (le_trans (hΦ_bdd _) (le_max_left _ _))
                (hκ_nonneg m hm u))
        _ = max C 0 := by rw [MeasureTheory.integral_const_mul, hκ_one m hm, mul_one]
    refine ⟨?_, h_meas_inner, h_bdd_inner⟩
    rw [hChainProj (m + 1) M (by omega) le_rfl Φ hΦ_dep]
    have : MeasureTheory.IsProbabilityMeasure (dtpcChainMeasure κ m) := hChainProb m (by omega)
    have : MeasureTheory.IsProbabilityMeasure (dtpcStepMeasure κ m) := hStepProb m hm
    have h_int_m1 : MeasureTheory.Integrable
        (fun p : dtpcChainSpace m × ℝ => Φ (dtpcChainPath (m + 1) p))
        ((dtpcChainMeasure κ m).prod (dtpcStepMeasure κ m)) :=
      hChainIntOfBdd (m + 1) (by omega) Φ C hΦ_meas hΦ_bdd
    change (∫ p : dtpcChainSpace m × ℝ, Φ (dtpcChainPath (m + 1) p)
        ∂(dtpcChainMeasure κ m).prod (dtpcStepMeasure κ m)) = _
    rw [MeasureTheory.integral_prod _ h_int_m1]
    congr 1; ext hist
    rw [hStepIntEq m hm]
    rfl
  
  have hMarginal : ∀ (m : ℕ), m ≤ M → ∀ (φ : ℝ → ℝ) (C : ℝ),
      Measurable φ → Function.Periodic φ (2 * Real.pi) → (∀ x, |φ x| ≤ C) →
      (∫ hist, φ (dtpcChainPath m hist m) ∂dtpcChainMeasure κ m) =
        (2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi), φ x := by
    intro m hm
    induction m with
    | zero =>
      intro φ C _ _ _
      change (∫ x : ℝ, φ x ∂(ENNReal.ofReal (2 * Real.pi)⁻¹ •
        MeasureTheory.volume.restrict (Set.Ioc (0 : ℝ) (2 * Real.pi)))) = _
      rw [MeasureTheory.integral_smul_measure,
        ENNReal.toReal_ofReal (by positivity : (0 : ℝ) ≤ (2 * Real.pi)⁻¹), smul_eq_mul,
        intervalIntegral.integral_of_le Real.two_pi_pos.le]
    | succ m ih =>
      intro φ C hφ_meas hφ_per hφ_bdd
      have hm_lt : m < M := by omega
      have : MeasureTheory.IsProbabilityMeasure (dtpcChainMeasure κ m) := hChainProb m (by omega)
      have : MeasureTheory.IsProbabilityMeasure (dtpcStepMeasure κ m) := hStepProb m hm_lt
      have h_int_prod : MeasureTheory.Integrable
          (fun p : dtpcChainSpace m × ℝ => φ (dtpcChainPath (m + 1) p (m + 1)))
          ((dtpcChainMeasure κ m).prod (dtpcStepMeasure κ m)) :=
        hChainIntOfBdd (m + 1) hm (fun w => φ (w (m + 1))) C
          (hφ_meas.comp (measurable_pi_apply (m + 1))) (fun w => hφ_bdd _)
      let ψ : ℝ → ℝ := fun y => ∫ u : ℝ, φ (y + u) * κ m u
      have h_step : (∫ hist, φ (dtpcChainPath (m + 1) hist (m + 1)) ∂dtpcChainMeasure κ (m + 1)) =
          ∫ hist, ψ (dtpcChainPath m hist m) ∂dtpcChainMeasure κ m := by
        change (∫ p : dtpcChainSpace m × ℝ, φ (dtpcChainPath (m + 1) p (m + 1))
            ∂(dtpcChainMeasure κ m).prod (dtpcStepMeasure κ m)) = _
        rw [MeasureTheory.integral_prod _ h_int_prod]
        congr 1; ext hist
        rw [hStepIntEq m hm_lt]
        congr 1; ext u
        simp [dtpcChainPath]
      have hψ_meas : Measurable ψ := by
        have hj : Measurable (fun p : ℝ × ℝ => φ (p.1 + p.2) * κ m p.2) :=
          (hφ_meas.comp measurable_add).mul ((hκ_cont m hm_lt).measurable.comp measurable_snd)
        exact hj.stronglyMeasurable.integral_prod_right'.measurable
      have hψ_per : Function.Periodic ψ (2 * Real.pi) := by
        intro y; simp only [ψ]
        congr 1; ext u
        have h_add : y + 2 * Real.pi + u = (y + u) + 2 * Real.pi := by ring
        rw [h_add, hφ_per (y + u)]
      let C' : ℝ := max C 0
      have hψ_bdd : ∀ y : ℝ, |ψ y| ≤ C' := by
        intro y; rw [← Real.norm_eq_abs]
        calc ‖∫ u : ℝ, φ (y + u) * κ m u‖
            ≤ ∫ u : ℝ, C' * κ m u := by
              apply MeasureTheory.norm_integral_le_of_norm_le ((hκ_int m hm_lt).const_mul C')
              exact Filter.Eventually.of_forall (fun u => by
                rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (hκ_nonneg m hm_lt u)]
                exact mul_le_mul_of_nonneg_right (le_trans (hφ_bdd _) (le_max_left _ _))
                  (hκ_nonneg m hm_lt u))
          _ = C' := by rw [MeasureTheory.integral_const_mul, hκ_one m hm_lt, mul_one]
      rw [h_step, ih (by omega) ψ C' hψ_meas hψ_per hψ_bdd]
      congr 1
      have h_fub : MeasureTheory.Integrable (fun p : ℝ × ℝ => φ (p.1 + p.2) * κ m p.2)
          ((MeasureTheory.volume.restrict (Set.uIoc (0 : ℝ) (2 * Real.pi))).prod
            MeasureTheory.volume) := by
        have : MeasureTheory.IsFiniteMeasure
            (MeasureTheory.volume.restrict (Set.uIoc (0 : ℝ) (2 * Real.pi))) :=
          ⟨by rw [MeasureTheory.Measure.restrict_apply_univ, Set.uIoc_of_le Real.two_pi_pos.le,
                Real.volume_Ioc]; exact ENNReal.ofReal_lt_top⟩
        have h_maj : MeasureTheory.Integrable (fun p : ℝ × ℝ => C' * κ m p.2)
            ((MeasureTheory.volume.restrict (Set.uIoc (0 : ℝ) (2 * Real.pi))).prod
              MeasureTheory.volume) :=
          (MeasureTheory.integrable_const C').mul_prod (hκ_int m hm_lt)
        have h_meas_p : Measurable (fun p : ℝ × ℝ => φ (p.1 + p.2) * κ m p.2) :=
          (hφ_meas.comp measurable_add).mul ((hκ_cont m hm_lt).measurable.comp measurable_snd)
        exact h_maj.mono' h_meas_p.aestronglyMeasurable (Filter.Eventually.of_forall (fun p => by
          rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (hκ_nonneg m hm_lt p.2)]
          exact mul_le_mul_of_nonneg_right (le_trans (hφ_bdd _) (le_max_left _ _))
            (hκ_nonneg m hm_lt p.2)))
      rw [MeasureTheory.intervalIntegral_integral_swap h_fub]
      calc (∫ u : ℝ, ∫ y in (0 : ℝ)..(2 * Real.pi), φ (y + u) * κ m u)
          = ∫ u : ℝ, (∫ x in (0 : ℝ)..(2 * Real.pi), φ x) * κ m u := by
            congr 1; ext u
            rw [intervalIntegral.integral_mul_const]
            congr 1
            rw [intervalIntegral.integral_comp_add_right φ u, zero_add, add_comm (2 * Real.pi) u]
            have h_per_int := hφ_per.intervalIntegral_add_eq u 0
            simpa [zero_add] using h_per_int
        _ = ∫ x in (0 : ℝ)..(2 * Real.pi), φ x := by
            rw [MeasureTheory.integral_const_mul, hκ_one m hm_lt, mul_one]
  have hStepExpect2D : ∀ (m : ℕ), m < M → ∀ (H : ℝ → ℝ → ℝ) (C : ℝ),
      Measurable (Function.uncurry H) →
      (∀ x y, |H x y| ≤ C) →
      (∀ x y, H (x + 2 * Real.pi) (y + 2 * Real.pi) = H x y) →
      (∫ om, H (dtpcChainPath M om m) (dtpcChainPath M om (m + 1)) ∂dtpcChainMeasure κ M) =
        (2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi), (∫ u : ℝ, H x (x + u) * κ m u) := by
    intro m hm H C hH_meas hH_bdd hH_per
    let Φ : (ℕ → ℝ) → ℝ := fun w => H (w m) (w (m + 1))
    have hΦ_meas : Measurable Φ := by
      have hp : Measurable (fun w : ℕ → ℝ => (w m, w (m + 1))) :=
        (measurable_pi_apply m).prodMk (measurable_pi_apply (m + 1))
      exact hH_meas.comp hp
    have hΦ_dep : dtpcDependsUpTo (m + 1) Φ := by
      intro w₁ w₂ hw; simp only [Φ, hw m (by omega), hw (m + 1) le_rfl]
    obtain ⟨h_eq, _, _⟩ := hChainCondStep m hm Φ C hΦ_meas (fun w => hH_bdd _ _) hΦ_dep
    rw [h_eq]
    let φ_H : ℝ → ℝ := fun x => ∫ u : ℝ, H x (x + u) * κ m u
    have h_ext_eq : ∀ hist : dtpcChainSpace m,
        (∫ u : ℝ, Φ (dtpcStepExtend m (dtpcChainPath m hist) u) * κ m u) =
          φ_H (dtpcChainPath m hist m) := by
      intro hist; simp only [Φ, φ_H, dtpcStepExtend, le_rfl, ↓reduceIte]
      have h_not : ¬ (m + 1 ≤ m) := by omega
      simp [h_not]
    simp_rw [h_ext_eq]
    have hφH_meas : Measurable φ_H := by
      have hj : Measurable (fun p : ℝ × ℝ => H p.1 (p.1 + p.2) * κ m p.2) :=
        (hH_meas.comp (measurable_fst.prodMk measurable_add)).mul
          ((hκ_cont m hm).measurable.comp measurable_snd)
      exact hj.stronglyMeasurable.integral_prod_right'.measurable
    have hφH_per : Function.Periodic φ_H (2 * Real.pi) := by
      intro x; simp only [φ_H]; congr 1; ext u
      have h_add : x + 2 * Real.pi + u = (x + u) + 2 * Real.pi := by ring
      rw [h_add, hH_per x (x + u)]
    have hφH_bdd : ∀ x : ℝ, |φ_H x| ≤ max C 0 := by
      intro x; rw [← Real.norm_eq_abs]
      calc ‖∫ u : ℝ, H x (x + u) * κ m u‖
          ≤ ∫ u : ℝ, max C 0 * κ m u := by
            apply MeasureTheory.norm_integral_le_of_norm_le ((hκ_int m hm).const_mul (max C 0))
            exact Filter.Eventually.of_forall (fun u => by
              rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg (hκ_nonneg m hm u)]
              exact mul_le_mul_of_nonneg_right (le_trans (hH_bdd _ _) (le_max_left _ _))
                (hκ_nonneg m hm u))
        _ = max C 0 := by rw [MeasureTheory.integral_const_mul, hκ_one m hm, mul_one]
    exact hMarginal m (by omega) φ_H (max C 0) hφH_meas hφH_per hφH_bdd
  
  let E_pred : ℕ → (ℕ → ℝ) → Prop := fun m w => ∀ k ∈ Finset.range (m + 1), g k (w k) ≤ R
  have hE_meas : ∀ m ≤ M, MeasurableSet {w : ℕ → ℝ | E_pred m w} := by
    intro m hm
    have h_eq_set : {w : ℕ → ℝ | E_pred m w} =
        ⋂ k ∈ (Finset.range (m + 1) : Set ℕ), {w : ℕ → ℝ | g k (w k) ≤ R} := by
      ext w; simp [E_pred]
    rw [h_eq_set]
    apply MeasurableSet.biInter (Finset.countable_toSet _)
    intro k hk
    have hkM : k ≤ M := by
      have : k < m + 1 := Finset.mem_range.mp hk
      omega
    exact measurableSet_Iic.preimage ((hg_cont k hkM).measurable.comp (measurable_pi_apply k))
  let PreTerm : ℕ → (ℕ → ℝ) → ℝ := fun m w =>
    if E_pred m w ∧ |g m (w m)| ≤ h then
      min ((g (m + 1) (w (m + 1)) - g m (w m)) ^ 2) (h ^ 2)
    else 0
  let PostTerm : ℕ → (ℕ → ℝ) → ℝ := fun m w =>
    if ¬ E_pred m w ∧ |g m (w m)| ≤ h then
      min ((g (m + 1) (w (m + 1)) - g m (w m)) ^ 2) (h ^ 2)
    else 0
  let PreOccup : (ℕ → ℝ) → ℝ := fun w => ∑ m ∈ Finset.range M, PreTerm m w
  let PostOccup : (ℕ → ℝ) → ℝ := fun w => ∑ m ∈ Finset.range M, PostTerm m w
  let QVar : (ℕ → ℝ) → ℝ := fun w =>
    ∑ m ∈ Finset.range M, (g (m + 1) (w (m + 1)) - g m (w m)) ^ 2
  have hMeasG : ∀ k ≤ M, Measurable (fun w : ℕ → ℝ => g k (w k)) :=
    fun k hk => (hg_cont k hk).measurable.comp (measurable_pi_apply k)
  have hPreTermMeas : ∀ m < M, Measurable (PreTerm m) := by
    intro m hm
    have hS : MeasurableSet {w : ℕ → ℝ | E_pred m w ∧ |g m (w m)| ≤ h} :=
      (hE_meas m (by omega)).inter
        (measurableSet_Iic.preimage (continuous_abs.measurable.comp (hMeasG m (by omega))))
    exact Measurable.ite hS
      ((((hMeasG (m + 1) (by omega)).sub (hMeasG m (by omega))).pow_const 2).min measurable_const)
      measurable_const
  have hPostTermMeas : ∀ m < M, Measurable (PostTerm m) := by
    intro m hm
    have hS : MeasurableSet {w : ℕ → ℝ | ¬ E_pred m w ∧ |g m (w m)| ≤ h} :=
      (hE_meas m (by omega)).compl.inter
        (measurableSet_Iic.preimage (continuous_abs.measurable.comp (hMeasG m (by omega))))
    exact Measurable.ite hS
      ((((hMeasG (m + 1) (by omega)).sub (hMeasG m (by omega))).pow_const 2).min measurable_const)
      measurable_const
  have hPreTermBdd : ∀ m < M, ∀ w : ℕ → ℝ, |PreTerm m w| ≤ h ^ 2 := by
    intro m _ w; simp only [PreTerm]
    split_ifs
    · rw [abs_of_nonneg (le_min (sq_nonneg _) (sq_nonneg _))]; exact min_le_right _ _
    · rw [abs_zero]; positivity
  have hPostTermBdd : ∀ m < M, ∀ w : ℕ → ℝ, |PostTerm m w| ≤ h ^ 2 := by
    intro m _ w; simp only [PostTerm]
    split_ifs
    · rw [abs_of_nonneg (le_min (sq_nonneg _) (sq_nonneg _))]; exact min_le_right _ _
    · rw [abs_zero]; positivity
  have hPreOccupMeas : Measurable PreOccup :=
    Finset.measurable_sum (Finset.range M) (fun m hm => hPreTermMeas m (Finset.mem_range.mp hm))
  have hPostOccupMeas : Measurable PostOccup :=
    Finset.measurable_sum (Finset.range M) (fun m hm => hPostTermMeas m (Finset.mem_range.mp hm))
  have hPreOccupBdd : ∀ w : ℕ → ℝ, |PreOccup w| ≤ (M : ℝ) * h ^ 2 := by
    intro w
    calc |PreOccup w|
        ≤ ∑ m ∈ Finset.range M, |PreTerm m w| := Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ _ ∈ Finset.range M, h ^ 2 :=
          Finset.sum_le_sum (fun m hm => hPreTermBdd m (Finset.mem_range.mp hm) w)
      _ = (M : ℝ) * h ^ 2 := by simp
  have hPostOccupBdd : ∀ w : ℕ → ℝ, |PostOccup w| ≤ (M : ℝ) * h ^ 2 := by
    intro w
    calc |PostOccup w|
        ≤ ∑ m ∈ Finset.range M, |PostTerm m w| := Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ _ ∈ Finset.range M, h ^ 2 :=
          Finset.sum_le_sum (fun m hm => hPostTermBdd m (Finset.mem_range.mp hm) w)
      _ = (M : ℝ) * h ^ 2 := by simp
  have hQTermBdd : ∀ m < M, ∀ w : ℕ → ℝ, |(g (m + 1) (w (m + 1)) - g m (w m)) ^ 2| ≤ 4 * B ^ 2 := by
    intro m hm w
    rw [abs_of_nonneg (sq_nonneg _)]
    have h1 : |g (m + 1) (w (m + 1))| ≤ B := hg_bdd (m + 1) (by omega) _
    have h2 : |g m (w m)| ≤ B := hg_bdd m (by omega) _
    have h3 : |g (m + 1) (w (m + 1)) - g m (w m)| ≤ 2 * B := by
      calc |g (m + 1) (w (m + 1)) - g m (w m)|
          ≤ |g (m + 1) (w (m + 1))| + |g m (w m)| := abs_sub _ _
        _ ≤ 2 * B := by linarith
    nlinarith [sq_abs (g (m + 1) (w (m + 1)) - g m (w m)), abs_nonneg (g (m + 1) (w (m + 1)) - g m (w m))]
  have hQVarMeas : Measurable QVar :=
    Finset.measurable_sum (Finset.range M) (fun m hm =>
      ((hMeasG (m + 1) (by have := Finset.mem_range.mp hm; omega)).sub
        (hMeasG m (by have := Finset.mem_range.mp hm; omega))).pow_const 2)
  have hQVarBdd : ∀ w : ℕ → ℝ, |QVar w| ≤ (M : ℝ) * (4 * B ^ 2) := by
    intro w
    calc |QVar w|
        ≤ ∑ m ∈ Finset.range M, |(g (m + 1) (w (m + 1)) - g m (w m)) ^ 2| :=
          Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ _ ∈ Finset.range M, 4 * B ^ 2 :=
          Finset.sum_le_sum (fun m hm => hQTermBdd m (Finset.mem_range.mp hm) w)
      _ = (M : ℝ) * (4 * B ^ 2) := by simp
  
  have hVarSplit : (∑ m ∈ Finset.range M,
      (2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi),
        (∫ u : ℝ, (g (m + 1) (x + u) - g m x) ^ 2 * κ m u)) =
      ∫ om, QVar (dtpcChainPath M om) ∂dtpcChainMeasure κ M := by
    rw [show (∫ om, QVar (dtpcChainPath M om) ∂dtpcChainMeasure κ M) =
        ∑ m ∈ Finset.range M,
          ∫ om, (g (m + 1) (dtpcChainPath M om (m + 1)) - g m (dtpcChainPath M om m)) ^ 2
            ∂dtpcChainMeasure κ M from
      MeasureTheory.integral_finsetSum (Finset.range M) (fun m hm => by
        have hm' : m < M := Finset.mem_range.mp hm
        exact hChainIntOfBdd M le_rfl (fun w => (g (m + 1) (w (m + 1)) - g m (w m)) ^ 2)
          (4 * B ^ 2) (((hMeasG (m + 1) (by omega)).sub (hMeasG m (by omega))).pow_const 2)
          (hQTermBdd m hm'))]
    apply Finset.sum_congr rfl
    intro m hm
    have hm' : m < M := Finset.mem_range.mp hm
    symm
    apply hStepExpect2D m hm' (fun x y => (g (m + 1) y - g m x) ^ 2) (4 * B ^ 2)
    · exact (((hg_cont (m + 1) (by omega)).comp continuous_snd).sub
        ((hg_cont m (by omega)).comp continuous_fst)).pow 2 |>.measurable
    · intro x y
      rw [abs_of_nonneg (sq_nonneg _)]
      have h1 := hg_bdd (m + 1) (by omega) y
      have h2 := hg_bdd m (by omega) x
      have h3 : |g (m + 1) y - g m x| ≤ 2 * B := le_trans (abs_sub _ _) (by linarith)
      nlinarith [sq_abs (g (m + 1) y - g m x), abs_nonneg (g (m + 1) y - g m x)]
    · intro x y
      rw [hg_per (m + 1) (by omega) y, hg_per m (by omega) x]
  have hOccSplit : (∑ m ∈ Finset.range M,
      (2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi),
        (if |g m x| ≤ h then
          ∫ u : ℝ, min ((g (m + 1) (x + u) - g m x) ^ 2) (h ^ 2) * κ m u
        else 0)) =
      (∫ om, PreOccup (dtpcChainPath M om) ∂dtpcChainMeasure κ M) +
      (∫ om, PostOccup (dtpcChainPath M om) ∂dtpcChainMeasure κ M) := by
    have h_sum_int : (∫ om, PreOccup (dtpcChainPath M om) ∂dtpcChainMeasure κ M) +
        (∫ om, PostOccup (dtpcChainPath M om) ∂dtpcChainMeasure κ M) =
        ∑ m ∈ Finset.range M,
          ∫ om, (if |g m (dtpcChainPath M om m)| ≤ h then
            min ((g (m + 1) (dtpcChainPath M om (m + 1)) - g m (dtpcChainPath M om m)) ^ 2) (h ^ 2)
          else 0) ∂dtpcChainMeasure κ M := by
      rw [← MeasureTheory.integral_add
        (hChainIntOfBdd M le_rfl PreOccup ((M : ℝ) * h ^ 2) hPreOccupMeas hPreOccupBdd)
        (hChainIntOfBdd M le_rfl PostOccup ((M : ℝ) * h ^ 2) hPostOccupMeas hPostOccupBdd)]
      have h_pt : ∀ om : dtpcChainSpace M,
          PreOccup (dtpcChainPath M om) + PostOccup (dtpcChainPath M om) =
          ∑ m ∈ Finset.range M,
            (if |g m (dtpcChainPath M om m)| ≤ h then
              min ((g (m + 1) (dtpcChainPath M om (m + 1)) - g m (dtpcChainPath M om m)) ^ 2) (h ^ 2)
            else 0) := by
        intro om
        simp only [PreOccup, PostOccup, PreTerm, PostTerm, ← Finset.sum_add_distrib]
        apply Finset.sum_congr rfl; intro m _
        by_cases hE : E_pred m (dtpcChainPath M om) <;>
          by_cases hg : |g m (dtpcChainPath M om m)| ≤ h <;> simp [hE, hg]
      simp_rw [h_pt]
      exact MeasureTheory.integral_finsetSum (Finset.range M) (fun m hm => by
        have hm' : m < M := Finset.mem_range.mp hm
