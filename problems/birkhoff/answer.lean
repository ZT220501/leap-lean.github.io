    have hPhi_ne : PhiQ z ≠ 0 := by
      intro h0; rw [h0, Complex.zero_re] at hPhi_re; linarith
    exact ⟨hq_norm, hq_small, h1pq_gt, h1mq_gt, h1pq_ne, hcosh_ne, hsinh_ne,
      htanh_eq, hsech_sq, hPhi_eq, hPhi_bound, hPhi_lt_tenth, hPhi_slit, hPhi_ne⟩

  
  let C_ψ : ℝ := 4800 / Λ ^ 2
  have hC_ψ_pos : 0 < C_ψ := by dsimp [C_ψ]; positivity
  have hC_ψ_lt : C_ψ < 1200 := by
