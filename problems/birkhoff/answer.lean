    obtain ⟨hg₁_low, hg₁_inv⟩ := hJet_inv_one_add hg₁
    obtain ⟨hg₂_low, hg₂_inv⟩ := hJet_inv_one_add hg₂
    have hQ := hJet_mul hg₁_inv hg₂_inv
    have hN := hJet_add (hJet_mul (hJet_pow5 ht) hb_p) (hJet_mul (hJet_pow5 hs) hb_m)
    have hNQ := hJet_mul hN hQ
    have hForce_raw := hJet_const_mul (-(2 * (q : ℝ) / Real.pi)) hNQ
    have hForce : IsRealJetPerturb p (C_force / (q : ℝ) ^ 4) (rdmc_elForcing J_R q w d (j + 1)) := by
      refine hJet_congr (fun x => by simp only [rdmc_elForcing, hj, ↓reduceIte, ρ])
