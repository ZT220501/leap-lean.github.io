      rw [sub_self, map_zero, mul_zero, add_zero, hQ_c0, hP_top] at h_mul
      change MvPowerSeries.coeff d
          (MvPowerSeries.C (2 : ℂ) * P * compPowerSeries2D (S_ser i) (lcJetHalfStep2D α_ser i)) =
        MvPowerSeries.coeff d
          (MvPowerSeries.C (2 : ℂ) * P0 * compPowerSeries2D (S_ser i) (lcJetHalfStep2D α_ser i)) +
          2 * s_d i * PowerSeries.coeff M (h_ser i) * MvPowerSeries.coeff d ((ψ_ser i) ^ M)
      have hPQ : MvPowerSeries.C (2 : ℂ) * P *
          compPowerSeries2D (S_ser i) (lcJetHalfStep2D α_ser i) = P * Q := by
        dsimp only [Q]; ring
      have hP0Q : MvPowerSeries.C (2 : ℂ) * P0 *
