    refine lt_of_le_of_lt hb_rec_R2 ?_
    exact lt_min (lt_of_le_of_lt (min_le_left _ _) (by linarith))
      (lt_of_le_of_lt (min_le_right _ _) (by norm_num))
  have hb_rec_R3 :
      8 * (A₀ + 5) * C_core.C_pass * ((5 / 4 : ℝ) * T₀) ^ 2 * b_rec ^ (2 * α) ≤ 1 / 16 := by
    have h1 : 2 / η_R3 ≤ D_rec :=
