              4 * M_max * ‖D_root - D_prev_star‖ := by ring
        linarith
      calc ‖S_next - S_star (Y - a_n, T)‖ +
              ‖(rctActDJ (F_n n) S_next D_root T - a_n * rctActDS (F_n n) S_next D_root T) -
                (rctActDJ (F_n n) (S_star (Y - a_n, T)) D_prev_star T -
                  a_n * rctActDS (F_n n) (S_star (Y - a_n, T)) D_prev_star T)‖
          ≤ (1 + 4 * M_max) * ‖D_root - D_prev_star‖ := by linarith
        _ ≤ (1 + 4 * M_max) * (μ_inv_max * ‖res_plus‖) :=
              mul_le_mul_of_nonneg_left hD_diff (by positivity)
        _ ≤ (1 + 4 * M_max) * (μ_inv_max * ((3 * C_EL_nb + 1) * δ₀ n * ‖a_n‖)) := by
              refine mul_le_mul_of_nonneg_left ?_ (by positivity)
              exact mul_le_mul_of_nonneg_left h_res_plus_bd hμ_inv_max_pos.le
        _ = ((1 + 4 * M_max) * μ_inv_max * (3 * C_EL_nb + 1)) * (δ₀ n * ‖a_n‖) := by ring
        _ ≤ C_cons * (δ₀ n * ‖a_n‖) :=
              mul_le_mul_of_nonneg_right hC_cons_2 (mul_nonneg (hδ₀_nonneg n) ha_pos.le)
        _ = C_cons * δ₀ n * ‖a_n‖ := by ring
  
  · intro n hn Y T S hYT_U hS_tube
    have hn_exh : N_exh ≤ n :=
      le_trans
        (le_trans (le_max_right _ _)
          (le_trans (le_max_right _ _) (le_trans (le_max_right _ _) (le_max_right _ _)))) hn
    have hS_star_bd : ‖S_star (Y, T)‖ ≤ M_S :=
      le_trans (hM_S_raw (Y, T) (hU_sub_K_nbhd hYT_U)) (le_max_left _ _)
    have hS_bd : ‖S‖ ≤ M_S + r_tube := by
      have h_tri : ‖S‖ ≤ ‖S - S_star (Y, T)‖ + ‖S_star (Y, T)‖ :=
        norm_le_norm_sub_add S (S_star (Y, T))
      linarith
    exact hN_exh n hn_exh S hS_bd
  
  · intro n hn W Y₀_fn T_fn S_prev_fn S_curr_fn hW_open hY₀_holo hT_holo hSp_holo hSc_holo hw_all
    have h_fst_eq :
        (fun w => (rctInitSymplecticState P seq n σ (S_prev_fn w) (S_curr_fn w) (T_fn w)).1) =
          S_curr_fn := by
      ext w
      unfold rctInitSymplecticState
      dsimp only []
      split_ifs <;> rfl
    refine ⟨by rw [h_fst_eq]; exact hSc_holo, ?_⟩
    let a_fn : ℂ × ℂ → ℂ := fun w => T_fn w / ((b_seq n : ℝ) : ℂ)
    have ha_fn_holo : DifferentiableOn ℂ a_fn W := by
      have h_eq : a_fn = fun w => T_fn w * (((b_seq n : ℝ) : ℂ))⁻¹ := by
        ext w; dsimp [a_fn]; rw [div_eq_mul_inv]
      rw [h_eq]
      exact hT_holo.mul_const _
    have ha_fn_ne : ∀ w ∈ W, a_fn w ≠ 0 := by
      intro w hw
      exact (h_a_glob n hn (T_fn w) (hw_all w hw).2.1 (hw_all w hw).2.2.1).1
    have ha_inv_holo : DifferentiableOn ℂ (fun w => (a_fn w)⁻¹) W :=
      ha_fn_holo.inv ha_fn_ne
    rcases hσ with rfl | rfl
    · let D_prev_fn : ℂ × ℂ → ℂ := fun w => (S_curr_fn w - S_prev_fn w) / a_fn w
      have hDp_holo : DifferentiableOn ℂ D_prev_fn W := by
        have h_eq : D_prev_fn = fun w => (S_curr_fn w - S_prev_fn w) * (a_fn w)⁻¹ := by
          ext w; dsimp [D_prev_fn]; rw [div_eq_mul_inv]
        rw [h_eq]
        exact (hSc_holo.sub hSp_holo).mul ha_inv_holo
      have h_snd_eq :
          (fun w => (rctInitSymplecticState P seq n 1 (S_prev_fn w) (S_curr_fn w) (T_fn w)).2) =
            fun w => rctActDJ (F_n n) (S_prev_fn w) (D_prev_fn w) (T_fn w) := by
        ext w
        rw [h_init_pos]
      rw [h_snd_eq]
      intro w₀ hw₀
      apply DifferentiableAt.differentiableWithinAt
      have hW_nhds : W ∈ nhds w₀ := hW_open.mem_nhds hw₀
      rcases hw_all w₀ hw₀ with ⟨hYT_U, hTw_ne, hTw_le, he_w₀⟩
      have h1a : ((1 : ℝ) : ℂ) * a_fn w₀ = a_fn w₀ := by push_cast; ring
      rw [h1a] at he_w₀
      obtain ⟨i, hi, hYT⟩ := h_U_cov (Y₀_fn w₀, T_fn w₀) hYT_U
      have hn_anch : N_anch i ≤ n :=
        le_trans (Finset.le_sup' N_anch hi)
          (le_trans (le_trans (le_max_left _ _) (le_max_right _ _)) hn)
      obtain ⟨hjet_i, _⟩ := h_jet_anch i n hn_anch
      obtain ⟨ha_ne, ha_pos, ha_1, ha_nb, _, ha_rmin, _⟩ :=
        h_a_glob n hn (T_fn w₀) hTw_ne hTw_le
      obtain ⟨_, _, hq_prev_star, _, hS_back_lt, _, _⟩ :=
        h_model_pts_in_Qc n hn i hi (Y₀_fn w₀) (T_fn w₀) hYT_U hYT hTw_ne hTw_le
      obtain ⟨_, _, _, _, hD_prev_J, _, _⟩ :=
        hEL_nb (Y₀_fn w₀, T_fn w₀) (hU_sub_K_nbhd hYT_U) (a_fn w₀) ha_pos ha_nb
      have hr_init_rc : r_init_atl ≤ r_c i / 8 :=
        le_trans (min_le_left _ _)
          (div_le_div_of_nonneg_right (Finset.inf'_le r_c hi) (by positivity))
      have h_cel_le : C_EL_nb * ‖a_fn w₀‖ ≤ r_c i / 8 := by
        have := Finset.inf'_le r_c hi; linarith
      let D_prev_star_w₀ : ℂ :=
        (S_star (Y₀_fn w₀, T_fn w₀) - S_star (Y₀_fn w₀ - a_fn w₀, T_fn w₀)) / a_fn w₀
      have hDp_diff :
          ‖D_prev_fn w₀ - D_prev_star_w₀‖ ≤
            ‖D_prev_fn w₀ - J_star_fn (Y₀_fn w₀, T_fn w₀)‖ + C_EL_nb * ‖a_fn w₀‖ := by
        have h_tri :=
          norm_sub_le_norm_sub_add_norm_sub (D_prev_fn w₀)
            (J_star_fn (Y₀_fn w₀, T_fn w₀)) D_prev_star_w₀
        rw [norm_sub_rev (J_star_fn (Y₀_fn w₀, T_fn w₀)) D_prev_star_w₀] at h_tri
        linarith
      have hSp_diff :
          ‖S_prev_fn w₀ - S_star (Y₀_fn w₀ - a_fn w₀, T_fn w₀)‖ < r_c i / 4 := by
        have h_id :
            S_prev_fn w₀ - S_star (Y₀_fn w₀ - a_fn w₀, T_fn w₀) =
              (S_curr_fn w₀ - S_star (Y₀_fn w₀, T_fn w₀)) -
                a_fn w₀ * (D_prev_fn w₀ - D_prev_star_w₀) := by
          dsimp [D_prev_fn, D_prev_star_w₀]
          rw [mul_sub, mul_div_cancel₀ _ ha_ne, mul_div_cancel₀ _ ha_ne]
          ring
        rw [h_id]
        have h_sub :=
          norm_sub_le (S_curr_fn w₀ - S_star (Y₀_fn w₀, T_fn w₀))
            (a_fn w₀ * (D_prev_fn w₀ - D_prev_star_w₀))
        rw [norm_mul] at h_sub
        have h_mul :
            ‖a_fn w₀‖ * ‖D_prev_fn w₀ - D_prev_star_w₀‖ ≤
              1 * (‖D_prev_fn w₀ - J_star_fn (Y₀_fn w₀, T_fn w₀)‖ + C_EL_nb * ‖a_fn w₀‖) :=
          mul_le_mul ha_1 hDp_diff (norm_nonneg _) zero_le_one
        change ‖S_curr_fn w₀ - S_star (Y₀_fn w₀, T_fn w₀)‖ +
          ‖D_prev_fn w₀ - J_star_fn (Y₀_fn w₀, T_fn w₀)‖ < r_init_atl at he_w₀
        linarith
      have h_pt_in : (S_prev_fn w₀, (D_prev_fn w₀, T_fn w₀)) ∈ Q_c i := by
        have hJ_var := (h_model_var i (Y₀_fn w₀, T_fn w₀) hYT).2.1
        have hSp_S₀ : ‖S_prev_fn w₀ - S₀ i‖ < r_c i / 2 := by
          have := norm_sub_le_norm_sub_add_norm_sub (S_prev_fn w₀)
            (S_star (Y₀_fn w₀ - a_fn w₀, T_fn w₀)) (S₀ i)
          linarith
        have hDp_J₀ : ‖D_prev_fn w₀ - J₀ i‖ < r_c i / 4 := by
          have := norm_sub_le_norm_sub_add_norm_sub (D_prev_fn w₀)
            (J_star_fn (Y₀_fn w₀, T_fn w₀)) (J₀ i)
          change ‖S_curr_fn w₀ - S_star (Y₀_fn w₀, T_fn w₀)‖ +
            ‖D_prev_fn w₀ - J_star_fn (Y₀_fn w₀, T_fn w₀)‖ < r_init_atl at he_w₀
          linarith [norm_nonneg (S_curr_fn w₀ - S_star (Y₀_fn w₀, T_fn w₀))]
        exact ⟨by linarith [hr_c_pos i], by linarith [hr_c_pos i], hq_prev_star.2.2⟩
      have hQ_open : IsOpen (Q_c i) := by
        dsimp only [Q_c]
        rw [h_Qc_ball]
        exact Metric.isOpen_ball
      have hDJ_at :
          DifferentiableAt ℂ (fun q : ℂ × ℂ × ℂ => rctActDJ (F_n n) q.1 q.2.1 q.2.2)
            (S_prev_fn w₀, (D_prev_fn w₀, T_fn w₀)) :=
        hjet_i.2.2.2.2.2.1.differentiableAt (hQ_open.mem_nhds h_pt_in)
      exact h_comp3 (fun q : ℂ × ℂ × ℂ => rctActDJ (F_n n) q.1 q.2.1 q.2.2)
        S_prev_fn D_prev_fn T_fn w₀ hDJ_at
        (hSp_holo.differentiableAt hW_nhds)
        (hDp_holo.differentiableAt hW_nhds)
        (hT_holo.differentiableAt hW_nhds)
    · let D_prev_fn : ℂ × ℂ → ℂ := fun w => (S_prev_fn w - S_curr_fn w) / a_fn w
      have hDp_holo : DifferentiableOn ℂ D_prev_fn W := by
        have h_eq : D_prev_fn = fun w => (S_prev_fn w - S_curr_fn w) * (a_fn w)⁻¹ := by
          ext w; dsimp [D_prev_fn]; rw [div_eq_mul_inv]
        rw [h_eq]
        exact (hSp_holo.sub hSc_holo).mul ha_inv_holo
      have h_snd_eq :
          (fun w => (rctInitSymplecticState P seq n (-1) (S_prev_fn w) (S_curr_fn w) (T_fn w)).2) =
            fun w =>
              rctActDJ (F_n n) (S_curr_fn w) (D_prev_fn w) (T_fn w) -
                a_fn w * rctActDS (F_n n) (S_curr_fn w) (D_prev_fn w) (T_fn w) := by
        ext w
        rw [h_init_neg]
      rw [h_snd_eq]
      intro w₀ hw₀
      apply DifferentiableAt.differentiableWithinAt
      have hW_nhds : W ∈ nhds w₀ := hW_open.mem_nhds hw₀
      rcases hw_all w₀ hw₀ with ⟨hYT_U, hTw_ne, hTw_le, he_w₀⟩
      have hm1_div :
          (S_curr_fn w₀ - S_prev_fn w₀) / (((-1 : ℝ) : ℂ) * a_fn w₀) = D_prev_fn w₀ := by
        dsimp [D_prev_fn]
        rw [show ((-1 : ℝ) : ℂ) * a_fn w₀ = -a_fn w₀ by push_cast; ring,
          div_neg, ← neg_div, neg_sub]
      rw [hm1_div] at he_w₀
      obtain ⟨i, hi, hYT⟩ := h_U_cov (Y₀_fn w₀, T_fn w₀) hYT_U
      have hn_anch : N_anch i ≤ n :=
        le_trans (Finset.le_sup' N_anch hi)
          (le_trans (le_trans (le_max_left _ _) (le_max_right _ _)) hn)
      obtain ⟨hjet_i, _⟩ := h_jet_anch i n hn_anch
      obtain ⟨_, hq_curr_star, _, hS_lt_8, _, _, _⟩ :=
        h_model_pts_in_Qc n hn i hi (Y₀_fn w₀) (T_fn w₀) hYT_U hYT hTw_ne hTw_le
      have hr_init_rc : r_init_atl ≤ r_c i / 8 :=
        le_trans (min_le_left _ _)
          (div_le_div_of_nonneg_right (Finset.inf'_le r_c hi) (by positivity))
      have h_pt_in : (S_curr_fn w₀, (D_prev_fn w₀, T_fn w₀)) ∈ Q_c i := by
        have hJ_var := (h_model_var i (Y₀_fn w₀, T_fn w₀) hYT).2.1
        change ‖S_curr_fn w₀ - S_star (Y₀_fn w₀, T_fn w₀)‖ +
          ‖D_prev_fn w₀ - J_star_fn (Y₀_fn w₀, T_fn w₀)‖ < r_init_atl at he_w₀
        have hSc_S₀ : ‖S_curr_fn w₀ - S₀ i‖ < r_c i / 4 := by
          have := norm_sub_le_norm_sub_add_norm_sub (S_curr_fn w₀)
            (S_star (Y₀_fn w₀, T_fn w₀)) (S₀ i)
          linarith [norm_nonneg (D_prev_fn w₀ - J_star_fn (Y₀_fn w₀, T_fn w₀))]
        have hDp_J₀ : ‖D_prev_fn w₀ - J₀ i‖ < r_c i / 4 := by
          have := norm_sub_le_norm_sub_add_norm_sub (D_prev_fn w₀)
            (J_star_fn (Y₀_fn w₀, T_fn w₀)) (J₀ i)
          linarith [norm_nonneg (S_curr_fn w₀ - S_star (Y₀_fn w₀, T_fn w₀))]
        exact ⟨by linarith [hr_c_pos i], by linarith [hr_c_pos i], hq_curr_star.2.2⟩
      have hQ_open : IsOpen (Q_c i) := by
        dsimp only [Q_c]
        rw [h_Qc_ball]
        exact Metric.isOpen_ball
      have h_nhds_Q : Q_c i ∈ nhds (S_curr_fn w₀, (D_prev_fn w₀, T_fn w₀)) :=
        hQ_open.mem_nhds h_pt_in
      have hDJ_w₀ :=
        h_comp3 (fun q : ℂ × ℂ × ℂ => rctActDJ (F_n n) q.1 q.2.1 q.2.2)
          S_curr_fn D_prev_fn T_fn w₀
          (hjet_i.2.2.2.2.2.1.differentiableAt h_nhds_Q)
          (hSc_holo.differentiableAt hW_nhds)
          (hDp_holo.differentiableAt hW_nhds)
          (hT_holo.differentiableAt hW_nhds)
      have hDS_w₀ :=
        h_comp3 (fun q : ℂ × ℂ × ℂ => rctActDS (F_n n) q.1 q.2.1 q.2.2)
          S_curr_fn D_prev_fn T_fn w₀
          (hjet_i.2.2.2.2.1.differentiableAt h_nhds_Q)
          (hSc_holo.differentiableAt hW_nhds)
          (hDp_holo.differentiableAt hW_nhds)
          (hT_holo.differentiableAt hW_nhds)
      exact hDJ_w₀.sub ((ha_fn_holo.differentiableAt hW_nhds).mul hDS_w₀)
  
  · intro n hn W Y_fn T_fn S_fn P_fn hW_open hY_holo hT_holo hS_holo hP_holo hw_all
    have h_at :
        ∀ w₀ ∈ W,
          DifferentiableAt ℂ (fun w => (Ψ n (Y_fn w, T_fn w) (S_fn w, P_fn w)).1) w₀ ∧
          DifferentiableAt ℂ (fun w => (Ψ n (Y_fn w, T_fn w) (S_fn w, P_fn w)).2) w₀ := by
      intro w₀ hw₀
      obtain ⟨i, hi, hYT_w₀⟩ := h_U_cov (Y_fn w₀, T_fn w₀) (hw_all w₀ hw₀).1
      have hn_anch : N_anch i ≤ n :=
        le_trans (Finset.le_sup' N_anch hi)
          (le_trans (le_trans (le_max_left _ _) (le_max_right _ _)) hn)
      obtain ⟨hjet_i, hanch_i⟩ := h_jet_anch i n hn_anch
      let W₀ : Set (ℂ × ℂ) := W ∩ (fun w => (Y_fn w, T_fn w)) ⁻¹' Metric.ball i.1 (ρ i)
      have hW₀_open : IsOpen W₀ :=
        (hY_holo.continuousOn.prodMk hT_holo.continuousOn).isOpen_inter_preimage
          hW_open Metric.isOpen_ball
      have hw₀_mem : w₀ ∈ W₀ := ⟨hw₀, hYT_w₀⟩
      have hW₀_sub : W₀ ⊆ W := Set.inter_subset_left
      have h_on_W₀ :
          ∀ w ∈ W₀,
            (CseInChartDom (S₀ i) (T₀ i) (P₀ i) (μ₀ i) (r_c i) (r_T i) (M_c i)
              (S_fn w) (P_fn w) (T_fn w) ∧
             CseStepSmall (J₀ i) (μ₀ i) (r_c i) (M_c i) (b_seq n) (T_fn w)) ∧
            Ψ n (Y_fn w, T_fn w) (S_fn w, P_fn w) =
              cseChartStep (F_n n) (μ₀ i) (J₀ i) (b_seq n) σ (S_fn w) (P_fn w) (T_fn w) := by
        intro w hw
        rcases hw_all w hw.1 with ⟨hYT_U, hTw_ne, hTw_le, hw_tube⟩
        have hq_mod_near := h_model_near_anchor n hn (Y_fn w) (T_fn w) hYT_U hTw_ne hTw_le
        dsimp only [] at hw_tube hq_mod_near
        have h_anch_2 :
            ‖S_fn w - S_star (Y_fn w, T_fn w)‖ +
              ‖P_fn w - P_anch_fn (Y_fn w, T_fn w)‖ ≤ 2 * r_tube := by
          have h1 :=
            norm_sub_le_norm_sub_add_norm_sub (S_fn w)
              (cseModelState P seq S_star n σ (Y_fn w) (T_fn w)).1
              (S_star (Y_fn w, T_fn w))
          have h2 :=
            norm_sub_le_norm_sub_add_norm_sub (P_fn w)
              (cseModelState P seq S_star n σ (Y_fn w) (T_fn w)).2
              (P_anch_fn (Y_fn w, T_fn w))
          linarith [hr_tube_pos]
        obtain ⟨hdom, hsm, hΨ_eq⟩ :=
          h_in_chart n hn i hi (Y_fn w) (T_fn w) (S_fn w) (P_fn w) hw.2 h_anch_2
        exact ⟨⟨hdom, hsm⟩, hΨ_eq⟩
      obtain ⟨h_holo1_chart, h_holo2_chart⟩ :=
        (hSolver (F_n n) (S₀ i) (J₀ i) (T₀ i) (P₀ i) (μ₀ i)
          (r_c i) (r_T i) (M_c i) (b_seq n) σ
          hjet_i (hr_T_pos i) (hr_T_le i) (hb_pos n) hanch_i).2.2
          W₀ S_fn P_fn T_fn hW₀_open
          (hS_holo.mono hW₀_sub) (hP_holo.mono hW₀_sub) (hT_holo.mono hW₀_sub)
          (fun w hw => (h_on_W₀ w hw).1)
      have h_holo1_W₀ :
          DifferentiableOn ℂ (fun w => (Ψ n (Y_fn w, T_fn w) (S_fn w, P_fn w)).1) W₀ :=
        h_holo1_chart.congr (fun w hw => congrArg Prod.fst (h_on_W₀ w hw).2)
      have h_holo2_W₀ :
          DifferentiableOn ℂ (fun w => (Ψ n (Y_fn w, T_fn w) (S_fn w, P_fn w)).2) W₀ :=
        h_holo2_chart.congr (fun w hw => congrArg Prod.snd (h_on_W₀ w hw).2)
      have hW₀_nhds : W₀ ∈ nhds w₀ := hW₀_open.mem_nhds hw₀_mem
      exact ⟨h_holo1_W₀.differentiableAt hW₀_nhds, h_holo2_W₀.differentiableAt hW₀_nhds⟩
    exact ⟨fun w₀ hw₀ => (h_at w₀ hw₀).1.differentiableWithinAt,
           fun w₀ hw₀ => (h_at w₀ hw₀).2.differentiableWithinAt⟩

theorem corridor_symplectic_step_and_gronwall (X : ExpStripData) (hX : IsExpObstructionStrip X)
    (P : ChordActionPackage X) (kind : ExpProfileKind)
    (seq : ExpSequenceData X kind)
    (hJetEL : RctFrozenJetAndELProp X P kind seq) :
    RctCorridorStepEngineProp X P kind seq :=
by
  intro V_mod S_star K_corr σ T_max L_max hMod hK_comp hK_sub hσ hT_max hL_max hK_T
  obtain ⟨hJ_holo, hEL_all⟩ := hJetEL.model_euler_lagrange V_mod S_star hMod
  obtain ⟨a_max, C_EL, ha_max_pos, hC_EL_pos, hEL_K⟩ := hEL_all K_corr hK_comp hK_sub
  refine ⟨hJ_holo, ⟨a_max, C_EL, ha_max_pos, hC_EL_pos, ?_⟩, ?_⟩
  · intro p hp a ha_pos ha_le
    obtain ⟨hVm1, hVm2, hS1, hS2, hD1, hD2, _⟩ := hEL_K p hp a ha_pos ha_le
    exact ⟨hVm1, hVm2, hS1, hS2, hD1, hD2⟩
  · have h_runChain_add :
        ∀ (Ψ : ℕ → ℂ × ℂ → ℂ × ℂ → ℂ × ℂ) (n d k₁ : ℕ) (Y₀ T : ℂ) (q₀ : ℂ × ℂ),
          let a_n : ℂ := T / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ)
          rctRunCorridorChain seq Ψ σ n (d + k₁) Y₀ T q₀ =
            rctRunCorridorChain seq Ψ σ n k₁
              (Y₀ + (d : ℂ) * (σ : ℂ) * a_n) T
              (rctRunCorridorChain seq Ψ σ n d Y₀ T q₀) := by
      intro Ψ n d k₁ Y₀ T q₀
      dsimp only []
      induction k₁ with
      | zero =>
        simp [rctRunCorridorChain]
      | succ m ih =>
