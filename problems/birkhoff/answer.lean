      fun j hj => (hd_star_weierstrass j hj).1
    have hd_star_tend : ∀ j : ℕ, j ≤ q → ∀ k : ℕ, ∀ z ∈ horizStrip σ_mesh,
        Filter.Tendsto (fun n => iteratedDeriv k (d n j) z) Filter.atTop
          (nhds (iteratedDeriv k (d_star j) z)) :=
      fun j hj => (hd_star_weierstrass j hj).2
    have hd_star_step_tend : ∀ j : ℕ, j < q → ∀ k : ℕ, ∀ z ∈ horizStrip σ_mesh,
        Filter.Tendsto
          (fun n => iteratedDeriv k (fun ζ => d n (j + 1) ζ - d n j ζ) z) Filter.atTop
