    rintro H ⟨⟨U, hU, h0, hH⟩⟩ n
    exact ((hH.contDiffOn hU).contDiffAt (hU.mem_nhds h0)).of_le le_top
  have hTay1D_congr_nhds : ∀ {H₁ H₂ : ℂ → ℂ} {z₀ : ℂ},
      H₁ =ᶠ[nhds z₀] H₂ → holoTaylor1D H₁ z₀ = holoTaylor1D H₂ z₀ := by
    intro H₁ H₂ z₀ hev
    ext n
    simp only [holoTaylor1D, PowerSeries.coeff_mk, hev.iteratedDeriv_eq n]
