            (2 * Real.pi / (q : ℝ) + (d (j + 1) x - d j x)) ^ 2) *
          J_R.a_R w (x + ρ + d (j + 1) x)) := by
      have ht2 := hJet_congr (fun x => (sq _).symm) (hJet_mul ht ht)
      have hs2 := hJet_congr (fun x => (sq _).symm) (hJet_mul hs hs)
      have hts2 := hJet_add ht2 hs2
      have htsa := hJet_mul hts2 ha
