      linarith
    have hd₀_lt_d_init : d₀ < d_init := by
      have h1 : d_cap ≤ min d_init (s_init / 4) := min_le_right _ _
      have h2 : min d_init (s_init / 4) ≤ d_init := min_le_left _ _
      linarith
    have hd₀_lt_s_init_div4 : d₀ < s_init / 4 := by
      have h1 : d_cap ≤ min d_init (s_init / 4) := min_le_right _ _
      have h2 : min d_init (s_init / 4) ≤ s_init / 4 := min_le_right _ _
      linarith
    have hd₀_sq_lt_d₀ : d₀ ^ 2 < d₀ := by nlinarith
    have hM_big_d₀_sq : M_big * d₀ ^ 2 ≤ 1 / 2 := by
      have hd₀_le_inv : d₀ ≤ 1 / (2 * M_big) := min_le_right _ _
      have h1 : M_big * d₀ ^ 2 ≤ M_big * d₀ :=
        mul_le_mul_of_nonneg_left hd₀_sq_lt_d₀.le hM_big_pos.le
      have h2 : M_big * d₀ ≤ M_big * (1 / (2 * M_big)) :=
        mul_le_mul_of_nonneg_left hd₀_le_inv hM_big_pos.le
      have h3 : M_big * (1 / (2 * M_big)) = 1 / 2 := by field_simp
      linarith
    have h_small1 : M_init * d₀ ^ 2 ≤ 1 := by
      have hle : M_init ≤ M_big := by
        have : 0 ≤ G.C_step * K_B ^ B₀ * (2 : ℝ) ^ A_exp := by positivity
        have : 0 ≤ (4 / 3 : ℝ) * G.C_step * K_B ^ B₀ / c_min := by positivity
        linarith
      have : M_init * d₀ ^ 2 ≤ M_big * d₀ ^ 2 :=
        mul_le_mul_of_nonneg_right hle (sq_nonneg d₀)
      linarith
    have h_small2 : G.C_step * K_B ^ B₀ * (2 : ℝ) ^ A_exp * d₀ ^ 2 ≤ 1 := by
      have hle : G.C_step * K_B ^ B₀ * (2 : ℝ) ^ A_exp ≤ M_big := by
        have : 0 ≤ (4 / 3 : ℝ) * G.C_step * K_B ^ B₀ / c_min := by positivity
        linarith
      have : G.C_step * K_B ^ B₀ * (2 : ℝ) ^ A_exp * d₀ ^ 2 ≤ M_big * d₀ ^ 2 :=
