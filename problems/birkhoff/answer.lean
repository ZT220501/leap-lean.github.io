      rcases le_or_gt u 1 with hu_le | hu_gt
      · calc min 1 (sSup (f_tr '' K)) ≤ sSup (f_tr '' K) := min_le_right _ _
          _ ≤ u ^ 2 := htr_le_sq
          _ ≤ u := by nlinarith
      · calc min 1 (sSup (f_tr '' K)) ≤ 1 := min_le_left _ _
          _ ≤ u := le_of_lt hu_gt
    exact ⟨hcont_F, hcont_Full, hF_le_Full, hG_cont, hG_mono, hG_lower, hattains,
