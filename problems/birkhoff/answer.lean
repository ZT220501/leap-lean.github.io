      have hv_ge1 : ((1 : ℕ) : ℝ) ≤ v := by
        rw [Nat.cast_one, le_div_iff₀ hℓ_pos]; linarith
      have hv_le : v ≤ δ_b / ℓ_seq j := div_le_div_of_nonneg_right hs_hi hℓ_pos.le
      have hu_le : |u_re| ≤ (L : ℝ) * v := by
        dsimp only [u_re, v]
        rw [abs_div, abs_of_pos hℓ_pos, ← mul_div_assoc]
        exact div_le_div_of_nonneg_right hs_re hℓ_pos.le
      let m_v : ℕ := Nat.floor v
      have hmv_ge1 : 1 ≤ m_v := Nat.le_floor hv_ge1
      have hmv_ne0 : m_v ≠ 0 := by omega
      have hmv_le_N : m_v ≤ Nat.floor (δ_b / ℓ_seq j) := Nat.floor_mono hv_le
      let k : ℕ := Nat.log 2 m_v
      have hk_le_K : k ≤ K_seq j := Nat.log_mono_right hmv_le_N
      have hk_mem : k ∈ Finset.range (K_seq j + 1) := Finset.mem_range.mpr (Nat.lt_succ_of_le hk_le_K)
      have hv_nn : 0 ≤ v := by positivity
