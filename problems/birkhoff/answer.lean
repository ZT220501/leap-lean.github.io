      IsStripBounded p σ' M_g g₁ →
      IsStripBounded p σ' M_g g₂ →
      (∀ z ∈ horizStrip σ', ‖g₁ z - 1‖ ≤ 1 / 2) →
      (∀ z ∈ horizStrip σ', ‖g₂ z - 1‖ ≤ 1 / 2) →
      IsStripBounded p σ' Δg (fun z => g₁ z - g₂ z) →
      IsStripBounded p σ'
        ((2 : ℝ) ^ p * (((p + 1).factorial : ℝ) * (4 : ℝ) ^ (p + 2)) * shjCompConst p M_g * Δg)
        (fun z => (g₁ z)⁻¹ - (g₂ z)⁻¹) := by
    intro p σ' M_g Δg g₁ g₂ hM_g hΔg hg₁ hg₂ hg₁_half hg₂_half hdg
    have hM_inv_nonneg : 0 ≤ ((p + 1).factorial : ℝ) * (4 : ℝ) ^ (p + 2) := by positivity
    have hZeroBnd : ∀ j : ℕ, j ≤ p → ∀ w ∈ V_inv,
        ‖iteratedDeriv j (fun ζ : ℂ => ζ⁻¹ - ζ⁻¹) w‖ ≤ (0 : ℝ) := by
      intro j _hj w _hw
      have h0 : (fun ζ : ℂ => ζ⁻¹ - ζ⁻¹) = (fun _ : ℂ => (0 : ℂ)) :=
        funext fun ζ => sub_self ζ⁻¹
      rw [h0, iteratedDeriv_const]
      split_ifs <;> simp
    have hCompDiff := h_comp_diff_bound p σ'
      (((p + 1).factorial : ℝ) * (4 : ℝ) ^ (p + 2)) 0 M_g Δg V_inv
      (fun w => w⁻¹) (fun w => w⁻¹) g₁ g₂
      Metric.isOpen_ball (convex_ball (1 : ℂ) (3 / 4))
      hM_inv_nonneg le_rfl hM_g hΔg hInvDiffOn hInvDiffOn
      hZeroBnd (hInvBnd p) hg₁.1 hg₂.1
      (hMapsVinv hg₁_half) (hMapsVinv hg₂_half)
      (fun j _hj1 hjp z hz => hg₁.2 j hjp z hz)
      (fun j _hj1 hjp z hz => hg₂.2 j hjp z hz)
      hdg
    have hEqConst :
        shjCompConst p M_g *
          (0 + (2 : ℝ) ^ p * (((p + 1).factorial : ℝ) * (4 : ℝ) ^ (p + 2)) * Δg) =
        (2 : ℝ) ^ p * (((p + 1).factorial : ℝ) * (4 : ℝ) ^ (p + 2)) *
          shjCompConst p M_g * Δg := by ring
    rw [hEqConst] at hCompDiff
    exact hCompDiff
  exact {
    vert_strip_maps_to := h_vert_strip_maps_to
    stripExt_iteratedDeriv_props := h_stripExt_iteratedDeriv_props
    stripDiffSup_nonneg_and_le := h_stripDiffSup_nonneg_and_le
    real_iteratedDeriv_eq := h_real_iteratedDeriv_eq
    bounded_const := h_bounded_const
    holo_const_real := h_holo_const_real
    bounded_mono := h_bounded_mono
    holo_mono := h_holo_mono
    bounded_add := h_bounded_add
    holo_add := h_holo_add
    bounded_sub := h_bounded_sub
    holo_sub := h_holo_sub
    bounded_neg := h_bounded_neg
    holo_neg := h_holo_neg
    bounded_const_mul := h_bounded_const_mul
    holo_real_mul := h_holo_real_mul
    bounded_mul := h_bounded_mul
    holo_mul := h_holo_mul
    bounded_mul_diff := h_bounded_mul_diff
    holo_inv := h_holo_inv
    bounded_inv_diff := h_bounded_inv_diff
    exp_ball_bound := h_exp_ball_bound
    sin_ball_bound := h_sin_ball_bound
    comp_bound := h_comp_bound
    comp_diff_bound := h_comp_diff_bound
    continuousOn_param_int := h_continuousOn_param_int
    param_int_bound := h_param_int_bound
    param_int_holo := h_param_int_holo
  }

theorem pointwise_taylor_and_real_action_identity : PointwiseTaylorAndRealActionProp :=
by
  have hOpen : ∀ σ : ℝ, IsOpen (horizStrip σ) := by
    intro σ
    exact isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const
  have hRealMem : ∀ {σ : ℝ} (r : ℝ), 0 < σ → (r : ℂ) ∈ horizStrip σ := by
    intro σ r hσ
    change |(r : ℂ).im| < σ
    simpa using hσ
  have hSeg : ∀ {σ : ℝ} {a y : ℂ} {t : ℝ},
      a ∈ horizStrip σ → a + y ∈ horizStrip σ → t ∈ Set.Icc (0 : ℝ) 1 →
      a + (t : ℂ) * y ∈ horizStrip σ := by
    intro σ a y t ha hay ht
    change |a.im| < σ at ha
    change |(a + y).im| < σ at hay
    change |(a + (t : ℂ) * y).im| < σ
    have him : (a + (t : ℂ) * y).im = (1 - t) * a.im + t * (a + y).im := by
      simp [Complex.add_im, Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im]
      ring
    rw [him]
    rcases eq_or_lt_of_le ht.1 with rfl | ht_pos
    · simpa using ha
    · have h1 : 0 ≤ 1 - t := sub_nonneg.mpr ht.2
      have habs : |(1 - t) * a.im + t * (a + y).im| ≤
          (1 - t) * |a.im| + t * |(a + y).im| := by
        calc
          |(1 - t) * a.im + t * (a + y).im| ≤ |(1 - t) * a.im| + |t * (a + y).im| :=
            abs_add_le _ _
          _ = (1 - t) * |a.im| + t * |(a + y).im| := by
            rw [abs_mul, abs_mul, abs_of_nonneg h1, abs_of_pos ht_pos]
      have hlt1 : (1 - t) * |a.im| ≤ (1 - t) * σ :=
        mul_le_mul_of_nonneg_left (le_of_lt ha) h1
      have hlt2 : t * |(a + y).im| < t * σ :=
        mul_lt_mul_of_pos_left hay ht_pos
      linarith
  have hIter : ∀ {σ : ℝ} {W : ℂ → ℂ},
      DifferentiableOn ℂ W (horizStrip σ) →
      ∀ k : ℕ, DifferentiableOn ℂ (iteratedDeriv k W) (horizStrip σ) := by
    intro σ W hW k
    induction k with
    | zero => simpa [iteratedDeriv_zero] using hW
    | succ k ih =>
      rw [iteratedDeriv_succ]
      exact ih.deriv (hOpen σ)
  have hIterDerivAt : ∀ {σ : ℝ} {W : ℂ → ℂ},
      DifferentiableOn ℂ W (horizStrip σ) →
      ∀ (k : ℕ) {z : ℂ}, z ∈ horizStrip σ →
        HasDerivAt (iteratedDeriv k W) (iteratedDeriv (k + 1) W z) z := by
    intro σ W hW k z hz
    rw [iteratedDeriv_succ]
    exact ((hIter hW k).differentiableAt ((hOpen σ).mem_nhds hz)).hasDerivAt
  have hCompAffine : ∀ {f : ℂ → ℂ} {f' X₀ y : ℂ} {s : ℝ},
      HasDerivAt f f' (X₀ + (s : ℂ) * y) →
      HasDerivAt (fun t : ℝ => f (X₀ + (t : ℂ) * y)) (y * f') s := by
    intro f f' X₀ y s hf
    have hC : HasDerivAt (fun z : ℂ => f (X₀ + z * y)) (f' * y) (s : ℂ) := by
      have hz : HasDerivAt (fun z : ℂ => X₀ + z * y) y (s : ℂ) := by
        simpa using ((hasDerivAt_id (s : ℂ)).mul_const y).const_add X₀
      exact hf.comp (s : ℂ) hz
    have hR : HasDerivAt (fun t : ℝ => (t : ℂ)) 1 s := by
      simpa using (hasDerivAt_id s).ofReal_comp
    have hs := hC.scomp s hR
    rw [Function.comp_def] at hs
    simpa [smul_eq_mul, mul_comm] using hs
  have hInt0 : (∫ _ in (0 : ℝ)..1, (1 : ℂ)) = 1 := by
    simp [intervalIntegral.integral_const]
  have hInt1 : (∫ s in (0 : ℝ)..1, (s : ℂ)) = (1 / 2 : ℂ) := by
    have hr : (∫ s in (0 : ℝ)..1, s) = (1 / 2 : ℝ) := by
      have hd : ∀ s ∈ Set.uIcc (0 : ℝ) 1, HasDerivAt (fun t : ℝ => t ^ 2 / 2) s s := by
        intro s _
        convert (hasDerivAt_pow 2 s).div_const (2 : ℝ) using 1
        ring
      rw [intervalIntegral.integral_eq_sub_of_hasDerivAt hd (continuous_id.intervalIntegrable 0 1)]
      norm_num
    have hc := congrArg (fun x : ℝ => (x : ℂ)) hr
    rw [← intervalIntegral.integral_ofReal] at hc
    simpa using hc
  have hInt2 : (∫ s in (0 : ℝ)..1, (s : ℂ) ^ 2) = (1 / 3 : ℂ) := by
    have hr : (∫ s in (0 : ℝ)..1, s ^ 2) = (1 / 3 : ℝ) := by
      have hd : ∀ s ∈ Set.uIcc (0 : ℝ) 1, HasDerivAt (fun t : ℝ => t ^ 3 / 3) (s ^ 2) s := by
        intro s _
        convert (hasDerivAt_pow 3 s).div_const (3 : ℝ) using 1
        ring
      rw [intervalIntegral.integral_eq_sub_of_hasDerivAt hd
        ((continuous_pow 2).intervalIntegrable 0 1)]
      norm_num
    have hc := congrArg (fun x : ℝ => (x : ℂ)) hr
    rw [← intervalIntegral.integral_ofReal] at hc
    simpa [Complex.ofReal_pow] using hc
  have hInt3 : (∫ s in (0 : ℝ)..1, (s : ℂ) ^ 3) = (1 / 4 : ℂ) := by
    have hr : (∫ s in (0 : ℝ)..1, s ^ 3) = (1 / 4 : ℝ) := by
      have hd : ∀ s ∈ Set.uIcc (0 : ℝ) 1, HasDerivAt (fun t : ℝ => t ^ 4 / 4) (s ^ 3) s := by
        intro s _
        convert (hasDerivAt_pow 4 s).div_const (4 : ℝ) using 1
        ring
      rw [intervalIntegral.integral_eq_sub_of_hasDerivAt hd
        ((continuous_pow 3).intervalIntegrable 0 1)]
      norm_num
    have hc := congrArg (fun x : ℝ => (x : ℂ)) hr
    rw [← intervalIntegral.integral_ofReal] at hc
    simpa [Complex.ofReal_pow] using hc
  have hContInt : ∀ (g : ℝ → ℝ → ℂ),
      ContinuousOn (fun p : ℝ × ℝ => g p.1 p.2) (Set.Icc (0 : ℝ) 1 ×ˢ Set.Icc (0 : ℝ) 1) →
      ContinuousOn (fun u : ℝ => ∫ t in (0 : ℝ)..1, g u t) (Set.Icc (0 : ℝ) 1) := by
    intro g hg
    let π : ℝ → ℝ := fun x => (Set.projIcc (0 : ℝ) 1 zero_le_one x : ℝ)
    have hπ_cont : Continuous π := continuous_subtype_val.comp continuous_projIcc
    have hπ_mem : ∀ x : ℝ, π x ∈ Set.Icc (0 : ℝ) 1 :=
      fun x => (Set.projIcc (0 : ℝ) 1 zero_le_one x).2
    have hπ_id : ∀ x ∈ Set.Icc (0 : ℝ) 1, π x = x := by
      intro x hx
      exact congrArg Subtype.val (Set.projIcc_of_mem zero_le_one hx)
    have h_uncurry : Continuous (Function.uncurry (fun u t : ℝ => g (π u) (π t))) :=
      hg.comp_continuous ((hπ_cont.comp continuous_fst).prodMk (hπ_cont.comp continuous_snd))
        (fun p => ⟨hπ_mem p.1, hπ_mem p.2⟩)
    have h_int_cont : Continuous (fun u : ℝ => ∫ t in (0 : ℝ)..1, g (π u) (π t)) :=
      intervalIntegral.continuous_parametric_intervalIntegral_of_continuous' h_uncurry 0 1
    refine h_int_cont.continuousOn.congr ?_
    intro u hu
    apply intervalIntegral.integral_congr
    intro t ht
    dsimp only
    rw [Set.uIcc_of_le zero_le_one] at ht
    rw [hπ_id u hu, hπ_id t ht]
  have hTaylor3 : ∀ (y : ℂ) (F₀ F₁ F₂ F₃ : ℝ → ℂ),
      (∀ s ∈ Set.Icc (0 : ℝ) 1,
        HasDerivAt F₀ (y * F₁ s) s ∧
        HasDerivAt F₁ (y * F₂ s) s ∧
        HasDerivAt F₂ (y * F₃ s) s) →
      ContinuousOn F₃ (Set.Icc (0 : ℝ) 1) →
      F₀ 1 = F₀ 0 + F₁ 0 * y + (1 / 2 : ℂ) * F₂ 0 * y ^ 2 +
        y ^ 3 * ((1 / 2 : ℂ) * ∫ s in (0 : ℝ)..1, ((1 - s : ℝ) : ℂ) ^ 2 * F₃ s) := by
    intro y F₀ F₁ F₂ F₃ hD hF₃
    let P : ℝ → ℂ := fun s =>
      F₀ s + ((1 - s : ℝ) : ℂ) * y * F₁ s +
        (1 / 2 : ℂ) * ((1 - s : ℝ) : ℂ) ^ 2 * y ^ 2 * F₂ s
    let P' : ℝ → ℂ := fun s => y ^ 3 * ((1 / 2 : ℂ) * (((1 - s : ℝ) : ℂ) ^ 2 * F₃ s))
    have hP_deriv : ∀ s ∈ Set.uIcc (0 : ℝ) 1, HasDerivAt P (P' s) s := by
      intro s hs
      rw [Set.uIcc_of_le zero_le_one] at hs
      obtain ⟨hD₀, hD₁, hD₂⟩ := hD s hs
      have h1s : HasDerivAt (fun t : ℝ => ((1 - t : ℝ) : ℂ)) (-1 : ℂ) s := by
        simpa using ((hasDerivAt_const s (1 : ℝ)).sub (hasDerivAt_id s)).ofReal_comp
      have h1s_sq : HasDerivAt (fun t : ℝ => ((1 - t : ℝ) : ℂ) ^ 2)
          ((-1 : ℂ) * ((1 - s : ℝ) : ℂ) + ((1 - s : ℝ) : ℂ) * (-1 : ℂ)) s := by
        simpa [sq, Pi.mul_def] using h1s.mul h1s
      have hTerm1 : HasDerivAt (fun t : ℝ => ((1 - t : ℝ) : ℂ) * y * F₁ t)
          (((-1 : ℂ) * y) * F₁ s + (((1 - s : ℝ) : ℂ) * y) * (y * F₂ s)) s :=
        (h1s.mul_const y).mul hD₁
      have hTerm2 : HasDerivAt
          (fun t : ℝ => (1 / 2 : ℂ) * ((1 - t : ℝ) : ℂ) ^ 2 * y ^ 2 * F₂ t)
          (((1 / 2 : ℂ) * ((-1 : ℂ) * ((1 - s : ℝ) : ℂ) + ((1 - s : ℝ) : ℂ) * (-1 : ℂ)) * y ^ 2) * F₂ s +
            ((1 / 2 : ℂ) * ((1 - s : ℝ) : ℂ) ^ 2 * y ^ 2) * (y * F₃ s)) s :=
        ((h1s_sq.const_mul (1 / 2 : ℂ)).mul_const (y ^ 2)).mul hD₂
      convert (hD₀.add hTerm1).add hTerm2 using 1
      dsimp [P']
      ring
    have hP'_cont : ContinuousOn P' (Set.uIcc (0 : ℝ) 1) := by
      rw [Set.uIcc_of_le zero_le_one]
      have hsub : ContinuousOn (fun s : ℝ => ((1 - s : ℝ) : ℂ) ^ 2) (Set.Icc (0 : ℝ) 1) :=
        ((Complex.continuous_ofReal.comp (continuous_const.sub continuous_id)).pow 2).continuousOn
      exact continuousOn_const.mul (continuousOn_const.mul (hsub.mul hF₃))
    have hFTC : (∫ s in (0 : ℝ)..1, P' s) = P 1 - P 0 :=
      intervalIntegral.integral_eq_sub_of_hasDerivAt hP_deriv hP'_cont.intervalIntegrable
    have hPull : (∫ s in (0 : ℝ)..1, P' s) =
        y ^ 3 * ((1 / 2 : ℂ) * ∫ s in (0 : ℝ)..1, ((1 - s : ℝ) : ℂ) ^ 2 * F₃ s) := by
      dsimp [P']
      rw [intervalIntegral.integral_const_mul, intervalIntegral.integral_const_mul]
    have hP1 : P 1 = F₀ 1 := by
      dsimp [P]
      norm_num
    have hP0 : P 0 = F₀ 0 + F₁ 0 * y + (1 / 2 : ℂ) * F₂ 0 * y ^ 2 := by
      dsimp [P]
      norm_num
      ring
    rw [hPull, hP1, hP0] at hFTC
    linear_combination -hFTC
  have hExpSlope : ∀ {σ : ℝ} {W : ℂ → ℂ} {X₀ y : ℂ},
      DifferentiableOn ℂ W (horizStrip σ) →
      X₀ ∈ horizStrip σ →
      X₀ + y ∈ horizStrip σ →
      y * expSlope_C W X₀ y = Complex.exp (W (X₀ + y) - W X₀) - 1 := by
    intro σ W X₀ y hW hX₀ hXy
    let γ : ℝ → ℂ := fun s => Complex.exp (W (X₀ + (s : ℂ) * y) - W X₀)
    let γ' : ℝ → ℂ := fun s =>
      y * (deriv W (X₀ + (s : ℂ) * y) * Complex.exp (W (X₀ + (s : ℂ) * y) - W X₀))
    have hγ_deriv : ∀ s ∈ Set.uIcc (0 : ℝ) 1, HasDerivAt γ (γ' s) s := by
      intro s hs
      rw [Set.uIcc_of_le zero_le_one] at hs
      let zs : ℂ := X₀ + (s : ℂ) * y
      have hzs : zs ∈ horizStrip σ := hSeg hX₀ hXy hs
      have hW_at : HasDerivAt W (deriv W zs) zs :=
        (hW.differentiableAt ((hOpen σ).mem_nhds hzs)).hasDerivAt
      have hW_sub : HasDerivAt (fun z : ℂ => Complex.exp (W z - W X₀))
          (Complex.exp (W zs - W X₀) * deriv W zs) zs := by
        simpa [Function.comp_def] using
          HasDerivAt.comp zs (Complex.hasDerivAt_exp (W zs - W X₀)) (hW_at.sub_const (W X₀))
      convert hCompAffine hW_sub using 1
      dsimp [γ', zs]
      ring
    have hγ'_cont : ContinuousOn γ' (Set.uIcc (0 : ℝ) 1) := by
      rw [Set.uIcc_of_le zero_le_one]
      have hAff_cont : Continuous (fun s : ℝ => X₀ + (s : ℂ) * y) :=
        continuous_const.add (Complex.continuous_ofReal.mul continuous_const)
      have hAff_maps : Set.MapsTo (fun s : ℝ => X₀ + (s : ℂ) * y)
          (Set.Icc (0 : ℝ) 1) (horizStrip σ) :=
        fun s hs => hSeg hX₀ hXy hs
      have hdW_cont : ContinuousOn (fun s : ℝ => deriv W (X₀ + (s : ℂ) * y))
          (Set.Icc (0 : ℝ) 1) :=
        ((hW.deriv (hOpen σ)).continuousOn).comp hAff_cont.continuousOn hAff_maps
      have hW_cont : ContinuousOn (fun s : ℝ => W (X₀ + (s : ℂ) * y))
          (Set.Icc (0 : ℝ) 1) :=
        hW.continuousOn.comp hAff_cont.continuousOn hAff_maps
      have hexp_cont : ContinuousOn (fun s : ℝ => Complex.exp (W (X₀ + (s : ℂ) * y) - W X₀))
          (Set.Icc (0 : ℝ) 1) :=
        Complex.continuous_exp.comp_continuousOn (hW_cont.sub continuousOn_const)
      exact continuousOn_const.mul (hdW_cont.mul hexp_cont)
    have hFTC : (∫ s in (0 : ℝ)..1, γ' s) = γ 1 - γ 0 :=
      intervalIntegral.integral_eq_sub_of_hasDerivAt hγ_deriv hγ'_cont.intervalIntegrable
    have hLHS : (∫ s in (0 : ℝ)..1, γ' s) = y * expSlope_C W X₀ y := by
      dsimp [γ', expSlope_C]
      exact intervalIntegral.integral_const_mul y _
    have hRHS : γ 1 - γ 0 = Complex.exp (W (X₀ + y) - W X₀) - 1 := by
      dsimp [γ]
      simp
    rw [hLHS, hRHS] at hFTC
    exact hFTC
  have hMidIff : ∀ (σ : ℝ) (W : ℂ → ℂ) (X₀ T₀ z₀ : ℂ),
      0 < σ →
      DifferentiableOn ℂ W (horizStrip σ) →
      X₀ ∈ horizStrip σ →
      X₀ + T₀ ∈ horizStrip σ →
      X₀ + T₀ * z₀ ∈ horizStrip σ →
      (z₀ - (1 / 2 : ℂ) = midStepOp_C W X₀ T₀ (z₀ - (1 / 2 : ℂ)) ↔
        z₀ * (∫ θ in (0 : ℝ)..1, Complex.exp (W (X₀ + (θ : ℂ) * T₀ * z₀) - W X₀)) =
          (1 / 2 : ℂ) * (∫ v in (0 : ℝ)..1, Complex.exp (W (X₀ + (v : ℂ) * T₀) - W X₀))) := by
    intro σ W X₀ T₀ z₀ _hσ hW hX₀ hXT₀ hXTz₀
    have hAffCont : ∀ y : ℂ, X₀ + y ∈ horizStrip σ →
        ContinuousOn (fun s : ℝ => Complex.exp (W (X₀ + (s : ℂ) * y) - W X₀))
          (Set.uIcc (0 : ℝ) 1) := by
      intro y hXy
      rw [Set.uIcc_of_le zero_le_one]
      have hAff : Continuous (fun s : ℝ => X₀ + (s : ℂ) * y) :=
        continuous_const.add (Complex.continuous_ofReal.mul continuous_const)
      have hW_c : ContinuousOn (fun s : ℝ => W (X₀ + (s : ℂ) * y)) (Set.Icc (0 : ℝ) 1) :=
        hW.continuousOn.comp hAff.continuousOn (fun s hs => hSeg hX₀ hXy hs)
      exact Complex.continuous_exp.comp_continuousOn (hW_c.sub continuousOn_const)
    have hJ1 : T₀ * (∫ v in (0 : ℝ)..1, (v : ℂ) * expSlope_C W X₀ ((v : ℂ) * T₀)) =
        (∫ v in (0 : ℝ)..1, Complex.exp (W (X₀ + (v : ℂ) * T₀) - W X₀)) - 1 := by
      rw [← intervalIntegral.integral_const_mul]
      have hCongr :
          (∫ v in (0 : ℝ)..1, T₀ * ((v : ℂ) * expSlope_C W X₀ ((v : ℂ) * T₀))) =
            ∫ v in (0 : ℝ)..1, (Complex.exp (W (X₀ + (v : ℂ) * T₀) - W X₀) - 1) := by
        apply intervalIntegral.integral_congr
        intro v hv
        dsimp only
        rw [Set.uIcc_of_le zero_le_one] at hv
        have hmul : T₀ * ((v : ℂ) * expSlope_C W X₀ ((v : ℂ) * T₀)) =
            ((v : ℂ) * T₀) * expSlope_C W X₀ ((v : ℂ) * T₀) := by ring
        rw [hmul]
        exact hExpSlope hW hX₀ (hSeg hX₀ hXT₀ hv)
      rw [hCongr, intervalIntegral.integral_sub (hAffCont T₀ hXT₀).intervalIntegrable
        continuousOn_const.intervalIntegrable, hInt0]
    have hJ2 : (T₀ * z₀) *
          (∫ θ in (0 : ℝ)..1, (θ : ℂ) * expSlope_C W X₀ ((θ : ℂ) * T₀ * z₀)) =
        (∫ θ in (0 : ℝ)..1, Complex.exp (W (X₀ + (θ : ℂ) * T₀ * z₀) - W X₀)) - 1 := by
      rw [← intervalIntegral.integral_const_mul]
      have hCongr :
          (∫ θ in (0 : ℝ)..1,
              (T₀ * z₀) * ((θ : ℂ) * expSlope_C W X₀ ((θ : ℂ) * T₀ * z₀))) =
