          hV₀ hV₀_ne (Set.Subset.trans hV₀_sub hB_sub)
          (h_mvpoly_holo (ssbpcBaseJetEnv C M k is_point) Disc h_env_holo)
          h_all q_w hqw_mem
        exact hqw_Disc h_z
