        exact le_trans h_comb h_Lin
      obtain ⟨hw_strip, hwf, hwq⟩ := hShape w hw_ge_d10 hw_le_54δ hw_re_le
      have hw_rpow_le : (h_ref - w.im) ^ (-α) ≤ 2 * D_0 ^ (-α) := by
        have h_half_pos : 0 < D_0 / 2 := div_pos hD0_pos (by norm_num)
        have h_half_le : D_0 / 2 ≤ h_ref - w.im := by linarith only [hD0_pos, hw_dep_lo]
        have h1 : (h_ref - w.im) ^ (-α) ≤ (D_0 / 2) ^ (-α) :=
          Real.rpow_le_rpow_of_nonpos h_half_pos h_half_le (by linarith only [hα_pos])
        have h2 : (D_0 / 2) ^ (-α) = (2 : ℝ) ^ α * D_0 ^ (-α) := by
          rw [Real.rpow_neg h_half_pos.le α, Real.div_rpow hD0_pos.le (by norm_num) α,
            inv_div, div_eq_mul_inv, ← Real.rpow_neg hD0_pos.le α]
        have h3 : (2 : ℝ) ^ α ≤ 2 := by
          calc (2 : ℝ) ^ α
              ≤ (2 : ℝ) ^ (1 : ℝ) :=
                Real.rpow_le_rpow_of_exponent_le (by norm_num) hα2.le
            _ = 2 := Real.rpow_one 2
        have h4 : (2 : ℝ) ^ α * D_0 ^ (-α) ≤ 2 * D_0 ^ (-α) :=
          mul_le_mul_of_nonneg_right h3 (Real.rpow_pos_of_pos hD0_pos (-α)).le
        rw [h2] at h1
        exact le_trans h1 h4
      have hM_scale_le : M_scale * (h_ref - w.im) ^ (-α) ≤ M_0 := by
        have hmul := mul_le_mul_of_nonneg_left hw_rpow_le hM.le
        dsimp only [M_0]
        linarith only [hmul]
      exact ⟨hw_strip, le_trans hwf hM_scale_le, le_trans hwq hM_scale_le⟩
    obtain ⟨hp_holo, _, hp_rem⟩ :=
      P.small_field z_0 r_s r_t M_0 hr_s_pos hr_t_pos h4rt_le_rs hM_0_pos.le hrt_M0_le
        (fun w hw => (h_ball_cone w hw).1)
        (fun w hw => ⟨(h_ball_cone w hw).2.1, (h_ball_cone w hw).2.2⟩)
    let M_a : ℝ := 4 * P.C_sf * ‖t‖ ^ 2 * M_scale ^ 2 * D_0 ^ (-2 * α)
    have hM_a_nonneg : 0 ≤ M_a := by
      dsimp only [M_a]
      exact mul_nonneg
        (mul_nonneg (mul_nonneg (mul_nonneg (by norm_num) hC_sf_pos.le) (sq_nonneg ‖t‖))
          (sq_nonneg M_scale))
        (Real.rpow_pos_of_pos hD0_pos (-2 * α)).le
    have hD0_sq_rpow : (D_0 ^ (-α)) ^ (2 : ℕ) = D_0 ^ (-2 * α) := by
      rw [← Real.rpow_natCast (D_0 ^ (-α)) 2, ← Real.rpow_mul hD0_pos.le (-α) (2 : ℕ)]
      congr 1
      push_cast
      ring
    have hp_rem_Ma : ∀ s' J' : ℂ,
        ‖s' - z_0‖ < r_s / 4 → ‖J' - 1‖ < 1 / 4 →
        ‖refSteepActionA P s' J' t‖ ≤ M_a := by
      intro s' J' hs' hJ'
      have h_raw := hp_rem s' J' t hs' hJ' ht_lt_rt
      have h_eq : P.C_sf * ‖t‖ ^ 2 * M_0 ^ 2 = M_a := by
        dsimp only [M_0, M_a]
        calc P.C_sf * ‖t‖ ^ 2 * (2 * M_scale * D_0 ^ (-α)) ^ 2
            = 4 * P.C_sf * ‖t‖ ^ 2 * M_scale ^ 2 * (D_0 ^ (-α)) ^ (2 : ℕ) := by ring
          _ = 4 * P.C_sf * ‖t‖ ^ 2 * M_scale ^ 2 * D_0 ^ (-2 * α) := by rw [hD0_sq_rpow]
      rwa [h_eq] at h_raw
    
    let ρ_s : ℝ := D_0 / 256
    have hρ_s_pos : 0 < ρ_s := div_pos hD0_pos (by norm_num)
    have hsm_z0_9 : ‖s_m - z_0‖ < (9 / 1280) * D_0 := by
      have h_split : s_m - z_0 = (s_m - (z_0 - t)) - t := by ring
      have h_tri : ‖s_m - z_0‖ ≤ ‖s_m - (z_0 - t)‖ + ‖t‖ := by
        rw [h_split]
        exact norm_sub_le _ _
      linarith only [h_tri, hsm_disp, hDm_lt_2D0, ht_lt_D0320]
    have hs0_z0_9 : ‖s_0 - z_0‖ < (9 / 1280) * D_0 := by
      linarith only [hs0_disp, hD0_pos]
    have hsm_lt_rs8 : ‖s_m - z_0‖ < r_s / 8 := by
      dsimp only [r_s]
      linarith only [hsm_z0_9, hD0_pos]
    have hs0_lt_rs8 : ‖s_0 - z_0‖ < r_s / 8 := by
      dsimp only [r_s]
      linarith only [hs0_z0_9, hD0_pos]
    have h_seg_ball : ∀ θ ∈ Set.Icc (0 : ℝ) 1,
        ∀ s' ∈ Metric.closedBall ((1 - (θ : ℂ)) * s_m + (θ : ℂ) * s_0) ρ_s,
          ‖s' - z_0‖ < r_s / 8 ∧
          ∀ J' ∈ Metric.closedBall (1 : ℂ) (3 / 32),
            ‖refSteepActionA P s' J' t‖ ≤ M_a := by
      intro θ hθ s' hs'
      set σ : ℂ := (1 - (θ : ℂ)) * s_m + (θ : ℂ) * s_0
      have hσ_sub : σ - z_0 = ((1 - θ : ℝ) : ℂ) * (s_m - z_0) + (θ : ℂ) * (s_0 - z_0) := by
        dsimp only [σ]
        push_cast
        ring
      have h1θ_nonneg : 0 ≤ 1 - θ := sub_nonneg.mpr hθ.2
      have hσ_norm : ‖σ - z_0‖ ≤ (9 / 1280) * D_0 := by
        have h_tri : ‖σ - z_0‖ ≤
            ‖((1 - θ : ℝ) : ℂ) * (s_m - z_0)‖ + ‖(θ : ℂ) * (s_0 - z_0)‖ := by
          rw [hσ_sub]
          exact norm_add_le _ _
        rw [norm_mul, norm_mul, Complex.norm_real, Complex.norm_real,
          Real.norm_eq_abs, Real.norm_eq_abs,
          abs_of_nonneg h1θ_nonneg, abs_of_nonneg hθ.1] at h_tri
        have h1 : (1 - θ) * ‖s_m - z_0‖ ≤ (1 - θ) * ((9 / 1280) * D_0) :=
          mul_le_mul_of_nonneg_left hsm_z0_9.le h1θ_nonneg
        have h2 : θ * ‖s_0 - z_0‖ ≤ θ * ((9 / 1280) * D_0) :=
          mul_le_mul_of_nonneg_left hs0_z0_9.le hθ.1
        linarith only [h_tri, h1, h2]
      have hs'_σ : ‖s' - σ‖ ≤ D_0 / 256 := by
        simpa only [Metric.mem_closedBall, dist_eq_norm, ρ_s] using hs'
      have hs'_z0 : ‖s' - z_0‖ < r_s / 8 := by
        have h_split : s' - z_0 = (s' - σ) + (σ - z_0) := by ring
        have h_tri : ‖s' - z_0‖ ≤ ‖s' - σ‖ + ‖σ - z_0‖ := by
          rw [h_split]
          exact norm_add_le _ _
        dsimp only [r_s]
        linarith only [h_tri, hs'_σ, hσ_norm, hD0_pos]
      refine ⟨hs'_z0, ?_⟩
      intro J' hJ'
      have hJ'_norm : ‖J' - 1‖ ≤ 3 / 32 := by
        simpa only [Metric.mem_closedBall, dist_eq_norm] using hJ'
      exact hp_rem_Ma s' J'
        (lt_trans hs'_z0 (by linarith only [hr_s_pos]))
        (lt_of_le_of_lt hJ'_norm (by norm_num))
    obtain ⟨h_derivG, h_DS, h_DJ_diff⟩ :=
      hJets.2.2.2 z_0 r_s r_t ρ_s M_a s_m s_0 J_m t
        hr_s_pos hr_t_pos hρ_s_pos hM_a_nonneg hp_holo hJm ht_lt_rt h_seg_ball
    
    let Λ_0 : ℝ := ‖t‖ * M_scale * D_0 ^ (-α)
    have hΛ_0_pos : 0 < Λ_0 :=
      mul_pos (mul_pos ht_norm_pos hM) (Real.rpow_pos_of_pos hD0_pos (-α))
    have hΛ_0_le : Λ_0 ≤ 10 * η_adm := by
      have h_rpow_le : D_0 ^ (-α) ≤ D_plus ^ (-α) :=
        Real.rpow_le_rpow_of_nonpos hDp_pos hDp_lt_D0.le (by linarith only [hα_pos])
      have h1 : Λ_0 ≤ ‖t‖ * M_scale * D_plus ^ (-α) :=
        mul_le_mul_of_nonneg_left h_rpow_le (mul_pos ht_norm_pos hM).le
      have h2 : ‖t‖ * M_scale * D_plus ^ (-α) ≤
          (10 * r * (D_plus / d) ^ α) * M_scale * D_plus ^ (-α) :=
        mul_le_mul_of_nonneg_right
          (mul_le_mul_of_nonneg_right ht_norm.le hM.le)
          (Real.rpow_pos_of_pos hDp_pos (-α)).le
      have h3 : (10 * r * (D_plus / d) ^ α) * M_scale * D_plus ^ (-α) =
          10 * (r * d ^ (-α) * M_scale) := by
        rw [Real.div_rpow hDp_pos.le hd.le α,
          Real.rpow_neg hDp_pos.le α, Real.rpow_neg hd.le α]
        have hne1 : D_plus ^ α ≠ 0 := (Real.rpow_pos_of_pos hDp_pos α).ne'
        have hne2 : d ^ α ≠ 0 := (Real.rpow_pos_of_pos hd α).ne'
        field_simp [hne1, hne2]
      rw [h3] at h2
      linarith only [h1, h2, hrM]
    have hMa_le : M_a ≤ 400 / 60000000 := by
      have hMa_eq : M_a = 4 * P.C_sf * Λ_0 ^ 2 := by
        dsimp only [M_a, Λ_0]
        calc 4 * P.C_sf * ‖t‖ ^ 2 * M_scale ^ 2 * D_0 ^ (-2 * α)
            = 4 * P.C_sf * ‖t‖ ^ 2 * M_scale ^ 2 * (D_0 ^ (-α)) ^ (2 : ℕ) := by
                rw [hD0_sq_rpow]
          _ = 4 * P.C_sf * (‖t‖ * M_scale * D_0 ^ (-α)) ^ 2 := by ring
      have hΛ_sq : Λ_0 ^ 2 ≤ 100 * η_adm ^ 2 := by
        have h_pow : Λ_0 ^ 2 ≤ (10 * η_adm) ^ 2 :=
          pow_le_pow_left₀ hΛ_0_pos.le hΛ_0_le 2
        linarith only [h_pow]
      have hη_sq : η_adm ^ 2 ≤ η_adm := by
        have hη_le_one : η_adm ≤ 1 := by linarith only [hη_adm_le_6400]
        nlinarith only [hη_adm_pos, hη_le_one]
      have h1 : M_a ≤ 400 * (P.C_sf * η_adm) := by
        rw [hMa_eq]
        have hΛ_le_100η : Λ_0 ^ 2 ≤ 100 * η_adm := by linarith only [hΛ_sq, hη_sq]
        have hmul := mul_le_mul_of_nonneg_left hΛ_le_100η
          (mul_pos (by norm_num : (0 : ℝ) < 4) hC_sf_pos).le
        linarith only [hmul]
      linarith only [h1, hC_sf_η_le]
    have ht_div_ρs : ‖t‖ / ρ_s ≤ 4 / 5 := by
      refine (div_le_iff₀ hρ_s_pos).mpr ?_
      dsimp only [ρ_s]
      linarith only [ht_lt_D0320]
    have h_tMa_div_ρs : ‖t‖ * M_a / ρ_s ≤ (4 / 5) * M_a := by
      have h_eq : ‖t‖ * M_a / ρ_s = (‖t‖ / ρ_s) * M_a := by ring
      rw [h_eq]
      exact mul_le_mul_of_nonneg_right ht_div_ρs hM_a_nonneg
    have h_derivG_bound : ∀ J ∈ Metric.closedBall J_m (1 / 32),
        ‖deriv (refSteepPerturbG P s_0 t) J‖ ≤ 1 / 32 := by
      intro J hJ
      have h1 := h_derivG J hJ
      have h2 : 64 * ‖t‖ * M_a / ρ_s ≤ 64 * M_a := by
        have h_eq : 64 * ‖t‖ * M_a / ρ_s = 64 * (‖t‖ * M_a / ρ_s) := by ring
        rw [h_eq]
        linarith only [h_tMa_div_ρs, hM_a_nonneg]
      linarith only [h1, h2, hMa_le]
    have hs0_sm_le : ‖s_0 - s_m‖ ≤ 2 * ‖t‖ := by
      have h_prod : s_0 - s_m = t * J_m := by
        dsimp only [J_m]
        field_simp [ht_ne]
      have hJm_norm : ‖J_m‖ ≤ 2 := by
        have h_split : J_m = (J_m - 1) + 1 := by ring
        have h_tri : ‖J_m‖ ≤ ‖J_m - 1‖ + ‖(1 : ℂ)‖ := by
          nth_rw 1 [h_split]
          exact norm_add_le _ _
        rw [norm_one] at h_tri
        linarith only [h_tri, hJm]
      rw [h_prod, norm_mul]
      have hmul := mul_le_mul_of_nonneg_left hJm_norm ht_norm_pos.le
      linarith only [hmul]
    have h_res_65 : ‖refSteepResidual P s_m J_m s_0 t J_m‖ ≤ 65 * ‖t‖ * M_a / ρ_s := by
      have h_res_eq : refSteepResidual P s_m J_m s_0 t J_m =
          (refSteepActionDJ P s_0 J_m t - refSteepActionDJ P s_m J_m t) -
            t * refSteepActionDS P s_0 J_m t := by
        unfold refSteepResidual refSteepPerturbG
        ring
      have h_tri : ‖refSteepResidual P s_m J_m s_0 t J_m‖ ≤
          ‖refSteepActionDJ P s_0 J_m t - refSteepActionDJ P s_m J_m t‖ +
            ‖t‖ * ‖refSteepActionDS P s_0 J_m t‖ := by
        rw [h_res_eq]
        refine le_trans (norm_sub_le _ _) ?_
        rw [norm_mul]
      have h_term1 : (32 * M_a / ρ_s) * ‖s_0 - s_m‖ ≤ 64 * ‖t‖ * M_a / ρ_s := by
        have hmul := mul_le_mul_of_nonneg_left hs0_sm_le
          (div_nonneg (mul_nonneg (by norm_num : (0 : ℝ) ≤ 32) hM_a_nonneg) hρ_s_pos.le)
        have h_alg : (32 * M_a / ρ_s) * (2 * ‖t‖) = 64 * ‖t‖ * M_a / ρ_s := by ring
        rwa [h_alg] at hmul
      have h_term2 : ‖t‖ * ‖refSteepActionDS P s_0 J_m t‖ ≤ ‖t‖ * M_a / ρ_s := by
        have hmul := mul_le_mul_of_nonneg_left h_DS ht_norm_pos.le
        have h_alg : ‖t‖ * (M_a / ρ_s) = ‖t‖ * M_a / ρ_s := by ring
        rwa [h_alg] at hmul
      have h1 := le_trans h_DJ_diff h_term1
      have h_sum : 64 * ‖t‖ * M_a / ρ_s + ‖t‖ * M_a / ρ_s = 65 * ‖t‖ * M_a / ρ_s := by ring
      linarith only [h_tri, h1, h_term2, h_sum]
    have h_res_contr : ‖refSteepResidual P s_m J_m s_0 t J_m‖ ≤ 1 / 256 := by
      have h1 : 65 * ‖t‖ * M_a / ρ_s ≤ 52 * M_a := by
        have h_eq : 65 * ‖t‖ * M_a / ρ_s = 65 * (‖t‖ * M_a / ρ_s) := by ring
        rw [h_eq]
        linarith only [h_tMa_div_ρs]
      linarith only [h_res_65, h1, hMa_le]
    have h_contractive : IsRefSteepContractivePt X P s_m s_0 t :=
      ⟨ht_ne, hJm,
        ⟨z_0, r_s, r_t, hr_s_pos, hr_t_pos, hp_holo, hsm_lt_rs8, hs0_lt_rs8, ht_lt_rt⟩,
        h_derivG_bound, h_res_contr⟩
    have h_res_power :
        8 * ‖refSteepResidual P s_m J_m s_0 t J_m‖ ≤
          C_res * ‖t‖ ^ 3 * M_scale ^ 2 * D_0 ^ (-2 * α - 1) := by
      have h8 : 8 * ‖refSteepResidual P s_m J_m s_0 t J_m‖ ≤ 520 * ‖t‖ * M_a / ρ_s := by
        have h_alg : 8 * (65 * ‖t‖ * M_a / ρ_s) = 520 * ‖t‖ * M_a / ρ_s := by ring
        linarith only [h_res_65, h_alg]
      have h_exact : 520 * ‖t‖ * M_a / ρ_s =
          C_res * ‖t‖ ^ 3 * M_scale ^ 2 * D_0 ^ (-2 * α - 1) := by
        dsimp only [M_a, ρ_s, C_res]
        have h1 : 520 * ‖t‖ * (4 * P.C_sf * ‖t‖ ^ 2 * M_scale ^ 2 * D_0 ^ (-2 * α)) /
            (D_0 / 256) =
            532480 * P.C_sf * ‖t‖ ^ 3 * M_scale ^ 2 * (D_0 ^ (-2 * α) * D_0⁻¹) := by
          field_simp [hD0_pos.ne']
          norm_num
        have h2 : D_0 ^ (-2 * α) * D_0⁻¹ = D_0 ^ (-2 * α - 1) := by
          rw [← Real.rpow_neg_one D_0, ← Real.rpow_add hD0_pos (-2 * α) (-1)]
          congr 1
        rw [h1, h2]
      rwa [h_exact] at h8
    exact ⟨h_contractive, h_res_power⟩

theorem ref_upward_steep_sector_passage (X : ExpStripData) (P : ChordActionPackage X)
    (hSolver : RefSteepSolverProp X P)
    (hAdm : RefSteepStepAdmProp X P) :
    RefUpwardSteepProp X P :=
by
  have hMesh := hAdm.1
  obtain ⟨η_adm, C_res, hη_adm_pos, hη_adm_le, hC_res_pos, hStep_all⟩ := hAdm.2.2
  intro α γ_steep hα1 hα2 hγ1 hγ2
  have hα_pos : 0 < α := by linarith only [hα1]
  have h2α_sub_pos : 0 < 2 * α - 1 := by linarith only [hα1]
  let C_J : ℝ := 1 + C_res / (2 * α * γ_steep)
  let C_st : ℝ := 1 + C_J * (1 + 1 / ((2 * α - 1) * γ_steep))
  let η_st : ℝ := min η_adm (1 / (60000 * C_st))
  have hCJ_gt_one : 1 < C_J := by
    have : 0 < C_res / (2 * α * γ_steep) := by positivity
    dsimp only [C_J]
    linarith only [this]
  have hCJ_pos : 0 < C_J := by linarith only [hCJ_gt_one]
  have hCst_gt_CJ : C_J < C_st := by
    have hfrac_pos : 0 < 1 / ((2 * α - 1) * γ_steep) := by positivity
    have hmul_gt : C_J < C_J * (1 + 1 / ((2 * α - 1) * γ_steep)) :=
      lt_mul_of_one_lt_right hCJ_pos (by linarith only [hfrac_pos])
    dsimp only [C_st]
    linarith only [hmul_gt]
  have hCst_ge_one : 1 ≤ C_st := by linarith only [hCJ_gt_one, hCst_gt_CJ]
  have hCst_pos : 0 < C_st := by linarith only [hCst_ge_one]
  have hη_st_pos : 0 < η_st := lt_min hη_adm_pos (by positivity)
  have hη_st_le_adm : η_st ≤ η_adm := min_le_left _ _
  have hη_st_le_6400 : η_st ≤ 1 / 6400 := le_trans hη_st_le_adm hη_adm_le
  have hη_st_lt_16 : η_st < 1 / 16 := by linarith only [hη_st_le_6400]
  have hη_st_le_one : η_st ≤ 1 := by linarith only [hη_st_le_6400]
  have hη_st_sq_le : η_st ^ 2 ≤ η_st := by
    calc η_st ^ 2 = η_st * η_st := sq η_st
      _ ≤ 1 * η_st := mul_le_mul_of_nonneg_right hη_st_le_one hη_st_pos.le
      _ = η_st := one_mul η_st
  have h100_Cst_η2 : 100 * C_st * η_st ^ 2 ≤ 1 / 600 := by
    have hη_le_inv : η_st ≤ 1 / (60000 * C_st) := min_le_right _ _
    have hCst_η : C_st * η_st ≤ 1 / 60000 := by
      calc C_st * η_st ≤ C_st * (1 / (60000 * C_st)) :=
            mul_le_mul_of_nonneg_left hη_le_inv hCst_pos.le
        _ = 1 / 60000 := by
            have hne : C_st ≠ 0 := hCst_pos.ne'
            field_simp [hne]
    calc 100 * C_st * η_st ^ 2 = 100 * (C_st * η_st ^ 2) := by ring
      _ ≤ 100 * (C_st * η_st) :=
          mul_le_mul_of_nonneg_left
            (mul_le_mul_of_nonneg_left hη_st_sq_le hCst_pos.le) (by norm_num)
      _ ≤ 100 * (1 / 60000) := mul_le_mul_of_nonneg_left hCst_η (by norm_num)
      _ = 1 / 600 := by norm_num
  have h100_Cst_512 : 100 * C_st * η_st ^ 2 ≤ 1 / 512 := by linarith only [h100_Cst_η2]
  have h100_CJ_32 : 100 * C_J * η_st ^ 2 ≤ 1 / 32 := by
    have hle : 100 * C_J * η_st ^ 2 ≤ 100 * C_st * η_st ^ 2 := by
      have h1 : 100 * C_J ≤ 100 * C_st := by linarith only [hCst_gt_CJ]
      exact mul_le_mul_of_nonneg_right h1 (sq_nonneg η_st)
    linarith only [hle, h100_Cst_η2]
  have h100_η2_64 : 100 * η_st ^ 2 ≤ 1 / 64 := by
    have hle : 100 * η_st ^ 2 ≤ 100 * C_st * η_st ^ 2 := by
      have h1 : (100 : ℝ) ≤ 100 * C_st := by linarith only [hCst_ge_one]
      simpa only [mul_assoc] using mul_le_mul_of_nonneg_right h1 (sq_nonneg η_st)
    linarith only [hle, h100_Cst_η2]
  refine ⟨C_st, η_st, hCst_ge_one, hη_st_pos, hη_st_lt_16, ?_⟩
  intro x₀ h_ref m_steep d δ_ceil Δ_slab r M_scale C_init s_init
    hm hd hΔ h2Δ h4d hr hM hCinit h12r hrd hrM hAbs
    L_in S_init W_up
    hShape hs_init_holo hs_init_bound hs_init_rec
  have hδ_pos : 0 < δ_ceil := by linarith only [hΔ, h2Δ]
  have hrd_adm : r / d ≤ η_adm := le_trans hrd hη_st_le_adm
  have hrM_adm : r * d ^ (-α) * M_scale ≤ η_adm := le_trans hrM hη_st_le_adm
  have hBase_at :=
    hAdm.2.1 α γ_steep x₀ h_ref m_steep d δ_ceil Δ_slab r M_scale C_init s_init
      hα1 hα2 hγ1 hγ2 hm hd hΔ h2Δ hr hM hCinit hAbs hs_init_holo hs_init_bound
  have hStep_at :=
    hStep_all α γ_steep x₀ h_ref m_steep d δ_ceil r M_scale
      hα1 hα2 hγ1 hγ2 hm hd hδ_pos hr hM hrd_adm hrM_adm hShape
  
  have hW_basic : ∀ p : ℂ × ℂ, p ∈ W_up →
      0 < h_ref - p.1.im ∧
      h_ref - p.1.im < δ_ceil ∧
      0 < p.2.im ∧
      p.2 ≠ 0 ∧
      ‖p.2‖ ≤ p.2.im / γ_steep ∧
      ‖p.2‖ < 10 * r * (δ_ceil / d) ^ α ∧
      p.2.im < (1 / 16) * Δ_slab := by
    intro p hp
    have hDy_pos : 0 < h_ref - p.1.im := by linarith only [hd, hp.1]
    have hDy_lt : h_ref - p.1.im < δ_ceil := by linarith only [hΔ, hp.2.1]
    have htim_pos : 0 < p.2.im :=
      lt_of_le_of_lt (mul_nonneg hγ1.le (norm_nonneg p.2)) hp.2.2.2.2
    have ht_ne : p.2 ≠ 0 := by
      intro h0
      rw [h0, Complex.zero_im] at htim_pos
      exact lt_irrefl 0 htim_pos
    have ht_norm_div : ‖p.2‖ ≤ p.2.im / γ_steep := by
      rw [le_div_iff₀ hγ1, mul_comm]
      exact hp.2.2.2.2.le
    have h_div_le : (h_ref - p.1.im) / d ≤ δ_ceil / d :=
      div_le_div_of_nonneg_right hDy_lt.le hd.le
    have h_rpow_le : ((h_ref - p.1.im) / d) ^ α ≤ (δ_ceil / d) ^ α :=
      Real.rpow_le_rpow (div_nonneg hDy_pos.le hd.le) h_div_le hα_pos.le
    have ht_lt_ceil : ‖p.2‖ < 10 * r * (δ_ceil / d) ^ α :=
      lt_of_lt_of_le hp.2.2.2.1 (mul_le_mul_of_nonneg_left h_rpow_le (by positivity))
    have h_rpow_pos : 0 < (δ_ceil / d) ^ α :=
      Real.rpow_pos_of_pos (div_pos hδ_pos hd) α
    have h10_lt_12 : 10 * r * (δ_ceil / d) ^ α < 12 * r * (δ_ceil / d) ^ α := by
      have : 0 < r * (δ_ceil / d) ^ α := mul_pos hr h_rpow_pos
      linarith only [this]
    have ht_lt_16 : ‖p.2‖ < (1 / 16) * Δ_slab := by
      linarith only [ht_lt_ceil, h10_lt_12, h12r]
    have htim_le_norm : p.2.im ≤ ‖p.2‖ :=
      le_trans (le_abs_self p.2.im) (Complex.abs_im_le_norm p.2)
    exact ⟨hDy_pos, hDy_lt, htim_pos, ht_ne, ht_norm_div, ht_lt_ceil,
      lt_of_le_of_lt htim_le_norm ht_lt_16⟩
  have hW_ray_re : ∀ p : ℂ × ℂ, p ∈ W_up → ∀ u : ℝ, 0 ≤ u →
      |(p.1 - (u : ℂ) * p.2).re - x₀| ≤
        (m_steep + 1 / γ_steep) * (h_ref - (p.1 - (u : ℂ) * p.2).im) := by
    intro p hp u hu
    obtain ⟨hDy_pos, _, htim_pos, _, ht_norm_div, _, _⟩ := hW_basic p hp
    have him_eq : h_ref - (p.1 - (u : ℂ) * p.2).im = (h_ref - p.1.im) + u * p.2.im := by
      simp [Complex.sub_im, Complex.mul_im]
      ring
    have hre_eq : (p.1 - (u : ℂ) * p.2).re - x₀ = (p.1.re - x₀) - u * p.2.re := by
      simp [Complex.sub_re, Complex.mul_re]
      ring
    have hut_re : |u * p.2.re| ≤ u * (p.2.im / γ_steep) := by
      rw [abs_mul, abs_of_nonneg hu]
      exact mul_le_mul_of_nonneg_left
        (le_trans (Complex.abs_re_le_norm p.2) ht_norm_div) hu
    have habs_sub : |(p.1.re - x₀) - u * p.2.re| ≤ |p.1.re - x₀| + |u * p.2.re| := by
      simpa only [sub_eq_add_neg, abs_neg] using abs_add_le (p.1.re - x₀) (-(u * p.2.re))
    have h1 : |p.1.re - x₀| ≤ (m_steep + 1 / γ_steep) * (h_ref - p.1.im) := by
      have hpos_inv : 0 ≤ 1 / γ_steep := by positivity
      have hle_m : m_steep ≤ m_steep + 1 / γ_steep := by linarith only [hpos_inv]
      exact le_trans hp.2.2.1.le (mul_le_mul_of_nonneg_right hle_m hDy_pos.le)
    have h2 : u * (p.2.im / γ_steep) ≤ (m_steep + 1 / γ_steep) * (u * p.2.im) := by
      have h_eq : u * (p.2.im / γ_steep) = (1 / γ_steep) * (u * p.2.im) := by ring
      rw [h_eq]
      have hle_inv : 1 / γ_steep ≤ m_steep + 1 / γ_steep := by linarith only [hm]
      exact mul_le_mul_of_nonneg_right hle_inv (mul_nonneg hu htim_pos.le)
    rw [hre_eq, him_eq]
    calc |(p.1.re - x₀) - u * p.2.re|
        ≤ |p.1.re - x₀| + |u * p.2.re| := habs_sub
      _ ≤ (m_steep + 1 / γ_steep) * (h_ref - p.1.im) +
            (m_steep + 1 / γ_steep) * (u * p.2.im) :=
          add_le_add h1 (le_trans hut_re h2)
      _ = (m_steep + 1 / γ_steep) * ((h_ref - p.1.im) + u * p.2.im) := by ring
  have hW_scale : ∀ p : ℂ × ℂ, p ∈ W_up → ∀ D : ℝ, h_ref - p.1.im ≤ D →
      ‖p.2‖ ^ 2 * M_scale ^ 2 * D ^ (-2 * α) ≤ 100 * η_st ^ 2 ∧
      D ^ (1 - 2 * α) = D ^ (-2 * α) * D ∧
      C_st * ‖p.2‖ ^ 2 * M_scale ^ 2 * D ^ (1 - 2 * α) ≤ (1 / 512) * D ∧
      ‖p.2‖ ^ 2 * M_scale ^ 2 * D ^ (1 - 2 * α) ≤ (1 / 512) * D ∧
      C_J * ‖p.2‖ ^ 2 * M_scale ^ 2 * D ^ (-2 * α) ≤ 1 / 32 ∧
      ‖p.2‖ < 10 * r * (D / d) ^ α ∧
      ‖p.2‖ ≤ D := by
    intro p hp D hD_ge
    obtain ⟨hDy_pos, _, _, _, _, _, _⟩ := hW_basic p hp
    set D_y : ℝ := h_ref - p.1.im
    have hD_pos : 0 < D := lt_of_lt_of_le hDy_pos hD_ge
    have hD_rpow_le : D ^ (-α) ≤ D_y ^ (-α) :=
      Real.rpow_le_rpow_of_nonpos hDy_pos hD_ge (by linarith only [hα_pos])
    have hDy_cancel : (D_y / d) ^ α * D_y ^ (-α) = d ^ (-α) := by
      rw [Real.div_rpow hDy_pos.le hd.le α]
      have h_mul_one : D_y ^ α * D_y ^ (-α) = 1 := by
        rw [← Real.rpow_add hDy_pos α (-α), add_neg_cancel, Real.rpow_zero]
      calc D_y ^ α / d ^ α * D_y ^ (-α) = (D_y ^ α * D_y ^ (-α)) / d ^ α := by ring
        _ = 1 / d ^ α := by rw [h_mul_one]
        _ = d ^ (-α) := by rw [one_div, ← Real.rpow_neg hd.le α]
    have h_lin_bound : ‖p.2‖ * M_scale * D ^ (-α) ≤ 10 * η_st := by
      have h1 : ‖p.2‖ * M_scale ≤ (10 * r * (D_y / d) ^ α) * M_scale :=
        mul_le_mul_of_nonneg_right hp.2.2.2.1.le hM.le
      have h2 : (‖p.2‖ * M_scale) * D ^ (-α) ≤
          ((10 * r * (D_y / d) ^ α) * M_scale) * D_y ^ (-α) :=
        mul_le_mul h1 hD_rpow_le (Real.rpow_nonneg hD_pos.le _) (by positivity)
      have h3 : ((10 * r * (D_y / d) ^ α) * M_scale) * D_y ^ (-α) =
          10 * (r * d ^ (-α) * M_scale) := by
        calc ((10 * r * (D_y / d) ^ α) * M_scale) * D_y ^ (-α)
            = 10 * (r * ((D_y / d) ^ α * D_y ^ (-α)) * M_scale) := by ring
          _ = 10 * (r * d ^ (-α) * M_scale) := by rw [hDy_cancel]
      calc ‖p.2‖ * M_scale * D ^ (-α)
          ≤ ((10 * r * (D_y / d) ^ α) * M_scale) * D_y ^ (-α) := h2
        _ = 10 * (r * d ^ (-α) * M_scale) := h3
        _ ≤ 10 * η_st := mul_le_mul_of_nonneg_left hrM (by norm_num)
    have h_sq_bound : ‖p.2‖ ^ 2 * M_scale ^ 2 * D ^ (-2 * α) ≤ 100 * η_st ^ 2 := by
      have h_nonneg : 0 ≤ ‖p.2‖ * M_scale * D ^ (-α) :=
        mul_nonneg (mul_nonneg (norm_nonneg _) hM.le) (Real.rpow_nonneg hD_pos.le _)
      have h_pow2 := pow_le_pow_left₀ h_nonneg h_lin_bound 2
      have hD_sq : (D ^ (-α)) ^ (2 : ℕ) = D ^ (-2 * α) := by
        rw [← Real.rpow_natCast (D ^ (-α)) 2, ← Real.rpow_mul hD_pos.le (-α) (2 : ℕ)]
        push_cast
        ring_nf
      calc ‖p.2‖ ^ 2 * M_scale ^ 2 * D ^ (-2 * α)
          = ‖p.2‖ ^ 2 * M_scale ^ 2 * (D ^ (-α)) ^ (2 : ℕ) := by rw [hD_sq]
        _ = (‖p.2‖ * M_scale * D ^ (-α)) ^ 2 := by ring
        _ ≤ (10 * η_st) ^ 2 := h_pow2
        _ = 100 * η_st ^ 2 := by ring
    have hD_split : D ^ (1 - 2 * α) = D ^ (-2 * α) * D := by
      have hexp : (1 : ℝ) - 2 * α = -2 * α + 1 := by ring
      rw [hexp, Real.rpow_add hD_pos (-2 * α) 1, Real.rpow_one]
    have hCst_pos_512 : C_st * ‖p.2‖ ^ 2 * M_scale ^ 2 * D ^ (1 - 2 * α) ≤ (1 / 512) * D := by
      rw [hD_split]
      calc C_st * ‖p.2‖ ^ 2 * M_scale ^ 2 * (D ^ (-2 * α) * D)
          = (C_st * (‖p.2‖ ^ 2 * M_scale ^ 2 * D ^ (-2 * α))) * D := by ring
        _ ≤ (C_st * (100 * η_st ^ 2)) * D :=
            mul_le_mul_of_nonneg_right
              (mul_le_mul_of_nonneg_left h_sq_bound hCst_pos.le) hD_pos.le
        _ = (100 * C_st * η_st ^ 2) * D := by ring
        _ ≤ (1 / 512) * D := mul_le_mul_of_nonneg_right h100_Cst_512 hD_pos.le
    have h1_pos_512 : ‖p.2‖ ^ 2 * M_scale ^ 2 * D ^ (1 - 2 * α) ≤ (1 / 512) * D := by
      have h_nonneg : 0 ≤ ‖p.2‖ ^ 2 * M_scale ^ 2 * D ^ (1 - 2 * α) :=
        mul_nonneg (mul_nonneg (sq_nonneg _) (sq_nonneg _)) (Real.rpow_nonneg hD_pos.le _)
      have hle : 1 * (‖p.2‖ ^ 2 * M_scale ^ 2 * D ^ (1 - 2 * α)) ≤
          C_st * (‖p.2‖ ^ 2 * M_scale ^ 2 * D ^ (1 - 2 * α)) :=
        mul_le_mul_of_nonneg_right hCst_ge_one h_nonneg
      have hle' : ‖p.2‖ ^ 2 * M_scale ^ 2 * D ^ (1 - 2 * α) ≤
          C_st * ‖p.2‖ ^ 2 * M_scale ^ 2 * D ^ (1 - 2 * α) := by
        linarith only [hle]
      exact le_trans hle' hCst_pos_512
    have hCJ_32 : C_J * ‖p.2‖ ^ 2 * M_scale ^ 2 * D ^ (-2 * α) ≤ 1 / 32 := by
      calc C_J * ‖p.2‖ ^ 2 * M_scale ^ 2 * D ^ (-2 * α)
          = C_J * (‖p.2‖ ^ 2 * M_scale ^ 2 * D ^ (-2 * α)) := by ring
        _ ≤ C_J * (100 * η_st ^ 2) := mul_le_mul_of_nonneg_left h_sq_bound hCJ_pos.le
        _ = 100 * C_J * η_st ^ 2 := by ring
        _ ≤ 1 / 32 := h100_CJ_32
    have ht_lt_D : ‖p.2‖ < 10 * r * (D / d) ^ α := by
      have hdiv : D_y / d ≤ D / d := div_le_div_of_nonneg_right hD_ge hd.le
      have hrp : (D_y / d) ^ α ≤ (D / d) ^ α :=
        Real.rpow_le_rpow (div_nonneg hDy_pos.le hd.le) hdiv hα_pos.le
      exact lt_of_lt_of_le hp.2.2.2.1 (mul_le_mul_of_nonneg_left hrp (by positivity))
    have ht_le_D : ‖p.2‖ ≤ D := by
      have hd_lt_2D : d < 2 * D := by linarith only [hp.1, hD_ge]
      have hdD_lt_2 : d / D < 2 := (div_lt_iff₀ hD_pos).mpr hd_lt_2D
      have hdD_rpow_le : (d / D) ^ (1 - α) ≤ 2 := by
        calc (d / D) ^ (1 - α)
            ≤ (2 : ℝ) ^ (1 - α) :=
              Real.rpow_le_rpow (div_nonneg hd.le hD_pos.le) hdD_lt_2.le
                (by linarith only [hα2])
          _ ≤ (2 : ℝ) ^ (1 : ℝ) :=
              Real.rpow_le_rpow_of_exponent_le (by norm_num) (by linarith only [hα_pos])
          _ = 2 := Real.rpow_one 2
      have hd_mul_rpow : d * (D / d) ^ α = D * (d / D) ^ (1 - α) := by
        rw [Real.div_rpow hD_pos.le hd.le α, Real.div_rpow hd.le hD_pos.le (1 - α)]
        have hD_sub : D ^ (1 - α) * D ^ α = D := by
          rw [← Real.rpow_add hD_pos (1 - α) α, sub_add_cancel, Real.rpow_one]
        have hd_sub : d ^ (1 - α) * d ^ α = d := by
          rw [← Real.rpow_add hd (1 - α) α, sub_add_cancel, Real.rpow_one]
        have hD_ne : D ^ (1 - α) ≠ 0 := (Real.rpow_pos_of_pos hD_pos _).ne'
        have hd_ne : d ^ α ≠ 0 := (Real.rpow_pos_of_pos hd _).ne'
        field_simp [hD_ne, hd_ne]
        linear_combination d * hD_sub - D * hd_sub
      have hr_le_d : r ≤ (1 / 6400) * d := by
        have hrd_6400 : r / d ≤ 1 / 6400 := le_trans hrd hη_st_le_6400
        exact (div_le_iff₀ hd).mp hrd_6400
      have h_rpow_nonneg : 0 ≤ (D / d) ^ α := Real.rpow_nonneg (div_nonneg hD_pos.le hd.le) α
      have h_step1 : 10 * r * (D / d) ^ α ≤ (10 / 6400) * (d * (D / d) ^ α) := by
        have : 10 * r ≤ 10 * ((1 / 6400) * d) := by linarith only [hr_le_d]
        calc 10 * r * (D / d) ^ α ≤ (10 * ((1 / 6400) * d)) * (D / d) ^ α :=
              mul_le_mul_of_nonneg_right this h_rpow_nonneg
          _ = (10 / 6400) * (d * (D / d) ^ α) := by ring
      have h_step2 : (10 / 6400) * (D * (d / D) ^ (1 - α)) ≤ (1 / 320) * D := by
        have hmul : D * (d / D) ^ (1 - α) ≤ D * 2 :=
          mul_le_mul_of_nonneg_left hdD_rpow_le hD_pos.le
        linarith only [hmul]
      rw [hd_mul_rpow] at h_step1
      linarith only [ht_lt_D, h_step1, h_step2, hD_pos]
    exact ⟨h_sq_bound, hD_split, hCst_pos_512, h1_pos_512, hCJ_32, ht_lt_D, ht_le_D⟩
  
  have h_chain_pt : ∀ (N : ℕ) (p : ℂ × ℂ),
      p ∈ W_up →
      δ_ceil - (31 / 32) * Δ_slab < h_ref - (p.1 - (N : ℂ) * p.2).im →
      h_ref - (p.1 - ((N : ℂ) + 1) * p.2).im < δ_ceil - (1 / 32) * Δ_slab →
      (p.1 - ((N : ℂ) + 1) * p.2, p.2) ∈ S_init ∧
      ((p.1 - ((N : ℂ) + 1) * p.2) + p.2, p.2) ∈ S_init ∧
      ‖refSteepPsi P s_init N p.1 p.2 - p.1‖ ≤
        C_st * ‖p.2‖ ^ 2 * M_scale ^ 2 * (h_ref - p.1.im) ^ (1 - 2 * α) ∧
      (∀ m < N,
        let ch := refSteepChain P s_init (p.1 - ((N : ℂ) + 1) * p.2) p.2 m
        IsRefSteepContractivePt X P ch.1 ch.2 p.2) := by
    intro N p hp h_lo h_hi
    set y : ℂ := p.1
    set t : ℂ := p.2
    obtain ⟨hDy_pos, _, htim_pos, ht_ne, ht_norm_div, ht_lt_ceil, _⟩ := hW_basic p hp
    let y_bot : ℂ := y - ((N : ℂ) + 1) * t
    let w : ℕ → ℂ := fun k => y_bot + (k : ℂ) * t
    let D : ℕ → ℝ := fun k => h_ref - (w k).im
    let a : ℕ → ℂ := fun j => (refSteepChain P s_init y_bot t j).1
    let b : ℕ → ℂ := fun j => (refSteepChain P s_init y_bot t j).2
    let J_step : ℕ → ℂ := fun j => (b j - a j) / t
    have hw_succ : ∀ k : ℕ, w (k + 1) = w k + t := by
      intro k
      dsimp only [w]
      push_cast
      ring
    have hw_zero : w 0 = y_bot := by
      dsimp only [w]
      simp
    have hw_one : w 1 = y - (N : ℂ) * t := by
      dsimp only [w, y_bot]
      push_cast
      ring
    have hw_top : w (N + 1) = y := by
      dsimp only [w, y_bot]
      push_cast
      ring
    have hD_eq : ∀ k : ℕ, D k = (h_ref - y.im) + ((N : ℝ) + 1 - (k : ℝ)) * t.im := by
      intro k
      dsimp only [D, w, y_bot]
      simp [Complex.add_im, Complex.sub_im, Complex.mul_im]
      ring
    have hD_ge_Dy : ∀ k : ℕ, k ≤ N + 1 → h_ref - y.im ≤ D k := by
      intro k hk
      rw [hD_eq k]
      have hk_r : (k : ℝ) ≤ (N : ℝ) + 1 := by exact_mod_cast hk
      have h_nonneg : 0 ≤ ((N : ℝ) + 1 - (k : ℝ)) * t.im :=
        mul_nonneg (by linarith only [hk_r]) htim_pos.le
      linarith only [h_nonneg]
    have hD_pos : ∀ k : ℕ, k ≤ N + 1 → 0 < D k := by
      intro k hk
      exact lt_of_lt_of_le hDy_pos (hD_ge_Dy k hk)
    have hD_lt_ceil : ∀ k : ℕ, k ≤ N + 1 → D k < δ_ceil := by
      intro k _
      have hD0_lt : D 0 < δ_ceil - (1 / 32) * Δ_slab := by
        simpa only [D, hw_zero, y_bot] using h_hi
      have hDk_le_D0 : D k ≤ D 0 := by
        rw [hD_eq k, hD_eq 0, Nat.cast_zero]
        have hk0 : (0 : ℝ) ≤ (k : ℝ) := Nat.cast_nonneg k
        have hmul : ((N : ℝ) + 1 - (k : ℝ)) * t.im ≤ ((N : ℝ) + 1 - 0) * t.im :=
          mul_le_mul_of_nonneg_right (by linarith only [hk0]) htim_pos.le
        linarith only [hmul]
      linarith only [hDk_le_D0, hD0_lt, hΔ]
    have hw_re : ∀ k : ℕ, k ≤ N + 1 → |(w k).re - x₀| ≤ (m_steep + 1 / γ_steep) * D k := by
      intro k hk
      let u : ℝ := (N : ℝ) + 1 - (k : ℝ)
      have hu_nonneg : 0 ≤ u := by
        have hk_r : (k : ℝ) ≤ (N : ℝ) + 1 := by exact_mod_cast hk
        dsimp only [u]
        linarith only [hk_r]
      have hw_as_ray : w k = y - (u : ℂ) * t := by
        dsimp only [w, y_bot, u]
        push_cast
        ring
      have hray := hW_ray_re p hp u hu_nonneg
      simpa only [y, t, D, hw_as_ray] using hray
    have h_base0 := hBase_at y_bot t hp.2.2.2.2 ht_lt_ceil
      (by
        have h_eq : y_bot + t = y - (N : ℂ) * t := by dsimp only [y_bot]; ring
        simpa only [h_eq] using h_lo)
      h_hi
      (by
        have h_eq : y_bot + t = w 1 := by rw [hw_succ 0, hw_zero]
        simpa only [h_eq, D] using hw_re 1 (by omega))
    rcases h_base0 with ⟨hybot_S, hybot1_S, ha0_raw, hb0_raw, hJ0_raw⟩
    have ha0_D : ∀ k : ℕ, k ≤ N + 1 →
        ‖a 0 - y_bot‖ ≤ ‖t‖ ^ 2 * M_scale ^ 2 * (D k) ^ (1 - 2 * α) := by
      intro k hk
      have hrp : δ_ceil ^ (1 - 2 * α) ≤ (D k) ^ (1 - 2 * α) :=
        Real.rpow_le_rpow_of_nonpos (hD_pos k hk) (hD_lt_ceil k hk).le
          (by linarith only [h2α_sub_pos])
      exact le_trans ha0_raw (mul_le_mul_of_nonneg_left hrp (by positivity))
    have hb0_D : ∀ k : ℕ, k ≤ N + 1 →
        ‖b 0 - w 1‖ ≤ ‖t‖ ^ 2 * M_scale ^ 2 * (D k) ^ (1 - 2 * α) := by
      intro k hk
      have hrp : δ_ceil ^ (1 - 2 * α) ≤ (D k) ^ (1 - 2 * α) :=
        Real.rpow_le_rpow_of_nonpos (hD_pos k hk) (hD_lt_ceil k hk).le
          (by linarith only [h2α_sub_pos])
      have hb0' : ‖b 0 - w 1‖ ≤ ‖t‖ ^ 2 * M_scale ^ 2 * δ_ceil ^ (1 - 2 * α) := by
        have hw1_eq : y_bot + t = w 1 := by rw [hw_succ 0, hw_zero]
        simpa only [b, refSteepChain, hw1_eq] using hb0_raw
      exact le_trans hb0' (mul_le_mul_of_nonneg_left hrp (by positivity))
    have hJ0_D : ∀ k : ℕ, k ≤ N + 1 →
        ‖J_step 0 - 1‖ ≤ ‖t‖ ^ 2 * M_scale ^ 2 * (D k) ^ (-2 * α) := by
      intro k hk
      have hrp : δ_ceil ^ (-2 * α) ≤ (D k) ^ (-2 * α) :=
        Real.rpow_le_rpow_of_nonpos (hD_pos k hk) (hD_lt_ceil k hk).le
          (by linarith only [hα_pos])
      exact le_trans hJ0_raw (mul_le_mul_of_nonneg_left hrp (by positivity))
    have ht_cubed_le : ‖t‖ ^ 3 ≤ ‖t‖ ^ 2 * (t.im / γ_steep) := by
      calc ‖t‖ ^ 3 = ‖t‖ ^ 2 * ‖t‖ := by ring
