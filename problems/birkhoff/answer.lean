        rw [hbStep_norm]
        have hN_ne_R : (N : ℝ) ≠ 0 := ne_of_gt hN_pos
        have hR_ne : R ≠ 0 := ne_of_gt hR_pos
        field_simp
      have hCU_le : C_U ≤ C_init := le_trans (le_max_left _ _) (le_max_right _ _)
      calc ‖chartU y₀ t - y₀‖ ≤ (4 * M.ρ_1 / R) * ‖t - t₀‖ := hfU_mvt
        _ = C_U * ‖bStep t‖ := h_eq
        _ ≤ C_init * ‖bStep t‖ := mul_le_mul_of_nonneg_right hCU_le (norm_nonneg _)
    
    let f_V : ℂ → ℂ := fun w => chartV y₀ w - (N : ℂ) * p₀ y₀ * (w - t₀)
    have hfV_holo : DifferentiableOn ℂ f_V (Metric.ball t₀ R) :=
      hV_y₀_holo.sub
        (((differentiableOn_id.sub (differentiableOn_const t₀)).const_mul ((N : ℂ) * p₀ y₀)).congr
          (fun w _ => by dsimp))
    have hfV_t₀ : f_V t₀ = 0 := by dsimp [f_V]; rw [hV_t₀]; ring
    have hderiv_fV_t₀ : deriv f_V t₀ = 0 := by
      have hV_da : DifferentiableAt ℂ (chartV y₀) t₀ :=
        hV_y₀_holo.differentiableAt (isOpen_ball.mem_nhds ht₀_in_R)
      have hV_hda : HasDerivAt (chartV y₀) ((N : ℂ) * p₀ y₀) t₀ := by
        rw [← M.chartV_deriv_t0 y₀ hy₀_half hy₀_im_h]
        exact hV_da.hasDerivAt
      have hlin_hda :
          HasDerivAt (fun w : ℂ => (N : ℂ) * p₀ y₀ * (w - t₀)) ((N : ℂ) * p₀ y₀) t₀ := by
        have h1 := ((hasDerivAt_id t₀).sub_const t₀).const_mul ((N : ℂ) * p₀ y₀)
        rw [mul_one] at h1
        exact h1
      have hsub_hda := hV_hda.sub hlin_hda
      rw [sub_self] at hsub_hda
      exact hsub_hda.deriv
    have hfV_bd : ∀ w ∈ Metric.ball t₀ R, ‖f_V w‖ ≤ B_V := by
      intro w hw
      have hw_ρv1 : chartV y₀ w ∈ Metric.ball (0 : ℂ) M.ρ_v1 :=
        (hStep_R y₀ hy₀_half hy₀_im_half w hw).1.2
      rw [Metric.mem_ball, dist_zero_right] at hw_ρv1
      have hw_dist : ‖w - t₀‖ ≤ R := by
        rw [← dist_eq_norm]
        exact le_of_lt (Metric.mem_ball.mp hw)
      have hp₀_le : ‖p₀ y₀‖ ≤ M_p0 := le_trans (hM_p0_raw y₀ hy₀_cb) (le_max_left _ _)
      have hlin_le : ‖(N : ℂ) * p₀ y₀ * (w - t₀)‖ ≤ (N : ℝ) * M_p0 * R := by
        rw [norm_mul, norm_mul, norm_natCast]
        have h1 : (N : ℝ) * ‖p₀ y₀‖ ≤ (N : ℝ) * M_p0 :=
          mul_le_mul_of_nonneg_left hp₀_le (le_of_lt hN_pos)
        calc (N : ℝ) * ‖p₀ y₀‖ * ‖w - t₀‖
            ≤ ((N : ℝ) * M_p0) * R :=
              mul_le_mul h1 hw_dist (norm_nonneg _) (by positivity)
          _ = (N : ℝ) * M_p0 * R := by ring
      calc ‖f_V w‖ ≤ ‖chartV y₀ w‖ + ‖(N : ℂ) * p₀ y₀ * (w - t₀)‖ := norm_sub_le _ _
        _ ≤ B_V := by dsimp [B_V]; linarith
    have hfV_deriv1_bd : ∀ z ∈ Metric.ball t₀ (R / 3), ‖deriv f_V z‖ ≤ 2 * B_V / R := by
      intro z hz
      have hsub : Metric.closedBall z (R / 2) ⊆ Metric.ball t₀ R := by
        intro w hw
        rw [Metric.mem_closedBall] at hw
        rw [Metric.mem_ball] at hz ⊢
        calc dist w t₀ ≤ dist w z + dist z t₀ := dist_triangle w z t₀
          _ < R / 2 + R / 3 := by linarith
          _ < R := by linarith
      have hle := Complex.norm_deriv_le_of_forall_mem_sphere_norm_le (half_pos hR_pos)
        (hfV_holo.diffContOnCl_ball hsub)
        (fun w hw => hfV_bd w (hsub (Metric.sphere_subset_closedBall hw)))
      calc ‖deriv f_V z‖ ≤ B_V / (R / 2) := hle
        _ = 2 * B_V / R := by ring
    have hfV_deriv_holo : DifferentiableOn ℂ (deriv f_V) (Metric.ball t₀ (R / 3)) :=
      (hfV_holo.deriv isOpen_ball).mono (Metric.ball_subset_ball (by linarith))
    have hfV_deriv2_bd :
        ∀ z ∈ Metric.ball t₀ (R / 6), ‖deriv (deriv f_V) z‖ ≤ 24 * B_V / R ^ 2 := by
      intro z hz
      have hsub : Metric.closedBall z (R / 12) ⊆ Metric.ball t₀ (R / 3) := by
        intro w hw
        rw [Metric.mem_closedBall] at hw
        rw [Metric.mem_ball] at hz ⊢
        calc dist w t₀ ≤ dist w z + dist z t₀ := dist_triangle w z t₀
          _ < R / 12 + R / 6 := by linarith
          _ < R / 3 := by linarith
      have hle := Complex.norm_deriv_le_of_forall_mem_sphere_norm_le (by linarith : 0 < R / 12)
        (hfV_deriv_holo.diffContOnCl_ball hsub)
        (fun w hw => hfV_deriv1_bd w (hsub (Metric.sphere_subset_closedBall hw)))
      calc ‖deriv (deriv f_V) z‖ ≤ (2 * B_V / R) / (R / 12) := hle
        _ = 24 * B_V / R ^ 2 := by ring
    have hfV_deriv1_lip :
        ∀ z ∈ Metric.ball t₀ (R / 6), ‖deriv f_V z‖ ≤ (24 * B_V / R ^ 2) * ‖z - t₀‖ := by
      intro z hz
      have hmvt := Convex.norm_image_sub_le_of_norm_deriv_le
        (fun w hw => hfV_deriv_holo.differentiableAt
          (isOpen_ball.mem_nhds (Metric.ball_subset_ball (by linarith) hw)))
        hfV_deriv2_bd (convex_ball t₀ (R / 6)) ht₀_in_R6 hz
      simpa only [hderiv_fV_t₀, sub_zero] using hmvt
    have hcb_sub_R6 : Metric.closedBall t₀ ‖t - t₀‖ ⊆ Metric.ball t₀ (R / 6) := by
      intro z hz
      rw [Metric.mem_closedBall, dist_eq_norm] at hz
      rw [Metric.mem_ball, dist_eq_norm] at ht_ball ⊢
      linarith
    have hfV_quad : ‖f_V t‖ ≤ (24 * B_V / R ^ 2) * ‖t - t₀‖ ^ 2 := by
      have hmvt := Convex.norm_image_sub_le_of_norm_deriv_le
        (fun z hz => hfV_holo.differentiableAt (isOpen_ball.mem_nhds
          (Metric.ball_subset_ball (by linarith) (hcb_sub_R6 hz))))
        (fun z hz => by
          have hz_le : ‖z - t₀‖ ≤ ‖t - t₀‖ := by
            rw [← dist_eq_norm]
            exact Metric.mem_closedBall.mp hz
          calc ‖deriv f_V z‖ ≤ (24 * B_V / R ^ 2) * ‖z - t₀‖ :=
                hfV_deriv1_lip z (hcb_sub_R6 hz)
            _ ≤ (24 * B_V / R ^ 2) * ‖t - t₀‖ :=
                mul_le_mul_of_nonneg_left hz_le (by positivity))
        (convex_closedBall t₀ ‖t - t₀‖)
        (Metric.mem_closedBall_self (norm_nonneg _))
        (by rw [Metric.mem_closedBall, dist_eq_norm])
      rw [hfV_t₀, sub_zero] at hmvt
      calc ‖f_V t‖ ≤ ((24 * B_V / R ^ 2) * ‖t - t₀‖) * ‖t - t₀‖ := hmvt
        _ = (24 * B_V / R ^ 2) * ‖t - t₀‖ ^ 2 := by ring
    have hV_err : ‖chartV y₀ t / bStep t - p₀ y₀‖ ≤ C_init * ‖bStep t‖ := by
      have hb_ne : bStep t ≠ 0 := mul_ne_zero hN_ne_C (sub_ne_zero.mpr ht_ne)
      have hb_pos : 0 < ‖bStep t‖ := norm_pos_iff.mpr hb_ne
      have hquot_eq : chartV y₀ t / bStep t - p₀ y₀ = f_V t / bStep t := by
        have h1 : f_V t = chartV y₀ t - p₀ y₀ * bStep t := by dsimp [f_V, bStep]; ring
        rw [h1, sub_div (chartV y₀ t) (p₀ y₀ * bStep t) (bStep t),
          mul_div_cancel_right₀ _ hb_ne]
      rw [hquot_eq, norm_div]
      have hCV_le : C_V ≤ C_init := le_trans (le_max_right _ _) (le_max_right _ _)
      calc ‖f_V t‖ / ‖bStep t‖
          ≤ C_V * ‖bStep t‖ := by
            rw [div_le_iff₀ hb_pos]
            have h_rhs : C_V * ‖bStep t‖ * ‖bStep t‖ = (24 * B_V / R ^ 2) * ‖t - t₀‖ ^ 2 := by
              dsimp [C_V]
              rw [hbStep_norm]
              have hN_ne_R : (N : ℝ) ≠ 0 := ne_of_gt hN_pos
              have hR_ne : R ≠ 0 := ne_of_gt hR_pos
              field_simp
            rw [h_rhs]
            exact hfV_quad
        _ ≤ C_init * ‖bStep t‖ := mul_le_mul_of_nonneg_right hCV_le (norm_nonneg _)
    exact ⟨hU_err, hV_err⟩
  
  obtain ⟨b_max, C_tot, hb_max_pos, hC_tot_pos, hGron⟩ :
      ∃ b_max C_tot : ℝ, 0 < b_max ∧ 0 < C_tot ∧
        ∀ (pos : Bool) (b y₀ : ℂ) (z₀ : ℂ × ℂ) (m : ℕ),
