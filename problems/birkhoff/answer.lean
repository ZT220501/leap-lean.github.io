            have hJ1 : ∀ m : Fin (k + 1), PowerSeries.coeff 1 (F_ser m) ∈ F_val :=
              fun m => hJets m 1 (by omega)
            have hJ2 : ∀ m : Fin (k + 1), 2 * PowerSeries.coeff 2 (F_ser m) ∈ F_val :=
