    have h_no_common : ∀ z : ℂ, ¬ (P_ρ.eval z = 0 ∧ Q_ρ.eval z = 0) := by
      intro z ⟨hPz, hQz⟩
      obtain ⟨u, v, huv⟩ := h_coprime
      have h1 := congrArg (Polynomial.eval z) huv
      simp [hPz, hQz] at h1
    have h_comp_shift_inv : ∀ (A : Polynomial ℂ) (c : ℂ),
