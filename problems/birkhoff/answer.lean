        have hd_cont : Continuous (deriv (circleMap 0 t₀)) := by
          have heq : deriv (circleMap 0 t₀) = fun θ : ℝ => circleMap 0 t₀ θ * Complex.I := by
            ext θ
            exact (hasDerivAt_circleMap 0 t₀ θ).deriv
          rw [heq]
          exact (continuous_circleMap 0 t₀).mul continuous_const
        have hh_cont : Continuous (fun θ : ℝ => h (circleMap 0 t₀ θ)) := by
          apply Continuous.inv₀ ((continuous_circleMap 0 t₀).sub continuous_const)
          intro θ h0
          have heq : circleMap 0 t₀ θ = T := sub_eq_zero.mp h0
          have hnorm : ‖circleMap 0 t₀ θ‖ = t₀ := by rw [norm_circleMap_zero, abs_of_pos ht₀]
          rw [heq] at hnorm
          linarith
        exact hd_cont.smul hh_cont
      have hIh : upperHalfDiskIntegral h = 2 * (Real.pi : ℂ) * Complex.I := by
        have hsum : upperHalfDiskIntegral h + upperHalfDiskIntegral g_opp =
            ∮ ζ in C(0, t₀), (ζ - T)⁻¹ := by
          dsimp only [upperHalfDiskIntegral]
