    have h_ab_lt : ∀ m : Fin N, a_m m < b_m m := by
      intro m
      have : b_m m - a_m m = 2 / (N : ℝ) := by dsimp [a_m, b_m]; ring
      have : 0 < 2 / (N : ℝ) := by positivity
      linarith
    have h_bm_le : ∀ m : Fin N, b_m m ≤ 1 := by
      intro m
      have hm1 : m.1 + 1 ≤ N := m.2
      have hm1_r : (m.1 : ℝ) + 1 ≤ (N : ℝ) := by exact_mod_cast hm1
      have hdiv : 2 * ((m.1 : ℝ) + 1) / (N : ℝ) ≤ 2 := by
        rw [div_le_iff₀ hN_pos_real]; linarith
      dsimp [b_m]; linarith
    have h_cover : Set.Icc (-1 : ℝ) 1 ⊆ ⋃ m ∈ (Finset.univ : Finset (Fin N)), I_m m := by
      intro u ⟨hu_lo, hu_hi⟩
      rw [Set.mem_iUnion₂]
      rcases eq_or_lt_of_le hu_hi with rfl | hu_lt
      · let mLast : Fin N := ⟨N - 1, Nat.sub_lt hN_pos Nat.zero_lt_one⟩
        have hb_last : b_m mLast = 1 := by
