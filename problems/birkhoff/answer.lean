    have h_logderiv_list :
        ∀ (L : List ℂ) (u : ℂ → ℂ) (w : ℂ),
          (∀ α ∈ L, w - α ≠ 0) →
          DifferentiableAt ℂ u w → u w ≠ 0 →
          (L.map (fun α => w - α)).prod * u w ≠ 0 ∧
          deriv (fun z => (L.map (fun α => z - α)).prod * u z) w /
              ((L.map (fun α => w - α)).prod * u w) =
            (L.map (fun α => (w - α)⁻¹)).sum + deriv u w / u w := by
      intro L
      induction L with
      | nil =>
        intro u w _ _ hu_nz
        simp [hu_nz]
      | cons α L ih =>
        intro u w hne hu_diff hu_nz
        have hwα : w - α ≠ 0 := hne α List.mem_cons_self
        have hne_L : ∀ β ∈ L, w - β ≠ 0 :=
          fun β hβ => hne β (List.mem_cons_of_mem α hβ)
        let P : ℂ → ℂ := fun z => (L.map (fun β => z - β)).prod * u z
        have hP_diff : DifferentiableAt ℂ P w := by
          have hprod_diff : Differentiable ℂ (fun z => (L.map (fun β => z - β)).prod) := by
            clear ih hne_L hwα hne
            induction L with
            | nil => simp
            | cons β L' ih' =>
              simp only [List.map_cons, List.prod_cons]
              exact (differentiable_id.sub_const β).mul ih'
          exact (hprod_diff w).mul hu_diff
        obtain ⟨hP_nz, hP_log⟩ := ih u w hne_L hu_diff hu_nz
        have hprod_nz : ((α :: L).map (fun β => w - β)).prod * u w ≠ 0 := by
          simpa [List.map_cons, List.prod_cons, mul_assoc] using mul_ne_zero hwα hP_nz
        refine ⟨hprod_nz, ?_⟩
        have hfn_eq : (fun z => ((α :: L).map (fun β => z - β)).prod * u z) =
            fun z => (z - α) * P z := by
          ext z; simp [P, mul_assoc]
        have hderiv_mul :
            deriv (fun z => (z - α) * P z) w = P w + (w - α) * deriv P w := by
          have hd := (((hasDerivAt_id w).sub_const α).fun_mul hP_diff.hasDerivAt).deriv
          simpa using hd
        rw [hfn_eq, hderiv_mul]
        simp only [List.map_cons, List.prod_cons, List.sum_cons]
        have hsplit : (P w + (w - α) * deriv P w) / ((w - α) * (L.map (fun β => w - β)).prod * u w) =
            (w - α)⁻¹ + deriv P w / P w := by
          have hden : (w - α) * (L.map (fun β => w - β)).prod * u w = (w - α) * P w :=
            mul_assoc _ _ _
          rw [hden, add_div, mul_comm (w - α) (P w), div_mul_eq_div_div, div_self hP_nz,
            one_div, mul_comm (P w) (w - α), mul_div_mul_left _ _ hwα]
        rw [hsplit, hP_log, add_assoc]
    have h_cont_poles_list :
        ∀ (k : ℕ) (L : List ℂ),
          (∀ α ∈ L, ‖α‖ < r_y / 2) →
          ContinuousOn (fun w : ℂ => w ^ k * (L.map (fun α => (w - α)⁻¹)).sum)
            (Metric.sphere 0 r_y) := by
      intro k L hrad
      refine (continuousOn_id.pow k).mul ?_
      induction L with
      | nil => simp [continuousOn_const]
      | cons β L' ih' =>
        simp only [List.map_cons, List.sum_cons]
        have hβ_lt : ‖β‖ < r_y := lt_trans (hrad β List.mem_cons_self) (by linarith)
        have hne_β : ∀ w ∈ Metric.sphere (0 : ℂ) r_y, w - β ≠ 0 := by
          intro w hw h0
          rw [sub_eq_zero.mp h0] at hw
          have : ‖β‖ = r_y := by simpa [Metric.mem_sphere] using hw
          linarith
        exact ((continuousOn_id.sub continuousOn_const).inv₀ hne_β).add
          (ih' (fun γ hγ => hrad γ (List.mem_cons_of_mem β hγ)))
