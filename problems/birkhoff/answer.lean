            {(0 : ℂ)}ᶜ isOpen_compl_singleton
        obtain ⟨p_bot, ⟨⟨hp_bot_B0, hp_bot_uni⟩, hp_bot_exc⟩, hp_bot_base⟩ :=
          hH_base_open_wit V_b0_exc hV_b0_exc_open
            ⟨p_b1, ⟨hp_b1_B0, hp_b1_uni⟩, hp_b1_exc⟩ (fun _ hp => hp.1.2)
        obtain ⟨r_b, M_bot, hr_b_pos, hball_rb_sub, hM_bot_holo_rb, hM_bot_solves_rb, hCh⟩ :=
