        (∀ Z ∈ U_m m, ‖u_fn n Z‖ ≤ M₀ ∧
          ‖u_fn n Z‖ ≤ P.C_pass * T₀ ^ 2 * (-Z.im) ^ (1 - 2 * α)) ∧
