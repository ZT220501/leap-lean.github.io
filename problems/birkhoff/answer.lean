        fun x hx y hy => ⟨h_lift_add F Φ hx hy, h_lift_sub F Φ hx hy, h_lift_mul F Φ hx hy⟩, ?_⟩
      intro z hz hz0 hsq
      let P := pointRecLiftArcFn F Φ z
      have hdiff : (P - PowerSeries.C z) * (P + PowerSeries.C z) = 0 := by
        calc (P - PowerSeries.C z) * (P + PowerSeries.C z)
