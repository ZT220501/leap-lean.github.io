          intro m hm
          rcases Nat.lt_succ_iff_lt_or_eq.mp hm with hlt | hm_eq
          · exact ih_contr m hlt
          · subst hm_eq
            exact ⟨hContr_j, hJ_diff_j⟩
        have h_diff_all : ∀ m < j + 1,
            (b (m + 1) - w (m + 2)) - (b m - w (m + 1)) = t * (J_step (m + 1) - 1) := by
          intro m hm
          rcases Nat.lt_succ_iff_lt_or_eq.mp hm with hlt | hm_eq
          · exact ih_diff m hlt
          · subst hm_eq
            rw [hb_succ, ← hJ_succ_eq, hw_succ (m + 1)]
            ring
        
        have hJ_top : ‖J_step (j + 1) - 1‖ ≤
            C_J * ‖t‖ ^ 2 * M_scale ^ 2 * (D (j + 2)) ^ (-2 * α) := by
          have h_tel : J_step (j + 1) - 1 =
