  · refine
      { C_cone_pos := Real.sqrt_pos.mpr hB_tot_pos
        M_exhaust_pos := fun r => mul_pos (hW_pos r) hB_tot_pos
        k_ge_k₀ := hk_ge_k₀
        k_tendsto := hk_tendsto
        moment_tendsto := hmom_tendsto
        normal_level := h_normal
        cone_bound := ?_
        compact_exhaust_bound := ?_ }
    · intro n s hs_lo hs_hi hs_re
      have hn_nonneg : (0 : ℝ) ≤ (n : ℝ) := Nat.cast_nonneg n
      have hK_ge_2 : 2 * hBudget.k₀ + 4 * (n : ℝ) + 40 ≤ K_seq n :=
        le_trans (le_max_right _ _) (hK_lower n)
      have h_mom_one : 1 ≤ rowMomentFull S (k_seq n) :=
        le_trans (Real.one_le_rpow (by linarith) (by norm_num)) (h_mom_K n)
      have h_env_n := hEnvCost n (k_seq n) (hk_gap n) h_mom_one (h_normal n)
      have h_cone := h_env_n.2.2.2.1 (x_seq n) (hx_spec n).1 s hs_lo hs_hi hs_re
      have h_wd_pos : 0 < wallDepth S s := lt_of_lt_of_le (Real.exp_pos _) hs_lo
      have h_rpow_nn : 0 ≤ (Real.exp (-k_seq n) / wallDepth S s) ^ (3 / 4 : ℝ) :=
        Real.rpow_nonneg (by positivity) _
      have h_sqrt_le : Real.sqrt (envCost n (k_seq n) (x_seq n)) ≤ C_cone :=
        Real.sqrt_le_sqrt (hx_spec n).2.2
      exact le_trans h_cone (mul_le_mul_of_nonneg_right h_sqrt_le h_rpow_nn)
    · intro r n hr Z hZ
      have hn_nonneg : (0 : ℝ) ≤ (n : ℝ) := Nat.cast_nonneg n
      have hK_ge_2 : 2 * hBudget.k₀ + 4 * (n : ℝ) + 40 ≤ K_seq n :=
        le_trans (le_max_right _ _) (hK_lower n)
      have h_mom_one : 1 ≤ rowMomentFull S (k_seq n) :=
        le_trans (Real.one_le_rpow (by linarith) (by norm_num)) (h_mom_K n)
      have h_env_n := hEnvCost n (k_seq n) (hk_gap n) h_mom_one (h_normal n)
      obtain ⟨h_strip, h_bd⟩ := h_env_n.2.2.2.2 (x_seq n) (hx_spec n).1 r hr Z hZ
      refine ⟨h_strip, le_trans h_bd ?_⟩
      exact mul_le_mul_of_nonneg_left (hx_spec n).2.2 (hW_pos r).le
  · intro n
    exact ⟨h_mom_K n, (hk_Icc n).1, (hx_spec n).2.1⟩

theorem rescaled_strip_montel_dichotomy (S : FiniteWallNonisotropicStrip)
    (hBudget : CriticalAngleBudgetData S) (L_star C_cone : ℝ)
    (M_exhaust : ℕ → ℝ) (k_seq x_seq : ℕ → ℝ)
    (hL_star : 0 < L_star)
    (hL_excl : ∀ k_seq' x_seq' : ℕ → ℝ, ∀ C₀ C₁ : ℝ, 0 < C₀ → 0 < C₁ →
      (∀ n : ℕ, hBudget.k₀ ≤ k_seq' n) →
      Filter.Tendsto k_seq' Filter.atTop Filter.atTop →
      Filter.Tendsto (fun n => rowMomentFull S (k_seq' n)) Filter.atTop Filter.atTop →
      (∀ n : ℕ, ∀ l : ℝ, hBudget.k₀ ≤ l →
        rowMomentFull S l ≤
          C₀ * rowMomentFull S (k_seq' n) * Real.exp ((1 / 8 : ℝ) * |l - k_seq' n|)) →
      (∀ n : ℕ, ∀ s : ℂ,
        Real.exp (-k_seq' n) ≤ wallDepth S s →
        wallDepth S s ≤ Real.exp (-hBudget.k₀) / 8 →
        |s.re - x_seq' n| ≤ L_star * wallDepth S s →
        (Real.exp (-k_seq' n) / rowMomentFull S (k_seq' n)) * shapeModulus S s ≤
          C₁ * (Real.exp (-k_seq' n) / wallDepth S s) ^ (3 / 4 : ℝ)) →
      ¬ (TendstoLocallyUniformlyOn
          (fun n Z =>
            ((Real.exp (-k_seq' n) / rowMomentFull S (k_seq' n) : ℝ) : ℂ) *
              S.f ((x_seq' n : ℂ) + (S.H : ℂ) * Complex.I +
                (Real.exp (-k_seq' n) : ℂ) * Z))
          (fun _ => 0) Filter.atTop { Z : ℂ | Z.im < 0 } ∧
        TendstoLocallyUniformlyOn
          (fun n Z =>
            ((Real.exp (-k_seq' n) / rowMomentFull S (k_seq' n) : ℝ) : ℂ) ^ 2 *
              S.q ((x_seq' n : ℂ) + (S.H : ℂ) * Complex.I +
                (Real.exp (-k_seq' n) : ℂ) * Z))
          (fun _ => 0) Filter.atTop { Z : ℂ | Z.im < 0 }))
    (hEnv : NormalizedCenterEnvelope S hBudget L_star C_cone M_exhaust k_seq x_seq) :
    ∃ (ϕ : ℕ → ℕ) (F Q : ℂ → ℂ),
      StrictMono ϕ ∧
      DifferentiableOn ℂ F lmLowerHalfPlane ∧
      DifferentiableOn ℂ Q lmLowerHalfPlane ∧
      TendstoLocallyUniformlyOn
        (fun n Z => lmRescaledF S (k_seq (ϕ n)) (x_seq (ϕ n)) Z)
        F Filter.atTop lmLowerHalfPlane ∧
      TendstoLocallyUniformlyOn
        (fun n Z => lmRescaledQ S (k_seq (ϕ n)) (x_seq (ϕ n)) Z)
        Q Filter.atTop lmLowerHalfPlane ∧
      ((∀ D ∈ Set.Icc (1 : ℝ) 2,
          {u ∈ Set.Icc (-1 : ℝ) 1 | F ((u : ℂ) - (D : ℂ) * Complex.I) = 0}.Finite) ∨
        ({D ∈ Set.Icc (1 : ℝ) 2 |
            ∀ u ∈ Set.Icc (-1 : ℝ) 1, (Q ((u : ℂ) - (D : ℂ) * Complex.I)).im = 0}.Finite ∧
          ∀ D ∈ Set.Icc (1 : ℝ) 2,
            (∃ u ∈ Set.Icc (-1 : ℝ) 1, (Q ((u : ℂ) - (D : ℂ) * Complex.I)).im ≠ 0) →
            {u ∈ Set.Icc (-1 : ℝ) 1 | (Q ((u : ℂ) - (D : ℂ) * Complex.I)).im = 0}.Finite)) :=
by
  have hLHP_open : IsOpen lmLowerHalfPlane :=
    isOpen_lt Complex.continuous_im continuous_const
  
  have hRect_conv : ∀ r : ℕ, Convex ℝ (lmCompactRect r) := by
    intro r Z₁ hZ₁ Z₂ hZ₂ a b ha hb hab
    refine ⟨?_, ?_⟩
    · simp only [Complex.add_re, Complex.real_smul, Complex.mul_re, Complex.ofReal_re,
        Complex.ofReal_im, zero_mul, sub_zero]
      exact convex_Icc _ _ hZ₁.1 hZ₂.1 ha hb hab
    · simp only [Complex.add_im, Complex.real_smul, Complex.mul_im, Complex.ofReal_re,
        Complex.ofReal_im, zero_mul, add_zero]
      exact convex_Icc _ _ hZ₁.2 hZ₂.2 ha hb hab
  have hRect_compact : ∀ r : ℕ, IsCompact (lmCompactRect r) := by
    intro r
    have h_closed : IsClosed (lmCompactRect r) :=
      (isClosed_Icc.preimage Complex.continuous_re).inter
        (isClosed_Icc.preimage Complex.continuous_im)
    refine (isCompact_closedBall (0 : ℂ) (2 * (r : ℝ) + 5)).of_isClosed_subset h_closed ?_
    intro Z hZ
    rw [Metric.mem_closedBall, dist_zero_right]
    have hr_nonneg : (0 : ℝ) ≤ (r : ℝ) := Nat.cast_nonneg r
    have h_re : |Z.re| ≤ (r : ℝ) + 2 := abs_le.mpr hZ.1
    have h_im_upper : -(1 / ((r : ℝ) + 2)) ≤ (r : ℝ) + 3 := by
      have h_pos : (0 : ℝ) < (r : ℝ) + 2 := by positivity
      have h_neg : -(1 / ((r : ℝ) + 2)) < 0 := neg_neg_of_pos (one_div_pos.mpr h_pos)
      linarith
    have h_im : |Z.im| ≤ (r : ℝ) + 3 :=
      abs_le.mpr ⟨hZ.2.1, le_trans hZ.2.2 h_im_upper⟩
    calc
      ‖Z‖ ≤ |Z.re| + |Z.im| := Complex.norm_le_abs_re_add_abs_im Z
      _ ≤ 2 * (r : ℝ) + 5 := by linarith
  let δ_rect : ℕ → ℝ := fun r => 1 / (2 * ((r : ℝ) + 2) * ((r : ℝ) + 3))
  have hδ_pos : ∀ r : ℕ, 0 < δ_rect r := by
    intro r
    have hr : (0 : ℝ) ≤ (r : ℝ) := Nat.cast_nonneg r
    exact one_div_pos.mpr (by positivity)
  have hRect_margin : ∀ (r : ℕ) (Z : ℂ),
      Z ∈ lmCompactRect r → Metric.closedBall Z (δ_rect r) ⊆ lmCompactRect (r + 1) := by
    intro r Z hZ W hW
    rw [Metric.mem_closedBall, dist_eq_norm] at hW
    have hr : (0 : ℝ) ≤ (r : ℝ) := Nat.cast_nonneg r
    have h_denom_ge : 12 ≤ 2 * ((r : ℝ) + 2) * ((r : ℝ) + 3) := by nlinarith
    have hδ_le_one : δ_rect r ≤ 1 := by
      dsimp [δ_rect]
      rw [div_le_one (by positivity)]
      linarith
    have h_re_diff : |W.re - Z.re| ≤ δ_rect r := by
      calc
        |W.re - Z.re| = |(W - Z).re| := by rw [Complex.sub_re]
        _ ≤ ‖W - Z‖ := Complex.abs_re_le_norm (W - Z)
        _ ≤ δ_rect r := hW
    have h_im_diff : |W.im - Z.im| ≤ δ_rect r := by
      calc
        |W.im - Z.im| = |(W - Z).im| := by rw [Complex.sub_im]
        _ ≤ ‖W - Z‖ := Complex.abs_im_le_norm (W - Z)
        _ ≤ δ_rect r := hW
    have h_re_abs := abs_le.mp h_re_diff
    have h_im_abs := abs_le.mp h_im_diff
    have h_upper_im : -(1 / ((r : ℝ) + 2)) + δ_rect r ≤ -(1 / (((r + 1 : ℕ) : ℝ) + 2)) := by
      dsimp [δ_rect]
      push_cast
      have h2 : (0 : ℝ) < (r : ℝ) + 2 := by linarith
      have h3 : (0 : ℝ) < (r : ℝ) + 3 := by linarith
      have h_eq : -(1 / ((r : ℝ) + 2)) + 1 / (2 * ((r : ℝ) + 2) * ((r : ℝ) + 3)) -
          (-(1 / ((r : ℝ) + 1 + 2))) = -1 / (2 * ((r : ℝ) + 2) * ((r : ℝ) + 3)) := by
        field_simp
        ring
      have h_neg : -1 / (2 * ((r : ℝ) + 2) * ((r : ℝ) + 3)) ≤ 0 :=
        div_nonpos_of_nonpos_of_nonneg (by norm_num) (by positivity)
      linarith
    refine ⟨⟨?_, ?_⟩, ⟨?_, ?_⟩⟩
    · push_cast; linarith [hZ.1.1, h_re_abs.1, hδ_le_one]
    · push_cast; linarith [hZ.1.2, h_re_abs.2, hδ_le_one]
    · push_cast; linarith [hZ.2.1, h_im_abs.1, hδ_le_one]
    · push_cast at h_upper_im ⊢; linarith [hZ.2.2, h_im_abs.2, h_upper_im]
  have hBall_exhaust : ∀ Z₀ ∈ lmLowerHalfPlane,
      ∃ (ρ₀ : ℝ) (r : ℕ), 0 < ρ₀ ∧ Metric.ball Z₀ ρ₀ ⊆ lmCompactRect r ∧
        Metric.ball Z₀ ρ₀ ⊆ lmLowerHalfPlane := by
    intro Z₀ hZ₀
    have h_im_neg : Z₀.im < 0 := hZ₀
    have h_pos : 0 < -Z₀.im := neg_pos.mpr h_im_neg
    let ρ₀ : ℝ := min 1 ((-Z₀.im) / 2)
    have hρ₀_pos : 0 < ρ₀ := lt_min zero_lt_one (half_pos h_pos)
    obtain ⟨r, hr⟩ := exists_nat_gt (max |Z₀.re| (max (-Z₀.im) (2 / (-Z₀.im))))
    have hr_re : |Z₀.re| < (r : ℝ) := lt_of_le_of_lt (le_max_left _ _) hr
    have hr_max2 : max (-Z₀.im) (2 / (-Z₀.im)) < (r : ℝ) :=
      lt_of_le_of_lt (le_max_right _ _) hr
    have hr_im : -Z₀.im < (r : ℝ) := lt_of_le_of_lt (le_max_left _ _) hr_max2
    have hr_inv : 2 / (-Z₀.im) < (r : ℝ) := lt_of_le_of_lt (le_max_right _ _) hr_max2
    have h_sub_rect : Metric.ball Z₀ ρ₀ ⊆ lmCompactRect r := by
      intro Z hZ
      rw [Metric.mem_ball, dist_eq_norm] at hZ
      have hρ_le_one : ρ₀ ≤ 1 := min_le_left _ _
      have hρ_le_half : ρ₀ ≤ (-Z₀.im) / 2 := min_le_right _ _
      have h_re_abs := abs_lt.mp (lt_of_le_of_lt
        (by simpa [Complex.sub_re] using Complex.abs_re_le_norm (Z - Z₀)) hZ)
      have h_im_abs := abs_lt.mp (lt_of_le_of_lt
        (by simpa [Complex.sub_im] using Complex.abs_im_le_norm (Z - Z₀)) hZ)
      have hZ₀_re_abs := abs_lt.mp hr_re
      have hr_pos2 : (0 : ℝ) < (r : ℝ) + 2 := by
        have : (0 : ℝ) ≤ (r : ℝ) := Nat.cast_nonneg r
        linarith
      have h_inv_bound : 1 / ((r : ℝ) + 2) ≤ (-Z₀.im) / 2 := by
        rw [div_le_div_iff₀ hr_pos2 (by norm_num : (0 : ℝ) < 2)]
        have h_lt : 2 < ((r : ℝ) + 2) * (-Z₀.im) := by
          have h1 : 2 < (r : ℝ) * (-Z₀.im) := (div_lt_iff₀ h_pos).mp hr_inv
          nlinarith
        linarith
      refine ⟨⟨?_, ?_⟩, ⟨?_, ?_⟩⟩
      · linarith [hZ₀_re_abs.1, h_re_abs.1, hρ_le_one]
      · linarith [hZ₀_re_abs.2, h_re_abs.2, hρ_le_one]
      · linarith [hr_im, h_im_abs.1, hρ_le_one]
      · linarith [h_im_abs.2, hρ_le_half, h_inv_bound]
    have h_sub_lhp : Metric.ball Z₀ ρ₀ ⊆ lmLowerHalfPlane := by
      intro Z hZ
      have hZ_rect := h_sub_rect hZ
      change Z.im < 0
      have hr_pos2 : (0 : ℝ) < (r : ℝ) + 2 := by
        have : (0 : ℝ) ≤ (r : ℝ) := Nat.cast_nonneg r
        linarith
      have h_neg : -(1 / ((r : ℝ) + 2)) < 0 := neg_neg_of_pos (one_div_pos.mpr hr_pos2)
      exact lt_of_le_of_lt hZ_rect.2.2 h_neg
    exact ⟨ρ₀, r, hρ₀_pos, h_sub_rect, h_sub_lhp⟩
  
  have h_montel : ∀ (G_seq : ℕ → ℂ → ℂ) (B_exhaust : ℕ → ℝ),
      (∀ r : ℕ, 0 < B_exhaust r) →
      (∀ r n : ℕ, r ≤ n → ∀ Z ∈ lmCompactRect r,
        DifferentiableAt ℂ (G_seq n) Z ∧ ‖G_seq n Z‖ ≤ B_exhaust r) →
      ∃ (ϕ : ℕ → ℕ) (G : ℂ → ℂ),
        StrictMono ϕ ∧
        DifferentiableOn ℂ G lmLowerHalfPlane ∧
        TendstoLocallyUniformlyOn
          (fun n Z => G_seq (ϕ n) Z) G Filter.atTop lmLowerHalfPlane := by
    intro G_seq B_exhaust hB_pos hG_bound
    let L_lip : ℕ → ℝ := fun r => B_exhaust (r + 1) / δ_rect r
    have hL_pos : ∀ r : ℕ, 0 < L_lip r := fun r => div_pos (hB_pos (r + 1)) (hδ_pos r)
    have hG_lip : ∀ (r n : ℕ), r + 1 ≤ n →
        ∀ Z₁ ∈ lmCompactRect r, ∀ Z₂ ∈ lmCompactRect r,
          ‖G_seq n Z₂ - G_seq n Z₁‖ ≤ L_lip r * ‖Z₂ - Z₁‖ := by
      intro r n hrn Z₁ hZ₁ Z₂ hZ₂
      have h_diff_r : ∀ Z ∈ lmCompactRect r, DifferentiableAt ℂ (G_seq n) Z :=
        fun Z hZ => (hG_bound r n (by omega) Z hZ).1
      have h_deriv_r : ∀ Z ∈ lmCompactRect r, ‖deriv (G_seq n) Z‖ ≤ L_lip r := by
        intro Z hZ
        have h_diff_r1 : DifferentiableOn ℂ (G_seq n) (lmCompactRect (r + 1)) :=
          fun W hW => (hG_bound (r + 1) n hrn W hW).1.differentiableWithinAt
        have h_dc : DiffContOnCl ℂ (G_seq n) (Metric.ball Z (δ_rect r)) :=
          h_diff_r1.diffContOnCl_ball (hRect_margin r Z hZ)
        have h_sph : ∀ W ∈ Metric.sphere Z (δ_rect r), ‖G_seq n W‖ ≤ B_exhaust (r + 1) :=
          fun W hW => (hG_bound (r + 1) n hrn W
            (hRect_margin r Z hZ (Metric.sphere_subset_closedBall hW))).2
        exact Complex.norm_deriv_le_of_forall_mem_sphere_norm_le (hδ_pos r) h_dc h_sph
      exact Convex.norm_image_sub_le_of_norm_deriv_le h_diff_r h_deriv_r
        (hRect_conv r) hZ₁ hZ₂
    let G_trunc : ℕ → ℕ → ℂ → ℂ := fun r n Z => if r + 1 ≤ n then G_seq n Z else 0
    have h_step : ∀ (r : ℕ) (τ : ℕ → ℕ), StrictMono τ →
        ∃ ρ : ℕ → ℕ, StrictMono ρ ∧
          ∃ g : ℂ → ℂ,
            TendstoUniformlyOn (fun m Z => G_seq (τ (ρ m)) Z) g Filter.atTop (lmCompactRect r) := by
      intro r τ hτ
      let K_r := ↥(lmCompactRect r)
      have : CompactSpace K_r := isCompact_iff_compactSpace.mp (hRect_compact r)
      let L_nnr : NNReal := ⟨L_lip r, (hL_pos r).le⟩
      have h_trunc_lip : ∀ n : ℕ, LipschitzWith L_nnr (fun z : K_r => G_trunc r n z.1) := by
        intro n
        refine LipschitzWith.of_dist_le_mul (fun z₁ z₂ => ?_)
        dsimp [G_trunc, L_nnr]
        split_ifs with h_rn
        · rw [dist_eq_norm, Subtype.dist_eq, dist_eq_norm]
          exact hG_lip r n h_rn z₂.1 z₂.2 z₁.1 z₁.2
        · simp only [dist_self]
          exact mul_nonneg (hL_pos r).le dist_nonneg
      have h_trunc_bdd : ∀ (n : ℕ) (z : K_r),
          G_trunc r n z.1 ∈ Metric.closedBall (0 : ℂ) (B_exhaust r) := by
        intro n z
        rw [Metric.mem_closedBall, dist_zero_right]
        dsimp [G_trunc]
        split_ifs with h_rn
        · exact (hG_bound r n (by omega) z.1 z.2).2
        · simp [(hB_pos r).le]
      let Ψ : ℕ → BoundedContinuousFunction K_r ℂ := fun n =>
        BoundedContinuousFunction.mkOfCompact ⟨fun z => G_trunc r n z.1, (h_trunc_lip n).continuous⟩
      let A : Set (BoundedContinuousFunction K_r ℂ) := Set.range (fun k : ℕ => Ψ (τ k))
      have hA_maps : ∀ (f : BoundedContinuousFunction K_r ℂ) (z : K_r),
          f ∈ A → f z ∈ Metric.closedBall (0 : ℂ) (B_exhaust r) := by
        intro f z hf
        rcases hf with ⟨k, rfl⟩
        simpa [Ψ] using h_trunc_bdd (τ k) z
      have hA_equi : Equicontinuous (fun x : ↥A => (⇑(x.1) : K_r → ℂ)) := by
        refine (LipschitzWith.uniformEquicontinuous
          (fun x : ↥A => (⇑(x.1) : K_r → ℂ)) L_nnr ?_).equicontinuous
        intro x
        rcases x.2 with ⟨k, hk⟩
        have h_eq : (⇑(x.1) : K_r → ℂ) = fun z : K_r => G_trunc r (τ k) z.1 := by
          ext z
          rw [← hk]
          simp [Ψ]
        rw [h_eq]
        exact h_trunc_lip (τ k)
      have hA_compact : IsCompact (closure A) :=
        BoundedContinuousFunction.arzela_ascoli
          (Metric.closedBall (0 : ℂ) (B_exhaust r))
          (isCompact_closedBall (0 : ℂ) (B_exhaust r))
          A hA_maps hA_equi
      obtain ⟨g_bcf, _, ρ, hρ_mono, hρ_conv⟩ :=
        hA_compact.tendsto_subseq (fun k => subset_closure (Set.mem_range_self k))
      have h_unif_sub : TendstoUniformly
          (fun m (z : K_r) => G_trunc r (τ (ρ m)) z.1) (⇑g_bcf) Filter.atTop := by
        have h1 := BoundedContinuousFunction.tendsto_iff_tendstoUniformly.mp hρ_conv
        have h_fn : (fun i (z : K_r) => (Ψ (τ (ρ i))) z) =
            (fun m (z : K_r) => G_trunc r (τ (ρ m)) z.1) := by
          ext i z
          simp [Ψ]
        simpa only [Function.comp_def, h_fn] using h1
      let g_ext : ℂ → ℂ := fun Z => by
        classical
        exact if hZ : Z ∈ lmCompactRect r then g_bcf ⟨Z, hZ⟩ else 0
      have h_coe_eq : g_ext ∘ Subtype.val = ⇑g_bcf := by
        ext z
        simp [g_ext, z.2]
      have h_unif_trunc : TendstoUniformlyOn
          (fun m Z => G_trunc r (τ (ρ m)) Z) g_ext Filter.atTop (lmCompactRect r) := by
        rw [tendstoUniformlyOn_iff_tendstoUniformly_comp_coe, h_coe_eq]
        exact h_unif_sub
      have h_unif_seq : TendstoUniformlyOn
          (fun m Z => G_seq (τ (ρ m)) Z) g_ext Filter.atTop (lmCompactRect r) := by
        refine h_unif_trunc.congr ?_
        filter_upwards [Filter.eventually_ge_atTop (r + 1)] with m hm Z _
        have h_ge : r + 1 ≤ τ (ρ m) :=
          le_trans hm ((hτ.comp hρ_mono).id_le m)
        dsimp only [G_trunc]
        split_ifs
        rfl
      exact ⟨ρ, hρ_mono, g_ext, h_unif_seq⟩
    let SubseqType := {f : ℕ → ℕ // StrictMono f}
    let next_sub : ℕ → SubseqType → SubseqType := fun r τ =>
      let ρ := Classical.choose (h_step r τ.1 τ.2)
      have hρ : StrictMono ρ := (Classical.choose_spec (h_step r τ.1 τ.2)).1
      ⟨τ.1 ∘ ρ, τ.2.comp hρ⟩
    let τ_chain : ℕ → SubseqType := fun r =>
      Nat.rec (next_sub 0 ⟨id, strictMono_id⟩) (fun k prev => next_sub (k + 1) prev) r
    have h_chain_unif : ∀ r : ℕ, ∃ g_r : ℂ → ℂ,
        TendstoUniformlyOn (fun m Z => G_seq ((τ_chain r).1 m) Z)
          g_r Filter.atTop (lmCompactRect r) := by
      intro r
      cases r with
      | zero =>
        exact (Classical.choose_spec (h_step 0 id strictMono_id)).2
      | succ k =>
