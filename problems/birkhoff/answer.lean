        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun r _ => ?_
        rw [mul_inv, inv_pow]; ring
      rw [heq, geom_sum_eq (by norm_num : (2⁻¹ : ℝ) ≠ 1) (n + 1)]
      have hp : (0 : ℝ) < (2⁻¹ : ℝ) ^ (n + 1) := by positivity
      have hd : (2⁻¹ : ℝ) - 1 = -1 / 2 := by norm_num
      rw [hd]
      linarith
    have hP_props : ∀ j : ℕ,
        (∀ x : ℝ, 0 ≤ P_pen j x) ∧
        (∃ x : ℝ, 1 / 2 < H_row j x - P_pen j x) := by
      intro j
