      htanh_eq, hsech_sq, _, hPhi_bound, hPhi_lt_tenth, hPhi_slit, hPhi_ne⟩ := hS0_q z hz
    have hΛ_c_ne : (Λ : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hΛ_pos.ne'
    have hlam_ne : lamZ z ≠ 0 :=
