    let ϕ₀ : ℂ := K.ϕ s₀
    have mp1_ne : ((m + 1 : ℕ) : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
    let G_ϕ : ℂ → ℂ := fun w => K.ϕ (s₀ + w) - ϕ₀ - (α / ((m + 1 : ℕ) : ℂ)) * w ^ (m + 1)
    have hG_ϕ_0 : G_ϕ 0 = 0 := by simp [G_ϕ, ϕ₀]
    have hG_ϕ_deriv : ∀ w ∈ Metric.ball (0 : ℂ) R₀,
