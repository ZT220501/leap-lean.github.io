      have h2 : G₂.num p q * G₂.den q₀ q = G₂.num q₀ q * G₂.den p q :=
        G₂.compat p hp_W2 q₀ hq₀ q ⟨hη₁_sub_p hq, hη₁_sub_q0 hq⟩
      dsimp [D]
