          by_cases h1 : (m : ℕ) < l
          · exact Or.inl h1
          · right
            by_cases h2 : (m : ℕ) = l
            · exact Or.inl (Fin.ext h2)
            · exact Or.inr (by omega)
        have hdisj1 : Disjoint
            (Finset.univ.filter (fun m : Fin (J + 1) => (m : ℕ) < l))
            (insert l_fin S_gt) := by
          rw [Finset.disjoint_left]
          intro m hm1 hm2
          simp only [Finset.mem_filter, Finset.mem_insert, S_gt, Fin.ext_iff] at hm1 hm2
          dsimp [l_fin] at hm2
          omega
