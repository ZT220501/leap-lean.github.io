          contDiff_const.mul ((hψ2_pt α hα).1.of_le (by exact_mod_cast Nat.le_succ m))
        have hu_le_B : ∀ k : ℕ, 1 ≤ k → k ≤ m → ∀ z : ℝ,
            |iteratedDeriv k u1 z| ≤ B_inv ∧ |iteratedDeriv k u2 z| ≤ B_inv := by
          intro k _ hk z
          have hb1 : |iteratedDeriv k u1 z| ≤ B_inv := by
            have hc : ContDiffAt ℝ (k : WithTop ℕ∞) (ψ w₁ α) z :=
              ((hψ1_pt α hα).1.of_le (by exact_mod_cast Nat.le_succ_of_le hk)).contDiffAt
            dsimp only [u1]
            rw [iteratedDeriv_const_mul (-(n : ℝ)) hc, abs_mul, abs_neg, hAbs_n_eq_q]
            have h := (hψ1_pt α hα).2 k (Nat.le_succ_of_le hk) z
            have hq_div : (q : ℝ) * |iteratedDeriv k (ψ w₁ α) z| ≤ H_inv.C_inv / (q : ℝ) := by
              calc (q : ℝ) * |iteratedDeriv k (ψ w₁ α) z|
                  ≤ (q : ℝ) * (H_inv.C_inv / (q : ℝ) ^ 2) :=
                    mul_le_mul_of_nonneg_left h (le_of_lt hq_pos)
                _ = H_inv.C_inv / (q : ℝ) := by field_simp
            exact le_trans hq_div
              (le_trans (div_le_self (le_of_lt hC_inv_pos) hq_ge_one) (by simp [B_inv]))
          have hb2 : |iteratedDeriv k u2 z| ≤ B_inv := by
            have hc : ContDiffAt ℝ (k : WithTop ℕ∞) (ψ w₂ α) z :=
              ((hψ2_pt α hα).1.of_le (by exact_mod_cast Nat.le_succ_of_le hk)).contDiffAt
            dsimp only [u2]
            rw [iteratedDeriv_const_mul (-(n : ℝ)) hc, abs_mul, abs_neg, hAbs_n_eq_q]
            have h := (hψ2_pt α hα).2 k (Nat.le_succ_of_le hk) z
            have hq_div : (q : ℝ) * |iteratedDeriv k (ψ w₂ α) z| ≤ H_inv.C_inv / (q : ℝ) := by
              calc (q : ℝ) * |iteratedDeriv k (ψ w₂ α) z|
                  ≤ (q : ℝ) * (H_inv.C_inv / (q : ℝ) ^ 2) :=
                    mul_le_mul_of_nonneg_left h (le_of_lt hq_pos)
                _ = H_inv.C_inv / (q : ℝ) := by field_simp
            exact le_trans hq_div
              (le_trans (div_le_self (le_of_lt hC_inv_pos) hq_ge_one) (by simp [B_inv]))
          exact ⟨hb1, hb2⟩
        have hu_diff : ∀ k : ℕ, k ≤ m → ∀ z : ℝ,
            |iteratedDeriv k (fun y => u1 y - u2 y) z| ≤ (H_inv.C_inv / (q : ℝ)) * Δw := by
          intro k hk z
          have hEq : (fun y => u1 y - u2 y) = fun y => -(n : ℝ) * (ψ w₁ α y - ψ w₂ α y) := by
            funext y; dsimp only [u1, u2]; ring
          have hc : ContDiffAt ℝ (k : WithTop ℕ∞) (fun y => ψ w₁ α y - ψ w₂ α y) z :=
            (((hψ1_pt α hα).1.sub (hψ2_pt α hα).1).of_le
              (by exact_mod_cast Nat.le_succ_of_le hk)).contDiffAt
          rw [hEq, iteratedDeriv_const_mul (-(n : ℝ)) hc, abs_mul, abs_neg, hAbs_n_eq_q]
          have h := hψ_lip k (Nat.le_succ_of_le hk) z
          calc (q : ℝ) * |iteratedDeriv k (fun y => ψ w₁ α y - ψ w₂ α y) z|
              ≤ (q : ℝ) * ((H_inv.C_inv / (q : ℝ) ^ 2) * Δw) :=
                mul_le_mul_of_nonneg_left h (le_of_lt hq_pos)
            _ = (H_inv.C_inv / (q : ℝ)) * Δw := by field_simp
        have hg_diff := hComp_same_diff (𝔸 := ℂ) m B_inv 1 ((H_inv.C_inv / (q : ℝ)) * Δw)
          g_osc u1 u2 zero_le_one (by positivity)
          (hg_osc_cd.of_le le_top) hu1_cd hu2_cd
          (fun k _ x => le_of_eq (hg_osc_norm k x))
          hu_le_B hu_diff
        have hOsc_jet : HasCJetℂ_moab m ((C_E / (q : ℝ)) * Δw)
            (fun y => g_osc (u1 y) - g_osc (u2 y)) := by
          refine ⟨(((hg_osc_cd.of_le le_top).comp hu1_cd).sub
            ((hg_osc_cd.of_le le_top).comp hu2_cd)), by positivity, ?_⟩
          intro k hk z
          refine le_trans (hg_diff k hk z) ?_
          have hc2_le : c2_moab m B_inv ≤ C_calc := le_max_right _ _
          calc c2_moab m B_inv * 1 * ((H_inv.C_inv / (q : ℝ)) * Δw)
              ≤ C_calc * ((H_inv.C_inv / (q : ℝ)) * Δw) := by
                rw [mul_one]
                exact mul_le_mul_of_nonneg_right hc2_le (by positivity)
            _ = (C_E / (q : ℝ)) * Δw := by dsimp only [C_E]; ring
        have hEq : (fun y => E_fn w₁ α y - E_fn w₂ α y) =
            fun y => E0_fn α * (g_osc (u1 y) - g_osc (u2 y)) := by
          funext y; dsimp only [E_fn, u1, u2]; ring
        rw [hEq]
        have hm1 := hJet_const_mul (E0_fn α) hOsc_jet
        have hnorm1 : ‖E0_fn α‖ = 1 := by
          dsimp only [E0_fn]
          simpa [mul_comm] using Complex.norm_exp_ofReal_mul_I (Real.pi * σ_n * τ α)
        rw [hnorm1, one_mul] at hm1
        exact hm1
      have hP_lip : HasCJetℂ_moab m ((C'_P / (q : ℝ) ^ 4) * Δw)
          (fun y => A_fn w₁ α y * B_fn w₁ α y - A_fn w₂ α y * B_fn w₂ α y) :=
        hJet_mono (le_of_eq (by dsimp only [C'_P]; ring))
          (hJet_mul_diff hA2 hB1 hA_lip hB_lip)
      have hQ_lip : HasCJetℂ_moab m ((C'_Q / (q : ℝ)) * Δw)
          (fun y => J_fn w₁ α y * E_fn w₁ α y - J_fn w₂ α y * E_fn w₂ α y) := by
        have hm1 := hJet_mul_diff hJ2 hE1 hJ_lip hE_lip
        refine hJet_mono ?_ hm1
        have hle : H_inv.C_inv / (q : ℝ) ^ 2 ≤ H_inv.C_inv / (q : ℝ) := by
          simpa [pow_one] using
            div_le_div_of_nonneg_left (le_of_lt hC_inv_pos) (by positivity)
              (pow_le_pow_right₀ hq_ge_one (by omega : 1 ≤ 2))
        have hle' : ((H_inv.C_inv / (q : ℝ) ^ 2) * Δw) * M_E ≤
            ((H_inv.C_inv * M_E) / (q : ℝ)) * Δw := by
          calc ((H_inv.C_inv / (q : ℝ) ^ 2) * Δw) * M_E
              = (H_inv.C_inv / (q : ℝ) ^ 2) * (Δw * M_E) := by ring
            _ ≤ (H_inv.C_inv / (q : ℝ)) * (Δw * M_E) :=
                mul_le_mul_of_nonneg_right hle (by positivity)
            _ = ((H_inv.C_inv * M_E) / (q : ℝ)) * Δw := by ring
        have h2m_nn : (0 : ℝ) ≤ (2 : ℝ) ^ m := by positivity
        have hinner : ((H_inv.C_inv / (q : ℝ) ^ 2) * Δw) * M_E +
            M_J * ((C_E / (q : ℝ)) * Δw) ≤
            ((H_inv.C_inv * M_E + M_J * C_E) / (q : ℝ)) * Δw := by
          have h2 : ((H_inv.C_inv * M_E) / (q : ℝ)) * Δw + M_J * ((C_E / (q : ℝ)) * Δw) =
              ((H_inv.C_inv * M_E + M_J * C_E) / (q : ℝ)) * Δw := by ring
          linarith
        calc (2 : ℝ) ^ m * (((H_inv.C_inv / (q : ℝ) ^ 2) * Δw) * M_E +
                M_J * ((C_E / (q : ℝ)) * Δw))
            ≤ (2 : ℝ) ^ m * (((H_inv.C_inv * M_E + M_J * C_E) / (q : ℝ)) * Δw) :=
              mul_le_mul_of_nonneg_left hinner h2m_nn
          _ = (C'_Q / (q : ℝ)) * Δw := by dsimp only [C'_Q]; ring
      have hEqTot : (fun y => halfTerm w₁ α y - halfTerm w₂ α y) =
          fun y => (A_fn w₁ α y * B_fn w₁ α y) * (J_fn w₁ α y * E_fn w₁ α y) -
            (A_fn w₂ α y * B_fn w₂ α y) * (J_fn w₂ α y * E_fn w₂ α y) := by
        funext y
        rw [hHalfTerm_factor w₁ hw₁ α hα, hHalfTerm_factor w₂ hw₂ α hα]
      rw [hEqTot]
      exact hJet_mono (le_of_eq (by dsimp only [C'_half]; ring))
        (hJet_mul_diff hP2 hQ1 hP_lip hQ_lip)

  
  
  
  obtain ⟨rawFn, hRawFn⟩ : ∃ F : (ℝ → ℝ) → ℕ → ℝ → ℝ → ℂ, F = rawCellIntegrand_moab n :=
    ⟨rawCellIntegrand_moab n, rfl⟩
  obtain ⟨leadFn, hLeadFn⟩ : ∃ L : ℝ → ℂ, L = leadCellIntegrand_moab n :=
    ⟨leadCellIntegrand_moab n, rfl⟩

  have hCellAll : ∀ (j : ℕ), j < q →
      (∀ (w : ℝ → ℝ), IsPeriodicSmoothBounded (m + 15) M w →
        (∀ α ∈ Set.Icc (0 : ℝ) 1,
          ContDiff ℝ (m : WithTop ℕ∞) (rawFn w j α) ∧
          HasCJetℂ_moab m (C_cell / (q : ℝ) ^ 4)
            (fun y => rawFn w j α y - leadFn α)) ∧
        (∀ k : ℕ, k ≤ m →
          ContinuousOn (fun p : ℝ × ℝ => iteratedDeriv k (rawFn w j p.1) p.2)
            (Set.Icc (0 : ℝ) 1 ×ˢ Set.univ))) ∧
      (∀ (w₁ w₂ : ℝ → ℝ) (α : ℝ),
        IsPeriodicSmoothBounded (m + 15) M w₁ →
        IsPeriodicSmoothBounded (m + 15) M w₂ →
        α ∈ Set.Icc (0 : ℝ) 1 →
        HasCJetℂ_moab m ((C_cell / (q : ℝ) ^ 4) * realDiffSup (m + 15) w₁ w₂)
          (fun y => rawFn w₁ j α y - rawFn w₂ j α y)) := by
    intro j hj
    have hMinus := hHalfCell j hj k0Minus
      (fun w => fwdKernelMinus q w j)
      (fun w => halfCellInvDispMinus q w j)
      (fun w => halfCellInvMinus_ℝ q w j)
      1 (fun α => α)
      (Or.inl rfl) continuous_id hk0Minus_bnd
      (fun w α z => by unfold halfCellInvDispMinus; ring)
      (fun w hw => by
        obtain ⟨hInvCont, hInvPt⟩ := H_inv.inv_props q w j hq_inv hw hj
        obtain ⟨hKernCont, hKernPt⟩ := H_kern.kern_props q w j hq_kern hw hj
        exact ⟨fun k hk => (hInvCont k hk).1,
          fun α hα => by
            obtain ⟨_, _, hDispM_cd, _, _, _, _, _, _, _, _, _, _, _, hDisp_bnd⟩ := hInvPt α hα
            exact ⟨hDispM_cd, fun k hk z => (hDisp_bnd k hk z).1⟩,
          fun k hk => (hKernCont k hk).1,
          fun α hα => ⟨(hKernPt α hα).1, fun k hk x => ((hKernPt α hα).2.2 k hk x).1⟩⟩)
      (fun w₁ w₂ α hw₁ hw₂ hα =>
        ⟨fun k hk z => (H_inv.inv_lip q w₁ w₂ j α hq_inv hw₁ hw₂ hj hα k hk z).1,
         fun k hk x => (H_kern.kern_lip q w₁ w₂ j α hq_kern hw₁ hw₂ hj hα k hk x).1⟩)
    have hPlus := hHalfCell j hj k0Plus
      (fun w => fwdKernelPlus q w j)
      (fun w => halfCellInvDispPlus q w j)
      (fun w => halfCellInvPlus_ℝ q w j)
      (-1) (fun α => 1 + α)
      (Or.inr rfl) (continuous_const.add continuous_id) hk0Plus_bnd
      (fun w α z => by unfold halfCellInvDispPlus; ring)
      (fun w hw => by
        obtain ⟨hInvCont, hInvPt⟩ := H_inv.inv_props q w j hq_inv hw hj
        obtain ⟨hKernCont, hKernPt⟩ := H_kern.kern_props q w j hq_kern hw hj
        exact ⟨fun k hk => (hInvCont k hk).2,
          fun α hα => by
            obtain ⟨_, _, _, hDispP_cd, _, _, _, _, _, _, _, _, _, _, hDisp_bnd⟩ := hInvPt α hα
            exact ⟨hDispP_cd, fun k hk z => (hDisp_bnd k hk z).2⟩,
          fun k hk => (hKernCont k hk).2,
          fun α hα => ⟨(hKernPt α hα).2.1, fun k hk x => ((hKernPt α hα).2.2 k hk x).2⟩⟩)
      (fun w₁ w₂ α hw₁ hw₂ hα =>
        ⟨fun k hk z => (H_inv.inv_lip q w₁ w₂ j α hq_inv hw₁ hw₂ hj hα k hk z).2,
         fun k hk x => (H_kern.kern_lip q w₁ w₂ j α hq_kern hw₁ hw₂ hj hα k hk x).2⟩)

    let halfTerm_m : (ℝ → ℝ) → ℝ → ℝ → ℂ := fun w α z =>
      let x := halfCellInvMinus_ℝ q w j α z
      let ℓ := (realMeshDisp q w (j + 1) x - realMeshDisp q w j x) / 2 +
        1 * realMidpointDisp q w j x
      ((fwdKernelMinus q w j α x * (Real.pi / (q : ℝ) + ℓ) *
        deriv (halfCellInvMinus_ℝ q w j α) z : ℝ) : ℂ) *
        Complex.exp (-Complex.I * (n : ℂ) * ((x - z : ℝ) : ℂ))
    let halfTerm_p : (ℝ → ℝ) → ℝ → ℝ → ℂ := fun w α z =>
      let x := halfCellInvPlus_ℝ q w j α z
      let ℓ := (realMeshDisp q w (j + 1) x - realMeshDisp q w j x) / 2 +
        (-1) * realMidpointDisp q w j x
      ((fwdKernelPlus q w j α x * (Real.pi / (q : ℝ) + ℓ) *
        deriv (halfCellInvPlus_ℝ q w j α) z : ℝ) : ℂ) *
        Complex.exp (-Complex.I * (n : ℂ) * ((x - z : ℝ) : ℂ))
    let leadHalf_m : ℝ → ℂ := fun α =>
      ((Real.pi / (q : ℝ) ^ 3 : ℝ) : ℂ) *
        ((k0Minus α : ℂ) * Complex.exp (Complex.I * ((Real.pi * σ_n * α : ℝ) : ℂ)))
    let leadHalf_p : ℝ → ℂ := fun α =>
      ((Real.pi / (q : ℝ) ^ 3 : ℝ) : ℂ) *
        ((k0Plus α : ℂ) * Complex.exp (Complex.I * ((Real.pi * σ_n * (1 + α) : ℝ) : ℂ)))

    have hRawEq : ∀ (w : ℝ → ℝ), IsPeriodicSmoothBounded (m + 15) M w →
        ∀ α ∈ Set.Icc (0 : ℝ) 1,
          rawFn w j α = fun z => halfTerm_m w α z + halfTerm_p w α z := by
      intro w hw α hα
      rw [hRawFn]
      obtain ⟨_, hInvPt⟩ := H_inv.inv_props q w j hq_inv hw hj
      obtain ⟨_, _, _, _, _, _, _, _, _, hRight_m, _, hRight_p, _, _, _⟩ := hInvPt α hα
      funext z
      dsimp only [rawCellIntegrand_moab, halfTerm_m, halfTerm_p]
      have hKm : cellKernelMinus_ℝ w (realMesh q w (halfCellInvMinus_ℝ q w j α z) j)
          (realMesh q w (halfCellInvMinus_ℝ q w j α z) (j + 1)) z =
          fwdKernelMinus q w j α (halfCellInvMinus_ℝ q w j α z) := by
        unfold fwdKernelMinus; rw [hRight_m z]
      have hKp : cellKernelPlus_ℝ w (realMesh q w (halfCellInvPlus_ℝ q w j α z) j)
          (realMesh q w (halfCellInvPlus_ℝ q w j α z) (j + 1)) z =
          fwdKernelPlus q w j α (halfCellInvPlus_ℝ q w j α z) := by
        unfold fwdKernelPlus; rw [hRight_p z]
      have hStep_m : ∀ x : ℝ,
          midpoint_ℝ w (realMesh q w x j) (realMesh q w x (j + 1)) - realMesh q w x j =
            Real.pi / (q : ℝ) + ((realMeshDisp q w (j + 1) x - realMeshDisp q w j x) / 2 +
              1 * realMidpointDisp q w j x) := by
        intro x; unfold realMeshDisp realMidpointDisp; push_cast; field_simp; ring
      have hStep_p : ∀ x : ℝ,
          realMesh q w x (j + 1) - midpoint_ℝ w (realMesh q w x j) (realMesh q w x (j + 1)) =
            Real.pi / (q : ℝ) + ((realMeshDisp q w (j + 1) x - realMeshDisp q w j x) / 2 +
              (-1) * realMidpointDisp q w j x) := by
        intro x; unfold realMeshDisp realMidpointDisp; push_cast; field_simp; ring
      change (((cellKernelMinus_ℝ w (realMesh q w (halfCellInvMinus_ℝ q w j α z) j)
            (realMesh q w (halfCellInvMinus_ℝ q w j α z) (j + 1)) z *
          (midpoint_ℝ w (realMesh q w (halfCellInvMinus_ℝ q w j α z) j)
            (realMesh q w (halfCellInvMinus_ℝ q w j α z) (j + 1)) -
            realMesh q w (halfCellInvMinus_ℝ q w j α z) j) *
          deriv (halfCellInvMinus_ℝ q w j α) z : ℝ) : ℂ) * _ +
        ((cellKernelPlus_ℝ w (realMesh q w (halfCellInvPlus_ℝ q w j α z) j)
            (realMesh q w (halfCellInvPlus_ℝ q w j α z) (j + 1)) z *
          (realMesh q w (halfCellInvPlus_ℝ q w j α z) (j + 1) -
            midpoint_ℝ w (realMesh q w (halfCellInvPlus_ℝ q w j α z) j)
              (realMesh q w (halfCellInvPlus_ℝ q w j α z) (j + 1))) *
          deriv (halfCellInvPlus_ℝ q w j α) z : ℝ) : ℂ) * _) = _
      rw [hKm, hKp, hStep_m (halfCellInvMinus_ℝ q w j α z), hStep_p (halfCellInvPlus_ℝ q w j α z)]

    have hLeadEq : ∀ α : ℝ, leadFn α = leadHalf_m α + leadHalf_p α := by
      intro α; rw [hLeadFn]; dsimp only [leadCellIntegrand_moab, leadHalf_m, leadHalf_p]; ring

    refine ⟨?_, ?_⟩
    · intro w hw
      obtain ⟨hM_pt, hM_cont⟩ := hMinus.1 w hw
      obtain ⟨hP_pt, hP_cont⟩ := hPlus.1 w hw
      refine ⟨?_, ?_⟩
      · intro α hα
        have hcd : ContDiff ℝ (m : WithTop ℕ∞) (rawFn w j α) := by
          rw [hRawEq w hw α hα]
          exact (hM_pt α hα).1.add (hP_pt α hα).1
        have hRem : HasCJetℂ_moab m (C_cell / (q : ℝ) ^ 4)
            (fun y => rawFn w j α y - leadFn α) := by
          have hEq : (fun y => rawFn w j α y - leadFn α) =
              fun y => (halfTerm_m w α y - leadHalf_m α) + (halfTerm_p w α y - leadHalf_p α) := by
            funext y; rw [hRawEq w hw α hα, hLeadEq α]; ring
          rw [hEq]
          have hAdd := hJet_add (hM_pt α hα).2 (hP_pt α hα).2
          refine hJet_mono ?_ hAdd
          have hmax : C_half ≤ max C_half C'_half := le_max_left _ _
          have hle : C_half + C_half ≤ C_cell := by dsimp only [C_cell]; linarith
          rw [← add_div]
          exact div_le_div_of_nonneg_right hle (by positivity)
        exact ⟨hcd, hRem⟩
      · intro k hk
        have hSumCont : ContinuousOn
            (fun p : ℝ × ℝ =>
              iteratedDeriv k (halfTerm_m w p.1) p.2 + iteratedDeriv k (halfTerm_p w p.1) p.2)
            (Set.Icc (0 : ℝ) 1 ×ˢ Set.univ) :=
          (hM_cont k hk).add (hP_cont k hk)
        refine hSumCont.congr fun p hp => ?_
        rw [hRawEq w hw p.1 hp.1]
        exact iteratedDeriv_fun_add
          (((hM_pt p.1 hp.1).1).of_le (by exact_mod_cast hk)).contDiffAt
          (((hP_pt p.1 hp.1).1).of_le (by exact_mod_cast hk)).contDiffAt
    · intro w₁ w₂ α hw₁ hw₂ hα
      have hM_lip := hMinus.2 w₁ w₂ α hw₁ hw₂ hα
      have hP_lip := hPlus.2 w₁ w₂ α hw₁ hw₂ hα
      have hEq : (fun y => rawFn w₁ j α y - rawFn w₂ j α y) =
          fun y => (halfTerm_m w₁ α y - halfTerm_m w₂ α y) +
            (halfTerm_p w₁ α y - halfTerm_p w₂ α y) := by
        funext y; rw [hRawEq w₁ hw₁ α hα, hRawEq w₂ hw₂ α hα]; ring
      rw [hEq]
      have hAdd := hJet_add hM_lip hP_lip
      refine hJet_mono ?_ hAdd
      let Δw := realDiffSup (m + 15) w₁ w₂
      have hΔw_nn : 0 ≤ Δw := hDiffSup_nonneg w₁ w₂
      have hmax : C'_half ≤ max C_half C'_half := le_max_right _ _
      have hle : C'_half + C'_half ≤ C_cell := by dsimp only [C_cell]; linarith
      calc (C'_half / (q : ℝ) ^ 4) * Δw + (C'_half / (q : ℝ) ^ 4) * Δw
          = ((C'_half + C'_half) / (q : ℝ) ^ 4) * Δw := by ring
        _ ≤ (C_cell / (q : ℝ) ^ 4) * Δw :=
            mul_le_mul_of_nonneg_right
              (div_le_div_of_nonneg_right hle (by positivity)) hΔw_nn

  have hGlobalB_eq : ∀ (w : ℝ → ℝ), IsPeriodicSmoothBounded (m + 15) M w →
      globalB_mult n w = fun y : ℝ =>
        -(((q : ℝ) ^ 2 / (6 * Real.pi) : ℝ) : ℂ) *
          ∑ j ∈ Finset.range q, ∫ α in (0 : ℝ)..1, rawFn w j α y := by
    intro w hw
    rw [hRawFn]
    have hMesh : HasUniqueGlobalMesh q w := (S.real_mesh_props q w hq_mesh (hWeakenM hw)).1
    funext y
    simp only [globalB_mult, hn_ne, ↓reduceIte, show HasUniqueGlobalMesh n.natAbs w from hMesh]
    rfl

  have hLead_cont : Continuous leadFn := by
    rw [hLeadFn]
    unfold leadCellIntegrand_moab k0Minus k0Plus
    fun_prop

  have hLeadSumEqOne : -(((q : ℝ) ^ 2 / (6 * Real.pi) : ℝ) : ℂ) *
      ∑ _j ∈ Finset.range q, (∫ α in (0 : ℝ)..1, leadFn α) = 1 := by
    rw [hLeadFn]
    exact hLeadEqOne n hn_ne

  have hSlice_int : ∀ (w : ℝ → ℝ), IsPeriodicSmoothBounded (m + 15) M w →
      ∀ j < q, ∀ y : ℝ, IntervalIntegrable (fun α => rawFn w j α y) MeasureTheory.volume 0 1 := by
    intro w hw j hj y
    have h0 : ContinuousOn (fun p : ℝ × ℝ => rawFn w j p.1 p.2)
        (Set.Icc (0 : ℝ) 1 ×ˢ Set.univ) := by
      simpa [iteratedDeriv_zero] using ((hCellAll j hj).1 w hw).2 0 (Nat.zero_le _)
    have hMap : ContinuousOn (fun α : ℝ => (α, y)) (Set.uIcc (0 : ℝ) 1) :=
      continuous_id.continuousOn.prodMk continuousOn_const
    have hSub : Set.MapsTo (fun α : ℝ => (α, y)) (Set.uIcc (0 : ℝ) 1)
        (Set.Icc (0 : ℝ) 1 ×ˢ Set.univ) := by
      intro α hα
      rw [Set.uIcc_of_le zero_le_one] at hα
      exact ⟨hα, trivial⟩
    exact (h0.comp hMap hSub).intervalIntegrable

  refine ⟨?_, ?_⟩
  · intro w hw
    have hCell_cd : ∀ j ∈ Finset.range q,
        ContDiff ℝ (m : WithTop ℕ∞) (fun y => ∫ α in (0 : ℝ)..1, rawFn w j α y) := by
      intro j hj_mem
      have hj : j < q := Finset.mem_range.mp hj_mem
      obtain ⟨hPt, hCont⟩ := (hCellAll j hj).1 w hw
      exact (hParamInt m (rawFn w j) (fun α hα => (hPt α hα).1) hCont).1
    have hGlobal_cd : ContDiff ℝ (m : WithTop ℕ∞) (globalB_mult n w) := by
      rw [hGlobalB_eq w hw]
      exact contDiff_const.mul (ContDiff.sum fun j hj => hCell_cd j hj)
    have hRemCell_jet : ∀ j ∈ Finset.range q,
        HasCJetℂ_moab m (C_cell / (q : ℝ) ^ 4)
          (fun y => ∫ α in (0 : ℝ)..1, (rawFn w j α y - leadFn α)) := by
      intro j hj_mem
      have hj : j < q := Finset.mem_range.mp hj_mem
      obtain ⟨hPt, hCont⟩ := (hCellAll j hj).1 w hw
      refine hParamJet m (C_cell / (q : ℝ) ^ 4)
        (fun α y => rawFn w j α y - leadFn α)
        (by positivity) (fun α hα => (hPt α hα).2) ?_
      intro k hk
      cases k with
      | zero =>
        have h0 : ContinuousOn (fun p : ℝ × ℝ => rawFn w j p.1 p.2)
            (Set.Icc (0 : ℝ) 1 ×ˢ Set.univ) := by
          simpa [iteratedDeriv_zero] using hCont 0 (Nat.zero_le _)
        have hSubCont : ContinuousOn
            (fun p : ℝ × ℝ => rawFn w j p.1 p.2 - leadFn p.1)
            (Set.Icc (0 : ℝ) 1 ×ˢ Set.univ) :=
          h0.sub (hLead_cont.comp continuous_fst).continuousOn
        simpa [iteratedDeriv_zero] using hSubCont
      | succ k' =>
        refine (hCont (k' + 1) hk).congr fun p _ => ?_
        rw [iteratedDeriv_succ',
          show deriv (fun y => rawFn w j p.1 y - leadFn p.1) =
            deriv (rawFn w j p.1) from funext fun y => deriv_sub_const _,
          ← iteratedDeriv_succ']
    have hSumRem_jet := hJet_finset_sum m (Finset.range q) (C_cell / (q : ℝ) ^ 4)
      (fun j y => ∫ α in (0 : ℝ)..1, (rawFn w j α y - leadFn α))
      (by positivity) hRemCell_jet
    rw [Finset.card_range] at hSumRem_jet
    have hGlobalSubOne_eq : (fun y : ℝ => globalB_mult n w y - 1) =
        fun y : ℝ => -(((q : ℝ) ^ 2 / (6 * Real.pi) : ℝ) : ℂ) *
          ∑ j ∈ Finset.range q, ∫ α in (0 : ℝ)..1, (rawFn w j α y - leadFn α) := by
      funext y
      rw [hGlobalB_eq w hw, ← hLeadSumEqOne]
      have hSubSum : (∑ j ∈ Finset.range q, ∫ α in (0 : ℝ)..1, rawFn w j α y) -
          (∑ _j ∈ Finset.range q, ∫ α in (0 : ℝ)..1, leadFn α) =
          ∑ j ∈ Finset.range q, ∫ α in (0 : ℝ)..1, (rawFn w j α y - leadFn α) := by
        rw [← Finset.sum_sub_distrib]
        refine Finset.sum_congr rfl fun j hj_mem => ?_
        have hj : j < q := Finset.mem_range.mp hj_mem
        exact (intervalIntegral.integral_sub (hSlice_int w hw j hj y)
          (hLead_cont.intervalIntegrable 0 1)).symm
      calc -(((q : ℝ) ^ 2 / (6 * Real.pi) : ℝ) : ℂ) *
              (∑ j ∈ Finset.range q, ∫ α in (0 : ℝ)..1, rawFn w j α y) -
            (-(((q : ℝ) ^ 2 / (6 * Real.pi) : ℝ) : ℂ) *
              (∑ _j ∈ Finset.range q, ∫ α in (0 : ℝ)..1, leadFn α))
          = -(((q : ℝ) ^ 2 / (6 * Real.pi) : ℝ) : ℂ) *
              ((∑ j ∈ Finset.range q, ∫ α in (0 : ℝ)..1, rawFn w j α y) -
               (∑ _j ∈ Finset.range q, ∫ α in (0 : ℝ)..1, leadFn α)) := by ring
        _ = _ := by rw [hSubSum]
    have hScaled_jet := hJet_const_mul (-(((q : ℝ) ^ 2 / (6 * Real.pi) : ℝ) : ℂ)) hSumRem_jet
    refine ⟨hGlobal_cd, ?_⟩
    intro k hk x
    rw [hGlobalSubOne_eq]
    have hb := hScaled_jet.2.2 k hk x
    have hPrefNorm : ‖-(((q : ℝ) ^ 2 / (6 * Real.pi) : ℝ) : ℂ)‖ = (q : ℝ) ^ 2 / (6 * Real.pi) := by
      rw [norm_neg, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (by positivity)]
    rw [hPrefNorm] at hb
    refine le_trans hb ?_
    rw [hAbs_n_eq_q]
    have hAlg : ((q : ℝ) ^ 2 / (6 * Real.pi)) * ((q : ℝ) * (C_cell / (q : ℝ) ^ 4)) =
        (C_cell / (6 * Real.pi)) / (q : ℝ) := by field_simp
    rw [hAlg]
    exact div_le_div_of_nonneg_right (by dsimp only [K_real]; linarith) (le_of_lt hq_pos)

  · intro w₁ w₂ hw₁ hw₂ k hk x
    let Δw := realDiffSup (m + 15) w₁ w₂
    have hΔw_nn : 0 ≤ Δw := hDiffSup_nonneg w₁ w₂
    have hDiffCell_jet : ∀ j ∈ Finset.range q,
        HasCJetℂ_moab m ((C_cell / (q : ℝ) ^ 4) * Δw)
          (fun y => ∫ α in (0 : ℝ)..1, (rawFn w₁ j α y - rawFn w₂ j α y)) := by
      intro j hj_mem
      have hj : j < q := Finset.mem_range.mp hj_mem
      obtain ⟨hPt1, hCont1⟩ := (hCellAll j hj).1 w₁ hw₁
      obtain ⟨hPt2, hCont2⟩ := (hCellAll j hj).1 w₂ hw₂
      refine hParamJet m ((C_cell / (q : ℝ) ^ 4) * Δw)
        (fun α y => rawFn w₁ j α y - rawFn w₂ j α y)
        (by positivity)
        (fun α hα => (hCellAll j hj).2 w₁ w₂ α hw₁ hw₂ hα)
        ?_
      intro r hr
      refine ((hCont1 r hr).sub (hCont2 r hr)).congr fun p hp => ?_
      exact iteratedDeriv_fun_sub
        (((hPt1 p.1 hp.1).1).of_le (by exact_mod_cast hr)).contDiffAt
        (((hPt2 p.1 hp.1).1).of_le (by exact_mod_cast hr)).contDiffAt
    have hSumDiff_jet := hJet_finset_sum m (Finset.range q) ((C_cell / (q : ℝ) ^ 4) * Δw)
      (fun j y => ∫ α in (0 : ℝ)..1, (rawFn w₁ j α y - rawFn w₂ j α y))
      (by positivity) hDiffCell_jet
    rw [Finset.card_range] at hSumDiff_jet
    have hGlobalDiff_eq : (fun y : ℝ => globalB_mult n w₁ y - globalB_mult n w₂ y) =
        fun y : ℝ => -(((q : ℝ) ^ 2 / (6 * Real.pi) : ℝ) : ℂ) *
          ∑ j ∈ Finset.range q, ∫ α in (0 : ℝ)..1, (rawFn w₁ j α y - rawFn w₂ j α y) := by
      funext y
      rw [hGlobalB_eq w₁ hw₁, hGlobalB_eq w₂ hw₂]
      have hSubSum : (∑ j ∈ Finset.range q, ∫ α in (0 : ℝ)..1, rawFn w₁ j α y) -
          (∑ j ∈ Finset.range q, ∫ α in (0 : ℝ)..1, rawFn w₂ j α y) =
          ∑ j ∈ Finset.range q, ∫ α in (0 : ℝ)..1, (rawFn w₁ j α y - rawFn w₂ j α y) := by
        rw [← Finset.sum_sub_distrib]
        refine Finset.sum_congr rfl fun j hj_mem => ?_
        have hj : j < q := Finset.mem_range.mp hj_mem
        exact (intervalIntegral.integral_sub (hSlice_int w₁ hw₁ j hj y)
          (hSlice_int w₂ hw₂ j hj y)).symm
      calc -(((q : ℝ) ^ 2 / (6 * Real.pi) : ℝ) : ℂ) *
              (∑ j ∈ Finset.range q, ∫ α in (0 : ℝ)..1, rawFn w₁ j α y) -
            (-(((q : ℝ) ^ 2 / (6 * Real.pi) : ℝ) : ℂ) *
              (∑ j ∈ Finset.range q, ∫ α in (0 : ℝ)..1, rawFn w₂ j α y))
          = -(((q : ℝ) ^ 2 / (6 * Real.pi) : ℝ) : ℂ) *
              ((∑ j ∈ Finset.range q, ∫ α in (0 : ℝ)..1, rawFn w₁ j α y) -
               (∑ j ∈ Finset.range q, ∫ α in (0 : ℝ)..1, rawFn w₂ j α y)) := by ring
        _ = _ := by rw [hSubSum]
    have hScaled_jet := hJet_const_mul (-(((q : ℝ) ^ 2 / (6 * Real.pi) : ℝ) : ℂ)) hSumDiff_jet
    rw [hGlobalDiff_eq]
    have hb := hScaled_jet.2.2 k hk x
    have hPrefNorm : ‖-(((q : ℝ) ^ 2 / (6 * Real.pi) : ℝ) : ℂ)‖ = (q : ℝ) ^ 2 / (6 * Real.pi) := by
      rw [norm_neg, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (by positivity)]
    rw [hPrefNorm] at hb
    refine le_trans hb ?_
    rw [hAbs_n_eq_q]
    have hAlg : ((q : ℝ) ^ 2 / (6 * Real.pi)) * ((q : ℝ) * ((C_cell / (q : ℝ) ^ 4) * Δw)) =
        ((C_cell / (6 * Real.pi)) / (q : ℝ)) * Δw := by field_simp
    rw [hAlg]
    exact mul_le_mul_of_nonneg_right
      (div_le_div_of_nonneg_right (by dsimp only [K_real]; linarith) (le_of_lt hq_pos)) hΔw_nn

theorem real_action_deriv_and_multiplier_bounds (m : ℕ) (M : ℝ)
    (hm : 2 ≤ m) (hM : 0 < M) (S : StationaryMeshSystem m (M + 1)) :
    ∃ (K_real : ℝ) (N_real : ℕ), 0 < K_real ∧ S.N_mesh ≤ N_real ∧
      ∀ (n : ℤ), (N_real : ℤ) ≤ |n| →
        (∀ (w : ℝ → ℝ), IsPeriodicSmoothBounded (m + 15) M w →
          ContDiff ℝ (m : WithTop ℕ∞) (globalB_mult n w) ∧
          Function.Periodic (globalB_mult n w) (2 * Real.pi) ∧
          (∀ (v : ℝ → ℝ), Function.Periodic v (2 * Real.pi) →
            ContDiff ℝ ((m + 15 : ℕ) : WithTop ℕ∞) v →
            HasDerivAt (fun t : ℝ => globalC_coeff n (fun x => w x + t * v x))
              (((2 * Real.pi : ℝ) : ℂ)⁻¹ *
                ∫ x in (0 : ℝ)..(2 * Real.pi),
                  Complex.exp (-Complex.I * (n : ℂ) * (x : ℂ)) * globalB_mult n w x * (v x : ℂ))
              0) ∧
          (∀ k : ℕ, k ≤ m → ∀ x : ℝ,
            ‖iteratedDeriv k (fun y : ℝ => globalB_mult n w y - 1) x‖ ≤ K_real / |(n : ℝ)|)) ∧
        (∀ (w₁ w₂ : ℝ → ℝ),
          IsPeriodicSmoothBounded (m + 15) M w₁ →
          IsPeriodicSmoothBounded (m + 15) M w₂ →
          ∀ k : ℕ, k ≤ m → ∀ x : ℝ,
            ‖iteratedDeriv k (fun y : ℝ => globalB_mult n w₁ y - globalB_mult n w₂ y) x‖ ≤
              (K_real / |(n : ℝ)|) * realDiffSup (m + 15) w₁ w₂) :=
by
  have hCalc : NormActionCalculusProp := normAction_real_calculus_and_variation
  obtain ⟨H_inv⟩ := halfCell_inverse_system m M hm hM S
  obtain ⟨H_kern⟩ := forward_cell_kernel_system m M hm hM S
  obtain ⟨K_real, N_real, hKr_pos, hNr_max, hMult⟩ :=
    multiplier_oscillatory_assembly_and_bounds m M hm hM S H_inv H_kern
  have hInv_le_real : H_inv.N_inv ≤ N_real :=
    le_trans (le_max_left H_inv.N_inv H_kern.N_kern) hNr_max
  have hMesh_le_real : S.N_mesh ≤ N_real :=
    le_trans H_inv.N_inv_ge hInv_le_real
  refine ⟨K_real, N_real, hKr_pos, hMesh_le_real, ?_⟩
  intro n hn
  have hn_inv : (H_inv.N_inv : ℤ) ≤ |n| :=
    le_trans (Int.ofNat_le.mpr hInv_le_real) hn
  obtain ⟨hMult1, hMult2⟩ := hMult n hn
  refine ⟨?_, hMult2⟩
  intro w hw
  obtain ⟨hCont, hBnd⟩ := hMult1 w hw
  obtain ⟨hPer, hDeriv⟩ :=
    action_directional_deriv_and_periodicity m M hm hM S hCalc H_inv n hn_inv w hw
  exact ⟨hCont, hPer, hDeriv, hBnd⟩

theorem strip_half_cell_inv_system (m : ℕ) (M : ℝ)
    (hm : 2 ≤ m) (hM : 0 < M) (S : StationaryMeshSystem m (M + 1)) :
    Nonempty (StripHalfCellInvSystem m M S) :=
by
  have _ : 0 < M := hM
  
  have hStripOpen : ∀ H : ℝ, IsOpen (horizStrip H) := fun H =>
    isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const
  have hStripConv : ∀ H : ℝ, Convex ℝ (horizStrip H) := by
    intro H z₁ hz₁ z₂ hz₂ a b ha hb hab
    change |(a • z₁ + b • z₂).im| < H
    change |z₁.im| < H at hz₁
    change |z₂.im| < H at hz₂
    have him : (a • z₁ + b • z₂).im = a * z₁.im + b * z₂.im := by simp
    rw [him]
    calc |a * z₁.im + b * z₂.im|
        ≤ |a * z₁.im| + |b * z₂.im| := abs_add_le _ _
      _ = a * |z₁.im| + b * |z₂.im| := by
          rw [abs_mul, abs_mul, abs_of_nonneg ha, abs_of_nonneg hb]
      _ < a * H + b * H := by
          rcases eq_or_lt_of_le ha with rfl | ha_pos
          · simp at hab ⊢; subst hab; simpa using hz₂
          · have h1 : a * |z₁.im| < a * H := mul_lt_mul_of_pos_left hz₁ ha_pos
            have h2 : b * |z₂.im| ≤ b * H := mul_le_mul_of_nonneg_left (le_of_lt hz₂) hb
            linarith
      _ = H := by rw [← add_mul, hab, one_mul]
  have hStripShift2Pi : ∀ {H : ℝ} {z : ℂ}, z ∈ horizStrip H → z + 2 * Real.pi ∈ horizStrip H := by
    intro H z hz
    change |(z + 2 * Real.pi).im| < H
    change |z.im| < H at hz
    simpa using hz
  have hStripConj : ∀ {H : ℝ} {z : ℂ}, z ∈ horizStrip H → starRingEnd ℂ z ∈ horizStrip H := by
    intro H z hz
    change |(starRingEnd ℂ z).im| < H
    change |z.im| < H at hz
    simpa using hz
  have hContDiffAt : ∀ {U : Set ℂ} {f : ℂ → ℂ} {z : ℂ} (s : ℕ),
      IsOpen U → DifferentiableOn ℂ f U → z ∈ U → ContDiffAt ℂ s f z :=
    fun s hU hf hz => ((hf.contDiffOn hU).contDiffAt (hU.mem_nhds hz)).of_le le_top

  
  have hCompConstMono : ∀ B : ℝ, 1 ≤ B →
      (∀ s : ℕ, 1 ≤ shciCompConst s B) ∧ Monotone (fun s => shciCompConst s B) := by
    intro B hB
    have hge1 : ∀ s : ℕ, 1 ≤ shciCompConst s B := by
      intro s
      induction s with
      | zero => simp [shciCompConst]
      | succ s ih =>
        simp only [shciCompConst]
        have h2s : (1 : ℝ) ≤ (2 : ℝ) ^ s := one_le_pow₀ (by norm_num)
        have h2sB : (1 : ℝ) ≤ (2 : ℝ) ^ s * B := one_le_mul_of_one_le_of_one_le h2s hB
        exact one_le_mul_of_one_le_of_one_le h2sB ih
    refine ⟨hge1, monotone_nat_of_le_succ fun s => ?_⟩
    simp only [shciCompConst]
    have h2s : (1 : ℝ) ≤ (2 : ℝ) ^ s := one_le_pow₀ (by norm_num)
    have h2sB : (1 : ℝ) ≤ (2 : ℝ) ^ s * B := one_le_mul_of_one_le_of_one_le h2s hB
    have hs0 : 0 ≤ shciCompConst s B := le_trans zero_le_one (hge1 s)
    calc shciCompConst s B = 1 * shciCompConst s B := (one_mul _).symm
      _ ≤ ((2 : ℝ) ^ s * B) * shciCompConst s B := mul_le_mul_of_nonneg_right h2sB hs0
  have hCompDiffConstMono : ∀ B : ℝ, 1 ≤ B →
      (∀ s : ℕ, 1 ≤ shciCompDiffConst s B) ∧ Monotone (fun s => shciCompDiffConst s B) := by
    intro B hB
    have hc1 := (hCompConstMono B hB).1
    have hge1 : ∀ s : ℕ, 1 ≤ shciCompDiffConst s B := by
      intro s
      induction s with
      | zero => simp [shciCompDiffConst]
      | succ s ih =>
        simp only [shciCompDiffConst]
        have h2s : (1 : ℝ) ≤ (2 : ℝ) ^ s := one_le_pow₀ (by norm_num)
        have hcs : 1 ≤ shciCompConst s B := hc1 s
        have hBs : 1 ≤ B * shciCompDiffConst s B := one_le_mul_of_one_le_of_one_le hB ih
        nlinarith
    refine ⟨hge1, monotone_nat_of_le_succ fun s => ?_⟩
    simp only [shciCompDiffConst]
    have h2s : (1 : ℝ) ≤ (2 : ℝ) ^ s := one_le_pow₀ (by norm_num)
    have hcs : 1 ≤ shciCompConst s B := hc1 s
    have hd_pos : 0 ≤ shciCompDiffConst s B := le_trans zero_le_one (hge1 s)
    have hstep1 : shciCompDiffConst s B ≤ B * shciCompDiffConst s B + shciCompConst s B := by
      have : 1 * shciCompDiffConst s B ≤ B * shciCompDiffConst s B :=
        mul_le_mul_of_nonneg_right hB hd_pos
      linarith
    have hsum_nonneg : 0 ≤ B * shciCompDiffConst s B + shciCompConst s B := by linarith
    calc shciCompDiffConst s B
        ≤ 1 * (B * shciCompDiffConst s B + shciCompConst s B) := by linarith
      _ ≤ (2 : ℝ) ^ s * (B * shciCompDiffConst s B + shciCompConst s B) :=
          mul_le_mul_of_nonneg_right h2s hsum_nonneg
  have hJetBMono : Monotone shciJetB :=
    monotone_nat_of_le_succ fun k => le_max_left _ _
  have hJetBGeTwo : ∀ k : ℕ, 2 ≤ shciJetB k := fun k =>
    le_trans (by simp [shciJetB]) (hJetBMono (Nat.zero_le k))
  have hJetLMono : Monotone shciJetL :=
    monotone_nat_of_le_succ fun k => le_max_left _ _
  have hJetLGeTwo : ∀ k : ℕ, 2 ≤ shciJetL k := fun k =>
    le_trans (by simp [shciJetL]) (hJetLMono (Nat.zero_le k))
  have hFactMono : Monotone Nat.factorial :=
    monotone_nat_of_le_succ fun n => by
      rw [Nat.factorial_succ]
      exact Nat.le_mul_of_pos_left _ (Nat.succ_pos n)

  
  have hChooseSum : ∀ s : ℕ, (∑ i ∈ Finset.range (s + 1), (s.choose i : ℝ)) = (2 : ℝ) ^ s := by
    intro s
    have hcast := congrArg (Nat.cast : ℕ → ℝ) (Nat.sum_range_choose s)
    simpa [Nat.cast_sum, Nat.cast_pow] using hcast
  have hLeibnizBnd : ∀ {U : Set ℂ} {u v : ℂ → ℂ} (s : ℕ) (M_u M_v : ℝ) {z : ℂ},
      IsOpen U → DifferentiableOn ℂ u U → DifferentiableOn ℂ v U →
      0 ≤ M_u → 0 ≤ M_v → z ∈ U →
      (∀ i ≤ s, ‖iteratedDeriv i u z‖ ≤ M_u) →
      (∀ j ≤ s, ‖iteratedDeriv j v z‖ ≤ M_v) →
      ‖iteratedDeriv s (fun ζ => u ζ * v ζ) z‖ ≤ (2 : ℝ) ^ s * M_u * M_v := by
    intro U u v s M_u M_v z hU hu hv hMu hMv hz hub hvb
    rw [iteratedDeriv_fun_mul (hContDiffAt s hU hu hz) (hContDiffAt s hU hv hz)]
    calc ‖∑ i ∈ Finset.range (s + 1),
            (s.choose i : ℂ) * iteratedDeriv i u z * iteratedDeriv (s - i) v z‖
        ≤ ∑ i ∈ Finset.range (s + 1),
            ‖(s.choose i : ℂ) * iteratedDeriv i u z * iteratedDeriv (s - i) v z‖ :=
          norm_sum_le _ _
      _ ≤ ∑ i ∈ Finset.range (s + 1), (s.choose i : ℝ) * (M_u * M_v) := by
          apply Finset.sum_le_sum
          intro i hi
          have hi_le : i ≤ s := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
          have hsi_le : s - i ≤ s := Nat.sub_le s i
          rw [norm_mul, norm_mul, Complex.norm_natCast, mul_assoc]
          exact mul_le_mul_of_nonneg_left
            (mul_le_mul (hub i hi_le) (hvb (s - i) hsi_le) (norm_nonneg _) hMu)
            (Nat.cast_nonneg _)
      _ = (∑ i ∈ Finset.range (s + 1), (s.choose i : ℝ)) * (M_u * M_v) := by
          rw [← Finset.sum_mul]
      _ = (2 : ℝ) ^ s * M_u * M_v := by
          rw [hChooseSum s]; ring

  
  have hCompBnd : ∀ (q₀ : ℕ) {U V : Set ℂ} {B M_g : ℝ} {f g : ℂ → ℂ},
      IsOpen U → IsOpen V → 1 ≤ B → 0 ≤ M_g →
      DifferentiableOn ℂ f U → DifferentiableOn ℂ g V →
      (∀ z ∈ U, f z ∈ V) →
      (∀ j : ℕ, 1 ≤ j → j ≤ q₀ → ∀ z ∈ U, ‖iteratedDeriv j f z‖ ≤ B) →
      (∀ r : ℕ, r ≤ q₀ → ∀ w ∈ V, ‖iteratedDeriv r g w‖ ≤ M_g) →
      ∀ k ≤ q₀, ∀ z ∈ U,
        ‖iteratedDeriv k (fun ζ => g (f ζ)) z‖ ≤ M_g * shciCompConst k B := by
    intro q₀
    induction q₀ with
    | zero =>
      intro U V B M_g f g _ _ _ _ _ _ hMaps _ hg_bnd k hk z hz
      have hk0 : k = 0 := Nat.le_zero.mp hk
      subst hk0
      simpa [iteratedDeriv_zero, shciCompConst] using hg_bnd 0 le_rfl (f z) (hMaps z hz)
    | succ q₀ ih =>
      intro U V B M_g f g hU hV hB hMg hf hg hMaps hf_bnd hg_bnd k hk z hz
      cases k with
      | zero =>
        simpa [iteratedDeriv_zero, shciCompConst] using
          hg_bnd 0 (Nat.zero_le _) (f z) (hMaps z hz)
      | succ s =>
        have hs : s ≤ q₀ := Nat.succ_le_succ_iff.mp hk
        have hg' : DifferentiableOn ℂ (deriv g) V := hg.deriv hV
        have hf' : DifferentiableOn ℂ (deriv f) U := hf.deriv hU
        have hg'f : DifferentiableOn ℂ (fun ζ => deriv g (f ζ)) U :=
          hg'.comp hf (fun _ hζ => hMaps _ hζ)
        have hEqDeriv : Set.EqOn (deriv (fun ζ => g (f ζ)))
            (fun ζ => deriv g (f ζ) * deriv f ζ) U := by
          intro ζ hζ
          exact deriv_comp ζ (hg.differentiableAt (hV.mem_nhds (hMaps ζ hζ)))
            (hf.differentiableAt (hU.mem_nhds hζ))
        have hEv : deriv (fun ζ => g (f ζ)) =ᶠ[nhds z]
            (fun ζ => deriv g (f ζ) * deriv f ζ) :=
          hEqDeriv.eventuallyEq_of_mem (hU.mem_nhds hz)
        rw [iteratedDeriv_succ', hEv.iteratedDeriv_eq s]
        have hIH : ∀ i ≤ q₀, ∀ ζ ∈ U,
            ‖iteratedDeriv i (fun ξ => deriv g (f ξ)) ζ‖ ≤ M_g * shciCompConst i B := by
          apply ih hU hV hB hMg hf hg' hMaps
          · intro j hj1 hjq ζ hζ
            exact hf_bnd j hj1 (Nat.le_succ_of_le hjq) ζ hζ
          · intro r hr w hw
            rw [← iteratedDeriv_succ']
            exact hg_bnd (r + 1) (Nat.succ_le_succ hr) w hw
        have hB_pos : 0 ≤ B := by linarith
        have hComp_mono := (hCompConstMono B hB).2
        have hComp_pos : 0 ≤ shciCompConst s B :=
          le_trans zero_le_one ((hCompConstMono B hB).1 s)
        have hLeib := hLeibnizBnd s (M_g * shciCompConst s B) B hU hg'f hf'
          (mul_nonneg hMg hComp_pos) hB_pos hz
          (fun i hi => le_trans (hIH i (le_trans hi hs) z hz)
            (mul_le_mul_of_nonneg_left (hComp_mono hi) hMg))
          (fun j hj => by
            rw [← iteratedDeriv_succ']
            exact hf_bnd (j + 1) (Nat.succ_le_succ (Nat.zero_le j))
              (Nat.succ_le_succ (le_trans hj hs)) z hz)
        calc ‖iteratedDeriv s (fun ζ => deriv g (f ζ) * deriv f ζ) z‖
            ≤ (2 : ℝ) ^ s * (M_g * shciCompConst s B) * B := hLeib
          _ = M_g * shciCompConst (s + 1) B := by simp [shciCompConst]; ring

  
  have hCompSubBnd : ∀ (q₀ : ℕ) {U V : Set ℂ} {B Δ_f M_g : ℝ} {f₁ f₂ g : ℂ → ℂ},
      IsOpen U → IsOpen V → Convex ℝ V → 1 ≤ B → 0 ≤ Δ_f → 0 ≤ M_g →
      DifferentiableOn ℂ f₁ U → DifferentiableOn ℂ f₂ U → DifferentiableOn ℂ g V →
      (∀ z ∈ U, f₁ z ∈ V) → (∀ z ∈ U, f₂ z ∈ V) →
      (∀ j : ℕ, 1 ≤ j → j ≤ q₀ → ∀ z ∈ U, ‖iteratedDeriv j f₁ z‖ ≤ B) →
      (∀ j : ℕ, 1 ≤ j → j ≤ q₀ → ∀ z ∈ U, ‖iteratedDeriv j f₂ z‖ ≤ B) →
      (∀ j : ℕ, j ≤ q₀ → ∀ z ∈ U, ‖iteratedDeriv j (fun ζ => f₁ ζ - f₂ ζ) z‖ ≤ Δ_f) →
      (∀ r : ℕ, r ≤ q₀ + 1 → ∀ w ∈ V, ‖iteratedDeriv r g w‖ ≤ M_g) →
      ∀ k ≤ q₀, ∀ z ∈ U,
        ‖iteratedDeriv k (fun ζ => g (f₁ ζ) - g (f₂ ζ)) z‖ ≤
          M_g * Δ_f * shciCompDiffConst k B := by
    intro q₀
    induction q₀ with
    | zero =>
      intro U V B Δ_f M_g f₁ f₂ g _ hV hV_conv _ _ hMg _ _ hg hMaps₁ hMaps₂ _ _ hdiff hg_bnd
        k hk z hz
      have hk0 : k = 0 := Nat.le_zero.mp hk
      subst hk0
      simp only [iteratedDeriv_zero, shciCompDiffConst, mul_one]
      have hLip : ‖g (f₁ z) - g (f₂ z)‖ ≤ M_g * ‖f₁ z - f₂ z‖ :=
        hV_conv.norm_image_sub_le_of_norm_deriv_le
          (fun _ hw => hg.differentiableAt (hV.mem_nhds hw))
          (fun w hw => by
            have h1 := hg_bnd 1 (by omega) w hw
            simpa [iteratedDeriv_succ, iteratedDeriv_zero] using h1)
          (hMaps₂ z hz) (hMaps₁ z hz)
      have h0 : ‖f₁ z - f₂ z‖ ≤ Δ_f := by
        simpa [iteratedDeriv_zero] using hdiff 0 le_rfl z hz
      exact le_trans hLip (mul_le_mul_of_nonneg_left h0 hMg)
    | succ q₀ ih =>
      intro U V B Δ_f M_g f₁ f₂ g hU hV hV_conv hB hΔ hMg hf₁ hf₂ hg hMaps₁ hMaps₂
        hf₁_bnd hf₂_bnd hdiff hg_bnd k hk z hz
      cases k with
      | zero =>
        simp only [iteratedDeriv_zero, shciCompDiffConst, mul_one]
        have hLip : ‖g (f₁ z) - g (f₂ z)‖ ≤ M_g * ‖f₁ z - f₂ z‖ :=
          hV_conv.norm_image_sub_le_of_norm_deriv_le
            (fun _ hw => hg.differentiableAt (hV.mem_nhds hw))
            (fun w hw => by
              have h1 := hg_bnd 1 (by omega) w hw
              simpa [iteratedDeriv_succ, iteratedDeriv_zero] using h1)
            (hMaps₂ z hz) (hMaps₁ z hz)
        have h0 : ‖f₁ z - f₂ z‖ ≤ Δ_f := by
          simpa [iteratedDeriv_zero] using hdiff 0 (Nat.zero_le _) z hz
        exact le_trans hLip (mul_le_mul_of_nonneg_left h0 hMg)
      | succ s =>
        have hs : s ≤ q₀ := Nat.succ_le_succ_iff.mp hk
        have hg' : DifferentiableOn ℂ (deriv g) V := hg.deriv hV
        have hf₁' : DifferentiableOn ℂ (deriv f₁) U := hf₁.deriv hU
        have hf_sub : DifferentiableOn ℂ (fun ζ => f₁ ζ - f₂ ζ) U := hf₁.sub hf₂
        have hf_sub' : DifferentiableOn ℂ (deriv (fun ζ => f₁ ζ - f₂ ζ)) U := hf_sub.deriv hU
        have hg'₁ : DifferentiableOn ℂ (fun ζ => deriv g (f₁ ζ)) U :=
          hg'.comp hf₁ (fun _ hζ => hMaps₁ _ hζ)
        have hg'₂ : DifferentiableOn ℂ (fun ζ => deriv g (f₂ ζ)) U :=
          hg'.comp hf₂ (fun _ hζ => hMaps₂ _ hζ)
        have hTerm1_holo : DifferentiableOn ℂ
            (fun ζ => (deriv g (f₁ ζ) - deriv g (f₂ ζ)) * deriv f₁ ζ) U :=
          (hg'₁.sub hg'₂).mul hf₁'
        have hTerm2_holo : DifferentiableOn ℂ
            (fun ζ => deriv g (f₂ ζ) * deriv (fun ξ => f₁ ξ - f₂ ξ) ζ) U :=
          hg'₂.mul hf_sub'
        have hEqDeriv : Set.EqOn (deriv (fun ζ => g (f₁ ζ) - g (f₂ ζ)))
            (fun ζ => (deriv g (f₁ ζ) - deriv g (f₂ ζ)) * deriv f₁ ζ +
              deriv g (f₂ ζ) * deriv (fun ξ => f₁ ξ - f₂ ξ) ζ) U := by
          intro ζ hζ
          have hdf₁ := hf₁.differentiableAt (hU.mem_nhds hζ)
          have hdf₂ := hf₂.differentiableAt (hU.mem_nhds hζ)
          have hdg₁ := hg.differentiableAt (hV.mem_nhds (hMaps₁ ζ hζ))
          have hdg₂ := hg.differentiableAt (hV.mem_nhds (hMaps₂ ζ hζ))
          have hd1 := (hdg₁.hasDerivAt).comp ζ hdf₁.hasDerivAt
          have hd2 := (hdg₂.hasDerivAt).comp ζ hdf₂.hasDerivAt
          have hd_fsub : deriv (fun ξ => f₁ ξ - f₂ ξ) ζ = deriv f₁ ζ - deriv f₂ ζ :=
            ((hdf₁.hasDerivAt).sub hdf₂.hasDerivAt).deriv
          exact ((hd1.sub hd2).deriv).trans (by dsimp; rw [hd_fsub]; ring)
        have hEv : deriv (fun ζ => g (f₁ ζ) - g (f₂ ζ)) =ᶠ[nhds z]
            (fun ζ => (deriv g (f₁ ζ) - deriv g (f₂ ζ)) * deriv f₁ ζ +
              deriv g (f₂ ζ) * deriv (fun ξ => f₁ ξ - f₂ ξ) ζ) :=
          hEqDeriv.eventuallyEq_of_mem (hU.mem_nhds hz)
        rw [iteratedDeriv_succ', hEv.iteratedDeriv_eq s,
          iteratedDeriv_fun_add (hContDiffAt s hU hTerm1_holo hz) (hContDiffAt s hU hTerm2_holo hz)]
        have hIH : ∀ i ≤ q₀, ∀ ζ ∈ U,
            ‖iteratedDeriv i (fun ξ => deriv g (f₁ ξ) - deriv g (f₂ ξ)) ζ‖ ≤
              M_g * Δ_f * shciCompDiffConst i B := by
          apply ih hU hV hV_conv hB hΔ hMg hf₁ hf₂ hg' hMaps₁ hMaps₂
          · intro j hj1 hjq ζ hζ; exact hf₁_bnd j hj1 (Nat.le_succ_of_le hjq) ζ hζ
          · intro j hj1 hjq ζ hζ; exact hf₂_bnd j hj1 (Nat.le_succ_of_le hjq) ζ hζ
          · intro j hjq ζ hζ; exact hdiff j (Nat.le_succ_of_le hjq) ζ hζ
          · intro r hr w hw
            rw [← iteratedDeriv_succ']
            exact hg_bnd (r + 1) (Nat.succ_le_succ hr) w hw
        have hComp₂ : ∀ i ≤ q₀, ∀ ζ ∈ U,
            ‖iteratedDeriv i (fun ξ => deriv g (f₂ ξ)) ζ‖ ≤ M_g * shciCompConst i B := by
          apply hCompBnd q₀ hU hV hB hMg hf₂ hg' hMaps₂
          · intro j hj1 hjq ζ hζ; exact hf₂_bnd j hj1 (Nat.le_succ_of_le hjq) ζ hζ
          · intro r hr w hw
            rw [← iteratedDeriv_succ']
            exact hg_bnd (r + 1) (by omega) w hw
        have hB_pos : 0 ≤ B := by linarith
        have hc_mono := (hCompConstMono B hB).2
        have hd_mono := (hCompDiffConstMono B hB).2
        have hc_pos : 0 ≤ shciCompConst s B :=
          le_trans zero_le_one ((hCompConstMono B hB).1 s)
        have hd_pos : 0 ≤ shciCompDiffConst s B :=
          le_trans zero_le_one ((hCompDiffConstMono B hB).1 s)
        have hL1 := hLeibnizBnd s (M_g * Δ_f * shciCompDiffConst s B) B
          hU (hg'₁.sub hg'₂) hf₁' (mul_nonneg (mul_nonneg hMg hΔ) hd_pos) hB_pos hz
          (fun i hi => le_trans (hIH i (le_trans hi hs) z hz)
            (mul_le_mul_of_nonneg_left (hd_mono hi) (mul_nonneg hMg hΔ)))
          (fun j hj => by
            rw [← iteratedDeriv_succ']
            exact hf₁_bnd (j + 1) (Nat.succ_le_succ (Nat.zero_le j))
              (Nat.succ_le_succ (le_trans hj hs)) z hz)
        have hL2 := hLeibnizBnd s (M_g * shciCompConst s B) Δ_f
          hU hg'₂ hf_sub' (mul_nonneg hMg hc_pos) hΔ hz
          (fun i hi => le_trans (hComp₂ i (le_trans hi hs) z hz)
            (mul_le_mul_of_nonneg_left (hc_mono hi) hMg))
          (fun j hj => by
            rw [← iteratedDeriv_succ']
            exact hdiff (j + 1) (Nat.succ_le_succ (le_trans hj hs)) z hz)
        calc ‖iteratedDeriv s (fun ζ => (deriv g (f₁ ζ) - deriv g (f₂ ζ)) * deriv f₁ ζ) z +
              iteratedDeriv s (fun ζ => deriv g (f₂ ζ) * deriv (fun ξ => f₁ ξ - f₂ ξ) ζ) z‖
            ≤ ‖iteratedDeriv s (fun ζ => (deriv g (f₁ ζ) - deriv g (f₂ ζ)) * deriv f₁ ζ) z‖ +
              ‖iteratedDeriv s (fun ζ => deriv g (f₂ ζ) * deriv (fun ξ => f₁ ξ - f₂ ξ) ζ) z‖ :=
              norm_add_le _ _
          _ ≤ (2 : ℝ) ^ s * (M_g * Δ_f * shciCompDiffConst s B) * B +
              (2 : ℝ) ^ s * (M_g * shciCompConst s B) * Δ_f := add_le_add hL1 hL2
          _ = M_g * Δ_f * shciCompDiffConst (s + 1) B := by simp [shciCompDiffConst]; ring

  
  let V_Q : Set ℂ := Metric.ball (0 : ℂ) (1 / 2)
  have hVQ_open : IsOpen V_Q := Metric.isOpen_ball
  have hVQ_conv : Convex ℝ V_Q := convex_ball (0 : ℂ) (1 / 2)
  have hVQ_one_add : ∀ w ∈ V_Q, 1 + w ≠ 0 ∧ ‖(1 + w)⁻¹‖ ≤ 2 := by
    intro w hw
    have hw_norm : ‖w‖ < 1 / 2 := by simpa [V_Q] using hw
    have hlow : (1 / 2 : ℝ) < ‖1 + w‖ := by
      have htri : ‖(1 : ℂ)‖ - ‖-w‖ ≤ ‖(1 : ℂ) - (-w)‖ := norm_sub_norm_le (1 : ℂ) (-w)
      simp only [norm_one, norm_neg, sub_neg_eq_add] at htri
      linarith
    have hpos : 0 < ‖1 + w‖ := by linarith
    refine ⟨norm_pos_iff.mp hpos, ?_⟩
    rw [norm_inv]
    calc (‖1 + w‖)⁻¹ ≤ (1 / 2 : ℝ)⁻¹ := inv_anti₀ (by norm_num) (le_of_lt hlow)
      _ = 2 := by norm_num
  have hP_holo : DifferentiableOn ℂ shciInvOneAdd V_Q := by
    intro w hw
    have hd : HasDerivAt (fun ζ : ℂ => 1 + ζ) 1 w := by
      have h0 := (hasDerivAt_const w (1 : ℂ)).add (hasDerivAt_id w)
      rw [zero_add] at h0
      exact h0
    exact (hd.inv (hVQ_one_add w hw).1).differentiableAt.differentiableWithinAt
  have hP_deriv_eq : ∀ r : ℕ, ∀ w ∈ V_Q,
      iteratedDeriv r shciInvOneAdd w =
        (-1 : ℂ) ^ r * (r.factorial : ℂ) * ((1 + w) ^ (r + 1))⁻¹ := by
    intro r
    induction r with
    | zero =>
      intro w _
      simp [shciInvOneAdd]
    | succ r ih =>
      intro w hw
      have hEq : Set.EqOn (iteratedDeriv r shciInvOneAdd)
          (fun ζ => (-1 : ℂ) ^ r * (r.factorial : ℂ) * ((1 + ζ) ^ (r + 1))⁻¹) V_Q :=
        fun ζ hζ => ih ζ hζ
      have hEv := hEq.eventuallyEq_of_mem (hVQ_open.mem_nhds hw)
      rw [iteratedDeriv_succ, hEv.deriv_eq]
      have hne : 1 + w ≠ 0 := (hVQ_one_add w hw).1
      have hd1 : HasDerivAt (fun ζ : ℂ => 1 + ζ) 1 w := by
        have h0 := (hasDerivAt_const w (1 : ℂ)).add (hasDerivAt_id w)
        rw [zero_add] at h0
        exact h0
      have hdpow : HasDerivAt (fun ζ : ℂ => (1 + ζ) ^ (r + 1))
          (((r + 1 : ℕ) : ℂ) * (1 + w) ^ r * 1) w := hd1.pow (r + 1)
      have hdinv : HasDerivAt (fun ζ : ℂ => ((1 + ζ) ^ (r + 1))⁻¹)
          (-(((r + 1 : ℕ) : ℂ) * (1 + w) ^ r * 1) / ((1 + w) ^ (r + 1)) ^ 2) w :=
        hdpow.inv (pow_ne_zero (r + 1) hne)
      have hdmul := hdinv.const_mul ((-1 : ℂ) ^ r * (r.factorial : ℂ))
      rw [hdmul.deriv, Nat.factorial_succ, Nat.cast_mul, pow_succ (-1 : ℂ) r]
      field_simp [hne]
      ring
  have hP_bnd : ∀ r : ℕ, ∀ w ∈ V_Q,
      ‖iteratedDeriv r shciInvOneAdd w‖ ≤ (r.factorial : ℝ) * (2 : ℝ) ^ (r + 1) := by
    intro r w hw
    rw [hP_deriv_eq r w hw, norm_mul, norm_mul, norm_pow, norm_neg, norm_one, one_pow,
       one_mul, Complex.norm_natCast, ← inv_pow, norm_pow]
    exact mul_le_mul_of_nonneg_left
      (pow_le_pow_left₀ (norm_nonneg _) (hVQ_one_add w hw).2 (r + 1))
      (Nat.cast_nonneg _)

  
  have hRightInvODE : ∀ {σ₁ σ₂ δ_e ρ : ℝ} {e x_inv : ℂ → ℂ},
      0 < σ₁ → 0 < σ₂ → 0 ≤ δ_e → δ_e ≤ 1 / 4 →
      DifferentiableOn ℂ e (horizStrip σ₁) →
      (∀ r ≤ 1, ∀ ζ ∈ horizStrip σ₁, ‖iteratedDeriv r e ζ‖ ≤ δ_e) →
      IsShciShiftRightInv σ₁ σ₂ ρ e x_inv →
      (∀ z ∈ horizStrip σ₂, deriv e (x_inv z) ∈ V_Q) ∧
      (∀ z ∈ horizStrip σ₂, deriv x_inv z = shciInvOneAdd (deriv e (x_inv z))) ∧
      (∀ z ∈ horizStrip σ₂,
        deriv (fun ζ : ℂ => x_inv ζ - (ζ - (ρ : ℂ))) z =
          -(deriv e (x_inv z) * shciInvOneAdd (deriv e (x_inv z)))) := by
    intro σ₁ σ₂ δ_e ρ e x_inv _ _ _ hδ_le he he_bnd hx
    have hU₁ := hStripOpen σ₁
    have hU₂ := hStripOpen σ₂
    obtain ⟨hx_holo, hx_maps, hx_eq⟩ := hx
    have hg_mem : ∀ z ∈ horizStrip σ₂, deriv e (x_inv z) ∈ V_Q := by
      intro z hz
      have hb1 : ‖deriv e (x_inv z)‖ ≤ δ_e := by
        simpa [iteratedDeriv_succ, iteratedDeriv_zero] using
          he_bnd 1 le_rfl (x_inv z) (hx_maps z hz)
      change dist (deriv e (x_inv z)) 0 < 1 / 2
      rw [dist_zero_right]
      linarith
    have hderiv_x : ∀ z ∈ horizStrip σ₂, deriv x_inv z = shciInvOneAdd (deriv e (x_inv z)) := by
      intro z hz
      have hdx : HasDerivAt x_inv (deriv x_inv z) z :=
        (hx_holo.differentiableAt (hU₂.mem_nhds hz)).hasDerivAt
      have hde : HasDerivAt e (deriv e (x_inv z)) (x_inv z) :=
        (he.differentiableAt (hU₁.mem_nhds (hx_maps z hz))).hasDerivAt
      have hd_lhs : HasDerivAt (fun ζ => x_inv ζ + (ρ : ℂ) + e (x_inv ζ))
          (deriv x_inv z + deriv e (x_inv z) * deriv x_inv z) z :=
        (hdx.add_const (ρ : ℂ)).add (hde.comp z hdx)
      have hEq : Set.EqOn (fun ζ => x_inv ζ + (ρ : ℂ) + e (x_inv ζ)) id (horizStrip σ₂) :=
        fun ζ hζ => hx_eq ζ hζ
      have hEv := hEq.eventuallyEq_of_mem (hU₂.mem_nhds hz)
      have hd1 : deriv (fun ζ => x_inv ζ + (ρ : ℂ) + e (x_inv ζ)) z = 1 := by
        rw [hEv.deriv_eq, deriv_id]
      have h_eq1 : deriv x_inv z + deriv e (x_inv z) * deriv x_inv z = 1 :=
        hd_lhs.deriv.symm.trans hd1
      have hmul : (1 + deriv e (x_inv z)) * deriv x_inv z = 1 := by
        linear_combination h_eq1
      have hne : 1 + deriv e (x_inv z) ≠ 0 := (hVQ_one_add _ (hg_mem z hz)).1
      change deriv x_inv z = (1 + deriv e (x_inv z))⁻¹
      exact eq_inv_of_mul_eq_one_right hmul
    refine ⟨hg_mem, hderiv_x, fun z hz => ?_⟩
    have hdx : HasDerivAt x_inv (deriv x_inv z) z :=
      (hx_holo.differentiableAt (hU₂.mem_nhds hz)).hasDerivAt
    have hlin : HasDerivAt (fun ζ : ℂ => ζ - (ρ : ℂ)) 1 z :=
      (hasDerivAt_id z).sub_const (ρ : ℂ)
    have hd_sub_ψ : deriv (fun ζ : ℂ => x_inv ζ - (ζ - (ρ : ℂ))) z = deriv x_inv z - 1 :=
      (hdx.sub hlin).deriv
    rw [hd_sub_ψ, hderiv_x z hz]
    have hne : 1 + deriv e (x_inv z) ≠ 0 := (hVQ_one_add _ (hg_mem z hz)).1
    unfold shciInvOneAdd
    field_simp [hne]
    ring

  have hLinZeroHigh : ∀ (ρ : ℝ) (t : ℕ) (z : ℂ),
      iteratedDeriv (t + 2) (fun ζ : ℂ => ζ - (ρ : ℂ)) z = 0 := by
    intro ρ t z
    have hd1 : deriv (fun ζ : ℂ => ζ - (ρ : ℂ)) = fun _ => (1 : ℂ) := by
      ext ζ; exact ((hasDerivAt_id ζ).sub_const (ρ : ℂ)).deriv
    have hd2 : deriv (fun _ : ℂ => (1 : ℂ)) = fun _ => (0 : ℂ) := by
      ext ζ; exact deriv_const ζ (1 : ℂ)
    rw [show t + 2 = (t + 1) + 1 from rfl, iteratedDeriv_succ', hd1,
      iteratedDeriv_succ', hd2]
    induction t generalizing z with
    | zero => simp
    | succ t _ => simp

  have hJetSingle : ∀ (p : ℕ) {σ₁ σ₂ δ_e ρ : ℝ} {e x_inv : ℂ → ℂ},
      0 < σ₁ → 0 < σ₂ → 0 ≤ δ_e → δ_e ≤ 1 / 4 →
      DifferentiableOn ℂ e (horizStrip σ₁) →
      (∀ r ≤ p + 1, ∀ ζ ∈ horizStrip σ₁, ‖iteratedDeriv r e ζ‖ ≤ δ_e) →
      IsShciShiftRightInv σ₁ σ₂ ρ e x_inv →
      ∀ k ≤ p, ∀ z ∈ horizStrip σ₂,
        ‖iteratedDeriv k (fun ζ : ℂ => x_inv ζ - (ζ - (ρ : ℂ))) z‖ ≤ shciJetB k * δ_e := by
    intro p σ₁ σ₂ δ_e ρ e x_inv hσ₁ hσ₂ hδ0 hδ_le he he_bnd hx
    have hU₁ := hStripOpen σ₁
    have hU₂ := hStripOpen σ₂
    have he_bnd1 : ∀ r ≤ 1, ∀ ζ ∈ horizStrip σ₁, ‖iteratedDeriv r e ζ‖ ≤ δ_e :=
      fun r hr => he_bnd r (by omega)
    obtain ⟨hg_mem, hderiv_x, hderiv_ψ⟩ := hRightInvODE hσ₁ hσ₂ hδ0 hδ_le he he_bnd1 hx
    obtain ⟨hx_holo, hx_maps, hx_eq⟩ := hx
    let ψ : ℂ → ℂ := fun ζ => x_inv ζ - (ζ - (ρ : ℂ))
    have hψ_holo : DifferentiableOn ℂ ψ (horizStrip σ₂) :=
      hx_holo.sub (differentiableOn_id.sub (differentiableOn_const (ρ : ℂ)))
    intro k
    induction k using Nat.strong_induction_on with
    | h k ih =>
      intro hkp z hz
      cases k with
      | zero =>
        simp only [iteratedDeriv_zero, shciJetB]
        have hψ_eq : x_inv z - (z - (ρ : ℂ)) = -e (x_inv z) := by
          linear_combination hx_eq z hz
        have hb0 : ‖e (x_inv z)‖ ≤ δ_e := by
          simpa [iteratedDeriv_zero] using he_bnd 0 (Nat.zero_le _) (x_inv z) (hx_maps z hz)
        rw [hψ_eq, norm_neg]
        linarith
      | succ k =>
        let B := shciJetB k
        let G := shciCompConst k B
        have hB_ge2 : 2 ≤ B := hJetBGeTwo k
        have hB_ge1 : 1 ≤ B := by linarith
        have hG_ge1 : 1 ≤ G := (hCompConstMono B hB_ge1).1 k
        have hx_deriv_bnd : ∀ j : ℕ, 1 ≤ j → j ≤ k → ∀ ζ ∈ horizStrip σ₂,
            ‖iteratedDeriv j x_inv ζ‖ ≤ B := by
          intro j hj1 hjk ζ hζ
          rcases eq_or_lt_of_le hj1 with rfl | hj_gt1
          · rw [iteratedDeriv_succ, iteratedDeriv_zero, hderiv_x ζ hζ]
            have h2 := (hVQ_one_add _ (hg_mem ζ hζ)).2
            simpa [shciInvOneAdd] using le_trans h2 hB_ge2
          · obtain ⟨t, rfl⟩ : ∃ t : ℕ, j = t + 2 := ⟨j - 2, by omega⟩
            have hx_split : x_inv = fun ξ => ψ ξ + (ξ - (ρ : ℂ)) := by ext ξ; simp [ψ]
            have hlin_holo : DifferentiableOn ℂ (fun ξ : ℂ => ξ - (ρ : ℂ)) (horizStrip σ₂) :=
              differentiableOn_id.sub (differentiableOn_const _)
            rw [hx_split, iteratedDeriv_fun_add (hContDiffAt (t + 2) hU₂ hψ_holo hζ)
              (hContDiffAt (t + 2) hU₂ hlin_holo hζ), hLinZeroHigh ρ t ζ, add_zero]
            have hψ_t : ‖iteratedDeriv (t + 2) ψ ζ‖ ≤ shciJetB (t + 2) * δ_e :=
              ih (t + 2) (by omega) (by omega) ζ hζ
            have hB_mono : shciJetB (t + 2) ≤ B := hJetBMono hjk
            have hBs_pos : 0 ≤ shciJetB (t + 2) := by have := hJetBGeTwo (t + 2); linarith
            calc ‖iteratedDeriv (t + 2) ψ ζ‖
                ≤ shciJetB (t + 2) * δ_e := hψ_t
              _ ≤ B * 1 := mul_le_mul hB_mono (by linarith) hδ0 (by linarith)
              _ = B := mul_one B
        have he'_holo : DifferentiableOn ℂ (deriv e) (horizStrip σ₁) := he.deriv hU₁
        have hg_holo : DifferentiableOn ℂ (fun ζ => deriv e (x_inv ζ)) (horizStrip σ₂) :=
          he'_holo.comp hx_holo (fun _ hζ => hx_maps _ hζ)
        have hg_bnd : ∀ r ≤ k, ∀ ζ ∈ horizStrip σ₂,
            ‖iteratedDeriv r (fun ξ => deriv e (x_inv ξ)) ζ‖ ≤ δ_e * G := by
          intro r hrk ζ hζ
          have hb := hCompBnd k hU₂ hU₁ hB_ge1 hδ0 hx_holo he'_holo hx_maps hx_deriv_bnd
            (fun j hj w hw => by
              rw [← iteratedDeriv_succ']
              exact he_bnd (j + 1) (by omega) w hw)
            r hrk ζ hζ
          exact le_trans hb (mul_le_mul_of_nonneg_left ((hCompConstMono B hB_ge1).2 hrk) hδ0)
        have hg_bnd_G : ∀ r : ℕ, 1 ≤ r → r ≤ k → ∀ ζ ∈ horizStrip σ₂,
            ‖iteratedDeriv r (fun ξ => deriv e (x_inv ξ)) ζ‖ ≤ G := by
          intro r _ hrk ζ hζ
          calc ‖iteratedDeriv r (fun ξ => deriv e (x_inv ξ)) ζ‖
              ≤ δ_e * G := hg_bnd r hrk ζ hζ
            _ ≤ 1 * G := mul_le_mul_of_nonneg_right (by linarith) (by linarith)
            _ = G := one_mul G
        let M_P : ℝ := (k.factorial : ℝ) * (2 : ℝ) ^ (k + 1)
        have hMP_pos : 0 ≤ M_P := mul_nonneg (Nat.cast_nonneg _) (pow_nonneg (by norm_num) _)
        have hPg_holo : DifferentiableOn ℂ
            (fun ζ => shciInvOneAdd (deriv e (x_inv ζ))) (horizStrip σ₂) :=
          hP_holo.comp hg_holo (fun _ hζ => hg_mem _ hζ)
        have hPg_bnd : ∀ i ≤ k, ∀ ζ ∈ horizStrip σ₂,
            ‖iteratedDeriv i (fun ξ => shciInvOneAdd (deriv e (x_inv ξ))) ζ‖ ≤
              M_P * shciCompConst k G := by
          intro i hik ζ hζ
          have hb := hCompBnd k hU₂ hVQ_open hG_ge1 hMP_pos hg_holo hP_holo hg_mem hg_bnd_G
            (fun r hr w hw => by
              calc ‖iteratedDeriv r shciInvOneAdd w‖
                  ≤ (r.factorial : ℝ) * (2 : ℝ) ^ (r + 1) := hP_bnd r w hw
                _ ≤ M_P := mul_le_mul
                    (Nat.cast_le.mpr (hFactMono hr))
                    (pow_le_pow_right₀ (by norm_num) (Nat.succ_le_succ hr))
                    (pow_nonneg (by norm_num) _) (Nat.cast_nonneg _))
            i hik ζ hζ
          exact le_trans hb
            (mul_le_mul_of_nonneg_left ((hCompConstMono G hG_ge1).2 hik) hMP_pos)
        have hEqψ' : Set.EqOn (deriv ψ)
            (fun ζ => -(deriv e (x_inv ζ) * shciInvOneAdd (deriv e (x_inv ζ))))
            (horizStrip σ₂) := fun ζ hζ => hderiv_ψ ζ hζ
        have hEv := hEqψ'.eventuallyEq_of_mem (hU₂.mem_nhds hz)
        rw [iteratedDeriv_succ', hEv.iteratedDeriv_eq k,
          iteratedDeriv_fun_neg k
            (fun ζ => deriv e (x_inv ζ) * shciInvOneAdd (deriv e (x_inv ζ))) z,
          norm_neg]
        have hCompG_pos : 0 ≤ shciCompConst k G :=
          le_trans zero_le_one ((hCompConstMono G hG_ge1).1 k)
        have hLeib := hLeibnizBnd k (δ_e * G) (M_P * shciCompConst k G)
          hU₂ hg_holo hPg_holo (mul_nonneg hδ0 (by linarith))
          (mul_nonneg hMP_pos hCompG_pos) hz
          (fun i hi => hg_bnd i hi z hz)
          (fun j hj => hPg_bnd j hj z hz)
        have hMax : (2 : ℝ) ^ k * M_P * G * shciCompConst k G ≤ shciJetB (k + 1) := by
          dsimp [shciJetB, B, G, M_P]
          exact le_max_right _ _
        calc ‖iteratedDeriv k
                (fun ζ => deriv e (x_inv ζ) * shciInvOneAdd (deriv e (x_inv ζ))) z‖
            ≤ (2 : ℝ) ^ k * (δ_e * G) * (M_P * shciCompConst k G) := hLeib
          _ = ((2 : ℝ) ^ k * M_P * G * shciCompConst k G) * δ_e := by ring
          _ ≤ shciJetB (k + 1) * δ_e := mul_le_mul_of_nonneg_right hMax hδ0

  have hSingleAux : ∀ (p k : ℕ) {σ₁ σ₂ δ_e ρ : ℝ} {e x_inv : ℂ → ℂ},
      k ≤ p → 0 < σ₁ → 0 < σ₂ → 0 ≤ δ_e → δ_e ≤ 1 / 4 →
      DifferentiableOn ℂ e (horizStrip σ₁) →
      (∀ r ≤ p + 1, ∀ ζ ∈ horizStrip σ₁, ‖iteratedDeriv r e ζ‖ ≤ δ_e) →
      IsShciShiftRightInv σ₁ σ₂ ρ e x_inv →
      (∀ j : ℕ, 1 ≤ j → j ≤ k → ∀ ζ ∈ horizStrip σ₂, ‖iteratedDeriv j x_inv ζ‖ ≤ shciJetB k) ∧
      DifferentiableOn ℂ (fun ξ => deriv e (x_inv ξ)) (horizStrip σ₂) ∧
      (∀ r : ℕ, 1 ≤ r → r ≤ k → ∀ ζ ∈ horizStrip σ₂,
        ‖iteratedDeriv r (fun ξ => deriv e (x_inv ξ)) ζ‖ ≤ shciCompConst k (shciJetB k)) := by
    intro p k σ₁ σ₂ δ_e ρ e x_inv hkp hσ₁ hσ₂ hδ0 hδ_le he he_bnd hx
    have hU₁ := hStripOpen σ₁
    have hU₂ := hStripOpen σ₂
    obtain ⟨hg_mem, hderiv_x, _⟩ :=
      hRightInvODE hσ₁ hσ₂ hδ0 hδ_le he (fun r hr => he_bnd r (by omega)) hx
    have hSing := hJetSingle p hσ₁ hσ₂ hδ0 hδ_le he he_bnd hx
    obtain ⟨hx_holo, hx_maps, _⟩ := hx
    let B := shciJetB k
    let G := shciCompConst k B
    have hB_ge2 : 2 ≤ B := hJetBGeTwo k
    have hB_ge1 : 1 ≤ B := by linarith
    have hG_ge1 : 1 ≤ G := (hCompConstMono B hB_ge1).1 k
    let ψ : ℂ → ℂ := fun ζ => x_inv ζ - (ζ - (ρ : ℂ))
    have hψ_holo : DifferentiableOn ℂ ψ (horizStrip σ₂) :=
      hx_holo.sub (differentiableOn_id.sub (differentiableOn_const (ρ : ℂ)))
    have hx_deriv_bnd : ∀ j : ℕ, 1 ≤ j → j ≤ k → ∀ ζ ∈ horizStrip σ₂,
        ‖iteratedDeriv j x_inv ζ‖ ≤ B := by
      intro j hj1 hjk ζ hζ
      rcases eq_or_lt_of_le hj1 with rfl | hj_gt1
      · rw [iteratedDeriv_succ, iteratedDeriv_zero, hderiv_x ζ hζ]
        have h2 := (hVQ_one_add _ (hg_mem ζ hζ)).2
        simpa [shciInvOneAdd] using le_trans h2 hB_ge2
      · obtain ⟨t, rfl⟩ : ∃ t : ℕ, j = t + 2 := ⟨j - 2, by omega⟩
        have hx_split : x_inv = fun ξ => ψ ξ + (ξ - (ρ : ℂ)) := by ext ξ; simp [ψ]
        have hlin_holo : DifferentiableOn ℂ (fun ξ : ℂ => ξ - (ρ : ℂ)) (horizStrip σ₂) :=
          differentiableOn_id.sub (differentiableOn_const _)
        rw [hx_split, iteratedDeriv_fun_add (hContDiffAt (t + 2) hU₂ hψ_holo hζ)
          (hContDiffAt (t + 2) hU₂ hlin_holo hζ), hLinZeroHigh ρ t ζ, add_zero]
        have hψ_t : ‖iteratedDeriv (t + 2) ψ ζ‖ ≤ shciJetB (t + 2) * δ_e :=
          hSing (t + 2) (le_trans hjk hkp) ζ hζ
        have hB_mono : shciJetB (t + 2) ≤ B := hJetBMono hjk
        calc ‖iteratedDeriv (t + 2) ψ ζ‖
            ≤ shciJetB (t + 2) * δ_e := hψ_t
          _ ≤ B * 1 := mul_le_mul hB_mono (by linarith) hδ0 (by linarith)
          _ = B := mul_one B
    have he'_holo : DifferentiableOn ℂ (deriv e) (horizStrip σ₁) := he.deriv hU₁
    have hg_holo : DifferentiableOn ℂ (fun ξ => deriv e (x_inv ξ)) (horizStrip σ₂) :=
      he'_holo.comp hx_holo (fun _ hζ => hx_maps _ hζ)
    have hg_bnd : ∀ r ≤ k, ∀ ζ ∈ horizStrip σ₂,
        ‖iteratedDeriv r (fun ξ => deriv e (x_inv ξ)) ζ‖ ≤ δ_e * G := by
      intro r hrk ζ hζ
      have hb := hCompBnd k hU₂ hU₁ hB_ge1 hδ0 hx_holo he'_holo hx_maps hx_deriv_bnd
        (fun j hj w hw => by
          rw [← iteratedDeriv_succ']
          exact he_bnd (j + 1) (by omega) w hw)
        r hrk ζ hζ
      exact le_trans hb (mul_le_mul_of_nonneg_left ((hCompConstMono B hB_ge1).2 hrk) hδ0)
    refine ⟨hx_deriv_bnd, hg_holo, fun r _ hrk ζ hζ => ?_⟩
    calc ‖iteratedDeriv r (fun ξ => deriv e (x_inv ξ)) ζ‖
        ≤ δ_e * G := hg_bnd r hrk ζ hζ
      _ ≤ 1 * G := mul_le_mul_of_nonneg_right (by linarith) (by linarith)
      _ = G := one_mul G

  
  have hJetDiff : ∀ (p : ℕ) {σ₁ σ₂ δ_e Δ_e ρ₁ ρ₂ : ℝ} {e₁ e₂ x₁ x₂ : ℂ → ℂ},
      0 < σ₁ → 0 < σ₂ → 0 ≤ δ_e → δ_e ≤ 1 / 4 → 0 ≤ Δ_e →
      DifferentiableOn ℂ e₁ (horizStrip σ₁) →
      DifferentiableOn ℂ e₂ (horizStrip σ₁) →
      (∀ r ≤ p + 1, ∀ ζ ∈ horizStrip σ₁,
        ‖iteratedDeriv r e₁ ζ‖ ≤ δ_e ∧ ‖iteratedDeriv r e₂ ζ‖ ≤ δ_e) →
      (∀ r ≤ p + 1, ∀ ζ ∈ horizStrip σ₁,
        ‖iteratedDeriv r (fun w => e₁ w - e₂ w) ζ‖ ≤ Δ_e) →
      IsShciShiftRightInv σ₁ σ₂ ρ₁ e₁ x₁ →
      IsShciShiftRightInv σ₁ σ₂ ρ₂ e₂ x₂ →
      ∀ k ≤ p, ∀ z ∈ horizStrip σ₂,
        ‖iteratedDeriv k (fun ζ : ℂ => x₁ ζ - x₂ ζ) z‖ ≤
          shciJetL k * (|ρ₁ - ρ₂| + Δ_e) := by
    intro p σ₁ σ₂ δ_e Δ_e ρ₁ ρ₂ e₁ e₂ x₁ x₂ hσ₁ hσ₂ hδ0 hδ_le hΔ0 he₁ he₂ he_bnd hde_bnd hx₁ hx₂
    have hU₁ := hStripOpen σ₁
    have hU₁_conv := hStripConv σ₁
    have hU₂ := hStripOpen σ₂
    have he₁_bnd : ∀ r ≤ p + 1, ∀ ζ ∈ horizStrip σ₁, ‖iteratedDeriv r e₁ ζ‖ ≤ δ_e :=
      fun r hr ζ hζ => (he_bnd r hr ζ hζ).1
    have he₂_bnd : ∀ r ≤ p + 1, ∀ ζ ∈ horizStrip σ₁, ‖iteratedDeriv r e₂ ζ‖ ≤ δ_e :=
      fun r hr ζ hζ => (he_bnd r hr ζ hζ).2
    obtain ⟨hg₁_mem, hderiv_x₁, _⟩ :=
      hRightInvODE hσ₁ hσ₂ hδ0 hδ_le he₁ (fun r hr => he₁_bnd r (by omega)) hx₁
    obtain ⟨hg₂_mem, hderiv_x₂, _⟩ :=
      hRightInvODE hσ₁ hσ₂ hδ0 hδ_le he₂ (fun r hr => he₂_bnd r (by omega)) hx₂
    have hx₁_full := hx₁
    have hx₂_full := hx₂
    obtain ⟨hx₁_holo, hx₁_maps, hx₁_eq⟩ := hx₁
    obtain ⟨hx₂_holo, hx₂_maps, hx₂_eq⟩ := hx₂
    let Δ_tot : ℝ := |ρ₁ - ρ₂| + Δ_e
    have hΔ_tot_pos : 0 ≤ Δ_tot := add_nonneg (abs_nonneg _) hΔ0
    intro k
    induction k using Nat.strong_induction_on with
    | h k ih =>
      intro hkp z hz
      cases k with
      | zero =>
        simp only [iteratedDeriv_zero, shciJetL]
        have hsub_id : x₁ z - x₂ z =
            -(((ρ₁ - ρ₂ : ℝ) : ℂ)) - (e₁ (x₁ z) - e₁ (x₂ z)) - (e₁ (x₂ z) - e₂ (x₂ z)) := by
          have h1 := hx₁_eq z hz
          have h2 := hx₂_eq z hz
          push_cast
          linear_combination h1 - h2
        have he₁_lip : ‖e₁ (x₁ z) - e₁ (x₂ z)‖ ≤ (1 / 2 : ℝ) * ‖x₁ z - x₂ z‖ := by
          have hb := hU₁_conv.norm_image_sub_le_of_norm_deriv_le
            (fun _ hw => he₁.differentiableAt (hU₁.mem_nhds hw))
            (fun w hw => by
              have h1 := he₁_bnd 1 (by omega) w hw
              simpa [iteratedDeriv_succ, iteratedDeriv_zero] using h1)
            (hx₂_maps z hz) (hx₁_maps z hz)
          have hhalf : δ_e * ‖x₁ z - x₂ z‖ ≤ (1 / 2 : ℝ) * ‖x₁ z - x₂ z‖ :=
            mul_le_mul_of_nonneg_right (by linarith) (norm_nonneg _)
          exact le_trans hb hhalf
        have he_diff : ‖e₁ (x₂ z) - e₂ (x₂ z)‖ ≤ Δ_e := by
          simpa [iteratedDeriv_zero] using hde_bnd 0 (Nat.zero_le _) (x₂ z) (hx₂_maps z hz)
        have hρ_norm : ‖(((ρ₁ - ρ₂ : ℝ) : ℂ))‖ = |ρ₁ - ρ₂| := by
          rw [Complex.norm_real, Real.norm_eq_abs]
        have htri : ‖x₁ z - x₂ z‖ ≤
            |ρ₁ - ρ₂| + ‖e₁ (x₁ z) - e₁ (x₂ z)‖ + ‖e₁ (x₂ z) - e₂ (x₂ z)‖ := by
          conv_lhs => rw [hsub_id]
          calc ‖-(((ρ₁ - ρ₂ : ℝ) : ℂ)) - (e₁ (x₁ z) - e₁ (x₂ z)) - (e₁ (x₂ z) - e₂ (x₂ z))‖
              ≤ ‖-(((ρ₁ - ρ₂ : ℝ) : ℂ)) - (e₁ (x₁ z) - e₁ (x₂ z))‖ +
                ‖e₁ (x₂ z) - e₂ (x₂ z)‖ := norm_sub_le _ _
            _ ≤ ‖-(((ρ₁ - ρ₂ : ℝ) : ℂ))‖ + ‖e₁ (x₁ z) - e₁ (x₂ z)‖ +
                ‖e₁ (x₂ z) - e₂ (x₂ z)‖ := by gcongr; exact norm_sub_le _ _
            _ = |ρ₁ - ρ₂| + ‖e₁ (x₁ z) - e₁ (x₂ z)‖ + ‖e₁ (x₂ z) - e₂ (x₂ z)‖ := by
                rw [norm_neg, hρ_norm]
        linarith
      | succ k =>
        have hk_le_p : k ≤ p := Nat.le_of_succ_le hkp
        let B := shciJetB k
        let G := shciCompConst k B
        let L := shciJetL k
        let D := L * shciCompDiffConst k B + shciCompConst k B
        have hB_ge1 : 1 ≤ B := by have := hJetBGeTwo k; linarith
        have hG_ge1 : 1 ≤ G := (hCompConstMono B hB_ge1).1 k
        have hL_pos : 0 ≤ L := by have := hJetLGeTwo k; linarith
        have hcB_pos : 0 ≤ shciCompConst k B :=
          le_trans zero_le_one ((hCompConstMono B hB_ge1).1 k)
        have hdB_pos : 0 ≤ shciCompDiffConst k B :=
          le_trans zero_le_one ((hCompDiffConstMono B hB_ge1).1 k)
        have hD_pos : 0 ≤ D := add_nonneg (mul_nonneg hL_pos hdB_pos) hcB_pos
        obtain ⟨hx₁_db, hg₁_holo, hg₁_db⟩ :=
          hSingleAux p k hk_le_p hσ₁ hσ₂ hδ0 hδ_le he₁ he₁_bnd hx₁_full
        obtain ⟨hx₂_db, hg₂_holo, hg₂_db⟩ :=
          hSingleAux p k hk_le_p hσ₁ hσ₂ hδ0 hδ_le he₂ he₂_bnd hx₂_full
        have hx_diff_k : ∀ s ≤ k, ∀ ζ ∈ horizStrip σ₂,
            ‖iteratedDeriv s (fun ξ => x₁ ξ - x₂ ξ) ζ‖ ≤ L * Δ_tot := by
          intro s hsk ζ hζ
          exact le_trans (ih s (Nat.lt_succ_of_le hsk) (le_trans hsk hk_le_p) ζ hζ)
            (mul_le_mul_of_nonneg_right (hJetLMono hsk) hΔ_tot_pos)
        have he₁'_holo : DifferentiableOn ℂ (deriv e₁) (horizStrip σ₁) := he₁.deriv hU₁
        have hde_sub_holo : DifferentiableOn ℂ (fun w => e₁ w - e₂ w) (horizStrip σ₁) :=
          he₁.sub he₂
        have hde'_holo : DifferentiableOn ℂ (deriv (fun w => e₁ w - e₂ w)) (horizStrip σ₁) :=
          hde_sub_holo.deriv hU₁
        have hg_part1_holo : DifferentiableOn ℂ
            (fun ξ => deriv e₁ (x₁ ξ) - deriv e₁ (x₂ ξ)) (horizStrip σ₂) :=
          hg₁_holo.sub (he₁'_holo.comp hx₂_holo (fun _ hζ => hx₂_maps _ hζ))
        have hg_part2_holo : DifferentiableOn ℂ
            (fun ξ => deriv (fun w => e₁ w - e₂ w) (x₂ ξ)) (horizStrip σ₂) :=
          hde'_holo.comp hx₂_holo (fun _ hζ => hx₂_maps _ hζ)
        have hg_diff_eq : Set.EqOn (fun ξ => deriv e₁ (x₁ ξ) - deriv e₂ (x₂ ξ))
            (fun ξ => (deriv e₁ (x₁ ξ) - deriv e₁ (x₂ ξ)) +
              deriv (fun w => e₁ w - e₂ w) (x₂ ξ)) (horizStrip σ₂) := by
          intro ξ hξ
          have hw : x₂ ξ ∈ horizStrip σ₁ := hx₂_maps ξ hξ
          have hd_sub : deriv (fun w => e₁ w - e₂ w) (x₂ ξ) =
              deriv e₁ (x₂ ξ) - deriv e₂ (x₂ ξ) :=
            ((he₁.differentiableAt (hU₁.mem_nhds hw)).hasDerivAt.sub
              (he₂.differentiableAt (hU₁.mem_nhds hw)).hasDerivAt).deriv
          dsimp only
          rw [hd_sub]
          ring
        have hg_diff_bnd : ∀ j ≤ k, ∀ ζ ∈ horizStrip σ₂,
            ‖iteratedDeriv j (fun ξ => deriv e₁ (x₁ ξ) - deriv e₂ (x₂ ξ)) ζ‖ ≤ D * Δ_tot := by
          intro j hjk ζ hζ
          have hEv_g := hg_diff_eq.eventuallyEq_of_mem (hU₂.mem_nhds hζ)
          rw [hEv_g.iteratedDeriv_eq j,
            iteratedDeriv_fun_add (hContDiffAt j hU₂ hg_part1_holo hζ)
              (hContDiffAt j hU₂ hg_part2_holo hζ)]
          have hb1 : ‖iteratedDeriv j (fun ξ => deriv e₁ (x₁ ξ) - deriv e₁ (x₂ ξ)) ζ‖ ≤
              1 * (L * Δ_tot) * shciCompDiffConst k B := by
            have hraw := hCompSubBnd k hU₂ hU₁ hU₁_conv hB_ge1
              (mul_nonneg hL_pos hΔ_tot_pos) zero_le_one
              hx₁_holo hx₂_holo he₁'_holo hx₁_maps hx₂_maps hx₁_db hx₂_db hx_diff_k
              (fun r hr w hw => by
                rw [← iteratedDeriv_succ']
                exact le_trans (he₁_bnd (r + 1) (by omega) w hw) (by linarith))
              j hjk ζ hζ
            exact le_trans hraw (mul_le_mul_of_nonneg_left
              ((hCompDiffConstMono B hB_ge1).2 hjk)
              (mul_nonneg zero_le_one (mul_nonneg hL_pos hΔ_tot_pos)))
          have hb2 : ‖iteratedDeriv j (fun ξ => deriv (fun w => e₁ w - e₂ w) (x₂ ξ)) ζ‖ ≤
              Δ_tot * shciCompConst k B := by
            have hraw := hCompBnd k hU₂ hU₁ hB_ge1 hΔ_tot_pos hx₂_holo hde'_holo hx₂_maps hx₂_db
              (fun r hr w hw => by
                rw [← iteratedDeriv_succ']
                exact le_trans (hde_bnd (r + 1) (by omega) w hw)
                  (le_add_of_nonneg_left (abs_nonneg _)))
              j hjk ζ hζ
            exact le_trans hraw (mul_le_mul_of_nonneg_left
              ((hCompConstMono B hB_ge1).2 hjk) hΔ_tot_pos)
          calc ‖iteratedDeriv j (fun ξ => deriv e₁ (x₁ ξ) - deriv e₁ (x₂ ξ)) ζ +
                iteratedDeriv j (fun ξ => deriv (fun w => e₁ w - e₂ w) (x₂ ξ)) ζ‖
              ≤ ‖iteratedDeriv j (fun ξ => deriv e₁ (x₁ ξ) - deriv e₁ (x₂ ξ)) ζ‖ +
                ‖iteratedDeriv j (fun ξ => deriv (fun w => e₁ w - e₂ w) (x₂ ξ)) ζ‖ :=
                norm_add_le _ _
            _ ≤ 1 * (L * Δ_tot) * shciCompDiffConst k B + Δ_tot * shciCompConst k B :=
                add_le_add hb1 hb2
            _ = D * Δ_tot := by dsimp [D]; ring
        have hEq_dx : Set.EqOn (deriv (fun ξ => x₁ ξ - x₂ ξ))
            (fun ξ => shciInvOneAdd (deriv e₁ (x₁ ξ)) - shciInvOneAdd (deriv e₂ (x₂ ξ)))
            (horizStrip σ₂) := by
          intro ξ hξ
          dsimp only
          have hd_sub := ((hx₁_holo.differentiableAt (hU₂.mem_nhds hξ)).hasDerivAt.sub
            (hx₂_holo.differentiableAt (hU₂.mem_nhds hξ)).hasDerivAt).deriv
          exact hd_sub.trans (by rw [hderiv_x₁ ξ hξ, hderiv_x₂ ξ hξ])
        have hEv_dx := hEq_dx.eventuallyEq_of_mem (hU₂.mem_nhds hz)
        rw [iteratedDeriv_succ', hEv_dx.iteratedDeriv_eq k]
        let M_P : ℝ := ((k + 1).factorial : ℝ) * (2 : ℝ) ^ (k + 2)
        have hMP_pos : 0 ≤ M_P := mul_nonneg (Nat.cast_nonneg _) (pow_nonneg (by norm_num) _)
        have hFinal := hCompSubBnd k hU₂ hVQ_open hVQ_conv hG_ge1
          (mul_nonneg hD_pos hΔ_tot_pos) hMP_pos
          hg₁_holo hg₂_holo hP_holo hg₁_mem hg₂_mem hg₁_db hg₂_db hg_diff_bnd
          (fun r hr w hw => by
            calc ‖iteratedDeriv r shciInvOneAdd w‖
                ≤ (r.factorial : ℝ) * (2 : ℝ) ^ (r + 1) := hP_bnd r w hw
              _ ≤ M_P := mul_le_mul
                  (Nat.cast_le.mpr (hFactMono hr))
                  (pow_le_pow_right₀ (by norm_num) (Nat.succ_le_succ hr))
                  (pow_nonneg (by norm_num) _) (Nat.cast_nonneg _))
          k le_rfl z hz
        have hMax : M_P * D * shciCompDiffConst k G ≤ shciJetL (k + 1) := by
          dsimp [shciJetL, B, G, L, D, M_P]
          exact le_max_right _ _
        calc ‖iteratedDeriv k
                (fun ζ => shciInvOneAdd (deriv e₁ (x₁ ζ)) - shciInvOneAdd (deriv e₂ (x₂ ζ))) z‖
            ≤ M_P * (D * Δ_tot) * shciCompDiffConst k G := hFinal
          _ = (M_P * D * shciCompDiffConst k G) * Δ_tot := by ring
          _ ≤ shciJetL (k + 1) * Δ_tot := mul_le_mul_of_nonneg_right hMax hΔ_tot_pos

  
  have hPicard : ∀ {r_max : ℕ} {σ₁ σ₂ δ_e ρ : ℝ} {g_ℝ : ℝ → ℝ} {e : ℂ → ℂ},
      1 ≤ r_max → 0 < σ₂ → 0 ≤ δ_e → δ_e ≤ 1 / 4 → (1 + 2 * δ_e) * σ₂ ≤ σ₁ →
      IsShciShiftPerturb r_max σ₁ δ_e ρ g_ℝ e →
      let x_inv := shciShiftInv ρ e
      IsShciShiftRightInv σ₁ σ₂ ρ e x_inv ∧
      (∀ z ∈ horizStrip σ₂, x_inv (z + 2 * Real.pi) = x_inv z + 2 * Real.pi) ∧
      (∀ x : ℝ, x_inv x = ((Function.invFun g_ℝ x : ℝ) : ℂ) ∧
        deriv x_inv x = ((deriv (Function.invFun g_ℝ) x : ℝ) : ℂ)) := by
    intro r_max σ₁ σ₂ δ_e ρ g_ℝ e hr_max hσ₂ hδ0 hδ_le hwidth he
    have hσ₁ : 0 < σ₁ := by nlinarith
    have hU₁ := hStripOpen σ₁
    have hU₁_conv := hStripConv σ₁
    have hU₂ := hStripOpen σ₂
    obtain ⟨he_holo, he_per, he_conj, he_real, he_bnd⟩ := he
    have he_c0 : ∀ ζ ∈ horizStrip σ₁, ‖e ζ‖ ≤ δ_e := fun ζ hζ => by
      simpa [iteratedDeriv_zero] using he_bnd 0 (Nat.zero_le _) ζ hζ
    have he_c1 : ∀ ζ ∈ horizStrip σ₁, ‖deriv e ζ‖ ≤ δ_e := fun ζ hζ => by
      simpa [iteratedDeriv_succ, iteratedDeriv_zero] using he_bnd 1 hr_max ζ hζ
    have he_lip : ∀ ζ₁ ∈ horizStrip σ₁, ∀ ζ₂ ∈ horizStrip σ₁,
        ‖e ζ₁ - e ζ₂‖ ≤ δ_e * ‖ζ₁ - ζ₂‖ :=
      fun ζ₁ hζ₁ ζ₂ hζ₂ =>
        hU₁_conv.norm_image_sub_le_of_norm_deriv_le
          (fun _ hw => he_holo.differentiableAt (hU₁.mem_nhds hw)) he_c1 hζ₂ hζ₁
    have hVertMaps : ∀ (φ : ℂ → ℂ),
        (∀ z ∈ horizStrip σ₂, φ (starRingEnd ℂ z) = starRingEnd ℂ (φ z)) →
        (∀ z₁ ∈ horizStrip σ₂, ∀ z₂ ∈ horizStrip σ₂, ‖φ z₁ - φ z₂‖ ≤ 2 * δ_e * ‖z₁ - z₂‖) →
        ∀ z ∈ horizStrip σ₂, z - (ρ : ℂ) + φ z ∈ horizStrip σ₁ := by
      intro φ hφ_conj hφ_lip z hz
      change |z.im| < σ₂ at hz
      let x₀ : ℂ := (z.re : ℂ)
      have hx₀ : x₀ ∈ horizStrip σ₂ := by
        change |x₀.im| < σ₂; simpa [x₀] using hσ₂
      have hφ_im0 : (φ x₀).im = 0 := by
        have hc := congrArg Complex.im (hφ_conj x₀ hx₀)
        simp only [x₀, Complex.conj_ofReal, Complex.conj_im] at hc
        linarith
      have hz_sub : z - x₀ = ((z.im : ℝ) : ℂ) * Complex.I := by
        dsimp [x₀]
        calc z - (z.re : ℂ) = ((z.re : ℂ) + (z.im : ℂ) * Complex.I) - (z.re : ℂ) := by
              rw [Complex.re_add_im]
          _ = (z.im : ℂ) * Complex.I := by ring
      have hnorm_sub : ‖z - x₀‖ = |z.im| := by
        rw [hz_sub, norm_mul, Complex.norm_real, Real.norm_eq_abs, Complex.norm_I, mul_one]
      have him_le : |(φ z).im| ≤ 2 * δ_e * |z.im| := by
        calc |(φ z).im| = |(φ z - φ x₀).im| := by simp [hφ_im0]
          _ ≤ ‖φ z - φ x₀‖ := Complex.abs_im_le_norm _
          _ ≤ 2 * δ_e * ‖z - x₀‖ := hφ_lip z hz x₀ hx₀
          _ = 2 * δ_e * |z.im| := by rw [hnorm_sub]
      change |(z - (ρ : ℂ) + φ z).im| < σ₁
      have him_tot : (z - (ρ : ℂ) + φ z).im = z.im + (φ z).im := by simp
      rw [him_tot]
      calc |z.im + (φ z).im| ≤ |z.im| + |(φ z).im| := abs_add_le _ _
        _ ≤ |z.im| + 2 * δ_e * |z.im| := by linarith
        _ = (1 + 2 * δ_e) * |z.im| := by ring
        _ < (1 + 2 * δ_e) * σ₂ := mul_lt_mul_of_pos_left hz (by linarith)
        _ ≤ σ₁ := hwidth
    have hSeqProps : ∀ n : ℕ,
        DifferentiableOn ℂ (shciPicardSeq ρ e n) (horizStrip σ₂) ∧
        (∀ z ∈ horizStrip σ₂,
          shciPicardSeq ρ e n (z + 2 * Real.pi) = shciPicardSeq ρ e n z) ∧
        (∀ z ∈ horizStrip σ₂,
          shciPicardSeq ρ e n (starRingEnd ℂ z) = starRingEnd ℂ (shciPicardSeq ρ e n z)) ∧
        (∀ z ∈ horizStrip σ₂, ‖shciPicardSeq ρ e n z‖ ≤ δ_e) ∧
        (∀ z₁ ∈ horizStrip σ₂, ∀ z₂ ∈ horizStrip σ₂,
          ‖shciPicardSeq ρ e n z₁ - shciPicardSeq ρ e n z₂‖ ≤ 2 * δ_e * ‖z₁ - z₂‖) := by
      intro n
      induction n with
      | zero =>
        refine ⟨differentiableOn_const 0, fun _ _ => rfl, fun _ _ => by simp [shciPicardSeq],
          fun _ _ => by simpa [shciPicardSeq] using hδ0,
          fun z₁ _ z₂ _ => by
            simpa [shciPicardSeq] using
              mul_nonneg (by linarith : (0 : ℝ) ≤ 2 * δ_e) (norm_nonneg (z₁ - z₂))⟩
      | succ n ih =>
        obtain ⟨ih_holo, ih_per, ih_conj, _, ih_lip⟩ := ih
        have hfn_maps := hVertMaps (shciPicardSeq ρ e n) ih_conj ih_lip
        have hfn_holo : DifferentiableOn ℂ
            (fun z => z - (ρ : ℂ) + shciPicardSeq ρ e n z) (horizStrip σ₂) :=
          (differentiableOn_id.sub (differentiableOn_const (ρ : ℂ))).add ih_holo
        refine ⟨?_, ?_, ?_, ?_, ?_⟩
        · exact (he_holo.comp hfn_holo (fun _ hz => hfn_maps _ hz)).neg
        · intro z hz
          have hz2 : z + 2 * Real.pi ∈ horizStrip σ₂ := hStripShift2Pi hz
          simp only [shciPicardSeq, ih_per z hz]
          have hsh : (z + 2 * Real.pi) - (ρ : ℂ) + shciPicardSeq ρ e n z =
              (z - (ρ : ℂ) + shciPicardSeq ρ e n z) + 2 * Real.pi := by ring
          rw [hsh, he_per _ (hfn_maps z hz)]
        · intro z hz
          have hzc : starRingEnd ℂ z ∈ horizStrip σ₂ := hStripConj hz
          simp only [shciPicardSeq, ih_conj z hz]
          have hcj : starRingEnd ℂ z - (ρ : ℂ) + starRingEnd ℂ (shciPicardSeq ρ e n z) =
              starRingEnd ℂ (z - (ρ : ℂ) + shciPicardSeq ρ e n z) := by
            simp [map_add, map_sub]
          rw [hcj, he_conj _ (hfn_maps z hz), map_neg]
        · intro z hz
          simp only [shciPicardSeq, norm_neg]
          exact he_c0 _ (hfn_maps z hz)
        · intro z₁ hz₁ z₂ hz₂
          simp only [shciPicardSeq, neg_sub_neg]
          rw [norm_sub_rev]
          have h1 := he_lip _ (hfn_maps z₁ hz₁) _ (hfn_maps z₂ hz₂)
          have h2 : ‖(z₁ - (ρ : ℂ) + shciPicardSeq ρ e n z₁) -
              (z₂ - (ρ : ℂ) + shciPicardSeq ρ e n z₂)‖ ≤ 2 * ‖z₁ - z₂‖ := by
            have hrew : (z₁ - (ρ : ℂ) + shciPicardSeq ρ e n z₁) -
                (z₂ - (ρ : ℂ) + shciPicardSeq ρ e n z₂) =
                (z₁ - z₂) + (shciPicardSeq ρ e n z₁ - shciPicardSeq ρ e n z₂) := by ring
            rw [hrew]
            calc ‖(z₁ - z₂) + (shciPicardSeq ρ e n z₁ - shciPicardSeq ρ e n z₂)‖
                ≤ ‖z₁ - z₂‖ + ‖shciPicardSeq ρ e n z₁ - shciPicardSeq ρ e n z₂‖ :=
                  norm_add_le _ _
              _ ≤ ‖z₁ - z₂‖ + 2 * δ_e * ‖z₁ - z₂‖ := by
                  linarith [ih_lip z₁ hz₁ z₂ hz₂]
              _ ≤ 2 * ‖z₁ - z₂‖ := by nlinarith [norm_nonneg (z₁ - z₂)]
          calc ‖e (z₁ - (ρ : ℂ) + shciPicardSeq ρ e n z₁) -
                e (z₂ - (ρ : ℂ) + shciPicardSeq ρ e n z₂)‖
              ≤ δ_e * ‖(z₁ - (ρ : ℂ) + shciPicardSeq ρ e n z₁) -
                  (z₂ - (ρ : ℂ) + shciPicardSeq ρ e n z₂)‖ := h1
            _ ≤ δ_e * (2 * ‖z₁ - z₂‖) := mul_le_mul_of_nonneg_left h2 hδ0
            _ = 2 * δ_e * ‖z₁ - z₂‖ := by ring
    have hSeqStep : ∀ n : ℕ, ∀ z ∈ horizStrip σ₂,
        dist (shciPicardSeq ρ e n z) (shciPicardSeq ρ e (n + 1) z) ≤
          δ_e * (1 / 2 : ℝ) ^ n := by
      intro n
      induction n with
      | zero =>
        intro z hz
        simpa [shciPicardSeq, dist_zero_left] using (hSeqProps 1).2.2.2.1 z hz
      | succ n ih =>
        intro z hz
        have hfn_maps := hVertMaps (shciPicardSeq ρ e n) (hSeqProps n).2.2.1 (hSeqProps n).2.2.2.2
        have hfn1_maps := hVertMaps (shciPicardSeq ρ e (n + 1))
          (hSeqProps (n + 1)).2.2.1 (hSeqProps (n + 1)).2.2.2.2
        rw [dist_eq_norm]
        simp only [shciPicardSeq, neg_sub_neg]
        rw [norm_sub_rev]
        have h1 := he_lip _ (hfn_maps z hz) _ (hfn1_maps z hz)
        have hsub : (z - (ρ : ℂ) + shciPicardSeq ρ e n z) -
            (z - (ρ : ℂ) + shciPicardSeq ρ e (n + 1) z) =
            shciPicardSeq ρ e n z - shciPicardSeq ρ e (n + 1) z := by ring
        rw [hsub] at h1
        calc ‖e (z - (ρ : ℂ) + shciPicardSeq ρ e n z) -
              e (z - (ρ : ℂ) + shciPicardSeq ρ e (n + 1) z)‖
            ≤ δ_e * ‖shciPicardSeq ρ e n z - shciPicardSeq ρ e (n + 1) z‖ := h1
          _ = δ_e * dist (shciPicardSeq ρ e n z) (shciPicardSeq ρ e (n + 1) z) := by
              rw [dist_eq_norm]
          _ ≤ (1 / 2 : ℝ) * (δ_e * (1 / 2 : ℝ) ^ n) :=
              mul_le_mul (by linarith) (ih z hz) dist_nonneg (by norm_num)
          _ = δ_e * (1 / 2 : ℝ) ^ (n + 1) := by rw [pow_succ]; ring
    let ψ : ℂ → ℂ := fun z => Filter.limUnder Filter.atTop (fun n => shciPicardSeq ρ e n z)
    have hTendsto : ∀ z ∈ horizStrip σ₂,
        Filter.Tendsto (fun n => shciPicardSeq ρ e n z) Filter.atTop (nhds (ψ z)) :=
      fun z hz =>
        (cauchySeq_of_le_geometric (1 / 2) δ_e (by norm_num) (fun n => hSeqStep n z hz)).tendsto_limUnder
    have hDistLim : ∀ n : ℕ, ∀ z ∈ horizStrip σ₂,
        dist (shciPicardSeq ρ e n z) (ψ z) ≤ 2 * δ_e * (1 / 2 : ℝ) ^ n := by
      intro n z hz
      have hd := dist_le_of_le_geometric_of_tendsto (1 / 2) δ_e (by norm_num)
        (fun k => hSeqStep k z hz) (hTendsto z hz) n
      calc dist (shciPicardSeq ρ e n z) (ψ z)
          ≤ δ_e * (1 / 2 : ℝ) ^ n / (1 - 1 / 2) := hd
        _ = 2 * δ_e * (1 / 2 : ℝ) ^ n := by ring
    have hUnif : TendstoUniformlyOn (shciPicardSeq ρ e) ψ Filter.atTop (horizStrip σ₂) := by
      rw [Metric.tendstoUniformlyOn_iff]
      intro ε hε
      have hHalf0 : Filter.Tendsto (fun n : ℕ => (1 / 2 : ℝ) ^ n) Filter.atTop (nhds 0) :=
        tendsto_pow_atTop_nhds_zero_of_lt_one (show (0 : ℝ) ≤ 1 / 2 by norm_num)
          (show (1 / 2 : ℝ) < 1 by norm_num)
      have hGeom0 : Filter.Tendsto (fun n : ℕ => 2 * δ_e * (1 / 2 : ℝ) ^ n)
          Filter.atTop (nhds 0) := by
        simpa using tendsto_const_nhds.mul hHalf0
      filter_upwards [(tendsto_order.mp hGeom0).2 ε hε] with n hn z hz
      rw [dist_comm]
      exact lt_of_le_of_lt (hDistLim n z hz) hn
    have hψ_holo : DifferentiableOn ℂ ψ (horizStrip σ₂) :=
      (hUnif.tendstoLocallyUniformlyOn).differentiableOn
        (Filter.Eventually.of_forall fun n => (hSeqProps n).1) hU₂
    have hψ_per : ∀ z ∈ horizStrip σ₂, ψ (z + 2 * Real.pi) = ψ z := by
      intro z hz
      have ht1 := hTendsto (z + 2 * Real.pi) (hStripShift2Pi hz)
      have ht2 : Filter.Tendsto (fun n => shciPicardSeq ρ e n (z + 2 * Real.pi))
          Filter.atTop (nhds (ψ z)) :=
        (hTendsto z hz).congr (fun n => ((hSeqProps n).2.1 z hz).symm)
      exact tendsto_nhds_unique ht1 ht2
    have hψ_conj : ∀ z ∈ horizStrip σ₂, ψ (starRingEnd ℂ z) = starRingEnd ℂ (ψ z) := by
      intro z hz
      have ht1 := hTendsto (starRingEnd ℂ z) (hStripConj hz)
      have ht2 : Filter.Tendsto (fun n => shciPicardSeq ρ e n (starRingEnd ℂ z))
          Filter.atTop (nhds (starRingEnd ℂ (ψ z))) :=
        ((Complex.continuous_conj.continuousAt.tendsto).comp (hTendsto z hz)).congr
          (fun n => ((hSeqProps n).2.2.1 z hz).symm)
      exact tendsto_nhds_unique ht1 ht2
    have hψ_lip : ∀ z₁ ∈ horizStrip σ₂, ∀ z₂ ∈ horizStrip σ₂,
        ‖ψ z₁ - ψ z₂‖ ≤ 2 * δ_e * ‖z₁ - z₂‖ := by
      intro z₁ hz₁ z₂ hz₂
      exact le_of_tendsto
        (continuous_norm.continuousAt.tendsto.comp ((hTendsto z₁ hz₁).sub (hTendsto z₂ hz₂)))
        (Filter.Eventually.of_forall fun n => (hSeqProps n).2.2.2.2 z₁ hz₁ z₂ hz₂)
    let x_inv := shciShiftInv ρ e
    have hx_holo : DifferentiableOn ℂ x_inv (horizStrip σ₂) :=
      (differentiableOn_id.sub (differentiableOn_const (ρ : ℂ))).add hψ_holo
    have hx_maps : ∀ z ∈ horizStrip σ₂, x_inv z ∈ horizStrip σ₁ :=
      hVertMaps ψ hψ_conj hψ_lip
    have hx_eq : ∀ z ∈ horizStrip σ₂, x_inv z + (ρ : ℂ) + e (x_inv z) = z := by
      intro z hz
      have ht_shift : Filter.Tendsto (fun n => shciPicardSeq ρ e (n + 1) z)
          Filter.atTop (nhds (ψ z)) :=
        (Filter.tendsto_add_atTop_iff_nat 1).mpr (hTendsto z hz)
      have ht_arg : Filter.Tendsto (fun n => z - (ρ : ℂ) + shciPicardSeq ρ e n z)
          Filter.atTop (nhds (x_inv z)) :=
        tendsto_const_nhds.add (hTendsto z hz)
      have he_cont : ContinuousAt e (x_inv z) :=
        he_holo.continuousOn.continuousAt (hU₁.mem_nhds (hx_maps z hz))
      have ht_rhs : Filter.Tendsto (fun n => -e (z - (ρ : ℂ) + shciPicardSeq ρ e n z))
          Filter.atTop (nhds (-e (x_inv z))) :=
        (he_cont.tendsto.comp ht_arg).neg
      have hψ_fix : ψ z = -e (x_inv z) := tendsto_nhds_unique ht_shift ht_rhs
      dsimp [x_inv, shciShiftInv]
      change z - (ρ : ℂ) + ψ z + (ρ : ℂ) + e (x_inv z) = z
      rw [hψ_fix]
      ring
    have hx_per : ∀ z ∈ horizStrip σ₂, x_inv (z + 2 * Real.pi) = x_inv z + 2 * Real.pi := by
      intro z hz
      dsimp [x_inv, shciShiftInv]
      change (z + 2 * Real.pi) - (ρ : ℂ) + ψ (z + 2 * Real.pi) =
        (z - (ρ : ℂ) + ψ z) + 2 * Real.pi
      rw [hψ_per z hz]
      ring
    
    have hg_mono : Function.Injective g_ℝ := by
      have hg_deriv_pos : ∀ x : ℝ, 0 < deriv g_ℝ x := by
        intro x
        have hx_mem : (x : ℂ) ∈ horizStrip σ₁ := by
          change |(x : ℂ).im| < σ₁; simpa using hσ₁
        have hd_F : HasDerivAt (fun ζ : ℂ => ζ + (ρ : ℂ) + e ζ)
            (1 + deriv e (x : ℂ)) (x : ℂ) :=
          ((hasDerivAt_id (x : ℂ)).add_const (ρ : ℂ)).add
            (he_holo.differentiableAt (hU₁.mem_nhds hx_mem)).hasDerivAt
        have hd_re0 : HasDerivAt (fun u : ℝ => ((u : ℂ) + (ρ : ℂ) + e (u : ℂ)).re)
            ((1 + deriv e (x : ℂ)).re) x :=
          Complex.reCLM.hasFDerivAt.comp_hasDerivAt x hd_F.comp_ofReal
        have hd_re1 : HasDerivAt g_ℝ ((1 + deriv e (x : ℂ)).re) x := by
          simpa [he_real] using hd_re0
        rw [hd_re1.deriv, Complex.add_re, Complex.one_re]
        have hre_bnd : |(deriv e (x : ℂ)).re| ≤ δ_e :=
          le_trans (Complex.abs_re_le_norm _) (he_c1 (x : ℂ) hx_mem)
        have hre_low := neg_le_of_abs_le hre_bnd
        linarith
      exact (strictMono_of_deriv_pos hg_deriv_pos).injective
    have hx_real_val : ∀ u : ℝ, x_inv (u : ℂ) = ((Function.invFun g_ℝ u : ℝ) : ℂ) := by
      intro u
      have hu_mem : (u : ℂ) ∈ horizStrip σ₂ := by
        change |(u : ℂ).im| < σ₂; simpa using hσ₂
      have hψ_im0 : (ψ (u : ℂ)).im = 0 := by
        have hc := congrArg Complex.im (hψ_conj (u : ℂ) hu_mem)
        simp only [Complex.conj_ofReal, Complex.conj_im] at hc
        linarith
      have hx_im0 : (x_inv (u : ℂ)).im = 0 := by
        dsimp [x_inv, shciShiftInv]
        change ((u : ℂ) - (ρ : ℂ) + ψ (u : ℂ)).im = 0
        simp [hψ_im0]
      let x₁ : ℝ := (x_inv (u : ℂ)).re
      have hx_cast : x_inv (u : ℂ) = (x₁ : ℂ) := by
        symm
        calc (x₁ : ℂ) = ((x_inv (u : ℂ)).re : ℂ) + ((x_inv (u : ℂ)).im : ℂ) * Complex.I := by
              simp [x₁, hx_im0]
          _ = x_inv (u : ℂ) := Complex.re_add_im _
      have hgx₁ : g_ℝ x₁ = u := by
        have h1 := hx_eq (u : ℂ) hu_mem
        rw [hx_cast, he_real x₁] at h1
        exact Complex.ofReal_inj.mp h1
      have hinv_eq : Function.invFun g_ℝ u = x₁ :=
        hg_mono ((Function.invFun_eq ⟨x₁, hgx₁⟩).trans hgx₁.symm)
      rw [hinv_eq, hx_cast]
    refine ⟨⟨hx_holo, hx_maps, hx_eq⟩, hx_per, fun x => ⟨hx_real_val x, ?_⟩⟩
    have hx_mem : (x : ℂ) ∈ horizStrip σ₂ := by
      change |(x : ℂ).im| < σ₂; simpa using hσ₂
    have hD : HasDerivAt x_inv (deriv x_inv (x : ℂ)) (x : ℂ) :=
      (hx_holo.differentiableAt (hU₂.mem_nhds hx_mem)).hasDerivAt
    have h_comp : HasDerivAt (fun u : ℝ => x_inv (u : ℂ)) (deriv x_inv (x : ℂ)) x :=
      hD.comp_ofReal
    have h_re0 : HasDerivAt (fun u : ℝ => (x_inv (u : ℂ)).re) (deriv x_inv (x : ℂ)).re x :=
      Complex.reCLM.hasFDerivAt.comp_hasDerivAt x h_comp
    have h_re : HasDerivAt (Function.invFun g_ℝ) (deriv x_inv (x : ℂ)).re x := by
      simpa [hx_real_val] using h_re0
    have h_ofR : HasDerivAt (fun u : ℝ => x_inv (u : ℂ))
        (((deriv x_inv (x : ℂ)).re : ℝ) : ℂ) x := by
      simpa [← hx_real_val] using h_re.ofReal_comp
    rw [h_re.deriv]
    exact h_comp.unique h_ofR

  
  have hSupNonneg : ∀ (σ : ℝ) (W₁ W₂ : ℂ → ℂ), 0 ≤ stripDiffSup (m + 15) σ W₁ W₂ := by
    intro σ W₁ W₂
    apply Real.sSup_nonneg
    rintro r ⟨j, _, ζ, _, rfl⟩
    exact norm_nonneg _

  have hLinCombBnd : ∀ {σ' : ℝ} {q : ℕ} {A : ℝ} {u Δu m_fn : ℂ → ℂ} (c₀ c₁ c₂ : ℝ),
      0 < σ' → 1 ≤ (q : ℝ) → 0 ≤ A →
      |c₀| ≤ 1 → |c₁| ≤ 1 → |c₂| ≤ 1 →
      DifferentiableOn ℂ u (horizStrip σ') →
      DifferentiableOn ℂ Δu (horizStrip σ') →
      DifferentiableOn ℂ m_fn (horizStrip σ') →
      (∀ k ≤ m + 2, ∀ z ∈ horizStrip σ', (q : ℝ) ^ 2 * ‖iteratedDeriv k u z‖ ≤ S.R_mesh * A) →
      (∀ k ≤ m + 2, ∀ z ∈ horizStrip σ', (q : ℝ) ^ 3 * ‖iteratedDeriv k Δu z‖ ≤ S.R_mesh * A) →
      (∀ k ≤ m + 2, ∀ z ∈ horizStrip σ', (q : ℝ) ^ 2 * ‖iteratedDeriv k m_fn z‖ ≤ S.R_mesh * A) →
      ∀ r ≤ m + 2, ∀ z ∈ horizStrip σ',
        ‖iteratedDeriv r (fun ζ => (c₀ : ℂ) * u ζ + (c₁ : ℂ) * Δu ζ + (c₂ : ℂ) * m_fn ζ) z‖ ≤
          (3 * S.R_mesh / (q : ℝ) ^ 2) * A := by
    intro σ' q A u Δu m_fn c₀ c₁ c₂ _ hq1 _ hc₀ hc₁ hc₂ hu hΔ hm bu bΔ bm r hr z hz
    have hU := hStripOpen σ'
    have hq_pos : 0 < (q : ℝ) := by linarith
    have hq2_pos : 0 < (q : ℝ) ^ 2 := sq_pos_of_pos hq_pos
    have hq2_le_q3 : (q : ℝ) ^ 2 ≤ (q : ℝ) ^ 3 := by nlinarith
    have hcu : ContDiffAt ℂ r u z := hContDiffAt r hU hu hz
    have hcΔ : ContDiffAt ℂ r Δu z := hContDiffAt r hU hΔ hz
    have hcm : ContDiffAt ℂ r m_fn z := hContDiffAt r hU hm hz
    have hc0u : ContDiffAt ℂ r (fun ζ => (c₀ : ℂ) * u ζ) z := hcu.const_smul (c₀ : ℂ)
    have hc1Δ : ContDiffAt ℂ r (fun ζ => (c₁ : ℂ) * Δu ζ) z := hcΔ.const_smul (c₁ : ℂ)
    have hc2m : ContDiffAt ℂ r (fun ζ => (c₂ : ℂ) * m_fn ζ) z := hcm.const_smul (c₂ : ℂ)
    rw [iteratedDeriv_fun_add (hc0u.add hc1Δ) hc2m, iteratedDeriv_fun_add hc0u hc1Δ,
      iteratedDeriv_const_mul (c₀ : ℂ) hcu, iteratedDeriv_const_mul (c₁ : ℂ) hcΔ,
      iteratedDeriv_const_mul (c₂ : ℂ) hcm]
    have hΔ_q2 : (q : ℝ) ^ 2 * ‖iteratedDeriv r Δu z‖ ≤ S.R_mesh * A :=
      le_trans (mul_le_mul_of_nonneg_right hq2_le_q3 (norm_nonneg _)) (bΔ r hr z hz)
    have htri : ‖(c₀ : ℂ) * iteratedDeriv r u z + (c₁ : ℂ) * iteratedDeriv r Δu z +
          (c₂ : ℂ) * iteratedDeriv r m_fn z‖ ≤
        ‖iteratedDeriv r u z‖ + ‖iteratedDeriv r Δu z‖ + ‖iteratedDeriv r m_fn z‖ := by
      calc ‖(c₀ : ℂ) * iteratedDeriv r u z + (c₁ : ℂ) * iteratedDeriv r Δu z +
              (c₂ : ℂ) * iteratedDeriv r m_fn z‖
          ≤ ‖(c₀ : ℂ) * iteratedDeriv r u z + (c₁ : ℂ) * iteratedDeriv r Δu z‖ +
            ‖(c₂ : ℂ) * iteratedDeriv r m_fn z‖ := norm_add_le _ _
        _ ≤ ‖(c₀ : ℂ) * iteratedDeriv r u z‖ + ‖(c₁ : ℂ) * iteratedDeriv r Δu z‖ +
            ‖(c₂ : ℂ) * iteratedDeriv r m_fn z‖ := by gcongr; exact norm_add_le _ _
        _ = |c₀| * ‖iteratedDeriv r u z‖ + |c₁| * ‖iteratedDeriv r Δu z‖ +
            |c₂| * ‖iteratedDeriv r m_fn z‖ := by
            simp [Complex.norm_real, Real.norm_eq_abs]
        _ ≤ 1 * ‖iteratedDeriv r u z‖ + 1 * ‖iteratedDeriv r Δu z‖ +
            1 * ‖iteratedDeriv r m_fn z‖ := by
            gcongr
        _ = ‖iteratedDeriv r u z‖ + ‖iteratedDeriv r Δu z‖ + ‖iteratedDeriv r m_fn z‖ := by ring
    have hscaled : (q : ℝ) ^ 2 *
        ‖(c₀ : ℂ) * iteratedDeriv r u z + (c₁ : ℂ) * iteratedDeriv r Δu z +
          (c₂ : ℂ) * iteratedDeriv r m_fn z‖ ≤ 3 * S.R_mesh * A := by
      have h1 := mul_le_mul_of_nonneg_left htri (le_of_lt hq2_pos)
      have hbu := bu r hr z hz
      have hbm := bm r hr z hz
      linarith
    rw [div_mul_eq_mul_div, le_div_iff₀ hq2_pos]
    linarith

  have hMeshPerturbSingle : ∀ {σ : ℝ} {q : ℕ} {w : ℝ → ℝ} {W : ℂ → ℂ} {X_ℂ μ_ℂ : ℕ → ℂ → ℂ},
      σ ∈ Set.Ioc (0 : ℝ) 1 → S.N_mesh ≤ q → S.K_mesh / (q : ℝ) ^ 2 < 1 →
      IsStripMeshExt m (M + 1) S σ q w W X_ℂ μ_ℂ →
      let σ_mesh := (1 - S.K_mesh / (q : ℝ) ^ 2) * σ
      let δ_e := 3 * S.R_mesh / (q : ℝ) ^ 2
      ∀ j < q,
        (∀ α ∈ Set.Icc (0 : ℝ) 1,
          IsShciShiftPerturb (m + 2) σ_mesh δ_e (shciShiftMinus q j α)
            (halfCellMinus_ℝ q w j α) (shciPerturbMinus q X_ℂ μ_ℂ j α) ∧
          IsShciShiftPerturb (m + 2) σ_mesh δ_e (shciShiftPlus q j α)
            (halfCellPlus_ℝ q w j α) (shciPerturbPlus q X_ℂ μ_ℂ j α)) ∧
        (∀ α₁ ∈ Set.Icc (0 : ℝ) 1, ∀ α₂ ∈ Set.Icc (0 : ℝ) 1,
          |shciShiftMinus q j α₁ - shciShiftMinus q j α₂| ≤ (Real.pi / (q : ℝ)) * |α₁ - α₂| ∧
          |shciShiftPlus q j α₁ - shciShiftPlus q j α₂| ≤ (Real.pi / (q : ℝ)) * |α₁ - α₂| ∧
          (∀ r ≤ m + 2, ∀ ζ ∈ horizStrip σ_mesh,
            ‖iteratedDeriv r (fun z =>
                shciPerturbMinus q X_ℂ μ_ℂ j α₁ z - shciPerturbMinus q X_ℂ μ_ℂ j α₂ z) ζ‖ ≤
              δ_e * |α₁ - α₂| ∧
            ‖iteratedDeriv r (fun z =>
                shciPerturbPlus q X_ℂ μ_ℂ j α₁ z - shciPerturbPlus q X_ℂ μ_ℂ j α₂ z) ζ‖ ≤
              δ_e * |α₁ - α₂|)) := by
    intro σ q w W X_ℂ μ_ℂ hσ hq hKm hMesh σ_mesh δ_e j hj
    have hσ_pos : 0 < σ := hσ.1
    have hσm_pos : 0 < σ_mesh := mul_pos (by linarith) hσ_pos
    have hq4 : 4 ≤ q := le_trans S.N_mesh_ge_four hq
    have hq1 : 1 ≤ (q : ℝ) := by exact_mod_cast (by omega : 1 ≤ q)
    have hq_pos : 0 < (q : ℝ) := by linarith
    obtain ⟨_, hX, hμ⟩ := hMesh
    obtain ⟨hXj_holo, hXj_real, hXj_per, hXj_conj, _, hXj_bnd⟩ := hX j (le_of_lt hj)
    obtain ⟨hXj1_holo, hXj1_real, hXj1_per, hXj1_conj, _, _⟩ := hX (j + 1) (Nat.succ_le_of_lt hj)
    obtain ⟨hμj_holo, hμj_real, hμj_per, hμj_conj, _, hΔ_bnd, hm_bnd⟩ := hμ j hj
    let u_j : ℂ → ℂ := fun ζ => X_ℂ j ζ - (ζ + ((2 * Real.pi * (j : ℝ) / (q : ℝ) : ℝ) : ℂ))
    let Δu_j : ℂ → ℂ := fun ζ => (X_ℂ (j + 1) ζ - X_ℂ j ζ) - ((2 * Real.pi / (q : ℝ) : ℝ) : ℂ)
    let m_j : ℂ → ℂ := fun ζ => μ_ℂ j ζ - (X_ℂ j ζ + (X_ℂ (j + 1) ζ - X_ℂ j ζ) / 2)
    have hu_holo : DifferentiableOn ℂ u_j (horizStrip σ_mesh) :=
      hXj_holo.sub (differentiableOn_id.add (differentiableOn_const _))
    have hΔ_holo : DifferentiableOn ℂ Δu_j (horizStrip σ_mesh) :=
      (hXj1_holo.sub hXj_holo).sub (differentiableOn_const _)
    have hm_holo : DifferentiableOn ℂ m_j (horizStrip σ_mesh) :=
      hμj_holo.sub (hXj_holo.add ((hXj1_holo.sub hXj_holo).div_const 2))
    have hMinus_eq : ∀ α : ℝ, shciPerturbMinus q X_ℂ μ_ℂ j α =
        fun ζ => (1 : ℂ) * u_j ζ + ((α / 2 : ℝ) : ℂ) * Δu_j ζ + (α : ℂ) * m_j ζ := by
      intro α; ext ζ
      dsimp [shciPerturbMinus, shciShiftMinus, u_j, Δu_j, m_j]
      push_cast; ring
    have hPlus_eq : ∀ α : ℝ, shciPerturbPlus q X_ℂ μ_ℂ j α =
        fun ζ => (1 : ℂ) * u_j ζ + (((1 + α) / 2 : ℝ) : ℂ) * Δu_j ζ +
          ((1 - α : ℝ) : ℂ) * m_j ζ := by
      intro α; ext ζ
      dsimp [shciPerturbPlus, shciShiftPlus, u_j, Δu_j, m_j]
      push_cast; ring
    refine ⟨?_, ?_⟩
    · intro α hα
      have hα0 : 0 ≤ α := hα.1
      have hα1 : α ≤ 1 := hα.2
      refine ⟨⟨?_, ?_, ?_, ?_, ?_⟩, ⟨?_, ?_, ?_, ?_, ?_⟩⟩
      · rw [hMinus_eq α]
        exact ((hu_holo.const_mul _).add (hΔ_holo.const_mul _)).add (hm_holo.const_mul _)
      · intro ζ hζ
        dsimp [shciPerturbMinus]
        rw [hXj_per ζ hζ, hμj_per ζ hζ]
        ring
      · intro ζ hζ
        dsimp [shciPerturbMinus]
        rw [hXj_conj ζ hζ, hμj_conj ζ hζ]
        simp [map_add, map_sub, map_mul]
      · intro x
        dsimp [shciPerturbMinus, halfCellMinus_ℝ]
        rw [hXj_real x, hμj_real x]
        push_cast; ring
      · intro r hr ζ hζ
        rw [hMinus_eq α]
        simpa [δ_e] using hLinCombBnd 1 (α / 2) α hσm_pos hq1 zero_le_one
          (by norm_num) (by rw [abs_of_nonneg (by linarith)]; linarith)
          (by rw [abs_of_nonneg hα0]; exact hα1)
          hu_holo hΔ_holo hm_holo
          (fun k hk z hz => by rw [mul_one]; exact hXj_bnd k hk z hz)
          (fun k hk z hz => by rw [mul_one]; exact hΔ_bnd k hk z hz)
          (fun k hk z hz => by rw [mul_one]; exact hm_bnd k hk z hz) r hr ζ hζ
      · rw [hPlus_eq α]
        exact ((hu_holo.const_mul _).add (hΔ_holo.const_mul _)).add (hm_holo.const_mul _)
      · intro ζ hζ
        dsimp [shciPerturbPlus]
        rw [hXj1_per ζ hζ, hμj_per ζ hζ]
        ring
      · intro ζ hζ
        dsimp [shciPerturbPlus]
        rw [hXj1_conj ζ hζ, hμj_conj ζ hζ]
        simp [map_add, map_sub, map_mul]
      · intro x
        dsimp [shciPerturbPlus, halfCellPlus_ℝ]
        rw [hXj1_real x, hμj_real x]
        push_cast; ring
      · intro r hr ζ hζ
        rw [hPlus_eq α]
        simpa [δ_e] using hLinCombBnd 1 ((1 + α) / 2) (1 - α) hσm_pos hq1 zero_le_one
          (by norm_num) (by rw [abs_of_nonneg (by linarith)]; linarith)
          (by rw [abs_of_nonneg (by linarith)]; linarith)
          hu_holo hΔ_holo hm_holo
          (fun k hk z hz => by rw [mul_one]; exact hXj_bnd k hk z hz)
          (fun k hk z hz => by rw [mul_one]; exact hΔ_bnd k hk z hz)
          (fun k hk z hz => by rw [mul_one]; exact hm_bnd k hk z hz) r hr ζ hζ
    · intro α₁ _ α₂ _
      have hsh_m : shciShiftMinus q j α₁ - shciShiftMinus q j α₂ =
          (Real.pi / (q : ℝ)) * (α₁ - α₂) := by
        dsimp [shciShiftMinus]; ring
      have hsh_p : shciShiftPlus q j α₁ - shciShiftPlus q j α₂ =
          (Real.pi / (q : ℝ)) * (α₁ - α₂) := by
        dsimp [shciShiftPlus]; ring
      have hpi_q_pos : 0 ≤ Real.pi / (q : ℝ) := div_nonneg (le_of_lt Real.pi_pos) (le_of_lt hq_pos)
      refine ⟨by rw [hsh_m, abs_mul, abs_of_nonneg hpi_q_pos],
        by rw [hsh_p, abs_mul, abs_of_nonneg hpi_q_pos], ?_⟩
      intro r hr ζ hζ
      have hU := hStripOpen σ_mesh
      have hm_sub : (fun z => shciPerturbMinus q X_ℂ μ_ℂ j α₁ z -
            shciPerturbMinus q X_ℂ μ_ℂ j α₂ z) =
          fun z => ((α₁ - α₂ : ℝ) : ℂ) *
            (((0 : ℝ) : ℂ) * u_j z + ((1 / 2 : ℝ) : ℂ) * Δu_j z + ((1 : ℝ) : ℂ) * m_j z) := by
        ext z; dsimp [shciPerturbMinus, shciShiftMinus, u_j, Δu_j, m_j]; push_cast; ring
      have hp_sub : (fun z => shciPerturbPlus q X_ℂ μ_ℂ j α₁ z -
            shciPerturbPlus q X_ℂ μ_ℂ j α₂ z) =
          fun z => ((α₁ - α₂ : ℝ) : ℂ) *
            (((0 : ℝ) : ℂ) * u_j z + ((1 / 2 : ℝ) : ℂ) * Δu_j z + ((-1 : ℝ) : ℂ) * m_j z) := by
        ext z; dsimp [shciPerturbPlus, shciShiftPlus, u_j, Δu_j, m_j]; push_cast; ring
      have hc_m : ContDiffAt ℂ r
          (fun z => ((0 : ℝ) : ℂ) * u_j z + ((1 / 2 : ℝ) : ℂ) * Δu_j z + ((1 : ℝ) : ℂ) * m_j z)
          ζ :=
        hContDiffAt r hU (((hu_holo.const_mul _).add (hΔ_holo.const_mul _)).add (hm_holo.const_mul _)) hζ
      have hc_p : ContDiffAt ℂ r
          (fun z => ((0 : ℝ) : ℂ) * u_j z + ((1 / 2 : ℝ) : ℂ) * Δu_j z + ((-1 : ℝ) : ℂ) * m_j z)
          ζ :=
        hContDiffAt r hU (((hu_holo.const_mul _).add (hΔ_holo.const_mul _)).add (hm_holo.const_mul _)) hζ
      refine ⟨?_, ?_⟩
      · rw [hm_sub, iteratedDeriv_const_mul _ hc_m, norm_mul, Complex.norm_real, Real.norm_eq_abs,
          mul_comm |α₁ - α₂|]
        apply mul_le_mul_of_nonneg_right _ (abs_nonneg _)
        simpa [δ_e] using hLinCombBnd 0 (1 / 2) 1 hσm_pos hq1 zero_le_one
          (by norm_num) (by norm_num) (by norm_num)
          hu_holo hΔ_holo hm_holo
          (fun k hk z hz => by rw [mul_one]; exact hXj_bnd k hk z hz)
          (fun k hk z hz => by rw [mul_one]; exact hΔ_bnd k hk z hz)
          (fun k hk z hz => by rw [mul_one]; exact hm_bnd k hk z hz) r hr ζ hζ
      · rw [hp_sub, iteratedDeriv_const_mul _ hc_p, norm_mul, Complex.norm_real, Real.norm_eq_abs,
          mul_comm |α₁ - α₂|]
        apply mul_le_mul_of_nonneg_right _ (abs_nonneg _)
        simpa [δ_e] using hLinCombBnd 0 (1 / 2) (-1) hσm_pos hq1 zero_le_one
          (by norm_num) (by norm_num) (by norm_num)
          hu_holo hΔ_holo hm_holo
          (fun k hk z hz => by rw [mul_one]; exact hXj_bnd k hk z hz)
          (fun k hk z hz => by rw [mul_one]; exact hΔ_bnd k hk z hz)
          (fun k hk z hz => by rw [mul_one]; exact hm_bnd k hk z hz) r hr ζ hζ

  have hMeshPerturbLip : ∀ {σ : ℝ} {q : ℕ} {w₁ w₂ : ℝ → ℝ} {W₁ W₂ : ℂ → ℂ}
      {X_ℂ₁ μ_ℂ₁ X_ℂ₂ μ_ℂ₂ : ℕ → ℂ → ℂ},
      σ ∈ Set.Ioc (0 : ℝ) 1 → S.N_mesh ≤ q → S.K_mesh / (q : ℝ) ^ 2 < 1 →
      IsPeriodicSmoothBounded (m + 15) M w₁ →
      IsPeriodicSmoothBounded (m + 15) M w₂ →
      IsBoundedStripExt (m + 15) σ M w₁ W₁ →
      IsBoundedStripExt (m + 15) σ M w₂ W₂ →
      IsStripMeshExt m (M + 1) S σ q w₁ W₁ X_ℂ₁ μ_ℂ₁ →
      IsStripMeshExt m (M + 1) S σ q w₂ W₂ X_ℂ₂ μ_ℂ₂ →
      let σ_mesh := (1 - S.K_mesh / (q : ℝ) ^ 2) * σ
      let δ_e := 3 * S.R_mesh / (q : ℝ) ^ 2
      ∀ j < q, ∀ α ∈ Set.Icc (0 : ℝ) 1, ∀ r ≤ m + 2, ∀ ζ ∈ horizStrip σ_mesh,
        ‖iteratedDeriv r (fun z =>
            shciPerturbMinus q X_ℂ₁ μ_ℂ₁ j α z - shciPerturbMinus q X_ℂ₂ μ_ℂ₂ j α z) ζ‖ ≤
          δ_e * stripDiffSup (m + 15) σ W₁ W₂ ∧
        ‖iteratedDeriv r (fun z =>
            shciPerturbPlus q X_ℂ₁ μ_ℂ₁ j α z - shciPerturbPlus q X_ℂ₂ μ_ℂ₂ j α z) ζ‖ ≤
          δ_e * stripDiffSup (m + 15) σ W₁ W₂ := by
    intro σ q w₁ w₂ W₁ W₂ X_ℂ₁ μ_ℂ₁ X_ℂ₂ μ_ℂ₂ hσ hq hKm hw₁ hw₂ hW₁ hW₂ hMesh₁ hMesh₂
      σ_mesh δ_e j hj α hα r hr ζ hζ
    have hσm_pos : 0 < σ_mesh := mul_pos (by linarith) hσ.1
    have hq4 : 4 ≤ q := le_trans S.N_mesh_ge_four hq
    have hq1 : 1 ≤ (q : ℝ) := by exact_mod_cast (by omega : 1 ≤ q)
    have hw₁' : IsPeriodicSmoothBounded (m + 15) (M + 1) w₁ :=
      ⟨hw₁.1, hw₁.2.1, fun k hk x => le_trans (hw₁.2.2 k hk x) (by linarith)⟩
    have hw₂' : IsPeriodicSmoothBounded (m + 15) (M + 1) w₂ :=
      ⟨hw₂.1, hw₂.2.1, fun k hk x => le_trans (hw₂.2.2 k hk x) (by linarith)⟩
    have hW₁' : IsBoundedStripExt (m + 15) σ (M + 1) w₁ W₁ :=
      ⟨hW₁.1, hW₁.2.1, hW₁.2.2.1, hW₁.2.2.2.1,
        fun k hk z hz => le_trans (hW₁.2.2.2.2 k hk z hz) (by linarith)⟩
    have hW₂' : IsBoundedStripExt (m + 15) σ (M + 1) w₂ W₂ :=
      ⟨hW₂.1, hW₂.2.1, hW₂.2.2.1, hW₂.2.2.2.1,
        fun k hk z hz => le_trans (hW₂.2.2.2.2 k hk z hz) (by linarith)⟩
    obtain ⟨_, hX₁, hμ₁⟩ := hMesh₁
    obtain ⟨_, hX₂, hμ₂⟩ := hMesh₂
    obtain ⟨hLipX, hLipStep, hLipMid⟩ :=
      S.strip_mesh_lip σ q w₁ w₂ W₁ W₂ X_ℂ₁ μ_ℂ₁ X_ℂ₂ μ_ℂ₂ hσ hq hKm hw₁' hw₂' hW₁' hW₂'
        (fun i hi => ⟨(hX₁ i hi).1, (hX₂ i hi).1, (hX₁ i hi).2.1, (hX₂ i hi).2.1⟩)
        (fun i hi => ⟨(hμ₁ i hi).1, (hμ₂ i hi).1, (hμ₁ i hi).2.1, (hμ₂ i hi).2.1⟩)
    let D_X : ℂ → ℂ := fun z => X_ℂ₁ j z - X_ℂ₂ j z
