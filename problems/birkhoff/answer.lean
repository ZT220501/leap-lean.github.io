      rw [add_zero] at hsum
      refine hsum.congr' (hδ_pos_ev.mono fun δ hδ => ?_)
      have hne : (δ : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (ne_of_gt hδ)
      dsimp only
      rw [mul_div_cancel₀ _ hne]
      ring
    have hm₀_ball_ev : ∀ i : Fin k, ∀ᶠ δ in φ, m₀ δ i ∈ Metric.ball (v_a : ℂ) ρ_m :=
      fun i => (hm₀_lim i).eventually (Metric.isOpen_ball.mem_nhds (Metric.mem_ball_self hρ_m_pos))
    have hℓ₀_eq_ev : ∀ i : Fin k, ∀ᶠ δ in φ,
