      calc (Real.pi * R ^ 2)⁻¹ *
          (∫ x in Set.Ioo (0 : ℝ) R, ∫ y in Set.Ioo (-Real.pi) Real.pi, x * g (circleMap z₀ x y))
          ≤ (Real.pi * R ^ 2)⁻¹ * (Real.pi * R ^ 2 * g z₀) :=
