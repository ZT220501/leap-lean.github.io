    rw [h_deriv_eq, hS_eq_lim Y hY1 hY2]
    simpa using h_en

theorem superlinear_halfplane_rigidity_contradiction (α₁ : ℝ) (hα₁ : 1 < α₁)
    (L : SuperlinearLimitingLiftData α₁) :
    False :=
by
  have hH_open : IsOpen superlinearLowerHalfPlane :=
    isOpen_lt Complex.continuous_im continuous_const
  have hH_preconn : IsPreconnected superlinearLowerHalfPlane :=
    (convex_halfSpace_im_lt 0).isPreconnected
  have hnegI_mem : -Complex.I ∈ superlinearLowerHalfPlane := by
    change (-Complex.I).im < 0
    simp
  have h_inv_sqrt_lt : ∀ A δ R : ℝ, 0 < A → 0 < δ → (A / δ) ^ 2 < R →
      A * R ^ (-(1 / 2 : ℝ)) < δ := by
    intro A δ R hA hδ hR_sq
    have hR_pos : 0 < R := lt_trans (by positivity) hR_sq
    have hR_half_sq : (R ^ (1 / 2 : ℝ)) ^ (2 : ℕ) = R := by
      rw [← Real.rpow_natCast, ← Real.rpow_mul hR_pos.le]
      norm_num
    have h_lt_half : A / δ < R ^ (1 / 2 : ℝ) := by
      apply lt_of_pow_lt_pow_left₀ 2 (by positivity)
      rwa [hR_half_sq]
    have h_prod_one : R ^ (1 / 2 : ℝ) * R ^ (-(1 / 2 : ℝ)) = 1 := by
      rw [← Real.rpow_add hR_pos]
      norm_num
    have h_mul := mul_lt_mul_of_pos_right h_lt_half (Real.rpow_pos_of_pos hR_pos (-(1 / 2 : ℝ)))
    rw [h_prod_one] at h_mul
    have h_mul2 := mul_lt_mul_of_pos_left h_mul hδ
    have h_cancel : δ * (A / δ * R ^ (-(1 / 2 : ℝ))) = A * R ^ (-(1 / 2 : ℝ)) := by
      field_simp [hδ.ne']
    linarith

  
  let f₁_term : ℂ → ℕ → ℂ := fun u m =>
    (3 * (2 * m + 2) : ℂ) * (-u) ^ m / ((2 * m + 3).factorial : ℂ)
  let g_sq1 : ℂ → ℂ := fun u => ∑' m : ℕ, f₁_term u m
  have hf₁_summable : ∀ u : ℂ, Summable (f₁_term u) := by
    intro u
    refine Summable.of_norm_bounded ((Real.summable_pow_div_factorial ‖u‖).mul_left 3) ?_
    intro m
    dsimp [f₁_term]
    rw [norm_div, norm_mul, norm_pow, norm_neg, Complex.norm_natCast]
    have h_num_eq : ‖(3 * (2 * (m : ℂ) + 2))‖ = (3 * (2 * (m : ℝ) + 2)) := by
      have : (3 * (2 * (m : ℂ) + 2)) = (((3 * (2 * m + 2) : ℕ) : ℝ) : ℂ) := by push_cast; ring
      rw [this, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (by positivity)]
      push_cast; ring
    rw [h_num_eq]
    have hm_le : m ≤ 2 * m + 2 := by omega
    have hfac_le : (m.factorial : ℝ) ≤ ((2 * m + 2).factorial : ℝ) := by
      exact_mod_cast Nat.factorial_le hm_le
    have hfac_succ : ((2 * m + 3).factorial : ℝ) =
        (2 * (m : ℝ) + 3) * ((2 * m + 2).factorial : ℝ) := by
      rw [Nat.factorial_succ]
      push_cast; ring
    have hfac_pos : (0 : ℝ) < (m.factorial : ℝ) := by exact_mod_cast Nat.factorial_pos m
    have hfac2_pos : (0 : ℝ) < ((2 * m + 3).factorial : ℝ) := by
      exact_mod_cast Nat.factorial_pos (2 * m + 3)
    rw [div_le_iff₀ hfac2_pos, hfac_succ]
    have h_one_le : 1 ≤ ((2 * m + 2).factorial : ℝ) / (m.factorial : ℝ) :=
      (one_le_div hfac_pos).mpr hfac_le
    have h_nonneg : 0 ≤ 3 * (2 * (m : ℝ) + 3) * ‖u‖ ^ m := by positivity
    calc (3 * (2 * (m : ℝ) + 2)) * ‖u‖ ^ m
        ≤ 3 * (2 * (m : ℝ) + 3) * ‖u‖ ^ m := by gcongr; linarith
      _ ≤ 3 * (2 * (m : ℝ) + 3) * ‖u‖ ^ m *
            (((2 * m + 2).factorial : ℝ) / (m.factorial : ℝ)) :=
          le_mul_of_one_le_right h_nonneg h_one_le
      _ = 3 * (‖u‖ ^ m / (m.factorial : ℝ)) *
            ((2 * (m : ℝ) + 3) * ((2 * m + 2).factorial : ℝ)) := by ring

  have hg_sq1_zero : g_sq1 0 = 1 := by
    have h_sh0 := (hasSum_nat_add_iff' 1).mpr (hf₁_summable 0).hasSum
    have hf0 : f₁_term 0 0 = 1 := by dsimp [f₁_term]; norm_num [Nat.factorial]
    have hf_succ : ∀ k : ℕ, f₁_term 0 (k + 1) = 0 := fun k => by simp [f₁_term]
    rw [Finset.sum_range_one, hf0] at h_sh0
    have h_eq0 : (0 : ℂ) = g_sq1 0 - 1 := by
      calc (0 : ℂ) = ∑' k : ℕ, (0 : ℂ) := tsum_zero.symm
        _ = ∑' k : ℕ, f₁_term 0 (k + 1) := by simp_rw [hf_succ]
        _ = g_sq1 0 - 1 := h_sh0.tsum_eq
    linear_combination -h_eq0

  have hEqG1 : ∀ z : ℂ, g_sq1 (z ^ 2) = frozenFirstFieldG z := by
    intro z
    by_cases hz : z = 0
    · subst hz
      simp [frozenFirstFieldG, hg_sq1_zero]
    · let s_term : ℕ → ℂ := fun n =>
        (-1 : ℂ) ^ n * z ^ (2 * n + 1) / ((2 * n + 1).factorial : ℂ)
      let c_term : ℕ → ℂ := fun n =>
        z * ((-1 : ℂ) ^ n * z ^ (2 * n) / ((2 * n).factorial : ℂ))
      have hsc : HasSum (fun n => s_term n - c_term n) (Complex.sin z - z * Complex.cos z) :=
        (Complex.hasSum_sin z).sub ((Complex.hasSum_cos z).mul_left z)
      have hsc0 : s_term 0 - c_term 0 = 0 := by simp [s_term, c_term]
      have h_sh := (hasSum_nat_add_iff' 1).mpr hsc
      rw [Finset.sum_range_one, hsc0, sub_zero] at h_sh
      have h_sh3 := h_sh.mul_left (3 : ℂ)
      have h_term_eq : ∀ m : ℕ,
          (3 : ℂ) * (s_term (m + 1) - c_term (m + 1)) = z ^ 3 * f₁_term (z ^ 2) m := by
        intro m
        dsimp [s_term, c_term, f₁_term]
        have h_idx1 : 2 * (m + 1) + 1 = (2 * m + 2) + 1 := by omega
        have h_idx2 : 2 * (m + 1) = 2 * m + 2 := by omega
        have h_idx3 : 2 * m + 3 = (2 * m + 2) + 1 := by omega
        rw [h_idx1, h_idx2, h_idx3, Nat.factorial_succ]
        have h_pow1 : z ^ ((2 * m + 2) + 1) = z ^ 3 * z ^ (2 * m) := by
          rw [show (2 * m + 2) + 1 = 3 + 2 * m by omega, pow_add]
        have h_pow2 : z ^ (2 * m + 2) = z ^ 2 * z ^ (2 * m) := by
          rw [show 2 * m + 2 = 2 + 2 * m by omega, pow_add]
        have h_neg_u : (-(z ^ 2)) ^ m = (-1 : ℂ) ^ m * z ^ (2 * m) := by
          calc (-(z ^ 2)) ^ m = ((-1 : ℂ) * z ^ 2) ^ m := by ring_nf
            _ = (-1 : ℂ) ^ m * (z ^ 2) ^ m := mul_pow _ _ _
            _ = (-1 : ℂ) ^ m * z ^ (2 * m) := by rw [← pow_mul]
        have h_sign : (-1 : ℂ) ^ (m + 1) = -((-1 : ℂ) ^ m) := by
          rw [pow_succ]; ring
        rw [h_pow1, h_pow2, h_neg_u, h_sign]
        have hfac_ne : (((2 * m + 2).factorial : ℕ) : ℂ) ≠ 0 :=
          Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)
        have hsucc_ne : (((2 * m + 2) + 1 : ℕ) : ℂ) ≠ 0 :=
          Nat.cast_ne_zero.mpr (by omega)
        push_cast
        have hsucc_ne' : (2 * (m : ℂ) + 2 + 1) ≠ 0 := by
          exact_mod_cast (by omega : 2 * m + 2 + 1 ≠ 0)
        have h3m_ne : (3 : ℂ) + (m : ℂ) * 2 ≠ 0 := by
          exact_mod_cast (by omega : 3 + m * 2 ≠ 0)
        field_simp [hfac_ne, hsucc_ne', h3m_ne]
        ring_nf
        linear_combination -(inv_mul_cancel₀ h3m_ne)
      have h_hasSum_lhs : HasSum (fun m => z ^ 3 * f₁_term (z ^ 2) m)
          (3 * (Complex.sin z - z * Complex.cos z)) := by
        simpa [h_term_eq] using h_sh3
      have h_hasSum_rhs : HasSum (fun m => z ^ 3 * f₁_term (z ^ 2) m)
          (z ^ 3 * g_sq1 (z ^ 2)) :=
        (hf₁_summable (z ^ 2)).hasSum.mul_left (z ^ 3)
      have h_mul_eq : z ^ 3 * g_sq1 (z ^ 2) = 3 * (Complex.sin z - z * Complex.cos z) :=
        h_hasSum_rhs.unique h_hasSum_lhs
      have hz3_ne : z ^ 3 ≠ 0 := pow_ne_zero 3 hz
      unfold frozenFirstFieldG
      simp only [hz, ↓reduceIte]
      rw [eq_div_iff hz3_ne]
      linear_combination h_mul_eq

  have h_ker1_props : ∀ u : ℂ, ‖u‖ ≤ 1 / 4 →
      ‖1 - g_sq1 u‖ ≤ 4 * ‖u‖ ∧ (g_sq1 u = 1 → u = 0) := by
    intro u hu_norm
    have hu_le_one : ‖u‖ ≤ 1 := by linarith
    have hf₁_0 : f₁_term u 0 = 1 := by
      dsimp [f₁_term]
      norm_num [Nat.factorial]
    have hf₁_1 : f₁_term u 1 = -(1 / 10 : ℂ) * u := by
      dsimp [f₁_term]
      norm_num [Nat.factorial]
      ring
    have h_shift := (hasSum_nat_add_iff' 2).mpr (hf₁_summable u).hasSum
    rw [Finset.sum_range_succ, Finset.sum_range_one, hf₁_0, hf₁_1] at h_shift
    have h_shift_tsum : ∑' k : ℕ, f₁_term u (k + 2) = g_sq1 u - (1 - (1 / 10 : ℂ) * u) := by
      rw [h_shift.tsum_eq]
      dsimp [g_sq1]
      ring
    have h_fac_ind : ∀ k : ℕ, 240 * 2 ^ k ≤ (2 * k + 6).factorial := by
      intro k
      induction k with
      | zero => decide
      | succ k ih =>
        have h_eq : 2 * (k + 1) + 6 = (2 * k + 7) + 1 := by omega
        rw [h_eq, Nat.factorial_succ, Nat.factorial_succ, pow_succ]
        calc 240 * (2 ^ k * 2) = 2 * (240 * 2 ^ k) := by ring
          _ ≤ ((2 * k + 7 + 1) * (2 * k + 6 + 1)) * (2 * k + 6).factorial :=
              Nat.mul_le_mul (by nlinarith) ih
          _ = (2 * k + 7 + 1) * ((2 * k + 6 + 1) * (2 * k + 6).factorial) := by ring
    have h_tail_bound : ∀ k : ℕ, ‖f₁_term u (k + 2)‖ ≤ (‖u‖ ^ 2 / 80) * (1 / 2 : ℝ) ^ k := by
      intro k
      dsimp [f₁_term]
      rw [norm_div, norm_mul, norm_pow, norm_neg, Complex.norm_natCast]
      have h_num_eq : ‖(3 * (2 * ((k + 2 : ℕ) : ℂ) + 2))‖ = (3 * (2 * (k : ℝ) + 6)) := by
        have : (3 * (2 * ((k + 2 : ℕ) : ℂ) + 2)) = (((3 * (2 * k + 6) : ℕ) : ℝ) : ℂ) := by
          push_cast; ring
        rw [this, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (by positivity)]
        push_cast; ring
      rw [h_num_eq]
      have h_idx : 2 * (k + 2) + 3 = (2 * k + 6) + 1 := by omega
      rw [h_idx, Nat.factorial_succ]
      push_cast
      have h_pow_le : ‖u‖ ^ (k + 2) ≤ ‖u‖ ^ 2 := by
        rw [pow_add]
        exact mul_le_of_le_one_left (sq_nonneg _) (pow_le_one₀ (norm_nonneg _) hu_le_one)
      have h_fac_r : (240 : ℝ) * (2 : ℝ) ^ k ≤ ((2 * k + 6).factorial : ℝ) := by
        exact_mod_cast h_fac_ind k
      have h_fac_pos : (0 : ℝ) < ((2 * k + 6).factorial : ℝ) := by
        exact_mod_cast Nat.factorial_pos (2 * k + 6)
      have h_coef : (3 * (2 * (k : ℝ) + 6)) /
          (((2 * (k : ℝ) + 6) + 1) * ((2 * k + 6).factorial : ℝ)) ≤
          (1 / 80 : ℝ) * (1 / 2 : ℝ) ^ k := by
        have h1 : (3 * (2 * (k : ℝ) + 6)) /
            (((2 * (k : ℝ) + 6) + 1) * ((2 * k + 6).factorial : ℝ)) ≤
            3 / ((2 * k + 6).factorial : ℝ) := by
          rw [div_le_div_iff₀ (by positivity) h_fac_pos]
          nlinarith [h_fac_pos]
        have h2 : 3 / ((2 * k + 6).factorial : ℝ) ≤ 3 / (240 * (2 : ℝ) ^ k) :=
          div_le_div_of_nonneg_left (by norm_num) (by positivity) h_fac_r
        have h3 : (3 : ℝ) / (240 * (2 : ℝ) ^ k) = (1 / 80 : ℝ) * (1 / 2 : ℝ) ^ k := by
          rw [_root_.one_div_pow]
          ring
        linarith
      calc 3 * (2 * (k : ℝ) + 6) * ‖u‖ ^ (k + 2) /
            ((2 * (k : ℝ) + 6 + 1) * ((2 * k + 6).factorial : ℝ))
          = (3 * (2 * (k : ℝ) + 6) /
              ((2 * (k : ℝ) + 6 + 1) * ((2 * k + 6).factorial : ℝ))) * ‖u‖ ^ (k + 2) := by ring
        _ ≤ ((1 / 80 : ℝ) * (1 / 2 : ℝ) ^ k) * ‖u‖ ^ 2 :=
            mul_le_mul h_coef h_pow_le (by positivity) (by positivity)
        _ = (‖u‖ ^ 2 / 80) * (1 / 2 : ℝ) ^ k := by ring
    have h_geom_sum : Summable (fun k : ℕ => (‖u‖ ^ 2 / 80) * (1 / 2 : ℝ) ^ k) :=
      summable_geometric_two.mul_left _
    have h_norm_sum : Summable (fun k : ℕ => ‖f₁_term u (k + 2)‖) :=
      h_shift.summable.norm
    have h_rem_norm : ‖∑' k : ℕ, f₁_term u (k + 2)‖ ≤ ‖u‖ ^ 2 / 40 := by
      calc ‖∑' k : ℕ, f₁_term u (k + 2)‖
          ≤ ∑' k : ℕ, ‖f₁_term u (k + 2)‖ := norm_tsum_le_tsum_norm h_norm_sum
        _ ≤ ∑' k : ℕ, (‖u‖ ^ 2 / 80) * (1 / 2 : ℝ) ^ k :=
            h_norm_sum.tsum_le_tsum h_tail_bound h_geom_sum
        _ = (‖u‖ ^ 2 / 80) * ∑' k : ℕ, (1 / 2 : ℝ) ^ k := tsum_mul_left
        _ = ‖u‖ ^ 2 / 40 := by rw [tsum_geometric_two]; ring
    refine ⟨?_, ?_⟩
    · have h1_sub_eq : 1 - g_sq1 u = (1 / 10 : ℂ) * u - ∑' k : ℕ, f₁_term u (k + 2) := by
        rw [h_shift_tsum]; ring
      have h_tri : ‖1 - g_sq1 u‖ ≤ ‖(1 / 10 : ℂ) * u‖ + ‖∑' k : ℕ, f₁_term u (k + 2)‖ := by
        rw [h1_sub_eq]; exact norm_sub_le _ _
      have h_tenth : ‖(1 / 10 : ℂ) * u‖ = (1 / 10 : ℝ) * ‖u‖ := by simp
      nlinarith [norm_nonneg u]
    · intro hg1
      have h_eq : ∑' k : ℕ, f₁_term u (k + 2) = (1 / 10 : ℂ) * u := by
        rw [h_shift_tsum, hg1]; ring
      have h_lhs : (1 / 10 : ℝ) * ‖u‖ ≤ ‖u‖ ^ 2 / 40 := by
        calc (1 / 10 : ℝ) * ‖u‖ = ‖(1 / 10 : ℂ) * u‖ := by simp
          _ = ‖∑' k : ℕ, f₁_term u (k + 2)‖ := by rw [← h_eq]
          _ ≤ ‖u‖ ^ 2 / 40 := h_rem_norm
      have hu0 : ‖u‖ = 0 := by nlinarith [norm_nonneg u]
      exact norm_eq_zero.mp hu0

  have h_ker1_zero : ∀ z : ℂ, ‖z‖ ≤ 1 / 2 → frozenFirstFieldG z = 1 → z = 0 := by
    intro z hz hG1
    rw [← hEqG1 z] at hG1
    have hu_norm : ‖z ^ 2‖ ≤ 1 / 4 := by
      rw [norm_pow]
      nlinarith [norm_nonneg z]
    exact sq_eq_zero_iff.mp ((h_ker1_props (z ^ 2) hu_norm).2 hG1)

  have h_ker2_props : ∀ w : ℂ, ‖w‖ ≤ 1 / 4 →
      ‖1 - frozenSecondFieldG w‖ ≤ 4 * ‖w‖ ∧ (frozenSecondFieldG w = 1 → w = 0) := by
    intro w hw
    set μ : ℂ := 4 * w
    have hμ_norm : ‖μ‖ = 4 * ‖w‖ := by
      dsimp [μ]
      rw [norm_mul]
      norm_num
    have hμ_le_one : ‖μ‖ ≤ 1 := by linarith
    have h_pow_eq : ∀ m : ℕ, (4 : ℂ) ^ m * w ^ m = μ ^ m := fun m => (mul_pow 4 w m).symm
    let a_num : ℕ → ℂ := fun m => μ ^ m / ((2 * m + 3).factorial : ℂ)
    let a_den : ℕ → ℂ := fun m => μ ^ m / ((2 * m).factorial : ℂ)
    have ha_num_sum : Summable a_num := by
      refine Summable.of_norm_bounded (Real.summable_pow_div_factorial ‖μ‖) ?_
      intro m
      dsimp [a_num]
      rw [norm_div, norm_pow, Complex.norm_natCast]
      exact div_le_div_of_nonneg_left (by positivity)
        (by exact_mod_cast Nat.factorial_pos m)
        (by exact_mod_cast Nat.factorial_le (by omega : m ≤ 2 * m + 3))
    have ha_den_sum : Summable a_den := by
      refine Summable.of_norm_bounded (Real.summable_pow_div_factorial ‖μ‖) ?_
      intro m
      dsimp [a_den]
      rw [norm_div, norm_pow, Complex.norm_natCast]
      exact div_le_div_of_nonneg_left (by positivity)
        (by exact_mod_cast Nat.factorial_pos m)
        (by exact_mod_cast Nat.factorial_le (by omega : m ≤ 2 * m))
    set D : ℂ := 1 + ∑' m : ℕ, a_den m
    have hG2_def : frozenSecondFieldG w = (12 * ∑' m : ℕ, a_num m) / D := by
      simp [frozenSecondFieldG, a_num, a_den, D, h_pow_eq]
    have h_den_ind : ∀ k : ℕ, 2 * 2 ^ k ≤ (2 * k + 2).factorial := by
      intro k
      induction k with
      | zero => decide
      | succ k ih =>
        have h_eq : 2 * (k + 1) + 2 = (2 * k + 3) + 1 := by omega
        rw [h_eq, Nat.factorial_succ, Nat.factorial_succ, pow_succ]
        calc 2 * (2 ^ k * 2) = 2 * (2 * 2 ^ k) := by ring
          _ ≤ ((2 * k + 3 + 1) * (2 * k + 2 + 1)) * (2 * k + 2).factorial :=
              Nat.mul_le_mul (by nlinarith) ih
          _ = (2 * k + 3 + 1) * ((2 * k + 2 + 1) * (2 * k + 2).factorial) := by ring
    have hD_ge_one : 1 ≤ ‖D‖ := by
      have h_sh1 := (hasSum_nat_add_iff' 1).mpr ha_den_sum.hasSum
      have ha_den_0 : a_den 0 = 1 := by dsimp [a_den]; norm_num [Nat.factorial]
      rw [Finset.sum_range_one, ha_den_0] at h_sh1
      have h_tsum1 : ∑' k : ℕ, a_den (k + 1) = D - 2 := by
        rw [h_sh1.tsum_eq]
        dsimp [D]
        ring
      have h_b1 : ∀ k : ℕ, ‖a_den (k + 1)‖ ≤ (1 / 2 : ℝ) * (1 / 2 : ℝ) ^ k := by
        intro k
        dsimp [a_den]
        rw [norm_div, norm_pow, Complex.norm_natCast]
        have h_idx : 2 * (k + 1) = 2 * k + 2 := by omega
        rw [h_idx]
        have h_pow : ‖μ‖ ^ (k + 1) ≤ 1 := pow_le_one₀ (norm_nonneg _) hμ_le_one
        have h_fac : (2 : ℝ) * (2 : ℝ) ^ k ≤ ((2 * k + 2).factorial : ℝ) := by
          exact_mod_cast h_den_ind k
        calc ‖μ‖ ^ (k + 1) / ((2 * k + 2).factorial : ℝ)
            ≤ 1 / (2 * (2 : ℝ) ^ k) :=
              div_le_div₀ zero_le_one h_pow (by positivity) h_fac
          _ = (1 / 2 : ℝ) * (1 / 2 : ℝ) ^ k := by rw [_root_.one_div_pow]; ring
      have h_norm1 : ‖D - 2‖ ≤ 1 := by
        calc ‖D - 2‖ = ‖∑' k : ℕ, a_den (k + 1)‖ := by rw [← h_tsum1]
          _ ≤ ∑' k : ℕ, ‖a_den (k + 1)‖ := norm_tsum_le_tsum_norm h_sh1.summable.norm
          _ ≤ ∑' k : ℕ, (1 / 2 : ℝ) * (1 / 2 : ℝ) ^ k :=
              h_sh1.summable.norm.tsum_le_tsum h_b1 (summable_geometric_two.mul_left _)
          _ = (1 / 2 : ℝ) * ∑' k : ℕ, (1 / 2 : ℝ) ^ k := tsum_mul_left
          _ = 1 := by rw [tsum_geometric_two]; norm_num
      have h_tri : ‖(2 : ℂ)‖ ≤ ‖D‖ + ‖2 - D‖ := by
        have := norm_add_le D (2 - D)
        simpa using this
      rw [norm_sub_rev] at h_tri
      have h2_norm : ‖(2 : ℂ)‖ = (2 : ℝ) := by norm_num
      linarith
    have hD_ne : D ≠ 0 := by
      intro h0
      rw [h0, norm_zero] at hD_ge_one
      linarith
    let d₂ : ℕ → ℂ := fun m => a_den m - 12 * a_num m
    have hd₂_sum : Summable d₂ := ha_den_sum.sub (ha_num_sum.mul_left 12)
    have hd₂_tsum : 1 + ∑' m : ℕ, d₂ m = D - 12 * ∑' m : ℕ, a_num m := by
      dsimp [d₂]
      rw [ha_den_sum.tsum_sub (ha_num_sum.mul_left 12), tsum_mul_left]
      dsimp [D]
      ring
    have hd₂_0 : d₂ 0 = -1 := by
      dsimp [d₂, a_den, a_num]
      norm_num [Nat.factorial]
    have hd₂_1 : d₂ 1 = (2 / 5 : ℂ) * μ := by
      dsimp [d₂, a_den, a_num]
      norm_num [Nat.factorial]
      ring
    have h_sh2 := (hasSum_nat_add_iff' 2).mpr hd₂_sum.hasSum
    rw [Finset.sum_range_succ, Finset.sum_range_one, hd₂_0, hd₂_1] at h_sh2
    have h_diff_eq : D - 12 * ∑' m : ℕ, a_num m =
        (2 / 5 : ℂ) * μ + ∑' k : ℕ, d₂ (k + 2) := by
      rw [← hd₂_tsum, h_sh2.tsum_eq]
      ring
    have h_fac4_ind : ∀ k : ℕ, 24 * 2 ^ k ≤ (2 * k + 4).factorial := by
      intro k
      induction k with
      | zero => decide
      | succ k ih =>
        have h_eq : 2 * (k + 1) + 4 = (2 * k + 5) + 1 := by omega
        rw [h_eq, Nat.factorial_succ, Nat.factorial_succ, pow_succ]
        calc 24 * (2 ^ k * 2) = 2 * (24 * 2 ^ k) := by ring
          _ ≤ ((2 * k + 5 + 1) * (2 * k + 4 + 1)) * (2 * k + 4).factorial :=
              Nat.mul_le_mul (by nlinarith) ih
          _ = (2 * k + 5 + 1) * ((2 * k + 4 + 1) * (2 * k + 4).factorial) := by ring
    have h_fac7_le : ∀ k : ℕ, 288 * 2 ^ k ≤ (2 * k + 7).factorial := by
      intro k
      have h4 := h_fac4_ind k
      have h_eq : 2 * k + 7 = (2 * k + 4) + 3 := by omega
      rw [h_eq, Nat.factorial_succ, Nat.factorial_succ, Nat.factorial_succ]
      have h12_le : 12 ≤ (2 * k + 6 + 1) * ((2 * k + 5 + 1) * (2 * k + 4 + 1)) := by
        calc 12 ≤ 7 * (6 * 5) := by decide
          _ ≤ (2 * k + 6 + 1) * ((2 * k + 5 + 1) * (2 * k + 4 + 1)) :=
              Nat.mul_le_mul (by omega) (Nat.mul_le_mul (by omega) (by omega))
      calc 288 * 2 ^ k = 12 * (24 * 2 ^ k) := by ring
        _ ≤ ((2 * k + 6 + 1) * ((2 * k + 5 + 1) * (2 * k + 4 + 1))) * (2 * k + 4).factorial :=
            Nat.mul_le_mul h12_le h4
        _ = (2 * k + 6 + 1) * ((2 * k + 5 + 1) * ((2 * k + 4 + 1) * (2 * k + 4).factorial)) := by
            ring
    have h_tail2 : ∀ k : ℕ, ‖d₂ (k + 2)‖ ≤ (‖μ‖ ^ 2 / 12) * (1 / 2 : ℝ) ^ k := by
      intro k
      have h_pow_le : ‖μ‖ ^ (k + 2) ≤ ‖μ‖ ^ 2 := by
        rw [pow_add]
        exact mul_le_of_le_one_left (sq_nonneg _) (pow_le_one₀ (norm_nonneg _) hμ_le_one)
      have h_tri : ‖d₂ (k + 2)‖ ≤ ‖a_den (k + 2)‖ + ‖12 * a_num (k + 2)‖ :=
        norm_sub_le _ _
      have h_t1 : ‖a_den (k + 2)‖ ≤ (‖μ‖ ^ 2 / 24) * (1 / 2 : ℝ) ^ k := by
        dsimp [a_den]
        rw [norm_div, norm_pow, Complex.norm_natCast]
        have h_idx : 2 * (k + 2) = 2 * k + 4 := by omega
        rw [h_idx]
        have hf4 : (24 : ℝ) * (2 : ℝ) ^ k ≤ ((2 * k + 4).factorial : ℝ) := by
          exact_mod_cast h_fac4_ind k
        calc ‖μ‖ ^ (k + 2) / ((2 * k + 4).factorial : ℝ)
            ≤ ‖μ‖ ^ 2 / (24 * (2 : ℝ) ^ k) :=
              div_le_div₀ (sq_nonneg _) h_pow_le (by positivity) hf4
          _ = (‖μ‖ ^ 2 / 24) * (1 / 2 : ℝ) ^ k := by rw [_root_.one_div_pow]; ring
      have h_t2 : ‖12 * a_num (k + 2)‖ ≤ (‖μ‖ ^ 2 / 24) * (1 / 2 : ℝ) ^ k := by
        dsimp [a_num]
        rw [norm_mul, norm_div, norm_pow, Complex.norm_natCast]
        have h12 : ‖(12 : ℂ)‖ = (12 : ℝ) := by norm_num
        rw [h12]
        have h_idx : 2 * (k + 2) + 3 = 2 * k + 7 := by omega
        rw [h_idx]
        have hf7 : (288 : ℝ) * (2 : ℝ) ^ k ≤ ((2 * k + 7).factorial : ℝ) := by
          exact_mod_cast h_fac7_le k
        have h_num_le : 12 * ‖μ‖ ^ (k + 2) ≤ 12 * ‖μ‖ ^ 2 := by linarith
        calc 12 * (‖μ‖ ^ (k + 2) / ((2 * k + 7).factorial : ℝ))
            = (12 * ‖μ‖ ^ (k + 2)) / ((2 * k + 7).factorial : ℝ) := by ring
          _ ≤ (12 * ‖μ‖ ^ 2) / (288 * (2 : ℝ) ^ k) :=
              div_le_div₀ (by positivity) h_num_le (by positivity) hf7
          _ = (‖μ‖ ^ 2 / 24) * (1 / 2 : ℝ) ^ k := by rw [_root_.one_div_pow]; ring
      linarith
    have h_geom2 : Summable (fun k : ℕ => (‖μ‖ ^ 2 / 12) * (1 / 2 : ℝ) ^ k) :=
      summable_geometric_two.mul_left _
    have h_norm2 : Summable (fun k : ℕ => ‖d₂ (k + 2)‖) := h_sh2.summable.norm
    have h_rem2_norm : ‖∑' k : ℕ, d₂ (k + 2)‖ ≤ ‖μ‖ ^ 2 / 6 := by
      calc ‖∑' k : ℕ, d₂ (k + 2)‖
          ≤ ∑' k : ℕ, ‖d₂ (k + 2)‖ := norm_tsum_le_tsum_norm h_norm2
        _ ≤ ∑' k : ℕ, (‖μ‖ ^ 2 / 12) * (1 / 2 : ℝ) ^ k :=
            h_norm2.tsum_le_tsum h_tail2 h_geom2
        _ = (‖μ‖ ^ 2 / 12) * ∑' k : ℕ, (1 / 2 : ℝ) ^ k := tsum_mul_left
        _ = ‖μ‖ ^ 2 / 6 := by rw [tsum_geometric_two]; ring
    refine ⟨?_, ?_⟩
    · have h1_sub_G2 : 1 - frozenSecondFieldG w =
          ((2 / 5 : ℂ) * μ + ∑' k : ℕ, d₂ (k + 2)) / D := by
        rw [hG2_def, ← h_diff_eq]
        field_simp [hD_ne]
      rw [h1_sub_G2, norm_div]
      have h_div_le : ‖(2 / 5 : ℂ) * μ + ∑' k : ℕ, d₂ (k + 2)‖ / ‖D‖ ≤
          ‖(2 / 5 : ℂ) * μ + ∑' k : ℕ, d₂ (k + 2)‖ :=
        div_le_self (norm_nonneg _) hD_ge_one
      have h_tri : ‖(2 / 5 : ℂ) * μ + ∑' k : ℕ, d₂ (k + 2)‖ ≤
          ‖(2 / 5 : ℂ) * μ‖ + ‖∑' k : ℕ, d₂ (k + 2)‖ := norm_add_le _ _
      have h25 : ‖(2 / 5 : ℂ) * μ‖ = (2 / 5 : ℝ) * ‖μ‖ := by simp
      nlinarith [norm_nonneg μ, norm_nonneg w]
    · intro hG2_eq
      rw [hG2_def] at hG2_eq
      have h_num_eq_D : 12 * ∑' m : ℕ, a_num m = D := (div_eq_one_iff_eq hD_ne).mp hG2_eq
      have h_sh2_eq : ∑' k : ℕ, d₂ (k + 2) = -(2 / 5 : ℂ) * μ := by
        have h0 : (2 / 5 : ℂ) * μ + ∑' k : ℕ, d₂ (k + 2) = 0 := by
          rw [← h_diff_eq, h_num_eq_D, sub_self]
        linear_combination h0
      have h_lhs2 : (2 / 5 : ℝ) * ‖μ‖ ≤ ‖μ‖ ^ 2 / 6 := by
        calc (2 / 5 : ℝ) * ‖μ‖ = ‖-(2 / 5 : ℂ) * μ‖ := by simp
          _ = ‖∑' k : ℕ, d₂ (k + 2)‖ := by rw [← h_sh2_eq]
          _ ≤ ‖μ‖ ^ 2 / 6 := h_rem2_norm
      have hμ_zero_norm : ‖μ‖ = 0 := by nlinarith [norm_nonneg μ]
      have hμ_zero : 4 * w = 0 := norm_eq_zero.mp hμ_zero_norm
      exact (mul_eq_zero.mp hμ_zero).resolve_left (by norm_num)

  
  have h_im_le : ∀ Y ∈ superlinearLowerHalfPlane, (L.S_inf Y).im ≤ Y.im := by
    intro Y₀ hY₀
    by_contra! h_gt
    have hY₀_im : Y₀.im < 0 := hY₀
    let x₀ : ℝ := Y₀.re
    let d₀ : ℝ := -Y₀.im
    let δ_v : ℝ := (L.S_inf Y₀).im - Y₀.im
    have hd₀_pos : 0 < d₀ := by dsimp [d₀]; linarith
    have hδv_pos : 0 < δ_v := by dsimp [δ_v]; linarith
    let ε : ℝ := min (d₀ / 2) (δ_v / 4)
    have hε_pos : 0 < ε := lt_min (by positivity) (by positivity)
    have hε_le_d : ε ≤ d₀ / 2 := min_le_left _ _
    have hε_le_δ : ε ≤ δ_v / 4 := min_le_right _ _
    let R : ℝ := max (max (d₀ + 1) L.D₁) ((L.C₁ / (δ_v / 4)) ^ 2 + 1)
    have hd₀_lt_R : d₀ < R := by
      have : d₀ + 1 ≤ R := le_trans (le_max_left _ _) (le_max_left _ _)
      linarith
    have hR_pos : 0 < R := lt_trans hd₀_pos hd₀_lt_R
    have hD₁_le_R : L.D₁ ≤ R := le_trans (le_max_right _ _) (le_max_left _ _)
    have hR_sq_gt : (L.C₁ / (δ_v / 4)) ^ 2 < R := by
      have : (L.C₁ / (δ_v / 4)) ^ 2 + 1 ≤ R := le_max_right _ _
      linarith
    have hC₁_R_lt : L.C₁ * R ^ (-(1 / 2 : ℝ)) < δ_v / 4 :=
      h_inv_sqrt_lt L.C₁ (δ_v / 4) R L.C₁_pos (by positivity) hR_sq_gt
    let γ : ℝ := δ_v / (4 * R ^ 2)
    have hγ_pos : 0 < γ := by positivity
    have hγR2 : γ * R ^ 2 = δ_v / 4 := by
      dsimp [γ]
      field_simp [hR_pos.ne']
    let M : ℝ := Real.sqrt (R / γ) + 1
    have hM_pos : 0 < M := by positivity
    have hR_lt_γM2 : R < γ * M ^ 2 := by
      have h_sqrt_lt : Real.sqrt (R / γ) < M := by dsimp [M]; linarith
      have h_sq_lt : (Real.sqrt (R / γ)) ^ 2 < M ^ 2 :=
        pow_lt_pow_left₀ h_sqrt_lt (Real.sqrt_nonneg _) (by norm_num)
      rw [Real.sq_sqrt (by positivity)] at h_sq_lt
      have := (div_lt_iff₀ hγ_pos).mp h_sq_lt
      linarith
    let U_M : Set ℂ := { Y : ℂ | |Y.re - x₀| < M ∧ -R < Y.im ∧ Y.im < -ε }
    let K_M : Set ℂ := { Y : ℂ | |Y.re - x₀| ≤ M ∧ -R ≤ Y.im ∧ Y.im ≤ -ε }
    have h_cont_re : Continuous (fun Y : ℂ => |Y.re - x₀|) :=
      (Complex.continuous_re.sub continuous_const).abs
    have hU_open : IsOpen U_M := by
      change IsOpen ({ Y : ℂ | |Y.re - x₀| < M } ∩ ({ Y : ℂ | -R < Y.im } ∩ { Y : ℂ | Y.im < -ε }))
      exact (isOpen_lt h_cont_re continuous_const).inter
        ((isOpen_lt continuous_const Complex.continuous_im).inter
          (isOpen_lt Complex.continuous_im continuous_const))
    have hK_closed : IsClosed K_M := by
      change IsClosed ({ Y : ℂ | |Y.re - x₀| ≤ M } ∩ ({ Y : ℂ | -R ≤ Y.im } ∩ { Y : ℂ | Y.im ≤ -ε }))
      exact (isClosed_le h_cont_re continuous_const).inter
        ((isClosed_le continuous_const Complex.continuous_im).inter
          (isClosed_le Complex.continuous_im continuous_const))
    have h_cl_sub : closure U_M ⊆ K_M :=
      closure_minimal (fun Y hY => ⟨hY.1.le, hY.2.1.le, hY.2.2.le⟩) hK_closed
    have hK_sub_H : K_M ⊆ superlinearLowerHalfPlane := by
      intro Y hY
      change Y.im < 0
      linarith [hY.2.2]
    have hU_bdd : Bornology.IsBounded U_M := by
      refine (Metric.isBounded_ball (x := (x₀ : ℂ)) (r := M + R)).subset ?_
      intro Y hY
      rw [Metric.mem_ball, dist_eq_norm]
      have h_decomp : Y - (x₀ : ℂ) = ((Y.re - x₀ : ℝ) : ℂ) + (Y.im : ℂ) * Complex.I := by
        apply Complex.ext <;> simp
      rw [h_decomp]
      have h_tri : ‖((Y.re - x₀ : ℝ) : ℂ) + (Y.im : ℂ) * Complex.I‖ ≤
          ‖((Y.re - x₀ : ℝ) : ℂ)‖ + ‖(Y.im : ℂ) * Complex.I‖ := norm_add_le _ _
      simp only [Complex.norm_real, Real.norm_eq_abs, norm_mul, Complex.norm_I, mul_one] at h_tri
      have him_abs : |Y.im| < R := abs_lt.mpr ⟨hY.2.1, by linarith [hY.2.2]⟩
      linarith [hY.1]
    have hY₀_in_U : Y₀ ∈ U_M := by
      refine ⟨?_, ?_, ?_⟩
      · simp [x₀, hM_pos]
      · dsimp [d₀] at hd₀_lt_R; linarith
      · dsimp [d₀] at hd₀_pos hε_le_d; linarith
    let Φ_γ : ℂ → ℂ := fun Y =>
      Complex.exp (Complex.I * (Y - L.S_inf Y) - (γ : ℂ) * (Y - (x₀ : ℂ)) ^ 2)
    have hΦ_holo : DifferentiableOn ℂ Φ_γ superlinearLowerHalfPlane := by
      have h_in : DifferentiableOn ℂ
          (fun Y => Complex.I * (Y - L.S_inf Y) - (γ : ℂ) * (Y - (x₀ : ℂ)) ^ 2)
          superlinearLowerHalfPlane :=
        ((differentiableOn_id.sub L.S_inf_holo).const_mul Complex.I).sub
          (((differentiableOn_id.sub (differentiableOn_const _)).pow 2).const_mul (γ : ℂ))
      exact Complex.differentiable_exp.comp_differentiableOn h_in
    have hΦ_diffCont : DiffContOnCl ℂ Φ_γ U_M :=
      (hΦ_holo.mono (h_cl_sub.trans hK_sub_H)).diffContOnCl
    have hΦ_norm : ∀ Y : ℂ, ‖Φ_γ Y‖ =
        Real.exp ((L.S_inf Y).im - Y.im - γ * (Y.re - x₀) ^ 2 + γ * (-Y.im) ^ 2) := by
      intro Y
      dsimp [Φ_γ]
      rw [Complex.norm_exp]
      congr 1
      simp [pow_two, Complex.mul_re, Complex.mul_im]
      ring
    have h_front : ∀ Y ∈ frontier U_M, ‖Φ_γ Y‖ ≤ Real.exp (δ_v / 2) := by
      rw [hU_open.frontier_eq]
      intro Y ⟨hY_cl, hY_not⟩
      have hY_K : Y ∈ K_M := h_cl_sub hY_cl
      have hS_im_neg : (L.S_inf Y).im < 0 := L.S_inf_maps_to Y (hK_sub_H hY_K)
      rw [hΦ_norm Y, Real.exp_le_exp]
      have hD_lo : ε ≤ -Y.im := by linarith [hY_K.2.2]
      have hD_hi : -Y.im ≤ R := by linarith [hY_K.2.1]
      have hD_sq : (-Y.im) ^ 2 ≤ R ^ 2 := by nlinarith
      have hx_sq_nonneg : 0 ≤ (Y.re - x₀) ^ 2 := sq_nonneg _
      rcases lt_or_eq_of_le hY_K.1 with h1 | h1
      · rcases lt_or_eq_of_le hY_K.2.1 with h2 | h2
        · rcases lt_or_eq_of_le hY_K.2.2 with h3 | h3
          · exfalso; exact hY_not ⟨h1, h2, h3⟩
          · nlinarith [hγ_pos, hγR2]
        · have hY_eq : Y = (Y.re : ℂ) - (R : ℂ) * Complex.I := by
            apply Complex.ext
            · simp
            · simp [← h2]
          have h_anc : ‖L.S_inf Y - Y‖ ≤ L.C₁ * R ^ (-(1 / 2 : ℝ)) := by
            rw [hY_eq]
            exact L.S_inf_anchor Y.re R hD₁_le_R
          have h_im_diff : (L.S_inf Y).im - Y.im ≤ ‖L.S_inf Y - Y‖ := by
            have : (L.S_inf Y).im - Y.im = (L.S_inf Y - Y).im := by simp
            rw [this]
            exact le_trans (le_abs_self _) (Complex.abs_im_le_norm _)
          nlinarith [hγ_pos, hγR2]
      · have hx_sq_eq : (Y.re - x₀) ^ 2 = M ^ 2 := by
          rw [← sq_abs, h1]
        nlinarith [hγ_pos, hγR2]
    have h_max :=
      Complex.norm_le_of_forall_mem_frontier_norm_le hU_bdd hΦ_diffCont h_front
        (subset_closure hY₀_in_U)
    rw [hΦ_norm Y₀] at h_max
    have h_exp_le := Real.exp_le_exp.mp h_max
    have h_zero_sq : (Y₀.re - x₀) ^ 2 = 0 := by dsimp [x₀]; ring
    have hd₀_sq_pos : 0 < γ * (-Y₀.im) ^ 2 := by
      have : 0 < (-Y₀.im) ^ 2 := by dsimp [d₀] at hd₀_pos; positivity
      positivity
    dsimp [δ_v] at h_exp_le hδv_pos
    linarith

  
  have h_unif : ∃ G_sq W : ℂ → ℂ,
      (∀ w : ℂ, ‖w‖ ≤ 1 / 4 → ‖1 - G_sq w‖ ≤ 4 * ‖w‖) ∧
      (∀ Z ∈ superlinearLowerHalfPlane, 1 ≤ -Z.im → ‖W Z‖ ≤ (-Z.im) ^ (-2 * α₁)) ∧
      (∀ y : ℝ, L.D₀ < y →
        (deriv L.S_inf (-(y : ℂ) * Complex.I)) ^ 3 *
          G_sq ((1 / 2 : ℂ) ^ 2 * W (L.S_inf (-(y : ℂ) * Complex.I)) *
            (deriv L.S_inf (-(y : ℂ) * Complex.I)) ^ 2) = 1) := by
    rcases L.pure_energy_branch with ⟨F, _, _, hF_dec, hF_eq⟩ | ⟨Q, _, _, hQ_dec, hQ_eq⟩
    · refine ⟨g_sq1, fun Z => (F Z) ^ 2, fun w hw => (h_ker1_props w hw).1, ?_, ?_⟩
      · intro Z hZ hZ1
        have h1 := pow_le_pow_left₀ (norm_nonneg (F Z)) (hF_dec Z hZ hZ1) 2
        rw [← norm_pow, ← Real.rpow_natCast, ← Real.rpow_mul (by linarith)] at h1
        have h_exp : -α₁ * (2 : ℕ) = -2 * α₁ := by push_cast; ring
        rwa [h_exp] at h1
      · intro y hy
        have hy_pos : 0 < y := lt_trans L.D₀_pos hy
        set Y : ℂ := -(y : ℂ) * Complex.I
        have hY_im : -Y.im = y := by simp [Y]
        have hY_re : |Y.re| < -Y.im := by simp [Y, hy_pos]
        have h_sq : (1 / 2 : ℂ) ^ 2 * (F (L.S_inf Y)) ^ 2 * (deriv L.S_inf Y) ^ 2 =
            (F (L.S_inf Y) * deriv L.S_inf Y / 2) ^ 2 := by ring
        rw [h_sq, hEqG1]
        exact hF_eq Y (by linarith) hY_re
    · refine ⟨frozenSecondFieldG, Q, fun w hw => (h_ker2_props w hw).1, ?_, ?_⟩
      · intro Z hZ hZ1
        have h1 := pow_le_pow_left₀ (Real.sqrt_nonneg ‖Q Z‖) (hQ_dec Z hZ hZ1) 2
        rw [Real.sq_sqrt (norm_nonneg _), ← Real.rpow_natCast,
          ← Real.rpow_mul (by linarith)] at h1
        have h_exp : -α₁ * (2 : ℕ) = -2 * α₁ := by push_cast; ring
        rwa [h_exp] at h1
      · intro y hy
        have hy_pos : 0 < y := lt_trans L.D₀_pos hy
        set Y : ℂ := -(y : ℂ) * Complex.I
        exact hQ_eq Y (by simp [Y]; linarith) (by simp [Y, hy_pos])

  obtain ⟨G_sq, W, hG_lip, hW_dec, hRayEq⟩ := h_unif
  let Δ : ℂ → ℂ := fun Z => L.S_inf Z - Z
  have hΔ_holo : DifferentiableOn ℂ Δ superlinearLowerHalfPlane :=
    L.S_inf_holo.sub differentiableOn_id
  let Y_thr : ℝ := max (max (2 * L.D₁ + 2) (L.D₀ + 1)) (16 * L.C₁ + 4)
  have hY_thr_ge_four : 4 ≤ Y_thr := by
    have : 16 * L.C₁ + 4 ≤ Y_thr := le_max_right _ _
    linarith [L.C₁_pos]

  have hΔ_deriv_bound : ∀ y : ℝ, Y_thr ≤ y →
      ‖deriv Δ (-(y : ℂ) * Complex.I)‖ ≤ 2 * y ^ (-2 * α₁) := by
    intro y hy
    have hy_ge4 : 4 ≤ y := le_trans hY_thr_ge_four hy
    have hy_pos : 0 < y := by linarith
    have hy_half_pos : 0 < y / 2 := by positivity
    have hy_D₁ : 2 * L.D₁ + 2 ≤ y :=
      le_trans (le_trans (le_max_left _ _) (le_max_left _ _)) hy
    have hy_D₀ : L.D₀ < y := by
      have : L.D₀ + 1 ≤ y := le_trans (le_trans (le_max_right _ _) (le_max_left _ _)) hy
      linarith
    have hy_C₁ : 16 * L.C₁ + 4 ≤ y := le_trans (le_max_right _ _) hy
    set c_y : ℂ := -(y : ℂ) * Complex.I
    have hc_mem : c_y ∈ superlinearLowerHalfPlane := by
      change c_y.im < 0
      simp [c_y, hy_pos]
    have h_cb_sub : Metric.closedBall c_y (y / 2) ⊆ superlinearLowerHalfPlane := by
      intro Z hZ
      rw [Metric.mem_closedBall, dist_eq_norm] at hZ
      have him_diff : |(Z - c_y).im| ≤ y / 2 :=
        le_trans (Complex.abs_im_le_norm _) hZ
      have hc_im : c_y.im = -y := by simp [c_y]
      rw [Complex.sub_im, hc_im, abs_le] at him_diff
      change Z.im < 0
      linarith
    have h_diffCont_ball : DiffContOnCl ℂ Δ (Metric.ball c_y (y / 2)) :=
      (hΔ_holo.mono (Metric.closure_ball_subset_closedBall.trans h_cb_sub)).diffContOnCl
    have h_sphere : ∀ Z ∈ Metric.sphere c_y (y / 2), ‖Δ Z‖ ≤ L.C₁ := by
      intro Z hZ
      have hZ_cb : Z ∈ Metric.closedBall c_y (y / 2) := Metric.sphere_subset_closedBall hZ
      rw [Metric.mem_closedBall, dist_eq_norm] at hZ_cb
      have him_diff : |(Z - c_y).im| ≤ y / 2 :=
        le_trans (Complex.abs_im_le_norm _) hZ_cb
      have hc_im : c_y.im = -y := by simp [c_y]
      rw [Complex.sub_im, hc_im, abs_le] at him_diff
      have hZ_depth_D₁ : L.D₁ ≤ -Z.im := by linarith
      have hZ_depth_one : 1 ≤ -Z.im := by linarith
      have hZ_eq : Z = (Z.re : ℂ) - ((-Z.im : ℝ) : ℂ) * Complex.I := by
        apply Complex.ext <;> simp
      have h_anc : ‖Δ Z‖ ≤ L.C₁ * (-Z.im) ^ (-(1 / 2 : ℝ)) := by
        have h_raw := L.S_inf_anchor Z.re (-Z.im) hZ_depth_D₁
        rw [← hZ_eq] at h_raw
        exact h_raw
      have h_rpow_le : (-Z.im) ^ (-(1 / 2 : ℝ)) ≤ 1 :=
        Real.rpow_le_one_of_one_le_of_nonpos hZ_depth_one (by norm_num)
      nlinarith [L.C₁_pos]
    have h_cauchy :=
      Complex.norm_deriv_le_of_forall_mem_sphere_norm_le hy_half_pos h_diffCont_ball h_sphere
    have h_deriv_lt : ‖deriv Δ c_y‖ < 1 / 8 := by
      have h_div_eq : L.C₁ / (y / 2) = 2 * L.C₁ / y := by ring
      rw [h_div_eq] at h_cauchy
      have h_lt : 2 * L.C₁ / y < 1 / 8 := by
        rw [div_lt_iff₀ hy_pos]
        linarith
      exact lt_of_le_of_lt h_cauchy h_lt
    have hS_diffAt : DifferentiableAt ℂ L.S_inf c_y :=
      L.S_inf_holo.differentiableAt (hH_open.mem_nhds hc_mem)
    have h_deriv_Δ_eq : deriv Δ c_y = deriv L.S_inf c_y - 1 :=
      ((hS_diffAt.hasDerivAt).sub (hasDerivAt_id c_y)).deriv
    set J : ℂ := deriv L.S_inf c_y
    have hJ_close : ‖J - 1‖ < 1 / 8 := by
      rwa [← h_deriv_Δ_eq]
    have hJ_norm : ‖J‖ ≤ 9 / 8 := by
      have h_tri : ‖J‖ ≤ ‖J - 1‖ + ‖(1 : ℂ)‖ := by
        simpa using norm_add_le (J - 1) 1
      rw [norm_one] at h_tri
      linarith
    have hJ2_le : ‖J‖ ^ 2 ≤ 2 := by nlinarith [norm_nonneg J]
    have hJ3_le : ‖J‖ ^ 3 ≤ 2 := by
      have : ‖J‖ ^ 3 ≤ (9 / 8 : ℝ) ^ 3 := pow_le_pow_left₀ (norm_nonneg J) hJ_norm 3
      linarith
    have hJ_quad_ge : 2 ≤ ‖J ^ 2 + J + 1‖ := by
      let rem_J : ℂ := (J - 1) ^ 2 + 3 * (J - 1)
      have h_id : (3 : ℂ) = (J ^ 2 + J + 1) - rem_J := by dsimp [rem_J]; ring
      have h_tri : ‖(3 : ℂ)‖ ≤ ‖J ^ 2 + J + 1‖ + ‖rem_J‖ := by
        rw [h_id]; exact norm_sub_le _ _
      have h_rem : ‖rem_J‖ ≤ ‖(J - 1) ^ 2‖ + ‖3 * (J - 1)‖ := norm_add_le _ _
      rw [norm_pow, norm_mul] at h_rem
      have h3_norm : ‖(3 : ℂ)‖ = (3 : ℝ) := by norm_num
      rw [h3_norm] at h_tri h_rem
      nlinarith [norm_nonneg (J - 1)]
    set Z_y : ℂ := L.S_inf c_y
    have hZy_mem : Z_y ∈ superlinearLowerHalfPlane := L.S_inf_maps_to c_y hc_mem
    have hZy_im_le : Z_y.im ≤ -y := by
      have hc_im : c_y.im = -y := by simp [c_y]
      exact (h_im_le c_y hc_mem).trans_eq hc_im
    have hy_le_Zy : y ≤ -Z_y.im := by linarith
    have hW_Zy : ‖W Z_y‖ ≤ y ^ (-2 * α₁) := by
      have h1 : ‖W Z_y‖ ≤ (-Z_y.im) ^ (-2 * α₁) := hW_dec Z_y hZy_mem (by linarith)
      have h2 : (-Z_y.im) ^ (-2 * α₁) ≤ y ^ (-2 * α₁) :=
        Real.rpow_le_rpow_of_nonpos hy_pos hy_le_Zy (by linarith)
      exact le_trans h1 h2
    set w : ℂ := (1 / 2 : ℂ) ^ 2 * W Z_y * J ^ 2
    have hw_bound : ‖w‖ ≤ (1 / 2 : ℝ) * y ^ (-2 * α₁) := by
      have h_quarter : ‖(1 / 2 : ℂ) ^ 2‖ = (1 / 4 : ℝ) := by norm_num
      calc ‖w‖ = ‖(1 / 2 : ℂ) ^ 2‖ * ‖W Z_y‖ * ‖J‖ ^ 2 := by
            dsimp [w]; rw [norm_mul, norm_mul, norm_pow J 2]
        _ = (1 / 4 : ℝ) * (‖W Z_y‖ * ‖J‖ ^ 2) := by rw [h_quarter]; ring
        _ ≤ (1 / 4 : ℝ) * (y ^ (-2 * α₁) * 2) :=
            mul_le_mul_of_nonneg_left
              (mul_le_mul hW_Zy hJ2_le (sq_nonneg _) (Real.rpow_pos_of_pos hy_pos _).le)
              (by norm_num)
        _ = (1 / 2 : ℝ) * y ^ (-2 * α₁) := by ring
    have hw_quarter : ‖w‖ ≤ 1 / 4 := by
      have hy_rpow_inv : y ^ (-2 * α₁) ≤ y ^ (-1 : ℝ) :=
        Real.rpow_le_rpow_of_exponent_le (by linarith) (by linarith)
      rw [Real.rpow_neg_one] at hy_rpow_inv
      have hy_inv_le : y⁻¹ ≤ 1 / 4 := by
        rw [inv_le_comm₀ hy_pos (by norm_num)]
        norm_num
        exact hy_ge4
      linarith
    have hJ_eq_one : J ^ 3 * G_sq w = 1 := hRayEq y hy_D₀
    have h_cubic : (J - 1) * (J ^ 2 + J + 1) = J ^ 3 * (1 - G_sq w) := by
      calc (J - 1) * (J ^ 2 + J + 1) = J ^ 3 - 1 := by ring
        _ = J ^ 3 - J ^ 3 * G_sq w := by rw [hJ_eq_one]
        _ = J ^ 3 * (1 - G_sq w) := by ring
    have h_norm_cubic : 2 * ‖J - 1‖ ≤ 4 * y ^ (-2 * α₁) := by
      calc 2 * ‖J - 1‖
          ≤ ‖J - 1‖ * ‖J ^ 2 + J + 1‖ := by
            have := mul_le_mul_of_nonneg_left hJ_quad_ge (norm_nonneg (J - 1))
            linarith
        _ = ‖(J - 1) * (J ^ 2 + J + 1)‖ := (norm_mul _ _).symm
        _ = ‖J ^ 3 * (1 - G_sq w)‖ := by rw [h_cubic]
        _ = ‖J‖ ^ 3 * ‖1 - G_sq w‖ := by rw [norm_mul, norm_pow]
        _ ≤ 2 * (4 * ‖w‖) :=
            mul_le_mul hJ3_le (hG_lip w hw_quarter) (norm_nonneg _) (by norm_num)
        _ ≤ 2 * (4 * ((1 / 2 : ℝ) * y ^ (-2 * α₁))) :=
            mul_le_mul_of_nonneg_left
              (mul_le_mul_of_nonneg_left hw_bound (by norm_num)) (by norm_num)
        _ = 4 * y ^ (-2 * α₁) := by ring
    rw [h_deriv_Δ_eq]
    linarith

  let C₂ : ℝ := 2 / (2 * α₁ - 1)
  have hC₂_pos : 0 < C₂ := div_pos (by norm_num) (by linarith)
  have hΔ_seg_bound : ∀ y R : ℝ, Y_thr ≤ y → y ≤ R →
      ‖Δ (-(R : ℂ) * Complex.I) - Δ (-(y : ℂ) * Complex.I)‖ ≤ C₂ * y ^ (1 - 2 * α₁) := by
    intro y R hy hyR
    let φ : ℝ → ℂ := fun t => (t : ℂ) * (-Complex.I)
    have hφ_eq : ∀ t : ℝ, φ t = -(t : ℂ) * Complex.I := fun t => by simp [φ]
    let f_ray : ℝ → ℂ := fun t => Δ (φ t) - Δ (φ y)
    let f_ray' : ℝ → ℂ := fun t => (-Complex.I) • deriv Δ (φ t)
    let B_ray : ℝ → ℝ := fun t => C₂ * (y ^ (1 - 2 * α₁) - t ^ (1 - 2 * α₁))
    let B_ray' : ℝ → ℝ := fun t => 2 * t ^ (-2 * α₁)
    have hφ_maps : Set.MapsTo φ (Set.Icc y R) superlinearLowerHalfPlane := by
      intro t ht
      have ht_pos : 0 < t := lt_of_lt_of_le (by linarith [hY_thr_ge_four]) ht.1
      change (φ t).im < 0
      simp [φ, ht_pos]
    have hf_cont : ContinuousOn f_ray (Set.Icc y R) :=
      (hΔ_holo.continuousOn.comp (by fun_prop) hφ_maps).sub continuousOn_const
    have hf_deriv : ∀ t ∈ Set.Ico y R,
        HasDerivWithinAt f_ray (f_ray' t) (Set.Ici t) t := by
      intro t ht
      have ht_mem : φ t ∈ superlinearLowerHalfPlane := hφ_maps ⟨ht.1, ht.2.le⟩
      have hΔ_at : HasDerivAt Δ (deriv Δ (φ t)) (φ t) :=
        (hΔ_holo.differentiableAt (hH_open.mem_nhds ht_mem)).hasDerivAt
      have hφ_at : HasDerivAt φ (-Complex.I) t := by
        simpa [φ] using (Complex.ofRealCLM.hasDerivAt (x := t)).mul_const (-Complex.I)
      have h_comp : HasDerivAt (Δ ∘ φ) (f_ray' t) t :=
        HasDerivAt.scomp t hΔ_at hφ_at
      exact (h_comp.sub_const (Δ (φ y))).hasDerivWithinAt
    have hB_cont : ContinuousOn B_ray (Set.Icc y R) := by
      refine continuousOn_const.mul (continuousOn_const.sub ?_)
      refine ContinuousOn.rpow_const continuousOn_id ?_
      intro t ht
      left
      have : 4 ≤ t := le_trans (le_trans hY_thr_ge_four hy) ht.1
      linarith
    have hB_deriv : ∀ t ∈ Set.Ico y R,
        HasDerivWithinAt B_ray (B_ray' t) (Set.Ici t) t := by
      intro t ht
      have ht_pos : 0 < t := lt_of_lt_of_le (by linarith [hY_thr_ge_four]) ht.1
      have hr : HasDerivAt (fun s : ℝ => s ^ (1 - 2 * α₁))
          ((1 - 2 * α₁) * t ^ ((1 - 2 * α₁) - 1)) t :=
        Real.hasDerivAt_rpow_const (Or.inl ht_pos.ne')
      have h_sub := (hasDerivAt_const t (y ^ (1 - 2 * α₁))).sub hr
      have h_mul := h_sub.const_mul C₂
      have h_eq : C₂ * (0 - (1 - 2 * α₁) * t ^ ((1 - 2 * α₁) - 1)) = B_ray' t := by
        dsimp [C₂, B_ray']
        have h_exp : (1 : ℝ) - 2 * α₁ - 1 = -2 * α₁ := by ring
        rw [h_exp]
        have hne : 2 * α₁ - 1 ≠ 0 := by linarith
        field_simp [hne]
        ring
      rw [h_eq] at h_mul
      exact h_mul.hasDerivWithinAt
    have hf_a : ‖f_ray y‖ ≤ B_ray y := by
      simp [f_ray, B_ray]
    have h_norm_deriv : ∀ t ∈ Set.Ico y R, ‖f_ray' t‖ ≤ B_ray' t := by
      intro t ht
      dsimp [f_ray', B_ray']
      rw [norm_mul, norm_neg, Complex.norm_I, one_mul, hφ_eq]
      exact hΔ_deriv_bound t (le_trans hy ht.1)
    have h_mvt :=
      image_norm_le_of_norm_deriv_right_le_deriv_boundary' hf_cont hf_deriv hf_a hB_cont hB_deriv
        h_norm_deriv ⟨hyR, le_rfl⟩
    dsimp [f_ray, B_ray] at h_mvt
    rw [hφ_eq R, hφ_eq y] at h_mvt
    have hR_pos : 0 < R := lt_of_lt_of_le (by linarith [hY_thr_ge_four]) (le_trans hy hyR)
    have hR_rpow_pos : 0 < R ^ (1 - 2 * α₁) := Real.rpow_pos_of_pos hR_pos _
    nlinarith [hC₂_pos]

  have h_ray_o : ∀ ε : ℝ, 0 < ε → ∃ y : ℝ, 1 < y ∧
      y * ‖L.S_inf (-(y : ℂ) * Complex.I) - (-(y : ℂ) * Complex.I)‖ < ε := by
    intro ε hε
    let p : ℝ := 2 * α₁ - 2
    have hp_pos : 0 < p := by dsimp [p]; linarith
    let y : ℝ := max Y_thr ((2 * C₂ / ε) ^ (1 / p) + 1)
    have hy_thr : Y_thr ≤ y := le_max_left _ _
    have hy_gt_one : 1 < y := lt_of_lt_of_le (by linarith [hY_thr_ge_four]) hy_thr
    have hy_pos : 0 < y := lt_trans zero_lt_one hy_gt_one
    have hy_gt_rpow : (2 * C₂ / ε) ^ (1 / p) < y := by
      have : (2 * C₂ / ε) ^ (1 / p) + 1 ≤ y := le_max_right _ _
      linarith
    have h_base_pos : 0 < 2 * C₂ / ε := by positivity
    have hy_p_gt : 2 * C₂ / ε < y ^ p := by
      have h1 := Real.rpow_lt_rpow (Real.rpow_pos_of_pos h_base_pos _).le hy_gt_rpow hp_pos
      rw [← Real.rpow_mul h_base_pos.le, one_div_mul_cancel hp_pos.ne', Real.rpow_one] at h1
      exact h1
    have h_term1 : C₂ * y ^ (2 - 2 * α₁) < ε / 2 := by
      have h_prod : y ^ p * y ^ (2 - 2 * α₁) = 1 := by
        rw [← Real.rpow_add hy_pos]
        have : p + (2 - 2 * α₁) = 0 := by dsimp [p]; ring
        rw [this, Real.rpow_zero]
      have hmul := mul_lt_mul_of_pos_right hy_p_gt (Real.rpow_pos_of_pos hy_pos (2 - 2 * α₁))
      rw [h_prod] at hmul
      have hmul2 := mul_lt_mul_of_pos_left hmul (by positivity : 0 < ε / 2)
      have h_cancel : ε / 2 * (2 * C₂ / ε * y ^ (2 - 2 * α₁)) = C₂ * y ^ (2 - 2 * α₁) := by
        field_simp [hε.ne']
      linarith
    let R : ℝ := max y (((y * L.C₁) / (ε / 2)) ^ 2 + 1)
    have hy_le_R : y ≤ R := le_max_left _ _
    have hR_D₁ : L.D₁ ≤ R := by
      have : 2 * L.D₁ + 2 ≤ Y_thr := le_trans (le_max_left _ _) (le_max_left _ _)
      linarith [L.D₁_pos]
    have hR_sq : ((y * L.C₁) / (ε / 2)) ^ 2 < R := by
      have : ((y * L.C₁) / (ε / 2)) ^ 2 + 1 ≤ R := le_max_right _ _
      linarith
    have h_term2 : (y * L.C₁) * R ^ (-(1 / 2 : ℝ)) < ε / 2 :=
      h_inv_sqrt_lt (y * L.C₁) (ε / 2) R (mul_pos hy_pos L.C₁_pos) (by positivity) hR_sq
    have hΔR : ‖Δ (-(R : ℂ) * Complex.I)‖ ≤ L.C₁ * R ^ (-(1 / 2 : ℝ)) := by
      simpa [Δ] using L.S_inf_anchor 0 R hR_D₁
    have h_seg := hΔ_seg_bound y R hy_thr hy_le_R
    have h_tri : ‖Δ (-(y : ℂ) * Complex.I)‖ ≤
        ‖Δ (-(R : ℂ) * Complex.I) - Δ (-(y : ℂ) * Complex.I)‖ + ‖Δ (-(R : ℂ) * Complex.I)‖ := by
      calc ‖Δ (-(y : ℂ) * Complex.I)‖
          = ‖Δ (-(R : ℂ) * Complex.I) - (Δ (-(R : ℂ) * Complex.I) - Δ (-(y : ℂ) * Complex.I))‖ := by
            ring_nf
        _ ≤ ‖Δ (-(R : ℂ) * Complex.I)‖ +
              ‖Δ (-(R : ℂ) * Complex.I) - Δ (-(y : ℂ) * Complex.I)‖ := norm_sub_le _ _
        _ = ‖Δ (-(R : ℂ) * Complex.I) - Δ (-(y : ℂ) * Complex.I)‖ +
              ‖Δ (-(R : ℂ) * Complex.I)‖ := add_comm _ _
    have hy_rpow_mul : y * (C₂ * y ^ (1 - 2 * α₁)) = C₂ * y ^ (2 - 2 * α₁) := by
      calc y * (C₂ * y ^ (1 - 2 * α₁))
          = C₂ * (y ^ (1 : ℝ) * y ^ (1 - 2 * α₁)) := by rw [Real.rpow_one]; ring
        _ = C₂ * y ^ (1 + (1 - 2 * α₁)) := by rw [← Real.rpow_add hy_pos]
        _ = C₂ * y ^ (2 - 2 * α₁) := by ring_nf
    refine ⟨y, hy_gt_one, ?_⟩
    change y * ‖Δ (-(y : ℂ) * Complex.I)‖ < ε
    calc y * ‖Δ (-(y : ℂ) * Complex.I)‖
        ≤ y * (‖Δ (-(R : ℂ) * Complex.I) - Δ (-(y : ℂ) * Complex.I)‖ +
            ‖Δ (-(R : ℂ) * Complex.I)‖) :=
          mul_le_mul_of_nonneg_left h_tri hy_pos.le
      _ ≤ y * (C₂ * y ^ (1 - 2 * α₁) + L.C₁ * R ^ (-(1 / 2 : ℝ))) :=
          mul_le_mul_of_nonneg_left (add_le_add h_seg hΔR) hy_pos.le
      _ = y * (C₂ * y ^ (1 - 2 * α₁)) + (y * L.C₁) * R ^ (-(1 / 2 : ℝ)) := by ring
      _ = C₂ * y ^ (2 - 2 * α₁) + (y * L.C₁) * R ^ (-(1 / 2 : ℝ)) := by rw [hy_rpow_mul]
      _ < ε / 2 + ε / 2 := add_lt_add h_term1 h_term2
      _ = ε := add_halves ε

  
  let h : ℂ → ℂ := fun Y => -Complex.I * (Y - L.S_inf Y)
  have hh_holo : DifferentiableOn ℂ h superlinearLowerHalfPlane :=
    (differentiableOn_id.sub L.S_inf_holo).const_mul (-Complex.I)
  have hh_re_nonneg : ∀ Y ∈ superlinearLowerHalfPlane, 0 ≤ (h Y).re := by
    intro Y hY
    have him := h_im_le Y hY
    have hre : (h Y).re = Y.im - (L.S_inf Y).im := by simp [h]
    linarith
  have hh_norm : ∀ Y : ℂ, ‖h Y‖ = ‖L.S_inf Y - Y‖ := by
    intro Y
    dsimp [h]
    rw [norm_mul, norm_neg, Complex.norm_I, one_mul, norm_sub_rev]

  have hh0_re_zero : (h (-Complex.I)).re = 0 := by
    have hv₁_nonneg : 0 ≤ (h (-Complex.I)).re := hh_re_nonneg (-Complex.I) hnegI_mem
    by_contra hv₁_ne
    have hv₁_pos : 0 < (h (-Complex.I)).re := lt_of_le_of_ne hv₁_nonneg (Ne.symm hv₁_ne)
    set h₀ : ℂ := h (-Complex.I)
    set v₁ : ℝ := h₀.re
    let ψ : ℂ → ℂ := fun ζ => -Complex.I * (1 + ζ) / (1 - ζ)
    have h1_sub_ne : ∀ ζ ∈ Metric.ball (0 : ℂ) 1, 1 - ζ ≠ 0 := by
      intro ζ hζ h_eq
      rw [Metric.mem_ball, dist_zero_right] at hζ
      have hζ1 : ζ = 1 := (sub_eq_zero.mp h_eq).symm
      rw [hζ1, norm_one] at hζ
      exact lt_irrefl 1 hζ
    have hψ_holo : DifferentiableOn ℂ ψ (Metric.ball (0 : ℂ) 1) :=
      (((differentiableOn_const (1 : ℂ)).add differentiableOn_id).const_mul (-Complex.I)).div
        ((differentiableOn_const (1 : ℂ)).sub differentiableOn_id) h1_sub_ne
    have hψ_maps : Set.MapsTo ψ (Metric.ball (0 : ℂ) 1) superlinearLowerHalfPlane := by
      intro ζ hζ
      have hne : 1 - ζ ≠ 0 := h1_sub_ne ζ hζ
      have hden_pos : 0 < Complex.normSq (1 - ζ) := Complex.normSq_pos.mpr hne
      rw [Metric.mem_ball, dist_zero_right] at hζ
      have hnorm_sq : Complex.normSq ζ < 1 := by
        rw [← Complex.sq_norm]
        nlinarith [norm_nonneg ζ]
      rw [Complex.normSq_apply] at hnorm_sq
      change (ψ ζ).im < 0
      dsimp [ψ]
      rw [Complex.div_im]
      have h_num : (-Complex.I * (1 + ζ)).im * (1 - ζ).re / Complex.normSq (1 - ζ) -
          (-Complex.I * (1 + ζ)).re * (1 - ζ).im / Complex.normSq (1 - ζ) =
          (ζ.re * ζ.re + ζ.im * ζ.im - 1) / Complex.normSq (1 - ζ) := by
        simp [Complex.mul_re, Complex.mul_im]
        ring
      rw [h_num]
      exact div_neg_of_neg_of_pos (by linarith) hden_pos
    let Θ : ℂ → ℂ := fun ζ => (h (ψ ζ) - h₀) / (h (ψ ζ) + starRingEnd ℂ h₀)
    have h_quad_id : ∀ w : ℂ,
        ‖w + starRingEnd ℂ h₀‖ ^ 2 - ‖w - h₀‖ ^ 2 = 4 * w.re * v₁ := by
      intro w
      rw [Complex.sq_norm, Complex.sq_norm, Complex.normSq_apply, Complex.normSq_apply]
      simp [v₁]
      ring
    have hΘ_den_ge : ∀ ζ ∈ Metric.ball (0 : ℂ) 1, v₁ ≤ ‖h (ψ ζ) + starRingEnd ℂ h₀‖ := by
      intro ζ hζ
      have hw_re : 0 ≤ (h (ψ ζ)).re := hh_re_nonneg (ψ ζ) (hψ_maps hζ)
      have h_re : v₁ ≤ (h (ψ ζ) + starRingEnd ℂ h₀).re := by
        simp [v₁]
        linarith
      exact le_trans h_re (le_trans (le_abs_self _) (Complex.abs_re_le_norm _))
    have hΘ_den_ne : ∀ ζ ∈ Metric.ball (0 : ℂ) 1, h (ψ ζ) + starRingEnd ℂ h₀ ≠ 0 := by
      intro ζ hζ h0
      have := hΘ_den_ge ζ hζ
      rw [h0, norm_zero] at this
      linarith
    have hΘ_holo : DifferentiableOn ℂ Θ (Metric.ball (0 : ℂ) 1) := by
      have h_comp : DifferentiableOn ℂ (fun ζ => h (ψ ζ)) (Metric.ball (0 : ℂ) 1) :=
        hh_holo.comp hψ_holo hψ_maps
      exact (h_comp.sub (differentiableOn_const h₀)).div
        (h_comp.add (differentiableOn_const (starRingEnd ℂ h₀))) hΘ_den_ne
    have hΘ_maps : Set.MapsTo Θ (Metric.ball (0 : ℂ) 1) (Metric.closedBall (0 : ℂ) 1) := by
      intro ζ hζ
      rw [Metric.mem_closedBall, dist_zero_right]
      dsimp [Θ]
      rw [norm_div]
      have hden_pos : 0 < ‖h (ψ ζ) + starRingEnd ℂ h₀‖ :=
        lt_of_lt_of_le hv₁_pos (hΘ_den_ge ζ hζ)
      rw [div_le_one hden_pos]
      have hw_re : 0 ≤ (h (ψ ζ)).re := hh_re_nonneg (ψ ζ) (hψ_maps hζ)
      have hq := h_quad_id (h (ψ ζ))
      have h_sq_le : ‖h (ψ ζ) - h₀‖ ^ 2 ≤ ‖h (ψ ζ) + starRingEnd ℂ h₀‖ ^ 2 := by
        nlinarith
      nlinarith [norm_nonneg (h (ψ ζ) - h₀), hden_pos]
    have hΘ_zero : Θ 0 = 0 := by
      have hψ0 : ψ 0 = -Complex.I := by simp [ψ]
      dsimp [Θ, h₀]
      rw [hψ0, sub_self, zero_div]
    obtain ⟨y, hy_gt_one, hy_small⟩ := h_ray_o (v₁ / 4) (by positivity)
    have hy_pos : 0 < y := lt_trans zero_lt_one hy_gt_one
    set r_y : ℝ := (y - 1) / (y + 1)
    have hr_pos : 0 < r_y := div_pos (by linarith) (by linarith)
    have hr_lt_one : r_y < 1 := (div_lt_one (by linarith)).mpr (by linarith)
    set ζ_y : ℂ := (r_y : ℂ)
    have hζ_norm : ‖ζ_y‖ = r_y := by
      simp [ζ_y, abs_of_pos hr_pos]
    have hζ_lt : ‖ζ_y‖ < 1 := by linarith
    have hψ_ζ : ψ ζ_y = -(y : ℂ) * Complex.I := by
      dsimp [ψ, ζ_y, r_y]
      have hy1_ne : (y : ℂ) + 1 ≠ 0 := by exact_mod_cast (by linarith : y + 1 ≠ 0)
      push_cast
      field_simp [hy1_ne]
      ring
    have h_schwarz :=
      Complex.norm_le_norm_of_mapsTo_ball hΘ_holo hΘ_maps hΘ_zero hζ_lt
    rw [hζ_norm] at h_schwarz
    set w_y : ℂ := h (-(y : ℂ) * Complex.I)
    have hw_y_eq : h (ψ ζ_y) = w_y := by rw [hψ_ζ]
    have hw_re_nonneg : 0 ≤ w_y.re :=
      hh_re_nonneg (-(y : ℂ) * Complex.I) (by change (-(y : ℂ) * Complex.I).im < 0; simp [hy_pos])
    have hD_ge : v₁ ≤ ‖w_y + starRingEnd ℂ h₀‖ := by
      rw [← hw_y_eq]
      exact hΘ_den_ge ζ_y (by rwa [Metric.mem_ball, dist_zero_right])
    set D_y : ℝ := ‖w_y + starRingEnd ℂ h₀‖
    have hD_pos : 0 < D_y := lt_of_lt_of_le hv₁_pos hD_ge
    have hΘ_val : ‖Θ ζ_y‖ = ‖w_y - h₀‖ / D_y := by
      dsimp [Θ, D_y]
      rw [hw_y_eq, norm_div]
    rw [hΘ_val] at h_schwarz
    have h_num_le : ‖w_y - h₀‖ ≤ r_y * D_y := (div_le_iff₀ hD_pos).mp h_schwarz
    have h_sq_le : ‖w_y - h₀‖ ^ 2 ≤ (r_y * D_y) ^ 2 :=
      pow_le_pow_left₀ (norm_nonneg _) h_num_le 2
    have h_id_y : D_y ^ 2 - ‖w_y - h₀‖ ^ 2 = 4 * w_y.re * v₁ := h_quad_id w_y
    have h1_sub_r2 : 1 - r_y ^ 2 = 4 * y / (y + 1) ^ 2 := by
      dsimp [r_y]
      have hy1 : y + 1 ≠ 0 := by linarith
      field_simp [hy1]
      ring
    have h_lower1 : (4 * y / (y + 1) ^ 2) * v₁ ^ 2 ≤ 4 * w_y.re * v₁ := by
      calc (4 * y / (y + 1) ^ 2) * v₁ ^ 2
          ≤ (4 * y / (y + 1) ^ 2) * D_y ^ 2 := by
            gcongr
        _ = (1 - r_y ^ 2) * D_y ^ 2 := by rw [h1_sub_r2]
        _ = D_y ^ 2 - (r_y * D_y) ^ 2 := by ring
        _ ≤ D_y ^ 2 - ‖w_y - h₀‖ ^ 2 := by linarith
        _ = 4 * w_y.re * v₁ := h_id_y
    have h_clear : 4 * y * v₁ ^ 2 ≤ 4 * w_y.re * v₁ * (y + 1) ^ 2 := by
      have hp : 0 < (y + 1) ^ 2 := by positivity
      have hmul := mul_le_mul_of_nonneg_right h_lower1 hp.le
      have hlhs : 4 * y / (y + 1) ^ 2 * v₁ ^ 2 * (y + 1) ^ 2 = 4 * y * v₁ ^ 2 := by
        field_simp [hp.ne']
      linarith
    have hy1_sq_le : (y + 1) ^ 2 ≤ 4 * y ^ 2 := by nlinarith
    have h_bound_re : v₁ / 4 ≤ y * w_y.re := by
      have hwv_nonneg : 0 ≤ 4 * w_y.re * v₁ := by positivity
      have h_step : 4 * w_y.re * v₁ * (y + 1) ^ 2 ≤ 16 * y ^ 2 * w_y.re * v₁ := by
        calc 4 * w_y.re * v₁ * (y + 1) ^ 2
            ≤ 4 * w_y.re * v₁ * (4 * y ^ 2) := mul_le_mul_of_nonneg_left hy1_sq_le hwv_nonneg
          _ = 16 * y ^ 2 * w_y.re * v₁ := by ring
      have h_comb : (16 * y * v₁) * (v₁ / 4) ≤ (16 * y * v₁) * (y * w_y.re) := by
        linarith [le_trans h_clear h_step]
      exact le_of_mul_le_mul_left h_comb (by positivity : 0 < 16 * y * v₁)
    have hw_re_le_norm : w_y.re ≤ ‖L.S_inf (-(y : ℂ) * Complex.I) - (-(y : ℂ) * Complex.I)‖ := by
      rw [← hh_norm]
      exact le_trans (le_abs_self _) (Complex.abs_re_le_norm _)
    have h_contra_le :
        v₁ / 4 ≤ y * ‖L.S_inf (-(y : ℂ) * Complex.I) - (-(y : ℂ) * Complex.I)‖ :=
      le_trans h_bound_re (mul_le_mul_of_nonneg_left hw_re_le_norm hy_pos.le)
    linarith

  let β : ℝ := (h (-Complex.I)).im
  let h₁ : ℂ → ℂ := fun Y => h Y - (β : ℂ) * Complex.I
  have hh₁_zero : h₁ (-Complex.I) = 0 := by
    apply Complex.ext
    · simp [h₁, hh0_re_zero]
    · simp [h₁, β]
  have hh₁_re_nonneg : ∀ Y ∈ superlinearLowerHalfPlane, 0 ≤ (h₁ Y).re := by
    intro Y hY
    have : (h₁ Y).re = (h Y).re := by simp [h₁]
    rw [this]
    exact hh_re_nonneg Y hY
  have hh₁_add_one_ge : ∀ Y ∈ superlinearLowerHalfPlane, 1 ≤ ‖h₁ Y + 1‖ := by
    intro Y hY
    have hre := hh₁_re_nonneg Y hY
    have hre1 : 1 ≤ (h₁ Y + 1).re := by simp; linarith
    exact le_trans hre1 (le_trans (le_abs_self _) (Complex.abs_re_le_norm _))
  have hh₁_add_one_ne : ∀ Y ∈ superlinearLowerHalfPlane, h₁ Y + 1 ≠ 0 := by
    intro Y hY h0
    have := hh₁_add_one_ge Y hY
    rw [h0, norm_zero] at this
    linarith
  let G_inv : ℂ → ℂ := fun Y => (h₁ Y + 1)⁻¹
  have hG_inv_holo : DifferentiableOn ℂ G_inv superlinearLowerHalfPlane :=
    ((hh_holo.sub (differentiableOn_const _)).add (differentiableOn_const 1)).inv hh₁_add_one_ne
  have hG_inv_negI : ‖G_inv (-Complex.I)‖ = 1 := by
    simp [G_inv, hh₁_zero]
  have hG_inv_max : IsMaxOn (norm ∘ G_inv) superlinearLowerHalfPlane (-Complex.I) := by
    intro Y hY
    simp only [Function.comp_apply, hG_inv_negI, G_inv, norm_inv]
    exact inv_le_one_of_one_le₀ (hh₁_add_one_ge Y hY)
  have hG_inv_const :=
    Complex.norm_eqOn_of_isPreconnected_of_isMaxOn hH_preconn hH_open hG_inv_holo hnegI_mem
      hG_inv_max
  have hh₁_eq_zero : ∀ Y ∈ superlinearLowerHalfPlane, h₁ Y = 0 := by
    intro Y hY
    have h_eq : ‖G_inv Y‖ = 1 := by
      have := hG_inv_const hY
      simpa [hG_inv_negI] using this
    dsimp [G_inv] at h_eq
    rw [norm_inv, inv_eq_one] at h_eq
    have h_sq : ‖h₁ Y + 1‖ ^ 2 = 1 := by rw [h_eq]; norm_num
    rw [Complex.sq_norm, Complex.normSq_apply] at h_sq
    simp only [Complex.add_re, Complex.one_re, Complex.add_im, Complex.one_im, add_zero] at h_sq
    have hre := hh₁_re_nonneg Y hY
    have hre_zero : (h₁ Y).re = 0 := by nlinarith
    have him_zero : (h₁ Y).im = 0 := by nlinarith
    exact Complex.ext hre_zero him_zero
  have hS_shift : ∀ Y ∈ superlinearLowerHalfPlane, L.S_inf Y - Y = (β : ℂ) := by
    intro Y hY
    have h0 : h Y - (β : ℂ) * Complex.I = 0 := hh₁_eq_zero Y hY
    have h_eq : -Complex.I * (Y - L.S_inf Y) = (β : ℂ) * Complex.I := sub_eq_zero.mp h0
    have h_mul := congr_arg (fun z : ℂ => Complex.I * z) h_eq
    have hlhs : Complex.I * (-Complex.I * (Y - L.S_inf Y)) = Y - L.S_inf Y := by
      calc Complex.I * (-Complex.I * (Y - L.S_inf Y))
          = -(Complex.I ^ 2) * (Y - L.S_inf Y) := by ring
        _ = Y - L.S_inf Y := by simp
    have hrhs : Complex.I * ((β : ℂ) * Complex.I) = -(β : ℂ) := by
      calc Complex.I * ((β : ℂ) * Complex.I)
          = (β : ℂ) * Complex.I ^ 2 := by ring
        _ = -(β : ℂ) := by simp
    rw [hlhs, hrhs] at h_mul
    linear_combination -h_mul
  have hβ_zero : β = 0 := by
    by_contra hβ_ne
    have hβ_pos : 0 < |β| := abs_pos.mpr hβ_ne
    let D : ℝ := max L.D₁ ((L.C₁ / (|β| / 2)) ^ 2 + 1)
    have hD_ge : L.D₁ ≤ D := le_max_left _ _
    have hD_pos : 0 < D := lt_of_lt_of_le L.D₁_pos hD_ge
    have hD_sq : (L.C₁ / (|β| / 2)) ^ 2 < D := by
      have : (L.C₁ / (|β| / 2)) ^ 2 + 1 ≤ D := le_max_right _ _
      linarith
    have h_lt := h_inv_sqrt_lt L.C₁ (|β| / 2) D L.C₁_pos (by positivity) hD_sq
    set Y_D : ℂ := -(D : ℂ) * Complex.I
    have hYD_mem : Y_D ∈ superlinearLowerHalfPlane := by
      change Y_D.im < 0
      simp [Y_D, hD_pos]
    have h_anc : ‖L.S_inf Y_D - Y_D‖ ≤ L.C₁ * D ^ (-(1 / 2 : ℝ)) := by
      simpa [Y_D] using L.S_inf_anchor 0 D hD_ge
    rw [hS_shift Y_D hYD_mem, Complex.norm_real, Real.norm_eq_abs] at h_anc
    linarith
  have hS_id : ∀ Y ∈ superlinearLowerHalfPlane, L.S_inf Y = Y := by
    intro Y hY
    have := hS_shift Y hY
    rw [hβ_zero, Complex.ofReal_zero] at this
    exact sub_eq_zero.mp this
  have hS_deriv : ∀ Y ∈ superlinearLowerHalfPlane, deriv L.S_inf Y = 1 := by
    intro Y hY
    have h_ev : L.S_inf =ᶠ[nhds Y] id :=
      Filter.eventuallyEq_of_mem (hH_open.mem_nhds hY) (fun Z hZ => hS_id Z hZ)
    rw [h_ev.deriv_eq, deriv_id]

  
  let z_star : ℂ := -((L.D₀ + 3 : ℝ) : ℂ) * Complex.I
  have hz_star_mem : z_star ∈ superlinearLowerHalfPlane := by
    change z_star.im < 0
    simp [z_star]
    linarith [L.D₀_pos]
  have h_ball_props : ∀ Y ∈ Metric.ball z_star 1,
      Y ∈ superlinearLowerHalfPlane ∧
      1 ≤ -Y.im ∧
      L.D₀ < -Y.im ∧
      |Y.re| < -Y.im ∧
      (-Y.im) ^ (-α₁) ≤ 1 := by
    intro Y hY
    rw [Metric.mem_ball, dist_eq_norm] at hY
    have hre : |(Y - z_star).re| < 1 := lt_of_le_of_lt (Complex.abs_re_le_norm _) hY
    have him : |(Y - z_star).im| < 1 := lt_of_le_of_lt (Complex.abs_im_le_norm _) hY
    simp only [z_star, Complex.sub_re, Complex.sub_im, Complex.neg_re, Complex.mul_re,
      Complex.ofReal_re, Complex.I_re, mul_zero, Complex.ofReal_im, Complex.I_im, mul_one,
      sub_zero, neg_zero, Complex.neg_im, Complex.mul_im, add_zero, sub_neg_eq_add] at hre him
    rw [abs_lt] at him
    have hY_depth : L.D₀ + 2 < -Y.im := by linarith
    refine ⟨?_, ?_, ?_, ?_, ?_⟩
    · change Y.im < 0; linarith [L.D₀_pos]
    · linarith [L.D₀_pos]
    · linarith
    · linarith [L.D₀_pos]
    · exact Real.rpow_le_one_of_one_le_of_nonpos (by linarith [L.D₀_pos]) (by linarith)

  rcases L.pure_energy_branch with ⟨F, hF_holo, hF_norm, hF_dec, hF_eq⟩ |
      ⟨Q, hQ_holo, hQ_norm, hQ_dec, hQ_eq⟩
  · have hF_ball_zero : ∀ Y ∈ Metric.ball z_star 1, F Y = 0 := by
      intro Y hY
      obtain ⟨hY_H, hY_1, hY_D₀, hY_re, hY_rpow⟩ := h_ball_props Y hY
      have h_eq := hF_eq Y hY_D₀ hY_re
      rw [hS_id Y hY_H, hS_deriv Y hY_H] at h_eq
      simp only [one_pow, mul_one, one_mul] at h_eq
      have h_norm_half : ‖F Y / 2‖ ≤ 1 / 2 := by
        rw [norm_div, Complex.norm_ofNat]
        have hF_le : ‖F Y‖ ≤ 1 := le_trans (hF_dec Y hY_H hY_1) hY_rpow
        linarith
      have h_half_zero := h_ker1_zero (F Y / 2) h_norm_half h_eq
      exact div_eq_zero_iff.mp h_half_zero |>.resolve_right (by norm_num)
    have hF_ev : F =ᶠ[nhds z_star] (fun _ => (0 : ℂ)) :=
      Filter.eventuallyEq_of_mem
        (Metric.isOpen_ball.mem_nhds (Metric.mem_ball_self zero_lt_one)) hF_ball_zero
    have hF_eqOn :=
      (hF_holo.analyticOnNhd hH_open).eqOn_of_preconnected_of_eventuallyEq
        analyticOnNhd_const hH_preconn hz_star_mem hF_ev
    have hF_negI : F (-Complex.I) = 0 := hF_eqOn hnegI_mem
    rw [hF_negI, norm_zero] at hF_norm
    norm_num at hF_norm
  · have hQ_ball_zero : ∀ Y ∈ Metric.ball z_star 1, Q Y = 0 := by
      intro Y hY
      obtain ⟨hY_H, hY_1, hY_D₀, hY_re, hY_rpow⟩ := h_ball_props Y hY
      have h_eq := hQ_eq Y hY_D₀ hY_re
      rw [hS_id Y hY_H, hS_deriv Y hY_H] at h_eq
      simp only [one_pow, mul_one, one_mul] at h_eq
      have hQ_sqrt_le : Real.sqrt ‖Q Y‖ ≤ 1 := le_trans (hQ_dec Y hY_H hY_1) hY_rpow
      have hQ_le_one : ‖Q Y‖ ≤ 1 := by
        have h1 := pow_le_pow_left₀ (Real.sqrt_nonneg _) hQ_sqrt_le 2
        rwa [Real.sq_sqrt (norm_nonneg _), one_pow] at h1
      have h_norm_quarter : ‖(1 / 2 : ℂ) ^ 2 * Q Y‖ ≤ 1 / 4 := by
        rw [norm_mul]
        have hq : ‖(1 / 2 : ℂ) ^ 2‖ = (1 / 4 : ℝ) := by norm_num
        rw [hq]
        linarith
      have h_q_zero := (h_ker2_props ((1 / 2 : ℂ) ^ 2 * Q Y) h_norm_quarter).2 h_eq
      exact (mul_eq_zero.mp h_q_zero).resolve_left (by norm_num)
    have hQ_ev : Q =ᶠ[nhds z_star] (fun _ => (0 : ℂ)) :=
      Filter.eventuallyEq_of_mem
        (Metric.isOpen_ball.mem_nhds (Metric.mem_ball_self zero_lt_one)) hQ_ball_zero
    have hQ_eqOn :=
      (hQ_holo.analyticOnNhd hH_open).eqOn_of_preconnected_of_eventuallyEq
        analyticOnNhd_const hH_preconn hz_star_mem hQ_ev
    have hQ_negI : Q (-Complex.I) = 0 := hQ_eqOn hnegI_mem
    rw [hQ_negI, norm_zero, Real.sqrt_zero] at hQ_norm
    norm_num at hQ_norm

theorem superlinear_growth_exclusion (S : FiniteWallNonisotropicStrip)
    (hCone : ConePassageProp S)
    (hFirst : DeepFirstFieldModelProp S)
    (hSecond : DeepSecondFieldModelProp S)
    (hFinOrd : HasFiniteUpperGrowthOrder S) :
    CriticalUpperBoundProp S :=
by
  unfold CriticalUpperBoundProp
  by_contra! hNotCrit
  obtain ⟨P₀, K_init, hP₀_gt, hFin⟩ := hFinOrd
  obtain ⟨ε_bad, hε_bad_pos, hUnbdd⟩ := hNotCrit
  
  have h_period_nat : ∀ (n : ℕ) (s : ℂ), s ∈ horizStrip S.H →
      shapeModulus S (s + (((n : ℝ) * (2 * Real.pi) : ℝ) : ℂ)) = shapeModulus S s := by
    intro n
    induction n with
    | zero =>
      intro s _
      simp
    | succ n ih =>
      intro s hs
      have hs_n : s + (((n : ℝ) * (2 * Real.pi) : ℝ) : ℂ) ∈ horizStrip S.H := by
        simpa [horizStrip] using hs
      have h_step : s + ((((n + 1 : ℕ) : ℝ) * (2 * Real.pi) : ℝ) : ℂ) =
          (s + (((n : ℝ) * (2 * Real.pi) : ℝ) : ℂ)) + 2 * Real.pi := by
        push_cast
        ring
      rw [h_step]
      have hf := S.f_periodic (s + (((n : ℝ) * (2 * Real.pi) : ℝ) : ℂ)) hs_n
      have hq := S.q_periodic (s + (((n : ℝ) * (2 * Real.pi) : ℝ) : ℂ)) hs_n
      have h_eq :
          shapeModulus S ((s + (((n : ℝ) * (2 * Real.pi) : ℝ) : ℂ)) + 2 * Real.pi) =
            shapeModulus S (s + (((n : ℝ) * (2 * Real.pi) : ℝ) : ℂ)) := by
        simp only [shapeModulus, hf, hq]
      rw [h_eq, ih s hs]
  have h_period_int : ∀ (k : ℤ) (s : ℂ), s ∈ horizStrip S.H →
      shapeModulus S (s + (((k : ℝ) * (2 * Real.pi) : ℝ) : ℂ)) = shapeModulus S s := by
    intro k s hs
    rcases k with n | n
    · simpa using h_period_nat n s hs
    · set s' : ℂ := s + (((Int.negSucc n : ℝ) * (2 * Real.pi) : ℝ) : ℂ)
      have hs' : s' ∈ horizStrip S.H := by
        simpa [s', horizStrip] using hs
      have h_back : s' + ((((n + 1 : ℕ) : ℝ) * (2 * Real.pi) : ℝ) : ℂ) = s := by
        simp only [s', Int.cast_negSucc]
        push_cast
        ring
      have h1 := h_period_nat (n + 1) s' hs'
      rw [h_back] at h1
      exact h1.symm
  have h_mod_2pi : ∀ s : ℂ, s ∈ horizStrip S.H →
      ∃ x₀ ∈ Set.Icc (0 : ℝ) (2 * Real.pi),
        shapeModulus S s = shapeModulus S ((x₀ : ℂ) + (s.im : ℂ) * Complex.I) := by
    intro s hs
    have h2pi : (0 : ℝ) < 2 * Real.pi := by positivity
    let k : ℤ := ⌊s.re / (2 * Real.pi)⌋
    let x₀ : ℝ := s.re - (k : ℝ) * (2 * Real.pi)
    have hk_le : (k : ℝ) ≤ s.re / (2 * Real.pi) := Int.floor_le _
    have hk_lt : s.re / (2 * Real.pi) < (k : ℝ) + 1 := Int.lt_floor_add_one _
    have hx₀_nonneg : 0 ≤ x₀ := by
      have := (le_div_iff₀ h2pi).mp hk_le
      linarith
    have hx₀_le : x₀ ≤ 2 * Real.pi := by
      have := (div_lt_iff₀ h2pi).mp hk_lt
      linarith
    refine ⟨x₀, ⟨hx₀_nonneg, hx₀_le⟩, ?_⟩
    set s₀ : ℂ := (x₀ : ℂ) + (s.im : ℂ) * Complex.I
    have hs₀ : s₀ ∈ horizStrip S.H := by
      simpa [s₀, horizStrip] using hs
    have hs_eq : s₀ + (((k : ℝ) * (2 * Real.pi) : ℝ) : ℂ) = s := by
      apply Complex.ext
      · simp [s₀, x₀]
      · simp [s₀]
    rw [← hs_eq, h_period_int k s₀ hs₀]
  have hM_cont : ContinuousOn (shapeModulus S) (horizStrip S.H) := by
    have hf_c : ContinuousOn (fun s => ‖S.f s‖) (horizStrip S.H) :=
      continuous_norm.comp_continuousOn S.f_holo.continuousOn
    have hq_c : ContinuousOn (fun s => Real.sqrt ‖S.q s‖) (horizStrip S.H) :=
      (Real.continuous_sqrt.comp continuous_norm).comp_continuousOn S.q_holo.continuousOn
    exact ContinuousOn.sup hf_c hq_c
  
  let k₀ : ℝ := max (max K_init 1) (-Real.log (S.H / 2))
  have hk₀_ge_init : K_init ≤ k₀ := le_trans (le_max_left _ _) (le_max_left _ _)
  have hk₀_ge_one : 1 ≤ k₀ := le_trans (le_max_right _ _) (le_max_left _ _)
  have hexp_k₀_le : Real.exp (-k₀) ≤ S.H / 2 := by
    have h1 : -Real.log (S.H / 2) ≤ k₀ := le_max_right _ _
    calc Real.exp (-k₀) ≤ Real.exp (Real.log (S.H / 2)) := Real.exp_le_exp.mpr (by linarith)
      _ = S.H / 2 := Real.exp_log (by linarith [S.H_pos])
  have hre_ofReal : ∀ x y : ℝ, ((x : ℂ) + (y : ℂ) * Complex.I).re = x := fun x y => by simp
  have him_ofReal : ∀ x y : ℝ, ((x : ℂ) + (y : ℂ) * Complex.I).im = y := fun x y => by simp
  let γ : ℝ × ℝ → ℂ := fun p => (p.2 : ℂ) + ((S.H - Real.exp (-p.1) : ℝ) : ℂ) * Complex.I
  have hγ_cont : Continuous γ := by fun_prop
  have hγ_mem : ∀ k x : ℝ, k₀ ≤ k → γ (k, x) ∈ horizStrip S.H := by
    intro k x hk
    have hexp_le : Real.exp (-k) ≤ S.H / 2 :=
      le_trans (Real.exp_le_exp.mpr (by linarith)) hexp_k₀_le
    have hexp_pos : 0 < Real.exp (-k) := Real.exp_pos _
    have him : (γ (k, x)).im = S.H - Real.exp (-k) := him_ofReal x (S.H - Real.exp (-k))
    change |(γ (k, x)).im| < S.H
    rw [him, abs_lt]
    constructor <;> linarith [S.H_pos]
  let F_mod : ℝ × ℝ → ℝ := fun p => shapeModulus S (γ p)
  have hF_mod_cont : ContinuousOn F_mod { p : ℝ × ℝ | k₀ ≤ p.1 } := by
    refine hM_cont.comp hγ_cont.continuousOn ?_
    intro p hp
    exact hγ_mem p.1 p.2 hp
  have hF_mod_per : ∀ k x : ℝ, k₀ ≤ k →
      ∃ x₀ ∈ Set.Icc (0 : ℝ) (2 * Real.pi), F_mod (k, x) = F_mod (k, x₀) := by
    intro k x hk
    obtain ⟨x₀, hx₀, h_eq⟩ := h_mod_2pi (γ (k, x)) (hγ_mem k x hk)
    refine ⟨x₀, hx₀, ?_⟩
    have him : (γ (k, x)).im = S.H - Real.exp (-k) := him_ofReal x (S.H - Real.exp (-k))
    dsimp only [F_mod, γ]
    rwa [him] at h_eq
  have hF_mod_upper : ∀ k x : ℝ, k₀ ≤ k → F_mod (k, x) ≤ Real.exp (P₀ * k) := by
    intro k x hk
    have hexp_lt : Real.exp (-k) < S.H := by
      have : Real.exp (-k) ≤ S.H / 2 :=
        le_trans (Real.exp_le_exp.mpr (by linarith)) hexp_k₀_le
      linarith [S.H_pos]
    exact hFin k (le_trans hk₀_ge_init hk) hexp_lt x
  have hP₀_gt_bad : 1 + ε_bad < P₀ := by
    obtain ⟨T_star, hT_ge, _, x_star, hT_gt⟩ := hUnbdd k₀
    have hT_le : F_mod (T_star, x_star) ≤ Real.exp (P₀ * T_star) :=
      hF_mod_upper T_star x_star hT_ge
    have hexp_lt : Real.exp ((1 + ε_bad) * T_star) < Real.exp (P₀ * T_star) :=
      lt_of_lt_of_le hT_gt hT_le
    have hmul_lt : (1 + ε_bad) * T_star < P₀ * T_star := Real.exp_lt_exp.mp hexp_lt
    have hT_pos : 0 < T_star := lt_of_lt_of_le zero_lt_one (le_trans hk₀_ge_one hT_ge)
    exact lt_of_mul_lt_mul_right hmul_lt hT_pos.le
  let α₁ : ℝ := 1 + ε_bad / 3
  let α₂ : ℝ := 1 + 2 * ε_bad / 3
  let P : ℝ := P₀ + 1
  have h1_lt_α₁ : 1 < α₁ := by dsimp [α₁]; linarith
  have hα₁_lt_α₂ : α₁ < α₂ := by dsimp [α₁, α₂]; linarith
  have hα₂_lt_bad : α₂ < 1 + ε_bad := by dsimp [α₂]; linarith
  have hP₀_lt_P : P₀ < P := by dsimp [P]; linarith
  have hα₂_lt_P : α₂ < P := by linarith
  
  let Φ₁ : ℝ × ℝ → ℝ := fun p => F_mod p * Real.exp (-α₁ * p.1)
  let Φ₂ : ℝ × ℝ → ℝ := fun p => F_mod p * Real.exp (-P * p.1)
  have hΦ₁_cont : ContinuousOn Φ₁ { p : ℝ × ℝ | k₀ ≤ p.1 } :=
    hF_mod_cont.mul (by fun_prop)
  have hΦ₂_cont : ContinuousOn Φ₂ { p : ℝ × ℝ | k₀ ≤ p.1 } :=
    hF_mod_cont.mul (by fun_prop)
  have h_step_n : ∀ n : ℕ, ∃ k_n x_n : ℝ,
      k₀ + (n : ℝ) ≤ k_n ∧
      x_n ∈ Set.Icc (0 : ℝ) (2 * Real.pi) ∧
      Real.exp (α₂ * k_n) ≤ F_mod (k_n, x_n) ∧
      F_mod (k_n, x_n) ≤ Real.exp (P * k_n) ∧
      (∀ k x : ℝ, k₀ ≤ k → k ≤ k_n →
        F_mod (k, x) ≤ F_mod (k_n, x_n) * Real.exp (α₁ * (k - k_n))) ∧
      (∀ k x : ℝ, k_n ≤ k →
        F_mod (k, x) ≤ F_mod (k_n, x_n) * Real.exp (P * (k - k_n))) := by
    intro n
    have hn_nonneg : (0 : ℝ) ≤ (n : ℝ) := Nat.cast_nonneg n
    have h2pi_nonneg : (0 : ℝ) ≤ 2 * Real.pi := by positivity
    let Q_init : Set (ℝ × ℝ) :=
      Set.Icc k₀ (k₀ + (n : ℝ)) ×ˢ Set.Icc (0 : ℝ) (2 * Real.pi)
    have hQ_init_comp : IsCompact Q_init := isCompact_Icc.prod isCompact_Icc
    have hQ_init_ne : Q_init.Nonempty :=
      ⟨(k₀, 0), ⟨le_rfl, by linarith⟩, ⟨le_rfl, h2pi_nonneg⟩⟩
    have hQ_init_sub : Q_init ⊆ { p : ℝ × ℝ | k₀ ≤ p.1 } := fun _ hp => hp.1.1
    obtain ⟨p_init, _, hp_init_max⟩ :=
      hQ_init_comp.exists_isMaxOn hQ_init_ne (hΦ₁_cont.mono hQ_init_sub)
    let M_init : ℝ := max 1 (Φ₁ p_init)
    have hM_init_ge_one : 1 ≤ M_init := le_max_left _ _
    have hM_init_pos : 0 < M_init := lt_of_lt_of_le zero_lt_one hM_init_ge_one
    have hdiff_pos : 0 < α₂ - α₁ := sub_pos.mpr hα₁_lt_α₂
    let K_wit : ℝ := max (k₀ + (n : ℝ)) ((Real.log M_init + 1) / (α₂ - α₁))
    obtain ⟨T_n, hT_ge_wit, _, x_raw, hT_raw⟩ := hUnbdd K_wit
    have hT_ge_kn : k₀ + (n : ℝ) ≤ T_n := le_trans (le_max_left _ _) hT_ge_wit
    have hT_ge_k₀ : k₀ ≤ T_n := by linarith
    have hT_pos : 0 < T_n := lt_of_lt_of_le zero_lt_one (le_trans hk₀_ge_one hT_ge_k₀)
    obtain ⟨x_wit, hx_wit_mem, hx_wit_eq⟩ := hF_mod_per T_n x_raw hT_ge_k₀
    have hF_T_gt : Real.exp (α₂ * T_n) < F_mod (T_n, x_wit) := by
      have h1 : Real.exp (α₂ * T_n) < Real.exp ((1 + ε_bad) * T_n) :=
        Real.exp_lt_exp.mpr (mul_lt_mul_of_pos_right hα₂_lt_bad hT_pos)
      have h2 : Real.exp ((1 + ε_bad) * T_n) < F_mod (T_n, x_raw) := hT_raw
      linarith [hx_wit_eq]
    have hΦ₁_T_gt_exp : Real.exp ((α₂ - α₁) * T_n) < Φ₁ (T_n, x_wit) := by
      have hmul := mul_lt_mul_of_pos_right hF_T_gt (Real.exp_pos (-α₁ * T_n))
      have hexp_eq : Real.exp (α₂ * T_n) * Real.exp (-α₁ * T_n) =
          Real.exp ((α₂ - α₁) * T_n) := by
        rw [← Real.exp_add]
        ring_nf
      rwa [hexp_eq] at hmul
    have hΦ₁_T_gt_M : M_init < Φ₁ (T_n, x_wit) := by
      have h_div : (Real.log M_init + 1) / (α₂ - α₁) ≤ T_n :=
        le_trans (le_max_right _ _) hT_ge_wit
      have h_log_le : Real.log M_init + 1 ≤ (α₂ - α₁) * T_n := by
        have := (div_le_iff₀ hdiff_pos).mp h_div
        linarith
      have hexp1 : 1 < Real.exp 1 := Real.one_lt_exp_iff.mpr zero_lt_one
      calc M_init = M_init * 1 := (mul_one M_init).symm
        _ < M_init * Real.exp 1 := mul_lt_mul_of_pos_left hexp1 hM_init_pos
        _ = Real.exp (Real.log M_init + 1) := by
            rw [Real.exp_add, Real.exp_log hM_init_pos]
        _ ≤ Real.exp ((α₂ - α₁) * T_n) := Real.exp_le_exp.mpr h_log_le
        _ < Φ₁ (T_n, x_wit) := hΦ₁_T_gt_exp
    let Q₁ : Set (ℝ × ℝ) := Set.Icc k₀ T_n ×ˢ Set.Icc (0 : ℝ) (2 * Real.pi)
    have hQ₁_comp : IsCompact Q₁ := isCompact_Icc.prod isCompact_Icc
    have hQ₁_ne : Q₁.Nonempty := ⟨(k₀, 0), ⟨le_rfl, hT_ge_k₀⟩, ⟨le_rfl, h2pi_nonneg⟩⟩
    have hQ₁_sub : Q₁ ⊆ { p : ℝ × ℝ | k₀ ≤ p.1 } := fun _ hp => hp.1.1
    obtain ⟨⟨r_n, y_n⟩, ⟨⟨hr_lo, hr_hi⟩, hy_mem⟩, hp₁_max⟩ :=
      hQ₁_comp.exists_isMaxOn hQ₁_ne (hΦ₁_cont.mono hQ₁_sub)
    have hT_mem_Q₁ : (T_n, x_wit) ∈ Q₁ := ⟨⟨hT_ge_k₀, le_rfl⟩, hx_wit_mem⟩
    have hΦ₁_T_le_r : Φ₁ (T_n, x_wit) ≤ Φ₁ (r_n, y_n) := hp₁_max hT_mem_Q₁
    have hr_gt_kn : k₀ + (n : ℝ) < r_n := by
      by_contra h_le
      push Not at h_le
      have h_in_init : (r_n, y_n) ∈ Q_init := ⟨⟨hr_lo, h_le⟩, hy_mem⟩
      have h1 : Φ₁ (r_n, y_n) ≤ Φ₁ p_init := hp_init_max h_in_init
      have h2 : Φ₁ p_init ≤ M_init := le_max_right _ _
      linarith
    have hF_r_gt : Real.exp (α₂ * r_n) < F_mod (r_n, y_n) := by
      have hexp_le : Real.exp ((α₂ - α₁) * r_n) ≤ Real.exp ((α₂ - α₁) * T_n) :=
        Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_left hr_hi hdiff_pos.le)
      have h1 : Real.exp ((α₂ - α₁) * r_n) < Φ₁ (r_n, y_n) :=
        lt_of_le_of_lt hexp_le (lt_of_lt_of_le hΦ₁_T_gt_exp hΦ₁_T_le_r)
      have hmul := mul_lt_mul_of_pos_right h1 (Real.exp_pos (α₁ * r_n))
      have hlhs : Real.exp ((α₂ - α₁) * r_n) * Real.exp (α₁ * r_n) = Real.exp (α₂ * r_n) := by
        rw [← Real.exp_add]
        ring_nf
      have hrhs : Φ₁ (r_n, y_n) * Real.exp (α₁ * r_n) = F_mod (r_n, y_n) := by
        dsimp [Φ₁]
        rw [mul_assoc, ← Real.exp_add]
        have : -α₁ * r_n + α₁ * r_n = 0 := by ring
        rw [this, Real.exp_zero, mul_one]
      rwa [hlhs, hrhs] at hmul
    let μ_n : ℝ := Φ₂ (r_n, y_n)
    have hμ_pos : 0 < μ_n := by
      dsimp [μ_n, Φ₂]
      exact mul_pos (lt_trans (Real.exp_pos _) hF_r_gt) (Real.exp_pos _)
    let K_cut : ℝ := max r_n (-Real.log μ_n + 1)
    let Q₂ : Set (ℝ × ℝ) := Set.Icc r_n K_cut ×ˢ Set.Icc (0 : ℝ) (2 * Real.pi)
    have hQ₂_comp : IsCompact Q₂ := isCompact_Icc.prod isCompact_Icc
    have hQ₂_ne : Q₂.Nonempty := ⟨(r_n, 0), ⟨le_rfl, le_max_left _ _⟩, ⟨le_rfl, h2pi_nonneg⟩⟩
    have hQ₂_sub : Q₂ ⊆ { p : ℝ × ℝ | k₀ ≤ p.1 } :=
      fun _ hp => le_trans hr_lo hp.1.1
    obtain ⟨⟨k_n, x_n⟩, ⟨⟨hk_ge_r, _⟩, hx_n_mem⟩, hp₂_max⟩ :=
      hQ₂_comp.exists_isMaxOn hQ₂_ne (hΦ₂_cont.mono hQ₂_sub)
    have hr_mem_Q₂ : (r_n, y_n) ∈ Q₂ := ⟨⟨le_rfl, le_max_left _ _⟩, hy_mem⟩
    have hμ_le_kn : μ_n ≤ Φ₂ (k_n, x_n) := hp₂_max hr_mem_Q₂
    have hk_n_ge_k₀ : k₀ ≤ k_n := le_trans hr_lo hk_ge_r
    have h_tail_Φ₂ : ∀ k x : ℝ, r_n ≤ k → Φ₂ (k, x) ≤ Φ₂ (k_n, x_n) := by
      intro k x hk_r
      have hk_k₀ : k₀ ≤ k := le_trans hr_lo hk_r
      obtain ⟨x₀, hx₀_mem, hx₀_eq⟩ := hF_mod_per k x hk_k₀
      have hΦ₂_eq : Φ₂ (k, x) = Φ₂ (k, x₀) := by dsimp [Φ₂]; rw [hx₀_eq]
      rw [hΦ₂_eq]
      by_cases hk_le : k ≤ K_cut
      · exact hp₂_max ⟨⟨hk_r, hk_le⟩, hx₀_mem⟩
      · push Not at hk_le
        have hk_gt_log : -Real.log μ_n + 1 < k :=
          lt_of_le_of_lt (le_max_right _ _) hk_le
        have hF_up : F_mod (k, x₀) ≤ Real.exp (P₀ * k) := hF_mod_upper k x₀ hk_k₀
        have hΦ₂_le_exp : Φ₂ (k, x₀) ≤ Real.exp (-k) := by
          calc Φ₂ (k, x₀) = F_mod (k, x₀) * Real.exp (-P * k) := rfl
            _ ≤ Real.exp (P₀ * k) * Real.exp (-P * k) :=
                mul_le_mul_of_nonneg_right hF_up (Real.exp_pos _).le
            _ = Real.exp (-k) := by
                rw [← Real.exp_add]
                dsimp [P]
                ring_nf
        have hexp_lt_μ : Real.exp (-k) < μ_n := by
          calc Real.exp (-k) < Real.exp (Real.log μ_n) := Real.exp_lt_exp.mpr (by linarith)
            _ = μ_n := Real.exp_log hμ_pos
        exact le_trans hΦ₂_le_exp (le_trans hexp_lt_μ.le hμ_le_kn)
    have h_tail_F : ∀ k x : ℝ, r_n ≤ k →
        F_mod (k, x) ≤ F_mod (k_n, x_n) * Real.exp (P * (k - k_n)) := by
      intro k x hk_r
      have hmul := mul_le_mul_of_nonneg_right (h_tail_Φ₂ k x hk_r) (Real.exp_pos (P * k)).le
      have hlhs : Φ₂ (k, x) * Real.exp (P * k) = F_mod (k, x) := by
        dsimp [Φ₂]
        rw [mul_assoc, ← Real.exp_add]
        have : -P * k + P * k = 0 := by ring
        rw [this, Real.exp_zero, mul_one]
      have hrhs : Φ₂ (k_n, x_n) * Real.exp (P * k) =
          F_mod (k_n, x_n) * Real.exp (P * (k - k_n)) := by
        dsimp [Φ₂]
        rw [mul_assoc, ← Real.exp_add]
        congr 2
        ring
      rwa [hlhs, hrhs] at hmul
    refine ⟨k_n, x_n, by linarith, hx_n_mem, ?_, ?_, ?_, ?_⟩
    · 
      have h1 : Real.exp (α₂ * r_n - P * r_n) < μ_n := by
        dsimp [μ_n, Φ₂]
        have hmul := mul_lt_mul_of_pos_right hF_r_gt (Real.exp_pos (-P * r_n))
        have hexp_eq : Real.exp (α₂ * r_n) * Real.exp (-P * r_n) =
            Real.exp (α₂ * r_n - P * r_n) := by
          rw [← Real.exp_add]
          congr 1
          ring
        rwa [hexp_eq] at hmul
      have h2 : Real.exp (α₂ * r_n - P * r_n) < Φ₂ (k_n, x_n) :=
        lt_of_lt_of_le h1 hμ_le_kn
      have hmul := mul_lt_mul_of_pos_right h2 (Real.exp_pos (P * k_n))
      have hlhs : Real.exp (α₂ * r_n - P * r_n) * Real.exp (P * k_n) =
          Real.exp (α₂ * r_n + P * (k_n - r_n)) := by
        rw [← Real.exp_add]
        ring_nf
      have hrhs : Φ₂ (k_n, x_n) * Real.exp (P * k_n) = F_mod (k_n, x_n) := by
        dsimp [Φ₂]
        rw [mul_assoc, ← Real.exp_add]
        have : -P * k_n + P * k_n = 0 := by ring
        rw [this, Real.exp_zero, mul_one]
      rw [hlhs, hrhs] at hmul
      have hexp_mono : Real.exp (α₂ * k_n) ≤ Real.exp (α₂ * r_n + P * (k_n - r_n)) := by
        apply Real.exp_le_exp.mpr
        nlinarith [hα₂_lt_P, hk_ge_r]
      exact le_trans hexp_mono hmul.le
    · 
      have hkn_pos : 0 < k_n := lt_of_lt_of_le zero_lt_one (le_trans hk₀_ge_one hk_n_ge_k₀)
      exact le_trans (hF_mod_upper k_n x_n hk_n_ge_k₀)
        (Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_right hP₀_lt_P.le hkn_pos.le))
    · 
      intro k x hk_lo hk_hi
      have hM_nonneg : 0 ≤ F_mod (k_n, x_n) := by
        dsimp [F_mod, shapeModulus]
        exact le_trans (norm_nonneg _) (le_max_left _ _)
      by_cases hk_r : r_n ≤ k
      · have h1 := h_tail_F k x hk_r
        have hexp_le : Real.exp (P * (k - k_n)) ≤ Real.exp (α₁ * (k - k_n)) := by
          apply Real.exp_le_exp.mpr
          nlinarith [hα₁_lt_α₂, hα₂_lt_P, hk_hi]
        exact le_trans h1 (mul_le_mul_of_nonneg_left hexp_le hM_nonneg)
      · push Not at hk_r
        obtain ⟨x₀, hx₀_mem, hx₀_eq⟩ := hF_mod_per k x hk_lo
        rw [hx₀_eq]
        have hk_mem_Q₁ : (k, x₀) ∈ Q₁ := ⟨⟨hk_lo, le_trans hk_r.le hr_hi⟩, hx₀_mem⟩
        have h1 : Φ₁ (k, x₀) ≤ Φ₁ (r_n, y_n) := hp₁_max hk_mem_Q₁
        have hmul1 := mul_le_mul_of_nonneg_right h1 (Real.exp_pos (α₁ * k)).le
        have hlhs1 : Φ₁ (k, x₀) * Real.exp (α₁ * k) = F_mod (k, x₀) := by
          dsimp [Φ₁]
          rw [mul_assoc, ← Real.exp_add]
          have : -α₁ * k + α₁ * k = 0 := by ring
          rw [this, Real.exp_zero, mul_one]
        have hrhs1 : Φ₁ (r_n, y_n) * Real.exp (α₁ * k) =
            F_mod (r_n, y_n) * Real.exp (α₁ * (k - r_n)) := by
          dsimp [Φ₁]
          rw [mul_assoc, ← Real.exp_add]
          congr 2
          ring
        rw [hlhs1, hrhs1] at hmul1
        have hr_bound : F_mod (r_n, y_n) ≤ F_mod (k_n, x_n) * Real.exp (P * (r_n - k_n)) :=
          h_tail_F r_n y_n le_rfl
        have hcomb : F_mod (k, x₀) ≤
            F_mod (k_n, x_n) * Real.exp (P * (r_n - k_n) + α₁ * (k - r_n)) := by
          calc F_mod (k, x₀)
              ≤ F_mod (r_n, y_n) * Real.exp (α₁ * (k - r_n)) := hmul1
            _ ≤ (F_mod (k_n, x_n) * Real.exp (P * (r_n - k_n))) *
                  Real.exp (α₁ * (k - r_n)) :=
                mul_le_mul_of_nonneg_right hr_bound (Real.exp_pos _).le
            _ = F_mod (k_n, x_n) * Real.exp (P * (r_n - k_n) + α₁ * (k - r_n)) := by
                rw [mul_assoc, ← Real.exp_add]
        have hexp_le : Real.exp (P * (r_n - k_n) + α₁ * (k - r_n)) ≤
            Real.exp (α₁ * (k - k_n)) := by
          apply Real.exp_le_exp.mpr
          nlinarith [hα₁_lt_α₂, hα₂_lt_P, hk_ge_r]
        exact le_trans hcomb (mul_le_mul_of_nonneg_left hexp_le hM_nonneg)
    · 
      intro k x hk_ge_kn
      exact h_tail_F k x (le_trans hk_ge_r hk_ge_kn)
  
  choose k_seq x_max hk_seq using h_step_n
  let d_seq : ℕ → ℝ := fun n => Real.exp (-k_seq n)
  let m_seq : ℕ → ℝ := fun n => F_mod (k_seq n, x_max n)
  have hm_seq_ge_one : ∀ n : ℕ, 1 ≤ m_seq n := by
    intro n
    have hk_ge_one : 1 ≤ k_seq n := by
      have h1 := (hk_seq n).1
      have h2 : (0 : ℝ) ≤ (n : ℝ) := Nat.cast_nonneg n
      linarith
    have hα₂_pos : 0 < α₂ * k_seq n := by nlinarith
    exact le_trans (Real.one_le_exp hα₂_pos.le) (hk_seq n).2.2.1
  have hs_eq_γ : ∀ s : ℂ, 0 < wallDepth S s →
      s = γ (-Real.log (wallDepth S s), s.re) := by
    intro s hδ_pos
    have hexp_eq : Real.exp (- -Real.log (wallDepth S s)) = wallDepth S s := by
      rw [neg_neg, Real.exp_log hδ_pos]
    dsimp only [γ]
    rw [hexp_eq]
    apply Complex.ext
    · exact (hre_ofReal s.re (S.H - wallDepth S s)).symm
    · rw [him_ofReal]
      unfold wallDepth
      ring
  have hrpow_exp_eq : ∀ (n : ℕ) (δ β : ℝ), 0 < δ →
      (d_seq n / δ) ^ β = Real.exp (β * (-Real.log δ - k_seq n)) := by
    intro n δ β hδ_pos
    have hd_pos : 0 < d_seq n := Real.exp_pos _
    rw [Real.rpow_def_of_pos (div_pos hd_pos hδ_pos) β, Real.log_div hd_pos.ne' hδ_pos.ne']
    dsimp [d_seq]
    rw [Real.log_exp]
    congr 1
    ring
  let R : SuperlinearRecordScales S :=
    { α₁ := α₁
      α₂ := α₂
      P := P
      k₀ := k₀
      one_lt_α₁ := h1_lt_α₁
      α₁_lt_α₂ := hα₁_lt_α₂
      α₂_lt_P := hα₂_lt_P
      one_le_k₀ := hk₀_ge_one
      exp_neg_k₀_le_half_H := hexp_k₀_le
      k_seq := k_seq
      d_seq := d_seq
      m_seq := m_seq
      x_max := x_max
      k_seq_ge := fun n => (hk_seq n).1
      d_seq_eq := fun _ => rfl
      m_seq_pos := hm_seq_ge_one
      m_seq_lower := fun n => (hk_seq n).2.2.1
      m_seq_upper := fun n => (hk_seq n).2.2.2.1
      x_max_mem := fun n => (hk_seq n).2.1
      x_max_attains := fun _ => rfl
      coarse_tail_bound := by
        intro n s hd_lo hd_hi
        have hδ_pos : 0 < wallDepth S s := lt_of_lt_of_le (Real.exp_pos _) hd_lo
        let k : ℝ := -Real.log (wallDepth S s)
        have hk_lo : k₀ ≤ k := by
          have hlog := Real.log_le_log hδ_pos hd_hi
          rw [Real.log_exp] at hlog
          dsimp [k]
          linarith
        have hk_hi : k ≤ k_seq n := by
          have hlog := Real.log_le_log (Real.exp_pos _) hd_lo
          rw [Real.log_exp] at hlog
          dsimp [k]
          linarith
        have hs_eq : shapeModulus S s = F_mod (k, s.re) := by
          dsimp [F_mod, k]
          rw [← hs_eq_γ s hδ_pos]
        rw [hs_eq, hrpow_exp_eq n (wallDepth S s) α₁ hδ_pos]
        exact (hk_seq n).2.2.2.2.1 k s.re hk_lo hk_hi
      fine_cap_bound := by
        intro n s hδ_pos hd_hi
        let k : ℝ := -Real.log (wallDepth S s)
        have hk_lo : k_seq n ≤ k := by
          have hlog := Real.log_le_log hδ_pos hd_hi
          dsimp [d_seq] at hlog
          rw [Real.log_exp] at hlog
          dsimp [k]
          linarith
        have hs_eq : shapeModulus S s = F_mod (k, s.re) := by
          dsimp [F_mod, k]
          rw [← hs_eq_γ s hδ_pos]
        rw [hs_eq, hrpow_exp_eq n (wallDepth S s) P hδ_pos]
        exact (hk_seq n).2.2.2.2.2 k s.re hk_lo }
  
  have hNoAllF : ∀ (φ : ℕ → ℕ), StrictMono φ → ∀ c₀ : ℝ, 0 < c₀ →
      ¬ ∀ k : ℕ, ∀ x : ℝ, ∃ Z ∈ Metric.closedBall (-Complex.I) (1 / 8),
        c₀ ≤ ‖superlinearRescaledF S x (R.d_seq (φ k)) (R.m_seq (φ k)) Z‖ :=
    fun φ hφ c₀ hc₀ hAll => superlinear_all_first_field_exclusion S R φ c₀ hφ hc₀ hAll
  obtain ⟨hPure, φ, x_quiet, hφ, hF0, hQ0⟩ :=
    superlinear_quiet_center_from_no_all_first S R hNoAllF
  obtain ⟨L⟩ :=
    superlinear_width_and_limiting_lift S hCone hFirst hSecond R hPure φ x_quiet hφ hF0 hQ0
  exact superlinear_halfplane_rigidity_contradiction R.α₁ R.one_lt_α₁ L

theorem noncritical_and_entire_growth_exclusion : (∀ E : EntireNonisotropicStrip, False) ∧
      (∀ S : FiniteWallNonisotropicStrip, CriticalWallData S) :=
by
  obtain ⟨hExpFin, hExpEnt⟩ := exponential_profile_obstruction
  obtain ⟨hNoEnt, hLogAndFin⟩ := log_deficit_and_infinite_growth_exclusion
  refine ⟨fun E => hNoEnt E (hExpEnt E), fun S => ?_⟩
  obtain ⟨hCone, hFirst, hSecond⟩ := cone_passage_and_pure_models S
  obtain ⟨hLogDef, hFinOrd⟩ := hLogAndFin S (hExpFin S)
  have hUpper : CriticalUpperBoundProp S :=
    superlinear_growth_exclusion S hCone hFirst hSecond hFinOrd
  
  have h_period_nat : ∀ (n : ℕ) (s : ℂ), s ∈ horizStrip S.H →
      shapeModulus S (s + (((n : ℝ) * (2 * Real.pi) : ℝ) : ℂ)) = shapeModulus S s := by
    intro n
    induction n with
    | zero =>
      intro s _
      simp
    | succ n ih =>
      intro s hs
      have hs_n : s + (((n : ℝ) * (2 * Real.pi) : ℝ) : ℂ) ∈ horizStrip S.H := by
        simpa [horizStrip] using hs
      have h_step : s + ((((n + 1 : ℕ) : ℝ) * (2 * Real.pi) : ℝ) : ℂ) =
          (s + (((n : ℝ) * (2 * Real.pi) : ℝ) : ℂ)) + 2 * Real.pi := by
        push_cast
        ring
      rw [h_step]
      have hf := S.f_periodic (s + (((n : ℝ) * (2 * Real.pi) : ℝ) : ℂ)) hs_n
      have hq := S.q_periodic (s + (((n : ℝ) * (2 * Real.pi) : ℝ) : ℂ)) hs_n
      have h_eq :
          shapeModulus S ((s + (((n : ℝ) * (2 * Real.pi) : ℝ) : ℂ)) + 2 * Real.pi) =
            shapeModulus S (s + (((n : ℝ) * (2 * Real.pi) : ℝ) : ℂ)) := by
        simp only [shapeModulus, hf, hq]
      rw [h_eq, ih s hs]
  have h_period_int : ∀ (k : ℤ) (s : ℂ), s ∈ horizStrip S.H →
      shapeModulus S (s + (((k : ℝ) * (2 * Real.pi) : ℝ) : ℂ)) = shapeModulus S s := by
    intro k s hs
    rcases k with n | n
    · simpa using h_period_nat n s hs
    · set s' : ℂ := s + (((Int.negSucc n : ℝ) * (2 * Real.pi) : ℝ) : ℂ)
      have hs' : s' ∈ horizStrip S.H := by
        simpa [s', horizStrip] using hs
      have h_back : s' + ((((n + 1 : ℕ) : ℝ) * (2 * Real.pi) : ℝ) : ℂ) = s := by
        simp only [s', Int.cast_negSucc]
        push_cast
        ring
      have h1 := h_period_nat (n + 1) s' hs'
      rw [h_back] at h1
      exact h1.symm
  have h_mod_2pi : ∀ s : ℂ, s ∈ horizStrip S.H →
      ∃ x₀ ∈ Set.Icc (0 : ℝ) (2 * Real.pi),
        shapeModulus S s = shapeModulus S ((x₀ : ℂ) + (s.im : ℂ) * Complex.I) := by
    intro s hs
    have h2pi : (0 : ℝ) < 2 * Real.pi := by positivity
    let k : ℤ := ⌊s.re / (2 * Real.pi)⌋
    let x₀ : ℝ := s.re - (k : ℝ) * (2 * Real.pi)
    have hk_le : (k : ℝ) ≤ s.re / (2 * Real.pi) := Int.floor_le _
    have hk_lt : s.re / (2 * Real.pi) < (k : ℝ) + 1 := Int.lt_floor_add_one _
    have hx₀_nonneg : 0 ≤ x₀ := by
      have := (le_div_iff₀ h2pi).mp hk_le
      linarith
    have hx₀_le : x₀ ≤ 2 * Real.pi := by
      have := (div_lt_iff₀ h2pi).mp hk_lt
      linarith
    refine ⟨x₀, ⟨hx₀_nonneg, hx₀_le⟩, ?_⟩
    set s₀ : ℂ := (x₀ : ℂ) + (s.im : ℂ) * Complex.I
    have hs₀ : s₀ ∈ horizStrip S.H := by
      simpa [s₀, horizStrip] using hs
    have hs_eq : s₀ + (((k : ℝ) * (2 * Real.pi) : ℝ) : ℂ) = s := by
      apply Complex.ext
      · simp [s₀, x₀]
      · simp [s₀]
    rw [← hs_eq, h_period_int k s₀ hs₀]
  
  have h_slab_bdd : ∀ a b : ℝ, 0 < a → a ≤ b → b < S.H →
      ∃ M : ℝ, 1 ≤ M ∧ ∀ s : ℂ, a ≤ wallDepth S s → wallDepth S s ≤ b →
        shapeModulus S s ≤ M := by
    intro a b ha hab hbH
    let R : Set (ℝ × ℝ) := Set.Icc (0 : ℝ) (2 * Real.pi) ×ˢ Set.Icc (S.H - b) (S.H - a)
    have hR_comp : IsCompact R := isCompact_Icc.prod isCompact_Icc
    have hR_ne : R.Nonempty :=
      ⟨(0, S.H - b), ⟨le_rfl, by positivity⟩, ⟨le_rfl, by linarith⟩⟩
    let φ : ℝ × ℝ → ℂ := fun p => (p.1 : ℂ) + (p.2 : ℂ) * Complex.I
    have hφ_cont : Continuous φ := by fun_prop
    have hφ_maps : Set.MapsTo φ R (horizStrip S.H) := by
      intro p hp
      rcases hp with ⟨_, hp2_lo, hp2_hi⟩
      have him : (φ p).im = p.2 := by simp [φ]
      change |(φ p).im| < S.H
      rw [him, abs_lt]
      constructor <;> linarith [S.H_pos]
    have hM_cont : ContinuousOn (shapeModulus S) (horizStrip S.H) := by
      have hf_c : ContinuousOn (fun s => ‖S.f s‖) (horizStrip S.H) :=
        continuous_norm.comp_continuousOn S.f_holo.continuousOn
      have hq_c : ContinuousOn (fun s => Real.sqrt ‖S.q s‖) (horizStrip S.H) :=
        (Real.continuous_sqrt.comp continuous_norm).comp_continuousOn S.q_holo.continuousOn
      exact ContinuousOn.sup hf_c hq_c
    have hcomp_cont : ContinuousOn (fun p => shapeModulus S (φ p)) R :=
      hM_cont.comp hφ_cont.continuousOn hφ_maps
    obtain ⟨p_max, _, hp_max⟩ := hR_comp.exists_isMaxOn hR_ne hcomp_cont
    refine ⟨max (shapeModulus S (φ p_max)) 1, le_max_right _ _, ?_⟩
    intro s hsa hsb
    have hs_mem : s ∈ horizStrip S.H := by
      change |s.im| < S.H
      rw [abs_lt]
      unfold wallDepth at hsa hsb
      constructor <;> linarith [S.H_pos]
    obtain ⟨x₀, hx₀, hs_mod⟩ := h_mod_2pi s hs_mem
    have hp_mem : (x₀, s.im) ∈ R := by
      refine ⟨hx₀, ?_⟩
      unfold wallDepth at hsa hsb
      exact ⟨by linarith, by linarith⟩
    rw [hs_mod]
    exact le_trans (hp_max hp_mem) (le_max_left _ _)
  
  let δ_b : ℝ := min (min (S.H / 3) ((S.H - S.s_star) / 2)) 1
  have hδb_pos : 0 < δ_b := by
    refine lt_min (lt_min ?_ ?_) zero_lt_one
    · linarith [S.H_pos]
    · linarith [S.s_star_lt_H]
  have hδb_le_one : δ_b ≤ 1 := min_le_right _ _
  have hδb_le_third : δ_b ≤ S.H / 3 := le_trans (min_le_left _ _) (min_le_left _ _)
  have hδb_lt_half : δ_b < S.H / 2 := by linarith [S.H_pos]
  have hδb_lt_diff : δ_b < S.H - S.s_star := by
    have : δ_b ≤ (S.H - S.s_star) / 2 := le_trans (min_le_left _ _) (min_le_right _ _)
    linarith [S.s_star_lt_H]
  have h_obs : ∀ α : ℝ, 1 / 2 < α → α < 1 →
      ∃ L ε₀ d_lim : ℝ, 0 < L ∧ 0 < ε₀ ∧ 0 < d_lim ∧
        ∀ d x₀ : ℝ, 0 < d → d < d_lim →
          ∃ s : ℂ, d / 100 ≤ wallDepth S s ∧ wallDepth S s ≤ δ_b ∧
            |s.re - x₀| ≤ L * wallDepth S s ∧
            ε₀ < 20 * ((d / 10) / wallDepth S s) ^ (1 - α) *
              (wallDepth S s * shapeModulus S s) := by
    intro α hα1 hα2
    obtain ⟨L, δ_star, hL_pos, hδs_pos, hδs_lt, hConeK⟩ :=
      hCone α 50 δ_b hα1 hα2 (by norm_num) hδb_pos hδb_lt_half
    obtain ⟨C_cp, ε₀, d₀_cp, _, hε₀_pos, hd₀_cp_pos, hPassage⟩ :=
      hConeK 20 (by norm_num)
    obtain ⟨d₀_obs, hd₀_obs_pos, hNoPass⟩ :=
      S.no_full_scale_cone_passage δ_star hδs_pos (lt_trans hδs_lt hδb_lt_diff)
    let d_lim : ℝ := min d₀_obs (10 * d₀_cp)
    have hd_lim_pos : 0 < d_lim := lt_min hd₀_obs_pos (by positivity)
    refine ⟨L, ε₀, d_lim, hL_pos, hε₀_pos, hd_lim_pos, ?_⟩
    intro d x₀ hd_pos hd_lt
    have hd_obs : d < d₀_obs := lt_of_lt_of_le hd_lt (min_le_left _ _)
    have hd_cp : d / 10 < d₀_cp := by
      have : d < 10 * d₀_cp := lt_of_lt_of_le hd_lt (min_le_right _ _)
      linarith
    have h_not_all : ¬ ∀ s : ℂ, (d / 10) / 10 ≤ wallDepth S s → wallDepth S s ≤ δ_b →
        |s.re - x₀| ≤ L * wallDepth S s →
        (2 * d) * shapeModulus S s ≤ ε₀ * ((d / 10) / wallDepth S s) ^ α := by
      intro hAll
      obtain ⟨s_tilde, hs_holo, hs_props⟩ :=
        hPassage (d / 10) x₀ (2 * d) ε₀ (by positivity) hd_cp (by positivity)
          (by linarith) hε₀_pos le_rfl hAll
      have h_sub : ∀ p : ℂ × ℂ, d / 10 < S.H - p.1.im → ‖p.2‖ < 2 * d →
          ‖p.2‖ < (2 * d) * ((S.H - p.1.im) / (d / 10)) ^ α := by
        intro p hp1 hp4
        have h_one_le : 1 ≤ (S.H - p.1.im) / (d / 10) :=
          (one_le_div (by positivity)).mpr hp1.le
        have h_rpow : 1 ≤ ((S.H - p.1.im) / (d / 10)) ^ α :=
          Real.one_le_rpow h_one_le (by linarith)
        nlinarith
      refine hNoPass d x₀ hd_pos hd_obs ⟨s_tilde, ?_, ?_, 2 * d, by positivity, ?_⟩
      · refine hs_holo.mono ?_
        intro p hp
        exact ⟨hp.1, hp.2.1, hp.2.2.1, h_sub p hp.1 hp.2.2.2⟩
      · intro p hp1 hp2 hp3 hp4
        exact (hs_props p hp1 hp2 hp3 (h_sub p hp1 hp4)).1
      · intro p hp1 hp2 hp_half hp3 _ hp4
        have h_in := hs_props p hp1 hp2 hp3 (h_sub p hp1 hp4)
        exact h_in.2.2.2.2 (h_in.2.2.2.1 hp_half)
    push Not at h_not_all
    obtain ⟨s, hs_lo, hs_hi, hs_re, hs_gt⟩ := h_not_all
    have hs_lo' : d / 100 ≤ wallDepth S s := by linarith
    have hδ_pos : 0 < wallDepth S s := lt_of_lt_of_le (by positivity) hs_lo'
    let u : ℝ := (d / 10) / wallDepth S s
    have hu_pos : 0 < u := by positivity
    have hu_split : u = u ^ α * u ^ (1 - α) := by
      calc u = u ^ (1 : ℝ) := (Real.rpow_one u).symm
        _ = u ^ (α + (1 - α)) := by ring_nf
        _ = u ^ α * u ^ (1 - α) := Real.rpow_add hu_pos α (1 - α)
    have h2d_eq : 2 * d = 20 * u * wallDepth S s := by
      dsimp [u]
      field_simp [hδ_pos.ne']
      ring
    have huα_pos : 0 < u ^ α := Real.rpow_pos_of_pos hu_pos α
    have hs_gt' : u ^ α * ε₀ <
        u ^ α * (20 * u ^ (1 - α) * (wallDepth S s * shapeModulus S s)) := by
      calc u ^ α * ε₀ = ε₀ * u ^ α := mul_comm _ _
        _ < (2 * d) * shapeModulus S s := hs_gt
        _ = (20 * u * wallDepth S s) * shapeModulus S s := by rw [h2d_eq]
        _ = (20 * (u ^ α * u ^ (1 - α)) * wallDepth S s) * shapeModulus S s := by
            rw [← hu_split]
        _ = u ^ α * (20 * u ^ (1 - α) * (wallDepth S s * shapeModulus S s)) := by ring
    exact ⟨s, hs_lo', hs_hi, hs_re, lt_of_mul_lt_mul_left hs_gt' huα_pos.le⟩
  
  have hLower : ∀ ε : ℝ, 0 < ε → ∀ K₀ : ℝ, ∃ k : ℝ, K₀ ≤ k ∧
      Real.exp (-k) < S.H ∧
      ∃ x ∈ Set.Icc (0 : ℝ) (2 * Real.pi),
        Real.exp ((1 - ε) * k) ≤
          shapeModulus S ((x : ℂ) + ((S.H - Real.exp (-k) : ℝ) : ℂ) * Complex.I) := by
    intro ε hε_pos K₀
    by_contra! h_contra
    let ε' : ℝ := min ε (1 / 2)
    have hε'_pos : 0 < ε' := lt_min hε_pos (by norm_num)
    have hε'_le_ε : ε' ≤ ε := min_le_left _ _
    have hε'_le_half : ε' ≤ 1 / 2 := min_le_right _ _
    let p₀ : ℝ := 1 - ε'
    let α : ℝ := 1 - ε' / 2
    have hp₀_nonneg : 0 ≤ p₀ := by dsimp [p₀]; linarith
    have hα1 : 1 / 2 < α := by dsimp [α]; linarith
    have hα2 : α < 1 := by dsimp [α]; linarith
    obtain ⟨L, ε₀, d_lim, _, hε₀_pos, hd_lim_pos, hObsα⟩ := h_obs α hα1 hα2
    let K₁ : ℝ := max (max K₀ 0) (-Real.log δ_b)
    let δ₁ : ℝ := Real.exp (-K₁)
    have hδ₁_pos : 0 < δ₁ := Real.exp_pos _
    have hδ₁_le_δb : δ₁ ≤ δ_b := by
      have h_neg : -K₁ ≤ Real.log δ_b := by
        have : -Real.log δ_b ≤ K₁ := le_max_right _ _
        linarith
      calc δ₁ = Real.exp (-K₁) := rfl
        _ ≤ Real.exp (Real.log δ_b) := Real.exp_le_exp.mpr h_neg
        _ = δ_b := Real.exp_log hδb_pos
    obtain ⟨M_slab, hM_ge_one, hM_slab⟩ :=
      h_slab_bdd δ₁ δ_b hδ₁_pos hδ₁_le_δb (lt_trans hδb_lt_half (by linarith [S.H_pos]))
    let C_sub : ℝ := max 1 (δ_b ^ p₀ * M_slab)
    have hC_sub_pos : 0 < C_sub := lt_of_lt_of_le zero_lt_one (le_max_left _ _)
    have h_sub_bound : ∀ s : ℂ, 0 < wallDepth S s → wallDepth S s ≤ δ_b →
        wallDepth S s ^ p₀ * shapeModulus S s ≤ C_sub := by
      intro s hδ_pos hδ_hi
      by_cases h_case : δ₁ ≤ wallDepth S s
      · have h_rpow_le : wallDepth S s ^ p₀ ≤ δ_b ^ p₀ :=
          Real.rpow_le_rpow hδ_pos.le hδ_hi hp₀_nonneg
        have hM_nonneg : 0 ≤ shapeModulus S s := by
          unfold shapeModulus
          exact le_trans (norm_nonneg _) (le_max_left _ _)
        have h_prod : wallDepth S s ^ p₀ * shapeModulus S s ≤ δ_b ^ p₀ * M_slab :=
          mul_le_mul h_rpow_le (hM_slab s h_case hδ_hi) hM_nonneg (by positivity)
        exact le_trans h_prod (le_max_right _ _)
      · push Not at h_case
        let k : ℝ := -Real.log (wallDepth S s)
        have hlog_lt : Real.log (wallDepth S s) < -K₁ := by
          have := Real.log_lt_log hδ_pos h_case
          simpa [δ₁] using this
        have hK₁_le : K₁ ≤ k := by dsimp [k]; linarith
        have hK₀_le : K₀ ≤ k :=
          le_trans (le_trans (le_max_left _ _) (le_max_left _ _)) hK₁_le
        have hk_nonneg : 0 ≤ k :=
          le_trans (le_trans (le_max_right _ _) (le_max_left _ _)) hK₁_le
        have hexp_eq : Real.exp (-k) = wallDepth S s := by
          dsimp [k]
          simp [Real.exp_log hδ_pos]
        have hexp_lt_H : Real.exp (-k) < S.H := by
          rw [hexp_eq]
          linarith [hδb_lt_half, S.H_pos]
        have hs_mem : s ∈ horizStrip S.H := by
          change |s.im| < S.H
          rw [abs_lt]
          unfold wallDepth at hδ_pos hδ_hi
          constructor <;> linarith [hδb_lt_half, S.H_pos]
        obtain ⟨x_mod, hx_mod, hs_mod⟩ := h_mod_2pi s hs_mem
        have him_eq : s.im = S.H - Real.exp (-k) := by
          rw [hexp_eq]
          unfold wallDepth
          ring
        have h_lt := h_contra k hK₀_le hexp_lt_H x_mod hx_mod
        rw [← him_eq, ← hs_mod] at h_lt
        have h_exp_le : Real.exp ((1 - ε) * k) ≤ Real.exp (p₀ * k) := by
          apply Real.exp_le_exp.mpr
          dsimp [p₀]
          nlinarith
        have hM_le : shapeModulus S s ≤ Real.exp (p₀ * k) := le_trans h_lt.le h_exp_le
        have hrpow_pos : 0 < wallDepth S s ^ p₀ := Real.rpow_pos_of_pos hδ_pos p₀
        have h_one : wallDepth S s ^ p₀ * Real.exp (p₀ * k) = 1 := by
          rw [Real.rpow_def_of_pos hδ_pos p₀, ← Real.exp_add]
          have : Real.log (wallDepth S s) * p₀ + p₀ * k = 0 := by
            dsimp [k]
            ring
          rw [this, Real.exp_zero]
        calc wallDepth S s ^ p₀ * shapeModulus S s
            ≤ wallDepth S s ^ p₀ * Real.exp (p₀ * k) :=
              mul_le_mul_of_nonneg_left hM_le hrpow_pos.le
          _ = 1 := h_one
          _ ≤ C_sub := le_max_left _ _
    let D_den : ℝ := 40 * C_sub * (δ_b ^ (ε' / 2) + 1)
    have hD_den_pos : 0 < D_den := by positivity
    let θ : ℝ := min (d_lim / 20) ((ε₀ / D_den) ^ (2 / ε'))
    have hθ_pos : 0 < θ := lt_min (by positivity) (Real.rpow_pos_of_pos (by positivity) _)
    let d : ℝ := 10 * θ
    have hd_pos : 0 < d := by positivity
    have hd_lt : d < d_lim := by
      have : θ ≤ d_lim / 20 := min_le_left _ _
      dsimp [d]
      linarith
    obtain ⟨s, hs_lo, hs_hi, _, hs_gt⟩ := hObsα d 0 hd_pos hd_lt
    let δ : ℝ := wallDepth S s
    have hδ_pos : 0 < δ := lt_of_lt_of_le (by positivity) hs_lo
    have h1_sub_α : 1 - α = ε' / 2 := by dsimp [α]; ring
    have hd10_eq : d / 10 = θ := by dsimp [d]; ring
    rw [h1_sub_α, hd10_eq] at hs_gt
    have hδ_decomp : δ = δ ^ (ε' / 2) * δ ^ (ε' / 2) * δ ^ p₀ := by
      calc δ = δ ^ (1 : ℝ) := (Real.rpow_one δ).symm
        _ = δ ^ (ε' / 2 + ε' / 2 + p₀) := by
            congr 1
            dsimp [p₀]
            ring
        _ = (δ ^ (ε' / 2) * δ ^ (ε' / 2)) * δ ^ p₀ := by
            rw [Real.rpow_add hδ_pos (ε' / 2 + ε' / 2) p₀, Real.rpow_add hδ_pos (ε' / 2) (ε' / 2)]
    have h_cancel_δ : (θ / δ) ^ (ε' / 2) * δ ^ (ε' / 2) = θ ^ (ε' / 2) := by
      rw [← Real.mul_rpow (by positivity) hδ_pos.le, div_mul_cancel₀ θ hδ_pos.ne']
    have h_rhs_eq : 20 * (θ / δ) ^ (ε' / 2) * (δ * shapeModulus S s) =
        20 * θ ^ (ε' / 2) * δ ^ (ε' / 2) * (δ ^ p₀ * shapeModulus S s) := by
      calc 20 * (θ / δ) ^ (ε' / 2) * (δ * shapeModulus S s)
          = 20 * (θ / δ) ^ (ε' / 2) *
              ((δ ^ (ε' / 2) * δ ^ (ε' / 2) * δ ^ p₀) * shapeModulus S s) := by
             nth_rw 2 [hδ_decomp]
        _ = 20 * ((θ / δ) ^ (ε' / 2) * δ ^ (ε' / 2)) *
              δ ^ (ε' / 2) * (δ ^ p₀ * shapeModulus S s) := by ring
        _ = 20 * θ ^ (ε' / 2) * δ ^ (ε' / 2) * (δ ^ p₀ * shapeModulus S s) := by
            rw [h_cancel_δ]
    rw [h_rhs_eq] at hs_gt
    have hδ_rpow_le : δ ^ (ε' / 2) ≤ δ_b ^ (ε' / 2) + 1 := by
      have : δ ^ (ε' / 2) ≤ δ_b ^ (ε' / 2) :=
        Real.rpow_le_rpow hδ_pos.le hs_hi (by positivity)
      linarith
    have h_sub_s : δ ^ p₀ * shapeModulus S s ≤ C_sub := h_sub_bound s hδ_pos hs_hi
    have h_nonneg_sub : 0 ≤ δ ^ p₀ * shapeModulus S s := by
      have : 0 ≤ shapeModulus S s := le_trans (norm_nonneg _) (le_max_left _ _)
      positivity
    have hθ_rpow : θ ^ (ε' / 2) ≤ ε₀ / D_den := by
      have hθ_le : θ ≤ (ε₀ / D_den) ^ (2 / ε') := min_le_right _ _
      calc θ ^ (ε' / 2)
          ≤ ((ε₀ / D_den) ^ (2 / ε')) ^ (ε' / 2) :=
            Real.rpow_le_rpow hθ_pos.le hθ_le (by positivity)
        _ = (ε₀ / D_den) ^ ((2 / ε') * (ε' / 2)) :=
            (Real.rpow_mul (by positivity) _ _).symm
        _ = (ε₀ / D_den) ^ (1 : ℝ) := by
            congr 1
            field_simp [hε'_pos.ne']
        _ = ε₀ / D_den := Real.rpow_one _
    have h_prod_bound :
        20 * θ ^ (ε' / 2) * δ ^ (ε' / 2) * (δ ^ p₀ * shapeModulus S s) ≤ ε₀ / 2 := by
      have h1 : δ ^ (ε' / 2) * (δ ^ p₀ * shapeModulus S s) ≤
          (δ_b ^ (ε' / 2) + 1) * C_sub :=
        mul_le_mul hδ_rpow_le h_sub_s h_nonneg_sub (by positivity)
      have h2 : 20 * θ ^ (ε' / 2) * (δ ^ (ε' / 2) * (δ ^ p₀ * shapeModulus S s)) ≤
          20 * (ε₀ / D_den) * ((δ_b ^ (ε' / 2) + 1) * C_sub) := by
        refine mul_le_mul ?_ h1 (by positivity) (by positivity)
        exact mul_le_mul_of_nonneg_left hθ_rpow (by norm_num)
      have h3 : 20 * (ε₀ / D_den) * ((δ_b ^ (ε' / 2) + 1) * C_sub) = ε₀ / 2 := by
        dsimp [D_den]
        have hne1 : C_sub ≠ 0 := hC_sub_pos.ne'
        have hne2 : δ_b ^ (ε' / 2) + 1 ≠ 0 := by positivity
        field_simp [hne1, hne2]
        ring
      linarith
    linarith
  
  have hWitness : ∀ C_p A_p δ_p : ℝ, 0 < C_p → 0 < A_p → 0 < δ_p →
      (∀ s ∈ horizStrip S.H, wallDepth S s ≤ δ_p →
        wallDepth S s * shapeModulus S s ≤
          C_p * (1 + Real.log (1 / wallDepth S s)) ^ A_p) →
      ∃ L₀ C₁ C₂ c_star k_star : ℝ,
        0 < L₀ ∧ 0 < C₁ ∧ 0 < C₂ ∧ 0 < c_star ∧ 1 ≤ k_star ∧
        ∀ k x₀ : ℝ, k_star ≤ k →
          ∃ z ∈ horizStrip S.H,
            0 < z.im ∧
            |z.re - x₀| ≤ L₀ * wallDepth S z ∧
            k - C₁ * Real.log k ≤ -Real.log (wallDepth S z) ∧
            -Real.log (wallDepth S z) ≤ k + C₂ ∧
            c_star ≤ wallDepth S z * (‖S.f z‖ + Real.sqrt ‖S.q z‖) := by
    intro C_p A_p δ_p hCp_pos hAp_pos hδp_pos hPoly
    obtain ⟨L, ε₀, d_lim, hL_pos, hε₀_pos, hd_lim_pos, hObs34⟩ :=
      h_obs (3 / 4) (by norm_num) (by norm_num)
    let δ_mid : ℝ := min δ_p δ_b
    have hδ_mid_pos : 0 < δ_mid := lt_min hδp_pos hδb_pos
    have hδ_mid_le_p : δ_mid ≤ δ_p := min_le_left _ _
    have hδ_mid_le_b : δ_mid ≤ δ_b := min_le_right _ _
    obtain ⟨M_low, hM_low_ge_one, hM_low⟩ :=
      h_slab_bdd δ_mid δ_b hδ_mid_pos hδ_mid_le_b
        (lt_trans hδb_lt_half (by linarith [S.H_pos]))
    let L₀ : ℝ := L
    let C₁ : ℝ := 4 * A_p + 4
    let C₂ : ℝ := Real.log 100
    let c_star : ℝ := ε₀ / 40
    let K_a : ℝ := max 1 (-Real.log d_lim + 1)
    let K_b : ℝ := max
      (Real.log (16000 * (δ_b * M_low) ^ 4 / (ε₀ ^ 4 * δ_mid)) + 1)
      (16000 * C_p ^ 4 * (2 : ℝ) ^ (4 * A_p) / ε₀ ^ 4 + 1)
    let k_star : ℝ := max K_a K_b
    have hC₂_pos : 0 < C₂ := Real.log_pos (by norm_num)
    have hk_star_ge_one : 1 ≤ k_star :=
      le_trans (le_max_left _ _) (le_max_left _ _)
    refine ⟨L₀, C₁, C₂, c_star, k_star, hL_pos, by positivity, hC₂_pos,
      by positivity, hk_star_ge_one, ?_⟩
    intro k x₀ hk
    have hk_ge_one : 1 ≤ k := le_trans hk_star_ge_one hk
    have hk_pos : 0 < k := lt_of_lt_of_le zero_lt_one hk_ge_one
    let d : ℝ := Real.exp (-k)
    have hd_pos : 0 < d := Real.exp_pos _
    have hd_lt : d < d_lim := by
      have hk_gt : -Real.log d_lim < k := by
        have : -Real.log d_lim + 1 ≤ k :=
          le_trans (le_trans (le_max_right _ _) (le_max_left _ _)) hk
        linarith
      calc d = Real.exp (-k) := rfl
        _ < Real.exp (Real.log d_lim) := Real.exp_lt_exp.mpr (by linarith)
        _ = d_lim := Real.exp_log hd_lim_pos
    obtain ⟨z, hz_lo, hz_hi, hz_re, hz_gt⟩ := hObs34 d x₀ hd_pos hd_lt
    let δ : ℝ := wallDepth S z
    have hδ_pos : 0 < δ := lt_of_lt_of_le (by positivity) hz_lo
    have h_exp_sub : (1 : ℝ) - 3 / 4 = 1 / 4 := by norm_num
    rw [h_exp_sub] at hz_gt
    
    have hu_pos : 0 < (d / 10) / δ := by positivity
    have hu_pow4 : (((d / 10) / δ) ^ (1 / 4 : ℝ)) ^ (4 : ℕ) = (d / 10) / δ := by
      rw [← Real.rpow_natCast, ← Real.rpow_mul hu_pos.le]
      norm_num
    have hz_pow4_raw : ε₀ ^ 4 <
        (20 * ((d / 10) / δ) ^ (1 / 4 : ℝ) * (δ * shapeModulus S z)) ^ 4 :=
      pow_lt_pow_left₀ hz_gt hε₀_pos.le (by norm_num)
    have h_rhs4 : (20 * ((d / 10) / δ) ^ (1 / 4 : ℝ) * (δ * shapeModulus S z)) ^ 4 =
        16000 * (d / δ) * (δ * shapeModulus S z) ^ 4 := by
      calc (20 * ((d / 10) / δ) ^ (1 / 4 : ℝ) * (δ * shapeModulus S z)) ^ 4
          = 20 ^ 4 * (((d / 10) / δ) ^ (1 / 4 : ℝ)) ^ (4 : ℕ) *
              (δ * shapeModulus S z) ^ 4 := by ring
        _ = 20 ^ 4 * ((d / 10) / δ) * (δ * shapeModulus S z) ^ 4 := by rw [hu_pow4]
        _ = 16000 * (d / δ) * (δ * shapeModulus S z) ^ 4 := by ring
    rw [h_rhs4] at hz_pow4_raw
    have h_star : ε₀ ^ 4 * δ < 16000 * d * (δ * shapeModulus S z) ^ 4 := by
      have hmul := mul_lt_mul_of_pos_right hz_pow4_raw hδ_pos
      have h_simp : 16000 * (d / δ) * (δ * shapeModulus S z) ^ 4 * δ =
          16000 * d * (δ * shapeModulus S z) ^ 4 := by
        field_simp [hδ_pos.ne']
      rwa [h_simp] at hmul
    
    have hz_im_pos : 0 < z.im := by
      have : S.H - z.im ≤ S.H / 3 := le_trans hz_hi hδb_le_third
      linarith [S.H_pos]
    have hz_mem : z ∈ horizStrip S.H := by
      change |z.im| < S.H
      rw [abs_lt]
      have : 0 < S.H - z.im := hδ_pos
      constructor <;> linarith [S.H_pos]
    
    have h_log_upper : -Real.log δ ≤ k + C₂ := by
      have hexp_le : Real.exp (-(k + C₂)) ≤ δ := by
        have h100 : Real.exp (-(k + C₂)) = d / 100 := by
          dsimp [d, C₂]
          rw [neg_add, Real.exp_add, Real.exp_neg, Real.exp_neg,
            Real.exp_log (by norm_num : (0 : ℝ) < 100), div_eq_mul_inv]
        rwa [h100]
      have hlog := Real.log_le_log (Real.exp_pos _) hexp_le
      rw [Real.log_exp] at hlog
      linarith
    
    have hc_star_le : c_star ≤ δ * (‖S.f z‖ + Real.sqrt ‖S.q z‖) := by
      have h1 : ε₀ ^ 4 * (d / 100) < 16000 * d * (δ * shapeModulus S z) ^ 4 :=
        lt_of_le_of_lt (mul_le_mul_of_nonneg_left hz_lo (by positivity)) h_star
      have h2 : d * (c_star ^ 4 * 16000) < d * ((δ * shapeModulus S z) ^ 4 * 16000) := by
        dsimp [c_star]
        nlinarith [hε₀_pos, pow_pos hε₀_pos 4, hd_pos]
      have h3 : c_star ^ 4 * 16000 < (δ * shapeModulus S z) ^ 4 * 16000 :=
        lt_of_mul_lt_mul_left h2 hd_pos.le
      have h4 : c_star ^ 4 < (δ * shapeModulus S z) ^ 4 := by linarith
      have hM_nonneg : 0 ≤ δ * shapeModulus S z := by
        have : 0 ≤ shapeModulus S z := le_trans (norm_nonneg _) (le_max_left _ _)
        positivity
      have h5 : c_star < δ * shapeModulus S z :=
        lt_of_pow_lt_pow_left₀ 4 hM_nonneg h4
      have h_max_le : shapeModulus S z ≤ ‖S.f z‖ + Real.sqrt ‖S.q z‖ := by
        unfold shapeModulus
        exact max_le (by linarith [Real.sqrt_nonneg ‖S.q z‖])
          (by linarith [norm_nonneg (S.f z)])
      exact le_trans h5.le (mul_le_mul_of_nonneg_left h_max_le hδ_pos.le)
    
    have hδ_lt_mid : δ < δ_mid := by
      by_contra h_ge_mid
      push Not at h_ge_mid
      have hM_le : shapeModulus S z ≤ M_low := hM_low z h_ge_mid hz_hi
      have hM_nonneg : 0 ≤ shapeModulus S z := le_trans (norm_nonneg _) (le_max_left _ _)
      have h_prod_le : δ * shapeModulus S z ≤ δ_b * M_low :=
        mul_le_mul hz_hi hM_le hM_nonneg (by positivity)
      have h_pow_le : (δ * shapeModulus S z) ^ 4 ≤ (δ_b * M_low) ^ 4 :=
        pow_le_pow_left₀ (by positivity) h_prod_le 4
      have h_ineq1 : ε₀ ^ 4 * δ_mid < 16000 * d * (δ_b * M_low) ^ 4 := by
        calc ε₀ ^ 4 * δ_mid ≤ ε₀ ^ 4 * δ := mul_le_mul_of_nonneg_left h_ge_mid (by positivity)
          _ < 16000 * d * (δ * shapeModulus S z) ^ 4 := h_star
          _ ≤ 16000 * d * (δ_b * M_low) ^ 4 :=
              mul_le_mul_of_nonneg_left h_pow_le (by positivity)
      have hk_gt : Real.log (16000 * (δ_b * M_low) ^ 4 / (ε₀ ^ 4 * δ_mid)) < k := by
        have : Real.log (16000 * (δ_b * M_low) ^ 4 / (ε₀ ^ 4 * δ_mid)) + 1 ≤ k :=
          le_trans (le_trans (le_max_left _ _) (le_max_right _ _)) hk
        linarith
      have hexp_lt : d < ε₀ ^ 4 * δ_mid / (16000 * (δ_b * M_low) ^ 4) := by
        have h_pos_arg : 0 < 16000 * (δ_b * M_low) ^ 4 / (ε₀ ^ 4 * δ_mid) := by positivity
        have h1 : d <
            Real.exp (-Real.log (16000 * (δ_b * M_low) ^ 4 / (ε₀ ^ 4 * δ_mid))) :=
          Real.exp_lt_exp.mpr (by linarith)
        rw [Real.exp_neg, Real.exp_log h_pos_arg, inv_div] at h1
        exact h1
      have h_denom_pos : 0 < 16000 * (δ_b * M_low) ^ 4 := by positivity
      have := (lt_div_iff₀ h_denom_pos).mp hexp_lt
      linarith
    have hδ_le_dk : δ ≤ d * k ^ C₁ := by
      by_contra h_gt_dk
      push Not at h_gt_dk
      have hk_rpow_ge_one : 1 ≤ k ^ C₁ := Real.one_le_rpow hk_ge_one (by positivity)
      have hd_lt_δ : d < δ := lt_of_le_of_lt (by nlinarith) h_gt_dk
      have hinv_lt : 1 / δ < Real.exp k := by
        have : 1 / δ < 1 / d := one_div_lt_one_div_of_lt hd_pos hd_lt_δ
        simpa [d, Real.exp_neg] using this
      have hlog_inv_lt : Real.log (1 / δ) < k := by
        have := Real.log_lt_log (by positivity) hinv_lt
        simpa using this
      have hδ_le_one : δ ≤ 1 := le_trans hz_hi hδb_le_one
      have hlog_inv_nonneg : 0 ≤ Real.log (1 / δ) :=
        Real.log_nonneg ((one_le_div hδ_pos).mpr hδ_le_one)
      have h1_plus_le : 1 + Real.log (1 / δ) ≤ 2 * k := by linarith
      have h_poly_z : δ * shapeModulus S z ≤ C_p * (2 * k) ^ A_p := by
        have hp := hPoly z hz_mem (le_trans hδ_lt_mid.le hδ_mid_le_p)
        have hr : (1 + Real.log (1 / δ)) ^ A_p ≤ (2 * k) ^ A_p :=
          Real.rpow_le_rpow (by linarith) h1_plus_le hAp_pos.le
        exact le_trans hp (mul_le_mul_of_nonneg_left hr hCp_pos.le)
      have hM_nonneg : 0 ≤ δ * shapeModulus S z := by
        have : 0 ≤ shapeModulus S z := le_trans (norm_nonneg _) (le_max_left _ _)
        positivity
      have h_pow4_poly : (δ * shapeModulus S z) ^ 4 ≤
          C_p ^ 4 * (2 : ℝ) ^ (4 * A_p) * k ^ (4 * A_p) := by
        have h2pow : ((2 : ℝ) ^ A_p) ^ (4 : ℕ) = (2 : ℝ) ^ (4 * A_p) := by
          rw [← Real.rpow_natCast ((2 : ℝ) ^ A_p) 4, ← Real.rpow_mul (by norm_num)]
          push_cast
          ring_nf
        have hkpow : (k ^ A_p) ^ (4 : ℕ) = k ^ (4 * A_p) := by
          rw [← Real.rpow_natCast (k ^ A_p) 4, ← Real.rpow_mul hk_pos.le]
          push_cast
          ring_nf
        calc (δ * shapeModulus S z) ^ 4
            ≤ (C_p * (2 * k) ^ A_p) ^ 4 := pow_le_pow_left₀ hM_nonneg h_poly_z 4
          _ = C_p ^ 4 * (((2 : ℝ) ^ A_p * k ^ A_p) ^ (4 : ℕ)) := by
              rw [Real.mul_rpow (by norm_num) hk_pos.le]
              ring
          _ = C_p ^ 4 * (((2 : ℝ) ^ A_p) ^ (4 : ℕ) * (k ^ A_p) ^ (4 : ℕ)) := by ring
          _ = C_p ^ 4 * ((2 : ℝ) ^ (4 * A_p) * k ^ (4 * A_p)) := by rw [h2pow, hkpow]
          _ = C_p ^ 4 * (2 : ℝ) ^ (4 * A_p) * k ^ (4 * A_p) := by ring
      have hkC₁_eq : k ^ C₁ = k ^ (4 * A_p) * k ^ 4 := by
        dsimp [C₁]
        rw [Real.rpow_add hk_pos (4 * A_p) 4]
        norm_cast
      have h_comb : (d * k ^ (4 * A_p)) * (ε₀ ^ 4 * k ^ 4) <
          (d * k ^ (4 * A_p)) * (16000 * C_p ^ 4 * (2 : ℝ) ^ (4 * A_p)) := by
        calc (d * k ^ (4 * A_p)) * (ε₀ ^ 4 * k ^ 4)
            = ε₀ ^ 4 * (d * k ^ C₁) := by rw [hkC₁_eq]; ring
          _ < ε₀ ^ 4 * δ := mul_lt_mul_of_pos_left h_gt_dk (by positivity)
          _ < 16000 * d * (δ * shapeModulus S z) ^ 4 := h_star
          _ ≤ 16000 * d * (C_p ^ 4 * (2 : ℝ) ^ (4 * A_p) * k ^ (4 * A_p)) :=
              mul_le_mul_of_nonneg_left h_pow4_poly (by positivity)
          _ = (d * k ^ (4 * A_p)) * (16000 * C_p ^ 4 * (2 : ℝ) ^ (4 * A_p)) := by ring
      have hdk_pos : 0 < d * k ^ (4 * A_p) :=
        mul_pos hd_pos (Real.rpow_pos_of_pos hk_pos _)
      have hk4_lt : ε₀ ^ 4 * k ^ 4 < 16000 * C_p ^ 4 * (2 : ℝ) ^ (4 * A_p) :=
        lt_of_mul_lt_mul_left h_comb hdk_pos.le
      have hk_le_k4 : k ≤ k ^ 4 := le_self_pow₀ hk_ge_one (by norm_num)
      have hk_gt_bound : 16000 * C_p ^ 4 * (2 : ℝ) ^ (4 * A_p) / ε₀ ^ 4 < k := by
        have : 16000 * C_p ^ 4 * (2 : ℝ) ^ (4 * A_p) / ε₀ ^ 4 + 1 ≤ k :=
          le_trans (le_trans (le_max_right _ _) (le_max_right _ _)) hk
        linarith
      have hε₀4_pos : 0 < ε₀ ^ 4 := by positivity
      have := (div_lt_iff₀ hε₀4_pos).mp hk_gt_bound
      nlinarith
    have h_log_lower : k - C₁ * Real.log k ≤ -Real.log δ := by
      have hdk_eq : d * k ^ C₁ = Real.exp (-k + C₁ * Real.log k) := by
        dsimp [d]
        rw [Real.rpow_def_of_pos hk_pos C₁, ← Real.exp_add]
        ring_nf
      rw [hdk_eq] at hδ_le_dk
      have hlog := Real.log_le_log hδ_pos hδ_le_dk
      rw [Real.log_exp] at hlog
      linarith
    exact ⟨z, hz_mem, hz_im_pos, hz_re, h_log_lower, h_log_upper, hc_star_le⟩
  exact
    { critical_upper_bound := hUpper
      critical_lower_unbounded := hLower
      cone_passage := hCone
      deep_first_field_model := hFirst
      exp_profile_obstruction := hExpFin S
      log_deficit_bound := hLogDef
      poly_growth_witness := hWitness }

theorem cone_real_wall_transfer_and_strip_bound (S : FiniteWallNonisotropicStrip)
    (hCrit : CriticalWallData S) :
    BootRealWallTransferProp S ∧
    ∀ t : ℝ, |t| < S.r_star → ∀ y : ℂ, 0 < y.im → y.im < S.h_X (t : ℂ) →
      (S.𝔰 (y, (t : ℂ)) - y).im ≤ S.H - S.h_X (t : ℂ) :=
by
  have hPeriodicStrip : ∀ (g : ℂ → ℂ) (T B M : ℝ),
      0 < T → 0 < B →
      DifferentiableOn ℂ g { z : ℂ | 0 ≤ z.im ∧ z.im ≤ B } →
      (∀ z : ℂ, 0 ≤ z.im → z.im ≤ B → g (z + (T : ℂ)) = g z) →
      (∀ x : ℝ, (g (x : ℂ)).im ≤ M) →
      (∀ z : ℂ, z.im = B → (g z).im ≤ M) →
      ∀ z : ℂ, 0 ≤ z.im → z.im ≤ B → (g z).im ≤ M := by
    intro g T B M hT_pos hB_pos hg_holo hg_per hg_bot hg_top
    let S_cl : Set ℂ := { z : ℂ | 0 ≤ z.im ∧ z.im ≤ B }
    let E : ℂ → ℂ := fun z => Complex.exp (-Complex.I * g z)
    have hE_norm : ∀ z : ℂ, ‖E z‖ = Real.exp ((g z).im) := by
      intro z
      dsimp [E]
      rw [Complex.norm_exp]
      congr 1
      simp [Complex.mul_re]
    have hE_holo : DifferentiableOn ℂ E S_cl :=
      (hg_holo.const_mul (-Complex.I)).cexp
    have hE_cont : ContinuousOn E S_cl := hE_holo.continuousOn
    let ψ : ℝ × ℝ → ℂ := fun p => (p.1 : ℂ) + (p.2 : ℂ) * Complex.I
    have hψ_cont : Continuous ψ := by
      dsimp [ψ]
      fun_prop
    let R_box : Set (ℝ × ℝ) := Set.Icc 0 T ×ˢ Set.Icc 0 B
    let K : Set ℂ := ψ '' R_box
    have hK_comp : IsCompact K := (isCompact_Icc.prod isCompact_Icc).image hψ_cont
    have hK_ne : K.Nonempty :=
      ⟨ψ (0, 0), ⟨(0, 0), ⟨⟨le_rfl, le_of_lt hT_pos⟩, ⟨le_rfl, le_of_lt hB_pos⟩⟩, rfl⟩⟩
    have hK_sub : K ⊆ S_cl := by
      rintro w ⟨⟨x, σ⟩, ⟨_, hσ⟩, rfl⟩
      exact ⟨by simpa [ψ] using hσ.1, by simpa [ψ] using hσ.2⟩
    have h_normE_cont : ContinuousOn (norm ∘ E) K :=
      continuous_norm.comp_continuousOn (hE_cont.mono hK_sub)
    obtain ⟨z_star, hz_in_K, hz_max_K⟩ := hK_comp.exists_isMaxOn hK_ne h_normE_cont
    have hz_mem : z_star ∈ S_cl := hK_sub hz_in_K
    have hz_max_S : IsMaxOn (norm ∘ E) S_cl z_star := by
      rw [isMaxOn_iff]
      intro z hz
      let φ : ℝ → ℂ := fun x => E ((x : ℂ) + (z.im : ℂ) * Complex.I)
      have hφ_per : Function.Periodic φ T := by
        intro x
        dsimp [φ, E]
        have hw1 : 0 ≤ (((x : ℂ) + (z.im : ℂ) * Complex.I)).im := by simpa using hz.1
        have hw2 : (((x : ℂ) + (z.im : ℂ) * Complex.I)).im ≤ B := by simpa using hz.2
        have hcast : ((x + T : ℝ) : ℂ) + (z.im : ℂ) * Complex.I =
            ((x : ℂ) + (z.im : ℂ) * Complex.I) + (T : ℂ) := by push_cast; ring
        rw [hcast, hg_per _ hw1 hw2]
      obtain ⟨x', hx'_mem, hx'_eq⟩ := hφ_per.exists_mem_Ico₀ hT_pos z.re
