          Complex.log (c₀ * (q - z₀)) - Complex.log (c₀ * (p - z₀)) := by
      intro L hL p hp q hq c₀ hc₀ h_pos
      let U : Set ℂ := {w : ℂ | 0 < (c₀ * (w - z₀)).re}
