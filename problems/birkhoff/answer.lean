            (fun θ : ℝ => expSlope_C W (z + (ρ : ℂ) + e_X z) ((θ : ℂ) * Y z))
            (Set.Icc (0 : ℝ) 1) := by
        intro z hz
        let X₀ : ℂ := z + (ρ : ℂ) + e_X z
        let Y₀ : ℂ := Y z
