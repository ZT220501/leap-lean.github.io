        ((h_seq j - s.im) / ℓ_seq j) ^ (9 / 8 : ℝ) * (Φ s / (m0_seq j) ^ 2) ≤ J_fn j L x := by
      intro x s hs_lo hs_hi hs_re
      let v : ℝ := (h_seq j - s.im) / ℓ_seq j
