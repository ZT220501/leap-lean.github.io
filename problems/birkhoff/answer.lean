      have h1q_lt : 1 + |(q : ℝ)| < J_all := by linarith [hJ_eq, hq_S]
      have h1q_pos : 0 < 1 + |(q : ℝ)| := by linarith [abs_nonneg (q : ℝ)]
      rw [Metric.mem_ball, Prod.dist_eq] at hp₁ ⊢
      have hd1 : ‖p₁.1 - p₂.1‖ < R := by
        simpa only [dist_eq_norm] using lt_of_le_of_lt (le_max_left _ _) hp₁
      have hd2 : ‖p₁.2 - p₂.2‖ < R := by
        simpa only [dist_eq_norm] using lt_of_le_of_lt (le_max_right _ _) hp₁
      refine max_lt ?_ ?_
      · rw [dist_eq_norm]
        have h_sub : (wallShiftPair q p₁).1 - (wallShiftPair q p₂).1 =
            (p₁.1 - p₂.1) + (q : ℂ) * (p₁.2 - p₂.2) := by
          dsimp [wallShiftPair]
          ring
        rw [h_sub]
        have h_tri : ‖(p₁.1 - p₂.1) + (q : ℂ) * (p₁.2 - p₂.2)‖ ≤
            ‖p₁.1 - p₂.1‖ + |(q : ℝ)| * ‖p₁.2 - p₂.2‖ := by
          calc ‖(p₁.1 - p₂.1) + (q : ℂ) * (p₁.2 - p₂.2)‖
