theorem trunc_speed_step_l2_increment (S : FiniteWallNonisotropicStrip)
    (hBudget : CriticalAngleBudgetData S)
    (hKern : StripExitKernelData S)
    (A : AmplitudeDeficitData S hBudget) :
    ∃ C_inc K_inc : ℝ, 0 < C_inc ∧ A.K_amp ≤ K_inc ∧
      ∀ K : ℝ, K_inc ≤ K →
        (∀ v ∈ Set.Icc ((9 / 10 : ℝ) * K) ((21 / 10 : ℝ) * K),
          rowMomentFull S v ≤ K ^ (1 / 100 : ℝ)) →
        ∀ v ∈ Set.Icc ((11 / 10 : ℝ) * K) ((49 / 25 : ℝ) * K),
        ∀ s ∈ Set.Icc (2 : ℝ) 4,
          (2 * Real.pi)⁻¹ *
            (∫ x in (0 : ℝ)..(2 * Real.pi),
              ∫ u : ℝ,
                (truncLogSpeed S (A.epsK K) (upperRowPt S (v + s) (x + u)) -
                  truncLogSpeed S (A.epsK K) (upperRowPt S v x)) ^ 2 *
                stripExitKernel (S.H - Real.exp (-(v + s))) (S.H - Real.exp (-v)) u) ≤
            C_inc * K ^ (1 / 50 : ℝ) :=
by
  
  have h_s3 : ∀ (g₁ g₂ a₁ a₂ κ : ℝ → ℝ),
      Continuous g₁ → Function.Periodic g₁ (2 * Real.pi) →
      Continuous g₂ → Function.Periodic g₂ (2 * Real.pi) →
      Continuous a₁ → Function.Periodic a₁ (2 * Real.pi) →
      Continuous a₂ → Function.Periodic a₂ (2 * Real.pi) →
      Continuous κ → (∀ u : ℝ, 0 ≤ κ u) →
      MeasureTheory.Integrable κ MeasureTheory.volume →
      (∫ u : ℝ, κ u) = 1 →
      (∀ u : ℝ, 0 ≤ (2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi), (a₂ (x + u) - a₁ x) ^ 2) ∧
      (∀ B_glob : ℝ, 0 ≤ B_glob → (∀ x : ℝ, |a₁ x| ≤ B_glob) → (∀ x : ℝ, |a₂ x| ≤ B_glob) →
        ∀ u : ℝ, ((2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi), (a₂ (x + u) - a₁ x) ^ 2) ≤
          4 * B_glob ^ (2 : ℕ)) ∧
      MeasureTheory.Integrable
        (fun u : ℝ => ((2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi), (a₂ (x + u) - a₁ x) ^ 2) * κ u)
        MeasureTheory.volume ∧
      (2 * Real.pi)⁻¹ * (∫ x in (0 : ℝ)..(2 * Real.pi), ∫ u : ℝ, (g₂ (x + u) - g₁ x) ^ 2 * κ u) ≤
        3 * ((2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi), (a₂ x - g₂ x) ^ 2) +
        3 * (∫ u : ℝ, ((2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi), (a₂ (x + u) - a₁ x) ^ 2) * κ u) +
        3 * ((2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi), (a₁ x - g₁ x) ^ 2) := by
    clear S hBudget hKern A
    intro g₁ g₂ a₁ a₂ κ hg₁_cont hg₁_per hg₂_cont hg₂_per ha₁_cont ha₁_per ha₂_cont ha₂_per
      hκ_cont hκ_nonneg hκ_int hκ_one
    have hBoundPer : ∀ h : ℝ → ℝ, Continuous h → Function.Periodic h (2 * Real.pi) →
        ∃ B : ℝ, 0 ≤ B ∧ ∀ x : ℝ, |h x| ≤ B := by
      intro h hh_cont hh_per
      obtain ⟨C₀, hC₀⟩ := isCompact_Icc.exists_bound_of_continuousOn
        (s := Set.Icc (0 : ℝ) (2 * Real.pi)) hh_cont.continuousOn
      refine ⟨max C₀ 0, le_max_right _ _, fun x => ?_⟩
      obtain ⟨y, hy_mem, hy_eq⟩ := hh_per.exists_mem_Ico₀ Real.two_pi_pos x
      have hy_Icc : y ∈ Set.Icc (0 : ℝ) (2 * Real.pi) := Set.Ico_subset_Icc_self hy_mem
      have hy_le : |h y| ≤ C₀ := by simpa only [Real.norm_eq_abs] using hC₀ y hy_Icc
      rw [hy_eq]
      exact le_trans hy_le (le_max_left _ _)
    have hFubini : ∀ Φ : ℝ × ℝ → ℝ, Continuous Φ → (∀ p, 0 ≤ Φ p) →
        (∃ B : ℝ, 0 ≤ B ∧ ∀ p, Φ p ≤ B) →
        (∀ x : ℝ, MeasureTheory.Integrable (fun u => Φ (x, u) * κ u) MeasureTheory.volume) ∧
        IntervalIntegrable (fun x => ∫ u : ℝ, Φ (x, u) * κ u) MeasureTheory.volume 0 (2 * Real.pi) ∧
        MeasureTheory.Integrable
          (fun u => (∫ x in (0 : ℝ)..(2 * Real.pi), Φ (x, u)) * κ u) MeasureTheory.volume ∧
        (∫ x in (0 : ℝ)..(2 * Real.pi), ∫ u : ℝ, Φ (x, u) * κ u) =
          ∫ u : ℝ, (∫ x in (0 : ℝ)..(2 * Real.pi), Φ (x, u)) * κ u := by
      intro Φ hΦ_cont hΦ_nonneg ⟨B, _hB, hΦ_le⟩
      let μ₁ := MeasureTheory.volume.restrict (Set.Ioc (0 : ℝ) (2 * Real.pi))
      have hB_μ₁ : MeasureTheory.Integrable (fun _ : ℝ => B) μ₁ := by
        refine MeasureTheory.integrableOn_const ?_
        rw [Real.volume_Ioc, sub_zero]
        exact ENNReal.ofReal_ne_top
      have hDom : MeasureTheory.Integrable (fun p : ℝ × ℝ => B * κ p.2)
