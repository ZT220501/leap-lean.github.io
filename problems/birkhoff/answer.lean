          constructor
          · intro h
            simpa [ι₁] using congr_arg (fun x => x 1) h
          · rintro rfl
            simp [ι₁]
        by_cases hk : k = 0
        · subst hk; simp [ι₁]
        · have hne : ι₁ k ≠ 0 := mt hiff.mp hk
          simp [hk, hne]
