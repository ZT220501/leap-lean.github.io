  have hFtilde_holo : DifferentiableOn ℂ F_tilde (D_a ×ˢ Metric.ball (0 : ℂ) 1) := by
    let W_G1 : Set ((ℂ × ℂ) × ℂ) :=
      { x | (x.1.1, x.2) ∈ D_a ×ˢ A_ζ ∧ x.2 - x.1.2 ≠ 0 }
    have hWG1_open : IsOpen W_G1 :=
      ((hDa_open.prod hAζ_open).preimage
        ((continuous_fst.comp continuous_fst).prodMk continuous_snd)).inter
        (isOpen_ne.preimage (continuous_snd.sub (continuous_snd.comp continuous_fst)))
    have hG1_diff : DifferentiableOn ℂ
        (fun x : (ℂ × ℂ) × ℂ => F (x.1.1, x.2) * x.2 / (x.2 - x.1.2)) W_G1 := by
      have h1 : DifferentiableOn ℂ (fun x : (ℂ × ℂ) × ℂ => F (x.1.1, x.2)) W_G1 :=
        hF_holo.comp
          (((differentiable_fst.comp differentiable_fst).prodMk differentiable_snd).differentiableOn)
          (fun x hx => hx.1)
      have h2 : DifferentiableOn ℂ (fun x : (ℂ × ℂ) × ℂ => x.2) W_G1 :=
        differentiable_snd.differentiableOn
      have hden : DifferentiableOn ℂ (fun x : (ℂ × ℂ) × ℂ => x.2 - x.1.2) W_G1 :=
        (differentiable_snd.sub (differentiable_snd.comp differentiable_fst)).differentiableOn
      have hinv : DifferentiableOn ℂ (fun x : (ℂ × ℂ) × ℂ => (x.2 - x.1.2)⁻¹) W_G1 :=
        differentiableOn_inv.comp hden (fun _ hx => hx.2)
      exact ((h1.mul h2).mul hinv).congr (fun _ _ => div_eq_mul_inv _ _)
    refine h_circle_param_holo W_G1 _ (D_a ×ˢ Metric.ball (0 : ℂ) 1)
      hWG1_open hG1_diff (hDa_open.prod Metric.isOpen_ball) ?_
    intro p hp z hz
    refine ⟨⟨hp.1, h_sphere_in_Aζ z hz⟩, ?_⟩
    intro hsub
    have heq : z = p.2 := sub_eq_zero.mp hsub
    have hzn : ‖z‖ = 1 := mem_sphere_zero_iff_norm.mp hz
    have hpn : ‖p.2‖ < 1 := by simpa [Metric.mem_ball, dist_zero_right] using hp.2
    linarith [heq ▸ hzn]

  have hJhat_holo : DifferentiableOn ℂ J_hat (D_a ×ˢ Metric.ball (0 : ℂ) 1) := by
    let W_G2 : Set ((ℂ × ℂ) × ℂ) :=
