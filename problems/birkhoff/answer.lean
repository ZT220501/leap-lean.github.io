                      compPowerSeries2D (PowerSeries.derivative (F_tr i.succ)) (β_ser i.succ) -
                    pcJetEdgeDY F_ser β_ser i *
                      compPowerSeries2D (PowerSeries.derivative (F_ser i.succ)) (β_ser i.succ) := by
                  unfold pcJetNumSucc; ring
                rw [hid]
                exact h_agree_mul _ _ _ _ (hDY_agree i) (hF'_agree i.succ)
              have hid : pcJetEdgeTermSucc x_base ℓ_base I_ser F_tr β_ser i -
                  pcJetEdgeTermSucc x_base ℓ_base I_ser F_ser β_ser i =
                MvPowerSeries.C ((ℓ_base i)⁻¹) *
                  (pcJetNumSucc x_base F_tr β_ser i *
                      compPowerSeries2D I_ser (pcJetEdgeU x_base ℓ_base F_tr β_ser i) -
                    pcJetNumSucc x_base F_ser β_ser i *
                      compPowerSeries2D I_ser (pcJetEdgeU x_base ℓ_base F_ser β_ser i)) := by
                unfold pcJetEdgeTermSucc; ring
              rw [hid]
              exact h_vb_C_mul _ (h_agree_mul _ _ _ _ hNS
                (h_vb_comp_sub (n + 1) I_ser _ _ (hU_agree i)))
            have hEC_agree : ∀ i : Fin k,
                pointCoreVanishesBelow (n + 1)
                  (pcJetEdgeTermCast x_base ℓ_base I_ser F_tr β_ser i -
                    pcJetEdgeTermCast x_base ℓ_base I_ser F_ser β_ser i) := by
              intro i
              have hNC : pointCoreVanishesBelow (n + 1)
                  (pcJetNumCast x_base F_tr β_ser i - pcJetNumCast x_base F_ser β_ser i) := by
                have hid : pcJetNumCast x_base F_tr β_ser i - pcJetNumCast x_base F_ser β_ser i =
