        (by simp; linarith [(h_bot_sep c₀ hc₀_bot).1])
        (by simp; linarith [(h_right_sep c₁ hc₁_right).1])
        (by simp; linarith [(h_bot_sep c₁ hc₁_bot).1])
        (by simp; linarith [(h_right_sep c₂ hc₂_right).1])
        (by simp; linarith [(h_top_sep c₂ hc₂_top).1])
        (by simp; linarith [(h_left_sep c₃ hc₃_left).1])
        (by simp; linarith [(h_top_sep c₃ hc₃_top).1])
    let L_tot : ℝ :=
      meshPolyLength (mpwcPolyPrefixTo γ_bot h_bot c₁ hc₁_bot) +
        meshPolyLength (mpwcPolyPrefixTo γ_bot h_bot c₀ hc₀_bot) +
        meshPolyLength (mpwcPolyPrefixTo σ_right h_right c₂ hc₂_right) +
        meshPolyLength (mpwcPolyPrefixTo σ_right h_right c₁ hc₁_right) +
        meshPolyLength (mpwcPolyPrefixTo γ_top h_top c₃ hc₃_top) +
        meshPolyLength (mpwcPolyPrefixTo γ_top h_top c₂ hc₂_top) +
        meshPolyLength (mpwcPolyPrefixTo σ_left h_left c₀ hc₀_left) +
        meshPolyLength (mpwcPolyPrefixTo σ_left h_left c₃ hc₃_left)
    have h_pow_bound : ∀ m : ℕ,
        (2 * Real.pi) * ‖G z₀‖ ^ m ≤ (L_tot / r_clr) * M_bound ^ m := by
      intro m
