      · have hodd : Odd k := Nat.not_even_iff_odd.mp heven
        have hev_neg : (fun t : ℂ => g_z (-t)) =ᶠ[nhds (0 : ℂ)] g_z := by
          filter_upwards [Metric.ball_mem_nhds (0 : ℂ) (mul_pos zero_lt_two hr_Z_pos)] with t ht
          rw [Metric.mem_ball, dist_zero_right] at ht
          dsimp only [g_z]
          rw [(hv_props z t hz ht).2.2.2.1]
        have h1 : iteratedDeriv k (fun t : ℂ => g_z (-t)) 0 = iteratedDeriv k g_z 0 :=
          hev_neg.iteratedDeriv_eq k
        rw [iteratedDeriv_comp_neg k g_z 0, neg_zero, smul_eq_mul, hodd.neg_one_pow,
          neg_one_mul] at h1
        have h0 : iteratedDeriv k g_z 0 = 0 := by linear_combination -h1 / 2
        change iteratedDeriv k g_z 0 / (k.factorial : ℂ) = 0
        rw [h0, zero_div]
    have hana_jets : ∀ j : ℕ, AnalyticAt ℂ (v_jet j) z₀ := by
      intro j
      by_cases hj0 : j = 0
      · subst hj0
        have hfn : v_jet 0 = fun _ => 0 := funext hv_jet_zero
        rw [hfn]
        exact analyticAt_const
      · let F_sub : ℂ × ℂ → ℂ := fun p => v_loc z₀ p - p.1
        have hF_sub_holo : DifferentiableOn ℂ F_sub W_Z := hv_holo.sub differentiableOn_fst
        have hiter_holo : DifferentiableOn ℂ (iterDerivYT 0 (2 * j) F_sub) W_Z :=
          hiterYT_holo hWZ_open hF_sub_holo 0 (2 * j)
        let slice_j : ℂ → ℂ :=
          fun z => iterDerivYT 0 (2 * j) F_sub (z, 0) / ((2 * j).factorial : ℂ)
        have hslice_holo : DifferentiableOn ℂ slice_j (Metric.ball z₀ (2 * r_Z)) := by
          refine (hiter_holo.comp (differentiable_id.prodMk (differentiable_const (0 : ℂ))).differentiableOn ?_).div_const _
          intro z hz
          exact ⟨hz, Metric.mem_ball_self (mul_pos zero_lt_two hr_Z_pos)⟩
        have hslice_ana : AnalyticAt ℂ slice_j z₀ :=
          hslice_holo.analyticAt (Metric.ball_mem_nhds z₀ (mul_pos zero_lt_two hr_Z_pos))
        refine hslice_ana.congr ?_
        filter_upwards [Metric.ball_mem_nhds z₀ (mul_pos zero_lt_two hr_Z_pos)] with z hz
        rw [Metric.mem_ball, dist_eq_norm] at hz
        have hjet := hv_jets z hz (2 * j)
        have hev2j : Even (2 * j) := even_two_mul j
        have hdiv2j : (2 * j) / 2 = j := by omega
        simp only [hev2j, ↓reduceIte, hdiv2j] at hjet
        rw [← hjet, iteratedDeriv_eq_iterate]
        rfl
    exact ⟨hana_jets, r_Z, hr_Z_pos, hz_ball_punc, h2r_lt_δ₀, hv_holo, hv_props, hv_zero, hv_jets⟩
  
  have h_w_refl : ∀ z₀ : ℂ, 0 < ‖z₀‖ → ‖z₀‖ < S.δ₁ →
      ∃ (r : ℝ) (v : ℂ × ℂ → ℂ),
        0 < r ∧
        (∀ z : ℂ, ‖z - z₀‖ < 2 * r → 0 < ‖z‖ ∧ ‖z‖ < S.δ₁) ∧
        2 * r < G.δ₀ ∧
        DifferentiableOn ℂ v (Metric.ball z₀ (2 * r) ×ˢ Metric.ball (0 : ℂ) (2 * r)) ∧
        (∀ z t : ℂ, ‖z - z₀‖ < 2 * r → ‖t‖ < 2 * r →
          0 < ‖v (z, t)‖ ∧ ‖v (z, t)‖ < S.δ₁ ∧
          G.D_ZW (z, t) ≠ 0 ∧
          v (z, -t) = v (z, t) ∧
          G.N_Z (z, t) / G.D_ZW (z, t) = G.Z_loc (v (z, t)) ∧
          G.N_W (z, t) / G.D_ZW (z, t) = G.W_loc (v (z, t))) ∧
        (∀ z : ℂ, ‖z - z₀‖ < 2 * r → v (z, 0) = z) ∧
        (∀ z : ℂ, ‖z - z₀‖ < 2 * r → ∀ k : ℕ,
          iteratedDeriv k (fun t => v (z, t) - z) 0 / (k.factorial : ℂ) =
            if Even k then v_jet (k / 2) z else 0) ∧
        (∀ z t : ℂ, ‖z - z₀‖ < r → ‖t‖ < r →
          normDiffQuot G.Z_loc (v (z, t)) (-(v (z, t) - v (z - t, t))) *
            normDiffQuot G.Z_loc (v (z, t)) (v (z + t, t) - v (z, t)) -
          normDiffQuot G.W_loc (v (z, t)) (-(v (z, t) - v (z - t, t))) *
            normDiffQuot G.W_loc (v (z, t)) (v (z + t, t) - v (z, t)) = 0) := by
    intro z₀ hz₀_pos hz₀_lt
    have hz₀_δ₀ : ‖z₀‖ < G.δ₀ := lt_of_lt_of_le hz₀_lt S.δ₁_le
    obtain ⟨_, r_Z, hr_Z_pos, hz_ball_punc, h2rZ_lt_δ₀, hv_holo, hv_props, hv_zero, hv_jets⟩ :=
      h_z_lift z₀ hz₀_pos hz₀_lt
    let v : ℂ × ℂ → ℂ := v_loc z₀
    obtain ⟨r_rk, hr_rk_pos, hr_rk⟩ := G.rank_one_punc z₀ hz₀_pos hz₀_δ₀
    obtain ⟨r_iso, hr_iso_pos, hr_iso⟩ := G.iso_reflect_punc z₀ hz₀_pos hz₀_δ₀
    set r₁ : ℝ := min (2 * r_Z) r_rk
    have hr₁_pos : 0 < r₁ := lt_min (by positivity) hr_rk_pos
    have hr₁_le_2rZ : r₁ ≤ 2 * r_Z := min_le_left _ _
    have hr₁_le_rk : r₁ ≤ r_rk := min_le_right _ _
    let W₁ : Set (ℂ × ℂ) := Metric.ball z₀ r₁ ×ˢ Metric.ball (0 : ℂ) r₁
    have hW₁_open : IsOpen W₁ := Metric.isOpen_ball.prod Metric.isOpen_ball
    have hW₁_preconn : IsPreconnected W₁ :=
      ((convex_ball z₀ r₁).prod (convex_ball (0 : ℂ) r₁)).isPreconnected
    have hp₀_W₁ : (z₀, (0 : ℂ)) ∈ W₁ :=
      ⟨Metric.mem_ball_self hr₁_pos, Metric.mem_ball_self hr₁_pos⟩
    have hW₁_sub_WZ : W₁ ⊆ Metric.ball z₀ (2 * r_Z) ×ˢ Metric.ball (0 : ℂ) (2 * r_Z) :=
      Set.prod_mono (Metric.ball_subset_ball hr₁_le_2rZ) (Metric.ball_subset_ball hr₁_le_2rZ)
    have hW₁_sub_B : W₁ ⊆ Metric.ball (0 : ℂ) G.δ₀ ×ˢ Metric.ball (0 : ℂ) G.δ₀ := by
      rintro ⟨z, t⟩ ⟨hz, ht⟩
      rw [Metric.mem_ball, dist_eq_norm] at hz
      rw [Metric.mem_ball, dist_zero_right] at ht
      have hz_lt : ‖z‖ < G.δ₀ :=
        lt_of_lt_of_le (hz_ball_punc z (lt_of_lt_of_le hz hr₁_le_2rZ)).2 S.δ₁_le
      have ht_lt : ‖t‖ < G.δ₀ := lt_trans (lt_of_lt_of_le ht hr₁_le_2rZ) h2rZ_lt_δ₀
      exact ⟨Metric.mem_ball.mpr (by simpa using hz_lt),
        Metric.mem_ball.mpr (by simpa using ht_lt)⟩
    let U₁ : Set ℂ := {w : ℂ | 0 < ‖w‖ ∧ ‖w‖ < S.δ₁}
    have hU₁_open : IsOpen U₁ :=
      (isOpen_lt continuous_const continuous_norm).inter (isOpen_lt continuous_norm continuous_const)
    have hZ_holo_U₁ : DifferentiableOn ℂ G.Z_loc U₁ :=
      fun w hw => (G.reg_on_punctured w hw.1 (lt_of_lt_of_le hw.2 S.δ₁_le)).1.differentiableAt.differentiableWithinAt
    have hW_holo_U₁ : DifferentiableOn ℂ G.W_loc U₁ :=
      fun w hw => (G.reg_on_punctured w hw.1 (lt_of_lt_of_le hw.2 S.δ₁_le)).2.1.differentiableAt.differentiableWithinAt
    have hv_W₁ : DifferentiableOn ℂ v W₁ := hv_holo.mono hW₁_sub_WZ
    have hv_maps_U₁ : ∀ p ∈ W₁, v p ∈ U₁ := by
      rintro ⟨z, t⟩ ⟨hz, ht⟩
      rw [Metric.mem_ball, dist_eq_norm] at hz
      rw [Metric.mem_ball, dist_zero_right] at ht
      have hp := hv_props z t (lt_of_lt_of_le hz hr₁_le_2rZ) (lt_of_lt_of_le ht hr₁_le_2rZ)
      exact ⟨hp.1, hp.2.1⟩
    have hD_ne_W₁ : ∀ p ∈ W₁, G.D_ZW p ≠ 0 := by
      rintro ⟨z, t⟩ ⟨hz, ht⟩
      rw [Metric.mem_ball, dist_eq_norm] at hz
      rw [Metric.mem_ball, dist_zero_right] at ht
      exact (hv_props z t (lt_of_lt_of_le hz hr₁_le_2rZ) (lt_of_lt_of_le ht hr₁_le_2rZ)).2.2.1
    let X_Z : ℂ × ℂ → ℂ := fun p => G.N_Z p / G.D_ZW p
    let X_W : ℂ × ℂ → ℂ := fun p => G.N_W p / G.D_ZW p
    have hXZ_W₁ : DifferentiableOn ℂ X_Z W₁ := by
      have hfn : X_Z = fun p => G.N_Z p * (G.D_ZW p)⁻¹ := by
