      have hden : 0 < 16 * (C_init + 1) := by positivity
      have hlt : 2 * C_init * (1 / (16 * (C_init + 1))) < 1 / 8 := by
        rw [mul_one_div, div_lt_div_iff₀ hden (by norm_num)]
        linarith
      exact lt_of_le_of_lt hmul hlt
    refine ⟨ρ_sub, C_init, hρ_sub_pos, hρ_sub_lt_min, hC_init_nonneg, ?_, ?_, ?_⟩
    · intro y t hy ht
      exact h_tube y t (by dsimp [H₃]; linarith) (lt_trans ht hρ_sub_lt_ρ₀)
    · intro y t hy ht
      exact h_quad_H₂ y t (by dsimp [H₂]; linarith) (le_of_lt (lt_trans ht hρ_sub_lt_rm))
    · intro y t hy ht_ne ht
      have hU₁_open : IsOpen (horizStrip H₁) :=
        isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const
      let s_p : ℂ → ℂ := fun z => S.𝔰 (z - t, t)
      let s_c : ℂ → ℂ := fun z => S.𝔰 (z, t)
