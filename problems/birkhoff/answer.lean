      mul_pos (mul_pos hh_pos (hX.f_real_pos u).1) (mul_pos hh_pos (hX.f_real_pos v).1)
    have ha₀_eq_g₀ : a₀ = g₀ 0 := by dsimp [a₀, g₀, z_fn]; simp
    have hb₁_eq_g₀ : a₀ * c0Kernel Q 1 + a₁ * k0Kernel Q 1 = g₀ 1 := by
      have hend := (hode.2 1 ⟨zero_le_one, le_rfl⟩).1
      simp only [Complex.ofReal_one, one_mul] at hend
      have hv_eq : (u : ℂ) + (h : ℂ) = (v : ℂ) := by dsimp [h]; push_cast; ring
      rw [hend, hv_eq]
      dsimp [g₀, z_fn]
      have huv_eq : u + 1 * h = v := by dsimp [h]; ring
      rw [huv_eq]
    let κ_pos : ℝ := b_prod_R / (X.c * h ^ 3)
    have hκ_pos : 0 < κ_pos := div_pos hb_prod_pos (mul_pos hX.c_pos (pow_pos hh_pos 3))
    let A_arc : ℝ := ∫ z in u..v, X.c * ((X.f (z : ℂ)).re)⁻¹ ^ 2
    have hk0_eq : k0Kernel Q 1 = ((κ_pos * A_arc : ℝ) : ℂ) := by
      have hwron := (hVolt.1 Q hQ_cont).2.2.2.2.2.2.2.2.2.2 g₀ g₀'
        hg₀_cont.continuousOn hg₀'_cont.continuousOn
        (fun w _ => ⟨hg₀_ne w, (hg₀_deriv w).hasDerivWithinAt, (hg₀'_deriv w).hasDerivWithinAt⟩)
      rw [hwron, hg₀_0, hg₀_1]
      let φ_arc : ℝ → ℝ := fun z => X.c * ((X.f (z : ℂ)).re)⁻¹ ^ 2
      have h_int_eq : (∫ w in (0 : ℝ)..1, (g₀ w)⁻¹ ^ 2) =
          (((X.c * h ^ 3)⁻¹ * A_arc : ℝ) : ℂ) := by
        have h_pt : ∀ w : ℝ, (g₀ w)⁻¹ ^ 2 =
            (((X.c * h ^ 3)⁻¹ * (h * φ_arc (u + h * w)) : ℝ) : ℂ) := by
          intro w
          let r_f : ℝ := (X.f ((u + w * h : ℝ) : ℂ)).re
          have hfx_pos : 0 < r_f := (hX.f_real_pos (u + w * h)).1
          have hw_comm : u + h * w = u + w * h := by ring
          have hg0_w : g₀ w = (h : ℂ) * (r_f : ℂ) := by
            dsimp [g₀, z_fn, r_f]
            rw [← hf_real_eq (u + w * h)]
          have hφ_w : φ_arc (u + h * w) = X.c * r_f⁻¹ ^ 2 := by
            dsimp [φ_arc, r_f]; rw [hw_comm]
          rw [hg0_w, hφ_w]
          push_cast
          have hc_ne : (X.c : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hX.c_pos.ne'
          have hf_ne : (r_f : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hfx_pos.ne'
          field_simp [hc_ne, hh_c_ne, hf_ne]
        simp_rw [h_pt]
        rw [intervalIntegral.integral_ofReal]
        congr 1
        rw [intervalIntegral.integral_const_mul, intervalIntegral.integral_const_mul,
          intervalIntegral.mul_integral_comp_add_mul h u]
        have h0 : u + h * 0 = u := by ring
        have h1 : u + h * 1 = v := by dsimp [h]; ring
        rw [h0, h1]
      rw [h_int_eq]
      dsimp [κ_pos, b_prod_R]
      push_cast
      ring
    let ΔΓ₀ : ℝ := (X.Γ_base (v : ℂ) 0).re - (X.Γ_base (u : ℂ) 0).re
    let ΔΓ₁ : ℝ := (X.Γ_base (v : ℂ) 1).re - (X.Γ_base (u : ℂ) 1).re
    let θ_mid : ℝ := ((X.ϕ (u : ℂ)).re + (X.ϕ (v : ℂ)).re) / 2
    have h_euler : ∀ (sgn θ : ℂ), (sgn = 1 ∨ sgn = -1) →
        Complex.cos θ + sgn * Complex.I * Complex.sin θ = Complex.exp (sgn * Complex.I * θ) := by
      intro sgn θ hsgn
      rcases hsgn with rfl | rfl
      · have h1 := Complex.exp_mul_I θ
        have h2 : (1 : ℂ) * Complex.I * θ = θ * Complex.I := by ring
        rw [h2, h1]; ring
      · have h1 := Complex.exp_mul_I (-θ)
        rw [Complex.cos_neg, Complex.sin_neg] at h1
        have h2 : (-1 : ℂ) * Complex.I * θ = (-θ) * Complex.I := by ring
        rw [h2, h1]; ring
    have hk_sgn_eq : ∀ sgn : ℂ, (sgn = 1 ∨ sgn = -1) →
        k0Kernel (pertPotential sgn Q a₀ a₁) 1 =
          (κ_pos : ℂ) * Complex.exp (-sgn * (θ_mid : ℂ) * Complex.I) *
            ((ΔΓ₁ : ℂ) - sgn * Complex.I * (ΔΓ₀ : ℂ)) := by
      intro sgn hsgn
      have hsgn_sq : sgn ^ 2 = 1 := by rcases hsgn with rfl | rfl <;> norm_num
      obtain ⟨hQs_cont, _⟩ := h_pert_cont_and_bdd sgn hsgn
      let c_exp : ℂ := -sgn * Complex.I / 2
      have hcexp_sq : c_exp ^ 2 = -(1 / 4 : ℂ) := by
        dsimp [c_exp]
        calc (-sgn * Complex.I / 2) ^ 2 = sgn ^ 2 * Complex.I ^ 2 / 4 := by ring
          _ = -(1 / 4 : ℂ) := by rw [hsgn_sq, Complex.I_sq]; norm_num
      let Φ_fn : ℝ → ℂ := fun w => X.ϕ (z_fn w) - X.ϕ (u : ℂ)
      have hΦ_deriv : ∀ w : ℝ, HasDerivAt Φ_fn (g₀ w) w := by
        intro w
        have hϕ_at : HasDerivAt X.ϕ (deriv X.ϕ (z_fn w)) (z_fn w) :=
          (hX.ϕ_holo.differentiableAt (hX.D_strip_open.mem_nhds (h_real_D _))).hasDerivAt
        refine hasDerivAt_congr_d ((hϕ_at.scomp w (hz_deriv w)).sub_const (X.ϕ (u : ℂ))) ?_
        dsimp [g₀]
        rw [hX.deriv_ϕ (z_fn w) (h_real_D _)]
      let E_sgn : ℝ → ℂ := fun w => Complex.exp (c_exp * Φ_fn w)
      have hE_deriv : ∀ w : ℝ, HasDerivAt E_sgn (E_sgn w * (c_exp * g₀ w)) w :=
        fun w => ((hΦ_deriv w).const_mul c_exp).cexp
      let g_sgn : ℝ → ℂ := fun w => g₀ w * E_sgn w
      let g_sgn' : ℝ → ℂ := fun w => (g₀' w + c_exp * (g₀ w) ^ 2) * E_sgn w
      have hgs_deriv : ∀ w : ℝ, HasDerivAt g_sgn (g_sgn' w) w := by
        intro w
        exact hasDerivAt_congr_d ((hg₀_deriv w).mul (hE_deriv w)) (by dsimp [g_sgn']; ring)
      have hgs'_deriv : ∀ w : ℝ,
          HasDerivAt g_sgn'
            ((Q w + 3 * c_exp * g₀' w + c_exp ^ 2 * (g₀ w) ^ 2) * g_sgn w) w := by
        intro w
        have hpow2 : HasDerivAt (fun x => (g₀ x) ^ 2) (2 * g₀ w * g₀' w) w :=
          hasDerivAt_congr_d ((hg₀_deriv w).pow 2) (by dsimp; ring)
        have hA_d : HasDerivAt (fun x => g₀' x + c_exp * (g₀ x) ^ 2)
            (Q w * g₀ w + c_exp * (2 * g₀ w * g₀' w)) w :=
          (hg₀'_deriv w).add (hpow2.const_mul c_exp)
        exact hasDerivAt_congr_d (hA_d.mul (hE_deriv w)) (by dsimp [g_sgn]; ring)
      have hgs_cont : Continuous g_sgn :=
        continuous_iff_continuousAt.mpr (fun w => (hgs_deriv w).continuousAt)
      have hgs'_cont : Continuous g_sgn' :=
        continuous_iff_continuousAt.mpr (fun w => (hgs'_deriv w).continuousAt)
      have hgs_ne : ∀ w : ℝ, g_sgn w ≠ 0 :=
        fun w => mul_ne_zero (hg₀_ne w) (Complex.exp_ne_zero _)
      have hwron := (hVolt.1 (pertPotential sgn Q a₀ a₁) hQs_cont).2.2.2.2.2.2.2.2.2.2
        g_sgn g_sgn' hgs_cont.continuousOn hgs'_cont.continuousOn ?_
      · rw [hwron]
        let Z_sgn : ℝ → ℂ := fun w => X.Γ_base (z_fn w) 1 - sgn * Complex.I * X.Γ_base (z_fn w) 0
        let Z_sgn' : ℝ → ℂ := fun w =>
          (h : ℂ) * (X.c : ℂ) * (X.f (z_fn w))⁻¹ ^ 2 *
            Complex.exp (sgn * Complex.I * X.ϕ (z_fn w))
        have hZ_deriv : ∀ w : ℝ, HasDerivAt Z_sgn (Z_sgn' w) w := by
          intro w
          have hΓ0_at : HasDerivAt (fun z => X.Γ_base z 0)
              (deriv (fun z => X.Γ_base z 0) (z_fn w)) (z_fn w) :=
            (hX.Γ_base_holo.1.differentiableAt
              ((isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const).mem_nhds
                (h_real_base _))).hasDerivAt
          have hΓ1_at : HasDerivAt (fun z => X.Γ_base z 1)
              (deriv (fun z => X.Γ_base z 1) (z_fn w)) (z_fn w) :=
            (hX.Γ_base_holo.2.differentiableAt
              ((isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const).mem_nhds
                (h_real_base _))).hasDerivAt
          have h0_w := hΓ0_at.scomp w (hz_deriv w)
          have h1_w := hΓ1_at.scomp w (hz_deriv w)
          refine hasDerivAt_congr_d (h1_w.sub (h0_w.const_mul (sgn * Complex.I))) ?_
          dsimp [Z_sgn']
          rw [hX.Γ_base_deriv₀ (z_fn w) (h_real_base _),
            hX.Γ_base_deriv₁ (z_fn w) (h_real_base _),
            ← h_euler sgn (X.ϕ (z_fn w)) hsgn]
          ring
        have hZ'_cont : Continuous Z_sgn' := by
          refine ((continuous_const.mul ?_).mul ?_)
          · refine Continuous.pow ?_ 2
            exact Continuous.inv₀
              (hX.f_holo.continuousOn.comp_continuous hz_cont (fun w => h_real_D (u + w * h)))
              (fun w => hX.f_lower_strip_ne_zero (z_fn w) (h_real_base _))
          · refine Complex.continuous_exp.comp (continuous_const.mul ?_)
            exact hX.ϕ_holo.continuousOn.comp_continuous hz_cont (fun w => h_real_D (u + w * h))
        have h_ftc : ∫ w in (0 : ℝ)..1, Z_sgn' w = Z_sgn 1 - Z_sgn 0 :=
          intervalIntegral.integral_eq_sub_of_hasDerivAt
            (fun w _ => hZ_deriv w) (hZ'_cont.intervalIntegrable 0 1)
        have h_integrand : ∀ w : ℝ, (g_sgn w)⁻¹ ^ 2 =
            (((X.c * h ^ 3)⁻¹ : ℝ) : ℂ) * Complex.exp (-sgn * Complex.I * X.ϕ (u : ℂ)) *
              Z_sgn' w := by
          intro w
          have hexp_inv : (E_sgn w)⁻¹ ^ 2 =
              Complex.exp (-sgn * Complex.I * X.ϕ (u : ℂ)) *
                Complex.exp (sgn * Complex.I * X.ϕ (z_fn w)) := by
            dsimp [E_sgn, Φ_fn, c_exp]
            rw [sq, ← Complex.exp_neg, ← Complex.exp_add, ← Complex.exp_add]
            congr 1; ring
          have hg0_inv : (g₀ w)⁻¹ ^ 2 =
              (((X.c * h ^ 3)⁻¹ : ℝ) : ℂ) * ((h : ℂ) * (X.c : ℂ) * (X.f (z_fn w))⁻¹ ^ 2) := by
            dsimp [g₀]
            push_cast
            have hc_ne : (X.c : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hX.c_pos.ne'
            have hf_ne : X.f (z_fn w) ≠ 0 := hX.f_lower_strip_ne_zero (z_fn w) (h_real_base _)
            field_simp [hc_ne, hh_c_ne, hf_ne]
          dsimp [g_sgn, Z_sgn']
          rw [mul_inv, mul_pow, hg0_inv, hexp_inv]
          ring
        simp_rw [h_integrand]
        rw [intervalIntegral.integral_const_mul, h_ftc]
        have hgs_0 : g_sgn 0 = g₀ 0 := by
          dsimp [g_sgn, E_sgn, Φ_fn, z_fn]; simp
        have hgs_1 : g_sgn 1 = g₀ 1 * Complex.exp (c_exp * (X.ϕ (v : ℂ) - X.ϕ (u : ℂ))) := by
          dsimp [g_sgn, E_sgn, Φ_fn, z_fn]
          have huv_eq : u + 1 * h = v := by dsimp [h]; ring
          rw [huv_eq]
        have hZ_diff : Z_sgn 1 - Z_sgn 0 = (ΔΓ₁ : ℂ) - sgn * Complex.I * (ΔΓ₀ : ℂ) := by
          dsimp [Z_sgn, z_fn]
          have huv_eq : u + 1 * h = v := by dsimp [h]; ring
          rw [zero_mul, add_zero, huv_eq,
            hΓ_real_eq u 0, hΓ_real_eq u 1, hΓ_real_eq v 0, hΓ_real_eq v 1]
          dsimp [ΔΓ₀, ΔΓ₁]
          push_cast; ring
        have hexp_comb : Complex.exp (c_exp * (X.ϕ (v : ℂ) - X.ϕ (u : ℂ))) *
            Complex.exp (-sgn * Complex.I * X.ϕ (u : ℂ)) =
            Complex.exp (-sgn * (θ_mid : ℂ) * Complex.I) := by
          rw [← Complex.exp_add, hϕ_real_eq u, hϕ_real_eq v]
          congr 1
          dsimp [c_exp, θ_mid]
          push_cast; ring
        rw [hgs_0, hgs_1, hg₀_0, hg₀_1, hZ_diff]
        calc ((h * (X.f (u : ℂ)).re : ℝ) : ℂ) *
              (((h * (X.f (v : ℂ)).re : ℝ) : ℂ) * Complex.exp (c_exp * (X.ϕ (v : ℂ) - X.ϕ (u : ℂ)))) *
              ((((X.c * h ^ 3)⁻¹ : ℝ) : ℂ) * Complex.exp (-sgn * Complex.I * X.ϕ (u : ℂ)) *
                ((ΔΓ₁ : ℂ) - sgn * Complex.I * (ΔΓ₀ : ℂ)))
            = (((b_prod_R * (X.c * h ^ 3)⁻¹ : ℝ) : ℂ)) *
                (Complex.exp (c_exp * (X.ϕ (v : ℂ) - X.ϕ (u : ℂ))) *
                  Complex.exp (-sgn * Complex.I * X.ϕ (u : ℂ))) *
                ((ΔΓ₁ : ℂ) - sgn * Complex.I * (ΔΓ₀ : ℂ)) := by
              dsimp [b_prod_R]; push_cast; ring
          _ = (κ_pos : ℂ) * Complex.exp (-sgn * (θ_mid : ℂ) * Complex.I) *
                ((ΔΓ₁ : ℂ) - sgn * Complex.I * (ΔΓ₀ : ℂ)) := by
              rw [hexp_comb]; dsimp [κ_pos]; rw [div_eq_mul_inv]
      · intro w hw
        refine ⟨hgs_ne w, (hgs_deriv w).hasDerivWithinAt, ?_⟩
        have hw_ode := hode.2 w hw
        have hz_eq : (u : ℂ) + (w : ℂ) * (h : ℂ) = z_fn w := by dsimp [z_fn]; push_cast; ring
        have hFw : a₀ * c0Kernel Q w + a₁ * k0Kernel Q w = g₀ w := by
          simpa [a₀, a₁, g₀, hz_eq] using hw_ode.1
        have hFpw : a₀ * c0Deriv Q w + a₁ * k0Deriv Q w = g₀' w := by
          simpa [a₀, a₁, g₀', hz_eq] using hw_ode.2
        have hpot_eq : pertPotential sgn Q a₀ a₁ w =
            Q w + 3 * c_exp * g₀' w + c_exp ^ 2 * (g₀ w) ^ 2 := by
          unfold pertPotential
          dsimp only
          rw [hFw, hFpw, hcexp_sq]
          dsimp [c_exp]; ring
        rw [hpot_eq]
        exact (hgs'_deriv w).hasDerivWithinAt
    have hkp_form : kp = (κ_pos : ℂ) * Complex.exp (-(θ_mid : ℂ) * Complex.I) *
        ((ΔΓ₁ : ℂ) - Complex.I * (ΔΓ₀ : ℂ)) := by
      simpa [kp, kPlusVal] using hk_sgn_eq 1 (Or.inl rfl)
    have hkm_form : km = (κ_pos : ℂ) * Complex.exp ((θ_mid : ℂ) * Complex.I) *
        ((ΔΓ₁ : ℂ) + Complex.I * (ΔΓ₀ : ℂ)) := by
      have h1 := hk_sgn_eq (-1) (Or.inr rfl)
      dsimp [km, kMinusVal]
      convert h1 using 2
      · congr 1; ring
      · ring
    have hkm_conj : km = starRingEnd ℂ kp := by
      rw [hkp_form, hkm_form, map_mul, map_mul, Complex.conj_ofReal, ← Complex.exp_conj]
      simp only [map_neg, map_mul, map_sub, Complex.conj_ofReal, Complex.conj_I]
      congr 2
      · congr 1; ring
      · ring
    let L_chord : ℝ := Real.sqrt (ΔΓ₀ ^ 2 + ΔΓ₁ ^ 2)
    have hkp_norm : ‖kp‖ = κ_pos * L_chord := by
      rw [hkp_form, norm_mul, norm_mul]
      have h1 : ‖(κ_pos : ℂ)‖ = κ_pos := by
        rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos hκ_pos]
      have h2 : ‖Complex.exp (-(θ_mid : ℂ) * Complex.I)‖ = 1 := by
        have : -(θ_mid : ℂ) * Complex.I = ((-θ_mid : ℝ) : ℂ) * Complex.I := by push_cast; ring
        rw [this, Complex.norm_exp_ofReal_mul_I]
      have h3 : ‖(ΔΓ₁ : ℂ) - Complex.I * (ΔΓ₀ : ℂ)‖ = L_chord := by
        rw [Complex.norm_def]
        dsimp [L_chord]
        congr 1
        simp only [Complex.normSq_apply, Complex.sub_re, Complex.sub_im, Complex.ofReal_re,
          Complex.ofReal_im, Complex.mul_re, Complex.mul_im, Complex.I_re, Complex.I_im]
        ring
      rw [h1, h2, h3, mul_one]
    let r_rat : ℝ := ‖kp‖ / m_R
    have hr_rat_pos : 0 < r_rat := div_pos hkp_norm_pos hm_R_pos
    have hcanon_eq : canonRoot Q a₀ a₁ = ((κ_pos * L_chord : ℝ) : ℂ) := by
      unfold canonRoot
      change ((kp + km) / 2) * Complex.exp ((1 / 2 : ℂ) * Complex.log (4 * kp * km / (kp + km) ^ 2)) =
        ((κ_pos * L_chord : ℝ) : ℂ)
      have hsum : kp + km = ((2 * m_R : ℝ) : ℂ) := by
        rw [hkm_conj, Complex.add_conj]
      have hprod : kp * km = ((‖kp‖ ^ 2 : ℝ) : ℂ) := by
        rw [hkm_conj, Complex.mul_conj']; norm_cast
      have hquot : 4 * kp * km / (kp + km) ^ 2 = ((r_rat ^ 2 : ℝ) : ℂ) := by
        rw [mul_assoc 4 kp km, hprod, hsum]
        dsimp [r_rat]
        have hm_ne : (m_R : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hm_R_pos.ne'
        push_cast
        field_simp [hm_ne]
        ring
      rw [hquot, hsum]
      have hlog : Complex.log ((r_rat ^ 2 : ℝ) : ℂ) = ((2 * Real.log r_rat : ℝ) : ℂ) := by
        rw [← Complex.ofReal_log (by positivity), Real.log_pow]
        push_cast; rfl
      rw [hlog]
      have hhalf : (1 / 2 : ℂ) * ((2 * Real.log r_rat : ℝ) : ℂ) = (Real.log r_rat : ℂ) := by
        push_cast; ring
      rw [hhalf, ← Complex.ofReal_exp, Real.exp_log hr_rat_pos]
      have hcalc : (((2 * m_R : ℝ) : ℂ) / 2) * (r_rat : ℂ) = (‖kp‖ : ℂ) := by
        dsimp [r_rat]
        have hm_ne : (m_R : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hm_R_pos.ne'
        push_cast
        field_simp [hm_ne]
      rw [hcalc, hkp_norm]
    have hphi_val : chordPhi X (u : ℂ) (h : ℂ) =
        (k0Kernel Q 1 - canonRoot Q a₀ a₁) / (b_prod_R : ℂ) := by
      unfold chordPhi
      rw [if_neg hh_c_ne]
      have hv_eq : (u : ℂ) + (h : ℂ) = (v : ℂ) := by dsimp [h]; push_cast; ring
      have hcond : (u : ℂ) ∈ X.D_strip ∧ (u : ℂ) + (h : ℂ) ∈ X.D_strip ∧ k0Kernel Q 1 ≠ 0 :=
        ⟨h_real_D u, hv_eq ▸ h_real_D v, hk0_ne⟩
      rw [if_pos hcond]
      change slDivided Q a₀ a₁ = _
      unfold slDivided
      dsimp only
      rw [hb₁_eq_g₀, ha₀_eq_g₀, hg₀_0, hg₀_1]
      have hb0_ne : ((h * (X.f (u : ℂ)).re : ℝ) : ℂ) ≠ 0 :=
        Complex.ofReal_ne_zero.mpr (mul_pos hh_pos (hX.f_real_pos u).1).ne'
      have hb1_ne : ((h * (X.f (v : ℂ)).re : ℝ) : ℂ) ≠ 0 :=
        Complex.ofReal_ne_zero.mpr (mul_pos hh_pos (hX.f_real_pos v).1).ne'
      rw [if_pos ⟨hb0_ne, hb1_ne⟩]
      congr 1
      dsimp [b_prod_R]; push_cast; rfl
    change ((X.c * h ^ 3 : ℝ) : ℂ) * chordPhi X (u : ℂ) (h : ℂ) =
      ((A_arc - L_chord : ℝ) : ℂ)
    rw [hphi_val, hk0_eq, hcanon_eq]
    dsimp [κ_pos]
    have hb_ne : (b_prod_R : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hb_prod_pos.ne'
    have hc_ne : (X.c : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hX.c_pos.ne'
    push_cast
    field_simp [hb_ne, hc_ne, hh_c_ne]
  have mod_two_pi_strip : ∀ {H : ℝ} (_hH : 0 < H) (G : ℂ → ℝ),
      (∀ z ∈ horizStrip H, G (z + 2 * Real.pi) = G z) →
      ∀ (z : ℂ), z ∈ horizStrip H →
      ∃ x₀ ∈ Set.Icc (0 : ℝ) (2 * Real.pi),
        G z = G ((x₀ : ℂ) + (z.im : ℂ) * Complex.I) := by
    intro H _hH G hG_per z hz
    have h_nat : ∀ (n : ℕ) (s : ℂ), s ∈ horizStrip H →
        G (s + (((n : ℝ) * (2 * Real.pi) : ℝ) : ℂ)) = G s := by
      intro n
      induction n with
      | zero => intro s _; simp
      | succ n ih =>
        intro s hs
