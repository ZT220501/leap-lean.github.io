  have h_int_sin_sq : (∫ θ, Real.sin θ ^ 2 ∂unifTwoPiMeasure) = 1 / 2 := by
    rw [h_unif_interval, integral_sin_sq]
    simp only [Real.sin_zero, Real.sin_two_pi]
    field_simp [Real.pi_ne_zero]
    ring
  have h_step_im : ∀ (y : ℂ) (r θ : ℝ),
      (y + (r : ℂ) * Complex.exp ((θ : ℂ) * Complex.I)).im = y.im + r * Real.sin θ := by
    intro y r θ
    simp [Complex.exp_ofReal_mul_I_im]
  exact
    { prob_walk := hProbWalk
      walk_in_reg := h_walk_in_reg
      reg_phase_depth_pos_and_step := h_reg_phase_depth
      walkPos_depends := h_walkPos_depends
      measurable_im := h_meas_im
      measurable_rho := h_meas_rho
      measurable_logDepth := h_meas_logDepth
      measurable_geomCost := h_meas_geomCost
      wall_linear_drift := by
        intro n sgn E hsgn hE
        let E_pre : Set (Finset.range (n + 1) → ℝ) := padPrefix n ⁻¹' E
        have hE_pre_meas : MeasurableSet E_pre := hE.1.preimage (h_pad_meas n)
        have hE_iff : ∀ om : WalkSpace, X_pref n om ∈ E_pre ↔ om ∈ E :=
