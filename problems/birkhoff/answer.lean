      rw [← mul_div_cancel_left₀ (MvPowerSeries.coeff d S) hc_ne]
      exact L.div_mem hmul (h_nat_mem L _)
  have h_inv_mem : ∀ (L : Subfield ℂ) {S T : MvPowerSeries (Fin 2) ℂ},
      S * T = 1 → lineCoreCoeffsIn L T → lineCoreCoeffsIn L S := by
    intro L S T hST hT
    have h0 : MvPowerSeries.coeff 0 S * MvPowerSeries.coeff 0 T = 1 := by
      rw [MvPowerSeries.coeff_zero_eq_constantCoeff_apply,
        MvPowerSeries.coeff_zero_eq_constantCoeff_apply, ← map_mul, hST, map_one]
    have ht0_ne : MvPowerSeries.coeff 0 T ≠ 0 := right_ne_zero_of_mul_eq_one h0
    have hs0_mem : MvPowerSeries.coeff 0 S ∈ L := by
      have hs0_eq : MvPowerSeries.coeff 0 S = (MvPowerSeries.coeff 0 T)⁻¹ :=
        eq_inv_of_mul_eq_one_left h0
      rw [hs0_eq]
      exact L.inv_mem (hT 0)
    have h_ind : ∀ N : ℕ, ∀ d : Fin 2 →₀ ℕ, d 0 + d 1 = N → MvPowerSeries.coeff d S ∈ L := by
      intro N
      induction N using Nat.strong_induction_on with
      | h N ih =>
        intro d hd
        by_cases hN0 : N = 0
        · have hd0 : d = 0 := (h_eq_zero_iff d).mpr (by omega)
          rw [hd0]
          exact hs0_mem
        · have hd_ne : d ≠ 0 := fun h => hN0 (by rw [← hd, (h_eq_zero_iff d).mp h])
          have h_cd : MvPowerSeries.coeff d (S * T) = 0 := by
            rw [hST, MvPowerSeries.coeff_one]
            simp [hd_ne]
          have hd0_mem : (d, (0 : Fin 2 →₀ ℕ)) ∈ Finset.HasAntidiagonal.antidiagonal d :=
            Finset.HasAntidiagonal.mem_antidiagonal.mpr (add_zero d)
          rw [MvPowerSeries.coeff_mul, ← Finset.add_sum_erase _ _ hd0_mem] at h_cd
          let rem : ℂ :=
            ∑ p ∈ (Finset.HasAntidiagonal.antidiagonal d).erase (d, 0),
