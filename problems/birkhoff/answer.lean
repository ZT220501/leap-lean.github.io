    have hBall_raw :
        IsStripMeshDispBall (m + 2) q σ_mesh
          (2 * (q : ℝ) ^ 4 * (F_bd.C_force / (q : ℝ) ^ 4))
          (stripMeshStep_ℂ J_C q W d) :=
      hDir.maps_to_ball (m + 2) q σ_mesh (F_bd.C_force / (q : ℝ) ^ 4)
        (stripMeshForcing_ℂ J_C q W d) hq1 hσ_mesh_pos hMf_nonneg hf_bnd
    have hRad : 2 * (q : ℝ) ^ 4 * (F_bd.C_force / (q : ℝ) ^ 4) ≤ R_strip / 2 := by
