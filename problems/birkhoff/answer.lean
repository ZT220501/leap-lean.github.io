                  (lcJetMid2D α_ref i) (lcJetHalfStep2D α_ref i)) :=
              fun i => hSub.sub_mem F_val
                (hSub.mul_mem F_val
                  (hSub.comp1D_mem F_val (hh'_tr_mem i) (h_mid_ref_c0 i) (h_mid_ref_mem i))
                  (hSub.comp1D_mem F_val (fun m => (hSC_mem i m).1)
                    (h_step_ref_c0 i) (h_step_ref_mem i)))
                (hSub.mul_mem F_val
                  (hSub.comp1D_mem F_val (hh_tr_mem i) (h_mid_ref_c0 i) (h_mid_ref_mem i))
                  (hSub.comp1D_mem F_val (fun m => (hSC_mem i m).2)
