          have hH₁_holo : DifferentiableOn ℂ H₁ U₀ := hdslope_holo.mul hD_holo
          have hH₁_mul : ∀ z ∈ U₀, H₁ z * B_fn a₀ z = H z := by
            intro z hz
            have hDnz := hD_nz a₀ ha₀ z hz
            have hRnz : ((R₀ : ℝ) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hR₀_pos.ne'
            have h_alg : H₁ z * B_fn a₀ z = (z - a₀) * dslope H a₀ z := by
