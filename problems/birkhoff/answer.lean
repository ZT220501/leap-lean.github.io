      have hprod := (hΔx₀_div i).mul hrem_lim
      have hlim_eq : (1 / (k : ℂ)) * ((1 / 2 : ℂ) * r_a) = r_a / (2 * (k : ℂ)) := by ring
      rw [hlim_eq] at hprod
