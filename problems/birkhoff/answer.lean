      exact hJet.jet_mono le_rfl (by linarith) (hJet.jet_const_mul (1 - s) hcos_s)
    let S_exp : Set ℝ := Set.Icc (-6 * M) (6 * M)
    let M_exp : ℝ := Real.exp (6 * M)
