        MeasureTheory.ofReal_integral_eq_lintegral_ofReal hint hae_raw_nonneg
      have h_lint_le : (∫⁻ w, ENNReal.ofReal (K - Real.log ‖S.f w‖) ∂μ) ≤
          (∫⁻ w, (⨆ m : ℕ, ENNReal.ofReal (ldtTruncDeficit S K m w)) ∂μ) :=
        MeasureTheory.lintegral_mono (fun w => h_ofReal_le K w)
      have h_aemeas : ∀ m : ℕ, AEMeasurable (fun w => ENNReal.ofReal (ldtTruncDeficit S K m w)) μ :=
        fun m => (htrunc_int m).aestronglyMeasurable.aemeasurable.ennreal_ofReal
      have h_mono_ae : ∀ᵐ w ∂μ, Monotone (fun m : ℕ => ENNReal.ofReal (ldtTruncDeficit S K m w)) :=
        Filter.Eventually.of_forall fun w m₁ m₂ hm =>
          ENNReal.ofReal_le_ofReal (h_monotone_trunc K w hm)
      rw [MeasureTheory.lintegral_iSup' h_aemeas h_mono_ae] at h_lint_le
      have h_sup_le : (⨆ m : ℕ, ∫⁻ w, ENNReal.ofReal (ldtTruncDeficit S K m w) ∂μ) ≤
