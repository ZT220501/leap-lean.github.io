            (Metric.sphere 0 r_y) := by
        intro w hw
        have hw_norm : ‖w‖ = r_y := by simpa [Metric.mem_sphere] using hw
        have hw_B32 : w ∈ B32 := by
          rw [Metric.mem_ball, dist_zero_right, hw_norm]; linarith
        have hne_L : ∀ α ∈ L, w - α ≠ 0 := by
          intro α hα h0
          rw [sub_eq_zero.mp h0] at hw_norm
