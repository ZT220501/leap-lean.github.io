        have h_lsc_p2 : S.h_X (t_k : ℂ) - ε_patch / 4 < S.h_X p.2 :=
          hδ₁ (by rw [dist_eq_norm]; exact lt_of_lt_of_le hp_t hδ_le_δ₁)
        linarith
      exact ⟨hp2_norm_lt, by linarith [S.s_star_pos], h_im_upper⟩

  
  have hStrip_base : ∀ a b : ℝ, 0 < a → a ≤ b → ∃ N_ab : ℕ, ∀ n ≥ N_ab,
      (R.m_seq n)⁻¹ < S.r_star →
      S.H - S.h_X (((R.m_seq n)⁻¹ : ℝ) : ℂ) < a * R.d_seq n →
      ∀ ξ : ℝ,
        DifferentiableOn ℂ (rescaledLift ξ (R.d_seq n) (R.m_seq n))
          { Y : ℂ | -b < Y.im ∧ Y.im < -a } ∧
        ∀ Y : ℂ, -b < Y.im → Y.im < -a →
          rescaledLift ξ (R.d_seq n) (R.m_seq n) Y ∈ superlinearLowerHalfPlane := by
    intro a b ha hab
    obtain ⟨N_ab, hN_ab⟩ := exists_nat_gt (b / S.H)
    refine ⟨N_ab, ?_⟩
    intro n hn ht_lt hwidth ξ
    have hb_dn_lt : b * R.d_seq n < S.H := by
      have hpos_b : 0 < b := lt_of_lt_of_le ha hab
      have h1 : b / S.H < (n : ℝ) + 1 := by
        have : (N_ab : ℝ) ≤ (n : ℝ) := Nat.cast_le.mpr hn
        linarith
      have h2 : b * (1 / ((n : ℝ) + 1)) < S.H := by
        rw [mul_one_div, div_lt_iff₀ (by positivity)]
        have := (div_lt_iff₀ S.H_pos).mp h1
        linarith
      exact lt_of_le_of_lt (mul_le_mul_of_nonneg_left (hd_le_inv n) hpos_b.le) h2
    let U_ab : Set ℂ := { Y : ℂ | -b < Y.im ∧ Y.im < -a }
    let Φ : ℂ → ℂ × ℂ := fun Y =>
      ((ξ : ℂ) + (S.H : ℂ) * Complex.I + (R.d_seq n : ℂ) * Y, (((R.m_seq n)⁻¹ : ℝ) : ℂ))
    have hΦ_diff : Differentiable ℂ Φ := by fun_prop
    have hΦ_maps : Set.MapsTo Φ U_ab (finiteWallTube S.r_star S.h_X) := by
      intro Y hY
      have h2_norm : ‖(Φ Y).2‖ < S.r_star := by
        simpa [Φ, abs_of_pos (hm_pos n)] using ht_lt
      have hconj_ball : starRingEnd ℂ (Φ Y).2 ∈ Metric.ball (0 : ℂ) S.r_star := by
        simpa [Metric.mem_ball, dist_zero_right] using h2_norm
      have h_ss : S.s_star ≤ S.h_X (starRingEnd ℂ (Φ Y).2) :=
        (S.h_X_bounds _ hconj_ball).1
      have h1_im : (Φ Y).1.im = S.H + R.d_seq n * Y.im := by simp [Φ]
      refine ⟨h2_norm, ?_, ?_⟩
      · rw [h1_im]
        have : -b * R.d_seq n < R.d_seq n * Y.im := by nlinarith [hd_pos n, hY.1]
        linarith [S.s_star_pos]
      · rw [h1_im]
        have : R.d_seq n * Y.im < -a * R.d_seq n := by nlinarith [hd_pos n, hY.2]
        dsimp [Φ]
        linarith
    have hs_comp_diff : DifferentiableOn ℂ (fun Y => S.𝔰 (Φ Y)) U_ab :=
      S.𝔰_holo.comp hΦ_diff.differentiableOn hΦ_maps
    have h_lift_diff : DifferentiableOn ℂ (rescaledLift ξ (R.d_seq n) (R.m_seq n)) U_ab :=
      ((hs_comp_diff.sub (differentiableOn_const (ξ : ℂ))).sub
        (differentiableOn_const ((S.H : ℂ) * Complex.I))).div_const (R.d_seq n : ℂ)
    refine ⟨h_lift_diff, ?_⟩
    intro Y hY1 hY2
    have hs_in_strip : S.𝔰 (Φ Y) ∈ horizStrip S.H := S.𝔰_maps_to (Φ Y) (hΦ_maps ⟨hY1, hY2⟩)
    change |(S.𝔰 (Φ Y)).im| < S.H at hs_in_strip
    have hs_im_lt : (S.𝔰 (Φ Y)).im < S.H := (abs_lt.mp hs_in_strip).2
    change (rescaledLift ξ (R.d_seq n) (R.m_seq n) Y).im < 0
    dsimp [rescaledLift]
    rw [h_div_ofReal_im]
    have hnum : (S.𝔰 (Φ Y) - (ξ : ℂ) - (S.H : ℂ) * Complex.I).im = (S.𝔰 (Φ Y)).im - S.H := by
      simp [Φ]
    rw [hnum]
    exact div_neg_of_neg_of_pos (by linarith) (hd_pos n)

  obtain ⟨L_anc, δ_star_anc, _, hδs_anc_pos, hδs_anc_lt, hConeK_anc⟩ :=
    hCone (3 / 4) 1 δ_b (by norm_num) (by norm_num) zero_lt_one hδb_pos hδb_lt_half
  obtain ⟨C_cp_anc, ε₀_anc, d₀_anc, hC_cp_anc_pos, hε₀_anc_pos, hd₀_anc_pos, hPassage_anc⟩ :=
    hConeK_anc 1 zero_lt_one
  let u₀ : ℝ := max 2 (2 / ε₀_anc)
  have hu₀_ge_two : 2 ≤ u₀ := le_max_left _ _
  have hu₀_pos : 0 < u₀ := by linarith
  let D_base : ℝ := u₀ ^ (4 : ℕ)
  have hD_base_ge_16 : 16 ≤ D_base := by
    calc (16 : ℝ) = (2 : ℝ) ^ (4 : ℕ) := by norm_num
