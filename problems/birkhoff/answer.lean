      intro x₀
      refine ⟨mul_nonneg (by positivity)
        (intervalIntegral.integral_nonneg hle_2pi fun θ _ => hΦ_nonneg (γ x₀ θ)), ?_⟩
      intro z hz
      let w₀ : ℂ := (x₀ : ℂ) + (y₀ : ℂ) * Complex.I
      have hsub : Metric.closedBall w₀ ((3 / 2 : ℝ) * r) ⊆ horizStrip S.H := by
        intro ζ hζ
        change |ζ.im| < S.H
        have hnorm : ‖ζ - w₀‖ ≤ ρ := by simpa [dist_eq_norm, ρ] using Metric.mem_closedBall.mp hζ
        have him_w0 : w₀.im = y₀ := him_rect x₀ y₀
        have him1 : |ζ.im - y₀| ≤ ‖ζ - w₀‖ := by
          rw [← him_w0, ← Complex.sub_im]
          exact Complex.abs_im_le_norm (ζ - w₀)
        calc |ζ.im| = |y₀ + (ζ.im - y₀)| := by ring_nf
          _ ≤ |y₀| + |ζ.im - y₀| := abs_add_le _ _
          _ ≤ |y₀| + ρ := by linarith
          _ < S.H := hyr
      have hcmap : ∀ θ : ℝ, circleMap w₀ ((3 / 2 : ℝ) * r) θ = γ x₀ θ := by
        intro θ
        simp only [circleMap, w₀, γ, ρ, Complex.exp_mul_I, ← Complex.ofReal_cos, ← Complex.ofReal_sin]
        push_cast
        ring
      have hf_bound := h_outer_cauchy (fun w => S.f w ^ 2) w₀ z r hr (S.f_holo.pow 2) hsub hz
      have hq_bound := h_outer_cauchy S.q w₀ z r hr S.q_holo hsub hz
      simp_rw [norm_pow, hcmap] at hf_bound
      simp_rw [hcmap] at hq_bound
      have hint_f : IntervalIntegrable (fun θ => ‖S.f (γ x₀ θ)‖ ^ 2)
          MeasureTheory.volume 0 (2 * Real.pi) :=
        ((S.f_holo.continuousOn.comp_continuous (hγ_cont.comp (continuous_const.prodMk continuous_id))
          (fun θ => hγ_mem x₀ θ)).norm.pow 2).intervalIntegrable 0 (2 * Real.pi)
      have hint_q : IntervalIntegrable (fun θ => ‖S.q (γ x₀ θ)‖)
          MeasureTheory.volume 0 (2 * Real.pi) :=
        ((S.q_holo.continuousOn.comp_continuous (hγ_cont.comp (continuous_const.prodMk continuous_id))
          (fun θ => hγ_mem x₀ θ)).norm).intervalIntegrable 0 (2 * Real.pi)
      rw [hΦ_def z]
      dsimp only [maj_fn]
      change ‖S.f z‖ ^ 2 + ‖S.q z‖ ≤
        (3 / (2 * Real.pi)) * ∫ θ in (0 : ℝ)..(2 * Real.pi), Φ (γ x₀ θ)
      simp_rw [hΦ_def]
      rw [intervalIntegral.integral_add hint_f hint_q, mul_add]
      linarith
    have h_mean : (2 * Real.pi)⁻¹ * (∫ x₀ in (0 : ℝ)..(2 * Real.pi), maj_fn y₀ r x₀) =
        (3 / (2 * Real.pi)) * ∫ θ in (0 : ℝ)..(2 * Real.pi),
          steepRowEnergy S (y₀ + (3 / 2 : ℝ) * r * Real.sin θ) := by
      dsimp only [maj_fn]
      change (2 * Real.pi)⁻¹ * (∫ x₀ in (0 : ℝ)..(2 * Real.pi),
          (3 / (2 * Real.pi)) * ∫ θ in (0 : ℝ)..(2 * Real.pi), Φ (γ x₀ θ)) = _
      rw [intervalIntegral.integral_const_mul, ← mul_assoc, h_fubini (fun x₀ θ => Φ (γ x₀ θ)) hF_cont]
      have hinner : ∀ θ : ℝ, (∫ x₀ in (0 : ℝ)..(2 * Real.pi), Φ (γ x₀ θ)) =
