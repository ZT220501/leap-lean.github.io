            simp only [pow_one, pow_zero, Nat.cast_zero, zero_add, map_one, one_mul]
            exact hMod_refl j _
        | succ m ih =>
            have hstep1 : ModEq j (Z₁ ^ (m + 2))
                ((Z₀ ^ (m + 1) +
                  X_ε ^ j * ι₀ (MvPowerSeries.C ((m : ℂ) + 1) * Z₀₀ ^ m * δ)) *
                  (Z₀ + X_ε ^ j * ι₀ δ)) := by
              rw [pow_succ Z₁ (m + 1)]
              exact hMod_mul ih (hMod_refl j _)
            refine hMod_trans hstep1 ?_
            have hexp :
                (Z₀ ^ (m + 1) +
                  X_ε ^ j * ι₀ (MvPowerSeries.C ((m : ℂ) + 1) * Z₀₀ ^ m * δ)) *
                  (Z₀ + X_ε ^ j * ι₀ δ) =
                Z₀ ^ (m + 2) +
                  (Z₀ ^ (m + 1) * (X_ε ^ j * ι₀ δ) +
                    Z₀ * (X_ε ^ j * ι₀ (MvPowerSeries.C ((m : ℂ) + 1) * Z₀₀ ^ m * δ))) +
                  (X_ε ^ (j + j) *
                    (ι₀ (MvPowerSeries.C ((m : ℂ) + 1) * Z₀₀ ^ m * δ) * ι₀ δ)) := by
              rw [pow_succ Z₀ (m + 1), pow_add X_ε j j]
              ring
            rw [hexp]
            have hquad_zero : ModEq j
                (X_ε ^ (j + j) *
                  (ι₀ (MvPowerSeries.C ((m : ℂ) + 1) * Z₀₀ ^ m * δ) * ι₀ δ)) 0 := by
              simpa only [ModEq, sub_zero] using
                hVE_mono (by omega : j + 1 ≤ j + j)
                  (hVE_mul_any _ (hVE_X_pow (j + j)))
            have hm1 : ModEq j (Z₀ ^ (m + 1) * (X_ε ^ j * ι₀ δ))
                (X_ε ^ j * ι₀ (Z₀₀ ^ (m + 1) * δ)) := by
              refine hMod_trans (hMod_mul_vanish (Z₀ ^ (m + 1)) _ (hXj_VE δ)) ?_
              rw [hslice0_pow, ← mul_assoc, mul_comm (ι₀ _), mul_assoc, ← hι_mul]
              exact hMod_refl j _
            have hm2 : ModEq j
                (Z₀ * (X_ε ^ j * ι₀ (MvPowerSeries.C ((m : ℂ) + 1) * Z₀₀ ^ m * δ)))
                (X_ε ^ j * ι₀ (Z₀₀ * (MvPowerSeries.C ((m : ℂ) + 1) * Z₀₀ ^ m * δ))) := by
              refine hMod_trans (hMod_mul_vanish Z₀ _ (hXj_VE _)) ?_
              rw [← mul_assoc, mul_comm (ι₀ Z₀₀), mul_assoc, ← hι_mul]
              exact hMod_refl j _
            have hlin := hMod_add (hMod_add (hMod_refl j (Z₀ ^ (m + 2))) (hMod_add hm1 hm2)) hquad_zero
            rw [add_zero, ← mul_add, ← hι_add] at hlin
            have hcomb : Z₀₀ ^ (m + 1) * δ +
                Z₀₀ * (MvPowerSeries.C ((m : ℂ) + 1) * Z₀₀ ^ m * δ) =
                MvPowerSeries.C (((m + 1 : ℕ) : ℂ) + 1) * Z₀₀ ^ (m + 1) * δ := by
              have h1 : (1 : MvPowerSeries (Fin 2) ℂ) + MvPowerSeries.C ((m : ℂ) + 1) =
                  MvPowerSeries.C (((m + 1 : ℕ) : ℂ) + 1) := by
                rw [← map_one MvPowerSeries.C, ← map_add]
