theorem binomial_dip_and_vertical_disk_continuation : DiskContinuationToolkitProp :=
by
  have h_s1 :
      ∀ (U₁ U₂ : Set (ℂ × ℂ)) (f₁ f₂ : ℂ × ℂ → ℂ) (y₀ t₀ : ℂ) (δ₀ : ℝ),
        IsDownwardVertConvex U₁ →
        IsDownwardVertConvex U₂ →
        DifferentiableOn ℂ f₁ U₁ →
        DifferentiableOn ℂ f₂ U₂ →
        (y₀, t₀) ∈ U₁ ∩ U₂ →
        0 ≤ y₀.im →
        0 < δ₀ →
        (∀ y : ℂ, ‖y - (y₀.re : ℂ)‖ < δ₀ → f₁ (y, t₀) = f₂ (y, t₀)) →
        f₁ (y₀, t₀) = f₂ (y₀, t₀) := by
    intro U₁ U₂ f₁ f₂ y₀ t₀ δ₀ hU₁ hU₂ hf₁ hf₂ hy₀ him hδ₀ heq
    let x₀ : ℝ := y₀.re
    let η₀ : ℝ := y₀.im
    let V : Set ℂ := { y : ℂ | (y, t₀) ∈ U₁ ∩ U₂ }
    have hV_open : IsOpen V :=
      (hU₁.1.inter hU₂.1).preimage (continuous_id.prodMk continuous_const)
    let γ : ℝ → ℂ := fun τ => (x₀ : ℂ) + (τ : ℂ) * Complex.I
    have hγ_cont : Continuous γ := by fun_prop
    let K : Set ℂ := γ '' Set.Icc 0 η₀
    have hK_comp : IsCompact K := isCompact_Icc.image hγ_cont
    have hK_sub : K ⊆ V := by
      rintro _ ⟨τ, ⟨hτ0, hτ1⟩, rfl⟩
      exact ⟨hU₁.2 y₀ t₀ hy₀.1 him τ hτ0 hτ1, hU₂.2 y₀ t₀ hy₀.2 him τ hτ0 hτ1⟩
    obtain ⟨r₁, hr₁_pos, hr₁_sub⟩ := hK_comp.exists_thickening_subset_open hV_open hK_sub
    let r : ℝ := min (r₁ / 3) (δ₀ / 2)
    have hr_pos : 0 < r := lt_min (by positivity) (by positivity)
    have hr_two_lt : 2 * r < r₁ := by
      have : r ≤ r₁ / 3 := min_le_left _ _
      linarith
    have hr_lt_δ₀ : r < δ₀ := by
      have : r ≤ δ₀ / 2 := min_le_right _ _
      linarith
    let R_r : Set ℂ :=
      (Complex.reCLM.toLinearMap ⁻¹' Set.Ioo (x₀ - r) (x₀ + r)) ∩
        (Complex.imCLM.toLinearMap ⁻¹' Set.Ioo (-r) (η₀ + r))
    have hR_open : IsOpen R_r :=
      (isOpen_Ioo.preimage Complex.reCLM.continuous).inter
        (isOpen_Ioo.preimage Complex.imCLM.continuous)
    have hR_conv : Convex ℝ R_r :=
      ((convex_Ioo (x₀ - r) (x₀ + r)).linear_preimage Complex.reCLM.toLinearMap).inter
        ((convex_Ioo (-r) (η₀ + r)).linear_preimage Complex.imCLM.toLinearMap)
    have hR_pre : IsPreconnected R_r := hR_conv.isPreconnected
    have hz₀_mem : (x₀ : ℂ) ∈ R_r := by
      refine ⟨⟨?_, ?_⟩, ⟨?_, ?_⟩⟩ <;> simp <;> linarith
    have hy₀_mem : y₀ ∈ R_r := by
      refine ⟨⟨?_, ?_⟩, ⟨?_, ?_⟩⟩ <;> simp [x₀, η₀] <;> linarith
    have hR_sub : R_r ⊆ V := by
      intro y hy
      have hre1 : x₀ - r < y.re := hy.1.1
      have hre2 : y.re < x₀ + r := hy.1.2
      have him1 : -r < y.im := hy.2.1
      have him2 : y.im < η₀ + r := hy.2.2
      let τ : ℝ := max 0 (min y.im η₀)
      have hτ_mem : τ ∈ Set.Icc 0 η₀ := ⟨le_max_left _ _, max_le him (min_le_right _ _)⟩
      have hγ_mem : γ τ ∈ K := ⟨τ, hτ_mem, rfl⟩
      have hre_abs : |y.re - x₀| < r := abs_lt.mpr ⟨by linarith, by linarith⟩
      have him_abs : |y.im - τ| < r := by
        dsimp [τ]
        rcases le_total y.im η₀ with hle | hge
