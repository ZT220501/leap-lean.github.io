          have h1 : σ_m = fun m : ℕ => (m : ℝ) + (D₁ + 3) := by ext m; dsimp [σ_m]; ring
          rw [h1]
          exact Filter.Tendsto.atTop_add tendsto_natCast_atTop_atTop tendsto_const_nhds
        have h_exp : 1 - 2 * α = -(2 * α - 1) := by ring
        rw [h_exp]
        simpa using ((tendsto_rpow_neg_atTop (y := 2 * α - 1) (by linarith)).comp
          hσ_tend).const_mul C_star
      have h_W_upper : Filter.Tendsto
          (fun m : ℕ => P.C_pass * (σ_m m - 1) ^ (-2 * α)) Filter.atTop (nhds 0) := by
        simpa using ((tendsto_rpow_neg_atTop (y := 2 * α) (by linarith)).comp
          hσ_sub1_tend).const_mul P.C_pass
      refine squeeze_zero' (Filter.Eventually.of_forall fun _ => norm_nonneg _) ?_ h_W_upper
      filter_upwards [h_disp_tend.eventually (gt_mem_nhds zero_lt_one)] with m hm
      have hYm_C₂ := hV_sub_C₂ (hYm_in_V m)
      have h_norm_le1 : ‖S_star (Y_m m) - Y_m m‖ ≤ 1 := by
        have hb := hS_disp (Y_m m) hYm_C₂.1 hYm_C₂.2
        rw [hYm_im] at hb
        exact le_trans hb hm.le
      have him_d : |(S_star (Y_m m)).im - (Y_m m).im| ≤ 1 :=
        le_trans (Complex.abs_im_le_norm (S_star (Y_m m) - Y_m m)) h_norm_le1
      have hre_d : |(S_star (Y_m m)).re - (Y_m m).re| ≤ 1 :=
        le_trans (Complex.abs_re_le_norm (S_star (Y_m m) - Y_m m)) h_norm_le1
      rw [hYm_re, sub_zero] at hre_d
      rw [abs_le] at him_d
      have h_sim : σ_m m - 1 ≤ -(S_star (Y_m m)).im := by have := hYm_im m; linarith
      have h_σ : 21 ≤ σ_m m - 1 := by dsimp [σ_m]; linarith
      have hrpow : (-(S_star (Y_m m)).im) ^ (-2 * α) ≤ (σ_m m - 1) ^ (-2 * α) :=
        Real.rpow_le_rpow_of_nonpos (by linarith) h_sim (by linarith)
      exact le_trans (P.W_bound (S_star (Y_m m)) (by linarith) (by nlinarith))
        (mul_le_mul_of_nonneg_left hrpow hC_W.le)
    have he_tend : Filter.Tendsto (fun m : ℕ => e (Y_m m)) Filter.atTop (nhds (1 / 12 : ℂ)) := by
      have h_arg_tend : Filter.Tendsto
          (fun m : ℕ => (T_star / 2) ^ 2 * W (S_star (Y_m m)) * (J (Y_m m)) ^ 2)
          Filter.atTop (nhds 0) := by
        simpa using ((hW_tend0.const_mul ((T_star / 2) ^ 2)).mul (hJ_tend1.pow 2))
      have hG_cont0 : ContinuousAt G_sq 0 :=
        hPair.g_holo.continuousOn.continuousAt (Metric.isOpen_ball.mem_nhds (by norm_num))
      have hG_tend1 : Filter.Tendsto
          (fun m : ℕ => G_sq ((T_star / 2) ^ 2 * W (S_star (Y_m m)) * (J (Y_m m)) ^ 2))
          Filter.atTop (nhds 1) := by
        rw [← hPair.g_zero]
        exact hG_cont0.tendsto.comp h_arg_tend
      have h_prod : Filter.Tendsto
          (fun m : ℕ => (1 / 12 : ℂ) * (J (Y_m m)) ^ 3 *
            G_sq ((T_star / 2) ^ 2 * W (S_star (Y_m m)) * (J (Y_m m)) ^ 2))
          Filter.atTop (nhds (1 / 12 : ℂ)) := by
        simpa using ((hJ_tend1.pow 3).const_mul (1 / 12 : ℂ)).mul hG_tend1
      exact h_prod.congr fun m => (he_leg (Y_m m) (hYm_in_V m)).symm
    intro Y hY_im hY_re
    have hY_V : Y ∈ V_deep := ⟨hY_im, hY_re⟩
    have he_eq_const : Filter.Tendsto (fun m : ℕ => e (Y_m m)) Filter.atTop (nhds (e Y)) :=
      tendsto_const_nhds.congr fun m => (he_const (hYm_in_V m) hY_V).symm
    have he_val : e Y = (1 / 12 : ℂ) := tendsto_nhds_unique he_eq_const he_tend
    rw [he_leg Y hY_V] at he_val
    linear_combination 12 * he_val
  
  refine h_s1 ?_
  intro T_star Y_star hT_star hT_ne hY_im hY_re
  by_contra h_not_pt
  have h_ex_pt : ∃ ε₀ : ℝ, 0 < ε₀ ∧ ∀ N : ℕ, ∃ n ≥ N,
      ε₀ ≤ dist (P.S_seq n (T_star, Y_star)) (M.S_lim (T_star, Y_star)) := by
    by_contra! h_all
    exact h_not_pt (Metric.tendsto_atTop.mpr h_all)
  obtain ⟨ε₀, hε₀_pos, h_freq⟩ := h_ex_pt
  classical
  let stepPt : ℕ → { n : ℕ // ε₀ ≤ dist (P.S_seq n (T_star, Y_star)) (M.S_lim (T_star, Y_star)) } :=
    fun N => ⟨Classical.choose (h_freq N), (Classical.choose_spec (h_freq N)).2⟩
  have h_stepPt_ge : ∀ N : ℕ, N ≤ (stepPt N).1 :=
    fun N => (Classical.choose_spec (h_freq N)).1
  let φ₁ : ℕ → ℕ := fun k => Nat.recOn k (stepPt 0).1 (fun _ prev => (stepPt (prev + 1)).1)
  have hφ₁_mono : StrictMono φ₁ :=
    strictMono_nat_of_lt_succ fun k => Nat.lt_of_succ_le (h_stepPt_ge (φ₁ k + 1))
  have hφ₁_sep : ∀ k : ℕ,
      ε₀ ≤ dist (P.S_seq (φ₁ k) (T_star, Y_star)) (M.S_lim (T_star, Y_star)) := by
    intro k
    cases k with
    | zero => exact (stepPt 0).2
    | succ k => exact (stepPt (φ₁ k + 1)).2
  obtain ⟨ψ, S_star, hψ_mono, hS_holo, hS_conv, hS_deriv_conv, hS_disp⟩ :=
    h_s2 T_star hT_star φ₁ hφ₁_mono
  let C_star : ℝ := P.C_pass * T₀ ^ 2 + 1
  have hC_star_pos : 0 < C_star := by
    have := P.C_pass_pos
    dsimp [C_star]
    positivity
  obtain ⟨D₁, hD₀_le_D₁, hG_holo, hEL⟩ :=
    h_s3 C_star hC_star_pos T_star hT_star hT_ne (φ₁ ∘ ψ) (hφ₁_mono.comp hψ_mono)
      S_star hS_holo hS_conv hS_deriv_conv hS_disp
  have hODE := h_s4 D₁ C_star hD₀_le_D₁ hC_star_pos T_star S_star hS_holo hS_disp hG_holo hEL
  have hC₁_sub_C₂ : { Y : ℂ | D₀ < -Y.im ∧ |Y.re| < (A₀ + 1) * (-Y.im) } ⊆
      { Y : ℂ | D₀ < -Y.im ∧ |Y.re| < (A₀ + 2) * (-Y.im) } := by
    intro Y hY
    have : 0 < -Y.im := by linarith [hY.1]
    exact ⟨hY.1, by nlinarith [hY.2]⟩
  have hS_eq_lim : S_star Y_star = M.S_lim (T_star, Y_star) :=
    M.S_lim_unique_1d D₀ hD₀_mod T_star hT_star S_star C_star D₁ hD₀_le_D₁ hC_star_pos
      (hS_holo.mono hC₁_sub_C₂)
      (fun Y h1 h2 => hS_disp Y h1 (hC₁_sub_C₂ ⟨h1, h2⟩).2)
      hODE Y_star hY_im hY_re
  have hY_star_C₂ : Y_star ∈ { Y : ℂ | D₀ < -Y.im ∧ |Y.re| < (A₀ + 2) * (-Y.im) } := by
    have : 0 < -Y_star.im := by linarith
    exact ⟨hY_im, by nlinarith⟩
  have h_sub_conv : Filter.Tendsto
      (fun k => P.S_seq (φ₁ (ψ k)) (T_star, Y_star)) Filter.atTop
      (nhds (M.S_lim (T_star, Y_star))) := by
    rw [← hS_eq_lim]
    exact hS_conv.tendsto_at hY_star_C₂
  obtain ⟨k₀, hk₀⟩ := Metric.tendsto_atTop.mp h_sub_conv ε₀ hε₀_pos
  exact absurd (hk₀ k₀ le_rfl) (not_lt_of_ge (hφ₁_sep (ψ k₀)))

theorem deep_pure_field_energy_models (S : FiniteWallNonisotropicStrip)
    (A : SmallFieldChordActionData S)
    (hCone : ConePassageProp S) :
    DeepFirstFieldModelProp S ∧ DeepSecondFieldModelProp S :=
by
  obtain ⟨hK1, hEqPhi1, hEqG1, hK2, hRootGen⟩ := deep_frozen_kernels_and_root
  obtain ⟨R1⟩ := hRootGen deepPureGSqFirst hK1.g_holo hK1.g_zero
  obtain ⟨R2⟩ := hRootGen frozenSecondFieldG hK2.g_holo hK2.g_zero
  constructor
  · intro d_seq B_seq ξ_seq α δ_b F hα1 hα2 hδb_pos hδb_lt hF_holo
      hdB_pos hd_tend hB_tend hCoarse hF_conv hQ_conv A₀ T₀ hA₀ hT₀
    obtain ⟨P1, hTube1⟩ :=
      (deep_rescaled_passages_and_recurrence S A hCone hK1 hEqPhi1 hK2
        d_seq B_seq ξ_seq α δ_b A₀ T₀ hα1 hα2 hδb_pos hδb_lt hA₀ hT₀
        hdB_pos hd_tend hB_tend hCoarse).1 F hF_holo hF_conv hQ_conv
    obtain ⟨M1⟩ :=
      deep_ray_primitive_and_model_solution α A₀ T₀ P1.C_pass deepPureGSqFirst
        (fun Z => F Z ^ 2) hα1 hα2 hA₀ hT₀ P1.C_pass_pos P1.W_holo P1.W_bound R1
    let D₀ : ℝ := max M1.D_mod P1.D_pass
    have hD₀_ge_mod : M1.D_mod ≤ D₀ := le_max_left _ _
    have hD₀_ge_pass : P1.D_pass ≤ D₀ := le_max_right _ _
    have hD₀_pos : 0 < D₀ := by linarith [M1.D_mod_ge]
    refine ⟨D₀, M1.C_mod, hD₀_pos, M1.C_mod_pos, M1.S_lim, ?_, ?_, ?_, ?_⟩
    · refine M1.S_lim_holo.mono ?_
      intro p hp
      exact ⟨hp.1, lt_of_le_of_lt hD₀_ge_mod hp.2.1, hp.2.2⟩
    · intro T Y hT hY_im hY_re
      obtain ⟨h_im, h_even, h_disp, _, h_ode⟩ :=
        M1.S_lim_props T Y hT (lt_of_le_of_lt hD₀_ge_mod hY_im) hY_re
      refine ⟨h_im, h_even, h_disp, ?_⟩
      have h_arg :
          (T / 2) ^ 2 * F (M1.S_lim (T, Y)) ^ 2 *
            (deriv (fun Y' : ℂ => M1.S_lim (T, Y')) Y) ^ 2 =
          (T * F (M1.S_lim (T, Y)) *
            deriv (fun Y' : ℂ => M1.S_lim (T, Y')) Y / 2) ^ 2 := by
        ring
      rw [h_arg, hEqG1] at h_ode
      exact h_ode
    · intro Y hY_im hY_re
      exact M1.S_lim_zero Y (lt_of_le_of_lt hD₀_ge_mod hY_im) hY_re
    · intro K hK_comp hK_sub ε hε
      rcases K.eq_empty_or_nonempty with rfl | hK_ne
      · refine ⟨0, ?_⟩
        intro _ _ p hp
        exact False.elim hp
      · have h_cont : ContinuousOn (fun p : ℂ × ℂ => -p.2.im) K := by fun_prop
        obtain ⟨p_max, _, hp_max⟩ := hK_comp.exists_isMaxOn hK_ne h_cont
        let R_top : ℝ := max (-p_max.2.im + 1) (D₀ + 1)
        have hR_top_gt_pass : P1.D_pass < R_top := by
          have : D₀ + 1 ≤ R_top := le_max_right _ _
          linarith
        obtain ⟨N_tube, hN_tube⟩ := hTube1 R_top hR_top_gt_pass
        obtain ⟨N_id, hN_id⟩ :=
          deep_divided_difference_limit_identification α A₀ T₀ D₀ B_seq
            deepPurePhiSqFirst deepPureGSqFirst (fun Z => F Z ^ 2)
            hα1 hα2 hA₀ hT₀ hK1 M1 P1 le_rfl K hK_comp hK_sub ε hε
        refine ⟨max N_id N_tube, ?_⟩
        intro n hn p hp h_mem_tube
        have hp_cone := hK_sub hp
        have hp_max_le : -p.2.im ≤ -p_max.2.im := hp_max hp
        have hp_lt_Rtop : -p.2.im < R_top := by
          have : -p_max.2.im + 1 ≤ R_top := le_max_left _ _
          linarith
        have hp_im_pos : 0 < -p.2.im := lt_trans hD₀_pos hp_cone.2.1
        have hp_T : ‖p.1‖ < (3 / 2 : ℝ) * T₀ := by linarith [hp_cone.1]
        have hp_im_lo : P1.D_pass / 2 < -p.2.im := by
          linarith [P1.D_pass_ge, hD₀_ge_pass, hp_cone.2.1]
        have hp_re : |p.2.re| < (A₀ + 3) * (-p.2.im) := by
          have := hp_cone.2.2
          linarith
        have h_eq :=
          hN_tube n (le_trans (le_max_right _ _) hn) p.1 p.2
            hp_T hp_im_lo hp_lt_Rtop hp_re h_mem_tube
        rw [← h_eq]
        exact hN_id n (le_trans (le_max_left _ _) hn) p hp
  · intro d_seq B_seq ξ_seq α δ_b Q hα1 hα2 hδb_pos hδb_lt hQ_holo
      hdB_pos hd_tend hB_tend hCoarse hF_conv hQ_conv A₀ T₀ hA₀ hT₀
    obtain ⟨P2, hTube2⟩ :=
      (deep_rescaled_passages_and_recurrence S A hCone hK1 hEqPhi1 hK2
        d_seq B_seq ξ_seq α δ_b A₀ T₀ hα1 hα2 hδb_pos hδb_lt hA₀ hT₀
        hdB_pos hd_tend hB_tend hCoarse).2 Q hQ_holo hF_conv hQ_conv
    obtain ⟨M2⟩ :=
      deep_ray_primitive_and_model_solution α A₀ T₀ P2.C_pass frozenSecondFieldG
        Q hα1 hα2 hA₀ hT₀ P2.C_pass_pos P2.W_holo P2.W_bound R2
    let D₀ : ℝ := max M2.D_mod P2.D_pass
    have hD₀_ge_mod : M2.D_mod ≤ D₀ := le_max_left _ _
    have hD₀_ge_pass : P2.D_pass ≤ D₀ := le_max_right _ _
    have hD₀_pos : 0 < D₀ := by linarith [M2.D_mod_ge]
    refine ⟨D₀, M2.C_mod, hD₀_pos, M2.C_mod_pos, M2.S_lim, ?_, ?_, ?_, ?_⟩
    · refine M2.S_lim_holo.mono ?_
      intro p hp
      exact ⟨hp.1, lt_of_le_of_lt hD₀_ge_mod hp.2.1, hp.2.2⟩
    · intro T Y hT hY_im hY_re
      exact M2.S_lim_props T Y hT (lt_of_le_of_lt hD₀_ge_mod hY_im) hY_re
    · intro Y hY_im hY_re
      exact M2.S_lim_zero Y (lt_of_le_of_lt hD₀_ge_mod hY_im) hY_re
    · intro K hK_comp hK_sub ε hε
      rcases K.eq_empty_or_nonempty with rfl | hK_ne
      · refine ⟨0, ?_⟩
        intro _ _ p hp
        exact False.elim hp
      · have h_cont : ContinuousOn (fun p : ℂ × ℂ => -p.2.im) K := by fun_prop
        obtain ⟨p_max, _, hp_max⟩ := hK_comp.exists_isMaxOn hK_ne h_cont
        let R_top : ℝ := max (-p_max.2.im + 1) (D₀ + 1)
        have hR_top_gt_pass : P2.D_pass < R_top := by
          have : D₀ + 1 ≤ R_top := le_max_right _ _
          linarith
        obtain ⟨N_tube, hN_tube⟩ := hTube2 R_top hR_top_gt_pass
        obtain ⟨N_id, hN_id⟩ :=
          deep_divided_difference_limit_identification α A₀ T₀ D₀ B_seq
            frozenPhiSecond frozenSecondFieldG Q
            hα1 hα2 hA₀ hT₀ hK2 M2 P2 le_rfl K hK_comp hK_sub ε hε
        refine ⟨max N_id N_tube, ?_⟩
        intro n hn p hp h_mem_tube
        have hp_cone := hK_sub hp
        have hp_max_le : -p.2.im ≤ -p_max.2.im := hp_max hp
        have hp_lt_Rtop : -p.2.im < R_top := by
          have : -p_max.2.im + 1 ≤ R_top := le_max_left _ _
          linarith
        have hp_im_pos : 0 < -p.2.im := lt_trans hD₀_pos hp_cone.2.1
        have hp_T : ‖p.1‖ < (3 / 2 : ℝ) * T₀ := by linarith [hp_cone.1]
        have hp_im_lo : P2.D_pass / 2 < -p.2.im := by
          linarith [P2.D_pass_ge, hD₀_ge_pass, hp_cone.2.1]
        have hp_re : |p.2.re| < (A₀ + 3) * (-p.2.im) := by
          have := hp_cone.2.2
          linarith
        have h_eq :=
          hN_tube n (le_trans (le_max_right _ _) hn) p.1 p.2
            hp_T hp_im_lo hp_lt_Rtop hp_re h_mem_tube
        rw [← h_eq]
        exact hN_id n (le_trans (le_max_left _ _) hn) p hp

theorem cone_passage_and_pure_models (S : FiniteWallNonisotropicStrip) :
    ConePassageProp S ∧ DeepFirstFieldModelProp S ∧ DeepSecondFieldModelProp S :=
by
  obtain ⟨A⟩ := small_field_chord_action_and_frozen_limits S
  have hSteep : SteepSectorPassageProp S := steep_sector_cone_continuation S A
  have hCone : ConePassageProp S := analytic_disk_cone_passage S hSteep
  obtain ⟨hFirst, hSecond⟩ := deep_pure_field_energy_models S A hCone
  exact ⟨hCone, hFirst, hSecond⟩

theorem volterra_ode_uniqueness_wronskian_and_lip (hSfca : SfcaVolterraKernelProp) :
    VolterraODEProp ∧ VolterraLipHoloProp :=
by
  have hIterEq : ∀ (Q init : ℝ → ℂ) (m : ℕ) (w : ℝ),
      volterraIter Q init m w = sfcaVolterraIter init Q m w := by
    intro Q init m
    induction m with
    | zero =>
      intro w
      rfl
    | succ m ih =>
      intro w
      simp only [volterraIter, sfcaVolterraIter, ih]
  have hc0_eq : c0Kernel = sfcaVolterraC := by
    funext Q w
    simp only [c0Kernel, sfcaVolterraC, hIterEq]
  have hk0_eq : k0Kernel = sfcaVolterraK := by
    funext Q w
    simp only [k0Kernel, sfcaVolterraK, hIterEq]
  have hc0d_eq : c0Deriv = sfcaVolterraCDeriv := by
    funext Q w
    simp only [c0Deriv, sfcaVolterraCDeriv, hc0_eq]
  have hk0d_eq : k0Deriv = sfcaVolterraKDeriv := by
    funext Q w
    simp only [k0Deriv, sfcaVolterraKDeriv, hk0_eq]

  have hIntIcc : ∀ (f : ℝ → ℂ), ContinuousOn f (Set.Icc (0 : ℝ) 1) →
      ∀ u ∈ Set.Icc (0 : ℝ) 1, IntervalIntegrable f MeasureTheory.volume 0 u := by
    intro f hf u hu
    apply ContinuousOn.intervalIntegrable
    rw [Set.uIcc_of_le hu.1]
    exact hf.mono (Set.Icc_subset_Icc_right hu.2)

  have hPrimDerivWithin : ∀ (f : ℝ → ℂ), ContinuousOn f (Set.Icc (0 : ℝ) 1) →
      ∀ w ∈ Set.Icc (0 : ℝ) 1,
        HasDerivWithinAt (fun u => ∫ v in (0 : ℝ)..u, f v) (f w) (Set.Icc (0 : ℝ) 1) w := by
    intro f hf w hw
    let clamp : ℝ → ℝ := fun t => max 0 (min 1 t)
    have hclamp_cont : Continuous clamp :=
      continuous_const.max (continuous_const.min continuous_id)
    have hclamp_mem : ∀ t : ℝ, clamp t ∈ Set.Icc (0 : ℝ) 1 :=
      fun t => ⟨le_max_left 0 (min 1 t), max_le zero_le_one (min_le_left 1 t)⟩
    have hclamp_id : ∀ t ∈ Set.Icc (0 : ℝ) 1, clamp t = t := by
      intro t ht
      dsimp [clamp]
      rw [min_eq_right ht.2, max_eq_right ht.1]
    let f_ext : ℝ → ℂ := f ∘ clamp
    have hf_ext_cont : Continuous f_ext := hf.comp_continuous hclamp_cont hclamp_mem
    have hd : HasDerivAt (fun u => ∫ v in (0 : ℝ)..u, f_ext v) (f_ext w) w :=
      intervalIntegral.integral_hasDerivAt_right
        (hf_ext_cont.intervalIntegrable 0 w)
        (hf_ext_cont.stronglyMeasurableAtFilter MeasureTheory.volume (nhds w))
        hf_ext_cont.continuousAt
    have hfw : f_ext w = f w := congrArg f (hclamp_id w hw)
    rw [hfw] at hd
    have hdw : HasDerivWithinAt (fun u => ∫ v in (0 : ℝ)..u, f_ext v) (f w)
        (Set.Icc (0 : ℝ) 1) w := hd.hasDerivWithinAt
    have h_eq : ∀ u ∈ Set.Icc (0 : ℝ) 1,
        (∫ v in (0 : ℝ)..u, f v) = ∫ v in (0 : ℝ)..u, f_ext v := by
      intro u hu
      apply intervalIntegral.integral_congr
      intro v hv
      rw [Set.uIcc_of_le hu.1] at hv
      have hv_mem : v ∈ Set.Icc (0 : ℝ) 1 := ⟨hv.1, le_trans hv.2 hu.2⟩
      exact (congrArg f (hclamp_id v hv_mem)).symm
    exact hdw.congr h_eq (h_eq w hw)

  have hPrimContOn : ∀ (f : ℝ → ℂ), ContinuousOn f (Set.Icc (0 : ℝ) 1) →
      ContinuousOn (fun u => ∫ v in (0 : ℝ)..u, f v) (Set.Icc (0 : ℝ) 1) :=
    fun f hf w hw => (hPrimDerivWithin f hf w hw).continuousWithinAt

  have hKernelSplit : ∀ (f : ℝ → ℂ), ContinuousOn f (Set.Icc (0 : ℝ) 1) →
      ∀ u ∈ Set.Icc (0 : ℝ) 1,
        (∫ v in (0 : ℝ)..u, ((u - v : ℝ) : ℂ) * f v) =
          (u : ℂ) * (∫ v in (0 : ℝ)..u, f v) - ∫ v in (0 : ℝ)..u, (v : ℂ) * f v := by
    intro f hf u hu
    have hvf_cont : ContinuousOn (fun v : ℝ => (v : ℂ) * f v) (Set.Icc (0 : ℝ) 1) :=
      Complex.continuous_ofReal.continuousOn.mul hf
    have h1 : IntervalIntegrable (fun v : ℝ => (u : ℂ) * f v) MeasureTheory.volume 0 u :=
      hIntIcc _ (continuousOn_const.mul hf) u hu
    have h2 : IntervalIntegrable (fun v : ℝ => (v : ℂ) * f v) MeasureTheory.volume 0 u :=
      hIntIcc _ hvf_cont u hu
    have h_congr : (∫ v in (0 : ℝ)..u, ((u - v : ℝ) : ℂ) * f v) =
        ∫ v in (0 : ℝ)..u, ((u : ℂ) * f v - (v : ℂ) * f v) := by
      apply intervalIntegral.integral_congr
      intro v _
      push_cast
      ring
    rw [h_congr, intervalIntegral.integral_sub h1 h2, intervalIntegral.integral_const_mul]

  have hODE : VolterraODEProp := by
    intro Q hQ
    have hLaws := hSfca.ode_laws Q hQ
    rw [← hc0_eq, ← hk0_eq, ← hc0d_eq, ← hk0d_eq] at hLaws
    rcases hLaws with ⟨hc_cont, hk_cont, hcd_cont, hkd_cont, hfp, hc0, hcd0, hk0, hkd0, hIoo⟩
    refine ⟨hc0, hcd0, hk0, hkd0, hc_cont, hcd_cont, hk_cont, hkd_cont, ?_, ?_, ?_⟩
    · intro w hw
      let g_c : ℝ → ℂ := fun v => Q v * c0Kernel Q v
      let g_k : ℝ → ℂ := fun v => Q v * k0Kernel Q v
      have hg_c : ContinuousOn g_c (Set.Icc (0 : ℝ) 1) := hQ.mul hc_cont
      have hg_k : ContinuousOn g_k (Set.Icc (0 : ℝ) 1) := hQ.mul hk_cont
      have hvg_c : ContinuousOn (fun v : ℝ => (v : ℂ) * g_c v) (Set.Icc (0 : ℝ) 1) :=
        Complex.continuous_ofReal.continuousOn.mul hg_c
      have hvg_k : ContinuousOn (fun v : ℝ => (v : ℂ) * g_k v) (Set.Icc (0 : ℝ) 1) :=
        Complex.continuous_ofReal.continuousOn.mul hg_k
      have hcd_dw : HasDerivWithinAt (c0Deriv Q) (Q w * c0Kernel Q w) (Set.Icc (0 : ℝ) 1) w :=
        hPrimDerivWithin g_c hg_c w hw
      have hkd_dw : HasDerivWithinAt (k0Deriv Q) (Q w * k0Kernel Q w) (Set.Icc (0 : ℝ) 1) w := by
        have h1 := (hasDerivWithinAt_const w (Set.Icc (0 : ℝ) 1) (1 : ℂ)).add
          (hPrimDerivWithin g_k hg_k w hw)
        have h_val : (0 : ℂ) + g_k w = Q w * k0Kernel Q w := zero_add _
        rw [h_val] at h1
        exact h1
      have hid_dw : HasDerivWithinAt (fun u : ℝ => (u : ℂ)) (1 : ℂ) (Set.Icc (0 : ℝ) 1) w := by
        have h1 := (hasDerivAt_id w).ofReal_comp.hasDerivWithinAt (s := Set.Icc (0 : ℝ) 1)
        rw [Complex.ofReal_one] at h1
        exact h1
      have hc_dw : HasDerivWithinAt (c0Kernel Q) (c0Deriv Q w) (Set.Icc (0 : ℝ) 1) w := by
        let F_c : ℝ → ℂ := fun u =>
          1 + ((u : ℂ) * c0Deriv Q u - ∫ v in (0 : ℝ)..u, (v : ℂ) * g_c v)
        have hF_dw : HasDerivWithinAt F_c
            ((0 : ℂ) + (((1 : ℂ) * c0Deriv Q w + (w : ℂ) * (Q w * c0Kernel Q w)) -
              (w : ℂ) * g_c w))
            (Set.Icc (0 : ℝ) 1) w :=
          (hasDerivWithinAt_const w (Set.Icc (0 : ℝ) 1) (1 : ℂ)).add
            ((hid_dw.mul hcd_dw).sub (hPrimDerivWithin _ hvg_c w hw))
        have h_val : (0 : ℂ) + (((1 : ℂ) * c0Deriv Q w + (w : ℂ) * (Q w * c0Kernel Q w)) -
            (w : ℂ) * g_c w) = c0Deriv Q w := by
          dsimp [g_c]
          ring
        rw [h_val] at hF_dw
        have hc_eq : ∀ u ∈ Set.Icc (0 : ℝ) 1, c0Kernel Q u = F_c u := by
          intro u hu
          have hfp_c := (hfp u hu).1
          have h_assoc : (∫ v in (0 : ℝ)..u, ((u - v : ℝ) : ℂ) * Q v * c0Kernel Q v) =
              ∫ v in (0 : ℝ)..u, ((u - v : ℝ) : ℂ) * g_c v := by
            apply intervalIntegral.integral_congr
            intro v _
            dsimp [g_c]
            ring
          rw [hfp_c, h_assoc, hKernelSplit g_c hg_c u hu]
          rfl
        exact hF_dw.congr hc_eq (hc_eq w hw)
      have hk_dw : HasDerivWithinAt (k0Kernel Q) (k0Deriv Q w) (Set.Icc (0 : ℝ) 1) w := by
        let F_k : ℝ → ℂ := fun u =>
          (u : ℂ) * k0Deriv Q u - ∫ v in (0 : ℝ)..u, (v : ℂ) * g_k v
        have hF_dw : HasDerivWithinAt F_k
            (((1 : ℂ) * k0Deriv Q w + (w : ℂ) * (Q w * k0Kernel Q w)) - (w : ℂ) * g_k w)
            (Set.Icc (0 : ℝ) 1) w :=
          (hid_dw.mul hkd_dw).sub (hPrimDerivWithin _ hvg_k w hw)
        have h_val : ((1 : ℂ) * k0Deriv Q w + (w : ℂ) * (Q w * k0Kernel Q w)) -
            (w : ℂ) * g_k w = k0Deriv Q w := by
          dsimp [g_k]
          ring
        rw [h_val] at hF_dw
        have hk_eq : ∀ u ∈ Set.Icc (0 : ℝ) 1, k0Kernel Q u = F_k u := by
          intro u hu
          have hfp_k := (hfp u hu).2
          have h_assoc : (∫ v in (0 : ℝ)..u, ((u - v : ℝ) : ℂ) * Q v * k0Kernel Q v) =
              ∫ v in (0 : ℝ)..u, ((u - v : ℝ) : ℂ) * g_k v := by
            apply intervalIntegral.integral_congr
            intro v _
            dsimp [g_k]
            ring
          rw [hfp_k, h_assoc, hKernelSplit g_k hg_k u hu]
          dsimp [F_k, k0Deriv, g_k]
          ring
        exact hF_dw.congr hk_eq (hk_eq w hw)
      exact ⟨hc_dw, hcd_dw, hk_dw, hkd_dw⟩
    · intro y y' hy_cont hy'_cont hy_ode
      let u : ℝ → ℂ := fun w => y w - (y 0 * c0Kernel Q w + y' 0 * k0Kernel Q w)
      let u' : ℝ → ℂ := fun w => y' w - (y 0 * c0Deriv Q w + y' 0 * k0Deriv Q w)
      have hu0 : u 0 = 0 := by simp [u, hc0, hk0]
      have hu'0 : u' 0 = 0 := by simp [u', hcd0, hkd0]
      have hu_cont : ContinuousOn u (Set.Icc (0 : ℝ) 1) :=
        hy_cont.sub ((continuousOn_const.mul hc_cont).add (continuousOn_const.mul hk_cont))
      have hu'_cont : ContinuousOn u' (Set.Icc (0 : ℝ) 1) :=
        hy'_cont.sub ((continuousOn_const.mul hcd_cont).add (continuousOn_const.mul hkd_cont))
      have hu_Ioo : ∀ x ∈ Set.Ioo (0 : ℝ) 1,
          HasDerivAt u (u' x) x ∧ HasDerivAt u' (Q x * u x) x := by
        intro x hx
        have hx_mem : x ∈ Set.Icc (0 : ℝ) 1 := ⟨hx.1.le, hx.2.le⟩
        have hnhds : Set.Icc (0 : ℝ) 1 ∈ nhds x := Icc_mem_nhds hx.1 hx.2
        have hy_d : HasDerivAt y (y' x) x := (hy_ode x hx_mem).1.hasDerivAt hnhds
        have hy'_d : HasDerivAt y' (Q x * y x) x := (hy_ode x hx_mem).2.hasDerivAt hnhds
        obtain ⟨hc_d, hcd_d, hk_d, hkd_d⟩ := hIoo x hx
        have hd1 : HasDerivAt u
            (y' x - (y 0 * c0Deriv Q x + y' 0 * k0Deriv Q x)) x :=
          hy_d.sub ((hc_d.const_mul (y 0)).add (hk_d.const_mul (y' 0)))
        have hd2 : HasDerivAt u'
            (Q x * y x - (y 0 * (Q x * c0Kernel Q x) + y' 0 * (Q x * k0Kernel Q x))) x :=
          hy'_d.sub ((hcd_d.const_mul (y 0)).add (hkd_d.const_mul (y' 0)))
        have h_val2 : Q x * y x - (y 0 * (Q x * c0Kernel Q x) + y' 0 * (Q x * k0Kernel Q x)) =
            Q x * u x := by
          dsimp [u]
          ring
        rw [h_val2] at hd2
        exact ⟨hd1, hd2⟩
      have hu'_int : ∀ w ∈ Set.Icc (0 : ℝ) 1, u' w = ∫ v in (0 : ℝ)..w, Q v * u v := by
        intro w hw
        have hftc := intervalIntegral.integral_eq_sub_of_hasDerivAt_of_le hw.1
          (hu'_cont.mono (Set.Icc_subset_Icc_right hw.2))
          (fun x hx => (hu_Ioo x ⟨hx.1, lt_of_lt_of_le hx.2 hw.2⟩).2)
          (hIntIcc _ (hQ.mul hu_cont) w hw)
        rw [hu'0, sub_zero] at hftc
        exact hftc.symm
      have hu_int : ∀ w ∈ Set.Icc (0 : ℝ) 1,
          u w = ∫ v in (0 : ℝ)..w, ((w - v : ℝ) : ℂ) * Q v * u v := by
        intro w hw
        let Φ : ℝ → ℂ := fun x => ((w - x : ℝ) : ℂ) * u' x + u x
        have hΦ_cont : ContinuousOn Φ (Set.Icc 0 w) := by
          have hw_sub : ContinuousOn (fun x : ℝ => ((w - x : ℝ) : ℂ)) (Set.Icc 0 w) :=
            (Complex.continuous_ofReal.comp (continuous_const.sub continuous_id)).continuousOn
          exact (hw_sub.mul (hu'_cont.mono (Set.Icc_subset_Icc_right hw.2))).add
            (hu_cont.mono (Set.Icc_subset_Icc_right hw.2))
        have hΦ_deriv : ∀ x ∈ Set.Ioo 0 w,
            HasDerivAt Φ (((w - x : ℝ) : ℂ) * Q x * u x) x := by
          intro x hx
          have hx_Ioo : x ∈ Set.Ioo (0 : ℝ) 1 := ⟨hx.1, lt_of_lt_of_le hx.2 hw.2⟩
          obtain ⟨hu_d, hu'_d⟩ := hu_Ioo x hx_Ioo
          have hw_d : HasDerivAt (fun t : ℝ => ((w - t : ℝ) : ℂ)) (-1 : ℂ) x := by
            have h1 := ((hasDerivAt_const x w).sub (hasDerivAt_id x)).ofReal_comp
            have h_eq : ((0 - 1 : ℝ) : ℂ) = (-1 : ℂ) := by push_cast; ring
            rw [h_eq] at h1
            exact h1
          have hd := (hw_d.mul hu'_d).add hu_d
          have h_val : (-1 : ℂ) * u' x + ((w - x : ℝ) : ℂ) * (Q x * u x) + u' x =
              ((w - x : ℝ) : ℂ) * Q x * u x := by ring
          rw [h_val] at hd
          exact hd
        have h_int : IntervalIntegrable
            (fun v : ℝ => ((w - v : ℝ) : ℂ) * Q v * u v) MeasureTheory.volume 0 w := by
          have hw_sub : ContinuousOn (fun v : ℝ => ((w - v : ℝ) : ℂ)) (Set.Icc (0 : ℝ) 1) :=
            (Complex.continuous_ofReal.comp (continuous_const.sub continuous_id)).continuousOn
          exact hIntIcc _ ((hw_sub.mul hQ).mul hu_cont) w hw
        have hftc := intervalIntegral.integral_eq_sub_of_hasDerivAt_of_le hw.1
          hΦ_cont hΦ_deriv h_int
        have hΦw : Φ w = u w := by simp [Φ]
        have hΦ0 : Φ 0 = 0 := by simp [Φ, hu0, hu'0]
        rw [hΦw, hΦ0, sub_zero] at hftc
        exact hftc.symm
      have hIcc_ne : (Set.Icc (0 : ℝ) 1).Nonempty := ⟨0, le_rfl, zero_le_one⟩
      obtain ⟨v_Q, _, hv_Q⟩ :=
        isCompact_Icc.exists_isMaxOn hIcc_ne (continuous_norm.comp_continuousOn hQ)
      obtain ⟨v_u, _, hv_u⟩ :=
        isCompact_Icc.exists_isMaxOn hIcc_ne (continuous_norm.comp_continuousOn hu_cont)
      let M : ℝ := ‖Q v_Q‖
      let B : ℝ := ‖u v_u‖
      have hM_nn : 0 ≤ M := norm_nonneg _
      have hB_nn : 0 ≤ B := norm_nonneg _
      have hQ_le : ∀ v ∈ Set.Icc (0 : ℝ) 1, ‖Q v‖ ≤ M := fun v hv => hv_Q hv
      have hu_le : ∀ v ∈ Set.Icc (0 : ℝ) 1, ‖u v‖ ≤ B := fun v hv => hv_u hv
      have h_fact : ∀ m : ℕ, ∀ w ∈ Set.Icc (0 : ℝ) 1,
          ‖u w‖ ≤ B * ((M * w) ^ m / (m.factorial : ℝ)) := by
        intro m
        induction m with
        | zero =>
          intro w hw
          simpa using hu_le w hw
        | succ m ih =>
          intro w hw
          rw [hu_int w hw]
          let C_maj : ℝ := B * M ^ (m + 1) / (m.factorial : ℝ)
          have h_ae : ∀ᵐ v ∂MeasureTheory.volume, v ∈ Set.Ioc (0 : ℝ) w →
              ‖((w - v : ℝ) : ℂ) * Q v * u v‖ ≤ C_maj * v ^ m := by
            refine Filter.Eventually.of_forall (fun v hv => ?_)
            have hv_mem : v ∈ Set.Icc (0 : ℝ) 1 := ⟨hv.1.le, le_trans hv.2 hw.2⟩
            have hwv_nn : 0 ≤ w - v := sub_nonneg.mpr hv.2
            have hwv_le : ‖((w - v : ℝ) : ℂ)‖ ≤ 1 := by
              rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hwv_nn]
              linarith [hv.1, hw.2]
            have hQv := hQ_le v hv_mem
            have huv := ih v hv_mem
            calc ‖((w - v : ℝ) : ℂ) * Q v * u v‖
                = ‖((w - v : ℝ) : ℂ)‖ * ‖Q v‖ * ‖u v‖ := by rw [norm_mul, norm_mul]
              _ ≤ (1 * M) * (B * ((M * v) ^ m / (m.factorial : ℝ))) := by
                  refine mul_le_mul (mul_le_mul hwv_le hQv (norm_nonneg _) zero_le_one)
                    huv (norm_nonneg _) (by positivity)
              _ = C_maj * v ^ m := by
                  dsimp [C_maj]
                  rw [mul_pow]
                  ring
          have h_maj_int : IntervalIntegrable (fun v : ℝ => C_maj * v ^ m)
              MeasureTheory.volume 0 w :=
            (continuous_const.mul (continuous_pow m)).intervalIntegrable 0 w
          have h_int_le := intervalIntegral.norm_integral_le_of_norm_le hw.1 h_ae h_maj_int
          rw [intervalIntegral.integral_const_mul, integral_pow,
            zero_pow (Nat.succ_ne_zero m), sub_zero] at h_int_le
          have h_rhs : C_maj * (w ^ (m + 1) / ((m : ℝ) + 1)) =
              B * ((M * w) ^ (m + 1) / ((m + 1).factorial : ℝ)) := by
            dsimp [C_maj]
            rw [Nat.factorial_succ, Nat.cast_mul, Nat.cast_add, Nat.cast_one, mul_pow]
            have hm1 : (m : ℝ) + 1 ≠ 0 := by positivity
            have hmf : (m.factorial : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero m)
            field_simp [hm1, hmf]
          rwa [h_rhs] at h_int_le
      have hu_zero : ∀ w ∈ Set.Icc (0 : ℝ) 1, u w = 0 := by
        intro w hw
        have h_all : ∀ m : ℕ, ‖u w‖ ≤ B * (M ^ m / (m.factorial : ℝ)) := by
          intro m
          have hMw_le : (M * w) ^ m ≤ M ^ m := by
            refine pow_le_pow_left₀ (mul_nonneg hM_nn hw.1) ?_ m
            nlinarith [hw.2]
          have h_div_le : (M * w) ^ m / (m.factorial : ℝ) ≤ M ^ m / (m.factorial : ℝ) :=
            div_le_div_of_nonneg_right hMw_le (Nat.cast_nonneg _)
          exact le_trans (h_fact m w hw) (mul_le_mul_of_nonneg_left h_div_le hB_nn)
        have h_lim0 : Filter.Tendsto (fun m : ℕ => M ^ m / (m.factorial : ℝ))
            Filter.atTop (nhds 0) :=
          (Real.summable_pow_div_factorial M).tendsto_atTop_zero
        have h_lim : Filter.Tendsto (fun m : ℕ => B * (M ^ m / (m.factorial : ℝ)))
            Filter.atTop (nhds 0) := by
          simpa using h_lim0.const_mul B
        exact norm_le_zero_iff.mp (ge_of_tendsto' h_lim h_all)
      intro w hw
      have hy_eq : y w = y 0 * c0Kernel Q w + y' 0 * k0Kernel Q w :=
        sub_eq_zero.mp (hu_zero w hw)
      have hu'_zero : u' w = 0 := by
        rw [hu'_int w hw]
        have h_congr : (∫ v in (0 : ℝ)..w, Q v * u v) = ∫ _ in (0 : ℝ)..w, (0 : ℂ) := by
          apply intervalIntegral.integral_congr
          intro v hv
          rw [Set.uIcc_of_le hw.1] at hv
          dsimp only
          rw [hu_zero v ⟨hv.1, le_trans hv.2 hw.2⟩, mul_zero]
        rw [h_congr, intervalIntegral.integral_zero]
      exact ⟨hy_eq, sub_eq_zero.mp hu'_zero⟩
    · intro g g' hg_cont hg'_cont hg_ode
      let W : ℝ → ℂ := fun w => k0Deriv Q w * g w - k0Kernel Q w * g' w
      have hW_cont : ContinuousOn W (Set.Icc (0 : ℝ) 1) :=
        (hkd_cont.mul hg_cont).sub (hk_cont.mul hg'_cont)
      have hW_deriv : ∀ x ∈ Set.Ioo (0 : ℝ) 1, HasDerivAt W 0 x := by
        intro x hx
        have hx_mem : x ∈ Set.Icc (0 : ℝ) 1 := ⟨hx.1.le, hx.2.le⟩
        have hnhds : Set.Icc (0 : ℝ) 1 ∈ nhds x := Icc_mem_nhds hx.1 hx.2
        have hg_d : HasDerivAt g (g' x) x := (hg_ode x hx_mem).2.1.hasDerivAt hnhds
        have hg'_d : HasDerivAt g' (Q x * g x) x := (hg_ode x hx_mem).2.2.hasDerivAt hnhds
        obtain ⟨_, _, hk_d, hkd_d⟩ := hIoo x hx
        have hd := (hkd_d.mul hg_d).sub (hk_d.mul hg'_d)
        have h_val : (Q x * k0Kernel Q x) * g x + k0Deriv Q x * g' x -
            (k0Deriv Q x * g' x + k0Kernel Q x * (Q x * g x)) = 0 := by ring
        rw [h_val] at hd
        exact hd
      have hW_const : ∀ w ∈ Set.Icc (0 : ℝ) 1, W w = g 0 := by
        intro w hw
        have hftc := intervalIntegral.integral_eq_sub_of_hasDerivAt_of_le hw.1
          (hW_cont.mono (Set.Icc_subset_Icc_right hw.2))
          (fun x hx => hW_deriv x ⟨hx.1, lt_of_lt_of_le hx.2 hw.2⟩)
          intervalIntegrable_const
        rw [intervalIntegral.integral_zero] at hftc
        have hW0 : W 0 = g 0 := by simp [W, hkd0, hk0]
        rw [hW0] at hftc
        exact sub_eq_zero.mp hftc.symm
      let q_fn : ℝ → ℂ := fun w => k0Kernel Q w / g w
      have hq_cont : ContinuousOn q_fn (Set.Icc (0 : ℝ) 1) :=
        hk_cont.div hg_cont (fun w hw => (hg_ode w hw).1)
      have hq_deriv : ∀ x ∈ Set.Ioo (0 : ℝ) 1,
          HasDerivAt q_fn (g 0 * (g x)⁻¹ ^ 2) x := by
        intro x hx
        have hx_mem : x ∈ Set.Icc (0 : ℝ) 1 := ⟨hx.1.le, hx.2.le⟩
        have hnhds : Set.Icc (0 : ℝ) 1 ∈ nhds x := Icc_mem_nhds hx.1 hx.2
        have hg_d : HasDerivAt g (g' x) x := (hg_ode x hx_mem).2.1.hasDerivAt hnhds
        have hk_d : HasDerivAt (k0Kernel Q) (k0Deriv Q x) x := (hIoo x hx).2.2.1
        have hd := hk_d.div hg_d (hg_ode x hx_mem).1
        have hWx : k0Deriv Q x * g x - k0Kernel Q x * g' x = g 0 := hW_const x hx_mem
        have h_val : (k0Deriv Q x * g x - k0Kernel Q x * g' x) / g x ^ 2 =
            g 0 * (g x)⁻¹ ^ 2 := by
          rw [hWx, div_eq_mul_inv, inv_pow]
        rw [h_val] at hd
        exact hd
      have hg_inv_cont : ContinuousOn (fun w : ℝ => g 0 * (g w)⁻¹ ^ 2) (Set.Icc (0 : ℝ) 1) :=
        continuousOn_const.mul ((hg_cont.inv₀ (fun w hw => (hg_ode w hw).1)).pow 2)
      have hftc := intervalIntegral.integral_eq_sub_of_hasDerivAt_of_le zero_le_one
        hq_cont hq_deriv (hIntIcc _ hg_inv_cont 1 ⟨zero_le_one, le_rfl⟩)
      rw [intervalIntegral.integral_const_mul] at hftc
      have hq0 : q_fn 0 = 0 := by simp [q_fn, hk0]
      rw [hq0, sub_zero] at hftc
      have hg1_ne : g 1 ≠ 0 := (hg_ode 1 ⟨zero_le_one, le_rfl⟩).1
      calc k0Kernel Q 1 = q_fn 1 * g 1 := by
            dsimp [q_fn]
            exact (div_mul_cancel₀ _ hg1_ne).symm
        _ = (g 0 * ∫ w in (0 : ℝ)..1, (g w)⁻¹ ^ 2) * g 1 := by rw [← hftc]
        _ = g 0 * g 1 * ∫ w in (0 : ℝ)..1, (g w)⁻¹ ^ 2 := by ring

  have hLipHolo : VolterraLipHoloProp := by
    refine ⟨?_, ?_⟩
    · intro M Δ Q₁ Q₂ hM hΔ hQ₁ hQ₂ hBds
      have hexp_tsum : (∑' m : ℕ, M ^ m / (m.factorial : ℝ)) = Real.exp M :=
        (congr_fun (Real.exp_eq_exp_ℝ.trans NormedSpace.exp_eq_tsum_div) M).symm
      have hSumExp : Summable (fun m : ℕ => M ^ m / (m.factorial : ℝ)) :=
        Real.summable_pow_div_factorial M
      have hSingleIter : ∀ (Q init : ℝ → ℂ),
          ContinuousOn Q (Set.Icc (0 : ℝ) 1) →
          (∀ v ∈ Set.Icc (0 : ℝ) 1, ‖Q v‖ ≤ M) →
          ContinuousOn init (Set.Icc (0 : ℝ) 1) →
          (∀ v ∈ Set.Icc (0 : ℝ) 1, ‖init v‖ ≤ 1) →
          (∀ m : ℕ, ContinuousOn (volterraIter Q init m) (Set.Icc (0 : ℝ) 1) ∧
            ∀ w ∈ Set.Icc (0 : ℝ) 1,
              ‖volterraIter Q init m w‖ ≤ (M * w) ^ m / (m.factorial : ℝ)) ∧
          (∀ w ∈ Set.Icc (0 : ℝ) 1,
            Summable (fun m : ℕ => volterraIter Q init m w) ∧
            ‖∑' m : ℕ, volterraIter Q init m w‖ ≤ Real.exp M) := by
        intro Q init hQ hQM hinit_c hinit_b
        have h_ind : ∀ m : ℕ, ContinuousOn (volterraIter Q init m) (Set.Icc (0 : ℝ) 1) ∧
            ∀ w ∈ Set.Icc (0 : ℝ) 1,
              ‖volterraIter Q init m w‖ ≤ (M * w) ^ m / (m.factorial : ℝ) := by
          intro m
          induction m with
          | zero =>
            refine ⟨hinit_c, fun w hw => ?_⟩
            simpa [volterraIter] using hinit_b w hw
          | succ m ih =>
            rcases ih with ⟨hm_cont, hm_bd⟩
            let gm : ℝ → ℂ := fun v => Q v * volterraIter Q init m v
            have hgm_cont : ContinuousOn gm (Set.Icc (0 : ℝ) 1) := hQ.mul hm_cont
            have hvgm_cont : ContinuousOn (fun v : ℝ => (v : ℂ) * gm v) (Set.Icc (0 : ℝ) 1) :=
              Complex.continuous_ofReal.continuousOn.mul hgm_cont
            have h_next_cont : ContinuousOn (volterraIter Q init (m + 1)) (Set.Icc (0 : ℝ) 1) := by
              let F_m : ℝ → ℂ := fun u =>
                (u : ℂ) * (∫ v in (0 : ℝ)..u, gm v) - ∫ v in (0 : ℝ)..u, (v : ℂ) * gm v
              have hF_cont : ContinuousOn F_m (Set.Icc (0 : ℝ) 1) :=
                (Complex.continuous_ofReal.continuousOn.mul (hPrimContOn gm hgm_cont)).sub
                  (hPrimContOn _ hvgm_cont)
              refine hF_cont.congr (fun u hu => ?_)
              simp only [volterraIter]
              have h_assoc : (∫ v in (0 : ℝ)..u,
                  ((u - v : ℝ) : ℂ) * Q v * volterraIter Q init m v) =
                  ∫ v in (0 : ℝ)..u, ((u - v : ℝ) : ℂ) * gm v := by
                apply intervalIntegral.integral_congr
                intro v _
                dsimp [gm]
                ring
              rw [h_assoc, hKernelSplit gm hgm_cont u hu]
            refine ⟨h_next_cont, fun w hw => ?_⟩
            simp only [volterraIter]
            let C_maj : ℝ := M ^ (m + 1) / (m.factorial : ℝ)
            have h_ae : ∀ᵐ v ∂MeasureTheory.volume, v ∈ Set.Ioc (0 : ℝ) w →
                ‖((w - v : ℝ) : ℂ) * Q v * volterraIter Q init m v‖ ≤ C_maj * v ^ m := by
              refine Filter.Eventually.of_forall (fun v hv => ?_)
              have hv_mem : v ∈ Set.Icc (0 : ℝ) 1 := ⟨hv.1.le, le_trans hv.2 hw.2⟩
              have hwv_nn : 0 ≤ w - v := sub_nonneg.mpr hv.2
              have hwv_le : ‖((w - v : ℝ) : ℂ)‖ ≤ 1 := by
                rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hwv_nn]
                linarith [hv.1, hw.2]
              calc ‖((w - v : ℝ) : ℂ) * Q v * volterraIter Q init m v‖
                  = ‖((w - v : ℝ) : ℂ)‖ * ‖Q v‖ * ‖volterraIter Q init m v‖ := by
                      rw [norm_mul, norm_mul]
                _ ≤ (1 * M) * ((M * v) ^ m / (m.factorial : ℝ)) := by
                    refine mul_le_mul
                      (mul_le_mul hwv_le (hQM v hv_mem) (norm_nonneg _) zero_le_one)
                      (hm_bd v hv_mem) (norm_nonneg _) (by positivity)
                _ = C_maj * v ^ m := by
                    dsimp [C_maj]
                    rw [mul_pow]
                    ring
            have h_maj_int : IntervalIntegrable (fun v : ℝ => C_maj * v ^ m)
                MeasureTheory.volume 0 w :=
              (continuous_const.mul (continuous_pow m)).intervalIntegrable 0 w
            have h_int_le := intervalIntegral.norm_integral_le_of_norm_le hw.1 h_ae h_maj_int
            rw [intervalIntegral.integral_const_mul, integral_pow,
              zero_pow (Nat.succ_ne_zero m), sub_zero] at h_int_le
            have h_rhs : C_maj * (w ^ (m + 1) / ((m : ℝ) + 1)) =
                (M * w) ^ (m + 1) / ((m + 1).factorial : ℝ) := by
              dsimp [C_maj]
              rw [Nat.factorial_succ, Nat.cast_mul, Nat.cast_add, Nat.cast_one, mul_pow]
              have hm1 : (m : ℝ) + 1 ≠ 0 := by positivity
              have hmf : (m.factorial : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero m)
              field_simp [hm1, hmf]
            rwa [h_rhs] at h_int_le
        refine ⟨h_ind, fun w hw => ?_⟩
        have h_term_le : ∀ m : ℕ, ‖volterraIter Q init m w‖ ≤ M ^ m / (m.factorial : ℝ) := by
          intro m
          have hMw_le : (M * w) ^ m ≤ M ^ m := by
            refine pow_le_pow_left₀ (mul_nonneg hM hw.1) ?_ m
            nlinarith [hw.2]
          exact le_trans ((h_ind m).2 w hw)
            (div_le_div_of_nonneg_right hMw_le (Nat.cast_nonneg _))
        have h_sum_norm : Summable (fun m : ℕ => ‖volterraIter Q init m w‖) :=
          Summable.of_nonneg_of_le (fun _ => norm_nonneg _) h_term_le hSumExp
        have h_sum : Summable (fun m : ℕ => volterraIter Q init m w) :=
          hSumExp.of_norm_bounded h_term_le
        have h_tsum_le : ‖∑' m : ℕ, volterraIter Q init m w‖ ≤ Real.exp M := by
          calc ‖∑' m : ℕ, volterraIter Q init m w‖
              ≤ ∑' m : ℕ, ‖volterraIter Q init m w‖ := norm_tsum_le_tsum_norm h_sum_norm
            _ ≤ ∑' m : ℕ, M ^ m / (m.factorial : ℝ) :=
                h_sum_norm.tsum_le_tsum h_term_le hSumExp
            _ = Real.exp M := hexp_tsum
        exact ⟨h_sum, h_tsum_le⟩
      have hDiffIter : ∀ (init : ℝ → ℂ),
          ContinuousOn init (Set.Icc (0 : ℝ) 1) →
          (∀ v ∈ Set.Icc (0 : ℝ) 1, ‖init v‖ ≤ 1) →
          ∀ w ∈ Set.Icc (0 : ℝ) 1,
            ‖(∑' k : ℕ, volterraIter Q₁ init k w) -
              (∑' k : ℕ, volterraIter Q₂ init k w)‖ ≤ Real.exp M * Δ := by
        intro init hinit_c hinit_b
        obtain ⟨hInd₁, hSum₁⟩ :=
          hSingleIter Q₁ init hQ₁ (fun v hv => (hBds v hv).1) hinit_c hinit_b
        obtain ⟨hInd₂, hSum₂⟩ :=
          hSingleIter Q₂ init hQ₂ (fun v hv => (hBds v hv).2.1) hinit_c hinit_b
        let d : ℕ → ℝ → ℂ := fun k w => volterraIter Q₁ init k w - volterraIter Q₂ init k w
        have hd_ind : ∀ m : ℕ, ∀ w ∈ Set.Icc (0 : ℝ) 1,
            ‖d (m + 1) w‖ ≤ Δ * M ^ m * w ^ (m + 1) / (m.factorial : ℝ) := by
          intro m
          induction m with
          | zero =>
            intro w hw
            dsimp [d, volterraIter]
            have hw_sub : ContinuousOn (fun v : ℝ => ((w - v : ℝ) : ℂ)) (Set.Icc (0 : ℝ) 1) :=
              (Complex.continuous_ofReal.comp (continuous_const.sub continuous_id)).continuousOn
            have h1_int : IntervalIntegrable
                (fun v : ℝ => ((w - v : ℝ) : ℂ) * Q₁ v * init v) MeasureTheory.volume 0 w :=
              hIntIcc _ ((hw_sub.mul hQ₁).mul hinit_c) w hw
            have h2_int : IntervalIntegrable
                (fun v : ℝ => ((w - v : ℝ) : ℂ) * Q₂ v * init v) MeasureTheory.volume 0 w :=
              hIntIcc _ ((hw_sub.mul hQ₂).mul hinit_c) w hw
            rw [← intervalIntegral.integral_sub h1_int h2_int]
            have h_congr : (∫ v in (0 : ℝ)..w,
                (((w - v : ℝ) : ℂ) * Q₁ v * init v - ((w - v : ℝ) : ℂ) * Q₂ v * init v)) =
                ∫ v in (0 : ℝ)..w, ((w - v : ℝ) : ℂ) * (Q₁ v - Q₂ v) * init v := by
              apply intervalIntegral.integral_congr
              intro v _
              ring
            rw [h_congr]
            have h_le : ‖∫ v in (0 : ℝ)..w, ((w - v : ℝ) : ℂ) * (Q₁ v - Q₂ v) * init v‖ ≤
                Δ * |w - 0| := by
              apply intervalIntegral.norm_integral_le_of_norm_le_const
              intro v hv
              rw [Set.uIoc_of_le hw.1] at hv
              have hv_mem : v ∈ Set.Icc (0 : ℝ) 1 := ⟨hv.1.le, le_trans hv.2 hw.2⟩
              have hwv_nn : 0 ≤ w - v := sub_nonneg.mpr hv.2
              have hwv_le : ‖((w - v : ℝ) : ℂ)‖ ≤ 1 := by
                rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hwv_nn]
                linarith [hv.1, hw.2]
              calc ‖((w - v : ℝ) : ℂ) * (Q₁ v - Q₂ v) * init v‖
                  = ‖((w - v : ℝ) : ℂ)‖ * ‖Q₁ v - Q₂ v‖ * ‖init v‖ := by
                      rw [norm_mul, norm_mul]
                _ ≤ (1 * Δ) * 1 := by
                    refine mul_le_mul
                      (mul_le_mul hwv_le (hBds v hv_mem).2.2 (norm_nonneg _) zero_le_one)
                      (hinit_b v hv_mem) (norm_nonneg _) (by positivity)
                _ = Δ := by ring
            have hw_abs : |w - 0| = w := by rw [sub_zero, abs_of_nonneg hw.1]
            rw [hw_abs] at h_le
            simpa using h_le
          | succ m ih =>
            intro w hw
            let u₁ := volterraIter Q₁ init (m + 1)
            let u₂ := volterraIter Q₂ init (m + 1)
            change ‖(∫ v in (0 : ℝ)..w, ((w - v : ℝ) : ℂ) * Q₁ v * u₁ v) -
              (∫ v in (0 : ℝ)..w, ((w - v : ℝ) : ℂ) * Q₂ v * u₂ v)‖ ≤
              Δ * M ^ (m + 1) * w ^ (m + 2) / ((m + 1).factorial : ℝ)
            have hw_sub : ContinuousOn (fun v : ℝ => ((w - v : ℝ) : ℂ)) (Set.Icc (0 : ℝ) 1) :=
              (Complex.continuous_ofReal.comp (continuous_const.sub continuous_id)).continuousOn
            have h1_int : IntervalIntegrable
                (fun v : ℝ => ((w - v : ℝ) : ℂ) * Q₁ v * u₁ v) MeasureTheory.volume 0 w :=
              hIntIcc _ ((hw_sub.mul hQ₁).mul (hInd₁ (m + 1)).1) w hw
            have h2_int : IntervalIntegrable
                (fun v : ℝ => ((w - v : ℝ) : ℂ) * Q₂ v * u₂ v) MeasureTheory.volume 0 w :=
              hIntIcc _ ((hw_sub.mul hQ₂).mul (hInd₂ (m + 1)).1) w hw
            rw [← intervalIntegral.integral_sub h1_int h2_int]
            let C_m : ℝ := Δ * (M ^ (m + 1) / ((m + 1).factorial : ℝ)) +
              M * (Δ * M ^ m / (m.factorial : ℝ))
            have h_ae : ∀ᵐ v ∂MeasureTheory.volume, v ∈ Set.Ioc (0 : ℝ) w →
                ‖((w - v : ℝ) : ℂ) * Q₁ v * u₁ v - ((w - v : ℝ) : ℂ) * Q₂ v * u₂ v‖ ≤
                  C_m * v ^ (m + 1) := by
              refine Filter.Eventually.of_forall (fun v hv => ?_)
              have hv_mem : v ∈ Set.Icc (0 : ℝ) 1 := ⟨hv.1.le, le_trans hv.2 hw.2⟩
              have hwv_nn : 0 ≤ w - v := sub_nonneg.mpr hv.2
              have hwv_le : ‖((w - v : ℝ) : ℂ)‖ ≤ 1 := by
                rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hwv_nn]
                linarith [hv.1, hw.2]
              have h_alg : ((w - v : ℝ) : ℂ) * Q₁ v * u₁ v - ((w - v : ℝ) : ℂ) * Q₂ v * u₂ v =
                  ((w - v : ℝ) : ℂ) * ((Q₁ v - Q₂ v) * u₁ v + Q₂ v * d (m + 1) v) := by
                dsimp [d, u₁, u₂]
                ring
              have hu₁_v : ‖u₁ v‖ ≤ (M ^ (m + 1) / ((m + 1).factorial : ℝ)) * v ^ (m + 1) := by
                have h1 := (hInd₁ (m + 1)).2 v hv_mem
                rwa [mul_pow, ← div_mul_eq_mul_div] at h1
              have hd_v : ‖d (m + 1) v‖ ≤ (Δ * M ^ m / (m.factorial : ℝ)) * v ^ (m + 1) := by
                have h1 := ih v hv_mem
                rwa [← div_mul_eq_mul_div] at h1
              have h_inner : ‖(Q₁ v - Q₂ v) * u₁ v + Q₂ v * d (m + 1) v‖ ≤ C_m * v ^ (m + 1) := by
                calc ‖(Q₁ v - Q₂ v) * u₁ v + Q₂ v * d (m + 1) v‖
                    ≤ ‖(Q₁ v - Q₂ v) * u₁ v‖ + ‖Q₂ v * d (m + 1) v‖ := norm_add_le _ _
                  _ = ‖Q₁ v - Q₂ v‖ * ‖u₁ v‖ + ‖Q₂ v‖ * ‖d (m + 1) v‖ := by
                      rw [norm_mul, norm_mul]
                  _ ≤ Δ * ((M ^ (m + 1) / ((m + 1).factorial : ℝ)) * v ^ (m + 1)) +
                        M * ((Δ * M ^ m / (m.factorial : ℝ)) * v ^ (m + 1)) := by
                      refine add_le_add
                        (mul_le_mul (hBds v hv_mem).2.2 hu₁_v (norm_nonneg _) hΔ)
                        (mul_le_mul (hBds v hv_mem).2.1 hd_v (norm_nonneg _) hM)
                  _ = C_m * v ^ (m + 1) := by
                      dsimp [C_m]
                      ring
              rw [h_alg, norm_mul]
              calc ‖((w - v : ℝ) : ℂ)‖ * ‖(Q₁ v - Q₂ v) * u₁ v + Q₂ v * d (m + 1) v‖
                  ≤ 1 * (C_m * v ^ (m + 1)) :=
                    mul_le_mul hwv_le h_inner (norm_nonneg _) zero_le_one
                _ = C_m * v ^ (m + 1) := one_mul _
            have h_maj_int : IntervalIntegrable (fun v : ℝ => C_m * v ^ (m + 1))
                MeasureTheory.volume 0 w :=
              (continuous_const.mul (continuous_pow (m + 1))).intervalIntegrable 0 w
            have h_int_le := intervalIntegral.norm_integral_le_of_norm_le hw.1 h_ae h_maj_int
            rw [intervalIntegral.integral_const_mul, integral_pow,
              zero_pow (Nat.succ_ne_zero (m + 1)), sub_zero] at h_int_le
            have h_rhs : C_m * (w ^ (m + 1 + 1) / (((m + 1 : ℕ) : ℝ) + 1)) =
                Δ * M ^ (m + 1) * w ^ (m + 2) / ((m + 1).factorial : ℝ) := by
              dsimp [C_m]
              rw [Nat.factorial_succ, Nat.cast_mul, Nat.cast_add, Nat.cast_one]
              have hm1 : (m : ℝ) + 1 ≠ 0 := by positivity
              have hm2 : (m : ℝ) + 1 + 1 ≠ 0 := by positivity
              have hmf : (m.factorial : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero m)
              field_simp [hm1, hm2, hmf]
              ring
            rwa [h_rhs] at h_int_le
        intro w hw
        have hs₁ := (hSum₁ w hw).1
        have hs₂ := (hSum₂ w hw).1
        have hd_sum : Summable (fun k : ℕ => d k w) := hs₁.sub hs₂
        have h_shift : (∑' k : ℕ, volterraIter Q₁ init k w) -
            (∑' k : ℕ, volterraIter Q₂ init k w) = ∑' m : ℕ, d (m + 1) w := by
          rw [← hs₁.tsum_sub hs₂]
          change (∑' k : ℕ, d k w) = ∑' m : ℕ, d (m + 1) w
          rw [hd_sum.tsum_eq_zero_add]
          have hd0 : d 0 w = 0 := sub_self _
          rw [hd0, zero_add]
        rw [h_shift]
        have h_term : ∀ m : ℕ, ‖d (m + 1) w‖ ≤ (M ^ m / (m.factorial : ℝ)) * Δ := by
          intro m
          have hw_pow : w ^ (m + 1) ≤ 1 := pow_le_one₀ hw.1 hw.2
          calc ‖d (m + 1) w‖
              ≤ Δ * M ^ m * w ^ (m + 1) / (m.factorial : ℝ) := hd_ind m w hw
            _ ≤ Δ * M ^ m * 1 / (m.factorial : ℝ) := by
                refine div_le_div_of_nonneg_right ?_ (Nat.cast_nonneg _)
                exact mul_le_mul_of_nonneg_left hw_pow (by positivity)
            _ = (M ^ m / (m.factorial : ℝ)) * Δ := by ring
        have h_sum_maj : Summable (fun m : ℕ => (M ^ m / (m.factorial : ℝ)) * Δ) :=
          hSumExp.mul_right Δ
        have h_sum_norm : Summable (fun m : ℕ => ‖d (m + 1) w‖) :=
          Summable.of_nonneg_of_le (fun _ => norm_nonneg _) h_term h_sum_maj
        calc ‖∑' m : ℕ, d (m + 1) w‖
            ≤ ∑' m : ℕ, ‖d (m + 1) w‖ := norm_tsum_le_tsum_norm h_sum_norm
          _ ≤ ∑' m : ℕ, (M ^ m / (m.factorial : ℝ)) * Δ :=
              h_sum_norm.tsum_le_tsum h_term h_sum_maj
          _ = (∑' m : ℕ, M ^ m / (m.factorial : ℝ)) * Δ := tsum_mul_right
          _ = Real.exp M * Δ := by rw [hexp_tsum]
      have hinit_1_b : ∀ v ∈ Set.Icc (0 : ℝ) 1, ‖(1 : ℂ)‖ ≤ 1 := fun _ _ => by simp
      have hinit_v_b : ∀ v ∈ Set.Icc (0 : ℝ) 1, ‖(v : ℂ)‖ ≤ 1 := by
        intro v hv
        rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hv.1]
        exact hv.2
      have hc₁_bd : ∀ v ∈ Set.Icc (0 : ℝ) 1, ‖c0Kernel Q₁ v‖ ≤ Real.exp M :=
        fun v hv => ((hSingleIter Q₁ (fun _ => 1) hQ₁ (fun u hu => (hBds u hu).1)
          continuousOn_const hinit_1_b).2 v hv).2
      have hk₁_bd : ∀ v ∈ Set.Icc (0 : ℝ) 1, ‖k0Kernel Q₁ v‖ ≤ Real.exp M :=
        fun v hv => ((hSingleIter Q₁ (fun u => (u : ℂ)) hQ₁ (fun u hu => (hBds u hu).1)
          Complex.continuous_ofReal.continuousOn hinit_v_b).2 v hv).2
      have hc_diff : ∀ v ∈ Set.Icc (0 : ℝ) 1,
          ‖c0Kernel Q₁ v - c0Kernel Q₂ v‖ ≤ Real.exp M * Δ :=
        hDiffIter (fun _ => 1) continuousOn_const hinit_1_b
      have hk_diff : ∀ v ∈ Set.Icc (0 : ℝ) 1,
          ‖k0Kernel Q₁ v - k0Kernel Q₂ v‖ ≤ Real.exp M * Δ :=
        hDiffIter (fun u => (u : ℂ)) Complex.continuous_ofReal.continuousOn hinit_v_b
      have hODE₁ := hODE Q₁ hQ₁
      have hODE₂ := hODE Q₂ hQ₂
      have hc₁_cont : ContinuousOn (c0Kernel Q₁) (Set.Icc (0 : ℝ) 1) := hODE₁.2.2.2.2.1
      have hk₁_cont : ContinuousOn (k0Kernel Q₁) (Set.Icc (0 : ℝ) 1) := hODE₁.2.2.2.2.2.2.1
      have hc₂_cont : ContinuousOn (c0Kernel Q₂) (Set.Icc (0 : ℝ) 1) := hODE₂.2.2.2.2.1
      have hk₂_cont : ContinuousOn (k0Kernel Q₂) (Set.Icc (0 : ℝ) 1) := hODE₂.2.2.2.2.2.2.1
      intro w hw
      have hw_abs : |w - 0| = w := by rw [sub_zero, abs_of_nonneg hw.1]
      have hcd₁_w : ‖c0Deriv Q₁ w‖ ≤ M * Real.exp M := by
        have h_le : ‖∫ v in (0 : ℝ)..w, Q₁ v * c0Kernel Q₁ v‖ ≤
            (M * Real.exp M) * |w - 0| := by
          apply intervalIntegral.norm_integral_le_of_norm_le_const
          intro v hv
          rw [Set.uIoc_of_le hw.1] at hv
          have hv_mem : v ∈ Set.Icc (0 : ℝ) 1 := ⟨hv.1.le, le_trans hv.2 hw.2⟩
          rw [norm_mul]
          exact mul_le_mul (hBds v hv_mem).1 (hc₁_bd v hv_mem) (norm_nonneg _) hM
        rw [hw_abs] at h_le
        exact le_trans h_le (mul_le_of_le_one_right (mul_nonneg hM (Real.exp_pos M).le) hw.2)
      have hkd₁_w : ‖k0Deriv Q₁ w‖ ≤ 1 + M * Real.exp M := by
        have h_le : ‖∫ v in (0 : ℝ)..w, Q₁ v * k0Kernel Q₁ v‖ ≤
            (M * Real.exp M) * |w - 0| := by
          apply intervalIntegral.norm_integral_le_of_norm_le_const
          intro v hv
          rw [Set.uIoc_of_le hw.1] at hv
          have hv_mem : v ∈ Set.Icc (0 : ℝ) 1 := ⟨hv.1.le, le_trans hv.2 hw.2⟩
          rw [norm_mul]
          exact mul_le_mul (hBds v hv_mem).1 (hk₁_bd v hv_mem) (norm_nonneg _) hM
        rw [hw_abs] at h_le
        have h_int_le : ‖∫ v in (0 : ℝ)..w, Q₁ v * k0Kernel Q₁ v‖ ≤ M * Real.exp M :=
          le_trans h_le (mul_le_of_le_one_right (mul_nonneg hM (Real.exp_pos M).le) hw.2)
        calc ‖k0Deriv Q₁ w‖
            = ‖(1 : ℂ) + ∫ v in (0 : ℝ)..w, Q₁ v * k0Kernel Q₁ v‖ := rfl
          _ ≤ ‖(1 : ℂ)‖ + ‖∫ v in (0 : ℝ)..w, Q₁ v * k0Kernel Q₁ v‖ := norm_add_le _ _
          _ ≤ 1 + M * Real.exp M := by simp [h_int_le]
      have hDerivDiff : ∀ (y₁ y₂ : ℝ → ℂ),
          ContinuousOn y₁ (Set.Icc (0 : ℝ) 1) →
          ContinuousOn y₂ (Set.Icc (0 : ℝ) 1) →
          (∀ v ∈ Set.Icc (0 : ℝ) 1, ‖y₁ v‖ ≤ Real.exp M) →
          (∀ v ∈ Set.Icc (0 : ℝ) 1, ‖y₁ v - y₂ v‖ ≤ Real.exp M * Δ) →
          ‖(∫ v in (0 : ℝ)..w, Q₁ v * y₁ v) - (∫ v in (0 : ℝ)..w, Q₂ v * y₂ v)‖ ≤
            (1 + M) * Real.exp M * Δ := by
        intro y₁ y₂ hy₁_c hy₂_c hy₁_bd hy_diff
        have h1_int := hIntIcc (fun v => Q₁ v * y₁ v) (hQ₁.mul hy₁_c) w hw
        have h2_int := hIntIcc (fun v => Q₂ v * y₂ v) (hQ₂.mul hy₂_c) w hw
        rw [← intervalIntegral.integral_sub h1_int h2_int]
        have h_le : ‖∫ v in (0 : ℝ)..w, (Q₁ v * y₁ v - Q₂ v * y₂ v)‖ ≤
            ((1 + M) * Real.exp M * Δ) * |w - 0| := by
          apply intervalIntegral.norm_integral_le_of_norm_le_const
          intro v hv
          rw [Set.uIoc_of_le hw.1] at hv
          have hv_mem : v ∈ Set.Icc (0 : ℝ) 1 := ⟨hv.1.le, le_trans hv.2 hw.2⟩
          have h_alg : Q₁ v * y₁ v - Q₂ v * y₂ v =
              (Q₁ v - Q₂ v) * y₁ v + Q₂ v * (y₁ v - y₂ v) := by ring
          rw [h_alg]
          calc ‖(Q₁ v - Q₂ v) * y₁ v + Q₂ v * (y₁ v - y₂ v)‖
              ≤ ‖(Q₁ v - Q₂ v) * y₁ v‖ + ‖Q₂ v * (y₁ v - y₂ v)‖ := norm_add_le _ _
            _ = ‖Q₁ v - Q₂ v‖ * ‖y₁ v‖ + ‖Q₂ v‖ * ‖y₁ v - y₂ v‖ := by rw [norm_mul, norm_mul]
            _ ≤ Δ * Real.exp M + M * (Real.exp M * Δ) := by
                refine add_le_add
                  (mul_le_mul (hBds v hv_mem).2.2 (hy₁_bd v hv_mem) (norm_nonneg _) hΔ)
                  (mul_le_mul (hBds v hv_mem).2.1 (hy_diff v hv_mem) (norm_nonneg _) hM)
            _ = (1 + M) * Real.exp M * Δ := by ring
        rw [hw_abs] at h_le
        have h_nn : 0 ≤ (1 + M) * Real.exp M * Δ := by positivity
        exact le_trans h_le (mul_le_of_le_one_right h_nn hw.2)
      have hcd_diff_w : ‖c0Deriv Q₁ w - c0Deriv Q₂ w‖ ≤ (1 + M) * Real.exp M * Δ :=
        hDerivDiff (c0Kernel Q₁) (c0Kernel Q₂) hc₁_cont hc₂_cont hc₁_bd hc_diff
      have hkd_diff_w : ‖k0Deriv Q₁ w - k0Deriv Q₂ w‖ ≤ (1 + M) * Real.exp M * Δ := by
        have h_sub : k0Deriv Q₁ w - k0Deriv Q₂ w =
            (∫ v in (0 : ℝ)..w, Q₁ v * k0Kernel Q₁ v) -
              (∫ v in (0 : ℝ)..w, Q₂ v * k0Kernel Q₂ v) := by
          dsimp [k0Deriv]
          ring
        rw [h_sub]
        exact hDerivDiff (k0Kernel Q₁) (k0Kernel Q₂) hk₁_cont hk₂_cont hk₁_bd hk_diff
      exact ⟨hc₁_bd w hw, hk₁_bd w hw, hcd₁_w, hkd₁_w,
        hc_diff w hw, hk_diff w hw, hcd_diff_w, hkd_diff_w⟩
    · intro U Q a₀ a₁ hU hQ_cont hQ_holo ha₀ ha₁
      have hPH := hSfca.param_holo U Q hU hQ_cont hQ_holo
      rw [← hc0_eq, ← hk0_eq, ← hc0d_eq, ← hk0d_eq] at hPH
      rcases hPH with ⟨hc_pcont, hk_pcont, hcd_pcont, hkd_pcont, h_slice⟩
      have h1_mem : (1 : ℝ) ∈ Set.Icc (0 : ℝ) 1 := ⟨zero_le_one, le_rfl⟩
      have hc1_holo : DifferentiableOn ℂ (fun p => c0Kernel (Q p) 1) U := (h_slice 1 h1_mem).1
      have hk1_holo : DifferentiableOn ℂ (fun p => k0Kernel (Q p) 1) U := (h_slice 1 h1_mem).2.1
      have hPertHolo : ∀ sgn : ℂ,
          DifferentiableOn ℂ (fun p => k0Kernel (pertPotential sgn (Q p) (a₀ p) (a₁ p)) 1) U := by
        intro sgn
        let P_sgn : ℂ × ℂ → ℝ → ℂ := fun p w => pertPotential sgn (Q p) (a₀ p) (a₁ p) w
        have ha₀_c : ContinuousOn (fun q : (ℂ × ℂ) × ℝ => a₀ q.1) (U ×ˢ Set.Icc (0 : ℝ) 1) :=
          ha₀.continuousOn.comp continuous_fst.continuousOn (fun _ hq => hq.1)
        have ha₁_c : ContinuousOn (fun q : (ℂ × ℂ) × ℝ => a₁ q.1) (U ×ˢ Set.Icc (0 : ℝ) 1) :=
          ha₁.continuousOn.comp continuous_fst.continuousOn (fun _ hq => hq.1)
        have hP_cont : ContinuousOn (fun q : (ℂ × ℂ) × ℝ => P_sgn q.1 q.2)
            (U ×ˢ Set.Icc (0 : ℝ) 1) := by
          dsimp [P_sgn, pertPotential]
          have hFw_c := (ha₀_c.mul hc_pcont).add (ha₁_c.mul hk_pcont)
          have hFpw_c := (ha₀_c.mul hcd_pcont).add (ha₁_c.mul hkd_pcont)
          exact (hQ_cont.sub (continuousOn_const.mul hFpw_c)).sub
            (continuousOn_const.mul (hFw_c.pow 2))
        have hP_holo : ∀ w ∈ Set.Icc (0 : ℝ) 1, DifferentiableOn ℂ (fun p => P_sgn p w) U := by
          intro w hw
          dsimp [P_sgn, pertPotential]
          rcases h_slice w hw with ⟨hc_w, hk_w, hcd_w, hkd_w⟩
          have hFw_h := (ha₀.mul hc_w).add (ha₁.mul hk_w)
          have hFpw_h := (ha₀.mul hcd_w).add (ha₁.mul hkd_w)
          exact ((hQ_holo w hw).sub ((differentiableOn_const _).mul hFpw_h)).sub
            ((differentiableOn_const _).mul (hFw_h.pow 2))
        have hPH_sgn := hSfca.param_holo U P_sgn hU hP_cont hP_holo
        rw [← hk0_eq] at hPH_sgn
        exact (hPH_sgn.2.2.2.2 1 h1_mem).2.1
      exact ⟨hc1_holo, hk1_holo, hPertHolo 1, hPertHolo (-1)⟩

  exact ⟨hODE, hLipHolo⟩

theorem sl_exact_symmetries_wronskian_product_and_free_eval (hSfca : SfcaVolterraKernelProp)
    (hODE : VolterraODEProp)
    (hLip : VolterraLipHoloProp) :
    (∀ (Q : ℝ → ℂ) (a₀ a₁ : ℂ),
      ContinuousOn Q (Set.Icc (0 : ℝ) 1) →
      k0Kernel (fun w => Q (1 - w)) 1 = k0Kernel Q 1 ∧
      kPlusVal Q (-a₀) (-a₁) = kMinusVal Q a₀ a₁ ∧
      kMinusVal Q (-a₀) (-a₁) = kPlusVal Q a₀ a₁ ∧
      canonRoot Q (-a₀) (-a₁) = canonRoot Q a₀ a₁ ∧
      ∀ w₀ w₁ : ℂ, slNumerator Q (-w₀) (-w₁) = slNumerator Q w₀ w₁) ∧
    (∀ (Q : ℝ → ℂ) (a₀ a₁ : ℂ),
      ContinuousOn Q (Set.Icc (0 : ℝ) 1) →
      let b₁ := a₀ * c0Kernel Q 1 + a₁ * k0Kernel Q 1
      let b₁' := a₀ * c0Deriv Q 1 + a₁ * k0Deriv Q 1
      canonRoot (fun w => Q (1 - w)) (-b₁) b₁' = canonRoot Q a₀ a₁ ∧
      -a₀ = (-b₁) * c0Kernel (fun w => Q (1 - w)) 1 +
        b₁' * k0Kernel (fun w => Q (1 - w)) 1) ∧
    (∀ Q : ℝ → ℂ,
      ContinuousOn Q (Set.Icc (0 : ℝ) 1) →
      k0Kernel Q 1 ≠ 0 →
      ∀ u v : ℂ, slNumerator (fun w => Q (1 - w)) u v = slNumerator Q (-v) (-u)) ∧
    (∀ (Q : ℝ → ℂ) (a₁ : ℂ),
      ContinuousOn Q (Set.Icc (0 : ℝ) 1) →
      kPlusVal Q 0 a₁ * kMinusVal Q 0 a₁ = (k0Kernel Q 1) ^ 2) ∧
    k0Kernel (fun _ => 0) 1 = 1 ∧
    (∀ lam : ℂ, 0 < ‖lam‖ → ‖lam‖ < 1 →
      slDivided (fun _ => 0) lam 0 =
        (lam / 2 - Complex.sin (lam / 2)) / (4 * (lam / 2) ^ 3)) ∧
    Filter.Tendsto
      (fun lam : ℂ => (lam / 2 - Complex.sin (lam / 2)) / (4 * (lam / 2) ^ 3))
      (nhdsWithin 0 {(0 : ℂ)}ᶜ) (nhds (1 / 24 : ℂ)) :=
by
  let _ := hLip
  
  have hIter : ∀ (Q init : ℝ → ℂ) (m : ℕ) (w : ℝ),
      volterraIter Q init m w = sfcaVolterraIter init Q m w := by
    intro Q init m
    induction m with
    | zero => intro w; rfl
    | succ m ih =>
      intro w
      simp only [volterraIter, sfcaVolterraIter, ih]

  have hc0_eq : ∀ (Q : ℝ → ℂ) (w : ℝ), c0Kernel Q w = sfcaVolterraC Q w := by
    intro Q w
    simp only [c0Kernel, sfcaVolterraC, hIter]

  have hk0_eq : ∀ (Q : ℝ → ℂ) (w : ℝ), k0Kernel Q w = sfcaVolterraK Q w := by
    intro Q w
    simp only [k0Kernel, sfcaVolterraK, hIter]

  have k0Kernel_one_congr : ∀ (P₁ P₂ : ℝ → ℂ),
      (∀ w ∈ Set.Icc (0 : ℝ) 1, P₁ w = P₂ w) → k0Kernel P₁ 1 = k0Kernel P₂ 1 := by
    intro P₁ P₂ hP
    have hIter_congr : ∀ (init : ℝ → ℂ) (m : ℕ),
        ∀ w ∈ Set.Icc (0 : ℝ) 1, volterraIter P₁ init m w = volterraIter P₂ init m w := by
      intro init m
      induction m with
      | zero => intro w _; rfl
      | succ m ih =>
        intro w hw
        simp only [volterraIter]
        apply intervalIntegral.integral_congr
        intro v hv
        rw [Set.uIcc_of_le hw.1] at hv
        have hv1 : v ∈ Set.Icc (0 : ℝ) 1 := ⟨hv.1, le_trans hv.2 hw.2⟩
        dsimp only
        rw [hP v hv1, ih v hv1]
    simp only [k0Kernel]
    exact tsum_congr (fun m => hIter_congr (fun v => (v : ℂ)) m 1 ⟨zero_le_one, le_rfl⟩)

  have hc0_zero : ∀ w ∈ Set.Icc (0 : ℝ) 1, c0Kernel (fun _ => 0) w = 1 := by
    intro w hw
    rw [hc0_eq]
    exact (hSfca.zero_pot w hw).1

  have hk0_zero : k0Kernel (fun _ => 0) 1 = 1 := by
    rw [hk0_eq]
    have h1 := (hSfca.zero_pot 1 ⟨zero_le_one, le_rfl⟩).2
    rw [Complex.ofReal_one] at h1
    exact h1

  have hk0_rev_symm : ∀ Q : ℝ → ℂ,
      ContinuousOn Q (Set.Icc (0 : ℝ) 1) →
      k0Kernel (fun w => Q (1 - w)) 1 = k0Kernel Q 1 := by
    intro Q hQ
    rw [hk0_eq, hk0_eq]
    exact hSfca.rev_symm Q hQ

  have hkp_neg : ∀ (Q : ℝ → ℂ) (a₀ a₁ : ℂ),
      kPlusVal Q (-a₀) (-a₁) = kMinusVal Q a₀ a₁ := by
    intro Q a₀ a₁
    have hpot : pertPotential 1 Q (-a₀) (-a₁) = pertPotential (-1) Q a₀ a₁ := by
      funext w
      dsimp [pertPotential]
      ring
    simp only [kPlusVal, kMinusVal, hpot]

  have hkm_neg : ∀ (Q : ℝ → ℂ) (a₀ a₁ : ℂ),
      kMinusVal Q (-a₀) (-a₁) = kPlusVal Q a₀ a₁ := by
    intro Q a₀ a₁
    have hpot : pertPotential (-1) Q (-a₀) (-a₁) = pertPotential 1 Q a₀ a₁ := by
      funext w
      dsimp [pertPotential]
      ring
    simp only [kPlusVal, kMinusVal, hpot]

  have hcanon_neg : ∀ (Q : ℝ → ℂ) (a₀ a₁ : ℂ),
      canonRoot Q (-a₀) (-a₁) = canonRoot Q a₀ a₁ := by
    intro Q a₀ a₁
    dsimp only [canonRoot]
    rw [hkp_neg Q a₀ a₁, hkm_neg Q a₀ a₁]
    set kp := kPlusVal Q a₀ a₁
    set km := kMinusVal Q a₀ a₁
    have hsum : km + kp = kp + km := add_comm km kp
    have hprod : 4 * km * kp = 4 * kp * km := by ring
    rw [hsum, hprod]

  have hslNum_neg : ∀ (Q : ℝ → ℂ) (w₀ w₁ : ℂ),
      slNumerator Q (-w₀) (-w₁) = slNumerator Q w₀ w₁ := by
    intro Q w₀ w₁
    dsimp only [slNumerator]
    have h_slope : ((-w₁) - (-w₀) * c0Kernel Q 1) / k0Kernel Q 1 =
        -((w₁ - w₀ * c0Kernel Q 1) / k0Kernel Q 1) := by ring
    rw [h_slope, hcanon_neg]

  have hConj1 : ∀ (Q : ℝ → ℂ) (a₀ a₁ : ℂ),
      ContinuousOn Q (Set.Icc (0 : ℝ) 1) →
      k0Kernel (fun w => Q (1 - w)) 1 = k0Kernel Q 1 ∧
      kPlusVal Q (-a₀) (-a₁) = kMinusVal Q a₀ a₁ ∧
      kMinusVal Q (-a₀) (-a₁) = kPlusVal Q a₀ a₁ ∧
      canonRoot Q (-a₀) (-a₁) = canonRoot Q a₀ a₁ ∧
      ∀ w₀ w₁ : ℂ, slNumerator Q (-w₀) (-w₁) = slNumerator Q w₀ w₁ :=
    fun Q a₀ a₁ hQ =>
      ⟨hk0_rev_symm Q hQ, hkp_neg Q a₀ a₁, hkm_neg Q a₀ a₁, hcanon_neg Q a₀ a₁, hslNum_neg Q⟩

  
  have hConj2 : ∀ (Q : ℝ → ℂ) (a₀ a₁ : ℂ),
      ContinuousOn Q (Set.Icc (0 : ℝ) 1) →
      let b₁ := a₀ * c0Kernel Q 1 + a₁ * k0Kernel Q 1
      let b₁' := a₀ * c0Deriv Q 1 + a₁ * k0Deriv Q 1
      canonRoot (fun w => Q (1 - w)) (-b₁) b₁' = canonRoot Q a₀ a₁ ∧
      -a₀ = (-b₁) * c0Kernel (fun w => Q (1 - w)) 1 +
        b₁' * k0Kernel (fun w => Q (1 - w)) 1 := by
    intro Q a₀ a₁ hQ
    dsimp only
    set I01 : Set ℝ := Set.Icc (0 : ℝ) 1
    set φ : ℝ → ℝ := fun w => 1 - w
    set Q_rev : ℝ → ℂ := fun w => Q (1 - w)
    set b₁ : ℂ := a₀ * c0Kernel Q 1 + a₁ * k0Kernel Q 1
    set b₁' : ℂ := a₀ * c0Deriv Q 1 + a₁ * k0Deriv Q 1
    have hφ_maps : Set.MapsTo φ I01 I01 := by
      intro w hw
      exact ⟨by linarith [hw.2], by linarith [hw.1]⟩
    have hφ_cont : Continuous φ := continuous_const.sub continuous_id
    have hQ_rev : ContinuousOn Q_rev I01 := hQ.comp hφ_cont.continuousOn hφ_maps
    have hdφ : ∀ w ∈ I01, HasDerivWithinAt φ (-1 : ℝ) I01 w := by
      intro w _
      have hd := ((hasDerivAt_const w (1 : ℝ)).sub (hasDerivAt_id' w)).hasDerivWithinAt (s := I01)
      have h_sub : (0 : ℝ) - 1 = -1 := by norm_num
      rw [h_sub] at hd
      exact hd
    obtain ⟨hc0_0, hc0'_0, hk0_0, hk0'_0, hc0_cont, hc0'_cont, hk0_cont, hk0'_cont,
      hd_base, _, _⟩ := hODE Q hQ
    let F : ℝ → ℂ := fun w => a₀ * c0Kernel Q w + a₁ * k0Kernel Q w
    let F' : ℝ → ℂ := fun w => a₀ * c0Deriv Q w + a₁ * k0Deriv Q w
    have hF_0 : F 0 = a₀ := by simp [F, hc0_0, hk0_0]
    have hF_1 : F 1 = b₁ := rfl
    have hF'_1 : F' 1 = b₁' := rfl
    have hF_cont : ContinuousOn F I01 :=
      (continuousOn_const.mul hc0_cont).add (continuousOn_const.mul hk0_cont)
    have hF'_cont : ContinuousOn F' I01 :=
      (continuousOn_const.mul hc0'_cont).add (continuousOn_const.mul hk0'_cont)
    have hdF : ∀ u ∈ I01, HasDerivWithinAt F (F' u) I01 u := by
      intro u hu
      obtain ⟨hdc0, _, hdk0, _⟩ := hd_base u hu
      exact (hdc0.const_mul a₀).add (hdk0.const_mul a₁)
    have hdF' : ∀ u ∈ I01, HasDerivWithinAt F' (Q u * F u) I01 u := by
      intro u hu
      obtain ⟨_, hdc0', _, hdk0'⟩ := hd_base u hu
      have hd := (hdc0'.const_mul a₀).add (hdk0'.const_mul a₁)
      have h_eq : a₀ * (Q u * c0Kernel Q u) + a₁ * (Q u * k0Kernel Q u) = Q u * F u := by
        dsimp [F]; ring
      rw [h_eq] at hd
      exact hd
    let G : ℝ → ℂ := fun w => -(F (φ w))
    let G' : ℝ → ℂ := fun w => F' (φ w)
    have hG_0 : G 0 = -b₁ := by
      dsimp [G, φ]
      rw [sub_zero, hF_1]
    have hG'_0 : G' 0 = b₁' := by
      dsimp [G', φ]
      rw [sub_zero, hF'_1]
    have hG_1 : G 1 = -a₀ := by
      dsimp [G, φ]
      rw [sub_self, hF_0]
    have hG_cont : ContinuousOn G I01 := (hF_cont.comp hφ_cont.continuousOn hφ_maps).neg
    have hG'_cont : ContinuousOn G' I01 := hF'_cont.comp hφ_cont.continuousOn hφ_maps
    have hdG : ∀ w ∈ I01,
        HasDerivWithinAt G (G' w) I01 w ∧ HasDerivWithinAt G' (Q_rev w * G w) I01 w := by
      intro w hw
      have hφw : φ w ∈ I01 := hφ_maps hw
      constructor
      · have hd1 := (HasDerivWithinAt.scomp w (hdF (φ w) hφw) (hdφ w hw) hφ_maps).neg
        change HasDerivWithinAt G (-((-1 : ℝ) • F' (φ w))) I01 w at hd1
        have h_eq : -((-1 : ℝ) • F' (φ w)) = G' w := by
          rw [neg_one_smul, neg_neg]
        rw [h_eq] at hd1
        exact hd1
      · have hd2 := HasDerivWithinAt.scomp w (hdF' (φ w) hφw) (hdφ w hw) hφ_maps
        change HasDerivWithinAt G' ((-1 : ℝ) • (Q (φ w) * F (φ w))) I01 w at hd2
        have h_eq : (-1 : ℝ) • (Q (φ w) * F (φ w)) = Q_rev w * G w := by
          rw [neg_one_smul]
          dsimp [Q_rev, G, φ]
          ring
        rw [h_eq] at hd2
        exact hd2
    obtain ⟨_, _, _, _, _, _, _, _, _, hUniq_rev, _⟩ := hODE Q_rev hQ_rev
    have hG_sol := hUniq_rev G G' hG_cont hG'_cont hdG
    have h_init_rev : -a₀ = (-b₁) * c0Kernel Q_rev 1 + b₁' * k0Kernel Q_rev 1 := by
      have h1 := (hG_sol 1 ⟨zero_le_one, le_rfl⟩).1
      rw [hG_1, hG_0, hG'_0] at h1
      exact h1
    have h_k_sgn : ∀ sgn : ℂ,
        k0Kernel (pertPotential sgn Q_rev (-b₁) b₁') 1 =
          k0Kernel (pertPotential sgn Q a₀ a₁) 1 := by
      intro sgn
      let P_sgn : ℝ → ℂ := pertPotential sgn Q a₀ a₁
      have hP_cont : ContinuousOn P_sgn I01 :=
        (hQ.sub (continuousOn_const.mul hF'_cont)).sub
          (continuousOn_const.mul (hF_cont.pow 2))
      have h_congr : ∀ w ∈ I01, pertPotential sgn Q_rev (-b₁) b₁' w = P_sgn (1 - w) := by
        intro w hw
        obtain ⟨hGw, hG'w⟩ := hG_sol w hw
        rw [hG_0, hG'_0] at hGw hG'w
        dsimp only [pertPotential, P_sgn]
        rw [← hGw, ← hG'w]
        dsimp [Q_rev, G, G', F, F', φ]
        ring
      rw [k0Kernel_one_congr _ (fun w => P_sgn (1 - w)) h_congr, hk0_rev_symm P_sgn hP_cont]
    have hkp_rev : kPlusVal Q_rev (-b₁) b₁' = kPlusVal Q a₀ a₁ := h_k_sgn 1
    have hkm_rev : kMinusVal Q_rev (-b₁) b₁' = kMinusVal Q a₀ a₁ := h_k_sgn (-1)
    have hcanon_rev : canonRoot Q_rev (-b₁) b₁' = canonRoot Q a₀ a₁ := by
      simp only [canonRoot, hkp_rev, hkm_rev]
    exact ⟨hcanon_rev, h_init_rev⟩

  have hConj3 : ∀ Q : ℝ → ℂ,
      ContinuousOn Q (Set.Icc (0 : ℝ) 1) →
      k0Kernel Q 1 ≠ 0 →
      ∀ u v : ℂ, slNumerator (fun w => Q (1 - w)) u v = slNumerator Q (-v) (-u) := by
    intro Q hQ hk0 u v
    set Q_rev : ℝ → ℂ := fun w => Q (1 - w)
    have hk0_rev_eq : k0Kernel Q_rev 1 = k0Kernel Q 1 := hk0_rev_symm Q hQ
    have hk0_rev : k0Kernel Q_rev 1 ≠ 0 := by rwa [hk0_rev_eq]
    let α₀ : ℂ := -v
    let α₁ : ℂ := (-u - (-v) * c0Kernel Q 1) / k0Kernel Q 1
    let β₁ : ℂ := α₀ * c0Kernel Q 1 + α₁ * k0Kernel Q 1
    let β₁' : ℂ := α₀ * c0Deriv Q 1 + α₁ * k0Deriv Q 1
    have hβ₁ : β₁ = -u := by
      dsimp [β₁, α₀, α₁]
      rw [div_mul_cancel₀ _ hk0]
      ring
    have hneg_β₁ : -β₁ = u := by rw [hβ₁, neg_neg]
    obtain ⟨hroot_eq, hval_eq⟩ := hConj2 Q α₀ α₁ hQ
    change canonRoot Q_rev (-β₁) β₁' = canonRoot Q α₀ α₁ at hroot_eq
    change -α₀ = (-β₁) * c0Kernel Q_rev 1 + β₁' * k0Kernel Q_rev 1 at hval_eq
    have hneg_α₀ : -α₀ = v := neg_neg v
    rw [hneg_β₁] at hroot_eq hval_eq
    rw [hneg_α₀] at hval_eq
    have hβ₁'_eq : β₁' = (v - u * c0Kernel Q_rev 1) / k0Kernel Q_rev 1 := by
      rw [eq_div_iff hk0_rev]
      linear_combination -hval_eq
    dsimp only [slNumerator]
    rw [← hβ₁'_eq, hk0_rev_eq, hroot_eq]

  
  have hasDerivWithinAt_primitive_Icc : ∀ F : ℝ → ℂ,
      ContinuousOn F (Set.Icc (0 : ℝ) 1) →
      ContinuousOn (fun u : ℝ => ∫ v in (0 : ℝ)..u, F v) (Set.Icc (0 : ℝ) 1) ∧
      ∀ w ∈ Set.Icc (0 : ℝ) 1,
        HasDerivWithinAt (fun u : ℝ => ∫ v in (0 : ℝ)..u, F v) (F w) (Set.Icc (0 : ℝ) 1) w := by
    intro F hF_cont
    let clamp01 : ℝ → ℝ := fun t => max 0 (min 1 t)
    have hclamp_cont : Continuous clamp01 :=
      continuous_const.max (continuous_const.min continuous_id)
    have hclamp_mem : ∀ t : ℝ, clamp01 t ∈ Set.Icc (0 : ℝ) 1 :=
      fun t => ⟨le_max_left 0 _, max_le zero_le_one (min_le_left 1 t)⟩
    have hclamp_eq : ∀ t ∈ Set.Icc (0 : ℝ) 1, clamp01 t = t := by
      intro t ht
      dsimp [clamp01]
      rw [min_eq_right ht.2, max_eq_right ht.1]
    let F_ext : ℝ → ℂ := F ∘ clamp01
    have hF_ext : Continuous F_ext := hF_cont.comp_continuous hclamp_cont hclamp_mem
    let A : ℝ → ℂ := fun u => ∫ v in (0 : ℝ)..u, F v
    let A_ext : ℝ → ℂ := fun u => ∫ v in (0 : ℝ)..u, F_ext v
    have hd_ext : ∀ w : ℝ, HasDerivAt A_ext (F_ext w) w := fun w =>
      intervalIntegral.integral_hasDerivAt_right
        (hF_ext.intervalIntegrable 0 w)
        (hF_ext.stronglyMeasurableAtFilter MeasureTheory.volume (nhds w))
        hF_ext.continuousAt
    have hA_eq : ∀ u ∈ Set.Icc (0 : ℝ) 1, A u = A_ext u := by
      intro u hu
      dsimp [A, A_ext]
      apply intervalIntegral.integral_congr
      intro v hv
      rw [Set.uIcc_of_le hu.1] at hv
      have hv1 : v ∈ Set.Icc (0 : ℝ) 1 := ⟨hv.1, le_trans hv.2 hu.2⟩
      dsimp [F_ext]
      rw [hclamp_eq v hv1]
    have hA_ext_cont : Continuous A_ext :=
      continuous_iff_continuousAt.mpr (fun w => (hd_ext w).continuousAt)
    refine ⟨hA_ext_cont.continuousOn.congr hA_eq, ?_⟩
    intro w hw
    have hd_w : HasDerivWithinAt A_ext (F w) (Set.Icc (0 : ℝ) 1) w := by
      have hd := (hd_ext w).hasDerivWithinAt (s := Set.Icc (0 : ℝ) 1)
      have hFw : F_ext w = F w := by
        dsimp [F_ext]
        rw [hclamp_eq w hw]
      rw [hFw] at hd
      exact hd
    exact hd_w.congr hA_eq (hA_eq w hw)

  have hConj4 : ∀ (Q : ℝ → ℂ) (a₁ : ℂ),
      ContinuousOn Q (Set.Icc (0 : ℝ) 1) →
      kPlusVal Q 0 a₁ * kMinusVal Q 0 a₁ = (k0Kernel Q 1) ^ 2 := by
    intro Q a₁ hQ
    by_cases ha₁ : a₁ = 0
    · subst ha₁
      have hpot1 : pertPotential 1 Q 0 0 = Q := by
        funext w; simp [pertPotential]
      have hpot2 : pertPotential (-1) Q 0 0 = Q := by
        funext w; simp [pertPotential]
      simp only [kPlusVal, kMinusVal, hpot1, hpot2, sq]
    · set I01 : Set ℝ := Set.Icc (0 : ℝ) 1
      obtain ⟨_, _, hk0_0, hk0'_0, _, _, hk0_cont, hk0'_cont, hd_base, _, _⟩ := hODE Q hQ
      let F : ℝ → ℂ := fun w => a₁ * k0Kernel Q w
      let F' : ℝ → ℂ := fun w => a₁ * k0Deriv Q w
      let A : ℝ → ℂ := fun w => ∫ v in (0 : ℝ)..w, F v
      have hF_0 : F 0 = 0 := by simp [F, hk0_0]
      have hF'_0 : F' 0 = a₁ := by simp [F', hk0'_0]
      have hA_0 : A 0 = 0 := intervalIntegral.integral_same
      have hF_cont : ContinuousOn F I01 := continuousOn_const.mul hk0_cont
      have hF'_cont : ContinuousOn F' I01 := continuousOn_const.mul hk0'_cont
      obtain ⟨hA_cont, hdA⟩ := hasDerivWithinAt_primitive_Icc F hF_cont
      have hdF : ∀ w ∈ I01, HasDerivWithinAt F (F' w) I01 w := by
        intro w hw
        exact (hd_base w hw).2.2.1.const_mul a₁
      have hdF' : ∀ w ∈ I01, HasDerivWithinAt F' (Q w * F w) I01 w := by
        intro w hw
        have hd := (hd_base w hw).2.2.2.const_mul a₁
        have h_eq : a₁ * (Q w * k0Kernel Q w) = Q w * F w := by dsimp [F]; ring
        rw [h_eq] at hd
        exact hd
      let Q_α : ℂ → ℝ → ℂ := fun α w => Q w + 3 * α * F' w + α ^ 2 * (F w) ^ 2
      let g_α : ℂ → ℝ → ℂ := fun α w => F w * Complex.exp (α * A w)
      let g_α' : ℂ → ℝ → ℂ := fun α w => (F' w + α * (F w) ^ 2) * Complex.exp (α * A w)
      have h_gauge : ∀ α : ℂ, F 1 * Complex.exp (α * A 1) = a₁ * k0Kernel (Q_α α) 1 := by
        intro α
        have hQα_cont : ContinuousOn (Q_α α) I01 :=
          (hQ.add (continuousOn_const.mul hF'_cont)).add
            (continuousOn_const.mul (hF_cont.pow 2))
        have hexp_cont : ContinuousOn (fun w => Complex.exp (α * A w)) I01 :=
          Complex.continuous_exp.comp_continuousOn (continuousOn_const.mul hA_cont)
        have hg_cont : ContinuousOn (g_α α) I01 := hF_cont.mul hexp_cont
        have hg'_cont : ContinuousOn (g_α' α) I01 :=
          (hF'_cont.add (continuousOn_const.mul (hF_cont.pow 2))).mul hexp_cont
        have hg_0 : g_α α 0 = 0 := by simp [g_α, hF_0]
        have hg'_0 : g_α' α 0 = a₁ := by simp [g_α', hF_0, hF'_0, hA_0]
        have hdg : ∀ w ∈ I01,
            HasDerivWithinAt (g_α α) (g_α' α w) I01 w ∧
            HasDerivWithinAt (g_α' α) (Q_α α w * g_α α w) I01 w := by
          intro w hw
          have hd_exp : HasDerivWithinAt (fun u => Complex.exp (α * A u))
              (Complex.exp (α * A w) * (α * F w)) I01 w :=
            ((hdA w hw).const_mul α).cexp
          constructor
          · have hd1 := (hdF w hw).mul hd_exp
            change HasDerivWithinAt (g_α α)
              (F' w * Complex.exp (α * A w) + F w * (Complex.exp (α * A w) * (α * F w)))
              I01 w at hd1
            have h_eq :
                F' w * Complex.exp (α * A w) + F w * (Complex.exp (α * A w) * (α * F w)) =
                  g_α' α w := by
              dsimp [g_α']; ring
            rw [h_eq] at hd1
            exact hd1
          · have hdF2 : HasDerivWithinAt (fun u => (F u) ^ 2)
                (F' w * F w + F w * F' w) I01 w := by
              simp only [sq]
              exact (hdF w hw).mul (hdF w hw)
            have hd2 := ((hdF' w hw).add (hdF2.const_mul α)).mul hd_exp
            change HasDerivWithinAt (g_α' α)
              ((Q w * F w + α * (F' w * F w + F w * F' w)) * Complex.exp (α * A w) +
                (F' w + α * (F w) ^ 2) * (Complex.exp (α * A w) * (α * F w)))
              I01 w at hd2
            have h_eq :
                (Q w * F w + α * (F' w * F w + F w * F' w)) * Complex.exp (α * A w) +
                  (F' w + α * (F w) ^ 2) * (Complex.exp (α * A w) * (α * F w)) =
                Q_α α w * g_α α w := by
              dsimp [Q_α, g_α]; ring
            rw [h_eq] at hd2
            exact hd2
        obtain ⟨_, _, _, _, _, _, _, _, _, hUniq_α, _⟩ := hODE (Q_α α) hQα_cont
        have h1 := (hUniq_α (g_α α) (g_α' α) hg_cont hg'_cont hdg 1 ⟨zero_le_one, le_rfl⟩).1
        rw [hg_0, hg'_0, zero_mul, zero_add] at h1
        exact h1
      have hQ_plus : Q_α (-Complex.I / 2) = pertPotential 1 Q 0 a₁ := by
        funext w
        dsimp [Q_α, pertPotential, F, F']
        linear_combination ((1 / 4 : ℂ) * (a₁ * k0Kernel Q w) ^ 2) * Complex.I_sq
      have hQ_minus : Q_α (Complex.I / 2) = pertPotential (-1) Q 0 a₁ := by
        funext w
        dsimp [Q_α, pertPotential, F, F']
        linear_combination ((1 / 4 : ℂ) * (a₁ * k0Kernel Q w) ^ 2) * Complex.I_sq
      have hp := h_gauge (-Complex.I / 2)
      rw [hQ_plus] at hp
      have hm := h_gauge (Complex.I / 2)
      rw [hQ_minus] at hm
      change F 1 * Complex.exp ((-Complex.I / 2) * A 1) = a₁ * kPlusVal Q 0 a₁ at hp
      change F 1 * Complex.exp ((Complex.I / 2) * A 1) = a₁ * kMinusVal Q 0 a₁ at hm
      have h_mul : a₁ ^ 2 * (kPlusVal Q 0 a₁ * kMinusVal Q 0 a₁) =
          a₁ ^ 2 * (k0Kernel Q 1) ^ 2 := by
        calc a₁ ^ 2 * (kPlusVal Q 0 a₁ * kMinusVal Q 0 a₁)
            = (a₁ * kPlusVal Q 0 a₁) * (a₁ * kMinusVal Q 0 a₁) := by ring
          _ = (F 1 * Complex.exp ((-Complex.I / 2) * A 1)) *
                (F 1 * Complex.exp ((Complex.I / 2) * A 1)) := by rw [← hp, ← hm]
          _ = (F 1) ^ 2 *
                (Complex.exp ((-Complex.I / 2) * A 1) * Complex.exp ((Complex.I / 2) * A 1)) := by
              ring
          _ = (F 1) ^ 2 * Complex.exp ((-Complex.I / 2) * A 1 + (Complex.I / 2) * A 1) := by
              rw [← Complex.exp_add]
          _ = (F 1) ^ 2 * Complex.exp 0 := by
              have h_zero : (-Complex.I / 2) * A 1 + (Complex.I / 2) * A 1 = 0 := by ring
              rw [h_zero]
          _ = a₁ ^ 2 * (k0Kernel Q 1) ^ 2 := by
              rw [Complex.exp_zero, mul_one]
              dsimp [F]
              ring
      exact mul_left_cancel₀ (pow_ne_zero 2 ha₁) h_mul

  
  have h_sin_rem : ∀ z : ℂ, ‖z‖ ≤ 1 →
      ‖Complex.sin z - (z - z ^ 3 / 6)‖ ≤ ‖z‖ ^ 4 := by
    intro z hz
    let P₄ : ℂ → ℂ := fun x => ∑ m ∈ Finset.range 4, x ^ m / (m.factorial : ℂ)
    have hP₄_eq : ∀ x : ℂ, P₄ x = 1 + x + x ^ 2 / 2 + x ^ 3 / 6 := by
      intro x
      dsimp [P₄]
      rw [Finset.sum_range_succ, Finset.sum_range_succ, Finset.sum_range_succ,
        Finset.sum_range_succ, Finset.sum_range_zero]
      norm_num [Nat.factorial]
    have hP₄_comb : (P₄ (-z * Complex.I) - P₄ (z * Complex.I)) * Complex.I =
        2 * (z - z ^ 3 / 6) := by
      rw [hP₄_eq (-z * Complex.I), hP₄_eq (z * Complex.I)]
      linear_combination (-2 * z - z ^ 3 / 3 * (Complex.I ^ 2 - 1)) * Complex.I_sq
    have h_diff_id : 2 * (Complex.sin z - (z - z ^ 3 / 6)) =
        ((Complex.exp (-z * Complex.I) - P₄ (-z * Complex.I)) -
          (Complex.exp (z * Complex.I) - P₄ (z * Complex.I))) * Complex.I := by
      have h2s := Complex.two_sin z
      linear_combination h2s + hP₄_comb
    have h_norm1 : ‖-z * Complex.I‖ = ‖z‖ := by
      rw [norm_mul, norm_neg, Complex.norm_I, mul_one]
    have h_norm2 : ‖z * Complex.I‖ = ‖z‖ := by
      rw [norm_mul, Complex.norm_I, mul_one]
    have hb1 : ‖Complex.exp (-z * Complex.I) - P₄ (-z * Complex.I)‖ ≤
        ‖z‖ ^ 4 * (5 / 96 : ℝ) := by
      have hb := Complex.exp_bound (x := -z * Complex.I) (by rwa [h_norm1]) (n := 4) (by norm_num)
      rw [h_norm1] at hb
      refine le_trans hb ?_
      norm_num [Nat.factorial]
    have hb2 : ‖Complex.exp (z * Complex.I) - P₄ (z * Complex.I)‖ ≤
        ‖z‖ ^ 4 * (5 / 96 : ℝ) := by
      have hb := Complex.exp_bound (x := z * Complex.I) (by rwa [h_norm2]) (n := 4) (by norm_num)
      rw [h_norm2] at hb
      refine le_trans hb ?_
      norm_num [Nat.factorial]
    have h2_norm : 2 * ‖Complex.sin z - (z - z ^ 3 / 6)‖ =
        ‖2 * (Complex.sin z - (z - z ^ 3 / 6))‖ := by
      rw [norm_mul, Complex.norm_ofNat]
    have h_sum_le : 2 * ‖Complex.sin z - (z - z ^ 3 / 6)‖ ≤
        ‖z‖ ^ 4 * (5 / 96 : ℝ) + ‖z‖ ^ 4 * (5 / 96 : ℝ) := by
      rw [h2_norm, h_diff_id, norm_mul, Complex.norm_I, mul_one]
      exact le_trans (norm_sub_le _ _) (add_le_add hb1 hb2)
    have hz4_nonneg : 0 ≤ ‖z‖ ^ 4 := by positivity
    linarith

  have h_sinc_ne_zero : ∀ z : ℂ, z ≠ 0 → ‖z‖ < 1 / 2 → Complex.sin z / z ≠ 0 := by
    intro z hz_ne hz_lt
    have hz_pos : 0 < ‖z‖ := norm_pos_iff.mpr hz_ne
    have hz_le_one : ‖z‖ ≤ 1 := by linarith
    have hrem := h_sin_rem z hz_le_one
    have h_alg : Complex.sin z / z - 1 =
        (Complex.sin z - (z - z ^ 3 / 6)) / z - z ^ 2 / 6 := by
      field_simp [hz_ne]
      ring
    have h_div_le : ‖(Complex.sin z - (z - z ^ 3 / 6)) / z‖ ≤ ‖z‖ ^ 3 := by
      rw [norm_div]
      calc ‖Complex.sin z - (z - z ^ 3 / 6)‖ / ‖z‖
          ≤ ‖z‖ ^ 4 / ‖z‖ := div_le_div_of_nonneg_right hrem hz_pos.le
        _ = ‖z‖ ^ 3 := by
            field_simp [hz_pos.ne']
    have h_z2_norm : ‖z ^ 2 / (6 : ℂ)‖ = ‖z‖ ^ 2 / 6 := by
      rw [norm_div, norm_pow, Complex.norm_ofNat]
    have h_lt_one : ‖Complex.sin z / z - 1‖ < 1 := by
      rw [h_alg]
      calc ‖(Complex.sin z - (z - z ^ 3 / 6)) / z - z ^ 2 / 6‖
          ≤ ‖(Complex.sin z - (z - z ^ 3 / 6)) / z‖ + ‖z ^ 2 / (6 : ℂ)‖ := norm_sub_le _ _
        _ ≤ ‖z‖ ^ 3 + ‖z‖ ^ 2 / 6 := by rw [h_z2_norm]; linarith
        _ < 1 := by nlinarith [sq_nonneg ‖z‖]
    intro h_zero
    rw [h_zero, zero_sub, norm_neg, norm_one] at h_lt_one
    exact lt_irrefl (1 : ℝ) h_lt_one

  have h_quot_bound : ∀ z : ℂ, z ≠ 0 → ‖z‖ ≤ 1 →
      ‖(z - Complex.sin z) / (4 * z ^ 3) - (1 / 24 : ℂ)‖ ≤ (1 / 4 : ℝ) * ‖z‖ := by
    intro z hz_ne hz_le
    have hz_pos : 0 < ‖z‖ := norm_pos_iff.mpr hz_ne
    have hrem := h_sin_rem z hz_le
    have h_alg : (z - Complex.sin z) / (4 * z ^ 3) - (1 / 24 : ℂ) =
        -(Complex.sin z - (z - z ^ 3 / 6)) / (4 * z ^ 3) := by
      field_simp [hz_ne]
      ring
    have h_den_norm : ‖(4 : ℂ) * z ^ 3‖ = 4 * ‖z‖ ^ 3 := by
      rw [norm_mul, Complex.norm_ofNat, norm_pow]
    have h_den_pos : 0 < 4 * ‖z‖ ^ 3 := by positivity
    rw [h_alg, norm_div, norm_neg, h_den_norm]
    calc ‖Complex.sin z - (z - z ^ 3 / 6)‖ / (4 * ‖z‖ ^ 3)
        ≤ ‖z‖ ^ 4 / (4 * ‖z‖ ^ 3) := div_le_div_of_nonneg_right hrem h_den_pos.le
      _ = (1 / 4 : ℝ) * ‖z‖ := by
          field_simp [hz_pos.ne']

  have hConj6 : ∀ lam : ℂ, 0 < ‖lam‖ → ‖lam‖ < 1 →
      slDivided (fun _ => 0) lam 0 =
        (lam / 2 - Complex.sin (lam / 2)) / (4 * (lam / 2) ^ 3) := by
    intro lam hlam_pos hlam_lt
    set Q₀ : ℝ → ℂ := fun _ => 0
    set z : ℂ := lam / 2
    have hlam_ne : lam ≠ 0 := norm_pos_iff.mp hlam_pos
    have hz_ne : z ≠ 0 := div_ne_zero hlam_ne two_ne_zero
    have hlam_eq : lam = 2 * z := by dsimp [z]; ring
    have hz_lt_half : ‖z‖ < 1 / 2 := by
      dsimp [z]
      rw [norm_div, Complex.norm_ofNat]
      linarith
    have hc0_Q₀_1 : c0Kernel Q₀ 1 = 1 := hc0_zero 1 ⟨zero_le_one, le_rfl⟩
    have hk0_Q₀_1 : k0Kernel Q₀ 1 = 1 := hk0_zero
    have hc0'_Q₀ : ∀ w : ℝ, c0Deriv Q₀ w = 0 := by
      intro w
      simp [c0Deriv, Q₀]
    have hb₁_eq : lam * c0Kernel Q₀ 1 + 0 * k0Kernel Q₀ 1 = lam := by
      rw [hc0_Q₀_1]; ring
    have hDiv_branch : slDivided Q₀ lam 0 = (1 - canonRoot Q₀ lam 0) / (lam * lam) := by
      dsimp only [slDivided]
      rw [hb₁_eq, hk0_Q₀_1]
      split_ifs with h_cond
      · rfl
      · exact False.elim (h_cond ⟨hlam_ne, hlam_ne⟩)
    let P_z : ℝ → ℂ := fun _ => -z ^ 2
    have hpert_eq : ∀ (sgn : ℂ), ∀ w ∈ Set.Icc (0 : ℝ) 1,
        pertPotential sgn Q₀ lam 0 w = P_z w := by
      intro sgn w hw
      dsimp only [pertPotential, P_z, Q₀]
      rw [hc0_zero w hw, hc0'_Q₀ w, hlam_eq]
      ring
    have hkp_z : kPlusVal Q₀ lam 0 = k0Kernel P_z 1 :=
      k0Kernel_one_congr _ P_z (hpert_eq 1)
    have hkm_z : kMinusVal Q₀ lam 0 = k0Kernel P_z 1 :=
      k0Kernel_one_congr _ P_z (hpert_eq (-1))
    let y : ℝ → ℂ := fun w => Complex.sin ((w : ℂ) * z) / z
    let y' : ℝ → ℂ := fun w => Complex.cos ((w : ℂ) * z)
    have hy_cont : Continuous y := by
      dsimp [y]; fun_prop
    have hy'_cont : Continuous y' := by
      dsimp [y']; fun_prop
    have hy_0 : y 0 = 0 := by simp [y]
    have hy'_0 : y' 0 = 1 := by simp [y']
    have hdy : ∀ w ∈ Set.Icc (0 : ℝ) 1,
        HasDerivWithinAt y (y' w) (Set.Icc (0 : ℝ) 1) w ∧
        HasDerivWithinAt y' (P_z w * y w) (Set.Icc (0 : ℝ) 1) w := by
      intro w _
      constructor
      · have hd1 :=
          ((((hasDerivAt_id' (w : ℂ)).mul_const z).csin.div_const z).comp_ofReal).hasDerivWithinAt
            (s := Set.Icc (0 : ℝ) 1)
        change HasDerivWithinAt y ((Complex.cos ((w : ℂ) * z) * ((1 : ℂ) * z)) / z)
          (Set.Icc (0 : ℝ) 1) w at hd1
        have h_eq : (Complex.cos ((w : ℂ) * z) * ((1 : ℂ) * z)) / z = y' w := by
          dsimp [y']
          field_simp [hz_ne]
        rw [h_eq] at hd1
        exact hd1
      · have hd2 :=
          ((((hasDerivAt_id' (w : ℂ)).mul_const z).ccos).comp_ofReal).hasDerivWithinAt
            (s := Set.Icc (0 : ℝ) 1)
        change HasDerivWithinAt y' (-Complex.sin ((w : ℂ) * z) * ((1 : ℂ) * z))
          (Set.Icc (0 : ℝ) 1) w at hd2
        have h_eq : -Complex.sin ((w : ℂ) * z) * ((1 : ℂ) * z) = P_z w * y w := by
          dsimp [P_z, y]
          field_simp [hz_ne]
        rw [h_eq] at hd2
        exact hd2
    obtain ⟨_, _, _, _, _, _, _, _, _, hUniq_Pz, _⟩ := hODE P_z continuousOn_const
    have hk0_Pz : k0Kernel P_z 1 = Complex.sin z / z := by
      have h1 := (hUniq_Pz y y' hy_cont.continuousOn hy'_cont.continuousOn hdy
        1 ⟨zero_le_one, le_rfl⟩).1
      rw [hy_0, hy'_0, zero_mul, zero_add, one_mul] at h1
      dsimp [y] at h1
      rw [one_mul] at h1
      exact h1.symm
    set u : ℂ := Complex.sin z / z
    have hu_ne : u ≠ 0 := h_sinc_ne_zero z hz_ne hz_lt_half
    have hcanon_Q₀ : canonRoot Q₀ lam 0 = u := by
      dsimp only [canonRoot]
      rw [hkp_z, hkm_z, hk0_Pz]
      have h_sq : (u + u) ^ 2 = 4 * u * u := by ring
      have h4u_ne : 4 * u * u ≠ 0 :=
        mul_ne_zero (mul_ne_zero (by norm_num) hu_ne) hu_ne
      rw [h_sq, div_self h4u_ne, Complex.log_one, mul_zero, Complex.exp_zero, mul_one]
      ring
    rw [hDiv_branch, hcanon_Q₀]
    dsimp [u]
    rw [hlam_eq]
    field_simp [hz_ne]
    ring

  have hConj7 : Filter.Tendsto
      (fun lam : ℂ => (lam / 2 - Complex.sin (lam / 2)) / (4 * (lam / 2) ^ 3))
      (nhdsWithin 0 {(0 : ℂ)}ᶜ) (nhds (1 / 24 : ℂ)) := by
    rw [Metric.tendsto_nhdsWithin_nhds]
    intro ε hε
    refine ⟨min 2 (4 * ε), lt_min zero_lt_two (by positivity), ?_⟩
    intro lam hlam_mem h_dist
    have hlam_ne : lam ≠ 0 := Set.mem_compl_singleton_iff.mp hlam_mem
    rw [dist_zero_right] at h_dist
    have hlam_lt2 : ‖lam‖ < 2 := lt_of_lt_of_le h_dist (min_le_left _ _)
    have hlam_lt4ε : ‖lam‖ < 4 * ε := lt_of_lt_of_le h_dist (min_le_right _ _)
    set z : ℂ := lam / 2
    have hz_ne : z ≠ 0 := div_ne_zero hlam_ne two_ne_zero
    have hz_norm : ‖z‖ = ‖lam‖ / 2 := by
      dsimp [z]
      rw [norm_div, Complex.norm_ofNat]
    have hz_le1 : ‖z‖ ≤ 1 := by linarith
    have hz_lt2ε : ‖z‖ < 2 * ε := by linarith
    rw [dist_eq_norm]
    calc ‖(z - Complex.sin z) / (4 * z ^ 3) - (1 / 24 : ℂ)‖
        ≤ (1 / 4 : ℝ) * ‖z‖ := h_quot_bound z hz_ne hz_le1
      _ < ε := by linarith

  exact ⟨hConj1, hConj2, hConj3, hConj4, hk0_zero, hConj6, hConj7⟩

theorem sl_numerator_slit_envelope_and_lipschitz (hODE : VolterraODEProp)
    (hLip : VolterraLipHoloProp)
    (hRevK : ∀ Q : ℝ → ℂ, ContinuousOn Q (Set.Icc (0 : ℝ) 1) →
      k0Kernel (fun w => Q (1 - w)) 1 = k0Kernel Q 1)
    (hWronskProd : ∀ (Q : ℝ → ℂ) (a₁ : ℂ), ContinuousOn Q (Set.Icc (0 : ℝ) 1) →
      kPlusVal Q 0 a₁ * kMinusVal Q 0 a₁ = (k0Kernel Q 1) ^ 2)
    (hRevNum : ∀ Q : ℝ → ℂ, ContinuousOn Q (Set.Icc (0 : ℝ) 1) → k0Kernel Q 1 ≠ 0 →
      ∀ u v : ℂ, slNumerator (fun w => Q (1 - w)) u v = slNumerator Q (-v) (-u))
    (Q₀ : ℝ → ℂ)
    (hQ₀ : ContinuousOn Q₀ (Set.Icc (0 : ℝ) 1))
    (hk0_Q₀ : k0Kernel Q₀ 1 ≠ 0) :
    ∃ δ_Q r_b M_num : ℝ,
      0 < δ_Q ∧ 0 < r_b ∧ 0 < M_num ∧
      (∀ Q : ℝ → ℂ,
        ContinuousOn Q (Set.Icc (0 : ℝ) 1) →
        (∀ w ∈ Set.Icc (0 : ℝ) 1, ‖Q w - Q₀ w‖ < δ_Q) →
        k0Kernel Q 1 ≠ 0 ∧
        DifferentiableOn ℂ (fun z : ℂ × ℂ => slNumerator Q z.1 z.2)
          (Metric.ball (0 : ℂ) (2 * r_b) ×ˢ Metric.ball (0 : ℂ) (2 * r_b)) ∧
        ∀ w₀ w₁ : ℂ, ‖w₀‖ < 2 * r_b → ‖w₁‖ < 2 * r_b →
          ‖slNumerator Q w₀ w₁‖ ≤ M_num ∧
          slNumerator Q 0 w₁ = 0 ∧
          slNumerator Q w₀ 0 = 0) ∧
      (∀ (Q₁ Q₂ : ℝ → ℂ) (Δ : ℝ),
        0 ≤ Δ →
        ContinuousOn Q₁ (Set.Icc (0 : ℝ) 1) →
        ContinuousOn Q₂ (Set.Icc (0 : ℝ) 1) →
        (∀ w ∈ Set.Icc (0 : ℝ) 1,
          ‖Q₁ w - Q₀ w‖ < δ_Q ∧ ‖Q₂ w - Q₀ w‖ < δ_Q ∧ ‖Q₁ w - Q₂ w‖ ≤ Δ) →
        ∀ w₀ w₁ : ℂ, ‖w₀‖ ≤ r_b → ‖w₁‖ ≤ r_b →
          ‖slNumerator Q₁ w₀ w₁ - slNumerator Q₂ w₀ w₁‖ ≤ M_num * Δ) ∧
      (∀ (U : Set (ℂ × ℂ)) (Q : ℂ × ℂ → ℝ → ℂ),
        IsOpen U →
        ContinuousOn (fun q : (ℂ × ℂ) × ℝ => Q q.1 q.2) (U ×ˢ Set.Icc (0 : ℝ) 1) →
        (∀ w ∈ Set.Icc (0 : ℝ) 1, DifferentiableOn ℂ (fun p => Q p w) U) →
        (∀ p ∈ U, ∀ w ∈ Set.Icc (0 : ℝ) 1, ‖Q p w - Q₀ w‖ < δ_Q) →
        ∀ z₀ z₁ : ℂ, ‖z₀‖ ≤ r_b → ‖z₁‖ ≤ r_b →
          DifferentiableOn ℂ (fun p => slNumerator (Q p) z₀ z₁) U) :=
by
  let I : Set ℝ := Set.Icc (0 : ℝ) 1
  have h0_mem : (0 : ℝ) ∈ I := ⟨le_rfl, zero_le_one⟩
  have h1_mem : (1 : ℝ) ∈ I := ⟨zero_le_one, le_rfl⟩

  
  obtain ⟨w_max, _, hw_max⟩ :=
    isCompact_Icc.exists_isMaxOn ⟨0, h0_mem⟩ (continuous_norm.comp_continuousOn hQ₀)
  let M₀ : ℝ := max 1 ‖Q₀ w_max‖
  have hM₀_ge_one : 1 ≤ M₀ := le_max_left _ _
  have hQ₀_bdd : ∀ w ∈ I, ‖Q₀ w‖ ≤ M₀ :=
    fun w hw => le_trans (hw_max hw) (le_max_right _ _)
  let κ₀ : ℝ := ‖k0Kernel Q₀ 1‖
  have hκ₀_pos : 0 < κ₀ := norm_pos_iff.mpr hk0_Q₀
  let E₀ : ℝ := Real.exp (M₀ + 1)
  have hE₀_pos : 0 < E₀ := Real.exp_pos _
  have hE₀_ge_one : 1 ≤ E₀ := Real.one_le_exp (by linarith)
  let B₀ : ℝ := (2 + M₀) * E₀
  have hB₀_ge_three : 3 ≤ B₀ := by dsimp [B₀]; nlinarith
  have hB₀_pos : 0 < B₀ := by linarith
  let δ_Q : ℝ := min 1 (κ₀ / (4 * E₀))
  have hδ_pos : 0 < δ_Q := lt_min zero_lt_one (by positivity)
  have hδ_le_one : δ_Q ≤ 1 := min_le_left _ _
  have hE₀_δ_le : E₀ * δ_Q ≤ κ₀ / 4 := by
    have h1 : δ_Q ≤ κ₀ / (4 * E₀) := min_le_right _ _
    have h2 := mul_le_mul_of_nonneg_left h1 hE₀_pos.le
    have h3 : E₀ * (κ₀ / (4 * E₀)) = κ₀ / 4 := by
      field_simp [hE₀_pos.ne']
    rwa [h3] at h2
  let K_a : ℝ := 3 * (1 + E₀) / κ₀
  have hKa_pos : 0 < K_a := by positivity
  let K_F : ℝ := (2 + K_a) * B₀
  have hKF_pos : 0 < K_F := by positivity
  have hKF_ge_six : 6 ≤ K_F := by dsimp [K_F]; nlinarith
  have hKa_le_KF : K_a ≤ K_F := by dsimp [K_F]; nlinarith
  let E_pert : ℝ := Real.exp (M₀ + 2)
  have hE_pert_pos : 0 < E_pert := Real.exp_pos _
  let r_b : ℝ := min (1 / (2 * K_F)) (κ₀ / (32 * E_pert * K_F))
  have hrb_pos : 0 < r_b := lt_min (by positivity) (by positivity)
  have hKF_rb_le_half : K_F * r_b ≤ 1 / 2 := by
    have h1 : r_b ≤ 1 / (2 * K_F) := min_le_left _ _
    have h2 := mul_le_mul_of_nonneg_left h1 hKF_pos.le
    have h3 : K_F * (1 / (2 * K_F)) = 1 / 2 := by
      field_simp [hKF_pos.ne']
    rwa [h3] at h2
  have hrb_le_one : r_b ≤ 1 := by nlinarith
  have hKa_rb_le_half : K_a * r_b ≤ 1 / 2 :=
    le_trans (mul_le_mul_of_nonneg_right hKa_le_KF hrb_pos.le) hKF_rb_le_half
  have hE_pert_rb_le : E_pert * (2 * K_F * r_b) ≤ κ₀ / 16 := by
    have h1 : r_b ≤ κ₀ / (32 * E_pert * K_F) := min_le_right _ _
    have h2 := mul_le_mul_of_nonneg_left h1 (by positivity : 0 ≤ 2 * E_pert * K_F)
    have h3 : (2 * E_pert * K_F) * (κ₀ / (32 * E_pert * K_F)) = κ₀ / 16 := by
      field_simp [hE_pert_pos.ne', hKF_pos.ne']
      ring
    calc E_pert * (2 * K_F * r_b)
        = (2 * E_pert * K_F) * r_b := by ring
      _ ≤ (2 * E_pert * K_F) * (κ₀ / (32 * E_pert * K_F)) := h2
      _ = κ₀ / 16 := h3
  let C_a : ℝ := 3 * B₀ / κ₀
  have hCa_pos : 0 < C_a := by positivity
  let C_F : ℝ := (2 + C_a) * B₀
  have hCF_pos : 0 < C_F := by positivity
  let C_k : ℝ := E_pert * (1 + 2 * C_F)
  have hCk_pos : 0 < C_k := by positivity
  let L_num : ℝ := B₀ + 10 * C_k
  have hL_num_pos : 0 < L_num := by positivity
  let M_num : ℝ := max 1 (max κ₀ L_num)
  have hM_num_pos : 0 < M_num := lt_of_lt_of_le zero_lt_one (le_max_left _ _)
  have hκ₀_le_M : κ₀ ≤ M_num := le_trans (le_max_left _ _) (le_max_right _ _)
  have hL_le_M : L_num ≤ M_num := le_trans (le_max_right _ _) (le_max_right _ _)

  have hnorm_3I2 : ‖(3 * Complex.I / 2 : ℂ)‖ = 3 / 2 := by
    rw [norm_div, norm_mul, Complex.norm_I]
    norm_num
  have hnorm_14 : ‖(1 / 4 : ℂ)‖ = 1 / 4 := by
    rw [norm_div]
    norm_num

  
  let cSqrt : ℂ → ℂ := fun ζ => Complex.exp ((1 / 2 : ℂ) * Complex.log ζ)
  have hcSqrt_one : cSqrt 1 = 1 := by
    dsimp [cSqrt]
    rw [Complex.log_one, mul_zero, Complex.exp_zero]
  have hcSqrt_half : ∀ ζ : ℂ, 1 / 4 < ζ.re → cSqrt ζ ^ 2 = ζ ∧ 1 / 2 < (cSqrt ζ).re := by
    intro ζ hζ
    have hζ_ne : ζ ≠ 0 := by
      intro h0
      rw [h0, Complex.zero_re] at hζ
      linarith
    have hsq : cSqrt ζ ^ 2 = ζ := by
      dsimp [cSqrt]
      rw [sq, ← Complex.exp_add]
      have h_add : (1 / 2 : ℂ) * Complex.log ζ + (1 / 2 : ℂ) * Complex.log ζ = Complex.log ζ := by
        ring
      rw [h_add, Complex.exp_log hζ_ne]
    refine ⟨hsq, ?_⟩
    have him_eq : ((1 / 2 : ℂ) * Complex.log ζ).im = (Complex.log ζ).im / 2 := by
      simp [div_eq_mul_inv, mul_comm]
    have him_lo : -(Real.pi / 2) ≤ ((1 / 2 : ℂ) * Complex.log ζ).im := by
      rw [him_eq]
      linarith [Complex.neg_pi_lt_log_im ζ]
    have him_hi : ((1 / 2 : ℂ) * Complex.log ζ).im ≤ Real.pi / 2 := by
      rw [him_eq]
      linarith [Complex.log_im_le_pi ζ]
    have hre_nonneg : 0 ≤ (cSqrt ζ).re := by
      dsimp [cSqrt]
      rw [Complex.exp_re]
      exact mul_nonneg (Real.exp_pos _).le (Real.cos_nonneg_of_mem_Icc ⟨him_lo, him_hi⟩)
    have hre_sq : ζ.re = (cSqrt ζ).re ^ 2 - (cSqrt ζ).im ^ 2 := by
      calc ζ.re = (cSqrt ζ ^ 2).re := by rw [hsq]
        _ = (cSqrt ζ * cSqrt ζ).re := by rw [sq]
        _ = (cSqrt ζ).re ^ 2 - (cSqrt ζ).im ^ 2 := by
            rw [Complex.mul_re]
            ring
    nlinarith [sq_nonneg (cSqrt ζ).im]
  have hcSqrt_lip : ∀ ζ₁ ζ₂ : ℂ, 1 / 4 < ζ₁.re → 1 / 4 < ζ₂.re →
      ‖cSqrt ζ₁ - cSqrt ζ₂‖ ≤ ‖ζ₁ - ζ₂‖ := by
    intro ζ₁ ζ₂ hζ₁ hζ₂
    obtain ⟨hsq₁, hre₁⟩ := hcSqrt_half ζ₁ hζ₁
    obtain ⟨hsq₂, hre₂⟩ := hcSqrt_half ζ₂ hζ₂
    have hsum_gt : 1 < ‖cSqrt ζ₁ + cSqrt ζ₂‖ := by
      have h1 : 1 < (cSqrt ζ₁ + cSqrt ζ₂).re := by
        rw [Complex.add_re]
        linarith
      exact lt_of_lt_of_le h1 (Complex.re_le_norm _)
    have hprod : (cSqrt ζ₁ - cSqrt ζ₂) * (cSqrt ζ₁ + cSqrt ζ₂) = ζ₁ - ζ₂ := by
      calc (cSqrt ζ₁ - cSqrt ζ₂) * (cSqrt ζ₁ + cSqrt ζ₂)
          = cSqrt ζ₁ ^ 2 - cSqrt ζ₂ ^ 2 := by ring
        _ = ζ₁ - ζ₂ := by rw [hsq₁, hsq₂]
    calc ‖cSqrt ζ₁ - cSqrt ζ₂‖
        = ‖cSqrt ζ₁ - cSqrt ζ₂‖ * 1 := (mul_one _).symm
      _ ≤ ‖cSqrt ζ₁ - cSqrt ζ₂‖ * ‖cSqrt ζ₁ + cSqrt ζ₂‖ :=
          mul_le_mul_of_nonneg_left hsum_gt.le (norm_nonneg _)
      _ = ‖(cSqrt ζ₁ - cSqrt ζ₂) * (cSqrt ζ₁ + cSqrt ζ₂)‖ := (norm_mul _ _).symm
      _ = ‖ζ₁ - ζ₂‖ := by rw [hprod]
  have hcSqrt_sub_one : ∀ ζ : ℂ, 1 / 4 < ζ.re → ‖cSqrt ζ - 1‖ ≤ ‖ζ - 1‖ := by
    intro ζ hζ
    simpa [hcSqrt_one] using hcSqrt_lip ζ 1 hζ (by norm_num)

  
  let IsBasePot : (ℝ → ℂ) → Prop := fun Q =>
    ContinuousOn Q I ∧
    (∀ w ∈ I, ‖Q w‖ ≤ M₀ + 1) ∧
    (3 / 4 : ℝ) * κ₀ ≤ ‖k0Kernel Q 1‖ ∧
    ‖k0Kernel Q 1‖ ≤ (5 / 4 : ℝ) * κ₀

  have hBallToBase : ∀ Q : ℝ → ℂ, ContinuousOn Q I →
      (∀ w ∈ I, ‖Q w - Q₀ w‖ < δ_Q) → IsBasePot Q := by
    intro Q hQ hQ_close
    have hQ_bdd : ∀ w ∈ I, ‖Q w‖ ≤ M₀ + 1 := by
      intro w hw
      calc ‖Q w‖ = ‖(Q w - Q₀ w) + Q₀ w‖ := by ring_nf
        _ ≤ ‖Q w - Q₀ w‖ + ‖Q₀ w‖ := norm_add_le _ _
        _ ≤ δ_Q + M₀ := add_le_add (hQ_close w hw).le (hQ₀_bdd w hw)
        _ ≤ M₀ + 1 := by linarith
    have hk0_diff : ‖k0Kernel Q 1 - k0Kernel Q₀ 1‖ ≤ κ₀ / 4 := by
      have h1 := (hLip.1 (M₀ + 1) δ_Q Q Q₀ (by linarith) hδ_pos.le hQ hQ₀
        (fun w hw => ⟨hQ_bdd w hw, le_trans (hQ₀_bdd w hw) (by linarith), (hQ_close w hw).le⟩)
        1 h1_mem).2.2.2.2.2.1
      exact le_trans h1 hE₀_δ_le
    have hk0_lo : (3 / 4 : ℝ) * κ₀ ≤ ‖k0Kernel Q 1‖ := by
      have h_tri : κ₀ ≤ ‖k0Kernel Q 1‖ + ‖k0Kernel Q 1 - k0Kernel Q₀ 1‖ := by
        calc κ₀ = ‖k0Kernel Q 1 - (k0Kernel Q 1 - k0Kernel Q₀ 1)‖ := by dsimp [κ₀]; ring_nf
          _ ≤ ‖k0Kernel Q 1‖ + ‖k0Kernel Q 1 - k0Kernel Q₀ 1‖ := norm_sub_le _ _
      linarith
    have hk0_hi : ‖k0Kernel Q 1‖ ≤ (5 / 4 : ℝ) * κ₀ := by
      have h_tri : ‖k0Kernel Q 1‖ ≤ ‖k0Kernel Q 1 - k0Kernel Q₀ 1‖ + κ₀ := by
        calc ‖k0Kernel Q 1‖ = ‖(k0Kernel Q 1 - k0Kernel Q₀ 1) + k0Kernel Q₀ 1‖ := by ring_nf
          _ ≤ ‖k0Kernel Q 1 - k0Kernel Q₀ 1‖ + ‖k0Kernel Q₀ 1‖ := norm_add_le _ _
      linarith
    exact ⟨hQ, hQ_bdd, hk0_lo, hk0_hi⟩

  
  let SingleOut : (ℝ → ℂ) → ℂ → ℂ → Prop := fun Q u v =>
    let a₁ := (v - u * c0Kernel Q 1) / k0Kernel Q 1
    let kp := kPlusVal Q u a₁
    let km := kMinusVal Q u a₁
    let Ξ := 4 * kp * km / (kp + km) ^ 2
    k0Kernel Q 1 ≠ 0 ∧
    ‖a₁‖ ≤ 1 ∧
    (∀ w ∈ I,
      ‖u * c0Kernel Q w + a₁ * k0Kernel Q w‖ ≤ 1 / 2 ∧
      ‖pertPotential 1 Q u a₁ w‖ ≤ M₀ + 2 ∧
      ‖pertPotential (-1) Q u a₁ w‖ ≤ M₀ + 2) ∧
    ContinuousOn (pertPotential 1 Q u a₁) I ∧
    ContinuousOn (pertPotential (-1) Q u a₁) I ∧
    kp + km ≠ 0 ∧
    κ₀ ≤ ‖kp + km‖ ∧
    ‖(kp + km) / 2‖ ≤ 2 * κ₀ ∧
    ‖(kp - km) / (kp + km)‖ ≤ 1 / 11 ∧
    Ξ - 1 = -((kp - km) / (kp + km)) ^ 2 ∧
    120 / 121 ≤ Ξ.re ∧
    Ξ ∈ Complex.slitPlane ∧
    ‖cSqrt Ξ‖ ≤ 2 ∧
    canonRoot Q u a₁ ^ 2 = kp * km ∧
    ‖slNumerator Q u v‖ ≤ (1 / 4 : ℝ) * ‖k0Kernel Q 1‖ ∧
    ‖slNumerator Q u v‖ ≤ κ₀

  have hSingleEnv : ∀ Q : ℝ → ℂ, IsBasePot Q →
      ∀ u v : ℂ, ‖u‖ ≤ 2 * r_b → ‖v‖ ≤ 2 * r_b → SingleOut Q u v := by
    intro Q ⟨hQ_cont, hQ_bdd, hk0_lo, hk0_hi⟩ u v hu hv
    dsimp only [SingleOut]
    set k₀ : ℂ := k0Kernel Q 1
    have hk0_pos : 0 < ‖k₀‖ := lt_of_lt_of_le (by positivity) hk0_lo
    have hk0_ne : k₀ ≠ 0 := norm_pos_iff.mp hk0_pos
    have hBaseK : ∀ w ∈ I,
        ‖c0Kernel Q w‖ ≤ E₀ ∧ ‖c0Kernel Q w‖ ≤ B₀ ∧
        ‖k0Kernel Q w‖ ≤ B₀ ∧ ‖c0Deriv Q w‖ ≤ B₀ ∧ ‖k0Deriv Q w‖ ≤ B₀ := by
      intro w hw
      obtain ⟨hc0_w, hk0_w, hc0d_w, hk0d_w, _⟩ :=
        hLip.1 (M₀ + 1) 0 Q Q (by linarith) le_rfl hQ_cont hQ_cont
          (fun t ht => ⟨hQ_bdd t ht, hQ_bdd t ht, by simp⟩) w hw
      refine ⟨hc0_w, ?_, ?_, ?_, ?_⟩
      · dsimp [B₀]; nlinarith
      · dsimp [B₀]; nlinarith
      · dsimp [B₀]; nlinarith
      · dsimp [B₀]; nlinarith
    set a₁ : ℂ := (v - u * c0Kernel Q 1) / k₀
    have ha₁_bound : ‖a₁‖ ≤ K_a * r_b := by
      have hmul : a₁ * k₀ = v - u * c0Kernel Q 1 := div_mul_cancel₀ _ hk0_ne
      have hc0_1 : ‖c0Kernel Q 1‖ ≤ E₀ := (hBaseK 1 h1_mem).1
      have h_rhs : ‖v - u * c0Kernel Q 1‖ ≤ 2 * (1 + E₀) * r_b := by
        calc ‖v - u * c0Kernel Q 1‖
            ≤ ‖v‖ + ‖u * c0Kernel Q 1‖ := norm_sub_le _ _
          _ = ‖v‖ + ‖u‖ * ‖c0Kernel Q 1‖ := by rw [norm_mul]
          _ ≤ 2 * r_b + (2 * r_b) * E₀ :=
              add_le_add hv (mul_le_mul hu hc0_1 (norm_nonneg _) (by positivity))
          _ = 2 * (1 + E₀) * r_b := by ring
      have h_lhs : (3 / 4 : ℝ) * κ₀ * ‖a₁‖ ≤ ((3 / 4 : ℝ) * κ₀) * (K_a * r_b) := by
        have h_eq : ((3 / 4 : ℝ) * κ₀) * (K_a * r_b) = (9 / 4 : ℝ) * (1 + E₀) * r_b := by
          dsimp [K_a]
          field_simp [hκ₀_pos.ne']
          ring
        calc (3 / 4 : ℝ) * κ₀ * ‖a₁‖
            ≤ ‖k₀‖ * ‖a₁‖ := mul_le_mul_of_nonneg_right hk0_lo (norm_nonneg _)
          _ = ‖a₁ * k₀‖ := by rw [norm_mul, mul_comm]
          _ = ‖v - u * c0Kernel Q 1‖ := by rw [hmul]
          _ ≤ 2 * (1 + E₀) * r_b := h_rhs
          _ ≤ (9 / 4 : ℝ) * (1 + E₀) * r_b := by nlinarith
          _ = ((3 / 4 : ℝ) * κ₀) * (K_a * r_b) := h_eq.symm
      exact le_of_mul_le_mul_left h_lhs (by positivity)
    have ha₁_le_one : ‖a₁‖ ≤ 1 := by linarith
    have hField : ∀ w ∈ I,
        ‖u * c0Kernel Q w + a₁ * k0Kernel Q w‖ ≤ K_F * r_b ∧
        ‖u * c0Deriv Q w + a₁ * k0Deriv Q w‖ ≤ K_F * r_b := by
      intro w hw
      obtain ⟨_, hc0_B, hk0_B, hc0d_B, hk0d_B⟩ := hBaseK w hw
      refine ⟨?_, ?_⟩
      · calc ‖u * c0Kernel Q w + a₁ * k0Kernel Q w‖
            ≤ ‖u * c0Kernel Q w‖ + ‖a₁ * k0Kernel Q w‖ := norm_add_le _ _
          _ = ‖u‖ * ‖c0Kernel Q w‖ + ‖a₁‖ * ‖k0Kernel Q w‖ := by rw [norm_mul, norm_mul]
          _ ≤ (2 * r_b) * B₀ + (K_a * r_b) * B₀ :=
              add_le_add (mul_le_mul hu hc0_B (norm_nonneg _) (by positivity))
                (mul_le_mul ha₁_bound hk0_B (norm_nonneg _) (by positivity))
          _ = K_F * r_b := by dsimp [K_F]; ring
      · calc ‖u * c0Deriv Q w + a₁ * k0Deriv Q w‖
            ≤ ‖u * c0Deriv Q w‖ + ‖a₁ * k0Deriv Q w‖ := norm_add_le _ _
          _ = ‖u‖ * ‖c0Deriv Q w‖ + ‖a₁‖ * ‖k0Deriv Q w‖ := by rw [norm_mul, norm_mul]
          _ ≤ (2 * r_b) * B₀ + (K_a * r_b) * B₀ :=
              add_le_add (mul_le_mul hu hc0d_B (norm_nonneg _) (by positivity))
                (mul_le_mul ha₁_bound hk0d_B (norm_nonneg _) (by positivity))
          _ = K_F * r_b := by dsimp [K_F]; ring
    obtain ⟨_, _, _, _, hc0_cont, hc0d_cont, hk0_cont, hk0d_cont, _⟩ := hODE Q hQ_cont
    have hPertSgn : ∀ sgn : ℂ, ‖sgn‖ = 1 →
        ContinuousOn (pertPotential sgn Q u a₁) I ∧
        (∀ w ∈ I, ‖pertPotential sgn Q u a₁ w‖ ≤ M₀ + 2) ∧
        ‖k0Kernel (pertPotential sgn Q u a₁) 1 - k₀‖ ≤ (1 / 12 : ℝ) * ‖k₀‖ := by
      intro sgn hsgn
      have hFw_cont : ContinuousOn (fun w => u * c0Kernel Q w + a₁ * k0Kernel Q w) I :=
        (continuousOn_const.mul hc0_cont).add (continuousOn_const.mul hk0_cont)
      have hFpw_cont : ContinuousOn (fun w => u * c0Deriv Q w + a₁ * k0Deriv Q w) I :=
        (continuousOn_const.mul hc0d_cont).add (continuousOn_const.mul hk0d_cont)
      have hP_cont : ContinuousOn (pertPotential sgn Q u a₁) I :=
        (hQ_cont.sub (continuousOn_const.mul hFpw_cont)).sub
          (continuousOn_const.mul (hFw_cont.pow 2))
      have hP_diff : ∀ w ∈ I, ‖pertPotential sgn Q u a₁ w - Q w‖ ≤ 2 * K_F * r_b := by
        intro w hw
        obtain ⟨hFw_le, hFpw_le⟩ := hField w hw
        have hFw_half : ‖u * c0Kernel Q w + a₁ * k0Kernel Q w‖ ≤ 1 / 2 :=
          le_trans hFw_le hKF_rb_le_half
        have hFw_sq : ‖(u * c0Kernel Q w + a₁ * k0Kernel Q w) ^ 2‖ ≤ K_F * r_b := by
          rw [norm_pow, sq]
          have h1 : ‖u * c0Kernel Q w + a₁ * k0Kernel Q w‖ *
              ‖u * c0Kernel Q w + a₁ * k0Kernel Q w‖ ≤ (K_F * r_b) * (1 / 2) :=
            mul_le_mul hFw_le hFw_half (norm_nonneg _) (by positivity)
          linarith [mul_pos hKF_pos hrb_pos]
        have h_sub_eq : pertPotential sgn Q u a₁ w - Q w =
            -(sgn * (3 * Complex.I / 2) * (u * c0Deriv Q w + a₁ * k0Deriv Q w) +
              (1 / 4 : ℂ) * (u * c0Kernel Q w + a₁ * k0Kernel Q w) ^ 2) := by
          dsimp [pertPotential]
          ring
        rw [h_sub_eq, norm_neg]
        calc ‖sgn * (3 * Complex.I / 2) * (u * c0Deriv Q w + a₁ * k0Deriv Q w) +
                (1 / 4 : ℂ) * (u * c0Kernel Q w + a₁ * k0Kernel Q w) ^ 2‖
            ≤ ‖sgn * (3 * Complex.I / 2) * (u * c0Deriv Q w + a₁ * k0Deriv Q w)‖ +
                ‖(1 / 4 : ℂ) * (u * c0Kernel Q w + a₁ * k0Kernel Q w) ^ 2‖ := norm_add_le _ _
          _ = ‖sgn‖ * ‖(3 * Complex.I / 2 : ℂ)‖ * ‖u * c0Deriv Q w + a₁ * k0Deriv Q w‖ +
                ‖(1 / 4 : ℂ)‖ * ‖(u * c0Kernel Q w + a₁ * k0Kernel Q w) ^ 2‖ := by
              rw [norm_mul, norm_mul, norm_mul]
          _ = (3 / 2 : ℝ) * ‖u * c0Deriv Q w + a₁ * k0Deriv Q w‖ +
                (1 / 4 : ℝ) * ‖(u * c0Kernel Q w + a₁ * k0Kernel Q w) ^ 2‖ := by
              rw [hsgn, hnorm_3I2, hnorm_14, one_mul]
          _ ≤ (3 / 2 : ℝ) * (K_F * r_b) + (1 / 4 : ℝ) * (K_F * r_b) := by linarith
          _ ≤ 2 * K_F * r_b := by linarith [mul_pos hKF_pos hrb_pos]
      have hP_bdd : ∀ w ∈ I, ‖pertPotential sgn Q u a₁ w‖ ≤ M₀ + 2 := by
        intro w hw
        have hd := hP_diff w hw
        have hq := hQ_bdd w hw
        have h_tri : ‖pertPotential sgn Q u a₁ w‖ ≤
            ‖pertPotential sgn Q u a₁ w - Q w‖ + ‖Q w‖ := by
          calc ‖pertPotential sgn Q u a₁ w‖
              = ‖(pertPotential sgn Q u a₁ w - Q w) + Q w‖ := by ring_nf
            _ ≤ ‖pertPotential sgn Q u a₁ w - Q w‖ + ‖Q w‖ := norm_add_le _ _
        linarith
      have hk_diff : ‖k0Kernel (pertPotential sgn Q u a₁) 1 - k₀‖ ≤ (1 / 12 : ℝ) * ‖k₀‖ := by
        have h1 := (hLip.1 (M₀ + 2) (2 * K_F * r_b) (pertPotential sgn Q u a₁) Q
          (by linarith) (by positivity) hP_cont hQ_cont
          (fun w hw => ⟨hP_bdd w hw, le_trans (hQ_bdd w hw) (by linarith), hP_diff w hw⟩)
          1 h1_mem).2.2.2.2.2.1
        have h2 : E_pert * (2 * K_F * r_b) ≤ (1 / 12 : ℝ) * ‖k₀‖ := by
          calc E_pert * (2 * K_F * r_b) ≤ κ₀ / 16 := hE_pert_rb_le
            _ ≤ (1 / 12 : ℝ) * ‖k₀‖ := by linarith
        exact le_trans h1 h2
      exact ⟨hP_cont, hP_bdd, hk_diff⟩
    obtain ⟨hP1_cont, hP1_bdd, hkp_diff⟩ := hPertSgn 1 norm_one
    obtain ⟨hPm1_cont, hPm1_bdd, hkm_diff⟩ := hPertSgn (-1) (by simp)
    set kp : ℂ := kPlusVal Q u a₁
    set km : ℂ := kMinusVal Q u a₁
    change ‖kp - k₀‖ ≤ (1 / 12 : ℝ) * ‖k₀‖ at hkp_diff
    change ‖km - k₀‖ ≤ (1 / 12 : ℝ) * ‖k₀‖ at hkm_diff
    have hH_diff : ‖(kp + km) / 2 - k₀‖ ≤ (1 / 12 : ℝ) * ‖k₀‖ := by
      have h_eq : (kp + km) / 2 - k₀ = (1 / 2 : ℂ) * ((kp - k₀) + (km - k₀)) := by ring
      have hnorm_12 : ‖(1 / 2 : ℂ)‖ = 1 / 2 := by rw [norm_div]; norm_num
      rw [h_eq, norm_mul, hnorm_12]
      have h_sum := norm_add_le (kp - k₀) (km - k₀)
      linarith [hkp_diff, hkm_diff]
    have hS_lo_k0 : (11 / 6 : ℝ) * ‖k₀‖ ≤ ‖kp + km‖ := by
      have h_eq : (2 : ℂ) * k₀ = (kp + km) - ((kp - k₀) + (km - k₀)) := by ring
      have h2k : 2 * ‖k₀‖ ≤ ‖kp + km‖ + (‖kp - k₀‖ + ‖km - k₀‖) := by
        calc 2 * ‖k₀‖ = ‖(2 : ℂ) * k₀‖ := by rw [norm_mul]; norm_num
          _ = ‖(kp + km) - ((kp - k₀) + (km - k₀))‖ := by rw [h_eq]
          _ ≤ ‖kp + km‖ + ‖(kp - k₀) + (km - k₀)‖ := norm_sub_le _ _
          _ ≤ ‖kp + km‖ + (‖kp - k₀‖ + ‖km - k₀‖) :=
              add_le_add le_rfl (norm_add_le _ _)
      linarith [hkp_diff, hkm_diff]
    have hS_lo_κ0 : κ₀ ≤ ‖kp + km‖ := by linarith
    have hS_ne : kp + km ≠ 0 := norm_pos_iff.mp (lt_of_lt_of_le hκ₀_pos hS_lo_κ0)
    have hH_hi_k0 : ‖(kp + km) / 2‖ ≤ (13 / 12 : ℝ) * ‖k₀‖ := by
      have h_tri : ‖(kp + km) / 2‖ ≤ ‖(kp + km) / 2 - k₀‖ + ‖k₀‖ := by
        calc ‖(kp + km) / 2‖ = ‖((kp + km) / 2 - k₀) + k₀‖ := by ring_nf
          _ ≤ ‖(kp + km) / 2 - k₀‖ + ‖k₀‖ := norm_add_le _ _
      linarith
    have hH_hi_κ0 : ‖(kp + km) / 2‖ ≤ 2 * κ₀ := by linarith
    have hD_hi : ‖kp - km‖ ≤ (1 / 6 : ℝ) * ‖k₀‖ := by
      calc ‖kp - km‖ = ‖(kp - k₀) - (km - k₀)‖ := by ring_nf
        _ ≤ ‖kp - k₀‖ + ‖km - k₀‖ := norm_sub_le _ _
        _ ≤ (1 / 6 : ℝ) * ‖k₀‖ := by linarith [hkp_diff, hkm_diff]
    set q : ℂ := (kp - km) / (kp + km)
    have hq_le : ‖q‖ ≤ 1 / 11 := by
      have hmul : q * (kp + km) = kp - km := div_mul_cancel₀ _ hS_ne
      have h_ineq : ((11 / 6 : ℝ) * ‖k₀‖) * ‖q‖ ≤ ((11 / 6 : ℝ) * ‖k₀‖) * (1 / 11 : ℝ) := by
        calc ((11 / 6 : ℝ) * ‖k₀‖) * ‖q‖
            ≤ ‖kp + km‖ * ‖q‖ := mul_le_mul_of_nonneg_right hS_lo_k0 (norm_nonneg _)
          _ = ‖q * (kp + km)‖ := by rw [norm_mul, mul_comm]
          _ = ‖kp - km‖ := by rw [hmul]
          _ ≤ (1 / 6 : ℝ) * ‖k₀‖ := hD_hi
          _ = ((11 / 6 : ℝ) * ‖k₀‖) * (1 / 11 : ℝ) := by ring
      exact le_of_mul_le_mul_left h_ineq (by positivity)
    set Ξ : ℂ := 4 * kp * km / (kp + km) ^ 2
    have hΞ_sub_eq : Ξ - 1 = -q ^ 2 := by
      dsimp [Ξ, q]
      field_simp [hS_ne]
      ring
    have hΞ_sub_le : ‖Ξ - 1‖ ≤ 1 / 121 := by
      rw [hΞ_sub_eq, norm_neg, norm_pow]
      calc ‖q‖ ^ 2 ≤ (1 / 11 : ℝ) ^ 2 := pow_le_pow_left₀ (norm_nonneg _) hq_le 2
        _ = 1 / 121 := by norm_num
    have hΞ_re : 120 / 121 ≤ Ξ.re := by
      have h1 : |(Ξ - 1).re| ≤ ‖Ξ - 1‖ := Complex.abs_re_le_norm (Ξ - 1)
      have h2 : (Ξ - 1).re = Ξ.re - 1 := by simp
      rw [h2, abs_le] at h1
      linarith [h1.1, hΞ_sub_le]
    have hΞ_re_gt : 1 / 4 < Ξ.re := by linarith
    have hΞ_slit : Ξ ∈ Complex.slitPlane :=
      Complex.mem_slitPlane_iff.mpr (Or.inl (by linarith))
    have hR_sub_one : ‖cSqrt Ξ - 1‖ ≤ 1 / 121 :=
      le_trans (hcSqrt_sub_one Ξ hΞ_re_gt) hΞ_sub_le
    have hR_norm : ‖cSqrt Ξ‖ ≤ 2 := by
      have h_tri : ‖cSqrt Ξ‖ ≤ ‖cSqrt Ξ - 1‖ + ‖(1 : ℂ)‖ := by
        calc ‖cSqrt Ξ‖ = ‖(cSqrt Ξ - 1) + 1‖ := by ring_nf
          _ ≤ ‖cSqrt Ξ - 1‖ + ‖(1 : ℂ)‖ := norm_add_le _ _
      rw [norm_one] at h_tri
      linarith
    have hCanon_sq : canonRoot Q u a₁ ^ 2 = kp * km := by
      have hR_sq : cSqrt Ξ ^ 2 = Ξ := (hcSqrt_half Ξ hΞ_re_gt).1
      change (((kp + km) / 2) * cSqrt Ξ) ^ 2 = kp * km
      calc (((kp + km) / 2) * cSqrt Ξ) ^ 2
          = ((kp + km) / 2) ^ 2 * cSqrt Ξ ^ 2 := by ring
        _ = ((kp + km) / 2) ^ 2 * Ξ := by rw [hR_sq]
        _ = kp * km := by
            dsimp [Ξ]
            field_simp [hS_ne]
            ring
    have hNum_k0 : ‖slNumerator Q u v‖ ≤ (1 / 4 : ℝ) * ‖k₀‖ := by
      have h_decomp : slNumerator Q u v =
          (k₀ - (kp + km) / 2) + ((kp + km) / 2) * (1 - cSqrt Ξ) := by
        change k₀ - ((kp + km) / 2) * cSqrt Ξ = _
        ring
      have h1 : ‖k₀ - (kp + km) / 2‖ ≤ (1 / 12 : ℝ) * ‖k₀‖ := by
        rw [norm_sub_rev]
        exact hH_diff
      have h2 : ‖1 - cSqrt Ξ‖ ≤ 1 / 121 := by
        rw [norm_sub_rev]
        exact hR_sub_one
      have h3 : ‖((kp + km) / 2) * (1 - cSqrt Ξ)‖ ≤
          ((13 / 12 : ℝ) * ‖k₀‖) * (1 / 121 : ℝ) := by
        rw [norm_mul]
        exact mul_le_mul hH_hi_k0 h2 (norm_nonneg _) (by positivity)
      rw [h_decomp]
      calc ‖(k₀ - (kp + km) / 2) + ((kp + km) / 2) * (1 - cSqrt Ξ)‖
          ≤ ‖k₀ - (kp + km) / 2‖ + ‖((kp + km) / 2) * (1 - cSqrt Ξ)‖ := norm_add_le _ _
        _ ≤ (1 / 4 : ℝ) * ‖k₀‖ := by linarith
    have hNum_κ0 : ‖slNumerator Q u v‖ ≤ κ₀ := by linarith
    refine ⟨hk0_ne, ha₁_le_one, ?_, hP1_cont, hPm1_cont, hS_ne, hS_lo_κ0, hH_hi_κ0,
      hq_le, hΞ_sub_eq, hΞ_re, hΞ_slit, hR_norm, hCanon_sq, hNum_k0, hNum_κ0⟩
    intro w hw
    exact ⟨le_trans (hField w hw).1 hKF_rb_le_half, hP1_bdd w hw, hPm1_bdd w hw⟩

  
  have hVanishLeft : ∀ Q : ℝ → ℂ, IsBasePot Q →
      ∀ v : ℂ, ‖v‖ ≤ 2 * r_b → slNumerator Q 0 v = 0 := by
    intro Q hBase v hv
    have h0_le : ‖(0 : ℂ)‖ ≤ 2 * r_b := by simp [hrb_pos.le]
    have hOut := hSingleEnv Q hBase 0 v h0_le hv
    set k₀ : ℂ := k0Kernel Q 1
    set a₁ : ℂ := (v - (0 : ℂ) * c0Kernel Q 1) / k₀
    have hk0_ne : k₀ ≠ 0 := hOut.1
    have hk0_pos : 0 < ‖k₀‖ := norm_pos_iff.mpr hk0_ne
    have hCanon_sq : canonRoot Q 0 a₁ ^ 2 = kPlusVal Q 0 a₁ * kMinusVal Q 0 a₁ :=
      hOut.2.2.2.2.2.2.2.2.2.2.2.2.2.1
    have hNum_le : ‖slNumerator Q 0 v‖ ≤ (1 / 4 : ℝ) * ‖k₀‖ :=
      hOut.2.2.2.2.2.2.2.2.2.2.2.2.2.2.1
    have hW := hWronskProd Q a₁ hBase.1
    have h_factor : (canonRoot Q 0 a₁ - k₀) * (canonRoot Q 0 a₁ + k₀) = 0 := by
      calc (canonRoot Q 0 a₁ - k₀) * (canonRoot Q 0 a₁ + k₀)
          = canonRoot Q 0 a₁ ^ 2 - k₀ ^ 2 := by ring
        _ = kPlusVal Q 0 a₁ * kMinusVal Q 0 a₁ - k₀ ^ 2 := by rw [hCanon_sq]
        _ = 0 := sub_eq_zero.mpr hW
    rcases mul_eq_zero.mp h_factor with h_sub | h_add
    · have h_eq : canonRoot Q 0 a₁ = k₀ := sub_eq_zero.mp h_sub
      change k₀ - canonRoot Q 0 a₁ = 0
      rw [h_eq, sub_self]
    · exfalso
      have h_eq : canonRoot Q 0 a₁ = -k₀ := eq_neg_of_add_eq_zero_left h_add
      have h_num_eq : slNumerator Q 0 v = (2 : ℂ) * k₀ := by
        change k₀ - canonRoot Q 0 a₁ = (2 : ℂ) * k₀
        rw [h_eq]
        ring
      have h_norm_eq : ‖slNumerator Q 0 v‖ = 2 * ‖k₀‖ := by
        rw [h_num_eq, norm_mul]
        norm_num
      linarith

  have hVanishRight : ∀ Q : ℝ → ℂ, IsBasePot Q →
      ∀ u : ℂ, ‖u‖ ≤ 2 * r_b → slNumerator Q u 0 = 0 := by
    intro Q hBase u hu
    rcases hBase with ⟨hQ_cont, hQ_bdd, hk0_lo, hk0_hi⟩
    let Q_rev : ℝ → ℂ := fun w => Q (1 - w)
    have h_flip_cont : Continuous (fun w : ℝ => 1 - w) :=
      continuous_const.sub continuous_id
    have h_flip_maps : Set.MapsTo (fun w : ℝ => 1 - w) I I := by
      intro w ⟨hw0, hw1⟩
      exact ⟨by linarith, by linarith⟩
    have hQ_rev_cont : ContinuousOn Q_rev I :=
      hQ_cont.comp h_flip_cont.continuousOn h_flip_maps
    have hQ_rev_bdd : ∀ w ∈ I, ‖Q_rev w‖ ≤ M₀ + 1 :=
      fun w hw => hQ_bdd (1 - w) (h_flip_maps hw)
    have hk0_rev_eq : k0Kernel Q_rev 1 = k0Kernel Q 1 := hRevK Q hQ_cont
    have hBase_rev : IsBasePot Q_rev :=
      ⟨hQ_rev_cont, hQ_rev_bdd, by rwa [hk0_rev_eq], by rwa [hk0_rev_eq]⟩
    have hk0_ne : k0Kernel Q 1 ≠ 0 :=
      norm_pos_iff.mp (lt_of_lt_of_le (by positivity) hk0_lo)
    have h_left := hVanishLeft Q_rev hBase_rev (-u) (by simpa using hu)
    have h_rev := hRevNum Q hQ_cont hk0_ne 0 (-u)
    simpa using h_rev.symm.trans h_left

  
  have hUnifiedHolo : ∀ (Ω : Set (ℂ × ℂ)) (P : ℂ × ℂ → ℝ → ℂ) (w₀_fn w₁_fn : ℂ × ℂ → ℂ),
      IsOpen Ω →
      ContinuousOn (fun q : (ℂ × ℂ) × ℝ => P q.1 q.2) (Ω ×ˢ I) →
      (∀ w ∈ I, DifferentiableOn ℂ (fun p => P p w) Ω) →
      DifferentiableOn ℂ w₀_fn Ω →
      DifferentiableOn ℂ w₁_fn Ω →
      (∀ p ∈ Ω,
        let a₁ := (w₁_fn p - w₀_fn p * c0Kernel (P p) 1) / k0Kernel (P p) 1
        let kp := kPlusVal (P p) (w₀_fn p) a₁
        let km := kMinusVal (P p) (w₀_fn p) a₁
        k0Kernel (P p) 1 ≠ 0 ∧
        kp + km ≠ 0 ∧
        4 * kp * km / (kp + km) ^ 2 ∈ Complex.slitPlane) →
      DifferentiableOn ℂ (fun p => slNumerator (P p) (w₀_fn p) (w₁_fn p)) Ω := by
    intro Ω P w₀_fn w₁_fn hΩ hP_cont hP_holo hw₀_holo hw₁_holo h_adm
    obtain ⟨hc0_holo, hk0_holo, _, _⟩ :=
      hLip.2 Ω P (fun _ => 0) (fun _ => 0) hΩ hP_cont hP_holo
        (differentiableOn_const 0) (differentiableOn_const 0)
    let a₁_fn : ℂ × ℂ → ℂ :=
      fun p => (w₁_fn p - w₀_fn p * c0Kernel (P p) 1) / k0Kernel (P p) 1
    have ha₁_holo : DifferentiableOn ℂ a₁_fn Ω := by
      have hnum : DifferentiableOn ℂ (fun p => w₁_fn p - w₀_fn p * c0Kernel (P p) 1) Ω :=
        hw₁_holo.sub (hw₀_holo.mul hc0_holo)
      intro p hp
      have h_eq : a₁_fn =
          (fun q => (w₁_fn q - w₀_fn q * c0Kernel (P q) 1) * (k0Kernel (P q) 1)⁻¹) := by
        funext q
        exact div_eq_mul_inv _ _
      rw [h_eq]
      exact (hnum p hp).mul ((hk0_holo p hp).fun_inv (h_adm p hp).1)
    obtain ⟨_, _, hkp_holo, hkm_holo⟩ :=
      hLip.2 Ω P w₀_fn a₁_fn hΩ hP_cont hP_holo hw₀_holo ha₁_holo
    let S_fn : ℂ × ℂ → ℂ :=
      fun p => kPlusVal (P p) (w₀_fn p) (a₁_fn p) + kMinusVal (P p) (w₀_fn p) (a₁_fn p)
    have hS_holo : DifferentiableOn ℂ S_fn Ω := hkp_holo.add hkm_holo
    let Ξ_fn : ℂ × ℂ → ℂ :=
      fun p => 4 * kPlusVal (P p) (w₀_fn p) (a₁_fn p) *
        kMinusVal (P p) (w₀_fn p) (a₁_fn p) / (S_fn p) ^ 2
    have hΞ_holo : DifferentiableOn ℂ Ξ_fn Ω := by
      have hnum : DifferentiableOn ℂ
          (fun p => 4 * kPlusVal (P p) (w₀_fn p) (a₁_fn p) *
            kMinusVal (P p) (w₀_fn p) (a₁_fn p)) Ω :=
        ((differentiableOn_const (4 : ℂ)).mul hkp_holo).mul hkm_holo
      have hden : DifferentiableOn ℂ (fun p => (S_fn p) ^ 2) Ω := hS_holo.pow 2
      intro p hp
      have h_eq : Ξ_fn =
          (fun q => 4 * kPlusVal (P q) (w₀_fn q) (a₁_fn q) *
            kMinusVal (P q) (w₀_fn q) (a₁_fn q) * ((S_fn q) ^ 2)⁻¹) := by
        funext q
        exact div_eq_mul_inv _ _
      rw [h_eq]
      exact (hnum p hp).mul ((hden p hp).fun_inv (pow_ne_zero 2 (h_adm p hp).2.1))
    have hlog_holo : DifferentiableOn ℂ (fun p => Complex.log (Ξ_fn p)) Ω :=
      hΞ_holo.clog (fun p hp => (h_adm p hp).2.2)
    have hexp_holo : DifferentiableOn ℂ
        (fun p => Complex.exp ((1 / 2 : ℂ) * Complex.log (Ξ_fn p))) Ω :=
      ((differentiableOn_const (1 / 2 : ℂ)).mul hlog_holo).cexp
    have hH_holo : DifferentiableOn ℂ (fun p => S_fn p / 2) Ω := by
      have h_eq : (fun p => S_fn p / 2) = (fun p => S_fn p * (2 : ℂ)⁻¹) := by
        funext p
        exact div_eq_mul_inv _ _
      rw [h_eq]
      exact hS_holo.mul (differentiableOn_const (2 : ℂ)⁻¹)
    exact hk0_holo.sub (hH_holo.mul hexp_holo)

  
  have hTwoPotLip : ∀ (Q₁ Q₂ : ℝ → ℂ) (Δ : ℝ),
      0 ≤ Δ →
      IsBasePot Q₁ →
      IsBasePot Q₂ →
      (∀ w ∈ I, ‖Q₁ w - Q₂ w‖ ≤ Δ) →
      ∀ w₀ w₁ : ℂ, ‖w₀‖ ≤ r_b → ‖w₁‖ ≤ r_b →
        ‖slNumerator Q₁ w₀ w₁ - slNumerator Q₂ w₀ w₁‖ ≤ L_num * Δ := by
    intro Q₁ Q₂ Δ hΔ hBase₁ hBase₂ hDiff w₀ w₁ hw₀ hw₁
    have hw₀_le_one : ‖w₀‖ ≤ 1 := le_trans hw₀ hrb_le_one
    have hw₀_2rb : ‖w₀‖ ≤ 2 * r_b := by linarith
    have hw₁_2rb : ‖w₁‖ ≤ 2 * r_b := by linarith
    have hOut₁ := hSingleEnv Q₁ hBase₁ w₀ w₁ hw₀_2rb hw₁_2rb
    have hOut₂ := hSingleEnv Q₂ hBase₂ w₀ w₁ hw₀_2rb hw₁_2rb
    rcases hBase₁ with ⟨hQ₁_cont, hQ₁_bdd, hk0₁_lo, _⟩
    rcases hBase₂ with ⟨hQ₂_cont, hQ₂_bdd, _, _⟩
    obtain ⟨hk0₁_ne, ha₁₁_le, hPt₁, hP1₁_cont, hPm1₁_cont, hS₁_ne, hS₁_lo, _, hq₁_le,
      hΞ₁_sub, hΞ₁_re, _, hR₁_norm, _, _, _⟩ := hOut₁
    obtain ⟨hk0₂_ne, ha₁₂_le, hPt₂, hP1₂_cont, hPm1₂_cont, hS₂_ne, _, hH₂_hi, hq₂_le,
      hΞ₂_sub, hΞ₂_re, _, _, _, _, _⟩ := hOut₂
    have hQ₂_ker : ∀ w ∈ I, ‖k0Kernel Q₂ w‖ ≤ B₀ ∧ ‖k0Deriv Q₂ w‖ ≤ B₀ := by
      intro w hw
      obtain ⟨_, hk0_w, _, hk0d_w, _⟩ :=
        hLip.1 (M₀ + 1) 0 Q₂ Q₂ (by linarith) le_rfl hQ₂_cont hQ₂_cont
          (fun t ht => ⟨hQ₂_bdd t ht, hQ₂_bdd t ht, by simp⟩) w hw
      exact ⟨by dsimp [B₀]; nlinarith, by dsimp [B₀]; nlinarith⟩
    have hKer_diff : ∀ w ∈ I,
        ‖c0Kernel Q₁ w - c0Kernel Q₂ w‖ ≤ B₀ * Δ ∧
        ‖k0Kernel Q₁ w - k0Kernel Q₂ w‖ ≤ B₀ * Δ ∧
        ‖c0Deriv Q₁ w - c0Deriv Q₂ w‖ ≤ B₀ * Δ ∧
        ‖k0Deriv Q₁ w - k0Deriv Q₂ w‖ ≤ B₀ * Δ := by
      intro w hw
      obtain ⟨_, _, _, _, hdc0, hdk0, hdc0', hdk0'⟩ :=
        hLip.1 (M₀ + 1) Δ Q₁ Q₂ (by linarith) hΔ hQ₁_cont hQ₂_cont
          (fun t ht => ⟨hQ₁_bdd t ht, hQ₂_bdd t ht, hDiff t ht⟩) w hw
      have hE₀_le_B₀ : E₀ ≤ B₀ := by dsimp [B₀]; nlinarith
      have h1M_eq : (1 + (M₀ + 1)) * E₀ * Δ = B₀ * Δ := by dsimp [B₀]; ring
      exact ⟨le_trans hdc0 (mul_le_mul_of_nonneg_right hE₀_le_B₀ hΔ),
        le_trans hdk0 (mul_le_mul_of_nonneg_right hE₀_le_B₀ hΔ),
        by linarith [hdc0', h1M_eq],
        by linarith [hdk0', h1M_eq]⟩
    set a₁₁ : ℂ := (w₁ - w₀ * c0Kernel Q₁ 1) / k0Kernel Q₁ 1
    set a₁₂ : ℂ := (w₁ - w₀ * c0Kernel Q₂ 1) / k0Kernel Q₂ 1
    have ha₁_diff : ‖a₁₁ - a₁₂‖ ≤ C_a * Δ := by
      have hm1 : a₁₁ * k0Kernel Q₁ 1 = w₁ - w₀ * c0Kernel Q₁ 1 :=
        div_mul_cancel₀ _ hk0₁_ne
      have hm2 : a₁₂ * k0Kernel Q₂ 1 = w₁ - w₀ * c0Kernel Q₂ 1 :=
        div_mul_cancel₀ _ hk0₂_ne
      have h_id : (a₁₁ - a₁₂) * k0Kernel Q₁ 1 =
          -(w₀ * (c0Kernel Q₁ 1 - c0Kernel Q₂ 1) +
            a₁₂ * (k0Kernel Q₁ 1 - k0Kernel Q₂ 1)) := by
        calc (a₁₁ - a₁₂) * k0Kernel Q₁ 1
            = a₁₁ * k0Kernel Q₁ 1 - a₁₂ * k0Kernel Q₂ 1 -
                a₁₂ * (k0Kernel Q₁ 1 - k0Kernel Q₂ 1) := by ring
          _ = (w₁ - w₀ * c0Kernel Q₁ 1) - (w₁ - w₀ * c0Kernel Q₂ 1) -
                a₁₂ * (k0Kernel Q₁ 1 - k0Kernel Q₂ 1) := by rw [hm1, hm2]
          _ = -(w₀ * (c0Kernel Q₁ 1 - c0Kernel Q₂ 1) +
                a₁₂ * (k0Kernel Q₁ 1 - k0Kernel Q₂ 1)) := by ring
      obtain ⟨hdc0_1, hdk0_1, _, _⟩ := hKer_diff 1 h1_mem
      have h_rhs : ‖(a₁₁ - a₁₂) * k0Kernel Q₁ 1‖ ≤ 2 * B₀ * Δ := by
        rw [h_id, norm_neg]
        calc ‖w₀ * (c0Kernel Q₁ 1 - c0Kernel Q₂ 1) +
                a₁₂ * (k0Kernel Q₁ 1 - k0Kernel Q₂ 1)‖
            ≤ ‖w₀ * (c0Kernel Q₁ 1 - c0Kernel Q₂ 1)‖ +
                ‖a₁₂ * (k0Kernel Q₁ 1 - k0Kernel Q₂ 1)‖ := norm_add_le _ _
          _ = ‖w₀‖ * ‖c0Kernel Q₁ 1 - c0Kernel Q₂ 1‖ +
                ‖a₁₂‖ * ‖k0Kernel Q₁ 1 - k0Kernel Q₂ 1‖ := by rw [norm_mul, norm_mul]
          _ ≤ 1 * (B₀ * Δ) + 1 * (B₀ * Δ) :=
              add_le_add (mul_le_mul hw₀_le_one hdc0_1 (norm_nonneg _) zero_le_one)
                (mul_le_mul ha₁₂_le hdk0_1 (norm_nonneg _) zero_le_one)
          _ = 2 * B₀ * Δ := by ring
      have h_lhs : ((3 / 4 : ℝ) * κ₀) * ‖a₁₁ - a₁₂‖ ≤ ((3 / 4 : ℝ) * κ₀) * (C_a * Δ) := by
        have h_eq : ((3 / 4 : ℝ) * κ₀) * (C_a * Δ) = (9 / 4 : ℝ) * B₀ * Δ := by
          dsimp [C_a]
          field_simp [hκ₀_pos.ne']
          ring
        calc ((3 / 4 : ℝ) * κ₀) * ‖a₁₁ - a₁₂‖
            ≤ ‖k0Kernel Q₁ 1‖ * ‖a₁₁ - a₁₂‖ :=
              mul_le_mul_of_nonneg_right hk0₁_lo (norm_nonneg _)
          _ = ‖(a₁₁ - a₁₂) * k0Kernel Q₁ 1‖ := by rw [norm_mul, mul_comm]
          _ ≤ 2 * B₀ * Δ := h_rhs
          _ ≤ (9 / 4 : ℝ) * B₀ * Δ := by nlinarith
          _ = ((3 / 4 : ℝ) * κ₀) * (C_a * Δ) := h_eq.symm
      exact le_of_mul_le_mul_left h_lhs (by positivity)
    have hPertDiff : ∀ sgn : ℂ, ‖sgn‖ = 1 →
        ∀ w ∈ I,
          ‖pertPotential sgn Q₁ w₀ a₁₁ w - pertPotential sgn Q₂ w₀ a₁₂ w‖ ≤
            (1 + 2 * C_F) * Δ := by
      intro sgn hsgn w hw
      obtain ⟨hdc0, hdk0, hdc0', hdk0'⟩ := hKer_diff w hw
      obtain ⟨hk0₂_B, hk0d₂_B⟩ := hQ₂_ker w hw
      let F₁ : ℂ := w₀ * c0Kernel Q₁ w + a₁₁ * k0Kernel Q₁ w
      let F₂ : ℂ := w₀ * c0Kernel Q₂ w + a₁₂ * k0Kernel Q₂ w
      let Fp₁ : ℂ := w₀ * c0Deriv Q₁ w + a₁₁ * k0Deriv Q₁ w
      let Fp₂ : ℂ := w₀ * c0Deriv Q₂ w + a₁₂ * k0Deriv Q₂ w
      have hF_diff : ‖F₁ - F₂‖ ≤ C_F * Δ := by
        have h_id : F₁ - F₂ =
            w₀ * (c0Kernel Q₁ w - c0Kernel Q₂ w) +
            a₁₁ * (k0Kernel Q₁ w - k0Kernel Q₂ w) +
            (a₁₁ - a₁₂) * k0Kernel Q₂ w := by
          dsimp [F₁, F₂]; ring
        rw [h_id]
        calc ‖w₀ * (c0Kernel Q₁ w - c0Kernel Q₂ w) +
                a₁₁ * (k0Kernel Q₁ w - k0Kernel Q₂ w) +
                (a₁₁ - a₁₂) * k0Kernel Q₂ w‖
            ≤ ‖w₀ * (c0Kernel Q₁ w - c0Kernel Q₂ w) +
                a₁₁ * (k0Kernel Q₁ w - k0Kernel Q₂ w)‖ +
              ‖(a₁₁ - a₁₂) * k0Kernel Q₂ w‖ := norm_add_le _ _
          _ ≤ ‖w₀ * (c0Kernel Q₁ w - c0Kernel Q₂ w)‖ +
              ‖a₁₁ * (k0Kernel Q₁ w - k0Kernel Q₂ w)‖ +
              ‖(a₁₁ - a₁₂) * k0Kernel Q₂ w‖ :=
              add_le_add (norm_add_le _ _) le_rfl
          _ = ‖w₀‖ * ‖c0Kernel Q₁ w - c0Kernel Q₂ w‖ +
              ‖a₁₁‖ * ‖k0Kernel Q₁ w - k0Kernel Q₂ w‖ +
              ‖a₁₁ - a₁₂‖ * ‖k0Kernel Q₂ w‖ := by rw [norm_mul, norm_mul, norm_mul]
          _ ≤ 1 * (B₀ * Δ) + 1 * (B₀ * Δ) + (C_a * Δ) * B₀ :=
              add_le_add
                (add_le_add
                  (mul_le_mul hw₀_le_one hdc0 (norm_nonneg _) zero_le_one)
                  (mul_le_mul ha₁₁_le hdk0 (norm_nonneg _) zero_le_one))
                (mul_le_mul ha₁_diff hk0₂_B (norm_nonneg _) (by positivity))
          _ = C_F * Δ := by dsimp [C_F]; ring
      have hFp_diff : ‖Fp₁ - Fp₂‖ ≤ C_F * Δ := by
        have h_id : Fp₁ - Fp₂ =
            w₀ * (c0Deriv Q₁ w - c0Deriv Q₂ w) +
            a₁₁ * (k0Deriv Q₁ w - k0Deriv Q₂ w) +
            (a₁₁ - a₁₂) * k0Deriv Q₂ w := by
          dsimp [Fp₁, Fp₂]; ring
        rw [h_id]
        calc ‖w₀ * (c0Deriv Q₁ w - c0Deriv Q₂ w) +
                a₁₁ * (k0Deriv Q₁ w - k0Deriv Q₂ w) +
                (a₁₁ - a₁₂) * k0Deriv Q₂ w‖
            ≤ ‖w₀ * (c0Deriv Q₁ w - c0Deriv Q₂ w) +
                a₁₁ * (k0Deriv Q₁ w - k0Deriv Q₂ w)‖ +
              ‖(a₁₁ - a₁₂) * k0Deriv Q₂ w‖ := norm_add_le _ _
          _ ≤ ‖w₀ * (c0Deriv Q₁ w - c0Deriv Q₂ w)‖ +
              ‖a₁₁ * (k0Deriv Q₁ w - k0Deriv Q₂ w)‖ +
              ‖(a₁₁ - a₁₂) * k0Deriv Q₂ w‖ :=
              add_le_add (norm_add_le _ _) le_rfl
          _ = ‖w₀‖ * ‖c0Deriv Q₁ w - c0Deriv Q₂ w‖ +
              ‖a₁₁‖ * ‖k0Deriv Q₁ w - k0Deriv Q₂ w‖ +
              ‖a₁₁ - a₁₂‖ * ‖k0Deriv Q₂ w‖ := by rw [norm_mul, norm_mul, norm_mul]
          _ ≤ 1 * (B₀ * Δ) + 1 * (B₀ * Δ) + (C_a * Δ) * B₀ :=
              add_le_add
                (add_le_add
                  (mul_le_mul hw₀_le_one hdc0' (norm_nonneg _) zero_le_one)
                  (mul_le_mul ha₁₁_le hdk0' (norm_nonneg _) zero_le_one))
                (mul_le_mul ha₁_diff hk0d₂_B (norm_nonneg _) (by positivity))
          _ = C_F * Δ := by dsimp [C_F]; ring
      have hF_sum_le : ‖F₁ + F₂‖ ≤ 1 := by
        have hF₁_le : ‖F₁‖ ≤ 1 / 2 := (hPt₁ w hw).1
        have hF₂_le : ‖F₂‖ ≤ 1 / 2 := (hPt₂ w hw).1
        calc ‖F₁ + F₂‖ ≤ ‖F₁‖ + ‖F₂‖ := norm_add_le _ _
          _ ≤ 1 / 2 + 1 / 2 := add_le_add hF₁_le hF₂_le
          _ = 1 := by norm_num
      have hF_sq_diff : ‖F₁ ^ 2 - F₂ ^ 2‖ ≤ C_F * Δ := by
        have h_sq_eq : F₁ ^ 2 - F₂ ^ 2 = (F₁ + F₂) * (F₁ - F₂) := by ring
        rw [h_sq_eq, norm_mul]
        calc ‖F₁ + F₂‖ * ‖F₁ - F₂‖
            ≤ 1 * (C_F * Δ) :=
              mul_le_mul hF_sum_le hF_diff (norm_nonneg _) zero_le_one
          _ = C_F * Δ := one_mul _
      have hP_eq : pertPotential sgn Q₁ w₀ a₁₁ w - pertPotential sgn Q₂ w₀ a₁₂ w =
          (Q₁ w - Q₂ w) - sgn * (3 * Complex.I / 2) * (Fp₁ - Fp₂) -
            (1 / 4 : ℂ) * (F₁ ^ 2 - F₂ ^ 2) := by
        dsimp [pertPotential, F₁, F₂, Fp₁, Fp₂]
        ring
      rw [hP_eq]
      calc ‖(Q₁ w - Q₂ w) - sgn * (3 * Complex.I / 2) * (Fp₁ - Fp₂) -
              (1 / 4 : ℂ) * (F₁ ^ 2 - F₂ ^ 2)‖
          ≤ ‖(Q₁ w - Q₂ w) - sgn * (3 * Complex.I / 2) * (Fp₁ - Fp₂)‖ +
              ‖(1 / 4 : ℂ) * (F₁ ^ 2 - F₂ ^ 2)‖ := norm_sub_le _ _
        _ ≤ ‖Q₁ w - Q₂ w‖ + ‖sgn * (3 * Complex.I / 2) * (Fp₁ - Fp₂)‖ +
              ‖(1 / 4 : ℂ) * (F₁ ^ 2 - F₂ ^ 2)‖ :=
              add_le_add (norm_sub_le _ _) le_rfl
        _ = ‖Q₁ w - Q₂ w‖ + ‖sgn‖ * ‖(3 * Complex.I / 2 : ℂ)‖ * ‖Fp₁ - Fp₂‖ +
              ‖(1 / 4 : ℂ)‖ * ‖F₁ ^ 2 - F₂ ^ 2‖ := by
              rw [norm_mul, norm_mul, norm_mul]
        _ = ‖Q₁ w - Q₂ w‖ + (3 / 2 : ℝ) * ‖Fp₁ - Fp₂‖ +
              (1 / 4 : ℝ) * ‖F₁ ^ 2 - F₂ ^ 2‖ := by
              rw [hsgn, hnorm_3I2, hnorm_14, one_mul]
        _ ≤ Δ + (3 / 2 : ℝ) * (C_F * Δ) + (1 / 4 : ℝ) * (C_F * Δ) := by
              linarith [hDiff w hw]
        _ ≤ (1 + 2 * C_F) * Δ := by nlinarith
    have hkp_diff : ‖kPlusVal Q₁ w₀ a₁₁ - kPlusVal Q₂ w₀ a₁₂‖ ≤ C_k * Δ := by
      have h1 := (hLip.1 (M₀ + 2) ((1 + 2 * C_F) * Δ)
        (pertPotential 1 Q₁ w₀ a₁₁) (pertPotential 1 Q₂ w₀ a₁₂)
        (by linarith) (by positivity) hP1₁_cont hP1₂_cont
        (fun w hw => ⟨(hPt₁ w hw).2.1, (hPt₂ w hw).2.1, hPertDiff 1 norm_one w hw⟩)
        1 h1_mem).2.2.2.2.2.1
      simpa [kPlusVal, C_k, E_pert, mul_assoc] using h1
    have hkm_diff : ‖kMinusVal Q₁ w₀ a₁₁ - kMinusVal Q₂ w₀ a₁₂‖ ≤ C_k * Δ := by
      have h1 := (hLip.1 (M₀ + 2) ((1 + 2 * C_F) * Δ)
        (pertPotential (-1) Q₁ w₀ a₁₁) (pertPotential (-1) Q₂ w₀ a₁₂)
        (by linarith) (by positivity) hPm1₁_cont hPm1₂_cont
        (fun w hw => ⟨(hPt₁ w hw).2.2, (hPt₂ w hw).2.2, hPertDiff (-1) (by simp) w hw⟩)
        1 h1_mem).2.2.2.2.2.1
      simpa [kMinusVal, C_k, E_pert, mul_assoc] using h1
    set kp₁ : ℂ := kPlusVal Q₁ w₀ a₁₁
    set km₁ : ℂ := kMinusVal Q₁ w₀ a₁₁
    set kp₂ : ℂ := kPlusVal Q₂ w₀ a₁₂
    set km₂ : ℂ := kMinusVal Q₂ w₀ a₁₂
    set S₁ : ℂ := kp₁ + km₁
    set S₂ : ℂ := kp₂ + km₂
    set q₁ : ℂ := (kp₁ - km₁) / S₁
    set q₂ : ℂ := (kp₂ - km₂) / S₂
    set Ξ₁ : ℂ := 4 * kp₁ * km₁ / S₁ ^ 2
    set Ξ₂ : ℂ := 4 * kp₂ * km₂ / S₂ ^ 2
    have hS_diff : ‖S₁ - S₂‖ ≤ 2 * C_k * Δ := by
      calc ‖S₁ - S₂‖ = ‖(kp₁ - kp₂) + (km₁ - km₂)‖ := by dsimp [S₁, S₂]; ring_nf
        _ ≤ ‖kp₁ - kp₂‖ + ‖km₁ - km₂‖ := norm_add_le _ _
        _ ≤ 2 * C_k * Δ := by linarith
    have hH_diff : ‖S₁ / 2 - S₂ / 2‖ ≤ C_k * Δ := by
      have h_eq : S₁ / 2 - S₂ / 2 = (1 / 2 : ℂ) * (S₁ - S₂) := by ring
      have hnorm_12 : ‖(1 / 2 : ℂ)‖ = 1 / 2 := by rw [norm_div]; norm_num
      rw [h_eq, norm_mul, hnorm_12]
      linarith
    have hD_diff : ‖(kp₁ - km₁) - (kp₂ - km₂)‖ ≤ 2 * C_k * Δ := by
      calc ‖(kp₁ - km₁) - (kp₂ - km₂)‖ = ‖(kp₁ - kp₂) - (km₁ - km₂)‖ := by ring_nf
        _ ≤ ‖kp₁ - kp₂‖ + ‖km₁ - km₂‖ := norm_sub_le _ _
        _ ≤ 2 * C_k * Δ := by linarith
    have hq_diff : ‖q₁ - q₂‖ ≤ (4 * C_k / κ₀) * Δ := by
      have hm1 : q₁ * S₁ = kp₁ - km₁ := div_mul_cancel₀ _ hS₁_ne
      have hm2 : q₂ * S₂ = kp₂ - km₂ := div_mul_cancel₀ _ hS₂_ne
      have h_id : (q₁ - q₂) * S₁ = ((kp₁ - km₁) - (kp₂ - km₂)) - q₂ * (S₁ - S₂) := by
        calc (q₁ - q₂) * S₁ = q₁ * S₁ - q₂ * S₂ - q₂ * (S₁ - S₂) := by ring
          _ = ((kp₁ - km₁) - (kp₂ - km₂)) - q₂ * (S₁ - S₂) := by rw [hm1, hm2]
      have hq₂_le_one : ‖q₂‖ ≤ 1 := by linarith
      have h_rhs : ‖(q₁ - q₂) * S₁‖ ≤ 4 * C_k * Δ := by
        rw [h_id]
        calc ‖((kp₁ - km₁) - (kp₂ - km₂)) - q₂ * (S₁ - S₂)‖
            ≤ ‖(kp₁ - km₁) - (kp₂ - km₂)‖ + ‖q₂ * (S₁ - S₂)‖ := norm_sub_le _ _
          _ = ‖(kp₁ - km₁) - (kp₂ - km₂)‖ + ‖q₂‖ * ‖S₁ - S₂‖ := by rw [norm_mul]
          _ ≤ 2 * C_k * Δ + 1 * (2 * C_k * Δ) :=
              add_le_add hD_diff
                (mul_le_mul hq₂_le_one hS_diff (norm_nonneg _) zero_le_one)
          _ = 4 * C_k * Δ := by ring
      have h_lhs : κ₀ * ‖q₁ - q₂‖ ≤ κ₀ * ((4 * C_k / κ₀) * Δ) := by
        have h_eq : κ₀ * ((4 * C_k / κ₀) * Δ) = 4 * C_k * Δ := by
          field_simp [hκ₀_pos.ne']
        calc κ₀ * ‖q₁ - q₂‖
            ≤ ‖S₁‖ * ‖q₁ - q₂‖ := mul_le_mul_of_nonneg_right hS₁_lo (norm_nonneg _)
          _ = ‖(q₁ - q₂) * S₁‖ := by rw [norm_mul, mul_comm]
          _ ≤ 4 * C_k * Δ := h_rhs
          _ = κ₀ * ((4 * C_k / κ₀) * Δ) := h_eq.symm
      exact le_of_mul_le_mul_left h_lhs hκ₀_pos
    have hΞ_diff : ‖Ξ₁ - Ξ₂‖ ≤ (4 * C_k / κ₀) * Δ := by
      have h_id : Ξ₁ - Ξ₂ = -(q₁ + q₂) * (q₁ - q₂) := by
        calc Ξ₁ - Ξ₂ = (Ξ₁ - 1) - (Ξ₂ - 1) := by ring
          _ = -q₁ ^ 2 - (-q₂ ^ 2) := by rw [hΞ₁_sub, hΞ₂_sub]
          _ = -(q₁ + q₂) * (q₁ - q₂) := by ring
      have hq_sum : ‖q₁ + q₂‖ ≤ 1 := by
        calc ‖q₁ + q₂‖ ≤ ‖q₁‖ + ‖q₂‖ := norm_add_le _ _
          _ ≤ 1 / 11 + 1 / 11 := add_le_add hq₁_le hq₂_le
          _ ≤ 1 := by norm_num
      rw [h_id, norm_mul, norm_neg]
      calc ‖q₁ + q₂‖ * ‖q₁ - q₂‖
          ≤ 1 * ((4 * C_k / κ₀) * Δ) :=
            mul_le_mul hq_sum hq_diff (norm_nonneg _) zero_le_one
        _ = (4 * C_k / κ₀) * Δ := one_mul _
    have hR_diff : ‖cSqrt Ξ₁ - cSqrt Ξ₂‖ ≤ (4 * C_k / κ₀) * Δ :=
      le_trans (hcSqrt_lip Ξ₁ Ξ₂ (by linarith) (by linarith)) hΞ_diff
    have hCanon_diff : ‖canonRoot Q₁ w₀ a₁₁ - canonRoot Q₂ w₀ a₁₂‖ ≤ 10 * C_k * Δ := by
      have h_id : canonRoot Q₁ w₀ a₁₁ - canonRoot Q₂ w₀ a₁₂ =
          (S₁ / 2 - S₂ / 2) * cSqrt Ξ₁ + (S₂ / 2) * (cSqrt Ξ₁ - cSqrt Ξ₂) := by
        change (S₁ / 2) * cSqrt Ξ₁ - (S₂ / 2) * cSqrt Ξ₂ = _
        ring
      have h_term1 : ‖(S₁ / 2 - S₂ / 2) * cSqrt Ξ₁‖ ≤ 2 * C_k * Δ := by
        rw [norm_mul]
        calc ‖S₁ / 2 - S₂ / 2‖ * ‖cSqrt Ξ₁‖
            ≤ (C_k * Δ) * 2 :=
              mul_le_mul hH_diff hR₁_norm (norm_nonneg _) (by positivity)
          _ = 2 * C_k * Δ := by ring
      have h_term2 : ‖(S₂ / 2) * (cSqrt Ξ₁ - cSqrt Ξ₂)‖ ≤ 8 * C_k * Δ := by
        rw [norm_mul]
        have h_cancel : (2 * κ₀) * ((4 * C_k / κ₀) * Δ) = 8 * C_k * Δ := by
          field_simp [hκ₀_pos.ne']
          ring
        calc ‖S₂ / 2‖ * ‖cSqrt Ξ₁ - cSqrt Ξ₂‖
            ≤ (2 * κ₀) * ((4 * C_k / κ₀) * Δ) :=
              mul_le_mul hH₂_hi hR_diff (norm_nonneg _) (by positivity)
          _ = 8 * C_k * Δ := h_cancel
      rw [h_id]
      calc ‖(S₁ / 2 - S₂ / 2) * cSqrt Ξ₁ + (S₂ / 2) * (cSqrt Ξ₁ - cSqrt Ξ₂)‖
          ≤ ‖(S₁ / 2 - S₂ / 2) * cSqrt Ξ₁‖ + ‖(S₂ / 2) * (cSqrt Ξ₁ - cSqrt Ξ₂)‖ :=
            norm_add_le _ _
        _ ≤ 10 * C_k * Δ := by linarith
    have hk0_1_diff : ‖k0Kernel Q₁ 1 - k0Kernel Q₂ 1‖ ≤ B₀ * Δ :=
      (hKer_diff 1 h1_mem).2.1
    have h_num_id : slNumerator Q₁ w₀ w₁ - slNumerator Q₂ w₀ w₁ =
        (k0Kernel Q₁ 1 - k0Kernel Q₂ 1) -
          (canonRoot Q₁ w₀ a₁₁ - canonRoot Q₂ w₀ a₁₂) := by
      dsimp [slNumerator, a₁₁, a₁₂]
      ring
    rw [h_num_id]
    calc ‖(k0Kernel Q₁ 1 - k0Kernel Q₂ 1) -
            (canonRoot Q₁ w₀ a₁₁ - canonRoot Q₂ w₀ a₁₂)‖
        ≤ ‖k0Kernel Q₁ 1 - k0Kernel Q₂ 1‖ +
            ‖canonRoot Q₁ w₀ a₁₁ - canonRoot Q₂ w₀ a₁₂‖ := norm_sub_le _ _
      _ ≤ B₀ * Δ + 10 * C_k * Δ := add_le_add hk0_1_diff hCanon_diff
      _ = L_num * Δ := by dsimp [L_num]; ring

  
  refine ⟨δ_Q, r_b, M_num, hδ_pos, hrb_pos, hM_num_pos, ?_, ?_, ?_⟩
  · 
    intro Q hQ hQ_close
    have hBase := hBallToBase Q hQ hQ_close
    have hk0_ne : k0Kernel Q 1 ≠ 0 :=
      (hSingleEnv Q hBase 0 0 (by simp [hrb_pos.le]) (by simp [hrb_pos.le])).1
    refine ⟨hk0_ne, ?_, ?_⟩
    · let Ω_bi : Set (ℂ × ℂ) :=
        Metric.ball (0 : ℂ) (2 * r_b) ×ˢ Metric.ball (0 : ℂ) (2 * r_b)
      have hΩ_bi : IsOpen Ω_bi := Metric.isOpen_ball.prod Metric.isOpen_ball
      have hP_cont : ContinuousOn (fun q : (ℂ × ℂ) × ℝ => Q q.2) (Ω_bi ×ˢ I) :=
        hQ.comp continuous_snd.continuousOn (fun _ hq => hq.2)
      exact hUnifiedHolo Ω_bi (fun _ w => Q w) Prod.fst Prod.snd
        hΩ_bi hP_cont (fun w _ => differentiableOn_const (Q w))
        differentiable_fst.differentiableOn differentiable_snd.differentiableOn
        (fun z hz => by
          have hz1 : ‖z.1‖ ≤ 2 * r_b := by
            have : ‖z.1‖ < 2 * r_b := by simpa [Metric.mem_ball, dist_zero_right] using hz.1
            exact this.le
          have hz2 : ‖z.2‖ ≤ 2 * r_b := by
            have : ‖z.2‖ < 2 * r_b := by simpa [Metric.mem_ball, dist_zero_right] using hz.2
            exact this.le
          have hOut := hSingleEnv Q hBase z.1 z.2 hz1 hz2
          exact ⟨hOut.1, hOut.2.2.2.2.2.1, hOut.2.2.2.2.2.2.2.2.2.2.2.1⟩)
    · intro w₀ w₁ hw₀ hw₁
      have hOut := hSingleEnv Q hBase w₀ w₁ hw₀.le hw₁.le
      exact ⟨le_trans hOut.2.2.2.2.2.2.2.2.2.2.2.2.2.2.2 hκ₀_le_M,
        hVanishLeft Q hBase w₁ hw₁.le,
        hVanishRight Q hBase w₀ hw₀.le⟩
  · 
    intro Q₁ Q₂ Δ hΔ hQ₁ hQ₂ hCond w₀ w₁ hw₀ hw₁
    have hBase₁ := hBallToBase Q₁ hQ₁ (fun w hw => (hCond w hw).1)
    have hBase₂ := hBallToBase Q₂ hQ₂ (fun w hw => (hCond w hw).2.1)
    exact le_trans
      (hTwoPotLip Q₁ Q₂ Δ hΔ hBase₁ hBase₂ (fun w hw => (hCond w hw).2.2) w₀ w₁ hw₀ hw₁)
      (mul_le_mul_of_nonneg_right hL_le_M hΔ)
  · 
    intro U Q hU hQ_cont hQ_holo hQ_ball z₀ z₁ hz₀ hz₁
    have hz₀_2rb : ‖z₀‖ ≤ 2 * r_b := by linarith
    have hz₁_2rb : ‖z₁‖ ≤ 2 * r_b := by linarith
    exact hUnifiedHolo U Q (fun _ => z₀) (fun _ => z₁)
      hU hQ_cont hQ_holo (differentiableOn_const z₀) (differentiableOn_const z₁)
      (fun p hp => by
        have hQp_cont : ContinuousOn (Q p) I :=
          hQ_cont.comp (continuous_const.prodMk continuous_id).continuousOn
            (fun w hw => ⟨hp, hw⟩)
        have hBase_p := hBallToBase (Q p) hQp_cont (hQ_ball p hp)
        have hOut := hSingleEnv (Q p) hBase_p z₀ z₁ hz₀_2rb hz₁_2rb
        exact ⟨hOut.1, hOut.2.2.2.2.2.1, hOut.2.2.2.2.2.2.2.2.2.2.2.1⟩)

theorem bivariate_hybrid_dslope_cauchy_and_param_holo : (∀ (r_b : ℝ) (N : ℂ → ℂ → ℂ),
      0 < r_b →
      DifferentiableOn ℂ (fun z : ℂ × ℂ => N z.1 z.2)
        (Metric.ball (0 : ℂ) (2 * r_b) ×ˢ Metric.ball (0 : ℂ) (2 * r_b)) →
      (∀ w₁ : ℂ, ‖w₁‖ < 2 * r_b → N 0 w₁ = 0) →
      (∀ w₀ : ℂ, ‖w₀‖ < 2 * r_b → N w₀ 0 = 0) →
      ∀ b₀ b₁ : ℂ, ‖b₀‖ < r_b / 2 → ‖b₁‖ < r_b / 2 →
        bivarHybridDiv N b₀ b₁ =
          (((2 * Real.pi) ^ 2 : ℝ) : ℂ)⁻¹ *
            ∫ θ₀ in (0 : ℝ)..(2 * Real.pi),
              ∫ θ₁ in (0 : ℝ)..(2 * Real.pi),
                N ((r_b : ℂ) * Complex.exp ((θ₀ : ℂ) * Complex.I))
                  ((r_b : ℂ) * Complex.exp ((θ₁ : ℂ) * Complex.I)) /
                (((r_b : ℂ) * Complex.exp ((θ₀ : ℂ) * Complex.I) - b₀) *
                  ((r_b : ℂ) * Complex.exp ((θ₁ : ℂ) * Complex.I) - b₁))) ∧
    (∀ (U : Set (ℂ × ℂ)) (G : (ℂ × ℂ) → ℝ → ℝ → ℂ),
      IsOpen U →
      ContinuousOn (fun x : (ℂ × ℂ) × ℝ × ℝ => G x.1 x.2.1 x.2.2)
        (U ×ˢ (Set.Icc (0 : ℝ) (2 * Real.pi) ×ˢ Set.Icc (0 : ℝ) (2 * Real.pi))) →
      (∀ θ₀ ∈ Set.Icc (0 : ℝ) (2 * Real.pi),
        ∀ θ₁ ∈ Set.Icc (0 : ℝ) (2 * Real.pi),
          DifferentiableOn ℂ (fun p => G p θ₀ θ₁) U) →
      DifferentiableOn ℂ
        (fun p =>
          ∫ θ₀ in (0 : ℝ)..(2 * Real.pi),
            ∫ θ₁ in (0 : ℝ)..(2 * Real.pi), G p θ₀ θ₁)
        U) ∧
    (∀ (F₁ F₂ : ℂ → ℂ → ℂ) (b₀ b₁ : ℂ),
      (∀ u v : ℂ, F₂ u v = F₁ (-v) (-u)) →
      bivarHybridDiv F₂ (-b₁) (-b₀) = bivarHybridDiv F₁ b₀ b₁) :=
by
  have hdslope_const_mul : ∀ (c : ℂ) (h : ℂ → ℂ) (u : ℂ),
      dslope (fun z => c * h z) 0 u = c * dslope h 0 u := by
    intro c h u
    by_cases hu : u = 0
    · subst hu
      simp only [dslope_same, deriv_const_mul_field]
    · simp only [dslope_of_ne _ hu, slope_def_field, sub_zero]
      ring

  have hdslope_comp_mul : ∀ (T : ℂ), T ≠ 0 → ∀ (h : ℂ → ℂ) (u : ℂ),
      dslope (fun z => h (T * z)) 0 u = T * dslope h 0 (T * u) := by
    intro T hT h u
    by_cases hu : u = 0
    · subst hu
      simp only [mul_zero, dslope_same, deriv_comp_mul_left, smul_eq_mul]
    · have hTu : T * u ≠ 0 := mul_ne_zero hT hu
      simp only [dslope_of_ne _ hu, dslope_of_ne _ hTu, slope_def_field, mul_zero, sub_zero]
      field_simp [hT, hu]

  have hbivar_dslope_scale : ∀ (T : ℂ), T ≠ 0 → ∀ (M : ℂ → ℂ → ℂ) (u₀ u₁ : ℂ),
      dslope (fun z₀ => dslope (fun z₁ => M (T * z₀) (T * z₁)) 0 u₁) 0 u₀ =
        T ^ 2 * dslope (fun w₀ => dslope (fun w₁ => M w₀ w₁) 0 (T * u₁)) 0 (T * u₀) := by
    intro T hT M u₀ u₁
    have h_inner : (fun z₀ => dslope (fun z₁ => M (T * z₀) (T * z₁)) 0 u₁) =
        (fun z₀ => T * dslope (fun w₁ => M (T * z₀) w₁) 0 (T * u₁)) := by
      funext z₀
      exact hdslope_comp_mul T hT (fun w₁ => M (T * z₀) w₁) u₁
    rw [h_inner, hdslope_const_mul T,
      hdslope_comp_mul T hT (fun w₀ => dslope (fun w₁ => M w₀ w₁) 0 (T * u₁)) u₀]
    ring

  have h_swap_order : ∀ (A B : ℂ → ℂ → ℂ),
      (∀ u v : ℂ, B u v = A (-v) (-u)) →
      ∀ b₀ b₁ : ℂ,
        dslope (fun z₀ => dslope (fun z₁ => B z₀ z₁) 0 (-b₀)) 0 (-b₁) =
          dslope (fun w₁ => dslope (fun w₀ => A w₀ w₁) 0 b₀) 0 b₁ := by
    intro A B hAB b₀ b₁
    have h_fn : (fun z₀ => dslope (fun z₁ => B z₀ z₁) 0 (-b₀)) =
        (fun z₀ => dslope (fun z₁ => A ((-1 : ℂ) * z₁) ((-1 : ℂ) * z₀)) 0 (-b₀)) := by
      funext z₀
      congr 1
      funext z₁
      simp [hAB z₀ z₁]
    rw [h_fn, hbivar_dslope_scale (-1) (by norm_num) (fun w₁ w₀ => A w₀ w₁) (-b₁) (-b₀)]
    have h1 : (-1 : ℂ) * -b₀ = b₀ := by ring
    have h2 : (-1 : ℂ) * -b₁ = b₁ := by ring
    rw [h1, h2]
    ring

  have hBivarRev : ∀ (F₁ F₂ : ℂ → ℂ → ℂ) (b₀ b₁ : ℂ),
      (∀ u v : ℂ, F₂ u v = F₁ (-v) (-u)) →
      bivarHybridDiv F₂ (-b₁) (-b₀) = bivarHybridDiv F₁ b₀ b₁ := by
    intro F₁ F₂ b₀ b₁ hF
    have hF_symm : ∀ u v : ℂ, F₁ u v = F₂ (-v) (-u) := by
      intro u v
      rw [hF (-v) (-u), neg_neg, neg_neg]
    dsimp only [bivarHybridDiv]
    split_ifs with h_nz' h_nz h_nz
    · rw [hF (-b₁) (-b₀), neg_neg, neg_neg]
      ring
    · exact False.elim (h_nz ⟨neg_ne_zero.mp h_nz'.2, neg_ne_zero.mp h_nz'.1⟩)
    · exact False.elim (h_nz' ⟨neg_ne_zero.mpr h_nz.2, neg_ne_zero.mpr h_nz.1⟩)
    · have h_t1 := h_swap_order F₁ F₂ hF b₀ b₁
      have h_t2 := (h_swap_order F₂ F₁ hF_symm (-b₁) (-b₀)).symm
      simp only [neg_neg] at h_t2
      rw [h_t1, h_t2, add_comm]

  let J : Set ℝ := Set.Icc (0 : ℝ) (2 * Real.pi)
  have h2pi_pos : (0 : ℝ) < 2 * Real.pi := by positivity
  have huIcc : Set.uIcc (0 : ℝ) (2 * Real.pi) = J := Set.uIcc_of_le h2pi_pos.le
  have huIoc_sub : Set.uIoc (0 : ℝ) (2 * Real.pi) ⊆ J :=
    huIcc ▸ Set.uIoc_subset_uIcc

  have hParamHolo1D : ∀ {W : Set (ℂ × ℂ)} {H : (ℂ × ℂ) → ℝ → ℂ},
      IsOpen W →
      ContinuousOn (fun q : (ℂ × ℂ) × ℝ => H q.1 q.2) (W ×ˢ J) →
      (∀ θ ∈ J, DifferentiableOn ℂ (fun p => H p θ) W) →
      DifferentiableOn ℂ (fun p => ∫ θ in (0 : ℝ)..(2 * Real.pi), H p θ) W := by
    let π₁ : (ℂ × ℂ) →L[ℂ] ℂ :=
      { toLinearMap :=
          { toFun := Prod.fst
            map_add' := fun _ _ => rfl
            map_smul' := fun _ _ => rfl }
        cont := continuous_fst }
    let π₂ : (ℂ × ℂ) →L[ℂ] ℂ :=
      { toLinearMap :=
          { toFun := Prod.snd
            map_add' := fun _ _ => rfl
            map_smul' := fun _ _ => rfl }
        cont := continuous_snd }
    let e₁ : ℂ →L[ℂ] (ℂ × ℂ) :=
      { toLinearMap :=
          { toFun := fun u => (u, 0)
            map_add' := fun _ _ => by ext <;> simp
            map_smul' := fun _ _ => by ext <;> simp }
        cont := continuous_id.prodMk continuous_const }
    let e₂ : ℂ →L[ℂ] (ℂ × ℂ) :=
      { toLinearMap :=
          { toFun := fun u => (0, u)
            map_add' := fun _ _ => by ext <;> simp
            map_smul' := fun _ _ => by ext <;> simp }
        cont := continuous_const.prodMk continuous_id }

    have hfderiv_decomp : ∀ {g : ℂ × ℂ → ℂ} {L : (ℂ × ℂ) →L[ℂ] ℂ} {q : ℂ × ℂ},
        HasFDerivAt g L q →
        HasDerivAt (fun u : ℂ => g (u, q.2)) (L (1, 0)) q.1 ∧
        HasDerivAt (fun u : ℂ => g (q.1, u)) (L (0, 1)) q.2 ∧
        L = π₁.smulRight (deriv (fun u : ℂ => g (u, q.2)) q.1) +
          π₂.smulRight (deriv (fun u : ℂ => g (q.1, u)) q.2) := by
      intro g L q hg
      have hemb₁ : HasFDerivAt (fun u : ℂ => (u, q.2)) e₁ q.1 := by
        have h_eq : (fun u : ℂ => (u, q.2)) = (fun u : ℂ => e₁ u + (0, q.2)) := by
          ext u <;> simp [e₁]
        rw [h_eq]
        exact e₁.hasFDerivAt.add_const (0, q.2)
      have hemb₂ : HasFDerivAt (fun u : ℂ => (q.1, u)) e₂ q.2 := by
        have h_eq : (fun u : ℂ => (q.1, u)) = (fun u : ℂ => e₂ u + (q.1, 0)) := by
          ext u <;> simp [e₂]
        rw [h_eq]
        exact e₂.hasFDerivAt.add_const (q.1, 0)
      have hd₁ : HasDerivAt (fun u : ℂ => g (u, q.2)) (L (1, 0)) q.1 :=
        (hg.comp q.1 hemb₁).hasDerivAt
      have hd₂ : HasDerivAt (fun u : ℂ => g (q.1, u)) (L (0, 1)) q.2 :=
        (hg.comp q.2 hemb₂).hasDerivAt
      refine ⟨hd₁, hd₂, ?_⟩
      rw [hd₁.deriv, hd₂.deriv]
      apply ContinuousLinearMap.ext
      intro v
      have hv_eq : v = v.1 • ((1 : ℂ), (0 : ℂ)) + v.2 • ((0 : ℂ), (1 : ℂ)) := by
        ext <;> simp
      calc L v = L (v.1 • ((1 : ℂ), (0 : ℂ)) + v.2 • ((0 : ℂ), (1 : ℂ))) := by rw [← hv_eq]
        _ = v.1 • L (1, 0) + v.2 • L (0, 1) := by rw [map_add, map_smul, map_smul]
        _ = (π₁.smulRight (L (1, 0)) + π₂.smulRight (L (0, 1))) v := rfl

    have hCauchy2D : ∀ {W : Set (ℂ × ℂ)} {g : ℂ × ℂ → ℂ} {q₀ : ℂ × ℂ} {r C : ℝ},
        IsOpen W →
        DifferentiableOn ℂ g W →
        0 < r →
        0 ≤ C →
        Metric.closedBall q₀ (2 * r) ⊆ W →
        (∀ x ∈ Metric.closedBall q₀ (2 * r), ‖g x‖ ≤ C) →
        ∀ q ∈ Metric.ball q₀ r, ‖fderiv ℂ g q‖ ≤ 2 * C / r := by
      intro W g q₀ r C hW hg hr hC0 hsub hbnd q hq
      have hq_dist : ‖q - q₀‖ < r := by simpa [dist_eq_norm] using Metric.mem_ball.mp hq
      have hq_mem : q ∈ W := hsub (Metric.mem_closedBall.mpr
        (by rw [dist_eq_norm]; linarith))
      have hg_at : HasFDerivAt g (fderiv ℂ g q) q :=
        (hg.differentiableAt (hW.mem_nhds hq_mem)).hasFDerivAt
      obtain ⟨_, _, hL_eq⟩ := hfderiv_decomp hg_at
      have hslice₁_sub : ∀ u ∈ Metric.closedBall q.1 r, (u, q.2) ∈ Metric.closedBall q₀ (2 * r) := by
        intro u hu
        have hu_r : ‖u - q.1‖ ≤ r := by simpa [dist_eq_norm] using Metric.mem_closedBall.mp hu
        rw [Metric.mem_closedBall, dist_eq_norm, Prod.norm_def]
        refine max_le ?_ ?_
        · calc ‖u - q₀.1‖ = ‖(u - q.1) + (q.1 - q₀.1)‖ := by ring_nf
            _ ≤ ‖u - q.1‖ + ‖q.1 - q₀.1‖ := norm_add_le _ _
            _ ≤ r + ‖q - q₀‖ := by
                refine add_le_add hu_r ?_
                rw [Prod.norm_def]
                exact le_max_left _ _
            _ ≤ 2 * r := by linarith
        · calc ‖q.2 - q₀.2‖ ≤ ‖q - q₀‖ := by rw [Prod.norm_def]; exact le_max_right _ _
            _ ≤ 2 * r := by linarith
      have hslice₂_sub : ∀ u ∈ Metric.closedBall q.2 r, (q.1, u) ∈ Metric.closedBall q₀ (2 * r) := by
        intro u hu
        have hu_r : ‖u - q.2‖ ≤ r := by simpa [dist_eq_norm] using Metric.mem_closedBall.mp hu
        rw [Metric.mem_closedBall, dist_eq_norm, Prod.norm_def]
        refine max_le ?_ ?_
        · calc ‖q.1 - q₀.1‖ ≤ ‖q - q₀‖ := by rw [Prod.norm_def]; exact le_max_left _ _
            _ ≤ 2 * r := by linarith
        · calc ‖u - q₀.2‖ = ‖(u - q.2) + (q.2 - q₀.2)‖ := by ring_nf
            _ ≤ ‖u - q.2‖ + ‖q.2 - q₀.2‖ := norm_add_le _ _
            _ ≤ r + ‖q - q₀‖ := by
                refine add_le_add hu_r ?_
                rw [Prod.norm_def]
                exact le_max_right _ _
            _ ≤ 2 * r := by linarith
      have hd₁_le : ‖deriv (fun u : ℂ => g (u, q.2)) q.1‖ ≤ C / r := by
        have hdiff₁ : DifferentiableOn ℂ (fun u : ℂ => g (u, q.2)) (Metric.closedBall q.1 r) := by
          have hemb_diff : Differentiable ℂ (fun u : ℂ => (u, q.2)) := fun u => by
            have h_eq : (fun z : ℂ => (z, q.2)) = (fun z : ℂ => e₁ z + (0, q.2)) := by
              ext z <;> simp [e₁]
            rw [h_eq]
            exact (e₁.hasFDerivAt.add_const (0, q.2)).differentiableAt
          exact hg.comp hemb_diff.differentiableOn (fun u hu => hsub (hslice₁_sub u hu))
        exact Complex.norm_deriv_le_of_forall_mem_sphere_norm_le hr
          (hdiff₁.diffContOnCl_ball Subset.rfl)
          (fun u hu => hbnd (u, q.2) (hslice₁_sub u (Metric.sphere_subset_closedBall hu)))
      have hd₂_le : ‖deriv (fun u : ℂ => g (q.1, u)) q.2‖ ≤ C / r := by
        have hdiff₂ : DifferentiableOn ℂ (fun u : ℂ => g (q.1, u)) (Metric.closedBall q.2 r) := by
          have hemb_diff : Differentiable ℂ (fun u : ℂ => (q.1, u)) := fun u => by
            have h_eq : (fun z : ℂ => (q.1, z)) = (fun z : ℂ => e₂ z + (q.1, 0)) := by
              ext z <;> simp [e₂]
            rw [h_eq]
            exact (e₂.hasFDerivAt.add_const (q.1, 0)).differentiableAt
          exact hg.comp hemb_diff.differentiableOn (fun u hu => hsub (hslice₂_sub u hu))
        exact Complex.norm_deriv_le_of_forall_mem_sphere_norm_le hr
          (hdiff₂.diffContOnCl_ball Subset.rfl)
          (fun u hu => hbnd (q.1, u) (hslice₂_sub u (Metric.sphere_subset_closedBall hu)))
      refine ContinuousLinearMap.opNorm_le_bound _ (by positivity) (fun v => ?_)
      have hv₁ : ‖v.1‖ ≤ ‖v‖ := by rw [Prod.norm_def]; exact le_max_left _ _
      have hv₂ : ‖v.2‖ ≤ ‖v‖ := by rw [Prod.norm_def]; exact le_max_right _ _
      calc ‖fderiv ℂ g q v‖
          = ‖v.1 * deriv (fun u : ℂ => g (u, q.2)) q.1 +
              v.2 * deriv (fun u : ℂ => g (q.1, u)) q.2‖ := by
            rw [hL_eq]
            rfl
        _ ≤ ‖v.1 * deriv (fun u : ℂ => g (u, q.2)) q.1‖ +
              ‖v.2 * deriv (fun u : ℂ => g (q.1, u)) q.2‖ := norm_add_le _ _
        _ = ‖v.1‖ * ‖deriv (fun u : ℂ => g (u, q.2)) q.1‖ +
              ‖v.2‖ * ‖deriv (fun u : ℂ => g (q.1, u)) q.2‖ := by rw [norm_mul, norm_mul]
        _ ≤ ‖v‖ * (C / r) + ‖v‖ * (C / r) :=
            add_le_add (mul_le_mul hv₁ hd₁_le (norm_nonneg _) (norm_nonneg _))
              (mul_le_mul hv₂ hd₂_le (norm_nonneg _) (norm_nonneg _))
        _ = (2 * C / r) * ‖v‖ := by ring

    intro W H hW hH_cont hH_holo p₀ hp₀
    obtain ⟨R₀, hR₀_pos, hball_R₀⟩ := Metric.isOpen_iff.mp hW p₀ hp₀
    let r : ℝ := R₀ / 3
    have hr : 0 < r := by positivity
    have hcb_sub : Metric.closedBall p₀ (2 * r) ⊆ W := by
      refine Subset.trans (Metric.closedBall_subset_ball ?_) hball_R₀
      dsimp [r]
      linarith
    have hball_sub : Metric.ball p₀ r ⊆ W :=
      Subset.trans (Metric.ball_subset_closedBall.trans
        (Metric.closedBall_subset_closedBall (by linarith))) hcb_sub
    let K : Set ((ℂ × ℂ) × ℝ) := Metric.closedBall p₀ (2 * r) ×ˢ J
    have hK_sub : K ⊆ W ×ˢ J := Set.prod_mono_left hcb_sub
    have hK_comp : IsCompact K := (isCompact_closedBall p₀ (2 * r)).prod isCompact_Icc
    have hK_ne : K.Nonempty :=
      ⟨(p₀, 0), Metric.mem_closedBall_self (by positivity), ⟨le_rfl, h2pi_pos.le⟩⟩
    obtain ⟨p_max, _, hp_max⟩ := hK_comp.exists_isMaxOn hK_ne
      (continuous_norm.comp_continuousOn (hH_cont.mono hK_sub))
    let C : ℝ := ‖H p_max.1 p_max.2‖
    have hC0 : 0 ≤ C := norm_nonneg _
    have hHbnd : ∀ p ∈ Metric.closedBall p₀ (2 * r), ∀ θ ∈ J, ‖H p θ‖ ≤ C :=
      fun p hp θ hθ => hp_max (show (p, θ) ∈ K from ⟨hp, hθ⟩)
    have hHp_cont : ∀ p ∈ W, ContinuousOn (H p) J :=
      fun p hp => hH_cont.comp (continuous_const.prodMk continuous_id).continuousOn
        (fun θ hθ => ⟨hp, hθ⟩)
    let H' : (ℂ × ℂ) → ℝ → ((ℂ × ℂ) →L[ℂ] ℂ) :=
      fun p θ => fderiv ℂ (fun q => H q θ) p
    have hH'p₀_meas : MeasureTheory.AEStronglyMeasurable (H' p₀)
        (MeasureTheory.volume.restrict (Set.uIoc 0 (2 * Real.pi))) := by
      let δ : ℕ → ℂ := fun n => ((r / ((n : ℝ) + 2) : ℝ) : ℂ)
      have hδ_pos : ∀ n : ℕ, 0 < r / ((n : ℝ) + 2) := fun n => by positivity
      have hδ_lt : ∀ n : ℕ, r / ((n : ℝ) + 2) < r := by
        intro n
        have hden : (1 : ℝ) < (n : ℝ) + 2 := by linarith [Nat.cast_nonneg (α := ℝ) n]
        exact div_lt_self hr hden
      have hδ_ne : ∀ n : ℕ, δ n ≠ 0 :=
        fun n => Complex.ofReal_ne_zero.mpr (hδ_pos n).ne'
      have hδ_norm : ∀ n : ℕ, ‖δ n‖ < r := by
        intro n
        rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos (hδ_pos n)]
        exact hδ_lt n
      have hδ_tendsto : Filter.Tendsto δ Filter.atTop (nhdsWithin 0 {0}ᶜ) := by
        have h_real : Filter.Tendsto (fun n : ℕ => r / ((n : ℝ) + 2))
            Filter.atTop (nhds 0) := by
          have h_atTop : Filter.Tendsto (fun n : ℕ => (n : ℝ) + 2)
              Filter.atTop Filter.atTop :=
            tendsto_natCast_atTop_atTop.atTop_add tendsto_const_nhds
          simpa using tendsto_const_nhds.div_atTop h_atTop
        have h_c : Filter.Tendsto δ Filter.atTop (nhds 0) := by
          have h := (Complex.continuous_ofReal.tendsto 0).comp h_real
          rw [Complex.ofReal_zero] at h
          exact h
        exact tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within _ h_c
          (Filter.Eventually.of_forall hδ_ne)
      have hp₁_mem : ∀ n : ℕ, (p₀.1 + δ n, p₀.2) ∈ W := by
        intro n
        apply hball_sub
        rw [Metric.mem_ball, dist_eq_norm, Prod.norm_def]
        simp [hδ_norm n]
      have hp₂_mem : ∀ n : ℕ, (p₀.1, p₀.2 + δ n) ∈ W := by
        intro n
        apply hball_sub
        rw [Metric.mem_ball, dist_eq_norm, Prod.norm_def]
        simp [hδ_norm n]
      let dq₁ : ℕ → ℝ → ℂ := fun n θ => (δ n)⁻¹ * (H (p₀.1 + δ n, p₀.2) θ - H p₀ θ)
      let dq₂ : ℕ → ℝ → ℂ := fun n θ => (δ n)⁻¹ * (H (p₀.1, p₀.2 + δ n) θ - H p₀ θ)
      let L_seq : ℕ → ℝ → ((ℂ × ℂ) →L[ℂ] ℂ) := fun n θ =>
        ContinuousLinearMap.smulRightL ℂ (ℂ × ℂ) ℂ π₁ (dq₁ n θ) +
          ContinuousLinearMap.smulRightL ℂ (ℂ × ℂ) ℂ π₂ (dq₂ n θ)
      have hL_meas : ∀ n : ℕ, MeasureTheory.AEStronglyMeasurable (L_seq n)
          (MeasureTheory.volume.restrict (Set.uIoc 0 (2 * Real.pi))) := by
        intro n
        have hdq₁_c : ContinuousOn (dq₁ n) J :=
          continuousOn_const.mul ((hHp_cont _ (hp₁_mem n)).sub (hHp_cont p₀ hp₀))
        have hdq₂_c : ContinuousOn (dq₂ n) J :=
          continuousOn_const.mul ((hHp_cont _ (hp₂_mem n)).sub (hHp_cont p₀ hp₀))
        have hL_c : ContinuousOn (L_seq n) J :=
          ((ContinuousLinearMap.smulRightL ℂ (ℂ × ℂ) ℂ π₁).continuous.comp_continuousOn
            hdq₁_c).add
          ((ContinuousLinearMap.smulRightL ℂ (ℂ × ℂ) ℂ π₂).continuous.comp_continuousOn
            hdq₂_c)
        exact (hL_c.mono huIoc_sub).aestronglyMeasurable measurableSet_uIoc
      have hL_lim : ∀ᵐ θ ∂(MeasureTheory.volume.restrict (Set.uIoc 0 (2 * Real.pi))),
          Filter.Tendsto (fun n => L_seq n θ) Filter.atTop (nhds (H' p₀ θ)) := by
        filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_uIoc] with θ hθ
        have hθ_J : θ ∈ J := huIoc_sub hθ
        have hg_at : HasFDerivAt (fun q => H q θ) (H' p₀ θ) p₀ :=
          ((hH_holo θ hθ_J).differentiableAt (hW.mem_nhds hp₀)).hasFDerivAt
        obtain ⟨hd₁, hd₂, hL_eq⟩ := hfderiv_decomp hg_at
        rw [hd₁.deriv, hd₂.deriv] at hL_eq
        have ht₁ : Filter.Tendsto (fun n => dq₁ n θ) Filter.atTop
            (nhds (H' p₀ θ (1, 0))) :=
          (hasDerivAt_iff_tendsto_slope_zero.mp hd₁).comp hδ_tendsto
        have ht₂ : Filter.Tendsto (fun n => dq₂ n θ) Filter.atTop
            (nhds (H' p₀ θ (0, 1))) :=
          (hasDerivAt_iff_tendsto_slope_zero.mp hd₂).comp hδ_tendsto
        rw [hL_eq]
        exact (((ContinuousLinearMap.smulRightL ℂ (ℂ × ℂ) ℂ π₁).continuous.tendsto _).comp
          ht₁).add
          (((ContinuousLinearMap.smulRightL ℂ (ℂ × ℂ) ℂ π₂).continuous.tendsto _).comp ht₂)
      exact aestronglyMeasurable_of_tendsto_ae Filter.atTop hL_meas hL_lim
    have hFDeriv : HasFDerivAt (fun p => ∫ θ in (0 : ℝ)..(2 * Real.pi), H p θ)
        (∫ θ in (0 : ℝ)..(2 * Real.pi), H' p₀ θ) p₀ := by
      apply intervalIntegral.hasFDerivAt_integral_of_dominated_of_fderiv_le
        (𝕜 := ℂ) (s := Metric.ball p₀ r) (bound := fun _ => 2 * C / r)
        (Metric.ball_mem_nhds p₀ hr)
      · filter_upwards [Metric.ball_mem_nhds p₀ hr] with p hp
        exact ((hHp_cont p (hball_sub hp)).mono huIoc_sub).aestronglyMeasurable
          measurableSet_uIoc
      · exact ((hHp_cont p₀ hp₀).mono (le_of_eq huIcc)).intervalIntegrable
      · exact hH'p₀_meas
      · refine Filter.Eventually.of_forall (fun θ hθ p hp => ?_)
        exact hCauchy2D hW (hH_holo θ (huIoc_sub hθ)) hr hC0 hcb_sub
          (fun x hx => hHbnd x hx θ (huIoc_sub hθ)) p hp
      · exact intervalIntegrable_const
      · refine Filter.Eventually.of_forall (fun θ hθ p hp => ?_)
        exact ((hH_holo θ (huIoc_sub hθ)).differentiableAt
          (hW.mem_nhds (hball_sub hp))).hasFDerivAt
    exact hFDeriv.differentiableAt.differentiableWithinAt

  have hDoubleHolo : ∀ (U : Set (ℂ × ℂ)) (G : (ℂ × ℂ) → ℝ → ℝ → ℂ),
      IsOpen U →
      ContinuousOn (fun x : (ℂ × ℂ) × ℝ × ℝ => G x.1 x.2.1 x.2.2)
        (U ×ˢ (Set.Icc (0 : ℝ) (2 * Real.pi) ×ˢ Set.Icc (0 : ℝ) (2 * Real.pi))) →
      (∀ θ₀ ∈ Set.Icc (0 : ℝ) (2 * Real.pi),
        ∀ θ₁ ∈ Set.Icc (0 : ℝ) (2 * Real.pi),
          DifferentiableOn ℂ (fun p => G p θ₀ θ₁) U) →
      DifferentiableOn ℂ
        (fun p =>
          ∫ θ₀ in (0 : ℝ)..(2 * Real.pi),
            ∫ θ₁ in (0 : ℝ)..(2 * Real.pi), G p θ₀ θ₁)
        U := by
    intro U G hU hG_cont hG_holo
    let I₁ : (ℂ × ℂ) → ℝ → ℂ :=
      fun p θ₀ => ∫ θ₁ in (0 : ℝ)..(2 * Real.pi), G p θ₀ θ₁
    have hI₁_holo : ∀ θ₀ ∈ J, DifferentiableOn ℂ (fun p => I₁ p θ₀) U := by
      intro θ₀ hθ₀
      have hSlice_cont : ContinuousOn (fun q : (ℂ × ℂ) × ℝ => G q.1 θ₀ q.2) (U ×ˢ J) := by
        have hψ : Continuous (fun q : (ℂ × ℂ) × ℝ => (q.1, (θ₀, q.2))) :=
          continuous_fst.prodMk (continuous_const.prodMk continuous_snd)
        exact hG_cont.comp hψ.continuousOn (fun q hq => ⟨hq.1, hθ₀, hq.2⟩)
      exact hParamHolo1D hU hSlice_cont (fun θ₁ hθ₁ => hG_holo θ₀ hθ₀ θ₁ hθ₁)
    have hI₁_cont : ContinuousOn (fun q : (ℂ × ℂ) × ℝ => I₁ q.1 q.2) (U ×ˢ J) := by
      let clamp : ℝ → ℝ := fun t => max 0 (min (2 * Real.pi) t)
      have hclamp_cont : Continuous clamp :=
        continuous_const.max (continuous_const.min continuous_id)
      have hclamp_mem : ∀ t : ℝ, clamp t ∈ J :=
        fun t => ⟨le_max_left 0 _, max_le h2pi_pos.le (min_le_left (2 * Real.pi) t)⟩
      have hclamp_id : ∀ t ∈ J, clamp t = t := by
        intro t ht
        dsimp [clamp]
        rw [min_eq_right ht.2, max_eq_right ht.1]
      let S_dom : Set ((ℂ × ℂ) × ℝ) := U ×ˢ J
      let g_cl : ↥S_dom → ℝ → ℂ := fun x t => G x.1.1 x.1.2 (clamp t)
      have h_uncurry : Continuous (Function.uncurry g_cl) := by
        have hφ_cont : Continuous (fun y : ↥S_dom × ℝ => (y.1.1.1, (y.1.1.2, clamp y.2))) :=
          (continuous_fst.comp (continuous_subtype_val.comp continuous_fst)).prodMk
            ((continuous_snd.comp (continuous_subtype_val.comp continuous_fst)).prodMk
              (hclamp_cont.comp continuous_snd))
        exact hG_cont.comp_continuous hφ_cont
          (fun y => ⟨y.1.2.1, y.1.2.2, hclamp_mem y.2⟩)
      have h_int_cl : Continuous (fun x : ↥S_dom => ∫ t in (0 : ℝ)..(2 * Real.pi), g_cl x t) :=
        intervalIntegral.continuous_parametric_intervalIntegral_of_continuous'
          h_uncurry 0 (2 * Real.pi)
      have hcl_on : ContinuousOn
          (fun q : (ℂ × ℂ) × ℝ => ∫ t in (0 : ℝ)..(2 * Real.pi), G q.1 q.2 (clamp t)) S_dom :=
        continuousOn_iff_continuous_domRestrict.mpr h_int_cl
      refine hcl_on.congr (fun q _ => ?_)
      refine intervalIntegral.integral_congr (fun t ht => ?_)
      have ht_J : t ∈ J := huIcc ▸ ht
      rw [hclamp_id t ht_J]
    exact hParamHolo1D hU hI₁_cont hI₁_holo

  have hCauchy : ∀ (r_b : ℝ) (N : ℂ → ℂ → ℂ),
      0 < r_b →
      DifferentiableOn ℂ (fun z : ℂ × ℂ => N z.1 z.2)
        (Metric.ball (0 : ℂ) (2 * r_b) ×ˢ Metric.ball (0 : ℂ) (2 * r_b)) →
      (∀ w₁ : ℂ, ‖w₁‖ < 2 * r_b → N 0 w₁ = 0) →
      (∀ w₀ : ℂ, ‖w₀‖ < 2 * r_b → N w₀ 0 = 0) →
      ∀ b₀ b₁ : ℂ, ‖b₀‖ < r_b / 2 → ‖b₁‖ < r_b / 2 →
        bivarHybridDiv N b₀ b₁ =
          (((2 * Real.pi) ^ 2 : ℝ) : ℂ)⁻¹ *
            ∫ θ₀ in (0 : ℝ)..(2 * Real.pi),
              ∫ θ₁ in (0 : ℝ)..(2 * Real.pi),
                N ((r_b : ℂ) * Complex.exp ((θ₀ : ℂ) * Complex.I))
                  ((r_b : ℂ) * Complex.exp ((θ₁ : ℂ) * Complex.I)) /
                (((r_b : ℂ) * Complex.exp ((θ₀ : ℂ) * Complex.I) - b₀) *
                  ((r_b : ℂ) * Complex.exp ((θ₁ : ℂ) * Complex.I) - b₁)) := by
    intro r_b N hrb hN_holo hN_zero₁ hN_zero₀ b₀ b₁ hb₀ hb₁
    let z_c : ℝ → ℂ := fun θ => (r_b : ℂ) * Complex.exp ((θ : ℂ) * Complex.I)
    have hz_c_eq : ∀ θ : ℝ, circleMap 0 r_b θ = z_c θ := fun θ => circleMap_zero r_b θ
    have hz_c_cont : Continuous z_c := by
      have h_eq : z_c = circleMap 0 r_b := funext fun θ => (hz_c_eq θ).symm
      rw [h_eq]
      exact continuous_circleMap 0 r_b
    have hz_c_norm : ∀ θ : ℝ, ‖z_c θ‖ = r_b := by
      intro θ
      rw [← hz_c_eq θ, norm_circleMap_zero, abs_of_pos hrb]
    have hz_c_ne : ∀ θ : ℝ, z_c θ ≠ 0 :=
      fun θ => norm_ne_zero_iff.mp (by rw [hz_c_norm θ]; exact hrb.ne')
    have hz_c_lt : ∀ θ : ℝ, ‖z_c θ‖ < 2 * r_b :=
      fun θ => by rw [hz_c_norm θ]; linarith
    have hz_c_sub_ne : ∀ {u : ℂ}, ‖u‖ < r_b → ∀ θ : ℝ, z_c θ - u ≠ 0 := by
      intro u hu θ h_eq
      have h1 : z_c θ = u := sub_eq_zero.mp h_eq
      have h2 : r_b = ‖u‖ := by rw [← hz_c_norm θ, h1]
      linarith
    have h2pi_c_ne : ((2 * Real.pi : ℝ) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr h2pi_pos.ne'
    have h_pi_cast : (((2 * Real.pi : ℝ) : ℂ)⁻¹) ^ 2 = (((2 * Real.pi) ^ 2 : ℝ) : ℂ)⁻¹ := by
      push_cast
      rw [inv_pow]

    have hdslope_circle : ∀ {h : ℂ → ℂ} {R : ℝ} {b : ℂ},
        r_b < R →
        DifferentiableOn ℂ h (Metric.ball (0 : ℂ) R) →
        h 0 = 0 →
        ‖b‖ < r_b →
        dslope h 0 b =
          ((2 * Real.pi : ℝ) : ℂ)⁻¹ *
            ∫ θ in (0 : ℝ)..(2 * Real.pi), h (z_c θ) / (z_c θ - b) := by
      intro h R b hrR hh hh0 hb
      have hR_pos : 0 < R := lt_trans hrb hrR
      have h_dsl : DifferentiableOn ℂ (dslope h 0) (Metric.ball (0 : ℂ) R) :=
        (Complex.differentiableOn_dslope (Metric.ball_mem_nhds 0 hR_pos)).mpr hh
      have h_dsl_cb : DifferentiableOn ℂ (dslope h 0) (Metric.closedBall (0 : ℂ) r_b) :=
        h_dsl.mono (Metric.closedBall_subset_ball hrR)
      have hc := h_dsl_cb.circleIntegral_sub_inv_smul
        (by simpa [Metric.mem_ball, dist_zero_right] using hb)
      unfold circleIntegral at hc
      have h_int_eq : ∀ θ : ℝ,
          deriv (circleMap 0 r_b) θ • ((circleMap 0 r_b θ - b)⁻¹ • dslope h 0 (circleMap 0 r_b θ)) =
            Complex.I * (h (z_c θ) / (z_c θ - b)) := by
        intro θ
        rw [deriv_circleMap, hz_c_eq θ, smul_eq_mul, smul_eq_mul,
          dslope_of_ne h (hz_c_ne θ), slope_def_field, hh0, sub_zero, sub_zero]
        have h_sub_ne : z_c θ - b ≠ 0 := hz_c_sub_ne hb θ
        field_simp [hz_c_ne θ, h_sub_ne]
      simp_rw [h_int_eq] at hc
      rw [intervalIntegral.integral_const_mul Complex.I, smul_eq_mul] at hc
      have h2piI_ne : (2 : ℂ) * (Real.pi : ℂ) * Complex.I ≠ 0 :=
        mul_ne_zero (mul_ne_zero two_ne_zero (Complex.ofReal_ne_zero.mpr Real.pi_pos.ne'))
          Complex.I_ne_zero
      apply mul_left_cancel₀ h2piI_ne
      calc (2 : ℂ) * (Real.pi : ℂ) * Complex.I * dslope h 0 b
          = Complex.I * ∫ θ in (0 : ℝ)..(2 * Real.pi), h (z_c θ) / (z_c θ - b) := hc.symm
        _ = (2 : ℂ) * (Real.pi : ℂ) * Complex.I *
              (((2 * Real.pi : ℝ) : ℂ)⁻¹ *
                ∫ θ in (0 : ℝ)..(2 * Real.pi), h (z_c θ) / (z_c θ - b)) := by
            push_cast
            field_simp [h2pi_c_ne]

    let U_b : Set (ℂ × ℂ) := Metric.ball (0 : ℂ) (r_b / 2) ×ˢ Metric.ball (0 : ℂ) (r_b / 2)
    have hUb_open : IsOpen U_b := Metric.isOpen_ball.prod Metric.isOpen_ball

    have hIterDslope : ∀ (M : ℂ → ℂ → ℂ),
        DifferentiableOn ℂ (fun z : ℂ × ℂ => M z.1 z.2)
          (Metric.ball (0 : ℂ) (2 * r_b) ×ˢ Metric.ball (0 : ℂ) (2 * r_b)) →
        (∀ w₁ : ℂ, ‖w₁‖ < 2 * r_b → M 0 w₁ = 0) →
        (∀ w₀ : ℂ, ‖w₀‖ < 2 * r_b → M w₀ 0 = 0) →
        (∀ u₀ u₁ : ℂ, ‖u₀‖ < 2 * r_b → ‖u₁‖ < 2 * r_b →
          u₀ * u₁ * dslope (fun w₀ => dslope (fun w₁ => M w₀ w₁) 0 u₁) 0 u₀ = M u₀ u₁) ∧
        (∀ u₀ u₁ : ℂ, ‖u₀‖ < r_b / 2 → ‖u₁‖ < r_b / 2 →
          dslope (fun w₀ => dslope (fun w₁ => M w₀ w₁) 0 u₁) 0 u₀ =
            (((2 * Real.pi) ^ 2 : ℝ) : ℂ)⁻¹ *
              ∫ θ₀ in (0 : ℝ)..(2 * Real.pi),
                ∫ θ₁ in (0 : ℝ)..(2 * Real.pi),
                  M (z_c θ₀) (z_c θ₁) / ((z_c θ₀ - u₀) * (z_c θ₁ - u₁))) ∧
        DifferentiableOn ℂ
          (fun p : ℂ × ℂ => dslope (fun w₀ => dslope (fun w₁ => M w₀ w₁) 0 p.2) 0 p.1) U_b := by
      intro M hM_holo hM_zero₁ hM_zero₀
      have h0_lt : ‖(0 : ℂ)‖ < 2 * r_b := by simp [hrb]
      have hG0_vanish : ∀ u₁ : ℂ, ‖u₁‖ < 2 * r_b →
          dslope (fun w₁ => M 0 w₁) 0 u₁ = 0 := by
        intro u₁ hu₁
        by_cases hu₁0 : u₁ = 0
        · subst hu₁0
          rw [dslope_same]
          have h_ev : (fun w₁ : ℂ => M 0 w₁) =ᶠ[nhds (0 : ℂ)] (fun _ => (0 : ℂ)) := by
            filter_upwards [Metric.ball_mem_nhds (0 : ℂ) (by positivity : 0 < 2 * r_b)] with w₁ hw₁
            exact hM_zero₁ w₁ (by simpa [Metric.mem_ball, dist_zero_right] using hw₁)
          rw [h_ev.deriv_eq, deriv_const]
        · rw [dslope_of_ne _ hu₁0, slope_def_field, hM_zero₁ u₁ hu₁, hM_zero₁ 0 h0_lt]
          simp
      have hProd : ∀ u₀ u₁ : ℂ, ‖u₀‖ < 2 * r_b → ‖u₁‖ < 2 * r_b →
          u₀ * u₁ * dslope (fun w₀ => dslope (fun w₁ => M w₀ w₁) 0 u₁) 0 u₀ = M u₀ u₁ := by
        intro u₀ u₁ hu₀ hu₁
        let G : ℂ → ℂ := fun w₀ => dslope (fun w₁ => M w₀ w₁) 0 u₁
        have hG0 : G 0 = 0 := hG0_vanish u₁ hu₁
        have h_outer : u₀ * dslope G 0 u₀ = G u₀ := by
          have hs := sub_smul_dslope G 0 u₀
          rw [sub_zero, smul_eq_mul, hG0, sub_zero] at hs
          exact hs
        have h_inner : u₁ * G u₀ = M u₀ u₁ := by
          have hs := sub_smul_dslope (fun w₁ => M u₀ w₁) 0 u₁
          rw [sub_zero, smul_eq_mul, hM_zero₀ u₀ hu₀, sub_zero] at hs
          exact hs
        calc u₀ * u₁ * dslope G 0 u₀ = u₁ * (u₀ * dslope G 0 u₀) := by ring
          _ = u₁ * G u₀ := by rw [h_outer]
          _ = M u₀ u₁ := h_inner
      have hRep : ∀ u₀ u₁ : ℂ, ‖u₀‖ < r_b / 2 → ‖u₁‖ < r_b / 2 →
          dslope (fun w₀ => dslope (fun w₁ => M w₀ w₁) 0 u₁) 0 u₀ =
            (((2 * Real.pi) ^ 2 : ℝ) : ℂ)⁻¹ *
              ∫ θ₀ in (0 : ℝ)..(2 * Real.pi),
                ∫ θ₁ in (0 : ℝ)..(2 * Real.pi),
                  M (z_c θ₀) (z_c θ₁) / ((z_c θ₀ - u₀) * (z_c θ₁ - u₁)) := by
        intro u₀ u₁ hu₀ hu₁
        have hu₀_rb : ‖u₀‖ < r_b := by linarith
        have hu₁_rb : ‖u₁‖ < r_b := by linarith
        have hu₁_2rb : ‖u₁‖ < 2 * r_b := by linarith
        let G : ℂ → ℂ := fun w₀ => dslope (fun w₁ => M w₀ w₁) 0 u₁
        have hG_eq : ∀ w₀ : ℂ, ‖w₀‖ < 2 * r_b →
            G w₀ = ((2 * Real.pi : ℝ) : ℂ)⁻¹ *
              ∫ θ₁ in (0 : ℝ)..(2 * Real.pi), M w₀ (z_c θ₁) / (z_c θ₁ - u₁) := by
          intro w₀ hw₀
          have h_slice₁ : DifferentiableOn ℂ (fun w₁ => M w₀ w₁) (Metric.ball (0 : ℂ) (2 * r_b)) :=
            hM_holo.comp ((differentiable_const w₀).prodMk differentiable_id).differentiableOn
              (fun w₁ hw₁ => ⟨by simpa [Metric.mem_ball, dist_zero_right] using hw₀, hw₁⟩)
          exact hdslope_circle (by linarith) h_slice₁ (hM_zero₀ w₀ hw₀) hu₁_rb
        let W₁ : Set (ℂ × ℂ) := Metric.ball (0 : ℂ) (3 * r_b / 2) ×ˢ (Set.univ : Set ℂ)
        let H₁ : (ℂ × ℂ) → ℝ → ℂ := fun p θ₁ => M p.1 (z_c θ₁) / (z_c θ₁ - u₁)
        have hH₁_cont : ContinuousOn (fun q : (ℂ × ℂ) × ℝ => H₁ q.1 q.2) (W₁ ×ˢ J) := by
          have h_num_c : ContinuousOn (fun q : (ℂ × ℂ) × ℝ => M q.1.1 (z_c q.2)) (W₁ ×ˢ J) := by
            have hφ : Continuous (fun q : (ℂ × ℂ) × ℝ => (q.1.1, z_c q.2)) :=
              (continuous_fst.comp continuous_fst).prodMk (hz_c_cont.comp continuous_snd)
            refine hM_holo.continuousOn.comp hφ.continuousOn (fun q hq => ⟨?_, ?_⟩)
            · have hq1 : ‖q.1.1‖ < 3 * r_b / 2 := by
                simpa [Metric.mem_ball, dist_zero_right] using hq.1.1
              rw [Metric.mem_ball, dist_zero_right]
              linarith
            · rw [Metric.mem_ball, dist_zero_right]
              exact hz_c_lt q.2
          have h_den_c : ContinuousOn (fun q : (ℂ × ℂ) × ℝ => z_c q.2 - u₁) (W₁ ×ˢ J) :=
            (hz_c_cont.comp continuous_snd).continuousOn.sub continuousOn_const
          have h_eq : (fun q : (ℂ × ℂ) × ℝ => H₁ q.1 q.2) =
              (fun q : (ℂ × ℂ) × ℝ => M q.1.1 (z_c q.2) * (z_c q.2 - u₁)⁻¹) := by
            funext q
            exact div_eq_mul_inv _ _
          rw [h_eq]
          exact h_num_c.mul (h_den_c.inv₀ (fun q _ => hz_c_sub_ne hu₁_rb q.2))
        have hH₁_holo : ∀ θ₁ ∈ J, DifferentiableOn ℂ (fun p => H₁ p θ₁) W₁ := by
          intro θ₁ _
          have h_num_h : DifferentiableOn ℂ (fun p : ℂ × ℂ => M p.1 (z_c θ₁)) W₁ := by
            refine hM_holo.comp (differentiable_fst.prodMk
              (differentiable_const (z_c θ₁))).differentiableOn (fun p hp => ⟨?_, ?_⟩)
            · have hp1 : ‖p.1‖ < 3 * r_b / 2 := by
                simpa [Metric.mem_ball, dist_zero_right] using hp.1
              rw [Metric.mem_ball, dist_zero_right]
              linarith
            · rw [Metric.mem_ball, dist_zero_right]
              exact hz_c_lt θ₁
          have h_eq : (fun p : ℂ × ℂ => H₁ p θ₁) =
              (fun p : ℂ × ℂ => (z_c θ₁ - u₁)⁻¹ * M p.1 (z_c θ₁)) := by
            funext p
            dsimp only [H₁]
            rw [div_eq_mul_inv, mul_comm]
          rw [h_eq]
          exact h_num_h.const_mul (z_c θ₁ - u₁)⁻¹
        have hW₁_int_holo : DifferentiableOn ℂ
            (fun p : ℂ × ℂ => ((2 * Real.pi : ℝ) : ℂ)⁻¹ *
              ∫ θ₁ in (0 : ℝ)..(2 * Real.pi), H₁ p θ₁) W₁ :=
          (hParamHolo1D (Metric.isOpen_ball.prod isOpen_univ) hH₁_cont hH₁_holo).const_mul _
        have hG_holo : DifferentiableOn ℂ G (Metric.ball (0 : ℂ) (3 * r_b / 2)) := by
          have h_comp : DifferentiableOn ℂ
              (fun w₀ : ℂ => ((2 * Real.pi : ℝ) : ℂ)⁻¹ *
                ∫ θ₁ in (0 : ℝ)..(2 * Real.pi), H₁ (w₀, 0) θ₁)
              (Metric.ball (0 : ℂ) (3 * r_b / 2)) :=
            hW₁_int_holo.comp (differentiable_id.prodMk (differentiable_const (0 : ℂ))).differentiableOn
              (fun w₀ hw₀ => ⟨hw₀, Set.mem_univ _⟩)
          refine h_comp.congr (fun w₀ hw₀ => ?_)
          have hw₀_lt : ‖w₀‖ < 2 * r_b := by
            have h1 : ‖w₀‖ < 3 * r_b / 2 := by simpa [Metric.mem_ball, dist_zero_right] using hw₀
            linarith
          exact hG_eq w₀ hw₀_lt
        have h_outer_c := hdslope_circle (by linarith : r_b < 3 * r_b / 2) hG_holo
          (hG0_vanish u₁ hu₁_2rb) hu₀_rb
        have h_outer_int : ∀ θ₀ : ℝ,
            G (z_c θ₀) / (z_c θ₀ - u₀) =
              ((2 * Real.pi : ℝ) : ℂ)⁻¹ *
                ∫ θ₁ in (0 : ℝ)..(2 * Real.pi),
                  M (z_c θ₀) (z_c θ₁) / ((z_c θ₀ - u₀) * (z_c θ₁ - u₁)) := by
          intro θ₀
          rw [hG_eq (z_c θ₀) (hz_c_lt θ₀)]
          have h_pull :
              (((2 * Real.pi : ℝ) : ℂ)⁻¹ *
                ∫ θ₁ in (0 : ℝ)..(2 * Real.pi), M (z_c θ₀) (z_c θ₁) / (z_c θ₁ - u₁)) /
                  (z_c θ₀ - u₀) =
                ((2 * Real.pi : ℝ) : ℂ)⁻¹ *
                  ((z_c θ₀ - u₀)⁻¹ *
                    ∫ θ₁ in (0 : ℝ)..(2 * Real.pi), M (z_c θ₀) (z_c θ₁) / (z_c θ₁ - u₁)) := by
            rw [div_eq_mul_inv]
            ring
          rw [h_pull, ← intervalIntegral.integral_const_mul (z_c θ₀ - u₀)⁻¹]
          congr 1
          refine intervalIntegral.integral_congr (fun θ₁ _ => ?_)
          rw [div_eq_mul_inv, div_eq_mul_inv, mul_inv]
          ring
        simp_rw [h_outer_int] at h_outer_c
        rw [intervalIntegral.integral_const_mul ((2 * Real.pi : ℝ) : ℂ)⁻¹] at h_outer_c
        rw [h_outer_c, ← mul_assoc, ← sq, h_pi_cast]
      have hHoloUb : DifferentiableOn ℂ
          (fun p : ℂ × ℂ => dslope (fun w₀ => dslope (fun w₁ => M w₀ w₁) 0 p.2) 0 p.1) U_b := by
        let G_M : (ℂ × ℂ) → ℝ → ℝ → ℂ := fun p θ₀ θ₁ =>
          M (z_c θ₀) (z_c θ₁) / ((z_c θ₀ - p.1) * (z_c θ₁ - p.2))
        have hDen_ne : ∀ p ∈ U_b, ∀ θ₀ θ₁ : ℝ, (z_c θ₀ - p.1) * (z_c θ₁ - p.2) ≠ 0 := by
          intro p hp θ₀ θ₁
          have hp0 : ‖p.1‖ < r_b := by
            have : ‖p.1‖ < r_b / 2 := by simpa [Metric.mem_ball, dist_zero_right] using hp.1
            linarith
          have hp1 : ‖p.2‖ < r_b := by
            have : ‖p.2‖ < r_b / 2 := by simpa [Metric.mem_ball, dist_zero_right] using hp.2
            linarith
          exact mul_ne_zero (hz_c_sub_ne hp0 θ₀) (hz_c_sub_ne hp1 θ₁)
        have hGM_cont : ContinuousOn (fun x : (ℂ × ℂ) × ℝ × ℝ => G_M x.1 x.2.1 x.2.2)
            (U_b ×ˢ (J ×ˢ J)) := by
          have h_num_c : ContinuousOn (fun x : (ℂ × ℂ) × ℝ × ℝ => M (z_c x.2.1) (z_c x.2.2))
              (U_b ×ˢ (J ×ˢ J)) := by
            have hφ : Continuous (fun x : (ℂ × ℂ) × ℝ × ℝ => (z_c x.2.1, z_c x.2.2)) :=
              (hz_c_cont.comp (continuous_fst.comp continuous_snd)).prodMk
                (hz_c_cont.comp (continuous_snd.comp continuous_snd))
            refine hM_holo.continuousOn.comp hφ.continuousOn (fun x _ => ⟨?_, ?_⟩)
            · rw [Metric.mem_ball, dist_zero_right]; exact hz_c_lt x.2.1
            · rw [Metric.mem_ball, dist_zero_right]; exact hz_c_lt x.2.2
          have hz₀_c : ContinuousOn (fun x : (ℂ × ℂ) × ℝ × ℝ => z_c x.2.1) (U_b ×ˢ (J ×ˢ J)) :=
            (hz_c_cont.comp (continuous_fst.comp continuous_snd)).continuousOn
          have hz₁_c : ContinuousOn (fun x : (ℂ × ℂ) × ℝ × ℝ => z_c x.2.2) (U_b ×ˢ (J ×ˢ J)) :=
            (hz_c_cont.comp (continuous_snd.comp continuous_snd)).continuousOn
          have hp₀_c : ContinuousOn (fun x : (ℂ × ℂ) × ℝ × ℝ => x.1.1) (U_b ×ˢ (J ×ˢ J)) :=
            (continuous_fst.comp continuous_fst).continuousOn
          have hp₁_c : ContinuousOn (fun x : (ℂ × ℂ) × ℝ × ℝ => x.1.2) (U_b ×ˢ (J ×ˢ J)) :=
            (continuous_snd.comp continuous_fst).continuousOn
          have h_den_c : ContinuousOn
              (fun x : (ℂ × ℂ) × ℝ × ℝ => (z_c x.2.1 - x.1.1) * (z_c x.2.2 - x.1.2))
              (U_b ×ˢ (J ×ˢ J)) :=
            (hz₀_c.sub hp₀_c).mul (hz₁_c.sub hp₁_c)
          have h_eq : (fun x : (ℂ × ℂ) × ℝ × ℝ => G_M x.1 x.2.1 x.2.2) =
              (fun x : (ℂ × ℂ) × ℝ × ℝ =>
                M (z_c x.2.1) (z_c x.2.2) * ((z_c x.2.1 - x.1.1) * (z_c x.2.2 - x.1.2))⁻¹) := by
            funext x
            exact div_eq_mul_inv _ _
          rw [h_eq]
          exact h_num_c.mul (h_den_c.inv₀ (fun x hx => hDen_ne x.1 hx.1 x.2.1 x.2.2))
        have hGM_holo : ∀ θ₀ ∈ J, ∀ θ₁ ∈ J, DifferentiableOn ℂ (fun p => G_M p θ₀ θ₁) U_b := by
          intro θ₀ _ θ₁ _ p hp
          have h_den_h : DifferentiableOn ℂ
              (fun q : ℂ × ℂ => (z_c θ₀ - q.1) * (z_c θ₁ - q.2)) U_b :=
            ((differentiableOn_const (z_c θ₀)).sub differentiable_fst.differentiableOn).mul
              ((differentiableOn_const (z_c θ₁)).sub differentiable_snd.differentiableOn)
          have h_eq : (fun q : ℂ × ℂ => G_M q θ₀ θ₁) =
              (fun q : ℂ × ℂ => M (z_c θ₀) (z_c θ₁) *
                ((z_c θ₀ - q.1) * (z_c θ₁ - q.2))⁻¹) := by
            funext q
            exact div_eq_mul_inv _ _
          rw [h_eq]
          exact (differentiableWithinAt_const _).mul
            ((h_den_h p hp).fun_inv (hDen_ne p hp θ₀ θ₁))
        have hInt_holo : DifferentiableOn ℂ
            (fun p : ℂ × ℂ => (((2 * Real.pi) ^ 2 : ℝ) : ℂ)⁻¹ *
              ∫ θ₀ in (0 : ℝ)..(2 * Real.pi),
                ∫ θ₁ in (0 : ℝ)..(2 * Real.pi), G_M p θ₀ θ₁) U_b :=
          (hDoubleHolo U_b G_M hUb_open hGM_cont hGM_holo).const_mul _
        refine hInt_holo.congr (fun p hp => ?_)
        exact hRep p.1 p.2
          (by simpa [Metric.mem_ball, dist_zero_right] using hp.1)
          (by simpa [Metric.mem_ball, dist_zero_right] using hp.2)
      exact ⟨hProd, hRep, hHoloUb⟩

    obtain ⟨hProd₁, hRep₁, hHolo₁⟩ := hIterDslope N hN_holo hN_zero₁ hN_zero₀
    let N_swap : ℂ → ℂ → ℂ := fun w₁ w₀ => N w₀ w₁
    have hN_swap_holo : DifferentiableOn ℂ (fun z : ℂ × ℂ => N_swap z.1 z.2)
        (Metric.ball (0 : ℂ) (2 * r_b) ×ˢ Metric.ball (0 : ℂ) (2 * r_b)) :=
      hN_holo.comp (differentiable_snd.prodMk differentiable_fst).differentiableOn
        (fun z hz => ⟨hz.2, hz.1⟩)
    obtain ⟨hProd₂, _, hHolo₂_swap⟩ := hIterDslope N_swap hN_swap_holo hN_zero₀ hN_zero₁
    have hHolo₂ : DifferentiableOn ℂ
        (fun p : ℂ × ℂ => dslope (fun w₁ => dslope (fun w₀ => N w₀ w₁) 0 p.1) 0 p.2) U_b :=
      hHolo₂_swap.comp (differentiable_snd.prodMk differentiable_fst).differentiableOn
        (fun p hp => ⟨hp.2, hp.1⟩)

    obtain ⟨nzSeq, h_nzSeq⟩ : ∃ nzSeq : ℂ → ℕ → ℂ,
        ∀ b : ℂ, ‖b‖ < r_b / 2 →
          (∀ n : ℕ, nzSeq b n ≠ 0 ∧ ‖nzSeq b n‖ < r_b / 2) ∧
          Filter.Tendsto (nzSeq b) Filter.atTop (nhds b) := by
      refine ⟨fun b n => if b = 0 then ((r_b / (4 * ((n : ℝ) + 1)) : ℝ) : ℂ) else b, ?_⟩
      intro b hb
      by_cases hb0 : b = 0
      · subst hb0
        simp only [↓reduceIte]
        refine ⟨fun n => ?_, ?_⟩
        · have hpos : 0 < r_b / (4 * ((n : ℝ) + 1)) := by positivity
          have hnorm : ‖((r_b / (4 * ((n : ℝ) + 1)) : ℝ) : ℂ)‖ = r_b / (4 * ((n : ℝ) + 1)) := by
            rw [Complex.norm_real, Real.norm_of_nonneg hpos.le]
          refine ⟨Complex.ofReal_ne_zero.mpr hpos.ne', ?_⟩
          rw [hnorm, div_lt_iff₀ (by positivity)]
          nlinarith [hrb, Nat.cast_nonneg (α := ℝ) n]
        · have h_real : Filter.Tendsto (fun n : ℕ => r_b / (4 * ((n : ℝ) + 1)))
              Filter.atTop (nhds 0) := by
            have h_eq : (fun n : ℕ => r_b / (4 * ((n : ℝ) + 1))) =
                (fun n : ℕ => (r_b / 4) * (1 / ((n : ℝ) + 1))) := by
              funext n
              have hne : (n : ℝ) + 1 ≠ 0 := by positivity
              field_simp [hne]
            rw [h_eq]
            simpa using tendsto_one_div_add_atTop_nhds_zero_nat.const_mul (r_b / 4)
          have hc := (Complex.continuous_ofReal.tendsto 0).comp h_real
          rwa [Complex.ofReal_zero] at hc
      · simp only [hb0, ↓reduceIte]
        exact ⟨fun _ => ⟨hb0, hb⟩, tendsto_const_nhds⟩

    let D₁ : ℂ := dslope (fun w₀ => dslope (fun w₁ => N w₀ w₁) 0 b₁) 0 b₀
    let D₂ : ℂ := dslope (fun w₁ => dslope (fun w₀ => N w₀ w₁) 0 b₀) 0 b₁
    let I_cauchy : ℂ :=
      (((2 * Real.pi) ^ 2 : ℝ) : ℂ)⁻¹ *
        ∫ θ₀ in (0 : ℝ)..(2 * Real.pi),
          ∫ θ₁ in (0 : ℝ)..(2 * Real.pi),
            N (z_c θ₀) (z_c θ₁) / ((z_c θ₀ - b₀) * (z_c θ₁ - b₁))
    have hD₁_eq : D₁ = I_cauchy := hRep₁ b₀ b₁ hb₀ hb₁
    have hb_mem : (b₀, b₁) ∈ U_b :=
      ⟨by simpa [Metric.mem_ball, dist_zero_right] using hb₀,
       by simpa [Metric.mem_ball, dist_zero_right] using hb₁⟩
    have hD_eq : D₂ = D₁ := by
      obtain ⟨hu₀_prop, hu₀_lim⟩ := h_nzSeq b₀ hb₀
      obtain ⟨hu₁_prop, hu₁_lim⟩ := h_nzSeq b₁ hb₁
      let p_seq : ℕ → ℂ × ℂ := fun n => (nzSeq b₀ n, nzSeq b₁ n)
      have hp_lim : Filter.Tendsto p_seq Filter.atTop (nhds (b₀, b₁)) :=
        hu₀_lim.prodMk_nhds hu₁_lim
      have hCont₁ : ContinuousAt
          (fun p : ℂ × ℂ => dslope (fun w₀ => dslope (fun w₁ => N w₀ w₁) 0 p.2) 0 p.1) (b₀, b₁) :=
        (hHolo₁.differentiableAt (hUb_open.mem_nhds hb_mem)).continuousAt
      have hCont₂ : ContinuousAt
          (fun p : ℂ × ℂ => dslope (fun w₁ => dslope (fun w₀ => N w₀ w₁) 0 p.1) 0 p.2) (b₀, b₁) :=
        (hHolo₂.differentiableAt (hUb_open.mem_nhds hb_mem)).continuousAt
      have h_seq_eq : ∀ n : ℕ,
          dslope (fun w₁ => dslope (fun w₀ => N w₀ w₁) 0 (nzSeq b₀ n)) 0 (nzSeq b₁ n) =
            dslope (fun w₀ => dslope (fun w₁ => N w₀ w₁) 0 (nzSeq b₁ n)) 0 (nzSeq b₀ n) := by
        intro n
        have hu₀_2rb : ‖nzSeq b₀ n‖ < 2 * r_b := lt_trans (hu₀_prop n).2 (by linarith)
        have hu₁_2rb : ‖nzSeq b₁ n‖ < 2 * r_b := lt_trans (hu₁_prop n).2 (by linarith)
        have hp1 := hProd₁ (nzSeq b₀ n) (nzSeq b₁ n) hu₀_2rb hu₁_2rb
        have hp2 := hProd₂ (nzSeq b₁ n) (nzSeq b₀ n) hu₁_2rb hu₀_2rb
        dsimp only [N_swap] at hp2
        have h_mul_ne : nzSeq b₀ n * nzSeq b₁ n ≠ 0 :=
          mul_ne_zero (hu₀_prop n).1 (hu₁_prop n).1
        apply mul_left_cancel₀ h_mul_ne
        calc nzSeq b₀ n * nzSeq b₁ n *
              dslope (fun w₁ => dslope (fun w₀ => N w₀ w₁) 0 (nzSeq b₀ n)) 0 (nzSeq b₁ n)
            = nzSeq b₁ n * nzSeq b₀ n *
              dslope (fun w₁ => dslope (fun w₀ => N w₀ w₁) 0 (nzSeq b₀ n)) 0 (nzSeq b₁ n) := by ring
          _ = N (nzSeq b₀ n) (nzSeq b₁ n) := hp2
          _ = nzSeq b₀ n * nzSeq b₁ n *
              dslope (fun w₀ => dslope (fun w₁ => N w₀ w₁) 0 (nzSeq b₁ n)) 0 (nzSeq b₀ n) :=
                hp1.symm
      have hLim₂ : Filter.Tendsto
          (fun n : ℕ => dslope (fun w₁ => dslope (fun w₀ => N w₀ w₁) 0 (nzSeq b₀ n)) 0 (nzSeq b₁ n))
          Filter.atTop (nhds D₂) :=
        hCont₂.tendsto.comp hp_lim
      have hLim₁ : Filter.Tendsto
          (fun n : ℕ => dslope (fun w₁ => dslope (fun w₀ => N w₀ w₁) 0 (nzSeq b₀ n)) 0 (nzSeq b₁ n))
          Filter.atTop (nhds D₁) :=
        (hCont₁.tendsto.comp hp_lim).congr' (Filter.Eventually.of_forall fun n => (h_seq_eq n).symm)
      exact tendsto_nhds_unique hLim₂ hLim₁

    dsimp only [bivarHybridDiv]
    split_ifs with h_nz
    · have hp1 := hProd₁ b₀ b₁ (by linarith) (by linarith)
      have h_prod : D₁ * (b₀ * b₁) = N b₀ b₁ := by
        dsimp only [D₁]
        linear_combination hp1
      rw [← h_prod, mul_div_cancel_right₀ D₁ (mul_ne_zero h_nz.1 h_nz.2)]
      exact hD₁_eq
    · change (1 / 2 : ℂ) * D₁ + (1 / 2 : ℂ) * D₂ = I_cauchy
      rw [hD_eq, hD₁_eq]
      ring

  exact ⟨hCauchy, hDoubleHolo, hBivarRev⟩

theorem volterra_picard_and_analytic_division : VolterraDivisionProp :=
by
  have hSfca : SfcaVolterraKernelProp := volterra_unit_interval_kernels
  obtain ⟨hODE, hLip⟩ := volterra_ode_uniqueness_wronskian_and_lip hSfca
  obtain ⟨hNeg, hRevRoot, hRevNum, hWronskProd, hk0_zero, hFreeTrig, hFreeLim⟩ :=
    sl_exact_symmetries_wronskian_product_and_free_eval hSfca hODE hLip
  have hEnv :=
    sl_numerator_slit_envelope_and_lipschitz hODE hLip
      (fun Q hQ => (hNeg Q 0 0 hQ).1) hWronskProd hRevNum
  obtain ⟨hCauchy, hDoubleHolo, hBivarRev⟩ := bivariate_hybrid_dslope_cauchy_and_param_holo

  have hDivEq : ∀ (Q : ℝ → ℂ), k0Kernel Q 1 ≠ 0 → ∀ a₀ a₁ : ℂ,
      slDivided Q a₀ a₁ =
        bivarHybridDiv (slNumerator Q) a₀ (a₀ * c0Kernel Q 1 + a₁ * k0Kernel Q 1) := by
    intro Q hk0 a₀ a₁
    dsimp [slDivided, bivarHybridDiv]
    split_ifs with h_nz
    · have h_slope :
          (a₀ * c0Kernel Q 1 + a₁ * k0Kernel Q 1 - a₀ * c0Kernel Q 1) / k0Kernel Q 1 = a₁ := by
        have h_sub : a₀ * c0Kernel Q 1 + a₁ * k0Kernel Q 1 - a₀ * c0Kernel Q 1 =
            a₁ * k0Kernel Q 1 := by ring
        rw [h_sub, mul_div_cancel_right₀ a₁ hk0]
      simp only [slNumerator, h_slope]
    · rfl

  have hPart4 : ∀ Q₀ : ℝ → ℂ,
