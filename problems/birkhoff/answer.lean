          apply Complex.ext <;> simp [Complex.measurableEquivRealProd]
        rw [hsymm]
        dsimp [G_ext, ψ_c]
        rw [hclamp_eq hp.2]
      rw [hcongr]
      have hmp2 : MeasureTheory.MeasurePreserving (fun p : ℝ × ℝ => (x, (0 : ℝ)) + p)
          MeasureTheory.volume MeasureTheory.volume :=
        MeasureTheory.measurePreserving_add_left MeasureTheory.volume (x, (0 : ℝ))
      have hemb2 : MeasurableEmbedding (fun p : ℝ × ℝ => (x, (0 : ℝ)) + p) :=
        (Homeomorph.addLeft (x, (0 : ℝ))).measurableEmbedding
      have hpre2 : (fun p : ℝ × ℝ => (x, (0 : ℝ)) + p) ⁻¹'
          (Set.Icc (x - L) (x + L) ×ˢ Set.Icc y₁ y₂) = K_vy := by
        ext ⟨v, y⟩
        simp only [Set.mem_preimage, Prod.add_def, zero_add, Set.mem_prod, Set.mem_Icc, K_vy]
        constructor
        · rintro ⟨⟨h1, h2⟩, h3⟩; exact ⟨⟨by linarith, by linarith⟩, h3⟩
        · rintro ⟨⟨h1, h2⟩, h3⟩; exact ⟨⟨by linarith, by linarith⟩, h3⟩
      rw [← hmp2.setIntegral_preimage_emb hemb2 G_ext _, hpre2]
      refine MeasureTheory.setIntegral_congr_fun (measurableSet_Icc.prod measurableSet_Icc)
        fun p _ => ?_
      simp [Prod.add_def]
    have hCont_rect : Continuous (fun x : ℝ => ∫ w in R_x x, G w) := by
      simp only [h_rect_eq]
      refine continuous_parametric_integral_of_continuous ?_ hKvy_compact
      exact hGext_cont.comp ((continuous_fst.add (continuous_fst.comp continuous_snd)).prodMk
        (continuous_snd.comp continuous_snd))
    let h_row : ℝ → ℝ := fun y => (2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi), G_ext (x, y)
    have hCont_row : Continuous h_row := by
      refine continuous_const.mul ?_
      refine intervalIntegral.continuous_parametric_intervalIntegral_of_continuous'
        ?_ 0 (2 * Real.pi)
      exact hGext_cont.comp (continuous_snd.prodMk continuous_fst)
    let φ : ℝ → ℝ := fun j => S.H - Real.exp (-j)
    have hφ_mem : ∀ j ∈ Set.Icc j₁ j₂, φ j ∈ Set.Icc y₁ y₂ := by
      intro j hj_mem
      refine ⟨?_, ?_⟩
      · dsimp [φ, y₁]
        have : Real.exp (-j) ≤ Real.exp (-j₁) := Real.exp_le_exp.mpr (by linarith [hj_mem.1])
        linarith
      · dsimp [φ, y₂]
        have : Real.exp (-j₂) ≤ Real.exp (-j) := Real.exp_le_exp.mpr (by linarith [hj_mem.2])
        linarith
    have h_row_φ : ∀ j ∈ Set.Icc j₁ j₂, h_row (φ j) =
        (2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi),
          G ((x : ℂ) + ((S.H - Real.exp (-j) : ℝ) : ℂ) * Complex.I) := by
      intro j hj_mem
      dsimp [h_row, G_ext, ψ_c]
      rw [hclamp_eq (hφ_mem j hj_mem)]
    refine ⟨hCont_rect.intervalIntegrable 0 (2 * Real.pi), ?_, ?_⟩
    · have hCont_base : ContinuousOn (fun j : ℝ => Real.exp (-j) * h_row (φ j)) (Set.Icc j₁ j₂) :=
        (Real.continuous_exp.comp continuous_neg).continuousOn.mul
          (hCont_row.comp
            (continuous_const.sub (Real.continuous_exp.comp continuous_neg))).continuousOn
      exact hCont_base.congr fun j hj_mem => by dsimp only; rw [h_row_φ j hj_mem]
    · simp_rw [h_rect_eq]
      let f_swap : ℝ → ℝ × ℝ → ℝ := fun x p => G_ext (x + p.1, p.2)
      have hf_swap_cont : Continuous (Function.uncurry f_swap) :=
        hGext_cont.comp ((continuous_fst.add (continuous_fst.comp continuous_snd)).prodMk
