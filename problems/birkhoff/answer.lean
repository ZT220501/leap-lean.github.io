        Fin.last ch.L_ch := rfl
    have h_end_ball : B_ch (Fin.last ch.L_ch) = Metric.ball p_b r_b := by
      dsimp only [B_ch]
      rw [ch.end_eq.1, ch.end_eq.2.1]
    have h_end :
        (∀ p ∈ B_ch (Fin.last ch.L_ch), Ψ E_chart (ch.M_ch (Fin.last ch.L_ch)) p = 0) ↔
        (∀ p ∈ Metric.ball p_b r_b, Ψ E_chart M_b p = 0) := by
      rw [h_end_ball]
      have h_congr : ∀ p ∈ Metric.ball p_b r_b,
          Ψ E_chart (ch.M_ch (Fin.last ch.L_ch)) p = Ψ E_chart M_b p :=
        hΨ.2 Metric.isOpen_ball (fun _ _ _ _ _ => rfl) ch.end_eq.2.2
      exact ⟨fun h p hp => (h_congr p hp).symm.trans (h p hp),
             fun h p hp => (h_congr p hp).trans (h p hp)⟩
    exact h_start.trans ((h_chain ch.L_ch le_rfl).trans h_end)
  
  obtain ⟨L_vert, hL_pos, c_vert, R_vert, hR_pos, N_vert, D_vert, D_prod,
