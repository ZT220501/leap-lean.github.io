        exact ⟨by linarith, h_t⟩
      have hU_maps : ∀ q ∈ collarBaseBox M, C.U (Φ q) ∈ horizStrip (2 * C.s₀) := by
        intro q hq
        obtain ⟨h_im, h_t⟩ := h_shift_mem q hq c hc
        exact C.U_maps_to _ _ (by linarith) h_t
      exact ⟨C.ϕ_ℂ_holo.comp hU_comp hU_maps, fun q hq => C.ϕ_ℂ_maps_to _ (hU_maps q hq)⟩
    obtain ⟨hTh_m_holo, hTh_m_maps⟩ := hTheta_shift_holo (-1 / 2) (by norm_num)
    obtain ⟨hTh_p_holo, hTh_p_maps⟩ := hTheta_shift_holo (1 / 2) (by norm_num)
    have hMid_eq : ∀ q : ℂ × ℂ, glancingMidAngle C q.1 q.2 =
        (glancingTheta C (q.1 + ((-1 / 2 : ℝ) : ℂ) * q.2) q.2 +
          glancingTheta C (q.1 + ((1 / 2 : ℝ) : ℂ) * q.2) q.2) / 2 := by
      intro ⟨y, t⟩
      dsimp [glancingMidAngle]
      congr 2 <;> [congr 1; congr 1] <;> push_cast <;> ring
    have hMid_holo : DifferentiableOn ℂ (fun q : ℂ × ℂ => glancingMidAngle C q.1 q.2)
        (collarBaseBox M) := by
      have : (fun q : ℂ × ℂ => glancingMidAngle C q.1 q.2) =
          fun q => (glancingTheta C (q.1 + ((-1 / 2 : ℝ) : ℂ) * q.2) q.2 +
            glancingTheta C (q.1 + ((1 / 2 : ℝ) : ℂ) * q.2) q.2) * (1 / 2 : ℂ) := by
        ext q
        rw [hMid_eq q, div_eq_mul_inv]
        ring
      rw [this]
      exact (hTh_m_holo.add hTh_p_holo).mul_const _
    have hMid_maps : ∀ q ∈ collarBaseBox M, glancingMidAngle C q.1 q.2 ∈ horizStrip (2 * C.s_h) := by
      intro q hq
