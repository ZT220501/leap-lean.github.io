            | zero => simpa using hg_ev_S
            | succ m ihm => simp only [iteratedDeriv_succ]; exact ihm.deriv
          rw [iteratedDeriv_succ, iteratedDeriv_succ, h_ev_k.deriv_eq]
      let R_nn : NNReal := ⟨5 * δ / 4, by positivity⟩
      have hR_nn_pos : (0 : NNReal) < R_nn := by
        exact_mod_cast (by positivity : (0 : ℝ) < 5 * δ / 4)
      have hcl_sub : Metric.closedBall (x₀ : ℂ) (R_nn : ℝ) ⊆ Metric.ball (ρ_star : ℂ) r_g := by
        intro w hw
        rw [Metric.mem_closedBall, dist_eq_norm] at hw
        rw [Metric.mem_ball, dist_eq_norm]
        have hdiff_x₀ : ‖(x₀ : ℂ) - (ρ_star : ℂ)‖ = δ / 2 := by
          rw [← Complex.ofReal_sub, Complex.norm_real, Real.norm_eq_abs]
          have : x₀ - ρ_star = -(δ / 2) := by dsimp [x₀]; ring
          rw [this, abs_neg, abs_of_pos (by positivity)]
        have htri : ‖w - (ρ_star : ℂ)‖ ≤ ‖w - (x₀ : ℂ)‖ + ‖(x₀ : ℂ) - (ρ_star : ℂ)‖ := by
          simpa using norm_add_le (w - (x₀ : ℂ)) ((x₀ : ℂ) - (ρ_star : ℂ))
        have hR_val : (R_nn : ℝ) = 5 * δ / 4 := rfl
        linarith
      have h_cauchy_ps :=
        (hg_holo.diffContOnCl_ball hcl_sub).hasFPowerSeriesOnBall hR_nn_pos
      have h_ps_eq : cauchyPowerSeries g (x₀ : ℂ) (R_nn : ℝ) =
          FormalMultilinearSeries.ofScalars ℂ
            (fun k => iteratedDeriv k g (x₀ : ℂ) / (k.factorial : ℂ)) :=
        h_cauchy_ps.hasFPowerSeriesAt.eq_formalMultilinearSeries hg_ana_x₀.hasFPowerSeriesAt
      rw [h_ps_eq] at h_cauchy_ps
      have hδ_in_eball : (δ : ℂ) ∈ Metric.eball (0 : ℂ) (R_nn : ENNReal) := by
        rw [Metric.mem_eball, edist_zero_right, enorm_eq_nnnorm]
        have h1 : (‖(δ : ℂ)‖₊ : ℝ) < (R_nn : ℝ) := by
          change ‖(δ : ℂ)‖ < 5 * δ / 4
          rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos hδ_pos]
          linarith
        exact_mod_cast h1
      have h_sum_δ_c := (h_cauchy_ps.hasSum hδ_in_eball).summable
      have h_sum_δ_re := Complex.reCLM.summable h_sum_δ_c
      have hterm_nn : ∀ k n : ℕ, 0 ≤ (Nat.choose n k : ℝ) * L.c n * x₀ ^ (n - k) :=
        fun k n => mul_nonneg (mul_nonneg (Nat.cast_nonneg _) (L.c_nonneg n))
          (pow_nonneg hx₀_pos.le _)
      let b_seq : ℕ → ℝ := fun k =>
        (∑' n : ℕ, (Nat.choose n k : ℝ) * L.c n * x₀ ^ (n - k)) * δ ^ k
      have hb_nonneg : ∀ k : ℕ, 0 ≤ b_seq k := fun k =>
        mul_nonneg (tsum_nonneg (fun n => hterm_nn k n)) (pow_nonneg hδ_pos.le k)
      have hb_summable : Summable b_seq := by
        convert h_sum_δ_re using 1
        ext k
        dsimp [b_seq]
        rw [← (hS_taylor_re x₀ hx₀_mem_ρ k).2, ← h_iter_eq k]
        change _ = (FormalMultilinearSeries.ofScalars ℂ
          (fun m => iteratedDeriv m g (x₀ : ℂ) / (m.factorial : ℂ)) k (fun _ => (δ : ℂ))).re
        rw [FormalMultilinearSeries.ofScalars_apply_eq, smul_eq_mul, ← Complex.ofReal_pow,
          Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im, mul_zero, sub_zero]
      let T_mat : ℕ → ℕ → ENNReal := fun k n =>
        ENNReal.ofReal ((Nat.choose n k : ℝ) * L.c n * x₀ ^ (n - k) * δ ^ k)
      have h_row_eq : ∀ k : ℕ, (∑' n : ℕ, T_mat k n) = ENNReal.ofReal (b_seq k) := by
        intro k
        dsimp [T_mat, b_seq]
        have hs_k := (hS_taylor_re x₀ hx₀_mem_ρ k).1.mul_right (δ ^ k)
        rw [← tsum_mul_right, ← ENNReal.ofReal_tsum_of_nonneg
          (fun n => mul_nonneg (hterm_nn k n) (pow_nonneg hδ_pos.le k)) hs_k]
      have h_col_eq : ∀ n : ℕ,
