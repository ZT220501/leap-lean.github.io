          _ = Real.pi ^ 2 / 2 := by field_simp
      have hswap : (∫ x in (0 : ℝ)..(2 * Real.pi),
          ∫ y in (0 : ℝ)..(2 * Real.pi), periodicPoissonKernel d_a (x - y) * w y) =
