      calc ‖S.𝔰 (y, t) - y‖ = ‖g t‖ := rfl
        _ = ‖t ^ 2 * h₂ t‖ := by rw [← h_mul t]
        _ = ‖t‖ ^ 2 * ‖h₂ t‖ := by rw [norm_mul, norm_pow]
        _ ≤ ‖t‖ ^ 2 * C_init := mul_le_mul_of_nonneg_left hh₂_le (by positivity)
        _ = C_init * ‖t‖ ^ 2 := mul_comm _ _
    have h_period_nat : ∀ (n : ℕ) (s : ℂ), s ∈ horizStrip S.H →
        shapeModulus S (s + (((n : ℝ) * (2 * Real.pi) : ℝ) : ℂ)) = shapeModulus S s := by
