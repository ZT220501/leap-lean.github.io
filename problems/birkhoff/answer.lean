            have hexp_cmp : (1 / 2 : ℝ) * Real.exp (-A) ≤ Real.exp A := by
              have hle1 : Real.exp (-A) ≤ 1 := Real.exp_le_one_iff.mpr (by linarith)
              have hge1 : 1 ≤ Real.exp A := Real.one_le_exp (by linarith)
