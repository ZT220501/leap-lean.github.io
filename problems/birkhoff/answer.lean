    have hb_props := hConeProps N hN k hk
    have hb_cont : Continuous (bootConeCost S δ_b L β₁ N k) := hb_props.1
    have hb_nonneg : ∀ x : ℝ, 0 ≤ bootConeCost S δ_b L β₁ N k x :=
      fun x => le_trans zero_le_one (hb_props.2.2 x)
    have hterm_cont : ∀ n : ℕ, Continuous (fun x => c_fn n * tileSupModulus S A (l_fn n) x) :=
      fun n => continuous_const.mul (hTileContPer (l_fn n) (le_max_left _ _)).1
    have hsum_cont : Continuous
        (fun x => ∑ n ∈ Finset.range M_lvl, c_fn n * tileSupModulus S A (l_fn n) x) :=
      continuous_finsetSum (Finset.range M_lvl) (fun n _ => hterm_cont n)
    have hG_cont : Continuous G_fn :=
      continuous_const.mul (continuous_const.add hsum_cont)
    have hb_le_G : ∀ x : ℝ, bootConeCost S δ_b L β₁ N k x ≤ G_fn x := by
      intro x
      have hdom := hConeDom N hN k x hk
      have h_eq : Real.exp 1 * (1 + ∑ n ∈ Finset.range M_lvl,
          Real.exp (-β₁ * ((n : ℝ) - 3)) * (tileSupModulus S A (l_fn n) x / N k)) = G_fn x := by
        dsimp [G_fn, c_fn]
        congr 2
        apply Finset.sum_congr rfl
        intro n _
        ring
      linarith
    have hN2_mono : N2 (bootConeCost S δ_b L β₁ N k) ≤ N2 G_fn := by
      apply Real.sqrt_le_sqrt
      apply mul_le_mul_of_nonneg_left _ (inv_nonneg.mpr h2pi_nonneg)
      apply intervalIntegral.integral_mono_on h2pi_nonneg
        ((hb_cont.pow 2).intervalIntegrable 0 (2 * Real.pi))
        ((hG_cont.pow 2).intervalIntegrable 0 (2 * Real.pi))
      intro x _
      exact pow_le_pow_left₀ (hb_nonneg x) (hb_le_G x) 2
    have hN2_G : N2 G_fn ≤ Real.exp 1 * (1 + C_t2 * (1 + M_r) * S_env) := by
      have h1 : N2 G_fn = Real.exp 1 *
          N2 (fun x => 1 + ∑ n ∈ Finset.range M_lvl, c_fn n * tileSupModulus S A (l_fn n) x) :=
        hN2_const_mul (Real.exp 1) _ (le_of_lt (Real.exp_pos 1))
      have h2 : N2 (fun x => 1 + ∑ n ∈ Finset.range M_lvl,
            c_fn n * tileSupModulus S A (l_fn n) x) ≤
          1 + ∑ n ∈ Finset.range M_lvl, c_fn n * N2 (tileSupModulus S A (l_fn n)) := by
        calc
          N2 (fun x => 1 + ∑ n ∈ Finset.range M_lvl, c_fn n * tileSupModulus S A (l_fn n) x) ≤
              N2 (fun _ => 1) +
                N2 (fun x => ∑ n ∈ Finset.range M_lvl, c_fn n * tileSupModulus S A (l_fn n) x) :=
            hN2_add (fun _ => 1) _ continuous_const hsum_cont
          _ ≤ 1 + ∑ n ∈ Finset.range M_lvl,
                N2 (fun x => c_fn n * tileSupModulus S A (l_fn n) x) := by
            rw [hN2_one]
            have h_sum := hN2_sum (Finset.range M_lvl) _ (fun n _ => hterm_cont n)
            linarith
          _ = 1 + ∑ n ∈ Finset.range M_lvl, c_fn n * N2 (tileSupModulus S A (l_fn n)) := by
            congr 1
            apply Finset.sum_congr rfl
            intro n _
            exact hN2_const_mul (c_fn n) _
              (div_nonneg (le_of_lt (Real.exp_pos _)) (le_of_lt hNk_pos))
      have h3 : (∑ n ∈ Finset.range M_lvl, c_fn n * N2 (tileSupModulus S A (l_fn n))) ≤
          C_t2 * (1 + M_r) * S_env := by
        have hsum_le :
            (∑ n ∈ Finset.range M_lvl, c_fn n * N2 (tileSupModulus S A (l_fn n))) ≤
              ∑ n ∈ Finset.range M_lvl,
                (C_t2 * (1 + M_r)) *
                  (Real.exp (-β₁ * ((n : ℝ) - 3)) * (N (l_fn n) / N k)) := by
          apply Finset.sum_le_sum
          intro n _
          have hc_nonneg : 0 ≤ c_fn n :=
            div_nonneg (le_of_lt (Real.exp_pos _)) (le_of_lt hNk_pos)
          have htile2 : N2 (tileSupModulus S A (l_fn n)) ≤
              C_t2 * (1 + M_r) * N (l_fn n) :=
            hTileL2 N hN M_r hMr hRow (l_fn n) (le_max_left _ _)
          calc
            c_fn n * N2 (tileSupModulus S A (l_fn n)) ≤
                c_fn n * (C_t2 * (1 + M_r) * N (l_fn n)) :=
              mul_le_mul_of_nonneg_left htile2 hc_nonneg
            _ = (C_t2 * (1 + M_r)) *
                  (Real.exp (-β₁ * ((n : ℝ) - 3)) * (N (l_fn n) / N k)) := by
              dsimp [c_fn]
              ring
        rw [← Finset.mul_sum] at hsum_le
        have hCt2Mr_nonneg : 0 ≤ C_t2 * (1 + M_r) := by positivity
        exact le_trans hsum_le (mul_le_mul_of_nonneg_left (hEnvSum N hN k hk) hCt2Mr_nonneg)
      rw [h1]
      exact mul_le_mul_of_nonneg_left (by linarith) (le_of_lt (Real.exp_pos 1))
    have hAbsorb : Real.exp 1 * (1 + C_t2 * (1 + M_r) * S_env) ≤ C_b2 * (1 + M_r) := by
      have h1 : 1 + C_t2 * (1 + M_r) * S_env ≤ (1 + C_t2 * S_env) * (1 + M_r) := by
        linarith
      calc
        Real.exp 1 * (1 + C_t2 * (1 + M_r) * S_env) ≤
            Real.exp 1 * ((1 + C_t2 * S_env) * (1 + M_r)) :=
          mul_le_mul_of_nonneg_left h1 (le_of_lt (Real.exp_pos 1))
        _ = C_b2 * (1 + M_r) := by dsimp [C_b2]; ring
    exact le_trans hN2_mono (le_trans hN2_G hAbsorb)

theorem cone_passage_dslope_taylor_neg_part (S : FiniteWallNonisotropicStrip)
    (hCrit : CriticalWallData S)
    (hStrip : ∀ t : ℝ, |t| < S.r_star → ∀ y : ℂ, 0 < y.im → y.im < S.h_X (t : ℂ) →
      (S.𝔰 (y, (t : ℂ)) - y).im ≤ S.H - S.h_X (t : ℂ))
    (β a C_N C₁ δ_b L₀ β₁ : ℝ)
    (hβ : 0 ≤ β) (hββ₁ : β < β₁) (hβ₁ : β₁ < 1 / 2) (ha : 0 < a) (hCN : 1 ≤ C_N) (hC₁ : 0 < C₁)
    (hδb_pos : 0 < δ_b) (hδb_lt : δ_b < S.H / 2) (hL₀_pos : 0 < L₀) :
    ∃ L K_tay c_tay C_tay : ℝ,
      L₀ ≤ L ∧
      criticalDepthThreshold S ≤ K_tay ∧
      0 < c_tay ∧ c_tay < S.r_star / 2 ∧
      0 < C_tay ∧
      ∀ N : ℝ → ℝ, IsCriticalEnvelope S β a C_N C₁ N →
        ∀ k x t : ℝ, K_tay ≤ k → 0 < |t| → |t| < S.r_star →
          (|t| * N k / Real.exp (-k)) * bootConeCost S δ_b L β₁ N k x ≤ c_tay →
          S.H - S.h_X (t : ℂ) ≤ Real.exp (-k) / 2 →
          Real.exp (-k) * max ((S.V (bootRowPt S k x)).im) 0 / (N k) ^ 2 ≤
            C_tay * (((S.H - S.h_X (t : ℂ)) / Real.exp (-k)) /
              (|t| * N k / Real.exp (-k)) ^ 2 +
              (|t| * N k / Real.exp (-k)) ^ 2 * (bootConeCost S δ_b L β₁ N k x) ^ 4) :=
by
  
  let α₁ : ℝ := 1 - β₁
  have hβ₁_pos : 0 < β₁ := lt_of_le_of_lt hβ hββ₁
  have hα₁_gt : 1 / 2 < α₁ := by dsimp [α₁]; linarith
  have hα₁_lt : α₁ < 1 := by dsimp [α₁]; linarith
  obtain ⟨L_cp, δ_star, hLcp_pos, hδs_pos, hδs_lt, hCP_K⟩ :=
    hCrit.cone_passage α₁ 1 δ_b hα₁_gt hα₁_lt zero_lt_one hδb_pos hδb_lt
  obtain ⟨C_cp, ε₀, d₀, hCcp_pos, hε₀_pos, hd₀_pos, hCP⟩ :=
    hCP_K 1 zero_lt_one
  let L : ℝ := max L₀ L_cp
  let δ_min : ℝ := min d₀ (min δ_star 1)
  let K_tay : ℝ := max (criticalDepthThreshold S) (-Real.log δ_min + 1)
  let c₀ : ℝ := min (1 / 4) (min (ε₀ / 2) (S.r_star / 2))
  let c_tay : ℝ := c₀ / 2
  let C_tay : ℝ := max 1 (512 * C_cp / (9 * c₀ ^ 2))
  have hL₀_le : L₀ ≤ L := le_max_left _ _
  have hLcp_le : L_cp ≤ L := le_max_right _ _
  have hL_pos : 0 < L := lt_of_lt_of_le hL₀_pos hL₀_le
  have hk₀_le_Ktay : criticalDepthThreshold S ≤ K_tay := le_max_left _ _
  have hδmin_pos : 0 < δ_min := lt_min hd₀_pos (lt_min hδs_pos zero_lt_one)
  have hc₀_pos : 0 < c₀ :=
    lt_min (by norm_num) (lt_min (half_pos hε₀_pos) (half_pos S.r_star_pos))
  have hc₀_le_quarter : c₀ ≤ 1 / 4 := min_le_left _ _
  have hc₀_le_ε₀ : 2 * c₀ ≤ ε₀ := by
    have h : c₀ ≤ ε₀ / 2 := le_trans (min_le_right _ _) (min_le_left _ _)
    linarith
  have hc₀_le_rstar : c₀ ≤ S.r_star / 2 :=
    le_trans (min_le_right _ _) (min_le_right _ _)
  have hctay_pos : 0 < c_tay := half_pos hc₀_pos
  have hctay_lt : c_tay < S.r_star / 2 :=
    lt_of_lt_of_le (half_lt_self hc₀_pos) hc₀_le_rstar
  have hCtay_ge_one : 1 ≤ C_tay := le_max_left _ _
  have hCtay_ge_coeff : 512 * C_cp / (9 * c₀ ^ 2) ≤ C_tay := le_max_right _ _
  have hCtay_pos : 0 < C_tay := lt_of_lt_of_le zero_lt_one hCtay_ge_one
  refine ⟨L, K_tay, c_tay, C_tay, hL₀_le, hk₀_le_Ktay, hctay_pos, hctay_lt, hCtay_pos, ?_⟩
  intro N hN k x t hk ht_pos ht_lt hzb hΔ
  have hk₀ : criticalDepthThreshold S ≤ k := le_trans hk₀_le_Ktay hk
  have hNk_ge : 1 ≤ N k := hN.one_le k hk₀
  have hNk_pos : 0 < N k := lt_of_lt_of_le zero_lt_one hNk_ge
  have hexp_pos : 0 < Real.exp (-k) := Real.exp_pos (-k)
  have hexp_lt_δmin : Real.exp (-k) < δ_min := by
    have hk_log : -Real.log δ_min + 1 ≤ k := le_trans (le_max_right _ _) hk
    have hneg_k : -k < Real.log δ_min := by linarith
    calc
      Real.exp (-k) < Real.exp (Real.log δ_min) := Real.exp_lt_exp.mpr hneg_k
      _ = δ_min := Real.exp_log hδmin_pos
  have hexp_lt_d₀ : Real.exp (-k) < d₀ := lt_of_lt_of_le hexp_lt_δmin (min_le_left _ _)
  have hexp_lt_δs : Real.exp (-k) < δ_star :=
    lt_of_lt_of_le hexp_lt_δmin (le_trans (min_le_right _ _) (min_le_left _ _))
  have hexp_lt_one : Real.exp (-k) < 1 :=
    lt_of_lt_of_le hexp_lt_δmin (le_trans (min_le_right _ _) (min_le_right _ _))

  
  let b : ℝ := bootConeCost S δ_b L β₁ N k x
  let V_set : Set ℝ := { v : ℝ | ∃ s : ℂ,
    Real.exp (-k) / 20 ≤ wallDepth S s ∧
    wallDepth S s ≤ δ_b ∧
    |s.re - x| ≤ L * wallDepth S s ∧
    v = (wallDepth S s * shapeModulus S s) /
      (N k * (wallDepth S s / Real.exp (-k)) ^ β₁) }
  have hb_eq : b = 1 + sSup V_set := rfl
  have hb_ge_one : 1 ≤ b := by
    rw [hb_eq]
    have hsSup_nn : 0 ≤ sSup V_set := by
      apply Real.sSup_nonneg
      rintro v ⟨s, hlo, _, _, rfl⟩
      have hw_pos : 0 < wallDepth S s := lt_of_lt_of_le (by positivity) hlo
      have hsm_nn : 0 ≤ shapeModulus S s := le_trans (norm_nonneg _) (le_max_left _ _)
      have hrp_pos : 0 < (wallDepth S s / Real.exp (-k)) ^ β₁ :=
        Real.rpow_pos_of_pos (div_pos hw_pos hexp_pos) β₁
      exact div_nonneg (mul_nonneg hw_pos.le hsm_nn) (mul_nonneg hNk_pos.le hrp_pos.le)
    linarith
  have hV_bdd : BddAbove V_set := by
    let φ_box : ℝ × ℝ → ℂ := fun p => (p.1 : ℂ) + (p.2 : ℂ) * Complex.I
    have hφ_cont : Continuous φ_box :=
      (Complex.continuous_ofReal.comp continuous_fst).add
        ((Complex.continuous_ofReal.comp continuous_snd).mul continuous_const)
    let R_box : Set ℂ := φ_box ''
      (Set.Icc (x - L * δ_b) (x + L * δ_b) ×ˢ Set.Icc (S.H - δ_b) (S.H - Real.exp (-k) / 20))
    have hR_comp : IsCompact R_box :=
      (isCompact_Icc.prod isCompact_Icc).image hφ_cont
    have hR_sub : R_box ⊆ horizStrip S.H := by
      rintro z ⟨⟨u, v⟩, ⟨_, hv⟩, rfl⟩
      have hz_im : (φ_box (u, v)).im = v := by simp [φ_box]
      show |(φ_box (u, v)).im| < S.H
      rw [hz_im, abs_lt]
      rcases hv with ⟨hv_lo, hv_hi⟩
      constructor <;> linarith [S.H_pos, hδb_lt]
    have hSM_cont : ContinuousOn (shapeModulus S) R_box := by
      have h_on_strip : ContinuousOn (shapeModulus S) (horizStrip S.H) :=
        ContinuousOn.sup S.f_holo.continuousOn.norm
          (Real.continuous_sqrt.comp_continuousOn S.q_holo.continuousOn.norm)
      exact h_on_strip.mono hR_sub
    obtain ⟨M_raw, hM_raw⟩ := hR_comp.bddAbove_image hSM_cont
    let M₀ : ℝ := max M_raw 0
    refine ⟨δ_b * M₀ / (1 / 20 : ℝ) ^ β₁, ?_⟩
    rintro v ⟨s, hlo, hhi, hre, rfl⟩
    have hw_pos : 0 < wallDepth S s := lt_of_lt_of_le (by positivity) hlo
    have hs_mem : s ∈ R_box := by
      refine ⟨(s.re, s.im), ⟨?_, ?_⟩, ?_⟩
      · have hre' : |s.re - x| ≤ L * δ_b :=
          le_trans hre (mul_le_mul_of_nonneg_left hhi hL_pos.le)
        rw [abs_sub_le_iff] at hre'
        exact ⟨by linarith, by linarith⟩
      · dsimp [wallDepth] at hlo hhi
        exact ⟨by linarith, by linarith⟩
      · simp [φ_box, Complex.re_add_im]
    have hSM_le : shapeModulus S s ≤ M₀ :=
      le_trans (hM_raw (Set.mem_image_of_mem _ hs_mem)) (le_max_left _ _)
    have hnum_le : wallDepth S s * shapeModulus S s ≤ δ_b * M₀ :=
      mul_le_mul hhi hSM_le (le_trans (norm_nonneg _) (le_max_left _ _)) hδb_pos.le
    have hrat_ge : (1 / 20 : ℝ) ≤ wallDepth S s / Real.exp (-k) := by
      have h1 := div_le_div_of_nonneg_right hlo hexp_pos.le
      have h2 : (Real.exp (-k) / 20) / Real.exp (-k) = (1 / 20 : ℝ) := by
        field_simp [hexp_pos.ne']
      linarith
    have hrp_ge : (1 / 20 : ℝ) ^ β₁ ≤ (wallDepth S s / Real.exp (-k)) ^ β₁ :=
      Real.rpow_le_rpow (by norm_num) hrat_ge hβ₁_pos.le
    have hrp20_pos : 0 < (1 / 20 : ℝ) ^ β₁ := Real.rpow_pos_of_pos (by norm_num) β₁
    have hden_ge : (1 / 20 : ℝ) ^ β₁ ≤ N k * (wallDepth S s / Real.exp (-k)) ^ β₁ := by
      calc
        (1 / 20 : ℝ) ^ β₁ = 1 * (1 / 20 : ℝ) ^ β₁ := (one_mul _).symm
        _ ≤ N k * (wallDepth S s / Real.exp (-k)) ^ β₁ :=
            mul_le_mul hNk_ge hrp_ge hrp20_pos.le hNk_pos.le
    exact le_trans
      (div_le_div_of_nonneg_right hnum_le (le_trans hrp20_pos.le hden_ge))
      (div_le_div_of_nonneg_left (mul_nonneg hδb_pos.le (le_max_right _ _)) hrp20_pos hden_ge)

  let d : ℝ := Real.exp (-k) / 2
  let B : ℝ := N k * b
  let r : ℝ := c₀ * Real.exp (-k) / B
  let ε : ℝ := 2 * c₀
  have hd_pos : 0 < d := half_pos hexp_pos
  have hd_lt_d₀ : d < d₀ := lt_trans (half_lt_self hexp_pos) hexp_lt_d₀
  have hd_le_one : d ≤ 1 := by dsimp [d]; linarith
  have hb_pos : 0 < b := lt_of_lt_of_le zero_lt_one hb_ge_one
  have hB_ge : 1 ≤ B := by
    calc
      (1 : ℝ) = 1 * 1 := by norm_num
      _ ≤ N k * b := mul_le_mul hNk_ge hb_ge_one zero_le_one hNk_pos.le
  have hB_pos : 0 < B := lt_of_lt_of_le zero_lt_one hB_ge
  have hr_pos : 0 < r := div_pos (mul_pos hc₀_pos hexp_pos) hB_pos
  have hr_le_d : r ≤ 1 * d := by
    have hr_eq : r = (2 * c₀ / B) * d := by
      dsimp [r, d]
      ring
    have hcoef : 2 * c₀ / B ≤ 1 := by
      rw [div_le_iff₀ hB_pos]
      linarith
    rw [hr_eq]
    exact mul_le_mul_of_nonneg_right hcoef hd_pos.le
  have hε_pos : 0 < ε := by dsimp [ε]; positivity
  have hcone_hyp : ∀ s : ℂ, d / 10 ≤ wallDepth S s → wallDepth S s ≤ δ_b →
      |s.re - x| ≤ L_cp * wallDepth S s →
      r * shapeModulus S s ≤ ε * (d / wallDepth S s) ^ α₁ := by
    intro s hlo hhi hre
    have hlo20 : Real.exp (-k) / 20 ≤ wallDepth S s := by
      dsimp [d] at hlo
      linarith
    have hw_pos : 0 < wallDepth S s := lt_of_lt_of_le (by positivity) hlo20
    have hre_L : |s.re - x| ≤ L * wallDepth S s :=
      le_trans hre (mul_le_mul_of_nonneg_right hLcp_le hw_pos.le)
    have hv_mem : (wallDepth S s * shapeModulus S s) /
        (N k * (wallDepth S s / Real.exp (-k)) ^ β₁) ∈ V_set :=
      ⟨s, hlo20, hhi, hre_L, rfl⟩
    have hv_le_b : (wallDepth S s * shapeModulus S s) /
        (N k * (wallDepth S s / Real.exp (-k)) ^ β₁) ≤ b := by
      have hv_sup := le_csSup hV_bdd hv_mem
      rw [hb_eq]
      linarith
    have hrp_pos : 0 < (wallDepth S s / Real.exp (-k)) ^ β₁ :=
      Real.rpow_pos_of_pos (div_pos hw_pos hexp_pos) β₁
    have hden_pos : 0 < N k * (wallDepth S s / Real.exp (-k)) ^ β₁ :=
      mul_pos hNk_pos hrp_pos
    have hmul_B : wallDepth S s * shapeModulus S s ≤
        B * (wallDepth S s / Real.exp (-k)) ^ β₁ := by
      have h1 := (div_le_iff₀ hden_pos).mp hv_le_b
      dsimp [B]
      linarith
    have hscale_pos : 0 < c₀ * Real.exp (-k) / (B * wallDepth S s) :=
      div_pos (mul_pos hc₀_pos hexp_pos) (mul_pos hB_pos hw_pos)
    have hr_step1 : r * shapeModulus S s ≤
        c₀ * (Real.exp (-k) / wallDepth S s) * (wallDepth S s / Real.exp (-k)) ^ β₁ := by
      have h1 := mul_le_mul_of_nonneg_left hmul_B hscale_pos.le
      have hlhs : (c₀ * Real.exp (-k) / (B * wallDepth S s)) *
          (wallDepth S s * shapeModulus S s) = r * shapeModulus S s := by
        dsimp [r]
        field_simp [hB_pos.ne', hw_pos.ne']
      have hrhs : (c₀ * Real.exp (-k) / (B * wallDepth S s)) *
          (B * (wallDepth S s / Real.exp (-k)) ^ β₁) =
          c₀ * (Real.exp (-k) / wallDepth S s) * (wallDepth S s / Real.exp (-k)) ^ β₁ := by
        field_simp [hB_pos.ne', hw_pos.ne']
      rw [hlhs, hrhs] at h1
      exact h1
    let p : ℝ := Real.exp (-k) / wallDepth S s
    have hp_pos : 0 < p := div_pos hexp_pos hw_pos
    have hp_inv : wallDepth S s / Real.exp (-k) = p⁻¹ := by
      dsimp [p]
      rw [inv_div]
    have hp_rpow : p * (wallDepth S s / Real.exp (-k)) ^ β₁ = p ^ α₁ := by
      rw [hp_inv, Real.inv_rpow hp_pos.le]
      have hexp_sum : α₁ + β₁ = 1 := by dsimp [α₁]; ring
      have hp_split : p = p ^ α₁ * p ^ β₁ := by
        calc
          p = p ^ (1 : ℝ) := (Real.rpow_one p).symm
          _ = p ^ (α₁ + β₁) := by rw [hexp_sum]
          _ = p ^ α₁ * p ^ β₁ := Real.rpow_add hp_pos α₁ β₁
      have hpβ_ne : p ^ β₁ ≠ 0 := (Real.rpow_pos_of_pos hp_pos β₁).ne'
      calc
        p * (p ^ β₁)⁻¹ = (p ^ α₁ * p ^ β₁) * (p ^ β₁)⁻¹ :=
          congr_arg (fun u => u * (p ^ β₁)⁻¹) hp_split
        _ = p ^ α₁ * (p ^ β₁ * (p ^ β₁)⁻¹) := by ring
        _ = p ^ α₁ := by rw [mul_inv_cancel₀ hpβ_ne, mul_one]
    have hp_le_two : p ^ α₁ ≤ 2 * (d / wallDepth S s) ^ α₁ := by
      have hp_two : p = 2 * (d / wallDepth S s) := by
        dsimp [p, d]
        ring
      have h2_le : (2 : ℝ) ^ α₁ ≤ 2 := by
        calc
          (2 : ℝ) ^ α₁ ≤ (2 : ℝ) ^ (1 : ℝ) :=
            Real.rpow_le_rpow_of_exponent_le (by norm_num) hα₁_lt.le
          _ = 2 := Real.rpow_one 2
      rw [hp_two, Real.mul_rpow (by norm_num) (div_nonneg hd_pos.le hw_pos.le)]
      exact mul_le_mul_of_nonneg_right h2_le
        (Real.rpow_nonneg (div_nonneg hd_pos.le hw_pos.le) α₁)
    calc
      r * shapeModulus S s ≤ c₀ * (p * (wallDepth S s / Real.exp (-k)) ^ β₁) := by
        dsimp [p]
        linarith [hr_step1]
      _ = c₀ * p ^ α₁ := by rw [hp_rpow]
      _ ≤ c₀ * (2 * (d / wallDepth S s) ^ α₁) :=
        mul_le_mul_of_nonneg_left hp_le_two hc₀_pos.le
      _ = ε * (d / wallDepth S s) ^ α₁ := by dsimp [ε]; ring

  
  obtain ⟨s_tilde, hs_holo, hs_props⟩ :=
    hCP d x r ε hd_pos hd_lt_d₀ hr_pos hr_le_d hε_pos hc₀_le_ε₀ hcone_hyp
  let y : ℂ := bootRowPt S k x
  let h_y : ℂ → ℂ := fun w => s_tilde (y, w) - y
  let R₀ : ℝ := (3 / 4 : ℝ) * r
  let M_err : ℝ := 9 * C_cp * c₀ ^ 2 * Real.exp (-k)
  have hR₀_pos : 0 < R₀ := by dsimp [R₀]; positivity
  have hR₀_lt : R₀ < r := by dsimp [R₀]; linarith
  have hM_nonneg : 0 ≤ M_err := by dsimp [M_err]; positivity
  have hy_re : y.re = x := by
    simp only [y, bootRowPt, Complex.add_re, Complex.ofReal_re, Complex.mul_re,
      Complex.ofReal_im, Complex.I_re, Complex.I_im, mul_zero]
    ring
  have hy_im : y.im = S.H - Real.exp (-k) := by
    simp only [y, bootRowPt, Complex.add_im, Complex.ofReal_im, Complex.mul_im,
      Complex.ofReal_re, Complex.I_re, Complex.I_im, mul_one, mul_zero, add_zero, zero_add]
  have hy_depth : S.H - y.im = Real.exp (-k) := by rw [hy_im]; ring
  have hy_im_pos : 0 < y.im := by
    rw [hy_im]
    linarith [hδs_lt, hδb_lt]
  have hy_strip : y ∈ horizStrip S.H := by
    show |y.im| < S.H
    rw [hy_im, abs_lt]
    constructor <;> linarith [hδs_lt, hδb_lt, hexp_pos]
  have h_two_rpow : 1 < ((S.H - y.im) / d) ^ α₁ := by
    have hquot : (S.H - y.im) / d = 2 := by
      rw [hy_depth]
      dsimp [d]
      field_simp [hexp_pos.ne']
    rw [hquot]
    exact Real.one_lt_rpow (by norm_num) (by linarith)
  have hy_cone_mem : ∀ w ∈ Metric.ball (0 : ℂ) r,
      d < S.H - y.im ∧ S.H - y.im < δ_star ∧
      |y.re - x| < 1 * (S.H - y.im) ∧
      ‖w‖ < r * ((S.H - y.im) / d) ^ α₁ := by
    intro w hw
    have hw_lt : ‖w‖ < r := by simpa using hw
    refine ⟨?_, ?_, ?_, ?_⟩
    · rw [hy_depth]; dsimp [d]; linarith
    · rw [hy_depth]; exact hexp_lt_δs
    · rw [hy_re, sub_self, abs_zero, hy_depth]; linarith
    · calc
        ‖w‖ < r := hw_lt
        _ = r * 1 := (mul_one r).symm
        _ < r * ((S.H - y.im) / d) ^ α₁ :=
            mul_lt_mul_of_pos_left h_two_rpow hr_pos
  have hh_holo : DifferentiableOn ℂ h_y (Metric.ball (0 : ℂ) r) := by
    have hcomp : DifferentiableOn ℂ (fun w : ℂ => s_tilde (y, w)) (Metric.ball (0 : ℂ) r) := by
