            by_contra hle
            have hη_le_n : η_pure N_cap om ≤ n := not_lt.mp hle
            have hη_lt_cap : η_pure N_cap om < N_cap := lt_of_le_of_lt hη_le_n hn
            have hspec : T_pure N_cap om ≤ η_pure N_cap om ∧
