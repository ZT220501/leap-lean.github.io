          mul_ne_zero (mul_ne_zero two_ne_zero (Complex.ofReal_ne_zero.mpr Real.pi_ne_zero))
            Complex.I_ne_zero
        rw [h_integrand, hcauchy]
        exact inv_mul_cancel_left₀ h2pi_ne (α ^ k)
    choose L_t u_t hLt_rad hut_holo hut_nz hft_prod using h_slice_factor
    have hp_fn_eval :
        ∀ (k : ℕ) (t : ℂ) (ht : t ∈ D_t),
          p_fn k t = ((L_t t ht).map (fun α => α ^ k)).sum := by
      intro k t ht
      let L := L_t t ht
      let u := u_t t ht
      have hL_rad := hLt_rad t ht
      have hu_holo := hut_holo t ht
      have hu_nz := hut_nz t ht
