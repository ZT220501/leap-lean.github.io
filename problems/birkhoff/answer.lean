          rw [hJ_succ_eq]
          exact le_trans (hSolver.1 (a j) (b j) t hContr_j).1 hRes_j
        have h_contr_all : ∀ m < j + 1,
            IsRefSteepContractivePt X P (a m) (b m) t ∧
            ‖J_step (m + 1) - J_step m‖ ≤
