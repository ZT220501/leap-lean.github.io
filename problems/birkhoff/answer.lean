theorem stationary_q_mesh_contraction (Ω : Set Plane)
    (B : AnalyticBoundaryData Ω)
    (S : GlancingScalePackage B) :
    StationaryMeshProp B S :=
by
  
  
  
  have hFlux : SqmcFluxInvProp := by
    intro q t₀ hq2 ht₀_ne
    have ht₀_c_ne : (t₀ : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr ht₀_ne
    have h_ell : ∀ w : ℂ, ‖4 * w - 1‖ ≤ 1 / 4 →
        w ≠ 0 ∧ ‖w⁻¹‖ ≤ 6 ∧ 2 ≤ (w⁻¹).re := by
      intro w hw
      have h4w : 3 / 4 ≤ 4 * ‖w‖ := by
        have h1 : (1 : ℝ) = ‖(1 : ℂ)‖ := by norm_num
        have htri : ‖(1 : ℂ)‖ ≤ ‖4 * w‖ + ‖4 * w - 1‖ := by
          have heq : (1 : ℂ) = 4 * w - (4 * w - 1) := by ring
          nth_rw 1 [heq]
          exact norm_sub_le (4 * w) (4 * w - 1)
        have h4norm : ‖(4 : ℂ) * w‖ = 4 * ‖w‖ := by
          rw [norm_mul]
          norm_num
        linarith
      have hw_norm : 3 / 16 ≤ ‖w‖ := by linarith
      have hw_pos : 0 < ‖w‖ := by linarith
      have hw_ne : w ≠ 0 := norm_pos_iff.mp hw_pos
      have h_inv_diff : w⁻¹ - 4 = -(4 * w - 1) / w := by
        field_simp [hw_ne]
        ring
      have h_inv_dist : ‖w⁻¹ - 4‖ ≤ 4 / 3 := by
        rw [h_inv_diff, norm_div, norm_neg]
        rw [div_le_iff₀ hw_pos]
        linarith
      have h_inv_norm : ‖w⁻¹‖ ≤ 6 := by
        have htri : ‖w⁻¹‖ ≤ ‖w⁻¹ - 4‖ + ‖(4 : ℂ)‖ := by
          have heq : w⁻¹ = (w⁻¹ - 4) + 4 := by ring
          nth_rw 1 [heq]
          exact norm_add_le (w⁻¹ - 4) 4
        have h4 : ‖(4 : ℂ)‖ = 4 := by norm_num
        linarith
      have h_inv_re : 2 ≤ (w⁻¹).re := by
        have hre_abs : |(w⁻¹ - 4).re| ≤ ‖w⁻¹ - 4‖ := Complex.abs_re_le_norm (w⁻¹ - 4)
        have hre_sub : (w⁻¹ - 4).re = (w⁻¹).re - 4 := by simp
        have hre_low : -(4 / 3 : ℝ) ≤ (w⁻¹ - 4).re := by
          linarith [neg_le_of_abs_le hre_abs]
        linarith
      exact ⟨hw_ne, h_inv_norm, h_inv_re⟩
    have h_den : ∀ a : ℕ → ℂ, (∀ j : ℕ, j < q → ‖4 * a j - 1‖ ≤ 1 / 4) →
        2 * (q : ℝ) ≤ ‖∑ j ∈ Finset.range q, (a j)⁻¹‖ ∧
        (∑ j ∈ Finset.range q, (a j)⁻¹) ≠ 0 := by
      intro a ha
      have hre_ge : 2 * (q : ℝ) ≤ (∑ j ∈ Finset.range q, (a j)⁻¹).re := by
        rw [Complex.re_sum]
        have hle : ∑ _j ∈ Finset.range q, (2 : ℝ) ≤ ∑ j ∈ Finset.range q, ((a j)⁻¹).re := by
          apply Finset.sum_le_sum
          intro j hj
          exact (h_ell (a j) (ha j (Finset.mem_range.mp hj))).2.2
        have hconst : ∑ _j ∈ Finset.range q, (2 : ℝ) = 2 * (q : ℝ) := by
          simp [mul_comm]
        linarith
      have hq_pos : (0 : ℝ) < 2 * (q : ℝ) := by
        have : (2 : ℝ) ≤ (q : ℝ) := by exact_mod_cast hq2
        linarith
      have hnorm_ge : 2 * (q : ℝ) ≤ ‖∑ j ∈ Finset.range q, (a j)⁻¹‖ := by
        have habs : |(∑ j ∈ Finset.range q, (a j)⁻¹).re| ≤ ‖∑ j ∈ Finset.range q, (a j)⁻¹‖ :=
          Complex.abs_re_le_norm _
        linarith [le_abs_self (∑ j ∈ Finset.range q, (a j)⁻¹).re]
      have hne : (∑ j ∈ Finset.range q, (a j)⁻¹) ≠ 0 :=
        norm_pos_iff.mp (lt_of_lt_of_le hq_pos hnorm_ge)
      exact ⟨hnorm_ge, hne⟩
    have h_step : ∀ (a F : ℕ → ℂ),
        (∀ j : ℕ, j < q → ‖4 * a j - 1‖ ≤ 1 / 4) →
        ∀ m : ℕ, m < q →
          a m * (sqmcFluxInv q t₀ a F (m + 1) - sqmcFluxInv q t₀ a F m) =
            sqmcFluxInit q t₀ a F + sqmcFluxCumSum t₀ F m := by
      intro a F ha m hm
      have hm_le : m ≤ q := Nat.le_of_lt hm
      have hm1_le : m + 1 ≤ q := hm
      have hdiff : sqmcFluxInv q t₀ a F (m + 1) - sqmcFluxInv q t₀ a F m =
          (a m)⁻¹ * (sqmcFluxInit q t₀ a F + sqmcFluxCumSum t₀ F m) := by
        simp only [sqmcFluxInv, hm_le, hm1_le, ↓reduceIte, Finset.sum_range_succ]
        ring
      have ham_ne : a m ≠ 0 := (h_ell (a m) (ha m hm)).1
      rw [hdiff, mul_inv_cancel_left₀ ham_ne]
    refine ⟨?_, ?_, ?_, ?_, ?_⟩
    · intro a F ha
      obtain ⟨_, hDa_ne⟩ := h_den a ha
      refine ⟨⟨?_, ?_, ?_⟩, ?_, ?_⟩
      · simp [sqmcFluxInv]
      · simp only [sqmcFluxInv, le_refl, ↓reduceIte]
        have hsplit : ∑ j ∈ Finset.range q,
            (a j)⁻¹ * (sqmcFluxInit q t₀ a F + sqmcFluxCumSum t₀ F j) =
            (∑ j ∈ Finset.range q, (a j)⁻¹) * sqmcFluxInit q t₀ a F +
            ∑ j ∈ Finset.range q, (a j)⁻¹ * sqmcFluxCumSum t₀ F j := by
          rw [Finset.sum_mul, ← Finset.sum_add_distrib]
          refine Finset.sum_congr rfl fun j _ => ?_
          ring
        rw [hsplit]
        dsimp [sqmcFluxInit]
        field_simp [hDa_ne]
        ring
      · intro k hk
        have hnk : ¬ (k ≤ q) := not_le.mpr hk
        simp [sqmcFluxInv, hnk]
      · intro j hj1
