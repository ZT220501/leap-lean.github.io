  let δ₃ : ℝ := δ₂ / 2
  let r_plus : ℝ := r + ε_r / 2
  have hδ₃_pos : 0 < δ₃ := by dsimp [δ₃]; linarith
  have hr_plus_pos : 0 < r_plus := by dsimp [r_plus]; linarith
  let K_w : Set ℂ := Metric.closedBall w₂ δ₃
  let K_ζ : Set ℂ := Metric.closedBall (0 : ℂ) r_plus
