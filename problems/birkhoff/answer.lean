      change |(sliceImpactSeq S P.N i.val y).im| < S.H at him
      simp only [sliceShapeDepth]
      exact ⟨by linarith, by linarith [abs_nonneg (sliceImpactSeq S P.N i.val y).im]⟩
    have hexpM2_le : Real.exp (-M ^ 2) ≤ 1 := by
      rw [Real.exp_le_one_iff]; nlinarith
    have hStepBounds : ∀ (n : ℕ) (om : WalkSpace),
        ‖Δ n om‖ ≤ S.H ∧ ‖Δ n om‖ ^ 2 ≤ q_fn (walkPos ρ om n) := by
      intro n om
      have hy : walkPos ρ om n ∈ Ω_reg := (hTk.closedBall_in_reg hAdm om n).1
      have hρ_pos : 0 < ρ (walkPos ρ om n) := (hTk.closedBall_in_reg hAdm om n).2.1
      let y := walkPos ρ om n
      let z : ℂ := (ρ y : ℂ) * Complex.exp ((om (n + 1) : ℂ) * Complex.I)
      have hz_norm : ‖z‖ = ρ y := by
        simp only [z, norm_mul, Complex.norm_real, Real.norm_eq_abs,
          Complex.norm_exp_ofReal_mul_I, mul_one]
        exact abs_of_pos hρ_pos
      have hSmall := hAdm.small_shape_step y hy z hz_norm.le i
      rcases hDepth_bounds y hy with ⟨hD0, hDH⟩
      have hNormH : ‖Δ n om‖ ≤ S.H := by
        change ‖sliceImpactSeq S P.N i.val (y + z) - sliceImpactSeq S P.N i.val y‖ ≤ S.H
        calc
          ‖sliceImpactSeq S P.N i.val (y + z) - sliceImpactSeq S P.N i.val y‖
            ≤ Real.exp (-M ^ 2) * sliceShapeDepth S P i y := hSmall
          _ ≤ 1 * S.H := mul_le_mul hexpM2_le hDH hD0 zero_le_one
          _ = S.H := one_mul S.H
      have hTay := hAdm.taylor_impact y hy z hz_norm.le i
      have hTri : ‖Δ n om‖ ≤
          ‖deriv (sliceImpactSeq S P.N i.val) y‖ * ρ y +
            (1 / 2 : ℝ) * Real.exp (-M ^ 3) * ρ y := by
        have h1 : ‖sliceImpactSeq S P.N i.val (y + z) - sliceImpactSeq S P.N i.val y‖ ≤
            ‖sliceImpactSeq S P.N i.val (y + z) - sliceImpactSeq S P.N i.val y -
                deriv (sliceImpactSeq S P.N i.val) y * z‖ +
              ‖deriv (sliceImpactSeq S P.N i.val) y * z‖ := by
          simpa only [sub_add_cancel] using
            norm_add_le (sliceImpactSeq S P.N i.val (y + z) - sliceImpactSeq S P.N i.val y -
                deriv (sliceImpactSeq S P.N i.val) y * z)
              (deriv (sliceImpactSeq S P.N i.val) y * z)
        rw [norm_mul, hz_norm] at h1
        change ‖sliceImpactSeq S P.N i.val (y + z) - sliceImpactSeq S P.N i.val y‖ ≤ _
        linarith
      have hSq : ‖Δ n om‖ ^ 2 ≤ q_fn y := by
        have h0 : 0 ≤ ‖Δ n om‖ := norm_nonneg _
        have hTwoSq : (‖deriv (sliceImpactSeq S P.N i.val) y‖ * ρ y +
            (1 / 2 : ℝ) * Real.exp (-M ^ 3) * ρ y) ^ 2 ≤
            2 * (‖deriv (sliceImpactSeq S P.N i.val) y‖ * ρ y) ^ 2 +
              2 * ((1 / 2 : ℝ) * Real.exp (-M ^ 3) * ρ y) ^ 2 := by
          nlinarith [sq_nonneg (‖deriv (sliceImpactSeq S P.N i.val) y‖ * ρ y -
            (1 / 2 : ℝ) * Real.exp (-M ^ 3) * ρ y)]
        have hexp_sq : (Real.exp (-M ^ 3)) ^ 2 = Real.exp (-2 * M ^ 3) := by
          rw [sq, ← Real.exp_add]; congr 1; ring
        have hPosExp : 0 ≤ Real.exp (-2 * M ^ 3) * (ρ y) ^ 2 := by positivity
        have hTwoSq' : 2 * (‖deriv (sliceImpactSeq S P.N i.val) y‖ * ρ y) ^ 2 +
            2 * ((1 / 2 : ℝ) * Real.exp (-M ^ 3) * ρ y) ^ 2 =
            2 * ‖deriv (sliceImpactSeq S P.N i.val) y‖ ^ 2 * (ρ y) ^ 2 +
              (1 / 2 : ℝ) * (Real.exp (-M ^ 3)) ^ 2 * (ρ y) ^ 2 := by ring
        calc
          ‖Δ n om‖ ^ 2
            ≤ (‖deriv (sliceImpactSeq S P.N i.val) y‖ * ρ y +
                (1 / 2 : ℝ) * Real.exp (-M ^ 3) * ρ y) ^ 2 :=
              pow_le_pow_left₀ h0 hTri 2
          _ ≤ 2 * ‖deriv (sliceImpactSeq S P.N i.val) y‖ ^ 2 * (ρ y) ^ 2 +
                (1 / 2 : ℝ) * (Real.exp (-M ^ 3)) ^ 2 * (ρ y) ^ 2 := by linarith
          _ = (2 * ‖deriv (sliceImpactSeq S P.N i.val) y‖ ^ 2 +
                (1 / 2 : ℝ) * Real.exp (-2 * M ^ 3)) * (ρ y) ^ 2 := by
              rw [hexp_sq]; ring
          _ ≤ q_fn y := by dsimp only [q_fn]; linarith
      exact ⟨hNormH, hSq⟩
    let K_i : ℂ → ℂ → ℂ := fun y z =>
      sliceImpactSeq S P.N i.val z - sliceImpactSeq S P.N i.val y
    have hKi_meas : Measurable (Set.indicator (Ω_reg ×ˢ Ω_reg) (fun p : ℂ × ℂ => K_i p.1 p.2)) := by
      have hCont : ContinuousOn (fun p : ℂ × ℂ => K_i p.1 p.2) (Ω_reg ×ˢ Ω_reg) := by
        have hsCont : ContinuousOn (sliceImpactSeq S P.N i.val) Ω_reg :=
          (hTk.impact_holo i).continuousOn.mono hRegSub
        exact (hsCont.comp continuousOn_snd (fun p hp => hp.2)).sub
          (hsCont.comp continuousOn_fst (fun p hp => hp.1))
