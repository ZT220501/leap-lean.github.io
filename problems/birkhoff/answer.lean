    have hj12 : j₁ ≤ j₂ := max_le (hl.trans (by linarith)) (by linarith)
    have hj_len : j₂ - j₁ ≤ 2 * (A + 1) := by
      have : l - A - 1 ≤ j₁ := le_max_right _ _
