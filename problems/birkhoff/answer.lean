      ∀ κ : ℝ, K₀ ≤ κ → κ ^ (1 / 4 : ℝ) ≤ rowMomentF S κ →
        c_jmp * rowMomentF S κ ≤
          rowLogMaxF (κ + C_jmp * Real.log κ) - rowLogMaxF (κ - C_jmp * Real.log κ) := by
    have hlog_le_two_sqrt : ∀ k : ℝ, 0 < k → Real.log k ≤ 2 * Real.sqrt k := by
      intro k hk
