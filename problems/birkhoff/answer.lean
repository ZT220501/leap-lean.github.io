      (L.S_star_holo.deriv hInf_open).continuousOn.continuousAt (hInf_open.mem_nhds hY₀_inf)
    obtain ⟨ρ_S, hρ_S_pos, hρ_S⟩ :=
      Metric.continuousAt_iff.mp hS_cont_Y₀ (δ₁ / 2) (by positivity)
    obtain ⟨ρ_J, hρ_J_pos, hρ_J⟩ :=
      Metric.continuousAt_iff.mp hdS_cont_Y₀ (δ₁ / 2) (by positivity)
    let r₀ : ℝ := min 1 (min (ρ_S / 2) (ρ_J / 2))
    have hr₀_pos : 0 < r₀ := lt_min zero_lt_one (lt_min (by positivity) (by positivity))
    have hr₀_le1 : r₀ ≤ 1 := min_le_left _ _
    have hr₀_lt_ρS : r₀ < ρ_S := by
      have : r₀ ≤ ρ_S / 2 := le_trans (min_le_right _ _) (min_le_left _ _)
      linarith
    have hr₀_lt_ρJ : r₀ < ρ_J := by
      have : r₀ ≤ ρ_J / 2 := le_trans (min_le_right _ _) (min_le_right _ _)
      linarith
    have h_cb2r₀_sub : Metric.closedBall Y₀ (2 * r₀) ⊆
        { Z : ℂ | D₀ < -Z.im ∧ |Z.re| < (A + 2) * (-Z.im) } :=
      Subset.trans (Metric.closedBall_subset_closedBall (by linarith)) hBall2
    obtain ⟨K₀, hK₀⟩ := L.local_holo_and_recurrence Y₀ r₀ hr₀_pos h_cb2r₀_sub
    let a_seq : ℕ → ℂ :=
      fun k => L.T_star / ((seq.ℓ_seq (L.φ k) * seq.m_seq (L.φ k) : ℝ) : ℂ)
    have ha_ne : ∀ k : ℕ, a_seq k ≠ 0 := by
      intro k
      dsimp [a_seq]
      have hb_pos : 0 < seq.ℓ_seq (L.φ k) * seq.m_seq (L.φ k) :=
        mul_pos (seq.ℓ_pos (L.φ k)) (seq.m_pos (L.φ k))
      exact div_ne_zero L.T_star_ne (Complex.ofReal_ne_zero.mpr hb_pos.ne')
    have ha_tend0 : Filter.Tendsto (fun k : ℕ => ‖a_seq k‖) Filter.atTop (nhds 0) := by
      have hb_sub : Filter.Tendsto
          (fun k : ℕ => seq.ℓ_seq (L.φ k) * seq.m_seq (L.φ k)) Filter.atTop Filter.atTop :=
        seq.b_tendsto.comp L.φ_strictMono.tendsto_atTop
      have h_eq : (fun k : ℕ => ‖a_seq k‖) =
          fun k : ℕ => ‖L.T_star‖ / (seq.ℓ_seq (L.φ k) * seq.m_seq (L.φ k)) := by
        ext k
        dsimp [a_seq]
        have hb_pos : 0 < seq.ℓ_seq (L.φ k) * seq.m_seq (L.φ k) :=
          mul_pos (seq.ℓ_pos (L.φ k)) (seq.m_pos (L.φ k))
        rw [norm_div, Complex.norm_real, Real.norm_of_nonneg hb_pos.le]
      rw [h_eq]
      exact tendsto_const_nhds.div_atTop hb_sub
    let B_r₀ : Set ℂ := Metric.ball Y₀ r₀
    let K_32r : Set ℂ := Metric.closedBall Y₀ (3 * r₀ / 2)
    have hK32r_sub_2r : K_32r ⊆ Metric.ball Y₀ (2 * r₀) :=
      Metric.closedBall_subset_ball (by linarith)
    have hK32r_sub_Inf : K_32r ⊆ { Z : ℂ | D₀ < -Z.im ∧ |Z.re| < (A + 2) * (-Z.im) } :=
      Subset.trans (Metric.closedBall_subset_closedBall (by linarith)) h_cb2r₀_sub
    have hBr₀_sub_K32r : B_r₀ ⊆ K_32r :=
      Subset.trans Metric.ball_subset_closedBall
        (Metric.closedBall_subset_closedBall (by linarith))
    have hF_unif_Br₀ : TendstoUniformlyOn L.F_seq L.S_star Filter.atTop B_r₀ :=
      ((tendstoLocallyUniformlyOn_iff_forall_isCompact hInf_open).mp L.F_conv
        K_32r hK32r_sub_Inf (isCompact_closedBall Y₀ (3 * r₀ / 2))).mono hBr₀_sub_K32r
    have hdF_unif_K32r : TendstoUniformlyOn
        (fun k Z => deriv (L.F_seq k) Z) (deriv L.S_star) Filter.atTop K_32r :=
      (tendstoLocallyUniformlyOn_iff_forall_isCompact hInf_open).mp L.F_deriv_conv
        K_32r hK32r_sub_Inf (isCompact_closedBall Y₀ (3 * r₀ / 2))
    have hdS_ucont_K32r : UniformContinuousOn (deriv L.S_star) K_32r :=
      (isCompact_closedBall Y₀ (3 * r₀ / 2)).uniformContinuousOn_of_continuous
        ((L.S_star_holo.deriv hInf_open).continuousOn.mono hK32r_sub_Inf)
    let Δ_seq : ℕ → ℂ → ℂ := fun k Y => (L.F_seq k (Y + a_seq k) - L.F_seq k Y) / a_seq k
    have hΔ_holo : ∀ k ≥ K₀, DifferentiableOn ℂ (Δ_seq k) B_r₀ := by
      intro k hk
      obtain ⟨hFk_holo, ha_lt, _⟩ := hK₀ k hk
      refine DifferentiableOn.div (DifferentiableOn.sub ?_ ?_)
        (differentiableOn_const _) (fun _ _ => ha_ne k)
      · refine hFk_holo.comp (differentiable_id.add (differentiable_const _)).differentiableOn ?_
        intro Y hY
        rw [Metric.mem_ball, dist_eq_norm] at hY ⊢
        have h_rew : Y + a_seq k - Y₀ = (Y - Y₀) + a_seq k := by ring
        rw [h_rew]
        have htri := norm_add_le (Y - Y₀) (a_seq k)
        linarith
      · exact hFk_holo.mono (Metric.ball_subset_ball (by linarith))
    have hΔ_unif_Br₀ : TendstoUniformlyOn Δ_seq (deriv L.S_star) Filter.atTop B_r₀ := by
      rw [Metric.tendstoUniformlyOn_iff]
      intro ε_J hε_J
      obtain ⟨δ_J, hδ_J_pos, hδ_J⟩ :=
        Metric.uniformContinuousOn_iff.mp hdS_ucont_K32r (ε_J / 3) (by positivity)
      have ev_K₀ := Filter.eventually_ge_atTop K₀
      have ev_a := ha_tend0.eventually (gt_mem_nhds hδ_J_pos)
      have ev_dF := (Metric.tendstoUniformlyOn_iff.mp hdF_unif_K32r) (ε_J / 3) (by positivity)
      filter_upwards [ev_K₀, ev_a, ev_dF] with k hkK₀ hka hkdF Y hY
      obtain ⟨hFk_holo, ha_lt, _⟩ := hK₀ k hkK₀
      have hY_K32r : Y ∈ K_32r := hBr₀_sub_K32r hY
      have h_sec := h_secant_bound (L.F_seq k) (Metric.ball Y₀ (2 * r₀))
        Metric.isOpen_ball hFk_holo Y (a_seq k) (deriv L.S_star Y)
        (2 * ε_J / 3) (ha_ne k) (fun θ hθ => by
          have hmul : ‖(θ : ℂ) * a_seq k‖ ≤ ‖a_seq k‖ := by
            rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg hθ.1]
            calc θ * ‖a_seq k‖ ≤ 1 * ‖a_seq k‖ :=
                mul_le_mul_of_nonneg_right hθ.2 (norm_nonneg _)
              _ = ‖a_seq k‖ := one_mul _
          have hz_K32r : Y + (θ : ℂ) * a_seq k ∈ K_32r := by
            rw [Metric.mem_ball, dist_eq_norm] at hY
            rw [Metric.mem_closedBall, dist_eq_norm]
            have h_rew : Y + (θ : ℂ) * a_seq k - Y₀ = (Y - Y₀) + (θ : ℂ) * a_seq k := by ring
            rw [h_rew]
            have htri := norm_add_le (Y - Y₀) ((θ : ℂ) * a_seq k)
            linarith
          refine ⟨hK32r_sub_2r hz_K32r, ?_⟩
          have h1 : ‖deriv (L.F_seq k) (Y + (θ : ℂ) * a_seq k) -
              deriv L.S_star (Y + (θ : ℂ) * a_seq k)‖ < ε_J / 3 := by
            simpa [dist_eq_norm, norm_sub_rev] using hkdF _ hz_K32r
          have h_dist_δ : dist (Y + (θ : ℂ) * a_seq k) Y < δ_J := by
            rw [dist_eq_norm]
            have h_sub : Y + (θ : ℂ) * a_seq k - Y = (θ : ℂ) * a_seq k := by ring
            rw [h_sub]
            exact lt_of_le_of_lt hmul hka
          have h2 : ‖deriv L.S_star (Y + (θ : ℂ) * a_seq k) - deriv L.S_star Y‖ < ε_J / 3 := by
            simpa [dist_eq_norm] using hδ_J _ hz_K32r Y hY_K32r h_dist_δ
          have htri := dist_triangle (deriv (L.F_seq k) (Y + (θ : ℂ) * a_seq k))
            (deriv L.S_star (Y + (θ : ℂ) * a_seq k)) (deriv L.S_star Y)
          rw [dist_eq_norm, dist_eq_norm, dist_eq_norm] at htri
          linarith)
      rw [dist_eq_norm, norm_sub_rev]
      exact lt_of_le_of_lt h_sec (by linarith)

    
    let G_k : ℕ → ℂ → ℂ := fun k Y => deriv (fun J' => p_seq k (L.F_seq k Y, J')) (Δ_seq k Y)
    let G_inf : ℂ → ℂ := fun Y => deriv (fun J' => p_inf (L.S_star Y, J')) (deriv L.S_star Y)
    have hS_Br₀_in : ∀ Y ∈ B_r₀,
        L.S_star Y ∈ Metric.ball S₀ (δ₁ / 2) ∧ deriv L.S_star Y ∈ Metric.ball J₀ (δ₁ / 2) := by
      intro Y hY
      have hd := Metric.mem_ball.mp hY
      exact ⟨hρ_S (lt_trans hd hr₀_lt_ρS), hρ_J (lt_trans hd hr₀_lt_ρJ)⟩
    have h_ev_Gk : ∀ᶠ k in Filter.atTop,
        k ≥ K₀ ∧ k ≥ K_p ∧
        (∀ Y ∈ B_r₀, L.F_seq k Y ∈ Metric.ball S₀ δ₁ ∧ Δ_seq k Y ∈ Metric.ball J₀ δ₁) ∧
        DifferentiableOn ℂ (G_k k) B_r₀ := by
      have ev_K₀ := Filter.eventually_ge_atTop K₀
      have ev_Kp := Filter.eventually_ge_atTop K_p
      have ev_F := (Metric.tendstoUniformlyOn_iff.mp hF_unif_Br₀) (δ₁ / 2) (by positivity)
      have ev_Δ := (Metric.tendstoUniformlyOn_iff.mp hΔ_unif_Br₀) (δ₁ / 2) (by positivity)
      filter_upwards [ev_K₀, ev_Kp, ev_F, ev_Δ] with k hkK₀ hkKp hkF hkΔ
      have h_in : ∀ Y ∈ B_r₀, L.F_seq k Y ∈ Metric.ball S₀ δ₁ ∧ Δ_seq k Y ∈ Metric.ball J₀ δ₁ := by
        intro Y hY
        obtain ⟨hSY, hdSY⟩ := hS_Br₀_in Y hY
        refine ⟨?_, ?_⟩
        · rw [Metric.mem_ball]
          calc dist (L.F_seq k Y) S₀
              ≤ dist (L.F_seq k Y) (L.S_star Y) + dist (L.S_star Y) S₀ := dist_triangle _ _ _
            _ < δ₁ / 2 + δ₁ / 2 := add_lt_add (by simpa [dist_comm] using hkF Y hY) hSY
            _ = δ₁ := add_halves δ₁
        · rw [Metric.mem_ball]
          calc dist (Δ_seq k Y) J₀
              ≤ dist (Δ_seq k Y) (deriv L.S_star Y) + dist (deriv L.S_star Y) J₀ :=
                dist_triangle _ _ _
            _ < δ₁ / 2 + δ₁ / 2 := add_lt_add (by simpa [dist_comm] using hkΔ Y hY) hdSY
            _ = δ₁ := add_halves δ₁
      have hFk_Br₀ : DifferentiableOn ℂ (L.F_seq k) B_r₀ :=
        (hK₀ k hkK₀).1.mono (Metric.ball_subset_ball (by linarith))
      exact ⟨hkK₀, hkKp, h_in,
        h_comp_holo_k k hkKp B_r₀ (L.F_seq k) (Δ_seq k) Metric.isOpen_ball hFk_Br₀
          (hΔ_holo k hkK₀) h_in⟩
    have hdJ_ucont : UniformContinuousOn
        (fun q : ℂ × ℂ => deriv (fun J' => p_inf (q.1, J')) q.2) K_δ₁ :=
      hKδ₁_comp.uniformContinuousOn_of_continuous hdJ_inf_cont
    have hG_unif_Br₀ : TendstoUniformlyOn G_k G_inf Filter.atTop B_r₀ := by
      rw [Metric.tendstoUniformlyOn_iff]
      intro ε_G hε_G
      obtain ⟨δ_G, hδ_G_pos, hδ_G⟩ :=
        Metric.uniformContinuousOn_iff.mp hdJ_ucont (ε_G / 2) (by positivity)
      have ev_dJ := (Metric.tendstoUniformlyOn_iff.mp hdJ_unif) (ε_G / 2) (by positivity)
      have ev_F := (Metric.tendstoUniformlyOn_iff.mp hF_unif_Br₀) δ_G hδ_G_pos
      have ev_Δ := (Metric.tendstoUniformlyOn_iff.mp hΔ_unif_Br₀) δ_G hδ_G_pos
      filter_upwards [h_ev_Gk, ev_dJ, ev_F, ev_Δ] with k hk_ev hkdJ hkF hkΔ Y hY
      have hq_k : (L.F_seq k Y, Δ_seq k Y) ∈ K_δ₁ :=
        ⟨Metric.ball_subset_closedBall (hk_ev.2.2.1 Y hY).1,
          Metric.ball_subset_closedBall (hk_ev.2.2.1 Y hY).2⟩
      have hq_inf : (L.S_star Y, deriv L.S_star Y) ∈ K_δ₁ :=
        ⟨Metric.ball_subset_closedBall (Metric.ball_subset_ball (by linarith) (hS_Br₀_in Y hY).1),
          Metric.ball_subset_closedBall (Metric.ball_subset_ball (by linarith) (hS_Br₀_in Y hY).2)⟩
      have h_dist_q : dist (L.F_seq k Y, Δ_seq k Y) (L.S_star Y, deriv L.S_star Y) < δ_G := by
        rw [Prod.dist_eq, max_lt_iff]
        exact ⟨by simpa [dist_comm] using hkF Y hY, by simpa [dist_comm] using hkΔ Y hY⟩
      have h1 : ‖deriv (fun J' => p_seq k (L.F_seq k Y, J')) (Δ_seq k Y) -
          deriv (fun J' => p_inf (L.F_seq k Y, J')) (Δ_seq k Y)‖ < ε_G / 2 := by
        simpa [dist_eq_norm, norm_sub_rev] using hkdJ _ hq_k
      have h2 : ‖deriv (fun J' => p_inf (L.F_seq k Y, J')) (Δ_seq k Y) -
          deriv (fun J' => p_inf (L.S_star Y, J')) (deriv L.S_star Y)‖ < ε_G / 2 := by
        simpa [dist_eq_norm] using hδ_G _ hq_k _ hq_inf h_dist_q
      have htri := dist_triangle
        (deriv (fun J' => p_seq k (L.F_seq k Y, J')) (Δ_seq k Y))
        (deriv (fun J' => p_inf (L.F_seq k Y, J')) (Δ_seq k Y))
        (deriv (fun J' => p_inf (L.S_star Y, J')) (deriv L.S_star Y))
      rw [dist_eq_norm, dist_eq_norm, dist_eq_norm] at htri
      rw [dist_eq_norm, norm_sub_rev]
      dsimp [G_k, G_inf]
      linarith
    have hG_loc : TendstoLocallyUniformlyOn G_k G_inf Filter.atTop B_r₀ :=
      hG_unif_Br₀.tendstoLocallyUniformlyOn
    have hG_ev_holo : ∀ᶠ k in Filter.atTop, DifferentiableOn ℂ (G_k k) B_r₀ :=
      h_ev_Gk.mono fun _ hk => hk.2.2.2
    have hG_inf_holo : DifferentiableOn ℂ G_inf B_r₀ :=
      hG_loc.differentiableOn hG_ev_holo Metric.isOpen_ball
    let K_half : Set ℂ := Metric.closedBall Y₀ (r₀ / 2)
    have hK_half_sub : K_half ⊆ B_r₀ := Metric.closedBall_subset_ball (by linarith)
    have hdG_unif_half : TendstoUniformlyOn
        (fun k Y => deriv (G_k k) Y) (deriv G_inf) Filter.atTop K_half :=
      (tendstoLocallyUniformlyOn_iff_forall_isCompact Metric.isOpen_ball).mp
        (hG_loc.deriv hG_ev_holo Metric.isOpen_ball) K_half hK_half_sub
        (isCompact_closedBall Y₀ (r₀ / 2))

    
    let D_quo : ℕ → ℂ := fun k => (G_k k Y₀ - G_k k (Y₀ - a_seq k)) / a_seq k
    let R_rhs : ℕ → ℂ :=
      fun k => deriv (fun S' => p_seq k (S', Δ_seq k Y₀)) (L.F_seq k Y₀)
    have hY₀_Br₀ : Y₀ ∈ B_r₀ := Metric.mem_ball_self hr₀_pos
    have h_ev_eq : D_quo =ᶠ[Filter.atTop] R_rhs := by
      filter_upwards [h_ev_Gk] with k ⟨hkK₀, hkKp, h_in_k, _⟩
      obtain ⟨_, h_rec_k⟩ := (hK₀ k hkK₀).2
      have h_rec_Y₀ := h_rec_k Y₀ hY₀_Br₀
      let n := L.φ k
      let ℓ_c : ℂ := (seq.ℓ_seq n : ℂ)
      let m_c : ℂ := (seq.m_seq n : ℂ)
      let t_k : ℂ := L.T_star / m_c
      have hℓ_ne : ℓ_c ≠ 0 := Complex.ofReal_ne_zero.mpr (seq.ℓ_pos n).ne'
      have hm_ne : m_c ≠ 0 := Complex.ofReal_ne_zero.mpr (seq.m_pos n).ne'
      have hΔ_prev : Δ_seq k (Y₀ - a_seq k) =
          (L.F_seq k Y₀ - L.F_seq k (Y₀ - a_seq k)) / a_seq k := by
        dsimp [Δ_seq]
        rw [sub_add_cancel]
      have h_diff_Gk : G_k k Y₀ - G_k k (Y₀ - a_seq k) =
          t_k * deriv (fun s' =>
            P.p_act s' (Δ_seq k Y₀) t_k) (s_base n + ℓ_c * L.F_seq k Y₀) := by
        dsimp [G_k, p_seq]
        rw [hΔ_prev]
        have hr : deriv (fun J' => P.p_act (s_base n + ℓ_c * L.F_seq k Y₀) J' t_k) (Δ_seq k Y₀) -
            t_k * deriv (fun s' => P.p_act s' (Δ_seq k Y₀) t_k) (s_base n + ℓ_c * L.F_seq k Y₀) =
            deriv (fun J' => P.p_act (s_base n + ℓ_c * L.F_seq k (Y₀ - a_seq k)) J' t_k)
              ((L.F_seq k Y₀ - L.F_seq k (Y₀ - a_seq k)) / a_seq k) := h_rec_Y₀
        linear_combination hr
      let φ_inv : ℂ → ℂ := fun s' => (s' - s_base n) / ℓ_c
      have h_pact_eq : (fun s' : ℂ => P.p_act s' (Δ_seq k Y₀) t_k) =
          fun s' : ℂ => p_seq k (φ_inv s', Δ_seq k Y₀) := by
        ext s'
        dsimp [p_seq, φ_inv]
        have hs' : s_base n + ℓ_c * ((s' - s_base n) / ℓ_c) = s' := by
          rw [mul_div_cancel₀ _ hℓ_ne, add_sub_cancel]
        rw [hs']
      have hφ_curr : φ_inv (s_base n + ℓ_c * L.F_seq k Y₀) = L.F_seq k Y₀ := by
        dsimp [φ_inv]
        rw [add_sub_cancel_left, mul_div_cancel_left₀ _ hℓ_ne]
      obtain ⟨hFY₀_in, hΔY₀_in⟩ := h_in_k Y₀ hY₀_Br₀
      have hFY₀_2δ₁ : L.F_seq k Y₀ ∈ Metric.ball S₀ (2 * δ₁) :=
        Metric.ball_subset_ball (by linarith) hFY₀_in
      have hΔY₀_2δ₁ : Δ_seq k Y₀ ∈ Metric.ball J₀ (2 * δ₁) :=
        Metric.ball_subset_ball (by linarith) hΔY₀_in
      have h_slice_S_holo : DifferentiableOn ℂ
          (fun S' => p_seq k (S', Δ_seq k Y₀)) (Metric.ball S₀ (2 * δ₁)) :=
        (hp_seq_holo k hkKp).comp
          (differentiable_id.prodMk (differentiable_const _)).differentiableOn
          (fun _ hS' => ⟨hS', hΔY₀_2δ₁⟩)
      have hd_outer : HasDerivAt (fun S' => p_seq k (S', Δ_seq k Y₀)) (R_rhs k) (L.F_seq k Y₀) :=
        (h_slice_S_holo.differentiableAt (Metric.isOpen_ball.mem_nhds hFY₀_2δ₁)).hasDerivAt
      have hd_inner : HasDerivAt φ_inv (ℓ_c⁻¹) (s_base n + ℓ_c * L.F_seq k Y₀) := by
        have h1 : φ_inv = fun s' : ℂ => (s' - s_base n) * ℓ_c⁻¹ := by
          ext s'; dsimp [φ_inv]; rw [div_eq_mul_inv]
        rw [h1]
        simpa using ((hasDerivAt_id (s_base n + ℓ_c * L.F_seq k Y₀)).sub_const (s_base n)).mul_const
          (ℓ_c⁻¹)
      have hd_comp : HasDerivAt (fun s' => p_seq k (φ_inv s', Δ_seq k Y₀))
          (R_rhs k * ℓ_c⁻¹) (s_base n + ℓ_c * L.F_seq k Y₀) := by
        have hd_outer' : HasDerivAt (fun S' => p_seq k (S', Δ_seq k Y₀)) (R_rhs k)
            (φ_inv (s_base n + ℓ_c * L.F_seq k Y₀)) := by
          rwa [hφ_curr]
        exact hd_outer'.comp (s_base n + ℓ_c * L.F_seq k Y₀) hd_inner
      have h_deriv_chain : deriv (fun s' => P.p_act s' (Δ_seq k Y₀) t_k)
          (s_base n + ℓ_c * L.F_seq k Y₀) = R_rhs k * ℓ_c⁻¹ := by
        rw [h_pact_eq, hd_comp.deriv]
      have h_tk_ak : t_k * ℓ_c⁻¹ = a_seq k := by
        dsimp [t_k, a_seq, ℓ_c, m_c, n]
        push_cast
        field_simp [hℓ_ne, hm_ne]
      have h_prod_ak : t_k * (R_rhs k * ℓ_c⁻¹) = a_seq k * R_rhs k := by
        rw [← h_tk_ak]; ring
      dsimp [D_quo]
      rw [h_diff_Gk, h_deriv_chain, h_prod_ak, mul_div_cancel_left₀ _ (ha_ne k)]

    
    have hD_tend_lhs : Filter.Tendsto D_quo Filter.atTop (nhds (deriv G_inf Y₀)) := by
      rw [Metric.tendsto_atTop]
      intro ε_D hε_D
      have hdG_cont_Y₀ : ContinuousAt (deriv G_inf) Y₀ :=
        (hG_inf_holo.deriv Metric.isOpen_ball).continuousOn.continuousAt
          (Metric.isOpen_ball.mem_nhds hY₀_Br₀)
      obtain ⟨δ_D, hδ_D_pos, hδ_D⟩ :=
        Metric.continuousAt_iff.mp hdG_cont_Y₀ (ε_D / 3) (by positivity)
      have ev_a := ha_tend0.eventually (gt_mem_nhds (lt_min (by positivity : 0 < r₀ / 2) hδ_D_pos))
      have ev_dG := (Metric.tendstoUniformlyOn_iff.mp hdG_unif_half) (ε_D / 3) (by positivity)
      obtain ⟨K_start, hK_start⟩ :=
        Filter.eventually_atTop.mp (hG_ev_holo.and (ev_a.and ev_dG))
      refine ⟨K_start, fun k hk => ?_⟩
      obtain ⟨hGk_holo, hka, hkdG⟩ := hK_start k hk
      have ha_r2 : ‖a_seq k‖ < r₀ / 2 := lt_of_lt_of_le hka (min_le_left _ _)
      have ha_δ : ‖a_seq k‖ < δ_D := lt_of_lt_of_le hka (min_le_right _ _)
      have h_sec := h_secant_bound (G_k k) B_r₀ Metric.isOpen_ball hGk_holo
        (Y₀ - a_seq k) (a_seq k) (deriv G_inf Y₀) (2 * ε_D / 3) (ha_ne k) (fun θ hθ => by
          have h1_sub_nn : 0 ≤ 1 - θ := by linarith [hθ.2]
          have h_dist_le : ‖(Y₀ - a_seq k) + (θ : ℂ) * a_seq k - Y₀‖ ≤ ‖a_seq k‖ := by
            have h_eq : (Y₀ - a_seq k) + (θ : ℂ) * a_seq k - Y₀ =
                -(((1 - θ : ℝ) : ℂ) * a_seq k) := by push_cast; ring
            rw [h_eq, norm_neg, norm_mul, Complex.norm_real, Real.norm_of_nonneg h1_sub_nn]
            calc (1 - θ) * ‖a_seq k‖ ≤ 1 * ‖a_seq k‖ :=
                mul_le_mul_of_nonneg_right (by linarith [hθ.1]) (norm_nonneg _)
              _ = ‖a_seq k‖ := one_mul _
          have hz_half : (Y₀ - a_seq k) + (θ : ℂ) * a_seq k ∈ K_half := by
            rw [Metric.mem_closedBall, dist_eq_norm]
            exact le_trans h_dist_le ha_r2.le
          refine ⟨hK_half_sub hz_half, ?_⟩
          have h1 : ‖deriv (G_k k) ((Y₀ - a_seq k) + (θ : ℂ) * a_seq k) -
              deriv G_inf ((Y₀ - a_seq k) + (θ : ℂ) * a_seq k)‖ < ε_D / 3 := by
            simpa [dist_eq_norm, norm_sub_rev] using hkdG _ hz_half
          have h_dist_δ : dist ((Y₀ - a_seq k) + (θ : ℂ) * a_seq k) Y₀ < δ_D := by
            rw [dist_eq_norm]
            exact lt_of_le_of_lt h_dist_le ha_δ
          have h2 : ‖deriv G_inf ((Y₀ - a_seq k) + (θ : ℂ) * a_seq k) - deriv G_inf Y₀‖ <
              ε_D / 3 := by
            simpa [dist_eq_norm] using hδ_D h_dist_δ
          have htri := dist_triangle
            (deriv (G_k k) ((Y₀ - a_seq k) + (θ : ℂ) * a_seq k))
            (deriv G_inf ((Y₀ - a_seq k) + (θ : ℂ) * a_seq k)) (deriv G_inf Y₀)
          rw [dist_eq_norm, dist_eq_norm, dist_eq_norm] at htri
          linarith)
      rw [sub_add_cancel] at h_sec
      rw [dist_eq_norm]
      exact lt_of_le_of_lt h_sec (by linarith)

    
    have hR_tend_rhs : Filter.Tendsto R_rhs Filter.atTop
        (nhds (deriv (fun S' => p_inf (S', J₀)) S₀)) := by
      rw [Metric.tendsto_atTop]
      intro ε_R hε_R
      have hdS_ucont : UniformContinuousOn
          (fun q : ℂ × ℂ => deriv (fun S' => p_inf (S', q.2)) q.1) K_δ₁ :=
        hKδ₁_comp.uniformContinuousOn_of_continuous hdS_inf_cont
      obtain ⟨δ_R, hδ_R_pos, hδ_R⟩ :=
        Metric.uniformContinuousOn_iff.mp hdS_ucont (ε_R / 2) (by positivity)
      have ev_dS := (Metric.tendstoUniformlyOn_iff.mp hdS_unif) (ε_R / 2) (by positivity)
      have ev_F := (Metric.tendstoUniformlyOn_iff.mp hF_unif_Br₀) δ_R hδ_R_pos
      have ev_Δ := (Metric.tendstoUniformlyOn_iff.mp hΔ_unif_Br₀) δ_R hδ_R_pos
      obtain ⟨K_r, hK_r⟩ :=
        Filter.eventually_atTop.mp (h_ev_Gk.and (ev_dS.and (ev_F.and ev_Δ)))
      refine ⟨K_r, fun k hk => ?_⟩
      obtain ⟨hk_ev, hkdS, hkF, hkΔ⟩ := hK_r k hk
      have hq_k : (L.F_seq k Y₀, Δ_seq k Y₀) ∈ K_δ₁ :=
        ⟨Metric.ball_subset_closedBall (hk_ev.2.2.1 Y₀ hY₀_Br₀).1,
          Metric.ball_subset_closedBall (hk_ev.2.2.1 Y₀ hY₀_Br₀).2⟩
      have hq₀ : (S₀, J₀) ∈ K_δ₁ :=
        ⟨Metric.mem_closedBall_self hδ₁_pos.le, Metric.mem_closedBall_self hδ₁_pos.le⟩
      have h_dist_q : dist (L.F_seq k Y₀, Δ_seq k Y₀) (S₀, J₀) < δ_R := by
        rw [Prod.dist_eq, max_lt_iff]
        exact ⟨by simpa [S₀, dist_comm] using hkF Y₀ hY₀_Br₀,
          by simpa [J₀, dist_comm] using hkΔ Y₀ hY₀_Br₀⟩
      have h1 : ‖deriv (fun S' => p_seq k (S', Δ_seq k Y₀)) (L.F_seq k Y₀) -
          deriv (fun S' => p_inf (S', Δ_seq k Y₀)) (L.F_seq k Y₀)‖ < ε_R / 2 := by
        simpa [dist_eq_norm, norm_sub_rev] using hkdS _ hq_k
      have h2 : ‖deriv (fun S' => p_inf (S', Δ_seq k Y₀)) (L.F_seq k Y₀) -
          deriv (fun S' => p_inf (S', J₀)) S₀‖ < ε_R / 2 := by
        simpa [dist_eq_norm] using hδ_R _ hq_k _ hq₀ h_dist_q
      have htri := dist_triangle
        (deriv (fun S' => p_seq k (S', Δ_seq k Y₀)) (L.F_seq k Y₀))
        (deriv (fun S' => p_inf (S', Δ_seq k Y₀)) (L.F_seq k Y₀))
        (deriv (fun S' => p_inf (S', J₀)) S₀)
      rw [dist_eq_norm, dist_eq_norm, dist_eq_norm] at htri
      rw [dist_eq_norm]
      dsimp [R_rhs]
      linarith

    exact tendsto_nhds_unique hD_tend_lhs (hR_tend_rhs.congr' h_ev_eq.symm)

  clear h_bivar_toolkit h_secant_bound

  
  have hEL_mid : ∀ Y₀ ∈ { Y : ℂ | D₁ < -Y.im ∧ |Y.re| < (A + 1) * (-Y.im) },
      deriv (fun Y' =>
        deriv (fun J' =>
          frozenActionP kind (L.T_star * seq.c₀ * Complex.exp (-Complex.I * L.S_star Y')) J')
          (deriv L.S_star Y')) Y₀ =
      deriv (fun S' =>
        frozenActionP kind (L.T_star * seq.c₀ * Complex.exp (-Complex.I * S'))
          (deriv L.S_star Y₀))
        (L.S_star Y₀) := by
    intro Y₀ hY₀
    obtain ⟨hBall2, _, _, hu_lt, hReg⟩ := hMid_props Y₀ hY₀.1 hY₀.2
    exact h_s3 Y₀ hBall2 hu_lt hReg
  clear h_s3

  obtain ⟨hInf_open, hInf_conv⟩ := h_cone_open_conv D₀ (A + 2)
  obtain ⟨hMid_open, hMid_conv⟩ := h_cone_open_conv D₁ (A + 1)
  have hD₁_pos : 0 < D₁ := lt_trans hD₀ hD₀_lt_D₁
  have hMid_sub_Inf :
      { Y : ℂ | D₁ < -Y.im ∧ |Y.re| < (A + 1) * (-Y.im) } ⊆
      { Y : ℂ | D₀ < -Y.im ∧ |Y.re| < (A + 2) * (-Y.im) } := by
    intro Y hY
    have him : D₀ < -Y.im := lt_trans hD₀_lt_D₁ hY.1
    have him_pos : 0 < -Y.im := lt_trans hD₀ him
    exact ⟨him, lt_trans hY.2 (by nlinarith)⟩
  have hS_holo_mid :
      DifferentiableOn ℂ L.S_star { Y : ℂ | D₁ < -Y.im ∧ |Y.re| < (A + 1) * (-Y.im) } :=
    L.S_star_holo.mono hMid_sub_Inf
  have hdS_holo_mid :
      DifferentiableOn ℂ (deriv L.S_star) { Y : ℂ | D₁ < -Y.im ∧ |Y.re| < (A + 1) * (-Y.im) } :=
    (L.S_star_holo.deriv hInf_open).mono hMid_sub_Inf
  have hu_holo_mid :
      DifferentiableOn ℂ
        (fun Y => L.T_star * seq.c₀ * Complex.exp (-Complex.I * L.S_star Y) * deriv L.S_star Y / 2)
        { Y : ℂ | D₁ < -Y.im ∧ |Y.re| < (A + 1) * (-Y.im) } := by
    have hexp := Complex.differentiable_exp.comp_differentiableOn
      ((differentiableOn_const (-Complex.I)).mul hS_holo_mid)
    exact DifferentiableOn.div
      (((differentiableOn_const (L.T_star * seq.c₀)).mul hexp).mul hdS_holo_mid)
      (differentiableOn_const (2 : ℂ)) (fun _ _ => two_ne_zero)
  have hu_maps_mid :
      Set.MapsTo
        (fun Y => L.T_star * seq.c₀ * Complex.exp (-Complex.I * L.S_star Y) * deriv L.S_star Y / 2)
        { Y : ℂ | D₁ < -Y.im ∧ |Y.re| < (A + 1) * (-Y.im) } (Metric.ball (0 : ℂ) 1) := by
    intro Y hY
    rw [Metric.mem_ball, dist_zero_right]
    exact (hMid_props Y hY.1 hY.2).2.2.2.1
  have hE_alt_holo :
      DifferentiableOn ℂ
        (fun Y => ((deriv L.S_star Y) ^ 3 / 12) *
          K_ker.G_ker (L.T_star * seq.c₀ * Complex.exp (-Complex.I * L.S_star Y) *
            deriv L.S_star Y / 2))
        { Y : ℂ | D₁ < -Y.im ∧ |Y.re| < (A + 1) * (-Y.im) } := by
    have h12_ne : (12 : ℂ) ≠ 0 := by norm_num
    have h1 := DifferentiableOn.div (hdS_holo_mid.pow 3) (differentiableOn_const (12 : ℂ))
      (fun _ _ => h12_ne)
    exact h1.mul (K_ker.G_ker_holo.comp hu_holo_mid hu_maps_mid)
  have hE_eq_alt : ∀ Y ∈ { Y : ℂ | D₁ < -Y.im ∧ |Y.re| < (A + 1) * (-Y.im) },
      frozenEnergyE kind (L.T_star * seq.c₀ * Complex.exp (-Complex.I * L.S_star Y))
        (deriv L.S_star Y) =
      ((deriv L.S_star Y) ^ 3 / 12) *
        K_ker.G_ker (L.T_star * seq.c₀ * Complex.exp (-Complex.I * L.S_star Y) *
          deriv L.S_star Y / 2) :=
    fun Y hY => K_ker.energy_eq _ _ (hMid_props Y hY.1 hY.2).2.2.2.1
  have hE_deriv0 :
      Set.EqOn
        (deriv (fun Y' =>
          frozenEnergyE kind (L.T_star * seq.c₀ * Complex.exp (-Complex.I * L.S_star Y'))
            (deriv L.S_star Y')))
        0 { Y : ℂ | D₁ < -Y.im ∧ |Y.re| < (A + 1) * (-Y.im) } :=
    K_ker.legendre_deriv_zero _ L.S_star seq.c₀ L.T_star hMid_open hS_holo_mid
      (fun Y hY => (hMid_props Y hY.1 hY.2).2.2.2.1) hEL_mid
  have hE_eq_12 : ∀ Y : ℂ, D₁ < -Y.im → |Y.re| < (A + 1) * (-Y.im) →
      frozenEnergyE kind (L.T_star * seq.c₀ * Complex.exp (-Complex.I * L.S_star Y))
        (deriv L.S_star Y) = 1 / 12 := by
    have hE_holo_mid := hE_alt_holo.congr hE_eq_alt
    have hE_const : ∀ {y₁ y₂ : ℂ},
        y₁ ∈ { Y : ℂ | D₁ < -Y.im ∧ |Y.re| < (A + 1) * (-Y.im) } →
        y₂ ∈ { Y : ℂ | D₁ < -Y.im ∧ |Y.re| < (A + 1) * (-Y.im) } →
        frozenEnergyE kind (L.T_star * seq.c₀ * Complex.exp (-Complex.I * L.S_star y₁))
          (deriv L.S_star y₁) =
        frozenEnergyE kind (L.T_star * seq.c₀ * Complex.exp (-Complex.I * L.S_star y₂))
          (deriv L.S_star y₂) :=
      hMid_open.is_const_of_deriv_eq_zero hMid_conv.isPreconnected hE_holo_mid hE_deriv0
    have hG_cont0 : ContinuousAt K_ker.G_ker (0 : ℂ) :=
      ContinuousOn.continuousAt K_ker.G_ker_holo.continuousOn
        (Metric.isOpen_ball.mem_nhds (Metric.mem_ball_self (x := (0 : ℂ)) zero_lt_one))
    have hu_t0 : Filter.Tendsto
        (fun m : ℕ =>
          L.T_star * seq.c₀ *
            Complex.exp (-Complex.I * L.S_star (-((D₁ + (m : ℝ) + 3 : ℝ) : ℂ) * Complex.I)) *
            deriv L.S_star (-((D₁ + (m : ℝ) + 3 : ℝ) : ℂ) * Complex.I) / 2)
        Filter.atTop (nhds 0) := by
      simpa using (hRay_lam.mul hRay_J).div_const (2 : ℂ)
    have hG_t1 : Filter.Tendsto
        (fun m : ℕ =>
          K_ker.G_ker
            (L.T_star * seq.c₀ *
              Complex.exp (-Complex.I * L.S_star (-((D₁ + (m : ℝ) + 3 : ℝ) : ℂ) * Complex.I)) *
              deriv L.S_star (-((D₁ + (m : ℝ) + 3 : ℝ) : ℂ) * Complex.I) / 2))
        Filter.atTop (nhds 1) := by
      rw [← K_ker.G_ker_zero]
      exact hG_cont0.tendsto.comp hu_t0
    have h_alt_tend : Filter.Tendsto
        (fun m : ℕ =>
          ((deriv L.S_star (-((D₁ + (m : ℝ) + 3 : ℝ) : ℂ) * Complex.I)) ^ 3 / 12) *
            K_ker.G_ker
              (L.T_star * seq.c₀ *
                Complex.exp (-Complex.I * L.S_star (-((D₁ + (m : ℝ) + 3 : ℝ) : ℂ) * Complex.I)) *
                deriv L.S_star (-((D₁ + (m : ℝ) + 3 : ℝ) : ℂ) * Complex.I) / 2))
        Filter.atTop (nhds (1 / 12 : ℂ)) := by
      simpa using ((hRay_J.pow 3).div_const (12 : ℂ)).mul hG_t1
    have hYm_mid : ∀ m : ℕ,
        -((D₁ + (m : ℝ) + 3 : ℝ) : ℂ) * Complex.I ∈
          { Y : ℂ | D₁ < -Y.im ∧ |Y.re| < (A + 1) * (-Y.im) } := by
      intro m
      have him : -(-((D₁ + (m : ℝ) + 3 : ℝ) : ℂ) * Complex.I).im = D₁ + (m : ℝ) + 3 := by simp
      have hre : (-((D₁ + (m : ℝ) + 3 : ℝ) : ℂ) * Complex.I).re = 0 := by simp
      refine ⟨by rw [him]; linarith [Nat.cast_nonneg (α := ℝ) m], ?_⟩
      rw [hre, him, abs_zero]
      positivity
    have hE_Ym_tend := h_alt_tend.congr fun m => (hE_eq_alt _ (hYm_mid m)).symm
    intro Y hY1 hY2
    have hY_mid : Y ∈ { Z : ℂ | D₁ < -Z.im ∧ |Z.re| < (A + 1) * (-Z.im) } := ⟨hY1, hY2⟩
    exact tendsto_nhds_unique
      (tendsto_const_nhds.congr fun m => (hE_const (hYm_mid m) hY_mid).symm) hE_Ym_tend

  
  have h_eq_mid : ∀ Y ∈ { Z : ℂ | D₁ < -Z.im ∧ |Z.re| < (A + 1) * (-Z.im) },
      L.S_star Y = Y + M_mod.Δ₀ (L.T_star * seq.c₀ * Complex.exp (-Complex.I * Y)) := by
    intro Y hY
    exact M_mod.cone_ode_uniqueness (L.T_star * seq.c₀) D₁ (A + 1) L.S_star
      hD₁_pos (by positivity) hS_holo_mid hRay_disp
      (fun Z hZ1 hZ2 =>
        let hZ := hMid_sub_Inf ⟨hZ1, hZ2⟩
        ⟨hw_mod_lt Z hZ.1 hZ.2,
         (hMid_props Z hZ1 hZ2).2.2.1,
         (hMid_props Z hZ1 hZ2).2.1,
         hE_eq_12 Z hZ1 hZ2⟩)
      Y hY.1 hY.2
  have hS_model_holo :
      DifferentiableOn ℂ
        (fun Y => Y + M_mod.Δ₀ (L.T_star * seq.c₀ * Complex.exp (-Complex.I * Y)))
        { Z : ℂ | D₀ < -Z.im ∧ |Z.re| < (A + 2) * (-Z.im) } := by
    have hw_diff : Differentiable ℂ
        (fun Y : ℂ => L.T_star * seq.c₀ * Complex.exp (-Complex.I * Y)) :=
      (differentiable_const (L.T_star * seq.c₀)).mul
        (Complex.differentiable_exp.comp ((differentiable_const (-Complex.I)).mul differentiable_id))
    refine differentiableOn_id.add (M_mod.Δ₀_holo.comp hw_diff.differentiableOn ?_)
    intro Y hY
    rw [Metric.mem_ball, dist_zero_right]
    exact hw_mod_lt Y hY.1 hY.2
  let z₀ : ℂ := -(((D₁ + 1 : ℝ) : ℂ) * Complex.I)
  have hz₀_mid : z₀ ∈ { Z : ℂ | D₁ < -Z.im ∧ |Z.re| < (A + 1) * (-Z.im) } := by
    refine ⟨by simp [z₀], ?_⟩
    have him : -z₀.im = D₁ + 1 := by simp [z₀]
    have hre : z₀.re = 0 := by simp [z₀]
    rw [hre, him, abs_zero]
    positivity
  have h_ev_z₀ :
      L.S_star =ᶠ[nhds z₀]
        (fun Y => Y + M_mod.Δ₀ (L.T_star * seq.c₀ * Complex.exp (-Complex.I * Y))) :=
    Filter.eventuallyEq_of_mem (hMid_open.mem_nhds hz₀_mid) h_eq_mid
  have h_eq_inf :=
    (L.S_star_holo.analyticOnNhd hInf_open).eqOn_of_preconnected_of_eventuallyEq
      (hS_model_holo.analyticOnNhd hInf_open) hInf_conv.isPreconnected
      (hMid_sub_Inf hz₀_mid) h_ev_z₀
  intro Y hY_im hY_re
  exact h_eq_inf ⟨hY_im, hY_re⟩

theorem deep_frozen_model_and_convergence (X : ExpStripData)
    (P : ChordActionPackage X)
    (kind : ExpProfileKind)
    (seq : ExpSequenceData X kind)
    (hAnc : DeepPassageAnchorData X P kind seq) :
    DeepInitializedModelData X P kind seq :=
by
  obtain ⟨K_ker⟩ := dfmc_frozen_kernel_and_legendre_calculus kind
  obtain ⟨M_mod⟩ := dfmc_analytic_model_and_ode_uniqueness kind K_ker
  intro T_max hT_max
  have h2T_pos : 0 < 2 * T_max := by positivity
  obtain ⟨D_anc, C_anc, α, hD_anc, hC_anc, hα₁, hα₂, hAnc2⟩ := hAnc (2 * T_max) h2T_pos
  have hAnc2' : DfmcHasAnchorAt X P kind seq (2 * T_max) D_anc C_anc α := hAnc2
  have hc₀_pos : 0 < ‖seq.c₀‖ := norm_pos_iff.mpr seq.c₀_ne_zero
  have hρ_pos : 0 < M_mod.ρ_mod := M_mod.ρ_mod_pos
  let R_ratio : ℝ := 4 * T_max * ‖seq.c₀‖ / M_mod.ρ_mod
  have hR_ratio_pos : 0 < R_ratio := by positivity
  let D₀ : ℝ := max (max D_anc 10) (Real.log R_ratio + 1)
  have hD_anc_le : D_anc ≤ D₀ := le_trans (le_max_left _ _) (le_max_left _ _)
  have h10_le_D₀ : 10 ≤ D₀ := le_trans (le_max_right _ _) (le_max_left _ _)
  have hD₀_pos : 0 < D₀ := by linarith
  have hSmall : T_max * ‖seq.c₀‖ * Real.exp (-D₀) < M_mod.ρ_mod := by
    have hlog_lt : Real.log R_ratio < D₀ := by
      have : Real.log R_ratio + 1 ≤ D₀ := le_max_right _ _
      linarith
    have hexp_lt : Real.exp (-D₀) < Real.exp (-Real.log R_ratio) :=
      Real.exp_lt_exp.mpr (by linarith)
    rw [Real.exp_neg (Real.log R_ratio), Real.exp_log hR_ratio_pos] at hexp_lt
    have hinv : R_ratio⁻¹ = M_mod.ρ_mod / (4 * T_max * ‖seq.c₀‖) := by
      dsimp [R_ratio]
      rw [inv_div]
    rw [hinv] at hexp_lt
    have hTc_pos : 0 < T_max * ‖seq.c₀‖ := mul_pos hT_max hc₀_pos
    have hmul := mul_lt_mul_of_pos_left hexp_lt hTc_pos
    have h_eq : T_max * ‖seq.c₀‖ * (M_mod.ρ_mod / (4 * T_max * ‖seq.c₀‖)) =
        M_mod.ρ_mod / 4 := by
      field_simp [hT_max.ne', hc₀_pos.ne']
    linarith
  let C_deep : ℝ := max 1 (M_mod.C_Δ * ‖seq.c₀‖ ^ 2)
  have hC_deep_pos : 0 < C_deep := lt_of_lt_of_le zero_lt_one (le_max_left _ _)
  let w_map : ℂ × ℂ → ℂ := fun p => p.2 * seq.c₀ * Complex.exp (-Complex.I * p.1)
  let S_deep : ℂ × ℂ → ℂ := fun p => p.1 + M_mod.Δ₀ (w_map p)
  let dom : Set (ℂ × ℂ) := { p : ℂ × ℂ | D₀ < -p.1.im ∧ ‖p.2‖ < T_max }
  have hw_re : ∀ z : ℂ, (-Complex.I * z).re = z.im := by
    intro z
    simp
  have hw_maps : Set.MapsTo w_map dom (Metric.ball (0 : ℂ) M_mod.ρ_mod) := by
    intro p hp
    rcases hp with ⟨hp1, hp2⟩
    rw [Metric.mem_ball, dist_zero_right]
    dsimp [w_map]
    rw [norm_mul, norm_mul, Complex.norm_exp, hw_re]
    have hexp_le : Real.exp p.1.im ≤ Real.exp (-D₀) :=
      Real.exp_le_exp.mpr (by linarith)
    have hprod_le : ‖p.2‖ * ‖seq.c₀‖ * Real.exp p.1.im ≤
        T_max * ‖seq.c₀‖ * Real.exp (-D₀) := by
      have h1 : ‖p.2‖ * ‖seq.c₀‖ ≤ T_max * ‖seq.c₀‖ :=
        mul_le_mul_of_nonneg_right hp2.le (norm_nonneg _)
      exact mul_le_mul h1 hexp_le (Real.exp_pos _).le (by positivity)
    exact lt_of_le_of_lt hprod_le hSmall
  have hw_diff : Differentiable ℂ w_map :=
    (differentiable_snd.mul (differentiable_const seq.c₀)).mul
      (Complex.differentiable_exp.comp
        ((differentiable_const (-Complex.I)).mul differentiable_fst))
  have hS_deep_holo : DifferentiableOn ℂ S_deep dom :=
    differentiable_fst.differentiableOn.add
      (M_mod.Δ₀_holo.comp hw_diff.differentiableOn hw_maps)
  refine ⟨D₀, C_deep, α, S_deep, hD₀_pos, hC_deep_pos, hα₁, hα₂, hS_deep_holo, ?_, ?_, ?_⟩
  · intro Y T hY hT
    have hw_mem : w_map (Y, T) ∈ Metric.ball (0 : ℂ) M_mod.ρ_mod := hw_maps ⟨hY, hT⟩
    refine ⟨?_, ?_, ?_⟩
    · have h_sub : S_deep (Y, T) - Y = M_mod.Δ₀ (w_map (Y, T)) := by
        dsimp [S_deep]
        exact add_sub_cancel_left Y _
      rw [h_sub]
      have hΔ_le : ‖M_mod.Δ₀ (w_map (Y, T))‖ ≤ M_mod.C_Δ * ‖w_map (Y, T)‖ ^ 2 :=
        M_mod.Δ₀_bound _ hw_mem
      let D : ℝ := -Y.im
      have hD_ge_one : 1 ≤ D := by dsimp [D]; linarith
      have hD_pos : 0 < D := by linarith
      have hw_sq : ‖w_map (Y, T)‖ ^ 2 =
          ‖seq.c₀‖ ^ 2 * ‖T‖ ^ 2 * Real.exp (-2 * D) := by
        dsimp [w_map, D]
        rw [norm_mul, norm_mul, Complex.norm_exp, hw_re]
        have hexp_sq : (Real.exp Y.im) ^ 2 = Real.exp (-2 * (-Y.im)) := by
          rw [sq, ← Real.exp_add]
          congr 1
          ring
        calc (‖T‖ * ‖seq.c₀‖ * Real.exp Y.im) ^ 2
            = ‖seq.c₀‖ ^ 2 * ‖T‖ ^ 2 * (Real.exp Y.im) ^ 2 := by ring
          _ = ‖seq.c₀‖ ^ 2 * ‖T‖ ^ 2 * Real.exp (-2 * (-Y.im)) := by rw [hexp_sq]
      let β : ℝ := 2 * α - 1
      have hβ_pos : 0 < β := by dsimp [β]; linarith
      have hβ_le : β ≤ 1 := by dsimp [β]; linarith
      have hDβ_pos : 0 < D ^ β := Real.rpow_pos_of_pos hD_pos β
      have hDβ_le_exp : D ^ β ≤ Real.exp (2 * D) := by
        calc D ^ β ≤ D ^ (1 : ℝ) := Real.rpow_le_rpow_of_exponent_le hD_ge_one hβ_le
          _ = D := Real.rpow_one D
          _ ≤ 2 * D + 1 := by linarith
          _ ≤ Real.exp (2 * D) := Real.add_one_le_exp (2 * D)
      have hexp_le_rpow : Real.exp (-2 * D) ≤ D ^ (1 - 2 * α) := by
        have h1 : Real.exp (-2 * D) = (Real.exp (2 * D))⁻¹ := by
          have hneg : -2 * D = -(2 * D) := by ring
          rw [hneg, Real.exp_neg]
        have h2 : D ^ (1 - 2 * α) = (D ^ β)⁻¹ := by
          have hexp_eq : 1 - 2 * α = -β := by dsimp [β]; ring
          rw [hexp_eq, Real.rpow_neg hD_pos.le]
        rw [h1, h2]
        exact inv_anti₀ hDβ_pos hDβ_le_exp
      have hC_le : M_mod.C_Δ * ‖seq.c₀‖ ^ 2 ≤ C_deep := le_max_right _ _
      have hCΔ_pos : 0 < M_mod.C_Δ := M_mod.C_Δ_pos
      calc ‖M_mod.Δ₀ (w_map (Y, T))‖
          ≤ M_mod.C_Δ * ‖w_map (Y, T)‖ ^ 2 := hΔ_le
        _ = (M_mod.C_Δ * ‖seq.c₀‖ ^ 2) * ‖T‖ ^ 2 * Real.exp (-2 * D) := by
            rw [hw_sq]; ring
        _ ≤ C_deep * ‖T‖ ^ 2 * Real.exp (-2 * D) := by
            refine mul_le_mul_of_nonneg_right ?_ (Real.exp_pos _).le
            exact mul_le_mul_of_nonneg_right hC_le (sq_nonneg _)
        _ ≤ C_deep * ‖T‖ ^ 2 * D ^ (1 - 2 * α) := by
            exact mul_le_mul_of_nonneg_left hexp_le_rpow (by positivity)
    · have hw_neg : w_map (Y, -T) = -w_map (Y, T) := by
        dsimp [w_map]
        ring
      dsimp [S_deep]
      rw [hw_neg, M_mod.Δ₀_even _ hw_mem]
    · have hw_lt : ‖(T * seq.c₀) * Complex.exp (-Complex.I * Y)‖ < M_mod.ρ_mod := by
        simpa [Metric.mem_ball, dist_zero_right, w_map] using hw_mem
      exact M_mod.model_energy (T * seq.c₀) Y hw_lt
  · intro Y _
    dsimp [S_deep, w_map]
    simp [M_mod.Δ₀_zero]
  · intro A D_top hA hD_top
    have hA2_pos : 0 < A + 2 := by positivity
    have hD_top4 : D_anc + 2 < D_top + 4 := by linarith
    obtain ⟨N_init, U_phys, s_tilde, δ_base, hWit⟩ := hAnc2' (A + 2) (D_top + 4) hA2_pos hD_top4
    refine ⟨N_init, U_phys, s_tilde, δ_base, ?_, ?_⟩
    · intro n hn
      rcases hWit n hn with
        ⟨hOpen, hδ, hVert, hNegMem, hHolo, hStrip, hEven, hBase, _, hCone, hRec⟩
      have hSubCone :
          { p : ℂ × ℂ |
            D₀ < -p.1.im ∧ -p.1.im < D_top ∧ |p.1.re| < A * (-p.1.im) ∧ ‖p.2‖ < T_max } ⊆
          { p : ℂ × ℂ |
            D_anc < -p.1.im ∧ -p.1.im < D_top + 4 ∧
            |p.1.re| < (A + 2) * (-p.1.im) ∧ ‖p.2‖ < 2 * T_max } := by
        intro p hp
        rcases hp with ⟨hp1, hp2, hp3, hp4⟩
        refine ⟨by linarith, by linarith, ?_, by linarith⟩
        have him_pos : 0 < -p.1.im := lt_trans hD₀_pos hp1
        nlinarith
      refine ⟨hOpen, hδ, hVert, hNegMem, hHolo, hStrip, hEven, ?_, ?_, ?_⟩
      · intro y t hy ht
        have hm_pos : 0 < seq.m_seq n := seq.m_pos n
        have ht2 : ‖t‖ < (2 * T_max) / seq.m_seq n :=
          lt_trans ht (div_lt_div_of_pos_right (by linarith) hm_pos)
        exact hBase y t hy ht2
      · intro p hp
        have hc := hCone p (hSubCone hp)
        exact ⟨hc.1, hc.2.1⟩
      · intro Y T hTne hYT hPrev hNext
        exact hRec Y T hTne (hSubCone hYT) (hSubCone hPrev) (hSubCone hNext)
    · intro K hK_comp hK_sub ε hε
      by_contra hFail
      obtain ⟨L, hNe⟩ :=
        dfmc_vertical_uniqueness_and_arzela_extraction X P kind seq
          T_max D_anc C_anc α D₀ A D_top
          hT_max hD_anc hC_anc hα₁ hα₂ hD_anc_le hA hD_top
          hAnc2' N_init U_phys s_tilde δ_base hWit
          S_deep hS_deep_holo.continuousOn
          (fun Y _ => by dsimp [S_deep, w_map]; simp [M_mod.Δ₀_zero])
          K hK_comp hK_sub ε hε hFail
      have hEq :=
        dfmc_divided_difference_limit_identification X P kind seq
          K_ker M_mod D₀ C_anc α A T_max
          hD₀_pos hC_anc hα₁ hα₂ hA hT_max hSmall L
          L.Y_star L.Y_star_mem.1 L.Y_star_mem.2
      exact hNe hEq

theorem deep_vertical_passages_and_model_convergence : (∀ (S : FiniteWallNonisotropicStrip) (P : ChordActionPackage S.toExpStripData)
       (kind : ExpProfileKind) (seq : ExpSequenceData S.toExpStripData kind)
       (α₀ δ_b : ℝ),
      1 / 2 < α₀ → α₀ < 1 → 0 < δ_b → δ_b < S.H / 2 →
      (∀ n : ℕ, seq.h_seq n < S.H) →
      Filter.Tendsto seq.h_seq Filter.atTop (nhds S.H) →
      Filter.Tendsto seq.ℓ_seq Filter.atTop (nhds 0) →
      Filter.Tendsto (fun n => (S.H - seq.h_seq n) / seq.ℓ_seq n) Filter.atTop Filter.atTop →
      (∀ L : ℝ, 0 < L → ∃ C_L : ℝ, 0 < C_L ∧ ∃ N₀ : ℕ, ∀ n ≥ N₀, ∀ s : ℂ,
        seq.ℓ_seq n ≤ seq.h_seq n - s.im → seq.h_seq n - s.im ≤ δ_b →
        |s.re - seq.x_seq n| ≤ L * (seq.h_seq n - s.im) →
        shapeModulus S s ≤
          C_L * seq.m_seq n * (seq.ℓ_seq n / (seq.h_seq n - s.im)) ^ α₀) →
      DeepInitializedModelData S.toExpStripData P kind seq) ∧
    (∀ (E : EntireNonisotropicStrip) (P : ChordActionPackage E.toExpStripData)
       (kind : ExpProfileKind) (seq : ExpSequenceData E.toExpStripData kind)
       (α₀ C_ℓ C_cone : ℝ),
      1 / 2 < α₀ → α₀ < 1 → 0 < C_ℓ → 0 < C_cone →
      (∀ n : ℕ, 0 < seq.h_seq n ∧ seq.ℓ_seq n ≤ C_ℓ) →
      Filter.Tendsto seq.h_seq Filter.atTop Filter.atTop →
      Filter.Tendsto
        (fun n => Real.log (1 + seq.h_seq n / seq.ℓ_seq n) / Real.log (seq.m_seq n))
        Filter.atTop (nhds 0) →
      (∃ N₀ : ℕ, ∀ n ≥ N₀, ∀ s : ℂ,
        seq.ℓ_seq n ≤ seq.h_seq n - s.im → seq.h_seq n - s.im ≤ seq.h_seq n →
        max ‖E.f s‖ (Real.sqrt ‖E.q s‖) ≤
          C_cone * seq.m_seq n * (seq.ℓ_seq n / (seq.h_seq n - s.im)) ^ α₀) →
      DeepInitializedModelData E.toExpStripData P kind seq) :=
by
  have hSteep : RefSteepContinuationProp := ref_height_steep_sector_continuation
  obtain ⟨hBump, hDyad⟩ := schwarz_poisson_and_dyadic_cone_filling
  refine ⟨?_, ?_⟩
  · intro S P kind seq α₀ δ_b hα₁ hα₂ hδ₁ hδ₂ hh_lt hh_tendsto hℓ_tendsto hgap_tendsto hCone
    have hAncS : DeepPassageAnchorData S.toExpStripData P kind seq :=
      finite_wall_deep_passage_anchor hSteep hDyad S P kind seq α₀ δ_b
        hα₁ hα₂ hδ₁ hδ₂ hh_lt hh_tendsto hℓ_tendsto hgap_tendsto hCone
    exact deep_frozen_model_and_convergence S.toExpStripData P kind seq hAncS
  · intro E P kind seq α₀ C_ℓ C_cone hα₁ hα₂ hCℓ hCcone h_bounds hh_tendsto hlog_tendsto hCone
    have hAncE : DeepPassageAnchorData E.toExpStripData P kind seq :=
      entire_strip_deep_passage_anchor hSteep hBump hDyad E P kind seq α₀ C_ℓ C_cone
        hα₁ hα₂ hCℓ hCcone h_bounds hh_tendsto hlog_tendsto hCone
    exact deep_frozen_model_and_convergence E.toExpStripData P kind seq hAncE

theorem frozen_calculus_and_kaluza_disk_inputs : FrozenCalculusProp ∧
      Nonempty (ModelDiskInput .firstField) ∧
      Nonempty (ModelDiskInput .secondField) :=
by
  
  
  
  have hStage1 : FrozenCalculusProp ∧
      (∀ z : ℂ, 3 * firstFieldG z + z * deriv firstFieldG z = 3 * firstFieldSinc z) ∧
      (∀ z : ℂ, deriv firstFieldSinc z = -(z / 3) * firstFieldG z) := by
    have h_even_entire : ∀ (c : ℕ → ℂ) (C B : ℝ),
        0 ≤ C → 1 ≤ B →
        (∀ m : ℕ, ‖c m‖ ≤ C * B ^ m / ((2 * m + 1).factorial : ℝ)) →
        let F : ℂ → ℂ := fun z => ∑' m : ℕ, c m * z ^ (2 * m)
        let F' : ℂ → ℂ := fun z => ∑' m : ℕ, c m * ((2 * m : ℕ) : ℂ) * z ^ (2 * m - 1)
        Differentiable ℂ F ∧
        (∀ z : ℂ, HasDerivAt F (F' z) z) ∧
        (∀ z : ℂ, Summable (fun m : ℕ => c m * z ^ (2 * m))) ∧
        (∀ z : ℂ, Summable (fun m : ℕ => c m * ((2 * m : ℕ) : ℂ) * z ^ (2 * m - 1))) ∧
        F 0 = c 0 ∧
        deriv F 0 = 0 ∧
        (∀ (k z : ℂ), k * F z + z * deriv F z =
          ∑' m : ℕ, c m * (k + ((2 * m : ℕ) : ℂ)) * z ^ (2 * m)) := by
      intro c C B hC hB hc
      dsimp only
      have h_core : ∀ y : ℂ,
          Summable (fun m : ℕ => c m * y ^ (2 * m)) ∧
          Summable (fun m : ℕ => c m * ((2 * m : ℕ) : ℂ) * y ^ (2 * m - 1)) ∧
          HasDerivAt (fun z => ∑' m : ℕ, c m * z ^ (2 * m))
            (∑' m : ℕ, c m * ((2 * m : ℕ) : ℂ) * y ^ (2 * m - 1)) y := by
        intro y
        let R : ℝ := ‖y‖ + 1
        have hR_ge_one : 1 ≤ R := by dsimp [R]; linarith [norm_nonneg y]
        have hR_pos : 0 < R := lt_of_lt_of_le zero_lt_one hR_ge_one
        have hBR_nonneg : 0 ≤ B * R := by positivity
        let t : Set ℂ := Metric.ball (0 : ℂ) R
        have ht_open : IsOpen t := Metric.isOpen_ball
        have ht_pre : IsPreconnected t := (convex_ball (0 : ℂ) R).isPreconnected
        have h0_mem : (0 : ℂ) ∈ t := Metric.mem_ball_self hR_pos
        have hy_mem : y ∈ t := by
          rw [Metric.mem_ball, dist_zero_right]
          dsimp [R]
          linarith
        have h_inj_even : Function.Injective (fun m : ℕ => 2 * m) := fun a b h => by
          dsimp at h; omega
        have h_inj_odd : Function.Injective (fun m : ℕ => 2 * m - 1) := fun a b h => by
          dsimp at h; omega
        have hu0_sum : Summable (fun m : ℕ => C * ((B * R) ^ (2 * m) / ((2 * m).factorial : ℝ))) :=
          ((Real.summable_pow_div_factorial (B * R)).comp_injective h_inj_even).mul_left C
        have hu1_sum : Summable
            (fun m : ℕ => C * ((B * R) ^ (2 * m - 1) / ((2 * m - 1).factorial : ℝ))) :=
          ((Real.summable_pow_div_factorial (B * R)).comp_injective h_inj_odd).mul_left C
        have hg_bound : ∀ z ∈ t, ∀ m : ℕ,
            ‖c m * z ^ (2 * m)‖ ≤ C * ((B * R) ^ (2 * m) / ((2 * m).factorial : ℝ)) := by
          intro z hz m
          have hzR : ‖z‖ ≤ R := le_of_lt (by simpa [t] using hz)
          have hBm : B ^ m ≤ B ^ (2 * m) := pow_le_pow_right₀ hB (by omega)
          have hBRm : B ^ m * ‖z‖ ^ (2 * m) ≤ (B * R) ^ (2 * m) := by
            calc B ^ m * ‖z‖ ^ (2 * m)
                ≤ B ^ (2 * m) * R ^ (2 * m) :=
                  mul_le_mul hBm (pow_le_pow_left₀ (norm_nonneg z) hzR _)
                    (by positivity) (by positivity)
              _ = (B * R) ^ (2 * m) := (mul_pow B R (2 * m)).symm
          have hfac : ((2 * m).factorial : ℝ) ≤ ((2 * m + 1).factorial : ℝ) := by
            exact_mod_cast Nat.factorial_le (by omega)
          have hfac_pos : (0 : ℝ) < ((2 * m).factorial : ℝ) := by positivity
          calc ‖c m * z ^ (2 * m)‖
              = ‖c m‖ * ‖z‖ ^ (2 * m) := by rw [norm_mul, norm_pow]
            _ ≤ (C * B ^ m / ((2 * m + 1).factorial : ℝ)) * ‖z‖ ^ (2 * m) :=
                mul_le_mul_of_nonneg_right (hc m) (by positivity)
            _ = C * (B ^ m * ‖z‖ ^ (2 * m)) / ((2 * m + 1).factorial : ℝ) := by ring
            _ ≤ C * (B * R) ^ (2 * m) / ((2 * m + 1).factorial : ℝ) := by
                gcongr
            _ ≤ C * (B * R) ^ (2 * m) / ((2 * m).factorial : ℝ) :=
                div_le_div_of_nonneg_left (by positivity) hfac_pos hfac
            _ = C * ((B * R) ^ (2 * m) / ((2 * m).factorial : ℝ)) := by ring
        have hg'_deriv : ∀ m : ℕ, ∀ z ∈ t,
            HasDerivAt (fun w : ℂ => c m * w ^ (2 * m))
              (c m * ((2 * m : ℕ) : ℂ) * z ^ (2 * m - 1)) z := by
          intro m z _
          cases m with
          | zero =>
            simpa using (hasDerivAt_const z (c 0))
          | succ k =>
            have hp := (hasDerivAt_pow (2 * (k + 1)) z).const_mul (c (k + 1))
            simpa [mul_assoc] using hp
        have hg'_bound : ∀ m : ℕ, ∀ z ∈ t,
            ‖c m * ((2 * m : ℕ) : ℂ) * z ^ (2 * m - 1)‖ ≤
              C * ((B * R) ^ (2 * m - 1) / ((2 * m - 1).factorial : ℝ)) := by
          intro m z hz
          have hzR : ‖z‖ ≤ R := le_of_lt (by simpa [t] using hz)
          cases m with
          | zero =>
            simp [hC]
          | succ k =>
            set m := k + 1
            have hm_ge : 1 ≤ m := Nat.succ_le_succ (Nat.zero_le k)
            have hBm : B ^ m ≤ B ^ (2 * m - 1) := pow_le_pow_right₀ hB (by omega)
            have hBRm : B ^ m * ‖z‖ ^ (2 * m - 1) ≤ (B * R) ^ (2 * m - 1) := by
              calc B ^ m * ‖z‖ ^ (2 * m - 1)
                  ≤ B ^ (2 * m - 1) * R ^ (2 * m - 1) :=
                    mul_le_mul hBm (pow_le_pow_left₀ (norm_nonneg z) hzR _)
                      (by positivity) (by positivity)
                _ = (B * R) ^ (2 * m - 1) := (mul_pow B R (2 * m - 1)).symm
            have hfac_nat : (2 * m) * (2 * m - 1).factorial ≤ (2 * m + 1).factorial := by
              have h1 : 2 * m - 1 + 1 = 2 * m := by omega
              have h2 : (2 * m) * (2 * m - 1).factorial = (2 * m).factorial := by
                conv_rhs => rw [← h1, Nat.factorial_succ, h1]
              rw [h2]
              exact Nat.factorial_le (by omega)
            have hfac_real : ((2 * m : ℕ) : ℝ) * ((2 * m - 1).factorial : ℝ) ≤
                ((2 * m + 1).factorial : ℝ) := by exact_mod_cast hfac_nat
            have hfac_div : ((2 * m : ℕ) : ℝ) / ((2 * m + 1).factorial : ℝ) ≤
                1 / ((2 * m - 1).factorial : ℝ) := by
              rw [div_le_div_iff₀ (by positivity) (by positivity)]
              linarith
            calc ‖c m * ((2 * m : ℕ) : ℂ) * z ^ (2 * m - 1)‖
                = ‖c m‖ * ((2 * m : ℕ) : ℝ) * ‖z‖ ^ (2 * m - 1) := by
                  rw [norm_mul, norm_mul, norm_pow, Complex.norm_natCast]
              _ ≤ (C * B ^ m / ((2 * m + 1).factorial : ℝ)) *
                    ((2 * m : ℕ) : ℝ) * ‖z‖ ^ (2 * m - 1) :=
                  mul_le_mul_of_nonneg_right
                    (mul_le_mul_of_nonneg_right (hc m) (by positivity)) (by positivity)
              _ = C * (B ^ m * ‖z‖ ^ (2 * m - 1)) *
                    (((2 * m : ℕ) : ℝ) / ((2 * m + 1).factorial : ℝ)) := by ring
              _ ≤ C * (B * R) ^ (2 * m - 1) * (1 / ((2 * m - 1).factorial : ℝ)) :=
                  mul_le_mul
                    (mul_le_mul_of_nonneg_left hBRm hC)
                    hfac_div (by positivity) (by positivity)
              _ = C * ((B * R) ^ (2 * m - 1) / ((2 * m - 1).factorial : ℝ)) := by ring
        have hsum_y : Summable (fun m : ℕ => c m * y ^ (2 * m)) :=
          Summable.of_norm_bounded hu0_sum (hg_bound y hy_mem)
        have hsum_0 : Summable (fun m : ℕ => c m * (0 : ℂ) ^ (2 * m)) :=
          Summable.of_norm_bounded hu0_sum (hg_bound 0 h0_mem)
        have hsum_y' : Summable (fun m : ℕ => c m * ((2 * m : ℕ) : ℂ) * y ^ (2 * m - 1)) :=
          Summable.of_norm_bounded hu1_sum fun m => hg'_bound m y hy_mem
        have hderiv := hasDerivAt_tsum_of_isPreconnected hu1_sum ht_open ht_pre
          hg'_deriv hg'_bound h0_mem hsum_0 hy_mem
        exact ⟨hsum_y, hsum_y', hderiv⟩
      have hF_diff : Differentiable ℂ (fun z => ∑' m : ℕ, c m * z ^ (2 * m)) :=
        fun y => (h_core y).2.2.differentiableAt
      have hF_zero : (∑' m : ℕ, c m * (0 : ℂ) ^ (2 * m)) = c 0 := by
        rw [tsum_eq_single 0]
        · simp
        · intro m hm
          have h2m : 2 * m ≠ 0 := by omega
          simp [zero_pow h2m]
      have hF'_zero : deriv (fun z => ∑' m : ℕ, c m * z ^ (2 * m)) 0 = 0 := by
        rw [(h_core 0).2.2.deriv]
        convert tsum_zero with m
        cases m with
        | zero => simp
        | succ k =>
          have h2m : 2 * (k + 1) - 1 ≠ 0 := by omega
          simp [zero_pow h2m]
      refine ⟨hF_diff, fun z => (h_core z).2.2, fun z => (h_core z).1,
        fun z => (h_core z).2.1, hF_zero, hF'_zero, ?_⟩
      intro k z
      rw [(h_core z).2.2.deriv, ← tsum_mul_left, ← tsum_mul_left,
        ← ((h_core z).1.mul_left k).tsum_add ((h_core z).2.1.mul_left z)]
      congr 1
      ext m
      cases m with
      | zero => simp; ring
      | succ n =>
        have hexp : 1 + (2 * (n + 1) - 1) = 2 * (n + 1) := by omega
        calc k * (c (n + 1) * z ^ (2 * (n + 1))) +
                z * (c (n + 1) * ((2 * (n + 1) : ℕ) : ℂ) * z ^ (2 * (n + 1) - 1))
            = k * c (n + 1) * z ^ (2 * (n + 1)) +
                c (n + 1) * ((2 * (n + 1) : ℕ) : ℂ) * (z ^ 1 * z ^ (2 * (n + 1) - 1)) := by ring
          _ = k * c (n + 1) * z ^ (2 * (n + 1)) +
                c (n + 1) * ((2 * (n + 1) : ℕ) : ℂ) * z ^ (2 * (n + 1)) := by
              rw [← pow_add, hexp]
          _ = c (n + 1) * (k + ((2 * (n + 1) : ℕ) : ℂ)) * z ^ (2 * (n + 1)) := by ring

    let c_sinc : ℕ → ℂ := fun m => (-1 : ℂ) ^ m / ((2 * m + 1).factorial : ℂ)
    let c_gF : ℕ → ℂ := fun m =>
      6 * (-1 : ℂ) ^ m * ((m + 1 : ℕ) : ℂ) / ((2 * m + 3).factorial : ℂ)
    let c_sinhc : ℕ → ℂ := fun m => 1 / ((2 * m + 1).factorial : ℂ)
    let c_gQ : ℕ → ℂ := fun m => 6 * (4 : ℂ) ^ m / ((2 * m + 3).factorial : ℂ)
    let c_HF : ℕ → ℂ := fun m => (-1 : ℂ) ^ m / ((2 * m + 3).factorial : ℂ)
    let c_KF : ℕ → ℂ := fun m => (-1 : ℂ) ^ m / ((2 * m + 2).factorial : ℂ)
    let c_HQ : ℕ → ℂ := fun m => ((2 * m + 2 : ℕ) : ℂ) / ((2 * m + 3).factorial : ℂ)
    let H_F : ℂ → ℂ := fun z => ∑' m : ℕ, c_HF m * z ^ (2 * m)
    let K_F : ℂ → ℂ := fun z => ∑' m : ℕ, c_KF m * z ^ (2 * m)
    let H_Q : ℂ → ℂ := fun z => ∑' m : ℕ, c_HQ m * z ^ (2 * m)

    have hsinc_eq : firstFieldSinc = fun z => ∑' m : ℕ, c_sinc m * z ^ (2 * m) := by
      ext z; unfold firstFieldSinc; congr 1; ext m; dsimp [c_sinc]; ring
    have hgF_eq : firstFieldG = fun z => ∑' m : ℕ, c_gF m * z ^ (2 * m) := by
      ext z; unfold firstFieldG; congr 1; ext m; dsimp [c_gF]; ring
    have hsinhc_eq : secondFieldSinhc = fun z => ∑' m : ℕ, c_sinhc m * z ^ (2 * m) := by
      ext z; unfold secondFieldSinhc; congr 1; ext m; dsimp [c_sinhc]; ring
    have hgQ_eq : secondFieldGNum = fun z => ∑' m : ℕ, c_gQ m * z ^ (2 * m) := by
      ext z; unfold secondFieldGNum; congr 1; ext m; dsimp [c_gQ]; ring

    have h_sinc := h_even_entire c_sinc 1 1 (by norm_num) (by norm_num) fun m => by
      dsimp [c_sinc]
      rw [norm_div, norm_pow, norm_neg, norm_one, one_pow, Complex.norm_natCast]
      simp
    have h_gF := h_even_entire c_gF 3 1 (by norm_num) (by norm_num) fun m => by
      dsimp [c_gF]
      rw [norm_div, norm_mul, norm_mul, norm_pow, norm_neg, norm_one, one_pow,
        Complex.norm_natCast, Complex.norm_natCast, Complex.norm_ofNat]
      have hfac : (2 * (m + 1)) * (2 * m + 1).factorial ≤ (2 * m + 3).factorial := by
        have h1 : (2 * m + 3).factorial = (2 * m + 3) * (2 * m + 2) * (2 * m + 1).factorial := by
          have ha : 2 * m + 3 = (2 * m + 2) + 1 := by omega
          have hb : 2 * m + 2 = (2 * m + 1) + 1 := by omega
          rw [ha, Nat.factorial_succ, hb, Nat.factorial_succ]
          ring
        rw [h1]
        exact Nat.mul_le_mul_right _ (by nlinarith)
      have hfac_r : (2 : ℝ) * ((m + 1 : ℕ) : ℝ) * ((2 * m + 1).factorial : ℝ) ≤
          ((2 * m + 3).factorial : ℝ) := by exact_mod_cast hfac
      rw [div_le_div_iff₀ (by positivity) (by positivity)]
      nlinarith
    have h_sinhc := h_even_entire c_sinhc 1 1 (by norm_num) (by norm_num) fun m => by
      dsimp [c_sinhc]
      rw [norm_div, norm_one, Complex.norm_natCast]
      simp
    have h_gQ := h_even_entire c_gQ 1 4 (by norm_num) (by norm_num) fun m => by
      dsimp [c_gQ]
      rw [norm_div, norm_mul, norm_pow, Complex.norm_ofNat, Complex.norm_ofNat,
        Complex.norm_natCast, one_mul]
      have hfac : 6 * (2 * m + 1).factorial ≤ (2 * m + 3).factorial := by
        have h1 : (2 * m + 3).factorial = (2 * m + 3) * (2 * m + 2) * (2 * m + 1).factorial := by
          have ha : 2 * m + 3 = (2 * m + 2) + 1 := by omega
          have hb : 2 * m + 2 = (2 * m + 1) + 1 := by omega
          rw [ha, Nat.factorial_succ, hb, Nat.factorial_succ]
          ring
        rw [h1]
        exact Nat.mul_le_mul_right _ (by nlinarith)
      have hfac_r : (6 : ℝ) * ((2 * m + 1).factorial : ℝ) ≤ ((2 * m + 3).factorial : ℝ) := by
        exact_mod_cast hfac
      rw [div_le_div_iff₀ (by positivity) (by positivity)]
      nlinarith [pow_nonneg (by norm_num : (0 : ℝ) ≤ 4) m]
    have h_HF := h_even_entire c_HF 1 1 (by norm_num) (by norm_num) fun m => by
      dsimp [c_HF]
      rw [norm_div, norm_pow, norm_neg, norm_one, one_pow, Complex.norm_natCast, mul_one]
      exact div_le_div_of_nonneg_left zero_le_one (by positivity)
        (by exact_mod_cast Nat.factorial_le (by omega))
    have h_KF := h_even_entire c_KF 1 1 (by norm_num) (by norm_num) fun m => by
      dsimp [c_KF]
      rw [norm_div, norm_pow, norm_neg, norm_one, one_pow, Complex.norm_natCast, mul_one]
      exact div_le_div_of_nonneg_left zero_le_one (by positivity)
        (by exact_mod_cast Nat.factorial_le (by omega))
    have h_HQ := h_even_entire c_HQ 1 1 (by norm_num) (by norm_num) fun m => by
      dsimp [c_HQ]
      rw [norm_div, Complex.norm_natCast, Complex.norm_natCast, one_pow, mul_one]
      have hfac : (2 * m + 2) * (2 * m + 1).factorial ≤ (2 * m + 3).factorial := by
        have h1 : (2 * m + 2) * (2 * m + 1).factorial = (2 * m + 2).factorial :=
          (Nat.factorial_succ (2 * m + 1)).symm
        rw [h1]
        exact Nat.factorial_le (by omega)
      have hfac_r : ((2 * m + 2 : ℕ) : ℝ) * ((2 * m + 1).factorial : ℝ) ≤
          ((2 * m + 3).factorial : ℝ) := by exact_mod_cast hfac
      rw [div_le_div_iff₀ (by positivity) (by positivity)]
      linarith

    have hsinc_entire : Differentiable ℂ firstFieldSinc := hsinc_eq ▸ h_sinc.1
    have hgF_entire : Differentiable ℂ firstFieldG := hgF_eq ▸ h_gF.1
    have hsinhc_entire : Differentiable ℂ secondFieldSinhc := hsinhc_eq ▸ h_sinhc.1
    have hgQ_entire : Differentiable ℂ secondFieldGNum := hgQ_eq ▸ h_gQ.1

    have hsinc_zero : firstFieldSinc 0 = 1 := by
      rw [hsinc_eq, h_sinc.2.2.2.2.1]; simp [c_sinc]
    have hgF_zero : firstFieldG 0 = 1 := by
      rw [hgF_eq, h_gF.2.2.2.2.1]; dsimp [c_gF]; norm_num [Nat.factorial]
    have hsinhc_zero : secondFieldSinhc 0 = 1 := by
      rw [hsinhc_eq, h_sinhc.2.2.2.2.1]; simp [c_sinhc]
    have hgQ_zero : secondFieldGNum 0 = 1 := by
      rw [hgQ_eq, h_gQ.2.2.2.2.1]; dsimp [c_gQ]; norm_num [Nat.factorial]
    have hHQ_zero : H_Q 0 = 1 / 3 := by
      change (fun z => ∑' m : ℕ, c_HQ m * z ^ (2 * m)) 0 = 1 / 3
      rw [h_HQ.2.2.2.2.1]; dsimp [c_HQ]; norm_num [Nat.factorial]

    have hfac_succ_cast :
        ∀ n : ℕ, ((n + 1).factorial : ℂ) = ((n + 1 : ℕ) : ℂ) * (n.factorial : ℂ) := by
      intro n; rw [Nat.factorial_succ]; push_cast; rfl

    have h_ode_HF : ∀ z : ℂ, 3 * H_F z + z * deriv H_F z = K_F z := by
      intro z
      rw [h_HF.2.2.2.2.2.2 3 z]
      congr 1; ext m
      dsimp [c_HF, c_KF]
      have h1 : (2 * m + 3).factorial = (2 * m + 2 + 1).factorial := rfl
      rw [h1, hfac_succ_cast (2 * m + 2)]
      have hne : ((2 * m + 2 + 1 : ℕ) : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
      have hnum : (3 : ℂ) + ((2 * m : ℕ) : ℂ) = ((2 * m + 2 + 1 : ℕ) : ℂ) := by push_cast; ring
      rw [hnum]
      field_simp [hne]

    have h_ode_KF : ∀ z : ℂ, 2 * K_F z + z * deriv K_F z = firstFieldSinc z := by
      intro z
      rw [h_KF.2.2.2.2.2.2 2 z, hsinc_eq]
      congr 1; ext m
      dsimp [c_KF, c_sinc]
      have h1 : (2 * m + 2).factorial = (2 * m + 1 + 1).factorial := rfl
      rw [h1, hfac_succ_cast (2 * m + 1)]
      have hne : ((2 * m + 1 + 1 : ℕ) : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
      have hnum : (2 : ℂ) + ((2 * m : ℕ) : ℂ) = ((2 * m + 1 + 1 : ℕ) : ℂ) := by push_cast; ring
      rw [hnum]
      field_simp [hne]

    have h_KF_sub_HF : ∀ z : ℂ, K_F z - H_F z = (1 / 3 : ℂ) * firstFieldG z := by
      intro z
      dsimp [K_F, H_F]
      rw [← (h_KF.2.2.1 z).tsum_sub (h_HF.2.2.1 z), hgF_eq, ← tsum_mul_left]
      congr 1; ext m
      dsimp [c_KF, c_HF, c_gF]
      have h1 : (2 * m + 3).factorial = (2 * m + 2 + 1).factorial := rfl
      rw [h1, hfac_succ_cast (2 * m + 2)]
      have hne1 : ((2 * m + 2 + 1 : ℕ) : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
      have hne2 : ((2 * m + 2).factorial : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)
      field_simp [hne1, hne2]
      push_cast
      ring

    have h_ode_gF : ∀ z : ℂ, 3 * firstFieldG z + z * deriv firstFieldG z = 3 * firstFieldSinc z := by
      intro z
      rw [hgF_eq, h_gF.2.2.2.2.2.2 3 z, hsinc_eq, ← tsum_mul_left]
      congr 1; ext m
      dsimp [c_gF, c_sinc]
      have h1 : ((2 * m + 3).factorial : ℂ) =
          ((2 * m + 3 : ℕ) : ℂ) * ((2 * m + 2 : ℕ) : ℂ) * ((2 * m + 1).factorial : ℂ) := by
        have ha : 2 * m + 3 = (2 * m + 2) + 1 := by omega
        have hb : 2 * m + 2 = (2 * m + 1) + 1 := by omega
        rw [ha, Nat.factorial_succ, hb, Nat.factorial_succ]
        push_cast; ring
      rw [h1]
      have hne1 : ((2 * m + 3 : ℕ) : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
      have hne2 : ((2 * m + 2 : ℕ) : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
      have hne3 : ((2 * m + 1).factorial : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)
      field_simp [hne1, hne2, hne3]
      push_cast
      ring

    have h_deriv_sinc : ∀ z : ℂ, deriv firstFieldSinc z = -(z / 3) * firstFieldG z := by
      intro z
      rw [hsinc_eq, (h_sinc.2.1 z).deriv]
      dsimp only
      have hhs := (h_sinc.2.2.2.1 z).hasSum
      have hshift := (hasSum_nat_add_iff' 1).mpr hhs
      simp only [Finset.range_one, Finset.sum_singleton, Nat.cast_zero,
        mul_zero, zero_mul, sub_zero] at hshift
      rw [← hshift.tsum_eq, hgF_eq, ← tsum_mul_left]
      congr 1; ext m
      dsimp [c_sinc, c_gF]
      have hexp1 : 2 * (m + 1) - 1 = 2 * m + 1 := by omega
      have hexp2 : 2 * (m + 1) + 1 = 2 * m + 3 := by omega
      rw [hexp1, hexp2, pow_succ (-1 : ℂ) m, pow_succ z (2 * m)]
      push_cast
      ring

    have h_ode_HQ : ∀ z : ℂ, 3 * H_Q z + z * deriv H_Q z = secondFieldSinhc z := by
      intro z
      rw [h_HQ.2.2.2.2.2.2 3 z, hsinhc_eq]
      congr 1; ext m
      dsimp [c_HQ, c_sinhc]
      have h1 : ((2 * m + 3).factorial : ℂ) =
          ((2 * m + 3 : ℕ) : ℂ) * ((2 * m + 2 : ℕ) : ℂ) * ((2 * m + 1).factorial : ℂ) := by
        have ha : 2 * m + 3 = (2 * m + 2) + 1 := by omega
        have hb : 2 * m + 2 = (2 * m + 1) + 1 := by omega
        rw [ha, Nat.factorial_succ, hb, Nat.factorial_succ]
        push_cast; ring
      rw [h1]
      have hne1 : ((2 * m + 3 : ℕ) : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
      have hne2 : ((2 * m + 2 : ℕ) : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
      have hne3 : ((2 * m + 1).factorial : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)
      field_simp [hne1, hne2, hne3]
      push_cast
      ring

    have h_ode_sinhc :
        ∀ z : ℂ, secondFieldSinhc z + z * deriv secondFieldSinhc z = Complex.cosh z := by
      intro z
      calc secondFieldSinhc z + z * deriv secondFieldSinhc z
          = 1 * secondFieldSinhc z + z * deriv secondFieldSinhc z := by ring
        _ = Complex.cosh z := by
            rw [hsinhc_eq, h_sinhc.2.2.2.2.2.2 1 z, Complex.cosh_eq_tsum]
            congr 1; ext m
            dsimp [c_sinhc]
            rw [hfac_succ_cast (2 * m)]
            have hne1 : ((2 * m + 1 : ℕ) : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
            have hne2 : ((2 * m).factorial : ℂ) ≠ 0 :=
              Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)
            field_simp [hne1, hne2]
            push_cast
            ring

    have hsinc_mul : ∀ z : ℂ, z * firstFieldSinc z = Complex.sin z := by
      intro z
      rw [hsinc_eq, ← tsum_mul_left, Complex.sin_eq_tsum]
      congr 1; ext m
      dsimp [c_sinc]
      rw [pow_succ z (2 * m)]
      ring

    have hsinhc_mul : ∀ z : ℂ, z * secondFieldSinhc z = Complex.sinh z := by
      intro z
      rw [hsinhc_eq, ← tsum_mul_left, Complex.sinh_eq_tsum]
      congr 1; ext m
      dsimp [c_sinhc]
      rw [pow_succ z (2 * m)]
      ring

    have hgF_mul : ∀ z : ℂ, z ^ 3 * firstFieldG z = 3 * (Complex.sin z - z * Complex.cos z) := by
      let φ : ℂ → ℂ := fun z => z ^ 3 * firstFieldG z - 3 * (Complex.sin z - z * Complex.cos z)
      have hφ_deriv : ∀ z : ℂ, HasDerivAt φ 0 z := by
        intro z
        have hd1 : HasDerivAt (fun w : ℂ => w ^ 3 * firstFieldG w)
            ((3 : ℂ) * z ^ (3 - 1) * firstFieldG z + z ^ 3 * deriv firstFieldG z) z :=
          (hasDerivAt_pow 3 z).mul hgF_entire.differentiableAt.hasDerivAt
        have hd2 : HasDerivAt (fun w : ℂ => 3 * (Complex.sin w - w * Complex.cos w))
            (3 * (Complex.cos z - (1 * Complex.cos z + z * (-Complex.sin z)))) z :=
          (Complex.hasDerivAt_sin z |>.sub
            ((hasDerivAt_id z).mul (Complex.hasDerivAt_cos z))).const_mul 3
        have hd := hd1.sub hd2
        have hzero : ((3 : ℂ) * z ^ (3 - 1) * firstFieldG z + z ^ 3 * deriv firstFieldG z) -
            3 * (Complex.cos z - (1 * Complex.cos z + z * (-Complex.sin z))) = 0 := by
          calc (3 : ℂ) * z ^ 2 * firstFieldG z + z ^ 3 * deriv firstFieldG z -
                3 * (Complex.cos z - (1 * Complex.cos z + z * (-Complex.sin z)))
              = z ^ 2 * (3 * firstFieldG z + z * deriv firstFieldG z) - 3 * z * Complex.sin z := by
                ring
            _ = z ^ 2 * (3 * firstFieldSinc z) - 3 * z * Complex.sin z := by rw [h_ode_gF z]
            _ = 3 * z * (z * firstFieldSinc z - Complex.sin z) := by ring
            _ = 0 := by rw [hsinc_mul z, sub_self, mul_zero]
        exact hzero ▸ hd
      have hφ_diff : DifferentiableOn ℂ φ Set.univ :=
        fun z _ => (hφ_deriv z).differentiableAt.differentiableWithinAt
      have hφ_eq0 : Set.EqOn (deriv φ) 0 Set.univ := fun z _ => (hφ_deriv z).deriv
      intro z
      have hc := isOpen_univ.is_const_of_deriv_eq_zero isPreconnected_univ hφ_diff hφ_eq0
        (Set.mem_univ z) (Set.mem_univ 0)
      have h0 : φ 0 = 0 := by simp [φ]
      rw [h0] at hc
      exact sub_eq_zero.mp hc

    have hHQ_mul : ∀ z : ℂ, z ^ 3 * H_Q z = z * Complex.cosh z - Complex.sinh z := by
      let φ : ℂ → ℂ := fun z => z ^ 3 * H_Q z - (z * Complex.cosh z - Complex.sinh z)
      have hφ_deriv : ∀ z : ℂ, HasDerivAt φ 0 z := by
        intro z
        have hd1 : HasDerivAt (fun w : ℂ => w ^ 3 * H_Q w)
            ((3 : ℂ) * z ^ (3 - 1) * H_Q z + z ^ 3 * deriv H_Q z) z :=
          (hasDerivAt_pow 3 z).mul h_HQ.1.differentiableAt.hasDerivAt
        have hd2 : HasDerivAt (fun w : ℂ => w * Complex.cosh w - Complex.sinh w)
            ((1 * Complex.cosh z + z * Complex.sinh z) - Complex.cosh z) z :=
          ((hasDerivAt_id z).mul (Complex.hasDerivAt_cosh z)).sub (Complex.hasDerivAt_sinh z)
        have hd := hd1.sub hd2
        have hzero : ((3 : ℂ) * z ^ (3 - 1) * H_Q z + z ^ 3 * deriv H_Q z) -
            ((1 * Complex.cosh z + z * Complex.sinh z) - Complex.cosh z) = 0 := by
          calc (3 : ℂ) * z ^ 2 * H_Q z + z ^ 3 * deriv H_Q z -
                ((1 * Complex.cosh z + z * Complex.sinh z) - Complex.cosh z)
              = z ^ 2 * (3 * H_Q z + z * deriv H_Q z) - z * Complex.sinh z := by ring
            _ = z ^ 2 * secondFieldSinhc z - z * Complex.sinh z := by rw [h_ode_HQ z]
            _ = z * (z * secondFieldSinhc z - Complex.sinh z) := by ring
            _ = 0 := by rw [hsinhc_mul z, sub_self, mul_zero]
        exact hzero ▸ hd
      have hφ_diff : DifferentiableOn ℂ φ Set.univ :=
        fun z _ => (hφ_deriv z).differentiableAt.differentiableWithinAt
      have hφ_eq0 : Set.EqOn (deriv φ) 0 Set.univ := fun z _ => (hφ_deriv z).deriv
      intro z
      have hc := isOpen_univ.is_const_of_deriv_eq_zero isPreconnected_univ hφ_diff hφ_eq0
        (Set.mem_univ z) (Set.mem_univ 0)
      have h0 : φ 0 = 0 := by simp [φ]
      rw [h0] at hc
      exact sub_eq_zero.mp hc

    have hgQ_mul : ∀ z : ℂ,
        2 * z ^ 3 * secondFieldGNum z = 3 * (Complex.sinh z * Complex.cosh z - z) := by
      intro z
      have hhs := (hasSum_nat_add_iff' 1).mpr (Complex.hasSum_sinh (2 * z))
      simp only [Finset.range_one, Finset.sum_singleton, Nat.mul_zero, zero_add, pow_one,
        Nat.factorial_one, Nat.cast_one, div_one] at hhs
      have hhs' := hhs.mul_left (3 / 2 : ℂ)
      have h_val : (3 / 2 : ℂ) * (Complex.sinh (2 * z) - 2 * z) =
          3 * (Complex.sinh z * Complex.cosh z - z) := by
        rw [Complex.sinh_two_mul]
        ring
      rw [h_val] at hhs'
      have h_lhs : HasSum
          (fun n : ℕ =>
            (3 / 2 : ℂ) * ((2 * z) ^ (2 * (n + 1) + 1) / ((2 * (n + 1) + 1).factorial : ℂ)))
          (2 * z ^ 3 * secondFieldGNum z) := by
        rw [hgQ_eq]
        have h_s := (h_gQ.2.2.1 z).hasSum.mul_left (2 * z ^ 3)
        refine h_s.congr_fun fun m => ?_
        dsimp [c_gQ]
        have hexp : 2 * (m + 1) + 1 = 2 * m + 3 := by omega
        rw [hexp]
        have hpow : (2 * z) ^ (2 * m + 3) = 8 * (4 : ℂ) ^ m * z ^ (2 * m) * z ^ 3 := by
          rw [mul_pow, pow_add, pow_mul]
          norm_num
          ring
        rw [hpow]
        ring
      exact h_lhs.unique hhs'

    have h_Q_alg1 : ∀ z : ℂ,
        3 * (secondFieldSinhc z ^ 2 - H_Q z * Complex.cosh z) = 2 * secondFieldGNum z := by
      intro z
      by_cases hz : z = 0
      · subst hz
        rw [hsinhc_zero, hHQ_zero, Complex.cosh_zero, hgQ_zero]
        norm_num
      · have hz3 : z ^ 3 ≠ 0 := pow_ne_zero 3 hz
        apply mul_left_cancel₀ hz3
        calc z ^ 3 * (3 * (secondFieldSinhc z ^ 2 - H_Q z * Complex.cosh z))
            = 3 * (z * (z * secondFieldSinhc z) ^ 2 - (z ^ 3 * H_Q z) * Complex.cosh z) := by ring
          _ = 3 * (z * Complex.sinh z ^ 2 -
                (z * Complex.cosh z - Complex.sinh z) * Complex.cosh z) := by
              rw [hsinhc_mul z, hHQ_mul z]
          _ = 3 * (Complex.sinh z * Complex.cosh z -
                z * (Complex.cosh z ^ 2 - Complex.sinh z ^ 2)) := by ring
          _ = 3 * (Complex.sinh z * Complex.cosh z - z) := by
              rw [Complex.cosh_sq_sub_sinh_sq z, mul_one]
          _ = 2 * z ^ 3 * secondFieldGNum z := (hgQ_mul z).symm
          _ = z ^ 3 * (2 * secondFieldGNum z) := by ring

    have h_Q_alg2 : ∀ z : ℂ,
        secondFieldSinhc z * Complex.cosh z - z * H_Q z * Complex.sinh z =
          secondFieldSinhc z ^ 2 := by
      intro z
      by_cases hz : z = 0
      · subst hz
        rw [hsinhc_zero, Complex.cosh_zero, Complex.sinh_zero]
        ring
      · have hz2 : z ^ 2 ≠ 0 := pow_ne_zero 2 hz
        apply mul_left_cancel₀ hz2
        calc z ^ 2 * (secondFieldSinhc z * Complex.cosh z - z * H_Q z * Complex.sinh z)
            = z * (z * secondFieldSinhc z) * Complex.cosh z -
                (z ^ 3 * H_Q z) * Complex.sinh z := by ring
          _ = z * Complex.sinh z * Complex.cosh z -
                (z * Complex.cosh z - Complex.sinh z) * Complex.sinh z := by
              rw [hsinhc_mul z, hHQ_mul z]
          _ = Complex.sinh z ^ 2 := by ring
          _ = (z * secondFieldSinhc z) ^ 2 := by rw [hsinhc_mul z]
          _ = z ^ 2 * secondFieldSinhc z ^ 2 := by ring

    have hlin_lam : ∀ lam J : ℂ, HasDerivAt (fun w : ℂ => lam * w / 2) (lam / 2) J := by
      intro lam J
      have h := ((hasDerivAt_id J).const_mul lam).div_const 2
      rwa [mul_one] at h

    have hpF_eq : ∀ lam J : ℂ,
        frozenActionP .firstField lam J = (J ^ 3 / 4) * H_F (lam * J / 2) := by
      intro lam J
      unfold frozenActionP
      dsimp [H_F, c_HF]
      rw [← tsum_mul_left]
      congr 1; ext m
      have h2 : (2 : ℂ) ^ (2 * m + 2) = 4 * (2 : ℂ) ^ (2 * m) := by
        rw [pow_add]; norm_num; ring
      rw [h2, div_pow, mul_pow, pow_add J (2 * m) 3]
      have h2ne : (2 : ℂ) ^ (2 * m) ≠ 0 := pow_ne_zero _ (by norm_num)
      have hfne : ((2 * m + 3).factorial : ℂ) ≠ 0 :=
        Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)
      field_simp [h2ne, hfne]

    have hpF_deriv : ∀ lam J : ℂ,
        HasDerivAt (frozenActionP .firstField lam)
          ((J ^ 2 / 4) * K_F (lam * J / 2)) J := by
      intro lam J
      have hlin := hlin_lam lam J
      have hcomp : HasDerivAt (fun w : ℂ => H_F (lam * w / 2))
          (deriv H_F (lam * J / 2) * (lam / 2)) J :=
        HasDerivAt.comp J h_HF.1.differentiableAt.hasDerivAt hlin
      have hprod : HasDerivAt (fun w : ℂ => (w ^ 3 / 4) * H_F (lam * w / 2))
          (((3 : ℂ) * J ^ (3 - 1) / 4) * H_F (lam * J / 2) +
            (J ^ 3 / 4) * (deriv H_F (lam * J / 2) * (lam / 2))) J :=
        ((hasDerivAt_pow 3 J).div_const 4).mul hcomp
      have h_eq_fn : frozenActionP .firstField lam = fun w => (w ^ 3 / 4) * H_F (lam * w / 2) := by
        ext w; exact hpF_eq lam w
      rw [h_eq_fn]
      have h_val : ((3 : ℂ) * J ^ (3 - 1) / 4) * H_F (lam * J / 2) +
          (J ^ 3 / 4) * (deriv H_F (lam * J / 2) * (lam / 2)) =
          (J ^ 2 / 4) * K_F (lam * J / 2) := by
        calc ((3 : ℂ) * J ^ 2 / 4) * H_F (lam * J / 2) +
              (J ^ 3 / 4) * (deriv H_F (lam * J / 2) * (lam / 2))
            = (J ^ 2 / 4) *
                (3 * H_F (lam * J / 2) + (lam * J / 2) * deriv H_F (lam * J / 2)) := by ring
          _ = (J ^ 2 / 4) * K_F (lam * J / 2) := by rw [h_ode_HF (lam * J / 2)]
      exact h_val ▸ hprod

    have hpF_deriv2 : ∀ lam J : ℂ,
        HasDerivAt (deriv (frozenActionP .firstField lam))
          ((J / 4) * firstFieldSinc (lam * J / 2)) J := by
      intro lam J
      have h_eq_fn : deriv (frozenActionP .firstField lam) =
          fun w => (w ^ 2 / 4) * K_F (lam * w / 2) := by
        ext w; exact (hpF_deriv lam w).deriv
      rw [h_eq_fn]
      have hlin := hlin_lam lam J
      have hcomp : HasDerivAt (fun w : ℂ => K_F (lam * w / 2))
          (deriv K_F (lam * J / 2) * (lam / 2)) J :=
        HasDerivAt.comp J h_KF.1.differentiableAt.hasDerivAt hlin
      have hprod : HasDerivAt (fun w : ℂ => (w ^ 2 / 4) * K_F (lam * w / 2))
          (((2 : ℂ) * J ^ (2 - 1) / 4) * K_F (lam * J / 2) +
            (J ^ 2 / 4) * (deriv K_F (lam * J / 2) * (lam / 2))) J :=
        ((hasDerivAt_pow 2 J).div_const 4).mul hcomp
      have h_val : ((2 : ℂ) * J ^ (2 - 1) / 4) * K_F (lam * J / 2) +
          (J ^ 2 / 4) * (deriv K_F (lam * J / 2) * (lam / 2)) =
          (J / 4) * firstFieldSinc (lam * J / 2) := by
        calc ((2 : ℂ) * J ^ 1 / 4) * K_F (lam * J / 2) +
              (J ^ 2 / 4) * (deriv K_F (lam * J / 2) * (lam / 2))
            = (J / 4) *
                (2 * K_F (lam * J / 2) + (lam * J / 2) * deriv K_F (lam * J / 2)) := by ring
          _ = (J / 4) * firstFieldSinc (lam * J / 2) := by rw [h_ode_KF (lam * J / 2)]
      exact h_val ▸ hprod

    have henergy_first : ∀ lam J : ℂ,
        frozenEnergyE .firstField lam J = (J ^ 3 / 12) * firstFieldG (lam * J / 2) := by
      intro lam J
      unfold frozenEnergyE
      rw [(hpF_deriv lam J).deriv, hpF_eq lam J]
      calc J * ((J ^ 2 / 4) * K_F (lam * J / 2)) - (J ^ 3 / 4) * H_F (lam * J / 2)
          = (J ^ 3 / 4) * (K_F (lam * J / 2) - H_F (lam * J / 2)) := by ring
        _ = (J ^ 3 / 4) * ((1 / 3 : ℂ) * firstFieldG (lam * J / 2)) := by
            rw [h_KF_sub_HF (lam * J / 2)]
        _ = (J ^ 3 / 12) * firstFieldG (lam * J / 2) := by ring

    have htwist_first : ∀ lam J : ℂ,
        deriv (deriv (frozenActionP .firstField lam)) J =
          (J / 4) * firstFieldSinc (lam * J / 2) :=
      fun lam J => (hpF_deriv2 lam J).deriv

    have hpQ_eq : ∀ lam J : ℂ,
        frozenActionP .secondField lam J =
          ((J ^ 3 / 8) * H_Q (lam * J / 2)) / Complex.cosh (lam * J / 2) := by
      intro lam J
      unfold frozenActionP
      dsimp [H_Q, c_HQ]
      congr 1
      rw [← tsum_mul_left]
      congr 1; ext m
      have h4 : (4 : ℂ) ^ m = (2 : ℂ) ^ (2 * m) := by
        rw [pow_mul]; norm_num
      rw [h4, div_pow, mul_pow, pow_add J (2 * m) 3]
      have h2ne : (2 : ℂ) ^ (2 * m) ≠ 0 := pow_ne_zero _ (by norm_num)
      have hfne : ((2 * m + 3).factorial : ℂ) ≠ 0 :=
        Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero _)
      field_simp [h2ne, hfne]

    have hpQ_deriv : ∀ lam J : ℂ, Complex.cosh (lam * J / 2) ≠ 0 →
        HasDerivAt (frozenActionP .secondField lam)
          ((1 / 8 : ℂ) * (J * secondFieldSinhc (lam * J / 2) / Complex.cosh (lam * J / 2)) ^ 2) J := by
      intro lam J hcosh
      have h_eq_fn : frozenActionP .secondField lam =
          fun w => ((w ^ 3 / 8) * H_Q (lam * w / 2)) / Complex.cosh (lam * w / 2) := by
        ext w; exact hpQ_eq lam w
      rw [h_eq_fn]
      have hlin := hlin_lam lam J
      have hnum_comp : HasDerivAt (fun w : ℂ => H_Q (lam * w / 2))
          (deriv H_Q (lam * J / 2) * (lam / 2)) J :=
        HasDerivAt.comp J h_HQ.1.differentiableAt.hasDerivAt hlin
      have hnum : HasDerivAt (fun w : ℂ => (w ^ 3 / 8) * H_Q (lam * w / 2))
          (((3 : ℂ) * J ^ (3 - 1) / 8) * H_Q (lam * J / 2) +
            (J ^ 3 / 8) * (deriv H_Q (lam * J / 2) * (lam / 2))) J :=
        ((hasDerivAt_pow 3 J).div_const 8).mul hnum_comp
      have hden : HasDerivAt (fun w : ℂ => Complex.cosh (lam * w / 2))
          (Complex.sinh (lam * J / 2) * (lam / 2)) J := by
        have hc : HasDerivAt Complex.cosh (Complex.sinh (lam * J / 2)) (lam * J / 2) :=
          Complex.hasDerivAt_cosh (lam * J / 2)
        exact hc.comp J hlin
      have hquot := hnum.div hden hcosh
      set z : ℂ := lam * J / 2
      have h_val :
          ((((3 : ℂ) * J ^ (3 - 1) / 8) * H_Q z + (J ^ 3 / 8) * (deriv H_Q z * (lam / 2))) *
              Complex.cosh z -
            ((J ^ 3 / 8) * H_Q z) * (Complex.sinh z * (lam / 2))) /
            Complex.cosh z ^ 2 =
          (1 / 8 : ℂ) * (J * secondFieldSinhc z / Complex.cosh z) ^ 2 := by
        have h1 : (((3 : ℂ) * J ^ (3 - 1) / 8) * H_Q z + (J ^ 3 / 8) * (deriv H_Q z * (lam / 2))) *
              Complex.cosh z -
            ((J ^ 3 / 8) * H_Q z) * (Complex.sinh z * (lam / 2)) =
            (J ^ 2 / 8) * ((3 * H_Q z + z * deriv H_Q z) * Complex.cosh z -
              z * H_Q z * Complex.sinh z) := by
          dsimp [z]; ring
        rw [h1, h_ode_HQ z, h_Q_alg2 z]
        field_simp [hcosh]
      exact h_val ▸ hquot

    have hpQ_deriv2 : ∀ lam J : ℂ, Complex.cosh (lam * J / 2) ≠ 0 →
        HasDerivAt (deriv (frozenActionP .secondField lam))
          ((J * secondFieldSinhc (lam * J / 2)) / (4 * Complex.cosh (lam * J / 2) ^ 3)) J := by
      intro lam J hcosh
      let U : Set ℂ := { w : ℂ | Complex.cosh (lam * w / 2) ≠ 0 }
      have hU_open : IsOpen U :=
        isOpen_compl_singleton.preimage
          (Complex.continuous_cosh.comp ((continuous_const.mul continuous_id).div_const 2))
      have h_ev : deriv (frozenActionP .secondField lam) =ᶠ[nhds J]
          fun w =>
            (1 / 8 : ℂ) * (w * secondFieldSinhc (lam * w / 2) / Complex.cosh (lam * w / 2)) ^ 2 :=
        Filter.eventually_of_mem (hU_open.mem_nhds hcosh) fun w hw => (hpQ_deriv lam w hw).deriv
      have hlin := hlin_lam lam J
      have h_sinhc_comp : HasDerivAt (fun w : ℂ => secondFieldSinhc (lam * w / 2))
          (deriv secondFieldSinhc (lam * J / 2) * (lam / 2)) J :=
        HasDerivAt.comp J hsinhc_entire.differentiableAt.hasDerivAt hlin
      have h_u_num : HasDerivAt (fun w : ℂ => w * secondFieldSinhc (lam * w / 2))
          (1 * secondFieldSinhc (lam * J / 2) +
            J * (deriv secondFieldSinhc (lam * J / 2) * (lam / 2))) J :=
        (hasDerivAt_id J).mul h_sinhc_comp
      have h_u_den : HasDerivAt (fun w : ℂ => Complex.cosh (lam * w / 2))
          (Complex.sinh (lam * J / 2) * (lam / 2)) J := by
        have hc : HasDerivAt Complex.cosh (Complex.sinh (lam * J / 2)) (lam * J / 2) :=
          Complex.hasDerivAt_cosh (lam * J / 2)
        exact hc.comp J hlin
      have h_u := h_u_num.div h_u_den hcosh
      set z : ℂ := lam * J / 2
      have h_u_simp :
          ((1 * secondFieldSinhc z + J * (deriv secondFieldSinhc z * (lam / 2))) * Complex.cosh z -
            (J * secondFieldSinhc z) * (Complex.sinh z * (lam / 2))) / Complex.cosh z ^ 2 =
          1 / Complex.cosh z ^ 2 := by
        have hnum_eq :
            (1 * secondFieldSinhc z + J * (deriv secondFieldSinhc z * (lam / 2))) * Complex.cosh z -
              (J * secondFieldSinhc z) * (Complex.sinh z * (lam / 2)) =
            (secondFieldSinhc z + z * deriv secondFieldSinhc z) * Complex.cosh z -
              (z * secondFieldSinhc z) * Complex.sinh z := by
          dsimp [z]; ring
        rw [hnum_eq, h_ode_sinhc z, hsinhc_mul z]
        have hsq : Complex.cosh z * Complex.cosh z - Complex.sinh z * Complex.sinh z = 1 := by
          simpa [sq] using Complex.cosh_sq_sub_sinh_sq z
        rw [hsq]
      have h_u' : HasDerivAt
          (fun w : ℂ => w * secondFieldSinhc (lam * w / 2) / Complex.cosh (lam * w / 2))
          (1 / Complex.cosh z ^ 2) J := h_u_simp ▸ h_u
      have h_sq := ((h_u'.pow 2).const_mul (1 / 8 : ℂ))
      have h_sq_val :
          (1 / 8 : ℂ) *
            (((2 : ℕ) : ℂ) * (J * secondFieldSinhc z / Complex.cosh z) ^ (2 - 1) *
              (1 / Complex.cosh z ^ 2)) =
          (J * secondFieldSinhc z) / (4 * Complex.cosh z ^ 3) := by
        push_cast
        field_simp [hcosh]
        ring
      exact (h_sq_val ▸ h_sq).congr_of_eventuallyEq h_ev

    have henergy_second : ∀ lam J : ℂ, Complex.cosh (lam * J / 2) ≠ 0 →
        frozenEnergyE .secondField lam J =
          (J ^ 3 / (12 * Complex.cosh (lam * J / 2) ^ 2)) * secondFieldGNum (lam * J / 2) := by
      intro lam J hcosh
      unfold frozenEnergyE
      rw [(hpQ_deriv lam J hcosh).deriv, hpQ_eq lam J]
      set z : ℂ := lam * J / 2
      have hstep :
          J * ((1 / 8 : ℂ) * (J * secondFieldSinhc z / Complex.cosh z) ^ 2) -
            ((J ^ 3 / 8) * H_Q z) / Complex.cosh z =
          (J ^ 3 / (24 * Complex.cosh z ^ 2)) *
            (3 * (secondFieldSinhc z ^ 2 - H_Q z * Complex.cosh z)) := by
        field_simp [hcosh]
        ring
      rw [hstep, h_Q_alg1 z]
      field_simp [hcosh]
      ring

    have htwist_second : ∀ lam J : ℂ, Complex.cosh (lam * J / 2) ≠ 0 →
        deriv (deriv (frozenActionP .secondField lam)) J =
          (J * secondFieldSinhc (lam * J / 2)) / (4 * Complex.cosh (lam * J / 2) ^ 3) :=
      fun lam J hcosh => (hpQ_deriv2 lam J hcosh).deriv

    have hlocal_J_inj : ∃ δ_E : ℝ, 0 < δ_E ∧
        ∀ (kind : ExpProfileKind) (lam J₁ J₂ : ℂ),
          ‖lam‖ < δ_E → ‖J₁ - 1‖ < δ_E → ‖J₂ - 1‖ < δ_E →
          frozenEnergyE kind lam J₁ = frozenEnergyE kind lam J₂ → J₁ = J₂ := by
      let p₀ : ℂ × ℂ := (0, 1)
      let cFn : ℂ × ℂ → ℂ := fun p => Complex.cosh (p.1 * p.2 / 2)
      let DF : ℂ × ℂ → ℂ := fun p => (p.2 ^ 2 / 4) * firstFieldSinc (p.1 * p.2 / 2)
      let DQ : ℂ × ℂ → ℂ := fun p =>
        (p.2 ^ 2 * secondFieldSinhc (p.1 * p.2 / 2)) / (4 * (cFn p) ^ 3)
      have hc_cont : Continuous cFn :=
        Complex.continuous_cosh.comp ((continuous_fst.mul continuous_snd).div_const 2)
      have hDF_cont : Continuous DF :=
        ((continuous_snd.pow 2).div_const 4).mul
          (hsinc_entire.continuous.comp ((continuous_fst.mul continuous_snd).div_const 2))
      have hc_p₀ : cFn p₀ = 1 := by simp [cFn, p₀]
      have hden_p₀ : 4 * (cFn p₀) ^ 3 ≠ 0 := by rw [hc_p₀]; norm_num
      have hDQ_contAt : ContinuousAt DQ p₀ := by
        refine ContinuousAt.div ?_ ?_ hden_p₀
        · exact ((continuous_snd.pow 2).mul
            (hsinhc_entire.continuous.comp
              ((continuous_fst.mul continuous_snd).div_const 2))).continuousAt
        · exact (continuous_const.mul (hc_cont.pow 3)).continuousAt
      have hDF_p₀ : DF p₀ = (1 / 4 : ℂ) := by simp [DF, p₀, hsinc_zero]
      have hDQ_p₀ : DQ p₀ = (1 / 4 : ℂ) := by simp [DQ, cFn, p₀, hsinhc_zero]
      have h_nhds1 : { p : ℂ × ℂ | cFn p ≠ 0 } ∈ nhds p₀ :=
        (isOpen_compl_singleton.preimage hc_cont).mem_nhds
          (by show cFn p₀ ≠ 0; rw [hc_p₀]; exact one_ne_zero)
      have h_nhds2 : { p : ℂ × ℂ | ‖DF p - (1 / 4 : ℂ)‖ < (1 / 8 : ℝ) } ∈ nhds p₀ := by
        refine Filter.mem_of_superset
          (hDF_cont.continuousAt (Metric.ball_mem_nhds _ (by norm_num : (0 : ℝ) < 1 / 8))) ?_
        intro p hp
        simpa [Metric.mem_ball, dist_eq_norm, hDF_p₀] using hp
      have h_nhds3 : { p : ℂ × ℂ | ‖DQ p - (1 / 4 : ℂ)‖ < (1 / 8 : ℝ) } ∈ nhds p₀ := by
        refine Filter.mem_of_superset
          (hDQ_contAt (Metric.ball_mem_nhds _ (by norm_num : (0 : ℝ) < 1 / 8))) ?_
        intro p hp
        simpa [Metric.mem_ball, dist_eq_norm, hDQ_p₀] using hp
      obtain ⟨δ_E, hδ_pos, hδ_sub⟩ :=
        Metric.mem_nhds_iff.mp (Filter.inter_mem h_nhds1 (Filter.inter_mem h_nhds2 h_nhds3))
      refine ⟨δ_E, hδ_pos, ?_⟩
      intro kind lam J₁ J₂ hlam hJ₁ hJ₂ hE_eq
      let s : Set ℂ := Metric.ball (1 : ℂ) δ_E
      have hs_conv : Convex ℝ s := convex_ball (1 : ℂ) δ_E
      have hJ₁_mem : J₁ ∈ s := by simpa [s, Metric.mem_ball, dist_eq_norm] using hJ₁
      have hJ₂_mem : J₂ ∈ s := by simpa [s, Metric.mem_ball, dist_eq_norm] using hJ₂
      have hp_mem : ∀ w ∈ s, (lam, w) ∈ Metric.ball p₀ δ_E := by
        intro w hw
        rw [Metric.mem_ball, Prod.dist_eq]
        exact max_lt (by simpa [p₀] using hlam) (by simpa [s, Metric.mem_ball, p₀] using hw)
      let g : ℂ → ℂ := fun w => frozenEnergyE kind lam w - (1 / 4 : ℂ) * w
      cases kind with
      | firstField =>
        have hg_deriv : ∀ w ∈ s, HasDerivWithinAt g (DF (lam, w) - (1 / 4 : ℂ)) s w := by
          intro w _
          have hdE : HasDerivAt (frozenEnergyE .firstField lam) (DF (lam, w)) w := by
            unfold frozenEnergyE
            have hd_mul := (hasDerivAt_id w).mul (hpF_deriv2 lam w)
            have hd_sub := hd_mul.sub (hpF_deriv lam w)
            have hval : 1 * deriv (frozenActionP .firstField lam) w +
                w * ((w / 4) * firstFieldSinc (lam * w / 2)) -
                (w ^ 2 / 4) * K_F (lam * w / 2) = DF (lam, w) := by
              rw [(hpF_deriv lam w).deriv]
              dsimp [DF]
              ring
            exact hval ▸ hd_sub
          have hlin14 : HasDerivAt (fun y : ℂ => (1 / 4 : ℂ) * y) (1 / 4 : ℂ) w := by
            simpa using (hasDerivAt_id w).const_mul (1 / 4 : ℂ)
          exact (hdE.sub hlin14).hasDerivWithinAt
        have hg_bound : ∀ w ∈ s, ‖DF (lam, w) - (1 / 4 : ℂ)‖ ≤ (1 / 8 : ℝ) :=
          fun w hw => (hδ_sub (hp_mem w hw)).2.1.le
        have hlip := hs_conv.norm_image_sub_le_of_norm_hasDerivWithin_le
          hg_deriv hg_bound hJ₂_mem hJ₁_mem
        have hg_diff : g J₁ - g J₂ = -(1 / 4 : ℂ) * (J₁ - J₂) := by
          dsimp [g]; rw [hE_eq]; ring
        rw [hg_diff, norm_mul, norm_neg] at hlip
        have h14 : ‖(1 / 4 : ℂ)‖ = (1 / 4 : ℝ) := by norm_num
        rw [h14] at hlip
        have hnorm0 : ‖J₁ - J₂‖ = 0 := le_antisymm (by linarith) (norm_nonneg _)
        exact sub_eq_zero.mp (norm_eq_zero.mp hnorm0)
      | secondField =>
        have hg_deriv : ∀ w ∈ s, HasDerivWithinAt g (DQ (lam, w) - (1 / 4 : ℂ)) s w := by
          intro w hw
          have hcw : Complex.cosh (lam * w / 2) ≠ 0 := (hδ_sub (hp_mem w hw)).1
          have hdE : HasDerivAt (frozenEnergyE .secondField lam) (DQ (lam, w)) w := by
            unfold frozenEnergyE
            have hd_mul := (hasDerivAt_id w).mul (hpQ_deriv2 lam w hcw)
            have hd_sub := hd_mul.sub (hpQ_deriv lam w hcw)
            have hval : 1 * deriv (frozenActionP .secondField lam) w +
                w * ((w * secondFieldSinhc (lam * w / 2)) / (4 * Complex.cosh (lam * w / 2) ^ 3)) -
                (1 / 8 : ℂ) *
                  (w * secondFieldSinhc (lam * w / 2) / Complex.cosh (lam * w / 2)) ^ 2 =
                DQ (lam, w) := by
              rw [(hpQ_deriv lam w hcw).deriv]
              dsimp [DQ, cFn]
              ring
            exact hval ▸ hd_sub
          have hlin14 : HasDerivAt (fun y : ℂ => (1 / 4 : ℂ) * y) (1 / 4 : ℂ) w := by
            simpa using (hasDerivAt_id w).const_mul (1 / 4 : ℂ)
          exact (hdE.sub hlin14).hasDerivWithinAt
        have hg_bound : ∀ w ∈ s, ‖DQ (lam, w) - (1 / 4 : ℂ)‖ ≤ (1 / 8 : ℝ) :=
          fun w hw => (hδ_sub (hp_mem w hw)).2.2.le
        have hlip := hs_conv.norm_image_sub_le_of_norm_hasDerivWithin_le
          hg_deriv hg_bound hJ₂_mem hJ₁_mem
        have hg_diff : g J₁ - g J₂ = -(1 / 4 : ℂ) * (J₁ - J₂) := by
          dsimp [g]; rw [hE_eq]; ring
        rw [hg_diff, norm_mul, norm_neg] at hlip
        have h14 : ‖(1 / 4 : ℂ)‖ = (1 / 4 : ℝ) := by norm_num
        rw [h14] at hlip
        have hnorm0 : ‖J₁ - J₂‖ = 0 := le_antisymm (by linarith) (norm_nonneg _)
        exact sub_eq_zero.mp (norm_eq_zero.mp hnorm0)

    exact ⟨{
      sinc_entire := hsinc_entire
      gF_entire := hgF_entire
      sinhc_entire := hsinhc_entire
      gQ_entire := hgQ_entire
      sinc_zero := hsinc_zero
      gF_zero := hgF_zero
      sinhc_zero := hsinhc_zero
      gQ_zero := hgQ_zero
      sinc_mul := hsinc_mul
      gF_mul := hgF_mul
      sinhc_mul := hsinhc_mul
      gQ_mul := hgQ_mul
      energy_first := henergy_first
      twist_first := htwist_first
      energy_second := henergy_second
      twist_second := htwist_second
      local_J_inj := hlocal_J_inj
    }, h_ode_gF, h_deriv_sinc⟩

  obtain ⟨hCalc, h_ode_gF, h_deriv_sinc⟩ := hStage1

  
  
  
  have hStage2 :
      (∀ (ρ C : ℝ) (c : ℕ → ℝ),
        0 < ρ → 0 ≤ C →
        (∀ m : ℕ, |c m| ≤ C * (ρ⁻¹) ^ (2 * m)) →
        let F : ℂ → ℂ := fun v => ∑' m : ℕ, (c m : ℂ) * v ^ (2 * m)
        let F' : ℂ → ℂ := fun v => ∑' m : ℕ, (c m : ℂ) * ((2 * m : ℕ) : ℂ) * v ^ (2 * m - 1)
        DifferentiableOn ℂ F (Metric.ball (0 : ℂ) ρ) ∧
        (∀ v ∈ Metric.ball (0 : ℂ) ρ, HasDerivAt F (F' v) v) ∧
        (∀ v ∈ Metric.ball (0 : ℂ) ρ, Summable (fun m : ℕ => (c m : ℂ) * v ^ (2 * m))) ∧
        (∀ v ∈ Metric.ball (0 : ℂ) ρ, Summable (fun m : ℕ => c m * ‖v‖ ^ (2 * m))) ∧
        (∀ v ∈ Metric.ball (0 : ℂ) ρ,
          Summable (fun m : ℕ => (c m : ℂ) * ((2 * m : ℕ) : ℂ) * v ^ (2 * m - 1))) ∧
        F 0 = c 0 ∧
        (∀ v : ℂ, F (-v) = F v) ∧
        (∀ r : ℝ, |r| < ρ → (F (r : ℂ)).im = 0 ∧ (F (r : ℂ)).re = ∑' m : ℕ, c m * r ^ (2 * m)) ∧
        (∀ k : ℂ, ∀ v ∈ Metric.ball (0 : ℂ) ρ,
          k * F v + v * deriv F v =
            ∑' m : ℕ, ((c m : ℂ) * (k + ((2 * m : ℕ) : ℂ))) * v ^ (2 * m))) ∧
      (∀ (c : ℕ → ℝ) (ρ : ℝ) (L : ℂ → ℂ),
        c 0 = 0 → 0 < c 1 → (∀ m : ℕ, 0 ≤ c m) → 0 < ρ →
        (∀ v ∈ Metric.ball (0 : ℂ) ρ, HasSum (fun m : ℕ => (c m : ℂ) * v ^ (2 * m)) (L v)) →
        ∃ p_even : ℕ → ℝ,
          p_even 0 = 1 ∧ p_even 1 = c 1 ∧ (∀ m : ℕ, 0 ≤ p_even m) ∧
