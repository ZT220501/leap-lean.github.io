            _ = C_st * ‖t‖ ^ 2 * M_scale ^ 2 * (D 0) ^ (1 - 2 * α) := by ring
        · have h1 := hb0_D 1 (by omega)
          have h_nonneg : 0 ≤ ‖t‖ ^ 2 * M_scale ^ 2 * (D 1) ^ (1 - 2 * α) :=
            mul_nonneg (mul_nonneg (sq_nonneg _) (sq_nonneg _))
              (Real.rpow_nonneg (hD_pos 1 (by omega)).le _)
          calc ‖b 0 - w 1‖
              ≤ 1 * (‖t‖ ^ 2 * M_scale ^ 2 * (D 1) ^ (1 - 2 * α)) := by linarith only [h1]
            _ ≤ C_st * (‖t‖ ^ 2 * M_scale ^ 2 * (D 1) ^ (1 - 2 * α)) :=
                mul_le_mul_of_nonneg_right hCst_ge_one h_nonneg
            _ = C_st * ‖t‖ ^ 2 * M_scale ^ 2 * (D 1) ^ (1 - 2 * α) := by ring
        · intro k hk
          have hk0 : k = 0 := by omega
          subst hk0
          have hJ0 := hJ0_D 1 (by omega)
          have h_nonneg : 0 ≤ ‖t‖ ^ 2 * M_scale ^ 2 * (D 1) ^ (-2 * α) :=
            mul_nonneg (mul_nonneg (sq_nonneg _) (sq_nonneg _))
              (Real.rpow_nonneg (hD_pos 1 (by omega)).le _)
          calc ‖J_step 0 - 1‖
              ≤ 1 * (‖t‖ ^ 2 * M_scale ^ 2 * (D 1) ^ (-2 * α)) := by linarith only [hJ0]
            _ ≤ C_J * (‖t‖ ^ 2 * M_scale ^ 2 * (D 1) ^ (-2 * α)) :=
