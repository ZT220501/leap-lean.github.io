        apply Finset.sum_subset Finset.subset_union_left
        intro w _ hw_not
        apply Polynomial.rootMultiplicity_eq_zero
        intro h_is_root
        exact hw_not (Multiset.mem_toFinset.mpr ((Polynomial.mem_roots hW_ne).mpr h_is_root))
      calc ∑ w ∈ S, Polynomial.rootMultiplicity w W_ρ
        ≤ ∑ w ∈ W_ρ.roots.toFinset ∪ S, Polynomial.rootMultiplicity w W_ρ :=
            Finset.sum_le_sum_of_subset Finset.subset_union_right
        _ = W_ρ.natDegree := by rw [h_union, h_sum_roots W_ρ hW_ne]
