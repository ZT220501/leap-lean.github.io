      rw [hfn]
      exact (G.N_Z_holo.mono hW₁_sub_B).mul ((G.D_ZW_holo.mono hW₁_sub_B).fun_inv hD_ne_W₁)
    have hXW_W₁ : DifferentiableOn ℂ X_W W₁ := by
      have hfn : X_W = fun p => G.N_W p * (G.D_ZW p)⁻¹ := by
        ext p; exact div_eq_mul_inv _ _
      rw [hfn]
      exact (G.N_W_holo.mono hW₁_sub_B).mul ((G.D_ZW_holo.mono hW₁_sub_B).fun_inv hD_ne_W₁)
