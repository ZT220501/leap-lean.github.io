          ≤ (2 * T₀ * (d_seq n / B_seq n)) * shapeModulus S s :=
            mul_le_mul hh_norm (le_max_left _ _) (norm_nonneg _) (by positivity)
        _ = 2 * T₀ * ((d_seq n / B_seq n) * shapeModulus S s) := by ring
        _ ≤ 2 * T₀ * (C_core.C_A * b_rec ^ α) := mul_le_mul_of_nonneg_left h0 (by positivity)
        _ = 2 * T₀ * C_core.C_A * b_rec ^ α := by ring
        _ < A.η_SL := lt_of_le_of_lt hb_rec_R1 (by linarith)
    · intro w hw
      have hw_bd := (h_seg_pt w hw).2
      have h_sqrt : (d_seq n / B_seq n) * Real.sqrt ‖S.q (s + (w : ℂ) * h)‖ ≤
