                (C_res / (2 * α * γ_steep)) * ‖t‖ ^ 2 * M_scale ^ 2 * (D (j + 2)) ^ (-2 * α) =
              C_J * ‖t‖ ^ 2 * M_scale ^ 2 * (D (j + 2)) ^ (-2 * α) := by
            dsimp only [C_J]
            ring
          rw [h_comb] at h_add
          exact le_trans h_norm_tel h_add
        have hJ_all : ∀ k ≤ j + 1,
            ‖J_step k - 1‖ ≤ C_J * ‖t‖ ^ 2 * M_scale ^ 2 * (D (k + 1)) ^ (-2 * α) := by
          intro k hk
          rcases Nat.of_le_succ hk with hle | hk_eq
          · exact ih_J k hle
          · subst hk_eq
            exact hJ_top
        
        have hb_top : ‖b (j + 1) - w (j + 2)‖ ≤
            C_st * ‖t‖ ^ 2 * M_scale ^ 2 * (D (j + 2)) ^ (1 - 2 * α) := by
          have h_tel : b (j + 1) - w (j + 2) =
