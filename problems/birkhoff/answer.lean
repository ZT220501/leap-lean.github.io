    intro i col
    exact (hsum_holo_gen Finset.univ _ fun r _ =>
      (hWinv_holo i r).mul (hCdiff_ode r col)).neg
  have hd_ode : ∀ i : Fin m,
      DifferentiableOn ℂ (fun p => d_vec p i) (webODEDomain ψ w U₀ U_plus) := by
    intro i
    exact hsum_holo_gen Finset.univ _ fun r _ =>
      (hWinv_holo i r).mul (hBiter_ode r)
  have hMbase_ode : ∀ idx col : Fin m × Fin m,
      DifferentiableOn ℂ (fun p => M_base p idx col) (webODEDomain ψ w U₀ U_plus) := by
    intro idx col
    by_cases h : idx.2.val + 1 < m
    · simp only [M_base, dif_pos h]
      exact differentiableOn_const _
    · simp only [M_base, dif_neg h]
      exact hK_ode idx.1 col
  have hcbase_ode : ∀ idx : Fin m × Fin m,
      DifferentiableOn ℂ (fun p => c_base p idx) (webODEDomain ψ w U₀ U_plus) := by
    intro idx
    by_cases h : idx.2.val + 1 < m
    · simp only [c_base, if_pos h]
      exact differentiableOn_const 0
    · simp only [c_base, if_neg h]
      exact hd_ode idx.1
  have hA_ode : ∀ i : Fin m, DifferentiableOn ℂ (pderivA (ψ i)) (webODEDomain ψ w U₀ U_plus) :=
    fun i => (hA_U₀ i).mono hode_U₀
  have hBψ_ode : ∀ i : Fin m, DifferentiableOn ℂ (pderivD (ψ i)) (webODEDomain ψ w U₀ U_plus) :=
    fun i => (hBψ_U₀ i).mono hode_U₀
  refine ⟨{
