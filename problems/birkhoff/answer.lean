        induction n using Int.induction_on with
        | zero => intro z _; simp
        | succ n ihn =>
            intro z hz
            have hzn_mem : (z + ((n : ℤ) : ℂ) * (2 * (Real.pi : ℂ)), t) ∈ glancingDomain 1 s d := by
