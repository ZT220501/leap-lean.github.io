      rwa [h_eq]
    let Z_t : Set (ℂ × ℂ) := { p ∈ Ω_tube | ∀ q ∈ Metric.ball p (r_t p), Res p q = 0 }
    let V_zero : Set (ℂ × ℂ) := ⋃ p ∈ Z_t, Metric.ball p (r_t p)
    let V_nz : Set (ℂ × ℂ) := ⋃ p ∈ Ω_tube \ Z_t, Metric.ball p (r_t p)
    have hVz_open : IsOpen V_zero := isOpen_biUnion (fun _ _ => Metric.isOpen_ball)
    have hVnz_open : IsOpen V_nz := isOpen_biUnion (fun _ _ => Metric.isOpen_ball)
    have hΩ_cov : Ω_tube ⊆ V_zero ∪ V_nz := by
      intro p hp
      by_cases hpZ : p ∈ Z_t
      · exact Or.inl (Set.mem_biUnion hpZ (Metric.mem_ball_self (hr_t_spec p hp).1))
      · exact Or.inr (Set.mem_biUnion ⟨hp, hpZ⟩ (Metric.mem_ball_self (hr_t_spec p hp).1))
    have h_disj : Ω_tube ∩ (V_zero ∩ V_nz) = ∅ := by
      ext q₀
      simp only [Set.mem_inter_iff, Set.mem_empty_iff_false, iff_false, not_and]
      intro _ hq_z hq_nz
      rcases Set.mem_iUnion₂.mp hq_z with ⟨p₁, hp₁Z, hq_b₁⟩
      rcases Set.mem_iUnion₂.mp hq_nz with ⟨p₂, ⟨hp₂Ω, hp₂_nZ⟩, hq_b₂⟩
      obtain ⟨_, _, hr_L₁, hr_s₁⟩ := hr_t_spec p₁ hp₁Z.1
      obtain ⟨_, _, hr_L₂, hr_s₂⟩ := hr_t_spec p₂ hp₂Ω
      let B₁₂ := Metric.ball p₁ (r_t p₁) ∩ Metric.ball p₂ (r_t p₂)
      have hB₁₂_open : IsOpen B₁₂ := Metric.isOpen_ball.inter Metric.isOpen_ball
      have hp₁_sh : L_s p₁ ∈ Ω_sh := hL_s_maps p₁ hp₁Z.1.1
      have hp₂_sh : L_s p₂ ∈ Ω_sh := hL_s_maps p₂ hp₂Ω.1
      have h_D1_cont : ContinuousOn (fun q => D_sh (L_s p₁) (L_s q)) B₁₂ :=
        ((hD_holo (L_s p₁) hp₁_sh).comp hL_s_diff.differentiableOn (fun q hq =>
          h_shear_ball s_minus (r_t p₁) (r_sh (L_s p₁)) p₁ q hq.1 hr_s₁)).continuousOn
      have h_den1_nz : ∀ V : Set (ℂ × ℂ), IsOpen V → V.Nonempty → V ⊆ B₁₂ →
          ∃ q ∈ V, ((W.L_mero ι).den p₁ q) ^ D ≠ 0 := by
        intro V hV hV_ne hV_sub
        by_contra h_none
        have h_all : ∀ q ∈ V, (W.L_mero ι).den p₁ q = 0 := by
          intro q hq
          by_contra hne
          exact h_none ⟨q, hq, pow_ne_zero D hne⟩
        obtain ⟨q_w, hq_w_mem, hq_w_nz⟩ := (W.L_mero ι).den_ne_zero p₁ hp₁Z.1.2
        exact hq_w_nz (B_cr.eqOn_zero_of_preconnected_2D Metric.isOpen_ball
          (convex_ball _ _).isPreconnected hV hV_ne
          (Set.Subset.trans hV_sub
            (Set.Subset.trans Set.inter_subset_left (Metric.ball_subset_ball hr_L₁)))
          ((W.L_mero ι).den_holo p₁ hp₁Z.1.2) h_all q_w hq_w_mem)
      obtain ⟨q₁, hq₁_mem, hq₁_prod_nz⟩ := h_mul_nz hB₁₂_open h_D1_cont
        (hD_pull_nz hp₁_sh (fun q hq =>
          h_shear_ball s_minus (r_t p₁) (r_sh (L_s p₁)) p₁ q hq.1 hr_s₁))
        h_den1_nz B₁₂ hB₁₂_open ⟨q₀, hq_b₁, hq_b₂⟩ Set.Subset.rfl
      have h_prod_cont : ContinuousOn
          (fun q => D_sh (L_s p₁) (L_s q) * ((W.L_mero ι).den p₁ q) ^ D) B₁₂ :=
        h_D1_cont.mul (h_pow_holo (((W.L_mero ι).den_holo p₁ hp₁Z.1.2).mono
          (Set.Subset.trans Set.inter_subset_left (Metric.ball_subset_ball hr_L₁))) D).continuousOn
      have h_ev : ∀ᶠ q in nhds q₁,
          q ∈ B₁₂ ∧ D_sh (L_s p₁) (L_s q) * ((W.L_mero ι).den p₁ q) ^ D ≠ 0 :=
        Filter.eventually_and.mpr ⟨hB₁₂_open.mem_nhds hq₁_mem,
          (h_prod_cont.continuousAt (hB₁₂_open.mem_nhds hq₁_mem)).eventually_ne hq₁_prod_nz⟩
      obtain ⟨δ', hδ'_pos, hδ'_sub⟩ := Metric.eventually_nhds_iff_ball.mp h_ev
      have h_res2_zero : ∀ q ∈ Metric.ball q₁ δ', Res p₂ q = 0 := by
        intro q hq
        obtain ⟨hqB, h_fac_nz⟩ := hδ'_sub q hq
        have hL_q₁ : L_s q ∈ Metric.ball (L_s p₁) (r_sh (L_s p₁)) :=
          h_shear_ball s_minus (r_t p₁) (r_sh (L_s p₁)) p₁ q hqB.1 hr_s₁
        have hL_q₂ : L_s q ∈ Metric.ball (L_s p₂) (r_sh (L_s p₂)) :=
          h_shear_ball s_minus (r_t p₂) (r_sh (L_s p₂)) p₂ q hqB.2 hr_s₂
        have h_mero_c := (W.L_mero ι).compat p₁ hp₁Z.1.2 p₂ hp₂Ω.2 q
          ⟨Metric.ball_subset_ball hr_L₁ hqB.1, Metric.ball_subset_ball hr_L₂ hqB.2⟩
        have h_ov : Res p₁ q * (D_sh (L_s p₂) (L_s q) * ((W.L_mero ι).den p₂ q) ^ D) =
            Res p₂ q * (D_sh (L_s p₁) (L_s q) * ((W.L_mero ι).den p₁ q) ^ D) := by
          dsimp [Res]
          rw [Finset.sum_mul, Finset.sum_mul]
          refine Finset.sum_congr rfl (fun d _ => ?_)
          have hd_le : (d : ℕ) ≤ D := Nat.lt_succ_iff.mp d.2
          have hN_c := hCompat d (L_s p₁) hp₁_sh (L_s p₂) hp₂_sh (L_s q) ⟨hL_q₁, hL_q₂⟩
          have hv₁ : ((W.L_mero ι).den p₁ q) ^ D =
              ((W.L_mero ι).den p₁ q) ^ (d : ℕ) * ((W.L_mero ι).den p₁ q) ^ (D - (d : ℕ)) := by
            rw [← pow_add, Nat.add_sub_of_le hd_le]
          have hv₂ : ((W.L_mero ι).den p₂ q) ^ D =
              ((W.L_mero ι).den p₂ q) ^ (d : ℕ) * ((W.L_mero ι).den p₂ q) ^ (D - (d : ℕ)) := by
            rw [← pow_add, Nat.add_sub_of_le hd_le]
          rw [hv₁, hv₂]
          calc N_sh d (L_s p₁) (L_s q) * (W.L_mero ι).num p₁ q ^ (d : ℕ) *
                (W.L_mero ι).den p₁ q ^ (D - (d : ℕ)) *
                (D_sh (L_s p₂) (L_s q) *
                  ((W.L_mero ι).den p₂ q ^ (d : ℕ) * (W.L_mero ι).den p₂ q ^ (D - (d : ℕ))))
              = (N_sh d (L_s p₁) (L_s q) * D_sh (L_s p₂) (L_s q)) *
                ((W.L_mero ι).num p₁ q * (W.L_mero ι).den p₂ q) ^ (d : ℕ) *
                ((W.L_mero ι).den p₁ q * (W.L_mero ι).den p₂ q) ^ (D - (d : ℕ)) := by
                  simp only [mul_pow]
                  ring
            _ = (N_sh d (L_s p₂) (L_s q) * D_sh (L_s p₁) (L_s q)) *
                ((W.L_mero ι).num p₂ q * (W.L_mero ι).den p₁ q) ^ (d : ℕ) *
                ((W.L_mero ι).den p₁ q * (W.L_mero ι).den p₂ q) ^ (D - (d : ℕ)) := by
                  rw [hN_c, h_mero_c]
            _ = N_sh d (L_s p₂) (L_s q) * (W.L_mero ι).num p₂ q ^ (d : ℕ) *
                (W.L_mero ι).den p₂ q ^ (D - (d : ℕ)) *
                (D_sh (L_s p₁) (L_s q) *
                  ((W.L_mero ι).den p₁ q ^ (d : ℕ) * (W.L_mero ι).den p₁ q ^ (D - (d : ℕ)))) := by
                  simp only [mul_pow]
                  ring
        rw [hp₁Z.2 q hqB.1, zero_mul] at h_ov
        exact (mul_eq_zero.mp h_ov.symm).resolve_right h_fac_nz
      have hp₂_Z : p₂ ∈ Z_t := ⟨hp₂Ω, B_cr.eqOn_zero_of_preconnected_2D Metric.isOpen_ball
        (convex_ball _ _).isPreconnected Metric.isOpen_ball ⟨q₁, Metric.mem_ball_self hδ'_pos⟩
        (fun q hq => (hδ'_sub q hq).1.2) (hRes_holo p₂ hp₂Ω) h_res2_zero⟩
      exact hp₂_nZ hp₂_Z
    have h_or := (isPreconnected_iff_subset_of_disjoint.mp hΩ_tube_preconn)
      V_zero V_nz hVz_open hVnz_open hΩ_cov h_disj
    have hp_base_tube : p_base ∈ Ω_tube := hB_un_sub hp_base_mem
    have hp_base_Z : p_base ∈ Z_t := by
      refine ⟨hp_base_tube, ?_⟩
      obtain ⟨r₀, hr₀_pos, _, h_b0⟩ := hBaseZero
      have hp_base_collar : p_base ∈
          { q : ℂ × ℂ | |q.1.im| < 2 * W.s_base ∧ ‖q.2‖ < W.r_base } := by
        dsimp [p_base]
        simp only [abs_zero]
        exact ⟨by linarith [W.s_base_pos], hp_base_tube.2.1⟩
      obtain ⟨r_ag, hr_ag_pos, _, _, hr_ag_eq⟩ := (W.L_agrees_two ι).2 p_base hp_base_collar
      let r_loc := min (r_t p_base) (min r₀ r_ag)
      have hr_loc_pos : 0 < r_loc :=
        lt_min (hr_t_spec p_base hp_base_tube).1 (lt_min hr₀_pos hr_ag_pos)
      have h_zero_loc : ∀ q ∈ Metric.ball p_base r_loc, Res p_base q = 0 := by
        intro q hq
        have hq_r₀ : q ∈ Metric.ball p_base r₀ :=
          Metric.ball_subset_ball (le_trans (min_le_right _ _) (min_le_left _ _)) hq
        have hq_ag : q ∈ Metric.ball p_base r_ag :=
          Metric.ball_subset_ball (le_trans (min_le_right _ _) (min_le_right _ _)) hq
        have h_num_eq := hr_ag_eq q hq_ag
        have h_sum_eq : Res p_base q =
            ((W.L_mero ι).den p_base q) ^ D *
              ∑ d : Fin (D + 1),
                N_sh d (L_s p_base) (L_s q) * (glancingDualLine C q.1 q.2 ι) ^ (d : ℕ) := by
          dsimp [Res]
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl (fun d _ => ?_)
          have hd_le : (d : ℕ) ≤ D := Nat.lt_succ_iff.mp d.2
          rw [h_num_eq, mul_pow]
          calc N_sh d (L_s p_base) (L_s q) *
                (glancingDualLine C q.1 q.2 ι ^ (d : ℕ) * (W.L_mero ι).den p_base q ^ (d : ℕ)) *
                (W.L_mero ι).den p_base q ^ (D - (d : ℕ))
              = ((W.L_mero ι).den p_base q ^ (d : ℕ) *
                  (W.L_mero ι).den p_base q ^ (D - (d : ℕ))) *
                (N_sh d (L_s p_base) (L_s q) * glancingDualLine C q.1 q.2 ι ^ (d : ℕ)) := by ring
            _ = (W.L_mero ι).den p_base q ^ D *
                (N_sh d (L_s p_base) (L_s q) * glancingDualLine C q.1 q.2 ι ^ (d : ℕ)) := by
                  rw [← pow_add, Nat.add_sub_of_le hd_le]
        rw [h_sum_eq, h_b0 q hq_r₀, mul_zero]
      exact B_cr.eqOn_zero_of_preconnected_2D Metric.isOpen_ball (convex_ball _ _).isPreconnected
        Metric.isOpen_ball ⟨p_base, Metric.mem_ball_self hr_loc_pos⟩
        (Metric.ball_subset_ball (min_le_left _ _)) (hRes_holo p_base hp_base_tube) h_zero_loc
    have hΩ_sub_Vz : Ω_tube ⊆ V_zero := by
      rcases h_or with h_sub_z | h_sub_nz
      · exact h_sub_z
      · exfalso
        have h_emp : p_base ∈ Ω_tube ∩ (V_zero ∩ V_nz) :=
          ⟨hp_base_tube,
            Set.mem_biUnion hp_base_Z (Metric.mem_ball_self (hr_t_spec p_base hp_base_tube).1),
            h_sub_nz hp_base_tube⟩
        rw [h_disj] at h_emp
        exact h_emp
    have hp_tgt_tube : p_tgt ∈ Ω_tube := ⟨hU_β_sub hp_tgt.1, hp_tgt.2⟩
    have hp_tgt_Z : p_tgt ∈ Z_t := by
      by_contra h_nZ
      have h_emp : p_tgt ∈ Ω_tube ∩ (V_zero ∩ V_nz) :=
        ⟨hp_tgt_tube, hΩ_sub_Vz hp_tgt_tube,
          Set.mem_biUnion ⟨hp_tgt_tube, h_nZ⟩
            (Metric.mem_ball_self (hr_t_spec p_tgt hp_tgt_tube).1)⟩
      rw [h_disj] at h_emp
      exact h_emp
    obtain ⟨hr_t_pos, _, hr_t_L, hr_t_s⟩ := hr_t_spec p_tgt hp_tgt_tube
    obtain ⟨r_u, hr_u_pos, hr_u_sub⟩ := Metric.isOpen_iff.mp hU_β_open p_tgt hp_tgt.1
    let r_p := min r_u (r_t p_tgt)
    have hr_p_pos : 0 < r_p := lt_min hr_u_pos hr_t_pos
    have hr_p_L : r_p ≤ (W.L_mero ι).rad p_tgt := le_trans (min_le_right _ _) hr_t_L
    have hr_p_U : Metric.ball p_tgt r_p ⊆ U_β :=
      Set.Subset.trans (Metric.ball_subset_ball (min_le_left _ _)) hr_u_sub
    have hr_p_bt : Metric.ball p_tgt r_p ⊆ Metric.ball p_tgt (r_t p_tgt) :=
      Metric.ball_subset_ball (min_le_right _ _)
    refine ⟨r_p, hr_p_pos, hr_p_L, hr_p_U, ?_⟩
    let tgt_sum : ℂ × ℂ → ℂ := fun q =>
      ∑ d : Fin (D + 1),
        N_sh d p_sh_b (L_s q) * ((W.L_mero ι).num p_tgt q) ^ (d : ℕ) *
          ((W.L_mero ι).den p_tgt q) ^ (D - (d : ℕ))
    have htgt_holo : DifferentiableOn ℂ tgt_sum (Metric.ball p_tgt r_p) := by
      refine DifferentiableOn.fun_sum (fun d _ => ?_)
      have hN_c : DifferentiableOn ℂ (fun q => N_sh d p_sh_b (L_s q)) (Metric.ball p_tgt r_p) :=
        (hN_holo d p_sh_b hp_sh_b).comp hL_s_diff.differentiableOn
          (fun q hq => hU_β_map q (hr_p_U hq))
      have h_num : DifferentiableOn ℂ (fun q => ((W.L_mero ι).num p_tgt q) ^ (d : ℕ))
          (Metric.ball p_tgt r_p) :=
        h_pow_holo (((W.L_mero ι).num_holo p_tgt hp_tgt.2).mono
          (Metric.ball_subset_ball hr_p_L)) (d : ℕ)
      have h_den : DifferentiableOn ℂ (fun q => ((W.L_mero ι).den p_tgt q) ^ (D - (d : ℕ)))
          (Metric.ball p_tgt r_p) :=
        h_pow_holo (((W.L_mero ι).den_holo p_tgt hp_tgt.2).mono
          (Metric.ball_subset_ball hr_p_L)) (D - (d : ℕ))
      exact (hN_c.mul h_num).mul h_den
    have hp_tgt_sh : L_s p_tgt ∈ Ω_sh := hL_s_maps p_tgt hp_tgt_tube.1
    obtain ⟨q₁, hq₁_mem, hq₁_D_nz⟩ := hD_pull_nz hp_tgt_sh
      (fun q hq => h_shear_ball s_minus (r_t p_tgt) (r_sh (L_s p_tgt)) p_tgt q
        (hr_p_bt hq) hr_t_s)
      (Metric.ball p_tgt r_p) Metric.isOpen_ball ⟨p_tgt, Metric.mem_ball_self hr_p_pos⟩
      Set.Subset.rfl
    have hD_tgt_cont : ContinuousOn (fun q => D_sh (L_s p_tgt) (L_s q))
        (Metric.ball p_tgt r_p) :=
      ((hD_holo (L_s p_tgt) hp_tgt_sh).comp hL_s_diff.differentiableOn
        (fun q hq => h_shear_ball s_minus (r_t p_tgt) (r_sh (L_s p_tgt)) p_tgt q
          (hr_p_bt hq) hr_t_s)).continuousOn
    have h_ev : ∀ᶠ q in nhds q₁,
        q ∈ Metric.ball p_tgt r_p ∧ D_sh (L_s p_tgt) (L_s q) ≠ 0 :=
      Filter.eventually_and.mpr ⟨Metric.isOpen_ball.mem_nhds hq₁_mem,
        (hD_tgt_cont.continuousAt (Metric.isOpen_ball.mem_nhds hq₁_mem)).eventually_ne hq₁_D_nz⟩
    obtain ⟨δ_p, hδ_p_pos, hδ_p_sub⟩ := Metric.eventually_nhds_iff_ball.mp h_ev
    have htgt_zero_sub : ∀ q ∈ Metric.ball q₁ δ_p, tgt_sum q = 0 := by
      intro q hq
      obtain ⟨hq_rp, hD_q_nz⟩ := hδ_p_sub q hq
      have h_mul_eq : tgt_sum q * D_sh (L_s p_tgt) (L_s q) =
          Res p_tgt q * D_sh p_sh_b (L_s q) := by
        dsimp [tgt_sum, Res]
        rw [Finset.sum_mul, Finset.sum_mul]
        refine Finset.sum_congr rfl (fun d _ => ?_)
        have hc := hCompat d p_sh_b hp_sh_b (L_s p_tgt) hp_tgt_sh (L_s q)
          ⟨hU_β_map q (hr_p_U hq_rp),
            h_shear_ball s_minus (r_t p_tgt) (r_sh (L_s p_tgt)) p_tgt q
              (hr_p_bt hq_rp) hr_t_s⟩
        calc N_sh d p_sh_b (L_s q) * (W.L_mero ι).num p_tgt q ^ (d : ℕ) *
              (W.L_mero ι).den p_tgt q ^ (D - (d : ℕ)) * D_sh (L_s p_tgt) (L_s q)
            = (N_sh d p_sh_b (L_s q) * D_sh (L_s p_tgt) (L_s q)) *
              ((W.L_mero ι).num p_tgt q ^ (d : ℕ) *
                (W.L_mero ι).den p_tgt q ^ (D - (d : ℕ))) := by ring
          _ = (N_sh d (L_s p_tgt) (L_s q) * D_sh p_sh_b (L_s q)) *
              ((W.L_mero ι).num p_tgt q ^ (d : ℕ) *
                (W.L_mero ι).den p_tgt q ^ (D - (d : ℕ))) := by rw [hc]
          _ = N_sh d (L_s p_tgt) (L_s q) * (W.L_mero ι).num p_tgt q ^ (d : ℕ) *
              (W.L_mero ι).den p_tgt q ^ (D - (d : ℕ)) * D_sh p_sh_b (L_s q) := by ring
      rw [hp_tgt_Z.2 q (hr_p_bt hq_rp), zero_mul] at h_mul_eq
      exact (mul_eq_zero.mp h_mul_eq).resolve_right hD_q_nz
    exact B_cr.eqOn_zero_of_preconnected_2D Metric.isOpen_ball (convex_ball _ _).isPreconnected
      Metric.isOpen_ball ⟨q₁, Metric.mem_ball_self hδ_p_pos⟩
      (fun q hq => (hδ_p_sub q hq).1) htgt_holo htgt_zero_sub

  
  have h_s5 : ∀ (r_chart : Fin S.N_slab → ℂ × ℂ → ℝ),
      (∀ α : Fin S.N_slab,
        ∀ q_sh ∈ bandShearedSlab W.s_base H₁ ε (S.x_c α) (S.s_minus α) t₁ S.r₁,
          0 < r_chart α q_sh) →
      Nonempty (SsbpcBandChartBidiskCover W.s_base H₁ ε t₁ S.r₁ S.N_slab
        S.x_c S.s_minus r_chart) := by
    intro r_chart hr_chart_pos
    let mk_y : ℝ × ℝ → ℂ := fun u => (u.1 : ℂ) + (u.2 : ℂ) * Complex.I
    let K_y : Set ℂ :=
      mk_y '' (Set.Icc (0 : ℝ) (2 * Real.pi) ×ˢ Set.Icc (H₁ - ε / 16) (H₁ + ε / 16))
    let K_band : Set (ℂ × ℂ) := K_y ×ˢ Metric.closedBall (t₁ : ℂ) (S.r₁ / 2)
    have hmk_cont : Continuous mk_y :=
      (Complex.continuous_ofReal.comp continuous_fst).add
        ((Complex.continuous_ofReal.comp continuous_snd).mul continuous_const)
    have hK_compact : IsCompact K_band :=
      ((isCompact_Icc.prod isCompact_Icc).image hmk_cont).prod
        (isCompact_closedBall (t₁ : ℂ) (S.r₁ / 2))
    have h_pt_slab : ∀ pt : ↥K_band,
        ∃ α : Fin S.N_slab,
          pt.1 ∈ bandUnshearedSlab W.s_base H₁ ε (S.x_c α) t₁ S.r₁ := by
      intro pt
      rcases pt with ⟨⟨y, τ⟩, ⟨⟨⟨x, y_im⟩, ⟨hx, hy_im⟩, hy_eq⟩, hτ⟩⟩
      dsimp only at hx hy_im hy_eq hτ
      obtain ⟨α, hα⟩ := S.covers_period x hx
      refine ⟨α, ?_⟩
      have hy_re : y.re = x := by rw [← hy_eq]; simp [mk_y]
      have hy_i : y.im = y_im := by rw [← hy_eq]; simp [mk_y]
      have hτ_lt : ‖τ - (t₁ : ℂ)‖ < S.r₁ := by
        have h_le : ‖τ - (t₁ : ℂ)‖ ≤ S.r₁ / 2 := by
          simpa [Metric.mem_closedBall, dist_eq_norm] using hτ
        linarith [S.r₁_pos]
      exact ⟨by simpa [hy_re] using hα,
        by dsimp only; rw [hy_i]; linarith [hy_im.1, hH₁_ge, hε_lt, W.s_base_pos],
        by dsimp only; rw [hy_i]; linarith [hy_im.2, hε_pos],
        hτ_lt⟩
    let α_pt : ↥K_band → Fin S.N_slab := fun pt => Classical.choose (h_pt_slab pt)
    have hα_pt_mem : ∀ pt : ↥K_band,
        pt.1 ∈ bandUnshearedSlab W.s_base H₁ ε (S.x_c (α_pt pt)) t₁ S.r₁ :=
      fun pt => Classical.choose_spec (h_pt_slab pt)
    have h_pt_rΩ : ∀ pt : ↥K_band, ∃ r : ℝ,
        0 < r ∧ Metric.ball pt.1 r ⊆
          bandUnshearedSlab W.s_base H₁ ε (S.x_c (α_pt pt)) t₁ S.r₁ :=
      fun pt => Metric.isOpen_iff.mp (h_unsheared_open (S.x_c (α_pt pt))) pt.1 (hα_pt_mem pt)
    let rΩ_pt : ↥K_band → ℝ := fun pt => Classical.choose (h_pt_rΩ pt)
    have hrΩ_spec : ∀ pt : ↥K_band,
        0 < rΩ_pt pt ∧ Metric.ball pt.1 (rΩ_pt pt) ⊆
          bandUnshearedSlab W.s_base H₁ ε (S.x_c (α_pt pt)) t₁ S.r₁ :=
      fun pt => Classical.choose_spec (h_pt_rΩ pt)
    let p_sh_pt : ↥K_band → ℂ × ℂ := fun pt =>
      (pt.1.1 + (S.s_minus (α_pt pt) : ℂ) * pt.1.2, pt.1.2)
    have hp_sh_mem : ∀ pt : ↥K_band,
        p_sh_pt pt ∈ bandShearedSlab W.s_base H₁ ε
          (S.x_c (α_pt pt)) (S.s_minus (α_pt pt)) t₁ S.r₁ := by
      intro pt
      dsimp [bandShearedSlab, p_sh_pt]
      convert hα_pt_mem pt using 1
      ext <;> simp
    let ρ_pt : ↥K_band → ℝ := fun pt =>
      min (S.r₁ / 4)
        (min (rΩ_pt pt)
          (r_chart (α_pt pt) (p_sh_pt pt) / (1 + |S.s_minus (α_pt pt)|)))
    have hρ_pt_pos : ∀ pt : ↥K_band, 0 < ρ_pt pt := by
      intro pt
      refine lt_min (by linarith [S.r₁_pos]) (lt_min (hrΩ_spec pt).1 ?_)
      exact div_pos (hr_chart_pos (α_pt pt) (p_sh_pt pt) (hp_sh_mem pt))
        (by linarith [abs_nonneg (S.s_minus (α_pt pt))])
    obtain ⟨T_fin, hT_cov⟩ := hK_compact.elim_finite_subcover
      (fun pt : ↥K_band => Metric.ball pt.1 (3 * ρ_pt pt / 4))
      (fun _ => Metric.isOpen_ball)
      (fun p hp => Set.mem_iUnion.mpr ⟨⟨p, hp⟩,
        Metric.mem_ball_self (by linarith [hρ_pt_pos ⟨p, hp⟩])⟩)
    let e := T_fin.equivFin.symm
    refine ⟨{
      N_cov := T_fin.card
      α_of := fun β => α_pt (e β).1
      y_c := fun β => (e β).1.1.1
      τ_c := fun β => (e β).1.1.2
      ρ := fun β => ρ_pt (e β).1
      ρ_pos := fun β => by
        let pt := (e β).1
        refine ⟨hρ_pt_pos pt, ?_⟩
        intro τ hτ
        rw [Metric.mem_ball] at hτ ⊢
        change dist τ pt.1.2 < ρ_pt pt at hτ
        have h1 : ρ_pt pt ≤ S.r₁ / 4 := min_le_left _ _
        have h2 : dist pt.1.2 (t₁ : ℂ) ≤ S.r₁ / 2 :=
          Metric.mem_closedBall.mp pt.2.2
        linarith [dist_triangle τ pt.1.2 (t₁ : ℂ), S.r₁_pos]
      covers_band := fun x y_im t hx hy_im ht => by
        let p : ℂ × ℂ := ((x : ℂ) + (y_im : ℂ) * Complex.I, t)
        have hp_K : p ∈ K_band := ⟨⟨(x, y_im), ⟨hx, hy_im⟩, rfl⟩, ht⟩
        rcases Set.mem_iUnion₂.mp (hT_cov hp_K) with ⟨pt, hpt_T, hp_ball⟩
        let β : Fin T_fin.card := T_fin.equivFin ⟨pt, hpt_T⟩
        have heβ : e β = ⟨pt, hpt_T⟩ := T_fin.equivFin.symm_apply_apply ⟨pt, hpt_T⟩
        rw [← ball_prod_same] at hp_ball
        refine ⟨β, ?_, ?_⟩
        · simpa only [heβ] using hp_ball.1
        · simpa only [heβ] using hp_ball.2
      center_in_sheared := fun β => hp_sh_mem (e β).1
      bidisk_in_unsheared := fun β => by
        let pt := (e β).1
        rw [ball_prod_same]
        exact Set.Subset.trans
          (Metric.ball_subset_ball (le_trans (min_le_right _ _) (min_le_left _ _)))
          (hrΩ_spec pt).2
      sheared_in_chart_ball := fun β => by
        dsimp only
        let pt := (e β).1
        intro q hq
        rw [ball_prod_same] at hq
        have h1s_pos : 0 < 1 + |S.s_minus (α_pt pt)| :=
          by linarith [abs_nonneg (S.s_minus (α_pt pt))]
        have h_le : ρ_pt pt ≤
            r_chart (α_pt pt) (p_sh_pt pt) / (1 + |S.s_minus (α_pt pt)|) :=
          le_trans (min_le_right _ _) (min_le_right _ _)
        have h_mul : (1 + |S.s_minus (α_pt pt)|) * ρ_pt pt ≤
            r_chart (α_pt pt) (p_sh_pt pt) := by
          have hm := mul_le_mul_of_nonneg_left h_le (le_of_lt h1s_pos)
          rwa [mul_div_cancel₀ _ (ne_of_gt h1s_pos)] at hm
        exact h_shear_ball (S.s_minus (α_pt pt)) (ρ_pt pt)
          (r_chart (α_pt pt) (p_sh_pt pt)) pt.1 q hq h_mul
    }⟩

  
  let detPkg : ∀ (α : Fin S.N_slab) (ι : Fin 2),
      SsbpcBaseDetPkg C W.s_base (S.x_c α) (S.s_minus α) t₁ S.r₁ ε (S.k_span α) is_point ι :=
    fun α ι => Classical.choice (h_s2 α ι)
  have hClear : ∀ α : Fin S.N_slab,
      SsbpcMeroJetClearedProp
        (bandShearedBaseBox W.s_base (S.x_c α) (S.s_minus α) t₁ S.r₁ ε)
        (S.E_left α) (S.E_right α)
        (fun i q => bandBaseEndpointFn C is_point q.1 q.2 i)
        (fun i q => bandBaseEndpointFn C is_point (q.1 + (S.k_span α : ℂ) * q.2) q.2 i)
        C.A := by
    intro α
    let x_c := S.x_c α
    let s_minus := S.s_minus α
    let Ω_sh := bandShearedSlab W.s_base H₁ ε x_c s_minus t₁ S.r₁
    let B_sh := bandShearedBaseBox W.s_base x_c s_minus t₁ S.r₁ ε
    have h_inv_cont : Continuous (fun q : ℂ × ℂ => (q.1 - (s_minus : ℂ) * q.2, q.2)) :=
      (continuous_fst.sub (continuous_const.mul continuous_snd)).prodMk continuous_snd
    have hΩ_sh_open : IsOpen Ω_sh := (h_unsheared_open x_c).preimage h_inv_cont
    have hΩ_sh_conv : Convex ℝ Ω_sh := by
      intro q₁ hq₁ q₂ hq₂ a b ha hb hab
      refine ⟨?_, ?_, ?_, ?_⟩
      · have h_re : ((a • q₁ + b • q₂).1 - (s_minus : ℂ) * (a • q₁ + b • q₂).2).re - x_c =
            a • ((q₁.1 - (s_minus : ℂ) * q₁.2).re - x_c) +
            b • ((q₂.1 - (s_minus : ℂ) * q₂.2).re - x_c) := by
          simp only [Prod.fst_add, Prod.snd_add, Prod.smul_fst, Prod.smul_snd,
            Complex.real_smul, Complex.add_re, Complex.sub_re, Complex.mul_re,
            Complex.ofReal_re, Complex.ofReal_im, zero_mul, sub_zero, smul_eq_mul]
          calc a * q₁.1.re + b * q₂.1.re - s_minus * (a * q₁.2.re + b * q₂.2.re) - x_c
              = a * q₁.1.re + b * q₂.1.re - s_minus * (a * q₁.2.re + b * q₂.2.re) -
                  (a + b) * x_c := by rw [hab, one_mul]
            _ = a * (q₁.1.re - s_minus * q₁.2.re - x_c) +
                  b * (q₂.1.re - s_minus * q₂.2.re - x_c) := by ring
        dsimp only
        rw [h_re, abs_lt]
        exact convex_Ioo (-(ε / 16)) (ε / 16) (abs_lt.mp hq₁.1) (abs_lt.mp hq₂.1) ha hb hab
      · have h_im : ((a • q₁ + b • q₂).1 - (s_minus : ℂ) * (a • q₁ + b • q₂).2).im =
            a • (q₁.1 - (s_minus : ℂ) * q₁.2).im + b • (q₂.1 - (s_minus : ℂ) * q₂.2).im := by
          simp only [Prod.fst_add, Prod.snd_add, Prod.smul_fst, Prod.smul_snd,
            Complex.real_smul, Complex.add_im, Complex.sub_im, Complex.mul_im,
            Complex.ofReal_re, Complex.ofReal_im, smul_eq_mul]
          ring
        dsimp only
        rw [h_im]
        exact (convex_Ioo (-W.s_base / 2) (H₁ + 3 * ε / 16)
          ⟨hq₁.2.1, hq₁.2.2.1⟩ ⟨hq₂.2.1, hq₂.2.2.1⟩ ha hb hab).1
      · have h_im : ((a • q₁ + b • q₂).1 - (s_minus : ℂ) * (a • q₁ + b • q₂).2).im =
            a • (q₁.1 - (s_minus : ℂ) * q₁.2).im + b • (q₂.1 - (s_minus : ℂ) * q₂.2).im := by
          simp only [Prod.fst_add, Prod.snd_add, Prod.smul_fst, Prod.smul_snd,
            Complex.real_smul, Complex.add_im, Complex.sub_im, Complex.mul_im,
            Complex.ofReal_re, Complex.ofReal_im, smul_eq_mul]
          ring
        dsimp only
        rw [h_im]
        exact (convex_Ioo (-W.s_base / 2) (H₁ + 3 * ε / 16)
          ⟨hq₁.2.1, hq₁.2.2.1⟩ ⟨hq₂.2.1, hq₂.2.2.1⟩ ha hb hab).2
      · have h_b : a • q₁.2 + b • q₂.2 ∈ Metric.ball (t₁ : ℂ) S.r₁ :=
          convex_ball (t₁ : ℂ) S.r₁
            (by simpa [Metric.mem_ball, dist_eq_norm] using hq₁.2.2.2)
            (by simpa [Metric.mem_ball, dist_eq_norm] using hq₂.2.2.2) ha hb hab
        simpa [Metric.mem_ball, dist_eq_norm] using h_b
    have hB_sh_open : IsOpen B_sh := by
      have h_y : Continuous (fun q : ℂ × ℂ => q.1 - (s_minus : ℂ) * q.2) :=
        continuous_fst.sub (continuous_const.mul continuous_snd)
      have h1 : IsOpen { q : ℂ × ℂ | |(q.1 - (s_minus : ℂ) * q.2).re - x_c| < ε / 16 } :=
        isOpen_lt (continuous_abs.comp ((Complex.continuous_re.comp h_y).sub continuous_const))
          continuous_const
      have h2 : IsOpen { q : ℂ × ℂ | |(q.1 - (s_minus : ℂ) * q.2).im| < W.s_base / 2 } :=
        isOpen_lt (continuous_abs.comp (Complex.continuous_im.comp h_y)) continuous_const
      have h3 : IsOpen { q : ℂ × ℂ | ‖q.2 - (t₁ : ℂ)‖ < S.r₁ } :=
        isOpen_lt (continuous_norm.comp (continuous_snd.sub continuous_const)) continuous_const
      exact h1.inter (h2.inter h3)
    have hB_sh_ne : B_sh.Nonempty := by
      refine ⟨((x_c : ℂ) + (s_minus : ℂ) * (t₁ : ℂ), (t₁ : ℂ)), ?_⟩
      dsimp [B_sh, bandShearedBaseBox]
      simp only [add_sub_cancel_right, sub_self, abs_zero, norm_zero]
      exact ⟨by linarith, by linarith [W.s_base_pos], S.r₁_pos⟩
    have hB_sh_sub : B_sh ⊆ Ω_sh := by
      intro q ⟨hq_re, hq_im, hq_t⟩
      obtain ⟨h_lo, h_hi⟩ := abs_lt.mp hq_im
      exact ⟨hq_re, by dsimp only; linarith, by dsimp only; linarith [W.s_base_pos], hq_t⟩
    have hA_maps : ∀ q ∈ Ω_sh, q.2 ∈ Metric.ball (0 : ℂ) C.r₁ := by
      intro q hq
      have hb := S.ball_sub_base (by simpa [Metric.mem_ball, dist_eq_norm] using hq.2.2.2)
      rw [Metric.mem_ball, dist_zero_right] at hb ⊢
      linarith [W.r_base_lt_r₁, C.r₁_pos]
    exact h_s3 (S.E_left α) (S.E_right α)
      (fun i q => bandBaseEndpointFn C is_point q.1 q.2 i)
      (fun i q => bandBaseEndpointFn C is_point (q.1 + (S.k_span α : ℂ) * q.2) q.2 i)
      hΩ_sh_open hΩ_sh_conv hB_sh_open hB_sh_ne hB_sh_sub
      Metric.isOpen_ball C.A_holo hA_maps
      (fun i => ⟨(detPkg α 0).base_left_holo i, (detPkg α 0).base_right_holo i⟩)
      (fun i => ⟨S.left_agrees_base α i, S.right_agrees_base α i⟩)
  let r_chart : Fin S.N_slab → ℂ × ℂ → ℝ :=
    fun α => ssbpcPairChartRad (S.E_left α) (S.E_right α)
  obtain ⟨cov⟩ := h_s5 r_chart (fun α q_sh hq_sh => ((hClear α).rad_pos q_sh hq_sh).1)
  let R_com : ∀ (α : Fin S.N_slab) (ι : Fin 2), ℕ := fun α ι =>
    Finset.univ.sup (fun d : Fin ((detPkg α ι).D + 1) => ssbpcPolyDeg ((detPkg α ι).Q d))
  let R_disc : ∀ (α : Fin S.N_slab) (ι : Fin 2), ℕ := fun α ι =>
    ssbpcPolyDeg (detPkg α ι).Disc
  let L_α : Fin S.N_slab → ℂ × ℂ → ℂ × ℂ :=
    fun α q => (q.1 + (S.s_minus α : ℂ) * q.2, q.2)
  let p_sh_of : Fin cov.N_cov → ℂ × ℂ :=
    fun β => L_α (cov.α_of β) (cov.y_c β, cov.τ_c β)
  let C_coeff : ∀ (β : Fin cov.N_cov) (ι : Fin 2),
      Fin ((detPkg (cov.α_of β) ι).D + 1) → ℂ × ℂ → ℂ :=
    fun β ι d q =>
      let α := cov.α_of β
      ssbpcClearedPoly (detPkg α ι).M (R_com α ι) ((detPkg α ι).Q d)
        (S.E_left α) (S.E_right α) C.A (p_sh_of β) (L_α α q)
  let Disc_tilde : ∀ (β : Fin cov.N_cov) (ι : Fin 2), ℂ × ℂ → ℂ :=
    fun β ι q =>
      let α := cov.α_of β
      ssbpcClearedPoly (detPkg α ι).M (R_disc α ι) (detPkg α ι).Disc
        (S.E_left α) (S.E_right α) C.A (p_sh_of β) (L_α α q)
  let d_prod_pb : Fin cov.N_cov → ℂ × ℂ → ℂ :=
    fun β q =>
      let α := cov.α_of β
      ssbpcPairDenProd (S.E_left α) (S.E_right α) (p_sh_of β) (L_α α q)
  let H_exc : Fin cov.N_cov → ℂ × ℂ → ℂ :=
    fun β q =>
      d_prod_pb β q *
        C_coeff β 0 (Fin.last (detPkg (cov.α_of β) 0).D) q *
        Disc_tilde β 0 q *
        C_coeff β 1 (Fin.last (detPkg (cov.α_of β) 1).D) q *
        Disc_tilde β 1 q
  have hL_α_diff : ∀ α : Fin S.N_slab, Differentiable ℂ (L_α α) := fun α =>
    (differentiable_fst.add ((differentiable_const (S.s_minus α : ℂ)).mul differentiable_snd)).prodMk
      differentiable_snd
  have h_coeff_holo : ∀ (β : Fin cov.N_cov) (ι : Fin 2)
      (d : Fin ((detPkg (cov.α_of β) ι).D + 1)),
      DifferentiableOn ℂ (C_coeff β ι d)
        (Metric.ball (cov.y_c β) (cov.ρ β) ×ˢ Metric.ball (cov.τ_c β) (cov.ρ β)) := by
    intro β ι d
    let α := cov.α_of β
    exact ((hClear α).cleared_holo (detPkg α ι).M (R_com α ι) ((detPkg α ι).Q d)
      (p_sh_of β) (cov.center_in_sheared β)).comp (hL_α_diff α).differentiableOn
      (cov.sheared_in_chart_ball β)
  have h_disc_holo : ∀ (β : Fin cov.N_cov) (ι : Fin 2),
      DifferentiableOn ℂ (Disc_tilde β ι)
        (Metric.ball (cov.y_c β) (cov.ρ β) ×ˢ Metric.ball (cov.τ_c β) (cov.ρ β)) := by
    intro β ι
    let α := cov.α_of β
    exact ((hClear α).cleared_holo (detPkg α ι).M (R_disc α ι) (detPkg α ι).Disc
      (p_sh_of β) (cov.center_in_sheared β)).comp (hL_α_diff α).differentiableOn
      (cov.sheared_in_chart_ball β)
  have hd_prod_holo : ∀ β : Fin cov.N_cov,
      DifferentiableOn ℂ (d_prod_pb β)
        (Metric.ball (cov.y_c β) (cov.ρ β) ×ˢ Metric.ball (cov.τ_c β) (cov.ρ β)) := by
    intro β
    let α := cov.α_of β
    exact ((hClear α).denProd_holo (p_sh_of β) (cov.center_in_sheared β)).comp
      (hL_α_diff α).differentiableOn (cov.sheared_in_chart_ball β)
  refine ⟨{
    r₁ := S.r₁
    r₁_pos := S.r₁_pos
    ball_sub_base := S.ball_sub_base
    h_L_lower := S.h_L_lower
    N_cov := cov.N_cov
    y_c := cov.y_c
    τ_c := cov.τ_c
    ρ_y := cov.ρ
    ρ_t := cov.ρ
    ρ_pos := fun β => ⟨(cov.ρ_pos β).1, (cov.ρ_pos β).1, (cov.ρ_pos β).2⟩
    covers_band := cov.covers_band
    deg := fun β ι => (detPkg (cov.α_of β) ι).D
    deg_pos := fun β ι => (detPkg (cov.α_of β) ι).D_pos
    C_coeff := C_coeff
    H_exc := H_exc
    coeff_holo := h_coeff_holo
    exc_holo := fun β =>
      ((((hd_prod_holo β).mul (h_coeff_holo β 0 _)).mul (h_disc_holo β 0)).mul
        (h_coeff_holo β 1 _)).mul (h_disc_holo β 1)
    exc_ne_zero := fun β => by
      let α := cov.α_of β
      let U_β := Metric.ball (cov.y_c β) (cov.ρ β) ×ˢ Metric.ball (cov.τ_c β) (cov.ρ β)
      have hU_open : IsOpen U_β := Metric.isOpen_ball.prod Metric.isOpen_ball
      have hU_ne : U_β.Nonempty :=
        ⟨(cov.y_c β, cov.τ_c β),
          Metric.mem_ball_self (cov.ρ_pos β).1, Metric.mem_ball_self (cov.ρ_pos β).1⟩
      have h_pull_nz : ∀ {F_sh : ℂ × ℂ → ℂ},
          (∀ W' : Set (ℂ × ℂ), IsOpen W' → W'.Nonempty →
            W' ⊆ Metric.ball (p_sh_of β) (r_chart α (p_sh_of β)) → ∃ w ∈ W', F_sh w ≠ 0) →
          ∀ V : Set (ℂ × ℂ), IsOpen V → V.Nonempty → V ⊆ U_β →
          ∃ q ∈ V, F_sh (L_α α q) ≠ 0 := by
        intro F_sh hF V hV ⟨q₀, hq₀⟩ hVU
        let L_inv : ℂ × ℂ → ℂ × ℂ := fun w => (w.1 - (S.s_minus α : ℂ) * w.2, w.2)
        have h_inv_cont : Continuous L_inv :=
          (continuous_fst.sub (continuous_const.mul continuous_snd)).prodMk continuous_snd
        let W_V := (L_inv ⁻¹' V) ∩ Metric.ball (p_sh_of β) (r_chart α (p_sh_of β))
        have hq₀_W : L_α α q₀ ∈ W_V := by
          refine ⟨?_, cov.sheared_in_chart_ball β q₀ (hVU hq₀)⟩
          have h_inv_eq : L_inv (L_α α q₀) = q₀ := by
            dsimp [L_inv, L_α]
            ext <;> simp
          show L_inv (L_α α q₀) ∈ V
          rwa [h_inv_eq]
        obtain ⟨w, hw_mem, hw_nz⟩ := hF W_V ((hV.preimage h_inv_cont).inter Metric.isOpen_ball)
          ⟨L_α α q₀, hq₀_W⟩ Set.inter_subset_right
        refine ⟨L_inv w, hw_mem.1, ?_⟩
        have h_eq : L_α α (L_inv w) = w := by
          dsimp [L_α, L_inv]
          ext <;> simp
        rwa [h_eq]
      have hp_sh_mem := cov.center_in_sheared β
      have h1_nz := h_pull_nz ((hClear α).denProd_ne_zero (p_sh_of β) hp_sh_mem)
      have h2_nz := h_pull_nz ((hClear α).cleared_ne_zero_of_base (detPkg α 0).M (R_com α 0)
        ((detPkg α 0).Q (Fin.last (detPkg α 0).D))
        (Finset.le_sup (f := fun d => ssbpcPolyDeg ((detPkg α 0).Q d)) (Finset.mem_univ _))
        (detPkg α 0).lead_ne_zero_on_base (p_sh_of β) hp_sh_mem)
      have h3_nz := h_pull_nz ((hClear α).cleared_ne_zero_of_base (detPkg α 0).M (R_disc α 0)
        (detPkg α 0).Disc le_rfl (detPkg α 0).disc_ne_zero_on_base (p_sh_of β) hp_sh_mem)
      have h4_nz := h_pull_nz ((hClear α).cleared_ne_zero_of_base (detPkg α 1).M (R_com α 1)
        ((detPkg α 1).Q (Fin.last (detPkg α 1).D))
        (Finset.le_sup (f := fun d => ssbpcPolyDeg ((detPkg α 1).Q d)) (Finset.mem_univ _))
        (detPkg α 1).lead_ne_zero_on_base (p_sh_of β) hp_sh_mem)
      have h5_nz := h_pull_nz ((hClear α).cleared_ne_zero_of_base (detPkg α 1).M (R_disc α 1)
        (detPkg α 1).Disc le_rfl (detPkg α 1).disc_ne_zero_on_base (p_sh_of β) hp_sh_mem)
      have h12 := h_mul_nz hU_open (hd_prod_holo β).continuousOn h1_nz h2_nz
      have h123 := h_mul_nz hU_open ((hd_prod_holo β).mul (h_coeff_holo β 0 _)).continuousOn
        h12 h3_nz
      have h1234 := h_mul_nz hU_open
        (((hd_prod_holo β).mul (h_coeff_holo β 0 _)).mul (h_disc_holo β 0)).continuousOn
        h123 h4_nz
      exact h_mul_nz hU_open
        ((((hd_prod_holo β).mul (h_coeff_holo β 0 _)).mul (h_disc_holo β 0)).mul
          (h_coeff_holo β 1 _)).continuousOn h1234 h5_nz U_β hU_open hU_ne Set.Subset.rfl
    lead_dvd_exc := fun β ι => by
      fin_cases ι
      · refine ⟨fun q => d_prod_pb β q * Disc_tilde β 0 q *
            C_coeff β 1 (Fin.last (detPkg (cov.α_of β) 1).D) q * Disc_tilde β 1 q,
          (((hd_prod_holo β).mul (h_disc_holo β 0)).mul (h_coeff_holo β 1 _)).mul
            (h_disc_holo β 1),
          fun q _ => by dsimp [H_exc]; ring⟩
      · refine ⟨fun q => d_prod_pb β q *
            C_coeff β 0 (Fin.last (detPkg (cov.α_of β) 0).D) q *
            Disc_tilde β 0 q * Disc_tilde β 1 q,
          (((hd_prod_holo β).mul (h_coeff_holo β 0 _)).mul (h_disc_holo β 0)).mul
            (h_disc_holo β 1),
          fun q _ => by dsimp [H_exc]; ring⟩
    separable_at := fun β ι q hq_U hH_nz => by
      let α := cov.α_of β
      have hd_nz : d_prod_pb β q ≠ 0 := fun h0 => hH_nz (by simp [H_exc, h0])
      have hC0_nz : C_coeff β 0 (Fin.last (detPkg α 0).D) q ≠ 0 :=
        fun h0 => hH_nz (by simp [H_exc, α, h0])
      have hD0_nz : Disc_tilde β 0 q ≠ 0 := fun h0 => hH_nz (by simp [H_exc, h0])
      have hC1_nz : C_coeff β 1 (Fin.last (detPkg α 1).D) q ≠ 0 :=
        fun h0 => hH_nz (by simp [H_exc, α, h0])
      have hD1_nz : Disc_tilde β 1 q ≠ 0 := fun h0 => hH_nz (by simp [H_exc, h0])
      have hC_lead_nz : C_coeff β ι (Fin.last (detPkg α ι).D) q ≠ 0 := by
        fin_cases ι
        · exact hC0_nz
        · exact hC1_nz
      have hDisc_t_nz : Disc_tilde β ι q ≠ 0 := by
        fin_cases ι
        · exact hD0_nz
        · exact hD1_nz
      refine ⟨hC_lead_nz, fun z h_root => ?_⟩
      let M_i := (detPkg α ι).M
      let D_com := (d_prod_pb β q) ^ (2 * M_i + 1)
      have hD_com_R_nz : D_com ^ (R_com α ι) ≠ 0 :=
        pow_ne_zero (R_com α ι) (pow_ne_zero (2 * M_i + 1) hd_nz)
      let env_q : PointJetVar M_i → ℂ :=
        fun v => ssbpcClearedJetEnv M_i (S.E_left α) (S.E_right α) C.A
          (p_sh_of β) (L_α α q) v / D_com
      have hLq_ball := cov.sheared_in_chart_ball β q hq_U
      have hC_eval : ∀ d : Fin ((detPkg α ι).D + 1),
          C_coeff β ι d q = D_com ^ (R_com α ι) * MvPolynomial.eval env_q ((detPkg α ι).Q d) :=
        fun d => (hClear α).eval_at_reg M_i (R_com α ι) ((detPkg α ι).Q d)
          (Finset.le_sup (f := fun d' => ssbpcPolyDeg ((detPkg α ι).Q d')) (Finset.mem_univ d))
          (p_sh_of β) (cov.center_in_sheared β) (L_α α q) hLq_ball hd_nz
      have hDisc_eval :
          Disc_tilde β ι q = D_com ^ (R_disc α ι) * MvPolynomial.eval env_q (detPkg α ι).Disc :=
        (hClear α).eval_at_reg M_i (R_disc α ι) (detPkg α ι).Disc le_rfl
          (p_sh_of β) (cov.center_in_sheared β) (L_α α q) hLq_ball hd_nz
      have hQ_lead_nz : MvPolynomial.eval env_q ((detPkg α ι).Q (Fin.last (detPkg α ι).D)) ≠ 0 := by
        intro h0
        apply hC_lead_nz
        rw [hC_eval, h0, mul_zero]
      have hDisc_nz : MvPolynomial.eval env_q (detPkg α ι).Disc ≠ 0 := by
        intro h0
        apply hDisc_t_nz
        rw [hDisc_eval, h0, mul_zero]
      have h_root_env : ∑ d : Fin ((detPkg α ι).D + 1),
          MvPolynomial.eval env_q ((detPkg α ι).Q d) * z ^ (d : ℕ) = 0 := by
        have h_fac : D_com ^ (R_com α ι) *
            (∑ d : Fin ((detPkg α ι).D + 1),
              MvPolynomial.eval env_q ((detPkg α ι).Q d) * z ^ (d : ℕ)) = 0 := by
          rw [Finset.mul_sum]
          convert h_root using 2 with d
          rw [hC_eval d, mul_assoc]
        exact (mul_eq_zero.mp h_fac).resolve_left hD_com_R_nz
      have h_deriv_nz := (detPkg α ι).univ_separable env_q z hQ_lead_nz hDisc_nz h_root_env
      have h_deriv_fac :
          (∑ d : Fin (detPkg α ι).D,
            (((d : ℕ) + 1 : ℕ) : ℂ) * C_coeff β ι d.succ q * z ^ (d : ℕ)) =
          D_com ^ (R_com α ι) *
            (∑ d : Fin (detPkg α ι).D,
              (((d : ℕ) + 1 : ℕ) : ℂ) *
                MvPolynomial.eval env_q ((detPkg α ι).Q d.succ) * z ^ (d : ℕ)) := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl (fun d _ => ?_)
        rw [hC_eval d.succ]
        ring
      rw [h_deriv_fac]
      exact mul_ne_zero hD_com_R_nz h_deriv_nz
    primary_solves := fun β ι p hp => by
      let α := cov.α_of β
      let M_i := (detPkg α ι).M
      let D_i := (detPkg α ι).D
      let R_i := R_com α ι
      let N_sh : Fin (D_i + 1) → ℂ × ℂ → ℂ × ℂ → ℂ := fun d p_sh w =>
        ssbpcClearedPoly M_i R_i ((detPkg α ι).Q d) (S.E_left α) (S.E_right α) C.A p_sh w
      let D_sh : ℂ × ℂ → ℂ × ℂ → ℂ := fun p_sh w =>
        ((ssbpcPairDenProd (S.E_left α) (S.E_right α) p_sh w) ^ (2 * M_i + 1)) ^ R_i
      have hBaseZero : ∃ r₀ : ℝ, 0 < r₀ ∧
          Metric.ball ((S.x_c α : ℂ), (t₁ : ℂ)) r₀ ⊆
            bandUnshearedSlab W.s_base H₁ ε (S.x_c α) t₁ S.r₁ ∧
          ∀ q ∈ Metric.ball ((S.x_c α : ℂ), (t₁ : ℂ)) r₀,
            ∑ d : Fin (D_i + 1),
              N_sh d (((S.x_c α : ℂ) + (S.s_minus α : ℂ) * (t₁ : ℂ)), (t₁ : ℂ))
                (q.1 + (S.s_minus α : ℂ) * q.2, q.2) *
                (glancingDualLine C q.1 q.2 ι) ^ (d : ℕ) = 0 := by
        let p_b : ℂ × ℂ := ((S.x_c α : ℂ), (t₁ : ℂ))
        let p_sh_base : ℂ × ℂ := L_α α p_b
        have hp_b_un : p_b ∈ bandUnshearedSlab W.s_base H₁ ε (S.x_c α) t₁ S.r₁ := by
          dsimp [bandUnshearedSlab, p_b]
          simp only [sub_self, abs_zero, norm_zero]
          exact ⟨by linarith, by linarith [W.s_base_pos],
            by linarith [W.s_base_pos, hH₁_ge], S.r₁_pos⟩
        obtain ⟨r_un, hr_un_pos, hr_un_sub⟩ :=
          Metric.isOpen_iff.mp (h_unsheared_open (S.x_c α)) p_b hp_b_un
        have hp_sh_base_mem : p_sh_base ∈
            bandShearedBaseBox W.s_base (S.x_c α) (S.s_minus α) t₁ S.r₁ ε := by
          dsimp [bandShearedBaseBox, p_sh_base, L_α, p_b]
          simp only [add_sub_cancel_right, sub_self, abs_zero, norm_zero]
          exact ⟨by linarith, by linarith [W.s_base_pos], S.r₁_pos⟩
        have h_ag_d : ∀ d : Fin (D_i + 1), ∃ r_ag : ℝ,
            0 < r_ag ∧ Metric.ball p_sh_base r_ag ⊆
              bandShearedBaseBox W.s_base (S.x_c α) (S.s_minus α) t₁ S.r₁ ε ∧
            ∀ w ∈ Metric.ball p_sh_base r_ag,
              N_sh d p_sh_base w =
                MvPolynomial.eval (ssbpcBaseJetEnv C M_i (S.k_span α) is_point w)
                  ((detPkg α ι).Q d) * D_sh p_sh_base w := by
          intro d
          obtain ⟨r_ag, hr_pos, _, hr_sub, hr_eq⟩ :=
            (hClear α).agrees_on_base M_i R_i ((detPkg α ι).Q d)
              (Finset.le_sup (f := fun d' => ssbpcPolyDeg ((detPkg α ι).Q d'))
                (Finset.mem_univ d))
              p_sh_base hp_sh_base_mem
          exact ⟨r_ag, hr_pos, hr_sub, hr_eq⟩
        let r_ag_fn : Fin (D_i + 1) → ℝ := fun d => Classical.choose (h_ag_d d)
        have hr_ag_spec : ∀ d : Fin (D_i + 1),
            0 < r_ag_fn d ∧ Metric.ball p_sh_base (r_ag_fn d) ⊆
              bandShearedBaseBox W.s_base (S.x_c α) (S.s_minus α) t₁ S.r₁ ε ∧
            ∀ w ∈ Metric.ball p_sh_base (r_ag_fn d),
              N_sh d p_sh_base w =
                MvPolynomial.eval (ssbpcBaseJetEnv C M_i (S.k_span α) is_point w)
                  ((detPkg α ι).Q d) * D_sh p_sh_base w :=
          fun d => Classical.choose_spec (h_ag_d d)
        let r_min : ℝ := Finset.univ.inf' Finset.univ_nonempty r_ag_fn
        have hr_min_pos : 0 < r_min :=
          (Finset.lt_inf'_iff Finset.univ_nonempty).mpr (fun d _ => (hr_ag_spec d).1)
        have h1s_pos : 0 < 1 + |S.s_minus α| := by linarith [abs_nonneg (S.s_minus α)]
        let r₀ := min r_un (r_min / (1 + |S.s_minus α|))
        refine ⟨r₀, lt_min hr_un_pos (div_pos hr_min_pos h1s_pos),
          Set.Subset.trans (Metric.ball_subset_ball (min_le_left _ _)) hr_un_sub, ?_⟩
        intro q hq
        have h_mul : (1 + |S.s_minus α|) * r₀ ≤ r_min := by
          have h_r₀_le : r₀ ≤ r_min / (1 + |S.s_minus α|) := min_le_right _ _
          have hm := mul_le_mul_of_nonneg_left h_r₀_le (le_of_lt h1s_pos)
          rwa [mul_div_cancel₀ _ (ne_of_gt h1s_pos)] at hm
        have hLq_min : L_α α q ∈ Metric.ball p_sh_base r_min :=
          h_shear_ball (S.s_minus α) r₀ r_min p_b q hq h_mul
        have hLq_d : ∀ d : Fin (D_i + 1), L_α α q ∈ Metric.ball p_sh_base (r_ag_fn d) :=
          fun d => Metric.ball_subset_ball (Finset.inf'_le r_ag_fn (Finset.mem_univ d)) hLq_min
        have hLq_base : L_α α q ∈
            bandShearedBaseBox W.s_base (S.x_c α) (S.s_minus α) t₁ S.r₁ ε :=
          (hr_ag_spec 0).2.1 (hLq_d 0)
        have h_fac : (∑ d : Fin (D_i + 1),
              N_sh d p_sh_base (L_α α q) * (glancingDualLine C q.1 q.2 ι) ^ (d : ℕ)) =
            D_sh p_sh_base (L_α α q) *
              ∑ d : Fin (D_i + 1),
                MvPolynomial.eval (ssbpcBaseJetEnv C M_i (S.k_span α) is_point (L_α α q))
                  ((detPkg α ι).Q d) * (glancingDualLine C q.1 q.2 ι) ^ (d : ℕ) := by
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl (fun d _ => ?_)
          rw [(hr_ag_spec d).2.2 (L_α α q) (hLq_d d)]
          ring
        change ∑ d : Fin (D_i + 1),
          N_sh d p_sh_base (L_α α q) * (glancingDualLine C q.1 q.2 ι) ^ (d : ℕ) = 0
        rw [h_fac, (detPkg α ι).base_solves q hLq_base, mul_zero]
      exact h_s4 (S.x_c α) (S.s_minus α) ι D_i (r_chart α) N_sh D_sh
        (hClear α).rad_pos
        (fun d q_sh hq_sh => (hClear α).cleared_holo M_i R_i ((detPkg α ι).Q d) q_sh hq_sh)
        (fun q_sh hq_sh => h_pow_holo
          (h_pow_holo ((hClear α).denProd_holo q_sh hq_sh) (2 * M_i + 1)) R_i)
        (fun q_sh hq_sh V hV hV_ne hV_sub => by
          obtain ⟨w, hwV, hw_nz⟩ := (hClear α).denProd_ne_zero q_sh hq_sh V hV hV_ne hV_sub
          exact ⟨w, hwV, pow_ne_zero R_i (pow_ne_zero (2 * M_i + 1) hw_nz)⟩)
        (fun d p_sh1 hp_sh1 p_sh2 hp_sh2 w hw =>
          (hClear α).chart_compat M_i R_i ((detPkg α ι).Q d)
            (Finset.le_sup (f := fun d' => ssbpcPolyDeg ((detPkg α ι).Q d')) (Finset.mem_univ d))
            p_sh1 hp_sh1 p_sh2 hp_sh2 w hw)
        hBaseZero
        (p_sh_of β) (cov.center_in_sheared β)
        (Metric.ball (cov.y_c β) (cov.ρ β) ×ˢ Metric.ball (cov.τ_c β) (cov.ρ β))
        (Metric.isOpen_ball.prod Metric.isOpen_ball)
        (cov.bidisk_in_unsheared β)
        (cov.sheared_in_chart_ball β)
        p hp
  }⟩

theorem irrational_shift_band_polynomials (Ω : Set Plane)
    (C : AnalyticGlancingCollar Ω)
    (hDet : EndpointDeterminationData C)
    (W : CollarWidthTubeData C hDet)
    (t₀ x₀ H₁ ε δ : ℝ)
    (ht₀ : |t₀| < W.r_base)
    (hhL : W.h_L (t₀ : ℂ) = ENNReal.ofReal H₁)
    (hε_pos : 0 < ε)
    (hε_lt : ε < W.s_base)
    (hδ_pos : 0 < δ)
    (hδ_le : δ ≤ ε)
    (hPatch : HasRealWallPatch W t₀ x₀ H₁ ε δ) :
    ∃ δ_star : ℝ, 0 < δ_star ∧ |t₀| + 2 * δ_star < W.r_base ∧
      ∀ t₁ ∈ Set.Ioo (t₀ - δ_star) (t₀ + δ_star),
        Irrational (t₁ / (2 * Real.pi)) →
        Nonempty (FullBandPolyData W H₁ (ε / 16) t₁) :=
by
  obtain ⟨B_cr⟩ := base_collar_and_cramer_data Ω C
  have ht₀_ball : (t₀ : ℂ) ∈ Metric.ball (0 : ℂ) W.r_base := by
    simpa [Metric.mem_ball, dist_zero_right, Complex.norm_real, Real.norm_eq_abs] using ht₀
  have hX_ge : ENNReal.ofReal (2 * W.s_base) ≤ W.h_X (t₀ : ℂ) :=
    W.h_X_ge_two (t₀ : ℂ) ht₀_ball
  have hL_eq_X : W.h_L (t₀ : ℂ) = W.h_X (t₀ : ℂ) := by
    simpa using W.h_L_eq (t₀ : ℂ) ht₀_ball
  have hhX : W.h_X (t₀ : ℂ) = ENNReal.ofReal H₁ := by
    rw [← hL_eq_X, hhL]
  have h2s_pos : 0 < 2 * W.s_base := by
    linarith [W.s_base_pos]
  have hH₁_pos : 0 < H₁ := by
    by_contra h_not_pos
    have h_le : H₁ ≤ 0 := le_of_not_gt h_not_pos
    have h0 : ENNReal.ofReal H₁ = 0 := ENNReal.ofReal_eq_zero.mpr h_le
    have hpos : (0 : ENNReal) < ENNReal.ofReal (2 * W.s_base) :=
      ENNReal.ofReal_pos.mpr h2s_pos
    rw [hhX, h0] at hX_ge
    exact not_lt_of_ge hX_ge hpos
  have h2s_le_H₁ : 2 * W.s_base ≤ H₁ := by
    rw [hhX] at hX_ge
    exact (ENNReal.ofReal_le_ofReal_iff (le_of_lt hH₁_pos)).mp hX_ge
  have hthr_lt : ENNReal.ofReal (H₁ - ε / 32) < ENNReal.ofReal H₁ :=
    (ENNReal.ofReal_lt_ofReal_iff hH₁_pos).mpr (by linarith)
  have hev_X : ∀ᶠ t in nhdsWithin (t₀ : ℂ) (Metric.ball (0 : ℂ) W.r_base),
      ENNReal.ofReal (H₁ - ε / 32) < W.h_X t :=
    W.h_X_lsc (t₀ : ℂ) ht₀_ball (ENNReal.ofReal (H₁ - ε / 32))
      (show ENNReal.ofReal (H₁ - ε / 32) < W.h_X (t₀ : ℂ) by rwa [hhX])
  rw [Metric.isOpen_ball.nhdsWithin_eq ht₀_ball] at hev_X
  obtain ⟨r_X, hr_X_pos, hr_X_bound⟩ := Metric.eventually_nhds_iff_ball.mp hev_X
  have hev_L : ∀ᶠ t in nhdsWithin (t₀ : ℂ) (Metric.ball (0 : ℂ) W.r_base),
      ENNReal.ofReal (H₁ - ε / 32) < W.h_L t :=
    W.h_L_lsc (t₀ : ℂ) ht₀_ball (ENNReal.ofReal (H₁ - ε / 32))
      (show ENNReal.ofReal (H₁ - ε / 32) < W.h_L (t₀ : ℂ) by rwa [hhL])
  rw [Metric.isOpen_ball.nhdsWithin_eq ht₀_ball] at hev_L
  obtain ⟨r_L, hr_L_pos, hr_L_bound⟩ := Metric.eventually_nhds_iff_ball.mp hev_L
  let δ_star : ℝ := min (δ / 2) (min ((W.r_base - |t₀|) / 4) (min r_X r_L / 4))
  have hδ_star_pos : 0 < δ_star := by
    refine lt_min (by linarith) (lt_min (by linarith) ?_)
    exact div_pos (lt_min hr_X_pos hr_L_pos) (by norm_num)
  have hδ_star_le_δ : 2 * δ_star ≤ δ := by
    have h1 : δ_star ≤ δ / 2 := min_le_left _ _
    linarith
  have hδ_star_lt_base : |t₀| + 2 * δ_star < W.r_base := by
    have h1 : δ_star ≤ (W.r_base - |t₀|) / 4 :=
      le_trans (min_le_right _ _) (min_le_left _ _)
    linarith
  have h2δ_lt_rX : 2 * δ_star < r_X := by
    have h1 : δ_star ≤ min r_X r_L / 4 :=
      le_trans (min_le_right _ _) (min_le_right _ _)
    have h2 : min r_X r_L ≤ r_X := min_le_left _ _
    linarith
  have h2δ_lt_rL : 2 * δ_star < r_L := by
    have h1 : δ_star ≤ min r_X r_L / 4 :=
      le_trans (min_le_right _ _) (min_le_right _ _)
    have h2 : min r_X r_L ≤ r_L := min_le_right _ _
    linarith
  have hLSC : ∀ t ∈ Metric.ball (t₀ : ℂ) (2 * δ_star),
      ENNReal.ofReal (H₁ - ε / 32) < W.h_X t ∧
      ENNReal.ofReal (H₁ - ε / 32) < W.h_L t := by
    intro t ht
    exact ⟨hr_X_bound t (Metric.ball_subset_ball (le_of_lt h2δ_lt_rX) ht),
      hr_L_bound t (Metric.ball_subset_ball (le_of_lt h2δ_lt_rL) ht)⟩
  refine ⟨δ_star, hδ_star_pos, hδ_star_lt_base, ?_⟩
  intro t₁ ht₁ ht₁_irr
  have hρ_pos : 0 < ε / 16 := by linarith
  obtain ⟨cov_L⟩ := irrational_enclosing_slab_cover x₀ 0 t₁ (ε / 16) ht₁_irr hρ_pos
  obtain ⟨cov_X⟩ := irrational_enclosing_slab_cover x₀ (-t₁ / 2) t₁ (ε / 16) ht₁_irr hρ_pos
  obtain ⟨is_point, ⟨S⟩⟩ :=
    glued_sheared_slab_endpoints Ω C hDet B_cr W t₀ x₀ H₁ ε δ δ_star t₁
      hδ_star_lt_base hε_pos hε_lt h2s_le_H₁ hδ_le hδ_star_pos hδ_star_le_δ
      ht₁ hLSC hPatch cov_L cov_X
  exact sheared_slab_band_poly_clearing Ω C hDet B_cr W H₁ ε t₁
    hε_pos hε_lt h2s_le_H₁ is_point S

theorem weierstrass_isolated_graph_slicing (y_c τ_c : ℂ) (ρ_y ρ_t : ℝ)
    (hρ_y : 0 < ρ_y) (hρ_t : 0 < ρ_t) (H : ℂ × ℂ → ℂ)
    (hHolo : DifferentiableOn ℂ H (Metric.ball y_c ρ_y ×ˢ Metric.ball τ_c ρ_t))
    (hNZ : ∃ p ∈ Metric.ball y_c ρ_y ×ˢ Metric.ball τ_c ρ_t, H p ≠ 0) :
    ∃ E_weier : Set ℝ, E_weier.Countable ∧
      ∀ t₂ : ℝ, t₂ ∉ E_weier → (t₂ : ℂ) ∈ Metric.ball τ_c (3 * ρ_t / 4) →
        IsIsolatedGraphSlicedAt y_c τ_c ρ_y ρ_t H t₂ :=
by
  
  have hpderiv_holo :
      ∀ {U : Set (ℂ × ℂ)}, IsOpen U → ∀ {f : ℂ × ℂ → ℂ},
        DifferentiableOn ℂ f U →
        DifferentiableOn ℂ (pderivA f) U ∧ DifferentiableOn ℂ (pderivD f) U := by
    let π₁ : (ℂ × ℂ) →L[ℂ] ℂ :=
      { toLinearMap :=
          { toFun := Prod.fst
            map_add' := fun _ _ => rfl
            map_smul' := fun _ _ => rfl }
        cont := continuous_fst }
