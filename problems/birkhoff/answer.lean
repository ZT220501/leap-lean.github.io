        · intro j
          simpa [P, q_start] using hy_s_av j
      · have hm : k.val - 1 < m := by omega
        let kp : Fin m := ⟨k.val - 1, hm⟩
        have hkp_succ : kp.succ = k := by ext; simp [kp]; omega
        have hP_eq : P k.castSucc = q_junc kp := by
          dsimp only [P]
          split_ifs with h1 h2
          · exact False.elim (hk0 (by simpa [Fin.val_castSucc] using h1))
          · rfl
          · exact False.elim (h2 (by simpa [Fin.val_castSucc] using hm))
        rw [hP_eq, ← hkp_succ]
        exact ⟨hq_j_R kp, hq_j_im kp⟩
    have hB_props : ∀ k : Fin (m + 1),
        P k.succ ∈ meshClosedSquare (c k) (9 * ρ k) ∧
        ∀ j : Fin (N_b k),
          (P k.succ).re ∉ Set.Ioo ((w_b k j).re - r_b k j) ((w_b k j).re + r_b k j) := by
      intro k
      by_cases hkm : k.val < m
      · let kc : Fin m := ⟨k.val, hkm⟩
