  have hHoloZero : ∀ z₀ : ℂ, pointArcHoloTaylor1D (fun _ : ℂ => (0 : ℂ)) z₀ = 0 := by
    intro z₀
    ext n
    simp only [pointArcHoloTaylor1D, holoTaylor1D, PowerSeries.coeff_mk, map_zero]
    rcases n with _ | n
    · simp
    · rw [iteratedDeriv_const]
      simp
  let p₀ : ℕ := D_form.p - 1
  have hp₀ : p₀ + 1 = D_form.p := Nat.sub_add_cancel D_form.p_pos
  let S_base : PointArcStepAnalyticData C B k G a₁ δ₁ D_form p₀ :=
    { W_ψ := G.W_F
      V_plus := V₀
      g := fun _ _ _ => 0
      U_split := fun _ _ => 0
      V_split := fun _ _ => 0
      β := fun _ _ _ => 0
      W_ψ_open := G.W_F_open
      W_ψ_preconn := G.W_F_preconn
      W_ψ_sub_W_F := Subset.rfl
      real_mem_W_ψ := fun x hx =>
        (G.F_real x (by linarith [G.δ_star_pos])).1
      V_plus_open := hU_nondeg_open.connectedComponentIn
      V_plus_preconn := isPreconnected_connectedComponentIn
      V_plus_sub := hV₀_sub_U₀
      trapezoid_mem_V_plus := fun q hq => hTrap_sub_V₀ ⟨q, hq, rfl⟩
      ψ_maps_W_ψ := fun q hq r => hψ_maps_WF q (hV₀_sub_U₀ hq) r
      chord_ne_zero := fun q hq i => hU_ell_ne q (hV₀_sub_U_nondeg hq).1 i
      hess_det_ne_zero := fun q hq => (hV₀_sub_U_nondeg hq).2
      g_holo := fun _ _ => differentiableOn_const 0
      g_endpoints := fun _ _ => ⟨rfl, rfl⟩
      g_lt_p := fun _ _ _ _ => rfl
      g_taylor := by
