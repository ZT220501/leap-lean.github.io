      | succ j ih =>
        intro hj_succ
        obtain ⟨ih_a, ih_b, ih_J, ih_contr, ih_diff⟩ := ih (by omega)
        have hj_le : j ≤ N + 1 := by omega
        have hj1_le : j + 1 ≤ N + 1 := by omega
        have hj2_le : j + 2 ≤ N + 1 := by omega
        have hw_plus : w (j + 1) + t = w (j + 2) := (hw_succ (j + 1)).symm
        have hw_minus : w (j + 1) - t = w j := by
          rw [hw_succ j]
