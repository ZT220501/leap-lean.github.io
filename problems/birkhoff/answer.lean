    have hClip_pos : 0 < F_bd.C_force_lip := F_bd.C_force_lip_pos
    have hMf_nonneg : 0 ≤ M_f := by positivity
    have hf_diff_bnd : ∀ j : ℕ, j + 1 < q → IsStripCJetBounded (m + 2) σ_mesh M_f (f_diff (j + 1)) := by
      intro j hj
      have hEq : f_diff (j + 1) = fun ζ =>
          stripForcingAt_ℂ J_C q W₁ d₁ j ζ - stripForcingAt_ℂ J_C q W₂ d₂ j ζ := by
        ext ζ
        simp [f_diff, stripMeshForcing_ℂ, hj]
      rw [hEq]
      have hf₁ := F_bd.forcing_props σ σ_mesh R_strip q w₁ W₁ d₁
        hσ hR_pos hq_force hq_R hσ_mesh_pos hσ_mesh_le hw₁ hW₁ hd₁ j hj
      have hf₂ := F_bd.forcing_props σ σ_mesh R_strip q w₂ W₂ d₂
        hσ hR_pos hq_force hq_R hσ_mesh_pos hσ_mesh_le hw₂ hW₂ hd₂ j hj
