        TendstoUniformlyOn
          (fun n p => slDivided (Q_seq n p) (a₀_seq n p) (a₁_seq n p))
          (fun p => (1 - 2 * Complex.sin (Λ_fn p / 2) / Λ_fn p) / (Λ_fn p) ^ 2)
          Filter.atTop U_δ := by
    intro hkind hΛ0_ne hsin0_ne
    have hq_zero : ∀ p, q_lim p = 0 := by intro p; simp [q_lim, hkind]
    have ha0_eq_Λ : ∀ p, a₀_lim p = Λ_fn p := by intro p; simp [a₀_lim, hkind]
    let k_lim : ℂ × ℂ → ℂ := fun p => 2 * Complex.sin (Λ_fn p / 2) / Λ_fn p
    have hk0_lim_ne : k_lim p₀ ≠ 0 :=
      div_ne_zero (mul_ne_zero two_ne_zero hsin0_ne) hΛ0_ne
    let c_Λ : ℝ := ‖Λ_fn p₀‖
    let c_k : ℝ := ‖k_lim p₀‖
    have hc_Λ_pos : 0 < c_Λ := norm_pos_iff.mpr hΛ0_ne
    have hc_k_pos : 0 < c_k := norm_pos_iff.mpr hk0_lim_ne
    have hΛ_cont : Continuous Λ_fn := by dsimp [Λ_fn]; fun_prop
    have hk_cont : ContinuousAt k_lim p₀ := by
      dsimp [k_lim]
      exact ((continuous_const.mul
        (Complex.continuous_sin.comp (hΛ_cont.div_const 2))).continuousAt).div
        hΛ_cont.continuousAt hΛ0_ne
    obtain ⟨δ₁, hδ₁_pos, hδ₁⟩ :=
      Metric.continuousAt_iff.mp hΛ_cont.continuousAt (c_Λ / 2) (by positivity)
    obtain ⟨δ₂, hδ₂_pos, hδ₂⟩ :=
      Metric.continuousAt_iff.mp hk_cont (c_k / 2) (by positivity)
    let δ : ℝ := min 1 (min δ₁ δ₂)
    have hδ_pos : 0 < δ := lt_min zero_lt_one (lt_min hδ₁_pos hδ₂_pos)
    have hδ_le1 : δ ≤ 1 := min_le_left _ _
    let U_δ : Set (ℂ × ℂ) := { p : ℂ × ℂ | ‖p.1 - S₀‖ < δ ∧ ‖p.2 - H₀‖ < δ }
    have hU_sub : U_δ ⊆ U₁ := fun p hp =>
      ⟨lt_of_lt_of_le hp.1 hδ_le1, lt_of_lt_of_le hp.2 hδ_le1⟩
    have h_bounds_Uδ : ∀ p ∈ U_δ,
        c_Λ / 2 ≤ ‖Λ_fn p‖ ∧ ‖Λ_fn p‖ ≤ 2 * c_Λ ∧
        c_k / 2 ≤ ‖k_lim p‖ ∧ ‖k_lim p‖ ≤ 2 * c_k ∧ Λ_fn p ≠ 0 := by
      intro p ⟨hp1, hp2⟩
      have hdist : dist p p₀ < min δ₁ δ₂ := by
