          Filter.atTop (nhds ((1 / 2 : ℂ) * (I₂ - I₁ ^ 2 / I₀))) := by
      simpa only [h_div_seq] using h_asymp
    have h_div00 : sfcaDivH P₀ 0 0 = (1 / 2 : ℂ) * (I₂ - I₁ ^ 2 / I₀) :=
      tendsto_nhds_unique h_lhs_tendsto h_rhs_tendsto
    have h_psi : sfcaUniversalPsi P₀ 0 0 = sfcaDivH P₀ 0 0 := by
      simp [sfcaUniversalPsi]
    have hP₀_eq : P₀ = (fun _ => μ) := by
      ext w
      exact hlam_sq
    rw [← hP₀_eq, h_psi, h_div00, h_moments_eq_frozen, hlam_sq]

theorem universal_chord_functional_and_frozen_bounds (hVolt : SfcaVolterraKernelProp) :
    SfcaUniversalChordProp :=
by
  obtain ⟨hNumA, C_N, hCN_pos, hNumLip⟩ := sfca_num_holo_slit_and_symmetries hVolt
  obtain ⟨hTkA, C_tk, hCtk_pos, hTkQuad, hTkLip⟩ := sfca_bivariate_dslope_cauchy_toolkit
  have hEta_le_RhoB : sfcaEtaSL ≤ sfcaRhoB := by norm_num [sfcaEtaSL, sfcaRhoB]
  have hRhoB_nonneg : 0 ≤ sfcaRhoB := by norm_num [sfcaRhoB]
  have hConstHolo : ∀ μ : ℂ, ‖μ‖ ≤ sfcaRhoB → IsSfcaBivarHoloVanish (sfcaNumN (fun _ => μ)) :=
    fun μ hμ => (hNumA (fun _ => μ) continuousOn_const (fun _ _ => hμ)).1
  have h0_le_RhoB : ‖(0 : ℂ)‖ ≤ sfcaRhoB := by simpa using hRhoB_nonneg
  have hDiv0 : ∀ b₀ b₁ : ℂ, ‖b₀‖ < sfcaRhoB → ‖b₁‖ < sfcaRhoB →
      b₀ * b₁ * sfcaDivH (fun _ => 0) b₀ b₁ = sfcaNumN (fun _ => 0) b₀ b₁ :=
    fun b₀ b₁ hb₀ hb₁ => (hTkA (sfcaNumN (fun _ => 0)) (hConstHolo 0 h0_le_RhoB)).1 b₀ b₁ hb₀ hb₁
  have hCont0 : ContinuousAt (fun z : ℂ × ℂ => sfcaDivH (fun _ => 0) z.1 z.2) (0, 0) :=
    (hTkA (sfcaNumN (fun _ => 0)) (hConstHolo 0 h0_le_RhoB)).2.2.1
  obtain ⟨hZero, hFirst⟩ := sfca_frozen_first_field_eval hVolt hDiv0 hCont0
  have hSecond : ∀ μ : ℂ, ‖μ‖ < sfcaEtaSL → sfcaUniversalPsi (fun _ => μ) 0 0 = frozenPhiSecond μ :=
    sfca_frozen_second_field_eval hVolt hZero
      (fun μ b₀ b₁ hμ hb₀ hb₁ =>
        (hTkA (sfcaNumN (fun _ => μ))
          (hConstHolo μ (le_trans hμ.le hEta_le_RhoB))).1 b₀ b₁ hb₀ hb₁)
      (fun μ hμ =>
        (hTkA (sfcaNumN (fun _ => μ))
          (hConstHolo μ (le_trans hμ.le hEta_le_RhoB))).2.2.1)
  refine {
    div_and_slit := ?_
    double_circle_eq := ?_
    rev_symm := ?_
    frozen_evals := ⟨hZero, hFirst, hSecond⟩
    exists_lip_bounds := ?_
  }
  · intro Q hQ_cont hQ_lt
    obtain ⟨hHolo, hProps⟩ := hNumA Q hQ_cont (fun w hw => (hQ_lt w hw).le)
    refine ⟨hHolo.1, ?_⟩
    intro b₀ b₁ hb₀ hb₁
    exact ⟨(hProps b₀ b₁ hb₀ hb₁).1,
      (hTkA (sfcaNumN Q) hHolo).1 b₀ b₁ hb₀ hb₁,
      (hProps b₀ b₁ hb₀ hb₁).2.1⟩
  · intro Q b₀ b₁ hQ_cont hQ_lt hb₀ hb₁
    have hHolo := (hNumA Q hQ_cont (fun w hw => (hQ_lt w hw).le)).1
    exact (hTkA (sfcaNumN Q) hHolo).2.1 b₀ b₁ hb₀ hb₁
  · intro Q b₀ b₁ hQ_cont hQ_lt hb₀ hb₁
    have hQ_le : ∀ w ∈ Set.Icc (0 : ℝ) 1, ‖Q w‖ ≤ sfcaRhoB :=
      fun w hw => (hQ_lt w hw).le
    have hRev_maps : Set.MapsTo (fun w : ℝ => 1 - w) (Set.Icc (0 : ℝ) 1) (Set.Icc (0 : ℝ) 1) := by
      intro w hw
      exact ⟨by linarith [hw.2], by linarith [hw.1]⟩
    have hQrev_cont : ContinuousOn (fun w => Q (1 - w)) (Set.Icc (0 : ℝ) 1) :=
      hQ_cont.comp (continuous_const.sub continuous_id).continuousOn hRev_maps
    have hQrev_le : ∀ w ∈ Set.Icc (0 : ℝ) 1, ‖Q (1 - w)‖ ≤ sfcaRhoB :=
      fun w hw => hQ_le (1 - w) (hRev_maps hw)
    obtain ⟨hHolo, hProps⟩ := hNumA Q hQ_cont hQ_le
    have hHoloRev := (hNumA (fun w => Q (1 - w)) hQrev_cont hQrev_le).1
    exact (hTkA (sfcaNumN Q) hHolo).2.2.2
      (sfcaNumN (fun w => Q (1 - w))) hHoloRev
      (fun z₀ z₁ hz₀ hz₁ => (hProps z₀ z₁ hz₀ hz₁).2.2.2) b₀ b₁ hb₀ hb₁
  · refine ⟨C_tk * (C_N + 12), mul_pos hCtk_pos (by linarith), ?_⟩
    intro Q a₀ a₁ hQ_cont hQ_lt ha₀ ha₁
    have hQ_rhoB : ∀ w ∈ Set.Icc (0 : ℝ) 1, ‖Q w‖ ≤ sfcaRhoB :=
      fun w hw => le_trans (hQ_lt w hw).le hEta_le_RhoB
    have hQ_half : ∀ w ∈ Set.Icc (0 : ℝ) 1, ‖Q w‖ ≤ 1 / 2 :=
      fun w hw => le_trans (hQ_rhoB w hw) (by norm_num [sfcaRhoB])
    obtain ⟨hQ_holo, hQ_props⟩ := hNumA Q hQ_cont hQ_rhoB
    have h1_mem : (1 : ℝ) ∈ Set.Icc (0 : ℝ) 1 := ⟨zero_le_one, le_rfl⟩
    have hQ_qb :=
      (hVolt.quant_bounds Q sfcaRhoB hQ_cont hRhoB_nonneg (by norm_num [sfcaRhoB]) hQ_rhoB).2
        1 h1_mem
    have h1_norm : ‖(1 : ℂ)‖ = 1 := norm_one
    have hC1_le : ‖sfcaVolterraC Q 1‖ ≤ 2 := by
      calc ‖sfcaVolterraC Q 1‖
          = ‖(sfcaVolterraC Q 1 - 1) + 1‖ := by ring_nf
        _ ≤ ‖sfcaVolterraC Q 1 - 1‖ + ‖(1 : ℂ)‖ := norm_add_le _ _
        _ ≤ sfcaRhoB + 1 := by linarith [hQ_qb.1, h1_norm]
        _ ≤ 2 := by norm_num [sfcaRhoB]
    have hK1_le : ‖sfcaVolterraK Q 1‖ ≤ 2 := by
      calc ‖sfcaVolterraK Q 1‖
          = ‖(sfcaVolterraK Q 1 - ((1 : ℝ) : ℂ)) + 1‖ := by push_cast; ring_nf
        _ ≤ ‖sfcaVolterraK Q 1 - ((1 : ℝ) : ℂ)‖ + ‖(1 : ℂ)‖ := norm_add_le _ _
        _ ≤ (1 / 4 : ℝ) * sfcaRhoB + 1 := by linarith [hQ_qb.2.1, h1_norm]
        _ ≤ 2 := by norm_num [sfcaRhoB]
    set b₀ : ℂ := a₀
    set b₁ : ℂ := a₀ * sfcaVolterraC Q 1 + a₁ * sfcaVolterraK Q 1
    have hb₀_le : ‖b₀‖ ≤ sfcaRhoC / 2 :=
      le_trans ha₀.le (by norm_num [sfcaEtaSL, sfcaRhoC])
    have hb₁_bound : ‖b₁‖ ≤ 2 * ‖a₀‖ + 2 * ‖a₁‖ := by
      calc ‖b₁‖
          ≤ ‖a₀ * sfcaVolterraC Q 1‖ + ‖a₁ * sfcaVolterraK Q 1‖ := norm_add_le _ _
        _ = ‖a₀‖ * ‖sfcaVolterraC Q 1‖ + ‖a₁‖ * ‖sfcaVolterraK Q 1‖ := by rw [norm_mul, norm_mul]
        _ ≤ ‖a₀‖ * 2 + ‖a₁‖ * 2 :=
            add_le_add (mul_le_mul_of_nonneg_left hC1_le (norm_nonneg _))
              (mul_le_mul_of_nonneg_left hK1_le (norm_nonneg _))
        _ = 2 * ‖a₀‖ + 2 * ‖a₁‖ := by ring
    have hb₁_le : ‖b₁‖ ≤ sfcaRhoC / 2 := by
      have ha₀_le := ha₀.le
      have ha₁_le := ha₁.le
      norm_num [sfcaEtaSL, sfcaRhoC] at ha₀_le ha₁_le ⊢
      linarith
    have h0_le_rhoC : ‖(0 : ℂ)‖ ≤ sfcaRhoC / 2 := by norm_num [sfcaRhoC]
    have hQ_bound3 : ∀ z₀ z₁ : ℂ, ‖z₀‖ < sfcaRhoB → ‖z₁‖ < sfcaRhoB → ‖sfcaNumN Q z₀ z₁‖ ≤ 3 :=
      fun z₀ z₁ hz₀ hz₁ => (hQ_props z₀ z₁ hz₀ hz₁).2.1
    constructor
    · intro M_q hMq_nonneg hMq
      have hNumLip0 : ∀ z₀ z₁ : ℂ, ‖z₀‖ < sfcaRhoB → ‖z₁‖ < sfcaRhoB →
          ‖sfcaNumN Q z₀ z₁ - sfcaNumN (fun _ => 0) z₀ z₁‖ ≤ C_N * M_q :=
        hNumLip Q (fun _ => 0) M_q hQ_cont continuousOn_const
          (fun w hw => ⟨hQ_rhoB w hw, h0_le_RhoB⟩) hMq_nonneg
          (fun w hw => by simpa using hMq w hw)
      constructor
      · have hDiv00 : sfcaBivarDiv (sfcaNumN (fun _ => 0)) 0 0 = 1 / 24 := by
          simpa [sfcaUniversalPsi, sfcaDivH, sfcaBivarDiv] using hZero
        have hQuad :=
          hTkQuad (sfcaNumN Q) hQ_holo
            (fun z₀ z₁ hz₀ hz₁ => ⟨(hQ_props z₀ z₁ hz₀ hz₁).2.1, (hQ_props z₀ z₁ hz₀ hz₁).2.2.1⟩)
            b₀ b₁ hb₀_le hb₁_le
        have hLip0 :=
          hTkLip (sfcaNumN Q) (sfcaNumN (fun _ => 0)) (C_N * M_q)
            hQ_holo (hConstHolo 0 h0_le_RhoB) hQ_bound3
            (mul_nonneg hCN_pos.le hMq_nonneg) hNumLip0
            0 0 0 0 h0_le_rhoC h0_le_rhoC h0_le_rhoC h0_le_rhoC
        simp only [sub_self, norm_zero, add_zero] at hLip0
        have hSq_bound : ‖b₀‖ ^ 2 + ‖b₁‖ ^ 2 ≤ 9 * (‖a₀‖ ^ 2 + ‖a₁‖ ^ 2) := by
          have hb₁_nonneg : 0 ≤ ‖b₁‖ := norm_nonneg _
          have hb₁_sq : ‖b₁‖ ^ 2 ≤ (2 * ‖a₀‖ + 2 * ‖a₁‖) ^ 2 :=
            pow_le_pow_left₀ hb₁_nonneg hb₁_bound 2
          have h_amgm : 0 ≤ (2 * ‖a₀‖ - 2 * ‖a₁‖) ^ 2 := sq_nonneg _
          change ‖a₀‖ ^ 2 + ‖b₁‖ ^ 2 ≤ 9 * (‖a₀‖ ^ 2 + ‖a₁‖ ^ 2)
          nlinarith
        have hInner0 : (‖b₀‖ ^ 2 + ‖b₁‖ ^ 2) + C_N * M_q ≤
            (C_N + 12) * (M_q + ‖a₀‖ ^ 2 + ‖a₁‖ ^ 2) := by
          have h_eq : (C_N + 12) * (M_q + ‖a₀‖ ^ 2 + ‖a₁‖ ^ 2) =
              9 * (‖a₀‖ ^ 2 + ‖a₁‖ ^ 2) + C_N * M_q +
                (12 * M_q + (C_N + 3) * (‖a₀‖ ^ 2 + ‖a₁‖ ^ 2)) := by ring
          have h_rem : 0 ≤ 12 * M_q + (C_N + 3) * (‖a₀‖ ^ 2 + ‖a₁‖ ^ 2) := by positivity
          linarith [hSq_bound]
        change ‖sfcaBivarDiv (sfcaNumN Q) b₀ b₁ - 1 / 24‖ ≤
          C_tk * (C_N + 12) * (M_q + ‖a₀‖ ^ 2 + ‖a₁‖ ^ 2)
        rw [← hDiv00]
        calc ‖sfcaBivarDiv (sfcaNumN Q) b₀ b₁ - sfcaBivarDiv (sfcaNumN (fun _ => 0)) 0 0‖
            ≤ ‖sfcaBivarDiv (sfcaNumN Q) b₀ b₁ - sfcaBivarDiv (sfcaNumN Q) 0 0‖ +
                ‖sfcaBivarDiv (sfcaNumN Q) 0 0 - sfcaBivarDiv (sfcaNumN (fun _ => 0)) 0 0‖ :=
              norm_sub_le_norm_sub_add_norm_sub _ _ _
          _ ≤ C_tk * (‖b₀‖ ^ 2 + ‖b₁‖ ^ 2) + C_tk * (C_N * M_q) := add_le_add hQuad hLip0
          _ = C_tk * ((‖b₀‖ ^ 2 + ‖b₁‖ ^ 2) + C_N * M_q) := by ring
          _ ≤ C_tk * ((C_N + 12) * (M_q + ‖a₀‖ ^ 2 + ‖a₁‖ ^ 2)) :=
              mul_le_mul_of_nonneg_left hInner0 hCtk_pos.le
          _ = C_tk * (C_N + 12) * (M_q + ‖a₀‖ ^ 2 + ‖a₁‖ ^ 2) := by ring
      · have hZeroPot1 := hVolt.zero_pot 1 h1_mem
        have hFirst_eq : frozenPhiFirst a₀ = sfcaBivarDiv (sfcaNumN (fun _ => 0)) a₀ a₀ := by
          rw [← hFirst a₀ ha₀]
          simp [sfcaUniversalPsi, sfcaDivH, sfcaBivarDiv, hZeroPot1.1]
        have hC_lip : ‖sfcaVolterraC Q 1 - 1‖ ≤ M_q := by
          have hL :=
            (hVolt.lip_bounds Q (fun _ => 0) M_q hQ_cont continuousOn_const
              (fun w hw => ⟨hQ_half w hw, by norm_num⟩) hMq_nonneg
              (fun w hw => by simpa using hMq w hw) 1 h1_mem).1
          rwa [hZeroPot1.1] at hL
        have ha₀_le_one : ‖a₀‖ ≤ 1 := le_trans ha₀.le (by norm_num [sfcaEtaSL])
        have hb₁_diff : ‖b₁ - a₀‖ ≤ M_q + 2 * ‖a₁‖ := by
          have hb₁_sub : b₁ - a₀ = a₀ * (sfcaVolterraC Q 1 - 1) + a₁ * sfcaVolterraK Q 1 := by
            dsimp [b₁]
            ring
          rw [hb₁_sub]
          calc ‖a₀ * (sfcaVolterraC Q 1 - 1) + a₁ * sfcaVolterraK Q 1‖
              ≤ ‖a₀ * (sfcaVolterraC Q 1 - 1)‖ + ‖a₁ * sfcaVolterraK Q 1‖ := norm_add_le _ _
            _ = ‖a₀‖ * ‖sfcaVolterraC Q 1 - 1‖ + ‖a₁‖ * ‖sfcaVolterraK Q 1‖ := by
                rw [norm_mul, norm_mul]
            _ ≤ 1 * M_q + ‖a₁‖ * 2 :=
                add_le_add (mul_le_mul ha₀_le_one hC_lip (norm_nonneg _) zero_le_one)
                  (mul_le_mul_of_nonneg_left hK1_le (norm_nonneg _))
            _ = M_q + 2 * ‖a₁‖ := by ring
        have hLip1 :=
          hTkLip (sfcaNumN Q) (sfcaNumN (fun _ => 0)) (C_N * M_q)
            hQ_holo (hConstHolo 0 h0_le_RhoB) hQ_bound3
            (mul_nonneg hCN_pos.le hMq_nonneg) hNumLip0
            b₀ b₁ a₀ a₀ hb₀_le hb₁_le hb₀_le hb₀_le
        have hInner1 : C_N * M_q + ‖b₀ - a₀‖ + ‖b₁ - a₀‖ ≤
            (C_N + 12) * (M_q + ‖a₁‖) := by
          have hb₀_sub : ‖b₀ - a₀‖ = 0 := by simp [b₀]
          have h_eq : (C_N + 12) * (M_q + ‖a₁‖) =
              C_N * M_q + (M_q + 2 * ‖a₁‖) + (11 * M_q + (C_N + 10) * ‖a₁‖) := by ring
          have h_rem : 0 ≤ 11 * M_q + (C_N + 10) * ‖a₁‖ := by positivity
          linarith [hb₁_diff, hb₀_sub]
        change ‖sfcaBivarDiv (sfcaNumN Q) b₀ b₁ - frozenPhiFirst a₀‖ ≤
          C_tk * (C_N + 12) * (M_q + ‖a₁‖)
        rw [hFirst_eq]
        calc ‖sfcaBivarDiv (sfcaNumN Q) b₀ b₁ - sfcaBivarDiv (sfcaNumN (fun _ => 0)) a₀ a₀‖
            ≤ C_tk * (C_N * M_q + ‖b₀ - a₀‖ + ‖b₁ - a₀‖) := hLip1
          _ ≤ C_tk * ((C_N + 12) * (M_q + ‖a₁‖)) :=
              mul_le_mul_of_nonneg_left hInner1 hCtk_pos.le
          _ = C_tk * (C_N + 12) * (M_q + ‖a₁‖) := by ring
    · intro μ M_diff hμ hMdiff_nonneg hMdiff
      have hμ_rhoB : ‖μ‖ ≤ sfcaRhoB := le_trans hμ.le hEta_le_RhoB
      have hSecond_eq : frozenPhiSecond μ = sfcaBivarDiv (sfcaNumN (fun _ => μ)) 0 0 := by
        rw [← hSecond μ hμ]
        simp [sfcaUniversalPsi, sfcaDivH, sfcaBivarDiv]
      have hNumLipMu : ∀ z₀ z₁ : ℂ, ‖z₀‖ < sfcaRhoB → ‖z₁‖ < sfcaRhoB →
          ‖sfcaNumN Q z₀ z₁ - sfcaNumN (fun _ => μ) z₀ z₁‖ ≤ C_N * M_diff :=
        hNumLip Q (fun _ => μ) M_diff hQ_cont continuousOn_const
          (fun w hw => ⟨hQ_rhoB w hw, hμ_rhoB⟩) hMdiff_nonneg hMdiff
      have hLip2 :=
        hTkLip (sfcaNumN Q) (sfcaNumN (fun _ => μ)) (C_N * M_diff)
          hQ_holo (hConstHolo μ hμ_rhoB) hQ_bound3
          (mul_nonneg hCN_pos.le hMdiff_nonneg) hNumLipMu
          b₀ b₁ 0 0 hb₀_le hb₁_le h0_le_rhoC h0_le_rhoC
      have hInner2 : C_N * M_diff + ‖b₀ - 0‖ + ‖b₁ - 0‖ ≤
          (C_N + 12) * (M_diff + ‖a₀‖ + ‖a₁‖) := by
        have hb₀_z : ‖b₀ - 0‖ = ‖a₀‖ := by simp [b₀]
        have hb₁_z : ‖b₁ - 0‖ = ‖b₁‖ := by simp
        have h_eq : (C_N + 12) * (M_diff + ‖a₀‖ + ‖a₁‖) =
            C_N * M_diff + ‖a₀‖ + (2 * ‖a₀‖ + 2 * ‖a₁‖) +
              (12 * M_diff + (C_N + 9) * ‖a₀‖ + (C_N + 10) * ‖a₁‖) := by ring
        have h_rem : 0 ≤ 12 * M_diff + (C_N + 9) * ‖a₀‖ + (C_N + 10) * ‖a₁‖ := by positivity
        linarith [hb₁_bound, hb₀_z, hb₁_z]
      change ‖sfcaBivarDiv (sfcaNumN Q) b₀ b₁ - frozenPhiSecond μ‖ ≤
        C_tk * (C_N + 12) * (M_diff + ‖a₀‖ + ‖a₁‖)
      rw [hSecond_eq]
      calc ‖sfcaBivarDiv (sfcaNumN Q) b₀ b₁ - sfcaBivarDiv (sfcaNumN (fun _ => μ)) 0 0‖
          ≤ C_tk * (C_N * M_diff + ‖b₀ - 0‖ + ‖b₁ - 0‖) := hLip2
        _ ≤ C_tk * ((C_N + 12) * (M_diff + ‖a₀‖ + ‖a₁‖)) :=
            mul_le_mul_of_nonneg_left hInner2 hCtk_pos.le
        _ = C_tk * (C_N + 12) * (M_diff + ‖a₀‖ + ‖a₁‖) := by ring

theorem strip_chord_domain_and_holomorphy (S : FiniteWallNonisotropicStrip)
    (hVolt : SfcaVolterraKernelProp)
    (hUniv : SfcaUniversalChordProp) :
    IsOpen (smallChordDomain S sfcaEtaSL) ∧
    DifferentiableOn ℂ (sfcaStripPhi S) (smallChordDomain S sfcaEtaSL) ∧
    (∀ s h : ℂ,
      (s, h) ∈ smallChordDomain S sfcaEtaSL →
      (s + h, -h) ∈ smallChordDomain S sfcaEtaSL →
      sfcaStripPhi S (s + h, -h) = sfcaStripPhi S (s, h)) :=
by
  have hOpen_strip : IsOpen (horizStrip S.H) :=
    isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const
  have hDerivF_holo : DifferentiableOn ℂ (deriv S.f) (horizStrip S.H) :=
    S.f_holo.deriv hOpen_strip
  have hSeg_mem : ∀ s h : ℂ, s ∈ horizStrip S.H → s + h ∈ horizStrip S.H →
      ∀ w ∈ Set.Icc (0 : ℝ) 1, s + (w : ℂ) * h ∈ horizStrip S.H := by
    intro s h hs hsh w hw
    rcases hw with ⟨hw0, hw1⟩
    change |(s + (w : ℂ) * h).im| < S.H
    have him : (s + (w : ℂ) * h).im = (1 - w) * s.im + w * (s + h).im := by
      simp [Complex.add_im, Complex.mul_im]
      ring
    rw [him, abs_lt]
    change |s.im| < S.H at hs
    change |(s + h).im| < S.H at hsh
    rw [abs_lt] at hs hsh
    rcases hs with ⟨hs_lo, hs_hi⟩
    rcases hsh with ⟨hsh_lo, hsh_hi⟩
    rcases eq_or_lt_of_le hw0 with rfl | hw_pos
    · simp [hs_lo, hs_hi]
    · have h1w : 0 ≤ 1 - w := by linarith
      constructor <;> nlinarith
  have hPot_cont : ∀ s h : ℂ, s ∈ horizStrip S.H → s + h ∈ horizStrip S.H →
      ContinuousOn (sfcaStripPot S s h) (Set.Icc (0 : ℝ) 1) := by
    intro s h hs hsh
    have hSegCont : ContinuousOn (fun w : ℝ => s + (w : ℂ) * h) (Set.Icc (0 : ℝ) 1) :=
      (continuous_const.add (Complex.continuous_ofReal.mul continuous_const)).continuousOn
    exact continuousOn_const.mul (S.q_holo.continuousOn.comp hSegCont (hSeg_mem s h hs hsh))
  
  have hOpen : IsOpen (smallChordDomain S sfcaEtaSL) := by
    let U_strip : Set (ℂ × ℂ) :=
      (Prod.fst ⁻¹' horizStrip S.H) ∩ ((fun q : ℂ × ℂ => q.1 + q.2) ⁻¹' horizStrip S.H)
    have hU_strip : IsOpen U_strip :=
      (hOpen_strip.preimage continuous_fst).inter
        (hOpen_strip.preimage (continuous_fst.add continuous_snd))
    let g₁ : ℂ × ℂ → ℝ := fun q => ‖q.2 * S.f q.1‖
    let g₂ : ℂ × ℂ → ℝ := fun q => ‖q.2 ^ 2 * deriv S.f q.1‖
