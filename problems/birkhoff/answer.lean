            H_base p_bot ≠ 0 ∧
            0 < r_bot ∧
            Metric.ball p_bot r_bot ⊆ U_uni ∧
            (∀ ι : Fin 2, DifferentiableOn ℂ (M_bot ι) (Metric.ball p_bot r_bot)) ∧
            (∀ ι : Fin 2, ∀ p ∈ Metric.ball p_bot r_bot,
