      hΘ_WU.mono hWcol_sub
    have hτ_holo : DifferentiableOn ℂ (fun q : ℂ × ℂ => (q.1 + q.2, q.2)) W_col :=
      ((differentiable_fst.add differentiable_snd).prodMk differentiable_snd).differentiableOn
    have hτ_maps : Set.MapsTo (fun q : ℂ × ℂ => (q.1 + q.2, q.2)) W_col W_U := by
      intro q hq
      refine ⟨?_, hq.2⟩
      have him : |(q.1 + q.2).im| ≤ |q.1.im| + |q.2.im| := by
        simpa [Complex.add_im] using abs_add_le q.1.im q.2.im
      have him2 : |q.2.im| ≤ ‖q.2‖ := Complex.abs_im_le_norm q.2
      linarith [hq.1, hq.2]
    have hΘ_fwd_raw := DifferentiableOn.comp hΘ_WU hτ_holo hτ_maps
    have hΘ_fwd : DifferentiableOn ℂ
        (fun q : ℂ × ℂ => glancingTheta C (q.1 + q.2) q.2) W_col := hΘ_fwd_raw
    have hM_holo : DifferentiableOn ℂ
        (fun q : ℂ × ℂ => (glancingTheta C q.1 q.2 + glancingTheta C (q.1 + q.2) q.2) / 2)
        W_col := by
      change DifferentiableOn ℂ
        (fun q : ℂ × ℂ =>
          (glancingTheta C q.1 q.2 + glancingTheta C (q.1 + q.2) q.2) * (2 : ℂ)⁻¹) W_col
      exact (hΘ_col.add hΘ_fwd).mul_const ((2 : ℂ)⁻¹)
    have hD_holo : DifferentiableOn ℂ
        (fun q : ℂ × ℂ => (glancingTheta C (q.1 + q.2) q.2 - glancingTheta C q.1 q.2) / 2)
        W_col := by
      change DifferentiableOn ℂ
        (fun q : ℂ × ℂ =>
          (glancingTheta C (q.1 + q.2) q.2 - glancingTheta C q.1 q.2) * (2 : ℂ)⁻¹) W_col
      exact (hΘ_fwd.sub hΘ_col).mul_const ((2 : ℂ)⁻¹)
    have hM_maps : Set.MapsTo
        (fun q : ℂ × ℂ => (glancingTheta C q.1 q.2 + glancingTheta C (q.1 + q.2) q.2) / 2)
        W_col (horizStrip (2 * C.s_h)) := by
      intro q hq
      have h1 : |(glancingTheta C q.1 q.2).im| < 2 * C.s_h := hΘ_maps q (hWcol_sub hq)
      have h2 : |(glancingTheta C (q.1 + q.2) q.2).im| < 2 * C.s_h := hΘ_maps _ (hτ_maps hq)
      change |((glancingTheta C q.1 q.2 + glancingTheta C (q.1 + q.2) q.2) / 2).im| < 2 * C.s_h
      have him_eq : ((glancingTheta C q.1 q.2 + glancingTheta C (q.1 + q.2) q.2) / 2).im =
          ((glancingTheta C q.1 q.2).im + (glancingTheta C (q.1 + q.2) q.2).im) / 2 := by
        simp [div_eq_mul_inv]
      rw [him_eq, abs_div, abs_of_pos (by norm_num : (0 : ℝ) < 2)]
      have htri := abs_add_le (glancingTheta C q.1 q.2).im (glancingTheta C (q.1 + q.2) q.2).im
      linarith
    have hstrip_open : IsOpen (horizStrip (2 * C.s_h)) :=
      isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const
    have hdh_holo : DifferentiableOn ℂ (deriv C.h_ℂ) (horizStrip (2 * C.s_h)) :=
      C.h_ℂ_holo.deriv hstrip_open
    have hdh_comp := DifferentiableOn.comp hdh_holo hM_holo hM_maps
    have hh_comp := DifferentiableOn.comp C.h_ℂ_holo hM_holo hM_maps
    have hsin_comp := DifferentiableOn.comp Complex.differentiable_sin.differentiableOn
      hD_holo (Set.mapsTo_univ _ _)
    have hcos_comp := DifferentiableOn.comp Complex.differentiable_cos.differentiableOn
      hD_holo (Set.mapsTo_univ _ _)
    have hP_raw := ((hdh_comp.mul hsin_comp).sub (hh_comp.mul hcos_comp)).neg
    have hP_col : DifferentiableOn ℂ (fun q : ℂ × ℂ => glancingOffset C q.1 q.2) W_col := hP_raw
    have hsnd_Wnorm : Set.MapsTo Prod.snd W_norm (Metric.ball (0 : ℂ) M.r_base) := by
      intro p hp
      simpa [Metric.mem_ball] using lt_trans hp.2 hr_star_lt_r_base
    have hb_Wnorm := DifferentiableOn.comp hb_holo differentiable_snd.differentiableOn hsnd_Wnorm
    have hS_Wnorm_holo : DifferentiableOn ℂ (fun p : ℂ × ℂ => (p.1 - b_shift p.2, p.2)) W_norm :=
      (differentiable_fst.differentiableOn.sub hb_Wnorm).prodMk differentiable_snd.differentiableOn
    have hS_Wnorm_maps : Set.MapsTo (fun p : ℂ × ℂ => (p.1 - b_shift p.2, p.2)) W_norm W_col := by
      intro p hp
      refine ⟨?_, lt_trans hp.2 hr_star_lt_r₁⟩
      have ht_ball : p.2 ∈ Metric.ball (0 : ℂ) r_star := by simpa [Metric.mem_ball] using hp.2
      have hb_p2 : ‖b_shift p.2‖ < s_star / 4 := hb_small p.2 ht_ball
      have hb_im : |(b_shift p.2).im| ≤ ‖b_shift p.2‖ := Complex.abs_im_le_norm _
      have htri : |p.1.im - (b_shift p.2).im| ≤ |p.1.im| + |(b_shift p.2).im| := abs_sub _ _
      change |p.1.im - (b_shift p.2).im| < C.s₁
      linarith [hp.1]
    have hΘ_gl_raw := DifferentiableOn.comp hΘ_col hS_Wnorm_holo hS_Wnorm_maps
    have hp_gl_raw := DifferentiableOn.comp hP_col hS_Wnorm_holo hS_Wnorm_maps
    have h_shear_deriv : ∀ (F : ℂ × ℂ → ℂ) (y t : ℂ),
        DifferentiableAt ℂ F (y - b_shift t, t) → DifferentiableAt ℂ b_shift t →
        deriv (fun y' : ℂ => F (y' - b_shift t, t)) y =
          deriv (fun u' : ℂ => F (u', t)) (y - b_shift t) ∧
        deriv (fun t' : ℂ => F (y - b_shift t', t')) t =
          -deriv b_shift t * deriv (fun u' : ℂ => F (u', t)) (y - b_shift t) +
            deriv (fun t' : ℂ => F (y - b_shift t, t')) t := by
      intro F y t hF hb
      let u : ℂ := y - b_shift t
      let L : (ℂ × ℂ) →L[ℂ] ℂ := fderiv ℂ F (u, t)
      have hFL : HasFDerivAt F L (u, t) := hF.hasFDerivAt
      have h1 : deriv (fun u' : ℂ => F (u', t)) u = L (1, 0) :=
        (HasFDerivAt.comp_hasDerivAt (f := fun u' : ℂ => (u', t)) u hFL
          ((hasDerivAt_id' u).prodMk (hasDerivAt_const u t))).deriv
      have h2 : deriv (fun t' : ℂ => F (u, t')) t = L (0, 1) :=
        (HasFDerivAt.comp_hasDerivAt (f := fun t' : ℂ => (u, t')) t hFL
          ((hasDerivAt_const t u).prodMk (hasDerivAt_id' t))).deriv
      have h3 : deriv (fun y' : ℂ => F (y' - b_shift t, t)) y = L (1, 0) :=
        (HasFDerivAt.comp_hasDerivAt (f := fun y' : ℂ => (y' - b_shift t, t)) y hFL
          (((hasDerivAt_id' y).sub_const (b_shift t)).prodMk (hasDerivAt_const y t))).deriv
      have h4 : deriv (fun t' : ℂ => F (y - b_shift t', t')) t = L (-deriv b_shift t, 1) :=
        (HasFDerivAt.comp_hasDerivAt (f := fun t' : ℂ => (y - b_shift t', t')) t hFL
          ((hb.hasDerivAt.const_sub y).prodMk (hasDerivAt_id' t))).deriv
      have hvec : ((-deriv b_shift t : ℂ), (1 : ℂ)) =
          (-deriv b_shift t) • ((1 : ℂ), (0 : ℂ)) + ((0 : ℂ), (1 : ℂ)) := by
        ext <;> simp
      refine ⟨h3.trans h1.symm, ?_⟩
      rw [h4, h1, h2, hvec, map_add, map_smul, smul_eq_mul]
    have halg_gen : ∀ p_u p_t θ_u θ_t db : ℂ,
        p_u * (-db * θ_u + θ_t) - (-db * p_u + p_t) * θ_u = p_u * θ_t - p_t * θ_u :=
      fun _ _ _ _ _ => by ring
    refine ⟨hΘ_gl_raw, hp_gl_raw, ?_⟩
    intro y t hy ht
    have hyt_norm : (y, t) ∈ W_norm := ⟨hy, ht⟩
    have hq_col : (y - b_shift t, t) ∈ W_col := hS_Wnorm_maps hyt_norm
    have hP_at : DifferentiableAt ℂ (fun q : ℂ × ℂ => glancingOffset C q.1 q.2)
        (y - b_shift t, t) := hP_col.differentiableAt (hWcol_open.mem_nhds hq_col)
    have hΘ_at : DifferentiableAt ℂ (fun q : ℂ × ℂ => glancingTheta C q.1 q.2)
        (y - b_shift t, t) := hΘ_col.differentiableAt (hWcol_open.mem_nhds hq_col)
    have ht_base_ball : t ∈ Metric.ball (0 : ℂ) M.r_base := by
      simpa [Metric.mem_ball] using lt_trans ht hr_star_lt_r_base
    have hb_at : DifferentiableAt ℂ b_shift t :=
      hb_holo.differentiableAt (Metric.isOpen_ball.mem_nhds ht_base_ball)
    obtain ⟨hP_y, hP_t⟩ :=
      h_shear_deriv (fun q : ℂ × ℂ => glancingOffset C q.1 q.2) y t hP_at hb_at
    obtain ⟨hΘ_y, hΘ_t⟩ :=
      h_shear_deriv (fun q : ℂ × ℂ => glancingTheta C q.1 q.2) y t hΘ_at hb_at
    change deriv (fun y' : ℂ => glancingOffset C (y' - b_shift t) t) y *
        deriv (fun t' : ℂ => glancingTheta C (y - b_shift t') t') t -
      deriv (fun t' : ℂ => glancingOffset C (y - b_shift t') t') t *
        deriv (fun y' : ℂ => glancingTheta C (y' - b_shift t) t) y = C.A t
    rw [hP_y, hP_t, hΘ_y, hΘ_t, halg_gen]
    exact C.symplectic_jacobian (y - b_shift t) t hq_col.1 hq_col.2
  obtain ⟨hΘ_gl_holo, hp_gl_holo, hsymplectic_gl⟩ := hcollar_pkg
  exact ⟨{
    𝔰_raw := Raw.𝔰_raw
    𝔰_raw_holo := Raw.𝔰_raw_holo
    𝔰_raw_maps_to := Raw.𝔰_raw_maps_to
    𝔰_raw_init_eq := Raw.𝔰_raw_init_eq
    𝔰_raw_zero := Raw.𝔰_raw_zero
    𝔰_raw_quasiperiodic := Raw.𝔰_raw_quasiperiodic
    𝔰_raw_even := Raw.𝔰_raw_even
    𝔰_raw_conj := Raw.𝔰_raw_conj
    𝔰_raw_comp_X := Raw.𝔰_raw_comp_X
    b_shift := b_shift
    s_star := s_star
    r_star := r_star
    s_star_pos := hs_star_pos
    s_star_le := hs_star_le
    r_star_pos := hr_star_pos
    r_star_lt_half_s_star := hr_star_lt_half
    r_star_lt_pi := hr_star_lt_pi
    r_star_le := hr_star_le
    b_shift_holo := hb_holo
    b_shift_zero := hb_zero
    b_shift_even := hb_even
    b_shift_conj := hb_conj
    b_shift_small := hb_small
    T_norm_iff := hT_norm_iff
    𝔰_holo := h𝔰_holo
    𝔰_maps_to := h𝔰_maps_to
    𝔰_lower_strip_im := h𝔰_lower_strip_im
    𝔰_zero := h𝔰_zero
    𝔰_quasiperiodic := h𝔰_qp
    𝔰_even := h𝔰_even
    𝔰_conj := h𝔰_conj
    𝔰_mean_zero := h𝔰_mean_zero
    zero_slice_nhd := hzero_slice_nhd
    Θ_gl_holo := hΘ_gl_holo
    p_gl_holo := hp_gl_holo
    symplectic_gl := hsymplectic_gl
  }⟩

theorem raw_global_shape_lift (Ω : Set Plane)
    (C : AnalyticGlancingCollar Ω)
    (M : MeromorphicCollarData C)
    (K : NonisotropicCurveData C M) :
    Nonempty (NormalizedGlobalLiftData C M K) :=
by
  obtain ⟨Reg⟩ := regular_locus_and_sixth_root_system Ω C M K
  obtain ⟨ExpLift⟩ := ball_chain_monodromy_free_exp_lift Ω C M K Reg
  obtain ⟨Raw⟩ := removable_extension_and_raw_lift Ω C M K Reg ExpLift
  exact phase_mean_shift_normalization Ω C M K Raw

theorem speed_zeros_simple_and_inflection (Ω : Set Plane)
    (C : AnalyticGlancingCollar Ω)
    (M : MeromorphicCollarData C)
    (K : NonisotropicCurveData C M)
    (L : NormalizedGlobalLiftData C M K) :
    ∀ s ∈ horizStripENNR (M.h_X 0),
      K.f s = 0 → deriv K.f s ≠ 0 ∧ deriv (deriv K.f) s = 0 :=
by
  intro s₀ hs₀ hf₀
  have hOpen_strip : ∀ R : ℝ, IsOpen (horizStrip R) :=
    fun R => isOpen_Iio.preimage (continuous_abs.comp Complex.continuous_im)
  have hConv_strip : ∀ R : ℝ, Convex ℝ (horizStrip R) := by
    intro R x hx y hy a b ha hb hab
    change |(a • x + b • y).im| < R
    have him : (a • x + b • y).im = a * x.im + b * y.im := by
      simp [Complex.add_im, Complex.real_smul, Complex.mul_im]
    rw [him]
    have hx' : |x.im| < R := hx
    have hy' : |y.im| < R := hy
    have htri : |a * x.im + b * y.im| ≤ a * |x.im| + b * |y.im| := by
      calc
        |a * x.im + b * y.im| ≤ |a * x.im| + |b * y.im| := abs_add_le _ _
        _ = a * |x.im| + b * |y.im| := by rw [abs_mul, abs_mul, abs_of_nonneg ha, abs_of_nonneg hb]
    rcases eq_or_lt_of_le ha with rfl | ha_pos
    · simp only [zero_add] at hab; subst hab; linarith
    · nlinarith [abs_nonneg x.im, abs_nonneg y.im]
  let D_H : Set ℂ := horizStripENNR (M.h_X 0)
  have h0_rbase : (0 : ℂ) ∈ Metric.ball (0 : ℂ) M.r_base := Metric.mem_ball_self M.r_base_pos
  have hsbase_le_hX0 : ENNReal.ofReal M.s_base ≤ M.h_X 0 := M.h_X_ge 0 h0_rbase
  have hbase_sub_DH : horizStrip M.s_base ⊆ D_H :=
    fun s hs => lt_of_lt_of_le ((ENNReal.ofReal_lt_ofReal_iff M.s_base_pos).mpr hs) hsbase_le_hX0
  have h0_DH : (0 : ℂ) ∈ D_H := by
    apply hbase_sub_DH
    show |(0 : ℂ).im| < M.s_base
    simp [M.s_base_pos]
  obtain ⟨hDH_open, hDH_conv⟩ : IsOpen D_H ∧ Convex ℝ D_H := by
    rcases eq_top_or_lt_top (M.h_X 0) with hTop | hLtTop
    · have hUniv : D_H = Set.univ :=
        Set.eq_univ_of_forall (fun s => by simp [D_H, horizStripENNR, hTop])
      rw [hUniv]
      exact ⟨isOpen_univ, convex_univ⟩
    · let H : ℝ := (M.h_X 0).toReal
      have hH_eq : ENNReal.ofReal H = M.h_X 0 := ENNReal.ofReal_toReal (ne_of_lt hLtTop)
      have hH_pos : 0 < H := by
        by_contra hle
        have h0 : ENNReal.ofReal H = 0 := ENNReal.ofReal_eq_zero.mpr (le_of_not_gt hle)
        rw [h0] at hH_eq
        exact not_lt_of_ge (hH_eq ▸ hsbase_le_hX0) (ENNReal.ofReal_pos.mpr M.s_base_pos)
      have hEq : D_H = horizStrip H := by
        ext s
        change ENNReal.ofReal |s.im| < M.h_X 0 ↔ |s.im| < H
        rw [← hH_eq]
        exact ENNReal.ofReal_lt_ofReal_iff hH_pos
      rw [hEq]
      exact ⟨hOpen_strip H, hConv_strip H⟩
  have hDH_preconn : IsPreconnected D_H := hDH_conv.isPreconnected
  
  have hMeroDeriv : ∀ (F : ℂ → ℂ) (p : ℕ) (c : ℂ),
      MeromorphicAt F 0 → 1 ≤ p → c ≠ 0 →
      Filter.Tendsto (fun z : ℂ => z ^ p * deriv F z) (nhdsWithin 0 {0}ᶜ) (nhds c) →
      p ≠ 1 ∧ (2 ≤ p →
        Filter.Tendsto (fun z : ℂ => z ^ (p - 1) * F z) (nhdsWithin 0 {0}ᶜ)
          (nhds (-c / ((p - 1 : ℕ) : ℂ)))) := by
    intro F p c hF hp hc hLim
    have _hNeBot : (nhdsWithin (0 : ℂ) {(0 : ℂ)}ᶜ).NeBot := inferInstance
    have hOrdNeTop : meromorphicOrderAt F 0 ≠ ⊤ := by
      intro hTop
      have hEv0 : ∀ᶠ z in nhdsWithin (0 : ℂ) {(0 : ℂ)}ᶜ, F z = 0 :=
        meromorphicOrderAt_eq_top_iff.mp hTop
      rw [Filter.Eventually, mem_nhdsWithin] at hEv0
      obtain ⟨U, hU_open, h0U, hU_sub⟩ := hEv0
      have hDerivEv0 : (fun z : ℂ => z ^ p * deriv F z) =ᶠ[nhdsWithin 0 {0}ᶜ] 0 := by
        rw [Filter.EventuallyEq, Filter.Eventually, mem_nhdsWithin]
        refine ⟨U, hU_open, h0U, fun z hz => ?_⟩
        dsimp only [Pi.zero_apply]
        have hV_open : IsOpen (U ∩ {(0 : ℂ)}ᶜ) := hU_open.inter isOpen_compl_singleton
        have hF_loc : F =ᶠ[nhds z] (fun _ => (0 : ℂ)) :=
          Filter.eventually_of_mem (hV_open.mem_nhds hz) (fun w hw => hU_sub hw)
        have hd0 : deriv F z = 0 :=
          ((hasDerivAt_const z (0 : ℂ)).congr_of_eventuallyEq hF_loc).deriv
        simp [hd0]
      exact hc (tendsto_nhds_unique hLim (tendsto_const_nhds.congr' hDerivEv0.symm))
    obtain ⟨h, hh_anal, hh0_ne, hF_eq⟩ := (meromorphicOrderAt_ne_top_iff hF).mp hOrdNeTop
    set k : ℤ := (meromorphicOrderAt F 0).untop₀
    have hh_ev : ∀ᶠ w in nhds (0 : ℂ), AnalyticAt ℂ h w := hh_anal.eventually_analyticAt
    rw [Metric.eventually_nhds_iff_ball] at hh_ev
    obtain ⟨r₁, hr₁_pos, hr₁⟩ := hh_ev
    rw [Filter.EventuallyEq, Filter.Eventually, mem_nhdsWithin] at hF_eq
    obtain ⟨U₀, hU₀_open, h0U₀, hU₀_sub⟩ := hF_eq
    let U : Set ℂ := U₀ ∩ Metric.ball (0 : ℂ) r₁
    have hU_open : IsOpen U := hU₀_open.inter Metric.isOpen_ball
    have h0U : (0 : ℂ) ∈ U := ⟨h0U₀, Metric.mem_ball_self hr₁_pos⟩
    let V : Set ℂ := U ∩ {(0 : ℂ)}ᶜ
    have hV_open : IsOpen V := hU_open.inter isOpen_compl_singleton
    have hV_mem : V ∈ nhdsWithin (0 : ℂ) {(0 : ℂ)}ᶜ :=
      mem_nhdsWithin.mpr ⟨U, hU_open, h0U, Set.Subset.rfl⟩
    let G : ℂ → ℂ := fun w => (k : ℂ) * h w + w * deriv h w
    have hG_cont : ContinuousAt G 0 :=
      (continuousAt_const.mul hh_anal.continuousAt).add
        (continuousAt_id.mul hh_anal.deriv.continuousAt)
    have hG0 : G 0 = (k : ℂ) * h 0 := by simp [G]
    set d : ℤ := ((p - 1 : ℕ) : ℤ) + k
    have hEqV : ∀ z ∈ V, z ^ p * deriv F z = z ^ d * G z := by
      intro z hz
      have hz0 : z ≠ 0 := hz.2
      have hF_nhds : F =ᶠ[nhds z] (fun w : ℂ => w ^ k * h w) := by
        refine Filter.eventually_of_mem (hV_open.mem_nhds hz) (fun w hw => ?_)
        have hw_eq : F w = (w - 0) ^ k • h w := hU₀_sub ⟨hw.1.1, hw.2⟩
        simpa [sub_zero, smul_eq_mul] using hw_eq
      have hd_F : deriv F z = (k : ℂ) * z ^ (k - 1) * h z + z ^ k * deriv h z :=
        (((hasDerivAt_zpow k z (Or.inl hz0)).mul
          (hr₁ z hz.1.2).differentiableAt.hasDerivAt).congr_of_eventuallyEq hF_nhds).deriv
      have hz_mul : z * deriv F z = z ^ k * G z := by
        rw [hd_F, zpow_sub_one₀ hz0]
        dsimp only [G]
        linear_combination (k : ℂ) * z ^ k * h z * mul_inv_cancel₀ hz0
      have hp_eq : p = (p - 1) + 1 := (Nat.sub_add_cancel hp).symm
      calc
        z ^ p * deriv F z = z ^ (p - 1) * (z * deriv F z) := by
          conv_lhs => rw [hp_eq, pow_succ]
          ring
        _ = z ^ (p - 1) * (z ^ k * G z) := by rw [hz_mul]
        _ = (z ^ (((p - 1 : ℕ) : ℤ)) * z ^ k) * G z := by rw [zpow_natCast, mul_assoc]
        _ = z ^ d * G z := by rw [← zpow_add₀ hz0]
    have hG_lim : Filter.Tendsto G (nhdsWithin 0 {0}ᶜ) (nhds (G 0)) :=
      hG_cont.tendsto.mono_left nhdsWithin_le_nhds
    rcases lt_trichotomy d 0 with hd_neg | hd_zero | hd_pos
    · obtain ⟨n, hn⟩ := Int.eq_ofNat_of_zero_le (le_of_lt (neg_pos.mpr hd_neg))
      have hn_ne : n ≠ 0 := by omega
      have hk_ne : k ≠ 0 := by omega
      have hG0_ne : G 0 ≠ 0 := by
        rw [hG0]
        exact mul_ne_zero (Int.cast_ne_zero.mpr hk_ne) hh0_ne
      have hMulEq : (fun z : ℂ => z ^ n * (z ^ p * deriv F z)) =ᶠ[nhdsWithin 0 {0}ᶜ] G := by
        refine Filter.eventually_of_mem hV_mem (fun z hz => ?_)
        dsimp only
        have hz0 : z ≠ 0 := hz.2
        rw [hEqV z hz]
        have hd_eq : d = -(n : ℤ) := by omega
        rw [hd_eq, ← zpow_natCast, ← mul_assoc, ← zpow_add₀ hz0, add_neg_cancel, zpow_zero, one_mul]
      have hzn_lim : Filter.Tendsto (fun z : ℂ => z ^ n) (nhdsWithin 0 {0}ᶜ) (nhds 0) := by
        have h0 := ((continuous_pow n).continuousAt (x := (0 : ℂ))).tendsto.mono_left
          (nhdsWithin_le_nhds (s := {(0 : ℂ)}ᶜ))
