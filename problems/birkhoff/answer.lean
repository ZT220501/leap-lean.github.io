          IsBoundedStripExt (m + 15) σ M w W →
          z - (τ : ℂ) * H₀ ∈ horizStrip σ →
          z + ((1 - τ : ℝ) : ℂ) * H₀ ∈ horizStrip σ →
          ContinuousOn c_fn (Set.Icc (0 : ℝ) 1) →
          (∀ t ∈ Set.Icc (0 : ℝ) 1, c_fn t ∈ Set.Icc (-τ) (1 - τ)) →
          ContinuousOn (fun t => skrSlopeW W z (c_fn t) H₀) (Set.Icc (0 : ℝ) 1)) := by
    let B_sl : ℝ := M * skrCompConst m 2
    let L_sl : ℝ := skrCompConst m 2 * (1 + (2 : ℝ) ^ m * M)
    have hBsl_nn : 0 ≤ B_sl := mul_nonneg (le_of_lt hM) (hCompConstNonneg m 2)
    have hLsl_nn : 0 ≤ L_sl :=
      mul_nonneg (hCompConstNonneg m 2) (by positivity)
    refine ⟨B_sl, L_sl, hBsl_nn, hLsl_nn, ?_, ?_⟩
    · intro σ σ' τ c ΔH w₁ w₂ W₁ W₂ H₁ H₂ hσ hσ' _ hΔH hτ hc hW₁ hW₂ hH₁ hH₂ hSeg hHdiff
      have hOpenσ := (hCalc.horizStrip_open_convex σ).1
      have hConvσ := (hCalc.horizStrip_open_convex σ).2
      have hdW₁ := hCalc.stripExt_deriv_props (m + 15) 1 σ M w₁ W₁ hσ hW₁ (by omega)
      have hdW₂ := hCalc.stripExt_deriv_props (m + 15) 1 σ M w₂ W₂ hσ hW₂ (by omega)
      rw [iteratedDeriv_one] at hdW₁ hdW₂
      obtain ⟨hΔW_nn, hdW_diff⟩ :=
        hCalc.stripDiffSup_nonneg_and_le (m + 15) σ M w₁ w₂ W₁ W₂ hσ hW₁ hW₂
      let ΔW := stripDiffSup (m + 15) σ W₁ W₂
      let Δ := ΔH + ΔW
      have hΔ_nn : 0 ≤ Δ := add_nonneg hΔH hΔW_nn
      have hc_abs : |c| ≤ 1 := (hTauSeg hτ hc ⟨le_rfl, zero_le_one⟩).1
      have hEtaPair : ∀ η ∈ Set.Icc (0 : ℝ) 1,
          PairBnd σ' Δ B_sl L_sl
            (fun z => deriv W₁ (z + ((η * c : ℝ) : ℂ) * H₁ z))
            (fun z => deriv W₂ (z + ((η * c : ℝ) : ℂ) * H₂ z)) := by
        intro η hη
        obtain ⟨_, hηc_mem, hηc_abs⟩ := hTauSeg hτ hc hη
        obtain ⟨hf1_holo, hf1_der⟩ := hShiftDerivLe hηc_abs hH₁
        obtain ⟨hf2_holo, hf2_der⟩ := hShiftDerivLe hηc_abs hH₂
        have hf1_map : ∀ z ∈ horizStrip σ', z + ((η * c : ℝ) : ℂ) * H₁ z ∈ horizStrip σ :=
          fun z hz => hCalc.mem_horizStrip_of_tau_seg σ τ (η * c) z (H₁ z) hτ hηc_mem
            (hSeg z hz).1 (hSeg z hz).2.1
        have hf2_map : ∀ z ∈ horizStrip σ', z + ((η * c : ℝ) : ℂ) * H₂ z ∈ horizStrip σ :=
          fun z hz => hCalc.mem_horizStrip_of_tau_seg σ τ (η * c) z (H₂ z) hτ hηc_mem
            (hSeg z hz).2.2.1 (hSeg z hz).2.2.2
        have h1 := hCalc.comp_bnd m σ' M 2 (horizStrip σ) (deriv W₁)
          (fun z => z + ((η * c : ℝ) : ℂ) * H₁ z) hOpenσ (le_of_lt hM) (by norm_num)
          hdW₁.1 (fun j hj w hw => hdW₁.2 j (by omega) w hw) hf1_holo hf1_map hf1_der
        have h2 := hCalc.comp_bnd m σ' M 2 (horizStrip σ) (deriv W₂)
          (fun z => z + ((η * c : ℝ) : ℂ) * H₂ z) hOpenσ (le_of_lt hM) (by norm_num)
          hdW₂.1 (fun j hj w hw => hdW₂.2 j (by omega) w hw) hf2_holo hf2_map hf2_der
        have hf_diff : IsSkrStripBnd m σ' ΔH
            (fun z => (z + ((η * c : ℝ) : ℂ) * H₁ z) - (z + ((η * c : ℝ) : ℂ) * H₂ z)) := by
