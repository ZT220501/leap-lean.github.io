            (fun z => Complex.exp (2 * W₁ z)) (fun z => Complex.exp (2 * W₂ z)) := by
    let R_W : ℝ := 2 * M + 1
    have hRW_pos : 0 < R_W := by linarith
    let B_eW1 : ℝ := Real.exp R_W * skrCompConst m M
    let L_eW1 : ℝ := skrCompConst m M * ((2 : ℝ) ^ m * Real.exp R_W)
    let B_eW2 : ℝ := Real.exp R_W * skrCompConst m (2 * M)
    let L_eW2 : ℝ := skrCompConst m (2 * M) * ((2 : ℝ) ^ m * Real.exp R_W * 2)
    refine ⟨B_eW1, L_eW1, B_eW2, L_eW2,
      mul_nonneg (Real.exp_nonneg _) (hCompConstNonneg m M),
      mul_nonneg (hCompConstNonneg m M) (by positivity),
      mul_nonneg (Real.exp_nonneg _) (hCompConstNonneg m (2 * M)),
      mul_nonneg (hCompConstNonneg m (2 * M)) (by positivity), ?_⟩
    intro σ σ' ΔH w₁ w₂ W₁ W₂ hσ _ hσ'σ hΔH hW₁ hW₂
    have hSub := hStripSub hσ'σ
    obtain ⟨hΔW_nn, hdW_diff⟩ :=
      hCalc.stripDiffSup_nonneg_and_le (m + 15) σ M w₁ w₂ W₁ W₂ hσ hW₁ hW₂
    let ΔW := stripDiffSup (m + 15) σ W₁ W₂
    let Δ := ΔH + ΔW
    have hΔ_nn : 0 ≤ Δ := add_nonneg hΔH hΔW_nn
    have hW1_bnd : IsSkrStripBnd m σ' M W₁ :=
      ⟨hW₁.1.mono hSub, fun k hk z hz => hW₁.2.2.2.2 k (by omega) z (hSub hz)⟩
    have hW2_bnd : IsSkrStripBnd m σ' M W₂ :=
      ⟨hW₂.1.mono hSub, fun k hk z hz => hW₂.2.2.2.2 k (by omega) z (hSub hz)⟩
    have hWdiff_bnd : IsSkrStripBnd m σ' Δ (fun z => W₁ z - W₂ z) := by
      refine hCalc.bnd_mono (by linarith : ΔW ≤ Δ) ⟨hW1_bnd.1.sub hW2_bnd.1, ?_⟩
      intro k hk z hz
      simpa [iteratedDeriv_zero] using hdW_diff k 0 (by omega) z (hSub hz)
    let V_W := Metric.ball (0 : ℂ) R_W
    have hExpBall := hCalc.exp_ball_bnd R_W hRW_pos
    have h1 := hCalc.comp_bnd m σ' (Real.exp R_W) M V_W Complex.exp W₁
      Metric.isOpen_ball (Real.exp_nonneg _) (le_of_lt hM) hExpBall.1
      (fun j _ w hw => hExpBall.2 j w hw) hW1_bnd.1
      (fun z hz => Metric.mem_ball.mpr (by rw [dist_zero_right]; linarith [hBndPt hW1_bnd z hz]))
      (fun j _ hjm z hz => hW1_bnd.2 j hjm z hz)
    have h2 := hCalc.comp_bnd m σ' (Real.exp R_W) M V_W Complex.exp W₂
      Metric.isOpen_ball (Real.exp_nonneg _) (le_of_lt hM) hExpBall.1
      (fun j _ w hw => hExpBall.2 j w hw) hW2_bnd.1
      (fun z hz => Metric.mem_ball.mpr (by rw [dist_zero_right]; linarith [hBndPt hW2_bnd z hz]))
      (fun j _ hjm z hz => hW2_bnd.2 j hjm z hz)
    have hDiff1 := hCalc.comp_diff_bnd m σ' (Real.exp R_W) 0 M Δ V_W
      Complex.exp Complex.exp W₁ W₂
      Metric.isOpen_ball (convex_ball 0 R_W) (Real.exp_nonneg _) le_rfl (le_of_lt hM) hΔ_nn
      hExpBall.1 hExpBall.1 (fun j _ _ _ => by simp [sub_self])
      (fun j _ w hw => hExpBall.2 j w hw) hW1_bnd.1 hW2_bnd.1
      (fun z hz => Metric.mem_ball.mpr (by rw [dist_zero_right]; linarith [hBndPt hW1_bnd z hz]))
      (fun z hz => Metric.mem_ball.mpr (by rw [dist_zero_right]; linarith [hBndPt hW2_bnd z hz]))
      (fun j _ hjm z hz => hW1_bnd.2 j hjm z hz)
      (fun j _ hjm z hz => hW2_bnd.2 j hjm z hz)
      hWdiff_bnd
    have hL1_eq : skrCompConst m M * (0 + (2 : ℝ) ^ m * Real.exp R_W * Δ) = L_eW1 * Δ := by
      dsimp [L_eW1]; ring
    rw [hL1_eq] at hDiff1
    have h2W1_bnd : IsSkrStripBnd m σ' (2 * M) (fun z => 2 * W₁ z) := by
      simpa [ Complex.norm_ofNat ] using hCalc.bnd_const_mul (2 : ℂ) (le_of_lt hM) hW1_bnd
    have h2W2_bnd : IsSkrStripBnd m σ' (2 * M) (fun z => 2 * W₂ z) := by
      simpa [ Complex.norm_ofNat ] using hCalc.bnd_const_mul (2 : ℂ) (le_of_lt hM) hW2_bnd
    have h2Wdiff : IsSkrStripBnd m σ' (2 * Δ) (fun z => 2 * W₁ z - 2 * W₂ z) := by
