      F_holo := G.F_holo.mono S_m.W_ψ_sub_W_F
      g := S_m.g
      g_holo := S_m.g_holo
      g_endpoints := S_m.g_endpoints
      g_lt_p := fun r l hl z _ => S_m.g_lt_p r l hl z
      g_at_p := fun r _ => congr_fun (hg_m r) (a : ℂ)
      U_split := S_m.U_split
      V_split := S_m.V_split
      UV_holo := S_m.UV_holo
      δ₀ := δ₀
      δ₀_pos := hδ₀_pos
      x₀ := fun δ r => G.x_fn r ((a : ℂ), (δ : ℂ))
      ℓ₀ := fun δ i => G.ℓ_fn i ((a : ℂ), (δ : ℂ))
      β := fun l δ r => S_m.β l r ((a : ℂ), (δ : ℂ))
      β_zero := fun δ r => S_m.β_zero r ((a : ℂ), (δ : ℂ))
      x₀_endpoints := fun δ hδ =>
        G.x_endpoints ((a : ℂ), (δ : ℂ)) (S_m.V_plus_sub (h_mem_V δ hδ))
      β_endpoints := fun l δ => S_m.β_endpoints l ((a : ℂ), (δ : ℂ))
      x₀_real := fun δ hδ r => (G.trapezoid_nondeg (a, δ) (h_trap δ hδ)).2.2.2.2.1 r
      x₀_tendsto := by
        intro r
        have ha0_U₀ : ((a : ℂ), (0 : ℂ)) ∈ U₀ := by
          refine ⟨?_, ?_⟩
          · rw [PointGlancingChartData.U_a, Metric.mem_ball, Complex.dist_eq,
