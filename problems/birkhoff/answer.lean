          nlinarith
  have hY_eq_Z_of_A : ∀ k (w : ℕ → ℝ), A_surv k w → Y_stop k w = Z_mart k w := by
    intro k w hAk
    apply Finset.sum_congr rfl
    intro j hj
    have hj_le : j ≤ k := le_of_lt (Finset.mem_range.mp hj)
    have hAj : A_surv j w := fun i hi =>
      hAk i (Finset.mem_range.mpr (lt_of_lt_of_le (Finset.mem_range.mp hi) (Nat.succ_le_succ hj_le)))
    simp [hAj]
  
  have hClaim3A : ∀ n ≤ M, ∀ w : ℕ → ℝ, C_pred n w → Z_mart n w < g n (w n) - R := by
    intro n hn w
    induction n with
    | zero =>
      intro hC0
      have hg0 : R < g 0 (w 0) := by
        by_contra h_not_gt
        have hle : g 0 (w 0) ≤ R := le_of_not_gt h_not_gt
        apply hC0
        intro k hk
        have hk0 : k = 0 := by have := Finset.mem_range.mp hk; omega
        subst hk0; exact hle
      simp only [Z_mart, Finset.range_zero, Finset.sum_empty]
      linarith
    | succ n ih =>
      intro hCn1
      rw [show Z_mart (n + 1) w = Z_mart n w + ξ_inc n w from Finset.sum_range_succ _ n]
      by_cases hCn : C_pred n w
      · have h_ih := ih (by omega) hCn
        have h_xi : ξ_inc n w = g (n + 1) (w (n + 1)) - g_bar n (w n) := by simp [ξ_inc, hCn]
        have h_le : g n (w n) ≤ g_bar n (w n) := h_sub n (by omega) (w n)
        linarith
      · have hEn : E_pred n w := not_not.mp hCn
        have hZn_zero : Z_mart n w = 0 := by
          apply Finset.sum_eq_zero; intro j hj
          have hEj : E_pred j w := fun k hk =>
            hEn k (Finset.mem_range.mpr (lt_trans (Finset.mem_range.mp hk)
              (Nat.succ_lt_succ (Finset.mem_range.mp hj))))
          have h_not_Cj : ¬ C_pred j w := not_not.mpr hEj
          simp [ξ_inc, h_not_Cj]
        have hxi_zero : ξ_inc n w = 0 := by simp [ξ_inc, hCn]
        have h_gt_R : R < g (n + 1) (w (n + 1)) := by
          by_contra h_not_gt
          have h_le_R : g (n + 1) (w (n + 1)) ≤ R := le_of_not_gt h_not_gt
          apply hCn1
          intro k hk
          rcases Nat.lt_succ_iff_lt_or_eq.mp (Finset.mem_range.mp hk) with hlt | rfl
          · exact hEn k (Finset.mem_range.mpr hlt)
          · exact h_le_R
        linarith
  
  have hClaim3B : ∀ k : ℕ, ∀ w : ℕ → ℝ, ¬ A_surv k w → Y_stop k w ≤ -(R - h) := by
    intro k w
    induction k with
    | zero =>
      intro hA0
      exfalso; apply hA0
      intro i hi
      have hi0 : i = 0 := by have := Finset.mem_range.mp hi; omega
      subst hi0
      simp only [Z_mart, Finset.range_zero, Finset.sum_empty]
      linarith
    | succ k ih =>
      intro hAk1
      rw [show Y_stop (k + 1) w = Y_stop k w + (if A_surv k w then ξ_inc k w else 0) from
        Finset.sum_range_succ _ k]
      by_cases hAk : A_surv k w
      · have h_ite : (if A_surv k w then ξ_inc k w else 0) = ξ_inc k w := by simp [hAk]
        rw [hY_eq_Z_of_A k w hAk, h_ite, ← Finset.sum_range_succ _ k]
        change Z_mart (k + 1) w ≤ -(R - h)
        by_contra h_not_le
        have h_gt : -(R - h) < Z_mart (k + 1) w := lt_of_not_ge h_not_le
        apply hAk1
        intro i hi
        rcases Nat.lt_succ_iff_lt_or_eq.mp (Finset.mem_range.mp hi) with hlt | rfl
        · exact hAk i (Finset.mem_range.mpr hlt)
        · exact h_gt
      · have h_ite : (if A_surv k w then ξ_inc k w else 0) = 0 := by simp [hAk]
        rw [h_ite, add_zero]
        exact ih hAk
  
  have hPostDom : ∀ w : ℕ → ℝ,
