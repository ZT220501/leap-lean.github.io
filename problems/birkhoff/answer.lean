      have : 0 < b_rec ^ α := Real.rpow_pos_of_pos hb_rec_pos α
      nlinarith
    calc 2 * T₀ * C_core.C_A * b_rec ^ α
        ≤ 2 * T₀ * C_core.C_A * η_R1 := mul_le_mul_of_nonneg_left h5 (by positivity)
      _ = A.η_SL / 4 := by
          dsimp [η_R1]
          field_simp [hT₀.ne', hCA_pos.ne']
  have hb_rec_R2 : 4 * T₀ ^ 2 * C_core.C_A ^ 2 * b_rec ^ (2 * α) ≤ min (A.η_SL / 4) 2 := by
    have h1 : 2 / η_R2 ≤ D_rec :=
