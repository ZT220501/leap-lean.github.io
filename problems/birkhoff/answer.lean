theorem patch_local_recurrence_and_slab (Ω : Set Plane)
    (C : AnalyticGlancingCollar Ω)
    (hDet : EndpointDeterminationData C)
    (W : CollarWidthTubeData C hDet)
    (H₀ : ℝ)
    (hHX : W.h_X 0 = ENNReal.ofReal H₀)
    (Z₀ : ZeroSliceExtractedData W)
    (x_star sgn ε : ℝ)
    (hsgn : sgn = 1 ∨ sgn = -1)
    (hε : 0 < ε)
    (g : Fin 2 → ℂ → ℂ)
    (hg0 : MeromorphicOn (g 0)
      (Metric.ball ((x_star : ℂ) + ((sgn * H₀ : ℝ) : ℂ) * Complex.I) ε))
    (hg1 : MeromorphicOn (g 1)
      (Metric.ball ((x_star : ℂ) + ((sgn * H₀ : ℝ) : ℂ) * Complex.I) ε))
    (V_overlap : Set ℂ)
    (hVopen : IsOpen V_overlap)
    (hVne : V_overlap.Nonempty)
    (hVsub : V_overlap ⊆
      Metric.ball ((x_star : ℂ) + ((sgn * H₀ : ℝ) : ℂ) * Complex.I) ε ∩ horizStrip H₀)
    (hg_eq : ∀ i : Fin 2, ∀ z ∈ V_overlap, g i z = Z₀.Γ_slice z i) :
    Nonempty (LocalPatchSlabData W H₀) :=
by
  obtain ⟨B_cramer⟩ := base_collar_and_cramer_data Ω C
  obtain ⟨E⟩ :=
    regular_edge_lazutkin_chart Ω C hDet W H₀ hHX Z₀ x_star sgn ε hsgn hε
      g hg0 hg1 V_overlap hVopen hVne hVsub hg_eq
  obtain ⟨S_rec⟩ :=
    cubic_step_successor_and_dual_line Ω C B_cramer
      ((E.x_edge : ℂ) + (H₀ : ℂ) * Complex.I) E.R_0 E.R_0_pos
      E.ϕ_loc E.h_loc E.U_θ E.U_θ_open E.ϕ_loc_holo E.ϕ_deriv_ne_zero
      E.ϕ_maps_to E.h_loc_holo E.h_loc_ne_zero E.lazutkin_ode
  obtain ⟨H_slab⟩ :=
    collar_cylinder_billiard_identities Ω C hDet B_cramer W H₀ hHX Z₀
      E.x_edge E.R_0 E.R_0_pos E.R_0_lt
  obtain ⟨A_br⟩ :=
    slab_angle_and_recurrence_bridge Ω C hDet B_cramer W H₀ hHX Z₀ E S_rec H_slab
  exact ⟨{
    x_edge := E.x_edge
    R_0 := E.R_0
    y_row := H_slab.y_row
    δ_slab := H_slab.δ_slab
    δ_t := A_br.δ_t
    δ_rec := S_rec.δ_rec
    C_rec := S_rec.C_rec
    C_init := A_br.C_init
    H₀_ge := E.H₀_ge
    R_0_pos := E.R_0_pos
    R_0_lt := E.R_0_lt
    y_row_bounds := H_slab.y_row_bounds
    δ_slab_pos := H_slab.δ_slab_pos
    δ_slab_lt_R := by linarith [H_slab.δ_slab_lt_R, E.R_0_pos]
    δ_slab_lt_gap := by linarith [H_slab.δ_slab_lt_gap, H_slab.δ_slab_pos]
    δ_t_pos := A_br.δ_t_pos
    δ_rec_pos := S_rec.δ_rec_pos
    C_rec_pos := S_rec.C_rec_pos
    C_init_pos := A_br.C_init_pos
    G_succ := S_rec.G_succ
    L_line := S_rec.L_line
    V_slab := A_br.V_slab
    G_succ_holo := S_rec.G_succ_holo
    G_succ_cubic := S_rec.G_succ_cubic
    L_line_holo := S_rec.L_line_holo
    V_slab_holo := A_br.V_slab_holo
    V_slab_quad := A_br.V_slab_quad
    slab_recurrence := A_br.slab_recurrence
    slab_agrees_L := A_br.slab_agrees_L
    L_mero_even := H_slab.L_mero_even
  }⟩

theorem steep_sector_dual_line_propagation (Ω : Set Plane)
    (C : AnalyticGlancingCollar Ω)
    (hDet : EndpointDeterminationData C)
    (W : CollarWidthTubeData C hDet)
    (H₀ : ℝ)
    (hHX : W.h_X 0 = ENNReal.ofReal H₀)
    (P : LocalPatchSlabData W H₀) :
    Nonempty (SteepCorridorDualLineData W H₀ P.x_edge P.R_0 P.y_row P.δ_slab) :=
by
  classical
  
  let x_edge := P.x_edge
  let R_0 := P.R_0
  let y_row := P.y_row
  let δ_slab := P.δ_slab
  let δ_t := P.δ_t
  let δ_rec := P.δ_rec
  let C_rec := P.C_rec
  let C_init := P.C_init
  let s_edge : ℂ := (x_edge : ℂ) + (H₀ : ℂ) * Complex.I
  let M_step : ℝ := 4 * (C_init + C_rec * R_0)
  have hCR_pos : 0 < C_init + C_rec * R_0 := by
    nlinarith [P.C_init_pos, P.C_rec_pos, P.R_0_pos]
  have hM_step_pos : 0 < M_step := by
    dsimp [M_step]; linarith
  have h16_pos : 0 < 16 * (C_init + C_rec * R_0) := by linarith
  let r_steep : ℝ :=
    min W.r_base
      (min (δ_slab / 4)
        (min (δ_t / 2)
          (min (R_0 / 8)
            (min (δ_rec / 2)
              ((16 * (C_init + C_rec * R_0))⁻¹)))))
  have hr_steep_pos : 0 < r_steep := by
    refine lt_min W.r_base_pos (lt_min (by linarith [P.δ_slab_pos])
      (lt_min (by linarith [P.δ_t_pos]) (lt_min (by linarith [P.R_0_pos])
        (lt_min (by linarith [P.δ_rec_pos]) (inv_pos.mpr h16_pos)))))
  have hr_le_base : r_steep ≤ W.r_base := min_le_left _ _
  have hr_le_slab : r_steep ≤ δ_slab / 4 := le_trans (min_le_right _ _) (min_le_left _ _)
  have hr_le_dt : r_steep ≤ δ_t / 2 :=
    le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_left _ _))
  have hr_le_R : r_steep ≤ R_0 / 8 :=
    le_trans (min_le_right _ _)
      (le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_left _ _)))
  have hr_le_drec : r_steep ≤ δ_rec / 2 :=
    le_trans (min_le_right _ _)
      (le_trans (min_le_right _ _)
        (le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_left _ _))))
  have hr_le_inv : r_steep ≤ (16 * (C_init + C_rec * R_0))⁻¹ :=
    le_trans (min_le_right _ _)
      (le_trans (min_le_right _ _)
        (le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_right _ _))))
  have ht_prod_lt : ∀ t : ℂ, ‖t‖ < r_steep →
      16 * (C_init + C_rec * R_0) * ‖t‖ < 1 ∧ M_step * ‖t‖ < 1 / 4 ∧ C_init * ‖t‖ < 1 / 16 := by
    intro t ht
    have h1 : ‖t‖ < (16 * (C_init + C_rec * R_0))⁻¹ := lt_of_lt_of_le ht hr_le_inv
    have h2 : 16 * (C_init + C_rec * R_0) * ‖t‖ <
        16 * (C_init + C_rec * R_0) * (16 * (C_init + C_rec * R_0))⁻¹ :=
      mul_lt_mul_of_pos_left h1 h16_pos
    rw [mul_inv_cancel₀ (ne_of_gt h16_pos)] at h2
    have hCR_nonneg : 0 ≤ C_rec * R_0 * ‖t‖ :=
      mul_nonneg (mul_nonneg (le_of_lt P.C_rec_pos) (le_of_lt P.R_0_pos)) (norm_nonneg t)
    exact ⟨h2, by dsimp [M_step]; linarith, by linarith⟩

  
  let K_cor : Set ℂ := steepCorridorY x_edge H₀ R_0 y_row δ_slab
  let C_plus : Set ℂ := { t : ℂ | 0 < ‖t‖ ∧ ‖t‖ < r_steep ∧ ‖t‖ / 3 < t.im }
  let Ω_N : ℕ → Set (ℂ × ℂ) := fun N =>
    { p : ℂ × ℂ |
      p.1 ∈ K_cor ∧
      p.2 ∈ C_plus ∧
      |(p.1 - (N : ℂ) * p.2).im - y_row| < (3 / 4 : ℝ) * δ_slab }
  let w_node : ℕ → ℕ → ℂ × ℂ → ℂ := fun N j p =>
    p.1 - (N : ℂ) * p.2 + (j : ℂ) * p.2
  let stepMap : ℂ × ℂ → ℂ × ℂ := fun uv =>
    (uv.2, uv.2 + P.G_succ (uv.2, uv.2 - uv.1))
  let pairIter : ℕ → ℕ → ℂ × ℂ → ℂ × ℂ := fun N k p =>
    stepMap^[k] (P.V_slab (w_node N 0 p, p.2), P.V_slab (w_node N 1 p, p.2))
  let Λ_N : ℕ → Fin 2 → ℂ × ℂ → ℂ := fun N i p =>
    P.L_line i ((pairIter N N p).1, (pairIter N N p).2 - (pairIter N N p).1)

  have hK_open : IsOpen K_cor := by
    refine (isOpen_lt (continuous_abs.comp (Complex.continuous_re.sub continuous_const))
      continuous_const).inter ?_
    exact (isOpen_lt continuous_const Complex.continuous_im).inter
      (isOpen_lt Complex.continuous_im continuous_const)
  have hC_plus_open : IsOpen C_plus := by
    refine (isOpen_lt continuous_const continuous_norm).inter ?_
    exact (isOpen_lt continuous_norm continuous_const).inter
      (isOpen_lt (continuous_norm.div_const 3) Complex.continuous_im)
  have hΩ_open : ∀ N : ℕ, IsOpen (Ω_N N) := by
    intro N
    have hcont : Continuous (fun p : ℂ × ℂ => |(p.1 - (N : ℂ) * p.2).im - y_row|) :=
      continuous_abs.comp
        ((Complex.continuous_im.comp (continuous_fst.sub (continuous_const.mul continuous_snd))).sub
          continuous_const)
    exact (hK_open.preimage continuous_fst).inter
      ((hC_plus_open.preimage continuous_snd).inter (isOpen_lt hcont continuous_const))

  have hs_edge_re : s_edge.re = x_edge := by simp [s_edge]
  have hs_edge_im : s_edge.im = H₀ := by simp [s_edge]
  have hw_re : ∀ N j : ℕ, ∀ p : ℂ × ℂ,
      (w_node N j p).re = p.1.re - (N : ℝ) * p.2.re + (j : ℝ) * p.2.re := by
    intro N j p; simp [w_node]
  have hw_im : ∀ N j : ℕ, ∀ p : ℂ × ℂ,
      (w_node N j p).im = p.1.im - (N : ℝ) * p.2.im + (j : ℝ) * p.2.im := by
    intro N j p; simp [w_node]
  have hshift_im : ∀ N : ℕ, ∀ p : ℂ × ℂ,
      (p.1 - (N : ℂ) * p.2).im = p.1.im - (N : ℝ) * p.2.im := by
    intro N p; simp

  
  have hStepBudget : ∀ N : ℕ, ∀ p ∈ Ω_N N, (N : ℝ) * ‖p.2‖ < (3 / 8 : ℝ) * R_0 := by
    intro N p hp
    rcases hp with ⟨⟨_, _, hy_hi⟩, ⟨_, _, ht_steep⟩, hrow⟩
    rw [hshift_im] at hrow
    have hrow_lo : y_row - (3 / 4 : ℝ) * δ_slab < p.1.im - (N : ℝ) * p.2.im := by
      linarith [(abs_lt.mp hrow).1]
    have hNim : (N : ℝ) * p.2.im < (1 / 8 : ℝ) * R_0 := by
      linarith [P.y_row_bounds.1, P.δ_slab_lt_R]
    have hN_nonneg : (0 : ℝ) ≤ (N : ℝ) := Nat.cast_nonneg N
    nlinarith

  
  have hw_ball : ∀ N j : ℕ, j ≤ N + 1 → ∀ p ∈ Ω_N N,
      ‖w_node N j p - s_edge‖ < (3 / 4 : ℝ) * R_0 := by
    intro N j hj p hp
    have hN_norm : (N : ℝ) * ‖p.2‖ < (3 / 8 : ℝ) * R_0 := hStepBudget N p hp
    rcases hp with ⟨⟨hy_re, _, hy_hi⟩, ⟨_, ht_lt, ht_steep⟩, hrow⟩
    rw [hshift_im] at hrow
    have ht_R : ‖p.2‖ < R_0 / 8 := lt_of_lt_of_le ht_lt hr_le_R
    have ht_im_pos : 0 < p.2.im := by linarith [norm_nonneg p.2]
    have ht_re_le : |p.2.re| ≤ ‖p.2‖ := Complex.abs_re_le_norm p.2
    have ht_im_le : |p.2.im| ≤ ‖p.2‖ := Complex.abs_im_le_norm p.2
    have hj_diff : |((j : ℝ) - (N : ℝ)) * p.2.re| < (3 / 8 : ℝ) * R_0 := by
      rw [abs_mul]
      by_cases hjN : j ≤ N
      · have hjN_R : (j : ℝ) ≤ (N : ℝ) := Nat.cast_le.mpr hjN
        have hj_nonneg : (0 : ℝ) ≤ (j : ℝ) := Nat.cast_nonneg j
        rw [abs_of_nonpos (by linarith)]
        nlinarith [norm_nonneg p.2]
      · have hj_eq : j = N + 1 := by omega
        subst hj_eq
        push_cast
        have h1 : |(N : ℝ) + 1 - (N : ℝ)| = 1 := by ring_nf; exact abs_one
        rw [h1, one_mul]
        linarith
    have hre_bound : |(w_node N j p - s_edge).re| < R_0 / 2 := by
      have h_eq : (w_node N j p - s_edge).re =
          (p.1.re - x_edge) + ((j : ℝ) - (N : ℝ)) * p.2.re := by
        rw [Complex.sub_re, hw_re, hs_edge_re]; ring
      rw [h_eq]
      linarith [abs_add_le (p.1.re - x_edge) (((j : ℝ) - (N : ℝ)) * p.2.re)]
    have him_bound : |(w_node N j p - s_edge).im| < (3 / 16 : ℝ) * R_0 := by
      have h_eq : (w_node N j p - s_edge).im =
          (p.1.im - (N : ℝ) * p.2.im + (j : ℝ) * p.2.im) - H₀ := by
        rw [Complex.sub_im, hw_im, hs_edge_im]
      rw [h_eq, abs_lt]
      have hj_nonneg : (0 : ℝ) ≤ (j : ℝ) := Nat.cast_nonneg j
      have hj_le : (j : ℝ) ≤ (N : ℝ) + 1 := by exact_mod_cast hj
      have hj_im_lo : 0 ≤ (j : ℝ) * p.2.im := mul_nonneg hj_nonneg (le_of_lt ht_im_pos)
      have hj_im_hi : (j : ℝ) * p.2.im ≤ ((N : ℝ) + 1) * p.2.im :=
        mul_le_mul_of_nonneg_right hj_le (le_of_lt ht_im_pos)
      have hrow_lo := (abs_lt.mp hrow).1
      have ht_im_hi : p.2.im ≤ ‖p.2‖ := le_trans (le_abs_self _) ht_im_le
      constructor <;> linarith [P.y_row_bounds.1, P.δ_slab_lt_R]
    have hnorm := Complex.norm_le_abs_re_add_abs_im (w_node N j p - s_edge)
    linarith

  
  have hw0_slab : ∀ N : ℕ, ∀ p ∈ Ω_N N,
      (w_node N 0 p, p.2) ∈ slabBox x_edge R_0 y_row δ_slab δ_t := by
    intro N p hp
    have hN_norm : (N : ℝ) * ‖p.2‖ < (3 / 8 : ℝ) * R_0 := hStepBudget N p hp
    rcases hp with ⟨⟨hy_re, _, _⟩, ⟨_, ht_lt, _⟩, hrow⟩
    rw [hshift_im] at hrow
    have ht_dt : ‖p.2‖ < δ_t / 2 := lt_of_lt_of_le ht_lt hr_le_dt
    have ht_re_le : |p.2.re| ≤ ‖p.2‖ := Complex.abs_re_le_norm p.2
    have hN_nonneg : (0 : ℝ) ≤ (N : ℝ) := Nat.cast_nonneg N
    have hN_re : |(N : ℝ) * p.2.re| < (3 / 8 : ℝ) * R_0 := by
      rw [abs_mul, abs_of_nonneg hN_nonneg]
      nlinarith [norm_nonneg p.2]
    refine ⟨?_, ?_, by linarith [P.δ_t_pos]⟩
    · have h_eq : (w_node N 0 p).re - x_edge = (p.1.re - x_edge) - (N : ℝ) * p.2.re := by
        rw [hw_re]; simp; ring
      rw [h_eq]
      linarith [abs_sub (p.1.re - x_edge) ((N : ℝ) * p.2.re), P.δ_slab_pos]
    · have h_eq : (w_node N 0 p).im - y_row = (p.1.im - (N : ℝ) * p.2.im) - y_row := by
        rw [hw_im]; simp
      rw [h_eq]
      linarith [P.δ_slab_pos]

  have hw1_slab : ∀ N : ℕ, ∀ p ∈ Ω_N N,
      (w_node N 1 p, p.2) ∈ slabBox x_edge R_0 y_row δ_slab δ_t := by
    intro N p hp
    obtain ⟨h0_re, h0_im, h0_t⟩ := hw0_slab N p hp
    have ht_lt : ‖p.2‖ < r_steep := hp.2.1.2.1
    have ht_slab : ‖p.2‖ < δ_slab / 4 := lt_of_lt_of_le ht_lt hr_le_slab
    have ht_im_le : |p.2.im| ≤ ‖p.2‖ := Complex.abs_im_le_norm p.2
    have hN_norm : (N : ℝ) * ‖p.2‖ < (3 / 8 : ℝ) * R_0 := hStepBudget N p hp
    have ht_R : ‖p.2‖ < R_0 / 8 := lt_of_lt_of_le ht_lt hr_le_R
    have ht_re_le : |p.2.re| ≤ ‖p.2‖ := Complex.abs_re_le_norm p.2
    refine ⟨?_, ?_, h0_t⟩
    · have h1_diff : |((1 : ℝ) - (N : ℝ)) * p.2.re| < (3 / 8 : ℝ) * R_0 := by
        rw [abs_mul]
        by_cases hN1 : 1 ≤ N
        · have hN1_R : (1 : ℝ) ≤ (N : ℝ) := by exact_mod_cast hN1
          rw [abs_of_nonpos (by linarith)]
          nlinarith [norm_nonneg p.2]
        · have hN0 : N = 0 := by omega
          subst hN0; simp
          linarith
      have h_eq : (w_node N 1 p).re - x_edge =
          (p.1.re - x_edge) + ((1 : ℝ) - (N : ℝ)) * p.2.re := by
        rw [hw_re]; simp; ring
      rw [h_eq]
      linarith [abs_add_le (p.1.re - x_edge) (((1 : ℝ) - (N : ℝ)) * p.2.re),
        hp.1.1, P.δ_slab_pos]
    · have h_eq : (w_node N 1 p).im - y_row = ((w_node N 0 p).im - y_row) + p.2.im := by
        rw [hw_im, hw_im]; simp; ring
      rw [h_eq]
      have h0_im' : |(w_node N 0 p).im - y_row| < (3 / 4 : ℝ) * δ_slab := by
        have h_eq0 : (w_node N 0 p).im - y_row = (p.1 - (N : ℂ) * p.2).im - y_row := by
          rw [hw_im, hshift_im]; simp
        rw [h_eq0]; exact hp.2.2
      linarith [abs_add_le ((w_node N 0 p).im - y_row) p.2.im, P.δ_slab_pos]

  
  have hPosInBall : ∀ N m : ℕ, m ≤ N → ∀ p ∈ Ω_N N, ∀ z : ℂ,
      ‖z - w_node N m p‖ ≤ (C_init + (m : ℝ) * M_step) * ‖p.2‖ ^ 2 →
      z ∈ Metric.ball s_edge R_0 := by
    intro N m hm p hp z hz
    have hN_norm : (N : ℝ) * ‖p.2‖ < (3 / 8 : ℝ) * R_0 := hStepBudget N p hp
    have hm_le : (m : ℝ) ≤ (N : ℝ) := Nat.cast_le.mpr hm
    have hm_norm : (m : ℝ) * ‖p.2‖ ≤ (N : ℝ) * ‖p.2‖ :=
      mul_le_mul_of_nonneg_right hm_le (norm_nonneg p.2)
    have ht_lt : ‖p.2‖ < r_steep := hp.2.1.2.1
    have ht_R : ‖p.2‖ < R_0 / 8 := lt_of_lt_of_le ht_lt hr_le_R
    obtain ⟨_, hM_t, hC_t⟩ := ht_prod_lt p.2 ht_lt
    have hz_quarter : ‖z - w_node N m p‖ < R_0 / 4 := by
      have hexp : (C_init + (m : ℝ) * M_step) * ‖p.2‖ ^ 2 =
          (C_init * ‖p.2‖) * ‖p.2‖ + ((m : ℝ) * ‖p.2‖) * (M_step * ‖p.2‖) := by ring
      have hterm1 : (C_init * ‖p.2‖) * ‖p.2‖ ≤ (1 / 16 : ℝ) * (R_0 / 8) :=
        mul_le_mul (le_of_lt hC_t) (le_of_lt ht_R) (norm_nonneg p.2) (by norm_num)
      have hterm2 : ((m : ℝ) * ‖p.2‖) * (M_step * ‖p.2‖) ≤
          ((3 / 8 : ℝ) * R_0) * (1 / 4 : ℝ) :=
        mul_le_mul (le_trans hm_norm (le_of_lt hN_norm)) (le_of_lt hM_t)
          (mul_nonneg (le_of_lt hM_step_pos) (norm_nonneg p.2))
          (by linarith [P.R_0_pos])
      linarith
    have hw_34 : ‖w_node N m p - s_edge‖ < (3 / 4 : ℝ) * R_0 :=
      hw_ball N m (Nat.le_succ_of_le hm) p hp
    rw [Metric.mem_ball, dist_eq_norm]
    have htri : ‖z - s_edge‖ ≤ ‖z - w_node N m p‖ + ‖w_node N m p - s_edge‖ := by
      simpa using norm_add_le (z - w_node N m p) (w_node N m p - s_edge)
    linarith

  have hStepInBall : ∀ N m : ℕ, m ≤ N → ∀ p ∈ Ω_N N, ∀ Δ : ℂ,
      ‖Δ - p.2‖ ≤ (2 * C_init + 8 * C_rec * (m : ℝ) * ‖p.2‖) * ‖p.2‖ ^ 2 →
      ‖Δ - p.2‖ ≤ M_step * ‖p.2‖ ^ 2 ∧ ‖Δ‖ ≤ 2 * ‖p.2‖ ∧ Δ ∈ Metric.ball (0 : ℂ) δ_rec := by
    intro N m hm p hp Δ hΔ
    have hN_norm : (N : ℝ) * ‖p.2‖ < (3 / 8 : ℝ) * R_0 := hStepBudget N p hp
    have hm_le : (m : ℝ) ≤ (N : ℝ) := Nat.cast_le.mpr hm
    have hm_norm : (m : ℝ) * ‖p.2‖ ≤ (N : ℝ) * ‖p.2‖ :=
      mul_le_mul_of_nonneg_right hm_le (norm_nonneg p.2)
    have ht_lt : ‖p.2‖ < r_steep := hp.2.1.2.1
    have ht_drec : ‖p.2‖ < δ_rec / 2 := lt_of_lt_of_le ht_lt hr_le_drec
    obtain ⟨_, hM_t, _⟩ := ht_prod_lt p.2 ht_lt
    have hcoeff : 2 * C_init + 8 * C_rec * (m : ℝ) * ‖p.2‖ ≤ M_step := by
      dsimp [M_step]
      nlinarith [P.C_init_pos, P.C_rec_pos]
    have hΔ_M : ‖Δ - p.2‖ ≤ M_step * ‖p.2‖ ^ 2 :=
      le_trans hΔ (mul_le_mul_of_nonneg_right hcoeff (sq_nonneg ‖p.2‖))
    have hΔ_t : ‖Δ - p.2‖ ≤ ‖p.2‖ := by
      nlinarith [norm_nonneg p.2]
    have hΔ_two : ‖Δ‖ ≤ 2 * ‖p.2‖ := by
      have htri : ‖Δ‖ ≤ ‖Δ - p.2‖ + ‖p.2‖ := by
        simpa using norm_add_le (Δ - p.2) p.2
      linarith
    refine ⟨hΔ_M, hΔ_two, ?_⟩
    rw [Metric.mem_ball, dist_zero_right]
    linarith

  
  have hIterBoot : ∀ (N k : ℕ), k ≤ N →
      DifferentiableOn ℂ (fun p => (pairIter N k p).1) (Ω_N N) ∧
      DifferentiableOn ℂ (fun p => (pairIter N k p).2) (Ω_N N) ∧
      ∀ p ∈ Ω_N N,
        ‖(pairIter N k p).1 - w_node N k p‖ ≤ (C_init + (k : ℝ) * M_step) * ‖p.2‖ ^ 2 ∧
        ‖(pairIter N k p).2 - w_node N (k + 1) p‖ ≤
          (C_init + ((k + 1 : ℕ) : ℝ) * M_step) * ‖p.2‖ ^ 2 ∧
        ‖((pairIter N k p).2 - (pairIter N k p).1) - p.2‖ ≤
          (2 * C_init + 8 * C_rec * (k : ℝ) * ‖p.2‖) * ‖p.2‖ ^ 2 := by
    intro N k
    induction k with
    | zero =>
      intro _
      have hw0_diff : DifferentiableOn ℂ (fun p : ℂ × ℂ => (w_node N 0 p, p.2)) (Ω_N N) :=
        ((differentiable_fst.sub (differentiable_const _ |>.mul differentiable_snd)).add
          (differentiable_const _ |>.mul differentiable_snd)).prodMk
          differentiable_snd |>.differentiableOn
      have hw1_diff : DifferentiableOn ℂ (fun p : ℂ × ℂ => (w_node N 1 p, p.2)) (Ω_N N) :=
        ((differentiable_fst.sub (differentiable_const _ |>.mul differentiable_snd)).add
          (differentiable_const _ |>.mul differentiable_snd)).prodMk
          differentiable_snd |>.differentiableOn
      have hu0_holo : DifferentiableOn ℂ (fun p => (pairIter N 0 p).1) (Ω_N N) :=
        P.V_slab_holo.comp hw0_diff (fun p hp => hw0_slab N p hp)
      have hv0_holo : DifferentiableOn ℂ (fun p => (pairIter N 0 p).2) (Ω_N N) :=
        P.V_slab_holo.comp hw1_diff (fun p hp => hw1_slab N p hp)
      refine ⟨hu0_holo, hv0_holo, fun p hp => ?_⟩
      have hq0 := P.V_slab_quad (w_node N 0 p, p.2) (hw0_slab N p hp)
      have hq1 := P.V_slab_quad (w_node N 1 p, p.2) (hw1_slab N p hp)
      dsimp [pairIter] at hq0 hq1 ⊢
      refine ⟨?_, ?_, ?_⟩
      · simpa using hq0
      · have hM_sq : 0 ≤ M_step * ‖p.2‖ ^ 2 :=
          mul_nonneg (le_of_lt hM_step_pos) (sq_nonneg ‖p.2‖)
        simp only [Nat.cast_one, one_mul]
        linarith
      · have hw_diff : w_node N 1 p - w_node N 0 p = p.2 := by
          dsimp [w_node]; ring
        have hdecomp :
            (P.V_slab (w_node N 1 p, p.2) - P.V_slab (w_node N 0 p, p.2)) - p.2 =
              (P.V_slab (w_node N 1 p, p.2) - w_node N 1 p) -
                (P.V_slab (w_node N 0 p, p.2) - w_node N 0 p) := by
          rw [← hw_diff]; ring
        rw [hdecomp]
        have htri := norm_sub_le (P.V_slab (w_node N 1 p, p.2) - w_node N 1 p)
          (P.V_slab (w_node N 0 p, p.2) - w_node N 0 p)
        simp only [Nat.cast_zero, mul_zero, zero_mul, add_zero]
        linarith
    | succ k ih =>
      intro hk1
      obtain ⟨hu_holo, hv_holo, hBounds⟩ := ih (Nat.le_of_succ_le hk1)
      have hPairEq : ∀ p : ℂ × ℂ,
          pairIter N (k + 1) p =
            ( (pairIter N k p).2,
              (pairIter N k p).2 +
                P.G_succ ((pairIter N k p).2, (pairIter N k p).2 - (pairIter N k p).1) ) := by
        intro p
        exact Function.iterate_succ_apply' stepMap k _
      have hMapsG : Set.MapsTo
          (fun p => ((pairIter N k p).2, (pairIter N k p).2 - (pairIter N k p).1))
          (Ω_N N) (Metric.ball s_edge R_0 ×ˢ Metric.ball (0 : ℂ) δ_rec) := by
        intro p hp
        obtain ⟨_, hv_bd, hΔ_bd⟩ := hBounds p hp
        exact ⟨hPosInBall N (k + 1) hk1 p hp _ hv_bd,
          (hStepInBall N k (Nat.le_of_succ_le hk1) p hp _ hΔ_bd).2.2⟩
      have hu1_holo : DifferentiableOn ℂ (fun p => (pairIter N (k + 1) p).1) (Ω_N N) :=
        hv_holo.congr (fun p _ => by rw [hPairEq p])
      have hv1_holo : DifferentiableOn ℂ (fun p => (pairIter N (k + 1) p).2) (Ω_N N) := by
        have hG_comp : DifferentiableOn ℂ
            (fun p => P.G_succ ((pairIter N k p).2, (pairIter N k p).2 - (pairIter N k p).1))
            (Ω_N N) :=
          P.G_succ_holo.comp (hv_holo.prodMk (hv_holo.sub hu_holo)) hMapsG
        exact (hv_holo.add hG_comp).congr (fun p _ => by rw [hPairEq p]; rfl)
      refine ⟨hu1_holo, hv1_holo, fun p hp => ?_⟩
      obtain ⟨_, hv_bd, hΔ_bd⟩ := hBounds p hp
      have hv_in : (pairIter N k p).2 ∈ Metric.ball s_edge R_0 :=
        hPosInBall N (k + 1) hk1 p hp _ hv_bd
      obtain ⟨_, hΔ_two, hΔ_in⟩ := hStepInBall N k (Nat.le_of_succ_le hk1) p hp _ hΔ_bd
      let Δ_k := (pairIter N k p).2 - (pairIter N k p).1
      have hG_cub := P.G_succ_cubic (pairIter N k p).2 Δ_k hv_in hΔ_in
      have hpow3 : ‖Δ_k‖ ^ 3 ≤ (2 * ‖p.2‖) ^ 3 :=
        pow_le_pow_left₀ (norm_nonneg Δ_k) hΔ_two 3
      have hG_bound : ‖P.G_succ ((pairIter N k p).2, Δ_k) - Δ_k‖ ≤ 8 * C_rec * ‖p.2‖ ^ 3 := by
        have hmul := mul_le_mul_of_nonneg_left hpow3 (le_of_lt P.C_rec_pos)
        linarith
      have hΔ1_bd : ‖P.G_succ ((pairIter N k p).2, Δ_k) - p.2‖ ≤
          (2 * C_init + 8 * C_rec * ((k + 1 : ℕ) : ℝ) * ‖p.2‖) * ‖p.2‖ ^ 2 := by
        have htri : ‖P.G_succ ((pairIter N k p).2, Δ_k) - p.2‖ ≤
            ‖P.G_succ ((pairIter N k p).2, Δ_k) - Δ_k‖ + ‖Δ_k - p.2‖ := by
          simpa using norm_add_le (P.G_succ ((pairIter N k p).2, Δ_k) - Δ_k) (Δ_k - p.2)
        push_cast
        linarith
      have hΔ1_M : ‖P.G_succ ((pairIter N k p).2, Δ_k) - p.2‖ ≤ M_step * ‖p.2‖ ^ 2 :=
        (hStepInBall N (k + 1) hk1 p hp _ hΔ1_bd).1
      have hv1_bd :
          ‖((pairIter N k p).2 + P.G_succ ((pairIter N k p).2, Δ_k)) - w_node N (k + 2) p‖ ≤
            (C_init + ((k + 2 : ℕ) : ℝ) * M_step) * ‖p.2‖ ^ 2 := by
        have hw_step : w_node N (k + 2) p = w_node N (k + 1) p + p.2 := by
          dsimp [w_node]; push_cast; ring
        have hdecomp :
            ((pairIter N k p).2 + P.G_succ ((pairIter N k p).2, Δ_k)) - w_node N (k + 2) p =
              ((pairIter N k p).2 - w_node N (k + 1) p) +
                (P.G_succ ((pairIter N k p).2, Δ_k) - p.2) := by
          rw [hw_step]; ring
        rw [hdecomp]
        have htri := norm_add_le ((pairIter N k p).2 - w_node N (k + 1) p)
          (P.G_succ ((pairIter N k p).2, Δ_k) - p.2)
        push_cast at hv_bd ⊢
        linarith
      rw [hPairEq p]
      dsimp only
      have hsub_eq :
          ((pairIter N k p).2 + P.G_succ ((pairIter N k p).2, Δ_k)) - (pairIter N k p).2 =
            P.G_succ ((pairIter N k p).2, Δ_k) := by ring
      rw [hsub_eq]
      exact ⟨hv_bd, hv1_bd, hΔ1_bd⟩

  have hΛ_N_holo : ∀ (N : ℕ) (i : Fin 2), DifferentiableOn ℂ (Λ_N N i) (Ω_N N) := by
    intro N i
    obtain ⟨hu_holo, hv_holo, hBounds⟩ := hIterBoot N N (le_refl N)
    have hMapsL : Set.MapsTo
        (fun p => ((pairIter N N p).1, (pairIter N N p).2 - (pairIter N N p).1))
        (Ω_N N) (Metric.ball s_edge R_0 ×ˢ Metric.ball (0 : ℂ) δ_rec) := by
      intro p hp
      obtain ⟨hu_bd, _, hΔ_bd⟩ := hBounds p hp
      exact ⟨hPosInBall N N (le_refl N) p hp _ hu_bd,
        (hStepInBall N N (le_refl N) p hp _ hΔ_bd).2.2⟩
    exact (P.L_line_holo i).comp (hu_holo.prodMk (hv_holo.sub hu_holo)) hMapsL

  
  let O_plus : Set (ℂ × ℂ) := K_cor ×ˢ C_plus
  have hO_plus_open : IsOpen O_plus := hK_open.prod hC_plus_open

  have hCover : ∀ p ∈ O_plus, ∃ N : ℕ, p ∈ Ω_N N := by
    intro p hp
    rcases hp with ⟨hy, ht⟩
    have ht_im_pos : 0 < p.2.im := by linarith [ht.2.2, norm_nonneg p.2]
    have ht_slab : ‖p.2‖ < δ_slab / 4 := lt_of_lt_of_le ht.2.1 hr_le_slab
    have ht_im_le : p.2.im ≤ ‖p.2‖ := le_trans (le_abs_self _) (Complex.abs_im_le_norm p.2)
    by_cases h_le : p.1.im - y_row ≤ 0
    · refine ⟨0, hy, ht, ?_⟩
      rw [hshift_im]
      simp only [Nat.cast_zero, zero_mul, sub_zero, abs_lt]
      constructor <;> linarith [hy.2.1, P.δ_slab_pos]
    · have h_pos : 0 < p.1.im - y_row := lt_of_not_ge h_le
      let N := Nat.floor ((p.1.im - y_row) / p.2.im)
      have hq_nonneg : 0 ≤ (p.1.im - y_row) / p.2.im :=
        div_nonneg (le_of_lt h_pos) (le_of_lt ht_im_pos)
      have hfl_le : (N : ℝ) * p.2.im ≤ p.1.im - y_row :=
        (le_div_iff₀ ht_im_pos).mp (Nat.floor_le hq_nonneg)
      have hlt_fl : p.1.im - y_row < ((N : ℝ) + 1) * p.2.im :=
        (div_lt_iff₀ ht_im_pos).mp (Nat.lt_floor_add_one _)
      refine ⟨N, hy, ht, ?_⟩
      rw [hshift_im, abs_lt]
      constructor <;> linarith [P.δ_slab_pos]

  have hOverlapLe : ∀ (N₁ N₂ : ℕ), N₁ ≤ N₂ → ∀ (i : Fin 2),
      ∀ p ∈ Ω_N N₁ ∩ Ω_N N₂, Λ_N N₁ i p = Λ_N N₂ i p := by
    intro N₁ N₂ hN i p ⟨hp1, hp2⟩
    let d := N₂ - N₁
    have hNd : N₁ + d = N₂ := Nat.add_sub_of_le hN
    have hN2_norm : (N₂ : ℝ) * ‖p.2‖ < (3 / 8 : ℝ) * R_0 := hStepBudget N₂ p hp2
    have ht_lt : ‖p.2‖ < r_steep := hp2.2.1.2.1
    have ht_im_pos : 0 < p.2.im := by linarith [hp2.2.1.2.2, norm_nonneg p.2]
    have ht_dt : ‖p.2‖ < δ_t / 2 := lt_of_lt_of_le ht_lt hr_le_dt
    have ht_slab : ‖p.2‖ < δ_slab / 4 := lt_of_lt_of_le ht_lt hr_le_slab
    have ht_re_le : |p.2.re| ≤ ‖p.2‖ := Complex.abs_re_le_norm p.2
    have ht_im_le : |p.2.im| ≤ ‖p.2‖ := Complex.abs_im_le_norm p.2
    have hInterLe : ∀ s : ℕ, s ≤ d →
        |(w_node N₂ s p).re - x_edge| < R_0 / 2 ∧
        |(w_node N₂ s p).im - y_row| < (3 / 4 : ℝ) * δ_slab := by
      intro s hs
      have hsN2 : s ≤ N₂ := le_trans hs (Nat.sub_le N₂ N₁)
      have hs_R : (s : ℝ) ≤ (d : ℝ) := Nat.cast_le.mpr hs
      have hd_R : (N₁ : ℝ) + (d : ℝ) = (N₂ : ℝ) := by exact_mod_cast hNd
      have hdiff_nonneg : 0 ≤ (N₂ : ℝ) - (s : ℝ) := by
        have : (s : ℝ) ≤ (N₂ : ℝ) := Nat.cast_le.mpr hsN2
        linarith
      have hdiff_le : (N₂ : ℝ) - (s : ℝ) ≤ (N₂ : ℝ) := by
        have hs0 : (0 : ℝ) ≤ (s : ℝ) := Nat.cast_nonneg s
        linarith
      have hdiff_ge : (N₁ : ℝ) ≤ (N₂ : ℝ) - (s : ℝ) := by linarith
      have hre_part : |((N₂ : ℝ) - (s : ℝ)) * p.2.re| < (3 / 8 : ℝ) * R_0 := by
        rw [abs_mul, abs_of_nonneg hdiff_nonneg]
        nlinarith [norm_nonneg p.2]
      refine ⟨?_, ?_⟩
      · have h_eq : (w_node N₂ s p).re - x_edge =
            (p.1.re - x_edge) - ((N₂ : ℝ) - (s : ℝ)) * p.2.re := by
          rw [hw_re]; ring
        rw [h_eq]
        linarith [abs_sub (p.1.re - x_edge) (((N₂ : ℝ) - (s : ℝ)) * p.2.re), hp2.1.1]
      · have hrow1 := hp1.2.2
        have hrow2 := hp2.2.2
        rw [hshift_im] at hrow1 hrow2
        have him_lo : ((N₁ : ℝ) * p.2.im) ≤ ((N₂ : ℝ) - (s : ℝ)) * p.2.im :=
          mul_le_mul_of_nonneg_right hdiff_ge (le_of_lt ht_im_pos)
        have him_hi : ((N₂ : ℝ) - (s : ℝ)) * p.2.im ≤ (N₂ : ℝ) * p.2.im :=
          mul_le_mul_of_nonneg_right hdiff_le (le_of_lt ht_im_pos)
        have h_eq : (w_node N₂ s p).im - y_row =
            (p.1.im - ((N₂ : ℝ) - (s : ℝ)) * p.2.im) - y_row := by
          rw [hw_im]; ring
        rw [h_eq, abs_lt]
        constructor <;> linarith [(abs_lt.mp hrow1).2, (abs_lt.mp hrow2).1]
    have hInSlab : ∀ s : ℕ, s ≤ d + 1 →
        (w_node N₂ s p, p.2) ∈ slabBox x_edge R_0 y_row δ_slab δ_t := by
      intro s hs
      by_cases hsd : s ≤ d
      · obtain ⟨hre, him⟩ := hInterLe s hsd
        exact ⟨by linarith [P.δ_slab_pos], by linarith [P.δ_slab_pos], by linarith [P.δ_t_pos]⟩
      · have hs_eq : s = d + 1 := by omega
        subst hs_eq
        obtain ⟨hre, him⟩ := hInterLe d (le_refl d)
        refine ⟨?_, ?_, by linarith [P.δ_t_pos]⟩
        · have h_eq : (w_node N₂ (d + 1) p).re - x_edge =
              ((w_node N₂ d p).re - x_edge) + p.2.re := by
            rw [hw_re, hw_re]; push_cast; ring
          rw [h_eq]
          linarith [abs_add_le ((w_node N₂ d p).re - x_edge) p.2.re, P.δ_slab_pos]
        · have h_eq : (w_node N₂ (d + 1) p).im - y_row =
              ((w_node N₂ d p).im - y_row) + p.2.im := by
            rw [hw_im, hw_im]; push_cast; ring
          rw [h_eq]
          linarith [abs_add_le ((w_node N₂ d p).im - y_row) p.2.im, P.δ_slab_pos]
    have hShiftIter : ∀ r : ℕ, r ≤ d →
        pairIter N₂ r p =
          (P.V_slab (w_node N₂ r p, p.2), P.V_slab (w_node N₂ (r + 1) p, p.2)) := by
      intro r
      induction r with
      | zero =>
        intro _
        rfl
      | succ r ih =>
        intro hr1
        have hPrev := ih (Nat.le_of_succ_le hr1)
        have hIterSucc : pairIter N₂ (r + 1) p = stepMap (pairIter N₂ r p) :=
          Function.iterate_succ_apply' stepMap r _
        rw [hIterSucc, hPrev]
        have hw_sub : w_node N₂ (r + 1) p - p.2 = w_node N₂ r p := by
          dsimp [w_node]; push_cast; ring
        have hw_add : w_node N₂ (r + 1) p + p.2 = w_node N₂ (r + 2) p := by
          dsimp [w_node]; push_cast; ring
        have hSubIn : (w_node N₂ (r + 1) p - p.2, p.2) ∈ slabBox x_edge R_0 y_row δ_slab δ_t := by
          rw [hw_sub]; exact hInSlab r (by omega)
        have hMidIn : (w_node N₂ (r + 1) p, p.2) ∈ slabBox x_edge R_0 y_row δ_slab δ_t :=
          hInSlab (r + 1) (by omega)
        have hAddIn : (w_node N₂ (r + 1) p + p.2, p.2) ∈ slabBox x_edge R_0 y_row δ_slab δ_t := by
          rw [hw_add]; exact hInSlab (r + 2) (by omega)
        have hRec := (P.slab_recurrence (w_node N₂ (r + 1) p) p.2 hSubIn hMidIn hAddIn).2.2.2
        rw [hw_sub, hw_add] at hRec
        dsimp [stepMap]
        ext
        · rfl
        · linear_combination -hRec
    have hd_eq := hShiftIter d (le_refl d)
    have hNd_C : (N₂ : ℂ) = (N₁ : ℂ) + (d : ℂ) := by exact_mod_cast hNd.symm
    have hw_d0 : w_node N₂ d p = w_node N₁ 0 p := by
      dsimp [w_node]; rw [hNd_C]; simp; ring
    have hw_d1 : w_node N₂ (d + 1) p = w_node N₁ 1 p := by
      dsimp [w_node]; rw [hNd_C]; push_cast; ring
    rw [hw_d0, hw_d1] at hd_eq
    have hPairN : pairIter N₂ N₂ p = pairIter N₁ N₁ p := by
      have hIterAdd : ∀ x, stepMap^[N₂] x = stepMap^[N₁] (stepMap^[d] x) := by
        intro x
        rw [← hNd]
        exact Function.iterate_add_apply stepMap N₁ d x
      dsimp [pairIter] at hd_eq ⊢
      rw [hIterAdd, hd_eq]
    dsimp [Λ_N]
    rw [hPairN]

  have hOverlap : ∀ (N₁ N₂ : ℕ) (i : Fin 2),
      ∀ p ∈ Ω_N N₁ ∩ Ω_N N₂, Λ_N N₁ i p = Λ_N N₂ i p := by
    intro N₁ N₂ i p hp
    rcases le_total N₁ N₂ with h | h
    · exact hOverlapLe N₁ N₂ h i p hp
    · exact (hOverlapLe N₂ N₁ h i p ⟨hp.2, hp.1⟩).symm

  
  let Λ_up : Fin 2 → ℂ × ℂ → ℂ := fun i p =>
    if hp : p ∈ O_plus then Λ_N (Classical.choose (hCover p hp)) i p else 0

  have hΛ_up_eq : ∀ (N : ℕ) (i : Fin 2), ∀ p ∈ Ω_N N, Λ_up i p = Λ_N N i p := by
    intro N i p hpN
    have hpO : p ∈ O_plus := ⟨hpN.1, hpN.2.1⟩
    dsimp [Λ_up]
    rw [dif_pos hpO]
    exact hOverlap _ N i p ⟨Classical.choose_spec (hCover p hpO), hpN⟩

  have hΛ_up_holo : ∀ i : Fin 2, DifferentiableOn ℂ (Λ_up i) O_plus := by
    intro i p₀ hp₀
    let N₀ := Classical.choose (hCover p₀ hp₀)
    have hp₀N : p₀ ∈ Ω_N N₀ := Classical.choose_spec (hCover p₀ hp₀)
    have hnhds : Ω_N N₀ ∈ nhds p₀ := (hΩ_open N₀).mem_nhds hp₀N
    have hev : Λ_up i =ᶠ[nhds p₀] Λ_N N₀ i :=
      Filter.eventuallyEq_of_mem hnhds (fun p hp => hΛ_up_eq N₀ i p hp)
    exact (((hΛ_N_holo N₀ i).differentiableAt hnhds).congr_of_eventuallyEq hev).differentiableWithinAt

  have hΛ_up_base : ∀ i : Fin 2, ∀ p ∈ Ω_N 0,
      Λ_up i p = P.L_line i (P.V_slab p, P.V_slab (p.1 + p.2, p.2) - P.V_slab p) := by
    intro i p hp0
    rw [hΛ_up_eq 0 i p hp0]
    have hw00 : (w_node 0 0 p, p.2) = p := by
      ext <;> simp [w_node]
    have hw01 : (w_node 0 1 p, p.2) = (p.1 + p.2, p.2) := by
      ext <;> simp [w_node]
    dsimp [Λ_N, pairIter]
    rw [hw00, hw01]

  
  let σ : ℂ × ℂ → ℂ × ℂ := fun p => (p.1, -p.2)
  have hσ_diff : Differentiable ℂ σ := differentiable_fst.prodMk differentiable_snd.neg
  have hσ_cont : Continuous σ := hσ_diff.continuous
  have hσ_invol : ∀ p : ℂ × ℂ, σ (σ p) = p := fun p => Prod.ext rfl (neg_neg p.2)
  have hσ_dist : ∀ q p : ℂ × ℂ, dist (σ q) (σ p) = dist q p := by
    intro q p
    simp [σ, Prod.dist_eq, dist_neg_neg]

  let Λ_steep : Fin 2 → ℂ × ℂ → ℂ := fun i p =>
    if 0 < p.2.im then Λ_up i p else Λ_up i (σ p)

  have hΛ_steep_holo : ∀ i : Fin 2,
      DifferentiableOn ℂ (Λ_steep i)
        (K_cor ×ˢ steepSectorT r_steep) := by
    intro i p₀ hp₀
    rcases hp₀ with ⟨hy₀, ht₀_pos, ht₀_lt, ht₀_im⟩
    have him_ne : p₀.2.im ≠ 0 := by
      intro h0
      rw [h0, abs_zero] at ht₀_im
      linarith
    rcases lt_or_gt_of_ne him_ne with him_neg | him_pos
    · let O_minus : Set (ℂ × ℂ) := σ ⁻¹' O_plus
      have hO_minus_open : IsOpen O_minus := hO_plus_open.preimage hσ_cont
      have hp₀_minus : p₀ ∈ O_minus := by
        refine ⟨hy₀, ?_, ?_, ?_⟩
        · simpa [σ] using ht₀_pos
        · simpa [σ] using ht₀_lt
        · rw [abs_of_neg him_neg] at ht₀_im
          simpa [σ] using ht₀_im
      have hnhds : O_minus ∈ nhds p₀ := hO_minus_open.mem_nhds hp₀_minus
      have hev : Λ_steep i =ᶠ[nhds p₀] (fun p => Λ_up i (σ p)) := by
        refine Filter.eventuallyEq_of_mem hnhds (fun p hp => ?_)
        have hp_neg : p.2.im < 0 := by
          have h1 : ‖-p.2‖ / 3 < (-p.2).im := hp.2.2.2
          simp only [norm_neg, Complex.neg_im] at h1
          linarith [norm_nonneg p.2]
        dsimp [Λ_steep]
        rw [if_neg (not_lt.mpr (le_of_lt hp_neg))]
      have hcomp_holo : DifferentiableOn ℂ (fun p => Λ_up i (σ p)) O_minus :=
        (hΛ_up_holo i).comp hσ_diff.differentiableOn (fun _ hp => hp)
      exact ((hcomp_holo.differentiableAt hnhds).congr_of_eventuallyEq hev).differentiableWithinAt
    · have hp₀_plus : p₀ ∈ O_plus := by
        rw [abs_of_pos him_pos] at ht₀_im
        exact ⟨hy₀, ht₀_pos, ht₀_lt, ht₀_im⟩
      have hnhds : O_plus ∈ nhds p₀ := hO_plus_open.mem_nhds hp₀_plus
      have hev : Λ_steep i =ᶠ[nhds p₀] Λ_up i := by
        refine Filter.eventuallyEq_of_mem hnhds (fun p hp => ?_)
        have hp_pos : 0 < p.2.im := by linarith [hp.2.2.2, norm_nonneg p.2]
        dsimp [Λ_steep]
        rw [if_pos hp_pos]
      exact (((hΛ_up_holo i).differentiableAt hnhds).congr_of_eventuallyEq hev).differentiableWithinAt

  
  have hEqZeroBall : ∀ {c : ℂ × ℂ} {R : ℝ} {O : Set (ℂ × ℂ)} {g : ℂ × ℂ → ℂ},
      IsOpen O → O.Nonempty → O ⊆ Metric.ball c R →
      DifferentiableOn ℂ g (Metric.ball c R) →
      (∀ z ∈ O, g z = 0) → ∀ q ∈ Metric.ball c R, g q = 0 := by
    intro c R O g hO_open hO_ne hO_sub hg hO_zero
    obtain ⟨q₀, hq₀O⟩ := hO_ne
    obtain ⟨η, hη_pos, hη_sub⟩ := Metric.isOpen_iff.mp hO_open q₀ hq₀O
    have hq₀B : q₀ ∈ Metric.ball c R := hO_sub hq₀O
    rw [Metric.mem_ball, dist_eq_norm] at hq₀B
    intro q hqB
    rw [Metric.mem_ball, dist_eq_norm] at hqB
    let d_max : ℝ := max ‖q₀ - c‖ ‖q - c‖
    have hd_lt : d_max < R := max_lt hq₀B hqB
    let D : ℝ := ‖q - q₀‖ + 1
    have hD_pos : 0 < D := by positivity
    let ε : ℝ := (R - d_max) / (2 * D)
    have hε_pos : 0 < ε := div_pos (by linarith) (by positivity)
    let Φ : ℂ → ℂ × ℂ := fun lam => q₀ + lam • (q - q₀)
    have hΦ_diff : Differentiable ℂ Φ :=
      (differentiable_const q₀).add (differentiable_id.smul_const (q - q₀))
    let Rect : Set ℂ :=
      { lam : ℂ | -ε < lam.re ∧ lam.re < 1 + ε ∧ -ε < lam.im ∧ lam.im < ε }
    have hRect_open : IsOpen Rect :=
      (isOpen_lt continuous_const Complex.continuous_re).inter
        ((isOpen_lt Complex.continuous_re continuous_const).inter
          ((isOpen_lt continuous_const Complex.continuous_im).inter
            (isOpen_lt Complex.continuous_im continuous_const)))
    have hRect_conv : Convex ℝ Rect := by
      intro z₁ hz₁ z₂ hz₂ a b ha hb hab
      rcases eq_or_lt_of_le ha with rfl | ha_pos
      · have hb1 : b = 1 := by linarith
        subst hb1; simpa using hz₂
      · rcases hz₁ with ⟨h1a, h1b, h1c, h1d⟩
        rcases hz₂ with ⟨h2a, h2b, h2c, h2d⟩
        refine ⟨?_, ?_, ?_, ?_⟩ <;>
          simp only [Complex.add_re, Complex.smul_re, Complex.add_im, Complex.smul_im,
            smul_eq_mul] <;>
          nlinarith
    have h0_Rect : (0 : ℂ) ∈ Rect := by
      refine ⟨?_, ?_, ?_, ?_⟩ <;> simp <;> linarith
    have h1_Rect : (1 : ℂ) ∈ Rect := by
      refine ⟨?_, ?_, ?_, ?_⟩ <;> simp <;> linarith
    have hΦ_maps : Set.MapsTo Φ Rect (Metric.ball c R) := by
      intro lam ⟨hre_lo, hre_hi, him_lo, him_hi⟩
      rw [Metric.mem_ball, dist_eq_norm]
      let t : ℝ := if lam.re ≤ 0 then 0 else if 1 ≤ lam.re then 1 else lam.re
      have ht_bounds : 0 ≤ t ∧ t ≤ 1 ∧ |lam.re - t| < ε := by
        dsimp [t]
        split_ifs with hle0 hge1
        · refine ⟨le_refl 0, zero_le_one, ?_⟩
          rw [sub_zero, abs_of_nonpos hle0]; linarith
        · refine ⟨zero_le_one, le_refl 1, ?_⟩
          rw [abs_of_nonneg (by linarith)]; linarith
        · refine ⟨by linarith, by linarith, ?_⟩
          simp [hε_pos]
      obtain ⟨ht0, _, hre_t⟩ := ht_bounds
      have him_abs : |lam.im| < ε := abs_lt.mpr ⟨him_lo, him_hi⟩
      have hlam_t : ‖lam - (t : ℂ)‖ < 2 * ε := by
        have h1 := Complex.norm_le_abs_re_add_abs_im (lam - (t : ℂ))
        simp only [Complex.sub_re, Complex.ofReal_re, Complex.sub_im, Complex.ofReal_im,
          sub_zero] at h1
        linarith
      have hdecomp : Φ lam - c =
          ((1 - t : ℝ) • (q₀ - c) + t • (q - c)) + (lam - (t : ℂ)) • (q - q₀) := by
        dsimp [Φ]
        ext <;> simp [Complex.real_smul] <;> ring
      rw [hdecomp]
      have hconv_norm : ‖(1 - t : ℝ) • (q₀ - c) + t • (q - c)‖ ≤ d_max := by
        calc ‖(1 - t : ℝ) • (q₀ - c) + t • (q - c)‖
            ≤ ‖(1 - t : ℝ) • (q₀ - c)‖ + ‖t • (q - c)‖ := norm_add_le _ _
          _ = (1 - t) * ‖q₀ - c‖ + t * ‖q - c‖ := by
              rw [norm_smul, norm_smul, Real.norm_of_nonneg (by linarith), Real.norm_of_nonneg ht0]
          _ ≤ (1 - t) * d_max + t * d_max :=
              add_le_add
                (mul_le_mul_of_nonneg_left (le_max_left _ _) (by linarith))
                (mul_le_mul_of_nonneg_left (le_max_right _ _) ht0)
          _ = d_max := by ring
      have herr_norm : ‖(lam - (t : ℂ)) • (q - q₀)‖ < R - d_max := by
        rw [norm_smul]
        have hmul1 : ‖lam - (t : ℂ)‖ * ‖q - q₀‖ ≤ (2 * ε) * ‖q - q₀‖ :=
          mul_le_mul_of_nonneg_right (le_of_lt hlam_t) (norm_nonneg _)
        have hmul2 : (2 * ε) * ‖q - q₀‖ < (2 * ε) * D := by
          dsimp [D]; nlinarith
        have h2εD : (2 * ε) * D = R - d_max := by
          dsimp [ε]
          field_simp [ne_of_gt hD_pos]
        linarith
      linarith [norm_add_le ((1 - t : ℝ) • (q₀ - c) + t • (q - c)) ((lam - (t : ℂ)) • (q - q₀))]
    have hgΦ_ana : AnalyticOnNhd ℂ (g ∘ Φ) Rect :=
      (Complex.analyticOnNhd_iff_differentiableOn hRect_open).mpr
        (hg.comp hΦ_diff.differentiableOn hΦ_maps)
    have hgΦ_ev0 : (g ∘ Φ) =ᶠ[nhds (0 : ℂ)] 0 := by
      have hpre : Φ ⁻¹' Metric.ball q₀ η ∈ nhds (0 : ℂ) := by
        apply hΦ_diff.continuous.continuousAt.preimage_mem_nhds
        simpa [Φ] using Metric.ball_mem_nhds q₀ hη_pos
      filter_upwards [hpre] with lam hlam
      exact hO_zero (Φ lam) (hη_sub hlam)
    have heq0 := hgΦ_ana.eqOn_zero_of_preconnected_of_eventuallyEq_zero
      hRect_conv.isPreconnected h0_Rect hgΦ_ev0 h1_Rect
    simpa [Φ] using heq0

  let T_mero : Set (ℂ × ℂ) := meroTubeENNR W.r_base W.h_L

  have hMeroCont : ∀ (F : MeroOn2D T_mero) (f : ℂ × ℂ → ℂ) (U V : Set (ℂ × ℂ)),
      IsOpen U → IsPreconnected U → U ⊆ T_mero → DifferentiableOn ℂ f U →
      IsOpen V → V.Nonempty → V ⊆ U → MeroAgreesHolo F f V →
      MeroAgreesHolo F f U := by
    intro F f U V hU_open hU_pre hU_sub hf_holo hV_open hV_ne hV_sub hAgV
    let S : Set (ℂ × ℂ) :=
      { p ∈ U | ∃ r : ℝ, 0 < r ∧ r ≤ F.rad p ∧ Metric.ball p r ⊆ U ∧
          ∀ q ∈ Metric.ball p r, F.num p q = f q * F.den p q }
    have hTransfer : ∀ p₁ p₂ : ℂ × ℂ, p₁ ∈ U → p₂ ∈ U →
        ∀ r₁ r₂ : ℝ, 0 < r₁ → r₁ ≤ F.rad p₁ → Metric.ball p₁ r₁ ⊆ U →
        (∀ q ∈ Metric.ball p₁ r₁, F.num p₁ q = f q * F.den p₁ q) →
        0 < r₂ → r₂ ≤ F.rad p₂ → Metric.ball p₂ r₂ ⊆ U →
        (Metric.ball p₁ r₁ ∩ Metric.ball p₂ r₂).Nonempty →
        ∀ q ∈ Metric.ball p₂ r₂, F.num p₂ q = f q * F.den p₂ q := by
      intro p₁ p₂ hp₁U hp₂U r₁ r₂ hr₁_pos hr₁_rad _ hp₁_eq hr₂_pos hr₂_rad hr₂_sub hO_ne
      let O := Metric.ball p₁ r₁ ∩ Metric.ball p₂ r₂
      have hO_open : IsOpen O := Metric.isOpen_ball.inter Metric.isOpen_ball
      have hO_sub1 : O ⊆ Metric.ball p₁ (F.rad p₁) :=
        fun _ hq => Metric.ball_subset_ball hr₁_rad hq.1
      have hDen1_nz : ∃ q₀ ∈ O, F.den p₁ q₀ ≠ 0 := by
        by_contra hAllZero
        push_neg at hAllZero
        have hZeroAll : ∀ q ∈ Metric.ball p₁ (F.rad p₁), F.den p₁ q = 0 :=
          hEqZeroBall hO_open hO_ne hO_sub1 (F.den_holo p₁ (hU_sub hp₁U)) hAllZero
        obtain ⟨q_nz, hq_nz_mem, hq_nz⟩ := F.den_ne_zero p₁ (hU_sub hp₁U)
        exact hq_nz (hZeroAll q_nz hq_nz_mem)
      obtain ⟨q₀, hq₀O, hq₀_nz⟩ := hDen1_nz
      have hDen1_cont : ContinuousAt (F.den p₁) q₀ :=
        (F.den_holo p₁ (hU_sub hp₁U)).continuousOn.continuousAt
          (Metric.isOpen_ball.mem_nhds (hO_sub1 hq₀O))
      have hSubNhds : (O ∩ { q | F.den p₁ q ≠ 0 }) ∈ nhds q₀ :=
        Filter.inter_mem (hO_open.mem_nhds hq₀O) (hDen1_cont.eventually_ne hq₀_nz)
      obtain ⟨η, hη_pos, hη_sub⟩ := Metric.mem_nhds_iff.mp hSubNhds
      let Δ₂ : ℂ × ℂ → ℂ := fun q => F.num p₂ q - f q * F.den p₂ q
      have hΔ₂_holo : DifferentiableOn ℂ Δ₂ (Metric.ball p₂ r₂) :=
        ((F.num_holo p₂ (hU_sub hp₂U)).mono (Metric.ball_subset_ball hr₂_rad)).sub
          ((hf_holo.mono hr₂_sub).mul
            ((F.den_holo p₂ (hU_sub hp₂U)).mono (Metric.ball_subset_ball hr₂_rad)))
      have hΔ₂_sub : ∀ q ∈ Metric.ball q₀ η, Δ₂ q = 0 := by
        intro q hq
        obtain ⟨hqO, hden_nz⟩ := hη_sub hq
        have hcomp := F.compat p₁ (hU_sub hp₁U) p₂ (hU_sub hp₂U) q
          ⟨hO_sub1 hqO, Metric.ball_subset_ball hr₂_rad hqO.2⟩
        have h1 := hp₁_eq q hqO.1
        have hprod : Δ₂ q * F.den p₁ q = 0 := by
          dsimp [Δ₂]
          linear_combination -hcomp + h1 * F.den p₂ q
        exact (mul_eq_zero.mp hprod).resolve_right hden_nz
      have hBall_sub2 : Metric.ball q₀ η ⊆ Metric.ball p₂ r₂ :=
        fun q hq => (hη_sub hq).1.2
      intro q hq
      have h0 : Δ₂ q = 0 :=
        hEqZeroBall Metric.isOpen_ball ⟨q₀, Metric.mem_ball_self hη_pos⟩ hBall_sub2
          hΔ₂_holo hΔ₂_sub q hq
      dsimp [Δ₂] at h0
      exact sub_eq_zero.mp h0
    have hS_open : IsOpen S := by
      rw [Metric.isOpen_iff]
      intro p₁ ⟨hp₁U, r₁, hr₁_pos, hr₁_rad, hr₁_sub, hp₁_eq⟩
      refine ⟨r₁, hr₁_pos, fun p₂ hp₂ => ?_⟩
      have hp₂U : p₂ ∈ U := hr₁_sub hp₂
      obtain ⟨r_u, hr_u_pos, hr_u_sub⟩ := Metric.isOpen_iff.mp hU_open p₂ hp₂U
      let ρ₂ := min (F.rad p₂) r_u
      have hρ₂_pos : 0 < ρ₂ := lt_min (F.rad_pos p₂ (hU_sub hp₂U)) hr_u_pos
      have hρ₂_sub : Metric.ball p₂ ρ₂ ⊆ U :=
        Set.Subset.trans (Metric.ball_subset_ball (min_le_right _ _)) hr_u_sub
      refine ⟨hp₂U, ρ₂, hρ₂_pos, min_le_left _ _, hρ₂_sub, ?_⟩
      exact hTransfer p₁ p₂ hp₁U hp₂U r₁ ρ₂ hr₁_pos hr₁_rad hr₁_sub hp₁_eq
        hρ₂_pos (min_le_left _ _) hρ₂_sub ⟨p₂, hp₂, Metric.mem_ball_self hρ₂_pos⟩
    have hS_ne : (U ∩ S).Nonempty := by
      obtain ⟨p₀, hp₀V⟩ := hV_ne
      obtain ⟨r₀, hr₀_pos, hr₀_rad, hr₀_sub, hp₀_eq⟩ := hAgV.2 p₀ hp₀V
      exact ⟨p₀, hV_sub hp₀V, hV_sub hp₀V, r₀, hr₀_pos, hr₀_rad,
        Set.Subset.trans hr₀_sub hV_sub, hp₀_eq⟩
    have hS_closed : closure S ∩ U ⊆ S := by
      intro p₂ ⟨hp₂_cl, hp₂U⟩
      obtain ⟨r_u, hr_u_pos, hr_u_sub⟩ := Metric.isOpen_iff.mp hU_open p₂ hp₂U
      let ρ₂ := min (F.rad p₂) r_u
      have hρ₂_pos : 0 < ρ₂ := lt_min (F.rad_pos p₂ (hU_sub hp₂U)) hr_u_pos
      have hρ₂_sub : Metric.ball p₂ ρ₂ ⊆ U :=
        Set.Subset.trans (Metric.ball_subset_ball (min_le_right _ _)) hr_u_sub
      obtain ⟨p₁, ⟨hp₁U, r₁, hr₁_pos, hr₁_rad, hr₁_sub, hp₁_eq⟩, hp₁_dist⟩ :=
        Metric.mem_closure_iff.mp hp₂_cl ρ₂ hρ₂_pos
      have hp₁_ball2 : p₁ ∈ Metric.ball p₂ ρ₂ := by
        rw [Metric.mem_ball, dist_comm]; exact hp₁_dist
      refine ⟨hp₂U, ρ₂, hρ₂_pos, min_le_left _ _, hρ₂_sub, ?_⟩
      exact hTransfer p₁ p₂ hp₁U hp₂U r₁ ρ₂ hr₁_pos hr₁_rad hr₁_sub hp₁_eq
        hρ₂_pos (min_le_left _ _) hρ₂_sub ⟨p₁, Metric.mem_ball_self hr₁_pos, hp₁_ball2⟩
    have hU_sub_S : U ⊆ S :=
      hU_pre.subset_of_closure_inter_subset hS_open hS_ne hS_closed
    exact ⟨hU_sub, fun p hp => (hU_sub_S hp).2⟩

  
  have hΛ_steep_agrees : ∀ μ : ℝ, 0 < μ → y_row < H₀ - μ →
      ∃ r_μ : ℝ, 0 < r_μ ∧ r_μ ≤ r_steep ∧
        ∀ i : Fin 2,
          MeroAgreesHolo (W.L_mero i) (Λ_steep i)
            ((K_cor ∩ { y : ℂ | y.im < H₀ - μ }) ×ˢ
              (steepSectorT r_steep ∩ Metric.ball (0 : ℂ) r_μ)) := by
    intro μ hμ hy_μ
    have hH₀_pos : 0 < H₀ := by linarith [P.H₀_ge, W.s_base_pos]
    have h0_ball : (0 : ℂ) ∈ Metric.ball (0 : ℂ) W.r_base :=
      Metric.mem_ball_self W.r_base_pos
    have hhL0 : W.h_L 0 = ENNReal.ofReal H₀ := by
      rw [W.h_L_eq 0 h0_ball, hHX]
      simp
    have hlt_hL0 : ENNReal.ofReal (H₀ - μ / 2) < W.h_L 0 := by
      rw [hhL0]
      exact (ENNReal.ofReal_lt_ofReal_iff hH₀_pos).mpr (by linarith)
    have hlsc_nhds : ∀ᶠ t in nhds (0 : ℂ), ENNReal.ofReal (H₀ - μ / 2) < W.h_L t := by
      have h1 := W.h_L_lsc 0 h0_ball (ENNReal.ofReal (H₀ - μ / 2)) hlt_hL0
      rwa [nhdsWithin_eq_nhds.mpr (Metric.isOpen_ball.mem_nhds h0_ball)] at h1
    obtain ⟨r_lsc, hr_lsc_pos, hr_lsc⟩ := Metric.eventually_nhds_iff.mp hlsc_nhds
    let r_μ := min r_steep r_lsc
    have hr_μ_pos : 0 < r_μ := lt_min hr_steep_pos hr_lsc_pos
    have hr_μ_le : r_μ ≤ r_steep := min_le_left _ _
    refine ⟨r_μ, hr_μ_pos, hr_μ_le, fun i => ?_⟩

    let Y_μ : Set ℂ := K_cor ∩ { y : ℂ | y.im < H₀ - μ }
    let S_μ : Set ℂ := steepSectorT r_steep ∩ Metric.ball (0 : ℂ) r_μ
    let U_μ : Set (ℂ × ℂ) := Y_μ ×ˢ S_μ
    let S_plus : Set ℂ := { t : ℂ | 0 < ‖t‖ ∧ ‖t‖ < r_μ ∧ ‖t‖ / 3 < t.im }
    let U_plus : Set (ℂ × ℂ) := Y_μ ×ˢ S_plus
    let U_minus : Set (ℂ × ℂ) := σ ⁻¹' U_plus

    have hU_sub_T : U_μ ⊆ T_mero := by
      intro p ⟨⟨hyK, hy_lt⟩, ⟨_, _, _⟩, ht_ball⟩
      rw [Metric.mem_ball, dist_zero_right] at ht_ball
      have ht_base : ‖p.2‖ < W.r_base :=
        lt_of_lt_of_le (lt_of_lt_of_le ht_ball hr_μ_le) hr_le_base
      have hy_pos : 0 < p.1.im := by
        linarith [hyK.2.1, P.y_row_bounds.1, P.δ_slab_lt_R, P.R_0_lt, P.H₀_ge, W.s_base_pos]
      have hconj_ball : starRingEnd ℂ p.2 ∈ Metric.ball (0 : ℂ) W.r_base := by
        rw [Metric.mem_ball, dist_zero_right, RCLike.norm_conj]; exact ht_base
      have hhL_conj_pos : 0 < W.h_L (starRingEnd ℂ p.2) := by
        have hpos2 : 0 < ENNReal.ofReal (2 * W.s_base) :=
          ENNReal.ofReal_pos.mpr (by linarith [W.s_base_pos])
        have hge := W.h_X_ge_two (starRingEnd ℂ p.2) hconj_ball
        rw [W.h_L_eq (starRingEnd ℂ p.2) hconj_ball]
        exact lt_of_lt_of_le hpos2 (le_trans hge le_self_add)
      refine ⟨ht_base, ?_, ?_⟩
      · rw [ENNReal.ofReal_of_nonpos (by linarith)]
        exact hhL_conj_pos
      · have hy_lt' : p.1.im < H₀ - μ := hy_lt
        have hle : ENNReal.ofReal p.1.im ≤ ENNReal.ofReal (H₀ - μ / 2) :=
          ENNReal.ofReal_le_ofReal (by linarith)
        have hlt_lsc : ENNReal.ofReal (H₀ - μ / 2) < W.h_L p.2 := by
          apply hr_lsc
          rw [dist_zero_right]
          exact lt_of_lt_of_le ht_ball (min_le_right _ _)
        exact lt_of_le_of_lt hle hlt_lsc

    have hY_open : IsOpen Y_μ := hK_open.inter (isOpen_lt Complex.continuous_im continuous_const)
    have hS_plus_open : IsOpen S_plus :=
      (isOpen_lt continuous_const continuous_norm).inter
        ((isOpen_lt continuous_norm continuous_const).inter
          (isOpen_lt (continuous_norm.div_const 3) Complex.continuous_im))
    have hU_plus_open : IsOpen U_plus := hY_open.prod hS_plus_open
    have hU_minus_open : IsOpen U_minus := hU_plus_open.preimage hσ_cont

    have hU_plus_sub_U : U_plus ⊆ U_μ := by
      intro p ⟨hy, ht_pos, ht_lt, ht_im⟩
      have ht_pos_im : 0 < p.2.im := by linarith [norm_nonneg p.2]
      refine ⟨hy, ⟨ht_pos, lt_of_lt_of_le ht_lt hr_μ_le, ?_⟩, ?_⟩
      · rwa [abs_of_pos ht_pos_im]
      · rwa [Metric.mem_ball, dist_zero_right]

    have hU_minus_sub_U : U_minus ⊆ U_μ := by
      intro p ⟨hy, ht_pos, ht_lt, ht_im⟩
      simp only [σ, norm_neg, Complex.neg_im] at ht_pos ht_lt ht_im
      have ht_neg_im : p.2.im < 0 := by linarith [norm_nonneg p.2]
      refine ⟨hy, ⟨ht_pos, lt_of_lt_of_le ht_lt hr_μ_le, ?_⟩, ?_⟩
      · rwa [abs_of_neg ht_neg_im]
      · rwa [Metric.mem_ball, dist_zero_right]

    have hY_conv : Convex ℝ Y_μ := by
      intro y₁ hy₁ y₂ hy₂ a b ha hb hab
      rcases eq_or_lt_of_le ha with rfl | ha_pos
      · have hb1 : b = 1 := by linarith
        subst hb1; simpa using hy₂
      · obtain ⟨⟨hy₁_re, hy₁_lo, hy₁_hi⟩, hy₁_μ⟩ := hy₁
        obtain ⟨⟨hy₂_re, hy₂_lo, hy₂_hi⟩, hy₂_μ⟩ := hy₂
        have hy₁_μ' : y₁.im < H₀ - μ := hy₁_μ
        have hy₂_μ' : y₂.im < H₀ - μ := hy₂_μ
        rcases abs_lt.mp hy₁_re with ⟨hy₁_re1, hy₁_re2⟩
        rcases abs_lt.mp hy₂_re with ⟨hy₂_re1, hy₂_re2⟩
        refine ⟨⟨?_, ?_, ?_⟩, ?_⟩
        · rw [abs_lt]
          simp only [Complex.add_re, Complex.smul_re, smul_eq_mul]
          have hlin : a * y₁.re + b * y₂.re - x_edge =
              a * (y₁.re - x_edge) + b * (y₂.re - x_edge) := by
            have hb_eq : b = 1 - a := by linarith
            rw [hb_eq]; ring
          rw [hlin]
          have hlo1 : a * (-(R_0 / 8)) < a * (y₁.re - x_edge) :=
            mul_lt_mul_of_pos_left hy₁_re1 ha_pos
          have hlo2 : b * (-(R_0 / 8)) ≤ b * (y₂.re - x_edge) :=
            mul_le_mul_of_nonneg_left (le_of_lt hy₂_re1) hb
          have hhi1 : a * (y₁.re - x_edge) < a * (R_0 / 8) :=
            mul_lt_mul_of_pos_left hy₁_re2 ha_pos
          have hhi2 : b * (y₂.re - x_edge) ≤ b * (R_0 / 8) :=
            mul_le_mul_of_nonneg_left (le_of_lt hy₂_re2) hb
          have hsum_R : a * (R_0 / 8) + b * (R_0 / 8) = R_0 / 8 := by
            linear_combination (R_0 / 8) * hab
          constructor <;> linarith
        · simp only [Complex.add_im, Complex.smul_im, smul_eq_mul]; nlinarith
        · simp only [Complex.add_im, Complex.smul_im, smul_eq_mul]; nlinarith
        · change (a • y₁ + b • y₂).im < H₀ - μ
          simp only [Complex.add_im, Complex.smul_im, smul_eq_mul]; nlinarith

    have hS_plus_conv : Convex ℝ S_plus := by
      intro t₁ ht₁ t₂ ht₂ a b ha hb hab
      rcases eq_or_lt_of_le ha with rfl | ha_pos
      · have hb1 : b = 1 := by linarith
        subst hb1; simpa using ht₂
      · obtain ⟨_, ht₁_lt, ht₁_im⟩ := ht₁
        obtain ⟨_, ht₂_lt, ht₂_im⟩ := ht₂
        have hnorm_le : ‖a • t₁ + b • t₂‖ ≤ a * ‖t₁‖ + b * ‖t₂‖ := by
          calc ‖a • t₁ + b • t₂‖
              ≤ ‖a • t₁‖ + ‖b • t₂‖ := norm_add_le _ _
            _ = a * ‖t₁‖ + b * ‖t₂‖ := by
                rw [norm_smul, norm_smul, Real.norm_of_nonneg ha, Real.norm_of_nonneg hb]
        have him_eq : (a • t₁ + b • t₂).im = a * t₁.im + b * t₂.im := by
          simp [Complex.add_im]
        have hw_im_gt : ‖a • t₁ + b • t₂‖ / 3 < (a • t₁ + b • t₂).im := by
          rw [him_eq]; nlinarith
        have hw_im_le : (a • t₁ + b • t₂).im ≤ ‖a • t₁ + b • t₂‖ :=
          le_trans (le_abs_self _) (Complex.abs_im_le_norm _)
        refine ⟨?_, ?_, hw_im_gt⟩
        · linarith [norm_nonneg (a • t₁ + b • t₂)]
        · nlinarith

    have hU_plus_pre : IsPreconnected U_plus := (hY_conv.prod hS_plus_conv).isPreconnected

    
    let V_plus : Set (ℂ × ℂ) :=
      (Y_μ ∩ { y : ℂ | |y.im - y_row| < δ_slab / 2 }) ×ˢ S_plus
    have hV_plus_open : IsOpen V_plus :=
      (hY_open.inter
        (isOpen_lt (continuous_abs.comp (Complex.continuous_im.sub continuous_const))
          continuous_const)).prod hS_plus_open
    have hV_plus_sub : V_plus ⊆ U_plus := fun _ hp => ⟨hp.1.1, hp.2⟩
    have hV_plus_ne : V_plus.Nonempty := by
      let y_seed : ℂ := (x_edge : ℂ) + (y_row : ℂ) * Complex.I
      let t_seed : ℂ := ((r_μ / 2 : ℝ) : ℂ) * Complex.I
      have ht_norm : ‖t_seed‖ = r_μ / 2 := by
        simp [t_seed, abs_of_pos hr_μ_pos]
      have ht_im : t_seed.im = r_μ / 2 := by simp [t_seed]
      refine ⟨(y_seed, t_seed), ⟨⟨⟨?_, ?_, ?_⟩, ?_⟩, ?_⟩, ⟨?_, ?_, ?_⟩⟩
      · simp [y_seed]; linarith [P.R_0_pos]
      · simp [y_seed]; linarith [P.δ_slab_pos]
      · simp [y_seed]; linarith [P.y_row_bounds.2, P.R_0_pos]
      · simp [y_seed]; exact hy_μ
      · simp [y_seed]; linarith [P.δ_slab_pos]
      · rw [ht_norm]; linarith
      · rw [ht_norm]; linarith
      · rw [ht_norm, ht_im]; linarith

    have hAg_V_plus : MeroAgreesHolo (W.L_mero i) (Λ_steep i) V_plus := by
      refine ⟨Set.Subset.trans hV_plus_sub (Set.Subset.trans hU_plus_sub_U hU_sub_T),
        fun p hp => ?_⟩
      have hp_slabL : p ∈ { q : ℂ × ℂ |
          |q.1.re - x_edge| < R_0 / 2 + δ_slab ∧
          |q.1.im - y_row| < δ_slab ∧
          ‖q.2‖ < δ_t } := by
        have him_p : |p.1.im - y_row| < δ_slab / 2 := hp.1.2
        refine ⟨?_, ?_, ?_⟩
        · linarith [hp.1.1.1.1, P.R_0_pos, P.δ_slab_pos]
        · linarith [P.δ_slab_pos]
        · have h1 : ‖p.2‖ < r_steep := lt_of_lt_of_le hp.2.2.1 hr_μ_le
          linarith [lt_of_lt_of_le h1 hr_le_dt, P.δ_t_pos]
      obtain ⟨r₁, hr₁_pos, hr₁_rad, _, hr₁_eq⟩ := (P.slab_agrees_L i).2 p hp_slabL
      obtain ⟨r₂, hr₂_pos, hr₂_sub⟩ := Metric.isOpen_iff.mp hV_plus_open p hp
      refine ⟨min r₁ r₂, lt_min hr₁_pos hr₂_pos, le_trans (min_le_left _ _) hr₁_rad,
        Set.Subset.trans (Metric.ball_subset_ball (min_le_right _ _)) hr₂_sub, fun q hq => ?_⟩
      have hqV : q ∈ V_plus := hr₂_sub (Metric.ball_subset_ball (min_le_right _ _) hq)
      have hq_im_pos : 0 < q.2.im := by linarith [hqV.2.2.2, norm_nonneg q.2]
      have hq_Ω0 : q ∈ Ω_N 0 := by
        have him_q : |q.1.im - y_row| < δ_slab / 2 := hqV.1.2
        refine ⟨hqV.1.1.1, ⟨hqV.2.1, lt_of_lt_of_le hqV.2.2.1 hr_μ_le, hqV.2.2.2⟩, ?_⟩
        rw [hshift_im]
        simp only [Nat.cast_zero, zero_mul, sub_zero]
        linarith [P.δ_slab_pos]
      have hΛ_eq : Λ_steep i q =
          P.L_line i (P.V_slab q, P.V_slab (q.1 + q.2, q.2) - P.V_slab q) := by
        dsimp [Λ_steep]
        rw [if_pos hq_im_pos, hΛ_up_base i q hq_Ω0]
      rw [hΛ_eq]
      exact hr₁_eq q (Metric.ball_subset_ball (min_le_left _ _) hq)

    have hΛ_holo_U : DifferentiableOn ℂ (Λ_steep i) U_μ :=
      (hΛ_steep_holo i).mono (fun p hp => ⟨hp.1.1, hp.2.1⟩)

    have hAg_U_plus : MeroAgreesHolo (W.L_mero i) (Λ_steep i) U_plus :=
      hMeroCont (W.L_mero i) (Λ_steep i) U_plus V_plus hU_plus_open hU_plus_pre
        (Set.Subset.trans hU_plus_sub_U hU_sub_T) (hΛ_holo_U.mono hU_plus_sub_U)
        hV_plus_open hV_plus_ne hV_plus_sub hAg_V_plus

    
    refine ⟨hU_sub_T, fun p hp => ?_⟩
    have him_ne : p.2.im ≠ 0 := by
      intro h0
      have h1 := hp.2.1.2.2
      rw [h0, abs_zero] at h1
      linarith [hp.2.1.1]
    rcases lt_or_gt_of_ne him_ne with him_neg | him_pos
    · 
      have hp_minus : p ∈ U_minus := by
        have ht_ball := hp.2.2
        rw [Metric.mem_ball, dist_zero_right] at ht_ball
        have ht_im := hp.2.1.2.2
        rw [abs_of_neg him_neg] at ht_im
        exact ⟨hp.1, by simpa [σ] using hp.2.1.1, by simpa [σ] using ht_ball,
          by simpa [σ] using ht_im⟩
      let p' := σ p
      have hp'_plus : p' ∈ U_plus := hp_minus
      have hp_T : p ∈ T_mero := hU_sub_T hp
      have hp'_T : p' ∈ T_mero := hU_sub_T (hU_plus_sub_U hp'_plus)
      obtain ⟨r₁, hr₁_pos, hr₁_rad, _, hr₁_eq⟩ := hAg_U_plus.2 p' hp'_plus
      obtain ⟨r₂, hr₂_pos, hr₂_sub⟩ := Metric.isOpen_iff.mp hU_minus_open p hp_minus
      let r := min (min ((W.L_mero i).rad p) ((W.L_mero i).rad p')) (min r₁ r₂)
      have hr_pos : 0 < r :=
        lt_min (lt_min ((W.L_mero i).rad_pos p hp_T) ((W.L_mero i).rad_pos p' hp'_T))
          (lt_min hr₁_pos hr₂_pos)
      have hr_le_rad : r ≤ (W.L_mero i).rad p :=
        le_trans (min_le_left _ _) (min_le_left _ _)
      have hr_le_rad' : r ≤ (W.L_mero i).rad p' :=
        le_trans (min_le_left _ _) (min_le_right _ _)
      have hr_le_r1 : r ≤ r₁ := le_trans (min_le_right _ _) (min_le_left _ _)
      have hr_le_r2 : r ≤ r₂ := le_trans (min_le_right _ _) (min_le_right _ _)
      have hball_sub_U : Metric.ball p r ⊆ U_μ :=
        Set.Subset.trans (Metric.ball_subset_ball hr_le_r2)
          (Set.Subset.trans hr₂_sub hU_minus_sub_U)
      refine ⟨r, hr_pos, hr_le_rad, hball_sub_U, ?_⟩
      let Δ_p : ℂ × ℂ → ℂ :=
        fun q => (W.L_mero i).num p q - Λ_steep i q * (W.L_mero i).den p q
      have hΔ_prod_zero : ∀ q ∈ Metric.ball p r,
          Δ_p q * (W.L_mero i).den p' (σ q) = 0 := by
        intro q hq
        have hq_even_ball :
            q ∈ Metric.ball p (min ((W.L_mero i).rad p) ((W.L_mero i).rad p')) :=
          Metric.ball_subset_ball (min_le_left _ _) hq
        have heven := (P.L_mero_even i p hp_T).2 q hq_even_ball
        have hσq_r1 : σ q ∈ Metric.ball p' r₁ := by
          rw [Metric.mem_ball, hσ_dist]
          exact lt_of_lt_of_le (Metric.mem_ball.mp hq) hr_le_r1
        have hq'_eq := hr₁_eq (σ q) hσq_r1
        have hq_minus : q ∈ U_minus := hr₂_sub (Metric.ball_subset_ball hr_le_r2 hq)
        have hσq_im_pos : 0 < (σ q).2.im := by
          linarith [hq_minus.2.2.2, norm_nonneg (σ q).2]
        have hq_im_neg : q.2.im < 0 := by
          have h1 : (σ q).2.im = -q.2.im := rfl
          linarith
        have hΛ_sym : Λ_steep i q = Λ_steep i (σ q) := by
          dsimp [Λ_steep]
          rw [if_neg (not_lt.mpr (le_of_lt hq_im_neg)), if_pos hσq_im_pos]
        dsimp [Δ_p]
        rw [hΛ_sym]
        change ((W.L_mero i).num p q - Λ_steep i (σ q) * (W.L_mero i).den p q) *
            (W.L_mero i).den p' (σ q) = 0
        dsimp only [p', σ] at hq'_eq ⊢
        linear_combination heven + hq'_eq * (W.L_mero i).den p q
      have hDen'_nz : ∃ q'_0 ∈ Metric.ball p' r, (W.L_mero i).den p' q'_0 ≠ 0 := by
        by_contra hAllZero
        push_neg at hAllZero
        have hZeroAll : ∀ q' ∈ Metric.ball p' ((W.L_mero i).rad p'),
            (W.L_mero i).den p' q' = 0 :=
          hEqZeroBall Metric.isOpen_ball ⟨p', Metric.mem_ball_self hr_pos⟩
            (Metric.ball_subset_ball hr_le_rad') ((W.L_mero i).den_holo p' hp'_T) hAllZero
        obtain ⟨q_nz, hq_nz_mem, hq_nz⟩ := (W.L_mero i).den_ne_zero p' hp'_T
        exact hq_nz (hZeroAll q_nz hq_nz_mem)
      obtain ⟨q'_0, hq'_0_mem, hq'_0_nz⟩ := hDen'_nz
      let q₀ := σ q'_0
      have hσ_q0 : σ q₀ = q'_0 := hσ_invol q'_0
      have hq₀_mem : q₀ ∈ Metric.ball p r := by
        rw [Metric.mem_ball, ← hσ_dist, hσ_q0]
        exact hq'_0_mem
      have hDen_comp_cont : ContinuousAt (fun q => (W.L_mero i).den p' (σ q)) q₀ := by
        have h1 : ContinuousAt ((W.L_mero i).den p') (σ q₀) :=
          ((W.L_mero i).den_holo p' hp'_T).continuousOn.continuousAt
            (Metric.isOpen_ball.mem_nhds
              (Metric.ball_subset_ball hr_le_rad' (by rwa [hσ_q0])))
        exact h1.comp hσ_cont.continuousAt
      have hq₀_nz : (W.L_mero i).den p' (σ q₀) ≠ 0 := by rwa [hσ_q0]
      have hSubNhds :
          (Metric.ball p r ∩ { q | (W.L_mero i).den p' (σ q) ≠ 0 }) ∈ nhds q₀ :=
        Filter.inter_mem (Metric.isOpen_ball.mem_nhds hq₀_mem)
          (hDen_comp_cont.eventually_ne hq₀_nz)
      obtain ⟨η, hη_pos, hη_sub⟩ := Metric.mem_nhds_iff.mp hSubNhds
      have hΔ_holo : DifferentiableOn ℂ Δ_p (Metric.ball p r) :=
        (((W.L_mero i).num_holo p hp_T).mono (Metric.ball_subset_ball hr_le_rad)).sub
          ((hΛ_holo_U.mono hball_sub_U).mul
            (((W.L_mero i).den_holo p hp_T).mono (Metric.ball_subset_ball hr_le_rad)))
      have hΔ_sub : ∀ q ∈ Metric.ball q₀ η, Δ_p q = 0 := by
        intro q hq
        obtain ⟨hq_r, hnz⟩ := hη_sub hq
        exact (mul_eq_zero.mp (hΔ_prod_zero q hq_r)).resolve_right hnz
      intro q hq
      have h0 : Δ_p q = 0 :=
        hEqZeroBall Metric.isOpen_ball ⟨q₀, Metric.mem_ball_self hη_pos⟩
          (fun z hz => (hη_sub hz).1) hΔ_holo hΔ_sub q hq
      exact sub_eq_zero.mp h0
    · 
      have hp_plus : p ∈ U_plus := by
        have ht_ball := hp.2.2
        rw [Metric.mem_ball, dist_zero_right] at ht_ball
        have ht_im := hp.2.1.2.2
        rw [abs_of_pos him_pos] at ht_im
        exact ⟨hp.1, hp.2.1.1, ht_ball, ht_im⟩
      obtain ⟨r₁, hr₁_pos, hr₁_rad, hr₁_sub, hr₁_eq⟩ := hAg_U_plus.2 p hp_plus
      exact ⟨r₁, hr₁_pos, hr₁_rad, Set.Subset.trans hr₁_sub hU_plus_sub_U, hr₁_eq⟩

  
  exact ⟨{
    H₀_ge := P.H₀_ge
    R_0_pos := P.R_0_pos
    R_0_lt := P.R_0_lt
    y_row_bounds := P.y_row_bounds
    δ_slab_pos := P.δ_slab_pos
    r_steep := r_steep
    r_steep_pos := hr_steep_pos
    r_steep_le := hr_le_base
    Λ_steep := Λ_steep
    Λ_steep_holo := hΛ_steep_holo
    Λ_steep_agrees := hΛ_steep_agrees
  }⟩

theorem quadratic_disk_wall_contradiction (Ω : Set Plane)
    (C : AnalyticGlancingCollar Ω)
    (hDet : EndpointDeterminationData C)
    (W : CollarWidthTubeData C hDet)
    (H₀ x_edge R_0 y_row δ_slab : ℝ)
    (hHX : W.h_X 0 = ENNReal.ofReal H₀)
    (hDisk : MeroDiskContinuationProp)
    (hNoPatch : NoPatchAtRealProp W)
    (S : SteepCorridorDualLineData W H₀ x_edge R_0 y_row δ_slab) :
    False :=
by
  classical
  
  have hId2D : ∀ {W_dom V_dom : Set (ℂ × ℂ)},
      IsOpen W_dom → IsPreconnected W_dom → IsOpen V_dom → V_dom.Nonempty → V_dom ⊆ W_dom →
      ∀ {f : ℂ × ℂ → ℂ}, DifferentiableOn ℂ f W_dom → (∀ p ∈ V_dom, f p = 0) →
      ∀ p ∈ W_dom, f p = 0 := by
    intro W_dom V_dom hWo hWp hVo hVne hVW f hf hzero
    have hBallZero : ∀ {p₀ : ℂ × ℂ} {r : ℝ} {U_z : Set (ℂ × ℂ)},
        0 < r → Metric.ball p₀ r ⊆ W_dom → IsOpen U_z →
        (∀ x ∈ U_z, f x = 0) → (Metric.ball p₀ r ∩ U_z).Nonempty →
        ∀ q ∈ Metric.ball p₀ r, f q = 0 := by
      intro p₀ r U_z hr hsub hUzo hUz0 ⟨p₁, hp₁_ball, hp₁_Uz⟩ q hq_ball
      let γ : ℂ → ℂ × ℂ := fun z => (p₁.1 + z * (q.1 - p₁.1), p₁.2 + z * (q.2 - p₁.2))
      have hγ_diff : Differentiable ℂ γ :=
        ((differentiable_const _).add (differentiable_id.mul (differentiable_const _))).prodMk
          ((differentiable_const _).add (differentiable_id.mul (differentiable_const _)))
      let Ω_z : Set ℂ := γ ⁻¹' Metric.ball p₀ r
      have hΩz_open : IsOpen Ω_z := Metric.isOpen_ball.preimage hγ_diff.continuous
      have hΩz_conv : Convex ℝ Ω_z := by
        intro z₁ hz₁ z₂ hz₂ a b ha hb hab
        have habC : (a : ℂ) + (b : ℂ) = 1 := by exact_mod_cast hab
        have hlin : γ (a • z₁ + b • z₂) = a • γ z₁ + b • γ z₂ := by
          apply Prod.ext
          · simp only [γ, Prod.smul_fst, Prod.fst_add, Complex.real_smul]
            push_cast
            linear_combination -p₁.1 * habC
          · simp only [γ, Prod.smul_snd, Prod.snd_add, Complex.real_smul]
            push_cast
            linear_combination -p₁.2 * habC
        change γ (a • z₁ + b • z₂) ∈ Metric.ball p₀ r
        rw [hlin]
        exact convex_ball p₀ r hz₁ hz₂ ha hb hab
      have h0_mem : (0 : ℂ) ∈ Ω_z := by
        change γ 0 ∈ Metric.ball p₀ r
        have hγ0 : γ 0 = p₁ := by apply Prod.ext <;> simp [γ]
        rwa [hγ0]
      have h1_mem : (1 : ℂ) ∈ Ω_z := by
        change γ 1 ∈ Metric.ball p₀ r
        have hγ1 : γ 1 = q := by apply Prod.ext <;> simp [γ]
        rwa [hγ1]
      have hg_ana : AnalyticOnNhd ℂ (fun z => f (γ z)) Ω_z :=
        ((hf.mono hsub).comp hγ_diff.differentiableOn (fun _ hz => hz)).analyticOnNhd hΩz_open
      have h_ev : (fun z => f (γ z)) =ᶠ[nhds (0 : ℂ)] 0 := by
        refine Filter.eventuallyEq_iff_exists_mem.mpr
          ⟨γ ⁻¹' U_z, (hUzo.preimage hγ_diff.continuous).mem_nhds ?_, fun z hz => hUz0 (γ z) hz⟩
        change γ 0 ∈ U_z
        have hγ0 : γ 0 = p₁ := by apply Prod.ext <;> simp [γ]
        rwa [hγ0]
      have h1_eq := hg_ana.eqOn_zero_of_preconnected_of_eventuallyEq_zero
        hΩz_conv.isPreconnected h0_mem h_ev h1_mem
      have hγ1 : γ 1 = q := by apply Prod.ext <;> simp [γ]
      simpa only [hγ1, Pi.zero_apply] using h1_eq
    let U_z : Set (ℂ × ℂ) :=
      { p ∈ W_dom | ∃ r : ℝ, 0 < r ∧ Metric.ball p r ⊆ W_dom ∧ ∀ q ∈ Metric.ball p r, f q = 0 }
    have hUzo : IsOpen U_z := by
      refine Metric.isOpen_iff.mpr (fun p ⟨_, r, hr, hsub, hzr⟩ => ?_)
      refine ⟨r / 2, half_pos hr, fun p' hp' => ?_⟩
      have hsub_half : Metric.ball p' (r / 2) ⊆ Metric.ball p r := by
        intro q hq
        rw [Metric.mem_ball] at hp' hq ⊢
        linarith [dist_triangle q p' p]
      exact ⟨hsub (hsub_half (Metric.mem_ball_self (half_pos hr))),
        r / 2, half_pos hr, Set.Subset.trans hsub_half hsub, fun q hq => hzr q (hsub_half hq)⟩
    obtain ⟨v₀, hv₀⟩ := hVne
    obtain ⟨rv, hrv_pos, hrv_sub⟩ := Metric.isOpen_iff.mp (hVo.inter hWo) v₀ ⟨hv₀, hVW hv₀⟩
    have hUz_ne : (W_dom ∩ U_z).Nonempty :=
      ⟨v₀, hVW hv₀, hVW hv₀, rv, hrv_pos, fun q hq => (hrv_sub hq).2,
        fun q hq => hzero q (hrv_sub hq).1⟩
    have hUz_cl : closure U_z ∩ W_dom ⊆ U_z := by
      intro p₀ ⟨hp₀_cl, hp₀W⟩
      obtain ⟨r, hr, hsub⟩ := Metric.isOpen_iff.mp hWo p₀ hp₀W
      obtain ⟨p₁, hp₁_Uz, hp₁_dist⟩ := Metric.mem_closure_iff.mp hp₀_cl r hr
      have hp₁_in : p₁ ∈ Metric.ball p₀ r := by rw [Metric.mem_ball, dist_comm]; exact hp₁_dist
      exact ⟨hp₀W, r, hr, hsub, hBallZero hr hsub hUzo
        (fun x ⟨_, rx, hrx, _, hzrx⟩ => hzrx x (Metric.mem_ball_self hrx))
        ⟨p₁, hp₁_in, hp₁_Uz⟩⟩
    have hW_sub : W_dom ⊆ U_z := hWp.subset_of_closure_inter_subset hUzo hUz_ne hUz_cl
    intro p hp
    obtain ⟨_, r, hr, _, hzr⟩ := hW_sub hp
    exact hzr p (Metric.mem_ball_self hr)

  
  have exists_ne_zero_on_open :
      ∀ {B_dom V_dom : Set (ℂ × ℂ)} {g : ℂ × ℂ → ℂ},
        IsOpen B_dom → IsPreconnected B_dom → DifferentiableOn ℂ g B_dom →
        (∃ q₀ ∈ B_dom, g q₀ ≠ 0) →
        IsOpen V_dom → V_dom.Nonempty → V_dom ⊆ B_dom →
        ∃ x ∈ V_dom, g x ≠ 0 := by
    intro B_dom V_dom g hBo hBp hg ⟨q₀, hq₀B, hq₀_ne⟩ hVo hVne hVB
    by_contra h_all
    push_neg at h_all
    exact hq₀_ne (hId2D hBo hBp hVo hVne hVB hg h_all q₀ hq₀B)

  have cancel_holo_of_ne_zero :
      ∀ {U_dom B_dom V_dom : Set (ℂ × ℂ)} {h g : ℂ × ℂ → ℂ},
        IsOpen U_dom → IsPreconnected U_dom → DifferentiableOn ℂ h U_dom →
        IsOpen B_dom → IsPreconnected B_dom → DifferentiableOn ℂ g B_dom →
        (∃ q₀ ∈ B_dom, g q₀ ≠ 0) →
        IsOpen V_dom → V_dom.Nonempty → V_dom ⊆ U_dom → V_dom ⊆ B_dom →
        (∀ q ∈ V_dom, h q * g q = 0) →
        ∀ q ∈ U_dom, h q = 0 := by
    intro U_dom B_dom V_dom h g hUo hUp hh hBo hBp hg hq₀ hVo hVne hVU hVB hprod
    obtain ⟨x₁, hx₁V, hx₁_ne⟩ := exists_ne_zero_on_open hBo hBp hg hq₀ hVo hVne hVB
    have hg_contAt : ContinuousAt g x₁ :=
      hg.continuousOn.continuousAt (hBo.mem_nhds (hVB hx₁V))
    obtain ⟨δ₁, hδ₁_pos, hδ₁_dist⟩ :=
      Metric.continuousAt_iff.mp hg_contAt ‖g x₁‖ (norm_pos_iff.mpr hx₁_ne)
    obtain ⟨δ₂, hδ₂_pos, hδ₂_sub⟩ := Metric.isOpen_iff.mp hVo x₁ hx₁V
    let η₁ : ℝ := min δ₁ δ₂
    have hη₁_pos : 0 < η₁ := lt_min hδ₁_pos hδ₂_pos
    have hball_U : Metric.ball x₁ η₁ ⊆ U_dom :=
      Set.Subset.trans (Metric.ball_subset_ball (min_le_right _ _)) (Set.Subset.trans hδ₂_sub hVU)
    have hzero_ball : ∀ q ∈ Metric.ball x₁ η₁, h q = 0 := by
      intro q hq
      have hqV : q ∈ V_dom := hδ₂_sub (Metric.ball_subset_ball (min_le_right _ _) hq)
      have hq_dist : dist q x₁ < δ₁ :=
        lt_of_lt_of_le (Metric.mem_ball.mp hq) (min_le_left _ _)
      have hgq_ne : g q ≠ 0 := by
        intro hgq0
        have hd := hδ₁_dist hq_dist
        rw [hgq0, dist_zero_left] at hd
        exact lt_irrefl _ hd
      exact (mul_eq_zero.mp (hprod q hqV)).resolve_right hgq_ne
    exact hId2D hUo hUp Metric.isOpen_ball ⟨x₁, Metric.mem_ball_self hη₁_pos⟩ hball_U hh hzero_ball

  have meroEqOn_symm :
      ∀ {W₁ W₂ : Set (ℂ × ℂ)} {F₁ : MeroOn2D W₁} {F₂ : MeroOn2D W₂} {U : Set (ℂ × ℂ)},
        MeroEqOn F₁ F₂ U → MeroEqOn F₂ F₁ U := by
    intro W₁ W₂ F₁ F₂ U h
    refine ⟨fun p hp => ⟨(h.1 hp).2, (h.1 hp).1⟩, fun p hp q hq => ?_⟩
    rw [min_comm] at hq
    exact (h.2 p hp q hq).symm

  have meroEqOn_mono :
      ∀ {W₁ W₂ : Set (ℂ × ℂ)} {F₁ : MeroOn2D W₁} {F₂ : MeroOn2D W₂} {U V : Set (ℂ × ℂ)},
        V ⊆ U → MeroEqOn F₁ F₂ U → MeroEqOn F₁ F₂ V := by
    intro W₁ W₂ F₁ F₂ U V hVU h
    exact ⟨Set.Subset.trans hVU h.1, fun p hp => h.2 p (hVU hp)⟩

  have meroEqOn_of_num_den_eq :
      ∀ {W₁ W₂ : Set (ℂ × ℂ)} (F₁ : MeroOn2D W₁) (F₂ : MeroOn2D W₂) (U : Set (ℂ × ℂ)),
        U ⊆ W₁ ∩ W₂ →
        (∀ p ∈ U, ∀ q, F₁.num p q = F₂.num p q ∧ F₁.den p q = F₂.den p q) →
        MeroEqOn F₁ F₂ U := by
    intro W₁ W₂ F₁ F₂ U hsub heq
    refine ⟨hsub, fun p hp q _ => ?_⟩
    rw [(heq p hp q).1, (heq p hp q).2]

  have meroEqOn_trans :
      ∀ {W₁ W₂ W₃ : Set (ℂ × ℂ)} {F₁ : MeroOn2D W₁} {F₂ : MeroOn2D W₂} {F₃ : MeroOn2D W₃}
        {U : Set (ℂ × ℂ)},
        MeroEqOn F₁ F₂ U → MeroEqOn F₂ F₃ U → MeroEqOn F₁ F₃ U := by
    intro W₁ W₂ W₃ F₁ F₂ F₃ U h₁₂ h₂₃
    refine ⟨fun p hp => ⟨(h₁₂.1 hp).1, (h₂₃.1 hp).2⟩, fun p hp q hq => ?_⟩
    have hp₁ : p ∈ W₁ := (h₁₂.1 hp).1
    have hp₂ : p ∈ W₂ := (h₁₂.1 hp).2
    have hp₃ : p ∈ W₃ := (h₂₃.1 hp).2
    let r₁₃ : ℝ := min (F₁.rad p) (F₃.rad p)
    have hr₁₃_pos : 0 < r₁₃ := lt_min (F₁.rad_pos p hp₁) (F₃.rad_pos p hp₃)
    let r₁₂₃ : ℝ := min r₁₃ (F₂.rad p)
    have hr₁₂₃_pos : 0 < r₁₂₃ := lt_min hr₁₃_pos (F₂.rad_pos p hp₂)
    have hh_holo : DifferentiableOn ℂ
        (fun z => F₁.num p z * F₃.den p z - F₃.num p z * F₁.den p z) (Metric.ball p r₁₃) :=
      (((F₁.num_holo p hp₁).mono (Metric.ball_subset_ball (min_le_left _ _))).mul
        ((F₃.den_holo p hp₃).mono (Metric.ball_subset_ball (min_le_right _ _)))).sub
      (((F₃.num_holo p hp₃).mono (Metric.ball_subset_ball (min_le_right _ _))).mul
        ((F₁.den_holo p hp₁).mono (Metric.ball_subset_ball (min_le_left _ _))))
    have hprod : ∀ z ∈ Metric.ball p r₁₂₃,
        (F₁.num p z * F₃.den p z - F₃.num p z * F₁.den p z) * F₂.den p z = 0 := by
      intro z hz
      have hz₁₂ : z ∈ Metric.ball p (min (F₁.rad p) (F₂.rad p)) := by
        refine Metric.mem_ball.mpr (lt_of_lt_of_le (Metric.mem_ball.mp hz) ?_)
        exact le_min (le_trans (min_le_left _ _) (min_le_left _ _)) (min_le_right _ _)
      have hz₂₃ : z ∈ Metric.ball p (min (F₂.rad p) (F₃.rad p)) := by
        refine Metric.mem_ball.mpr (lt_of_lt_of_le (Metric.mem_ball.mp hz) ?_)
        exact le_min (min_le_right _ _) (le_trans (min_le_left _ _) (min_le_right _ _))
      have e₁₂ := h₁₂.2 p hp z hz₁₂
      have e₂₃ := h₂₃.2 p hp z hz₂₃
      linear_combination e₁₂ * F₃.den p z + e₂₃ * F₁.den p z
    have hzero := cancel_holo_of_ne_zero
      Metric.isOpen_ball (convex_ball p r₁₃).isPreconnected hh_holo
      Metric.isOpen_ball (convex_ball p (F₂.rad p)).isPreconnected
      (F₂.den_holo p hp₂) (F₂.den_ne_zero p hp₂)
      Metric.isOpen_ball ⟨p, Metric.mem_ball_self hr₁₂₃_pos⟩
      (Metric.ball_subset_ball (min_le_left _ _))
      (Metric.ball_subset_ball (min_le_right _ _))
      hprod q hq
    exact sub_eq_zero.mp hzero

  have meroEq_step :
      ∀ {W₁ W₂ : Set (ℂ × ℂ)} (G₁ : MeroOn2D W₁) (G₂ : MeroOn2D W₂) {p₀ p₁ : ℂ × ℂ},
        p₀ ∈ W₁ ∩ W₂ → p₁ ∈ W₁ ∩ W₂ →
        (Metric.ball p₀ (min (G₁.rad p₀) (G₂.rad p₀)) ∩
          Metric.ball p₁ (min (G₁.rad p₁) (G₂.rad p₁))).Nonempty →
        (∀ q ∈ Metric.ball p₀ (min (G₁.rad p₀) (G₂.rad p₀)),
          G₁.num p₀ q * G₂.den p₀ q = G₂.num p₀ q * G₁.den p₀ q) →
        ∀ q ∈ Metric.ball p₁ (min (G₁.rad p₁) (G₂.rad p₁)),
          G₁.num p₁ q * G₂.den p₁ q = G₂.num p₁ q * G₁.den p₁ q := by
    intro W₁ W₂ G₁ G₂ p₀ p₁ hp₀ hp₁ hVne hp₀_eq
    let r₀ : ℝ := min (G₁.rad p₀) (G₂.rad p₀)
    let r₁ : ℝ := min (G₁.rad p₁) (G₂.rad p₁)
    let V : Set (ℂ × ℂ) := Metric.ball p₀ r₀ ∩ Metric.ball p₁ r₁
    have hVo : IsOpen V := Metric.isOpen_ball.inter Metric.isOpen_ball
    have hVp : IsPreconnected V := ((convex_ball p₀ r₀).inter (convex_ball p₁ r₁)).isPreconnected
    let h₁ : ℂ × ℂ → ℂ := fun z => G₁.num p₁ z * G₂.den p₁ z - G₂.num p₁ z * G₁.den p₁ z
    have hh₁_holo : DifferentiableOn ℂ h₁ (Metric.ball p₁ r₁) :=
      (((G₁.num_holo p₁ hp₁.1).mono (Metric.ball_subset_ball (min_le_left _ _))).mul
        ((G₂.den_holo p₁ hp₁.2).mono (Metric.ball_subset_ball (min_le_right _ _)))).sub
      (((G₂.num_holo p₁ hp₁.2).mono (Metric.ball_subset_ball (min_le_right _ _))).mul
        ((G₁.den_holo p₁ hp₁.1).mono (Metric.ball_subset_ball (min_le_left _ _))))
    have hV_sub_G₁₀ : V ⊆ Metric.ball p₀ (G₁.rad p₀) :=
      Set.Subset.trans Set.inter_subset_left (Metric.ball_subset_ball (min_le_left _ _))
    have hV_sub_G₂₀ : V ⊆ Metric.ball p₀ (G₂.rad p₀) :=
      Set.Subset.trans Set.inter_subset_left (Metric.ball_subset_ball (min_le_right _ _))
    have hprod2 : ∀ z ∈ V, (h₁ z * G₁.den p₀ z) * G₂.den p₀ z = 0 := by
      intro z hz
      have c₁ := G₁.compat p₀ hp₀.1 p₁ hp₁.1 z
        ⟨hV_sub_G₁₀ hz, Metric.ball_subset_ball (min_le_left _ _) hz.2⟩
      have c₂ := G₂.compat p₀ hp₀.2 p₁ hp₁.2 z
        ⟨hV_sub_G₂₀ hz, Metric.ball_subset_ball (min_le_right _ _) hz.2⟩
      have e₀ := hp₀_eq z hz.1
      dsimp only [h₁]
      calc ((G₁.num p₁ z * G₂.den p₁ z - G₂.num p₁ z * G₁.den p₁ z) * G₁.den p₀ z) * G₂.den p₀ z
          = (G₁.num p₁ z * G₁.den p₀ z) * G₂.den p₁ z * G₂.den p₀ z -
            (G₂.num p₁ z * G₂.den p₀ z) * G₁.den p₁ z * G₁.den p₀ z := by ring
        _ = (G₁.num p₀ z * G₁.den p₁ z) * G₂.den p₁ z * G₂.den p₀ z -
            (G₂.num p₀ z * G₂.den p₁ z) * G₁.den p₁ z * G₁.den p₀ z := by rw [← c₁, ← c₂]
        _ = (G₁.num p₀ z * G₂.den p₀ z - G₂.num p₀ z * G₁.den p₀ z) *
            (G₁.den p₁ z * G₂.den p₁ z) := by ring
        _ = 0 := by rw [e₀]; ring
    have hprod1 : ∀ z ∈ V, h₁ z * G₁.den p₀ z = 0 :=
      cancel_holo_of_ne_zero hVo hVp
        ((hh₁_holo.mono Set.inter_subset_right).mul ((G₁.den_holo p₀ hp₀.1).mono hV_sub_G₁₀))
        Metric.isOpen_ball (convex_ball p₀ (G₂.rad p₀)).isPreconnected
        (G₂.den_holo p₀ hp₀.2) (G₂.den_ne_zero p₀ hp₀.2)
        hVo hVne Set.Subset.rfl hV_sub_G₂₀ hprod2
    have hzero : ∀ z ∈ Metric.ball p₁ r₁, h₁ z = 0 :=
      cancel_holo_of_ne_zero
        Metric.isOpen_ball (convex_ball p₁ r₁).isPreconnected hh₁_holo
        Metric.isOpen_ball (convex_ball p₀ (G₁.rad p₀)).isPreconnected
        (G₁.den_holo p₀ hp₀.1) (G₁.den_ne_zero p₀ hp₀.1)
        hVo hVne Set.inter_subset_right hV_sub_G₁₀ hprod1
    intro q hq
    exact sub_eq_zero.mp (hzero q hq)

  have meroEqOn_of_preconnected :
      ∀ {W₁ W₂ : Set (ℂ × ℂ)} (G₁ : MeroOn2D W₁) (G₂ : MeroOn2D W₂)
        {U_ov V : Set (ℂ × ℂ)},
        IsOpen U_ov → IsPreconnected U_ov → U_ov ⊆ W₁ ∩ W₂ →
        V.Nonempty → V ⊆ U_ov → MeroEqOn G₁ G₂ V →
        MeroEqOn G₁ G₂ U_ov := by
    intro W₁ W₂ G₁ G₂ U_ov V hUo hUp hU_sub ⟨v₀, hv₀⟩ hVU hEqV
    let E_eq : Set (ℂ × ℂ) :=
      { p ∈ U_ov | ∀ q ∈ Metric.ball p (min (G₁.rad p) (G₂.rad p)),
          G₁.num p q * G₂.den p q = G₂.num p q * G₁.den p q }
    have hEo : IsOpen E_eq := by
      refine Metric.isOpen_iff.mpr (fun p₀ hp₀ => ?_)
      obtain ⟨δ_u, hδ_u_pos, hδ_u_sub⟩ := Metric.isOpen_iff.mp hUo p₀ hp₀.1
      have hp₀W := hU_sub hp₀.1
      let r₀ : ℝ := min (G₁.rad p₀) (G₂.rad p₀)
      have hr₀_pos : 0 < r₀ := lt_min (G₁.rad_pos p₀ hp₀W.1) (G₂.rad_pos p₀ hp₀W.2)
      refine ⟨min δ_u r₀, lt_min hδ_u_pos hr₀_pos, fun p₁ hp₁ => ?_⟩
      have hp₁U : p₁ ∈ U_ov := hδ_u_sub (Metric.ball_subset_ball (min_le_left _ _) hp₁)
      have hp₁W := hU_sub hp₁U
      have hr₁_pos : 0 < min (G₁.rad p₁) (G₂.rad p₁) :=
        lt_min (G₁.rad_pos p₁ hp₁W.1) (G₂.rad_pos p₁ hp₁W.2)
      refine ⟨hp₁U, meroEq_step G₁ G₂ hp₀W hp₁W
        ⟨p₁, Metric.ball_subset_ball (min_le_right _ _) hp₁, Metric.mem_ball_self hr₁_pos⟩ hp₀.2⟩
    have hE_ne : (U_ov ∩ E_eq).Nonempty :=
      ⟨v₀, hVU hv₀, hVU hv₀, hEqV.2 v₀ hv₀⟩
    have hE_cl : closure E_eq ∩ U_ov ⊆ E_eq := by
      intro p₁ ⟨hp₁_cl, hp₁U⟩
      have hp₁W := hU_sub hp₁U
      let r₁ : ℝ := min (G₁.rad p₁) (G₂.rad p₁)
      have hr₁_pos : 0 < r₁ := lt_min (G₁.rad_pos p₁ hp₁W.1) (G₂.rad_pos p₁ hp₁W.2)
      obtain ⟨p₀, hp₀E, hp₀_dist⟩ := Metric.mem_closure_iff.mp hp₁_cl r₁ hr₁_pos
      have hp₀W := hU_sub hp₀E.1
      have hr₀_pos : 0 < min (G₁.rad p₀) (G₂.rad p₀) :=
        lt_min (G₁.rad_pos p₀ hp₀W.1) (G₂.rad_pos p₀ hp₀W.2)
      have hp₀_in_p₁ : p₀ ∈ Metric.ball p₁ r₁ := by
        rw [Metric.mem_ball, dist_comm]
        exact hp₀_dist
      exact ⟨hp₁U, meroEq_step G₁ G₂ hp₀W hp₁W
        ⟨p₀, Metric.mem_ball_self hr₀_pos, hp₀_in_p₁⟩ hp₀E.2⟩
    have hsub : U_ov ⊆ E_eq := hUp.subset_of_closure_inter_subset hEo hE_ne hE_cl
    exact ⟨hU_sub, fun p hp => (hsub hp).2⟩

  have mkHoloMero :
      ∀ (U : Set (ℂ × ℂ)), IsOpen U → ∀ (f : ℂ × ℂ → ℂ), DifferentiableOn ℂ f U →
        ∃ H : MeroOn2D U,
          (∀ p q, H.num p q = f q ∧ H.den p q = 1) ∧
          (∀ {W_dom : Set (ℂ × ℂ)} (F : MeroOn2D W_dom) (V : Set (ℂ × ℂ)),
            V ⊆ U → MeroAgreesHolo F f V → MeroEqOn F H V) := by
    intro U hU f hf
    let rad_fn : ℂ × ℂ → ℝ := fun p =>
      if hp : p ∈ U then Classical.choose (Metric.isOpen_iff.mp hU p hp) else 1
    have hrad_spec : ∀ p (hp : p ∈ U), 0 < rad_fn p ∧ Metric.ball p (rad_fn p) ⊆ U := by
      intro p hp
      dsimp only [rad_fn]
      rw [dif_pos hp]
      exact Classical.choose_spec (Metric.isOpen_iff.mp hU p hp)
    let H : MeroOn2D U := {
      rad := rad_fn
      num := fun _ q => f q
      den := fun _ _ => 1
      rad_pos := fun p hp => (hrad_spec p hp).1
      ball_sub := fun p hp => (hrad_spec p hp).2
      num_holo := fun p hp => hf.mono (hrad_spec p hp).2
      den_holo := fun _ _ => (differentiable_const (1 : ℂ)).differentiableOn
      den_ne_zero := fun p hp => ⟨p, Metric.mem_ball_self (hrad_spec p hp).1, one_ne_zero⟩
      compat := fun _ _ _ _ _ _ => by ring
    }
    refine ⟨H, fun _ _ => ⟨rfl, rfl⟩, ?_⟩
    intro W_dom F V hVU hAg
    refine ⟨fun p hp => ⟨hAg.1 hp, hVU hp⟩, fun p hp q hq => ?_⟩
    have hpW : p ∈ W_dom := hAg.1 hp
    have hpU : p ∈ U := hVU hp
    let r_m : ℝ := min (F.rad p) (H.rad p)
    have hr_m_pos : 0 < r_m := lt_min (F.rad_pos p hpW) (H.rad_pos p hpU)
    obtain ⟨r_a, hr_a_pos, _, _, hr_a_eq⟩ := hAg.2 p hp
    let η_a : ℝ := min r_m r_a
    have hη_a_pos : 0 < η_a := lt_min hr_m_pos hr_a_pos
    have hh_holo : DifferentiableOn ℂ
        (fun z => F.num p z * (1 : ℂ) - f z * F.den p z) (Metric.ball p r_m) :=
      (((F.num_holo p hpW).mono (Metric.ball_subset_ball (min_le_left _ _))).mul
        (differentiable_const (1 : ℂ)).differentiableOn).sub
      ((hf.mono (Set.Subset.trans (Metric.ball_subset_ball (min_le_right _ _))
        (H.ball_sub p hpU))).mul
        ((F.den_holo p hpW).mono (Metric.ball_subset_ball (min_le_left _ _))))
    have hzero_sub : ∀ z ∈ Metric.ball p η_a, F.num p z * (1 : ℂ) - f z * F.den p z = 0 := by
      intro z hz
      have hza : z ∈ Metric.ball p r_a := Metric.ball_subset_ball (min_le_right _ _) hz
      rw [hr_a_eq z hza]
      ring
    have hzero := hId2D Metric.isOpen_ball (convex_ball p r_m).isPreconnected
      Metric.isOpen_ball ⟨p, Metric.mem_ball_self hη_a_pos⟩
      (Metric.ball_subset_ball (min_le_left _ _)) hh_holo hzero_sub q hq
    exact sub_eq_zero.mp hzero

  have mkGlueMero :
      ∀ {W₁ W₂ W_tgt : Set (ℂ × ℂ)},
        W₁ ⊆ W_tgt → W₂ ⊆ W_tgt → W_tgt ⊆ W₁ ∪ W₂ →
        ∀ (G₁ : MeroOn2D W₁) (G₂ : MeroOn2D W₂),
          MeroEqOn G₁ G₂ (W₁ ∩ W₂) →
          ∃ G_gl : MeroOn2D W_tgt, MeroEqOn G_gl G₁ W₁ := by
    intro W₁ W₂ W_tgt hW₁ hW₂ hcov G₁ G₂ hEq
    have hCross : ∀ p₁ ∈ W₁, ∀ p₂ ∈ W₂,
        ∀ q₀ ∈ Metric.ball p₁ (G₁.rad p₁) ∩ Metric.ball p₂ (G₂.rad p₂),
          G₁.num p₁ q₀ * G₂.den p₂ q₀ = G₂.num p₂ q₀ * G₁.den p₁ q₀ := by
      intro p₁ hp₁ p₂ hp₂ q₀ hq₀
      have hq₀W : q₀ ∈ W₁ ∩ W₂ :=
        ⟨G₁.ball_sub p₁ hp₁ hq₀.1, G₂.ball_sub p₂ hp₂ hq₀.2⟩
      let r₀ : ℝ := min (G₁.rad q₀) (G₂.rad q₀)
      have hr₀_pos : 0 < r₀ := lt_min (G₁.rad_pos q₀ hq₀W.1) (G₂.rad_pos q₀ hq₀W.2)
      let V : Set (ℂ × ℂ) :=
        (Metric.ball p₁ (G₁.rad p₁) ∩ Metric.ball p₂ (G₂.rad p₂)) ∩ Metric.ball q₀ r₀
      have hVo : IsOpen V := (Metric.isOpen_ball.inter Metric.isOpen_ball).inter Metric.isOpen_ball
      have hVp : IsPreconnected V :=
        (((convex_ball p₁ (G₁.rad p₁)).inter (convex_ball p₂ (G₂.rad p₂))).inter
          (convex_ball q₀ r₀)).isPreconnected
      have hq₀V : q₀ ∈ V := ⟨hq₀, Metric.mem_ball_self hr₀_pos⟩
      have hV_G₁₀ : V ⊆ Metric.ball q₀ (G₁.rad q₀) :=
        Set.Subset.trans Set.inter_subset_right (Metric.ball_subset_ball (min_le_left _ _))
      have hV_G₂₀ : V ⊆ Metric.ball q₀ (G₂.rad q₀) :=
        Set.Subset.trans Set.inter_subset_right (Metric.ball_subset_ball (min_le_right _ _))
      let h_d : ℂ × ℂ → ℂ := fun z => G₁.num p₁ z * G₂.den p₂ z - G₂.num p₂ z * G₁.den p₁ z
      have hhd_holo : DifferentiableOn ℂ h_d V :=
        (((G₁.num_holo p₁ hp₁).mono (Set.Subset.trans Set.inter_subset_left Set.inter_subset_left)).mul
          ((G₂.den_holo p₂ hp₂).mono (Set.Subset.trans Set.inter_subset_left Set.inter_subset_right))).sub
        (((G₂.num_holo p₂ hp₂).mono (Set.Subset.trans Set.inter_subset_left Set.inter_subset_right)).mul
          ((G₁.den_holo p₁ hp₁).mono (Set.Subset.trans Set.inter_subset_left Set.inter_subset_left)))
      have hprod2 : ∀ z ∈ V, (h_d z * G₁.den q₀ z) * G₂.den q₀ z = 0 := by
        intro z hz
        have c₁ := G₁.compat p₁ hp₁ q₀ hq₀W.1 z ⟨hz.1.1, hV_G₁₀ hz⟩
        have c₂ := G₂.compat p₂ hp₂ q₀ hq₀W.2 z ⟨hz.1.2, hV_G₂₀ hz⟩
        have e₀ := hEq.2 q₀ hq₀W z hz.2
        dsimp only [h_d]
        calc ((G₁.num p₁ z * G₂.den p₂ z - G₂.num p₂ z * G₁.den p₁ z) * G₁.den q₀ z) * G₂.den q₀ z
            = (G₁.num p₁ z * G₁.den q₀ z) * G₂.den p₂ z * G₂.den q₀ z -
              (G₂.num p₂ z * G₂.den q₀ z) * G₁.den p₁ z * G₁.den q₀ z := by ring
          _ = (G₁.num q₀ z * G₁.den p₁ z) * G₂.den p₂ z * G₂.den q₀ z -
              (G₂.num q₀ z * G₂.den p₂ z) * G₁.den p₁ z * G₁.den q₀ z := by rw [c₁, c₂]
          _ = (G₁.num q₀ z * G₂.den q₀ z - G₂.num q₀ z * G₁.den q₀ z) *
              (G₁.den p₁ z * G₂.den p₂ z) := by ring
          _ = 0 := by rw [e₀, sub_self, zero_mul]
      have hprod1 : ∀ z ∈ V, h_d z * G₁.den q₀ z = 0 :=
        cancel_holo_of_ne_zero hVo hVp
          (hhd_holo.mul ((G₁.den_holo q₀ hq₀W.1).mono hV_G₁₀))
          Metric.isOpen_ball (convex_ball q₀ (G₂.rad q₀)).isPreconnected
          (G₂.den_holo q₀ hq₀W.2) (G₂.den_ne_zero q₀ hq₀W.2)
          hVo ⟨q₀, hq₀V⟩ Set.Subset.rfl hV_G₂₀ hprod2
      have hzero : ∀ z ∈ V, h_d z = 0 :=
        cancel_holo_of_ne_zero hVo hVp hhd_holo
          Metric.isOpen_ball (convex_ball q₀ (G₁.rad q₀)).isPreconnected
          (G₁.den_holo q₀ hq₀W.1) (G₁.den_ne_zero q₀ hq₀W.1)
          hVo ⟨q₀, hq₀V⟩ Set.Subset.rfl hV_G₁₀ hprod1
      exact sub_eq_zero.mp (hzero q₀ hq₀V)
    let G_gl : MeroOn2D W_tgt := {
      rad := fun p => if p ∈ W₁ then G₁.rad p else G₂.rad p
      num := fun p => if p ∈ W₁ then G₁.num p else G₂.num p
      den := fun p => if p ∈ W₁ then G₁.den p else G₂.den p
      rad_pos := fun p hp => by
        by_cases hp₁ : p ∈ W₁
        · simp only [hp₁, ↓reduceIte]
          exact G₁.rad_pos p hp₁
        · simp only [hp₁, ↓reduceIte]
          exact G₂.rad_pos p ((hcov hp).resolve_left hp₁)
      ball_sub := fun p hp => by
        by_cases hp₁ : p ∈ W₁
        · simp only [hp₁, ↓reduceIte]
          exact Set.Subset.trans (G₁.ball_sub p hp₁) hW₁
        · simp only [hp₁, ↓reduceIte]
          exact Set.Subset.trans (G₂.ball_sub p ((hcov hp).resolve_left hp₁)) hW₂
      num_holo := fun p hp => by
        by_cases hp₁ : p ∈ W₁
        · simp only [hp₁, ↓reduceIte]
          exact G₁.num_holo p hp₁
        · simp only [hp₁, ↓reduceIte]
          exact G₂.num_holo p ((hcov hp).resolve_left hp₁)
      den_holo := fun p hp => by
        by_cases hp₁ : p ∈ W₁
        · simp only [hp₁, ↓reduceIte]
          exact G₁.den_holo p hp₁
        · simp only [hp₁, ↓reduceIte]
          exact G₂.den_holo p ((hcov hp).resolve_left hp₁)
      den_ne_zero := fun p hp => by
        by_cases hp₁ : p ∈ W₁
        · simp only [hp₁, ↓reduceIte]
          exact G₁.den_ne_zero p hp₁
        · simp only [hp₁, ↓reduceIte]
          exact G₂.den_ne_zero p ((hcov hp).resolve_left hp₁)
      compat := fun p₁ hp₁W p₂ hp₂W q hq => by
        by_cases hp₁ : p₁ ∈ W₁ <;> by_cases hp₂ : p₂ ∈ W₁
        · simp only [hp₁, hp₂, ↓reduceIte] at hq ⊢
          exact G₁.compat p₁ hp₁ p₂ hp₂ q hq
        · simp only [hp₁, hp₂, ↓reduceIte] at hq ⊢
          exact hCross p₁ hp₁ p₂ ((hcov hp₂W).resolve_left hp₂) q hq
        · simp only [hp₁, hp₂, ↓reduceIte] at hq ⊢
          exact (hCross p₂ hp₂ p₁ ((hcov hp₁W).resolve_left hp₁) q ⟨hq.2, hq.1⟩).symm
        · simp only [hp₁, hp₂, ↓reduceIte] at hq ⊢
          exact G₂.compat p₁ ((hcov hp₁W).resolve_left hp₁) p₂ ((hcov hp₂W).resolve_left hp₂) q hq
    }
    refine ⟨G_gl, ⟨fun p hp => ⟨hW₁ hp, hp⟩, fun p hp q _ => ?_⟩⟩
    dsimp only [G_gl]
    simp only [hp, ↓reduceIte]

  have mkPullbackMero :
      ∀ {W_dom : Set (ℂ × ℂ)} (F : MeroOn2D W_dom) (U : Set (ℂ × ℂ)), IsOpen U →
        ∀ (Φ_fn Ψ_fn : ℂ × ℂ → ℂ × ℂ),
          Differentiable ℂ Φ_fn → Differentiable ℂ Ψ_fn →
          (∀ p, Ψ_fn (Φ_fn p) = p) → (∀ q, Φ_fn (Ψ_fn q) = q) →
          Set.MapsTo Φ_fn U W_dom →
          ∃ G : MeroOn2D U,
            ∀ p q, G.num p q = F.num (Φ_fn p) (Φ_fn q) ∧ G.den p q = F.den (Φ_fn p) (Φ_fn q) := by
    intro W_dom F U hU Φ_fn Ψ_fn hΦ hΨ hL hR hMaps
    have hex_rad : ∀ p, p ∈ U →
        ∃ r : ℝ, 0 < r ∧
          Metric.ball p r ⊆ U ∩ Φ_fn ⁻¹' Metric.ball (Φ_fn p) (F.rad (Φ_fn p)) := by
      intro p hp
      have hOo : IsOpen (U ∩ Φ_fn ⁻¹' Metric.ball (Φ_fn p) (F.rad (Φ_fn p))) :=
        hU.inter (Metric.isOpen_ball.preimage hΦ.continuous)
      exact Metric.isOpen_iff.mp hOo p ⟨hp, Metric.mem_ball_self (F.rad_pos (Φ_fn p) (hMaps hp))⟩
    let rad_pb : ℂ × ℂ → ℝ := fun p =>
      if hp : p ∈ U then Classical.choose (hex_rad p hp) else 1
    have hrad_pb : ∀ p (hp : p ∈ U),
        0 < rad_pb p ∧
        Metric.ball p (rad_pb p) ⊆ U ∧
        Set.MapsTo Φ_fn (Metric.ball p (rad_pb p)) (Metric.ball (Φ_fn p) (F.rad (Φ_fn p))) := by
      intro p hp
      dsimp only [rad_pb]
      rw [dif_pos hp]
      have hsp := Classical.choose_spec (hex_rad p hp)
      exact ⟨hsp.1, fun q hq => (hsp.2 hq).1, fun q hq => (hsp.2 hq).2⟩
    let G : MeroOn2D U := {
      rad := rad_pb
      num := fun p q => F.num (Φ_fn p) (Φ_fn q)
      den := fun p q => F.den (Φ_fn p) (Φ_fn q)
      rad_pos := fun p hp => (hrad_pb p hp).1
      ball_sub := fun p hp => (hrad_pb p hp).2.1
      num_holo := fun p hp =>
        (F.num_holo (Φ_fn p) (hMaps hp)).comp hΦ.differentiableOn (hrad_pb p hp).2.2
      den_holo := fun p hp =>
        (F.den_holo (Φ_fn p) (hMaps hp)).comp hΦ.differentiableOn (hrad_pb p hp).2.2
      den_ne_zero := fun p hp => by
        let B_t : Set (ℂ × ℂ) := Metric.ball (Φ_fn p) (F.rad (Φ_fn p))
        let V_t : Set (ℂ × ℂ) := Ψ_fn ⁻¹' Metric.ball p (rad_pb p) ∩ B_t
        have hVto : IsOpen V_t :=
          (Metric.isOpen_ball.preimage hΨ.continuous).inter Metric.isOpen_ball
        have hΦp_mem : Φ_fn p ∈ V_t :=
          ⟨by simpa only [Set.mem_preimage, hL p] using Metric.mem_ball_self (hrad_pb p hp).1,
           Metric.mem_ball_self (F.rad_pos (Φ_fn p) (hMaps hp))⟩
        obtain ⟨z₀, hz₀V, hz₀_ne⟩ := exists_ne_zero_on_open
          Metric.isOpen_ball (convex_ball (Φ_fn p) (F.rad (Φ_fn p))).isPreconnected
          (F.den_holo (Φ_fn p) (hMaps hp)) (F.den_ne_zero (Φ_fn p) (hMaps hp))
          hVto ⟨Φ_fn p, hΦp_mem⟩ Set.inter_subset_right
        refine ⟨Ψ_fn z₀, hz₀V.1, ?_⟩
        simpa only [hR z₀] using hz₀_ne
      compat := fun p₁ hp₁ p₂ hp₂ q hq =>
        F.compat (Φ_fn p₁) (hMaps hp₁) (Φ_fn p₂) (hMaps hp₂) (Φ_fn q)
          ⟨(hrad_pb p₁ hp₁).2.2 hq.1, (hrad_pb p₂ hp₂).2.2 hq.2⟩
    }
    exact ⟨G, fun _ _ => ⟨rfl, rfl⟩⟩

  have eqOn_of_pullback :
      ∀ {W₁ W₂ U₁ U₂ : Set (ℂ × ℂ)}
        {F₁ : MeroOn2D W₁} {F₂ : MeroOn2D W₂}
        {G₁ : MeroOn2D U₁} {G₂ : MeroOn2D U₂}
        {Φ_fn : ℂ × ℂ → ℂ × ℂ} {V_src V_tgt : Set (ℂ × ℂ)},
        Continuous Φ_fn → V_src ⊆ U₁ ∩ U₂ → Set.MapsTo Φ_fn V_src V_tgt →
        (∀ p q, G₁.num p q = F₁.num (Φ_fn p) (Φ_fn q) ∧ G₁.den p q = F₁.den (Φ_fn p) (Φ_fn q)) →
        (∀ p q, G₂.num p q = F₂.num (Φ_fn p) (Φ_fn q) ∧ G₂.den p q = F₂.den (Φ_fn p) (Φ_fn q)) →
        MeroEqOn F₁ F₂ V_tgt →
        MeroEqOn G₁ G₂ V_src := by
    intro W₁ W₂ U₁ U₂ F₁ F₂ G₁ G₂ Φ_fn V_src V_tgt hΦ_cont hV_sub hMapsV hG₁ hG₂ hEqF
    refine ⟨hV_sub, fun p hp q hq => ?_⟩
    have hpU₁ : p ∈ U₁ := (hV_sub hp).1
    have hpU₂ : p ∈ U₂ := (hV_sub hp).2
    have hΦp : Φ_fn p ∈ V_tgt := hMapsV hp
    have hΦpW := hEqF.1 hΦp
    let r_s : ℝ := min (G₁.rad p) (G₂.rad p)
    have hr_s_pos : 0 < r_s := lt_min (G₁.rad_pos p hpU₁) (G₂.rad_pos p hpU₂)
    let r_t : ℝ := min (F₁.rad (Φ_fn p)) (F₂.rad (Φ_fn p))
    have hr_t_pos : 0 < r_t := lt_min (F₁.rad_pos (Φ_fn p) hΦpW.1) (F₂.rad_pos (Φ_fn p) hΦpW.2)
    have hOo : IsOpen (Metric.ball p r_s ∩ Φ_fn ⁻¹' Metric.ball (Φ_fn p) r_t) :=
      Metric.isOpen_ball.inter (Metric.isOpen_ball.preimage hΦ_cont)
    obtain ⟨η_p, hη_p_pos, hη_p_sub⟩ := Metric.isOpen_iff.mp hOo p
      ⟨Metric.mem_ball_self hr_s_pos, Metric.mem_ball_self hr_t_pos⟩
    have hh_holo : DifferentiableOn ℂ
        (fun z => G₁.num p z * G₂.den p z - G₂.num p z * G₁.den p z) (Metric.ball p r_s) :=
      (((G₁.num_holo p hpU₁).mono (Metric.ball_subset_ball (min_le_left _ _))).mul
        ((G₂.den_holo p hpU₂).mono (Metric.ball_subset_ball (min_le_right _ _)))).sub
      (((G₂.num_holo p hpU₂).mono (Metric.ball_subset_ball (min_le_right _ _))).mul
        ((G₁.den_holo p hpU₁).mono (Metric.ball_subset_ball (min_le_left _ _))))
    have hzero_sub : ∀ z ∈ Metric.ball p η_p,
        G₁.num p z * G₂.den p z - G₂.num p z * G₁.den p z = 0 := by
      intro z hz
      have hz_t : Φ_fn z ∈ Metric.ball (Φ_fn p) r_t := (hη_p_sub hz).2
      rw [(hG₁ p z).1, (hG₂ p z).2, (hG₂ p z).1, (hG₁ p z).2]
      exact sub_eq_zero.mpr (hEqF.2 (Φ_fn p) hΦp (Φ_fn z) hz_t)
    have hzero := hId2D Metric.isOpen_ball (convex_ball p r_s).isPreconnected
      Metric.isOpen_ball ⟨p, Metric.mem_ball_self hη_p_pos⟩
      (fun z hz => (hη_p_sub hz).1) hh_holo hzero_sub q hq
    exact sub_eq_zero.mp hzero

  
  have h4R0_lt : 4 * R_0 < H₀ := by
    linarith [W.s_base_pos, S.R_0_lt, S.H₀_ge]
  have hH₀_pos : 0 < H₀ := by
    linarith [S.R_0_pos, h4R0_lt]
  have h0_mem_base : (0 : ℂ) ∈ Metric.ball (0 : ℂ) W.r_base :=
    Metric.mem_ball_self W.r_base_pos
  have hHL0 : W.h_L 0 = ENNReal.ofReal H₀ := by
    have heq := W.h_L_eq 0 h0_mem_base
    simp only [Complex.zero_im, abs_zero, zero_div, ENNReal.ofReal_zero, add_zero] at heq
    rw [heq, hHX]

  have exists_lsc_radius : ∀ b : ℝ, b < H₀ →
      ∃ r_b : ℝ, 0 < r_b ∧ r_b ≤ W.r_base ∧
        ∀ t : ℂ, ‖t‖ < r_b → ENNReal.ofReal b ≤ W.h_L t := by
    intro b hb
    have hlt : ENNReal.ofReal b < W.h_L 0 := by
      rw [hHL0]
      exact (ENNReal.ofReal_lt_ofReal_iff hH₀_pos).mpr hb
    obtain ⟨U_b, hUb_open, hUb_eq⟩ :=
      lowerSemicontinuousOn_iff_preimage_Ioi.mp W.h_L_lsc (ENNReal.ofReal b)
    have h0_lhs : (0 : ℂ) ∈ Metric.ball (0 : ℂ) W.r_base ∩ W.h_L ⁻¹' Set.Ioi (ENNReal.ofReal b) :=
      ⟨h0_mem_base, hlt⟩
    rw [hUb_eq] at h0_lhs
    obtain ⟨r_tilde, hr_tilde_pos, hr_tilde_sub⟩ := Metric.isOpen_iff.mp hUb_open 0 h0_lhs.2
    refine ⟨min r_tilde W.r_base, lt_min hr_tilde_pos W.r_base_pos, min_le_right _ _, ?_⟩
    intro t ht
    have ht_rhs : t ∈ Metric.ball (0 : ℂ) W.r_base ∩ U_b :=
      ⟨Metric.mem_ball.mpr (by simpa [dist_zero_right] using lt_of_lt_of_le ht (min_le_right _ _)),
       hr_tilde_sub (Metric.mem_ball.mpr (by simpa [dist_zero_right] using lt_of_lt_of_le ht (min_le_left _ _)))⟩
    rw [← hUb_eq] at ht_rhs
    exact le_of_lt ht_rhs.2

  have mem_meroTube_L : ∀ (p : ℂ × ℂ) (b : ℝ),
      ‖p.2‖ < W.r_base → 0 < p.1.im → p.1.im < b → ENNReal.ofReal b ≤ W.h_L p.2 →
      p ∈ meroTubeENNR W.r_base W.h_L := by
    intro p b ht him_pos him_lt hb_le
    refine ⟨ht, ?_, ?_⟩
    · have h_nonpos : -p.1.im ≤ 0 := by linarith
      rw [ENNReal.ofReal_of_nonpos h_nonpos]
      have hconj_mem : starRingEnd ℂ p.2 ∈ Metric.ball (0 : ℂ) W.r_base := by
        simpa [Metric.mem_ball, dist_zero_right, Complex.norm_conj] using ht
      have hpos_s : (0 : ENNReal) < ENNReal.ofReal (2 * W.s_base) :=
        ENNReal.ofReal_pos.mpr (by linarith [W.s_base_pos])
      have hge_X := W.h_X_ge_two (starRingEnd ℂ p.2) hconj_mem
      have heq_L := W.h_L_eq (starRingEnd ℂ p.2) hconj_mem
      exact lt_of_lt_of_le hpos_s (le_trans hge_X (by rw [heq_L]; exact le_self_add))
    · have hb_pos : 0 < b := lt_trans him_pos him_lt
      exact lt_of_lt_of_le ((ENNReal.ofReal_lt_ofReal_iff hb_pos).mpr him_lt) hb_le

  let η : ℝ := R_0 / 256
  have hη_pos : 0 < η := by dsimp only [η]; linarith [S.R_0_pos]
  have h1024η_lt : 1024 * η < H₀ := by dsimp only [η]; linarith [h4R0_lt]
  let d_w : ℝ := η / 8
  have hd_w_pos : 0 < d_w := by dsimp only [d_w]; linarith
  let Δσ : ℝ := d_w / 4
  have hΔσ_pos : 0 < Δσ := by dsimp only [Δσ]; linarith
  let ρ : ℝ := 19 / 20
  let R : ℝ := 21 / 20
  have hρ_pos : 0 < ρ := by norm_num [ρ]
  have hρR : ρ < R := by norm_num [ρ, R]
  let μ : ℝ := η / 8
  have hμ_pos : 0 < μ := by dsimp only [μ]; linarith
  let δ₀ : ℝ := 1 / 10
  have hδ₀_pos : 0 < δ₀ := by norm_num [δ₀]
  have hy_row_lt_μ : y_row < H₀ - μ := by
    have hy2 := S.y_row_bounds.2
    dsimp only [μ, η]
    linarith [S.R_0_pos]
  obtain ⟨r_μ, hr_μ_pos, hr_μ_le, hΛ_agrees⟩ := S.Λ_steep_agrees μ hμ_pos hy_row_lt_μ
  obtain ⟨r_lsc, hr_lsc_pos, hr_lsc_le, h_lsc_bound⟩ :=
    exists_lsc_radius (H₀ - η / 128) (by linarith)
  let r_0 : ℝ := (1 / 2 : ℝ) * min r_μ r_lsc
  have hr_0_pos : 0 < r_0 := mul_pos (by norm_num) (lt_min hr_μ_pos hr_lsc_pos)
  have hr_0_C_ne : (r_0 : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (ne_of_gt hr_0_pos)
  have hR_r0_lt_μ : R * r_0 < r_μ := by
    have hm : min r_μ r_lsc ≤ r_μ := min_le_left _ _
    have hm_pos : 0 < min r_μ r_lsc := lt_min hr_μ_pos hr_lsc_pos
    dsimp only [R, r_0]
    linarith
  have hR_r0_lt_lsc : R * r_0 < r_lsc := by
    have hm : min r_μ r_lsc ≤ r_lsc := min_le_right _ _
    have hm_pos : 0 < min r_μ r_lsc := lt_min hr_μ_pos hr_lsc_pos
    dsimp only [R, r_0]
    linarith

  
  let A : Set ℂ := { ζ : ℂ | ρ < ‖ζ‖ ∧ ‖ζ‖ < R }
  have isOpen_A : IsOpen A :=
    (isOpen_lt continuous_const continuous_norm).inter (isOpen_lt continuous_norm continuous_const)
  have isPreconn_A : IsPreconnected A := by
    let Φ_pol : ℝ × ℝ → ℂ := fun x => (x.1 : ℂ) * Complex.exp ((x.2 : ℂ) * Complex.I)
    have hΦ_pol_cont : Continuous Φ_pol :=
      (Complex.continuous_ofReal.comp continuous_fst).mul
        (Complex.continuous_exp.comp
          ((Complex.continuous_ofReal.comp continuous_snd).mul continuous_const))
    have himg : Φ_pol '' (Set.Ioo ρ R ×ˢ Set.univ) = A := by
      ext ζ
      simp only [Set.mem_image, Set.mem_prod, Set.mem_Ioo, Set.mem_univ, and_true, A,
        Set.mem_setOf_eq, Prod.exists]
      constructor
      · rintro ⟨s, θ, ⟨hs1, hs2⟩, rfl⟩
        have hs_pos : 0 < s := lt_trans hρ_pos hs1
        have hnorm : ‖Φ_pol (s, θ)‖ = s := by
          dsimp only [Φ_pol]
          rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hs_pos,
            Complex.norm_exp_ofReal_mul_I, mul_one]
        rw [hnorm]
        exact ⟨hs1, hs2⟩
      · intro ⟨h1, h2⟩
        exact ⟨‖ζ‖, ζ.arg, ⟨h1, h2⟩, Complex.norm_mul_exp_arg_mul_I ζ⟩
    rw [← himg]
    exact ((convex_Ioo ρ R).prod convex_univ).isPreconnected.image Φ_pol hΦ_pol_cont.continuousOn

  
  let Φ : ℝ → (ℂ × ℂ → ℂ × ℂ) := fun σ p =>
    (((x_edge : ℂ) + (σ : ℂ) * Complex.I) - (η : ℂ) * Complex.I * (p.2 ^ 2) + p.1,
     (r_0 : ℂ) * p.2)
  let Ψ : ℝ → (ℂ × ℂ → ℂ × ℂ) := fun σ q =>
    (q.1 - ((x_edge : ℂ) + (σ : ℂ) * Complex.I) + ((η / r_0 ^ 2 : ℝ) : ℂ) * Complex.I * (q.2 ^ 2),
     ((r_0⁻¹ : ℝ) : ℂ) * q.2)
  have hΦ_diff : ∀ σ : ℝ, Differentiable ℂ (Φ σ) := fun σ =>
    (((differentiable_const _).sub ((differentiable_const _).mul (differentiable_snd.pow 2))).add
      differentiable_fst).prodMk ((differentiable_const _).mul differentiable_snd)
  have hΨ_diff : ∀ σ : ℝ, Differentiable ℂ (Ψ σ) := fun σ =>
    ((differentiable_fst.sub (differentiable_const _)).add
      ((differentiable_const _).mul (differentiable_snd.pow 2))).prodMk
      ((differentiable_const _).mul differentiable_snd)
  have hΨΦ : ∀ (σ : ℝ) (p : ℂ × ℂ), Ψ σ (Φ σ p) = p := by
    intro σ p
    apply Prod.ext <;> dsimp only [Φ, Ψ] <;> push_cast <;> field_simp [hr_0_C_ne] <;> ring
  have hΦΨ : ∀ (σ : ℝ) (q : ℂ × ℂ), Φ σ (Ψ σ q) = q := by
    intro σ q
    apply Prod.ext <;> dsimp only [Φ, Ψ] <;> push_cast <;> field_simp [hr_0_C_ne] <;> ring

  have h_sq_re : ∀ ζ : ℂ, (ζ ^ 2).re = ‖ζ‖ ^ 2 - 2 * ζ.im ^ 2 := by
    intro ζ
    have h1 : (ζ ^ 2).re = ζ.re * ζ.re - ζ.im * ζ.im := by rw [sq, Complex.mul_re]
    have h2 : ‖ζ‖ ^ 2 = ζ.re * ζ.re + ζ.im * ζ.im := by
      rw [← Complex.normSq_eq_norm_sq, Complex.normSq_apply]
    linarith
  have h_abs_sq_re : ∀ ζ : ℂ, |(ζ ^ 2).re| ≤ ‖ζ‖ ^ 2 := fun ζ =>
    le_trans (Complex.abs_re_le_norm (ζ ^ 2)) (by rw [norm_pow])
  have h_abs_sq_im : ∀ ζ : ℂ, |(ζ ^ 2).im| ≤ ‖ζ‖ ^ 2 := fun ζ =>
    le_trans (Complex.abs_im_le_norm (ζ ^ 2)) (by rw [norm_pow])
  have hΦ1_re : ∀ (σ : ℝ) (p : ℂ × ℂ),
      (Φ σ p).1.re = x_edge + η * (p.2 ^ 2).im + p.1.re := by
    intro σ p
    dsimp only [Φ]
    simp only [Complex.add_re, Complex.sub_re, Complex.mul_re, Complex.mul_im,
      Complex.ofReal_re, Complex.ofReal_im, Complex.I_re, Complex.I_im]
    ring
  have hΦ1_im : ∀ (σ : ℝ) (p : ℂ × ℂ),
      (Φ σ p).1.im = σ - η * (p.2 ^ 2).re + p.1.im := by
    intro σ p
    dsimp only [Φ]
    simp only [Complex.add_im, Complex.sub_im, Complex.mul_re, Complex.mul_im,
      Complex.ofReal_re, Complex.ofReal_im, Complex.I_re, Complex.I_im]
    ring
  have hΦ2_norm : ∀ (σ : ℝ) (p : ℂ × ℂ), ‖(Φ σ p).2‖ = r_0 * ‖p.2‖ := by
    intro σ p
    dsimp only [Φ]
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hr_0_pos]
  have hΦ2_abs_im : ∀ (σ : ℝ) (p : ℂ × ℂ), |(Φ σ p).2.im| = r_0 * |p.2.im| := by
    intro σ p
    dsimp only [Φ]
    simp only [Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im, zero_mul, add_zero,
      abs_mul, abs_of_pos hr_0_pos]

  
  let A_shal : Set ℂ := A ∩ { ζ : ℂ | |ζ.im| < (3 / 5 : ℝ) * ‖ζ‖ }
  let A_steep : Set ℂ := A ∩ { ζ : ℂ | (2 / 5 : ℝ) * ‖ζ‖ < |ζ.im| }
  have isOpen_A_shal : IsOpen A_shal :=
    isOpen_A.inter (isOpen_lt (continuous_abs.comp Complex.continuous_im)
      (continuous_const.mul continuous_norm))
  have isOpen_A_steep : IsOpen A_steep :=
    isOpen_A.inter (isOpen_lt (continuous_const.mul continuous_norm)
      (continuous_abs.comp Complex.continuous_im))
  have h1_mem_shal : (1 : ℂ) ∈ A_shal := by
    refine ⟨⟨?_, ?_⟩, ?_⟩ <;> norm_num [ρ, R]
  have hA_cov : A ⊆ A_shal ∪ A_steep := by
    intro ζ hζ
    have hζ_pos : 0 < ‖ζ‖ := lt_trans hρ_pos hζ.1
    rcases lt_or_ge |ζ.im| ((3 / 5 : ℝ) * ‖ζ‖) with hlt | hge
    · exact Or.inl ⟨hζ, hlt⟩
    · exact Or.inr ⟨hζ, show (2 / 5 : ℝ) * ‖ζ‖ < |ζ.im| by linarith⟩

  have hShal_im_lt : ∀ {σ : ℝ}, σ ≤ H₀ →
      ∀ p ∈ Metric.ball (0 : ℂ) d_w ×ˢ A_shal,
        (Φ σ p).1.im < H₀ - μ := by
    intro σ hσ_hi p ⟨hpw, hpζ_A, hpζ_sh⟩
    change |p.2.im| < (3 / 5 : ℝ) * ‖p.2‖ at hpζ_sh
    have hw_norm : ‖p.1‖ < d_w := by simpa [Metric.mem_ball, dist_zero_right] using hpw
    have hw_im : p.1.im ≤ ‖p.1‖ := Complex.im_le_norm p.1
    have h_im_sq : p.2.im ^ 2 < (9 / 25 : ℝ) * ‖p.2‖ ^ 2 := by
      have h0 : 0 ≤ |p.2.im| := abs_nonneg p.2.im
      have hsq : |p.2.im| ^ 2 = p.2.im ^ 2 := sq_abs p.2.im
      nlinarith
    have h_norm_sq : (19 / 20 : ℝ) ^ 2 < ‖p.2‖ ^ 2 := by
      have h1 : (19 / 20 : ℝ) < ‖p.2‖ := hpζ_A.1
      nlinarith
    have h_re_gt : (1 / 4 : ℝ) < (p.2 ^ 2).re := by
      rw [h_sq_re p.2]
      nlinarith
    rw [hΦ1_im]
    dsimp only [μ, d_w] at hw_norm ⊢
    nlinarith

  have hShal_maps_tube : ∀ {σ : ℝ}, σ ∈ Set.Icc (H₀ - 2 * η) H₀ →
      Set.MapsTo (Φ σ) (Metric.ball (0 : ℂ) d_w ×ˢ A_shal) (meroTubeENNR W.r_base W.h_L) := by
    intro σ ⟨hσ_lo, hσ_hi⟩ p hp
    have him_hi : (Φ σ p).1.im < H₀ - η / 128 := by
      have h1 := hShal_im_lt hσ_hi p hp
      dsimp only [μ] at h1
      linarith
    have hw_norm : ‖p.1‖ < d_w := by simpa [Metric.mem_ball, dist_zero_right] using hp.1
    have hw_abs : |p.1.im| ≤ ‖p.1‖ := Complex.abs_im_le_norm p.1
    have hw_lo : -d_w < p.1.im := by linarith [neg_abs_le p.1.im]
    have hζ_norm : ‖p.2‖ < R := hp.2.1.2
    have hζ_sq : ‖p.2‖ ^ 2 < (21 / 20 : ℝ) ^ 2 := by
      have h0 : 0 ≤ ‖p.2‖ := norm_nonneg p.2
      dsimp only [R] at hζ_norm
      nlinarith
    have hre_le : (p.2 ^ 2).re ≤ ‖p.2‖ ^ 2 := le_trans (le_abs_self _) (h_abs_sq_re p.2)
    have him_pos : 0 < (Φ σ p).1.im := by
      rw [hΦ1_im]
      dsimp only [d_w] at hw_lo
      nlinarith [h1024η_lt]
    have ht_lsc : ‖(Φ σ p).2‖ < r_lsc := by
      rw [hΦ2_norm]
      have : r_0 * ‖p.2‖ < r_0 * R := mul_lt_mul_of_pos_left hζ_norm hr_0_pos
      linarith [hR_r0_lt_lsc]
    exact mem_meroTube_L (Φ σ p) (H₀ - η / 128)
      (lt_of_lt_of_le ht_lsc hr_lsc_le) him_pos him_hi (h_lsc_bound (Φ σ p).2 ht_lsc)

  have hSteep_maps : ∀ {σ : ℝ}, σ ∈ Set.Icc (H₀ - 2 * η) H₀ →
      ∀ p ∈ Metric.ball (0 : ℂ) d_w ×ˢ A_steep,
        (Φ σ p).1 ∈ steepCorridorY x_edge H₀ R_0 y_row δ_slab ∧
        (Φ σ p).2 ∈ steepSectorT S.r_steep ∩ Metric.ball (0 : ℂ) r_μ := by
    intro σ ⟨hσ_lo, hσ_hi⟩ p ⟨hpw, ⟨hpζ_lo, hpζ_hi⟩, hpζ_st⟩
    have hw_norm : ‖p.1‖ < d_w := by simpa [Metric.mem_ball, dist_zero_right] using hpw
    have hw_re_abs : |p.1.re| < d_w := lt_of_le_of_lt (Complex.abs_re_le_norm p.1) hw_norm
    have hw_im_abs : |p.1.im| < d_w := lt_of_le_of_lt (Complex.abs_im_le_norm p.1) hw_norm
    have hζ_sq : ‖p.2‖ ^ 2 < (21 / 20 : ℝ) ^ 2 := by
      have h0 : 0 ≤ ‖p.2‖ := norm_nonneg p.2
      dsimp only [R] at hpζ_hi
      nlinarith
    have hre_abs := h_abs_sq_re p.2
    have him_abs := h_abs_sq_im p.2
    refine ⟨⟨?_, ?_, ?_⟩, ⟨?_, ?_⟩⟩
    · rw [hΦ1_re]
      have htri : |x_edge + η * (p.2 ^ 2).im + p.1.re - x_edge| ≤
          η * |(p.2 ^ 2).im| + |p.1.re| := by
        have heq : x_edge + η * (p.2 ^ 2).im + p.1.re - x_edge = η * (p.2 ^ 2).im + p.1.re := by ring
        rw [heq]
        exact le_trans (abs_add_le _ _) (by rw [abs_mul, abs_of_pos hη_pos])
      have hR0_eq : R_0 = 256 * η := by dsimp only [η]; ring
      dsimp only [d_w] at hw_re_abs
      nlinarith
    · rw [hΦ1_im]
      have hy_ub := S.y_row_bounds.2
      have hδ_pos := S.δ_slab_pos
      have hR0_eq : R_0 = 256 * η := by dsimp only [η]; ring
      have hre_le : (p.2 ^ 2).re ≤ |(p.2 ^ 2).re| := le_abs_self _
      have hw_lo : -d_w < p.1.im := (abs_lt.mp hw_im_abs).1
      dsimp only [d_w] at hw_lo
      nlinarith
    · rw [hΦ1_im]
      have hR0_eq : R_0 = 256 * η := by dsimp only [η]; ring
      have hre_lo : -|(p.2 ^ 2).re| ≤ (p.2 ^ 2).re := neg_abs_le _
      have hw_hi : p.1.im < d_w := (abs_lt.mp hw_im_abs).2
      dsimp only [d_w] at hw_hi
      nlinarith
    · refine ⟨?_, ?_, ?_⟩
      · rw [hΦ2_norm]
        exact mul_pos hr_0_pos (lt_trans hρ_pos hpζ_lo)
      · rw [hΦ2_norm]
        have : r_0 * ‖p.2‖ < r_0 * R := mul_lt_mul_of_pos_left hpζ_hi hr_0_pos
        linarith [hR_r0_lt_μ, hr_μ_le]
      · rw [hΦ2_norm, hΦ2_abs_im]
        change (2 / 5 : ℝ) * ‖p.2‖ < |p.2.im| at hpζ_st
        have hζ_pos : 0 < ‖p.2‖ := lt_trans hρ_pos hpζ_lo
        nlinarith
    · rw [Metric.mem_ball, dist_zero_right, hΦ2_norm]
      have : r_0 * ‖p.2‖ < r_0 * R := mul_lt_mul_of_pos_left hpζ_hi hr_0_pos
      linarith [hR_r0_lt_μ]

  let W_ag : Set (ℂ × ℂ) :=
    (steepCorridorY x_edge H₀ R_0 y_row δ_slab ∩ { y : ℂ | y.im < H₀ - μ }) ×ˢ
      (steepSectorT S.r_steep ∩ Metric.ball (0 : ℂ) r_μ)
  have isOpen_steepY : IsOpen (steepCorridorY x_edge H₀ R_0 y_row δ_slab) :=
    (isOpen_lt (continuous_abs.comp (Complex.continuous_re.sub continuous_const))
      continuous_const).inter
      ((isOpen_lt continuous_const Complex.continuous_im).inter
        (isOpen_lt Complex.continuous_im continuous_const))
  have isOpen_steepT : IsOpen (steepSectorT S.r_steep) :=
    (isOpen_lt continuous_const continuous_norm).inter
      ((isOpen_lt continuous_norm continuous_const).inter
        (isOpen_lt (continuous_norm.div_const (3 : ℝ)) (continuous_abs.comp Complex.continuous_im)))
  have isOpen_Wag : IsOpen W_ag :=
    (isOpen_steepY.inter (isOpen_lt Complex.continuous_im continuous_const)).prod
      (isOpen_steepT.inter Metric.isOpen_ball)

  have mkAnnularFamily : ∀ (i : Fin 2) (σ : ℝ), σ ∈ Set.Icc (H₀ - 2 * η) H₀ →
      ∃ (F_shal : MeroOn2D (Metric.ball (0 : ℂ) d_w ×ˢ A_shal))
        (F_ann : MeroOn2D (Metric.ball (0 : ℂ) d_w ×ˢ A)),
        (∀ p q, F_shal.num p q = (W.L_mero i).num (Φ σ p) (Φ σ q) ∧
                F_shal.den p q = (W.L_mero i).den (Φ σ p) (Φ σ q)) ∧
        MeroEqOn F_ann F_shal (Metric.ball (0 : ℂ) d_w ×ˢ A_shal) := by
    intro i σ hσ
    let U_sh : Set (ℂ × ℂ) := Metric.ball (0 : ℂ) d_w ×ˢ A_shal
    let U_st : Set (ℂ × ℂ) := Metric.ball (0 : ℂ) d_w ×ˢ A_steep
    have hUsh_o : IsOpen U_sh := Metric.isOpen_ball.prod isOpen_A_shal
    have hUst_o : IsOpen U_st := Metric.isOpen_ball.prod isOpen_A_steep
    obtain ⟨F_shal, hF_shal_nd⟩ := mkPullbackMero (W.L_mero i) U_sh hUsh_o
      (Φ σ) (Ψ σ) (hΦ_diff σ) (hΨ_diff σ) (hΨΦ σ) (hΦΨ σ) (hShal_maps_tube hσ)
    have hΛ_comp_holo : DifferentiableOn ℂ (fun p => S.Λ_steep i (Φ σ p)) U_st :=
      (S.Λ_steep_holo i).comp (hΦ_diff σ).differentiableOn
        (fun p hp => ⟨(hSteep_maps hσ p hp).1, (hSteep_maps hσ p hp).2.1⟩)
    obtain ⟨F_steep, hF_steep_nd, _⟩ := mkHoloMero U_st hUst_o _ hΛ_comp_holo
    have hΛ_Wag_holo : DifferentiableOn ℂ (S.Λ_steep i) W_ag :=
      (S.Λ_steep_holo i).mono (Set.prod_mono Set.inter_subset_left Set.inter_subset_left)
    obtain ⟨H_ag, hH_ag_nd, hH_ag_iff⟩ := mkHoloMero W_ag isOpen_Wag (S.Λ_steep i) hΛ_Wag_holo
    have hEq_Wag : MeroEqOn (W.L_mero i) H_ag W_ag :=
      hH_ag_iff (W.L_mero i) W_ag Set.Subset.rfl (hΛ_agrees i)
    have hOv_maps : Set.MapsTo (Φ σ) (U_sh ∩ U_st) W_ag := by
      intro p ⟨hpsh, hpst⟩
      exact ⟨⟨(hSteep_maps hσ p hpst).1, hShal_im_lt hσ.2 p hpsh⟩, (hSteep_maps hσ p hpst).2⟩
    obtain ⟨H_ov_pb, hH_ov_pb_nd⟩ := mkPullbackMero H_ag (U_sh ∩ U_st) (hUsh_o.inter hUst_o)
      (Φ σ) (Ψ σ) (hΦ_diff σ) (hΨ_diff σ) (hΨΦ σ) (hΦΨ σ) hOv_maps
    have hEq_ov1 : MeroEqOn F_shal H_ov_pb (U_sh ∩ U_st) :=
      eqOn_of_pullback (hΦ_diff σ).continuous
        (fun p hp => ⟨hp.1, hp⟩) hOv_maps hF_shal_nd hH_ov_pb_nd hEq_Wag
    have hEq_ov2 : MeroEqOn H_ov_pb F_steep (U_sh ∩ U_st) :=
      meroEqOn_of_num_den_eq H_ov_pb F_steep (U_sh ∩ U_st)
        (fun p hp => ⟨hp, hp.2⟩)
        (fun p _ q => by
          rw [(hH_ov_pb_nd p q).1, (hH_ag_nd (Φ σ p) (Φ σ q)).1, (hF_steep_nd p q).1,
              (hH_ov_pb_nd p q).2, (hH_ag_nd (Φ σ p) (Φ σ q)).2, (hF_steep_nd p q).2]
          exact ⟨rfl, rfl⟩)
    have hEq_ov : MeroEqOn F_shal F_steep (U_sh ∩ U_st) := meroEqOn_trans hEq_ov1 hEq_ov2
    obtain ⟨F_ann, hF_ann_sh⟩ := mkGlueMero
      (Set.prod_mono Set.Subset.rfl Set.inter_subset_left : U_sh ⊆ Metric.ball (0 : ℂ) d_w ×ˢ A)
      (Set.prod_mono Set.Subset.rfl Set.inter_subset_left : U_st ⊆ Metric.ball (0 : ℂ) d_w ×ˢ A)
      (fun p hp => by
        rcases hA_cov hp.2 with h1 | h2
        · exact Or.inl ⟨hp.1, h1⟩
        · exact Or.inr ⟨hp.1, h2⟩)
      F_shal F_steep hEq_ov
    exact ⟨F_shal, F_ann, hF_shal_nd, hF_ann_sh⟩

  
  let σ_fn : ℕ → ℝ := fun k => H₀ - 2 * η + (k : ℝ) * Δσ
  have hσ_mem : ∀ {k : ℕ}, k ≤ 64 → σ_fn k ∈ Set.Icc (H₀ - 2 * η) H₀ := by
    intro k hk
    have hk0 : (0 : ℝ) ≤ (k : ℝ) := Nat.cast_nonneg k
    have hk64 : (k : ℝ) ≤ 64 := by exact_mod_cast hk
    dsimp only [σ_fn, Δσ, d_w]
    exact ⟨by nlinarith, by nlinarith⟩

  let U_box : ℕ → Set (ℂ × ℂ) := fun k =>
    (Metric.ball (0 : ℂ) d_w ∩ { w : ℂ | w.im < H₀ - d_w / 4 - σ_fn k }) ×ˢ
      Metric.ball (0 : ℂ) δ₀
  have isOpen_Ubox : ∀ k : ℕ, IsOpen (U_box k) := fun k =>
    (Metric.isOpen_ball.inter (isOpen_lt Complex.continuous_im continuous_const)).prod
      Metric.isOpen_ball
  have isPreconn_Ubox : ∀ k : ℕ, IsPreconnected (U_box k) := fun k =>
    (((convex_ball (0 : ℂ) d_w).inter
      ((convex_Iio (H₀ - d_w / 4 - σ_fn k)).linear_preimage Complex.imCLM.toLinearMap)).prod
      (convex_ball (0 : ℂ) δ₀)).isPreconnected
  have hUbox_maps_tube : ∀ {k : ℕ}, k ≤ 64 →
      Set.MapsTo (Φ (σ_fn k)) (U_box k) (meroTubeENNR W.r_base W.h_L) := by
    intro k hk p ⟨⟨hpw, hpw_im⟩, hpζ⟩
    obtain ⟨hσ_lo, _⟩ := hσ_mem hk
    have hw_norm : ‖p.1‖ < d_w := by simpa [Metric.mem_ball, dist_zero_right] using hpw
    have hw_lo : -d_w < p.1.im := (abs_lt.mp (lt_of_le_of_lt (Complex.abs_im_le_norm p.1) hw_norm)).1
    have hζ_norm : ‖p.2‖ < δ₀ := by simpa [Metric.mem_ball, dist_zero_right] using hpζ
    have hζ_sq : ‖p.2‖ ^ 2 < (1 / 100 : ℝ) := by
