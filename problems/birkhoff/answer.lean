        h_lift_mul F Φ (inv_mem (natCast_mem F s.factorial)) (hH s)]
      have hinv_K : ((s.factorial : ℂ)⁻¹) ∈ K := inv_mem (natCast_mem K s.factorial)
      have hlift_inv : pointRecLiftArcFn F Φ ((s.factorial : ℂ)⁻¹) =
