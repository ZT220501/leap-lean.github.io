        symm
        refine Finset.sum_subset (Finset.range_mono (by omega)) ?_
        intro s _ hsd
        rw [Finset.mem_range] at hsd
        rw [MvPowerSeries.coeff_C_mul, hΨ_pow_vanish2D s d (by omega), mul_zero, map_zero]
      rw [htrunc_d]
      change PowerSeries.coeff l₀ (pointRecLiftArcFn F Φ
          (∑ s ∈ Finset.range (d 0 + d 1 + 1),
            PowerSeries.coeff s (PowerSeries.mk (fun n => H_star n / (n.factorial : ℂ))) *
