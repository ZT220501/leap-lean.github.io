        filter_upwards [hSh_open.mem_nhds (hSh_conj w hw)] with z hz
        simpa using C.h_ℂ_conj (starRingEnd ℂ z) (hSh_conj z hz)
      exact (hd_c.congr_of_eventuallyEq hev).deriv
    have hΘ_conj : ∀ y t : ℂ, |y.im| < C.s₁ + C.r₁ → ‖t‖ < C.r₁ →
        glancingTheta C (starRingEnd ℂ y) (starRingEnd ℂ t) = starRingEnd ℂ (glancingTheta C y t) := by
      intro y t hy ht
      have hy2 : |y.im| < 2 * C.s₁ := by linarith [C.r₁_lt_s₁]
      have hU_mem : C.U (y, t) ∈ horizStrip (2 * C.s₀) := C.U_maps_to y t hy ht
      simp [glancingTheta, C.U_conj y t hy2 ht, C.ϕ_ℂ_conj (C.U (y, t)) hU_mem]
    have hImp_conj : ∀ p ∈ W₀, ∀ c_sh : ℝ, |c_sh| ≤ (k : ℝ) → ∀ c : Fin 2,
        glancingImpact C (starRingEnd ℂ p.1 + (c_sh : ℂ) * starRingEnd ℂ p.2) (starRingEnd ℂ p.2) c =
          starRingEnd ℂ (glancingImpact C (p.1 + (c_sh : ℂ) * p.2) p.2 c) := by
      intro p hp c_sh hc c
      have hm : |c_sh - 1 / 2| ≤ (k : ℝ) + 1 := abs_le.mpr
        ⟨by linarith [(abs_le.mp hc).1], by linarith [(abs_le.mp hc).2]⟩
      have hp' : |c_sh + 1 / 2| ≤ (k : ℝ) + 1 := abs_le.mpr
        ⟨by linarith [(abs_le.mp hc).1], by linarith [(abs_le.mp hc).2]⟩
      obtain ⟨him_m, hnm_t⟩ := h_shift_bounds p hp (c_sh - 1 / 2) hm
      obtain ⟨him_p, _⟩ := h_shift_bounds p hp (c_sh + 1 / 2) hp'
      have ht_r1 : ‖p.2‖ < C.r₁ := by linarith [B.r_det_lt_r₁, B.r_det_pos]
      have hy_m_im : |(p.1 + (c_sh : ℂ) * p.2 - p.2 / 2).im| < C.s₁ + C.r₁ := by
        have heq : p.1 + (c_sh : ℂ) * p.2 - p.2 / 2 = p.1 + ((c_sh - 1 / 2 : ℝ) : ℂ) * p.2 := by
          push_cast; ring
        rw [heq]; linarith [B.s_det_le_s₁, B.r_det_lt_s_det, B.s_det_pos, C.r₁_pos]
      have hy_p_im : |(p.1 + (c_sh : ℂ) * p.2 + p.2 / 2).im| < C.s₁ + C.r₁ := by
        have heq : p.1 + (c_sh : ℂ) * p.2 + p.2 / 2 = p.1 + ((c_sh + 1 / 2 : ℝ) : ℂ) * p.2 := by
          push_cast; ring
        rw [heq]; linarith [B.s_det_le_s₁, B.r_det_lt_s_det, B.s_det_pos, C.r₁_pos]
      have hμ_conj : glancingMidAngle C (starRingEnd ℂ p.1 + (c_sh : ℂ) * starRingEnd ℂ p.2)
          (starRingEnd ℂ p.2) = starRingEnd ℂ (glancingMidAngle C (p.1 + (c_sh : ℂ) * p.2) p.2) := by
        have h1 := hΘ_conj (p.1 + (c_sh : ℂ) * p.2 - p.2 / 2) p.2 hy_m_im ht_r1
        have h2 := hΘ_conj (p.1 + (c_sh : ℂ) * p.2 + p.2 / 2) p.2 hy_p_im ht_r1
        dsimp [glancingMidAngle]
        have e1 : starRingEnd ℂ p.1 + (c_sh : ℂ) * starRingEnd ℂ p.2 - starRingEnd ℂ p.2 / 2 =
            starRingEnd ℂ (p.1 + (c_sh : ℂ) * p.2 - p.2 / 2) := by
          simp [map_sub, map_add, map_mul, map_div₀, map_ofNat]
        have e2 : starRingEnd ℂ p.1 + (c_sh : ℂ) * starRingEnd ℂ p.2 + starRingEnd ℂ p.2 / 2 =
            starRingEnd ℂ (p.1 + (c_sh : ℂ) * p.2 + p.2 / 2) := by
          simp [map_sub, map_add, map_mul, map_div₀, map_ofNat]
        rw [e1, e2, h1, h2]
        simp [map_add, map_div₀, map_ofNat]
      have hμ_Sh : glancingMidAngle C (p.1 + (c_sh : ℂ) * p.2) p.2 ∈ S_h := by
        have h1 : glancingTheta C (p.1 + (c_sh : ℂ) * p.2 - p.2 / 2) p.2 ∈ S_h :=
          C.ϕ_ℂ_maps_to _ (C.U_maps_to _ _ hy_m_im ht_r1)
        have h2 : glancingTheta C (p.1 + (c_sh : ℂ) * p.2 + p.2 / 2) p.2 ∈ S_h :=
          C.ϕ_ℂ_maps_to _ (C.U_maps_to _ _ hy_p_im ht_r1)
        change |((glancingTheta C (p.1 + (c_sh : ℂ) * p.2 - p.2 / 2) p.2 +
          glancingTheta C (p.1 + (c_sh : ℂ) * p.2 + p.2 / 2) p.2) / 2).im| < 2 * C.s_h
        have him_div : ((glancingTheta C (p.1 + (c_sh : ℂ) * p.2 - p.2 / 2) p.2 +
            glancingTheta C (p.1 + (c_sh : ℂ) * p.2 + p.2 / 2) p.2) / 2).im =
            ((glancingTheta C (p.1 + (c_sh : ℂ) * p.2 - p.2 / 2) p.2).im +
              (glancingTheta C (p.1 + (c_sh : ℂ) * p.2 + p.2 / 2) p.2).im) / 2 := by
          simp [div_eq_mul_inv]
        rw [him_div, abs_div, abs_of_pos (by norm_num : (0 : ℝ) < 2)]
        have htri := abs_add_le
          (glancingTheta C (p.1 + (c_sh : ℂ) * p.2 - p.2 / 2) p.2).im
          (glancingTheta C (p.1 + (c_sh : ℂ) * p.2 + p.2 / 2) p.2).im
        have h1' : |(glancingTheta C (p.1 + (c_sh : ℂ) * p.2 - p.2 / 2) p.2).im| < 2 * C.s_h := h1
        have h2' : |(glancingTheta C (p.1 + (c_sh : ℂ) * p.2 + p.2 / 2) p.2).im| < 2 * C.s_h := h2
        linarith
      fin_cases c <;>
        simp [glancingImpact, hμ_conj, C.h_ℂ_conj _ hμ_Sh, hh'_conj _ hμ_Sh,
          Complex.cos_conj, Complex.sin_conj]
    have h_real_slice : ∀ a δ : ℝ, ((a : ℂ), (δ : ℂ)) ∈ U₀ →
        (Ψ ((a : ℂ), (δ : ℂ))).1.im = 0 ∧
        (Ψ ((a : ℂ), (δ : ℂ))).2.im = 0 ∧
        (∀ r : Fin (k + 1), (pointChartX C k rotIdx Ψ r ((a : ℂ), (δ : ℂ))).im = 0) ∧
        (∀ i : Fin k, (pointChartEll C Ψ i ((a : ℂ), (δ : ℂ))).im = 0) := by
      intro a δ hq
      let p := Ψ ((a : ℂ), (δ : ℂ))
      have hp_B : p ∈ B_src := hΨ_maps_B _ hq
      have hp_W₀ : p ∈ W₀ := hB_sub_W₀ hp_B
      let p_bar : ℂ × ℂ := (starRingEnd ℂ p.1, starRingEnd ℂ p.2)
      have hp_bar_B : p_bar ∈ B_src := by
        rw [Metric.mem_ball, Prod.dist_eq] at hp_B ⊢
        simpa [p_bar, dist_zero_right, Complex.norm_conj] using hp_B
      have hΦ_conj : Φ p_bar = (starRingEnd ℂ (Φ p).1, starRingEnd ℂ (Φ p).2) := by
        have h0_c : glancingImpact C p_bar.1 p_bar.2 =
            fun c => starRingEnd ℂ (glancingImpact C p.1 p.2 c) := by
          ext c; simpa [p_bar] using hImp_conj p hp_W₀ 0 (by rw [abs_zero]; positivity) c
        have hk_c : glancingImpact C (p_bar.1 + (k : ℂ) * p_bar.2) p_bar.2 =
            fun c => starRingEnd ℂ (glancingImpact C (p.1 + (k : ℂ) * p.2) p.2 c) := by
          ext c
          simpa [p_bar] using hImp_conj p hp_W₀ (k : ℝ)
            (by rw [abs_of_nonneg (Nat.cast_nonneg k)]) c
        have ha_c : pointChartACoord C rotIdx p_bar = starRingEnd ℂ (pointChartACoord C rotIdx p) := by
          dsimp [pointChartACoord]; rw [h0_c]; exact (h_rot_all rotIdx).2.2.2 _
        have hb_c : pointChartBCoord C k rotIdx p_bar = starRingEnd ℂ (pointChartBCoord C k rotIdx p) := by
          dsimp [pointChartBCoord]; rw [hk_c]; exact (h_rot_all rotIdx).2.2.2 _
        ext <;> simp [Φ, pointPhiMap, ha_c, hb_c]
      have hp_eq_bar : p_bar = p := by
        apply e.injOn (hρ₀_sub p_bar hp_bar_B).1 (hρ₀_sub p hp_B).1
        rw [he_coe, hΦ_conj, hΦ_left_inv _ hq]
        simp
      have hp1_conj : starRingEnd ℂ p.1 = p.1 := congr_arg Prod.fst hp_eq_bar
      have hp2_conj : starRingEnd ℂ p.2 = p.2 := congr_arg Prod.snd hp_eq_bar
      refine ⟨Complex.conj_eq_iff_im.mp hp1_conj, Complex.conj_eq_iff_im.mp hp2_conj, ?_, ?_⟩
      · intro r
        apply Complex.conj_eq_iff_im.mp
        have hr_le : |(r.1 : ℝ)| ≤ (k : ℝ) := by
          rw [abs_of_nonneg (Nat.cast_nonneg _)]
          exact_mod_cast Nat.le_of_lt_succ r.2
        have hc : (fun c => starRingEnd ℂ (glancingImpact C (p.1 + ((r : ℕ) : ℂ) * p.2) p.2 c)) =
            glancingImpact C (p.1 + ((r : ℕ) : ℂ) * p.2) p.2 := by
          ext c
          have h := (hImp_conj p hp_W₀ (r.1 : ℝ) hr_le c).symm
          simpa [hp1_conj, hp2_conj] using h
        dsimp [pointChartX]
        rw [← (h_rot_all rotIdx).2.2.2 _, hc]
      · intro i
        apply Complex.conj_eq_iff_im.mp
        have hi_le : |(i.1 : ℝ)| ≤ (k : ℝ) := by
          rw [abs_of_nonneg (Nat.cast_nonneg _)]
          exact le_of_lt (Nat.cast_lt.mpr i.2)
        have hi1_le : |((i.1 + 1 : ℕ) : ℝ)| ≤ (k : ℝ) := by
          rw [abs_of_nonneg (Nat.cast_nonneg _)]
          exact_mod_cast i.2
        have hc0 : ∀ c : Fin 2,
            starRingEnd ℂ (glancingImpact C (p.1 + ((i : ℕ) : ℂ) * p.2) p.2 c) =
              glancingImpact C (p.1 + ((i : ℕ) : ℂ) * p.2) p.2 c := by
          intro c
          have h := (hImp_conj p hp_W₀ (i.1 : ℝ) hi_le c).symm
          simpa [hp1_conj, hp2_conj] using h
        have hc1 : ∀ c : Fin 2,
            starRingEnd ℂ (glancingImpact C (p.1 + (((i : ℕ) + 1 : ℕ) : ℂ) * p.2) p.2 c) =
              glancingImpact C (p.1 + (((i : ℕ) + 1 : ℕ) : ℂ) * p.2) p.2 c := by
          intro c
          have h := (hImp_conj p hp_W₀ ((i.1 + 1 : ℕ) : ℝ) hi1_le c).symm
          simpa [hp1_conj, hp2_conj] using h
        have hic : |(i.1 : ℝ) + 1 / 2| ≤ (k : ℝ) + 1 := by
          rw [abs_of_nonneg (by positivity)]
          have : (i.1 : ℝ) + 1 ≤ (k : ℝ) := by exact_mod_cast i.2
          linarith
        obtain ⟨him_mid, hnm_t⟩ := h_shift_bounds p hp_W₀ ((i.1 : ℝ) + 1 / 2) hic
        have hy_im : |(p.1 + (((i : ℕ) : ℂ) + 1 / 2) * p.2).im| < C.s₁ + C.r₁ := by
          have heq : p.1 + (((i : ℕ) : ℂ) + 1 / 2) * p.2 =
              p.1 + (((i.1 : ℝ) + 1 / 2 : ℝ) : ℂ) * p.2 := by push_cast; rfl
          rw [heq]; linarith [B.s_det_le_s₁, B.r_det_lt_s_det, B.s_det_pos, C.r₁_pos]
        have ht_r1 : ‖p.2‖ < C.r₁ := by linarith [hnm_t, B.r_det_lt_r₁, B.r_det_pos]
        have hΘc : starRingEnd ℂ (glancingTheta C (p.1 + (((i : ℕ) : ℂ) + 1 / 2) * p.2) p.2) =
            glancingTheta C (p.1 + (((i : ℕ) : ℂ) + 1 / 2) * p.2) p.2 := by
          have h := (hΘ_conj (p.1 + (((i : ℕ) : ℂ) + 1 / 2) * p.2) p.2 hy_im ht_r1).symm
          have heq : starRingEnd ℂ (p.1 + (((i : ℕ) : ℂ) + 1 / 2) * p.2) =
              p.1 + (((i : ℕ) : ℂ) + 1 / 2) * p.2 := by
            simp [hp1_conj, hp2_conj, map_add, map_mul, map_div₀, map_ofNat]
          rwa [heq, hp2_conj] at h
        dsimp [pointChartEll]
        change starRingEnd ℂ
          (-(glancingImpact C (p.1 + (((i : ℕ) + 1 : ℕ) : ℂ) * p.2) p.2 0 -
              glancingImpact C (p.1 + ((i : ℕ) : ℂ) * p.2) p.2 0) *
            Complex.sin (glancingTheta C (p.1 + (((i : ℕ) : ℂ) + 1 / 2) * p.2) p.2) +
          (glancingImpact C (p.1 + (((i : ℕ) + 1 : ℕ) : ℂ) * p.2) p.2 1 -
              glancingImpact C (p.1 + ((i : ℕ) : ℂ) * p.2) p.2 1) *
            Complex.cos (glancingTheta C (p.1 + (((i : ℕ) : ℂ) + 1 / 2) * p.2) p.2)) = _
        simp only [map_add, map_sub, map_mul, map_neg, ← Complex.sin_conj, ← Complex.cos_conj]
        rw [hc0 0, hc0 1, hc1 0, hc1 1, hΘc]
    have hΨ_zero_eq : ∀ z ∈ Metric.ball (G_gr.a₀ : ℂ) (2 * R₀),
        Ψ (z, 0) = (e_ϕ.symm (G_gr.θ_inv z), 0) := by
      intro z hz
      have h2R_lt : 2 * R₀ < r_z := by
        have h1 : R₀ ≤ min r_e r_z / 4 := min_le_right _ _
        have h2 : min r_e r_z ≤ r_z := min_le_right _ _
        linarith
      have hz_rz : z ∈ Metric.ball (G_gr.a₀ : ℂ) r_z :=
        Metric.ball_subset_ball (le_of_lt h2R_lt) hz
      obtain ⟨hz_WF, hθ_tgt, hyz_ball⟩ := hr_z_sub z hz_rz
      let y_z : ℂ := e_ϕ.symm (G_gr.θ_inv z)
      have hpz_B : (y_z, (0 : ℂ)) ∈ B_src := by
        rw [Metric.mem_ball, Prod.dist_eq]
        have hyz : dist y_z 0 < ρ₀ := Metric.mem_ball.mp hyz_ball
        simpa [hρ₀_pos] using hyz
      have hpz_W₀ : (y_z, (0 : ℂ)) ∈ W₀ := hB_sub_W₀ hpz_B
      have hqz_U₀ : (z, (0 : ℂ)) ∈ U₀ := ⟨hz, Metric.mem_ball_self (by positivity)⟩
      apply e.injOn (hρ₀_sub _ (hΨ_maps_B (z, 0) hqz_U₀)).1 (hρ₀_sub _ hpz_B).1
      rw [he_coe, hΦ_left_inv (z, 0) hqz_U₀]
      have hyz_2s₁ : |y_z.im| < 2 * C.s₁ := by linarith [hpz_W₀.1, B.s_det_le_s₁, B.s_det_pos]
      have hϕ_yz : C.ϕ_ℂ y_z = G_gr.θ_inv z := by
        rw [← he_ϕ_coe]; exact e_ϕ.right_inv hθ_tgt
      have hμ_yz : glancingMidAngle C y_z 0 = G_gr.θ_inv z := by
        simp [glancingMidAngle, glancingTheta, C.U_zero y_z hyz_2s₁, hϕ_yz]
      have ha_yz : a_fn (y_z, 0) = z := by
        change rotCoordX rotIdx (pointSupportCurve C (glancingMidAngle C y_z 0)) = z
        rw [hμ_yz, (G_gr.θ_right_inv z hz_WF).1]
      have hb_yz : b_fn (y_z, 0) = a_fn (y_z, 0) := by
        simp [b_fn, a_fn, pointChartBCoord, pointChartACoord]
      change (z, (0 : ℂ)) = (a_fn (y_z, 0), b_fn (y_z, 0) - a_fn (y_z, 0))
      rw [hb_yz, ha_yz, sub_self]
    have h_zero_slice : ∀ z ∈ Metric.ball (G_gr.a₀ : ℂ) (2 * R₀),
        (Ψ (z, 0)).2 = 0 ∧
        (∀ r : Fin (k + 1), pointChartX C k rotIdx Ψ r (z, 0) = z) ∧
        (∀ r : Fin (k + 1),
          glancingMidAngle C ((Ψ (z, 0)).1 + ((r : ℕ) : ℂ) * (Ψ (z, 0)).2) (Ψ (z, 0)).2 =
