          exact pow_le_pow_left₀ hlam.le hm_spec.2.le 2
        · simp only [Set.indicator_of_notMem hom]
          exact sq_nonneg _
      have h_int_ind : MeasureTheory.Integrable
          ((E_fin N_hor).indicator (fun _ : WalkSpace => lam ^ 2)) walkMeasure :=
        (MeasureTheory.integrable_const (lam ^ 2)).indicator (hE_fin_meas N_hor)
