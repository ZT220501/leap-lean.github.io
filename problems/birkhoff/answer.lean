        (∑ l ∈ Finset.Ico (T_pure N_cap om) (η_pure N_cap om), q_fn (walkPos ρ om l) ≤ q_K) ∧
        r_exit < ‖sliceImpactSeq S P.N i.val (walkPos ρ om (η_pure N_cap om)) -
          sliceImpactSeq S P.N i.val (walkPos ρ om (T_pure N_cap om))‖}
    have hCapBound : ∀ N_cap : ℕ, walkMeasure.real (E_cap N_cap) ≤ 2 * q_K / r_exit ^ 2 := by
      intro N_cap
      have hσ_le : ∀ j om, σ_pure N_cap j om ≤ N_cap :=
        fun j om => hFindMin' _ (Or.inl le_rfl)
      have hT_le : ∀ om, T_pure N_cap om ≤ N_cap :=
        fun om => Finset.sup'_le hJ _ (fun j _ => hσ_le j om)
      have hT_le_η : ∀ om, T_pure N_cap om ≤ η_pure N_cap om := by
        intro om
        exact (@Nat.find_spec
          (fun m => T_pure N_cap om ≤ m ∧
            (N_cap ≤ m ∨ r_exit < ‖sliceImpactSeq S P.N i.val (walkPos ρ om m) -
              sliceImpactSeq S P.N i.val (walkPos ρ om (T_pure N_cap om))‖))
          (Classical.decPred _) _).1
      have hη_le : ∀ om, η_pure N_cap om ≤ N_cap :=
        fun om => hFindMin' _ ⟨hT_le om, Or.inl le_rfl⟩
      let A_set : ℕ → Set WalkSpace := fun n =>
        {om : WalkSpace | T_pure N_cap om ≤ n ∧ n < η_pure N_cap om ∧
          (∑ l ∈ Finset.Ico (T_pure N_cap om) (n + 1), q_fn (walkPos ρ om l)) ≤ q_K}
      have hA_pref : ∀ n < N_cap, shcbWalkPrefixEvent n (A_set n) := by
        intro n hn
        have hT_le_ev : ∀ t₀ ≤ n, shcbWalkPrefixEvent n {om | T_pure N_cap om ≤ t₀} := by
          intro t₀ ht₀
          have hEq : {om : WalkSpace | T_pure N_cap om ≤ t₀} =
              {om : WalkSpace | ∀ j ∈ J, ∃ l ∈ Finset.range (t₀ + 1),
                sliceShapeDepth S P j (walkPos ρ om l) ≤ d} := by
            ext om
            simp only [Set.mem_setOf_eq, T_pure, Finset.sup'_le_iff]
            refine forall₂_congr fun j _ => ⟨fun hle => ?_, fun ⟨l, hl, hdl⟩ => ?_⟩
            · have hlt : σ_pure N_cap j om < N_cap := lt_of_le_of_lt hle (lt_of_le_of_lt ht₀ hn)
              have hspec := @Nat.find_spec
                (fun m => N_cap ≤ m ∨ sliceShapeDepth S P j (walkPos ρ om m) ≤ d)
                (Classical.decPred _) ⟨N_cap, Or.inl le_rfl⟩
              exact ⟨σ_pure N_cap j om, Finset.mem_range.mpr (Nat.lt_succ_of_le hle),
                hspec.resolve_left (not_le.mpr hlt)⟩
            · exact le_trans (hFindMin' _ (Or.inr hdl))
                (Nat.lt_succ_iff.mp (Finset.mem_range.mp hl))
          rw [hEq]
          refine hEvBiInter J fun j _ => hEvBiUnion (Finset.range (t₀ + 1)) fun l hl => ?_
          have hln : l ≤ n := le_trans (Nat.lt_succ_iff.mp (Finset.mem_range.mp hl)) ht₀
          exact hEvPreimage (hPrefMono hln (hDepthPref j l)) measurableSet_Iic
        have hT_eq_ev : ∀ t₀ ≤ n, shcbWalkPrefixEvent n {om | T_pure N_cap om = t₀} := by
          intro t₀ ht₀
          by_cases h0 : t₀ = 0
          · subst h0
            have hEq : {om : WalkSpace | T_pure N_cap om = 0} = {om | T_pure N_cap om ≤ 0} := by
              ext om; simp
            rw [hEq]
            exact hT_le_ev 0 ht₀
          · have ht1 : t₀ - 1 ≤ n := le_trans (Nat.sub_le t₀ 1) ht₀
            have hEq : {om : WalkSpace | T_pure N_cap om = t₀} =
                {om | T_pure N_cap om ≤ t₀} ∩ {om | T_pure N_cap om ≤ t₀ - 1}ᶜ := by
              ext om
              simp only [Set.mem_inter_iff, Set.mem_compl_iff, Set.mem_setOf_eq]
              omega
            rw [hEq]
            exact hEvInter (hT_le_ev t₀ ht₀) (hEvCompl (hT_le_ev (t₀ - 1) ht1))
        have hA_eq : A_set n =
            {om : WalkSpace | ∃ t₀ ∈ Finset.range (n + 1),
              om ∈ ({om' | T_pure N_cap om' = t₀} ∩
                {om' | ∀ m ∈ Finset.Ico t₀ (n + 1),
