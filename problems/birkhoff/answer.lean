                (T_fn w / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ))
            have hYm_holo : DifferentiableOn ℂ Y_m_fn W := by
              have h_eq :
                  Y_m_fn =
                    fun w : ℂ × ℂ =>
                      Y₀_fn w +
                        ((m : ℂ) * (σ : ℂ) *
                          (((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ)⁻¹)) * T_fn w := by
                ext w
                dsimp [Y_m_fn]
                rw [div_eq_mul_inv]
                ring
              rw [h_eq]
              exact hY₀_holo.add (hT_holo.const_mul _)
            simp only [rctRunCorridorChain]
            refine h_step_holo n hn_atl W Y_m_fn T_fn
              (fun w =>
                (rctRunCorridorChain seq Ψ σ n m (Y₀_fn w) (T_fn w)
                  (rctInitSymplecticState P seq n σ (S_prev_fn w) (S_curr_fn w) (T_fn w))).1)
              (fun w =>
                (rctRunCorridorChain seq Ψ σ n m (Y₀_fn w) (T_fn w)
                  (rctInitSymplecticState P seq n σ (S_prev_fn w) (S_curr_fn w) (T_fn w))).2)
              hW_open hYm_holo hT_holo hS_m_holo hPm_holo ?_
            intro w hw
            rcases hw_all w hw with ⟨hTw_ne, hTw_le, hw_traj, hw_err⟩
            have hm_mem : (Y_m_fn w, T_fn w) ∈ U_corr := hw_traj m hm
            have hd_tube :
                ‖(rctRunCorridorChain seq Ψ σ n m (Y₀_fn w) (T_fn w)
                    (rctInitSymplecticState P seq n σ (S_prev_fn w) (S_curr_fn w) (T_fn w))).1 -
                  (cseModelState P seq S_star n σ (Y_m_fn w) (T_fn w)).1‖ +
                ‖(rctRunCorridorChain seq Ψ σ n m (Y₀_fn w) (T_fn w)
                    (rctInitSymplecticState P seq n σ (S_prev_fn w) (S_curr_fn w) (T_fn w))).2 -
                  (cseModelState P seq S_star n σ (Y_m_fn w) (T_fn w)).2‖ ≤ r_tube :=
              (h_gronwall n hn K_n hK_len (Y₀_fn w) (T_fn w) (S_prev_fn w) (S_curr_fn w)
                hTw_ne hTw_le hw_traj hw_err m hm).2
            exact ⟨hm_mem, hTw_ne, hTw_le, hd_tube⟩
        intro k hk
        exact (h_holo_both k hk).1
    · have hK_empty : K_corr = ∅ := Set.not_nonempty_iff_eq_empty.mp hK_ne
      refine ⟨1, 1, 1, 0, fun _ => 0, fun _ _ q => q,
        zero_lt_one, zero_lt_one, zero_lt_one,
        fun _ => le_rfl, tendsto_const_nhds, ?_⟩
      dsimp only []
      have hU_empty : { p : ℂ × ℂ | ∃ q ∈ K_corr, ‖p - q‖ < (1 : ℝ) } = ∅ := by
        ext p
        simp [hK_empty]
      refine ⟨hU_empty ▸ isOpen_empty, hU_empty ▸ Set.empty_subset V_mod,
        h_runChain_add (fun _ _ q => q), ?_, ?_, ?_⟩
      · intro n _ Y T _ hYT
        rw [hU_empty] at hYT
        exact False.elim hYT
      · intro n _ K_n _ Y₀ T _ _ _ _ h_traj
        have h0 :
            (Y₀ + ((0 : ℕ) : ℂ) * (σ : ℂ) *
                (T / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ)), T) ∈
              { p : ℂ × ℂ | ∃ q ∈ K_corr, ‖p - q‖ < (1 : ℝ) } :=
          h_traj 0 (Nat.zero_le K_n)
        rw [hU_empty] at h0
        exact False.elim h0
      · intro n _ K_n _ W Y₀_fn T_fn _ _ _ _ _ _ _ hw_all k _ w hw
        rcases hw_all w hw with ⟨_, _, hw_traj, _⟩
        have h0 :
            (Y₀_fn w + ((0 : ℕ) : ℂ) * (σ : ℂ) *
                (T_fn w / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ)), T_fn w) ∈
              { p : ℂ × ℂ | ∃ q ∈ K_corr, ‖p - q‖ < (1 : ℝ) } :=
          hw_traj 0 (Nat.zero_le K_n)
        rw [hU_empty] at h0
        exact False.elim h0

theorem horizontal_corridor_chain_tracking (X : ExpStripData) (hX : IsExpObstructionStrip X)
    (P : ChordActionPackage X) (kind : ExpProfileKind)
    (seq : ExpSequenceData X kind)
    (hEngine : RctCorridorStepEngineProp X P kind seq) :
    ∀ (V_mod : Set (ℂ × ℂ)) (S_star : ℂ × ℂ → ℂ) (T₀ Y_plus : ℂ)
      (ε_plus L_max : ℝ) (S_init : ℕ → ℂ → ℂ) (N_base : ℕ) (N_step : ℕ → ℕ),
      IsRegularFrozenModel seq V_mod S_star →
      T₀ ≠ 0 → 0 < ε_plus → 0 < L_max →
      Metric.closedBall Y_plus (3 * ε_plus) ×ˢ ({T₀} : Set ℂ) ⊆ V_mod →
      (∀ Z ∈ Metric.closedBall Y_plus ε_plus, ∀ τ ∈ Set.Icc (0 : ℝ) L_max,
        (Z + (τ : ℂ) * T₀, T₀) ∈ V_mod) →
      (∀ n ≥ N_base, DifferentiableOn ℂ (S_init n) (Metric.ball Y_plus (3 * ε_plus))) →
      (∀ n ≥ N_base, ∀ Z ∈ Metric.ball Y_plus (2 * ε_plus),
        Z - T₀ / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ) ∈ Metric.ball Y_plus (3 * ε_plus) →
        Z + T₀ / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ) ∈ Metric.ball Y_plus (3 * ε_plus) →
        SatisfiesScaledChordRecurrence P seq (S_init n) n Z T₀) →
      TendstoUniformlyOn S_init (fun Z => S_star (Z, T₀))
        Filter.atTop (Metric.closedBall Y_plus (2 * ε_plus)) →
      (∀ n : ℕ, (N_step n : ℝ) / (seq.ℓ_seq n * seq.m_seq n) ≤ L_max) →
      ∃ (N_tr : ℕ) (S_chain : ℕ → ℕ → ℂ → ℂ),
        N_base ≤ N_tr ∧
        (∀ n ≥ N_tr, ∀ j ≤ N_step n,
          DifferentiableOn ℂ (S_chain n j) (Metric.ball Y_plus ε_plus)) ∧
        (∀ n ≥ N_tr, ∀ Z ∈ Metric.ball Y_plus ε_plus,
          let a_n : ℂ := T₀ / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ)
          S_chain n 0 Z = S_init n Z ∧ S_chain n 1 Z = S_init n (Z + a_n)) ∧
        (∀ n ≥ N_tr, ∀ j < N_step n, ∀ Z ∈ Metric.ball Y_plus ε_plus,
          let a_n : ℂ := T₀ / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ)
          Z + a_n ∈ Metric.ball Y_plus ε_plus →
          S_chain n (j + 1) Z = S_chain n j (Z + a_n)) ∧
        (∀ ε : ℝ, 0 < ε → ∃ N₁ ≥ N_tr, ∀ n ≥ N₁, ∀ j ≤ N_step n,
          ∀ Z ∈ Metric.ball Y_plus ε_plus,
            let a_n : ℂ := T₀ / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ)
            ‖S_chain n j Z - S_star (Z + (j : ℂ) * a_n, T₀)‖ < ε) :=
by
  intro V_mod S_star T₀ Y_plus ε_plus L_max S_init N_base N_step
    hMod hT₀ hε_plus hL_max hBall3 hRay hInit_holo hInit_rec hInit_conv hStep_le
  let b : ℕ → ℝ := fun n => seq.ℓ_seq n * seq.m_seq n
  let a : ℕ → ℂ := fun n => T₀ / ((b n : ℝ) : ℂ)
  have hb_pos : ∀ n : ℕ, 0 < b n := fun n => mul_pos (seq.ℓ_pos n) (seq.m_pos n)
  have hb_c_ne : ∀ n : ℕ, ((b n : ℝ) : ℂ) ≠ 0 :=
    fun n => Complex.ofReal_ne_zero.mpr (hb_pos n).ne'
  have ha_ne : ∀ n : ℕ, a n ≠ 0 := fun n => div_ne_zero hT₀ (hb_c_ne n)
  have ha_norm_pos : ∀ n : ℕ, 0 < ‖a n‖ := fun n => norm_pos_iff.mpr (ha_ne n)
  have ha_norm_eq : ∀ n : ℕ, ‖a n‖ = ‖T₀‖ / b n := by
    intro n
    dsimp [a]
    rw [norm_div, Complex.norm_of_nonneg (hb_pos n).le]
  have ha_tendsto : Filter.Tendsto (fun n => ‖a n‖) Filter.atTop (nhds 0) := by
    have h0 : Filter.Tendsto (fun n => ‖T₀‖ / b n) Filter.atTop (nhds 0) :=
      seq.b_tendsto.const_div_atTop ‖T₀‖
    simpa [ha_norm_eq] using h0
  let K₁ : Set (ℂ × ℂ) := Metric.closedBall Y_plus (2 * ε_plus) ×ˢ ({T₀} : Set ℂ)
  let φ_ray : ℂ × ℝ → ℂ × ℂ := fun p => (p.1 + (p.2 : ℂ) * T₀, T₀)
  let K₂ : Set (ℂ × ℂ) :=
    φ_ray '' (Metric.closedBall Y_plus ε_plus ×ˢ Set.Icc (0 : ℝ) L_max)
  let K_horiz : Set (ℂ × ℂ) := K₁ ∪ K₂
  have hK₁_comp : IsCompact K₁ :=
    (isCompact_closedBall Y_plus (2 * ε_plus)).prod isCompact_singleton
  have hφ_cont : Continuous φ_ray := by fun_prop
  have hK₂_comp : IsCompact K₂ :=
    ((isCompact_closedBall Y_plus ε_plus).prod isCompact_Icc).image hφ_cont
  have hK_comp : IsCompact K_horiz := hK₁_comp.union hK₂_comp
  have hK_sub : K_horiz ⊆ V_mod := by
    intro p hp
    rcases hp with hp1 | hp2
    · exact hBall3 ⟨Metric.closedBall_subset_closedBall (by linarith) hp1.1, hp1.2⟩
    · rcases hp2 with ⟨⟨Z, τ⟩, ⟨hZ, hτ⟩, rfl⟩
      exact hRay Z hZ τ hτ
  have hK_T_le : ∀ p ∈ K_horiz, ‖p.2‖ ≤ ‖T₀‖ := by
    intro p hp
    rcases hp with hp1 | hp2
    · have hpT : p.2 = T₀ := Set.mem_singleton_iff.mp hp1.2
      rw [hpT]
    · rcases hp2 with ⟨⟨Z, τ⟩, _, rfl⟩
      exact le_rfl
  have hT_max_pos : 0 < ‖T₀‖ := norm_pos_iff.mpr hT₀
  obtain ⟨_hJ_holo, ⟨a_max, C_EL, ha_max_pos, hC_EL_pos, hEL⟩,
    ⟨η_corr, r_init, C_Gron, N_eng, δ_mod, Ψ,
      hη_corr_pos, hr_init_pos, hC_Gron_pos, hδ_nonneg, hδ_tendsto,
      _hU_open, _hU_sub, hChain_add, hStep_rec, hGronwall, hParam_holo⟩⟩ :=
    hEngine V_mod S_star K_horiz 1 ‖T₀‖ L_max
      hMod hK_comp hK_sub (Or.inl rfl) hT_max_pos hL_max hK_T_le
  let U_corr : Set (ℂ × ℂ) := { p : ℂ × ℂ | ∃ q ∈ K_horiz, ‖p - q‖ < η_corr }
  have hK_sub_U : K_horiz ⊆ U_corr := fun q hq => ⟨q, hq, by simp [hη_corr_pos]⟩
  let f_star : ℂ → ℂ := fun Z => S_star (Z, T₀)
  let g_n : ℕ → ℂ → ℂ := fun n Z => S_init n Z - f_star Z
  have hf_star_holo : DifferentiableOn ℂ f_star (Metric.ball Y_plus (3 * ε_plus)) := by
    refine hMod.2.1.comp (differentiable_id.prodMk (differentiable_const T₀)).differentiableOn ?_
    intro Z hZ
    exact hBall3 ⟨Metric.ball_subset_closedBall hZ, rfl⟩
  have hg_holo : ∀ n ≥ N_base, DifferentiableOn ℂ (g_n n) (Metric.ball Y_plus (3 * ε_plus)) :=
    fun n hn => (hInit_holo n hn).sub hf_star_holo
  have hg_conv : TendstoUniformlyOn g_n (fun _ => (0 : ℂ)) Filter.atTop
      (Metric.closedBall Y_plus (2 * ε_plus)) := by
    rw [Metric.tendstoUniformlyOn_iff]
    intro ε hε
    filter_upwards [Metric.tendstoUniformlyOn_iff.mp hInit_conv ε hε] with n hn Z hZ
    have hd : dist (0 : ℂ) (g_n n Z) = dist (f_star Z) (S_init n Z) := by
      dsimp [g_n, f_star]
      rw [dist_zero_left, dist_comm, dist_eq_norm]
    rw [hd]
    exact hn Z hZ
  have hg_loc : TendstoLocallyUniformlyOn g_n (fun _ => (0 : ℂ)) Filter.atTop
      (Metric.ball Y_plus (2 * ε_plus)) :=
    (hg_conv.mono Metric.ball_subset_closedBall).tendstoLocallyUniformlyOn
  have hg_ev_holo : ∀ᶠ n in Filter.atTop,
      DifferentiableOn ℂ (g_n n) (Metric.ball Y_plus (2 * ε_plus)) := by
    refine Filter.eventually_atTop.mpr ⟨N_base, fun n hn => ?_⟩
    exact (hg_holo n hn).mono (Metric.ball_subset_ball (by linarith))
  have hdg_conv : TendstoUniformlyOn (fun n W => deriv (g_n n) W) (fun _ => (0 : ℂ)) Filter.atTop
      (Metric.closedBall Y_plus ((7 / 4 : ℝ) * ε_plus)) := by
    have hd_loc := hg_loc.deriv hg_ev_holo Metric.isOpen_ball
    rw [deriv_const' (0 : ℂ)] at hd_loc
    exact (tendstoLocallyUniformlyOn_iff_forall_isCompact Metric.isOpen_ball).mp hd_loc
      (Metric.closedBall Y_plus ((7 / 4 : ℝ) * ε_plus))
      (Metric.closedBall_subset_ball (by linarith))
      (isCompact_closedBall _ _)
  have hg_diff_quot : ∀ n ≥ N_base, ∀ δ : ℝ,
      ‖a n‖ ≤ ε_plus / 4 →
      (∀ W ∈ Metric.closedBall Y_plus ((7 / 4 : ℝ) * ε_plus), ‖deriv (g_n n) W‖ ≤ δ) →
      ∀ W ∈ Metric.closedBall Y_plus ((3 / 2 : ℝ) * ε_plus),
        ‖(g_n n (W + a n) - g_n n W) / a n‖ ≤ δ := by
    intro n hn δ ha_le hderiv_le W hW
    have hW_mem : W ∈ Metric.closedBall Y_plus ((7 / 4 : ℝ) * ε_plus) :=
      Metric.closedBall_subset_closedBall (by linarith) hW
    have hWa_mem : W + a n ∈ Metric.closedBall Y_plus ((7 / 4 : ℝ) * ε_plus) := by
      rw [Metric.mem_closedBall, dist_eq_norm] at hW ⊢
      have h_eq : W + a n - Y_plus = (W - Y_plus) + a n := by ring
      rw [h_eq]
      calc ‖(W - Y_plus) + a n‖
          ≤ ‖W - Y_plus‖ + ‖a n‖ := norm_add_le _ _
        _ ≤ (3 / 2 : ℝ) * ε_plus + ε_plus / 4 := add_le_add hW ha_le
        _ = (7 / 4 : ℝ) * ε_plus := by ring
    have hg_diffAt : ∀ x ∈ Metric.closedBall Y_plus ((7 / 4 : ℝ) * ε_plus),
        DifferentiableAt ℂ (g_n n) x := by
      intro x hx
      have hx_ball : x ∈ Metric.ball Y_plus (3 * ε_plus) :=
        Metric.closedBall_subset_ball (by linarith) hx
      exact (hg_holo n hn).differentiableAt (Metric.isOpen_ball.mem_nhds hx_ball)
    have h_mvt : ‖g_n n (W + a n) - g_n n W‖ ≤ δ * ‖a n‖ := by
      simpa using Convex.norm_image_sub_le_of_norm_deriv_le
        hg_diffAt hderiv_le (convex_closedBall Y_plus ((7 / 4 : ℝ) * ε_plus)) hW_mem hWa_mem
    rw [norm_div]
    exact (div_le_iff₀ (ha_norm_pos n)).mpr h_mvt
  have h1_mul : ∀ z : ℂ, ((1 : ℝ) : ℂ) * z = z := by simp
  have h_init_small : ∀ η : ℝ, 0 < η →
      ∃ N_η : ℕ, N_base ≤ N_η ∧ N_eng ≤ N_η ∧
        ∀ n ≥ N_η,
          ‖a n‖ < ε_plus / 4 ∧
          ∀ Z ∈ Metric.ball Y_plus ε_plus,
            let J_sh : ℂ := deriv (fun Y' => S_star (Y', T₀)) (Z + a n)
            ‖S_init n Z - S_star (Z, T₀)‖ < η ∧
            ‖S_init n (Z + a n) - S_star (Z + a n, T₀)‖ < η ∧
            ‖S_init n (Z + a n + a n) - S_star (Z + a n + a n, T₀)‖ < η ∧
            ‖(S_init n (Z + a n) - S_init n Z) / a n - J_sh‖ < η ∧
            ‖(S_init n (Z + a n + a n) - S_init n (Z + a n)) / a n - J_sh‖ < η ∧
            ‖S_init n (Z + a n) - S_star (Z + a n, T₀)‖ +
              ‖(S_init n (Z + a n) - S_init n Z) / a n - J_sh‖ < η := by
    intro η hη
    obtain ⟨N₁, hN₁⟩ :=
      Filter.eventually_atTop.mp (Metric.tendstoUniformlyOn_iff.mp hg_conv (η / 3) (by positivity))
    obtain ⟨N₂, hN₂⟩ :=
      Filter.eventually_atTop.mp (Metric.tendstoUniformlyOn_iff.mp hdg_conv (η / 3) (by positivity))
    let r_a : ℝ := min (min (ε_plus / 4) a_max) (η / (3 * C_EL))
    have hr_a_pos : 0 < r_a :=
      lt_min (lt_min (by positivity) ha_max_pos) (by positivity)
    obtain ⟨N₃, hN₃⟩ := Metric.tendsto_atTop.mp ha_tendsto r_a hr_a_pos
    let N_η : ℕ := max (max N_base N_eng) (max N₁ (max N₂ N₃))
    have hN_base_le : N_base ≤ N_η := le_trans (le_max_left _ _) (le_max_left _ _)
    have hN_eng_le : N_eng ≤ N_η := le_trans (le_max_right _ _) (le_max_left _ _)
    refine ⟨N_η, hN_base_le, hN_eng_le, fun n hn => ?_⟩
    have hn_base : N_base ≤ n := le_trans hN_base_le hn
    have hn₁ : N₁ ≤ n := le_trans (le_trans (le_max_left _ _) (le_max_right _ _)) hn
    have hn₂ : N₂ ≤ n :=
      le_trans (le_trans (le_max_left _ _) (le_trans (le_max_right _ _) (le_max_right _ _))) hn
    have hn₃ : N₃ ≤ n :=
      le_trans (le_trans (le_max_right _ _) (le_trans (le_max_right _ _) (le_max_right _ _))) hn
    have ha_lt_ra : ‖a n‖ < r_a := by
      have hd := hN₃ n hn₃
      rw [Real.dist_eq, sub_zero, abs_of_pos (ha_norm_pos n)] at hd
      exact hd
    have ha_lt_q : ‖a n‖ < ε_plus / 4 :=
      lt_of_lt_of_le ha_lt_ra (le_trans (min_le_left _ _) (min_le_left _ _))
    have ha_le_max : ‖a n‖ ≤ a_max :=
      le_of_lt (lt_of_lt_of_le ha_lt_ra (le_trans (min_le_left _ _) (min_le_right _ _)))
    have ha_lt_cel : ‖a n‖ < η / (3 * C_EL) :=
      lt_of_lt_of_le ha_lt_ra (min_le_right _ _)
    have hC_EL_a_lt : C_EL * ‖a n‖ < η / 3 := by
      have hmul := mul_lt_mul_of_pos_left ha_lt_cel hC_EL_pos
      have hsimp : C_EL * (η / (3 * C_EL)) = η / 3 := by
        field_simp [hC_EL_pos.ne']
      rwa [hsimp] at hmul
    have hdg_le : ∀ W ∈ Metric.closedBall Y_plus ((7 / 4 : ℝ) * ε_plus),
        ‖deriv (g_n n) W‖ ≤ η / 3 := by
      intro W hW
      have hd := hN₂ n hn₂ W hW
      rw [dist_zero_left] at hd
      exact hd.le
    refine ⟨ha_lt_q, fun Z hZ => ?_⟩
    have hZ_norm : ‖Z - Y_plus‖ < ε_plus := by
      simpa [Metric.mem_ball, dist_eq_norm] using hZ
    have hZa_norm : ‖Z + a n - Y_plus‖ < (5 / 4 : ℝ) * ε_plus := by
      have h_eq : Z + a n - Y_plus = (Z - Y_plus) + a n := by ring
      rw [h_eq]
      calc ‖(Z - Y_plus) + a n‖
          ≤ ‖Z - Y_plus‖ + ‖a n‖ := norm_add_le _ _
        _ < ε_plus + ε_plus / 4 := add_lt_add hZ_norm ha_lt_q
        _ = (5 / 4 : ℝ) * ε_plus := by ring
    have hZ2a_norm : ‖Z + a n + a n - Y_plus‖ < (3 / 2 : ℝ) * ε_plus := by
      have h_eq : Z + a n + a n - Y_plus = (Z + a n - Y_plus) + a n := by ring
      rw [h_eq]
      calc ‖(Z + a n - Y_plus) + a n‖
          ≤ ‖Z + a n - Y_plus‖ + ‖a n‖ := norm_add_le _ _
        _ < (5 / 4 : ℝ) * ε_plus + ε_plus / 4 := add_lt_add hZa_norm ha_lt_q
        _ = (3 / 2 : ℝ) * ε_plus := by ring
    have hZ_cb32 : Z ∈ Metric.closedBall Y_plus ((3 / 2 : ℝ) * ε_plus) := by
      rw [Metric.mem_closedBall, dist_eq_norm]
      linarith
    have hZa_cb32 : Z + a n ∈ Metric.closedBall Y_plus ((3 / 2 : ℝ) * ε_plus) := by
      rw [Metric.mem_closedBall, dist_eq_norm]
      linarith
    have hZ_cb2 : Z ∈ Metric.closedBall Y_plus (2 * ε_plus) :=
      Metric.closedBall_subset_closedBall (by linarith) hZ_cb32
    have hZa_cb2 : Z + a n ∈ Metric.closedBall Y_plus (2 * ε_plus) :=
      Metric.closedBall_subset_closedBall (by linarith) hZa_cb32
    have hZ2a_cb2 : Z + a n + a n ∈ Metric.closedBall Y_plus (2 * ε_plus) := by
      rw [Metric.mem_closedBall, dist_eq_norm]
      linarith
    have hg_Z : ‖S_init n Z - S_star (Z, T₀)‖ < η / 3 := by
      have hd := hN₁ n hn₁ Z hZ_cb2
      rw [dist_zero_left] at hd
      exact hd
    have hg_Za : ‖S_init n (Z + a n) - S_star (Z + a n, T₀)‖ < η / 3 := by
      have hd := hN₁ n hn₁ (Z + a n) hZa_cb2
      rw [dist_zero_left] at hd
      exact hd
    have hg_Z2a : ‖S_init n (Z + a n + a n) - S_star (Z + a n + a n, T₀)‖ < η / 3 := by
      have hd := hN₁ n hn₁ (Z + a n + a n) hZ2a_cb2
      rw [dist_zero_left] at hd
      exact hd
    have hp_K : (Z + a n, T₀) ∈ K_horiz := Or.inl ⟨hZa_cb2, rfl⟩
    have hEL_Za := hEL (Z + a n, T₀) hp_K (a n) (ha_norm_pos n) ha_le_max
    have hD_prev_mod :
        ‖(S_star (Z + a n, T₀) - S_star (Z, T₀)) / a n -
          deriv (fun Y' => S_star (Y', T₀)) (Z + a n)‖ ≤ C_EL * ‖a n‖ := by
      have hprev := hEL_Za.2.2.2.2.1
      simpa [add_sub_cancel_right] using hprev
    have hD_curr_mod :
        ‖(S_star (Z + a n + a n, T₀) - S_star (Z + a n, T₀)) / a n -
          deriv (fun Y' => S_star (Y', T₀)) (Z + a n)‖ ≤ C_EL * ‖a n‖ :=
      hEL_Za.2.2.2.2.2
    have hdiff_prev :
        ‖(S_init n (Z + a n) - S_init n Z) / a n -
          deriv (fun Y' => S_star (Y', T₀)) (Z + a n)‖ < (2 / 3 : ℝ) * η := by
      have h_split :
          (S_init n (Z + a n) - S_init n Z) / a n -
            deriv (fun Y' => S_star (Y', T₀)) (Z + a n) =
          (g_n n (Z + a n) - g_n n Z) / a n +
            ((S_star (Z + a n, T₀) - S_star (Z, T₀)) / a n -
              deriv (fun Y' => S_star (Y', T₀)) (Z + a n)) := by
        dsimp [g_n, f_star]
        field_simp [ha_ne n]
        ring
      rw [h_split]
      have hq_g := hg_diff_quot n hn_base (η / 3) ha_lt_q.le hdg_le Z hZ_cb32
      calc ‖(g_n n (Z + a n) - g_n n Z) / a n +
              ((S_star (Z + a n, T₀) - S_star (Z, T₀)) / a n -
                deriv (fun Y' => S_star (Y', T₀)) (Z + a n))‖
          ≤ ‖(g_n n (Z + a n) - g_n n Z) / a n‖ +
              ‖(S_star (Z + a n, T₀) - S_star (Z, T₀)) / a n -
                deriv (fun Y' => S_star (Y', T₀)) (Z + a n)‖ := norm_add_le _ _
        _ ≤ η / 3 + C_EL * ‖a n‖ := add_le_add hq_g hD_prev_mod
        _ < η / 3 + η / 3 := by linarith
        _ = (2 / 3 : ℝ) * η := by ring
    have hdiff_curr :
        ‖(S_init n (Z + a n + a n) - S_init n (Z + a n)) / a n -
          deriv (fun Y' => S_star (Y', T₀)) (Z + a n)‖ < (2 / 3 : ℝ) * η := by
      have h_split :
          (S_init n (Z + a n + a n) - S_init n (Z + a n)) / a n -
            deriv (fun Y' => S_star (Y', T₀)) (Z + a n) =
          (g_n n (Z + a n + a n) - g_n n (Z + a n)) / a n +
            ((S_star (Z + a n + a n, T₀) - S_star (Z + a n, T₀)) / a n -
              deriv (fun Y' => S_star (Y', T₀)) (Z + a n)) := by
        dsimp [g_n, f_star]
        field_simp [ha_ne n]
        ring
      rw [h_split]
      have hq_g := hg_diff_quot n hn_base (η / 3) ha_lt_q.le hdg_le (Z + a n) hZa_cb32
      calc ‖(g_n n (Z + a n + a n) - g_n n (Z + a n)) / a n +
              ((S_star (Z + a n + a n, T₀) - S_star (Z + a n, T₀)) / a n -
                deriv (fun Y' => S_star (Y', T₀)) (Z + a n))‖
          ≤ ‖(g_n n (Z + a n + a n) - g_n n (Z + a n)) / a n‖ +
              ‖(S_star (Z + a n + a n, T₀) - S_star (Z + a n, T₀)) / a n -
                deriv (fun Y' => S_star (Y', T₀)) (Z + a n)‖ := norm_add_le _ _
        _ ≤ η / 3 + C_EL * ‖a n‖ := add_le_add hq_g hD_curr_mod
        _ < η / 3 + η / 3 := by linarith
        _ = (2 / 3 : ℝ) * η := by ring
    exact ⟨by linarith, by linarith, by linarith, by linarith, by linarith, by linarith⟩
  obtain ⟨N_tr, hN_tr_base, hN_tr_eng, hN_tr⟩ := h_init_small r_init hr_init_pos
  let S_chain : ℕ → ℕ → ℂ → ℂ := fun n j Z =>
    match j with
    | 0 => S_init n Z
    | m + 1 =>
        (rctRunCorridorChain seq Ψ 1 n m (Z + a n) T₀
          (rctInitSymplecticState P seq n 1 (S_init n Z) (S_init n (Z + a n)) T₀)).1
  have hS_chain_one : ∀ (n : ℕ) (Z : ℂ), S_chain n 1 Z = S_init n (Z + a n) := by
    intro n Z
    simp [S_chain, rctRunCorridorChain, rctInitSymplecticState, zero_lt_one]
  have h_traj : ∀ (n m : ℕ), m + 1 ≤ N_step n →
      (m : ℝ) / b n ≤ L_max ∧
      ∀ Z ∈ Metric.ball Y_plus ε_plus, ∀ k ≤ m,
        ((Z + a n) + (k : ℂ) * ((1 : ℝ) : ℂ) * a n, T₀) ∈ U_corr := by
    intro n m hm
    have hm_le : (m : ℝ) ≤ (N_step n : ℝ) :=
      Nat.cast_le.mpr (le_trans (Nat.le_succ m) hm)
    have hm_div : (m : ℝ) / b n ≤ L_max :=
      le_trans (div_le_div_of_nonneg_right hm_le (hb_pos n).le) (hStep_le n)
    refine ⟨hm_div, fun Z hZ k hk => ?_⟩
    let τ : ℝ := ((k + 1 : ℕ) : ℝ) / b n
    have hτ_nonneg : 0 ≤ τ := div_nonneg (Nat.cast_nonneg _) (hb_pos n).le
    have hk1_le : (k + 1 : ℕ) ≤ N_step n := le_trans (Nat.add_le_add_right hk 1) hm
    have hτ_le : τ ≤ L_max :=
      le_trans (div_le_div_of_nonneg_right (Nat.cast_le.mpr hk1_le) (hb_pos n).le) (hStep_le n)
    have h_pt_eq : (Z + a n) + (k : ℂ) * ((1 : ℝ) : ℂ) * a n = Z + (τ : ℂ) * T₀ := by
      dsimp [a, τ]
      have hne : ((b n : ℝ) : ℂ) ≠ 0 := hb_c_ne n
      push_cast
      field_simp [hne]
      ring
    rw [h_pt_eq]
    apply hK_sub_U
    exact Or.inr ⟨(Z, τ), ⟨Metric.ball_subset_closedBall hZ, ⟨hτ_nonneg, hτ_le⟩⟩, rfl⟩
  refine ⟨N_tr, S_chain, hN_tr_base, ?_, ?_, ?_, ?_⟩
  · intro n hn j hj
    have hn_base : N_base ≤ n := le_trans hN_tr_base hn
    have hn_eng : N_eng ≤ n := le_trans hN_tr_eng hn
    rcases j with _ | m
    · exact (hInit_holo n hn_base).mono (Metric.ball_subset_ball (by linarith))
    · obtain ⟨hm_div, h_corr⟩ := h_traj n m hj
      obtain ⟨ha_lt_q, h_small_n⟩ := hN_tr n hn
      let W : Set (ℂ × ℂ) := Metric.ball Y_plus ε_plus ×ˢ Set.univ
      have hW_open : IsOpen W := Metric.isOpen_ball.prod isOpen_univ
      let Y₀_fn : ℂ × ℂ → ℂ := fun w => w.1 + a n
      let T_fn : ℂ × ℂ → ℂ := fun _ => T₀
      let S_prev_fn : ℂ × ℂ → ℂ := fun w => S_init n w.1
      let S_curr_fn : ℂ × ℂ → ℂ := fun w => S_init n (w.1 + a n)
      have hY₀_holo : DifferentiableOn ℂ Y₀_fn W :=
        (differentiable_fst.add (differentiable_const (a n))).differentiableOn
      have hT_holo : DifferentiableOn ℂ T_fn W := differentiableOn_const T₀
      have hSp_holo : DifferentiableOn ℂ S_prev_fn W := by
        refine (hInit_holo n hn_base).comp differentiable_fst.differentiableOn ?_
        intro w hw
        exact Metric.ball_subset_ball (by linarith) hw.1
      have hSc_holo : DifferentiableOn ℂ S_curr_fn W := by
        refine (hInit_holo n hn_base).comp
          (differentiable_fst.add (differentiable_const (a n))).differentiableOn ?_
        intro w hw
        have hw1 : ‖w.1 - Y_plus‖ < ε_plus := by
          simpa [Metric.mem_ball, dist_eq_norm] using hw.1
        rw [Metric.mem_ball, dist_eq_norm]
        have h_eq : w.1 + a n - Y_plus = (w.1 - Y_plus) + a n := by ring
        rw [h_eq]
        calc ‖(w.1 - Y_plus) + a n‖
            ≤ ‖w.1 - Y_plus‖ + ‖a n‖ := norm_add_le _ _
          _ < ε_plus + ε_plus / 4 := add_lt_add hw1 ha_lt_q
          _ < 3 * ε_plus := by linarith
      have h2d := hParam_holo n hn_eng m hm_div W Y₀_fn T_fn S_prev_fn S_curr_fn
        hW_open hY₀_holo hT_holo hSp_holo hSc_holo ?_ m le_rfl
      · refine h2d.comp (differentiable_id.prodMk (differentiable_const (0 : ℂ))).differentiableOn ?_
        intro Z hZ
        exact ⟨hZ, trivial⟩
      · intro w hw
        refine ⟨hT₀, le_rfl, h_corr w.1 hw.1, ?_⟩
        simpa [Y₀_fn, T_fn, S_prev_fn, S_curr_fn, a, b] using (h_small_n w.1 hw.1).2.2.2.2.2
  · intro n _ Z _
    exact ⟨rfl, hS_chain_one n Z⟩
  · intro n hn j hj Z hZ a_n _hZa_in
    have hn_base : N_base ≤ n := le_trans hN_tr_base hn
    have hn_eng : N_eng ≤ n := le_trans hN_tr_eng hn
    rcases j with _ | m
    · exact hS_chain_one n Z
    · obtain ⟨ha_lt_q, h_small_n⟩ := hN_tr n hn
      obtain ⟨h_s0, h_s1, h_s2, h_d0, h_d1, _⟩ := h_small_n Z hZ
      have hZ_norm : ‖Z - Y_plus‖ < ε_plus := by
        simpa [Metric.mem_ball, dist_eq_norm] using hZ
      have hZa_norm : ‖Z + a n - Y_plus‖ < (5 / 4 : ℝ) * ε_plus := by
        have h_eq : Z + a n - Y_plus = (Z - Y_plus) + a n := by ring
        rw [h_eq]
        calc ‖(Z - Y_plus) + a n‖
            ≤ ‖Z - Y_plus‖ + ‖a n‖ := norm_add_le _ _
          _ < ε_plus + ε_plus / 4 := add_lt_add hZ_norm ha_lt_q
          _ = (5 / 4 : ℝ) * ε_plus := by ring
      have hZa_b2 : Z + a n ∈ Metric.ball Y_plus (2 * ε_plus) := by
        rw [Metric.mem_ball, dist_eq_norm]
        linarith
      have hZa_sub_b3 : (Z + a n) - a n ∈ Metric.ball Y_plus (3 * ε_plus) := by
        rw [add_sub_cancel_right]
        exact Metric.ball_subset_ball (by linarith) hZ
      have hZa_add_b3 : (Z + a n) + a n ∈ Metric.ball Y_plus (3 * ε_plus) := by
        rw [Metric.mem_ball, dist_eq_norm]
        have h_eq : (Z + a n) + a n - Y_plus = (Z + a n - Y_plus) + a n := by ring
        rw [h_eq]
        calc ‖(Z + a n - Y_plus) + a n‖
            ≤ ‖Z + a n - Y_plus‖ + ‖a n‖ := norm_add_le _ _
          _ < (5 / 4 : ℝ) * ε_plus + ε_plus / 4 := add_lt_add hZa_norm ha_lt_q
          _ < 3 * ε_plus := by linarith
      have h_rec : SatisfiesScaledChordRecurrence P seq (S_init n) n (Z + a n) T₀ :=
        hInit_rec n hn_base (Z + a n) hZa_b2 hZa_sub_b3 hZa_add_b3
      have hZa_U : (Z + a n, T₀) ∈ U_corr :=
        hK_sub_U (Or.inl ⟨Metric.ball_subset_closedBall hZa_b2, rfl⟩)
      have h_step := hStep_rec n hn_eng (Z + a n) T₀ (S_init n) hZa_U hT₀ le_rfl h_rec
        (by simpa [a, b] using h_s0)
        h_s1
        (by simpa [a, b] using h_s2)
        (by simpa [a, b] using h_d0)
        (by simpa [a, b] using h_d1)
      let q₀ : ℂ → ℂ × ℂ := fun W =>
        rctInitSymplecticState P seq n 1 (S_init n W) (S_init n (W + a n)) T₀
      have h_one_step :
          rctRunCorridorChain seq Ψ 1 n 1 (Z + a n) T₀ (q₀ Z) = q₀ (Z + a n) := by
        simpa [rctRunCorridorChain, q₀, a, b] using h_step
      change (rctRunCorridorChain seq Ψ 1 n (m + 1) (Z + a n) T₀ (q₀ Z)).1 =
        (rctRunCorridorChain seq Ψ 1 n m ((Z + a n) + a n) T₀ (q₀ (Z + a n))).1
      rw [Nat.add_comm m 1, hChain_add n 1 m (Z + a n) T₀ (q₀ Z), h_one_step]
      congr 1
      congr 2
      simp [a, b]
  · intro ε hε
    let η_ε : ℝ := min (ε / 2) (ε / (3 * C_Gron))
    have hη_ε_pos : 0 < η_ε := lt_min (half_pos hε) (by positivity)
    obtain ⟨N_init_ε, _, _, hN_init_ε⟩ := h_init_small η_ε hη_ε_pos
    obtain ⟨N_δ_ε, hN_δ_ε⟩ :=
      Metric.tendsto_atTop.mp hδ_tendsto (ε / (3 * C_Gron)) (by positivity)
    let N₁ : ℕ := max N_tr (max N_init_ε N_δ_ε)
    refine ⟨N₁, le_max_left _ _, fun n hn j hj Z hZ => ?_⟩
    have hn_tr : N_tr ≤ n := le_trans (le_max_left _ _) hn
    have hn_eng : N_eng ≤ n := le_trans hN_tr_eng hn_tr
    have hn_init : N_init_ε ≤ n := le_trans (le_trans (le_max_left _ _) (le_max_right _ _)) hn
    have hn_δ : N_δ_ε ≤ n := le_trans (le_trans (le_max_right _ _) (le_max_right _ _)) hn
    rcases j with _ | m
    · have h0_eq : Z + ((0 : ℕ) : ℂ) * a n = Z := by simp
      change ‖S_init n Z - S_star (Z + ((0 : ℕ) : ℂ) * a n, T₀)‖ < ε
      rw [h0_eq]
      have hs0 := ((hN_init_ε n hn_init).2 Z hZ).1
      have hle : η_ε ≤ ε / 2 := min_le_left _ _
      linarith
    · obtain ⟨hm_div, h_corr⟩ := h_traj n m hj
      have he_tr :
          ‖S_init n (Z + a n) - S_star (Z + a n, T₀)‖ +
            ‖(S_init n (Z + a n) - S_init n Z) / (((1 : ℝ) : ℂ) * a n) -
              deriv (fun Y' => S_star (Y', T₀)) (Z + a n)‖ < r_init := by
        rw [h1_mul]
        exact ((hN_tr n hn_tr).2 Z hZ).2.2.2.2.2
      have h_gron :=
        (hGronwall n hn_eng m hm_div (Z + a n) T₀ (S_init n Z) (S_init n (Z + a n))
          hT₀ le_rfl (h_corr Z hZ) he_tr m le_rfl).1
      have h_pt :
          (Z + a n) + (m : ℂ) * ((1 : ℝ) : ℂ) * a n = Z + ((m + 1 : ℕ) : ℂ) * a n := by
        push_cast
        ring
      change ‖(rctRunCorridorChain seq Ψ 1 n m (Z + a n) T₀
          (rctInitSymplecticState P seq n 1 (S_init n Z) (S_init n (Z + a n)) T₀)).1 -
        S_star (Z + ((m + 1 : ℕ) : ℂ) * a n, T₀)‖ < ε
      rw [← h_pt]
      have he_ε :
          ‖S_init n (Z + a n) - S_star (Z + a n, T₀)‖ +
            ‖(S_init n (Z + a n) - S_init n Z) / (((1 : ℝ) : ℂ) * a n) -
              deriv (fun Y' => S_star (Y', T₀)) (Z + a n)‖ < ε / (3 * C_Gron) := by
        rw [h1_mul]
        exact lt_of_lt_of_le (((hN_init_ε n hn_init).2 Z hZ).2.2.2.2.2) (min_le_right _ _)
      have hδ_lt : δ_mod n < ε / (3 * C_Gron) := by
        have hd := hN_δ_ε n hn_δ
        rw [Real.dist_eq, sub_zero, abs_of_nonneg (hδ_nonneg n)] at hd
        exact hd
      have h_bound :
          C_Gron *
            ((‖S_init n (Z + a n) - S_star (Z + a n, T₀)‖ +
              ‖(S_init n (Z + a n) - S_init n Z) / (((1 : ℝ) : ℂ) * a n) -
                deriv (fun Y' => S_star (Y', T₀)) (Z + a n)‖) + δ_mod n) < ε := by
        have hsum_lt :
            (‖S_init n (Z + a n) - S_star (Z + a n, T₀)‖ +
              ‖(S_init n (Z + a n) - S_init n Z) / (((1 : ℝ) : ℂ) * a n) -
                deriv (fun Y' => S_star (Y', T₀)) (Z + a n)‖) + δ_mod n <
            ε / (3 * C_Gron) + ε / (3 * C_Gron) := add_lt_add he_ε hδ_lt
        have hmul := mul_lt_mul_of_pos_left hsum_lt hC_Gron_pos
        have h_eq : C_Gron * (ε / (3 * C_Gron) + ε / (3 * C_Gron)) = (2 / 3 : ℝ) * ε := by
          field_simp [hC_Gron_pos.ne']
          ring
        linarith
      exact lt_of_le_of_lt h_gron h_bound

theorem steep_corridor_vertical_passage (X : ExpStripData) (hX : IsExpObstructionStrip X)
    (P : ChordActionPackage X) (kind : ExpProfileKind)
    (seq : ExpSequenceData X kind)
    (hEngine : RctCorridorStepEngineProp X P kind seq) :
    ∀ (V_mod : Set (ℂ × ℂ)) (S_star : ℂ × ℂ → ℂ)
      (σ η T_max : ℝ) (U_T : Set ℂ) (x_lo x_hi y_bot y_top : ℝ)
      (K_steep : Set (ℂ × ℂ)),
      IsRegularFrozenModel seq V_mod S_star →
      (σ = 1 ∨ σ = -1) → 0 < η → 0 < T_max →
      IsOpen U_T →
      U_T ⊆ { T : ℂ | η < σ * T.im ∧ ‖T‖ < T_max } →
      x_lo < x_hi → y_bot < y_top →
      (let B_init : Set (ℂ × ℂ) :=
        { p : ℂ × ℂ |
          x_lo < p.1.re ∧ p.1.re < x_hi ∧
          y_bot < p.1.im ∧ p.1.im < y_top ∧ p.2 ∈ U_T }
       let y_mid : ℝ := (y_bot + y_top) / 2
       let δ_y : ℝ := (y_top - y_bot) / 4
       B_init ⊆ V_mod →
       IsCompact K_steep →
       K_steep ⊆ { p : ℂ × ℂ |
         x_lo < p.1.re ∧ p.1.re < x_hi ∧
         y_bot + δ_y ≤ p.1.im ∧ p.2 ∈ U_T } →
       (∀ p ∈ K_steep, ∀ τ ∈ Set.Icc y_mid (max y_mid p.1.im),
         let Y_vert : ℂ := (p.1.re : ℂ) + (τ : ℂ) * Complex.I
         let s_end : ℝ := (τ - y_mid) / (σ * p.2.im)
         (∀ s ∈ Set.Icc (0 : ℝ) s_end,
           (Y_vert - (s : ℂ) * (σ : ℂ) * p.2, p.2) ∈ V_mod) ∧
         x_lo < (Y_vert - (s_end : ℂ) * (σ : ℂ) * p.2).re ∧
         (Y_vert - (s_end : ℂ) * (σ : ℂ) * p.2).re < x_hi) →
       ∃ W_steep : Set (ℂ × ℂ),
         IsOpen W_steep ∧
         K_steep ⊆ W_steep ∧
         W_steep ⊆ V_mod ∧
         W_steep ⊆ { p : ℂ × ℂ |
           x_lo < p.1.re ∧ p.1.re < x_hi ∧
           y_bot + δ_y / 2 < p.1.im ∧ p.2 ∈ U_T } ∧
         (∀ Y T : ℂ, (Y, T) ∈ W_steep →
           ∀ τ : ℝ, y_bot + δ_y ≤ τ → τ ≤ Y.im →
             ((Y.re : ℂ) + (τ : ℂ) * Complex.I, T) ∈ W_steep) ∧
         ∀ (N₀ : ℕ) (S_low : ℕ → ℂ × ℂ → ℂ),
           (∀ n ≥ N₀, DifferentiableOn ℂ (S_low n) B_init) →
           (∀ n ≥ N₀, ∀ Y T : ℂ, T ≠ 0 →
             (Y, T) ∈ B_init →
             (Y - T / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ), T) ∈ B_init →
             (Y + T / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ), T) ∈ B_init →
             SatisfiesScaledChordRecurrence P seq (fun Z => S_low n (Z, T)) n Y T) →
           (∀ K : Set (ℂ × ℂ), IsCompact K → K ⊆ B_init →
             TendstoUniformlyOn S_low S_star Filter.atTop K) →
           ∃ (N_st : ℕ) (S_ext : ℕ → ℂ × ℂ → ℂ),
             N₀ ≤ N_st ∧
             (∀ n ≥ N_st, DifferentiableOn ℂ (S_ext n) W_steep) ∧
             (∀ n ≥ N_st, ∀ p ∈ W_steep,
               expBasePt seq n + (seq.ℓ_seq n : ℂ) * S_ext n p ∈ X.D_strip) ∧
             (∀ n ≥ N_st, ∀ p ∈ W_steep, p.1.im < y_top - δ_y →
               S_ext n p = S_low n p) ∧
             TendstoUniformlyOn S_ext S_star Filter.atTop K_steep) :=
by
  have _ := hX
  intro V_mod S_star σ η T_max U_T x_lo x_hi y_bot y_top K_steep
    hMod hσ hη hT_max hUT_open hUT_sub hx hy
    B_init y_mid δ_y hB_sub hK_comp hK_sub hRays
  by_cases hK_ne : K_steep.Nonempty
  swap
  · have hK_eq : K_steep = ∅ := Set.not_nonempty_iff_eq_empty.mp hK_ne
    refine ⟨∅, isOpen_empty, by simp [hK_eq], Set.empty_subset _, Set.empty_subset _,
      fun _ _ h => False.elim h, fun N₀ S_low _ _ _ => ⟨N₀, S_low, le_rfl,
        fun _ _ => differentiableOn_empty,
        fun _ _ _ h => False.elim h,
        fun _ _ _ h _ => False.elim h,
        by rw [hK_eq]; exact tendstoUniformlyOn_empty⟩⟩
  have hδ_y_pos : 0 < δ_y := by
    change 0 < (y_top - y_bot) / 4
    linarith
  have hy_mid_eq : y_mid = y_bot + 2 * δ_y := by
