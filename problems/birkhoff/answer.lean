        ∀ (k : ℕ) (L : List ℂ),
          (∀ α ∈ L, ‖α‖ < r_y / 2) →
          (2 * ↑Real.pi * Complex.I)⁻¹ *
            (∮ w in C(0, r_y), w ^ k * (L.map (fun α => (w - α)⁻¹)).sum) =
            (L.map (fun α => α ^ k)).sum := by
      intro k L
      induction L with
      | nil =>
        intro _
        simp [circleIntegral]
      | cons α L ih =>
        intro hrad
        have hα_lt : ‖α‖ < r_y := lt_trans (hrad α List.mem_cons_self) (by linarith)
        have hrad_L : ∀ β ∈ L, ‖β‖ < r_y / 2 :=
          fun β hβ => hrad β (List.mem_cons_of_mem α hβ)
        have hne_α : ∀ w ∈ Metric.sphere (0 : ℂ) r_y, w - α ≠ 0 := by
          intro w hw h0
          rw [sub_eq_zero.mp h0] at hw
          have : ‖α‖ = r_y := by simpa [Metric.mem_sphere] using hw
          linarith
        have hcont_1 : ContinuousOn (fun w : ℂ => w ^ k * (w - α)⁻¹) (Metric.sphere 0 r_y) :=
