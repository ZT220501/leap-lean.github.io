    let ϕ₁ : ℂ → ℂ := fun z =>
      if z = 0 then α / ((m + 1 : ℕ) : ℂ) else (K.ϕ (s₀ + z) - ϕ₀) / z ^ (m + 1)
    have hϕ₁_0 : ϕ₁ 0 = α / ((m + 1 : ℕ) : ℂ) := by simp [ϕ₁]
    have hϕ₁_eq : ∀ z : ℂ, K.ϕ (s₀ + z) - ϕ₀ = z ^ (m + 1) * ϕ₁ z := by
      intro z
      by_cases hz : z = 0
      · subst hz; simp [ϕ₀]
      · simp only [ϕ₁, hz, ↓reduceIte]
        exact (mul_div_cancel₀ _ (pow_ne_zero (m + 1) hz)).symm
    have hϕ₁_cont : ContinuousAt ϕ₁ 0 := by
      rw [Metric.continuousAt_iff]
      intro ε hε
      refine ⟨min ρ_f (ε / (M₁ + 1)), lt_min hρ_f_pos (div_pos hε (by linarith)), ?_⟩
      intro z hz_dist
      rw [dist_zero_right] at hz_dist
      rw [dist_eq_norm]
      by_cases hz0 : z = 0
      · subst hz0; simp [hε]
      · have hz_le : ‖z‖ ≤ ρ_f := le_of_lt (lt_of_lt_of_le hz_dist (min_le_left _ _))
        have hz_lt_eps : ‖z‖ < ε / (M₁ + 1) := lt_of_lt_of_le hz_dist (min_le_right _ _)
        have hcb_sub : Metric.closedBall (0 : ℂ) ‖z‖ ⊆ Metric.ball (0 : ℂ) R₀ :=
