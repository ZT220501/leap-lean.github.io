        by_contra hne
        have h_in_bad : R_p ∈ Bad := ⟨q, hq, hne⟩
        exact hd₁_not (Set.mem_biUnion h_in_bad ⟨hd₁_mem, h0⟩)
      let ev_pt : MvPolynomial ι_all (↥K₀) →+* ℂ :=
        MvPolynomial.eval₂Hom K₀.subtype (fun v => jetFn v (Ψ q₁))
      let E_frac : Subfield ℂ := {
        carrier := { z : ℂ | ∃ A B : MvPolynomial ι_all (↥K₀), ev_pt B ≠ 0 ∧ z = ev_pt A / ev_pt B }
        mul_mem' := by
          rintro _ _ ⟨A₁, B₁, hB₁, rfl⟩ ⟨A₂, B₂, hB₂, rfl⟩
          exact ⟨A₁ * A₂, B₁ * B₂, by rw [map_mul]; exact mul_ne_zero hB₁ hB₂,
