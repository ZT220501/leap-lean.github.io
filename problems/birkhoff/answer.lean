            h_nhds.mono (fun z hz => ih (z, q.2) hz)
          have h_f_holo : DifferentiableOn ℂ (iterDerivY m f) U :=
            B_cr.iterDerivYT_holo hU hf m 0
          have hd₁ : DifferentiableAt ℂ (fun z => iterDerivY m f (z, q.2)) q.1 :=
            show DifferentiableAt ℂ (fun z => iterDerivY m f (z, q.2)) q.1 from
              (h_f_holo.differentiableAt (hU.mem_nhds hq)).comp q.1
                (differentiableAt_id.prodMk (differentiableAt_const q.2))
          have hd₂ : DifferentiableAt ℂ (fun z => D_f (z, q.2)) q.1 :=
            show DifferentiableAt ℂ (fun z => D_f (z, q.2)) q.1 from
              (hD.differentiableAt (hU.mem_nhds hq)).comp q.1
                (differentiableAt_id.prodMk (differentiableAt_const q.2))
          have h_prod_d := (hd₁.hasDerivAt.mul (hd₂.hasDerivAt.pow (m + 1))).deriv
          change deriv (fun z => iterDerivY m f (z, q.2) * (D_f (z, q.2)) ^ (m + 1)) q.1 =
            deriv (fun z => iterDerivY m f (z, q.2)) q.1 * (D_f q) ^ (m + 1) +
              iterDerivY m f q *
                (((m + 1 : ℕ) : ℂ) * (D_f q) ^ m * deriv (fun z => D_f (z, q.2)) q.1) at h_prod_d
          have hpA_eq : pderivA (ssbpcQuotNumY D_f m N_f) q =
              iterDerivY (m + 1) f q * (D_f q) ^ (m + 1) +
                iterDerivY m f q * (((m + 1 : ℕ) : ℂ) * (D_f q) ^ m * pderivA D_f q) := by
            dsimp [pderivA, iterDerivY]
            rw [h_ev.deriv_eq, h_prod_d]
          dsimp [ssbpcQuotNumY]
          rw [hpA_eq, ih q hq]
          ring
      intro b
      induction b with
      | zero =>
        intro q hq
        simpa [ssbpcQuotNumYT, iterDerivYT] using h_y a q hq
      | succ b ih =>
        intro q hq
        have h_nhds : ∀ᶠ z in nhds q.2, (q.1, z) ∈ U :=
          (hU.preimage (continuous_const.prodMk continuous_id)).mem_nhds hq
        have h_ev : (fun z => ssbpcQuotNumYT D_f a b N_f (q.1, z)) =ᶠ[nhds q.2]
            (fun z => iterDerivYT a b f (q.1, z) * (D_f (q.1, z)) ^ (a + b + 1)) :=
          h_nhds.mono (fun z hz => ih (q.1, z) hz)
        have h_f_holo : DifferentiableOn ℂ (iterDerivYT a b f) U :=
          B_cr.iterDerivYT_holo hU hf a b
        have hd₁ : DifferentiableAt ℂ (fun z => iterDerivYT a b f (q.1, z)) q.2 :=
          show DifferentiableAt ℂ (fun z => iterDerivYT a b f (q.1, z)) q.2 from
            DifferentiableAt.comp (g := iterDerivYT a b f) q.2
              (h_f_holo.differentiableAt (hU.mem_nhds hq))
              ((differentiableAt_const (𝕜 := ℂ) q.1).prodMk differentiableAt_id)
        have hd₂ : DifferentiableAt ℂ (fun z => D_f (q.1, z)) q.2 :=
          show DifferentiableAt ℂ (fun z => D_f (q.1, z)) q.2 from
            DifferentiableAt.comp (g := D_f) q.2
              (hD.differentiableAt (hU.mem_nhds hq))
              ((differentiableAt_const (𝕜 := ℂ) q.1).prodMk differentiableAt_id)
        have h_prod_d := (hd₁.hasDerivAt.mul (hd₂.hasDerivAt.pow (a + b + 1))).deriv
        change deriv (fun z => iterDerivYT a b f (q.1, z) * (D_f (q.1, z)) ^ (a + b + 1)) q.2 =
          deriv (fun z => iterDerivYT a b f (q.1, z)) q.2 * (D_f q) ^ (a + b + 1) +
            iterDerivYT a b f q *
              (((a + b + 1 : ℕ) : ℂ) * (D_f q) ^ (a + b) * deriv (fun z => D_f (q.1, z)) q.2) at h_prod_d
        have h_step_d : deriv (fun z => iterDerivYT a b f (q.1, z)) q.2 =
            iterDerivYT a (b + 1) f q := by
          simp [iterDerivYT, Function.iterate_succ_apply']
        have hpD_eq : pderivD (ssbpcQuotNumYT D_f a b N_f) q =
            iterDerivYT a (b + 1) f q * (D_f q) ^ (a + b + 1) +
              iterDerivYT a b f q *
                (((a + b + 1 : ℕ) : ℂ) * (D_f q) ^ (a + b) * pderivD D_f q) := by
          dsimp [pderivD]
          rw [h_ev.deriv_eq, h_prod_d, h_step_d]
        dsimp [ssbpcQuotNumYT]
        rw [hpD_eq, ih q hq]
        ring
    have h_homog_eval : ∀ {σ : Type} [Fintype σ] (R : ℕ) (P : MvPolynomial σ ℂ),
        ssbpcPolyDeg P ≤ R → ∀ (env : σ → ℂ) (D_den : ℂ),
        ssbpcHomogEval R P (fun v => env v * D_den) D_den =
          D_den ^ R * MvPolynomial.eval env P := by
      intro σ _ R P hR env D_den
      rw [MvPolynomial.eval_eq', Finset.mul_sum]
      dsimp [ssbpcHomogEval]
      refine Finset.sum_congr rfl (fun m hm => ?_)
      have hm_le : (∑ v : σ, m v) ≤ R :=
        le_trans (Finset.le_sup (f := fun m' : σ →₀ ℕ => ∑ v : σ, m' v) hm) hR
      have h_prod : (∏ v : σ, (env v * D_den) ^ (m v)) =
          (∏ v : σ, (env v) ^ (m v)) * D_den ^ (∑ v : σ, m v) := by
        calc ∏ v : σ, (env v * D_den) ^ (m v)
            = ∏ v : σ, ((env v) ^ (m v) * D_den ^ (m v)) :=
              Finset.prod_congr rfl (fun v _ => mul_pow _ _ _)
          _ = (∏ v : σ, (env v) ^ (m v)) * (∏ v : σ, D_den ^ (m v)) := Finset.prod_mul_distrib
          _ = (∏ v : σ, (env v) ^ (m v)) * D_den ^ (∑ v : σ, m v) := by
              rw [Finset.prod_pow_eq_pow_sum]
      rw [h_prod]
      calc P.coeff m * ((∏ v : σ, env v ^ m v) * D_den ^ ∑ v : σ, m v) *
              D_den ^ (R - ∑ v : σ, m v)
          = P.coeff m * (∏ v : σ, env v ^ m v) *
              (D_den ^ (∑ v : σ, m v) * D_den ^ (R - ∑ v : σ, m v)) := by ring
        _ = P.coeff m * (∏ v : σ, env v ^ m v) * D_den ^ R := by
            rw [← pow_add, Nat.add_sub_of_le hm_le]
        _ = D_den ^ R * (P.coeff m * ∏ v : σ, env v ^ m v) := by ring
    have h_spec_on_open : ∀ (M R : ℕ) (P : MvPolynomial (PointJetVar M) ℂ),
        ssbpcPolyDeg P ≤ R →
        ∀ p ∈ Ω_dom, ∀ {U : Set (ℂ × ℂ)} {f₀ f₁ : Fin 2 → ℂ × ℂ → ℂ},
          IsOpen U → U ⊆ Metric.ball p (ssbpcPairChartRad E₀ E₁ p) →
          (∀ i : Fin 2, DifferentiableOn ℂ (f₀ i) U ∧ DifferentiableOn ℂ (f₁ i) U) →
          (∀ ci : Fin 2 × Fin 2, ∀ q ∈ U,
            ssbpcPairNum E₀ E₁ p q ci =
              (if ci.1 = 0 then f₀ ci.2 q else f₁ ci.2 q) * ssbpcPairDen E₀ E₁ p q ci) →
          ∀ q ∈ U,
            ssbpcClearedPoly M R P E₀ E₁ A p q =
              ((ssbpcPairDenProd E₀ E₁ p q) ^ (2 * M + 1)) ^ R *
                MvPolynomial.eval (pointJetEnv M f₀ f₁ A q) P := by
      intro M R P hR p hp U f₀ f₁ hU hU_sub hf_holo h_rel q hq
      let D_com := (ssbpcPairDenProd E₀ E₁ p q) ^ (2 * M + 1)
      have h_env : ssbpcClearedJetEnv M E₀ E₁ A p q =
          fun v => pointJetEnv M f₀ f₁ A q v * D_com := by
        ext v
        rcases v with ⟨c_idx, i_idx, a_idx, b_idx⟩ | β_idx
        · dsimp [ssbpcClearedJetEnv, pointJetEnv]
          let ci : Fin 2 × Fin 2 := (c_idx, i_idx)
          let f_ci : ℂ × ℂ → ℂ := fun r => if c_idx = 0 then f₀ i_idx r else f₁ i_idx r
          have hf_ci_holo : DifferentiableOn ℂ f_ci U := by
            by_cases hc0 : c_idx = 0
            · have h_eq : f_ci = f₀ i_idx := by ext r; simp [f_ci, hc0]
              rw [h_eq]; exact (hf_holo i_idx).1
            · have h_eq : f_ci = f₁ i_idx := by ext r; simp [f_ci, hc0]
              rw [h_eq]; exact (hf_holo i_idx).2
          have hD_ci_holo : DifferentiableOn ℂ (fun r => ssbpcPairDen E₀ E₁ p r ci) U :=
            (h_num_den_holo p hp ci).2.mono hU_sub
          have h_rel_ci : ∀ q' ∈ U,
              ssbpcPairNum E₀ E₁ p q' ci = f_ci q' * ssbpcPairDen E₀ E₁ p q' ci :=
            fun q' hq' => h_rel ci q' hq'
          have h_qid := h_quotYT_id hU hD_ci_holo hf_ci_holo h_rel_ci a_idx.1 b_idx.1 q hq
          have hab_le : a_idx.1 + b_idx.1 + 1 ≤ 2 * M + 1 := by
            have := a_idx.2
            have := b_idx.2
            omega
          have h_fci_val : iterDerivYT a_idx.1 b_idx.1 f_ci q =
              (if c_idx = 0 then iterDerivYT a_idx.1 b_idx.1 (f₀ i_idx) q
               else iterDerivYT a_idx.1 b_idx.1 (f₁ i_idx) q) := by
            by_cases hc0 : c_idx = 0
            · have h_eq : f_ci = f₀ i_idx := by ext r; simp [f_ci, hc0]
              simp [hc0, h_eq]
            · have h_eq : f_ci = f₁ i_idx := by ext r; simp [f_ci, hc0]
              simp [hc0, h_eq]
          rw [h_qid, h_fci_val]
          have h_pow_comb : (ssbpcPairDen E₀ E₁ p q ci) ^ (a_idx.1 + b_idx.1 + 1) *
              (ssbpcPairDen E₀ E₁ p q ci) ^ (2 * M + 1 - (a_idx.1 + b_idx.1 + 1)) =
              (ssbpcPairDen E₀ E₁ p q ci) ^ (2 * M + 1) := by
            rw [← pow_add, Nat.add_sub_of_le hab_le]
          have h_prod_er : (ssbpcPairDen E₀ E₁ p q ci) ^ (2 * M + 1) *
              (∏ cj ∈ Finset.univ.erase ci, (ssbpcPairDen E₀ E₁ p q cj) ^ (2 * M + 1)) =
              D_com := by
            rw [Finset.mul_prod_erase Finset.univ
              (fun cj => (ssbpcPairDen E₀ E₁ p q cj) ^ (2 * M + 1)) (Finset.mem_univ ci),
              Finset.prod_pow]
            rfl
          calc _ = (if c_idx = 0 then iterDerivYT a_idx.1 b_idx.1 (f₀ i_idx) q
                    else iterDerivYT a_idx.1 b_idx.1 (f₁ i_idx) q) *
                  ((ssbpcPairDen E₀ E₁ p q ci ^ (a_idx.1 + b_idx.1 + 1) *
                    ssbpcPairDen E₀ E₁ p q ci ^ (2 * M + 1 - (a_idx.1 + b_idx.1 + 1))) *
                   ∏ cj ∈ Finset.univ.erase ci, ssbpcPairDen E₀ E₁ p q cj ^ (2 * M + 1)) := by ring
            _ = _ := by rw [h_pow_comb, h_prod_er]
        · rfl
      dsimp [ssbpcClearedPoly]
      rw [h_env]
      exact h_homog_eval R P hR (pointJetEnv M f₀ f₁ A q) D_com
    have h_eval_reg : ∀ (M R : ℕ) (P : MvPolynomial (PointJetVar M) ℂ),
        ssbpcPolyDeg P ≤ R →
        ∀ p ∈ Ω_dom, ∀ q ∈ Metric.ball p (ssbpcPairChartRad E₀ E₁ p),
          ssbpcPairDenProd E₀ E₁ p q ≠ 0 →
          let D_com := (ssbpcPairDenProd E₀ E₁ p q) ^ (2 * M + 1)
          let env : PointJetVar M → ℂ := fun v => ssbpcClearedJetEnv M E₀ E₁ A p q v / D_com
          ssbpcClearedPoly M R P E₀ E₁ A p q = D_com ^ R * MvPolynomial.eval env P := by
      intro M R P hR p _ q _ h_nz
      dsimp [ssbpcClearedPoly]
      let D_com := (ssbpcPairDenProd E₀ E₁ p q) ^ (2 * M + 1)
      have hD_nz : D_com ≠ 0 := pow_ne_zero (2 * M + 1) h_nz
