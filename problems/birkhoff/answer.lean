      have h_eq : 8 * (C_mul * (C_mul * (9 / (q : ℝ)) * (9 / (q : ℝ)) +
          C_mul * (9 / (q : ℝ)) * (9 / (q : ℝ))) * J_R.C_jet_R) = K_g2 / (q : ℝ) ^ 2 := by
