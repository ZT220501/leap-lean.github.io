    exact ⟨hi1, hi2, by linarith, hb2⟩

theorem row_occup_fubini_and_integrable (S : FiniteWallNonisotropicStrip)
    (hKern : StripExitKernelData S) (ε h₀ v_lo v_hi : ℝ)
    (hε : 0 < ε) (hh₀ : 0 < h₀) (hv_le : v_lo ≤ v_hi)
    (hv_depth : Real.exp (-v_lo) < S.H / 4) :
    MeasureTheory.IntegrableOn
      (fun p : ℝ × ℝ => rowOccupDensity S ε h₀ p.1 p.2)
      (Set.Icc (0 : ℝ) (2 * Real.pi) ×ˢ Set.Icc v_lo v_hi)
      MeasureTheory.volume ∧
    (∀ s ∈ Set.Icc (2 : ℝ) 4,
      MeasureTheory.IntegrableOn
        (fun v : ℝ => (2 * Real.pi)⁻¹ *
          ∫ x in (0 : ℝ)..(2 * Real.pi), stepOccupDensity S ε h₀ s x v)
        (Set.Icc v_lo (v_hi + 8)) MeasureTheory.volume) ∧
    (∀ B : ℝ, 0 ≤ B →
      (∀ s ∈ Set.Icc (2 : ℝ) 4,
        (∫ v in v_lo..v_hi,
          (2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi), stepOccupDensity S ε h₀ s x v) ≤ B) →
      (∫ p in Set.Icc (0 : ℝ) (2 * Real.pi) ×ˢ Set.Icc v_lo v_hi,
        rowOccupDensity S ε h₀ p.1 p.2) ≤ 4 * Real.pi * B) :=
by
  have hH_pos : 0 < S.H := S.H_pos
  have h_strip : ∀ w y : ℝ, v_lo ≤ w → upperRowPt S w y ∈ horizStrip S.H := by
    intro w y hw
    have hexp_pos : 0 < Real.exp (-w) := Real.exp_pos (-w)
    have hexp_le : Real.exp (-w) ≤ Real.exp (-v_lo) :=
      Real.exp_le_exp_of_le (by linarith)
    have him_pos : 0 < S.H - Real.exp (-w) := by linarith
    have him_lt : S.H - Real.exp (-w) < S.H := by linarith
    change |(upperRowPt S w y).im| < S.H
    have him_eq : (upperRowPt S w y).im = S.H - Real.exp (-w) := by
      simp only [upperRowPt, Complex.add_im, Complex.ofReal_im, Complex.ofReal_re,
        Complex.mul_im, Complex.I_re, Complex.I_im, mul_one, mul_zero, add_zero, zero_add]
    rw [him_eq, abs_of_pos him_pos]
    exact him_lt
  have h_urp_cont : Continuous (fun p : ℝ × ℝ => upperRowPt S p.1 p.2) := by
    unfold upperRowPt
    exact (Complex.continuous_ofReal.comp continuous_snd).add
      ((Complex.continuous_ofReal.comp
        (continuous_const.sub (Real.continuous_exp.comp continuous_fst.neg))).mul
        continuous_const)
  have h_trunc_cont : ContinuousOn (truncLogSpeed S ε) (horizStrip S.H) := by
    unfold truncLogSpeed
    have hf_norm : ContinuousOn (fun z : ℂ => ‖S.f z‖) (horizStrip S.H) :=
      continuous_norm.comp_continuousOn S.f_holo.continuousOn
    have h_max : ContinuousOn (fun z : ℂ => max ‖S.f z‖ ε) (horizStrip S.H) :=
      hf_norm.sup continuousOn_const
    exact h_max.log (fun z _ => ne_of_gt (lt_of_lt_of_le hε (le_max_right _ _)))
  let v_top : ℝ := v_hi + 8
  let K_vs : Set (ℝ × ℝ) := Set.Icc v_lo v_top ×ˢ Set.Icc (2 : ℝ) 4
  let H_p : ℝ → ℝ → ℝ := fun v s => S.H - Real.exp (-(v + s))
  let y₀ : ℝ → ℝ := fun v => S.H - Real.exp (-v)
  let θ_fn : ℝ → ℝ → ℝ := fun v s => Real.pi * y₀ v / (2 * H_p v s)
  let α_fn : ℝ → ℝ → ℝ → ℝ := fun v s u => Real.pi * u / (2 * H_p v s)
  have hK_vs_compact : IsCompact K_vs := isCompact_Icc.prod isCompact_Icc
  have hK_vs_ne : K_vs.Nonempty :=
    ⟨(v_lo, 2), ⟨⟨le_rfl, by dsimp [v_top]; linarith⟩, by norm_num⟩⟩
  have hK_vs_geom : ∀ r ∈ K_vs,
      0 < Real.exp (-(r.1 + r.2)) ∧
      Real.exp (-(r.1 + r.2)) < Real.exp (-r.1) ∧
      Real.exp (-r.1) < S.H / 4 ∧
      3 * S.H / 4 < y₀ r.1 ∧
      y₀ r.1 < H_p r.1 r.2 ∧
      H_p r.1 r.2 < S.H := by
    intro r hr
    have hv : v_lo ≤ r.1 := hr.1.1
    have hs : 2 ≤ r.2 := hr.2.1
    have hexp1 : 0 < Real.exp (-(r.1 + r.2)) := Real.exp_pos _
    have hexp2 : Real.exp (-(r.1 + r.2)) < Real.exp (-r.1) :=
      Real.exp_lt_exp.mpr (by linarith)
    have hexp3 : Real.exp (-r.1) ≤ Real.exp (-v_lo) :=
      Real.exp_le_exp_of_le (by linarith)
    have hexp4 : Real.exp (-r.1) < S.H / 4 := lt_of_le_of_lt hexp3 hv_depth
    refine ⟨hexp1, hexp2, hexp4, ?_, ?_, ?_⟩ <;> dsimp [y₀, H_p] <;> linarith
  have hθ_bounds : ∀ r ∈ K_vs,
      0 < Real.cos (θ_fn r.1 r.2) ∧ Real.cos (θ_fn r.1 r.2) ≤ 1 := by
    intro r hr
    obtain ⟨_, _, _, hy₀_gt, hy₀_lt_Hp, _⟩ := hK_vs_geom r hr
    have hy₀_pos : 0 < y₀ r.1 := by linarith
    have h2Hp_pos : 0 < 2 * H_p r.1 r.2 := by linarith
    have hθ_pos : 0 < θ_fn r.1 r.2 :=
      div_pos (mul_pos Real.pi_pos hy₀_pos) h2Hp_pos
    have hθ_lt : θ_fn r.1 r.2 < Real.pi / 2 := by
      dsimp [θ_fn]
      rw [div_lt_div_iff₀ h2Hp_pos (by norm_num : (0 : ℝ) < 2)]
      nlinarith [Real.pi_pos]
    refine ⟨Real.cos_pos_of_mem_Ioo ⟨by linarith [Real.pi_pos], hθ_lt⟩,
      Real.cos_le_one _⟩
  have h_y₀_cont : Continuous (fun r : ℝ × ℝ => y₀ r.1) :=
    continuous_const.sub (Real.continuous_exp.comp continuous_fst.neg)
  have h_Hp_cont : Continuous (fun r : ℝ × ℝ => H_p r.1 r.2) :=
    continuous_const.sub (Real.continuous_exp.comp (continuous_fst.add continuous_snd).neg)
  have h_cosθ_cont : ContinuousOn (fun r : ℝ × ℝ => Real.cos (θ_fn r.1 r.2)) K_vs := by
    refine Real.continuous_cos.comp_continuousOn ?_
    refine ((continuous_const.mul h_y₀_cont).continuousOn).div
      ((continuous_const.mul h_Hp_cont).continuousOn) ?_
    intro r hr
    obtain ⟨_, _, _, hy₀_gt, hy₀_lt_Hp, _⟩ := hK_vs_geom r hr
    linarith
  obtain ⟨r_min, hr_min_mem, hr_min⟩ :=
    hK_vs_compact.exists_isMinOn hK_vs_ne h_cosθ_cont
  let c₀ : ℝ := Real.cos (θ_fn r_min.1 r_min.2)
  have hc₀_pos : 0 < c₀ := (hθ_bounds r_min hr_min_mem).1
  have hc₀_le_one : c₀ ≤ 1 := (hθ_bounds r_min hr_min_mem).2
  have hc₀_min : ∀ r ∈ K_vs, c₀ ≤ Real.cos (θ_fn r.1 r.2) :=
    isMinOn_iff.mp hr_min
  let lam : ℝ := min (1 / 2) (1 / (4 * S.H ^ 2))
  have hlam_pos : 0 < lam := by positivity
  let C_dom : ℝ := 2 / (3 * S.H * c₀ ^ 2 * lam)
  have hC_dom_pos : 0 < C_dom := by positivity
  have h_denom_ge : ∀ r ∈ K_vs, ∀ u : ℝ,
      c₀ ^ 2 * Real.cosh (α_fn r.1 r.2 u) ^ 2 ≤
        Real.cosh (α_fn r.1 r.2 u) ^ 2 - Real.sin (θ_fn r.1 r.2) ^ 2 := by
    intro r hr u
    have hcos_ge : c₀ ≤ Real.cos (θ_fn r.1 r.2) := hc₀_min r hr
    have h1 := Real.cosh_sq_sub_sinh_sq (α_fn r.1 r.2 u)
    have h2 := Real.sin_sq_add_cos_sq (θ_fn r.1 r.2)
    have h3 : 0 ≤ Real.sinh (α_fn r.1 r.2 u) ^ 2 := sq_nonneg _
    have hc₀_sq_le_one : c₀ ^ 2 ≤ 1 := by nlinarith
    have hc₀_sq_le_cos : c₀ ^ 2 ≤ Real.cos (θ_fn r.1 r.2) ^ 2 := by nlinarith
    have h_sinh :
        c₀ ^ 2 * Real.sinh (α_fn r.1 r.2 u) ^ 2 ≤ Real.sinh (α_fn r.1 r.2 u) ^ 2 :=
      mul_le_of_le_one_left h3 hc₀_sq_le_one
    have h_expand :
        c₀ ^ 2 * Real.cosh (α_fn r.1 r.2 u) ^ 2 =
          c₀ ^ 2 * Real.sinh (α_fn r.1 r.2 u) ^ 2 + c₀ ^ 2 := by
      rw [show Real.cosh (α_fn r.1 r.2 u) ^ 2 = Real.sinh (α_fn r.1 r.2 u) ^ 2 + 1 by linarith]
      ring
    linarith
  have h_kern_contOn : ContinuousOn
      (fun m : (ℝ × ℝ) × ℝ => stripExitKernel (H_p m.1.1 m.1.2) (y₀ m.1.1) m.2)
      (K_vs ×ˢ Set.univ) := by
    unfold stripExitKernel
    have h2Hp_cont : ContinuousOn (fun m : (ℝ × ℝ) × ℝ => 2 * H_p m.1.1 m.1.2)
        (K_vs ×ˢ Set.univ) :=
      (continuous_const.mul (h_Hp_cont.comp continuous_fst)).continuousOn
    have h2Hp_ne : ∀ m ∈ K_vs ×ˢ (Set.univ : Set ℝ), 2 * H_p m.1.1 m.1.2 ≠ 0 := by
      intro m hm
      obtain ⟨_, _, _, hy₀_gt, hy₀_lt_Hp, _⟩ := hK_vs_geom m.1 hm.1
      linarith
    have hα_cont : ContinuousOn (fun m : (ℝ × ℝ) × ℝ => Real.pi * m.2 / (2 * H_p m.1.1 m.1.2))
        (K_vs ×ˢ Set.univ) :=
      ((continuous_const.mul continuous_snd).continuousOn).div h2Hp_cont h2Hp_ne
    have hθ_cont : ContinuousOn
        (fun m : (ℝ × ℝ) × ℝ => Real.pi * y₀ m.1.1 / (2 * H_p m.1.1 m.1.2))
        (K_vs ×ˢ Set.univ) :=
      ((continuous_const.mul (h_y₀_cont.comp continuous_fst)).continuousOn).div h2Hp_cont h2Hp_ne
    have hcosh_cont : ContinuousOn
        (fun m : (ℝ × ℝ) × ℝ => Real.cosh (Real.pi * m.2 / (2 * H_p m.1.1 m.1.2)))
        (K_vs ×ˢ Set.univ) :=
      Real.continuous_cosh.comp_continuousOn hα_cont
    have hcos_cont : ContinuousOn
        (fun m : (ℝ × ℝ) × ℝ => Real.cos (Real.pi * y₀ m.1.1 / (2 * H_p m.1.1 m.1.2)))
        (K_vs ×ˢ Set.univ) :=
      Real.continuous_cos.comp_continuousOn hθ_cont
    have hsin_cont : ContinuousOn
        (fun m : (ℝ × ℝ) × ℝ => Real.sin (Real.pi * y₀ m.1.1 / (2 * H_p m.1.1 m.1.2)))
        (K_vs ×ˢ Set.univ) :=
      Real.continuous_sin.comp_continuousOn hθ_cont
    refine ((h2Hp_cont.inv₀ h2Hp_ne).mul (hcosh_cont.mul hcos_cont)).div
      ((hcosh_cont.pow 2).sub (hsin_cont.pow 2)) ?_
    intro m hm
    have h_ge := h_denom_ge m.1 hm.1 m.2
    have h_cosh_ge : 1 ≤ Real.cosh (α_fn m.1.1 m.1.2 m.2) := Real.one_le_cosh _
    have h_cosh_sq : 1 ≤ Real.cosh (α_fn m.1.1 m.1.2 m.2) ^ 2 := by nlinarith
    have hc₀_sq_pos : 0 < c₀ ^ 2 := sq_pos_of_pos hc₀_pos
    have hc₀_prod_ge : c₀ ^ 2 ≤ c₀ ^ 2 * Real.cosh (α_fn m.1.1 m.1.2 m.2) ^ 2 :=
      le_mul_of_one_le_right hc₀_sq_pos.le h_cosh_sq
    dsimp [α_fn, θ_fn] at h_ge hc₀_prod_ge
    linarith
  have h_cosh_quad : ∀ a : ℝ, 1 / 2 + a ^ 2 / 4 ≤ Real.cosh a := by
    intro a
    have hsum := Real.sum_le_exp_of_nonneg (abs_nonneg a) 3
    simp only [Finset.sum_range_succ, Finset.range_zero, Finset.sum_empty,
      Nat.factorial, pow_zero, pow_one, sq_abs] at hsum
    norm_num at hsum
    have hexp_neg : 0 < Real.exp (-|a|) := Real.exp_pos _
    have habs_nn : 0 ≤ |a| := abs_nonneg a
    have hcosh_abs : Real.cosh a = (Real.exp |a| + Real.exp (-|a|)) / 2 := by
      rw [← Real.cosh_abs, Real.cosh_eq]
    linarith
  have h_kern_bounds : ∀ r ∈ K_vs, ∀ u : ℝ,
      0 ≤ stripExitKernel (H_p r.1 r.2) (y₀ r.1) u ∧
      stripExitKernel (H_p r.1 r.2) (y₀ r.1) u ≤ C_dom * (1 + u ^ 2)⁻¹ := by
    intro r hr u
    obtain ⟨_, _, _, hy₀_gt, hy₀_lt_Hp, hHp_lt_H⟩ := hK_vs_geom r hr
    have h2Hp_gt : 3 * S.H / 2 < 2 * H_p r.1 r.2 := by linarith
    have h2Hp_pos : 0 < 2 * H_p r.1 r.2 := by linarith
    have hcos_pos : 0 < Real.cos (θ_fn r.1 r.2) := (hθ_bounds r hr).1
    have hcos_le : Real.cos (θ_fn r.1 r.2) ≤ 1 := (hθ_bounds r hr).2
    have hcosh_ge_one : 1 ≤ Real.cosh (α_fn r.1 r.2 u) := Real.one_le_cosh _
    have hcosh_pos : 0 < Real.cosh (α_fn r.1 r.2 u) := by linarith
    have h_den : c₀ ^ 2 * Real.cosh (α_fn r.1 r.2 u) ^ 2 ≤
        Real.cosh (α_fn r.1 r.2 u) ^ 2 - Real.sin (θ_fn r.1 r.2) ^ 2 :=
      h_denom_ge r hr u
    have h_den_pos : 0 < c₀ ^ 2 * Real.cosh (α_fn r.1 r.2 u) ^ 2 := by positivity
    have h_den_rhs_pos : 0 < Real.cosh (α_fn r.1 r.2 u) ^ 2 - Real.sin (θ_fn r.1 r.2) ^ 2 :=
      lt_of_lt_of_le h_den_pos h_den
    have h_abs_α : |u| / S.H ≤ |α_fn r.1 r.2 u| := by
      have h_eq : |α_fn r.1 r.2 u| = Real.pi * |u| / (2 * H_p r.1 r.2) := by
        dsimp [α_fn]
        rw [abs_div, abs_mul, abs_of_pos Real.pi_pos, abs_of_pos h2Hp_pos]
      rw [h_eq, div_le_div_iff₀ hH_pos h2Hp_pos]
      have h_pi_H : 2 * H_p r.1 r.2 ≤ Real.pi * S.H := by nlinarith [Real.pi_gt_three]
      have h_mul := mul_le_mul_of_nonneg_left h_pi_H (abs_nonneg u)
      linarith [show |u| * (Real.pi * S.H) = Real.pi * |u| * S.H by ring]
    have h_sq_α : u ^ 2 / S.H ^ 2 ≤ (α_fn r.1 r.2 u) ^ 2 := by
      have h0 : 0 ≤ |u| / S.H := div_nonneg (abs_nonneg u) hH_pos.le
      have h1 : (|u| / S.H) ^ 2 ≤ |α_fn r.1 r.2 u| ^ 2 := by nlinarith
      rwa [div_pow, sq_abs, sq_abs] at h1
    have h_cosh_lam : lam * (1 + u ^ 2) ≤ Real.cosh (α_fn r.1 r.2 u) := by
      have hq := h_cosh_quad (α_fn r.1 r.2 u)
      have h_div : u ^ 2 / (4 * S.H ^ 2) ≤ (α_fn r.1 r.2 u) ^ 2 / 4 := by
        have : u ^ 2 / (4 * S.H ^ 2) = (u ^ 2 / S.H ^ 2) / 4 := by ring
        linarith
      have hlam1 : lam ≤ 1 / 2 := min_le_left _ _
      have hlam2 : lam ≤ 1 / (4 * S.H ^ 2) := min_le_right _ _
      have hlam_u : lam * u ^ 2 ≤ u ^ 2 / (4 * S.H ^ 2) := by
        have hu2 : 0 ≤ u ^ 2 := sq_nonneg u
        have := mul_le_mul_of_nonneg_right hlam2 hu2
        linarith [show (1 / (4 * S.H ^ 2)) * u ^ 2 = u ^ 2 / (4 * S.H ^ 2) by ring]
      linarith
    have h_kern_eq : stripExitKernel (H_p r.1 r.2) (y₀ r.1) u =
        (2 * H_p r.1 r.2)⁻¹ *
          (Real.cosh (α_fn r.1 r.2 u) * Real.cos (θ_fn r.1 r.2)) /
          (Real.cosh (α_fn r.1 r.2 u) ^ 2 - Real.sin (θ_fn r.1 r.2) ^ 2) := rfl
    rw [h_kern_eq]
    refine ⟨by positivity, ?_⟩
    have h_inv_Hp : (2 * H_p r.1 r.2)⁻¹ ≤ 2 / (3 * S.H) := by
      rw [inv_eq_one_div, div_le_div_iff₀ h2Hp_pos (by positivity)]
      linarith
    have h_frac :
        (Real.cosh (α_fn r.1 r.2 u) * Real.cos (θ_fn r.1 r.2)) /
          (Real.cosh (α_fn r.1 r.2 u) ^ 2 - Real.sin (θ_fn r.1 r.2) ^ 2) ≤
        1 / (c₀ ^ 2 * (lam * (1 + u ^ 2))) := by
      calc
        (Real.cosh (α_fn r.1 r.2 u) * Real.cos (θ_fn r.1 r.2)) /
            (Real.cosh (α_fn r.1 r.2 u) ^ 2 - Real.sin (θ_fn r.1 r.2) ^ 2)
          ≤ Real.cosh (α_fn r.1 r.2 u) /
              (c₀ ^ 2 * Real.cosh (α_fn r.1 r.2 u) ^ 2) := by
            rw [div_le_div_iff₀ h_den_rhs_pos h_den_pos]
            have h_num : Real.cosh (α_fn r.1 r.2 u) * Real.cos (θ_fn r.1 r.2) ≤
                Real.cosh (α_fn r.1 r.2 u) :=
              mul_le_of_le_one_right hcosh_pos.le hcos_le
            exact mul_le_mul h_num h_den h_den_pos.le hcosh_pos.le
        _ = 1 / (c₀ ^ 2 * Real.cosh (α_fn r.1 r.2 u)) := by
            field_simp [hc₀_pos.ne', hcosh_pos.ne']
        _ ≤ 1 / (c₀ ^ 2 * (lam * (1 + u ^ 2))) := by
            rw [div_le_div_iff₀ (by positivity) (by positivity)]
            linarith [mul_le_mul_of_nonneg_left h_cosh_lam (sq_nonneg c₀)]
    calc
      (2 * H_p r.1 r.2)⁻¹ *
          (Real.cosh (α_fn r.1 r.2 u) * Real.cos (θ_fn r.1 r.2)) /
          (Real.cosh (α_fn r.1 r.2 u) ^ 2 - Real.sin (θ_fn r.1 r.2) ^ 2)
        = (2 * H_p r.1 r.2)⁻¹ *
            ((Real.cosh (α_fn r.1 r.2 u) * Real.cos (θ_fn r.1 r.2)) /
              (Real.cosh (α_fn r.1 r.2 u) ^ 2 - Real.sin (θ_fn r.1 r.2) ^ 2)) :=
          mul_div_assoc _ _ _
      _ ≤ (2 / (3 * S.H)) * (1 / (c₀ ^ 2 * (lam * (1 + u ^ 2)))) := by
          refine mul_le_mul h_inv_Hp h_frac ?_ (by positivity)
          positivity
      _ = C_dom * (1 + u ^ 2)⁻¹ := by
          dsimp [C_dom]
          rw [inv_eq_one_div]
          have h1u : (1 : ℝ) + u ^ 2 ≠ 0 := by positivity
          field_simp [hH_pos.ne', hc₀_pos.ne', hlam_pos.ne', h1u]
  let D_2 : Set (ℝ × ℝ) := Set.Icc (0 : ℝ) (2 * Real.pi) ×ˢ Set.Icc v_lo v_top
  let D_3 : Set ((ℝ × ℝ) × ℝ) := D_2 ×ˢ Set.Icc (2 : ℝ) 4
  let F : ((ℝ × ℝ) × ℝ) → ℝ → ℝ := fun q u =>
    min ((truncLogSpeed S ε (upperRowPt S (q.1.2 + q.2) (q.1.1 + u)) -
      truncLogSpeed S ε (upperRowPt S q.1.2 q.1.1)) ^ 2) (h₀ ^ 2) *
    stripExitKernel (S.H - Real.exp (-(q.1.2 + q.2))) (S.H - Real.exp (-q.1.2)) u
  let Ψ_tup : ((ℝ × ℝ) × ℝ) → ℝ := fun q => ∫ u : ℝ, F q u
  let bound : ℝ → ℝ := fun u => (h₀ ^ 2 * C_dom) * (1 + u ^ 2)⁻¹
  have hD3_to_Kvs : ∀ q ∈ D_3, (q.1.2, q.2) ∈ K_vs := fun q hq => ⟨hq.1.2, hq.2⟩
  have hΨ_cont : ContinuousOn Ψ_tup D_3 := by
    refine MeasureTheory.continuousOn_of_dominated (bound := bound) ?_ ?_ ?_ ?_
    · intro q hq
      have h_kvs : (q.1.2, q.2) ∈ K_vs := hD3_to_Kvs q hq
      obtain ⟨hd'_pos, hd'_lt_d, hd_lt_H4, _, _, _⟩ := hK_vs_geom (q.1.2, q.2) h_kvs
      have hd_lt_H : Real.exp (-q.1.2) < S.H := by linarith
      have hv_add : v_lo ≤ q.1.2 + q.2 := by linarith [hq.1.2.1, hq.2.1]
      have hu_urp : Continuous (fun u : ℝ => upperRowPt S (q.1.2 + q.2) (q.1.1 + u)) :=
        h_urp_cont.comp (continuous_const.prodMk (continuous_const.add continuous_id))
      have hu_trunc : Continuous
          (fun u : ℝ => truncLogSpeed S ε (upperRowPt S (q.1.2 + q.2) (q.1.1 + u))) :=
        h_trunc_cont.comp_continuous hu_urp
          (fun u => h_strip (q.1.2 + q.2) (q.1.1 + u) hv_add)
      have hu_min : Continuous (fun u : ℝ =>
          min ((truncLogSpeed S ε (upperRowPt S (q.1.2 + q.2) (q.1.1 + u)) -
            truncLogSpeed S ε (upperRowPt S q.1.2 q.1.1)) ^ 2) (h₀ ^ 2)) :=
        ((hu_trunc.sub continuous_const).pow 2).inf continuous_const
      have hu_kern : Continuous
          (stripExitKernel (S.H - Real.exp (-(q.1.2 + q.2))) (S.H - Real.exp (-q.1.2))) :=
        hKern.kernel_cont (Real.exp (-q.1.2)) (Real.exp (-(q.1.2 + q.2)))
          hd'_pos hd'_lt_d hd_lt_H
      exact (hu_min.mul hu_kern).aestronglyMeasurable
    · intro q hq
      refine Filter.Eventually.of_forall (fun u => ?_)
      have h_kvs : (q.1.2, q.2) ∈ K_vs := hD3_to_Kvs q hq
      obtain ⟨hk_nonneg, hk_le⟩ := h_kern_bounds (q.1.2, q.2) h_kvs u
      have hmin_nonneg : 0 ≤ min
          ((truncLogSpeed S ε (upperRowPt S (q.1.2 + q.2) (q.1.1 + u)) -
            truncLogSpeed S ε (upperRowPt S q.1.2 q.1.1)) ^ 2) (h₀ ^ 2) :=
