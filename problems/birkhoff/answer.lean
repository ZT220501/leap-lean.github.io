        _ = (B + 1) * Real.exp B := by rw [hexp_cancel, mul_one]
    have h_coeff_le : c₂ * (2 * K_shift * L) ≤ C_tr := by
      have hexp_4B : Real.exp (3 * B + 1) * Real.exp B = Real.exp (4 * B + 1) := by
        rw [← Real.exp_add]
        congr 1
        ring
      calc c₂ * (2 * K_shift * L)
          = (4 * Real.exp (3 * B + 1) / Real.pi) * (2 * K_shift) * (Real.exp q * L) := by
            dsimp [c₂]; ring
        _ ≤ (4 * Real.exp (3 * B + 1) / Real.pi) * (2 * K_shift) * ((B + 1) * Real.exp B) :=
            mul_le_mul_of_nonneg_left h_expq_L (by positivity)
        _ = (16 / Real.pi) * (B + 1) * (1 + (B + 1) ^ 2) *
              (Real.exp (3 * B + 1) * Real.exp B) := by
            dsimp [K_shift]; ring
        _ = C_tr := by rw [hexp_4B]
    have h_congr_GM :
        (∫ l in l_lo..l_hi, ((2 * Real.pi)⁻¹ * ∫ u in (0 : ℝ)..(2 * Real.pi), G_M l u * ν u)) =
        ∫ l in l_lo..l_hi, ((2 * Real.pi)⁻¹ * ∫ u in (0 : ℝ)..(2 * Real.pi),
          (Real.exp (-l) * shapeModulus S (bootRowPt S l u)) ^ 2 * ν u) := by
      refine intervalIntegral.integral_congr (fun l hl_mem => ?_)
      rw [Set.uIcc_of_le hl_le] at hl_mem
      exact (hGM_eq_on l hl_mem.1).symm
    calc (2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi), (tileSupModulus S B q x) ^ 2 * ν x
        ≤ c₁ * ((2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi),
            (tileSupModulus S A_coarse k_a x) ^ 2 * ν x) +
          c₂ * ((2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi),
            (∫ l in l_lo..l_hi, ∫ u in (x - L)..(x + L), G_M l u) * ν x) := by
          linarith
      _ ≤ c₁ * ((2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi),
            (tileSupModulus S A_coarse k_a x) ^ 2 * ν x) +
          c₂ * (2 * K_shift * L * ∫ l in l_lo..l_hi,
            ((2 * Real.pi)⁻¹ * ∫ u in (0 : ℝ)..(2 * Real.pi), G_M l u * ν u)) :=
          add_le_add le_rfl (mul_le_mul_of_nonneg_left hFubM (by dsimp [c₂]; positivity))
      _ = c₁ * ((2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi),
            (tileSupModulus S A_coarse k_a x) ^ 2 * ν x) +
          (c₂ * (2 * K_shift * L)) * ∫ l in l_lo..l_hi,
            ((2 * Real.pi)⁻¹ * ∫ u in (0 : ℝ)..(2 * Real.pi), G_M l u * ν u) := by ring
      _ ≤ c₁ * ((2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi),
            (tileSupModulus S A_coarse k_a x) ^ 2 * ν x) +
          C_tr * ∫ l in l_lo..l_hi,
            ((2 * Real.pi)⁻¹ * ∫ u in (0 : ℝ)..(2 * Real.pi), G_M l u * ν u) :=
          add_le_add le_rfl (mul_le_mul_of_nonneg_right h_coeff_le hI_GM_nn)
      _ = Real.exp (-2 * (q - k_a)) * ((2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi),
            (tileSupModulus S A_coarse k_a x) ^ 2 * ν x) +
          C_tr * ∫ l in l_lo..l_hi,
            ((2 * Real.pi)⁻¹ * ∫ u in (0 : ℝ)..(2 * Real.pi),
              (Real.exp (-l) * shapeModulus S (bootRowPt S l u)) ^ 2 * ν u) := by
          rw [h_congr_GM]
  
  have hConj3 : ∃ C_rc : ℝ, 0 < C_rc ∧
      ∀ (k_a j : ℝ) (ν : ℝ → ℝ),
        k₀ + 1 ≤ k_a →
        k_a + 1 ≤ j →
        Continuous ν →
        Function.Periodic ν (2 * Real.pi) →
        (∀ x : ℝ, 0 ≤ ν x) →
        (2 * Real.pi)⁻¹ * (∫ x in (0 : ℝ)..(2 * Real.pi), ν x) = 1 →
        (∀ M x x' : ℝ, 0 ≤ M → |x' - x| ≤ M * Real.exp (-k_a) →
          ν x' ≤ 2 * (1 + M ^ 2) * ν x) →
        IntervalIntegrable
          (fun l : ℝ => (2 * Real.pi)⁻¹ * ∫ u in (0 : ℝ)..(2 * Real.pi),
            Real.exp (-l) * |(S.V (bootRowPt S l u)).im| * ν u)
          MeasureTheory.volume (j - 1) (j + 1) ∧
        (2 * Real.pi)⁻¹ * (∫ x in (0 : ℝ)..(2 * Real.pi),
          (Real.exp (-j) * shapeModulus S (bootRowPt S j x)) ^ 2 * ν x) ≤
          C_rc * (1 + ∫ l in (j - 1)..(j + 1),
            ((2 * Real.pi)⁻¹ * ∫ u in (0 : ℝ)..(2 * Real.pi),
              Real.exp (-l) * |(S.V (bootRowPt S l u)).im| * ν u)) := by
    obtain ⟨C_cell, hC_cell_pos, hCell⟩ := hInt.row_cell_from_P_int
    refine ⟨8 * C_cell, by positivity, ?_⟩
    intro k_a j ν hka hj hν_cont hν_per hν_nn hν_mean hν_shift
    have hk₀_jm1 : k₀ ≤ j - 1 := by linarith
    have hk₀_j : k₀ ≤ j := by linarith
    have hj_le : j - 1 ≤ j + 1 := by linarith
    let d_j : ℝ := Real.exp (-j)
    have hdj_pos : 0 < d_j := Real.exp_pos (-j)
    have hdj_le_da : d_j ≤ Real.exp (-k_a) := Real.exp_le_exp.mpr (by linarith)
    have hShiftDj : ∀ x x' : ℝ, |x' - x| ≤ d_j → ν x' ≤ 4 * ν x := by
      intro x x' habs
      have h1 := hν_shift 1 x x' zero_le_one (by linarith)
      linarith
    obtain ⟨hWinV_cont, hIntGV, hFubV⟩ :=
      hWinFubini G_V ν (j - 1) (j + 1) d_j 4
        hGV_cont hGV_nn hGV_per hν_cont hν_per hν_nn hj_le hdj_pos.le (by norm_num) hShiftDj
    have hGV_eq_on : ∀ l : ℝ, j - 1 ≤ l →
        (2 * Real.pi)⁻¹ * (∫ u in (0 : ℝ)..(2 * Real.pi),
          Real.exp (-l) * |(S.V (bootRowPt S l u)).im| * ν u) =
        (2 * Real.pi)⁻¹ * (∫ u in (0 : ℝ)..(2 * Real.pi), G_V l u * ν u) := by
      intro l hl_ge
      have hmax : l_c l = l := max_eq_right (le_trans hk₀_jm1 hl_ge)
      dsimp [G_V]
      rw [hmax]
    have hIntVUnclamped : IntervalIntegrable
        (fun l : ℝ => (2 * Real.pi)⁻¹ * ∫ u in (0 : ℝ)..(2 * Real.pi),
          Real.exp (-l) * |(S.V (bootRowPt S l u)).im| * ν u)
        MeasureTheory.volume (j - 1) (j + 1) := by
      refine hIntGV.congr ?_
      intro l hl_mem
      rw [Set.uIoc_of_le hj_le] at hl_mem
      exact (hGV_eq_on l hl_mem.1.le).symm
    refine ⟨hIntVUnclamped, ?_⟩
    have hPointwiseRC : ∀ x : ℝ,
        (d_j * shapeModulus S (bootRowPt S j x)) ^ 2 * ν x ≤
          C_cell * ν x +
          (C_cell * Real.exp j) *
            ((∫ l in (j - 1)..(j + 1), ∫ u in (x - d_j)..(x + d_j), G_V l u) * ν x) := by
      intro x
      have hcx := hCell j x x hk₀_j (by rw [sub_self, abs_zero]; positivity)
      have h_eq_int :
          (∫ l in (j - 1)..(j + 1), Real.exp j *
            ∫ u in (x - d_j)..(x + d_j), Real.exp (-l) * |(S.V (bootRowPt S l u)).im|) =
          Real.exp j * ∫ l in (j - 1)..(j + 1), ∫ u in (x - d_j)..(x + d_j), G_V l u := by
        rw [← intervalIntegral.integral_const_mul]
        refine intervalIntegral.integral_congr (fun l hl_mem => ?_)
        rw [Set.uIcc_of_le hj_le] at hl_mem
        have hmax : l_c l = l := max_eq_right (le_trans hk₀_jm1 hl_mem.1)
        dsimp [G_V]
        rw [hmax]
      rw [show Real.exp (-j) = d_j from rfl, h_eq_int] at hcx
      have hmul := mul_le_mul_of_nonneg_right hcx (hν_nn x)
      linarith
    have hLHS_cont : Continuous (fun x : ℝ =>
        (d_j * shapeModulus S (bootRowPt S j x)) ^ 2 * ν x) := by
      have h_eq : (fun x : ℝ => (d_j * shapeModulus S (bootRowPt S j x)) ^ 2 * ν x) =
          (fun x : ℝ => G_M j x * ν x) := by
        ext x
        dsimp [G_M, d_j, l_c]
        rw [max_eq_right hk₀_j]
      rw [h_eq]
      exact (hGM_cont.comp (continuous_const.prodMk continuous_id)).mul hν_cont
    have hLHS_int : IntervalIntegrable
        (fun x : ℝ => (d_j * shapeModulus S (bootRowPt S j x)) ^ 2 * ν x)
        MeasureTheory.volume 0 (2 * Real.pi) :=
      hLHS_cont.intervalIntegrable 0 (2 * Real.pi)
    have hν_int : IntervalIntegrable ν MeasureTheory.volume 0 (2 * Real.pi) :=
      hν_cont.intervalIntegrable 0 (2 * Real.pi)
    have hWinV_int : IntervalIntegrable
        (fun x : ℝ => (∫ l in (j - 1)..(j + 1), ∫ u in (x - d_j)..(x + d_j), G_V l u) * ν x)
        MeasureTheory.volume 0 (2 * Real.pi) :=
      (hWinV_cont.mul hν_cont).intervalIntegrable 0 (2 * Real.pi)
    have h_int_rc :
        (∫ x in (0 : ℝ)..(2 * Real.pi), (d_j * shapeModulus S (bootRowPt S j x)) ^ 2 * ν x) ≤
          C_cell * (∫ x in (0 : ℝ)..(2 * Real.pi), ν x) +
          (C_cell * Real.exp j) * (∫ x in (0 : ℝ)..(2 * Real.pi),
            (∫ l in (j - 1)..(j + 1), ∫ u in (x - d_j)..(x + d_j), G_V l u) * ν x) := by
      have h_rhs_eq :
          C_cell * (∫ x in (0 : ℝ)..(2 * Real.pi), ν x) +
            (C_cell * Real.exp j) * (∫ x in (0 : ℝ)..(2 * Real.pi),
              (∫ l in (j - 1)..(j + 1), ∫ u in (x - d_j)..(x + d_j), G_V l u) * ν x) =
          ∫ x in (0 : ℝ)..(2 * Real.pi),
            (C_cell * ν x + (C_cell * Real.exp j) *
              ((∫ l in (j - 1)..(j + 1), ∫ u in (x - d_j)..(x + d_j), G_V l u) * ν x)) := by
        rw [intervalIntegral.integral_add (hν_int.const_mul C_cell)
          (hWinV_int.const_mul (C_cell * Real.exp j)),
          intervalIntegral.integral_const_mul, intervalIntegral.integral_const_mul]
      rw [h_rhs_eq]
      exact intervalIntegral.integral_mono_on h2pi_pos.le hLHS_int
        ((hν_int.const_mul C_cell).add (hWinV_int.const_mul (C_cell * Real.exp j)))
        (fun x _ => hPointwiseRC x)
    have h_mul_rc := mul_le_mul_of_nonneg_left h_int_rc h2pi_inv_nonneg
    have hexp_j_cancel : Real.exp j * d_j = 1 := by
      dsimp [d_j]
      rw [← Real.exp_add]
      simp
    have h_congr_GV :
        (∫ l in (j - 1)..(j + 1), ((2 * Real.pi)⁻¹ * ∫ u in (0 : ℝ)..(2 * Real.pi), G_V l u * ν u)) =
        ∫ l in (j - 1)..(j + 1), ((2 * Real.pi)⁻¹ * ∫ u in (0 : ℝ)..(2 * Real.pi),
          Real.exp (-l) * |(S.V (bootRowPt S l u)).im| * ν u) := by
      refine intervalIntegral.integral_congr (fun l hl_mem => ?_)
      rw [Set.uIcc_of_le hj_le] at hl_mem
      exact (hGV_eq_on l hl_mem.1).symm
    calc (2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi),
            (d_j * shapeModulus S (bootRowPt S j x)) ^ 2 * ν x
        ≤ C_cell * ((2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi), ν x) +
          (C_cell * Real.exp j) * ((2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi),
            (∫ l in (j - 1)..(j + 1), ∫ u in (x - d_j)..(x + d_j), G_V l u) * ν x) := by
          linarith
      _ ≤ C_cell * 1 + (C_cell * Real.exp j) *
            (2 * 4 * d_j * ∫ l in (j - 1)..(j + 1),
              ((2 * Real.pi)⁻¹ * ∫ u in (0 : ℝ)..(2 * Real.pi), G_V l u * ν u)) := by
          rw [hν_mean]
          exact add_le_add le_rfl (mul_le_mul_of_nonneg_left hFubV (by positivity))
      _ = C_cell + 8 * C_cell * (Real.exp j * d_j) * ∫ l in (j - 1)..(j + 1),
            ((2 * Real.pi)⁻¹ * ∫ u in (0 : ℝ)..(2 * Real.pi), G_V l u * ν u) := by ring
      _ = C_cell + 8 * C_cell * ∫ l in (j - 1)..(j + 1),
            ((2 * Real.pi)⁻¹ * ∫ u in (0 : ℝ)..(2 * Real.pi),
              Real.exp (-l) * |(S.V (bootRowPt S l u)).im| * ν u) := by
          rw [hexp_j_cancel, mul_one, h_congr_GV]
      _ ≤ 8 * C_cell * (1 + ∫ l in (j - 1)..(j + 1),
            ((2 * Real.pi)⁻¹ * ∫ u in (0 : ℝ)..(2 * Real.pi),
              Real.exp (-l) * |(S.V (bootRowPt S l u)).im| * ν u)) := by
          linarith [hC_cell_pos]
  exact ⟨hConj1, hConj2, hConj3⟩

theorem cone_cost_weighted_subquad_bound (S : FiniteWallNonisotropicStrip)
    (hInt : BootInteriorTransferProp S)
    (β a C_N C₁ : ℝ) (hβ0 : 0 ≤ β) (hβhalf : β < 1 / 2)
    (ha : 0 < a) (hCN : 1 ≤ C_N) (hC1 : 0 < C₁)
    (D : BootConeNegativePartData S β a C_N C₁) :
    ∃ C_sub : ℝ, 0 < C_sub ∧
      ∀ (N : ℝ → ℝ) (ν : ℝ → ℝ) (M_t l : ℝ),
        IsCriticalEnvelope S β a C_N C₁ N →
        Continuous ν →
        (∀ x : ℝ, 0 ≤ ν x) →
        (2 * Real.pi)⁻¹ * (∫ x in (0 : ℝ)..(2 * Real.pi), ν x) = 1 →
        0 ≤ M_t →
        (∀ q : ℝ, criticalDepthThreshold S ≤ q →
          Real.sqrt ((2 * Real.pi)⁻¹ * ∫ x in (0 : ℝ)..(2 * Real.pi),
            (tileSupModulus S D.A_cone q x) ^ 2 * ν x) ≤ M_t * N q) →
        criticalDepthThreshold S ≤ l →
        (2 * Real.pi)⁻¹ * (∫ x in (0 : ℝ)..(2 * Real.pi),
          (Real.exp (-l) * max ((S.V (bootRowPt S l x)).im) 0 / (N l) ^ 2) * ν x) ≤
          C_sub * (1 + M_t) ^ (4 * (2 - 1 / (1 + a)) / (4 - 1 / (1 + a))) :=
by
  have _ := hβhalf
  have _ := hC1
  have hβ_lt_β1 : β < D.β₁ := D.β_lt_β₁
  let δ : ℝ := (D.β₁ - β) / 2
  have hδ_pos : 0 < δ := by dsimp [δ]; linarith
  let r : ℝ := Real.exp (-(D.β₁ - β))
  have hr_pos : 0 < r := Real.exp_pos _
  have hr_lt1 : r < 1 := Real.exp_lt_one_iff.mpr (by linarith)
  have hr_ne1 : r ≠ 1 := ne_of_lt hr_lt1
  have h1r_pos : 0 < 1 - r := by linarith
  have hCN_pos : 0 < C_N := lt_of_lt_of_le zero_lt_one hCN
  have hCdom_pos : 0 < D.C_dom := D.C_dom_pos
  have hCneg_pos : 0 < D.C_neg := D.C_neg_pos
  let K_sum : ℝ := C_N ^ 2 * Real.exp (6 * D.β₁ + 6 * a) / (1 - r) ^ 2
  have hKsum_pos : 0 < K_sum := by dsimp [K_sum]; positivity
  let C_b2w : ℝ := 2 * D.C_dom ^ 2 * (1 + K_sum)
  have hCb2w_pos : 0 < C_b2w := by dsimp [C_b2w]; positivity
  let C_sub : ℝ := D.C_neg * (C_b2w + 1)
  have hCsub_pos : 0 < C_sub := by dsimp [C_sub]; positivity
  let γ : ℝ := 1 / (1 + a)
  have hγ_pos : 0 < γ := by dsimp [γ]; positivity
  have hγ_lt1 : γ < 1 := by
    dsimp [γ]
    rw [div_lt_one (by linarith)]
    linarith
  let m : ℝ := 4 * (2 - γ) / (4 - γ)
  have hm_pos : 0 < m := by
    dsimp [m]
    exact div_pos (by linarith) (by linarith)
  have hm_lt2 : m < 2 := by
    have h2m : 2 - m = 2 * γ / (4 - γ) := by
      dsimp [m]
      field_simp [show (4 - γ : ℝ) ≠ 0 by linarith]
      ring
    have h2m_pos : 0 < 2 - m := by
      rw [h2m]
      exact div_pos (by linarith) (by linarith)
    linarith
  have h_geom : ∀ M : ℕ, ∑ n ∈ Finset.range M, r ^ n ≤ 1 / (1 - r) := by
    intro M
    have h_eq : (r ^ M - 1) / (r - 1) = (1 - r ^ M) / (1 - r) := by
      rw [div_eq_div_iff (by linarith) (by linarith)]
      ring
    rw [geom_sum_eq hr_ne1, h_eq]
    exact div_le_div_of_nonneg_right (by linarith [pow_pos hr_pos M]) h1r_pos.le
  refine ⟨C_sub, hCsub_pos, ?_⟩
  intro N ν M_t l hN hν_cont hν_nonneg hν_mean hMt hTile hl
  have h2pi_pos : 0 < 2 * Real.pi := Real.two_pi_pos
  have h2pi_inv_nonneg : 0 ≤ (2 * Real.pi)⁻¹ := inv_nonneg.mpr h2pi_pos.le
  let k₀ : ℝ := criticalDepthThreshold S
  have hNl_ge1 : 1 ≤ N l := hN.one_le l hl
  have hNl_pos : 0 < N l := lt_of_lt_of_le zero_lt_one hNl_ge1
  have hNl_sq_pos : 0 < (N l) ^ 2 := sq_pos_of_pos hNl_pos
  have hAcone_nonneg : 0 ≤ D.A_cone := le_trans zero_le_one D.one_le_A_cone
  let q_lvl : ℕ → ℝ := fun n => max k₀ (l + 3 - (n : ℝ))
  have hq_ge_k0 : ∀ n : ℕ, k₀ ≤ q_lvl n := fun n => le_max_left _ _
  have hEnvSq : ∀ n : ℕ, (N (q_lvl n)) ^ 2 ≤
      C_N ^ 2 * (N l) ^ 2 * Real.exp (6 * a + 2 * β * (n : ℝ)) := by
    intro n
    have hn_nonneg : 0 ≤ (n : ℝ) := Nat.cast_nonneg n
    have hNqn_nonneg : 0 ≤ N (q_lvl n) :=
      le_trans zero_le_one (hN.one_le (q_lvl n) (hq_ge_k0 n))
    have hEnv : N (q_lvl n) ≤ C_N * N l * Real.exp (3 * a + β * (n : ℝ)) := by
      rcases le_total (q_lvl n) l with hqn_le | hl_le
      · have hc := hN.coarse_bound (q_lvl n) l (hq_ge_k0 n) hqn_le
        have hdiff : l - q_lvl n ≤ (n : ℝ) := by
          have : l + 3 - (n : ℝ) ≤ q_lvl n := le_max_right _ _
          linarith
        have hexp : Real.exp (β * (l - q_lvl n)) ≤ Real.exp (3 * a + β * (n : ℝ)) := by
          apply Real.exp_le_exp.mpr
          have hβmul : β * (l - q_lvl n) ≤ β * (n : ℝ) :=
            mul_le_mul_of_nonneg_left hdiff hβ0
          linarith
        exact le_trans hc (mul_le_mul_of_nonneg_left hexp (by positivity))
      · have hf := hN.fine_bound (q_lvl n) l hl hl_le
        have hdiff : q_lvl n - l ≤ 3 := by
          have hmax : q_lvl n ≤ l + 3 := max_le (by linarith [hl]) (by linarith)
          linarith
        have hexp : Real.exp (a * (q_lvl n - l)) ≤ Real.exp (3 * a + β * (n : ℝ)) := by
          apply Real.exp_le_exp.mpr
          have hamul : a * (q_lvl n - l) ≤ a * 3 :=
            mul_le_mul_of_nonneg_left hdiff ha.le
          have hβn : 0 ≤ β * (n : ℝ) := mul_nonneg hβ0 hn_nonneg
          linarith
        exact le_trans hf (mul_le_mul_of_nonneg_left hexp (by positivity))
    have hsq := pow_le_pow_left₀ hNqn_nonneg hEnv 2
    have hexp2 : (Real.exp (3 * a + β * (n : ℝ))) ^ 2 =
        Real.exp (6 * a + 2 * β * (n : ℝ)) := by
      rw [← Real.exp_nat_mul]
      congr 1
      push_cast
      ring
    calc (N (q_lvl n)) ^ 2
        ≤ (C_N * N l * Real.exp (3 * a + β * (n : ℝ))) ^ 2 := hsq
      _ = C_N ^ 2 * (N l) ^ 2 * (Real.exp (3 * a + β * (n : ℝ))) ^ 2 := by ring
      _ = C_N ^ 2 * (N l) ^ 2 * Real.exp (6 * a + 2 * β * (n : ℝ)) := by rw [hexp2]
  let b : ℝ → ℝ := bootConeCost S D.δ_b D.L D.β₁ N l
  obtain ⟨hb_cont, _, hb_ge1⟩ := D.cone_cost_props N hN l hl
  have hb_nonneg : ∀ x : ℝ, 0 ≤ b x := fun x => le_trans zero_le_one (hb_ge1 x)
  let M_lvl : ℕ := Nat.ceil (l - k₀) + 5
  let u : ℕ → ℝ := fun n => Real.exp (-δ * (n : ℝ))
  let v : ℕ → ℝ → ℝ := fun n x =>
    Real.exp (3 * D.β₁ - (β + δ) * (n : ℝ)) *
      (tileSupModulus S D.A_cone (q_lvl n) x / N l)
  have huv_eq : ∀ (n : ℕ) (x : ℝ),
       Real.exp (-D.β₁ * ((n : ℝ) - 3)) *
        (tileSupModulus S D.A_cone (q_lvl n) x / N l) = u n * v n x := by
    intro n x
    dsimp [u, v]
    have hexp_eq : Real.exp (-D.β₁ * ((n : ℝ) - 3)) =
        Real.exp (-δ * (n : ℝ)) * Real.exp (3 * D.β₁ - (β + δ) * (n : ℝ)) := by
      rw [← Real.exp_add]
      congr 1
      dsimp [δ]
      ring
