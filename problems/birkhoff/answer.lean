        rw [(k_iterYT_step hU hf α 0 (σ m p) hp).1,
          iha (k_pderiv_holo hU hf).1 hp,
          h_it_congr hUm hp α 0 (fun q hq => by
            simpa only [Function.comp_apply] using (h_shear_pderiv hU hf m hq).1.symm),
