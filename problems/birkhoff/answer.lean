      have hre : ζ.re ≤ 1 / 2 := le_trans (Complex.re_le_norm ζ) hζ
      exact le_trans (Real.exp_le_exp.mpr hre) hexp_half_le_2
    have h_mvt := Convex.norm_image_sub_le_of_norm_deriv_le h_diff h_dbound
      (convex_closedBall (0 : ℂ) (1 / 2))
      (Metric.mem_closedBall_self (by norm_num))
      (by rwa [Metric.mem_closedBall, dist_zero_right])
    simpa using h_mvt

  
  have h_exp_quad : ∀ u : ℂ, ‖u‖ ≤ 1 / 2 →
      ‖1 - Complex.exp (-u) - u‖ ≤ 2 * ‖u‖ ^ 2 := by
    intro u hu
    let f₂ : ℂ → ℂ := fun ζ => 1 - Complex.exp (-ζ) - ζ
    have h_hd : ∀ ζ : ℂ, HasDerivAt f₂ (Complex.exp (-ζ) - 1) ζ := by
      intro ζ
      have h_neg : HasDerivAt (fun z : ℂ => -z) (-1) ζ := (hasDerivAt_id ζ).neg
      have h_cexp : HasDerivAt (fun z : ℂ => Complex.exp (-z)) (Complex.exp (-ζ) * (-1)) ζ :=
        HasDerivAt.comp ζ (Complex.hasDerivAt_exp (-ζ)) h_neg
      have h1 : HasDerivAt (fun z : ℂ => 1 - Complex.exp (-z)) (0 - Complex.exp (-ζ) * (-1)) ζ :=
        (hasDerivAt_const ζ (1 : ℂ)).sub h_cexp
      have h2 := h1.sub (hasDerivAt_id ζ)
      convert h2 using 1
      · rfl
      · ring
    have h_diff : ∀ ζ ∈ Metric.closedBall (0 : ℂ) ‖u‖, DifferentiableAt ℂ f₂ ζ :=
      fun ζ _ => (h_hd ζ).differentiableAt
    have h_dbound : ∀ ζ ∈ Metric.closedBall (0 : ℂ) ‖u‖, ‖deriv f₂ ζ‖ ≤ 2 * ‖u‖ := by
      intro ζ hζ
      rw [(h_hd ζ).deriv]
      rw [Metric.mem_closedBall, dist_zero_right] at hζ
      have hζ_half : ‖-ζ‖ ≤ 1 / 2 := by rw [norm_neg]; linarith
      calc ‖Complex.exp (-ζ) - 1‖ ≤ 2 * ‖-ζ‖ := h_exp_sub_one (-ζ) hζ_half
        _ = 2 * ‖ζ‖ := by rw [norm_neg]
        _ ≤ 2 * ‖u‖ := by linarith
    have hu_cb : u ∈ Metric.closedBall (0 : ℂ) ‖u‖ := by simp [Metric.mem_closedBall]
    have h0_cb : (0 : ℂ) ∈ Metric.closedBall (0 : ℂ) ‖u‖ :=
      Metric.mem_closedBall_self (norm_nonneg u)
    have h_mvt := Convex.norm_image_sub_le_of_norm_deriv_le h_diff h_dbound
      (convex_closedBall (0 : ℂ) ‖u‖) h0_cb hu_cb
    have hf0 : f₂ 0 = 0 := by simp [f₂]
    rw [hf0, sub_zero, sub_zero] at h_mvt
    calc ‖1 - Complex.exp (-u) - u‖ = ‖f₂ u‖ := rfl
      _ ≤ 2 * ‖u‖ * ‖u‖ := h_mvt
      _ = 2 * ‖u‖ ^ 2 := by ring

  
  
  
  let PhiQ : ℂ → ℂ := fun z => Complex.tanh z - z / (Complex.cosh z) ^ 2
  let lamZ : ℂ → ℂ := fun z => (Λ : ℂ) * Complex.exp ((1 / 3 : ℂ) * Complex.log (PhiQ z))
  let PsiQ : ℂ → ℂ := fun z => 4 * Complex.tanh z / ((Complex.cosh z) ^ 2 * (lamZ z) ^ 2)

  
  have hS0_q : ∀ z ∈ S_strip 8 (4 * Real.pi),
      let q := Complex.exp (-2 * z)
      ‖q‖ = Real.exp (-2 * z.re) ∧
      ‖q‖ < 1 / 1000 ∧
      1 / 2 < ‖1 + q‖ ∧
      1 / 2 < ‖1 - q‖ ∧
      1 + q ≠ 0 ∧
      Complex.cosh z ≠ 0 ∧
      Complex.sinh z ≠ 0 ∧
      Complex.tanh z = (1 - q) / (1 + q) ∧
      (1 : ℂ) / (Complex.cosh z) ^ 2 = 4 * q / (1 + q) ^ 2 ∧
      PhiQ z = (1 - q ^ 2 - 4 * z * q) / (1 + q) ^ 2 ∧
      ‖PhiQ z - 1‖ ≤ 64 * Real.exp (-(3 / 2 : ℝ) * z.re) ∧
      ‖PhiQ z - 1‖ < 1 / 10 ∧
      PhiQ z ∈ Complex.slitPlane ∧
      PhiQ z ≠ 0 := by
    intro z hz
    rcases hz with ⟨hz_re, hz_im⟩
    intro q
    have hq_norm : ‖q‖ = Real.exp (-2 * z.re) := by
      dsimp [q]
      rw [Complex.norm_exp]
      simp
    have hq_small : ‖q‖ < 1 / 1000 := by
      rw [hq_norm]
      have h1 : Real.exp (-2 * z.re) < Real.exp (-16) :=
        Real.exp_lt_exp.mpr (by linarith)
      have h2 : Real.exp (-16) ≤ 1 / 6561 := by
        rw [Real.exp_neg]
        exact (inv_anti₀ (by norm_num) hexp16_ge).trans (by norm_num)
      linarith
    have h1pq_gt : 1 / 2 < ‖1 + q‖ := by
      have htri := norm_sub_norm_le (1 : ℂ) (-q)
      simp only [sub_neg_eq_add, norm_one, norm_neg] at htri
      linarith
    have h1mq_gt : 1 / 2 < ‖1 - q‖ := by
      have htri := norm_sub_norm_le (1 : ℂ) q
      simp only [norm_one] at htri
      linarith
    have h1pq_ne : 1 + q ≠ 0 := by
      intro h0; rw [h0, norm_zero] at h1pq_gt; linarith
    have h1mq_ne : 1 - q ≠ 0 := by
      intro h0; rw [h0, norm_zero] at h1mq_gt; linarith
    have hexp_mul_q : Complex.exp z * q = Complex.exp (-z) := by
      dsimp [q]
      rw [← Complex.exp_add]
      congr 1; ring
    have hcosh_eq : Complex.cosh z = Complex.exp z * (1 + q) / 2 := by
      rw [Complex.cosh, mul_add, mul_one, hexp_mul_q]
    have hsinh_eq : Complex.sinh z = Complex.exp z * (1 - q) / 2 := by
      rw [Complex.sinh, mul_sub, mul_one, hexp_mul_q]
    have hexp_ne : Complex.exp z ≠ 0 := Complex.exp_ne_zero z
    have hcosh_ne : Complex.cosh z ≠ 0 := by
      rw [hcosh_eq]
      exact div_ne_zero (mul_ne_zero hexp_ne h1pq_ne) two_ne_zero
    have hsinh_ne : Complex.sinh z ≠ 0 := by
      rw [hsinh_eq]
      exact div_ne_zero (mul_ne_zero hexp_ne h1mq_ne) two_ne_zero
    have htanh_eq : Complex.tanh z = (1 - q) / (1 + q) := by
      rw [Complex.tanh_eq_sinh_div_cosh, hsinh_eq, hcosh_eq]
      field_simp [hexp_ne, h1pq_ne]
    have hexp2_mul_q : Complex.exp z ^ 2 * q = 1 := by
      dsimp [q]
      rw [sq, mul_assoc, hexp_mul_q, ← Complex.exp_add, add_neg_cancel, Complex.exp_zero]
    have hsech_sq : (1 : ℂ) / (Complex.cosh z) ^ 2 = 4 * q / (1 + q) ^ 2 := by
      rw [hcosh_eq, div_eq_iff (pow_ne_zero 2 (div_ne_zero (mul_ne_zero hexp_ne h1pq_ne) two_ne_zero))]
      have h_rhs : 4 * q / (1 + q) ^ 2 * (Complex.exp z * (1 + q) / 2) ^ 2 =
          (Complex.exp z ^ 2 * q) * ((1 + q) ^ 2 / (1 + q) ^ 2) := by ring
      rw [h_rhs, hexp2_mul_q, div_self (pow_ne_zero 2 h1pq_ne), mul_one]
    have hPhi_eq : PhiQ z = (1 - q ^ 2 - 4 * z * q) / (1 + q) ^ 2 := by
      dsimp [PhiQ]
      have hdiv : z / (Complex.cosh z) ^ 2 = z * ((1 : ℂ) / (Complex.cosh z) ^ 2) := by ring
      rw [htanh_eq, hdiv, hsech_sq]
      field_simp [h1pq_ne]
      ring
    have hPhi_diff : PhiQ z - 1 = (-2 * q - 2 * q ^ 2 - 4 * z * q) / (1 + q) ^ 2 := by
      rw [hPhi_eq]
      field_simp [h1pq_ne]
      ring
    have hq_le_32 : ‖q‖ ≤ Real.exp (-(3 / 2 : ℝ) * z.re) := by
      rw [hq_norm]
