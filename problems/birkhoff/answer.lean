          k₀ < N ∧ AnalyticAt ℂ g 0 ∧ g 0 ≠ 0 ∧
          ∀ᶠ w in nhds (0 : ℂ),
            Z_hat w - ∑ m ∈ Finset.range (k₀ + 1), c m * w ^ (2 * m) =
              w ^ (2 * k₀ + 1) * g w) ∨
        (∃ (c : ℕ → ℂ) (R_N : ℂ → ℂ),
          AnalyticAt ℂ R_N 0 ∧
          ∀ᶠ w in nhds (0 : ℂ),
            Z_hat w - ∑ m ∈ Finset.range N, c m * w ^ (2 * m) = w ^ (2 * N) * R_N w) := by
