    have h_disp_int : ∀ (k : ℤ) (y t : ℂ), |y.im| < H₃ → ‖t‖ < ρ₀ →
        S.𝔰 (y + (((k : ℝ) * (2 * Real.pi) : ℝ) : ℂ), t) -
          (y + (((k : ℝ) * (2 * Real.pi) : ℝ) : ℂ)) = S.𝔰 (y, t) - y := by
