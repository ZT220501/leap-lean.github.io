  have hlog_real_int :
      IntervalIntegrable (fun x : ℝ => Real.log ‖f (x : ℂ)‖) MeasureTheory.volume 0 (2 * Real.pi) :=
    ((continuous_norm.comp hf_real_cont).log (fun x => (hf_real_norm_pos x).ne')).intervalIntegrable
      0 (2 * Real.pi)
  refine ⟨C_strip, hC_strip_pos, ?_⟩
  intro z₀ Δ K hΔ hSub hBand
  
  let s_dir : ℝ := if 0 ≤ z₀.im then Δ else -Δ
  let w_top : ℂ := z₀ + (s_dir : ℂ) * Complex.I
  have hs_dir_abs : |s_dir| = Δ := by
    dsimp [s_dir]
    split_ifs <;> simp [abs_of_pos hΔ]
  have hw_top_mem : w_top ∈ U := by
    apply hSub
    rw [Metric.mem_closedBall, dist_eq_norm]
    have hdiff : w_top - z₀ = (s_dir : ℂ) * Complex.I := by dsimp [w_top]; ring
    rw [hdiff, norm_mul, Complex.norm_real, Real.norm_eq_abs, hs_dir_abs, Complex.norm_I, mul_one]
  have hw_top_im_abs : |w_top.im| = |z₀.im| + Δ := by
    have him : w_top.im = z₀.im + s_dir := by simp [w_top]
    rw [him]
    dsimp [s_dir]
    split_ifs with hz_nn
    · rw [abs_of_nonneg hz_nn, abs_of_pos (by linarith)]
    · push Not at hz_nn
      rw [abs_of_neg hz_nn, abs_of_neg (by linarith)]
      ring
  obtain ⟨δ_U, hδ_U_pos, hBall_U⟩ := Metric.isOpen_iff.mp hPer.isOpen_U w_top hw_top_mem
  let s_ext : ℝ := if 0 ≤ w_top.im then δ_U / 2 else -(δ_U / 2)
  let w_ext : ℂ := w_top + (s_ext : ℂ) * Complex.I
  have hs_ext_abs : |s_ext| = δ_U / 2 := by
    dsimp [s_ext]
    split_ifs <;> simp [abs_of_pos (half_pos hδ_U_pos)]
  have hw_ext_mem : w_ext ∈ U := by
    apply hBall_U
    rw [Metric.mem_ball, dist_eq_norm]
    have hdiff : w_ext - w_top = (s_ext : ℂ) * Complex.I := by dsimp [w_ext]; ring
    rw [hdiff, norm_mul, Complex.norm_real, Real.norm_eq_abs, hs_ext_abs, Complex.norm_I, mul_one]
    linarith
