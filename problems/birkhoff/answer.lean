      let Bad : Set S_mv := { R_p : S_mv | ∃ q ∈ U_a ×ˢ U_d, evalFn R_p q ≠ 0 }
      have hBad_cnt : Bad.Countable := Set.to_countable Bad
      let S_a : S_mv → Set ℝ := fun R_p =>
        { a ∈ Set.Ioo a_lo a_hi | ∀ d ∈ Set.Ioo d_lo d_hi, evalFn R_p ((a : ℂ), (d : ℂ)) = 0 }
      have hSa_cnt : ∀ R_p ∈ Bad, (S_a R_p).Countable := by
        rintro R_p ⟨⟨z_s, w_s⟩, ⟨hz_s, hw_s⟩, hne_s⟩
        have hw_holo : DifferentiableOn ℂ (fun w => evalFn R_p (z_s, w)) U_d :=
          (heval_holo R_p).comp ((differentiableOn_const z_s).prodMk differentiableOn_id)
            (fun w hw => ⟨hz_s, hw⟩)
        have hd_zero_cnt := hZeroCount U_d d_lo d_hi (fun w => evalFn R_p (z_s, w))
          hUd_open hUd_conn hId hw_holo ⟨w_s, hw_s, hne_s⟩
        rcases hIooAvoid d_lo d_hi _ hd_lt hd_zero_cnt with ⟨d_s, hd_s, hd_s_nz⟩
        have hd_s_ne : evalFn R_p (z_s, (d_s : ℂ)) ≠ 0 := fun h0 => hd_s_nz ⟨hd_s, h0⟩
        have hz_holo_slice : DifferentiableOn ℂ (fun z => evalFn R_p (z, (d_s : ℂ))) U_a :=
          (heval_holo R_p).comp (differentiableOn_id.prodMk (differentiableOn_const (d_s : ℂ)))
            (fun z hz => ⟨hz, hId d_s hd_s⟩)
        have ha_zero_cnt := hZeroCount U_a a_lo a_hi (fun z => evalFn R_p (z, (d_s : ℂ)))
          hUa_open hUa_conn hIa hz_holo_slice ⟨z_s, hz_s, hd_s_ne⟩
        refine ha_zero_cnt.mono ?_
        intro a ha
        exact ⟨ha.1, ha.2 d_s hd_s⟩
      rcases hIooAvoid a_lo a_hi (⋃ R_p ∈ Bad, S_a R_p) ha_lt (hBad_cnt.biUnion hSa_cnt) with
        ⟨a₁, ha₁_mem, ha₁_not⟩
      let T_d : S_mv → Set ℝ := fun R_p =>
        { d ∈ Set.Ioo d_lo d_hi | evalFn R_p ((a₁ : ℂ), (d : ℂ)) = 0 }
      have hTd_cnt : ∀ R_p ∈ Bad, (T_d R_p).Countable := by
        intro R_p hR_bad
        have ha₁_not_R : a₁ ∉ S_a R_p := fun h => ha₁_not (Set.mem_biUnion hR_bad h)
        have hex_d : ∃ d' ∈ Set.Ioo d_lo d_hi, evalFn R_p ((a₁ : ℂ), (d' : ℂ)) ≠ 0 := by
          by_contra h_all0
          exact ha₁_not_R ⟨ha₁_mem, fun d hd => Classical.not_not.mp fun hne => h_all0 ⟨d, hd, hne⟩⟩
        rcases hex_d with ⟨d', hd'_mem, hd'_nz⟩
        have hw_holo : DifferentiableOn ℂ (fun w => evalFn R_p ((a₁ : ℂ), w)) U_d :=
          (heval_holo R_p).comp ((differentiableOn_const (a₁ : ℂ)).prodMk differentiableOn_id)
            (fun w hw => ⟨hIa a₁ ha₁_mem, hw⟩)
        exact hZeroCount U_d d_lo d_hi (fun w => evalFn R_p ((a₁ : ℂ), w))
          hUd_open hUd_conn hId hw_holo ⟨(d' : ℂ), hId d' hd'_mem, hd'_nz⟩
      rcases hIooAvoid d_lo d_hi (⋃ R_p ∈ Bad, T_d R_p) hd_lt (hBad_cnt.biUnion hTd_cnt) with
        ⟨d₁, hd₁_mem, hd₁_not⟩
      let q₁ : ℂ × ℂ := ((a₁ : ℂ), (d₁ : ℂ))
      have hq₁_mem : q₁ ∈ U_a ×ˢ U_d := ⟨hIa a₁ ha₁_mem, hId d₁ hd₁_mem⟩
      have h_gen : ∀ R_p : S_mv, evalFn R_p q₁ = 0 → ∀ q ∈ U_a ×ˢ U_d, evalFn R_p q = 0 := by
