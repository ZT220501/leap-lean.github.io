    have hRq3_le : R / (q : ℝ) ^ 3 ≤ (4 * (q : ℝ))⁻¹ := le_trans hRq3_le_q2 hRq2_le
    have hRq3_le_invq : R / (q : ℝ) ^ 3 ≤ 1 / (q : ℝ) := by
