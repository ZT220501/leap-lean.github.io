          iteratedDeriv_add (x := (0 : ℂ)) (n := l) hcB (hc_lin.add hc_rem)
        have h2 : iteratedDeriv l (fun ε => c * ε ^ l + ε ^ (l + 1) * Ψ ε) 0 =
