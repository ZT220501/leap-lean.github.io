      let T2 : ℂ →L[ℂ] ℂ × ℂ := (0 : ℂ →L[ℂ] ℂ).prod (ContinuousLinearMap.id ℂ ℂ)
      have hc : HasDerivAt (fun t : ℂ => (s₀, t)) (0, 1) 0 := by
        have h := T2.hasDerivAt (x := 0) |>.const_add (s₀, 0)
        have hf : (fun t : ℂ => (s₀, 0) + T2 t) = (fun t : ℂ => (s₀, t)) := by
          ext t <;> simp [T2]
        have hv : T2 1 = ((0 : ℂ), (1 : ℂ)) := by simp [T2]
        rwa [hf, hv] at h
      have hΨ_t : HasDerivAt (fun t : ℂ => Ψ (s₀, t)) (0, 1) 0 :=
