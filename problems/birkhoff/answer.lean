      obtain ⟨δ', hδ'_pos, hδ'_sub⟩ := Metric.eventually_nhds_iff_ball.mp h_ev
      let B' := Metric.ball q₁ δ'
      have hB'_sub₁ : B' ⊆ B₁ := fun q hq => (hδ'_sub q hq).1.1
      have hB'_sub₂ : B' ⊆ B₂ := fun q hq => (hδ'_sub q hq).1.2
      have h_den1_nz : ∀ ci : Fin 2 × Fin 2, ∀ q ∈ B', ssbpcPairDen E₀ E₁ p₁ q ci ≠ 0 := by
        intro ci q hq
        have hp_nz : ssbpcPairDenProd E₀ E₁ p₁ q ≠ 0 :=
