    let G : ℂ → ℂ := fun w =>
      if w ∈ S_int then
        -2 * dslope (dslope (dslope f w) w) w w / (deriv f w) ^ 3 -
          ∑ z ∈ S_int.erase w, (deriv f z)⁻¹ ^ 2 * (w - z)⁻¹ ^ 2
