      obtain ⟨Pm, hPm_within⟩ := hH_conv.exists_forall_hasDerivWithinAt hhm_holo
      have hPm_deriv : ∀ w ∈ criticalLowerHalfPlane, HasDerivAt Pm (hm w) w :=
