  have hEvBiUnion : ∀ {ι : Type} (s : Finset ι) {n : ℕ} {A : ι → Set WalkSpace},
      (∀ x ∈ s, shcbWalkPrefixEvent n (A x)) →
      shcbWalkPrefixEvent n {om | ∃ x ∈ s, om ∈ A x} := by
    intro ι s n A hA
    classical
    induction s using Finset.induction_on with
    | empty =>
        have : {om : WalkSpace | ∃ x ∈ (∅ : Finset ι), om ∈ A x} = Set.univᶜ := by ext; simp
        rw [this]; exact hEvCompl (hEvUniv n)
    | @insert a s' ha ih =>
        have hEq : {om : WalkSpace | ∃ x ∈ insert a s', om ∈ A x} =
            A a ∪ {om | ∃ x ∈ s', om ∈ A x} := by ext om; simp
        rw [hEq]
        exact hEvUnion (hA a (Finset.mem_insert_self a s'))
          (ih (fun x hx => hA x (Finset.mem_insert_of_mem hx)))
