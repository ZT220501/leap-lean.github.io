    have ht_Vt : t ∈ V_t := by
      dsimp [V_t]
      rw [Metric.mem_ball, dist_eq_norm, sub_zero]
      linarith
    have hρ_nonneg : 0 ≤ ρ_t := by positivity
    have hρ_le_adm : ρ_t ≤ O.η_adm / 8 := by
      have ht_pow_d1 : ‖t‖ ^ (2 * j) ≤ d₁ :=
        (pow_le_of_le_one (norm_nonneg t) ht_le1 (by omega)).trans (le_of_lt ht_d1)
      calc M_u3 * ‖t‖ ^ (2 * j) ≤ M_u3 * d₁ := by gcongr
        _ = d₁ * M_u3 := mul_comm _ _
        _ ≤ O.η_adm / 8 := hd₁_Mu3_adm
    have hu_t_holo_s : DifferentiableOn ℂ u_t (horizStrip s) :=
      hU_adm.1.comp (differentiableOn_id.prodMk (differentiableOn_const t))
        (fun z hz => ⟨ht_d, by have : |z.im| < s := hz; simp [this]⟩)
    have hu_t_holo : DifferentiableOn ℂ u_t (horizStrip s₃) :=
      hu_t_holo_s.mono (fun z hz => lt_trans hz hs₃_lt_s)
    have hv_t_holo : DifferentiableOn ℂ v_t (horizStrip s₃) :=
      (hw₀_holo.comp (differentiableOn_id.prodMk (differentiableOn_const t))
        (fun z hz => ⟨ht_Vt, by
          have hz' : |z.im| < s₃ := hz
          dsimp [s₃, δ_s] at hz' ⊢
          linarith⟩)).mul (differentiableOn_const (t ^ (2 * j)))
    have hprod_eq_s : ∀ z ∈ horizStrip s, deriv u_t z * v_t z = u_j z * t ^ (2 * j) := by
      intro z hz
      have hdu_ne := (hdU_y_props z hz t ht_d).1
      dsimp [u_t, v_t, w₀, dU_y] at hdu_ne ⊢
      field_simp [hdu_ne]
    have huv_t_it : ∀ k : ℕ, k ≤ 2 → ∀ z ∈ horizStrip s₃,
        ‖iteratedDeriv k (fun z' : ℂ => deriv u_t z' * v_t z') z‖ ≤ ρ_t := by
      intro k hk z hz
      have hz_s : z ∈ horizStrip s := lt_trans hz hs₃_lt_s
      have hev : (fun z' : ℂ => deriv u_t z' * v_t z') =ᶠ[nhds z]
          (fun z' : ℂ => t ^ (2 * j) * u_j z') :=
        Filter.eventuallyEq_of_mem ((isOpen_horizStrip s).mem_nhds hz_s) (fun z' hz' => by
          rw [hprod_eq_s z' hz', mul_comm])
      have hu_cd : ContDiffAt ℂ (k : WithTop ℕ∞) u_j z :=
        (hu_holo.contDiffOn (isOpen_horizStrip s)).contDiffAt ((isOpen_horizStrip s).mem_nhds hz_s)
      rw [hev.iteratedDeriv_eq, iteratedDeriv_const_mul (t ^ (2 * j)) hu_cd, norm_mul, norm_pow]
      have hb := hu_it3 k (by omega) z hz
      calc ‖t‖ ^ (2 * j) * ‖iteratedDeriv k u_j z‖
          ≤ ‖t‖ ^ (2 * j) * M_u3 := by gcongr
        _ = ρ_t := mul_comm _ _
    have hquad_step := hQuad s₃ ρ_t y t u_t v_t hs₃_pos hs₃_le ht_d_act hyt_s3
      hρ_nonneg hρ_le_adm hu_t_holo hv_t_holo
      (fun k hk z hz => hU_adm_O.2.2.2.2 k (by omega) z t
        ⟨ht_d, by have hz' : |z.im| < s₃ := hz; simp [lt_trans hz' hs₃_lt_s]⟩)
      huv_t_it
    have hres_next_eq :
        glancingResidualOp B (fun q => u_t q.1 + deriv u_t q.1 * v_t q.1) (y, t) =
          glancingResidualOp B U_next (y, t) := by
      have h1 := glancingResidualOp_congr_strip s y t
        (fun z => u_t z + deriv u_t z * v_t z) (fun z => U_next (z, t)) hyt_s
        (fun z hz => by dsimp [U_next, u_t]; rw [hprod_eq_s z hz])
      rw [h1, glancingResidualOp_slice U_next y t]
    have hlin_factor :
        glancingDiffOp
          (fun q =>
            glancingLinCoeff B (fun r => u_t r.1) (q.1, t) *
              glancingDiffOp (fun r => v_t r.1) (q.1, t))
          (y, t) = F (y, t) * t ^ (2 * j) := by
      have hinner : ∀ z : ℂ,
          glancingDiffOp (fun r => v_t r.1) (z, t) = glancingDiffOp w₀ (z, t) * t ^ (2 * j) :=
        fun z => glancingDiffOp_mul_const (fun r => w₀ (r.1, t)) (z, t) (t ^ (2 * j))
      have houter_fn :
          (fun q : ℂ × ℂ =>
            glancingLinCoeff B (fun r => u_t r.1) (q.1, t) *
              glancingDiffOp (fun r => v_t r.1) (q.1, t)) =
          (fun q : ℂ × ℂ => G₁ (q.1, t) * t ^ (2 * j)) := by
        ext q
        rw [hinner q.1]
        dsimp [G₁, u_t]
        rw [glancingLinCoeff_slice U_prev q.1 t, mul_assoc]
      rw [houter_fn]
      exact glancingDiffOp_mul_const (fun q => G₁ (q.1, t)) (y, t) (t ^ (2 * j))
    
    let H_t : ℂ → ℂ := fun z => glancingResidualOp B U_prev (z, t) * w₀ (z, t)
    have hdrift_bound :
        ‖deriv (fun z : ℂ => glancingResidualOp B (fun r => u_t r.1) (z, t) * v_t z) y‖ ≤
          (128 / (123 * δ_s)) * M_prev * M_u * ‖t‖ ^ (4 * j) := by
      have hcb : Metric.closedBall y δ_s ⊆ horizStrip (s - |t.im|) :=
        closedBall_subset_horizStrip y δ_s (s - |t.im|) (by dsimp [δ_s]; linarith)
      have hE_holo_2d := (O.E_op_props s d U_prev hs hs_le hd hd_le hd_lt hU_adm_O).1
      have hH_holo : DifferentiableOn ℂ H_t (horizStrip (s - |t.im|)) := by
        have hE_1d : DifferentiableOn ℂ (fun z => glancingResidualOp B U_prev (z, t))
            (horizStrip (s - |t.im|)) :=
          hE_holo_2d.comp (differentiableOn_id.prodMk (differentiableOn_const t))
            (fun z hz => ⟨ht_d, by have hz' : |z.im| < s - |t.im| := hz; dsimp; linarith⟩)
        have hw_1d : DifferentiableOn ℂ (fun z => w₀ (z, t)) (horizStrip (s - |t.im|)) :=
          hw₀_holo.comp (differentiableOn_id.prodMk (differentiableOn_const t))
            (fun z hz => ⟨ht_Vt, by
              have hz' : |z.im| < s - |t.im| := hz
              dsimp; linarith [abs_nonneg t.im]⟩)
        exact hE_1d.mul hw_1d
      have hH_bd : ∀ z ∈ horizStrip (s - |t.im|),
          ‖H_t z‖ ≤ (M_prev * ‖t‖ ^ (2 * j)) * ((128 / 123 : ℝ) * M_u) := by
        intro z hz
        have hz' : |z.im| < s - |t.im| := hz
        have hdom : (z, t) ∈ glancingDomain 1 s d := ⟨ht_d, by dsimp; linarith⟩
        have hz_s : z ∈ horizStrip s := by change |z.im| < s; linarith [abs_nonneg t.im]
        dsimp [H_t]
        rw [norm_mul]
        have hb1 := hU_res (z, t) hdom
        have hb2 := hw₀_bound z hz_s t ht_d
        gcongr
      have hc := cauchy_deriv_ball (horizStrip (s - |t.im|)) H_t y δ_s
        ((M_prev * ‖t‖ ^ (2 * j)) * ((128 / 123 : ℝ) * M_u)) hδ_s hH_holo hcb hH_bd
      have hfn_eq : (fun z : ℂ => glancingResidualOp B (fun r => u_t r.1) (z, t) * v_t z) =
          (fun z : ℂ => H_t z * t ^ (2 * j)) := by
        ext z
        dsimp [H_t, v_t, u_t]
        rw [glancingResidualOp_slice U_prev z t, mul_assoc]
      rw [hfn_eq, deriv_mul_const_field, norm_mul, norm_pow]
      calc ‖deriv H_t y‖ * ‖t‖ ^ (2 * j)
          ≤ (((M_prev * ‖t‖ ^ (2 * j)) * ((128 / 123 : ℝ) * M_u)) / δ_s) * ‖t‖ ^ (2 * j) := by
            gcongr
        _ = (128 / (123 * δ_s)) * M_prev * M_u * ‖t‖ ^ (4 * j) := by
            have hpow : ‖t‖ ^ (2 * j) * ‖t‖ ^ (2 * j) = ‖t‖ ^ (4 * j) := by
              rw [← pow_add]
              congr 1
              omega
            calc (((M_prev * ‖t‖ ^ (2 * j)) * ((128 / 123 : ℝ) * M_u)) / δ_s) * ‖t‖ ^ (2 * j)
                = (128 / (123 * δ_s)) * M_prev * M_u * (‖t‖ ^ (2 * j) * ‖t‖ ^ (2 * j)) := by
                  field_simp [ne_of_gt hδ_s]
              _ = (128 / (123 * δ_s)) * M_prev * M_u * ‖t‖ ^ (4 * j) := by rw [hpow]
    have ht_pow4_le : ‖t‖ ^ (4 * j) ≤ ‖t‖ ^ (2 * j + 2) :=
      pow_le_pow_of_le_one (norm_nonneg t) ht_le1 (by omega)
    have hres_prev_rfl : glancingResidualOp B (fun q => u_t q.1) (y, t) =
        glancingResidualOp B U_prev (y, t) :=
      glancingResidualOp_slice U_prev y t
    rw [hres_next_eq, hres_prev_rfl, hlin_factor] at hquad_step
    have hb_quad : C_quad * ρ_t ^ 2 ≤ C_quad * M_u3 ^ 2 * ‖t‖ ^ (2 * j + 2) := by
      have hρ_sq : C_quad * ρ_t ^ 2 = C_quad * M_u3 ^ 2 * ‖t‖ ^ (4 * j) := by
        dsimp [ρ_t]
        have hpow : (‖t‖ ^ (2 * j)) ^ 2 = ‖t‖ ^ (4 * j) := by
          rw [← pow_mul]
          congr 1
          omega
        calc C_quad * (M_u3 * ‖t‖ ^ (2 * j)) ^ 2
            = C_quad * M_u3 ^ 2 * (‖t‖ ^ (2 * j)) ^ 2 := by ring
          _ = C_quad * M_u3 ^ 2 * ‖t‖ ^ (4 * j) := by rw [hpow]
      rw [hρ_sq]
      gcongr
    have hb_lin :
        ‖F (y, t) * t ^ (2 * j) - (1 / 4 : ℂ) * deriv (deriv u_j) y * t ^ (2 * j)‖ ≤
          (M_F / d₁ ^ 2) * ‖t‖ ^ (2 * j + 2) := by
      have hsub : F (y, t) * t ^ (2 * j) - (1 / 4 : ℂ) * deriv (deriv u_j) y * t ^ (2 * j) =
          (F (y, t) - (1 / 4 : ℂ) * deriv (deriv u_j) y) * t ^ (2 * j) := by ring
      rw [hsub, norm_mul, norm_pow]
      have hF_ds := hF_dslope y hy_s' t ht_d1
      calc ‖F (y, t) - (1 / 4 : ℂ) * deriv (deriv u_j) y‖ * ‖t‖ ^ (2 * j)
          ≤ ((M_F / d₁ ^ 2) * ‖t‖ ^ 2) * ‖t‖ ^ (2 * j) := by gcongr
        _ = (M_F / d₁ ^ 2) * ‖t‖ ^ (2 * j + 2) := by
            have hpow : ‖t‖ ^ 2 * ‖t‖ ^ (2 * j) = ‖t‖ ^ (2 * j + 2) := by
              rw [← pow_add]
              congr 1
              omega
            calc ((M_F / d₁ ^ 2) * ‖t‖ ^ 2) * ‖t‖ ^ (2 * j)
                = (M_F / d₁ ^ 2) * (‖t‖ ^ 2 * ‖t‖ ^ (2 * j)) := by ring
              _ = (M_F / d₁ ^ 2) * ‖t‖ ^ (2 * j + 2) := by rw [hpow]
    have hb_drift :
        ‖deriv (fun z : ℂ => glancingResidualOp B (fun r => u_t r.1) (z, t) * v_t z) y‖ ≤
          (128 / (123 * δ_s)) * M_prev * M_u * ‖t‖ ^ (2 * j + 2) :=
      hdrift_bound.trans (by gcongr)
    set E_next := glancingResidualOp B U_next (y, t)
    set E_prev := glancingResidualOp B U_prev (y, t)
    set L_lin := F (y, t) * t ^ (2 * j)
    set L_drift := deriv (fun z : ℂ => glancingResidualOp B (fun r => u_t r.1) (z, t) * v_t z) y
    set T_lead := (1 / 4 : ℂ) * deriv (deriv u_j) y * t ^ (2 * j)
    have hsplit : E_next - (E_prev + T_lead) =
        (E_next - E_prev - (L_lin + L_drift)) + (L_lin - T_lead) + L_drift := by ring
    change ‖E_next - (E_prev + T_lead)‖ ≤ M_next * ‖t‖ ^ (2 * j + 2)
    rw [hsplit]
    calc ‖(E_next - E_prev - (L_lin + L_drift)) + (L_lin - T_lead) + L_drift‖
        ≤ ‖E_next - E_prev - (L_lin + L_drift)‖ + ‖L_lin - T_lead‖ + ‖L_drift‖ := by
          exact (norm_add_le _ _).trans (add_le_add (norm_add_le _ _) (le_refl _))
      _ ≤ C_quad * M_u3 ^ 2 * ‖t‖ ^ (2 * j + 2) +
            (M_F / d₁ ^ 2) * ‖t‖ ^ (2 * j + 2) +
            (128 / (123 * δ_s)) * M_prev * M_u * ‖t‖ ^ (2 * j + 2) := by
          linarith [hquad_step.trans hb_quad, hb_lin, hb_drift]
      _ = M_next * ‖t‖ ^ (2 * j + 2) := by
          dsimp [M_next]; ring
  exact ⟨{
    C_quad := C_quad
    C_quad_pos := hC_quad_pos
    formal_perturbation := hPert
    slice_quad_approx := hQuad
    exact_jet_deriv := hJet
  }⟩

