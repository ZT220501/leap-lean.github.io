        have hmaps : Set.MapsTo E₀ (Metric.ball z δ) (Metric.closedBall (E₀ z) (2 * ε)) := by
          intro w hw
          rw [Metric.mem_closedBall, dist_eq_norm]
          have htri := norm_sub_le (E₀ w) (E₀ z)
          have h1 := hE₀_bnd w (hball_sub hw)
          have h2 := hE₀_bnd z hz_s
