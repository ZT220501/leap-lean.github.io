            (continuousOn_const.mul (hf.comp (by fun_prop : Continuous γ_seg).continuousOn
              hγ_mem)).intervalIntegrable
          have h_int_g : IntervalIntegrable (fun t => (b - a) * g (γ_seg t))
              MeasureTheory.volume 0 1 :=
            (continuousOn_const.mul (hg.comp (by fun_prop : Continuous γ_seg).continuousOn
              hγ_mem)).intervalIntegrable
          have h_seg : (∫ t in (0 : ℝ)..(1 : ℝ), (b - a) * (f (γ_seg t) - c * g (γ_seg t))) =
              (∫ t in (0 : ℝ)..(1 : ℝ), (b - a) * f (γ_seg t)) -
                c * (∫ t in (0 : ℝ)..(1 : ℝ), (b - a) * g (γ_seg t)) := by
            have h_eq_fn : (fun t => (b - a) * (f (γ_seg t) - c * g (γ_seg t))) =
                (fun t => (b - a) * f (γ_seg t) - c * ((b - a) * g (γ_seg t))) := by
              ext t; ring
            rw [h_eq_fn, intervalIntegral.integral_sub h_int_f (h_int_g.const_mul c),
              intervalIntegral.integral_const_mul c]
          have h_rest := ih (hf.mono (fun w hw => Or.inr hw)) (hg.mono (fun w hw => Or.inr hw))
          simp only [mpwcPolyIntegral]
          change (∫ t in (0 : ℝ)..(1 : ℝ), (b - a) * (f (γ_seg t) - c * g (γ_seg t))) +
            mpwcPolyIntegral (fun w => f w - c * g w) (b :: rest) = _
          rw [h_seg, h_rest]
          ring
    let signedJ (f : ℂ → ℂ) (L : List ℂ) (hL : L ≠ [])
