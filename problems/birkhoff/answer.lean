    let Ψ : ℕ → (ℕ → ℝ) → ℝ := fun m w =>
      if E_pred m w then D_tan (g m (w m)) * (g (m + 1) (w (m + 1)) - g m (w m)) else 0
    have h_step_ineq : ∀ m < M, ∀ w : ℕ → ℝ,
