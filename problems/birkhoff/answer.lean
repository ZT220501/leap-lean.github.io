    clear h_stage1
    intro s_init d_init M_init U_init hs_pos hs_le hd_pos hd_le hd_lt hM_pos hAdm_init hRes_init
    have hC_pos : 0 < G.C_step := G.C_step_pos
    have hc_pos : 0 < G.c_small := G.c_small_pos
    have hη_pos : 0 < G.η_adm := G.η_adm_pos
    let B₀ : ℕ := G.B₀
    let A_exp : ℕ := 2 * B₀ + 2
    have hA_pos : 0 < A_exp := by omega
    have hA_ge2 : 2 ≤ A_exp := by omega
    let K_B : ℝ := 403 + 400 * (A_exp : ℝ)
    have hK_B_eq : K_B = 403 + 400 * (A_exp : ℝ) := rfl
    have hK_B_pos : 0 < K_B := by positivity
    let c_min : ℝ := min G.c_small (G.η_adm / 4)
    have hc_min_pos : 0 < c_min := lt_min hc_pos (by positivity)
    let d_cap : ℝ := min (1 / 4 : ℝ) (min d_init (s_init / 4))
    have hd_cap_pos : 0 < d_cap := lt_min (by norm_num) (lt_min hd_pos (by positivity))
    let M_big : ℝ := 1 + M_init + G.C_step * K_B ^ B₀ * (2 : ℝ) ^ A_exp +
      (4 / 3 : ℝ) * G.C_step * K_B ^ B₀ / c_min
    have hM_big_eq : M_big = 1 + M_init + G.C_step * K_B ^ B₀ * (2 : ℝ) ^ A_exp +
      (4 / 3 : ℝ) * G.C_step * K_B ^ B₀ / c_min := rfl
    have hM_big_gt1 : 1 < M_big := by
      have h1 : 0 < M_init := hM_pos
      have h2 : 0 ≤ G.C_step * K_B ^ B₀ * (2 : ℝ) ^ A_exp := by positivity
      have h3 : 0 ≤ (4 / 3 : ℝ) * G.C_step * K_B ^ B₀ / c_min := by positivity
      linarith
    have hM_big_pos : 0 < M_big := by linarith
    let d₀ : ℝ := min (d_cap / 2) (1 / (2 * M_big))
    have hd₀_pos : 0 < d₀ := lt_min (by positivity) (by positivity)
    have hd₀_lt_half_cap : d₀ ≤ d_cap / 2 := min_le_left _ _
    have hd₀_lt_quarter : d₀ < 1 / 4 := by
