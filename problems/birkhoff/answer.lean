      mpwcPolyIntegral f (mpwcPolyPrefixTo L hL q hq) -
        mpwcPolyIntegral f (mpwcPolyPrefixTo L hL p hp)
    have h_signedJ_ftc : ∀ (L : List ℂ) (hL : L ≠ []) (p : ℂ) (hp : p ∈ meshPolyTrace L)
        (q : ℂ) (hq : q ∈ meshPolyTrace L) (U : Set ℂ) (f F_prim : ℂ → ℂ),
        meshPolyTrace L ⊆ U →
        ContinuousOn f U →
        (∀ w ∈ U, HasDerivAt F_prim (f w) w) →
        signedJ f L hL p hp q hq = F_prim q - F_prim p := by
