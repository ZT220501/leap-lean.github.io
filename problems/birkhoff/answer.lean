        (∀ v ∈ Metric.ball (0 : ℂ) ρ, HasDerivAt F (F' v) v) ∧
        (∀ v ∈ Metric.ball (0 : ℂ) ρ, Summable (fun m : ℕ => (c m : ℂ) * v ^ (2 * m))) ∧
        (∀ v ∈ Metric.ball (0 : ℂ) ρ, Summable (fun m : ℕ => c m * ‖v‖ ^ (2 * m))) ∧
        (∀ v ∈ Metric.ball (0 : ℂ) ρ,
          Summable (fun m : ℕ => (c m : ℂ) * ((2 * m : ℕ) : ℂ) * v ^ (2 * m - 1))) ∧
        F 0 = c 0 ∧
        (∀ v : ℂ, F (-v) = F v) ∧
        (∀ r : ℝ, |r| < ρ → (F (r : ℂ)).im = 0 ∧ (F (r : ℂ)).re = ∑' m : ℕ, c m * r ^ (2 * m)) ∧
        (∀ k : ℂ, ∀ v ∈ Metric.ball (0 : ℂ) ρ,
          k * F v + v * deriv F v =
            ∑' m : ℕ, ((c m : ℂ) * (k + ((2 * m : ℕ) : ℂ))) * v ^ (2 * m)) := by
      intro ρ C c hρ hC hc
      dsimp only
      have h_core : ∀ v ∈ Metric.ball (0 : ℂ) ρ,
          Summable (fun m : ℕ => (c m : ℂ) * v ^ (2 * m)) ∧
          Summable (fun m : ℕ => c m * ‖v‖ ^ (2 * m)) ∧
          Summable (fun m : ℕ => (c m : ℂ) * ((2 * m : ℕ) : ℂ) * v ^ (2 * m - 1)) ∧
          HasDerivAt (fun z => ∑' m : ℕ, (c m : ℂ) * z ^ (2 * m))
            (∑' m : ℕ, (c m : ℂ) * ((2 * m : ℕ) : ℂ) * v ^ (2 * m - 1)) v := by
        intro v hv
        have hv_lt : ‖v‖ < ρ := by simpa using hv
        let R : ℝ := (‖v‖ + ρ) / 2
        have hR_pos : 0 < R := by dsimp [R]; linarith [norm_nonneg v]
        have hR_lt : R < ρ := by dsimp [R]; linarith
        have hv_R : v ∈ Metric.ball (0 : ℂ) R := by
          rw [Metric.mem_ball, dist_zero_right]; dsimp [R]; linarith
        have h0_R : (0 : ℂ) ∈ Metric.ball (0 : ℂ) R := Metric.mem_ball_self hR_pos
        let q : ℝ := R / ρ
        have hq_pos : 0 < q := div_pos hR_pos hρ
        have hq_lt : q < 1 := (div_lt_one hρ).mpr hR_lt
        have hq2_lt : q ^ 2 < 1 := by nlinarith
        have hq2_norm : ‖q ^ 2‖ < 1 := by
          rw [Real.norm_eq_abs, abs_of_pos (by positivity)]
          exact hq2_lt
        have hu0 : Summable (fun m : ℕ => C * (q ^ 2) ^ m) :=
          (summable_geometric_of_lt_one (by positivity) hq2_lt).mul_left C
        have hu1 : Summable (fun m : ℕ => (2 * C * R⁻¹) * ((m : ℝ) ^ 1 * (q ^ 2) ^ m)) :=
          (summable_pow_mul_geometric_of_norm_lt_one 1 hq2_norm).mul_left (2 * C * R⁻¹)
        have h_pow_q : ∀ m : ℕ, (ρ⁻¹) ^ (2 * m) * R ^ (2 * m) = (q ^ 2) ^ m := by
