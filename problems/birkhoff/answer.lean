      simpa [s_closed, Metric.mem_closedBall, dist_eq_norm] using hZ
    change |Z.im - (Real.log M.R + B.ν' / 2)| < 3 * B.ε_patch
    calc |Z.im - (Real.log M.R + B.ν' / 2)| = |(Z - Y_minus).im| := by simp [Y_minus]
      _ ≤ ‖Z - Y_minus‖ := Complex.abs_im_le_norm _
      _ ≤ 2 * B.ε_patch := hZ_norm
      _ < 3 * B.ε_patch := by linarith
  have hF_inner_cont : ContinuousOn F_inner s_closed :=
    hConv_minus_true.continuousOn
      ((Filter.eventually_ge_atTop N_prom).mono
        fun n hn => ((hProm n hn).1.mono hs_closed_sub).continuousOn).frequently
  have hY_end_within : Filter.Tendsto Y_end Filter.atTop (nhdsWithin Y_minus s_closed) :=
    tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within Y_end hY_end_tendsto
      ((Filter.eventually_ge_atTop N_a).mono fun n hn => by
        rw [Metric.mem_closedBall, dist_eq_norm]
        linarith [hY_end_dist n, ha_lt n hn])
  have hLim_inner : Filter.Tendsto u Filter.atTop (nhds (F_inner Y_minus)) :=
    hConv_minus_true.tendsto_comp
      (hF_inner_cont Y_minus (Metric.mem_closedBall_self (by positivity))) hY_end_within

  have hLim_outer : Filter.Tendsto u Filter.atTop (nhds (S_outer (Y_minus, (T_star : ℂ)))) := by
    rw [Metric.tendsto_atTop]
    intro ε hε
    obtain ⟨N₁, _, hN₁⟩ := hChain_conv (ε / 2) (half_pos hε)
    obtain ⟨N₂, hN₂⟩ :=
      (Metric.tendsto_atTop.mp (hCont_out.tendsto.comp hY_end_tendsto)) (ε / 2) (half_pos hε)
    refine ⟨max (max N_tr N_a) (max N₁ N₂), fun n hn => ?_⟩
    have hn_glue : max N_tr N_a ≤ n := le_trans (le_max_left _ _) hn
    have hn₁ : N₁ ≤ n := le_trans (le_trans (le_max_left _ _) (le_max_right _ _)) hn
    have hn₂ : N₂ ≤ n := le_trans (le_trans (le_max_right _ _) (le_max_right _ _)) hn
    have hY_plus_B₁ : Y_plus ∈ B₁ := Metric.mem_ball_self hε_pos
    have hu_eq : u n = S_chain n (N_step n) Y_plus :=
      (h_glue n hn_glue (N_step n) le_rfl Y_plus hY_plus_B₁).symm
    have h_track_step := hN₁ n hn₁ (N_step n) le_rfl Y_plus hY_plus_B₁
    have h_end_eq :
        Y_plus + (N_step n : ℂ) * ((T_star : ℂ) / ((seq.ℓ_seq n * seq.m_seq n : ℝ) : ℂ)) =
          Y_end n := by
      rw [← ha_cast n]
    have hd₁ : dist (u n) (S_outer (Y_end n, (T_star : ℂ))) < ε / 2 := by
      rw [hu_eq, dist_eq_norm, ← h_end_eq]
      exact h_track_step
    have hd₂ : dist (S_outer (Y_end n, (T_star : ℂ))) (S_outer (Y_minus, (T_star : ℂ))) < ε / 2 :=
      hN₂ n hn₂
    calc dist (u n) (S_outer (Y_minus, (T_star : ℂ)))
        ≤ dist (u n) (S_outer (Y_end n, (T_star : ℂ))) +
            dist (S_outer (Y_end n, (T_star : ℂ))) (S_outer (Y_minus, (T_star : ℂ))) :=
          dist_triangle _ _ _
      _ < ε / 2 + ε / 2 := add_lt_add hd₁ hd₂
      _ = ε := add_halves ε

  exact hMono_ne (tendsto_nhds_unique hLim_outer hLim_inner)

theorem corridor_tracking_and_bypass_contradiction (X : ExpStripData) (hX : IsExpObstructionStrip X)
    (P : ChordActionPackage X) (kind : ExpProfileKind)
    (seq : ExpSequenceData X kind)
    (hDeep : DeepInitializedModelData X P kind seq)
    (M : BranchMonodromyPackage kind) :
    False :=
by
  have hDisk : DiskContinuationToolkitProp := binomial_dip_and_vertical_disk_continuation
  have hTrack : RegularCorridorTrackingProp X P kind seq :=
    regular_corridor_tracking_and_steep_passage X hX P kind seq
  obtain ⟨B⟩ := logarithmic_disk_radial_bypass_patches X hX P kind seq hDeep M hDisk hTrack
  exact horizontal_promotion_and_monodromy_contradiction X hX P kind seq M hDisk hTrack B

theorem exponential_profile_obstruction : (∀ S : FiniteWallNonisotropicStrip, ExpProfileObstructionProp S) ∧
      (∀ E : EntireNonisotropicStrip, EntireExpProfileObstructionProp E) :=
by
  obtain ⟨M_first⟩ := exponential_model_branch_monodromy .firstField
  obtain ⟨M_second⟩ := exponential_model_branch_monodromy .secondField
  obtain ⟨hStripFin, hStripEnt, hChord⟩ :=
    sturm_liouville_chord_action_and_frozen_convergence
  obtain ⟨hDeepFin, hDeepEnt⟩ := deep_vertical_passages_and_model_convergence
  refine ⟨?_, ?_⟩
  · intro S x_seq h_seq ℓ_seq m_seq c₀ α₀ δ_b hc₀ hα₁ hα₂ hδ₁ hδ₂
      h_bounds hh_tendsto hℓ_tendsto hb_tendsto hgap_tendsto hProf hCone
    have hX_S : IsExpObstructionStrip S.toExpStripData := hStripFin S
    obtain ⟨P_S⟩ := hChord S.toExpStripData hX_S
    have hm_tendsto : Filter.Tendsto m_seq Filter.atTop Filter.atTop := by
      rw [Filter.tendsto_atTop_atTop]
      intro B
      obtain ⟨N₁, hN₁⟩ := (Metric.tendsto_atTop.mp hℓ_tendsto) 1 zero_lt_one
      obtain ⟨N₂, hN₂⟩ := (Filter.tendsto_atTop_atTop.mp hb_tendsto) (max B 0)
      refine ⟨max N₁ N₂, fun n hn => ?_⟩
      have hn₁ : N₁ ≤ n := le_trans (le_max_left _ _) hn
      have hn₂ : N₂ ≤ n := le_trans (le_max_right _ _) hn
      have hℓ_pos : 0 < ℓ_seq n := (h_bounds n).2.1
      have hm_pos : 0 < m_seq n := (h_bounds n).2.2
      have hℓ_lt_one : ℓ_seq n < 1 := by
        have hd := hN₁ n hn₁
        rw [Real.dist_eq, sub_zero, abs_of_pos hℓ_pos] at hd
        exact hd
      have hprod_ge : max B 0 ≤ ℓ_seq n * m_seq n := hN₂ n hn₂
      have hprod_le : ℓ_seq n * m_seq n ≤ m_seq n := by nlinarith
      exact le_trans (le_max_left B 0) (le_trans hprod_ge hprod_le)
    have hh_div_ℓ : Filter.Tendsto (fun n => h_seq n / ℓ_seq n) Filter.atTop Filter.atTop := by
      rw [Filter.tendsto_atTop_atTop]
      intro B
      let B' : ℝ := max B 1
      have hB'_pos : 0 < B' := lt_of_lt_of_le zero_lt_one (le_max_right B 1)
      have hH_pos : 0 < S.H := S.H_pos
      obtain ⟨N₁, hN₁⟩ := (Metric.tendsto_atTop.mp hh_tendsto) (S.H / 2) (by positivity)
      obtain ⟨N₂, hN₂⟩ :=
        (Metric.tendsto_atTop.mp hℓ_tendsto) ((S.H / 2) / B') (by positivity)
      refine ⟨max N₁ N₂, fun n hn => ?_⟩
      have hn₁ : N₁ ≤ n := le_trans (le_max_left _ _) hn
      have hn₂ : N₂ ≤ n := le_trans (le_max_right _ _) hn
      have hℓ_pos : 0 < ℓ_seq n := (h_bounds n).2.1
      have hh_gt : S.H / 2 < h_seq n := by
        have hd := hN₁ n hn₁
        rw [Real.dist_eq, abs_lt] at hd
        linarith
      have hℓ_lt : ℓ_seq n < (S.H / 2) / B' := by
        have hd := hN₂ n hn₂
        rw [Real.dist_eq, sub_zero, abs_of_pos hℓ_pos] at hd
        exact hd
      have hmul_lt : ℓ_seq n * B' < S.H / 2 := (lt_div_iff₀ hB'_pos).mp hℓ_lt
      have hmul_lt' : B' * ℓ_seq n < S.H / 2 := by linarith
      have hdiv_gt : B' < h_seq n / ℓ_seq n :=
        (lt_div_iff₀ hℓ_pos).mpr (lt_trans hmul_lt' hh_gt)
      exact le_trans (le_max_left B 1) hdiv_gt.le
    have hexh : ∀ R_exh : ℝ, 0 < R_exh → ∃ N_exh : ℕ, ∀ n ≥ N_exh, ∀ Z : ℂ,
        ‖Z‖ ≤ R_exh →
          (x_seq n : ℂ) + (h_seq n : ℂ) * Complex.I + (ℓ_seq n : ℂ) * Z ∈
            S.toExpStripData.D_strip := by
      intro R_exh hR_pos
      have hH_pos : 0 < S.H := S.H_pos
      obtain ⟨N₁, hN₁⟩ := (Metric.tendsto_atTop.mp hh_tendsto) (S.H / 2) (by positivity)
      obtain ⟨N₂, hN₂⟩ :=
        (Metric.tendsto_atTop.mp hℓ_tendsto) ((S.H / 2) / R_exh) (by positivity)
      obtain ⟨N₃, hN₃⟩ := (Filter.tendsto_atTop_atTop.mp hgap_tendsto) (R_exh + 1)
      refine ⟨max (max N₁ N₂) N₃, fun n hn Z hZ => ?_⟩
      have hn₁ : N₁ ≤ n := le_trans (le_trans (le_max_left _ _) (le_max_left _ _)) hn
      have hn₂ : N₂ ≤ n := le_trans (le_trans (le_max_right _ _) (le_max_left _ _)) hn
      have hn₃ : N₃ ≤ n := le_trans (le_max_right _ _) hn
      have hℓ_pos : 0 < ℓ_seq n := (h_bounds n).2.1
      have hh_gt : S.H / 2 < h_seq n := by
        have hd := hN₁ n hn₁
        rw [Real.dist_eq, abs_lt] at hd
        linarith
      have hℓ_lt : ℓ_seq n < (S.H / 2) / R_exh := by
        have hd := hN₂ n hn₂
        rw [Real.dist_eq, sub_zero, abs_of_pos hℓ_pos] at hd
        exact hd
      have hmul_lt : ℓ_seq n * R_exh < S.H / 2 := (lt_div_iff₀ hR_pos).mp hℓ_lt
      have hgap_ge : R_exh + 1 ≤ (S.H - h_seq n) / ℓ_seq n := hN₃ n hn₃
      have hgap_mul : (R_exh + 1) * ℓ_seq n ≤ S.H - h_seq n :=
        (le_div_iff₀ hℓ_pos).mp hgap_ge
      have hgap_mul' : ℓ_seq n * R_exh + ℓ_seq n ≤ S.H - h_seq n := by linarith
      have hZ_im : |Z.im| ≤ R_exh := le_trans (Complex.abs_im_le_norm Z) hZ
      rw [abs_le] at hZ_im
      change |((x_seq n : ℂ) + (h_seq n : ℂ) * Complex.I + (ℓ_seq n : ℂ) * Z).im| < S.H
      have him_eq :
          ((x_seq n : ℂ) + (h_seq n : ℂ) * Complex.I + (ℓ_seq n : ℂ) * Z).im =
            h_seq n + ℓ_seq n * Z.im := by simp
      rw [him_eq, abs_lt]
      have hlo : -(ℓ_seq n * R_exh) ≤ ℓ_seq n * Z.im := by nlinarith [hZ_im.1]
      have hhi : ℓ_seq n * Z.im ≤ ℓ_seq n * R_exh := by nlinarith [hZ_im.2]
      constructor <;> linarith
    rcases hProf with ⟨hf_conv, hq_conv⟩ | ⟨hf_conv, hq_conv⟩
    · let seq : ExpSequenceData S.toExpStripData .firstField :=
        { x_seq := x_seq
          h_seq := h_seq
          ℓ_seq := ℓ_seq
          m_seq := m_seq
          c₀ := c₀
          c₀_ne_zero := hc₀
          ℓ_pos := fun n => (h_bounds n).2.1
          m_pos := fun n => (h_bounds n).2.2
          m_tendsto := hm_tendsto
          b_tendsto := hb_tendsto
          h_div_ℓ_tendsto := hh_div_ℓ
          exhausts_ℂ := hexh
          f_conv := hf_conv
          q_conv := hq_conv }
      have hDeep := hDeepFin S P_S .firstField seq α₀ δ_b hα₁ hα₂ hδ₁ hδ₂
        (fun n => (h_bounds n).1) hh_tendsto hℓ_tendsto hgap_tendsto hCone
      exact corridor_tracking_and_bypass_contradiction
        S.toExpStripData hX_S P_S .firstField seq hDeep M_first
    · let seq : ExpSequenceData S.toExpStripData .secondField :=
        { x_seq := x_seq
          h_seq := h_seq
          ℓ_seq := ℓ_seq
          m_seq := m_seq
          c₀ := c₀
          c₀_ne_zero := hc₀
          ℓ_pos := fun n => (h_bounds n).2.1
          m_pos := fun n => (h_bounds n).2.2
          m_tendsto := hm_tendsto
          b_tendsto := hb_tendsto
          h_div_ℓ_tendsto := hh_div_ℓ
          exhausts_ℂ := hexh
          f_conv := hf_conv
          q_conv := hq_conv }
      have hDeep := hDeepFin S P_S .secondField seq α₀ δ_b hα₁ hα₂ hδ₁ hδ₂
        (fun n => (h_bounds n).1) hh_tendsto hℓ_tendsto hgap_tendsto hCone
      exact corridor_tracking_and_bypass_contradiction
        S.toExpStripData hX_S P_S .secondField seq hDeep M_second
  · intro E x_seq h_seq ℓ_seq m_seq c₀ α₀ C_ℓ C_cone hc₀ hα₁ hα₂ hCℓ hCcone
      h_bounds hh_tendsto hb_tendsto hlog_tendsto hProf hCone
    have hX_E : IsExpObstructionStrip E.toExpStripData := hStripEnt E
    obtain ⟨P_E⟩ := hChord E.toExpStripData hX_E
    have hm_tendsto : Filter.Tendsto m_seq Filter.atTop Filter.atTop := by
      rw [Filter.tendsto_atTop_atTop]
      intro B
      let B' : ℝ := max B 0
      obtain ⟨N₁, hN₁⟩ := (Filter.tendsto_atTop_atTop.mp hb_tendsto) (B' * C_ℓ)
      refine ⟨N₁, fun n hn => ?_⟩
      have hℓ_le : ℓ_seq n ≤ C_ℓ := (h_bounds n).2.2.1
      have hm_pos : 0 < m_seq n := (h_bounds n).2.2.2
      have hprod_ge : B' * C_ℓ ≤ ℓ_seq n * m_seq n := hN₁ n hn
      have hprod_le : ℓ_seq n * m_seq n ≤ C_ℓ * m_seq n :=
        mul_le_mul_of_nonneg_right hℓ_le hm_pos.le
      have hB'_le : B' ≤ m_seq n := by nlinarith
      exact le_trans (le_max_left B 0) hB'_le
    have hh_div_ℓ : Filter.Tendsto (fun n => h_seq n / ℓ_seq n) Filter.atTop Filter.atTop := by
      rw [Filter.tendsto_atTop_atTop]
      intro B
      let B' : ℝ := max B 0
      have hB'_nonneg : 0 ≤ B' := le_max_right B 0
      obtain ⟨N₁, hN₁⟩ := (Filter.tendsto_atTop_atTop.mp hh_tendsto) (B' * C_ℓ)
      refine ⟨N₁, fun n hn => ?_⟩
      have hℓ_pos : 0 < ℓ_seq n := (h_bounds n).2.1
      have hℓ_le : ℓ_seq n ≤ C_ℓ := (h_bounds n).2.2.1
      have hh_ge : B' * C_ℓ ≤ h_seq n := hN₁ n hn
      have hmul_le : B' * ℓ_seq n ≤ h_seq n :=
        le_trans (mul_le_mul_of_nonneg_left hℓ_le hB'_nonneg) hh_ge
      have hdiv_ge : B' ≤ h_seq n / ℓ_seq n := (le_div_iff₀ hℓ_pos).mpr hmul_le
      exact le_trans (le_max_left B 0) hdiv_ge
    have hexh : ∀ R_exh : ℝ, 0 < R_exh → ∃ N_exh : ℕ, ∀ n ≥ N_exh, ∀ Z : ℂ,
        ‖Z‖ ≤ R_exh →
          (x_seq n : ℂ) + (h_seq n : ℂ) * Complex.I + (ℓ_seq n : ℂ) * Z ∈
            E.toExpStripData.D_strip :=
      fun _ _ => ⟨0, fun _ _ _ _ => Set.mem_univ _⟩
    rcases hProf with ⟨hf_conv, hq_conv⟩ | ⟨hf_conv, hq_conv⟩
    · let seq : ExpSequenceData E.toExpStripData .firstField :=
        { x_seq := x_seq
          h_seq := h_seq
          ℓ_seq := ℓ_seq
          m_seq := m_seq
          c₀ := c₀
          c₀_ne_zero := hc₀
          ℓ_pos := fun n => (h_bounds n).2.1
          m_pos := fun n => (h_bounds n).2.2.2
          m_tendsto := hm_tendsto
          b_tendsto := hb_tendsto
          h_div_ℓ_tendsto := hh_div_ℓ
          exhausts_ℂ := hexh
          f_conv := hf_conv
          q_conv := hq_conv }
      have hDeep := hDeepEnt E P_E .firstField seq α₀ C_ℓ C_cone hα₁ hα₂ hCℓ hCcone
        (fun n => ⟨(h_bounds n).1, (h_bounds n).2.2.1⟩) hh_tendsto hlog_tendsto hCone
      exact corridor_tracking_and_bypass_contradiction
        E.toExpStripData hX_E P_E .firstField seq hDeep M_first
    · let seq : ExpSequenceData E.toExpStripData .secondField :=
        { x_seq := x_seq
          h_seq := h_seq
          ℓ_seq := ℓ_seq
          m_seq := m_seq
          c₀ := c₀
          c₀_ne_zero := hc₀
          ℓ_pos := fun n => (h_bounds n).2.1
          m_pos := fun n => (h_bounds n).2.2.2
          m_tendsto := hm_tendsto
          b_tendsto := hb_tendsto
          h_div_ℓ_tendsto := hh_div_ℓ
          exhausts_ℂ := hexh
          f_conv := hf_conv
          q_conv := hq_conv }
      have hDeep := hDeepEnt E P_E .secondField seq α₀ C_ℓ C_cone hα₁ hα₂ hCℓ hCcone
        (fun n => ⟨(h_bounds n).1, (h_bounds n).2.2.1⟩) hh_tendsto hlog_tendsto hCone
      exact corridor_tracking_and_bypass_contradiction
        E.toExpStripData hX_E P_E .secondField seq hDeep M_second

theorem universal_disk_log_deficit : UniversalDiskLogDeficitProp :=
by
  have h_s1 : ∀ (U : Set ℂ) (f : ℂ → ℂ), IsOpen U →
      DifferentiableOn ℂ f U →
      (∀ z ∈ U, f z = 0 → deriv f z ≠ 0) →
      ∀ (c : ℂ) (R : ℝ), 0 < R → Metric.closedBall c R ⊆ U →
      ∃ (S : Finset ℂ) (g : ℂ → ℂ),
        (∀ a : ℂ, a ∈ S ↔ a ∈ Metric.closedBall c R ∧ f a = 0) ∧
        DifferentiableOn ℂ g U ∧
        (∀ z ∈ Metric.closedBall c R, g z ≠ 0) ∧
        (∀ z ∈ U, f z = g z * ∏ a ∈ S, (z - a)) := by
    intro U f hU hf hsimple c R _hR hSub
    let Z : Set ℂ := Metric.closedBall c R ∩ f ⁻¹' ({0} : Set ℂ)
    have hZ_closed : IsClosed Z :=
      (hf.continuousOn.mono hSub).preimage_isClosed_of_isClosed isClosed_closedBall isClosed_singleton
    have hZ_comp : IsCompact Z :=
      IsCompact.of_isClosed_subset (isCompact_closedBall c R) hZ_closed Set.inter_subset_left
    have hZ_iso : ∀ a ∈ Z, ∃ r : ℝ, 0 < r ∧ ∀ w ∈ Metric.ball a r, w ∈ Z → w = a := by
      intro a ha
      have haU : a ∈ U := hSub ha.1
      have hfa : f a = 0 := ha.2
      have hU_nhds : U ∈ nhds a := hU.mem_nhds haU
      have hd_diff : DifferentiableOn ℂ (dslope f a) U :=
        (Complex.differentiableOn_dslope hU_nhds).mpr hf
      have hd_cont : ContinuousAt (dslope f a) a :=
        (hd_diff.differentiableAt hU_nhds).continuousAt
      have hd_ne : dslope f a a ≠ 0 := by
        rw [dslope_same]
        exact hsimple a haU hfa
      obtain ⟨r, hr_pos, hr_ball⟩ := Metric.eventually_nhds_iff_ball.mp (hd_cont.eventually_ne hd_ne)
      refine ⟨r, hr_pos, fun w hw_ball hwZ => ?_⟩
      have hfw : f w = 0 := hwZ.2
      have h_eq : (w - a) * dslope f a w = 0 := by
        simpa [smul_eq_mul, hfw, hfa] using sub_smul_dslope f a w
      exact sub_eq_zero.mp ((mul_eq_zero.mp h_eq).resolve_right (hr_ball w hw_ball))
    choose r hr_pos hr_iso using fun (a : Z) => hZ_iso a.1 a.2
    obtain ⟨t, ht_cover⟩ :=
      hZ_comp.elim_finite_subcover (fun a : Z => Metric.ball (a : ℂ) (r a))
        (fun _ => Metric.isOpen_ball)
        (fun x hx => Set.mem_iUnion.mpr ⟨⟨x, hx⟩, Metric.mem_ball_self (hr_pos ⟨x, hx⟩)⟩)
    have hZ_sub : Z ⊆ ↑(t.image Subtype.val) := by
      intro x hx
      obtain ⟨a, ha_mem⟩ := Set.mem_iUnion₂.mp (ht_cover hx)
      rw [Finset.coe_image, Set.mem_image]
      exact ⟨a, ha_mem.1, (hr_iso a x ha_mem.2 hx).symm⟩
    have hZ_fin : Z.Finite := (t.image Subtype.val).finite_toSet.subset hZ_sub
    let S : Finset ℂ := hZ_fin.toFinset
    have hS_mem : ∀ a : ℂ, a ∈ S ↔ a ∈ Metric.closedBall c R ∧ f a = 0 := by
      intro a
      exact hZ_fin.mem_toFinset
    have h_div : ∀ T : Finset ℂ, (∀ a ∈ T, a ∈ U ∧ f a = 0) →
        ∃ g : ℂ → ℂ, DifferentiableOn ℂ g U ∧ ∀ z ∈ U, f z = g z * ∏ a ∈ T, (z - a) := by
      intro T
      induction T using Finset.induction_on with
      | empty =>
        intro _
        exact ⟨f, hf, fun z _ => by simp⟩
      | @insert b T hb_not_mem ih =>
        intro hT_all
        obtain ⟨g_T, hg_T_holo, hg_T_eq⟩ :=
          ih (fun a ha => hT_all a (Finset.mem_insert_of_mem ha))
        obtain ⟨hbU, hfb⟩ := hT_all b (Finset.mem_insert_self b T)
        have hprod_ne : (∏ a ∈ T, (b - a)) ≠ 0 := by
          rw [Finset.prod_ne_zero_iff]
          intro a ha
          exact sub_ne_zero.mpr (fun h_eq => hb_not_mem (h_eq ▸ ha))
        have hg_T_b : g_T b = 0 := by
          have h1 := hg_T_eq b hbU
          rw [hfb] at h1
