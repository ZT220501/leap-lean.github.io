      have h_mem_A : ρ_star + δ / 2 ∈ A :=
        ⟨by linarith, by linarith, hu_sum_r⟩
      have h_le_sup : ρ_star + δ / 2 ≤ ρ_star := le_csSup hA_bdd h_mem_A
      linarith

    rw [hρ_eq_R] at hS_holo hS_maps_ρstar h_rinv_ρstar h_real_rinv_ρstar h_sum_complex
    refine ⟨{
      v_inv := S
      v_inv_holo := hS_holo
      v_inv_zero := by
