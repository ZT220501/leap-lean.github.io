          linarith
        refine hz_nhdsW.frequently (Filter.Frequently.of_forall (fun m => ?_))
        apply hg_eq_S_real
        have hm1 : (1 : ℝ) ≤ (m : ℝ) + 1 := by linarith [Nat.cast_nonneg (α := ℝ) m]
        have hstep_pos : 0 < (δ / 4) / ((m : ℝ) + 1) := by positivity
        have hstep_le : (δ / 4) / ((m : ℝ) + 1) ≤ δ / 4 := div_le_self (by positivity) hm1
        exact ⟨by linarith [hx₀_mem_Ioo.1], by dsimp [x₀]; linarith⟩
      have h_iter_eq : ∀ k : ℕ, iteratedDeriv k g (x₀ : ℂ) = iteratedDeriv k S (x₀ : ℂ) := by
        intro k
        induction k with
        | zero => simpa using hg_ev_S.self_of_nhds
        | succ k ih =>
          have h_ev_k : iteratedDeriv k g =ᶠ[nhds (x₀ : ℂ)] iteratedDeriv k S := by
            clear ih
