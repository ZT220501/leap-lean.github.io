        _ ≤ d ^ α₁ := Real.rpow_le_rpow_of_exponent_ge hd_pos hd_le_one hα₁_lt.le
    have hone_le_term : 1 ≤ (ε / r) * d ^ α₁ := by
      rw [hεr_eq, div_mul_eq_mul_div, one_le_div hd_pos]
      calc
