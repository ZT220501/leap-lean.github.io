        have h1 := MeasureTheory.integral_mono h_int_ind (hZ_tilde_int_sq N_hor) h_ind_le
        rw [MeasureTheory.integral_indicator_const (lam ^ 2) (hE_fin_meas N_hor), smul_eq_mul] at h1
