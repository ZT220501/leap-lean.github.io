    have h4 : 0 ≤ |Real.log ‖P.ℓ_slice j y‖| := abs_nonneg _
    have habs : |Real.log ‖Complex.sin (P.d0 j y)‖| ≤ M ^ σ := by linarith
    rcases abs_le.mp habs with ⟨hlo, hhi⟩
    have hpos : 0 < ‖Complex.sin (P.d0 j y)‖ :=
