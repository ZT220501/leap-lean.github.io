              iterDerivYT (α + β - r) r (pderivD f ∘ σ m) p) =
          (∑ r ∈ Finset.range (β + 1), (β.choose r : ℂ) * term (r + 1)) +
          (∑ r ∈ Finset.range (β + 1), (β.choose r : ℂ) * term r) := by
        rw [← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl (fun r hr => ?_)
        have hr_le : r ≤ β := Nat.lt_succ_iff.mp (Finset.mem_range.mp hr)
        have h_congr : iterDerivYT (α + β - r) r (pderivD f ∘ σ m) p =
            iterDerivYT (α + β - r) r (fun q => pderivD g q - (m : ℂ) * pderivA g q) p :=
          h_it_congr hUm hp (α + β - r) r (fun q hq => (h_shear_pderiv hU hf m hq).2)
        rw [h_congr, h_it_sub_cmul hUm hp (α + β - r) r (m : ℂ) hgD_holo hgA_holo,
          ← (k_iterYT_step hUm hg_holo (α + β - r) r p hp).2.1,
          ← (k_iterYT_step hUm hg_holo (α + β - r) r p hp).1]
        have h_idx1 : α + β - r = α + (β + 1) - (r + 1) := by omega
        have h_idx2 : α + β - r + 1 = α + (β + 1) - r := by omega
        have h_exp1 : β - r = β + 1 - (r + 1) := by omega
        have h_exp2 : β + 1 - r = (β - r) + 1 := by omega
        dsimp only [term]
        rw [← h_idx1, ← h_idx2, ← h_exp1, h_exp2, pow_succ]
        ring
