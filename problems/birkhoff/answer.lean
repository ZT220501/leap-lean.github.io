    obtain ⟨NB2, hNB2⟩ := h_ev_B
    refine ⟨max (max C_core.N_coarse N_d_eta) (max Nd2 NB2), fun n hn Z hZ J hJ T' hT' => ?_⟩
    have hn_c : C_core.N_coarse ≤ n :=
      le_trans (le_trans (le_max_left _ _) (le_max_left _ _)) hn
    have hn_eta : N_d_eta ≤ n :=
