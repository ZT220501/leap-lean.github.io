          constructor <;> linarith
      · have hs_le : s_k ≤ ρ k.succ := min_le_right _ _
        have hp1 := abs_le.mp hp_R.1
        have hp2 := abs_le.mp hp_R.2
        have hρ_pos := hρ k.succ
        refine ⟨?_, ?_⟩
        · simp only [q_j, Complex.add_re, Complex.ofReal_re, Complex.mul_re, Complex.I_re,
