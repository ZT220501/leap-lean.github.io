      rw [hg_eq i z hz_V, hΓ_reg_eq z (hH₀_DH (hV_sub hz_V).2) hz_not_E]
  let ω_vec : Fin 2 → ℂ → ℂ := fun i =>
    if i = 0 then fun z => -(C.c : ℂ) * (f z)⁻¹ ^ 2 * Complex.sin (ϕ z)
    else fun z => (C.c : ℂ) * (f z)⁻¹ ^ 2 * Complex.cos (ϕ z)
  have hslice_deriv_ω : ∀ z ∈ D_H, z ∉ M.E_disc → ∀ i : Fin 2,
      deriv (fun w => M.Γ_slice w i) z = ω_vec i z := by
    intro z hzD hzE i
    have hreg := M.slice_reg z hzD hzE
    have hd_plus := hreg.2.2.2.2.2.2.1
    have hd_minus := hreg.2.2.2.2.2.2.2.1
    rw [← ha_reg z hzD hzE, ← hf_reg z hzD hzE] at hd_plus hd_minus
    have ha_ne := ha_ne_zero z hzD
    have hf_ne : f z ≠ 0 := by rw [hf_reg z hzD hzE]; exact hreg.2.2.2.2.2.1
    have hexp_pos : Complex.exp (ϕ z * Complex.I) = a z := by
      rw [mul_comm]; exact hexp_ϕ z hzD
    have hexp_neg : Complex.exp (-ϕ z * Complex.I) = (a z)⁻¹ := by
      have : -ϕ z * Complex.I = -(ϕ z * Complex.I) := by ring
      rw [this, Complex.exp_neg, hexp_pos]
    have hsin : Complex.sin (ϕ z) = ((a z)⁻¹ - a z) * Complex.I / 2 := by
      rw [Complex.sin, hexp_neg, hexp_pos]
    have hcos : Complex.cos (ϕ z) = (a z + (a z)⁻¹) / 2 := by
      rw [Complex.cos, hexp_pos, hexp_neg]
    let d₀ := deriv (fun w => M.Γ_slice w 0) z
    let d₁ := deriv (fun w => M.Γ_slice w 1) z
    change d₀ + Complex.I * d₁ = Complex.I * C.c * a z / f z ^ 2 at hd_plus
    change d₀ - Complex.I * d₁ = -Complex.I * C.c / (a z * f z ^ 2) at hd_minus
    fin_cases i
    · change d₀ = -C.c * (f z)⁻¹ ^ 2 * Complex.sin (ϕ z)
      rw [hsin]
      have h2d₀ : 2 * d₀ = Complex.I * C.c * a z / f z ^ 2 + (-Complex.I * C.c / (a z * f z ^ 2)) := by
        linear_combination hd_plus + hd_minus
      have htarget : 2 * (-C.c * (f z)⁻¹ ^ 2 * (((a z)⁻¹ - a z) * Complex.I / 2)) =
          Complex.I * C.c * a z / f z ^ 2 + (-Complex.I * C.c / (a z * f z ^ 2)) := by
        field_simp [ha_ne, hf_ne]
        ring
      linear_combination (h2d₀ - htarget) / 2
    · change d₁ = C.c * (f z)⁻¹ ^ 2 * Complex.cos (ϕ z)
      rw [hcos]
      have h2Id₁ : 2 * Complex.I * d₁ =
          Complex.I * C.c * a z / f z ^ 2 - (-Complex.I * C.c / (a z * f z ^ 2)) := by
        linear_combination hd_plus - hd_minus
      have htarget : 2 * Complex.I * (C.c * (f z)⁻¹ ^ 2 * ((a z + (a z)⁻¹) / 2)) =
          Complex.I * C.c * a z / f z ^ 2 - (-Complex.I * C.c / (a z * f z ^ 2)) := by
        field_simp [ha_ne, hf_ne]
        ring
      have hdiff : 2 * Complex.I * (d₁ - C.c * (f z)⁻¹ ^ 2 * ((a z + (a z)⁻¹) / 2)) = 0 := by
        linear_combination h2Id₁ - htarget
      have h2I_ne : (2 : ℂ) * Complex.I ≠ 0 := mul_ne_zero two_ne_zero Complex.I_ne_zero
      exact sub_eq_zero.mp ((mul_eq_zero.mp hdiff).resolve_left h2I_ne)
  have hΓ_hasDeriv : ∀ s₀ ∈ D_H, f s₀ ≠ 0 → ∀ i : Fin 2,
      HasDerivAt (fun z => Γ z i) (ω_vec i s₀) s₀ := by
    intro s₀ hs₀ hfs₀ i
    obtain ⟨r_E, hrE_pos, hrE_sub, hrE_disj⟩ := M.E_disc_isolated s₀ hs₀
    have hf_cont : ContinuousAt f s₀ :=
      (hf_holo.differentiableAt (hDH_open.mem_nhds hs₀)).continuousAt
    obtain ⟨r_f, hrf_pos, hrf_ne⟩ :=
      Metric.eventually_nhds_iff_ball.mp (hf_cont.eventually_ne hfs₀)
    let r₁ : ℝ := min r_E r_f
    have hr₁_pos : 0 < r₁ := lt_min hrE_pos hrf_pos
    let B : Set ℂ := Metric.ball s₀ r₁
    have hB_sub : B ⊆ D_H := (Metric.ball_subset_ball (min_le_left _ _)).trans hrE_sub
    have hB_f_ne : ∀ z ∈ B, f z ≠ 0 :=
      fun z hz => hrf_ne z (Metric.ball_subset_ball (min_le_right _ _) hz)
    have hω_holo : DifferentiableOn ℂ (ω_vec i) B := by
      have hfB : DifferentiableOn ℂ f B := hf_holo.mono hB_sub
      have hϕB : DifferentiableOn ℂ ϕ B := hϕ_holo.mono hB_sub
      have hfinv2 : DifferentiableOn ℂ (fun z => (f z)⁻¹ ^ 2) B := (hfB.inv hB_f_ne).pow 2
      fin_cases i
      · exact (hfinv2.const_mul (-(C.c : ℂ))).mul
          (Complex.differentiable_sin.comp_differentiableOn hϕB)
      · exact (hfinv2.const_mul (C.c : ℂ)).mul
          (Complex.differentiable_cos.comp_differentiableOn hϕB)
    obtain ⟨G_i, hGi_within⟩ := Convex.exists_forall_hasDerivWithinAt (convex_ball s₀ r₁) hω_holo
    have hGi_deriv : ∀ z ∈ B, HasDerivAt G_i (ω_vec i z) z := fun z hz =>
      (hGi_within z hz).hasDerivAt (Metric.isOpen_ball.mem_nhds hz)
    have hB_punct_open : IsOpen (B \ {s₀}) := Metric.isOpen_ball.sdiff isClosed_singleton
    have hB_punct_pre : IsPreconnected (B \ {s₀}) :=
      h_vpath B {s₀} Metric.isOpen_ball (convex_ball s₀ r₁) (Set.countable_singleton s₀)
    have hdiff_punct : ∀ z ∈ B \ {s₀},
        HasDerivAt (fun w => M.Γ_slice w i - G_i w) 0 z := by
      intro z ⟨hzB, hzs₀⟩
      have hz_not_E : z ∉ M.E_disc :=
        hrE_disj z (Metric.ball_subset_ball (min_le_left _ _) hzB)
          (Set.mem_compl_singleton_iff.mp hzs₀)
      have hanal : AnalyticAt ℂ (fun w => M.Γ_slice w i) z := by
        fin_cases i
        · exact (M.slice_reg z (hB_sub hzB) hz_not_E).1
        · exact (M.slice_reg z (hB_sub hzB) hz_not_E).2.1
      have hd1 : HasDerivAt (fun w => M.Γ_slice w i) (ω_vec i z) z := by
        rw [← hslice_deriv_ω z (hB_sub hzB) hz_not_E i]
        exact hanal.differentiableAt.hasDerivAt
      have h0 : ω_vec i z - ω_vec i z = 0 := sub_self _
      exact h0 ▸ hd1.sub (hGi_deriv z hzB)
    let z₁ : ℂ := s₀ + ((r₁ / 2 : ℝ) : ℂ)
    have hz₁_punct : z₁ ∈ B \ {s₀} := by
      refine ⟨?_, ?_⟩
      · rw [Metric.mem_ball, dist_eq_norm]
        have : z₁ - s₀ = ((r₁ / 2 : ℝ) : ℂ) := by dsimp [z₁]; ring
        rw [this, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (by linarith)]; linarith
      · intro heq
        rw [Set.mem_singleton_iff] at heq
        have : ((r₁ / 2 : ℝ) : ℂ) = 0 := by dsimp [z₁] at heq; linear_combination heq
        have : r₁ / 2 = 0 := Complex.ofReal_eq_zero.mp this
        linarith
    let C_i : ℂ := M.Γ_slice z₁ i - G_i z₁
    have hΓ_punct_eq : (fun z => Γ z i) =ᶠ[nhdsWithin s₀ {s₀}ᶜ] (fun z => G_i z + C_i) := by
      filter_upwards [mem_nhdsWithin_of_mem_nhds (Metric.ball_mem_nhds s₀ hr₁_pos),
        self_mem_nhdsWithin] with z hzB hzNe
      have hzp : z ≠ s₀ := Set.mem_compl_singleton_iff.mp hzNe
      have hz_not_E : z ∉ M.E_disc :=
        hrE_disj z (Metric.ball_subset_ball (min_le_left _ _) hzB) hzp
      have hc : M.Γ_slice z i - G_i z = C_i :=
        hB_punct_open.is_const_of_deriv_eq_zero hB_punct_pre
          (fun w hw => (hdiff_punct w hw).differentiableAt.differentiableWithinAt)
          (fun w hw => (hdiff_punct w hw).deriv) ⟨hzB, hzNe⟩ hz₁_punct
      rw [congr_fun (hΓ_reg_eq z (hB_sub hzB) hz_not_E) i]
      linear_combination hc
    have hGi_anal : AnalyticAt ℂ (fun z => G_i z + C_i) s₀ := by
      have hG_holo : DifferentiableOn ℂ (fun z => G_i z + C_i) B :=
        fun z hz => ((hGi_deriv z hz).add_const C_i).differentiableAt.differentiableWithinAt
      exact ((Complex.analyticOnNhd_iff_differentiableOn Metric.isOpen_ball).mpr hG_holo)
        s₀ (Metric.mem_ball_self hr₁_pos)
    have hΓ_nhds_eq : (fun z => Γ z i) =ᶠ[nhds s₀] (fun z => G_i z + C_i) :=
      ((hΓ_NF i hs₀).eventuallyEq_nhdsNE_iff_eventuallyEq_nhds hGi_anal.meromorphicNFAt).mp
        hΓ_punct_eq
    exact ((hGi_deriv s₀ (Metric.mem_ball_self hr₁_pos)).add_const C_i).congr_of_eventuallyEq
      hΓ_nhds_eq
  let Z_f : Set ℂ := { s ∈ D_H | f s = 0 }
  have hf_anal_on : AnalyticOnNhd ℂ f D_H :=
    (Complex.analyticOnNhd_iff_differentiableOn hDH_open).mpr hf_holo
  have hZf_iso : ∀ z ∈ Z_f, ∃ r : ℝ, 0 < r ∧ ∀ w ∈ Metric.ball z r, w ≠ z → f w ≠ 0 := by
    intro z ⟨hzD, hfz⟩
    rcases (hf_anal_on z hzD).eventually_eq_zero_or_eventually_ne_zero with hev0 | hevNe
    · exfalso
      have hf0 : f 0 = 0 :=
        hf_anal_on.eqOn_zero_of_preconnected_of_eventuallyEq_zero hDH_pre hzD hev0 h0_in_DH
      have hpos := (hf_real_pos 0).1
      simp [hf0] at hpos
    · obtain ⟨r, hr_pos, hr_ne⟩ :=
        Metric.eventually_nhds_iff_ball.mp (eventually_nhdsWithin_iff.mp hevNe)
      exact ⟨r, hr_pos, fun w hw hwz => hr_ne w hw (Set.mem_compl_singleton_iff.mpr hwz)⟩
  have hZf_cnt : Z_f.Countable := by
    classical
    let rad : ℂ → ℝ := fun z => if hz : z ∈ Z_f then (hZf_iso z hz).choose else 1
    have hrad_pos : ∀ z ∈ Z_f, 0 < rad z := by
      intro z hz
      have h_eq : rad z = (hZf_iso z hz).choose := dif_pos hz
      rw [h_eq]; exact (hZf_iso z hz).choose_spec.1
    have hrad_ne : ∀ z ∈ Z_f, ∀ w ∈ Metric.ball z (rad z), w ≠ z → f w ≠ 0 := by
      intro z hz
      have h_eq : rad z = (hZf_iso z hz).choose := dif_pos hz
      rw [h_eq]; exact (hZf_iso z hz).choose_spec.2
    refine Set.PairwiseDisjoint.countable_of_isOpen (s := fun z => Metric.ball z (rad z / 2))
      ?_ (fun _ _ => Metric.isOpen_ball)
      (fun z hz => ⟨z, Metric.mem_ball_self (half_pos (hrad_pos z hz))⟩)
    intro z₁ hz₁ z₂ hz₂ hne
    change Disjoint (Metric.ball z₁ (rad z₁ / 2)) (Metric.ball z₂ (rad z₂ / 2))
    rw [Set.disjoint_iff]
    rintro w ⟨hw₁, hw₂⟩
    rw [Metric.mem_ball] at hw₁ hw₂
    have hdist : dist z₁ z₂ < rad z₁ / 2 + rad z₂ / 2 := by
      have := dist_triangle z₁ w z₂
      rw [dist_comm z₁ w] at this
      linarith
    rcases le_total (rad z₁) (rad z₂) with hle | hle
    · exact hrad_ne z₂ hz₂ z₁ (Metric.mem_ball.mpr (by linarith)) hne hz₁.2
    · exact hrad_ne z₁ hz₁ z₂ (Metric.mem_ball.mpr (by rw [dist_comm]; linarith)) hne.symm hz₂.2
  let D_reg : Set ℂ := D_H \ Z_f
  have hD_reg_eq : D_reg = { s ∈ D_H | f s ≠ 0 } := by
    ext s; simp [D_reg, Z_f]
  have hD_reg_open : IsOpen D_reg := by
    rw [hD_reg_eq]
    exact hf_holo.continuousOn.isOpen_inter_preimage hDH_open isOpen_ne
  have hD_reg_pre : IsPreconnected D_reg := h_vpath D_H Z_f hDH_open hDH_conv hZf_cnt
  have h0_in_reg : (0 : ℂ) ∈ D_reg := by
    rw [hD_reg_eq]; exact ⟨h0_in_DH, hf_base_ne_zero 0 h0_in_base⟩
  have h2pi_in_base : (2 * (Real.pi : ℂ)) ∈ horizStrip M.s_base := by
    simpa using hreal_in_base (2 * Real.pi)
  have hΓ_0_2pi : Γ (0 + 2 * Real.pi) = Γ 0 := by
    rw [zero_add, hΓ_base_eq _ h2pi_in_base, hΓ_base_eq 0 h0_in_base]
    have h2pi_2s0 : (0 : ℂ) ∈ horizStrip (2 * C.s₀) := hbase_sub_2s0 h0_in_base
    have hϕ_2pi : C.ϕ_ℂ (2 * Real.pi) = C.ϕ_ℂ 0 + 2 * Real.pi := by
      simpa using C.ϕ_ℂ_quasiperiodic 0 h2pi_2s0
    let w₀ : ℂ := C.ϕ_ℂ 0
    have hw₀_mem : w₀ ∈ horizStrip (2 * C.s_h) := C.ϕ_ℂ_maps_to 0 h2pi_2s0
    have hsh_open : IsOpen (horizStrip (2 * C.s_h)) := hstrip_open (2 * C.s_h)
    have hh_2pi : C.h_ℂ (w₀ + 2 * Real.pi) = C.h_ℂ w₀ := C.h_ℂ_periodic w₀ hw₀_mem
    have hdh_2pi : deriv C.h_ℂ (w₀ + 2 * Real.pi) = deriv C.h_ℂ w₀ := by
      have hw₀_shift : w₀ + 2 * (Real.pi : ℂ) ∈ horizStrip (2 * C.s_h) := by
        simp only [horizStrip, Set.mem_ofPred_eq, Complex.add_im, h2pi_im, add_zero] at hw₀_mem ⊢
        exact hw₀_mem
      have hd1 := ((C.h_ℂ_holo.differentiableAt (hsh_open.mem_nhds hw₀_shift)).hasDerivAt).comp_add_const
        w₀ (2 * (Real.pi : ℂ))
      have hd2 := (C.h_ℂ_holo.differentiableAt (hsh_open.mem_nhds hw₀_mem)).hasDerivAt
      have hev : (fun w => C.h_ℂ (w + 2 * Real.pi)) =ᶠ[nhds w₀] C.h_ℂ := by
        filter_upwards [hsh_open.mem_nhds hw₀_mem] with w hw
        exact C.h_ℂ_periodic w hw
      exact (hd1.congr_of_eventuallyEq hev.symm).unique hd2
    funext i
    fin_cases i <;>
      simp [glancingBoundaryCurve, hϕ_2pi, w₀, hh_2pi, hdh_2pi,
        Complex.cos_add_two_pi, Complex.sin_add_two_pi]
  have hΓ_0_conj : ∀ i : Fin 2, starRingEnd ℂ (Γ 0 i) = Γ 0 i := by
    intro i
    rw [hΓ_base_eq 0 h0_in_base]
    let w₀ : ℂ := C.ϕ_ℂ 0
    have hw₀_real : w₀ = (C.ϕ 0 : ℂ) := by simpa [w₀] using C.ϕ_ℂ_real 0
    have hw₀_conj : starRingEnd ℂ w₀ = w₀ := by rw [hw₀_real]; simp
    have hw₀_mem : w₀ ∈ horizStrip (2 * C.s_h) := C.ϕ_ℂ_maps_to 0 (hbase_sub_2s0 h0_in_base)
    have hsh_open : IsOpen (horizStrip (2 * C.s_h)) := hstrip_open (2 * C.s_h)
    have hdh_conj : starRingEnd ℂ (deriv C.h_ℂ w₀) = deriv C.h_ℂ w₀ := by
      have hd1 : HasDerivAt (fun w => starRingEnd ℂ (C.h_ℂ (starRingEnd ℂ w)))
