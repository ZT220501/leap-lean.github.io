        𝔰_init (starRingEnd ℂ y, starRingEnd ℂ t) = starRingEnd ℂ (𝔰_init (y, t))) := by
    have h2pi_pos : 0 < 2 * Real.pi := Real.two_pi_pos
    have h2pi_im : ((2 : ℂ) * (Real.pi : ℂ)).im = 0 := by norm_cast
    have hstrip_open : ∀ H : ℝ, IsOpen (horizStrip H) := fun H =>
      isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const
    have h2s0_open : IsOpen (horizStrip (2 * C.s₀)) := hstrip_open (2 * C.s₀)
    have hϕ_diff : Differentiable ℝ C.ϕ := C.ϕ_smooth.differentiable (by decide)
    have hϕ2 : ContDiff ℝ ((1 : WithTop ℕ∞) + 1) C.ϕ := C.ϕ_smooth.of_le (by decide)
    have hdϕ_cont : Continuous (deriv C.ϕ) := hϕ2.deriv'.continuous
    have hdϕ_per : Function.Periodic (deriv C.ϕ) (2 * Real.pi) := by
      intro x
      have hd1 := (hϕ_diff (x + 2 * Real.pi)).hasDerivAt.comp_add_const x (2 * Real.pi)
      have hd2 := (hϕ_diff x).hasDerivAt.add_const (2 * Real.pi)
