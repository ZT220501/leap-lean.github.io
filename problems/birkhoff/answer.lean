            C_mul * (C_pow5 * (9 / (q : ℝ)) ^ 5) * J_R.C_jet_R) *
          (C_mul * C_inv * C_inv) := by positivity
      have h1 := mul_le_mul_of_nonneg_right h2q_le hNQ_nn
      have h2 : (q : ℝ) * (C_mul *
          (C_mul * (C_pow5 * (9 / (q : ℝ)) ^ 5) * J_R.C_jet_R +
            C_mul * (C_pow5 * (9 / (q : ℝ)) ^ 5) * J_R.C_jet_R) *
