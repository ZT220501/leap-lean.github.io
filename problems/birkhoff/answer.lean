        fun q hq => not_ne_iff.mp (fun hne => h_no_nz ⟨q, hq, hne⟩)
      obtain ⟨q_nz, hq_nz_mem, hq_nz⟩ := G₂.den_ne_zero p hp_W2
      exact hq_nz (hBall2D_id p p (G₂.rad p) η₁ (G₂.den p) (G₂.den_holo p hp_W2)
