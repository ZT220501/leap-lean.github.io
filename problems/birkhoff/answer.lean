          S.c * ‖Complex.sin (P.d0 j y)‖ * (r_y * ‖deriv (sliceImpactSeq S P.N j.val) y‖) := by
        rw [norm_mul, norm_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hc_pos,
