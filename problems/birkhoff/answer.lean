    obtain ⟨c₀, hc₀_bot, hc₀_left⟩ := h_c0
    obtain ⟨c₁, hc₁_bot, hc₁_right⟩ := h_c1
    obtain ⟨c₂, hc₂_top, hc₂_right⟩ := h_c2
