    · rcases hTile 0 with ⟨hρ0_pos, hAsp0_lo, _, _, _, _, _, _⟩
      rcases hSq_coords (σ.head hσ) (c 0) (ρ 0) hσ_head with ⟨_, ⟨him1, _⟩⟩
      linarith
    · rcases hTile (Fin.last m) with ⟨hρL_pos, hAspL_lo, _, _, _, _, _, _⟩
      rcases hSq_coords (σ.getLast hσ) (c (Fin.last m)) (ρ (Fin.last m)) hσ_last with
        ⟨_, ⟨_, him2⟩⟩
      linarith
    · have hSum' : (∑ k : Fin (m + 1), ρ k) ≤ 512 * ((L_a2 + 3 - (L_b - 3) : ℕ) : ℝ) := by
        linarith
      exact hσ_len.trans (mul_le_mul_of_nonneg_left hSum' hC_len.le)
    · intro w hw
      refine ⟨hσ_mod_lo w hw, ?_⟩
      rcases Set.mem_iUnion.mp (hσ_sub hw) with ⟨k, hwk⟩
      exact (hBallProps2 k).2.1 w (hSq_sub_ball w (c k) (ρ k) (hTile k).1 hwk)

theorem epoch_bands_to_polygonal_mesh (F : ℂ → ℂ) (lam : ℝ)
    (hF_holo : DifferentiableOn ℂ F criticalLowerHalfPlane)
    (hlam : 1 ≤ lam)
    (hMesh : FirstFieldMeshHypotheses F lam)
    (hShadow : BadTileShadowBoundProp)
    (hRoute : GoodChainRoutingProp)
    (hDual : GridFourEightDualityProp) :
    HighModulusPolygonalMesh F lam :=
by
  rcases hMesh.epochs_and_witnesses with ⟨L₀, E, hL₀, hE_pos, hE_dense, hE_wit⟩
  obtain ⟨M_lat, C_shad, hM_lat_gt, hC_shad, hSh_raw⟩ :=
    hShadow 1024 2048 (L₀ + 3) (by norm_num) (by norm_num) (by linarith)
  have hM_lat : 0 < M_lat := by linarith
  have hOpenH : IsOpen criticalLowerHalfPlane :=
    isOpen_lt Complex.continuous_im continuous_const
  have hSh : DyadicShadowBoundAt L₀ M_lat C_shad := by
    intro p d τ M_top_loc U₀ H_def F_loc N x_T d_T ρ_T hd hτ hτd hU₀ hH hTiles hF_loc hBox hWit hBalls
    refine hSh_raw p d τ M_top_loc U₀ H_def F_loc criticalLowerHalfPlane N x_T d_T ρ_T
      hd hτ hτd hU₀ hH hTiles hOpenH ?_ hF_loc hBox hWit hBalls
    intro z hz
    show z.im < 0
    linarith [hz.2.1]
  rcases hRoute with ⟨C_route, C_len, hC_route, hC_len, hRt_raw⟩
  have hRt : DyadicChainRoutingAt C_route C_len := hRt_raw
  let C_small : ℝ := min (1 / 4) (min (1 / (16384 * C_shad)) (1 / (6144 * C_len)))
  have hC_small : 0 < C_small := by positivity
  have hC_small_le_quarter : C_small ≤ 1 / 4 := min_le_left _ _
  have hC_small_le_shad : C_small ≤ 1 / (16384 * C_shad) :=
    le_trans (min_le_right _ _) (min_le_left _ _)
  have hC_small_le_len : C_small ≤ 1 / (6144 * C_len) :=
    le_trans (min_le_right _ _) (min_le_right _ _)
  have hShad_mul_small : C_shad * C_small ≤ 1 / 16384 := by
    have h1 : C_shad * C_small ≤ C_shad * (1 / (16384 * C_shad)) :=
      mul_le_mul_of_nonneg_left hC_small_le_shad hC_shad.le
    have h2 : C_shad * (1 / (16384 * C_shad)) = 1 / 16384 := by
      field_simp [hC_shad.ne']
    linarith
  have hLen_le_inv_small : C_len * 6144 ≤ 1 / C_small := by
    have h1 : (C_len * 6144) * C_small ≤ (6144 * C_len) * (1 / (6144 * C_len)) := by
      have hcomm : C_len * 6144 = 6144 * C_len := mul_comm _ _
      rw [hcomm]
      exact mul_le_mul_of_nonneg_left hC_small_le_len (by positivity)
    have h2 : (6144 * C_len) * (1 / (6144 * C_len)) = 1 := by
      field_simp [hC_len.ne']
    have h3 : ((C_len * 6144) * C_small) * (1 / C_small) ≤ 1 * (1 / C_small) :=
      mul_le_mul_of_nonneg_right (h1.trans_eq h2) (by positivity)
    have h4 : ((C_len * 6144) * C_small) * (1 / C_small) = C_len * 6144 := by
      field_simp [hC_small.ne']
    linarith
  rcases doubling_epoch_band_schedule F lam L₀ M_lat C_small E
      hlam hL₀ hM_lat hC_small hMesh.upper_growth hE_pos hE_dense hE_wit with
    ⟨u, ε_seq, M_top, L_a, L_b, hu_step, hu_top, hε_bounds, hε_anti, hε_zero,
     hεu_ge, hL_sep, hL_span, hM_bounds, hBox_unif, hWit_curr, hWit_prev⟩
  let A : ℕ → ℝ := fun j => ((2 : ℝ) ^ (L_a j + 1))⁻¹
  let B : ℕ → ℝ := fun j => ((2 : ℝ) ^ (L_b j - 1))⁻¹
  let η : ℕ → ℝ := fun j => (C_route + 2) * ε_seq j
  let B_low : ℕ → ℝ := fun j => (lam - ε_seq j) * u j
  let T_good : ℕ → ℝ := fun j => (M_top j - B_low j) / 2
  let U₀_j : ℕ → ℝ := fun j => C_small * (ε_seq j * u j)
  have inv_two_pow_lt : ∀ m n : ℕ, n < m → ((2 : ℝ) ^ m)⁻¹ < ((2 : ℝ) ^ n)⁻¹ := by
    intro m n hnm
    exact inv_strictAnti₀ (by positivity) (pow_lt_pow_right₀ (by norm_num) hnm)
  have inv_two_pow_le : ∀ m n : ℕ, n ≤ m → ((2 : ℝ) ^ m)⁻¹ ≤ ((2 : ℝ) ^ n)⁻¹ := by
    intro m n hnm
    rcases eq_or_lt_of_le hnm with rfl | hlt
    · exact le_rfl
    · exact (inv_two_pow_lt m n hlt).le
  have hAB : ∀ j : ℕ, 0 < A j ∧ A j < B j ∧ B (j + 1) < A j := by
    intro j
    have hj0 := hL_sep j
    have hj1 := hL_sep (j + 1)
    refine ⟨by positivity, ?_, ?_⟩
    · exact inv_two_pow_lt (L_a j + 1) (L_b j - 1) (by omega)
    · exact inv_two_pow_lt (L_b (j + 1) - 1) (L_a j + 1) (by omega)
  have hLb_ge_succ : ∀ j : ℕ, j + 1 ≤ L_b j := by
    intro j
    induction j with
    | zero =>
      have := (hL_sep 0).1
      omega
    | succ j ih =>
      have h1 := (hL_sep j).2.1
      have h2 := (hL_sep j).2.2
      omega
  have hB_zero : Filter.Tendsto B Filter.atTop (nhds 0) := by
    have h_geom : Filter.Tendsto (fun j : ℕ => (2⁻¹ : ℝ) ^ j) Filter.atTop (nhds 0) :=
      tendsto_pow_atTop_nhds_zero_iff.mpr (by norm_num)
    refine tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds h_geom
      (fun j => by positivity) (fun j => ?_)
    have h1 : B j = (2⁻¹ : ℝ) ^ (L_b j - 1) := by
      dsimp [B]
      rw [inv_pow]
    rw [h1]
    have hj := hLb_ge_succ j
    exact pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega)
  have hη_pos : ∀ j : ℕ, 0 < η j := by
    intro j
    have := (hε_bounds j).1
    positivity
  have hη_anti : Antitone η := by
    intro i j hij
    exact mul_le_mul_of_nonneg_left (hε_anti hij) (by positivity)
  have hη_zero : Filter.Tendsto η Filter.atTop (nhds 0) := by
    have h1 := hε_zero.const_mul (C_route + 2)
    rwa [mul_zero] at h1
  have hBadExcl := bad_dyadic_barriers_exclusion F hF_holo L₀ M_lat C_shad hL₀ hC_shad hSh
  have hGoodRt := good_dyadic_chains_to_routed_curves F hF_holo C_route C_len hC_route hC_len hRt
  have h_epoch_j : ∀ j : ℕ,
      ∃ (γ σL σR : List ℂ) (hγ : γ ≠ []) (hσL : σL ≠ []) (hσR : σR ≠ []),
        (∀ w ∈ meshPolyTrace γ,
          -4 ≤ w.re ∧ w.re ≤ 4 ∧ A j < -w.im ∧ -w.im < B j) ∧
        (γ.head hγ).re ≤ -2.5 ∧
        2.5 ≤ (γ.getLast hγ).re ∧
        (∀ w ∈ meshPolyTrace σL,
          -2.4 < w.re ∧ w.re < -1.1 ∧ 0 < -w.im) ∧
        B j ≤ -(σL.head hσL).im ∧
        -(σL.getLast hσL).im ≤ A (j + 2) ∧
        (∀ w ∈ meshPolyTrace σR,
          1.1 < w.re ∧ w.re < 2.4 ∧ 0 < -w.im) ∧
        B j ≤ -(σR.head hσR).im ∧
        -(σR.getLast hσR).im ≤ A (j + 2) ∧
        meshPolyLength γ ≤ Real.exp (η j * u j) ∧
        meshPolyLength σL ≤ Real.exp (η j * u j) ∧
        meshPolyLength σR ≤ Real.exp (η j * u j) ∧
        (∀ w ∈ meshPolyTrace γ ∪ meshPolyTrace σL ∪ meshPolyTrace σR,
          Real.exp ((lam - η j) * u j) ≤ ‖F w‖ ∧
          ‖F w‖ ≤ Real.exp ((lam + η j) * u j)) := by
    intro j
    have hu_ge_one : 1 ≤ u j := (hu_step j).1
    have hε_pos : 0 < ε_seq j := (hε_bounds j).1
    let X : ℝ := ε_seq j * u j
    have hX_pos : 0 < X := mul_pos hε_pos (by linarith)
    have hU₀_nonneg : 0 ≤ U₀_j j := by dsimp [U₀_j]; positivity
    have hM_lo : lam * u j ≤ M_top j := (hM_bounds j).1
    have hM_hi : M_top j ≤ lam * u j + C_small * X := (hM_bounds j).2
    have hDiff_lo : X ≤ M_top j - B_low j := by
      dsimp [X, B_low]
      linarith
    have hDiff_pos : 0 < M_top j - B_low j := lt_of_lt_of_le hX_pos hDiff_lo
    have hT_pos : 0 < T_good j := by dsimp [T_good]; linarith
    have hT_le_X : T_good j ≤ X := by
      dsimp [T_good, B_low, X]
      nlinarith [hC_small_le_quarter, hX_pos]
    have hBlow_eq : M_top j - 2 * T_good j = B_low j := by
      dsimp [T_good]
      ring
    have hRatio_le : U₀_j j / (M_top j - B_low j) ≤ C_small := by
      rw [div_le_iff₀ hDiff_pos]
      have : C_small * X ≤ C_small * (M_top j - B_low j) :=
        mul_le_mul_of_nonneg_left hDiff_lo hC_small.le
      simpa [U₀_j, X] using this
    have hShad_ratio : C_shad * (U₀_j j / (M_top j - B_low j)) ≤ 1 / 16384 := by
      calc C_shad * (U₀_j j / (M_top j - B_low j))
          ≤ C_shad * C_small := mul_le_mul_of_nonneg_left hRatio_le hC_shad.le
        _ ≤ 1 / 16384 := hShad_mul_small
    have hSep0 := hL_sep j
    have hSep1 := hL_sep (j + 1)
    have hSep2 := hL_sep (j + 2)
    have hLb_eq : L_b (j + 1 + 1) = L_b (j + 2) := rfl
    have hLa_le_La2 : L_a j + 16 ≤ L_a (j + 2) := by omega
    have hLb_lt_La : L_b j < L_a j := by omega
    have hLb_lt_La2 : L_b j < L_a (j + 2) := by omega
    have hLb3_lt_La23 : L_b j - 3 < L_a (j + 2) + 3 := by omega
    
    have hNoBadVert : ¬ DyadicBadVertChain (-3) 12 (L_b j) (L_a j)
        (meshTileIsGood F (B_low j)) := by
      refine hBadExcl.1 (L_b j) (L_a j) (M_top j) (B_low j) (U₀_j j)
        hLb_lt_La hU₀_nonneg hDiff_pos (by linarith) ?_
      intro x₀ hx₀
      rcases hWit_curr j x₀ hx₀ with ⟨p, δ_w, hδ1, hδ2, hp, _, hF_wit, hF_box⟩
      exact ⟨p, δ_w, hδ1, hδ2, hp, hF_wit, hF_box⟩
    have hGoodHoriz : DyadicGoodHorizChain (-3) 12 (L_b j) (L_a j)
        (meshTileIsGood F (M_top j - 2 * T_good j)) := by
      rw [hBlow_eq]
      rcases (graded_dyadic_grid_dichotomy hDual (-3) 12 (L_b j) (L_a j)
          (by norm_num) hLb_lt_La (meshTileIsGood F (B_low j))).1 with hG | hB
      · exact hG
      · exact False.elim (hNoBadVert hB)
    have hBox_horiz : ∀ z : ℂ, |z.re| ≤ 5 →
        ((2 : ℝ) ^ (L_a j + 1))⁻¹ ≤ -z.im → -z.im ≤ 2 * ((2 : ℝ) ^ L_b j)⁻¹ →
        ‖F z‖ ≤ Real.exp (M_top j) := by
      intro z hz_re hz_lo hz_hi
      have h_lo' : ((2 : ℝ) ^ (L_a (j + 2) + 6))⁻¹ ≤ -z.im :=
        le_trans (inv_two_pow_le (L_a (j + 2) + 6) (L_a j + 1) (by omega)) hz_lo
      have h_pow_pos : (0 : ℝ) ≤ ((2 : ℝ) ^ L_b j)⁻¹ := by positivity
      have h_hi' : -z.im ≤ 16 * ((2 : ℝ) ^ L_b j)⁻¹ := by linarith
      exact hBox_unif j z hz_re h_lo' h_hi'
    rcases hGoodRt.1 (L_b j) (L_a j) (M_top j) (T_good j)
        hSep0.1 hLb_lt_La hT_pos hBox_horiz hGoodHoriz with
      ⟨γ, hγ, hγ_box, hγ_head, hγ_last, hγ_len, hγ_mod⟩
    
    have hNoBadLatL : ¬ DyadicBadLatChain (-2) 1 (L_b j - 3) (L_a (j + 2) + 3)
        (meshTileIsGood F (B_low j)) := by
      refine hBadExcl.2 (-2) (L_b j - 3) (L_a (j + 2) + 3) (M_top j) (B_low j) (U₀_j j)
        hLb3_lt_La23 hU₀_nonneg hDiff_pos (by linarith) ?_
      rcases hWit_prev j (-2 + 1 / 4) (by norm_num) with
        ⟨p, δ_w, hδ1, hp, hδ_small, hF_wit, hF_box⟩
      have hδ_pos : 0 < δ_w := lt_trans (by positivity) hδ1
      have hδ_small' : (L₀ + 2) * δ_w ≤ 1 / 8 := by nlinarith
      exact ⟨p, δ_w, hδ1, hp, hδ_small', hF_wit, hF_box⟩
    have hGoodVertL : DyadicGoodVertChain (-2) 1 (L_b j - 3) (L_a (j + 2) + 3)
        (meshTileIsGood F (M_top j - 2 * T_good j)) := by
      rw [hBlow_eq]
      rcases (graded_dyadic_grid_dichotomy hDual (-2) 1 (L_b j - 3) (L_a (j + 2) + 3)
          (by norm_num) hLb3_lt_La23 (meshTileIsGood F (B_low j))).2 with hG | hB
      · exact hG
      · exact False.elim (hNoBadLatL hB)
    rcases hGoodRt.2 (-2) (L_b j) (L_a (j + 2)) (M_top j) (T_good j)
        (by norm_num) hSep0.1 hLb_lt_La2 hT_pos (hBox_unif j) hGoodVertL with
      ⟨σL, hσL, hσL_box, hσL_head, hσL_last, hσL_len, hσL_mod⟩
    
    have hNoBadLatR : ¬ DyadicBadLatChain (3 / 2) 1 (L_b j - 3) (L_a (j + 2) + 3)
        (meshTileIsGood F (B_low j)) := by
      refine hBadExcl.2 (3 / 2) (L_b j - 3) (L_a (j + 2) + 3) (M_top j) (B_low j) (U₀_j j)
        hLb3_lt_La23 hU₀_nonneg hDiff_pos (by linarith) ?_
      rcases hWit_prev j (3 / 2 + 1 / 4) (by norm_num) with
        ⟨p, δ_w, hδ1, hp, hδ_small, hF_wit, hF_box⟩
      have hδ_pos : 0 < δ_w := lt_trans (by positivity) hδ1
      have hδ_small' : (L₀ + 2) * δ_w ≤ 1 / 8 := by nlinarith
      exact ⟨p, δ_w, hδ1, hp, hδ_small', hF_wit, hF_box⟩
    have hGoodVertR : DyadicGoodVertChain (3 / 2) 1 (L_b j - 3) (L_a (j + 2) + 3)
        (meshTileIsGood F (M_top j - 2 * T_good j)) := by
      rw [hBlow_eq]
      rcases (graded_dyadic_grid_dichotomy hDual (3 / 2) 1 (L_b j - 3) (L_a (j + 2) + 3)
          (by norm_num) hLb3_lt_La23 (meshTileIsGood F (B_low j))).2 with hG | hB
      · exact hG
      · exact False.elim (hNoBadLatR hB)
    rcases hGoodRt.2 (3 / 2) (L_b j) (L_a (j + 2)) (M_top j) (T_good j)
        (by norm_num) hSep0.1 hLb_lt_La2 hT_pos (hBox_unif j) hGoodVertR with
      ⟨σR, hσR, hσR_box, hσR_head, hσR_last, hσR_len, hσR_mod⟩
    
    have hCap_le_exp : (C_len * 6144) * ((L_a (j + 2) + 3 - (L_b j - 3) : ℕ) : ℝ) ≤
        Real.exp (η j * u j) := by
      have hSpan_le : ((L_a (j + 2) + 3 - (L_b j - 3) : ℕ) : ℝ) ≤ X := hL_span j
      have hInv_le_X : 1 / C_small ≤ X := hεu_ge j
      have hProd1 : (C_len * 6144) * ((L_a (j + 2) + 3 - (L_b j - 3) : ℕ) : ℝ) ≤ X ^ 2 := by
        calc (C_len * 6144) * ((L_a (j + 2) + 3 - (L_b j - 3) : ℕ) : ℝ)
            ≤ (1 / C_small) * X :=
              mul_le_mul hLen_le_inv_small hSpan_le (by positivity) (by positivity)
          _ ≤ X * X := mul_le_mul_of_nonneg_right hInv_le_X hX_pos.le
          _ = X ^ 2 := (sq X).symm
      have hX_le_exp : X + 1 ≤ Real.exp X := Real.add_one_le_exp X
      have hSq_le : X ^ 2 ≤ Real.exp (2 * X) := by
        calc X ^ 2 ≤ (X + 1) ^ 2 := by nlinarith
          _ ≤ (Real.exp X) ^ 2 := sq_le_sq' (by linarith [Real.exp_pos X]) hX_le_exp
          _ = Real.exp X * Real.exp X := sq (Real.exp X)
          _ = Real.exp (X + X) := (Real.exp_add X X).symm
          _ = Real.exp (2 * X) := by ring_nf
      have hExp_mono : Real.exp (2 * X) ≤ Real.exp (η j * u j) := by
        apply Real.exp_le_exp.mpr
        dsimp [η, X]
        nlinarith [hC_route, hX_pos]
      exact hProd1.trans (hSq_le.trans hExp_mono)
    have hNat_sub_le : ((L_a j - L_b j : ℕ) : ℝ) ≤
        ((L_a (j + 2) + 3 - (L_b j - 3) : ℕ) : ℝ) := by
      exact_mod_cast (show L_a j - L_b j ≤ L_a (j + 2) + 3 - (L_b j - 3) by omega)
    have hγ_len_exp : meshPolyLength γ ≤ Real.exp (η j * u j) := by
      calc meshPolyLength γ
          ≤ C_len * (6144 * ((L_a j - L_b j : ℕ) : ℝ)) := hγ_len
        _ = (C_len * 6144) * ((L_a j - L_b j : ℕ) : ℝ) := by ring
        _ ≤ (C_len * 6144) * ((L_a (j + 2) + 3 - (L_b j - 3) : ℕ) : ℝ) :=
            mul_le_mul_of_nonneg_left hNat_sub_le (by positivity)
        _ ≤ Real.exp (η j * u j) := hCap_le_exp
    have hσL_len_exp : meshPolyLength σL ≤ Real.exp (η j * u j) := by
      have h512 : C_len * (512 * ((L_a (j + 2) + 3 - (L_b j - 3) : ℕ) : ℝ)) ≤
          (C_len * 6144) * ((L_a (j + 2) + 3 - (L_b j - 3) : ℕ) : ℝ) := by
        have h_nonneg : (0 : ℝ) ≤ ((L_a (j + 2) + 3 - (L_b j - 3) : ℕ) : ℝ) := by positivity
        nlinarith
      exact hσL_len.trans (h512.trans hCap_le_exp)
    have hσR_len_exp : meshPolyLength σR ≤ Real.exp (η j * u j) := by
      have h512 : C_len * (512 * ((L_a (j + 2) + 3 - (L_b j - 3) : ℕ) : ℝ)) ≤
          (C_len * 6144) * ((L_a (j + 2) + 3 - (L_b j - 3) : ℕ) : ℝ) := by
        have h_nonneg : (0 : ℝ) ≤ ((L_a (j + 2) + 3 - (L_b j - 3) : ℕ) : ℝ) := by positivity
        nlinarith
      exact hσR_len.trans (h512.trans hCap_le_exp)
    have hMod_lo_exp : Real.exp ((lam - η j) * u j) ≤ Real.exp (M_top j - C_route * T_good j) := by
      apply Real.exp_le_exp.mpr
      have hCT : C_route * T_good j ≤ C_route * X :=
        mul_le_mul_of_nonneg_left hT_le_X hC_route.le
      dsimp [η, X] at hCT ⊢
      linarith
    have hMod_hi_exp : Real.exp (M_top j) ≤ Real.exp ((lam + η j) * u j) := by
      apply Real.exp_le_exp.mpr
      dsimp [η, X] at hM_hi ⊢
      nlinarith [hC_small_le_quarter, hC_route, hX_pos]
    refine ⟨γ, σL, σR, hγ, hσL, hσR, hγ_box, hγ_head, hγ_last, ?_, hσL_head, hσL_last,
      ?_, hσR_head, hσR_last, hγ_len_exp, hσL_len_exp, hσR_len_exp, ?_⟩
    · intro w hw
      rcases hσL_box w hw with ⟨h1, h2, h3⟩
      exact ⟨by linarith, by linarith, h3⟩
    · intro w hw
      rcases hσR_box w hw with ⟨h1, h2, h3⟩
      exact ⟨by linarith, by linarith, h3⟩
    · intro w hw
      have hw_raw : Real.exp (M_top j - C_route * T_good j) ≤ ‖F w‖ ∧
          ‖F w‖ ≤ Real.exp (M_top j) := by
        rcases hw with (hwγ | hwL) | hwR
        · exact hγ_mod w hwγ
        · exact hσL_mod w hwL
        · exact hσR_mod w hwR
      exact ⟨hMod_lo_exp.trans hw_raw.1, hw_raw.2.trans hMod_hi_exp⟩
  choose γ σ_left σ_right hγ hσL hσR h_props using h_epoch_j
  exact ⟨⟨u, A, B, η, γ, σ_left, σ_right, hγ, hσL, hσR,
    hu_step, hu_top, hAB, hB_zero, hη_pos, hη_anti, hη_zero, h_props⟩⟩

theorem mesh_primitive_winding_contradiction (F Q_lim : ℂ → ℂ) (lam : ℝ)
    (hF_holo : DifferentiableOn ℂ F criticalLowerHalfPlane)
    (hQ_holo : DifferentiableOn ℂ Q_lim criticalLowerHalfPlane)
    (hF_nonzero : ∃ z ∈ criticalLowerHalfPlane, F z ≠ 0)
    (hF_ode : ∀ z ∈ criticalLowerHalfPlane, deriv (deriv F) z = Q_lim z * F z)
    (hlam : 1 ≤ lam)
    (hPolyMesh : HighModulusPolygonalMesh F lam) :
    False :=
by
  
  have h_len_nonneg : ∀ L : List ℂ, 0 ≤ meshPolyLength L := by
    intro L
    induction L with
    | nil => simp [meshPolyLength]
    | cons a tail ih =>
      cases tail with
      | nil => simp [meshPolyLength]
      | cons b rest =>
        simp only [meshPolyLength]
        linarith [norm_nonneg (b - a)]
  have h_trace_basic : ∀ (L : List ℂ) (hL : L ≠ []),
      IsCompact (meshPolyTrace L) ∧
      L.head hL ∈ meshPolyTrace L ∧
      L.getLast hL ∈ meshPolyTrace L := by
    intro L
    induction L with
    | nil => intro hL; exact absurd rfl hL
    | cons a tail ih =>
      cases tail with
      | nil => intro _; exact ⟨isCompact_singleton, rfl, rfl⟩
      | cons b rest =>
        intro _
        have h_seg_comp : IsCompact (segment ℝ a b) := by
          rw [segment_eq_image]
          exact isCompact_Icc.image (by fun_prop)
        obtain ⟨h_comp_rest, _, h_last_rest⟩ := ih (List.cons_ne_nil b rest)
        exact ⟨h_seg_comp.union h_comp_rest,
          Or.inl (left_mem_segment ℝ a b), Or.inr h_last_rest⟩
  have h_seg_deriv : ∀ (a b : ℂ) (t : ℝ),
      HasDerivAt (fun s : ℝ => (1 - s) • a + s • b) (b - a) t := by
    intro a b t
    have h_eq : (fun s : ℝ => (1 - s) • a + s • b) = (fun s : ℝ => a + s • (b - a)) := by
      ext s; module
    rw [h_eq]
    simpa using ((hasDerivAt_id t).smul_const (b - a)).const_add a
  have h_poly_ftc : ∀ (L : List ℂ) (hL : L ≠ []) (U : Set ℂ) (f F_prim : ℂ → ℂ),
      meshPolyTrace L ⊆ U →
      ContinuousOn f U →
      (∀ w ∈ U, HasDerivAt F_prim (f w) w) →
      mpwcPolyIntegral f L = F_prim (L.getLast hL) - F_prim (L.head hL) := by
    intro L
    induction L with
    | nil => intro hL; exact absurd rfl hL
    | cons a tail ih =>
      cases tail with
      | nil => intro _ _ _ _ _ _ _; simp [mpwcPolyIntegral]
      | cons b rest =>
        intro _ U f F_prim hsub hcont hderiv
        let γ_seg : ℝ → ℂ := fun t => (1 - t) • a + t • b
        have hγ_mem : ∀ t ∈ Set.uIcc (0 : ℝ) 1, γ_seg t ∈ U := by
          intro t ht
          rw [Set.uIcc_of_le zero_le_one] at ht
          exact hsub (Or.inl (by rw [segment_eq_image]; exact ⟨t, ht, rfl⟩))
        have h_comp_deriv : ∀ t ∈ Set.uIcc (0 : ℝ) 1,
            HasDerivAt (fun s => F_prim (γ_seg s)) ((b - a) * f (γ_seg t)) t := by
          intro t ht
          simpa [Function.comp_def, smul_eq_mul] using
            (hderiv (γ_seg t) (hγ_mem t ht)).scomp t (h_seg_deriv a b t)
        have h_int : IntervalIntegrable (fun t => (b - a) * f (γ_seg t))
            MeasureTheory.volume 0 1 := by
          apply ContinuousOn.intervalIntegrable
          exact continuousOn_const.mul (hcont.comp (by fun_prop : Continuous γ_seg).continuousOn
            hγ_mem)
        have h_seg_eq : (∫ t in (0 : ℝ)..(1 : ℝ), (b - a) * f (γ_seg t)) =
            F_prim b - F_prim a := by
          simpa [γ_seg] using intervalIntegral.integral_eq_sub_of_hasDerivAt h_comp_deriv h_int
        have h_rest := ih (List.cons_ne_nil b rest) U f F_prim
          (fun w hw => hsub (Or.inr hw)) hcont hderiv
        simp only [mpwcPolyIntegral]
        rw [h_seg_eq, h_rest]
        simp only [List.head_cons, List.getLast_cons_cons]
        ring
  have h_poly_norm_le : ∀ (L : List ℂ) (f : ℂ → ℂ) (C : ℝ),
      0 ≤ C →
      (∀ w ∈ meshPolyTrace L, ‖f w‖ ≤ C) →
      ‖mpwcPolyIntegral f L‖ ≤ C * meshPolyLength L := by
    intro L
    induction L with
    | nil => intro _ C _ _; simp [mpwcPolyIntegral, meshPolyLength]
    | cons a tail ih =>
      cases tail with
      | nil => intro _ C _ _; simp [mpwcPolyIntegral, meshPolyLength]
      | cons b rest =>
        intro f C hC hbd
        have h_seg_bd : ‖∫ t in (0 : ℝ)..(1 : ℝ), (b - a) * f ((1 - t) • a + t • b)‖ ≤
            (C * ‖b - a‖) * |(1 : ℝ) - 0| := by
          apply intervalIntegral.norm_integral_le_of_norm_le_const
          intro t ht
          rw [Set.uIoc_of_le zero_le_one] at ht
          have hw : (1 - t) • a + t • b ∈ meshPolyTrace (a :: b :: rest) :=
            Or.inl (by rw [segment_eq_image]; exact ⟨t, ⟨le_of_lt ht.1, ht.2⟩, rfl⟩)
          rw [norm_mul, mul_comm C]
          exact mul_le_mul_of_nonneg_left (hbd _ hw) (norm_nonneg _)
        have h_rest := ih f C hC (fun w hw => hbd w (Or.inr hw))
        simp only [mpwcPolyIntegral, meshPolyLength]
        calc ‖(∫ t in (0 : ℝ)..(1 : ℝ), (b - a) * f ((1 - t) • a + t • b)) +
              mpwcPolyIntegral f (b :: rest)‖
            ≤ ‖∫ t in (0 : ℝ)..(1 : ℝ), (b - a) * f ((1 - t) • a + t • b)‖ +
                ‖mpwcPolyIntegral f (b :: rest)‖ := norm_add_le _ _
          _ ≤ (C * ‖b - a‖) * |(1 : ℝ) - 0| + C * meshPolyLength (b :: rest) :=
                add_le_add h_seg_bd h_rest
          _ = C * (‖b - a‖ + meshPolyLength (b :: rest)) := by norm_num; ring
  have h_q4_log : ∀ v : ℂ, 0 < v.re → v.im < 0 →
      Complex.log (Complex.I * v) - Complex.log v = Complex.I * (Real.pi / 2) := by
    intro v hre him
    have hv_ne : v ≠ 0 := by intro h; simp [h] at hre
    have h_abs : |v.arg| < Real.pi / 2 :=
      Complex.abs_arg_lt_pi_div_two_iff.mpr (Or.inl hre)
    have h_neg : v.arg < 0 := Complex.arg_neg_iff.mpr him
    have h_arg_mem : Complex.I.arg + v.arg ∈ Set.Ioc (-Real.pi) Real.pi := by
      rw [Complex.arg_I]
      exact ⟨by linarith [(abs_lt.mp h_abs).1], by linarith [Real.pi_pos]⟩
    rw [Complex.log_mul Complex.I_ne_zero hv_ne h_arg_mem, Complex.log_I]
    ring
  have h_four_corners : ∀ u₀ u₁ u₂ u₃ : ℂ,
      u₀.re < 0 → u₀.im < 0 →
      0 < u₁.re → u₁.im < 0 →
      0 < u₂.re → 0 < u₂.im →
      u₃.re < 0 → 0 < u₃.im →
      (Complex.log (Complex.I * u₁) - Complex.log (Complex.I * u₀)) +
        (Complex.log u₂ - Complex.log u₁) +
        (Complex.log (-Complex.I * u₃) - Complex.log (-Complex.I * u₂)) +
        (Complex.log (-u₀) - Complex.log (-u₃)) = 2 * Real.pi * Complex.I := by
    intro u₀ u₁ u₂ u₃ hu₀r hu₀i hu₁r hu₁i hu₂r hu₂i hu₃r hu₃i
    have h1 := h_q4_log u₁ hu₁r hu₁i
    have h2 := h_q4_log (-Complex.I * u₂) (by simp [hu₂i]) (by simp [hu₂r])
    have h3 := h_q4_log (-u₃) (by simp [hu₃r]) (by simp [hu₃i])
    have h4 := h_q4_log (Complex.I * u₀) (by simp [hu₀i]) (by simp [hu₀r])
    have heq2 : Complex.I * (-Complex.I * u₂) = u₂ := by rw [← mul_assoc]; simp
    have heq3 : Complex.I * (-u₃) = -Complex.I * u₃ := by ring
    have heq4 : Complex.I * (Complex.I * u₀) = -u₀ := by rw [← mul_assoc]; simp
    rw [heq2] at h2; rw [heq3] at h3; rw [heq4] at h4
    linear_combination h1 + h2 + h3 + h4
  
  have hs1_ode : ∃ C₀ : ℂ → ℂ,
      (∀ z ∈ criticalLowerHalfPlane, F z ≠ 0 → HasDerivAt C₀ ((F z)⁻¹ ^ 2) z) ∧
      (∀ c : ℂ, ∃ G : ℂ → ℂ,
        DifferentiableOn ℂ G criticalLowerHalfPlane ∧
        (∃ z ∈ criticalLowerHalfPlane, G z ≠ 0) ∧
        (∀ z ∈ criticalLowerHalfPlane, F z ≠ 0 → G z = F z * (C₀ z - c))) := by
    classical
    have hH_open : IsOpen criticalLowerHalfPlane :=
      isOpen_lt Complex.continuous_im continuous_const
    have hH_conv : Convex ℝ criticalLowerHalfPlane := convex_halfSpace_im_lt 0
    have hH_preconn : IsPreconnected criticalLowerHalfPlane := hH_conv.isPreconnected
    have hF_an : AnalyticOnNhd ℂ F criticalLowerHalfPlane := hF_holo.analyticOnNhd hH_open
    have hQ_an : AnalyticOnNhd ℂ Q_lim criticalLowerHalfPlane := hQ_holo.analyticOnNhd hH_open
    have h_zero_simple : ∀ a ∈ criticalLowerHalfPlane, F a = 0 →
        deriv F a ≠ 0 ∧ deriv (deriv F) a = 0 := by
      intro a ha hFa
      have hF2_zero : deriv (deriv F) a = 0 := by
        rw [hF_ode a ha, hFa, mul_zero]
      refine ⟨?_, hF2_zero⟩
      intro hF1_zero
      have h_ev_ode : deriv (deriv F) =ᶠ[nhds a] Q_lim * F :=
        Filter.eventuallyEq_of_mem (hH_open.mem_nhds ha) (fun z hz => hF_ode z hz)
      have h_iter : ∀ m : ℕ, iteratedDeriv m F a = 0 := by
        intro m
        induction m using Nat.strong_induction_on with
        | h m ih =>
          rcases m with _ | _ | n
          · simpa using hFa
          · simpa [iteratedDeriv_one] using hF1_zero
          · rw [iteratedDeriv_succ', iteratedDeriv_succ', h_ev_ode.iteratedDeriv_eq n]
            rw [iteratedDeriv_mul (hQ_an a ha).contDiffAt (hF_an a ha).contDiffAt]
            apply Finset.sum_eq_zero
            intro i hi
            rw [Finset.mem_range] at hi
            rw [ih (n - i) (by omega), mul_zero]
      have h_ord_top : analyticOrderAt F a = ⊤ := by
        by_contra h_ne
        obtain ⟨m, hm⟩ := ENat.ne_top_iff_exists.mp h_ne
        have h_le : ((m + 1 : ℕ) : ℕ∞) ≤ analyticOrderAt F a :=
          (natCast_le_analyticOrderAt_iff_iteratedDeriv_eq_zero (hF_an a ha)).mpr
            (fun i _ => h_iter i)
        rw [← hm] at h_le
        exact (by omega : ¬ (m + 1 ≤ m)) (Nat.cast_le.mp h_le)
      have h_ev0 : F =ᶠ[nhds a] 0 := analyticOrderAt_eq_top.mp h_ord_top
      obtain ⟨z_nz, hz_nz_mem, hz_nz⟩ := hF_nonzero
      exact hz_nz
        (hF_an.eqOn_of_preconnected_of_eventuallyEq analyticOnNhd_const hH_preconn ha h_ev0
          hz_nz_mem)
    let g1 : ℂ → ℂ → ℂ := fun a => dslope F a
    let g2 : ℂ → ℂ → ℂ := fun a => dslope (g1 a) a
    let g3 : ℂ → ℂ → ℂ := fun a => dslope (g2 a) a
    let rho : ℂ → ℂ → ℂ := fun a z =>
      (-g3 a z * (g1 a z + deriv F a)) / ((deriv F a) ^ 2 * (g1 a z) ^ 2)
    have h_zero_dslope : ∀ a ∈ criticalLowerHalfPlane, F a = 0 →
        DifferentiableOn ℂ (g1 a) criticalLowerHalfPlane ∧
        DifferentiableOn ℂ (g3 a) criticalLowerHalfPlane ∧
        g1 a a = deriv F a ∧
        (∀ z : ℂ, (z - a) * g1 a z = F z) ∧
        (∀ z : ℂ, g1 a z - deriv F a = (z - a) ^ 2 * g3 a z) ∧
        (∀ z : ℂ, z ≠ a → g1 a z ≠ 0 →
          (F z)⁻¹ ^ 2 - (deriv F a)⁻¹ ^ 2 * (z - a)⁻¹ ^ 2 = rho a z) := by
      intro a ha hFa
      obtain ⟨hF1_ne, hF2_zero⟩ := h_zero_simple a ha hFa
      have h_nhds : criticalLowerHalfPlane ∈ nhds a := hH_open.mem_nhds ha
      have hg1_holo : DifferentiableOn ℂ (g1 a) criticalLowerHalfPlane :=
        (Complex.differentiableOn_dslope h_nhds).mpr hF_holo
      have hg2_holo : DifferentiableOn ℂ (g2 a) criticalLowerHalfPlane :=
        (Complex.differentiableOn_dslope h_nhds).mpr hg1_holo
      have hg3_holo : DifferentiableOn ℂ (g3 a) criticalLowerHalfPlane :=
        (Complex.differentiableOn_dslope h_nhds).mpr hg2_holo
      have hg1_same : g1 a a = deriv F a := dslope_same F a
      have hg1_mul : ∀ z : ℂ, (z - a) * g1 a z = F z := by
        intro z
        simpa [g1, smul_eq_mul, hFa] using sub_smul_dslope F a z
      have hg2_mul : ∀ z : ℂ, (z - a) * g2 a z = g1 a z - deriv F a := by
        intro z
        simpa [g2, hg1_same, smul_eq_mul] using sub_smul_dslope (g1 a) a z
      have hF_quad : ∀ z : ℂ, F z = (z - a) * deriv F a + (z - a) ^ 2 * g2 a z := by
        intro z
        linear_combination -(hg1_mul z) - (z - a) * (hg2_mul z)
      have hg2_zero : g2 a a = 0 := by
        have hg2_deriv_holo : DifferentiableOn ℂ (deriv (g2 a)) criticalLowerHalfPlane :=
          hg2_holo.deriv hH_open
        have h_derivF_eq : ∀ z ∈ criticalLowerHalfPlane,
            deriv F z = deriv F a + 2 * (z - a) * g2 a z + (z - a) ^ 2 * deriv (g2 a) z := by
          intro z hz
          have h_sub : HasDerivAt (fun w : ℂ => w - a) 1 z := (hasDerivAt_id z).sub_const a
          have h_lin : HasDerivAt (fun w : ℂ => (w - a) * deriv F a) (1 * deriv F a) z :=
            h_sub.mul_const (deriv F a)
          have h_sq : HasDerivAt (fun w : ℂ => (w - a) ^ 2) (2 * (z - a) ^ 1 * 1) z :=
            h_sub.pow 2
          have hg2_at : HasDerivAt (g2 a) (deriv (g2 a) z) z :=
            ((hg2_holo z hz).differentiableAt (hH_open.mem_nhds hz)).hasDerivAt
          have h_tot : HasDerivAt F
              (1 * deriv F a + (2 * (z - a) ^ 1 * 1 * g2 a z + (z - a) ^ 2 * deriv (g2 a) z)) z :=
            (h_lin.add (h_sq.mul hg2_at)).congr_of_eventuallyEq
              (Filter.Eventually.of_forall (fun w => hF_quad w))
          rw [h_tot.deriv]
          ring
        have hg2_at_a : HasDerivAt (g2 a) (deriv (g2 a) a) a :=
          ((hg2_holo a ha).differentiableAt h_nhds).hasDerivAt
        have hdg2_at_a : HasDerivAt (deriv (g2 a)) (deriv (deriv (g2 a)) a) a :=
          ((hg2_deriv_holo a ha).differentiableAt h_nhds).hasDerivAt
        have h_sub_a : HasDerivAt (fun z : ℂ => z - a) 1 a := (hasDerivAt_id a).sub_const a
        have h_t1 : HasDerivAt (fun _ : ℂ => deriv F a) 0 a := hasDerivAt_const a (deriv F a)
        have h_t2 : HasDerivAt (fun z : ℂ => 2 * (z - a) * g2 a z)
            ((2 * 1) * g2 a a + (2 * (a - a)) * deriv (g2 a) a) a :=
          (h_sub_a.const_mul (2 : ℂ)).mul hg2_at_a
        have h_t3 : HasDerivAt (fun z : ℂ => (z - a) ^ 2 * deriv (g2 a) z)
            ((2 * (a - a) ^ 1 * 1) * deriv (g2 a) a + (a - a) ^ 2 * deriv (deriv (g2 a)) a) a :=
          (h_sub_a.pow 2).mul hdg2_at_a
        have h_rhs_deriv := (h_t1.add h_t2).add h_t3
        have h_ev_dF : (fun z : ℂ => deriv F a + 2 * (z - a) * g2 a z +
            (z - a) ^ 2 * deriv (g2 a) z) =ᶠ[nhds a] deriv F :=
          Filter.eventuallyEq_of_mem h_nhds (fun z hz => (h_derivF_eq z hz).symm)
        have h_d2 := (h_rhs_deriv.congr_of_eventuallyEq h_ev_dF.symm).deriv
        rw [hF2_zero] at h_d2
        have h_two : (2 : ℂ) * g2 a a = 0 := by linear_combination -h_d2
        exact (mul_eq_zero.mp h_two).resolve_left two_ne_zero
      have hg3_mul : ∀ z : ℂ, (z - a) * g3 a z = g2 a z := by
        intro z
        simpa [g3, hg2_zero, smul_eq_mul] using sub_smul_dslope (g2 a) a z
      have hg1_sub : ∀ z : ℂ, g1 a z - deriv F a = (z - a) ^ 2 * g3 a z := by
        intro z
        linear_combination -(hg2_mul z) - (z - a) * (hg3_mul z)
      refine ⟨hg1_holo, hg3_holo, hg1_same, hg1_mul, hg1_sub, ?_⟩
      intro z hz hg1_ne
      have hza_ne : z - a ≠ 0 := sub_ne_zero.mpr hz
      dsimp [rho]
      rw [← hg1_mul z]
      field_simp [hza_ne, hg1_ne, hF1_ne]
      linear_combination -(g1 a z + deriv F a) * (hg1_sub z)
    let R_rect : ℕ → Set ℂ := fun N =>
      {z : ℂ | -((N : ℝ) + 2) < z.re ∧ z.re < (N : ℝ) + 2 ∧
        -((N : ℝ) + 2) < z.im ∧ z.im < -(1 / ((N : ℝ) + 2))}
    let K_rect : ℕ → Set ℂ := fun N =>
      {z : ℂ | -((N : ℝ) + 2) ≤ z.re ∧ z.re ≤ (N : ℝ) + 2 ∧
        -((N : ℝ) + 2) ≤ z.im ∧ z.im ≤ -(1 / ((N : ℝ) + 2))}
    have hR_open : ∀ N : ℕ, IsOpen (R_rect N) := by
      intro N
      exact (isOpen_lt continuous_const Complex.continuous_re).inter
        ((isOpen_lt Complex.continuous_re continuous_const).inter
          ((isOpen_lt continuous_const Complex.continuous_im).inter
            (isOpen_lt Complex.continuous_im continuous_const)))
    have hR_conv : ∀ N : ℕ, Convex ℝ (R_rect N) := by
      intro N
      exact (convex_halfSpace_re_gt (-((N : ℝ) + 2))).inter
        ((convex_halfSpace_re_lt ((N : ℝ) + 2)).inter
          ((convex_halfSpace_im_gt (-((N : ℝ) + 2))).inter
            (convex_halfSpace_im_lt (-(1 / ((N : ℝ) + 2))))))
    have hRK_sub : ∀ N : ℕ, R_rect N ⊆ K_rect N ∧ K_rect N ⊆ criticalLowerHalfPlane := by
      intro N
      refine ⟨fun z hz => ⟨le_of_lt hz.1, le_of_lt hz.2.1, le_of_lt hz.2.2.1, le_of_lt hz.2.2.2⟩,
        fun z hz => ?_⟩
      have hpos : (0 : ℝ) < 1 / ((N : ℝ) + 2) := by positivity
      change z.im < 0
      linarith [hz.2.2.2]
    have hRK_mono : ∀ {N M : ℕ}, N ≤ M → R_rect N ⊆ R_rect M ∧ K_rect N ⊆ K_rect M := by
      intro N M hNM
      have hle : (N : ℝ) ≤ (M : ℝ) := Nat.cast_le.mpr hNM
      have hinv : 1 / ((M : ℝ) + 2) ≤ 1 / ((N : ℝ) + 2) :=
        one_div_le_one_div_of_le (by positivity) (by linarith)
      exact ⟨fun z hz => ⟨by linarith [hz.1], by linarith [hz.2.1],
          by linarith [hz.2.2.1], by linarith [hz.2.2.2]⟩,
        fun z hz => ⟨by linarith [hz.1], by linarith [hz.2.1],
          by linarith [hz.2.2.1], by linarith [hz.2.2.2]⟩⟩
    have h_exh : ∀ z ∈ criticalLowerHalfPlane, ∃ N : ℕ, z ∈ R_rect N := by
      intro z hz
      have hz_im : z.im < 0 := hz
      obtain ⟨N, hN⟩ := exists_nat_gt (max |z.re| (max (-z.im) (1 / (-z.im))))
      have h1 : |z.re| < (N : ℝ) := lt_of_le_of_lt (le_max_left _ _) hN
      have h2 : -z.im < (N : ℝ) :=
        lt_of_le_of_lt (le_trans (le_max_left _ _) (le_max_right _ _)) hN
      have h3 : 1 / (-z.im) < (N : ℝ) :=
        lt_of_le_of_lt (le_trans (le_max_right _ _) (le_max_right _ _)) hN
      have h_inv : 1 / ((N : ℝ) + 2) < -z.im := by
        have hN2 : 1 / (-z.im) < (N : ℝ) + 2 := by linarith
        exact (one_div_lt (by linarith) (by positivity)).mp hN2
      exact ⟨N, by linarith [(abs_lt.mp h1).1], by linarith [(abs_lt.mp h1).2],
        by linarith, by linarith⟩
    have h_exists_base : ∃ z_base ∈ R_rect 0, F z_base ≠ 0 := by
      by_contra h_all
      have h_zero_R0 : ∀ z ∈ R_rect 0, F z = 0 := by
        intro z hz; by_contra hne; exact h_all ⟨z, hz, hne⟩
      have h_negI : (-Complex.I : ℂ) ∈ R_rect 0 := by
        simp [R_rect]; norm_num
      have h_ev0 : F =ᶠ[nhds (-Complex.I)] 0 :=
        Filter.eventuallyEq_of_mem ((hR_open 0).mem_nhds h_negI) h_zero_R0
      obtain ⟨z_nz, hz_nz_mem, hz_nz⟩ := hF_nonzero
      exact hz_nz (hF_an.eqOn_of_preconnected_of_eventuallyEq analyticOnNhd_const hH_preconn
        ((hRK_sub 0).2 ((hRK_sub 0).1 h_negI)) h_ev0 hz_nz_mem)
    obtain ⟨z_base, hz_base_R0, hz_base_ne⟩ := h_exists_base
    have hz_base_R : ∀ N : ℕ, z_base ∈ R_rect N :=
      fun N => (hRK_mono (Nat.zero_le N)).1 hz_base_R0
    have hK_compact : ∀ N : ℕ, IsCompact (K_rect N) := by
      intro N
      let φ : ℝ × ℝ → ℂ := fun p => (p.1 : ℂ) + (p.2 : ℂ) * Complex.I
      have h_eq : K_rect N = φ '' (Set.Icc (-((N : ℝ) + 2)) ((N : ℝ) + 2) ×ˢ
          Set.Icc (-((N : ℝ) + 2)) (-(1 / ((N : ℝ) + 2)))) := by
        ext z
        constructor
        · intro hz
          refine ⟨⟨z.re, z.im⟩, ⟨⟨hz.1, hz.2.1⟩, ⟨hz.2.2.1, hz.2.2.2⟩⟩, ?_⟩
          apply Complex.ext <;> simp [φ]
        · rintro ⟨⟨x, y⟩, ⟨⟨hx1, hx2⟩, ⟨hy1, hy2⟩⟩, rfl⟩
          dsimp at hx1 hx2 hy1 hy2
          change -((N : ℝ) + 2) ≤ ((x : ℂ) + (y : ℂ) * Complex.I).re ∧
            ((x : ℂ) + (y : ℂ) * Complex.I).re ≤ (N : ℝ) + 2 ∧
            -((N : ℝ) + 2) ≤ ((x : ℂ) + (y : ℂ) * Complex.I).im ∧
            ((x : ℂ) + (y : ℂ) * Complex.I).im ≤ -(1 / ((N : ℝ) + 2))
          simp only [Complex.add_re, Complex.ofReal_re, Complex.mul_re, Complex.I_re, mul_zero,
            Complex.ofReal_im, Complex.I_im, mul_one, sub_self, add_zero, Complex.add_im, zero_add,
            Complex.mul_im]
          exact ⟨hx1, hx2, hy1, hy2⟩
      rw [h_eq]
      exact (isCompact_Icc.prod isCompact_Icc).image (by fun_prop)
    have hZ_fin : ∀ N : ℕ, {a ∈ K_rect N | F a = 0}.Finite := by
      intro N
      have h_iso : ∀ w : K_rect N, ∃ r : ℝ, 0 < r ∧
          ∀ z ∈ Metric.ball (w : ℂ) r, F z = 0 → z = (w : ℂ) := by
        intro ⟨w, hwK⟩
        have hwH : w ∈ criticalLowerHalfPlane := (hRK_sub N).2 hwK
        by_cases hFw : F w = 0
        · obtain ⟨hg1_holo, _, hg1_same, hg1_mul, _, _⟩ := h_zero_dslope w hwH hFw
          have hF1_ne : deriv F w ≠ 0 := (h_zero_simple w hwH hFw).1
          have hg1_cont : ContinuousAt (g1 w) w :=
            (hg1_holo w hwH).continuousWithinAt.continuousAt (hH_open.mem_nhds hwH)
          have h_ev : ∀ᶠ z in nhds w, g1 w z ≠ 0 :=
            hg1_cont.eventually_ne (by rw [hg1_same]; exact hF1_ne)
          obtain ⟨r, hr_pos, hr_ball⟩ := Metric.eventually_nhds_iff.mp h_ev
          refine ⟨r, hr_pos, fun z hz hFz => ?_⟩
          have h_prod : (z - w) * g1 w z = 0 := by rw [hg1_mul z, hFz]
          exact sub_eq_zero.mp ((mul_eq_zero.mp h_prod).resolve_right
            (hr_ball (by simpa [dist_eq_norm] using hz)))
        · have hF_cont : ContinuousAt F w :=
            (hF_holo w hwH).continuousWithinAt.continuousAt (hH_open.mem_nhds hwH)
          obtain ⟨r, hr_pos, hr_ball⟩ :=
            Metric.eventually_nhds_iff.mp (hF_cont.eventually_ne hFw)
          exact ⟨r, hr_pos, fun z hz hFz =>
            absurd hFz (hr_ball (by simpa [dist_eq_norm] using hz))⟩
      choose r_fn hr_pos hr_iso using h_iso
      obtain ⟨t, ht_cov⟩ := (hK_compact N).elim_finite_subcover
        (fun w : K_rect N => Metric.ball (w : ℂ) (r_fn w))
        (fun _ => Metric.isOpen_ball)
        (fun z hz => Set.mem_iUnion.mpr ⟨⟨z, hz⟩, Metric.mem_ball_self (hr_pos ⟨z, hz⟩)⟩)
      refine ((t.image Subtype.val).finite_toSet).subset ?_
      intro z ⟨hzK, hFz⟩
      have hz_un := ht_cov hzK
      simp only [Set.mem_iUnion] at hz_un
      obtain ⟨w, hw_t, hz_ball⟩ := hz_un
      have hz_eq : z = (w : ℂ) := hr_iso w z hz_ball hFz
      rw [hz_eq]
      exact Finset.mem_coe.mpr (Finset.mem_image_of_mem Subtype.val hw_t)
    let ZF : ℕ → Finset ℂ := fun N => (hZ_fin N).toFinset
    have h_mem_ZF : ∀ N : ℕ, ∀ b : ℂ, b ∈ ZF N ↔ b ∈ K_rect N ∧ F b = 0 :=
      fun N b => Set.Finite.mem_toFinset (hZ_fin N)
    have hZF_mono : ∀ {N M : ℕ}, N ≤ M → ZF N ⊆ ZF M := by
      intro N M hNM b hb
      rw [h_mem_ZF] at hb ⊢
      exact ⟨(hRK_mono hNM).2 hb.1, hb.2⟩
    have h_sum_pp_deriv : ∀ (S_fin : Finset ℂ) (z : ℂ),
        (∀ b ∈ S_fin, z ≠ b) →
        HasDerivAt (fun w => ∑ b ∈ S_fin, -(deriv F b)⁻¹ ^ 2 * (w - b)⁻¹)
          (∑ b ∈ S_fin, (deriv F b)⁻¹ ^ 2 * (z - b)⁻¹ ^ 2) z := by
      intro S_fin z hz_ne
      have h_term : ∀ b ∈ S_fin,
          HasDerivAt (fun w => -(deriv F b)⁻¹ ^ 2 * (w - b)⁻¹)
            ((deriv F b)⁻¹ ^ 2 * (z - b)⁻¹ ^ 2) z := by
        intro b hb
        have hzb : z - b ≠ 0 := sub_ne_zero.mpr (hz_ne b hb)
        have h1 : HasDerivAt (fun w : ℂ => (w - b)⁻¹) (-1 / (z - b) ^ 2) z :=
          ((hasDerivAt_id z).sub_const b).inv hzb
        have h2 := h1.const_mul (-(deriv F b)⁻¹ ^ 2)
        have h_alg : -(deriv F b)⁻¹ ^ 2 * (-1 / (z - b) ^ 2) =
            (deriv F b)⁻¹ ^ 2 * (z - b)⁻¹ ^ 2 := by
          field_simp [hzb]
        rwa [h_alg] at h2
      exact HasDerivAt.fun_sum h_term
    have h_sum_pp2_diff : ∀ (S_fin : Finset ℂ) (z : ℂ),
        (∀ b ∈ S_fin, z ≠ b) →
        DifferentiableAt ℂ (fun w => ∑ b ∈ S_fin, (deriv F b)⁻¹ ^ 2 * (w - b)⁻¹ ^ 2) z := by
      intro S_fin z hz_ne
      refine DifferentiableAt.fun_sum (fun b hb => ?_)
      have hzb : z - b ≠ 0 := sub_ne_zero.mpr (hz_ne b hb)
      exact (differentiableAt_const _).mul
        (((differentiableAt_id.sub (differentiableAt_const b)).inv hzb).pow 2)
    let S_pp : ℕ → ℂ → ℂ := fun N z =>
      ∑ b ∈ ZF N, -(deriv F b)⁻¹ ^ 2 * (z - b)⁻¹
    let h_reg : ℕ → ℂ → ℂ := fun N z =>
      if z ∈ ZF N then
        rho z z - ∑ b ∈ (ZF N).erase z, (deriv F b)⁻¹ ^ 2 * (z - b)⁻¹ ^ 2
      else
        (F z)⁻¹ ^ 2 - ∑ b ∈ ZF N, (deriv F b)⁻¹ ^ 2 * (z - b)⁻¹ ^ 2
    have hh_reg_holo : ∀ N : ℕ, DifferentiableOn ℂ (h_reg N) (R_rect N) := by
      intro N z₀ hz₀
      have hz₀_K : z₀ ∈ K_rect N := (hRK_sub N).1 hz₀
      have hz₀_H : z₀ ∈ criticalLowerHalfPlane := (hRK_sub N).2 hz₀_K
      suffices DifferentiableAt ℂ (h_reg N) z₀ from this.differentiableWithinAt
      by_cases hFz₀ : F z₀ = 0
      · have hz₀_ZF : z₀ ∈ ZF N := (h_mem_ZF N z₀).mpr ⟨hz₀_K, hFz₀⟩
        obtain ⟨hg1_holo, hg3_holo, hg1_same, hg1_mul, _, h_rat_id⟩ :=
          h_zero_dslope z₀ hz₀_H hFz₀
        have hF1_ne : deriv F z₀ ≠ 0 := (h_zero_simple z₀ hz₀_H hFz₀).1
        have hg1_at : DifferentiableAt ℂ (g1 z₀) z₀ :=
          (hg1_holo z₀ hz₀_H).differentiableAt (hH_open.mem_nhds hz₀_H)
        have hg3_at : DifferentiableAt ℂ (g3 z₀) z₀ :=
          (hg3_holo z₀ hz₀_H).differentiableAt (hH_open.mem_nhds hz₀_H)
        have hrho_at : DifferentiableAt ℂ (rho z₀) z₀ := by
          dsimp [rho]
          have h_den_ne : (deriv F z₀) ^ 2 * (g1 z₀ z₀) ^ 2 ≠ 0 := by
            rw [hg1_same]
            exact mul_ne_zero (pow_ne_zero 2 hF1_ne) (pow_ne_zero 2 hF1_ne)
          exact ((hg3_at.neg).mul (hg1_at.add (differentiableAt_const _))).div
            ((differentiableAt_const _).mul (hg1_at.pow 2)) h_den_ne
        have h_erase_ne : ∀ b ∈ (ZF N).erase z₀, z₀ ≠ b :=
          fun b hb => (Finset.ne_of_mem_erase hb).symm
        have h_loc_diff : DifferentiableAt ℂ
            (fun z => rho z₀ z - ∑ b ∈ (ZF N).erase z₀, (deriv F b)⁻¹ ^ 2 * (z - b)⁻¹ ^ 2) z₀ :=
          hrho_at.sub (h_sum_pp2_diff ((ZF N).erase z₀) z₀ h_erase_ne)
        have h_ev_R : ∀ᶠ z in nhds z₀, z ∈ R_rect N := (hR_open N).mem_nhds hz₀
        have h_ev_g1 : ∀ᶠ z in nhds z₀, g1 z₀ z ≠ 0 :=
          hg1_at.continuousAt.eventually_ne (by rw [hg1_same]; exact hF1_ne)
        have h_ev_er : ∀ᶠ z in nhds z₀, ∀ b ∈ (ZF N).erase z₀, z ≠ b :=
          (Filter.eventually_all_finset ((ZF N).erase z₀)).mpr
            (fun b hb => eventually_ne_nhds (Finset.ne_of_mem_erase hb).symm)
        refine h_loc_diff.congr_of_eventuallyEq ?_
        filter_upwards [h_ev_R, h_ev_g1, h_ev_er] with z hz_R hz_g1 hz_er
        by_cases hzz₀ : z = z₀
        · subst hzz₀
          simp [h_reg, hz₀_ZF]
        · have hFz_ne : F z ≠ 0 := by
            rw [← hg1_mul z]
            exact mul_ne_zero (sub_ne_zero.mpr hzz₀) hz_g1
          have hz_not_ZF : z ∉ ZF N := fun hm => hFz_ne ((h_mem_ZF N z).mp hm).2
          simp only [h_reg, hz_not_ZF, ↓reduceIte]
          rw [← Finset.add_sum_erase _ _ hz₀_ZF]
          linear_combination h_rat_id z hzz₀ hz_g1
      · have hz₀_not_ZF : z₀ ∉ ZF N := fun hm => hFz₀ ((h_mem_ZF N z₀).mp hm).2
        have h_all_ne : ∀ b ∈ ZF N, z₀ ≠ b := by
          intro b hb h_eq
          exact hz₀_not_ZF (h_eq ▸ hb)
        have hF_at : DifferentiableAt ℂ F z₀ :=
          (hF_holo z₀ hz₀_H).differentiableAt (hH_open.mem_nhds hz₀_H)
        have h_loc_diff : DifferentiableAt ℂ
            (fun z => (F z)⁻¹ ^ 2 - ∑ b ∈ ZF N, (deriv F b)⁻¹ ^ 2 * (z - b)⁻¹ ^ 2) z₀ :=
          ((hF_at.inv hFz₀).pow 2).sub (h_sum_pp2_diff (ZF N) z₀ h_all_ne)
        have h_ev_er : ∀ᶠ z in nhds z₀, ∀ b ∈ ZF N, z ≠ b :=
          (Filter.eventually_all_finset (ZF N)).mpr
            (fun b hb => eventually_ne_nhds (h_all_ne b hb))
        refine h_loc_diff.congr_of_eventuallyEq ?_
        filter_upwards [h_ev_er] with z hz_ne
        have hz_not_ZF : z ∉ ZF N := fun hm => hz_ne z hm rfl
        simp [h_reg, hz_not_ZF]
    choose H_raw hH_raw_within using
      fun N => (hR_conv N).exists_forall_hasDerivWithinAt (hh_reg_holo N)
    have hH_raw_deriv : ∀ N : ℕ, ∀ z ∈ R_rect N, HasDerivAt (H_raw N) (h_reg N z) z :=
      fun N z hz => (hH_raw_within N z hz).hasDerivAt ((hR_open N).mem_nhds hz)
    let H_norm : ℕ → ℂ → ℂ := fun N z => H_raw N z - H_raw N z_base
    let C0_loc : ℕ → ℂ → ℂ := fun N z => H_norm N z + S_pp N z - S_pp N z_base
    have hH_norm_deriv : ∀ N : ℕ, ∀ z ∈ R_rect N, HasDerivAt (H_norm N) (h_reg N z) z :=
      fun N z hz => (hH_raw_deriv N z hz).sub_const (H_raw N z_base)
    have hC0_loc_deriv : ∀ N : ℕ, ∀ z ∈ R_rect N, F z ≠ 0 →
        HasDerivAt (C0_loc N) ((F z)⁻¹ ^ 2) z := by
      intro N z hz hFz
      have hz_not_ZF : z ∉ ZF N := fun hm => hFz ((h_mem_ZF N z).mp hm).2
      have hz_ne_b : ∀ b ∈ ZF N, z ≠ b := fun b hb heq => hz_not_ZF (heq ▸ hb)
      have h1 := hH_norm_deriv N z hz
      simp only [h_reg, hz_not_ZF, ↓reduceIte] at h1
      have h2 := h_sum_pp_deriv (ZF N) z hz_ne_b
      have h3 := (h1.add h2).sub_const (S_pp N z_base)
      simpa [C0_loc, S_pp, sub_add_cancel] using h3
    have hC0_compat : ∀ {N M : ℕ}, N ≤ M → ∀ z ∈ R_rect N, F z ≠ 0 →
