            (fun z => deriv W (ξ z) * Complex.exp (W (ξ z) - W (z + (ρ : ℂ) + e_X z))) := by
        intro c hc
        obtain ⟨hξ_holo, hξ_maps, hξ_per, hξ_conj, hξ_deriv⟩ := hCurve c hc
        let ξ := fun z => (z + (ρ : ℂ) + e_X z) + (c : ℂ) * Y z
        have hA_bdd : IsStripBounded p₀ σ' M_W (fun z => deriv W (ξ z)) :=
