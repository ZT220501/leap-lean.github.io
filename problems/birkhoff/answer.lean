      refine hJet_mono (by ring_nf; exact le_refl _)
        (hJet_add hc_step (hJet_mono hRq3_le_invq (hd.2.2.2.2 (j + 1) hj)))
    have hs : IsRealJetPerturb p (9 / (q : ℝ))
        (fun x => 2 * Real.pi / (q : ℝ) + (d (j + 1) x - d j x)) := by
      refine hJet_mono (by ring_nf; exact le_refl _)
        (hJet_add hc_step (hJet_mono hRq3_le_invq (hd.2.2.2.2 j (by omega))))
    have h9q_le2 : 9 / (q : ℝ) ≤ 2 := (div_le_iff₀ hq_pos).mpr (by linarith)
    have hts_le2 : ∀ x : ℝ,
        |2 * Real.pi / (q : ℝ) + (d (j + 2) x - d (j + 1) x)| ≤ 2 ∧
