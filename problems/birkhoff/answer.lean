  let Z_lim_J : ℂ → Fin k → ℂ := fun e i =>
    (((i.succ : ℕ) : ℂ) / (k : ℂ) + ∑ j ∈ Finset.Icc 1 J, e ^ j * b_lim j i.succ) -
    (((i.castSucc : ℕ) : ℂ) / (k : ℂ) + ∑ j ∈ Finset.Icc 1 J, e ^ j * b_lim j i.castSucc)
  let f_t2_lim : ℂ → ℂ := fun e =>
    g_a_pow⁻¹ * (p : ℂ) * e ^ (p - 1) *
      ∑ i : Fin k,
        (-(r_a * (f_p i.succ + f_p i.castSucc) / 2) * Z_lim_J e i +
          (f_p i.succ - f_p i.castSucc) ^ 2 * e ^ p * (Z_lim_J e i)⁻¹)
  
  have h_lim1 : Filter.Tendsto
      (fun τ : ℝ => iteratedDeriv (J - 1) (F_term2 τ) 0 / ((J - 1).factorial : ℂ))
      φ (nhds (iteratedDeriv (J - 1) f_t2_lim 0 / ((J - 1).factorial : ℂ))) :=
    (h_unif_id hρ_e hF_t2_holo hF_t2_unif (J - 1)).div_const _
  
  let rem_exp : ℕ := (2 * d - 1) * p
  have hrem_pos : rem_exp ≠ 0 := by
    dsimp [rem_exp]
    exact Nat.mul_ne_zero (by omega) (by omega)
  have h_exp_id : 2 + 2 * (J - 1) = 3 * p + rem_exp := by
    cases d with
    | zero => omega
    | succ d' =>
        cases p with
        | zero => omega
        | succ p' =>
            dsimp [J, n, rem_exp]
            have h1 : (d' + 1 + 1) * (p' + 1) - 1 = (d' + 1) * (p' + 1) + p' := by
              have : (d' + 1 + 1) * (p' + 1) = (d' + 1) * (p' + 1) + p' + 1 := by ring
              omega
            have h2 : 2 * (d' + 1) - 1 = 2 * d' + 1 := by omega
            rw [h1, h2]
            ring
  have h_t2_ev : ∀ᶠ τ in φ,
      iteratedDeriv (J - 1) (F_term2 τ) 0 =
        (J.factorial : ℂ) * (τ : ℂ) ^ rem_exp *
          (M.U_split (Fin.last J) (a : ℂ) +
            M.V_split (Fin.last J) ((a : ℂ) + ((τ ^ p : ℝ) : ℂ))) := by
    refine hτ_good.mono fun τ ⟨hτ_pos, hτ_M, hdet_ne⟩ => ?_
    have hτ_ne : (τ : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (ne_of_gt hτ_pos)
    have h_univ_eq : Finset.univ.filter (fun q : Fin (J + 1) => (q : ℕ) ≤ J) = Finset.univ := by
      ext q; simp [Nat.le_of_lt_succ q.2]
    let g_t2 : ℂ → ℂ := fun ε =>
      pointCoalescingTermII p (M.ℓ₀ (τ ^ p)) F M.g
        (fun m' => M.x₀ (τ ^ p) m' + ∑ q : Fin (J + 1), ε ^ (q : ℕ) * M.β q (τ ^ p) m') ε
    have hF_rw : F_term2 τ = fun e : ℂ =>
        ((τ : ℂ) ^ 2 * ((τ : ℂ) ^ (3 * p))⁻¹) * g_t2 ((τ : ℂ) ^ 2 * e) := by
      funext e
      dsimp only [F_term2, g_t2]
      have hx := funext (hx_τ_eq_filter J le_rfl τ hτ_pos hτ_M hdet_ne e)
      rw [hx, h_univ_eq]
    rw [hF_rw, h_id_const_mul, h_id_comp_mul]
    simp only [mul_zero]
    have h_s3_2 := (point_model_jet_identities k p J hk hp a F f_p M (τ ^ p) hτ_M).2
      (Fin.last J) (by simp [hJ_pos])
    simp only [Fin.val_last] at h_s3_2
    dsimp only [g_t2]
    rw [h_s3_2]
    have h_pow_τ : (τ : ℂ) ^ 2 * ((τ : ℂ) ^ (3 * p))⁻¹ * ((τ : ℂ) ^ 2) ^ (J - 1) =
        (τ : ℂ) ^ rem_exp := by
      have h_lhs : (τ : ℂ) ^ 2 * ((τ : ℂ) ^ 2) ^ (J - 1) =
          (τ : ℂ) ^ (3 * p) * (τ : ℂ) ^ rem_exp := by
        rw [← pow_mul, ← pow_add, h_exp_id, pow_add]
      have h3p_ne : (τ : ℂ) ^ (3 * p) ≠ 0 := pow_ne_zero _ hτ_ne
      calc (τ : ℂ) ^ 2 * ((τ : ℂ) ^ (3 * p))⁻¹ * ((τ : ℂ) ^ 2) ^ (J - 1)
          = ((τ : ℂ) ^ (3 * p))⁻¹ * ((τ : ℂ) ^ 2 * ((τ : ℂ) ^ 2) ^ (J - 1)) := by ring
        _ = ((τ : ℂ) ^ (3 * p))⁻¹ * ((τ : ℂ) ^ (3 * p) * (τ : ℂ) ^ rem_exp) := by rw [h_lhs]
        _ = (τ : ℂ) ^ rem_exp := inv_mul_cancel_left₀ h3p_ne _
    calc (τ : ℂ) ^ 2 * ((τ : ℂ) ^ (3 * p))⁻¹ *
          (((τ : ℂ) ^ 2) ^ (J - 1) *
            ((J.factorial : ℂ) *
              (M.U_split (Fin.last J) (a : ℂ) +
                M.V_split (Fin.last J) ((a : ℂ) + ((τ ^ p : ℝ) : ℂ)))))
        = ((τ : ℂ) ^ 2 * ((τ : ℂ) ^ (3 * p))⁻¹ * ((τ : ℂ) ^ 2) ^ (J - 1)) *
            (J.factorial : ℂ) *
            (M.U_split (Fin.last J) (a : ℂ) +
              M.V_split (Fin.last J) ((a : ℂ) + ((τ ^ p : ℝ) : ℂ))) := by ring
      _ = (J.factorial : ℂ) * (τ : ℂ) ^ rem_exp *
            (M.U_split (Fin.last J) (a : ℂ) +
              M.V_split (Fin.last J) ((a : ℂ) + ((τ ^ p : ℝ) : ℂ))) := by
          rw [h_pow_τ]; ring
  have h_lim2 : Filter.Tendsto
      (fun τ : ℝ => iteratedDeriv (J - 1) (F_term2 τ) 0 / ((J - 1).factorial : ℂ))
      φ (nhds 0) := by
    have hτ_C_zero : Filter.Tendsto (fun τ : ℝ => (τ : ℂ)) φ (nhds 0) :=
      (Complex.continuous_ofReal.tendsto 0).mono_left nhdsWithin_le_nhds
    have hτ_rem_zero : Filter.Tendsto (fun τ : ℝ => (τ : ℂ) ^ rem_exp) φ (nhds 0) := by
      simpa [Function.comp_def, zero_pow hrem_pos] using
        (continuous_pow rem_exp |>.tendsto (0 : ℂ)).comp hτ_C_zero
    have hV_cont : ContinuousAt (M.V_split (Fin.last J)) (a : ℂ) :=
      (M.UV_holo (Fin.last J)).2.continuousOn.continuousAt (M.W_n_open.mem_nhds M.a_mem)
    have ha_shift : Filter.Tendsto (fun τ : ℝ => (a : ℂ) + ((τ ^ p : ℝ) : ℂ)) φ (nhds (a : ℂ)) := by
      simpa using tendsto_const_nhds.add ((Complex.continuous_ofReal.tendsto 0).comp hτ_pow_tendsto_nhds)
    have hUV_tendsto : Filter.Tendsto
        (fun τ : ℝ =>
          M.U_split (Fin.last J) (a : ℂ) +
            M.V_split (Fin.last J) ((a : ℂ) + ((τ ^ p : ℝ) : ℂ)))
        φ (nhds (M.U_split (Fin.last J) (a : ℂ) + M.V_split (Fin.last J) (a : ℂ))) :=
      tendsto_const_nhds.add (hV_cont.tendsto.comp ha_shift)
    have h_prod_zero : Filter.Tendsto
        (fun τ : ℝ =>
          (J.factorial : ℂ) * (τ : ℂ) ^ rem_exp *
            (M.U_split (Fin.last J) (a : ℂ) +
              M.V_split (Fin.last J) ((a : ℂ) + ((τ ^ p : ℝ) : ℂ))))
        φ (nhds 0) := by
      simpa using (tendsto_const_nhds.mul hτ_rem_zero).mul hUV_tendsto
    simpa using (h_prod_zero.congr' (h_t2_ev.mono fun τ hτ => hτ.symm)).div_const
      ((J - 1).factorial : ℂ)
  have h_coeff_lim_zero : iteratedDeriv (J - 1) f_t2_lim 0 / ((J - 1).factorial : ℂ) = 0 :=
    @tendsto_nhds_unique _ _ _ _ _ φ _ _ hφ_neBot h_lim1 h_lim2
  
  have hqJ_eq : J / p + 1 = d + 2 := by
    dsimp [J, n]
    rw [Nat.mul_div_left (d + 1) hp]
  let u_tr_ps : Fin (k - 1) → PowerSeries ℂ := fun s =>
    ((u_trunc_fn (d + 2) s : Polynomial ℂ) : PowerSeries ℂ)
  let D_tr : PowerSeries ℂ := pointFormalDerivSeries r_a f_p u_tr_ps
  have hf_t2_ps : psAtZero f_t2_lim =
      PowerSeries.C (g_a_pow⁻¹ * (p : ℂ)) * (PowerSeries.X ^ (p - 1) * compPow D_tr) := by
    let P_J : Fin k → Polynomial ℂ := fun i => pointCoalescingStep (u_trunc_fn (d + 2)) i
    have hZ_J_eq : ∀ (e : ℂ) (i : Fin k), Z_lim_J e i = (P_J i).eval (e ^ p) := by
      intro e i
      have h := hZ_lim_poly J e i
      rw [hqJ_eq] at h
      exact h
    have hz_tr_step : ∀ i : Fin k,
        pointCoalescingStep u_tr_ps i = ((P_J i : Polynomial ℂ) : PowerSeries ℂ) := by
      intro i
      dsimp only [P_J, pointCoalescingStep, pointCoalescingExtend, u_tr_ps]
      rw [Polynomial.coe_sub]
      congr 1 <;> split_ifs <;> simp [Polynomial.coe_zero, Polynomial.coe_one]
    let term_fn : Fin k → ℂ → ℂ := fun i e =>
      -(r_a * (f_p i.succ + f_p i.castSucc) / 2) * Z_lim_J e i +
        (f_p i.succ - f_p i.castSucc) ^ 2 * e ^ p * (Z_lim_J e i)⁻¹
    have h_term_ps : ∀ i : Fin k,
        AnalyticAt ℂ (term_fn i) 0 ∧
        psAtZero (term_fn i) =
          compPow
            (-PowerSeries.C (r_a * (f_p i.succ + f_p i.castSucc) / 2) *
                pointCoalescingStep u_tr_ps i +
              PowerSeries.C ((f_p i.succ - f_p i.castSucc) ^ 2) * PowerSeries.X *
                (pointCoalescingStep u_tr_ps i)⁻¹) := by
      intro i
      have hP0 : (P_J i).eval 0 ≠ 0 := by
        rw [hZ_poly_at0 (d + 2) (by omega) i]
        exact one_div_ne_zero hk_ne
      rcases hps_poly (P_J i) with ⟨hP_an, hP_ps⟩
      rcases hps_poly_inv (P_J i) hP0 with ⟨hinv_an, hinv_ps⟩
      have hw_an : AnalyticAt ℂ (fun e : ℂ => e ^ p) 0 := han_pow p
      have h1_an := han_mul (han_const (-(r_a * (f_p i.succ + f_p i.castSucc) / 2))) hP_an
      have h2a_an := han_mul (han_const ((f_p i.succ - f_p i.castSucc) ^ 2)) hw_an
      have h2_an := han_mul h2a_an hinv_an
      have h_eq : term_fn i = fun e : ℂ =>
          -(r_a * (f_p i.succ + f_p i.castSucc) / 2) * (P_J i).eval (e ^ p) +
            ((f_p i.succ - f_p i.castSucc) ^ 2 * e ^ p) * ((P_J i).eval (e ^ p))⁻¹ := by
        funext e; simp only [term_fn, hZ_J_eq]
      rw [h_eq]
      refine ⟨han_add h1_an h2_an, ?_⟩
      rw [hps_add h1_an h2_an, hps_mul (han_const _) hP_an,
        hps_mul h2a_an hinv_an, hps_mul (han_const _) hw_an,
        hps_const, hps_const, hP_ps, hinv_ps, hps_pow p, hz_tr_step i]
      simp only [map_add, map_mul, map_neg, hcompPow_C, hcompPow_X]
    rcases hps_sum Finset.univ term_fn (fun i _ => (h_term_ps i).1) with ⟨hsum_an, hsum_ps⟩
    have hpow_an : AnalyticAt ℂ (fun e : ℂ => e ^ (p - 1)) 0 := han_pow (p - 1)
    have hf_eq : f_t2_lim = fun e : ℂ =>
        (g_a_pow⁻¹ * (p : ℂ)) * (e ^ (p - 1) * ∑ i : Fin k, term_fn i e) := by
      funext e; dsimp only [f_t2_lim, term_fn]; ring
    rw [hf_eq, hps_mul (han_const _) (han_mul hpow_an hsum_an), hps_const,
      hps_mul hpow_an hsum_an, hps_pow (p - 1), hsum_ps]
    have hsum_comp : (∑ i : Fin k, psAtZero (term_fn i)) = compPow D_tr := by
      dsimp only [D_tr, pointFormalDerivSeries]
      rw [map_sum]
      exact Finset.sum_congr rfl fun i _ => (h_term_ps i).2
    rw [hsum_comp]
  have hJ_sub1 : J - 1 = d * p + (p - 1) := by
    have h1 : J = d * p + p := by dsimp [J, n]; ring
    omega
  have hD_tr_zero : PowerSeries.coeff d D_tr = 0 := by
    have hc := congr_arg (PowerSeries.coeff (J - 1)) hf_t2_ps
    have h_lhs : PowerSeries.coeff (J - 1) (psAtZero f_t2_lim) = 0 := by
      simpa [psAtZero] using h_coeff_lim_zero
    have hdvd_dp : p ∣ d * p := dvd_mul_left p d
    rw [h_lhs, hJ_sub1, PowerSeries.coeff_C_mul, PowerSeries.coeff_X_pow_mul] at hc
    dsimp only [compPow, RingHom.coe_mk, MonoidHom.coe_mk, OneHom.coe_mk] at hc
    simp only [PowerSeries.coeff_mk, hdvd_dp, ↓reduceIte, Nat.mul_div_left d hp] at hc
    exact (mul_eq_zero.mp hc.symm).resolve_left (mul_ne_zero (inv_ne_zero hg_a_ne) hp_ne)
  
  let z_full : Fin k → PowerSeries ℂ := pointCoalescingStep F_formal.u_ps
  let z_tr_J : Fin k → PowerSeries ℂ := pointCoalescingStep u_tr_ps
  have hz_agree : ∀ (i : Fin k) (m : ℕ), m < d + 2 →
      PowerSeries.coeff m (z_tr_J i) = PowerSeries.coeff m (z_full i) := by
    intro i m hm
    have hu_agree : ∀ s : Fin (k - 1),
        PowerSeries.coeff m (u_tr_ps s) = PowerSeries.coeff m (F_formal.u_ps s) := by
      intro s
      dsimp only [u_tr_ps, u_trunc_fn]
      rw [Polynomial.coeff_coe, Polynomial.finsetSum_coeff, Finset.sum_eq_single m]
      · simp
      · intro b _ hbm
        simp [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, Ne.symm hbm]
      · intro hm_not
        exact False.elim (hm_not (Finset.mem_range.mpr hm))
    dsimp only [z_tr_J, z_full, pointCoalescingStep, pointCoalescingExtend]
    simp only [map_sub]
    congr 1 <;> split_ifs <;> simp [hu_agree]
  have hz_X_pow_dvd : ∀ (S : PowerSeries ℂ) (m : ℕ), m < d + 2 →
      PowerSeries.coeff m (PowerSeries.X ^ (d + 2) * S) = 0 := by
    intro S m hm
    rw [PowerSeries.coeff_mul, Finset.Nat.sum_antidiagonal_eq_sum_range_succ_mk]
    apply Finset.sum_eq_zero
    intro j hj
    have hj_ne : j ≠ d + 2 :=
      ne_of_lt (lt_of_le_of_lt (Nat.lt_succ_iff.mp (Finset.mem_range.mp hj)) hm)
    simp [PowerSeries.coeff_X_pow, hj_ne]
  have hz_inv_agree : ∀ i : Fin k,
      PowerSeries.coeff (d - 1) ((z_tr_J i)⁻¹) = PowerSeries.coeff (d - 1) ((z_full i)⁻¹) := by
    intro i
    have htr_const : PowerSeries.constantCoeff (z_tr_J i) ≠ 0 := by
      have h_eq : z_tr_J i =
          ((pointCoalescingStep (u_trunc_fn (d + 2)) i : Polynomial ℂ) : PowerSeries ℂ) := by
        dsimp only [z_tr_J, pointCoalescingStep, pointCoalescingExtend, u_tr_ps]
        rw [Polynomial.coe_sub]
        congr 1 <;> split_ifs <;> simp [Polynomial.coe_zero, Polynomial.coe_one]
      rw [h_eq, ← PowerSeries.coeff_zero_eq_constantCoeff, Polynomial.coeff_coe,
        Polynomial.coeff_zero_eq_eval_zero, hZ_poly_at0 (d + 2) (by omega) i]
      exact one_div_ne_zero hk_ne
    have hfull_const : PowerSeries.constantCoeff (z_full i) ≠ 0 := by
      rw [← PowerSeries.coeff_zero_eq_constantCoeff, ← hz_agree i 0 (by omega),
        PowerSeries.coeff_zero_eq_constantCoeff]
      exact htr_const
    let R_rem : PowerSeries ℂ :=
      PowerSeries.mk (fun j => PowerSeries.coeff (j + (d + 2)) (z_full i - z_tr_J i))
    have hdiff : z_full i - z_tr_J i = PowerSeries.X ^ (d + 2) * R_rem := by
      ext m
      by_cases hm : m < d + 2
      · rw [hz_X_pow_dvd R_rem m hm, map_sub, hz_agree i m hm, sub_self]
      · have hle : d + 2 ≤ m := not_lt.mp hm
        have hm_eq : m = (m - (d + 2)) + (d + 2) := (Nat.sub_add_cancel hle).symm
        rw [hm_eq, PowerSeries.coeff_X_pow_mul]
        simp [R_rem]
    have hinv_diff : (z_tr_J i)⁻¹ - (z_full i)⁻¹ =
        PowerSeries.X ^ (d + 2) * ((z_full i)⁻¹ * R_rem * (z_tr_J i)⁻¹) := by
      calc (z_tr_J i)⁻¹ - (z_full i)⁻¹
          = ((z_full i)⁻¹ * z_full i) * (z_tr_J i)⁻¹ -
              (z_full i)⁻¹ * (z_tr_J i * (z_tr_J i)⁻¹) := by
              rw [PowerSeries.inv_mul_cancel _ hfull_const,
                PowerSeries.mul_inv_cancel _ htr_const, one_mul, mul_one]
        _ = (z_full i)⁻¹ * (z_full i - z_tr_J i) * (z_tr_J i)⁻¹ := by ring
        _ = PowerSeries.X ^ (d + 2) * ((z_full i)⁻¹ * R_rem * (z_tr_J i)⁻¹) := by
            rw [hdiff]; ring
    have hc := congr_arg (PowerSeries.coeff (d - 1)) hinv_diff
    rw [map_sub, hz_X_pow_dvd _ (d - 1) (by omega)] at hc
    exact sub_eq_zero.mp hc
  have hD_eq : PowerSeries.coeff d (pointFormalDerivSeries r_a f_p F_formal.u_ps) =
      PowerSeries.coeff d D_tr := by
    dsimp only [D_tr, pointFormalDerivSeries]
    rw [map_sum, map_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [map_add, map_add]
    congr 1
    · rw [neg_mul, neg_mul, map_neg, map_neg, PowerSeries.coeff_C_mul, PowerSeries.coeff_C_mul]
      change -((r_a * (f_p i.succ + f_p i.castSucc) / 2) * PowerSeries.coeff d (z_full i)) =
        -((r_a * (f_p i.succ + f_p i.castSucc) / 2) * PowerSeries.coeff d (z_tr_J i))
      rw [hz_agree i d (by omega)]
    · have hd1 : d = (d - 1) + 1 := (Nat.sub_add_cancel hd).symm
      calc PowerSeries.coeff d
            (PowerSeries.C ((f_p i.succ - f_p i.castSucc) ^ 2) * PowerSeries.X * (z_full i)⁻¹)
          = (f_p i.succ - f_p i.castSucc) ^ 2 *
              PowerSeries.coeff ((d - 1) + 1) (PowerSeries.X ^ 1 * (z_full i)⁻¹) := by
              rw [mul_assoc, PowerSeries.coeff_C_mul, pow_one, ← hd1]
        _ = (f_p i.succ - f_p i.castSucc) ^ 2 * PowerSeries.coeff (d - 1) ((z_full i)⁻¹) := by
              rw [PowerSeries.coeff_X_pow_mul]
        _ = (f_p i.succ - f_p i.castSucc) ^ 2 * PowerSeries.coeff (d - 1) ((z_tr_J i)⁻¹) := by
              rw [hz_inv_agree i]
        _ = PowerSeries.coeff d
              (PowerSeries.C ((f_p i.succ - f_p i.castSucc) ^ 2) * PowerSeries.X *
                (z_tr_J i)⁻¹) := by
              rw [← PowerSeries.coeff_X_pow_mul (z_tr_J i)⁻¹ 1 (d - 1), pow_one, ← hd1,
                ← PowerSeries.coeff_C_mul, ← mul_assoc]
  rw [hD_eq, hD_tr_zero]

theorem point_endpoint_chain_determination (Ω : Set Plane)
    (C : AnalyticGlancingCollar Ω)
    (B : BaseCollarAndCramerData C)
    (hAlg : AlgebraicLiftingToolkit)
    (hWeb : FiniteWebContinuationProp) :
    PointEndpointDetProp C B.s_det B.r_det :=
by
  intro k hk j hj0 hjk ι
  obtain ⟨G⟩ := point_glancing_chart_and_symplectic Ω C B k hk
  let W : Set (ℂ × ℂ) := pointChainBox C B k
  have hk1_pos : (0 : ℝ) < (k : ℝ) + 1 := by positivity
  have hW_open : IsOpen W := by
    refine IsOpen.inter ?_ ?_
    · exact isOpen_lt (continuous_abs.comp (Complex.continuous_im.comp continuous_fst))
        continuous_const
    · exact isOpen_lt (continuous_norm.comp continuous_snd) continuous_const
  have hW_convex : Convex ℝ W := by
    intro p hp q hq a b ha hb hab
    rcases eq_or_lt_of_le ha with rfl | ha_pos
    · simp_all
    · refine ⟨?_, ?_⟩
      · have h1 : (a • p + b • q).1.im = a * p.1.im + b * q.1.im := by simp
        rw [h1]
        calc |a * p.1.im + b * q.1.im|
            ≤ |a * p.1.im| + |b * q.1.im| := abs_add_le _ _
          _ = a * |p.1.im| + b * |q.1.im| := by
              rw [abs_mul, abs_mul, abs_of_nonneg ha, abs_of_nonneg hb]
          _ < a * B.s_det + b * B.s_det := by
              have hlt1 : a * |p.1.im| < a * B.s_det := mul_lt_mul_of_pos_left hp.1 ha_pos
              have hle2 : b * |q.1.im| ≤ b * B.s_det :=
                mul_le_mul_of_nonneg_left (le_of_lt hq.1) hb
              linarith
          _ = B.s_det := by rw [← add_mul, hab, one_mul]
      · have h2 : (a • p + b • q).2 = a • p.2 + b • q.2 := rfl
        rw [h2]
        calc ‖a • p.2 + b • q.2‖
            ≤ ‖a • p.2‖ + ‖b • q.2‖ := norm_add_le _ _
          _ = a * ‖p.2‖ + b * ‖q.2‖ := by
              rw [norm_smul, norm_smul, Real.norm_of_nonneg ha, Real.norm_of_nonneg hb]
          _ < a * (B.r_det / ((k : ℝ) + 1)) + b * (B.r_det / ((k : ℝ) + 1)) := by
              have hlt1 : a * ‖p.2‖ < a * (B.r_det / ((k : ℝ) + 1)) :=
                mul_lt_mul_of_pos_left hp.2 ha_pos
