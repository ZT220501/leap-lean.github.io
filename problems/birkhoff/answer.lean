        dsimp [C_num]; ring
      linarith
    have hD₁_pos : 0 < D₁ := lt_of_lt_of_le (by positivity) hD₁_lo
    have h_prod : |δ (j + 1) - δ j| * (5 / (8 * (q : ℝ))) ≤ (K_step / (q : ℝ) ^ 4) * M := by
      have h1 : |δ (j + 1) - δ j| * (5 / (8 * (q : ℝ))) ≤ |δ (j + 1) - δ j| * D₁ :=
        mul_le_mul_of_nonneg_left hD₁_lo (abs_nonneg _)
      have h2 : |δ (j + 1) - δ j| * D₁ = |-(t₂ - s₂) * (D₁ - D₂) - (N₁ - N₂)| := by
