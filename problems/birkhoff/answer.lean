          _ = 0 := sub_eq_zero.mpr hsq
      have hunit : IsUnit (P + PowerSeries.C z) := by
        rw [PowerSeries.isUnit_iff_constantCoeff, isUnit_iff_ne_zero, map_add,
          hconst z, PowerSeries.constantCoeff_C]
        simpa [two_mul] using mul_ne_zero two_ne_zero hz0
      exact sub_eq_zero.mp (hunit.mul_left_eq_zero.mp hdiff)
    have h_mv_ring : ∀ (F : Subfield ℂ) (Φ : ↥F →+* PowerSeries ℂ),
        (∀ c : ℂ,
          pointRecLiftMv2D F Φ (MvPowerSeries.C c) =
            MvPowerSeries.C (pointRecLiftArcFn F Φ c)) ∧
        (∀ Ψ₁ Ψ₂ : MvPowerSeries (Fin 2) ℂ,
          (∀ d, MvPowerSeries.coeff d Ψ₁ ∈ F) →
          (∀ d, MvPowerSeries.coeff d Ψ₂ ∈ F) →
          pointRecLiftMv2D F Φ (Ψ₁ + Ψ₂) =
            pointRecLiftMv2D F Φ Ψ₁ + pointRecLiftMv2D F Φ Ψ₂ ∧
          pointRecLiftMv2D F Φ (Ψ₁ - Ψ₂) =
            pointRecLiftMv2D F Φ Ψ₁ - pointRecLiftMv2D F Φ Ψ₂ ∧
          pointRecLiftMv2D F Φ (Ψ₁ * Ψ₂) =
            pointRecLiftMv2D F Φ Ψ₁ * pointRecLiftMv2D F Φ Ψ₂) := by
      intro F Φ
      refine ⟨?_, ?_⟩
      · intro c; ext d m
        change PowerSeries.coeff m (pointRecLiftArcFn F Φ (MvPowerSeries.coeff d (MvPowerSeries.C c))) =
          PowerSeries.coeff m (MvPowerSeries.coeff d (MvPowerSeries.C (pointRecLiftArcFn F Φ c)))
        rw [MvPowerSeries.coeff_C, MvPowerSeries.coeff_C]
        split_ifs
        · rfl
        · rw [h_lift_zero]
      · intro Ψ₁ Ψ₂ h₁ h₂
        refine ⟨?_, ?_, ?_⟩
        · ext d m
          change PowerSeries.coeff m (pointRecLiftArcFn F Φ (MvPowerSeries.coeff d (Ψ₁ + Ψ₂))) =
            PowerSeries.coeff m (MvPowerSeries.coeff d (pointRecLiftMv2D F Φ Ψ₁ + pointRecLiftMv2D F Φ Ψ₂))
          rw [map_add, h_lift_add F Φ (h₁ d) (h₂ d), map_add]
          rfl
        · ext d m
          change PowerSeries.coeff m (pointRecLiftArcFn F Φ (MvPowerSeries.coeff d (Ψ₁ - Ψ₂))) =
            PowerSeries.coeff m (MvPowerSeries.coeff d (pointRecLiftMv2D F Φ Ψ₁ - pointRecLiftMv2D F Φ Ψ₂))
          rw [map_sub, h_lift_sub F Φ (h₁ d) (h₂ d), map_sub]
          rfl
        · ext d m
          change PowerSeries.coeff m (pointRecLiftArcFn F Φ (MvPowerSeries.coeff d (Ψ₁ * Ψ₂))) =
            PowerSeries.coeff m (MvPowerSeries.coeff d (pointRecLiftMv2D F Φ Ψ₁ * pointRecLiftMv2D F Φ Ψ₂))
          rw [MvPowerSeries.coeff_mul, MvPowerSeries.coeff_mul]
          have hsum_eq := h_lift_sum F Φ (Finset.HasAntidiagonal.antidiagonal d)
            (fun p => MvPowerSeries.coeff p.1 Ψ₁ * MvPowerSeries.coeff p.2 Ψ₂)
            (fun p _ => F.mul_mem (h₁ p.1) (h₂ p.2))
          rw [hsum_eq]
          simp_rw [h_lift_mul F Φ (h₁ _) (h₂ _)]
          rfl
    have h_coeffs_mem_pow : ∀ (L : Subfield ℂ) (Ψ : MvPowerSeries (Fin 2) ℂ),
        (∀ d, MvPowerSeries.coeff d Ψ ∈ L) → ∀ n d, MvPowerSeries.coeff d (Ψ ^ n) ∈ L := by
      intro L Ψ hΨ n
      induction n with
      | zero =>
          intro d
          rw [pow_zero, MvPowerSeries.coeff_one]
          split_ifs
          · exact L.one_mem
          · exact L.zero_mem
      | succ n ih =>
          intro d
          rw [pow_succ, MvPowerSeries.coeff_mul]
          exact L.sum_mem fun p _ => L.mul_mem (ih p.1) (hΨ p.2)
    have h_mv_pow : ∀ (F : Subfield ℂ) (Φ : ↥F →+* PowerSeries ℂ) (Ψ : MvPowerSeries (Fin 2) ℂ),
        (∀ d, MvPowerSeries.coeff d Ψ ∈ F) →
        ∀ n : ℕ, pointRecLiftMv2D F Φ (Ψ ^ n) = (pointRecLiftMv2D F Φ Ψ) ^ n := by
      intro F Φ Ψ hΨ n
      induction n with
      | zero =>
          rw [pow_zero, pow_zero]
          have h1 : (1 : MvPowerSeries (Fin 2) ℂ) = MvPowerSeries.C 1 := rfl
          rw [h1, (h_mv_ring F Φ).1 1, h_lift_one F Φ, map_one]
      | succ n ih =>
          rw [pow_succ, pow_succ, ((h_mv_ring F Φ).2 (Ψ ^ n) Ψ (h_coeffs_mem_pow F Ψ hΨ n) hΨ).2.2, ih]
    have h_recenter : ∀ (K F : Subfield ℂ) (Φ : ↥F →+* PowerSeries ℂ) (hKF : K ≤ F),
        (∀ (x : ℂ) (hx : x ∈ K), Φ ⟨x, hKF hx⟩ = PowerSeries.C x) →
        ∀ (H_star : ℕ → ℂ) (Δ : PowerSeries ℂ) (Ψ : MvPowerSeries (Fin 2) ℂ),
