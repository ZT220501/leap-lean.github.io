          Metric.mem_closedBall.mpr (lt_of_lt_of_le h_dist_p (min_le_left _ _)).le
        have hp₀_cb : p₀ ∈ Metric.closedBall p₀ r₀ := Metric.mem_closedBall_self hr₀_pos.le
        have hQ_diff : ∀ t ∈ Set.Icc (0 : ℝ) 1, ‖Q p t - Q p₀ t‖ ≤ η := by
          intro t ht
