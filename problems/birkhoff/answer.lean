      rw [← Finset.sum_filter_add_sum_filter_not Finset.univ (fun i : Fin k => i.1 < k - 1)]
      have h_rest : (∑ i ∈ Finset.univ.filter (fun i : Fin k => ¬ i.1 < k - 1),
          A_fn i * T_fn i.succ) = 0 := by
        refine Finset.sum_eq_zero fun i hi => ?_
        rw [Finset.mem_filter] at hi
        have hik : i.1 + 1 = k := by have := i.2; omega
        have h_last : i.succ = Fin.last k := Fin.ext hik
        rw [h_last, hTk, mul_zero]
      rw [h_rest, add_zero]
      symm
      refine Finset.sum_bij (fun (s : Fin (k - 1)) _ => (⟨s.1, by have := s.2; omega⟩ : Fin k))
        ?_ ?_ ?_ ?_
      · intro s _; simp [s.2]
      · intro s₁ _ s₂ _ h; exact Fin.ext (Fin.mk.inj h)
      · intro i hi
        rw [Finset.mem_filter] at hi
        exact ⟨⟨i.1, hi.2⟩, Finset.mem_univ _, Fin.ext rfl⟩
      · intro _ _; rfl
    have h_sum2 : (∑ i : Fin k, B_fn i * T_fn i.castSucc) =
        ∑ s : Fin (k - 1),
          B_fn ⟨s.1 + 1, by have := s.2; omega⟩ * T_fn ⟨s.1 + 1, by have := s.2; omega⟩ := by
      rw [← Finset.sum_filter_add_sum_filter_not Finset.univ (fun i : Fin k => 0 < i.1)]
      have h_rest : (∑ i ∈ Finset.univ.filter (fun i : Fin k => ¬ 0 < i.1),
          B_fn i * T_fn i.castSucc) = 0 := by
        refine Finset.sum_eq_zero fun i hi => ?_
        rw [Finset.mem_filter] at hi
        have hi0 : i.1 = 0 := by omega
        have h_zero : i.castSucc = 0 := Fin.ext hi0
        rw [h_zero, hT0, mul_zero]
      rw [h_rest, add_zero]
      symm
      refine Finset.sum_bij (fun (s : Fin (k - 1)) _ => (⟨s.1 + 1, by have := s.2; omega⟩ : Fin k))
        ?_ ?_ ?_ ?_
      · intro _ _; simp
      · intro s₁ _ s₂ _ h
        have hv : s₁.1 + 1 = s₂.1 + 1 := Fin.mk.inj h
        exact Fin.ext (by omega)
      · intro i hi
        rw [Finset.mem_filter] at hi
        exact ⟨⟨i.1 - 1, by have := i.2; omega⟩, Finset.mem_univ _, Fin.ext (by dsimp; omega)⟩
      · intro _ _; rfl
    rw [Finset.sum_sub_distrib, h_sum1, h_sum2, ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl fun s _ => ?_
