    have h_dbl : 4 * P.C_rec * Real.exp (4 * P.C_rec * B_init) * lam ≤ 1 := by
      calc 4 * P.C_rec * Real.exp (4 * P.C_rec * B_init) * lam
        _ ≤ Real.exp (4 * P.C_rec * B_init) * Real.exp (4 * P.C_rec * B_init) *
              Real.exp (-C_exp * B_init) := by
            refine mul_le_mul
              (mul_le_mul_of_nonneg_right h4C_exp (Real.exp_pos _).le)
              hlam_le hlam_pos.le (by positivity)
        _ = Real.exp ((8 * P.C_rec - C_exp) * B_init) := by
            rw [← Real.exp_add, ← Real.exp_add]
            exact congrArg Real.exp (by ring)
        _ ≤ Real.exp 0 := Real.exp_le_exp.mpr h_neg_exp
        _ = 1 := Real.exp_zero
    linarith
  have hRb_exp : R b ≤ Real.exp ((8 * P.C_rec + 6) * B_init) := by
    have h_prod_le : (2 * P.C_rec * Real.exp (4 * P.C_rec * B_init) * lam) * R b ≤
        (1 / 2 : ℝ) * R b :=
      mul_le_mul_of_nonneg_right h_coeff_half (hR_pos b).le
    have hRb_lin : R b ≤ 2 + 2 * Real.exp B_init +
        4 * P.C_rec * Real.exp ((4 * P.C_rec + 2) * B_init) := by linarith
    have h1_le_e : (1 : ℝ) ≤ Real.exp ((4 * P.C_rec + 2) * B_init) :=
      Real.one_le_exp (by positivity)
    have heB_le_e : Real.exp B_init ≤ Real.exp ((4 * P.C_rec + 2) * B_init) :=
      Real.exp_le_exp.mpr (by linarith)
    have h4p4C_exp : 4 + 4 * P.C_rec ≤ Real.exp ((4 + 4 * P.C_rec) * B_init) :=
      le_trans (by linarith) (Real.add_one_le_exp ((4 + 4 * P.C_rec) * B_init))
    calc R b
      _ ≤ 2 + 2 * Real.exp B_init + 4 * P.C_rec * Real.exp ((4 * P.C_rec + 2) * B_init) := hRb_lin
      _ ≤ (4 + 4 * P.C_rec) * Real.exp ((4 * P.C_rec + 2) * B_init) := by linarith
      _ ≤ Real.exp ((4 + 4 * P.C_rec) * B_init) * Real.exp ((4 * P.C_rec + 2) * B_init) :=
          mul_le_mul_of_nonneg_right h4p4C_exp (Real.exp_pos _).le
      _ = Real.exp ((8 * P.C_rec + 6) * B_init) := by
          rw [← Real.exp_add]
          exact congrArg Real.exp (by ring)
  clear h_sup_le h_abel hR_ge_one hR_pos hR_mono h_sup_a h_late_pos hRb_self h_coeff_half

  
  have hB_le_Clat : B_init ≤ C_lat * B_init := le_mul_of_one_le_left hB_nn hC_lat_ge
  have h_10_le_Clat : (8 * P.C_rec + 10) * B_init ≤ C_lat * B_init :=
    mul_le_mul_of_nonneg_right (by dsimp only [C_lat]; linarith) hB_nn
  intro m hm j
  rcases le_total m a with hma | ham
  · have h_eb := h_early_bounds hma j
    exact ⟨le_trans h_eb.2.2.2.1 hB_le_Clat, le_trans h_eb.2.2.2.2 hB_le_Clat⟩
  · have h1pX_le_Rb : ∀ i : Fin P.N,
        1 + ‖slicePosSeq S P.N i.val (y_seq m)‖ ≤ Real.exp ((8 * P.C_rec + 6) * B_init) := by
      intro i
      have h_s1 : ‖slicePosSeq S P.N i.val (y_seq m)‖ ≤
          Finset.univ.sup' Finset.univ_nonempty
            (fun k : Fin P.N => ‖slicePosSeq S P.N k.val (y_seq m)‖) :=
        Finset.le_sup' (fun k : Fin P.N => ‖slicePosSeq S P.N k.val (y_seq m)‖)
          (Finset.mem_univ i)
      have h_s2 :
          Finset.univ.sup' Finset.univ_nonempty
            (fun k : Fin P.N => ‖slicePosSeq S P.N k.val (y_seq m)‖) ≤
          (Finset.range (b + 1)).sup' ⟨0, Finset.mem_range.mpr (Nat.zero_lt_succ b)⟩
            (fun l => Finset.univ.sup' Finset.univ_nonempty
              (fun k : Fin P.N => ‖slicePosSeq S P.N k.val (y_seq l)‖)) :=
        Finset.le_sup'
          (fun l => Finset.univ.sup' Finset.univ_nonempty
            (fun k : Fin P.N => ‖slicePosSeq S P.N k.val (y_seq l)‖))
          (Finset.mem_range.mpr (Nat.lt_succ_of_le hm))
      have hRb_def : R b = 1 + (Finset.range (b + 1)).sup'
          ⟨0, Finset.mem_range.mpr (Nat.zero_lt_succ b)⟩
          (fun l => Finset.univ.sup' Finset.univ_nonempty
            (fun k : Fin P.N => ‖slicePosSeq S P.N k.val (y_seq l)‖)) := rfl
      linarith
    have h_log_1pX : Real.log (1 + ‖slicePosSeq S P.N j.val (y_seq m)‖) ≤
        (8 * P.C_rec + 6) * B_init :=
      (Real.log_le_iff_le_exp (by positivity)).mpr (h1pX_le_Rb j)
    refine ⟨?_, ?_⟩
    · have hψ_m := h_late_ang ham hm j
      have hsin_m := h_late_sin ham hm j
      linarith
    · have hX_le_exp : ∀ i : Fin P.N,
          ‖slicePosSeq S P.N i.val (y_seq m)‖ ≤ Real.exp ((8 * P.C_rec + 6) * B_init) :=
        fun i => by linarith [h1pX_le_Rb i]
      have h_ell_norm := h_chord_le (hy_reg m hm) (Real.exp ((8 * P.C_rec + 6) * B_init))
        (Real.exp_pos _).le hX_le_exp j
      have h4_le_exp : (4 : ℝ) ≤ Real.exp (4 * B_init) :=
        le_trans (by linarith) (Real.add_one_le_exp (4 * B_init))
      have hθ_exp : Real.exp ‖P.θ_seq j.val (y_seq m)‖ ≤
          Real.exp ((2 * (P.N : ℝ) + (2 * (P.N : ℝ) + 1) * Real.pi) * B_init) :=
        Real.exp_le_exp.mpr (h_late_theta ham hm j)
      have h_ell_le_Clat : ‖P.ℓ_slice j (y_seq m)‖ ≤ Real.exp (C_lat * B_init) := by
        calc ‖P.ℓ_slice j (y_seq m)‖
          _ ≤ 4 * Real.exp ((8 * P.C_rec + 6) * B_init) *
                Real.exp ‖P.θ_seq j.val (y_seq m)‖ := h_ell_norm
          _ ≤ Real.exp (4 * B_init) * Real.exp ((8 * P.C_rec + 6) * B_init) *
                Real.exp ((2 * (P.N : ℝ) + (2 * (P.N : ℝ) + 1) * Real.pi) * B_init) := by
              refine mul_le_mul
                (mul_le_mul_of_nonneg_right h4_le_exp (Real.exp_pos _).le)
                hθ_exp (Real.exp_pos _).le (by positivity)
          _ = Real.exp (C_lat * B_init) := by
              dsimp only [C_lat]
              rw [← Real.exp_add, ← Real.exp_add]
              exact congrArg Real.exp (by ring)
      have h_ell_pos : 0 < ‖P.ℓ_slice j (y_seq m)‖ :=
        norm_pos_iff.mpr (P.reg_chord_ne_zero (y_seq m) (hy_reg m hm) j)
      exact (Real.log_le_iff_le_exp h_ell_pos).mpr h_ell_le_Clat

theorem stopped_geometry_exponent_bootstrap (S : FiniteWallNonisotropicStrip)
    (hBudget : CriticalAngleBudgetData S) (P : OddPeriodicSliceData S) (C_clk C_inv : ℝ)
    (hBase : WalkBaseAndStopProp S P C_clk)
    (hRet : SliceRetreatBoundProp S P)
    (hLogDef : StoppedLogDeficitProp S P)
    (hInv : AdmissibleModifiedInverseProp S P C_inv) :
    ∀ σ : ℝ, 0 < σ → σ < 1 →
      HasUniformPowerGeometry S P σ →
      HasUniformPowerGeometry S P ((σ + σ ^ 2) / 2) :=
by
  have hProbUnif : MeasureTheory.IsProbabilityMeasure unifTwoPiMeasure := by
    refine ⟨?_⟩
    simp only [unifTwoPiMeasure, MeasureTheory.Measure.smul_apply,
      MeasureTheory.Measure.restrict_apply_univ, smul_eq_mul, Real.volume_Ico, sub_zero]
    exact ENNReal.inv_mul_cancel
      (ENNReal.ofReal_pos.mpr Real.two_pi_pos).ne' ENNReal.ofReal_ne_top
  haveI hProbWalk : MeasureTheory.IsProbabilityMeasure walkMeasure := by
    dsimp only [walkMeasure]
    infer_instance
  have hAdmMono : ∀ {M₁ M₂ : ℝ} {ρ : ℂ → ℝ}, 2 ≤ M₁ → M₁ ≤ M₂ →
      IsScaleAdmissibleStep S P M₂ ρ → IsScaleAdmissibleStep S P M₁ ρ := by
    intro M₁ M₂ ρ hM₁ hM₁₂ h₂
    have h_sq : Real.exp (-M₂ ^ 2) ≤ Real.exp (-M₁ ^ 2) :=
      Real.exp_le_exp.mpr (neg_le_neg (pow_le_pow_left₀ (by linarith) hM₁₂ 2))
    have h_cube : Real.exp (-M₂ ^ 3) ≤ Real.exp (-M₁ ^ 3) :=
      Real.exp_le_exp.mpr (neg_le_neg (pow_le_pow_left₀ (by linarith) hM₁₂ 3))
    refine
      { scale_ge_two := hM₁
        measurable := h₂.measurable
        periodic := h₂.periodic
        cont_on := h₂.cont_on
        nonneg := h₂.nonneg
        pos_iff := h₂.pos_iff
        le_sing_dist := h₂.le_sing_dist
        small_shape_step := ?_
        jump_log_speed := h₂.jump_log_speed
        jump_log_sin_d0 := h₂.jump_log_sin_d0
        jump_log_chord := h₂.jump_log_chord
        jump_angle := h₂.jump_angle
        jump_pos := h₂.jump_pos
        taylor_impact := ?_
        taylor_angle := ?_
        taylor_pos₀ := ?_
        taylor_pos₁ := ?_
        taylor_support := ?_ }
    · intro y hy z hz j
      have h_step := h₂.small_shape_step y hy z hz j
      have h_depth_nonneg : 0 ≤ sliceShapeDepth S P j y := by
        have h_prod : 0 ≤ Real.exp (-M₂ ^ 2) * sliceShapeDepth S P j y :=
          le_trans (norm_nonneg _) h_step
        exact nonneg_of_mul_nonneg_right h_prod (Real.exp_pos _)
      exact le_trans h_step (mul_le_mul_of_nonneg_right h_sq h_depth_nonneg)
    · intro y hy z hz j
      refine le_trans (h₂.taylor_impact y hy z hz j) ?_
      have hρ : 0 ≤ ρ y := h₂.nonneg y
      nlinarith
    · intro y hy z hz j
      refine le_trans (h₂.taylor_angle y hy z hz j) ?_
      have hρ : 0 ≤ ρ y := h₂.nonneg y
      nlinarith
    · intro y hy z hz j
      refine le_trans (h₂.taylor_pos₀ y hy z hz j) ?_
      have hρ : 0 ≤ ρ y := h₂.nonneg y
      nlinarith
    · intro y hy z hz j
      refine le_trans (h₂.taylor_pos₁ y hy z hz j) ?_
      have hρ : 0 ≤ ρ y := h₂.nonneg y
      nlinarith
    · intro y hy z hz j
      refine le_trans (h₂.taylor_support y hy z hz j) ?_
      have hρ : 0 ≤ ρ y := h₂.nonneg y
      exact mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_left h_cube (by positivity)) hρ
  have hHist_mono : ∀ (ρ : ℂ → ℝ) (om : WalkSpace) (j : Fin P.N) {m₁ m₂ : ℕ},
      m₁ ≤ m₂ → sliceHistory S P ρ om j m₁ ≤ sliceHistory S P ρ om j m₂ := by
    intro ρ om j m₁ m₂ hm
    unfold sliceHistory
    refine Finset.sup'_le _ _ fun n hn => ?_
    refine Finset.le_sup' (fun k => sliceLogDepth S P j (walkPos ρ om k)) ?_
    exact Finset.mem_range.mpr (lt_of_lt_of_le (Finset.mem_range.mp hn) (Nat.succ_le_succ hm))
  have h_rpow_bound : ∀ {K β M : ℝ}, 0 < β → 1 ≤ K → K ^ (1 / β) ≤ M → K ≤ M ^ β := by
    intro K β M hβ hK hKM
    have hK_nn : 0 ≤ K := by linarith
    have h_pow_nn : 0 ≤ K ^ (1 / β) := Real.rpow_nonneg hK_nn _
    calc
      K = K ^ ((1 / β) * β) := by
        rw [one_div_mul_cancel hβ.ne', Real.rpow_one]
      _ = (K ^ (1 / β)) ^ β := Real.rpow_mul hK_nn (1 / β) β
      _ ≤ M ^ β := Real.rpow_le_rpow h_pow_nn hKM hβ.le
  intro σ hσ_pos hσ_lt hPow
  rcases hPow with ⟨A_cap, hA_cap_ge, hPowσ⟩
  obtain ⟨hℓ_reg, C_lat, C_exp, hC_lat_ge, hC_exp_ge, hFreeze⟩ :=
    slice_late_freezing_and_chord_bounds S P
  have h_ex_Cℓ : ∀ j : Fin P.N, ∃ C_g : ℝ, 0 < C_g ∧
      ∀ M B₀ B₁ : ℝ, 1 ≤ B₀ → 1 ≤ B₁ →
        ∀ ρ : ℂ → ℝ, IsScaleAdmissibleStep S P M ρ →
          (∀ y ∈ horizStrip (sliceHeight S P.N) \ P.Z_all, ∀ z : ℂ, ‖z‖ ≤ ρ y →
            |Real.log ‖P.ℓ_slice j (y + z)‖ - Real.log ‖P.ℓ_slice j y‖| ≤ 1) →
          walkMeasure.real {om : WalkSpace |
            ∃ m ≤ sliceStopTau S P ρ M om,
              (∀ l < m, Real.log ‖P.ℓ_slice j (walkPos ρ om l)‖ ≤ B₀) ∧
              Real.log ‖P.ℓ_slice j (walkPos ρ om m)‖ < -B₁} ≤
            C_g * (1 + B₀) / (1 + B₁) :=
    fun j => hLogDef (P.ℓ_slice j) (hℓ_reg j).1 (hℓ_reg j).2.1 (hℓ_reg j).2.2
  let C_ℓ_fn : Fin P.N → ℝ := fun j => Classical.choose (h_ex_Cℓ j)
  have hC_ℓ_spec := fun j : Fin P.N => Classical.choose_spec (h_ex_Cℓ j)
  let C_ℓ : ℝ := Finset.univ.sup' Finset.univ_nonempty C_ℓ_fn
  have hC_ℓ_pos : 0 < C_ℓ := by
    have j₀ : Fin P.N := ⟨0, lt_of_lt_of_le (by decide : 0 < 3) P.N_ge_three⟩
    exact lt_of_lt_of_le (hC_ℓ_spec j₀).1 (Finset.le_sup' C_ℓ_fn (Finset.mem_univ j₀))
  have hC_ℓ_le : ∀ j : Fin P.N, C_ℓ_fn j ≤ C_ℓ :=
    fun j => Finset.le_sup' C_ℓ_fn (Finset.mem_univ j)
  have hC_inv_pos : 0 < C_inv := hInv.C_inv_pos
  have hC_clk_pos : 0 < C_clk := hBase.C_clk_pos
  obtain ⟨M_sup, hM_sup_ge, hDerivSup⟩ :=
    pigeonhole_jacobi_angle_deriv_suppression S P C_inv σ hC_inv_pos hσ_pos hσ_lt
  let ε₀ : ℝ := bootEps0 σ
  have hε₀_def : ε₀ = (1 - σ) / 4 := rfl
  have hε₀_pos : 0 < ε₀ := by linarith
  let η : ℝ := bootGapEta P.N σ
  have hη_pos : 0 < η := by
    dsimp only [η, bootGapEta]
    exact div_pos hε₀_pos (by positivity)
  let σ_new : ℝ := (σ + σ ^ 2) / 2
  let σ_init : ℝ := σ * (σ + ε₀)
  let σ_mid : ℝ := (σ_init + σ_new) / 2
  let α : ℝ := σ + ε₀ / 3
  have h_gap_new : σ_new - σ_init = σ * ε₀ := by
    dsimp only [σ_new, σ_init, ε₀, bootEps0]
    ring
  have h_σε₀_pos : 0 < σ * ε₀ := mul_pos hσ_pos hε₀_pos
  have h_σ_plus_ε₀_pos : 0 < σ + ε₀ := by linarith
  have h_σ_plus_ε₀_lt : σ + ε₀ < 1 := by linarith
  have h_σ_init_pos : 0 < σ_init := mul_pos hσ_pos h_σ_plus_ε₀_pos
  have h_σ_mid_eq : σ_mid = σ_init + σ * ε₀ / 2 := by
    dsimp only [σ_mid]
    linarith
  have h_σ_new_eq : σ_new = σ_mid + σ * ε₀ / 2 := by
    dsimp only [σ_mid]
    linarith
  have h_σ_mid_pos : 0 < σ_mid := by linarith
  have hα_pos : 0 < α := by
    dsimp only [α]
    linarith
  have hα_lt_one : α < 1 := by
    dsimp only [α]
    linarith
  have h_α_sub_σ : 0 < α - σ := by
    dsimp only [α]
    linarith
  have h_α_sub_init : 0 < α - σ_init := by
    have h_init_lt_σ : σ_init < σ := by
      dsimp only [σ_init]
      nlinarith
    linarith
  let Idx6 := Fin (P.N + 1) × Finset (Fin P.N) × Finset (Fin P.N)
  refine ⟨2 * A_cap, by linarith, ?_⟩
  intro δ hδ
  obtain ⟨M₀_σ, hM₀_σ_ge, hM₀_σ⟩ := hPowσ (δ / 8) (by positivity)
  obtain ⟨M_ph, hM_ph_ge, hM_ph⟩ :=
    stopped_phase_depth_and_clock_bound S hBudget P C_clk hBase (δ / 16) (by positivity)
  obtain ⟨M_ret, hM_ret_ge, hM_ret⟩ := hRet (δ / 8) (by positivity)
  let k_exp : ℕ := Nat.ceil (3 / α) + 1
  have hk_exp_pos : 0 < (k_exp : ℝ) := by positivity
  have h_3_le_kα : 3 ≤ α * (k_exp : ℝ) := by
    have h1 : 3 / α ≤ (Nat.ceil (3 / α) : ℝ) := Nat.le_ceil (3 / α)
    have h2 : (Nat.ceil (3 / α) : ℝ) ≤ (k_exp : ℝ) := by
      dsimp only [k_exp]
      push_cast
      linarith
    have h3 : 3 / α ≤ (k_exp : ℝ) := le_trans h1 h2
    have h4 := (div_le_iff₀ hα_pos).mp h3
    linarith
  let K_inv : ℝ := max 1 (16 * (Fintype.card Idx6 : ℝ) * C_inv / δ)
  let K_exp : ℝ := max 1 (64 * C_exp)
  let K_ℓ : ℝ := max 1 (16 * (P.N : ℝ) * C_ℓ * C_lat / δ)
  let K_lat : ℝ := max 1 (2 * C_lat)
  let M_a : ℝ := max (max 2 M₀_σ) (max M_ph (max M_ret M_sup))
  let M_b : ℝ := max (M₀_σ ^ (1 / (σ + ε₀))) (16 * C_clk / δ)
  let M_c : ℝ := max (K_inv ^ (1 / (η / 4)))
    (max ((128 : ℝ) ^ (1 / (α - σ))) (K_exp ^ (1 / (α - σ_init))))
  let M_d : ℝ := max (384 * (P.N : ℝ) * ((64 * (k_exp : ℝ)) ^ k_exp) / δ)
    (max (K_ℓ ^ (1 / (σ * ε₀ / 2))) (K_lat ^ (1 / (σ * ε₀ / 2))))
  let M₀' : ℝ := max (max M_a M_b) (max M_c M_d)
  have h2_le_Ma : 2 ≤ M_a := le_trans (le_max_left 2 M₀_σ) (le_max_left _ _)
  have hMa_le : M_a ≤ M₀' := le_trans (le_max_left M_a M_b) (le_max_left _ _)
  have hMb_le : M_b ≤ M₀' := le_trans (le_max_right M_a M_b) (le_max_left _ _)
  have hMc_le : M_c ≤ M₀' := le_trans (le_max_left M_c M_d) (le_max_right _ _)
  have hMd_le : M_d ≤ M₀' := le_trans (le_max_right M_c M_d) (le_max_right _ _)
  refine ⟨M₀', le_trans h2_le_Ma hMa_le, ?_⟩
  intro M M_cap hM₀'_le hM_cap ρ hAdmCap
  have hMa_le_M : M_a ≤ M := le_trans hMa_le hM₀'_le
  have hMb_le_M : M_b ≤ M := le_trans hMb_le hM₀'_le
  have hMc_le_M : M_c ≤ M := le_trans hMc_le hM₀'_le
  have hMd_le_M : M_d ≤ M := le_trans hMd_le hM₀'_le
  have hM_ge_two : 2 ≤ M := le_trans h2_le_Ma hMa_le_M
  have hM_ge_one : 1 ≤ M := by linarith
  have hM_pos : 0 < M := by linarith
  have hM_nn : 0 ≤ M := by linarith
  have hM₀_σ_le_M : M₀_σ ≤ M :=
    le_trans (le_trans (le_max_right 2 M₀_σ) (le_max_left _ _)) hMa_le_M
  have hM_ph_le_M : M_ph ≤ M :=
    le_trans (le_trans (le_max_left _ _) (le_max_right _ _)) hMa_le_M
  have hM_ret_le_M : M_ret ≤ M :=
    le_trans (le_trans (le_max_left _ _) (le_trans (le_max_right _ _) (le_max_right _ _))) hMa_le_M
  have hM_sup_le_M : M_sup ≤ M :=
    le_trans (le_trans (le_max_right _ _) (le_trans (le_max_right _ _) (le_max_right _ _))) hMa_le_M
  let H₀ : ℝ := M ^ (σ + ε₀)
  have hM₀_σ_le_H₀ : M₀_σ ≤ H₀ :=
    h_rpow_bound h_σ_plus_ε₀_pos (by linarith) (le_trans (le_max_left _ _) hMb_le_M)
  have hH₀_le_M : H₀ ≤ M := by
    calc
      H₀ = M ^ (σ + ε₀) := rfl
      _ ≤ M ^ (1 : ℝ) := Real.rpow_le_rpow_of_exponent_le hM_ge_one h_σ_plus_ε₀_lt.le
      _ = M := Real.rpow_one M
  have h2M_le_cap : 2 * M ≤ M_cap := by nlinarith
  have hAdm2M : IsScaleAdmissibleStep S P (2 * M) ρ :=
    hAdmMono (by linarith) h2M_le_cap hAdmCap
  have hAdmM : IsScaleAdmissibleStep S P M ρ :=
    hAdmMono hM_ge_two (by linarith) hAdm2M
  let B_init : ℝ := M ^ σ_init
  have hH₀_rpow_σ : H₀ ^ σ = B_init := by
    dsimp only [H₀, B_init, σ_init]
    rw [← Real.rpow_mul hM_nn, mul_comm]
  have hB_init_ge_one : 1 ≤ B_init :=
    Real.one_le_rpow hM_ge_one h_σ_init_pos.le
  let B₀ : ℝ := C_lat * B_init
  let B₁ : ℝ := M ^ σ_mid
  have hB₀_ge_one : 1 ≤ B₀ := by nlinarith
  have hB₁_ge_one : 1 ≤ B₁ := Real.one_le_rpow hM_ge_one h_σ_mid_pos.le
  have hB₁_pos : 0 < B₁ := by linarith
  let η_ang : ℝ := (1 / 2 : ℝ) * Real.exp (-(1 / 32 : ℝ) * M ^ α)
