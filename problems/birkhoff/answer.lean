      simp [y_wall, Complex.mul_im]
    refine ⟨ht₂_norm, ?_, ?_⟩
    · change ENNReal.ofReal (-(c_shift q).1.im) < W.h_L (starRingEnd ℂ (t₂ : ℂ))
      rw [Complex.conj_ofReal, D_wall.h_L_eq_H₂, him]
      exact (ENNReal.ofReal_lt_ofReal_iff hH₂_pos).mpr
