        _ = (w - s₀) ^ 2 * ψ₁ w := by dsimp [ψ₁]; ring
    let q_u : ℂ → ℂ := fun w => Complex.cos (K.ϕ w - ϕ₀) / (g₁ w) ^ 2 - α⁻¹ ^ 2
    have hq_u_holo : DifferentiableOn ℂ q_u B := by
      refine ((Complex.differentiable_cos.differentiableOn.comp hδϕ_holo
        (Set.mapsTo_univ _ _)).div ((hg₁_holo.mono hB_sub).pow 2) ?_).sub_const _
      intro w hw
      exact pow_ne_zero 2 (hg₁_ne w hw)
    have hq_u_zero : q_u s₀ = 0 := by
      simp only [q_u, ϕ₀, sub_self, Complex.cos_zero, hg₁_s₀]
      field_simp [hf']
      ring
    have hq_u_deriv : deriv q_u s₀ = 0 := by
      have hN : HasDerivAt (fun w => Complex.cos (K.ϕ w - ϕ₀)) 0 s₀ := by
        convert (Complex.hasDerivAt_cos (K.ϕ s₀ - ϕ₀)).comp s₀ hδϕ_deriv using 1
        · ext w; simp [Function.comp_apply, sub_eq_add_neg, add_comm]
        · ring
