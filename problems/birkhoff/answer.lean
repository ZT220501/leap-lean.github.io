        linarith
      · rw [dist_eq_norm]
        change ‖p₁.2 - p₂.2‖ < J_all * R
        nlinarith
    have hDen_pre_wit : ∀ (w_c : ℂ × ℂ), w_c ∈ meroTubeENNR W.r_base W.h_L →
