        have ht2 : Filter.Tendsto
            (fun n => (h_seq n)⁻¹ * (Φ μ (p₀.1, p₀.2 + h_seq n) - Φ μ p₀))
            Filter.atTop (nhds (fderiv ℂ (Φ μ) p₀ (0, 1))) := by
          have hs2 := (hasDerivAt_iff_tendsto_slope_zero.mp hd2).comp hh_tendsto
          simpa only [Function.comp_def, smul_eq_mul, zero_add, add_zero, Prod.mk.eta] using hs2
