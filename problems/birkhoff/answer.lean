      have hw3 := h_mul_wit Metric.isOpen_ball hB_pre
        ((hD_prod_holo k).mul ((h_cl_props k).1 0 _)) ((h_cl_props k).2.1 0)
        hw2 (hΔ_cl_wit k 0)
      have hw4 := h_mul_wit Metric.isOpen_ball hB_pre
        (((hD_prod_holo k).mul ((h_cl_props k).1 0 _)).mul ((h_cl_props k).2.1 0))
        ((h_cl_props k).1 1 _) hw3 (hC_lead_wit k 1)
      have hw5 := h_mul_wit Metric.isOpen_ball hB_pre
        ((((hD_prod_holo k).mul ((h_cl_props k).1 0 _)).mul ((h_cl_props k).2.1 0)).mul
          ((h_cl_props k).1 1 _))
        ((h_cl_props k).2.1 1) hw4 (hΔ_cl_wit k 1)
      exact h_nz_open Metric.isOpen_ball hB_pre (hH_exc_holo k) hw5 hV_open hV_ne hV_sub
    let H_base : ℂ × ℂ → ℂ := fun p =>
      E_base.A_coeff 0 (Fin.last (E_base.D_det 0)) p * E_base.Δ_base 0 p *
        E_base.A_coeff 1 (Fin.last (E_base.D_det 1)) p * E_base.Δ_base 1 p
    have hH_base_holo : DifferentiableOn ℂ H_base U_uni :=
      (((E_base.base_coeff_holo 0 _).mul (E_base.base_disc_holo 0)).mul
        (E_base.base_coeff_holo 1 _)).mul (E_base.base_disc_holo 1)
    have hH_base_open_wit : ∀ (V : Set (ℂ × ℂ)),
        IsOpen V → V.Nonempty → V ⊆ U_uni → ∃ p ∈ V, H_base p ≠ 0 := by
      intro V hV_open hV_ne hV_sub
      have hU_pre : IsPreconnected U_uni := hUni_conv.isPreconnected
      have hw2 := h_mul_wit hUni_open hU_pre
        (E_base.base_coeff_holo 0 _) (E_base.base_disc_holo 0)
        (E_base.base_lead_witness 0) (E_base.base_disc_witness 0)
      have hw3 := h_mul_wit hUni_open hU_pre
        ((E_base.base_coeff_holo 0 _).mul (E_base.base_disc_holo 0))
        (E_base.base_coeff_holo 1 _) hw2 (E_base.base_lead_witness 1)
      have hw4 := h_mul_wit hUni_open hU_pre
        (((E_base.base_coeff_holo 0 _).mul (E_base.base_disc_holo 0)).mul
          (E_base.base_coeff_holo 1 _))
        (E_base.base_disc_holo 1) hw3 (E_base.base_disc_witness 1)
      exact h_nz_open hUni_open hU_pre hH_base_holo hw4 hV_open hV_ne hV_sub
    have h_cl_solves_iff : ∀ (k : Fin L_vert) (ι : Fin 2) (p : ℂ × ℂ),
        p ∈ Ω_k k → ∀ z : ℂ,
          (∑ d : Fin (E_base.D_det ι + 1), C_cl k ι d p * z ^ (d : ℕ) = 0) ↔
          (∑ d : Fin (E_base.D_det ι + 1),
            MvPolynomial.eval
              (lineJetEnv (E_base.M_det ι) (F_k k 0) (F_k k b_int) p)
              (E_base.Q_det ι d) * z ^ (d : ℕ) = 0) := by
      intro k ι p ⟨hp_B, hp_D⟩ z
      have h_den0b : ∀ c : Fin 2, D_vert k 0 c p ≠ 0 ∧ D_vert k b_int c p ≠ 0 :=
        fun c => ⟨(hD_prod_nz k p).mp hp_D 0 h0_mem c,
          (hD_prod_nz k p).mp hp_D b_int hb_mem c⟩
      have h_pr := (h_cl_props k).2.2.2 p hp_B h_den0b ι
      have h_sum :
          (∑ d : Fin (E_base.D_det ι + 1), C_cl k ι d p * z ^ (d : ℕ)) =
          S_cl k ι p * ∑ d : Fin (E_base.D_det ι + 1),
            MvPolynomial.eval
              (lineJetEnv (E_base.M_det ι) (F_k k 0) (F_k k b_int) p)
              (E_base.Q_det ι d) * z ^ (d : ℕ) := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl (fun d _ => ?_)
        rw [h_pr.2.2.1 d, mul_assoc]
      rw [h_sum, mul_eq_zero]
      exact ⟨fun h => h.resolve_left h_pr.1, fun h => Or.inr h⟩
    have h_sep_cl : ∀ (k : Fin L_vert) (ι : Fin 2),
        ∀ q ∈ B_ball k, H_exc k q ≠ 0 →
          C_cl k ι (Fin.last (E_base.D_det ι)) q ≠ 0 ∧
          ∀ z : ℂ,
            ∑ d : Fin (E_base.D_det ι + 1), C_cl k ι d q * z ^ (d : ℕ) = 0 →
            ∑ d : Fin (E_base.D_det ι),
              (((d : ℕ) + 1 : ℕ) : ℂ) * C_cl k ι d.succ q * z ^ (d : ℕ) ≠ 0 := by
      intro k ι q hq_B hHq
      simp only [H_exc, mul_ne_zero_iff] at hHq
      have hDq : D_prod k q ≠ 0 := hHq.1.1.1.1
      have hC_last_nz : C_cl k ι (Fin.last (E_base.D_det ι)) q ≠ 0 := by
        fin_cases ι
        · exact hHq.1.1.1.2
        · exact hHq.1.2
      have hΔ_nz : Δ_cl k ι q ≠ 0 := by
        fin_cases ι
        · exact hHq.1.1.2
        · exact hHq.2
      have h_den0b : ∀ c : Fin 2, D_vert k 0 c q ≠ 0 ∧ D_vert k b_int c q ≠ 0 :=
        fun c => ⟨(hD_prod_nz k q).mp hDq 0 h0_mem c,
          (hD_prod_nz k q).mp hDq b_int hb_mem c⟩
      have h_pr := (h_cl_props k).2.2.2 q hq_B h_den0b ι
      let env := lineJetEnv (E_base.M_det ι) (F_k k 0) (F_k k b_int) q
      have hQ_last_nz : MvPolynomial.eval env (E_base.Q_det ι (Fin.last (E_base.D_det ι))) ≠ 0 := by
        intro h0
        apply hC_last_nz
        rw [h_pr.2.2.1 _, h0, mul_zero]
      have hDisc_nz : MvPolynomial.eval env (E_base.Disc_det ι) ≠ 0 := by
        intro h0
        apply hΔ_nz
        rw [h_pr.2.2.2, h0, mul_zero]
      refine ⟨hC_last_nz, fun z hz => ?_⟩
      have hz_eval := (h_cl_solves_iff k ι q ⟨hq_B, hDq⟩ z).mp hz
      have h_dsum_eq :
          (∑ d : Fin (E_base.D_det ι),
            (((d : ℕ) + 1 : ℕ) : ℂ) * C_cl k ι d.succ q * z ^ (d : ℕ)) =
          S_cl k ι q * ∑ d : Fin (E_base.D_det ι),
            (((d : ℕ) + 1 : ℕ) : ℂ) * MvPolynomial.eval env (E_base.Q_det ι d.succ) *
              z ^ (d : ℕ) := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl (fun d _ => ?_)
        rw [h_pr.2.2.1 d.succ]
        ring
      rw [h_dsum_eq]
      exact mul_ne_zero h_pr.1 (E_base.univ_separable ι env z hQ_last_nz hDisc_nz hz_eval)
    have h_sep_base : ∀ ι : Fin 2,
        ∀ q ∈ U_uni, H_base q ≠ 0 →
          E_base.A_coeff ι (Fin.last (E_base.D_det ι)) q ≠ 0 ∧
          ∀ z : ℂ,
            ∑ d : Fin (E_base.D_det ι + 1), E_base.A_coeff ι d q * z ^ (d : ℕ) = 0 →
            ∑ d : Fin (E_base.D_det ι),
              (((d : ℕ) + 1 : ℕ) : ℂ) * E_base.A_coeff ι d.succ q * z ^ (d : ℕ) ≠ 0 := by
      intro ι q _ hHq
      simp only [H_base, mul_ne_zero_iff] at hHq
      have hA_last_nz : E_base.A_coeff ι (Fin.last (E_base.D_det ι)) q ≠ 0 := by
        fin_cases ι
        · exact hHq.1.1.1
        · exact hHq.1.2
      have hΔ_nz : E_base.Δ_base ι q ≠ 0 := by
        fin_cases ι
        · exact hHq.1.1.2
        · exact hHq.2
      refine ⟨hA_last_nz, fun z hz => ?_⟩
      rw [E_base.A_coeff_def] at hA_last_nz
      rw [E_base.Δ_base_def] at hΔ_nz
      have hz_eval :
          ∑ d : Fin (E_base.D_det ι + 1),
