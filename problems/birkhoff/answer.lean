        (∫ x in (0 : ℝ)..(2 * Real.pi),
          Complex.exp (-Complex.I * (n : ℂ) * (x : ℂ)) * H_sys.b_mult n (fourierSeriesℝ c) x *
            (fourierSeriesℝ dc x : ℂ)) = -H_sys.C_coeff n (fourierSeriesℝ c))

  have h_c0_conj : ∀ k : ℤ, uTruncCoeff R P (-k) = starRingEnd ℂ (uTruncCoeff R P k) := by
    intro k
    unfold uTruncCoeff
    rw [abs_neg]
    split_ifs with hk
    · exact hu_conj k
    · simp

  have h_c0_wiener : ∀ τ : ℝ,
      Summable (fun k : ℤ => ‖uTruncCoeff R P k‖ * Real.exp (τ * |(k : ℝ)|)) := by
    intro τ
    refine summable_of_ne_finset_zero (s := Finset.Icc (-(P : ℤ)) (P : ℤ)) ?_
    intro k hk
    have hk_gt : ¬ |k| ≤ (P : ℤ) := by
      intro hle
      exact hk (Finset.mem_Icc.mpr (abs_le.mp hle))
    simp [uTruncCoeff, hk_gt]

  have h_state_zero : State 0 (uTruncCoeff R P) := by
    obtain ⟨h0_sm, h0_ext, h0_res_sum, h0_res_le⟩ := hInitP P hP₀_le
    have hσ0 : σ_seq 0 = 1 / (P : ℝ) := by
      dsimp [σ_seq]
      field_simp
      norm_num
    have hB0 : B_seq 0 = M / 4 := by simp [B_seq]
    have hε0 : ε_seq 0 = 1 / (P : ℝ) ^ 34 := by simp [ε_seq, one_div]
    refine ⟨h_c0_conj, ?_, h_c0_wiener (σ_seq 0), ?_, ?_, ?_, ?_⟩
    · intro k hk
      have hkP : |k| ≤ (P : ℤ) := by omega
      simp [uTruncCoeff, hkP]
    · rw [hB0]; exact h0_sm
    · rw [hσ0, hB0]; exact h0_ext
    · rw [hσ0]; exact h0_res_sum
    · rw [hσ0, hε0]; exact h0_res_le

  have h_exists_step : ∀ (j : ℕ) (s : { c : ℤ → ℂ // State j c }),
      ∃ dc : ℤ → ℂ, StepSpec j s.1 dc := by
    intro j ⟨c, hc_conj, _, _, hc_sm, hc_ext, hc_res_sum, hc_res_le⟩
    have hB_le_34 : B_seq j ≤ 3 * M / 4 := le_trans (hB_le_half j) (by linarith)
    exact W_op.solve_high (σ_seq j) (ε_seq j) (fourierSeriesℝ c) (fourierSeriesℂ c)
      (fun n => H_sys.C_coeff n (fourierSeriesℝ c))
      (hσ_mem_Ioc j) (hε_nn j)
      (h_smooth_mono hc_sm hB_le_34)
      (h_strip_mono hc_ext le_rfl hB_le_34)
      (fun n _ => H_sys.C_conj_symm n (fourierSeriesℝ c))
      hc_res_sum hc_res_le

  let nextStep : ∀ (j : ℕ) (s : { c : ℤ → ℂ // State j c }),
      { dc : ℤ → ℂ // StepSpec j s.1 dc } :=
    fun j s => ⟨Classical.choose (h_exists_step j s), Classical.choose_spec (h_exists_step j s)⟩

  have h_next_state : ∀ (j : ℕ) (s : { c : ℤ → ℂ // State j c }),
      State (j + 1) (s.1 + (nextStep j s).1) := by
    intro j s
    let c := s.1
    let dc := (nextStep j s).1
    rcases s.2 with ⟨hc_conj, hc_low, hc_wsum, hc_sm, hc_ext, _, _⟩
    rcases (nextStep j s).2 with ⟨hdc_conj, hdc_low, hdc_wsum, hdc_wle, hdc_lin⟩
    have hσ_next_pos : 0 < σ_seq (j + 1) := (hσ_mem_Ioc (j + 1)).1
    have hσ_next_le : σ_seq (j + 1) ≤ σ_seq j := le_of_lt (hσ_step_lt j)
    
    obtain ⟨hdc_sm_raw, hdc_ext_raw⟩ :=
      h_wiener_strip_calc dc (σ_seq j) (σ_seq (j + 1)) (2 * ε_seq j)
        hσ_next_pos (hσ_step_lt j) (hσ_diff_le_one j) (by positivity)
        hdc_conj hdc_wsum hdc_wle
    let D_η : ℝ := C₁ * ((P : ℝ) ^ 17)⁻¹ * ((2 : ℝ) ^ j)⁻¹
    have hD_raw_eq :
        ((Nat.factorial 17) : ℝ) * (σ_seq j - σ_seq (j + 1))⁻¹ ^ 17 * (2 * ε_seq j) = D_η := by
      rw [hσ_diff j, inv_inv]
      dsimp [ε_seq, D_η, C₁]
      have hP34 : (P : ℝ) ^ 34 = (P : ℝ) ^ 17 * (P : ℝ) ^ 17 := by ring
      have hP17_ne : (P : ℝ) ^ 17 ≠ 0 := ne_of_gt (pow_pos hP_pos 17)
      have h_two_pow : ((2 : ℝ) ^ j) ^ 17 * (((2 : ℝ) ^ 18)⁻¹) ^ j = ((2 : ℝ) ^ j)⁻¹ := by
        rw [pow_right_comm (2 : ℝ) j 17, ← mul_pow]
        rw [show (2 : ℝ) ^ 17 * ((2 : ℝ) ^ 18)⁻¹ = (2 : ℝ)⁻¹ by norm_num, inv_pow]
      calc ((Nat.factorial 17) : ℝ) * (4 * (P : ℝ) * (2 : ℝ) ^ j) ^ 17 *
              (2 * (((P : ℝ) ^ 34)⁻¹ * (((2 : ℝ) ^ 18)⁻¹) ^ j))
          = 2 * ((Nat.factorial 17) : ℝ) * (4 : ℝ) ^ 17 *
              ((P : ℝ) ^ 17 * ((P : ℝ) ^ 34)⁻¹) *
              (((2 : ℝ) ^ j) ^ 17 * (((2 : ℝ) ^ 18)⁻¹) ^ j) := by ring
        _ = 2 * ((Nat.factorial 17) : ℝ) * (4 : ℝ) ^ 17 * ((P : ℝ) ^ 17)⁻¹ * ((2 : ℝ) ^ j)⁻¹ := by
              rw [hP34, mul_inv, mul_inv_cancel_left₀ hP17_ne, h_two_pow]
    have hdc_sm : IsPeriodicSmoothBounded 17 D_η (fourierSeriesℝ dc) := by
      rwa [hD_raw_eq] at hdc_sm_raw
    have hdc_ext : IsBoundedStripExt 17 (σ_seq (j + 1)) D_η
        (fourierSeriesℝ dc) (fourierSeriesℂ dc) := by
      rwa [hD_raw_eq] at hdc_ext_raw
    have hD_η_nn : 0 ≤ D_η := by dsimp [D_η]; positivity
    have hD_η_le : D_η ≤ M / 4 := by
      calc D_η
          = C₁ * ((P : ℝ) ^ 17)⁻¹ * ((2 : ℝ) ^ j)⁻¹ := rfl
        _ ≤ C₁ * ((P : ℝ) ^ 17)⁻¹ * 1 :=
              mul_le_mul_of_nonneg_left (h2j_inv_le_one j) (by positivity)
        _ ≤ 2 * C₁ * ((P : ℝ) ^ 17)⁻¹ := by
              have h_nn : 0 ≤ C₁ * ((P : ℝ) ^ 17)⁻¹ := by positivity
              linarith
        _ ≤ M / 4 := hC₁_thresh
    
    have hc_wsum_next : Summable (fun k : ℤ => ‖c k‖ * Real.exp (σ_seq (j + 1) * |(k : ℝ)|)) :=
      Summable.of_nonneg_of_le (fun _ => by positivity)
        (fun k => mul_le_mul_of_nonneg_left
          (Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_right hσ_next_le (abs_nonneg _)))
          (norm_nonneg _)) hc_wsum
    have hdc_wsum_next : Summable (fun k : ℤ => ‖dc k‖ * Real.exp (σ_seq (j + 1) * |(k : ℝ)|)) :=
      Summable.of_nonneg_of_le (fun _ => by positivity)
        (fun k => mul_le_mul_of_nonneg_left
          (Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_right hσ_next_le (abs_nonneg _)))
          (norm_nonneg _)) hdc_wsum
    have hdc_wle_next :
        (∑' k : ℤ, ‖dc k‖ * Real.exp (σ_seq (j + 1) * |(k : ℝ)|)) ≤ 2 * ε_seq j :=
      le_trans
        (Summable.tsum_le_tsum
          (fun k => mul_le_mul_of_nonneg_left
            (Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_right hσ_next_le (abs_nonneg _)))
            (norm_nonneg _)) hdc_wsum_next hdc_wsum)
        hdc_wle
    
    obtain ⟨hAddR, h_sum_sm, h_sum_ext⟩ :=
      h_wiener_add c dc (σ_seq (j + 1)) (B_seq j) D_η hσ_next_pos
        hc_wsum_next hdc_wsum_next hc_sm hdc_sm
        (h_strip_mono hc_ext hσ_next_le le_rfl) hdc_ext
    have hB_step_eq : B_seq j + D_η = B_seq (j + 1) := by
      dsimp [B_seq, D_η]
      rw [pow_succ, mul_inv]
      ring
    
    obtain ⟨hrem_sum, hrem_le⟩ :=
      W_op.taylor_rem_wiener (σ_seq (j + 1)) D_η (2 * ε_seq j)
        (fourierSeriesℝ c) (fourierSeriesℂ c) (fourierSeriesℂ dc) dc
        (hσ_mem_Ioc (j + 1)) hD_η_nn hD_η_le (by positivity)
        (h_smooth_mono hc_sm (hB_le_half j))
        (h_strip_mono hc_ext hσ_next_le (hB_le_half j))
        hdc_conj hdc_wsum_next hdc_wle_next hdc_sm hdc_ext
    have hrem_eq :
        (fun n : ℤ =>
          if (N : ℤ) ≤ |n| then
            ‖H_sys.C_coeff n (fourierSeriesℝ (c + dc))‖ *
              Real.exp (σ_seq (j + 1) * |(n : ℝ)|)
          else 0) =
        (fun n : ℤ =>
          if (N : ℤ) ≤ |n| then
            ‖(H_sys.C_coeff n (fun x => fourierSeriesℝ c x + fourierSeriesℝ dc x) -
              H_sys.C_coeff n (fourierSeriesℝ c) -
              ((2 * Real.pi : ℝ) : ℂ)⁻¹ *
                ∫ x in (0 : ℝ)..(2 * Real.pi),
                  Complex.exp (-Complex.I * (n : ℂ) * (x : ℂ)) *
                    H_sys.b_mult n (fourierSeriesℝ c) x * (fourierSeriesℝ dc x : ℂ))‖ *
              Real.exp (σ_seq (j + 1) * |(n : ℝ)|)
          else 0) := by
      ext n
      split_ifs with hn
      · congr 2
        have hfun : (fun x => fourierSeriesℝ c x + fourierSeriesℝ dc x) = fourierSeriesℝ (c + dc) :=
          funext (fun x => (hAddR x).symm)
        rw [hfun, hdc_lin n hn]
        ring
      · rfl
    have h_quad_contract : W_op.C_quad * D_η * (2 * ε_seq j) ≤ ε_seq (j + 1) := by
      have hε_rel : ε_seq j = (2 : ℝ) ^ 18 * ε_seq (j + 1) := by
        dsimp [ε_seq]
        rw [pow_succ]
        ring
      have h_id : W_op.C_quad * D_η * (2 * ε_seq j) =
          (C₂ * ((P : ℝ) ^ 17)⁻¹ * (2 : ℝ) ^ 18) * ((2 : ℝ) ^ j)⁻¹ * ε_seq (j + 1) := by
        rw [hε_rel]
        dsimp [D_η, C₂]
        ring
      rw [h_id]
      have hprod_le_one :
          (C₂ * ((P : ℝ) ^ 17)⁻¹ * (2 : ℝ) ^ 18) * ((2 : ℝ) ^ j)⁻¹ ≤ 1 := by
        calc (C₂ * ((P : ℝ) ^ 17)⁻¹ * (2 : ℝ) ^ 18) * ((2 : ℝ) ^ j)⁻¹
            ≤ 1 * 1 := mul_le_mul hC₂_thresh (h2j_inv_le_one j) (by positivity) zero_le_one
          _ = 1 := one_mul 1
      calc (C₂ * ((P : ℝ) ^ 17)⁻¹ * (2 : ℝ) ^ 18) * ((2 : ℝ) ^ j)⁻¹ * ε_seq (j + 1)
          ≤ 1 * ε_seq (j + 1) := mul_le_mul_of_nonneg_right hprod_le_one (hε_nn (j + 1))
        _ = ε_seq (j + 1) := one_mul _
    refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · intro k
      simp [Pi.add_apply, hc_conj k, hdc_conj k, map_add]
    · intro k hk
      simp [Pi.add_apply, hc_low k hk, hdc_low k hk]
    · exact Summable.of_nonneg_of_le (fun _ => by positivity)
        (fun k => by
          dsimp [Pi.add_apply]
          calc ‖c k + dc k‖ * Real.exp (σ_seq (j + 1) * |(k : ℝ)|)
              ≤ (‖c k‖ + ‖dc k‖) * Real.exp (σ_seq (j + 1) * |(k : ℝ)|) :=
                mul_le_mul_of_nonneg_right (norm_add_le _ _) (Real.exp_nonneg _)
            _ = ‖c k‖ * Real.exp (σ_seq (j + 1) * |(k : ℝ)|) +
                  ‖dc k‖ * Real.exp (σ_seq (j + 1) * |(k : ℝ)|) := add_mul _ _ _)
        (hc_wsum_next.add hdc_wsum_next)
    · rwa [hB_step_eq] at h_sum_sm
    · rwa [hB_step_eq] at h_sum_ext
    · rw [hrem_eq]; exact hrem_sum
    · rw [hrem_eq]; exact le_trans hrem_le h_quad_contract

  let iter : ∀ j : ℕ, { c : ℤ → ℂ // State j c } :=
    Nat.rec ⟨uTruncCoeff R P, h_state_zero⟩
      (fun j s => ⟨s.1 + (nextStep j s).1, h_next_state j s⟩)
  let c_seq : ℕ → ℤ → ℂ := fun j => (iter j).1
  let Δc : ℕ → ℤ → ℂ := fun j => (nextStep j (iter j)).1

  
  
  
  let q : ℝ := ((2 : ℝ) ^ 18)⁻¹
  have hq_nn : 0 ≤ q := by dsimp [q]; positivity
  have hq_lt_one : q < 1 := by dsimp [q]; norm_num
  have hq_geom_le : (∑' j : ℕ, q ^ j) ≤ 2 := by
    rw [tsum_geometric_of_lt_one hq_nn hq_lt_one]
    dsimp [q]
    norm_num

  let σ_inf : ℝ := 1 / (2 * (P : ℝ))
  let σ_raw : ℝ := 1 / (4 * (P : ℝ))
  have hσ_raw_pos : 0 < σ_raw := by dsimp [σ_raw]; positivity
  have hσ_raw_lt_inf : σ_raw < σ_inf := by
    dsimp [σ_raw, σ_inf]
    have : 2 * (P : ℝ) < 4 * (P : ℝ) := by linarith
    exact one_div_lt_one_div_of_lt (by positivity) this
  have hσ_inf_sub_raw : σ_inf - σ_raw = (4 * (P : ℝ))⁻¹ := by
    dsimp [σ_inf, σ_raw]
    field_simp
    ring
  have hσ_inf_sub_le_one : σ_inf - σ_raw ≤ 1 := by
    rw [hσ_inf_sub_raw]
    apply inv_le_one_of_one_le₀
    linarith
  have hσ_inf_le_seq : ∀ j : ℕ, σ_inf ≤ σ_seq j := by
    intro j
    dsimp [σ_inf, σ_seq]
    gcongr
    have : 0 ≤ ((2 : ℝ) ^ j)⁻¹ := by positivity
    linarith

  let f_2d : ℕ × ℤ → ℝ := fun p => ‖Δc p.1 p.2‖ * Real.exp (σ_inf * |(p.2 : ℝ)|)
  have hf_2d_nn : 0 ≤ f_2d := fun _ => by dsimp [f_2d]; positivity

  have hf_row_sum : ∀ j : ℕ, Summable (fun k : ℤ => f_2d (j, k)) := by
    intro j
    exact Summable.of_nonneg_of_le (fun _ => by dsimp [f_2d]; positivity)
      (fun k => mul_le_mul_of_nonneg_left
        (Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_right (hσ_inf_le_seq j) (abs_nonneg _)))
        (norm_nonneg _))
      (nextStep j (iter j)).2.2.2.1

  have hf_row_le : ∀ j : ℕ, (∑' k : ℤ, f_2d (j, k)) ≤ 2 * ((P : ℝ) ^ 34)⁻¹ * q ^ j := by
    intro j
    exact le_trans
      (Summable.tsum_le_tsum
        (fun k => mul_le_mul_of_nonneg_left
          (Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_right (hσ_inf_le_seq j) (abs_nonneg _)))
          (norm_nonneg _))
        (hf_row_sum j) (nextStep j (iter j)).2.2.2.1)
      (by simpa [ε_seq, q, mul_assoc] using (nextStep j (iter j)).2.2.2.2.1)

  have h_maj_geom_sum : Summable (fun j : ℕ => 2 * ((P : ℝ) ^ 34)⁻¹ * q ^ j) :=
    (summable_geometric_of_lt_one hq_nn hq_lt_one).mul_left _

  have hf_outer_sum : Summable (fun j : ℕ => ∑' k : ℤ, f_2d (j, k)) :=
    Summable.of_nonneg_of_le (fun _ => tsum_nonneg (fun _ => by dsimp [f_2d]; positivity))
      hf_row_le h_maj_geom_sum

  have hf_2d_sum : Summable f_2d :=
    (summable_prod_of_nonneg hf_2d_nn).mpr ⟨hf_row_sum, hf_outer_sum⟩

  have hf_swap := (summable_prod_of_nonneg (fun p : ℤ × ℕ => hf_2d_nn p.swap)).mp hf_2d_sum.prod_symm
  have hf_col_sum : ∀ k : ℤ, Summable (fun j : ℕ => f_2d (j, k)) := hf_swap.1
  have hf_col_outer : Summable (fun k : ℤ => ∑' j : ℕ, f_2d (j, k)) := hf_swap.2

  have hΔc_norm_sum : ∀ k : ℤ, Summable (fun j : ℕ => ‖Δc j k‖) := by
    intro k
    refine Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (fun j => ?_) (hf_col_sum k)
    dsimp [f_2d]
    exact le_mul_of_one_le_right (norm_nonneg _)
      (Real.one_le_exp (by dsimp [σ_inf]; positivity))

  have hΔc_sum : ∀ k : ℤ, Summable (fun j : ℕ => Δc j k) :=
    fun k => Summable.of_norm (hΔc_norm_sum k)

  let d_star : ℤ → ℂ := fun k => ∑' j : ℕ, Δc j k
  let c_star : ℤ → ℂ := uTruncCoeff R P + d_star

  have hd_star_conj : ∀ k : ℤ, d_star (-k) = starRingEnd ℂ (d_star k) := by
    intro k
    dsimp [d_star]
    symm
    change Complex.conjCLE (∑' j : ℕ, Δc j k) = _
    rw [Complex.conjCLE.map_tsum]
    exact tsum_congr fun j => ((nextStep j (iter j)).2.1 k).symm

  have hd_star_w_le : ∀ k : ℤ,
      ‖d_star k‖ * Real.exp (σ_inf * |(k : ℝ)|) ≤ ∑' j : ℕ, f_2d (j, k) := by
    intro k
    calc ‖d_star k‖ * Real.exp (σ_inf * |(k : ℝ)|)
        ≤ (∑' j : ℕ, ‖Δc j k‖) * Real.exp (σ_inf * |(k : ℝ)|) :=
          mul_le_mul_of_nonneg_right (norm_tsum_le_tsum_norm (hΔc_norm_sum k)) (Real.exp_nonneg _)
      _ = ∑' j : ℕ, f_2d (j, k) := tsum_mul_right.symm

  have hd_star_wsum : Summable (fun k : ℤ => ‖d_star k‖ * Real.exp (σ_inf * |(k : ℝ)|)) :=
    Summable.of_nonneg_of_le (fun _ => by positivity) hd_star_w_le hf_col_outer

  have hd_star_wbound :
      (∑' k : ℤ, ‖d_star k‖ * Real.exp (σ_inf * |(k : ℝ)|)) ≤ 4 * ((P : ℝ) ^ 34)⁻¹ := by
    calc (∑' k : ℤ, ‖d_star k‖ * Real.exp (σ_inf * |(k : ℝ)|))
        ≤ ∑' k : ℤ, ∑' j : ℕ, f_2d (j, k) :=
          Summable.tsum_le_tsum hd_star_w_le hd_star_wsum hf_col_outer
      _ = ∑' j : ℕ, ∑' k : ℤ, f_2d (j, k) :=
          Summable.tsum_comm (f := fun j k => f_2d (j, k)) hf_2d_sum
      _ ≤ ∑' j : ℕ, (2 * ((P : ℝ) ^ 34)⁻¹ * q ^ j) :=
          Summable.tsum_le_tsum hf_row_le hf_outer_sum h_maj_geom_sum
      _ = 2 * ((P : ℝ) ^ 34)⁻¹ * ∑' j : ℕ, q ^ j := tsum_mul_left
      _ ≤ 2 * ((P : ℝ) ^ 34)⁻¹ * 2 :=
          mul_le_mul_of_nonneg_left hq_geom_le (by positivity)
      _ = 4 * ((P : ℝ) ^ 34)⁻¹ := by ring

  
  obtain ⟨hd_sm_raw, hd_ext_raw⟩ :=
    h_wiener_strip_calc d_star σ_inf σ_raw (4 * ((P : ℝ) ^ 34)⁻¹)
      hσ_raw_pos hσ_raw_lt_inf hσ_inf_sub_le_one (by positivity)
      hd_star_conj hd_star_wsum hd_star_wbound

  have hd_bound_le :
      ((Nat.factorial 17) : ℝ) * (σ_inf - σ_raw)⁻¹ ^ 17 * (4 * ((P : ℝ) ^ 34)⁻¹) ≤ M / 4 := by
    rw [hσ_inf_sub_raw, inv_inv]
    have hP34 : (P : ℝ) ^ 34 = (P : ℝ) ^ 17 * (P : ℝ) ^ 17 := by ring
    have hP17_ne : (P : ℝ) ^ 17 ≠ 0 := ne_of_gt (pow_pos hP_pos 17)
    have h_eq : ((Nat.factorial 17) : ℝ) * (4 * (P : ℝ)) ^ 17 * (4 * ((P : ℝ) ^ 34)⁻¹) =
        2 * C₁ * ((P : ℝ) ^ 17)⁻¹ := by
      dsimp [C₁]
      calc ((Nat.factorial 17) : ℝ) * (4 * (P : ℝ)) ^ 17 * (4 * ((P : ℝ) ^ 34)⁻¹)
          = 4 * ((Nat.factorial 17) : ℝ) * (4 : ℝ) ^ 17 * ((P : ℝ) ^ 17 * ((P : ℝ) ^ 34)⁻¹) := by ring
        _ = 2 * (2 * ((Nat.factorial 17) : ℝ) * (4 : ℝ) ^ 17) * ((P : ℝ) ^ 17)⁻¹ := by
              rw [hP34, mul_inv, mul_inv_cancel_left₀ hP17_ne]; ring
    rw [h_eq]
    exact hC₁_thresh

  have hd_sm : IsPeriodicSmoothBounded 17 (M / 4) (fourierSeriesℝ d_star) :=
    h_smooth_mono hd_sm_raw hd_bound_le
  have hd_ext : IsBoundedStripExt 17 σ_raw (M / 4)
      (fourierSeriesℝ d_star) (fourierSeriesℂ d_star) :=
    h_strip_mono hd_ext_raw le_rfl hd_bound_le

  have hd_wsum_raw : Summable (fun k : ℤ => ‖d_star k‖ * Real.exp (σ_raw * |(k : ℝ)|)) :=
    Summable.of_nonneg_of_le (fun _ => by positivity)
      (fun k => mul_le_mul_of_nonneg_left
        (Real.exp_le_exp.mpr
          (mul_le_mul_of_nonneg_right (le_of_lt hσ_raw_lt_inf) (abs_nonneg _)))
        (norm_nonneg _)) hd_star_wsum

  obtain ⟨h0_sm, h0_ext, _, _⟩ := hInitP P hP₀_le
  have hσ_raw_le_1P : σ_raw ≤ 1 / (P : ℝ) := by
    dsimp [σ_raw]
    exact le_of_lt (one_div_lt_one_div_of_lt hP_pos (by linarith))

  obtain ⟨_, hc_star_sm_raw, hc_star_ext_raw⟩ :=
    h_wiener_add (uTruncCoeff R P) d_star σ_raw (M / 4) (M / 4) hσ_raw_pos
      (h_c0_wiener σ_raw) hd_wsum_raw h0_sm hd_sm
      (h_strip_mono h0_ext hσ_raw_le_1P le_rfl) hd_ext

  have hM_quarter_add : M / 4 + M / 4 = M / 2 := by ring
  have hc_star_sm : IsPeriodicSmoothBounded 17 (M / 2) (fourierSeriesℝ c_star) := by
    rwa [hM_quarter_add] at hc_star_sm_raw
  have hc_star_ext : IsBoundedStripExt 17 σ_raw (M / 2)
      (fourierSeriesℝ c_star) (fourierSeriesℂ c_star) := by
    rwa [hM_quarter_add] at hc_star_ext_raw

  have hc_star_conj : ∀ k : ℤ, c_star (-k) = starRingEnd ℂ (c_star k) := by
    intro k
    simp [c_star, Pi.add_apply, h_c0_conj k, hd_star_conj k, map_add]

  have hc_star_low : ∀ k : ℤ, |k| < (N : ℤ) → c_star k = uTableCoeff R k := by
    intro k hk
    have hkP : |k| ≤ (P : ℤ) := by omega
    have hd0 : d_star k = 0 := by
      have hzero : ∀ j : ℕ, Δc j k = 0 := fun j => (nextStep j (iter j)).2.2.1 k hk
      simp [d_star, hzero]
    simp [c_star, Pi.add_apply, uTruncCoeff, hkP, hd0]

  have hc_star_sum : Summable (fun k : ℤ => ‖c_star k‖) := by
    have hw : Summable (fun k : ℤ =>
        ‖uTruncCoeff R P k‖ * Real.exp (σ_raw * |(k : ℝ)|) +
          ‖d_star k‖ * Real.exp (σ_raw * |(k : ℝ)|)) :=
      (h_c0_wiener σ_raw).add hd_wsum_raw
    refine Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (fun k => ?_) hw
    calc ‖c_star k‖
        ≤ ‖uTruncCoeff R P k‖ + ‖d_star k‖ := norm_add_le _ _
      _ ≤ (‖uTruncCoeff R P k‖ + ‖d_star k‖) * Real.exp (σ_raw * |(k : ℝ)|) :=
            le_mul_of_one_le_right (by positivity)
              (Real.one_le_exp (by positivity))
      _ = ‖uTruncCoeff R P k‖ * Real.exp (σ_raw * |(k : ℝ)|) +
            ‖d_star k‖ * Real.exp (σ_raw * |(k : ℝ)|) := add_mul _ _ _

  have hc_seq_sum : ∀ j : ℕ, Summable (fun k : ℤ => ‖c_seq j k‖) := by
    intro j
    refine Summable.of_nonneg_of_le (fun _ => norm_nonneg _) (fun k => ?_) (iter j).2.2.2.1
    exact le_mul_of_one_le_right (norm_nonneg _)
      (Real.one_le_exp (mul_nonneg (le_of_lt (hσ_mem_Ioc j).1) (abs_nonneg _)))

  
  have hc_seq_partial : ∀ (j : ℕ) (k : ℤ),
      c_seq j k = uTruncCoeff R P k + ∑ i ∈ Finset.range j, Δc i k := by
    intro j
    induction j with
    | zero =>
      intro k
      simp [c_seq, iter]
    | succ j ih =>
      intro k
      change c_seq j k + Δc j k = _
      rw [ih k, Finset.sum_range_succ, add_assoc]

  have h_tail_diff : ∀ (j : ℕ) (x : ℝ),
      |fourierSeriesℝ c_star x - fourierSeriesℝ (c_seq j) x| ≤
        4 * ((P : ℝ) ^ 34)⁻¹ * q ^ j := by
    intro j x
    have h_coeff_tail : ∀ k : ℤ, c_star k - c_seq j k = ∑' i : ℕ, Δc (i + j) k := by
      intro k
      rw [hc_seq_partial j k]
      dsimp [c_star, Pi.add_apply, d_star]
      rw [← Summable.sum_add_tsum_nat_add j (hΔc_sum k)]
      ring
    let g_tail : ℕ × ℤ → ℝ := fun p => ‖Δc (p.1 + j) p.2‖
    have hg_nn : 0 ≤ g_tail := fun _ => norm_nonneg _
    have hg_le_f : ∀ (i : ℕ) (k : ℤ), g_tail (i, k) ≤ f_2d (i + j, k) := by
      intro i k
      dsimp [g_tail, f_2d]
      exact le_mul_of_one_le_right (norm_nonneg _)
        (Real.one_le_exp (by dsimp [σ_inf]; positivity))
    have hg_row_sum : ∀ i : ℕ, Summable (fun k : ℤ => g_tail (i, k)) :=
      fun i => Summable.of_nonneg_of_le (fun _ => norm_nonneg _)
        (fun k => hg_le_f i k) (hf_row_sum (i + j))
    have hg_row_le : ∀ i : ℕ,
        (∑' k : ℤ, g_tail (i, k)) ≤ (2 * ((P : ℝ) ^ 34)⁻¹ * q ^ j) * q ^ i := by
      intro i
      calc (∑' k : ℤ, g_tail (i, k))
          ≤ ∑' k : ℤ, f_2d (i + j, k) :=
            Summable.tsum_le_tsum (fun k => hg_le_f i k) (hg_row_sum i) (hf_row_sum (i + j))
        _ ≤ 2 * ((P : ℝ) ^ 34)⁻¹ * q ^ (i + j) := hf_row_le (i + j)
        _ = (2 * ((P : ℝ) ^ 34)⁻¹ * q ^ j) * q ^ i := by rw [pow_add]; ring
    have h_tail_geom : Summable (fun i : ℕ => (2 * ((P : ℝ) ^ 34)⁻¹ * q ^ j) * q ^ i) :=
      (summable_geometric_of_lt_one hq_nn hq_lt_one).mul_left _
    have hg_outer_sum : Summable (fun i : ℕ => ∑' k : ℤ, g_tail (i, k)) :=
      Summable.of_nonneg_of_le (fun _ => tsum_nonneg (fun _ => norm_nonneg _))
        hg_row_le h_tail_geom
    have hg_2d_sum : Summable g_tail :=
      (summable_prod_of_nonneg hg_nn).mpr ⟨hg_row_sum, hg_outer_sum⟩
    have hg_swap :=
      (summable_prod_of_nonneg (fun p : ℤ × ℕ => hg_nn p.swap)).mp hg_2d_sum.prod_symm
    have h_norm_tail_le : ∀ k : ℤ, ‖c_star k - c_seq j k‖ ≤ ∑' i : ℕ, g_tail (i, k) := by
      intro k
      rw [h_coeff_tail k]
      exact norm_tsum_le_tsum_norm (hg_swap.1 k)
    have h_diff_sum : Summable (fun k : ℤ => ‖c_star k - c_seq j k‖) :=
      Summable.of_nonneg_of_le (fun _ => norm_nonneg _) h_norm_tail_le hg_swap.2
    calc |fourierSeriesℝ c_star x - fourierSeriesℝ (c_seq j) x|
        ≤ ∑' k : ℤ, ‖c_star k - c_seq j k‖ :=
          h_real_diff_l1 c_star (c_seq j) hc_star_sum (hc_seq_sum j) x
      _ ≤ ∑' k : ℤ, ∑' i : ℕ, g_tail (i, k) :=
          Summable.tsum_le_tsum h_norm_tail_le h_diff_sum hg_swap.2
      _ = ∑' i : ℕ, ∑' k : ℤ, g_tail (i, k) :=
          Summable.tsum_comm (f := fun i k => g_tail (i, k)) hg_2d_sum
      _ ≤ ∑' i : ℕ, ((2 * ((P : ℝ) ^ 34)⁻¹ * q ^ j) * q ^ i) :=
          Summable.tsum_le_tsum hg_row_le hg_outer_sum h_tail_geom
      _ = (2 * ((P : ℝ) ^ 34)⁻¹ * q ^ j) * ∑' i : ℕ, q ^ i := tsum_mul_left
      _ ≤ (2 * ((P : ℝ) ^ 34)⁻¹ * q ^ j) * 2 :=
          mul_le_mul_of_nonneg_left hq_geom_le (by positivity)
      _ = 4 * ((P : ℝ) ^ 34)⁻¹ * q ^ j := by ring

  
  have hc_star_sm34 : IsPeriodicSmoothBounded 17 (3 * M / 4) (fourierSeriesℝ c_star) :=
    h_smooth_mono hc_star_sm (by linarith)

  have hc_star_C_zero : ∀ n : ℤ, (N : ℤ) ≤ |n| →
      H_sys.C_coeff n (fourierSeriesℝ c_star) = 0 := by
    intro n hn
    have h_bound_j : ∀ j : ℕ,
        ‖H_sys.C_coeff n (fourierSeriesℝ c_star)‖ ≤
          (4 * W_op.C_lip + 1) * ((P : ℝ) ^ 34)⁻¹ * q ^ j := by
      intro j
      rcases (iter j).2 with ⟨_, _, _, hc_j_sm, _, hc_j_res_sum, hc_j_res_le⟩
      have hc_j_sm34 : IsPeriodicSmoothBounded 17 (3 * M / 4) (fourierSeriesℝ (c_seq j)) :=
        h_smooth_mono hc_j_sm (le_trans (hB_le_half j) (by linarith))
      have h_lip := W_op.C_coeff_lip n hn (fourierSeriesℝ c_star) (fourierSeriesℝ (c_seq j))
        (4 * ((P : ℝ) ^ 34)⁻¹ * q ^ j) (by positivity) hc_star_sm34 hc_j_sm34 (h_tail_diff j)
      have h_res_j : ‖H_sys.C_coeff n (fourierSeriesℝ (c_seq j))‖ ≤
          ((P : ℝ) ^ 34)⁻¹ * q ^ j := by
        have h_term_le := Summable.le_tsum hc_j_res_sum n
          (fun m _ => by split_ifs <;> positivity)
        simp only [hn, ↓reduceIte] at h_term_le
        have h1 : ‖H_sys.C_coeff n (fourierSeriesℝ (c_seq j))‖ ≤
            ‖H_sys.C_coeff n (fourierSeriesℝ (c_seq j))‖ * Real.exp (σ_seq j * |(n : ℝ)|) :=
          le_mul_of_one_le_right (norm_nonneg _)
            (Real.one_le_exp (mul_nonneg (le_of_lt (hσ_mem_Ioc j).1) (abs_nonneg _)))
        exact le_trans h1 (le_trans h_term_le (by simpa [ε_seq, q] using hc_j_res_le))
      calc ‖H_sys.C_coeff n (fourierSeriesℝ c_star)‖
          ≤ ‖H_sys.C_coeff n (fourierSeriesℝ c_star) -
                H_sys.C_coeff n (fourierSeriesℝ (c_seq j))‖ +
              ‖H_sys.C_coeff n (fourierSeriesℝ (c_seq j))‖ := norm_le_norm_sub_add _ _
        _ ≤ W_op.C_lip * (4 * ((P : ℝ) ^ 34)⁻¹ * q ^ j) + ((P : ℝ) ^ 34)⁻¹ * q ^ j :=
              add_le_add h_lip h_res_j
        _ = (4 * W_op.C_lip + 1) * ((P : ℝ) ^ 34)⁻¹ * q ^ j := by ring
    have h_tendsto : Filter.Tendsto
        (fun j : ℕ => (4 * W_op.C_lip + 1) * ((P : ℝ) ^ 34)⁻¹ * q ^ j)
        Filter.atTop (nhds 0) := by
      simpa using (tendsto_pow_atTop_nhds_zero_of_lt_one hq_nn hq_lt_one).const_mul
        ((4 * W_op.C_lip + 1) * ((P : ℝ) ^ 34)⁻¹)
    exact norm_le_zero_iff.mp
      (le_of_tendsto_of_tendsto' tendsto_const_nhds h_tendsto h_bound_j)

  
  have hc_star_real_eq : ∀ x : ℝ, fourierSeriesℝ c_star x = uTable R x :=
    W_op.real_uniqueness c_star hu_smooth hu_sum hu_eq hc_star_conj hc_star_sum
      hc_star_low hc_star_sm34 hc_star_C_zero

  
  refine ⟨{
    σ_raw := σ_raw
    M_raw := M / 2
    σ_raw_pos := hσ_raw_pos
    M_raw_pos := by positivity
    u_raw := fourierSeriesℂ c_star
    u_raw_holo := hc_star_ext.1
    u_raw_real := fun x => by
      rw [hc_star_ext.2.1 x, hc_star_real_eq x]
      rfl
    u_raw_periodic := hc_star_ext.2.2.1
    u_raw_conj := hc_star_ext.2.2.2.1
    u_raw_bound := fun z hz => by
      have hb0 := hc_star_ext.2.2.2.2 0 (by decide) z hz
      have hb1 := hc_star_ext.2.2.2.2 1 (by decide) z hz
      rw [iteratedDeriv_zero] at hb0
      rw [iteratedDeriv_succ, iteratedDeriv_zero] at hb1
      exact ⟨hb0, hb1⟩
  }⟩

theorem complex_lazutkin_support_strip (Ω : Set Plane)
    (R : RationalCollarData Ω)
    (U_data : AnalyticLogSpeedData R) :
    Nonempty (AnalyticBoundaryData Ω) :=
by
  
  
  
  have hStrip_eq : ∀ H : ℝ, horizStrip H = Complex.im ⁻¹' Set.Ioo (-H) H := by
    intro H; ext s; simp [horizStrip, abs_lt]
  have hStrip_open : ∀ H : ℝ, IsOpen (horizStrip H) := by
    intro H; rw [hStrip_eq]; exact isOpen_Ioo.preimage Complex.continuous_im
  have hStrip_convex : ∀ H : ℝ, Convex ℝ (horizStrip H) := by
    intro H; rw [hStrip_eq]; exact (convex_Ioo (-H) H).linear_preimage Complex.imCLM.toLinearMap
  have hStrip_real : ∀ {H : ℝ}, 0 < H → ∀ x : ℝ, (x : ℂ) ∈ horizStrip H := by
    intro H hH x; simp [horizStrip, hH]
  have hStrip_zero : ∀ {H : ℝ}, 0 < H → (0 : ℂ) ∈ horizStrip H := by
    intro H hH; simpa using hStrip_real hH 0
  have hStrip_add_two_pi : ∀ {H : ℝ} {z : ℂ}, z ∈ horizStrip H → z + 2 * Real.pi ∈ horizStrip H := by
    intro H z hz; simpa [horizStrip] using hz
  have hStrip_conj : ∀ {H : ℝ} {z : ℂ}, z ∈ horizStrip H → starRingEnd ℂ z ∈ horizStrip H := by
    intro H z hz; simpa [horizStrip] using hz
  have hStrip_mono : ∀ {H₁ H₂ : ℝ}, H₁ ≤ H₂ → horizStrip H₁ ⊆ horizStrip H₂ := by
    intro H₁ H₂ hle z hz; exact lt_of_lt_of_le hz hle
  have hStrip_const : ∀ {H : ℝ} {F : ℂ → ℂ}, 0 < H →
      (∀ z ∈ horizStrip H, HasDerivAt F 0 z) → ∀ z ∈ horizStrip H, F z = F 0 := by
    intro H F hH hF z hz
    have hbound := Convex.norm_image_sub_le_of_norm_hasDerivWithin_le
      (fun w hw => (hF w hw).hasDerivWithinAt)
      (fun _ _ => le_rfl)
      (hStrip_convex H) (hStrip_zero hH) hz
    simpa [norm_zero, zero_mul, sub_eq_zero] using hbound
  have hHasDerivAt_conj : ∀ {f : ℂ → ℂ} {f' z : ℂ},
      HasDerivAt f f' (starRingEnd ℂ z) →
      HasDerivAt (fun w => starRingEnd ℂ (f (starRingEnd ℂ w))) (starRingEnd ℂ f') z := by
    intro f f' z hf
    simpa [Function.comp_def] using hf.conj_conj
  have hHasDerivAt_shift_ℂ : ∀ {f : ℂ → ℂ} {f' w c : ℂ},
      HasDerivAt f f' (w + c) → HasDerivAt (fun ζ => f (ζ + c)) f' w := by
    intro f f' w c hf
    have hc : HasDerivAt (fun ζ : ℂ => ζ + c) 1 w := by
      convert (hasDerivAt_id' w).add (hasDerivAt_const w c) using 1
      ring
    have hcomp := hf.comp w hc
    rw [mul_one] at hcomp
    exact hcomp
  have hHasDerivAt_shift_ℝ : ∀ {f : ℝ → ℝ} {f' x c : ℝ},
      HasDerivAt f f' (x + c) → HasDerivAt (fun y => f (y + c)) f' x := by
    intro f f' x c hf
    have hc : HasDerivAt (fun y : ℝ => y + c) 1 x := by
      convert (hasDerivAt_id' x).add (hasDerivAt_const x c) using 1
      ring
    have hcomp := hf.comp x hc
    rw [mul_one] at hcomp
    exact hcomp

  
  
  
  let σ₁ : ℝ := U_data.σ_raw
  let M₁ : ℝ := U_data.M_raw
  have hσ₁ : 0 < σ₁ := U_data.σ_raw_pos
  have hM₁ : 0 < M₁ := U_data.M_raw_pos
  let g : ℂ → ℂ := fun z => Complex.exp (U_data.u_raw z)
  have hg_holo : DifferentiableOn ℂ g (horizStrip σ₁) :=
    Complex.differentiable_exp.comp_differentiableOn U_data.u_raw_holo
  obtain ⟨F₀, hF₀_within⟩ :=
    (hStrip_convex σ₁).exists_forall_hasDerivWithinAt hg_holo
  have hF₀_deriv : ∀ z ∈ horizStrip σ₁, HasDerivAt F₀ (g z) z :=
    fun z hz => (hF₀_within z hz).hasDerivAt ((hStrip_open σ₁).mem_nhds hz)
  let ϕ_ℂ : ℂ → ℂ := fun z => F₀ z - F₀ 0 + (R.ϕ 0 : ℂ)
  have hϕ_ℂ_zero : ϕ_ℂ 0 = (R.ϕ 0 : ℂ) := by simp [ϕ_ℂ]
  have hϕ_ℂ_hasDeriv : ∀ z ∈ horizStrip σ₁, HasDerivAt ϕ_ℂ (g z) z :=
    fun z hz => ((hF₀_deriv z hz).sub_const (F₀ 0)).add_const (R.ϕ 0 : ℂ)
  have hϕ_ℂ_holo : DifferentiableOn ℂ ϕ_ℂ (horizStrip σ₁) :=
    fun z hz => (hϕ_ℂ_hasDeriv z hz).differentiableAt.differentiableWithinAt
  have hϕ_ℂ_deriv : ∀ z ∈ horizStrip σ₁, deriv ϕ_ℂ z = g z :=
    fun z hz => (hϕ_ℂ_hasDeriv z hz).deriv

  have hϕ_diff : Differentiable ℝ R.ϕ := R.ϕ_smooth.differentiable (by simp)
  have hϕ_ℂ_real : ∀ x : ℝ, ϕ_ℂ x = R.ϕ x := by
    let d : ℝ → ℂ := fun y => ϕ_ℂ y - (R.ϕ y : ℂ)
    have hd_deriv : ∀ y : ℝ, HasDerivAt d 0 y := by
      intro y
      have h1 : HasDerivAt (fun t : ℝ => ϕ_ℂ t) (g y) y :=
        (hϕ_ℂ_hasDeriv y (hStrip_real hσ₁ y)).comp_ofReal
      have hgy : g y = ((deriv R.ϕ y : ℝ) : ℂ) := by
        dsimp [g]
        rw [U_data.u_raw_real y, ← Complex.ofReal_exp, Real.exp_log (R.ϕ_deriv_pos y)]
      rw [hgy] at h1
      have h2 : HasDerivAt (fun t : ℝ => (R.ϕ t : ℂ)) ((deriv R.ϕ y : ℝ) : ℂ) y :=
        (hϕ_diff y).hasDerivAt.ofReal_comp
      convert h1.sub h2 using 1
      ring
    have hd_const : ∀ x : ℝ, d x = d 0 := fun x =>
      is_const_of_deriv_eq_zero (fun y => (hd_deriv y).differentiableAt)
        (fun y => (hd_deriv y).deriv) x 0
    intro x
    have hx := hd_const x
    have h0 : d 0 = 0 := by simp [d, hϕ_ℂ_zero]
    rw [h0] at hx
    exact sub_eq_zero.mp hx

  have hϕ_ℂ_qper : ∀ z ∈ horizStrip σ₁, ϕ_ℂ (z + 2 * Real.pi) = ϕ_ℂ z + 2 * Real.pi := by
    let Q : ℂ → ℂ := fun w => ϕ_ℂ (w + 2 * Real.pi) - ϕ_ℂ w - 2 * Real.pi
    have hQ_deriv : ∀ w ∈ horizStrip σ₁, HasDerivAt Q 0 w := by
      intro w hw
      have hw' : w + 2 * Real.pi ∈ horizStrip σ₁ := hStrip_add_two_pi hw
      have h1 : HasDerivAt (fun ζ => ϕ_ℂ (ζ + 2 * Real.pi)) (g (w + 2 * Real.pi)) w :=
        hHasDerivAt_shift_ℂ (hϕ_ℂ_hasDeriv (w + 2 * Real.pi) hw')
      have hg_per : g (w + 2 * Real.pi) = g w := by
        dsimp [g]; rw [U_data.u_raw_periodic w hw]
      rw [hg_per] at h1
      convert (h1.sub (hϕ_ℂ_hasDeriv w hw)).sub_const (2 * Real.pi : ℂ) using 1
      ring
    intro z hz
    have hQz := hStrip_const hσ₁ hQ_deriv z hz
    have hQ0 : Q 0 = 0 := by
      dsimp [Q]
      have h2pi : (0 : ℂ) + 2 * Real.pi = ((2 * Real.pi : ℝ) : ℂ) := by push_cast; ring
      rw [h2pi, hϕ_ℂ_real (2 * Real.pi), hϕ_ℂ_zero]
      have hqp := R.ϕ_quasiperiodic 0
      rw [zero_add] at hqp
      rw [hqp]
      push_cast; ring
    rw [hQ0] at hQz
    dsimp [Q] at hQz
    linear_combination hQz

  have hϕ_ℂ_conj : ∀ z ∈ horizStrip σ₁, ϕ_ℂ (starRingEnd ℂ z) = starRingEnd ℂ (ϕ_ℂ z) := by
    let C_sym : ℂ → ℂ := fun w => starRingEnd ℂ (ϕ_ℂ (starRingEnd ℂ w)) - ϕ_ℂ w
    have hC_deriv : ∀ w ∈ horizStrip σ₁, HasDerivAt C_sym 0 w := by
      intro w hw
      have h1 := hHasDerivAt_conj (hϕ_ℂ_hasDeriv (starRingEnd ℂ w) (hStrip_conj hw))
      have hg_conj : starRingEnd ℂ (g (starRingEnd ℂ w)) = g w := by
        dsimp [g]
        rw [← Complex.exp_conj, U_data.u_raw_conj w hw]
        simp
      rw [hg_conj] at h1
      convert h1.sub (hϕ_ℂ_hasDeriv w hw) using 1
      ring
    intro z hz
    have hCz := hStrip_const hσ₁ hC_deriv (starRingEnd ℂ z) (hStrip_conj hz)
    have hC0 : C_sym 0 = 0 := by
      simp [C_sym, hϕ_ℂ_zero]
    rw [hC0] at hCz
    dsimp [C_sym] at hCz
    simp only [RingHomCompTriple.comp_apply, RingHom.id_apply] at hCz
    exact (sub_eq_zero.mp hCz).symm

  have hg_norm : ∀ z ∈ horizStrip σ₁, ‖g z‖ ≤ Real.exp M₁ := by
    intro z hz
    dsimp [g]
    rw [Complex.norm_exp]
    exact Real.exp_le_exp.mpr ((Complex.re_le_norm _).trans (U_data.u_raw_bound z hz).1)

  have h_sub_re_norm : ∀ z : ℂ, ‖z - (z.re : ℂ)‖ = |z.im| := by
    intro z
    have h_eq : z - (z.re : ℂ) = (z.im : ℂ) * Complex.I := by
      apply Complex.ext <;> simp
    rw [h_eq, norm_mul, Complex.norm_real, Real.norm_eq_abs, Complex.norm_I, mul_one]

  have hϕ_ℂ_im_le : ∀ z ∈ horizStrip σ₁, |(ϕ_ℂ z).im| ≤ Real.exp M₁ * |z.im| := by
    intro z hz
    have hmv := Convex.norm_image_sub_le_of_norm_hasDerivWithin_le
      (fun w hw => (hϕ_ℂ_hasDeriv w hw).hasDerivWithinAt)
      hg_norm (hStrip_convex σ₁) (hStrip_real hσ₁ z.re) hz
    rw [h_sub_re_norm z] at hmv
    have him_re : (ϕ_ℂ (z.re : ℂ)).im = 0 := by rw [hϕ_ℂ_real z.re]; simp
    calc |(ϕ_ℂ z).im|
        = |(ϕ_ℂ z - ϕ_ℂ (z.re : ℂ)).im| := by simp [him_re]
      _ ≤ ‖ϕ_ℂ z - ϕ_ℂ (z.re : ℂ)‖ := Complex.abs_im_le_norm _
      _ ≤ Real.exp M₁ * |z.im| := hmv

  have hϕ'_per : Function.Periodic (deriv R.ϕ) (2 * Real.pi) := by
    intro x
    have h1 : HasDerivAt (fun y => R.ϕ (y + 2 * Real.pi)) (deriv R.ϕ (x + 2 * Real.pi)) x :=
      hHasDerivAt_shift_ℝ (hϕ_diff (x + 2 * Real.pi)).hasDerivAt
    have h2 : HasDerivAt (fun y => R.ϕ y + 2 * Real.pi) (deriv R.ϕ x) x :=
      (hϕ_diff x).hasDerivAt.add_const (2 * Real.pi)
    have h12 : (fun y => R.ϕ (y + 2 * Real.pi)) = (fun y => R.ϕ y + 2 * Real.pi) :=
      funext R.ϕ_quasiperiodic
    rw [h12] at h1
    exact h1.unique h2

  have hϕ'_cont : Continuous (deriv R.ϕ) := R.ϕ_smooth.continuous_deriv (by simp)
  obtain ⟨x_min, _, hx_min⟩ :=
    isCompact_Icc.exists_isMinOn ⟨(0 : ℝ), le_rfl, Real.two_pi_pos.le⟩ hϕ'_cont.continuousOn
  let m_ϕ : ℝ := deriv R.ϕ x_min
  have hm_ϕ_pos : 0 < m_ϕ := R.ϕ_deriv_pos x_min
  have hm_ϕ_le : ∀ x : ℝ, m_ϕ ≤ deriv R.ϕ x := by
    intro x
    obtain ⟨y, hy, hxy⟩ := hϕ'_per.exists_mem_Ico₀ Real.two_pi_pos x
    rw [hxy]
    exact hx_min (Set.Ico_subset_Icc_self hy)

  have hϕ_surj : Function.Surjective R.ϕ := by
    let f_lin : ℝ → ℝ := fun x => R.ϕ x - m_ϕ * x
    have hf_lin_d : ∀ x : ℝ, HasDerivAt f_lin (deriv R.ϕ x - m_ϕ) x := by
      intro x
      convert (hϕ_diff x).hasDerivAt.sub ((hasDerivAt_id' x).const_mul m_ϕ) using 1
      ring
    have h_mono : Monotone f_lin := by
      apply monotone_of_deriv_nonneg (fun x => (hf_lin_d x).differentiableAt)
      intro x
      rw [(hf_lin_d x).deriv]
      linarith [hm_ϕ_le x]
    intro θ
    let B : ℝ := |θ - R.ϕ 0| / m_ϕ
    have hB_nonneg : 0 ≤ B := div_nonneg (abs_nonneg _) hm_ϕ_pos.le
    have hmB : m_ϕ * B = |θ - R.ϕ 0| := mul_div_cancel₀ _ hm_ϕ_pos.ne'
    have h_lo_mono : f_lin (-B) ≤ f_lin 0 := h_mono (neg_nonpos.mpr hB_nonneg)
    have h_hi_mono : f_lin 0 ≤ f_lin B := h_mono hB_nonneg
    dsimp [f_lin] at h_lo_mono h_hi_mono
    have h_lo : R.ϕ (-B) ≤ θ := by
      have habs : -(θ - R.ϕ 0) ≤ |θ - R.ϕ 0| := neg_le_abs _
      linarith
    have h_hi : θ ≤ R.ϕ B := by
      have habs : θ - R.ϕ 0 ≤ |θ - R.ϕ 0| := le_abs_self _
      linarith
    obtain ⟨x₀, _, hx₀⟩ := intermediate_value_Icc (by linarith : -B ≤ B)
      hϕ_diff.continuous.continuousOn ⟨h_lo, h_hi⟩
    exact ⟨x₀, hx₀⟩

  let σ₂ : ℝ := min (σ₁ / 2) (1 / (4 * M₁))
  have hσ₂_pos : 0 < σ₂ := lt_min (half_pos hσ₁) (by positivity)
  have hσ₂_le_half_σ₁ : σ₂ ≤ σ₁ / 2 := min_le_left _ _
  have hσ₂_le_σ₁ : σ₂ ≤ σ₁ := hσ₂_le_half_σ₁.trans (by linarith)
  have hσ₂_le_inv : σ₂ ≤ 1 / (4 * M₁) := min_le_right _ _
  let c₁ : ℝ := m_ϕ / 4
  have hc₁_pos : 0 < c₁ := by positivity
  let L₂ : ℝ := M₁ * Real.exp M₁
  have hL₂_pos : 0 < L₂ := by positivity

  have hre_deriv_lower : ∀ z ∈ horizStrip σ₂, c₁ ≤ (deriv ϕ_ℂ z).re := by
    intro z hz
    have hz₁ : z ∈ horizStrip σ₁ := hStrip_mono hσ₂_le_σ₁ hz
    have hu_mv := Convex.norm_image_sub_le_of_norm_hasDerivWithin_le
      (fun w hw =>
        (U_data.u_raw_holo.differentiableAt ((hStrip_open σ₁).mem_nhds hw)).hasDerivAt.hasDerivWithinAt)
      (fun w hw => (U_data.u_raw_bound w hw).2)
      (hStrip_convex σ₁) (hStrip_real hσ₁ z.re) hz₁
    rw [h_sub_re_norm z] at hu_mv
    let δ : ℂ := U_data.u_raw z - U_data.u_raw (z.re : ℂ)
    have hδ_norm : ‖δ‖ ≤ 1 / 4 := by
      have hzim_le : |z.im| ≤ 1 / (4 * M₁) := (le_of_lt hz).trans hσ₂_le_inv
      calc ‖δ‖ ≤ M₁ * |z.im| := hu_mv
        _ ≤ M₁ * (1 / (4 * M₁)) := mul_le_mul_of_nonneg_left hzim_le hM₁.le
        _ = 1 / 4 := by field_simp [hM₁.ne']
    have hδ_re : |δ.re| ≤ 1 / 4 := (Complex.abs_re_le_norm δ).trans hδ_norm
    have hδ_im : |δ.im| ≤ 1 / 4 := (Complex.abs_im_le_norm δ).trans hδ_norm
    have hexp_δ : 1 / 2 ≤ Real.exp δ.re := by
      have h1 := (abs_le.mp hδ_re).1
      have h2 := Real.add_one_le_exp δ.re
      linarith
    have hcos_δ : 1 / 2 ≤ Real.cos δ.im := by
      obtain ⟨h1, h2⟩ := abs_le.mp hδ_im
      have h3 := Real.one_sub_sq_div_two_le_cos (x := δ.im)
      nlinarith
    have hprod_δ : 1 / 4 ≤ Real.exp δ.re * Real.cos δ.im := by nlinarith
    have hu_decomp : U_data.u_raw z = (Real.log (deriv R.ϕ z.re) : ℂ) + δ := by
      simp [δ, U_data.u_raw_real]
    have hre_eq : (deriv ϕ_ℂ z).re = deriv R.ϕ z.re * (Real.exp δ.re * Real.cos δ.im) := by
      rw [hϕ_ℂ_deriv z hz₁]
      dsimp [g]
      rw [hu_decomp, Complex.exp_re]
      simp only [Complex.add_re, Complex.ofReal_re, Complex.add_im, Complex.ofReal_im, zero_add]
      rw [Real.exp_add, Real.exp_log (R.ϕ_deriv_pos z.re), mul_assoc]
    rw [hre_eq]
    have hm_le := hm_ϕ_le z.re
    dsimp [c₁]
    nlinarith

  have h_deriv2_hasDeriv :
      ∀ z ∈ horizStrip σ₁, HasDerivAt (deriv ϕ_ℂ) (g z * deriv U_data.u_raw z) z := by
    intro z hz
    have hu_d : HasDerivAt U_data.u_raw (deriv U_data.u_raw z) z :=
      (U_data.u_raw_holo.differentiableAt ((hStrip_open σ₁).mem_nhds hz)).hasDerivAt
    have hg_d : HasDerivAt g (g z * deriv U_data.u_raw z) z := hu_d.cexp
    exact hg_d.congr_of_eventuallyEq
      (Filter.eventually_of_mem ((hStrip_open σ₁).mem_nhds hz) hϕ_ℂ_deriv)

  have h_deriv2_norm : ∀ z ∈ horizStrip σ₁, ‖g z * deriv U_data.u_raw z‖ ≤ L₂ := by
    intro z hz
    rw [norm_mul, show L₂ = Real.exp M₁ * M₁ by dsimp [L₂]; ring]
    exact mul_le_mul (hg_norm z hz) (U_data.u_raw_bound z hz).2 (norm_nonneg _) (Real.exp_pos _).le

  
  
  
  have hϕ_ℂ_inj : Set.InjOn ϕ_ℂ (horizStrip σ₂) := by
    intro z₁ hz₁ z₂ hz₂ h_eq
    by_contra hne
    have hd_ne : z₂ - z₁ ≠ 0 := sub_ne_zero.mpr (Ne.symm hne)
    let γ : ℝ → ℝ := fun t => ((ϕ_ℂ (z₁ + (t : ℂ) * (z₂ - z₁)) - ϕ_ℂ z₁) / (z₂ - z₁)).re
    have hζ_mem : ∀ t ∈ Set.Icc (0 : ℝ) 1, z₁ + (t : ℂ) * (z₂ - z₁) ∈ horizStrip σ₂ := by
      intro t ht
      have hconv_eq : (1 - t) • z₁ + t • z₂ = z₁ + (t : ℂ) * (z₂ - z₁) := by
        simp [Complex.real_smul]; ring
      rw [← hconv_eq]
      exact (hStrip_convex σ₂) hz₁ hz₂ (sub_nonneg.mpr ht.2) ht.1 (sub_add_cancel 1 t)
    have hγ_deriv : ∀ t ∈ Set.Icc (0 : ℝ) 1,
        HasDerivAt γ (deriv ϕ_ℂ (z₁ + (t : ℂ) * (z₂ - z₁))).re t := by
      intro t ht
      let ζ : ℂ := z₁ + (t : ℂ) * (z₂ - z₁)
      have hζ₁ : ζ ∈ horizStrip σ₁ := hStrip_mono hσ₂_le_σ₁ (hζ_mem t ht)
      have h_line : HasDerivAt (fun s : ℝ => z₁ + (s : ℂ) * (z₂ - z₁)) (z₂ - z₁) t := by
        convert (((hasDerivAt_id' t).ofReal_comp).mul_const (z₂ - z₁)).const_add z₁ using 1
        simp
      have h_comp : HasDerivAt (fun s : ℝ => ϕ_ℂ (z₁ + (s : ℂ) * (z₂ - z₁)))
          ((z₂ - z₁) * deriv ϕ_ℂ ζ) t := by
        have hs := (hϕ_ℂ_hasDeriv ζ hζ₁).scomp t h_line
        rw [← hϕ_ℂ_deriv ζ hζ₁, smul_eq_mul] at hs
        exact hs
      have h_quot : HasDerivAt
          (fun s : ℝ => (ϕ_ℂ (z₁ + (s : ℂ) * (z₂ - z₁)) - ϕ_ℂ z₁) / (z₂ - z₁))
          (deriv ϕ_ℂ ζ) t := by
        convert (h_comp.sub_const (ϕ_ℂ z₁)).div_const (z₂ - z₁) using 1
        exact (mul_div_cancel_left₀ (deriv ϕ_ℂ ζ) hd_ne).symm
      exact (Complex.reCLM.hasFDerivAt (x := _)).comp_hasDerivAt t h_quot
    have hγ_cont : ContinuousOn γ (Set.Icc 0 1) :=
      fun t ht => (hγ_deriv t ht).continuousAt.continuousWithinAt
    obtain ⟨t_star, ht_star, h_slope⟩ := exists_hasDerivAt_eq_slope γ
      (fun t => (deriv ϕ_ℂ (z₁ + (t : ℂ) * (z₂ - z₁))).re) zero_lt_one hγ_cont
      (fun t ht => hγ_deriv t (Set.Ioo_subset_Icc_self ht))
    have hγ0 : γ 0 = 0 := by simp [γ]
    have hγ1 : γ 1 = 0 := by simp [γ, h_eq]
    rw [hγ1, hγ0, sub_self, zero_div] at h_slope
    have h_low := hre_deriv_lower _ (hζ_mem t_star (Set.Ioo_subset_Icc_self ht_star))
    linarith

  have h_deriv_lip : ∀ ζ₁ ∈ horizStrip σ₂, ∀ ζ₂ ∈ horizStrip σ₂,
      ‖deriv ϕ_ℂ ζ₁ - deriv ϕ_ℂ ζ₂‖ ≤ L₂ * ‖ζ₁ - ζ₂‖ := by
    intro ζ₁ hζ₁ ζ₂ hζ₂
    exact Convex.norm_image_sub_le_of_norm_hasDerivWithin_le
      (fun w hw => (h_deriv2_hasDeriv w (hStrip_mono hσ₂_le_σ₁ hw)).hasDerivWithinAt)
      (fun w hw => h_deriv2_norm w (hStrip_mono hσ₂_le_σ₁ hw))
      (hStrip_convex σ₂) hζ₂ hζ₁

  let ρ : ℝ := min (σ₂ / 2) (c₁ / (2 * L₂))
  have hρ_pos : 0 < ρ := lt_min (half_pos hσ₂_pos) (by positivity)
  have hρ_le_σ₂ : ρ ≤ σ₂ / 2 := min_le_left _ _
  have hρ_le_lip : ρ ≤ c₁ / (2 * L₂) := min_le_right _ _
  let s_h : ℝ := c₁ * ρ / 4
  have hs_h_pos : 0 < s_h := by positivity

  have h_surj_strip : ∀ w ∈ horizStrip (2 * s_h), ∃ z ∈ horizStrip σ₂, ϕ_ℂ z = w := by
    intro w hw
    obtain ⟨x₀, hx₀⟩ := hϕ_surj w.re
    let B : Set ℂ := Metric.closedBall (x₀ : ℂ) ρ
    have hB_sub : B ⊆ horizStrip σ₂ := by
      intro z hz
      have hdist : ‖z - (x₀ : ℂ)‖ ≤ ρ := by simpa [B, dist_eq_norm] using hz
      have him : |z.im| ≤ ‖z - (x₀ : ℂ)‖ := by
        have h1 : z.im = (z - (x₀ : ℂ)).im := by simp
        rw [h1]; exact Complex.abs_im_le_norm _
      change |z.im| < σ₂
      linarith
    have hx₀_B : (x₀ : ℂ) ∈ B := Metric.mem_closedBall_self hρ_pos.le
    have hx₀_σ₂ : (x₀ : ℂ) ∈ horizStrip σ₂ := hB_sub hx₀_B
    let A₀ : ℂ := deriv ϕ_ℂ (x₀ : ℂ)
    have hc₁_le_A₀ : c₁ ≤ ‖A₀‖ :=
      (hre_deriv_lower (x₀ : ℂ) hx₀_σ₂).trans ((le_abs_self _).trans (Complex.abs_re_le_norm A₀))
    have hA₀_pos : 0 < ‖A₀‖ := lt_of_lt_of_le hc₁_pos hc₁_le_A₀
    have hA₀_ne : A₀ ≠ 0 := norm_pos_iff.mp hA₀_pos
    have hA₀_inv_le : ‖A₀⁻¹‖ ≤ c₁⁻¹ := by
      rw [norm_inv]; exact inv_anti₀ hc₁_pos hc₁_le_A₀
    let T_w : ℂ → ℂ := fun z => z + A₀⁻¹ * (w - ϕ_ℂ z)
    have hT_deriv : ∀ z ∈ B, HasDerivAt T_w (1 - A₀⁻¹ * deriv ϕ_ℂ z) z := by
      intro z hz
      have hz₁ : z ∈ horizStrip σ₁ := hStrip_mono hσ₂_le_σ₁ (hB_sub hz)
      have hd : HasDerivAt (fun ζ => ζ + A₀⁻¹ * (w - ϕ_ℂ ζ))
          (1 + A₀⁻¹ * (0 - g z)) z :=
        (hasDerivAt_id' z).add (((hasDerivAt_const z w).sub (hϕ_ℂ_hasDeriv z hz₁)).const_mul A₀⁻¹)
      rw [← hϕ_ℂ_deriv z hz₁] at hd
      convert hd using 1
      ring
    have hT_deriv_le : ∀ z ∈ B, ‖1 - A₀⁻¹ * deriv ϕ_ℂ z‖ ≤ 1 / 2 := by
      intro z hz
      have h_alg : 1 - A₀⁻¹ * deriv ϕ_ℂ z = A₀⁻¹ * (A₀ - deriv ϕ_ℂ z) := by
        field_simp [hA₀_ne]
      rw [h_alg, norm_mul]
      have hdist : ‖(x₀ : ℂ) - z‖ ≤ ρ := by
        rw [norm_sub_rev]; simpa [B, dist_eq_norm] using hz
      have hdlip := h_deriv_lip (x₀ : ℂ) hx₀_σ₂ z (hB_sub hz)
      calc ‖A₀⁻¹‖ * ‖A₀ - deriv ϕ_ℂ z‖
          ≤ c₁⁻¹ * (L₂ * ‖(x₀ : ℂ) - z‖) :=
            mul_le_mul hA₀_inv_le hdlip (norm_nonneg _) (inv_nonneg.mpr hc₁_pos.le)
        _ ≤ c₁⁻¹ * (L₂ * ρ) := by gcongr
        _ ≤ c₁⁻¹ * (L₂ * (c₁ / (2 * L₂))) := by gcongr
        _ = 1 / 2 := by field_simp [hc₁_pos.ne', hL₂_pos.ne']
    have hT_lip_norm : ∀ z₁ ∈ B, ∀ z₂ ∈ B, ‖T_w z₁ - T_w z₂‖ ≤ (1 / 2 : ℝ) * ‖z₁ - z₂‖ := by
      intro z₁ hz₁ z₂ hz₂
      exact Convex.norm_image_sub_le_of_norm_hasDerivWithin_le
        (fun ζ hζ => (hT_deriv ζ hζ).hasDerivWithinAt)
        hT_deriv_le (convex_closedBall (x₀ : ℂ) ρ) hz₂ hz₁
    have hT_center : ‖T_w (x₀ : ℂ) - (x₀ : ℂ)‖ ≤ ρ / 2 := by
      have h_sub_x₀ : T_w (x₀ : ℂ) - (x₀ : ℂ) = A₀⁻¹ * ((w.im : ℂ) * Complex.I) := by
        dsimp [T_w]
        rw [hϕ_ℂ_real x₀, hx₀]
        have hw_im : w - (w.re : ℂ) = (w.im : ℂ) * Complex.I := by
          apply Complex.ext <;> simp
        rw [hw_im]; ring
      rw [h_sub_x₀, norm_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs, Complex.norm_I, mul_one]
      have hw_lt : |w.im| ≤ c₁ * ρ / 2 := by
        have h1 : |w.im| < 2 * s_h := hw
        dsimp [s_h] at h1
        linarith
      calc ‖A₀⁻¹‖ * |w.im|
          ≤ c₁⁻¹ * (c₁ * ρ / 2) :=
            mul_le_mul hA₀_inv_le hw_lt (abs_nonneg _) (inv_nonneg.mpr hc₁_pos.le)
        _ = ρ / 2 := by field_simp [hc₁_pos.ne']
    have hMaps : Set.MapsTo T_w B B := by
      intro z hz
      have hz_dist : ‖z - (x₀ : ℂ)‖ ≤ ρ := by simpa [B, dist_eq_norm] using hz
      have h1 := hT_lip_norm z hz (x₀ : ℂ) hx₀_B
      have h2 : ‖T_w z - (x₀ : ℂ)‖ ≤ ρ := by
        calc ‖T_w z - (x₀ : ℂ)‖
            = ‖(T_w z - T_w (x₀ : ℂ)) + (T_w (x₀ : ℂ) - (x₀ : ℂ))‖ := by ring_nf
          _ ≤ ‖T_w z - T_w (x₀ : ℂ)‖ + ‖T_w (x₀ : ℂ) - (x₀ : ℂ)‖ := norm_add_le _ _
          _ ≤ (1 / 2 : ℝ) * ‖z - (x₀ : ℂ)‖ + ρ / 2 := add_le_add h1 hT_center
          _ ≤ (1 / 2 : ℝ) * ρ + ρ / 2 := by linarith
          _ = ρ := by ring
      simpa [B, dist_eq_norm] using h2
    have : CompleteSpace ↥B := Metric.isClosed_closedBall.completeSpace_coe
    have : Nonempty ↥B := ⟨⟨(x₀ : ℂ), hx₀_B⟩⟩
    let T_B : ↥B → ↥B := fun z => ⟨T_w z.1, hMaps z.2⟩
    have hLip_B : LipschitzWith (1 / 2 : NNReal) T_B := by
      refine LipschitzWith.of_dist_le_mul fun z₁ z₂ => ?_
      change dist (T_w z₁.1) (T_w z₂.1) ≤ ((1 / 2 : NNReal) : ℝ) * dist z₁.1 z₂.1
      simpa [dist_eq_norm] using hT_lip_norm z₁.1 z₁.2 z₂.1 z₂.2
    have hContr : ContractingWith (1 / 2 : NNReal) T_B := ⟨by norm_num, hLip_B⟩
    let z_fix : ↥B := ContractingWith.fixedPoint T_B hContr
    have hz_eq : T_w z_fix.1 = z_fix.1 :=
      congrArg Subtype.val (ContractingWith.fixedPoint_isFixedPt hContr)
    dsimp [T_w] at hz_eq
    have h_zero : A₀⁻¹ * (w - ϕ_ℂ z_fix.1) = 0 := by linear_combination hz_eq
    rcases mul_eq_zero.mp h_zero with hinv0 | hw0
    · exact False.elim (inv_ne_zero hA₀_ne hinv0)
    · exact ⟨z_fix.1, hB_sub z_fix.2, (sub_eq_zero.mp hw0).symm⟩

  let ψ_ℂ : ℂ → ℂ := Function.invFunOn ϕ_ℂ (horizStrip σ₂)
  have hψ_ϕ : ∀ z ∈ horizStrip σ₂, ψ_ℂ (ϕ_ℂ z) = z := hϕ_ℂ_inj.leftInvOn_invFunOn
  have hψ_maps : ∀ w ∈ horizStrip (2 * s_h), ψ_ℂ w ∈ horizStrip σ₂ :=
    fun w hw => (Function.invFunOn_pos (h_surj_strip w hw)).1
  have hϕ_ψ : ∀ w ∈ horizStrip (2 * s_h), ϕ_ℂ (ψ_ℂ w) = w :=
    fun w hw => (Function.invFunOn_pos (h_surj_strip w hw)).2
  have hψ_holo : DifferentiableOn ℂ ψ_ℂ (horizStrip (2 * s_h)) := by
    intro w hw
    let a : ℂ := ψ_ℂ w
    have ha : a ∈ horizStrip σ₂ := hψ_maps w hw
    have ha₁ : a ∈ horizStrip σ₁ := hStrip_mono hσ₂_le_σ₁ ha
    have ha_strict : HasStrictDerivAt ϕ_ℂ (deriv ϕ_ℂ a) a :=
      (hϕ_ℂ_holo.analyticAt ((hStrip_open σ₁).mem_nhds ha₁)).hasStrictDerivAt
    have hda_ne : deriv ϕ_ℂ a ≠ 0 := by
      intro h0
      have hlow := hre_deriv_lower a ha
      rw [h0, Complex.zero_re] at hlow
      linarith
    have hev_left : ∀ᶠ z in nhds a, ψ_ℂ (ϕ_ℂ z) = z :=
      Filter.eventually_of_mem ((hStrip_open σ₂).mem_nhds ha) hψ_ϕ
    have hψ_strict := ha_strict.to_local_left_inverse hda_ne hev_left
    rw [hϕ_ψ w hw] at hψ_strict
    exact hψ_strict.hasDerivAt.differentiableAt.differentiableWithinAt

  have hψ_real : ∀ x : ℝ, ψ_ℂ (R.ϕ x) = x := by
    intro x
    rw [← hϕ_ℂ_real x]
    exact hψ_ϕ (x : ℂ) (hStrip_real hσ₂_pos x)

  have hψ_qper : ∀ w ∈ horizStrip (2 * s_h), ψ_ℂ (w + 2 * Real.pi) = ψ_ℂ w + 2 * Real.pi := by
    intro w hw
    have hz : ψ_ℂ w ∈ horizStrip σ₂ := hψ_maps w hw
    have hz₁ : ψ_ℂ w ∈ horizStrip σ₁ := hStrip_mono hσ₂_le_σ₁ hz
    have h_step : ϕ_ℂ (ψ_ℂ w + 2 * Real.pi) = w + 2 * Real.pi := by
      rw [hϕ_ℂ_qper (ψ_ℂ w) hz₁, hϕ_ψ w hw]
    rw [← h_step]
    exact hψ_ϕ (ψ_ℂ w + 2 * Real.pi) (hStrip_add_two_pi hz)

  have hψ_conj : ∀ w ∈ horizStrip (2 * s_h), ψ_ℂ (starRingEnd ℂ w) = starRingEnd ℂ (ψ_ℂ w) := by
    intro w hw
    have hz : ψ_ℂ w ∈ horizStrip σ₂ := hψ_maps w hw
    have hz₁ : ψ_ℂ w ∈ horizStrip σ₁ := hStrip_mono hσ₂_le_σ₁ hz
    have h_step : ϕ_ℂ (starRingEnd ℂ (ψ_ℂ w)) = starRingEnd ℂ w := by
      rw [hϕ_ℂ_conj (ψ_ℂ w) hz₁, hϕ_ψ w hw]
    rw [← h_step]
    exact hψ_ϕ (starRingEnd ℂ (ψ_ℂ w)) (hStrip_conj hz)

  
  
  
  have h2sh_pos : 0 < 2 * s_h := by positivity
  let U_h : Set ℂ := horizStrip (2 * s_h)
  let rad_ℂ : ℂ → ℂ := fun w => (R.c : ℂ) * Complex.exp (-3 * U_data.u_raw (ψ_ℂ w))
  have hr_holo : DifferentiableOn ℂ rad_ℂ U_h := by
    have hu_ψ : DifferentiableOn ℂ (fun w => U_data.u_raw (ψ_ℂ w)) U_h :=
      U_data.u_raw_holo.comp hψ_holo (fun w hw => hStrip_mono hσ₂_le_σ₁ (hψ_maps w hw))
    exact (Complex.differentiable_exp.comp_differentiableOn (hu_ψ.const_mul (-3 : ℂ))).const_mul
      (R.c : ℂ)

  have hr_real : ∀ θ : ℝ, rad_ℂ θ = ((R.h θ + deriv (deriv R.h) θ : ℝ) : ℂ) := by
    intro θ
    obtain ⟨x, rfl⟩ := hϕ_surj θ
    dsimp [rad_ℂ]
    rw [hψ_real x, U_data.u_raw_real x]
    have hcast : (-3 : ℂ) * (Real.log (deriv R.ϕ x) : ℂ) =
        ((-3 * Real.log (deriv R.ϕ x) : ℝ) : ℂ) := by push_cast; ring
    rw [hcast, ← Complex.ofReal_exp, ← Complex.ofReal_mul]
    congr 1
    let p : ℝ := deriv R.ϕ x
    have hp_pos : 0 < p := R.ϕ_deriv_pos x
    have hp_ne : p ^ 3 ≠ 0 := pow_ne_zero 3 hp_pos.ne'
    apply mul_right_cancel₀ hp_ne
    have hexp_cancel : Real.exp (-3 * Real.log p) * p ^ 3 = 1 := by
      have hp_exp : p = Real.exp (Real.log p) := (Real.exp_log hp_pos).symm
      calc Real.exp (-3 * Real.log p) * p ^ 3
          = Real.exp (-3 * Real.log p) * (Real.exp (Real.log p)) ^ 3 := by rw [← hp_exp]
        _ = Real.exp (-3 * Real.log p) * Real.exp (3 * Real.log p) := by
            rw [← Real.exp_nat_mul]; norm_num
        _ = Real.exp (-3 * Real.log p + 3 * Real.log p) := (Real.exp_add _ _).symm
        _ = 1 := by simp
    calc R.c * Real.exp (-3 * Real.log p) * p ^ 3
        = R.c * (Real.exp (-3 * Real.log p) * p ^ 3) := by ring
      _ = R.c * 1 := by rw [hexp_cancel]
      _ = R.c := mul_one _
      _ = (R.h (R.ϕ x) + deriv (deriv R.h) (R.ϕ x)) * p ^ 3 := (R.lazutkin_norm x).symm

  have hr_per : ∀ w ∈ U_h, rad_ℂ (w + 2 * Real.pi) = rad_ℂ w := by
    intro w hw
    dsimp [rad_ℂ]
    rw [hψ_qper w hw, U_data.u_raw_periodic (ψ_ℂ w) (hStrip_mono hσ₂_le_σ₁ (hψ_maps w hw))]

  have hr_conj : ∀ w ∈ U_h, rad_ℂ (starRingEnd ℂ w) = starRingEnd ℂ (rad_ℂ w) := by
    intro w hw
    dsimp [rad_ℂ]
    rw [hψ_conj w hw, U_data.u_raw_conj (ψ_ℂ w) (hStrip_mono hσ₂_le_σ₁ (hψ_maps w hw))]
    have h3 : -3 * starRingEnd ℂ (U_data.u_raw (ψ_ℂ w)) =
        starRingEnd ℂ (-3 * U_data.u_raw (ψ_ℂ w)) := by
      rw [map_mul, map_neg, map_ofNat]
    rw [h3, Complex.exp_conj, map_mul, Complex.conj_ofReal]

  have h_neg_rsin_holo : DifferentiableOn ℂ (fun w => -rad_ℂ w * Complex.sin w) U_h :=
    hr_holo.neg.mul Complex.differentiable_sin.differentiableOn
  have h_rcos_holo : DifferentiableOn ℂ (fun w => rad_ℂ w * Complex.cos w) U_h :=
    hr_holo.mul Complex.differentiable_cos.differentiableOn
  obtain ⟨A₀_fn, hA₀_within⟩ :=
    (hStrip_convex (2 * s_h)).exists_forall_hasDerivWithinAt h_neg_rsin_holo
  obtain ⟨B₀_fn, hB₀_within⟩ :=
    (hStrip_convex (2 * s_h)).exists_forall_hasDerivWithinAt h_rcos_holo
  let h0_ℂ : ℂ := ((R.h (0 : ℝ) : ℝ) : ℂ)
  let h'0_ℂ : ℂ := ((deriv R.h (0 : ℝ) : ℝ) : ℂ)
  let A : ℂ → ℂ := fun w => A₀_fn w - A₀_fn 0 + h0_ℂ
  let B : ℂ → ℂ := fun w => B₀_fn w - B₀_fn 0 + h'0_ℂ
  have hA_deriv : ∀ w ∈ U_h, HasDerivAt A (-rad_ℂ w * Complex.sin w) w :=
    fun w hw => (((hA₀_within w hw).hasDerivAt ((hStrip_open (2 * s_h)).mem_nhds hw)).sub_const
      (A₀_fn 0)).add_const h0_ℂ
  have hB_deriv : ∀ w ∈ U_h, HasDerivAt B (rad_ℂ w * Complex.cos w) w :=
    fun w hw => (((hB₀_within w hw).hasDerivAt ((hStrip_open (2 * s_h)).mem_nhds hw)).sub_const
      (B₀_fn 0)).add_const h'0_ℂ

  let h_ℂ : ℂ → ℂ := fun w => A w * Complex.cos w + B w * Complex.sin w
  let g_ℂ : ℂ → ℂ := fun w => -A w * Complex.sin w + B w * Complex.cos w
  have hh_ℂ_zero : h_ℂ 0 = h0_ℂ := by simp [h_ℂ, A, B]
  have hh_ℂ_hasDeriv : ∀ w ∈ U_h, HasDerivAt h_ℂ (g_ℂ w) w := by
    intro w hw
    convert ((hA_deriv w hw).mul (Complex.hasDerivAt_cos w)).add
      ((hB_deriv w hw).mul (Complex.hasDerivAt_sin w)) using 1
    dsimp [g_ℂ]; ring
  have hh_ℂ_holo : DifferentiableOn ℂ h_ℂ U_h :=
    fun w hw => (hh_ℂ_hasDeriv w hw).differentiableAt.differentiableWithinAt
  have hh_ℂ_deriv : ∀ w ∈ U_h, deriv h_ℂ w = g_ℂ w :=
    fun w hw => (hh_ℂ_hasDeriv w hw).deriv
  have hderiv_h_ℂ_zero : deriv h_ℂ 0 = h'0_ℂ := by
    rw [hh_ℂ_deriv 0 (hStrip_zero h2sh_pos)]
    simp [g_ℂ, A, B]

  have hh_ℂ_deriv2_hasDeriv : ∀ w ∈ U_h, HasDerivAt (deriv h_ℂ) (rad_ℂ w - h_ℂ w) w := by
    intro w hw
    have hg_d : HasDerivAt g_ℂ (rad_ℂ w - h_ℂ w) w := by
      convert (((hA_deriv w hw).neg).mul (Complex.hasDerivAt_sin w)).add
        ((hB_deriv w hw).mul (Complex.hasDerivAt_cos w)) using 1
      dsimp [h_ℂ]
      linear_combination rad_ℂ w * (Complex.sin_sq_add_cos_sq w).symm
    exact hg_d.congr_of_eventuallyEq
      (Filter.eventually_of_mem ((hStrip_open (2 * s_h)).mem_nhds hw) hh_ℂ_deriv)

  have hh_ℂ_ode : ∀ w ∈ U_h, h_ℂ w + deriv (deriv h_ℂ) w = rad_ℂ w := by
    intro w hw
    rw [(hh_ℂ_deriv2_hasDeriv w hw).deriv]
    ring

  have hh_diff : Differentiable ℝ R.h := R.h_smooth.differentiable (by simp)
  have hh'_diff : Differentiable ℝ (deriv R.h) := by
    rw [← iteratedDeriv_one]
    exact R.h_smooth.differentiable_iteratedDeriv 1 (by simp)

  have hh_real_both :
      ∀ θ : ℝ, h_ℂ θ = ((R.h θ : ℝ) : ℂ) ∧ deriv h_ℂ θ = ((deriv R.h θ : ℝ) : ℂ) := by
    let δ : ℝ → ℂ := fun t => h_ℂ t - ((R.h t : ℝ) : ℂ)
    let δ' : ℝ → ℂ := fun t => deriv h_ℂ t - ((deriv R.h t : ℝ) : ℂ)
    have hδ_d : ∀ t : ℝ, HasDerivAt δ (δ' t) t := by
      intro t
      have ht_mem : (t : ℂ) ∈ U_h := hStrip_real h2sh_pos t
      have h1 : HasDerivAt (fun s : ℝ => h_ℂ s) (deriv h_ℂ t) t := by
        rw [hh_ℂ_deriv t ht_mem]
        exact (hh_ℂ_hasDeriv t ht_mem).comp_ofReal
      exact h1.sub ((hh_diff t).hasDerivAt.ofReal_comp)
    have hδ'_d : ∀ t : ℝ, HasDerivAt δ' (-δ t) t := by
      intro t
      have ht_mem : (t : ℂ) ∈ U_h := hStrip_real h2sh_pos t
      have h1 : HasDerivAt (fun s : ℝ => deriv h_ℂ s) (rad_ℂ t - h_ℂ t) t :=
        (hh_ℂ_deriv2_hasDeriv t ht_mem).comp_ofReal
      convert h1.sub ((hh'_diff t).hasDerivAt.ofReal_comp) using 1
      dsimp [δ]
      rw [hr_real t]
      push_cast; ring
    let E₁ : ℝ → ℂ := fun t => δ t * Complex.cos t - δ' t * Complex.sin t
    let E₂ : ℝ → ℂ := fun t => δ t * Complex.sin t + δ' t * Complex.cos t
    have hE₁_d : ∀ t : ℝ, HasDerivAt E₁ 0 t := by
      intro t
      convert ((hδ_d t).mul ((Complex.hasDerivAt_cos t).comp_ofReal)).sub
        ((hδ'_d t).mul ((Complex.hasDerivAt_sin t).comp_ofReal)) using 1
      ring
    have hE₂_d : ∀ t : ℝ, HasDerivAt E₂ 0 t := by
      intro t
      convert ((hδ_d t).mul ((Complex.hasDerivAt_sin t).comp_ofReal)).add
        ((hδ'_d t).mul ((Complex.hasDerivAt_cos t).comp_ofReal)) using 1
      ring
    have hE₁_eq : ∀ t : ℝ, E₁ t = 0 := by
      intro t
      have hc := is_const_of_deriv_eq_zero (fun s => (hE₁_d s).differentiableAt)
        (fun s => (hE₁_d s).deriv) t 0
      have h0 : E₁ 0 = 0 := by simp [E₁, δ, δ', hh_ℂ_zero, hderiv_h_ℂ_zero, h0_ℂ, h'0_ℂ]
      exact hc.trans h0
    have hE₂_eq : ∀ t : ℝ, E₂ t = 0 := by
      intro t
      have hc := is_const_of_deriv_eq_zero (fun s => (hE₂_d s).differentiableAt)
        (fun s => (hE₂_d s).deriv) t 0
      have h0 : E₂ 0 = 0 := by simp [E₂, δ, δ', hh_ℂ_zero, hderiv_h_ℂ_zero, h0_ℂ, h'0_ℂ]
      exact hc.trans h0
    intro θ
    have h1 := hE₁_eq θ
    have h2 := hE₂_eq θ
    have hδ_zero : δ θ = 0 := by
      have hid : δ θ = E₁ θ * Complex.cos θ + E₂ θ * Complex.sin θ := by
        dsimp [E₁, E₂]
        linear_combination δ θ * (Complex.sin_sq_add_cos_sq (θ : ℂ)).symm
      rw [hid, h1, h2]; simp
    have hδ'_zero : δ' θ = 0 := by
      have hid : δ' θ = -E₁ θ * Complex.sin θ + E₂ θ * Complex.cos θ := by
        dsimp [E₁, E₂]
        linear_combination δ' θ * (Complex.sin_sq_add_cos_sq (θ : ℂ)).symm
      rw [hid, h1, h2]; simp
    exact ⟨sub_eq_zero.mp hδ_zero, sub_eq_zero.mp hδ'_zero⟩

  have hh_ℂ_real : ∀ θ : ℝ, h_ℂ θ = R.h θ := fun θ => (hh_real_both θ).1

  have hWronskian_zero : ∀ (D D' : ℂ → ℂ), D 0 = 0 → D' 0 = 0 →
      (∀ w ∈ U_h, HasDerivAt D (D' w) w) →
      (∀ w ∈ U_h, HasDerivAt D' (-D w) w) →
      ∀ w ∈ U_h, D w = 0 := by
    intro D D' hD0 hD'0 hDd hD'd
    let E₁ : ℂ → ℂ := fun w => D w * Complex.cos w - D' w * Complex.sin w
    let E₂ : ℂ → ℂ := fun w => D w * Complex.sin w + D' w * Complex.cos w
    have hE₁_d : ∀ w ∈ U_h, HasDerivAt E₁ 0 w := by
      intro w hw
      convert ((hDd w hw).mul (Complex.hasDerivAt_cos w)).sub
        ((hD'd w hw).mul (Complex.hasDerivAt_sin w)) using 1
      ring
    have hE₂_d : ∀ w ∈ U_h, HasDerivAt E₂ 0 w := by
      intro w hw
      convert ((hDd w hw).mul (Complex.hasDerivAt_sin w)).add
        ((hD'd w hw).mul (Complex.hasDerivAt_cos w)) using 1
      ring
    intro w hw
    have h1 : E₁ w = 0 := by
      rw [hStrip_const h2sh_pos hE₁_d w hw]; simp [E₁, hD0, hD'0]
    have h2 : E₂ w = 0 := by
      rw [hStrip_const h2sh_pos hE₂_d w hw]; simp [E₂, hD0, hD'0]
    have hid : D w = E₁ w * Complex.cos w + E₂ w * Complex.sin w := by
      dsimp [E₁, E₂]
      linear_combination D w * (Complex.sin_sq_add_cos_sq w).symm
    rw [hid, h1, h2]; simp

  have hh'_per : Function.Periodic (deriv R.h) (2 * Real.pi) := by
    intro θ
    have h1 : HasDerivAt (fun t => R.h (t + 2 * Real.pi)) (deriv R.h (θ + 2 * Real.pi)) θ :=
      hHasDerivAt_shift_ℝ (hh_diff (θ + 2 * Real.pi)).hasDerivAt
    have h2 : HasDerivAt R.h (deriv R.h θ) θ := (hh_diff θ).hasDerivAt
    have h12 : (fun t => R.h (t + 2 * Real.pi)) = R.h := funext R.h_periodic
    rw [h12] at h1
    exact h1.unique h2

  have hh_ℂ_per : ∀ w ∈ U_h, h_ℂ (w + 2 * Real.pi) = h_ℂ w := by
    let D : ℂ → ℂ := fun w => h_ℂ (w + 2 * Real.pi) - h_ℂ w
    let D' : ℂ → ℂ := fun w => deriv h_ℂ (w + 2 * Real.pi) - deriv h_ℂ w
    have h2pi_0 : (0 : ℂ) + 2 * Real.pi = ((2 * Real.pi : ℝ) : ℂ) := by push_cast; ring
    have hD0 : D 0 = 0 := by
      dsimp [D]
      rw [h2pi_0, hh_ℂ_real (2 * Real.pi), hh_ℂ_zero]
      dsimp [h0_ℂ]
      have hp := R.h_periodic 0; rw [zero_add] at hp; simp [hp]
    have hD'0 : D' 0 = 0 := by
      dsimp [D']
      rw [h2pi_0, (hh_real_both (2 * Real.pi)).2, hderiv_h_ℂ_zero]
      dsimp [h'0_ℂ]
      have hp := hh'_per 0; rw [zero_add] at hp; simp [hp]
    have hDd : ∀ w ∈ U_h, HasDerivAt D (D' w) w := by
      intro w hw
      have hw' : w + 2 * Real.pi ∈ U_h := hStrip_add_two_pi hw
      have h1 : HasDerivAt (fun ζ => h_ℂ (ζ + 2 * Real.pi)) (deriv h_ℂ (w + 2 * Real.pi)) w := by
        rw [hh_ℂ_deriv (w + 2 * Real.pi) hw']
        exact hHasDerivAt_shift_ℂ (hh_ℂ_hasDeriv (w + 2 * Real.pi) hw')
      have h2 : HasDerivAt h_ℂ (deriv h_ℂ w) w := by
        rw [hh_ℂ_deriv w hw]; exact hh_ℂ_hasDeriv w hw
      exact h1.sub h2
    have hD'd : ∀ w ∈ U_h, HasDerivAt D' (-D w) w := by
      intro w hw
      have hw' : w + 2 * Real.pi ∈ U_h := hStrip_add_two_pi hw
      have h1 : HasDerivAt (fun ζ => deriv h_ℂ (ζ + 2 * Real.pi))
          (rad_ℂ (w + 2 * Real.pi) - h_ℂ (w + 2 * Real.pi)) w :=
        hHasDerivAt_shift_ℂ (hh_ℂ_deriv2_hasDeriv (w + 2 * Real.pi) hw')
      convert h1.sub (hh_ℂ_deriv2_hasDeriv w hw) using 1
      dsimp [D]; rw [hr_per w hw]; ring
    intro w hw
    exact sub_eq_zero.mp (hWronskian_zero D D' hD0 hD'0 hDd hD'd w hw)

  have hh_ℂ_conj : ∀ w ∈ U_h, h_ℂ (starRingEnd ℂ w) = starRingEnd ℂ (h_ℂ w) := by
    let D : ℂ → ℂ := fun w => starRingEnd ℂ (h_ℂ (starRingEnd ℂ w)) - h_ℂ w
    let D' : ℂ → ℂ := fun w => starRingEnd ℂ (deriv h_ℂ (starRingEnd ℂ w)) - deriv h_ℂ w
    have hD0 : D 0 = 0 := by simp [D, hh_ℂ_zero, h0_ℂ]
    have hD'0 : D' 0 = 0 := by simp [D', hderiv_h_ℂ_zero, h'0_ℂ]
    have hDd : ∀ w ∈ U_h, HasDerivAt D (D' w) w := by
      intro w hw
      have hcw : starRingEnd ℂ w ∈ U_h := hStrip_conj hw
      have h1 : HasDerivAt (fun ζ => starRingEnd ℂ (h_ℂ (starRingEnd ℂ ζ)))
          (starRingEnd ℂ (deriv h_ℂ (starRingEnd ℂ w))) w := by
        rw [hh_ℂ_deriv (starRingEnd ℂ w) hcw]
        exact hHasDerivAt_conj (hh_ℂ_hasDeriv (starRingEnd ℂ w) hcw)
      have h2 : HasDerivAt h_ℂ (deriv h_ℂ w) w := by
        rw [hh_ℂ_deriv w hw]; exact hh_ℂ_hasDeriv w hw
      exact h1.sub h2
    have hD'd : ∀ w ∈ U_h, HasDerivAt D' (-D w) w := by
      intro w hw
      have hcw : starRingEnd ℂ w ∈ U_h := hStrip_conj hw
      have h1 := hHasDerivAt_conj (hh_ℂ_deriv2_hasDeriv (starRingEnd ℂ w) hcw)
      convert h1.sub (hh_ℂ_deriv2_hasDeriv w hw) using 1
      dsimp [D]
      rw [map_sub, hr_conj w hw]
      simp only [RingHomCompTriple.comp_apply, RingHom.id_apply]
      ring
    intro w hw
    have hzero := hWronskian_zero D D' hD0 hD'0 hDd hD'd (starRingEnd ℂ w) (hStrip_conj hw)
    dsimp [D] at hzero
    simp only [RingHomCompTriple.comp_apply, RingHom.id_apply] at hzero
    exact (sub_eq_zero.mp hzero).symm

  
  
  
  let s₀ : ℝ := min (σ₂ / 4) (s_h / (2 * Real.exp M₁))
  have hs₀_pos : 0 < s₀ := lt_min (by positivity) (by positivity)
  have h2s₀_le_σ₂ : 2 * s₀ ≤ σ₂ := by
    have h1 : s₀ ≤ σ₂ / 4 := min_le_left _ _
    linarith
  have h2s₀_le_σ₁ : 2 * s₀ ≤ σ₁ := h2s₀_le_σ₂.trans hσ₂_le_σ₁

  have hϕ_maps_to : ∀ z ∈ horizStrip (2 * s₀), ϕ_ℂ z ∈ horizStrip (2 * s_h) := by
    intro z hz
    have hz₁ : z ∈ horizStrip σ₁ := hStrip_mono h2s₀_le_σ₁ hz
    have him_le := hϕ_ℂ_im_le z hz₁
    have hs₀_le : s₀ ≤ s_h / (2 * Real.exp M₁) := min_le_right _ _
    have hexp_pos : 0 < Real.exp M₁ := Real.exp_pos M₁
    have h_prod_lt : Real.exp M₁ * |z.im| < s_h := by
      have hzim_lt : |z.im| < 2 * s₀ := hz
      calc Real.exp M₁ * |z.im|
          < Real.exp M₁ * (2 * s₀) := mul_lt_mul_of_pos_left hzim_lt hexp_pos
        _ ≤ Real.exp M₁ * (2 * (s_h / (2 * Real.exp M₁))) :=
            mul_le_mul_of_nonneg_left (by linarith) hexp_pos.le
        _ = s_h := by field_simp [hexp_pos.ne']
    change |(ϕ_ℂ z).im| < 2 * s_h
    linarith

  refine ⟨{
    toRationalCollarData := R
    s₀ := s₀
    s_h := s_h
    s₀_pos := hs₀_pos
    s_h_pos := hs_h_pos
    u_ℂ := U_data.u_raw
    h_ℂ := h_ℂ
    ϕ_ℂ := ϕ_ℂ
    u_ℂ_holo := U_data.u_raw_holo.mono (hStrip_mono h2s₀_le_σ₁)
    u_ℂ_real := U_data.u_raw_real
    u_ℂ_periodic := fun z hz => U_data.u_raw_periodic z (hStrip_mono h2s₀_le_σ₁ hz)
    u_ℂ_conj := fun z hz => U_data.u_raw_conj z (hStrip_mono h2s₀_le_σ₁ hz)
    deriv_ϕ_ℂ_eq_exp := fun z hz => hϕ_ℂ_deriv z (hStrip_mono h2s₀_le_σ₁ hz)
    h_ℂ_holo := hh_ℂ_holo
    ϕ_ℂ_holo := hϕ_ℂ_holo.mono (hStrip_mono h2s₀_le_σ₁)
    ϕ_ℂ_maps_to := hϕ_maps_to
    h_ℂ_real := hh_ℂ_real
    ϕ_ℂ_real := hϕ_ℂ_real
    h_ℂ_periodic := hh_ℂ_per
    h_ℂ_conj := hh_ℂ_conj
    ϕ_ℂ_quasiperiodic := fun z hz => hϕ_ℂ_qper z (hStrip_mono h2s₀_le_σ₁ hz)
    ϕ_ℂ_conj := fun z hz => hϕ_ℂ_conj z (hStrip_mono h2s₀_le_σ₁ hz)
    ϕ_ℂ_deriv_ne_zero := fun z hz => by
      rw [hϕ_ℂ_deriv z (hStrip_mono h2s₀_le_σ₁ hz)]
      exact Complex.exp_ne_zero _
    lazutkin_norm_ℂ := fun z hz => by
      have hz₂ : z ∈ horizStrip σ₂ := hStrip_mono h2s₀_le_σ₂ hz
      have hz₁ : z ∈ horizStrip σ₁ := hStrip_mono h2s₀_le_σ₁ hz
      have hw : ϕ_ℂ z ∈ U_h := hϕ_maps_to z hz
      rw [hh_ℂ_ode (ϕ_ℂ z) hw, hϕ_ℂ_deriv z hz₁]
      dsimp [rad_ℂ, g]
      rw [hψ_ϕ z hz₂]
      have hexp3 : (Complex.exp (U_data.u_raw z)) ^ 3 = Complex.exp (3 * U_data.u_raw z) := by
        rw [← Complex.exp_nat_mul]; norm_num
      rw [hexp3, mul_assoc, ← Complex.exp_add]
      have h_cancel : -3 * U_data.u_raw z + 3 * U_data.u_raw z = 0 := by ring
      rw [h_cancel, Complex.exp_zero, mul_one]
  }⟩

theorem analytic_boundary_regularity (Ω : Set Plane)
    (R : RationalCollarData Ω)
    (H_sys : HighFreqActionSystem (fun x : ℝ => Real.log (deriv R.ϕ x))) :
    Nonempty (AnalyticBoundaryData Ω) :=
by
  have H_sys' : HighFreqActionSystem (uTable R) := H_sys
  obtain ⟨N_op, hN_op_van, hW⟩ := high_mode_wiener_operator_inversion Ω R H_sys'
  obtain ⟨N_init, _, hInit⟩ := initial_truncation_wiener_residual Ω R H_sys'
  let N : ℕ := max N_op N_init
  obtain ⟨W_op⟩ := hW N (le_max_left N_op N_init)
  have h_init : InitialTruncationAt R H_sys' N := hInit N (le_max_right N_op N_init)
  have hN_van : H_sys'.N_vanish ≤ N := le_trans hN_op_van (le_max_left N_op N_init)
  obtain ⟨U_data⟩ := newton_convergence_and_uniqueness Ω R H_sys' N hN_van W_op h_init
  exact complex_lazutkin_support_strip Ω R U_data

theorem complex_partial_and_diffop_calculus : UniversalGlancingCalculus :=
by
  
  have h_param_cont : ∀ (a b : ℝ) (W : Set (ℝ × (ℂ × ℂ))) (F : ℝ → ℝ × (ℂ × ℂ) → ℂ),
      ContinuousOn (fun q : ℝ × (ℝ × (ℂ × ℂ)) => F q.1 q.2) (Set.uIcc a b ×ˢ W) →
      ContinuousOn (fun p : ℝ × (ℂ × ℂ) => ∫ τ in a..b, F τ p) W := by
    intro a b W F hF
    let π : ℝ → ℝ := fun τ => max (min a b) (min (max a b) τ)
    have hπ_cont : Continuous π :=
      continuous_const.max (continuous_const.min continuous_id)
    have hπ_mem : ∀ τ : ℝ, π τ ∈ Set.uIcc a b := by
      intro τ
      show min a b ≤ π τ ∧ π τ ≤ max a b
      exact ⟨le_max_left _ _, max_le min_le_max (min_le_left _ _)⟩
    have hπ_eq : ∀ τ ∈ Set.uIcc a b, π τ = τ := by
      intro τ hτ
      have hτ' : min a b ≤ τ ∧ τ ≤ max a b := hτ
      dsimp [π]
      rw [min_eq_right hτ'.2, max_eq_right hτ'.1]
    let g : ↥W → ℝ → ℂ := fun w τ => F (π τ) w.1
    have hg_cont : Continuous (Function.uncurry g) := by
      refine hF.comp_continuous
        ((hπ_cont.comp continuous_snd).prodMk (continuous_subtype_val.comp continuous_fst)) ?_
      intro x
      exact ⟨hπ_mem x.2, x.1.2⟩
    have h_int_cont : Continuous (fun w : ↥W => ∫ τ in a..b, F (π τ) w.1) :=
      intervalIntegral.continuous_parametric_intervalIntegral_of_continuous' hg_cont a b
    rw [continuousOn_iff_continuous_domRestrict]
    convert h_int_cont using 1
    ext w
    exact (intervalIntegral.integral_congr (fun τ hτ => by rw [hπ_eq τ hτ])).symm

  
  have h_param_holo : ∀ (a b : ℝ) (W : Set (ℂ × ℂ)) (F : ℝ → ℂ × ℂ → ℂ),
      IsOpen W →
      ContinuousOn (fun q : ℝ × (ℂ × ℂ) => F q.1 q.2) (Set.uIcc a b ×ˢ W) →
      (∀ τ ∈ Set.uIcc a b, DifferentiableOn ℂ (F τ) W) →
      DifferentiableOn ℂ (fun p : ℂ × ℂ => ∫ τ in a..b, F τ p) W := by
    intro a b W F hW hCont hHolo p₀ hp₀
    obtain ⟨ε, hε, hε_sub⟩ := Metric.isOpen_iff.mp hW p₀ hp₀
    let r : ℝ := ε / 3
    have hr : 0 < r := by positivity
    have h2r_lt : 2 * r < ε := by dsimp only [r]; linarith
    have h2r_sub : Metric.closedBall p₀ (2 * r) ⊆ W :=
      (Metric.closedBall_subset_ball h2r_lt).trans hε_sub
    have hK_compact : IsCompact (Set.uIcc a b ×ˢ Metric.closedBall p₀ (2 * r)) :=
      isCompact_uIcc.prod (isCompact_closedBall p₀ (2 * r))
    have hK_sub : Set.uIcc a b ×ˢ Metric.closedBall p₀ (2 * r) ⊆ Set.uIcc a b ×ˢ W :=
      Set.prod_mono Subset.rfl h2r_sub
    obtain ⟨C₀, hC₀⟩ := hK_compact.exists_bound_of_continuousOn (hCont.mono hK_sub)
    let M : ℝ := max C₀ 0
    have hM_bound : ∀ τ ∈ Set.uIcc a b, ∀ q ∈ Metric.closedBall p₀ (2 * r), ‖F τ q‖ ≤ M := by
      intro τ hτ q hq
      exact (hC₀ (τ, q) ⟨hτ, hq⟩).trans (le_max_left _ _)
    let s : Set (ℂ × ℂ) := Metric.ball p₀ r
    have hs_nhds : s ∈ nhds p₀ := Metric.ball_mem_nhds p₀ hr
    have hs_2r : ∀ p ∈ s, ∀ q ∈ Metric.ball p r, q ∈ Metric.closedBall p₀ (2 * r) := by
      intro p hp q hq
      rw [Metric.mem_closedBall]
      have hp' : dist p p₀ < r := hp
      have hq' : dist q p < r := hq
      linarith [dist_triangle q p p₀]
    have hs_sub : s ⊆ W := fun p hp =>
      h2r_sub (Metric.ball_subset_closedBall (Metric.mem_ball.mpr (by linarith [Metric.mem_ball.mp hp])))
    have h_slice_cont : ∀ p ∈ W, ContinuousOn (fun τ : ℝ => F τ p) (Set.uIcc a b) := fun p hp =>
      hCont.comp (continuous_id.prodMk continuous_const).continuousOn (fun τ hτ => ⟨hτ, hp⟩)
    let μ₀ : MeasureTheory.Measure ℝ := MeasureTheory.volume.restrict (Set.uIoc a b)
    have hμ_le : μ₀ ≤ MeasureTheory.volume.restrict (Set.uIcc a b) :=
      MeasureTheory.Measure.restrict_mono Set.uIoc_subset_uIcc le_rfl
    have hF_meas : ∀ᶠ p in nhds p₀, MeasureTheory.AEStronglyMeasurable (fun τ => F τ p) μ₀ := by
      filter_upwards [hs_nhds] with p hp
      exact ((h_slice_cont p (hs_sub hp)).aestronglyMeasurable measurableSet_uIcc).mono_measure hμ_le
    have hF_int : IntervalIntegrable (fun τ => F τ p₀) MeasureTheory.volume a b :=
      (h_slice_cont p₀ hp₀).intervalIntegrable
    let δ : ℕ → ℝ := fun n => (1 / ((n : ℝ) + 1)) * (r / 2)
    let h : ℕ → ℂ := fun n => ((δ n : ℝ) : ℂ)
    have hδ_pos : ∀ n : ℕ, 0 < δ n := fun n => by positivity
    have hδ_lt : ∀ n : ℕ, δ n < r := by
      intro n
      have hn : (1 : ℝ) ≤ (n : ℝ) + 1 := by linarith [(Nat.cast_nonneg n : (0 : ℝ) ≤ n)]
      have h1 : 1 / ((n : ℝ) + 1) ≤ 1 := div_le_one_of_le₀ hn (by positivity)
      dsimp only [δ]
      nlinarith
    have hh_ne : ∀ n : ℕ, h n ≠ 0 := fun n => Complex.ofReal_ne_zero.mpr (hδ_pos n).ne'
    have hh_norm : ∀ n : ℕ, ‖h n‖ < r := by
      intro n
      rw [Complex.norm_real, Real.norm_of_nonneg (hδ_pos n).le]
      exact hδ_lt n
    let e₁ : ℂ × ℂ := ((1 : ℂ), (0 : ℂ))
    let e₂ : ℂ × ℂ := ((0 : ℂ), (1 : ℂ))
    have hp1_mem : ∀ n : ℕ, p₀ + h n • e₁ ∈ W := by
      intro n
      apply hs_sub
      rw [Metric.mem_ball, dist_self_add_left, Prod.norm_def]
      simp [e₁, hh_norm n]
    have hp2_mem : ∀ n : ℕ, p₀ + h n • e₂ ∈ W := by
      intro n
      apply hs_sub
      rw [Metric.mem_ball, dist_self_add_left, Prod.norm_def]
      simp [e₂, hh_norm n]
    have hh_tendsto : Filter.Tendsto h Filter.atTop (nhdsWithin (0 : ℂ) {(0 : ℂ)}ᶜ) := by
      rw [tendsto_nhdsWithin_iff]
      refine ⟨?_, Filter.Eventually.of_forall (fun n => Set.mem_compl_singleton_iff.mpr (hh_ne n))⟩
      have h0 : Filter.Tendsto δ Filter.atTop (nhds (0 : ℝ)) := by
        simpa [δ] using tendsto_one_div_add_atTop_nhds_zero_nat.mul_const (r / 2)
      simpa [h, Function.comp_def] using (Complex.continuous_ofReal.tendsto 0).comp h0
    let g_seq : ℕ → ℝ → ((ℂ × ℂ) →L[ℂ] ℂ) := fun n τ =>
      ((h n)⁻¹ • (F τ (p₀ + h n • e₁) - F τ p₀)) • ContinuousLinearMap.fst ℂ ℂ ℂ +
      ((h n)⁻¹ • (F τ (p₀ + h n • e₂) - F τ p₀)) • ContinuousLinearMap.snd ℂ ℂ ℂ
    have hg_meas : ∀ n : ℕ, MeasureTheory.AEStronglyMeasurable (g_seq n) μ₀ := by
      intro n
      have hc1 : ContinuousOn (fun τ => (h n)⁻¹ • (F τ (p₀ + h n • e₁) - F τ p₀)) (Set.uIcc a b) :=
        (continuousOn_const (c := (h n)⁻¹)).smul ((h_slice_cont _ (hp1_mem n)).sub (h_slice_cont p₀ hp₀))
      have hc2 : ContinuousOn (fun τ => (h n)⁻¹ • (F τ (p₀ + h n • e₂) - F τ p₀)) (Set.uIcc a b) :=
        (continuousOn_const (c := (h n)⁻¹)).smul ((h_slice_cont _ (hp2_mem n)).sub (h_slice_cont p₀ hp₀))
      have hcg : ContinuousOn (g_seq n) (Set.uIcc a b) :=
        (hc1.smul (continuousOn_const (c := ContinuousLinearMap.fst ℂ ℂ ℂ))).add
          (hc2.smul (continuousOn_const (c := ContinuousLinearMap.snd ℂ ℂ ℂ)))
      exact (hcg.aestronglyMeasurable measurableSet_uIcc).mono_measure hμ_le
    have hF'_meas : MeasureTheory.AEStronglyMeasurable (fun τ => fderiv ℂ (F τ) p₀) μ₀ := by
      refine aestronglyMeasurable_of_tendsto_ae Filter.atTop hg_meas ?_
      filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_uIoc] with τ hτ_ioc
      have hτ : τ ∈ Set.uIcc a b := Set.uIoc_subset_uIcc hτ_ioc
      have hFD : HasFDerivAt (F τ) (fderiv ℂ (F τ) p₀) p₀ :=
        ((hHolo τ hτ).differentiableAt (hW.mem_nhds hp₀)).hasFDerivAt
      have ht1 := (hasLineDerivAt_iff_tendsto_slope_zero.mp (hFD.hasLineDerivAt e₁)).comp hh_tendsto
      have ht2 := (hasLineDerivAt_iff_tendsto_slope_zero.mp (hFD.hasLineDerivAt e₂)).comp hh_tendsto
      have ht_sum : Filter.Tendsto (g_seq · τ) Filter.atTop
          (nhds ((fderiv ℂ (F τ) p₀ e₁) • ContinuousLinearMap.fst ℂ ℂ ℂ +
            (fderiv ℂ (F τ) p₀ e₂) • ContinuousLinearMap.snd ℂ ℂ ℂ)) :=
        (ht1.smul_const _).add (ht2.smul_const _)
      have hL_eq : (fderiv ℂ (F τ) p₀ e₁) • ContinuousLinearMap.fst ℂ ℂ ℂ +
          (fderiv ℂ (F τ) p₀ e₂) • ContinuousLinearMap.snd ℂ ℂ ℂ = fderiv ℂ (F τ) p₀ := by
        refine ContinuousLinearMap.ext (fun ⟨v₁, v₂⟩ => ?_)
        have hv : ((v₁, v₂) : ℂ × ℂ) = v₁ • e₁ + v₂ • e₂ := by ext <;> simp [e₁, e₂]
        conv_rhs => rw [hv, (fderiv ℂ (F τ) p₀).map_add, (fderiv ℂ (F τ) p₀).map_smul,
          (fderiv ℂ (F τ) p₀).map_smul]
        simp [mul_comm]
      rwa [hL_eq] at ht_sum
    have h_fderiv_bound : ∀ τ ∈ Set.uIcc a b, ∀ p ∈ s, ‖fderiv ℂ (F τ) p‖ ≤ 2 * M / r := by
      intro τ hτ p hp
      have hball_sub : Metric.ball p r ⊆ W := fun q hq => h2r_sub (hs_2r p hp q hq)
      have hmaps : Set.MapsTo (F τ) (Metric.ball p r) (Metric.closedBall (F τ p) (2 * M)) := by
        intro q hq
        rw [Metric.mem_closedBall, dist_eq_norm]
        have hq2r : q ∈ Metric.closedBall p₀ (2 * r) := hs_2r p hp q hq
        have hp2r : p ∈ Metric.closedBall p₀ (2 * r) := hs_2r p hp p (Metric.mem_ball_self hr)
        calc ‖F τ q - F τ p‖ ≤ ‖F τ q‖ + ‖F τ p‖ := norm_sub_le _ _
          _ ≤ M + M := add_le_add (hM_bound τ hτ q hq2r) (hM_bound τ hτ p hp2r)
          _ = 2 * M := by ring
      exact Complex.norm_fderiv_le_div_of_mapsTo_ball ((hHolo τ hτ).mono hball_sub) hmaps hr
    have h_ae_bound : ∀ᵐ τ : ℝ, τ ∈ Set.uIoc a b → ∀ p ∈ s, ‖fderiv ℂ (F τ) p‖ ≤ 2 * M / r :=
      Filter.Eventually.of_forall (fun τ hτ p hp => h_fderiv_bound τ (Set.uIoc_subset_uIcc hτ) p hp)
    have h_ae_diff : ∀ᵐ τ : ℝ, τ ∈ Set.uIoc a b → ∀ p ∈ s, HasFDerivAt (F τ) (fderiv ℂ (F τ) p) p :=
      Filter.Eventually.of_forall (fun τ hτ p hp =>
        ((hHolo τ (Set.uIoc_subset_uIcc hτ)).differentiableAt (hW.mem_nhds (hs_sub hp))).hasFDerivAt)
    have hIntFD := intervalIntegral.hasFDerivAt_integral_of_dominated_of_fderiv_le
      (𝕜 := ℂ) (F := fun p τ => F τ p) (F' := fun p τ => fderiv ℂ (F τ) p)
      (bound := fun _ => 2 * M / r)
      hs_nhds hF_meas hF_int hF'_meas h_ae_bound intervalIntegrable_const h_ae_diff
    exact hIntFD.differentiableAt.differentiableWithinAt

  
  have h_partial_y : ∀ (W : Set (ℂ × ℂ)) (U : ℂ × ℂ → ℂ),
      IsOpen W → DifferentiableOn ℂ U W →
      DifferentiableOn ℂ (fun p : ℂ × ℂ => deriv (fun y' : ℂ => U (y', p.2)) p.1) W := by
    intro W U hW hU p₀ hp₀
    obtain ⟨ε, hε, hε_sub⟩ := Metric.isOpen_iff.mp hW p₀ hp₀
    let r : ℝ := ε / 2
    have hr : 0 < r := half_pos hε
    let R_c : ℝ := (3 / 2 : ℝ) * r
    have hRc : 0 < R_c := by positivity
    let B₀ : Set (ℂ × ℂ) := Metric.ball p₀.1 r ×ˢ Metric.ball p₀.2 r
    have hB₀_open : IsOpen B₀ := Metric.isOpen_ball.prod Metric.isOpen_ball
    have hp₀_B₀ : p₀ ∈ B₀ := ⟨Metric.mem_ball_self hr, Metric.mem_ball_self hr⟩
    have h_in_W : ∀ z t : ℂ, dist z p₀.1 ≤ R_c → dist t p₀.2 < r → (z, t) ∈ W := by
      intro z t hz ht
      apply hε_sub
      rw [Metric.mem_ball, Prod.dist_eq, max_lt_iff]
      dsimp only [r, R_c] at hz ht ⊢
      exact ⟨by linarith, by linarith⟩
    let F : ℝ → ℂ × ℂ → ℂ := fun θ p =>
      (2 * (Real.pi : ℂ) * Complex.I)⁻¹ *
        (deriv (circleMap p₀.1 R_c) θ *
          (((circleMap p₀.1 R_c θ - p.1) ^ 2)⁻¹ * U (circleMap p₀.1 R_c θ, p.2)))
    have h_cm_dist : ∀ θ : ℝ, dist (circleMap p₀.1 R_c θ) p₀.1 = R_c := by
      intro θ
      rw [dist_eq_norm, circleMap_sub_center]
      simp [circleMap, abs_of_pos hRc]
    have h_sub_ne : ∀ θ : ℝ, ∀ p ∈ B₀, (circleMap p₀.1 R_c θ - p.1) ^ 2 ≠ 0 := by
      intro θ p hp
      apply pow_ne_zero 2
      rw [sub_ne_zero]
      intro h_eq
      have hd1 : dist (circleMap p₀.1 R_c θ) p₀.1 = R_c := h_cm_dist θ
      have hd2 : dist p.1 p₀.1 < r := hp.1
      rw [h_eq] at hd1
      dsimp only [R_c] at hd1
      linarith
    have hF_cont : ContinuousOn (fun q : ℝ × (ℂ × ℂ) => F q.1 q.2) (Set.uIcc 0 (2 * Real.pi) ×ˢ B₀) := by
      have hc_deriv : Continuous (fun q : ℝ × (ℂ × ℂ) => deriv (circleMap p₀.1 R_c) q.1) := by
        rw [show (fun q : ℝ × (ℂ × ℂ) => deriv (circleMap p₀.1 R_c) q.1) =
            fun q : ℝ × (ℂ × ℂ) => circleMap 0 R_c q.1 * Complex.I by
          ext q; exact deriv_circleMap p₀.1 R_c q.1]
        exact ((continuous_circleMap 0 R_c).comp continuous_fst).mul continuous_const
      have hc_cm : Continuous (fun q : ℝ × (ℂ × ℂ) => circleMap p₀.1 R_c q.1) :=
        (continuous_circleMap p₀.1 R_c).comp continuous_fst
      have hc_U : ContinuousOn (fun q : ℝ × (ℂ × ℂ) => U (circleMap p₀.1 R_c q.1, q.2.2))
          (Set.uIcc 0 (2 * Real.pi) ×ˢ B₀) := by
        refine hU.continuousOn.comp (hc_cm.prodMk (continuous_snd.comp continuous_snd)).continuousOn ?_
        intro q hq
        exact h_in_W _ _ (h_cm_dist q.1).le hq.2.2
      have hc_inv : ContinuousOn (fun q : ℝ × (ℂ × ℂ) => ((circleMap p₀.1 R_c q.1 - q.2.1) ^ 2)⁻¹)
          (Set.uIcc 0 (2 * Real.pi) ×ˢ B₀) :=
        ContinuousOn.inv₀
          (((hc_cm.sub (continuous_fst.comp continuous_snd)).pow 2).continuousOn)
          (fun q hq => h_sub_ne q.1 q.2 hq.2)
      exact continuousOn_const.mul (hc_deriv.continuousOn.mul (hc_inv.mul hc_U))
    have hF_holo : ∀ θ ∈ Set.uIcc 0 (2 * Real.pi), DifferentiableOn ℂ (F θ) B₀ := by
      intro θ _
      have hd_inv : DifferentiableOn ℂ (fun p : ℂ × ℂ => ((circleMap p₀.1 R_c θ - p.1) ^ 2)⁻¹) B₀ :=
        DifferentiableOn.inv
          (((differentiableOn_const (circleMap p₀.1 R_c θ)).sub differentiable_fst.differentiableOn).pow 2)
          (fun p hp => h_sub_ne θ p hp)
      have hd_U : DifferentiableOn ℂ (fun p : ℂ × ℂ => U (circleMap p₀.1 R_c θ, p.2)) B₀ :=
        hU.comp ((differentiable_const (circleMap p₀.1 R_c θ)).prodMk differentiable_snd).differentiableOn
          (fun p hp => h_in_W _ _ (h_cm_dist θ).le hp.2)
      exact (differentiableOn_const _).mul ((differentiableOn_const _).mul (hd_inv.mul hd_U))
    have hInt_holo : DifferentiableOn ℂ (fun p : ℂ × ℂ => ∫ θ in (0 : ℝ)..(2 * Real.pi), F θ p) B₀ :=
      h_param_holo 0 (2 * Real.pi) B₀ F hB₀_open hF_cont hF_holo
    have h_eq_on_B₀ : DifferentiableOn ℂ (fun p : ℂ × ℂ => deriv (fun y' : ℂ => U (y', p.2)) p.1) B₀ := by
      refine hInt_holo.congr ?_
      intro p hp
      have hp1_Rc : p.1 ∈ Metric.ball p₀.1 R_c := by
        rw [Metric.mem_ball]
        have hd2 : dist p.1 p₀.1 < r := hp.1
        dsimp only [R_c]
        linarith
      have hCauchy := (Complex.two_pi_I_inv_smul_circleIntegral_sub_sq_inv_smul_of_differentiable
        (hW.preimage (continuous_id.prodMk continuous_const))
        (fun z hz => h_in_W z p.2 hz hp.2)
        (hU.comp (differentiable_id.prodMk (differentiable_const p.2)).differentiableOn (fun _ hy' => hy'))
        hp1_Rc).symm
      dsimp only [Function.comp_def, id_eq] at hCauchy
      rw [hCauchy, circleIntegral_def_Icc, MeasureTheory.integral_Icc_eq_integral_Ioc,
        ← intervalIntegral.integral_of_le Real.two_pi_pos.le, ← intervalIntegral.integral_smul]
      refine intervalIntegral.integral_congr (fun θ _ => ?_)
      simp [F, smul_eq_mul, mul_assoc]
    exact (h_eq_on_B₀.differentiableAt (hB₀_open.mem_nhds hp₀_B₀)).differentiableWithinAt

  have h_partial_t : ∀ (W : Set (ℂ × ℂ)) (U : ℂ × ℂ → ℂ),
      IsOpen W → DifferentiableOn ℂ U W →
      DifferentiableOn ℂ (fun p : ℂ × ℂ => deriv (fun t' : ℂ => U (p.1, t')) p.2) W := by
    intro W U hW hU
    let S := ContinuousLinearEquiv.prodComm ℂ ℂ ℂ
    have h1 := h_partial_y (S ⁻¹' W) (U ∘ S) (hW.preimage S.continuous)
      (hU.comp S.differentiable.differentiableOn (fun _ hq => hq))
    have h2 := h1.comp S.differentiable.differentiableOn (fun p hp => show S (S p) ∈ W by simpa [S] using hp)
    exact h2.congr (fun p _ => rfl)

  
  have hStrip_open : ∀ σ : ℝ, IsOpen (horizStrip σ) := fun σ =>
    isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const
  have h_deriv_conj : ∀ (σ : ℝ) (f : ℂ → ℂ),
      DifferentiableOn ℂ f (horizStrip σ) →
      (∀ z ∈ horizStrip σ, f (starRingEnd ℂ z) = starRingEnd ℂ (f z)) →
      ∀ z ∈ horizStrip σ, deriv f (starRingEnd ℂ z) = starRingEnd ℂ (deriv f z) := by
    intro σ f hf hf_conj z hz
    have h_conj_mem : ∀ w ∈ horizStrip σ, starRingEnd ℂ w ∈ horizStrip σ := by
      intro w hw
      simpa [horizStrip] using hw
    have hd : HasDerivAt f (deriv f z) z :=
      (hf.differentiableAt ((hStrip_open σ).mem_nhds hz)).hasDerivAt
    have hd_conj := hd.conj_conj
    have hev : f =ᶠ[nhds (starRingEnd ℂ z)] ((starRingEnd ℂ) ∘ f ∘ (starRingEnd ℂ)) := by
      filter_upwards [(hStrip_open σ).mem_nhds (h_conj_mem z hz)] with w hw
      dsimp
      rw [hf_conj w hw, RingHomCompTriple.comp_apply, RingHom.id_apply]
    exact (hd_conj.congr_of_eventuallyEq hev).deriv

  
  have h_sinc_diff : Differentiable ℂ sinc_ℂ := by
    have h2d : DifferentiableOn ℂ
        (fun p : ℂ × ℂ => ∫ τ in (0 : ℝ)..(1 : ℝ), Complex.cos ((τ : ℂ) * p.1)) Set.univ := by
      refine h_param_holo 0 1 Set.univ (fun τ p => Complex.cos ((τ : ℂ) * p.1)) isOpen_univ ?_ ?_
      · exact (Complex.continuous_cos.comp
          ((Complex.continuous_ofReal.comp continuous_fst).mul (continuous_fst.comp continuous_snd))).continuousOn
      · intro τ _
        exact ((differentiable_const (τ : ℂ)).mul differentiable_fst).ccos.differentiableOn
    have hemb : Differentiable ℂ (fun z : ℂ => (z, (0 : ℂ))) :=
      (differentiable_id (𝕜 := ℂ) (E := ℂ)).prodMk (differentiable_const (0 : ℂ))
    have hcomp : Differentiable ℂ
        ((fun p : ℂ × ℂ => ∫ τ in (0 : ℝ)..(1 : ℝ), Complex.cos ((τ : ℂ) * p.1)) ∘
          (fun z : ℂ => (z, (0 : ℂ)))) :=
      (differentiableOn_univ.mp h2d).comp hemb
    exact hcomp
  have h_sinc_zero : sinc_ℂ 0 = 1 := by
    simp [sinc_ℂ]
  have h_sinc_neg : ∀ z : ℂ, sinc_ℂ (-z) = sinc_ℂ z := by
    intro z
    simp only [sinc_ℂ, mul_neg, Complex.cos_neg]
  have h_sinc_conj : ∀ z : ℂ, sinc_ℂ (starRingEnd ℂ z) = starRingEnd ℂ (sinc_ℂ z) := by
    intro z
    simp only [sinc_ℂ, intervalIntegral.integral_of_le zero_le_one, ← integral_conj]
    refine MeasureTheory.integral_congr_ae (Filter.Eventually.of_forall (fun τ => ?_))
    dsimp only
    rw [← Complex.cos_conj, map_mul, Complex.conj_ofReal]
  have h_sinc_mul : ∀ z : ℂ, z * sinc_ℂ z = Complex.sin z := by
    intro z
    rw [sinc_ℂ, ← intervalIntegral.integral_const_mul]
    have hderiv : ∀ τ ∈ Set.uIcc (0 : ℝ) 1,
        HasDerivAt (fun t : ℝ => Complex.sin ((t : ℂ) * z)) (z * Complex.cos ((τ : ℂ) * z)) τ := by
      intro τ _
      have hc : HasDerivAt (fun ζ : ℂ => Complex.sin (ζ * z)) (z * Complex.cos ((τ : ℂ) * z)) (τ : ℂ) := by
        simpa [mul_comm] using ((hasDerivAt_id (τ : ℂ)).mul_const z).csin
      exact hc.comp_ofReal
    have hint : IntervalIntegrable (fun τ : ℝ => z * Complex.cos ((τ : ℂ) * z)) MeasureTheory.volume 0 1 :=
      (continuous_const.mul (Complex.continuous_cos.comp (Complex.continuous_ofReal.mul continuous_const))).intervalIntegrable 0 1
    rw [intervalIntegral.integral_eq_sub_of_hasDerivAt hderiv hint]
    simp
  have h_sinc_bound : ∀ z : ℂ, ‖z‖ ≤ 1 → ‖sinc_ℂ z - 1‖ ≤ ‖z‖ := by
    have hexp_half : Real.exp (1 / 2) ≤ 7 / 4 := by
      have hsq : Real.exp (1 / 2) * Real.exp (1 / 2) = Real.exp 1 := by
        rw [← Real.exp_add]; norm_num
      have he1 : Real.exp 1 < 49 / 16 :=
        lt_trans Real.exp_one_lt_d9 (by norm_num)
      nlinarith [Real.exp_pos (1 / 2)]
    have hcos_half : ∀ ζ ∈ Metric.closedBall (0 : ℂ) (1 / 2), ‖Complex.cos ζ‖ ≤ 11 / 8 := by
      intro ζ hζ
      have him_abs : |ζ.im| ≤ 1 / 2 :=
        (Complex.abs_im_le_norm ζ).trans (by simpa using hζ)
      have him_bounds : -(1 / 2 : ℝ) ≤ ζ.im ∧ ζ.im ≤ 1 / 2 := abs_le.mp him_abs
      have hexp_sum : Real.exp (-ζ.im) + Real.exp ζ.im ≤ 11 / 4 := by
        rcases le_total 0 ζ.im with hnonneg | hnonpos
        · have h1 : Real.exp (-ζ.im) ≤ 1 := Real.exp_le_one_iff.mpr (by linarith)
          have h2 : Real.exp ζ.im ≤ 7 / 4 := (Real.exp_le_exp.mpr him_bounds.2).trans hexp_half
          linarith
        · have h1 : Real.exp ζ.im ≤ 1 := Real.exp_le_one_iff.mpr hnonpos
          have h2 : Real.exp (-ζ.im) ≤ 7 / 4 :=
            (Real.exp_le_exp.mpr (by linarith)).trans hexp_half
          linarith
      rw [Complex.cos]
      calc ‖(Complex.exp (ζ * Complex.I) + Complex.exp (-ζ * Complex.I)) / 2‖
          = ‖Complex.exp (ζ * Complex.I) + Complex.exp (-ζ * Complex.I)‖ / 2 := by
            rw [norm_div, Complex.norm_ofNat]
        _ ≤ (‖Complex.exp (ζ * Complex.I)‖ + ‖Complex.exp (-ζ * Complex.I)‖) / 2 := by
            gcongr; exact norm_add_le _ _
        _ = (Real.exp (-ζ.im) + Real.exp ζ.im) / 2 := by
            simp [Complex.norm_exp]
        _ ≤ 11 / 8 := by linarith
    have hcos_sub_one : ∀ w : ℂ, ‖w‖ ≤ 1 → ‖Complex.cos w - 1‖ ≤ ‖w‖ := by
      intro w hw
      have hw2_mem : w / 2 ∈ Metric.closedBall (0 : ℂ) (1 / 2) := by
        rw [Metric.mem_closedBall, dist_zero_right, norm_div, Complex.norm_ofNat]
        linarith
      have h0_mem : (0 : ℂ) ∈ Metric.closedBall (0 : ℂ) (1 / 2) :=
        Metric.mem_closedBall_self (by positivity)
      have hsin_half : ‖Complex.sin (w / 2)‖ ≤ (11 / 16) * ‖w‖ := by
        have hmv := Convex.norm_image_sub_le_of_norm_deriv_le (𝕜 := ℂ)
          (f := Complex.sin) (C := 11 / 8) (s := Metric.closedBall 0 (1 / 2))
          (fun ζ _ => Complex.differentiable_sin ζ)
          (fun ζ hζ => by simpa [Complex.deriv_sin] using hcos_half ζ hζ)
          (convex_closedBall 0 (1 / 2)) h0_mem hw2_mem
        simp only [Complex.sin_zero, sub_zero, norm_div, Complex.norm_ofNat] at hmv
        linarith
      have hid : Complex.cos w - 1 = -2 * Complex.sin (w / 2) ^ 2 := by
        have h2 : w = 2 * (w / 2) := by ring
        have hcs : Complex.cos (w / 2) ^ 2 = 1 - Complex.sin (w / 2) ^ 2 :=
          eq_sub_of_add_eq (Complex.cos_sq_add_sin_sq (w / 2))
        rw [h2, Complex.cos_two_mul, hcs]
        ring
      rw [hid, norm_mul, norm_neg, Complex.norm_ofNat, norm_pow]
      have hsin_nonneg : 0 ≤ ‖Complex.sin (w / 2)‖ := norm_nonneg _
      have hw_nonneg : 0 ≤ ‖w‖ := norm_nonneg _
      nlinarith
    intro z hz
    have hint_cos : IntervalIntegrable (fun τ : ℝ => Complex.cos ((τ : ℂ) * z)) MeasureTheory.volume 0 1 :=
      (Complex.continuous_cos.comp (Complex.continuous_ofReal.mul continuous_const)).intervalIntegrable 0 1
    have hsub_eq : sinc_ℂ z - 1 = ∫ τ in (0 : ℝ)..(1 : ℝ), (Complex.cos ((τ : ℂ) * z) - 1) := by
      rw [sinc_ℂ, intervalIntegral.integral_sub hint_cos intervalIntegrable_const]
      simp
    rw [hsub_eq]
    calc ‖∫ τ in (0 : ℝ)..(1 : ℝ), (Complex.cos ((τ : ℂ) * z) - 1)‖
        ≤ ‖z‖ * |(1 : ℝ) - 0| := intervalIntegral.norm_integral_le_of_norm_le_const (fun τ hτ => by
          have hτ_bounds : 0 < τ ∧ τ ≤ 1 := by simpa [Set.uIoc_of_le zero_le_one] using hτ
          have hτz_le : ‖(τ : ℂ) * z‖ ≤ ‖z‖ := by
            rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg hτ_bounds.1.le]
            exact mul_le_of_le_one_left (norm_nonneg z) hτ_bounds.2
          exact (hcos_sub_one _ (hτz_le.trans hz)).trans hτz_le)
      _ = ‖z‖ := by norm_num

  
  have h_diffOp_holo : ∀ (σ α : ℝ) (V_t : Set ℂ) (v : ℂ × ℂ → ℂ),
      0 < σ → 0 ≤ α → IsOpen V_t →
      DifferentiableOn ℂ v { p : ℂ × ℂ | p.2 ∈ V_t ∧ |p.1.im| + α * |p.2.im| < σ } →
      DifferentiableOn ℂ (glancingDiffOp v)
        { p : ℂ × ℂ | p.2 ∈ V_t ∧ |p.1.im| + (α + 1 / 2) * |p.2.im| < σ } := by
    intro σ α V_t v _ _ hVt hv
    let Wα : Set (ℂ × ℂ) := { p : ℂ × ℂ | p.2 ∈ V_t ∧ |p.1.im| + α * |p.2.im| < σ }
    let Wα' : Set (ℂ × ℂ) := { p : ℂ × ℂ | p.2 ∈ V_t ∧ |p.1.im| + (α + 1 / 2) * |p.2.im| < σ }
    have hWα_open : IsOpen Wα :=
      (hVt.preimage continuous_snd).inter
        (isOpen_lt
          (((continuous_abs.comp (Complex.continuous_im.comp continuous_fst)).add
            (continuous_const.mul (continuous_abs.comp (Complex.continuous_im.comp continuous_snd)))))
          continuous_const)
    have hWα'_open : IsOpen Wα' :=
      (hVt.preimage continuous_snd).inter
        (isOpen_lt
          (((continuous_abs.comp (Complex.continuous_im.comp continuous_fst)).add
            (continuous_const.mul (continuous_abs.comp (Complex.continuous_im.comp continuous_snd)))))
          continuous_const)
    have hdv_holo : DifferentiableOn ℂ (fun q : ℂ × ℂ => deriv (fun y' : ℂ => v (y', q.2)) q.1) Wα :=
      h_partial_y Wα v hWα_open hv
    have h_shift_mem : ∀ μ ∈ Set.uIcc (-1 / 2 : ℝ) (1 / 2 : ℝ), ∀ p ∈ Wα',
        (p.1 + (μ : ℂ) * p.2, p.2) ∈ Wα := by
      intro μ hμ p hp
      have hμ_le : (-1 / 2 : ℝ) ≤ μ ∧ μ ≤ 1 / 2 := by
        rwa [Set.uIcc_of_le (by norm_num)] at hμ
      have hμ_abs : |μ| ≤ 1 / 2 := abs_le.mpr (by constructor <;> linarith)
      refine ⟨hp.1, ?_⟩
      show |(p.1 + (μ : ℂ) * p.2).im| + α * |p.2.im| < σ
      have him_eq : (p.1 + (μ : ℂ) * p.2).im = p.1.im + μ * p.2.im := by simp
      rw [him_eq]
      have htri : |p.1.im + μ * p.2.im| ≤ |p.1.im| + |μ| * |p.2.im| := by
        simpa [abs_mul] using abs_add_le p.1.im (μ * p.2.im)
      have hmul : |μ| * |p.2.im| ≤ (1 / 2) * |p.2.im| :=
        mul_le_mul_of_nonneg_right hμ_abs (abs_nonneg _)
      linarith [hp.2]
    let F : ℝ → ℂ × ℂ → ℂ := fun μ p => deriv (fun y' : ℂ => v (y', p.2)) (p.1 + (μ : ℂ) * p.2)
    have hF_cont : ContinuousOn (fun q : ℝ × (ℂ × ℂ) => F q.1 q.2)
        (Set.uIcc (-1 / 2 : ℝ) (1 / 2 : ℝ) ×ˢ Wα') := by
      have h_map_cont : ContinuousOn (fun q : ℝ × (ℂ × ℂ) => (q.2.1 + (q.1 : ℂ) * q.2.2, q.2.2))
          (Set.uIcc (-1 / 2 : ℝ) (1 / 2 : ℝ) ×ˢ Wα') :=
        (((continuous_fst.comp continuous_snd).add
          ((Complex.continuous_ofReal.comp continuous_fst).mul (continuous_snd.comp continuous_snd))).prodMk
          (continuous_snd.comp continuous_snd)).continuousOn
      exact hdv_holo.continuousOn.comp h_map_cont (fun q hq => h_shift_mem q.1 hq.1 q.2 hq.2)
    have hF_holo : ∀ μ ∈ Set.uIcc (-1 / 2 : ℝ) (1 / 2 : ℝ), DifferentiableOn ℂ (F μ) Wα' := by
      intro μ hμ
      exact hdv_holo.comp
        ((differentiable_fst.add ((differentiable_const (μ : ℂ)).mul differentiable_snd)).prodMk
          differentiable_snd).differentiableOn
        (fun p hp => h_shift_mem μ hμ p hp)
    exact h_param_holo (-1 / 2) (1 / 2) Wα' F hWα'_open hF_cont hF_holo

  have h_diffOp_zero : ∀ (v : ℂ × ℂ → ℂ) (y : ℂ),
      glancingDiffOp v (y, 0) = deriv (fun y' : ℂ => v (y', 0)) y := by
    intro v y
    simp only [glancingDiffOp, mul_zero, add_zero, intervalIntegral.integral_const]
    norm_num

  have h_diffOp_ftc : ∀ (σ : ℝ) (y t : ℂ) (u : ℂ → ℂ),
      t ≠ 0 → |y.im| + |t.im| / 2 < σ →
      DifferentiableOn ℂ u (horizStrip σ) →
      glancingDiffOp (fun p => u p.1) (y, t) = t⁻¹ * (u (y + t / 2) - u (y - t / 2)) := by
    intro σ y t u ht hy_im hu
    have h_mem_strip : ∀ μ ∈ Set.uIcc (-1 / 2 : ℝ) (1 / 2 : ℝ), y + (μ : ℂ) * t ∈ horizStrip σ := by
      intro μ hμ
      have hμ_le : (-1 / 2 : ℝ) ≤ μ ∧ μ ≤ 1 / 2 := by
        rwa [Set.uIcc_of_le (by norm_num)] at hμ
      have hμ_abs : |μ| ≤ 1 / 2 := abs_le.mpr (by constructor <;> linarith)
      show |(y + (μ : ℂ) * t).im| < σ
      have him_eq : (y + (μ : ℂ) * t).im = y.im + μ * t.im := by simp
      rw [him_eq]
      have htri : |y.im + μ * t.im| ≤ |y.im| + |μ| * |t.im| := by
        simpa [abs_mul] using abs_add_le y.im (μ * t.im)
      have hmul : |μ| * |t.im| ≤ (1 / 2) * |t.im| :=
        mul_le_mul_of_nonneg_right hμ_abs (abs_nonneg _)
      linarith
    have hderiv_μ : ∀ μ ∈ Set.uIcc (-1 / 2 : ℝ) (1 / 2 : ℝ),
        HasDerivAt (fun s : ℝ => u (y + (s : ℂ) * t)) (deriv u (y + (μ : ℂ) * t) * t) μ := by
      intro μ hμ
      have hu_at : HasDerivAt u (deriv u (y + (μ : ℂ) * t)) (y + (μ : ℂ) * t) :=
        (hu.differentiableAt ((hStrip_open σ).mem_nhds (h_mem_strip μ hμ))).hasDerivAt
      have hlin : HasDerivAt (fun ζ : ℂ => y + ζ * t) t (μ : ℂ) := by
        simpa only [id_eq, one_mul] using ((hasDerivAt_id (μ : ℂ)).mul_const t).const_add y
      exact (hu_at.comp (μ : ℂ) hlin).comp_ofReal
    have hdu_cont : ContinuousOn (fun μ : ℝ => deriv u (y + (μ : ℂ) * t) * t)
        (Set.uIcc (-1 / 2 : ℝ) (1 / 2 : ℝ)) := by
      have hc : ContinuousOn (fun μ : ℝ => deriv u (y + (μ : ℂ) * t))
          (Set.uIcc (-1 / 2 : ℝ) (1 / 2 : ℝ)) :=
        (hu.deriv (hStrip_open σ)).continuousOn.comp
          (continuous_const.add (Complex.continuous_ofReal.mul continuous_const)).continuousOn
          (fun μ hμ => h_mem_strip μ hμ)
      exact hc.mul continuousOn_const
    have hmul_t : glancingDiffOp (fun p => u p.1) (y, t) * t = u (y + t / 2) - u (y - t / 2) := by
      rw [glancingDiffOp, ← intervalIntegral.integral_mul_const,
        intervalIntegral.integral_eq_sub_of_hasDerivAt hderiv_μ hdu_cont.intervalIntegrable]
      push_cast
      ring_nf
    calc glancingDiffOp (fun p => u p.1) (y, t)
        = t⁻¹ * (glancingDiffOp (fun p => u p.1) (y, t) * t) := by
          rw [mul_comm _ t, ← mul_assoc, inv_mul_cancel₀ ht, one_mul]
      _ = t⁻¹ * (u (y + t / 2) - u (y - t / 2)) := by rw [hmul_t]

  have h_diffOp_even : ∀ (σ α : ℝ) (V_t : Set ℂ) (v : ℂ × ℂ → ℂ),
      0 ≤ α → IsOpen V_t → (∀ t ∈ V_t, -t ∈ V_t) →
      DifferentiableOn ℂ v { p : ℂ × ℂ | p.2 ∈ V_t ∧ |p.1.im| + α * |p.2.im| < σ } →
      (∀ y t : ℂ, t ∈ V_t → |y.im| + α * |t.im| < σ → v (y, -t) = v (y, t)) →
      ∀ y t : ℂ, t ∈ V_t → |y.im| + (α + 1 / 2) * |t.im| < σ →
        glancingDiffOp v (y, -t) = glancingDiffOp v (y, t) := by
    intro σ α V_t v _ _ _ _ hv_even y t ht hy_im
    have h_flip : glancingDiffOp v (y, t) =
        ∫ μ in (-1 / 2 : ℝ)..(1 / 2 : ℝ),
          deriv (fun y' : ℂ => v (y', t)) (y + ((-μ : ℝ) : ℂ) * t) := by
      let f_int : ℝ → ℂ := fun μ => deriv (fun y' : ℂ => v (y', t)) (y + (μ : ℂ) * t)
      have hcomp : (∫ μ in (-1 / 2 : ℝ)..(1 / 2 : ℝ), f_int (-μ)) =
          ∫ μ in -(1 / 2 : ℝ)..-(-1 / 2 : ℝ), f_int μ :=
        intervalIntegral.integral_comp_neg f_int
      have h_end1 : -(1 / 2 : ℝ) = (-1 / 2 : ℝ) := by norm_num
      have h_end2 : -(-1 / 2 : ℝ) = (1 / 2 : ℝ) := by norm_num
      rw [h_end1, h_end2] at hcomp
      exact hcomp.symm
    rw [h_flip, glancingDiffOp]
    refine intervalIntegral.integral_congr (fun μ hμ => ?_)
    have hμ_le : (-1 / 2 : ℝ) ≤ μ ∧ μ ≤ 1 / 2 := by
      rwa [Set.uIcc_of_le (by norm_num)] at hμ
    have hμ_abs : |μ| ≤ 1 / 2 := abs_le.mpr (by constructor <;> linarith)
    let z₀ : ℂ := y + (μ : ℂ) * (-t)
    have hz₀_eq : y + ((-μ : ℝ) : ℂ) * t = z₀ := by
      dsimp [z₀]; push_cast; ring
    rw [hz₀_eq]
    have hz₀_im : |z₀.im| < σ - α * |t.im| := by
      have him_eq : z₀.im = y.im - μ * t.im := by simp [z₀]; ring
      rw [him_eq]
      have htri : |y.im - μ * t.im| ≤ |y.im| + |μ| * |t.im| := by
        simpa [sub_eq_add_neg, abs_mul] using abs_add_le y.im (-(μ * t.im))
      have hmul : |μ| * |t.im| ≤ (1 / 2) * |t.im| :=
        mul_le_mul_of_nonneg_right hμ_abs (abs_nonneg _)
      linarith
    have hU_open : IsOpen { y' : ℂ | |y'.im| < σ - α * |t.im| } :=
      isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const
    have hev : (fun y' : ℂ => v (y', -t)) =ᶠ[nhds z₀] (fun y' : ℂ => v (y', t)) := by
      filter_upwards [hU_open.mem_nhds hz₀_im] with y' hy'
      exact hv_even y' t ht (by linarith [show |y'.im| < σ - α * |t.im| from hy'])
    exact hev.deriv_eq

  
  have h_dslope : ∀ (R M : ℝ) (g : ℂ → ℂ),
      0 < R → 0 ≤ M →
      DifferentiableOn ℂ g (Metric.ball (0 : ℂ) R) →
      (∀ ζ ∈ Metric.ball (0 : ℂ) R, ‖g ζ‖ ≤ M) →
      ∀ z ∈ Metric.ball (0 : ℂ) R,
        ‖g z - g 0 - z * deriv g 0‖ ≤ (4 * M / R ^ 2) * ‖z‖ ^ 2 := by
    intro R M g hR _ hg hM z hz
    let g₁ : ℂ → ℂ := dslope g 0
    have h0_mem : (0 : ℂ) ∈ Metric.ball (0 : ℂ) R := Metric.mem_ball_self hR
    have hg₁_holo : DifferentiableOn ℂ g₁ (Metric.ball (0 : ℂ) R) :=
      (Complex.differentiableOn_dslope (Metric.ball_mem_nhds 0 hR)).mpr hg
    have hg_maps : Set.MapsTo g (Metric.ball (0 : ℂ) R) (Metric.closedBall (g 0) (2 * M)) := by
      intro ζ hζ
      rw [Metric.mem_closedBall, dist_eq_norm]
      calc ‖g ζ - g 0‖ ≤ ‖g ζ‖ + ‖g 0‖ := norm_sub_le _ _
        _ ≤ M + M := add_le_add (hM ζ hζ) (hM 0 h0_mem)
        _ = 2 * M := by ring
    have hg₁_bound : ∀ ζ ∈ Metric.ball (0 : ℂ) R, ‖g₁ ζ‖ ≤ 2 * M / R := fun ζ hζ =>
      Complex.norm_dslope_le_div_of_mapsTo_ball hg hg_maps hζ
    have hg₁_maps : Set.MapsTo g₁ (Metric.ball (0 : ℂ) R) (Metric.closedBall (g₁ 0) (4 * M / R)) := by
      intro ζ hζ
      rw [Metric.mem_closedBall, dist_eq_norm]
      calc ‖g₁ ζ - g₁ 0‖ ≤ ‖g₁ ζ‖ + ‖g₁ 0‖ := norm_sub_le _ _
        _ ≤ 2 * M / R + 2 * M / R := add_le_add (hg₁_bound ζ hζ) (hg₁_bound 0 h0_mem)
        _ = 4 * M / R := by ring
    have hg₂_bound : ‖dslope g₁ 0 z‖ ≤ (4 * M / R) / R :=
      Complex.norm_dslope_le_div_of_mapsTo_ball hg₁_holo hg₁_maps hz
    have h_alg : g z - g 0 - z * deriv g 0 = z ^ 2 * dslope g₁ 0 z := by
      have h1 : z * g₁ z = g z - g 0 := by simpa [g₁, smul_eq_mul] using sub_smul_dslope g 0 z
      have h2 : z * dslope g₁ 0 z = g₁ z - deriv g 0 := by
        simpa [g₁, dslope_same, smul_eq_mul] using sub_smul_dslope g₁ 0 z
      calc g z - g 0 - z * deriv g 0
          = z * g₁ z - z * deriv g 0 := by rw [h1]
        _ = z * (g₁ z - deriv g 0) := by ring
        _ = z * (z * dslope g₁ 0 z) := by rw [h2]
        _ = z ^ 2 * dslope g₁ 0 z := by ring
    rw [h_alg, norm_mul, norm_pow]
    calc ‖z‖ ^ 2 * ‖dslope g₁ 0 z‖
        ≤ ‖z‖ ^ 2 * ((4 * M / R) / R) := mul_le_mul_of_nonneg_left hg₂_bound (sq_nonneg _)
      _ = (4 * M / R ^ 2) * ‖z‖ ^ 2 := by rw [div_div, ← sq]; ring

  exact {
    partial_y_holo := h_partial_y
    partial_t_holo := h_partial_t
    param_integral_holo := h_param_holo
    param_integral_cont := h_param_cont
    deriv_conj_strip := h_deriv_conj
    sinc_props := ⟨h_sinc_diff, h_sinc_zero, h_sinc_neg, h_sinc_conj, h_sinc_mul, h_sinc_bound⟩
    diffOp_props := ⟨h_diffOp_holo, h_diffOp_zero, h_diffOp_ftc, h_diffOp_even⟩
    dslope_quad_bound := h_dslope
  }

theorem normalized_action_calculus_and_taylor (Ω : Set Plane)
    (B : AnalyticBoundaryData Ω)
    (hCalc : UniversalGlancingCalculus) :
    Nonempty (NormActionPackage B) :=
by
  
  
  
  have hc_pos : 0 < B.c := B.c_pos
  have hs0_pos : 0 < B.s₀ := B.s₀_pos
  have hsh_pos : 0 < B.s_h := B.s_h_pos
  have isOpen_strip : ∀ H : ℝ, IsOpen (horizStrip H) :=
    fun H => isOpen_lt Complex.continuous_im.abs continuous_const
  have strip_mono : ∀ {H₁ H₂ : ℝ}, H₁ ≤ H₂ → horizStrip H₁ ⊆ horizStrip H₂ :=
    fun hle _ hz => lt_of_lt_of_le hz hle
  have convex_strip : ∀ H : ℝ, Convex ℝ (horizStrip H) := by
    intro H
    have h_eq : horizStrip H = Complex.imCLM ⁻¹' Set.Ioo (-H) H := by
      ext z; simp [horizStrip, abs_lt]
    rw [h_eq]
    exact (convex_Ioo (-H) H).linear_preimage Complex.imCLM.toLinearMap
  have conj_mem_strip : ∀ {H : ℝ} {z : ℂ}, z ∈ horizStrip H → starRingEnd ℂ z ∈ horizStrip H := by
    intro H z hz
    change |z.im| < H at hz
    change |(starRingEnd ℂ z).im| < H
    simpa using hz
  have add_real_mem_strip : ∀ {H : ℝ} {z : ℂ} (x : ℝ), z ∈ horizStrip H → z + (x : ℂ) ∈ horizStrip H := by
    intro H z x hz
    change |z.im| < H at hz
    change |(z + (x : ℂ)).im| < H
    simpa using hz
  have add_two_pi_mem_strip : ∀ {H : ℝ} {z : ℂ}, z ∈ horizStrip H → z + 2 * Real.pi ∈ horizStrip H := by
    intro H z hz
    have hcast : z + 2 * Real.pi = z + ((2 * Real.pi : ℝ) : ℂ) := by push_cast; rfl
    rw [hcast]
    exact add_real_mem_strip _ hz
  have real_mem_strip : ∀ {H : ℝ} (x : ℝ), 0 < H → (x : ℂ) ∈ horizStrip H := by
    intro H x hH; simp [horizStrip, hH]
  have mid_mem_strip : ∀ {H : ℝ} {w₁ w₂ : ℂ},
      w₁ ∈ horizStrip H → w₂ ∈ horizStrip H → (w₁ + w₂) / 2 ∈ horizStrip H := by
    intro H w₁ w₂ hw₁ hw₂
    change |w₁.im| < H at hw₁
    change |w₂.im| < H at hw₂
    change |((w₁ + w₂) / 2).im| < H
    have him : ((w₁ + w₂) / 2).im = (w₁.im + w₂.im) / 2 := by simp [add_div]
    rw [him, abs_div, abs_of_pos (by norm_num : (0 : ℝ) < 2)]
    linarith [abs_add_le w₁.im w₂.im]
  have hc_ne : (B.c : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hc_pos.ne'
  have h2c_ne : 2 * (B.c : ℂ) ≠ 0 := mul_ne_zero two_ne_zero hc_ne
  have norm_c : ‖(B.c : ℂ)‖ = B.c := by
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos hc_pos]
  have hS3_sub : horizStrip (3 * B.s₀ / 2) ⊆ horizStrip (2 * B.s₀) :=
    strip_mono (by linarith)
  have hS54_sub : horizStrip (5 * B.s₀ / 4) ⊆ horizStrip (3 * B.s₀ / 2) :=
    strip_mono (by linarith)
  have hS1_sub : horizStrip B.s₀ ⊆ horizStrip (3 * B.s₀ / 2) :=
    strip_mono (by linarith)

  
  
  
  have hdh_holo : DifferentiableOn ℂ (deriv B.h_ℂ) (horizStrip (2 * B.s_h)) :=
    B.h_ℂ_holo.deriv (isOpen_strip _)
  have hddh_holo : DifferentiableOn ℂ (deriv (deriv B.h_ℂ)) (horizStrip (2 * B.s_h)) :=
    hdh_holo.deriv (isOpen_strip _)
  have hr_holo : DifferentiableOn ℂ (r_ℂ B) (horizStrip (2 * B.s_h)) :=
    B.h_ℂ_holo.add hddh_holo
  have hdr_holo : DifferentiableOn ℂ (deriv (r_ℂ B)) (horizStrip (2 * B.s_h)) :=
    hr_holo.deriv (isOpen_strip _)
  have hdϕ_holo : DifferentiableOn ℂ (deriv B.ϕ_ℂ) (horizStrip (2 * B.s₀)) :=
    B.ϕ_ℂ_holo.deriv (isOpen_strip _)
  have hddϕ_holo : DifferentiableOn ℂ (deriv (deriv B.ϕ_ℂ)) (horizStrip (2 * B.s₀)) :=
    hdϕ_holo.deriv (isOpen_strip _)

  have deriv_periodic_strip : ∀ {σ : ℝ} {g : ℂ → ℂ},
      (∀ w ∈ horizStrip σ, g (w + 2 * Real.pi) = g w) →
      ∀ w ∈ horizStrip σ, deriv g (w + 2 * Real.pi) = deriv g w := by
    intro σ g hper w hw
    have hev : (fun z : ℂ => g (z + (2 * (Real.pi : ℂ)))) =ᶠ[nhds w] g :=
      Filter.eventually_of_mem ((isOpen_strip σ).mem_nhds hw) (fun z hz => hper z hz)
    have hd1 : deriv (fun z : ℂ => g (z + (2 * (Real.pi : ℂ)))) w = deriv g w := hev.deriv_eq
    rw [deriv_comp_add_const] at hd1
    exact hd1
  have hdh_per : ∀ w ∈ horizStrip (2 * B.s_h), deriv B.h_ℂ (w + 2 * Real.pi) = deriv B.h_ℂ w :=
    deriv_periodic_strip B.h_ℂ_periodic
  have hddh_per : ∀ w ∈ horizStrip (2 * B.s_h),
      deriv (deriv B.h_ℂ) (w + 2 * Real.pi) = deriv (deriv B.h_ℂ) w :=
    deriv_periodic_strip hdh_per
  have hr_per : ∀ w ∈ horizStrip (2 * B.s_h), r_ℂ B (w + 2 * Real.pi) = r_ℂ B w := by
    intro w hw; simp only [r_ℂ, B.h_ℂ_periodic w hw, hddh_per w hw]
  have hdr_per : ∀ w ∈ horizStrip (2 * B.s_h),
      deriv (r_ℂ B) (w + 2 * Real.pi) = deriv (r_ℂ B) w :=
    deriv_periodic_strip hr_per
  have hdϕ_per : ∀ z ∈ horizStrip (2 * B.s₀), deriv B.ϕ_ℂ (z + 2 * Real.pi) = deriv B.ϕ_ℂ z := by
    intro z hz
    rw [B.deriv_ϕ_ℂ_eq_exp _ (add_two_pi_mem_strip hz), B.deriv_ϕ_ℂ_eq_exp z hz, B.u_ℂ_periodic z hz]
  have hddϕ_per : ∀ z ∈ horizStrip (2 * B.s₀),
      deriv (deriv B.ϕ_ℂ) (z + 2 * Real.pi) = deriv (deriv B.ϕ_ℂ) z :=
    deriv_periodic_strip hdϕ_per

  have hdϕ_conj : ∀ z ∈ horizStrip (2 * B.s₀),
      deriv B.ϕ_ℂ (starRingEnd ℂ z) = starRingEnd ℂ (deriv B.ϕ_ℂ z) :=
    hCalc.deriv_conj_strip (2 * B.s₀) B.ϕ_ℂ B.ϕ_ℂ_holo B.ϕ_ℂ_conj
  have hdh_conj : ∀ w ∈ horizStrip (2 * B.s_h),
      deriv B.h_ℂ (starRingEnd ℂ w) = starRingEnd ℂ (deriv B.h_ℂ w) :=
    hCalc.deriv_conj_strip (2 * B.s_h) B.h_ℂ B.h_ℂ_holo B.h_ℂ_conj
  have hddh_conj : ∀ w ∈ horizStrip (2 * B.s_h),
      deriv (deriv B.h_ℂ) (starRingEnd ℂ w) = starRingEnd ℂ (deriv (deriv B.h_ℂ) w) :=
    hCalc.deriv_conj_strip (2 * B.s_h) (deriv B.h_ℂ) hdh_holo hdh_conj
  have hr_conj : ∀ w ∈ horizStrip (2 * B.s_h),
      r_ℂ B (starRingEnd ℂ w) = starRingEnd ℂ (r_ℂ B w) := by
    intro w hw; simp only [r_ℂ, map_add, B.h_ℂ_conj w hw, hddh_conj w hw]

  
  
  
  have h_swap : ∀ X Y : ℂ, normAction2_ℂ B X Y = -normAction1_ℂ B Y X := by
    intro X Y
    simp only [normAction2_ℂ, normAction1_ℂ, supportAction2_ℂ, supportAction1_ℂ]
    have hmid : (B.ϕ_ℂ Y + B.ϕ_ℂ X) / 2 = (B.ϕ_ℂ X + B.ϕ_ℂ Y) / 2 := by ring
    have hdiff : (B.ϕ_ℂ X - B.ϕ_ℂ Y) / 2 = -((B.ϕ_ℂ Y - B.ϕ_ℂ X) / 2) := by ring
    rw [hmid, hdiff, Complex.sin_neg, Complex.cos_neg]
    ring

  let W₃ : Set (ℂ × ℂ) := horizStrip (3 * B.s₀ / 2) ×ˢ horizStrip (3 * B.s₀ / 2)
  have isOpen_W3 : IsOpen W₃ := (isOpen_strip _).prod (isOpen_strip _)
  have h_act1_holo : DifferentiableOn ℂ (fun q : ℂ × ℂ => normAction1_ℂ B q.1 q.2) W₃ := by
    have hϕ1 : DifferentiableOn ℂ (fun q : ℂ × ℂ => B.ϕ_ℂ q.1) W₃ :=
      B.ϕ_ℂ_holo.comp differentiable_fst.differentiableOn (fun _ hq => hS3_sub hq.1)
    have hϕ2 : DifferentiableOn ℂ (fun q : ℂ × ℂ => B.ϕ_ℂ q.2) W₃ :=
      B.ϕ_ℂ_holo.comp differentiable_snd.differentiableOn (fun _ hq => hS3_sub hq.2)
    have hdϕ1 : DifferentiableOn ℂ (fun q : ℂ × ℂ => deriv B.ϕ_ℂ q.1) W₃ :=
      hdϕ_holo.comp differentiable_fst.differentiableOn (fun _ hq => hS3_sub hq.1)
    have hmid : DifferentiableOn ℂ (fun q : ℂ × ℂ => (B.ϕ_ℂ q.1 + B.ϕ_ℂ q.2) / 2) W₃ :=
      ((hϕ1.add hϕ2).mul_const (2⁻¹ : ℂ)).congr (fun _ _ => by simp [div_eq_mul_inv])
    have hdiff : DifferentiableOn ℂ (fun q : ℂ × ℂ => (B.ϕ_ℂ q.2 - B.ϕ_ℂ q.1) / 2) W₃ :=
      ((hϕ2.sub hϕ1).mul_const (2⁻¹ : ℂ)).congr (fun _ _ => by simp [div_eq_mul_inv])
    have hmid_maps : Set.MapsTo (fun q : ℂ × ℂ => (B.ϕ_ℂ q.1 + B.ϕ_ℂ q.2) / 2) W₃
        (horizStrip (2 * B.s_h)) :=
      fun _ hq => mid_mem_strip (B.ϕ_ℂ_maps_to _ (hS3_sub hq.1)) (B.ϕ_ℂ_maps_to _ (hS3_sub hq.2))
    have hϕ1_maps : Set.MapsTo (fun q : ℂ × ℂ => B.ϕ_ℂ q.1) W₃ (horizStrip (2 * B.s_h)) :=
      fun _ hq => B.ϕ_ℂ_maps_to _ (hS3_sub hq.1)
    have h_sa1 : DifferentiableOn ℂ
        (fun q : ℂ × ℂ => supportAction1_ℂ B.h_ℂ (B.ϕ_ℂ q.1) (B.ϕ_ℂ q.2)) W₃ :=
      ((hdh_holo.comp hmid hmid_maps).mul (Complex.differentiable_sin.comp_differentiableOn hdiff)).sub
        ((B.h_ℂ_holo.comp hmid hmid_maps).mul (Complex.differentiable_cos.comp_differentiableOn hdiff))
    have hdϕ1_c : DifferentiableOn ℂ (fun q : ℂ × ℂ => deriv B.ϕ_ℂ q.1 / (B.c : ℂ)) W₃ :=
      (hdϕ1.mul_const ((B.c : ℂ)⁻¹)).congr (fun _ _ => by simp [div_eq_mul_inv])
    exact hdϕ1_c.mul (h_sa1.add (B.h_ℂ_holo.comp hϕ1 hϕ1_maps))

  have h_act2_holo : DifferentiableOn ℂ (fun q : ℂ × ℂ => normAction2_ℂ B q.1 q.2) W₃ := by
    have h_eq : (fun q : ℂ × ℂ => normAction2_ℂ B q.1 q.2) =
        (fun q : ℂ × ℂ => -(normAction1_ℂ B q.2 q.1)) := by
      ext q; exact h_swap q.1 q.2
    rw [h_eq]
    have hswap_diff : Differentiable ℂ (fun q : ℂ × ℂ => (q.2, q.1)) :=
      differentiable_snd.prodMk differentiable_fst
    exact (h_act1_holo.comp hswap_diff.differentiableOn (fun _ hq => ⟨hq.2, hq.1⟩)).neg

  have h_act12_holo : DifferentiableOn ℂ (fun q : ℂ × ℂ => normAction12_ℂ B q.1 q.2) W₃ := by
    have hϕ1 : DifferentiableOn ℂ (fun q : ℂ × ℂ => B.ϕ_ℂ q.1) W₃ :=
      B.ϕ_ℂ_holo.comp differentiable_fst.differentiableOn (fun _ hq => hS3_sub hq.1)
    have hϕ2 : DifferentiableOn ℂ (fun q : ℂ × ℂ => B.ϕ_ℂ q.2) W₃ :=
      B.ϕ_ℂ_holo.comp differentiable_snd.differentiableOn (fun _ hq => hS3_sub hq.2)
    have hdϕ1 : DifferentiableOn ℂ (fun q : ℂ × ℂ => deriv B.ϕ_ℂ q.1) W₃ :=
      hdϕ_holo.comp differentiable_fst.differentiableOn (fun _ hq => hS3_sub hq.1)
    have hdϕ2 : DifferentiableOn ℂ (fun q : ℂ × ℂ => deriv B.ϕ_ℂ q.2) W₃ :=
      hdϕ_holo.comp differentiable_snd.differentiableOn (fun _ hq => hS3_sub hq.2)
    have hmid : DifferentiableOn ℂ (fun q : ℂ × ℂ => (B.ϕ_ℂ q.1 + B.ϕ_ℂ q.2) / 2) W₃ :=
      ((hϕ1.add hϕ2).mul_const (2⁻¹ : ℂ)).congr (fun _ _ => by simp [div_eq_mul_inv])
    have hdiff : DifferentiableOn ℂ (fun q : ℂ × ℂ => (B.ϕ_ℂ q.2 - B.ϕ_ℂ q.1) / 2) W₃ :=
      ((hϕ2.sub hϕ1).mul_const (2⁻¹ : ℂ)).congr (fun _ _ => by simp [div_eq_mul_inv])
    have hmid_maps : Set.MapsTo (fun q : ℂ × ℂ => (B.ϕ_ℂ q.1 + B.ϕ_ℂ q.2) / 2) W₃
        (horizStrip (2 * B.s_h)) :=
      fun _ hq => mid_mem_strip (B.ϕ_ℂ_maps_to _ (hS3_sub hq.1)) (B.ϕ_ℂ_maps_to _ (hS3_sub hq.2))
    have hdϕ12_c : DifferentiableOn ℂ
        (fun q : ℂ × ℂ => deriv B.ϕ_ℂ q.1 * deriv B.ϕ_ℂ q.2 / (2 * (B.c : ℂ))) W₃ :=
      ((hdϕ1.mul hdϕ2).mul_const ((2 * (B.c : ℂ))⁻¹)).congr (fun _ _ => by simp [div_eq_mul_inv])
    exact (hdϕ12_c.mul (hr_holo.comp hmid hmid_maps)).mul
      (Complex.differentiable_sin.comp_differentiableOn hdiff)

  have h_diag_per_1 : ∀ X Y : ℂ,
      X ∈ horizStrip (3 * B.s₀ / 2) → Y ∈ horizStrip (3 * B.s₀ / 2) →
      normAction1_ℂ B (X + 2 * Real.pi) (Y + 2 * Real.pi) = normAction1_ℂ B X Y := by
    intro X Y hX hY
    have hX0 := hS3_sub hX
    have hY0 := hS3_sub hY
    have hmid_sh : (B.ϕ_ℂ (X + 2 * Real.pi) + B.ϕ_ℂ (Y + 2 * Real.pi)) / 2 =
        (B.ϕ_ℂ X + B.ϕ_ℂ Y) / 2 + 2 * Real.pi := by
      rw [B.ϕ_ℂ_quasiperiodic X hX0, B.ϕ_ℂ_quasiperiodic Y hY0]; ring
    have hdiff_sh : (B.ϕ_ℂ (Y + 2 * Real.pi) - B.ϕ_ℂ (X + 2 * Real.pi)) / 2 =
        (B.ϕ_ℂ Y - B.ϕ_ℂ X) / 2 := by
      rw [B.ϕ_ℂ_quasiperiodic X hX0, B.ϕ_ℂ_quasiperiodic Y hY0]; ring
    have hmid_mem : (B.ϕ_ℂ X + B.ϕ_ℂ Y) / 2 ∈ horizStrip (2 * B.s_h) :=
      mid_mem_strip (B.ϕ_ℂ_maps_to X hX0) (B.ϕ_ℂ_maps_to Y hY0)
    simp only [normAction1_ℂ, supportAction1_ℂ, hdϕ_per X hX0, hmid_sh, hdiff_sh,
      hdh_per _ hmid_mem, B.h_ℂ_periodic _ hmid_mem]
    rw [B.ϕ_ℂ_quasiperiodic X hX0, B.h_ℂ_periodic _ (B.ϕ_ℂ_maps_to X hX0)]

  have h_diag_per : ∀ X Y : ℂ,
      X ∈ horizStrip (3 * B.s₀ / 2) → Y ∈ horizStrip (3 * B.s₀ / 2) →
      normAction1_ℂ B (X + 2 * Real.pi) (Y + 2 * Real.pi) = normAction1_ℂ B X Y ∧
      normAction2_ℂ B (X + 2 * Real.pi) (Y + 2 * Real.pi) = normAction2_ℂ B X Y ∧
      normAction12_ℂ B (X + 2 * Real.pi) (Y + 2 * Real.pi) = normAction12_ℂ B X Y := by
    intro X Y hX hY
    refine ⟨h_diag_per_1 X Y hX hY, ?_, ?_⟩
    · rw [h_swap, h_swap X Y, h_diag_per_1 Y X hY hX]
    · have hX0 := hS3_sub hX
      have hY0 := hS3_sub hY
      have hmid_sh : (B.ϕ_ℂ (X + 2 * Real.pi) + B.ϕ_ℂ (Y + 2 * Real.pi)) / 2 =
          (B.ϕ_ℂ X + B.ϕ_ℂ Y) / 2 + 2 * Real.pi := by
        rw [B.ϕ_ℂ_quasiperiodic X hX0, B.ϕ_ℂ_quasiperiodic Y hY0]; ring
      have hdiff_sh : (B.ϕ_ℂ (Y + 2 * Real.pi) - B.ϕ_ℂ (X + 2 * Real.pi)) / 2 =
          (B.ϕ_ℂ Y - B.ϕ_ℂ X) / 2 := by
        rw [B.ϕ_ℂ_quasiperiodic X hX0, B.ϕ_ℂ_quasiperiodic Y hY0]; ring
      have hmid_mem : (B.ϕ_ℂ X + B.ϕ_ℂ Y) / 2 ∈ horizStrip (2 * B.s_h) :=
        mid_mem_strip (B.ϕ_ℂ_maps_to X hX0) (B.ϕ_ℂ_maps_to Y hY0)
      simp only [normAction12_ℂ, hdϕ_per X hX0, hdϕ_per Y hY0, hmid_sh, hdiff_sh, hr_per _ hmid_mem]

  have h_conj_1 : ∀ X Y : ℂ,
      X ∈ horizStrip (3 * B.s₀ / 2) → Y ∈ horizStrip (3 * B.s₀ / 2) →
      normAction1_ℂ B (starRingEnd ℂ X) (starRingEnd ℂ Y) =
        starRingEnd ℂ (normAction1_ℂ B X Y) := by
    intro X Y hX hY
    have hX0 := hS3_sub hX
    have hY0 := hS3_sub hY
    have hmid_mem : (B.ϕ_ℂ X + B.ϕ_ℂ Y) / 2 ∈ horizStrip (2 * B.s_h) :=
      mid_mem_strip (B.ϕ_ℂ_maps_to X hX0) (B.ϕ_ℂ_maps_to Y hY0)
    have hmid_c : (B.ϕ_ℂ (starRingEnd ℂ X) + B.ϕ_ℂ (starRingEnd ℂ Y)) / 2 =
        starRingEnd ℂ ((B.ϕ_ℂ X + B.ϕ_ℂ Y) / 2) := by
      rw [B.ϕ_ℂ_conj X hX0, B.ϕ_ℂ_conj Y hY0]; simp [map_ofNat]
    have hdiff_c : (B.ϕ_ℂ (starRingEnd ℂ Y) - B.ϕ_ℂ (starRingEnd ℂ X)) / 2 =
        starRingEnd ℂ ((B.ϕ_ℂ Y - B.ϕ_ℂ X) / 2) := by
      rw [B.ϕ_ℂ_conj X hX0, B.ϕ_ℂ_conj Y hY0]; simp [map_ofNat]
    simp only [normAction1_ℂ, supportAction1_ℂ]
    rw [hmid_c, hdiff_c, hdϕ_conj X hX0, hdh_conj _ hmid_mem, B.h_ℂ_conj _ hmid_mem,
      B.ϕ_ℂ_conj X hX0, B.h_ℂ_conj _ (B.ϕ_ℂ_maps_to X hX0), Complex.sin_conj, Complex.cos_conj]
    simp

  have h_conj : ∀ X Y : ℂ,
      X ∈ horizStrip (3 * B.s₀ / 2) → Y ∈ horizStrip (3 * B.s₀ / 2) →
      normAction1_ℂ B (starRingEnd ℂ X) (starRingEnd ℂ Y) =
        starRingEnd ℂ (normAction1_ℂ B X Y) ∧
      normAction2_ℂ B (starRingEnd ℂ X) (starRingEnd ℂ Y) =
        starRingEnd ℂ (normAction2_ℂ B X Y) ∧
      normAction12_ℂ B (starRingEnd ℂ X) (starRingEnd ℂ Y) =
        starRingEnd ℂ (normAction12_ℂ B X Y) := by
    intro X Y hX hY
    refine ⟨h_conj_1 X Y hX hY, ?_, ?_⟩
    · rw [h_swap, h_swap X Y, map_neg, h_conj_1 Y X hY hX]
    · have hX0 := hS3_sub hX
      have hY0 := hS3_sub hY
      have hmid_mem : (B.ϕ_ℂ X + B.ϕ_ℂ Y) / 2 ∈ horizStrip (2 * B.s_h) :=
        mid_mem_strip (B.ϕ_ℂ_maps_to X hX0) (B.ϕ_ℂ_maps_to Y hY0)
      have hmid_c : (B.ϕ_ℂ (starRingEnd ℂ X) + B.ϕ_ℂ (starRingEnd ℂ Y)) / 2 =
          starRingEnd ℂ ((B.ϕ_ℂ X + B.ϕ_ℂ Y) / 2) := by
        rw [B.ϕ_ℂ_conj X hX0, B.ϕ_ℂ_conj Y hY0]; simp [map_ofNat]
      have hdiff_c : (B.ϕ_ℂ (starRingEnd ℂ Y) - B.ϕ_ℂ (starRingEnd ℂ X)) / 2 =
          starRingEnd ℂ ((B.ϕ_ℂ Y - B.ϕ_ℂ X) / 2) := by
        rw [B.ϕ_ℂ_conj X hX0, B.ϕ_ℂ_conj Y hY0]; simp [map_ofNat]
      simp only [normAction12_ℂ]
      rw [hmid_c, hdiff_c, hdϕ_conj X hX0, hdϕ_conj Y hY0, hr_conj _ hmid_mem, Complex.sin_conj]
      simp [map_ofNat]

  have h_deriv1_right : ∀ X Y : ℂ,
      X ∈ horizStrip (3 * B.s₀ / 2) → Y ∈ horizStrip (3 * B.s₀ / 2) →
      deriv (fun Y' : ℂ => normAction1_ℂ B X Y') Y = normAction12_ℂ B X Y := by
    intro X Y hX hY
    have hX0 := hS3_sub hX
    have hY0 := hS3_sub hY
    let θ₁ := B.ϕ_ℂ X
    let θ₂ := B.ϕ_ℂ Y
    have hmid_mem : (θ₁ + θ₂) / 2 ∈ horizStrip (2 * B.s_h) :=
      mid_mem_strip (B.ϕ_ℂ_maps_to X hX0) (B.ϕ_ℂ_maps_to Y hY0)
    have hϕY : HasDerivAt B.ϕ_ℂ (deriv B.ϕ_ℂ Y) Y :=
      (B.ϕ_ℂ_holo.differentiableAt ((isOpen_strip _).mem_nhds hY0)).hasDerivAt
    have hψ : HasDerivAt (fun Y' : ℂ => (θ₁ + B.ϕ_ℂ Y') / 2) (deriv B.ϕ_ℂ Y / 2) Y := by
      simpa using (hϕY.const_add θ₁).div_const (2 : ℂ)
    have hΔ : HasDerivAt (fun Y' : ℂ => (B.ϕ_ℂ Y' - θ₁) / 2) (deriv B.ϕ_ℂ Y / 2) Y := by
      simpa using (hϕY.sub_const θ₁).div_const (2 : ℂ)
    have hh_at : HasDerivAt B.h_ℂ (deriv B.h_ℂ ((θ₁ + θ₂) / 2)) ((θ₁ + θ₂) / 2) :=
      (B.h_ℂ_holo.differentiableAt ((isOpen_strip _).mem_nhds hmid_mem)).hasDerivAt
    have hdh_at : HasDerivAt (deriv B.h_ℂ) (deriv (deriv B.h_ℂ) ((θ₁ + θ₂) / 2)) ((θ₁ + θ₂) / 2) :=
      (hdh_holo.differentiableAt ((isOpen_strip _).mem_nhds hmid_mem)).hasDerivAt
    have h_sa1 := ((hdh_at.comp Y hψ).mul hΔ.csin).sub ((hh_at.comp Y hψ).mul hΔ.ccos)
    have h_tot := ((h_sa1.congr_of_eventuallyEq
      (Filter.EventuallyEq.of_eq (by ext Y'; rfl :
        _ = (fun Y' : ℂ => supportAction1_ℂ B.h_ℂ θ₁ (B.ϕ_ℂ Y'))))).add_const
          (B.h_ℂ θ₁)).const_mul (deriv B.ϕ_ℂ X / (B.c : ℂ))
    have h_tot' := h_tot.congr_of_eventuallyEq
      (Filter.EventuallyEq.of_eq (by ext Y'; rfl : _ = (fun Y' : ℂ => normAction1_ℂ B X Y')))
    rw [h_tot'.deriv]
    simp only [Function.comp_apply, normAction12_ℂ, r_ℂ, θ₁, θ₂]
    ring

  have h_deriv2_left : ∀ X Y : ℂ,
      X ∈ horizStrip (3 * B.s₀ / 2) → Y ∈ horizStrip (3 * B.s₀ / 2) →
      deriv (fun X' : ℂ => normAction2_ℂ B X' Y) X = normAction12_ℂ B X Y := by
    intro X Y hX hY
    have hfun : (fun X' : ℂ => normAction2_ℂ B X' Y) = -(fun X' : ℂ => normAction1_ℂ B Y X') := by
      ext X'; exact h_swap X' Y
    rw [hfun, deriv.neg, h_deriv1_right Y X hY hX]
    simp only [normAction12_ℂ]
    have hmid : (B.ϕ_ℂ Y + B.ϕ_ℂ X) / 2 = (B.ϕ_ℂ X + B.ϕ_ℂ Y) / 2 := by ring
    have hdiff : (B.ϕ_ℂ X - B.ϕ_ℂ Y) / 2 = -((B.ϕ_ℂ Y - B.ϕ_ℂ X) / 2) := by ring
    rw [hmid, hdiff, Complex.sin_neg]
    ring

  have h_real_stat : ∀ x₀ x₁ x₂ : ℝ,
      normAction1_ℂ B (x₁ : ℂ) (x₂ : ℂ) + normAction2_ℂ B (x₀ : ℂ) (x₁ : ℂ) = 0 ↔
        -supportAction1_ℝ B.h (B.ϕ x₁) (B.ϕ x₂) = supportAction2_ℝ B.h (B.ϕ x₀) (B.ϕ x₁) := by
    have hdh_real : ∀ θ : ℝ, deriv B.h_ℂ (θ : ℂ) = ((deriv B.h θ : ℝ) : ℂ) := by
      intro θ
      have hθ_mem : (θ : ℂ) ∈ horizStrip (2 * B.s_h) := real_mem_strip θ (by positivity)
      have hd1 : HasDerivAt (fun t : ℝ => B.h_ℂ (t : ℂ)) (deriv B.h_ℂ (θ : ℂ)) θ :=
        (B.h_ℂ_holo.differentiableAt ((isOpen_strip _).mem_nhds hθ_mem)).hasDerivAt.comp_ofReal
      have hd2 : HasDerivAt (fun t : ℝ => (B.h t : ℂ)) ((deriv B.h θ : ℝ) : ℂ) θ :=
        (B.h_smooth.differentiable (by simp) θ).hasDerivAt.ofReal_comp
      have hfun_eq : (fun t : ℝ => B.h_ℂ (t : ℂ)) = (fun t : ℝ => (B.h t : ℂ)) := by
        ext t; exact B.h_ℂ_real t
      rw [hfun_eq] at hd1
      exact hd1.unique hd2
    have hsa1_real : ∀ θ₁ θ₂ : ℝ,
        supportAction1_ℂ B.h_ℂ (θ₁ : ℂ) (θ₂ : ℂ) = (supportAction1_ℝ B.h θ₁ θ₂ : ℂ) := by
      intro θ₁ θ₂
      simp only [supportAction1_ℂ, supportAction1_ℝ]
      have hm : ((θ₁ : ℂ) + (θ₂ : ℂ)) / 2 = (((θ₁ + θ₂) / 2 : ℝ) : ℂ) := by push_cast; ring
      have hd : ((θ₂ : ℂ) - (θ₁ : ℂ)) / 2 = (((θ₂ - θ₁) / 2 : ℝ) : ℂ) := by push_cast; ring
      rw [hm, hd, hdh_real, B.h_ℂ_real, ← Complex.ofReal_sin, ← Complex.ofReal_cos]
      push_cast; rfl
    have hsa2_real : ∀ θ₁ θ₂ : ℝ,
        supportAction2_ℂ B.h_ℂ (θ₁ : ℂ) (θ₂ : ℂ) = (supportAction2_ℝ B.h θ₁ θ₂ : ℂ) := by
      intro θ₁ θ₂
      simp only [supportAction2_ℂ, supportAction2_ℝ]
      have hm : ((θ₁ : ℂ) + (θ₂ : ℂ)) / 2 = (((θ₁ + θ₂) / 2 : ℝ) : ℂ) := by push_cast; ring
      have hd : ((θ₂ : ℂ) - (θ₁ : ℂ)) / 2 = (((θ₂ - θ₁) / 2 : ℝ) : ℂ) := by push_cast; ring
      rw [hm, hd, hdh_real, B.h_ℂ_real, ← Complex.ofReal_sin, ← Complex.ofReal_cos]
      push_cast; rfl
    intro x₀ x₁ x₂
    have hsum : normAction1_ℂ B (x₁ : ℂ) (x₂ : ℂ) + normAction2_ℂ B (x₀ : ℂ) (x₁ : ℂ) =
        (deriv B.ϕ_ℂ (x₁ : ℂ) / (B.c : ℂ)) *
          (((supportAction1_ℝ B.h (B.ϕ x₁) (B.ϕ x₂) +
            supportAction2_ℝ B.h (B.ϕ x₀) (B.ϕ x₁)) : ℝ) : ℂ) := by
      simp only [normAction1_ℂ, normAction2_ℂ, B.ϕ_ℂ_real, hsa1_real, hsa2_real]
      push_cast; ring
    have hpref_ne : deriv B.ϕ_ℂ (x₁ : ℂ) / (B.c : ℂ) ≠ 0 :=
      div_ne_zero (B.ϕ_ℂ_deriv_ne_zero (x₁ : ℂ) (real_mem_strip x₁ (by positivity))) hc_ne
    rw [hsum, mul_eq_zero, or_iff_right hpref_ne, Complex.ofReal_eq_zero]
    constructor <;> intro h <;> linarith

  
  
  
  let K_rect : ℝ → Set ℂ := fun H =>
    (fun p : ℝ × ℝ => (p.1 : ℂ) + (p.2 : ℂ) * Complex.I) ''
      (Set.Icc (0 : ℝ) (2 * Real.pi) ×ˢ Set.Icc (-H) H)
  have isCompact_K : ∀ H : ℝ, IsCompact (K_rect H) :=
    fun H => (isCompact_Icc.prod isCompact_Icc).image (by fun_prop)
  have nonempty_K : ∀ {H : ℝ}, 0 ≤ H → (K_rect H).Nonempty := by
    intro H hH
    exact ⟨0, ⟨(0, 0), ⟨⟨le_rfl, by positivity⟩, ⟨by linarith, by linarith⟩⟩, by simp⟩⟩
  have K_sub_strip : ∀ {H σ : ℝ}, H < σ → K_rect H ⊆ horizStrip σ := by
    rintro H σ hlt _ ⟨⟨x, y⟩, ⟨_, hy⟩, rfl⟩
    change |(((x : ℂ) + (y : ℂ) * Complex.I).im)| < σ
    simp only [Complex.add_im, Complex.ofReal_im, Complex.mul_im, Complex.ofReal_re,
      Complex.I_re, Complex.I_im, mul_one, mul_zero, add_zero, zero_add]
    exact lt_of_le_of_lt (abs_le.mpr hy) hlt

  have period_reduce : ∀ {H : ℝ} (z : ℂ), 0 ≤ H → |z.im| ≤ H →
      ∃ z₀ ∈ K_rect H, ∃ k : ℤ, z = z₀ + (k : ℂ) * (2 * Real.pi) := by
    intro H z _ hz
    have h2pi : (0 : ℝ) < 2 * Real.pi := by positivity
    let k : ℤ := ⌊z.re / (2 * Real.pi)⌋
    let z₀ : ℂ := z - (k : ℂ) * (2 * Real.pi)
    have hz0_re : z₀.re = z.re - (k : ℝ) * (2 * Real.pi) := by
      simp [z₀]
    have hz0_im : z₀.im = z.im := by
      simp [z₀]
    have hlo : 0 ≤ z₀.re := by
      have h1 : (k : ℝ) ≤ z.re / (2 * Real.pi) := Int.floor_le _
      have h2 : (k : ℝ) * (2 * Real.pi) ≤ z.re := (le_div_iff₀ h2pi).mp h1
      linarith
    have hhi : z₀.re ≤ 2 * Real.pi := by
      have h1 : z.re / (2 * Real.pi) < (k : ℝ) + 1 := Int.lt_floor_add_one _
      have h2 : z.re < ((k : ℝ) + 1) * (2 * Real.pi) := (div_lt_iff₀ h2pi).mp h1
      linarith
    refine ⟨z₀, ⟨(z₀.re, z₀.im), ⟨⟨hlo, hhi⟩, abs_le.mp (hz0_im.symm ▸ hz)⟩,
      Complex.re_add_im z₀⟩, k, by ring⟩

  have int_shift_mem : ∀ {σ : ℝ} {z : ℂ} (k : ℤ),
      z ∈ horizStrip σ → z + (k : ℂ) * (2 * Real.pi) ∈ horizStrip σ := by
    intro σ z k hz
    have hcast : z + (k : ℂ) * (2 * Real.pi) = z + (((k : ℝ) * (2 * Real.pi) : ℝ) : ℂ) := by
      push_cast; rfl
    rw [hcast]
    exact add_real_mem_strip _ hz

  have periodic_int_shift : ∀ {σ : ℝ} {g : ℂ → ℂ},
      (∀ w ∈ horizStrip σ, g (w + 2 * Real.pi) = g w) →
      ∀ z ∈ horizStrip σ, ∀ k : ℤ, g (z + (k : ℂ) * (2 * Real.pi)) = g z := by
    intro σ g hper z hz k
    refine Int.induction_on k (by simp) (fun i hi => ?_) (fun i hi => ?_)
    · have hstep : z + (((i : ℤ) + 1 : ℤ) : ℂ) * (2 * Real.pi) =
          (z + ((i : ℤ) : ℂ) * (2 * Real.pi)) + 2 * Real.pi := by push_cast; ring
      rw [hstep, hper _ (int_shift_mem (i : ℤ) hz), hi]
    · let w' : ℂ := z + (-(i : ℤ) - 1 : ℂ) * (2 * Real.pi)
      have hw'_eq : z + ((-(i : ℤ) - 1 : ℤ) : ℂ) * (2 * Real.pi) = w' := by push_cast; rfl
      have hw'_mem : w' ∈ horizStrip σ := by
        rw [← hw'_eq]; exact int_shift_mem (-(i : ℤ) - 1) hz
      have hstep : w' + 2 * Real.pi = z + (-(i : ℤ) : ℂ) * (2 * Real.pi) := by
        simp only [w']; push_cast; ring
      rw [hw'_eq, ← hper w' hw'_mem, hstep]
      simpa using hi

  have ϕ_im_int_shift : ∀ z ∈ horizStrip (2 * B.s₀), ∀ k : ℤ,
      (B.ϕ_ℂ (z + (k : ℂ) * (2 * Real.pi))).im = (B.ϕ_ℂ z).im := by
    intro z hz k
    have hqp : ∀ k' : ℤ, B.ϕ_ℂ (z + (k' : ℂ) * (2 * Real.pi)) =
        B.ϕ_ℂ z + (k' : ℂ) * (2 * Real.pi) := by
      intro k'
      refine Int.induction_on k' (by simp) (fun i hi => ?_) (fun i hi => ?_)
      · have hstep : z + (((i : ℤ) + 1 : ℤ) : ℂ) * (2 * Real.pi) =
            (z + ((i : ℤ) : ℂ) * (2 * Real.pi)) + 2 * Real.pi := by push_cast; ring
        rw [hstep, B.ϕ_ℂ_quasiperiodic _ (int_shift_mem (i : ℤ) hz), hi]
        push_cast; ring
      · let w' : ℂ := z + (-(i : ℤ) - 1 : ℂ) * (2 * Real.pi)
        have hw'_eq : z + ((-(i : ℤ) - 1 : ℤ) : ℂ) * (2 * Real.pi) = w' := by push_cast; rfl
        have hw'_mem : w' ∈ horizStrip (2 * B.s₀) := by
          rw [← hw'_eq]; exact int_shift_mem (-(i : ℤ) - 1) hz
        have hstep : w' + 2 * Real.pi = z + (-(i : ℤ) : ℂ) * (2 * Real.pi) := by
          simp only [w']; push_cast; ring
        have h1 := B.ϕ_ℂ_quasiperiodic w' hw'_mem
        rw [hstep] at h1
        have h2 : B.ϕ_ℂ (z + (-(i : ℤ) : ℂ) * (2 * Real.pi)) =
            B.ϕ_ℂ z + (-(i : ℤ) : ℂ) * (2 * Real.pi) := by
          simpa using hi
        rw [hw'_eq]
        have hGoal : B.ϕ_ℂ w' = B.ϕ_ℂ z + (-(i : ℤ) - 1 : ℂ) * (2 * Real.pi) := by
          linear_combination -h1 + h2
        rw [hGoal]
        push_cast; ring
    rw [hqp k]
    simp

  have exists_strip_bound : ∀ (σ H : ℝ) (g : ℂ → ℂ),
      0 ≤ H → H < σ → DifferentiableOn ℂ g (horizStrip σ) →
      (∀ w ∈ horizStrip σ, g (w + 2 * Real.pi) = g w) →
      ∃ M : ℝ, 1 ≤ M ∧ ∀ z : ℂ, |z.im| ≤ H → ‖g z‖ ≤ M := by
    intro σ H g hH0 hHσ hg_holo hg_per
    have hg_cont : ContinuousOn (fun z : ℂ => ‖g z‖) (K_rect H) :=
      continuous_norm.comp_continuousOn (hg_holo.continuousOn.mono (K_sub_strip hHσ))
    obtain ⟨z_m, _, hz_max⟩ := (isCompact_K H).exists_isMaxOn (nonempty_K hH0) hg_cont
    refine ⟨max 1 ‖g z_m‖, le_max_left _ _, fun z hz => ?_⟩
    obtain ⟨z₀, hz₀_K, k, rfl⟩ := period_reduce z hH0 hz
    rw [periodic_int_shift hg_per z₀ (K_sub_strip hHσ hz₀_K) k]
    exact le_trans (hz_max hz₀_K) (le_max_right _ _)

  
  have hH3_nonneg : (0 : ℝ) ≤ 3 * B.s₀ / 2 := by positivity
  have hH3_lt : 3 * B.s₀ / 2 < 2 * B.s₀ := by linarith
  have hϕ_im_cont : ContinuousOn (fun z : ℂ => |(B.ϕ_ℂ z).im|) (K_rect (3 * B.s₀ / 2)) :=
    Complex.continuous_im.abs.comp_continuousOn (B.ϕ_ℂ_holo.continuousOn.mono (K_sub_strip hH3_lt))
  obtain ⟨z_ϕmax, hz_ϕmax_K, hz_ϕmax⟩ :=
    (isCompact_K (3 * B.s₀ / 2)).exists_isMaxOn (nonempty_K hH3_nonneg) hϕ_im_cont
  let H_ϕ : ℝ := |(B.ϕ_ℂ z_ϕmax).im|
  have hH_ϕ_nonneg : 0 ≤ H_ϕ := abs_nonneg _
  have hH_ϕ_lt : H_ϕ < 2 * B.s_h :=
    B.ϕ_ℂ_maps_to z_ϕmax (K_sub_strip hH3_lt hz_ϕmax_K)
  have hϕ_im_le : ∀ z : ℂ, |z.im| ≤ 3 * B.s₀ / 2 → |(B.ϕ_ℂ z).im| ≤ H_ϕ := by
    intro z hz
    obtain ⟨z₀, hz₀_K, k, rfl⟩ := period_reduce z hH3_nonneg hz
    rw [ϕ_im_int_shift z₀ (K_sub_strip hH3_lt hz₀_K) k]
    exact hz_ϕmax hz₀_K

  let H_h : ℝ := (H_ϕ + 2 * B.s_h) / 2
  have hH_h_pos : 0 < H_h := by simp only [H_h]; linarith
  have hH_ϕ_lt_Hh : H_ϕ < H_h := by simp only [H_h]; linarith
  have hH_h_lt : H_h < 2 * B.s_h := by simp only [H_h]; linarith
  have hHh_sub : horizStrip H_h ⊆ horizStrip (2 * B.s_h) := strip_mono hH_h_lt.le
  have hϕ_maps_Hh : ∀ z : ℂ, |z.im| ≤ 3 * B.s₀ / 2 → B.ϕ_ℂ z ∈ horizStrip H_h :=
    fun z hz => lt_of_le_of_lt (hϕ_im_le z hz) hH_ϕ_lt_Hh

  obtain ⟨M_ϕ1, hM_ϕ1_ge1, hM_ϕ1⟩ :=
    exists_strip_bound (2 * B.s₀) (3 * B.s₀ / 2) (deriv B.ϕ_ℂ) hH3_nonneg hH3_lt hdϕ_holo hdϕ_per
  obtain ⟨M_ϕ2, hM_ϕ2_ge1, hM_ϕ2⟩ :=
    exists_strip_bound (2 * B.s₀) (3 * B.s₀ / 2) (deriv (deriv B.ϕ_ℂ)) hH3_nonneg hH3_lt hddϕ_holo hddϕ_per
  obtain ⟨M_h0, hM_h0_ge1, hM_h0⟩ :=
    exists_strip_bound (2 * B.s_h) H_h B.h_ℂ hH_h_pos.le hH_h_lt B.h_ℂ_holo B.h_ℂ_periodic
  obtain ⟨M_h1, hM_h1_ge1, hM_h1⟩ :=
    exists_strip_bound (2 * B.s_h) H_h (deriv B.h_ℂ) hH_h_pos.le hH_h_lt hdh_holo hdh_per
  obtain ⟨M_r0, hM_r0_ge1, hM_r0⟩ :=
    exists_strip_bound (2 * B.s_h) H_h (r_ℂ B) hH_h_pos.le hH_h_lt hr_holo hr_per
  obtain ⟨M_r1, hM_r1_ge1, hM_r1⟩ :=
    exists_strip_bound (2 * B.s_h) H_h (deriv (r_ℂ B)) hH_h_pos.le hH_h_lt hdr_holo hdr_per

  
  have hϕ_lip : ∀ z₁ ∈ horizStrip (3 * B.s₀ / 2), ∀ z₂ ∈ horizStrip (3 * B.s₀ / 2),
      ‖B.ϕ_ℂ z₁ - B.ϕ_ℂ z₂‖ ≤ M_ϕ1 * ‖z₁ - z₂‖ := by
    intro z₁ hz₁ z₂ hz₂
    exact Convex.norm_image_sub_le_of_norm_deriv_le
      (fun z hz => B.ϕ_ℂ_holo.differentiableAt ((isOpen_strip _).mem_nhds (hS3_sub hz)))
      (fun z hz => hM_ϕ1 z (le_of_lt hz)) (convex_strip _) hz₂ hz₁
  have hdϕ_lip : ∀ z₁ ∈ horizStrip (3 * B.s₀ / 2), ∀ z₂ ∈ horizStrip (3 * B.s₀ / 2),
      ‖deriv B.ϕ_ℂ z₁ - deriv B.ϕ_ℂ z₂‖ ≤ M_ϕ2 * ‖z₁ - z₂‖ := by
    intro z₁ hz₁ z₂ hz₂
    exact Convex.norm_image_sub_le_of_norm_deriv_le
      (fun z hz => hdϕ_holo.differentiableAt ((isOpen_strip _).mem_nhds (hS3_sub hz)))
      (fun z hz => hM_ϕ2 z (le_of_lt hz)) (convex_strip _) hz₂ hz₁
  have hr_lip : ∀ w₁ ∈ horizStrip H_h, ∀ w₂ ∈ horizStrip H_h,
      ‖r_ℂ B w₁ - r_ℂ B w₂‖ ≤ M_r1 * ‖w₁ - w₂‖ := by
    intro w₁ hw₁ w₂ hw₂
    exact Convex.norm_image_sub_le_of_norm_deriv_le
      (fun w hw => hr_holo.differentiableAt ((isOpen_strip _).mem_nhds (hHh_sub hw)))
      (fun w hw => hM_r1 w (le_of_lt hw)) (convex_strip _) hw₂ hw₁

  
  have h_trig_bound : ∀ Δ : ℂ,
      ‖Complex.sin Δ‖ ≤ Real.exp |Δ.im| ∧ ‖Complex.cos Δ‖ ≤ Real.exp |Δ.im| := by
    intro Δ
    have hexp1 : ‖Complex.exp (Δ * Complex.I)‖ ≤ Real.exp |Δ.im| := by
      rw [Complex.norm_exp]
      have hre : (Δ * Complex.I).re = -Δ.im := by simp
      rw [hre]; exact Real.exp_le_exp.mpr (neg_le_abs _)
    have hexp2 : ‖Complex.exp (-Δ * Complex.I)‖ ≤ Real.exp |Δ.im| := by
      rw [Complex.norm_exp]
      have hre : (-Δ * Complex.I).re = Δ.im := by simp
      rw [hre]; exact Real.exp_le_exp.mpr (le_abs_self _)
    constructor
    · rw [Complex.sin]
      calc ‖(Complex.exp (-Δ * Complex.I) - Complex.exp (Δ * Complex.I)) * Complex.I / 2‖
          = ‖Complex.exp (-Δ * Complex.I) - Complex.exp (Δ * Complex.I)‖ * ‖Complex.I‖ / ‖(2 : ℂ)‖ := by
            rw [norm_div, norm_mul]
        _ = ‖Complex.exp (-Δ * Complex.I) - Complex.exp (Δ * Complex.I)‖ / 2 := by
            simp [Complex.norm_I]
        _ ≤ (‖Complex.exp (-Δ * Complex.I)‖ + ‖Complex.exp (Δ * Complex.I)‖) / 2 := by
            gcongr; exact norm_sub_le _ _
        _ ≤ Real.exp |Δ.im| := by linarith
    · rw [Complex.cos]
      calc ‖(Complex.exp (Δ * Complex.I) + Complex.exp (-Δ * Complex.I)) / 2‖
          = ‖Complex.exp (Δ * Complex.I) + Complex.exp (-Δ * Complex.I)‖ / ‖(2 : ℂ)‖ := norm_div _ _
        _ = ‖Complex.exp (Δ * Complex.I) + Complex.exp (-Δ * Complex.I)‖ / 2 := by simp
        _ ≤ (‖Complex.exp (Δ * Complex.I)‖ + ‖Complex.exp (-Δ * Complex.I)‖) / 2 := by
            gcongr; exact norm_add_le _ _
        _ ≤ Real.exp |Δ.im| := by linarith

  let M_act : ℝ := max (M_ϕ1 + 1)
    (max M_ϕ2
      (max ((M_ϕ1 / B.c) * ((M_h1 + M_h0) * Real.exp H_ϕ + M_h0))
        ((M_ϕ1 ^ 2 / (2 * B.c)) * M_r0 * Real.exp H_ϕ)))
  have hM_act_pos : 0 < M_act :=
    lt_of_lt_of_le (by linarith : 0 < M_ϕ1 + 1) (le_max_left _ _)

  have h_wide_bound_1 : ∀ X Y : ℂ,
      X ∈ horizStrip (3 * B.s₀ / 2) → Y ∈ horizStrip (3 * B.s₀ / 2) →
      ‖normAction1_ℂ B X Y‖ ≤ M_act := by
    intro X Y hX hY
    have hX_im : |(B.ϕ_ℂ X).im| ≤ H_ϕ := hϕ_im_le X (le_of_lt hX)
    have hY_im : |(B.ϕ_ℂ Y).im| ≤ H_ϕ := hϕ_im_le Y (le_of_lt hY)
    have hmid_im : |((B.ϕ_ℂ X + B.ϕ_ℂ Y) / 2).im| ≤ H_h := by
      have him : ((B.ϕ_ℂ X + B.ϕ_ℂ Y) / 2).im = ((B.ϕ_ℂ X).im + (B.ϕ_ℂ Y).im) / 2 := by
        simp [add_div]
      rw [him, abs_div, abs_of_pos (by norm_num : (0 : ℝ) < 2)]
      linarith [abs_add_le (B.ϕ_ℂ X).im (B.ϕ_ℂ Y).im]
    have hdiff_im : |((B.ϕ_ℂ Y - B.ϕ_ℂ X) / 2).im| ≤ H_ϕ := by
      have him : ((B.ϕ_ℂ Y - B.ϕ_ℂ X) / 2).im = ((B.ϕ_ℂ Y).im - (B.ϕ_ℂ X).im) / 2 := by
        simp [sub_div]
      rw [him, abs_div, abs_of_pos (by norm_num : (0 : ℝ) < 2)]
      linarith [abs_sub (B.ϕ_ℂ Y).im (B.ϕ_ℂ X).im]
    have hsin : ‖Complex.sin ((B.ϕ_ℂ Y - B.ϕ_ℂ X) / 2)‖ ≤ Real.exp H_ϕ :=
      le_trans (h_trig_bound _).1 (Real.exp_le_exp.mpr hdiff_im)
    have hcos : ‖Complex.cos ((B.ϕ_ℂ Y - B.ϕ_ℂ X) / 2)‖ ≤ Real.exp H_ϕ :=
      le_trans (h_trig_bound _).2 (Real.exp_le_exp.mpr hdiff_im)
    have hsa1 : ‖supportAction1_ℂ B.h_ℂ (B.ϕ_ℂ X) (B.ϕ_ℂ Y) + B.h_ℂ (B.ϕ_ℂ X)‖ ≤
        (M_h1 + M_h0) * Real.exp H_ϕ + M_h0 := by
      simp only [supportAction1_ℂ]
      calc ‖deriv B.h_ℂ ((B.ϕ_ℂ X + B.ϕ_ℂ Y) / 2) * Complex.sin ((B.ϕ_ℂ Y - B.ϕ_ℂ X) / 2) -
              B.h_ℂ ((B.ϕ_ℂ X + B.ϕ_ℂ Y) / 2) * Complex.cos ((B.ϕ_ℂ Y - B.ϕ_ℂ X) / 2) +
              B.h_ℂ (B.ϕ_ℂ X)‖
          ≤ ‖deriv B.h_ℂ ((B.ϕ_ℂ X + B.ϕ_ℂ Y) / 2) * Complex.sin ((B.ϕ_ℂ Y - B.ϕ_ℂ X) / 2) -
              B.h_ℂ ((B.ϕ_ℂ X + B.ϕ_ℂ Y) / 2) * Complex.cos ((B.ϕ_ℂ Y - B.ϕ_ℂ X) / 2)‖ +
            ‖B.h_ℂ (B.ϕ_ℂ X)‖ := norm_add_le _ _
        _ ≤ ‖deriv B.h_ℂ ((B.ϕ_ℂ X + B.ϕ_ℂ Y) / 2)‖ * ‖Complex.sin ((B.ϕ_ℂ Y - B.ϕ_ℂ X) / 2)‖ +
            ‖B.h_ℂ ((B.ϕ_ℂ X + B.ϕ_ℂ Y) / 2)‖ * ‖Complex.cos ((B.ϕ_ℂ Y - B.ϕ_ℂ X) / 2)‖ +
            ‖B.h_ℂ (B.ϕ_ℂ X)‖ := by
              gcongr
              exact le_trans (norm_sub_le _ _) (by rw [norm_mul, norm_mul])
        _ ≤ M_h1 * Real.exp H_ϕ + M_h0 * Real.exp H_ϕ + M_h0 := by
            gcongr
            · exact hM_h1 _ hmid_im
            · exact hM_h0 _ hmid_im
            · exact hM_h0 _ (le_trans hX_im hH_ϕ_lt_Hh.le)
        _ = (M_h1 + M_h0) * Real.exp H_ϕ + M_h0 := by ring
    have h1 : ‖normAction1_ℂ B X Y‖ ≤
        (M_ϕ1 / B.c) * ((M_h1 + M_h0) * Real.exp H_ϕ + M_h0) := by
      simp only [normAction1_ℂ, norm_mul, norm_div, norm_c]
      gcongr
      exact hM_ϕ1 X (le_of_lt hX)
    exact le_trans h1 (le_trans (le_max_left _ _) (le_trans (le_max_right _ _) (le_max_right _ _)))

  have h_wide_bound_12 : ∀ X Y : ℂ,
      X ∈ horizStrip (3 * B.s₀ / 2) → Y ∈ horizStrip (3 * B.s₀ / 2) →
      ‖normAction12_ℂ B X Y‖ ≤ M_act := by
    intro X Y hX hY
    have hX_im : |(B.ϕ_ℂ X).im| ≤ H_ϕ := hϕ_im_le X (le_of_lt hX)
    have hY_im : |(B.ϕ_ℂ Y).im| ≤ H_ϕ := hϕ_im_le Y (le_of_lt hY)
    have hmid_im : |((B.ϕ_ℂ X + B.ϕ_ℂ Y) / 2).im| ≤ H_h := by
      have him : ((B.ϕ_ℂ X + B.ϕ_ℂ Y) / 2).im = ((B.ϕ_ℂ X).im + (B.ϕ_ℂ Y).im) / 2 := by
        simp [add_div]
      rw [him, abs_div, abs_of_pos (by norm_num : (0 : ℝ) < 2)]
      linarith [abs_add_le (B.ϕ_ℂ X).im (B.ϕ_ℂ Y).im]
    have hdiff_im : |((B.ϕ_ℂ Y - B.ϕ_ℂ X) / 2).im| ≤ H_ϕ := by
      have him : ((B.ϕ_ℂ Y - B.ϕ_ℂ X) / 2).im = ((B.ϕ_ℂ Y).im - (B.ϕ_ℂ X).im) / 2 := by
        simp [sub_div]
      rw [him, abs_div, abs_of_pos (by norm_num : (0 : ℝ) < 2)]
      linarith [abs_sub (B.ϕ_ℂ Y).im (B.ϕ_ℂ X).im]
    have hsin : ‖Complex.sin ((B.ϕ_ℂ Y - B.ϕ_ℂ X) / 2)‖ ≤ Real.exp H_ϕ :=
      le_trans (h_trig_bound _).1 (Real.exp_le_exp.mpr hdiff_im)
    have h12 : ‖normAction12_ℂ B X Y‖ ≤
        (M_ϕ1 ^ 2 / (2 * B.c)) * M_r0 * Real.exp H_ϕ := by
      simp only [normAction12_ℂ, norm_mul, norm_div, norm_c]
      have h2norm : ‖(2 : ℂ)‖ = 2 := by simp
      rw [h2norm]
      have hdX := hM_ϕ1 X (le_of_lt hX)
      have hdY := hM_ϕ1 Y (le_of_lt hY)
      have hprod : ‖deriv B.ϕ_ℂ X‖ * ‖deriv B.ϕ_ℂ Y‖ ≤ M_ϕ1 ^ 2 := by
        rw [sq]; gcongr
      have hdiv : ‖deriv B.ϕ_ℂ X‖ * ‖deriv B.ϕ_ℂ Y‖ / (2 * B.c) ≤ M_ϕ1 ^ 2 / (2 * B.c) := by
        gcongr
      gcongr
      exact hM_r0 _ hmid_im
    exact le_trans h12 (le_trans (le_max_right _ _) (le_trans (le_max_right _ _) (le_max_right _ _)))

  have h_act_bound : ∀ X Y : ℂ,
      X ∈ horizStrip (5 * B.s₀ / 4) → Y ∈ horizStrip (5 * B.s₀ / 4) →
      ‖normAction1_ℂ B X Y‖ ≤ M_act ∧
      ‖normAction2_ℂ B X Y‖ ≤ M_act ∧
      ‖normAction12_ℂ B X Y‖ ≤ M_act := by
    intro X Y hX hY
    have hX3 := hS54_sub hX
    have hY3 := hS54_sub hY
    refine ⟨h_wide_bound_1 X Y hX3 hY3, ?_, h_wide_bound_12 X Y hX3 hY3⟩
    rw [h_swap, norm_neg]
    exact h_wide_bound_1 Y X hY3 hX3

  have h_ϕ_lip_54 :
      (∀ z ∈ horizStrip (5 * B.s₀ / 4), ‖deriv B.ϕ_ℂ z‖ ≤ M_act) ∧
      (∀ z₁ ∈ horizStrip (5 * B.s₀ / 4), ∀ z₂ ∈ horizStrip (5 * B.s₀ / 4),
        ‖deriv B.ϕ_ℂ z₁ - deriv B.ϕ_ℂ z₂‖ ≤ M_act * ‖z₁ - z₂‖) := by
    refine ⟨fun z hz => ?_, fun z₁ hz₁ z₂ hz₂ => ?_⟩
    · exact le_trans (hM_ϕ1 z (le_of_lt (hS54_sub hz)))
        (le_trans (by linarith : M_ϕ1 ≤ M_ϕ1 + 1) (le_max_left _ _))
    · have hM2_le : M_ϕ2 ≤ M_act := le_trans (le_max_left _ _) (le_max_right _ _)
      exact le_trans (hdϕ_lip z₁ (hS54_sub hz₁) z₂ (hS54_sub hz₂))
        (mul_le_mul_of_nonneg_right hM2_le (norm_nonneg _))

  let K_lin : ℝ :=
    (M_ϕ1 * M_ϕ2 * M_r0 * (M_ϕ1 + 1) + M_ϕ1 ^ 3 * M_r1 * (M_ϕ1 + 1) + M_ϕ1 ^ 2 * M_r0) / B.c
  have hK_lin_pos : 0 < K_lin := by
    have hnum : 0 < M_ϕ1 * M_ϕ2 * M_r0 * (M_ϕ1 + 1) +
        M_ϕ1 ^ 3 * M_r1 * (M_ϕ1 + 1) + M_ϕ1 ^ 2 * M_r0 := by positivity
    exact div_pos hnum B.c_pos

  let δ_lin : ℝ :=
    min (min (B.s₀ / 8) (1 / 2)) (min (Real.pi / (2 * M_ϕ1)) (1 / (16 * K_lin)))
  have hδ_lin_pos : 0 < δ_lin := by
    simp only [δ_lin, lt_min_iff]
    refine ⟨⟨by positivity [B.s₀_pos], by norm_num⟩, ⟨?_, ?_⟩⟩
    · exact div_pos Real.pi_pos (by positivity)
    · exact div_pos one_pos (by positivity)
  have hδ_le_eighth : δ_lin ≤ B.s₀ / 8 := le_trans (min_le_left _ _) (min_le_left _ _)
  have hδ_le_half : δ_lin ≤ 1 / 2 := le_trans (min_le_left _ _) (min_le_right _ _)
  have hδ_le_pi : δ_lin ≤ Real.pi / (2 * M_ϕ1) := le_trans (min_le_right _ _) (min_le_left _ _)
  have hδ_le_klin : δ_lin ≤ 1 / (16 * K_lin) := le_trans (min_le_right _ _) (min_le_right _ _)

  have h_real_step : ∀ x₀ x₁ : ℝ,
      0 < x₁ - x₀ → x₁ - x₀ ≤ δ_lin →
      0 < B.ϕ x₁ - B.ϕ x₀ ∧ B.ϕ x₁ - B.ϕ x₀ < Real.pi := by
    intro x₀ x₁ hpos hle
    have hmono : StrictMono B.ϕ := strictMono_of_deriv_pos B.ϕ_deriv_pos
    have hdiff_pos : 0 < B.ϕ x₁ - B.ϕ x₀ := sub_pos.mpr (hmono (sub_pos.mp hpos))
    refine ⟨hdiff_pos, ?_⟩
    have hx0 : (x₀ : ℂ) ∈ horizStrip (3 * B.s₀ / 2) := real_mem_strip x₀ (by positivity [B.s₀_pos])
    have hx1 : (x₁ : ℂ) ∈ horizStrip (3 * B.s₀ / 2) := real_mem_strip x₁ (by positivity [B.s₀_pos])
    have hlip := hϕ_lip (x₁ : ℂ) hx1 (x₀ : ℂ) hx0
    rw [B.ϕ_ℂ_real, B.ϕ_ℂ_real, ← Complex.ofReal_sub, Complex.norm_real, Real.norm_eq_abs,
      abs_of_pos hdiff_pos, ← Complex.ofReal_sub, Complex.norm_real, Real.norm_eq_abs,
      abs_of_pos hpos] at hlip
    have h2M : (0 : ℝ) < 2 * M_ϕ1 := by positivity
    have hstep1 : M_ϕ1 * (x₁ - x₀) ≤ M_ϕ1 * (Real.pi / (2 * M_ϕ1)) :=
      mul_le_mul_of_nonneg_left (le_trans hle hδ_le_pi) (by positivity)
    have hstep2 : M_ϕ1 * (Real.pi / (2 * M_ϕ1)) = Real.pi / 2 := by
      field_simp
    linarith [Real.pi_pos]

  have h_lin_close : ∀ X_m X_p W : ℂ,
      X_m ∈ horizStrip B.s₀ →
      ‖X_p - X_m‖ ≤ δ_lin →
      ‖2 * W - deriv B.ϕ_ℂ X_m‖ ≤ δ_lin →
      ‖W‖ ≤ M_act ∧
      ‖4 * ((deriv B.ϕ_ℂ X_m * deriv B.ϕ_ℂ X_p / (2 * (B.c : ℂ))) *
        r_ℂ B ((B.ϕ_ℂ X_m + B.ϕ_ℂ X_p) / 2) * W) - 1‖ ≤ 1 / 16 := by
    intro X_m X_p W hXm hXp_dist hW_dist
    have hXm_3 : X_m ∈ horizStrip (3 * B.s₀ / 2) := hS1_sub hXm
    have hXp_3 : X_p ∈ horizStrip (3 * B.s₀ / 2) := by
      change |X_m.im| < B.s₀ at hXm
      change |X_p.im| < 3 * B.s₀ / 2
      have him_eq : X_p.im = X_m.im + (X_p - X_m).im := by simp
      have him_le : |(X_p - X_m).im| ≤ ‖X_p - X_m‖ := Complex.abs_im_le_norm _
      rw [him_eq]
      linarith [abs_add_le X_m.im (X_p - X_m).im, hXp_dist, hδ_le_eighth, hs0_pos]
    let a_m := deriv B.ϕ_ℂ X_m
    let a_p := deriv B.ϕ_ℂ X_p
    let ψ := (B.ϕ_ℂ X_m + B.ϕ_ℂ X_p) / 2
    let r_m := r_ℂ B (B.ϕ_ℂ X_m)
    let r_ψ := r_ℂ B ψ
    let w₂ := 2 * W
    have ha_m : ‖a_m‖ ≤ M_ϕ1 := hM_ϕ1 X_m (le_of_lt hXm_3)
    have hw2 : ‖w₂‖ ≤ M_ϕ1 + 1 := by
      have h1 : ‖w₂‖ ≤ ‖a_m‖ + ‖w₂ - a_m‖ := by
        simpa [sub_add_cancel] using norm_add_le a_m (w₂ - a_m)
      linarith [hW_dist, hδ_le_half]
    have hW_bound : ‖W‖ ≤ M_act := by
      have h2W : 2 * ‖W‖ = ‖w₂‖ := by simp [w₂]
      have hW1 : ‖W‖ ≤ M_ϕ1 + 1 := by linarith [norm_nonneg W]
      exact le_trans hW1 (le_max_left _ _)
    refine ⟨hW_bound, ?_⟩
    have hϕm_Hh : B.ϕ_ℂ X_m ∈ horizStrip H_h := hϕ_maps_Hh X_m (le_of_lt hXm_3)
    have hϕp_Hh : B.ϕ_ℂ X_p ∈ horizStrip H_h := hϕ_maps_Hh X_p (le_of_lt hXp_3)
    have hψ_Hh : ψ ∈ horizStrip H_h := mid_mem_strip hϕm_Hh hϕp_Hh
    have hr_m : ‖r_m‖ ≤ M_r0 := hM_r0 _ (le_of_lt hϕm_Hh)
    have hr_ψ : ‖r_ψ‖ ≤ M_r0 := hM_r0 _ (le_of_lt hψ_Hh)
    have hap_diff : ‖a_p - a_m‖ ≤ M_ϕ2 * δ_lin :=
      le_trans (hdϕ_lip X_p hXp_3 X_m hXm_3) (mul_le_mul_of_nonneg_left hXp_dist (by positivity))
    have hψ_diff : ‖ψ - B.ϕ_ℂ X_m‖ ≤ M_ϕ1 * δ_lin := by
      have heq : ψ - B.ϕ_ℂ X_m = (B.ϕ_ℂ X_p - B.ϕ_ℂ X_m) / 2 := by simp only [ψ]; ring
      rw [heq, norm_div, show ‖(2 : ℂ)‖ = 2 by simp]
      have h1 : ‖B.ϕ_ℂ X_p - B.ϕ_ℂ X_m‖ ≤ M_ϕ1 * δ_lin :=
        le_trans (hϕ_lip X_p hXp_3 X_m hXm_3) (mul_le_mul_of_nonneg_left hXp_dist (by positivity))
      linarith [norm_nonneg (B.ϕ_ℂ X_p - B.ϕ_ℂ X_m)]
    have hr_diff : ‖r_ψ - r_m‖ ≤ M_r1 * (M_ϕ1 * δ_lin) :=
      le_trans (hr_lip ψ hψ_Hh (B.ϕ_ℂ X_m) hϕm_Hh) (mul_le_mul_of_nonneg_left hψ_diff (by positivity))
    have h_laz : r_m * a_m ^ 3 = (B.c : ℂ) := B.lazutkin_norm_ℂ X_m (hS3_sub hXm_3)
    have h_tele : 4 * ((a_m * a_p / (2 * (B.c : ℂ))) * r_ψ * W) - 1 =
        (a_m * (a_p - a_m) * r_ψ * w₂ + a_m ^ 2 * (r_ψ - r_m) * w₂ + a_m ^ 2 * r_m * (w₂ - a_m)) /
          (B.c : ℂ) := by
      have h4 : 4 * ((a_m * a_p / (2 * (B.c : ℂ))) * r_ψ * W) = (a_m * a_p * r_ψ * w₂) / (B.c : ℂ) := by
        simp only [w₂]; field_simp [hc_ne]; ring
      rw [h4, div_sub_one hc_ne, ← h_laz]
      ring
    rw [h_tele, norm_div, norm_c]
    have ht1 : ‖a_m * (a_p - a_m) * r_ψ * w₂‖ ≤ M_ϕ1 * M_ϕ2 * M_r0 * (M_ϕ1 + 1) * δ_lin := by
      rw [norm_mul, norm_mul, norm_mul]
      calc ‖a_m‖ * ‖a_p - a_m‖ * ‖r_ψ‖ * ‖w₂‖
          ≤ M_ϕ1 * (M_ϕ2 * δ_lin) * M_r0 * (M_ϕ1 + 1) := by gcongr
        _ = M_ϕ1 * M_ϕ2 * M_r0 * (M_ϕ1 + 1) * δ_lin := by ring
    have ht2 : ‖a_m ^ 2 * (r_ψ - r_m) * w₂‖ ≤ M_ϕ1 ^ 3 * M_r1 * (M_ϕ1 + 1) * δ_lin := by
      rw [norm_mul, norm_mul, norm_pow]
      calc ‖a_m‖ ^ 2 * ‖r_ψ - r_m‖ * ‖w₂‖
          ≤ M_ϕ1 ^ 2 * (M_r1 * (M_ϕ1 * δ_lin)) * (M_ϕ1 + 1) := by gcongr
        _ = M_ϕ1 ^ 3 * M_r1 * (M_ϕ1 + 1) * δ_lin := by ring
    have ht3 : ‖a_m ^ 2 * r_m * (w₂ - a_m)‖ ≤ M_ϕ1 ^ 2 * M_r0 * δ_lin := by
      rw [norm_mul, norm_mul, norm_pow]
      gcongr
    have hnum_le : ‖a_m * (a_p - a_m) * r_ψ * w₂ + a_m ^ 2 * (r_ψ - r_m) * w₂ +
        a_m ^ 2 * r_m * (w₂ - a_m)‖ ≤
        (M_ϕ1 * M_ϕ2 * M_r0 * (M_ϕ1 + 1) + M_ϕ1 ^ 3 * M_r1 * (M_ϕ1 + 1) + M_ϕ1 ^ 2 * M_r0) * δ_lin := by
      have htri : ‖a_m * (a_p - a_m) * r_ψ * w₂ + a_m ^ 2 * (r_ψ - r_m) * w₂ +
          a_m ^ 2 * r_m * (w₂ - a_m)‖ ≤
          ‖a_m * (a_p - a_m) * r_ψ * w₂‖ + ‖a_m ^ 2 * (r_ψ - r_m) * w₂‖ +
            ‖a_m ^ 2 * r_m * (w₂ - a_m)‖ :=
        le_trans (norm_add_le _ _) (add_le_add (norm_add_le _ _) le_rfl)
      linarith
    have hdiv_le : ‖a_m * (a_p - a_m) * r_ψ * w₂ + a_m ^ 2 * (r_ψ - r_m) * w₂ +
        a_m ^ 2 * r_m * (w₂ - a_m)‖ / B.c ≤ K_lin * δ_lin := by
      have h1 := div_le_div_of_nonneg_right hnum_le hc_pos.le
      have h2 : (M_ϕ1 * M_ϕ2 * M_r0 * (M_ϕ1 + 1) + M_ϕ1 ^ 3 * M_r1 * (M_ϕ1 + 1) + M_ϕ1 ^ 2 * M_r0) *
          δ_lin / B.c = K_lin * δ_lin := by simp only [K_lin]; ring
      rwa [h2] at h1
    have hklin_le : K_lin * δ_lin ≤ 1 / 16 := by
      have h1 := mul_le_mul_of_nonneg_left hδ_le_klin hK_lin_pos.le
      have h2 : K_lin * (1 / (16 * K_lin)) = 1 / 16 := by field_simp [hK_lin_pos.ne']
      linarith
    exact le_trans hdiv_le hklin_le

  
  
  
  have diffOn_iter : ∀ {U : Set ℂ}, IsOpen U → ∀ {g : ℂ → ℂ},
      DifferentiableOn ℂ g U → ∀ n : ℕ, DifferentiableOn ℂ (iteratedDeriv n g) U := by
    intro U hU g hg n
    induction n with
    | zero => simpa [iteratedDeriv_zero] using hg
    | succ k ih => rw [iteratedDeriv_succ]; exact ih.deriv hU

  let M_rem : ℝ := 4 * M_act / (B.s₀ / 8) ^ 4
  have hM_rem_pos : 0 < M_rem := by positivity

  
  let W_rem : Set (ℂ × ℂ) := horizStrip B.s₀ ×ˢ Metric.ball (0 : ℂ) (B.s₀ / 4)
  have isOpen_Wrem : IsOpen W_rem := (isOpen_strip B.s₀).prod Metric.isOpen_ball

  have h_rem_holo : DifferentiableOn ℂ (fun q : ℂ × ℂ => normActionRem_ℂ B q.1 q.2) W_rem := by
    let g₀ : ℂ × ℂ → ℂ := fun p => normAction1_ℂ B p.1 p.2
    let g₁ : ℂ × ℂ → ℂ := fun p => deriv (fun Y' => g₀ (p.1, Y')) p.2
    let g₂ : ℂ × ℂ → ℂ := fun p => deriv (fun Y' => g₁ (p.1, Y')) p.2
    let g₃ : ℂ × ℂ → ℂ := fun p => deriv (fun Y' => g₂ (p.1, Y')) p.2
    let g₄ : ℂ × ℂ → ℂ := fun p => deriv (fun Y' => g₃ (p.1, Y')) p.2
    have hg1 : DifferentiableOn ℂ g₁ W₃ := hCalc.partial_t_holo W₃ g₀ isOpen_W3 h_act1_holo
    have hg2 : DifferentiableOn ℂ g₂ W₃ := hCalc.partial_t_holo W₃ g₁ isOpen_W3 hg1
    have hg3 : DifferentiableOn ℂ g₃ W₃ := hCalc.partial_t_holo W₃ g₂ isOpen_W3 hg2
    have hg4 : DifferentiableOn ℂ g₄ W₃ := hCalc.partial_t_holo W₃ g₃ isOpen_W3 hg3
    have hg4_eq : ∀ X z : ℂ,
        iteratedDeriv 4 (fun b' : ℂ => normAction1_ℂ B X (X + b')) z = g₄ (X, X + z) := by
      intro X z
      have hcomp := congr_fun (iteratedDeriv_comp_const_add 4 (normAction1_ℂ B X) X) z
      rw [hcomp]
      have h0 : (fun Y' => g₀ (X, Y')) = iteratedDeriv 0 (normAction1_ℂ B X) := by
        ext Y'; simp [g₀]
      have h1 : (fun Y' => g₁ (X, Y')) = iteratedDeriv 1 (normAction1_ℂ B X) := by
        ext Y'; simp only [g₁, h0, ← iteratedDeriv_succ]
      have h2 : (fun Y' => g₂ (X, Y')) = iteratedDeriv 2 (normAction1_ℂ B X) := by
        ext Y'; simp only [g₂, h1, ← iteratedDeriv_succ]
      have h3 : (fun Y' => g₃ (X, Y')) = iteratedDeriv 3 (normAction1_ℂ B X) := by
        ext Y'; simp only [g₃, h2, ← iteratedDeriv_succ]
      simp only [g₄, h3, ← iteratedDeriv_succ]
    let F_rem : ℝ → ℂ × ℂ → ℂ := fun τ q =>
      ((1 - τ : ℝ) : ℂ) ^ 3 * g₄ (q.1, q.1 + (τ : ℂ) * q.2)
    have h_maps_all : ∀ τ ∈ Set.uIcc (0 : ℝ) 1, ∀ q ∈ W_rem,
        (q.1, q.1 + (τ : ℂ) * q.2) ∈ W₃ := by
      intro τ hτ q ⟨hq1, hq2⟩
      rw [Set.uIcc_of_le zero_le_one] at hτ
      refine ⟨hS1_sub hq1, ?_⟩
      change |q.1.im| < B.s₀ at hq1
      change |(q.1 + (τ : ℂ) * q.2).im| < 3 * B.s₀ / 2
      simp only [Metric.mem_ball, dist_zero_right] at hq2
      have hτ_abs : |τ| ≤ 1 := abs_le.mpr ⟨by linarith [hτ.1], hτ.2⟩
      have him_le : |((τ : ℂ) * q.2).im| ≤ ‖q.2‖ := by
        calc |((τ : ℂ) * q.2).im| ≤ ‖(τ : ℂ) * q.2‖ := Complex.abs_im_le_norm _
          _ = |τ| * ‖q.2‖ := by rw [norm_mul, Complex.norm_real, Real.norm_eq_abs]
          _ ≤ 1 * ‖q.2‖ := mul_le_mul_of_nonneg_right hτ_abs (norm_nonneg _)
          _ = ‖q.2‖ := one_mul _
      rw [Complex.add_im]
      linarith [abs_add_le q.1.im ((τ : ℂ) * q.2).im]
    have hF_cont : ContinuousOn (fun r : ℝ × (ℂ × ℂ) => F_rem r.1 r.2)
        (Set.uIcc (0 : ℝ) 1 ×ˢ W_rem) := by
      have h1 : Continuous (fun r : ℝ × (ℂ × ℂ) => ((1 - r.1 : ℝ) : ℂ) ^ 3) := by fun_prop
      have h2 : Continuous (fun r : ℝ × (ℂ × ℂ) => (r.2.1, r.2.1 + (r.1 : ℂ) * r.2.2)) := by
        fun_prop
      exact h1.continuousOn.mul (hg4.continuousOn.comp h2.continuousOn (fun r hr => h_maps_all r.1 hr.1 r.2 hr.2))
    have hF_holo : ∀ τ ∈ Set.uIcc (0 : ℝ) 1, DifferentiableOn ℂ (F_rem τ) W_rem := by
      intro τ hτ
      have h_aff : Differentiable ℂ (fun q : ℂ × ℂ => (q.1, q.1 + (τ : ℂ) * q.2)) :=
        differentiable_fst.prodMk (differentiable_fst.add (differentiable_snd.const_mul (τ : ℂ)))
      exact (hg4.comp h_aff.differentiableOn (fun q hq => h_maps_all τ hτ q hq)).const_mul _
    have hint_holo := hCalc.param_integral_holo 0 1 W_rem F_rem isOpen_Wrem hF_cont hF_holo
    have h_rem_eq : (fun q : ℂ × ℂ => normActionRem_ℂ B q.1 q.2) =
        (fun q : ℂ × ℂ => (1 / 6 : ℂ) * ∫ τ in (0 : ℝ)..1, F_rem τ q) := by
      ext q
      simp only [normActionRem_ℂ, F_rem, hg4_eq]
    rw [h_rem_eq]
    exact hint_holo.const_mul (1 / 6 : ℂ)

  
  have h_rem_bound : ∀ X ∈ horizStrip B.s₀, ∀ b ∈ Metric.ball (0 : ℂ) (B.s₀ / 4),
      ‖normActionRem_ℂ B X b‖ ≤ M_rem := by
    intro X hX b hb
    let r_c : ℝ := B.s₀ / 8
    have hr_c_pos : 0 < r_c := by positivity
    have h_integrand : ∀ τ ∈ Set.uIoc (0 : ℝ) 1,
        ‖((1 - τ : ℝ) : ℂ) ^ 3 *
          iteratedDeriv 4 (fun b' : ℂ => normAction1_ℂ B X (X + b')) ((τ : ℂ) * b)‖ ≤
          24 * M_act / r_c ^ 4 := by
      intro τ hτ
      rw [Set.uIoc_of_le zero_le_one] at hτ
      let Y₀ : ℂ := X + (τ : ℂ) * b
      have hcball_sub : Metric.closedBall Y₀ r_c ⊆ horizStrip (3 * B.s₀ / 2) := by
        intro w hw
        rw [Metric.mem_closedBall, dist_eq_norm] at hw
        change |X.im| < B.s₀ at hX
        change |w.im| < 3 * B.s₀ / 2
        simp only [Metric.mem_ball, dist_zero_right] at hb
        have hτ_abs : |τ| ≤ 1 := abs_le.mpr ⟨by linarith [hτ.1], hτ.2⟩
        have him_τb : |((τ : ℂ) * b).im| ≤ ‖b‖ := by
          calc |((τ : ℂ) * b).im| ≤ ‖(τ : ℂ) * b‖ := Complex.abs_im_le_norm _
            _ = |τ| * ‖b‖ := by rw [norm_mul, Complex.norm_real, Real.norm_eq_abs]
            _ ≤ 1 * ‖b‖ := mul_le_mul_of_nonneg_right hτ_abs (norm_nonneg _)
            _ = ‖b‖ := one_mul _
        have him_w : w.im = X.im + ((τ : ℂ) * b).im + (w - Y₀).im := by simp [Y₀]
        have him_diff : |(w - Y₀).im| ≤ ‖w - Y₀‖ := Complex.abs_im_le_norm _
        simp only [r_c] at hw
        rw [him_w]
        linarith [abs_add_le (X.im + ((τ : ℂ) * b).im) (w - Y₀).im,
          abs_add_le X.im ((τ : ℂ) * b).im, hw, hs0_pos]
      have hX_slice : DifferentiableOn ℂ (normAction1_ℂ B X) (horizStrip (3 * B.s₀ / 2)) :=
        h_act1_holo.comp ((differentiable_const X).prodMk differentiable_id).differentiableOn
          (fun w hw => ⟨hS1_sub hX, hw⟩)
      have h_diffCont : DiffContOnCl ℂ (normAction1_ℂ B X) (Metric.ball Y₀ r_c) :=
        (hX_slice.mono (Set.Subset.trans Metric.closure_ball_subset_closedBall hcball_sub)).diffContOnCl
      have h_sph : ∀ w ∈ Metric.sphere Y₀ r_c, ‖normAction1_ℂ B X w‖ ≤ M_act :=
        fun w hw => h_wide_bound_1 X w (hS1_sub hX) (hcball_sub (Metric.sphere_subset_closedBall hw))
      have hcauchy := Complex.norm_iteratedDeriv_le_of_forall_mem_sphere_norm_le 4 hr_c_pos h_diffCont h_sph
      have hcomp := congr_fun (iteratedDeriv_comp_const_add 4 (normAction1_ℂ B X) X) ((τ : ℂ) * b)
      have h1mt : ‖((1 - τ : ℝ) : ℂ) ^ 3‖ ≤ 1 := by
        rw [norm_pow, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (by linarith [hτ.2])]
        have hle1 : 1 - τ ≤ 1 := by linarith [hτ.1]
        have hnn : 0 ≤ 1 - τ := by linarith [hτ.2]
        nlinarith [sq_nonneg (1 - τ)]
      rw [norm_mul, hcomp]
      have hfac : ((4 : ℕ).factorial : ℝ) * M_act / r_c ^ 4 = 24 * M_act / r_c ^ 4 := by norm_num
      rw [hfac] at hcauchy
      calc ‖((1 - τ : ℝ) : ℂ) ^ 3‖ * ‖iteratedDeriv 4 (normAction1_ℂ B X) Y₀‖
          ≤ 1 * (24 * M_act / r_c ^ 4) := by gcongr
        _ = 24 * M_act / r_c ^ 4 := one_mul _
    simp only [normActionRem_ℂ, norm_mul]
    have h16 : ‖(1 / 6 : ℂ)‖ = 1 / 6 := by norm_num
    rw [h16]
    have hint_le := intervalIntegral.norm_integral_le_of_norm_le_const h_integrand
    have habs1 : |(1 : ℝ) - 0| = 1 := by norm_num
    rw [habs1, mul_one] at hint_le
    have hrem_step1 : (1 / 6 : ℝ) * ‖∫ τ in (0 : ℝ)..1,
        ((1 - τ : ℝ) : ℂ) ^ 3 *
          iteratedDeriv 4 (fun b' : ℂ => normAction1_ℂ B X (X + b')) ((τ : ℂ) * b)‖ ≤
        (1 / 6) * (24 * M_act / r_c ^ 4) :=
      mul_le_mul_of_nonneg_left hint_le (by norm_num)
    have hrem_step2 : (1 / 6 : ℝ) * (24 * M_act / r_c ^ 4) = M_rem := by
      simp only [M_rem, r_c]; ring
    linarith

  
  have iter_conj_pair : ∀ (n : ℕ) (f₁ f₂ : ℂ → ℂ),
      DifferentiableOn ℂ f₁ (horizStrip (3 * B.s₀ / 2)) →
      DifferentiableOn ℂ f₂ (horizStrip (3 * B.s₀ / 2)) →
      (∀ w ∈ horizStrip (3 * B.s₀ / 2), f₂ (starRingEnd ℂ w) = starRingEnd ℂ (f₁ w)) →
      ∀ z ∈ horizStrip (3 * B.s₀ / 2),
        iteratedDeriv n f₂ (starRingEnd ℂ z) = starRingEnd ℂ (iteratedDeriv n f₁ z) := by
    intro n
    induction n with
    | zero =>
      intro f₁ f₂ _ _ hrel z hz
      simpa [iteratedDeriv_zero] using hrel z hz
    | succ k ih =>
      intro f₁ f₂ hf1 hf2 hrel z hz
      let g₁ := iteratedDeriv k f₁
      let g₂ := iteratedDeriv k f₂
      have hg1_holo : DifferentiableOn ℂ g₁ (horizStrip (3 * B.s₀ / 2)) :=
        diffOn_iter (isOpen_strip _) hf1 k
      have hg1_at : HasDerivAt g₁ (deriv g₁ z) z :=
        (hg1_holo.differentiableAt ((isOpen_strip _).mem_nhds hz)).hasDerivAt
      have hcc := hg1_at.conj_conj
      have hev : (⇑(starRingEnd ℂ) ∘ g₁ ∘ ⇑(starRingEnd ℂ)) =ᶠ[nhds (starRingEnd ℂ z)] g₂ := by
        refine Filter.eventually_of_mem ((isOpen_strip _).mem_nhds (conj_mem_strip hz)) (fun w hw => ?_)
        have hw_bar : starRingEnd ℂ w ∈ horizStrip (3 * B.s₀ / 2) := conj_mem_strip hw
        have hstep := ih f₁ f₂ hf1 hf2 hrel (starRingEnd ℂ w) hw_bar
        simp only [Function.comp_apply, RingHomCompTriple.comp_apply, RingHom.id_apply] at hstep ⊢
        exact hstep.symm
      have hg2_at := hev.hasDerivAt_iff.mp hcc
      rw [iteratedDeriv_succ, iteratedDeriv_succ]
      exact hg2_at.deriv

  have h_rem_conj : ∀ X ∈ horizStrip B.s₀, ∀ b ∈ Metric.ball (0 : ℂ) (B.s₀ / 4),
      normActionRem_ℂ B (starRingEnd ℂ X) (starRingEnd ℂ b) =
        starRingEnd ℂ (normActionRem_ℂ B X b) := by
    intro X hX b hb
    have hX3 : X ∈ horizStrip (3 * B.s₀ / 2) := hS1_sub hX
    have hXb3 : starRingEnd ℂ X ∈ horizStrip (3 * B.s₀ / 2) := conj_mem_strip hX3
    have hf1_holo : DifferentiableOn ℂ (normAction1_ℂ B X) (horizStrip (3 * B.s₀ / 2)) :=
      h_act1_holo.comp ((differentiable_const X).prodMk differentiable_id).differentiableOn
        (fun w hw => ⟨hX3, hw⟩)
    have hf2_holo : DifferentiableOn ℂ (normAction1_ℂ B (starRingEnd ℂ X)) (horizStrip (3 * B.s₀ / 2)) :=
      h_act1_holo.comp ((differentiable_const (starRingEnd ℂ X)).prodMk differentiable_id).differentiableOn
        (fun w hw => ⟨hXb3, hw⟩)
    have hrel : ∀ w ∈ horizStrip (3 * B.s₀ / 2),
        normAction1_ℂ B (starRingEnd ℂ X) (starRingEnd ℂ w) =
          starRingEnd ℂ (normAction1_ℂ B X w) :=
      fun w hw => (h_conj X w hX3 hw).1
    have h_eqon : Set.EqOn
        (fun τ : ℝ => ((1 - τ : ℝ) : ℂ) ^ 3 *
          iteratedDeriv 4 (fun b' : ℂ => normAction1_ℂ B (starRingEnd ℂ X) (starRingEnd ℂ X + b'))
            ((τ : ℂ) * starRingEnd ℂ b))
        (fun τ : ℝ => starRingEnd ℂ (((1 - τ : ℝ) : ℂ) ^ 3 *
          iteratedDeriv 4 (fun b' : ℂ => normAction1_ℂ B X (X + b')) ((τ : ℂ) * b)))
        (Set.uIcc 0 1) := by
      intro τ hτ
      dsimp only
      rw [Set.uIcc_of_le zero_le_one] at hτ
      have hz_mem : X + (τ : ℂ) * b ∈ horizStrip (3 * B.s₀ / 2) := by
        change |X.im| < B.s₀ at hX
        change |(X + (τ : ℂ) * b).im| < 3 * B.s₀ / 2
        simp only [Metric.mem_ball, dist_zero_right] at hb
        have hτ_abs : |τ| ≤ 1 := abs_le.mpr ⟨by linarith [hτ.1], hτ.2⟩
        have him_τb : |((τ : ℂ) * b).im| ≤ ‖b‖ := by
          calc |((τ : ℂ) * b).im| ≤ ‖(τ : ℂ) * b‖ := Complex.abs_im_le_norm _
            _ = |τ| * ‖b‖ := by rw [norm_mul, Complex.norm_real, Real.norm_eq_abs]
            _ ≤ 1 * ‖b‖ := mul_le_mul_of_nonneg_right hτ_abs (norm_nonneg _)
            _ = ‖b‖ := one_mul _
        rw [Complex.add_im]
        linarith [abs_add_le X.im ((τ : ℂ) * b).im]
      have hc1 := congr_fun (iteratedDeriv_comp_const_add 4 (normAction1_ℂ B (starRingEnd ℂ X))
        (starRingEnd ℂ X)) ((τ : ℂ) * starRingEnd ℂ b)
      have hc2 := congr_fun (iteratedDeriv_comp_const_add 4 (normAction1_ℂ B X) X) ((τ : ℂ) * b)
      have harg : starRingEnd ℂ X + (τ : ℂ) * starRingEnd ℂ b = starRingEnd ℂ (X + (τ : ℂ) * b) := by
        simp
      rw [hc1, hc2, harg, iter_conj_pair 4 _ _ hf1_holo hf2_holo hrel _ hz_mem]
      simp
    simp only [normActionRem_ℂ]
    rw [intervalIntegral.integral_congr h_eqon, map_mul]
    have h16c : starRingEnd ℂ (1 / 6 : ℂ) = 1 / 6 := by simp [map_ofNat]
    rw [h16c]
    simp only [intervalIntegral.integral_of_le zero_le_one, integral_conj]

  
  have h_taylor4 : ∀ X ∈ horizStrip B.s₀, ∀ b ∈ Metric.ball (0 : ℂ) (B.s₀ / 4),
      normAction1_ℂ B X (X + b) = b ^ 2 / 8 + b ^ 4 * normActionRem_ℂ B X b := by
    intro X hX b hb
    have hX3 : X ∈ horizStrip (3 * B.s₀ / 2) := hS1_sub hX
    have hX2 : X ∈ horizStrip (2 * B.s₀) := hS3_sub hX3
    let ϕ₀ := B.ϕ_ℂ X
    let ϕ₁ := deriv B.ϕ_ℂ X
    let ϕ₂ := deriv (deriv B.ϕ_ℂ) X
    let r₀ := r_ℂ B ϕ₀
    let r₁ := deriv (r_ℂ B) ϕ₀
    have hϕ0_mem : ϕ₀ ∈ horizStrip (2 * B.s_h) := B.ϕ_ℂ_maps_to X hX2

    
    have h_laz0 : r₀ * ϕ₁ ^ 3 = (B.c : ℂ) := B.lazutkin_norm_ℂ X hX2
    have h_laz1 : r₁ * ϕ₁ ^ 3 + 3 * r₀ * ϕ₁ * ϕ₂ = 0 := by
      have hϕ_at : HasDerivAt B.ϕ_ℂ ϕ₁ X :=
        (B.ϕ_ℂ_holo.differentiableAt ((isOpen_strip _).mem_nhds hX2)).hasDerivAt
      have hdϕ_at : HasDerivAt (deriv B.ϕ_ℂ) ϕ₂ X :=
        (hdϕ_holo.differentiableAt ((isOpen_strip _).mem_nhds hX2)).hasDerivAt
      have hr_at : HasDerivAt (r_ℂ B) r₁ ϕ₀ :=
        (hr_holo.differentiableAt ((isOpen_strip _).mem_nhds hϕ0_mem)).hasDerivAt
      have hlhs := (hr_at.comp X hϕ_at).mul (hdϕ_at.pow 3)
      have hev : ((r_ℂ B ∘ B.ϕ_ℂ) * deriv B.ϕ_ℂ ^ 3) =ᶠ[nhds X]
          (fun _ : ℂ => (B.c : ℂ)) :=
        Filter.eventually_of_mem ((isOpen_strip _).mem_nhds hX2) (fun z hz => B.lazutkin_norm_ℂ z hz)
      have hzero : (r₁ * ϕ₁) * ϕ₁ ^ 3 + r₀ * (((3 : ℕ) : ℂ) * ϕ₁ ^ (3 - 1) * ϕ₂) = 0 := by
        have hd_eq := hlhs.deriv
        rw [hev.deriv_eq, deriv_const] at hd_eq
        simpa only [Function.comp_apply, Pi.pow_apply, ϕ₀, ϕ₁, r₀] using hd_eq.symm
      have hfac : ϕ₁ * (r₁ * ϕ₁ ^ 3 + 3 * r₀ * ϕ₁ * ϕ₂) = 0 := by
        calc ϕ₁ * (r₁ * ϕ₁ ^ 3 + 3 * r₀ * ϕ₁ * ϕ₂)
            = (r₁ * ϕ₁) * ϕ₁ ^ 3 + r₀ * (((3 : ℕ) : ℂ) * ϕ₁ ^ (3 - 1) * ϕ₂) := by norm_num; ring
          _ = 0 := hzero
      exact (mul_eq_zero.mp hfac).resolve_left (B.ϕ_ℂ_deriv_ne_zero X hX2)

    
    let D_b : Set ℂ := Metric.ball (0 : ℂ) (B.s₀ / 2)
    have h0_Db : (0 : ℂ) ∈ D_b := Metric.mem_ball_self (by positivity)
    have hDb_maps : ∀ b' ∈ D_b, X + b' ∈ horizStrip (3 * B.s₀ / 2) := by
      intro b' hb'
      rw [Metric.mem_ball, dist_zero_right] at hb'
      change |X.im| < B.s₀ at hX
      change |(X + b').im| < 3 * B.s₀ / 2
      have him_b : |b'.im| ≤ ‖b'‖ := Complex.abs_im_le_norm _
      rw [Complex.add_im]
      linarith [abs_add_le X.im b'.im]
    let f : ℂ → ℂ := fun b' => normAction1_ℂ B X (X + b')
    have hf_holo : DifferentiableOn ℂ f D_b :=
      h_act1_holo.comp ((differentiable_const X).prodMk (differentiable_id.const_add X)).differentiableOn
        (fun b' hb' => ⟨hX3, hDb_maps b' hb'⟩)
    have hf_iter_holo : ∀ n : ℕ, DifferentiableOn ℂ (iteratedDeriv n f) D_b :=
      diffOn_iter Metric.isOpen_ball hf_holo

    
    have hf0 : iteratedDeriv 0 f 0 = 0 := by
      simp only [iteratedDeriv_zero, f, add_zero, normAction1_ℂ, supportAction1_ℂ]
      have hm : (B.ϕ_ℂ X + B.ϕ_ℂ X) / 2 = B.ϕ_ℂ X := by ring
      have hd : (B.ϕ_ℂ X - B.ϕ_ℂ X) / 2 = 0 := by ring
      rw [hm, hd, Complex.sin_zero, Complex.cos_zero]
      ring

    let P : ℂ → ℂ := fun b' => ϕ₁ * deriv B.ϕ_ℂ (X + b') * r_ℂ B ((ϕ₀ + B.ϕ_ℂ (X + b')) / 2)
    let S : ℂ → ℂ := fun b' => Complex.sin ((B.ϕ_ℂ (X + b') - ϕ₀) / 2)
    let S₁ : ℂ → ℂ := fun b' =>
      Complex.cos ((B.ϕ_ℂ (X + b') - ϕ₀) / 2) * (deriv B.ϕ_ℂ (X + b') / 2)

    have hdf_eq : ∀ b' ∈ D_b, deriv f b' = (2 * (B.c : ℂ))⁻¹ * (P b' * S b') := by
      intro b' hb'
      have hc : deriv f b' = deriv (fun Y' : ℂ => normAction1_ℂ B X Y') (X + b') :=
        deriv_comp_const_add (normAction1_ℂ B X) X b'
      rw [hc, h_deriv1_right X (X + b') hX3 (hDb_maps b' hb')]
      simp only [normAction12_ℂ, P, S, ϕ₀, ϕ₁]
      ring

    have hS0 : S 0 = 0 := by
      simp only [S, add_zero, ϕ₀, sub_self, zero_div, Complex.sin_zero]
    have hP0 : P 0 = r₀ * ϕ₁ ^ 2 := by
      simp only [P, add_zero, ϕ₀, ϕ₁, r₀]
      have hm : (B.ϕ_ℂ X + B.ϕ_ℂ X) / 2 = B.ϕ_ℂ X := by ring
      rw [hm]; ring
    have hS1_0 : S₁ 0 = ϕ₁ / 2 := by
      simp only [S₁, add_zero, ϕ₀, ϕ₁, sub_self, zero_div, Complex.cos_zero, one_mul]
    have hf1 : iteratedDeriv 1 f 0 = 0 := by
      rw [iteratedDeriv_one, hdf_eq 0 h0_Db, hS0, mul_zero, mul_zero]

    have hP_holo : DifferentiableOn ℂ P D_b := by
      have hϕ_sh : DifferentiableOn ℂ (fun b' : ℂ => B.ϕ_ℂ (X + b')) D_b :=
        B.ϕ_ℂ_holo.comp (differentiable_id.const_add X).differentiableOn
          (fun b' hb' => hS3_sub (hDb_maps b' hb'))
      have hdϕ_sh : DifferentiableOn ℂ (fun b' : ℂ => deriv B.ϕ_ℂ (X + b')) D_b :=
        hdϕ_holo.comp (differentiable_id.const_add X).differentiableOn
          (fun b' hb' => hS3_sub (hDb_maps b' hb'))
      have hmid_sh : DifferentiableOn ℂ (fun b' : ℂ => (ϕ₀ + B.ϕ_ℂ (X + b')) / 2) D_b :=
        ((hϕ_sh.const_add ϕ₀).mul_const (2⁻¹ : ℂ)).congr (fun _ _ => by simp [div_eq_mul_inv])
      have hmid_maps : Set.MapsTo (fun b' : ℂ => (ϕ₀ + B.ϕ_ℂ (X + b')) / 2) D_b
          (horizStrip (2 * B.s_h)) :=
        fun b' hb' => mid_mem_strip hϕ0_mem (B.ϕ_ℂ_maps_to _ (hS3_sub (hDb_maps b' hb')))
      exact (hdϕ_sh.const_mul ϕ₁).mul (hr_holo.comp hmid_sh hmid_maps)
    have hdP_holo : DifferentiableOn ℂ (deriv P) D_b := hP_holo.deriv Metric.isOpen_ball

    have hϕ_sh_at : ∀ b' ∈ D_b,
        HasDerivAt (B.ϕ_ℂ ∘ HAdd.hAdd X) (deriv B.ϕ_ℂ (X + b')) b' := by
      intro b' hb'
      have hXb' : X + b' ∈ horizStrip (2 * B.s₀) := hS3_sub (hDb_maps b' hb')
      have h_inner : HasDerivAt (HAdd.hAdd X) 1 b' := by
        simpa using (hasDerivAt_id b').const_add X
      have h_out : HasDerivAt B.ϕ_ℂ (deriv B.ϕ_ℂ (X + b')) (HAdd.hAdd X b') :=
        (B.ϕ_ℂ_holo.differentiableAt ((isOpen_strip _).mem_nhds hXb')).hasDerivAt
      have hc := h_out.comp b' h_inner
      rwa [mul_one] at hc

    have hdϕ_sh_at : ∀ b' ∈ D_b,
        HasDerivAt (deriv B.ϕ_ℂ ∘ HAdd.hAdd X) (deriv (deriv B.ϕ_ℂ) (X + b')) b' := by
      intro b' hb'
      have hXb' : X + b' ∈ horizStrip (2 * B.s₀) := hS3_sub (hDb_maps b' hb')
      have h_inner : HasDerivAt (HAdd.hAdd X) 1 b' := by
        simpa using (hasDerivAt_id b').const_add X
      have h_out : HasDerivAt (deriv B.ϕ_ℂ) (deriv (deriv B.ϕ_ℂ) (X + b')) (HAdd.hAdd X b') :=
        (hdϕ_holo.differentiableAt ((isOpen_strip _).mem_nhds hXb')).hasDerivAt
      have hc := h_out.comp b' h_inner
      rwa [mul_one] at hc

    have hdP_0 : deriv P 0 = -(1 / 2 : ℂ) * r₀ * ϕ₁ * ϕ₂ := by
      have h1 := hdϕ_sh_at 0 h0_Db
      rw [add_zero] at h1
      have hϕ0_at := hϕ_sh_at 0 h0_Db
      rw [add_zero] at hϕ0_at
      have h2_in := (hϕ0_at.const_add ϕ₀).div_const (2 : ℂ)
      have hm0 : (ϕ₀ + (B.ϕ_ℂ ∘ HAdd.hAdd X) 0) / 2 = ϕ₀ := by
        simp only [Function.comp_apply, add_zero, ϕ₀]; ring
      have hr_at : HasDerivAt (r_ℂ B) r₁ ((ϕ₀ + (B.ϕ_ℂ ∘ HAdd.hAdd X) 0) / 2) := by
        rw [hm0]; exact (hr_holo.differentiableAt ((isOpen_strip _).mem_nhds hϕ0_mem)).hasDerivAt
      have hP_raw := (h1.const_mul ϕ₁).mul (hr_at.comp 0 h2_in)
      have hP_at := hP_raw.congr_of_eventuallyEq (Filter.EventuallyEq.of_eq (by ext z; rfl : _ = P))
      rw [hP_at.deriv, Function.comp_apply, hm0]
      simp only [Function.comp_apply, add_zero]
      change (ϕ₁ * ϕ₂) * r₀ + (ϕ₁ * ϕ₁) * (r₁ * (ϕ₁ / 2)) = -(1 / 2 : ℂ) * r₀ * ϕ₁ * ϕ₂
      linear_combination (1 / 2 : ℂ) * h_laz1

    have hS_deriv : ∀ b' ∈ D_b, HasDerivAt S (S₁ b') b' := by
      intro b' hb'
      have hΔ := ((hϕ_sh_at b' hb').sub_const ϕ₀).div_const (2 : ℂ)
      exact hΔ.csin.congr_of_eventuallyEq (Filter.EventuallyEq.of_eq (by ext z; rfl : _ = S))

    have hS1_at0_raw := by
      have hϕ0_at := hϕ_sh_at 0 h0_Db
      rw [add_zero] at hϕ0_at
      have hΔ0 := (hϕ0_at.sub_const ϕ₀).div_const (2 : ℂ)
      have hdϕ0_at := (hdϕ_sh_at 0 h0_Db).div_const (2 : ℂ)
      rw [add_zero] at hdϕ0_at
      exact (hΔ0.ccos.mul hdϕ0_at).congr_of_eventuallyEq
        (Filter.EventuallyEq.of_eq (by ext z; rfl : _ = S₁))
    have hS1_val : -Complex.sin (((B.ϕ_ℂ ∘ HAdd.hAdd X) 0 - ϕ₀) / 2) * (deriv B.ϕ_ℂ X / 2) *
        ((deriv B.ϕ_ℂ ∘ HAdd.hAdd X) 0 / 2) +
        Complex.cos (((B.ϕ_ℂ ∘ HAdd.hAdd X) 0 - ϕ₀) / 2) * (deriv (deriv B.ϕ_ℂ) X / 2) = ϕ₂ / 2 := by
      simp [Function.comp_apply, ϕ₀, ϕ₂, sub_self, zero_div, Complex.sin_zero, Complex.cos_zero]
    rw [hS1_val] at hS1_at0_raw

    let f₂ : ℂ → ℂ := fun b' => (2 * (B.c : ℂ))⁻¹ * (deriv P b' * S b' + P b' * S₁ b')
    have hdf2_eq : ∀ b' ∈ D_b, deriv (deriv f) b' = f₂ b' := by
      intro b' hb'
      have hP_at : HasDerivAt P (deriv P b') b' :=
        (hP_holo.differentiableAt (Metric.isOpen_ball.mem_nhds hb')).hasDerivAt
      have hps := ((hP_at.mul (hS_deriv b' hb')).const_mul (2 * (B.c : ℂ))⁻¹).congr_of_eventuallyEq
        (Filter.EventuallyEq.of_eq (by ext z; rfl :
          _ = (fun z : ℂ => (2 * (B.c : ℂ))⁻¹ * (P z * S z))))
      have hev : deriv f =ᶠ[nhds b'] (fun z : ℂ => (2 * (B.c : ℂ))⁻¹ * (P z * S z)) :=
        Filter.eventually_of_mem (Metric.isOpen_ball.mem_nhds hb') (fun z hz => hdf_eq z hz)
      rw [hev.deriv_eq, hps.deriv]

    have hf2 : iteratedDeriv 2 f 0 = 1 / 4 := by
      rw [iteratedDeriv_succ, iteratedDeriv_one, hdf2_eq 0 h0_Db]
      simp only [f₂, hS0, hP0, hS1_0, mul_zero, zero_add]
      calc (2 * (B.c : ℂ))⁻¹ * (r₀ * ϕ₁ ^ 2 * (ϕ₁ / 2))
          = (r₀ * ϕ₁ ^ 3) / (4 * (B.c : ℂ)) := by ring
        _ = (B.c : ℂ) / (4 * (B.c : ℂ)) := by rw [h_laz0]
        _ = 1 / 4 := by field_simp [hc_ne]

    have hf3 : iteratedDeriv 3 f 0 = 0 := by
      have hdP_at0 : HasDerivAt (deriv P) (deriv (deriv P) 0) 0 :=
        (hdP_holo.differentiableAt (Metric.isOpen_ball.mem_nhds h0_Db)).hasDerivAt
      have hP_at0 : HasDerivAt P (deriv P 0) 0 :=
        (hP_holo.differentiableAt (Metric.isOpen_ball.mem_nhds h0_Db)).hasDerivAt
      have hf2_at0 := (((hdP_at0.mul (hS_deriv 0 h0_Db)).add
        (hP_at0.mul hS1_at0_raw)).const_mul (2 * (B.c : ℂ))⁻¹).congr_of_eventuallyEq
          (Filter.EventuallyEq.of_eq (by ext z; rfl : _ = f₂))
      have hev : deriv (deriv f) =ᶠ[nhds (0 : ℂ)] f₂ :=
        Filter.eventually_of_mem (Metric.isOpen_ball.mem_nhds h0_Db) (fun z hz => hdf2_eq z hz)
      have h3_eq : iteratedDeriv 3 f 0 = deriv (deriv (deriv f)) 0 := by
        rw [iteratedDeriv_succ, iteratedDeriv_succ, iteratedDeriv_one]
      rw [h3_eq, hev.deriv_eq, hf2_at0.deriv, hS0, hdP_0, hS1_0, hP0]
      ring

    
    let G_ℂ : ℂ → ℂ := fun w =>
      iteratedDeriv 0 f (w * b) +
      (1 - w) * b * iteratedDeriv 1 f (w * b) +
      ((1 - w) ^ 2 / 2) * b ^ 2 * iteratedDeriv 2 f (w * b) +
      ((1 - w) ^ 3 / 6) * b ^ 3 * iteratedDeriv 3 f (w * b)
    have hτb_Db : ∀ τ ∈ Set.uIcc (0 : ℝ) 1, (τ : ℂ) * b ∈ D_b := by
      intro τ hτ
      rw [Set.uIcc_of_le zero_le_one] at hτ
      rw [Metric.mem_ball, dist_zero_right] at hb ⊢
      have hτ_abs : |τ| ≤ 1 := abs_le.mpr ⟨by linarith [hτ.1], hτ.2⟩
      calc ‖(τ : ℂ) * b‖ = |τ| * ‖b‖ := by rw [norm_mul, Complex.norm_real, Real.norm_eq_abs]
        _ ≤ 1 * ‖b‖ := mul_le_mul_of_nonneg_right hτ_abs (norm_nonneg _)
        _ < B.s₀ / 2 := by linarith

    have hG_deriv : ∀ τ ∈ Set.uIcc (0 : ℝ) 1,
        HasDerivAt (fun t : ℝ => G_ℂ (t : ℂ))
          (b ^ 4 * ((1 / 6 : ℂ) *
            (((1 - τ : ℝ) : ℂ) ^ 3 * iteratedDeriv 4 f ((τ : ℂ) * b)))) τ := by
      intro τ hτ
      have hwb : (τ : ℂ) * b ∈ D_b := hτb_Db τ hτ
      have hw_mul : HasDerivAt (fun ζ : ℂ => ζ * b) b (τ : ℂ) := by
        simpa using (hasDerivAt_id (τ : ℂ)).mul_const b
      have h1mw := ((hasDerivAt_const (τ : ℂ) (1 : ℂ)).sub (hasDerivAt_id (τ : ℂ))).congr_of_eventuallyEq
        (Filter.EventuallyEq.of_eq (by ext ζ; rfl : _ = (fun ζ : ℂ => 1 - ζ)))
      rw [show (0 : ℂ) - 1 = (-1 : ℂ) by ring] at h1mw
      have hi0 : HasDerivAt (fun ζ : ℂ => iteratedDeriv 0 f (ζ * b))
          (iteratedDeriv 1 f ((τ : ℂ) * b) * b) (τ : ℂ) := by
        have h := ((hf_iter_holo 0).differentiableAt (Metric.isOpen_ball.mem_nhds hwb)).hasDerivAt.comp (τ : ℂ) hw_mul
        rwa [← iteratedDeriv_succ] at h
      have hi1 : HasDerivAt (fun ζ : ℂ => iteratedDeriv 1 f (ζ * b))
          (iteratedDeriv 2 f ((τ : ℂ) * b) * b) (τ : ℂ) := by
        have h := ((hf_iter_holo 1).differentiableAt (Metric.isOpen_ball.mem_nhds hwb)).hasDerivAt.comp (τ : ℂ) hw_mul
        rwa [← iteratedDeriv_succ] at h
      have hi2 : HasDerivAt (fun ζ : ℂ => iteratedDeriv 2 f (ζ * b))
          (iteratedDeriv 3 f ((τ : ℂ) * b) * b) (τ : ℂ) := by
        have h := ((hf_iter_holo 2).differentiableAt (Metric.isOpen_ball.mem_nhds hwb)).hasDerivAt.comp (τ : ℂ) hw_mul
        rwa [← iteratedDeriv_succ] at h
      have hi3 : HasDerivAt (fun ζ : ℂ => iteratedDeriv 3 f (ζ * b))
          (iteratedDeriv 4 f ((τ : ℂ) * b) * b) (τ : ℂ) := by
        have h := ((hf_iter_holo 3).differentiableAt (Metric.isOpen_ball.mem_nhds hwb)).hasDerivAt.comp (τ : ℂ) hw_mul
        rwa [← iteratedDeriv_succ] at h
      have ht1 := (h1mw.mul_const b).mul hi1
      have ht2 := (((h1mw.pow 2).div_const (2 : ℂ)).mul_const (b ^ 2)).mul hi2
      have ht3 := (((h1mw.pow 3).div_const (6 : ℂ)).mul_const (b ^ 3)).mul hi3
      have hG_at := (((hi0.add ht1).add ht2).add ht3).congr_of_eventuallyEq
        (Filter.EventuallyEq.of_eq (by ext ζ; rfl : _ = G_ℂ))
      have hG_simp :
          iteratedDeriv 1 f ((τ : ℂ) * b) * b +
          (((-1 : ℂ) * b) * iteratedDeriv 1 f ((τ : ℂ) * b) +
            ((1 - (τ : ℂ)) * b) * (iteratedDeriv 2 f ((τ : ℂ) * b) * b)) +
          (((((2 : ℕ) : ℂ) * (1 - (τ : ℂ)) ^ (2 - 1) * (-1 : ℂ) / 2) * b ^ 2) * iteratedDeriv 2 f ((τ : ℂ) * b) +
            ((1 - (τ : ℂ)) ^ 2 / 2 * b ^ 2) * (iteratedDeriv 3 f ((τ : ℂ) * b) * b)) +
          (((((3 : ℕ) : ℂ) * (1 - (τ : ℂ)) ^ (3 - 1) * (-1 : ℂ) / 6) * b ^ 3) * iteratedDeriv 3 f ((τ : ℂ) * b) +
            ((1 - (τ : ℂ)) ^ 3 / 6 * b ^ 3) * (iteratedDeriv 4 f ((τ : ℂ) * b) * b)) =
          b ^ 4 * ((1 / 6 : ℂ) * (((1 - τ : ℝ) : ℂ) ^ 3 * iteratedDeriv 4 f ((τ : ℂ) * b))) := by
        push_cast
        norm_num
        ring
      have hG_real := hG_at.comp_ofReal
      dsimp only [Pi.pow_apply] at hG_real
      rwa [hG_simp] at hG_real

    have hG'_cont : ContinuousOn
        (fun τ : ℝ => b ^ 4 * ((1 / 6 : ℂ) *
          (((1 - τ : ℝ) : ℂ) ^ 3 * iteratedDeriv 4 f ((τ : ℂ) * b))))
        (Set.uIcc 0 1) := by
      have hc1 : Continuous (fun τ : ℝ => ((1 - τ : ℝ) : ℂ) ^ 3) := by fun_prop
      have hc2 : Continuous (fun τ : ℝ => (τ : ℂ) * b) := by fun_prop
      have hc3 : ContinuousOn (fun τ : ℝ => iteratedDeriv 4 f ((τ : ℂ) * b)) (Set.uIcc 0 1) :=
        (hf_iter_holo 4).continuousOn.comp hc2.continuousOn hτb_Db
      exact continuousOn_const.mul (continuousOn_const.mul (hc1.continuousOn.mul hc3))

    have hftc := intervalIntegral.integral_eq_sub_of_hasDerivAt hG_deriv hG'_cont.intervalIntegrable
    rw [intervalIntegral.integral_const_mul, intervalIntegral.integral_const_mul] at hftc
    have hG1 : G_ℂ (1 : ℂ) = normAction1_ℂ B X (X + b) := by
      simp [G_ℂ, f]
    have hG0 : G_ℂ (0 : ℂ) = b ^ 2 / 8 := by
      simp only [G_ℂ, zero_mul, sub_zero, hf0, hf1, hf2, hf3]
      ring
    rw [Complex.ofReal_one, Complex.ofReal_zero, hG1, hG0] at hftc
    change b ^ 4 * normActionRem_ℂ B X b = normAction1_ℂ B X (X + b) - b ^ 2 / 8 at hftc
    linear_combination -hftc

  
  
  
  exact ⟨{
    M_act := M_act
    M_rem := M_rem
    δ_lin := δ_lin
    M_act_pos := hM_act_pos
    M_rem_pos := hM_rem_pos
    δ_lin_pos := hδ_lin_pos
    δ_lin_le_eighth_s₀ := hδ_le_eighth
    δ_lin_le_half := hδ_le_half
    normAction1_holo := h_act1_holo
    normAction2_holo := h_act2_holo
    normAction12_holo := h_act12_holo
    normAction_diag_periodic := h_diag_per
    normAction_conj := h_conj
    normAction2_eq_neg_swap := h_swap
    deriv_normAction1_right := h_deriv1_right
    deriv_normAction2_left := h_deriv2_left
    normAction_real_stationary_iff := h_real_stat
    normAction_bound := h_act_bound
    ϕ_deriv_strip_lip := h_ϕ_lip_54
    real_step_bound := h_real_step
    boundary_lin_close := h_lin_close
    normActionRem_holo := h_rem_holo
    normActionRem_bound := h_rem_bound
    normActionRem_conj := h_rem_conj
    normAction1_taylor4 := h_taylor4
  }⟩

theorem glancing_scale_and_operator_props (Ω : Set Plane)
    (B : AnalyticBoundaryData Ω)
    (hCalc : UniversalGlancingCalculus)
    (A : NormActionPackage B) :
    Nonempty (GlancingOperatorCore B A) :=
by
  obtain ⟨s_act, d_act, η_adm, M_E, lin_ratio,
      hs_pos, hs_le_half_s₀, hs_le_one,
      hlin_pos, hlin_le_quarter, hM_ratio,
      hη_pos, hη_le_inv32, hη_le_eighth_s₀, hη_le_quarter_s₀, hη_le_lin,
      hd_pos, hd_lt_half_s_act, hd_lt_one, hd_lt_half_δ_col, hd_lt_half_τ₀, hd_le_s₀32, hd_le_lin,
      hME_eq, hME_pos⟩ :
      ∃ (s_act d_act η_adm M_E lin_ratio : ℝ),
        0 < s_act ∧ s_act ≤ B.s₀ / 2 ∧ s_act ≤ 1 ∧
        0 < lin_ratio ∧ lin_ratio ≤ A.δ_lin / 4 ∧ A.M_act * lin_ratio ≤ A.δ_lin / 4 ∧
        0 < η_adm ∧ η_adm ≤ 1 / 32 ∧ η_adm ≤ B.s₀ / 8 ∧ η_adm ≤ B.s₀ / 4 ∧ η_adm ≤ lin_ratio ∧
        0 < d_act ∧ d_act < s_act / 2 ∧ d_act < 1 ∧ d_act < B.δ_col / 2 ∧ d_act < B.τ₀ / 2 ∧
        d_act ≤ B.s₀ / 32 ∧ d_act ≤ lin_ratio / 4 ∧
        M_E = 2 + 64 * A.M_rem ∧ 0 < M_E := by
    let s_act : ℝ := min (B.s₀ / 2) 1
    let lin_ratio : ℝ := A.δ_lin / (4 * (A.M_act + 1))
    let η_adm : ℝ := min (1 / 32) (min (B.s₀ / 8) lin_ratio)
    let m_d : ℝ := min (s_act / 2) (min 1 (min (B.δ_col / 2) (min (B.τ₀ / 2) (min (B.s₀ / 8) lin_ratio))))
    let d_act : ℝ := (1 / 4) * m_d
    let M_E : ℝ := 2 + 64 * A.M_rem
    have hs₀_pos : 0 < B.s₀ := B.s₀_pos
    have hδcol_pos : 0 < B.δ_col := B.δ_col_pos
    have hτ₀_pos : 0 < B.τ₀ := B.τ₀_pos
    have hMact_pos : 0 < A.M_act := A.M_act_pos
    have hMrem_pos : 0 < A.M_rem := A.M_rem_pos
    have hδlin_pos : 0 < A.δ_lin := A.δ_lin_pos
    have hlin_pos : 0 < lin_ratio := div_pos hδlin_pos (by linarith)
    have hlin_le_q : lin_ratio ≤ A.δ_lin / 4 := by
      change A.δ_lin / (4 * (A.M_act + 1)) ≤ A.δ_lin / 4
      exact div_le_div_of_nonneg_left (le_of_lt hδlin_pos) (by norm_num) (by linarith)
    have hM_rat : A.M_act * lin_ratio ≤ A.δ_lin / 4 := by
      change A.M_act * (A.δ_lin / (4 * (A.M_act + 1))) ≤ A.δ_lin / 4
      rw [← mul_div_assoc]
      exact (div_le_div_iff₀ (by linarith) (by norm_num)).mpr (by nlinarith)
    have hs_pos : 0 < s_act := lt_min (by linarith) (by norm_num)
    have hs_le_half_s₀ : s_act ≤ B.s₀ / 2 := min_le_left _ _
    have hs_le_one : s_act ≤ 1 := min_le_right _ _
    have hη_pos : 0 < η_adm := lt_min (by norm_num) (lt_min (by linarith) hlin_pos)
    have hη_le_inv32 : η_adm ≤ 1 / 32 := min_le_left _ _
    have hη_le_eighth_s₀ : η_adm ≤ B.s₀ / 8 := le_trans (min_le_right _ _) (min_le_left _ _)
    have hη_le_quarter_s₀ : η_adm ≤ B.s₀ / 4 := by linarith
    have hη_le_lin : η_adm ≤ lin_ratio := le_trans (min_le_right _ _) (min_le_right _ _)
    have hmd_pos : 0 < m_d :=
      lt_min (by linarith) (lt_min (by norm_num) (lt_min (by linarith)
        (lt_min (by linarith) (lt_min (by linarith) hlin_pos))))
    have hd_pos : 0 < d_act := by change 0 < (1 / 4) * m_d; linarith
    have hmd_le_s : m_d ≤ s_act / 2 := min_le_left _ _
    have hmd_le_1 : m_d ≤ 1 := le_trans (min_le_right _ _) (min_le_left _ _)
    have hmd_le_col : m_d ≤ B.δ_col / 2 :=
      le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_left _ _))
    have hmd_le_tau : m_d ≤ B.τ₀ / 2 :=
      le_trans (min_le_right _ _) (le_trans (min_le_right _ _)
        (le_trans (min_le_right _ _) (min_le_left _ _)))
    have hmd_le_s₀8 : m_d ≤ B.s₀ / 8 :=
      le_trans (min_le_right _ _) (le_trans (min_le_right _ _)
        (le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_left _ _))))
    have hmd_le_lin : m_d ≤ lin_ratio :=
      le_trans (min_le_right _ _) (le_trans (min_le_right _ _)
        (le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_right _ _))))
    have hd_lt_md : d_act < m_d := by change (1 / 4) * m_d < m_d; linarith
    exact ⟨s_act, d_act, η_adm, M_E, lin_ratio,
      hs_pos, hs_le_half_s₀, hs_le_one,
      hlin_pos, hlin_le_q, hM_rat,
      hη_pos, hη_le_inv32, hη_le_eighth_s₀, hη_le_quarter_s₀, hη_le_lin,
      hd_pos, lt_of_lt_of_le hd_lt_md hmd_le_s, lt_of_lt_of_le hd_lt_md hmd_le_1,
      lt_of_lt_of_le hd_lt_md hmd_le_col, lt_of_lt_of_le hd_lt_md hmd_le_tau,
      by change (1 / 4) * m_d ≤ B.s₀ / 32; linarith,
      by change (1 / 4) * m_d ≤ lin_ratio / 4; linarith,
      rfl, by change 0 < 2 + 64 * A.M_rem; linarith⟩
  have hs₀_pos : 0 < B.s₀ := B.s₀_pos
  have hc_ne : (B.c : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (ne_of_gt B.c_pos)
  have isOpen_horizStrip : ∀ H : ℝ, IsOpen (horizStrip H) := fun H =>
    isOpen_Iio.preimage (continuous_abs.comp Complex.continuous_im)
  have convex_horizStrip : ∀ H : ℝ, Convex ℝ (horizStrip H) := by
    intro H
    have heq : horizStrip H = Complex.imCLM.toLinearMap ⁻¹' Set.Ioo (-H) H := by
      ext z; simp [horizStrip, abs_lt]
    rw [heq]
    exact (convex_Ioo (-H) H).linear_preimage Complex.imCLM.toLinearMap
  have mem_horizStrip_shift : ∀ {σ : ℝ} {y t : ℂ} {k : ℝ},
      0 ≤ k → |y.im| + k * |t.im| < σ → ∀ {c : ℝ}, |c| ≤ k →
        y + (c : ℂ) * t ∈ horizStrip σ := by
    intro σ y t k hk hy c hc
    change |(y + (c : ℂ) * t).im| < σ
    have him : (y + (c : ℂ) * t).im = y.im + c * t.im := by simp
    rw [him]
    have h1 : |y.im + c * t.im| ≤ |y.im| + |c * t.im| := abs_add_le _ _
    have h2 : |c * t.im| ≤ k * |t.im| := by
      rw [abs_mul]; exact mul_le_mul_of_nonneg_right hc (abs_nonneg _)
    linarith
  have rescaled_symm_integral : ∀ (g : ℝ → ℂ) (lam : ℝ),
      (∫ μ in (-lam)..lam, g μ) = ∫ s in (-1 : ℝ)..(1 : ℝ), (lam : ℂ) * g (lam * s) := by
    intro g lam
    by_cases hlam : lam = 0
    · subst hlam; simp
    · rw [intervalIntegral.integral_const_mul, intervalIntegral.integral_comp_mul_left g hlam,
        mul_neg_one, mul_one, Complex.real_smul, ← mul_assoc, ← Complex.ofReal_mul,
        mul_inv_cancel₀ hlam, Complex.ofReal_one, one_mul]
  have glancingResidualOp_slice : ∀ (U : ℂ × ℂ → ℂ) (y t : ℂ),
      glancingResidualOp B (fun q => U (q.1, t)) (y, t) = glancingResidualOp B U (y, t) := by
    intro U y t
    have h1 : glancingAvgPlus (fun q => U (q.1, t)) y t = glancingAvgPlus U y t := rfl
    have h2 : glancingAvgMinus (fun q => U (q.1, t)) y t = glancingAvgMinus U y t := rfl
    have h3 : glancingSecondAvg (fun q => U (q.1, t)) y t = glancingSecondAvg U y t := rfl
    simp only [glancingResidualOp, h1, h2, h3]
  have u_jet_props : ∀ {σ : ℝ} {u : ℂ → ℂ},
      0 < σ → σ ≤ s_act → DifferentiableOn ℂ u (horizStrip σ) →
      (∀ k : ℕ, k ≤ 2 → ∀ z ∈ horizStrip σ,
        ‖iteratedDeriv k (fun y' : ℂ => u y' - y') z‖ ≤ 5 * η_adm / 4) →
      DifferentiableOn ℂ (deriv u) (horizStrip σ) ∧
      DifferentiableOn ℂ (deriv (deriv u)) (horizStrip σ) ∧
      (∀ z ∈ horizStrip σ,
        u z ∈ horizStrip B.s₀ ∧
        u z ∈ horizStrip (5 * B.s₀ / 4) ∧
        u z ∈ horizStrip (2 * B.s₀) ∧
        ‖deriv u z - 1‖ ≤ 5 * η_adm / 4 ∧
        ‖deriv u z‖ ≤ 133 / 128 ∧
        ‖deriv u z‖ ≤ 2 ∧
        deriv u z ≠ 0 ∧
        ‖deriv (deriv u) z‖ ≤ 5 * η_adm / 4) := by
    intro σ u hσ_pos hσ_le hu hjet
    have hOpen : IsOpen (horizStrip σ) := isOpen_horizStrip σ
    have hu1 : DifferentiableOn ℂ (deriv u) (horizStrip σ) := hu.deriv hOpen
    have hu2 : DifferentiableOn ℂ (deriv (deriv u)) (horizStrip σ) := hu1.deriv hOpen
    refine ⟨hu1, hu2, fun z hz => ?_⟩
    have h0 := hjet 0 (by omega) z hz
    rw [iteratedDeriv_zero] at h0
    have him_sub : |(u z - z).im| ≤ ‖u z - z‖ := Complex.abs_im_le_norm _
    have hzim : |z.im| < σ := hz
    have huz_im : |(u z).im| < B.s₀ := by
      have heq : (u z).im = z.im + (u z - z).im := by simp
      rw [heq]
      have h_abs : |z.im + (u z - z).im| ≤ |z.im| + |(u z - z).im| := abs_add_le _ _
      linarith
