                ((differentiableOn_const (deriv u z)).mul
                  ((differentiableOn_const p_0).add (differentiableOn_id.mul (differentiableOn_const v_0))))
            have hptp_d : DifferentiableOn ℂ
                (fun ζ : ℂ => sqmcMeshPt u (z + (t₀ : ℂ)) (p_p + ζ * v_p))
                (Metric.ball 0 (R₀ / 2)) :=
              (differentiableOn_const _).add
                ((differentiableOn_const _).mul
                  ((differentiableOn_const p_p).add (differentiableOn_id.mul (differentiableOn_const v_p))))
            have hptm_d : DifferentiableOn ℂ
                (fun ζ : ℂ => sqmcMeshPt u (z - (t₀ : ℂ)) (p_m + ζ * v_m))
                (Metric.ball 0 (R₀ / 2)) :=
              (differentiableOn_const _).add
                ((differentiableOn_const _).mul
                  ((differentiableOn_const p_m).add (differentiableOn_id.mul (differentiableOn_const v_m))))
            have hD₁_d : DifferentiableOn ℂ
