          fun r u hu => ih (fun i m hm => hJets i m (by omega)) r u (by omega)
        intro r_goal d hd_le
        rcases lt_or_eq_of_le hd_le with hd_lt | hd_eq
        · exact hIH r_goal d hd_lt
        · 
          let α_ref := lcJetTruncAngles n α_ser
          let η : Fin (k + 1) → MvPowerSeries (Fin 2) ℂ := fun m => α_ser m - α_ref m
          obtain ⟨hα_ref_c0, hα_ref_mem, hη_zero, hη_last, hη_vb, hη_int⟩ :=
            h_trunc_angles_props n hn1 hIH
          let h_tr : Fin k → PowerSeries ℂ := fun i => lcJetTrunc1D (n + 1) (h_ser i)
          have hh_tr_mem : ∀ (i : Fin k) (m : ℕ), PowerSeries.coeff m (h_tr i) ∈ F_val := by
