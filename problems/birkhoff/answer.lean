    have hd_seq_bounds : ∀ i : ℕ, d_lim < d_seq i ∧ d_seq i ≤ d₀ := by
      intro i
      have hlt := h_sum_δ_lt i
      have hnonneg : 0 ≤ ∑ r ∈ Finset.range i, δ r :=
        Finset.sum_nonneg fun r _ => by dsimp [δ]; positivity
