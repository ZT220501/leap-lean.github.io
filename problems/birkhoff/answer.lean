            ∑ j ∈ Finset.range n, φ (n + j + 1) := by
      intro M _ n φ
      have hlen : 2 * n + 1 = n + (n + 1) := by omega
      rw [hlen, Finset.sum_range_add, Finset.sum_range_succ']
      have hrefl : ∑ x ∈ Finset.range n, φ x = ∑ j ∈ Finset.range n, φ (n - 1 - j) := by
        simpa [Nat.sub_sub] using (Finset.sum_range_reflect φ n).symm
