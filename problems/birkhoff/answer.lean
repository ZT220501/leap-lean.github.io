          simpa using tendsto_const_nhds.add h0
        have hz_nhdsW : Filter.Tendsto z_seq Filter.atTop (nhdsWithin (x₀ : ℂ) {(x₀ : ℂ)}ᶜ) := by
          refine tendsto_nhdsWithin_iff.mpr ⟨(Complex.continuous_ofReal.tendsto x₀).comp hz_tend_r,
            Filter.Eventually.of_forall (fun m h_eq => ?_)⟩
          have hre := Complex.ofReal_injective h_eq
