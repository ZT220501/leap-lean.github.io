      rw [one_lt_div hw_pos]
      linarith
    refine ⟨ρ_w, h1_lt, min_le_left _ _, ?_⟩
    refine (differentiableOn_const w).div
      ((differentiableOn_const (1 : ℂ)).sub ((differentiableOn_const w).mul differentiableOn_id)) ?_
    intro z hz
    have hzn_ρ : ‖z‖ < ρ_w := by rwa [Metric.mem_ball, dist_zero_right] at hz
    have hzn : ‖z‖ < 2 / (1 + ‖w‖) := lt_of_lt_of_le hzn_ρ (min_le_right _ _)
    have hz_prod : ‖z‖ * (1 + ‖w‖) < 2 := (lt_div_iff₀ hw_pos).mp hzn
    have h_pos_prod : 0 < (1 + ‖w‖) * (1 - ‖w‖ * ‖z‖) := by
      nlinarith [norm_nonneg w, norm_nonneg z]
    have h_wz_lt : ‖w‖ * ‖z‖ < 1 := by nlinarith
    intro hsub
    have hmul : w * z = 1 := (sub_eq_zero.mp hsub).symm
    have h1 : ‖w * z‖ = 1 := by rw [hmul, norm_one]
    rw [norm_mul] at h1
    linarith

  have hFtilde_low : ∀ a ∈ I_low, ∀ ζ ∈ Metric.ball (0 : ℂ) 1,
      F_tilde (a, ζ) = S.𝔰 (Ψ (a, ζ)) := by
    intro a ha ζ hζ
    let G_a : ℂ → ℂ := fun z => S.𝔰 (Ψ (a, z))
    have hGa_holo : DifferentiableOn ℂ G_a (Metric.ball (0 : ℂ) (11 / 10)) := by
