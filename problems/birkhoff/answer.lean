          have hw_le : ‖w‖ ≤ ‖z‖ := by simpa [Metric.mem_closedBall] using hw
          have hw_cb : w ∈ Metric.closedBall (0 : ℂ) ρ_f :=
            Metric.closedBall_subset_closedBall hz_le hw
