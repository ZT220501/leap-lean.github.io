        ‖a₀'‖ ≤ ρ' →
        ‖a₀' * c0Kernel Q' 1 + a₁' * k0Kernel Q' 1‖ ≤ ρ' →
        ‖slDivided Q' a₀' a₁'‖ ≤ M_num / (r_b - ρ') ^ 2 := by
