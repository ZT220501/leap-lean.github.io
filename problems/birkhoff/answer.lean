          have h_nonneg : 0 ≤ ‖t‖ ^ 2 * M_scale ^ 2 * (D 0) ^ (1 - 2 * α) :=
            mul_nonneg (mul_nonneg (sq_nonneg _) (sq_nonneg _))
              (Real.rpow_nonneg (hD_pos 0 (by omega)).le _)
