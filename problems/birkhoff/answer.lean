      linarith
    have h_small3 : (4 / 3 : ℝ) * G.C_step * K_B ^ B₀ * d₀ ^ 2 ≤ c_min := by
      have hle : (4 / 3 : ℝ) * G.C_step * K_B ^ B₀ / c_min ≤ M_big := by
        have : 0 ≤ G.C_step * K_B ^ B₀ * (2 : ℝ) ^ A_exp := by positivity
        linarith
      have h1 : ((4 / 3 : ℝ) * G.C_step * K_B ^ B₀ / c_min) * d₀ ^ 2 ≤ 1 := by
