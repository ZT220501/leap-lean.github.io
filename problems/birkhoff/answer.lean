  have hStep_lip : ∀ (w₁ w₂ : ℝ → ℝ) (W₁ W₂ : ℂ → ℂ),
      IsPeriodicSmoothBounded (m + 15) M₁ w₁ →
      IsPeriodicSmoothBounded (m + 15) M₁ w₂ →
      IsBoundedStripExt (m + 15) σ M₁ w₁ W₁ →
      IsBoundedStripExt (m + 15) σ M₁ w₂ W₂ →
      ∀ (d₁ d₂ : ℕ → ℂ → ℂ) (Δ_star : ℝ),
        IsStripMeshDispBall (m + 2) q σ_mesh R_strip d₁ →
        IsStripMeshDispBall (m + 2) q σ_mesh R_strip d₂ →
        0 ≤ Δ_star →
        (∀ r : ℕ, r ≤ q → ∀ k : ℕ, k ≤ m + 2 → ∀ z ∈ horizStrip σ_mesh,
          (q : ℝ) ^ 2 * ‖iteratedDeriv k (fun ζ => d₁ r ζ - d₂ r ζ) z‖ ≤ Δ_star) →
        (∀ r : ℕ, r < q → ∀ k : ℕ, k ≤ m + 2 → ∀ z ∈ horizStrip σ_mesh,
          (q : ℝ) ^ 3 *
            ‖iteratedDeriv k
              (fun ζ => (d₁ (r + 1) ζ - d₁ r ζ) - (d₂ (r + 1) ζ - d₂ r ζ)) z‖ ≤ Δ_star) →
        (∀ j : ℕ, j ≤ q → ∀ k : ℕ, k ≤ m + 2 → ∀ z ∈ horizStrip σ_mesh,
          (q : ℝ) ^ 2 *
            ‖iteratedDeriv k
