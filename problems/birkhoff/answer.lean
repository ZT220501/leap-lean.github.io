      have hprod_int : MeasureTheory.IntegrableOn
          (fun q : ℝ × ℝ => q.1 * g (circleMap z₀ q.1 q.2))
          (Set.Ioo (0 : ℝ) R ×ˢ Set.Ioo (-Real.pi) Real.pi)
          MeasureTheory.volume := by
        have h_compact : IsCompact (Set.Icc (0 : ℝ) R ×ˢ Set.Icc (-Real.pi) Real.pi) :=
          isCompact_Icc.prod isCompact_Icc
        have h_cm_maps : Set.MapsTo (fun q : ℝ × ℝ => circleMap z₀ q.1 q.2)
            (Set.Icc (0 : ℝ) R ×ˢ Set.Icc (-Real.pi) Real.pi) (Metric.closedBall z₀ R) := by
          intro q hq
          rw [Metric.mem_closedBall, dist_eq_norm]
          have hsub : circleMap z₀ q.1 q.2 - z₀ = (q.1 : ℂ) * Complex.exp ((q.2 : ℂ) * Complex.I) := by
            simp [circleMap]
          rw [hsub, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hq.1.1,
