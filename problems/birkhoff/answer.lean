          simp only [Complex.sub_im] at hp2
          constructor <;> linarith
      · intro j
        simpa [q_j, r_comb] using hx_av (Sum.inl j)
      · intro j
        simpa [q_j, r_comb] using hy_av (Sum.inr j)
    choose q_junc hq_j_L hq_j_R hq_j_re hq_j_im using h_junc_ex
    let P : Fin (m + 2) → ℂ := fun i =>
      if i.val = 0 then q_start
      else if hm : i.val - 1 < m then q_junc ⟨i.val - 1, hm⟩
      else q_end
    have hP_zero : P 0 = q_start := by simp [P]
    have hP_last : P (Fin.last (m + 1)) = q_end := by simp [P]
    have hA_props : ∀ k : Fin (m + 1),
        P k.castSucc ∈ meshClosedSquare (c k) (9 * ρ k) ∧
        ∀ j : Fin (N_b k),
          (P k.castSucc).im ∉ Set.Ioo ((w_b k j).im - r_b k j) ((w_b k j).im + r_b k j) := by
      intro k
      by_cases hk0 : k.val = 0
      · have hk_eq : k = 0 := Fin.ext hk0
