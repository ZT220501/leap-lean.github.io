  have h_const_interval : ∀ {a u : ℕ}, a ≤ u → u ≤ T → ∀ j : Fin P.N,
      (∀ n : ℕ, a ≤ n → n < u →
        sliceIsTiny S P bG j y_seq n = sliceIsTiny S P bG j y_seq a) →
