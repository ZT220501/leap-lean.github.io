      Metric.closedBall_subset_ball (half_lt_self hR₀_pos)
    have hf₁_holo : DifferentiableOn ℂ f₁ (Metric.ball (0 : ℂ) R₀) :=
      fun z hz => (hR₀ z hz).2.1.differentiableAt.differentiableWithinAt
    let α : ℂ := f₁ 0
    have hα_ne : α ≠ 0 := hf₁_0_ne
