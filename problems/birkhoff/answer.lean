  have hHolo_const : ∀ c : ℂ, paJetHoloAtZero (fun _ => c) ∧
      holoTaylor1D (fun _ => c) 0 = PowerSeries.C c := by
    intro c
    refine ⟨⟨⟨Set.univ, isOpen_univ, Set.mem_univ 0, differentiableOn_const c⟩⟩, ?_⟩
    ext n
    simp only [holoTaylor1D, PowerSeries.coeff_mk, PowerSeries.coeff_C]
    rcases n with _ | n
    · simp
    · rw [iteratedDeriv_const]; simp
  have hHolo_id : paJetHoloAtZero (fun z => z) ∧
      holoTaylor1D (fun z => z) 0 = PowerSeries.X := by
    refine ⟨⟨⟨Set.univ, isOpen_univ, Set.mem_univ 0, differentiableOn_id⟩⟩, ?_⟩
    ext n
    simp only [holoTaylor1D, PowerSeries.coeff_mk, PowerSeries.coeff_X]
    rcases n with _ | _ | n
    · simp
    · simp
    · rw [show n + 1 + 1 = (n + 1) + 1 from rfl, iteratedDeriv_succ',
