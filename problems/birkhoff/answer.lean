        intro n
        have h_vanish : ∀ k ∉ Finset.range (n + 1), T_mat k n = 0 := by
          intro k hk
          rw [Finset.mem_range, not_lt] at hk
          have hch : Nat.choose n k = 0 := Nat.choose_eq_zero_of_lt hk
