    filter_upwards [hBr_nhds, htube_nhds] with w hw_ball hw_tube
    obtain ⟨hc1, hc2, hc3, hc4⟩ := hy_cone_mem w hw_ball
    have heq := (hs_props (y, w) hc1 hc2 hc3 hc4).2.2.2.2 hw_tube
    dsimp [h_y]
    rw [heq]
