  have hr_cr_u_pos : ∀ (u : { q // q ∈ F_un }) (c : Fin 2), 0 < r_cr_u u c := fun u c =>
    lt_min ((W.L_mero c).rad_pos _ (hc_shift_in_tube u.1)) (by linarith [h8ρ_le, hρ_pos])
  have hCross_u : ∀ (u : { q // q ∈ F_un }) (c : Fin 2),
      ∀ z ∈ Metric.ball (c_shift u.1) (r_cr_u u c),
        z ∈ Metric.ball (c_wall u.1) R_wall ∧
        z ∈ Metric.ball (c_shift u.1) ((W.L_mero c).rad (c_shift u.1)) ∧
