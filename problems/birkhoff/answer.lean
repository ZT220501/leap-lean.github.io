        walkMeasure.real (E₈_of j) ≤ 2 * C_ℓ * C_lat / M ^ (σ * ε₀ / 2) := by
      intro j
      have h_log := (hC_ℓ_spec j).2 M B₀ B₁ hB₀_ge_one hB₁_ge_one ρ hAdmM
        (fun y hy z hz => hAdmM.jump_log_chord y hy z hz j)
      refine le_trans h_log ?_
      have hC_j_le : C_ℓ_fn j ≤ C_ℓ := hC_ℓ_le j
      have hC_j_pos : 0 < C_ℓ_fn j := (hC_ℓ_spec j).1
      have h_denom_pos : 0 < 1 + B₁ := by linarith
      calc
        C_ℓ_fn j * (1 + B₀) / (1 + B₁) ≤ C_ℓ * (1 + B₀) / (1 + B₁) := by gcongr
        _ ≤ 2 * C_ℓ * C_lat / M ^ (σ * ε₀ / 2) := by
          rw [div_le_div_iff₀ h_denom_pos h_pow_pos, hB₁_split]
          have h_up1 : M ^ (σ * ε₀ / 2) ≤ B₀ * M ^ (σ * ε₀ / 2) :=
            le_mul_of_one_le_left h_pow_pos.le hB₀_ge_one
          have h_up2 : B₀ * M ^ (σ * ε₀ / 2) ≤ C_lat * (1 + B_init * M ^ (σ * ε₀ / 2)) := by
            dsimp only [B₀]
            calc
              C_lat * B_init * M ^ (σ * ε₀ / 2) = C_lat * (B_init * M ^ (σ * ε₀ / 2)) := by ring
              _ ≤ C_lat * (1 + B_init * M ^ (σ * ε₀ / 2)) :=
                mul_le_mul_of_nonneg_left (by linarith) (by linarith)
          have h_lin : (1 + B₀) * M ^ (σ * ε₀ / 2) ≤
              2 * C_lat * (1 + B_init * M ^ (σ * ε₀ / 2)) := by
            calc
              (1 + B₀) * M ^ (σ * ε₀ / 2) = M ^ (σ * ε₀ / 2) + B₀ * M ^ (σ * ε₀ / 2) := by ring
              _ ≤ 2 * (B₀ * M ^ (σ * ε₀ / 2)) := by linarith
              _ ≤ 2 * (C_lat * (1 + B_init * M ^ (σ * ε₀ / 2))) := by linarith
              _ = 2 * C_lat * (1 + B_init * M ^ (σ * ε₀ / 2)) := by ring
          have h_mul_c := mul_le_mul_of_nonneg_left h_lin hC_ℓ_pos.le
          linarith
    calc
      walkMeasure.real E₈ ≤ ∑ j : Fin P.N, walkMeasure.real (E₈_of j) :=
        MeasureTheory.measureReal_iUnion_fintype_le E₈_of
      _ ≤ ∑ _j : Fin P.N, (2 * C_ℓ * C_lat / M ^ (σ * ε₀ / 2)) :=
        Finset.sum_le_sum fun j _ => h_each j
      _ = (P.N : ℝ) * (2 * C_ℓ * C_lat / M ^ (σ * ε₀ / 2)) := by
        rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
      _ ≤ δ / 8 := by
        have h1 : 16 * (P.N : ℝ) * C_ℓ * C_lat / δ ≤ M ^ (σ * ε₀ / 2) :=
          le_trans (le_max_right _ _) hK_ℓ_le
        have h2 : 16 * (P.N : ℝ) * C_ℓ * C_lat ≤ M ^ (σ * ε₀ / 2) * δ :=
          (div_le_iff₀ hδ).mp h1
        rw [mul_div_assoc', div_le_iff₀ h_pow_pos]
        linarith
  
  let E_all : Set WalkSpace :=
    E₀ ∪ (E₁ ∪ (E₂ ∪ (E₃ ∪ (E₄ ∪ (E₅ ∪ (E₆ ∪ (E₇ ∪ E₈)))))))
  have h_target_sub :
      {om : WalkSpace | ∃ m ≤ sliceStopTau S P ρ M om,
        M ^ σ_new < sliceGeomCost S P (walkPos ρ om m)} ⊆ E_all := by
    intro om ⟨m_bad, hm_bad_le, hm_bad_gt⟩
    by_contra h_not_mem
    simp only [E_all, Set.mem_union, not_or] at h_not_mem
    rcases h_not_mem with ⟨hnE₀, hnE₁, hnE₂, hnE₃, hnE₄, hnE₅, hnE₆, hnE₇, hnE₈⟩
    have h_ex_2M : ∃ m : ℕ, 2 * M ≤ Finset.univ.sup' Finset.univ_nonempty
        (fun j => sliceHistory S P ρ om j m) := not_not.mp hnE₀
    have h_ex_M : ∃ m : ℕ, M ≤ Finset.univ.sup' Finset.univ_nonempty
        (fun j => sliceHistory S P ρ om j m) := by
      obtain ⟨m, hm⟩ := h_ex_2M
      exact ⟨m, le_trans (by linarith) hm⟩
    have h_ex_H₀ : ∃ m : ℕ, H₀ ≤ Finset.univ.sup' Finset.univ_nonempty
        (fun j => sliceHistory S P ρ om j m) := by
      obtain ⟨m, hm⟩ := h_ex_M
      exact ⟨m, le_trans hH₀_le_M hm⟩
    have h_tau_M_eq : sliceStopTau S P ρ M om = @Nat.find _ (Classical.decPred _) h_ex_M := by
      unfold sliceStopTau
      exact dif_pos h_ex_M
    have h_tau_H₀_eq : sliceStopTau S P ρ H₀ om = @Nat.find _ (Classical.decPred _) h_ex_H₀ := by
      unfold sliceStopTau
      exact dif_pos h_ex_H₀
    have h_tau_M_spec : M ≤ Finset.univ.sup' Finset.univ_nonempty
        (fun j => sliceHistory S P ρ om j (sliceStopTau S P ρ M om)) := by
      rw [h_tau_M_eq]
      exact @Nat.find_spec _ (Classical.decPred _) h_ex_M
    have h_tau_H₀_spec : H₀ ≤ Finset.univ.sup' Finset.univ_nonempty
        (fun j => sliceHistory S P ρ om j (sliceStopTau S P ρ H₀ om)) := by
      rw [h_tau_H₀_eq]
      exact @Nat.find_spec _ (Classical.decPred _) h_ex_H₀
    have h_H₀_le_M_tau : sliceStopTau S P ρ H₀ om ≤ sliceStopTau S P ρ M om := by
      rw [h_tau_H₀_eq]
      exact @Nat.find_min' _ (Classical.decPred _) h_ex_H₀ _ (le_trans hH₀_le_M h_tau_M_spec)
    
    have h_good_2M : ∀ m ≤ sliceStopTau S P ρ (2 * M) om,
        sliceGeomCost S P (walkPos ρ om m) ≤ 2 * M := by
      intro m hm
      have h_le : sliceGeomCost S P (walkPos ρ om m) ≤ (2 * M) ^ σ := by
        by_contra hgt
        exact hnE₁ ⟨m, hm, lt_of_not_ge hgt⟩
      have h_2M_pow : (2 * M) ^ σ ≤ 2 * M := by
        calc
          (2 * M) ^ σ ≤ (2 * M) ^ (1 : ℝ) :=
            Real.rpow_le_rpow_of_exponent_le (by linarith) hσ_lt.le
          _ = 2 * M := Real.rpow_one (2 * M)
      exact le_trans h_le h_2M_pow
    
    have h_clk_sum :
        ∑ l ∈ Finset.range (sliceStopTau S P ρ M om),
          ((slicePhaseDepth S P (walkPos ρ om l))⁻¹ ^ 2 + 1) *
            (ρ (walkPos ρ om l)) ^ 2 ≤ 2 * M ^ 2 := by
      simp only [E₄, Set.mem_union, not_or] at hnE₄
      have h_ph_le : ∑ l ∈ Finset.range (sliceStopTau S P ρ M om),
          (slicePhaseDepth S P (walkPos ρ om l))⁻¹ ^ 2 * (ρ (walkPos ρ om l)) ^ 2 ≤ M ^ 2 := by
        by_contra hgt
        exact hnE₄.1 ⟨h_good_2M, lt_of_not_ge hgt⟩
      have h_phys_le : ∑ l ∈ Finset.range (sliceStopTau S P ρ M om),
          (ρ (walkPos ρ om l)) ^ 2 ≤ M ^ 2 := by
        by_contra hgt
        exact hnE₄.2 (lt_of_not_ge hgt)
      have h_eq_sum :
          ∑ l ∈ Finset.range (sliceStopTau S P ρ M om),
            ((slicePhaseDepth S P (walkPos ρ om l))⁻¹ ^ 2 + 1) * (ρ (walkPos ρ om l)) ^ 2 =
          (∑ l ∈ Finset.range (sliceStopTau S P ρ M om),
            (slicePhaseDepth S P (walkPos ρ om l))⁻¹ ^ 2 * (ρ (walkPos ρ om l)) ^ 2) +
          (∑ l ∈ Finset.range (sliceStopTau S P ρ M om),
            (ρ (walkPos ρ om l)) ^ 2) := by
        rw [← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl fun l _ => ?_
        ring
      linarith
    
    have h_good_M : ∀ m ≤ sliceStopTau S P ρ M om,
        sliceGeomCost S P (walkPos ρ om m) ≤ M ^ σ := by
      intro m hm
      by_contra hgt
      exact hnE₂ ⟨m, hm, lt_of_not_ge hgt⟩
    
    have h_good_H₀ : ∀ m ≤ sliceStopTau S P ρ H₀ om,
        sliceGeomCost S P (walkPos ρ om m) ≤ B_init := by
      intro m hm
      rw [← hH₀_rpow_σ]
      by_contra hgt
      exact hnE₃ ⟨m, hm, lt_of_not_ge hgt⟩
    
    have h_no_ret : ∀ m ≤ sliceStopTau S P ρ M om, ∀ j : Fin P.N,
        sliceHistory S P ρ om j m - 4 * Real.log M ≤ sliceLogDepth S P j (walkPos ρ om m) := by
      intro m hm j
      by_contra hlt
      exact hnE₅ ⟨m, hm, j, lt_of_not_ge hlt⟩
    
    have h_late_sup : ∀ n : ℕ, sliceStopTau S P ρ H₀ om ≤ n → n < sliceStopTau S P ρ M om →
        sliceGeomCost S P (walkPos ρ om n) ≤ M ^ σ ∧
        ∀ j : Fin P.N,
          slicePhaseDepth S P (walkPos ρ om n) *
            ‖deriv (sliceAngleSeq S P.N j.val) (walkPos ρ om n)‖ ≤ η_ang := by
      intro n hn_ge hn_lt
      have hn_le : n ≤ sliceStopTau S P ρ M om := Nat.le_of_lt hn_lt
      refine ⟨h_good_M n hn_le, ?_⟩
      have hy_reg : walkPos ρ om n ∈ horizStrip (sliceHeight S P.N) \ P.Z_all :=
        (hBase.walk_in_reg M ρ hAdmM om n).1
      have hK_sup : H₀ ≤ Finset.univ.sup' Finset.univ_nonempty
          (fun j => sliceHistory S P ρ om j n) := by
        refine le_trans h_tau_H₀_spec (Finset.sup'_le _ _ fun j hj => ?_)
        exact le_trans (hHist_mono ρ om j hn_ge)
          (Finset.le_sup' (fun k => sliceHistory S P ρ om k n) hj)
      refine hDerivSup M hM_sup_le_M (walkPos ρ om n)
        (fun j => sliceHistory S P ρ om j n) hy_reg hK_sup
        (h_good_M n hn_le) (h_no_ret n hn_le) ?_
      intro ν I F hI_ssub hIF_disj hI_hist
      have ht : (ν, I, F).2.1 ⊂ Finset.univ ∧ Disjoint (ν, I, F).2.1 (ν, I, F).2.2 :=
        ⟨hI_ssub, hIF_disj⟩
      have hom_not_t : om ∉ E₆_of (ν, I, F) := fun hmem =>
        hnE₆ (Set.mem_iUnion.mpr ⟨(ν, I, F), hmem⟩)
      dsimp only [E₆_of] at hom_not_t
      rw [dif_pos ht] at hom_not_t
      have h_spec := Classical.choose_spec (hInv.inv_bound M
        (M ^ (bootGapXi P.N σ ν + η / 4))
        (M ^ (bootGapXi P.N σ ν + η / 2))
        ρ hAdmM (hU_ν_ge_one ν) (hU_le_V_ν ν) I F hI_ssub hIF_disj)
      have h_σ_le_U : M ^ σ ≤ M ^ (bootGapXi P.N σ ν + η / 4) := by
        refine Real.rpow_le_rpow_of_exponent_le hM_ge_one ?_
        change σ ≤ σ + ε₀ / 3 + (2 * (ν.val : ℝ) + 1) * η + η / 4
        have h_term_nn : 0 ≤ (2 * (ν.val : ℝ) + 1) * η := by positivity
        linarith
      obtain ⟨B_inv, _hB1, hB2, hB_norm⟩ :=
        h_spec.2.2 om hom_not_t n hn_le
          (fun k hk => le_trans (h_good_M k (le_trans hk hn_le)) h_σ_le_U)
          hI_hist
      exact ⟨B_inv, hB2, hB_norm⟩
    
    have h_late_mart : ∀ m : ℕ, sliceStopTau S P ρ H₀ om ≤ m → m ≤ sliceStopTau S P ρ M om →
        ∀ j : Fin P.N,
          ‖sliceAngleSeq S P.N j.val (walkPos ρ om m) -
            sliceAngleSeq S P.N j.val (walkPos ρ om (sliceStopTau S P ρ H₀ om))‖ ≤ lam ∧
          ‖∑ n ∈ Finset.Ico (sliceStopTau S P ρ H₀ om) m,
            ((bootRunningPosMax S P (walkPos ρ om) n : ℂ)⁻¹ *
              (sliceSupportSeq S P.N j.val (walkPos ρ om (n + 1)) -
                sliceSupportSeq S P.N j.val (walkPos ρ om n)))‖ ≤ lam := by
      by_contra h_not_mart
      exact hnE₇ ⟨h_ex_M, h_clk_sum, h_late_sup, h_not_mart⟩
    
    have h_frozen := hFreeze B_init lam (walkPos ρ om)
      (sliceStopTau S P ρ H₀ om) (sliceStopTau S P ρ M om)
      hB_init_ge_one hlam_pos hlam_le_exp h_H₀_le_M_tau
      (fun m _ => (hBase.walk_in_reg M ρ hAdmM om m).1)
      h_good_H₀
      (fun m hm1 hm2 j => (h_late_mart m hm1 hm2 j).1)
      (fun m hm1 hm2 j => (h_late_mart m hm1 hm2 j).2)
    
    have hB_init_le_B₁ : B_init ≤ B₁ := by
      dsimp only [B_init, B₁]
      exact Real.rpow_le_rpow_of_exponent_le hM_ge_one (by linarith)
    have h_2Clat_B₁_le : 2 * C_lat * B₁ ≤ M ^ σ_new := by
      have h_new_split : M ^ σ_new = M ^ (σ * ε₀ / 2) * B₁ := by
        dsimp only [B₁]
        rw [h_σ_new_eq, add_comm, Real.rpow_add hM_pos]
      have h_2Clat : 2 * C_lat ≤ M ^ (σ * ε₀ / 2) := le_trans (le_max_right _ _) hK_lat_le
      rw [h_new_split]
      exact mul_le_mul_of_nonneg_right h_2Clat hB₁_pos.le
    have h_cost_le : sliceGeomCost S P (walkPos ρ om m_bad) ≤ M ^ σ_new := by
      unfold sliceGeomCost
      refine Finset.sup'_le _ _ fun j _ => ?_
      have h_part1 := (h_frozen m_bad hm_bad_le j).1
      have h_part2 : Real.log ‖P.ℓ_slice j (walkPos ρ om m_bad)‖ ≤ B₀ :=
        (h_frozen m_bad hm_bad_le j).2
      have h_lower_ℓ : -B₁ ≤ Real.log ‖P.ℓ_slice j (walkPos ρ om m_bad)‖ := by
        by_contra hlt
        have hom_j : om ∈ E₈_of j :=
          ⟨m_bad, hm_bad_le,
            fun l hl => (h_frozen l (le_trans (Nat.le_of_lt hl) hm_bad_le) j).2,
            lt_of_not_ge hlt⟩
        exact hnE₈ (Set.mem_iUnion.mpr ⟨j, hom_j⟩)
      have h_abs_ℓ : |Real.log ‖P.ℓ_slice j (walkPos ρ om m_bad)‖| ≤ C_lat * B₁ := by
        rw [abs_le]
        constructor
        · nlinarith
        · dsimp only [B₀] at h_part2
          nlinarith
      have h_sum_le :
          ‖sliceAngleSeq S P.N j.val (walkPos ρ om m_bad)‖ +
            Real.log (1 + ‖slicePosSeq S P.N j.val (walkPos ρ om m_bad)‖) +
            |Real.log ‖Complex.sin (P.d0 j (walkPos ρ om m_bad))‖| +
            |Real.log ‖P.ℓ_slice j (walkPos ρ om m_bad)‖| ≤ 2 * C_lat * B₁ := by
        nlinarith
      exact le_trans h_sum_le h_2Clat_B₁_le
    exact not_lt_of_ge h_cost_le hm_bad_gt
  
  have h_u8 := MeasureTheory.measureReal_union_le (μ := walkMeasure) E₇ E₈
  have h_u7 := MeasureTheory.measureReal_union_le (μ := walkMeasure) E₆ (E₇ ∪ E₈)
  have h_u6 := MeasureTheory.measureReal_union_le (μ := walkMeasure) E₅ (E₆ ∪ (E₇ ∪ E₈))
  have h_u5 := MeasureTheory.measureReal_union_le (μ := walkMeasure) E₄ (E₅ ∪ (E₆ ∪ (E₇ ∪ E₈)))
  have h_u4 := MeasureTheory.measureReal_union_le (μ := walkMeasure) E₃
    (E₄ ∪ (E₅ ∪ (E₆ ∪ (E₇ ∪ E₈))))
  have h_u3 := MeasureTheory.measureReal_union_le (μ := walkMeasure) E₂
    (E₃ ∪ (E₄ ∪ (E₅ ∪ (E₆ ∪ (E₇ ∪ E₈)))))
  have h_u2 := MeasureTheory.measureReal_union_le (μ := walkMeasure) E₁
    (E₂ ∪ (E₃ ∪ (E₄ ∪ (E₅ ∪ (E₆ ∪ (E₇ ∪ E₈))))))
  have h_u1 := MeasureTheory.measureReal_union_le (μ := walkMeasure) E₀
    (E₁ ∪ (E₂ ∪ (E₃ ∪ (E₄ ∪ (E₅ ∪ (E₆ ∪ (E₇ ∪ E₈)))))))
  have h_mono : walkMeasure.real {om : WalkSpace | ∃ m ≤ sliceStopTau S P ρ M om,
      M ^ ((σ + σ ^ 2) / 2) < sliceGeomCost S P (walkPos ρ om m)} ≤
    walkMeasure.real (E₀ ∪ (E₁ ∪ (E₂ ∪ (E₃ ∪ (E₄ ∪ (E₅ ∪ (E₆ ∪ (E₇ ∪ E₈)))))))) :=
    MeasureTheory.measureReal_mono h_target_sub (MeasureTheory.measure_ne_top walkMeasure _)
  linarith

theorem odd_slice_stopped_geometry_all_powers (S : FiniteWallNonisotropicStrip)
    (hBudget : CriticalAngleBudgetData S)
    (P : OddPeriodicSliceData S) :
    Nonempty (StoppedSliceGeometryData S P) :=
by
  have hProbUnif : MeasureTheory.IsProbabilityMeasure unifTwoPiMeasure := by
    refine ⟨?_⟩
    simp only [unifTwoPiMeasure, MeasureTheory.Measure.smul_apply,
      MeasureTheory.Measure.restrict_apply_univ, smul_eq_mul, Real.volume_Ico, sub_zero]
    exact ENNReal.inv_mul_cancel
      (ENNReal.ofReal_pos.mpr Real.two_pi_pos).ne' ENNReal.ofReal_ne_top
  have hProbWalk : MeasureTheory.IsProbabilityMeasure walkMeasure := by
    dsimp only [walkMeasure]
    infer_instance
  have hAdmMono : ∀ {M₁ M₂ : ℝ} {ρ : ℂ → ℝ}, 2 ≤ M₁ → M₁ ≤ M₂ →
      IsScaleAdmissibleStep S P M₂ ρ → IsScaleAdmissibleStep S P M₁ ρ := by
    intro M₁ M₂ ρ hM₁ hM₁₂ h₂
    have h_sq : Real.exp (-M₂ ^ 2) ≤ Real.exp (-M₁ ^ 2) :=
      Real.exp_le_exp.mpr (neg_le_neg (pow_le_pow_left₀ (by linarith) hM₁₂ 2))
    have h_cube : Real.exp (-M₂ ^ 3) ≤ Real.exp (-M₁ ^ 3) :=
      Real.exp_le_exp.mpr (neg_le_neg (pow_le_pow_left₀ (by linarith) hM₁₂ 3))
    refine
      { scale_ge_two := hM₁
        measurable := h₂.measurable
        periodic := h₂.periodic
        cont_on := h₂.cont_on
        nonneg := h₂.nonneg
        pos_iff := h₂.pos_iff
        le_sing_dist := h₂.le_sing_dist
        small_shape_step := ?_
        jump_log_speed := h₂.jump_log_speed
        jump_log_sin_d0 := h₂.jump_log_sin_d0
        jump_log_chord := h₂.jump_log_chord
        jump_angle := h₂.jump_angle
        jump_pos := h₂.jump_pos
        taylor_impact := ?_
        taylor_angle := ?_
        taylor_pos₀ := ?_
        taylor_pos₁ := ?_
        taylor_support := ?_ }
    · intro y hy z hz j
      have h_step := h₂.small_shape_step y hy z hz j
      have h_depth_nonneg : 0 ≤ sliceShapeDepth S P j y := by
        have h_prod : 0 ≤ Real.exp (-M₂ ^ 2) * sliceShapeDepth S P j y :=
          le_trans (norm_nonneg _) h_step
        exact nonneg_of_mul_nonneg_right h_prod (Real.exp_pos _)
      exact le_trans h_step (mul_le_mul_of_nonneg_right h_sq h_depth_nonneg)
    · intro y hy z hz j
      refine le_trans (h₂.taylor_impact y hy z hz j) ?_
      have hρ : 0 ≤ ρ y := h₂.nonneg y
      nlinarith
    · intro y hy z hz j
      refine le_trans (h₂.taylor_angle y hy z hz j) ?_
      have hρ : 0 ≤ ρ y := h₂.nonneg y
      nlinarith
    · intro y hy z hz j
      refine le_trans (h₂.taylor_pos₀ y hy z hz j) ?_
      have hρ : 0 ≤ ρ y := h₂.nonneg y
      nlinarith
    · intro y hy z hz j
      refine le_trans (h₂.taylor_pos₁ y hy z hz j) ?_
      have hρ : 0 ≤ ρ y := h₂.nonneg y
      nlinarith
    · intro y hy z hz j
      refine le_trans (h₂.taylor_support y hy z hz j) ?_
      have hρ : 0 ≤ ρ y := h₂.nonneg y
      have hX : 0 ≤ 1 + ‖slicePosSeq S P.N j.val y‖ := by positivity
      exact mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_left h_cube (by positivity)) hρ
  obtain ⟨hMeas, hAdmL2, C_clk, hBase⟩ := adaptive_walk_step_and_stopping S P
  obtain ⟨hRet, C_hit, C_rem, hSliceBounds⟩ := slice_hitting_and_clock_bounds S P
  obtain ⟨hLogDef, C_inv, hInv⟩ := modified_jacobi_inverse_martingale_bound S hBudget P
  obtain ⟨σ₀, hσ₀_pos, hσ₀_lt, hPow₀⟩ :=
    initial_sublinear_stopped_geometry S hBudget P C_clk hBase hLogDef
  have hStep :=
    stopped_geometry_exponent_bootstrap S hBudget P C_clk C_inv hBase hRet hLogDef hInv
  have hAdmL : ∀ L : ℝ, 2 ≤ L → IsScaleAdmissibleStep S P L (adaptiveStepRadius S P L) := by
    intro L hL
    exact hAdmMono hL (by nlinarith) (hAdmL2 L hL)
  let σ_seq : ℕ → ℝ := fun n =>
    Nat.rec σ₀ (fun _ s => (s + s ^ 2) / 2) n
  have h_iter : ∀ n : ℕ,
      0 < σ_seq n ∧
      σ_seq n < 1 ∧
      σ_seq n ≤ ((1 + σ₀) / 2) ^ n * σ₀ ∧
      HasUniformPowerGeometry S P (σ_seq n) := by
    intro n
    induction n with
    | zero =>
        refine ⟨hσ₀_pos, hσ₀_lt, ?_, hPow₀⟩
        simp [σ_seq]
    | succ n ih =>
        rcases ih with ⟨h_pos, h_lt, h_le, h_pow⟩
        have h_next_eq : σ_seq (n + 1) = (σ_seq n + (σ_seq n) ^ 2) / 2 := rfl
        have h_next_pos : 0 < σ_seq (n + 1) := by
          rw [h_next_eq]
          nlinarith
        have h_next_lt : σ_seq (n + 1) < 1 := by
          rw [h_next_eq]
          nlinarith
        have h_pow_le_one : ((1 + σ₀) / 2) ^ n ≤ 1 :=
          pow_le_one₀ (by linarith) (by linarith)
        have h_le_σ₀ : σ_seq n ≤ σ₀ := by
          nlinarith
        have h_next_le : σ_seq (n + 1) ≤ ((1 + σ₀) / 2) ^ (n + 1) * σ₀ := by
          calc
            σ_seq (n + 1) = (σ_seq n + (σ_seq n) ^ 2) / 2 := h_next_eq
            _ ≤ ((1 + σ₀) / 2) * σ_seq n := by nlinarith
            _ ≤ ((1 + σ₀) / 2) * (((1 + σ₀) / 2) ^ n * σ₀) :=
              mul_le_mul_of_nonneg_left h_le (by linarith)
            _ = ((1 + σ₀) / 2) ^ (n + 1) * σ₀ := by ring
        exact ⟨h_next_pos, h_next_lt, h_next_le, hStep (σ_seq n) h_pos h_lt h_pow⟩
  refine ⟨{
    stepRadius := adaptiveStepRadius S P
    L_min := 2
    C_inv := C_inv
    C_hit := C_hit
    C_clk := C_clk
    C_rem := C_rem
    L_min_ge_two := le_rfl
    C_inv_pos := hInv.C_inv_pos
    C_hit_pos := hSliceBounds.C_hit_pos
    C_clk_pos := hBase.C_clk_pos
    C_rem_pos := hSliceBounds.C_rem_pos
    stepRadius_measurable := hMeas
    walk_in_reg_domain := fun L hL om m =>
      hBase.walk_in_reg L (adaptiveStepRadius S P L) (hAdmL L hL) om m
    walk_small_step := ?_
    walk_stops_ae := fun L hL =>
      hBase.walk_stops L (adaptiveStepRadius S P L) (hAdmL L hL)
    walk_clock_bound := fun L hL =>
      hBase.walk_clock L (adaptiveStepRadius S P L) (hAdmL L hL)
    all_power_geometry := ?_
    modified_inverse_bound := fun L U V hL hU hUV I F hI hIF =>
      hInv.inv_bound L U V (adaptiveStepRadius S P L) (hAdmL L hL) hU hUV I F hI hIF
    first_hit_interval_domination := fun L d r_int j E hL hd0 hdH hr hEm hEp =>
      hSliceBounds.first_hit_dom L d r_int (adaptiveStepRadius S P L) j E
        (hAdmL L hL) hd0 hdH hr hEm hEp
    remaining_clock_tail := fun L d B j hL hd0 hdH hB hdB =>
      hSliceBounds.rem_clock_tail L d B (adaptiveStepRadius S P L) j
        (hAdmL L hL) hd0 hdH hB hdB
    stopped_displacement_bound := fun L d r_exit q_K J hJ i hL hi hd0 hdH hr hq =>
      hSliceBounds.stopped_disp L d r_exit q_K (adaptiveStepRadius S P L) J hJ i
        (hAdmL L hL) hi hd0 hdH hr hq
  }⟩
  · intro L hL om m _hm j
    have hAdm := hAdmL L hL
    have hy : walkPos (adaptiveStepRadius S P L) om m ∈
        horizStrip (sliceHeight S P.N) \ P.Z_all :=
      (hBase.walk_in_reg L (adaptiveStepRadius S P L) hAdm om m).1
    have hρ_nonneg : 0 ≤ adaptiveStepRadius S P L (walkPos (adaptiveStepRadius S P L) om m) :=
      hAdm.nonneg _
    let z : ℂ :=
      (adaptiveStepRadius S P L (walkPos (adaptiveStepRadius S P L) om m) : ℂ) *
        Complex.exp ((om (m + 1) : ℂ) * Complex.I)
    have hz : ‖z‖ ≤ adaptiveStepRadius S P L (walkPos (adaptiveStepRadius S P L) om m) := by
      simp only [z, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hρ_nonneg,
        Complex.norm_exp_ofReal_mul_I, mul_one, le_rfl]
    simpa only [walkPos, z] using hAdm.small_shape_step _ hy z hz j
  · intro σ δ hσ hδ
    obtain ⟨n, hn⟩ :=
      exists_pow_lt_of_lt_one (div_pos hσ hσ₀_pos) (by linarith : (1 + σ₀) / 2 < 1)
    have h_mul_lt : ((1 + σ₀) / 2) ^ n * σ₀ < σ :=
      (lt_div_iff₀ hσ₀_pos).mp hn
    rcases h_iter n with ⟨_, _, h_le_n, A_cap, _hA_ge, hPow_n⟩
    have hσ_le : σ_seq n ≤ σ := le_trans h_le_n (le_of_lt h_mul_lt)
    obtain ⟨M₀, _hM₀_ge, hM₀⟩ := hPow_n δ hδ
    refine ⟨max (max 2 M₀) A_cap, le_trans (le_max_left 2 M₀) (le_max_left _ _), ?_⟩
    intro L hL₁
    have hL_ge_two : 2 ≤ L :=
      le_trans (le_trans (le_max_left 2 M₀) (le_max_left _ _)) hL₁
    have hM₀_le_L : M₀ ≤ L :=
      le_trans (le_trans (le_max_right 2 M₀) (le_max_left _ _)) hL₁
    have hA_le_L : A_cap ≤ L :=
      le_trans (le_max_right _ _) hL₁
    have hL_ge_one : 1 ≤ L := by linarith
    have hA_mul_L : A_cap * L ≤ L ^ 2 := by nlinarith
    have h_rpow : L ^ (σ_seq n) ≤ L ^ σ :=
      Real.rpow_le_rpow_of_exponent_le hL_ge_one hσ_le
    have h_sub :
        {om : WalkSpace |
          ∃ m ≤ sliceStopTau S P (adaptiveStepRadius S P L) L om,
            L ^ σ < sliceGeomCost S P (walkPos (adaptiveStepRadius S P L) om m)} ⊆
        {om : WalkSpace |
          ∃ m ≤ sliceStopTau S P (adaptiveStepRadius S P L) L om,
            L ^ (σ_seq n) < sliceGeomCost S P (walkPos (adaptiveStepRadius S P L) om m)} := by
      intro om ⟨m, hm, hgt⟩
      exact ⟨m, hm, lt_of_le_of_lt h_rpow hgt⟩
    exact le_trans (MeasureTheory.measureReal_mono h_sub)
      (hM₀ L (L ^ 2) hM₀_le_L hA_mul_L (adaptiveStepRadius S P L) (hAdmL2 L hL_ge_two))

theorem odd_slice_last_site_contradiction (S : FiniteWallNonisotropicStrip)
    (hBudget : CriticalAngleBudgetData S)
    (P : OddPeriodicSliceData S)
    (G : StoppedSliceGeometryData S P)
    (hRobust : ∀ ε : ℝ, 0 < ε →
      ∃ K₀ : ℝ, hBudget.k₀ ≤ K₀ ∧
        ∀ K : ℝ, K₀ ≤ K →
          ∃ k ∈ Set.Icc ((4 / 5 : ℝ) * K) ((11 / 5 : ℝ) * K),
            MeasureTheory.volume.real
              {x ∈ Set.Icc (0 : ℝ) (2 * Real.pi) | ¬ HasRobustSignDisk S K k x} ≤ ε) :
    False :=
by
  have hN_pos : (0 : ℝ) < (P.N : ℝ) := by
    exact_mod_cast lt_of_lt_of_le (by decide : 0 < 3) P.N_ge_three
  have ht0_pos : 0 < sliceParamT0 P.N := div_pos Real.two_pi_pos hN_pos
  have ht0_norm : ‖(sliceParamT0 P.N : ℂ)‖ < S.r_star := by
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos ht0_pos]
    exact P.t₀_lt_r_star
  have h_tube : ∀ y ∈ horizStrip (sliceHeight S P.N), ∀ j : ℤ,
      (y + (j : ℂ) * (sliceParamT0 P.N : ℂ), (sliceParamT0 P.N : ℂ)) ∈
        finiteWallTube S.r_star S.h_X := by
    intro y hy j
    have hy_im : |y.im| < S.h_X (sliceParamT0 P.N : ℂ) := hy
    rw [abs_lt] at hy_im
    have him_eq : (y + (j : ℂ) * (sliceParamT0 P.N : ℂ)).im = y.im := by
      simp [Complex.add_im, Complex.mul_im]
    refine ⟨ht0_norm, ?_, ?_⟩
    · rw [Complex.conj_ofReal, him_eq]; exact hy_im.1
    · rw [him_eq]; exact hy_im.2
  have h_depth_lipschitz : ∀ j : Fin P.N, ∀ y z : ℂ,
      sliceShapeDepth S P j z - sliceShapeDepth S P j y ≤
        ‖sliceImpactSeq S P.N j.val y - sliceImpactSeq S P.N j.val z‖ := by
    intro j y z
    unfold sliceShapeDepth
    have h1 : |(sliceImpactSeq S P.N j.val y).im| - |(sliceImpactSeq S P.N j.val z).im| ≤
        |(sliceImpactSeq S P.N j.val y - sliceImpactSeq S P.N j.val z).im| := by
      simpa [Complex.sub_im] using
        abs_sub_abs_le_abs_sub (sliceImpactSeq S P.N j.val y).im (sliceImpactSeq S P.N j.val z).im
    have h2 := Complex.abs_im_le_norm (sliceImpactSeq S P.N j.val y - sliceImpactSeq S P.N j.val z)
    linarith
  have h_real_start_depth : ∀ (ρ : ℂ → ℝ) (om : WalkSpace) (j : Fin P.N),
      S.H - S.s_star < sliceShapeDepth S P j (walkPos ρ om 0) := by
    intro ρ om j
    unfold sliceShapeDepth sliceImpactSeq walkPos
    let z0 : ℂ := (om 0 : ℂ) + ((j.val : ℤ) : ℂ) * (sliceParamT0 P.N : ℂ)
    have hz0_im : |z0.im| < S.s_star / 2 := by
      have : z0.im = 0 := by simp [z0, Complex.add_im, Complex.mul_im]
      rw [this, abs_zero]
      linarith [S.s_star_pos]
    have h_abs : |(S.𝔰 (z0, (sliceParamT0 P.N : ℂ))).im| < S.s_star :=
      S.𝔰_lower_strip_im z0 (sliceParamT0 P.N : ℂ) hz0_im ht0_norm
    change S.H - |(S.𝔰 (z0, (sliceParamT0 P.N : ℂ))).im| > S.H - S.s_star
    linarith
  
  have hProb : MeasureTheory.IsProbabilityMeasure walkMeasure := by
    have : MeasureTheory.IsProbabilityMeasure unifTwoPiMeasure := by
      refine ⟨?_⟩
      unfold unifTwoPiMeasure
      rw [MeasureTheory.Measure.smul_apply, MeasureTheory.Measure.restrict_apply_univ,
        Real.volume_Ico, sub_zero, smul_eq_mul]
      exact ENNReal.inv_mul_cancel
        (ne_of_gt (ENNReal.ofReal_pos.mpr Real.two_pi_pos))
        ENNReal.ofReal_ne_top
    unfold walkMeasure
    infer_instance
  have hFinMeas : MeasureTheory.IsFiniteMeasure walkMeasure := inferInstance
  have h_walk_ne_top : ∀ A : Set WalkSpace, walkMeasure A ≠ ⊤ :=
    fun A => MeasureTheory.measure_ne_top walkMeasure A
  have hClk : ∀ L : ℝ, G.L_min ≤ L →
      walkMeasure.real {om : WalkSpace |
        100 * G.C_clk < ∑ m ∈ Finset.range (sliceStopTau S P (G.stepRadius L) L om),
          (G.stepRadius L (walkPos (G.stepRadius L) om m)) ^ 2} ≤ 1 / 100 := by
    intro L hL
    obtain ⟨hInt, hInt_le⟩ := G.walk_clock_bound L hL
    have h_nn : 0 ≤ᵐ[walkMeasure] fun om : WalkSpace =>
        ∑ m ∈ Finset.range (sliceStopTau S P (G.stepRadius L) L om),
          (G.stepRadius L (walkPos (G.stepRadius L) om m)) ^ 2 :=
      Filter.Eventually.of_forall fun om => Finset.sum_nonneg fun _ _ => sq_nonneg _
    have h_mk := MeasureTheory.mul_meas_ge_le_integral_of_nonneg h_nn hInt (100 * G.C_clk)
    have h_ge_le : walkMeasure.real {om : WalkSpace |
        100 * G.C_clk ≤ ∑ m ∈ Finset.range (sliceStopTau S P (G.stepRadius L) L om),
          (G.stepRadius L (walkPos (G.stepRadius L) om m)) ^ 2} ≤ 1 / 100 := by
      have hC := G.C_clk_pos
      nlinarith
    have h_sub_clk : {om : WalkSpace |
        100 * G.C_clk < ∑ m ∈ Finset.range (sliceStopTau S P (G.stepRadius L) L om),
          (G.stepRadius L (walkPos (G.stepRadius L) om m)) ^ 2} ⊆
        {om : WalkSpace |
        100 * G.C_clk ≤ ∑ m ∈ Finset.range (sliceStopTau S P (G.stepRadius L) L om),
          (G.stepRadius L (walkPos (G.stepRadius L) om m)) ^ 2} := by
      intro om hom
      exact le_of_lt (show 100 * G.C_clk < _ from hom)
    exact le_trans (MeasureTheory.measureReal_mono h_sub_clk (h_walk_ne_top _)) h_ge_le
  have hMenu : ∀ K_min : ℝ, ∃ L_gap : ℝ, G.L_min ≤ L_gap ∧
      ∀ L : ℝ, L_gap ≤ L →
        ∃ γ : ℝ,
          ((1000 : ℝ) ^ (10 * P.N + 1))⁻¹ ≤ γ ∧
          γ ≤ (1 / 1000 : ℝ) ∧
          K_min ≤ L ^ γ ∧
          3 * L ^ γ < L ∧
          walkMeasure.real {om : WalkSpace |
            ¬ ((∃ m : ℕ, L ≤ Finset.univ.sup' Finset.univ_nonempty
                  (fun j => sliceHistory S P (G.stepRadius L) om j m)) ∧
                (∀ j : Fin P.N,
                  sliceHistory S P (G.stepRadius L) om j
                      (sliceStopTau S P (G.stepRadius L) L om) ≤ (L ^ γ) ^ (1 / 800 : ℝ) ∨
                    3 * L ^ γ ≤
                      sliceHistory S P (G.stepRadius L) om j
                        (sliceStopTau S P (G.stepRadius L) L om)))} ≤ 1 / 10 := by
    intro K_min
    let M : ℕ := 10 * P.N + 1
    have hM_pos : 0 < M := Nat.succ_pos _
    have : NeZero M := ⟨ne_of_gt hM_pos⟩
    let γ₀ : ℝ := ((1000 : ℝ) ^ M)⁻¹
    have hγ₀_pos : 0 < γ₀ := by positivity
    let C₀ : ℝ := max K_min 8
    refine ⟨max G.L_min (Real.exp (C₀ / γ₀)), le_max_left _ _, ?_⟩
    intro L hL_gap
    have hL_min : G.L_min ≤ L := le_trans (le_max_left _ _) hL_gap
    have hL_ge_two : 2 ≤ L := le_trans G.L_min_ge_two hL_min
    have hL_pos : 0 < L := by linarith
    have hL_exp : Real.exp (C₀ / γ₀) ≤ L := le_trans (le_max_right _ _) hL_gap
    have hlogL : C₀ / γ₀ ≤ Real.log L := (Real.le_log_iff_exp_le hL_pos).mpr hL_exp
    have hC₀_ge_eight : 8 ≤ C₀ := le_max_right _ _
    have h_sup'_meas : ∀ {α : Type} (A : Finset α) (hA : A.Nonempty) (f : α → WalkSpace → ℝ),
        (∀ a ∈ A, Measurable (f a)) →
        Measurable (fun om => A.sup' hA (fun a => f a om)) := by
      intro α A hA
      induction hA using Finset.Nonempty.cons_induction with
      | singleton a =>
        intro f hf
        simp only [Finset.sup'_singleton]
        exact hf a (Finset.mem_singleton_self a)
      | cons a s ha hs ih =>
        intro f hf
        simp only [Finset.sup'_cons hs]
        exact (hf a (Finset.mem_cons_self a s)).sup
          (ih f fun b hb => hf b (Finset.mem_cons.mpr (Or.inr hb)))
    let ρ := G.stepRadius L
    have h_walk_meas : ∀ n : ℕ, Measurable (fun om : WalkSpace => walkPos ρ om n) := by
      intro n
      induction n with
      | zero =>
        unfold walkPos
        exact Complex.measurable_ofReal.comp (measurable_pi_apply 0)
      | succ n ih =>
        unfold walkPos
        exact ih.add ((Complex.measurable_ofReal.comp ((G.stepRadius_measurable L).comp ih)).mul
          (Complex.continuous_exp.measurable.comp
            ((Complex.measurable_ofReal.comp (measurable_pi_apply (n + 1))).mul measurable_const)))
    have h_impact_meas : ∀ (j : Fin P.N) (n : ℕ),
        Measurable (fun om : WalkSpace => sliceImpactSeq S P.N j.val (walkPos ρ om n)) := by
      intro j n
      let U : Set ℂ := horizStrip (sliceHeight S P.N)
      have h_cont_on : ContinuousOn (sliceImpactSeq S P.N j.val) U := by
        unfold sliceImpactSeq
        refine S.𝔰_holo.continuousOn.comp
          ((continuous_id.add continuous_const).prodMk continuous_const).continuousOn ?_
        intro y hy
        exact h_tube y hy j.val
      have h_dom_cont : Continuous (U.domRestrict (sliceImpactSeq S P.N j.val)) :=
        continuousOn_iff_continuous_domRestrict.mp h_cont_on
      have h_sub_meas : Measurable (fun om : WalkSpace =>
          (⟨walkPos ρ om n, (G.walk_in_reg_domain L hL_min om n).1.1⟩ : U)) :=
        Measurable.subtype_mk (h_walk_meas n)
      exact h_dom_cont.measurable.comp h_sub_meas
    have h_hist_meas : ∀ (j : Fin P.N) (m : ℕ),
        Measurable (fun om : WalkSpace => sliceHistory S P ρ om j m) := by
      intro j m
      unfold sliceHistory
      refine h_sup'_meas (Finset.range (m + 1)) _
        (fun n om => sliceLogDepth S P j (walkPos ρ om n)) fun n _ => ?_
      unfold sliceLogDepth sliceShapeDepth
      exact (Real.measurable_log.comp
        (measurable_const.sub (continuous_abs.measurable.comp
          (Complex.continuous_im.measurable.comp (h_impact_meas j n))))).neg
    let H_fn : ℕ → WalkSpace → ℝ := fun m om =>
      Finset.univ.sup' Finset.univ_nonempty (fun j => sliceHistory S P ρ om j m)
    have hH_meas : ∀ m : ℕ, Measurable (H_fn m) := fun m =>
      h_sup'_meas Finset.univ Finset.univ_nonempty
        (fun j om => sliceHistory S P ρ om j m) fun j _ => h_hist_meas j m
    let A_set : ℕ → Set WalkSpace := fun m => {om | L ≤ H_fn m om}
    have hA_meas : ∀ m : ℕ, MeasurableSet (A_set m) := fun m =>
      measurableSet_Ici.preimage (hH_meas m)
    let τ_fn : WalkSpace → ℕ := sliceStopTau S P ρ L
    have hτ_level_meas : ∀ k : ℕ, MeasurableSet {om : WalkSpace | τ_fn om = k} := by
      intro k
      cases k with
      | zero =>
        have h_eq : {om : WalkSpace | τ_fn om = 0} = A_set 0 ∪ (⋃ m : ℕ, A_set m)ᶜ := by
          ext om
          simp only [Set.mem_union, Set.mem_compl_iff, Set.mem_iUnion, not_exists]
          change sliceStopTau S P ρ L om = 0 ↔ L ≤ H_fn 0 om ∨ ∀ x : ℕ, ¬ L ≤ H_fn x om
          unfold sliceStopTau
          split_ifs with h
          · constructor
            · intro h0
              exact Or.inl ((@Nat.find_eq_zero _ (Classical.decPred _) h).mp h0)
            · rintro (h0 | hall)
              · exact (@Nat.find_eq_zero _ (Classical.decPred _) h).mpr h0
              · obtain ⟨x, hx⟩ := h
                exact absurd hx (hall x)
          · constructor
            · intro _
              exact Or.inr fun x hx => h ⟨x, hx⟩
            · intro _
              rfl
        rw [h_eq]
        exact (hA_meas 0).union (MeasurableSet.iUnion hA_meas).compl
      | succ k =>
        have h_eq : {om : WalkSpace | τ_fn om = k + 1} =
            A_set (k + 1) ∩ ⋂ m ∈ Finset.range (k + 1), (A_set m)ᶜ := by
          ext om
          simp only [Set.mem_inter_iff, Set.mem_iInter, Set.mem_compl_iff, Finset.mem_range]
          change sliceStopTau S P ρ L om = k + 1 ↔
            L ≤ H_fn (k + 1) om ∧ ∀ m < k + 1, ¬ L ≤ H_fn m om
          unfold sliceStopTau
          split_ifs with h
          · exact @Nat.find_eq_iff (k + 1) _ (Classical.decPred _) h
          · constructor
            · intro h0
              cases h0
            · rintro ⟨hk1, _⟩
              exact absurd ⟨k + 1, hk1⟩ h
        rw [h_eq]
        exact (hA_meas (k + 1)).inter
          (Finset.measurableSet_biInter _ fun m _ => (hA_meas m).compl)
    let K_term : Fin P.N → WalkSpace → ℝ := fun j om => sliceHistory S P ρ om j (τ_fn om)
    have hK_term_preimage : ∀ (j : Fin P.N) (I_set : Set ℝ), MeasurableSet I_set →
        MeasurableSet {om : WalkSpace | K_term j om ∈ I_set} := by
      intro j I_set hI
      have h_eq : {om : WalkSpace | K_term j om ∈ I_set} =
          ⋃ k : ℕ, ({om : WalkSpace | τ_fn om = k} ∩
            {om : WalkSpace | sliceHistory S P ρ om j k ∈ I_set}) := by
        ext om
        simp only [Set.mem_ofPred_eq, Set.mem_iUnion, Set.mem_inter_iff, K_term]
        exact ⟨fun hm => ⟨τ_fn om, rfl, hm⟩, fun ⟨k, hk, hm⟩ => hk ▸ hm⟩
      rw [h_eq]
      exact MeasurableSet.iUnion fun k => (hτ_level_meas k).inter (hI.preimage (h_hist_meas j k))
    let γ_menu : Fin M → ℝ := fun m => ((1000 : ℝ) ^ (M - m.val))⁻¹
    have hγ_bounds : ∀ m : Fin M, γ₀ ≤ γ_menu m ∧ γ_menu m ≤ 1 / 1000 := by
      intro m
      have hm1 : 1 ≤ M - m.val := Nat.le_sub_of_add_le' m.isLt
      have hm2 : M - m.val ≤ M := Nat.sub_le M m.val
      have hp1 : (1000 : ℝ) ^ 1 ≤ (1000 : ℝ) ^ (M - m.val) :=
        pow_le_pow_right₀ (by norm_num) hm1
      have hp2 : (1000 : ℝ) ^ (M - m.val) ≤ (1000 : ℝ) ^ M :=
        pow_le_pow_right₀ (by norm_num) hm2
      constructor
      · exact inv_anti₀ (by positivity) hp2
      · have : ((1000 : ℝ) ^ (M - m.val))⁻¹ ≤ ((1000 : ℝ) ^ 1)⁻¹ :=
          inv_anti₀ (by positivity) hp1
        linarith
    have hγ_step : ∀ m₁ m₂ : Fin M, m₁.val < m₂.val → 1000 * γ_menu m₁ ≤ γ_menu m₂ := by
      intro m₁ m₂ hlt
      have hexp : (M - m₂.val) + 1 ≤ M - m₁.val := by omega
      have hp : (1000 : ℝ) ^ (M - m₂.val) * 1000 ≤ (1000 : ℝ) ^ (M - m₁.val) := by
        calc (1000 : ℝ) ^ (M - m₂.val) * 1000
            = (1000 : ℝ) ^ ((M - m₂.val) + 1) := by ring
          _ ≤ (1000 : ℝ) ^ (M - m₁.val) := pow_le_pow_right₀ (by norm_num) hexp
      have hpos2 : 0 < (1000 : ℝ) ^ (M - m₂.val) := by positivity
      dsimp only [γ_menu]
      calc 1000 * ((1000 : ℝ) ^ (M - m₁.val))⁻¹
          ≤ 1000 * ((1000 : ℝ) ^ (M - m₂.val) * 1000)⁻¹ :=
            mul_le_mul_of_nonneg_left (inv_anti₀ (by positivity) hp) (by norm_num)
        _ = ((1000 : ℝ) ^ (M - m₂.val))⁻¹ := by
            field_simp [ne_of_gt hpos2]
    have hlogL_ge : 8 / γ₀ ≤ Real.log L := by
      have : 8 / γ₀ ≤ C₀ / γ₀ := div_le_div_of_nonneg_right hC₀_ge_eight (le_of_lt hγ₀_pos)
      linarith
    have h_three_le_exp2 : (3 : ℝ) ≤ Real.exp 2 := by
      linarith [Real.add_one_le_exp 2]
    have h_Kmin_le : ∀ m : Fin M, K_min ≤ L ^ (γ_menu m) := by
      intro m
      rw [Real.rpow_def_of_pos hL_pos]
      have h1 : C₀ ≤ Real.log L * γ_menu m := by
        have hγm := (hγ_bounds m).1
        have hmul : (C₀ / γ₀) * γ₀ ≤ Real.log L * γ_menu m :=
          mul_le_mul hlogL hγm (le_of_lt hγ₀_pos)
