      have harg : (θ_m + θ_0) / 2 - θ_0 = -((θ_0 - θ_m) / 2) := by ring
      rw [harg, Complex.cos_neg, Complex.sin_neg]
      have h_eq2 : C.h_ℂ ((θ_m + θ_0) / 2) * Complex.cos ((θ_0 - θ_m) / 2) -
          deriv C.h_ℂ ((θ_m + θ_0) / 2) * -Complex.sin ((θ_0 - θ_m) / 2) =
          supportAction2_ℂ C.h_ℂ θ_m θ_0 := by
        unfold supportAction2_ℂ; ring
      rw [h_eq2]
      exact hstat.symm
    · simp only [glancingImpact, Matrix.cons_val_zero, Matrix.cons_val_one, hμ_p]
      rw [h_trig_ℂ]
      have harg : (θ_0 + θ_p) / 2 - θ_0 = (θ_p - θ_0) / 2 := by ring
      rw [harg]
      unfold glancingOffset supportAction1_ℂ
      ring
  have hCramer : ∀ y t : ℂ, |y.im| < s_det + r_det → ‖t‖ < r_det →
      let P_minus := glancingImpact C (y - t / 2) t
      let P_plus := glancingImpact C (y + t / 2) t
      let Λ := glancingDualLine C y t
      let Δ := P_minus 0 * P_plus 1 - P_minus 1 * P_plus 0
      (P_minus 0 * Λ 0 + P_minus 1 * Λ 1 = 1 ∧ P_plus 0 * Λ 0 + P_plus 1 * Λ 1 = 1) ∧
      (Δ * Λ 0 = P_plus 1 - P_minus 1 ∧ Δ * Λ 1 = P_minus 0 - P_plus 0) := by
    intro y t hy ht
    dsimp only
    set P_minus := glancingImpact C (y - t / 2) t
    set P_plus := glancingImpact C (y + t / 2) t
    set Λ := glancingDualLine C y t
    set Δ := P_minus 0 * P_plus 1 - P_minus 1 * P_plus 0
    have hp_off : glancingOffset C y t ≠ 0 := hoff_ne_zero y t (by linarith) (by linarith)
    obtain ⟨hpm, hpp⟩ := hProj y t hy ht
    have hm1 : P_minus 0 * Λ 0 + P_minus 1 * Λ 1 = 1 := by
      simp only [Λ, glancingDualLine, Matrix.cons_val_zero, Matrix.cons_val_one]
      rw [← mul_div_assoc, ← mul_div_assoc, ← add_div, hpm, div_self hp_off]
    have hp1 : P_plus 0 * Λ 0 + P_plus 1 * Λ 1 = 1 := by
      simp only [Λ, glancingDualLine, Matrix.cons_val_zero, Matrix.cons_val_one]
      rw [← mul_div_assoc, ← mul_div_assoc, ← add_div, hpp, div_self hp_off]
    refine ⟨⟨hm1, hp1⟩, ?_, ?_⟩
    · linear_combination P_plus 1 * hm1 - P_minus 1 * hp1
    · linear_combination P_minus 0 * hp1 - P_plus 0 * hm1
  have hRealChord : ∀ x t : ℝ, 0 < t → t < r_det →
      0 < (glancingOffset C (x : ℂ) (t : ℂ)).re ∧
      (glancingOffset C (x : ℂ) (t : ℂ)).im = 0 ∧
      0 < (glancingImpact C ((x : ℂ) - (t : ℂ) / 2) (t : ℂ) 0 *
            glancingImpact C ((x : ℂ) + (t : ℂ) / 2) (t : ℂ) 1 -
          glancingImpact C ((x : ℂ) - (t : ℂ) / 2) (t : ℂ) 1 *
            glancingImpact C ((x : ℂ) + (t : ℂ) / 2) (t : ℂ) 0).re ∧
      (glancingImpact C ((x : ℂ) - (t : ℂ) / 2) (t : ℂ) 0 *
        glancingImpact C ((x : ℂ) + (t : ℂ) / 2) (t : ℂ) 1 -
      glancingImpact C ((x : ℂ) - (t : ℂ) / 2) (t : ℂ) 1 *
        glancingImpact C ((x : ℂ) + (t : ℂ) / 2) (t : ℂ) 0).im = 0 := by
    have hderiv_h_real : ∀ μ : ℝ, deriv C.h_ℂ (μ : ℂ) = ((deriv C.h μ : ℝ) : ℂ) := by
      intro μ
      have hμ_mem : (μ : ℂ) ∈ horizStrip (2 * C.s_h) := by
        change |((μ : ℂ)).im| < 2 * C.s_h
        simp [hsh_pos]
      have hd_C : HasDerivAt C.h_ℂ (deriv C.h_ℂ (μ : ℂ)) (μ : ℂ) :=
        (C.h_ℂ_holo.differentiableAt ((h_open_strip (2 * C.s_h)).mem_nhds hμ_mem)).hasDerivAt
      have hd1 : HasDerivAt (fun θ : ℝ => C.h_ℂ (θ : ℂ)) (deriv C.h_ℂ (μ : ℂ)) μ :=
        hd_C.comp_ofReal
      have hd_R : HasDerivAt C.h (deriv C.h μ) μ :=
        (C.h_smooth.differentiable (by decide) μ).hasDerivAt
      have hd2 : HasDerivAt (fun θ : ℝ => (C.h θ : ℂ)) ((deriv C.h μ : ℝ) : ℂ) μ :=
        hd_R.ofReal_comp
      have hfun : (fun θ : ℝ => C.h_ℂ (θ : ℂ)) = (fun θ : ℝ => (C.h θ : ℂ)) := funext C.h_ℂ_real
      rw [hfun] at hd1
      exact hd1.unique hd2
    have hTheta_real : ∀ u s : ℝ, |s| < C.r₁ →
        glancingTheta C (u : ℂ) (s : ℂ) = (C.ϕ (C.U ((u : ℂ), (s : ℂ))).re : ℂ) := by
      intro u s hs
      have hconj := C.U_conj (u : ℂ) (s : ℂ) (by simp [hs₁_pos])
        (by simpa [Complex.norm_real, Real.norm_eq_abs] using hs)
      simp only [Complex.conj_ofReal] at hconj
      have him0 : (C.U ((u : ℂ), (s : ℂ))).im = 0 := Complex.conj_eq_iff_im.mp hconj.symm
      let r₀ : ℝ := (C.U ((u : ℂ), (s : ℂ))).re
      have hU_eq : C.U ((u : ℂ), (s : ℂ)) = (r₀ : ℂ) := by
        apply Complex.ext <;> simp [r₀, him0]
      unfold glancingTheta
      rw [hU_eq, C.ϕ_ℂ_real]
      simp [r₀]
    have hOffset_real_im : ∀ u s : ℝ, |s| < C.r₁ →
        (glancingOffset C (u : ℂ) (s : ℂ)).im = 0 := by
      intro u s hs
      have h_add : (u : ℂ) + (s : ℂ) = ((u + s : ℝ) : ℂ) := by push_cast; rfl
      set θ₁ : ℝ := C.ϕ (C.U ((u : ℂ), (s : ℂ))).re
      set θ₂ : ℝ := C.ϕ (C.U (((u + s : ℝ) : ℂ), (s : ℂ))).re
      unfold glancingOffset supportAction1_ℂ
      rw [h_add, hTheta_real u s hs, hTheta_real (u + s) s hs]
      have hm : ((θ₁ : ℂ) + (θ₂ : ℂ)) / 2 = (((θ₁ + θ₂) / 2 : ℝ) : ℂ) := by push_cast; ring
      have hd : ((θ₂ : ℂ) - (θ₁ : ℂ)) / 2 = (((θ₂ - θ₁) / 2 : ℝ) : ℂ) := by push_cast; ring
      rw [hm, hd, hderiv_h_real, C.h_ℂ_real, ← Complex.ofReal_sin, ← Complex.ofReal_cos]
      norm_cast
    have hh_diff : Differentiable ℝ C.h := C.h_smooth.differentiable (by decide)
    have hh2 : ContDiff ℝ ((1 : WithTop ℕ∞) + 1) C.h := C.h_smooth.of_le (by decide)
    have hh'_diff : Differentiable ℝ (deriv C.h) := hh2.deriv'.differentiable_one
    intro x t ht_pos ht_det
    have ht_r₁ : t < C.r₁ := by linarith
    have ht_abs_r₁ : |t| < C.r₁ := by rw [abs_of_pos ht_pos]; exact ht_r₁
    let g : ℝ → ℝ := fun s => (glancingOffset C (x : ℂ) (s : ℂ)).re
    have hg_cont : ContinuousOn g (Set.Icc 0 t) := by
      have hemb : Continuous (fun s : ℝ => ((x : ℂ), (s : ℂ))) :=
        continuous_const.prodMk Complex.continuous_ofReal
      have hmaps : Set.MapsTo (fun s : ℝ => ((x : ℂ), (s : ℂ))) (Set.Icc 0 t)
          { p : ℂ × ℂ | |p.1.im| < 2 * s_det ∧ ‖p.2‖ < 2 * r_det } := by
        intro s hs
        refine ⟨by simp [hs_det_pos], ?_⟩
        simp only [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hs.1]
        linarith [hs.2]
      change ContinuousOn
        (Complex.re ∘ (fun p : ℂ × ℂ => glancingOffset C p.1 p.2) ∘
          (fun s : ℝ => ((x : ℂ), (s : ℂ))))
        (Set.Icc 0 t)
      exact Complex.continuous_re.comp_continuousOn
        (hOff_det.continuousOn.comp hemb.continuousOn hmaps)
    have hg0 : 0 < g 0 := by
      dsimp [g]
      have h0 : glancingOffset C (x : ℂ) 0 = (C.h (C.ϕ x) : ℂ) := by simpa using hoff_real_zero x
      rw [h0, Complex.ofReal_re]
      exact C.h_pos (C.ϕ x)
    have hg_nz : ∀ s ∈ Set.Icc 0 t, g s ≠ 0 := by
      intro s hs hgs0
      have hs_r₁ : |s| < C.r₁ := by rw [abs_of_nonneg hs.1]; linarith [hs.2]
      have him0 : (glancingOffset C (x : ℂ) (s : ℂ)).im = 0 := hOffset_real_im x s hs_r₁
      have hcz : glancingOffset C (x : ℂ) (s : ℂ) = 0 := by
        apply Complex.ext
        · exact hgs0
        · exact him0
      refine hoff_ne_zero (x : ℂ) (s : ℂ) (by simp [hs_det_pos]) ?_ hcz
      simp only [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hs.1]
      linarith [hs.2]
    have hgt_pos : 0 < g t := by
      by_contra hnot
      have hle : g t ≤ 0 := not_lt.mp hnot
      have hmem0 : (0 : ℝ) ∈ g '' Set.Icc 0 t :=
        isPreconnected_Icc.intermediate_value
          (Set.right_mem_Icc.mpr ht_pos.le) (Set.left_mem_Icc.mpr ht_pos.le)
          hg_cont ⟨hle, hg0.le⟩
      rcases hmem0 with ⟨s₀, hs₀, hgs₀⟩
      exact hg_nz s₀ hs₀ hgs₀
    set θ_m : ℝ := C.ϕ (C.U (((x - t : ℝ) : ℂ), (t : ℂ))).re
    set θ_0 : ℝ := C.ϕ (C.U ((x : ℂ), (t : ℂ))).re
    set θ_p : ℝ := C.ϕ (C.U (((x + t : ℝ) : ℂ), (t : ℂ))).re
    set ψ_m : ℝ := (θ_m + θ_0) / 2
    set ψ_p : ℝ := (θ_0 + θ_p) / 2
    have hmid_m : glancingMidAngle C ((x : ℂ) - (t : ℂ) / 2) (t : ℂ) = (ψ_m : ℂ) := by
      unfold glancingMidAngle
      have h1 : ((x : ℂ) - (t : ℂ) / 2) - (t : ℂ) / 2 = ((x - t : ℝ) : ℂ) := by push_cast; ring
      have h2 : ((x : ℂ) - (t : ℂ) / 2) + (t : ℂ) / 2 = (x : ℂ) := by ring
      rw [h1, h2, hTheta_real (x - t) t ht_abs_r₁, hTheta_real x t ht_abs_r₁]
      dsimp only [ψ_m, θ_m, θ_0]
      push_cast; ring
    have hmid_p : glancingMidAngle C ((x : ℂ) + (t : ℂ) / 2) (t : ℂ) = (ψ_p : ℂ) := by
      unfold glancingMidAngle
      have h1 : ((x : ℂ) + (t : ℂ) / 2) - (t : ℂ) / 2 = (x : ℂ) := by ring
      have h2 : ((x : ℂ) + (t : ℂ) / 2) + (t : ℂ) / 2 = ((x + t : ℝ) : ℂ) := by push_cast; ring
      rw [h1, h2, hTheta_real x t ht_abs_r₁, hTheta_real (x + t) t ht_abs_r₁]
      dsimp only [ψ_p, θ_0, θ_p]
      push_cast; ring
    let P_ℝ (ψ : ℝ) : Fin 2 → ℝ :=
      ![C.h ψ * Real.cos ψ - deriv C.h ψ * Real.sin ψ,
        C.h ψ * Real.sin ψ + deriv C.h ψ * Real.cos ψ]
    have hImp_m : ∀ i : Fin 2,
        glancingImpact C ((x : ℂ) - (t : ℂ) / 2) (t : ℂ) i = (P_ℝ ψ_m i : ℂ) := by
      intro i
      fin_cases i <;>
      · simp only [glancingImpact, P_ℝ, hmid_m, C.h_ℂ_real, hderiv_h_real,
          ← Complex.ofReal_cos, ← Complex.ofReal_sin]
        push_cast; rfl
    have hImp_p : ∀ i : Fin 2,
        glancingImpact C ((x : ℂ) + (t : ℂ) / 2) (t : ℂ) i = (P_ℝ ψ_p i : ℂ) := by
      intro i
      fin_cases i <;>
      · simp only [glancingImpact, P_ℝ, hmid_p, C.h_ℂ_real, hderiv_h_real,
          ← Complex.ofReal_cos, ← Complex.ofReal_sin]
        push_cast; rfl
    have hΔ_cast :
        glancingImpact C ((x : ℂ) - (t : ℂ) / 2) (t : ℂ) 0 *
          glancingImpact C ((x : ℂ) + (t : ℂ) / 2) (t : ℂ) 1 -
        glancingImpact C ((x : ℂ) - (t : ℂ) / 2) (t : ℂ) 1 *
          glancingImpact C ((x : ℂ) + (t : ℂ) / 2) (t : ℂ) 0 =
        ((P_ℝ ψ_m 0 * P_ℝ ψ_p 1 - P_ℝ ψ_m 1 * P_ℝ ψ_p 0 : ℝ) : ℂ) := by
      rw [hImp_m 0, hImp_p 1, hImp_m 1, hImp_p 0]
      push_cast; rfl
    obtain ⟨hpm_C, hpp_C⟩ := hProj (x : ℂ) (t : ℂ)
      (by simp; linarith)
      (by simp only [Complex.norm_real, Real.norm_eq_abs, abs_of_pos ht_pos]; exact ht_det)
    have hm_re : P_ℝ ψ_m 0 * Real.cos θ_0 + P_ℝ ψ_m 1 * Real.sin θ_0 = g t := by
      have hc := congr_arg Complex.re hpm_C
      rw [hImp_m 0, hImp_m 1, hTheta_real x t ht_abs_r₁,
        ← Complex.ofReal_cos, ← Complex.ofReal_sin] at hc
      norm_cast at hc
    have hp_re : P_ℝ ψ_p 0 * Real.cos θ_0 + P_ℝ ψ_p 1 * Real.sin θ_0 = g t := by
      have hc := congr_arg Complex.re hpp_C
      rw [hImp_p 0, hImp_p 1, hTheta_real x t ht_abs_r₁,
        ← Complex.ofReal_cos, ← Complex.ofReal_sin] at hc
      norm_cast at hc
    let F_mono : ℝ → ℝ := fun ψ => C.h ψ * Real.sin (ψ - θ_0) + deriv C.h ψ * Real.cos (ψ - θ_0)
    have hF_proj : ∀ ψ : ℝ, -P_ℝ ψ 0 * Real.sin θ_0 + P_ℝ ψ 1 * Real.cos θ_0 = F_mono ψ := by
      intro ψ
      simp only [P_ℝ, F_mono, Matrix.cons_val_zero, Matrix.cons_val_one,
        Real.sin_sub, Real.cos_sub]
      ring
    have hΔ_factor :
        P_ℝ ψ_m 0 * P_ℝ ψ_p 1 - P_ℝ ψ_m 1 * P_ℝ ψ_p 0 = g t * (F_mono ψ_p - F_mono ψ_m) := by
      rw [← hF_proj ψ_p, ← hF_proj ψ_m]
      have hcs : Real.cos θ_0 ^ 2 + Real.sin θ_0 ^ 2 = 1 := Real.cos_sq_add_sin_sq θ_0
      linear_combination -(P_ℝ ψ_m 0 * P_ℝ ψ_p 1 - P_ℝ ψ_m 1 * P_ℝ ψ_p 0) * hcs +
        (-P_ℝ ψ_p 0 * Real.sin θ_0 + P_ℝ ψ_p 1 * Real.cos θ_0) * hm_re -
        (-P_ℝ ψ_m 0 * Real.sin θ_0 + P_ℝ ψ_m 1 * Real.cos θ_0) * hp_re
    have hF_hasDeriv : ∀ ψ : ℝ,
        HasDerivAt F_mono ((C.h ψ + deriv (deriv C.h) ψ) * Real.cos (ψ - θ_0)) ψ := by
      intro ψ
      have h1 : HasDerivAt C.h (deriv C.h ψ) ψ := (hh_diff ψ).hasDerivAt
      have h2 : HasDerivAt (fun u : ℝ => Real.sin (u - θ_0)) (Real.cos (ψ - θ_0)) ψ := by
        simpa [Function.comp_def] using
          (Real.hasDerivAt_sin (ψ - θ_0)).comp ψ ((hasDerivAt_id ψ).sub_const θ_0)
      have h3 : HasDerivAt (deriv C.h) (deriv (deriv C.h) ψ) ψ := (hh'_diff ψ).hasDerivAt
      have h4 : HasDerivAt (fun u : ℝ => Real.cos (u - θ_0)) (-Real.sin (ψ - θ_0)) ψ := by
        simpa [Function.comp_def] using
          (Real.hasDerivAt_cos (ψ - θ_0)).comp ψ ((hasDerivAt_id ψ).sub_const θ_0)
      convert (h1.mul h2).add (h3.mul h4) using 1
      ring
    have hF_cont : Continuous F_mono :=
      Differentiable.continuous fun ψ => (hF_hasDeriv ψ).differentiableAt
    have hstep_m := C.U_real_step_pos (x - t) t ht_pos ht_r₁
    have hstep_p := C.U_real_step_pos x t ht_pos ht_r₁
    have hU_m_eq : C.ϕ (C.U (((x - t : ℝ) : ℂ) + (t : ℂ), (t : ℂ))).re = θ_0 := by
      have h_cancel : ((x - t : ℝ) : ℂ) + (t : ℂ) = (x : ℂ) := by push_cast; ring
      rw [h_cancel]
    have hU_p_eq : C.ϕ (C.U ((x : ℂ) + (t : ℂ), (t : ℂ))).re = θ_p := by
      have h_add : (x : ℂ) + (t : ℂ) = ((x + t : ℝ) : ℂ) := by push_cast; rfl
      rw [h_add]
    have hθ0_sub_θm_pos : 0 < θ_0 - θ_m := by simpa [hU_m_eq, θ_m] using hstep_m.2.1
    have hθ0_sub_θm_lt : θ_0 - θ_m < Real.pi := by simpa [hU_m_eq, θ_m] using hstep_m.2.2
    have hθp_sub_θ0_pos : 0 < θ_p - θ_0 := by simpa [hU_p_eq, θ_0] using hstep_p.2.1
    have hθp_sub_θ0_lt : θ_p - θ_0 < Real.pi := by simpa [hU_p_eq, θ_0] using hstep_p.2.2
    have hψm_lt_ψp : ψ_m < ψ_p := by dsimp [ψ_m, ψ_p]; linarith
    have hF'_pos : ∀ ψ ∈ Set.Icc ψ_m ψ_p, 0 < deriv F_mono ψ := by
      intro ψ hψ
      rw [(hF_hasDeriv ψ).deriv]
      refine mul_pos (C.r_pos ψ) (Real.cos_pos_of_mem_Ioo ⟨?_, ?_⟩)
      · dsimp [ψ_m] at hψ; linarith [hψ.1]
      · dsimp [ψ_p] at hψ; linarith [hψ.2]
    have hF_mono : StrictMonoOn F_mono (Set.Icc ψ_m ψ_p) :=
      strictMonoOn_of_deriv_pos (convex_Icc ψ_m ψ_p) hF_cont.continuousOn
        (fun ψ hψ => hF'_pos ψ (interior_subset hψ))
    have hF_lt : F_mono ψ_m < F_mono ψ_p :=
      hF_mono ⟨le_rfl, hψm_lt_ψp.le⟩ ⟨hψm_lt_ψp.le, le_rfl⟩ hψm_lt_ψp
    refine ⟨hgt_pos, hOffset_real_im x t ht_abs_r₁, ?_, ?_⟩
    · rw [hΔ_cast, Complex.ofReal_re, hΔ_factor]
      exact mul_pos hgt_pos (sub_pos.mpr hF_lt)
    · rw [hΔ_cast, Complex.ofReal_im]
  exact ⟨{
    s_det := s_det
    r_det := r_det
    s_det_pos := hs_det_pos
    s_det_le_s₁ := hs_det_le_init.trans hs_init_s₁
    s_det_le_s₀ := hs_det_le_init.trans hs_init_s₀
    r_det_pos := hr_det_pos
    r_det_lt_s_det := hr_det_lt_s4
    r_det_lt_r₁ := hr_det_lt_r₁_half
    offset_ne_zero := hoff_ne_zero
    theta_holo := hTh_det
    offset_holo := hOff_det
    dualLine_holo := hDual_det
    impact_holo := hImp_det
    iterDerivYT_holo := hIterYT
    eqOn_zero_of_preconnected_2D := hId2D
    impact_support_proj := hProj
    cramer_edge_identities := hCramer
    real_chord_pos := hRealChord
  }⟩

theorem algebraic_arc_and_resultant_toolkit : AlgebraicLiftingToolkit :=
by
  refine {
    formal_arc := ?_
    lift_separable := ?_
    sqrt_power_sum_zero := ?_
  }
  · 
    have hTaylor : ∀ {A : Type} [CommRing A] (P : Polynomial A) (a b : A),
        ∃ rem : A, P.eval (a + b) = P.eval a + P.derivative.eval a * b + rem * b ^ 2 := by
      intro A _ P a b
      have hPow : ∀ d : ℕ, ∃ rem : A,
          (a + b) ^ d = a ^ d + (d : A) * a ^ (d - 1) * b + rem * b ^ 2 := by
        intro d
        induction d with
        | zero => exact ⟨0, by simp⟩
        | succ d ih =>
          rcases d with _ | k
          · exact ⟨0, by simp⟩
          · rcases ih with ⟨r, hr⟩
            refine ⟨((k + 1 : ℕ) : A) * a ^ k + r * (a + b), ?_⟩
            have h1 : (a + b) ^ (k + 2) = (a + b) ^ (k + 1) * (a + b) := pow_succ (a + b) (k + 1)
            rw [h1, hr]
            simp only [Nat.add_sub_cancel, pow_succ, Nat.cast_add, Nat.cast_one]
            ring
      induction P using Polynomial.induction_on' with
      | add p q hp hq =>
        rcases hp with ⟨rp, hrp⟩
        rcases hq with ⟨rq, hrq⟩
        refine ⟨rp + rq, ?_⟩
        simp only [Polynomial.eval_add, Polynomial.derivative_add]
        rw [hrp, hrq]
        ring
      | monomial d s =>
        rcases hPow d with ⟨r, hr⟩
        refine ⟨s * r, ?_⟩
        simp only [Polynomial.eval_monomial, Polynomial.derivative_monomial]
        rw [hr]
        ring
    have hMapEval : ∀ {A B : Type} [CommRing A] [CommRing B] (f : A →+* B)
        (P : Polynomial A) (a : A), f (P.eval a) = (P.map f).eval (f a) := by
      intro A B _ _ f P a
      induction P using Polynomial.induction_on' with
      | add p q hp hq =>
        rw [Polynomial.eval_add, map_add, Polynomial.map_add, Polynomial.eval_add, hp, hq]
      | monomial d s =>
        rw [Polynomial.eval_monomial, map_mul, map_pow, Polynomial.map_monomial,
          Polynomial.eval_monomial]
    have hHensel : ∀ (L : Subfield ℂ) (Φ : ↥L →+* PowerSeries ℂ)
        (hΦ_cc : ∀ y : ↥L, PowerSeries.constantCoeff (Φ y) = (y : ℂ))
        (α : ℂ) (h_alg : IsAlgebraic (↥L) α),
        ∃ γ : PowerSeries ℂ,
          PowerSeries.constantCoeff γ = α ∧
          Polynomial.eval₂ Φ γ (minpoly (↥L) α) = 0 := by
      intro L Φ hΦ_cc α h_alg
      have : CharZero (↥L) := L.subtype.charZero
      let m : Polynomial (↥L) := minpoly (↥L) α
      have hm_irr : Irreducible m := minpoly.irreducible h_alg.isIntegral
      let m_ℂ : Polynomial ℂ := m.map L.subtype
      have hm_ℂ_sep : m_ℂ.Separable := hm_irr.separable.map
      let M : Polynomial (PowerSeries ℂ) := m.map Φ
      have hM_cc : M.map PowerSeries.constantCoeff = m_ℂ := by
        rw [Polynomial.map_map]
        congr 1
        ext y
        exact hΦ_cc y
      have hm_ℂ_eval : m_ℂ.eval α = 0 := by
        rw [Polynomial.eval_map]
        exact minpoly.aeval (↥L) α
      let μ : ℂ := m_ℂ.derivative.eval α
      have hμ_ne : μ ≠ 0 := by
        rcases hm_ℂ_sep with ⟨u, v, huv⟩
        have hev := congr_arg (Polynomial.eval α) huv
        simp only [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_one,
          hm_ℂ_eval, mul_zero, zero_add] at hev
        intro h0
        dsimp only [μ] at h0
        rw [h0, mul_zero] at hev
        exact zero_ne_one hev
      let g : ℕ → PowerSeries ℂ := fun k =>
        Nat.rec (PowerSeries.C α)
          (fun n gn =>
            gn + PowerSeries.C (-PowerSeries.coeff (n + 1) (M.eval gn) / μ) *
              PowerSeries.X ^ (n + 1)) k
      have hg_zero : g 0 = PowerSeries.C α := rfl
      have hg_succ : ∀ n : ℕ, g (n + 1) =
          g n + PowerSeries.C (-PowerSeries.coeff (n + 1) (M.eval (g n)) / μ) *
            PowerSeries.X ^ (n + 1) := fun _ => rfl
      have hg_cc : ∀ k : ℕ, PowerSeries.constantCoeff (g k) = α := by
        intro k
        induction k with
        | zero => simp [hg_zero]
        | succ n ih =>
          rw [hg_succ, map_add, map_mul, map_pow, PowerSeries.constantCoeff_X,
            zero_pow (Nat.succ_ne_zero n), mul_zero, add_zero, ih]
      have hg_stab : ∀ (j k : ℕ), j ≤ k → PowerSeries.coeff j (g k) = PowerSeries.coeff j (g j) := by
        intro j k hjk
        induction k with
        | zero =>
          have hj0 : j = 0 := Nat.eq_zero_of_le_zero hjk
          subst hj0; rfl
        | succ n ih =>
          rcases Nat.of_le_succ hjk with hle | rfl
          · rw [hg_succ, map_add, PowerSeries.coeff_C_mul, PowerSeries.coeff_X_pow,
              ite_eq_right_iff.mpr (fun h => absurd h (by omega)), mul_zero, add_zero, ih hle]
          · rfl
      have hg_vanish : ∀ k : ℕ, ∀ j ≤ k, PowerSeries.coeff j (M.eval (g k)) = 0 := by
        intro k
        induction k with
        | zero =>
          intro j hj
          have hj0 : j = 0 := Nat.eq_zero_of_le_zero hj
          subst hj0
          rw [PowerSeries.coeff_zero_eq_constantCoeff, hMapEval PowerSeries.constantCoeff M (g 0),
            hM_cc, hg_cc 0, hm_ℂ_eval]
        | succ n ih =>
          intro j hj
          set c_step : ℂ := -PowerSeries.coeff (n + 1) (M.eval (g n)) / μ
          rcases hTaylor M (g n) (PowerSeries.C c_step * PowerSeries.X ^ (n + 1)) with ⟨rem, hrem⟩
          rw [hg_succ, hrem, map_add, map_add]
          have hrem_zero : PowerSeries.coeff j
              (rem * (PowerSeries.C c_step * PowerSeries.X ^ (n + 1)) ^ 2) = 0 := by
            have hb2 : rem * (PowerSeries.C c_step * PowerSeries.X ^ (n + 1)) ^ 2 =
                PowerSeries.X ^ (2 * n + 2) * (rem * PowerSeries.C (c_step ^ 2)) := by
              rw [mul_pow, ← map_pow, ← pow_mul]
              ring
            rw [hb2, PowerSeries.coeff_X_pow_mul',
              ite_eq_right_iff.mpr (fun h => absurd h (by omega))]
          rw [hrem_zero, add_zero]
          have hlin_rewrite : M.derivative.eval (g n) *
              (PowerSeries.C c_step * PowerSeries.X ^ (n + 1)) =
              PowerSeries.X ^ (n + 1) * (PowerSeries.C c_step * M.derivative.eval (g n)) := by ring
          rw [hlin_rewrite, PowerSeries.coeff_X_pow_mul']
          rcases Nat.of_le_succ hj with hlt | rfl
          · rw [ih j hlt, ite_eq_right_iff.mpr (fun h => absurd h (by omega)), add_zero]
          · simp only [le_refl, ↓reduceIte, Nat.sub_self, PowerSeries.coeff_C_mul,
              PowerSeries.coeff_zero_eq_constantCoeff]
            have hderiv_cc : PowerSeries.constantCoeff (M.derivative.eval (g n)) = μ := by
              rw [hMapEval PowerSeries.constantCoeff M.derivative (g n),
                ← Polynomial.derivative_map, hM_cc, hg_cc n]
            rw [hderiv_cc]
            dsimp only [c_step]
            field_simp [hμ_ne]
            ring
      let γ : PowerSeries ℂ := PowerSeries.mk (fun k => PowerSeries.coeff k (g k))
      have hγ_cc : PowerSeries.constantCoeff γ = α := by
        rw [← PowerSeries.coeff_zero_eq_constantCoeff]
        change PowerSeries.coeff 0 (PowerSeries.mk _) = α
        rw [PowerSeries.coeff_mk, PowerSeries.coeff_zero_eq_constantCoeff, hg_cc 0]
      refine ⟨γ, hγ_cc, ?_⟩
      rw [← Polynomial.eval_map]
      change M.eval γ = 0
      ext k
      rw [map_zero]
      let tail_k : PowerSeries ℂ :=
        PowerSeries.mk (fun d => PowerSeries.coeff (d + (k + 1)) (γ - g k))
      have hγ_split : γ = g k + PowerSeries.X ^ (k + 1) * tail_k := by
        ext j
        rw [map_add, PowerSeries.coeff_X_pow_mul']
        by_cases hjk : k + 1 ≤ j
        · simp only [hjk, ↓reduceIte, tail_k, PowerSeries.coeff_mk,
            Nat.sub_add_cancel hjk, map_sub]
          ring
        · simp only [hjk, ↓reduceIte, add_zero]
          have hj_le : j ≤ k := by omega
          change PowerSeries.coeff j (PowerSeries.mk _) = PowerSeries.coeff j (g k)
          rw [PowerSeries.coeff_mk, hg_stab j k hj_le]
      rcases hTaylor M (g k) (PowerSeries.X ^ (k + 1) * tail_k) with ⟨rem, hrem⟩
      rw [hγ_split, hrem, map_add, map_add, hg_vanish k k (le_refl k), zero_add]
      have hlin0 : PowerSeries.coeff k
          (M.derivative.eval (g k) * (PowerSeries.X ^ (k + 1) * tail_k)) = 0 := by
        have hcomm : M.derivative.eval (g k) * (PowerSeries.X ^ (k + 1) * tail_k) =
            PowerSeries.X ^ (k + 1) * (M.derivative.eval (g k) * tail_k) := by ring
        rw [hcomm, PowerSeries.coeff_X_pow_mul',
          ite_eq_right_iff.mpr (fun h => absurd h (by omega))]
      have hquad0 : PowerSeries.coeff k
          (rem * (PowerSeries.X ^ (k + 1) * tail_k) ^ 2) = 0 := by
        have hcomm : rem * (PowerSeries.X ^ (k + 1) * tail_k) ^ 2 =
            PowerSeries.X ^ (2 * k + 2) * (rem * tail_k ^ 2) := by
          rw [mul_pow, ← pow_mul]
          ring
        rw [hcomm, PowerSeries.coeff_X_pow_mul',
          ite_eq_right_iff.mpr (fun h => absurd h (by omega))]
      rw [hlin0, hquad0, add_zero]
    have hExtendSingle : ∀ (L : Subfield ℂ) (Φ : ↥L →+* PowerSeries ℂ)
        (hΦ_cc : ∀ y : ↥L, PowerSeries.constantCoeff (Φ y) = (y : ℂ))
        (α : ℂ) (δ : PowerSeries ℂ) (hδ_cc : PowerSeries.constantCoeff δ = 0),
        let F₁ : Subfield ℂ := Subfield.closure ((L : Set ℂ) ∪ {α})
        ∃ Φ_ext : ↥F₁ →+* PowerSeries ℂ,
          (∀ y : ↥L, Φ_ext ⟨(y : ℂ), Subfield.subset_closure (Or.inl y.2)⟩ = Φ y) ∧
          (∀ z : ↥F₁, PowerSeries.constantCoeff (Φ_ext z) = (z : ℂ)) ∧
          (¬ IsAlgebraic (↥L) α →
            Φ_ext ⟨α, Subfield.subset_closure (Or.inr rfl)⟩ = PowerSeries.C α + δ) := by
      intro L Φ hΦ_cc α δ hδ_cc F₁
      let ev_ℂ : Polynomial (↥L) →+* ℂ := Polynomial.eval₂RingHom L.subtype α
      have hev_aeval : ∀ P : Polynomial (↥L), ev_ℂ P = Polynomial.aeval α P := fun _ => rfl
      by_cases h_alg : IsAlgebraic (↥L) α
      · rcases hHensel L Φ hΦ_cc α h_alg with ⟨γ, hγ_cc, hγ_eval⟩
        let m : Polynomial (↥L) := minpoly (↥L) α
        have hm_irr : Irreducible m := minpoly.irreducible h_alg.isIntegral
        have hm_ev0 : ev_ℂ m = 0 := by
          rw [hev_aeval]
          exact minpoly.aeval (↥L) α
        let E_alg : Subfield ℂ := {
          carrier := Set.range ev_ℂ
          mul_mem' := by
            rintro _ _ ⟨P, rfl⟩ ⟨Q, rfl⟩
            exact ⟨P * Q, map_mul ev_ℂ P Q⟩
          one_mem' := ⟨1, map_one ev_ℂ⟩
          add_mem' := by
            rintro _ _ ⟨P, rfl⟩ ⟨Q, rfl⟩
            exact ⟨P + Q, map_add ev_ℂ P Q⟩
          zero_mem' := ⟨0, map_zero ev_ℂ⟩
          neg_mem' := by
            rintro _ ⟨P, rfl⟩
            exact ⟨-P, map_neg ev_ℂ P⟩
          inv_mem' := by
            rintro _ ⟨P, rfl⟩
            by_cases hP0 : ev_ℂ P = 0
            · rw [hP0, _root_.inv_zero]
              exact ⟨0, map_zero ev_ℂ⟩
            · have h_ndvd : ¬ (m ∣ P) := by
                rintro ⟨q, rfl⟩
                exact hP0 (by rw [map_mul, hm_ev0, zero_mul])
              rcases hm_irr.coprime_iff_not_dvd.mpr h_ndvd with ⟨A, B, hAB⟩
              have hev1 := congr_arg ev_ℂ hAB
              simp only [map_add, map_mul, map_one, hm_ev0, mul_zero, zero_add] at hev1
              refine ⟨B, ?_⟩
              exact eq_inv_of_mul_eq_one_left hev1
        }
        have hF₁_le : F₁ ≤ E_alg := by
          refine Subfield.closure_le.mpr ?_
          rintro w (hwL | rfl)
          · exact ⟨Polynomial.C ⟨w, hwL⟩, by simp [ev_ℂ]⟩
          · exact ⟨Polynomial.X, by simp [ev_ℂ]⟩
        let ψ : Polynomial (↥L) →+* PowerSeries ℂ := Polynomial.eval₂RingHom Φ γ
        have hψ_cc : ∀ P : Polynomial (↥L), PowerSeries.constantCoeff (ψ P) = ev_ℂ P := by
          intro P
          induction P using Polynomial.induction_on' with
          | add p q hp hq => rw [map_add, map_add, map_add, hp, hq]
          | monomial d s => simp [ψ, ev_ℂ, hΦ_cc s, hγ_cc]
        have hψ_m : ψ m = 0 := hγ_eval
        have h_wd : ∀ P Q : Polynomial (↥L), ev_ℂ P = ev_ℂ Q → ψ P = ψ Q := by
          intro P Q hPQ
          have hsub0 : Polynomial.aeval α (P - Q) = 0 := by
            rw [← hev_aeval, map_sub, hPQ, sub_self]
          rcases minpoly.dvd (↥L) α hsub0 with ⟨R, hR⟩
          have hψ_sub : ψ (P - Q) = 0 := by
            rw [hR, map_mul, hψ_m, zero_mul]
          exact sub_eq_zero.mp (by rwa [← map_sub])
        have h_rep : ∀ z : ↥F₁, ∃ P : Polynomial (↥L), ev_ℂ P = (z : ℂ) := fun z => hF₁_le z.2
        have h_apply : ∀ (z : ↥F₁) (P : Polynomial (↥L)), ev_ℂ P = (z : ℂ) →
            ψ (Classical.choose (h_rep z)) = ψ P := fun z P hP =>
          h_wd _ _ ((Classical.choose_spec (h_rep z)).trans hP.symm)
        let Φ_ext : ↥F₁ →+* PowerSeries ℂ := {
          toFun := fun z => ψ (Classical.choose (h_rep z))
          map_one' := by simp [h_apply 1 1 (map_one ev_ℂ)]
          map_mul' := fun z₁ z₂ => by
            change ψ (Classical.choose (h_rep (z₁ * z₂))) =
              ψ (Classical.choose (h_rep z₁)) * ψ (Classical.choose (h_rep z₂))
            rw [h_apply (z₁ * z₂) (Classical.choose (h_rep z₁) * Classical.choose (h_rep z₂))
              (by rw [map_mul, Classical.choose_spec (h_rep z₁), Classical.choose_spec (h_rep z₂)]; rfl),
              map_mul]
          map_zero' := by simp [h_apply 0 0 (map_zero ev_ℂ)]
          map_add' := fun z₁ z₂ => by
            change ψ (Classical.choose (h_rep (z₁ + z₂))) =
              ψ (Classical.choose (h_rep z₁)) + ψ (Classical.choose (h_rep z₂))
            rw [h_apply (z₁ + z₂) (Classical.choose (h_rep z₁) + Classical.choose (h_rep z₂))
              (by rw [map_add, Classical.choose_spec (h_rep z₁), Classical.choose_spec (h_rep z₂)]; rfl),
              map_add]
        }
        refine ⟨Φ_ext, fun y => ?_, fun z => ?_, fun hna => absurd h_alg hna⟩
        · change ψ (Classical.choose (h_rep _)) = Φ y
          rw [h_apply _ (Polynomial.C y) (by simp [ev_ℂ])]
          simp [ψ]
        · change PowerSeries.constantCoeff (ψ (Classical.choose (h_rep z))) = (z : ℂ)
          rw [hψ_cc, Classical.choose_spec (h_rep z)]
      · have h_ev_ne : ∀ Q : Polynomial (↥L), Q ≠ 0 → ev_ℂ Q ≠ 0 := by
          intro Q hQ h0
          exact h_alg ⟨Q, hQ, by rwa [← hev_aeval]⟩
        let E_tr : Subfield ℂ := {
          carrier := { w : ℂ | ∃ P Q : Polynomial (↥L), Q ≠ 0 ∧ w = ev_ℂ P / ev_ℂ Q }
          mul_mem' := by
            rintro _ _ ⟨P₁, Q₁, hQ₁, rfl⟩ ⟨P₂, Q₂, hQ₂, rfl⟩
            exact ⟨P₁ * P₂, Q₁ * Q₂, mul_ne_zero hQ₁ hQ₂, by simp [map_mul, div_mul_div_comm]⟩
          one_mem' := ⟨1, 1, one_ne_zero, by simp⟩
          add_mem' := by
            rintro _ _ ⟨P₁, Q₁, hQ₁, rfl⟩ ⟨P₂, Q₂, hQ₂, rfl⟩
            refine ⟨P₁ * Q₂ + P₂ * Q₁, Q₁ * Q₂, mul_ne_zero hQ₁ hQ₂, ?_⟩
            rw [div_add_div _ _ (h_ev_ne Q₁ hQ₁) (h_ev_ne Q₂ hQ₂)]
            simp [map_add, map_mul]
            ring
          zero_mem' := ⟨0, 1, one_ne_zero, by simp⟩
          neg_mem' := by
            rintro _ ⟨P, Q, hQ, rfl⟩
            exact ⟨-P, Q, hQ, by rw [map_neg, neg_div]⟩
          inv_mem' := by
            rintro _ ⟨P, Q, hQ, rfl⟩
            by_cases hP : P = 0
            · exact ⟨0, 1, one_ne_zero, by simp [hP]⟩
            · exact ⟨Q, P, hP, by rw [inv_div]⟩
        }
        have hF₁_le : F₁ ≤ E_tr := by
          refine Subfield.closure_le.mpr ?_
          rintro w (hwL | rfl)
          · exact ⟨Polynomial.C ⟨w, hwL⟩, 1, one_ne_zero, by simp [ev_ℂ]⟩
          · exact ⟨Polynomial.X, 1, one_ne_zero, by simp [ev_ℂ]⟩
        let γ : PowerSeries ℂ := PowerSeries.C α + δ
        have hγ_cc : PowerSeries.constantCoeff γ = α := by simp [γ, hδ_cc]
        let ψ : Polynomial (↥L) →+* PowerSeries ℂ := Polynomial.eval₂RingHom Φ γ
        have hψ_cc : ∀ P : Polynomial (↥L), PowerSeries.constantCoeff (ψ P) = ev_ℂ P := by
          intro P
          induction P using Polynomial.induction_on' with
          | add p q hp hq => rw [map_add, map_add, map_add, hp, hq]
          | monomial d s => simp [ψ, ev_ℂ, hΦ_cc s, hγ_cc]
        have hψ_unit : ∀ Q : Polynomial (↥L), Q ≠ 0 → IsUnit (ψ Q) := by
          intro Q hQ
          rw [PowerSeries.isUnit_iff_constantCoeff, hψ_cc]
          exact isUnit_iff_ne_zero.mpr (h_ev_ne Q hQ)
        let invPS : ∀ Q : Polynomial (↥L), Q ≠ 0 → PowerSeries ℂ := fun Q hQ =>
          ↑((hψ_unit Q hQ).unit⁻¹)
        have hinvPS_mul : ∀ (Q : Polynomial (↥L)) (hQ : Q ≠ 0), ψ Q * invPS Q hQ = 1 :=
          fun Q hQ => IsUnit.mul_val_inv (hψ_unit Q hQ)
        have hinvPS_cc : ∀ (Q : Polynomial (↥L)) (hQ : Q ≠ 0),
            PowerSeries.constantCoeff (invPS Q hQ) = (ev_ℂ Q)⁻¹ := by
          intro Q hQ
          have h1 := congr_arg PowerSeries.constantCoeff (hinvPS_mul Q hQ)
          rw [map_mul, map_one, hψ_cc] at h1
          exact eq_inv_of_mul_eq_one_right h1
        have h_wd_tr : ∀ (P₁ Q₁ P₂ Q₂ : Polynomial (↥L)) (hQ₁ : Q₁ ≠ 0) (hQ₂ : Q₂ ≠ 0),
            ev_ℂ P₁ / ev_ℂ Q₁ = ev_ℂ P₂ / ev_ℂ Q₂ →
            ψ P₁ * invPS Q₁ hQ₁ = ψ P₂ * invPS Q₂ hQ₂ := by
          intro P₁ Q₁ P₂ Q₂ hQ₁ hQ₂ heq
          have hcross_ev : ev_ℂ (P₁ * Q₂ - P₂ * Q₁) = 0 := by
            have h1 := (div_eq_div_iff (h_ev_ne Q₁ hQ₁) (h_ev_ne Q₂ hQ₂)).mp heq
            simp only [map_sub, map_mul]
            exact sub_eq_zero.mpr h1
          have hcross_poly : P₁ * Q₂ = P₂ * Q₁ := by
            by_contra hne
            exact h_ev_ne _ (sub_ne_zero.mpr hne) hcross_ev
          have hψ_eq : ψ P₁ * ψ Q₂ = ψ P₂ * ψ Q₁ := by
            simpa only [map_mul] using congr_arg ψ hcross_poly
          calc
            ψ P₁ * invPS Q₁ hQ₁
              = ψ P₁ * (ψ Q₂ * invPS Q₂ hQ₂) * invPS Q₁ hQ₁ := by rw [hinvPS_mul Q₂ hQ₂, mul_one]
            _ = (ψ P₁ * ψ Q₂) * invPS Q₁ hQ₁ * invPS Q₂ hQ₂ := by ring
            _ = (ψ P₂ * ψ Q₁) * invPS Q₁ hQ₁ * invPS Q₂ hQ₂ := by rw [hψ_eq]
            _ = ψ P₂ * (ψ Q₁ * invPS Q₁ hQ₁) * invPS Q₂ hQ₂ := by ring
            _ = ψ P₂ * invPS Q₂ hQ₂ := by rw [hinvPS_mul Q₁ hQ₁, mul_one]
        have h_rep : ∀ z : ↥F₁, ∃ P Q : Polynomial (↥L), Q ≠ 0 ∧ (z : ℂ) = ev_ℂ P / ev_ℂ Q :=
          fun z => hF₁_le z.2
        let P_z : ↥F₁ → Polynomial (↥L) := fun z => Classical.choose (h_rep z)
        let Q_z : ↥F₁ → Polynomial (↥L) := fun z => Classical.choose (Classical.choose_spec (h_rep z))
        have hQz_ne : ∀ z : ↥F₁, Q_z z ≠ 0 := fun z =>
          (Classical.choose_spec (Classical.choose_spec (h_rep z))).1
        have hPQ_eq : ∀ z : ↥F₁, (z : ℂ) = ev_ℂ (P_z z) / ev_ℂ (Q_z z) := fun z =>
          (Classical.choose_spec (Classical.choose_spec (h_rep z))).2
        have h_apply : ∀ (z : ↥F₁) (P Q : Polynomial (↥L)) (hQ : Q ≠ 0),
            (z : ℂ) = ev_ℂ P / ev_ℂ Q →
            ψ (P_z z) * invPS (Q_z z) (hQz_ne z) = ψ P * invPS Q hQ :=
          fun z P Q hQ h => h_wd_tr (P_z z) (Q_z z) P Q (hQz_ne z) hQ ((hPQ_eq z).symm.trans h)
        let Φ_ext : ↥F₁ →+* PowerSeries ℂ := {
          toFun := fun z => ψ (P_z z) * invPS (Q_z z) (hQz_ne z)
          map_one' := by
            change ψ (P_z 1) * invPS (Q_z 1) (hQz_ne 1) = 1
            rw [h_apply 1 1 1 one_ne_zero (by simp), map_one, one_mul]
            have h1 := hinvPS_mul 1 one_ne_zero
            rwa [map_one, one_mul] at h1
          map_mul' := fun z₁ z₂ => by
            change ψ (P_z (z₁ * z₂)) * invPS (Q_z (z₁ * z₂)) (hQz_ne (z₁ * z₂)) =
              (ψ (P_z z₁) * invPS (Q_z z₁) (hQz_ne z₁)) *
                (ψ (P_z z₂) * invPS (Q_z z₂) (hQz_ne z₂))
            have hQ12 : Q_z z₁ * Q_z z₂ ≠ 0 := mul_ne_zero (hQz_ne z₁) (hQz_ne z₂)
            rw [h_apply (z₁ * z₂) (P_z z₁ * P_z z₂) (Q_z z₁ * Q_z z₂) hQ12
              (by rw [Subfield.coe_mul, hPQ_eq z₁, hPQ_eq z₂, div_mul_div_comm, map_mul, map_mul])]
            have hinv_mul : invPS (Q_z z₁ * Q_z z₂) hQ12 =
                invPS (Q_z z₁) (hQz_ne z₁) * invPS (Q_z z₂) (hQz_ne z₂) := by
              have hmul1 : ψ (Q_z z₁ * Q_z z₂) *
                  (invPS (Q_z z₁) (hQz_ne z₁) * invPS (Q_z z₂) (hQz_ne z₂)) = 1 := by
                calc
                  ψ (Q_z z₁ * Q_z z₂) * (invPS (Q_z z₁) (hQz_ne z₁) * invPS (Q_z z₂) (hQz_ne z₂))
