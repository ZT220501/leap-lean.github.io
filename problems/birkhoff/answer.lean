    have h0 : h_y 0 = S.𝔰 (y, 0) - y := hh_germ.self_of_nhds
    rw [h0, S.𝔰_zero y hy_strip, sub_self]
  have hh_deriv2 : deriv (deriv h_y) 0 = 2 * S.V y := by
    have hiter := hh_germ.iteratedDeriv_eq 2
    simp only [iteratedDeriv_succ, iteratedDeriv_zero] at hiter
    rw [hiter, deriv_sub_const_fun, S.𝔰_deriv2_t_zero y hy_strip]
  have hh_bound : ∀ w : ℂ, ‖w‖ ≤ R₀ → ‖h_y w‖ ≤ M_err := by
    intro w hw_le
    have hw_ball : w ∈ Metric.ball (0 : ℂ) r := by
      rw [Metric.mem_ball, dist_zero_right]
      exact lt_of_le_of_lt hw_le hR₀_lt
    obtain ⟨hc1, hc2, hc3, hc4⟩ := hy_cone_mem w hw_ball
    have hraw := (hs_props (y, w) hc1 hc2 hc3 hc4).2.2.1
    have hεr_eq : ε / r = B / d := by
      dsimp [ε, r, d]
      field_simp [hc₀_pos.ne', hexp_pos.ne', hB_pos.ne']
    have hd_le_rpow : d ≤ d ^ α₁ := by
      calc
