  have hDiffSup_nonneg : ∀ (w₁ w₂ : ℝ → ℝ), 0 ≤ realDiffSup (m + 15) w₁ w₂ := by
    intro w₁ w₂
    apply Real.sSup_nonneg
    rintro r ⟨_, _, _, _, rfl⟩
    exact abs_nonneg _

  have hDiffSup_self : ∀ (w : ℝ → ℝ), realDiffSup (m + 15) w w = 0 := by
    intro w
    apply le_antisymm
    · apply csSup_le
      · refine ⟨0, 0, Nat.zero_le _, 0, ⟨le_refl 0, le_of_lt Real.two_pi_pos⟩, ?_⟩
        simp [sub_self]
      · rintro r ⟨k, _, y, _, rfl⟩
        have hw0 : w - w = fun _ : ℝ => (0 : ℝ) := sub_self w
        rw [hw0, iteratedDeriv_const]
        split_ifs <;> simp
    · exact hDiffSup_nonneg w w

  have hForcing_lip : ∀ (q : ℕ) (R Δ : ℝ) (w₁ w₂ : ℝ → ℝ) (d₁ d₂ : ℕ → ℝ → ℝ) (j : ℕ),
      N_force ≤ q → 0 ≤ R → 8 * R ≤ (q : ℝ) → 0 ≤ Δ →
      IsPeriodicSmoothBounded (m + 15) M₁ w₁ →
      IsPeriodicSmoothBounded (m + 15) M₁ w₂ →
      rdmc_IsBoundedDispTuple p q R d₁ →
      rdmc_IsBoundedDispTuple p q R d₂ →
      rdmc_IsBoundedDispTuple p q Δ (fun r x => d₁ r x - d₂ r x) →
      j + 1 < q →
      IsRealJetPerturb p
        (C_force_lip * (Δ / (q : ℝ) ^ 6 + realDiffSup (m + 15) w₁ w₂ / (q : ℝ) ^ 4))
        (fun x => rdmc_elForcing J_R q w₁ d₁ (j + 1) x -
          rdmc_elForcing J_R q w₂ d₂ (j + 1) x) := by
    intro q R Δ w₁ w₂ d₁ d₂ j hq hR h8R hΔ hw₁ hw₂ hd₁ hd₂ hΔd hj
    have hq5 : 5 ≤ q := le_trans (le_max_left 5 _) hq
    have hq_jet : J_R.N_jet_R ≤ q :=
      le_trans (le_trans (le_max_left _ _) (le_max_right 5 _)) hq
    have hq_ge5 : (5 : ℝ) ≤ (q : ℝ) := by exact_mod_cast hq5
    have hq_pos : 0 < (q : ℝ) := by linarith
    have hq_nz : (q : ℝ) ≠ 0 := ne_of_gt hq_pos
    have hq_ge1 : 1 ≤ (q : ℝ) := by linarith
    have hpi_pos : 0 < Real.pi := Real.pi_pos
    have hpi_nz : Real.pi ≠ 0 := ne_of_gt hpi_pos
    obtain ⟨he_X₁, hτ_t₁, hτ_s₁, hneg_τ_s₁, ht₁, hs₁, _, ha₁, hb_p₁, hb_m₁, hg₁_1, hg₂_1, _, _⟩ :=
      hSingleJet q R w₁ d₁ j hq hR h8R hw₁ hd₁ hj
    obtain ⟨he_X₂, hτ_t₂, hτ_s₂, hneg_τ_s₂, ht₂, hs₂, _, ha₂, hb_p₂, hb_m₂, hg₁_2, hg₂_2, _, _⟩ :=
      hSingleJet q R w₂ d₂ j hq hR h8R hw₂ hd₂ hj
    let Δ_w : ℝ := realDiffSup (m + 15) w₁ w₂
    have hΔ_w_nn : 0 ≤ Δ_w := hDiffSup_nonneg w₁ w₂
    let Δ_base : ℝ := Δ / (q : ℝ) ^ 2 + Δ_w
    have hΔ_base_nn : 0 ≤ Δ_base := by positivity
    have hΔq3_le_q2 : Δ / (q : ℝ) ^ 3 ≤ Δ / (q : ℝ) ^ 2 := by
      refine div_le_div_of_nonneg_left hΔ (pow_pos hq_pos 2) ?_
      exact pow_le_pow_right₀ hq_ge1 (by norm_num : 2 ≤ 3)
    have hΔ_e : IsRealJetPerturb p (Δ / (q : ℝ) ^ 2) (fun x => d₁ (j + 1) x - d₂ (j + 1) x) :=
      hΔd.2.2.2.1 (j + 1) (by omega)
    have hΔ_τ_t : IsRealJetPerturb p (Δ / (q : ℝ) ^ 3)
        (fun x => (d₁ (j + 2) x - d₁ (j + 1) x) - (d₂ (j + 2) x - d₂ (j + 1) x)) :=
      hJet_congr (fun x => by ring) (hΔd.2.2.2.2 (j + 1) hj)
    have hΔ_τ_s : IsRealJetPerturb p (Δ / (q : ℝ) ^ 3)
        (fun x => (d₁ (j + 1) x - d₁ j x) - (d₂ (j + 1) x - d₂ j x)) :=
      hJet_congr (fun x => by ring) (hΔd.2.2.2.2 j (by omega))
    have hΔ_neg_τ_s : IsRealJetPerturb p (Δ / (q : ℝ) ^ 3)
        (fun x => -(d₁ (j + 1) x - d₁ j x) - -(d₂ (j + 1) x - d₂ j x)) :=
      hJet_congr (fun x => by ring) (hJet_neg hΔ_τ_s)
    let ρ : ℝ := 2 * Real.pi * ((j + 1 : ℕ) : ℝ) / (q : ℝ)
    obtain ⟨ha_lip_bnd, hb_p_lip_bnd⟩ :=
      J_R.jet_lip q ρ 1 (Δ / (q : ℝ) ^ 2) (Δ / (q : ℝ) ^ 3) w₁ w₂
        (d₁ (j + 1)) (fun x => d₁ (j + 2) x - d₁ (j + 1) x)
        (d₂ (j + 1)) (fun x => d₂ (j + 2) x - d₂ (j + 1) x)
        hq_jet (Or.inl rfl) (by positivity) (by positivity) hw₁ hw₂
        he_X₁ hτ_t₁ he_X₂ hτ_t₂ hΔ_e.2.2 hΔ_τ_t.2.2
    obtain ⟨_, hb_m_lip_bnd⟩ :=
      J_R.jet_lip q ρ (-1) (Δ / (q : ℝ) ^ 2) (Δ / (q : ℝ) ^ 3) w₁ w₂
        (d₁ (j + 1)) (fun x => -(d₁ (j + 1) x - d₁ j x))
        (d₂ (j + 1)) (fun x => -(d₂ (j + 1) x - d₂ j x))
        hq_jet (Or.inr rfl) (by positivity) (by positivity) hw₁ hw₂
        he_X₁ hneg_τ_s₁ he_X₂ hneg_τ_s₂ hΔ_e.2.2 hΔ_neg_τ_s.2.2
    have hΔ_a : IsRealJetPerturb p (J_R.C_jet_R * Δ_base)
        (fun x => J_R.a_R w₁ (x + ρ + d₁ (j + 1) x) - J_R.a_R w₂ (x + ρ + d₂ (j + 1) x)) :=
      ⟨(hJet_sub ha₁ ha₂).1, (hJet_sub ha₁ ha₂).2.1, ha_lip_bnd⟩
    have hΔ_bp : IsRealJetPerturb p (2 * J_R.C_jet_R * Δ_base)
        (fun x => J_R.b_R w₁ (x + ρ + d₁ (j + 1) x)
            (2 * Real.pi / (q : ℝ) + (d₁ (j + 2) x - d₁ (j + 1) x)) -
          J_R.b_R w₂ (x + ρ + d₂ (j + 1) x)
            (2 * Real.pi / (q : ℝ) + (d₂ (j + 2) x - d₂ (j + 1) x))) := by
      refine ⟨(hJet_sub hb_p₁ hb_p₂).1, (hJet_sub hb_p₁ hb_p₂).2.1, ?_⟩
      intro k hk x
      have h1 : |iteratedDeriv k
          (fun y => J_R.b_R w₁ (y + ρ + d₁ (j + 1) y)
              (2 * Real.pi / (q : ℝ) + (d₁ (j + 2) y - d₁ (j + 1) y)) -
            J_R.b_R w₂ (y + ρ + d₂ (j + 1) y)
              (2 * Real.pi / (q : ℝ) + (d₂ (j + 2) y - d₂ (j + 1) y))) x| ≤
          J_R.C_jet_R * (Δ / (q : ℝ) ^ 2 + Δ / (q : ℝ) ^ 3 + Δ_w) := by
        simpa only [one_mul] using hb_p_lip_bnd k hk x
      have h2 : J_R.C_jet_R * (Δ / (q : ℝ) ^ 2 + Δ / (q : ℝ) ^ 3 + Δ_w) ≤
          2 * J_R.C_jet_R * Δ_base := by
        dsimp [Δ_base]
        nlinarith
      exact le_trans h1 h2
    have hΔ_bm : IsRealJetPerturb p (2 * J_R.C_jet_R * Δ_base)
        (fun x => J_R.b_R w₁ (x + ρ + d₁ (j + 1) x)
            (-(2 * Real.pi / (q : ℝ) + (d₁ (j + 1) x - d₁ j x))) -
          J_R.b_R w₂ (x + ρ + d₂ (j + 1) x)
            (-(2 * Real.pi / (q : ℝ) + (d₂ (j + 1) x - d₂ j x)))) := by
      refine ⟨(hJet_sub hb_m₁ hb_m₂).1, (hJet_sub hb_m₁ hb_m₂).2.1, ?_⟩
      intro k hk x
      have heq_fn : (fun y => J_R.b_R w₁ (y + ρ + d₁ (j + 1) y)
            (-(2 * Real.pi / (q : ℝ) + (d₁ (j + 1) y - d₁ j y))) -
          J_R.b_R w₂ (y + ρ + d₂ (j + 1) y)
            (-(2 * Real.pi / (q : ℝ) + (d₂ (j + 1) y - d₂ j y)))) =
          (fun y => J_R.b_R w₁ (y + ρ + d₁ (j + 1) y)
            ((-1 : ℝ) * (2 * Real.pi / (q : ℝ)) + -(d₁ (j + 1) y - d₁ j y)) -
          J_R.b_R w₂ (y + ρ + d₂ (j + 1) y)
            ((-1 : ℝ) * (2 * Real.pi / (q : ℝ)) + -(d₂ (j + 1) y - d₂ j y))) := by
        funext y
        congr 2 <;> ring
      rw [heq_fn]
      have h1 := hb_m_lip_bnd k hk x
      have h2 : J_R.C_jet_R * (Δ / (q : ℝ) ^ 2 + Δ / (q : ℝ) ^ 3 + Δ_w) ≤
          2 * J_R.C_jet_R * Δ_base := by
        dsimp [Δ_base]
        nlinarith
      exact le_trans h1 h2
    have hΔ_t : IsRealJetPerturb p (Δ / (q : ℝ) ^ 3)
        (fun x => (2 * Real.pi / (q : ℝ) + (d₁ (j + 2) x - d₁ (j + 1) x)) -
          (2 * Real.pi / (q : ℝ) + (d₂ (j + 2) x - d₂ (j + 1) x))) :=
      hJet_congr (fun x => by ring) hΔ_τ_t
    have hΔ_s : IsRealJetPerturb p (Δ / (q : ℝ) ^ 3)
        (fun x => (2 * Real.pi / (q : ℝ) + (d₁ (j + 1) x - d₁ j x)) -
          (2 * Real.pi / (q : ℝ) + (d₂ (j + 1) x - d₂ j x))) :=
      hJet_congr (fun x => by ring) hΔ_τ_s
    have h_pow5_bnd : C_pow5 * (9 / (q : ℝ)) ^ 4 * (Δ / (q : ℝ) ^ 3) ≤
        (9 : ℝ) ^ 4 * C_pow5 * (Δ_base / (q : ℝ) ^ 5) := by
      have h1 : C_pow5 * (9 / (q : ℝ)) ^ 4 * (Δ / (q : ℝ) ^ 3) =
          (9 : ℝ) ^ 4 * C_pow5 * ((Δ / (q : ℝ) ^ 2) / (q : ℝ) ^ 5) := by
        field_simp [hq_nz]
      rw [h1]
      refine mul_le_mul_of_nonneg_left ?_ (by positivity)
      exact div_le_div_of_nonneg_right (by dsimp [Δ_base]; linarith) (by positivity)
    have hΔ_t5 := hJet_mono h_pow5_bnd (hJet_pow5_sub ht₁ ht₂ hΔ_t)
    have hΔ_s5 := hJet_mono h_pow5_bnd (hJet_pow5_sub hs₁ hs₂ hΔ_s)
    have hΔ_N : IsRealJetPerturb p (C_N_lip * (Δ_base / (q : ℝ) ^ 5))
        (fun x =>
          ((2 * Real.pi / (q : ℝ) + (d₁ (j + 2) x - d₁ (j + 1) x)) ^ 5 *
              J_R.b_R w₁ (x + ρ + d₁ (j + 1) x)
                (2 * Real.pi / (q : ℝ) + (d₁ (j + 2) x - d₁ (j + 1) x)) +
            (2 * Real.pi / (q : ℝ) + (d₁ (j + 1) x - d₁ j x)) ^ 5 *
              J_R.b_R w₁ (x + ρ + d₁ (j + 1) x)
                (-(2 * Real.pi / (q : ℝ) + (d₁ (j + 1) x - d₁ j x)))) -
          ((2 * Real.pi / (q : ℝ) + (d₂ (j + 2) x - d₂ (j + 1) x)) ^ 5 *
              J_R.b_R w₂ (x + ρ + d₂ (j + 1) x)
                (2 * Real.pi / (q : ℝ) + (d₂ (j + 2) x - d₂ (j + 1) x)) +
            (2 * Real.pi / (q : ℝ) + (d₂ (j + 1) x - d₂ j x)) ^ 5 *
              J_R.b_R w₂ (x + ρ + d₂ (j + 1) x)
                (-(2 * Real.pi / (q : ℝ) + (d₂ (j + 1) x - d₂ j x))))) := by
      have hp_sub := hJet_mul_sub (hJet_pow5 ht₂) hb_p₁ hΔ_t5 hΔ_bp
      have hm_sub := hJet_mul_sub (hJet_pow5 hs₂) hb_m₁ hΔ_s5 hΔ_bm
      refine hJet_congr (fun x => by ring) (hJet_mono ?_ (hJet_add hp_sub hm_sub))
      have h_eq : C_mul * (((9 : ℝ) ^ 4 * C_pow5 * (Δ_base / (q : ℝ) ^ 5)) * J_R.C_jet_R +
            (C_pow5 * (9 / (q : ℝ)) ^ 5) * (2 * J_R.C_jet_R * Δ_base)) +
          C_mul * (((9 : ℝ) ^ 4 * C_pow5 * (Δ_base / (q : ℝ) ^ 5)) * J_R.C_jet_R +
            (C_pow5 * (9 / (q : ℝ)) ^ 5) * (2 * J_R.C_jet_R * Δ_base)) =
          C_N_lip * (Δ_base / (q : ℝ) ^ 5) := by
        dsimp [C_N_lip]
        field_simp [hq_nz]
        ring
      linarith
    have hΔ_g₁ : IsRealJetPerturb p Δ_base
        (fun x => ((q : ℝ) / (4 * Real.pi)) *
            ((d₁ (j + 2) x - d₁ (j + 1) x) + (d₁ (j + 1) x - d₁ j x)) -
          ((q : ℝ) / (4 * Real.pi)) *
            ((d₂ (j + 2) x - d₂ (j + 1) x) + (d₂ (j + 1) x - d₂ j x))) := by
      have h1 := hJet_const_mul ((q : ℝ) / (4 * Real.pi)) (hJet_add hΔ_τ_t hΔ_τ_s)
      refine hJet_congr (fun x => by ring) (hJet_mono ?_ h1)
      rw [abs_of_pos (div_pos hq_pos (by positivity))]
      have h_eq : ((q : ℝ) / (4 * Real.pi)) * (Δ / (q : ℝ) ^ 3 + Δ / (q : ℝ) ^ 3) =
          (Δ / (q : ℝ) ^ 2) / (2 * Real.pi) := by
        field_simp [hq_nz, hpi_nz]
        ring
      rw [h_eq]
      have h_le1 : (Δ / (q : ℝ) ^ 2) / (2 * Real.pi) ≤ Δ / (q : ℝ) ^ 2 :=
        div_le_self (by positivity) (by linarith [Real.two_le_pi])
      dsimp [Δ_base]
      linarith
    have hΔ_g₂ : IsRealJetPerturb p (C_g2_lip * Δ_base)
        (fun x => 8 *
            ((2 * Real.pi / (q : ℝ) + (d₁ (j + 2) x - d₁ (j + 1) x)) ^ 2 +
              (2 * Real.pi / (q : ℝ) + (d₁ (j + 1) x - d₁ j x)) ^ 2) *
            J_R.a_R w₁ (x + ρ + d₁ (j + 1) x) -
          8 *
            ((2 * Real.pi / (q : ℝ) + (d₂ (j + 2) x - d₂ (j + 1) x)) ^ 2 +
              (2 * Real.pi / (q : ℝ) + (d₂ (j + 1) x - d₂ j x)) ^ 2) *
            J_R.a_R w₂ (x + ρ + d₂ (j + 1) x)) := by
      have hq2_ge1 : 1 ≤ (q : ℝ) ^ 2 := by nlinarith
      have hq4_ge_q2 : (q : ℝ) ^ 2 ≤ (q : ℝ) ^ 4 :=
        pow_le_pow_right₀ hq_ge1 (by norm_num : 2 ≤ 4)
      have h_sq_diff_bnd : C_mul * ((Δ / (q : ℝ) ^ 3) * (9 / (q : ℝ)) +
          (9 / (q : ℝ)) * (Δ / (q : ℝ) ^ 3)) ≤ 18 * C_mul * Δ_base := by
        have h_eq : C_mul * ((Δ / (q : ℝ) ^ 3) * (9 / (q : ℝ)) +
            (9 / (q : ℝ)) * (Δ / (q : ℝ) ^ 3)) = 18 * C_mul * (Δ / (q : ℝ) ^ 4) := by
          field_simp [hq_nz]
          ring
        rw [h_eq]
        refine mul_le_mul_of_nonneg_left ?_ (by positivity)
        have h1 : Δ / (q : ℝ) ^ 4 ≤ Δ / (q : ℝ) ^ 2 :=
          div_le_div_of_nonneg_left hΔ (pow_pos hq_pos 2) hq4_ge_q2
        dsimp [Δ_base]
        linarith
      have hΔ_t2 : IsRealJetPerturb p (18 * C_mul * Δ_base)
          (fun x => (2 * Real.pi / (q : ℝ) + (d₁ (j + 2) x - d₁ (j + 1) x)) ^ 2 -
            (2 * Real.pi / (q : ℝ) + (d₂ (j + 2) x - d₂ (j + 1) x)) ^ 2) :=
        hJet_congr' (hJet_mono h_sq_diff_bnd (hJet_mul_sub ht₂ ht₁ hΔ_t hΔ_t)) (fun x => by ring)
      have hΔ_s2 : IsRealJetPerturb p (18 * C_mul * Δ_base)
          (fun x => (2 * Real.pi / (q : ℝ) + (d₁ (j + 1) x - d₁ j x)) ^ 2 -
            (2 * Real.pi / (q : ℝ) + (d₂ (j + 1) x - d₂ j x)) ^ 2) :=
        hJet_congr' (hJet_mono h_sq_diff_bnd (hJet_mul_sub hs₂ hs₁ hΔ_s hΔ_s)) (fun x => by ring)
      have hΔ_ts2 : IsRealJetPerturb p (36 * C_mul * Δ_base)
          (fun x => ((2 * Real.pi / (q : ℝ) + (d₁ (j + 2) x - d₁ (j + 1) x)) ^ 2 +
              (2 * Real.pi / (q : ℝ) + (d₁ (j + 1) x - d₁ j x)) ^ 2) -
            ((2 * Real.pi / (q : ℝ) + (d₂ (j + 2) x - d₂ (j + 1) x)) ^ 2 +
              (2 * Real.pi / (q : ℝ) + (d₂ (j + 1) x - d₂ j x)) ^ 2)) :=
        hJet_congr' (hJet_mono (by linarith) (hJet_add hΔ_t2 hΔ_s2)) (fun x => by ring)
      have hts2_2 : IsRealJetPerturb p (162 * C_mul)
          (fun x => (2 * Real.pi / (q : ℝ) + (d₂ (j + 2) x - d₂ (j + 1) x)) ^ 2 +
            (2 * Real.pi / (q : ℝ) + (d₂ (j + 1) x - d₂ j x)) ^ 2) := by
        have ht2_2 := hJet_congr (fun x => (sq _).symm) (hJet_mul ht₂ ht₂)
        have hs2_2 := hJet_congr (fun x => (sq _).symm) (hJet_mul hs₂ hs₂)
        refine hJet_mono ?_ (hJet_add ht2_2 hs2_2)
        have h_eq : C_mul * (9 / (q : ℝ)) * (9 / (q : ℝ)) +
            C_mul * (9 / (q : ℝ)) * (9 / (q : ℝ)) = (162 * C_mul) / (q : ℝ) ^ 2 := by
          field_simp [hq_nz]
          ring
        rw [h_eq]
        exact div_le_self (by positivity) hq2_ge1
      have hprod_sub := hJet_const_mul 8 (hJet_mul_sub hts2_2 ha₁ hΔ_ts2 hΔ_a)
      refine hJet_congr (fun x => by ring) (hJet_mono ?_ hprod_sub)
      rw [abs_of_pos (by norm_num : (0 : ℝ) < 8)]
      have h_eq : 8 * (C_mul * ((36 * C_mul * Δ_base) * J_R.C_jet_R +
          (162 * C_mul) * (J_R.C_jet_R * Δ_base))) = C_g2_lip * Δ_base := by
        dsimp [C_g2_lip]
        ring
      linarith
    have hΔ_inv1 := hJet_inv_one_add_sub hg₁_1 hg₁_2 hΔ_g₁
    have hΔ_inv2 := hJet_inv_one_add_sub hg₂_1 hg₂_2 hΔ_g₂
    obtain ⟨_, hinv1_1⟩ := hJet_inv_one_add hg₁_1
    obtain ⟨_, hinv1_2⟩ := hJet_inv_one_add hg₁_2
    obtain ⟨_, hinv2_1⟩ := hJet_inv_one_add hg₂_1
    have hΔ_Q := hJet_mono (B₂ := C_Q_lip * Δ_base)
      (by
        have h_eq : C_mul * ((C_inv_lip * Δ_base) * C_inv +
            C_inv * (C_inv_lip * (C_g2_lip * Δ_base))) = C_Q_lip * Δ_base := by
          dsimp [C_Q_lip]
          ring
        linarith)
      (hJet_mul_sub hinv1_2 hinv2_1 hΔ_inv1 hΔ_inv2)
    have hQ₁ := hJet_mono (B₂ := C_mul * C_inv ^ 2)
      (by linarith [show C_mul * C_inv * C_inv = C_mul * C_inv ^ 2 by ring])
      (hJet_mul hinv1_1 hinv2_1)
    have hN₂ := hJet_mono (B₂ := C_N / (q : ℝ) ^ 5)
      (by
        have h_eq : C_mul * (C_pow5 * (9 / (q : ℝ)) ^ 5) * J_R.C_jet_R +
            C_mul * (C_pow5 * (9 / (q : ℝ)) ^ 5) * J_R.C_jet_R = C_N / (q : ℝ) ^ 5 := by
          dsimp [C_N]
          field_simp [hq_nz]
          ring
        linarith)
      (hJet_add (hJet_mul (hJet_pow5 ht₂) hb_p₂) (hJet_mul (hJet_pow5 hs₂) hb_m₂))
    have hΔ_NQ := hJet_mul_sub hN₂ hQ₁ hΔ_N hΔ_Q
    have hΔ_Force_raw := hJet_const_mul (-(2 * (q : ℝ) / Real.pi)) hΔ_NQ
    refine hJet_congr
      (fun x => by
        simp only [rdmc_elForcing, hj, ↓reduceIte, ρ]
        ring)
      (hJet_mono ?_ hΔ_Force_raw)
    rw [abs_neg, abs_of_pos (div_pos (by positivity) hpi_pos)]
    have h2q_le : 2 * (q : ℝ) / Real.pi ≤ (q : ℝ) :=
      (div_le_iff₀ hpi_pos).mpr (by nlinarith [Real.two_le_pi])
    have h_rhs_nn : 0 ≤ C_mul * ((C_N_lip * (Δ_base / (q : ℝ) ^ 5)) * (C_mul * C_inv ^ 2) +
        (C_N / (q : ℝ) ^ 5) * (C_Q_lip * Δ_base)) := by positivity
    have h1 := mul_le_mul_of_nonneg_right h2q_le h_rhs_nn
    have h2 : (q : ℝ) * (C_mul * ((C_N_lip * (Δ_base / (q : ℝ) ^ 5)) * (C_mul * C_inv ^ 2) +
        (C_N / (q : ℝ) ^ 5) * (C_Q_lip * Δ_base))) =
        C_force_lip * (Δ / (q : ℝ) ^ 6 + Δ_w / (q : ℝ) ^ 4) := by
      dsimp [C_force_lip, Δ_base]
      field_simp [hq_nz]
    linarith

  have hStationary : ∀ (q : ℕ) (R : ℝ) (w : ℝ → ℝ) (d : ℕ → ℝ → ℝ),
      N_force ≤ q → 0 ≤ R → 8 * R ≤ (q : ℝ) →
      IsPeriodicSmoothBounded (m + 15) M₁ w →
      rdmc_IsBoundedDispTuple p q R d →
      (∀ j : ℕ, j + 1 < q → ∀ x : ℝ,
        d (j + 2) x - 2 * d (j + 1) x + d j x = rdmc_elForcing J_R q w d (j + 1) x) →
      ∀ x : ℝ, IsStationaryRealMesh q w x
        (fun j => if j ≤ q then x + 2 * Real.pi * (j : ℝ) / (q : ℝ) + d j x else 0) := by
    intro q R w d hq hR h8R hw hd hsec x
    have hq5 : 5 ≤ q := le_trans (le_max_left 5 _) hq
    have hq_ge5 : (5 : ℝ) ≤ (q : ℝ) := by exact_mod_cast hq5
    have hq_pos : 0 < (q : ℝ) := by linarith
    have hq_nz : (q : ℝ) ≠ 0 := ne_of_gt hq_pos
    have hq_ge1 : 1 ≤ (q : ℝ) := by linarith
    have hpi_nz : Real.pi ≠ 0 := ne_of_gt Real.pi_pos
    let X : ℕ → ℝ := fun j => if j ≤ q then x + 2 * Real.pi * (j : ℝ) / (q : ℝ) + d j x else 0
    have hRq2_le_invq : R / (q : ℝ) ^ 2 ≤ (q : ℝ)⁻¹ := by
      rw [← one_div, div_le_div_iff₀ (pow_pos hq_pos 2) hq_pos]
      nlinarith
    have hRq3_le_invq : R / (q : ℝ) ^ 3 ≤ (q : ℝ)⁻¹ := by
      refine le_trans ?_ hRq2_le_invq
      refine div_le_div_of_nonneg_left hR (pow_pos hq_pos 2) ?_
      exact pow_le_pow_right₀ hq_ge1 (by norm_num : 2 ≤ 3)
    have hCand : IsCandidateRealMesh q x X := by
      refine ⟨?_, ?_, ?_, ?_, ?_⟩
      · simp [X, Nat.zero_le q, hd.1]
      · simp only [X, le_refl, ↓reduceIte, hd.2.1, Pi.zero_apply, add_zero]
        field_simp [hq_nz]
      · intro j hj
        simp only [X, hj, ↓reduceIte, add_sub_cancel_left]
        exact le_trans (hJet_eval (hd.2.2.2.1 j hj) x) hRq2_le_invq
      · intro j hj
        have hj0 : j ≤ q := by omega
        have hj1 : j + 1 ≤ q := by omega
        simp only [X, hj0, hj1, ↓reduceIte]
        have h_eq : (x + 2 * Real.pi * ((j + 1 : ℕ) : ℝ) / (q : ℝ) + d (j + 1) x -
            (x + 2 * Real.pi * (j : ℝ) / (q : ℝ) + d j x)) - 2 * Real.pi / (q : ℝ) =
            d (j + 1) x - d j x := by
          push_cast
          ring
        rw [h_eq]
        exact le_trans (hJet_eval (hd.2.2.2.2 j hj) x) hRq3_le_invq
      · intro j hj
        have hnot : ¬ j ≤ q := by omega
        simp [X, hnot]
    refine ⟨hCand, ?_⟩
    intro j hj
    obtain ⟨_, _, _, _, _, _, hts_le2, _, _, _, _, _, hg_low, _⟩ :=
      hSingleJet q R w d j hq hR h8R hw hd hj
    have hj0 : j ≤ q := by omega
    have hj1 : j + 1 ≤ q := by omega
    have hj2 : j + 2 ≤ q := by omega
    let τ_t : ℝ := d (j + 2) x - d (j + 1) x
    let τ_s : ℝ := d (j + 1) x - d j x
    let t : ℝ := 2 * Real.pi / (q : ℝ) + τ_t
    let s : ℝ := 2 * Real.pi / (q : ℝ) + τ_s
    have hX1 : X (j + 1) = x + 2 * Real.pi * ((j + 1 : ℕ) : ℝ) / (q : ℝ) + d (j + 1) x := by
      simp [X, hj1]
    have hX2 : X (j + 2) = X (j + 1) + t := by
      simp only [X, hj1, hj2, ↓reduceIte, t, τ_t]
      push_cast
      ring
    have hX0 : X j = X (j + 1) + (-s) := by
      simp only [X, hj0, hj1, ↓reduceIte, s, τ_s]
      push_cast
      ring
    change normAction1_ℝ w (X (j + 1)) (X (j + 2)) - normAction1_ℝ w (X (j + 1)) (X j) = 0
    rw [hX2, hX0, J_R.action_factor w hw (X (j + 1)) t (hts_le2 x).1,
      J_R.action_factor w hw (X (j + 1)) (-s) (hts_le2 x).2]
    let a : ℝ := J_R.a_R w (X (j + 1))
    let b_p : ℝ := J_R.b_R w (X (j + 1)) t
    let b_m : ℝ := J_R.b_R w (X (j + 1)) (-s)
    let g₁ : ℝ := ((q : ℝ) / (4 * Real.pi)) * (τ_t + τ_s)
    let g₂ : ℝ := 8 * (t ^ 2 + s ^ 2) * a
    have hg1_nz : 1 + g₁ ≠ 0 := by
      have h1 := (hg_low x).1
      linarith
    have hg2_nz : 1 + g₂ ≠ 0 := by
      have h2 : 1 / 2 ≤ 1 + g₂ := by
        dsimp only [g₂, a, t, s, τ_t, τ_s]
        rw [hX1]
        exact (hg_low x).2
      linarith
    have hts_diff : t - s = rdmc_elForcing J_R q w d (j + 1) x := by
      have h_alg : t - s = d (j + 2) x - 2 * d (j + 1) x + d j x := by
        dsimp [t, s, τ_t, τ_s]
        ring
      rw [h_alg, hsec j hj x]
    have hforce_val : rdmc_elForcing J_R q w d (j + 1) x =
        -(2 * (q : ℝ) / Real.pi) * ((t ^ 5 * b_p + s ^ 5 * b_m) * ((1 + g₁)⁻¹ * (1 + g₂)⁻¹)) := by
      simp only [rdmc_elForcing, hj, ↓reduceIte]
      dsimp [a, b_p, b_m, g₁, g₂, t, s, τ_t, τ_s]
      rw [hX1]
    have hden_fac : (t + s) * (1 / 8 + (t ^ 2 + s ^ 2) * a) =
        (Real.pi / (2 * (q : ℝ))) * (1 + g₁) * (1 + g₂) := by
      dsimp [g₁, g₂, t, s]
      field_simp [hq_nz, hpi_nz]
      ring
    have hpoly : t ^ 2 * (1 / 8 + a * t ^ 2 + t ^ 3 * b_p) -
        (-s) ^ 2 * (1 / 8 + a * (-s) ^ 2 + (-s) ^ 3 * b_m) =
        (t - s) * ((t + s) * (1 / 8 + (t ^ 2 + s ^ 2) * a)) + (t ^ 5 * b_p + s ^ 5 * b_m) := by
      ring
    change t ^ 2 * (1 / 8 + a * t ^ 2 + t ^ 3 * b_p) -
      (-s) ^ 2 * (1 / 8 + a * (-s) ^ 2 + (-s) ^ 3 * b_m) = 0
    rw [hpoly, hts_diff, hforce_val, hden_fac]
    field_simp [hq_nz, hpi_nz, hg1_nz, hg2_nz]
    ring

  
  let R_real : ℝ :=
    max (2 * C_force + 1) (max (4 * C_force_lip + 1) (3 * J_R.C_mid_R + 1))
  have hR_real_pos : 0 < R_real :=
    lt_of_lt_of_le (by positivity : 0 < 2 * C_force + 1) (le_max_left _ _)
  have h2C_le_R : 2 * C_force ≤ R_real :=
    le_trans (by linarith) (le_max_left _ _)
  have h4Lip_le_R : 4 * C_force_lip ≤ R_real :=
