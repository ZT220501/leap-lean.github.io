      hTK.pullback_meroEqOn hO_ov_open (fun p hp => ⟨hO_sub_tube hp, hp⟩) hId_inv
        (fun p _ => by simp only [Function.comp_apply, id_eq]; exact h_shift_right_inv H p)
        (hTK.pullback_id_self (M.L_mero i)) hComp
        ⟨fun _ h => ⟨h, h⟩, fun _ _ _ _ => rfl⟩ hO_sub_tube
    exact hTK.eq_symm hSymm
  exact M.no_patch_L_at_real 0 x₀ H ε' h0_r h_hL0_real hε'_pos hε'_lt_sbase
    ⟨g, δ_ov, hδ_ov_pos, hδ_ov_le, hg_eq_mero⟩

theorem tube_widths_and_cone_obstruction (Ω : Set Plane)
    (C : AnalyticGlancingCollar Ω)
    (M : MeromorphicCollarData C)
    (K : NonisotropicCurveData C M)
    (L : NormalizedGlobalLiftData C M K) :
    (M.h_X 0 = ⊤ → Nonempty (EntireTubeObstructionData C M K L)) ∧
    (∀ H : ℝ, M.h_X 0 = ENNReal.ofReal H →
      Nonempty (FiniteWallTubeObstructionData C M K L H)) :=
by
  obtain ⟨hEnt, hNoPatchFin⟩ := entire_tube_and_real_wall_no_patch Ω C M K L
  refine ⟨hEnt, ?_⟩
  intro H hH
  obtain ⟨hH_pos, hs_lt_H, h_ne_top, htube_eq, hbounds, hzero, heven, hlsc, htube_open, hdef_sub⟩ :=
    finite_wall_width_and_subharmonicity Ω C M K L H hH
  refine ⟨{
    h_X := finiteWallWidthFn M L
    tube_eq := htube_eq
    H_pos := hH_pos
    s_star_lt_H := hs_lt_H
    h_X_bounds := hbounds
    h_X_zero := hzero
    h_X_even := heven
    h_X_lsc := hlsc
    tube_open := htube_open
    deficit_subharmonic := hdef_sub
    no_patch_at_real_wall := ?_
    no_full_scale_cone_passage := ?_
  }⟩
  · intro t₀ x₀ ε ht₀ hε0 hεs
    have ht_mem : (t₀ : ℂ) ∈ Metric.ball (0 : ℂ) L.r_star := by
      rw [Metric.mem_ball, dist_zero_right, Complex.norm_real, Real.norm_eq_abs]
      exact ht₀
    exact hNoPatchFin H t₀ x₀ ε hH ht₀ (h_ne_top (t₀ : ℂ) ht_mem) hε0 hεs
  · intro δ_star hδ0 hδH
    obtain ⟨d₀_raw, hd₀_raw_pos, hEmpty⟩ :=
      quadratic_disk_cone_wall_contradiction Ω C M K L H δ_star hH hδ0 hδH
    refine ⟨min d₀_raw (min (δ_star / 6) (L.r_star / 4)), ?_, ?_⟩
    · exact lt_min hd₀_raw_pos (lt_min (by linarith) (by linarith [L.r_star_pos]))
    · intro d x₀ hd0 hd_lt
      rintro ⟨s_tilde, hs_holo, hs_maps, η, hη, hs_eq⟩
      have hd_raw : d < d₀_raw := lt_of_lt_of_le hd_lt (min_le_left _ _)
      have hd_rest : d < min (δ_star / 6) (L.r_star / 4) :=
        lt_of_lt_of_le hd_lt (min_le_right _ _)
      have hd_δ : d < δ_star / 6 := lt_of_lt_of_le hd_rest (min_le_left _ _)
      have hd_r : d < L.r_star / 4 := lt_of_lt_of_le hd_rest (min_le_right _ _)
      have hDual : Nonempty (ShiftedConeDualLines C M L H δ_star d x₀) :=
        cone_lift_to_shifted_dual_lines Ω C M K L H δ_star d x₀ hH hδ0 hδH hd0 hd_δ hd_r
          s_tilde hs_holo
          (fun p hp => hs_maps p hp.1 hp.2.1 hp.2.2.1 hp.2.2.2)
          η hη
          (fun p hp hdeep hηp => hs_eq p hp.1 hp.2.1 hdeep hp.2.2.1 hηp hp.2.2.2)
      obtain ⟨S⟩ := hDual
      exact @IsEmpty.false _ (hEmpty d x₀ hd0 hd_raw) S

theorem nonisotropic_global_shape_lift (Ω : Set Plane)
    (C : AnalyticGlancingCollar Ω)
    (M : MeromorphicCollarData C)
    (hNonIso : ¬ HasIsotropicCenter M)
    (hNonConst : ∃ x : ℝ, deriv (deriv C.ϕ) x ≠ 0) :
    Nonempty EntireNonisotropicStrip ∨ Nonempty FiniteWallNonisotropicStrip :=
by
  obtain ⟨K⟩ := nonisotropic_curve_and_collar_germ Ω C M hNonIso hNonConst
  obtain ⟨L⟩ := raw_global_shape_lift Ω C M K
  obtain ⟨P⟩ := speed_zeros_and_displacement Ω C M K L
  obtain ⟨hEntObs, hFinObs⟩ := tube_widths_and_cone_obstruction Ω C M K L
  have hs_lt_base : L.s_star < M.s_base := by
    linarith [L.s_star_le, K.s_init_le, M.s_base_pos]
  have h_lower_sub : horizStrip L.s_star ⊆ horizStrip M.s_base := by
    intro s hs
    exact lt_trans hs hs_lt_base
  have h_f_lower : ∀ s ∈ horizStrip L.s_star, K.f s ≠ 0 :=
    fun s hs => K.f_base_ne_zero s (h_lower_sub hs)
  have hr_lt_r₁ : L.r_star < C.r₁ := by
    linarith [L.r_star_le, K.r_init_le, M.r_base_lt_r₁, C.r₁_pos]
  rcases eq_top_or_lt_top (M.h_X 0) with hTop | hLtTop
  · obtain ⟨W_ent⟩ := hEntObs hTop
    have hMemUniv : ∀ s : ℂ, s ∈ horizStripENNR (M.h_X 0) := by
      intro s
      simp [horizStripENNR, hTop]
    have hStripUniv : horizStripENNR (M.h_X 0) = Set.univ :=
      Set.eq_univ_of_forall hMemUniv
    refine Or.inl ⟨{
      c := C.c
      s_star := L.s_star
      r_star := L.r_star
      c_pos := C.c_pos
      s_star_pos := L.s_star_pos
      r_star_pos := L.r_star_pos
      r_star_lt_half_s_star := L.r_star_lt_half_s_star
      r_star_lt_pi := L.r_star_lt_pi
      ϕ := K.ϕ
      f := K.f
      q := P.q
      ϕ_entire := differentiableOn_univ.mp (hStripUniv ▸ K.ϕ_holo)
      f_entire := differentiableOn_univ.mp (hStripUniv ▸ K.f_holo)
      q_entire := differentiableOn_univ.mp (hStripUniv ▸ P.q_holo)
      deriv_ϕ := fun s => K.deriv_ϕ s (hMemUniv s)
      deriv2_f := fun s => P.deriv2_f s (hMemUniv s)
      ϕ_quasiperiodic := fun s => K.ϕ_quasiperiodic s (hMemUniv s)
      f_periodic := fun s => K.f_periodic s (hMemUniv s)
      q_periodic := fun s => P.q_periodic s (hMemUniv s)
      ϕ_conj := fun s => K.ϕ_conj s (hMemUniv s)
      f_conj := fun s => K.f_conj s (hMemUniv s)
      q_conj := fun s => P.q_conj s (hMemUniv s)
      f_real_pos := K.f_real_pos
      f_lower_strip_ne_zero := h_f_lower
      f_nonconstant := K.f_nonconstant
      f_simple_zeros := fun s hfs => P.f_simple_zeros s (hMemUniv s) hfs
      Γ0 := K.Γ
      Γ0_holo := ⟨fun s hs =>
          (K.Γ_reg_holo s (hMemUniv s) (h_f_lower s hs)).1.differentiableWithinAt,
        fun s hs =>
          (K.Γ_reg_holo s (hMemUniv s) (h_f_lower s hs)).2.differentiableWithinAt⟩
      Γ0_deriv₀ := fun s hs => K.Γ_deriv₀ s (hMemUniv s) (h_f_lower s hs)
      Γ0_deriv₁ := fun s hs => K.Γ_deriv₁ s (hMemUniv s) (h_f_lower s hs)
      Γ0_periodic := fun s hs => K.Γ_periodic s (hMemUniv s) (h_f_lower s hs)
      Γ0_conj := fun s hs => K.Γ_conj s (hMemUniv s) (h_f_lower s hs)
      T := L.T_norm
      T_open := W_ent.T_open
      T_base_subset := W_ent.T_base_subset
      T_param_subset := W_ent.T_param_subset
      T_vertically_star_shaped := W_ent.T_vertically_star_shaped
      T_horiz_invariant := W_ent.T_horiz_invariant
      T_even := W_ent.T_even
      T_conj := W_ent.T_conj
      𝔰 := L.𝔰
      𝔰_holo := L.𝔰_holo
      𝔰_zero := fun y => L.𝔰_zero y (hMemUniv y)
      𝔰_quasiperiodic := fun y t hyt => L.𝔰_quasiperiodic (y, t) hyt
      𝔰_even := fun y t hyt => L.𝔰_even (y, t) hyt
      𝔰_conj := fun y t hyt => L.𝔰_conj (y, t) hyt
      𝔰_mean_zero := L.𝔰_mean_zero
      𝔰_lower_strip_im := L.𝔰_lower_strip_im
      θ_edge := fun x t => (L.Θ_gl ((x : ℂ) + (t : ℂ) / 2, (t : ℂ))).re
      ℓ_chord := P.ℓ_chord
      real_collar_reflection := by
        intro x t ht0 htr
        obtain ⟨_, _, h1, h2, h3, h4, h5, h6, h7, h8, h9, _⟩ :=
          P.real_collar_chord x t ht0 htr
        have hsub : (((x - t : ℝ) : ℂ) + (t : ℂ) / 2, (t : ℂ)) =
            ((x : ℂ) - (t : ℂ) / 2, (t : ℂ)) := by
          ext <;> push_cast <;> ring
        have hper : (((x + 2 * Real.pi : ℝ) : ℂ) + (t : ℂ) / 2, (t : ℂ)) =
            ((x : ℂ) + 2 * (Real.pi : ℂ) + (t : ℂ) / 2, (t : ℂ)) := by
          ext <;> push_cast <;> ring
        refine ⟨h1, h2, ?_, ?_, h5, h6, h7, h8, h9⟩
        · rw [hsub]; exact h3
        · rw [hper]; exact h4
      real_vertical_promotion := W_ent.real_vertical_promotion
    }⟩
  · let H : ℝ := (M.h_X 0).toReal
    have hH : M.h_X 0 = ENNReal.ofReal H :=
      (ENNReal.ofReal_toReal (ne_of_lt hLtTop)).symm
    obtain ⟨W_fin⟩ := hFinObs H hH
    have hStrip : horizStripENNR (M.h_X 0) = horizStrip H := by
      ext s
      change ENNReal.ofReal |s.im| < M.h_X 0 ↔ |s.im| < H
      rw [hH]
      exact ENNReal.ofReal_lt_ofReal_iff W_fin.H_pos
    have hTubeMem : ∀ p : ℂ × ℂ, p ∈ finiteWallTube L.r_star W_fin.h_X →
        p ∈ shiftedMeroTube L.r_star M.h_X L.b_shift := by
      intro p hp
      rwa [W_fin.tube_eq] at hp
    refine Or.inr ⟨{
      H := H
      c := C.c
      s_star := L.s_star
      r_star := L.r_star
      H_pos := W_fin.H_pos
      c_pos := C.c_pos
      r_star_pos := L.r_star_pos
      s_star_pos := L.s_star_pos
      s_star_lt_H := W_fin.s_star_lt_H
      r_star_lt_half_s_star := L.r_star_lt_half_s_star
      r_star_lt_pi := L.r_star_lt_pi
      ϕ := K.ϕ
      f := K.f
      q := P.q
      ϕ_holo := hStrip ▸ K.ϕ_holo
      f_holo := hStrip ▸ K.f_holo
      q_holo := hStrip ▸ P.q_holo
      deriv_ϕ := fun s hs => K.deriv_ϕ s (hStrip.symm ▸ hs)
      deriv2_f := fun s hs => P.deriv2_f s (hStrip.symm ▸ hs)
      ϕ_quasiperiodic := fun s hs => K.ϕ_quasiperiodic s (hStrip.symm ▸ hs)
      f_periodic := fun s hs => K.f_periodic s (hStrip.symm ▸ hs)
      q_periodic := fun s hs => P.q_periodic s (hStrip.symm ▸ hs)
      ϕ_conj := fun s hs => K.ϕ_conj s (hStrip.symm ▸ hs)
      f_conj := fun s hs => K.f_conj s (hStrip.symm ▸ hs)
      q_conj := fun s hs => P.q_conj s (hStrip.symm ▸ hs)
      f_real_pos := K.f_real_pos
      f_lower_strip_ne_zero := h_f_lower
      f_nonconstant := K.f_nonconstant
      f_simple_zeros := fun s hs hfs => P.f_simple_zeros s (hStrip.symm ▸ hs) hfs
      Γ := K.Γ
      H0 := P.H0
      Γ_mero := hStrip ▸ K.Γ_mero
      H0_holo := hStrip ▸ P.H0_holo
      H0_periodic := fun s hs => P.H0_periodic s (hStrip.symm ▸ hs)
      H0_conj := fun s hs => P.H0_conj s (hStrip.symm ▸ hs)
      Γ_reg_holo := fun s hs hfs => K.Γ_reg_holo s (hStrip.symm ▸ hs) hfs
      Γ_deriv₀ := fun s hs hfs => K.Γ_deriv₀ s (hStrip.symm ▸ hs) hfs
      Γ_deriv₁ := fun s hs hfs => K.Γ_deriv₁ s (hStrip.symm ▸ hs) hfs
      Γ_periodic := fun s hs hfs => K.Γ_periodic s (hStrip.symm ▸ hs) hfs
      Γ_conj := fun s hs hfs => K.Γ_conj s (hStrip.symm ▸ hs) hfs
      H0_eq := fun s hs hfs => P.H0_eq s (hStrip.symm ▸ hs) hfs
      H0_deriv := fun s hs hfs => P.H0_deriv s (hStrip.symm ▸ hs) hfs
      h_X := W_fin.h_X
      h_X_bounds := W_fin.h_X_bounds
      h_X_zero := W_fin.h_X_zero
      h_X_even := W_fin.h_X_even
      h_X_lsc := W_fin.h_X_lsc
      tube_open := W_fin.tube_open
      deficit_subharmonic := W_fin.deficit_subharmonic
      𝔰 := L.𝔰
      V := P.V
      A := C.A
      Θ_gl := L.Θ_gl
      p_gl := L.p_gl
      ℓ_chord := P.ℓ_chord
      𝔰_holo := W_fin.tube_eq.symm ▸ L.𝔰_holo
      𝔰_maps_to := fun p hp => hStrip ▸ L.𝔰_maps_to p (hTubeMem p hp)
      𝔰_lower_strip_im := L.𝔰_lower_strip_im
      𝔰_zero := fun y hy => L.𝔰_zero y (hStrip.symm ▸ hy)
      𝔰_quasiperiodic := fun p hp => L.𝔰_quasiperiodic p (hTubeMem p hp)
      𝔰_even := fun p hp => L.𝔰_even p (hTubeMem p hp)
      𝔰_conj := fun p hp => L.𝔰_conj p (hTubeMem p hp)
      𝔰_mean_zero := L.𝔰_mean_zero
      V_holo := hStrip ▸ P.V_holo
      V_periodic := fun s hs => P.V_periodic s (hStrip.symm ▸ hs)
      V_conj := fun s hs => P.V_conj s (hStrip.symm ▸ hs)
      V_mean_zero := P.V_mean_zero
      𝔰_deriv_t_zero := fun y hy => P.𝔰_deriv_t_zero y (hStrip.symm ▸ hy)
      𝔰_deriv2_t_zero := fun y hy => P.𝔰_deriv2_t_zero y (hStrip.symm ▸ hy)
      V_deriv := fun s hs => P.V_deriv s (hStrip.symm ▸ hs)
      Θ_gl_holo := L.Θ_gl_holo
      p_gl_holo := L.p_gl_holo
      A_holo := C.A_holo.mono (Metric.ball_subset_ball (le_of_lt hr_lt_r₁))
      A_odd := fun t ht => C.A_odd t (Metric.ball_subset_ball (le_of_lt hr_lt_r₁) ht)
      A_conj := fun t ht => C.A_conj t (Metric.ball_subset_ball (le_of_lt hr_lt_r₁) ht)
      A_deriv_zero := C.A_deriv_zero
      A_real_pos := fun t ht0 htr => C.A_real_pos t ht0 (lt_trans htr hr_lt_r₁)
      symplectic_gl := L.symplectic_gl
      real_collar_chord := P.real_collar_chord
      no_patch_at_real_wall := W_fin.no_patch_at_real_wall
      no_full_scale_cone_passage := W_fin.no_full_scale_cone_passage
    }⟩

theorem shape_strip_dichotomy (Ω : Set Plane)
    (hΩ : IsSmoothPositivelyCurvedBilliardDomain Ω)
    (C : AnalyticGlancingCollar Ω) :
    HasTrigSpeed C.toSupportLazutkinData ∨
      Nonempty EntireNonisotropicStrip ∨
      Nonempty FiniteWallNonisotropicStrip :=
by
  let _ := hΩ
  obtain ⟨hDet⟩ := chain_endpoint_determination Ω C
  obtain ⟨M⟩ := meromorphic_wall_and_no_patch Ω C hDet
  by_cases hIso : HasIsotropicCenter M
  · exact Or.inl (isotropic_center_trig_speed Ω C M hIso)
  · by_cases hNonConst : ∃ x : ℝ, deriv (deriv C.ϕ) x ≠ 0
    · exact Or.inr (nonisotropic_global_shape_lift Ω C M hIso hNonConst)
    · left
      have hZero : ∀ x : ℝ, deriv (deriv C.ϕ) x = 0 :=
        fun x => not_ne_iff.mp (forall_not_of_not_exists hNonConst x)
      have hϕ2 : ContDiff ℝ ((1 : WithTop ℕ∞) + 1) C.ϕ :=
        C.ϕ_smooth.of_le (by decide)
      have hderiv_diff : Differentiable ℝ (deriv C.ϕ) :=
        hϕ2.deriv'.differentiable_one
      have hconst : ∀ x y : ℝ, deriv C.ϕ x = deriv C.ϕ y :=
        is_const_of_deriv_eq_zero hderiv_diff hZero
      refine ⟨0, (deriv C.ϕ 0) ^ 2, 0, ?_⟩
      intro x
      simp [hconst x 0]

theorem volterra_unit_interval_kernels : SfcaVolterraKernelProp :=
by
  have huIcc_01 : Set.uIcc (0 : ℝ) 1 = Set.Icc (0 : ℝ) 1 := Set.uIcc_of_le zero_le_one
  have huIcc_sub : ∀ {w : ℝ}, w ∈ Set.Icc (0 : ℝ) 1 → Set.uIcc (0 : ℝ) w ⊆ Set.Icc (0 : ℝ) 1 := by
    intro w hw
    rw [Set.uIcc_of_le hw.1]
    exact Set.Icc_subset_Icc_right hw.2
  have huIoc_sub : ∀ {w : ℝ}, w ∈ Set.Icc (0 : ℝ) 1 → Set.uIoc (0 : ℝ) w ⊆ Set.Icc (0 : ℝ) 1 := by
    intro w hw
    exact Set.uIoc_subset_uIcc.trans (huIcc_sub hw)
  have hPrim_cont : ∀ {f : ℝ → ℂ}, ContinuousOn f (Set.Icc (0 : ℝ) 1) →
      ContinuousOn (fun w => ∫ v in (0 : ℝ)..w, f v) (Set.Icc (0 : ℝ) 1) := by
    intro f hf
    rw [← huIcc_01]
    exact intervalIntegral.continuousOn_primitive_interval
      (hf.integrableOn_Icc.mono_set (by rw [huIcc_01]))
  have hPrim_deriv : ∀ {f : ℝ → ℂ}, ContinuousOn f (Set.Icc (0 : ℝ) 1) →
      ∀ w ∈ Set.Ioo (0 : ℝ) 1, HasDerivAt (fun u => ∫ v in (0 : ℝ)..u, f v) (f w) w := by
    intro f hf w hw
    have hw_Icc : w ∈ Set.Icc (0 : ℝ) 1 := Set.Ioo_subset_Icc_self hw
    apply intervalIntegral.integral_hasDerivAt_right
    · exact (hf.mono (huIcc_sub hw_Icc)).intervalIntegrable
    · exact (hf.mono Set.Ioo_subset_Icc_self).stronglyMeasurableAtFilter isOpen_Ioo w hw
    · exact hf.continuousAt (Icc_mem_nhds hw.1 hw.2)
  have hKernel_split : ∀ {f : ℝ → ℂ}, ContinuousOn f (Set.Icc (0 : ℝ) 1) →
      ∀ w ∈ Set.Icc (0 : ℝ) 1,
        (∫ v in (0 : ℝ)..w, ((w - v : ℝ) : ℂ) * f v) =
          (w : ℂ) * (∫ v in (0 : ℝ)..w, f v) - ∫ v in (0 : ℝ)..w, (v : ℂ) * f v := by
    intro f hf w hw
    have hf_int : IntervalIntegrable f MeasureTheory.volume 0 w :=
      (hf.mono (huIcc_sub hw)).intervalIntegrable
    have hvf_cont : ContinuousOn (fun v : ℝ => (v : ℂ) * f v) (Set.Icc (0 : ℝ) 1) :=
      Complex.continuous_ofReal.continuousOn.mul hf
    have hvf_int : IntervalIntegrable (fun v : ℝ => (v : ℂ) * f v) MeasureTheory.volume 0 w :=
      (hvf_cont.mono (huIcc_sub hw)).intervalIntegrable
    have h_congr : (∫ v in (0 : ℝ)..w, ((w - v : ℝ) : ℂ) * f v) =
        ∫ v in (0 : ℝ)..w, ((w : ℂ) * f v - (v : ℂ) * f v) := by
      refine intervalIntegral.integral_congr (fun v _ => ?_)
      push_cast
      ring
    rw [h_congr, intervalIntegral.integral_sub (hf_int.const_mul (w : ℂ)) hvf_int,
      intervalIntegral.integral_const_mul]
  have hPicard1D : ∀ {Q y₀ : ℝ → ℂ} {M : ℝ},
      ContinuousOn Q (Set.Icc (0 : ℝ) 1) →
      0 ≤ M →
      (∀ w ∈ Set.Icc (0 : ℝ) 1, ‖Q w‖ ≤ M) →
      ContinuousOn y₀ (Set.Icc (0 : ℝ) 1) →
      (∀ w ∈ Set.Icc (0 : ℝ) 1, ‖y₀ w‖ ≤ 1) →
      (∀ m : ℕ, ContinuousOn (sfcaVolterraIter y₀ Q m) (Set.Icc (0 : ℝ) 1) ∧
        ∀ w ∈ Set.Icc (0 : ℝ) 1,
          ‖sfcaVolterraIter y₀ Q m w‖ ≤ (M * w) ^ m / (m.factorial : ℝ) ∧
          ‖sfcaVolterraIter y₀ Q m w‖ ≤ M ^ m / (m.factorial : ℝ)) ∧
      ContinuousOn (fun w => ∑' m : ℕ, sfcaVolterraIter y₀ Q m w) (Set.Icc (0 : ℝ) 1) ∧
      (∀ w ∈ Set.Icc (0 : ℝ) 1,
        (∑' m : ℕ, sfcaVolterraIter y₀ Q m w) =
          y₀ w + ∫ v in (0 : ℝ)..w,
            ((w - v : ℝ) : ℂ) * Q v * (∑' m : ℕ, sfcaVolterraIter y₀ Q m v)) := by
    intro Q y₀ M hQ hM0 hQbnd hy₀_cont hy₀_bnd
    have hIter : ∀ m : ℕ, ContinuousOn (sfcaVolterraIter y₀ Q m) (Set.Icc (0 : ℝ) 1) ∧
        ∀ w ∈ Set.Icc (0 : ℝ) 1,
          ‖sfcaVolterraIter y₀ Q m w‖ ≤ (M * w) ^ m / (m.factorial : ℝ) := by
      intro m
      induction m with
      | zero =>
