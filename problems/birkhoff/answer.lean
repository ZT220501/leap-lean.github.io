    have h0_base : (0 : ℂ) ∈ horizStrip (K.s_init / 2) := by
      show |(0 : ℂ).im| < K.s_init / 2
      simp [half_pos K.s_init_pos]
    let g₀ : ℂ → ℂ := fun y => L.𝔰_raw (y, t₀)
    let g_m : ℂ → ℂ := fun y => L.𝔰_raw (y - t₀, t₀)
    let J_slice : ℂ → ℂ := fun y =>
      deriv (fun y' : ℂ => L.𝔰_raw (y', t₀)) y * deriv (fun t' : ℂ => L.𝔰_raw (y - t', t')) t₀ -
      deriv (fun t' : ℂ => L.𝔰_raw (y, t')) t₀ * deriv (fun y' : ℂ => L.𝔰_raw (y' - t₀, t₀)) y
    have hSlice_W₁ : Set.MapsTo (fun y : ℂ => (y, t₀)) (horizStrip H') W₁ :=
      fun _ hy => ⟨hy, ht₀_δ₁⟩
    have hSlice_diff : Differentiable ℂ (fun y : ℂ => (y, t₀)) :=
      differentiable_id.prodMk (differentiable_const t₀)
    have hg₀_maps : ∀ y ∈ horizStrip H', g₀ y ∈ D_H :=
      fun y hy => L.𝔰_raw_maps_to (y, t₀) (hW₁_sub (y, t₀) ⟨hy, ht₀_δ₁⟩).1
    have hgm_maps : ∀ y ∈ horizStrip H', g_m y ∈ D_H :=
      fun y hy => L.𝔰_raw_maps_to (y - t₀, t₀) (hW₁_sub (y, t₀) ⟨hy, ht₀_δ₁⟩).2
    have hg₀_holo : DifferentiableOn ℂ g₀ (horizStrip H') :=
      hF₁_holo.comp hSlice_diff.differentiableOn hSlice_W₁
    have hgm_holo : DifferentiableOn ℂ g_m (horizStrip H') :=
      hF₂_holo.comp hSlice_diff.differentiableOn hSlice_W₁
    have hJ_holo : DifferentiableOn ℂ J_slice (horizStrip H') := by
      have hBall_t₀_sub : Metric.ball t₀ (δ₁ - t_real) ⊆ Metric.ball (0 : ℂ) δ₁ := by
