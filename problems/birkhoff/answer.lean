  have hψ_bot_eq : ∀ t : ℝ,
      ‖g ((t : ℂ) - (H_p : ℂ) * Complex.I)‖ ^ 2 = ψ t := by
    intro t
    have h_conj_pt : starRingEnd ℂ ((t : ℂ) + (H_p : ℂ) * Complex.I) =
