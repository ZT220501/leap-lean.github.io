      have him_exp : -(Complex.exp w').im = Real.exp w'.re * Real.cos η_im := by
        rw [← hre_iu, hiu, hexp_re_z]
      have hre_exp : (Complex.exp w').re = Real.exp w'.re * Real.sin η_im := by
