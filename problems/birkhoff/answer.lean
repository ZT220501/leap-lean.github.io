      have hRm1_le_12 : ‖w_m (u₁ : ℂ)‖ ^ 2 ≤ 12 * ‖w_m (u₂ : ℂ)‖ ^ 2 := by linarith
      have h_exp_le : Real.exp (B * c₁ * (u₂ - u₁)) ≤ Real.exp (Real.log 12) := by
        rw [Real.exp_log (by norm_num : (0 : ℝ) < 12)]
        exact le_of_mul_le_mul_right (le_trans h_gr hRm1_le_12) hRm2_pos
