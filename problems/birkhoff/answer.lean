      ring
    rw [hV_norm_sq, div_le_iff₀ (by positivity)]
    have h_f6 : 4 * (‖f_j‖ ^ 2) ^ 3 ≤
        S.c ^ 2 * (32 * S.c * Real.exp (3 * M ^ σ - (9 / 8 : ℝ) * H_star)) := by
      have h_cube : (‖f_j‖ ^ 2) ^ 3 ≤
