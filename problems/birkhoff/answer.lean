          have h_pow_y : ‖y‖ ^ k ≤ R ^ k := pow_le_pow_left₀ (norm_nonneg y) hy_le k
          have h_k2 : ((k + 1 : ℕ) : ℝ) ≤ (2 : ℝ) ^ (k + 1) := by
            exact_mod_cast (Nat.lt_two_pow_self (n := k + 1)).le
          have h_2R : ((k + 1 : ℕ) : ℝ) * ‖y‖ ^ k ≤ (2 * R) ^ (k + 1) := by
