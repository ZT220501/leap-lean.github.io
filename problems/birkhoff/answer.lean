      rw [← hfderiv_eq]
      exact Complex.norm_fderiv_le_div_of_mapsTo_ball hg_diff hg_maps hη_b_pos
    have h_has_int : HasFDerivAt
        (fun p => ∫ θ in (0 : ℝ)..(2 * Real.pi), ℱ p θ)
        (∫ θ in (0 : ℝ)..(2 * Real.pi), ℱ' p₀ θ) p₀ :=
      intervalIntegral.hasFDerivAt_integral_of_dominated_of_fderiv_le
        (Metric.ball_mem_nhds p₀ hη_b_pos)
        h_meas_F
        h_int_p₀
        h_meas_F'
        (Filter.Eventually.of_forall fun θ _ p hp => h_bound θ p hp)
        intervalIntegrable_const
        (Filter.Eventually.of_forall fun θ _ p hp =>
          h_fderiv_q p (h_ball_sub_cb p hp (Metric.mem_ball_self hη_b_pos)) θ)
    exact (h_has_int.differentiableAt.const_mul (((2 * Real.pi)⁻¹ : ℝ) : ℂ)).differentiableWithinAt

  let F_tilde : ℂ × ℂ → ℂ := fun p =>
    (((2 * Real.pi)⁻¹ : ℝ) : ℂ) *
      ∫ θ in (0 : ℝ)..(2 * Real.pi),
