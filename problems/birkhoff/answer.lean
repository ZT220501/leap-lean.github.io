      have h_shift_g' := (hasSum_nat_add_iff' 1).mpr hg'_sum.hasSum
      rw [Finset.sum_range_one] at h_shift_g'
      have hg'0 : g' 0 z₀ = 0 := rfl
      rw [hg'0, sub_zero] at h_shift_g'
      have h_tsum_eq : (∑' k : ℕ, ((k + 1 : ℕ) : ℂ) * c (k + 1) * z₀ ^ k) = ∑' m : ℕ, g' m z₀ :=
        h_shift_g'.tsum_eq
      constructor
      · rwa [h_tsum_eq]
      · rw [h_tsum_eq]
        have hm := (hg'_sum.hasSum).mul_left z₀
        refine hm.congr_fun ?_
        intro m
        cases m with
        | zero => simp [g']
        | succ k =>
          simp only [g', Nat.cast_add, Nat.cast_one]
          rw [pow_succ]
          ring
    exact ⟨h_sum, h_zero, h_peel, fun z => (h_deriv_and_euler z).1,
      fun z => (h_deriv_and_euler z).2⟩

  
  
  
  let cPhi1 : ℕ → ℂ := fun m => (-1 / 4 : ℂ) ^ m / ((2 * m + 3).factorial : ℂ)
