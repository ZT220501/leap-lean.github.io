      rw [hrew] at htel
      have hmul := congrArg ((q : ℂ)⁻¹ * ·) htel
      have hrhs : (q : ℂ)⁻¹ * ((q : ℂ) * f y) = f y := by field_simp [hq_C_ne]
      have hlhs : (q : ℂ)⁻¹ *
            (((∑ j ∈ Finset.range q, (j : ℂ) * f ((y + (t₀ : ℂ)) + (j : ℂ) * (t₀ : ℂ))) -
              (∑ j ∈ Finset.range q, (j : ℂ) * f (y + (j : ℂ) * (t₀ : ℂ)))) +
            (∑ j ∈ Finset.range q, f ((y + (t₀ : ℂ)) + (j : ℂ) * (t₀ : ℂ)))) =
          (RampOp f (y + (t₀ : ℂ)) - RampOp f y) + PiOp f (y + (t₀ : ℂ)) := by
        dsimp [RampOp, PiOp]
        ring
      rw [hlhs, hrhs, hPi_shift f hf_per y hy] at hmul
      linear_combination hmul
    have hK_diff : ∀ (f : ℂ → ℂ),
        DifferentiableOn ℂ f (horizStrip σ) →
        (∀ y ∈ horizStrip σ, f (y + 2 * Real.pi) = f y) →
        ∀ y ∈ horizStrip σ,
          glancingDiffOp (fun p => KOp f p.1) (y, (t₀ : ℂ)) = f y - PiOp f y := by
      intro f hf_holo hf_per y hy
      rw [h_ftc_1d (KOp f) (hK_holo f hf_holo) y hy]
      have hk_plus : KOp f (y + (t₀ : ℂ) / 2) = (t₀ : ℂ) * RampOp f (y + (t₀ : ℂ)) := by
        dsimp [KOp, RampOp]
        congr 2
        refine Finset.sum_congr rfl (fun j _ => ?_)
        congr 1
        have h1 : (y + (t₀ : ℂ) / 2 + (j : ℂ) * (t₀ : ℂ)) + (t₀ : ℂ) / 2 =
            (y + (t₀ : ℂ)) + (j : ℂ) * (t₀ : ℂ) := by ring
        rw [h1]
      have hk_minus : KOp f (y - (t₀ : ℂ) / 2) = (t₀ : ℂ) * RampOp f y := by
        dsimp [KOp, RampOp]
        congr 2
        refine Finset.sum_congr rfl (fun j _ => ?_)
        congr 1
        have h1 : (y - (t₀ : ℂ) / 2 + (j : ℂ) * (t₀ : ℂ)) + (t₀ : ℂ) / 2 =
            y + (j : ℂ) * (t₀ : ℂ) := by ring
        rw [h1]
      rw [hk_plus, hk_minus]
      have hcancel : (t₀ : ℂ)⁻¹ * ((t₀ : ℂ) * RampOp f (y + (t₀ : ℂ)) - (t₀ : ℂ) * RampOp f y) =
          RampOp f (y + (t₀ : ℂ)) - RampOp f y := by
        field_simp [ht₀_C]
      rw [hcancel]
      exact hRamp_shift f hf_per y hy
    have hPi_Edot : ∀ y ∈ horizStrip σ, PiOp E_dot y = 0 := by
      intro y hy
      have htel := Finset.sum_range_sub
        (fun j : ℕ => g_init ((y - (t₀ : ℂ) / 2) + (j : ℂ) * (t₀ : ℂ))) q
      simp only [Nat.cast_zero, zero_mul, add_zero] at htel
      rw [h_per_qt g_init hg_per (y - (t₀ : ℂ) / 2) (hStrip_half_sub y hy), sub_self] at htel
      dsimp [PiOp]
      have hsum_eq : (∑ j ∈ Finset.range q, E_dot (y + (j : ℂ) * (t₀ : ℂ))) =
          (t₀ : ℂ)⁻¹ * ∑ j ∈ Finset.range q,
            (g_init ((y - (t₀ : ℂ) / 2) + ((j + 1 : ℕ) : ℂ) * (t₀ : ℂ)) -
              g_init ((y - (t₀ : ℂ) / 2) + (j : ℂ) * (t₀ : ℂ))) := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        have hwj : y + (j : ℂ) * (t₀ : ℂ) ∈ horizStrip σ := hStrip_jt y j hy
        rw [hE_eq _ hwj, h_ftc_1d g_init hg_holo _ hwj]
        congr 1
        have hp1 : (y + (j : ℂ) * (t₀ : ℂ)) + (t₀ : ℂ) / 2 =
            (y - (t₀ : ℂ) / 2) + ((j + 1 : ℕ) : ℂ) * (t₀ : ℂ) := by push_cast; ring
        have hm1 : (y + (j : ℂ) * (t₀ : ℂ)) - (t₀ : ℂ) / 2 =
            (y - (t₀ : ℂ) / 2) + (j : ℂ) * (t₀ : ℂ) := by ring
        rw [hp1, hm1]
      rw [hsum_eq, htel, mul_zero, mul_zero]
    
    let a_inv : ℂ → ℂ := fun u => (a_star u)⁻¹
    have ha_inv_props : ∀ y ∈ horizStrip σ,
        a_star y ≠ 0 ∧ ‖a_inv y‖ ≤ 16 / 3 ∧ 8 / 3 ≤ (a_inv y).re := by
      intro y hy
      set w : ℂ := a_star y
      have hw_close : ‖4 * w - 1‖ ≤ 1 / 4 := (ha_pb y hy).2
      have hw_norm : 3 / 16 ≤ ‖w‖ := by
        have h1 : (1 : ℝ) = ‖(1 - 4 * w) + 4 * w‖ := by
          have h_eq : (1 - 4 * w) + 4 * w = (1 : ℂ) := by ring
          rw [h_eq, norm_one]
        have h3 : ‖(1 - 4 * w) + 4 * w‖ ≤ ‖1 - 4 * w‖ + ‖4 * w‖ := norm_add_le _ _
        have h4 : ‖1 - 4 * w‖ = ‖4 * w - 1‖ := norm_sub_rev _ _
        have h5 : ‖4 * w‖ = 4 * ‖w‖ := by rw [norm_mul]; norm_num
        linarith
      have hw_ne : w ≠ 0 := norm_pos_iff.mp (by linarith)
      have hinv_norm : ‖w⁻¹‖ ≤ 16 / 3 := by
        rw [norm_inv]
        have hinv : ‖w‖⁻¹ ≤ (3 / 16 : ℝ)⁻¹ := inv_anti₀ (by norm_num) hw_norm
        norm_num at hinv
        exact hinv
      have hinv_close : ‖w⁻¹ - 4‖ ≤ 4 / 3 := by
        have hfac : w⁻¹ - 4 = (1 - 4 * w) * w⁻¹ := by field_simp [hw_ne]
        rw [hfac, norm_mul, norm_sub_rev]
        nlinarith [norm_nonneg (4 * w - 1), norm_nonneg w⁻¹]
      have hinv_re : 8 / 3 ≤ (w⁻¹).re := by
        have habs : |(w⁻¹ - 4).re| ≤ 4 / 3 :=
          le_trans (Complex.abs_re_le_norm (w⁻¹ - 4)) hinv_close
        have hsub : (w⁻¹ - 4).re = (w⁻¹).re - 4 := by simp
        rw [hsub] at habs
        linarith [(abs_le.mp habs).1]
      exact ⟨hw_ne, hinv_norm, hinv_re⟩
    let D_a : ℂ → ℂ := PiOp a_inv
    have hDa_props : ∀ y ∈ horizStrip σ, 8 / 3 ≤ ‖D_a y‖ ∧ D_a y ≠ 0 := by
      intro y hy
      have hre : 8 / 3 ≤ (D_a y).re := by
        dsimp [D_a, PiOp]
        have hq_inv : ((q : ℂ)⁻¹ : ℂ) = (((q : ℝ)⁻¹ : ℝ) : ℂ) := by push_cast; rfl
        rw [hq_inv, Complex.re_ofReal_mul, Complex.re_sum]
        have hsum : (q : ℝ) * (8 / 3 : ℝ) ≤
            ∑ j ∈ Finset.range q, (a_inv (y + (j : ℂ) * (t₀ : ℂ))).re := by
          calc
            (q : ℝ) * (8 / 3 : ℝ) = ∑ _j ∈ Finset.range q, (8 / 3 : ℝ) := by
              simp [Finset.sum_const, nsmul_eq_mul]
            _ ≤ ∑ j ∈ Finset.range q, (a_inv (y + (j : ℂ) * (t₀ : ℂ))).re :=
              Finset.sum_le_sum (fun j _ => (ha_inv_props _ (hStrip_jt y j hy)).2.2)
        calc
          (8 / 3 : ℝ) = (q : ℝ)⁻¹ * ((q : ℝ) * (8 / 3 : ℝ)) := by field_simp [hq_R_ne]
          _ ≤ (q : ℝ)⁻¹ * ∑ j ∈ Finset.range q, (a_inv (y + (j : ℂ) * (t₀ : ℂ))).re :=
            mul_le_mul_of_nonneg_left hsum (inv_nonneg.mpr (le_of_lt hq_pos))
      have hnorm : 8 / 3 ≤ ‖D_a y‖ := le_trans hre (Complex.re_le_norm (D_a y))
      exact ⟨hnorm, norm_pos_iff.mp (by linarith)⟩
    
    let h₀ : ℂ → ℂ := fun y => -KOp E_dot y
    let c₀ : ℂ → ℂ := fun y => -PiOp (fun u => a_inv u * h₀ u) y * (D_a y)⁻¹
    let ϕ₁ : ℂ → ℂ := fun y => a_inv y * (h₀ y + c₀ y)
    let z : ℂ → ℂ := KOp ϕ₁
    have ha_inv_holo : DifferentiableOn ℂ a_inv (horizStrip σ) :=
      ha_holo.inv (fun y hy => (ha_inv_props y hy).1)
    have ha_inv_per : ∀ y ∈ horizStrip σ, a_inv (y + 2 * Real.pi) = a_inv y :=
      fun y hy => congrArg Inv.inv (ha_pb y hy).1
    have hh₀_holo : DifferentiableOn ℂ h₀ (horizStrip σ) := (hK_holo E_dot hE_holo).neg
    have hh₀_per : ∀ y ∈ horizStrip σ, h₀ (y + 2 * Real.pi) = h₀ y :=
      fun y hy => congrArg Neg.neg (hK_per E_dot (fun u hu => (hE_pb u hu).1) y hy)
    have hDa_holo : DifferentiableOn ℂ D_a (horizStrip σ) := hPi_holo a_inv ha_inv_holo
    have hDa_per : ∀ y ∈ horizStrip σ, D_a (y + 2 * Real.pi) = D_a y :=
      hPi_per a_inv ha_inv_per
    have hah_per : ∀ y ∈ horizStrip σ,
        a_inv (y + 2 * Real.pi) * h₀ (y + 2 * Real.pi) = a_inv y * h₀ y := by
      intro y hy
      rw [ha_inv_per y hy, hh₀_per y hy]
    have hc₀_holo : DifferentiableOn ℂ c₀ (horizStrip σ) :=
      (hPi_holo (fun u => a_inv u * h₀ u) (ha_inv_holo.mul hh₀_holo)).neg.mul
        (hDa_holo.inv (fun y hy => (hDa_props y hy).2))
    have hc₀_per : ∀ y ∈ horizStrip σ, c₀ (y + 2 * Real.pi) = c₀ y := by
      intro y hy
      dsimp [c₀]
      rw [hPi_per (fun u => a_inv u * h₀ u) hah_per y hy, hDa_per y hy]
    have hϕ₁_holo : DifferentiableOn ℂ ϕ₁ (horizStrip σ) :=
      ha_inv_holo.mul (hh₀_holo.add hc₀_holo)
    have hϕ₁_per : ∀ y ∈ horizStrip σ, ϕ₁ (y + 2 * Real.pi) = ϕ₁ y := by
      intro y hy
      dsimp [ϕ₁]
      rw [ha_inv_per y hy, hh₀_per y hy, hc₀_per y hy]
    have hz_holo : DifferentiableOn ℂ z (horizStrip σ) := hK_holo ϕ₁ hϕ₁_holo
    have hz_per : ∀ y ∈ horizStrip σ, z (y + 2 * Real.pi) = z y := hK_per ϕ₁ hϕ₁_per
    
    let B_h : ℝ := (q : ℝ) * t₀ * M_dot
    have hBh_nn : 0 ≤ B_h := by dsimp [B_h]; positivity
    have hh₀_bound : ∀ y ∈ horizStrip σ, ‖h₀ y‖ ≤ B_h := by
      intro y hy
      dsimp [h₀, B_h]
      rw [norm_neg]
      exact hK_bound E_dot M_dot hM_dot (fun u hu => (hE_pb u hu).2) y hy
    have hc₀_bound : ∀ y ∈ horizStrip σ, ‖c₀ y‖ ≤ 2 * B_h := by
      intro y hy
      have hah_b : ∀ u ∈ horizStrip σ, ‖a_inv u * h₀ u‖ ≤ (16 / 3 : ℝ) * B_h := by
        intro u hu
        rw [norm_mul]
        exact mul_le_mul (ha_inv_props u hu).2.1 (hh₀_bound u hu) (norm_nonneg _) (by norm_num)
      have hnum : ‖PiOp (fun u => a_inv u * h₀ u) y‖ ≤ (16 / 3 : ℝ) * B_h :=
        hPi_bound (fun u => a_inv u * h₀ u) ((16 / 3 : ℝ) * B_h) (by positivity) hah_b y hy
      have hden : ‖(D_a y)⁻¹‖ ≤ 3 / 8 := by
        rw [norm_inv]
        have hinv := inv_anti₀ (by norm_num) (hDa_props y hy).1
        norm_num at hinv
        exact hinv
      dsimp [c₀]
      rw [norm_mul, norm_neg]
      calc
        ‖PiOp (fun u => a_inv u * h₀ u) y‖ * ‖(D_a y)⁻¹‖
            ≤ ((16 / 3 : ℝ) * B_h) * (3 / 8 : ℝ) :=
          mul_le_mul hnum hden (norm_nonneg _) (by positivity)
        _ = 2 * B_h := by ring
    have hϕ₁_bound : ∀ y ∈ horizStrip σ, ‖ϕ₁ y‖ ≤ 16 * B_h := by
      intro y hy
      dsimp [ϕ₁]
      rw [norm_mul]
      have hsum : ‖h₀ y + c₀ y‖ ≤ 3 * B_h := by
        calc
          ‖h₀ y + c₀ y‖ ≤ ‖h₀ y‖ + ‖c₀ y‖ := norm_add_le _ _
          _ ≤ B_h + 2 * B_h := add_le_add (hh₀_bound y hy) (hc₀_bound y hy)
          _ = 3 * B_h := by ring
      calc
        ‖a_inv y‖ * ‖h₀ y + c₀ y‖ ≤ (16 / 3 : ℝ) * (3 * B_h) :=
          mul_le_mul (ha_inv_props y hy).2.1 hsum (norm_nonneg _) (by norm_num)
        _ = 16 * B_h := by ring
    have hz_bound : ∀ y ∈ horizStrip σ, ‖z y‖ ≤ 24 * (q : ℝ) ^ 2 * t₀ ^ 2 * M_dot := by
      intro y hy
      have hk := hK_bound ϕ₁ (16 * B_h) (by positivity) hϕ₁_bound y hy
      have h16 : (q : ℝ) * t₀ * (16 * B_h) = 16 * (q : ℝ) ^ 2 * t₀ ^ 2 * M_dot := by
        dsimp [B_h]; ring
      rw [h16] at hk
      have hnn : 0 ≤ (q : ℝ) ^ 2 * t₀ ^ 2 * M_dot := by positivity
      linarith
    
    have hc₀_shift : ∀ w ∈ horizStrip σ, c₀ (w + (t₀ : ℂ)) = c₀ w := by
      intro w hw
      dsimp [c₀, D_a]
      rw [hPi_shift (fun u => a_inv u * h₀ u) hah_per w hw,
          hPi_shift a_inv ha_inv_per w hw]
    have hc₀_shift_nat : ∀ (j : ℕ), ∀ w ∈ horizStrip σ,
        c₀ (w + (j : ℂ) * (t₀ : ℂ)) = c₀ w := by
      intro j
      induction j with
      | zero => intro w _; simp
      | succ j ihj =>
        intro w hw
        have hstep : w + ((j + 1 : ℕ) : ℂ) * (t₀ : ℂ) =
            (w + (j : ℂ) * (t₀ : ℂ)) + (t₀ : ℂ) := by push_cast; ring
        rw [hstep, hc₀_shift _ (hStrip_jt w j hw), ihj w hw]
    have hPi_ϕ₁ : ∀ w ∈ horizStrip σ, PiOp ϕ₁ w = 0 := by
      intro w hw
      have hdecomp : PiOp ϕ₁ w = PiOp (fun u => a_inv u * h₀ u) w + D_a w * c₀ w := by
        dsimp [PiOp, D_a, ϕ₁]
        have hsum : (∑ j ∈ Finset.range q,
              a_inv (w + (j : ℂ) * (t₀ : ℂ)) *
                (h₀ (w + (j : ℂ) * (t₀ : ℂ)) + c₀ (w + (j : ℂ) * (t₀ : ℂ)))) =
            (∑ j ∈ Finset.range q,
              a_inv (w + (j : ℂ) * (t₀ : ℂ)) * h₀ (w + (j : ℂ) * (t₀ : ℂ))) +
            (∑ j ∈ Finset.range q, a_inv (w + (j : ℂ) * (t₀ : ℂ))) * c₀ w := by
          rw [Finset.sum_mul, ← Finset.sum_add_distrib]
          refine Finset.sum_congr rfl (fun j _ => ?_)
          rw [hc₀_shift_nat j w hw, mul_add]
        rw [hsum]
        ring
      rw [hdecomp]
      dsimp [c₀]
      have hDa_ne : D_a w ≠ 0 := (hDa_props w hw).2
      field_simp [hDa_ne]
      ring
    have hpsi_eq : ∀ w ∈ horizStrip σ,
        a_star w * glancingDiffOp (fun r => z r.1) (w, (t₀ : ℂ)) = h₀ w + c₀ w := by
      intro w hw
      have hdz : glancingDiffOp (fun r => z r.1) (w, (t₀ : ℂ)) = ϕ₁ w := by
        rw [hK_diff ϕ₁ hϕ₁_holo hϕ₁_per w hw, hPi_ϕ₁ w hw, sub_zero]
      rw [hdz]
      dsimp [ϕ₁, a_inv]
      have ha_ne : a_star w ≠ 0 := (ha_inv_props w hw).1
      field_simp [ha_ne]
    refine ⟨z, hz_holo, hz_per, hz_bound, ?_⟩
    intro y hy
    have houter_congr :
        glancingDiffOp
          (fun p => a_star p.1 * glancingDiffOp (fun r => z r.1) (p.1, (t₀ : ℂ)))
          (y, (t₀ : ℂ)) =
        glancingDiffOp (fun p => h₀ p.1 + c₀ p.1) (y, (t₀ : ℂ)) := by
      unfold glancingDiffOp
      dsimp only
      refine intervalIntegral.integral_congr (fun μ _ => ?_)
      set z₀ : ℂ := y + (μ : ℂ) * (t₀ : ℂ)
      have hz₀ : z₀ ∈ horizStrip σ := by
        have hc : (μ : ℂ) * (t₀ : ℂ) = ((μ * t₀ : ℝ) : ℂ) := by push_cast; rfl
        dsimp [z₀]
        rw [hc]
        exact hStrip_add_real σ y (μ * t₀) hy
      have hev :
          (fun w : ℂ => a_star w * glancingDiffOp (fun r => z r.1) (w, (t₀ : ℂ))) =ᶠ[nhds z₀]
          (fun w : ℂ => h₀ w + c₀ w) :=
        Filter.eventuallyEq_of_mem ((hStrip_open σ).mem_nhds hz₀)
          (fun w hw => hpsi_eq w hw)
      exact hev.deriv_eq
    rw [houter_congr, h_add h₀ c₀ hh₀_holo hc₀_holo y hy]
    have hc₀_diff : glancingDiffOp (fun p => c₀ p.1) (y, (t₀ : ℂ)) = 0 := by
      rw [h_ftc_1d c₀ hc₀_holo y hy]
      have hrew : y + (t₀ : ℂ) / 2 = (y - (t₀ : ℂ) / 2) + (t₀ : ℂ) := by ring
      rw [hrew, hc₀_shift (y - (t₀ : ℂ) / 2) (hStrip_half_sub y hy), sub_self, mul_zero]
    have hh₀_diff : glancingDiffOp (fun p => h₀ p.1) (y, (t₀ : ℂ)) = -E_dot y := by
      rw [h_ftc_1d h₀ hh₀_holo y hy]
      have hneg : (t₀ : ℂ)⁻¹ * (h₀ (y + (t₀ : ℂ) / 2) - h₀ (y - (t₀ : ℂ) / 2)) =
          -((t₀ : ℂ)⁻¹ * (KOp E_dot (y + (t₀ : ℂ) / 2) - KOp E_dot (y - (t₀ : ℂ) / 2))) := by
        dsimp [h₀]; ring
      rw [hneg, ← h_ftc_1d (KOp E_dot) (hK_holo E_dot hE_holo) y hy,
          hK_diff E_dot hE_holo (fun u hu => (hE_pb u hu).1) y hy,
          hPi_Edot y hy, sub_zero]
    rw [hh₀_diff, hc₀_diff, add_zero]

theorem prelim_lift_and_cyclic_jet_solve (Ω : Set Plane)
    (B : AnalyticBoundaryData Ω)
    (S : GlancingScalePackage B) :
    PrelimCyclicJetSolveProp B S :=
by
  intro hCyc
  have hDiff := hCyc.1 S.partial_y_holo
  have hCyclic := hCyc.2.2
  have hC_quad_pos : 0 < S.C_quad := S.C_quad_pos
  let C_pre : ℝ := 114 + S.C_quad
  let C_z : ℝ := 192 * C_pre
  have hC_pre_gt : 114 < C_pre := by dsimp [C_pre]; linarith
  have hC_pre_pos : 0 < C_pre := by linarith
  have hC_z_ge_one : 1 ≤ C_z := by dsimp [C_z]; linarith
  refine ⟨C_z, hC_z_ge_one, ?_⟩
  intro s d δ ε η_slice N l q U U_star
    hs0 hs_act hd0 hd_act hd_half hδ0 hδ_lt hε0 hε1
    hη_slice0 hη_slice_adm hN hU hRes hl1 hq2 hqN
    t₀ ht₀_lt hU_star Q η_tot

  
  have hη_adm_pos : 0 < S.η_adm := S.η_adm_pos
  have hη_adm_le32 : S.η_adm ≤ 1 / 32 := S.η_adm_le_inv32
  have hη_adm_s₀ : S.η_adm ≤ B.s₀ / 4 := S.η_adm_le_quarter_s₀
  have hs_act_s₀ : S.s_act ≤ B.s₀ / 2 := S.s_act_le_half_s₀
  have hd_act_lt1 : S.d_act < 1 := S.d_act_lt_one

  have hs6_pos : 0 < s - 6 * δ := by linarith
  have hs11_2_pos : 0 < s - (11 / 2 : ℝ) * δ := by linarith
  have hs21_4_pos : 0 < s - (21 / 4 : ℝ) * δ := by linarith
  have hs5_pos : 0 < s - 5 * δ := by linarith
  have hs5_le_act : s - 5 * δ ≤ S.s_act := by linarith

  set Y5 : Set ℂ := horizStrip (s - 5 * δ)
  set Y21_4 : Set ℂ := horizStrip (s - (21 / 4 : ℝ) * δ)
  set Y11_2 : Set ℂ := horizStrip (s - (11 / 2 : ℝ) * δ)
  set Y6 : Set ℂ := horizStrip (s - 6 * δ)
  set B4 : Set ℂ := Metric.ball (t₀ : ℂ) (δ / 4)

  have hstrip_mono : ∀ {σ₁ σ₂ : ℝ}, σ₁ ≤ σ₂ → horizStrip σ₁ ⊆ horizStrip σ₂ := by
    intro σ₁ σ₂ hle z hz
    exact lt_of_lt_of_le hz hle
  have hY6_sub_Y11_2 : Y6 ⊆ Y11_2 := hstrip_mono (by linarith)
  have hY11_2_sub_Y21_4 : Y11_2 ⊆ Y21_4 := hstrip_mono (by linarith)
  have hY21_4_sub_Y5 : Y21_4 ⊆ Y5 := hstrip_mono (by linarith)
  have hY6_sub_Y5 : Y6 ⊆ Y5 := hstrip_mono (by linarith)
  have hY5_sub_s : Y5 ⊆ horizStrip s := hstrip_mono (by linarith)

  have isOpen_horizStrip : ∀ H : ℝ, IsOpen (horizStrip H) := fun H =>
    isOpen_lt (continuous_abs.comp Complex.continuous_im) continuous_const
  have hstrip_add_real : ∀ {H : ℝ} {w : ℂ}, w ∈ horizStrip H → ∀ x : ℝ,
      w + (x : ℂ) ∈ horizStrip H := by
    intro H w hw x
    have hw' : |w.im| < H := hw
    change |(w + (x : ℂ)).im| < H
    simpa using hw'
  have hstrip_shift_2pi : ∀ {H : ℝ} {w : ℂ}, w ∈ horizStrip H →
      w + 2 * Real.pi ∈ horizStrip H := by
    intro H w hw
    change |(w + (2 * (Real.pi : ℂ))).im| < H
    have him : (w + (2 * (Real.pi : ℂ))).im = w.im := by simp
    rw [him]
    exact hw

  
  have slice_fst_holo :
      ∀ {W : Set (ℂ × ℂ)} {S_y : Set ℂ} {F : ℂ × ℂ → ℂ} (t_fixed : ℂ),
        DifferentiableOn ℂ F W →
        (∀ z ∈ S_y, (z, t_fixed) ∈ W) →
        DifferentiableOn ℂ (fun z : ℂ => F (z, t_fixed)) S_y := by
    intro W S_y F t_fixed hF hmaps
    exact DifferentiableOn.comp hF
      (differentiable_id.prodMk (differentiable_const t_fixed)).differentiableOn hmaps

  have slice_snd_holo :
      ∀ {W : Set (ℂ × ℂ)} {S_t : Set ℂ} {F : ℂ × ℂ → ℂ} (y_fixed : ℂ),
        DifferentiableOn ℂ F W →
        (∀ t ∈ S_t, (y_fixed, t) ∈ W) →
        DifferentiableOn ℂ (fun t : ℂ => F (y_fixed, t)) S_t := by
    intro W S_t F y_fixed hF hmaps
    exact DifferentiableOn.comp hF
      ((differentiable_const y_fixed).prodMk differentiable_id).differentiableOn hmaps

  have partial_t_slice_holo :
      ∀ {W : Set (ℂ × ℂ)} {S_y : Set ℂ} {F : ℂ × ℂ → ℂ} (t_fixed : ℂ),
        IsOpen W →
        DifferentiableOn ℂ F W →
        (∀ z ∈ S_y, (z, t_fixed) ∈ W) →
        DifferentiableOn ℂ (fun z : ℂ => deriv (fun t' : ℂ => F (z, t')) t_fixed) S_y := by
    intro W S_y F t_fixed hW_open hF hmaps
    exact slice_fst_holo t_fixed (S.partial_t_holo W F hW_open hF) hmaps

  have hpi_pos : 0 < Real.pi := by linarith [Real.pi_gt_three]
  have hq1 : 1 ≤ q := by omega
  have hq_pos : (0 : ℝ) < (q : ℝ) := by positivity
  have hq_ne : (q : ℝ) ≠ 0 := ne_of_gt hq_pos
  have ht₀_pos : 0 < t₀ := by
    change 0 < (2 * Real.pi * (l : ℝ)) / (q : ℝ)
    positivity
  have ht₀_C_ne : (t₀ : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (ne_of_gt ht₀_pos)
  have hqt₀_eq : (q : ℝ) * t₀ = 2 * Real.pi * (l : ℝ) := by
    change (q : ℝ) * ((2 * Real.pi * (l : ℝ)) / (q : ℝ)) = 2 * Real.pi * (l : ℝ)
    field_simp [hq_ne]
  have ht₀_lt_one : t₀ < 1 := by linarith
  have hq_le_N : (q : ℝ) ≤ (N : ℝ) := by exact_mod_cast hqN
  have hN_nonneg : (0 : ℝ) ≤ (N : ℝ) := Nat.cast_nonneg N
  have hδ_inv_pos : 0 < δ⁻¹ := inv_pos.mpr hδ0
  have hQ_ge_one : 1 ≤ Q := by
    change 1 ≤ 1 + (N : ℝ) + δ⁻¹
    linarith
  have hQ_nonneg : 0 ≤ Q := by linarith
  have hδ_inv_le_Q : δ⁻¹ ≤ Q := by
    change δ⁻¹ ≤ 1 + (N : ℝ) + δ⁻¹
    linarith
  have hδ_inv_sq_le : (δ⁻¹) ^ 2 ≤ Q ^ 2 :=
    pow_le_pow_left₀ (le_of_lt hδ_inv_pos) hδ_inv_le_Q 2
  have hQ_sq_ge_one : 1 ≤ Q ^ 2 := one_le_pow₀ hQ_ge_one
  have hqt₀_le_Q : (q : ℝ) * t₀ ≤ Q := by
    have hqt₀_le_q : (q : ℝ) * t₀ ≤ (q : ℝ) * 1 :=
      mul_le_mul_of_nonneg_left (le_of_lt ht₀_lt_one) (le_of_lt hq_pos)
    change (q : ℝ) * t₀ ≤ 1 + (N : ℝ) + δ⁻¹
    linarith
  have hqt₀_sq_le : (q : ℝ) ^ 2 * t₀ ^ 2 ≤ Q ^ 2 := by
    have hpow : ((q : ℝ) * t₀) ^ 2 ≤ Q ^ 2 :=
      pow_le_pow_left₀ (by positivity) hqt₀_le_Q 2
    calc
      (q : ℝ) ^ 2 * t₀ ^ 2 = ((q : ℝ) * t₀) ^ 2 := by ring
      _ ≤ Q ^ 2 := hpow
  have hη_tot_pos : 0 < η_tot := by
    change 0 < ε + η_slice
    linarith
  have hη_tot_nonneg : 0 ≤ η_tot := le_of_lt hη_tot_pos
  have hη_slice_le_one : η_slice ≤ 1 := by linarith
  have hη_slice_sq_le : η_slice ^ 2 ≤ Q ^ 2 * η_slice := by
    have hsq : η_slice ^ 2 ≤ 1 * η_slice := by nlinarith
    exact le_trans hsq (mul_le_mul_of_nonneg_right hQ_sq_ge_one hη_slice0)

  have hδ4_pos : 0 < δ / 4 := by positivity
  have ht₀_mem_B4 : (t₀ : ℂ) ∈ B4 := Metric.mem_ball_self hδ4_pos
  have ht₀_norm : ‖(t₀ : ℂ)‖ = t₀ := by
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos ht₀_pos]
  have ht₀_norm_lt_d_act : ‖(t₀ : ℂ)‖ < S.d_act := by
    rw [ht₀_norm]
    linarith
  have ht₀_add_δ4_le : t₀ + δ / 4 ≤ S.d_act := by linarith
  have hB4_bounds : ∀ t ∈ B4, ‖t‖ < d ∧ |t.im| < δ / 4 := by
    intro t ht
    rw [Metric.mem_ball, dist_eq_norm] at ht
    have htri : ‖t‖ ≤ ‖t - (t₀ : ℂ)‖ + ‖(t₀ : ℂ)‖ := norm_le_norm_sub_add t (t₀ : ℂ)
    have ht_norm : ‖t‖ < d := by linarith
    have him_eq : t.im = (t - (t₀ : ℂ)).im := by simp
    have ht_im : |t.im| < δ / 4 := by
      rw [him_eq]
      exact lt_of_le_of_lt (Complex.abs_im_le_norm (t - (t₀ : ℂ))) ht
    exact ⟨ht_norm, ht_im⟩
  have hB4_sub_d_act : B4 ⊆ Metric.ball (0 : ℂ) S.d_act := by
    intro t ht
    rw [Metric.mem_ball, dist_zero_right]
    exact lt_of_lt_of_le (hB4_bounds t ht).1 hd_act
  have hY5B4_sub_dom : ∀ {ν : ℝ}, 0 ≤ ν → ν ≤ 1 → Y5 ×ˢ B4 ⊆ glancingDomain ν s d := by
    intro ν hν0 hν1 p hp
    obtain ⟨ht_norm, ht_im⟩ := hB4_bounds p.2 hp.2
    refine ⟨ht_norm, ?_⟩
    have hy_im : |p.1.im| < s - 5 * δ := hp.1
    have hν_im : ν * |p.2.im| ≤ δ / 4 := by nlinarith [abs_nonneg p.2.im]
    linarith
  have hY5B4_sub_dom0 : Y5 ×ˢ B4 ⊆ glancingDomain 0 s d :=
    hY5B4_sub_dom (by norm_num) (by norm_num)
  have hY5B4_sub_dom_half : Y5 ×ˢ B4 ⊆ glancingDomain (1 / 2) s d :=
    hY5B4_sub_dom (by norm_num) (by norm_num)
  have hY5B4_sub_dom1 : Y5 ×ˢ B4 ⊆ glancingDomain 1 s d :=
    hY5B4_sub_dom (by norm_num) (by norm_num)
  have isOpen_glancingDomain0 : IsOpen (glancingDomain 0 s d) :=
    IsOpen.inter
      (isOpen_lt (continuous_norm.comp continuous_snd) continuous_const)
      (isOpen_lt (continuous_abs.comp (Complex.continuous_im.comp continuous_fst))
        (continuous_const.sub
          (continuous_const.mul (continuous_abs.comp (Complex.continuous_im.comp continuous_snd)))))

  
  have glancingResidualOp_slice_eq :
      ∀ (U₁ U₂ : ℂ × ℂ → ℂ) (y t : ℂ),
        (∀ z : ℂ, U₁ (z, t) = U₂ (z, t)) →
        glancingResidualOp B U₁ (y, t) = glancingResidualOp B U₂ (y, t) := by
    intro U₁ U₂ y t h
    have hfun : (fun z : ℂ => U₁ (z, t)) = (fun z : ℂ => U₂ (z, t)) := funext h
    have hAp : glancingAvgPlus U₁ y t = glancingAvgPlus U₂ y t := by
      dsimp only [glancingAvgPlus]; simp only [hfun]
    have hAm : glancingAvgMinus U₁ y t = glancingAvgMinus U₂ y t := by
      dsimp only [glancingAvgMinus]; simp only [hfun]
    have hC : glancingSecondAvg U₁ y t = glancingSecondAvg U₂ y t := by
      dsimp only [glancingSecondAvg]; simp only [hfun]
    dsimp only [glancingResidualOp]
    rw [hAp, hAm, hC, h y]
    simp only [hfun]

  have glancingLinCoeff_slice_eq :
      ∀ (U₁ U₂ : ℂ × ℂ → ℂ) (y t : ℂ),
        (∀ z : ℂ, U₁ (z, t) = U₂ (z, t)) →
        glancingLinCoeff B U₁ (y, t) = glancingLinCoeff B U₂ (y, t) := by
    intro U₁ U₂ y t h
    have hW : glancingPhaseSlope B U₁ y t = glancingPhaseSlope B U₂ y t := by
      dsimp only [glancingPhaseSlope]; simp only [h]
    dsimp only [glancingLinCoeff]
    rw [hW]
    simp only [h]

  have glancingDiffOp_slice_eq :
      ∀ (V₁ V₂ : ℂ × ℂ → ℂ) (y t : ℂ),
        (∀ z : ℂ, V₁ (z, t) = V₂ (z, t)) →
        glancingDiffOp V₁ (y, t) = glancingDiffOp V₂ (y, t) := by
    intro V₁ V₂ y t h
    have hfun : (fun z : ℂ => V₁ (z, t)) = (fun z : ℂ => V₂ (z, t)) := funext h
    dsimp only [glancingDiffOp]
    simp only [hfun]

  have glancingResidualOp_congr_strip :
      ∀ (σ : ℝ) (U₁ U₂ : ℂ × ℂ → ℂ) (y t : ℂ),
        |y.im| + |t.im| < σ →
        (∀ z ∈ horizStrip σ, U₁ (z, t) = U₂ (z, t)) →
        glancingResidualOp B U₁ (y, t) = glancingResidualOp B U₂ (y, t) := by
    intro σ U₁ U₂ y t hyim h
    have hd1 : ∀ w ∈ horizStrip σ,
        deriv (fun y' : ℂ => U₁ (y', t)) w = deriv (fun y' : ℂ => U₂ (y', t)) w := by
      intro w hw
      have hev : (fun y' : ℂ => U₁ (y', t)) =ᶠ[nhds w] (fun y' : ℂ => U₂ (y', t)) :=
        Filter.eventually_of_mem ((isOpen_horizStrip σ).mem_nhds hw) h
      exact hev.deriv_eq
    have hd2 : ∀ w ∈ horizStrip σ,
        deriv (deriv (fun y' : ℂ => U₁ (y', t))) w =
          deriv (deriv (fun y' : ℂ => U₂ (y', t))) w := by
      intro w hw
      have hev : deriv (fun y' : ℂ => U₁ (y', t)) =ᶠ[nhds w]
          deriv (fun y' : ℂ => U₂ (y', t)) :=
        Filter.eventually_of_mem ((isOpen_horizStrip σ).mem_nhds hw) hd1
      exact hev.deriv_eq
    have hy_mem : y ∈ horizStrip σ := by
      change |y.im| < σ
      linarith [abs_nonneg t.im]
    have hAp : glancingAvgPlus U₁ y t = glancingAvgPlus U₂ y t := by
      dsimp only [glancingAvgPlus]
      refine intervalIntegral.integral_congr fun lam hlam => hd1 _ ?_
      rw [Set.uIcc_of_le (by norm_num : (0 : ℝ) ≤ 1)] at hlam
      change |(y + (lam : ℂ) * t).im| < σ
      have him : (y + (lam : ℂ) * t).im = y.im + lam * t.im := by simp
      rw [him]
      have hle : |y.im + lam * t.im| ≤ |y.im| + |lam| * |t.im| := by
        simpa [abs_mul] using abs_add_le y.im (lam * t.im)
      have hlam_abs : |lam| ≤ 1 := abs_le.mpr ⟨by linarith [hlam.1], hlam.2⟩
      nlinarith [abs_nonneg t.im]
    have hAm : glancingAvgMinus U₁ y t = glancingAvgMinus U₂ y t := by
      dsimp only [glancingAvgMinus]
      refine intervalIntegral.integral_congr fun lam hlam => hd1 _ ?_
      rw [Set.uIcc_of_le (by norm_num : (0 : ℝ) ≤ 1)] at hlam
      change |(y - (lam : ℂ) * t).im| < σ
      have him : (y - (lam : ℂ) * t).im = y.im + (-lam) * t.im := by simp; ring
      rw [him]
      have hle : |y.im + (-lam) * t.im| ≤ |y.im| + |-lam| * |t.im| := by
        simpa [abs_mul] using abs_add_le y.im ((-lam) * t.im)
      have hlam_abs : |-lam| ≤ 1 := by
        rw [abs_neg]
        exact abs_le.mpr ⟨by linarith [hlam.1], hlam.2⟩
      nlinarith [abs_nonneg t.im]
    have hC : glancingSecondAvg U₁ y t = glancingSecondAvg U₂ y t := by
      dsimp only [glancingSecondAvg]
      refine intervalIntegral.integral_congr fun lam hlam => ?_
      rw [Set.uIcc_of_le (by norm_num : (0 : ℝ) ≤ 1)] at hlam
      refine intervalIntegral.integral_congr fun μ hμ => hd2 _ ?_
      rw [Set.uIcc_of_le (by linarith [hlam.1] : -lam ≤ lam)] at hμ
      change |(y + (μ : ℂ) * t).im| < σ
      have him : (y + (μ : ℂ) * t).im = y.im + μ * t.im := by simp
      rw [him]
      have hle : |y.im + μ * t.im| ≤ |y.im| + |μ| * |t.im| := by
        simpa [abs_mul] using abs_add_le y.im (μ * t.im)
      have hμ_abs : |μ| ≤ 1 :=
        abs_le.mpr ⟨by linarith [hμ.1, hlam.2], by linarith [hμ.2, hlam.2]⟩
      nlinarith [abs_nonneg t.im]
    dsimp only [glancingResidualOp]
    rw [hAp, hAm, hC, h y hy_mem, hd1 y hy_mem]

  
  have glancingDiffOp_congr_real_slice :
      ∀ (σ : ℝ) (f₁ f₂ : ℂ → ℂ) (w : ℂ),
        w ∈ horizStrip σ →
        (∀ z ∈ horizStrip σ, f₁ z = f₂ z) →
        glancingDiffOp (fun r => f₁ r.1) (w, (t₀ : ℂ)) =
          glancingDiffOp (fun r => f₂ r.1) (w, (t₀ : ℂ)) := by
    intro σ f₁ f₂ w hw h
    dsimp only [glancingDiffOp]
    refine intervalIntegral.integral_congr fun μ _ => ?_
    have hz_mem : w + (μ : ℂ) * (t₀ : ℂ) ∈ horizStrip σ := by
      simpa [Complex.ofReal_mul] using hstrip_add_real hw (μ * t₀)
    have hev : f₁ =ᶠ[nhds (w + (μ : ℂ) * (t₀ : ℂ))] f₂ :=
      Filter.eventually_of_mem ((isOpen_horizStrip σ).mem_nhds hz_mem) h
    exact hev.deriv_eq

  have glancingDiffOp_real_slice :
      ∀ (σ : ℝ) (f : ℂ → ℂ),
        DifferentiableOn ℂ f (horizStrip σ) →
        ∀ w ∈ horizStrip σ,
          glancingDiffOp (fun r => f r.1) (w, (t₀ : ℂ)) =
            (t₀ : ℂ)⁻¹ * (f (w + (t₀ : ℂ) / 2) - f (w - (t₀ : ℂ) / 2)) := by
    intro σ f hf w hw
    have hmem : ∀ μ : ℝ, w + (μ : ℂ) * (t₀ : ℂ) ∈ horizStrip σ := fun μ => by
      simpa [Complex.ofReal_mul] using hstrip_add_real hw (μ * t₀)
    have hderiv : ∀ μ ∈ Set.uIcc (-1 / 2 : ℝ) (1 / 2 : ℝ),
        HasDerivAt (fun x : ℝ => f (w + (x : ℂ) * (t₀ : ℂ)))
          (deriv f (w + (μ : ℂ) * (t₀ : ℂ)) * (t₀ : ℂ)) μ := by
      intro μ _
      have hf_at : HasDerivAt f (deriv f (w + (μ : ℂ) * (t₀ : ℂ))) (w + (μ : ℂ) * (t₀ : ℂ)) :=
        (hf.differentiableAt ((isOpen_horizStrip σ).mem_nhds (hmem μ))).hasDerivAt
      have hlin : HasDerivAt (fun z : ℂ => w + z * (t₀ : ℂ)) (t₀ : ℂ) (μ : ℂ) := by
        simpa using ((hasDerivAt_id (μ : ℂ)).mul_const (t₀ : ℂ)).const_add w
      exact (hf_at.comp (μ : ℂ) hlin).comp_ofReal
    have hcont : ContinuousOn (fun μ : ℝ => deriv f (w + (μ : ℂ) * (t₀ : ℂ)) * (t₀ : ℂ))
        (Set.uIcc (-1 / 2 : ℝ) (1 / 2 : ℝ)) := by
      have hdf : ContinuousOn (deriv f) (horizStrip σ) :=
        (hf.deriv (isOpen_horizStrip σ)).continuousOn
      have hmap : Continuous (fun μ : ℝ => w + (μ : ℂ) * (t₀ : ℂ)) := by fun_prop
      exact (hdf.comp hmap.continuousOn (fun μ _ => hmem μ)).mul continuousOn_const
    have hint := intervalIntegral.integral_eq_sub_of_hasDerivAt hderiv hcont.intervalIntegrable
    rw [intervalIntegral.integral_mul_const] at hint
    have h1 : w + ((1 / 2 : ℝ) : ℂ) * (t₀ : ℂ) = w + (t₀ : ℂ) / 2 := by push_cast; ring
    have h2 : w + ((-1 / 2 : ℝ) : ℂ) * (t₀ : ℂ) = w - (t₀ : ℂ) / 2 := by push_cast; ring
    rw [h1, h2] at hint
    dsimp only [glancingDiffOp]
    calc
      (∫ μ in (-1 / 2 : ℝ)..(1 / 2 : ℝ), deriv f (w + (μ : ℂ) * (t₀ : ℂ))) =
          ((∫ μ in (-1 / 2 : ℝ)..(1 / 2 : ℝ), deriv f (w + (μ : ℂ) * (t₀ : ℂ))) * (t₀ : ℂ)) *
            (t₀ : ℂ)⁻¹ := by
        rw [mul_assoc, mul_inv_cancel₀ ht₀_C_ne, mul_one]
      _ = (t₀ : ℂ)⁻¹ * (f (w + (t₀ : ℂ) / 2) - f (w - (t₀ : ℂ) / 2)) := by
        rw [hint, mul_comm]

  have glancingDiffOp_real_slice_holo :
      ∀ (σ : ℝ) (f : ℂ → ℂ),
        DifferentiableOn ℂ f (horizStrip σ) →
        DifferentiableOn ℂ (fun w => glancingDiffOp (fun r => f r.1) (w, (t₀ : ℂ)))
          (horizStrip σ) := by
    intro σ f hf
    have h_p : DifferentiableOn ℂ (fun w : ℂ => f (w + (t₀ : ℂ) / 2)) (horizStrip σ) :=
      hf.comp (differentiable_id.add_const ((t₀ : ℂ) / 2)).differentiableOn fun w hw => by
        simpa [Complex.ofReal_div] using hstrip_add_real hw (t₀ / 2)
    have h_m : DifferentiableOn ℂ (fun w : ℂ => f (w - (t₀ : ℂ) / 2)) (horizStrip σ) :=
      hf.comp (differentiable_id.sub_const ((t₀ : ℂ) / 2)).differentiableOn fun w hw => by
        have heq : w - (t₀ : ℂ) / 2 = w + ((-t₀ / 2 : ℝ) : ℂ) := by push_cast; ring
        rw [heq]
        exact hstrip_add_real hw (-t₀ / 2)
    exact ((differentiableOn_const (t₀ : ℂ)⁻¹).mul (h_p.sub h_m)).congr fun w hw =>
      glancingDiffOp_real_slice σ f hf w hw

  have glancingDiffOp_real_slice_per :
      ∀ (σ : ℝ) (f : ℂ → ℂ),
        DifferentiableOn ℂ f (horizStrip σ) →
        (∀ w ∈ horizStrip σ, f (w + 2 * Real.pi) = f w) →
        ∀ w ∈ horizStrip σ,
          glancingDiffOp (fun r => f r.1) (w + 2 * Real.pi, (t₀ : ℂ)) =
            glancingDiffOp (fun r => f r.1) (w, (t₀ : ℂ)) := by
    intro σ f hf hper w hw
    have hw_2pi : w + 2 * Real.pi ∈ horizStrip σ := hstrip_shift_2pi hw
    have hw_p : w + (t₀ : ℂ) / 2 ∈ horizStrip σ := by
      simpa [Complex.ofReal_div] using hstrip_add_real hw (t₀ / 2)
    have hw_m : w - (t₀ : ℂ) / 2 ∈ horizStrip σ := by
      have heq : w - (t₀ : ℂ) / 2 = w + ((-t₀ / 2 : ℝ) : ℂ) := by push_cast; ring
      rw [heq]
      exact hstrip_add_real hw (-t₀ / 2)
    have hp_shift : w + 2 * Real.pi + (t₀ : ℂ) / 2 = (w + (t₀ : ℂ) / 2) + 2 * Real.pi := by ring
    have hm_shift : w + 2 * Real.pi - (t₀ : ℂ) / 2 = (w - (t₀ : ℂ) / 2) + 2 * Real.pi := by ring
    rw [glancingDiffOp_real_slice σ f hf (w + 2 * Real.pi) hw_2pi,
      glancingDiffOp_real_slice σ f hf w hw, hp_shift, hm_shift,
      hper _ hw_p, hper _ hw_m]

  
  have hU_adm : IsAdmissibleGlancingCand s d S.η_adm U := by
    refine ⟨hU.1, hU.2.1, hU.2.2.1, hU.2.2.2.1, ?_⟩
    intro k hk y t hyt
    exact le_trans (hU.2.2.2.2 k hk y t hyt) (by linarith)

  let Up : ℂ × ℂ → ℂ := fun p => deriv (fun y' : ℂ => U (y', p.2)) p.1
  have hUp_holo : DifferentiableOn ℂ Up (glancingDomain 0 s d) :=
    S.partial_y_holo (glancingDomain 0 s d) U isOpen_glancingDomain0 hU.1

  have hUp_props : ∀ y t : ℂ, (y, t) ∈ glancingDomain 0 s d →
      Up (y + 2 * Real.pi, t) = Up (y, t) ∧ Up (y, t) ≠ 0 ∧ ‖(Up (y, t))⁻¹‖ ≤ 4 / 3 := by
    intro y t hyt
    have ht_norm : ‖t‖ < d := hyt.1
    have hy_strip : y ∈ horizStrip s := by
      change |y.im| < s
      have := hyt.2
      linarith
    have hdom_slice : ∀ z ∈ horizStrip s, (z, t) ∈ glancingDomain 0 s d := fun z hz => by
      refine ⟨ht_norm, ?_⟩
      change |z.im| < s - 0 * |t.im|
      have : |z.im| < s := hz
      linarith
    have hU_slice_holo : DifferentiableOn ℂ (fun y' : ℂ => U (y', t)) (horizStrip s) :=
