          rw [Nat.sum_range_choose k]
          push_cast
          rfl
      _ ≤ C_mul * B₁ * B₂ := by
          have hpow : (2 : ℝ) ^ k ≤ C_mul :=
            pow_le_pow_right₀ (by norm_num : (1 : ℝ) ≤ 2) hk
