        supportAction2_ℂ C.h_ℂ θ₁ θ₂ := by
      intro θ₁ θ₂
      dsimp [F_curve, supportAction2_ℂ]
      have hsub : (θ₂ - θ₁) / 2 = θ₂ - (θ₁ + θ₂) / 2 := by ring
      rw [hsub, Complex.sin_sub, Complex.cos_sub]
      ring
    have h_ortho_iso : ∀ u₀ u₁ α : ℂ,
        u₀ * Complex.cos α + u₁ * Complex.sin α = 0 →
        u₀ + Complex.I * u₁ = -Complex.exp (2 * Complex.I * α) * (u₀ - Complex.I * u₁) := by
      intro u₀ u₁ α h_dot
      have he_pos : Complex.exp (α * Complex.I) = Complex.cos α + Complex.sin α * Complex.I :=
        Complex.exp_mul_I α
      have he_neg : Complex.exp (-(α * Complex.I)) = Complex.cos α - Complex.sin α * Complex.I := by
        have := Complex.exp_mul_I (-α)
        simpa [Complex.cos_neg, Complex.sin_neg, sub_eq_add_neg] using this
      have h_comb : (u₀ + Complex.I * u₁) * Complex.exp (-(α * Complex.I)) +
          (u₀ - Complex.I * u₁) * Complex.exp (α * Complex.I) = 0 := by
        rw [he_pos, he_neg]
        have hI2 : Complex.I ^ 2 = -1 := Complex.I_sq
        linear_combination 2 * h_dot - 2 * u₁ * Complex.sin α * hI2
      have h_mul := congrArg (fun z => Complex.exp (α * Complex.I) * z) h_comb
      simp only [mul_zero] at h_mul
      have h_cancel : Complex.exp (α * Complex.I) * Complex.exp (-(α * Complex.I)) = 1 := by
        rw [← Complex.exp_add, add_neg_cancel, Complex.exp_zero]
      have h_sq : Complex.exp (α * Complex.I) * Complex.exp (α * Complex.I) =
          Complex.exp (2 * Complex.I * α) := by
        rw [← Complex.exp_add]
        congr 1
        ring
      have h_expnd : Complex.exp (α * Complex.I) *
          ((u₀ + Complex.I * u₁) * Complex.exp (-(α * Complex.I)) +
            (u₀ - Complex.I * u₁) * Complex.exp (α * Complex.I)) =
          (u₀ + Complex.I * u₁) * (Complex.exp (α * Complex.I) * Complex.exp (-(α * Complex.I))) +
          (Complex.exp (α * Complex.I) * Complex.exp (α * Complex.I)) * (u₀ - Complex.I * u₁) := by
        ring
      rw [h_expnd, h_cancel, h_sq, mul_one] at h_mul
      linear_combination h_mul
    have hRefl : ∀ q ∈ collarHalfBaseBox M,
        SatisfiesIsoReflectAt (fun i w => glancingImpact C w.1 w.2 i) q := by
      rintro ⟨y, t⟩ ⟨hy, ht⟩
      have hq_base : (y, t) ∈ collarBaseBox M := ⟨by linarith, by linarith⟩
      have ht_im : |t.im| ≤ ‖t‖ := Complex.abs_im_le_norm t
      have hym_s1 : |(y - t / 2).im| < C.s₁ := by
        have : |(y - t / 2).im| ≤ |y.im| + |t.im| / 2 := by
          have h := abs_add_le y.im (-(t.im / 2))
          simpa [Complex.sub_im, sub_eq_add_neg, abs_div] using h
        linarith
      have hyp_s1 : |(y + t / 2).im| < C.s₁ := by
        have : |(y + t / 2).im| ≤ |y.im| + |t.im| / 2 := by
          have h := abs_add_le y.im (t.im / 2)
          simpa [Complex.add_im, abs_div] using h
        linarith
      have ht_r1 : ‖t‖ < C.r₁ := by linarith
      let Θ_m1 := glancingTheta C (y - t - t / 2) t
      let Θ_0 := glancingTheta C (y - t / 2) t
      let Θ_1 := glancingTheta C (y + t / 2) t
      let Θ_2 := glancingTheta C (y + t + t / 2) t
      let ψ_0 := (Θ_0 + Θ_1) / 2
      have h_stat0 : -supportAction1_ℂ C.h_ℂ Θ_0 Θ_1 = supportAction2_ℂ C.h_ℂ Θ_m1 Θ_0 := by
        have h := C.glancing_stationary (y - t / 2) t hym_s1 ht_r1
        have ha1 : y - t / 2 + t = y + t / 2 := by ring
