        (∀ z ∈ Metric.sphere q R₀, ‖H z‖ ≤ Real.exp M) →
        Real.exp M * (1 / 2 : ℝ) ^ fuel < ‖H q‖ →
        ∃ (N : ℕ) (a : Fin N → ℂ) (G : ℂ → ℂ),
