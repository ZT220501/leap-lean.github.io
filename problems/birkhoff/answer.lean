        iterDerivYT a b h₁ p = iterDerivYT a b h₂ p := by
    intro V hV p hp a b h₁ h₂ heq
    rw [h_it_tay a b h₁ p, h_it_tay a b h₂ p, k_taylor2D_congr hV hp heq]
