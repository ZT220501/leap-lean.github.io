            simpa [iteratedDeriv_zero] using hdW₂.2 0 (by omega) _ hmem)
        nlinarith [abs_nonneg c, norm_nonneg (∫ η in (0 : ℝ)..1, deriv W₂ (z + ((η * c : ℝ) : ℂ) * H₂ z))]
    · intro σ τ w W z H₀ c_fn hσ hτ hW hz1 hz2 hc_cont hc_mem
      have hdW := hCalc.stripExt_deriv_props (m + 15) 1 σ M w W hσ hW (by omega)
