        intro θ p hp
        obtain ⟨_, hp2⟩ := hp_ball hp
        have hne : γ θ - p.1 ≠ 0 := fun h0 => by
          have := hp_sep p hp θ; rw [h0, norm_zero] at this; linarith
        have hu : HasFDerivAt (fun q : ℂ × ℂ => γ θ - q.1) (-π₁) p :=
          ((hasFDerivAt_const (γ θ) p).sub π₁.hasFDerivAt).congr_fderiv (zero_sub π₁)
        have hinv : HasFDerivAt (fun q : ℂ × ℂ => (γ θ - q.1)⁻¹)
            (((γ θ - p.1)⁻¹ ^ 2) • π₁) p := by
          refine ((hasDerivAt_inv hne).comp_hasFDerivAt p hu).congr_fderiv ?_
          refine ContinuousLinearMap.ext fun ⟨v₁, v₂⟩ => ?_
          simp [π₁, inv_pow]
        have hinv2 : HasFDerivAt (fun q : ℂ × ℂ => (γ θ - q.1)⁻¹ * (γ θ - q.1)⁻¹)
