    have h_mid_tr_c0 : ∀ i : Fin k, MvPowerSeries.coeff 0 (lcJetMid2D α_trunc i) = 0 := by
      intro i
      unfold lcJetMid2D
      rw [MvPowerSeries.coeff_C_mul, map_add, hα_tr_c0, hα_tr_c0, add_zero, mul_zero]
    have h_step_tr_c0 : ∀ i : Fin k, MvPowerSeries.coeff 0 (lcJetHalfStep2D α_trunc i) = 0 := by
      intro i
      unfold lcJetHalfStep2D
      rw [MvPowerSeries.coeff_C_mul, map_sub, hα_tr_c0, hα_tr_c0, sub_self, mul_zero]
