          _ ≤ ‖slNumerator (Q p) w.1 w.2 - slNumerator (Q p₀) w.1 w.2‖ +
                ‖slNumerator (Q p₀) w.1 w.2 - slNumerator (Q p₀) w₀.1 w₀.2‖ := norm_add_le _ _
