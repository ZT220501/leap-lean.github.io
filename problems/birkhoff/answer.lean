    fun i => lineRecJetSeq (A_jet i) (Δψ i)
  let K_seq : ℕ → ℂ :=
    fun l => PowerSeries.coeff l (lineRecLiftArcFn E.F_val Φ (G.A_line p₁))
  let β_full : ℕ → Fin (k + 1) → MvPowerSeries (Fin 2) ℂ :=
    fun l r =>
      match l with
      | 0 => centeredTaylor2D (G.α_fn r) p₁
      | m + 1 => fun d =>
          if d = 0 then PowerSeries.coeff (m + 1) (Δα r)
          else PowerSeries.coeff (m + 1)
            (lineRecLiftArcFn E.F_val Φ
              (MvPowerSeries.coeff d (centeredTaylor2D (G.α_fn r) p₁)))
  let sin_d0 : Fin k → ℂ := fun i => Complex.sin (G.d_fn i p₁)
  let cos_d0 : Fin k → ℂ := fun i => Complex.cos (G.d_fn i p₁)
  have hc_sq : ∀ r : Fin (k + 1), (c_star r) ^ 2 + (s_star r) ^ 2 = 1 :=
    fun r => Complex.cos_sq_add_sin_sq (G.α_fn r p₁ / 2)
  have hCS_sq : ∀ r : Fin (k + 1), (C_ser r) ^ 2 + (S_ser r) ^ 2 = 1 := by
    intro r
    obtain ⟨hcF, hsF⟩ := E.half_angles_mem r
    have h1 : (C_ser r) ^ 2 = lineRecLiftArcFn E.F_val Φ ((c_star r) ^ 2) := by
      rw [sq, sq, (hLift_F _ hcF _ hcF).2.2]
    have h2 : (S_ser r) ^ 2 = lineRecLiftArcFn E.F_val Φ ((s_star r) ^ 2) := by
      rw [sq, sq, (hLift_F _ hsF _ hsF).2.2]
    rw [h1, h2,
      ← (hLift_F (c_star r ^ 2) (by rw [sq]; exact E.F_val.mul_mem hcF hcF)
          (s_star r ^ 2) (by rw [sq]; exact E.F_val.mul_mem hsF hsF)).1,
      hc_sq r, hLift_K 1 E.K_end.one_mem, map_one]
  have hθ_const0 : ∀ r : Fin (k + 1), PowerSeries.constantCoeff (θ r) = 0 :=
    fun r => (hTrig.circle_lift (c_star r) (s_star r) (C_ser r) (S_ser r)
      (hc_sq r) (hCS_sq r) (hLift_const _) (hLift_const _)).1
  have hΔα_const0 : ∀ r : Fin (k + 1), PowerSeries.constantCoeff (Δα r) = 0 := by
    intro r; simp [Δα, hθ_const0 r]
  have hΔψ_const0 : ∀ i : Fin k, PowerSeries.constantCoeff (Δψ i) = 0 := by
    intro i; simp [Δψ, hΔα_const0]
  have hΔd_eq : ∀ i : Fin k, Δd i = θ i.succ - θ i.castSucc := by
    intro i
    dsimp only [Δd, Δα]
    have h2_half : (2 : PowerSeries ℂ) * PowerSeries.C (1 / 2 : ℂ) = 1 := by
      have h2 : (2 : PowerSeries ℂ) = PowerSeries.C (2 : ℂ) := by rw [map_ofNat]
      rw [h2, ← map_mul]; norm_num
    calc (2 * θ i.succ - 2 * θ i.castSucc) * PowerSeries.C (1 / 2 : ℂ)
        = ((2 : PowerSeries ℂ) * PowerSeries.C (1 / 2 : ℂ)) *
            (θ i.succ - θ i.castSucc) := by ring
      _ = θ i.succ - θ i.castSucc := by rw [h2_half, one_mul]
  have hΔd_const0 : ∀ i : Fin k, PowerSeries.constantCoeff (Δd i) = 0 := by
    intro i; rw [hΔd_eq i, map_sub, hθ_const0, hθ_const0, sub_self]
  have hθ_zero_end : θ 0 = 0 ∧ θ (Fin.last k) = 0 := by
    obtain ⟨hα0, hαlast⟩ := hα_end p₁ hp₁_U₀
    constructor
    · rw [(hTrig.circle_lift _ _ _ _ (hc_sq 0) (hCS_sq 0)
        (hLift_const _) (hLift_const _)).2.2.2]
      have hc0_mem : c_star 0 ∈ E.K_end := by
        dsimp only [c_star]; rw [hα0]; exact E.cos_half_zero_mem
      have hs0_mem : s_star 0 ∈ E.K_end := by
        dsimp only [s_star]; rw [hα0]; exact E.sin_half_zero_mem
      exact ⟨hLift_K _ hc0_mem, hLift_K _ hs0_mem⟩
    · rw [(hTrig.circle_lift _ _ _ _ (hc_sq (Fin.last k)) (hCS_sq (Fin.last k))
        (hLift_const _) (hLift_const _)).2.2.2]
      have hcl_mem : c_star (Fin.last k) ∈ E.K_end := by
        dsimp only [c_star]; rw [hαlast]; exact E.cos_half_last_mem
      have hsl_mem : s_star (Fin.last k) ∈ E.K_end := by
        dsimp only [s_star]; rw [hαlast]; exact E.sin_half_last_mem
      exact ⟨hLift_K _ hcl_mem, hLift_K _ hsl_mem⟩
  have hΔα_end : Δα 0 = 0 ∧ Δα (Fin.last k) = 0 := by
    simp [Δα, hθ_zero_end.1, hθ_zero_end.2]
  have hf_zero : ∀ i : Fin k, f_full i 0 = lineArcHoloTaylor1D C.h_ℂ (G.ψ_fn i p₁) := by
    intro i
    ext n
    rw [hLift.jetSeq_zero, hLift_const]
    simp [lineArcHoloTaylor1D, holoTaylor1D]
  have hβ_zero : ∀ r : Fin (k + 1), β_full 0 r = centeredTaylor2D (G.α_fn r) p₁ :=
    fun _ => rfl
  have h_tay_c0 : ∀ (f : ℂ × ℂ → ℂ), MvPowerSeries.coeff 0 (taylor2D f p₁) = f p₁ := by
    intro f
    change taylor2D f p₁ 0 = f p₁
    simp [taylor2D, iterDerivYT, iterDerivY]
  have h_ctay_c0 : ∀ (ψ : ℂ × ℂ → ℂ), MvPowerSeries.coeff 0 (centeredTaylor2D ψ p₁) = 0 := by
    intro ψ
    rw [centeredTaylor2D, h_tay_c0, sub_self]
  have hβ_end : ∀ l : ℕ, 1 ≤ l → β_full l 0 = 0 ∧ β_full l (Fin.last k) = 0 := by
    have h_ct0 : centeredTaylor2D (G.α_fn 0) p₁ = MvPowerSeries.X 0 := by
      rw [centeredTaylor2D,
        hJet.taylor2D_congr hU₀_open hp₁_U₀ (f₂ := fun q => q.1 - p₁.1) (fun q hq => by
          rw [(hα_end q hq).1, (hα_end p₁ hp₁_U₀).1])]
      exact (hJet.taylor2D_linear_coords p₁).1
    have h_ctl : centeredTaylor2D (G.α_fn (Fin.last k)) p₁ =
        MvPowerSeries.X 0 + MvPowerSeries.X 1 := by
      rw [centeredTaylor2D,
        hJet.taylor2D_congr hU₀_open hp₁_U₀
          (f₂ := fun q => (q.1 - p₁.1) + (q.2 - p₁.2)) (fun q hq => by
            rw [(hα_end q hq).2, (hα_end p₁ hp₁_U₀).2]; ring)]
      have h1 : DifferentiableOn ℂ (fun q : ℂ × ℂ => q.1 - p₁.1) U₀ :=
        h_diff_sub differentiableOn_fst (differentiableOn_const _)
      have h2 : DifferentiableOn ℂ (fun q : ℂ × ℂ => q.2 - p₁.2) U₀ :=
        h_diff_sub differentiableOn_snd (differentiableOn_const _)
      rw [h_tay_add h1 h2]
      exact congrArg₂ (· + ·)
        (hJet.taylor2D_linear_coords p₁).1 (hJet.taylor2D_linear_coords p₁).2
    have h_mem0 : lineCoreCoeffsIn E.K_end (centeredTaylor2D (G.α_fn 0) p₁) := by
      rw [h_ct0]; exact hSub.X_mem E.K_end 0
    have h_meml : lineCoreCoeffsIn E.K_end (centeredTaylor2D (G.α_fn (Fin.last k)) p₁) := by
      rw [h_ctl]; exact hSub.add_mem E.K_end (hSub.X_mem E.K_end 0) (hSub.X_mem E.K_end 1)
    intro l hl
    rcases l with _ | m
    · omega
    · constructor
      · ext d
        change (if d = 0 then PowerSeries.coeff (m + 1) (Δα 0)
          else PowerSeries.coeff (m + 1)
            (lineRecLiftArcFn E.F_val Φ (MvPowerSeries.coeff d (centeredTaylor2D (G.α_fn 0) p₁)))) = 0
        split_ifs
        · rw [hΔα_end.1, map_zero]
        · rw [hLift_K _ (h_mem0 d), PowerSeries.coeff_C, if_neg (Nat.succ_ne_zero m)]
      · ext d
        change (if d = 0 then PowerSeries.coeff (m + 1) (Δα (Fin.last k))
          else PowerSeries.coeff (m + 1)
            (lineRecLiftArcFn E.F_val Φ
              (MvPowerSeries.coeff d (centeredTaylor2D (G.α_fn (Fin.last k)) p₁)))) = 0
        split_ifs
        · rw [hΔα_end.2, map_zero]
        · rw [hLift_K _ (h_meml d), PowerSeries.coeff_C, if_neg (Nat.succ_ne_zero m)]
  have h_holo1D_deriv : ∀ (g : ℂ → ℂ) (z₀ : ℂ),
      PowerSeries.derivative (lineArcHoloTaylor1D g z₀) = lineArcHoloTaylor1D (deriv g) z₀ := by
    intro g z₀
    ext n
    rw [PowerSeries.coeff_derivative]
    simp only [lineArcHoloTaylor1D, holoTaylor1D, PowerSeries.coeff_mk]
    rw [iteratedDeriv_succ', Nat.factorial_succ, Nat.cast_mul, Nat.cast_add, Nat.cast_one]
    have hne : ((n : ℂ) + 1) ≠ 0 := by exact_mod_cast Nat.succ_ne_zero n
    rw [div_mul_eq_mul_div, mul_comm (iteratedDeriv n (deriv g) z₀), mul_div_mul_left _ _ hne]
  have h_ctay_ψ : ∀ i : Fin k,
      centeredTaylor2D (G.ψ_fn i) p₁ = lineRecMid0 (β_full 0) i := by
    intro i
    rw [centeredTaylor2D,
      hJet.taylor2D_congr hU₀_open hp₁_U₀
        (f₂ := fun q =>
          ((G.α_fn i.castSucc q - G.α_fn i.castSucc p₁) +
            (G.α_fn i.succ q - G.α_fn i.succ p₁)) * (1 / 2 : ℂ))
        (fun q _ => by
          change (G.α_fn i.castSucc q + G.α_fn i.succ q) / 2 -
            (G.α_fn i.castSucc p₁ + G.α_fn i.succ p₁) / 2 = _
          ring)]
    have h1 : DifferentiableOn ℂ (fun q => G.α_fn i.castSucc q - G.α_fn i.castSucc p₁) U₀ :=
      h_diff_sub (G.α_holo i.castSucc) (differentiableOn_const _)
    have h2 : DifferentiableOn ℂ (fun q => G.α_fn i.succ q - G.α_fn i.succ p₁) U₀ :=
      h_diff_sub (G.α_holo i.succ) (differentiableOn_const _)
    rw [h_tay_mulc (1 / 2 : ℂ) (h_diff_add h1 h2), h_tay_add h1 h2]
    rfl
  have h_ctay_d : ∀ i : Fin k,
      centeredTaylor2D (G.d_fn i) p₁ = lineRecHalfStep0 (β_full 0) i := by
    intro i
    rw [centeredTaylor2D,
      hJet.taylor2D_congr hU₀_open hp₁_U₀
        (f₂ := fun q =>
          ((G.α_fn i.succ q - G.α_fn i.succ p₁) -
            (G.α_fn i.castSucc q - G.α_fn i.castSucc p₁)) * (1 / 2 : ℂ))
        (fun q _ => by
          change (G.α_fn i.succ q - G.α_fn i.castSucc q) / 2 -
            (G.α_fn i.succ p₁ - G.α_fn i.castSucc p₁) / 2 = _
          ring)]
    have h1 : DifferentiableOn ℂ (fun q => G.α_fn i.succ q - G.α_fn i.succ p₁) U₀ :=
      h_diff_sub (G.α_holo i.succ) (differentiableOn_const _)
    have h2 : DifferentiableOn ℂ (fun q => G.α_fn i.castSucc q - G.α_fn i.castSucc p₁) U₀ :=
      h_diff_sub (G.α_holo i.castSucc) (differentiableOn_const _)
    rw [h_tay_mulc (1 / 2 : ℂ) (h_diff_sub h1 h2), h_tay_sub h1 h2]
    rfl
  have h_tay_h : ∀ i : Fin k,
      taylor2D (fun q => C.h_ℂ (G.ψ_fn i q)) p₁ =
        compPowerSeries2D (f_full i 0) (lineRecMid0 (β_full 0) i) ∧
      taylor2D (fun q => deriv C.h_ℂ (G.ψ_fn i q)) p₁ =
        compPowerSeries2D (PowerSeries.derivative (f_full i 0)) (lineRecMid0 (β_full 0) i) ∧
      taylor2D (fun q => deriv (deriv C.h_ℂ) (G.ψ_fn i q)) p₁ =
        compPowerSeries2D (PowerSeries.derivative (PowerSeries.derivative (f_full i 0)))
          (lineRecMid0 (β_full 0) i) := by
    intro i
    refine ⟨?_, ?_, ?_⟩
    · rw [hJet.taylor2D_comp_1D hU₀_open hW₀_open hp₁_U₀ (hψ_holo i) C.h_ℂ_holo
        (G.ψ_maps_strip i), ← hf_zero i, h_ctay_ψ i]
    · rw [hJet.taylor2D_comp_1D hU₀_open hW₀_open hp₁_U₀ (hψ_holo i) hh'_holo
        (G.ψ_maps_strip i), ← h_holo1D_deriv, ← hf_zero i, h_ctay_ψ i]
    · rw [hJet.taylor2D_comp_1D hU₀_open hW₀_open hp₁_U₀ (hψ_holo i) hh''_holo
        (G.ψ_maps_strip i), ← h_holo1D_deriv, ← h_holo1D_deriv, ← hf_zero i, h_ctay_ψ i]
  have h_tay_sincos : ∀ i : Fin k,
      taylor2D (fun q => Complex.sin (G.d_fn i q)) p₁ =
        lineRecSin0 sin_d0 cos_d0 (β_full 0) i ∧
      taylor2D (fun q => Complex.cos (G.d_fn i q)) p₁ =
        lineRecCos0 sin_d0 cos_d0 (β_full 0) i := by
    intro i
    let δd_fn : ℂ × ℂ → ℂ := fun q => G.d_fn i q - G.d_fn i p₁
    have hδd_holo : DifferentiableOn ℂ δd_fn U₀ := (hd_holo i).sub (differentiableOn_const _)
    have hδd_p₁ : δd_fn p₁ = 0 := sub_self _
    have h_ct_δd : centeredTaylor2D δd_fn p₁ = lineRecHalfStep0 (β_full 0) i := by
      unfold centeredTaylor2D
      simp only [hδd_p₁, sub_zero]
      exact h_ctay_d i
    have h_sin_δ : taylor2D (fun q => Complex.sin (δd_fn q)) p₁ =
        compPowerSeries2D lineArcPsSin0 (lineRecHalfStep0 (β_full 0) i) := by
      rw [hJet.taylor2D_comp_1D hU₀_open isOpen_univ hp₁_U₀ hδd_holo
        Complex.differentiable_sin.differentiableOn (fun _ _ => Set.mem_univ _),
        hδd_p₁, h_ct_δd]
      rfl
    have h_cos_δ : taylor2D (fun q => Complex.cos (δd_fn q)) p₁ =
        compPowerSeries2D lineArcPsCos0 (lineRecHalfStep0 (β_full 0) i) := by
      rw [hJet.taylor2D_comp_1D hU₀_open isOpen_univ hp₁_U₀ hδd_holo
        Complex.differentiable_cos.differentiableOn (fun _ _ => Set.mem_univ _),
        hδd_p₁, h_ct_δd]
      rfl
    have hsin_d_holo : DifferentiableOn ℂ (fun q => Complex.sin (δd_fn q)) U₀ :=
      Complex.differentiable_sin.comp_differentiableOn hδd_holo
    have hcos_d_holo : DifferentiableOn ℂ (fun q => Complex.cos (δd_fn q)) U₀ :=
      Complex.differentiable_cos.comp_differentiableOn hδd_holo
    constructor
    · rw [hJet.taylor2D_congr hU₀_open hp₁_U₀
        (f₂ := fun q => sin_d0 i * Complex.cos (δd_fn q) + cos_d0 i * Complex.sin (δd_fn q))
        (fun q _ => by
          dsimp only [sin_d0, cos_d0, δd_fn]
          have h_split : G.d_fn i q = G.d_fn i p₁ + (G.d_fn i q - G.d_fn i p₁) := by ring
          conv_lhs => rw [h_split]
          rw [Complex.sin_add])]
      rw [h_tay_add (h_diff_cmul _ hcos_d_holo) (h_diff_cmul _ hsin_d_holo),
        h_tay_cmul _ hcos_d_holo, h_tay_cmul _ hsin_d_holo, h_cos_δ, h_sin_δ]
      rfl
    · rw [hJet.taylor2D_congr hU₀_open hp₁_U₀
        (f₂ := fun q => cos_d0 i * Complex.cos (δd_fn q) - sin_d0 i * Complex.sin (δd_fn q))
        (fun q _ => by
          dsimp only [sin_d0, cos_d0, δd_fn]
          have h_split : G.d_fn i q = G.d_fn i p₁ + (G.d_fn i q - G.d_fn i p₁) := by ring
          conv_lhs => rw [h_split]
          rw [Complex.cos_add])]
      rw [h_tay_sub (h_diff_cmul _ hcos_d_holo) (h_diff_cmul _ hsin_d_holo),
        h_tay_cmul _ hcos_d_holo, h_tay_cmul _ hsin_d_holo, h_cos_δ, h_sin_δ]
      rfl
  have h_h_holo : ∀ i : Fin k, DifferentiableOn ℂ (fun q => C.h_ℂ (G.ψ_fn i q)) U₀ :=
    fun i => C.h_ℂ_holo.comp (hψ_holo i) (G.ψ_maps_strip i)
  have h_h'_holo : ∀ i : Fin k, DifferentiableOn ℂ (fun q => deriv C.h_ℂ (G.ψ_fn i q)) U₀ :=
    fun i => hh'_holo.comp (hψ_holo i) (G.ψ_maps_strip i)
  have h_h''_holo : ∀ i : Fin k,
      DifferentiableOn ℂ (fun q => deriv (deriv C.h_ℂ) (G.ψ_fn i q)) U₀ :=
    fun i => hh''_holo.comp (hψ_holo i) (G.ψ_maps_strip i)
  have h_sin_holo : ∀ i : Fin k, DifferentiableOn ℂ (fun q => Complex.sin (G.d_fn i q)) U₀ :=
    fun i => Complex.differentiable_sin.comp_differentiableOn (hd_holo i)
  have h_cos_holo : ∀ i : Fin k, DifferentiableOn ℂ (fun q => Complex.cos (G.d_fn i q)) U₀ :=
    fun i => Complex.differentiable_cos.comp_differentiableOn (hd_holo i)
  have h_tay_w : ∀ i : Fin k,
      taylor2D (G.w_fn i) p₁ = 2 * lineRecSin0 sin_d0 cos_d0 (β_full 0) i := by
    intro i
    change taylor2D (fun q => (2 : ℂ) * Complex.sin (G.d_fn i q)) p₁ = _
    rw [h_tay_cmul 2 (h_sin_holo i), (h_tay_sincos i).1, map_ofNat]
  have h_tay_sum : ∀ {ι : Type} (s : Finset ι) (F : ι → ℂ × ℂ → ℂ),
      (∀ idx ∈ s, DifferentiableOn ℂ (F idx) U₀) →
      DifferentiableOn ℂ (fun q => ∑ idx ∈ s, F idx q) U₀ ∧
        taylor2D (fun q => ∑ idx ∈ s, F idx q) p₁ = ∑ idx ∈ s, taylor2D (F idx) p₁ := by
    intro ι s F hF
    classical
    induction s using Finset.induction_on with
    | empty =>
      refine ⟨differentiableOn_const 0, ?_⟩
      simpa using hJet.taylor2D_const p₁ 0
    | insert a s ha ih =>
      have ha_h : DifferentiableOn ℂ (F a) U₀ := hF a (Finset.mem_insert_self a s)
      obtain ⟨hs_diff, hs_tay⟩ := ih (fun idx hidx => hF idx (Finset.mem_insert_of_mem hidx))
      refine ⟨(h_diff_add ha_h hs_diff).congr (fun q _ => Finset.sum_insert ha), ?_⟩
      rw [hJet.taylor2D_congr hU₀_open hp₁_U₀
          (f₂ := fun q => F a q + ∑ idx ∈ s, F idx q) (fun q _ => Finset.sum_insert ha),
        h_tay_add ha_h hs_diff, hs_tay, Finset.sum_insert ha]
  have h_tay_Aline :
      taylor2D G.A_line p₁ =
        ∑ i : Fin k,
          2 * compPowerSeries2D (f_full i 0) (lineRecMid0 (β_full 0) i) *
            lineRecSin0 sin_d0 cos_d0 (β_full 0) i := by
    change taylor2D (fun q =>
      ∑ i : Fin k, (2 : ℂ) * C.h_ℂ (G.ψ_fn i q) * Complex.sin (G.d_fn i q)) p₁ = _
    rw [(h_tay_sum Finset.univ
      (fun i q => (2 : ℂ) * C.h_ℂ (G.ψ_fn i q) * Complex.sin (G.d_fn i q))
      (fun i _ => h_diff_mul (h_diff_cmul 2 (h_h_holo i)) (h_sin_holo i))).2]
    apply Finset.sum_congr rfl
    intro i _
    rw [h_tay_mul (h_diff_cmul 2 (h_h_holo i)) (h_sin_holo i),
      h_tay_cmul 2 (h_h_holo i), map_ofNat, (h_tay_h i).1, (h_tay_sincos i).1]
  have h_grad0_zero : ∀ r : Fin (k - 1),
      lineRecGrad0 sin_d0 cos_d0 (fun i => f_full i 0) (β_full 0) r = 0 := by
    intro r
    let i_L : Fin k := ⟨r.1, by have := r.2; omega⟩
    let i_R : Fin k := ⟨r.1 + 1, by have := r.2; omega⟩
    have h_stat_tay :
        taylor2D
          (fun q => lineInteriorGrad (fun _ => C.h_ℂ) (fun _ => deriv C.h_ℂ)
            (fun s => G.α_fn s q) r) p₁ = 0 := by
      rw [hJet.taylor2D_congr hU₀_open hp₁_U₀ (f₂ := fun _ => 0)
        (fun q hq => G.stationary_on_chart q hq r),
        hJet.taylor2D_const, map_zero]
    rw [← h_stat_tay]
    unfold lineInteriorGrad lineRecGrad0
    dsimp only
    change _ = taylor2D
      (fun q =>
        (deriv C.h_ℂ (G.ψ_fn i_L q) * Complex.sin (G.d_fn i_L q) +
          C.h_ℂ (G.ψ_fn i_L q) * Complex.cos (G.d_fn i_L q) +
          deriv C.h_ℂ (G.ψ_fn i_R q) * Complex.sin (G.d_fn i_R q)) -
        C.h_ℂ (G.ψ_fn i_R q) * Complex.cos (G.d_fn i_R q)) p₁
    have ht1 := h_diff_mul (h_h'_holo i_L) (h_sin_holo i_L)
    have ht2 := h_diff_mul (h_h_holo i_L) (h_cos_holo i_L)
    have ht3 := h_diff_mul (h_h'_holo i_R) (h_sin_holo i_R)
    have ht4 := h_diff_mul (h_h_holo i_R) (h_cos_holo i_R)
    rw [h_tay_sub (h_diff_add (h_diff_add ht1 ht2) ht3) ht4,
      h_tay_add (h_diff_add ht1 ht2) ht3,
      h_tay_add ht1 ht2,
      h_tay_mul (h_h'_holo i_L) (h_sin_holo i_L),
      h_tay_mul (h_h_holo i_L) (h_cos_holo i_L),
      h_tay_mul (h_h'_holo i_R) (h_sin_holo i_R),
