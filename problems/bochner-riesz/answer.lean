        change ‖∑ α ∈ U₁ ∪ U₂, W α‖ ^ 2 ≤ 2 * ‖∑ α ∈ U₁, W α‖ ^ 2 + 2 * ‖∑ α ∈ U₂, W α‖ ^ 2
        rw [Finset.sum_union hU_disj]
