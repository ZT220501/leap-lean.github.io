          (by linarith : u₀ - 2 * h ≤ u₀ - h) (by linarith : u₀ - h ≤ u₀ + 2 * h)
          (Filter.Eventually.of_forall (fun u =>
            intervalIntegral.integral_nonneg (by linarith) (fun _ _ => abs_nonneg _)))
          (h_box_ii _ _)
        calc ((3 / 2) * lam_s * h ^ 2)⁻¹ * ∫ u in (u₀ - 2 * h)..(u₀ - h),
              ∫ r in (0 : ℝ)..(lam_s * (u₀ - u)), |a j (b u₀ - p * (u - u₀) + r, u) - a_plus j|
            ≤ ((3 / 2) * lam_s * h ^ 2)⁻¹ * ∫ u in (u₀ - 2 * h)..(u₀ + 2 * h),
                ∫ r in (0 : ℝ)..(2 * h), |a j (b u₀ - p * (u - u₀) + r, u) - a_plus j| :=
              mul_le_mul_of_nonneg_left (le_trans h_step1 h_step2) (by positivity)
          _ = (8 / (3 * lam_s)) * ((2 * h)⁻¹ ^ 2 * ∫ u in (u₀ - 2 * h)..(u₀ + 2 * h),
                ∫ r in (0 : ℝ)..(2 * h), |a j (b u₀ - p * (u - u₀) + r, u) - a_plus j|) := by
              field_simp [hlam_pos.ne', hh.ne']
              ring
    obtain ⟨r_p0, _, hP_rp0, hψ_rp0, htr_rp0⟩ := h_s4 a_plus
      (fun h => u₀ - 2 * h) (fun h => u₀ - h)
      (fun _ _ => 0) (fun _ u => lam_s * (u₀ - u))
      (fun _ => ⟨continuous_const, continuous_const.mul (continuous_const.sub continuous_id)⟩)
      (fun r => γ - r j₀)
      (continuous_const.sub (continuous_apply j₀))
      h_geom_0 h_mean_ψ_0 h_mean_S_0 h_mean_tr_0
    refine ⟨r_p0, hP_rp0, by linarith, htr_rp0 j_top (by linarith [hc_top_val, hm]), ?_⟩
    rwa [h_sum_char r_p0 a_plus htr_rp0]
  · 
    rintro ⟨_, hp_lt⟩
    have h_j := h_jmp (by linarith [hc_top_val])
    rwa [hc_top_val] at h_j

theorem characteristic_plane_trace_and_contact (n : ℕ) (hn : 2 ≤ n) (j₀ j_top : Fin n)
    (c d : Fin n → ℝ) (d_v : ℝ) (E_cone : Fin n → Fin n → Prop)
    (hc_inj : Function.Injective c)
    (hc_zero : c j₀ = 0)
    (hc_min : ∀ j : Fin n, c j₀ ≤ c j)
    (hc_top : ∀ j : Fin n, j ≠ j_top → c j < c j_top)
    (hd_nn : (∀ j, 0 ≤ d j) ∧ d j_top ≤ 1 ∧ 0 ≤ d_v)
    (hE_pos : ∀ j k : Fin n, E_cone j k → 0 < c k - c j)
    (f : ((Fin n → ℝ) × ℝ) → ℝ)
    (hf : IsSubmodularConeProfile n c d d_v E_cone f) :
    ∃ (a : Fin n → ℝ × ℝ → ℝ) (D : ℝ × ℝ → ℝ) (h_seq : ℕ → ℝ),
      (∀ j, Measurable (a j) ∧ ∀ iu, 0 ≤ a j iu ∧ a j iu ≤ d j) ∧
      (Measurable D ∧ ∀ iu, 0 ≤ D iu ∧ D iu ≤ d_v) ∧
      (∀ l, 0 < h_seq l) ∧
      Filter.Tendsto h_seq Filter.atTop (nhds 0) ∧
      (∀ᵐ iu : ℝ × ℝ, iu.2 ∈ Set.Ioo (0 : ℝ) 1 →
        ∀ (R ε_err : ℝ), 1 ≤ R → 0 < ε_err →
          ∀ᶠ l in Filter.atTop, ∀ ξ : (Fin n → ℝ) × ℝ,
            InDispCone n c E_cone ξ → (∀ j, |ξ.1 j| ≤ R) → |ξ.2| ≤ R →
            |(f (planeEmbed n c iu + h_seq l • ξ) - f (planeEmbed n c iu)) / h_seq l -
              ((∑ j : Fin n, a j iu * ξ.1 j) + D iu * ξ.2)| ≤ ε_err) ∧
      (∀ (γ m β τ : ℝ) (b S : ℝ → ℝ) (g_x : ℝ → ℝ → ℝ)
         (P_rates : ℝ → (Fin n → ℝ) → Prop),
        0 < γ → 0 < m → c j_top = 1 + m →
        (∀ u₁ u₂ : ℝ, u₁ ≤ u₂ → 0 ≤ b u₁ - b u₂ ∧ b u₁ - b u₂ ≤ (1 + m) * (u₂ - u₁)) →
        (∀ u ∈ Set.Icc (0 : ℝ) 1, 0 ≤ b u ∧ b u + (1 + m) * u ≤ 1 + m) →
        (∀ u₁ u₂ : ℝ, u₁ ≤ u₂ → 0 ≤ S u₂ - S u₁ ∧ S u₂ - S u₁ ≤ u₂ - u₁) →
        (∀ (i u : ℝ), u ∈ Set.Ioo (0 : ℝ) 1 → 0 ≤ i → i + (1 + m) * u ≤ 1 + m →
          2 * i + (1 - γ) * m * u + 2 * S u - β * u - τ ≤ f (planeEmbed n c (i, u))) →
        (∀ u ∈ Set.Ioo (0 : ℝ) 1,
          f (planeEmbed n c (b u, u)) = 2 * (b u) + (1 - γ) * m * u + 2 * S u - β * u - τ) →
        (∀ u₀ ∈ Set.Ioo (0 : ℝ) 1,
          g_x u₀ 0 = 0 ∧
          (∀ d₁ d₂ : ℝ, d₁ ≤ d₂ → 0 ≤ g_x u₀ d₂ - g_x u₀ d₁ ∧ g_x u₀ d₂ - g_x u₀ d₁ ≤ d₂ - d₁) ∧
          (∀ d_r : ℝ, 0 ≤ d_r → d_r ≤ m * u₀ → γ * d_r ≤ g_x u₀ d_r) ∧
          (∀ (lam_s h i t : ℝ),
            0 < lam_s → lam_s < min 1 m → 0 < h → h < u₀ →
            b u₀ ≤ i → i ≤ b u₀ + lam_s * h → 0 < t → i + t < b u₀ + m * u₀ →
            let p₀ := planeEmbed n c (i, u₀ - h)
            let p_t := (Function.update p₀.1 j₀ (p₀.1 j₀ + t), p₀.2)
            g_x u₀ (i - b u₀ + t) - g_x u₀ (i - b u₀) ≤ f p_t - f p₀)) →
        IsClosed { sr : ℝ × (Fin n → ℝ) | P_rates sr.1 sr.2 } →
        (∀ᵐ iu : ℝ × ℝ, 0 < iu.1 ∧ iu.2 ∈ Set.Ioo (0 : ℝ) 1 →
          ∃ s_u : ℝ, HasDerivAt S s_u iu.2 ∧ 0 < s_u ∧ s_u ≤ 1 ∧ P_rates s_u (fun j => a j iu)) →
        ∃ (p s z_minus z_plus D_minus D_plus : ℝ),
          0 ≤ p ∧ p ≤ 1 + m ∧ 0 < s ∧ s ≤ 1 ∧
          0 ≤ z_minus ∧ z_minus ≤ 1 ∧ 0 ≤ z_plus ∧ z_plus ≤ 1 ∧
          0 ≤ D_minus ∧ 0 ≤ D_plus ∧
          (0 < p → ∃ r_m : Fin n → ℝ,
            P_rates s r_m ∧ (∑ j, r_m j) - 2 ≤ 0 ∧ γ ≤ r_m j₀ ∧
            (p < 1 + m → r_m j_top = z_minus) ∧
            (2 * p - m + ∑ j, (c j - p) * r_m j) + D_minus = 2 * s - β - γ * m) ∧
          (p < 1 + m → ∃ r_p : Fin n → ℝ,
            P_rates s r_p ∧ 0 ≤ (∑ j, r_p j) - 2 ∧ r_p j_top = z_plus ∧
            (2 * p - m + ∑ j, (c j - p) * r_p j) + D_plus = 2 * s - β - γ * m) ∧
          (p = 0 → ∃ r_p0 : Fin n → ℝ,
            P_rates s r_p0 ∧ γ ≤ r_p0 j₀ ∧ r_p0 j_top = z_plus ∧
            (2 * p - m + ∑ j, (c j - p) * r_p0 j) + D_plus = 2 * s - β - γ * m) ∧
          (0 < p ∧ p < 1 + m → (1 + m - p) * (z_plus - z_minus) ≤ D_minus - D_plus)) :=
by
  have hd_pair : (∀ j, 0 ≤ d j) ∧ 0 ≤ d_v := ⟨hd_nn.1, hd_nn.2.2⟩
  obtain ⟨a, D, h_tr⟩ :=
    submodular_plane_strong_traces n hn j_top c d d_v E_cone hc_inj hc_top hd_pair hE_pos f hf
  obtain ⟨h_seq, hh_pos, hh_lim, h_blow⟩ :=
    cone_uniform_affine_blowup n hn j_top c d d_v E_cone hc_inj hd_pair hE_pos f hf a D h_tr
  refine ⟨a, D, h_seq, h_tr.1, h_tr.2.1, hh_pos, hh_lim, h_blow, ?_⟩
  intro γ m β τ b S g_x P_rates hγ hm hc_top_val hb_lip hb_dom hS_lip h_obs h_cont h_xref
    hP_closed h_rates_ae
  have h_ex_Ioo : ∀ {P : ℝ → Prop}, (∀ᵐ x : ℝ, P x) → ∃ x ∈ Set.Ioo (0 : ℝ) 1, P x := by
    intro P hP
    by_contra h_none
    have h_sub : Set.Ioo (0 : ℝ) 1 ⊆ { x : ℝ | ¬ P x } :=
      fun x hx hPx => h_none ⟨x, hx, hPx⟩
    have h_zero : MeasureTheory.volume { x : ℝ | ¬ P x } = 0 := MeasureTheory.ae_iff.mp hP
    have h_le := MeasureTheory.measure_mono_null h_sub h_zero
    rw [Real.volume_Ioo] at h_le
    norm_num at h_le
  have hb_abs_lip : ∀ u₁ u₂ : ℝ, |b u₁ - b u₂| ≤ (1 + m) * |u₁ - u₂| := by
    intro u₁ u₂
    rcases le_total u₁ u₂ with h_le | h_ge
    · obtain ⟨h1, h2⟩ := hb_lip u₁ u₂ h_le
      rw [abs_of_nonneg h1, abs_of_nonpos (sub_nonpos.mpr h_le)]
      linarith
    · obtain ⟨h1, h2⟩ := hb_lip u₂ u₁ h_ge
      rw [abs_sub_comm, abs_of_nonneg h1, abs_of_nonneg (sub_nonneg.mpr h_ge)]
      exact h2
  have h1m_nn : (0 : ℝ) ≤ 1 + m := by linarith
  have h_curve_ae :=
    directional_bv_transverse_curve_traces n j_top c d d_v E_cone hd_nn f a D h_tr b (1 + m)
      h1m_nn hb_abs_lip
  have h_rates_swap : ∀ᵐ ui : ℝ × ℝ, 0 < ui.2 ∧ ui.1 ∈ Set.Ioo (0 : ℝ) 1 →
      ∃ s_u : ℝ, HasDerivAt S s_u ui.1 ∧ 0 < s_u ∧ s_u ≤ 1 ∧
        P_rates s_u (fun j => a j (ui.2, ui.1)) :=
    (MeasureTheory.Measure.measurePreserving_swap
      (μ := MeasureTheory.volume) (ν := MeasureTheory.volume)).quasiMeasurePreserving.ae h_rates_ae
  have h_S_der_ae : ∀ᵐ u₀ : ℝ, u₀ ∈ Set.Ioo (0 : ℝ) 1 →
      ∃ s : ℝ, HasDerivAt S s u₀ ∧ 0 < s ∧ s ≤ 1 := by
    filter_upwards [MeasureTheory.Measure.ae_ae_of_ae_prod h_rates_swap] with u₀ hu₀_ae hu₀_mem
    obtain ⟨i₀, hi₀_mem, hi₀_prop⟩ := h_ex_Ioo hu₀_ae
    obtain ⟨s, hS_der, hs_pos, hs_le, _⟩ := hi₀_prop ⟨hi₀_mem.1, hu₀_mem⟩
    exact ⟨s, hS_der, hs_pos, hs_le⟩
  have hS_lip1 : LipschitzWith 1 S := by
    refine LipschitzWith.of_dist_le_mul (fun u₁ u₂ => ?_)
    simp only [NNReal.coe_one, one_mul, Real.dist_eq]
    rcases le_total u₁ u₂ with h_le | h_ge
    · obtain ⟨h1, h2⟩ := hS_lip u₁ u₂ h_le
      rw [abs_sub_comm, abs_of_nonneg h1, abs_of_nonpos (sub_nonpos.mpr h_le)]
      linarith
    · obtain ⟨h1, h2⟩ := hS_lip u₂ u₁ h_ge
      rw [abs_of_nonneg h1, abs_of_nonneg (sub_nonneg.mpr h_ge)]
      exact h2
  have h_derivS_loc : MeasureTheory.LocallyIntegrable (deriv S) MeasureTheory.volume := by
    have h_mem : MeasureTheory.MemLp (deriv S) ⊤ MeasureTheory.volume :=
      MeasureTheory.memLp_top_of_bound (measurable_deriv S).aestronglyMeasurable 1
        (Filter.Eventually.of_forall (fun x => by
          simpa using norm_deriv_le_of_lipschitz (𝕜 := ℝ) hS_lip1 (x₀ := x)))
    exact h_mem.locallyIntegrable le_top
  have h_S_leb_ae : ∀ᵐ u₀ : ℝ,
      Filter.Tendsto (fun ρ : ℝ =>
        ρ⁻¹ * ∫ u in (u₀ - ρ)..(u₀ + ρ), |deriv S u - deriv S u₀|)
      (nhdsWithin 0 (Set.Ioi 0)) (nhds 0) := by
    filter_upwards [IsUnifLocDoublingMeasure.ae_tendsto_average_norm_sub
      (μ := MeasureTheory.volume) h_derivS_loc 1] with u₀ hu₀_leb
    have h_avg : Filter.Tendsto (fun ρ : ℝ =>
        ⨍ u in Metric.closedBall u₀ ρ, ‖deriv S u - deriv S u₀‖ ∂MeasureTheory.volume)
        (nhdsWithin 0 (Set.Ioi 0)) (nhds 0) := by
      refine hu₀_leb (fun _ => u₀) id Filter.tendsto_id ?_
      filter_upwards [self_mem_nhdsWithin] with ρ (hρ : 0 < ρ)
      simp only [one_mul, id_eq]
      exact Metric.mem_closedBall_self hρ.le
    have h_mul := h_avg.const_mul (2 : ℝ)
    rw [mul_zero] at h_mul
    refine h_mul.congr' ?_
    filter_upwards [self_mem_nhdsWithin] with ρ (hρ : 0 < ρ)
    rw [MeasureTheory.setAverage_eq, smul_eq_mul, Real.closedBall_eq_Icc,
      MeasureTheory.Measure.real, Real.volume_Icc,
      MeasureTheory.integral_Icc_eq_integral_Ioc,
      ← intervalIntegral.integral_of_le (by linarith : u₀ - ρ ≤ u₀ + ρ)]
    have h_diff : (u₀ + ρ) - (u₀ - ρ) = 2 * ρ := by ring
    rw [h_diff, ENNReal.toReal_ofReal (by positivity : (0 : ℝ) ≤ 2 * ρ)]
    have h_int_eq : (∫ u in (u₀ - ρ)..(u₀ + ρ), ‖deriv S u - deriv S u₀‖) =
        ∫ u in (u₀ - ρ)..(u₀ + ρ), |deriv S u - deriv S u₀| := by rfl
    rw [h_int_eq, ← mul_assoc]
    have h2ρ : (2 : ℝ) * (2 * ρ)⁻¹ = ρ⁻¹ := by
      field_simp [hρ.ne']
    rw [h2ρ]
  let ξ₀ : (Fin n → ℝ) × ℝ := (Function.update 0 j₀ 1, 0)
  have hξ₀_cone : InDispCone n c E_cone ξ₀ := by
    intro j k hjk
    have hckj : 0 < c k - c j := hE_pos j k hjk
    have hcj : c j₀ ≤ c j := hc_min j
    have hk_ne : k ≠ j₀ := by
      intro h_eq
      subst h_eq
      linarith
    have hξk : ξ₀.1 k = 0 := by simp [ξ₀, Function.update_of_ne hk_ne]
    have hξj : 0 ≤ ξ₀.1 j := by
      by_cases hj : j = j₀
      · subst hj; simp [ξ₀]
      · simp [ξ₀, Function.update_of_ne hj]
    simp only [ξ₀, mul_zero] at hξk ⊢
    rw [hξk]
    linarith
  have hξ₀_b1 : ∀ j : Fin n, |ξ₀.1 j| ≤ 1 := by
    intro j
    by_cases hj : j = j₀
    · subst hj; simp [ξ₀]
    · simp [ξ₀, Function.update_of_ne hj]
  have hξ₀_b2 : |ξ₀.2| ≤ 1 := by simp [ξ₀]
  have h_blow_swap : ∀ᵐ vi : ℝ × ℝ, vi.1 ∈ Set.Ioo (0 : ℝ) 1 →
      ∀ (R ε_err : ℝ), 1 ≤ R → 0 < ε_err →
        ∀ᶠ l in Filter.atTop, ∀ ξ : (Fin n → ℝ) × ℝ,
          InDispCone n c E_cone ξ → (∀ j, |ξ.1 j| ≤ R) → |ξ.2| ≤ R →
          |(f (planeEmbed n c (vi.2, vi.1) + h_seq l • ξ) - f (planeEmbed n c (vi.2, vi.1))) /
            h_seq l - ((∑ j : Fin n, a j (vi.2, vi.1) * ξ.1 j) + D (vi.2, vi.1) * ξ.2)| ≤
            ε_err :=
    (MeasureTheory.Measure.measurePreserving_swap
      (μ := MeasureTheory.volume) (ν := MeasureTheory.volume)).quasiMeasurePreserving.ae h_blow
  have h_blow_v : ∀ᵐ v : ℝ, v ∈ Set.Ioo (0 : ℝ) 1 → ∀ᵐ i : ℝ,
      Filter.Tendsto (fun l : ℕ =>
        let p₀ := planeEmbed n c (i, v)
        let p_t := (Function.update p₀.1 j₀ (p₀.1 j₀ + h_seq l), p₀.2)
        (f p_t - f p₀) / h_seq l) Filter.atTop (nhds (a j₀ (i, v))) := by
    filter_upwards [MeasureTheory.Measure.ae_ae_of_ae_prod h_blow_swap] with v hv_ae hv_mem
    filter_upwards [hv_ae] with i hi_blow
    rw [Metric.tendsto_atTop]
    intro ε_err hε_pos
    have h_ev := hi_blow hv_mem 1 (ε_err / 2) le_rfl (half_pos hε_pos)
    rw [Filter.eventually_atTop] at h_ev
    obtain ⟨L₀, hL₀⟩ := h_ev
    refine ⟨L₀, fun l hl => ?_⟩
    have h_spec := hL₀ l hl ξ₀ hξ₀_cone hξ₀_b1 hξ₀_b2
    have h_pt_eq : planeEmbed n c (i, v) + h_seq l • ξ₀ =
        (Function.update (planeEmbed n c (i, v)).1 j₀
          ((planeEmbed n c (i, v)).1 j₀ + h_seq l), (planeEmbed n c (i, v)).2) := by
      refine Prod.ext ?_ (by simp [ξ₀, planeEmbed])
      ext j
      by_cases hj : j = j₀
      · subst hj; simp [ξ₀]
      · simp [ξ₀, Function.update_of_ne hj]
    have h_lin_eq : (∑ j : Fin n, a j (i, v) * ξ₀.1 j) + D (i, v) * ξ₀.2 = a j₀ (i, v) := by
      have h_sum : ∑ j : Fin n, a j (i, v) * ξ₀.1 j = a j₀ (i, v) := by
        rw [Finset.sum_eq_single j₀]
        · simp [ξ₀]
        · intro j _ hj
          simp [ξ₀, Function.update_of_ne hj]
        · intro h_abs
          exact absurd (Finset.mem_univ j₀) h_abs
      simp [ξ₀, h_sum]
    rw [h_pt_eq, h_lin_eq] at h_spec
    rw [Real.dist_eq]
    linarith
  obtain ⟨u₀, hu₀, h_curve_u₀, h_S_der_u₀, h_S_leb_u₀⟩ :=
    h_ex_Ioo (h_curve_ae.and (h_S_der_ae.and h_S_leb_ae))
  obtain ⟨p, D_minus, D_plus, a_minus, a_plus, hb_der, hDm0, hDm1, hDp0, hDp1,
    ha_bds, hD_tr, ha_tr, h_jmp⟩ := h_curve_u₀ hu₀
  obtain ⟨s, hS_der, hs_pos, hs_le⟩ := h_S_der_u₀ hu₀
  rw [hS_der.deriv] at h_S_leb_u₀
  have h_blow_j₀ : ∀ᵐ h : ℝ, 0 < h → h < u₀ → ∀ᵐ i : ℝ,
      Filter.Tendsto (fun l : ℕ =>
        let p₀ := planeEmbed n c (i, u₀ - h)
        let p_t := (Function.update p₀.1 j₀ (p₀.1 j₀ + h_seq l), p₀.2)
        (f p_t - f p₀) / h_seq l) Filter.atTop (nhds (a j₀ (i, u₀ - h))) := by
    have h_sub := (MeasureTheory.Measure.measurePreserving_sub_left
      MeasureTheory.volume u₀).quasiMeasurePreserving.ae h_blow_v
    filter_upwards [h_sub] with h hh_ae hh_pos hh_lt
    exact hh_ae ⟨by linarith [hu₀.1], by linarith [hu₀.2]⟩
  exact obstacle_contact_tuple_extraction n j₀ j_top c d d_v E_cone hc_zero hc_min hd_nn hE_pos
    f hf a D h_seq h_tr hh_pos hh_lim γ m β τ b S g_x P_rates hγ hm hc_top_val hb_lip hb_dom
    hS_lip h_obs h_cont h_xref hP_closed h_rates_ae u₀ p s D_minus D_plus a_minus a_plus
    hu₀ hb_der hS_der hs_pos hs_le h_S_leb_u₀ ⟨hDm0, hDm1, hDp0, hDp1⟩ ha_bds hD_tr ha_tr
    h_jmp h_blow_j₀

theorem weighted_tagged_planar_projection : WeightedTaggedProjectionBound :=
by
  classical
  
  have h_lp2 : ∀ a b : ℝ,
      (WithLp.toLp 2 ![a, b] : EuclideanSpace ℝ (Fin 2)) 0 = a ∧
      (WithLp.toLp 2 ![a, b] : EuclideanSpace ℝ (Fin 2)) 1 = b :=
    fun a b => ⟨by simp, by simp⟩
  have h_sub_apply : ∀ (u v : EuclideanSpace ℝ (Fin 2)) (idx : Fin 2),
      (u - v) idx = u idx - v idx := fun _ _ _ => rfl
  have h_norm2 : ∀ v : EuclideanSpace ℝ (Fin 2), ‖v‖ ^ 2 = (v 0) ^ 2 + (v 1) ^ 2 := by
    intro v
    rw [PiLp.norm_sq_eq_of_L2]
    simp [Fin.sum_univ_two]
  have h_coord_le : ∀ (v : EuclideanSpace ℝ (Fin 2)) (idx : Fin 2), |v idx| ≤ ‖v‖ := by
    intro v idx
    simpa using PiLp.norm_apply_le v idx

  
  
  
  have h_chernoff_sample :
      ∀ {ι_P ι_B : Type}
        (N_P N_B N Q : ℕ) (_hN : 1 ≤ N) (_hQ : 1 ≤ Q)
        (μ : Fin N_P → ℝ) (_hμ_nn : ∀ i, 0 ≤ μ i) (_hμ_sum : ∑ i, μ i = 1)
        (ν : Fin N_B → ℝ) (_hν_nn : ∀ j, 0 ≤ ν j) (_hν_sum : ∑ j, ν j = 1)
        (G : Fin N_P → Fin N_B → Prop)
        (S_P : Finset ι_P) (E_P : ι_P → Fin N_P → Prop) (p_P : ι_P → ℝ)
        (_hp_P : ∀ a ∈ S_P, (∑ i : Fin N_P, if E_P a i then μ i else 0) ≤ p_P a)
        (_hp_P_nn : ∀ a ∈ S_P, 0 ≤ p_P a)
        (S_B : Finset ι_B) (E_B : ι_B → Fin N_B → Prop) (p_B : ι_B → ℝ)
        (_hp_B : ∀ b ∈ S_B, (∑ j : Fin N_B, if E_B b j then ν j else 0) ≤ p_B b)
        (_hp_B_nn : ∀ b ∈ S_B, 0 ≤ p_B b)
        (q T : ℝ) (_hq_pos : 0 < q) (_hT_nn : 0 ≤ T)
        (_hq_lb : q ≤ ∑ i : Fin N_P, ∑ j : Fin N_B, if G i j then μ i * ν j else 0)
        (_h_tail : ((S_P.card + S_B.card : ℕ) : ℝ) * Real.exp (-T) < q / 2),
        ∃ (ω_P : Fin N → Fin N_P) (ω_B : Fin Q → Fin N_B),
          (∀ a ∈ S_P,
            ((Finset.univ.filter (fun u : Fin N => E_P a (ω_P u))).card : ℝ) ≤
              Real.exp 2 * (N : ℝ) * p_P a + T) ∧
          (∀ b ∈ S_B,
            ((Finset.univ.filter (fun v : Fin Q => E_B b (ω_B v))).card : ℝ) ≤
              Real.exp 2 * (Q : ℝ) * p_B b + T) ∧
          (1 / 2 : ℝ) * q * (N : ℝ) * (Q : ℝ) ≤
            ((Finset.univ.filter (fun uv : Fin N × Fin Q => G (ω_P uv.1) (ω_B uv.2))).card : ℝ) := by
    intro ι_P ι_B N_P N_B N Q hN hQ μ hμ_nn hμ_sum ν hν_nn hν_sum G
      S_P E_P p_P hp_P hp_P_nn S_B E_B p_B hp_B hp_B_nn q T hq_pos hT_nn hq_lb h_tail
    have h_mgf_tail : ∀ {M_s K : ℕ} (w : Fin K → ℝ) (_hw_nn : ∀ i, 0 ≤ w i)
        (_hw_sum : ∑ i, w i = 1) (E : Fin K → Prop) (p₀ : ℝ) (_hp₀_nn : 0 ≤ p₀)
        (_hp₀ : (∑ i : Fin K, if E i then w i else 0) ≤ p₀),
        let cnt := fun ω : Fin M_s → Fin K =>
          (Finset.univ.filter (fun u : Fin M_s => E (ω u))).card
        (∑ ω : Fin M_s → Fin K,
          if Real.exp 2 * (M_s : ℝ) * p₀ + T < (cnt ω : ℝ)
          then (∏ u : Fin M_s, w (ω u)) else 0) ≤ Real.exp (-T) := by
      intro M_s K w hw_nn hw_sum E p₀ hp₀_nn hp₀ cnt
      have h_exp_cnt : ∀ ω : Fin M_s → Fin K,
          Real.exp (2 * (cnt ω : ℝ)) =
            ∏ u : Fin M_s, (if E (ω u) then Real.exp 2 else 1) := by
        intro ω
        rw [Finset.prod_ite, Finset.prod_const, Finset.prod_const_one, mul_one,
            mul_comm (2 : ℝ) (cnt ω : ℝ), Real.exp_nat_mul]
      have h_sum_mgf : (∑ ω : Fin M_s → Fin K,
          (∏ u : Fin M_s, w (ω u)) * Real.exp (2 * (cnt ω : ℝ))) ≤
          Real.exp (Real.exp 2 * (M_s : ℝ) * p₀) := by
        have h_eq : (∑ ω : Fin M_s → Fin K,
            (∏ u : Fin M_s, w (ω u)) * Real.exp (2 * (cnt ω : ℝ))) =
            (∑ i : Fin K, w i * (if E i then Real.exp 2 else 1)) ^ M_s := by
          simp_rw [h_exp_cnt, ← Finset.prod_mul_distrib]
          rw [← Fintype.prod_sum (fun (_ : Fin M_s) (i : Fin K) =>
            w i * (if E i then Real.exp 2 else 1))]
          rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
        rw [h_eq]
        have h_inner_nn : 0 ≤ ∑ i : Fin K, w i * (if E i then Real.exp 2 else 1) :=
          Finset.sum_nonneg (fun i _ => by
            split_ifs
            · exact mul_nonneg (hw_nn i) (Real.exp_pos 2).le
            · rw [mul_one]; exact hw_nn i)
        have h_inner_ub : (∑ i : Fin K, w i * (if E i then Real.exp 2 else 1)) ≤
            Real.exp (Real.exp 2 * p₀) := by
          have h_pt : ∀ i : Fin K, w i * (if E i then Real.exp 2 else 1) ≤
              w i + Real.exp 2 * (if E i then w i else 0) := by
            intro i
            have hwi := hw_nn i
            split_ifs <;> linarith only [hwi]
          calc (∑ i : Fin K, w i * (if E i then Real.exp 2 else 1))
              ≤ ∑ i : Fin K, (w i + Real.exp 2 * (if E i then w i else 0)) :=
                Finset.sum_le_sum (fun i _ => h_pt i)
            _ = (∑ i : Fin K, w i) + Real.exp 2 * (∑ i : Fin K, if E i then w i else 0) := by
                rw [Finset.sum_add_distrib, ← Finset.mul_sum]
            _ ≤ 1 + Real.exp 2 * p₀ := by
                rw [hw_sum]
                exact add_le_add le_rfl (mul_le_mul_of_nonneg_left hp₀ (Real.exp_pos 2).le)
            _ ≤ Real.exp (Real.exp 2 * p₀) := by
                have h_e := Real.add_one_le_exp (Real.exp 2 * p₀)
                linarith only [h_e]
        calc (∑ i : Fin K, w i * (if E i then Real.exp 2 else 1)) ^ M_s
            ≤ (Real.exp (Real.exp 2 * p₀)) ^ M_s := pow_le_pow_left₀ h_inner_nn h_inner_ub M_s
          _ = Real.exp ((M_s : ℝ) * (Real.exp 2 * p₀)) := (Real.exp_nat_mul _ M_s).symm
          _ = Real.exp (Real.exp 2 * (M_s : ℝ) * p₀) := by ring_nf
      let A := Real.exp 2 * (M_s : ℝ) * p₀
      have hA_nn : 0 ≤ A := mul_nonneg (mul_nonneg (Real.exp_pos 2).le (Nat.cast_nonneg _)) hp₀_nn
      have h_markov : (∑ ω : Fin M_s → Fin K,
          if A + T < (cnt ω : ℝ) then (∏ u : Fin M_s, w (ω u)) else 0) *
          Real.exp (A + T) ≤
          ∑ ω : Fin M_s → Fin K, (∏ u : Fin M_s, w (ω u)) * Real.exp (2 * (cnt ω : ℝ)) := by
        rw [Finset.sum_mul]
        refine Finset.sum_le_sum (fun ω _ => ?_)
        have hw_prod_nn : 0 ≤ ∏ u : Fin M_s, w (ω u) :=
          Finset.prod_nonneg (fun u _ => hw_nn (ω u))
        split_ifs with h_bad
        · refine mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr ?_) hw_prod_nn
          linarith only [hA_nn, hT_nn, h_bad]
        · rw [zero_mul]
          exact mul_nonneg hw_prod_nn (Real.exp_pos _).le
      have h_comb := le_trans h_markov h_sum_mgf
      rw [Real.exp_add] at h_comb
      have h_posA : 0 < Real.exp A := Real.exp_pos A
      have h_posT : 0 < Real.exp T := Real.exp_pos T
      rw [Real.exp_neg, inv_eq_one_div, le_div_iff₀ h_posT]
      have h_rearr : ((∑ ω : Fin M_s → Fin K,
          if A + T < (cnt ω : ℝ) then (∏ u : Fin M_s, w (ω u)) else 0) * Real.exp T) *
          Real.exp A ≤ 1 * Real.exp A := by
        linarith only [h_comb]
      exact le_of_mul_le_mul_right h_rearr h_posA

    have h_marginal : ∀ {M_s K : ℕ} (w : Fin K → ℝ) (_hw_sum : ∑ i, w i = 1)
        (u₀ : Fin M_s) (φ : Fin K → ℝ),
        ∑ ω : Fin M_s → Fin K, (∏ u : Fin M_s, w (ω u)) * φ (ω u₀) =
          ∑ i : Fin K, w i * φ i := by
      intro M_s K w hw_sum u₀ φ
      let F : Fin M_s → Fin K → ℝ := fun u i => if u = u₀ then w i * φ i else w i
      have h_prod_sum := Fintype.prod_sum F
      have h_lhs : (∏ u : Fin M_s, ∑ i : Fin K, F u i) = ∑ i : Fin K, w i * φ i := by
        rw [← Finset.mul_prod_erase Finset.univ (fun u => ∑ i : Fin K, F u i) (Finset.mem_univ u₀)]
        have h_u0 : (∑ i : Fin K, F u₀ i) = ∑ i : Fin K, w i * φ i := by simp [F]
        have h_er : (∏ u ∈ Finset.univ.erase u₀, ∑ i : Fin K, F u i) = 1 := by
          refine Finset.prod_eq_one (fun u hu => ?_)
          have hne : u ≠ u₀ := (Finset.mem_erase.mp hu).1
          simp [F, hne, hw_sum]
        rw [h_u0, h_er, mul_one]
      have h_rhs : (∑ ω : Fin M_s → Fin K, ∏ u : Fin M_s, F u (ω u)) =
          ∑ ω : Fin M_s → Fin K, (∏ u : Fin M_s, w (ω u)) * φ (ω u₀) := by
        refine Finset.sum_congr rfl (fun ω _ => ?_)
        rw [← Finset.mul_prod_erase Finset.univ (fun u => F u (ω u)) (Finset.mem_univ u₀),
            ← Finset.mul_prod_erase Finset.univ (fun u => w (ω u)) (Finset.mem_univ u₀)]
        have h_er : (∏ u ∈ Finset.univ.erase u₀, F u (ω u)) =
            ∏ u ∈ Finset.univ.erase u₀, w (ω u) := by
          refine Finset.prod_congr rfl (fun u hu => ?_)
          have hne : u ≠ u₀ := (Finset.mem_erase.mp hu).1
          simp [F, hne]
        dsimp [F]
        rw [if_pos rfl, h_er]
        ring
      linarith only [h_prod_sum, h_lhs, h_rhs]

    let W_P : (Fin N → Fin N_P) → ℝ := fun ω_P => ∏ u : Fin N, μ (ω_P u)
    let W_B : (Fin Q → Fin N_B) → ℝ := fun ω_B => ∏ v : Fin Q, ν (ω_B v)
    have hWP_nn : ∀ ω_P, 0 ≤ W_P ω_P :=
      fun ω_P => Finset.prod_nonneg (fun u _ => hμ_nn (ω_P u))
    have hWB_nn : ∀ ω_B, 0 ≤ W_B ω_B :=
      fun ω_B => Finset.prod_nonneg (fun v _ => hν_nn (ω_B v))
    have hWP_sum : ∑ ω_P : Fin N → Fin N_P, W_P ω_P = 1 := by
      dsimp [W_P]
      rw [← Fintype.prod_sum (fun (_ : Fin N) (i : Fin N_P) => μ i)]
      simp [hμ_sum]
    have hWB_sum : ∑ ω_B : Fin Q → Fin N_B, W_B ω_B = 1 := by
      dsimp [W_B]
      rw [← Fintype.prod_sum (fun (_ : Fin Q) (j : Fin N_B) => ν j)]
      simp [hν_sum]
    let cnt_P : ι_P → (Fin N → Fin N_P) → ℕ := fun a ω_P =>
      (Finset.univ.filter (fun u : Fin N => E_P a (ω_P u))).card
    let cnt_B : ι_B → (Fin Q → Fin N_B) → ℕ := fun b ω_B =>
      (Finset.univ.filter (fun v : Fin Q => E_B b (ω_B v))).card
    let Good : ((Fin N → Fin N_P) × (Fin Q → Fin N_B)) → Prop := fun ω =>
      (∀ a ∈ S_P, (cnt_P a ω.1 : ℝ) ≤ Real.exp 2 * (N : ℝ) * p_P a + T) ∧
      (∀ b ∈ S_B, (cnt_B b ω.2 : ℝ) ≤ Real.exp 2 * (Q : ℝ) * p_B b + T)
    let W_prod : ((Fin N → Fin N_P) × (Fin Q → Fin N_B)) → ℝ :=
      fun ω => W_P ω.1 * W_B ω.2
    have hW_nn : ∀ ω, 0 ≤ W_prod ω := fun ω => mul_nonneg (hWP_nn ω.1) (hWB_nn ω.2)
    have hW_sum : ∑ ω : (Fin N → Fin N_P) × (Fin Q → Fin N_B), W_prod ω = 1 := by
      rw [Fintype.sum_prod_type]
      simp_rw [W_prod, ← Finset.mul_sum, hWB_sum, mul_one, hWP_sum]

    have h_bad_mass : (∑ ω : (Fin N → Fin N_P) × (Fin Q → Fin N_B),
        if ¬ Good ω then W_prod ω else 0) < q / 2 := by
      have h_pt : ∀ ω : (Fin N → Fin N_P) × (Fin Q → Fin N_B),
          (if ¬ Good ω then W_prod ω else 0) ≤
            (∑ a ∈ S_P, if Real.exp 2 * (N : ℝ) * p_P a + T < (cnt_P a ω.1 : ℝ)
              then W_prod ω else 0) +
            (∑ b ∈ S_B, if Real.exp 2 * (Q : ℝ) * p_B b + T < (cnt_B b ω.2 : ℝ)
              then W_prod ω else 0) := by
        intro ω
        have h_s1_nn : 0 ≤ ∑ a ∈ S_P,
            if Real.exp 2 * (N : ℝ) * p_P a + T < (cnt_P a ω.1 : ℝ) then W_prod ω else 0 :=
          Finset.sum_nonneg (fun a _ => by split_ifs; exact hW_nn ω; exact le_rfl)
        have h_s2_nn : 0 ≤ ∑ b ∈ S_B,
            if Real.exp 2 * (Q : ℝ) * p_B b + T < (cnt_B b ω.2 : ℝ) then W_prod ω else 0 :=
          Finset.sum_nonneg (fun b _ => by split_ifs; exact hW_nn ω; exact le_rfl)
        by_cases hG_ω : Good ω
        · rw [if_neg (not_not.mpr hG_ω)]
          linarith only [h_s1_nn, h_s2_nn]
        · rw [if_pos hG_ω]
          dsimp [Good] at hG_ω
          push_neg at hG_ω
          by_cases h1 : ∃ a ∈ S_P, Real.exp 2 * (N : ℝ) * p_P a + T < (cnt_P a ω.1 : ℝ)
          · obtain ⟨a₀, ha₀_mem, ha₀_lt⟩ := h1
            have h_le1 : W_prod ω ≤ ∑ a ∈ S_P,
                if Real.exp 2 * (N : ℝ) * p_P a + T < (cnt_P a ω.1 : ℝ) then W_prod ω else 0 := by
              calc W_prod ω
                  = (if Real.exp 2 * (N : ℝ) * p_P a₀ + T < (cnt_P a₀ ω.1 : ℝ)
                      then W_prod ω else 0) := (if_pos ha₀_lt).symm
                _ ≤ ∑ a ∈ S_P,
                      if Real.exp 2 * (N : ℝ) * p_P a + T < (cnt_P a ω.1 : ℝ)
                      then W_prod ω else 0 :=
                    Finset.single_le_sum
                      (f := fun a => if Real.exp 2 * (N : ℝ) * p_P a + T < (cnt_P a ω.1 : ℝ)
                        then W_prod ω else 0)
                      (fun a _ => by split_ifs; exact hW_nn ω; exact le_rfl) ha₀_mem
            linarith only [h_le1, h_s2_nn]
          · push_neg at h1
            obtain ⟨b₀, hb₀_mem, hb₀_lt⟩ := hG_ω h1
            have h_le2 : W_prod ω ≤ ∑ b ∈ S_B,
                if Real.exp 2 * (Q : ℝ) * p_B b + T < (cnt_B b ω.2 : ℝ) then W_prod ω else 0 := by
              calc W_prod ω
                  = (if Real.exp 2 * (Q : ℝ) * p_B b₀ + T < (cnt_B b₀ ω.2 : ℝ)
                      then W_prod ω else 0) := (if_pos hb₀_lt).symm
                _ ≤ ∑ b ∈ S_B,
                      if Real.exp 2 * (Q : ℝ) * p_B b + T < (cnt_B b ω.2 : ℝ)
                      then W_prod ω else 0 :=
                    Finset.single_le_sum
                      (f := fun b => if Real.exp 2 * (Q : ℝ) * p_B b + T < (cnt_B b ω.2 : ℝ)
                        then W_prod ω else 0)
                      (fun b _ => by split_ifs; exact hW_nn ω; exact le_rfl) hb₀_mem
            linarith only [h_le2, h_s1_nn]
      have h_a_ub : ∀ a ∈ S_P,
          (∑ ω : (Fin N → Fin N_P) × (Fin Q → Fin N_B),
            if Real.exp 2 * (N : ℝ) * p_P a + T < (cnt_P a ω.1 : ℝ) then W_prod ω else 0) ≤
            Real.exp (-T) := by
        intro a ha
        rw [Fintype.sum_prod_type]
        have h_fact : ∀ ω_P : Fin N → Fin N_P,
            (∑ ω_B : Fin Q → Fin N_B,
              if Real.exp 2 * (N : ℝ) * p_P a + T < (cnt_P a ω_P : ℝ)
              then W_P ω_P * W_B ω_B else 0) =
            (if Real.exp 2 * (N : ℝ) * p_P a + T < (cnt_P a ω_P : ℝ) then W_P ω_P else 0) := by
          intro ω_P
          split_ifs
          · rw [← Finset.mul_sum, hWB_sum, mul_one]
          · simp
        simp_rw [W_prod, h_fact]
        exact h_mgf_tail μ hμ_nn hμ_sum (E_P a) (p_P a) (hp_P_nn a ha) (hp_P a ha)
      have h_b_ub : ∀ b ∈ S_B,
          (∑ ω : (Fin N → Fin N_P) × (Fin Q → Fin N_B),
            if Real.exp 2 * (Q : ℝ) * p_B b + T < (cnt_B b ω.2 : ℝ) then W_prod ω else 0) ≤
            Real.exp (-T) := by
        intro b hb
        rw [Fintype.sum_prod_type, Finset.sum_comm]
        have h_fact : ∀ ω_B : Fin Q → Fin N_B,
            (∑ ω_P : Fin N → Fin N_P,
              if Real.exp 2 * (Q : ℝ) * p_B b + T < (cnt_B b ω_B : ℝ)
              then W_P ω_P * W_B ω_B else 0) =
            (if Real.exp 2 * (Q : ℝ) * p_B b + T < (cnt_B b ω_B : ℝ) then W_B ω_B else 0) := by
          intro ω_B
          split_ifs
          · rw [← Finset.sum_mul, hWP_sum, one_mul]
          · simp
        simp_rw [W_prod, h_fact]
        exact h_mgf_tail ν hν_nn hν_sum (E_B b) (p_B b) (hp_B_nn b hb) (hp_B b hb)
      calc (∑ ω : (Fin N → Fin N_P) × (Fin Q → Fin N_B), if ¬ Good ω then W_prod ω else 0)
          ≤ ∑ ω : (Fin N → Fin N_P) × (Fin Q → Fin N_B),
              ((∑ a ∈ S_P, if Real.exp 2 * (N : ℝ) * p_P a + T < (cnt_P a ω.1 : ℝ)
                then W_prod ω else 0) +
               (∑ b ∈ S_B, if Real.exp 2 * (Q : ℝ) * p_B b + T < (cnt_B b ω.2 : ℝ)
                then W_prod ω else 0)) := Finset.sum_le_sum (fun ω _ => h_pt ω)
        _ = (∑ a ∈ S_P, ∑ ω : (Fin N → Fin N_P) × (Fin Q → Fin N_B),
              if Real.exp 2 * (N : ℝ) * p_P a + T < (cnt_P a ω.1 : ℝ) then W_prod ω else 0) +
            (∑ b ∈ S_B, ∑ ω : (Fin N → Fin N_P) × (Fin Q → Fin N_B),
              if Real.exp 2 * (Q : ℝ) * p_B b + T < (cnt_B b ω.2 : ℝ) then W_prod ω else 0) := by
            rw [Finset.sum_add_distrib, Finset.sum_comm, @Finset.sum_comm _ _ _ _ S_B]
        _ ≤ (∑ _a ∈ S_P, Real.exp (-T)) + (∑ _b ∈ S_B, Real.exp (-T)) :=
            add_le_add (Finset.sum_le_sum h_a_ub) (Finset.sum_le_sum h_b_ub)
        _ = ((S_P.card + S_B.card : ℕ) : ℝ) * Real.exp (-T) := by
            rw [Finset.sum_const, Finset.sum_const, nsmul_eq_mul, nsmul_eq_mul, Nat.cast_add]
            ring
        _ < q / 2 := h_tail

    let q_act : ℝ := ∑ i : Fin N_P, ∑ j : Fin N_B, if G i j then μ i * ν j else 0
    let E_cnt : ((Fin N → Fin N_P) × (Fin Q → Fin N_B)) → ℕ := fun ω =>
      (Finset.univ.filter (fun uv : Fin N × Fin Q => G (ω.1 uv.1) (ω.2 uv.2))).card
    have h_edge_exp : (∑ ω : (Fin N → Fin N_P) × (Fin Q → Fin N_B),
        W_prod ω * (E_cnt ω : ℝ)) = q_act * ((N : ℝ) * (Q : ℝ)) := by
      have h_card_real : ∀ ω : (Fin N → Fin N_P) × (Fin Q → Fin N_B),
          (E_cnt ω : ℝ) = ∑ u : Fin N, ∑ v : Fin Q, (if G (ω.1 u) (ω.2 v) then (1 : ℝ) else 0) := by
        intro ω
        dsimp [E_cnt]
        rw [Finset.card_filter, Nat.cast_sum, Fintype.sum_prod_type]
        refine Finset.sum_congr rfl (fun u _ => ?_)
        refine Finset.sum_congr rfl (fun v _ => ?_)
        split_ifs <;> simp
      simp_rw [h_card_real, Finset.mul_sum]
      rw [Finset.sum_comm]
      have h_uv : ∀ u : Fin N,
          (∑ ω : (Fin N → Fin N_P) × (Fin Q → Fin N_B),
            ∑ v : Fin Q, W_prod ω * (if G (ω.1 u) (ω.2 v) then (1 : ℝ) else 0)) =
          (Q : ℝ) * q_act := by
        intro u
        rw [Finset.sum_comm]
        have h_single : ∀ v : Fin Q,
            (∑ ω : (Fin N → Fin N_P) × (Fin Q → Fin N_B),
              W_prod ω * (if G (ω.1 u) (ω.2 v) then (1 : ℝ) else 0)) = q_act := by
          intro v
          rw [Fintype.sum_prod_type]
          have h_step1 : ∀ ω_P : Fin N → Fin N_P,
              (∑ ω_B : Fin Q → Fin N_B,
                (W_P ω_P * W_B ω_B) * (if G (ω_P u) (ω_B v) then (1 : ℝ) else 0)) =
              W_P ω_P * (∑ j : Fin N_B, ν j * (if G (ω_P u) j then (1 : ℝ) else 0)) := by
            intro ω_P
            simp_rw [mul_assoc, ← Finset.mul_sum]
            rw [h_marginal ν hν_sum v (fun j => if G (ω_P u) j then (1 : ℝ) else 0)]
          simp_rw [W_prod, h_step1]
          rw [h_marginal μ hμ_sum u
            (fun i => ∑ j : Fin N_B, ν j * (if G i j then (1 : ℝ) else 0))]
          dsimp [q_act]
          refine Finset.sum_congr rfl (fun i _ => ?_)
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl (fun j _ => ?_)
          split_ifs <;> ring
        simp_rw [h_single, Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
      simp_rw [h_uv, Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
      ring

    have hN_pos : (0 : ℝ) < (N : ℝ) := Nat.cast_pos.mpr (by omega)
    have hQ_pos : (0 : ℝ) < (Q : ℝ) := Nat.cast_pos.mpr (by omega)
    have hNQ_pos : 0 < (N : ℝ) * (Q : ℝ) := mul_pos hN_pos hQ_pos
    have h_exists : ∃ ω : (Fin N → Fin N_P) × (Fin Q → Fin N_B),
        Good ω ∧ (1 / 2 : ℝ) * q * (N : ℝ) * (Q : ℝ) ≤ (E_cnt ω : ℝ) := by
      by_contra h_none
      push_neg at h_none
      have h_max_E : ∀ ω, (E_cnt ω : ℝ) ≤ (N : ℝ) * (Q : ℝ) := by
        intro ω
        have h1 : E_cnt ω ≤ (Finset.univ : Finset (Fin N × Fin Q)).card := Finset.card_filter_le _ _
        rw [Finset.card_univ, Fintype.card_prod, Fintype.card_fin, Fintype.card_fin] at h1
        exact_mod_cast h1
      have h_q_le : (1 / 2 : ℝ) * q * ((N : ℝ) * (Q : ℝ)) ≤
          (1 / 2 : ℝ) * q_act * ((N : ℝ) * (Q : ℝ)) := by
        refine mul_le_mul_of_nonneg_right ?_ hNQ_pos.le
        linarith only [hq_lb]
      have hq_act_nn : 0 ≤ q_act := le_trans hq_pos.le hq_lb
      have h_split_pt : ∀ ω : (Fin N → Fin N_P) × (Fin Q → Fin N_B),
          W_prod ω * (E_cnt ω : ℝ) ≤
            ((1 / 2 : ℝ) * q_act * ((N : ℝ) * (Q : ℝ))) * W_prod ω +
            ((N : ℝ) * (Q : ℝ)) * (if ¬ Good ω then W_prod ω else 0) := by
        intro ω
        by_cases hG_ω : Good ω
        · rw [if_neg (not_not.mpr hG_ω), mul_zero, add_zero]
          have hlt : (E_cnt ω : ℝ) ≤ (1 / 2 : ℝ) * q_act * ((N : ℝ) * (Q : ℝ)) := by
            have h1 := (h_none ω hG_ω).le
            linarith only [h1, h_q_le]
          have h_m := mul_le_mul_of_nonneg_left hlt (hW_nn ω)
          linarith only [h_m]
        · rw [if_pos hG_ω]
          have h_nn1 : 0 ≤ ((1 / 2 : ℝ) * q_act * ((N : ℝ) * (Q : ℝ))) * W_prod ω :=
            mul_nonneg (mul_nonneg (mul_nonneg (by norm_num) hq_act_nn) hNQ_pos.le) (hW_nn ω)
          have h_le2 : W_prod ω * (E_cnt ω : ℝ) ≤ ((N : ℝ) * (Q : ℝ)) * W_prod ω := by
            rw [mul_comm ((N : ℝ) * (Q : ℝ)) (W_prod ω)]
            exact mul_le_mul_of_nonneg_left (h_max_E ω) (hW_nn ω)
          linarith only [h_nn1, h_le2]
      have h_sum_ub : (∑ ω : (Fin N → Fin N_P) × (Fin Q → Fin N_B), W_prod ω * (E_cnt ω : ℝ)) <
          q_act * ((N : ℝ) * (Q : ℝ)) := by
        calc (∑ ω : (Fin N → Fin N_P) × (Fin Q → Fin N_B), W_prod ω * (E_cnt ω : ℝ))
            ≤ ∑ ω : (Fin N → Fin N_P) × (Fin Q → Fin N_B),
                (((1 / 2 : ℝ) * q_act * ((N : ℝ) * (Q : ℝ))) * W_prod ω +
                 ((N : ℝ) * (Q : ℝ)) * (if ¬ Good ω then W_prod ω else 0)) :=
              Finset.sum_le_sum (fun ω _ => h_split_pt ω)
          _ = ((1 / 2 : ℝ) * q_act * ((N : ℝ) * (Q : ℝ))) * (∑ ω, W_prod ω) +
              ((N : ℝ) * (Q : ℝ)) * (∑ ω, if ¬ Good ω then W_prod ω else 0) := by
              rw [Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.mul_sum]
          _ < ((1 / 2 : ℝ) * q_act * ((N : ℝ) * (Q : ℝ))) * 1 +
              ((N : ℝ) * (Q : ℝ)) * (q / 2) := by
              rw [hW_sum]
              have h_lt := mul_lt_mul_of_pos_left h_bad_mass hNQ_pos
              linarith only [h_lt]
          _ ≤ q_act * ((N : ℝ) * (Q : ℝ)) := by
              have h_m : ((N : ℝ) * (Q : ℝ)) * (q / 2) ≤
                  ((N : ℝ) * (Q : ℝ)) * (q_act / 2) :=
                mul_le_mul_of_nonneg_left (by linarith only [hq_lb]) hNQ_pos.le
              linarith only [h_m]
      linarith only [h_edge_exp, h_sum_ub]
    obtain ⟨⟨ω_P, ω_B⟩, ⟨hgP, hgB⟩, hE⟩ := h_exists
    exact ⟨ω_P, ω_B, hgP, hgB, hE⟩

  
  
  
  have h_net_transfer :
      ∀ (N Q : ℕ) (ρ d s A_P A_B : ℝ)
        (_hρ₀ : 0 < ρ)
        (_hd₀ : 0 < d) (_hd₂ : d ≤ 2) (_hs₀ : 0 < s) (_hs₁ : s ≤ 1)
        (_hA_P : 0 ≤ A_P) (_hA_B : 0 ≤ A_B)
        (y : Fin N → EuclideanSpace ℝ (Fin 2))
        (_hy_dom : ∀ u : Fin N, (0 ≤ y u 0 ∧ y u 0 ≤ 1) ∧ (0 ≤ y u 1 ∧ y u 1 ≤ 1))
        (a_sl : Fin Q → ℝ)
        (_ha_dom : ∀ v : Fin Q, -(1 / 2 : ℝ) ≤ a_sl v ∧ a_sl v ≤ 1 / 2)
        (_h_net_P :
          let K_g : ℕ := ⌈1 / ρ⌉₊
          ∀ g₀ ∈ Finset.Icc (0 : ℤ) (K_g : ℤ),
          ∀ g₁ ∈ Finset.Icc (0 : ℤ) (K_g : ℤ),
          ∀ m ∈ Finset.range (K_g + 1),
            ((Finset.univ.filter (fun u : Fin N =>
              ‖y u - WithLp.toLp 2 ![(g₀ : ℝ) * ρ, (g₁ : ℝ) * ρ]‖ <
                8 * (2 : ℝ) ^ m * ρ)).card : ℝ) ≤
              A_P * ((2 : ℝ) ^ m) ^ d)
        (_h_net_B :
          let K_g : ℕ := ⌈1 / ρ⌉₊
          ∀ g ∈ Finset.Icc (-(K_g : ℤ) - 1) (K_g : ℤ),
          ∀ m ∈ Finset.range (K_g + 1),
            ((Finset.univ.filter (fun v : Fin Q =>
              |a_sl v - (g : ℝ) * ρ| < 5 * (2 : ℝ) ^ m * ρ)).card : ℝ) ≤
              A_B * ((2 : ℝ) ^ m) ^ s),
        (∀ (z : EuclideanSpace ℝ (Fin 2)) (r : ℝ), ρ ≤ r → r ≤ 1 →
          ((Finset.univ.filter (fun u : Fin N => ‖y u - z‖ < 3 * r)).card : ℝ) ≤
            4 * A_P * (r / ρ) ^ d) ∧
        (∀ (a₀ r : ℝ), ρ ≤ r → r ≤ 1 →
          ((Finset.univ.filter (fun v : Fin Q => |a_sl v - a₀| < 2 * r)).card : ℝ) ≤
            2 * A_B * (r / ρ) ^ s) := by
    intro N Q ρ d s A_P A_B hρ hd₀ hd₂ hs₀ hs₁ hA_P hA_B y hy_dom a_sl ha_dom h_net_P h_net_B
    let K_g : ℕ := ⌈1 / ρ⌉₊
    have hKg_ge1 : 1 / ρ ≤ (K_g : ℝ) := Nat.le_ceil _
    have h_scale_snap : ∀ r : ℝ, ρ ≤ r → r ≤ 1 →
        ∃ m₀ ∈ Finset.range (K_g + 1),
          r ≤ (2 : ℝ) ^ m₀ * ρ ∧ (2 : ℝ) ^ m₀ * ρ ≤ 2 * r := by
      intro r hr₀ hr₁
      have hKg_ge : 1 ≤ (K_g : ℝ) * ρ := (div_le_iff₀ hρ).mp hKg_ge1
      have h2Kg_ge : (K_g : ℝ) ≤ (2 : ℝ) ^ K_g := by
        exact_mod_cast (Nat.le_of_lt Nat.lt_two_pow_self)
      have hr_le_top : r ≤ (2 : ℝ) ^ K_g * ρ := by
        calc r ≤ 1 := hr₁
          _ ≤ (K_g : ℝ) * ρ := hKg_ge
          _ ≤ (2 : ℝ) ^ K_g * ρ := mul_le_mul_of_nonneg_right h2Kg_ge hρ.le
      let S_sc := (Finset.range (K_g + 1)).filter (fun m => r ≤ (2 : ℝ) ^ m * ρ)
      have hS_ne : S_sc.Nonempty :=
        ⟨K_g, Finset.mem_filter.mpr ⟨Finset.mem_range.mpr (by omega), hr_le_top⟩⟩
      obtain ⟨m₀, hm₀_eq⟩ : ∃ m₀, S_sc.min' hS_ne = m₀ := ⟨_, rfl⟩
      have hm₀_mem : m₀ ∈ S_sc := hm₀_eq ▸ Finset.min'_mem S_sc hS_ne
      obtain ⟨hm₀_range, hm₀_ge⟩ := Finset.mem_filter.mp hm₀_mem
      refine ⟨m₀, hm₀_range, hm₀_ge, ?_⟩
      rcases m₀ with _ | m'
      · simp only [pow_zero, one_mul]
        linarith only [hρ, hr₀]
      · by_contra h_gt
        have hm'_lt : m' < K_g + 1 :=
          lt_trans (Nat.lt_succ_self m') (Finset.mem_range.mp hm₀_range)
        have hm'_ge : r ≤ (2 : ℝ) ^ m' * ρ := by
          have h_gt' : 2 * r ≤ (2 : ℝ) ^ (m' + 1) * ρ := le_of_not_ge h_gt
          rw [pow_succ'] at h_gt'
          linarith only [h_gt']
        have hm'_mem : m' ∈ S_sc :=
          Finset.mem_filter.mpr ⟨Finset.mem_range.mpr hm'_lt, hm'_ge⟩
        have h_min_le : m' + 1 ≤ m' := hm₀_eq ▸ Finset.min'_le S_sc m' hm'_mem
        omega
    refine ⟨?_, ?_⟩
    · intro z r hr₀ hr₁
      have hr_pos : 0 < r := lt_of_lt_of_le hρ hr₀
      obtain ⟨m₀, hm₀_range, hm₀_ge, hm₀_le⟩ := h_scale_snap r hr₀ hr₁
      have h2m_ub : ((2 : ℝ) ^ m₀) ^ d ≤ 4 * (r / ρ) ^ d := by
        have h_div : (2 : ℝ) ^ m₀ ≤ 2 * (r / ρ) := by
          rw [show 2 * (r / ρ) = (2 * r) / ρ by ring, le_div_iff₀ hρ]
          exact hm₀_le
        have h2d : (2 : ℝ) ^ d ≤ 4 := by
          calc (2 : ℝ) ^ d ≤ (2 : ℝ) ^ (2 : ℝ) := Real.rpow_le_rpow_of_exponent_le (by norm_num) hd₂
            _ = (2 : ℝ) ^ (2 : ℕ) := Real.rpow_natCast 2 2
            _ = 4 := by norm_num
        calc ((2 : ℝ) ^ m₀) ^ d
            ≤ (2 * (r / ρ)) ^ d := Real.rpow_le_rpow (by positivity) h_div hd₀.le
          _ = 2 ^ d * (r / ρ) ^ d := Real.mul_rpow (by norm_num) (by positivity)
          _ ≤ 4 * (r / ρ) ^ d := mul_le_mul_of_nonneg_right h2d (by positivity)
      let H_P := Finset.univ.filter (fun u : Fin N => ‖y u - z‖ < 3 * r)
      by_cases h_emp : H_P = ∅
      · change (H_P.card : ℝ) ≤ 4 * A_P * (r / ρ) ^ d
        rw [h_emp, Finset.card_empty, Nat.cast_zero]
        positivity
      · obtain ⟨u₀, hu₀⟩ := Finset.nonempty_iff_ne_empty.mpr h_emp
        have hu₀_dist : ‖y u₀ - z‖ < 3 * r := (Finset.mem_filter.mp hu₀).2
        have hy_u0 := hy_dom u₀
        let g₀ : ℤ := ⌊y u₀ 0 / ρ⌋
        let g₁ : ℤ := ⌊y u₀ 1 / ρ⌋
        have hg₀_mem : g₀ ∈ Finset.Icc (0 : ℤ) (K_g : ℤ) := by
          refine Finset.mem_Icc.mpr ⟨Int.floor_nonneg.mpr (div_nonneg hy_u0.1.1 hρ.le), ?_⟩
          have h_le : (g₀ : ℝ) ≤ (K_g : ℝ) := by
            calc (g₀ : ℝ) ≤ y u₀ 0 / ρ := Int.floor_le _
              _ ≤ 1 / ρ := div_le_div_of_nonneg_right hy_u0.1.2 hρ.le
              _ ≤ (K_g : ℝ) := hKg_ge1
          exact_mod_cast h_le
        have hg₁_mem : g₁ ∈ Finset.Icc (0 : ℤ) (K_g : ℤ) := by
          refine Finset.mem_Icc.mpr ⟨Int.floor_nonneg.mpr (div_nonneg hy_u0.2.1 hρ.le), ?_⟩
          have h_le : (g₁ : ℝ) ≤ (K_g : ℝ) := by
            calc (g₁ : ℝ) ≤ y u₀ 1 / ρ := Int.floor_le _
              _ ≤ 1 / ρ := div_le_div_of_nonneg_right hy_u0.2.2 hρ.le
              _ ≤ (K_g : ℝ) := hKg_ge1
          exact_mod_cast h_le
        let z_grid : EuclideanSpace ℝ (Fin 2) := WithLp.toLp 2 ![(g₀ : ℝ) * ρ, (g₁ : ℝ) * ρ]
        have hu₀_grid : ‖y u₀ - z_grid‖ < 2 * ρ := by
          have hd0_nn : 0 ≤ y u₀ 0 - (g₀ : ℝ) * ρ := by
            have h1 := (le_div_iff₀ hρ).mp (Int.floor_le (y u₀ 0 / ρ))
            linarith only [h1]
          have hd0_lt : y u₀ 0 - (g₀ : ℝ) * ρ < ρ := by
            have h1 := (div_lt_iff₀ hρ).mp (Int.lt_floor_add_one (y u₀ 0 / ρ))
            linarith only [h1]
          have hd1_nn : 0 ≤ y u₀ 1 - (g₁ : ℝ) * ρ := by
            have h1 := (le_div_iff₀ hρ).mp (Int.floor_le (y u₀ 1 / ρ))
            linarith only [h1]
          have hd1_lt : y u₀ 1 - (g₁ : ℝ) * ρ < ρ := by
            have h1 := (div_lt_iff₀ hρ).mp (Int.lt_floor_add_one (y u₀ 1 / ρ))
            linarith only [h1]
          have hsq0 : (y u₀ 0 - (g₀ : ℝ) * ρ) ^ 2 < ρ ^ 2 :=
            (sq_lt_sq₀ hd0_nn hρ.le).mpr hd0_lt
          have hsq1 : (y u₀ 1 - (g₁ : ℝ) * ρ) ^ 2 < ρ ^ 2 :=
            (sq_lt_sq₀ hd1_nn hρ.le).mpr hd1_lt
          have h_nsq : ‖y u₀ - z_grid‖ ^ 2 < (2 * ρ) ^ 2 := by
            rw [h_norm2 (y u₀ - z_grid), h_sub_apply, h_sub_apply,
                (h_lp2 ((g₀ : ℝ) * ρ) ((g₁ : ℝ) * ρ)).1,
                (h_lp2 ((g₀ : ℝ) * ρ) ((g₁ : ℝ) * ρ)).2]
            have hρ2_pos : 0 < ρ ^ 2 := sq_pos_of_pos hρ
            have h4 : (2 * ρ) ^ 2 = 4 * ρ ^ 2 := by ring
            linarith only [hsq0, hsq1, hρ2_pos, h4]
          exact (sq_lt_sq₀ (norm_nonneg _) (by positivity)).mp h_nsq
        have h_sub : H_P ⊆ Finset.univ.filter
            (fun u : Fin N => ‖y u - z_grid‖ < 8 * (2 : ℝ) ^ m₀ * ρ) := by
          intro u hu
          have hu_dist : ‖y u - z‖ < 3 * r := (Finset.mem_filter.mp hu).2
          refine Finset.mem_filter.mpr ⟨Finset.mem_univ u, ?_⟩
          have h_tri : ‖y u - z_grid‖ ≤ ‖y u - z‖ + ‖z - y u₀‖ + ‖y u₀ - z_grid‖ := by
            have ht1 : ‖y u - z_grid‖ = ‖(y u - z) + (z - y u₀) + (y u₀ - z_grid)‖ := by abel_nf
            have ht2 := norm_add_le ((y u - z) + (z - y u₀)) (y u₀ - z_grid)
            have ht3 := norm_add_le (y u - z) (z - y u₀)
            linarith only [ht1, ht2, ht3]
          rw [norm_sub_rev z (y u₀)] at h_tri
          have h8 : 8 * r ≤ 8 * ((2 : ℝ) ^ m₀ * ρ) := mul_le_mul_of_nonneg_left hm₀_ge (by norm_num)
          have h8_eq : 8 * ((2 : ℝ) ^ m₀ * ρ) = 8 * (2 : ℝ) ^ m₀ * ρ := by ring
          linarith only [h_tri, hu_dist, hu₀_dist, hu₀_grid, hr₀, h8, h8_eq]
        have h_card_le : (H_P.card : ℝ) ≤ A_P * ((2 : ℝ) ^ m₀) ^ d :=
          le_trans (by exact_mod_cast Finset.card_le_card h_sub)
            (h_net_P g₀ hg₀_mem g₁ hg₁_mem m₀ hm₀_range)
        change (H_P.card : ℝ) ≤ 4 * A_P * (r / ρ) ^ d
        calc (H_P.card : ℝ)
            ≤ A_P * ((2 : ℝ) ^ m₀) ^ d := h_card_le
          _ ≤ A_P * (4 * (r / ρ) ^ d) := mul_le_mul_of_nonneg_left h2m_ub hA_P
          _ = 4 * A_P * (r / ρ) ^ d := by ring
    · intro a₀ r hr₀ hr₁
      have hr_pos : 0 < r := lt_of_lt_of_le hρ hr₀
      obtain ⟨m₀, hm₀_range, hm₀_ge, hm₀_le⟩ := h_scale_snap r hr₀ hr₁
      have h2m_ub : ((2 : ℝ) ^ m₀) ^ s ≤ 2 * (r / ρ) ^ s := by
        have h_div : (2 : ℝ) ^ m₀ ≤ 2 * (r / ρ) := by
          rw [show 2 * (r / ρ) = (2 * r) / ρ by ring, le_div_iff₀ hρ]
          exact hm₀_le
        have h2s : (2 : ℝ) ^ s ≤ 2 := by
          calc (2 : ℝ) ^ s ≤ (2 : ℝ) ^ (1 : ℝ) := Real.rpow_le_rpow_of_exponent_le (by norm_num) hs₁
            _ = 2 := Real.rpow_one 2
        calc ((2 : ℝ) ^ m₀) ^ s
            ≤ (2 * (r / ρ)) ^ s := Real.rpow_le_rpow (by positivity) h_div hs₀.le
          _ = 2 ^ s * (r / ρ) ^ s := Real.mul_rpow (by norm_num) (by positivity)
          _ ≤ 2 * (r / ρ) ^ s := mul_le_mul_of_nonneg_right h2s (by positivity)
      let H_B := Finset.univ.filter (fun v : Fin Q => |a_sl v - a₀| < 2 * r)
      by_cases h_emp : H_B = ∅
      · change (H_B.card : ℝ) ≤ 2 * A_B * (r / ρ) ^ s
        rw [h_emp, Finset.card_empty, Nat.cast_zero]
        positivity
      · obtain ⟨v₀, hv₀⟩ := Finset.nonempty_iff_ne_empty.mpr h_emp
        have hv₀_dist : |a_sl v₀ - a₀| < 2 * r := (Finset.mem_filter.mp hv₀).2
        have ha_v0 := ha_dom v₀
        let g : ℤ := ⌊a_sl v₀ / ρ⌋
        have hg_mem : g ∈ Finset.Icc (-(K_g : ℤ) - 1) (K_g : ℤ) := by
          refine Finset.mem_Icc.mpr ⟨?_, ?_⟩
          · have h_lb : (((-(K_g : ℤ)) : ℤ) : ℝ) ≤ a_sl v₀ / ρ := by
              have h1 : (-1 : ℝ) / ρ ≤ a_sl v₀ / ρ :=
                div_le_div_of_nonneg_right (by linarith only [ha_v0.1]) hρ.le
              have h1' : -(1 / ρ) ≤ a_sl v₀ / ρ := by
                have h_nd : -(1 / ρ) = (-1 : ℝ) / ρ := by ring
                linarith only [h1, h_nd]
              push_cast
              linarith only [h1', hKg_ge1]
            have h_fl : -(K_g : ℤ) ≤ g := Int.le_floor.mpr h_lb
            omega
          · have h_ub : (g : ℝ) ≤ (K_g : ℝ) := by
              calc (g : ℝ) ≤ a_sl v₀ / ρ := Int.floor_le _
                _ ≤ 1 / ρ := div_le_div_of_nonneg_right (by linarith only [ha_v0.2]) hρ.le
                _ ≤ (K_g : ℝ) := hKg_ge1
            exact_mod_cast h_ub
        have hv₀_grid : |a_sl v₀ - (g : ℝ) * ρ| < ρ := by
          have hd_nn : 0 ≤ a_sl v₀ - (g : ℝ) * ρ := by
            have h1 := (le_div_iff₀ hρ).mp (Int.floor_le (a_sl v₀ / ρ))
            linarith only [h1]
          have hd_lt : a_sl v₀ - (g : ℝ) * ρ < ρ := by
            have h1 := (div_lt_iff₀ hρ).mp (Int.lt_floor_add_one (a_sl v₀ / ρ))
            linarith only [h1]
          rw [abs_of_nonneg hd_nn]
          exact hd_lt
        have h_sub : H_B ⊆ Finset.univ.filter
            (fun v : Fin Q => |a_sl v - (g : ℝ) * ρ| < 5 * (2 : ℝ) ^ m₀ * ρ) := by
          intro v hv
          have hv_dist : |a_sl v - a₀| < 2 * r := (Finset.mem_filter.mp hv).2
          refine Finset.mem_filter.mpr ⟨Finset.mem_univ v, ?_⟩
          have h_tri : |a_sl v - (g : ℝ) * ρ| ≤
              |a_sl v - a₀| + |a_sl v₀ - a₀| + |a_sl v₀ - (g : ℝ) * ρ| := by
            have ht1 : |a_sl v - (g : ℝ) * ρ| =
                |(a_sl v - a₀) - (a_sl v₀ - a₀) + (a_sl v₀ - (g : ℝ) * ρ)| := by ring_nf
            have ht2 := abs_add_le ((a_sl v - a₀) - (a_sl v₀ - a₀)) (a_sl v₀ - (g : ℝ) * ρ)
            have ht3 := abs_sub (a_sl v - a₀) (a_sl v₀ - a₀)
            linarith only [ht1, ht2, ht3]
          have h5 : 5 * r ≤ 5 * ((2 : ℝ) ^ m₀ * ρ) := mul_le_mul_of_nonneg_left hm₀_ge (by norm_num)
          have h5_eq : 5 * ((2 : ℝ) ^ m₀ * ρ) = 5 * (2 : ℝ) ^ m₀ * ρ := by ring
          linarith only [h_tri, hv_dist, hv₀_dist, hv₀_grid, hr₀, h5, h5_eq]
        have h_card_le : (H_B.card : ℝ) ≤ A_B * ((2 : ℝ) ^ m₀) ^ s :=
          le_trans (by exact_mod_cast Finset.card_le_card h_sub)
            (h_net_B g hg_mem m₀ hm₀_range)
        change (H_B.card : ℝ) ≤ 2 * A_B * (r / ρ) ^ s
        calc (H_B.card : ℝ)
            ≤ A_B * ((2 : ℝ) ^ m₀) ^ s := h_card_le
          _ ≤ A_B * (2 * (r / ρ) ^ s) := mul_le_mul_of_nonneg_left h2m_ub hA_B
          _ = 2 * A_B * (r / ρ) ^ s := by ring

  
  
  
  have h_inc_regularize :
      ∀ (N Q : ℕ) (_hN : 1 ≤ N) (_hQ : 1 ≤ Q)
        (ρ d s q M C_cov B_P B_B : ℝ)
        (_hρ₀ : 0 < ρ) (_hρ₆ : ρ < 1 / 6)
        (_hd₀ : 0 < d) (_hs₀ : 0 < s)
        (_hq₀ : 0 < q) (_hM₀ : 0 < M) (_hC_cov : 1 ≤ C_cov)
        (_hB_P : 1 ≤ B_P) (_hB_B : 1 ≤ B_B)
        (_hN_lb : ρ ^ (-d) ≤ (N : ℝ)) (_hQ_lb : ρ ^ (-s) ≤ (Q : ℝ))
        (y : Fin N → EuclideanSpace ℝ (Fin 2))
        (_hy_dom : ∀ u : Fin N,
          (0 ≤ y u 0 ∧ y u 0 ≤ 2 / 3) ∧ (0 ≤ y u 1 ∧ y u 1 ≤ 2 / 3))
        (a_sl : Fin Q → ℝ)
        (_ha_dom : ∀ v : Fin Q, -(1 / 2 : ℝ) ≤ a_sl v ∧ a_sl v ≤ 1 / 2)
        (G_samp : Fin N → Fin Q → Prop)
        (_h_edges : (1 / 2 : ℝ) * q * (N : ℝ) * (Q : ℝ) ≤
          ((Finset.univ.filter (fun uv : Fin N × Fin Q => G_samp uv.1 uv.2)).card : ℝ))
        (_h_occ_P : ∀ (z : EuclideanSpace ℝ (Fin 2)) (r : ℝ), ρ ≤ r → r ≤ 1 →
          ((Finset.univ.filter (fun u : Fin N => ‖y u - z‖ < 3 * r)).card : ℝ) ≤
            B_P * (r / ρ) ^ d)
        (_h_occ_B : ∀ (a₀ r : ℝ), ρ ≤ r → r ≤ 1 →
          ((Finset.univ.filter (fun v : Fin Q => |a_sl v - a₀| < 2 * r)).card : ℝ) ≤
            B_B * (r / ρ) ^ s)
        (S_cov : Fin Q → Finset ℝ)
        (_hS_card : ∀ v : Fin Q, ((S_cov v).card : ℝ) ≤ M)
        (_hS_cov : ∀ (u : Fin N) (v : Fin Q), G_samp u v →
          ∃ c₀ ∈ S_cov v, |(y u 1 - a_sl v * y u 0) - c₀| ≤ C_cov * ρ),
        ∃ (M₀ : ℝ) (P : Finset (Set (EuclideanSpace ℝ (Fin 2))))
          (T_fam : Set (EuclideanSpace ℝ (Fin 2)) → Finset (Set (EuclideanSpace ℝ (Fin 2)))),
          0 < M₀ ∧
          (q / (8 * B_B)) * (Q : ℝ) ≤ M₀ ∧
          (∀ p ∈ P, IsDyadicSquare ρ p) ∧
          IsRhoSet ρ d (4 * B_P ^ 2 * ((Nat.log 2 Q + 1 : ℕ) : ℝ) / q) P ∧
          (∀ p ∈ P, ∀ q_sq ∈ T_fam p, IsTubeParamSquare ρ q_sq ∧ (dyadicTube q_sq ∩ p).Nonempty) ∧
          (∀ p ∈ P, M₀ / 2 ≤ ((T_fam p).card : ℝ) ∧ ((T_fam p).card : ℝ) ≤ 2 * M₀) ∧
          (∀ p ∈ P, IsRhoSet ρ s (4 * B_B ^ 2 / q) (T_fam p)) ∧
          (((P.biUnion T_fam).card : ℝ) ≤ (Q : ℝ) * (2 * (⌈C_cov⌉₊ : ℝ) + 1) * M) := by
    intro N Q hN hQ ρ d s q M C_cov B_P B_B hρ hρ₆ hd₀ hs₀ hq₀ hM₀ hC_cov hB_P hB_B
      hN_lb hQ_lb y hy_dom a_sl ha_dom G_samp h_edges h_occ_P h_occ_B S_cov hS_card hS_cov
    have hρ_lt1 : ρ < 1 := by linarith only [hρ₆]
    have hQ_pos : (0 : ℝ) < (Q : ℝ) := Nat.cast_pos.mpr (by omega)
    have hN_pos : (0 : ℝ) < (N : ℝ) := Nat.cast_pos.mpr (by omega)

    have h_dyad_inj : ∀ k₁ k₂ : ℤ × ℤ, dyadicSquare ρ k₁ = dyadicSquare ρ k₂ → k₁ = k₂ := by
      intro k₁ k₂ h_eq
      let pt : EuclideanSpace ℝ (Fin 2) := WithLp.toLp 2 ![(k₁.1 : ℝ) * ρ, (k₁.2 : ℝ) * ρ]
      have h_pt0 : pt 0 = (k₁.1 : ℝ) * ρ := (h_lp2 _ _).1
      have h_pt1 : pt 1 = (k₁.2 : ℝ) * ρ := (h_lp2 _ _).2
      have h_mem1 : pt ∈ dyadicSquare ρ k₁ := by
        dsimp [dyadicSquare]
        rw [h_pt0, h_pt1]
        exact ⟨le_rfl, by linarith only [hρ], le_rfl, by linarith only [hρ]⟩
      rw [h_eq] at h_mem1
      dsimp [dyadicSquare] at h_mem1
      rw [h_pt0, h_pt1] at h_mem1
      obtain ⟨h1_le, h1_lt, h2_le, h2_lt⟩ := h_mem1
      have hk1_a : (k₂.1 : ℝ) ≤ (k₁.1 : ℝ) := le_of_mul_le_mul_right h1_le hρ
      have hk1_b : (k₁.1 : ℝ) < ((k₂.1 + 1 : ℤ) : ℝ) := by
        push_cast
        exact lt_of_mul_lt_mul_right h1_lt hρ.le
      have hk2_a : (k₂.2 : ℝ) ≤ (k₁.2 : ℝ) := le_of_mul_le_mul_right h2_le hρ
      have hk2_b : (k₁.2 : ℝ) < ((k₂.2 + 1 : ℤ) : ℝ) := by
        push_cast
        exact lt_of_mul_lt_mul_right h2_lt hρ.le
      have hk1_z1 : k₂.1 ≤ k₁.1 := by exact_mod_cast hk1_a
      have hk1_z2 : k₁.1 < k₂.1 + 1 := by exact_mod_cast hk1_b
      have hk2_z1 : k₂.2 ≤ k₁.2 := by exact_mod_cast hk2_a
      have hk2_z2 : k₁.2 < k₂.2 + 1 := by exact_mod_cast hk2_b
      exact Prod.ext (by omega) (by omega)

    have h_pt_in_dyad : ∀ w : EuclideanSpace ℝ (Fin 2),
        w ∈ dyadicSquare ρ (⌊w 0 / ρ⌋, ⌊w 1 / ρ⌋) := by
      intro w
      exact ⟨(le_div_iff₀ hρ).mp (Int.floor_le (w 0 / ρ)),
             (div_lt_iff₀ hρ).mp (Int.lt_floor_add_one (w 0 / ρ)),
             (le_div_iff₀ hρ).mp (Int.floor_le (w 1 / ρ)),
             (div_lt_iff₀ hρ).mp (Int.lt_floor_add_one (w 1 / ρ))⟩

    have h_dyad_diam : ∀ (k : ℤ × ℤ) (w₁ w₂ : EuclideanSpace ℝ (Fin 2)),
        w₁ ∈ dyadicSquare ρ k → w₂ ∈ dyadicSquare ρ k → ‖w₁ - w₂‖ < 2 * ρ := by
      intro k w₁ w₂ hw₁ hw₂
      obtain ⟨h1a, h1b, h1c, h1d⟩ := hw₁
      obtain ⟨h2a, h2b, h2c, h2d⟩ := hw₂
      have hd0 : |w₁ 0 - w₂ 0| < ρ :=
        abs_lt.mpr ⟨by linarith only [h1a, h2b], by linarith only [h1b, h2a]⟩
      have hd1 : |w₁ 1 - w₂ 1| < ρ :=
        abs_lt.mpr ⟨by linarith only [h1c, h2d], by linarith only [h1d, h2c]⟩
      have hsq0 : (w₁ 0 - w₂ 0) ^ 2 < ρ ^ 2 := by
        rw [← sq_abs]
        exact (sq_lt_sq₀ (abs_nonneg _) hρ.le).mpr hd0
      have hsq1 : (w₁ 1 - w₂ 1) ^ 2 < ρ ^ 2 := by
        rw [← sq_abs]
        exact (sq_lt_sq₀ (abs_nonneg _) hρ.le).mpr hd1
      have h_nsq : ‖w₁ - w₂‖ ^ 2 < (2 * ρ) ^ 2 := by
        rw [h_norm2 (w₁ - w₂), h_sub_apply, h_sub_apply]
        have hρ2_pos : 0 < ρ ^ 2 := sq_pos_of_pos hρ
        have h4 : (2 * ρ) ^ 2 = 4 * ρ ^ 2 := by ring
        linarith only [hsq0, hsq1, hρ2_pos, h4]
      exact (sq_lt_sq₀ (norm_nonneg _) (by positivity)).mp h_nsq

    let deg : Fin N → ℕ := fun u => (Finset.univ.filter (fun v : Fin Q => G_samp u v)).card
    have h_deg_sum : (1 / 2 : ℝ) * q * (N : ℝ) * (Q : ℝ) ≤ ∑ u : Fin N, (deg u : ℝ) := by
      have h_eq : (Finset.univ.filter (fun uv : Fin N × Fin Q => G_samp uv.1 uv.2)).card =
          ∑ u : Fin N, deg u := by
        dsimp [deg]
        rw [Finset.card_filter, Fintype.sum_prod_type]
        refine Finset.sum_congr rfl (fun u _ => ?_)
        rw [Finset.card_filter]
      have h_cast : ((Finset.univ.filter (fun uv : Fin N × Fin Q => G_samp uv.1 uv.2)).card : ℝ) =
          ∑ u : Fin N, (deg u : ℝ) := by
        rw [h_eq, Nat.cast_sum]
      linarith only [h_edges, h_cast]

    let U_high : Finset (Fin N) :=
      Finset.univ.filter (fun u : Fin N => (1 / 4 : ℝ) * q * (Q : ℝ) ≤ (deg u : ℝ))
    have hU_high_card : (1 / 4 : ℝ) * q * (N : ℝ) ≤ (U_high.card : ℝ) := by
      let U_low :=
        Finset.univ.filter (fun u : Fin N => ¬ ((1 / 4 : ℝ) * q * (Q : ℝ) ≤ (deg u : ℝ)))
      have h_split := Finset.sum_filter_add_sum_filter_not Finset.univ
        (fun u : Fin N => (1 / 4 : ℝ) * q * (Q : ℝ) ≤ (deg u : ℝ)) (fun u => (deg u : ℝ))
      change (∑ u ∈ U_high, (deg u : ℝ)) + (∑ u ∈ U_low, (deg u : ℝ)) =
        ∑ u : Fin N, (deg u : ℝ) at h_split
      have h_low_ub : (∑ u ∈ U_low, (deg u : ℝ)) ≤ (1 / 4 : ℝ) * q * (N : ℝ) * (Q : ℝ) := by
        have h_u : ∀ u ∈ U_low, (deg u : ℝ) ≤ (1 / 4 : ℝ) * q * (Q : ℝ) :=
          fun u hu => le_of_not_ge (Finset.mem_filter.mp hu).2
        have h_card : (U_low.card : ℝ) ≤ (N : ℝ) := by
          have h1 : U_low.card ≤ (Finset.univ : Finset (Fin N)).card := Finset.card_filter_le _ _
          rw [Finset.card_univ, Fintype.card_fin] at h1
          exact_mod_cast h1
        calc (∑ u ∈ U_low, (deg u : ℝ))
            ≤ ∑ _u ∈ U_low, ((1 / 4 : ℝ) * q * (Q : ℝ)) := Finset.sum_le_sum h_u
          _ = (U_low.card : ℝ) * ((1 / 4 : ℝ) * q * (Q : ℝ)) := by
              rw [Finset.sum_const, nsmul_eq_mul]
          _ ≤ (N : ℝ) * ((1 / 4 : ℝ) * q * (Q : ℝ)) :=
              mul_le_mul_of_nonneg_right h_card (by positivity)
          _ = (1 / 4 : ℝ) * q * (N : ℝ) * (Q : ℝ) := by ring
      have h_high_ub : (∑ u ∈ U_high, (deg u : ℝ)) ≤ (U_high.card : ℝ) * (Q : ℝ) := by
        have h_u : ∀ u ∈ U_high, (deg u : ℝ) ≤ (Q : ℝ) := by
          intro u _
          have h1 : deg u ≤ (Finset.univ : Finset (Fin Q)).card := Finset.card_filter_le _ _
          rw [Finset.card_univ, Fintype.card_fin] at h1
          exact_mod_cast h1
        calc (∑ u ∈ U_high, (deg u : ℝ))
            ≤ ∑ _u ∈ U_high, (Q : ℝ) := Finset.sum_le_sum h_u
          _ = (U_high.card : ℝ) * (Q : ℝ) := by rw [Finset.sum_const, nsmul_eq_mul]
      have h_high_lb : (1 / 4 : ℝ) * q * (N : ℝ) * (Q : ℝ) ≤ (U_high.card : ℝ) * (Q : ℝ) := by
        linarith only [h_deg_sum, h_split, h_low_ub, h_high_ub]
      exact le_of_mul_le_mul_right h_high_lb hQ_pos

    let p_of : Fin N → Set (EuclideanSpace ℝ (Fin 2)) :=
      fun u => dyadicSquare ρ (⌊y u 0 / ρ⌋, ⌊y u 1 / ρ⌋)
    let P_sq : Finset (Set (EuclideanSpace ℝ (Fin 2))) := U_high.image p_of
    have hp_of_dyad : ∀ u : Fin N, IsDyadicSquare ρ (p_of u) := by
      intro u
      refine ⟨⟨(⌊y u 0 / ρ⌋, ⌊y u 1 / ρ⌋), rfl⟩, ?_⟩
      intro w hw
      have hy_u := hy_dom u
      obtain ⟨hw0_ge, hw0_lt, hw1_ge, hw1_lt⟩ := hw
      obtain ⟨hy0_ge, _, hy1_ge, _⟩ := h_pt_in_dyad (y u)
      have hk0_nn : (0 : ℝ) ≤ (⌊y u 0 / ρ⌋ : ℝ) := by
        exact_mod_cast Int.floor_nonneg.mpr (div_nonneg hy_u.1.1 hρ.le)
      have hk1_nn : (0 : ℝ) ≤ (⌊y u 1 / ρ⌋ : ℝ) := by
        exact_mod_cast Int.floor_nonneg.mpr (div_nonneg hy_u.2.1 hρ.le)
      have hy_u0_hi := hy_u.1.2
      have hy_u1_hi := hy_u.2.2
      refine ⟨⟨le_trans (mul_nonneg hk0_nn hρ.le) hw0_ge, ?_⟩,
              ⟨le_trans (mul_nonneg hk1_nn hρ.le) hw1_ge, ?_⟩⟩
      · have h_step : ((⌊y u 0 / ρ⌋ : ℝ) + 1) * ρ = (⌊y u 0 / ρ⌋ : ℝ) * ρ + ρ := by ring
        linarith only [hw0_lt, hy0_ge, hy_u0_hi, hρ₆, h_step]
      · have h_step : ((⌊y u 1 / ρ⌋ : ℝ) + 1) * ρ = (⌊y u 1 / ρ⌋ : ℝ) * ρ + ρ := by ring
        linarith only [hw1_lt, hy1_ge, hy_u1_hi, hρ₆, h_step]

    have hP_sq_card : (q * (N : ℝ)) / (4 * B_P) ≤ (P_sq.card : ℝ) := by
      have h_fib_sum : U_high.card = ∑ p ∈ P_sq, (U_high.filter (fun u => p_of u = p)).card :=
        Finset.card_eq_sum_card_image p_of U_high
      have h_fib_ub : ∀ p ∈ P_sq, ((U_high.filter (fun u => p_of u = p)).card : ℝ) ≤ B_P := by
        intro p hp
        obtain ⟨u₀, _, rfl⟩ := Finset.mem_image.mp hp
        have h_sub : U_high.filter (fun u => p_of u = p_of u₀) ⊆
            Finset.univ.filter (fun u : Fin N => ‖y u - y u₀‖ < 3 * ρ) := by
          intro u hu
          have heq : p_of u = p_of u₀ := (Finset.mem_filter.mp hu).2
          refine Finset.mem_filter.mpr ⟨Finset.mem_univ u, ?_⟩
          have h_in_u : y u ∈ p_of u₀ := by rw [← heq]; exact h_pt_in_dyad (y u)
          have h_diam := h_dyad_diam _ (y u) (y u₀) h_in_u (h_pt_in_dyad (y u₀))
          linarith only [h_diam, hρ]
        have h_occ := h_occ_P (y u₀) ρ le_rfl hρ_lt1.le
        rw [div_self hρ.ne', Real.one_rpow, mul_one] at h_occ
        exact le_trans (by exact_mod_cast Finset.card_le_card h_sub) h_occ
      have h_sum_real : (U_high.card : ℝ) ≤ (P_sq.card : ℝ) * B_P := by
        calc (U_high.card : ℝ)
            = ∑ p ∈ P_sq, ((U_high.filter (fun u => p_of u = p)).card : ℝ) := by
              rw [h_fib_sum, Nat.cast_sum]
          _ ≤ ∑ _p ∈ P_sq, B_P := Finset.sum_le_sum h_fib_ub
          _ = (P_sq.card : ℝ) * B_P := by rw [Finset.sum_const, nsmul_eq_mul]
      rw [div_le_iff₀ (by positivity)]
      linarith only [hU_high_card, h_sum_real]

    let u_p : Set (EuclideanSpace ℝ (Fin 2)) → Fin N := fun p =>
      if hp : p ∈ P_sq then Classical.choose (Finset.mem_image.mp hp) else ⟨0, by omega⟩
    have hu_p_spec : ∀ p ∈ P_sq, u_p p ∈ U_high ∧ p_of (u_p p) = p := by
      intro p hp
      dsimp [u_p]
      rw [dif_pos hp]
      exact Classical.choose_spec (Finset.mem_image.mp hp)
    have hu_p_inj : Set.InjOn u_p ↑P_sq := by
      intro p₁ hp₁ p₂ hp₂ heq
      rw [← (hu_p_spec p₁ hp₁).2, ← (hu_p_spec p₂ hp₂).2, heq]

    let V_inc : Set (EuclideanSpace ℝ (Fin 2)) → Finset (Fin Q) :=
      fun p => Finset.univ.filter (fun v : Fin Q => G_samp (u_p p) v)
    let k_sl : Fin Q → ℤ := fun v => ⌊a_sl v / ρ⌋
    let K_s : Set (EuclideanSpace ℝ (Fin 2)) → Finset ℤ := fun p => (V_inc p).image k_sl
    let v_pk : Set (EuclideanSpace ℝ (Fin 2)) → ℤ → Fin Q := fun p k₀ =>
      if hk : k₀ ∈ K_s p then Classical.choose (Finset.mem_image.mp hk) else ⟨0, by omega⟩
    have hv_pk_spec : ∀ p (k₀ : ℤ), k₀ ∈ K_s p →
        v_pk p k₀ ∈ V_inc p ∧ k_sl (v_pk p k₀) = k₀ := by
      intro p k₀ hk
      dsimp [v_pk]
      rw [dif_pos hk]
      exact Classical.choose_spec (Finset.mem_image.mp hk)
    have hv_pk_inj : ∀ p, Set.InjOn (v_pk p) ↑(K_s p) := by
      intro p k₁ hk₁ k₂ hk₂ heq
      rw [← (hv_pk_spec p k₁ hk₁).2, ← (hv_pk_spec p k₂ hk₂).2, heq]

    let q_mk : Set (EuclideanSpace ℝ (Fin 2)) → ℤ → Set (EuclideanSpace ℝ (Fin 2)) :=
      fun p k₀ => dyadicSquare ρ (k₀, ⌊(y (u_p p) 1 - a_sl (v_pk p k₀) * y (u_p p) 0) / ρ⌋)
    have hq_mk_inj : ∀ p, Function.Injective (q_mk p) := by
      intro p k₁ k₂ heq
      exact (Prod.ext_iff.mp (h_dyad_inj _ _ heq)).1
    let T_fam : Set (EuclideanSpace ℝ (Fin 2)) → Finset (Set (EuclideanSpace ℝ (Fin 2))) :=
      fun p => if p ∈ P_sq then (K_s p).image (q_mk p) else ∅

    have hT_fam_bounds : ∀ p ∈ P_sq,
        1 ≤ (T_fam p).card ∧ (T_fam p).card ≤ Q ∧
        (q * (Q : ℝ)) / (4 * B_B) ≤ ((T_fam p).card : ℝ) := by
      intro p hp
      have hT_card_eq : (T_fam p).card = (K_s p).card := by
        dsimp [T_fam]
        rw [if_pos hp]
        exact Finset.card_image_of_injective (K_s p) (hq_mk_inj p)
      have hu_high := (hu_p_spec p hp).1
      have hV_lb : (1 / 4 : ℝ) * q * (Q : ℝ) ≤ ((V_inc p).card : ℝ) :=
        (Finset.mem_filter.mp hu_high).2
      have hV_pos_real : (0 : ℝ) < ((V_inc p).card : ℝ) := lt_of_lt_of_le (by positivity) hV_lb
      have hV_ne : (V_inc p).Nonempty := Finset.card_pos.mp (Nat.cast_pos.mp hV_pos_real)
      have hK_ge1 : 1 ≤ (K_s p).card := Finset.one_le_card.mpr (hV_ne.image k_sl)
      have hK_le_Q : (K_s p).card ≤ Q := by
        calc (K_s p).card ≤ (V_inc p).card := Finset.card_image_le
          _ ≤ (Finset.univ : Finset (Fin Q)).card := Finset.card_filter_le _ _
          _ = Q := by rw [Finset.card_univ, Fintype.card_fin]
      have h_fib_sum : (V_inc p).card =
          ∑ k₀ ∈ K_s p, ((V_inc p).filter (fun v => k_sl v = k₀)).card :=
        Finset.card_eq_sum_card_image k_sl (V_inc p)
      have h_fib_ub : ∀ k₀ ∈ K_s p,
          (((V_inc p).filter (fun v => k_sl v = k₀)).card : ℝ) ≤ B_B := by
        intro k₀ _
        have h_sub : (V_inc p).filter (fun v => k_sl v = k₀) ⊆
            Finset.univ.filter (fun v : Fin Q => |a_sl v - (k₀ : ℝ) * ρ| < 2 * ρ) := by
          intro v hv
          have hk_eq : ⌊a_sl v / ρ⌋ = k₀ := (Finset.mem_filter.mp hv).2
          refine Finset.mem_filter.mpr ⟨Finset.mem_univ v, ?_⟩
          have h_ge : (k₀ : ℝ) * ρ ≤ a_sl v := by
            rw [← hk_eq]
            exact (le_div_iff₀ hρ).mp (Int.floor_le (a_sl v / ρ))
          have h_lt : a_sl v < ((k₀ : ℝ) + 1) * ρ := by
            rw [← hk_eq]
            exact (div_lt_iff₀ hρ).mp (Int.lt_floor_add_one (a_sl v / ρ))
          rw [abs_of_nonneg (by linarith only [h_ge])]
          have h_step : ((k₀ : ℝ) + 1) * ρ = (k₀ : ℝ) * ρ + ρ := by ring
          linarith only [h_lt, h_step, hρ]
        have h_occ := h_occ_B ((k₀ : ℝ) * ρ) ρ le_rfl hρ_lt1.le
        rw [div_self hρ.ne', Real.one_rpow, mul_one] at h_occ
        exact le_trans (by exact_mod_cast Finset.card_le_card h_sub) h_occ
      have hK_lb : (q * (Q : ℝ)) / (4 * B_B) ≤ ((K_s p).card : ℝ) := by
        have h_sum_real : ((V_inc p).card : ℝ) ≤ ((K_s p).card : ℝ) * B_B := by
          calc ((V_inc p).card : ℝ)
              = ∑ k₀ ∈ K_s p, (((V_inc p).filter (fun v => k_sl v = k₀)).card : ℝ) := by
                rw [h_fib_sum, Nat.cast_sum]
            _ ≤ ∑ _k₀ ∈ K_s p, B_B := Finset.sum_le_sum h_fib_ub
            _ = ((K_s p).card : ℝ) * B_B := by rw [Finset.sum_const, nsmul_eq_mul]
        rw [div_le_iff₀ (by positivity)]
        linarith only [hV_lb, h_sum_real]
      rw [hT_card_eq]
      exact ⟨hK_ge1, hK_le_Q, hK_lb⟩

    have hT_fam_geom : ∀ p ∈ P_sq, ∀ q_sq ∈ T_fam p,
        IsTubeParamSquare ρ q_sq ∧ (dyadicTube q_sq ∩ p).Nonempty := by
      intro p hp q_sq hq_sq
      dsimp [T_fam] at hq_sq
      rw [if_pos hp] at hq_sq
      obtain ⟨k₀, hk₀_mem, rfl⟩ := Finset.mem_image.mp hq_sq
      have hv_spec := hv_pk_spec p k₀ hk₀_mem
      have hk₀_eq : ⌊a_sl (v_pk p k₀) / ρ⌋ = k₀ := hv_spec.2
      have ha_v := ha_dom (v_pk p k₀)
      have ha_lo := ha_v.1
      have ha_hi := ha_v.2
      have h_a_ge : (k₀ : ℝ) * ρ ≤ a_sl (v_pk p k₀) := by
        have h_fl := Int.floor_le (a_sl (v_pk p k₀) / ρ)
        rw [hk₀_eq] at h_fl
        exact (le_div_iff₀ hρ).mp h_fl
      have h_a_lt : a_sl (v_pk p k₀) < ((k₀ : ℝ) + 1) * ρ := by
        have h_fl := Int.lt_floor_add_one (a_sl (v_pk p k₀) / ρ)
        rw [hk₀_eq] at h_fl
        exact (div_lt_iff₀ hρ).mp h_fl
      refine ⟨⟨⟨(k₀, ⌊(y (u_p p) 1 - a_sl (v_pk p k₀) * y (u_p p) 0) / ρ⌋), rfl⟩, ?_⟩, ?_⟩
      · intro w hw
        obtain ⟨hw0_ge, hw0_lt, _, _⟩ := hw
        have h_step : ((k₀ : ℝ) + 1) * ρ = (k₀ : ℝ) * ρ + ρ := by ring
        exact ⟨by linarith only [hw0_ge, h_a_lt, ha_lo, hρ₆, h_step],
               by linarith only [hw0_lt, h_a_ge, ha_hi, hρ₆, h_step]⟩
      · refine ⟨y (u_p p), ?_, ?_⟩
        · let u_star : EuclideanSpace ℝ (Fin 2) :=
            WithLp.toLp 2 ![a_sl (v_pk p k₀),
                            y (u_p p) 1 - a_sl (v_pk p k₀) * y (u_p p) 0]
          have hu0 := (h_lp2 (a_sl (v_pk p k₀))
            (y (u_p p) 1 - a_sl (v_pk p k₀) * y (u_p p) 0)).1
          have hu1 := (h_lp2 (a_sl (v_pk p k₀))
            (y (u_p p) 1 - a_sl (v_pk p k₀) * y (u_p p) 0)).2
          refine ⟨u_star, ?_, ?_⟩
          · dsimp [q_mk, dyadicSquare]
            rw [hu0, hu1]
            exact ⟨h_a_ge, h_a_lt,
                   (le_div_iff₀ hρ).mp (Int.floor_le _),
                   (div_lt_iff₀ hρ).mp (Int.lt_floor_add_one _)⟩
          · rw [hu0, hu1]
            ring
        · have h_in : y (u_p p) ∈ p_of (u_p p) := h_pt_in_dyad (y (u_p p))
          rwa [(hu_p_spec p hp).2] at h_in

    let k_sh : Set (EuclideanSpace ℝ (Fin 2)) → ℕ := fun p => Nat.log 2 (T_fam p).card
    let L_sh : ℕ := Nat.log 2 Q + 1
    have hL_sh_pos : (0 : ℝ) < (L_sh : ℝ) := by dsimp [L_sh]; positivity
    have h_maps : Set.MapsTo k_sh ↑P_sq ↑(Finset.range L_sh) := by
      intro p hp
      have h_le_Q := (hT_fam_bounds p hp).2.1
      have h_log_le : Nat.log 2 (T_fam p).card ≤ Nat.log 2 Q := Nat.log_mono_right h_le_Q
      exact Finset.mem_range.mpr (by dsimp [k_sh, L_sh]; omega)
    have h_shell_sum : P_sq.card =
        ∑ k ∈ Finset.range L_sh, (P_sq.filter (fun p => k_sh p = k)).card :=
      Finset.card_eq_sum_card_fiberwise h_maps
    have h_shell_exists : ∃ k_star ∈ Finset.range L_sh,
        (q * (N : ℝ)) / (4 * B_P * (L_sh : ℝ)) ≤
          ((P_sq.filter (fun p => k_sh p = k_star)).card : ℝ) := by
      by_contra h_all
      push_neg at h_all
      have h_ne : (Finset.range L_sh).Nonempty := ⟨0, Finset.mem_range.mpr (by dsimp [L_sh]; omega)⟩
      have h_sum_lt : (∑ k ∈ Finset.range L_sh,
          ((P_sq.filter (fun p => k_sh p = k)).card : ℝ)) < (q * (N : ℝ)) / (4 * B_P) := by
        calc (∑ k ∈ Finset.range L_sh, ((P_sq.filter (fun p => k_sh p = k)).card : ℝ))
            < ∑ _k ∈ Finset.range L_sh, ((q * (N : ℝ)) / (4 * B_P * (L_sh : ℝ))) :=
              Finset.sum_lt_sum_of_nonempty h_ne h_all
          _ = (L_sh : ℝ) * ((q * (N : ℝ)) / (4 * B_P * (L_sh : ℝ))) := by
              rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
          _ = (q * (N : ℝ)) / (4 * B_P) := by
              have hBP_pos : 0 < B_P := by linarith only [hB_P]
              field_simp [hBP_pos.ne', hL_sh_pos.ne']
      have h_sum_eq : (P_sq.card : ℝ) =
          ∑ k ∈ Finset.range L_sh, ((P_sq.filter (fun p => k_sh p = k)).card : ℝ) := by
        rw [h_shell_sum, Nat.cast_sum]
      linarith only [hP_sq_card, h_sum_eq, h_sum_lt]

    obtain ⟨k_star, _, hk_star_card⟩ := h_shell_exists
    let P : Finset (Set (EuclideanSpace ℝ (Fin 2))) := P_sq.filter (fun p => k_sh p = k_star)
    let M₀ : ℝ := ((2 ^ k_star : ℕ) : ℝ)
    have hM₀_pos : 0 < M₀ := by dsimp [M₀]; positivity
    have hP_card_lb : (q * (N : ℝ)) / (4 * B_P * (L_sh : ℝ)) ≤ (P.card : ℝ) := hk_star_card
    have hP_pos_real : (0 : ℝ) < (P.card : ℝ) := lt_of_lt_of_le (by positivity) hP_card_lb
    have hP_ne : P.Nonempty := Finset.card_pos.mp (Nat.cast_pos.mp hP_pos_real)
    have hP_sub : P ⊆ P_sq := Finset.filter_subset _ _

    have hT_deg_shell : ∀ p ∈ P,
        M₀ / 2 ≤ ((T_fam p).card : ℝ) ∧ ((T_fam p).card : ℝ) ≤ 2 * M₀ := by
      intro p hp
      obtain ⟨hp_sq, hk_eq⟩ := Finset.mem_filter.mp hp
      dsimp [k_sh] at hk_eq
      have h1_le := (hT_fam_bounds p hp_sq).1
      have h_lo_nat : 2 ^ k_star ≤ (T_fam p).card := by
        rw [← hk_eq]
        exact Nat.pow_log_le_self 2 (by omega)
      have h_hi_nat : (T_fam p).card ≤ 2 * 2 ^ k_star := by
        have h_lt := Nat.lt_pow_succ_log_self (by omega : 1 < 2) (T_fam p).card
        rw [hk_eq, Nat.succ_eq_add_one, pow_succ'] at h_lt
        omega
      have h_lo_real : M₀ ≤ ((T_fam p).card : ℝ) := by
        dsimp [M₀]
        exact_mod_cast h_lo_nat
      have h_hi_real : ((T_fam p).card : ℝ) ≤ 2 * M₀ := by
        dsimp [M₀]
        exact_mod_cast h_hi_nat
      exact ⟨by linarith only [hM₀_pos, h_lo_real], h_hi_real⟩

    have hM₀_lb : (q / (8 * B_B)) * (Q : ℝ) ≤ M₀ := by
      obtain ⟨p₀, hp₀⟩ := hP_ne
      have h1 := (hT_fam_bounds p₀ (hP_sub hp₀)).2.2
      have h2 := (hT_deg_shell p₀ hp₀).2
      have h_comb : (q * (Q : ℝ)) / (4 * B_B) ≤ 2 * M₀ := le_trans h1 h2
      have h_eq : (q / (8 * B_B)) * (Q : ℝ) = ((q * (Q : ℝ)) / (4 * B_B)) / 2 := by ring
      linarith only [h_comb, h_eq]

    have hP_rhoset : IsRhoSet ρ d (4 * B_P ^ 2 * (L_sh : ℝ) / q) P := by
      refine ⟨hP_ne, fun z r hr₀ hr₁ => ?_⟩
      let P_hit := P.filter (fun p => (p ∩ Metric.ball z r).Nonempty)
      have h_img_sub : P_hit.image u_p ⊆
          Finset.univ.filter (fun u : Fin N => ‖y u - z‖ < 3 * r) := by
        intro u hu
        obtain ⟨p, hp_hit, rfl⟩ := Finset.mem_image.mp hu
        obtain ⟨hp_P, w, hw_p, hw_ball⟩ := Finset.mem_filter.mp hp_hit
        have hp_sq : p ∈ P_sq := hP_sub hp_P
        refine Finset.mem_filter.mpr ⟨Finset.mem_univ _, ?_⟩
        have hp_eq := (hu_p_spec p hp_sq).2
        rw [← hp_eq] at hw_p
        have h_diam := h_dyad_diam _ (y (u_p p)) w (h_pt_in_dyad _) hw_p
        have hw_dist : ‖w - z‖ < r := Metric.mem_ball.mp hw_ball
        have h_tri : ‖y (u_p p) - z‖ ≤ ‖y (u_p p) - w‖ + ‖w - z‖ := by
          calc ‖y (u_p p) - z‖ = ‖(y (u_p p) - w) + (w - z)‖ := by abel_nf
            _ ≤ ‖y (u_p p) - w‖ + ‖w - z‖ := norm_add_le _ _
        linarith only [h_tri, h_diam, hw_dist, hr₀]
      have h_inj_hit : Set.InjOn u_p ↑P_hit :=
        hu_p_inj.mono (Finset.coe_subset.mpr ((Finset.filter_subset _ P).trans hP_sub))
      have h_hit_card : (P_hit.card : ℝ) ≤ B_P * (r / ρ) ^ d := by
        have h_eq : (P_hit.image u_p).card = P_hit.card := Finset.card_image_of_injOn h_inj_hit
        have h_le : P_hit.card ≤ (Finset.univ.filter (fun u : Fin N => ‖y u - z‖ < 3 * r)).card := by
          rw [← h_eq]
          exact Finset.card_le_card h_img_sub
        exact le_trans (by exact_mod_cast h_le) (h_occ_P z r hr₀ hr₁)
      have h_N_le_P : (N : ℝ) ≤ (4 * B_P * (L_sh : ℝ) / q) * (P.card : ℝ) := by
        have h1 := (div_le_iff₀ (by positivity : 0 < 4 * B_P * (L_sh : ℝ))).mp hP_card_lb
        rw [div_mul_eq_mul_div, le_div_iff₀ hq₀]
        linarith only [h1]
      have h_div_rpow : (r / ρ) ^ d = r ^ d * ρ ^ (-d) := by
        have hr_nn : 0 ≤ r := le_trans hρ.le hr₀
        rw [div_eq_mul_inv, Real.mul_rpow hr_nn (inv_nonneg.mpr hρ.le),
            Real.inv_rpow hρ.le, Real.rpow_neg hρ.le]
      calc (P_hit.card : ℝ)
          ≤ B_P * (r / ρ) ^ d := h_hit_card
        _ = B_P * r ^ d * ρ ^ (-d) := by rw [h_div_rpow]; ring
        _ ≤ B_P * r ^ d * (N : ℝ) :=
            mul_le_mul_of_nonneg_left hN_lb (mul_nonneg (by linarith only [hB_P])
              (Real.rpow_nonneg (le_trans hρ.le hr₀) _))
        _ ≤ B_P * r ^ d * ((4 * B_P * (L_sh : ℝ) / q) * (P.card : ℝ)) :=
            mul_le_mul_of_nonneg_left h_N_le_P (mul_nonneg (by linarith only [hB_P])
              (Real.rpow_nonneg (le_trans hρ.le hr₀) _))
        _ = (4 * B_P ^ 2 * (L_sh : ℝ) / q) * r ^ d * (P.card : ℝ) := by ring

    have hT_rhoset : ∀ p ∈ P, IsRhoSet ρ s (4 * B_B ^ 2 / q) (T_fam p) := by
      intro p hp
      have hp_sq : p ∈ P_sq := hP_sub hp
      obtain ⟨hT_ge1, _, hT_lb⟩ := hT_fam_bounds p hp_sq
      refine ⟨Finset.one_le_card.mp hT_ge1, fun z r hr₀ hr₁ => ?_⟩
      let T_hit := (T_fam p).filter (fun q_sq => (q_sq ∩ Metric.ball z r).Nonempty)
      let K_hit := (K_s p).filter (fun k₀ => (q_mk p k₀ ∩ Metric.ball z r).Nonempty)
      have hT_hit_eq : T_hit = K_hit.image (q_mk p) := by
        dsimp [T_hit, K_hit, T_fam]
        rw [if_pos hp_sq, Finset.filter_image]
      have h_img_sub : K_hit.image (v_pk p) ⊆
          Finset.univ.filter (fun v : Fin Q => |a_sl v - z 0| < 2 * r) := by
        intro v hv
        obtain ⟨k₀, hk₀_hit, rfl⟩ := Finset.mem_image.mp hv
        obtain ⟨hk₀_mem, w, hw_q, hw_ball⟩ := Finset.mem_filter.mp hk₀_hit
        refine Finset.mem_filter.mpr ⟨Finset.mem_univ _, ?_⟩
        have hk₀_eq : ⌊a_sl (v_pk p k₀) / ρ⌋ = k₀ := (hv_pk_spec p k₀ hk₀_mem).2
        obtain ⟨hw0_ge, hw0_lt, _, _⟩ := hw_q
        have ha_ge : (k₀ : ℝ) * ρ ≤ a_sl (v_pk p k₀) := by
          have h_fl := Int.floor_le (a_sl (v_pk p k₀) / ρ)
          rw [hk₀_eq] at h_fl
          exact (le_div_iff₀ hρ).mp h_fl
        have ha_lt : a_sl (v_pk p k₀) < ((k₀ : ℝ) + 1) * ρ := by
          have h_fl := Int.lt_floor_add_one (a_sl (v_pk p k₀) / ρ)
          rw [hk₀_eq] at h_fl
          exact (div_lt_iff₀ hρ).mp h_fl
        have h_step : ((k₀ : ℝ) + 1) * ρ = (k₀ : ℝ) * ρ + ρ := by ring
        have h_aw : |a_sl (v_pk p k₀) - w 0| < ρ :=
          abs_lt.mpr ⟨by linarith only [ha_ge, hw0_lt, h_step],
                      by linarith only [ha_lt, hw0_ge, h_step]⟩
        have hw_dist : ‖w - z‖ < r := Metric.mem_ball.mp hw_ball
        have h_wz : |w 0 - z 0| < r := lt_of_le_of_lt (h_coord_le (w - z) 0) hw_dist
        have h_tri : |a_sl (v_pk p k₀) - z 0| ≤
            |a_sl (v_pk p k₀) - w 0| + |w 0 - z 0| := by
          calc |a_sl (v_pk p k₀) - z 0|
              = |(a_sl (v_pk p k₀) - w 0) + (w 0 - z 0)| := by ring_nf
            _ ≤ |a_sl (v_pk p k₀) - w 0| + |w 0 - z 0| := abs_add_le _ _
        linarith only [h_tri, h_aw, h_wz, hr₀]
      have h_inj_K : Set.InjOn (v_pk p) ↑K_hit :=
        (hv_pk_inj p).mono (Finset.coe_subset.mpr (Finset.filter_subset _ _))
      have h_hit_card : (T_hit.card : ℝ) ≤ B_B * (r / ρ) ^ s := by
        have h1 : T_hit.card ≤ K_hit.card := by
          rw [hT_hit_eq]
          exact Finset.card_image_le
        have h2 : K_hit.card = (K_hit.image (v_pk p)).card :=
          (Finset.card_image_of_injOn h_inj_K).symm
        have h3 : K_hit.card ≤
            (Finset.univ.filter (fun v : Fin Q => |a_sl v - z 0| < 2 * r)).card := by
          rw [h2]
          exact Finset.card_le_card h_img_sub
        exact le_trans (by exact_mod_cast (le_trans h1 h3)) (h_occ_B (z 0) r hr₀ hr₁)
      have h_Q_le_T : (Q : ℝ) ≤ (4 * B_B / q) * ((T_fam p).card : ℝ) := by
        have h1 := (div_le_iff₀ (by positivity : 0 < 4 * B_B)).mp hT_lb
        rw [div_mul_eq_mul_div, le_div_iff₀ hq₀]
        linarith only [h1]
      have h_div_rpow : (r / ρ) ^ s = r ^ s * ρ ^ (-s) := by
        have hr_nn : 0 ≤ r := le_trans hρ.le hr₀
        rw [div_eq_mul_inv, Real.mul_rpow hr_nn (inv_nonneg.mpr hρ.le),
            Real.inv_rpow hρ.le, Real.rpow_neg hρ.le]
      calc (T_hit.card : ℝ)
          ≤ B_B * (r / ρ) ^ s := h_hit_card
        _ = B_B * r ^ s * ρ ^ (-s) := by rw [h_div_rpow]; ring
        _ ≤ B_B * r ^ s * (Q : ℝ) :=
            mul_le_mul_of_nonneg_left hQ_lb (mul_nonneg (by linarith only [hB_B])
              (Real.rpow_nonneg (le_trans hρ.le hr₀) _))
        _ ≤ B_B * r ^ s * ((4 * B_B / q) * ((T_fam p).card : ℝ)) :=
            mul_le_mul_of_nonneg_left h_Q_le_T (mul_nonneg (by linarith only [hB_B])
              (Real.rpow_nonneg (le_trans hρ.le hr₀) _))
        _ = (4 * B_B ^ 2 / q) * r ^ s * ((T_fam p).card : ℝ) := by ring

    let K_c : ℕ := ⌈C_cov⌉₊
    have h_biUnion_ub : ((P.biUnion T_fam).card : ℝ) ≤ (Q : ℝ) * (2 * (K_c : ℝ) + 1) * M := by
      let Win : Fin Q → ℝ → Finset (Set (EuclideanSpace ℝ (Fin 2))) := fun v c_t =>
        (Finset.Icc (⌊c_t / ρ⌋ - (K_c : ℤ)) (⌊c_t / ρ⌋ + (K_c : ℤ))).image
          (fun m_int => dyadicSquare ρ (k_sl v, m_int))
      have hWin_card : ∀ (v : Fin Q) (c_t : ℝ), ((Win v c_t).card : ℝ) ≤ 2 * (K_c : ℝ) + 1 := by
        intro v c_t
        have h1 : (Win v c_t).card ≤
            (Finset.Icc (⌊c_t / ρ⌋ - (K_c : ℤ)) (⌊c_t / ρ⌋ + (K_c : ℤ))).card :=
          Finset.card_image_le
        have h2 : (Finset.Icc (⌊c_t / ρ⌋ - (K_c : ℤ)) (⌊c_t / ρ⌋ + (K_c : ℤ))).card =
            2 * K_c + 1 := by
          rw [Int.card_Icc]
          omega
        have h_nat : (Win v c_t).card ≤ 2 * K_c + 1 := le_trans h1 (le_of_eq h2)
        have h_cast : ((Win v c_t).card : ℝ) ≤ ((2 * K_c + 1 : ℕ) : ℝ) := by exact_mod_cast h_nat
        push_cast at h_cast
        exact h_cast
      have h_sub_union : P.biUnion T_fam ⊆
          Finset.univ.biUnion (fun v : Fin Q => (S_cov v).biUnion (fun c_t => Win v c_t)) := by
        intro q_sq hq_mem
        obtain ⟨p, hp_P, hq_Tp⟩ := Finset.mem_biUnion.mp hq_mem
        have hp_sq : p ∈ P_sq := hP_sub hp_P
        dsimp [T_fam] at hq_Tp
        rw [if_pos hp_sq] at hq_Tp
        obtain ⟨k₀, hk₀_mem, rfl⟩ := Finset.mem_image.mp hq_Tp
        let v := v_pk p k₀
        have hv_spec := hv_pk_spec p k₀ hk₀_mem
        have hG_uv : G_samp (u_p p) v := (Finset.mem_filter.mp hv_spec.1).2
        obtain ⟨c_t, hc_t_mem, hc_t_est⟩ := hS_cov (u_p p) v hG_uv
        have hC_le_Kc : C_cov ≤ (K_c : ℝ) := Nat.le_ceil _
        let val := y (u_p p) 1 - a_sl v * y (u_p p) 0
        have h_val_est : |val - c_t| ≤ (K_c : ℝ) * ρ :=
          le_trans hc_t_est (mul_le_mul_of_nonneg_right hC_le_Kc hρ.le)
        obtain ⟨h_val_lo, h_val_hi⟩ := abs_le.mp h_val_est
        have h_div_lo : c_t / ρ - (K_c : ℝ) ≤ val / ρ := by
          have h1 : c_t - (K_c : ℝ) * ρ ≤ val := by linarith only [h_val_lo]
          have h2 := div_le_div_of_nonneg_right h1 hρ.le
          rwa [sub_div, mul_div_cancel_right₀ _ hρ.ne'] at h2
        have h_div_hi : val / ρ ≤ c_t / ρ + (K_c : ℝ) := by
          have h1 : val ≤ c_t + (K_c : ℝ) * ρ := by linarith only [h_val_hi]
          have h2 := div_le_div_of_nonneg_right h1 hρ.le
          rwa [add_div, mul_div_cancel_right₀ _ hρ.ne'] at h2
        have hm_icc : ⌊val / ρ⌋ ∈ Finset.Icc (⌊c_t / ρ⌋ - (K_c : ℤ)) (⌊c_t / ρ⌋ + (K_c : ℤ)) := by
          refine Finset.mem_Icc.mpr ⟨?_, ?_⟩
          · refine Int.le_floor.mpr ?_
            have h_fl := Int.floor_le (c_t / ρ)
            push_cast
            linarith only [h_fl, h_div_lo]
          · have h_lt : (⌊val / ρ⌋ : ℝ) < ((⌊c_t / ρ⌋ + (K_c : ℤ) + 1 : ℤ) : ℝ) := by
              have h_fl1 := Int.floor_le (val / ρ)
              have h_fl2 := Int.lt_floor_add_one (c_t / ρ)
              push_cast
              linarith only [h_fl1, h_div_hi, h_fl2]
            have h_lt_z : ⌊val / ρ⌋ < ⌊c_t / ρ⌋ + (K_c : ℤ) + 1 := by exact_mod_cast h_lt
            omega
        refine Finset.mem_biUnion.mpr ⟨v, Finset.mem_univ v, ?_⟩
        refine Finset.mem_biUnion.mpr ⟨c_t, hc_t_mem, ?_⟩
        refine Finset.mem_image.mpr ⟨⌊val / ρ⌋, hm_icc, ?_⟩
        change dyadicSquare ρ (k_sl v, ⌊val / ρ⌋) = dyadicSquare ρ (k₀, ⌊val / ρ⌋)
        rw [hv_spec.2]
      have h_card_nat : (P.biUnion T_fam).card ≤
          ∑ v : Fin Q, ∑ c_t ∈ S_cov v, (Win v c_t).card := by
        calc (P.biUnion T_fam).card
            ≤ (Finset.univ.biUnion (fun v : Fin Q =>
                (S_cov v).biUnion (fun c_t => Win v c_t))).card :=
              Finset.card_le_card h_sub_union
          _ ≤ ∑ v : Fin Q, ((S_cov v).biUnion (fun c_t => Win v c_t)).card :=
              Finset.card_biUnion_le
          _ ≤ ∑ v : Fin Q, ∑ c_t ∈ S_cov v, (Win v c_t).card :=
              Finset.sum_le_sum (fun v _ => Finset.card_biUnion_le)
      calc ((P.biUnion T_fam).card : ℝ)
          ≤ ∑ v : Fin Q, ∑ c_t ∈ S_cov v, ((Win v c_t).card : ℝ) := by
            have h1 : ((P.biUnion T_fam).card : ℝ) ≤
                ((∑ v : Fin Q, ∑ c_t ∈ S_cov v, (Win v c_t).card : ℕ) : ℝ) := by
              exact_mod_cast h_card_nat
            simpa only [Nat.cast_sum] using h1
        _ ≤ ∑ v : Fin Q, ∑ _c_t ∈ S_cov v, (2 * (K_c : ℝ) + 1) :=
            Finset.sum_le_sum (fun v _ => Finset.sum_le_sum (fun c_t _ => hWin_card v c_t))
        _ = ∑ v : Fin Q, ((S_cov v).card : ℝ) * (2 * (K_c : ℝ) + 1) := by
            refine Finset.sum_congr rfl (fun v _ => ?_)
            rw [Finset.sum_const, nsmul_eq_mul]
        _ ≤ ∑ _v : Fin Q, M * (2 * (K_c : ℝ) + 1) :=
            Finset.sum_le_sum (fun v _ =>
              mul_le_mul_of_nonneg_right (hS_card v) (by positivity))
        _ = (Q : ℝ) * (2 * (K_c : ℝ) + 1) * M := by
            rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
            ring

    refine ⟨M₀, P, T_fam, hM₀_pos, hM₀_lb, ?_, hP_rhoset, ?_, hT_deg_shell, hT_rhoset, h_biUnion_ub⟩
    · intro p hp
      rw [← (hu_p_spec p (hP_sub hp)).2]
      exact hp_of_dyad _
    · exact fun p hp => hT_fam_geom p (hP_sub hp)

  
  
  
  intro d s α B_dom C_cov hd₀ hd₂ hs₀ hs₁ hα hB hC
  obtain ⟨η₀, ρ₀, c_rw, hη₀, hρ₀, hc_rw, h_rw⟩ :=
    ren_wang s d (α / 2) hs₀ hs₁ hd₀ hd₂ (half_pos hα)
  let η : ℝ := min (1 / 8) (min (η₀ / 12) (α / 24))
  have hη_pos : 0 < η := lt_min (by norm_num) (lt_min (by positivity) (by positivity))
  have hη_le_eighth : η ≤ 1 / 8 := min_le_left _ _
  have h12η_le_η₀ : 12 * η ≤ η₀ := by
    have h1 : η ≤ η₀ / 12 := le_trans (min_le_right _ _) (min_le_left _ _)
    linarith only [h1]
  have h24η_le_α : 24 * η ≤ α := by
    have h1 : η ≤ α / 24 := le_trans (min_le_right _ _) (min_le_right _ _)
    linarith only [h1]
  let k_deg : ℕ := ⌈(4 + η) / (3 * η)⌉₊
  let K_c : ℕ := ⌈C_cov⌉₊
  let C_P0 : ℝ := 4 * (Real.exp 2 * 4608 * B_dom ^ 4 + 1)
  let C_B0 : ℝ := 2 * (Real.exp 2 * 20 * B_dom + 1)
  have hB_pos : 0 < B_dom := lt_of_lt_of_le zero_lt_one hB
  have hC_B0_pos : 0 < C_B0 := by positivity
  have hC_P0_pos : 0 < C_P0 := by positivity
  have h1_le_CB0 : 1 ≤ C_B0 := by
    have h_nn : (0 : ℝ) ≤ Real.exp 2 * 20 * B_dom := by positivity
    dsimp [C_B0]
    linarith only [h_nn]
  have h1_le_CP0 : 1 ≤ C_P0 := by
    have h_nn : (0 : ℝ) ≤ Real.exp 2 * 4608 * B_dom ^ 4 := by positivity
    dsimp [C_P0]
    linarith only [h_nn]
  have hCB0_le_CP0 : C_B0 ≤ C_P0 := by
    have hB_le_B4 : B_dom ≤ B_dom ^ 4 := by
      calc B_dom = B_dom ^ 1 := (pow_one B_dom).symm
        _ ≤ B_dom ^ 4 := pow_le_pow_right₀ hB (by omega)
    have h_mul : Real.exp 2 * (20 * B_dom) ≤ Real.exp 2 * (4608 * B_dom ^ 4) := by
      refine mul_le_mul_of_nonneg_left ?_ (Real.exp_pos 2).le
      have hB4_nn : 0 ≤ B_dom ^ 4 := pow_nonneg hB_pos.le 4
      linarith only [hB_le_B4, hB4_nn]
    dsimp [C_B0, C_P0]
    have h_nn : 0 ≤ Real.exp 2 * (4608 * B_dom ^ 4) := by positivity
    linarith only [h_mul, h_nn]

  let δ_2 : ℝ := (2 : ℝ) ^ η - 1
  have hδ_2_pos : 0 < δ_2 := sub_pos.mpr (Real.one_lt_rpow (by norm_num) hη_pos)
  let C_log : ℝ := 2 / δ_2 + 1
  let C_rho : ℝ := 4 * C_P0 ^ 2 * C_log
  have hC_rho_pos : 0 < C_rho := by positivity
  let C_end : ℝ := c_rw / (8 * C_B0 * (2 * (K_c : ℝ) + 1))
  have hC_end_pos : 0 < C_end := by positivity
  let ρ_tail : ℝ := 1 / (90 * (k_deg.factorial : ℝ))
  let ρ_rset : ℝ := C_rho⁻¹ ^ (1 / η)
  let ρ_end : ℝ := (min 1 C_end) ^ (4 / α)
  have hρ_tail_pos : 0 < ρ_tail := by
    have hf_pos : 0 < (k_deg.factorial : ℝ) := Nat.cast_pos.mpr (Nat.factorial_pos k_deg)
    positivity
  have hρ_rset_pos : 0 < ρ_rset := Real.rpow_pos_of_pos (inv_pos.mpr hC_rho_pos) _
  have hρ_end_pos : 0 < ρ_end := Real.rpow_pos_of_pos (lt_min zero_lt_one hC_end_pos) _
  let ρ₁ : ℝ := min (1 / 6) (min ρ₀ (min ρ_tail (min ρ_rset ρ_end)))
  have hρ₁_pos : 0 < ρ₁ :=
    lt_min (by norm_num) (lt_min hρ₀ (lt_min hρ_tail_pos (lt_min hρ_rset_pos hρ_end_pos)))
  have hρ₁_sixth : ρ₁ ≤ 1 / 6 := min_le_left _ _
  have hρ₁_half : ρ₁ < 1 / 2 := lt_of_le_of_lt hρ₁_sixth (by norm_num)
  refine ⟨η, ρ₁, hη_pos, hρ₁_pos, hρ₁_half, ?_⟩
  intro ρ M N_P N_B μ x_P ν a_B G
    hρ hρ_lt_ρ₁ hM hμ_nn hμ_sum hx_dom hx_ball hν_nn hν_sum ha_dom ha_ball hG_mass h_cov
  have hρ_sixth : ρ < 1 / 6 := lt_of_lt_of_le hρ_lt_ρ₁ (min_le_left _ _)
  have hρ_lt_ρ₀ : ρ < ρ₀ :=
    lt_of_lt_of_le hρ_lt_ρ₁ (le_trans (min_le_right _ _) (min_le_left _ _))
  have hρ_lt_tail : ρ < ρ_tail :=
    lt_of_lt_of_le hρ_lt_ρ₁
      (le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_left _ _)))
  have hρ_lt_rset : ρ < ρ_rset :=
    lt_of_lt_of_le hρ_lt_ρ₁
      (le_trans (min_le_right _ _)
        (le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_left _ _))))
  have hρ_lt_end : ρ < ρ_end :=
    lt_of_lt_of_le hρ_lt_ρ₁
      (le_trans (min_le_right _ _)
        (le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_right _ _))))
  have hρ_lt_one : ρ < 1 := by linarith only [hρ_sixth]

  
  let y_P : Fin N_P → EuclideanSpace ℝ (Fin 2) := fun i =>
    WithLp.toLp 2 ![(x_P i 0 + B_dom) / (3 * B_dom),
                    (x_P i 1 + 2 * B_dom ^ 2) / (6 * B_dom ^ 2)]
  let a_sl : Fin N_B → ℝ := fun j => a_B j / (2 * B_dom)
  have hy_P0 : ∀ i : Fin N_P, y_P i 0 = (x_P i 0 + B_dom) / (3 * B_dom) :=
    fun i => (h_lp2 _ _).1
  have hy_P1 : ∀ i : Fin N_P, y_P i 1 = (x_P i 1 + 2 * B_dom ^ 2) / (6 * B_dom ^ 2) :=
    fun i => (h_lp2 _ _).2
  have hB_le_B2 : B_dom ≤ B_dom ^ 2 := by
    calc B_dom = B_dom ^ 1 := (pow_one B_dom).symm
      _ ≤ B_dom ^ 2 := pow_le_pow_right₀ hB (by omega)
  have hy_P_dom : ∀ i : Fin N_P,
      (0 ≤ y_P i 0 ∧ y_P i 0 ≤ 2 / 3) ∧ (0 ≤ y_P i 1 ∧ y_P i 1 ≤ 2 / 3) := by
    intro i
    obtain ⟨h0_lo, h0_hi⟩ := abs_le.mp (le_trans (h_coord_le (x_P i) 0) (hx_dom i))
    obtain ⟨h1_lo, h1_hi⟩ := abs_le.mp (le_trans (h_coord_le (x_P i) 1) (hx_dom i))
    rw [hy_P0, hy_P1]
    refine ⟨⟨div_nonneg (by linarith only [h0_lo]) (by positivity), ?_⟩,
            ⟨div_nonneg (by linarith only [h1_lo, hB_le_B2, hB_pos]) (by positivity), ?_⟩⟩
    · rw [div_le_div_iff₀ (by positivity) (by norm_num)]
      linarith only [h0_hi]
    · rw [div_le_div_iff₀ (by positivity) (by norm_num)]
      have hB2_nn : 0 ≤ B_dom ^ 2 := sq_nonneg B_dom
      linarith only [h1_hi, hB_le_B2, hB2_nn]
  have ha_sl_dom : ∀ j : Fin N_B, -(1 / 2 : ℝ) ≤ a_sl j ∧ a_sl j ≤ 1 / 2 := by
    intro j
    obtain ⟨hj_lo, hj_hi⟩ := abs_le.mp (ha_dom j)
    dsimp [a_sl]
    refine ⟨(le_div_iff₀ (by positivity)).mpr (by linarith only [hj_lo]),
            (div_le_iff₀ (by positivity)).mpr (by linarith only [hj_hi])⟩

  have h1_le_6B2 : 1 ≤ 6 * B_dom ^ 2 := by
    have h1 : 1 ≤ B_dom ^ 2 := one_le_pow₀ hB
    linarith only [h1]
  have hy_P_ball : ∀ (z' : EuclideanSpace ℝ (Fin 2)) (R' : ℝ), ρ ≤ R' →
      (∑ i : Fin N_P, if ‖y_P i - z'‖ < R' then μ i else 0) ≤
        36 * B_dom ^ 4 * ρ ^ (-η) * R' ^ d := by
    intro z' R' hR'
    have hR'_pos : 0 < R' := lt_of_lt_of_le hρ hR'
    let z : EuclideanSpace ℝ (Fin 2) :=
      WithLp.toLp 2 ![3 * B_dom * z' 0 - B_dom, 6 * B_dom ^ 2 * z' 1 - 2 * B_dom ^ 2]
    have h_imp : ∀ i : Fin N_P, ‖y_P i - z'‖ < R' → ‖x_P i - z‖ < 6 * B_dom ^ 2 * R' := by
      intro i hi
      have h0 : (x_P i - z) 0 = 3 * B_dom * (y_P i 0 - z' 0) := by
        rw [h_sub_apply, (h_lp2 _ _).1, hy_P0]
        field_simp [hB_pos.ne']
        ring
      have h1 : (x_P i - z) 1 = 6 * B_dom ^ 2 * (y_P i 1 - z' 1) := by
        rw [h_sub_apply, (h_lp2 _ _).2, hy_P1]
        field_simp [hB_pos.ne']
        ring
      have hB2_le_B4 : B_dom ^ 2 ≤ B_dom ^ 4 := pow_le_pow_right₀ hB (by omega)
      have hsq_le : ‖x_P i - z‖ ^ 2 ≤ (6 * B_dom ^ 2 * ‖y_P i - z'‖) ^ 2 := by
        rw [h_norm2 (x_P i - z), h0, h1]
        have hy_sq := h_norm2 (y_P i - z')
        rw [h_sub_apply, h_sub_apply] at hy_sq
        have h_lhs_eq : (3 * B_dom * (y_P i 0 - z' 0)) ^ 2 +
            (6 * B_dom ^ 2 * (y_P i 1 - z' 1)) ^ 2 =
            9 * B_dom ^ 2 * (y_P i 0 - z' 0) ^ 2 + 36 * B_dom ^ 4 * (y_P i 1 - z' 1) ^ 2 := by
          ring
        have h_rhs_eq : (6 * B_dom ^ 2 * ‖y_P i - z'‖) ^ 2 =
            36 * B_dom ^ 4 * ((y_P i 0 - z' 0) ^ 2 + (y_P i 1 - z' 1) ^ 2) := by
          rw [← hy_sq]
          ring
        have h_term0 : 9 * B_dom ^ 2 * (y_P i 0 - z' 0) ^ 2 ≤
            36 * B_dom ^ 4 * (y_P i 0 - z' 0) ^ 2 := by
          refine mul_le_mul_of_nonneg_right ?_ (sq_nonneg _)
          have hB4_nn : 0 ≤ B_dom ^ 4 := pow_nonneg hB_pos.le 4
          linarith only [hB2_le_B4, hB4_nn]
        linarith only [h_lhs_eq, h_rhs_eq, h_term0]
      have hsq_lt : (6 * B_dom ^ 2 * ‖y_P i - z'‖) ^ 2 < (6 * B_dom ^ 2 * R') ^ 2 :=
        (sq_lt_sq₀ (by positivity) (by positivity)).mpr
          (mul_lt_mul_of_pos_left hi (by positivity))
      exact (sq_lt_sq₀ (norm_nonneg _) (by positivity)).mp (lt_of_le_of_lt hsq_le hsq_lt)
    have h6Bd_le : (6 * B_dom ^ 2) ^ d ≤ 36 * B_dom ^ 4 := by
      calc (6 * B_dom ^ 2) ^ d
          ≤ (6 * B_dom ^ 2) ^ (2 : ℝ) := Real.rpow_le_rpow_of_exponent_le h1_le_6B2 hd₂
        _ = (6 * B_dom ^ 2) ^ (2 : ℕ) := Real.rpow_natCast _ 2
        _ = 36 * B_dom ^ 4 := by ring
    by_cases h_le1 : 6 * B_dom ^ 2 * R' ≤ 1
    · have h_sub : (∑ i : Fin N_P, if ‖y_P i - z'‖ < R' then μ i else 0) ≤
          ∑ i : Fin N_P, if ‖x_P i - z‖ < 6 * B_dom ^ 2 * R' then μ i else 0 := by
        refine Finset.sum_le_sum (fun i _ => ?_)
        split_ifs with h_y h_x
        · exact le_rfl
        · exact absurd (h_imp i h_y) h_x
        · exact hμ_nn i
        · exact le_rfl
      have h_ρ_le : ρ ≤ 6 * B_dom ^ 2 * R' := by
        calc ρ ≤ 1 * R' := by rw [one_mul]; exact hR'
          _ ≤ 6 * B_dom ^ 2 * R' := mul_le_mul_of_nonneg_right h1_le_6B2 hR'_pos.le
      have h_xb := hx_ball z (6 * B_dom ^ 2 * R') h_ρ_le h_le1
      rw [Real.mul_rpow (by positivity) hR'_pos.le] at h_xb
      calc (∑ i : Fin N_P, if ‖y_P i - z'‖ < R' then μ i else 0)
          ≤ ρ ^ (-η) * ((6 * B_dom ^ 2) ^ d * R' ^ d) := le_trans h_sub h_xb
        _ ≤ ρ ^ (-η) * (36 * B_dom ^ 4 * R' ^ d) := by
            refine mul_le_mul_of_nonneg_left ?_ (Real.rpow_nonneg hρ.le _)
            exact mul_le_mul_of_nonneg_right h6Bd_le (Real.rpow_nonneg hR'_pos.le _)
        _ = 36 * B_dom ^ 4 * ρ ^ (-η) * R' ^ d := by ring
    · have h_gt1 : 1 ≤ 6 * B_dom ^ 2 * R' := le_of_not_ge h_le1
      have h_le_sum : (∑ i : Fin N_P, if ‖y_P i - z'‖ < R' then μ i else 0) ≤ 1 := by
        calc (∑ i : Fin N_P, if ‖y_P i - z'‖ < R' then μ i else 0)
            ≤ ∑ i : Fin N_P, μ i := Finset.sum_le_sum (fun i _ => by
              split_ifs; exact le_rfl; exact hμ_nn i)
          _ = 1 := hμ_sum
      have h1_le_ρη : 1 ≤ ρ ^ (-η) := by
        calc (1 : ℝ) = ρ ^ (0 : ℝ) := (Real.rpow_zero ρ).symm
          _ ≤ ρ ^ (-η) := Real.rpow_le_rpow_of_exponent_ge hρ hρ_lt_one.le (by linarith only [hη_pos])
      have h1_le_rpow : 1 ≤ 36 * B_dom ^ 4 * R' ^ d := by
        calc (1 : ℝ) = (1 : ℝ) ^ d := (Real.one_rpow d).symm
          _ ≤ (6 * B_dom ^ 2 * R') ^ d := Real.rpow_le_rpow zero_le_one h_gt1 hd₀.le
          _ = (6 * B_dom ^ 2) ^ d * R' ^ d := Real.mul_rpow (by positivity) hR'_pos.le
          _ ≤ 36 * B_dom ^ 4 * R' ^ d :=
              mul_le_mul_of_nonneg_right h6Bd_le (Real.rpow_nonneg hR'_pos.le _)
      calc (∑ i : Fin N_P, if ‖y_P i - z'‖ < R' then μ i else 0)
          ≤ 1 := h_le_sum
        _ = 1 * 1 := (mul_one 1).symm
        _ ≤ ρ ^ (-η) * (36 * B_dom ^ 4 * R' ^ d) :=
            mul_le_mul h1_le_ρη h1_le_rpow zero_le_one (Real.rpow_nonneg hρ.le _)
        _ = 36 * B_dom ^ 4 * ρ ^ (-η) * R' ^ d := by ring

  have ha_sl_ball : ∀ (a'₀ R' : ℝ), ρ ≤ R' →
      (∑ j : Fin N_B, if |a_sl j - a'₀| < R' then ν j else 0) ≤
        2 * B_dom * ρ ^ (-η) * R' ^ s := by
    intro a'₀ R' hR'
    have hR'_pos : 0 < R' := lt_of_lt_of_le hρ hR'
    let a₀ := 2 * B_dom * a'₀
    have h_imp : ∀ j : Fin N_B, |a_sl j - a'₀| < R' → |a_B j - a₀| < 2 * B_dom * R' := by
      intro j hj
      have h_eq : a_B j - a₀ = 2 * B_dom * (a_sl j - a'₀) := by
        dsimp [a_sl, a₀]
        field_simp [hB_pos.ne']
      rw [h_eq, abs_mul, abs_of_pos (by positivity : 0 < 2 * B_dom)]
      exact mul_lt_mul_of_pos_left hj (by positivity)
    have h1_le_2B : 1 ≤ 2 * B_dom := by linarith only [hB]
    have h2Bs_le : (2 * B_dom) ^ s ≤ 2 * B_dom := by
      calc (2 * B_dom) ^ s
          ≤ (2 * B_dom) ^ (1 : ℝ) := Real.rpow_le_rpow_of_exponent_le h1_le_2B hs₁
        _ = 2 * B_dom := Real.rpow_one _
    by_cases h_le1 : 2 * B_dom * R' ≤ 1
    · have h_sub : (∑ j : Fin N_B, if |a_sl j - a'₀| < R' then ν j else 0) ≤
          ∑ j : Fin N_B, if |a_B j - a₀| < 2 * B_dom * R' then ν j else 0 := by
        refine Finset.sum_le_sum (fun j _ => ?_)
        split_ifs with h1 h2
        · exact le_rfl
        · exact absurd (h_imp j h1) h2
        · exact hν_nn j
        · exact le_rfl
      have h_ρ_le : ρ ≤ 2 * B_dom * R' := by
        calc ρ ≤ 1 * R' := by rw [one_mul]; exact hR'
          _ ≤ 2 * B_dom * R' := mul_le_mul_of_nonneg_right h1_le_2B hR'_pos.le
      have h_ab := ha_ball a₀ (2 * B_dom * R') h_ρ_le h_le1
      rw [Real.mul_rpow (by positivity) hR'_pos.le] at h_ab
      calc (∑ j : Fin N_B, if |a_sl j - a'₀| < R' then ν j else 0)
          ≤ ρ ^ (-η) * ((2 * B_dom) ^ s * R' ^ s) := le_trans h_sub h_ab
        _ ≤ ρ ^ (-η) * (2 * B_dom * R' ^ s) := by
            refine mul_le_mul_of_nonneg_left ?_ (Real.rpow_nonneg hρ.le _)
            exact mul_le_mul_of_nonneg_right h2Bs_le (Real.rpow_nonneg hR'_pos.le _)
        _ = 2 * B_dom * ρ ^ (-η) * R' ^ s := by ring
    · have h_gt1 : 1 ≤ 2 * B_dom * R' := le_of_not_ge h_le1
      have h_le_sum : (∑ j : Fin N_B, if |a_sl j - a'₀| < R' then ν j else 0) ≤ 1 := by
        calc (∑ j : Fin N_B, if |a_sl j - a'₀| < R' then ν j else 0)
            ≤ ∑ j : Fin N_B, ν j := Finset.sum_le_sum (fun j _ => by
              split_ifs; exact le_rfl; exact hν_nn j)
          _ = 1 := hν_sum
      have h1_le_ρη : 1 ≤ ρ ^ (-η) := by
        calc (1 : ℝ) = ρ ^ (0 : ℝ) := (Real.rpow_zero ρ).symm
          _ ≤ ρ ^ (-η) := Real.rpow_le_rpow_of_exponent_ge hρ hρ_lt_one.le (by linarith only [hη_pos])
      have h1_le_rpow : 1 ≤ 2 * B_dom * R' ^ s := by
        calc (1 : ℝ) = (1 : ℝ) ^ s := (Real.one_rpow s).symm
          _ ≤ (2 * B_dom * R') ^ s := Real.rpow_le_rpow zero_le_one h_gt1 hs₀.le
          _ = (2 * B_dom) ^ s * R' ^ s := Real.mul_rpow (by positivity) hR'_pos.le
          _ ≤ 2 * B_dom * R' ^ s :=
              mul_le_mul_of_nonneg_right h2Bs_le (Real.rpow_nonneg hR'_pos.le _)
      calc (∑ j : Fin N_B, if |a_sl j - a'₀| < R' then ν j else 0)
          ≤ 1 := h_le_sum
        _ = 1 * 1 := (mul_one 1).symm
        _ ≤ ρ ^ (-η) * (2 * B_dom * R' ^ s) :=
            mul_le_mul h1_le_ρη h1_le_rpow zero_le_one (Real.rpow_nonneg hρ.le _)
        _ = 2 * B_dom * ρ ^ (-η) * R' ^ s := by ring

  let S_orig : Fin N_B → Finset ℝ := fun j => Classical.choose (h_cov j)
  have hS_orig_spec : ∀ j : Fin N_B, ((S_orig j).card : ℝ) ≤ M ∧
      ∀ i : Fin N_P, G i j →
        ∃ c₀ ∈ S_orig j, |(x_P i 1 - a_B j * x_P i 0) - c₀| ≤ C_cov * ρ :=
    fun j => Classical.choose_spec (h_cov j)
  let S_tilde : Fin N_B → Finset ℝ := fun j =>
    (S_orig j).image (fun c₀ => c₀ / (6 * B_dom ^ 2) + (2 * B_dom - a_B j) / (6 * B_dom))
  have hS_tilde_card : ∀ j : Fin N_B, ((S_tilde j).card : ℝ) ≤ M := by
    intro j
    exact le_trans (by exact_mod_cast Finset.card_image_le) (hS_orig_spec j).1
  have hS_tilde_cov : ∀ (i : Fin N_P) (j : Fin N_B), G i j →
      ∃ c_t ∈ S_tilde j, |(y_P i 1 - a_sl j * y_P i 0) - c_t| ≤ C_cov * ρ := by
    intro i j hGij
    obtain ⟨c₀, hc₀_mem, hc₀_est⟩ := (hS_orig_spec j).2 i hGij
    refine ⟨c₀ / (6 * B_dom ^ 2) + (2 * B_dom - a_B j) / (6 * B_dom),
      Finset.mem_image_of_mem _ hc₀_mem, ?_⟩
    have h_id : (y_P i 1 - a_sl j * y_P i 0) -
        (c₀ / (6 * B_dom ^ 2) + (2 * B_dom - a_B j) / (6 * B_dom)) =
        ((x_P i 1 - a_B j * x_P i 0) - c₀) / (6 * B_dom ^ 2) := by
      rw [hy_P0, hy_P1]
      dsimp [a_sl]
      field_simp [hB_pos.ne']
      ring
    rw [h_id, abs_div, abs_of_pos (by positivity : 0 < 6 * B_dom ^ 2)]
    calc |(x_P i 1 - a_B j * x_P i 0) - c₀| / (6 * B_dom ^ 2)
        ≤ (C_cov * ρ) / (6 * B_dom ^ 2) :=
          div_le_div_of_nonneg_right hc₀_est (by positivity)
      _ ≤ (C_cov * ρ) / 1 :=
