      split_ifs with h
      · rw [one_mul, abs_of_nonneg h]
      · rw [neg_one_mul, abs_of_neg (lt_of_not_ge h)]
    refine ⟨ε_sgn, hε_cases, ?_⟩
    let x_line : ℝ → EuclideanSpace ℝ (Fin 2) := fun y => x₀ + (s * y) • τ_P
    let v_seg : ℝ → EuclideanSpace ℝ (Fin 2) := fun τ => v' + τ • δ
    have hx_cd : ∀ k : ℕ, ContDiff ℝ k x_line := fun k =>
