      have hm_U₂_cs : m_set o U₂ ≤ (I₂.card : ℝ) * ∑ k₂ ∈ I₂, m_set o (F₂ k₂) := by
        have h_disj_I₂ : ∀ k₂ ∈ I₂, ∀ k₂' ∈ I₂, k₂ ≠ k₂' → Disjoint (F₂ k₂) (F₂ k₂') :=
