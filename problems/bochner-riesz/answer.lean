            simp
            ring
        have hP_arg : P_fn s = P₀ - (c * ρ₀ * s) • e := by
          ext i
          dsimp only [P_fn, v_fn, P₀, V_base]
          simp only [PiLp.add_apply, PiLp.sub_apply, PiLp.smul_apply, smul_eq_mul]
          ring
        dsimp only [H, f_vec, Pi.sub_apply]
        rw [h_arg, hP_arg, ContinuousLinearMap.map_sub, ContinuousLinearMap.map_smul,
          inner_sub_left, real_inner_smul_left]
        calc (lam_sys * ρ₀) *
              (inner ℝ ((M (Λ_τ s + q_τ)) P₀) w - (c * ρ₀ * s) * inner ℝ ((M (Λ_τ s + q_τ)) e) w)
