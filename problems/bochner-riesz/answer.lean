    have hq_le : sub.loc_idx.1 + 1 ≤ 2 ^ m_r := hqr_lt
    have hq_r : (sub.loc_idx.1 : ℝ) + 1 ≤ (2 : ℝ) ^ m_r := by exact_mod_cast hq_le
    calc ((sub.loc_idx.1 : ℝ) + 1 / 2) * ((2 : ℝ) ^ m_r)⁻¹
        ≤ ((2 : ℝ) ^ m_r) * ((2 : ℝ) ^ m_r)⁻¹ :=
