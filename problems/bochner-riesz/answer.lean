        have hJ_card : (J_bdry.card : ℝ) ≤ 416 * C_cov * ε ^ (-(5 / 4 : ℝ) * h) := by
          have h_nn1 : 0 ≤ 2 * (C_cov * ε ^ (-h)) + 3 :=
            add_nonneg (mul_nonneg (by norm_num) (mul_nonneg hC_cov_pos.le (Real.rpow_nonneg hε₀.le _)))
