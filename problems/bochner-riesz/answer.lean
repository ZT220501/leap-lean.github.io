      intro y j hj
      have h1 : (j : ℝ) ≤ y / s_M := by rw [← hj]; exact Int.floor_le (y / s_M)
      have h2 : y / s_M < (j : ℝ) + 1 := by rw [← hj]; exact Int.lt_floor_add_one (y / s_M)
      have hm1 := (le_div_iff₀ hs_M_pos).mp h1
      have hm2 := (div_lt_iff₀ hs_M_pos).mp h2
      exact abs_le.mpr ⟨by linarith only [hm1, hs_M_pos], by linarith only [hm2]⟩
    have h_card := h_cap_card_of_mem S 0 sub.b_loc R_U e_U V_U X_U
      le_rfl hb_loc0 hbloc_W hR_U_ge1 he_U ?_
    · have hpkt : pktWeight γ 0 sub.b_loc = (1 - γ) * sub.b_loc := by
        unfold pktWeight; ring
      rwa [hpkt] at h_card
    · intro α hα
      obtain ⟨α₀, d₀, hm_eq, hu_eq, hcomp₀⟩ := hS α hα
      obtain ⟨hv_n, hx_n, _, _, _, _, _, _⟩ := hsub_at α
      obtain ⟨hv0_n, hx0_n, _, _, _, _, _, _⟩ := hsub_at α₀
      obtain ⟨hv0_tr, hx0_tr⟩ := h_compat_trans α₀ d₀ hcomp₀
      have hm_v : roundShift2D s_M 0 (V'_at α₀) = roundShift2D s_M 0 (V'_at α) :=
        congrArg Prod.fst hm_eq
      have hm_x : roundShift2D s_M 0 (X'_at α₀) = roundShift2D s_M 0 (X'_at α) :=
        congrArg Prod.snd hm_eq
      have hk_u : roundShift2D ((1 / 4 : ℝ) * s_M) 0 (e_D d₀) = u.1 :=
        congrArg Prod.fst hu_eq
      have hj_v : Int.floor (v_perp_fn d₀ / s_M) = u.2.1 :=
        congrArg (fun q => q.2.1) hu_eq
      have hj_x : Int.floor (x_perp_fn d₀ / s_M) = u.2.2 :=
        congrArg (fun q => q.2.2) hu_eq
      have hn_diff : ‖n_U - perp2D (e_D d₀)‖ ≤ s_M := by
        have h_ed := (h_et_round (e_D d₀) (hd_adm d₀).2.2.2).2
        dsimp only [n_U, e_U, e_tilde] at h_ed ⊢
        rwa [hk_u] at h_ed
      refine ⟨?_, ?_, ?_, ?_⟩
      · rw [Real.rpow_zero, mul_one]
        refine le_trans (h_par_proj (V'_at α) e_U ((u.2.1 : ℝ) * s_M) he_U) ?_
        dsimp only [R_U]; linarith only [hv_n, hB_sys2, hR_win2, hML_nn]
      · change |inner ℝ (V'_at α - V_U) n_U| ≤ R_U * s_M
        rw [show inner ℝ (V'_at α - V_U) n_U = inner ℝ (V'_at α) n_U - (u.2.1 : ℝ) * s_M from
          h_perp_proj (V'_at α) e_U ((u.2.1 : ℝ) * s_M) he_U]
        have h_4hop : inner ℝ (V'_at α) n_U - (u.2.1 : ℝ) * s_M =
            ((inner ℝ (V'_at α - V'_at α₀) n_U +
              inner ℝ (V'_at α₀) (n_U - perp2D (e_D d₀))) +
              (inner ℝ (V'_at α₀) (perp2D (e_D d₀)) - v_perp_fn d₀)) +
              (v_perp_fn d₀ - (u.2.1 : ℝ) * s_M) := by
          rw [inner_sub_left, inner_sub_right]; ring
        have h1 : |inner ℝ (V'_at α - V'_at α₀) n_U| ≤ 2 * s_M := by
          calc |inner ℝ (V'_at α - V'_at α₀) n_U|
              ≤ ‖V'_at α - V'_at α₀‖ * ‖n_U‖ := abs_real_inner_le_norm _ _
            _ = ‖V'_at α - V'_at α₀‖ := by rw [hn_U, mul_one]
            _ ≤ 2 * s_M := h_rs_dist (V'_at α) (V'_at α₀) hm_v
        have h2 : |inner ℝ (V'_at α₀) (n_U - perp2D (e_D d₀))| ≤
            (4 * cls.B_sys + cls.R_win + 4) * s_M := by
          calc |inner ℝ (V'_at α₀) (n_U - perp2D (e_D d₀))|
              ≤ ‖V'_at α₀‖ * ‖n_U - perp2D (e_D d₀)‖ := abs_real_inner_le_norm _ _
            _ ≤ (4 * cls.B_sys + cls.R_win + 4) * s_M :=
                mul_le_mul hv0_n hn_diff (norm_nonneg _) (by linarith only [hB_sys2, hR_win2])
        have h3 : |inner ℝ (V'_at α₀) (perp2D (e_D d₀)) - v_perp_fn d₀| ≤
            (2 * (M_L : ℝ) + cls.B_sys) * s_M :=
          le_trans hv0_tr (mul_le_mul_of_nonneg_left hrpow_e2z_sM (by linarith only [hML_nn, hB_sys2]))
        have h4 : |v_perp_fn d₀ - (u.2.1 : ℝ) * s_M| ≤ s_M := h_fl_err (v_perp_fn d₀) u.2.1 hj_v
        rw [h_4hop]
        have h_abs := le_trans (abs_add_le _ _)
          (add_le_add (le_trans (abs_add_le _ _)
            (add_le_add (le_trans (abs_add_le _ _) (add_le_add h1 h2)) h3)) h4)
        refine le_trans h_abs ?_
        have hcoef : 5 * cls.B_sys + cls.R_win + 2 * (M_L : ℝ) + 7 ≤ R_U := by
          dsimp only [R_U]; linarith only [hB_sys2, hR_win2]
        nlinarith only [hcoef, hs_M_pos]
      · rw [Real.rpow_zero, mul_one]
        refine le_trans (h_par_proj (X'_at α) e_U ((u.2.2 : ℝ) * s_M) he_U) ?_
        dsimp only [R_U]; linarith only [hx_n, hB_sys2, hML_nn]
      · change |inner ℝ (X'_at α - X_U) n_U| ≤ R_U * s_M
        rw [show inner ℝ (X'_at α - X_U) n_U = inner ℝ (X'_at α) n_U - (u.2.2 : ℝ) * s_M from
          h_perp_proj (X'_at α) e_U ((u.2.2 : ℝ) * s_M) he_U]
        have h_4hop : inner ℝ (X'_at α) n_U - (u.2.2 : ℝ) * s_M =
            ((inner ℝ (X'_at α - X'_at α₀) n_U +
              inner ℝ (X'_at α₀) (n_U - perp2D (e_D d₀))) +
              (inner ℝ (X'_at α₀) (perp2D (e_D d₀)) - x_perp_fn d₀)) +
              (x_perp_fn d₀ - (u.2.2 : ℝ) * s_M) := by
          rw [inner_sub_left, inner_sub_right]; ring
        have h1 : |inner ℝ (X'_at α - X'_at α₀) n_U| ≤ 2 * s_M := by
          calc |inner ℝ (X'_at α - X'_at α₀) n_U|
              ≤ ‖X'_at α - X'_at α₀‖ * ‖n_U‖ := abs_real_inner_le_norm _ _
            _ = ‖X'_at α - X'_at α₀‖ := by rw [hn_U, mul_one]
            _ ≤ 2 * s_M := h_rs_dist (X'_at α) (X'_at α₀) hm_x
        have h2 : |inner ℝ (X'_at α₀) (n_U - perp2D (e_D d₀))| ≤
            (8 * cls.B_sys + 2 * cls.R_win + 10) * s_M := by
          calc |inner ℝ (X'_at α₀) (n_U - perp2D (e_D d₀))|
              ≤ ‖X'_at α₀‖ * ‖n_U - perp2D (e_D d₀)‖ := abs_real_inner_le_norm _ _
            _ ≤ (8 * cls.B_sys + 2 * cls.R_win + 10) * s_M :=
                mul_le_mul hx0_n hn_diff (norm_nonneg _) (by linarith only [hB_sys2, hR_win2])
        have h3 : |inner ℝ (X'_at α₀) (perp2D (e_D d₀)) - x_perp_fn d₀| ≤
            (2 * (M_L : ℝ) + 2 * cls.B_sys) * s_M :=
          le_trans hx0_tr (mul_le_mul_of_nonneg_left hrpow_e2z_sM (by linarith only [hML_nn, hB_sys2]))
        have h4 : |x_perp_fn d₀ - (u.2.2 : ℝ) * s_M| ≤ s_M := h_fl_err (x_perp_fn d₀) u.2.2 hj_x
        rw [h_4hop]
        have h_abs := le_trans (abs_add_le _ _)
          (add_le_add (le_trans (abs_add_le _ _)
            (add_le_add (le_trans (abs_add_le _ _) (add_le_add h1 h2)) h3)) h4)
        refine le_trans h_abs ?_
        dsimp only [R_U]; linarith only
  exact ⟨⟨he_bloc, haloc_hi⟩, h_c2, h_c3, h_c4, h_c5⟩

theorem contributor_cramer_strip_entropy_exclusion (γ ε h e₀ ζ_sh ξ b_star b_ref a_ref m_bin g_bin b_loc a_loc : ℝ)
    (N_O N_D N_ret N_all N_R : ℕ)
    (K_fac C_R C_E C_D C_DE C_U : ℝ)
    (p_cond : Fin N_O → Fin N_D → ℝ) (m_O : Fin N_O → ℝ)
    (b_D a_D : Fin N_D → ℝ)
    (P_obs : Fin N_O → ℕ × (ℤ × ℤ) × (ℤ × ℤ))
    (P_at : Fin N_ret → ℕ × (ℤ × ℤ) × (ℤ × ℤ))
    (rv_O : Fin N_O → Fin N_R) (rv_D : Fin N_D → Fin N_R)
    (cap_fn : Fin N_ret → ℕ)
    (m_fn : Fin N_ret → (ℤ × ℤ) × (ℤ × ℤ))
    (u_fn : Fin N_D → (ℤ × ℤ) × ℤ × ℤ)
    (hγ₀ : 0 < γ) (hγ₁ : γ < 1) (hε₀ : 0 < ε) (hε₁ : ε < 1 / 2)
    (hh : 0 < h) (hm_bin : 0 < m_bin)
    (hN_ret : 1 ≤ N_ret) (hN_all : 1 ≤ N_all) (hN_R : 1 ≤ N_R)
    (hK_fac : 1 ≤ K_fac) (hC_R : 1 ≤ C_R) (hC_E : 1 ≤ C_E)
    (hC_D : 1 ≤ C_D) (hC_DE : 1 ≤ C_DE) (hC_U : 1 ≤ C_U)
    (hb_bref : |b_star - b_ref| ≤ ζ_sh)
    (he_bloc : e₀ - h - 2 * ζ_sh ≤ (a_ref - b_star) - b_loc)
    (haloc_hi : a_loc ≤ (a_ref - b_star) + h + 2 * ζ_sh)
    (hp_nn : ∀ o d, 0 ≤ p_cond o d) (hp_sum : ∑ o : Fin N_O, ∑ d : Fin N_D, p_cond o d = 1)
    (hm_pos : ∀ o : Fin N_O, (0 < ∑ d : Fin N_D, p_cond o d) → 0 < m_O o)
    (h_act_ba_r : ∀ o d, 0 < p_cond o d →
      |b_D d - b_ref| ≤ ζ_sh ∧ |a_D d - a_ref| ≤ ζ_sh ∧ rv_O o = rv_D d)
    (hNR_bd : (N_R : ℝ) ≤ C_R * ε ^ (-(2 * h)))
    (hNE_bd : ((Finset.univ.image cap_fn).card : ℝ) ≤
      C_E * (N_all : ℝ) * ε ^ (g_bin - pktWeight γ b_loc a_loc - 2 * ξ))
    (h625 : ∀ (c : ℕ) (S : Finset (Fin N_ret)),
      (∀ α ∈ S, cap_fn α = c) → ((S.image m_fn).card : ℝ) ≤ 625)
    (h_fib_mass : ∀ (p_buf : ℕ × (ℤ × ℤ) × (ℤ × ℤ)) (rv : Fin N_R)
      (S_obs : Finset (Fin N_O)) (T_P : Finset (Fin N_ret)),
      (∀ o ∈ S_obs, (0 < ∑ d, p_cond o d) ∧ P_obs o = p_buf ∧ rv_O o = rv) →
      (∀ α : Fin N_ret, P_at α = p_buf ↔ α ∈ T_P) →
      S_obs.Nonempty →
      T_P.Nonempty ∧
      ∑ o ∈ S_obs, m_O o ≤ K_fac * ε ^ (-(5 / 4 : ℝ) * h - ξ) * m_bin * (T_P.card : ℝ))
    (h_fib_D : ∀ (d : Fin N_D) (S : Finset (Fin N_ret)),
      (∀ α ∈ S, ∃ o : Fin N_O, P_at α = P_obs o ∧ 0 < p_cond o d) →
      (S.card : ℝ) ≤ C_D * ε ^ (-g_bin + (1 - γ) * ((a_ref - b_star) - 2 * ζ_sh) - 2 * ξ))
    (h_fib_DE : ∀ (d : Fin N_D) (c : ℕ) (S : Finset (Fin N_ret)),
      (∀ α ∈ S, cap_fn α = c ∧ ∃ o : Fin N_O, P_at α = P_obs o ∧ 0 < p_cond o d) →
      (S.card : ℝ) ≤ C_DE * ε ^ (-g_bin + 2 * ((a_ref - b_star) - h - 2 * ζ_sh) - 2 * ξ))
    (h_fib_U : ∀ (u : (ℤ × ℤ) × ℤ × ℤ) (S : Finset (Fin N_ret)),
      (∀ α ∈ S, ∃ (α₀ : Fin N_ret) (d₀ : Fin N_D),
        m_fn α₀ = m_fn α ∧ u_fn d₀ = u ∧
        ∃ o : Fin N_O, P_at α₀ = P_obs o ∧ 0 < p_cond o d₀) →
      (S.card : ℝ) ≤ C_U * ε ^ (-g_bin + (1 - γ) * b_loc - 2 * ξ))
    (h_ent_eps :
      let ell := Real.log (ε⁻¹)
      (∀ {N_O' N_D' N_Z N_T N_R' : ℕ} (p : Fin N_O' → Fin N_D' → ℝ) (m : Fin N_O' → ℝ)
         (Z_of : Fin N_O' → Fin N_Z) (r_Z : Fin N_Z → Fin N_R') (r_D' : Fin N_D' → Fin N_R')
         (T_of_Z : Fin N_Z → Finset (Fin N_T)) {K_mass : ℝ} {M_amb : ℕ},
         0 < K_mass → 1 ≤ M_amb →
         (∀ o d, 0 ≤ p o d) → (∑ o : Fin N_O', ∑ d : Fin N_D', p o d = 1) →
         (∀ o, (0 < ∑ d : Fin N_D', p o d) → 0 < m o) →
         (∀ o d, 0 < p o d → r_Z (Z_of o) = r_D' d) →
         (letI := Classical.propDecidable
          ∀ z : Fin N_Z, (0 < ∑ o ∈ Finset.univ.filter (fun o => Z_of o = z), ∑ d, p o d) →
            (T_of_Z z).Nonempty ∧
            (∑ o ∈ Finset.univ.filter (fun o => Z_of o = z),
              if 0 < ∑ d : Fin N_D', p o d then m o else 0) ≤
              K_mass * ((T_of_Z z).card : ℝ)) →
         (letI := Classical.propDecidable
          ∀ (α : Fin N_T) (rv : Fin N_R'),
            ((Finset.univ.filter (fun z : Fin N_Z => r_Z z = rv ∧ α ∈ T_of_Z z)).card : ℝ) ≤
              (M_amb : ℝ)) →
         letI := Classical.propDecidable
         let p_O' := fun o => ∑ d : Fin N_D', p o d
         let p_D' := fun d => ∑ o : Fin N_O', p o d
         let p_ZD := fun z d => ∑ o ∈ Finset.univ.filter (fun o => Z_of o = z), p o d
         let q := fun (z : Fin N_Z) (d : Fin N_D') (α : Fin N_T) =>
           if α ∈ T_of_Z z then p_ZD z d / ((T_of_Z z).card : ℝ) else 0
         let q_T := fun α => ∑ z, ∑ d, q z d α
         let q_TD := fun α d => ∑ z, q z d α
         let q_TR := fun α rv => ∑ z ∈ Finset.univ.filter (fun z => r_Z z = rv), ∑ d, q z d α
         (∀ z d α, 0 ≤ q z d α) ∧ (∑ z, ∑ d, ∑ α, q z d α = 1) ∧
         (∀ z d α, 0 < q z d α → α ∈ T_of_Z z ∧ ∃ o, Z_of o = z ∧ 0 < p o d) ∧
         ((∑ o, -(p_O' o * Real.log (p_O' o))) / ell +
          (1 / 2 : ℝ) * ((∑ o, ∑ d, -(p o d * Real.log (p o d / p_D' d))) / ell) +
          (3 / 2 : ℝ) * ((∑ o, p_O' o * Real.log (m o)) / ell) ≤
          (∑ α, -(q_T α * Real.log (q_T α))) / ell +
          (1 / 2 : ℝ) * ((∑ α, ∑ d, -(q_TD α d * Real.log (q_TD α d / p_D' d))) / ell) +
          (∑ α, ∑ rv, -(q_TR α rv * Real.log (q_TR α rv / q_T α))) / ell +
          (3 / 2 : ℝ) * (Real.log (M_amb : ℝ) / ell) +
          (3 / 2 : ℝ) * (Real.log K_mass / ell))) ∧
      (∀ {N_X N_Y : ℕ} (P : Fin N_X → Fin N_Y → ℝ) {B_fib : ℝ},
         0 < B_fib → (∀ x y, 0 ≤ P x y) → (∑ x, ∑ y, P x y = 1) →
         (letI := Classical.propDecidable
          ∀ y : Fin N_Y, (0 < ∑ x, P x y) →
            ((Finset.univ.filter (fun x : Fin N_X => 0 < P x y)).card : ℝ) ≤ B_fib) →
         let P_Y := fun y => ∑ x, P x y
         (∑ x, ∑ y, -(P x y * Real.log (P x y / P_Y y))) / ell ≤ Real.log B_fib / ell) ∧
      (∀ {N_T N_D' N_E N_M N_U : ℕ} (P : Fin N_T → Fin N_D' → ℝ)
         (E_of : Fin N_T → Fin N_E) (M_of : Fin N_T → Fin N_M) (U_of : Fin N_D' → Fin N_U)
         {K_EM : ℕ},
         1 ≤ N_E → 1 ≤ K_EM →
         (∀ α d, 0 ≤ P α d) → (∑ α, ∑ d, P α d = 1) →
         (letI := Classical.propDecidable
          ∀ e : Fin N_E,
            (((Finset.univ.filter (fun α => E_of α = e)).image M_of).card : ℝ) ≤ (K_EM : ℝ)) →
         letI := Classical.propDecidable
         let P_T := fun α => ∑ d, P α d
         let P_D := fun d => ∑ α, P α d
         let P_E := fun e => ∑ α ∈ Finset.univ.filter (fun α => E_of α = e), P_T α
         let P_DE := fun d e => ∑ α ∈ Finset.univ.filter (fun α => E_of α = e), P α d
         let P_M := fun m => ∑ α ∈ Finset.univ.filter (fun α => M_of α = m), P_T α
         let P_MU := fun m u =>
           ∑ α ∈ Finset.univ.filter (fun α => M_of α = m),
             ∑ d ∈ Finset.univ.filter (fun d => U_of d = u), P α d
         let Q_TU := fun α u =>
           if 0 < P_M (M_of α) then P_T α * (P_MU (M_of α) u / P_M (M_of α)) else 0
         let Q_U := fun u => ∑ α, Q_TU α u
         (∀ α u, 0 ≤ Q_TU α u) ∧ (∑ α, ∑ u, Q_TU α u = 1) ∧
         (∀ α u, 0 < Q_TU α u → 0 < P_T α ∧
           ∃ α₀ d₀, M_of α₀ = M_of α ∧ U_of d₀ = u ∧ 0 < P α₀ d₀) ∧
         ((∑ α, -(P_T α * Real.log (P_T α))) / ell - Real.log (N_E : ℝ) / ell ≤
           (∑ α, -(P_T α * Real.log (P_T α / P_E (E_of α)))) / ell) ∧
         (((∑ α, -(P_T α * Real.log (P_T α / P_E (E_of α)))) / ell -
           (∑ α, ∑ d, -(P α d * Real.log (P α d / P_DE d (E_of α)))) / ell) ≤
          ((∑ α, ∑ u, -(Q_TU α u * Real.log (Q_TU α u / Q_U u))) / ell -
           (∑ α, ∑ d, -(P α d * Real.log (P α d / P_D d))) / ell) +
          Real.log (K_EM : ℝ) / ell))) :
    let ell := Real.log (ε⁻¹)
    let p_O := fun o : Fin N_O => ∑ d : Fin N_D, p_cond o d
    let p_D := fun d : Fin N_D => ∑ o : Fin N_O, p_cond o d
    let P_score :=
      (∑ o, -(p_O o * Real.log (p_O o))) / ell +
      (1 / 2 : ℝ) * ((∑ o, ∑ d, -(p_cond o d * Real.log (p_cond o d / p_D d))) / ell) +
      (3 / 2 : ℝ) * ((∑ o, p_O o * Real.log (m_O o)) / ell) +
      (1 / 2 : ℝ) * (∑ d, p_D d * ((1 + γ) * b_D d + (1 - γ) * a_D d)) - b_star
    let A_proxy :=
      Real.log (N_ret : ℝ) / ell + (3 / 2 : ℝ) * (Real.log m_bin / ell) + (1 / 2 : ℝ) * g_bin
    2 * γ * e₀ ≤
      (Real.log ((N_all : ℝ) / (N_ret : ℝ)) / ell) +
      4 * (A_proxy - P_score) +
      ((37 / 2 : ℝ) + γ) * h +
      16 * ζ_sh + 14 * ξ +
      (6 * Real.log K_fac + 4 * Real.log C_R + Real.log C_E + Real.log C_D +
        Real.log C_DE + Real.log C_U + Real.log 625) / ell :=
by
  intro ell p_O p_D P_score A_proxy
  
  have hε_lt1 : ε < 1 := by linarith only [hε₁]
  have hell_pos : 0 < ell := Real.log_pos ((one_lt_inv₀ hε₀).mpr hε_lt1)
  have hell_ne : ell ≠ 0 := hell_pos.ne'
  have hζ_nn : 0 ≤ ζ_sh := le_trans (abs_nonneg (b_star - b_ref)) hb_bref
  have hpO_nn : ∀ o : Fin N_O, 0 ≤ p_O o :=
    fun o => Finset.sum_nonneg (fun d _ => hp_nn o d)
  have hpD_nn : ∀ d : Fin N_D, 0 ≤ p_D d :=
    fun d => Finset.sum_nonneg (fun o _ => hp_nn o d)
  have hpD_sum : ∑ d : Fin N_D, p_D d = 1 := by
    dsimp only [p_D]
    rw [Finset.sum_comm]
    exact hp_sum
  have h_log_eps_mul : ∀ {C : ℝ}, 0 < C → ∀ (X : ℝ),
      Real.log (C * ε ^ X) / ell = Real.log C / ell - X := by
    intro C hC X
    have hεX : 0 < ε ^ X := Real.rpow_pos_of_pos hε₀ X
    have hlog_eps : Real.log ε = -ell := by
      dsimp only [ell]
      rw [Real.log_inv]
      ring
    rw [Real.log_mul hC.ne' hεX.ne', Real.log_rpow hε₀ X, hlog_eps]
    field_simp [hell_ne]
    ring
  have h_sum_fib : ∀ {N K : ℕ} (g : Fin N → Fin K) (f : Fin N → ℝ)
      (dec : ∀ k : Fin K, DecidablePred (fun i : Fin N => g i = k)),
      ∑ k : Fin K, ∑ i ∈ @Finset.filter _ (fun i => g i = k) (dec k) Finset.univ, f i =
        ∑ i : Fin N, f i := by
    intro N K g f dec
    refine (Finset.sum_congr rfl (fun k _ => ?_)).trans (Finset.sum_fiberwise Finset.univ g f)
    congr 1
    convert rfl

  
  let e : ℝ := a_ref - b_star
  let W_term : ℝ :=
    (1 / 2 : ℝ) * (∑ d : Fin N_D, p_D d * ((1 + γ) * b_D d + (1 - γ) * a_D d)) - b_star
  have hW_bd : W_term ≤ (1 / 2 : ℝ) * (1 - γ) * e + 2 * ζ_sh := by
    have h_pt : ∀ d : Fin N_D,
        p_D d * ((1 + γ) * b_D d + (1 - γ) * a_D d) ≤
        p_D d * (2 * b_star + (1 - γ) * e + 4 * ζ_sh) := by
      intro d
      by_cases hpD0 : p_D d = 0
      · simp [hpD0]
      · have hpD_pos : 0 < p_D d := lt_of_le_of_ne (hpD_nn d) (Ne.symm hpD0)
        obtain ⟨o, _, hpod⟩ :=
          (Finset.sum_pos_iff_of_nonneg (fun o _ => hp_nn o d)).mp hpD_pos
        obtain ⟨hb_d, ha_d, _⟩ := h_act_ba_r o d hpod
        have hb1 := (abs_le.mp hb_d).2
        have hb2 := (abs_le.mp hb_bref).1
        have ha1 := (abs_le.mp ha_d).2
        have hb_le : b_D d ≤ b_star + 2 * ζ_sh := by linarith only [hb1, hb2]
        have ha_le : a_D d ≤ b_star + e + ζ_sh := by
          dsimp only [e]
          linarith only [ha1]
        have h_w : (1 + γ) * b_D d + (1 - γ) * a_D d ≤
            2 * b_star + (1 - γ) * e + 4 * ζ_sh := by
          nlinarith only [hγ₀, hγ₁, hζ_nn, hb_le, ha_le]
        exact mul_le_mul_of_nonneg_left h_w (hpD_nn d)
    have h_sum_le : ∑ d : Fin N_D, p_D d * ((1 + γ) * b_D d + (1 - γ) * a_D d) ≤
        2 * b_star + (1 - γ) * e + 4 * ζ_sh := by
      calc ∑ d : Fin N_D, p_D d * ((1 + γ) * b_D d + (1 - γ) * a_D d)
          ≤ ∑ d : Fin N_D, p_D d * (2 * b_star + (1 - γ) * e + 4 * ζ_sh) :=
            Finset.sum_le_sum (fun d _ => h_pt d)
        _ = (∑ d : Fin N_D, p_D d) * (2 * b_star + (1 - γ) * e + 4 * ζ_sh) :=
            (Finset.sum_mul _ _ _).symm
        _ = 2 * b_star + (1 - γ) * e + 4 * ζ_sh := by rw [hpD_sum, one_mul]
    have h_alg : (1 / 2 : ℝ) * (2 * b_star + (1 - γ) * e + 4 * ζ_sh) - b_star =
        (1 / 2 : ℝ) * (1 - γ) * e + 2 * ζ_sh := by ring
    dsimp only [W_term]
    linarith only [h_sum_le, h_alg]

  
  let ImgZ : Finset ((ℕ × (ℤ × ℤ) × (ℤ × ℤ)) × Fin N_R) :=
    Finset.univ.image (fun o : Fin N_O => (P_obs o, rv_O o))
  let N_Z : ℕ := ImgZ.card
  let eZ : ImgZ ≃ Fin N_Z := ImgZ.equivFin
  let Z_of : Fin N_O → Fin N_Z :=
    fun o => eZ ⟨(P_obs o, rv_O o), Finset.mem_image_of_mem _ (Finset.mem_univ o)⟩
  let p_of_Z : Fin N_Z → ℕ × (ℤ × ℤ) × (ℤ × ℤ) := fun z => (eZ.symm z).1.1
  let r_Z : Fin N_Z → Fin N_R := fun z => (eZ.symm z).1.2
  let T_of_Z : Fin N_Z → Finset (Fin N_ret) :=
    fun z => Finset.univ.filter (fun α : Fin N_ret => P_at α = p_of_Z z)
  have h_mem_TZ : ∀ (z : Fin N_Z) (α : Fin N_ret), α ∈ T_of_Z z ↔ P_at α = p_of_Z z := by
    intro z α
    simp only [T_of_Z, Finset.mem_filter, Finset.mem_univ, true_and]
  have hpZ_eq : ∀ o : Fin N_O, p_of_Z (Z_of o) = P_obs o := by
    intro o
    dsimp only [p_of_Z, Z_of]
    rw [eZ.symm_apply_apply]
  have hrZ_eq : ∀ o : Fin N_O, r_Z (Z_of o) = rv_O o := by
    intro o
    dsimp only [r_Z, Z_of]
    rw [eZ.symm_apply_apply]
  let ImgE : Finset ℕ := Finset.univ.image cap_fn
  let N_E : ℕ := ImgE.card
  let eE : ImgE ≃ Fin N_E := ImgE.equivFin
  let E_of : Fin N_ret → Fin N_E :=
    fun α => eE ⟨cap_fn α, Finset.mem_image_of_mem _ (Finset.mem_univ α)⟩
  have hE_eq : ∀ α : Fin N_ret, (eE.symm (E_of α)).1 = cap_fn α := by
    intro α
    dsimp only [E_of]
    rw [eE.symm_apply_apply]
  have hN_E : 1 ≤ N_E := by
    have hne : ImgE.Nonempty :=
      ⟨cap_fn ⟨0, by omega⟩, Finset.mem_image_of_mem _ (Finset.mem_univ _)⟩
    exact Finset.card_pos.mpr hne
  let ImgM : Finset ((ℤ × ℤ) × (ℤ × ℤ)) := Finset.univ.image m_fn
  let N_M : ℕ := ImgM.card
  let eM : ImgM ≃ Fin N_M := ImgM.equivFin
  let M_of : Fin N_ret → Fin N_M :=
    fun α => eM ⟨m_fn α, Finset.mem_image_of_mem _ (Finset.mem_univ α)⟩
  let g_M : Fin N_M → (ℤ × ℤ) × (ℤ × ℤ) := fun m => (eM.symm m).1
  have hgM_eq : ∀ α : Fin N_ret, g_M (M_of α) = m_fn α := by
    intro α
    dsimp only [g_M, M_of]
    rw [eM.symm_apply_apply]
  have hgM_inj : Function.Injective g_M := by
    intro m₁ m₂ h_eq
    exact eM.symm.injective (Subtype.ext h_eq)
  let m_img_std : Finset (Fin N_ret) → Finset ((ℤ × ℤ) × (ℤ × ℤ)) :=
    fun S => S.image m_fn
  let ImgU : Finset ((ℤ × ℤ) × ℤ × ℤ) := Finset.univ.image u_fn
  let N_U : ℕ := ImgU.card
  let eU : ImgU ≃ Fin N_U := ImgU.equivFin
  let U_of : Fin N_D → Fin N_U :=
    fun d => eU ⟨u_fn d, Finset.mem_image_of_mem _ (Finset.mem_univ d)⟩
  have hU_eq : ∀ d : Fin N_D, (eU.symm (U_of d)).1 = u_fn d := by
    intro d
    dsimp only [U_of]
    rw [eU.symm_apply_apply]

  let K_mass : ℝ := K_fac * ε ^ (-(5 / 4 : ℝ) * h - ξ) * m_bin
  have hK_fac_pos : 0 < K_fac := lt_of_lt_of_le zero_lt_one hK_fac
  have hK_mass_pos : 0 < K_mass :=
    mul_pos (mul_pos hK_fac_pos (Real.rpow_pos_of_pos hε₀ _)) hm_bin
  have h_rZ_sync : ∀ (o : Fin N_O) (d : Fin N_D), 0 < p_cond o d → r_Z (Z_of o) = rv_D d := by
    intro o d hpod
    rw [hrZ_eq o]
    exact (h_act_ba_r o d hpod).2.2

  letI := Classical.propDecidable
  have h_fib_z : ∀ z : Fin N_Z,
      (0 < ∑ o ∈ Finset.univ.filter (fun o : Fin N_O => Z_of o = z), ∑ d, p_cond o d) →
        (T_of_Z z).Nonempty ∧
        (∑ o ∈ Finset.univ.filter (fun o : Fin N_O => Z_of o = z),
          if 0 < ∑ d : Fin N_D, p_cond o d then m_O o else 0) ≤
          K_mass * ((T_of_Z z).card : ℝ) := by
    intro z hFz
    set F_z := Finset.univ.filter (fun o : Fin N_O => Z_of o = z)
    set S_obs := F_z.filter (fun o : Fin N_O => 0 < ∑ d : Fin N_D, p_cond o d)
    obtain ⟨o₁, ho₁_Fz, ho₁_pos⟩ :=
      (Finset.sum_pos_iff_of_nonneg (fun o _ => hpO_nn o)).mp hFz
    have hS_ne : S_obs.Nonempty := ⟨o₁, Finset.mem_filter.mpr ⟨ho₁_Fz, ho₁_pos⟩⟩
    have hS_cond : ∀ o ∈ S_obs,
        (0 < ∑ d, p_cond o d) ∧ P_obs o = p_of_Z z ∧ rv_O o = r_Z z := by
      intro o ho
      obtain ⟨ho_Fz, ho_pos⟩ := Finset.mem_filter.mp ho
      have hZo : Z_of o = z := (Finset.mem_filter.mp ho_Fz).2
      exact ⟨ho_pos, by rw [← hpZ_eq o, hZo], by rw [← hrZ_eq o, hZo]⟩
    have hT_iff : ∀ α : Fin N_ret, P_at α = p_of_Z z ↔ α ∈ T_of_Z z := by
      intro α
      simp only [T_of_Z, Finset.mem_filter, Finset.mem_univ, true_and]
    obtain ⟨hT_ne, h_mass_le⟩ :=
      h_fib_mass (p_of_Z z) (r_Z z) S_obs (T_of_Z z) hS_cond hT_iff hS_ne
    refine ⟨hT_ne, ?_⟩
    have h_sum_eq : (∑ o ∈ F_z, if 0 < ∑ d : Fin N_D, p_cond o d then m_O o else 0) =
        ∑ o ∈ S_obs, m_O o := (Finset.sum_filter _ _).symm
    rw [h_sum_eq]
    exact h_mass_le
  have h_amb_z : ∀ (α : Fin N_ret) (rv : Fin N_R),
      ((Finset.univ.filter (fun z : Fin N_Z => r_Z z = rv ∧ α ∈ T_of_Z z)).card : ℝ) ≤
        ((1 : ℕ) : ℝ) := by
    intro α rv
    exact_mod_cast Finset.card_le_one.mpr (by
      intro z₁ hz₁ z₂ hz₂
      obtain ⟨hr₁, hα₁⟩ := (Finset.mem_filter.mp hz₁).2
      obtain ⟨hr₂, hα₂⟩ := (Finset.mem_filter.mp hz₂).2
      have hp₁ : P_at α = p_of_Z z₁ := (h_mem_TZ z₁ α).mp hα₁
      have hp₂ : P_at α = p_of_Z z₂ := (h_mem_TZ z₂ α).mp hα₂
      have h_pair : (eZ.symm z₁).1 = (eZ.symm z₂).1 :=
        Prod.ext (hp₁.symm.trans hp₂) (hr₁.trans hr₂.symm)
      exact eZ.symm.injective (Subtype.ext h_pair))

  let p_ZD := fun (z : Fin N_Z) (d : Fin N_D) =>
    ∑ o ∈ Finset.univ.filter (fun o : Fin N_O => Z_of o = z), p_cond o d
  let q := fun (z : Fin N_Z) (d : Fin N_D) (α : Fin N_ret) =>
    if α ∈ T_of_Z z then p_ZD z d / ((T_of_Z z).card : ℝ) else 0
  let q_T := fun α : Fin N_ret => ∑ z : Fin N_Z, ∑ d : Fin N_D, q z d α
  let q_TD := fun (α : Fin N_ret) (d : Fin N_D) => ∑ z : Fin N_Z, q z d α
  let q_TR := fun (α : Fin N_ret) (rv : Fin N_R) =>
    ∑ z ∈ Finset.univ.filter (fun z : Fin N_Z => r_Z z = rv), ∑ d : Fin N_D, q z d α
  obtain ⟨hq_nn, hq_sum, hq_pos, h_bridge⟩ :=
    h_ent_eps.1 p_cond m_O Z_of r_Z rv_D T_of_Z
      hK_mass_pos (le_refl 1) hp_nn hp_sum hm_pos h_rZ_sync h_fib_z h_amb_z
  have hqT_nn : ∀ α : Fin N_ret, 0 ≤ q_T α :=
    fun α => Finset.sum_nonneg (fun z _ => Finset.sum_nonneg (fun d _ => hq_nn z d α))
  have hqTD_nn : ∀ (α : Fin N_ret) (d : Fin N_D), 0 ≤ q_TD α d :=
    fun α d => Finset.sum_nonneg (fun z _ => hq_nn z d α)
  have hqTR_nn : ∀ (α : Fin N_ret) (rv : Fin N_R), 0 ≤ q_TR α rv :=
    fun α rv => Finset.sum_nonneg (fun z _ => Finset.sum_nonneg (fun d _ => hq_nn z d α))
  have hqTD_marg_T : ∀ α : Fin N_ret, ∑ d : Fin N_D, q_TD α d = q_T α := by
    intro α
    dsimp only [q_TD, q_T]
    exact Finset.sum_comm
  have hqT_sum : ∑ α : Fin N_ret, q_T α = 1 := by
    dsimp only [q_T]
    calc ∑ α : Fin N_ret, ∑ z : Fin N_Z, ∑ d : Fin N_D, q z d α
        = ∑ z : Fin N_Z, ∑ α : Fin N_ret, ∑ d : Fin N_D, q z d α := Finset.sum_comm
      _ = ∑ z : Fin N_Z, ∑ d : Fin N_D, ∑ α : Fin N_ret, q z d α :=
          Finset.sum_congr rfl (fun z _ => Finset.sum_comm)
      _ = 1 := hq_sum
  have hqTD_sum : ∑ α : Fin N_ret, ∑ d : Fin N_D, q_TD α d = 1 := by
    simp_rw [hqTD_marg_T]
    exact hqT_sum
  have hqTR_marg_T : ∀ α : Fin N_ret, ∑ rv : Fin N_R, q_TR α rv = q_T α := by
    intro α
    dsimp only [q_TR, q_T]
    exact h_sum_fib r_Z (fun z => ∑ d : Fin N_D, q z d α) _
  have hqTD_marg_D : ∀ d : Fin N_D, ∑ α : Fin N_ret, q_TD α d = p_D d := by
    intro d
    dsimp only [q_TD]
    rw [Finset.sum_comm]
    have h_inner : ∀ z : Fin N_Z, ∑ α : Fin N_ret, q z d α = p_ZD z d := by
      intro z
      by_cases hpz0 : p_ZD z d = 0
      · dsimp only [q]
        simp [hpz0]
      · have hpz_nn : 0 ≤ p_ZD z d := Finset.sum_nonneg (fun o _ => hp_nn o d)
        have hpz_pos : 0 < p_ZD z d := lt_of_le_of_ne hpz_nn (Ne.symm hpz0)
        have hFz_pos : 0 < ∑ o ∈ Finset.univ.filter (fun o : Fin N_O => Z_of o = z),
            ∑ d' : Fin N_D, p_cond o d' := by
          have h_le : p_ZD z d ≤ ∑ d' : Fin N_D, p_ZD z d' :=
            Finset.single_le_sum (fun d' _ => Finset.sum_nonneg (fun o _ => hp_nn o d'))
              (Finset.mem_univ d)
          have h_comm : ∑ d' : Fin N_D, p_ZD z d' =
              ∑ o ∈ Finset.univ.filter (fun o : Fin N_O => Z_of o = z),
                ∑ d' : Fin N_D, p_cond o d' := by
            dsimp only [p_ZD]
            exact Finset.sum_comm
          linarith only [hpz_pos, h_le, h_comm]
        have hT_ne : (T_of_Z z).Nonempty := (h_fib_z z hFz_pos).1
        have hT_card_pos : 0 < ((T_of_Z z).card : ℝ) :=
          Nat.cast_pos.mpr (Finset.card_pos.mpr hT_ne)
        dsimp only [q]
        rw [← Finset.sum_filter]
        have h_filt : Finset.univ.filter (fun α : Fin N_ret => α ∈ T_of_Z z) = T_of_Z z := by
          ext α
          simp only [Finset.mem_filter, Finset.mem_univ, true_and]
        rw [h_filt, Finset.sum_const, nsmul_eq_mul, mul_div_cancel₀ _ hT_card_pos.ne']
    simp_rw [h_inner]
    dsimp only [p_ZD, p_D]
    exact h_sum_fib Z_of (fun o => p_cond o d) _
  have hqTD_compat : ∀ (α : Fin N_ret) (d : Fin N_D), 0 < q_TD α d →
      ∃ o : Fin N_O, P_at α = P_obs o ∧ 0 < p_cond o d := by
    intro α d hpos
    obtain ⟨z, _, hqz⟩ :=
      (Finset.sum_pos_iff_of_nonneg (fun z _ => hq_nn z d α)).mp hpos
    obtain ⟨hαT, o, hZo, hpod⟩ := hq_pos z d α hqz
    have hpα : P_at α = p_of_Z z := (h_mem_TZ z α).mp hαT
    exact ⟨o, by rw [hpα, ← hZo, hpZ_eq o], hpod⟩

  
  let H_T : ℝ := (∑ α : Fin N_ret, -(q_T α * Real.log (q_T α))) / ell
  let H_TD : ℝ :=
    (∑ α : Fin N_ret, ∑ d : Fin N_D, -(q_TD α d * Real.log (q_TD α d / p_D d))) / ell
  let H_RT : ℝ :=
    (∑ α : Fin N_ret, ∑ rv : Fin N_R, -(q_TR α rv * Real.log (q_TR α rv / q_T α))) / ell
  let A_gap : ℝ := Real.log (N_ret : ℝ) / ell - H_T
  let B_gap : ℝ := g_bin - (1 - γ) * e - H_TD
  let err_D : ℝ := 2 * (1 - γ) * ζ_sh + 2 * ξ + Real.log C_D / ell
  have hC_R_pos : 0 < C_R := lt_of_lt_of_le zero_lt_one hC_R
  have hC_D_pos : 0 < C_D := lt_of_lt_of_le zero_lt_one hC_D
  have hHRT_bd : H_RT ≤ Real.log C_R / ell + 2 * h := by
    let P_RT : Fin N_R → Fin N_ret → ℝ := fun rv α => q_TR α rv
    let B_RT : ℝ := C_R * ε ^ (-(2 * h))
    have hBRT_pos : 0 < B_RT := mul_pos hC_R_pos (Real.rpow_pos_of_pos hε₀ _)
    have hPRT_sum : ∑ rv : Fin N_R, ∑ α : Fin N_ret, P_RT rv α = 1 := by
      dsimp only [P_RT]
      rw [Finset.sum_comm]
      simp_rw [hqTR_marg_T]
      exact hqT_sum
    have hPRT_fib : ∀ α : Fin N_ret, (0 < ∑ rv : Fin N_R, P_RT rv α) →
        ((Finset.univ.filter (fun rv : Fin N_R => 0 < P_RT rv α)).card : ℝ) ≤ B_RT := by
      intro α _
      have h_card : (Finset.univ.filter (fun rv : Fin N_R => 0 < P_RT rv α)).card ≤ N_R := by
        calc (Finset.univ.filter (fun rv : Fin N_R => 0 < P_RT rv α)).card
            ≤ (Finset.univ : Finset (Fin N_R)).card := Finset.card_filter_le _ _
          _ = N_R := Finset.card_fin N_R
      exact le_trans (by exact_mod_cast h_card) hNR_bd
    have h_raw := h_ent_eps.2.1 P_RT hBRT_pos (fun rv α => hqTR_nn α rv) hPRT_sum hPRT_fib
    have h_lhs : (∑ rv : Fin N_R, ∑ α : Fin N_ret,
        -(P_RT rv α * Real.log (P_RT rv α / (∑ rv' : Fin N_R, P_RT rv' α)))) / ell = H_RT := by
      dsimp only [P_RT, H_RT]
      rw [Finset.sum_comm]
      simp_rw [hqTR_marg_T]
    have h_rhs : Real.log B_RT / ell = Real.log C_R / ell + 2 * h := by
      dsimp only [B_RT]
      rw [h_log_eps_mul hC_R_pos]
      ring
    linarith only [h_raw, h_lhs, h_rhs]
  have hN_ret_pos : 0 < (N_ret : ℝ) := Nat.cast_pos.mpr hN_ret
  have hAgap_nn : 0 ≤ A_gap := by
    let P_T1 : Fin N_ret → Fin 1 → ℝ := fun α _ => q_T α
    have hPT1_sum : ∑ α : Fin N_ret, ∑ y : Fin 1, P_T1 α y = 1 := by
      simp only [P_T1, Fin.sum_univ_one]
      exact hqT_sum
    have hPT1_fib : ∀ y : Fin 1, (0 < ∑ α : Fin N_ret, P_T1 α y) →
        ((Finset.univ.filter (fun α : Fin N_ret => 0 < P_T1 α y)).card : ℝ) ≤ (N_ret : ℝ) := by
      intro y _
      have h_card : (Finset.univ.filter (fun α : Fin N_ret => 0 < P_T1 α y)).card ≤ N_ret := by
        calc (Finset.univ.filter (fun α : Fin N_ret => 0 < P_T1 α y)).card
            ≤ (Finset.univ : Finset (Fin N_ret)).card := Finset.card_filter_le _ _
          _ = N_ret := Finset.card_fin N_ret
      exact_mod_cast h_card
    have h_raw := h_ent_eps.2.1 P_T1 hN_ret_pos (fun α _ => hqT_nn α) hPT1_sum hPT1_fib
    have h_lhs : (∑ α : Fin N_ret, ∑ y : Fin 1,
        -(P_T1 α y * Real.log (P_T1 α y / (∑ α' : Fin N_ret, P_T1 α' y)))) / ell = H_T := by
      dsimp only [P_T1, H_T]
      simp only [Fin.sum_univ_one, hqT_sum, div_one]
    dsimp only [A_gap]
    linarith only [h_raw, h_lhs]
  have hBgap_lo : 0 ≤ B_gap + err_D := by
    let B_D : ℝ := C_D * ε ^ (-g_bin + (1 - γ) * (e - 2 * ζ_sh) - 2 * ξ)
    have hBD_pos : 0 < B_D := mul_pos hC_D_pos (Real.rpow_pos_of_pos hε₀ _)
    have hqTD_fib : ∀ d : Fin N_D, (0 < ∑ α : Fin N_ret, q_TD α d) →
        ((Finset.univ.filter (fun α : Fin N_ret => 0 < q_TD α d)).card : ℝ) ≤ B_D := by
      intro d _
      refine h_fib_D d _ (fun α hα => ?_)
      exact hqTD_compat α d (Finset.mem_filter.mp hα).2
    have h_raw := h_ent_eps.2.1 q_TD hBD_pos hqTD_nn hqTD_sum hqTD_fib
    have h_lhs : (∑ α : Fin N_ret, ∑ d : Fin N_D,
        -(q_TD α d * Real.log (q_TD α d / (∑ α' : Fin N_ret, q_TD α' d)))) / ell = H_TD := by
      dsimp only [H_TD]
      simp_rw [hqTD_marg_D]
    have h_rhs : Real.log B_D / ell =
        Real.log C_D / ell + g_bin - (1 - γ) * (e - 2 * ζ_sh) + 2 * ξ := by
      dsimp only [B_D, e]
      rw [h_log_eps_mul hC_D_pos]
      ring
    have h_alg :
        g_bin - (1 - γ) * e -
          (Real.log C_D / ell + g_bin - (1 - γ) * (e - 2 * ζ_sh) + 2 * ξ) +
          (2 * (1 - γ) * ζ_sh + 2 * ξ + Real.log C_D / ell) = 0 := by ring
    dsimp only [B_gap, err_D]
    linarith only [h_raw, h_lhs, h_rhs, h_alg]

  let RHS_star : ℝ :=
    (A_proxy - P_score) + (31 / 8 : ℝ) * h + 2 * ζ_sh + (3 / 2 : ℝ) * ξ +
      (3 / 2 : ℝ) * (Real.log K_fac / ell) + Real.log C_R / ell
  have hHT_eq : H_T = Real.log (N_ret : ℝ) / ell - A_gap := by dsimp only [A_gap]; ring
  have hHTD_eq : H_TD = g_bin - (1 - γ) * e - B_gap := by dsimp only [B_gap]; ring
  have h_score_bridge : A_gap + (1 / 2 : ℝ) * B_gap ≤ RHS_star := by
    have h_log_1 : Real.log ((1 : ℕ) : ℝ) / ell = 0 := by simp
    have h_log_Kmass : Real.log K_mass / ell =
        Real.log K_fac / ell + (5 / 4 : ℝ) * h + ξ + Real.log m_bin / ell := by
      have h1_pos : 0 < K_fac * ε ^ (-(5 / 4 : ℝ) * h - ξ) :=
        mul_pos hK_fac_pos (Real.rpow_pos_of_pos hε₀ _)
      dsimp only [K_mass]
      rw [Real.log_mul h1_pos.ne' hm_bin.ne', add_div, h_log_eps_mul hK_fac_pos]
      ring
    change (∑ o : Fin N_O, -(p_O o * Real.log (p_O o))) / ell +
        (1 / 2 : ℝ) * ((∑ o : Fin N_O, ∑ d : Fin N_D,
          -(p_cond o d * Real.log (p_cond o d / p_D d))) / ell) +
        (3 / 2 : ℝ) * ((∑ o : Fin N_O, p_O o * Real.log (m_O o)) / ell) ≤
        H_T + (1 / 2 : ℝ) * H_TD + H_RT +
        (3 / 2 : ℝ) * (Real.log ((1 : ℕ) : ℝ) / ell) +
        (3 / 2 : ℝ) * (Real.log K_mass / ell) at h_bridge
    rw [h_log_1, h_log_Kmass, hHT_eq, hHTD_eq] at h_bridge
    have h_alg :
        (Real.log (N_ret : ℝ) / ell - A_gap) +
          (1 / 2 : ℝ) * (g_bin - (1 - γ) * e - B_gap) +
          (Real.log C_R / ell + 2 * h) +
          (3 / 2 : ℝ) * 0 +
          (3 / 2 : ℝ) * (Real.log K_fac / ell + (5 / 4 : ℝ) * h + ξ + Real.log m_bin / ell) +
          ((1 / 2 : ℝ) * (1 - γ) * e + 2 * ζ_sh) =
        A_proxy - (A_gap + (1 / 2 : ℝ) * B_gap) +
          (31 / 8 : ℝ) * h + 2 * ζ_sh + (3 / 2 : ℝ) * ξ +
          (3 / 2 : ℝ) * (Real.log K_fac / ell) + Real.log C_R / ell := by
      dsimp only [A_proxy]
      ring
    dsimp only [RHS_star, P_score, W_term] at hW_bd ⊢
    linarith only [h_bridge, hW_bd, hHRT_bd, h_alg]

  
  let P_DE : Fin N_D → Fin N_E → ℝ :=
    fun d e_idx => ∑ α ∈ Finset.univ.filter (fun α : Fin N_ret => E_of α = e_idx), q_TD α d
  let H_TDE : ℝ :=
    (∑ α : Fin N_ret, ∑ d : Fin N_D, -(q_TD α d * Real.log (q_TD α d / P_DE d (E_of α)))) / ell
  have hC_DE_pos : 0 < C_DE := lt_of_lt_of_le zero_lt_one hC_DE
  have hHTDE_bd : H_TDE ≤ Real.log C_DE / ell + g_bin - 2 * (e - h - 2 * ζ_sh) + 2 * ξ := by
    let P_TDE : Fin N_ret → Fin (N_D * N_E) → ℝ :=
      fun α y =>
        let de := finProdFinEquiv.symm y
        if E_of α = de.2 then q_TD α de.1 else 0
    let B_DE : ℝ := C_DE * ε ^ (-g_bin + 2 * (e - h - 2 * ζ_sh) - 2 * ξ)
    have hBDE_pos : 0 < B_DE := mul_pos hC_DE_pos (Real.rpow_pos_of_pos hε₀ _)
    have hPTDE_nn : ∀ α y, 0 ≤ P_TDE α y := by
      intro α y
      dsimp only [P_TDE]
      split_ifs
      · exact hqTD_nn α _
      · exact le_rfl
    have hPTDE_marg : ∀ y : Fin (N_D * N_E),
        ∑ α : Fin N_ret, P_TDE α y = P_DE (finProdFinEquiv.symm y).1 (finProdFinEquiv.symm y).2 := by
      intro y
      dsimp only [P_TDE, P_DE]
      rw [Finset.sum_filter]
    have hPTDE_sum : ∑ α : Fin N_ret, ∑ y : Fin (N_D * N_E), P_TDE α y = 1 := by
      have h_row : ∀ α : Fin N_ret, ∑ y : Fin (N_D * N_E), P_TDE α y = ∑ d : Fin N_D, q_TD α d := by
        intro α
        rw [← Equiv.sum_comp finProdFinEquiv (fun y => P_TDE α y), Fintype.sum_prod_type]
        refine Finset.sum_congr rfl (fun d _ => ?_)
        dsimp only [P_TDE]
        simp_rw [Equiv.symm_apply_apply]
        rw [Finset.sum_eq_single (E_of α)]
        · simp
        · intro e_idx _ hne
          exact if_neg (Ne.symm hne)
        · intro h_abs
          exact absurd (Finset.mem_univ (E_of α)) h_abs
      simp_rw [h_row]
      exact hqTD_sum
    have hPTDE_fib : ∀ y : Fin (N_D * N_E), (0 < ∑ α : Fin N_ret, P_TDE α y) →
        ((Finset.univ.filter (fun α : Fin N_ret => 0 < P_TDE α y)).card : ℝ) ≤ B_DE := by
      intro y _
      set de := finProdFinEquiv.symm y
      refine h_fib_DE de.1 (eE.symm de.2).1 _ (fun α hα => ?_)
      have hpos : 0 < P_TDE α y := (Finset.mem_filter.mp hα).2
      dsimp only [P_TDE] at hpos
      change 0 < (if E_of α = de.2 then q_TD α de.1 else 0) at hpos
      by_cases hE : E_of α = de.2
      · rw [if_pos hE] at hpos
        refine ⟨?_, hqTD_compat α de.1 hpos⟩
        rw [← hE_eq α, hE]
      · rw [if_neg hE] at hpos
        exact absurd hpos (lt_irrefl 0)
    have h_raw := h_ent_eps.2.1 P_TDE hBDE_pos hPTDE_nn hPTDE_sum hPTDE_fib
    have h_lhs : (∑ α : Fin N_ret, ∑ y : Fin (N_D * N_E),
        -(P_TDE α y * Real.log (P_TDE α y / (∑ α' : Fin N_ret, P_TDE α' y)))) / ell = H_TDE := by
      dsimp only [H_TDE]
      congr 1
      refine Finset.sum_congr rfl (fun α _ => ?_)
      simp_rw [hPTDE_marg]
      rw [← Equiv.sum_comp finProdFinEquiv
        (fun y => -(P_TDE α y * Real.log (P_TDE α y /
          P_DE (finProdFinEquiv.symm y).1 (finProdFinEquiv.symm y).2))),
        Fintype.sum_prod_type]
      refine Finset.sum_congr rfl (fun d _ => ?_)
      dsimp only [P_TDE]
      simp_rw [Equiv.symm_apply_apply]
      rw [Finset.sum_eq_single (E_of α)]
      · simp
      · intro e_idx _ hne
        rw [if_neg (Ne.symm hne)]
        simp
      · intro h_abs
        exact absurd (Finset.mem_univ (E_of α)) h_abs
    have h_rhs : Real.log B_DE / ell =
        Real.log C_DE / ell + g_bin - 2 * (e - h - 2 * ζ_sh) + 2 * ξ := by
      dsimp only [B_DE, e]
      rw [h_log_eps_mul hC_DE_pos]
      ring
    linarith only [h_raw, h_lhs, h_rhs]

  
  have h_625_fib : ∀ e_idx : Fin N_E,
      (((Finset.univ.filter (fun α : Fin N_ret => E_of α = e_idx)).image M_of).card : ℝ) ≤
        ((625 : ℕ) : ℝ) := by
    intro e_idx
    set S_e := Finset.univ.filter (fun α : Fin N_ret => E_of α = e_idx)
    set I_M := S_e.image M_of
    have h_cap_Se : ∀ α ∈ S_e, cap_fn α = (eE.symm e_idx).1 := by
      intro α hα
      have hEα : E_of α = e_idx := (Finset.mem_filter.mp hα).2
      rw [← hE_eq α, hEα]
    have h625_Se : ((m_img_std S_e).card : ℝ) ≤ 625 :=
      h625 (eE.symm e_idx).1 S_e h_cap_Se
    have h_img_eq : Finset.image g_M I_M = m_img_std S_e := by
      ext v
      simp only [m_img_std, I_M, Finset.mem_image]
      constructor
      · rintro ⟨m, ⟨α, hα, rfl⟩, rfl⟩
        exact ⟨α, hα, (hgM_eq α).symm⟩
      · rintro ⟨α, hα, rfl⟩
        exact ⟨M_of α, ⟨α, hα, rfl⟩, hgM_eq α⟩
    have h_card_eq : I_M.card = (m_img_std S_e).card := by
      rw [← h_img_eq, Finset.card_image_of_injective I_M hgM_inj]
    rw [h_card_eq]
    simpa using h625_Se

  let P_E : Fin N_E → ℝ :=
    fun e_idx => ∑ α ∈ Finset.univ.filter (fun α : Fin N_ret => E_of α = e_idx),
      (∑ d : Fin N_D, q_TD α d)
  let P_M : Fin N_M → ℝ :=
    fun m => ∑ α ∈ Finset.univ.filter (fun α : Fin N_ret => M_of α = m),
      (∑ d : Fin N_D, q_TD α d)
  let P_MU : Fin N_M → Fin N_U → ℝ :=
    fun m u =>
      ∑ α ∈ Finset.univ.filter (fun α : Fin N_ret => M_of α = m),
        ∑ d ∈ Finset.univ.filter (fun d : Fin N_D => U_of d = u), q_TD α d
  let Q_TU : Fin N_ret → Fin N_U → ℝ :=
    fun α u =>
      if 0 < P_M (M_of α) then (∑ d : Fin N_D, q_TD α d) * (P_MU (M_of α) u / P_M (M_of α)) else 0
  let Q_U : Fin N_U → ℝ := fun u => ∑ α : Fin N_ret, Q_TU α u
  obtain ⟨hQ_nn, hQ_sum, hQ_pos, h_HTE_lo, h_markov⟩ :=
    h_ent_eps.2.2 q_TD E_of M_of U_of hN_E (Nat.succ_le_succ (Nat.zero_le 624))
      hqTD_nn hqTD_sum h_625_fib

  let H_TE : ℝ :=
    (∑ α : Fin N_ret,
      -((∑ d : Fin N_D, q_TD α d) * Real.log ((∑ d : Fin N_D, q_TD α d) / P_E (E_of α)))) / ell
  let H_QTU : ℝ :=
    (∑ α : Fin N_ret, ∑ u : Fin N_U, -(Q_TU α u * Real.log (Q_TU α u / Q_U u))) / ell
  have hC_U_pos : 0 < C_U := lt_of_lt_of_le zero_lt_one hC_U
  have hHQTU_bd : H_QTU ≤ Real.log C_U / ell + g_bin - (1 - γ) * b_loc + 2 * ξ := by
    let B_U : ℝ := C_U * ε ^ (-g_bin + (1 - γ) * b_loc - 2 * ξ)
    have hBU_pos : 0 < B_U := mul_pos hC_U_pos (Real.rpow_pos_of_pos hε₀ _)
    have hQTU_fib : ∀ u_idx : Fin N_U, (0 < ∑ α : Fin N_ret, Q_TU α u_idx) →
        ((Finset.univ.filter (fun α : Fin N_ret => 0 < Q_TU α u_idx)).card : ℝ) ≤ B_U := by
      intro u_idx _
      refine h_fib_U (eU.symm u_idx).1 _ (fun α hα => ?_)
      have hpos : 0 < Q_TU α u_idx := (Finset.mem_filter.mp hα).2
      obtain ⟨_, α₀, d₀, hM_eq, hU_d₀, hq₀⟩ := hQ_pos α u_idx hpos
      have hm_eq : m_fn α₀ = m_fn α := by
        rw [← hgM_eq α₀, ← hgM_eq α, hM_eq]
      have hu_eq : u_fn d₀ = (eU.symm u_idx).1 := by
        rw [← hU_eq d₀, hU_d₀]
      exact ⟨α₀, d₀, hm_eq, hu_eq, hqTD_compat α₀ d₀ hq₀⟩
    have h_raw := h_ent_eps.2.1 Q_TU hBU_pos hQ_nn hQ_sum hQTU_fib
    have h_rhs : Real.log B_U / ell =
        Real.log C_U / ell + g_bin - (1 - γ) * b_loc + 2 * ξ := by
      dsimp only [B_U]
      rw [h_log_eps_mul hC_U_pos]
      ring
    change H_QTU ≤ Real.log B_U / ell at h_raw
    linarith only [h_raw, h_rhs]

  
  let d₁ : ℝ := Real.log ((N_all : ℝ) / (N_ret : ℝ)) / ell
  have hC_E_pos : 0 < C_E := lt_of_lt_of_le zero_lt_one hC_E
  have hN_all_pos : 0 < (N_all : ℝ) := Nat.cast_pos.mpr hN_all
  have hN_E_pos : 0 < (N_E : ℝ) := Nat.cast_pos.mpr hN_E
  have h_log_NE : Real.log (N_E : ℝ) / ell ≤
      Real.log C_E / ell + Real.log (N_ret : ℝ) / ell + d₁ - g_bin +
        (1 + γ) * b_loc + (1 - γ) * (e + h + 2 * ζ_sh) + 2 * ξ := by
    have hNE_le : (N_E : ℝ) ≤
        (C_E * (N_all : ℝ)) * ε ^ (g_bin - pktWeight γ b_loc a_loc - 2 * ξ) := hNE_bd
    have hCN_pos : 0 < C_E * (N_all : ℝ) := mul_pos hC_E_pos hN_all_pos
    have h_log_le : Real.log (N_E : ℝ) / ell ≤
        Real.log ((C_E * (N_all : ℝ)) * ε ^ (g_bin - pktWeight γ b_loc a_loc - 2 * ξ)) / ell :=
      div_le_div_of_nonneg_right (Real.log_le_log hN_E_pos hNE_le) hell_pos.le
    have h_log_expand :
        Real.log ((C_E * (N_all : ℝ)) * ε ^ (g_bin - pktWeight γ b_loc a_loc - 2 * ξ)) / ell =
        Real.log C_E / ell + Real.log (N_all : ℝ) / ell - g_bin +
          pktWeight γ b_loc a_loc + 2 * ξ := by
      rw [h_log_eps_mul hCN_pos, Real.log_mul hC_E_pos.ne' hN_all_pos.ne', add_div]
      ring
    have h_d1_eq : Real.log (N_all : ℝ) / ell = Real.log (N_ret : ℝ) / ell + d₁ := by
      dsimp only [d₁]
      rw [Real.log_div hN_all_pos.ne' hN_ret_pos.ne', sub_div]
      ring
    have h_pkt : pktWeight γ b_loc a_loc ≤ (1 + γ) * b_loc + (1 - γ) * (e + h + 2 * ζ_sh) := by
      dsimp only [pktWeight, e]
      nlinarith only [hγ₁, haloc_hi]
    linarith only [h_log_le, h_log_expand, h_d1_eq, h_pkt]
  have h_HTE_lo' : H_T - Real.log (N_E : ℝ) / ell ≤ H_TE := by
    have h_PT_eq : (∑ α : Fin N_ret,
        -((∑ d : Fin N_D, q_TD α d) * Real.log (∑ d : Fin N_D, q_TD α d))) / ell = H_T := by
      dsimp only [H_T]
      simp_rw [hqTD_marg_T]
    change (∑ α : Fin N_ret,
        -((∑ d : Fin N_D, q_TD α d) * Real.log (∑ d : Fin N_D, q_TD α d))) / ell -
        Real.log (N_E : ℝ) / ell ≤ H_TE at h_HTE_lo
    linarith only [h_HTE_lo, h_PT_eq]
  have h_markov' : H_TE - H_TDE ≤ H_QTU - H_TD + Real.log (625 : ℝ) / ell := by
    have h_PD_eq : (∑ α : Fin N_ret, ∑ d : Fin N_D,
        -(q_TD α d * Real.log (q_TD α d / (∑ α' : Fin N_ret, q_TD α' d)))) / ell = H_TD := by
      dsimp only [H_TD]
      simp_rw [hqTD_marg_D]
    have h_625_cast : Real.log ((625 : ℕ) : ℝ) / ell = Real.log (625 : ℝ) / ell := by norm_num
    change H_TE - H_TDE ≤
      (H_QTU - (∑ α : Fin N_ret, ∑ d : Fin N_D,
        -(q_TD α d * Real.log (q_TD α d / (∑ α' : Fin N_ret, q_TD α' d)))) / ell) +
      Real.log ((625 : ℕ) : ℝ) / ell at h_markov
    linarith only [h_markov, h_PD_eq, h_625_cast]
  have h_CMI_lo :
      (1 + γ) * (e - b_loc) - d₁ - A_gap - (3 - γ) * h - (6 - 2 * γ) * ζ_sh - 4 * ξ -
        Real.log C_E / ell - Real.log C_DE / ell ≤ H_TE - H_TDE := by
    have h_alg :
        (Real.log (N_ret : ℝ) / ell - A_gap) -
          (Real.log C_E / ell + Real.log (N_ret : ℝ) / ell + d₁ - g_bin +
            (1 + γ) * b_loc + (1 - γ) * (e + h + 2 * ζ_sh) + 2 * ξ) -
          (Real.log C_DE / ell + g_bin - 2 * (e - h - 2 * ζ_sh) + 2 * ξ) =
        (1 + γ) * (e - b_loc) - d₁ - A_gap - (3 - γ) * h - (6 - 2 * γ) * ζ_sh - 4 * ξ -
          Real.log C_E / ell - Real.log C_DE / ell := by ring
    linarith only [h_HTE_lo', hHT_eq, h_log_NE, hHTDE_bd, h_alg]
  have h_CMI_hi :
      H_TE - H_TDE ≤
        (1 - γ) * (e - b_loc) + B_gap + 2 * ξ + Real.log C_U / ell + Real.log (625 : ℝ) / ell := by
    have h_alg :
        (Real.log C_U / ell + g_bin - (1 - γ) * b_loc + 2 * ξ) -
          (g_bin - (1 - γ) * e - B_gap) + Real.log (625 : ℝ) / ell =
        (1 - γ) * (e - b_loc) + B_gap + 2 * ξ + Real.log C_U / ell + Real.log (625 : ℝ) / ell := by
      ring
    linarith only [h_markov', hHTD_eq, hHQTU_bd, h_alg]

  
  have h_AB_up : A_gap + B_gap ≤ 4 * RHS_star + err_D := by
    let U_nn : ℝ := A_gap + (1 / 2 : ℝ) * (B_gap + err_D)
    have hUnn : 0 ≤ U_nn := by
      dsimp only [U_nn]
      linarith only [hAgap_nn, hBgap_lo]
    have h_id : (A_gap + B_gap) + A_gap + 2 * U_nn =
        4 * (A_gap + (1 / 2 : ℝ) * B_gap) + err_D := by
      dsimp only [U_nn]
      ring
    linarith only [hAgap_nn, hUnn, h_id, h_score_bridge]
  have h_ebloc_2g : 2 * γ * e₀ - 2 * γ * h - 4 * γ * ζ_sh ≤ 2 * γ * (e - b_loc) := by
    have h_mul : 2 * γ * (e₀ - h - 2 * ζ_sh) ≤ 2 * γ * (e - b_loc) :=
      mul_le_mul_of_nonneg_left he_bloc (by linarith only [hγ₀] : 0 ≤ 2 * γ)
    have h_alg : 2 * γ * (e₀ - h - 2 * ζ_sh) = 2 * γ * e₀ - 2 * γ * h - 4 * γ * ζ_sh := by ring
    linarith only [h_mul, h_alg]
  have h_cmi_diff :
      (1 + γ) * (e - b_loc) - (1 - γ) * (e - b_loc) = 2 * γ * (e - b_loc) := by ring
  have h_final_alg :
      2 * γ * h + 4 * γ * ζ_sh + d₁ + (4 * RHS_star + err_D) +
        (3 - γ) * h + (6 - 2 * γ) * ζ_sh + 6 * ξ +
        Real.log C_E / ell + Real.log C_DE / ell +
        Real.log C_U / ell + Real.log (625 : ℝ) / ell =
      (Real.log ((N_all : ℝ) / (N_ret : ℝ)) / ell) +
        4 * (A_proxy - P_score) +
        ((37 / 2 : ℝ) + γ) * h +
        16 * ζ_sh + 14 * ξ +
        (6 * Real.log K_fac + 4 * Real.log C_R + Real.log C_E + Real.log C_D +
          Real.log C_DE + Real.log C_U + Real.log 625) / ell := by
    dsimp only [RHS_star, err_D, d₁]
    field_simp [hell_ne]
    ring
  linarith only [h_ebloc_2g, h_CMI_lo, h_CMI_hi, h_cmi_diff, h_AB_up, h_final_alg]

theorem misaligned_cap_cramer_and_strip_exclusion (γ : ℝ) (hγ₀ : 0 < γ) (hγ₁ : γ < 1)
    (hβ_pos : 0 < quantumPacketRate γ)
    (M_atom : ℝ → ℝ → ℝ → ℝ → ℝ → ℕ → ℝ)
    (cls : PacketBoundClass) (h e₀ ζ_sh A_win ξ C_cov e_al : ℝ)
    (M_L M_mult M_ord : ℕ) (C_tr : ℕ → ℝ)
    (C_sub_bes C_at_cnt B_V B_X C_far : ℝ)
    (hh : 0 < h) (h64h : 64 * h < γ * e₀) (hζ_sh : 0 < ζ_sh)
    (hA_win : 0 < A_win) (hξ : 0 < ξ) (hC_cov : 2 ≤ C_cov)
    (hML_64 : 64 ≤ M_L) (hML_bound : (64 * C_cov * cls.B_sys : ℝ) ≤ (M_L : ℝ))
    (hM_mult : 1 ≤ M_mult) (hC_tr : ∀ M, 0 ≤ C_tr M)
    (he_al : 0 < e_al) (he_al_le : e_al ≤ γ * e₀) (h64_err : 64 * (ζ_sh + ξ) ≤ e_al)
    (hC_bes : 1 ≤ C_sub_bes) (hC_at : 1 ≤ C_at_cnt)
    (hBV : C_cov ≤ B_V) (hBX : 2 ≤ B_X) (hC_far : 0 ≤ C_far)
    (hM_ord_gt : 10 * cls.K_hor + ξ + 2 < (2 * (M_ord : ℝ)) * min (h / 16) (e_al / 512))
    (h_ana : ∀ (ε H_P L t b_star lam_sys : ℝ) (m_r m_t N_O N_D N_ret : ℕ)
      (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
      (ζ₀ : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → EuclideanSpace ℝ (Fin 2))
      (f : EuclideanSpace ℝ (Fin 2) → ℂ)
      (r_O : Fin N_O → ℕ) (V_O X_O : Fin N_O → EuclideanSpace ℝ (Fin 2))
      (ψ_O : Fin N_O → EuclideanSpace ℝ (Fin 2) → ℂ)
      (b_D a_D : Fin N_D → ℝ) (r_D : Fin N_D → ℕ)
      (e_D V_D X_D : Fin N_D → EuclideanSpace ℝ (Fin 2))
      (sub : LocalizerSubclass N_ret) (p_cond : Fin N_O → Fin N_D → ℝ),
      let r := t - 2 * h
      let s_c := ((2 : ℝ) ^ m_r)⁻¹
      let C_r := ((sub.loc_idx.1 : ℝ) + 1 / 2) * s_c
      let s_v := ε ^ b_star
      let s_x := s_c * s_v
      let V_J := gridPt2D s_v sub.loc_idx.2.1
      let X_J := gridPt2D s_x sub.loc_idx.2.2
      let ρ_r := ε ^ ((H_P - r) / 2)
      let σ_r := (lam_sys * ρ_r)⁻¹
