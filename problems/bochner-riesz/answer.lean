  have huV_sq : (inner ℝ δV e_φ / d₂₀) ^ 2 + (inner ℝ δV (perp2D e_φ) / d₂₁) ^ 2 ≤ 200 := by
    change |inner ℝ δV e_φ| ≤ 10 * d₂₀ at hV_φ
    change |inner ℝ δV (perp2D e_φ)| ≤ 10 * d₂₁ at hV_pφ
    have h1 : |inner ℝ δV e_φ / d₂₀| ≤ 10 := by
