                (6 * (4 * ((2 : ℝ) ^ m₂)⁻¹ * ε ^ (-h)) + 4) ≤
              2 * (4 * C_cov * ε ^ (-h)) * (52 * ε ^ (-(h / 4))) := by
            linarith only [hm]
          have h_rhs : 2 * (4 * C_cov * ε ^ (-h)) * (52 * ε ^ (-(h / 4))) =
              416 * C_cov * ε ^ (-(5 / 4 : ℝ) * h) := by
            have hexp : ε ^ (-h) * ε ^ (-(h / 4)) = ε ^ (-(5 / 4 : ℝ) * h) := by
              rw [← Real.rpow_add hε₀]
              congr 1; ring
            calc 2 * (4 * C_cov * ε ^ (-h)) * (52 * ε ^ (-(h / 4)))
                = 416 * C_cov * (ε ^ (-h) * ε ^ (-(h / 4))) := by ring
              _ = 416 * C_cov * ε ^ (-(5 / 4 : ℝ) * h) := by rw [hexp]
          exact le_trans hJ_cnt (h_rhs ▸ h_prod)
        
        have hBj_card : ∀ j ∈ J_bdry,
            (((S_bdry.filter (fun α => (sub.o_at α).1 = j)).card : ℕ) : ℝ) ≤
              9 * C_cov ^ 2 * R_tr ^ 2 * (M_mult : ℝ) := by
          intro j _
          let B_j : Finset (Fin N_ret) := S_bdry.filter (fun α => (sub.o_at α).1 = j)
