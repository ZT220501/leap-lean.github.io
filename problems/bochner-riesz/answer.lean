    let I_f : ℂ := (ρ_obs⁻¹ : ℂ) * ∫ v : EuclideanSpace ℝ (Fin 2),
      f v * ψ_o (ρ_obs⁻¹ • (v - V_o)) *
        Complex.exp (Complex.I * ((lam_sys * Φ₀ (C_box, X_o, v) : ℝ) : ℂ))
    let I_S : Finset ((ℤ × ℤ) × (ℤ × ℤ)) → ℂ := fun S =>
      (ρ_obs⁻¹ : ℂ) * ∫ v : EuclideanSpace ℝ (Fin 2),
        h_syn S v * ψ_o (ρ_obs⁻¹ • (v - V_o)) *
          Complex.exp (Complex.I * ((lam_sys * Φ₀ (C_box, X_o, v) : ℝ) : ℂ))
    let I_compl : ℂ := ∑ j ∈ pktVelBox lam_sys R_dom,
      ∑' n : ℤ × ℤ, if (j, n) ∈ F_modes then (0 : ℂ) else c (j, n) * pair_o j n
    have hIf_mass : generalPacketObsMass ε H_P d lam_sys m_time Φ₀ f r_o V_o X_o ψ_o = ‖I_f‖ ^ 2 := rfl
    have hIS_mass : ∀ S, generalPacketObsMass ε H_P d lam_sys m_time Φ₀ (h_syn S) r_o V_o X_o ψ_o =
        ‖I_S S‖ ^ 2 := fun _ => rfl
    have hIf_series : I_f = ∑ j ∈ pktVelBox lam_sys R_dom, ∑' n : ℤ × ℤ, c (j, n) * pair_o j n := by
      have h1 : I_f = (ρ_obs⁻¹ : ℂ) * ∫ v : EuclideanSpace ℝ (Fin 2),
          f v * (ψ_o (ρ_obs⁻¹ • (v - V_o)) *
            Complex.exp (Complex.I * ((lam_sys * Φ₀ (C_box, X_o, v) : ℝ) : ℂ))) := by
        dsimp only [I_f]
        congr 1
        refine MeasureTheory.integral_congr_ae (Filter.Eventually.of_forall (fun v => by ring))
      rw [h1, h_exp_pair, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [← tsum_mul_left]
      congr 1
      ext n
      dsimp only [pair_o]
      rw [← mul_assoc, mul_comm (ρ_obs⁻¹ : ℂ) (c (j, n)), mul_assoc]
      congr 2
      refine MeasureTheory.integral_congr_ae (Filter.Eventually.of_forall (fun v => by ring))
    have hIf_split_modes : I_f = (∑ q ∈ F_modes, c q * pair_o q.1 q.2) + I_compl := by
      rw [hIf_series, ← Finset.sum_fiberwise_of_maps_to hF_vel (fun q => c q * pair_o q.1 q.2),
        ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun j hj => ?_)
      let F_j := F_modes.filter (fun q => q.1 = j)
      let N_j := F_j.image Prod.snd
      let u₁ : ℤ × ℤ → ℂ := fun n => if (j, n) ∈ F_modes then c (j, n) * pair_o j n else 0
      let u₂ : ℤ × ℤ → ℂ := fun n => if (j, n) ∈ F_modes then 0 else c (j, n) * pair_o j n
      have hu₁_supp : ∀ n ∉ N_j, u₁ n = 0 := by
        intro n hn
        dsimp only [u₁]
        split_ifs with hmem
        · exfalso
          exact hn (Finset.mem_image.mpr ⟨(j, n), Finset.mem_filter.mpr ⟨hmem, rfl⟩, rfl⟩)
        · rfl
      have hu₁_has : HasSum u₁ (∑ n ∈ N_j, u₁ n) := hasSum_sum_of_ne_finset_zero hu₁_supp
      have hu₂_sum : Summable u₂ := h_compl_sum j hj
      have h_add_fn : (fun n : ℤ × ℤ => c (j, n) * pair_o j n) = fun n => u₁ n + u₂ n := by
        ext n
        dsimp only [u₁, u₂]
        split_ifs <;> simp
      rw [h_add_fn, hu₁_has.summable.tsum_add hu₂_sum, hu₁_has.tsum_eq]
      congr 1
      dsimp only [N_j]
      rw [Finset.sum_image]
      · refine Finset.sum_congr rfl (fun q hq => ?_)
        obtain ⟨hqF, hq1⟩ := Finset.mem_filter.mp hq
        have hpair : (j, q.2) = q := Prod.ext hq1.symm rfl
        simp only [u₁, hpair, hqF, ↓reduceIte, hq1]
      · intro q₁ hq₁ q₂ hq₂ h2
        have h1₁ : q₁.1 = j := (Finset.mem_filter.mp hq₁).2
        have h1₂ : q₂.1 = j := (Finset.mem_filter.mp hq₂).2
        exact Prod.ext (h1₁.trans h1₂.symm) h2
    have hIf_full_split : I_f = (∑ m_idx : Fin M_c, I_S (F_bin m_idx)) + I_S F_tiny + I_compl := by
      rw [hIf_split_modes, ← h_part_eq, Finset.sum_union h_disj_tiny,
        Finset.sum_biUnion h_pw_disj, ← h_lin_S F_tiny]
      congr 2
      exact Finset.sum_congr rfl (fun m_idx _ => (h_lin_S (F_bin m_idx)).symm)
    rw [hIf_mass] at h_floor
    have h_tiny_sq : ‖I_S F_tiny‖ ^ 2 ≤ ((1 / 4 : ℝ) * ‖I_f‖) ^ 2 := by
      rw [← hIS_mass]
      obtain ⟨hm_t, hi_t, h_l2_t⟩ := h_synth F_tiny
      have hbes := h_bes_single (h_syn F_tiny) hm_t hi_t
      have hsum_t : ∑ q ∈ F_tiny, ‖c q‖ ^ 2 ≤
          (F_modes.card : ℝ) * (ε ^ ((M_c : ℝ) * ξ) * E_f) := by
        have hcard_le : (F_tiny.card : ℝ) ≤ (F_modes.card : ℝ) := by
          exact_mod_cast Finset.card_le_card
            (letI := Classical.propDecidable; Finset.filter_subset _ F_modes)
        calc ∑ q ∈ F_tiny, ‖c q‖ ^ 2
            ≤ ∑ _q ∈ F_tiny, (ε ^ ((M_c : ℝ) * ξ) * E_f) :=
              Finset.sum_le_sum (fun q hq =>
                (letI := Classical.propDecidable; Finset.mem_filter.mp hq).2.le)
          _ = (F_tiny.card : ℝ) * (ε ^ ((M_c : ℝ) * ξ) * E_f) := by simp
          _ ≤ (F_modes.card : ℝ) * (ε ^ ((M_c : ℝ) * ξ) * E_f) :=
              mul_le_mul_of_nonneg_right hcard_le
                (mul_nonneg (Real.rpow_pos_of_pos hε₀ _).le hE_f.le)
      have hC_Bes_nn : 0 ≤ C_Bes := by linarith only [hC_Bes]
      have h1 : generalPacketObsMass ε H_P d lam_sys m_time Φ₀ (h_syn F_tiny) r_o V_o X_o ψ_o ≤
          (4 * C_Bes * C_modes * lam_sys ^ 2 * ε ^ ((M_c : ℝ) * ξ)) * E_f := by
        calc generalPacketObsMass ε H_P d lam_sys m_time Φ₀ (h_syn F_tiny) r_o V_o X_o ψ_o
            ≤ C_Bes * ∫ v, ‖h_syn F_tiny v‖ ^ 2 := hbes
          _ ≤ C_Bes * (4 * ∑ q ∈ F_tiny, ‖c q‖ ^ 2) :=
              mul_le_mul_of_nonneg_left h_l2_t hC_Bes_nn
          _ ≤ C_Bes * (4 * ((F_modes.card : ℝ) * (ε ^ ((M_c : ℝ) * ξ) * E_f))) :=
              mul_le_mul_of_nonneg_left
                (mul_le_mul_of_nonneg_left hsum_t (by norm_num)) hC_Bes_nn
          _ ≤ C_Bes * (4 * ((C_modes * lam_sys ^ 2) * (ε ^ ((M_c : ℝ) * ξ) * E_f))) := by
              refine mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left ?_ (by norm_num)) hC_Bes_nn
              exact mul_le_mul_of_nonneg_right hF_card
                (mul_nonneg (Real.rpow_pos_of_pos hε₀ _).le hE_f.le)
          _ = (4 * C_Bes * C_modes * lam_sys ^ 2 * ε ^ ((M_c : ℝ) * ξ)) * E_f := by ring
      have h2 : (4 * C_Bes * C_modes * lam_sys ^ 2 * ε ^ ((M_c : ℝ) * ξ)) * E_f ≤
          (1 / 16) * (ε ^ A₀ * E_f) := by
        have hm := mul_le_mul_of_nonneg_right h_tiny_budget hE_f.le
        linarith only [hm]
      have h3 : (1 / 16 : ℝ) * ‖I_f‖ ^ 2 = ((1 / 4 : ℝ) * ‖I_f‖) ^ 2 := by ring
      linarith only [h1, h2, h_floor, h3]
    have h_tiny_norm : ‖I_S F_tiny‖ ≤ (1 / 4 : ℝ) * ‖I_f‖ := by
      have hs := Real.sqrt_le_sqrt h_tiny_sq
      rwa [Real.sqrt_sq (norm_nonneg _),
        Real.sqrt_sq (mul_nonneg (by norm_num) (norm_nonneg _))] at hs
    have h_compl_sq : ‖I_compl‖ ^ 2 ≤ ((1 / 4 : ℝ) * ‖I_f‖) ^ 2 := by
      have h3 : (1 / 16 : ℝ) * ‖I_f‖ ^ 2 = ((1 / 4 : ℝ) * ‖I_f‖) ^ 2 := by ring
      linarith only [h_compl_bound, h_floor, h3]
    have h_compl_norm : ‖I_compl‖ ≤ (1 / 4 : ℝ) * ‖I_f‖ := by
      have hs := Real.sqrt_le_sqrt h_compl_sq
      rwa [Real.sqrt_sq (norm_nonneg _),
        Real.sqrt_sq (mul_nonneg (by norm_num) (norm_nonneg _))] at hs
    have h_tri : ‖I_f‖ ≤ (∑ m_idx : Fin M_c, ‖I_S (F_bin m_idx)‖) +
        ‖I_S F_tiny‖ + ‖I_compl‖ := by
      rw [hIf_full_split]
      have ht1 := norm_add_le ((∑ m_idx : Fin M_c, I_S (F_bin m_idx)) + I_S F_tiny) I_compl
      have ht2 := norm_add_le (∑ m_idx : Fin M_c, I_S (F_bin m_idx)) (I_S F_tiny)
      have ht3 := norm_sum_le (Finset.univ : Finset (Fin M_c)) (fun m_idx => I_S (F_bin m_idx))
      linarith only [ht1, ht2, ht3]
    have h_half_le : (1 / 2 : ℝ) * ‖I_f‖ ≤ ∑ m_idx : Fin M_c, ‖I_S (F_bin m_idx)‖ := by
      linarith only [h_tri, h_tiny_norm, h_compl_norm]
    have hMc_pos : (0 : ℝ) < (M_c : ℝ) := by exact_mod_cast hM_c
    have h2Mc_pos : (0 : ℝ) < 2 * (M_c : ℝ) := by positivity
    have h_avg_sum : (∑ _m ∈ (Finset.univ : Finset (Fin M_c)), ‖I_f‖ / (2 * (M_c : ℝ))) ≤
        ∑ m_idx ∈ (Finset.univ : Finset (Fin M_c)), ‖I_S (F_bin m_idx)‖ := by
      have hconst : (∑ _m ∈ (Finset.univ : Finset (Fin M_c)), ‖I_f‖ / (2 * (M_c : ℝ))) =
          (1 / 2 : ℝ) * ‖I_f‖ := by
        simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
        field_simp [hMc_pos.ne']
      rwa [hconst]
    have huniv_ne : (Finset.univ : Finset (Fin M_c)).Nonempty :=
      ⟨⟨0, hM_c⟩, Finset.mem_univ _⟩
    obtain ⟨m_idx, _, hm_win⟩ := Finset.exists_le_of_sum_le huniv_ne h_avg_sum
    have hm_mul : ‖I_f‖ ≤ 2 * (M_c : ℝ) * ‖I_S (F_bin m_idx)‖ := by
      have h1 := (div_le_iff₀ h2Mc_pos).mp hm_win
      linarith only [h1]
    refine ⟨m_idx, ?_⟩
    rw [hIf_mass, hIS_mass]
    have hsq := pow_le_pow_left₀ (norm_nonneg I_f) hm_mul 2
    calc ‖I_f‖ ^ 2 ≤ (2 * (M_c : ℝ) * ‖I_S (F_bin m_idx)‖) ^ 2 := hsq
      _ = 4 * (M_c : ℝ) ^ 2 * ‖I_S (F_bin m_idx)‖ ^ 2 := by ring

  
  have h_fiber_sep : ∀ (ε H_P d lam_sys B_sys R_win η A₀ E_f K_up E_far C_Bes : ℝ)
      (m_time N_O M_c r : ℕ) (a : ℝ) (k_V k_Y : ℤ × ℤ)
      (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
      (r_O : Fin N_O → ℕ) (V_O X_O : Fin N_O → EuclideanSpace ℝ (Fin 2))
      (ψ_O : Fin N_O → EuclideanSpace ℝ (Fin 2) → ℂ)
      (F_m : Finset ((ℤ × ℤ) × (ℤ × ℤ)))
      (X_ex : ((ℤ × ℤ) × (ℤ × ℤ)) → EuclideanSpace ℝ (Fin 2))
      (c : ((ℤ × ℤ) × (ℤ × ℤ)) → ℂ),
      0 < ε → ε < 1 → 2 ≤ B_sys → 2 ≤ R_win →
      a ≤ (H_P - d) / 2 → r < 2 ^ m_time →
      0 < K_up → 1 ≤ C_Bes →
      (Real.sqrt lam_sys)⁻¹ ≤ B_sys * ε ^ ((H_P - d) / 2) →
      (∀ q ∈ F_m, ‖c q‖ ^ 2 ≤ K_up) →
      (∀ S : Finset ((ℤ × ℤ) × (ℤ × ℤ)),
        let h_S := fun v => ∑ q ∈ S, c q * pktLinearAtom lam_sys Φ₀ q.1 q.2 v
        MeasureTheory.AEStronglyMeasurable h_S MeasureTheory.volume ∧
        MeasureTheory.Integrable (fun v => ‖h_S v‖ ^ 2) MeasureTheory.volume ∧
        (∫ v : EuclideanSpace ℝ (Fin 2), ‖h_S v‖ ^ 2) ≤ 4 * ∑ q ∈ S, ‖c q‖ ^ 2) →
      (∀ (S_sub : Finset (Fin N_O)), (∀ o ∈ S_sub, r_O o = r) →
        ∀ (h : EuclideanSpace ℝ (Fin 2) → ℂ),
          MeasureTheory.AEStronglyMeasurable h MeasureTheory.volume →
          MeasureTheory.Integrable (fun v => ‖h v‖ ^ 2) MeasureTheory.volume →
          ∑ o ∈ S_sub, generalPacketObsMass ε H_P d lam_sys m_time Φ₀ h
            (r_O o) (V_O o) (X_O o) (ψ_O o) ≤
            C_Bes * ∫ v : EuclideanSpace ℝ (Fin 2), ‖h v‖ ^ 2) →
      (∀ (o : Fin N_O) (S : Finset ((ℤ × ℤ) × (ℤ × ℤ))),
        let ρ_obs := ε ^ ((H_P - d) / 2)
        let C_o := ((r_O o : ℝ) + 1 / 2) * ((2 : ℝ) ^ m_time)⁻¹
        (ρ_obs⁻¹ : ℂ) * ∫ v : EuclideanSpace ℝ (Fin 2),
          (∑ q ∈ S, c q * pktLinearAtom lam_sys Φ₀ q.1 q.2 v) *
            ψ_O o (ρ_obs⁻¹ • (v - V_O o)) *
            Complex.exp (Complex.I * ((lam_sys * Φ₀ (C_o, X_O o, v) : ℝ) : ℂ)) =
        ∑ q ∈ S, c q *
          ((ρ_obs⁻¹ : ℂ) * ∫ v : EuclideanSpace ℝ (Fin 2),
            pktLinearAtom lam_sys Φ₀ q.1 q.2 v * ψ_O o (ρ_obs⁻¹ • (v - V_O o)) *
              Complex.exp (Complex.I * ((lam_sys * Φ₀ (C_o, X_O o, v) : ℝ) : ℂ)))) →
      (∀ (o : Fin N_O), r_O o = r →
        let ρ₀ := (Real.sqrt lam_sys)⁻¹
        let ρ_obs := ε ^ ((H_P - d) / 2)
        let ρ_tilde := max ρ₀ ρ_obs
        let C_r := ((r : ℝ) + 1 / 2) * ((2 : ℝ) ^ m_time)⁻¹
        ∀ (S_far : Finset ((ℤ × ℤ) × (ℤ × ℤ))), S_far ⊆ F_m →
          (∀ q ∈ S_far,
            R_win * ρ_tilde + 2 * ρ₀ ≤ ‖gridPt2D ρ₀ q.1 - V_O o‖ ∨
            ε ^ (-η) * ρ₀ ≤ ‖X_ex q - (X_O o + (1 / 2 - C_r) • gridPt2D ρ₀ q.1)‖) →
          generalPacketObsMass ε H_P d lam_sys m_time Φ₀
            (fun v => ∑ q ∈ S_far, c q * pktLinearAtom lam_sys Φ₀ q.1 q.2 v)
            (r_O o) (V_O o) (X_O o) (ψ_O o) ≤ E_far) →
      let R'_win := (R_win + 2) * B_sys
      let ρ₀ := (Real.sqrt lam_sys)⁻¹
      let C_r := ((r : ℝ) + 1 / 2) * ((2 : ℝ) ^ m_time)⁻¹
      let m_of : Fin N_O → ℝ := fun o =>
        generalPacketObsMass ε H_P d lam_sys m_time Φ₀
          (fun v => ∑ q ∈ F_m, c q * pktLinearAtom lam_sys Φ₀ q.1 q.2 v)
          (r_O o) (V_O o) (X_O o) (ψ_O o)
      let S_Z :=
        letI := Classical.propDecidable
        Finset.univ.filter (fun o : Fin N_O =>
          r_O o = r ∧
          pktRound2D (ε ^ a) (V_O o) = k_V ∧
          pktRound2D (ε ^ a) (X_O o + (1 / 2 - C_r) • V_O o) = k_Y ∧
          (4 * (M_c : ℝ) ^ 2)⁻¹ * ε ^ A₀ * E_f ≤ m_of o)
      let T_Z :=
        letI := Classical.propDecidable
        F_m.filter (fun q =>
          ‖gridPt2D ρ₀ q.1 - gridPt2D (ε ^ a) k_V‖ ≤ (R'_win + 6) * ε ^ a ∧
          ‖X_ex q - gridPt2D (ε ^ a) k_Y‖ ≤ ε ^ (-η) * ρ₀ + (R'_win + 6) * ε ^ a)
      2 * (S_Z.card : ℝ) * E_far < (4 * (M_c : ℝ) ^ 2)⁻¹ * ε ^ A₀ * E_f →
      2 * (S_Z.card : ℝ) * E_far ≤ K_up →
      S_Z.Nonempty →
      T_Z.Nonempty ∧
      ∑ o ∈ S_Z, m_of o ≤ (8 * C_Bes + 1) * K_up * (T_Z.card : ℝ) := by
    intro ε H_P d lam_sys B_sys R_win η A₀ E_f K_up E_far C_Bes m_time N_O M_c r a k_V k_Y
      Φ₀ r_O V_O X_O ψ_O F_m X_ex c
      hε₀ hε₁ hB_sys hR_win ha_hi hr hK_up hC_Bes hρ₀_bound hF_upper h_synth_all h_bes_slice
      h_pair_lin h_far_tail
    dsimp only
    let R'_win := (R_win + 2) * B_sys
    let ρ₀ := (Real.sqrt lam_sys)⁻¹
    let ρ_obs := ε ^ ((H_P - d) / 2)
    let ρ_tilde := max ρ₀ ρ_obs
    let s := ε ^ a
    let C_r := ((r : ℝ) + 1 / 2) * ((2 : ℝ) ^ m_time)⁻¹
    let h_syn : Finset ((ℤ × ℤ) × (ℤ × ℤ)) → EuclideanSpace ℝ (Fin 2) → ℂ :=
      fun S v => ∑ q ∈ S, c q * pktLinearAtom lam_sys Φ₀ q.1 q.2 v
    let m_of : Fin N_O → ℝ := fun o =>
      generalPacketObsMass ε H_P d lam_sys m_time Φ₀ (h_syn F_m) (r_O o) (V_O o) (X_O o) (ψ_O o)
    let P_TZ : ((ℤ × ℤ) × (ℤ × ℤ)) → Prop := fun q =>
