                · exact mul_le_mul_of_nonneg_left hfe_k (Nat.cast_nonneg m)
            _ = 4 * A ^ (m + 1) * ((m.factorial : ℝ) ^ 3) +
                  (m : ℝ) * A ^ m * (((m - 1).factorial : ℝ) ^ 3) := by ring
        calc c * |t * iteratedDeriv m (f_vec e) t + (m : ℝ) * iteratedDeriv k (f_vec e) t|
            ≤ 1 * (4 * A ^ (m + 1) * ((m.factorial : ℝ) ^ 3) +
                (m : ℝ) * A ^ m * (((m - 1).factorial : ℝ) ^ 3)) :=
              mul_le_mul hc1 h_sum_abs (abs_nonneg _) zero_le_one
          _ = 4 * A ^ (m + 1) * ((m.factorial : ℝ) ^ 3) +
