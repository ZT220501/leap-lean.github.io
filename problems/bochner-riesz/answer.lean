    let c_end := ((r_loc : ℝ) + 1 / 2) * ((2 : ℝ) ^ (m_t - m_r))⁻¹
    have hpow_split : ((2 : ℝ) ^ m_t)⁻¹ = s_c * ((2 : ℝ) ^ (m_t - m_r))⁻¹ := by
      have hm_add : m_t = m_r + (m_t - m_r) := (Nat.add_sub_of_le hmr_le_mt).symm
      conv_lhs => rw [hm_add, pow_add, mul_inv]
    have hCt_sub_Cr : C_t - C_r = s_c * (c_end - 1 / 2) := by
      dsimp only [C_t, C_r, c_end]
      rw [hpow_split, hr_div_mod]
      push_cast
      have h_id : (((menu j).loc_idx.1 : ℝ) * (2 : ℝ) ^ (m_t - m_r) + (r_loc : ℝ) + 1 / 2) *
            (s_c * ((2 : ℝ) ^ (m_t - m_r))⁻¹) - (((menu j).loc_idx.1 : ℝ) + 1 / 2) * s_c =
          (((menu j).loc_idx.1 : ℝ) * s_c) * (((2 : ℝ) ^ (m_t - m_r)) * ((2 : ℝ) ^ (m_t - m_r))⁻¹ - 1) +
            s_c * (((r_loc : ℝ) + 1 / 2) * ((2 : ℝ) ^ (m_t - m_r))⁻¹ - 1 / 2) := by ring
      have hne : ((2 : ℝ) ^ (m_t - m_r)) ≠ 0 := by positivity
