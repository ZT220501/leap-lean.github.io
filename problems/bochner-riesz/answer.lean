        refine Finset.sum_eq_zero (fun n_bin _ => ?_)
        exact if_neg (fun h => hk h.1.symm)
      · intro hnot; exact absurd (Finset.mem_image_of_mem _ (Finset.mem_univ i)) hnot
    have h_exists_sl : ∃ (k_X : ℤ) (n_bin : ℤ),
        (1 / 2 : ℝ) * (∑ i, if bX i = k_X then ν_P i else 0) *
          (∑ i, if N_bin i = n_bin then ν_P i else 0) <
          ∑ i, if bX i = k_X ∧ N_bin i = n_bin then ν_P i else 0 := by
      by_contra h_all
      push_neg at h_all
      have h_le : (∑ k_X ∈ I_X, ∑ n_bin ∈ I_N,
          ∑ i : Fin N_P, if bX i = k_X ∧ N_bin i = n_bin then ν_P i else 0) ≤
          ∑ k_X ∈ I_X, ∑ n_bin ∈ I_N,
            (1 / 2 : ℝ) * (∑ i, if bX i = k_X then ν_P i else 0) *
              (∑ i, if N_bin i = n_bin then ν_P i else 0) :=
        Finset.sum_le_sum (fun k_X _ => Finset.sum_le_sum (fun n_bin _ => h_all k_X n_bin))
      have h_rhs_half : (∑ k_X ∈ I_X, ∑ n_bin ∈ I_N,
          (1 / 2 : ℝ) * (∑ i, if bX i = k_X then ν_P i else 0) *
            (∑ i, if N_bin i = n_bin then ν_P i else 0)) = 1 / 2 := by
        have h_f : ∀ k_X, (∑ n_bin ∈ I_N,
            (1 / 2 : ℝ) * (∑ i, if bX i = k_X then ν_P i else 0) *
              (∑ i, if N_bin i = n_bin then ν_P i else 0)) =
            (1 / 2 : ℝ) * (∑ i, if bX i = k_X then ν_P i else 0) := by
          intro k_X
          rw [← Finset.mul_sum, h_sum_IN, mul_one]
        simp_rw [h_f, ← Finset.mul_sum, h_sum_IX, mul_one]
      linarith [h_sum_joint, h_le, h_rhs_half]
    obtain ⟨kX_star, n_star, h_sl_gt⟩ := h_exists_sl
    let p_X_star := ∑ i : Fin N_P, if bX i = kX_star then ν_P i else 0
    let p_N_star := ∑ i : Fin N_P, if N_bin i = n_star then ν_P i else 0
    let p_sl := ∑ i : Fin N_P, if bX i = kX_star ∧ N_bin i = n_star then ν_P i else 0
    have hpX_nn : 0 ≤ p_X_star :=
      Finset.sum_nonneg (fun i _ => by split_ifs; exact hν_P_nn i; exact le_rfl)
    have hpN_nn : 0 ≤ p_N_star :=
      Finset.sum_nonneg (fun i _ => by split_ifs; exact hν_P_nn i; exact le_rfl)
    have hp_sl_pos : 0 < p_sl :=
      lt_of_le_of_lt (mul_nonneg (mul_nonneg (by norm_num) hpX_nn) hpN_nn) h_sl_gt
    let μ_sl : Fin N_P → ℝ :=
      fun i => if bX i = kX_star ∧ N_bin i = n_star then ν_P i / p_sl else 0
    let x_P : Fin N_P → EuclideanSpace ℝ (Fin 2) :=
      fun i => WithLp.toLp 2 ![L_hat i, Z₁_hat i]
    let G_sl : Fin N_P → Fin N_Θ → Prop :=
      fun i b₂ => 0 < ν_star i b₂ ∧ bX i = kX_star ∧ N_bin i = n_star
    have hμ_sl_nn : ∀ i, 0 ≤ μ_sl i := by
      intro i; dsimp [μ_sl]; split_ifs; exact div_nonneg (hν_P_nn i) hp_sl_pos.le; exact le_rfl
    have hμ_sl_sum : ∑ i, μ_sl i = 1 := by
      dsimp [μ_sl]
      have heq : (∑ i : Fin N_P, if bX i = kX_star ∧ N_bin i = n_star then ν_P i / p_sl else 0) =
          p_sl / p_sl := by
        dsimp [p_sl]
        rw [Finset.sum_div]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        split_ifs <;> simp
      rw [heq]
      exact div_self hp_sl_pos.ne'
    refine h_app ρ M N_P N_Θ μ_sl x_P lam₀₁ a_B G_sl
      hρ hρ_lt_ρ₀ hM hμ_sl_nn hμ_sl_sum
      (fun i => (h_L_dom i).2) ?_
      hlam_nn hlam_sum ha_dom ?_ ?_ ?_
    · intro z_pt r hr0 hr1
      have hr_pos : 0 < r := lt_of_lt_of_le hρ hr0
      let S_L : Finset ℤ :=
        (Finset.univ.image L_bin).filter (fun l_bin => |((l_bin : ℝ) + 1 / 2) * ρ - z_pt 0| < r)
      let S_Z : Finset ℤ :=
        (Finset.univ.image bZ₁).filter (fun k_Z => |((k_Z : ℝ) + 1 / 2) * ρ - z_pt 1| < r)
      have h_norm_imp : ∀ i : Fin N_P, ‖x_P i - z_pt‖ < r →
          |L_hat i - z_pt 0| < r ∧ |Z₁_hat i - z_pt 1| < r := by
        intro i hlt
        have hsq : ‖x_P i - z_pt‖ ^ 2 < r ^ 2 :=
          (sq_lt_sq₀ (norm_nonneg _) hr_pos.le).mpr hlt
        rw [PiLp.norm_sq_eq_of_L2 (fun _ => ℝ), Fin.sum_univ_two] at hsq
        have h0_eq : (x_P i - z_pt) 0 = L_hat i - z_pt 0 := by simp [x_P]
        have h1_eq : (x_P i - z_pt) 1 = Z₁_hat i - z_pt 1 := by simp [x_P]
        simp only [Real.norm_eq_abs, sq_abs] at hsq
        rw [h0_eq, h1_eq] at hsq
        exact ⟨(sq_lt_sq₀ (abs_nonneg _) hr_pos.le).mp
                 (by rw [sq_abs]; nlinarith [sq_nonneg (Z₁_hat i - z_pt 1)]),
               (sq_lt_sq₀ (abs_nonneg _) hr_pos.le).mp
                 (by rw [sq_abs]; nlinarith [sq_nonneg (L_hat i - z_pt 0)])⟩
      have h_pt_sl : ∀ i : Fin N_P,
          @ite ℝ (‖x_P i - z_pt‖ < r) (Classical.propDecidable _) (μ_sl i) 0 ≤
            (∑ l_bin ∈ S_L, ∑ k_Z ∈ S_Z,
              if bX i = kX_star ∧ (N_bin i, L_bin i) = (n_star, l_bin) ∧ bZ₁ i = k_Z
              then ν_P i else 0) / p_sl := by
        intro i
        split_ifs with hlt
        · obtain ⟨hL_lt, hZ_lt⟩ := h_norm_imp i hlt
          dsimp [μ_sl]
          split_ifs with hsl
          · have hl_mem : L_bin i ∈ S_L :=
              Finset.mem_filter.mpr ⟨Finset.mem_image_of_mem _ (Finset.mem_univ i), hL_lt⟩
            have hz_mem : bZ₁ i ∈ S_Z :=
              Finset.mem_filter.mpr ⟨Finset.mem_image_of_mem _ (Finset.mem_univ i), hZ_lt⟩
            refine div_le_div_of_nonneg_right ?_ hp_sl_pos.le
            have h_in : ν_P i ≤ ∑ k_Z ∈ S_Z,
                if bX i = kX_star ∧ (N_bin i, L_bin i) = (n_star, L_bin i) ∧ bZ₁ i = k_Z
                then ν_P i else 0 := by
              refine le_trans (le_of_eq (if_pos ⟨hsl.1, Prod.ext hsl.2 rfl, rfl⟩).symm)
                (Finset.single_le_sum
                  (f := fun k_Z =>
                    if bX i = kX_star ∧ (N_bin i, L_bin i) = (n_star, L_bin i) ∧ bZ₁ i = k_Z
                    then ν_P i else 0)
                  (fun k_Z _ => by split_ifs; exact hν_P_nn i; exact le_rfl) hz_mem)
            exact le_trans h_in
              (Finset.single_le_sum
                (f := fun l_bin => ∑ k_Z ∈ S_Z,
                  if bX i = kX_star ∧ (N_bin i, L_bin i) = (n_star, l_bin) ∧ bZ₁ i = k_Z
                  then ν_P i else 0)
                (fun l_bin _ => Finset.sum_nonneg (fun k_Z _ => by
                  split_ifs; exact hν_P_nn i; exact le_rfl)) hl_mem)
          · exact div_nonneg
              (Finset.sum_nonneg (fun _ _ => Finset.sum_nonneg (fun _ _ => by
                split_ifs; exact hν_P_nn i; exact le_rfl))) hp_sl_pos.le
        · exact div_nonneg
            (Finset.sum_nonneg (fun _ _ => Finset.sum_nonneg (fun _ _ => by
              split_ifs; exact hν_P_nn i; exact le_rfl))) hp_sl_pos.le
      have h_sum_SL : (∑ l_bin ∈ S_L, ∑ i : Fin N_P,
          if (N_bin i, L_bin i) = (n_star, l_bin) then ν_P i else 0) ≤
          12 * ρ ^ (-3 * η_sl) * p_N_star * r ^ x := by
        have heq : (∑ l_bin ∈ S_L, ∑ i : Fin N_P,
            if (N_bin i, L_bin i) = (n_star, l_bin) then ν_P i else 0) =
            ∑ i : Fin N_P, if N_bin i = n_star ∧ |L_hat i - z_pt 0| < r then ν_P i else 0 := by
          rw [Finset.sum_comm]
          refine Finset.sum_congr rfl (fun i _ => ?_)
          by_cases hi : N_bin i = n_star ∧ |L_hat i - z_pt 0| < r
          · rw [if_pos hi, Finset.sum_eq_single (L_bin i)]
            · have hp_eq : (N_bin i, L_bin i) = (n_star, L_bin i) := Prod.ext hi.1 rfl
              exact if_pos hp_eq
            · intro l_bin _ hl; exact if_neg (fun h => hl (Prod.ext_iff.mp h).2.symm)
            · intro hnot
              exfalso
              exact hnot (Finset.mem_filter.mpr
                ⟨Finset.mem_image_of_mem _ (Finset.mem_univ i), hi.2⟩)
          · rw [if_neg hi]
            refine Finset.sum_eq_zero (fun l_bin hl => ?_)
            have hl_lt : |((l_bin : ℝ) + 1 / 2) * ρ - z_pt 0| < r := (Finset.mem_filter.mp hl).2
            refine if_neg (fun h => ?_)
            obtain ⟨hn_eq, hl_eq⟩ := Prod.mk.inj h
            have hL_lt : |L_hat i - z_pt 0| < r := by dsimp [L_hat]; rwa [hl_eq]
            exact hi ⟨hn_eq, hL_lt⟩
        rw [heq]
        exact h_L_cond n_star (z_pt 0) r hr0 hr1
      have h_sum_SZ : (∑ k_Z ∈ S_Z, ∑ i : Fin N_P, if bZ₁ i = k_Z then ν_P i else 0) ≤
          ρ ^ (-η_sl) * r ^ z := by
        have heq : (∑ k_Z ∈ S_Z, ∑ i : Fin N_P, if bZ₁ i = k_Z then ν_P i else 0) =
            ∑ i : Fin N_P, if |Z₁_hat i - z_pt 1| < r then ν_P i else 0 := by
          rw [Finset.sum_comm]
          refine Finset.sum_congr rfl (fun i _ => ?_)
          by_cases hi : |Z₁_hat i - z_pt 1| < r
          · rw [if_pos hi, Finset.sum_eq_single (bZ₁ i)]
            · exact if_pos rfl
            · intro k_Z _ hk; exact if_neg (Ne.symm hk)
            · intro hnot
              exfalso
              exact hnot (Finset.mem_filter.mpr
                ⟨Finset.mem_image_of_mem _ (Finset.mem_univ i), hi⟩)
          · rw [if_neg hi]
            refine Finset.sum_eq_zero (fun k_Z hk => ?_)
            have hk_lt : |((k_Z : ℝ) + 1 / 2) * ρ - z_pt 1| < r := (Finset.mem_filter.mp hk).2
            exact if_neg (fun h => hi (by simpa [Z₁_hat, h] using hk_lt))
        rw [heq]
        refine le_trans (le_of_eq ?_) (h_Z_ball (z_pt 1) r hr0 hr1)
        refine Finset.sum_congr rfl (fun i _ => ?_)
        split_ifs <;> rfl
      have h_swap : (∑ i : Fin N_P, (∑ l_bin ∈ S_L, ∑ k_Z ∈ S_Z,
          if bX i = kX_star ∧ (N_bin i, L_bin i) = (n_star, l_bin) ∧ bZ₁ i = k_Z
          then ν_P i else 0) / p_sl) =
          (∑ l_bin ∈ S_L, ∑ k_Z ∈ S_Z, ∑ i : Fin N_P,
            if bX i = kX_star ∧ (N_bin i, L_bin i) = (n_star, l_bin) ∧ bZ₁ i = k_Z
            then ν_P i else 0) / p_sl := by
        rw [← Finset.sum_div, Finset.sum_comm]
        congr 1
        refine Finset.sum_congr rfl (fun _ _ => Finset.sum_comm)
      have h_ratio_le2 : (p_X_star * p_N_star) / p_sl ≤ 2 := by
        rw [div_le_iff₀ hp_sl_pos]
        linarith [h_sl_gt]
      calc (∑ i : Fin N_P, @ite ℝ (‖x_P i - z_pt‖ < r) (Classical.propDecidable _) (μ_sl i) 0)
          ≤ (∑ l_bin ∈ S_L, ∑ k_Z ∈ S_Z, ∑ i : Fin N_P,
              if bX i = kX_star ∧ (N_bin i, L_bin i) = (n_star, l_bin) ∧ bZ₁ i = k_Z
              then ν_P i else 0) / p_sl := by
            rw [← h_swap]
            exact Finset.sum_le_sum (fun i _ => h_pt_sl i)
        _ ≤ (∑ l_bin ∈ S_L, ∑ k_Z ∈ S_Z,
              ρ ^ (-η_sl) * p_X_star *
                (∑ i, if (N_bin i, L_bin i) = (n_star, l_bin) then ν_P i else 0) *
                (∑ i, if bZ₁ i = k_Z then ν_P i else 0)) / p_sl := by
            refine div_le_div_of_nonneg_right ?_ hp_sl_pos.le
            exact Finset.sum_le_sum (fun l_bin _ =>
              Finset.sum_le_sum (fun k_Z _ => h_prod_XNLZ kX_star n_star l_bin k_Z))
        _ = (ρ ^ (-η_sl) * p_X_star / p_sl) *
              (∑ l_bin ∈ S_L, ∑ i, if (N_bin i, L_bin i) = (n_star, l_bin) then ν_P i else 0) *
              (∑ k_Z ∈ S_Z, ∑ i, if bZ₁ i = k_Z then ν_P i else 0) := by
            have h_in1 : ∀ l_bin, (∑ k_Z ∈ S_Z,
                ρ ^ (-η_sl) * p_X_star *
                  (∑ i, if (N_bin i, L_bin i) = (n_star, l_bin) then ν_P i else 0) *
                  (∑ i, if bZ₁ i = k_Z then ν_P i else 0)) =
                (ρ ^ (-η_sl) * p_X_star *
                  (∑ k_Z ∈ S_Z, ∑ i, if bZ₁ i = k_Z then ν_P i else 0)) *
                (∑ i, if (N_bin i, L_bin i) = (n_star, l_bin) then ν_P i else 0) := by
              intro l_bin
              rw [← Finset.mul_sum]
              ring
            simp_rw [h_in1, ← Finset.mul_sum]
            ring
        _ ≤ (ρ ^ (-η_sl) * p_X_star / p_sl) *
              (12 * ρ ^ (-3 * η_sl) * p_N_star * r ^ x) *
              (ρ ^ (-η_sl) * r ^ z) := by
            have hL_nn : 0 ≤ ∑ l_bin ∈ S_L, ∑ i,
                if (N_bin i, L_bin i) = (n_star, l_bin) then ν_P i else 0 :=
              Finset.sum_nonneg (fun _ _ => Finset.sum_nonneg (fun i _ => by
                split_ifs; exact hν_P_nn i; exact le_rfl))
            have hZ_nn : 0 ≤ ∑ k_Z ∈ S_Z, ∑ i, if bZ₁ i = k_Z then ν_P i else 0 :=
              Finset.sum_nonneg (fun _ _ => Finset.sum_nonneg (fun i _ => by
                split_ifs; exact hν_P_nn i; exact le_rfl))
            have hc_nn : 0 ≤ ρ ^ (-η_sl) * p_X_star / p_sl :=
              div_nonneg (mul_nonneg (Real.rpow_nonneg hρ.le _) hpX_nn) hp_sl_pos.le
            exact mul_le_mul
              (mul_le_mul_of_nonneg_left h_sum_SL hc_nn)
              h_sum_SZ hZ_nn
              (mul_nonneg hc_nn (mul_nonneg (mul_nonneg (by positivity) hpN_nn)
                (Real.rpow_nonneg hr_pos.le x)))
        _ = 12 * (ρ ^ (-η_sl) * ρ ^ (-3 * η_sl) * ρ ^ (-η_sl)) *
              ((p_X_star * p_N_star) / p_sl) * (r ^ x * r ^ z) := by ring
        _ = 12 * ρ ^ (-5 * η_sl) * ((p_X_star * p_N_star) / p_sl) * r ^ (x + z) := by
            rw [← Real.rpow_add hρ, ← Real.rpow_add hρ, ← Real.rpow_add hr_pos]
            ring_nf
        _ ≤ 12 * ρ ^ (-5 * η_sl) * 2 * r ^ (x + z) :=
            mul_le_mul_of_nonneg_right
              (mul_le_mul_of_nonneg_left h_ratio_le2 (by positivity))
              (Real.rpow_nonneg hr_pos.le _)
        _ = (24 * ρ ^ (-5 * η_sl)) * r ^ (x + z) := by ring
        _ ≤ ρ ^ (-η₀) * r ^ (x + z) :=
            mul_le_mul_of_nonneg_right h24_pow (Real.rpow_nonneg hr_pos.le _)
    · intro a₀ r hr0 hr1
      have h_a := h_a_ball a₀ r hr0 hr1
      have h_pow : ρ ^ (-η_sl) ≤ ρ ^ (-η₀) :=
        Real.rpow_le_rpow_of_exponent_ge hρ hρ_lt1.le (by dsimp [η_sl]; linarith)
      refine le_trans (le_of_eq ?_)
        (le_trans h_a (mul_le_mul_of_nonneg_right h_pow
