      exact hV_pφ
    have hs1 : (inner ℝ δV e_φ / d₂₀) ^ 2 ≤ 100 :=
      le_trans (h_sq_of_abs (inner ℝ δV e_φ / d₂₀) 10 (by norm_num) h1) (by norm_num)
    have hs2 : (inner ℝ δV (perp2D e_φ) / d₂₁) ^ 2 ≤ 100 :=
      le_trans (h_sq_of_abs (inner ℝ δV (perp2D e_φ) / d₂₁) 10 (by norm_num) h2) (by norm_num)
    linarith
  have huU_sq : (inner ℝ δU e_φ / d₂₀) ^ 2 + (inner ℝ δU (perp2D e_φ) / d₂₁) ^ 2 ≤ 450 := by
    change |inner ℝ δV e_φ| ≤ 10 * d₂₀ at hV_φ
    change |inner ℝ δV (perp2D e_φ)| ≤ 10 * d₂₁ at hV_pφ
    change |inner ℝ δA e_φ| ≤ 10 * d₂₀ at hA_φ
    change |inner ℝ δA (perp2D e_φ)| ≤ 10 * d₂₁ at hA_pφ
    have hU_φ : |inner ℝ δU e_φ| ≤ 15 * d₂₀ := by
