          have hR_pos : 0 < R a b := (div_pos_iff_of_pos_right hm_good_pos).mp hG_pos
          have h_mid : paramTreeMid ρ j (blk.θ_seq l a) = a_mid := h_mid_eq a a_par hc.1
          refine ⟨hR_supp a b hR_pos, hc.1, ?_⟩
