    let ℓ_δ : (EuclideanSpace ℝ (Fin 2) →L[ℝ] EuclideanSpace ℝ (Fin 2)) →L[ℝ] ℝ :=
      (ε_sgn * lam_loc * s) • ((InnerProductSpace.toDual ℝ (EuclideanSpace ℝ (Fin 2)) δ).comp
        (ContinuousLinearMap.apply ℝ (EuclideanSpace ℝ (Fin 2)) τ_P))
    have hℓ_norm : ‖ℓ_δ‖ ≤ L * (4 * B_cell ^ 2 / a₀) := by
      have h_cap_pos : 0 < L * (4 * B_cell ^ 2 / a₀) := by positivity
      refine ContinuousLinearMap.opNorm_le_bound _ h_cap_pos.le (fun T => ?_)
      have h_app : ℓ_δ T = (ε_sgn * lam_loc * s) * inner ℝ δ (T τ_P) := by
        simp [ℓ_δ, InnerProductSpace.toDual_apply_apply]
      rw [h_app, Real.norm_eq_abs, abs_mul, abs_mul, abs_mul, hε_abs, one_mul,
        abs_of_pos hlam, abs_of_pos hs]
      have h_inner_le : |inner ℝ δ (T τ_P)| ≤ ‖δ‖ * ‖T‖ := by
        calc |inner ℝ δ (T τ_P)| ≤ ‖δ‖ * ‖T τ_P‖ := abs_real_inner_le_norm δ (T τ_P)
