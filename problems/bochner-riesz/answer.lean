              = (s_c⁻¹ * s_c) * ((c_end - 1 / 2) * s_v⁻¹) := by
                rw [inv_mul_cancel₀ hsc_pos.ne', one_mul]
            _ = (s_c⁻¹ * s_v⁻¹) * ((c_end - 1 / 2) * s_c) := by ring
        dsimp only [P_α, X'_at, V'_at, X'_D, w_X2, w_X3]
        rw [smul_smul, h_coeff, mul_smul, ← smul_add, ← smul_sub, ← smul_add]
