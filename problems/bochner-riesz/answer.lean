            Finset.sum_le_sum (fun tid _ => Finset.sum_le_sum (fun d _ => h_kl_term tid d))
          have h2 : ∑ tid : Fin N_T, ∑ d : Fin N_D, (p_T tid * q_D d - q tid d) = 0 := by
            have h_row0 : ∀ tid : Fin N_T, ∑ d : Fin N_D, (p_T tid * q_D d - q tid d) = 0 := by
              intro tid
              rw [Finset.sum_sub_distrib, ← Finset.mul_sum, hqD_sum, hq_row tid, mul_one, sub_self]
            exact Finset.sum_eq_zero (fun tid _ => h_row0 tid)
          simp_rw [Finset.sum_neg_distrib] at h1
          linarith
        have hI_nn : 0 ≤ (∑ tid : Fin N_T, ∑ d : Fin N_D,
            q tid d * Real.log (q tid d / (p_T tid * q_D d))) / ell :=
          div_nonneg h_kl_sum hell_pos.le
        have hEw_ub : ∑ d : Fin N_D, q_D d * ((1 + γ) * b_D d + (1 - γ) * a_D d) ≤ 2 * L := by
          calc ∑ d : Fin N_D, q_D d * ((1 + γ) * b_D d + (1 - γ) * a_D d)
              ≤ ∑ d : Fin N_D, q_D d * (2 * L) := by
                refine Finset.sum_le_sum (fun d _ => mul_le_mul_of_nonneg_left ?_ (hqD_nn d))
                have hbL : b_D d ≤ L := le_trans (h_adm d).2.1 (h_adm d).2.2.1
                have haL : a_D d ≤ L := (h_adm d).2.2.1
                nlinarith
            _ = (∑ d : Fin N_D, q_D d) * (2 * L) := (Finset.sum_mul _ _ _).symm
            _ = 2 * L := by rw [hqD_sum, one_mul]
        dsimp only at hs_eq
        linarith
    refine ⟨h_ne_bdd, ?_⟩
    intro L₁ L₂ hL₁ hL₂
    change sSup (S_root L₂) ≤ sSup (S_root L₁) + 2 * max (L₂ - L₁) 0
    have h_ne2 : (S_root L₂).Nonempty := ⟨0, (h_ne_bdd L₂ hL₂).1⟩
    have h_bdd1 : BddAbove (S_root L₁) := (h_ne_bdd L₁ hL₁).2
    rcases le_or_gt L₂ L₁ with h_le | h_gt
    · rw [max_eq_right (by linarith), mul_zero, add_zero]
      refine csSup_le_csSup h_bdd1 h_ne2 ?_
      rintro s ⟨N_D, b_D, a_D, e_D, V_D, A_D, q, h_adm, h2, h3, h4, h5⟩
      exact ⟨N_D, b_D, a_D, e_D, V_D, A_D, q,
        fun d => ⟨(h_adm d).1, (h_adm d).2.1, le_trans (h_adm d).2.2.1 h_le, (h_adm d).2.2.2⟩,
        h2, h3, h4, h5⟩
    · rw [max_eq_left (by linarith)]
      refine csSup_le h_ne2 ?_
      rintro s ⟨N_D, b_D, a_D, e_D, V_D, A_D, q, h_adm, hq_nn, hq_row, h_geom, hs_eq⟩
      let b'_D : Fin N_D → ℝ := fun d => min (b_D d) L₁
      let a'_D : Fin N_D → ℝ := fun d => min (a_D d) L₁
      let q_D := fun d => ∑ tid : Fin N_T, q tid d
      let I_TD := (∑ tid : Fin N_T, ∑ d : Fin N_D,
        q tid d * Real.log (q tid d / (p_T tid * q_D d))) / ell
      let E'_w := ∑ d : Fin N_D, q_D d * ((1 + γ) * b'_D d + (1 - γ) * a'_D d)
      have hs'_mem : E'_w - I_TD ∈ S_root L₁ := by
        refine ⟨N_D, b'_D, a'_D, e_D, V_D, A_D, q, ?_, hq_nn, hq_row, ?_, rfl⟩
        · intro d
          exact ⟨le_min (h_adm d).1 hL₁,
                 min_le_min_right L₁ (h_adm d).2.1,
                 min_le_right _ _,
                 (h_adm d).2.2.2⟩
        · intro tid d hq_pos
          obtain ⟨hg1, hg2, hg3, hg4⟩ := h_geom tid d hq_pos
          have hε_le1 : ε ≤ 1 := by linarith
          have h_pow_b : 10 * ε ^ (b_D d) ≤ 10 * ε ^ (b'_D d) :=
            mul_le_mul_of_nonneg_left
              (Real.rpow_le_rpow_of_exponent_ge hε₀ hε_le1 (min_le_left _ _)) (by norm_num)
          have h_pow_a : 10 * ε ^ (a_D d) ≤ 10 * ε ^ (a'_D d) :=
            mul_le_mul_of_nonneg_left
              (Real.rpow_le_rpow_of_exponent_ge hε₀ hε_le1 (min_le_left _ _)) (by norm_num)
          exact ⟨hg1.trans h_pow_b, hg2.trans h_pow_a, hg3.trans h_pow_b, hg4.trans h_pow_a⟩
      have hs'_le : E'_w - I_TD ≤ sSup (S_root L₁) := le_csSup h_bdd1 hs'_mem
      have hqD_nn : ∀ d, 0 ≤ q_D d := fun d =>
        Finset.sum_nonneg (fun tid _ => hq_nn tid d)
      have hqD_sum : ∑ d : Fin N_D, q_D d = 1 := by
        dsimp only [q_D]
        rw [Finset.sum_comm]
        simp_rw [hq_row]
        exact hpT_sum
      have h_diff_w : (∑ d : Fin N_D, q_D d * ((1 + γ) * b_D d + (1 - γ) * a_D d)) - E'_w ≤
          2 * (L₂ - L₁) := by
        dsimp only [E'_w]
        rw [← Finset.sum_sub_distrib]
        calc ∑ d : Fin N_D,
              (q_D d * ((1 + γ) * b_D d + (1 - γ) * a_D d) -
               q_D d * ((1 + γ) * b'_D d + (1 - γ) * a'_D d))
            ≤ ∑ d : Fin N_D, q_D d * (2 * (L₂ - L₁)) := by
              refine Finset.sum_le_sum (fun d _ => ?_)
              rw [← mul_sub]
              refine mul_le_mul_of_nonneg_left ?_ (hqD_nn d)
              have hb_diff : b_D d - b'_D d ≤ L₂ - L₁ := by
                dsimp only [b'_D]
                have hbL2 : b_D d ≤ L₂ := le_trans (h_adm d).2.1 (h_adm d).2.2.1
                rcases le_total (b_D d) L₁ with h | h
                · rw [min_eq_left h]; linarith
                · rw [min_eq_right h]; linarith
              have ha_diff : a_D d - a'_D d ≤ L₂ - L₁ := by
                dsimp only [a'_D]
                have haL2 : a_D d ≤ L₂ := (h_adm d).2.2.1
                rcases le_total (a_D d) L₁ with h | h
                · rw [min_eq_left h]; linarith
                · rw [min_eq_right h]; linarith
              nlinarith
          _ = (∑ d : Fin N_D, q_D d) * (2 * (L₂ - L₁)) := (Finset.sum_mul _ _ _).symm
          _ = 2 * (L₂ - L₁) := by rw [hqD_sum, one_mul]
      dsimp only at hs_eq
      linarith

  
  have h_prob_bounds : ∀ {N_ω : ℕ} {α β : Type} (π : Fin N_ω → ℝ)
      (X : Fin N_ω → α) (Y : Fin N_ω → β),
      (∀ ω, 0 ≤ π ω) → ∀ ω : Fin N_ω,
        0 ≤ finProbAt2 π X Y ω ∧
        finProbAt2 π X Y ω ≤ finProbAt π X ω ∧
        π ω ≤ finProbAt2 π X Y ω := by
    intro N_ω α β π X Y hπ_nn ω
    refine ⟨?_, ?_, ?_⟩
    · unfold finProbAt2
      exact Finset.sum_nonneg (fun ω' _ => by split_ifs <;> [exact hπ_nn ω'; exact le_rfl])
    · unfold finProbAt2 finProbAt
      refine Finset.sum_le_sum (fun ω' _ => ?_)
      by_cases hX : X ω' = X ω
      · by_cases hY : Y ω' = Y ω
        · rw [if_pos ⟨hX, hY⟩, if_pos hX]
        · rw [if_neg (fun h => hY h.2), if_pos hX]; exact hπ_nn ω'
      · rw [if_neg (fun h => hX h.1), if_neg hX]
    · unfold finProbAt2
      have h_mem : ω ∈ (Finset.univ : Finset (Fin N_ω)) := Finset.mem_univ ω
      have h_le := Finset.single_le_sum
        (f := fun ω' => @ite ℝ (X ω' = X ω ∧ Y ω' = Y ω) (Classical.propDecidable _) (π ω') 0)
        (fun ω' _ => by split_ifs <;> [exact hπ_nn ω'; exact le_rfl]) h_mem
      simpa using h_le
  have h_ent_nonneg : ∀ (ε : ℝ), 0 < ε → ε < 1 / 2 →
      ∀ {N_ω : ℕ} {α β : Type} (π : Fin N_ω → ℝ) (X : Fin N_ω → α) (Y : Fin N_ω → β),
        (∀ ω, 0 ≤ π ω) → 0 ≤ finCondEntropy ε π X Y := by
    intro ε hε₀ hε₁ N_ω α β π X Y hπ_nn
    have hell_pos : 0 < Real.log (ε⁻¹) := (h_ell_pos ε hε₀ hε₁).2
    unfold finCondEntropy condSurprise
    refine Finset.sum_nonneg (fun ω _ => ?_)
    by_cases h0 : π ω = 0
    · simp [h0]
    · have hπ_pos : 0 < π ω := lt_of_le_of_ne (hπ_nn ω) (Ne.symm h0)
      obtain ⟨_, h_le, h_ge⟩ := h_prob_bounds π X Y hπ_nn ω
      have hXY_pos : 0 < finProbAt2 π X Y ω := lt_of_lt_of_le hπ_pos h_ge
      have hX_pos : 0 < finProbAt π X ω := lt_of_lt_of_le hXY_pos h_le
      have h_log_np : Real.log (finProbAt2 π X Y ω / finProbAt π X ω) ≤ 0 :=
        Real.log_nonpos (div_nonneg hXY_pos.le hX_pos.le) ((div_le_one hX_pos).mpr h_le)
      exact mul_nonneg hπ_pos.le (div_nonneg (neg_nonneg.mpr h_log_np) hell_pos.le)
  have h_ent_pair : ∀ (ε : ℝ) {N_ω : ℕ} {α β δ_t : Type} (π : Fin N_ω → ℝ)
      (X : Fin N_ω → α) (A : Fin N_ω → β) (B : Fin N_ω → δ_t),
      (∀ ω, 0 ≤ π ω) →
      finCondEntropy ε π X (fun ω => (A ω, B ω)) =
        finCondEntropy ε π X A + finCondEntropy ε π (fun ω => (X ω, A ω)) B := by
    intro ε N_ω α β δ_t π X A B hπ_nn
    unfold finCondEntropy condSurprise
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun ω _ => ?_)
    by_cases h0 : π ω = 0
    · simp [h0]
    · have hπ_pos : 0 < π ω := lt_of_le_of_ne (hπ_nn ω) (Ne.symm h0)
      have hpX_pos : 0 < finProbAt π X ω :=
        lt_of_lt_of_le hπ_pos (le_trans (h_prob_bounds π X A hπ_nn ω).2.2
          (h_prob_bounds π X A hπ_nn ω).2.1)
      have hpXA_pos : 0 < finProbAt2 π X A ω :=
        lt_of_lt_of_le hπ_pos (h_prob_bounds π X A hπ_nn ω).2.2
      have hpXAB_pos : 0 < finProbAt2 π X (fun ω' => (A ω', B ω')) ω :=
        lt_of_lt_of_le hπ_pos (h_prob_bounds π X (fun ω' => (A ω', B ω')) hπ_nn ω).2.2
      have heq1 : finProbAt π (fun ω' => (X ω', A ω')) ω = finProbAt2 π X A ω := by
        unfold finProbAt finProbAt2
        exact Finset.sum_congr rfl (fun ω' _ => h_ite_iff _ _ Prod.ext_iff)
      have heq2 : finProbAt2 π (fun ω' => (X ω', A ω')) B ω =
          finProbAt2 π X (fun ω' => (A ω', B ω')) ω := by
        unfold finProbAt2
        exact Finset.sum_congr rfl (fun ω' _ => h_ite_iff _ _
          ⟨fun h => ⟨(Prod.ext_iff.mp h.1).1, Prod.ext_iff.mpr ⟨(Prod.ext_iff.mp h.1).2, h.2⟩⟩,
           fun h => ⟨Prod.ext_iff.mpr ⟨h.1, (Prod.ext_iff.mp h.2).1⟩, (Prod.ext_iff.mp h.2).2⟩⟩)
      rw [heq1, heq2]
      have h_mul : finProbAt2 π X (fun ω' => (A ω', B ω')) ω / finProbAt π X ω =
          (finProbAt2 π X A ω / finProbAt π X ω) *
          (finProbAt2 π X (fun ω' => (A ω', B ω')) ω / finProbAt2 π X A ω) := by
        field_simp [hpX_pos.ne', hpXA_pos.ne']
      rw [h_mul, Real.log_mul (div_pos hpXA_pos hpX_pos).ne' (div_pos hpXAB_pos hpXA_pos).ne']
      ring
  have h_ent_swap_rhs : ∀ (ε : ℝ) {N_ω : ℕ} {α β δ_t : Type} (π : Fin N_ω → ℝ)
      (X : Fin N_ω → α) (A : Fin N_ω → β) (B : Fin N_ω → δ_t),
      finCondEntropy ε π X (fun ω => (A ω, B ω)) =
        finCondEntropy ε π X (fun ω => (B ω, A ω)) := by
    intro ε N_ω α β δ_t π X A B
    unfold finCondEntropy condSurprise
    refine Finset.sum_congr rfl (fun ω _ => ?_)
    have heq : finProbAt2 π X (fun ω' => (A ω', B ω')) ω =
        finProbAt2 π X (fun ω' => (B ω', A ω')) ω := by
      unfold finProbAt2
      exact Finset.sum_congr rfl (fun ω' _ => h_ite_iff _ _
        ⟨fun h => ⟨h.1, Prod.ext_iff.mpr (Prod.ext_iff.mp h.2).symm⟩,
         fun h => ⟨h.1, Prod.ext_iff.mpr (Prod.ext_iff.mp h.2).symm⟩⟩)
    rw [heq]
  have h_ent_swap_lhs : ∀ (ε : ℝ) {N_ω : ℕ} {α β δ_t : Type} (π : Fin N_ω → ℝ)
      (A : Fin N_ω → α) (B : Fin N_ω → β) (Y : Fin N_ω → δ_t),
      finCondEntropy ε π (fun ω => (A ω, B ω)) Y =
        finCondEntropy ε π (fun ω => (B ω, A ω)) Y := by
    intro ε N_ω α β δ_t π A B Y
    unfold finCondEntropy condSurprise
    refine Finset.sum_congr rfl (fun ω _ => ?_)
    have heq1 : finProbAt π (fun ω' => (A ω', B ω')) ω =
        finProbAt π (fun ω' => (B ω', A ω')) ω := by
      unfold finProbAt
      exact Finset.sum_congr rfl (fun ω' _ => h_ite_iff _ _
        ⟨fun h => Prod.ext_iff.mpr (Prod.ext_iff.mp h).symm,
         fun h => Prod.ext_iff.mpr (Prod.ext_iff.mp h).symm⟩)
    have heq2 : finProbAt2 π (fun ω' => (A ω', B ω')) Y ω =
        finProbAt2 π (fun ω' => (B ω', A ω')) Y ω := by
      unfold finProbAt2
      exact Finset.sum_congr rfl (fun ω' _ => h_ite_iff _ _
        ⟨fun h => ⟨Prod.ext_iff.mpr (Prod.ext_iff.mp h.1).symm, h.2⟩,
         fun h => ⟨Prod.ext_iff.mpr (Prod.ext_iff.mp h.1).symm, h.2⟩⟩)
    rw [heq1, heq2]
  have h_ent_unit_lhs : ∀ (ε : ℝ) {N_ω : ℕ} {α β : Type} (π : Fin N_ω → ℝ)
      (X : Fin N_ω → α) (Y : Fin N_ω → β),
      finCondEntropy ε π (fun ω => ((), X ω)) Y = finCondEntropy ε π X Y := by
    intro ε N_ω α β π X Y
    unfold finCondEntropy condSurprise
    refine Finset.sum_congr rfl (fun ω _ => ?_)
    have heq1 : finProbAt π (fun ω' => ((), X ω')) ω = finProbAt π X ω := by
      unfold finProbAt
      exact Finset.sum_congr rfl (fun ω' _ => h_ite_iff _ _
        ⟨fun h => (Prod.ext_iff.mp h).2, fun h => Prod.ext rfl h⟩)
    have heq2 : finProbAt2 π (fun ω' => ((), X ω')) Y ω = finProbAt2 π X Y ω := by
      unfold finProbAt2
      exact Finset.sum_congr rfl (fun ω' _ => h_ite_iff _ _
        ⟨fun h => ⟨(Prod.ext_iff.mp h.1).2, h.2⟩, fun h => ⟨Prod.ext rfl h.1, h.2⟩⟩)
    rw [heq1, heq2]
  have h_ent_drop_cond : ∀ (ε : ℝ), 0 < ε → ε < 1 / 2 →
      ∀ {N_ω : ℕ} {α β δ_t : Type} (π : Fin N_ω → ℝ)
        (X : Fin N_ω → α) (B : Fin N_ω → β) (A : Fin N_ω → δ_t),
        (∀ ω, 0 ≤ π ω) → (∑ ω : Fin N_ω, π ω = 1) →
        finCondEntropy ε π (fun ω => (X ω, B ω)) A ≤ finCondEntropy ε π X A := by
    intro ε hε₀ hε₁ N_ω α β δ_t π X B A hπ_nn hπ_sum
    have hell_pos : 0 < Real.log (ε⁻¹) := (h_ell_pos ε hε₀ hε₁).2
    have hell_ne : Real.log (ε⁻¹) ≠ 0 := hell_pos.ne'
    let F_pos : Finset (Fin N_ω) := Finset.univ.filter (fun ω => 0 < π ω)
    have hπ_zero_of_not_mem : ∀ ω, ω ∉ F_pos → π ω = 0 := by
      intro ω hω
      simp only [F_pos, Finset.mem_filter, Finset.mem_univ, true_and, not_lt] at hω
      exact le_antisymm hω (hπ_nn ω)
    have h_sum_Fpos : ∀ g : Fin N_ω → ℝ,
        ∑ ω : Fin N_ω, π ω * g ω = ∑ ω ∈ F_pos, π ω * g ω := by
      intro g
      rw [← Finset.sum_subset (Finset.subset_univ F_pos)]
      intro ω _ hω
      rw [hπ_zero_of_not_mem ω hω, zero_mul]
    have h_Fpos_one : ∑ ω ∈ F_pos, π ω = 1 := by
      have h1 := h_sum_Fpos (fun _ => 1)
      simp only [mul_one] at h1
      linarith
    let ImgX := F_pos.image X
    let ImgB := F_pos.image B
    let ImgA := F_pos.image A
    let mX : α → ℝ := fun x => ∑ ω ∈ F_pos, if X ω = x then π ω else 0
    let mXA : α → δ_t → ℝ := fun x a => ∑ ω ∈ F_pos, if X ω = x ∧ A ω = a then π ω else 0
    let mXB : α → β → ℝ := fun x b => ∑ ω ∈ F_pos, if X ω = x ∧ B ω = b then π ω else 0
    let mXBA : α → β → δ_t → ℝ := fun x b a =>
      ∑ ω ∈ F_pos, if (X ω = x ∧ B ω = b) ∧ A ω = a then π ω else 0
    have hmX_nn : ∀ x, 0 ≤ mX x := fun x =>
      Finset.sum_nonneg (fun ω _ => by split_ifs <;> [exact hπ_nn ω; exact le_rfl])
    have hmXA_nn : ∀ x a, 0 ≤ mXA x a := fun x a =>
      Finset.sum_nonneg (fun ω _ => by split_ifs <;> [exact hπ_nn ω; exact le_rfl])
    have hmXB_nn : ∀ x b, 0 ≤ mXB x b := fun x b =>
      Finset.sum_nonneg (fun ω _ => by split_ifs <;> [exact hπ_nn ω; exact le_rfl])
    have h_diff_ell :
        (finCondEntropy ε π (fun ω => (X ω, B ω)) A - finCondEntropy ε π X A) *
          Real.log (ε⁻¹) ≤ 0 := by
      unfold finCondEntropy
      rw [h_sum_Fpos, h_sum_Fpos, ← Finset.sum_sub_distrib, Finset.sum_mul]
      have h_pt : ∀ ω ∈ F_pos,
          (π ω * condSurprise ε π (fun ω' => (X ω', B ω')) A ω -
           π ω * condSurprise ε π X A ω) * Real.log (ε⁻¹) ≤
          π ω * ((mXA (X ω) (A ω) * mXB (X ω) (B ω)) /
            (mX (X ω) * mXBA (X ω) (B ω) (A ω))) - π ω := by
        intro ω hω
        have hπ_pos : 0 < π ω := (Finset.mem_filter.mp hω).2
        have h_eq_mX : finProbAt π X ω = mX (X ω) := by
          unfold finProbAt
          have h1 := h_sum_Fpos (fun ω' => if X ω' = X ω then 1 else 0)
          simp only [mul_ite, mul_one, mul_zero] at h1
          exact (Finset.sum_congr rfl (fun ω' _ => h_ite_iff _ _ Iff.rfl)).trans
            (h1.trans (Finset.sum_congr rfl (fun ω' _ => h_ite_iff _ _ Iff.rfl)))
        have h_eq_mXA : finProbAt2 π X A ω = mXA (X ω) (A ω) := by
          unfold finProbAt2
          have h1 := h_sum_Fpos (fun ω' => if X ω' = X ω ∧ A ω' = A ω then 1 else 0)
          simp only [mul_ite, mul_one, mul_zero] at h1
          exact (Finset.sum_congr rfl (fun ω' _ => h_ite_iff _ _ Iff.rfl)).trans
            (h1.trans (Finset.sum_congr rfl (fun ω' _ => h_ite_iff _ _ Iff.rfl)))
        have h_eq_mXB : finProbAt π (fun ω' => (X ω', B ω')) ω = mXB (X ω) (B ω) := by
          unfold finProbAt
          have h1 := h_sum_Fpos (fun ω' => if X ω' = X ω ∧ B ω' = B ω then 1 else 0)
          simp only [mul_ite, mul_one, mul_zero] at h1
          exact (Finset.sum_congr rfl (fun ω' _ => h_ite_iff _ _ Prod.ext_iff)).trans
            (h1.trans (Finset.sum_congr rfl (fun ω' _ => h_ite_iff _ _ Iff.rfl)))
        have h_eq_mXBA : finProbAt2 π (fun ω' => (X ω', B ω')) A ω = mXBA (X ω) (B ω) (A ω) := by
          unfold finProbAt2
          have h1 := h_sum_Fpos (fun ω' => if (X ω' = X ω ∧ B ω' = B ω) ∧ A ω' = A ω then 1 else 0)
          simp only [mul_ite, mul_one, mul_zero] at h1
          exact (Finset.sum_congr rfl (fun ω' _ => h_ite_iff _ _
            ⟨fun h => ⟨Prod.ext_iff.mp h.1, h.2⟩, fun h => ⟨Prod.ext_iff.mpr h.1, h.2⟩⟩)).trans
            (h1.trans (Finset.sum_congr rfl (fun ω' _ => h_ite_iff _ _ Iff.rfl)))
        have hpX : 0 < mX (X ω) := by
          rw [← h_eq_mX]
          exact lt_of_lt_of_le hπ_pos (le_trans (h_prob_bounds π X A hπ_nn ω).2.2
            (h_prob_bounds π X A hπ_nn ω).2.1)
        have hpXA : 0 < mXA (X ω) (A ω) := by
          rw [← h_eq_mXA]
          exact lt_of_lt_of_le hπ_pos (h_prob_bounds π X A hπ_nn ω).2.2
        have hpXB : 0 < mXB (X ω) (B ω) := by
          rw [← h_eq_mXB]
          exact lt_of_lt_of_le hπ_pos (le_trans
            (h_prob_bounds π (fun ω' => (X ω', B ω')) A hπ_nn ω).2.2
            (h_prob_bounds π (fun ω' => (X ω', B ω')) A hπ_nn ω).2.1)
        have hpXBA : 0 < mXBA (X ω) (B ω) (A ω) := by
          rw [← h_eq_mXBA]
          exact lt_of_lt_of_le hπ_pos
            (h_prob_bounds π (fun ω' => (X ω', B ω')) A hπ_nn ω).2.2
        unfold condSurprise
