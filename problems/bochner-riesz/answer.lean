      have hm1' : 20 * (m : ℝ) * δ ≤ u + 10 * δ := by
        have h_eq : 20 * (m : ℝ) * δ = 20 * δ * (m : ℝ) := by ring
        linarith only [hm1, h_eq]
      have hm2' : u + 10 * δ < 20 * (m : ℝ) * δ + 20 * δ := by
        have h_eq : 20 * δ * ((m : ℝ) + 1) = 20 * (m : ℝ) * δ + 20 * δ := by ring
        linarith only [hm2, h_eq]
      refine ⟨abs_le.mpr ⟨by linarith only [hm1'], by linarith only [hm2']⟩, ?_⟩
      intro hu_le
      rw [Finset.mem_Icc]
      rw [abs_le] at hu_le
      have hceil : R_enl / 20 ≤ (⌈R_enl / 20⌉₊ : ℝ) := Nat.le_ceil _
      have hK_eq : (K_sub : ℝ) = (⌈R_enl / 20⌉₊ : ℝ) + 1 := by dsimp [K_sub]; push_cast; ring
      have hu1 := mul_le_mul_of_nonneg_left hu_le.1 (inv_nonneg.mpr h20δ.le)
      have hu2 := mul_le_mul_of_nonneg_left hu_le.2 (inv_nonneg.mpr h20δ.le)
      have hr1 : (20 * δ)⁻¹ * -(R_enl * δ) = -(R_enl / 20) := by field_simp [hδ.ne']
      have hr2 : (20 * δ)⁻¹ * (R_enl * δ) = R_enl / 20 := by field_simp [hδ.ne']
      rw [hr1] at hu1
      rw [hr2] at hu2
      have hlo_real : ((-(K_sub : ℤ) : ℤ) : ℝ) ≤ (m : ℝ) := by
        push_cast; linarith only [hlt, hu1, hceil, hK_eq]
      have hhi_real : (m : ℝ) ≤ ((K_sub : ℤ) : ℝ) := by
        push_cast; linarith only [hfl, hu2, hceil, hK_eq]
      exact ⟨Int.cast_le.mp hlo_real, Int.cast_le.mp hhi_real⟩
    let round1D : ℝ → ℝ → ℤ := fun δ u => ⌊(20 * δ)⁻¹ * u + 1 / 2⌋
    let m_vec : ((ℤ × ℤ) × (ℤ × ℤ)) → Fin N_D → ((ℤ × ℤ) × (ℤ × ℤ)) := fun o d =>
      let e := e_D d
      let ep := perp2D e
      let sb := ε ^ (b_D d)
      let sa := ε ^ (a_D d)
      ((round1D sb (inner ℝ (gridPt2D ρ₀ o.1 - V_D d) e),
        round1D sa (inner ℝ (gridPt2D ρ₀ o.1 - V_D d) ep)),
       (round1D sb (inner ℝ (gridPt2D ρ₀ o.2 - X_root d) e),
        round1D sa (inner ℝ (gridPt2D ρ₀ o.2 - X_root d) ep)))
    have hm_vec_props : ∀ o ∈ O₀, ∀ d : Fin N_D, 0 < π_root o d →
        m_vec o d ∈ boxSub ∧
        let m := m_vec o d
        let e := e_D d
        let ep := perp2D e
        let sb := ε ^ (b_D d)
        let sa := ε ^ (a_D d)
        let Vc := V_D d + (20 * (m.1.1 : ℝ) * sb) • e + (20 * (m.1.2 : ℝ) * sa) • ep
        let Xc := X_root d + (20 * (m.2.1 : ℝ) * sb) • e + (20 * (m.2.2 : ℝ) * sa) • ep
        |inner ℝ (gridPt2D ρ₀ o.1 - Vc) e| ≤ 10 * sb ∧
        |inner ℝ (gridPt2D ρ₀ o.1 - Vc) ep| ≤ 10 * sa ∧
        |inner ℝ (gridPt2D ρ₀ o.2 - Xc) e| ≤ 10 * sb ∧
        |inner ℝ (gridPt2D ρ₀ o.2 - Xc) ep| ≤ 10 * sa := by
      intro o ho d hpos
      obtain ⟨_, _, hb1, ha1, hb2, ha2⟩ := hπ_root_geom o ho d hpos
      have hsb : 0 < ε ^ (b_D d) := Real.rpow_pos_of_pos hε₀ _
      have hsa : 0 < ε ^ (a_D d) := Real.rpow_pos_of_pos hε₀ _
      have hr1 := h_round20 (ε ^ (b_D d)) (inner ℝ (gridPt2D ρ₀ o.1 - V_D d) (e_D d)) hsb
      have hr2 := h_round20 (ε ^ (a_D d)) (inner ℝ (gridPt2D ρ₀ o.1 - V_D d) (perp2D (e_D d))) hsa
      have hr3 := h_round20 (ε ^ (b_D d)) (inner ℝ (gridPt2D ρ₀ o.2 - X_root d) (e_D d)) hsb
      have hr4 := h_round20 (ε ^ (a_D d)) (inner ℝ (gridPt2D ρ₀ o.2 - X_root d) (perp2D (e_D d))) hsa
      have hmem : m_vec o d ∈ boxSub := by
        simp only [boxSub, Finset.mem_product, m_vec, round1D]
        exact ⟨⟨hr1.2 hb1, hr2.2 ha1⟩, ⟨hr3.2 hb2, hr4.2 ha2⟩⟩
      have he_norm : ‖e_D d‖ = 1 := (hD_bound d).2.2.2.2
      obtain ⟨hep_eq, hee_perp, hperp_e⟩ := h_perp (e_D d)
      have hee : inner ℝ (e_D d) (e_D d) = 1 := by
        rw [real_inner_self_eq_norm_sq, he_norm, one_pow]
      have hepep : inner ℝ (perp2D (e_D d)) (perp2D (e_D d)) = 1 := by
        rw [real_inner_self_eq_norm_sq, hep_eq, he_norm, one_pow]
      have h_ortho : ∀ (w c₀ : EuclideanSpace ℝ (Fin 2)) (α₁ α₂ : ℝ),
          inner ℝ (w - (c₀ + α₁ • (e_D d) + α₂ • (perp2D (e_D d)))) (e_D d) =
            inner ℝ (w - c₀) (e_D d) - α₁ ∧
          inner ℝ (w - (c₀ + α₁ • (e_D d) + α₂ • (perp2D (e_D d)))) (perp2D (e_D d)) =
            inner ℝ (w - c₀) (perp2D (e_D d)) - α₂ := by
        intro w c₀ α₁ α₂
        have hsub : w - (c₀ + α₁ • (e_D d) + α₂ • (perp2D (e_D d))) =
            (w - c₀) - α₁ • (e_D d) - α₂ • (perp2D (e_D d)) := by abel
        rw [hsub]
        constructor
        · rw [inner_sub_left, inner_sub_left, inner_smul_left, inner_smul_left]
          simp only [RCLike.conj_to_real, hee, hperp_e]
          ring
        · rw [inner_sub_left, inner_sub_left, inner_smul_left, inner_smul_left]
          simp only [RCLike.conj_to_real, hee_perp, hepep]
          ring
      refine ⟨hmem, ?_⟩
      dsimp only
      have hoV := h_ortho (gridPt2D ρ₀ o.1) (V_D d)
        (20 * ((m_vec o d).1.1 : ℝ) * ε ^ (b_D d))
        (20 * ((m_vec o d).1.2 : ℝ) * ε ^ (a_D d))
      have hoX := h_ortho (gridPt2D ρ₀ o.2) (X_root d)
        (20 * ((m_vec o d).2.1 : ℝ) * ε ^ (b_D d))
        (20 * ((m_vec o d).2.2 : ℝ) * ε ^ (a_D d))
      rw [hoV.1, hoV.2, hoX.1, hoX.2]
      exact ⟨hr1.1, hr2.1, hr3.1, hr4.1⟩
    
    let e_idx : Fin N_D × ↥boxSub ≃ Fin (N_D * N_sub) :=
      (Equiv.prodCongr (Equiv.refl (Fin N_D)) boxSub.equivFin).trans finProdFinEquiv
    let d_of : Fin (N_D * N_sub) → Fin N_D := fun dt => (e_idx.symm dt).1
    let m_of : Fin (N_D * N_sub) → ((ℤ × ℤ) × (ℤ × ℤ)) := fun dt => ((e_idx.symm dt).2 : _)
    let b_tilde : Fin (N_D * N_sub) → ℝ := fun dt => b_D (d_of dt)
    let a_tilde : Fin (N_D * N_sub) → ℝ := fun dt => a_D (d_of dt)
    let e_tilde : Fin (N_D * N_sub) → EuclideanSpace ℝ (Fin 2) := fun dt => e_D (d_of dt)
    let V_tilde : Fin (N_D * N_sub) → EuclideanSpace ℝ (Fin 2) := fun dt =>
      let d := d_of dt
      let m := m_of dt
      V_D d + (20 * (m.1.1 : ℝ) * ε ^ (b_D d)) • (e_D d) +
        (20 * (m.1.2 : ℝ) * ε ^ (a_D d)) • (perp2D (e_D d))
    let X_tilde : Fin (N_D * N_sub) → EuclideanSpace ℝ (Fin 2) := fun dt =>
      let d := d_of dt
      let m := m_of dt
      X_root d + (20 * (m.2.1 : ℝ) * ε ^ (b_D d)) • (e_D d) +
        (20 * (m.2.2 : ℝ) * ε ^ (a_D d)) • (perp2D (e_D d))
    let p_comp : ((ℤ × ℤ) × (ℤ × ℤ)) → Fin (N_D * N_sub) → ℝ := fun o dt =>
      if m_vec o (d_of dt) = m_of dt then π_root o (d_of dt) else 0
    have h_sum_dt : ∀ G : Fin (N_D * N_sub) → ℝ,
        ∑ dt : Fin (N_D * N_sub), G dt =
          ∑ d : Fin N_D, ∑ m_sub : ↥boxSub, G (e_idx (d, m_sub)) := by
      intro G
      rw [← Equiv.sum_comp e_idx G, Fintype.sum_prod_type]
    have hd_of_apply : ∀ d m_sub, d_of (e_idx (d, m_sub)) = d := by
      intro d m_sub; dsimp [d_of]; rw [e_idx.symm_apply_apply]
    have hm_of_apply : ∀ d m_sub, m_of (e_idx (d, m_sub)) = (m_sub : _) := by
      intro d m_sub; dsimp [m_of]; rw [e_idx.symm_apply_apply]
    have hp_comp_sum_m : ∀ o d,
        ∑ m_sub : ↥boxSub, p_comp o (e_idx (d, m_sub)) = π_root o d := by
      intro o d
      have heq : ∑ m_sub : ↥boxSub, p_comp o (e_idx (d, m_sub)) =
          ∑ m ∈ boxSub, (if m_vec o d = m then π_root o d else 0) := by
        rw [← Finset.sum_coe_sort boxSub (fun m => if m_vec o d = m then π_root o d else 0)]
        refine Finset.sum_congr rfl (fun m_sub _ => ?_)
        dsimp [p_comp]
        rw [hd_of_apply, hm_of_apply]
      rw [heq]
      by_cases ho : o ∈ O₀
      · by_cases h0 : π_root o d = 0
        · simp [h0]
        · have hpos : 0 < π_root o d := lt_of_le_of_ne (hπ_root_nn o d) (Ne.symm h0)
          have hmem : m_vec o d ∈ boxSub := (hm_vec_props o ho d hpos).1
          simp [hmem]
      · have h0 : π_root o d = 0 := by dsimp [π_root]; rw [if_neg ho]
        simp [h0]
    let p_comp_O : ((ℤ × ℤ) × (ℤ × ℤ)) → ℝ := fun o => ∑ dt : Fin (N_D * N_sub), p_comp o dt
    let p_comp_D : Fin (N_D * N_sub) → ℝ := fun dt => ∑ o ∈ O₀, p_comp o dt
    have hp_comp_O_eq : ∀ o, p_comp_O o = π_O o := by
      intro o; dsimp [p_comp_O, π_O]
      rw [h_sum_dt]
      exact Finset.sum_congr rfl (fun d _ => hp_comp_sum_m o d)
    have hp_comp_D_sum_m : ∀ d : Fin N_D,
        ∑ m_sub : ↥boxSub, p_comp_D (e_idx (d, m_sub)) = p_cD d := by
      intro d; dsimp [p_comp_D]
      rw [Finset.sum_comm]
      calc ∑ o ∈ O₀, ∑ m_sub : ↥boxSub, p_comp o (e_idx (d, m_sub))
          = ∑ o ∈ O₀, π_root o d := Finset.sum_congr rfl (fun o _ => hp_comp_sum_m o d)
        _ = p_cD d := hπ_root_D d
    let s_comp : ℝ :=
      (∑ o ∈ O₀, -(p_comp_O o * Real.log (p_comp_O o))) / ell +
      (1 / 2 : ℝ) * ((∑ o ∈ O₀, ∑ dt : Fin (N_D * N_sub),
        -(p_comp o dt * Real.log (p_comp o dt / p_comp_D dt))) / ell) +
      (3 / 2 : ℝ) * ((∑ o ∈ O₀,
        p_comp_O o * Real.log (canonicalRootMass lam_sys Φ₀ f o)) / ell) +
      (1 / 2 : ℝ) * (∑ dt : Fin (N_D * N_sub),
        p_comp_D dt * ((1 + γ) * b_tilde dt + (1 - γ) * a_tilde dt))
    have hs_comp_mem : s_comp ∈ S_comp := by
      refine ⟨N_D * N_sub, b_tilde, a_tilde, e_tilde, V_tilde, X_tilde, p_comp,
        ?_, ?_, ?_, ?_, ?_, rfl⟩
      · intro dt
        have hd := hD_bound (d_of dt)
        have ha_min : a_D (d_of dt) ≤ min L (H_P / 2) := by
          refine le_min ?_ ?_
          · have h1 : a_D (d_of dt) ≤ L - t := le_trans hd.2.2.1 (min_le_left _ _)
            linarith only [h1, ht_pos]
          · have h1 : a_D (d_of dt) ≤ (H_P - t) / 2 := le_trans hd.2.2.1 (min_le_right _ _)
            linarith only [h1, ht_pos]
        exact ⟨hd.1, hd.2.1, ha_min, hd.2.2.2.2⟩
      · intro o dt; dsimp [p_comp]; split_ifs
        · exact hπ_root_nn o (d_of dt)
        · exact le_rfl
      · intro o dt ho; dsimp [p_comp, π_root]; rw [if_neg ho, ite_self]
      · calc ∑ o ∈ O₀, ∑ dt : Fin (N_D * N_sub), p_comp o dt
            = ∑ o ∈ O₀, π_O o := Finset.sum_congr rfl (fun o _ => hp_comp_O_eq o)
          _ = 1 := hπ_O_sum
      · intro o ho dt hpos
        dsimp [p_comp] at hpos
        split_ifs at hpos with hm_eq
        · have hcan_pos := (hπ_root_geom o ho (d_of dt) hpos).1
          have hm_pr := (hm_vec_props o ho (d_of dt) hpos).2
          dsimp only at hm_pr
          dsimp [V_tilde, X_tilde, b_tilde, a_tilde, e_tilde]
          rw [← hm_eq]
          exact ⟨hcan_pos, hm_pr⟩
        · exact False.elim (lt_irrefl 0 hpos)
    have hs_comp_le_root : s_comp ≤ generalPacketRootScore ε H_P L R_dom γ lam_sys Φ₀ f := by
      unfold generalPacketRootScore
      exact le_csSup h_root_bdd (Set.mem_union_right _ hs_comp_mem)
    
    have h_sub_HOD :
        ∑ o ∈ O₀, ∑ d : Fin N_D, -(π_root o d * Real.log (π_root o d / p_cD d)) ≤
          (∑ o ∈ O₀, ∑ dt : Fin (N_D * N_sub),
            -(p_comp o dt * Real.log (p_comp o dt / p_comp_D dt))) +
            Real.log (N_sub : ℝ) := by
      let β : Fin N_D → ((ℤ × ℤ) × (ℤ × ℤ)) → ℝ :=
        fun d m => ∑ o ∈ O₀, if m_vec o d = m then π_root o d else 0
      have hite_nn : ∀ o d m, 0 ≤ (if m_vec o d = m then π_root o d else 0) := by
        intro o d m
        split_ifs
        · exact hπ_root_nn o d
        · exact le_rfl
      have hβ_nn : ∀ d m, 0 ≤ β d m :=
        fun d m => Finset.sum_nonneg (fun o _ => hite_nn o d m)
      have hβ_eq_D : ∀ d (m_sub : ↥boxSub), β d m_sub.1 = p_comp_D (e_idx (d, m_sub)) := by
        intro d m_sub; dsimp [β, p_comp_D, p_comp]
        simp_rw [hd_of_apply, hm_of_apply]
      have hβ_sum : ∀ d : Fin N_D, ∑ m ∈ boxSub, β d m = p_cD d := by
        intro d
        rw [← Finset.sum_coe_sort boxSub (β d)]
        simp_rw [hβ_eq_D]
        exact hp_comp_D_sum_m d
      have h_each_d : ∀ d : Fin N_D,
          ∑ o ∈ O₀, -(π_root o d * Real.log (π_root o d / p_cD d)) ≤
            (∑ o ∈ O₀, ∑ m_sub : ↥boxSub,
              -(p_comp o (e_idx (d, m_sub)) *
                Real.log (p_comp o (e_idx (d, m_sub)) / p_comp_D (e_idx (d, m_sub))))) +
              p_cD d * Real.log (N_sub : ℝ) := by
        intro d
        have h_o_eq : ∀ o ∈ O₀,
            -(π_root o d * Real.log (π_root o d / p_cD d)) =
              (∑ m ∈ boxSub, -((if m_vec o d = m then π_root o d else 0) * Real.log (β d m / p_cD d))) +
              ∑ m_sub : ↥boxSub,
                -(p_comp o (e_idx (d, m_sub)) *
                  Real.log (p_comp o (e_idx (d, m_sub)) / p_comp_D (e_idx (d, m_sub)))) := by
          intro o ho
          by_cases hπ0 : π_root o d = 0
          · have hcomp0 : ∀ m_sub : ↥boxSub, p_comp o (e_idx (d, m_sub)) = 0 := by
              intro m_sub; dsimp [p_comp]; rw [hd_of_apply, hπ0, ite_self]
            simp [hπ0, hcomp0]
          · have hπ_pos : 0 < π_root o d := lt_of_le_of_ne (hπ_root_nn o d) (Ne.symm hπ0)
            let m₀ := m_vec o d
            have hm₀_mem : m₀ ∈ boxSub := (hm_vec_props o ho d hπ_pos).1
            let m₀_sub : ↥boxSub := ⟨m₀, hm₀_mem⟩
            have h1_sum : ∑ m ∈ boxSub,
                  -((if m₀ = m then π_root o d else 0) * Real.log (β d m / p_cD d)) =
                -(π_root o d * Real.log (β d m₀ / p_cD d)) := by
              have heq : ∑ m ∈ boxSub,
                    -((if m₀ = m then π_root o d else 0) * Real.log (β d m / p_cD d)) =
                  ∑ m ∈ boxSub, if m₀ = m then -(π_root o d * Real.log (β d m / p_cD d)) else 0 :=
                Finset.sum_congr rfl (fun m _ => by split_ifs <;> simp)
              rw [heq, Finset.sum_ite_eq boxSub m₀]
              exact if_pos hm₀_mem
            have h2_sum : ∑ m_sub : ↥boxSub,
                  -(p_comp o (e_idx (d, m_sub)) *
                    Real.log (p_comp o (e_idx (d, m_sub)) / p_comp_D (e_idx (d, m_sub)))) =
                -(π_root o d * Real.log (π_root o d / β d m₀)) := by
              have heq_fn : ∀ m_sub : ↥boxSub,
                  -(p_comp o (e_idx (d, m_sub)) *
                    Real.log (p_comp o (e_idx (d, m_sub)) / p_comp_D (e_idx (d, m_sub)))) =
                  if m₀_sub = m_sub then -(π_root o d * Real.log (π_root o d / β d m₀)) else 0 := by
                intro m_sub
                rw [← hβ_eq_D d m_sub]
                dsimp [p_comp]
                rw [hd_of_apply, hm_of_apply]
                by_cases hm : m₀ = m_sub.1
                · have hsub_eq : m₀_sub = m_sub := Subtype.ext hm
                  rw [if_pos hm, if_pos hsub_eq, ← hm]
                · have hsub_ne : m₀_sub ≠ m_sub := fun h => hm (congrArg Subtype.val h)
                  rw [if_neg hm, if_neg hsub_ne]
                  simp
              simp_rw [heq_fn]
              simp
            have hβ_pos : 0 < β d m₀ := by
              dsimp [β]
              refine lt_of_lt_of_le (by simpa [m₀] using hπ_pos)
                (Finset.single_le_sum (fun o' _ => hite_nn o' d m₀) ho)
            have hpcD_pos : 0 < p_cD d := by
              rw [← hβ_sum d]
              exact lt_of_lt_of_le hβ_pos (Finset.single_le_sum (fun m' _ => hβ_nn d m') hm₀_mem)
            have h_rat : π_root o d / p_cD d = (β d m₀ / p_cD d) * (π_root o d / β d m₀) := by
              field_simp [hβ_pos.ne', hpcD_pos.ne']
            change -(π_root o d * Real.log (π_root o d / p_cD d)) =
              (∑ m ∈ boxSub, -((if m₀ = m then π_root o d else 0) * Real.log (β d m / p_cD d))) +
              ∑ m_sub : ↥boxSub,
                -(p_comp o (e_idx (d, m_sub)) *
                  Real.log (p_comp o (e_idx (d, m_sub)) / p_comp_D (e_idx (d, m_sub))))
            rw [h1_sum, h2_sum, h_rat,
              Real.log_mul (div_pos hβ_pos hpcD_pos).ne' (div_pos hπ_pos hβ_pos).ne']
            ring
        rw [Finset.sum_congr rfl h_o_eq, Finset.sum_add_distrib]
        have h_β_ent : ∑ o ∈ O₀, ∑ m ∈ boxSub,
              -((if m_vec o d = m then π_root o d else 0) * Real.log (β d m / p_cD d)) ≤
            p_cD d * Real.log (N_sub : ℝ) := by
          rw [Finset.sum_comm]
          have heq : ∑ m ∈ boxSub, ∑ o ∈ O₀,
                -((if m_vec o d = m then π_root o d else 0) * Real.log (β d m / p_cD d)) =
              ∑ m ∈ boxSub, -(β d m * Real.log (β d m / p_cD d)) := by
            refine Finset.sum_congr rfl (fun m _ => ?_)
            dsimp [β]
            rw [Finset.sum_neg_distrib, ← Finset.sum_mul]
          rw [heq]
          exact h_card_ent boxSub (β d) (p_cD d) (N_sub : ℝ)
            (fun m _ => hβ_nn d m) (hβ_sum d) hN_sub_pos le_rfl
        linarith only [h_β_ent]
      rw [Finset.sum_comm]
      calc ∑ d : Fin N_D, ∑ o ∈ O₀, -(π_root o d * Real.log (π_root o d / p_cD d))
          ≤ ∑ d : Fin N_D,
              ((∑ o ∈ O₀, ∑ m_sub : ↥boxSub,
                -(p_comp o (e_idx (d, m_sub)) *
                  Real.log (p_comp o (e_idx (d, m_sub)) / p_comp_D (e_idx (d, m_sub))))) +
                p_cD d * Real.log (N_sub : ℝ)) :=
            Finset.sum_le_sum (fun d _ => h_each_d d)
        _ = (∑ o ∈ O₀, ∑ dt : Fin (N_D * N_sub),
              -(p_comp o dt * Real.log (p_comp o dt / p_comp_D dt))) +
              Real.log (N_sub : ℝ) := by
            rw [Finset.sum_add_distrib, ← Finset.sum_mul, hp_cD_sum, one_mul, Finset.sum_comm]
            congr 1
            refine Finset.sum_congr rfl (fun o _ => ?_)
            exact (h_sum_dt
              (fun dt => -(p_comp o dt * Real.log (p_comp o dt / p_comp_D dt)))).symm
    have h_Ew_eq : ∑ dt : Fin (N_D * N_sub),
          p_comp_D dt * ((1 + γ) * b_tilde dt + (1 - γ) * a_tilde dt) =
        ∑ d : Fin N_D, p_cD d * ((1 + γ) * b_D d + (1 - γ) * a_D d) := by
      rw [h_sum_dt]
      refine Finset.sum_congr rfl (fun d _ => ?_)
      have heq : ∑ m_sub : ↥boxSub,
            p_comp_D (e_idx (d, m_sub)) *
              ((1 + γ) * b_tilde (e_idx (d, m_sub)) + (1 - γ) * a_tilde (e_idx (d, m_sub))) =
          ∑ m_sub : ↥boxSub,
            p_comp_D (e_idx (d, m_sub)) * ((1 + γ) * b_D d + (1 - γ) * a_D d) := by
        refine Finset.sum_congr rfl (fun m_sub _ => ?_)
        dsimp [b_tilde, a_tilde]
        rw [hd_of_apply]
      rw [heq, ← Finset.sum_mul, hp_comp_D_sum_m d]
    
    have hlog_Munit_Mlow : Real.log M_unit = Real.log M_low + ξ * ell + Real.log C_fib := by
      have h1 : Real.log M_unit =
          Real.log C_fib + (-(((m_idx.1 : ℝ) * ξ)) * ell + Real.log E_f) := by
        dsimp [M_unit]
        rw [Real.log_mul (lt_of_lt_of_le zero_lt_one hC_fib).ne'
            (mul_pos (Real.rpow_pos_of_pos hε₀ _) hE_f_pos).ne',
          Real.log_mul (Real.rpow_pos_of_pos hε₀ _).ne' hE_f_pos.ne', hlog_rpow]
      have h2 : Real.log M_low = -((((m_idx.1 : ℝ) + 1) * ξ)) * ell + Real.log E_f := by
        dsimp [M_low]
        rw [Real.log_mul (Real.rpow_pos_of_pos hε₀ _).ne' hE_f_pos.ne', hlog_rpow]
      have h_alg : -(((m_idx.1 : ℝ) + 1) * ξ) * ell = -((m_idx.1 : ℝ) * ξ) * ell - ξ * ell := by
        ring
      linarith only [h1, h2, h_alg]
    have hlog_Btime : Real.log B_time = Real.log B_sys + t * ell := by
      dsimp [B_time]
      rw [Real.log_mul hB_pos.ne' (Real.rpow_pos_of_pos hε₀ _).ne', hlog_rpow]
      ring
    have hlog_Mcell : Real.log M_cell = Real.log C_cell + 2 * η * ell := by
      dsimp [M_cell]
      rw [Real.log_mul (lt_of_lt_of_le zero_lt_one hC_cell).ne'
          (Real.rpow_pos_of_pos hε₀ _).ne', hlog_rpow]
      ring
    have hlog_6Renl : Real.log (6 * R_enl) = Real.log (6 * C_enl_base) + (η + ξ) * ell := by
      have h6eq : 6 * R_enl = (6 * C_enl_base) * ε ^ (-η - ξ) := by dsimp [R_enl]; ring
      rw [h6eq, Real.log_mul (by linarith only [hC_enl_base])
          (Real.rpow_pos_of_pos hε₀ _).ne', hlog_rpow]
      ring
    
    have h_HO_comp_eq : ∑ o ∈ O₀, -(π_O o * Real.log (π_O o)) =
        ∑ o ∈ O₀, -(p_comp_O o * Real.log (p_comp_O o)) := by
      simp_rw [hp_comp_O_eq]
    have h_Emass_comp_eq : ∑ o ∈ O₀, π_O o * Real.log (canonicalRootMass lam_sys Φ₀ f o) =
        ∑ o ∈ O₀, p_comp_O o * Real.log (canonicalRootMass lam_sys Φ₀ f o) := by
      simp_rw [hp_comp_O_eq]
    let Num_pc : ℝ :=
      (∑ o : Fin N_O, -(p_cO o * Real.log (p_cO o))) +
      (1 / 2) * (∑ o : Fin N_O, ∑ d : Fin N_D, -(p_c o d * Real.log (p_c o d / p_cD d))) +
      (3 / 2) * (∑ o : Fin N_O, p_cO o * Real.log (m_obs o))
    let Num_comp : ℝ :=
      (∑ o ∈ O₀, -(p_comp_O o * Real.log (p_comp_O o))) +
      (1 / 2) * (∑ o ∈ O₀, ∑ dt : Fin (N_D * N_sub),
        -(p_comp o dt * Real.log (p_comp o dt / p_comp_D dt))) +
      (3 / 2) * (∑ o ∈ O₀, p_comp_O o * Real.log (canonicalRootMass lam_sys Φ₀ f o))
    let C_rem : ℝ :=
      (3 / 2) * Real.log C_fib +
      Real.log B_sys +
      (3 / 2) * Real.log C_cell +
      (3 / 2) * Real.log M_loss +
      2 * Real.log (6 * C_enl_base) +
      (3 / 2) * Real.log (M_mult : ℝ) +
      (3 / 2) * Real.log C_can
    have h_num_chain : Num_pc ≤ Num_comp + (t + 5 * η + (7 / 2) * ξ) * ell + C_rem := by
      dsimp [Num_pc, Num_comp, C_rem]
      linarith only [h_step3_1, h_step3_2, h_uncond_contrib, h_cond_contrib,
        h_push_HO, h_push_HOD, h_push_mass, h_sub_HOD, h_log_Nsub,
        hlog_Munit_Mlow, hlog_Btime, hlog_Mcell, hlog_6Renl,
        h_HO_comp_eq, h_Emass_comp_eq]
    have h_div_chain := div_le_div_of_nonneg_right h_num_chain hell_pos.le
    have h_rhs_div : (Num_comp + (t + 5 * η + (7 / 2) * ξ) * ell + C_rem) / ell =
        Num_comp / ell + (t + 5 * η + (7 / 2) * ξ) + C_rem / ell := by
      field_simp [hell_pos.ne']
    rw [h_rhs_div] at h_div_chain
    have h_pc_eq : generalPacketScore ε γ H_P t lam_sys m_time Φ₀ f
        N_O N_D r_O V_O X_O ψ_O b_D a_D p_c =
        Num_pc / ell + (1 / 2) * (∑ d : Fin N_D, p_cD d * ((1 + γ) * b_D d + (1 - γ) * a_D d)) := by
      unfold generalPacketScore
      dsimp [Num_pc, p_cO, p_cD, m_obs, ell]
      ring
    have hs_comp_split : s_comp =
        Num_comp / ell + (1 / 2) * (∑ d : Fin N_D, p_cD d * ((1 + γ) * b_D d + (1 - γ) * a_D d)) := by
      dsimp [s_comp, Num_comp]
      rw [h_Ew_eq]
      ring
    have hC1_split : (3 / 2 : ℝ) * (Real.log (M_split : ℝ) / ell) + C_rem / ell = C_info_1 / ell := by
      dsimp [C_info_1, C_rem, M_loss]
      ring
    have hC1_le : C_info_1 / ell ≤ C_info / ell :=
      div_le_div_of_nonneg_right (le_max_right _ _) hell_pos.le
    change generalPacketScore ε γ H_P t lam_sys m_time Φ₀ f
        N_O N_D r_O V_O X_O ψ_O b_D a_D p ≤
      generalPacketRootScore ε H_P L R_dom γ lam_sys Φ₀ f +
        t + 5 * η + 4 * ξ + C_info / ell
    linarith only [h_score_split, h_pc_eq, hs_comp_split, h_div_chain, hs_comp_le_root,
      hC1_split, hC1_le, hξ₀]

theorem preliminary_packet_growth_le_one (γ : ℝ) (hγ₀ : 0 < γ) (hγ₁ : γ < 1) :
    (1 : ℝ) ∈ ValidPacketGrowthRates γ :=
by
  refine ⟨zero_le_one, le_rfl, ?_⟩
  intro a₀ a₁ A R_dom B_sys K_hor R_win t_min δ N_mult M_win
    ha₀ ha₁ hA hR_dom hB_sys hK_hor hR_win ht_min ht_hor hδ hN_mult
  obtain ⟨C_Bes, C_cnt, hC_Bes, hC_cnt, h_bessel_all⟩ :=
    admissible_packet_fixed_time_bessel a₀ a₁ A B_sys K_hor R_win N_mult M_win
      ha₀ ha₁ hA hB_sys hK_hor hR_win hN_mult
  obtain ⟨C_χ, hC_χ, h_pou_smooth, h_pou_supp, h_pou_deriv, h_fourier⟩ :=
    gevrey_partition_and_fourier_synthesis
  obtain ⟨C_can, C_modes, M_mult, C_tail, hC_can, hC_modes, hM_mult, hC_tail, h_modes_all⟩ :=
    root_mode_bijection_and_transport_tail a₀ a₁ A R_dom B_sys R_win C_χ M_win
      ha₀ ha₁ hA hR_dom hB_sys hR_win hC_χ h_pou_smooth h_pou_supp h_pou_deriv
  let η : ℝ := min (1 / 8) (δ * t_min / 20)
  let ξ : ℝ := min (1 / 8) (δ * t_min / 20)
  have hη₀ : 0 < η := lt_min (by norm_num) (by positivity)
  have hη₁ : η ≤ 1 / 8 := min_le_left _ _
  have hη_dt : η ≤ δ * t_min / 20 := min_le_right _ _
  have hξ₀ : 0 < ξ := lt_min (by norm_num) (by positivity)
  have hξ₁ : ξ ≤ 1 / 8 := min_le_left _ _
  have hξ_dt : ξ ≤ δ * t_min / 20 := min_le_right _ _
  let A₀ : ℝ := 6 * K_hor + 2
  have hA₀_pos : 0 < A₀ := by dsimp [A₀]; linarith only [hK_hor]
  let B_cut : ℝ := A₀ + 2 * K_hor + 2
  have hB_cut_pos : 0 < B_cut := by dsimp [B_cut, A₀]; linarith only [hK_hor]
  let M_c : ℕ := ⌊B_cut / ξ⌋₊ + 1
  have hM_c : 1 ≤ M_c := Nat.le_add_left 1 _
  have hM_c_pos : (0 : ℝ) < (M_c : ℝ) := by exact_mod_cast hM_c
  have hB_cut_lt_Mc : B_cut < (M_c : ℝ) * ξ := by
    have h1 : B_cut / ξ < (⌊B_cut / ξ⌋₊ : ℝ) + 1 := Nat.lt_floor_add_one (B_cut / ξ)
    have h2 : ((⌊B_cut / ξ⌋₊ + 1 : ℕ) : ℝ) = (⌊B_cut / ξ⌋₊ : ℝ) + 1 := by push_cast; ring
    have h3 : B_cut / ξ < (M_c : ℝ) := by dsimp [M_c]; linarith only [h1, h2]
    have h4 := (div_lt_iff₀ hξ₀).mp h3
    linarith only [h4]
  let C_fib : ℝ := 8 * C_Bes + 1
  have hC_fib : 1 ≤ C_fib := by dsimp [C_fib]; linarith only [hC_Bes]
  let M₁ : ℕ := ⌈(A₀ + 2) / t_min⌉₊ + 3
  have hM₁_ge : 3 ≤ M₁ := Nat.le_add_left 3 _
  have hM₁_exp : A₀ + 2 ≤ ((M₁ - 1 : ℕ) : ℝ) * t_min := by
    have h1 : (A₀ + 2) / t_min ≤ (⌈(A₀ + 2) / t_min⌉₊ : ℝ) := Nat.le_ceil _
    have h2 : (⌈(A₀ + 2) / t_min⌉₊ : ℝ) ≤ ((M₁ - 1 : ℕ) : ℝ) := by
      have hm : ⌈(A₀ + 2) / t_min⌉₊ ≤ M₁ - 1 := by dsimp [M₁]; omega
      exact_mod_cast hm
    exact (div_le_iff₀ ht_min).mp (le_trans h1 h2)
  let M₂ : ℕ := ⌈(B_cut + 4 * K_hor + 2) / (2 * η)⌉₊ + 3
  have hM₂_ge : 3 ≤ M₂ := Nat.le_add_left 3 _
  have hM₂_exp : B_cut + 4 * K_hor + 2 ≤ η * ((2 * M₂ - 2 : ℕ) : ℝ) := by
    have h2η : 0 < 2 * η := by positivity
    have h1 : (B_cut + 4 * K_hor + 2) / (2 * η) ≤
        (⌈(B_cut + 4 * K_hor + 2) / (2 * η)⌉₊ : ℝ) := Nat.le_ceil _
    have hm : 2 * ⌈(B_cut + 4 * K_hor + 2) / (2 * η)⌉₊ ≤ 2 * M₂ - 2 := by
      dsimp [M₂]; omega
    have h2 : 2 * (⌈(B_cut + 4 * K_hor + 2) / (2 * η)⌉₊ : ℝ) ≤ ((2 * M₂ - 2 : ℕ) : ℝ) := by
      exact_mod_cast hm
    have h3 := (div_le_iff₀ h2η).mp h1
    nlinarith only [h2, h3, hη₀]
  obtain ⟨C_info, hC_info_nn, h_push⟩ :=
    contributor_backward_push_score_bound
      γ R_dom B_sys K_hor R_win η ξ A₀ C_cnt C_can C_fib N_mult M_mult M_c M_win
      hγ₀ hγ₁ hR_dom hB_sys hK_hor hR_win hη₀ hη₁ hξ₀ hξ₁
      (le_refl A₀) hC_cnt hC_can hC_fib hN_mult hM_mult hM_c
  let L_req : ℝ := max 4 (Real.exp (2 * B_sys + 5))
  have hL_req_ge : 4 ≤ L_req := le_max_left _ _
  let W₁ : ℝ := B_sys * L_req
  let W₂ : ℝ := 16 * (4 * C_Bes * C_modes * B_sys ^ 2)
  let W₃ : ℝ := 16 * (C_tail M₁ * B_sys ^ (M₁ - 1))
  let W₄ : ℝ := 2 * C_cnt * C_tail M₂ * (4 * (M_c : ℝ) ^ 2)
  let K₁ : ℝ := Real.log W₁ / t_min
  let K₂ : ℝ := Real.log W₂ / 2
  let K₃ : ℝ := Real.log W₃ / 2
  let K₄ : ℝ := (Real.log W₄ + 1) / 2
  let K₅ : ℝ := (C_info + 1) / ((1 / 2) * δ * t_min)
  let K_big : ℝ := max K₁ (max K₂ (max K₃ (max K₄ (max K₅ 1))))
  have hK_big_ge1 : 1 ≤ K_big :=
    le_trans (le_max_right _ _) (le_trans (le_max_right _ _)
      (le_trans (le_max_right _ _) (le_trans (le_max_right _ _) (le_max_right _ _))))
  let ε₀ : ℝ := min (1 / 4) (Real.exp (-K_big))
  have hε₀_pos : 0 < ε₀ := lt_min (by norm_num) (Real.exp_pos _)
  have hε₀_lt_half : ε₀ < 1 / 2 := lt_of_le_of_lt (min_le_left _ _) (by norm_num)
  refine ⟨ε₀, hε₀_pos, hε₀_lt_half, ?_⟩
  intro ε H_P L t lam_sys m_time
    hε_pos hε_lt ht_lo ht_L ht_HP hHP_hor hL_hor hlam_lo hlam_hi hm_lo hm_hi
    Φ₀ ζ₀ h_phase f hf_meas hf_supp hf_l2 hf_pos
    N_O N_D r_O V_O X_O ψ_O b_D a_D r_D e_D V_D X_D p h_adm
  have hε_lt_quarter : ε < 1 / 4 := lt_of_lt_of_le hε_lt (min_le_left _ _)
  have hε_lt_half : ε < 1 / 2 := by linarith only [hε_lt_quarter]
  have hε_lt_exp : ε < Real.exp (-K_big) := lt_of_lt_of_le hε_lt (min_le_right _ _)
  let ell : ℝ := Real.log (ε⁻¹)
  have hell_gt_K : K_big < ell := by
    dsimp [ell]
    rw [Real.log_inv]
    have hlog := Real.log_lt_log hε_pos hε_lt_exp
    rw [Real.log_exp] at hlog
    linarith only [hlog]
  have hell_pos : 0 < ell := by linarith only [hK_big_ge1, hell_gt_K]
  have hK₁_lt : K₁ < ell := lt_of_le_of_lt (le_max_left _ _) hell_gt_K
  have hK₂_lt : K₂ < ell :=
    lt_of_le_of_lt (le_trans (le_max_left _ _) (le_max_right _ _)) hell_gt_K
  have hK₃_lt : K₃ < ell :=
    lt_of_le_of_lt (le_trans (le_max_left _ _) (le_trans (le_max_right _ _) (le_max_right _ _)))
      hell_gt_K
  have hK₄_lt : K₄ < ell :=
    lt_of_le_of_lt (le_trans (le_max_left _ _) (le_trans (le_max_right _ _)
      (le_trans (le_max_right _ _) (le_max_right _ _)))) hell_gt_K
  have hK₅_lt : K₅ < ell :=
    lt_of_le_of_lt (le_trans (le_max_left _ _) (le_trans (le_max_right _ _)
      (le_trans (le_max_right _ _) (le_trans (le_max_right _ _) (le_max_right _ _))))) hell_gt_K
  have hε_rpow : ∀ α : ℝ, ε ^ α = Real.exp (-α * ell) := by
    intro α
    rw [Real.rpow_def_of_pos hε_pos]
    congr 1
    dsimp [ell]
    rw [Real.log_inv]
    ring
  have ht_pos : 0 < t := lt_of_lt_of_le ht_min ht_lo
  have hB_pos : 0 < B_sys := by linarith only [hB_sys]
  have hW₁_pos : 0 < W₁ := by dsimp [W₁]; positivity
  have hW₁_le_t : W₁ ≤ ε ^ (-t) := by
    rw [hε_rpow (-t)]
    have h1 : Real.log W₁ < ell * t_min := (div_lt_iff₀ ht_min).mp hK₁_lt
    have h2 : ell * t_min ≤ -(-t) * ell := by nlinarith only [ht_lo, hell_pos]
    calc W₁ = Real.exp (Real.log W₁) := (Real.exp_log hW₁_pos).symm
      _ ≤ Real.exp (-(-t) * ell) := Real.exp_le_exp.mpr (by linarith only [h1, h2])
  have h_et_le_HP : ε ^ (-t) ≤ ε ^ (-H_P) := by
    rw [hε_rpow (-t), hε_rpow (-H_P)]
    exact Real.exp_le_exp.mpr (by nlinarith only [ht_HP, hell_pos])
  have hL_req_le_lam : L_req ≤ lam_sys := by
    have h1 : B_sys * L_req ≤ ε ^ (-H_P) := le_trans hW₁_le_t h_et_le_HP
    have h2 : L_req ≤ B_sys⁻¹ * ε ^ (-H_P) := by
      calc L_req = B_sys⁻¹ * (B_sys * L_req) := by field_simp [hB_pos.ne']
        _ ≤ B_sys⁻¹ * ε ^ (-H_P) := mul_le_mul_of_nonneg_left h1 (inv_nonneg.mpr hB_pos.le)
    exact le_trans h2 hlam_lo
  have hlam_ge4 : 4 ≤ lam_sys := le_trans hL_req_ge hL_req_le_lam
  have hlam_ge1 : 1 ≤ lam_sys := by linarith only [hlam_ge4]
  have hlam_pos : 0 < lam_sys := by linarith only [hlam_ge4]
  have hlog_lam : 2 * B_sys + 5 ≤ Real.log lam_sys := by
    have hexp_le : Real.exp (2 * B_sys + 5) ≤ lam_sys :=
      le_trans (le_max_right 4 _) hL_req_le_lam
    calc 2 * B_sys + 5 = Real.log (Real.exp (2 * B_sys + 5)) := (Real.log_exp _).symm
      _ ≤ Real.log lam_sys := Real.log_le_log (Real.exp_pos _) hexp_le
  let ρ₀ : ℝ := (Real.sqrt lam_sys)⁻¹
  let ρ_obs : ℝ := ε ^ ((H_P - t) / 2)
  have hρ₀_pos : 0 < ρ₀ := inv_pos.mpr (Real.sqrt_pos.mpr hlam_pos)
  have hρ_obs_pos : 0 < ρ_obs := Real.rpow_pos_of_pos hε_pos _
  have hρ_obs_le1 : ρ_obs ≤ 1 := by
    dsimp [ρ_obs]
    rw [hε_rpow]
    calc Real.exp (-((H_P - t) / 2) * ell) ≤ Real.exp 0 :=
          Real.exp_le_exp.mpr (by nlinarith only [ht_HP, hell_pos])
      _ = 1 := Real.exp_zero
  have hρ₀_le_obs : ρ₀ ≤ ρ_obs := by
    have h_et_inv : ε ^ t ≤ B_sys⁻¹ := by
      have h1 : B_sys ≤ ε ^ (-t) := by
        have hb1 : B_sys * 1 ≤ W₁ := by
          dsimp [W₁]
          exact mul_le_mul_of_nonneg_left (by linarith only [hL_req_ge]) hB_pos.le
        linarith only [hb1, hW₁_le_t]
      rw [hε_rpow (-t)] at h1
      rw [hε_rpow t]
      have h3 : B_sys ≤ Real.exp (t * ell) := by
        convert h1 using 2; ring
      have h2 : Real.exp (-(t * ell)) ≤ B_sys⁻¹ := by
        rw [Real.exp_neg]
        exact inv_anti₀ hB_pos h3
      convert h2 using 2; ring
    have h_sq : (ρ_obs⁻¹) ^ 2 ≤ lam_sys := by
      have h_obs_inv_sq : (ρ_obs⁻¹) ^ 2 = ε ^ t * ε ^ (-H_P) := by
        dsimp [ρ_obs]
        rw [hε_rpow, hε_rpow, hε_rpow, ← Real.exp_neg, ← Real.exp_nat_mul, ← Real.exp_add]
        congr 1; push_cast; ring
      rw [h_obs_inv_sq]
      exact le_trans (mul_le_mul_of_nonneg_right h_et_inv (Real.rpow_nonneg hε_pos.le _)) hlam_lo
    have h_le_sqrt : ρ_obs⁻¹ ≤ Real.sqrt lam_sys := by
      rw [← Real.sqrt_sq (inv_nonneg.mpr hρ_obs_pos.le)]
      exact Real.sqrt_le_sqrt h_sq
    dsimp [ρ₀]
    have h_inv := inv_anti₀ (inv_pos.mpr hρ_obs_pos) h_le_sqrt
    simpa using h_inv
  have hΦ₀_cont : Continuous Φ₀ := contDiff_zero.mp (h_phase.1 0)
  have hf_sq_int : MeasureTheory.Integrable (fun v => ‖f v‖ ^ 2) MeasureTheory.volume :=
    hf_l2.integrable_norm_pow (by norm_num)
  let E_f : ℝ := ∫ v : EuclideanSpace ℝ (Fin 2), ‖f v‖ ^ 2
  have hE_f_pos : 0 < E_f := hf_pos
  obtain ⟨hO_bound, hO_smooth, hO_supp, hO_deriv, hO_pack, hD_bound, hp_nn, hp_sum, hp_supp⟩ := h_adm
  have hO_pack_std :
      let ρ_obs' := ε ^ ((H_P - t) / 2)
      let σ_obs' := (lam_sys * ρ_obs')⁻¹
      ∀ (r : ℕ) (v₀ x₀ : EuclideanSpace ℝ (Fin 2)),
        ((Finset.univ.filter (fun o : Fin N_O =>
          r_O o = r ∧ ‖V_O o - v₀‖ ≤ ρ_obs' ∧ ‖X_O o - x₀‖ ≤ σ_obs')).card : ℝ) ≤
          (N_mult : ℝ) := by
    dsimp only
    intro r v₀ x₀
    convert hO_pack r v₀ x₀ using 3
    ext o
    simp only [Finset.mem_filter]
  obtain ⟨hNO_cnt, h_bes⟩ :=
    h_bessel_all ε H_P t lam_sys m_time hε_pos hε_lt_half ht_pos.le ht_HP hHP_hor
      hlam_lo hlam_hi hm_lo Φ₀ ζ₀ h_phase N_O r_O V_O X_O ψ_O
      hO_bound hO_smooth hO_supp hO_deriv hO_pack_std
  obtain ⟨h_sum_j, h_parseval, h_pair_exp, h_synth⟩ :=
    h_fourier lam_sys R_dom hlam_ge1 hR_dom Φ₀ hΦ₀_cont f hf_meas hf_supp hf_l2
  obtain ⟨F_modes, X_ex, o_root, hF_props, hF_card, hF_in_root, hF_mult, hF_can, hF_tail⟩ :=
    h_modes_all lam_sys hlam_ge4 Φ₀ ζ₀ h_phase
