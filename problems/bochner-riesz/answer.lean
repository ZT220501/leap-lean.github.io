      (∀ ξ : (Fin n → ℝ) × ℝ,
        IsStrictDispCone n c E_cone ξ → (∀ k, |ξ.1 k| ≤ M) → |ξ.2| ≤ M →
        |partFn (planeEmbed n c iu + h • ξ) - α| ≤ H_err M h iu ξ) →
      (∀ t ∈ Set.uIcc (0 : ℝ) Δ, ∀ w ∈ W_box δ_box,
