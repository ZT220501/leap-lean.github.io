  have hh'_pos : 0 < h' := mul_pos hδ₀_pos hh
  let τ : ℝ := h' / (M : ℝ)
  have hτ_pos : 0 < τ := div_pos hh'_pos hM_pos
  have hMτ : (M : ℝ) * τ = h' := mul_div_cancel₀ h' hM_pos.ne'
  have hQτ : (Q : ℝ) * τ = (min 1 m / K) * h := by
    have hQ_cast : (Q : ℝ) = (M : ℝ) * (N_blk : ℝ) := by dsimp [Q]; push_cast; ring
    dsimp [τ, h', δ₀]
    rw [hQ_cast, ← hN_cast]
    field_simp [hM_pos.ne', hK_pos.ne', hN_pos.ne']
  have h_min_Km : min 1 m / (K * m) ≤ 1 / 2 := by
    rw [div_le_div_iff₀ (mul_pos hK_pos hm) (by norm_num)]
    nlinarith [hmin_lem, hK_ge2, hm]
  let v : ℕ → ℝ := fun r => u + (r : ℝ) * (τ / m)
  have hv_succ : ∀ r : ℕ, v r + τ / m = v (r + 1) := by
    intro r; dsimp [v]; push_cast; ring
  have hv_mono : ∀ r₁ r₂ : ℕ, r₁ ≤ r₂ → v r₁ ≤ v r₂ := by
    intro r₁ r₂ hr
    dsimp [v]
    have hrc : (r₁ : ℝ) ≤ (r₂ : ℝ) := by exact_mod_cast hr
    exact add_le_add le_rfl (mul_le_mul_of_nonneg_right hrc (div_pos hτ_pos hm).le)
  have hvQ_lt1 : v Q < 1 := by
