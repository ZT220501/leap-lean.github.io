      let dual_δ := InnerProductSpace.toDual ℝ (EuclideanSpace ℝ (Fin 2)) δ
      have h_comp2 := (dual_δ.hasFDerivAt.comp_hasDerivAt y h_comp1).const_mul (ε_sgn * lam_loc)
      have h_fn : (fun y' : ℝ => (ε_sgn * lam_loc) *
          (⇑dual_δ ∘ (fun p' => ζ₀ (v_seg τ, p')) ∘ fun y'' => p_seg (y'', τ)) y') =
