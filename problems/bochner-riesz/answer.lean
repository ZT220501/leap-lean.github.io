          (le_trans (le_max_right _ _) (le_trans (le_max_right _ _)
            (le_trans (le_max_left _ _) (le_max_right _ _)))))
      have h_lt := lt_of_le_of_lt h_div
        (h_absorb_const ρ₁ C_LW_rat e₁ E_rhs1 hρ₁_pos hC_LW_rat_pos h_pow_small)
      have h_exp_ineq := h_rpow_le_iff ρ₁ (-2 * p_star + 6 * ζ₁) (E_rhs1 - e₁)
        hρ₁_pos hρ₁_lt1 h_lt.le
      have hη_h : 6 * (η₀ / h) ≤ β / 1000 := by
        have h1 : η₀ / h ≤ (Δ_star / 10000) * (r * ϑ) := by
          rw [div_le_iff₀ hh_pos]
          calc η₀ ≤ Δ_star * r * (ϑ * h) / 10000 := hη₀_le_Δrl
            _ = ((Δ_star / 10000) * (r * ϑ)) * h := by ring
        have h2 : r * ϑ ≤ 1 := by
          calc r * ϑ ≤ (1 / 2) * 1 := mul_le_mul hr_le_half hϑ_lt1.le hϑ_pos.le (by norm_num)
            _ ≤ 1 := by norm_num
        have h3 : Δ_star ≤ β / 10 := by dsimp [Δ_star]; linarith only [hγ₀]
        have h4 : (Δ_star / 10000) * (r * ϑ) ≤ (β / 100000) * 1 :=
          mul_le_mul (by linarith only [h3]) h2 (mul_nonneg hr_pos.le hϑ_pos.le)
            (by linarith only [hβ_pos])
        linarith only [h1, h4, hβ_pos]
      dsimp [E_rhs1, ζ₁] at h_exp_ineq
      have h_assoc1 : 2 * η₀ / h = 2 * (η₀ / h) := mul_div_assoc 2 η₀ h
      linarith only [h_exp_ineq, h_assoc1, hp_star_hi, hϑ_le_β, he₁_le_β, hη_h, hβ_pos]

  let e_def : EuclideanSpace ℝ (Fin 2) :=
    WithLp.toLp 2 (fun i : Fin 2 => if i = 0 then 1 else 0)
  have he_def_norm : ‖e_def‖ = 1 := by
    have hsq : ‖e_def‖ ^ 2 = 1 := by
      rw [PiLp.norm_sq_eq_of_L2, Fin.sum_univ_two]; simp [e_def]
    exact (sq_eq_one_iff.mp hsq).resolve_right (by linarith only [norm_nonneg e_def])
  let n_dir : (ℤ × ℤ × ℤ) → EuclideanSpace ℝ (Fin 2) := fun ok =>
    if hok : ok ∈ G_Ok then Classical.choose (h_strip_each ok hok) else e_def
  let w_off : (ℤ × ℤ × ℤ) → ℝ := fun ok =>
    if hok : ok ∈ G_Ok then Classical.choose (Classical.choose_spec (h_strip_each ok hok)) else 0
  have hn_dir_unit : ∀ ok, ‖n_dir ok‖ = 1 := by
    intro ok; dsimp [n_dir]; split_ifs with hok
    · exact (Classical.choose_spec (Classical.choose_spec (h_strip_each ok hok))).1
    · exact he_def_norm
  let E_ok_strip : (ℤ × ℤ × ℤ) → Finset (Fin M_ω) := fun ok =>
    @Finset.filter (Fin M_ω)
      (fun ω => |inner ℝ (V_part (T_idx ω)) (n_dir ok) - w_off ok| ≤ 4 * ε ^ l)
      (fun _ => Classical.propDecidable _)
      (E_good1.filter (fun ω => O_at k ω = ok))
  let E_strip : Finset (Fin M_ω) := G_Ok.biUnion E_ok_strip
  have hE_strip_disj : (G_Ok : Set (ℤ × ℤ × ℤ)).PairwiseDisjoint E_ok_strip := by
    intro ok₁ _ ok₂ _ hne
    rw [Function.onFun, Finset.disjoint_left]
    intro ω h1 h2
    have heq1 : O_at k ω = ok₁ :=
      (Finset.mem_filter.mp ((@Finset.mem_filter _ _ (fun _ => Classical.propDecidable _) _ _).mp h1).1).2
    have heq2 : O_at k ω = ok₂ :=
      (Finset.mem_filter.mp ((@Finset.mem_filter _ _ (fun _ => Classical.propDecidable _) _ _).mp h2).1).2
    exact hne (heq1.symm.trans heq2)
  have hE_strip_props : ∀ ω ∈ E_strip,
      0 < π₀ ω ∧ |inner ℝ (V_part (T_idx ω)) (n_dir (O_at k ω)) - w_off (O_at k ω)| ≤ 4 * ε ^ l := by
    intro ω hω
    obtain ⟨ok, _, hω_ok⟩ := Finset.mem_biUnion.mp hω
    obtain ⟨h1, h2⟩ := (@Finset.mem_filter _ _ (fun _ => Classical.propDecidable _) _ _).mp hω_ok
    obtain ⟨h_good, h_eq⟩ := Finset.mem_filter.mp h1
    rw [h_eq]
    exact ⟨hE_good1_pos ω h_good, h2⟩

  let m_strip : ℝ := ∑ ω ∈ E_strip, π₀ ω
  have hm_strip_lb : ε ^ (6 * e₁ * h) ≤ m_strip := by
    have h_bunion : m_strip = ∑ ok ∈ G_Ok, ∑ ω ∈ E_ok_strip ok, π₀ ω :=
      Finset.sum_biUnion hE_strip_disj
    have h_each : ∀ ok ∈ G_Ok,
        (∑ ω ∈ E_good1.filter (fun ω => O_at k ω = ok), π₀ ω) / (16 * K_q1 ^ 3) ≤
          ∑ ω ∈ E_ok_strip ok, π₀ ω := by
      intro ok hok
      have hspec := (Classical.choose_spec (Classical.choose_spec (h_strip_each ok hok))).2
      have hn_eq : n_dir ok = Classical.choose (h_strip_each ok hok) := dif_pos hok
      have hw_eq : w_off ok = Classical.choose (Classical.choose_spec (h_strip_each ok hok)) := dif_pos hok
      have h_flt_eq : E_ok_strip ok = @Finset.filter (Fin M_ω)
          (fun ω => |inner ℝ (V_part (T_idx ω)) (Classical.choose (h_strip_each ok hok)) -
            Classical.choose (Classical.choose_spec (h_strip_each ok hok))| ≤ 4 * ε ^ l)
          (fun _ => Classical.propDecidable _)
          (E_good1.filter (fun ω => O_at k ω = ok)) := by
        dsimp only [E_ok_strip]
        rw [hn_eq, hw_eq]
      rw [h_flt_eq]
      exact hspec
    have h_sum1 : (c_ret1 / 2) / (16 * K_q1 ^ 3) ≤ m_strip := by
      rw [h_bunion]
      have h_le := Finset.sum_le_sum h_each
      rw [← Finset.sum_div] at h_le
      have h_eq_sum : ∑ ok ∈ G_Ok, ∑ ω ∈ E_good1.filter (fun ω => O_at k ω = ok), π₀ ω =
          ∑ ok ∈ G_Ok, ∑ ω ∈ E_good1, if O_at k ω = ok then π₀ ω else 0 :=
        Finset.sum_congr rfl (fun ok _ => Finset.sum_filter _ _)
      rw [h_eq_sum] at h_le
      exact le_trans (div_le_div_of_nonneg_right hG_Ok_mass (by positivity)) h_le
    have h_eq_c : (c_ret1 / 2) / (16 * K_q1 ^ 3) = C_strip1 * ρ₁ ^ (3 * ζ₁) := by
      dsimp [K_q1, C_strip1]
      have h1 : (c_ret1 / 2) / (16 * ((256 / c_ret1) * ρ₁ ^ (-ζ₁)) ^ 3) =
          (c_ret1 ^ 4 / (32 * (256 : ℝ) ^ 3)) * ((ρ₁ ^ (-ζ₁)) ^ 3)⁻¹ := by
        field_simp [hc_ret1_pos.ne', (Real.rpow_pos_of_pos hρ₁_pos (-ζ₁)).ne']; ring
      rw [h1]; congr 1
      rw [← Real.rpow_natCast (ρ₁ ^ (-ζ₁)) 3, ← Real.rpow_mul hρ₁_pos.le, ← Real.rpow_neg hρ₁_pos.le]
      congr 1; push_cast; ring
    rw [h_eq_c] at h_sum1
    have h_c_gt : ε ^ (5 * e₁ * h) < C_strip1 := by
      refine h_exp_small C_strip1 (5 * e₁ * h) hC_strip1_pos (by positivity) ?_
      exact le_trans (le_max_left _ _) (le_trans (le_max_right _ _)
        (le_trans (le_max_right _ _) (le_trans (le_max_right _ _)
          (le_trans (le_max_left _ _) (le_max_right _ _)))))
    have h_pow_ge : ε ^ (e₁ * h) ≤ ρ₁ ^ (3 * ζ₁) := by
      have h1 : ρ₁ ^ (3 * ζ₁) = ε ^ ((3 / 10) * e₁ * h) := by
        dsimp [ρ₁, ζ₁]; rw [← Real.rpow_mul hε_pos.le]; congr 1; ring
      rw [h1]
      exact Real.rpow_le_rpow_of_exponent_ge hε_pos (by linarith only [hε_lt_half])
        (by have := mul_pos he₁_pos hh_pos; linarith only [this])
    have h_prod : ε ^ (6 * e₁ * h) ≤ C_strip1 * ρ₁ ^ (3 * ζ₁) := by
      have h_add : ε ^ (6 * e₁ * h) = ε ^ (5 * e₁ * h) * ε ^ (e₁ * h) := by
        rw [← Real.rpow_add hε_pos]; congr 1; ring
      rw [h_add]
      exact mul_le_mul h_c_gt.le h_pow_ge (Real.rpow_pos_of_pos hε_pos _).le hC_strip1_pos.le
    exact le_trans h_prod h_sum1
  have hm_strip_pos : 0 < m_strip := lt_of_lt_of_le (Real.rpow_pos_of_pos hε_pos _) hm_strip_lb
  have hm_strip_le1 : m_strip ≤ 1 := by
    calc m_strip = ∑ ω ∈ E_strip, π₀ ω := rfl
      _ ≤ ∑ ω : Fin M_ω, π₀ ω :=
          Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ _) (fun ω _ _ => hπ₀_nn ω)
      _ = 1 := hπ₀_sum

  let π_strip : Fin M_ω → ℝ := fun ω => if ω ∈ E_strip then π₀ ω / m_strip else 0
  have hπ_s_nn : ∀ ω, 0 ≤ π_strip ω := fun ω => by
    dsimp [π_strip]; split_ifs
    · exact div_nonneg (hπ₀_nn ω) hm_strip_pos.le
    · exact le_rfl
  have hπ_s_sum : ∑ ω : Fin M_ω, π_strip ω = 1 := by
    dsimp [π_strip]
    rw [← Finset.sum_filter, Finset.filter_mem_eq_inter, Finset.univ_inter, ← Finset.sum_div]
    exact div_self hm_strip_pos.ne'
  have hπ_s_pos_iff : ∀ ω, 0 < π_strip ω →
      ω ∈ E_strip ∧ 0 < π₀ ω ∧
        |inner ℝ (V_part (T_idx ω)) (n_dir (O_at k ω)) - w_off (O_at k ω)| ≤ 4 * ε ^ l := by
    intro ω hpos
    dsimp [π_strip] at hpos
    by_cases hmem : ω ∈ E_strip
    · exact ⟨hmem, hE_strip_props ω hmem⟩
    · rw [if_neg hmem] at hpos; exact absurd hpos (lt_irrefl 0)
  have hπ_s_le_π0 : ∀ ω, π_strip ω ≤ m_strip⁻¹ * π₀ ω := by
    intro ω; dsimp [π_strip]; split_ifs
    · rw [div_eq_mul_inv, mul_comm]
    · exact mul_nonneg (inv_nonneg.mpr hm_strip_pos.le) (hπ₀_nn ω)
  have hπ_s_le_amb : ∀ ω, π_strip ω ≤ (K₀ / m_strip) * π_amb ω := by
    intro ω
    calc π_strip ω ≤ m_strip⁻¹ * π₀ ω := hπ_s_le_π0 ω
      _ ≤ m_strip⁻¹ * (K₀ * π_amb ω) :=
          mul_le_mul_of_nonneg_left (hπ₀_le_amb ω) (inv_nonneg.mpr hm_strip_pos.le)
      _ = (K₀ / m_strip) * π_amb ω := by ring
  have hK_amb2_ge1 : 1 ≤ K₀ / m_strip :=
    (one_le_div hm_strip_pos).mpr (le_trans hm_strip_le1 hK₀_ge)

  obtain ⟨hS_BF_cov, hS_F01_cov, hS_Fc_cov, hS_Fch_cov, hS_Xr_cov, hS_Vd_cov⟩ :=
    hS_strip_cov k l n_dir w_off hl_pos hl_lt1 hk_nn hk_le_a hn_dir_unit
  let O₁ : Fin M_ω → ℤ × ℤ × ℤ := O_at 1
  let B_obs : Fin M_ω → (ℤ × ℤ × ℤ) × (ℤ × ℤ × ℤ) × ℤ :=
    isoStripEarlierObs ε k a T_idx V_part A_part c_val n_dir
  let F_at : ℝ → Fin M_ω → ℤ × ℤ :=
    fun u => isoLastBlockObs ε k u T_idx V_part A_part c_val n_dir
  let X_r : Fin M_ω → ℤ := isoTanVelBin ε k (r * l) T_idx V_part A_part c_val n_dir
  let V_d : Fin M_ω → ℤ × ℤ := isoVelObs ε d_star T_idx V_part

  let ρ₂ : ℝ := ε ^ (r * l)
  have hρ₂_pos : 0 < ρ₂ := Real.rpow_pos_of_pos hε_pos (r * l)
  have hρ₂_lt_half : ρ₂ < 1 / 2 := by
    refine h_exp_small (1 / 2) (r * l) (by norm_num) (mul_pos hr_pos hl_pos) ?_
    have : 1 / (1 / 2 : ℝ) = 2 := by norm_num
    rw [this]
    exact le_trans (le_max_right _ _) (le_trans (le_max_left _ _)
      (le_trans (le_max_left _ _) (le_max_right _ _)))
  have hρ₂_lt1 : ρ₂ < 1 := lt_trans hρ₂_lt_half (by norm_num)
  let κ₂ : ℝ := 6 * e₁ / (ϑ * r)
  have hκ₂_pos : 0 < κ₂ := div_pos (by positivity) (mul_pos hϑ_pos hr_pos)
  have hκ₂_le : κ₂ ≤ e₂ / 100 := by
    dsimp [κ₂]
    rw [div_le_iff₀ (mul_pos hϑ_pos hr_pos)]
    have h_eq : (e₂ / 100) * (ϑ * r) = 6 * (ϑ * r * e₂ / 600) := by ring
    linarith only [he₁_le_e₂, h_eq]
  have hm_strip_ρ₂ : ρ₂ ^ κ₂ ≤ m_strip := by
    have h_eq : ρ₂ ^ κ₂ = ε ^ (6 * e₁ * h) := by
      dsimp [ρ₂, κ₂, l]
      rw [← Real.rpow_mul hε_pos.le]
      congr 1; field_simp [hϑ_pos.ne', hr_pos.ne']
    rwa [h_eq]
  have hm_strip_inv_ub : m_strip⁻¹ ≤ ρ₂ ^ (-κ₂) := by
    rw [Real.rpow_neg hρ₂_pos.le]
    exact inv_anti₀ (Real.rpow_pos_of_pos hρ₂_pos κ₂) hm_strip_ρ₂
  have hρ₂_a0 : ρ₂ ^ a₀ = ε ^ d_star := by
    dsimp [ρ₂, d_star]; rw [← Real.rpow_mul hε_pos.le]; congr 1; ring

  have h_Fc_ent : ∀ (u₁ u₂ : ℝ), a ≤ u₁ → u₁ ≤ u₂ → u₂ ≤ 1 →
      finCondEntropy ε π_strip (fun ω => (B_obs ω, F_at u₂ ω)) (F_at u₁) ≤ Real.log C_amb / ell := by
    intro u₁ u₂ hu₁ hu₁₂ hu₂
    refine hs2_card ε C_amb π_strip (fun ω => (B_obs ω, F_at u₂ ω)) (F_at u₁)
      hε_pos hε_lt_half hC_amb_ge hπ_s_nn hπ_s_sum ?_
    intro ω₀ _
    obtain ⟨S_Fc, hSFc_card, hSFc_mem⟩ := hS_Fc_cov u₁ u₂ hu₁ hu₁₂ hu₂ ω₀
    refine ⟨S_Fc, hSFc_card, fun ω _ h_eq => ?_⟩
    obtain ⟨hB_eq, hF_eq⟩ := Prod.ext_iff.mp h_eq
    exact hSFc_mem ω hB_eq hF_eq

  have h_sum_miB : ∑ m ∈ Finset.range R,
      finCondMutualInfo ε π_strip (fun ω => (B_obs ω, F_at (a + (m : ℝ) * r * l) ω))
        X_r (F_at (a + ((m + 1 : ℕ) : ℝ) * r * l)) ≤ 2 * (r * l) := by
    let gB : ℕ → ℝ := fun m => finCondMutualInfo ε π_strip B_obs (F_at (a + (m : ℝ) * r * l)) X_r
    have h_step : ∀ m ∈ Finset.range R,
        finCondMutualInfo ε π_strip (fun ω => (B_obs ω, F_at (a + (m : ℝ) * r * l) ω))
          X_r (F_at (a + ((m + 1 : ℕ) : ℝ) * r * l)) ≤
        (gB (m + 1) - gB m) + Real.log C_amb / ell := by
      intro m hm
      have hmR : (m + 1 : ℕ) ≤ R := Finset.mem_range.mp hm
      have hu1 : a ≤ a + (m : ℝ) * r * l := by
        have hnn : 0 ≤ (m : ℝ) * r * l :=
          mul_nonneg (mul_nonneg (Nat.cast_nonneg m) hr_pos.le) hl_pos.le
        linarith only [hnn]
      have hu12 : a + (m : ℝ) * r * l ≤ a + ((m + 1 : ℕ) : ℝ) * r * l := by
        have hle : (m : ℝ) * r * l ≤ ((m + 1 : ℕ) : ℝ) * r * l :=
          mul_le_mul_of_nonneg_right
            (mul_le_mul_of_nonneg_right (by exact_mod_cast Nat.le_succ m) hr_pos.le) hl_pos.le
        linarith only [hle]
      have hu2 : a + ((m + 1 : ℕ) : ℝ) * r * l ≤ 1 := by
        have hmr : ((m + 1 : ℕ) : ℝ) ≤ (R : ℝ) := by exact_mod_cast hmR
        have h1 : ((m + 1 : ℕ) : ℝ) * r ≤ 1 := by
          calc ((m + 1 : ℕ) : ℝ) * r ≤ (R : ℝ) * r := mul_le_mul_of_nonneg_right hmr hr_pos.le
            _ = 1 := mul_inv_cancel₀ hR_pos.ne'
        have h2 : ((m + 1 : ℕ) : ℝ) * r * l ≤ l := by
          calc ((m + 1 : ℕ) * r) * l ≤ 1 * l := mul_le_mul_of_nonneg_right h1 hl_pos.le
            _ = l := one_mul l
        dsimp [a]; linarith only [h2]
      have hmi := hs2_mi_step ε π_strip B_obs (F_at (a + (m : ℝ) * r * l))
        (F_at (a + ((m + 1 : ℕ) : ℝ) * r * l)) X_r hε_pos hε_lt_half hπ_s_nn hπ_s_sum
      have hc := h_Fc_ent (a + (m : ℝ) * r * l) (a + ((m + 1 : ℕ) : ℝ) * r * l) hu1 hu12 hu2
      dsimp [gB]; linarith only [hmi, hc]
    have h_tel : ∑ m ∈ Finset.range R, ((gB (m + 1) - gB m) + Real.log C_amb / ell) =
        (gB R - gB 0) + (R : ℝ) * (Real.log C_amb / ell) := by
      rw [Finset.sum_add_distrib, Finset.sum_range_sub, Finset.sum_const, Finset.card_range,
        nsmul_eq_mul]
    have hg0_nn : 0 ≤ gB 0 :=
      h_cmi_nn ε π_strip B_obs (F_at (a + (0 : ℕ) * r * l)) X_r
        hε_pos hε_lt_half hπ_s_nn hπ_s_sum
    have hgR_le : gB R ≤ r * l + Real.log C_amb / ell := by
      have h_sub_nn : 0 ≤ finCondEntropy ε π_strip
          (fun ω => (B_obs ω, F_at (a + (R : ℝ) * r * l) ω)) X_r :=
        h_ent_nn ε π_strip (fun ω => (B_obs ω, F_at (a + (R : ℝ) * r * l) ω)) X_r
          hε_pos hε_lt_half hπ_s_nn
      have h_pow_ge : 1 ≤ (ε ^ (r * l)) ^ (-(1 : ℝ)) := by
        rw [Real.rpow_neg hρ₂_pos.le, Real.rpow_one, one_le_inv₀ hρ₂_pos]
        exact hρ₂_lt1.le
      have hN_ge : 1 ≤ C_amb * (ε ^ (r * l)) ^ (-(1 : ℝ)) :=
        one_le_mul_of_one_le_of_one_le hC_amb_ge h_pow_ge
      have hH_Xr := hs2_card ε (C_amb * (ε ^ (r * l)) ^ (-(1 : ℝ))) π_strip B_obs X_r
        hε_pos hε_lt_half hN_ge hπ_s_nn hπ_s_sum (fun ω₀ _ => by
          obtain ⟨S_Xr, hSXr_c, hSXr_m⟩ := hS_Xr_cov (r * l) (mul_nonneg hr_pos.le hl_pos.le) ω₀
          exact ⟨S_Xr, hSXr_c, fun ω _ hb => hSXr_m ω hb⟩)
      rw [h_log_eps_pow C_amb (r * l) 1 hC_amb_pos, one_mul] at hH_Xr
      dsimp [gB, finCondMutualInfo]; linarith only [hH_Xr, h_sub_nn]
    have h_errB_ell : ((R : ℝ) + 1) * (Real.log C_amb / ell) ≤ r * l := by
      have hL : ((R : ℝ) + 1) * Real.log C_amb / (r * l) ≤ L_big :=
        le_trans (le_max_left _ _) (le_trans (le_max_left _ _)
          (le_trans (le_max_left _ _) (le_trans (le_max_right _ _) (le_max_right _ _))))
      have h1 := (div_le_iff₀ (mul_pos hr_pos hl_pos)).mp (le_trans hL hell_gt_L.le)
      rw [← mul_div_assoc, div_le_iff₀ hell_pos]
      linarith only [h1, mul_comm ell (r * l)]
    have h_le1 := Finset.sum_le_sum h_step
    rw [h_tel] at h_le1
    have heq : (r * l + Real.log C_amb / ell) + (R : ℝ) * (Real.log C_amb / ell) =
        r * l + ((R : ℝ) + 1) * (Real.log C_amb / ell) := by ring
    linarith only [h_le1, hgR_le, hg0_nn, heq, h_errB_ell]

  let miB_fn : ℕ → ℝ := fun m =>
    finCondMutualInfo ε π_strip (fun ω => (B_obs ω, F_at (a + (m : ℝ) * r * l) ω))
      X_r (F_at (a + ((m + 1 : ℕ) : ℝ) * r * l))
  let Good_R : Finset ℕ :=
    @Finset.filter ℕ (fun m => miB_fn m ≤ θ_R * (r * l))
      (fun _ => Classical.propDecidable _) (Finset.range R)
  have hGood_R_card : (R : ℝ) - 2 / θ_R ≤ (Good_R.card : ℝ) := by
    let Bad_R := @Finset.filter ℕ (fun m => ¬ (miB_fn m ≤ θ_R * (r * l)))
      (fun _ => Classical.propDecidable _) (Finset.range R)
    have h_part_card : Good_R.card + Bad_R.card = R := by
      have h1 := @Finset.card_filter_add_card_filter_not ℕ (Finset.range R)
        (fun m => miB_fn m ≤ θ_R * (r * l))
        (fun _ => Classical.propDecidable _) (fun _ => Classical.propDecidable _)
      rwa [Finset.card_range] at h1
    have h_bad_sum : (Bad_R.card : ℝ) * (θ_R * (r * l)) ≤ 2 * (r * l) := by
      calc (Bad_R.card : ℝ) * (θ_R * (r * l))
          = ∑ _m ∈ Bad_R, θ_R * (r * l) := by simp [Finset.sum_const, nsmul_eq_mul]
        _ ≤ ∑ m ∈ Bad_R, miB_fn m := Finset.sum_le_sum (fun m hm =>
            le_of_lt (lt_of_not_ge
              ((@Finset.mem_filter _ _ (fun _ => Classical.propDecidable _) _ _).mp hm).2))
        _ ≤ ∑ m ∈ Finset.range R, miB_fn m :=
            Finset.sum_le_sum_of_subset_of_nonneg
              (@Finset.filter_subset _ _ (fun _ => Classical.propDecidable _) _) (fun m _ _ =>
                h_cmi_nn ε π_strip _ X_r _ hε_pos hε_lt_half hπ_s_nn hπ_s_sum)
        _ ≤ 2 * (r * l) := h_sum_miB
    have h_bad_ub : (Bad_R.card : ℝ) ≤ 2 / θ_R := by
      rw [le_div_iff₀ hθ_R_pos]
      have h1 : (Bad_R.card : ℝ) * θ_R * (r * l) ≤ 2 * (r * l) := by
        have heq : (Bad_R.card : ℝ) * θ_R * (r * l) = (Bad_R.card : ℝ) * (θ_R * (r * l)) := by ring
        linarith only [h_bad_sum, heq]
      exact le_of_mul_le_mul_right h1 (mul_pos hr_pos hl_pos)
    have h_cast : (Good_R.card : ℝ) + (Bad_R.card : ℝ) = (R : ℝ) := by exact_mod_cast h_part_card
    linarith only [h_cast, h_bad_ub]

  let K_q2 : ℝ := (256 / c_ret2) * ρ₂ ^ (-ζ₂)
  have hK_q2_ge1 : 1 ≤ K_q2 := by
    have h1 : c_ret2 ≤ 1 := by
      dsimp [c_ret2]
      have hJ2 : (1 : ℝ) ≤ (J_bins2 : ℝ) := by dsimp [J_bins2]; exact_mod_cast Nat.le_add_right 1 _
      have hden : (64 : ℝ) ≤ 16 * (2 + 2) * (J_bins2 : ℝ) := by linarith only [hJ2]
      rw [div_le_one (by positivity)]
      linarith only [hΔ_le, hden]
    have h2 : 1 ≤ ρ₂ ^ (-ζ₂) := by
      rw [Real.rpow_neg hρ₂_pos.le, one_le_inv₀ (Real.rpow_pos_of_pos hρ₂_pos ζ₂)]
      exact Real.rpow_le_one hρ₂_pos.le hρ₂_lt1.le hζ₂_pos.le
    dsimp [K_q2]
    have h3 : (1 : ℝ) ≤ 256 / c_ret2 := (le_div_iff₀ hc_ret2_pos).mpr (by linarith only [h1])
    exact one_le_mul_of_one_le_of_one_le h3 h2

  have h_goodR_step : ∀ m ∈ Good_R,
      (2 * s - Δ_star / 2) * (r * l) ≤
        finCondEntropy ε π_strip (fun ω => (B_obs ω, F_at (a + (m : ℝ) * r * l) ω))
          (F_at (a + ((m + 1 : ℕ) : ℝ) * r * l)) := by
    intro m hm_good
    have hm_range : m ∈ Finset.range R :=
      ((@Finset.mem_filter _ _ (fun _ => Classical.propDecidable _) _ _).mp hm_good).1
    have hmi_m : miB_fn m ≤ θ_R * (r * l) :=
      ((@Finset.mem_filter _ _ (fun _ => Classical.propDecidable _) _ _).mp hm_good).2
    have hm_ltR : m < R := Finset.mem_range.mp hm_range
    let u_m : ℝ := a + (m : ℝ) * r * l
    let u_m1 : ℝ := a + ((m + 1 : ℕ) : ℝ) * r * l
    have hu_m1_eq : u_m1 = u_m + r * l := by dsimp [u_m, u_m1]; push_cast; ring
    have ha_le_um : a ≤ u_m := by
      dsimp [u_m]
      have : 0 ≤ (m : ℝ) * r * l :=
        mul_nonneg (mul_nonneg (Nat.cast_nonneg m) hr_pos.le) hl_pos.le
      linarith only [this]
    have hum1_le1 : u_m1 ≤ 1 := by
      have hm1R : ((m + 1 : ℕ) : ℝ) ≤ (R : ℝ) := by exact_mod_cast hm_ltR
      have h1 : ((m + 1 : ℕ) : ℝ) * r ≤ 1 := by
        calc ((m + 1 : ℕ) : ℝ) * r ≤ (R : ℝ) * r := mul_le_mul_of_nonneg_right hm1R hr_pos.le
          _ = 1 := mul_inv_cancel₀ hR_pos.ne'
      have h2 : ((m + 1 : ℕ) : ℝ) * r * l ≤ l := by
        calc ((m + 1 : ℕ) * r) * l ≤ 1 * l := mul_le_mul_of_nonneg_right h1 hl_pos.le
          _ = l := one_mul l
      dsimp [u_m1, a]; linarith only [h2]
    have hum_le1 : u_m ≤ 1 := by
      rw [hu_m1_eq] at hum1_le1
      have : 0 < r * l := mul_pos hr_pos hl_pos
      linarith only [hum1_le1, this]
    have hum_in_U : u_m ∈ U_fin := by
      let _ : DecidableEq ℝ := Classical.decEq ℝ
      simp only [U_fin, Finset.mem_union, Finset.mem_image, Finset.mem_range]
      right; exact ⟨m, Nat.lt_succ_of_lt hm_ltR, rfl⟩
    have hum1_in_U : u_m1 ∈ U_fin := by
      let _ : DecidableEq ℝ := Classical.decEq ℝ
      simp only [U_fin, Finset.mem_union, Finset.mem_image, Finset.mem_range]
      right; exact ⟨m + 1, Nat.succ_lt_succ hm_ltR, rfl⟩

    let W_m : Fin M_ω → ((ℤ × ℤ × ℤ) × (ℤ × ℤ × ℤ) × ℤ) × (ℤ × ℤ) :=
      fun ω => (B_obs ω, F_at u_m ω)
    by_contra h_not_ge
    have h_ent_lt : finCondEntropy ε π_strip W_m (F_at u_m1) < (2 * s - Δ_star / 2) * (r * l) :=
      lt_of_not_ge h_not_ge
    have h_ent_nn2 : 0 ≤ finCondEntropy ε π_strip W_m (F_at u_m1) :=
      h_ent_nn ε π_strip W_m (F_at u_m1) hε_pos hε_lt_half hπ_s_nn
    have hp_hi2_nn : 0 ≤ 2 * s - Δ_star / 4 := by
      have h0 : 0 ≤ 2 * s - Δ_star / 2 := nonneg_of_mul_nonneg_left
        (le_trans h_ent_nn2 h_ent_lt.le) (mul_pos hr_pos hl_pos)
      linarith only [h0, hΔ_pos]

    let E_pos_s := @Finset.filter (Fin M_ω) (fun ω => 0 < π_strip ω)
      (fun _ => Classical.propDecidable _) Finset.univ
    have h_mem_pos_s : ∀ ω, ω ∈ E_pos_s ↔ 0 < π_strip ω := fun ω => by
      simp only [E_pos_s, @Finset.mem_filter _ _ (fun _ => Classical.propDecidable _),
        Finset.mem_univ, true_and]
    let Bad_B1 := @Finset.filter (Fin M_ω)
      (fun ω => finProbAt π_strip O₁ ω < ρ₂ ^ ζ₂ * finProbAt π₀ O₁ ω)
      (fun _ => Classical.propDecidable _) E_pos_s
    have h_mem_B1 : ∀ ω, ω ∈ Bad_B1 ↔
        ω ∈ E_pos_s ∧ finProbAt π_strip O₁ ω < ρ₂ ^ ζ₂ * finProbAt π₀ O₁ ω :=
      fun ω => @Finset.mem_filter _ _ (fun _ => Classical.propDecidable _) _ _
    let Bad_B2 := @Finset.filter (Fin M_ω)
      (fun ω => finProbAt2 π_strip O₁ W_m ω < ρ₂ ^ ζ₂ * finProbAt π_strip O₁ ω)
      (fun _ => Classical.propDecidable _) E_pos_s
    have h_mem_B2 : ∀ ω, ω ∈ Bad_B2 ↔
        ω ∈ E_pos_s ∧ finProbAt2 π_strip O₁ W_m ω < ρ₂ ^ ζ₂ * finProbAt π_strip O₁ ω :=
      fun ω => @Finset.mem_filter _ _ (fun _ => Classical.propDecidable _) _ _
    let E_good_OW := (E_pos_s \ Bad_B1) \ Bad_B2

    have hBad_B1_mass : ∑ ω ∈ Bad_B1, π_strip ω ≤ ρ₂ ^ ζ₂ := by
      have h_fib := (Finset.sum_fiberwise_of_maps_to (s := Bad_B1)
        (fun ω hω => Finset.mem_image_of_mem O₁ hω) π_strip).symm
      rw [h_fib]
      have h_each : ∀ o ∈ Bad_B1.image O₁,
          (∑ ω ∈ Bad_B1.filter (fun ω => O₁ ω = o), π_strip ω) ≤
            ρ₂ ^ ζ₂ * ∑ ω : Fin M_ω, if O₁ ω = o then π₀ ω else 0 := by
        intro o ho
        obtain ⟨ω_o, hω_o_in, rfl⟩ := Finset.mem_image.mp ho
        have hbad := ((h_mem_B1 ω_o).mp hω_o_in).2
        have h_sub : ∑ ω ∈ Bad_B1.filter (fun ω => O₁ ω = O₁ ω_o), π_strip ω ≤
            finProbAt π_strip O₁ ω_o := by
          rw [h_probAt_eq, ← Finset.sum_filter (p := fun ω => O₁ ω = O₁ ω_o)]
          refine Finset.sum_le_sum_of_subset_of_nonneg (fun ω hω => ?_) (fun ω _ _ => hπ_s_nn ω)
          exact Finset.mem_filter.mpr ⟨Finset.mem_univ _, (Finset.mem_filter.mp hω).2⟩
        rw [← h_probAt_eq π₀ O₁ ω_o]
        exact le_trans h_sub hbad.le
      calc ∑ o ∈ Bad_B1.image O₁, ∑ ω ∈ Bad_B1.filter (fun ω => O₁ ω = o), π_strip ω
          ≤ ∑ o ∈ Bad_B1.image O₁, (ρ₂ ^ ζ₂ * ∑ ω : Fin M_ω, if O₁ ω = o then π₀ ω else 0) :=
            Finset.sum_le_sum h_each
        _ = ρ₂ ^ ζ₂ * ∑ o ∈ Bad_B1.image O₁, ∑ ω : Fin M_ω, if O₁ ω = o then π₀ ω else 0 :=
            (Finset.mul_sum _ _ _).symm
        _ ≤ ρ₂ ^ ζ₂ * 1 := by
            refine mul_le_mul_of_nonneg_left ?_ (Real.rpow_pos_of_pos hρ₂_pos _).le
            rw [Finset.sum_comm]
            calc ∑ ω : Fin M_ω, ∑ o ∈ Bad_B1.image O₁, (if O₁ ω = o then π₀ ω else 0)
                ≤ ∑ ω : Fin M_ω, π₀ ω := Finset.sum_le_sum (fun ω _ => by
                  by_cases hmem : O₁ ω ∈ Bad_B1.image O₁
                  · simp [Finset.sum_ite_eq, hmem]
                  · simp [hmem, hπ₀_nn ω])
              _ = 1 := hπ₀_sum
        _ = ρ₂ ^ ζ₂ := mul_one _

    have hBad_B2_mass : ∑ ω ∈ Bad_B2, π_strip ω ≤ C_amb * ρ₂ ^ ζ₂ := by
      have h_fib1 := (Finset.sum_fiberwise_of_maps_to (s := Bad_B2)
        (fun ω hω => Finset.mem_image_of_mem O₁ hω) π_strip).symm
      rw [h_fib1]
      have h_each_o : ∀ o ∈ Bad_B2.image O₁,
          (∑ ω ∈ Bad_B2.filter (fun ω => O₁ ω = o), π_strip ω) ≤
            (C_amb * ρ₂ ^ ζ₂) * ∑ ω : Fin M_ω, if O₁ ω = o then π_strip ω else 0 := by
        intro o ho
        obtain ⟨ω_o, hω_o_in, rfl⟩ := Finset.mem_image.mp ho
        have hω_o_pos : 0 < π_strip ω_o := (h_mem_pos_s ω_o).mp ((h_mem_B2 ω_o).mp hω_o_in).1
        let B2_o := Bad_B2.filter (fun ω => O₁ ω = O₁ ω_o)
        obtain ⟨S_BF, hS_BF_card, hS_BF_mem⟩ := hS_BF_cov u_m ha_le_um hum_le1 ω_o
        have h_img_sub : B2_o.image W_m ⊆ S_BF := by
          intro wm hwm
          obtain ⟨ω, hω_b2o, rfl⟩ := Finset.mem_image.mp hwm
          obtain ⟨hω_b2, hω_eq_o⟩ := Finset.mem_filter.mp hω_b2o
          have hω_pos : 0 < π_strip ω := (h_mem_pos_s ω).mp ((h_mem_B2 ω).mp hω_b2).1
          exact hS_BF_mem ω (hπ_s_pos_iff ω hω_pos).2.2 hω_eq_o
        have h_card_wm : ((B2_o.image W_m).card : ℝ) ≤ C_amb :=
          le_trans (by exact_mod_cast Finset.card_le_card h_img_sub) hS_BF_card
        have h_fib2 := (Finset.sum_fiberwise_of_maps_to (s := B2_o)
          (fun ω hω => Finset.mem_image_of_mem W_m hω) π_strip).symm
        rw [h_fib2]
        have h_each_wm : ∀ wm ∈ B2_o.image W_m,
            (∑ ω ∈ B2_o.filter (fun ω => W_m ω = wm), π_strip ω) ≤
              ρ₂ ^ ζ₂ * finProbAt π_strip O₁ ω_o := by
          intro wm hwm
          obtain ⟨ω_w, hω_w_in, rfl⟩ := Finset.mem_image.mp hwm
          obtain ⟨hω_w_b2, hω_w_o⟩ := Finset.mem_filter.mp hω_w_in
          have hbad2 := ((h_mem_B2 ω_w).mp hω_w_b2).2
          have h_o_eq : finProbAt π_strip O₁ ω_w = finProbAt π_strip O₁ ω_o := by
            rw [h_probAt_eq, h_probAt_eq]; simp_rw [hω_w_o]
          have h_sub : ∑ ω ∈ B2_o.filter (fun ω => W_m ω = W_m ω_w), π_strip ω ≤
              finProbAt2 π_strip O₁ W_m ω_w := by
            rw [h_probAt2_eq, ← Finset.sum_filter (p := fun ω => O₁ ω = O₁ ω_w ∧ W_m ω = W_m ω_w)]
            refine Finset.sum_le_sum_of_subset_of_nonneg (fun ω hω => ?_) (fun ω _ _ => hπ_s_nn ω)
            obtain ⟨h1, h2⟩ := Finset.mem_filter.mp hω
            exact Finset.mem_filter.mpr ⟨Finset.mem_univ _,
              (Finset.mem_filter.mp h1).2.trans hω_w_o.symm, h2⟩
          rw [← h_o_eq]
          exact le_trans h_sub hbad2.le
        rw [← h_probAt_eq π_strip O₁ ω_o]
        calc ∑ wm ∈ B2_o.image W_m, ∑ ω ∈ B2_o.filter (fun ω => W_m ω = wm), π_strip ω
            ≤ ∑ _wm ∈ B2_o.image W_m, (ρ₂ ^ ζ₂ * finProbAt π_strip O₁ ω_o) :=
              Finset.sum_le_sum h_each_wm
          _ = ((B2_o.image W_m).card : ℝ) * (ρ₂ ^ ζ₂ * finProbAt π_strip O₁ ω_o) := by
              simp [Finset.sum_const, nsmul_eq_mul]
          _ ≤ C_amb * (ρ₂ ^ ζ₂ * finProbAt π_strip O₁ ω_o) :=
              mul_le_mul_of_nonneg_right h_card_wm
                (mul_nonneg (Real.rpow_pos_of_pos hρ₂_pos _).le
                  (by rw [h_probAt_eq]; exact Finset.sum_nonneg (fun ω _ => by split_ifs <;> linarith only [hπ_s_nn ω])))
          _ = (C_amb * ρ₂ ^ ζ₂) * finProbAt π_strip O₁ ω_o := by ring
      calc ∑ o ∈ Bad_B2.image O₁, ∑ ω ∈ Bad_B2.filter (fun ω => O₁ ω = o), π_strip ω
          ≤ ∑ o ∈ Bad_B2.image O₁,
              ((C_amb * ρ₂ ^ ζ₂) * ∑ ω : Fin M_ω, if O₁ ω = o then π_strip ω else 0) :=
            Finset.sum_le_sum h_each_o
        _ = (C_amb * ρ₂ ^ ζ₂) *
              ∑ o ∈ Bad_B2.image O₁, ∑ ω : Fin M_ω, if O₁ ω = o then π_strip ω else 0 :=
            (Finset.mul_sum _ _ _).symm
        _ ≤ (C_amb * ρ₂ ^ ζ₂) * 1 := by
            refine mul_le_mul_of_nonneg_left ?_ (by positivity)
            rw [Finset.sum_comm]
            calc ∑ ω : Fin M_ω, ∑ o ∈ Bad_B2.image O₁, (if O₁ ω = o then π_strip ω else 0)
                ≤ ∑ ω : Fin M_ω, π_strip ω := Finset.sum_le_sum (fun ω _ => by
                  by_cases hmem : O₁ ω ∈ Bad_B2.image O₁
                  · simp [Finset.sum_ite_eq, hmem]
                  · simp [hmem, hπ_s_nn ω])
              _ = 1 := hπ_s_sum
        _ = C_amb * ρ₂ ^ ζ₂ := mul_one _

    have hE_good_OW_mass : 1 - (Δ_star / 4) / (32 * (2 + 2)) ≤ ∑ ω ∈ E_good_OW, π_strip ω := by
      have h_pos_sum : ∑ ω ∈ E_pos_s, π_strip ω = 1 := by
        rw [← hπ_s_sum, ← Finset.sum_subset (Finset.subset_univ E_pos_s)]
        intro ω _ hnot
        have hle : π_strip ω ≤ 0 := le_of_not_gt (fun hp => hnot ((h_mem_pos_s ω).mpr hp))
        exact le_antisymm hle (hπ_s_nn ω)
      have h_sub1 : ∑ ω ∈ E_pos_s, π_strip ω ≤
          ∑ ω ∈ E_good_OW, π_strip ω + ∑ ω ∈ Bad_B1, π_strip ω + ∑ ω ∈ Bad_B2, π_strip ω := by
        have h_union : E_pos_s ⊆ (E_good_OW ∪ Bad_B1) ∪ Bad_B2 := by
          intro ω hω
          by_cases hb2 : ω ∈ Bad_B2
          · exact Finset.mem_union_right _ hb2
          · refine Finset.mem_union_left _ ?_
            by_cases hb1 : ω ∈ Bad_B1
            · exact Finset.mem_union_right _ hb1
            · exact Finset.mem_union_left _
                (Finset.mem_sdiff.mpr ⟨Finset.mem_sdiff.mpr ⟨hω, hb1⟩, hb2⟩)
        have hu0 := Finset.sum_le_sum_of_subset_of_nonneg h_union (fun ω _ _ => hπ_s_nn ω)
        have hu1 : ∑ ω ∈ (E_good_OW ∪ Bad_B1) ∪ Bad_B2, π_strip ω ≤
            ∑ ω ∈ E_good_OW ∪ Bad_B1, π_strip ω + ∑ ω ∈ Bad_B2, π_strip ω := by
          rw [← Finset.sum_union_inter]
          have h_in := Finset.sum_nonneg (s := (E_good_OW ∪ Bad_B1) ∩ Bad_B2) (fun ω _ => hπ_s_nn ω)
          linarith only [h_in]
        have hu2 : ∑ ω ∈ E_good_OW ∪ Bad_B1, π_strip ω ≤
            ∑ ω ∈ E_good_OW, π_strip ω + ∑ ω ∈ Bad_B1, π_strip ω := by
          rw [← Finset.sum_union_inter]
          have h_in := Finset.sum_nonneg (s := E_good_OW ∩ Bad_B1) (fun ω _ => hπ_s_nn ω)
          linarith only [h_in]
        linarith only [hu0, hu1, hu2]
      have h_small_b12 : (C_amb + 1) * ρ₂ ^ ζ₂ ≤ Δ_star / 512 := by
        have h_eq : ρ₂ ^ ζ₂ = ε ^ (ζ₂ * r * l) := by
          dsimp [ρ₂]; rw [← Real.rpow_mul hε_pos.le]; congr 1; ring
        rw [h_eq]
        have hL : (Real.log (1 / ((Δ_star / 512) / (C_amb + 1))) + 1) / (ζ₂ * r * l) ≤ L_big :=
          le_trans (le_max_right _ _) (le_trans (le_max_left _ _)
            (le_trans (le_max_left _ _) (le_trans (le_max_right _ _) (le_max_right _ _))))
        have hlt := h_exp_small ((Δ_star / 512) / (C_amb + 1)) (ζ₂ * r * l)
          (div_pos (by linarith only [hΔ_pos]) (by positivity)) (by positivity) hL
        have h1 := mul_lt_mul_of_pos_left hlt (by positivity : 0 < C_amb + 1)
        rw [mul_div_cancel₀ _ (by positivity : C_amb + 1 ≠ 0)] at h1
        exact h1.le
      have halg : (C_amb + 1) * ρ₂ ^ ζ₂ = ρ₂ ^ ζ₂ + C_amb * ρ₂ ^ ζ₂ := by ring
      linarith only [h_pos_sum, h_sub1, hBad_B1_mass, hBad_B2_mass, h_small_b12, halg]

    let Par2 : Fin M_ω → Fin M_T × ℤ := fun ω => (T_idx ω, dyadicTimeBin ε u_m (c_val ω))
    have hPar2_W : ∀ ω₁ ω₂, Par2 ω₁ = Par2 ω₂ → W_m ω₁ = W_m ω₂ := by
      intro ω₁ ω₂ h_eq
      obtain ⟨htid, hkum⟩ := Prod.ext_iff.mp h_eq
      dsimp [Par2] at htid hkum
      have h_ka1 := (hs4_dyadic ε a u_m (c_val ω₁) 0 0 0
        hε_pos hε_lt_half ha_pos.le ha_le_um le_rfl).2.1
      have h_ka2 := (hs4_dyadic ε a u_m (c_val ω₂) 0 0 0
        hε_pos hε_lt_half ha_pos.le ha_le_um le_rfl).2.1
      have hka_eq : dyadicTimeBin ε a (c_val ω₁) = dyadicTimeBin ε a (c_val ω₂) := by
        rw [h_ka1, h_ka2, hkum]
      have h_kk1 := (hs4_dyadic ε k u_m (c_val ω₁) 0 0 0
        hε_pos hε_lt_half hk_nn (le_trans hk_le_a ha_le_um) le_rfl).2.1
      have h_kk2 := (hs4_dyadic ε k u_m (c_val ω₂) 0 0 0
        hε_pos hε_lt_half hk_nn (le_trans hk_le_a ha_le_um) le_rfl).2.1
      have hkk_eq : dyadicTimeBin ε k (c_val ω₁) = dyadicTimeBin ε k (c_val ω₂) := by
        rw [h_kk1, h_kk2, hkum]
      have hok_eq : isoAnchoredObs ε k T_idx V_part A_part c_val ω₁ =
          isoAnchoredObs ε k T_idx V_part A_part c_val ω₂ := by
        dsimp [isoAnchoredObs, dyadicTimeMid]; rw [htid, hkk_eq]
      have hoa_eq : isoAnchoredObs ε a T_idx V_part A_part c_val ω₁ =
          isoAnchoredObs ε a T_idx V_part A_part c_val ω₂ := by
        dsimp [isoAnchoredObs, dyadicTimeMid]; rw [htid, hka_eq]
      have hB_eq : B_obs ω₁ = B_obs ω₂ := by
        dsimp [B_obs, isoStripEarlierObs]
        rw [hok_eq, hoa_eq]
        congr 2; dsimp [dyadicTimeMid]; rw [htid, hka_eq]
      have hF_eq : F_at u_m ω₁ = F_at u_m ω₂ := by
        dsimp [F_at, isoLastBlockObs]
        rw [hok_eq, hkum]
        congr 1; dsimp [dyadicTimeMid]; rw [htid, hkum]
      exact Prod.ext hB_eq hF_eq

    have h_mi_cond2 : θ_R / ζ₂ + 1 / (ζ₂ * (r * l) * ell) ≤ (Δ_star / 4) / (32 * (2 + 2)) := by
      have h1 : θ_R / ζ₂ = Δ_star / 1024 := by dsimp [θ_R]; field_simp [hζ₂_pos.ne']
      have hL : 1 / (ζ₂ * (r * l) * (Δ_star / 1024)) ≤ L_big :=
        le_trans (le_max_left _ _) (le_trans (le_max_left _ _)
          (le_trans (le_max_right _ _) (le_trans (le_max_left _ _)
            (le_trans (le_max_right _ _) (le_max_right _ _)))))
      have h2 : 1 / (ζ₂ * (r * l) * ell) ≤ Δ_star / 1024 := by
        rw [div_le_iff₀ (mul_pos (mul_pos hζ₂_pos (mul_pos hr_pos hl_pos)) hell_pos)]
        have h3 := (div_le_iff₀ (mul_pos (mul_pos hζ₂_pos (mul_pos hr_pos hl_pos))
          (by linarith only [hΔ_pos] : (0 : ℝ) < Δ_star / 1024))).mp (le_trans hL hell_gt_L.le)
        have heq : ell * (ζ₂ * (r * l) * (Δ_star / 1024)) =
            (Δ_star / 1024) * (ζ₂ * (r * l) * ell) := by ring
        linarith only [h3, heq]
      linarith only [h1, h2]
    have h_tail_cond2 : C_amb * ε ^ (r * l) ≤ (Δ_star / 4) / (32 * (2 + 2)) := by
      have hL : (Real.log (1 / ((Δ_star / 512) / C_amb)) + 1) / (r * l) ≤ L_big :=
        le_trans (le_max_right _ _) (le_trans (le_max_left _ _)
          (le_trans (le_max_right _ _) (le_trans (le_max_left _ _)
            (le_trans (le_max_right _ _) (le_max_right _ _)))))
      have hlt := h_exp_small ((Δ_star / 512) / C_amb) (r * l)
        (div_pos (by linarith only [hΔ_pos]) hC_amb_pos) (mul_pos hr_pos hl_pos) hL
      have h1 := mul_lt_mul_of_pos_left hlt hC_amb_pos
      rw [mul_div_cancel₀ _ hC_amb_pos.ne'] at h1
      linarith only [h1]

    obtain ⟨p1_star, E_good2, G_Wm, hp1_nn, hp1_hi, hE_good2_sub, hE_good2_pos, hG_Wm_mass, hG_Wm_fib⟩ :=
      increment_surprise_and_marginal_core ε (K₀ / m_strip) (r * l) ζ₂ (Δ_star / 4) 2 C_amb (2 * s - Δ_star / 4) θ_R
        π_strip π_amb W_m Par2 (F_at u_m1) X_r E_good_OW
        hε_pos hε_lt_half hK_amb2_ge1 (mul_pos hr_pos hl_pos) hζ₂_pos
        (by linarith only [hΔ_pos]) (by norm_num) hC_amb_ge
        hp_hi2_nn (by linarith only [hs₁, hΔ_pos]) hθ_R_pos.le
        hπ_s_nn hπ_s_sum hπ_amb_nn hπ_amb_sum hπ_s_le_amb hPar2_W hE_good_OW_mass
        (fun ω₀ _ => by
          obtain ⟨S_Fch, hSFch_c, hSFch_m⟩ :=
            hS_Fch_cov u_m (r * l) ha_le_um (mul_pos hr_pos hl_pos) (hu_m1_eq ▸ hum1_le1) ω₀
          refine ⟨S_Fch, ?_, fun ω _ hwm => ?_⟩
          · exact hSFch_c
          · obtain ⟨hb, hf⟩ := Prod.ext_iff.mp hwm
            rw [hu_m1_eq]; exact hSFch_m ω hb hf)
        (by have heq : (2 * s - Δ_star / 4 - Δ_star / 4) * (r * l) =
              (2 * s - Δ_star / 2) * (r * l) := by ring
            rw [heq]; exact h_ent_lt.le)
        hmi_m h_mi_cond2 h_tail_cond2

    have hG_Wm_ne : G_Wm.Nonempty := by
      refine Finset.nonempty_of_ne_empty (fun hemp => ?_)
      change c_ret2 / 2 ≤ ∑ w ∈ G_Wm, ∑ ω ∈ E_good2, (if W_m ω = w then π_strip ω else 0) at hG_Wm_mass
      rw [hemp, Finset.sum_empty] at hG_Wm_mass
      linarith only [hG_Wm_mass, hc_ret2_pos]
    obtain ⟨wm, hwm_in⟩ := hG_Wm_ne
    obtain ⟨hm_wm_pos, hm_wm_ret, hcard_P2, q2, hq2_nn, hq2_sum, hq2_out, hq2_ub, hq2_ind, hq2_P, hq2_par⟩ :=
      hG_Wm_fib wm hwm_in
    let E_wm := E_good2.filter (fun ω => W_m ω = wm)
    let S_P2 : Finset (ℤ × ℤ) := E_wm.image (F_at u_m1)
    let S_V2 : Finset ℤ := E_wm.image X_r
    let q_PV2 : (ℤ × ℤ) → ℤ → ℝ := fun p v =>
      ∑ ω : Fin M_ω, if F_at u_m1 ω = p ∧ X_r ω = v then q2 ω else 0
    let ok_m : ℤ × ℤ × ℤ := wm.1.1
    let e_tan_m : EuclideanSpace ℝ (Fin 2) := negPerp2D (n_dir ok_m)
    have he_tan_norm : ‖e_tan_m‖ = 1 := (h_negPerp_norm (n_dir ok_m)).trans (hn_dir_unit ok_m)
    let step_tm : ℝ := ((2 : ℝ) ^ (dyadicTimeLevel ε u_m))⁻¹
    let step_tm1 : ℝ := ((2 : ℝ) ^ (dyadicTimeLevel ε u_m1))⁻¹
    let cb2 : ℝ := ((wm.2.1 : ℝ) + 1 / 2) * step_tm
    let xb2 : ℝ := ((wm.2.2 : ℝ) + 1 / 2) * dyadicRealStep ε u_m
    let c_raw2 : (ℤ × ℤ) → ℝ := fun p => ((p.1 : ℝ) + 1 / 2) * step_tm1
    let x_raw2 : (ℤ × ℤ) → ℝ := fun p => ((p.2 : ℝ) + 1 / 2) * dyadicRealStep ε u_m1
    let c_pt2 : (ℤ × ℤ) → ℝ := fun p => ε ^ (-u_m) * (c_raw2 p - cb2)
    let x_pt2 : (ℤ × ℤ) → ℝ := fun p => ε ^ (-u_m) * (x_raw2 p - xb2)
    let v_bar2 : ℤ → ℝ := fun v => ((v : ℝ) + 1 / 2) * dyadicRealStep ε (r * l)

    have hum_nn : 0 ≤ u_m := le_trans ha_pos.le ha_le_um
    have hum1_nn : 0 ≤ u_m1 := by rw [hu_m1_eq]; positivity
    have h_eum_pos : 0 < ε ^ (-u_m) := Real.rpow_pos_of_pos hε_pos (-u_m)
    have h_eum_m1 : ε ^ (-u_m) * ε ^ u_m1 = ρ₂ := by
      rw [← Real.rpow_add hε_pos, hu_m1_eq]; dsimp [ρ₂]; congr 1; ring
    have h_eum_m : ε ^ (-u_m) * ε ^ u_m = 1 := by
      rw [← Real.rpow_add hε_pos, neg_add_cancel, Real.rpow_zero]

    have h_wm_ok : ∀ ω ∈ E_wm, O_at k ω = ok_m := by
      intro ω hω
      have h_eq : W_m ω = wm := (Finset.mem_filter.mp hω).2
      have hB : B_obs ω = wm.1 := (Prod.ext_iff.mp h_eq).1
      exact (Prod.ext_iff.mp hB).1
    have h_wm_ok_iso : ∀ ω ∈ E_wm, isoAnchoredObs ε k T_idx V_part A_part c_val ω = ok_m :=
      h_wm_ok

    have hP2_bds : ∀ p ∈ S_P2, |c_pt2 p| ≤ B_iso + 6 ∧ |x_pt2 p| ≤ B_iso + 6 := by
      intro p hp
      obtain ⟨ω, hω_in, rfl⟩ := Finset.mem_image.mp hp
      have hω_wm : W_m ω = wm := (Finset.mem_filter.mp hω_in).2
      have hω_fm : F_at u_m ω = wm.2 := (Prod.ext_iff.mp hω_wm).2
      have hω_ok : O_at k ω = ok_m := h_wm_ok ω hω_in
      have hcb : cb2 = dyadicTimeMid ε u_m (c_val ω) := by
        dsimp [cb2, step_tm, dyadicTimeMid]; rw [← hω_fm]; rfl
      have hcr : c_raw2 (F_at u_m1 ω) = dyadicTimeMid ε u_m1 (c_val ω) := rfl
      have h_le_e : ε ^ u_m1 ≤ ε ^ u_m :=
        Real.rpow_le_rpow_of_exponent_ge hε_pos (by linarith only [hε_lt_half])
          (by rw [hu_m1_eq]; have := mul_pos hr_pos hl_pos; linarith only [this])
      have hc_diff : |c_raw2 (F_at u_m1 ω) - cb2| ≤ ε ^ u_m := by
        rw [hcb, hcr]
        have h1 := ((hs4_dyadic ε u_m u_m (c_val ω) 0 0 0
          hε_pos hε_lt_half hum_nn le_rfl le_rfl).2.2.2.2.1 (hc_val_mem ω)).2.2.2
        have h2 := ((hs4_dyadic ε u_m1 u_m1 (c_val ω) 0 0 0
          hε_pos hε_lt_half hum1_nn le_rfl le_rfl).2.2.2.2.1 (hc_val_mem ω)).2.2.2
        have htri : |dyadicTimeMid ε u_m1 (c_val ω) - dyadicTimeMid ε u_m (c_val ω)| ≤
            |c_val ω - dyadicTimeMid ε u_m1 (c_val ω)| +
              |c_val ω - dyadicTimeMid ε u_m (c_val ω)| := by
          rw [abs_sub_comm (c_val ω)]; exact abs_sub_le _ _ _
        linarith only [htri, h1, h2, h_le_e]
      have hc_bd : |c_pt2 (F_at u_m1 ω)| ≤ B_iso + 6 := by
        dsimp [c_pt2]; rw [abs_mul, abs_of_pos h_eum_pos]
        calc ε ^ (-u_m) * |c_raw2 (F_at u_m1 ω) - cb2|
            ≤ ε ^ (-u_m) * ε ^ u_m := mul_le_mul_of_nonneg_left hc_diff h_eum_pos.le
          _ = 1 := h_eum_m
          _ ≤ B_iso + 6 := by linarith only [hB_iso]
      let ym := inner ℝ (A_part (T_idx ω) + (dyadicTimeMid ε u_m (c_val ω)) • V_part (T_idx ω)) e_tan_m
      let ym1 := inner ℝ (A_part (T_idx ω) + (dyadicTimeMid ε u_m1 (c_val ω)) • V_part (T_idx ω)) e_tan_m
      have hxb : xb2 = dyadicRealMid ε u_m ym := by
        dsimp [xb2, dyadicRealMid]; rw [← hω_fm]
        dsimp [F_at, isoLastBlockObs, ym, e_tan_m]
        rw [h_wm_ok_iso ω hω_in]
      have hxr : x_raw2 (F_at u_m1 ω) = dyadicRealMid ε u_m1 ym1 := by
        dsimp [x_raw2, dyadicRealMid, F_at, isoLastBlockObs, ym1, e_tan_m]
        rw [h_wm_ok_iso ω hω_in]
      have hm1 := (hs4_dyadic ε u_m u_m 0 u_m u_m ym hε_pos hε_lt_half hum_nn le_rfl le_rfl).2.2.2.2.2.2.2.2.2
      have hm2 := (hs4_dyadic ε u_m1 u_m1 0 u_m1 u_m1 ym1 hε_pos hε_lt_half hum1_nn le_rfl le_rfl).2.2.2.2.2.2.2.2.2
      have hv_tan : |inner ℝ (V_part (T_idx ω)) e_tan_m| ≤ B_iso := by
        have hcs := abs_real_inner_le_norm (V_part (T_idx ω)) e_tan_m
        rw [he_tan_norm, mul_one] at hcs
        exact le_trans hcs (hVA_bds (T_idx ω)).1
      have hym_diff : |ym1 - ym| ≤ B_iso * ε ^ u_m := by
        have heq : ym1 - ym =
            (dyadicTimeMid ε u_m1 (c_val ω) - dyadicTimeMid ε u_m (c_val ω)) *
              inner ℝ (V_part (T_idx ω)) e_tan_m := by
          dsimp [ym, ym1]
          rw [← inner_sub_left]
          have : (A_part (T_idx ω) + dyadicTimeMid ε u_m1 (c_val ω) • V_part (T_idx ω)) -
              (A_part (T_idx ω) + dyadicTimeMid ε u_m (c_val ω) • V_part (T_idx ω)) =
              (dyadicTimeMid ε u_m1 (c_val ω) - dyadicTimeMid ε u_m (c_val ω)) • V_part (T_idx ω) := by
            rw [add_sub_add_left_eq_sub, ← sub_smul]
          rw [this, real_inner_smul_left]
        rw [heq, abs_mul, ← hcb, ← hcr, mul_comm]
        exact mul_le_mul hv_tan hc_diff (abs_nonneg _) (by linarith only [hB_iso])
      have hraw_diff : |x_raw2 (F_at u_m1 ω) - xb2| ≤ (B_iso + 2) * ε ^ u_m := by
        rw [hxb, hxr]
        have htri : |dyadicRealMid ε u_m1 ym1 - dyadicRealMid ε u_m ym| ≤
            |ym1 - dyadicRealMid ε u_m1 ym1| + |ym1 - ym| + |ym - dyadicRealMid ε u_m ym| := by
          have h1 := abs_sub_le (dyadicRealMid ε u_m1 ym1) ym1 (dyadicRealMid ε u_m ym)
          have h2 := abs_sub_le ym1 ym (dyadicRealMid ε u_m ym)
          rw [abs_sub_comm (dyadicRealMid ε u_m1 ym1) ym1] at h1
          linarith only [h1, h2]
        have halg : (B_iso + 2) * ε ^ u_m = ε ^ u_m + B_iso * ε ^ u_m + ε ^ u_m := by ring
        linarith only [htri, hm1, hm2, h_le_e, hym_diff, halg]
      have hx_bd : |x_pt2 (F_at u_m1 ω)| ≤ B_iso + 6 := by
        dsimp [x_pt2]; rw [abs_mul, abs_of_pos h_eum_pos]
        calc ε ^ (-u_m) * |x_raw2 (F_at u_m1 ω) - xb2|
            ≤ ε ^ (-u_m) * ((B_iso + 2) * ε ^ u_m) :=
              mul_le_mul_of_nonneg_left hraw_diff h_eum_pos.le
          _ = (B_iso + 2) * (ε ^ (-u_m) * ε ^ u_m) := by ring
          _ = B_iso + 2 := by rw [h_eum_m, mul_one]
          _ ≤ B_iso + 6 := by linarith only []
      exact ⟨hc_bd, hx_bd⟩

    have hP2_sep : ∀ p₁ ∈ S_P2, ∀ p₂ ∈ S_P2, p₁ ≠ p₂ →
        ρ₂ / 2 ≤ max |c_pt2 p₁ - c_pt2 p₂| |x_pt2 p₁ - x_pt2 p₂| := by
      intro p₁ _ p₂ _ hne
      have hdy := hs4_dyadic ε u_m1 u_m1 0 u_m1 u_m1 0 hε_pos hε_lt_half hum1_nn le_rfl le_rfl
      by_cases hk12 : p₁.1 ≠ p₂.1
      · refine le_trans ?_ (le_max_left _ _)
        have hint : (1 : ℝ) ≤ |(p₁.1 : ℝ) - (p₂.1 : ℝ)| := by
          have : (1 : ℤ) ≤ |p₁.1 - p₂.1| := Int.one_le_abs (sub_ne_zero.mpr hk12)
          exact_mod_cast this
        have hstep_lb : (1 / 2) * ε ^ u_m1 ≤ step_tm1 := hdy.2.2.1
        have heq : c_pt2 p₁ - c_pt2 p₂ = ε ^ (-u_m) * (((p₁.1 : ℝ) - (p₂.1 : ℝ)) * step_tm1) := by
          dsimp [c_pt2, c_raw2]; ring
        rw [heq, abs_mul, abs_mul, abs_of_pos h_eum_pos, abs_of_nonneg (by positivity : 0 ≤ step_tm1)]
        calc ρ₂ / 2 = ε ^ (-u_m) * (1 * ((1 / 2) * ε ^ u_m1)) := by rw [← h_eum_m1]; ring
          _ ≤ ε ^ (-u_m) * (|(p₁.1 : ℝ) - (p₂.1 : ℝ)| * step_tm1) :=
              mul_le_mul_of_nonneg_left (mul_le_mul hint hstep_lb (by positivity) (by positivity))
                h_eum_pos.le
      · push_neg at hk12
        have hx12 : p₁.2 ≠ p₂.2 := fun hx => hne (Prod.ext hk12 hx)
        refine le_trans ?_ (le_max_right _ _)
        have hint : (1 : ℝ) ≤ |(p₁.2 : ℝ) - (p₂.2 : ℝ)| := by
          have : (1 : ℤ) ≤ |p₁.2 - p₂.2| := Int.one_le_abs (sub_ne_zero.mpr hx12)
          exact_mod_cast this
        have hstep_lb : ε ^ u_m1 ≤ dyadicRealStep ε u_m1 := hdy.2.2.2.2.2.2.2.1
        have hstep_nn : 0 ≤ dyadicRealStep ε u_m1 :=
          le_trans (Real.rpow_pos_of_pos hε_pos u_m1).le hstep_lb
        have heq : x_pt2 p₁ - x_pt2 p₂ =
            ε ^ (-u_m) * (((p₁.2 : ℝ) - (p₂.2 : ℝ)) * dyadicRealStep ε u_m1) := by
          dsimp [x_pt2, x_raw2]; ring
        rw [heq, abs_mul, abs_mul, abs_of_pos h_eum_pos, abs_of_nonneg hstep_nn]
        calc ρ₂ / 2 ≤ ρ₂ := by linarith only [hρ₂_pos]
          _ = ε ^ (-u_m) * (1 * ε ^ u_m1) := by rw [← h_eum_m1]; ring
          _ ≤ ε ^ (-u_m) * (|(p₁.2 : ℝ) - (p₂.2 : ℝ)| * dyadicRealStep ε u_m1) :=
              mul_le_mul_of_nonneg_left (mul_le_mul hint hstep_lb
                (Real.rpow_pos_of_pos hε_pos _).le (by positivity)) h_eum_pos.le

    have hV2_bds : ∀ v ∈ S_V2, |v_bar2 v| ≤ B_iso + 6 := by
      intro v hv
      obtain ⟨ω, hω_in, rfl⟩ := Finset.mem_image.mp hv
      have hω_ok : O_at k ω = ok_m := h_wm_ok ω hω_in
      let xtan := inner ℝ (V_part (T_idx ω)) e_tan_m
      have hmid : v_bar2 (X_r ω) = dyadicRealMid ε (r * l) xtan := by
        dsimp [v_bar2, dyadicRealMid, X_r, isoTanVelBin, xtan, e_tan_m]
        rw [h_wm_ok_iso ω hω_in]
      have hm := (hs4_dyadic ε (r * l) (r * l) 0 (r * l) (r * l) xtan
        hε_pos hε_lt_half (mul_nonneg hr_pos.le hl_pos.le) le_rfl le_rfl).2.2.2.2.2.2.2.2.2
      have hv_tan : |xtan| ≤ B_iso := by
        have hcs := abs_real_inner_le_norm (V_part (T_idx ω)) e_tan_m
        rw [he_tan_norm, mul_one] at hcs
        exact le_trans hcs (hVA_bds (T_idx ω)).1
      rw [hmid]
      have htri : |dyadicRealMid ε (r * l) xtan| ≤ |xtan| + |xtan - dyadicRealMid ε (r * l) xtan| := by
        have h1 := abs_sub_le (dyadicRealMid ε (r * l) xtan) xtan 0
        rw [sub_zero, sub_zero, abs_sub_comm] at h1
        linarith only [h1]
      linarith only [htri, hv_tan, hm, hρ₂_lt1]

    have hq_PV2_eq : ∀ p v,
        q_PV2 p v = ∑ ω ∈ E_wm, if F_at u_m1 ω = p ∧ X_r ω = v then q2 ω else 0 := by
      intro p v; dsimp [q_PV2]
      rw [← Finset.sum_subset (Finset.subset_univ E_wm)]
      intro ω _ hnot; simp [hq2_out ω hnot]
    have hq_PV2_sum_V : ∀ p, ∑ v ∈ S_V2, q_PV2 p v =
        ∑ ω : Fin M_ω, if F_at u_m1 ω = p then q2 ω else 0 := by
      intro p; simp_rw [hq_PV2_eq p]; rw [Finset.sum_comm]
      have h1 : ∑ ω ∈ E_wm, ∑ v ∈ S_V2, (if F_at u_m1 ω = p ∧ X_r ω = v then q2 ω else 0) =
          ∑ ω ∈ E_wm, if F_at u_m1 ω = p then q2 ω else 0 := by
        refine Finset.sum_congr rfl (fun ω hω => ?_)
        have hv_in : X_r ω ∈ S_V2 := Finset.mem_image_of_mem X_r hω
        by_cases hp_eq : F_at u_m1 ω = p <;> simp [hp_eq, Finset.sum_ite_eq, hv_in]
      rw [h1, ← Finset.sum_subset (Finset.subset_univ E_wm)]
      intro ω _ hnot; simp [hq2_out ω hnot]
    have hq_PV2_sum_P : ∀ v, ∑ p ∈ S_P2, q_PV2 p v =
        ∑ ω : Fin M_ω, if X_r ω = v then q2 ω else 0 := by
      intro v; simp_rw [fun p => hq_PV2_eq p v]; rw [Finset.sum_comm]
      have h1 : ∑ ω ∈ E_wm, ∑ p ∈ S_P2, (if F_at u_m1 ω = p ∧ X_r ω = v then q2 ω else 0) =
          ∑ ω ∈ E_wm, if X_r ω = v then q2 ω else 0 := by
        refine Finset.sum_congr rfl (fun ω hω => ?_)
        have hp_in : F_at u_m1 ω ∈ S_P2 := Finset.mem_image_of_mem (F_at u_m1) hω
        by_cases hv_eq : X_r ω = v <;> simp [hv_eq, Finset.sum_ite_eq, hp_in]
      rw [h1, ← Finset.sum_subset (Finset.subset_univ E_wm)]
      intro ω _ hnot; simp [hq2_out ω hnot]
    have hq_PV2_tot : ∑ p ∈ S_P2, ∑ v ∈ S_V2, q_PV2 p v = 1 := by
      simp_rw [hq_PV2_sum_V]; rw [Finset.sum_comm]
      have h1 : ∑ ω : Fin M_ω, ∑ p ∈ S_P2, (if F_at u_m1 ω = p then q2 ω else 0) =
          ∑ ω : Fin M_ω, q2 ω := by
        refine Finset.sum_congr rfl (fun ω _ => ?_)
        by_cases hω : ω ∈ E_wm
        · have hp_in : F_at u_m1 ω ∈ S_P2 := Finset.mem_image_of_mem (F_at u_m1) hω
          simp [Finset.sum_ite_eq, hp_in]
        · simp [hq2_out ω hω]
      rw [h1, hq2_sum]

    have h_int_nonconc : ∀ (x₀ : ℝ) (S_int : Finset ℤ), S_int ⊆ S_V2 →
        (∀ v ∈ S_int, |v_bar2 v - x₀| ≤ ρ₂ ^ a₀) →
        (∑ v ∈ S_int, ∑ p ∈ S_P2, q_PV2 p v) ≤ 1 / (4 * K_q2 ^ 2) := by
      intro x₀ S_int hS_sub hS_int
      obtain ⟨S_Vd1, hSVd1_c, hSVd1_m⟩ := hS_Vd_cov d_star (x₀ - ε ^ d_star) ok_m hd_pos hd_lt_l.le
      obtain ⟨S_Vd2, hSVd2_c, hSVd2_m⟩ := hS_Vd_cov d_star (x₀ + ε ^ d_star) ok_m hd_pos hd_lt_l.le
      let S_Vd := S_Vd1 ∪ S_Vd2
      have hS_Vd_card : (S_Vd.card : ℝ) ≤ 2 * C_amb := by
        have h1 : S_Vd.card ≤ S_Vd1.card + S_Vd2.card := Finset.card_union_le _ _
        have h2 : (S_Vd.card : ℝ) ≤ (S_Vd1.card : ℝ) + (S_Vd2.card : ℝ) := by exact_mod_cast h1
        linarith only [h2, hSVd1_c, hSVd2_c]
      let E_wm_int := E_wm.filter (fun ω => X_r ω ∈ S_int)
      have h_in_Vd : ∀ ω ∈ E_wm_int, V_d ω ∈ S_Vd := by
        intro ω hω
        obtain ⟨hω_wm, hω_v⟩ := Finset.mem_filter.mp hω
        have hω_good2 : ω ∈ E_good2 := (Finset.mem_filter.mp hω_wm).1
        have hω_ow : ω ∈ E_good_OW := hE_good2_sub hω_good2
        have hω_pos_s : 0 < π_strip ω :=
          (h_mem_pos_s ω).mp (Finset.mem_sdiff.mp (Finset.mem_sdiff.mp hω_ow).1).1
        have hω_ok : O_at k ω = ok_m := h_wm_ok ω hω_wm
        have h_strip_ω : |inner ℝ (V_part (T_idx ω)) (n_dir ok_m) - w_off ok_m| ≤ 4 * ε ^ l := by
          have := (hπ_s_pos_iff ω hω_pos_s).2.2
          rwa [hω_ok] at this
        let xtan := inner ℝ (V_part (T_idx ω)) e_tan_m
        have hmid : v_bar2 (X_r ω) = dyadicRealMid ε (r * l) xtan := by
          dsimp [v_bar2, dyadicRealMid, X_r, isoTanVelBin, xtan, e_tan_m]
          rw [h_wm_ok_iso ω hω_wm]
