    let R_set : Finset ℕ := Finset.range (2 ^ m_time)
    let S_qr : ((ℤ × ℤ) × (ℤ × ℤ)) → ℕ → Finset (ℕ × ((ℤ × ℤ) × (ℤ × ℤ))) :=
