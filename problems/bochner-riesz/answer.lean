  let aa_hat : (ℤ × ℤ × ℤ × ℤ × ℤ × ℤ) → ℝ := fun g =>
    let c_m_g := ((g.1 : ℝ) + 1 / 2) * ((2 : ℝ) ^ m₁)⁻¹
