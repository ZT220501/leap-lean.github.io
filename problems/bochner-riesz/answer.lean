        (fun _ => Classical.propDecidable _) Finset.univ
    have hO_act_zero : ∀ o, o ∉ O_act → p_cO o = 0 ∧ ∀ d, p_c o d = 0 := by
      intro o ho
      have hnot_pos : ¬ 0 < p_cO o :=
        fun hpos => ho ((@Finset.mem_filter _ _ (fun _ => Classical.propDecidable _) Finset.univ o).mpr
          ⟨Finset.mem_univ o, hpos⟩)
      have hle0 : p_cO o ≤ 0 := le_of_not_gt hnot_pos
      have h0 : p_cO o = 0 := le_antisymm hle0 (hp_cO_nn o)
      refine ⟨h0, fun d => ?_⟩
      have hd_le : p_c o d ≤ p_cO o :=
        Finset.single_le_sum (fun d' _ => hp_c_nn o d') (Finset.mem_univ d)
      exact le_antisymm (hd_le.trans h0.le) (hp_c_nn o d)
    have hO_act_wit : ∀ o ∈ O_act, ∃ d : Fin N_D, 0 < p_c o d := by
      intro o ho
      have hpos : 0 < p_cO o := (Finset.mem_filter.mp ho).2
      by_contra hall0
      push_neg at hall0
      have h0 : p_cO o = 0 :=
        Finset.sum_eq_zero (fun d _ => le_antisymm (hall0 d) (hp_c_nn o d))
      exact hpos.ne' h0
    have hO_act_sum : ∑ o ∈ O_act, p_cO o = 1 := by
      rw [Finset.sum_subset (Finset.subset_univ O_act) (fun o _ ho => (hO_act_zero o ho).1)]
      exact hp_c_sum
    have h_step3_1 : ∑ o : Fin N_O, p_cO o * Real.log (m_obs o) ≤
        (∑ o ∈ O_act, p_cO o * Real.log (m_bin m_idx o)) + Real.log M_loss := by
      have h_sub_eq : ∑ o : Fin N_O, p_cO o * Real.log (m_obs o) =
          ∑ o ∈ O_act, p_cO o * Real.log (m_obs o) := by
        refine (Finset.sum_subset (Finset.subset_univ O_act) (fun o _ ho => ?_)).symm
        simp [(hO_act_zero o ho).1]
      rw [h_sub_eq]
      calc ∑ o ∈ O_act, p_cO o * Real.log (m_obs o)
          ≤ ∑ o ∈ O_act, (p_cO o * Real.log (m_bin m_idx o) + p_cO o * Real.log M_loss) := by
            refine Finset.sum_le_sum (fun o ho => ?_)
            obtain ⟨d, hd_pos⟩ := hO_act_wit o ho
            have hp_pr := h_high_props o d hd_pos
            have hlog_le : Real.log (m_obs o) ≤ Real.log (m_bin m_idx o) + Real.log M_loss := by
              calc Real.log (m_obs o)
                  ≤ Real.log (M_loss * m_bin m_idx o) :=
                    Real.log_le_log hp_pr.2.2.2.2.2.1 hp_pr.2.2.2.2.2.2.1
                _ = Real.log M_loss + Real.log (m_bin m_idx o) :=
                    Real.log_mul hM_loss_pos.ne' hp_pr.2.2.2.2.2.2.2.2.ne'
                _ = Real.log (m_bin m_idx o) + Real.log M_loss := add_comm _ _
            have h_mul := mul_le_mul_of_nonneg_left hlog_le (hp_cO_nn o)
            linarith only [h_mul]
        _ = (∑ o ∈ O_act, p_cO o * Real.log (m_bin m_idx o)) + Real.log M_loss := by
            rw [Finset.sum_add_distrib, ← Finset.sum_mul, hO_act_sum, one_mul]
    
    let Z_of : Fin N_O → ℕ × ((ℤ × ℤ) × (ℤ × ℤ)) := fun o => (r_O o, k_cell o)
    let Z_act : Finset (ℕ × ((ℤ × ℤ) × (ℤ × ℤ))) := O_act.image Z_of
    let F_z : (ℕ × ((ℤ × ℤ) × (ℤ × ℤ))) → Finset (Fin N_O) :=
      fun z => O_act.filter (fun o => Z_of o = z)
    let p_ZD : (ℕ × ((ℤ × ℤ) × (ℤ × ℤ))) → Fin N_D → ℝ :=
      fun z d => ∑ o ∈ F_z z, p_c o d
    let p_Z : (ℕ × ((ℤ × ℤ) × (ℤ × ℤ))) → ℝ :=
      fun z => ∑ o ∈ F_z z, p_cO o
    have hp_ZD_nn : ∀ z d, 0 ≤ p_ZD z d :=
      fun z d => Finset.sum_nonneg (fun o _ => hp_c_nn o d)
    have hp_Z_eq_sum_d : ∀ z, p_Z z = ∑ d : Fin N_D, p_ZD z d := by
      intro z; dsimp [p_Z, p_ZD, p_cO]; exact Finset.sum_comm
    have hp_ZD_sum_z : ∀ d : Fin N_D, ∑ z ∈ Z_act, p_ZD z d = p_cD d := by
      intro d
      have h1 : ∑ z ∈ Z_act, p_ZD z d = ∑ o ∈ O_act, p_c o d :=
        Finset.sum_fiberwise_of_maps_to (fun o ho => Finset.mem_image_of_mem Z_of ho) _
      rw [h1]
      exact Finset.sum_subset (Finset.subset_univ O_act) (fun o _ ho => (hO_act_zero o ho).2 d)
    have hp_Z_sum_z : ∑ z ∈ Z_act, p_Z z = 1 := by
      have h1 : ∑ z ∈ Z_act, p_Z z = ∑ o ∈ O_act, p_cO o :=
        Finset.sum_fiberwise_of_maps_to (fun o ho => Finset.mem_image_of_mem Z_of ho) _
      exact h1.trans hO_act_sum
    have hZ_act_props : ∀ z ∈ Z_act,
        z.1 < 2 ^ m_time ∧
        0 < p_Z z ∧
        (T_cell z.2).Nonempty ∧
        0 < ((T_cell z.2).card : ℝ) ∧
        ∑ o ∈ F_z z, m_bin m_idx o ≤ M_unit * ((T_cell z.2).card : ℝ) := by
      intro z hz
      obtain ⟨o₀, ho₀, hzo₀⟩ := Finset.mem_image.mp hz
      obtain ⟨d₀, hd₀_pos⟩ := hO_act_wit o₀ ho₀
      have hp0 := h_high_props o₀ d₀ hd₀_pos
      have hz1_lt : z.1 < 2 ^ m_time := by rw [← hzo₀]; exact hp0.2.2.1
      have ho₀_Fz : o₀ ∈ F_z z := Finset.mem_filter.mpr ⟨ho₀, hzo₀⟩
      have hpZ_pos : 0 < p_Z z :=
        lt_of_lt_of_le (Finset.mem_filter.mp ho₀).2
          (Finset.single_le_sum (fun o _ => hp_cO_nn o) ho₀_Fz)
      let C_r := ((z.1 : ℝ) + 1 / 2) * ((2 : ℝ) ^ m_time)⁻¹
      let S_Z : Finset (Fin N_O) :=
        letI := Classical.propDecidable
        Finset.univ.filter (fun o : Fin N_O =>
          r_O o = z.1 ∧
          pktRound2D (ε ^ a) (V_O o) = z.2.1 ∧
          pktRound2D (ε ^ a) (X_O o + (1 / 2 - C_r) • V_O o) = z.2.2 ∧
          (4 * (M_c : ℝ) ^ 2)⁻¹ * ε ^ A₀ * E_f ≤ m_bin m_idx o)
      have hFz_sub : F_z z ⊆ S_Z := by
        intro o ho
        obtain ⟨ho_act, hzo⟩ := Finset.mem_filter.mp ho
        obtain ⟨d, hd_pos⟩ := hO_act_wit o ho_act
        have hpo := h_high_props o d hd_pos
        have hr_o : r_O o = z.1 := congrArg Prod.fst hzo
        have hk_o : k_cell o = z.2 := congrArg Prod.snd hzo
        have hCo_Cr : C_o o = C_r := by dsimp [C_o, C_r]; rw [hr_o]
        have hk1 : pktRound2D (ε ^ a) (V_O o) = z.2.1 := congrArg Prod.fst hk_o
        have hk2 : pktRound2D (ε ^ a) (X_O o + (1 / 2 - C_r) • V_O o) = z.2.2 := by
          rw [← hCo_Cr]; exact congrArg Prod.snd hk_o
        letI := Classical.propDecidable
        exact Finset.mem_filter.mpr ⟨Finset.mem_univ o, hr_o, hk1, hk2, hpo.2.2.2.2.2.2.2.1⟩
      have hSZ_ne : S_Z.Nonempty := ⟨o₀, hFz_sub ho₀_Fz⟩
      have hfib := h_fiber m_idx a ha₀ ha_hi z.1 hz1_lt z.2.1 z.2.2
      obtain ⟨hTZ_ne, hSZ_sum⟩ := hfib hSZ_ne
      have hcard_pos : 0 < ((T_cell z.2).card : ℝ) :=
        Nat.cast_pos.mpr (Finset.card_pos.mpr hTZ_ne)
      have hFz_sum : ∑ o ∈ F_z z, m_bin m_idx o ≤ M_unit * ((T_cell z.2).card : ℝ) :=
        le_trans
          (Finset.sum_le_sum_of_subset_of_nonneg hFz_sub (fun o _ _ => (h_winner o).1 m_idx))
          hSZ_sum
      exact ⟨hz1_lt, hpZ_pos, hTZ_ne, hcard_pos, hFz_sum⟩
    
    have h_step3_2 :
        (∑ o : Fin N_O, -(p_cO o * Real.log (p_cO o))) +
        (1 / 2) * (∑ o : Fin N_O, ∑ d : Fin N_D, -(p_c o d * Real.log (p_c o d / p_cD d))) +
        (3 / 2) * (∑ o ∈ O_act, p_cO o * Real.log (m_bin m_idx o)) ≤
        (∑ z ∈ Z_act, -(p_Z z * Real.log (p_Z z))) +
        (1 / 2) * (∑ z ∈ Z_act, ∑ d : Fin N_D, -(p_ZD z d * Real.log (p_ZD z d / p_cD d))) +
        (3 / 2) * (∑ z ∈ Z_act, p_Z z * Real.log ((T_cell z.2).card : ℝ)) +
        (3 / 2) * Real.log M_unit := by
      have h_HO_sub : ∑ o : Fin N_O, -(p_cO o * Real.log (p_cO o)) =
          ∑ o ∈ O_act, -(p_cO o * Real.log (p_cO o)) := by
        refine (Finset.sum_subset (Finset.subset_univ O_act) (fun o _ ho => ?_)).symm
        simp [(hO_act_zero o ho).1]
      have h_HOD_sub : ∑ o : Fin N_O, ∑ d : Fin N_D, -(p_c o d * Real.log (p_c o d / p_cD d)) =
          ∑ o ∈ O_act, ∑ d : Fin N_D, -(p_c o d * Real.log (p_c o d / p_cD d)) := by
        refine (Finset.sum_subset (Finset.subset_univ O_act) (fun o _ ho => ?_)).symm
        refine Finset.sum_eq_zero (fun d _ => ?_)
        simp [(hO_act_zero o ho).2 d]
      have h_uncond_z : ∀ z ∈ Z_act,
          ∑ o ∈ F_z z, (-(p_cO o * Real.log (p_cO o)) + p_cO o * Real.log (m_bin m_idx o)) ≤
            -(p_Z z * Real.log (p_Z z)) +
              p_Z z * Real.log ((T_cell z.2).card : ℝ) + p_Z z * Real.log M_unit := by
        intro z hz
        obtain ⟨_, hpZ_pos, _, hTcard_pos, hFz_sum⟩ := hZ_act_props z hz
        let μ_z := M_unit * ((T_cell z.2).card : ℝ)
        have hμ_pos : 0 < μ_z := mul_pos hM_unit_pos hTcard_pos
        have h_gib := h_gibbs (F_z z) p_cO (m_bin m_idx) (p_Z z) μ_z
          (fun o _ => hp_cO_nn o) rfl hμ_pos
          (fun o _ => (h_winner o).1 m_idx)
          (fun o ho _ => by
            obtain ⟨d, hd_pos⟩ := hO_act_wit o (Finset.mem_filter.mp ho).1
            exact (h_high_props o d hd_pos).2.2.2.2.2.2.2.2)
          hFz_sum
        have h_split : ∑ o ∈ F_z z,
              (-(p_cO o * Real.log (p_cO o)) + p_cO o * Real.log (m_bin m_idx o)) =
            -(p_Z z * Real.log (p_Z z)) +
              ∑ o ∈ F_z z,
                (-(p_cO o * Real.log (p_cO o / p_Z z)) + p_cO o * Real.log (m_bin m_idx o)) := by
          have h_each : ∀ o ∈ F_z z,
              -(p_cO o * Real.log (p_cO o)) + p_cO o * Real.log (m_bin m_idx o) =
                -(p_cO o * Real.log (p_Z z)) +
                  (-(p_cO o * Real.log (p_cO o / p_Z z)) + p_cO o * Real.log (m_bin m_idx o)) := by
            intro o ho
            have hpo_pos : 0 < p_cO o := (Finset.mem_filter.mp (Finset.mem_filter.mp ho).1).2
            rw [Real.log_div hpo_pos.ne' hpZ_pos.ne']
            ring
          rw [Finset.sum_congr rfl h_each, Finset.sum_add_distrib]
          congr 1
          dsimp [p_Z]
          rw [Finset.sum_mul, ← Finset.sum_neg_distrib]
        have hlog_μ : Real.log μ_z = Real.log M_unit + Real.log ((T_cell z.2).card : ℝ) :=
          Real.log_mul hM_unit_pos.ne' hTcard_pos.ne'
        rw [h_split]
        rw [hlog_μ] at h_gib
        linarith only [h_gib]
      have h_cond_zd : ∀ z ∈ Z_act, ∀ d : Fin N_D,
          ∑ o ∈ F_z z, (-(p_c o d * Real.log (p_c o d / p_cD d)) + p_c o d * Real.log (m_bin m_idx o)) ≤
            -(p_ZD z d * Real.log (p_ZD z d / p_cD d)) +
              p_ZD z d * Real.log ((T_cell z.2).card : ℝ) + p_ZD z d * Real.log M_unit := by
        intro z hz d
        obtain ⟨_, _, _, hTcard_pos, hFz_sum⟩ := hZ_act_props z hz
        let μ_z := M_unit * ((T_cell z.2).card : ℝ)
        have hμ_pos : 0 < μ_z := mul_pos hM_unit_pos hTcard_pos
        have h_gib := h_gibbs (F_z z) (fun o => p_c o d) (m_bin m_idx) (p_ZD z d) μ_z
          (fun o _ => hp_c_nn o d) rfl hμ_pos
          (fun o _ => (h_winner o).1 m_idx)
          (fun o _ hpos => (h_high_props o d hpos).2.2.2.2.2.2.2.2)
          hFz_sum
        have h_split : ∑ o ∈ F_z z,
              (-(p_c o d * Real.log (p_c o d / p_cD d)) + p_c o d * Real.log (m_bin m_idx o)) =
            -(p_ZD z d * Real.log (p_ZD z d / p_cD d)) +
              ∑ o ∈ F_z z,
                (-(p_c o d * Real.log (p_c o d / p_ZD z d)) + p_c o d * Real.log (m_bin m_idx o)) := by
          have h_each : ∀ o ∈ F_z z,
              -(p_c o d * Real.log (p_c o d / p_cD d)) + p_c o d * Real.log (m_bin m_idx o) =
                -(p_c o d * Real.log (p_ZD z d / p_cD d)) +
                  (-(p_c o d * Real.log (p_c o d / p_ZD z d)) + p_c o d * Real.log (m_bin m_idx o)) := by
            intro o ho
            by_cases hpod0 : p_c o d = 0
            · simp [hpod0]
            · have hpod_pos : 0 < p_c o d := lt_of_le_of_ne (hp_c_nn o d) (Ne.symm hpod0)
              have hpZD_pos : 0 < p_ZD z d :=
                lt_of_lt_of_le hpod_pos (Finset.single_le_sum (fun o' _ => hp_c_nn o' d) ho)
              have hpcD_pos : 0 < p_cD d :=
                lt_of_lt_of_le hpod_pos
                  (Finset.single_le_sum (fun o' _ => hp_c_nn o' d) (Finset.mem_univ o))
              have h_rat : p_c o d / p_cD d = (p_ZD z d / p_cD d) * (p_c o d / p_ZD z d) := by
                field_simp [hpZD_pos.ne', hpcD_pos.ne']
              rw [h_rat, Real.log_mul (div_pos hpZD_pos hpcD_pos).ne' (div_pos hpod_pos hpZD_pos).ne']
              ring
          rw [Finset.sum_congr rfl h_each, Finset.sum_add_distrib]
          congr 1
          dsimp [p_ZD]
          rw [Finset.sum_mul, ← Finset.sum_neg_distrib]
        have hlog_μ : Real.log μ_z = Real.log M_unit + Real.log ((T_cell z.2).card : ℝ) :=
          Real.log_mul hM_unit_pos.ne' hTcard_pos.ne'
        rw [h_split]
        rw [hlog_μ] at h_gib
        linarith only [h_gib]
      have h_sum_u : ∑ o ∈ O_act, (-(p_cO o * Real.log (p_cO o)) + p_cO o * Real.log (m_bin m_idx o)) ≤
          (∑ z ∈ Z_act, -(p_Z z * Real.log (p_Z z))) +
            (∑ z ∈ Z_act, p_Z z * Real.log ((T_cell z.2).card : ℝ)) +
            Real.log M_unit := by
        rw [← Finset.sum_fiberwise_of_maps_to (fun o ho => Finset.mem_image_of_mem Z_of ho)]
        calc ∑ z ∈ Z_act, ∑ o ∈ F_z z,
              (-(p_cO o * Real.log (p_cO o)) + p_cO o * Real.log (m_bin m_idx o))
            ≤ ∑ z ∈ Z_act, (-(p_Z z * Real.log (p_Z z)) +
                p_Z z * Real.log ((T_cell z.2).card : ℝ) + p_Z z * Real.log M_unit) :=
              Finset.sum_le_sum h_uncond_z
          _ = (∑ z ∈ Z_act, -(p_Z z * Real.log (p_Z z))) +
                (∑ z ∈ Z_act, p_Z z * Real.log ((T_cell z.2).card : ℝ)) +
                Real.log M_unit := by
              rw [Finset.sum_add_distrib, Finset.sum_add_distrib, ← Finset.sum_mul, hp_Z_sum_z, one_mul]
      have h_sum_c : (∑ o ∈ O_act, ∑ d : Fin N_D, -(p_c o d * Real.log (p_c o d / p_cD d))) +
            ∑ o ∈ O_act, p_cO o * Real.log (m_bin m_idx o) ≤
          (∑ z ∈ Z_act, ∑ d : Fin N_D, -(p_ZD z d * Real.log (p_ZD z d / p_cD d))) +
            (∑ z ∈ Z_act, p_Z z * Real.log ((T_cell z.2).card : ℝ)) +
            Real.log M_unit := by
        have h_lhs_eq : (∑ o ∈ O_act, ∑ d : Fin N_D, -(p_c o d * Real.log (p_c o d / p_cD d))) +
              ∑ o ∈ O_act, p_cO o * Real.log (m_bin m_idx o) =
            ∑ z ∈ Z_act, ∑ d : Fin N_D, ∑ o ∈ F_z z,
              (-(p_c o d * Real.log (p_c o d / p_cD d)) + p_c o d * Real.log (m_bin m_idx o)) := by
          rw [← Finset.sum_add_distrib]
          have h1 : ∀ o ∈ O_act,
              (∑ d : Fin N_D, -(p_c o d * Real.log (p_c o d / p_cD d))) +
                p_cO o * Real.log (m_bin m_idx o) =
              ∑ d : Fin N_D,
                (-(p_c o d * Real.log (p_c o d / p_cD d)) + p_c o d * Real.log (m_bin m_idx o)) := by
            intro o _
            rw [Finset.sum_add_distrib, ← Finset.sum_mul]
          rw [Finset.sum_congr rfl h1,
            ← Finset.sum_fiberwise_of_maps_to (fun o ho => Finset.mem_image_of_mem Z_of ho)]
          exact Finset.sum_congr rfl (fun _ _ => Finset.sum_comm)
        rw [h_lhs_eq]
        calc ∑ z ∈ Z_act, ∑ d : Fin N_D, ∑ o ∈ F_z z,
              (-(p_c o d * Real.log (p_c o d / p_cD d)) + p_c o d * Real.log (m_bin m_idx o))
            ≤ ∑ z ∈ Z_act, ∑ d : Fin N_D,
                (-(p_ZD z d * Real.log (p_ZD z d / p_cD d)) +
                  p_ZD z d * Real.log ((T_cell z.2).card : ℝ) + p_ZD z d * Real.log M_unit) :=
              Finset.sum_le_sum (fun z hz => Finset.sum_le_sum (fun d _ => h_cond_zd z hz d))
          _ = (∑ z ∈ Z_act, ∑ d : Fin N_D, -(p_ZD z d * Real.log (p_ZD z d / p_cD d))) +
                (∑ z ∈ Z_act, p_Z z * Real.log ((T_cell z.2).card : ℝ)) +
                Real.log M_unit := by
              simp_rw [Finset.sum_add_distrib, ← Finset.sum_mul, ← hp_Z_eq_sum_d]
              rw [hp_Z_sum_z, one_mul]
      rw [h_HO_sub, h_HOD_sub]
      rw [Finset.sum_add_distrib] at h_sum_u
      linarith only [h_sum_u, h_sum_c]
    
    let W : (ℕ × ((ℤ × ℤ) × (ℤ × ℤ))) → ((ℤ × ℤ) × (ℤ × ℤ)) → Fin N_D → ℝ :=
      fun z q d => if q ∈ T_cell z.2 then p_ZD z d / ((T_cell z.2).card : ℝ) else 0
    let q_law : ((ℤ × ℤ) × (ℤ × ℤ)) → Fin N_D → ℝ :=
      fun q d => if q ∈ F_set then ∑ z ∈ Z_act, W z q d else 0
    have hT_sub_F : ∀ kv_ky, T_cell kv_ky ⊆ F_set := by
      intro kv_ky
      letI := Classical.propDecidable
      exact Finset.filter_subset _ _
    have hW_nn : ∀ z q d, 0 ≤ W z q d := by
      intro z q d; dsimp [W]; split_ifs
      · exact div_nonneg (hp_ZD_nn z d) (Nat.cast_nonneg _)
      · exact le_rfl
    have hq_law_nn : ∀ q d, 0 ≤ q_law q d := by
      intro q d; dsimp [q_law]; split_ifs
      · exact Finset.sum_nonneg (fun z _ => hW_nn z q d)
      · exact le_rfl
    have hW_sum_q : ∀ z ∈ Z_act, ∀ d : Fin N_D, ∑ q ∈ F_set, W z q d = p_ZD z d := by
      intro z hz d
      have hcard_pos := (hZ_act_props z hz).2.2.2.1
      dsimp [W]
      rw [← Finset.sum_subset (hT_sub_F z.2) (fun q _ hnot => if_neg hnot)]
      have heq : ∑ q ∈ T_cell z.2,
          (if q ∈ T_cell z.2 then p_ZD z d / ((T_cell z.2).card : ℝ) else 0) =
          ∑ _q ∈ T_cell z.2, (p_ZD z d / ((T_cell z.2).card : ℝ)) :=
        Finset.sum_congr rfl (fun q hq => if_pos hq)
      rw [heq, Finset.sum_const, nsmul_eq_mul, mul_div_cancel₀ _ hcard_pos.ne']
    have hq_law_D : ∀ d : Fin N_D, ∑ q ∈ F_set, q_law q d = p_cD d := by
      intro d
      have heq : ∑ q ∈ F_set, q_law q d = ∑ q ∈ F_set, ∑ z ∈ Z_act, W z q d :=
        Finset.sum_congr rfl (fun q hq => if_pos hq)
