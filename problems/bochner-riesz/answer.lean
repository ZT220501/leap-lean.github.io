  have hH_k1_T_ub : finCondEntropy ε π_strip T_idx k₁_fn ≤ s + η₀ := by
    let N_k1 : ℝ := ε ^ (-(s + η₀))
    have hN_k1_ge1 : 1 ≤ N_k1 := by
