    simpa using h1
  
  let O₀ : Finset ((ℤ × ℤ) × (ℤ × ℤ)) := rootSiteFinset lam_sys R_dom
  let S_comp : Set ℝ :=
    { s : ℝ | ∃ (N'_D : ℕ)
        (b a : Fin N'_D → ℝ)
        (e_dir V_c X_c : Fin N'_D → EuclideanSpace ℝ (Fin 2))
        (p' : ((ℤ × ℤ) × (ℤ × ℤ)) → Fin N'_D → ℝ),
        (∀ d : Fin N'_D, 0 ≤ b d ∧ b d ≤ a d ∧ a d ≤ min L (H_P / 2) ∧ ‖e_dir d‖ = 1) ∧
        (∀ o d, 0 ≤ p' o d) ∧
        (∀ o d, o ∉ O₀ → p' o d = 0) ∧
        (∑ o ∈ O₀, ∑ d : Fin N'_D, p' o d = 1) ∧
        (∀ o ∈ O₀, ∀ d : Fin N'_D, 0 < p' o d →
          0 < canonicalRootMass lam_sys Φ₀ f o ∧
          |inner ℝ (gridPt2D ρ₀ o.1 - V_c d) (e_dir d)| ≤ 10 * ε ^ (b d) ∧
          |inner ℝ (gridPt2D ρ₀ o.1 - V_c d) (perp2D (e_dir d))| ≤ 10 * ε ^ (a d) ∧
          |inner ℝ (gridPt2D ρ₀ o.2 - X_c d) (e_dir d)| ≤ 10 * ε ^ (b d) ∧
          |inner ℝ (gridPt2D ρ₀ o.2 - X_c d) (perp2D (e_dir d))| ≤ 10 * ε ^ (a d)) ∧
        (let p_O := fun o => ∑ d : Fin N'_D, p' o d
         let p_D := fun d => ∑ o ∈ O₀, p' o d
         let H_O := (∑ o ∈ O₀, -(p_O o * Real.log (p_O o))) / ell
         let H_O_D := (∑ o ∈ O₀, ∑ d : Fin N'_D,
           -(p' o d * Real.log (p' o d / p_D d))) / ell
         let E_mass := (∑ o ∈ O₀,
           p_O o * Real.log (canonicalRootMass lam_sys Φ₀ f o)) / ell
         let E_w := ∑ d : Fin N'_D,
           p_D d * ((1 + γ) * b d + (1 - γ) * a d)
         s = H_O + (1 / 2 : ℝ) * H_O_D + (3 / 2 : ℝ) * E_mass + (1 / 2 : ℝ) * E_w) }
  have h_root_bdd : BddAbove ({ (3 / 2 : ℝ) * (Real.log E_f / ell) } ∪ S_comp) := by
    refine BddAbove.union bddAbove_singleton ?_
    let M_log : ℝ := ∑ o ∈ O₀, |Real.log (canonicalRootMass lam_sys Φ₀ f o)|
    refine ⟨((O₀.card : ℝ) + (1 / 2) * (O₀.card : ℝ) + (3 / 2) * M_log) / ell + K_hor, ?_⟩
    rintro s ⟨N'_D, b, a, e_dir, V_c, X_c, p', h_ap, hp'_nn, _, hp'_sum, _, hs_eq⟩
    have h_ent_le_P : ∀ u P : ℝ, 0 ≤ u → 0 ≤ P → -(u * Real.log (u / P)) ≤ P := by
      intro u P hu hP
      by_cases hu0 : u = 0
      · simp [hu0, hP]
      · by_cases hP0 : P = 0
        · simp [hP0]
        · have hu_pos : 0 < u := lt_of_le_of_ne hu (Ne.symm hu0)
          have hP_pos : 0 < P := lt_of_le_of_ne hP (Ne.symm hP0)
          have hlog : -(u * Real.log (u / P)) = u * Real.log (P / u) := by
            rw [Real.log_div hu_pos.ne' hP_pos.ne', Real.log_div hP_pos.ne' hu_pos.ne']
            ring
          rw [hlog]
          have h1 := mul_le_mul_of_nonneg_left
            (Real.log_le_sub_one_of_pos (div_pos hP_pos hu_pos)) hu_pos.le
          have h2 : u * (P / u - 1) = P - u := by field_simp [hu_pos.ne']
          linarith
    let p'_O := fun o => ∑ d : Fin N'_D, p' o d
    let p'_D := fun d => ∑ o ∈ O₀, p' o d
    have hp'_O_nn : ∀ o, 0 ≤ p'_O o := fun o => Finset.sum_nonneg (fun d _ => hp'_nn o d)
    have hp'_D_nn : ∀ d, 0 ≤ p'_D d := fun d => Finset.sum_nonneg (fun o _ => hp'_nn o d)
    have hp'_D_sum : ∑ d : Fin N'_D, p'_D d = 1 := by
      dsimp [p'_D]
      rw [Finset.sum_comm]
      exact hp'_sum
    have h_HO : ∑ o ∈ O₀, -(p'_O o * Real.log (p'_O o)) ≤ (O₀.card : ℝ) := by
      calc ∑ o ∈ O₀, -(p'_O o * Real.log (p'_O o))
          = ∑ o ∈ O₀, -(p'_O o * Real.log (p'_O o / 1)) := by simp
        _ ≤ ∑ _o ∈ O₀, (1 : ℝ) :=
            Finset.sum_le_sum (fun o _ => h_ent_le_P (p'_O o) 1 (hp'_O_nn o) zero_le_one)
        _ = (O₀.card : ℝ) := by simp
    have h_HOD : ∑ o ∈ O₀, ∑ d : Fin N'_D, -(p' o d * Real.log (p' o d / p'_D d)) ≤
        (O₀.card : ℝ) := by
      calc ∑ o ∈ O₀, ∑ d : Fin N'_D, -(p' o d * Real.log (p' o d / p'_D d))
          ≤ ∑ o ∈ O₀, ∑ d : Fin N'_D, p'_D d :=
            Finset.sum_le_sum (fun o _ =>
              Finset.sum_le_sum (fun d _ => h_ent_le_P (p' o d) (p'_D d) (hp'_nn o d) (hp'_D_nn d)))
        _ = ∑ _o ∈ O₀, (1 : ℝ) := by
            refine Finset.sum_congr rfl (fun _ _ => hp'_D_sum)
        _ = (O₀.card : ℝ) := by simp
    have h_Emass : ∑ o ∈ O₀, p'_O o * Real.log (canonicalRootMass lam_sys Φ₀ f o) ≤ M_log := by
      refine Finset.sum_le_sum (fun o ho => ?_)
      have hp'_O_le1 : p'_O o ≤ 1 := by
        rw [← hp'_sum]
        exact Finset.single_le_sum (fun o' _ => hp'_O_nn o') ho
      calc p'_O o * Real.log (canonicalRootMass lam_sys Φ₀ f o)
          ≤ p'_O o * |Real.log (canonicalRootMass lam_sys Φ₀ f o)| :=
            mul_le_mul_of_nonneg_left (le_abs_self _) (hp'_O_nn o)
        _ ≤ 1 * |Real.log (canonicalRootMass lam_sys Φ₀ f o)| :=
            mul_le_mul_of_nonneg_right hp'_O_le1 (abs_nonneg _)
        _ = |Real.log (canonicalRootMass lam_sys Φ₀ f o)| := one_mul _
    have h_Ew : ∑ d : Fin N'_D, p'_D d * ((1 + γ) * b d + (1 - γ) * a d) ≤ 2 * K_hor := by
      calc ∑ d : Fin N'_D, p'_D d * ((1 + γ) * b d + (1 - γ) * a d)
          ≤ ∑ d : Fin N'_D, p'_D d * (2 * K_hor) := by
            refine Finset.sum_le_sum (fun d _ => mul_le_mul_of_nonneg_left ?_ (hp'_D_nn d))
            have hd := h_ap d
            have ha_le : a d ≤ K_hor := le_trans hd.2.2.1 (le_trans (min_le_left _ _) hL_hor)
            have hb_le : b d ≤ K_hor := le_trans hd.2.1 ha_le
            nlinarith only [hγ₀, hγ₁, hb_le, ha_le]
        _ = (∑ d : Fin N'_D, p'_D d) * (2 * K_hor) := (Finset.sum_mul _ _ _).symm
        _ = 2 * K_hor := by rw [hp'_D_sum, one_mul]
    rw [hs_eq]
    have h_num : (∑ o ∈ O₀, -(p'_O o * Real.log (p'_O o))) +
        (1 / 2) * (∑ o ∈ O₀, ∑ d : Fin N'_D, -(p' o d * Real.log (p' o d / p'_D d))) +
        (3 / 2) * (∑ o ∈ O₀, p'_O o * Real.log (canonicalRootMass lam_sys Φ₀ f o)) ≤
        (O₀.card : ℝ) + (1 / 2) * (O₀.card : ℝ) + (3 / 2) * M_log := by
      linarith only [h_HO, h_HOD, h_Emass]
    have h_div := div_le_div_of_nonneg_right h_num hell_pos.le
    have h_split_div : ((∑ o ∈ O₀, -(p'_O o * Real.log (p'_O o))) +
        (1 / 2) * (∑ o ∈ O₀, ∑ d : Fin N'_D, -(p' o d * Real.log (p' o d / p'_D d))) +
        (3 / 2) * (∑ o ∈ O₀, p'_O o * Real.log (canonicalRootMass lam_sys Φ₀ f o))) / ell =
        (∑ o ∈ O₀, -(p'_O o * Real.log (p'_O o))) / ell +
        (1 / 2) * ((∑ o ∈ O₀, ∑ d : Fin N'_D, -(p' o d * Real.log (p' o d / p'_D d))) / ell) +
        (3 / 2) * ((∑ o ∈ O₀, p'_O o * Real.log (canonicalRootMass lam_sys Φ₀ f o)) / ell) := by
      ring
    rw [h_split_div] at h_div
    linarith only [h_div, h_Ew]
  have h_root_norm : (3 / 2 : ℝ) * (Real.log E_f / ell) ≤
      generalPacketRootScore ε H_P L R_dom γ lam_sys Φ₀ f := by
    unfold generalPacketRootScore
    exact le_csSup h_root_bdd (Set.mem_union_left _ (Set.mem_singleton _))
  
  let m_obs : Fin N_O → ℝ := fun o =>
    generalPacketObsMass ε H_P t lam_sys m_time Φ₀ f (r_O o) (V_O o) (X_O o) (ψ_O o)
  let w_of : Fin N_D → ℕ := fun d => ⌊a_D d / ξ⌋₊
  have hw_of_bounds : ∀ d : Fin N_D,
      w_of d < M_a ∧ (w_of d : ℝ) * ξ ≤ a_D d ∧ a_D d < ((w_of d : ℝ) + 1) * ξ := by
    intro d
    have hd := hD_bound d
    have ha_nn : 0 ≤ a_D d := le_trans hd.1 hd.2.1
    have ha_K : a_D d ≤ K_hor := by
      have h1 : a_D d ≤ L - t := le_trans hd.2.2.1 (min_le_left _ _)
      linarith only [h1, ht_pos, hL_hor]
    have hdiv_nn : 0 ≤ a_D d / ξ := div_nonneg ha_nn hξ₀.le
    have hfl : (w_of d : ℝ) ≤ a_D d / ξ := Nat.floor_le hdiv_nn
    have hlt1 : a_D d / ξ < (w_of d : ℝ) + 1 := Nat.lt_floor_add_one _
    have hdiv_le : a_D d / ξ ≤ K_hor / ξ := div_le_div_of_nonneg_right ha_K hξ₀.le
    have hK_lt : K_hor / ξ < (M_a : ℝ) := by
      dsimp [M_a]
      push_cast
      exact Nat.lt_floor_add_one _
    have hw_real_lt : (w_of d : ℝ) < (M_a : ℝ) := lt_of_le_of_lt hfl (lt_of_le_of_lt hdiv_le hK_lt)
    exact ⟨Nat.cast_lt.mp hw_real_lt, (le_div_iff₀ hξ₀).mp hfl, (div_lt_iff₀ hξ₀).mp hlt1⟩
  let win_of : Fin N_O → Fin M_c := fun o =>
    @dite _ (ε ^ A₀ * E_f ≤ m_obs o) (Classical.propDecidable _)
      (fun h => Classical.choose ((h_winner o).2 h))
      (fun _ => ⟨0, hM_c_pos⟩)
  have hwin_of_spec : ∀ o : Fin N_O, ε ^ A₀ * E_f ≤ m_obs o →
