        unfold finProbAt2
        rw [Finset.sum_div]
        refine Finset.sum_congr rfl (fun ω' _ => ?_)
        dsimp only [π_E]
        by_cases hev' : ev ω' = true
        · rw [if_pos hev']
          by_cases hXY : X ω' = X ω ∧ Y ω' = Y ω
          · have hp : (fun ω'' => (X ω'', ev ω'')) ω' = (fun ω'' => (X ω'', ev ω'')) ω ∧ Y ω' = Y ω :=
