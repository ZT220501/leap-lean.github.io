theorem weak_flux_tangent_box_jump_ineq (c_top M : ℝ) (hM : 0 ≤ M)
    (a_top D : ℝ × ℝ → ℝ)
    (ha_meas : Measurable a_top) (hD_meas : Measurable D)
    (ha_bds : ∀ iu : ℝ × ℝ, 0 ≤ a_top iu ∧ a_top iu ≤ M)
    (hD_bds : ∀ iu : ℝ × ℝ, 0 ≤ D iu ∧ D iu ≤ M)
    (h_flux : ∀ (φ : ℝ × ℝ → ℝ) (K δ : ℝ),
      ContDiff ℝ 1 φ → 1 ≤ K → 0 < δ → δ < 1 / 2 →
      (∀ iu, 0 ≤ φ iu) →
      (∀ iu, (K ≤ |iu.1| ∨ iu.2 ≤ δ ∨ 1 - δ ≤ iu.2) → φ iu = 0) →
      0 ≤ ∫ u in δ..(1 - δ), ∫ i in (-K)..K,
        (-a_top (i, u) *
            (deriv (fun u' => φ (i, u')) u - c_top * deriv (fun i' => φ (i', u)) i) +
          D (i, u) * deriv (fun i' => φ (i', u)) i))
    (b₀ u₀ p z_minus z_plus D_minus D_plus : ℝ)
    (hu₀ : u₀ ∈ Set.Ioo (0 : ℝ) 1)
    (ha_tr : HasTangentBoxTrace a_top b₀ u₀ p z_minus z_plus)
    (hD_tr : HasTangentBoxTrace D b₀ u₀ p D_minus D_plus) :
    (c_top - p) * (z_plus - z_minus) ≤ D_minus - D_plus :=
by
  
  have h_ii_1d : ∀ {g : ℝ → ℝ} (B : ℝ),
      Measurable g → (∀ x : ℝ, |g x| ≤ B) → ∀ a b : ℝ,
        IntervalIntegrable g MeasureTheory.volume a b := by
    intro g B hg hb a b
