        rw [h_sum_partition_pred Finset.univ (S_L ×ˢ S_Z1) g_LZ
          (fun i => N_bin i = n_star ∧ bX i = kX_star) Q_LZ ν_P (fun i _ => hg_prod_mem i)]
        calc (∑ lk ∈ S_L ×ˢ S_Z1, if Q_LZ lk then
                (∑ i : Fin N_P,
                  if (N_bin i = n_star ∧ bX i = kX_star) ∧ g_LZ i = lk then ν_P i else 0) else 0)
            ≤ ∑ lk ∈ S_L ×ˢ S_Z1, if Q_LZ lk then
                ρ_tilde ^ (-η_sl) * p_X kX_star *
                  (∑ i : Fin N_P, if N_bin i = n_star ∧ L_bin i = lk.1 then ν_P i else 0) *
                  (∑ i : Fin N_P, if bZ₁ i = lk.2 then ν_P i else 0) else 0 := by
