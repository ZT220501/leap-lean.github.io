      have hj_le_real : (j : ℝ) ≤ v * (2 : ℝ) ^ l := Nat.floor_le (by positivity)
      have hj_lt_add : v * (2 : ℝ) ^ l < (j : ℝ) + 1 := Nat.lt_floor_add_one _
      have hj1_lt_real : ((j + 1 : ℕ) : ℝ) < (2 : ℝ) ^ l := by push_cast; linarith
      have hj1_lt_nat : j + 1 < 2 ^ l := by
