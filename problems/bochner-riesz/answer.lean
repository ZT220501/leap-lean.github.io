      by_cases h0 : π_J j = 0
      · simp [h0]
      · exact mul_nonneg (hπ_nn j) (hd_nn j (lt_of_le_of_ne (hπ_nn j) (Ne.symm h0))).1
    have h23_nn : 0 ≤ ∑ j : Fin N_J, π_J j * (d₂ j + d₃ j) := by
      refine Finset.sum_nonneg (fun j _ => ?_)
      by_cases h0 : π_J j = 0
      · simp [h0]
      · obtain ⟨_, h2, h3⟩ := hd_nn j (lt_of_le_of_ne (hπ_nn j) (Ne.symm h0))
        exact mul_nonneg (hπ_nn j) (add_nonneg h2 h3)
    have hsplit : (∑ j : Fin N_J, π_J j * (d₁ j + d₂ j + d₃ j)) =
        (∑ j : Fin N_J, π_J j * d₁ j) + ∑ j : Fin N_J, π_J j * (d₂ j + d₃ j) := by
      rw [← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl (fun j _ => by ring)
    rw [hsplit] at hsum
