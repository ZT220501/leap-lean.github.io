        _ = (16 * K₀) / (16 * d_r ^ 4) := by
            rw [← hr_diff]
            dsimp only [d_r]
            field_simp [hd_r_pos.ne']
        _ ≤ (16 * K₀) / (d_q ^ 2) :=
            div_le_div_of_nonneg_left (by positivity) (pow_pos (by linarith) 2) h_denom
        _ = 16 * K₀ * w_Z (q T₁) (q T₂) := by
            dsimp only [w_Z, d_q]
            ring
    have h_row : ∀ m₁ : ℤ, ∑ T₂ ∈ W, w_Z m₁ (q T₂) ≤ 3 * M_fib := by
      intro m₁
      let S_q : Finset ℤ := W.image q
      have h_fib_sum : ∑ T₂ ∈ W, w_Z m₁ (q T₂) =
          ∑ m ∈ S_q, ((W.filter (fun T => q T = m)).card : ℝ) * w_Z m₁ m := by
        rw [← Finset.sum_fiberwise_of_maps_to (fun T hT => Finset.mem_image_of_mem q hT)]
        refine Finset.sum_congr rfl (fun m _ => ?_)
        have h_eq : ∑ T ∈ W.filter (fun T => q T = m), w_Z m₁ (q T) =
            ∑ _T ∈ W.filter (fun T => q T = m), w_Z m₁ m := by
          refine Finset.sum_congr rfl (fun T hT => ?_)
          rw [(Finset.mem_filter.mp hT).2]
        rw [h_eq, Finset.sum_const, nsmul_eq_mul]
      have h_card_le : ∀ m : ℤ, ((W.filter (fun T => q T = m)).card : ℝ) ≤ M_fib := by
        intro m
