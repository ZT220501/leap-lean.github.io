        rw [smul_smul, h_scale_inv]
        ring
      change (ρ_tilde⁻¹ : ℂ) * ∫ v : E,
          h v * ψ_tilde (ρ_tilde⁻¹ • (v - V_o)) *
            Complex.exp (Complex.I * ((lam_sys * Φ₀ (C_box, X_o, v) : ℝ) : ℂ)) = _
      rw [h_ig, MeasureTheory.integral_const_mul, ← mul_assoc]
      congr 1
      rw [← Complex.ofReal_inv, ← Complex.ofReal_inv, ← Complex.ofReal_mul,
        mul_comm ρ_tilde⁻¹ κ_sc, h_scale_inv]
    · intro S c
      have h_atom_cont : ∀ j n : ℤ × ℤ, Continuous (pktLinearAtom lam_sys Φ₀ j n) := by
        intro j n
        let ρ₀_at : ℝ := (Real.sqrt lam_sys)⁻¹
        have h_fn : pktLinearAtom lam_sys Φ₀ j n = fun v : E =>
            ((4 : ℂ)⁻¹ * (ρ₀_at⁻¹ : ℂ)) *
              (pktPou2D (ρ₀_at⁻¹ • (v - gridPt2D ρ₀_at j)) : ℂ) *
              Complex.exp (Complex.I *
                ((-lam_sys * Φ₀ (1 / 2, 0, v) +
