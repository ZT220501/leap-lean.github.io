          (∀ (k : ℕ) (s : ℝ),
            |iteratedDeriv k (f_vec u) s| ≤
              ‖u‖ * (A ^ (k + 1) * ((k.factorial : ℝ) ^ 3)) * ρ₀ ^ k) := by
        intro u
        let ℓ_u : (EuclideanSpace ℝ (Fin 2) →L[ℝ] EuclideanSpace ℝ (Fin 2)) →L[ℝ] ℝ :=
          dual_w.comp (ContinuousLinearMap.apply ℝ (EuclideanSpace ℝ (Fin 2)) u)
        have hℓ_norm : ‖ℓ_u‖ ≤ ‖u‖ := by
          refine ContinuousLinearMap.opNorm_le_bound _ (norm_nonneg u) (fun T => ?_)
          have h_app : ℓ_u T = inner ℝ w (T u) := by
            simp [ℓ_u, dual_w, InnerProductSpace.toDual_apply_apply]
          rw [h_app, Real.norm_eq_abs]
          calc |inner ℝ w (T u)| ≤ ‖w‖ * ‖T u‖ := abs_real_inner_le_norm w (T u)
            _ ≤ 1 * (‖T‖ * ‖u‖) := by
                rw [hw]
                exact mul_le_mul_of_nonneg_left (T.le_opNorm u) zero_le_one
            _ = ‖u‖ * ‖T‖ := by ring
        have hf_eq : f_vec u = ⇑ℓ_u ∘ ((fun z => M (z + q_τ)) ∘ ⇑Λ_τ) := by
          ext s
          dsimp only [f_vec, ℓ_u, dual_w, Function.comp_apply]
          simp only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.apply_apply,
            InnerProductSpace.toDual_apply_apply]
          rw [real_inner_comm]
        refine ⟨fun k => ?_, fun k s => ?_⟩
        · rw [hf_eq]
          exact ℓ_u.contDiff.comp
            (((hM_cd k).comp (contDiff_id.add contDiff_const)).comp Λ_τ.contDiff)
        · rw [← Real.norm_eq_abs, ← norm_iteratedFDeriv_eq_norm_iteratedDeriv, hf_eq]
          have h_shift_cd : ContDiff ℝ k (fun z => M (z + q_τ)) :=
            (hM_cd k).comp (contDiff_id.add contDiff_const)
          have h_inner_cd : ContDiff ℝ k ((fun z => M (z + q_τ)) ∘ ⇑Λ_τ) :=
            h_shift_cd.comp Λ_τ.contDiff
          rw [ℓ_u.iteratedFDeriv_comp_left h_inner_cd.contDiffAt le_rfl]
          have h_le1 := ℓ_u.norm_compContinuousMultilinearMap_le
            (iteratedFDeriv ℝ k ((fun z => M (z + q_τ)) ∘ ⇑Λ_τ) s)
          have h_le2 := ContinuousMultilinearMap.norm_compContinuousLinearMap_le
            (iteratedFDeriv ℝ k M (Λ_τ s + q_τ)) (fun _ : Fin k => Λ_τ)
          have h_prod_le : (∏ _ : Fin k, ‖Λ_τ‖) ≤ ρ₀ ^ k := by
            rw [Finset.prod_const, Finset.card_fin]
            exact pow_le_pow_left₀ (norm_nonneg Λ_τ) hΛ_τ_norm k
          have h_gev := hζ_gevrey k (Λ_τ s + q_τ)
          have h_mid : ‖iteratedFDeriv ℝ k ((fun z => M (z + q_τ)) ∘ ⇑Λ_τ) s‖ ≤
              (A ^ (k + 1) * ((k.factorial : ℝ) ^ 3)) * ρ₀ ^ k := by
            rw [Λ_τ.iteratedFDeriv_comp_right h_shift_cd s le_rfl, iteratedFDeriv_comp_add_right]
            calc ‖(iteratedFDeriv ℝ k M (Λ_τ s + q_τ)).compContinuousLinearMap (fun _ => Λ_τ)‖
                ≤ ‖iteratedFDeriv ℝ k M (Λ_τ s + q_τ)‖ * ∏ _ : Fin k, ‖Λ_τ‖ := h_le2
              _ ≤ (A ^ (k + 1) * ((k.factorial : ℝ) ^ 3)) * ρ₀ ^ k :=
                  mul_le_mul h_gev h_prod_le
                    (Finset.prod_nonneg (fun _ _ => norm_nonneg Λ_τ)) (by positivity)
          calc ‖ℓ_u.compContinuousMultilinearMap
                (iteratedFDeriv ℝ k ((fun z => M (z + q_τ)) ∘ ⇑Λ_τ) s)‖
              ≤ ‖ℓ_u‖ * ‖iteratedFDeriv ℝ k ((fun z => M (z + q_τ)) ∘ ⇑Λ_τ) s‖ := h_le1
            _ ≤ ‖u‖ * ((A ^ (k + 1) * ((k.factorial : ℝ) ^ 3)) * ρ₀ ^ k) :=
                mul_le_mul hℓ_norm h_mid (norm_nonneg _) (norm_nonneg u)
            _ = ‖u‖ * (A ^ (k + 1) * ((k.factorial : ℝ) ^ 3)) * ρ₀ ^ k := by ring
      have hH_split : (fun s : ℝ => H (s, τ)) =
          (fun s => (lam_sys * ρ₀) * f_vec P₀ s) - (fun s => c * (s * f_vec e s)) := by
        ext s
        have h_arg : (v_fn s, τ • P_fn s) = Λ_τ s + q_τ := by
          refine Prod.ext ?_ ?_
          · ext i
