            mul_le_mul_of_nonneg_right hcard_le
              (mul_nonneg (Real.rpow_nonneg hε_pos.le _)
                (mul_nonneg (mul_nonneg hCfar_nn (Real.rpow_nonneg (by positivity) _))
                  (Real.rpow_nonneg hε_pos.le _)))
        _ = (C_at_cnt * C_far * (4 * C_cov) ^ (-(M_ord : ℝ))) *
              (ε ^ (-(3 * cls.K_hor)) *
                (ε ^ (-(10 * cls.K_hor + 10 + ξ)) * ε ^ ((M_ord : ℝ) * θ))) := by ring
        _ ≤ (C_at_cnt * C_far * (4 * C_cov) ^ (-(M_ord : ℝ))) * (ε ^ (2 * θ) * ε ^ E_fl) :=
            mul_le_mul_of_nonneg_left hrpow_le
              (mul_nonneg (mul_nonneg hCat_pos.le hCfar_nn)
                (Real.rpow_nonneg (by positivity) _))
        _ = (C_at_cnt * C_far * (4 * C_cov) ^ (-(M_ord : ℝ))) * ε ^ (2 * θ) * ε ^ E_fl := by
            ring

    
    have h_tot_err : ‖P_pair h_sub (ψ_O o) - P_pair h_cand_o (ψ_loc o)‖ ≤
        (1 / 2 : ℝ) * ‖P_pair h_sub (ψ_O o)‖ := by
      have htri : ‖P_pair h_sub (ψ_O o) - P_pair h_cand_o (ψ_loc o)‖ ≤
          ‖P_pair h_sub (ψ_O o) - P_pair h_sub (ψ_loc o)‖ +
            ‖P_pair h_sub (ψ_loc o) - P_pair h_cand_o (ψ_loc o)‖ := by
        have heq : P_pair h_sub (ψ_O o) - P_pair h_cand_o (ψ_loc o) =
            (P_pair h_sub (ψ_O o) - P_pair h_sub (ψ_loc o)) +
              (P_pair h_sub (ψ_loc o) - P_pair h_cand_o (ψ_loc o)) := by abel
        rw [heq]; exact norm_add_le _ _
      have hsum_le : ‖P_pair h_sub (ψ_O o) - P_pair h_sub (ψ_loc o)‖ +
          ‖P_pair h_sub (ψ_loc o) - P_pair h_cand_o (ψ_loc o)‖ ≤
          C_err_coef * ε ^ (2 * θ) * ε ^ E_fl := by
        have h1pos : 0 ≤ ε ^ (2 * θ) * ε ^ E_fl :=
          mul_nonneg (Real.rpow_nonneg hε_pos.le _) (Real.rpow_nonneg hε_pos.le _)
        have h_add_coef :
            (2 * C_loc * Real.sqrt (C_Bes_at * C_at_cnt)) * ε ^ (2 * θ) * ε ^ E_fl +
              (C_at_cnt * C_far * (4 * C_cov) ^ (-(M_ord : ℝ))) * ε ^ (2 * θ) * ε ^ E_fl +
              (ε ^ (2 * θ) * ε ^ E_fl) =
            C_err_coef * ε ^ (2 * θ) * ε ^ E_fl := by
          dsimp only [C_err_coef]; ring
        linarith only [h_err1, h_err2, h1pos, h_add_coef]
      have h_quarter : C_err_coef * ε ^ (2 * θ) * ε ^ E_fl ≤ (1 / 4 : ℝ) * ε ^ E_fl :=
        mul_le_mul_of_nonneg_right h_sm_err (Real.rpow_nonneg hε_pos.le E_fl)
      linarith only [htri, hsum_le, h_quarter, h_amp_floor]

    have h_half_le : (1 / 2 : ℝ) * ‖P_pair h_sub (ψ_O o)‖ ≤ ‖P_pair h_cand_o (ψ_loc o)‖ := by
      have htri : ‖P_pair h_sub (ψ_O o)‖ ≤
          ‖P_pair h_sub (ψ_O o) - P_pair h_cand_o (ψ_loc o)‖ + ‖P_pair h_cand_o (ψ_loc o)‖ := by
        have heq : P_pair h_sub (ψ_O o) =
            (P_pair h_sub (ψ_O o) - P_pair h_cand_o (ψ_loc o)) +
              P_pair h_cand_o (ψ_loc o) := by abel
        conv_lhs => rw [heq]
        exact norm_add_le _ _
      linarith only [htri, h_tot_err]

    have h_cand_pos : 0 < ‖P_pair h_cand_o (ψ_loc o)‖ := by
      have hpos : 0 < (1 / 2 : ℝ) * ε ^ E_fl :=
        mul_pos (by norm_num) (Real.rpow_pos_of_pos hε_pos E_fl)
      linarith only [hpos, h_amp_floor, h_half_le]

    have hm_site_pos : 0 < m_site o := sq_pos_of_pos h_cand_pos
    have hm_site_ratio :
        generalPacketObsMass ε H_P t lam_sys m_t Φ₀ h_sub (r_O o) (V_O o) (X_O o) (ψ_O o) ≤
          4 * m_site o := by
      change ‖P_pair h_sub (ψ_O o)‖ ^ 2 ≤ 4 * ‖P_pair h_cand_o (ψ_loc o)‖ ^ 2
      have h2 : ‖P_pair h_sub (ψ_O o)‖ ≤ 2 * ‖P_pair h_cand_o (ψ_loc o)‖ := by
        linarith only [h_half_le]
      calc ‖P_pair h_sub (ψ_O o)‖ ^ 2
          ≤ (2 * ‖P_pair h_cand_o (ψ_loc o)‖) ^ 2 := pow_le_pow_left₀ (norm_nonneg _) h2 2
        _ = 4 * ‖P_pair h_cand_o (ψ_loc o)‖ ^ 2 := by ring
    have hT_nonempty : (T_cand (Q_of o)).Nonempty := by
      rw [Finset.nonempty_iff_ne_empty]
      intro hempty
      have hzero : P_pair h_cand_o (ψ_loc o) = 0 := by
        have h_int_0 : (fun v : EuclideanSpace ℝ (Fin 2) =>
            h_cand_o v * ψ_loc o (ρ_t⁻¹ • (v - V_O o)) *
              Complex.exp (Complex.I * ((lam_sys * Φ₀ (C_t, X_O o, v) : ℝ) : ℂ))) =
            (fun _ => (0 : ℂ)) := by
          ext v
          change (∑ α ∈ T_cand (Q_of o), sub.c_at α * g_at α v) *
              ψ_loc o (ρ_t⁻¹ • (v - V_O o)) *
              Complex.exp (Complex.I * ((lam_sys * Φ₀ (C_t, X_O o, v) : ℝ) : ℂ)) = 0
          rw [hempty, Finset.sum_empty, zero_mul, zero_mul]
        dsimp only [P_pair]
        rw [h_int_0, MeasureTheory.integral_zero, mul_zero]
      rw [hzero, norm_zero] at h_cand_pos
      exact lt_irrefl 0 h_cand_pos
    exact ⟨hm_site_pos, hm_site_ratio, hT_nonempty⟩

  
  have h_s4_act : ∀ o ∈ S_act,
      r_O o = sub.loc_idx.1 * 2 ^ (m_t - m_r) + r_O o % 2 ^ (m_t - m_r) ∧
      r_O o % 2 ^ (m_t - m_r) < 2 ^ (m_t - m_r) ∧
      (∀ k : ℕ, ContDiff ℝ k (ψ_loc o)) ∧
      (∀ z : EuclideanSpace ℝ (Fin 2), cls.R_win ≤ ‖z‖ → ψ_loc o z = 0) ∧
      (∀ (k : ℕ) (z : EuclideanSpace ℝ (Fin 2)), ‖iteratedFDeriv ℝ k (ψ_loc o) z‖ ≤ M_win_loc k) ∧
      (T_cand (Q_of o)).Nonempty := by
    intro o ho
    have hψ_eq : ψ_loc o = Classical.choose (hex_ψ o ho) := dif_pos ho
    obtain ⟨hψl_sm, hψl_supp_R, _, hψl_der, _⟩ := Classical.choose_spec (hex_ψ o ho)
    rw [← hψ_eq] at hψl_sm hψl_supp_R hψl_der
    obtain ⟨hr_decomp, hrloc_lt, _⟩ :=
      hs1_loc (r_O o) (V_O o) (X_O o) (h_obs_win o).1 (h_Sact o ho).1
    exact ⟨hr_decomp, hrloc_lt, hψl_sm, hψl_supp_R, hψl_der, (h_conc1 o ho).2.2⟩

  obtain ⟨h_bridge_Q, h_bridge_Z⟩ :=
    h_s4 ε H_P t r b_star lam_sys k_out m_r m_t N_O N_ret Φ₀ ζ₀ τ_V τ_X n_buf
      r_O V_O X_O ψ_loc sub S_act
      hε_pos hε_lt_half rfl hb_star0 hu_nn hs_c_lo hs_c_hi hmr_le_mt hqr_lt
      hlam_lo hlam_hi h_phase hnbuf hm_bin_pos.le
      (fun α => ⟨hw_reg α, (h_at_props α).2.2.2.2.2.2.1⟩)
      h_o_mult h_vel_cnt
      (fun S => ⟨(h_sub_L2 S).1, (h_sub_L2 S).2.1⟩)
      h_s4_act h_obs_pack

  
  obtain ⟨h_list_Q, h_list_Z⟩ :=
    h_s5 ε H_P t r b_star lam_sys m_r m_t N_O N_D N_ret τ_V τ_X n_buf
      r_O V_O X_O b_D a_D r_D e_D X_D sub.loc_idx sub.o_at S_act
      hε_pos hε_lt_half rfl hs_c_lo hs_c_hi hlam_lo hlam_hi hnbuf

  refine ⟨m_site, h_conc1, ?_, ?_, ?_, ?_⟩
  · intro q
    refine le_trans (h_bridge_Q q) ?_
    refine mul_le_mul_of_nonneg_right ?_ hm_bin_pos.le
    refine mul_le_mul_of_nonneg_right ?_ (Nat.cast_nonneg _)
    exact mul_le_mul_of_nonneg_right hCbridge_le (Real.rpow_nonneg hε_pos.le _)
  · intro z
    refine le_trans (h_bridge_Z z) ?_
    refine mul_le_mul_of_nonneg_right ?_ hm_bin_pos.le
    refine mul_le_mul_of_nonneg_right ?_ (Nat.cast_nonneg _)
    refine mul_le_mul_of_nonneg_right ?_ (Real.rpow_nonneg hε_pos.le _)
    exact mul_le_mul_of_nonneg_right hCbridge_le (Nat.cast_nonneg _)
  · intro α r_loc
    exact le_trans (h_list_Q α r_loc)
      (mul_le_mul_of_nonneg_right hClist_le (Real.rpow_nonneg hε_pos.le _))
  · intro α d hbD haD hd2 heD
    exact le_trans (h_list_Z α d hbD haD hd2 heD)
      (mul_le_mul_of_nonneg_right hClist_le (Real.rpow_nonneg hε_pos.le _))

theorem multi_localizer_score_and_winner_list_split (cls : PacketBoundClass) :
    ∃ C_split : ℝ, 0 ≤ C_split ∧
      ∀ (γ ε H_P L t h b_star lam_sys : ℝ) (m_r m_t N_O N_D N_J S_per_loc : ℕ)
        (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
        (f : EuclideanSpace ℝ (Fin 2) → ℂ)
        (r_O : Fin N_O → ℕ) (V_O X_O : Fin N_O → EuclideanSpace ℝ (Fin 2))
        (ψ_O : Fin N_O → EuclideanSpace ℝ (Fin 2) → ℂ)
        (b_D a_D : Fin N_D → ℝ) (r_D : Fin N_D → ℕ)
        (e_D V_D X_D : Fin N_D → EuclideanSpace ℝ (Fin 2))
        (N_ret_of : Fin N_J → ℕ)
        (menu : ∀ j : Fin N_J, LocalizerSubclass (N_ret_of j))
        (win_of : Fin N_O → Fin N_J)
        (p : Fin N_O → Fin N_D → ℝ)
        (m_site : Fin N_J → Fin N_O → ℝ),
        letI := Classical.propDecidable
        let r := t - 2 * h
        let ell := Real.log (ε⁻¹)
        let s_c := ((2 : ℝ) ^ m_r)⁻¹
        0 < ε → ε < 1 / 4 → 0 < h → 0 < r →
        1 ≤ S_per_loc →
        (∀ j₀, ((Finset.univ.filter (fun j : Fin N_J =>
          (menu j).loc_idx = j₀)).card : ℝ) ≤ (S_per_loc : ℝ)) →
        0 ≤ b_star → ε ^ r ≤ s_c → m_r ≤ m_t →
        IsAdmissiblePacketLaw ε H_P L t cls.B_sys cls.R_win cls.N_mult cls.M_win
          lam_sys m_t Φ₀ f N_O N_D r_O V_O X_O ψ_O b_D a_D r_D e_D V_D X_D p →
        (∀ o d, 0 < p o d →
          let j := win_of o
          (menu j).loc_idx = cutLocalizerIdx ε b_star m_r m_t (r_O o) (V_O o) (X_O o) ∧
          b_star ≤ b_D d ∧
          0 < m_site j o ∧
          generalPacketObsMass ε H_P t lam_sys m_t Φ₀ f (r_O o) (V_O o) (X_O o) (ψ_O o) ≤
            16 * ((S_per_loc : ℝ) ^ 2) * m_site j o) →
        let π_J := fun j : Fin N_J =>
          ∑ o ∈ Finset.univ.filter (fun o => win_of o = j), ∑ d : Fin N_D, p o d
        let H_J := (∑ j : Fin N_J, -(π_J j * Real.log (π_J j))) / ell
        let p_cond := fun (j : Fin N_J) (o : Fin N_O) (d : Fin N_D) =>
          if win_of o = j ∧ 0 < π_J j then p o d / π_J j else 0
        (∀ j : Fin N_J, 0 ≤ π_J j) ∧
        (∑ j : Fin N_J, π_J j = 1) ∧
        (∀ j : Fin N_J, 0 < π_J j →
          (∀ o d, 0 ≤ p_cond j o d) ∧
          (∑ o : Fin N_O, ∑ d : Fin N_D, p_cond j o d = 1) ∧
          (∀ o d, 0 < p_cond j o d → win_of o = j ∧ 0 < p o d)) ∧
        generalPacketScore ε γ H_P t lam_sys m_t Φ₀ f N_O N_D r_O V_O X_O ψ_O b_D a_D p ≤
          H_J + b_star +
          (∑ j : Fin N_J, if 0 < π_J j then π_J j * (
            let p_jO := fun o => ∑ d : Fin N_D, p_cond j o d
            let p_jD := fun d => ∑ o : Fin N_O, p_cond j o d
            (∑ o : Fin N_O, -(p_jO o * Real.log (p_jO o))) / ell +
            (1 / 2 : ℝ) * ((∑ o : Fin N_O, ∑ d : Fin N_D,
              -(p_cond j o d * Real.log (p_cond j o d / p_jD d))) / ell) +
            (3 / 2 : ℝ) * ((∑ o : Fin N_O, p_jO o * Real.log (m_site j o)) / ell) +
            (1 / 2 : ℝ) * (∑ d : Fin N_D, p_jD d * pktWeight γ (b_D d - b_star) (a_D d - b_star)))
           else 0) +
          (7 / 2 : ℝ) * (Real.log (S_per_loc : ℝ) / ell) + C_split / ell :=
by
  let B_ceil : ℕ := ⌈cls.B_sys⌉₊
  let K_box : ℕ := 3 * B_ceil
  let C_J0 : ℕ := (2 * K_box + 1) ^ 4
  let C_split : ℝ := (1 / 2 : ℝ) * Real.log (C_J0 : ℝ) + (3 / 2 : ℝ) * Real.log 16
  have hCJ0_ge1 : 1 ≤ C_J0 := by
    dsimp only [C_J0]
    exact Nat.one_le_pow 4 (2 * K_box + 1) (Nat.succ_pos _)
  have hCJ0_r_ge1 : (1 : ℝ) ≤ (C_J0 : ℝ) := by exact_mod_cast hCJ0_ge1
  have hCJ0_pos : (0 : ℝ) < (C_J0 : ℝ) := lt_of_lt_of_le zero_lt_one hCJ0_r_ge1
  have hC_split_nn : 0 ≤ C_split := by
    have hlog1 : 0 ≤ Real.log (C_J0 : ℝ) := Real.log_nonneg hCJ0_r_ge1
    have hlog16 : 0 ≤ Real.log (16 : ℝ) := Real.log_nonneg (by norm_num)
    dsimp only [C_split]
    linarith
  have h_parseval_bound : ∀ (u e : EuclideanSpace ℝ (Fin 2)) (A B : ℝ),
      ‖e‖ = 1 → 0 ≤ A → 0 ≤ B →
      |inner ℝ u e| ≤ A → |inner ℝ u (perp2D e)| ≤ B →
      ‖u‖ ≤ A + B ∧ |u 0| ≤ ‖u‖ ∧ |u 1| ≤ ‖u‖ := by
    intro u e A B he hA hB h1 h2
    have hu_sq : ‖u‖ ^ 2 = (u 0) ^ 2 + (u 1) ^ 2 := by
      rw [EuclideanSpace.norm_sq_eq, Fin.sum_univ_two]
      simp [Real.norm_eq_abs, sq_abs]
    have he_sq : (e 0) ^ 2 + (e 1) ^ 2 = 1 := by
      have h := EuclideanSpace.norm_sq_eq e
      rw [he, one_pow, Fin.sum_univ_two] at h
      simpa [Real.norm_eq_abs, sq_abs] using h.symm
    have hin1 : inner ℝ u e = u 0 * e 0 + u 1 * e 1 := by
      rw [PiLp.inner_apply, Fin.sum_univ_two]
      simp [mul_comm]
    have hin2 : inner ℝ u (perp2D e) = -(u 0 * e 1) + u 1 * e 0 := by
      rw [PiLp.inner_apply, Fin.sum_univ_two]
      simp [perp2D, mul_comm]
    have h_parseval : ‖u‖ ^ 2 = (inner ℝ u e) ^ 2 + (inner ℝ u (perp2D e)) ^ 2 := by
      rw [hu_sq, hin1, hin2]
      calc (u 0) ^ 2 + (u 1) ^ 2
          = ((u 0) ^ 2 + (u 1) ^ 2) * 1 := (mul_one _).symm
        _ = ((u 0) ^ 2 + (u 1) ^ 2) * ((e 0) ^ 2 + (e 1) ^ 2) := by rw [he_sq]
        _ = (u 0 * e 0 + u 1 * e 1) ^ 2 + (-(u 0 * e 1) + u 1 * e 0) ^ 2 := by ring
    have hsq1 : (inner ℝ u e) ^ 2 ≤ A ^ 2 := by
      rw [← sq_abs (inner ℝ u e)]
      nlinarith [abs_nonneg (inner ℝ u e)]
    have hsq2 : (inner ℝ u (perp2D e)) ^ 2 ≤ B ^ 2 := by
      rw [← sq_abs (inner ℝ u (perp2D e))]
      nlinarith [abs_nonneg (inner ℝ u (perp2D e))]
    have h_norm_le : ‖u‖ ≤ A + B := by
      have h_le_sq : ‖u‖ ^ 2 ≤ (A + B) ^ 2 := by nlinarith
      nlinarith [norm_nonneg u]
    have h_u0 : |u 0| ≤ ‖u‖ := by
      have h0 : |u 0| ^ 2 ≤ ‖u‖ ^ 2 := by rw [sq_abs, hu_sq]; nlinarith [sq_nonneg (u 1)]
      nlinarith [abs_nonneg (u 0), norm_nonneg u]
    have h_u1 : |u 1| ≤ ‖u‖ := by
      have h1' : |u 1| ^ 2 ≤ ‖u‖ ^ 2 := by rw [sq_abs, hu_sq]; nlinarith [sq_nonneg (u 0)]
      nlinarith [abs_nonneg (u 1), norm_nonneg u]
    exact ⟨h_norm_le, h_u0, h_u1⟩
  have h_floor_mem_icc : ∀ (z y : ℝ) (R : ℕ),
      |z - y| ≤ (R : ℝ) →
      ⌊z⌋ ∈ Finset.Icc (⌊y⌋ - (R : ℤ)) (⌊y⌋ + (R : ℤ)) := by
    intro z y R hzy
    obtain ⟨hlo, hhi⟩ := abs_le.mp hzy
    have hy_fl : (⌊y⌋ : ℝ) ≤ y := Int.floor_le y
    have hy_lt : y < (⌊y⌋ : ℝ) + 1 := Int.lt_floor_add_one y
    have hz_fl : (⌊z⌋ : ℝ) ≤ z := Int.floor_le z
    rw [Finset.mem_Icc]
    constructor
    · apply Int.le_floor.mpr
      push_cast
      linarith
    · have hlt_real : (⌊z⌋ : ℝ) < ((⌊y⌋ + (R : ℤ) + 1 : ℤ) : ℝ) := by
        push_cast
        linarith
      have hlt_int : ⌊z⌋ < ⌊y⌋ + (R : ℤ) + 1 := by exact_mod_cast hlt_real
      omega
  have h_icc_card : ∀ (m : ℤ),
      (Finset.Icc (m - (K_box : ℤ)) (m + (K_box : ℤ))).card = 2 * K_box + 1 := by
    intro m
    rw [Int.card_Icc]
    omega
  have h_box_card : ∀ (q_d : ℕ) (m1 m2 m3 m4 : ℤ),
      (({q_d} : Finset ℕ) ×ˢ
        ((Finset.Icc (m1 - (K_box : ℤ)) (m1 + (K_box : ℤ)) ×ˢ
          Finset.Icc (m2 - (K_box : ℤ)) (m2 + (K_box : ℤ))) ×ˢ
         (Finset.Icc (m3 - (K_box : ℤ)) (m3 + (K_box : ℤ)) ×ˢ
          Finset.Icc (m4 - (K_box : ℤ)) (m4 + (K_box : ℤ))))).card = C_J0 := by
    intro q_d m1 m2 m3 m4
    rw [Finset.card_product, Finset.card_singleton,
      Finset.card_product, Finset.card_product, Finset.card_product,
      h_icc_card, h_icc_card, h_icc_card, h_icc_card]
    dsimp only [C_J0]
    ring
  refine ⟨C_split, hC_split_nn, ?_⟩
  intro γ ε H_P L t h b_star lam_sys m_r m_t N_O N_D N_J S_per_loc
    Φ₀ f r_O V_O X_O ψ_O b_D a_D r_D e_D V_D X_D
    N_ret_of menu win_of p m_site
  intro r ell s_c
  intro hε₀ hε₁ hh hr_pos hS_loc_1 h_card_loc hb_star_nn hsc_lo hmr_le_mt hadm h_act
  intro π_J H_J p_cond
  have hε_lt1 : ε < 1 := by linarith
  have hε_le1 : ε ≤ 1 := hε_lt1.le
  have hell_pos : 0 < ell := by
    dsimp only [ell]
    exact Real.log_pos ((one_lt_inv₀ hε₀).mpr hε_lt1)
  have hS_ge1 : (1 : ℝ) ≤ (S_per_loc : ℝ) := by exact_mod_cast hS_loc_1
  have hS_pos : (0 : ℝ) < (S_per_loc : ℝ) := lt_of_lt_of_le zero_lt_one hS_ge1
  obtain ⟨_, _, _, _, _, hd_adm, hp_nn, hp_sum, hp_pos_adm⟩ := hadm

  let p_O : Fin N_O → ℝ := fun o => ∑ d : Fin N_D, p o d
  let p_D : Fin N_D → ℝ := fun d => ∑ o : Fin N_O, p o d
  have hpO_nn : ∀ o : Fin N_O, 0 ≤ p_O o :=
    fun o => Finset.sum_nonneg (fun d _ => hp_nn o d)
  have hpD_nn : ∀ d : Fin N_D, 0 ≤ p_D d :=
    fun d => Finset.sum_nonneg (fun o _ => hp_nn o d)
  have hpO_sum1 : ∑ o : Fin N_O, p_O o = 1 := hp_sum
  have hpD_sum1 : ∑ d : Fin N_D, p_D d = 1 := by
    dsimp only [p_D]
    rw [Finset.sum_comm]
    exact hp_sum

  have hπ_eq_ite : ∀ j : Fin N_J,
      π_J j = ∑ o : Fin N_O, if win_of o = j then p_O o else 0 := by
    intro j
    dsimp only [π_J, p_O]
    rw [← Finset.sum_filter]
    congr 1
    ext o
    simp

  have hp_le_pO : ∀ (o : Fin N_O) (d : Fin N_D), p o d ≤ p_O o :=
    fun o d => Finset.single_le_sum (fun d' _ => hp_nn o d') (Finset.mem_univ d)
  have hp_le_pD : ∀ (o : Fin N_O) (d : Fin N_D), p o d ≤ p_D d :=
    fun o d => Finset.single_le_sum (fun o' _ => hp_nn o' d) (Finset.mem_univ o)
  have hpO_le_π : ∀ o : Fin N_O, p_O o ≤ π_J (win_of o) := by
    intro o
    rw [hπ_eq_ite]
    have h_term : p_O o = (if win_of o = win_of o then p_O o else 0) := (if_pos rfl).symm
    rw [h_term]
    exact Finset.single_le_sum
      (f := fun o' => if win_of o' = win_of o then p_O o' else 0)
      (fun o' _ => by split_ifs <;> [exact hpO_nn o'; exact le_rfl])
      (Finset.mem_univ o)

  have hπ_nn : ∀ j : Fin N_J, 0 ≤ π_J j :=
    fun j => Finset.sum_nonneg (fun o _ => Finset.sum_nonneg (fun d _ => hp_nn o d))

  have hπ_sum1 : ∑ j : Fin N_J, π_J j = 1 := by
    simp_rw [hπ_eq_ite]
    rw [Finset.sum_comm]
    have h_one : ∀ o : Fin N_O,
        (∑ j : Fin N_J, if win_of o = j then p_O o else 0) = p_O o := by
      intro o
      simp [Finset.sum_ite_eq]
    simp_rw [h_one]
    exact hpO_sum1

  have hp_cond_props : ∀ j : Fin N_J, 0 < π_J j →
      (∀ o d, 0 ≤ p_cond j o d) ∧
      (∑ o : Fin N_O, ∑ d : Fin N_D, p_cond j o d = 1) ∧
      (∀ o d, 0 < p_cond j o d → win_of o = j ∧ 0 < p o d) := by
    intro j hπj
    refine ⟨?_, ?_, ?_⟩
    · intro o d
      dsimp only [p_cond]
      split_ifs
      · exact div_nonneg (hp_nn o d) hπj.le
      · exact le_rfl
    · have h_row : ∀ o : Fin N_O,
          (∑ d : Fin N_D, p_cond j o d) =
            (if win_of o = j then p_O o else 0) / π_J j := by
        intro o
        by_cases hwo : win_of o = j
        · have hc : win_of o = j ∧ 0 < π_J j := ⟨hwo, hπj⟩
          have h_d : ∀ d : Fin N_D, p_cond j o d = p o d / π_J j := by
            intro d; dsimp only [p_cond]; exact if_pos hc
          simp_rw [h_d]
          rw [← Finset.sum_div, if_pos hwo]
        · have h_d : ∀ d : Fin N_D, p_cond j o d = 0 := by
            intro d; dsimp only [p_cond]; exact if_neg (fun hc => hwo hc.1)
          simp_rw [h_d]
          rw [Finset.sum_const_zero, if_neg hwo, zero_div]
      simp_rw [h_row]
      rw [← Finset.sum_div, ← hπ_eq_ite j, div_self hπj.ne']
    · intro o d hpos
      dsimp only [p_cond] at hpos
      by_cases hc : win_of o = j ∧ 0 < π_J j
      · rw [if_pos hc] at hpos
        have hmul_pos : 0 < (p o d / π_J j) * π_J j := mul_pos hpos hπj
        rw [div_mul_cancel₀ _ hπj.ne'] at hmul_pos
        exact ⟨hc.1, hmul_pos⟩
      · rw [if_neg hc] at hpos
        exact False.elim (lt_irrefl 0 hpos)

  let p_cond_O : Fin N_J → Fin N_O → ℝ := fun j o => ∑ d : Fin N_D, p_cond j o d
  let p_cond_D : Fin N_J → Fin N_D → ℝ := fun j d => ∑ o : Fin N_O, p_cond j o d
  let P_JD : Fin N_J → Fin N_D → ℝ := fun j d =>
    ∑ o : Fin N_O, if win_of o = j then p o d else 0
  have hPJD_nn : ∀ (j : Fin N_J) (d : Fin N_D), 0 ≤ P_JD j d := by
    intro j d
    refine Finset.sum_nonneg (fun o _ => ?_)
    split_ifs
    · exact hp_nn o d
    · exact le_rfl
  have hPJD_sum_d : ∀ d : Fin N_D, ∑ j : Fin N_J, P_JD j d = p_D d := by
    intro d
    dsimp only [P_JD, p_D]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun o _ => ?_)
    simp [Finset.sum_ite_eq]
  have hp_le_PJD : ∀ (o : Fin N_O) (d : Fin N_D), p o d ≤ P_JD (win_of o) d := by
    intro o d
    dsimp only [P_JD]
    have h_term : p o d = (if win_of o = win_of o then p o d else 0) := (if_pos rfl).symm
    rw [h_term]
    exact Finset.single_le_sum
      (f := fun o' => if win_of o' = win_of o then p o' d else 0)
      (fun o' _ => by split_ifs <;> [exact hp_nn o' d; exact le_rfl])
      (Finset.mem_univ o)
  have hPJD_le_π : ∀ (j : Fin N_J) (d : Fin N_D), P_JD j d ≤ π_J j := by
    intro j d
    rw [hπ_eq_ite j]
    refine Finset.sum_le_sum (fun o _ => ?_)
    split_ifs
    · exact hp_le_pO o d
    · exact le_rfl
  have h_mul_pcond : ∀ (j : Fin N_J) (o : Fin N_O) (d : Fin N_D),
      π_J j * p_cond j o d = if win_of o = j then p o d else 0 := by
    intro j o d
    dsimp only [p_cond]
    by_cases hwo : win_of o = j
    · by_cases hπj : 0 < π_J j
      · rw [if_pos ⟨hwo, hπj⟩, if_pos hwo, mul_div_cancel₀ _ hπj.ne']
      · have hπ0 : π_J j = 0 := le_antisymm (not_lt.mp hπj) (hπ_nn j)
        have hp0 : p o d = 0 := by
          have hle : p o d ≤ π_J j :=
            le_trans (hp_le_pO o d) (by rw [← hwo]; exact hpO_le_π o)
          exact le_antisymm (hπ0 ▸ hle) (hp_nn o d)
        rw [if_neg (fun hc => hπj hc.2), if_pos hwo, mul_zero, hp0]
    · rw [if_neg (fun hc => hwo hc.1), if_neg hwo, mul_zero]
  have h_mul_pcond_O : ∀ (j : Fin N_J) (o : Fin N_O),
      π_J j * p_cond_O j o = if win_of o = j then p_O o else 0 := by
    intro j o
    dsimp only [p_cond_O, p_O]
    rw [Finset.mul_sum]
    simp_rw [h_mul_pcond j o]
    by_cases hwo : win_of o = j
    · simp [hwo]
    · simp [hwo]
  have h_mul_pcond_D : ∀ (j : Fin N_J) (d : Fin N_D),
      π_J j * p_cond_D j d = P_JD j d := by
    intro j d
    dsimp only [p_cond_D, P_JD]
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl (fun o _ => h_mul_pcond j o d)
  have h_ite_pi : ∀ (F : Fin N_J → ℝ) (j : Fin N_J) [Decidable (0 < π_J j)],
      (@ite ℝ (0 < π_J j) _ (π_J j * F j) 0) = π_J j * F j := by
    intro F j _
    by_cases hπj : 0 < π_J j
    · exact if_pos hπj
    · have hπ0 : π_J j = 0 := le_antisymm (not_lt.mp hπj) (hπ_nn j)
      rw [if_neg hπj, hπ0, zero_mul]

  have h_HO_pt : ∀ (j : Fin N_J) (o : Fin N_O),
      π_J j * -(p_cond_O j o * Real.log (p_cond_O j o)) =
        if win_of o = j then -(p_O o * Real.log (p_O o)) + p_O o * Real.log (π_J j) else 0 := by
    intro j o
    by_cases hwo : win_of o = j
    · rw [if_pos hwo]
      rcases eq_or_lt_of_le (hpO_nn o) with hpO0 | hpO_pos
      · rw [← hpO0]
        simp only [zero_mul, neg_zero, zero_add]
        by_cases hπ0 : π_J j = 0
        · rw [hπ0, zero_mul]
        · have hprod := h_mul_pcond_O j o
          rw [if_pos hwo, ← hpO0] at hprod
          have hpc0 : p_cond_O j o = 0 := (mul_eq_zero.mp hprod).resolve_left hπ0
          rw [hpc0, zero_mul, neg_zero, mul_zero]
      · have hπ_pos : 0 < π_J j := lt_of_lt_of_le hpO_pos (by rw [← hwo]; exact hpO_le_π o)
        have hprod := h_mul_pcond_O j o
        rw [if_pos hwo] at hprod
        have hpc_eq : p_cond_O j o = p_O o / π_J j := by
          rw [← hprod, mul_div_cancel_left₀ _ hπ_pos.ne']
        rw [hpc_eq, Real.log_div hpO_pos.ne' hπ_pos.ne']
        have hcancel : π_J j * (p_O o / π_J j) = p_O o := mul_div_cancel₀ _ hπ_pos.ne'
        calc π_J j * -(p_O o / π_J j * (Real.log (p_O o) - Real.log (π_J j)))
            = -(π_J j * (p_O o / π_J j)) * (Real.log (p_O o) - Real.log (π_J j)) := by ring
          _ = -(p_O o) * (Real.log (p_O o) - Real.log (π_J j)) := by rw [hcancel]
          _ = -(p_O o * Real.log (p_O o)) + p_O o * Real.log (π_J j) := by ring
    · rw [if_neg hwo]
      by_cases hπ0 : π_J j = 0
      · rw [hπ0, zero_mul]
      · have hprod := h_mul_pcond_O j o
        rw [if_neg hwo] at hprod
        have hpc0 : p_cond_O j o = 0 := (mul_eq_zero.mp hprod).resolve_left hπ0
        rw [hpc0, zero_mul, neg_zero, mul_zero]

  have h_HO_sum :
      (∑ o : Fin N_O, -(p_O o * Real.log (p_O o))) =
      (∑ j : Fin N_J, -(π_J j * Real.log (π_J j))) +
      ∑ j : Fin N_J, π_J j * (∑ o : Fin N_O, -(p_cond_O j o * Real.log (p_cond_O j o))) := by
    have h_j_sum : ∀ j : Fin N_J,
        π_J j * (∑ o : Fin N_O, -(p_cond_O j o * Real.log (p_cond_O j o))) =
        (∑ o : Fin N_O, if win_of o = j then -(p_O o * Real.log (p_O o)) else 0) +
          π_J j * Real.log (π_J j) := by
      intro j
      rw [Finset.mul_sum]
      simp_rw [h_HO_pt j]
      have h_split : ∀ o : Fin N_O,
          (if win_of o = j then -(p_O o * Real.log (p_O o)) + p_O o * Real.log (π_J j) else 0) =
          (if win_of o = j then -(p_O o * Real.log (p_O o)) else 0) +
          (if win_of o = j then p_O o else 0) * Real.log (π_J j) := by
        intro o
        split_ifs <;> ring
      simp_rw [h_split]
      rw [Finset.sum_add_distrib, ← Finset.sum_mul, ← hπ_eq_ite j]
    simp_rw [h_j_sum]
    rw [Finset.sum_add_distrib, Finset.sum_comm]
    have h_one : ∀ o : Fin N_O,
        (∑ j : Fin N_J, if win_of o = j then -(p_O o * Real.log (p_O o)) else 0) =
          -(p_O o * Real.log (p_O o)) := by
      intro o
      simp [Finset.sum_ite_eq]
    simp_rw [h_one]
    simp_rw [Finset.sum_neg_distrib]
    ring

  have h_HO_eq :
      (∑ o : Fin N_O, -(p_O o * Real.log (p_O o))) / ell =
      H_J + ∑ j : Fin N_J,
        π_J j * ((∑ o : Fin N_O, -(p_cond_O j o * Real.log (p_cond_O j o))) / ell) := by
    rw [h_HO_sum, add_div]
    change H_J + (∑ j : Fin N_J, π_J j * (∑ o : Fin N_O, -(p_cond_O j o * Real.log (p_cond_O j o)))) / ell = _
    rw [Finset.sum_div]
    congr 1
    refine Finset.sum_congr rfl (fun j _ => ?_)
    ring

  have h_Ew_eq :
      (1 / 2 : ℝ) * (∑ d : Fin N_D, p_D d * ((1 + γ) * b_D d + (1 - γ) * a_D d)) =
      b_star + ∑ j : Fin N_J, π_J j *
        ((1 / 2 : ℝ) * (∑ d : Fin N_D, p_cond_D j d * pktWeight γ (b_D d - b_star) (a_D d - b_star))) := by
    have h_wt : ∀ d : Fin N_D,
        p_D d * ((1 + γ) * b_D d + (1 - γ) * a_D d) =
          p_D d * (2 * b_star) +
          (∑ j : Fin N_J, π_J j * (p_cond_D j d * pktWeight γ (b_D d - b_star) (a_D d - b_star))) := by
      intro d
      have h_pD_j : p_D d = ∑ j : Fin N_J, π_J j * p_cond_D j d := by
        rw [← hPJD_sum_d d]
        exact Finset.sum_congr rfl (fun j _ => (h_mul_pcond_D j d).symm)
      have h_poly : (1 + γ) * b_D d + (1 - γ) * a_D d =
          2 * b_star + pktWeight γ (b_D d - b_star) (a_D d - b_star) := by
        dsimp only [pktWeight]
        ring
      rw [h_poly, mul_add]
      congr 1
      conv_lhs => rw [h_pD_j, Finset.sum_mul]
      exact Finset.sum_congr rfl (fun j _ => mul_assoc _ _ _)
    simp_rw [h_wt]
    rw [Finset.sum_add_distrib, ← Finset.sum_mul, hpD_sum1, one_mul, Finset.sum_comm]
    rw [mul_add, Finset.mul_sum]
    have h_b : (1 / 2 : ℝ) * (2 * b_star) = b_star := by ring
    rw [h_b]
    congr 1
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [← Finset.mul_sum]
    ring

  let m_f : Fin N_O → ℝ := fun o =>
    generalPacketObsMass ε H_P t lam_sys m_t Φ₀ f (r_O o) (V_O o) (X_O o) (ψ_O o)
  have h_Emass_le :
      (3 / 2 : ℝ) * ((∑ o : Fin N_O, p_O o * Real.log (m_f o)) / ell) ≤
      (∑ j : Fin N_J, π_J j *
        ((3 / 2 : ℝ) * ((∑ o : Fin N_O, p_cond_O j o * Real.log (m_site j o)) / ell))) +
      3 * (Real.log (S_per_loc : ℝ) / ell) + ((3 / 2 : ℝ) * Real.log 16) / ell := by
    have h_pt : ∀ o : Fin N_O,
        p_O o * Real.log (m_f o) ≤
          p_O o * Real.log (m_site (win_of o) o) +
          p_O o * (Real.log 16 + 2 * Real.log (S_per_loc : ℝ)) := by
      intro o
      rcases eq_or_lt_of_le (hpO_nn o) with hpO0 | hpO_pos
      · rw [← hpO0]
        simp
      · obtain ⟨d₀, _, hpod₀⟩ :=
          (Finset.sum_pos_iff_of_nonneg (fun d _ => hp_nn o d)).mp hpO_pos
        have hmf_pos : 0 < m_f o := (hp_pos_adm o d₀ hpod₀).1
        obtain ⟨_, _, hms_pos, hmf_le⟩ := h_act o d₀ hpod₀
        have h16S_pos : (0 : ℝ) < 16 * ((S_per_loc : ℝ) ^ 2) := by positivity
        have hlog_le : Real.log (m_f o) ≤
            Real.log (m_site (win_of o) o) + (Real.log 16 + 2 * Real.log (S_per_loc : ℝ)) := by
          calc Real.log (m_f o)
              ≤ Real.log (16 * ((S_per_loc : ℝ) ^ 2) * m_site (win_of o) o) :=
                Real.log_le_log hmf_pos hmf_le
            _ = Real.log (16 * ((S_per_loc : ℝ) ^ 2)) + Real.log (m_site (win_of o) o) :=
                Real.log_mul h16S_pos.ne' hms_pos.ne'
            _ = Real.log 16 + Real.log ((S_per_loc : ℝ) ^ 2) + Real.log (m_site (win_of o) o) := by
                rw [Real.log_mul (by norm_num : (16 : ℝ) ≠ 0) (pow_ne_zero 2 hS_pos.ne')]
            _ = Real.log (m_site (win_of o) o) + (Real.log 16 + 2 * Real.log (S_per_loc : ℝ)) := by
                rw [Real.log_pow]; ring
        have hmul := mul_le_mul_of_nonneg_left hlog_le hpO_pos.le
        linarith
    have h_sum_o :
        ∑ o : Fin N_O, p_O o * Real.log (m_f o) ≤
          (∑ o : Fin N_O, p_O o * Real.log (m_site (win_of o) o)) +
          (Real.log 16 + 2 * Real.log (S_per_loc : ℝ)) := by
      calc ∑ o : Fin N_O, p_O o * Real.log (m_f o)
          ≤ ∑ o : Fin N_O, (p_O o * Real.log (m_site (win_of o) o) +
              p_O o * (Real.log 16 + 2 * Real.log (S_per_loc : ℝ))) :=
            Finset.sum_le_sum (fun o _ => h_pt o)
        _ = (∑ o : Fin N_O, p_O o * Real.log (m_site (win_of o) o)) +
              (∑ o : Fin N_O, p_O o) * (Real.log 16 + 2 * Real.log (S_per_loc : ℝ)) := by
            rw [Finset.sum_add_distrib, ← Finset.sum_mul]
        _ = (∑ o : Fin N_O, p_O o * Real.log (m_site (win_of o) o)) +
              (Real.log 16 + 2 * Real.log (S_per_loc : ℝ)) := by
            rw [hpO_sum1, one_mul]
    have h_ms_split :
        (∑ o : Fin N_O, p_O o * Real.log (m_site (win_of o) o)) =
        ∑ j : Fin N_J, π_J j * (∑ o : Fin N_O, p_cond_O j o * Real.log (m_site j o)) := by
      have h_o_eq : ∀ o : Fin N_O,
          p_O o * Real.log (m_site (win_of o) o) =
            ∑ j : Fin N_J, (if win_of o = j then p_O o else 0) * Real.log (m_site j o) := by
        intro o
        have h_ite : ∀ j : Fin N_J,
            (if win_of o = j then p_O o else 0) * Real.log (m_site j o) =
              if win_of o = j then p_O o * Real.log (m_site j o) else 0 := by
          intro j; split_ifs <;> ring
        simp_rw [h_ite]
        simp [Finset.sum_ite_eq]
      simp_rw [h_o_eq]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun o _ => ?_)
      rw [← h_mul_pcond_O j o, mul_assoc]
    rw [h_ms_split] at h_sum_o
    have h_div := div_le_div_of_nonneg_right h_sum_o hell_pos.le
    have h_mul32 := mul_le_mul_of_nonneg_left h_div (by norm_num : (0 : ℝ) ≤ 3 / 2)
    have h_rhs_eq :
        (3 / 2 : ℝ) * (((∑ j : Fin N_J, π_J j * (∑ o : Fin N_O, p_cond_O j o * Real.log (m_site j o))) +
          (Real.log 16 + 2 * Real.log (S_per_loc : ℝ))) / ell) =
        (∑ j : Fin N_J, π_J j *
          ((3 / 2 : ℝ) * ((∑ o : Fin N_O, p_cond_O j o * Real.log (m_site j o)) / ell))) +
        3 * (Real.log (S_per_loc : ℝ) / ell) + ((3 / 2 : ℝ) * Real.log 16) / ell := by
      rw [add_div, mul_add, Finset.sum_div, Finset.mul_sum]
      have h_sum_rw :
          (∑ j : Fin N_J, (3 / 2 : ℝ) * (π_J j * (∑ o : Fin N_O, p_cond_O j o * Real.log (m_site j o)) / ell)) =
          ∑ j : Fin N_J, π_J j * ((3 / 2 : ℝ) * ((∑ o : Fin N_O, p_cond_O j o * Real.log (m_site j o)) / ell)) :=
        Finset.sum_congr rfl (fun j _ => by ring)
      rw [h_sum_rw]
      ring
    linarith

  let B_fib : ℝ := (C_J0 : ℝ) * (S_per_loc : ℝ)
  have hB_fib_pos : 0 < B_fib := mul_pos hCJ0_pos hS_pos
  have hs_c_ge : ε ^ t ≤ s_c :=
    le_trans (Real.rpow_le_rpow_of_exponent_ge hε₀ hε_le1 (by dsimp only [r]; linarith)) hsc_lo
  have hB_nn : 0 ≤ cls.B_sys := by linarith [cls.hB_sys]
  have hB_ceil_le : cls.B_sys ≤ (B_ceil : ℝ) := Nat.le_ceil cls.B_sys
  have h3B_le_K : 3 * cls.B_sys ≤ (K_box : ℝ) := by
    dsimp only [K_box]
    push_cast
    linarith
  have h2B_le_K : 2 * cls.B_sys ≤ (K_box : ℝ) := by linarith

  have h_gibbs_d : ∀ d : Fin N_D,
      (∑ j : Fin N_J, -(P_JD j d * Real.log (P_JD j d / p_D d))) ≤
        p_D d * Real.log B_fib := by
    intro d
    rcases eq_or_lt_of_le (hpD_nn d) with hpD0 | hpD_pos
    · have h_all0 : ∀ j : Fin N_J, P_JD j d = 0 := by
        intro j
        have hle : P_JD j d ≤ p_D d := by
          rw [← hPJD_sum_d d]
          exact Finset.single_le_sum (fun j' _ => hPJD_nn j' d) (Finset.mem_univ j)
        exact le_antisymm (hpD0 ▸ hle) (hPJD_nn j d)
      rw [← hpD0, zero_mul]
      refine le_of_eq (Finset.sum_eq_zero (fun j _ => ?_))
      rw [h_all0 j, zero_div, Real.log_zero, mul_zero, neg_zero]
    · let s_v : ℝ := ε ^ b_star
      let s_x : ℝ := s_c * s_v
      have hsv_pos : 0 < s_v := Real.rpow_pos_of_pos hε₀ b_star
      have hsc_pos : 0 < s_c := inv_pos.mpr (pow_pos (by norm_num : (0 : ℝ) < 2) m_r)
      have hsx_pos : 0 < s_x := mul_pos hsc_pos hsv_pos
      let K_t : ℕ := 2 ^ (m_t - m_r)
      let q_d : ℕ := r_D d / K_t
      let C_rd : ℝ := ((q_d : ℝ) + 1 / 2) * s_c
      let C_td : ℝ := ((r_D d : ℝ) + 1 / 2) * ((2 : ℝ) ^ m_t)⁻¹
      have hKt_pos : 0 < K_t := Nat.two_pow_pos (m_t - m_r)
      have hKt_r_pos : (0 : ℝ) < (K_t : ℝ) := by exact_mod_cast hKt_pos
      have hpow_mt : ((2 : ℝ) ^ m_t)⁻¹ = s_c * (K_t : ℝ)⁻¹ := by
        have hm : m_t = m_r + (m_t - m_r) := (Nat.add_sub_of_le hmr_le_mt).symm
        dsimp only [s_c, K_t]
        conv_lhs => rw [hm, pow_add]
        push_cast
        rw [mul_inv]
      let r_rem : ℕ := r_D d % K_t
      have hr_div_mod : r_D d = K_t * q_d + r_rem := (Nat.div_add_mod (r_D d) K_t).symm
      have hr_rem_lt : r_rem < K_t := Nat.mod_lt (r_D d) hKt_pos
      have hr_rem_le : (r_rem : ℝ) + 1 ≤ (K_t : ℝ) := by
        have h1 : r_rem + 1 ≤ K_t := Nat.succ_le_of_lt hr_rem_lt
        exact_mod_cast h1
      have hr_rem_nn : (0 : ℝ) ≤ (r_rem : ℝ) := Nat.cast_nonneg r_rem
      have hC_diff_eq : C_rd - C_td = s_c * (1 / 2 - ((r_rem : ℝ) + 1 / 2) / (K_t : ℝ)) := by
        dsimp only [C_rd, C_td]
        rw [hpow_mt, hr_div_mod]
        push_cast
        have hKt_ne : (K_t : ℝ) ≠ 0 := hKt_r_pos.ne'
        field_simp [hKt_ne]
        ring
      have hC_diff_abs : |C_rd - C_td| ≤ (1 / 2 : ℝ) * s_c := by
        rw [hC_diff_eq, abs_mul, abs_of_pos hsc_pos, mul_comm]
        refine mul_le_mul_of_nonneg_right ?_ hsc_pos.le
        rw [abs_le]
        constructor
        · have h_le1 : ((r_rem : ℝ) + 1 / 2) / (K_t : ℝ) ≤ 1 := by
            rw [div_le_one hKt_r_pos]
            linarith only [hr_rem_le]
          linarith only [h_le1]
        · have h_nn : 0 ≤ ((r_rem : ℝ) + 1 / 2) / (K_t : ℝ) :=
            div_nonneg (by linarith only [hr_rem_nn]) hKt_r_pos.le
          linarith only [h_nn]
      let v0_d : ℝ := (V_D d) 0 / s_v + 1 / 2
      let v1_d : ℝ := (V_D d) 1 / s_v + 1 / 2
      let x0_d : ℝ := ((X_D d) 0 + (C_rd - C_td) * (V_D d) 0) / s_x + 1 / 2
      let x1_d : ℝ := ((X_D d) 1 + (C_rd - C_td) * (V_D d) 1) / s_x + 1 / 2
      let Box_d : Finset (ℕ × (ℤ × ℤ) × (ℤ × ℤ)) :=
        ({q_d} : Finset ℕ) ×ˢ
          ((Finset.Icc (⌊v0_d⌋ - (K_box : ℤ)) (⌊v0_d⌋ + (K_box : ℤ)) ×ˢ
            Finset.Icc (⌊v1_d⌋ - (K_box : ℤ)) (⌊v1_d⌋ + (K_box : ℤ))) ×ˢ
           (Finset.Icc (⌊x0_d⌋ - (K_box : ℤ)) (⌊x0_d⌋ + (K_box : ℤ)) ×ˢ
            Finset.Icc (⌊x1_d⌋ - (K_box : ℤ)) (⌊x1_d⌋ + (K_box : ℤ))))
      let fib_fn : ℕ × (ℤ × ℤ) × (ℤ × ℤ) → Finset (Fin N_J) :=
        fun j₀ => Finset.univ.filter (fun j : Fin N_J => (menu j).loc_idx = j₀)
      letI : DecidablePred (fun j : Fin N_J => 0 < P_JD j d) :=
        fun _ => Classical.propDecidable _
      let S_d : Finset (Fin N_J) := Finset.univ.filter (fun j : Fin N_J => 0 < P_JD j d)
      have h_sub : S_d ⊆ Box_d.biUnion fib_fn := by
        intro j hj
        rw [Finset.mem_filter] at hj
        obtain ⟨_, hP_pos⟩ := hj
        obtain ⟨o, _, ho_pos⟩ :=
          (Finset.sum_pos_iff_of_nonneg
            (fun o _ => by split_ifs <;> [exact hp_nn o d; exact le_rfl])).mp hP_pos
        have hwo : win_of o = j := by
          by_contra hne
          rw [if_neg hne] at ho_pos
          exact lt_irrefl 0 ho_pos
        rw [if_pos hwo] at ho_pos
        obtain ⟨_, hr_eq, hv1, hv2, hx1, hx2⟩ := hp_pos_adm o d ho_pos
        obtain ⟨_, hba, _, _, he_unit⟩ := hd_adm d
        obtain ⟨hloc_eq, hb_star_le, _, _⟩ := h_act o d ho_pos
        rw [hwo] at hloc_eq
        have heb : ε ^ (b_D d) ≤ s_v :=
          Real.rpow_le_rpow_of_exponent_ge hε₀ hε_le1 hb_star_le
        have hea : ε ^ (a_D d) ≤ s_v :=
          Real.rpow_le_rpow_of_exponent_ge hε₀ hε_le1 (le_trans hb_star_le hba)
        have hebt : ε ^ (b_D d + t) ≤ s_x := by
          rw [Real.rpow_add hε₀, mul_comm]
          exact mul_le_mul hs_c_ge heb (Real.rpow_nonneg hε₀.le _) hsc_pos.le
        have heat : ε ^ (a_D d + t) ≤ s_x := by
          rw [Real.rpow_add hε₀, mul_comm]
          exact mul_le_mul hs_c_ge hea (Real.rpow_nonneg hε₀.le _) hsc_pos.le
        have hV_parse := h_parseval_bound (V_O o - V_D d) (e_D d)
          (cls.B_sys * s_v) (cls.B_sys * s_v) he_unit
          (mul_nonneg hB_nn hsv_pos.le) (mul_nonneg hB_nn hsv_pos.le)
          (le_trans hv1 (mul_le_mul_of_nonneg_left heb hB_nn))
          (le_trans hv2 (mul_le_mul_of_nonneg_left hea hB_nn))
        have hX_parse := h_parseval_bound (X_O o - X_D d) (e_D d)
          (cls.B_sys * s_x) (cls.B_sys * s_x) he_unit
          (mul_nonneg hB_nn hsx_pos.le) (mul_nonneg hB_nn hsx_pos.le)
          (le_trans hx1 (mul_le_mul_of_nonneg_left hebt hB_nn))
          (le_trans hx2 (mul_le_mul_of_nonneg_left heat hB_nn))
        have hV0_abs : |(V_O o) 0 - (V_D d) 0| ≤ 2 * cls.B_sys * s_v := by
          have h1 : |(V_O o - V_D d) 0| ≤ 2 * cls.B_sys * s_v := by
            linarith only [hV_parse.1, hV_parse.2.1]
          exact h1
        have hV1_abs : |(V_O o) 1 - (V_D d) 1| ≤ 2 * cls.B_sys * s_v := by
          have h1 : |(V_O o - V_D d) 1| ≤ 2 * cls.B_sys * s_v := by
            linarith only [hV_parse.1, hV_parse.2.2]
          exact h1
        have hX0_abs : |(X_O o) 0 - (X_D d) 0| ≤ 2 * cls.B_sys * s_x := by
          have h1 : |(X_O o - X_D d) 0| ≤ 2 * cls.B_sys * s_x := by
            linarith only [hX_parse.1, hX_parse.2.1]
          exact h1
        have hX1_abs : |(X_O o) 1 - (X_D d) 1| ≤ 2 * cls.B_sys * s_x := by
          have h1 : |(X_O o - X_D d) 1| ≤ 2 * cls.B_sys * s_x := by
            linarith only [hX_parse.1, hX_parse.2.2]
          exact h1
        have h2B_sv : 2 * cls.B_sys * s_v ≤ (K_box : ℝ) * s_v :=
          mul_le_mul_of_nonneg_right h2B_le_K hsv_pos.le
        have h3B_sx : 3 * cls.B_sys * s_x ≤ (K_box : ℝ) * s_x :=
          mul_le_mul_of_nonneg_right h3B_le_K hsx_pos.le
        have hv0_bd : |((V_O o) 0 / s_v + 1 / 2) - v0_d| ≤ (K_box : ℝ) := by
          have h_eq : ((V_O o) 0 / s_v + 1 / 2) - v0_d = ((V_O o) 0 - (V_D d) 0) / s_v := by
            dsimp only [v0_d]; ring
          rw [h_eq, abs_div, abs_of_pos hsv_pos, div_le_iff₀ hsv_pos]
          linarith only [hV0_abs, h2B_sv]
        have hv1_bd : |((V_O o) 1 / s_v + 1 / 2) - v1_d| ≤ (K_box : ℝ) := by
          have h_eq : ((V_O o) 1 / s_v + 1 / 2) - v1_d = ((V_O o) 1 - (V_D d) 1) / s_v := by
            dsimp only [v1_d]; ring
          rw [h_eq, abs_div, abs_of_pos hsv_pos, div_le_iff₀ hsv_pos]
          linarith only [hV1_abs, h2B_sv]
        have hhalf_sc_nn : (0 : ℝ) ≤ (1 / 2 : ℝ) * s_c := mul_nonneg (by norm_num) hsc_pos.le
        have hx0_bd : |(((X_O o) 0 + (C_rd - C_td) * (V_O o) 0) / s_x + 1 / 2) - x0_d| ≤ (K_box : ℝ) := by
          have h_eq : (((X_O o) 0 + (C_rd - C_td) * (V_O o) 0) / s_x + 1 / 2) - x0_d =
              (((X_O o) 0 - (X_D d) 0) + (C_rd - C_td) * ((V_O o) 0 - (V_D d) 0)) / s_x := by
            dsimp only [x0_d]; ring
          rw [h_eq, abs_div, abs_of_pos hsx_pos, div_le_iff₀ hsx_pos]
          have htri := abs_add_le ((X_O o) 0 - (X_D d) 0) ((C_rd - C_td) * ((V_O o) 0 - (V_D d) 0))
          rw [abs_mul] at htri
          have hprod_le : |C_rd - C_td| * |(V_O o) 0 - (V_D d) 0| ≤ cls.B_sys * s_x := by
            have hm := mul_le_mul hC_diff_abs hV0_abs (abs_nonneg _) hhalf_sc_nn
            have hid : ((1 / 2 : ℝ) * s_c) * (2 * cls.B_sys * s_v) = cls.B_sys * s_x := by
              dsimp only [s_x]; ring
            rwa [hid] at hm
          linarith only [htri, hX0_abs, hprod_le, h3B_sx]
        have hx1_bd : |(((X_O o) 1 + (C_rd - C_td) * (V_O o) 1) / s_x + 1 / 2) - x1_d| ≤ (K_box : ℝ) := by
          have h_eq : (((X_O o) 1 + (C_rd - C_td) * (V_O o) 1) / s_x + 1 / 2) - x1_d =
              (((X_O o) 1 - (X_D d) 1) + (C_rd - C_td) * ((V_O o) 1 - (V_D d) 1)) / s_x := by
            dsimp only [x1_d]; ring
          rw [h_eq, abs_div, abs_of_pos hsx_pos, div_le_iff₀ hsx_pos]
          have htri := abs_add_le ((X_O o) 1 - (X_D d) 1) ((C_rd - C_td) * ((V_O o) 1 - (V_D d) 1))
          rw [abs_mul] at htri
          have hprod_le : |C_rd - C_td| * |(V_O o) 1 - (V_D d) 1| ≤ cls.B_sys * s_x := by
            have hm := mul_le_mul hC_diff_abs hV1_abs (abs_nonneg _) hhalf_sc_nn
            have hid : ((1 / 2 : ℝ) * s_c) * (2 * cls.B_sys * s_v) = cls.B_sys * s_x := by
              dsimp only [s_x]; ring
            rwa [hid] at hm
          linarith only [htri, hX1_abs, hprod_le, h3B_sx]
        have h_mem_box : (menu j).loc_idx ∈ Box_d := by
          rw [hloc_eq, hr_eq]
          dsimp only [cutLocalizerIdx, Box_d]
          refine Finset.mem_product.mpr ⟨Finset.mem_singleton_self q_d, ?_⟩
          refine Finset.mem_product.mpr ⟨Finset.mem_product.mpr ⟨?_, ?_⟩, Finset.mem_product.mpr ⟨?_, ?_⟩⟩
          · exact h_floor_mem_icc _ _ K_box hv0_bd
          · exact h_floor_mem_icc _ _ K_box hv1_bd
          · exact h_floor_mem_icc _ _ K_box hx0_bd
          · exact h_floor_mem_icc _ _ K_box hx1_bd
        exact Finset.mem_biUnion.mpr ⟨(menu j).loc_idx, h_mem_box,
          Finset.mem_filter.mpr ⟨Finset.mem_univ j, rfl⟩⟩
      have h_fib_le : ∀ j₀ ∈ Box_d, (fib_fn j₀).card ≤ S_per_loc := by
        intro j₀ _
        have h1 : (fib_fn j₀).card =
            (@Finset.filter (Fin N_J) (fun j => (menu j).loc_idx = j₀)
              (fun _ => Classical.propDecidable _) Finset.univ).card := by
          dsimp only [fib_fn]
          congr 1
          ext j'
          simp
        have h2 := h_card_loc j₀
        rw [h1]
        exact Nat.cast_le.mp h2
      have h_card_nat : S_d.card ≤ C_J0 * S_per_loc := by
        calc S_d.card
            ≤ (Box_d.biUnion fib_fn).card := Finset.card_le_card h_sub
          _ ≤ Box_d.card * S_per_loc := Finset.card_biUnion_le_card_mul Box_d fib_fn S_per_loc h_fib_le
          _ = C_J0 * S_per_loc := by rw [h_box_card]
      have h_card_d : (S_d.card : ℝ) ≤ B_fib := by
        have hc : (S_d.card : ℝ) ≤ ((C_J0 * S_per_loc : ℕ) : ℝ) := by exact_mod_cast h_card_nat
        simpa [B_fib] using hc
      have h_sum_Sd : ∑ j ∈ S_d, P_JD j d = p_D d := by
        rw [← hPJD_sum_d d]
        dsimp only [S_d]
        rw [Finset.sum_filter]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        by_cases hj : 0 < P_JD j d
        · exact if_pos hj
        · have hj0 : P_JD j d = 0 := le_antisymm (not_lt.mp hj) (hPJD_nn j d)
          rw [if_neg hj, hj0]
      have h_ent_Sd :
          (∑ j : Fin N_J, -(P_JD j d * Real.log (P_JD j d / p_D d))) =
          ∑ j ∈ S_d, -(P_JD j d * Real.log (P_JD j d / p_D d)) := by
        dsimp only [S_d]
        rw [Finset.sum_filter]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        by_cases hj : 0 < P_JD j d
        · exact (if_pos hj).symm
        · have hj0 : P_JD j d = 0 := le_antisymm (not_lt.mp hj) (hPJD_nn j d)
          rw [if_neg hj, hj0, zero_div, Real.log_zero, mul_zero, neg_zero]
      rw [h_ent_Sd]
      have h_pt_j : ∀ j ∈ S_d,
          -(P_JD j d * Real.log (P_JD j d / p_D d)) - P_JD j d * Real.log B_fib ≤
            p_D d / B_fib - P_JD j d := by
        intro j hj
        rw [Finset.mem_filter] at hj
        have hPj : 0 < P_JD j d := hj.2
        let x_j : ℝ := p_D d / (B_fib * P_JD j d)
        have hxj_pos : 0 < x_j := div_pos hpD_pos (mul_pos hB_fib_pos hPj)
        have hlog_xj : Real.log x_j = -Real.log (P_JD j d / p_D d) - Real.log B_fib := by
          dsimp only [x_j]
          rw [Real.log_div hpD_pos.ne' (mul_pos hB_fib_pos hPj).ne',
            Real.log_mul hB_fib_pos.ne' hPj.ne',
            Real.log_div hPj.ne' hpD_pos.ne']
          ring
        have h_sub1 : Real.log x_j ≤ x_j - 1 := Real.log_le_sub_one_of_pos hxj_pos
        have h_mul := mul_le_mul_of_nonneg_left h_sub1 hPj.le
        have h_lhs : P_JD j d * Real.log x_j =
            -(P_JD j d * Real.log (P_JD j d / p_D d)) - P_JD j d * Real.log B_fib := by
          rw [hlog_xj]; ring
        have h_rhs : P_JD j d * (x_j - 1) = p_D d / B_fib - P_JD j d := by
          dsimp only [x_j]
          have hB_ne : B_fib ≠ 0 := hB_fib_pos.ne'
          have hP_ne : P_JD j d ≠ 0 := hPj.ne'
          field_simp [hB_ne, hP_ne]
        linarith only [h_mul, h_lhs, h_rhs]
      have h_sum_ineq := Finset.sum_le_sum h_pt_j
      rw [Finset.sum_sub_distrib, Finset.sum_sub_distrib, ← Finset.sum_mul,
        Finset.sum_const, nsmul_eq_mul, h_sum_Sd] at h_sum_ineq
      have h_card_mul : (S_d.card : ℝ) * (p_D d / B_fib) ≤ p_D d := by
        have h1 := mul_le_mul_of_nonneg_right h_card_d (div_pos hpD_pos hB_fib_pos).le
        rwa [mul_div_cancel₀ _ hB_fib_pos.ne'] at h1
      linarith only [h_sum_ineq, h_card_mul]

  have h_HJD_le :
      (∑ j : Fin N_J, ∑ d : Fin N_D, -(P_JD j d * Real.log (P_JD j d / p_D d))) ≤
        Real.log (C_J0 : ℝ) + Real.log (S_per_loc : ℝ) := by
    rw [Finset.sum_comm]
    calc ∑ d : Fin N_D, ∑ j : Fin N_J, -(P_JD j d * Real.log (P_JD j d / p_D d))
        ≤ ∑ d : Fin N_D, p_D d * Real.log B_fib := Finset.sum_le_sum (fun d _ => h_gibbs_d d)
      _ = (∑ d : Fin N_D, p_D d) * Real.log B_fib := (Finset.sum_mul _ _ _).symm
      _ = Real.log B_fib := by rw [hpD_sum1, one_mul]
      _ = Real.log (C_J0 : ℝ) + Real.log (S_per_loc : ℝ) :=
          Real.log_mul hCJ0_pos.ne' hS_pos.ne'

  have h_HOD_pt1 : ∀ (j : Fin N_J) (o : Fin N_O) (d : Fin N_D),
      π_J j * -(p_cond j o d * Real.log (p_cond j o d / p_cond_D j d)) =
        if win_of o = j then -(p o d * Real.log (p o d / P_JD j d)) else 0 := by
    intro j o d
    by_cases hwo : win_of o = j
    · rw [if_pos hwo]
      rcases eq_or_lt_of_le (hp_nn o d) with hpod0 | hpod_pos
      · rw [← hpod0]
        simp only [zero_div, Real.log_zero, mul_zero, neg_zero]
        dsimp only [p_cond]
        rw [← hpod0, zero_div]
        split_ifs <;> simp
      · have hPJD_pos : 0 < P_JD j d := lt_of_lt_of_le hpod_pos (by rw [← hwo]; exact hp_le_PJD o d)
        have hπ_pos : 0 < π_J j := lt_of_lt_of_le hPJD_pos (hPJD_le_π j d)
        have hpc_eq : p_cond j o d = p o d / π_J j := by
          dsimp only [p_cond]
          exact if_pos ⟨hwo, hπ_pos⟩
        have hpcd_eq : p_cond_D j d = P_JD j d / π_J j := by
          rw [← h_mul_pcond_D j d, mul_div_cancel_left₀ _ hπ_pos.ne']
        have hdiv_eq : (p o d / π_J j) / (P_JD j d / π_J j) = p o d / P_JD j d := by
          have hπ_ne : π_J j ≠ 0 := hπ_pos.ne'
          have hP_ne : P_JD j d ≠ 0 := hPJD_pos.ne'
          field_simp [hπ_ne, hP_ne]
        rw [hpc_eq, hpcd_eq, hdiv_eq]
        have hcancel : π_J j * (p o d / π_J j) = p o d := mul_div_cancel₀ _ hπ_pos.ne'
        calc π_J j * -(p o d / π_J j * Real.log (p o d / P_JD j d))
            = -(π_J j * (p o d / π_J j)) * Real.log (p o d / P_JD j d) := by ring
          _ = -(p o d * Real.log (p o d / P_JD j d)) := by rw [hcancel]; ring
    · rw [if_neg hwo]
      have hpc0 : p_cond j o d = 0 := by
        dsimp only [p_cond]
        exact if_neg (fun hc => hwo hc.1)
      rw [hpc0, zero_div, Real.log_zero, mul_zero, neg_zero, mul_zero]

  have h_HOD_sum1 :
      (∑ j : Fin N_J, π_J j *
        (∑ o : Fin N_O, ∑ d : Fin N_D, -(p_cond j o d * Real.log (p_cond j o d / p_cond_D j d)))) =
      ∑ o : Fin N_O, ∑ d : Fin N_D, -(p o d * Real.log (p o d / P_JD (win_of o) d)) := by
    have h_in : ∀ j : Fin N_J,
        π_J j * (∑ o : Fin N_O, ∑ d : Fin N_D, -(p_cond j o d * Real.log (p_cond j o d / p_cond_D j d))) =
        ∑ o : Fin N_O, ∑ d : Fin N_D,
          if win_of o = j then -(p o d * Real.log (p o d / P_JD j d)) else 0 := by
      intro j
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun o _ => ?_)
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl (fun d _ => h_HOD_pt1 j o d)
    simp_rw [h_in]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun o _ => ?_)
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun d _ => ?_)
    simp [Finset.sum_ite_eq]

  have h_HOD_sum2 :
      (∑ j : Fin N_J, ∑ d : Fin N_D, -(P_JD j d * Real.log (P_JD j d / p_D d))) =
      ∑ o : Fin N_O, ∑ d : Fin N_D, -(p o d * Real.log (P_JD (win_of o) d / p_D d)) := by
    have h_expand : ∀ (j : Fin N_J) (d : Fin N_D),
        -(P_JD j d * Real.log (P_JD j d / p_D d)) =
        ∑ o : Fin N_O, if win_of o = j then -(p o d * Real.log (P_JD j d / p_D d)) else 0 := by
      intro j d
      dsimp only [P_JD]
      rw [Finset.sum_mul, ← Finset.sum_neg_distrib]
      refine Finset.sum_congr rfl (fun o _ => ?_)
      split_ifs <;> ring
    simp_rw [h_expand]
    calc (∑ j : Fin N_J, ∑ d : Fin N_D, ∑ o : Fin N_O,
            if win_of o = j then -(p o d * Real.log (P_JD j d / p_D d)) else 0)
        = ∑ j : Fin N_J, ∑ o : Fin N_O, ∑ d : Fin N_D,
            if win_of o = j then -(p o d * Real.log (P_JD j d / p_D d)) else 0 :=
          Finset.sum_congr rfl (fun _ _ => Finset.sum_comm)
      _ = ∑ o : Fin N_O, ∑ j : Fin N_J, ∑ d : Fin N_D,
            if win_of o = j then -(p o d * Real.log (P_JD j d / p_D d)) else 0 :=
          Finset.sum_comm
      _ = ∑ o : Fin N_O, ∑ d : Fin N_D, ∑ j : Fin N_J,
            if win_of o = j then -(p o d * Real.log (P_JD j d / p_D d)) else 0 :=
          Finset.sum_congr rfl (fun _ _ => Finset.sum_comm)
      _ = ∑ o : Fin N_O, ∑ d : Fin N_D, -(p o d * Real.log (P_JD (win_of o) d / p_D d)) := by
          refine Finset.sum_congr rfl (fun o _ => Finset.sum_congr rfl (fun d _ => ?_))
          simp [Finset.sum_ite_eq]

  have h_HOD_split :
      (∑ o : Fin N_O, ∑ d : Fin N_D, -(p o d * Real.log (p o d / p_D d))) =
      (∑ j : Fin N_J, π_J j *
        (∑ o : Fin N_O, ∑ d : Fin N_D, -(p_cond j o d * Real.log (p_cond j o d / p_cond_D j d)))) +
      (∑ j : Fin N_J, ∑ d : Fin N_D, -(P_JD j d * Real.log (P_JD j d / p_D d))) := by
    rw [h_HOD_sum1, h_HOD_sum2, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun o _ => ?_)
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun d _ => ?_)
    rcases eq_or_lt_of_le (hp_nn o d) with hpod0 | hpod_pos
    · rw [← hpod0]
      simp
    · have hPJD_pos : 0 < P_JD (win_of o) d := lt_of_lt_of_le hpod_pos (hp_le_PJD o d)
      have hpD_pos : 0 < p_D d := lt_of_lt_of_le hpod_pos (hp_le_pD o d)
      have h_div_mul : (p o d / P_JD (win_of o) d) * (P_JD (win_of o) d / p_D d) = p o d / p_D d :=
        div_mul_div_cancel₀ hPJD_pos.ne'
      have h1_ne : p o d / P_JD (win_of o) d ≠ 0 := (div_pos hpod_pos hPJD_pos).ne'
      have h2_ne : P_JD (win_of o) d / p_D d ≠ 0 := (div_pos hPJD_pos hpD_pos).ne'
      rw [← h_div_mul, Real.log_mul h1_ne h2_ne]
      ring

  have h_HOD_le :
      (1 / 2 : ℝ) * ((∑ o : Fin N_O, ∑ d : Fin N_D, -(p o d * Real.log (p o d / p_D d))) / ell) ≤
      (∑ j : Fin N_J, π_J j *
        ((1 / 2 : ℝ) * ((∑ o : Fin N_O, ∑ d : Fin N_D,
          -(p_cond j o d * Real.log (p_cond j o d / p_cond_D j d))) / ell))) +
      (1 / 2 : ℝ) * (Real.log (S_per_loc : ℝ) / ell) + ((1 / 2 : ℝ) * Real.log (C_J0 : ℝ)) / ell := by
    have h_num_le :
        (∑ o : Fin N_O, ∑ d : Fin N_D, -(p o d * Real.log (p o d / p_D d))) ≤
        (∑ j : Fin N_J, π_J j *
          (∑ o : Fin N_O, ∑ d : Fin N_D, -(p_cond j o d * Real.log (p_cond j o d / p_cond_D j d)))) +
        (Real.log (C_J0 : ℝ) + Real.log (S_per_loc : ℝ)) := by
      linarith [h_HOD_split, h_HJD_le]
    have h_div := div_le_div_of_nonneg_right h_num_le hell_pos.le
    have h_mul12 := mul_le_mul_of_nonneg_left h_div (by norm_num : (0 : ℝ) ≤ 1 / 2)
    have h_rhs_eq :
        (1 / 2 : ℝ) * (((∑ j : Fin N_J, π_J j *
          (∑ o : Fin N_O, ∑ d : Fin N_D, -(p_cond j o d * Real.log (p_cond j o d / p_cond_D j d)))) +
          (Real.log (C_J0 : ℝ) + Real.log (S_per_loc : ℝ))) / ell) =
        (∑ j : Fin N_J, π_J j *
          ((1 / 2 : ℝ) * ((∑ o : Fin N_O, ∑ d : Fin N_D,
            -(p_cond j o d * Real.log (p_cond j o d / p_cond_D j d))) / ell))) +
        (1 / 2 : ℝ) * (Real.log (S_per_loc : ℝ) / ell) + ((1 / 2 : ℝ) * Real.log (C_J0 : ℝ)) / ell := by
      rw [add_div, mul_add, Finset.sum_div, Finset.mul_sum]
      have h_sum_rw :
          (∑ j : Fin N_J, (1 / 2 : ℝ) * (π_J j *
            (∑ o : Fin N_O, ∑ d : Fin N_D, -(p_cond j o d * Real.log (p_cond j o d / p_cond_D j d))) / ell)) =
          ∑ j : Fin N_J, π_J j * ((1 / 2 : ℝ) *
            ((∑ o : Fin N_O, ∑ d : Fin N_D, -(p_cond j o d * Real.log (p_cond j o d / p_cond_D j d))) / ell)) :=
        Finset.sum_congr rfl (fun j _ => by ring)
      rw [h_sum_rw]
      ring
    linarith

  refine ⟨hπ_nn, hπ_sum1, hp_cond_props, ?_⟩
  let score_j : Fin N_J → ℝ := fun j =>
    (∑ o : Fin N_O, -(p_cond_O j o * Real.log (p_cond_O j o))) / ell +
    (1 / 2 : ℝ) * ((∑ o : Fin N_O, ∑ d : Fin N_D,
      -(p_cond j o d * Real.log (p_cond j o d / p_cond_D j d))) / ell) +
    (3 / 2 : ℝ) * ((∑ o : Fin N_O, p_cond_O j o * Real.log (m_site j o)) / ell) +
    (1 / 2 : ℝ) * (∑ d : Fin N_D, p_cond_D j d * pktWeight γ (b_D d - b_star) (a_D d - b_star))
  have h_jsum_eq :
      (∑ j : Fin N_J, @ite ℝ (0 < π_J j) (Classical.propDecidable _) (π_J j * score_j j) 0) =
      (∑ j : Fin N_J, π_J j * ((∑ o : Fin N_O, -(p_cond_O j o * Real.log (p_cond_O j o))) / ell)) +
      (∑ j : Fin N_J, π_J j * ((1 / 2 : ℝ) * ((∑ o : Fin N_O, ∑ d : Fin N_D,
        -(p_cond j o d * Real.log (p_cond j o d / p_cond_D j d))) / ell))) +
      (∑ j : Fin N_J, π_J j * ((3 / 2 : ℝ) * ((∑ o : Fin N_O, p_cond_O j o * Real.log (m_site j o)) / ell))) +
      (∑ j : Fin N_J, π_J j * ((1 / 2 : ℝ) * (∑ d : Fin N_D,
        p_cond_D j d * pktWeight γ (b_D d - b_star) (a_D d - b_star)))) := by
    have h_step : ∀ j : Fin N_J,
        @ite ℝ (0 < π_J j) (Classical.propDecidable _) (π_J j * score_j j) 0 = π_J j * score_j j :=
      fun j => @h_ite_pi score_j j (Classical.propDecidable _)
    simp_rw [h_step]
    rw [← Finset.sum_add_distrib, ← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    dsimp only [score_j]
    ring
  have h_const_eq :
      ((1 / 2 : ℝ) * Real.log (C_J0 : ℝ)) / ell + ((3 / 2 : ℝ) * Real.log 16) / ell =
      C_split / ell := by
    dsimp only [C_split]
    ring
  have h_score_def :
      generalPacketScore ε γ H_P t lam_sys m_t Φ₀ f N_O N_D r_O V_O X_O ψ_O b_D a_D p =
      (∑ o : Fin N_O, -(p_O o * Real.log (p_O o))) / ell +
      (1 / 2 : ℝ) * ((∑ o : Fin N_O, ∑ d : Fin N_D, -(p o d * Real.log (p o d / p_D d))) / ell) +
      (3 / 2 : ℝ) * ((∑ o : Fin N_O, p_O o * Real.log (m_f o)) / ell) +
      (1 / 2 : ℝ) * (∑ d : Fin N_D, p_D d * ((1 + γ) * b_D d + (1 - γ) * a_D d)) := rfl
  change generalPacketScore ε γ H_P t lam_sys m_t Φ₀ f N_O N_D r_O V_O X_O ψ_O b_D a_D p ≤
      H_J + b_star + (∑ j : Fin N_J, @ite ℝ (0 < π_J j) (Classical.propDecidable _) (π_J j * score_j j) 0) +
      (7 / 2 : ℝ) * (Real.log (S_per_loc : ℝ) / ell) + C_split / ell
  linarith [h_score_def, h_HO_eq, h_HOD_le, h_Emass_le, h_Ew_eq, h_jsum_eq, h_const_eq]

theorem single_localizer_b1_entropy_cancellation (ε h ζ_sh ξ θ k_out m_bin C_coh_tot : ℝ)
    (d_dim M_L m_r m_t N_O N_D N_ret : ℕ)
    (r_O : Fin N_O → ℕ)
    (p_cond : Fin N_O → Fin N_D → ℝ)
    (Q_of : Fin N_O → (ℕ × (ℤ × ℤ) × (ℤ × ℤ)) × ℕ × (ℤ × ℤ))
    (Z_of : Fin N_O → ((ℕ × (ℤ × ℤ) × (ℤ × ℤ)) × ℕ × (ℤ × ℤ)) × (ℤ × ℤ))
    (T_cand : ((ℕ × (ℤ × ℤ) × (ℤ × ℤ)) × ℕ × (ℤ × ℤ)) → Finset (Fin N_ret))
    (m_site : Fin N_O → ℝ)
    (hε₀ : 0 < ε) (hε₁ : ε < 1 / 4)
    (hML : 1 ≤ M_L) (hC_coh : 1 ≤ C_coh_tot) (hm_bin : 0 < m_bin)
    (hp_nn : ∀ o d, 0 ≤ p_cond o d)
    (hp_sum : ∑ o : Fin N_O, ∑ d : Fin N_D, p_cond o d = 1) :
    letI := Classical.propDecidable
    let ell := Real.log (ε⁻¹)
    let p_O := fun o : Fin N_O => ∑ d : Fin N_D, p_cond o d
    let p_D := fun d : Fin N_D => ∑ o : Fin N_O, p_cond o d
    let S_act := Finset.univ.filter (fun o : Fin N_O => 0 < p_O o)
    (∀ o ∈ S_act,
      (Z_of o).1 = Q_of o ∧
      (Q_of o).2.1 = r_O o % 2 ^ (m_t - m_r) ∧
      0 < m_site o ∧
      (T_cand (Q_of o)).Nonempty) →
    (∀ q, ∑ o ∈ S_act.filter (fun o => Q_of o = q), m_site o ≤
      C_coh_tot * ε ^ (-ξ) * ((T_cand q).card : ℝ) * m_bin) →
    (∀ z, ∑ o ∈ S_act.filter (fun o => Z_of o = z), m_site o ≤
      C_coh_tot * ((M_L ^ 4 : ℕ) : ℝ) *
        ε ^ ((d_dim : ℝ) * h - k_out - 2 * θ - 2 * ξ) *
        ((T_cand z.1).card : ℝ) * m_bin) →
    (∀ (α : Fin N_ret) (r_loc : ℕ),
      (((S_act.image Q_of).filter (fun q =>
        q.2.1 = r_loc ∧ α ∈ T_cand q)).card : ℝ) ≤ C_coh_tot * ε ^ (-2 * θ)) →
    (∀ (α : Fin N_ret) (d : Fin N_D),
      0 < p_D d →
      (((S_act.filter (fun o => 0 < p_cond o d ∧ α ∈ T_cand (Q_of o))).image
        Z_of).card : ℝ) ≤ C_coh_tot * ε ^ (-2 * θ - ζ_sh)) →
    let q_cand : Fin N_O → Fin N_D → Fin N_ret → ℝ := fun o d α =>
      if α ∈ T_cand (Q_of o) then p_cond o d / ((T_cand (Q_of o)).card : ℝ) else 0
    let q_T := fun α => ∑ o, ∑ d, q_cand o d α
    let q_TD := fun α d => ∑ o, q_cand o d α
    let q_D := fun d => ∑ o, ∑ α, q_cand o d α
    let q_TR := fun α (rl : Fin (2 ^ (m_t - m_r))) =>
      ∑ o ∈ Finset.univ.filter (fun o => r_O o % 2 ^ (m_t - m_r) = rl.1),
        ∑ d, q_cand o d α
    q_D = p_D ∧
    (∑ o : Fin N_O, -(p_O o * Real.log (p_O o))) / ell +
    (1 / 2 : ℝ) * ((∑ o : Fin N_O, ∑ d : Fin N_D,
      -(p_cond o d * Real.log (p_cond o d / p_D d))) / ell) +
    (3 / 2 : ℝ) * ((∑ o : Fin N_O, p_O o * Real.log (m_site o)) / ell) ≤
    (∑ α : Fin N_ret, -(q_T α * Real.log (q_T α))) / ell +
    (3 / 2 : ℝ) * (Real.log m_bin / ell) +
    (1 / 2 : ℝ) * (
      (∑ α : Fin N_ret, ∑ d : Fin N_D, -(q_TD α d * Real.log (q_TD α d / q_D d))) / ell +
      2 * ((∑ α : Fin N_ret, ∑ rl : Fin (2 ^ (m_t - m_r)),
        -(q_TR α rl * Real.log (q_TR α rl / q_T α))) / ell) +
      k_out - (d_dim : ℝ) * h) +
    4 * θ + 2 * ξ + (1 / 2 : ℝ) * ζ_sh +
    (3 * Real.log C_coh_tot + 2 * Real.log (M_L : ℝ)) / ell :=
by
  
  
  
  
  have hell_pos_raw : 0 < Real.log (ε⁻¹) :=
    Real.log_pos ((one_lt_inv₀ hε₀).mpr (by linarith only [hε₁]))
  have hlog_eps : Real.log ε = -Real.log (ε⁻¹) := by
    rw [Real.log_inv]; ring
  have hlog_rpow : ∀ e : ℝ, Real.log (ε ^ e) = -e * Real.log (ε⁻¹) := by
    intro e
    rw [Real.log_rpow hε₀ e, hlog_eps]
    ring
  have hC_coh_pos : 0 < C_coh_tot := lt_of_lt_of_le zero_lt_one hC_coh
  have hML_pos : 0 < (M_L : ℝ) :=
    Nat.cast_pos.mpr (Nat.lt_of_lt_of_le Nat.zero_lt_one hML)
  have hML4_cast : ((M_L ^ 4 : ℕ) : ℝ) = (M_L : ℝ) ^ 4 := Nat.cast_pow M_L 4
  have hML4_pos : 0 < ((M_L ^ 4 : ℕ) : ℝ) := by
    rw [hML4_cast]; exact pow_pos hML_pos 4
  have hlog_ML4 : Real.log (((M_L ^ 4 : ℕ) : ℝ)) = 4 * Real.log (M_L : ℝ) := by
    rw [hML4_cast, Real.log_pow]
    push_cast
    ring
  have h_two_pow_pos : 0 < 2 ^ (m_t - m_r) := Nat.two_pow_pos (m_t - m_r)

  have h_sum_fib_maps_to : ∀ {α β : Type} [DecidableEq β]
      (S : Finset α) (T : Finset β) (g : α → β) (f : α → ℝ)
      (dec : ∀ b : β, DecidablePred (fun a : α => g a = b)),
      (∀ a ∈ S, g a ∈ T) →
      (∑ b ∈ T, ∑ a ∈ @Finset.filter α (fun a => g a = b) (dec b) S, f a) =
        ∑ a ∈ S, f a := by
    intro α β _ S T g f dec hmaps
    rw [← Finset.sum_fiberwise_of_maps_to hmaps f]
    refine Finset.sum_congr rfl (fun b _ => ?_)
    refine Finset.sum_congr ?_ (fun _ _ => rfl)
    ext a
    simp only [Finset.mem_filter]

  have h_ite_sum : ∀ {α : Type} (S : Finset α) (P : Prop) (dec : Decidable P)
      (u : α → ℝ) (C : ℝ),
      (∑ a ∈ S, @ite ℝ P dec (u a / C) 0) = @ite ℝ P dec ((∑ a ∈ S, u a) / C) 0 := by
    intro α S P dec u C
    by_cases hP : P <;> simp [hP, Finset.sum_div]

  have h_ent_split : ∀ {u v w : ℝ}, 0 ≤ u → (0 < u → 0 < v) → (0 < u → 0 < w) →
      -(u * Real.log (u / w)) = -(u * Real.log (u / v)) + -(u * Real.log (v / w)) := by
    intro u v w hu hv hw
    by_cases hu0 : u = 0
    · simp [hu0]
    · have hu_pos : 0 < u := lt_of_le_of_ne hu (Ne.symm hu0)
      have hv_pos : 0 < v := hv hu_pos
      have hw_pos : 0 < w := hw hu_pos
      have hprod : u / w = (u / v) * (v / w) := by
        field_simp [hv_pos.ne', hw_pos.ne']
      rw [hprod, Real.log_mul (div_pos hu_pos hv_pos).ne' (div_pos hv_pos hw_pos).ne']
      ring

  have h_sum_ent_split : ∀ {α : Type} (S : Finset α) (u : α → ℝ) (U w : ℝ),
      (∀ i ∈ S, 0 ≤ u i) → (∑ i ∈ S, u i = U) → (∀ i ∈ S, 0 < u i → 0 < w) →
      (∑ i ∈ S, -(u i * Real.log (u i / w))) =
        (∑ i ∈ S, -(u i * Real.log (u i / U))) + -(U * Real.log (U / w)) := by
    intro α S u U w hu_nn hU hw
    have hcongr : (∑ i ∈ S, -(u i * Real.log (u i / w))) =
        ∑ i ∈ S, (-(u i * Real.log (u i / U)) + -(u i * Real.log (U / w))) := by
      refine Finset.sum_congr rfl (fun i hi => ?_)
      refine h_ent_split (hu_nn i hi) (fun hui => ?_) (hw i hi)
      rw [← hU]
      exact lt_of_lt_of_le hui (Finset.single_le_sum hu_nn hi)
    rw [hcongr, Finset.sum_add_distrib]
    congr 1
    rw [Finset.sum_neg_distrib, ← Finset.sum_mul, hU]

  have h_sum_ent_split_one : ∀ {α : Type} (S : Finset α) (u : α → ℝ) (U : ℝ),
      (∀ i ∈ S, 0 ≤ u i) → (∑ i ∈ S, u i = U) →
      (∑ i ∈ S, -(u i * Real.log (u i))) =
        (∑ i ∈ S, -(u i * Real.log (u i / U))) + -(U * Real.log U) := by
    intro α S u U hu_nn hU
    simpa only [div_one] using h_sum_ent_split S u U 1 hu_nn hU (fun _ _ _ => zero_lt_one)

  have h_gibbs : ∀ {α : Type} (S : Finset α) (u w : α → ℝ) (U B : ℝ),
      (∀ i ∈ S, 0 ≤ u i) → (∑ i ∈ S, u i = U) → 0 < B →
      (∀ i ∈ S, 0 ≤ w i) → (∀ i ∈ S, 0 < u i → 0 < w i) → (∑ i ∈ S, w i ≤ B) →
      (∑ i ∈ S, (-(u i * Real.log (u i / U)) + u i * Real.log (w i))) ≤ U * Real.log B := by
    intro α S u w U B hu_nn hU hB_pos hw_nn hw_pos hw_sum
    have hU_nn : 0 ≤ U := by rw [← hU]; exact Finset.sum_nonneg hu_nn
    by_cases hU0 : U = 0
    · have hu0 : ∀ i ∈ S, u i = 0 :=
        (Finset.sum_eq_zero_iff_of_nonneg hu_nn).mp (hU.trans hU0)
      rw [hU0, zero_mul, Finset.sum_eq_zero (fun i hi => by simp [hu0 i hi])]
    · have hU_pos : 0 < U := lt_of_le_of_ne hU_nn (Ne.symm hU0)
      have hpt : ∀ i ∈ S,
          (-(u i * Real.log (u i / U)) + u i * Real.log (w i)) - u i * Real.log B ≤
            U * (w i / B) - u i := by
        intro i hi
        by_cases hui0 : u i = 0
        · rw [hui0]
          simp only [zero_div, zero_mul, neg_zero, add_zero, sub_zero]
          exact mul_nonneg hU_nn (div_nonneg (hw_nn i hi) hB_pos.le)
        · have hui_pos : 0 < u i := lt_of_le_of_ne (hu_nn i hi) (Ne.symm hui0)
          have hwi_pos : 0 < w i := hw_pos i hi hui_pos
          let x := (w i / B) / (u i / U)
          have hx_pos : 0 < x := div_pos (div_pos hwi_pos hB_pos) (div_pos hui_pos hU_pos)
          have hlog : Real.log x = Real.log (w i) - Real.log B - Real.log (u i / U) := by
            dsimp only [x]
            rw [Real.log_div (div_pos hwi_pos hB_pos).ne' (div_pos hui_pos hU_pos).ne',
              Real.log_div hwi_pos.ne' hB_pos.ne']
          have h1 := mul_le_mul_of_nonneg_left (Real.log_le_sub_one_of_pos hx_pos) hui_pos.le
          have hlhs : u i * Real.log x =
              (-(u i * Real.log (u i / U)) + u i * Real.log (w i)) - u i * Real.log B := by
            rw [hlog]; ring
          have hrhs : u i * (x - 1) = U * (w i / B) - u i := by
            dsimp only [x]
            field_simp [hui_pos.ne', hU_pos.ne', hB_pos.ne']
          rwa [hlhs, hrhs] at h1
      have hsum := Finset.sum_le_sum hpt
      rw [Finset.sum_sub_distrib, ← Finset.sum_mul, hU,
        Finset.sum_sub_distrib, ← Finset.mul_sum, ← Finset.sum_div, hU] at hsum
      have hdiv : (∑ i ∈ S, w i) / B ≤ 1 := (div_le_one hB_pos).mpr hw_sum
      have hmul : U * ((∑ i ∈ S, w i) / B) ≤ U * 1 := mul_le_mul_of_nonneg_left hdiv hU_nn
      linarith only [hsum, hmul]

  have h_gibbs_chain : ∀ {α : Type} (S : Finset α) (u w : α → ℝ) (U v_den B : ℝ),
      (∀ i ∈ S, 0 ≤ u i) → (∑ i ∈ S, u i = U) → (∀ i ∈ S, 0 < u i → 0 < v_den) →
      0 < B → (∀ i ∈ S, 0 ≤ w i) → (∀ i ∈ S, 0 < u i → 0 < w i) → (∑ i ∈ S, w i ≤ B) →
      (∑ i ∈ S, (-(u i * Real.log (u i / v_den)) + u i * Real.log (w i))) ≤
        -(U * Real.log (U / v_den)) + U * Real.log B := by
    intro α S u w U v_den B hu_nn hU hv hB_pos hw_nn hw_pos hw_sum
    rw [Finset.sum_add_distrib, h_sum_ent_split S u U v_den hu_nn hU hv]
    have hg := h_gibbs S u w U B hu_nn hU hB_pos hw_nn hw_pos hw_sum
    rw [Finset.sum_add_distrib] at hg
    linarith only [hg]

  have h_gibbs_chain_one : ∀ {α : Type} (S : Finset α) (u w : α → ℝ) (U B : ℝ),
      (∀ i ∈ S, 0 ≤ u i) → (∑ i ∈ S, u i = U) →
      0 < B → (∀ i ∈ S, 0 ≤ w i) → (∀ i ∈ S, 0 < u i → 0 < w i) → (∑ i ∈ S, w i ≤ B) →
      (∑ i ∈ S, (-(u i * Real.log (u i)) + u i * Real.log (w i))) ≤
        -(U * Real.log U) + U * Real.log B := by
    intro α S u w U B hu_nn hU hB_pos hw_nn hw_pos hw_sum
    simpa only [div_one] using h_gibbs_chain S u w U 1 B hu_nn hU
      (fun _ _ _ => zero_lt_one) hB_pos hw_nn hw_pos hw_sum

  have h_card_ent : ∀ {α : Type} (S : Finset α) (u : α → ℝ) (U K : ℝ),
      (∀ i ∈ S, 0 ≤ u i) → (∑ i ∈ S, u i = U) → 0 < K → (S.card : ℝ) ≤ K →
      (∑ i ∈ S, -(u i * Real.log (u i / U))) ≤ U * Real.log K := by
    intro α S u U K hu_nn hU hK_pos hcard
    have hg := h_gibbs S u (fun _ => (1 : ℝ)) U K hu_nn hU hK_pos
      (fun _ _ => zero_le_one) (fun _ _ _ => zero_lt_one)
      (by simp only [Finset.sum_const, nsmul_eq_mul, mul_one]; exact hcard)
    simpa only [Real.log_one, mul_zero, add_zero] using hg

  have h_supp_card_ent : ∀ {α : Type} (S₀ S : Finset α) (u : α → ℝ) (U K : ℝ),
      S ⊆ S₀ → (∀ i ∈ S₀, 0 ≤ u i) → (∑ i ∈ S₀, u i = U) →
      (∀ i ∈ S₀, 0 < u i → i ∈ S) → 0 < K → (0 < U → (S.card : ℝ) ≤ K) →
      (∑ i ∈ S₀, -(u i * Real.log (u i / U))) ≤ U * Real.log K := by
    intro α S₀ S u U K hsub hu_nn hU hsupp hK_pos hcard
    have hU_nn : 0 ≤ U := by rw [← hU]; exact Finset.sum_nonneg hu_nn
    by_cases hU0 : U = 0
    · have hu0 : ∀ i ∈ S₀, u i = 0 :=
        (Finset.sum_eq_zero_iff_of_nonneg hu_nn).mp (hU.trans hU0)
      rw [hU0, zero_mul, Finset.sum_eq_zero (fun i hi => by simp [hu0 i hi])]
    · have hU_pos : 0 < U := lt_of_le_of_ne hU_nn (Ne.symm hU0)
      have hzero_out : ∀ i ∈ S₀, i ∉ S → u i = 0 := by
        intro i hi₀ hiS
        by_contra hne
        exact hiS (hsupp i hi₀ (lt_of_le_of_ne (hu_nn i hi₀) (Ne.symm hne)))
      have hU_S : ∑ i ∈ S, u i = U := by
        rw [← hU]
        exact Finset.sum_subset hsub hzero_out
      have hent_S : (∑ i ∈ S, -(u i * Real.log (u i / U))) =
          ∑ i ∈ S₀, -(u i * Real.log (u i / U)) :=
        Finset.sum_subset hsub (fun i hi₀ hiS => by simp [hzero_out i hi₀ hiS])
      rw [← hent_S]
      exact h_card_ent S u U K (fun i hi => hu_nn i (hsub hi)) hU_S hK_pos (hcard hU_pos)

  have h_supp_card_chain : ∀ {α : Type} (S₀ S : Finset α) (u : α → ℝ) (U v_den K : ℝ),
      S ⊆ S₀ → (∀ i ∈ S₀, 0 ≤ u i) → (∑ i ∈ S₀, u i = U) →
      (∀ i ∈ S₀, 0 < u i → 0 < v_den) →
      (∀ i ∈ S₀, 0 < u i → i ∈ S) → 0 < K → (0 < U → (S.card : ℝ) ≤ K) →
      (∑ i ∈ S₀, -(u i * Real.log (u i / v_den))) ≤
        -(U * Real.log (U / v_den)) + U * Real.log K := by
    intro α S₀ S u U v_den K hsub hu_nn hU hv hsupp hK_pos hcard
    rw [h_sum_ent_split S₀ u U v_den hu_nn hU hv]
    have hs := h_supp_card_ent S₀ S u U K hsub hu_nn hU hsupp hK_pos hcard
    linarith only [hs]

  have h_supp_card_chain_one : ∀ {α : Type} (S₀ S : Finset α) (u : α → ℝ) (U K : ℝ),
      S ⊆ S₀ → (∀ i ∈ S₀, 0 ≤ u i) → (∑ i ∈ S₀, u i = U) →
      (∀ i ∈ S₀, 0 < u i → i ∈ S) → 0 < K → (0 < U → (S.card : ℝ) ≤ K) →
      (∑ i ∈ S₀, -(u i * Real.log (u i))) ≤
        -(U * Real.log U) + U * Real.log K := by
    intro α S₀ S u U K hsub hu_nn hU hsupp hK_pos hcard
    simpa only [div_one] using h_supp_card_chain S₀ S u U 1 K hsub hu_nn hU
      (fun _ _ _ => zero_lt_one) hsupp hK_pos hcard

  have h_ite_card : ∀ {N : ℕ} (T : Finset (Fin N)) (c : ℝ)
      (dec : DecidablePred (fun α : Fin N => α ∈ T)),
      (∑ α : Fin N, @ite ℝ (α ∈ T) (dec α) c 0) = (T.card : ℝ) * c := by
    intro N T c dec
    rw [← Finset.sum_subset (Finset.subset_univ T) (fun α _ hα => by simp [hα])]
    have hcongr : (∑ α ∈ T, @ite ℝ (α ∈ T) (dec α) c 0) = ∑ _α ∈ T, c :=
      Finset.sum_congr rfl (fun α hα => by simp [hα])
    rw [hcongr, Finset.sum_const, nsmul_eq_mul]

  have h_unif_sum : ∀ {N : ℕ} (T : Finset (Fin N)) (U : ℝ)
      (dec : DecidablePred (fun α : Fin N => α ∈ T)),
      0 ≤ U → (0 < U → T.Nonempty) →
      (∑ α : Fin N, @ite ℝ (α ∈ T) (dec α) (U / (T.card : ℝ)) 0) = U := by
    intro N T U dec hU_nn hne
    rw [h_ite_card]
    by_cases hU0 : U = 0
    · simp [hU0]
    · have hU_pos : 0 < U := lt_of_le_of_ne hU_nn (Ne.symm hU0)
      have hcard_pos : 0 < (T.card : ℝ) := Nat.cast_pos.mpr (Finset.card_pos.mpr (hne hU_pos))
      exact mul_div_cancel₀ U hcard_pos.ne'

  have h_unif_ent : ∀ {N : ℕ} (T : Finset (Fin N)) (U w : ℝ)
      (dec : DecidablePred (fun α : Fin N => α ∈ T)),
      0 ≤ U → (0 < U → T.Nonempty) → (0 < U → 0 < w) →
      let f := fun α : Fin N => @ite ℝ (α ∈ T) (dec α) (U / (T.card : ℝ)) 0
      (∑ α : Fin N, -(f α * Real.log (f α / w))) =
        -(U * Real.log (U / w)) + U * Real.log (T.card : ℝ) := by
    intro N T U w dec hU_nn hne hw f
    by_cases hU0 : U = 0
    · have hf0 : ∀ α : Fin N, f α = 0 := by
        intro α; dsimp only [f]; rw [hU0, zero_div, ite_self]
      simp [hf0, hU0]
    · have hU_pos : 0 < U := lt_of_le_of_ne hU_nn (Ne.symm hU0)
      have hcard_pos : 0 < (T.card : ℝ) := Nat.cast_pos.mpr (Finset.card_pos.mpr (hne hU_pos))
      have hw_pos : 0 < w := hw hU_pos
      let c := -((U / (T.card : ℝ)) * Real.log ((U / (T.card : ℝ)) / w))
      have hcongr : (∑ α : Fin N, -(f α * Real.log (f α / w))) =
          ∑ α : Fin N, @ite ℝ (α ∈ T) (dec α) c 0 := by
        refine Finset.sum_congr rfl (fun α _ => ?_)
        dsimp only [f, c]
        by_cases hα : α ∈ T <;> simp [hα]
      rw [hcongr, h_ite_card]
      dsimp only [c]
      have hdiv_eq : (U / (T.card : ℝ)) / w = (U / w) / (T.card : ℝ) := by
        rw [div_div, mul_comm (T.card : ℝ) w, ← div_div]
      rw [hdiv_eq, Real.log_div (div_pos hU_pos hw_pos).ne' hcard_pos.ne']
      have hmul : (T.card : ℝ) * (U / (T.card : ℝ)) = U := mul_div_cancel₀ U hcard_pos.ne'
      calc (T.card : ℝ) * -((U / (T.card : ℝ)) * (Real.log (U / w) - Real.log (T.card : ℝ)))
          = -(((T.card : ℝ) * (U / (T.card : ℝ))) * (Real.log (U / w) - Real.log (T.card : ℝ))) := by ring
        _ = -(U * (Real.log (U / w) - Real.log (T.card : ℝ))) := by rw [hmul]
        _ = -(U * Real.log (U / w)) + U * Real.log (T.card : ℝ) := by ring

  have h_unif_ent_one : ∀ {N : ℕ} (T : Finset (Fin N)) (U : ℝ)
      (dec : DecidablePred (fun α : Fin N => α ∈ T)),
      0 ≤ U → (0 < U → T.Nonempty) →
      let f := fun α : Fin N => @ite ℝ (α ∈ T) (dec α) (U / (T.card : ℝ)) 0
      (∑ α : Fin N, -(f α * Real.log (f α))) =
        -(U * Real.log U) + U * Real.log (T.card : ℝ) := by
    intro N T U dec hU_nn hne f
    simpa only [div_one] using h_unif_ent T U 1 dec hU_nn hne (fun _ => zero_lt_one)

  
  
  
  letI := Classical.propDecidable
  intro ell p_O p_D S_act h_act hQ_sum hZ_sum hQ_card hZ_card q_cand q_T q_TD q_D q_TR
  have hell_pos : 0 < ell := hell_pos_raw
  have hell_nn : 0 ≤ ell := hell_pos.le

  have hpO_nn : ∀ o : Fin N_O, 0 ≤ p_O o :=
    fun o => Finset.sum_nonneg (fun d _ => hp_nn o d)
  have hpD_nn : ∀ d : Fin N_D, 0 ≤ p_D d :=
    fun d => Finset.sum_nonneg (fun o _ => hp_nn o d)
  have hpD_sum : ∑ d : Fin N_D, p_D d = 1 :=
    Finset.sum_comm.trans hp_sum

  have hmem_Sact_of_p_pos : ∀ {o : Fin N_O} {d : Fin N_D}, 0 < p_cond o d → o ∈ S_act := by
    intro o d hpos
    exact Finset.mem_filter.mpr ⟨Finset.mem_univ o,
      lt_of_lt_of_le hpos (Finset.single_le_sum (fun d' _ => hp_nn o d') (Finset.mem_univ d))⟩

  have hpD_pos_of_p_pos : ∀ {o : Fin N_O} {d : Fin N_D}, 0 < p_cond o d → 0 < p_D d := by
    intro o d hpos
    exact lt_of_lt_of_le hpos (Finset.single_le_sum (fun o' _ => hp_nn o' d) (Finset.mem_univ o))

  have hpO_zero_of_not_mem : ∀ {o : Fin N_O}, o ∉ S_act → p_O o = 0 := by
    intro o ho
    have hnot : ¬ (0 < p_O o) :=
      fun hpos => ho (Finset.mem_filter.mpr ⟨Finset.mem_univ o, hpos⟩)
    exact le_antisymm (not_lt.mp hnot) (hpO_nn o)

  have hp_zero_of_not_mem : ∀ {o : Fin N_O}, o ∉ S_act → ∀ d : Fin N_D, p_cond o d = 0 := by
    intro o ho d
    exact (Finset.sum_eq_zero_iff_of_nonneg (fun d' _ => hp_nn o d')).mp
      (hpO_zero_of_not_mem ho) d (Finset.mem_univ d)

  have hqc_zero_of_not_mem :
      ∀ {o : Fin N_O}, o ∉ S_act → ∀ (d : Fin N_D) (α : Fin N_ret), q_cand o d α = 0 := by
    intro o ho d α
    dsimp only [q_cand]
    rw [hp_zero_of_not_mem ho d, zero_div, ite_self]

  have hqc_sum_α : ∀ (o : Fin N_O) (d : Fin N_D),
      (∑ α : Fin N_ret, q_cand o d α) = p_cond o d :=
    fun o d => h_unif_sum (T_cand (Q_of o)) (p_cond o d) _ (hp_nn o d)
      (fun hpos => (h_act o (hmem_Sact_of_p_pos hpos)).2.2.2)

  have hqD_eq : q_D = p_D :=
    funext (fun d => Finset.sum_congr rfl (fun o _ => hqc_sum_α o d))

  have hqc_nn : ∀ o d α, 0 ≤ q_cand o d α := by
    intro o d α
    dsimp only [q_cand]
    split_ifs
    · exact div_nonneg (hp_nn o d) (Nat.cast_nonneg _)
    · exact le_rfl

  have hqTD_nn : ∀ α d, 0 ≤ q_TD α d :=
    fun α d => Finset.sum_nonneg (fun o _ => hqc_nn o d α)
  have hqT_nn : ∀ α, 0 ≤ q_T α :=
    fun α => Finset.sum_nonneg (fun o _ => Finset.sum_nonneg (fun d _ => hqc_nn o d α))
  have hqTR_nn : ∀ α rl, 0 ≤ q_TR α rl :=
    fun α rl => Finset.sum_nonneg (fun o _ => Finset.sum_nonneg (fun d _ => hqc_nn o d α))

  let S_Q := S_act.image Q_of
  let S_Z := S_act.image Z_of
  let F_z := fun z => S_act.filter (fun o => Z_of o = z)
  let H_q := fun q => S_act.filter (fun o => Q_of o = q)
  let G_q := fun q => S_Z.filter (fun z => z.1 = q)
  let p_Z := fun z => ∑ o ∈ F_z z, p_O o
  let p_ZD := fun z (d : Fin N_D) => ∑ o ∈ F_z z, p_cond o d
  let m_Z := fun z => ∑ o ∈ F_z z, m_site o
  let p_Q := fun q => ∑ z ∈ G_q q, p_Z z
  let q_QT := fun q (α : Fin N_ret) =>
    if α ∈ T_cand q then p_Q q / ((T_cand q).card : ℝ) else 0
  let q_ZTD := fun z (d : Fin N_D) (α : Fin N_ret) =>
    if α ∈ T_cand z.1 then p_ZD z d / ((T_cand z.1).card : ℝ) else 0

  have hpZ_nn : ∀ z, 0 ≤ p_Z z :=
    fun z => Finset.sum_nonneg (fun o _ => hpO_nn o)
  have hpZD_nn : ∀ z d, 0 ≤ p_ZD z d :=
    fun z d => Finset.sum_nonneg (fun o _ => hp_nn o d)
  have hpQ_nn : ∀ q, 0 ≤ p_Q q :=
    fun q => Finset.sum_nonneg (fun z _ => hpZ_nn z)
  have hqQT_nn : ∀ q α, 0 ≤ q_QT q α := by
    intro q α
    dsimp only [q_QT]
    split_ifs
    · exact div_nonneg (hpQ_nn q) (Nat.cast_nonneg _)
    · exact le_rfl
  have hqZTD_nn : ∀ z d α, 0 ≤ q_ZTD z d α := by
    intro z d α
    dsimp only [q_ZTD]
    split_ifs
    · exact div_nonneg (hpZD_nn z d) (Nat.cast_nonneg _)
    · exact le_rfl

  have h_sum_SZ : ∀ φ : Fin N_O → ℝ, (∑ z ∈ S_Z, ∑ o ∈ F_z z, φ o) = ∑ o ∈ S_act, φ o :=
    fun φ => h_sum_fib_maps_to S_act S_Z Z_of φ _ (fun o ho => Finset.mem_image_of_mem Z_of ho)

  have h_sum_SQ : ∀ φ : Fin N_O → ℝ, (∑ q ∈ S_Q, ∑ o ∈ H_q q, φ o) = ∑ o ∈ S_act, φ o :=
    fun φ => h_sum_fib_maps_to S_act S_Q Q_of φ _ (fun o ho => Finset.mem_image_of_mem Q_of ho)

  have hZ_props : ∀ {z}, z ∈ S_Z → z.1 ∈ S_Q ∧ (T_cand z.1).Nonempty ∧ 0 < m_Z z := by
    intro z hz
    rcases Finset.mem_image.mp hz with ⟨o₀, ho₀, rfl⟩
    obtain ⟨hzq, _, hm₀, hne₀⟩ := h_act o₀ ho₀
    refine ⟨?_, ?_, ?_⟩
    · rw [hzq]; exact Finset.mem_image_of_mem Q_of ho₀
    · rwa [hzq]
    · have ho₀_F : o₀ ∈ F_z (Z_of o₀) := Finset.mem_filter.mpr ⟨ho₀, rfl⟩
      have hm_nn : ∀ o ∈ F_z (Z_of o₀), 0 ≤ m_site o :=
        fun o ho => (h_act o (Finset.mem_filter.mp ho).1).2.2.1.le
      exact lt_of_lt_of_le hm₀ (Finset.single_le_sum hm_nn ho₀_F)

  have hQ_props : ∀ {q}, q ∈ S_Q → (T_cand q).Nonempty ∧ q.2.1 < 2 ^ (m_t - m_r) := by
    intro q hq
    rcases Finset.mem_image.mp hq with ⟨o₀, ho₀, rfl⟩
    obtain ⟨_, hrl₀, _, hne₀⟩ := h_act o₀ ho₀
    refine ⟨hne₀, ?_⟩
    rw [hrl₀]
    exact Nat.mod_lt (r_O o₀) h_two_pow_pos

  have h_sum_SZ_SQ :
      ∀ ψ : (((ℕ × (ℤ × ℤ) × (ℤ × ℤ)) × ℕ × (ℤ × ℤ)) × (ℤ × ℤ)) → ℝ,
        (∑ q ∈ S_Q, ∑ z ∈ G_q q, ψ z) = ∑ z ∈ S_Z, ψ z :=
    fun ψ => h_sum_fib_maps_to S_Z S_Q Prod.fst ψ _ (fun z hz => (hZ_props hz).1)

  have h_two_level : ∀ q (φ : Fin N_O → ℝ),
      (∑ z ∈ G_q q, ∑ o ∈ F_z z, φ o) = ∑ o ∈ H_q q, φ o := by
    intro q φ
    have hmaps : ∀ o ∈ H_q q, Z_of o ∈ G_q q := by
      intro o ho
      obtain ⟨ho_act, hqo⟩ := Finset.mem_filter.mp ho
      exact Finset.mem_filter.mpr ⟨Finset.mem_image_of_mem Z_of ho_act,
        (h_act o ho_act).1.trans hqo⟩
    rw [← h_sum_fib_maps_to (H_q q) (G_q q) Z_of φ
      (fun _ _ => Classical.propDecidable _) hmaps]
    refine Finset.sum_congr rfl (fun z hz => ?_)
    have hzq : z.1 = q := (Finset.mem_filter.mp hz).2
    refine Finset.sum_congr ?_ (fun _ _ => rfl)
    ext o
    dsimp only [F_z, H_q]
    constructor
    · intro h
      obtain ⟨ho_act, rfl⟩ := Finset.mem_filter.mp h
      exact Finset.mem_filter.mpr
        ⟨Finset.mem_filter.mpr ⟨ho_act, (h_act o ho_act).1.symm.trans hzq⟩, rfl⟩
    · intro h
      obtain ⟨h_hq, hzo⟩ := Finset.mem_filter.mp h
      obtain ⟨ho_act, _⟩ := Finset.mem_filter.mp h_hq
      exact Finset.mem_filter.mpr ⟨ho_act, hzo⟩

  have hpQ_eq_H : ∀ q, p_Q q = ∑ o ∈ H_q q, p_O o :=
    fun q => h_two_level q p_O
  have hmZ_sum_G : ∀ q, (∑ z ∈ G_q q, m_Z z) = ∑ o ∈ H_q q, m_site o :=
    fun q => h_two_level q m_site

  have hpZD_sum_d : ∀ z, (∑ d : Fin N_D, p_ZD z d) = p_Z z :=
    fun _ => Finset.sum_comm
  have hpZD_sum_z : ∀ d : Fin N_D, (∑ z ∈ S_Z, p_ZD z d) = p_D d := by
    intro d
    rw [h_sum_SZ]
    exact Finset.sum_subset (Finset.subset_univ S_act)
      (fun o _ ho => hp_zero_of_not_mem ho d)
  have hpZ_sum : ∑ z ∈ S_Z, p_Z z = 1 := by
    rw [h_sum_SZ]
    calc ∑ o ∈ S_act, p_O o
        = ∑ o : Fin N_O, p_O o :=
          Finset.sum_subset (Finset.subset_univ S_act) (fun o _ ho => hpO_zero_of_not_mem ho)
      _ = 1 := hp_sum
  have hpQ_sum : ∑ q ∈ S_Q, p_Q q = 1 :=
    (h_sum_SZ_SQ p_Z).trans hpZ_sum

  have hqc_sum_d : ∀ (o : Fin N_O) (α : Fin N_ret),
      (∑ d : Fin N_D, q_cand o d α) =
        if α ∈ T_cand (Q_of o) then p_O o / ((T_cand (Q_of o)).card : ℝ) else 0 :=
    fun o α => h_ite_sum Finset.univ (α ∈ T_cand (Q_of o)) _
      (fun d => p_cond o d) ((T_cand (Q_of o)).card : ℝ)

  have hqZTD_sum_z : ∀ (α : Fin N_ret) (d : Fin N_D),
      (∑ z ∈ S_Z, q_ZTD z d α) = q_TD α d := by
    intro α d
    have h_fib : ∀ z ∈ S_Z, q_ZTD z d α = ∑ o ∈ F_z z, q_cand o d α := by
      intro z _
      have hcongr : (∑ o ∈ F_z z, q_cand o d α) =
          ∑ o ∈ F_z z, (if α ∈ T_cand z.1 then p_cond o d / ((T_cand z.1).card : ℝ) else 0) := by
        refine Finset.sum_congr rfl (fun o ho => ?_)
        obtain ⟨ho_act, hzo⟩ := Finset.mem_filter.mp ho
        have hqo : Q_of o = z.1 := (h_act o ho_act).1.symm.trans (congrArg Prod.fst hzo)
        dsimp only [q_cand]
        rw [hqo]
      rw [hcongr, h_ite_sum]
    rw [Finset.sum_congr rfl h_fib, h_sum_SZ]
    exact Finset.sum_subset (Finset.subset_univ S_act)
      (fun o _ ho => hqc_zero_of_not_mem ho d α)

  have hqTD_sum_α : ∀ d : Fin N_D, (∑ α : Fin N_ret, q_TD α d) = p_D d := by
    intro d
    calc ∑ α : Fin N_ret, q_TD α d
        = ∑ o : Fin N_O, ∑ α : Fin N_ret, q_cand o d α := Finset.sum_comm
      _ = q_D d := rfl
      _ = p_D d := congrFun hqD_eq d

  have hqTD_sum : ∑ α : Fin N_ret, ∑ d : Fin N_D, q_TD α d = 1 := by
    calc ∑ α : Fin N_ret, ∑ d : Fin N_D, q_TD α d
        = ∑ d : Fin N_D, ∑ α : Fin N_ret, q_TD α d := Finset.sum_comm
      _ = ∑ d : Fin N_D, p_D d := Finset.sum_congr rfl (fun d _ => hqTD_sum_α d)
      _ = 1 := hpD_sum

  have hqQT_fib : ∀ (q : (ℕ × (ℤ × ℤ) × (ℤ × ℤ)) × ℕ × (ℤ × ℤ)) (α : Fin N_ret),
      q_QT q α = ∑ o ∈ H_q q, ∑ d : Fin N_D, q_cand o d α := by
    intro q α
    have hcongr : (∑ o ∈ H_q q, ∑ d : Fin N_D, q_cand o d α) =
        ∑ o ∈ H_q q, (if α ∈ T_cand q then p_O o / ((T_cand q).card : ℝ) else 0) := by
      refine Finset.sum_congr rfl (fun o ho => ?_)
      rw [hqc_sum_d o α, (Finset.mem_filter.mp ho).2]
    rw [hcongr, h_ite_sum, ← hpQ_eq_H q]

  have hqQT_sum_q : ∀ α : Fin N_ret, (∑ q ∈ S_Q, q_QT q α) = q_T α := by
    intro α
    rw [Finset.sum_congr rfl (fun q _ => hqQT_fib q α), h_sum_SQ]
    exact Finset.sum_subset (Finset.subset_univ S_act)
      (fun o _ ho => Finset.sum_eq_zero (fun d _ => hqc_zero_of_not_mem ho d α))

  have hqT_sum : ∑ α : Fin N_ret, q_T α = 1 := by
    calc ∑ α : Fin N_ret, q_T α
        = ∑ α : Fin N_ret, ∑ o : Fin N_O, ∑ d : Fin N_D, q_cand o d α := rfl
      _ = ∑ o : Fin N_O, ∑ α : Fin N_ret, ∑ d : Fin N_D, q_cand o d α := Finset.sum_comm
      _ = ∑ o : Fin N_O, ∑ d : Fin N_D, ∑ α : Fin N_ret, q_cand o d α :=
          Finset.sum_congr rfl (fun _ _ => Finset.sum_comm)
      _ = ∑ o : Fin N_O, ∑ d : Fin N_D, p_cond o d :=
          Finset.sum_congr rfl (fun o _ => Finset.sum_congr rfl (fun d _ => hqc_sum_α o d))
      _ = 1 := hp_sum

  let N_rl := 2 ^ (m_t - m_r)
  let S_Q_rl := fun rl : Fin N_rl => S_Q.filter (fun q => q.2.1 = rl.1)
  let rl_of_Q : ((ℕ × (ℤ × ℤ) × (ℤ × ℤ)) × ℕ × (ℤ × ℤ)) → Fin N_rl :=
    fun q => ⟨q.2.1 % N_rl, Nat.mod_lt q.2.1 h_two_pow_pos⟩

  have h_sum_SQ_rl :
      ∀ ψ : ((ℕ × (ℤ × ℤ) × (ℤ × ℤ)) × ℕ × (ℤ × ℤ)) → ℝ,
        (∑ rl : Fin N_rl, ∑ q ∈ S_Q_rl rl, ψ q) = ∑ q ∈ S_Q, ψ q := by
    intro ψ
    rw [← h_sum_fib_maps_to S_Q Finset.univ rl_of_Q ψ
      (fun _ _ => Classical.propDecidable _) (fun _ _ => Finset.mem_univ _)]
    refine Finset.sum_congr rfl (fun rl _ => ?_)
    refine Finset.sum_congr ?_ (fun _ _ => rfl)
    ext q
    dsimp only [S_Q_rl]
    constructor
    · intro h
      obtain ⟨hq, hrl⟩ := Finset.mem_filter.mp h
      refine Finset.mem_filter.mpr ⟨hq, ?_⟩
      ext
      dsimp only [rl_of_Q]
      rw [Nat.mod_eq_of_lt (hQ_props hq).2, hrl]
    · intro h
      obtain ⟨hq, hrl⟩ := Finset.mem_filter.mp h
      refine Finset.mem_filter.mpr ⟨hq, ?_⟩
      have hval : (rl_of_Q q).1 = rl.1 := congrArg Fin.val hrl
      dsimp only [rl_of_Q] at hval
      rwa [Nat.mod_eq_of_lt (hQ_props hq).2] at hval

  have hqQT_sum_rl : ∀ (α : Fin N_ret) (rl : Fin N_rl),
      (∑ q ∈ S_Q_rl rl, q_QT q α) = q_TR α rl := by
    intro α rl
    let A_rl := S_act.filter (fun o => r_O o % N_rl = rl.1)
    have hmaps : ∀ o ∈ A_rl, Q_of o ∈ S_Q_rl rl := by
      intro o ho
      obtain ⟨ho_act, hmod⟩ := Finset.mem_filter.mp ho
      exact Finset.mem_filter.mpr ⟨Finset.mem_image_of_mem Q_of ho_act,
        (h_act o ho_act).2.1.trans hmod⟩
    have hfib_eq : ∀ q ∈ S_Q_rl rl,
        A_rl.filter (fun o => Q_of o = q) = H_q q := by
      intro q hq
      have hq_rl : q.2.1 = rl.1 := (Finset.mem_filter.mp hq).2
      ext o
      dsimp only [A_rl, H_q]
      constructor
      · intro h
        obtain ⟨h_arl, hqo⟩ := Finset.mem_filter.mp h
        obtain ⟨ho_act, _⟩ := Finset.mem_filter.mp h_arl
        exact Finset.mem_filter.mpr ⟨ho_act, hqo⟩
      · intro h
        obtain ⟨ho_act, hqo⟩ := Finset.mem_filter.mp h
        refine Finset.mem_filter.mpr ⟨Finset.mem_filter.mpr ⟨ho_act, ?_⟩, hqo⟩
        rw [← (h_act o ho_act).2.1, hqo, hq_rl]
    calc ∑ q ∈ S_Q_rl rl, q_QT q α
        = ∑ q ∈ S_Q_rl rl, ∑ o ∈ H_q q, ∑ d : Fin N_D, q_cand o d α :=
          Finset.sum_congr rfl (fun q _ => hqQT_fib q α)
      _ = ∑ q ∈ S_Q_rl rl, ∑ o ∈ A_rl.filter (fun o => Q_of o = q), ∑ d : Fin N_D, q_cand o d α :=
          Finset.sum_congr rfl (fun q hq => by rw [hfib_eq q hq])
      _ = ∑ o ∈ A_rl, ∑ d : Fin N_D, q_cand o d α :=
          h_sum_fib_maps_to A_rl (S_Q_rl rl) Q_of _ _ hmaps
      _ = q_TR α rl := by
          dsimp only [q_TR]
          refine Finset.sum_subset ?_ ?_
          · intro o ho
            obtain ⟨_, hmod⟩ := Finset.mem_filter.mp ho
            exact Finset.mem_filter.mpr ⟨Finset.mem_univ o, hmod⟩
          · intro o ho_u ho_n
            have hmod : r_O o % N_rl = rl.1 := (Finset.mem_filter.mp ho_u).2
            have ho_not_act : o ∉ S_act :=
              fun ho_act => ho_n (Finset.mem_filter.mpr ⟨ho_act, hmod⟩)
            exact Finset.sum_eq_zero (fun d _ => hqc_zero_of_not_mem ho_not_act d α)

  have hqTR_sum : ∀ α : Fin N_ret, (∑ rl : Fin N_rl, q_TR α rl) = q_T α := by
    intro α
    calc ∑ rl : Fin N_rl, q_TR α rl
        = ∑ rl : Fin N_rl, ∑ q ∈ S_Q_rl rl, q_QT q α :=
          Finset.sum_congr rfl (fun rl _ => (hqQT_sum_rl α rl).symm)
      _ = ∑ q ∈ S_Q, q_QT q α := h_sum_SQ_rl (fun q => q_QT q α)
      _ = q_T α := hqQT_sum_q α

  
  
  
  let H_O := ∑ o : Fin N_O, -(p_O o * Real.log (p_O o))
  let H_OD := ∑ o : Fin N_O, ∑ d : Fin N_D, -(p_cond o d * Real.log (p_cond o d / p_D d))
  let E_site := ∑ o : Fin N_O, p_O o * Real.log (m_site o)
  let H_Z := ∑ z ∈ S_Z, -(p_Z z * Real.log (p_Z z))
  let H_ZD := ∑ z ∈ S_Z, ∑ d : Fin N_D, -(p_ZD z d * Real.log (p_ZD z d / p_D d))
  let M_Z := ∑ z ∈ S_Z, p_Z z * Real.log (m_Z z)
  let H_Q := ∑ q ∈ S_Q, -(p_Q q * Real.log (p_Q q))
  let H_ZQ := ∑ q ∈ S_Q, ∑ z ∈ G_q q, -(p_Z z * Real.log (p_Z z / p_Q q))

  have hHO_act : H_O = ∑ o ∈ S_act, -(p_O o * Real.log (p_O o)) := by
    dsimp only [H_O]
    refine (Finset.sum_subset (Finset.subset_univ S_act) (fun o _ ho => ?_)).symm
    rw [hpO_zero_of_not_mem ho, zero_mul, neg_zero]

  have hHOD_act : H_OD = ∑ o ∈ S_act, ∑ d : Fin N_D,
      -(p_cond o d * Real.log (p_cond o d / p_D d)) := by
    dsimp only [H_OD]
    refine (Finset.sum_subset (Finset.subset_univ S_act) (fun o _ ho => ?_)).symm
    refine Finset.sum_eq_zero (fun d _ => ?_)
    rw [hp_zero_of_not_mem ho d, zero_div, zero_mul, neg_zero]

  have hEsite_act : E_site = ∑ o ∈ S_act, p_O o * Real.log (m_site o) := by
    dsimp only [E_site]
    refine (Finset.sum_subset (Finset.subset_univ S_act) (fun o _ ho => ?_)).symm
    rw [hpO_zero_of_not_mem ho, zero_mul]

  have h_OZ_uncond : H_O + E_site ≤ H_Z + M_Z := by
    rw [hHO_act, hEsite_act, ← Finset.sum_add_distrib,
      ← h_sum_SZ (fun o => -(p_O o * Real.log (p_O o)) + p_O o * Real.log (m_site o))]
    dsimp only [H_Z, M_Z]
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_le_sum (fun z hz => ?_)
    exact h_gibbs_chain_one (F_z z) p_O m_site (p_Z z) (m_Z z)
      (fun o _ => hpO_nn o) rfl (hZ_props hz).2.2
      (fun o ho => (h_act o (Finset.mem_filter.mp ho).1).2.2.1.le)
      (fun o ho _ => (h_act o (Finset.mem_filter.mp ho).1).2.2.1)
      le_rfl

  have h_OZ_cond : H_OD + E_site ≤ H_ZD + M_Z := by
    have h_lhs : H_OD + E_site = ∑ z ∈ S_Z, ∑ d : Fin N_D,
        ∑ o ∈ F_z z, (-(p_cond o d * Real.log (p_cond o d / p_D d)) +
          p_cond o d * Real.log (m_site o)) := by
      rw [hHOD_act, hEsite_act]
      have hE_expand : (∑ o ∈ S_act, p_O o * Real.log (m_site o)) =
          ∑ o ∈ S_act, ∑ d : Fin N_D, p_cond o d * Real.log (m_site o) :=
        Finset.sum_congr rfl (fun o _ => Finset.sum_mul Finset.univ (fun d => p_cond o d) _)
      rw [hE_expand, ← Finset.sum_add_distrib]
      have h_inner : (∑ o ∈ S_act, ((∑ d : Fin N_D, -(p_cond o d * Real.log (p_cond o d / p_D d))) +
            ∑ d : Fin N_D, p_cond o d * Real.log (m_site o))) =
          ∑ o ∈ S_act, ∑ d : Fin N_D, (-(p_cond o d * Real.log (p_cond o d / p_D d)) +
            p_cond o d * Real.log (m_site o)) :=
        Finset.sum_congr rfl (fun _ _ => Finset.sum_add_distrib.symm)
      rw [h_inner, ← h_sum_SZ]
      exact Finset.sum_congr rfl (fun _ _ => Finset.sum_comm)
    have h_rhs : H_ZD + M_Z = ∑ z ∈ S_Z, ∑ d : Fin N_D,
        (-(p_ZD z d * Real.log (p_ZD z d / p_D d)) + p_ZD z d * Real.log (m_Z z)) := by
      dsimp only [H_ZD, M_Z]
      have hM_expand : (∑ z ∈ S_Z, p_Z z * Real.log (m_Z z)) =
          ∑ z ∈ S_Z, ∑ d : Fin N_D, p_ZD z d * Real.log (m_Z z) :=
        Finset.sum_congr rfl (fun z _ => by
          rw [← hpZD_sum_d z, Finset.sum_mul])
      rw [hM_expand, ← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl (fun _ _ => Finset.sum_add_distrib.symm)
    rw [h_lhs, h_rhs]
    refine Finset.sum_le_sum (fun z hz => Finset.sum_le_sum (fun d _ => ?_))
    exact h_gibbs_chain (F_z z) (fun o => p_cond o d) m_site (p_ZD z d) (p_D d) (m_Z z)
      (fun o _ => hp_nn o d) rfl (fun o _ hpos => hpD_pos_of_p_pos hpos)
      (hZ_props hz).2.2
      (fun o ho => (h_act o (Finset.mem_filter.mp ho).1).2.2.1.le)
      (fun o ho _ => (h_act o (Finset.mem_filter.mp ho).1).2.2.1)
      le_rfl

  have h_ZQ_split : H_Z = H_Q + H_ZQ := by
    dsimp only [H_Z, H_Q, H_ZQ]
    rw [← h_sum_SZ_SQ (fun z => -(p_Z z * Real.log (p_Z z))), add_comm, ← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl (fun q _ =>
      h_sum_ent_split_one (G_q q) p_Z (p_Q q) (fun z _ => hpZ_nn z) rfl)

  
  
  
  let E_card := ∑ q ∈ S_Q, p_Q q * Real.log ((T_cand q).card : ℝ)

  have h_Ecard_Z : (∑ z ∈ S_Z, p_Z z * Real.log ((T_cand z.1).card : ℝ)) = E_card := by
    rw [← h_sum_SZ_SQ]
    dsimp only [E_card]
    refine Finset.sum_congr rfl (fun q _ => ?_)
    have hcongr : (∑ z ∈ G_q q, p_Z z * Real.log ((T_cand z.1).card : ℝ)) =
        ∑ z ∈ G_q q, p_Z z * Real.log ((T_cand q).card : ℝ) :=
      Finset.sum_congr rfl (fun z hz => by rw [(Finset.mem_filter.mp hz).2])
    rw [hcongr, ← Finset.sum_mul]

  have h_coh_Q : H_ZQ + M_Z ≤
      E_card + Real.log m_bin + ξ * ell + Real.log C_coh_tot := by
    have hMZ_fib : M_Z = ∑ q ∈ S_Q, ∑ z ∈ G_q q, p_Z z * Real.log (m_Z z) :=
      (h_sum_SZ_SQ (fun z => p_Z z * Real.log (m_Z z))).symm
    have hlhs : H_ZQ + M_Z =
        ∑ q ∈ S_Q, ∑ z ∈ G_q q, (-(p_Z z * Real.log (p_Z z / p_Q q)) + p_Z z * Real.log (m_Z z)) := by
      dsimp only [H_ZQ]
      rw [hMZ_fib, ← Finset.sum_add_distrib]
      exact Finset.sum_congr rfl (fun _ _ => Finset.sum_add_distrib.symm)
    have h_pt : ∀ q ∈ S_Q,
        (∑ z ∈ G_q q, (-(p_Z z * Real.log (p_Z z / p_Q q)) + p_Z z * Real.log (m_Z z))) ≤
          p_Q q * Real.log ((T_cand q).card : ℝ) +
            p_Q q * (Real.log m_bin + ξ * ell + Real.log C_coh_tot) := by
      intro q hq
      have hcard_pos : 0 < ((T_cand q).card : ℝ) :=
        Nat.cast_pos.mpr (Finset.card_pos.mpr (hQ_props hq).1)
      have hrpow_pos : 0 < ε ^ (-ξ) := Real.rpow_pos_of_pos hε₀ (-ξ)
      let B_Q := C_coh_tot * ε ^ (-ξ) * ((T_cand q).card : ℝ) * m_bin
      have hBQ_pos : 0 < B_Q :=
        mul_pos (mul_pos (mul_pos hC_coh_pos hrpow_pos) hcard_pos) hm_bin
      have hm_le : ∑ z ∈ G_q q, m_Z z ≤ B_Q := by
        rw [hmZ_sum_G q]
        exact hQ_sum q
      have hg := h_gibbs (G_q q) p_Z m_Z (p_Q q) B_Q
        (fun z _ => hpZ_nn z) rfl hBQ_pos
        (fun z hz => (hZ_props (Finset.mem_filter.mp hz).1).2.2.le)
        (fun z hz _ => (hZ_props (Finset.mem_filter.mp hz).1).2.2)
        hm_le
      have hlog_BQ : Real.log B_Q =
          Real.log ((T_cand q).card : ℝ) + (Real.log m_bin + ξ * ell + Real.log C_coh_tot) := by
        dsimp only [B_Q, ell]
        rw [Real.log_mul (mul_pos (mul_pos hC_coh_pos hrpow_pos) hcard_pos).ne' hm_bin.ne',
          Real.log_mul (mul_pos hC_coh_pos hrpow_pos).ne' hcard_pos.ne',
          Real.log_mul hC_coh_pos.ne' hrpow_pos.ne',
          hlog_rpow (-ξ)]
        ring
      rw [hlog_BQ, mul_add] at hg
      exact hg
    rw [hlhs]
    have hsum := Finset.sum_le_sum h_pt
    rw [Finset.sum_add_distrib, ← Finset.sum_mul, hpQ_sum, one_mul] at hsum
    change (∑ q ∈ S_Q, ∑ z ∈ G_q q, (-(p_Z z * Real.log (p_Z z / p_Q q)) + p_Z z * Real.log (m_Z z))) ≤
      E_card + (Real.log m_bin + ξ * ell + Real.log C_coh_tot) at hsum
    linarith only [hsum]

  have h_coh_Z : M_Z ≤ E_card + Real.log m_bin +
      (k_out - (d_dim : ℝ) * h + 2 * θ + 2 * ξ) * ell +
      Real.log C_coh_tot + 4 * Real.log (M_L : ℝ) := by
    let exp_Z := (d_dim : ℝ) * h - k_out - 2 * θ - 2 * ξ
    let C_Z_const := Real.log m_bin + (k_out - (d_dim : ℝ) * h + 2 * θ + 2 * ξ) * ell +
      Real.log C_coh_tot + 4 * Real.log (M_L : ℝ)
    have h_pt : ∀ z ∈ S_Z, p_Z z * Real.log (m_Z z) ≤
        p_Z z * Real.log ((T_cand z.1).card : ℝ) + p_Z z * C_Z_const := by
      intro z hz
      have hmZ_pos : 0 < m_Z z := (hZ_props hz).2.2
      have hcard_pos : 0 < ((T_cand z.1).card : ℝ) :=
        Nat.cast_pos.mpr (Finset.card_pos.mpr (hZ_props hz).2.1)
      have hrpow_pos : 0 < ε ^ exp_Z := Real.rpow_pos_of_pos hε₀ exp_Z
      let B_Z := C_coh_tot * ((M_L ^ 4 : ℕ) : ℝ) * ε ^ exp_Z * ((T_cand z.1).card : ℝ) * m_bin
      have hlog_le : Real.log (m_Z z) ≤ Real.log B_Z :=
        Real.log_le_log hmZ_pos (hZ_sum z)
      have hlog_BZ : Real.log B_Z = Real.log ((T_cand z.1).card : ℝ) + C_Z_const := by
        dsimp only [B_Z, C_Z_const, exp_Z, ell]
        rw [Real.log_mul (mul_pos (mul_pos (mul_pos hC_coh_pos hML4_pos) hrpow_pos) hcard_pos).ne' hm_bin.ne',
          Real.log_mul (mul_pos (mul_pos hC_coh_pos hML4_pos) hrpow_pos).ne' hcard_pos.ne',
          Real.log_mul (mul_pos hC_coh_pos hML4_pos).ne' hrpow_pos.ne',
          Real.log_mul hC_coh_pos.ne' hML4_pos.ne',
          hlog_ML4, hlog_rpow ((d_dim : ℝ) * h - k_out - 2 * θ - 2 * ξ)]
        ring
      have hmul := mul_le_mul_of_nonneg_left hlog_le (hpZ_nn z)
      rwa [hlog_BZ, mul_add] at hmul
    have hsum := Finset.sum_le_sum h_pt
    rw [Finset.sum_add_distrib, h_Ecard_Z, ← Finset.sum_mul, hpZ_sum, one_mul] at hsum
    dsimp only [C_Z_const] at hsum
    linarith only [hsum]

  
  
  
  let H_qT := ∑ α : Fin N_ret, -(q_T α * Real.log (q_T α))
  let H_qTD := ∑ α : Fin N_ret, ∑ d : Fin N_D, -(q_TD α d * Real.log (q_TD α d / p_D d))
  let H_qTR := ∑ α : Fin N_ret, ∑ rl : Fin N_rl, -(q_TR α rl * Real.log (q_TR α rl / q_T α))

  have h_QT_bound : H_Q + E_card ≤ H_qT + H_qTR + 2 * θ * ell + Real.log C_coh_tot := by
    have h_expand : (∑ q ∈ S_Q, ∑ α : Fin N_ret, -(q_QT q α * Real.log (q_QT q α))) =
        H_Q + E_card := by
      dsimp only [H_Q, E_card]
      rw [← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun q hq => ?_)
      exact h_unif_ent_one (T_cand q) (p_Q q) _ (hpQ_nn q) (fun _ => (hQ_props hq).1)
    let K_Q := C_coh_tot * ε ^ (-2 * θ)
    have hrpow_Q : 0 < ε ^ (-2 * θ) := Real.rpow_pos_of_pos hε₀ (-2 * θ)
    have hKQ_pos : 0 < K_Q := mul_pos hC_coh_pos hrpow_Q
    have hlog_KQ : Real.log K_Q = 2 * θ * ell + Real.log C_coh_tot := by
      dsimp only [K_Q, ell]
      rw [Real.log_mul hC_coh_pos.ne' hrpow_Q.ne', hlog_rpow (-2 * θ)]
      ring
    have h_α : ∀ α : Fin N_ret,
        (∑ q ∈ S_Q, -(q_QT q α * Real.log (q_QT q α))) ≤
          -(q_T α * Real.log (q_T α)) +
            (∑ rl : Fin N_rl, -(q_TR α rl * Real.log (q_TR α rl / q_T α))) +
            q_T α * Real.log K_Q := by
      intro α
      rw [← h_sum_SQ_rl (fun q => -(q_QT q α * Real.log (q_QT q α)))]
      have h_rl : ∀ rl : Fin N_rl,
          (∑ q ∈ S_Q_rl rl, -(q_QT q α * Real.log (q_QT q α))) ≤
            -(q_TR α rl * Real.log (q_TR α rl)) + q_TR α rl * Real.log K_Q := by
        intro rl
        let S_Q_act := S_Q.filter (fun q => q.2.1 = rl.1 ∧ α ∈ T_cand q)
        have hsub : S_Q_act ⊆ S_Q_rl rl := by
          intro q hq
          obtain ⟨hq_S, hq_rl, _⟩ := Finset.mem_filter.mp hq
          exact Finset.mem_filter.mpr ⟨hq_S, hq_rl⟩
        have hsupp : ∀ q ∈ S_Q_rl rl, 0 < q_QT q α → q ∈ S_Q_act := by
          intro q hq hpos
          obtain ⟨hq_S, hq_rl⟩ := Finset.mem_filter.mp hq
          refine Finset.mem_filter.mpr ⟨hq_S, hq_rl, ?_⟩
          by_contra hnot
          have h0 : q_QT q α = 0 := by
            dsimp only [q_QT]
            split_ifs
            rfl
          linarith only [hpos, h0]
        exact h_supp_card_chain_one (S_Q_rl rl) S_Q_act (fun q => q_QT q α) (q_TR α rl) K_Q
          hsub (fun q _ => hqQT_nn q α) (hqQT_sum_rl α rl) hsupp hKQ_pos
          (fun _ => hQ_card α rl.1)
      have hsum_rl := Finset.sum_le_sum (fun rl (_ : rl ∈ Finset.univ) => h_rl rl)
      rw [Finset.sum_add_distrib, ← Finset.sum_mul, hqTR_sum α,
        h_sum_ent_split_one Finset.univ (fun rl => q_TR α rl) (q_T α)
          (fun rl _ => hqTR_nn α rl) (hqTR_sum α)] at hsum_rl
      linarith only [hsum_rl]
    rw [← h_expand, Finset.sum_comm]
    have hsum_α := Finset.sum_le_sum (fun α (_ : α ∈ Finset.univ) => h_α α)
    rw [Finset.sum_add_distrib, Finset.sum_add_distrib, ← Finset.sum_mul,
      hqT_sum, one_mul, hlog_KQ] at hsum_α
    dsimp only [H_qT, H_qTR]
    linarith only [hsum_α]

  have h_ZTD_bound : H_ZD + E_card ≤
      H_qTD + (2 * θ + ζ_sh) * ell + Real.log C_coh_tot := by
    have h_expand : (∑ z ∈ S_Z, ∑ d : Fin N_D, ∑ α : Fin N_ret,
        -(q_ZTD z d α * Real.log (q_ZTD z d α / p_D d))) = H_ZD + E_card := by
      have h_z : ∀ z ∈ S_Z,
          (∑ d : Fin N_D, ∑ α : Fin N_ret, -(q_ZTD z d α * Real.log (q_ZTD z d α / p_D d))) =
            (∑ d : Fin N_D, -(p_ZD z d * Real.log (p_ZD z d / p_D d))) +
              p_Z z * Real.log ((T_cand z.1).card : ℝ) := by
        intro z hz
        have h_d : ∀ d : Fin N_D,
            (∑ α : Fin N_ret, -(q_ZTD z d α * Real.log (q_ZTD z d α / p_D d))) =
              -(p_ZD z d * Real.log (p_ZD z d / p_D d)) +
                p_ZD z d * Real.log ((T_cand z.1).card : ℝ) := by
          intro d
          refine h_unif_ent (T_cand z.1) (p_ZD z d) (p_D d) _ (hpZD_nn z d)
            (fun _ => (hZ_props hz).2.1) (fun hpos => ?_)
          rw [← hpZD_sum_z d]
          exact lt_of_lt_of_le hpos (Finset.single_le_sum (fun z' _ => hpZD_nn z' d) hz)
        rw [Finset.sum_congr rfl (fun d _ => h_d d), Finset.sum_add_distrib,
          ← Finset.sum_mul, hpZD_sum_d z]
      rw [Finset.sum_congr rfl h_z, Finset.sum_add_distrib, h_Ecard_Z]
    let K_ZD := C_coh_tot * ε ^ (-2 * θ - ζ_sh)
    have hrpow_ZD : 0 < ε ^ (-2 * θ - ζ_sh) := Real.rpow_pos_of_pos hε₀ (-2 * θ - ζ_sh)
    have hKZD_pos : 0 < K_ZD := mul_pos hC_coh_pos hrpow_ZD
    have hlog_KZD : Real.log K_ZD = (2 * θ + ζ_sh) * ell + Real.log C_coh_tot := by
      dsimp only [K_ZD, ell]
      rw [Real.log_mul hC_coh_pos.ne' hrpow_ZD.ne', hlog_rpow (-2 * θ - ζ_sh)]
      ring
    have h_swap : (∑ z ∈ S_Z, ∑ d : Fin N_D, ∑ α : Fin N_ret,
          -(q_ZTD z d α * Real.log (q_ZTD z d α / p_D d))) =
        ∑ α : Fin N_ret, ∑ d : Fin N_D, ∑ z ∈ S_Z,
          -(q_ZTD z d α * Real.log (q_ZTD z d α / p_D d)) := by
      calc ∑ z ∈ S_Z, ∑ d : Fin N_D, ∑ α : Fin N_ret,
              -(q_ZTD z d α * Real.log (q_ZTD z d α / p_D d))
          = ∑ d : Fin N_D, ∑ z ∈ S_Z, ∑ α : Fin N_ret,
              -(q_ZTD z d α * Real.log (q_ZTD z d α / p_D d)) := Finset.sum_comm
        _ = ∑ d : Fin N_D, ∑ α : Fin N_ret, ∑ z ∈ S_Z,
              -(q_ZTD z d α * Real.log (q_ZTD z d α / p_D d)) :=
            Finset.sum_congr rfl (fun _ _ => Finset.sum_comm)
        _ = ∑ α : Fin N_ret, ∑ d : Fin N_D, ∑ z ∈ S_Z,
              -(q_ZTD z d α * Real.log (q_ZTD z d α / p_D d)) := Finset.sum_comm
    have h_αd : ∀ (α : Fin N_ret) (d : Fin N_D),
        (∑ z ∈ S_Z, -(q_ZTD z d α * Real.log (q_ZTD z d α / p_D d))) ≤
          -(q_TD α d * Real.log (q_TD α d / p_D d)) + q_TD α d * Real.log K_ZD := by
      intro α d
      let S_Z_ad :=
        (S_act.filter (fun o => 0 < p_cond o d ∧ α ∈ T_cand (Q_of o))).image Z_of
      have hsub : S_Z_ad ⊆ S_Z := by
        intro z hz
        rcases Finset.mem_image.mp hz with ⟨o, ho, rfl⟩
        exact Finset.mem_image_of_mem Z_of (Finset.mem_filter.mp ho).1
      have hpD_of_qZTD : ∀ z ∈ S_Z, 0 < q_ZTD z d α → 0 < p_D d := by
        intro z hz hpos
        have hle : q_ZTD z d α ≤ q_TD α d := by
          rw [← hqZTD_sum_z α d]
          exact Finset.single_le_sum (fun z' _ => hqZTD_nn z' d α) hz
        have hle2 : q_TD α d ≤ p_D d := by
          rw [← hqTD_sum_α d]
          exact Finset.single_le_sum (fun α' _ => hqTD_nn α' d) (Finset.mem_univ α)
        exact lt_of_lt_of_le hpos (le_trans hle hle2)
      have hsupp : ∀ z ∈ S_Z, 0 < q_ZTD z d α → z ∈ S_Z_ad := by
        intro z _ hpos
        have hα_mem : α ∈ T_cand z.1 := by
          by_contra hnot
          have h0 : q_ZTD z d α = 0 := by
            dsimp only [q_ZTD]
            split_ifs
            rfl
          linarith only [hpos, h0]
        have hpos_div : 0 < p_ZD z d / ((T_cand z.1).card : ℝ) := by
          dsimp only [q_ZTD] at hpos
          split_ifs at hpos
          exact hpos
        have hcard_pos : 0 < ((T_cand z.1).card : ℝ) :=
          Nat.cast_pos.mpr (Finset.card_pos.mpr ⟨α, hα_mem⟩)
        have hpZD_pos : 0 < p_ZD z d := by
          by_contra hle
          have h0 : p_ZD z d = 0 := le_antisymm (not_lt.mp hle) (hpZD_nn z d)
          rw [h0, zero_div] at hpos_div
          exact lt_irrefl 0 hpos_div
        obtain ⟨o, ho_F, hp_pos⟩ :=
          (Finset.sum_pos_iff_of_nonneg (fun o' _ => hp_nn o' d)).mp hpZD_pos
        obtain ⟨ho_act, hzo⟩ := Finset.mem_filter.mp ho_F
        have hqo : Q_of o = z.1 := (h_act o ho_act).1.symm.trans (congrArg Prod.fst hzo)
        rw [← hqo] at hα_mem
        rw [← hzo]
        exact Finset.mem_image_of_mem Z_of (Finset.mem_filter.mpr ⟨ho_act, hp_pos, hα_mem⟩)
      have hcard_guard : 0 < q_TD α d → (S_Z_ad.card : ℝ) ≤ K_ZD := by
        intro hqTD_pos
        have hpD_pos : 0 < p_D d := by
          rw [← hqTD_sum_α d]
          exact lt_of_lt_of_le hqTD_pos
            (Finset.single_le_sum (fun α' _ => hqTD_nn α' d) (Finset.mem_univ α))
        exact hZ_card α d hpD_pos
      exact h_supp_card_chain S_Z S_Z_ad (fun z => q_ZTD z d α) (q_TD α d) (p_D d) K_ZD
        hsub (fun z _ => hqZTD_nn z d α) (hqZTD_sum_z α d) hpD_of_qZTD hsupp hKZD_pos hcard_guard
    rw [← h_expand, h_swap]
    have hsum_αd := Finset.sum_le_sum (fun α (_ : α ∈ Finset.univ) =>
      Finset.sum_le_sum (fun d (_ : d ∈ Finset.univ) => h_αd α d))
    have hrhs_split : (∑ α : Fin N_ret, ∑ d : Fin N_D,
          (-(q_TD α d * Real.log (q_TD α d / p_D d)) + q_TD α d * Real.log K_ZD)) =
        H_qTD + (∑ α : Fin N_ret, ∑ d : Fin N_D, q_TD α d) * Real.log K_ZD := by
      dsimp only [H_qTD]
      have h1 : (∑ α : Fin N_ret, ∑ d : Fin N_D,
            (-(q_TD α d * Real.log (q_TD α d / p_D d)) + q_TD α d * Real.log K_ZD)) =
          ∑ α : Fin N_ret, ((∑ d : Fin N_D, -(q_TD α d * Real.log (q_TD α d / p_D d))) +
            (∑ d : Fin N_D, q_TD α d) * Real.log K_ZD) :=
        Finset.sum_congr rfl (fun α _ => by rw [Finset.sum_add_distrib, ← Finset.sum_mul])
      rw [h1, Finset.sum_add_distrib, ← Finset.sum_mul]
    rw [hrhs_split, hqTD_sum, one_mul, hlog_KZD] at hsum_αd
    linarith only [hsum_αd]

  
  
  
  refine ⟨hqD_eq, ?_⟩
  have h_raw : H_O + (1 / 2 : ℝ) * H_OD + (3 / 2 : ℝ) * E_site ≤
      H_qT + (3 / 2 : ℝ) * Real.log m_bin +
        (1 / 2 : ℝ) * (H_qTD + 2 * H_qTR + (k_out - (d_dim : ℝ) * h) * ell) +
        (4 * θ + 2 * ξ + (1 / 2 : ℝ) * ζ_sh) * ell +
        (3 * Real.log C_coh_tot + 2 * Real.log (M_L : ℝ)) := by
    linarith only [h_OZ_uncond, h_OZ_cond, h_ZQ_split, h_coh_Q, h_coh_Z, h_QT_bound, h_ZTD_bound]

  have h_div := div_le_div_of_nonneg_right h_raw hell_nn
  have hlhs_div : (H_O + (1 / 2 : ℝ) * H_OD + (3 / 2 : ℝ) * E_site) / ell =
      H_O / ell + (1 / 2 : ℝ) * (H_OD / ell) + (3 / 2 : ℝ) * (E_site / ell) := by
    ring
  have hrhs_div :
      (H_qT + (3 / 2 : ℝ) * Real.log m_bin +
        (1 / 2 : ℝ) * (H_qTD + 2 * H_qTR + (k_out - (d_dim : ℝ) * h) * ell) +
        (4 * θ + 2 * ξ + (1 / 2 : ℝ) * ζ_sh) * ell +
        (3 * Real.log C_coh_tot + 2 * Real.log (M_L : ℝ))) / ell =
      H_qT / ell + (3 / 2 : ℝ) * (Real.log m_bin / ell) +
        (1 / 2 : ℝ) * (H_qTD / ell + 2 * (H_qTR / ell) +
          (k_out - (d_dim : ℝ) * h) * (ell / ell)) +
        (4 * θ + 2 * ξ + (1 / 2 : ℝ) * ζ_sh) * (ell / ell) +
        (3 * Real.log C_coh_tot + 2 * Real.log (M_L : ℝ)) / ell := by
    ring
  rw [hlhs_div, hrhs_div, div_self hell_pos.ne'] at h_div
  have hrhs_clean :
      H_qT / ell + (3 / 2 : ℝ) * (Real.log m_bin / ell) +
        (1 / 2 : ℝ) * (H_qTD / ell + 2 * (H_qTR / ell) +
          (k_out - (d_dim : ℝ) * h) * 1) +
        (4 * θ + 2 * ξ + (1 / 2 : ℝ) * ζ_sh) * 1 +
        (3 * Real.log C_coh_tot + 2 * Real.log (M_L : ℝ)) / ell =
      H_qT / ell + (3 / 2 : ℝ) * (Real.log m_bin / ell) +
        (1 / 2 : ℝ) * (H_qTD / ell + 2 * (H_qTR / ell) + k_out - (d_dim : ℝ) * h) +
        4 * θ + 2 * ξ + (1 / 2 : ℝ) * ζ_sh +
        (3 * Real.log C_coh_tot + 2 * Real.log (M_L : ℝ)) / ell := by
    ring
  rw [hrhs_clean] at h_div
  dsimp only [H_O, H_OD, E_site, H_qT, H_qTD, H_qTR, N_rl] at h_div
  rwa [hqD_eq]

theorem assembled_cmi_lower_bound_of_fiber_lists (ε : ℝ) (hε₀ : 0 < ε) (hε₁ : ε < 1 / 4)
    (N_O N_D N_J : ℕ) (N_ret_of : Fin N_J → ℕ)
    (win_of : Fin N_O → Fin N_J)
    (p : Fin N_O → Fin N_D → ℝ)
    (Q_of : Fin N_J → Fin N_O → (ℕ × (ℤ × ℤ) × (ℤ × ℤ)) × ℕ × (ℤ × ℤ))
    (T_cand : ∀ j : Fin N_J, ((ℕ × (ℤ × ℤ) × (ℤ × ℤ)) × ℕ × (ℤ × ℤ)) → Finset (Fin (N_ret_of j)))
    (F_of : ∀ j : Fin N_J, Fin N_O → Fin (N_ret_of j) → ℕ × (ℤ × ℤ) × (ℤ × ℤ))
    (hp_nn : ∀ o d, 0 ≤ p o d)
    (hp_sum : ∑ o : Fin N_O, ∑ d : Fin N_D, p o d = 1)
    (hT_ne : ∀ o d, 0 < p o d → (T_cand (win_of o) (Q_of (win_of o) o)).Nonempty) :
    letI := Classical.propDecidable
    let ell := Real.log (ε⁻¹)
    let π_J := fun j : Fin N_J =>
      ∑ o ∈ Finset.univ.filter (fun o => win_of o = j), ∑ d : Fin N_D, p o d
    let q_cand : ∀ j : Fin N_J, Fin N_O → Fin N_D → Fin (N_ret_of j) → ℝ :=
      fun j o d α =>
        if win_of o = j ∧ 0 < π_J j ∧ α ∈ T_cand j (Q_of j o) then
          (p o d / π_J j) / ((T_cand j (Q_of j o)).card : ℝ)
        else 0
    let π_FTJ := fun j (ft : ℕ × (ℤ × ℤ) × (ℤ × ℤ)) =>
      ∑ o, ∑ d, ∑ α ∈ Finset.univ.filter (fun α => F_of j o α = ft),
        π_J j * q_cand j o d α
    let π_TFTJ := fun j ft α =>
      ∑ o, ∑ d, if F_of j o α = ft then π_J j * q_cand j o d α else 0
    let π_DFTJ := fun j ft d =>
      ∑ o, ∑ α ∈ Finset.univ.filter (fun α => F_of j o α = ft),
        π_J j * q_cand j o d α
    let π_TDFTJ := fun j ft α d =>
      ∑ o, if F_of j o α = ft then π_J j * q_cand j o d α else 0
    let S_FT : Fin N_J → Finset (ℕ × (ℤ × ℤ) × (ℤ × ℤ)) := fun j =>
      (Finset.univ ×ˢ Finset.univ).image (fun oα : Fin N_O × Fin (N_ret_of j) =>
        F_of j oα.1 oα.2)
    let I_TD_FTJ : ℝ :=
      (∑ j : Fin N_J, ∑ ft ∈ S_FT j, ∑ α : Fin (N_ret_of j), ∑ d : Fin N_D,
        if 0 < π_FTJ j ft then
          π_TDFTJ j ft α d * Real.log ((π_TDFTJ j ft α d * π_FTJ j ft) /
            (π_TFTJ j ft α * π_DFTJ j ft d))
        else 0) / ell
    0 ≤ I_TD_FTJ ∧
    (∀ (P_f : Fin N_O → ℕ × (ℤ × ℤ) × (ℤ × ℤ))
       (W_f : Fin N_O → ℤ × ℤ)
       (B_FTJ B_TW B_DW : ℝ),
       0 < B_FTJ → 0 < B_TW → 0 < B_DW →
       (∀ p_c : ℕ × (ℤ × ℤ) × (ℤ × ℤ),
         (((Finset.univ.filter (fun o : Fin N_O => P_f o = p_c ∧ 0 < ∑ d, p o d)).biUnion
           (fun o => (T_cand (win_of o) (Q_of (win_of o) o)).image
             (fun α => (win_of o, F_of (win_of o) o α)))).card : ℝ) ≤ B_FTJ) →
       (∀ (j : Fin N_J) (ft : ℕ × (ℤ × ℤ) × (ℤ × ℤ)) (α : Fin (N_ret_of j)),
         (((Finset.univ.filter (fun o : Fin N_O =>
           win_of o = j ∧ (0 < ∑ d, p o d) ∧ α ∈ T_cand j (Q_of j o) ∧
             F_of j o α = ft)).image W_f).card : ℝ) ≤ B_TW) →
       (∀ (j : Fin N_J) (ft : ℕ × (ℤ × ℤ) × (ℤ × ℤ)) (d : Fin N_D),
         (((Finset.univ.filter (fun o : Fin N_O =>
           win_of o = j ∧ 0 < p o d ∧
             ∃ α ∈ T_cand j (Q_of j o), F_of j o α = ft)).image W_f).card : ℝ) ≤ B_DW) →
       let p_O := fun o => ∑ d : Fin N_D, p o d
       let p_P := fun p_c => ∑ o ∈ Finset.univ.filter (fun o => P_f o = p_c), p_O o
       let p_PW := fun p_c w =>
         ∑ o ∈ Finset.univ.filter (fun o => P_f o = p_c ∧ W_f o = w), p_O o
       (∑ p_c ∈ Finset.univ.image P_f, ∑ w ∈ Finset.univ.image W_f,
         -(p_PW p_c w * Real.log (p_PW p_c w / p_P p_c))) / ell -
       (Real.log B_FTJ + Real.log B_TW + Real.log B_DW) / ell ≤ I_TD_FTJ) :=
by
  have hell_pos_raw : 0 < Real.log (ε⁻¹) :=
    Real.log_pos ((one_lt_inv₀ hε₀).mpr (by linarith only [hε₁]))
  have hell_nn_raw : 0 ≤ Real.log (ε⁻¹) := hell_pos_raw.le

  have h_log_le_sub_one : ∀ {y x : ℝ}, 0 < y → y ≤ x → Real.log y ≤ x - 1 := by
    intro y x hy hyx
    exact (Real.log_le_log hy hyx).trans (Real.log_le_sub_one_of_pos (lt_of_lt_of_le hy hyx))

  have h_supp_card_ent : ∀ {ι : Type} (S₀ L : Finset ι) (u : ι → ℝ) (U B : ℝ),
      (∀ i ∈ S₀, 0 ≤ u i) →
      (∑ i ∈ S₀, u i = U) →
      (∀ i ∈ S₀, 0 < u i → i ∈ L) →
      0 < B →
      (L.card : ℝ) ≤ B →
      (∑ i ∈ S₀, -(u i * Real.log (u i / U))) ≤ U * Real.log B := by
    intro ι S₀ L u U B hu_nn hU hsupp hB_pos hL_card
    have hU_nn : 0 ≤ U := by rw [← hU]; exact Finset.sum_nonneg hu_nn
    by_cases hU0 : U = 0
    · have hu0 : ∀ i ∈ S₀, u i = 0 :=
        (Finset.sum_eq_zero_iff_of_nonneg hu_nn).mp (hU.trans hU0)
      rw [hU0, zero_mul, Finset.sum_eq_zero (fun i hi => by
        rw [hu0 i hi, zero_div, zero_mul, neg_zero])]
    · have hU_pos : 0 < U := lt_of_le_of_ne hU_nn (Ne.symm hU0)
      let dec_pos : DecidablePred (fun i : ι => 0 < u i) :=
        fun i => Classical.propDecidable (0 < u i)
      let S_pos : Finset ι := @Finset.filter ι (fun i => 0 < u i) dec_pos S₀
      have hsub_S₀ : S_pos ⊆ S₀ := @Finset.filter_subset ι (fun i => 0 < u i) dec_pos S₀
      have hzero_out : ∀ i ∈ S₀, i ∉ S_pos → u i = 0 := by
        intro i hi₀ hi_not
        have hnot_pos : ¬ (0 < u i) := fun hpos =>
          hi_not ((@Finset.mem_filter ι (fun i => 0 < u i) dec_pos S₀ i).mpr ⟨hi₀, hpos⟩)
        exact le_antisymm (not_lt.mp hnot_pos) (hu_nn i hi₀)
      have hU_pos_sum : ∑ i ∈ S_pos, u i = U := by
        rw [← hU]
        exact Finset.sum_subset hsub_S₀ hzero_out
      have hent_eq : (∑ i ∈ S_pos, -(u i * Real.log (u i / U))) =
          ∑ i ∈ S₀, -(u i * Real.log (u i / U)) :=
        Finset.sum_subset hsub_S₀ (fun i hi₀ hi_not => by
          rw [hzero_out i hi₀ hi_not, zero_div, zero_mul, neg_zero])
      have hsub_L : S_pos ⊆ L := by
        intro i hi
        have hm := (@Finset.mem_filter ι (fun i => 0 < u i) dec_pos S₀ i).mp hi
        exact hsupp i hm.1 hm.2
      have hS_pos_card : (S_pos.card : ℝ) ≤ B :=
        (Nat.cast_le.mpr (Finset.card_le_card hsub_L)).trans hL_card
      have hpt : ∀ i ∈ S_pos,
          -(u i * Real.log (u i / U)) - u i * Real.log B ≤ U / B - u i := by
        intro i hi
        have hui : 0 < u i := ((@Finset.mem_filter ι (fun i => 0 < u i) dec_pos S₀ i).mp hi).2
        let x := (U / B) / u i
        have hx_pos : 0 < x := div_pos (div_pos hU_pos hB_pos) hui
        have hlog : Real.log x = -Real.log (u i / U) - Real.log B := by
          dsimp only [x]
          rw [Real.log_div (div_pos hU_pos hB_pos).ne' hui.ne',
            Real.log_div hU_pos.ne' hB_pos.ne',
            Real.log_div hui.ne' hU_pos.ne']
          ring
        have h1 := mul_le_mul_of_nonneg_left (Real.log_le_sub_one_of_pos hx_pos) hui.le
        have hlhs : u i * Real.log x = -(u i * Real.log (u i / U)) - u i * Real.log B := by
          rw [hlog]; ring
        have hrhs : u i * (x - 1) = U / B - u i := by
          dsimp only [x]
          rw [mul_sub, mul_one, mul_div_cancel₀ (U / B) hui.ne']
        rwa [hlhs, hrhs] at h1
      have hsum := Finset.sum_le_sum hpt
      rw [Finset.sum_sub_distrib, ← Finset.sum_mul, hU_pos_sum, hent_eq,
        Finset.sum_sub_distrib, Finset.sum_const, nsmul_eq_mul, hU_pos_sum] at hsum
      have hcard_mul : (S_pos.card : ℝ) * (U / B) ≤ U := by
        calc (S_pos.card : ℝ) * (U / B)
            ≤ B * (U / B) :=
              mul_le_mul_of_nonneg_right hS_pos_card (div_nonneg hU_pos.le hB_pos.le)
          _ = U := mul_div_cancel₀ U hB_pos.ne'
      linarith only [hsum, hcard_mul]

  letI := Classical.propDecidable
  intro ell π_J q_cand π_FTJ π_TFTJ π_DFTJ π_TDFTJ S_FT I_TD_FTJ
  have hell_nn : 0 ≤ ell := hell_nn_raw

  
  let wt : ∀ j : Fin N_J, Fin N_O → Fin N_D → Fin (N_ret_of j) → ℝ :=
    fun j o d α => π_J j * q_cand j o d α
  have hπJ_nn : ∀ j : Fin N_J, 0 ≤ π_J j :=
    fun _ => Finset.sum_nonneg (fun o _ => Finset.sum_nonneg (fun d _ => hp_nn o d))
  have h_wt : ∀ (j : Fin N_J) (o : Fin N_O) (d : Fin N_D) (α : Fin (N_ret_of j)),
      wt j o d α =
        if win_of o = j ∧ α ∈ T_cand j (Q_of j o) then
          p o d / ((T_cand j (Q_of j o)).card : ℝ)
        else 0 := by
    intro j o d α
    dsimp only [wt, q_cand]
    by_cases hcond : win_of o = j ∧ α ∈ T_cand j (Q_of j o)
    · rw [if_pos hcond]
      by_cases hπ : 0 < π_J j
      · rw [if_pos ⟨hcond.1, hπ, hcond.2⟩, mul_div_assoc', mul_div_cancel₀ (p o d) hπ.ne']
      · rw [if_neg (fun h => hπ h.2.1), mul_zero]
        have hπ0 : π_J j = 0 := le_antisymm (not_lt.mp hπ) (hπJ_nn j)
        have ho_mem : o ∈ Finset.univ.filter (fun o' : Fin N_O => win_of o' = j) :=
          Finset.mem_filter.mpr ⟨Finset.mem_univ o, hcond.1⟩
        have hsum_le : (∑ d' : Fin N_D, p o d') ≤ π_J j :=
          Finset.single_le_sum (fun o' _ => Finset.sum_nonneg (fun d' _ => hp_nn o' d')) ho_mem
        have hpod_le : p o d ≤ ∑ d' : Fin N_D, p o d' :=
          Finset.single_le_sum (fun d' _ => hp_nn o d') (Finset.mem_univ d)
        have hpod0 : p o d = 0 := by linarith only [hp_nn o d, hpod_le, hsum_le, hπ0]
        rw [hpod0, zero_div]
    · rw [if_neg hcond, if_neg (fun h => hcond ⟨h.1, h.2.2⟩), mul_zero]

  have h_wt_nn : ∀ j o d α, 0 ≤ wt j o d α := by
    intro j o d α
    rw [h_wt j o d α]
    by_cases hcond : win_of o = j ∧ α ∈ T_cand j (Q_of j o)
    · rw [if_pos hcond]
      exact div_nonneg (hp_nn o d) (Nat.cast_nonneg _)
    · rw [if_neg hcond]

  have h_wt_pos : ∀ {j o d α}, 0 < wt j o d α →
      win_of o = j ∧ 0 < p o d ∧ α ∈ T_cand j (Q_of j o) := by
    intro j o d α hpos
    rw [h_wt j o d α] at hpos
    by_cases hcond : win_of o = j ∧ α ∈ T_cand j (Q_of j o)
    · rw [if_pos hcond] at hpos
      have hpod_ne : p o d ≠ 0 := by
        intro h0
        rw [h0, zero_div] at hpos
        exact lt_irrefl 0 hpos
      exact ⟨hcond.1, lt_of_le_of_ne (hp_nn o d) (Ne.symm hpod_ne), hcond.2⟩
    · rw [if_neg hcond] at hpos
      exact False.elim (lt_irrefl 0 hpos)

  have h_wt_sum_α : ∀ (j : Fin N_J) (o : Fin N_O) (d : Fin N_D),
      (∑ α : Fin (N_ret_of j), wt j o d α) = if win_of o = j then p o d else 0 := by
    intro j o d
    by_cases hwin : win_of o = j
    · rw [if_pos hwin]
      by_cases hpod0 : p o d = 0
      · rw [hpod0]
        refine Finset.sum_eq_zero (fun α _ => ?_)
        rw [h_wt j o d α, hpod0, zero_div, ite_self]
      · have hpod_pos : 0 < p o d := lt_of_le_of_ne (hp_nn o d) (Ne.symm hpod0)
        have hne : (T_cand j (Q_of j o)).Nonempty := by
          rw [← hwin]
          exact hT_ne o d hpod_pos
        have hcard_pos : (0 : ℝ) < ((T_cand j (Q_of j o)).card : ℝ) :=
          Nat.cast_pos.mpr (Finset.card_pos.mpr hne)
        have hsub : (∑ α ∈ T_cand j (Q_of j o), wt j o d α) = ∑ α : Fin (N_ret_of j), wt j o d α :=
          Finset.sum_subset (Finset.subset_univ _) (fun α _ hnot => by
            rw [h_wt j o d α, if_neg (fun h => hnot h.2)])
        rw [← hsub]
        have hcongr : (∑ α ∈ T_cand j (Q_of j o), wt j o d α) =
            ∑ _α ∈ T_cand j (Q_of j o), (p o d / ((T_cand j (Q_of j o)).card : ℝ)) :=
          Finset.sum_congr rfl (fun α hα => by rw [h_wt j o d α, if_pos ⟨hwin, hα⟩])
        rw [hcongr, Finset.sum_const, nsmul_eq_mul, mul_div_cancel₀ (p o d) hcard_pos.ne']
    · rw [if_neg hwin]
      exact Finset.sum_eq_zero (fun α _ => by rw [h_wt j o d α, if_neg (fun h => hwin h.1)])

  have h_wt_sum_jα : ∀ (o : Fin N_O) (d : Fin N_D),
      (∑ j : Fin N_J, ∑ α : Fin (N_ret_of j), wt j o d α) = p o d := by
    intro o d
    have hcongr : (∑ j : Fin N_J, ∑ α : Fin (N_ret_of j), wt j o d α) =
        ∑ j : Fin N_J, if win_of o = j then p o d else 0 :=
      Finset.sum_congr rfl (fun j _ => h_wt_sum_α j o d)
    rw [hcongr, Finset.sum_ite_eq Finset.univ (win_of o) (fun _ => p o d),
      if_pos (Finset.mem_univ (win_of o))]

  
  have hπ_TDFTJ_nn : ∀ j ft α d, 0 ≤ π_TDFTJ j ft α d := by
    intro j ft α d
    dsimp only [π_TDFTJ]
    refine Finset.sum_nonneg (fun o _ => ?_)
    by_cases hF : F_of j o α = ft
    · rw [if_pos hF]; exact h_wt_nn j o d α
    · rw [if_neg hF]

  have hπ_TDFTJ_sum_d : ∀ j ft α, (∑ d : Fin N_D, π_TDFTJ j ft α d) = π_TFTJ j ft α := by
    intro j ft α
    dsimp only [π_TDFTJ, π_TFTJ]
    exact Finset.sum_comm

  have hπ_TDFTJ_sum_α : ∀ j ft d, (∑ α : Fin (N_ret_of j), π_TDFTJ j ft α d) = π_DFTJ j ft d := by
    intro j ft d
    dsimp only [π_TDFTJ, π_DFTJ]
    rw [Finset.sum_comm]
    exact Finset.sum_congr rfl (fun o _ => (Finset.sum_filter _ _).symm)

  have hπ_TFTJ_nn : ∀ j ft α, 0 ≤ π_TFTJ j ft α := by
    intro j ft α
    rw [← hπ_TDFTJ_sum_d]
    exact Finset.sum_nonneg (fun d _ => hπ_TDFTJ_nn j ft α d)

  have hπ_DFTJ_nn : ∀ j ft d, 0 ≤ π_DFTJ j ft d := by
    intro j ft d
    rw [← hπ_TDFTJ_sum_α]
    exact Finset.sum_nonneg (fun α _ => hπ_TDFTJ_nn j ft α d)

  have hπ_TFTJ_sum_α : ∀ j ft, (∑ α : Fin (N_ret_of j), π_TFTJ j ft α) = π_FTJ j ft := by
    intro j ft
    dsimp only [π_TFTJ, π_FTJ]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun o _ => ?_)
    rw [Finset.sum_comm]
    exact Finset.sum_congr rfl (fun d _ => (Finset.sum_filter _ _).symm)

  have hπ_DFTJ_sum_d : ∀ j ft, (∑ d : Fin N_D, π_DFTJ j ft d) = π_FTJ j ft := by
    intro j ft
    dsimp only [π_DFTJ, π_FTJ]
    exact Finset.sum_comm

  have hπ_FTJ_nn : ∀ j ft, 0 ≤ π_FTJ j ft := by
    intro j ft
    rw [← hπ_TFTJ_sum_α]
    exact Finset.sum_nonneg (fun α _ => hπ_TFTJ_nn j ft α)

  have h_mem_S_FT : ∀ j o α, F_of j o α ∈ S_FT j := by
    intro j o α
    dsimp only [S_FT]
    exact Finset.mem_image.mpr ⟨(o, α),
      Finset.mem_product.mpr ⟨Finset.mem_univ o, Finset.mem_univ α⟩, rfl⟩

  have h_sum_ite_S_FT : ∀ (j : Fin N_J) (o : Fin N_O) (α : Fin (N_ret_of j)) (c : ℝ),
      (∑ ft ∈ S_FT j, if F_of j o α = ft then c else 0) = c := by
    intro j o α c
    rw [Finset.sum_ite_eq (S_FT j) (F_of j o α) (fun _ => c), if_pos (h_mem_S_FT j o α)]

  have hπ_FTJ_sum_ft : ∀ j : Fin N_J,
      (∑ ft ∈ S_FT j, π_FTJ j ft) =
        ∑ o : Fin N_O, ∑ d : Fin N_D, ∑ α : Fin (N_ret_of j), wt j o d α := by
    intro j
    have h1 : ∀ ft, π_FTJ j ft =
        ∑ o : Fin N_O, ∑ d : Fin N_D, ∑ α : Fin (N_ret_of j),
          if F_of j o α = ft then wt j o d α else 0 := by
      intro ft
      dsimp only [π_FTJ, wt]
      exact Finset.sum_congr rfl (fun o _ => Finset.sum_congr rfl (fun d _ => Finset.sum_filter _ _))
    rw [Finset.sum_congr rfl (fun ft _ => h1 ft), Finset.sum_comm]
    refine Finset.sum_congr rfl (fun o _ => ?_)
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun d _ => ?_)
    rw [Finset.sum_comm]
    exact Finset.sum_congr rfl (fun α _ => h_sum_ite_S_FT j o α (wt j o d α))

  have hπ_FTJ_total : (∑ j : Fin N_J, ∑ ft ∈ S_FT j, π_FTJ j ft) = 1 := by
    rw [Finset.sum_congr rfl (fun j _ => hπ_FTJ_sum_ft j), Finset.sum_comm]
    have h1 : (∑ o : Fin N_O, ∑ j : Fin N_J, ∑ d : Fin N_D, ∑ α : Fin (N_ret_of j), wt j o d α) =
        ∑ o : Fin N_O, ∑ d : Fin N_D, p o d := by
      refine Finset.sum_congr rfl (fun o _ => ?_)
      rw [Finset.sum_comm]
      exact Finset.sum_congr rfl (fun d _ => h_wt_sum_jα o d)
    exact h1.trans hp_sum

  refine ⟨?_, ?_⟩

  
  · dsimp only [I_TD_FTJ]
    refine div_nonneg (Finset.sum_nonneg (fun j _ => Finset.sum_nonneg (fun ft _ => ?_))) hell_nn
    by_cases hU : 0 < π_FTJ j ft
    · have hcongr : (∑ α : Fin (N_ret_of j), ∑ d : Fin N_D,
          if 0 < π_FTJ j ft then
            π_TDFTJ j ft α d * Real.log ((π_TDFTJ j ft α d * π_FTJ j ft) /
              (π_TFTJ j ft α * π_DFTJ j ft d))
          else 0) =
          ∑ α : Fin (N_ret_of j), ∑ d : Fin N_D,
            π_TDFTJ j ft α d * Real.log ((π_TDFTJ j ft α d * π_FTJ j ft) /
              (π_TFTJ j ft α * π_DFTJ j ft d)) :=
        Finset.sum_congr rfl (fun α _ => Finset.sum_congr rfl (fun d _ => if_pos hU))
      rw [hcongr]
      let U := π_FTJ j ft
      let u := fun α d => π_TDFTJ j ft α d
      let P_T := fun α => π_TFTJ j ft α
      let P_D := fun d => π_DFTJ j ft d
      let v := fun α d => (P_T α * P_D d) / U
      have hpt : ∀ (α : Fin (N_ret_of j)) (d : Fin N_D),
          u α d - v α d ≤ u α d * Real.log ((u α d * U) / (P_T α * P_D d)) := by
        intro α d
        by_cases hu0 : u α d = 0
        · rw [hu0, zero_mul, zero_sub, neg_le]
          rw [neg_zero]
          exact div_nonneg (mul_nonneg (hπ_TFTJ_nn j ft α) (hπ_DFTJ_nn j ft d)) hU.le
        · have hu_pos : 0 < u α d := lt_of_le_of_ne (hπ_TDFTJ_nn j ft α d) (Ne.symm hu0)
          have hPT_pos : 0 < P_T α := by
            refine lt_of_lt_of_le hu_pos ?_
            dsimp only [u, P_T]
            rw [← hπ_TDFTJ_sum_d j ft α]
            exact Finset.single_le_sum (fun d' _ => hπ_TDFTJ_nn j ft α d') (Finset.mem_univ d)
          have hPD_pos : 0 < P_D d := by
            refine lt_of_lt_of_le hu_pos ?_
            dsimp only [u, P_D]
            rw [← hπ_TDFTJ_sum_α j ft d]
            exact Finset.single_le_sum (fun α' _ => hπ_TDFTJ_nn j ft α' d) (Finset.mem_univ α)
          have hv_pos : 0 < v α d := div_pos (mul_pos hPT_pos hPD_pos) hU
          let x := v α d / u α d
          have hx_pos : 0 < x := div_pos hv_pos hu_pos
          have hlog : Real.log x = -Real.log ((u α d * U) / (P_T α * P_D d)) := by
            dsimp only [x, v]
            rw [Real.log_div hv_pos.ne' hu_pos.ne',
              Real.log_div (mul_pos hPT_pos hPD_pos).ne' hU.ne',
              Real.log_mul hPT_pos.ne' hPD_pos.ne',
              Real.log_div (mul_pos hu_pos hU).ne' (mul_pos hPT_pos hPD_pos).ne',
              Real.log_mul hu_pos.ne' hU.ne',
              Real.log_mul hPT_pos.ne' hPD_pos.ne']
            ring
          have h1 := mul_le_mul_of_nonneg_left (Real.log_le_sub_one_of_pos hx_pos) hu_pos.le
          have hlhs : u α d * Real.log x =
              -(u α d * Real.log ((u α d * U) / (P_T α * P_D d))) := by
            rw [hlog]; ring
          have hrhs : u α d * (x - 1) = v α d - u α d := by
            dsimp only [x]
            rw [mul_sub, mul_one, mul_div_cancel₀ (v α d) hu_pos.ne']
          rw [hlhs, hrhs] at h1
          linarith only [h1]
      have hsum : (∑ α : Fin (N_ret_of j), ∑ d : Fin N_D, (u α d - v α d)) ≤
          ∑ α : Fin (N_ret_of j), ∑ d : Fin N_D,
            u α d * Real.log ((u α d * U) / (P_T α * P_D d)) :=
        Finset.sum_le_sum (fun α _ => Finset.sum_le_sum (fun d _ => hpt α d))
      have hsum_u : (∑ α : Fin (N_ret_of j), ∑ d : Fin N_D, u α d) = U := by
        dsimp only [u, U]
        rw [Finset.sum_congr rfl (fun α _ => hπ_TDFTJ_sum_d j ft α), hπ_TFTJ_sum_α j ft]
      have hsum_v : (∑ α : Fin (N_ret_of j), ∑ d : Fin N_D, v α d) = U := by
        dsimp only [v, P_T, P_D, U]
        have h_in : ∀ α : Fin (N_ret_of j),
            (∑ d : Fin N_D, (π_TFTJ j ft α * π_DFTJ j ft d) / π_FTJ j ft) =
              (π_TFTJ j ft α * π_FTJ j ft) / π_FTJ j ft := by
          intro α
          rw [← Finset.sum_div, ← Finset.mul_sum, hπ_DFTJ_sum_d j ft]
        rw [Finset.sum_congr rfl (fun α _ => h_in α), ← Finset.sum_div, ← Finset.sum_mul,
          hπ_TFTJ_sum_α j ft, mul_div_cancel_right₀ (π_FTJ j ft) hU.ne']
      have hdiff_zero : (∑ α : Fin (N_ret_of j), ∑ d : Fin N_D, (u α d - v α d)) = 0 := by
        rw [Finset.sum_congr rfl (fun α _ => Finset.sum_sub_distrib _ _),
          Finset.sum_sub_distrib, hsum_u, hsum_v, sub_self]
      rw [hdiff_zero] at hsum
      exact hsum
    · exact le_of_eq (Finset.sum_eq_zero (fun α _ =>
        Finset.sum_eq_zero (fun d _ => if_neg hU))).symm

  
  · intro P_f W_f B_FTJ B_TW B_DW hB_FTJ_pos hB_TW_pos hB_DW_pos hB_FTJ hB_TW hB_DW
      p_O p_P p_PW
    
    let S_P : Finset (ℕ × (ℤ × ℤ) × (ℤ × ℤ)) := Finset.univ.image P_f
    let S_W : Finset (ℤ × ℤ) := Finset.univ.image W_f
    let S_JFT : Finset (Fin N_J × (ℕ × (ℤ × ℤ) × (ℤ × ℤ))) :=
      Finset.univ.biUnion (fun j : Fin N_J => (S_FT j).image (fun ft => (j, ft)))

    have h_sum_S_JFT : ∀ g : Fin N_J × (ℕ × (ℤ × ℤ) × (ℤ × ℤ)) → ℝ,
        (∑ u ∈ S_JFT, g u) = ∑ j : Fin N_J, ∑ ft ∈ S_FT j, g (j, ft) := by
      intro g
      dsimp only [S_JFT]
      have hdisj : ∀ j₁ ∈ (Finset.univ : Finset (Fin N_J)),
          ∀ j₂ ∈ (Finset.univ : Finset (Fin N_J)), j₁ ≠ j₂ →
            Disjoint ((S_FT j₁).image (fun ft => (j₁, ft)))
              ((S_FT j₂).image (fun ft => (j₂, ft))) := by
        intro j₁ _ j₂ _ hne
        refine Finset.disjoint_left.mpr (fun u hu₁ hu₂ => ?_)
        obtain ⟨ft₁, _, h1⟩ := Finset.mem_image.mp hu₁
        obtain ⟨ft₂, _, h2⟩ := Finset.mem_image.mp hu₂
        exact hne ((congrArg Prod.fst h1).trans (congrArg Prod.fst h2).symm)
      rw [Finset.sum_biUnion hdisj]
      refine Finset.sum_congr rfl (fun j _ => ?_)
      exact Finset.sum_image (fun ft₁ _ ft₂ _ h => congrArg Prod.snd h)

    have h_mem_S_P : ∀ o : Fin N_O, P_f o ∈ S_P :=
      fun o => Finset.mem_image_of_mem P_f (Finset.mem_univ o)
    have h_mem_S_W : ∀ o : Fin N_O, W_f o ∈ S_W :=
      fun o => Finset.mem_image_of_mem W_f (Finset.mem_univ o)

    have h_sum_ite_S_P : ∀ (o : Fin N_O) (c : ℝ),
        (∑ p_c ∈ S_P, if P_f o = p_c then c else 0) = c := by
      intro o c
      rw [Finset.sum_ite_eq S_P (P_f o) (fun _ => c), if_pos (h_mem_S_P o)]

    have h_sum_ite_S_W : ∀ (o : Fin N_O) (c : ℝ),
        (∑ w ∈ S_W, if W_f o = w then c else 0) = c := by
      intro o c
      rw [Finset.sum_ite_eq S_W (W_f o) (fun _ => c), if_pos (h_mem_S_W o)]

    have h_sum_and_S_W : ∀ (o : Fin N_O) (p_c : ℕ × (ℤ × ℤ) × (ℤ × ℤ)) (c : ℝ),
        (∑ w ∈ S_W, if P_f o = p_c ∧ W_f o = w then c else 0) =
          if P_f o = p_c then c else 0 := by
      intro o p_c c
      by_cases hp : P_f o = p_c
      · have hcongr : (∑ w ∈ S_W, if P_f o = p_c ∧ W_f o = w then c else 0) =
            ∑ w ∈ S_W, if W_f o = w then c else 0 := by
          refine Finset.sum_congr rfl (fun w _ => ?_)
          by_cases hw : W_f o = w
          · rw [if_pos ⟨hp, hw⟩, if_pos hw]
          · rw [if_neg (fun h => hw h.2), if_neg hw]
        rw [if_pos hp, hcongr, h_sum_ite_S_W o c]
      · rw [if_neg hp]
        exact Finset.sum_eq_zero (fun w _ => if_neg (fun h => hp h.1))

    have h_sum_and_S_P : ∀ (o : Fin N_O) (w : ℤ × ℤ) (c : ℝ),
        (∑ p_c ∈ S_P, if P_f o = p_c ∧ W_f o = w then c else 0) =
          if W_f o = w then c else 0 := by
      intro o w c
      by_cases hw : W_f o = w
      · have hcongr : (∑ p_c ∈ S_P, if P_f o = p_c ∧ W_f o = w then c else 0) =
            ∑ p_c ∈ S_P, if P_f o = p_c then c else 0 := by
          refine Finset.sum_congr rfl (fun p_c _ => ?_)
          by_cases hp : P_f o = p_c
          · rw [if_pos ⟨hp, hw⟩, if_pos hp]
          · rw [if_neg (fun h => hp h.1), if_neg hp]
        rw [if_pos hw, hcongr, h_sum_ite_S_P o c]
      · rw [if_neg hw]
        exact Finset.sum_eq_zero (fun p_c _ => if_neg (fun h => hw h.2))

    
    let w_FT : Fin N_J → (ℕ × (ℤ × ℤ) × (ℤ × ℤ)) → Fin N_O → ℝ :=
      fun j ft o => ∑ d : Fin N_D, ∑ α : Fin (N_ret_of j),
        if F_of j o α = ft then wt j o d α else 0
    let Q_4 : (Fin N_J × (ℕ × (ℤ × ℤ) × (ℤ × ℤ))) →
