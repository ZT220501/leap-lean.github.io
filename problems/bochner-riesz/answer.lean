    · have h0 : π ω = 0 := le_antisymm (le_of_not_gt hω_pos) (hπ_nn ω)
      simp [h0]
  have h_Ew_eq : ∑ g : Fin N_G, p_G g * ((1 + γ) * b_G g + (1 - γ) * a_G g) = 0 := by
    dsimp [b_G, a_G]
    simp
  have h_score_eq :
      stdApertureScore ε γ 1 0 0 π T_idx V_part A_part c_s θ_s =
        classicalTransportScore ε γ N_ω N_T N_G π T_idx k_time G_idx b_G a_G := by
    unfold stdApertureScore classicalTransportScore
    change ((1 + γ) * 0 + (1 - γ) * 0) - finMutualInfo ε π T_idx G_raw +
        2 * finCondEntropy ε π T_idx k_time =
      (∑ g : Fin N_G, p_G g * ((1 + γ) * b_G g + (1 - γ) * a_G g)) -
        (∑ tid : Fin N_T, ∑ g : Fin N_G,
          p_TG tid g * Real.log (p_TG tid g / (p_T tid * p_G g))) / ell +
        2 * ((∑ tid : Fin N_T, ∑ k ∈ S_cells,
          -(p_TC tid k * Real.log (p_TC tid k / p_T tid))) / ell)
    rw [h_Ew_eq, h_ITG_eq, h_St_eq]
    ring
  have h_cl := h_est ε 1 1 Δ_time hε0 hε1 le_rfl le_rfl le_rfl hΔ_lo hΔ_hi
    N_ω N_T N_G π T_idx k_time G_idx V_part A_part b_G a_G e_G V_G X_G k_G
    hπ_nn hπ_sum hVA_4 hG_adm h_supp
  rw [← h_score_eq] at h_cl
  linarith

theorem row_frame_positive_orientation_growth (γ m : ℝ) (hγ₀ : 0 < γ) (hγ₁ : γ < 1) (hm : 0 < m)
    (h_two : (2 : ℝ) ∈ ValidClassicalGrowthRates γ)
    (h_gt : γ < classicalGrowthRate γ)
    (h_min : ∀ e : ℝ, IsStdSaturatedAspect γ e → m ≤ e)
    (b : ℝ → ℝ)
    (hb_dom : ∀ u ∈ Set.Icc (0 : ℝ) 1, 0 ≤ b u ∧ b u + (1 + m) * u ≤ 1 + m)
    (ε_seq : ℕ → ℝ)
    (N_ω N_T : ℕ → ℕ)
    (π_seq : ∀ k, Fin (N_ω k) → ℝ)
    (T_seq : ∀ k, Fin (N_ω k) → Fin (N_T k))
    (V_seq A_seq : ∀ k, Fin (N_T k) → EuclideanSpace ℝ (Fin 2))
    (c_seq R_seq : ∀ k, Fin (N_ω k) → ℝ)
    (hε_bounds : ∀ k, 0 < ε_seq k ∧ ε_seq k < 1 / 2)
    (hε_tendsto : Filter.Tendsto ε_seq Filter.atTop (nhds 0))
    (h_law : ∀ k, (∀ ω, 0 ≤ π_seq k ω) ∧ (∑ ω : Fin (N_ω k), π_seq k ω = 1) ∧
      (∀ tid, ‖V_seq k tid‖ ≤ 1 ∧ ‖A_seq k tid‖ ≤ 1) ∧
      (∀ ω, 0 < π_seq k ω → c_seq k ω ∈ Set.Icc (0 : ℝ) 1 ∧ |R_seq k ω| ≤ 1))
    (h_all_sat : ∀ t ∈ Set.Ioo (0 : ℝ) 1,
      Filter.Tendsto (fun k =>
        rowObsScore (ε_seq k) γ m t (b t) (π_seq k) (T_seq k) (V_seq k) (A_seq k)
          (c_seq k) (R_seq k) -
        classicalRootSupremum (ε_seq k) (1 + m) γ (N_ω k) (N_T k) (π_seq k) (T_seq k)
          (V_seq k) (A_seq k))
        Filter.atTop (nhds (classicalGrowthRate γ * t))) :
    ∃ κ : ℝ, 0 < κ ∧
      ∀ (v a δ : ℝ), 0 < v → 0 < a → v + a < 1 → 0 < δ →
        ∃ K₀ : ℕ, ∀ k : ℕ, K₀ ≤ k →
          κ * a - δ ≤ finCondEntropy (ε_seq k) (π_seq k)
            (fun ω => (T_seq k ω, dyadicTimeBin (ε_seq k) v (c_seq k ω)))
            (fun ω => dyadicRealBin (ε_seq k) (m * (v + a)) (R_seq k ω)) :=
by
  by_contra h_not
  let θ : ℕ → ℝ := fun j => 1 / ((j : ℝ) + 1)
  have hθ_pos : ∀ j : ℕ, 0 < θ j := fun j => by
    dsimp [θ]
    positivity
  let H_ent : ℝ → ℝ → ℕ → ℝ := fun v a k =>
    finCondEntropy (ε_seq k) (π_seq k)
      (fun ω => (T_seq k ω, dyadicTimeBin (ε_seq k) v (c_seq k ω)))
      (fun ω => dyadicRealBin (ε_seq k) (m * (v + a)) (R_seq k ω))
  have h_ex_stage : ∀ j : ℕ, ∃ (v a : ℝ),
      0 < v ∧ 0 < a ∧ v + a < 1 ∧
      (∃ᶠ k in Filter.atTop, H_ent v a k < θ j * a) := by
    intro j
    by_contra h_all
    apply h_not
    refine ⟨θ j, hθ_pos j, ?_⟩
    intro v a δ hv ha hva hδ
    by_contra h_no_K
    apply h_all
    refine ⟨v, a, hv, ha, hva, ?_⟩
    rw [Filter.frequently_atTop]
    intro K₀
    have h_ex_k : ∃ k : ℕ, K₀ ≤ k ∧ H_ent v a k < θ j * a - δ := by
      by_contra h_contra
      apply h_no_K
      refine ⟨K₀, fun k hk => ?_⟩
      by_contra h_lt
      exact h_contra ⟨k, hk, lt_of_not_ge h_lt⟩
    obtain ⟨k, hk, h_lt⟩ := h_ex_k
    exact ⟨k, hk, by linarith⟩
  have h_stage : ∀ j : ℕ,
      ∃ (ε_tilde : ℝ) (k_idx : ℕ)
        (π_loc : Fin (N_ω k_idx) → ℝ)
        (V_loc A_loc : Fin (N_T k_idx) → EuclideanSpace ℝ (Fin 2))
        (c_loc : Fin (N_ω k_idx) → ℝ),
        (0 < ε_tilde ∧ ε_tilde < 1 / ((j : ℝ) + 3)) ∧
        ((∀ ω, 0 ≤ π_loc ω) ∧ (∑ ω : Fin (N_ω k_idx), π_loc ω = 1) ∧
          (∀ tid, ‖V_loc tid‖ ≤ 1 ∧ ‖A_loc tid‖ ≤ 1) ∧
          (∀ ω, 0 < π_loc ω → c_loc ω ∈ Set.Icc (0 : ℝ) 1)) ∧
        (classicalGrowthRate γ - 5 * θ j ≤
          stdApertureScore ε_tilde γ 1 0 0 π_loc (T_seq k_idx) V_loc A_loc c_loc (fun _ => 0) -
            classicalRootSupremum ε_tilde 1 γ (N_ω k_idx) (N_T k_idx)
              π_loc (T_seq k_idx) V_loc A_loc ∧
         stdApertureScore ε_tilde γ 1 0 0 π_loc (T_seq k_idx) V_loc A_loc c_loc (fun _ => 0) -
            classicalRootSupremum ε_tilde 1 γ (N_ω k_idx) (N_T k_idx)
              π_loc (T_seq k_idx) V_loc A_loc ≤
          classicalGrowthRate γ + 5 * θ j) := by
    intro j
    obtain ⟨v, a, hv, ha, hva, h_freq⟩ := h_ex_stage j
    let r : ℝ := v
    let t : ℝ := v + a
    have hr_pos : 0 < r := hv
    have hrt : r < t := by dsimp [r, t]; linarith
    have ht_lt1 : t < 1 := hva
    have htr_eq : t - r = a := by dsimp [r, t]; ring
    have ht_ioo : t ∈ Set.Ioo (0 : ℝ) 1 := ⟨by linarith, ht_lt1⟩
    have ht_icc : t ∈ Set.Icc (0 : ℝ) 1 := ⟨by linarith, ht_lt1.le⟩
    have hb_t : 0 ≤ b t ∧ b t + (1 + m) * t ≤ 1 + m := hb_dom t ht_icc
    have hθj : 0 < θ j := hθ_pos j
    have hθa : 0 < θ j * a := mul_pos hθj ha
    obtain ⟨ε_back₀, hε_back_pos, _, h_back⟩ :=
      row_localization_backward_root_composition γ m r t (θ j)
        hγ₀ hγ₁ hm h_two hr_pos hrt ht_lt1 hθj
    obtain ⟨ε_iso₀, hε_iso_pos, _, h_iso⟩ :=
      isotropic_unit_score_upper_bound γ hγ₀ hγ₁ h_two (θ j) hθj
    have hj3_pos : (0 : ℝ) < (j : ℝ) + 3 := by positivity
    let ε_tilde_cap : ℝ := min (1 / ((j : ℝ) + 3)) ε_iso₀
    have h_cap_pos : 0 < ε_tilde_cap := lt_min (div_pos zero_lt_one hj3_pos) hε_iso_pos
    let ε_req : ℝ := min ε_back₀ (min (ε_tilde_cap ^ (1 / a)) (Real.exp (-16 / (a * θ j))))
    have h_req_pos : 0 < ε_req :=
      lt_min hε_back_pos
        (lt_min (Real.rpow_pos_of_pos h_cap_pos (1 / a)) (Real.exp_pos _))
    have h_ev_eps : ∀ᶠ k in Filter.atTop, ε_seq k < ε_req := by
      have h_lim := hε_tendsto
      rw [Metric.tendsto_atTop] at h_lim
      obtain ⟨K₁, hK₁⟩ := h_lim ε_req h_req_pos
      rw [Filter.eventually_atTop]
      refine ⟨K₁, fun k hk => ?_⟩
      have hdist := hK₁ k hk
      rw [Real.dist_eq, sub_zero, abs_of_pos (hε_bounds k).1] at hdist
      exact hdist
    have h_ev_sat : ∀ᶠ k in Filter.atTop,
        classicalGrowthRate γ * t +
          classicalRootSupremum (ε_seq k) (1 + m) γ (N_ω k) (N_T k) (π_seq k) (T_seq k)
            (V_seq k) (A_seq k) -
          rowObsScore (ε_seq k) γ m t (b t) (π_seq k) (T_seq k) (V_seq k) (A_seq k)
            (c_seq k) (R_seq k) < θ j * a := by
      have h_lim := h_all_sat t ht_ioo
      rw [Metric.tendsto_atTop] at h_lim
      obtain ⟨K₂, hK₂⟩ := h_lim (θ j * a) hθa
      rw [Filter.eventually_atTop]
      refine ⟨K₂, fun k hk => ?_⟩
      have hdist := hK₂ k hk
      rw [Real.dist_eq] at hdist
      have h_lt := (abs_lt.mp hdist).1
      linarith
    obtain ⟨k, ⟨hε_lt_req, h_glob_def⟩, hH_lt⟩ :=
      ((h_ev_eps.and h_ev_sat).and_frequently h_freq).exists
    let ε : ℝ := ε_seq k
    have hε₀ : 0 < ε := (hε_bounds k).1
    have hε₁ : ε < 1 / 2 := (hε_bounds k).2
    have hε_back : ε < ε_back₀ := lt_of_lt_of_le hε_lt_req (min_le_left _ _)
    have hε_pow : ε < ε_tilde_cap ^ (1 / a) :=
      lt_of_lt_of_le hε_lt_req (le_trans (min_le_right _ _) (min_le_left _ _))
    have hε_exp : ε < Real.exp (-16 / (a * θ j)) :=
      lt_of_lt_of_le hε_lt_req (le_trans (min_le_right _ _) (min_le_right _ _))
    let ε_tilde : ℝ := ε ^ (t - r)
    have hε_tilde_pos : 0 < ε_tilde := Real.rpow_pos_of_pos hε₀ (t - r)
    have hε_tilde_lt_cap : ε_tilde < ε_tilde_cap := by
      dsimp [ε_tilde]
      rw [htr_eq]
      have h1 : ε ^ a < (ε_tilde_cap ^ (1 / a)) ^ a :=
        Real.rpow_lt_rpow hε₀.le hε_pow ha
      rw [← Real.rpow_mul h_cap_pos.le, one_div_mul_cancel ha.ne', Real.rpow_one] at h1
      exact h1
    have hε_tilde_lt_j3 : ε_tilde < 1 / ((j : ℝ) + 3) :=
      lt_of_lt_of_le hε_tilde_lt_cap (min_le_left _ _)
    have hε_tilde_lt_iso : ε_tilde < ε_iso₀ :=
      lt_of_lt_of_le hε_tilde_lt_cap (min_le_right _ _)
    have hε_tilde_half : ε_tilde < 1 / 2 := by
      have hj_nn : (0 : ℝ) ≤ (j : ℝ) := Nat.cast_nonneg j
      have h_lt23 : (2 : ℝ) < (j : ℝ) + 3 := by linarith
      exact lt_trans hε_tilde_lt_j3 (one_div_lt_one_div_of_lt (by norm_num) h_lt23)
    have h_log_err : 16 / Real.log (ε⁻¹) < θ j * a := by
      have h_log_lt : Real.log ε < -16 / (a * θ j) := by
        have h1 := Real.log_lt_log hε₀ hε_exp
        rwa [Real.log_exp] at h1
      have h_aθ_pos : 0 < a * θ j := mul_pos ha hθj
      have h_log_inv_gt : 16 / (a * θ j) < Real.log (ε⁻¹) := by
        rw [neg_div] at h_log_lt
        rw [Real.log_inv]
        linarith
      have h_log_inv_pos : 0 < Real.log (ε⁻¹) :=
        lt_trans (div_pos (by norm_num) h_aθ_pos) h_log_inv_gt
      rw [div_lt_iff₀ h_log_inv_pos]
      have h_mul := (div_lt_iff₀ h_aθ_pos).mp h_log_inv_gt
      linarith
    obtain ⟨hπ_nn, hπ_sum, hVA, hcR⟩ := h_law k
    obtain ⟨h_fib_adm, _, h_fwd⟩ :=
      row_localization_forward_score_bound γ m ε r t (b t)
        hγ₀ hγ₁ hm hε₀ hε₁ hr_pos hrt ht_lt1 hε_tilde_half hb_t.1
        (π_seq k) (T_seq k) (V_seq k) (A_seq k) (c_seq k) (R_seq k)
        hπ_nn hπ_sum hVA hcR
    have h_bwd :=
      h_back ε (b t) hε₀ hε_back hε_tilde_half hb_t.1 hb_t.2
        (fun R_bar X_bar Y_bar W_bar Z_bar C_r Δ_r B A e_φ V_D A_D
            hR hΔ₀ hΔ_ub hB₀ hBA hA₁ he_φ =>
          shear_svd_aperture_bound_2d γ m ε r t (b t)
            hγ₀ hγ₁ hm hε₀ hε₁ hr_pos hrt hb_t.1 hb_t.2
            R_bar X_bar Y_bar W_bar Z_bar C_r Δ_r B A e_φ V_D A_D
            hR hΔ₀ hΔ_ub hB₀ hBA hA₁ he_φ)
        (π_seq k) (T_seq k) (V_seq k) (A_seq k) (c_seq k) (R_seq k)
        hπ_nn hπ_sum hVA hcR
    let J := fun ω : Fin (N_ω k) =>
      rowGrowthCell ε m r t (b t) (V_seq k (T_seq k ω)) (A_seq k (T_seq k ω))
        (c_seq k ω) (R_seq k ω)
    let S_pos : Finset (Fin (N_ω k)) :=
      Finset.univ.filter (fun ω : Fin (N_ω k) => 0 < π_seq k ω)
    let S_J : Finset (ℤ × ℤ × ℤ × ℤ × ℤ × ℤ) := S_pos.image J
    let p_J := fun j₀ => ∑ ω : Fin (N_ω k), if J ω = j₀ then π_seq k ω else 0
    let π_j := fun j₀ =>
      rowGrowthRestrictLaw (π_seq k) (Finset.univ.filter (fun ω => J ω = j₀))
    let V_j := fun j₀ tid => rowGrowthLocVel ε m t (b t) j₀ (V_seq k tid)
    let A_j := fun j₀ tid => rowGrowthLocPos ε m r t (b t) j₀ (V_seq k tid) (A_seq k tid)
    let c_j := fun (j₀ : ℤ × ℤ × ℤ × ℤ × ℤ × ℤ) ω =>
      rowGrowthLocTime ε r j₀.1 (c_seq k ω)
    have hp_J_eq_filter : ∀ j₀ : ℤ × ℤ × ℤ × ℤ × ℤ × ℤ,
        p_J j₀ = ∑ ω ∈ S_pos with J ω = j₀, π_seq k ω := by
      intro j₀
      rw [Finset.sum_filter]
      refine (Finset.sum_subset (Finset.subset_univ S_pos) ?_).symm
      intro ω _ hω_not
      have h_le : π_seq k ω ≤ 0 := by
        by_contra h_gt_zero
        exact hω_not (Finset.mem_filter.mpr ⟨Finset.mem_univ ω, lt_of_not_ge h_gt_zero⟩)
      have h_zero : π_seq k ω = 0 := le_antisymm h_le (hπ_nn ω)
      simp [h_zero]
    have hS_pos_sum : ∑ ω ∈ S_pos, π_seq k ω = 1 := by
      rw [← hπ_sum]
      refine Finset.sum_subset (Finset.subset_univ S_pos) ?_
      intro ω _ hω_not
      have h_le : π_seq k ω ≤ 0 := by
        by_contra h_gt_zero
        exact hω_not (Finset.mem_filter.mpr ⟨Finset.mem_univ ω, lt_of_not_ge h_gt_zero⟩)
      exact le_antisymm h_le (hπ_nn ω)
    have hp_J_sum : ∑ j₀ ∈ S_J, p_J j₀ = 1 := by
      calc ∑ j₀ ∈ S_J, p_J j₀
          = ∑ j₀ ∈ S_J, ∑ ω ∈ S_pos with J ω = j₀, π_seq k ω :=
            Finset.sum_congr rfl (fun j₀ _ => hp_J_eq_filter j₀)
        _ = ∑ ω ∈ S_pos, π_seq k ω :=
            Finset.sum_fiberwise_of_maps_to
              (fun ω hω => Finset.mem_image_of_mem J hω) (π_seq k)
        _ = 1 := hS_pos_sum
    have hSJ_ne : S_J.Nonempty := by
      by_contra h_empty
      rw [Finset.not_nonempty_iff_eq_empty.mp h_empty, Finset.sum_empty] at hp_J_sum
      norm_num at hp_J_sum
    let Δ_loc : (ℤ × ℤ × ℤ × ℤ × ℤ × ℤ) → ℝ := fun j₀ =>
      classicalGrowthRate γ +
        classicalRootSupremum ε_tilde 1 γ (N_ω k) (N_T k)
          (π_j j₀) (T_seq k) (V_j j₀) (A_j j₀) -
        stdApertureScore ε_tilde γ 1 0 0
          (π_j j₀) (T_seq k) (V_j j₀) (A_j j₀) (c_j j₀) (fun _ => 0)
    have h_sum_Δ_split :
        ∑ j₀ ∈ S_J, p_J j₀ * Δ_loc j₀ =
          classicalGrowthRate γ +
          (∑ j₀ ∈ S_J, p_J j₀ *
            classicalRootSupremum ε_tilde 1 γ (N_ω k) (N_T k)
              (π_j j₀) (T_seq k) (V_j j₀) (A_j j₀)) -
          (∑ j₀ ∈ S_J, p_J j₀ *
            stdApertureScore ε_tilde γ 1 0 0
              (π_j j₀) (T_seq k) (V_j j₀) (A_j j₀) (c_j j₀) (fun _ => 0)) := by
      have h1 : ∀ j₀ : ℤ × ℤ × ℤ × ℤ × ℤ × ℤ,
          p_J j₀ * Δ_loc j₀ =
            p_J j₀ * classicalGrowthRate γ +
            p_J j₀ * classicalRootSupremum ε_tilde 1 γ (N_ω k) (N_T k)
              (π_j j₀) (T_seq k) (V_j j₀) (A_j j₀) -
            p_J j₀ * stdApertureScore ε_tilde γ 1 0 0
              (π_j j₀) (T_seq k) (V_j j₀) (A_j j₀) (c_j j₀) (fun _ => 0) := by
        intro j₀
        dsimp [Δ_loc]
        ring
      simp_rw [h1, Finset.sum_sub_distrib, Finset.sum_add_distrib,
        ← Finset.sum_mul, hp_J_sum, one_mul]
    have h_mul_bound : a * (∑ j₀ ∈ S_J, p_J j₀ * Δ_loc j₀) ≤ a * (5 * θ j) := by
      have h_id : a * (∑ j₀ ∈ S_J, p_J j₀ * Δ_loc j₀) =
          classicalGrowthRate γ * (t - r) +
          (t - r) * (∑ j₀ ∈ S_J, p_J j₀ *
            classicalRootSupremum ε_tilde 1 γ (N_ω k) (N_T k)
              (π_j j₀) (T_seq k) (V_j j₀) (A_j j₀)) -
          (t - r) * (∑ j₀ ∈ S_J, p_J j₀ *
            stdApertureScore ε_tilde γ 1 0 0
              (π_j j₀) (T_seq k) (V_j j₀) (A_j j₀) (c_j j₀) (fun _ => 0)) := by
        rw [← htr_eq, h_sum_Δ_split]
        ring
      have h_rate_id : classicalGrowthRate γ * (t - r) + classicalGrowthRate γ * r =
          classicalGrowthRate γ * t := by ring
      have h_a_id : (t - r) * θ j = θ j * a := by
        rw [htr_eq]
        ring
      dsimp only [H_ent] at hH_lt
      change rowObsScore ε γ m t (b t) (π_seq k) (T_seq k) (V_seq k) (A_seq k)
          (c_seq k) (R_seq k) ≤
        ((2 * b t + (1 - γ) * m * t) -
          finMutualInfo ε (π_seq k) (T_seq k) J +
          2 * finCondEntropy ε (π_seq k) (T_seq k) (fun ω => dyadicTimeBin ε r (c_seq k ω))) +
        (t - r) * (∑ j₀ ∈ S_J, p_J j₀ *
          stdApertureScore ε_tilde γ 1 0 0
            (π_j j₀) (T_seq k) (V_j j₀) (A_j j₀) (c_j j₀) (fun _ => 0)) +
        2 * finCondEntropy ε (π_seq k)
          (fun ω => (T_seq k ω, dyadicTimeBin ε r (c_seq k ω)))
          (fun ω => dyadicRealBin ε (m * t) (R_seq k ω)) +
        16 / Real.log (ε⁻¹) at h_fwd
      change ((2 * b t + (1 - γ) * m * t) -
          finMutualInfo ε (π_seq k) (T_seq k) J +
          2 * finCondEntropy ε (π_seq k) (T_seq k) (fun ω => dyadicTimeBin ε r (c_seq k ω))) +
        (t - r) * (∑ j₀ ∈ S_J, p_J j₀ *
          classicalRootSupremum ε_tilde 1 γ (N_ω k) (N_T k)
            (π_j j₀) (T_seq k) (V_j j₀) (A_j j₀)) ≤
        classicalRootSupremum ε (1 + m) γ (N_ω k) (N_T k)
          (π_seq k) (T_seq k) (V_seq k) (A_seq k) +
          classicalGrowthRate γ * r + (t - r) * θ j at h_bwd
      change classicalGrowthRate γ * t +
          classicalRootSupremum ε (1 + m) γ (N_ω k) (N_T k)
            (π_seq k) (T_seq k) (V_seq k) (A_seq k) -
          rowObsScore ε γ m t (b t) (π_seq k) (T_seq k) (V_seq k) (A_seq k)
            (c_seq k) (R_seq k) < θ j * a at h_glob_def
      change finCondEntropy ε (π_seq k)
          (fun ω => (T_seq k ω, dyadicTimeBin ε r (c_seq k ω)))
          (fun ω => dyadicRealBin ε (m * t) (R_seq k ω)) < θ j * a at hH_lt
      linarith
    have h_avg_bound : ∑ j₀ ∈ S_J, p_J j₀ * Δ_loc j₀ ≤ 5 * θ j :=
      le_of_mul_le_mul_left h_mul_bound ha
    obtain ⟨j_star, hj_star_mem, hj_star_min⟩ := Finset.exists_min_image S_J Δ_loc hSJ_ne
