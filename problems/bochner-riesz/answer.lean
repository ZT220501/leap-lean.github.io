      linarith [hκ_le_η8', hη_t1_le_α, hη_t1_pos, hα₁_pos, hα_def]
    have h_strict := Real.rpow_lt_rpow_of_exponent_gt hρ_t_pos hρ_t_lt_one h_exp_lt
    linarith [h_res, h_strict]
  · 
    intro ha2_lt1
    by_contra h_not
    push_neg at h_not
    have ha1_gt1 : 1 < a_pt 1 := by linarith
