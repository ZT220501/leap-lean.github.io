        · rw [Finset.mul_sum]
          exact Finset.sum_congr rfl (fun s _ => by ring)
      unfold generalPacketScore
      change (∑ o : Fin N_O, -(p_O o * Real.log (p_O o))) / ell +
          (1 / 2) * ((∑ o : Fin N_O, ∑ d : Fin N_D, -(p o d * Real.log (p o d / p_D d))) / ell) +
          (3 / 2) * ((∑ o : Fin N_O, p_O o * Real.log (m_obs o)) / ell) +
          (1 / 2) * (∑ d : Fin N_D, p_D d * ((1 + γ) * b_D d + (1 - γ) * a_D d)) ≤
          (∑ s : Fin M_split, α s * Score s) + (3 / 2) * (Real.log (M_split : ℝ) / ell)
      rw [h_avg_expand, ← h_Emass_lin, ← h_Ew_lin]
      have hd1 := div_le_div_of_nonneg_right h_HO_sum hell_pos.le
      have hd2 := div_le_div_of_nonneg_right h_HOD_sum hell_pos.le
      rw [add_div] at hd1 hd2
      linarith only [hd1, hd2]
    
    have hex_s : ∃ s : Fin M_split, 0 < α s ∧ (∑ s' : Fin M_split, α s' * Score s') ≤ Score s := by
      by_contra h_none
      push_neg at h_none
      have hex_pos : ∃ s₀ : Fin M_split, 0 < α s₀ := by
        by_contra hall_le
        push_neg at hall_le
        have hall0 : ∀ s ∈ (Finset.univ : Finset (Fin M_split)), α s = 0 :=
          fun s _ => le_antisymm (hall_le s) (hα_nn s)
        have h0 : ∑ s : Fin M_split, α s = 0 := Finset.sum_eq_zero hall0
        linarith [hα_sum, h0]
      obtain ⟨s₀, hs₀_pos⟩ := hex_pos
      let M_avg := ∑ s' : Fin M_split, α s' * Score s'
      have h_le_all : ∀ s ∈ (Finset.univ : Finset (Fin M_split)), α s * Score s ≤ α s * M_avg := by
        intro s _
        by_cases h0 : α s = 0
        · simp [h0]
        · have hpos : 0 < α s := lt_of_le_of_ne (hα_nn s) (Ne.symm h0)
