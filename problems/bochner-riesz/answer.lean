        (∑ i : Fin N_P, ∑ b : Fin N_Θ, π_tilde i b = 1) →
        (∀ i b, 0 < π_tilde i b →
          0 < π_orig i b ∧
          |(θ_lbl b).1 * e_n 0 + (θ_lbl b).2 * e_n 1 - c₀| ≤ ρ_tilde) →
        (∀ i b, π_tilde i b ≤ 512 * ρ ^ (-κ) * (∑ b', π_tilde i b') * (∑ i', π_tilde i' b)) →
        (∀ b : Fin N_Θ,
          let lam_t := ∑ i, π_tilde i b
          let lam_o := ∑ i, π_orig i b
          0 < lam_t → 0 < lam_o ∧ ∀ i : Fin N_P, π_tilde i b / lam_t ≤ 8 * (π_orig i b / lam_o)) →
        (∀ (a₀ r : ℝ), ρ_tilde ≤ r → r ≤ 1 →
          letI := Classical.propDecidable
          (∑ b : Fin N_Θ,
            if |(θ_lbl b).1 * (perp2D e_n 0) + (θ_lbl b).2 * (perp2D e_n 1) - a₀| < r
            then (∑ i, π_tilde i b) else 0) ≤ ρ_tilde ^ (-η) * r ^ s) →
        ρ_tilde ^ (-min 1 (min (q - 1 + z) ((q - 1 + z + s) / 2)) + α / 2) ≤
          ρ ^ (-κ) * ρ_tilde ^ (-z) :=
by
  let _ := h_core
  
  obtain ⟨η₀, ρ₀, hη₀, hρ₀_pos, hρ₀_half, h_wt_app⟩ :=
    h_proj (q - 1 + z) s (α / 2) 200 200
      (by linarith) (by linarith) hs₀ hs₁ (half_pos hα) (by norm_num) (by norm_num)
  let η : ℝ := η₀ / 8
