    constructor
    · intro d hd_unit d_perp S k_U
      obtain ⟨hd_sq, _, _⟩ := h_unit_props d hd_unit
      let m₀ : ℝ := (k_U.1 : ℝ) + 1 / 2
      let m₁ : ℝ := (k_U.2 : ℝ) + 1 / 2
      let μ_n : ℝ := -(d 1) * m₀ + d 0 * m₁
      let μ_l : ℝ := d 0 * m₀ + d 1 * m₁
      let n₀ : ℤ := ⌊μ_n⌋
      let l₀ : ℤ := ⌊μ_l⌋
      let box13 : Finset (ℤ × ℤ) :=
        Finset.Icc (n₀ - 6) (n₀ + 6) ×ˢ Finset.Icc (l₀ - 6) (l₀ + 6)
      have h_sub : S.filter (fun nl : ℤ × ℤ =>
          let u_star0 := ((nl.2 : ℝ) + 1 / 2) * d 0 + ((nl.1 : ℝ) + 1 / 2) * d_perp 0
          let u_star1 := ((nl.2 : ℝ) + 1 / 2) * d 1 + ((nl.1 : ℝ) + 1 / 2) * d_perp 1
          ⌊u_star0⌋ - 3 ≤ k_U.1 ∧ k_U.1 ≤ ⌊u_star0⌋ + 3 ∧
          ⌊u_star1⌋ - 3 ≤ k_U.2 ∧ k_U.2 ≤ ⌊u_star1⌋ + 3) ⊆ box13 := by
        intro nl hnl
        obtain ⟨_, hb0_lo, hb0_hi, hb1_lo, hb1_hi⟩ := Finset.mem_filter.mp hnl
        let u₀ : ℝ := ((nl.2 : ℝ) + 1 / 2) * d 0 + ((nl.1 : ℝ) + 1 / 2) * d_perp 0
        let u₁ : ℝ := ((nl.2 : ℝ) + 1 / 2) * d 1 + ((nl.1 : ℝ) + 1 / 2) * d_perp 1
        change ⌊u₀⌋ - 3 ≤ k_U.1 at hb0_lo
        change k_U.1 ≤ ⌊u₀⌋ + 3 at hb0_hi
        change ⌊u₁⌋ - 3 ≤ k_U.2 at hb1_lo
        change k_U.2 ≤ ⌊u₁⌋ + 3 at hb1_hi
        have h0_lo_r : ((⌊u₀⌋ : ℝ) - 3) ≤ (k_U.1 : ℝ) := by exact_mod_cast hb0_lo
        have h0_hi_r : (k_U.1 : ℝ) ≤ (⌊u₀⌋ : ℝ) + 3 := by exact_mod_cast hb0_hi
        have h1_lo_r : ((⌊u₁⌋ : ℝ) - 3) ≤ (k_U.2 : ℝ) := by exact_mod_cast hb1_lo
        have h1_hi_r : (k_U.2 : ℝ) ≤ (⌊u₁⌋ : ℝ) + 3 := by exact_mod_cast hb1_hi
        have hu₀_fl := Int.floor_le u₀
        have hu₀_lt := Int.lt_floor_add_one u₀
        have hu₁_fl := Int.floor_le u₁
        have hu₁_lt := Int.lt_floor_add_one u₁
        have h_diff0 : (u₀ - m₀) ^ 2 < 16 := by
          dsimp [m₀]; nlinarith
        have h_diff1 : (u₁ - m₁) ^ 2 < 16 := by
          dsimp [m₁]; nlinarith
        have h_parseval : (((nl.2 : ℝ) + 1 / 2) - μ_l) ^ 2 +
            (((nl.1 : ℝ) + 1 / 2) - μ_n) ^ 2 =
