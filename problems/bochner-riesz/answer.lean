      (1 ≤ ∑ b : Fin S_k, ∑ o : Fin N_O, ∑ d : Fin N_D, if E_k b o d then p o d else 0) := by
    intro N_O N_D N_J S_k p win_of k_val ξ hξ _ hp_nn hp_sum hk_grid E_k
