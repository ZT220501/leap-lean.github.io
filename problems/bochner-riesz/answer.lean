          congr 1; push_cast; ring
        calc lam_sys * ρ_r ^ 2 * |C_t - C_r|
            ≤ (cls.B_sys * ε ^ (-H_P)) * ε ^ (H_P - r) * ε ^ r := by
              rw [hρ_sq]
              exact mul_le_mul
                (mul_le_mul_of_nonneg_right hlam_hi (Real.rpow_nonneg hε₀.le _))
                hCt_εr (abs_nonneg _) (by positivity)
          _ = cls.B_sys * (ε ^ (-H_P) * ε ^ (H_P - r) * ε ^ r) := by ring
          _ = cls.B_sys * ε ^ (0 : ℝ) := by
              rw [← Real.rpow_add hε₀, ← Real.rpow_add hε₀]
              congr 2; ring
          _ = cls.B_sys := by rw [Real.rpow_zero, mul_one]
      let ΔX : EuclideanSpace ℝ (Fin 2) := X_o - X_at α - (C_t - C_r) • V_at α
      let K : ℝ := σ_r⁻¹ * ‖ΔX‖
      have hRtr_ge2 : 2 ≤ R_tr := le_trans hBX_ge2 hBX_le
      have hRtr_pos : 0 < R_tr := by linarith
      have hRtr_le_K : R_tr ≤ K := by
        dsimp only [K]
        have hm := mul_le_mul_of_nonneg_left hRtr_sep (inv_nonneg.mpr hσ_r_pos.le)
        rwa [← mul_assoc, mul_comm σ_r⁻¹ R_tr, mul_assoc, inv_mul_cancel₀ hσ_r_pos.ne',
          mul_one] at hm
      have h_thresh_BX : (20 * cls.A * cls.B_sys + 4) / cls.a₀ ≤ B_X :=
        le_trans (le_max_right 2 _) (le_max_right C_cov _)
      have hK_lo : (20 * cls.A * cls.B_sys + 4) / cls.a₀ ≤ K :=
        le_trans (le_trans h_thresh_BX hBX_le) hRtr_le_K
      let L_osc : ℝ := (cls.a₀ / 2) * K
      obtain ⟨hL_pos, e, he, h_θ_props⟩ :=
        h_s4_phase Φ₀ ζ₀ h_phase lam_sys ρ_r C_r C_t
          hlam_pos hρ_r_pos hρ_r_le1 hCr_mem hCt_mem h_chirp
          (V_at α) (X_at α) X_o hK_lo
      have h_u_props := (h_s3_win (sub.ψ_at α) hψ_sm hψ_supp hψ_der).2
        ψ_o hψ_o_sm hψ_o_der (ρ_r / ρ_t)
        (div_nonneg hρ_r_pos.le hρ_t_pos.le) (div_le_one_of_le₀ hρ_r_le_t hρ_t_pos.le)
        (ρ_t⁻¹ • (V_at α - V_o)) e he
      let M_sl : ℝ := C_ibp / L_osc ^ M_ord
      have hM_sl_nn : 0 ≤ M_sl := div_nonneg hC_ibp (pow_nonneg hL_pos.le M_ord)
      have h_sl_all : ∀ y₁ ∈ Set.Icc (-4 : ℝ) 4,
          ‖∫ s : ℝ,
            (star (sub.ψ_at α (s • e + y₁ • perp2D e)) *
              ψ_o (ρ_t⁻¹ • (V_at α - V_o) + (ρ_r / ρ_t) • (s • e + y₁ • perp2D e))) *
            Complex.exp (Complex.I *
              ((lam_sys * (Φ₀ (C_t, X_o, V_at α + ρ_r • (s • e + y₁ • perp2D e)) -
                Φ₀ (C_r, X_at α, V_at α + ρ_r • (s • e + y₁ • perp2D e))) : ℝ) : ℂ))‖ ≤ M_sl := by
        intro y₁ hy₁
        obtain ⟨hθ_cd, hθ_lo, hθ_hi⟩ := h_θ_props y₁ hy₁
        obtain ⟨hu_cd, hu_supp, hu_bd⟩ := h_u_props y₁
        exact h_ibp L_osc hL_pos _ hθ_cd hθ_lo
          (fun m hm1 _hmM s hs => hθ_hi m hm1 s hs) _ hu_cd hu_supp
          (fun k _hkM s => hu_bd k s)
      have h_mass_sl := h_slice_raw e he M_sl hM_sl_nn h_sl_all
      have ha₀2_pos : 0 < cls.a₀ / 2 := half_pos ha₀
      have h_pow_L : (cls.a₀ / 2) ^ M_ord * R_tr ^ M_ord ≤ L_osc ^ M_ord := by
        rw [← mul_pow]
        exact pow_le_pow_left₀ (by positivity)
          (mul_le_mul_of_nonneg_left hRtr_le_K ha₀2_pos.le) M_ord
      have h_lhs_pos : 0 < (cls.a₀ / 2) ^ M_ord * R_tr ^ M_ord := by positivity
      have h_8M_le : 8 * M_sl ≤ (8 * C_ibp / (cls.a₀ / 2) ^ M_ord) * (R_tr ^ M_ord)⁻¹ := by
        dsimp only [M_sl]
        calc 8 * (C_ibp / L_osc ^ M_ord)
            = (8 * C_ibp) / L_osc ^ M_ord := by ring
          _ ≤ (8 * C_ibp) / ((cls.a₀ / 2) ^ M_ord * R_tr ^ M_ord) :=
              div_le_div_of_nonneg_left (by positivity) h_lhs_pos h_pow_L
          _ = (8 * C_ibp / (cls.a₀ / 2) ^ M_ord) * (R_tr ^ M_ord)⁻¹ := by
              rw [div_mul_eq_div_div, div_eq_mul_inv]
      have h_sq_le : (8 * M_sl) ^ 2 ≤
          ((8 * C_ibp / (cls.a₀ / 2) ^ M_ord) ^ 2) * ((R_tr ^ M_ord)⁻¹) ^ 2 := by
        calc (8 * M_sl) ^ 2
            ≤ ((8 * C_ibp / (cls.a₀ / 2) ^ M_ord) * (R_tr ^ M_ord)⁻¹) ^ 2 :=
              pow_le_pow_left₀ (by positivity) h_8M_le 2
          _ = ((8 * C_ibp / (cls.a₀ / 2) ^ M_ord) ^ 2) * ((R_tr ^ M_ord)⁻¹) ^ 2 := mul_pow _ _ 2
      have h_rpow_eq : ((R_tr ^ M_ord)⁻¹) ^ 2 = R_tr ^ (-(2 * (M_ord : ℝ))) := by
        rw [← Real.rpow_natCast R_tr M_ord, ← Real.rpow_neg hRtr_pos.le,
          ← Real.rpow_natCast _ 2, ← Real.rpow_mul hRtr_pos.le]
        congr 1; push_cast; ring
      rw [h_rpow_eq] at h_sq_le
      exact le_trans h_mass_sl h_sq_le

theorem slack_classical_line_exclusion (γ : ℝ) (hγ₀ : 0 < γ) (hγ₁ : γ < 1)
