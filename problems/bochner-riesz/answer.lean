        have h_upd1 : ∀ (L : Fin 3 → ℝ) (t : ℝ),
            embed34 (Function.update L 1 (L 1 + t)) =
              Function.update (Function.update (embed34 L) 1 (L 1 + t)) 2 (L 1 + t) := by
          intro L t
          ext i
          fin_cases i <;> simp [embed34, Function.update]
        have hj3 : ∀ x : Fin 3, x = 0 ∨ x = 1 ∨ x = 2 := by
          intro x
