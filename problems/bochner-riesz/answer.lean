        rw [← h_sum_fib r_Z (fun z => -(q_ZT z α * Real.log (q_ZT z α))) _]
        have hrv_le : ∀ rv : Fin N_R,
            (∑ z ∈ Finset.univ.filter (fun z => r_Z z = rv),
              -(q_ZT z α * Real.log (q_ZT z α))) ≤
              -(q_TR α rv * Real.log (q_TR α rv)) + q_TR α rv * Real.log (M_amb : ℝ) := by
          intro rv
          let S₀ := Finset.univ.filter (fun z : Fin N_Z => r_Z z = rv)
