    let A_i : ℝ × ℝ → ℝ := fun iu =>
      ∑ k : Fin n, fderiv ℝ (fderiv ℝ F) (p_fn iu) (coneBasisL n k) (coneBasisL n j_top)
    let D_i : ℝ × ℝ → ℝ := fun iu =>
      ∑ k : Fin n, fderiv ℝ (fderiv ℝ F) (p_fn iu) (coneBasisL n k) (coneBasisV n)
    have hAu_cont : Continuous A_u :=
      (continuous_finsetSum _ fun k _ =>
        continuous_const.mul
          ((h_cont_fderiv2 F hF (coneBasisL n k) (coneBasisL n j_top)).comp hp_cont)).add
        ((h_cont_fderiv2 F hF (coneBasisV n) (coneBasisL n j_top)).comp hp_cont)
    have hAi_cont : Continuous A_i :=
      continuous_finsetSum _ fun k _ =>
        (h_cont_fderiv2 F hF (coneBasisL n k) (coneBasisL n j_top)).comp hp_cont
    have hDi_cont : Continuous D_i :=
      continuous_finsetSum _ fun k _ =>
        (h_cont_fderiv2 F hF (coneBasisL n k) (coneBasisV n)).comp hp_cont
    have hA_der_u : ∀ i u : ℝ, HasDerivAt (fun u' => A_top (i, u')) (A_u (i, u)) u := by
      intro i u
      have hd := h_deriv_fderiv F hF (coneBasisL n j_top)
        (fun u' => planeEmbed n c (i, u') + η) (c, 1) u (h_curve_ver η i u)
      exact hd.congr_deriv (by simp [A_u, p_fn])
    have hA_der_i : ∀ i u : ℝ, HasDerivAt (fun i' => A_top (i', u)) (A_i (i, u)) i := by
      intro i u
      have hd := h_deriv_fderiv F hF (coneBasisL n j_top)
        (fun i' => planeEmbed n c (i', u) + η) (fun _ => 1, 0) i (h_curve_hor η u i)
      exact hd.congr_deriv (by simp [A_i, p_fn])
    have hD_der_i : ∀ i u : ℝ, HasDerivAt (fun i' => D_sm (i', u)) (D_i (i, u)) i := by
      intro i u
      have hd := h_deriv_fderiv F hF (coneBasisV n)
        (fun i' => planeEmbed n c (i', u) + η) (fun _ => 1, 0) i (h_curve_hor η u i)
      exact hd.congr_deriv (by simp [D_i, p_fn])
    let M₁ : ℝ × ℝ → ℝ := fun iu => (-A_top iu) * φ_u iu
    let M₂ : ℝ × ℝ → ℝ := fun iu => (c j_top * A_top iu + D_sm iu) * φ_i iu
    have hM₁_cont : Continuous M₁ := hA_cont.neg.mul hφu_cont
    have hM₂_cont : Continuous M₂ := ((continuous_const.mul hA_cont).add hD_cont).mul hφi_cont
    have h_rew_integrand : ∀ u i : ℝ,
        -fderiv ℝ F (planeEmbed n c (i, u) + η) (coneBasisL n j_top) *
            (deriv (fun u' => φ (i, u')) u - c j_top * deriv (fun i' => φ (i', u)) i) +
          fderiv ℝ F (planeEmbed n c (i, u) + η) (coneBasisV n) *
            deriv (fun i' => φ (i', u)) i =
        M₁ (i, u) + M₂ (i, u) := by
      intro u i
      rw [(hφ_der_u i u).deriv, (hφ_der_i i u).deriv]
      dsimp [M₁, M₂, A_top, D_sm, p_fn]
      ring
    simp_rw [h_rew_integrand]
    have h_split_in : ∀ u : ℝ,
        (∫ i in (-K)..K, (M₁ (i, u) + M₂ (i, u))) =
        (∫ i in (-K)..K, M₁ (i, u)) + (∫ i in (-K)..K, M₂ (i, u)) := fun u =>
      intervalIntegral.integral_add
        ((hM₁_cont.comp (continuous_id.prodMk continuous_const)).intervalIntegrable _ _)
        ((hM₂_cont.comp (continuous_id.prodMk continuous_const)).intervalIntegrable _ _)
    simp_rw [h_split_in]
    have hc_M₁_out : Continuous (fun u => ∫ i in (-K)..K, M₁ (i, u)) :=
      intervalIntegral.continuous_parametric_intervalIntegral_of_continuous'
        (f := fun u i => M₁ (i, u)) (hM₁_cont.comp continuous_swap) (-K) K
    have hc_M₂_out : Continuous (fun u => ∫ i in (-K)..K, M₂ (i, u)) :=
      intervalIntegral.continuous_parametric_intervalIntegral_of_continuous'
        (f := fun u i => M₂ (i, u)) (hM₂_cont.comp continuous_swap) (-K) K
    rw [intervalIntegral.integral_add (hc_M₁_out.intervalIntegrable _ _)
      (hc_M₂_out.intervalIntegrable _ _)]
    have h_part1 :
        (∫ u in δ..(1 - δ), ∫ i in (-K)..K, M₁ (i, u)) =
        ∫ u in δ..(1 - δ), ∫ i in (-K)..K, A_u (i, u) * φ (i, u) := by
      rw [← h_swap M₁ (-K) K δ (1 - δ) hK_le hδ_le hM₁_cont]
      have h_ibp_u : ∀ i : ℝ,
          (∫ u in δ..(1 - δ), M₁ (i, u)) =
          ∫ u in δ..(1 - δ), A_u (i, u) * φ (i, u) := by
        intro i
        have h_z1 : φ (i, δ) = 0 := hφ_supp (i, δ) (Or.inr (Or.inl le_rfl))
        have h_z2 : φ (i, 1 - δ) = 0 := hφ_supp (i, 1 - δ) (Or.inr (Or.inr le_rfl))
        have hibp := h_ibp_zero
          (fun u' => -A_top (i, u')) (fun u' => -A_u (i, u'))
          (fun u' => φ (i, u')) (fun u' => φ_u (i, u'))
          δ (1 - δ)
          (fun u' _ => (hA_der_u i u').neg)
          (fun u' _ => hφ_der_u i u')
          ((hAu_cont.comp (continuous_const.prodMk continuous_id)).neg)
          (hφu_cont.comp (continuous_const.prodMk continuous_id))
          (by simp [h_z1, h_z2])
        dsimp [M₁]
        rw [hibp, ← intervalIntegral.integral_neg]
        exact intervalIntegral.integral_congr fun u _ => by ring
      simp_rw [h_ibp_u]
      exact h_swap (fun iu => A_u iu * φ iu) (-K) K δ (1 - δ) hK_le hδ_le (hAu_cont.mul hφ_cont)
    have h_part2 :
        (∫ u in δ..(1 - δ), ∫ i in (-K)..K, M₂ (i, u)) =
        ∫ u in δ..(1 - δ), ∫ i in (-K)..K, -(c j_top * A_i (i, u) + D_i (i, u)) * φ (i, u) := by
      refine intervalIntegral.integral_congr fun u _ => ?_
      have h_z1 : φ (-K, u) = 0 := by
        refine hφ_supp (-K, u) (Or.inl ?_)
        dsimp
        rw [abs_neg]
        exact le_abs_self K
      have h_z2 : φ (K, u) = 0 := hφ_supp (K, u) (Or.inl (le_abs_self K))
      have hibp := h_ibp_zero
        (fun i' => c j_top * A_top (i', u) + D_sm (i', u))
        (fun i' => c j_top * A_i (i', u) + D_i (i', u))
        (fun i' => φ (i', u)) (fun i' => φ_i (i', u))
        (-K) K
        (fun i' _ => ((hA_der_i i' u).const_mul (c j_top)).add (hD_der_i i' u))
        (fun i' _ => hφ_der_i i' u)
        (((continuous_const.mul hAi_cont).add hDi_cont).comp
          (continuous_id.prodMk continuous_const))
        (hφi_cont.comp (continuous_id.prodMk continuous_const))
        (by simp [h_z1, h_z2])
      dsimp [M₂]
      rw [hibp, ← intervalIntegral.integral_neg]
      exact intervalIntegral.integral_congr fun i _ => by ring
    rw [h_part1, h_part2]
    let N₁ : ℝ × ℝ → ℝ := fun iu => A_u iu * φ iu
    let N₂ : ℝ × ℝ → ℝ := fun iu => -(c j_top * A_i iu + D_i iu) * φ iu
    have hN₁_cont : Continuous N₁ := hAu_cont.mul hφ_cont
    have hN₂_cont : Continuous N₂ := ((continuous_const.mul hAi_cont).add hDi_cont).neg.mul hφ_cont
    have hc_N₁_out : Continuous (fun u => ∫ i in (-K)..K, N₁ (i, u)) :=
      intervalIntegral.continuous_parametric_intervalIntegral_of_continuous'
        (f := fun u i => N₁ (i, u)) (hN₁_cont.comp continuous_swap) (-K) K
    have hc_N₂_out : Continuous (fun u => ∫ i in (-K)..K, N₂ (i, u)) :=
      intervalIntegral.continuous_parametric_intervalIntegral_of_continuous'
        (f := fun u i => N₂ (i, u)) (hN₂_cont.comp continuous_swap) (-K) K
    change 0 ≤ (∫ u in δ..(1 - δ), ∫ i in (-K)..K, N₁ (i, u)) +
      (∫ u in δ..(1 - δ), ∫ i in (-K)..K, N₂ (i, u))
    rw [← intervalIntegral.integral_add (hc_N₁_out.intervalIntegrable _ _)
      (hc_N₂_out.intervalIntegrable _ _)]
    refine intervalIntegral.integral_nonneg hδ_le fun u hu => ?_
    have hi1 : IntervalIntegrable (fun i => N₁ (i, u)) MeasureTheory.volume (-K) K :=
      (hN₁_cont.comp (continuous_id.prodMk continuous_const)).intervalIntegrable _ _
    have hi2 : IntervalIntegrable (fun i => N₂ (i, u)) MeasureTheory.volume (-K) K :=
      (hN₂_cont.comp (continuous_id.prodMk continuous_const)).intervalIntegrable _ _
    rw [← intervalIntegral.integral_add hi1 hi2]
    refine intervalIntegral.integral_nonneg hK_le fun i hi => ?_
    have hs := h_signs i u (abs_le.mpr hi) hu
    let R_top : ℝ := A_u (i, u) - c j_top * A_i (i, u) - D_i (i, u)
    have h_alg : N₁ (i, u) + N₂ (i, u) = R_top * φ (i, u) := by
      dsimp [N₁, N₂, R_top]
      ring
    rw [h_alg]
    have hR_eq : R_top =
        ∑ k ∈ (Finset.univ : Finset (Fin n)).erase j_top,
          ((c j_top - c k) *
            (-fderiv ℝ (fderiv ℝ F) (p_fn (i, u)) (coneBasisL n k) (coneBasisL n j_top)) +
            (-fderiv ℝ (fderiv ℝ F) (p_fn (i, u)) (coneBasisL n k) (coneBasisV n))) := by
      dsimp [R_top, A_u, A_i, D_i]
      have hs1 :
          (∑ k : Fin n, c k *
            fderiv ℝ (fderiv ℝ F) (p_fn (i, u)) (coneBasisL n k) (coneBasisL n j_top)) -
          c j_top * (∑ k : Fin n,
            fderiv ℝ (fderiv ℝ F) (p_fn (i, u)) (coneBasisL n k) (coneBasisL n j_top)) =
          ∑ k ∈ (Finset.univ : Finset (Fin n)).erase j_top,
            (c j_top - c k) *
              (-fderiv ℝ (fderiv ℝ F) (p_fn (i, u)) (coneBasisL n k) (coneBasisL n j_top)) := by
        rw [Finset.mul_sum, ← Finset.sum_sub_distrib,
          ← Finset.add_sum_erase Finset.univ _ (Finset.mem_univ j_top)]
        have h0 : c j_top *
            fderiv ℝ (fderiv ℝ F) (p_fn (i, u)) (coneBasisL n j_top) (coneBasisL n j_top) -
            c j_top *
            fderiv ℝ (fderiv ℝ F) (p_fn (i, u)) (coneBasisL n j_top) (coneBasisL n j_top) = 0 :=
          sub_self _
        rw [h0, zero_add]
        exact Finset.sum_congr rfl fun k _ => by ring
      have hs2 :
          ∑ k : Fin n, fderiv ℝ (fderiv ℝ F) (p_fn (i, u)) (coneBasisL n k) (coneBasisV n) =
          fderiv ℝ (fderiv ℝ F) (p_fn (i, u)) (coneBasisV n) (coneBasisL n j_top) +
          ∑ k ∈ (Finset.univ : Finset (Fin n)).erase j_top,
            fderiv ℝ (fderiv ℝ F) (p_fn (i, u)) (coneBasisL n k) (coneBasisV n) := by
        rw [← Finset.add_sum_erase Finset.univ _ (Finset.mem_univ j_top),
          h_symm F hF (p_fn (i, u)) (coneBasisL n j_top) (coneBasisV n)]
      have hs3 :
          (∑ k ∈ (Finset.univ : Finset (Fin n)).erase j_top,
            (c j_top - c k) *
              (-fderiv ℝ (fderiv ℝ F) (p_fn (i, u)) (coneBasisL n k) (coneBasisL n j_top))) -
          (∑ k ∈ (Finset.univ : Finset (Fin n)).erase j_top,
            fderiv ℝ (fderiv ℝ F) (p_fn (i, u)) (coneBasisL n k) (coneBasisV n)) =
          ∑ k ∈ (Finset.univ : Finset (Fin n)).erase j_top,
            ((c j_top - c k) *
              (-fderiv ℝ (fderiv ℝ F) (p_fn (i, u)) (coneBasisL n k) (coneBasisL n j_top)) +
              (-fderiv ℝ (fderiv ℝ F) (p_fn (i, u)) (coneBasisL n k) (coneBasisV n))) := by
        rw [← Finset.sum_sub_distrib]
        exact Finset.sum_congr rfl fun k _ => by ring
      linarith [hs1, hs2, hs3]
    have hR_nn : 0 ≤ R_top := by
      rw [hR_eq]
      refine Finset.sum_nonneg fun k hk => ?_
      have hk_ne : k ≠ j_top := (Finset.mem_erase.mp hk).1
      have hc_lt : c k < c j_top := hc_top k hk_ne
      have hf1 : fderiv ℝ (fderiv ℝ F) (p_fn (i, u)) (coneBasisL n k) (coneBasisL n j_top) ≤ 0 :=
        hs.2.2.1 k j_top hk_ne
      have hf2 : fderiv ℝ (fderiv ℝ F) (p_fn (i, u)) (coneBasisL n k) (coneBasisV n) ≤ 0 :=
        hs.2.2.2 k
      exact add_nonneg (mul_nonneg (by linarith) (by linarith)) (by linarith)
    exact mul_nonneg hR_nn (hφ_nn (i, u))
  · 
    intro F η hF
    refine ⟨?_, ?_⟩
    · intro u i₁ i₂
      have h_cont : Continuous (fun i : ℝ =>
          ∑ j : Fin n, fderiv ℝ F (planeEmbed n c (i, u) + η) (coneBasisL n j)) :=
        continuous_finsetSum _ fun j _ =>
          (h_cont_fderiv F hF (coneBasisL n j)).comp
            ((h_cont_plane.comp (continuous_id.prodMk continuous_const)).add continuous_const)
      refine (intervalIntegral.integral_eq_sub_of_hasDerivAt
        (f := fun i => F (planeEmbed n c (i, u) + η)) (fun i _ => ?_)
        (h_cont.intervalIntegrable i₁ i₂)).symm
      have hd := h_deriv_F F hF (fun i' => planeEmbed n c (i', u) + η)
        (fun _ => 1, 0) i (h_curve_hor η u i)
      exact hd.congr_deriv (by simp)
    · intro p r u₁ u₂
      have h_sh_cont : Continuous (fun u : ℝ => planeEmbed n c (r - p * u, u) + η) :=
        (h_cont_plane.comp ((continuous_const.sub (continuous_const.mul continuous_id)).prodMk
          continuous_id)).add continuous_const
      have h_cont : Continuous (fun u : ℝ =>
          (∑ j : Fin n, (c j - p) *
            fderiv ℝ F (planeEmbed n c (r - p * u, u) + η) (coneBasisL n j)) +
          fderiv ℝ F (planeEmbed n c (r - p * u, u) + η) (coneBasisV n)) :=
        (continuous_finsetSum _ fun j _ =>
          continuous_const.mul ((h_cont_fderiv F hF (coneBasisL n j)).comp h_sh_cont)).add
          ((h_cont_fderiv F hF (coneBasisV n)).comp h_sh_cont)
      refine (intervalIntegral.integral_eq_sub_of_hasDerivAt
        (f := fun u => F (planeEmbed n c (r - p * u, u) + η)) (fun u _ => ?_)
        (h_cont.intervalIntegrable u₁ u₂)).symm
      have hd := h_deriv_F F hF (fun u' => planeEmbed n c (r - p * u', u') + η)
        (fun k => c k - p, 1) u (h_curve_sh η p r u)
      exact hd.congr_deriv (by simp)

theorem strong_plane_trace_limit_extraction (n : ℕ) (hn : 2 ≤ n)
    (c d : Fin n → ℝ) (d_v : ℝ) (E_cone : Fin n → Fin n → Prop)
    (hc_inj : Function.Injective c)
    (hd_nn : (∀ j, 0 ≤ d j) ∧ 0 ≤ d_v)
    (hE_pos : ∀ j k : Fin n, E_cone j k → 0 < c k - c j)
    (P_L : Fin n → ((Fin n → ℝ) × ℝ) → ℝ)
    (P_V : ((Fin n → ℝ) × ℝ) → ℝ)
    (hP_L : ∀ j : Fin n, Measurable (P_L j) ∧ ∀ p, 0 ≤ P_L j p ∧ P_L j p ≤ d j)
    (hP_V : Measurable P_V ∧ ∀ p, 0 ≤ P_V p ∧ P_V p ≤ d_v)
    (F_seq : ℕ → ((Fin n → ℝ) × ℝ) → ℝ)
    (hF_smooth : ∀ k : ℕ, ContDiff ℝ 2 (F_seq k))
    (hF_signs : ∀ (k : ℕ) (p : (Fin n → ℝ) × ℝ),
      (∀ q : (Fin n → ℝ) × ℝ, ‖q - p‖ ≤ 2 * ((k + 2 : ℝ))⁻¹ →
        InResolutionCone n c E_cone q) →
      HasSmoothSubmodularSigns n d d_v (F_seq k) p)
    (hF_L1 : ∀ (K_c : Set ((Fin n → ℝ) × ℝ)) (r_margin : ℝ),
      MeasurableSet K_c → MeasureTheory.volume K_c < ⊤ → 0 < r_margin →
      (∀ p ∈ K_c, ∀ q : (Fin n → ℝ) × ℝ, ‖q - p‖ ≤ r_margin →
        InStrictResolutionCone n c E_cone q) →
      (∀ j : Fin n,
        Filter.Tendsto (fun k =>
          ∫ p in K_c, |fderiv ℝ (F_seq k) p (coneBasisL n j) - P_L j p|)
          Filter.atTop (nhds 0)) ∧
      Filter.Tendsto (fun k =>
        ∫ p in K_c, |fderiv ℝ (F_seq k) p (coneBasisV n) - P_V p|)
        Filter.atTop (nhds 0))
    (hF_slice_lip : ∀ (K δ : ℝ), 1 ≤ K → 0 < δ → δ < 1 / 2 →
      ∃ C_mix : ℝ, 0 ≤ C_mix ∧
        ∀ (k : ℕ) (η η' : (Fin n → ℝ) × ℝ),
          (∀ (θ i u : ℝ), θ ∈ Set.Icc (0 : ℝ) 1 →
            |i| ≤ K + 1 → u ∈ Set.Icc (δ / 2) (1 - δ / 2) →
            HasSmoothSubmodularSigns n d d_v (F_seq k)
              (planeEmbed n c (i, u) + ((1 - θ) • η + θ • η'))) →
          (∀ j : Fin n, η.1 j = 0 → η'.1 j = 0 →
            (∫ i in (-K)..K, ∫ u in δ..(1 - δ),
              |fderiv ℝ (F_seq k) (planeEmbed n c (i, u) + η) (coneBasisL n j) -
                fderiv ℝ (F_seq k) (planeEmbed n c (i, u) + η') (coneBasisL n j)|) ≤
              C_mix * ((∑ k' : Fin n, |η.1 k' - η'.1 k'|) + |η.2 - η'.2|)) ∧
          (η.2 = 0 → η'.2 = 0 →
            (∫ i in (-K)..K, ∫ u in δ..(1 - δ),
              |fderiv ℝ (F_seq k) (planeEmbed n c (i, u) + η) (coneBasisV n) -
                fderiv ℝ (F_seq k) (planeEmbed n c (i, u) + η') (coneBasisV n)|) ≤
              C_mix * (∑ k' : Fin n, |η.1 k' - η'.1 k'|))) :
    letI := Classical.propDecidable
    ∃ (a : Fin n → ℝ × ℝ → ℝ) (D : ℝ × ℝ → ℝ)
      (η_seq : ℕ → (Fin n → ℝ) × ℝ) (k_seq : ℕ → ℕ),
      (∀ j : Fin n, Measurable (a j) ∧ ∀ iu : ℝ × ℝ, 0 ≤ a j iu ∧ a j iu ≤ d j) ∧
      (Measurable D ∧ ∀ iu : ℝ × ℝ, 0 ≤ D iu ∧ D iu ≤ d_v) ∧
      (∀ (K δ R : ℝ), 1 ≤ K → 0 < δ → δ < 1 / 2 → 1 ≤ R →
        Filter.Tendsto (fun h : ℝ =>
          ∫ i in (-K)..K, ∫ u in δ..(1 - δ),
            ∫ ξ : (Fin n → ℝ) × ℝ,
              if IsStrictDispCone n c E_cone ξ ∧ (∀ j, |ξ.1 j| ≤ R) ∧ |ξ.2| ≤ R then
                (∑ j : Fin n,
                  |P_L j (planeEmbed n c (i, u) + h • ξ) - a j (i, u)|) +
                  |P_V (planeEmbed n c (i, u) + h • ξ) - D (i, u)|
              else 0)
          (nhdsWithin 0 (Set.Ioi 0)) (nhds 0)) ∧
      (∀ m : ℕ, m ≤ k_seq m ∧ ‖η_seq m‖ ≤ (2 : ℝ) ^ (-(m : ℤ))) ∧
      (∀ m : ℕ, ∀ (i u : ℝ),
        u ∈ Set.Icc ((2 * (m + 4 : ℝ))⁻¹) (1 - (2 * (m + 4 : ℝ))⁻¹) →
        ∀ q : (Fin n → ℝ) × ℝ,
          ‖q - (planeEmbed n c (i, u) + η_seq m)‖ ≤ 2 * ((k_seq m + 2 : ℝ))⁻¹ →
          InResolutionCone n c E_cone q) ∧
      (∀ m : ℕ,
        (∫ i in (-((m + 2 : ℝ)))..(m + 2 : ℝ),
          ∫ u in ((m + 4 : ℝ)⁻¹)..(1 - (m + 4 : ℝ)⁻¹),
            (∑ j : Fin n,
              |fderiv ℝ (F_seq (k_seq m))
                  (planeEmbed n c (i, u) + η_seq m) (coneBasisL n j) - a j (i, u)|) +
              |fderiv ℝ (F_seq (k_seq m))
                  (planeEmbed n c (i, u) + η_seq m) (coneBasisV n) - D (i, u)|) ≤
          (2 : ℝ) ^ (-(m : ℤ))) :=
by
  classical
  have : (MeasureTheory.volume : MeasureTheory.Measure ((Fin n → ℝ) × ℝ)).IsAddHaarMeasure :=
    MeasureTheory.Measure.prod.instIsAddHaarMeasure MeasureTheory.volume MeasureTheory.volume
  
  have h_norm_fst : ∀ (p : (Fin n → ℝ) × ℝ) (j : Fin n), |p.1 j| ≤ ‖p‖ := by
    intro p j
    calc |p.1 j| = ‖p.1 j‖ := (Real.norm_eq_abs _).symm
      _ ≤ ‖p.1‖ := norm_le_pi_norm p.1 j
      _ ≤ ‖p‖ := le_max_left ‖p.1‖ ‖p.2‖
  have h_norm_snd : ∀ p : (Fin n → ℝ) × ℝ, |p.2| ≤ ‖p‖ := by
    intro p
    calc |p.2| = ‖p.2‖ := (Real.norm_eq_abs _).symm
      _ ≤ ‖p‖ := le_max_right ‖p.1‖ ‖p.2‖
  have h_norm_le_iff : ∀ (p : (Fin n → ℝ) × ℝ) (R : ℝ), 0 ≤ R →
      (((∀ j : Fin n, |p.1 j| ≤ R) ∧ |p.2| ≤ R) ↔ ‖p‖ ≤ R) := by
    intro p R hR
    rw [Prod.norm_def, max_le_iff, pi_norm_le_iff_of_nonneg hR]
    simp only [Real.norm_eq_abs]
  let c_sum : ℝ := ∑ j : Fin n, |c j|
  have hc_sum_nn : 0 ≤ c_sum := Finset.sum_nonneg (fun _ _ => abs_nonneg _)
  have hc_le_sum : ∀ j : Fin n, |c j| ≤ c_sum :=
    fun j => Finset.single_le_sum (f := fun k : Fin n => |c k|)
      (fun _ _ => abs_nonneg _) (Finset.mem_univ j)
  let C_cone : ℝ := 2 + 2 * c_sum
  have hC_cone_ge : 2 ≤ C_cone := by
    dsimp [C_cone]
    linarith
  have hC_cone_pos : 0 < C_cone := by linarith
  let edgeSlack : Fin n → Fin n → ((Fin n → ℝ) × ℝ) → ℝ :=
    fun j₁ j₂ p => (c j₂ - c j₁) * p.2 - (p.1 j₂ - p.1 j₁)
  have h_slack_cont : ∀ j₁ j₂ : Fin n, Continuous (edgeSlack j₁ j₂) := by
    intro j₁ j₂
    exact (continuous_const.mul continuous_snd).sub
      (((continuous_apply j₂).comp continuous_fst).sub ((continuous_apply j₁).comp continuous_fst))
  have h_slack_lip : ∀ (j₁ j₂ : Fin n) (p q : (Fin n → ℝ) × ℝ),
      |edgeSlack j₁ j₂ q - edgeSlack j₁ j₂ p| ≤ C_cone * ‖q - p‖ := by
    intro j₁ j₂ p q
    have h_eq : edgeSlack j₁ j₂ q - edgeSlack j₁ j₂ p =
        (c j₂ - c j₁) * (q - p).2 - (q - p).1 j₂ + (q - p).1 j₁ := by
      dsimp [edgeSlack]
      ring
    rw [h_eq]
    have hc_diff : |c j₂ - c j₁| ≤ 2 * c_sum := by
      calc |c j₂ - c j₁| ≤ |c j₂| + |c j₁| := abs_sub _ _
        _ ≤ c_sum + c_sum := add_le_add (hc_le_sum j₂) (hc_le_sum j₁)
        _ = 2 * c_sum := by ring
    have h1 : |(c j₂ - c j₁) * (q - p).2| ≤ (2 * c_sum) * ‖q - p‖ := by
      rw [abs_mul]
      exact mul_le_mul hc_diff (h_norm_snd (q - p)) (abs_nonneg _) (by linarith)
    have h2 : |(q - p).1 j₂| ≤ ‖q - p‖ := h_norm_fst (q - p) j₂
    have h3 : |(q - p).1 j₁| ≤ ‖q - p‖ := h_norm_fst (q - p) j₁
    calc |(c j₂ - c j₁) * (q - p).2 - (q - p).1 j₂ + (q - p).1 j₁|
        ≤ |(c j₂ - c j₁) * (q - p).2 - (q - p).1 j₂| + |(q - p).1 j₁| := abs_add_le _ _
      _ ≤ |(c j₂ - c j₁) * (q - p).2| + |(q - p).1 j₂| + |(q - p).1 j₁| :=
          add_le_add (abs_sub _ _) le_rfl
      _ ≤ (2 * c_sum) * ‖q - p‖ + ‖q - p‖ + ‖q - p‖ := add_le_add (add_le_add h1 h2) h3
      _ = C_cone * ‖q - p‖ := by dsimp [C_cone]; ring
  have h_slack_lower : ∀ (j₁ j₂ : Fin n) (p q : (Fin n → ℝ) × ℝ),
      edgeSlack j₁ j₂ p - C_cone * ‖q - p‖ ≤ edgeSlack j₁ j₂ q := by
    intro j₁ j₂ p q
    have h := (abs_le.mp (h_slack_lip j₁ j₂ p q)).1
    linarith
  have h_slack_plane : ∀ (j₁ j₂ : Fin n) (iu : ℝ × ℝ),
      edgeSlack j₁ j₂ (planeEmbed n c iu) = 0 := by
    intro j₁ j₂ iu
    dsimp [edgeSlack, planeEmbed]
    ring
  have h_slack_add : ∀ (j₁ j₂ : Fin n) (p q : (Fin n → ℝ) × ℝ),
      edgeSlack j₁ j₂ (p + q) = edgeSlack j₁ j₂ p + edgeSlack j₁ j₂ q := by
    intro j₁ j₂ p q
    dsimp [edgeSlack]
    ring
  have h_slack_smul : ∀ (j₁ j₂ : Fin n) (t : ℝ) (p : (Fin n → ℝ) × ℝ),
      edgeSlack j₁ j₂ (t • p) = t * edgeSlack j₁ j₂ p := by
    intro j₁ j₂ t p
    dsimp [edgeSlack]
    ring
  have h_slack_projL : ∀ (j₁ j₂ j : Fin n) (ξ : (Fin n → ℝ) × ℝ),
      edgeSlack j₁ j₂ (coneProjZeroL n j ξ) = edgeSlack j₁ j₂ ξ := by
    intro j₁ j₂ j ξ
    dsimp [edgeSlack, coneProjZeroL]
    ring
  have h_slack_projV : ∀ (j₁ j₂ : Fin n) (ξ : (Fin n → ℝ) × ℝ),
      edgeSlack j₁ j₂ (coneProjZeroV n c ξ) = edgeSlack j₁ j₂ ξ := by
    intro j₁ j₂ ξ
    dsimp [edgeSlack, coneProjZeroV]
    ring
  have h_shift_L1 : ∀ (i u : ℝ) (j : Fin n) (ξ : (Fin n → ℝ) × ℝ),
      planeEmbed n c (i, u) + coneProjZeroL n j ξ =
        planeEmbed n c (i - ξ.1 j, u) + ξ := by
    intro i u j ξ
    ext k <;> dsimp [planeEmbed, coneProjZeroL]
    ring
  have h_shift_L2 : ∀ (i u : ℝ) (j : Fin n) (ξ : (Fin n → ℝ) × ℝ),
      planeEmbed n c (i, u) + ξ =
        planeEmbed n c (i + ξ.1 j, u) + coneProjZeroL n j ξ := by
    intro i u j ξ
    ext k <;> dsimp [planeEmbed, coneProjZeroL]
    ring
  have h_shift_V1 : ∀ (i u : ℝ) (ξ : (Fin n → ℝ) × ℝ),
      planeEmbed n c (i, u) + coneProjZeroV n c ξ =
        planeEmbed n c (i, u - ξ.2) + ξ := by
    intro i u ξ
    ext k <;> (dsimp [planeEmbed, coneProjZeroV]; ring)
  have h_shift_V2 : ∀ (i u : ℝ) (ξ : (Fin n → ℝ) × ℝ),
      planeEmbed n c (i, u) + ξ =
        planeEmbed n c (i, u + ξ.2) + coneProjZeroV n c ξ := by
    intro i u ξ
    ext k <;> (dsimp [planeEmbed, coneProjZeroV]; ring)
  have hne_off : (Finset.univ : Finset (Fin n)).offDiag.Nonempty := by
    refine ⟨(⟨0, by omega⟩, ⟨1, by omega⟩), ?_⟩
    rw [Finset.mem_offDiag]
    refine ⟨Finset.mem_univ _, Finset.mem_univ _, ?_⟩
    intro h_eq
    have : (0 : ℕ) = 1 := congrArg Fin.val h_eq
    omega
  let c_gap : ℝ := min 1
    ((Finset.univ : Finset (Fin n)).offDiag.inf' hne_off (fun jk => |c jk.2 - c jk.1|))
  have hc_gap_pos : 0 < c_gap := by
    refine lt_min zero_lt_one ?_
    rw [Finset.lt_inf'_iff]
    intro jk hjk
    rw [Finset.mem_offDiag] at hjk
    exact abs_pos.mpr (sub_ne_zero.mpr (hc_inj.ne hjk.2.2.symm))
  have hc_gap_le_one : c_gap ≤ 1 := min_le_left _ _
  have hc_gap_edge : ∀ j₁ j₂ : Fin n, E_cone j₁ j₂ → c_gap ≤ c j₂ - c j₁ := by
    intro j₁ j₂ hE
    have h_pos := hE_pos j₁ j₂ hE
    have h_ne : j₁ ≠ j₂ := by
      intro h_eq
      subst h_eq
      linarith
    have h_mem : (j₁, j₂) ∈ (Finset.univ : Finset (Fin n)).offDiag :=
      Finset.mem_offDiag.mpr ⟨Finset.mem_univ _, Finset.mem_univ _, h_ne⟩
    calc c_gap
        ≤ (Finset.univ : Finset (Fin n)).offDiag.inf' hne_off (fun jk => |c jk.2 - c jk.1|) :=
          min_le_right _ _
      _ ≤ |c j₂ - c j₁| := Finset.inf'_le (fun jk => |c jk.2 - c jk.1|) h_mem
      _ = c j₂ - c j₁ := abs_of_pos h_pos
  let r_ball : ℝ → ℝ := fun s => s * c_gap / (2 * C_cone)
  have h_cone_ball : ∀ (s : ℝ), 0 < s →
      0 < r_ball s ∧ r_ball s ≤ s / 4 ∧
      ∀ ξ ∈ Metric.ball ((0 : Fin n → ℝ), s) (r_ball s),
        ‖ξ‖ < (5 / 4) * s ∧
        (3 / 4) * s < ξ.2 ∧ ξ.2 < (5 / 4) * s ∧
        (∀ j₁ j₂ : Fin n, E_cone j₁ j₂ → (1 / 2) * s * c_gap < edgeSlack j₁ j₂ ξ) ∧
        IsStrictDispCone n c E_cone ξ := by
    intro s hs
    have hr_pos : 0 < r_ball s := div_pos (mul_pos hs hc_gap_pos) (by linarith)
    have hr_le : r_ball s ≤ s / 4 := by
      dsimp [r_ball]
      rw [div_le_div_iff₀ (by linarith) (by norm_num)]
      nlinarith [hc_gap_le_one, hC_cone_ge]
    refine ⟨hr_pos, hr_le, fun ξ hξ => ?_⟩
    rw [Metric.mem_ball, dist_eq_norm] at hξ
    have h0s_norm : ‖((0 : Fin n → ℝ), s)‖ = s := by
      rw [Prod.norm_def, norm_zero, Real.norm_eq_abs, abs_of_pos hs, max_eq_right hs.le]
    have hξ_norm : ‖ξ‖ < (5 / 4) * s := by
      calc ‖ξ‖ = ‖((0 : Fin n → ℝ), s) + (ξ - ((0 : Fin n → ℝ), s))‖ := by abel_nf
        _ ≤ ‖((0 : Fin n → ℝ), s)‖ + ‖ξ - ((0 : Fin n → ℝ), s)‖ := norm_add_le _ _
        _ < s + r_ball s := add_lt_add_of_le_of_lt (le_of_eq h0s_norm) hξ
        _ ≤ s + s / 4 := by linarith
        _ = (5 / 4) * s := by ring
    have hξ2_diff : |ξ.2 - s| < s / 4 :=
      lt_of_le_of_lt (h_norm_snd (ξ - ((0 : Fin n → ℝ), s))) (lt_of_lt_of_le hξ hr_le)
    have hξ2_lo : (3 / 4) * s < ξ.2 := by linarith [(abs_lt.mp hξ2_diff).1]
    have hξ2_hi : ξ.2 < (5 / 4) * s := by linarith [(abs_lt.mp hξ2_diff).2]
    have h_sl : ∀ j₁ j₂ : Fin n, E_cone j₁ j₂ → (1 / 2) * s * c_gap < edgeSlack j₁ j₂ ξ := by
      intro j₁ j₂ hE
      have h_center : s * c_gap ≤ edgeSlack j₁ j₂ ((0 : Fin n → ℝ), s) := by
        dsimp [edgeSlack]
        rw [sub_zero, sub_zero]
        nlinarith [hc_gap_edge j₁ j₂ hE]
      have h_cr : C_cone * r_ball s = (1 / 2) * s * c_gap := by
        dsimp [r_ball]
        field_simp [hC_cone_pos.ne']
      have h_low := h_slack_lower j₁ j₂ ((0 : Fin n → ℝ), s) ξ
      have h_mul : C_cone * ‖ξ - ((0 : Fin n → ℝ), s)‖ < C_cone * r_ball s :=
        mul_lt_mul_of_pos_left hξ hC_cone_pos
      linarith
    refine ⟨hξ_norm, hξ2_lo, hξ2_hi, h_sl, fun j₁ j₂ hE => ?_⟩
    have h_pos : 0 < edgeSlack j₁ j₂ ξ := lt_trans (by positivity) (h_sl j₁ j₂ hE)
    dsimp [edgeSlack] at h_pos
    linarith

  
  have h_plane_cont : Continuous (planeEmbed n c) :=
    (continuous_pi (fun j => continuous_fst.add (continuous_const.mul continuous_snd))).prodMk
      continuous_snd
  have h_projL_cont : ∀ j : Fin n, Continuous (coneProjZeroL n j) := by
    intro j
    change Continuous (fun ξ : (Fin n → ℝ) × ℝ => (fun k : Fin n => ξ.1 k - ξ.1 j, ξ.2))
    exact (continuous_pi (fun k =>
      ((continuous_apply (A := fun _ : Fin n => ℝ) k).comp continuous_fst).sub
        ((continuous_apply (A := fun _ : Fin n => ℝ) j).comp continuous_fst))).prodMk continuous_snd
  have h_projV_cont : Continuous (coneProjZeroV n c) :=
    (continuous_pi (fun k =>
      ((continuous_apply k).comp continuous_fst).sub
        (continuous_const.mul continuous_snd))).prodMk continuous_const
  have h_fderiv_cont : ∀ (k : ℕ) (v : (Fin n → ℝ) × ℝ),
      Continuous (fun p : (Fin n → ℝ) × ℝ => fderiv ℝ (F_seq k) p v) := by
    intro k v
    exact ((hF_smooth k).continuous_fderiv (by norm_num)).clm_apply continuous_const
  have h_rect_fin : ∀ a₁ b₁ a₂ b₂ : ℝ,
      MeasureTheory.volume (Set.Ioc a₁ b₁ ×ˢ Set.Ioc a₂ b₂) < ⊤ := by
    intro a₁ b₁ a₂ b₂
    rw [MeasureTheory.Measure.volume_eq_prod, MeasureTheory.Measure.prod_prod,
      Real.volume_Ioc, Real.volume_Ioc]
    exact ENNReal.mul_lt_top ENNReal.ofReal_lt_top ENNReal.ofReal_lt_top
  have h_rect_vol_toReal : ∀ (a₁ b₁ a₂ b₂ : ℝ), a₁ ≤ b₁ → a₂ ≤ b₂ →
      (MeasureTheory.volume (Set.Ioc a₁ b₁ ×ˢ Set.Ioc a₂ b₂)).toReal =
        (b₁ - a₁) * (b₂ - a₂) := by
    intro a₁ b₁ a₂ b₂ ha₁ ha₂
    rw [MeasureTheory.Measure.volume_eq_prod, MeasureTheory.Measure.prod_prod,
      Real.volume_Ioc, Real.volume_Ioc, ENNReal.toReal_mul,
      ENNReal.toReal_ofReal (sub_nonneg.mpr ha₁), ENNReal.toReal_ofReal (sub_nonneg.mpr ha₂)]
  have h_rect_int_bdd : ∀ (G : ℝ × ℝ → ℝ) (B a₁ b₁ a₂ b₂ : ℝ),
      Measurable G → (∀ p ∈ Set.Ioc a₁ b₁ ×ˢ Set.Ioc a₂ b₂, |G p| ≤ B) →
      MeasureTheory.IntegrableOn G (Set.Ioc a₁ b₁ ×ˢ Set.Ioc a₂ b₂) MeasureTheory.volume := by
    intro G B a₁ b₁ a₂ b₂ hG h_bd
    refine MeasureTheory.IntegrableOn.of_bound (h_rect_fin a₁ b₁ a₂ b₂)
      hG.aestronglyMeasurable.restrict |B| ?_
    filter_upwards [MeasureTheory.ae_restrict_mem
      (measurableSet_Ioc.prod measurableSet_Ioc)] with p hp
    rw [Real.norm_eq_abs]
    exact (h_bd p hp).trans (le_abs_self B)
  have h_1d_int_bdd : ∀ (g : ℝ → ℝ) (B a₁ b₁ : ℝ),
      Measurable g → (∀ x ∈ Set.Ioc a₁ b₁, |g x| ≤ B) →
      MeasureTheory.IntegrableOn g (Set.Ioc a₁ b₁) MeasureTheory.volume := by
    intro g B a₁ b₁ hg h_bd
    have h_fin : MeasureTheory.volume (Set.Ioc a₁ b₁) < ⊤ := by
      rw [Real.volume_Ioc]
      exact ENNReal.ofReal_lt_top
    refine MeasureTheory.IntegrableOn.of_bound h_fin hg.aestronglyMeasurable.restrict |B| ?_
    filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioc] with x hx
    rw [Real.norm_eq_abs]
    exact (h_bd x hx).trans (le_abs_self B)
  have h_rect_eq_prod : ∀ (G : ℝ × ℝ → ℝ) (a₁ b₁ a₂ b₂ : ℝ),
      a₁ ≤ b₁ → a₂ ≤ b₂ →
      MeasureTheory.IntegrableOn G (Set.Ioc a₁ b₁ ×ˢ Set.Ioc a₂ b₂) MeasureTheory.volume →
      (∫ i in a₁..b₁, ∫ u in a₂..b₂, G (i, u)) =
        ∫ iu in Set.Ioc a₁ b₁ ×ˢ Set.Ioc a₂ b₂, G iu := by
    intro G a₁ b₁ a₂ b₂ ha₁ ha₂ h_int
    rw [intervalIntegral.integral_of_le ha₁]
    simp_rw [intervalIntegral.integral_of_le ha₂]
    rw [MeasureTheory.Measure.volume_eq_prod] at h_int ⊢
    exact (MeasureTheory.setIntegral_prod G h_int).symm
  have h_1d_mono : ∀ (g : ℝ → ℝ) (a₁ b₁ c₁ d₁ : ℝ),
      a₁ ≤ c₁ → c₁ ≤ d₁ → d₁ ≤ b₁ → (∀ x, 0 ≤ g x) →
      MeasureTheory.IntegrableOn g (Set.Ioc a₁ b₁) MeasureTheory.volume →
      (∫ x in c₁..d₁, g x) ≤ ∫ x in a₁..b₁, g x := by
    intro g a₁ b₁ c₁ d₁ hac hcd hdb h_nn h_int
    rw [intervalIntegral.integral_of_le hcd, intervalIntegral.integral_of_le (hac.trans (hcd.trans hdb))]
    exact MeasureTheory.setIntegral_mono_set h_int (Filter.Eventually.of_forall h_nn)
      (Filter.Eventually.of_forall (Set.Ioc_subset_Ioc hac hdb))
  have h_rect_mono : ∀ (G : ℝ × ℝ → ℝ) (a₁ b₁ a₂ b₂ c₁ d₁ c₂ d₂ : ℝ),
      a₁ ≤ c₁ → c₁ ≤ d₁ → d₁ ≤ b₁ →
      a₂ ≤ c₂ → c₂ ≤ d₂ → d₂ ≤ b₂ →
      (∀ p, 0 ≤ G p) →
      MeasureTheory.IntegrableOn G (Set.Ioc a₁ b₁ ×ˢ Set.Ioc a₂ b₂) MeasureTheory.volume →
      (∫ x in c₁..d₁, ∫ y in c₂..d₂, G (x, y)) ≤
        ∫ x in a₁..b₁, ∫ y in a₂..b₂, G (x, y) := by
    intro G a₁ b₁ a₂ b₂ c₁ d₁ c₂ d₂ hac₁ hcd₁ hdb₁ hac₂ hcd₂ hdb₂ h_nn h_int
    have h_sub : Set.Ioc c₁ d₁ ×ˢ Set.Ioc c₂ d₂ ⊆ Set.Ioc a₁ b₁ ×ˢ Set.Ioc a₂ b₂ :=
      Set.prod_mono (Set.Ioc_subset_Ioc hac₁ hdb₁) (Set.Ioc_subset_Ioc hac₂ hdb₂)
    rw [h_rect_eq_prod G c₁ d₁ c₂ d₂ hcd₁ hcd₂ (h_int.mono_set h_sub),
      h_rect_eq_prod G a₁ b₁ a₂ b₂ (hac₁.trans (hcd₁.trans hdb₁)) (hac₂.trans (hcd₂.trans hdb₂)) h_int]
    exact MeasureTheory.setIntegral_mono_set h_int (Filter.Eventually.of_forall h_nn)
      (Filter.Eventually.of_forall h_sub)
  have h_fubini_3fold : ∀ (F : (ℝ × ℝ) → ((Fin n → ℝ) × ℝ) → ℝ) (B a₁ b₁ a₂ b₂ : ℝ),
      a₁ ≤ b₁ → a₂ ≤ b₂ →
      ∀ (S : Set ((Fin n → ℝ) × ℝ)), MeasurableSet S → MeasureTheory.volume S < ⊤ →
        Measurable (fun p : (ℝ × ℝ) × ((Fin n → ℝ) × ℝ) => F p.1 p.2) →
        (∀ iu ξ, |F iu ξ| ≤ B) →
        (∫ i in a₁..b₁, ∫ u in a₂..b₂, ∫ ξ in S, F (i, u) ξ) =
          ∫ ξ in S, ∫ i in a₁..b₁, ∫ u in a₂..b₂, F (i, u) ξ := by
    intro F B a₁ b₁ a₂ b₂ ha₁ ha₂ S hS_meas hS_fin hF_meas hF_bd
    let Q : Set (ℝ × ℝ) := Set.Ioc a₁ b₁ ×ˢ Set.Ioc a₂ b₂
    have hQ_fin : MeasureTheory.volume Q < ⊤ := h_rect_fin a₁ b₁ a₂ b₂
    have h_prod_fin : (MeasureTheory.volume.prod MeasureTheory.volume) (Q ×ˢ S) < ⊤ := by
      rw [MeasureTheory.Measure.prod_prod]
      exact ENNReal.mul_lt_top hQ_fin hS_fin
    have h_int : MeasureTheory.IntegrableOn
        (fun p : (ℝ × ℝ) × ((Fin n → ℝ) × ℝ) => F p.1 p.2) (Q ×ˢ S)
        (MeasureTheory.volume.prod MeasureTheory.volume) := by
      refine MeasureTheory.IntegrableOn.of_bound h_prod_fin hF_meas.aestronglyMeasurable.restrict |B| ?_
      filter_upwards with p
      rw [Real.norm_eq_abs]
      exact (hF_bd p.1 p.2).trans (le_abs_self B)
    have h_int_sw : MeasureTheory.IntegrableOn
        (fun p : ((Fin n → ℝ) × ℝ) × (ℝ × ℝ) => F p.swap.1 p.swap.2)
        (S ×ˢ Q) (MeasureTheory.volume.prod MeasureTheory.volume) := by
      rw [MeasureTheory.IntegrableOn, ← MeasureTheory.Measure.prod_restrict] at h_int ⊢
      exact h_int.swap
    have h_slice_Q : ∀ ξ ∈ S, MeasureTheory.IntegrableOn (fun iu => F iu ξ) Q MeasureTheory.volume := by
      intro ξ _
      exact h_rect_int_bdd (fun iu => F iu ξ) B a₁ b₁ a₂ b₂
        (hF_meas.comp (measurable_id.prodMk measurable_const)) (fun iu _ => hF_bd iu ξ)
    have h_lhs_int : MeasureTheory.IntegrableOn (fun iu => ∫ ξ in S, F iu ξ) Q MeasureTheory.volume := by
      rw [MeasureTheory.IntegrableOn, ← MeasureTheory.Measure.prod_restrict] at h_int
      exact h_int.integral_prod_left
    rw [h_rect_eq_prod (fun iu => ∫ ξ in S, F iu ξ) a₁ b₁ a₂ b₂ ha₁ ha₂ h_lhs_int]
    rw [← MeasureTheory.setIntegral_prod (fun p : (ℝ × ℝ) × ((Fin n → ℝ) × ℝ) => F p.1 p.2) h_int]
    rw [← MeasureTheory.setIntegral_prod_swap]
    rw [MeasureTheory.setIntegral_prod
      (fun p : ((Fin n → ℝ) × ℝ) × (ℝ × ℝ) => F p.swap.1 p.swap.2) h_int_sw]
    refine MeasureTheory.setIntegral_congr_fun hS_meas (fun ξ hξ => ?_)
    exact (h_rect_eq_prod (fun iu => F iu ξ) a₁ b₁ a₂ b₂ ha₁ ha₂ (h_slice_Q ξ hξ)).symm
  have h_rect_meas_param : ∀ {α : Type} [MeasurableSpace α] (F : (ℝ × ℝ) × α → ℝ)
      (a₁ b₁ a₂ b₂ : ℝ), a₁ ≤ b₁ → a₂ ≤ b₂ → Measurable F →
      Measurable (fun x : α => ∫ i in a₁..b₁, ∫ u in a₂..b₂, F ((i, u), x)) := by
    intro α _ F a₁ b₁ a₂ b₂ ha₁ ha₂ hF
    simp_rw [intervalIntegral.integral_of_le ha₁, intervalIntegral.integral_of_le ha₂]
