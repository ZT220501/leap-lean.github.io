theorem std_aperture_shape_and_duration_reduction (γ m : ℝ) (hγ₀ : 0 < γ) (hγ₁ : γ < 1) (hm : 0 ≤ m)
    (h_two : (2 : ℝ) ∈ ValidClassicalGrowthRates γ) :
    (∀ (ε : ℝ) {N_ω N_T : ℕ} (π : Fin N_ω → ℝ) (T_idx : Fin N_ω → Fin N_T)
      (V_part A_part : Fin N_T → EuclideanSpace ℝ (Fin 2)) (c_s : Fin N_ω → ℝ),
      0 < ε → ε < 1 / 2 → IsUnitBallTimeLaw π V_part A_part c_s →
      0 ≤ classicalRootSupremum ε (1 + m) γ N_ω N_T π T_idx V_part A_part ∧
      classicalRootSupremum ε (1 + m) γ N_ω N_T π T_idx V_part A_part ≤ 2 * (1 + m)) ∧
    (∀ (u_min η : ℝ), 0 < u_min → u_min ≤ 1 → 0 < η →
      ∃ ε₀ : ℝ, 0 < ε₀ ∧ ε₀ < 1 / 2 ∧
        ∀ (ε u b a : ℝ) {N_ω N_T : ℕ} (π : Fin N_ω → ℝ) (T_idx : Fin N_ω → Fin N_T)
          (V_part A_part : Fin N_T → EuclideanSpace ℝ (Fin 2)) (c_s θ_s : Fin N_ω → ℝ),
          0 < ε → ε < ε₀ → u_min ≤ u → u ≤ 1 →
          0 ≤ b → b ≤ a → a + u ≤ 1 + m →
          IsUnitBallTimeLaw π V_part A_part c_s →
          (∀ ω, 0 < π ω → θ_s ω ∈ Set.Ico (0 : ℝ) Real.pi) →
          -η ≤ stdApertureDeficit ε γ (1 + m) u b a π T_idx V_part A_part c_s θ_s) ∧
    (∃ C_tr : ℝ, 0 ≤ C_tr ∧
      ∀ (ε r t b₁ a₁ b₂ a₂ : ℝ) {N_ω N_T : ℕ} (π : Fin N_ω → ℝ) (T_idx : Fin N_ω → Fin N_T)
        (V_part A_part : Fin N_T → EuclideanSpace ℝ (Fin 2)) (c_s θ_s : Fin N_ω → ℝ),
        0 < ε → ε < 1 / 2 → 0 < r → r ≤ t → t ≤ 1 →
        0 ≤ b₁ → b₁ ≤ a₁ → a₁ + r ≤ 1 + m →
        0 ≤ b₂ → b₂ ≤ a₂ → a₂ + t ≤ 1 + m →
        IsUnitBallTimeLaw π V_part A_part c_s →
        (∀ ω, 0 < π ω → θ_s ω ∈ Set.Ico (0 : ℝ) Real.pi) →
        stdApertureDeficit ε γ (1 + m) r b₁ a₁ π T_idx V_part A_part c_s θ_s ≤
          stdApertureDeficit ε γ (1 + m) t b₂ a₂ π T_idx V_part A_part c_s θ_s +
            9 * (|b₁ - b₂| + |a₁ - a₂| + (t - r)) + C_tr / Real.log (ε⁻¹)) ∧
    (∀ (u b_u a_u : ℝ), 0 < u → u ≤ 1 → 0 ≤ b_u → b_u ≤ a_u → a_u + u ≤ 1 + m →
      (∃ (ε_seq : ℕ → ℝ) (N_ω N_T : ℕ → ℕ)
        (π_seq : ∀ n, Fin (N_ω n) → ℝ) (T_seq : ∀ n, Fin (N_ω n) → Fin (N_T n))
