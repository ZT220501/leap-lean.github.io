            ∑ i : Fin N_P, if N_bin i = n_star ∧ |L_hat i - z₀ 0| < r then ν_P i else 0 := by
        exact (h_sum_partition_pred Finset.univ S_L L_bin (fun i => N_bin i = n_star)
          (fun l => |l_of_k l - z₀ 0| < r) ν_P (fun i _ => hL_mem i)).symm
      have h_coll_Z1 :
          (∑ k_Z ∈ S_Z1, if |z_of_k k_Z - z₀ 1| < r then
