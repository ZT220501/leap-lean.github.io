            have h_c : (gridPt2D ρ_r (kv0, kv1) - v₀) 1 = ρ_r * (kv1 : ℝ) - v₀ 1 := rfl
            rw [h_c] at hc1
            have h_div : |(kv1 : ℝ) - v₀ 1 / ρ_r| = |ρ_r * (kv1 : ℝ) - v₀ 1| / ρ_r := by
              have : (kv1 : ℝ) - v₀ 1 / ρ_r = (ρ_r * (kv1 : ℝ) - v₀ 1) / ρ_r := by
                field_simp [hρ_pos.ne']
