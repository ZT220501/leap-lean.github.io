  have part3_info_identity :
      ∀ {M_ω M_T N_G : ℕ} {β_B : Type}
        (ε γ b₀ a₀ : ℝ)
        (Q : Fin M_ω → ℝ)
        (T_idx : Fin M_ω → Fin M_T)
        (k_time : Fin M_ω → ℤ)
        (B_obs : Fin M_ω → β_B)
        (G_idx : Fin M_ω → Fin N_G),
        (∀ ω, 0 ≤ Q ω) →
        (∑ ω : Fin M_ω, Q ω = 1) →
        (∀ ω₁ ω₂ : Fin M_ω, G_idx ω₁ = G_idx ω₂ ↔ B_obs ω₁ = B_obs ω₂) →
        classicalTransportScore ε γ M_ω M_T N_G Q T_idx k_time G_idx
            (fun _ => b₀) (fun _ => a₀) =
          ((1 + γ) * b₀ + (1 - γ) * a₀) -
            finMutualInfo ε Q T_idx B_obs +
