theorem wave_packet_score_growth_bound (a₀ a₁ A R_dom : ℝ) (ha₀ : 0 < a₀) (ha₁ : a₀ ≤ a₁) (hA : 1 ≤ A) (hR : 1 ≤ R_dom)
    (M_ψ : ℕ → ℝ) (γ η : ℝ) (hγ₀ : 0 < γ) (hγ₁ : γ < 1) (hη : 0 < η) :
    ∃ (Λ₀ C_pkt : ℝ), 2 ≤ Λ₀ ∧ 0 ≤ C_pkt ∧
      ∀ (lam : ℝ), Λ₀ ≤ lam →
      ∀ (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
        (ζ₀ : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → EuclideanSpace ℝ (Fin 2)),
        IsNormalizedPosDefPhase a₀ a₁ A Φ₀ ζ₀ →
      ∀ (ψ_end : (ℕ × (ℤ × ℤ) × (ℤ × ℤ)) → EuclideanSpace ℝ (Fin 2) → ℂ),
        (∀ o, ∀ k : ℕ, ContDiff ℝ k (ψ_end o)) →
        (∀ o, ∀ z : EuclideanSpace ℝ (Fin 2), 2 ≤ ‖z‖ → ψ_end o z = 0) →
        (∀ o, ∀ (k : ℕ) (z : EuclideanSpace ℝ (Fin 2)),
          ‖iteratedFDeriv ℝ k (ψ_end o) z‖ ≤ M_ψ k) →
      ∀ (f : EuclideanSpace ℝ (Fin 2) → ℂ),
        MeasureTheory.AEStronglyMeasurable f MeasureTheory.volume →
        (∀ v : EuclideanSpace ℝ (Fin 2), R_dom ≤ ‖v‖ → f v = 0) →
        MeasureTheory.MemLp f 2 MeasureTheory.volume →
        0 < ∫ v : EuclideanSpace ℝ (Fin 2), ‖f v‖ ^ 2 →
        ∑ o ∈ endpointSiteFinset lam R_dom,
          (endpointPacketMass lam Φ₀ ψ_end f o) ^ ((3 : ℝ) / 2) ≤
          C_pkt * lam ^ (rootPacketScore lam R_dom γ Φ₀ f + γ / 2 + η) :=
by
  have h_one : (1 : ℝ) ∈ ValidPacketGrowthRates γ :=
    preliminary_packet_growth_le_one γ hγ₀ hγ₁
  have h_cl : ClassicalLineGrowthBound γ :=
    classical_positive_transport_growth γ hγ₀ hγ₁
  have h_rate : quantumPacketRate γ ≤ γ / 2 := by
    by_contra h_not
    have h_gt : γ / 2 < quantumPacketRate γ := lt_of_not_ge h_not
    let c_gain : ℝ := 4 * quantumPacketRate γ - 2 * γ
    have hc_pos : 0 < c_gain := by
      dsimp [c_gain]
      linarith
    obtain ⟨q₀, hq₀⟩ := exists_nat_gt (2 / c_gain)
    let q : ℕ := q₀ + 1
    have hq : 1 ≤ q := Nat.le_add_left 1 q₀
    have hq_lt : (q₀ : ℝ) < (q : ℝ) := by
      dsimp [q]
      push_cast
      linarith
    have hq_div : 2 / c_gain < (q : ℝ) := lt_trans hq₀ hq_lt
    have hq_gain : 2 < (q : ℝ) * c_gain := (div_lt_iff₀ hc_pos).mp hq_div
    let ε_err : ℝ := ((q : ℝ) * c_gain - 2) / (2 * ((q : ℝ) + 1))
    have hq_pos : 0 < 2 * ((q : ℝ) + 1) := by positivity
    have hε_pos : 0 < ε_err := div_pos (sub_pos.mpr hq_gain) hq_pos
    obtain ⟨h, k, hh_pos, hk0, hk_step, hk_cap⟩ :=
      quantum_packet_credit_chain_bound γ hγ₀ hγ₁ h_cl h_one h_gt q hq ε_err hε_pos
    have hk_ind : ∀ m : ℕ, ∀ hm : m ≤ q,
        (m : ℝ) * (c_gain - ε_err) * h ≤ k ⟨m, Nat.lt_succ_of_le hm⟩ := by
      intro m
      induction m with
      | zero =>
        intro hm
        have h0 : (⟨0, Nat.lt_succ_of_le hm⟩ : Fin (q + 1)) = 0 := by
          ext
          simp
        rw [h0, hk0]
        simp
      | succ m ih =>
        intro hm1
        have hm : m ≤ q := Nat.le_of_succ_le hm1
        let i : Fin q := ⟨m, hm1⟩
        have h_cast : i.castSucc = ⟨m, Nat.lt_succ_of_le hm⟩ := by
          ext
          simp [i]
        have h_succ : i.succ = ⟨m + 1, Nat.lt_succ_of_le hm1⟩ := by
          ext
          simp [i]
        have h_step := hk_step i
        rw [h_cast, h_succ] at h_step
        have h_ih := ih hm
        have h_alg : ((m + 1 : ℕ) : ℝ) * (c_gain - ε_err) * h =
            (m : ℝ) * (c_gain - ε_err) * h + (c_gain - ε_err) * h := by
          push_cast
          ring
        linarith [h_ih, h_step, h_alg]
    have hk_q := hk_ind q (le_refl q)
    have h_last : (⟨q, Nat.lt_succ_of_le (le_refl q)⟩ : Fin (q + 1)) = Fin.last q := by
      ext
      simp
    rw [h_last] at hk_q
    have h_comb : (q : ℝ) * (c_gain - ε_err) * h ≤ (2 + ε_err) * h :=
      le_trans hk_q hk_cap
    have h_div_h : (q : ℝ) * (c_gain - ε_err) ≤ 2 + ε_err :=
      le_of_mul_le_mul_right h_comb hh_pos
    have h_err_eq : ((q : ℝ) + 1) * ε_err = ((q : ℝ) * c_gain - 2) / 2 := by
      dsimp [ε_err]
      have hq1_ne : ((q : ℝ) + 1) ≠ 0 := by positivity
      field_simp [hq1_ne]
    linarith
  have h_ne : (ValidPacketGrowthRates γ).Nonempty := ⟨1, h_one⟩
  have h_inf_lt : sInf (ValidPacketGrowthRates γ) < γ / 2 + η / 2 := by
    change quantumPacketRate γ < γ / 2 + η / 2
    linarith
  obtain ⟨b₀, hb₀_mem, hb₀_lt⟩ := exists_lt_of_csInf_lt h_ne h_inf_lt
  obtain ⟨Λ₀, C_pkt, hΛ₀, hC_pkt, h_end⟩ :=
    endpoint_gibbs_score_reduction a₀ a₁ A R_dom ha₀ ha₁ hA hR M_ψ γ hγ₀ hγ₁
      b₀ (η / 2) hb₀_mem (half_pos hη)
  refine ⟨Λ₀, C_pkt, hΛ₀, hC_pkt, ?_⟩
  intro lam hlam Φ₀ ζ₀ h_phase ψ_end hψ_smooth hψ_supp hψ_deriv f hf_meas hf_supp hf_l2 hf_pos
  have h_est := h_end lam hlam Φ₀ ζ₀ h_phase ψ_end hψ_smooth hψ_supp hψ_deriv
    f hf_meas hf_supp hf_l2 hf_pos
  refine le_trans h_est ?_
  refine mul_le_mul_of_nonneg_left ?_ hC_pkt
  have hlam_ge_one : (1 : ℝ) ≤ lam := by linarith
  refine Real.rpow_le_rpow_of_exponent_le hlam_ge_one ?_
  linarith

theorem osc_integral_2d_l3_bound (a₀ a₁ A R_x R_v : ℝ) (ha₀ : 0 < a₀) (ha₁ : a₀ ≤ a₁) (hA : 1 ≤ A)
    (hRx : 0 < R_x) (hRv : 0 < R_v)
    (M_B : ℕ → ℝ) (ν : ℝ) (hν : 0 < ν) :
    ∃ C_osc : ℝ, 0 ≤ C_osc ∧
      ∀ (lam : ℝ), 2 ≤ lam →
      ∀ (Φ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
        (ζ : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → EuclideanSpace ℝ (Fin 2)),
        IsEllipticGevreyPhase a₀ a₁ A Φ ζ →
      ∀ (B : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℂ),
        (∀ k : ℕ, ContDiff ℝ k B) →
        (∀ (c : ℝ) (x v : EuclideanSpace ℝ (Fin 2)),
          (c ∉ Set.Icc 0 1 ∨ R_x ≤ ‖x‖ ∨ R_v ≤ ‖v‖) → B (c, x, v) = 0) →
        (∀ (k : ℕ) (p : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2)),
          ‖iteratedFDeriv ℝ k B p‖ ≤ M_B k) →
      ∀ (f : EuclideanSpace ℝ (Fin 2) → ℂ),
        MeasureTheory.AEStronglyMeasurable f MeasureTheory.volume →
        (∀ v : EuclideanSpace ℝ (Fin 2), R_v + 1 ≤ ‖v‖ → f v = 0) →
        MeasureTheory.eLpNorm f 3 MeasureTheory.volume < ⊤ →
        MeasureTheory.eLpNorm (oscIntegralOp2D lam Φ B f) 3 MeasureTheory.volume ≤
          ENNReal.ofReal (C_osc * lam ^ (-1 + ν)) *
            MeasureTheory.eLpNorm f 3 MeasureTheory.volume :=
by
  let R_dom : ℝ := max 1 (max (R_x + 2) (R_v + 2))
  have hR_dom : 1 ≤ R_dom := le_max_left _ _
  have hRx_dom : R_x + 2 ≤ R_dom := le_trans (le_max_left _ _) (le_max_right _ _)
  have hRv_dom : R_v + 2 ≤ R_dom := le_trans (le_max_right _ _) (le_max_right _ _)
  let ν₀ : ℝ := min ν (1 / 2)
  have hν₀_pos : 0 < ν₀ := lt_min hν (by norm_num)
  have hν₀_le_ν : ν₀ ≤ ν := min_le_left _ _
  have hν₀_le_half : ν₀ ≤ 1 / 2 := min_le_right _ _
  let γ : ℝ := ν₀
  let η : ℝ := ν₀
  have hγ₀ : 0 < γ := hν₀_pos
  have hγ₁ : γ < 1 := lt_of_le_of_lt hν₀_le_half (by norm_num)
  have hη : 0 < η := hν₀_pos
  obtain ⟨M_ψ, C_box, hC_box_nn, h_box⟩ :=
    endpoint_box_discretization_bound a₀ a₁ A R_x R_v R_dom ha₀ ha₁ hA hRx hRv
      hR_dom hRx_dom hRv_dom M_B
  obtain ⟨C_root, hC_root_ge, h_root⟩ :=
    root_packet_score_sublevel_bound a₀ a₁ A R_dom γ ha₀ ha₁ hA hR_dom hγ₀ hγ₁
  have hC_root_nn : 0 ≤ C_root := by linarith
  obtain ⟨Λ₀, C_pkt, hΛ₀_ge, hC_pkt_nn, h_pkt⟩ :=
    wave_packet_score_growth_bound a₀ a₁ A R_dom ha₀ ha₁ hA hR_dom M_ψ γ η hγ₀ hγ₁ hη
  let C_sub : ℝ := C_box * (C_pkt * C_root) ^ ((1 : ℝ) / 3)
  have hC_sub_nn : 0 ≤ C_sub :=
    mul_nonneg hC_box_nn (Real.rpow_nonneg (mul_nonneg hC_pkt_nn hC_root_nn) _)
  let B_max : ℝ := max (M_B 0) 0
  have hB_max_nn : 0 ≤ B_max := le_max_right _ _
  obtain ⟨C_osc, hC_osc_nn, h_dyadic⟩ :=
    sublevel_to_l3_dyadic_interpolation R_x R_v B_max ν Λ₀ C_sub
      hRx hRv hB_max_nn hν hΛ₀_ge hC_sub_nn
  refine ⟨C_osc, hC_osc_nn, ?_⟩
  intro lam hlam Φ ζ h_phase B hB_smooth hB_supp hB_deriv f hf_meas hf_supp hf_l3
  obtain ⟨Φ₀, ζ₀, B', f', h_norm, hB'_smooth, hB'_supp, hB'_deriv,
      hf'_meas, hf'_supp, hf'_l3_eq, h_op_eq⟩ :=
    elliptic_phase_gauge_reduction a₀ a₁ A R_x R_v hRx hRv lam Φ ζ h_phase
      B hB_smooth hB_supp M_B hB_deriv f hf_meas hf_supp hf_l3
  rw [h_op_eq, ← hf'_l3_eq]
  have hf'_l3 : MeasureTheory.eLpNorm f' 3 MeasureTheory.volume < ⊤ := by
    rwa [hf'_l3_eq]
  have hB'_bound : ∀ p : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2),
      ‖B' p‖ ≤ B_max := by
    intro p
    calc ‖B' p‖ = ‖iteratedFDeriv ℝ 0 B' p‖ := (norm_iteratedFDeriv_zero).symm
      _ ≤ M_B 0 := hB'_deriv 0 p
      _ ≤ B_max := le_max_left _ _
  refine h_dyadic lam hlam Φ₀ B' (h_norm.1 0).continuous (hB'_smooth 0).continuous
    hB'_supp hB'_bound ?_ f' hf'_meas hf'_supp hf'_l3
  intro hlam_Λ F hF_meas hF_sub g hg_meas hg_ind
  have hlam_pos : 0 < lam := by linarith
  have hlam_nn : 0 ≤ lam := hlam_pos.le
  have hlam_ge_one : 1 ≤ lam := by linarith
  have hF_dom : F ⊆ Metric.closedBall 0 R_dom :=
    hF_sub.trans (Metric.closedBall_subset_closedBall (by linarith))
  have hF_lt_top : MeasureTheory.volume F < ⊤ :=
    lt_of_le_of_lt (MeasureTheory.measure_mono hF_dom) MeasureTheory.measure_closedBall_lt_top
  have hF_ne_top : MeasureTheory.volume F ≠ ⊤ := hF_lt_top.ne
  have hg_supp_dom : ∀ v : EuclideanSpace ℝ (Fin 2), R_dom ≤ ‖v‖ → g v = 0 := by
    intro v hv
    have hv_not_F : v ∉ F := by
      intro hvF
      have hv_ball := hF_sub hvF
      rw [Metric.mem_closedBall, dist_zero_right] at hv_ball
      linarith
    have h_le : ‖g v‖ ≤ 0 := by
      have h1 := hg_ind v
      rw [Set.indicator_of_notMem hv_not_F] at h1
      exact h1
    exact norm_le_zero_iff.mp h_le
  have h_ind_l1 : MeasureTheory.Integrable (Set.indicator F (fun _ => (1 : ℝ)))
      MeasureTheory.volume :=
    MeasureTheory.memLp_one_iff_integrable.mp
      (MeasureTheory.memLp_indicator_const 1 hF_meas (1 : ℝ) (Or.inr hF_ne_top))
  have h_ind_l2 : MeasureTheory.MemLp (Set.indicator F (fun _ => (1 : ℝ)))
      2 MeasureTheory.volume :=
    MeasureTheory.memLp_indicator_const 2 hF_meas (1 : ℝ) (Or.inr hF_ne_top)
  have hg_le_ind : ∀ v : EuclideanSpace ℝ (Fin 2),
      ‖g v‖ ≤ Set.indicator F (fun _ => (1 : ℝ)) v := hg_ind
  have hg_int : MeasureTheory.Integrable g MeasureTheory.volume :=
    h_ind_l1.mono' hg_meas (Filter.Eventually.of_forall hg_le_ind)
  have hg_l2 : MeasureTheory.MemLp g 2 MeasureTheory.volume :=
    h_ind_l2.mono' hg_meas (Filter.Eventually.of_forall hg_le_ind)
  have hg_sq_le_ind : ∀ v : EuclideanSpace ℝ (Fin 2),
      ‖‖g v‖ ^ 2‖ ≤ Set.indicator F (fun _ => (1 : ℝ)) v := by
    intro v
    rw [Real.norm_of_nonneg (sq_nonneg _)]
    by_cases hv : v ∈ F
    · have h1 := hg_ind v
      rw [Set.indicator_of_mem hv] at h1 ⊢
      change ‖g v‖ ≤ 1 at h1
      nlinarith [norm_nonneg (g v)]
    · have h1 := hg_ind v
      rw [Set.indicator_of_notMem hv] at h1 ⊢
      change ‖g v‖ ≤ 0 at h1
      have h0 : ‖g v‖ = 0 := le_antisymm h1 (norm_nonneg _)
      simp [h0]
  have hg_sq_int : MeasureTheory.Integrable (fun v => ‖g v‖ ^ 2) MeasureTheory.volume :=
    h_ind_l1.mono' (hg_meas.norm.pow 2) (Filter.Eventually.of_forall hg_sq_le_ind)
  by_cases hg_zero : ∫ v : EuclideanSpace ℝ (Fin 2), ‖g v‖ ^ 2 = 0
  · have hg_sq_ae : (fun v => ‖g v‖ ^ 2) =ᵐ[MeasureTheory.volume] 0 :=
      (MeasureTheory.integral_eq_zero_iff_of_nonneg (fun v => sq_nonneg ‖g v‖) hg_sq_int).mp
        hg_zero
    have h_op_zero : oscIntegralOp2D lam Φ₀ B' g = 0 := by
      ext cx
      unfold oscIntegralOp2D
      rw [Pi.zero_apply]
      refine MeasureTheory.integral_eq_zero_of_ae ?_
      filter_upwards [hg_sq_ae] with v hv
      change ‖g v‖ ^ 2 = 0 at hv
      have hgv : g v = 0 := norm_eq_zero.mp (sq_eq_zero_iff.mp hv)
      simp [hgv]
    rw [h_op_zero, MeasureTheory.eLpNorm_zero]
    exact zero_le
  · have hg_int_nn : 0 ≤ ∫ v : EuclideanSpace ℝ (Fin 2), ‖g v‖ ^ 2 :=
      MeasureTheory.integral_nonneg (fun v => sq_nonneg ‖g v‖)
    have hg_pos : 0 < ∫ v : EuclideanSpace ℝ (Fin 2), ‖g v‖ ^ 2 :=
      lt_of_le_of_ne hg_int_nn (Ne.symm hg_zero)
    obtain ⟨ψ_end, hψ_smooth, hψ_supp, hψ_deriv, h_box_est⟩ :=
      h_box lam hlam Φ₀ ζ₀ h_norm B' hB'_smooth hB'_supp hB'_deriv g hg_int
    have h_pkt_est :=
      h_pkt lam hlam_Λ Φ₀ ζ₀ h_norm ψ_end hψ_smooth hψ_supp hψ_deriv
        g hg_meas hg_supp_dom hg_l2 hg_pos
    have h_root_est :=
      h_root lam hlam Φ₀ ζ₀ h_norm F hF_meas hF_dom g hg_meas hg_ind hg_pos
    let S_end : ℝ := ∑ o ∈ endpointSiteFinset lam R_dom,
      (endpointPacketMass lam Φ₀ ψ_end g o) ^ ((3 : ℝ) / 2)
    have hS_nn : 0 ≤ S_end := by
      refine Finset.sum_nonneg (fun o _ => Real.rpow_nonneg ?_ _)
      unfold endpointPacketMass
      exact sq_nonneg _
    have h_sum_bound : S_end ≤
        (C_pkt * C_root) * (MeasureTheory.volume F).toReal * lam ^ (3 * ν₀ / 2) := by
      have hexp : γ / 2 + η = 3 * ν₀ / 2 := by
        dsimp [γ, η]
        ring
      have h_split : lam ^ (rootPacketScore lam R_dom γ Φ₀ g + (γ / 2 + η)) =
          lam ^ (rootPacketScore lam R_dom γ Φ₀ g) * lam ^ (3 * ν₀ / 2) := by
        rw [Real.rpow_add hlam_pos, hexp]
      calc S_end
          ≤ C_pkt * lam ^ (rootPacketScore lam R_dom γ Φ₀ g + γ / 2 + η) := h_pkt_est
        _ = C_pkt * (lam ^ (rootPacketScore lam R_dom γ Φ₀ g) * lam ^ (3 * ν₀ / 2)) := by
            rw [add_assoc, h_split]
        _ ≤ C_pkt * ((C_root * (MeasureTheory.volume F).toReal) * lam ^ (3 * ν₀ / 2)) := by
            refine mul_le_mul_of_nonneg_left ?_ hC_pkt_nn
            exact mul_le_mul_of_nonneg_right h_root_est (Real.rpow_nonneg hlam_nn _)
        _ = (C_pkt * C_root) * (MeasureTheory.volume F).toReal * lam ^ (3 * ν₀ / 2) := by ring
    have h_rpow_bound : S_end ^ ((1 : ℝ) / 3) ≤
        (C_pkt * C_root) ^ ((1 : ℝ) / 3) *
          (MeasureTheory.volume F).toReal ^ ((1 : ℝ) / 3) *
          lam ^ (ν₀ / 2) := by
      have h_lhs := Real.rpow_le_rpow hS_nn h_sum_bound (by norm_num : (0 : ℝ) ≤ 1 / 3)
      have h1 : 0 ≤ C_pkt * C_root := mul_nonneg hC_pkt_nn hC_root_nn
      have h2 : 0 ≤ (MeasureTheory.volume F).toReal := ENNReal.toReal_nonneg
      have h3 : 0 ≤ lam ^ (3 * ν₀ / 2) := Real.rpow_nonneg hlam_nn _
      rw [Real.mul_rpow (mul_nonneg h1 h2) h3, Real.mul_rpow h1 h2,
        ← Real.rpow_mul hlam_nn] at h_lhs
      have hexp2 : (3 * ν₀ / 2) * ((1 : ℝ) / 3) = ν₀ / 2 := by ring
      rwa [hexp2] at h_lhs
    have h_real_bound : C_box * lam⁻¹ * S_end ^ ((1 : ℝ) / 3) ≤
        (C_sub * lam ^ (-1 + ν / 2)) * (MeasureTheory.volume F).toReal ^ ((1 : ℝ) / 3) := by
      have h_cbox_lam : 0 ≤ C_box * lam⁻¹ := mul_nonneg hC_box_nn (inv_nonneg.mpr hlam_nn)
      have h_lam_exp : lam⁻¹ * lam ^ (ν₀ / 2) ≤ lam ^ (-1 + ν / 2) := by
        rw [← Real.rpow_neg_one lam, ← Real.rpow_add hlam_pos]
        exact Real.rpow_le_rpow_of_exponent_le hlam_ge_one (by linarith)
      calc C_box * lam⁻¹ * S_end ^ ((1 : ℝ) / 3)
          ≤ C_box * lam⁻¹ * ((C_pkt * C_root) ^ ((1 : ℝ) / 3) *
              (MeasureTheory.volume F).toReal ^ ((1 : ℝ) / 3) * lam ^ (ν₀ / 2)) :=
            mul_le_mul_of_nonneg_left h_rpow_bound h_cbox_lam
        _ = C_sub * (lam⁻¹ * lam ^ (ν₀ / 2)) *
              (MeasureTheory.volume F).toReal ^ ((1 : ℝ) / 3) := by
            dsimp [C_sub]
            ring
        _ ≤ C_sub * lam ^ (-1 + ν / 2) *
              (MeasureTheory.volume F).toReal ^ ((1 : ℝ) / 3) := by
            refine mul_le_mul_of_nonneg_right ?_ (Real.rpow_nonneg ENNReal.toReal_nonneg _)
            exact mul_le_mul_of_nonneg_left h_lam_exp hC_sub_nn
    refine h_box_est.trans ?_
    have h_ofReal := ENNReal.ofReal_le_ofReal h_real_bound
    have h_coeff_nn : 0 ≤ C_sub * lam ^ (-1 + ν / 2) :=
      mul_nonneg hC_sub_nn (Real.rpow_nonneg hlam_nn _)
    rw [ENNReal.ofReal_mul h_coeff_nn,
      ← ENNReal.ofReal_rpow_of_nonneg ENNReal.toReal_nonneg (by norm_num),
      ENNReal.ofReal_toReal hF_ne_top] at h_ofReal
    exact h_ofReal

theorem distance_phase_osc_l3_bound (M : ℕ → ℝ) (ν : ℝ) (hν : 0 < ν) :
    ∃ C_ν : ℝ, 0 ≤ C_ν ∧
      ∀ (σ lam : ℝ), (σ = 1 ∨ σ = -1) → 2 ≤ lam →
      ∀ (a : EuclideanSpace ℝ (Fin 3) → ℂ),
        (∀ k : ℕ, ContDiff ℝ k a) →
        (∀ w : EuclideanSpace ℝ (Fin 3), (‖w‖ ≤ 1 / 2 ∨ 2 ≤ ‖w‖) → a w = 0) →
        (∀ k : ℕ, ∀ w : EuclideanSpace ℝ (Fin 3), ‖iteratedFDeriv ℝ k a w‖ ≤ M k) →
      ∀ (g : EuclideanSpace ℝ (Fin 3) → ℂ),
        Continuous g →
        MeasureTheory.Integrable g MeasureTheory.volume →
        MeasureTheory.eLpNorm g 3 MeasureTheory.volume < ⊤ →
        MeasureTheory.eLpNorm (distPhaseOscOp σ lam a g) 3 MeasureTheory.volume ≤
          ENNReal.ofReal (C_ν * lam ^ (-1 + ν)) *
            MeasureTheory.eLpNorm g 3 MeasureTheory.volume :=
by
  obtain ⟨M_cone, h_cone⟩ := annulus_six_cone_decomp M
  obtain ⟨a₀, a₁, A, Φ_s, ζ_s, ha₀, ha₁, hA, h_phase⟩ := pseudoconformal_gevrey_phase
  obtain ⟨M_B, h_slice⟩ := pseudoconformal_slice_reduction M_cone
  obtain ⟨C_osc, hC_osc_nn, h_osc⟩ :=
    osc_integral_2d_l3_bound a₀ a₁ A 2 5 ha₀ ha₁ hA (by norm_num) (by norm_num) M_B ν hν
  refine ⟨2520 * C_osc, mul_nonneg (by norm_num) hC_osc_nn, ?_⟩
  intro σ lam hσ hlam a ha_smooth ha_supp ha_deriv g hg_cont hg_int hg_l3
  have hlam_nn : (0 : ℝ) ≤ lam := by linarith
  let C_2d : ℝ := C_osc * lam ^ (-1 + ν)
  have hC_2d_nn : 0 ≤ C_2d := mul_nonneg hC_osc_nn (Real.rpow_nonneg hlam_nn (-1 + ν))
  obtain ⟨h_is_phase, hΦ_eq⟩ := h_phase σ hσ
  have hΦ_smooth : ∀ k : ℕ, ContDiff ℝ k (Φ_s σ) := h_is_phase.1
  have h_dir_bound : ∀ (a_dir : EuclideanSpace ℝ (Fin 3) → ℂ),
      (∀ k : ℕ, ContDiff ℝ k a_dir) →
      (∀ w : EuclideanSpace ℝ (Fin 3), (‖w‖ ≤ 1 / 2 ∨ 2 ≤ ‖w‖ ∨ w 2 ≤ 1 / 6) → a_dir w = 0) →
      (∀ k : ℕ, ∀ w : EuclideanSpace ℝ (Fin 3), ‖iteratedFDeriv ℝ k a_dir w‖ ≤ M_cone k) →
      ∀ (g' : EuclideanSpace ℝ (Fin 3) → ℂ),
        Continuous g' →
        MeasureTheory.Integrable g' MeasureTheory.volume →
        MeasureTheory.eLpNorm g' 3 MeasureTheory.volume < ⊤ →
        MeasureTheory.eLpNorm (distPhaseOscOp σ lam a_dir g') 3 MeasureTheory.volume ≤
          ENNReal.ofReal (7 * (60 * C_2d)) * MeasureTheory.eLpNorm g' 3 MeasureTheory.volume := by
    intro a_dir ha_dir_smooth ha_dir_supp ha_dir_deriv g' hg'_cont hg'_int hg'_l3
    obtain ⟨B_a, hB_smooth, hB_supp, hB_deriv, hB_imp⟩ :=
      h_slice σ lam C_2d hC_2d_nn (Φ_s σ) hΦ_smooth hΦ_eq a_dir
        ha_dir_smooth ha_dir_supp ha_dir_deriv
    have h_loc_bound := hB_imp (fun f hf_meas hf_supp hf_l3 =>
      h_osc lam hlam (Φ_s σ) (ζ_s σ) h_is_phase B_a hB_smooth hB_supp hB_deriv
        f hf_meas (fun v hv => hf_supp v (by linarith)) hf_l3)
    exact unit_cube_localization_l3 σ lam (60 * C_2d) (mul_nonneg (by norm_num) hC_2d_nn)
      a_dir (ha_dir_smooth 0).continuous (fun w hw => ha_dir_supp w (Or.inr (Or.inl hw)))
      h_loc_bound g' hg'_cont hg'_int hg'_l3
  have h_global := h_cone σ lam (7 * (60 * C_2d))
    (mul_nonneg (by norm_num) (mul_nonneg (by norm_num) hC_2d_nn))
    h_dir_bound a ha_smooth ha_supp ha_deriv g hg_cont hg_int hg_l3
  have h_const_eq : 6 * (7 * (60 * C_2d)) = (2520 * C_osc) * lam ^ (-1 + ν) := by
    dsimp [C_2d]
    ring
  rwa [h_const_eq] at h_global

theorem bochner_riesz (δ : ℝ) (hδ : 0 < δ) :
    ∃ C_δ : ℝ,
      0 ≤ C_δ ∧
      ∀ f : SchwartzMap (EuclideanSpace ℝ (Fin 3)) ℂ,
        MeasureTheory.eLpNorm (bochnerRiesz δ f) 3 MeasureTheory.volume ≤
          ENNReal.ofReal C_δ * MeasureTheory.eLpNorm f 3 MeasureTheory.volume :=
by
  obtain ⟨B_δ, hB_nonneg, hK_cont, hK_bound, hBR⟩ := bochner_riesz_conv_representation δ hδ
  obtain ⟨K₀, a_pos, a_neg, M, Φ, hK₀_cont, hK₀_supp, ha_smooth, ha_supp, ha_deriv, hΦ⟩ :=
    bochner_riesz_kernel_dyadic_decomp δ hδ
  have hν_pos : 0 < δ / 2 := half_pos hδ
  obtain ⟨C_ν, hC_ν_nonneg, hC_ν⟩ := distance_phase_osc_l3_bound M (δ / 2) hν_pos
  let r : ℝ := (2 : ℝ) ^ (-δ / 2)
  have hr_pos : 0 < r := Real.rpow_pos_of_pos (by norm_num) (-δ / 2)
  have hr_lt_one : r < 1 := by
    calc (2 : ℝ) ^ (-δ / 2) < (2 : ℝ) ^ (0 : ℝ) :=
          Real.rpow_lt_rpow_of_exponent_lt (by norm_num) (by linarith)
      _ = 1 := Real.rpow_zero 2
  have h1mr_pos : 0 < 1 - r := sub_pos.mpr hr_lt_one
  let I₀ : ℝ := ∫ z : EuclideanSpace ℝ (Fin 3), ‖K₀ z‖
  have hI₀_nonneg : 0 ≤ I₀ := MeasureTheory.integral_nonneg (fun z => norm_nonneg (K₀ z))
  let C_δ : ℝ := I₀ + 2 * C_ν / (1 - r)
  have hC_δ_nonneg : 0 ≤ C_δ :=
    add_nonneg hI₀_nonneg (div_nonneg (mul_nonneg (by norm_num) hC_ν_nonneg) h1mr_pos.le)
  refine ⟨C_δ, hC_δ_nonneg, fun f => ?_⟩
  let T : ℕ → EuclideanSpace ℝ (Fin 3) → ℂ := fun N x =>
    ∫ y : EuclideanSpace ℝ (Fin 3),
      (bochnerRieszKernel δ (x - y) * (Φ N (x - y) : ℂ)) * f y
  
  have hT_tendsto : ∀ x : EuclideanSpace ℝ (Fin 3),
      Filter.Tendsto (fun N => T N x) Filter.atTop (nhds (bochnerRiesz δ f x)) := by
    intro x
    rw [(hBR f).2 x]
    unfold spatialConv
    refine MeasureTheory.tendsto_integral_of_dominated_convergence
      (fun y => B_δ * ‖f y‖) ?_ ?_ ?_ ?_
    · intro N
      have hc : Continuous (fun y : EuclideanSpace ℝ (Fin 3) =>
          (bochnerRieszKernel δ (x - y) * (Φ N (x - y) : ℂ)) * f y) :=
        ((hK_cont.comp (continuous_const.sub continuous_id)).mul
          (Complex.continuous_ofReal.comp ((hΦ N).1.comp (continuous_const.sub continuous_id)))).mul
          f.continuous
      exact hc.aestronglyMeasurable
    · exact f.integrable.norm.const_mul B_δ
    · intro N
      refine Filter.Eventually.of_forall (fun y => ?_)
      have hΦ_01 := (hΦ N).2.1 (x - y)
      have hΦ_norm : ‖(Φ N (x - y) : ℂ)‖ ≤ 1 := by
        rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hΦ_01.1]
        exact hΦ_01.2
      calc ‖(bochnerRieszKernel δ (x - y) * (Φ N (x - y) : ℂ)) * f y‖
          = ‖bochnerRieszKernel δ (x - y)‖ * ‖(Φ N (x - y) : ℂ)‖ * ‖f y‖ := by
            rw [norm_mul, norm_mul]
        _ ≤ (B_δ * 1) * ‖f y‖ := by
            refine mul_le_mul ?_ (le_refl _) (norm_nonneg _) (mul_nonneg hB_nonneg zero_le_one)
            exact mul_le_mul (hK_bound (x - y)) hΦ_norm (norm_nonneg _) hB_nonneg
        _ = B_δ * ‖f y‖ := by ring
    · refine Filter.Eventually.of_forall (fun y => ?_)
      obtain ⟨N₀, hN₀⟩ := exists_nat_gt ‖x - y‖
      refine tendsto_const_nhds.congr' ?_
      rw [Filter.EventuallyEq, Filter.eventually_atTop]
      refine ⟨N₀, fun N hN => ?_⟩
      have h_le : ‖x - y‖ ≤ (2 : ℝ) ^ N := by
        have h_nat : N₀ ≤ 2 ^ N :=
          le_trans (Nat.le_of_lt Nat.lt_two_pow_self) (Nat.pow_le_pow_right (by omega) hN)
        have h_real : (N₀ : ℝ) ≤ (2 : ℝ) ^ N := by exact_mod_cast h_nat
        exact le_trans hN₀.le h_real
      have hΦ_eq : Φ N (x - y) = 1 := (hΦ N).2.2.1 (x - y) h_le
      simp [hΦ_eq]
  
  obtain ⟨hConv0_cont, hConv0_int, hConv0_l3⟩ :=
    young_spatialConv_l3 K₀ hK₀_cont hK₀_supp f
  let K_pos : ℕ → EuclideanSpace ℝ (Fin 3) → ℂ :=
    fun j => shellOscKernel δ 1 ((2 : ℝ) ^ (j + 1)) (a_pos j)
  let K_neg : ℕ → EuclideanSpace ℝ (Fin 3) → ℂ :=
    fun j => shellOscKernel δ (-1) ((2 : ℝ) ^ (j + 1)) (a_neg j)
  have hShell_pos : ∀ j : ℕ,
      Continuous (spatialConv (K_pos j) (⇑f)) ∧
      (∀ x : EuclideanSpace ℝ (Fin 3),
        MeasureTheory.Integrable (fun y => K_pos j (x - y) * f y) MeasureTheory.volume) ∧
      MeasureTheory.eLpNorm (spatialConv (K_pos j) (⇑f)) 3 MeasureTheory.volume ≤
        ENNReal.ofReal (C_ν * r ^ j) * MeasureTheory.eLpNorm f 3 MeasureTheory.volume := by
    intro j
    have hlam_ge : (2 : ℝ) ≤ (2 : ℝ) ^ (j + 1) := by
      have h_nat : 2 ^ 1 ≤ 2 ^ (j + 1) := Nat.pow_le_pow_right (by omega) (by omega)
      exact_mod_cast h_nat
    have hlam_pos : (0 : ℝ) < (2 : ℝ) ^ (j + 1) := by linarith
    have ha_c : Continuous (a_pos j) := ((ha_smooth j).1 0).continuous
    have ha_s : ∀ w, (‖w‖ ≤ 1 / 2 ∨ 2 ≤ ‖w‖) → a_pos j w = 0 :=
      fun w hw => (ha_supp j w hw).1
    obtain ⟨hc, hint, hgc, hgint, hgl3, himp⟩ :=
      dyadic_shell_rescaling_l3 δ 1 ((2 : ℝ) ^ (j + 1)) C_ν (δ / 2)
        hlam_pos hC_ν_nonneg (a_pos j) ha_c ha_s f
    have hosc := hC_ν 1 ((2 : ℝ) ^ (j + 1)) (Or.inl rfl) hlam_ge (a_pos j)
      (ha_smooth j).1 ha_s (fun k w => (ha_deriv j k w).1)
      (fun y => f (((2 : ℝ) ^ (j + 1)) • y)) hgc hgint hgl3
    have hbound := himp hosc
    refine ⟨hc, hint, le_trans hbound ?_⟩
    refine mul_le_mul_of_nonneg_right (ENNReal.ofReal_le_ofReal ?_) zero_le
    refine mul_le_mul_of_nonneg_left ?_ hC_ν_nonneg
    have hexp : (((2 : ℝ) ^ (j + 1)) ^ (-δ + δ / 2) : ℝ) = r ^ (j + 1) := by
      have hd : -δ + δ / 2 = -δ / 2 := by ring
      rw [hd, ← Real.rpow_natCast (2 : ℝ) (j + 1),
        ← Real.rpow_mul (by norm_num) ((j + 1 : ℕ) : ℝ) (-δ / 2),
        mul_comm ((j + 1 : ℕ) : ℝ) (-δ / 2),
        Real.rpow_mul (by norm_num) (-δ / 2) ((j + 1 : ℕ) : ℝ),
        Real.rpow_natCast]
    rw [hexp, pow_succ]
    exact mul_le_of_le_one_right (pow_nonneg hr_pos.le j) hr_lt_one.le
  have hShell_neg : ∀ j : ℕ,
      Continuous (spatialConv (K_neg j) (⇑f)) ∧
      (∀ x : EuclideanSpace ℝ (Fin 3),
        MeasureTheory.Integrable (fun y => K_neg j (x - y) * f y) MeasureTheory.volume) ∧
      MeasureTheory.eLpNorm (spatialConv (K_neg j) (⇑f)) 3 MeasureTheory.volume ≤
        ENNReal.ofReal (C_ν * r ^ j) * MeasureTheory.eLpNorm f 3 MeasureTheory.volume := by
    intro j
    have hlam_ge : (2 : ℝ) ≤ (2 : ℝ) ^ (j + 1) := by
      have h_nat : 2 ^ 1 ≤ 2 ^ (j + 1) := Nat.pow_le_pow_right (by omega) (by omega)
      exact_mod_cast h_nat
    have hlam_pos : (0 : ℝ) < (2 : ℝ) ^ (j + 1) := by linarith
    have ha_c : Continuous (a_neg j) := ((ha_smooth j).2 0).continuous
    have ha_s : ∀ w, (‖w‖ ≤ 1 / 2 ∨ 2 ≤ ‖w‖) → a_neg j w = 0 :=
      fun w hw => (ha_supp j w hw).2
    obtain ⟨hc, hint, hgc, hgint, hgl3, himp⟩ :=
      dyadic_shell_rescaling_l3 δ (-1) ((2 : ℝ) ^ (j + 1)) C_ν (δ / 2)
        hlam_pos hC_ν_nonneg (a_neg j) ha_c ha_s f
    have hosc := hC_ν (-1) ((2 : ℝ) ^ (j + 1)) (Or.inr rfl) hlam_ge (a_neg j)
      (ha_smooth j).2 ha_s (fun k w => (ha_deriv j k w).2)
      (fun y => f (((2 : ℝ) ^ (j + 1)) • y)) hgc hgint hgl3
    have hbound := himp hosc
    refine ⟨hc, hint, le_trans hbound ?_⟩
    refine mul_le_mul_of_nonneg_right (ENNReal.ofReal_le_ofReal ?_) zero_le
    refine mul_le_mul_of_nonneg_left ?_ hC_ν_nonneg
    have hexp : (((2 : ℝ) ^ (j + 1)) ^ (-δ + δ / 2) : ℝ) = r ^ (j + 1) := by
      have hd : -δ + δ / 2 = -δ / 2 := by ring
      rw [hd, ← Real.rpow_natCast (2 : ℝ) (j + 1),
        ← Real.rpow_mul (by norm_num) ((j + 1 : ℕ) : ℝ) (-δ / 2),
        mul_comm ((j + 1 : ℕ) : ℝ) (-δ / 2),
        Real.rpow_mul (by norm_num) (-δ / 2) ((j + 1 : ℕ) : ℝ),
        Real.rpow_natCast]
    rw [hexp, pow_succ]
    exact mul_le_of_le_one_right (pow_nonneg hr_pos.le j) hr_lt_one.le
  
  have hT_eq : ∀ N : ℕ,
      T N = spatialConv K₀ (⇑f) + ∑ j ∈ Finset.range N,
        (spatialConv (K_pos j) (⇑f) + spatialConv (K_neg j) (⇑f)) := by
    intro N
    ext x
    simp only [T, Pi.add_apply, Finset.sum_apply]
    have h_integrand : (fun y : EuclideanSpace ℝ (Fin 3) =>
        (bochnerRieszKernel δ (x - y) * (Φ N (x - y) : ℂ)) * f y) =
      (fun y => K₀ (x - y) * f y + ∑ j ∈ Finset.range N,
        (K_pos j (x - y) * f y + K_neg j (x - y) * f y)) := by
      ext y
      rw [(hΦ N).2.2.2 (x - y), add_mul, Finset.sum_mul]
      simp only [add_mul, K_pos, K_neg]
    rw [h_integrand]
    have h_each_int : ∀ j ∈ Finset.range N, MeasureTheory.Integrable
        (fun y => K_pos j (x - y) * f y + K_neg j (x - y) * f y) MeasureTheory.volume :=
      fun j _ => ((hShell_pos j).2.1 x).add ((hShell_neg j).2.1 x)
    have h_sum_int : MeasureTheory.Integrable
        (fun y => ∑ j ∈ Finset.range N, (K_pos j (x - y) * f y + K_neg j (x - y) * f y))
        MeasureTheory.volume :=
      MeasureTheory.integrable_finsetSum (Finset.range N) h_each_int
    rw [MeasureTheory.integral_add (hConv0_int x) h_sum_int,
      MeasureTheory.integral_finsetSum (Finset.range N) h_each_int]
    congr 1
    refine Finset.sum_congr rfl (fun j _ => ?_)
    exact MeasureTheory.integral_add ((hShell_pos j).2.1 x) ((hShell_neg j).2.1 x)
  have h_sum_cont : ∀ N : ℕ, Continuous (∑ j ∈ Finset.range N,
      (spatialConv (K_pos j) (⇑f) + spatialConv (K_neg j) (⇑f))) := by
    intro N
    have h_fn : (∑ j ∈ Finset.range N,
        (spatialConv (K_pos j) (⇑f) + spatialConv (K_neg j) (⇑f))) =
      (fun x => ∑ j ∈ Finset.range N,
        (spatialConv (K_pos j) (⇑f) x + spatialConv (K_neg j) (⇑f) x)) := by
      ext x
      simp only [Finset.sum_apply, Pi.add_apply]
    rw [h_fn]
    exact continuous_finsetSum (Finset.range N)
      (fun j _ => (hShell_pos j).1.add (hShell_neg j).1)
  have hT_meas : ∀ N : ℕ, MeasureTheory.AEStronglyMeasurable (T N) MeasureTheory.volume := by
    intro N
    rw [hT_eq N]
    exact (hConv0_cont.add (h_sum_cont N)).aestronglyMeasurable
  have hT_l3 : ∀ N : ℕ,
      MeasureTheory.eLpNorm (T N) 3 MeasureTheory.volume ≤
        ENNReal.ofReal C_δ * MeasureTheory.eLpNorm f 3 MeasureTheory.volume := by
    intro N
    rw [hT_eq N]
    have hp1 : (1 : ENNReal) ≤ 3 := by norm_num
    have h1 : MeasureTheory.eLpNorm (spatialConv K₀ (⇑f) + ∑ j ∈ Finset.range N,
          (spatialConv (K_pos j) (⇑f) + spatialConv (K_neg j) (⇑f))) 3 MeasureTheory.volume ≤
        MeasureTheory.eLpNorm (spatialConv K₀ (⇑f)) 3 MeasureTheory.volume +
          MeasureTheory.eLpNorm (∑ j ∈ Finset.range N,
            (spatialConv (K_pos j) (⇑f) + spatialConv (K_neg j) (⇑f))) 3 MeasureTheory.volume :=
      MeasureTheory.eLpNorm_add_le hp1
    have h2 : MeasureTheory.eLpNorm (∑ j ∈ Finset.range N,
          (spatialConv (K_pos j) (⇑f) + spatialConv (K_neg j) (⇑f))) 3 MeasureTheory.volume ≤
        ∑ j ∈ Finset.range N, MeasureTheory.eLpNorm
          (spatialConv (K_pos j) (⇑f) + spatialConv (K_neg j) (⇑f)) 3 MeasureTheory.volume :=
      MeasureTheory.eLpNorm_sum_le hp1
    have h3 : ∑ j ∈ Finset.range N,
        MeasureTheory.eLpNorm (spatialConv (K_pos j) (⇑f) + spatialConv (K_neg j) (⇑f))
          3 MeasureTheory.volume ≤
      ∑ j ∈ Finset.range N,
        ENNReal.ofReal (2 * C_ν * r ^ j) * MeasureTheory.eLpNorm f 3 MeasureTheory.volume := by
      refine Finset.sum_le_sum (fun j _ => ?_)
      have h_add : MeasureTheory.eLpNorm
            (spatialConv (K_pos j) (⇑f) + spatialConv (K_neg j) (⇑f)) 3 MeasureTheory.volume ≤
          MeasureTheory.eLpNorm (spatialConv (K_pos j) (⇑f)) 3 MeasureTheory.volume +
            MeasureTheory.eLpNorm (spatialConv (K_neg j) (⇑f)) 3 MeasureTheory.volume :=
        MeasureTheory.eLpNorm_add_le hp1
      have h_term_nn : 0 ≤ C_ν * r ^ j := mul_nonneg hC_ν_nonneg (pow_nonneg hr_pos.le j)
      calc MeasureTheory.eLpNorm (spatialConv (K_pos j) (⇑f) + spatialConv (K_neg j) (⇑f))
            3 MeasureTheory.volume
          ≤ MeasureTheory.eLpNorm (spatialConv (K_pos j) (⇑f)) 3 MeasureTheory.volume +
              MeasureTheory.eLpNorm (spatialConv (K_neg j) (⇑f)) 3 MeasureTheory.volume := h_add
        _ ≤ ENNReal.ofReal (C_ν * r ^ j) * MeasureTheory.eLpNorm f 3 MeasureTheory.volume +
              ENNReal.ofReal (C_ν * r ^ j) * MeasureTheory.eLpNorm f 3 MeasureTheory.volume :=
            add_le_add (hShell_pos j).2.2 (hShell_neg j).2.2
        _ = (ENNReal.ofReal (C_ν * r ^ j) + ENNReal.ofReal (C_ν * r ^ j)) *
              MeasureTheory.eLpNorm f 3 MeasureTheory.volume := (add_mul _ _ _).symm
        _ = ENNReal.ofReal (2 * C_ν * r ^ j) *
              MeasureTheory.eLpNorm f 3 MeasureTheory.volume := by
            rw [← ENNReal.ofReal_add h_term_nn h_term_nn]
            congr 2
            ring
    have h_geom : I₀ + ∑ j ∈ Finset.range N, (2 * C_ν * r ^ j) ≤ C_δ := by
      have h_sum_r : ∑ j ∈ Finset.range N, r ^ j ≤ 1 / (1 - r) := by
        rw [le_div_iff₀ h1mr_pos]
        have h_id := geom_sum_mul_neg r N
        have hrN : 0 ≤ r ^ N := pow_nonneg hr_pos.le N
        linarith
      have h_factor : ∑ j ∈ Finset.range N, (2 * C_ν * r ^ j) =
          (2 * C_ν) * ∑ j ∈ Finset.range N, r ^ j := (Finset.mul_sum _ _ _).symm
      rw [h_factor]
      have h_mul := mul_le_mul_of_nonneg_left h_sum_r (mul_nonneg (by norm_num : (0 : ℝ) ≤ 2) hC_ν_nonneg)
      calc I₀ + (2 * C_ν) * ∑ j ∈ Finset.range N, r ^ j
          ≤ I₀ + (2 * C_ν) * (1 / (1 - r)) := add_le_add le_rfl h_mul
        _ = C_δ := by simp only [C_δ, mul_one_div]
    calc MeasureTheory.eLpNorm (spatialConv K₀ (⇑f) + ∑ j ∈ Finset.range N,
          (spatialConv (K_pos j) (⇑f) + spatialConv (K_neg j) (⇑f))) 3 MeasureTheory.volume
        ≤ MeasureTheory.eLpNorm (spatialConv K₀ (⇑f)) 3 MeasureTheory.volume +
            ∑ j ∈ Finset.range N,
              ENNReal.ofReal (2 * C_ν * r ^ j) * MeasureTheory.eLpNorm f 3 MeasureTheory.volume :=
          le_trans h1 (add_le_add le_rfl (le_trans h2 h3))
      _ ≤ ENNReal.ofReal I₀ * MeasureTheory.eLpNorm f 3 MeasureTheory.volume +
            (∑ j ∈ Finset.range N, ENNReal.ofReal (2 * C_ν * r ^ j)) *
              MeasureTheory.eLpNorm f 3 MeasureTheory.volume := by
          rw [Finset.sum_mul]
          exact add_le_add hConv0_l3 le_rfl
      _ = (ENNReal.ofReal I₀ + ∑ j ∈ Finset.range N, ENNReal.ofReal (2 * C_ν * r ^ j)) *
            MeasureTheory.eLpNorm f 3 MeasureTheory.volume := (add_mul _ _ _).symm
      _ = ENNReal.ofReal (I₀ + ∑ j ∈ Finset.range N, (2 * C_ν * r ^ j)) *
            MeasureTheory.eLpNorm f 3 MeasureTheory.volume := by
          have h_sum_nn : 0 ≤ ∑ j ∈ Finset.range N, (2 * C_ν * r ^ j) :=
            Finset.sum_nonneg (fun j _ =>
              mul_nonneg (mul_nonneg (by norm_num) hC_ν_nonneg) (pow_nonneg hr_pos.le j))
          rw [← ENNReal.ofReal_sum_of_nonneg (fun j _ =>
            mul_nonneg (mul_nonneg (by norm_num) hC_ν_nonneg) (pow_nonneg hr_pos.le j)),
            ← ENNReal.ofReal_add hI₀_nonneg h_sum_nn]
      _ ≤ ENNReal.ofReal C_δ * MeasureTheory.eLpNorm f 3 MeasureTheory.volume :=
          mul_le_mul_of_nonneg_right (ENNReal.ofReal_le_ofReal h_geom) zero_le
  
  have h_lim := MeasureTheory.Lp.eLpNorm_lim_le_liminf_eLpNorm
    (p := 3) hT_meas (bochnerRiesz δ f) (hBR f).1.aestronglyMeasurable
    (Filter.Eventually.of_forall hT_tendsto)
  refine le_trans h_lim ?_
  exact Filter.liminf_le_of_frequently_le'
    ((Filter.Eventually.of_forall hT_l3).frequently)
