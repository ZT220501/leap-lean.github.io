                  (M_split : ℝ) (fun s _ => hqD_nn s d) (hqD_sum_s d)
                  (lt_of_lt_of_le zero_lt_one hM_split_real) (by simp))
          _ = (∑ d : Fin N_D, p_D d) * Real.log (M_split : ℝ) := (Finset.sum_mul _ _ _).symm
          _ = Real.log (M_split : ℝ) := by rw [hpD_sum, one_mul]
      rw [h1, h2_clean]
      linarith only [h3]
    
    have h_Emass_lin : ∑ o : Fin N_O, p_O o * Real.log (m_obs o) =
        ∑ s : Fin M_split, α s * (∑ o : Fin N_O, p_cd_O s o * Real.log (m_obs o)) := by
      calc ∑ o : Fin N_O, p_O o * Real.log (m_obs o)
