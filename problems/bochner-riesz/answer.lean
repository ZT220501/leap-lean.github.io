    have hQj_apply : ∀ ω, Q_j ω = if ω ∈ E_j then π ω / pJE j else 0 := by
      intro ω
      dsimp only [Q_j, restrictLaw, E_j]
      rw [hEj_mass]
    haveI : DecidableEq α_T := Classical.decEq α_T
    let qT : α_T → ℝ := fun t => ∑ ω' ∈ E_j, if T ω' = t then π ω' else 0
    let qTY : α_T → ℤ → ℝ := fun t y => ∑ ω' ∈ E_j, if T ω' = t ∧ Y ω' = y then π ω' else 0
    let pTJ : α_T → ℝ := fun t => ∑ ω' : Fin N_ω, if T ω' = t ∧ J ω' = j then π ω' else 0
    let pTJY : α_T → ℤ → ℝ := fun t y =>
      ∑ ω' : Fin N_ω, if (T ω' = t ∧ J ω' = j) ∧ Y ω' = y then π ω' else 0
    have h_qT_eq : ∀ ω, finProbAt Q_j T ω = qT (T ω) / pJE j := by
      intro ω
      unfold finProbAt
      have h1 : (letI := Classical.propDecidable;
          ∑ ω' : Fin N_ω, if T ω' = T ω then Q_j ω' else 0) =
          ∑ ω' ∈ E_j, (if T ω' = T ω then π ω' else 0) / pJE j := by
        have h_congr : (letI := Classical.propDecidable;
            ∑ ω' : Fin N_ω, if T ω' = T ω then Q_j ω' else 0) =
            ∑ ω' : Fin N_ω,
              if ω' ∈ E_j then (if T ω' = T ω then π ω' else 0) / pJE j else 0 := by
          refine Finset.sum_congr rfl (fun ω' _ => ?_)
          rw [hQj_apply ω']
          by_cases hT : T ω' = T ω <;> by_cases hE : ω' ∈ E_j <;> simp [hT, hE]
        rw [h_congr, ← Finset.sum_filter]
        congr 1
        ext ω'
        simp
      rw [h1, ← Finset.sum_div]
    have h_qTY_eq : ∀ ω, finProbAt2 Q_j T Y ω = qTY (T ω) (Y ω) / pJE j := by
      intro ω
      unfold finProbAt2
      have h1 : (letI := Classical.propDecidable;
          ∑ ω' : Fin N_ω, if T ω' = T ω ∧ Y ω' = Y ω then Q_j ω' else 0) =
          ∑ ω' ∈ E_j, (if T ω' = T ω ∧ Y ω' = Y ω then π ω' else 0) / pJE j := by
        have h_congr : (letI := Classical.propDecidable;
            ∑ ω' : Fin N_ω, if T ω' = T ω ∧ Y ω' = Y ω then Q_j ω' else 0) =
            ∑ ω' : Fin N_ω,
              if ω' ∈ E_j then (if T ω' = T ω ∧ Y ω' = Y ω then π ω' else 0) / pJE j else 0 := by
          refine Finset.sum_congr rfl (fun ω' _ => ?_)
          rw [hQj_apply ω']
          by_cases hTY : T ω' = T ω ∧ Y ω' = Y ω <;> by_cases hE : ω' ∈ E_j <;> simp [hTY, hE]
        rw [h_congr, ← Finset.sum_filter]
        congr 1
        ext ω'
        simp
      rw [h1, ← Finset.sum_div]
    have h_pTJ_eq : ∀ ω ∈ E_j, finProbAt π (fun ω' => (T ω', J ω')) ω = pTJ (T ω) := by
      intro ω hω
      have hJω : J ω = j := (Finset.mem_filter.mp hω).2
      unfold finProbAt
      refine Finset.sum_congr rfl (fun ω' _ => ?_)
      refine h_ite_iff _ _ _ _ ?_
      simp [Prod.mk.injEq, hJω]
    have h_pTJY_eq : ∀ ω ∈ E_j, finProbAt2 π (fun ω' => (T ω', J ω')) Y ω = pTJY (T ω) (Y ω) := by
      intro ω hω
      have hJω : J ω = j := (Finset.mem_filter.mp hω).2
      unfold finProbAt2
      refine Finset.sum_congr rfl (fun ω' _ => ?_)
      refine h_ite_iff _ _ _ _ ?_
      simp [Prod.mk.injEq, hJω]
    let d_lo : ℝ := d₀ - α
    let d_hi : ℝ := d₀ + α
    have h_sandwich : ∀ ω ∈ E_j,
        0 < pTJ (T ω) ∧
        ε ^ d_hi * pTJ (T ω) ≤ pTJY (T ω) (Y ω) ∧
        pTJY (T ω) (Y ω) ≤ ε ^ d_lo * pTJ (T ω) := by
      intro ω hω
      obtain ⟨hωE, hJω⟩ := Finset.mem_filter.mp hω
      have hπ_p : 0 < π ω := hE_pos ω hωE
      obtain ⟨hp1, hp2, _⟩ :=
        (h_pos_nn ε π (fun ω' => (T ω', J ω')) Y hε₀ hε₁ hπ_nn).1 ω hπ_p
      rw [h_pTJ_eq ω hω] at hp1
      rw [h_pTJY_eq ω hω] at hp2
      obtain ⟨h_ge, h_le⟩ := abs_sub_le_iff.mp (hY_hom ω hωE hJω)
      unfold condSurprise at h_ge h_le
      rw [h_pTJ_eq ω hω, h_pTJY_eq ω hω] at h_ge h_le
      have h_upper_s : -(Real.log (pTJY (T ω) (Y ω) / pTJ (T ω))) ≤ d_hi * Real.log (ε⁻¹) := by
        have h1 : -(Real.log (pTJY (T ω) (Y ω) / pTJ (T ω))) / Real.log (ε⁻¹) ≤ d_hi := by
          dsimp [d_hi]; linarith
        exact (div_le_iff₀ hℓ).mp h1
      have h_lower_s : d_lo * Real.log (ε⁻¹) ≤ -(Real.log (pTJY (T ω) (Y ω) / pTJ (T ω))) := by
        have h1 : d_lo ≤ -(Real.log (pTJY (T ω) (Y ω) / pTJ (T ω))) / Real.log (ε⁻¹) := by
          dsimp [d_lo]; linarith
        exact (le_div_iff₀ hℓ).mp h1
      have h_log_hi : Real.log (ε ^ d_hi) ≤ Real.log (pTJY (T ω) (Y ω) / pTJ (T ω)) := by
        rw [Real.log_rpow hε₀]
        have h_inv : Real.log ε = -Real.log (ε⁻¹) := by rw [Real.log_inv, neg_neg]
        rw [h_inv]
        linarith
      have h_log_lo : Real.log (pTJY (T ω) (Y ω) / pTJ (T ω)) ≤ Real.log (ε ^ d_lo) := by
        rw [Real.log_rpow hε₀]
        have h_inv : Real.log ε = -Real.log (ε⁻¹) := by rw [Real.log_inv, neg_neg]
        rw [h_inv]
        linarith
      have h_r_hi : ε ^ d_hi ≤ pTJY (T ω) (Y ω) / pTJ (T ω) :=
        (Real.log_le_log_iff (Real.rpow_pos_of_pos hε₀ d_hi) (div_pos hp2 hp1)).mp h_log_hi
      have h_r_lo : pTJY (T ω) (Y ω) / pTJ (T ω) ≤ ε ^ d_lo :=
        (Real.log_le_log_iff (div_pos hp2 hp1) (Real.rpow_pos_of_pos hε₀ d_lo)).mp h_log_lo
      exact ⟨hp1, (le_div_iff₀ hp1).mp h_r_hi, (div_le_iff₀ hp1).mp h_r_lo⟩
    have h_qTY_le_pTJY : ∀ t y, qTY t y ≤ pTJY t y := by
      intro t y
      calc qTY t y
          = ∑ ω' ∈ E_j, if (T ω' = t ∧ J ω' = j) ∧ Y ω' = y then π ω' else 0 := by
            refine Finset.sum_congr rfl (fun ω' hω' => ?_)
            have hJω' : J ω' = j := (Finset.mem_filter.mp hω').2
            by_cases hT : T ω' = t <;> by_cases hY : Y ω' = y <;> simp [hT, hY, hJω']
        _ ≤ pTJY t y := Finset.sum_le_univ_sum_of_nonneg
            (fun ω' => by split_ifs <;> [exact hπ_nn ω'; exact le_rfl])
    have h_good_atom : ∀ ω ∈ E_j,
        lam * pJE j * pTJ (T ω) ≤ pJ j * qT (T ω) →
        lam * ε ^ d_hi * qT (T ω) ≤ qTY (T ω) (Y ω) →
        |condSurprise ε Q_j T Y ω - d₀| ≤ err_j := by
      intro ω hω h_gp h_gc
      obtain ⟨hp1, _, h_p_lo⟩ := h_sandwich ω hω
      have hπ_p : 0 < π ω := hE_pos ω (Finset.mem_filter.mp hω).1
      have hqTY_p : 0 < qTY (T ω) (Y ω) := by
        refine lt_of_lt_of_le hπ_p ?_
        calc π ω = (if T ω = T ω ∧ Y ω = Y ω then π ω else 0) := by simp
          _ ≤ qTY (T ω) (Y ω) := Finset.single_le_sum
              (f := fun ω' => if T ω' = T ω ∧ Y ω' = Y ω then π ω' else 0)
              (fun ω' _ => by split_ifs <;> [exact hπ_nn ω'; exact le_rfl]) hω
      have hqT_p : 0 < qT (T ω) := by
        refine lt_of_lt_of_le hqTY_p ?_
        refine Finset.sum_le_sum (fun ω' _ => ?_)
        by_cases hT : T ω' = T ω
        · by_cases hY : Y ω' = Y ω <;> simp [hT, hY, hπ_nn ω']
        · simp [hT]
      have h_qT_lb : m_E * lam ^ 2 * pTJ (T ω) ≤ qT (T ω) := by
        have h_mul1 : (lam * pTJ (T ω)) * (lam * m_E * pJ j) ≤ (lam * pTJ (T ω)) * pJE j :=
          mul_le_mul_of_nonneg_left hj_ret (mul_nonneg hlam₀.le hp1.le)
        have h_mul2 : pJ j * (m_E * lam ^ 2 * pTJ (T ω)) ≤ pJ j * qT (T ω) := by
          linarith [h_mul1, h_gp]
        exact le_of_mul_le_mul_left h_mul2 hpJ_pos
      have hm_lam_pos : 0 < m_E * lam ^ 2 := mul_pos hmE_pos (pow_pos hlam₀ 2)
      have h_inv_pos : 0 < 1 / (m_E * lam ^ 2) := div_pos zero_lt_one hm_lam_pos
      have h_ratio_ub : qTY (T ω) (Y ω) / qT (T ω) ≤ ε ^ d_lo * (1 / (m_E * lam ^ 2)) := by
        rw [div_le_iff₀ hqT_p]
        calc qTY (T ω) (Y ω)
            ≤ pTJY (T ω) (Y ω) := h_qTY_le_pTJY (T ω) (Y ω)
          _ ≤ ε ^ d_lo * pTJ (T ω) := h_p_lo
          _ = (ε ^ d_lo * (1 / (m_E * lam ^ 2))) * (m_E * lam ^ 2 * pTJ (T ω)) := by
              rw [one_div, mul_assoc, inv_mul_cancel_left₀ hm_lam_pos.ne']
          _ ≤ (ε ^ d_lo * (1 / (m_E * lam ^ 2))) * qT (T ω) :=
              mul_le_mul_of_nonneg_left h_qT_lb
                (mul_nonneg (Real.rpow_nonneg hε₀.le d_lo) h_inv_pos.le)
      have hm_lam_le : m_E * lam ^ 2 ≤ lam := by nlinarith [hmE_le1, hlam₀, hlam₁]
      have h_ratio_lb : ε ^ d_hi * (m_E * lam ^ 2) ≤ qTY (T ω) (Y ω) / qT (T ω) := by
        rw [le_div_iff₀ hqT_p]
        calc ε ^ d_hi * (m_E * lam ^ 2) * qT (T ω)
            ≤ ε ^ d_hi * lam * qT (T ω) :=
              mul_le_mul_of_nonneg_right
                (mul_le_mul_of_nonneg_left hm_lam_le (Real.rpow_nonneg hε₀.le d_hi)) hqT_p.le
          _ = lam * ε ^ d_hi * qT (T ω) := by ring
          _ ≤ qTY (T ω) (Y ω) := h_gc
      have h_inv_log : Real.log (m_E * lam ^ 2) = -Real.log (1 / (m_E * lam ^ 2)) := by
        rw [one_div, Real.log_inv, neg_neg]
      have h_eps_log : Real.log ε = -Real.log (ε⁻¹) := by rw [Real.log_inv, neg_neg]
      have h_log_ub : Real.log (qTY (T ω) (Y ω) / qT (T ω)) ≤
          -(d_lo * Real.log (ε⁻¹)) + Real.log (1 / (m_E * lam ^ 2)) := by
        calc Real.log (qTY (T ω) (Y ω) / qT (T ω))
            ≤ Real.log (ε ^ d_lo * (1 / (m_E * lam ^ 2))) :=
              Real.log_le_log (div_pos hqTY_p hqT_p) h_ratio_ub
          _ = Real.log (ε ^ d_lo) + Real.log (1 / (m_E * lam ^ 2)) :=
              Real.log_mul (Real.rpow_pos_of_pos hε₀ d_lo).ne' h_inv_pos.ne'
          _ = -(d_lo * Real.log (ε⁻¹)) + Real.log (1 / (m_E * lam ^ 2)) := by
              rw [Real.log_rpow hε₀, h_eps_log]; ring
      have h_log_lb : -(d_hi * Real.log (ε⁻¹)) - Real.log (1 / (m_E * lam ^ 2)) ≤
          Real.log (qTY (T ω) (Y ω) / qT (T ω)) := by
        calc -(d_hi * Real.log (ε⁻¹)) - Real.log (1 / (m_E * lam ^ 2))
            = Real.log (ε ^ d_hi) + Real.log (m_E * lam ^ 2) := by
              rw [Real.log_rpow hε₀, h_eps_log, h_inv_log]; ring
          _ = Real.log (ε ^ d_hi * (m_E * lam ^ 2)) :=
              (Real.log_mul (Real.rpow_pos_of_pos hε₀ d_hi).ne' hm_lam_pos.ne').symm
          _ ≤ Real.log (qTY (T ω) (Y ω) / qT (T ω)) :=
              Real.log_le_log (mul_pos (Real.rpow_pos_of_pos hε₀ d_hi) hm_lam_pos) h_ratio_lb
      have h_surp_eq : condSurprise ε Q_j T Y ω =
          -(Real.log (qTY (T ω) (Y ω) / qT (T ω))) / Real.log (ε⁻¹) := by
        unfold condSurprise
        rw [h_qT_eq ω, h_qTY_eq ω, div_div_div_cancel_right₀ hj_pos.ne']
      have h_err_mul : err_j * Real.log (ε⁻¹) =
          α * Real.log (ε⁻¹) + Real.log (1 / (m_E * lam ^ 2)) := by
        dsimp [err_j, m_E]
        rw [add_mul, div_mul_cancel₀ _ hℓ.ne']
      rw [h_surp_eq, abs_sub_le_iff]
      constructor
      · rw [sub_le_iff_le_add', div_le_iff₀ hℓ, add_mul, h_err_mul]
        dsimp [d_hi] at h_log_lb
        linarith
      · rw [sub_le_iff_le_add, ← sub_le_iff_le_add', le_div_iff₀ hℓ, sub_mul, h_err_mul]
        dsimp [d_lo] at h_log_ub
        linarith
    let S_T : Finset α_T := E_j.image T
    let U_T : Finset α_T := Finset.univ.image T
    have h_bad_par : (∑ ω ∈ E_j,
        if pJ j * qT (T ω) < lam * pJE j * pTJ (T ω) then π ω else 0) ≤ lam * pJE j := by
      have h_grp : (∑ ω ∈ E_j,
          if pJ j * qT (T ω) < lam * pJE j * pTJ (T ω) then π ω else 0) =
          ∑ t ∈ S_T, if pJ j * qT t < lam * pJE j * pTJ t then qT t else 0 := by
        dsimp only [qT]
        have h_rhs : (∑ t ∈ S_T, if pJ j * (∑ ω' ∈ E_j, if T ω' = t then π ω' else 0) <
            lam * pJE j * pTJ t then (∑ ω' ∈ E_j, if T ω' = t then π ω' else 0) else 0) =
            ∑ t ∈ S_T, ∑ ω ∈ E_j,
              if T ω = t then
                (if pJ j * qT t < lam * pJE j * pTJ t then π ω else 0) else 0 := by
          refine Finset.sum_congr rfl (fun t _ => ?_)
          by_cases hp : pJ j * qT t < lam * pJE j * pTJ t <;> simp [hp, qT]
        rw [h_rhs, Finset.sum_comm]
        refine Finset.sum_congr rfl (fun ω hω => ?_)
        have hm : T ω ∈ S_T := Finset.mem_image_of_mem T hω
        rw [Finset.sum_ite_eq S_T (T ω)
          (fun t => if pJ j * qT t < lam * pJE j * pTJ t then π ω else 0)]
        simp [hm, qT]
      have h_ST_sub : S_T ⊆ U_T := by
        intro t ht
        obtain ⟨ω, _, rfl⟩ := Finset.mem_image.mp ht
        exact Finset.mem_image_of_mem T (Finset.mem_univ ω)
      have h_sum_pTJ : ∑ t ∈ U_T, pTJ t = pJ j := by
        dsimp only [pTJ, pJ]
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl (fun ω' _ => ?_)
        have hm : T ω' ∈ U_T := Finset.mem_image_of_mem T (Finset.mem_univ ω')
        by_cases hJ : J ω' = j
        · simp only [hJ, and_true]
          exact (Finset.sum_ite_eq U_T (T ω') (fun _ => π ω')).trans (by simp [hm])
        · simp [hJ]
      rw [h_grp]
      calc (∑ t ∈ S_T, if pJ j * qT t < lam * pJE j * pTJ t then qT t else 0)
          ≤ ∑ t ∈ S_T, (lam * pJE j / pJ j) * pTJ t := by
            refine Finset.sum_le_sum (fun t _ => ?_)
            by_cases hp : pJ j * qT t < lam * pJE j * pTJ t
            · simp only [hp, ↓reduceIte]
              rw [div_mul_eq_mul_div, le_div_iff₀ hpJ_pos]
              linarith
            · simp only [hp, ↓reduceIte]
              exact mul_nonneg (div_nonneg (mul_nonneg hlam₀.le hj_pos.le) hpJ_pos.le)
                (Finset.sum_nonneg (fun ω' _ => by split_ifs <;> [exact hπ_nn ω'; exact le_rfl]))
        _ = (lam * pJE j / pJ j) * ∑ t ∈ S_T, pTJ t := (Finset.mul_sum _ _ _).symm
        _ ≤ (lam * pJE j / pJ j) * ∑ t ∈ U_T, pTJ t :=
            mul_le_mul_of_nonneg_left
              (Finset.sum_le_sum_of_subset_of_nonneg h_ST_sub (fun t _ _ =>
                Finset.sum_nonneg (fun ω' _ => by split_ifs <;> [exact hπ_nn ω'; exact le_rfl])))
              (div_nonneg (mul_nonneg hlam₀.le hj_pos.le) hpJ_pos.le)
        _ = lam * pJE j := by rw [h_sum_pTJ, div_mul_cancel₀ _ hpJ_pos.ne']
    have h_bad_child : (∑ ω ∈ E_j,
        if qTY (T ω) (Y ω) < lam * ε ^ d_hi * qT (T ω) then π ω else 0) ≤ lam * pJE j := by
      let U_Y : Finset ℤ := Finset.univ.image Y
      have h_per_t : ∀ t ∈ S_T,
          (∑ ω ∈ E_j, if T ω = t then
            (if qTY t (Y ω) < lam * ε ^ d_hi * qT t then π ω else 0) else 0) ≤ lam * qT t := by
        intro t ht
        obtain ⟨ω₀, hω₀, rfl⟩ := Finset.mem_image.mp ht
        let t₀ := T ω₀
        have hp1_0 : 0 < pTJ t₀ := (h_sandwich ω₀ hω₀).1
        let E_jt : Finset (Fin N_ω) := E_j.filter (fun ω => T ω = t₀)
        let Y_t : Finset ℤ := E_jt.image Y
        have h_Yt_sub : Y_t ⊆ U_Y := by
          intro y hy
          obtain ⟨ω, _, rfl⟩ := Finset.mem_image.mp hy
          exact Finset.mem_image_of_mem Y (Finset.mem_univ ω)
        have h_sum_pTJY : ∑ y ∈ U_Y, pTJY t₀ y = pTJ t₀ := by
          dsimp only [pTJY, pTJ]
          rw [Finset.sum_comm]
          refine Finset.sum_congr rfl (fun ω' _ => ?_)
          have hm : Y ω' ∈ U_Y := Finset.mem_image_of_mem Y (Finset.mem_univ ω')
          by_cases hTJ : T ω' = t₀ ∧ J ω' = j
          · simp only [hTJ, true_and]
            exact (Finset.sum_ite_eq U_Y (Y ω') (fun _ => π ω')).trans (by simp [hm])
          · simp [hTJ]
        have h_card_Yt : (Y_t.card : ℝ) * ε ^ d_hi ≤ 1 := by
          have h_lb : ∀ y ∈ Y_t, ε ^ d_hi * pTJ t₀ ≤ pTJY t₀ y := by
            intro y hy
            obtain ⟨ω_y, hω_y, rfl⟩ := Finset.mem_image.mp hy
            obtain ⟨hω_Ej, hT_eq⟩ := Finset.mem_filter.mp hω_y
            have h_s := (h_sandwich ω_y hω_Ej).2.1
            rwa [hT_eq] at h_s
          have h_sum_lb : ((Y_t.card : ℝ) * ε ^ d_hi) * pTJ t₀ ≤ 1 * pTJ t₀ := by
            calc ((Y_t.card : ℝ) * ε ^ d_hi) * pTJ t₀
                = ∑ _y ∈ Y_t, (ε ^ d_hi * pTJ t₀) := by
                  rw [Finset.sum_const, nsmul_eq_mul, mul_assoc]
              _ ≤ ∑ y ∈ Y_t, pTJY t₀ y := Finset.sum_le_sum h_lb
              _ ≤ ∑ y ∈ U_Y, pTJY t₀ y :=
                  Finset.sum_le_sum_of_subset_of_nonneg h_Yt_sub (fun y _ _ =>
                    Finset.sum_nonneg (fun ω' _ => by split_ifs <;> [exact hπ_nn ω'; exact le_rfl]))
              _ = 1 * pTJ t₀ := by rw [h_sum_pTJY, one_mul]
          exact le_of_mul_le_mul_right h_sum_lb hp1_0
        have h_grp_y : (∑ ω ∈ E_j, if T ω = t₀ then
            (if qTY t₀ (Y ω) < lam * ε ^ d_hi * qT t₀ then π ω else 0) else 0) =
            ∑ y ∈ Y_t, if qTY t₀ y < lam * ε ^ d_hi * qT t₀ then qTY t₀ y else 0 := by
          have h_rhs : (∑ y ∈ Y_t, if qTY t₀ y < lam * ε ^ d_hi * qT t₀ then qTY t₀ y else 0) =
              ∑ y ∈ Y_t, ∑ ω ∈ E_j,
                if T ω = t₀ ∧ Y ω = y then
                  (if qTY t₀ y < lam * ε ^ d_hi * qT t₀ then π ω else 0) else 0 := by
            refine Finset.sum_congr rfl (fun y _ => ?_)
            by_cases hq : qTY t₀ y < lam * ε ^ d_hi * qT t₀ <;> simp [hq, qTY]
          rw [h_rhs, Finset.sum_comm]
          refine Finset.sum_congr rfl (fun ω hω => ?_)
          by_cases hT : T ω = t₀
          · have hm : Y ω ∈ Y_t := Finset.mem_image_of_mem Y (Finset.mem_filter.mpr ⟨hω, hT⟩)
            simp only [hT, true_and]
            rw [Finset.sum_ite_eq Y_t (Y ω)
              (fun y => if qTY t₀ y < lam * ε ^ d_hi * qT t₀ then π ω else 0)]
            simp [hm]
          · simp [hT]
        have hqT_nn : 0 ≤ qT t₀ :=
          Finset.sum_nonneg (fun ω' _ => by split_ifs <;> [exact hπ_nn ω'; exact le_rfl])
        rw [h_grp_y]
        calc (∑ y ∈ Y_t, if qTY t₀ y < lam * ε ^ d_hi * qT t₀ then qTY t₀ y else 0)
            ≤ ∑ _y ∈ Y_t, (lam * ε ^ d_hi * qT t₀) := by
              refine Finset.sum_le_sum (fun y _ => ?_)
              by_cases hq : qTY t₀ y < lam * ε ^ d_hi * qT t₀
              · simp [hq, hq.le]
              · simp only [hq, ↓reduceIte]
                exact mul_nonneg (mul_nonneg hlam₀.le (Real.rpow_nonneg hε₀.le d_hi)) hqT_nn
          _ = ((Y_t.card : ℝ) * ε ^ d_hi) * (lam * qT t₀) := by
              rw [Finset.sum_const, nsmul_eq_mul]
              ring
          _ ≤ 1 * (lam * qT t₀) :=
              mul_le_mul_of_nonneg_right h_card_Yt (mul_nonneg hlam₀.le hqT_nn)
          _ = lam * qT t₀ := one_mul _
      have h_decomp_t : (∑ ω ∈ E_j,
