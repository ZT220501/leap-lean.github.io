            rw [if_neg hX, if_neg hp, zero_div]
        · have hp : ¬ ((fun ω'' => (X ω'', ev ω'')) ω' = (fun ω'' => (X ω'', ev ω'')) ω) :=
            fun h => hev' ((congrArg Prod.snd h).trans hev)
