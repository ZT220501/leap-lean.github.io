    have hj_ret : lam * m_E * pJ j ≤ pJE j := (Finset.mem_filter.mp hj).2.2
    have hpJ_pos : 0 < pJ j := lt_of_lt_of_le hj_pos (hpJE_le_pJ j)
    let E_j : Finset (Fin N_ω) := E.filter (fun ω => J ω = j)
