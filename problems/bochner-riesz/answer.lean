    omega
  have hM_all_bound : (M_all : ℝ) ≤ 100000 * ε ^ (-(6 + 5 * m)) := by
    have hf1 : ((2 ^ m_u : ℕ) : ℝ) ≤ 4 * ε ^ (-1 : ℝ) := by
      push_cast
      exact le_trans (h_tl u hu₀.le).2
        (mul_le_mul_of_nonneg_left (hε_anti (by linarith)) (by norm_num))
    have hf2 : ((2 ^ m_e : ℕ) : ℝ) ≤ 4 * ε ^ (-(1 + m)) := by
      push_cast
      exact le_trans (h_tl (a - b) h_ab_nn).2
        (mul_le_mul_of_nonneg_left (hε_anti (by linarith)) (by norm_num))
    have hf3 : ((2 * B₁ + 1 : ℕ) : ℝ) ≤ 5 * ε ^ (-(1 + m)) := by
      have h_raw := (h_rb_pow 1 (1 + m) h_1m_nn).1
      have hc : ((2 * 1 + 3 : ℕ) : ℝ) = 5 := by norm_num
      rwa [hc] at h_raw
    have hf5 : ((2 * B₂ + 1 : ℕ) : ℝ) ≤ 7 * ε ^ (-(1 + m)) := by
      have h_raw := (h_rb_pow 2 (1 + m) h_1m_nn).1
      have hc : ((2 * 2 + 3 : ℕ) : ℝ) = 7 := by norm_num
      rwa [hc] at h_raw
    have h12 : ((2 ^ m_u * 2 ^ m_e : ℕ) : ℝ) ≤ (4 * ε ^ (-1 : ℝ)) * (4 * ε ^ (-(1 + m))) := by
      rw [Nat.cast_mul]
      exact mul_le_mul hf1 hf2 (by positivity) (by positivity)
    have h123 : ((2 ^ m_u * 2 ^ m_e * (2 * B₁ + 1) : ℕ) : ℝ) ≤
        ((4 * ε ^ (-1 : ℝ)) * (4 * ε ^ (-(1 + m)))) * (5 * ε ^ (-(1 + m))) := by
      rw [Nat.cast_mul]
      exact mul_le_mul h12 hf3 (by positivity) (by positivity)
    have h1234 : ((2 ^ m_u * 2 ^ m_e * (2 * B₁ + 1) * (2 * B₁ + 1) : ℕ) : ℝ) ≤
        (((4 * ε ^ (-1 : ℝ)) * (4 * ε ^ (-(1 + m)))) * (5 * ε ^ (-(1 + m)))) *
          (5 * ε ^ (-(1 + m))) := by
      rw [Nat.cast_mul]
      exact mul_le_mul h123 hf3 (by positivity) (by positivity)
    have h12345 : ((2 ^ m_u * 2 ^ m_e * (2 * B₁ + 1) * (2 * B₁ + 1) * (2 * B₂ + 1) : ℕ) : ℝ) ≤
        ((((4 * ε ^ (-1 : ℝ)) * (4 * ε ^ (-(1 + m)))) * (5 * ε ^ (-(1 + m)))) *
          (5 * ε ^ (-(1 + m)))) * (7 * ε ^ (-(1 + m))) := by
