            fun hu2 => hu ⟨hu0, hu1, hu2⟩
          have hu2_cases : u 2 ≤ 1 / 6 ∨ 2 ≤ u 2 := by
            by_contra h_in
            push Not at h_in
            exact hu2_not ⟨h_in.1, h_in.2⟩
          have hG0 : G (z, y₂) = 0 := by
            dsimp [G, distPhaseSliceOp]
            have h_vanish : ∀ v : EuclideanSpace ℝ (Fin 2),
                a_dir (u - sliceEmbed v 0) = 0 := by
              intro v
              rcases hu2_cases with hle | hge
              · refine ha_dir_supp (u - sliceEmbed v 0) (Or.inr (Or.inr ?_))
                have hc2 : (u - sliceEmbed v 0) 2 = u 2 := by simp [sliceEmbed, L3_toLp]
                rw [hc2]; exact hle
              · refine ha_dir_supp (u - sliceEmbed v 0) (Or.inr (Or.inl ?_))
                let w := u - sliceEmbed v 0
                have hw2 : 2 ≤ w 2 := by
                  have hc2 : w 2 = u 2 := by simp [w, sliceEmbed, L3_toLp]
                  rw [hc2]; exact hge
                have hw_sq : 4 ≤ ‖w‖ ^ 2 := by
                  rw [h_norm3_sq w]
                  have : 0 ≤ (w 0) ^ 2 + (w 1) ^ 2 := by positivity
                  nlinarith
                nlinarith [norm_nonneg w]
            change ∫ v : EuclideanSpace ℝ (Fin 2),
              Complex.exp (2 * Real.pi * Complex.I *
                ((σ * lam * ‖u - sliceEmbed v 0‖ : ℝ) : ℂ)) *
                a_dir (u - sliceEmbed v 0) * f_slice y₂ v = 0
            simp only [h_vanish, mul_zero, zero_mul, MeasureTheory.integral_zero]
          rw [hG0]
          simp
      · rw [Set.indicator_of_notMem hz]
        exact zero_le
    have h_step1 : ∫⁻ z in Q0, ‖G (z, y₂)‖ₑ ^ (3 : ℝ) ∂MeasureTheory.volume ≤
        ∫⁻ u in U0, H_y2 u ∂MeasureTheory.volume := by
      rw [← MeasureTheory.lintegral_indicator hQ0_meas,
        ← MeasureTheory.lintegral_indicator hU0_meas]
      calc ∫⁻ z, Q0.indicator (fun z' => ‖G (z', y₂)‖ₑ ^ (3 : ℝ)) z ∂MeasureTheory.volume
          ≤ ∫⁻ z, U0.indicator H_y2 (z - sliceEmbed 0 y₂) ∂MeasureTheory.volume :=
            MeasureTheory.lintegral_mono h_ind_le
        _ = ∫⁻ u, U0.indicator H_y2 u ∂MeasureTheory.volume :=
            MeasureTheory.lintegral_sub_right_eq_self (U0.indicator H_y2) (sliceEmbed 0 y₂)
    exact le_trans h_step1 (h_slice_u0 (f_slice y₂) (hf_slice_cont y₂) (hf_slice_supp y₂))

  
  have h_3d_fubini :
      ∫⁻ y₂ : ℝ, (∫⁻ v : EuclideanSpace ℝ (Fin 2),
        ‖h (sliceEmbed v y₂)‖ₑ ^ (3 : ℝ) ∂MeasureTheory.volume) ∂MeasureTheory.volume =
      ∫⁻ y : EuclideanSpace ℝ (Fin 3), ‖h y‖ₑ ^ (3 : ℝ) ∂MeasureTheory.volume := by
    have h_meas_fn : Measurable
        (fun p : ℝ × EuclideanSpace ℝ (Fin 2) => ‖h (e3.symm p)‖ₑ ^ (3 : ℝ)) :=
      ((hh_cont.enorm.measurable.comp e3.symm.measurable).pow_const (3 : ℝ))
    have h_prod := MeasureTheory.lintegral_prod
      (μ := MeasureTheory.volume) (ν := MeasureTheory.volume)
      (fun p : ℝ × EuclideanSpace ℝ (Fin 2) => ‖h (e3.symm p)‖ₑ ^ (3 : ℝ))
      h_meas_fn.aemeasurable
    have h_emb := he3_symm_mp.lintegral_comp_emb e3.symm.measurableEmbedding
      (fun y : EuclideanSpace ℝ (Fin 3) => ‖h y‖ₑ ^ (3 : ℝ))
    rw [← h_emb, h_prod]
    congr 1
    ext y₂
    congr 1
    ext v
    rw [he3_symm_apply y₂ v]

  have hG_rpow_meas : Measurable
      (Function.uncurry (fun (z : EuclideanSpace ℝ (Fin 3)) (y₂ : ℝ) =>
        ‖G (z, y₂)‖ₑ ^ (3 : ℝ))) :=
    (hG_cont.enorm.measurable.pow_const (3 : ℝ))

  have h_total_lintegral :
      ∫⁻ z in Q0, ‖distPhaseOscOp σ lam a_dir h z‖ₑ ^ (3 : ℝ) ∂MeasureTheory.volume ≤
        ENNReal.ofReal ((60 * C_2d) ^ 3) *
          ∫⁻ y : EuclideanSpace ℝ (Fin 3), ‖h y‖ₑ ^ (3 : ℝ) ∂MeasureTheory.volume := by
    have h_stepA :
        ∫⁻ z in Q0, ‖distPhaseOscOp σ lam a_dir h z‖ₑ ^ (3 : ℝ) ∂MeasureTheory.volume ≤
          9 * ∫⁻ z in Q0,
            (∫⁻ y₂ in Set.Icc (-2 : ℝ) 1, ‖G (z, y₂)‖ₑ ^ (3 : ℝ) ∂MeasureTheory.volume)
            ∂MeasureTheory.volume := by
      rw [← MeasureTheory.lintegral_const_mul' 9 _ (by norm_num)]
      exact MeasureTheory.setLIntegral_mono' hQ0_meas h_pt_holder
    have h_swap :
        ∫⁻ z in Q0,
          (∫⁻ y₂ in Set.Icc (-2 : ℝ) 1, ‖G (z, y₂)‖ₑ ^ (3 : ℝ) ∂MeasureTheory.volume)
          ∂MeasureTheory.volume =
        ∫⁻ y₂ in Set.Icc (-2 : ℝ) 1,
          (∫⁻ z in Q0, ‖G (z, y₂)‖ₑ ^ (3 : ℝ) ∂MeasureTheory.volume)
          ∂MeasureTheory.volume :=
      MeasureTheory.lintegral_lintegral_swap hG_rpow_meas.aemeasurable
    have h_stepB :
        ∫⁻ y₂ in Set.Icc (-2 : ℝ) 1,
          (∫⁻ z in Q0, ‖G (z, y₂)‖ₑ ^ (3 : ℝ) ∂MeasureTheory.volume)
          ∂MeasureTheory.volume ≤
        ∫⁻ y₂ : ℝ,
          (8192 * (ENNReal.ofReal (C_2d ^ 3) *
            ∫⁻ v : EuclideanSpace ℝ (Fin 2),
              ‖h (sliceEmbed v y₂)‖ₑ ^ (3 : ℝ) ∂MeasureTheory.volume))
          ∂MeasureTheory.volume := by
      refine le_trans (MeasureTheory.setLIntegral_le_lintegral (Set.Icc (-2 : ℝ) 1) _) ?_
      exact MeasureTheory.lintegral_mono h_z_trans
    have h_pull :
        ∫⁻ y₂ : ℝ,
          (8192 * (ENNReal.ofReal (C_2d ^ 3) *
            ∫⁻ v : EuclideanSpace ℝ (Fin 2),
              ‖h (sliceEmbed v y₂)‖ₑ ^ (3 : ℝ) ∂MeasureTheory.volume))
          ∂MeasureTheory.volume =
        (8192 * ENNReal.ofReal (C_2d ^ 3)) *
          ∫⁻ y : EuclideanSpace ℝ (Fin 3), ‖h y‖ₑ ^ (3 : ℝ) ∂MeasureTheory.volume := by
      have h_assoc : (fun y₂ : ℝ =>
          8192 * (ENNReal.ofReal (C_2d ^ 3) *
            ∫⁻ v : EuclideanSpace ℝ (Fin 2),
              ‖h (sliceEmbed v y₂)‖ₑ ^ (3 : ℝ) ∂MeasureTheory.volume)) =
        (fun y₂ : ℝ =>
          (8192 * ENNReal.ofReal (C_2d ^ 3)) *
            ∫⁻ v : EuclideanSpace ℝ (Fin 2),
              ‖h (sliceEmbed v y₂)‖ₑ ^ (3 : ℝ) ∂MeasureTheory.volume) := by
        ext y₂; rw [mul_assoc]
      rw [h_assoc, MeasureTheory.lintegral_const_mul' (8192 * ENNReal.ofReal (C_2d ^ 3)) _
        (ENNReal.mul_ne_top (by norm_num) ENNReal.ofReal_ne_top), h_3d_fubini]
    have h_const_le : (9 : ENNReal) * (8192 * ENNReal.ofReal (C_2d ^ 3)) ≤
        ENNReal.ofReal ((60 * C_2d) ^ 3) := by
      have h73728 : (9 : ENNReal) * 8192 = ENNReal.ofReal 73728 := by norm_num
      rw [← mul_assoc, h73728, ← ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 73728)]
      refine ENNReal.ofReal_le_ofReal ?_
      have hC3_nn : 0 ≤ C_2d ^ 3 := pow_nonneg hC_2d 3
      have h60 : (60 * C_2d) ^ 3 = 216000 * C_2d ^ 3 := by ring
      rw [h60]
      linarith
    calc ∫⁻ z in Q0, ‖distPhaseOscOp σ lam a_dir h z‖ₑ ^ (3 : ℝ) ∂MeasureTheory.volume
        ≤ 9 * ∫⁻ y₂ in Set.Icc (-2 : ℝ) 1,
            (∫⁻ z in Q0, ‖G (z, y₂)‖ₑ ^ (3 : ℝ) ∂MeasureTheory.volume)
            ∂MeasureTheory.volume := by rw [← h_swap]; exact h_stepA
      _ ≤ 9 * ((8192 * ENNReal.ofReal (C_2d ^ 3)) *
            ∫⁻ y : EuclideanSpace ℝ (Fin 3), ‖h y‖ₑ ^ (3 : ℝ) ∂MeasureTheory.volume) := by
          rw [← h_pull]
          exact mul_le_mul_of_nonneg_left h_stepB zero_le
      _ = ((9 : ENNReal) * (8192 * ENNReal.ofReal (C_2d ^ 3))) *
            ∫⁻ y : EuclideanSpace ℝ (Fin 3), ‖h y‖ₑ ^ (3 : ℝ) ∂MeasureTheory.volume :=
          (mul_assoc _ _ _).symm
      _ ≤ ENNReal.ofReal ((60 * C_2d) ^ 3) *
            ∫⁻ y : EuclideanSpace ℝ (Fin 3), ‖h y‖ₑ ^ (3 : ℝ) ∂MeasureTheory.volume :=
          mul_le_mul_of_nonneg_right h_const_le zero_le

  
  rw [MeasureTheory.eLpNorm_eq_lintegral_rpow_enorm_toReal (by norm_num) (by norm_num)
      h_dist_cont.aestronglyMeasurable,
    MeasureTheory.eLpNorm_eq_lintegral_rpow_enorm_toReal (by norm_num) (by norm_num)
      hh_cont.aestronglyMeasurable]
  simp only [ENNReal.toReal_ofNat]
  have h_rpow := ENNReal.rpow_le_rpow h_total_lintegral (by norm_num : (0 : ℝ) ≤ 1 / 3)
  rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num : (0 : ℝ) ≤ 1 / 3)] at h_rpow
  have h_c_pow : (ENNReal.ofReal ((60 * C_2d) ^ 3)) ^ (1 / 3 : ℝ) =
      ENNReal.ofReal (60 * C_2d) := by
    have h60_nn : 0 ≤ 60 * C_2d := mul_nonneg (by norm_num) hC_2d
    rw [ENNReal.ofReal_pow h60_nn 3, ← ENNReal.rpow_natCast, ← ENNReal.rpow_mul,
      show ((3 : ℕ) : ℝ) * (1 / 3 : ℝ) = 1 by norm_num, ENNReal.rpow_one]
  rw [h_c_pow] at h_rpow
  exact h_rpow

theorem elliptic_phase_gauge_reduction (a₀ a₁ A R_x R_v : ℝ) (hRx : 0 < R_x) (hRv : 0 < R_v)
    (lam : ℝ)
    (Φ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
    (ζ : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → EuclideanSpace ℝ (Fin 2))
    (h_phase : IsEllipticGevreyPhase a₀ a₁ A Φ ζ)
    (B : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℂ)
    (hB_smooth : ∀ k : ℕ, ContDiff ℝ k B)
    (hB_supp : ∀ (c : ℝ) (x v : EuclideanSpace ℝ (Fin 2)),
      (c ∉ Set.Icc 0 1 ∨ R_x ≤ ‖x‖ ∨ R_v ≤ ‖v‖) → B (c, x, v) = 0)
    (M_B : ℕ → ℝ)
    (hB_deriv : ∀ (k : ℕ) (p : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2)),
      ‖iteratedFDeriv ℝ k B p‖ ≤ M_B k)
    (f : EuclideanSpace ℝ (Fin 2) → ℂ)
    (hf_meas : MeasureTheory.AEStronglyMeasurable f MeasureTheory.volume)
    (hf_supp : ∀ v : EuclideanSpace ℝ (Fin 2), R_v + 1 ≤ ‖v‖ → f v = 0)
    (hf_l3 : MeasureTheory.eLpNorm f 3 MeasureTheory.volume < ⊤) :
    ∃ (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
      (ζ₀ : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → EuclideanSpace ℝ (Fin 2))
      (B' : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℂ)
      (f' : EuclideanSpace ℝ (Fin 2) → ℂ),
      IsNormalizedPosDefPhase a₀ a₁ A Φ₀ ζ₀ ∧
      (∀ k : ℕ, ContDiff ℝ k B') ∧
      (∀ (c : ℝ) (x v : EuclideanSpace ℝ (Fin 2)),
        (c ∉ Set.Icc 0 1 ∨ R_x ≤ ‖x‖ ∨ R_v ≤ ‖v‖) → B' (c, x, v) = 0) ∧
      (∀ (k : ℕ) (p : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2)),
        ‖iteratedFDeriv ℝ k B' p‖ ≤ M_B k) ∧
      MeasureTheory.AEStronglyMeasurable f' MeasureTheory.volume ∧
      (∀ v : EuclideanSpace ℝ (Fin 2), R_v + 1 ≤ ‖v‖ → f' v = 0) ∧
      MeasureTheory.eLpNorm f' 3 MeasureTheory.volume =
        MeasureTheory.eLpNorm f 3 MeasureTheory.volume ∧
      MeasureTheory.eLpNorm (oscIntegralOp2D lam Φ B f) 3 MeasureTheory.volume =
        MeasureTheory.eLpNorm (oscIntegralOp2D lam Φ₀ B' f') 3 MeasureTheory.volume :=
by
  have _ := And.intro hRx hRv
  let K_v : Set (EuclideanSpace ℝ (Fin 2)) := Metric.closedBall 0 (R_v + 1)
  have : MeasureTheory.IsFiniteMeasure (MeasureTheory.volume.restrict K_v) :=
    MeasureTheory.isFiniteMeasure_restrict.mpr MeasureTheory.measure_closedBall_lt_top.ne
  have hf_memLp : MeasureTheory.MemLp f 3 MeasureTheory.volume := hf_l3
  have hf_int_on : MeasureTheory.IntegrableOn f K_v MeasureTheory.volume :=
    (hf_memLp.restrict K_v).integrable (by norm_num)
  have hf_supp_sub : Function.support f ⊆ K_v := by
    intro v hv
    rw [Function.mem_support] at hv
    rw [Metric.mem_closedBall, dist_zero_right]
    by_contra h_not
    exact hv (hf_supp v (le_of_not_ge h_not))
  have hf_int : MeasureTheory.Integrable f MeasureTheory.volume :=
    (MeasureTheory.integrableOn_iff_integrable_of_support_subset hf_supp_sub).mp hf_int_on
  let B_max : ℝ := max (M_B 0) 0
  have hbnd_int : MeasureTheory.Integrable (fun v => B_max * ‖f v‖) MeasureTheory.volume :=
    hf_int.norm.const_mul B_max
  have h_op_meas :
      ∀ (Ψ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
        (B_in : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℂ)
        (g : EuclideanSpace ℝ (Fin 2) → ℂ),
        Continuous Ψ →
        Continuous B_in →
        (∀ p, ‖B_in p‖ ≤ B_max) →
        MeasureTheory.AEStronglyMeasurable g MeasureTheory.volume →
        (∀ v, ‖g v‖ = ‖f v‖) →
        MeasureTheory.AEStronglyMeasurable (oscIntegralOp2D lam Ψ B_in g) MeasureTheory.volume := by
    intro Ψ B_in g hΨ_cont hBin_cont hBin_bound hg_meas hg_norm
    have h_cont : Continuous (oscIntegralOp2D lam Ψ B_in g) := by
      unfold oscIntegralOp2D
      refine MeasureTheory.continuous_of_dominated (bound := fun v => B_max * ‖f v‖) ?_ ?_ hbnd_int ?_
      · intro cx
        have h_tup : Continuous (fun v : EuclideanSpace ℝ (Fin 2) => (cx.1, (cx.2, v))) :=
          continuous_const.prodMk (continuous_const.prodMk continuous_id)
        have h_left : Continuous (fun v : EuclideanSpace ℝ (Fin 2) =>
            Complex.exp (Complex.I * ((lam * Ψ (cx.1, cx.2, v) : ℝ) : ℂ)) *
              B_in (cx.1, cx.2, v)) :=
          (Complex.continuous_exp.comp
            (continuous_const.mul
              (Complex.continuous_ofReal.comp
                (continuous_const.mul (hΨ_cont.comp h_tup))))).mul
            (hBin_cont.comp h_tup)
        exact h_left.aestronglyMeasurable.mul hg_meas
      · intro cx
        refine Filter.Eventually.of_forall (fun v => ?_)
        rw [norm_mul, norm_mul, Complex.norm_exp_I_mul_ofReal, one_mul, hg_norm v]
        exact mul_le_mul_of_nonneg_right (hBin_bound (cx.1, cx.2, v)) (norm_nonneg (f v))
      · refine Filter.Eventually.of_forall (fun v => ?_)
        have h_tup : Continuous (fun cx : ℝ × EuclideanSpace ℝ (Fin 2) => (cx.1, (cx.2, v))) :=
          continuous_fst.prodMk (continuous_snd.prodMk continuous_const)
        exact ((Complex.continuous_exp.comp
          (continuous_const.mul
            (Complex.continuous_ofReal.comp
              (continuous_const.mul (hΨ_cont.comp h_tup))))).mul
          (hBin_cont.comp h_tup)).mul continuous_const
    exact h_cont.aestronglyMeasurable
  rcases h_phase with ⟨hΦ_smooth, hζ_smooth, hΦ_grad, hζ_symm, hζ_ell, hζ_gevrey⟩
  have h_stage1 :
      ∃ (Φ₁ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
        (ζ₁ : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → EuclideanSpace ℝ (Fin 2))
        (B₁ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℂ)
        (f₁ : EuclideanSpace ℝ (Fin 2) → ℂ),
        (∀ k : ℕ, ContDiff ℝ k Φ₁) ∧
        (∀ k : ℕ, ContDiff ℝ k ζ₁) ∧
        (∀ (c : ℝ), c ∈ Set.Icc (0 : ℝ) 1 →
          ∀ (x v u : EuclideanSpace ℝ (Fin 2)),
            fderiv ℝ (fun v' => Φ₁ (c, x, v')) v u = inner ℝ (ζ₁ (v, x - c • v)) u) ∧
        (∀ (v p u w : EuclideanSpace ℝ (Fin 2)),
          inner ℝ (fderiv ℝ (fun p' => ζ₁ (v, p')) p u) w =
            inner ℝ u (fderiv ℝ (fun p' => ζ₁ (v, p')) p w)) ∧
        (∀ (v p u : EuclideanSpace ℝ (Fin 2)),
          a₀ * ‖u‖ ^ 2 ≤ inner ℝ (fderiv ℝ (fun p' => ζ₁ (v, p')) p u) u ∧
          inner ℝ (fderiv ℝ (fun p' => ζ₁ (v, p')) p u) u ≤ a₁ * ‖u‖ ^ 2) ∧
        (∀ (j : ℕ) (vp : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2)),
          ‖iteratedFDeriv ℝ j
            (fun q : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) =>
              fderiv ℝ (fun p' => ζ₁ (q.1, p')) q.2) vp‖ ≤
            A ^ (j + 1) * ((j.factorial : ℝ) ^ 3)) ∧
        (∀ k : ℕ, ContDiff ℝ k B₁) ∧
        (∀ (c : ℝ) (x v : EuclideanSpace ℝ (Fin 2)),
          (c ∉ Set.Icc 0 1 ∨ R_x ≤ ‖x‖ ∨ R_v ≤ ‖v‖) → B₁ (c, x, v) = 0) ∧
        (∀ (k : ℕ) (p : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2)),
          ‖iteratedFDeriv ℝ k B₁ p‖ ≤ M_B k) ∧
        MeasureTheory.AEStronglyMeasurable f₁ MeasureTheory.volume ∧
        (∀ v : EuclideanSpace ℝ (Fin 2), R_v + 1 ≤ ‖v‖ → f₁ v = 0) ∧
        (∀ v : EuclideanSpace ℝ (Fin 2), ‖f₁ v‖ = ‖f v‖) ∧
        (∀ cx : ℝ × EuclideanSpace ℝ (Fin 2),
          ‖oscIntegralOp2D lam Φ₁ B₁ f₁ cx‖ = ‖oscIntegralOp2D lam Φ B f cx‖) := by
    rcases hζ_ell with h_pos | h_neg
    · exact ⟨Φ, ζ, B, f, hΦ_smooth, hζ_smooth, hΦ_grad, hζ_symm, h_pos, hζ_gevrey,
        hB_smooth, hB_supp, hB_deriv, hf_meas, hf_supp, fun _ => rfl, fun _ => rfl⟩
    · refine ⟨fun p => -Φ p, fun vp => -ζ vp, ⇑Complex.conjLIE ∘ B, ⇑Complex.conjLIE ∘ f,
        fun k => (hΦ_smooth k).neg, fun k => (hζ_smooth k).neg, ?_, ?_, ?_, ?_,
        fun k => Complex.conjLIE.contDiff.comp (hB_smooth k), ?_, ?_,
        Complex.conjLIE.continuous.comp_aestronglyMeasurable hf_meas, ?_,
        fun v => Complex.conjLIE.norm_map (f v), ?_⟩
      · intro c hc x v u
        have h_fn : (fun v' : EuclideanSpace ℝ (Fin 2) => -Φ (c, x, v')) =
            -(fun v' => Φ (c, x, v')) := rfl
        rw [h_fn, fderiv_neg]
        change -(fderiv ℝ (fun v' => Φ (c, x, v')) v u) = inner ℝ (-ζ (v, x - c • v)) u
        rw [hΦ_grad c hc x v u, inner_neg_left]
      · intro v p u w
        have h_fn : (fun p' : EuclideanSpace ℝ (Fin 2) => -ζ (v, p')) =
            -(fun p' => ζ (v, p')) := rfl
        rw [h_fn, fderiv_neg]
        change inner ℝ (-(fderiv ℝ (fun p' => ζ (v, p')) p u)) w =
          inner ℝ u (-(fderiv ℝ (fun p' => ζ (v, p')) p w))
        rw [inner_neg_left, inner_neg_right, hζ_symm v p u w]
      · intro v p u
        have h_fn : (fun p' : EuclideanSpace ℝ (Fin 2) => -ζ (v, p')) =
            -(fun p' => ζ (v, p')) := rfl
        rw [h_fn, fderiv_neg]
        change a₀ * ‖u‖ ^ 2 ≤ inner ℝ (-(fderiv ℝ (fun p' => ζ (v, p')) p u)) u ∧
          inner ℝ (-(fderiv ℝ (fun p' => ζ (v, p')) p u)) u ≤ a₁ * ‖u‖ ^ 2
        rw [inner_neg_left]
        exact h_neg v p u
      · intro j vp
        have h_map :
            (fun q : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) =>
              fderiv ℝ (fun p' => -ζ (q.1, p')) q.2) =
            -(fun q : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) =>
              fderiv ℝ (fun p' => ζ (q.1, p')) q.2) := by
          ext q u
          have h_fn : (fun p' : EuclideanSpace ℝ (Fin 2) => -ζ (q.1, p')) =
              -(fun p' => ζ (q.1, p')) := rfl
          rw [h_fn, fderiv_neg]
          rfl
        rw [h_map, iteratedFDeriv_neg_apply, norm_neg]
        exact hζ_gevrey j vp
      · intro c x v h_out
        simp only [Function.comp_apply, hB_supp c x v h_out, map_zero]
      · intro k p
        rw [Complex.conjLIE.norm_iteratedFDeriv_comp_left B p k]
        exact hB_deriv k p
      · intro v hv
        simp only [Function.comp_apply, hf_supp v hv, map_zero]
      · intro cx
        unfold oscIntegralOp2D
        have h_integrand :
            (fun v : EuclideanSpace ℝ (Fin 2) =>
              Complex.exp (Complex.I * ((lam * -Φ (cx.1, cx.2, v) : ℝ) : ℂ)) *
                (⇑Complex.conjLIE ∘ B) (cx.1, cx.2, v) * (⇑Complex.conjLIE ∘ f) v) =
            (fun v : EuclideanSpace ℝ (Fin 2) =>
              (starRingEnd ℂ)
                (Complex.exp (Complex.I * ((lam * Φ (cx.1, cx.2, v) : ℝ) : ℂ)) *
                  B (cx.1, cx.2, v) * f v)) := by
          ext v
          simp only [Function.comp_apply, Complex.conjLIE_apply, map_mul, ← Complex.exp_conj,
            Complex.conj_I, Complex.conj_ofReal]
          congr 3
          push_cast
          ring
        rw [h_integrand, integral_conj, Complex.norm_conj]
  obtain ⟨Φ₁, ζ₁, B₁, f₁, hΦ₁_smooth, hζ₁_smooth, hΦ₁_grad, hζ₁_symm, hζ₁_pos, hζ₁_gevrey,
    hB₁_smooth, hB₁_supp, hB₁_deriv, hf₁_meas, hf₁_supp, hf₁_norm, h_op₁_norm⟩ := h_stage1
  let Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ :=
    fun p => Φ₁ p - Φ₁ (p.1, p.2.1, 0) - Φ₁ (0, 0, p.2.2) + Φ₁ (0, 0, 0)
  let ζ₀ : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → EuclideanSpace ℝ (Fin 2) :=
    fun vp => ζ₁ vp - ζ₁ (vp.1, 0)
  let B' : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℂ := B₁
  let f' : EuclideanSpace ℝ (Fin 2) → ℂ :=
    fun v => Complex.exp (Complex.I * ((lam * (Φ₁ (0, 0, v) - Φ₁ (0, 0, 0)) : ℝ) : ℂ)) * f₁ v
  have hΦ₀_smooth : ∀ k : ℕ, ContDiff ℝ k Φ₀ := by
    intro k
    have h_p1 : ContDiff ℝ k
        (fun p : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) =>
          (p.1, (p.2.1, (0 : EuclideanSpace ℝ (Fin 2))))) :=
      contDiff_fst.prodMk ((contDiff_fst.comp contDiff_snd).prodMk contDiff_const)
    have h_p2 : ContDiff ℝ k
        (fun p : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) =>
          ((0 : ℝ), ((0 : EuclideanSpace ℝ (Fin 2)), p.2.2))) :=
      contDiff_const.prodMk (contDiff_const.prodMk (contDiff_snd.comp contDiff_snd))
    exact (((hΦ₁_smooth k).sub ((hΦ₁_smooth k).comp h_p1)).sub
      ((hΦ₁_smooth k).comp h_p2)).add contDiff_const
  have hζ₀_smooth : ∀ k : ℕ, ContDiff ℝ k ζ₀ := by
    intro k
    exact (hζ₁_smooth k).sub
      ((hζ₁_smooth k).comp (contDiff_fst.prodMk contDiff_const))
  have hζ₀_fderiv : ∀ (v p : EuclideanSpace ℝ (Fin 2)),
      fderiv ℝ (fun p' => ζ₀ (v, p')) p = fderiv ℝ (fun p' => ζ₁ (v, p')) p := by
    intro v p
    exact fderiv_sub_const (ζ₁ (v, 0))
  have hΦ₀_grad : ∀ (c : ℝ), c ∈ Set.Icc (0 : ℝ) 1 →
      ∀ (x v u : EuclideanSpace ℝ (Fin 2)),
        fderiv ℝ (fun v' => Φ₀ (c, x, v')) v u = inner ℝ (ζ₀ (v, x - c • v)) u := by
    intro c hc x v u
    have h_diff_slice : ∀ (c' : ℝ) (x' : EuclideanSpace ℝ (Fin 2)),
        DifferentiableAt ℝ (fun v' : EuclideanSpace ℝ (Fin 2) => Φ₁ (c', x', v')) v := by
      intro c' x'
      have hc1 : ContDiff ℝ (1 : ℕ) (fun v' : EuclideanSpace ℝ (Fin 2) => Φ₁ (c', x', v')) :=
        (hΦ₁_smooth 1).comp (contDiff_const.prodMk (contDiff_const.prodMk contDiff_id))
      exact (hc1.differentiable (one_ne_zero : ((1 : ℕ) : WithTop ℕ∞) ≠ 0)).differentiableAt
    have h_fn : (fun v' : EuclideanSpace ℝ (Fin 2) => Φ₀ (c, x, v')) =
        (fun v' => (((fun w => Φ₁ (c, x, w)) - (fun w => Φ₁ (0, 0, w))) v') +
          (Φ₁ (0, 0, 0) - Φ₁ (c, x, 0))) := by
      ext v'
      dsimp [Φ₀]
      ring
    have h0_mem : (0 : ℝ) ∈ Set.Icc (0 : ℝ) 1 := ⟨le_rfl, zero_le_one⟩
    rw [h_fn, fderiv_add_const, fderiv_sub (h_diff_slice c x) (h_diff_slice 0 0)]
    change fderiv ℝ (fun v' => Φ₁ (c, x, v')) v u -
        fderiv ℝ (fun v' => Φ₁ (0, 0, v')) v u =
      inner ℝ (ζ₁ (v, x - c • v) - ζ₁ (v, 0)) u
    rw [hΦ₁_grad c hc x v u, hΦ₁_grad 0 h0_mem 0 v u, zero_smul, sub_zero, inner_sub_left]
  have hf'_meas : MeasureTheory.AEStronglyMeasurable f' MeasureTheory.volume := by
    have h_mod_cont : Continuous (fun v : EuclideanSpace ℝ (Fin 2) =>
        Complex.exp (Complex.I * ((lam * (Φ₁ (0, 0, v) - Φ₁ (0, 0, 0)) : ℝ) : ℂ))) := by
      have h_tup : Continuous (fun v : EuclideanSpace ℝ (Fin 2) =>
          ((0 : ℝ), ((0 : EuclideanSpace ℝ (Fin 2)), v))) :=
        continuous_const.prodMk (continuous_const.prodMk continuous_id)
      exact Complex.continuous_exp.comp
        (continuous_const.mul
          (Complex.continuous_ofReal.comp
            (continuous_const.mul (((hΦ₁_smooth 0).continuous.comp h_tup).sub continuous_const))))
    exact h_mod_cont.aestronglyMeasurable.mul hf₁_meas
  have hf'_supp : ∀ v : EuclideanSpace ℝ (Fin 2), R_v + 1 ≤ ‖v‖ → f' v = 0 := by
    intro v hv
    simp only [f', hf₁_supp v hv, mul_zero]
  have hf'_norm : ∀ v : EuclideanSpace ℝ (Fin 2), ‖f' v‖ = ‖f v‖ := by
    intro v
    dsimp [f']
    rw [norm_mul, Complex.norm_exp_I_mul_ofReal, one_mul, hf₁_norm v]
  have hf'_l3_eq : MeasureTheory.eLpNorm f' 3 MeasureTheory.volume =
      MeasureTheory.eLpNorm f 3 MeasureTheory.volume :=
    MeasureTheory.eLpNorm_congr_norm_ae hf'_meas hf_meas (Filter.Eventually.of_forall hf'_norm)
  have h_op_norm : ∀ cx : ℝ × EuclideanSpace ℝ (Fin 2),
      ‖oscIntegralOp2D lam Φ B f cx‖ = ‖oscIntegralOp2D lam Φ₀ B' f' cx‖ := by
    intro cx
    rw [← h_op₁_norm cx]
    have h_pull : oscIntegralOp2D lam Φ₁ B₁ f₁ cx =
        Complex.exp (Complex.I * ((lam * Φ₁ (cx.1, cx.2, 0) : ℝ) : ℂ)) *
          oscIntegralOp2D lam Φ₀ B' f' cx := by
      unfold oscIntegralOp2D
      rw [← MeasureTheory.integral_const_mul]
      congr 1
      ext v
      have h_phase_split :
          Complex.I * ((lam * Φ₁ (cx.1, cx.2, v) : ℝ) : ℂ) =
            Complex.I * ((lam * Φ₁ (cx.1, cx.2, 0) : ℝ) : ℂ) +
              (Complex.I * ((lam * Φ₀ (cx.1, cx.2, v) : ℝ) : ℂ) +
                Complex.I * ((lam * (Φ₁ (0, 0, v) - Φ₁ (0, 0, 0)) : ℝ) : ℂ)) := by
        dsimp [Φ₀]
        push_cast
        ring
      dsimp [B', f']
      rw [h_phase_split, Complex.exp_add, Complex.exp_add]
      ring
    rw [h_pull, norm_mul, Complex.norm_exp_I_mul_ofReal, one_mul]
  have hB_bound : ∀ p, ‖B p‖ ≤ B_max := by
    intro p
    calc ‖B p‖ = ‖iteratedFDeriv ℝ 0 B p‖ := norm_iteratedFDeriv_zero.symm
      _ ≤ M_B 0 := hB_deriv 0 p
      _ ≤ B_max := le_max_left _ _
  have hB'_bound : ∀ p, ‖B' p‖ ≤ B_max := by
    intro p
    calc ‖B' p‖ = ‖iteratedFDeriv ℝ 0 B₁ p‖ := norm_iteratedFDeriv_zero.symm
      _ ≤ M_B 0 := hB₁_deriv 0 p
      _ ≤ B_max := le_max_left _ _
  have h_op_orig_meas :
      MeasureTheory.AEStronglyMeasurable (oscIntegralOp2D lam Φ B f) MeasureTheory.volume :=
    h_op_meas Φ B f (hΦ_smooth 0).continuous (hB_smooth 0).continuous hB_bound hf_meas
      (fun _ => rfl)
  have h_op_new_meas :
      MeasureTheory.AEStronglyMeasurable (oscIntegralOp2D lam Φ₀ B' f') MeasureTheory.volume :=
    h_op_meas Φ₀ B' f' (hΦ₀_smooth 0).continuous (hB₁_smooth 0).continuous hB'_bound hf'_meas
      hf'_norm
  have h_op_eq :
      MeasureTheory.eLpNorm (oscIntegralOp2D lam Φ B f) 3 MeasureTheory.volume =
        MeasureTheory.eLpNorm (oscIntegralOp2D lam Φ₀ B' f') 3 MeasureTheory.volume :=
    MeasureTheory.eLpNorm_congr_norm_ae h_op_orig_meas h_op_new_meas
      (Filter.Eventually.of_forall h_op_norm)
  refine ⟨Φ₀, ζ₀, B', f', ?_, hB₁_smooth, hB₁_supp, hB₁_deriv,
    hf'_meas, hf'_supp, hf'_l3_eq, h_op_eq⟩
  refine ⟨hΦ₀_smooth, hζ₀_smooth, ?_, ?_, ?_, hΦ₀_grad, ?_, ?_, ?_⟩
  · intro c x; dsimp [Φ₀]; ring
  · intro v; dsimp [Φ₀]; ring
  · intro v; dsimp [ζ₀]; exact sub_self _
  · intro v p u w
    rw [hζ₀_fderiv v p]
    exact hζ₁_symm v p u w
  · intro v p u
    rw [hζ₀_fderiv v p]
    exact hζ₁_pos v p u
  · intro j vp
    have h_eq : (fun q : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) =>
        fderiv ℝ (fun p' => ζ₀ (q.1, p')) q.2) =
      (fun q : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) =>
        fderiv ℝ (fun p' => ζ₁ (q.1, p')) q.2) := by
      ext q u
      rw [hζ₀_fderiv q.1 q.2]
    rw [h_eq]
    exact hζ₁_gevrey j vp

theorem sublevel_to_l3_dyadic_interpolation (R_x R_v B_max ν Λ₀ C_sub : ℝ)
    (hRx : 0 < R_x) (hRv : 0 < R_v) (hB_max : 0 ≤ B_max)
    (hν : 0 < ν) (hΛ₀ : 2 ≤ Λ₀) (hC_sub : 0 ≤ C_sub) :
    ∃ C_osc : ℝ, 0 ≤ C_osc ∧
      ∀ (lam : ℝ), 2 ≤ lam →
      ∀ (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
        (B : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℂ),
        Continuous Φ₀ →
        Continuous B →
        (∀ (c : ℝ) (x v : EuclideanSpace ℝ (Fin 2)),
          (c ∉ Set.Icc 0 1 ∨ R_x ≤ ‖x‖ ∨ R_v ≤ ‖v‖) → B (c, x, v) = 0) →
        (∀ p : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2), ‖B p‖ ≤ B_max) →
        (Λ₀ ≤ lam →
          ∀ (F : Set (EuclideanSpace ℝ (Fin 2))),
            MeasurableSet F →
            F ⊆ Metric.closedBall 0 (R_v + 1) →
            ∀ (g : EuclideanSpace ℝ (Fin 2) → ℂ),
              MeasureTheory.AEStronglyMeasurable g MeasureTheory.volume →
              (∀ v : EuclideanSpace ℝ (Fin 2), ‖g v‖ ≤ Set.indicator F 1 v) →
              MeasureTheory.eLpNorm (oscIntegralOp2D lam Φ₀ B g) 3 MeasureTheory.volume ≤
                ENNReal.ofReal (C_sub * lam ^ (-1 + ν / 2)) *
                  (MeasureTheory.volume F) ^ ((1 : ℝ) / 3)) →
      ∀ (f : EuclideanSpace ℝ (Fin 2) → ℂ),
        MeasureTheory.AEStronglyMeasurable f MeasureTheory.volume →
        (∀ v : EuclideanSpace ℝ (Fin 2), R_v + 1 ≤ ‖v‖ → f v = 0) →
        MeasureTheory.eLpNorm f 3 MeasureTheory.volume < ⊤ →
        MeasureTheory.eLpNorm (oscIntegralOp2D lam Φ₀ B f) 3 MeasureTheory.volume ≤
          ENNReal.ofReal (C_osc * lam ^ (-1 + ν)) *
            MeasureTheory.eLpNorm f 3 MeasureTheory.volume :=
by
  
  let S_out : Set (ℝ × EuclideanSpace ℝ (Fin 2)) :=
    Set.Icc (0 : ℝ) 1 ×ˢ Metric.closedBall (0 : EuclideanSpace ℝ (Fin 2)) R_x
  have hS_out_lt_top : MeasureTheory.volume S_out < ⊤ := by
    rw [MeasureTheory.Measure.volume_eq_prod ℝ (EuclideanSpace ℝ (Fin 2)),
      MeasureTheory.Measure.prod_prod, Real.volume_Icc]
    exact ENNReal.mul_lt_top ENNReal.ofReal_lt_top MeasureTheory.measure_closedBall_lt_top
  have hS_out_ne_top : MeasureTheory.volume S_out ≠ ⊤ := hS_out_lt_top.ne
  let K_in : Set (EuclideanSpace ℝ (Fin 2)) :=
    Metric.closedBall (0 : EuclideanSpace ℝ (Fin 2)) (R_v + 1)
  have hK_in_meas : MeasurableSet K_in := measurableSet_closedBall
  have hK_in_lt_top : MeasureTheory.volume K_in < ⊤ := MeasureTheory.measure_closedBall_lt_top
  have hK_in_ne_top : MeasureTheory.volume K_in ≠ ⊤ := hK_in_lt_top.ne
  let V_out : ℝ := (MeasureTheory.volume S_out).toReal
  let V_in : ℝ := (MeasureTheory.volume K_in).toReal
  have hV_out_nn : 0 ≤ V_out := ENNReal.toReal_nonneg
  have hV_in_nn : 0 ≤ V_in := ENNReal.toReal_nonneg
  let C_L1 : ℝ := B_max * V_out ^ ((1 : ℝ) / 3)
  have hC_L1_nn : 0 ≤ C_L1 := mul_nonneg hB_max (Real.rpow_nonneg hV_out_nn _)
  let C_triv : ℝ := C_L1 * V_in ^ ((2 : ℝ) / 3)
  have hC_triv_nn : 0 ≤ C_triv := mul_nonneg hC_L1_nn (Real.rpow_nonneg hV_in_nn _)
  let M_ν : ℝ := max 1 (max (Λ₀ ^ (1 - ν)) ((8 / (ν * Real.log 2)) ^ ((2 : ℝ) / 3)))
  have hM_ν_ge_one : 1 ≤ M_ν := le_max_left _ _
  have hM_ν_nn : 0 ≤ M_ν := by linarith
  let C_osc : ℝ := max (C_triv * M_ν) (C_L1 * (V_in + 1) + 2 * C_sub * M_ν)
  have hC_osc_nn : 0 ≤ C_osc :=
    le_trans (mul_nonneg hC_triv_nn hM_ν_nn) (le_max_left _ _)
  refine ⟨C_osc, hC_osc_nn, ?_⟩
  intro lam hlam Φ₀ B hΦ₀ hB hB_supp hB_bound h_sub f hf_meas hf_supp hf_l3
  have hlam_pos : 0 < lam := by linarith
  have hlam_nn : 0 ≤ lam := hlam_pos.le
  have hlam_ge_one : 1 ≤ lam := by linarith

  
  have h_L1_op : ∀ (h : EuclideanSpace ℝ (Fin 2) → ℂ),
      MeasureTheory.Integrable h MeasureTheory.volume →
      Continuous (oscIntegralOp2D lam Φ₀ B h) ∧
      (∀ cx : ℝ × EuclideanSpace ℝ (Fin 2),
        MeasureTheory.Integrable
          (fun v => Complex.exp (Complex.I * ((lam * Φ₀ (cx.1, cx.2, v) : ℝ) : ℂ)) *
            B (cx.1, cx.2, v) * h v)
          MeasureTheory.volume) ∧
      MeasureTheory.eLpNorm (oscIntegralOp2D lam Φ₀ B h) 3 MeasureTheory.volume ≤
        ENNReal.ofReal (C_L1 * ∫ v : EuclideanSpace ℝ (Fin 2), ‖h v‖) := by
    intro h hh_int
    let F_ker : (ℝ × EuclideanSpace ℝ (Fin 2)) → EuclideanSpace ℝ (Fin 2) → ℂ :=
      fun cx v => Complex.exp (Complex.I * ((lam * Φ₀ (cx.1, cx.2, v) : ℝ) : ℂ)) *
        B (cx.1, cx.2, v) * h v
    have hF_norm : ∀ cx v, ‖F_ker cx v‖ ≤ B_max * ‖h v‖ := by
      intro cx v
      dsimp only [F_ker]
      rw [norm_mul, norm_mul, Complex.norm_exp_I_mul_ofReal, one_mul]
      exact mul_le_mul_of_nonneg_right (hB_bound (cx.1, cx.2, v)) (norm_nonneg _)
    have hF_fib_int : ∀ cx, MeasureTheory.Integrable (F_ker cx) MeasureTheory.volume := by
      intro cx
      have h_tup : Continuous (fun v : EuclideanSpace ℝ (Fin 2) => (cx.1, cx.2, v)) :=
        continuous_const.prodMk (continuous_const.prodMk continuous_id)
      have hc_v : Continuous (fun v : EuclideanSpace ℝ (Fin 2) =>
          Complex.exp (Complex.I * ((lam * Φ₀ (cx.1, cx.2, v) : ℝ) : ℂ)) *
            B (cx.1, cx.2, v)) :=
        (Complex.continuous_exp.comp (continuous_const.mul
          (Complex.continuous_ofReal.comp (continuous_const.mul (hΦ₀.comp h_tup))))).mul
          (hB.comp h_tup)
      exact (hh_int.norm.const_mul B_max).mono'
        (hc_v.aestronglyMeasurable.mul hh_int.aestronglyMeasurable)
        (Filter.Eventually.of_forall (hF_norm cx))
    have h_op_cont : Continuous (oscIntegralOp2D lam Φ₀ B h) := by
      unfold oscIntegralOp2D
      refine MeasureTheory.continuous_of_dominated
        (fun cx => (hF_fib_int cx).aestronglyMeasurable)
        (fun cx => Filter.Eventually.of_forall (hF_norm cx))
        (hh_int.norm.const_mul B_max)
        (Filter.Eventually.of_forall (fun v => ?_))
      have h_tup_cx : Continuous (fun cx : ℝ × EuclideanSpace ℝ (Fin 2) => (cx.1, cx.2, v)) :=
        continuous_fst.prodMk (continuous_snd.prodMk continuous_const)
      exact ((Complex.continuous_exp.comp (continuous_const.mul
        (Complex.continuous_ofReal.comp (continuous_const.mul (hΦ₀.comp h_tup_cx))))).mul
        (hB.comp h_tup_cx)).mul continuous_const
    have h_op_supp : Function.support (oscIntegralOp2D lam Φ₀ B h) ⊆ S_out := by
      intro cx hcx
      rw [Function.mem_support] at hcx
      by_contra h_not
      apply hcx
      unfold oscIntegralOp2D
      have hB_zero : ∀ v : EuclideanSpace ℝ (Fin 2), B (cx.1, cx.2, v) = 0 := by
        intro v
        apply hB_supp cx.1 cx.2 v
        by_cases hc1 : cx.1 ∈ Set.Icc (0 : ℝ) 1
        · right; left
          have hc2 : cx.2 ∉ Metric.closedBall (0 : EuclideanSpace ℝ (Fin 2)) R_x :=
            fun h2 => h_not ⟨hc1, h2⟩
          rw [Metric.mem_closedBall, dist_zero_right, not_le] at hc2
          exact hc2.le
        · exact Or.inl hc1
      simp [hB_zero]
    have h_int_h_nn : 0 ≤ ∫ v : EuclideanSpace ℝ (Fin 2), ‖h v‖ :=
      MeasureTheory.integral_nonneg (fun v => norm_nonneg _)
    have h_ptwise : ∀ cx, ‖oscIntegralOp2D lam Φ₀ B h cx‖ ≤
        B_max * ∫ v : EuclideanSpace ℝ (Fin 2), ‖h v‖ := by
      intro cx
      calc ‖oscIntegralOp2D lam Φ₀ B h cx‖
          = ‖∫ v, F_ker cx v‖ := rfl
        _ ≤ ∫ v, ‖F_ker cx v‖ := MeasureTheory.norm_integral_le_integral_norm _
        _ ≤ ∫ v, B_max * ‖h v‖ :=
            MeasureTheory.integral_mono (hF_fib_int cx).norm (hh_int.norm.const_mul B_max)
              (hF_norm cx)
        _ = B_max * ∫ v, ‖h v‖ := MeasureTheory.integral_const_mul B_max _
    have h_el3 : MeasureTheory.eLpNorm (oscIntegralOp2D lam Φ₀ B h) 3 MeasureTheory.volume ≤
        ENNReal.ofReal (C_L1 * ∫ v : EuclideanSpace ℝ (Fin 2), ‖h v‖) := by
      rw [← MeasureTheory.eLpNorm_restrict_eq_of_support_subset
        h_op_cont.aestronglyMeasurable h_op_supp]
      have h_ae := MeasureTheory.eLpNorm_le_of_ae_bound (p := 3)
        (μ := MeasureTheory.volume.restrict S_out)
        (h_op_cont.aestronglyMeasurable (μ := MeasureTheory.volume)).restrict
        (Filter.Eventually.of_forall h_ptwise)
      refine h_ae.trans ?_
      rw [MeasureTheory.Measure.restrict_apply_univ]
      have hp3 : (3 : ENNReal).toReal⁻¹ = (1 : ℝ) / 3 := by norm_num
      rw [hp3, ← ENNReal.ofReal_toReal hS_out_ne_top,
        ENNReal.ofReal_rpow_of_nonneg hV_out_nn (by norm_num),
        ← ENNReal.ofReal_mul (Real.rpow_nonneg hV_out_nn _)]
      exact ENNReal.ofReal_le_ofReal (le_of_eq (by dsimp only [C_L1, V_out]; ring))
    exact ⟨h_op_cont, hF_fib_int, h_el3⟩

  have hf_supp_in : Function.support f ⊆ K_in := by
    intro v hv
    rw [Function.mem_support] at hv
    rw [Metric.mem_closedBall, dist_zero_right]
    by_contra h_not
    rw [not_le] at h_not
    exact hv (hf_supp v h_not.le)
  have hf_l1_le : MeasureTheory.eLpNorm f 1 MeasureTheory.volume ≤
      ENNReal.ofReal (V_in ^ ((2 : ℝ) / 3)) * MeasureTheory.eLpNorm f 3 MeasureTheory.volume := by
    have h_cmp := MeasureTheory.eLpNorm_le_eLpNorm_mul_rpow_measure_univ
      (μ := MeasureTheory.volume.restrict K_in) (p := 1) (q := 3) (by norm_num) hf_meas.restrict
    rw [MeasureTheory.eLpNorm_restrict_eq_of_support_subset (p := 1) hf_meas hf_supp_in,
      MeasureTheory.eLpNorm_restrict_eq_of_support_subset (p := 3) hf_meas hf_supp_in,
      MeasureTheory.Measure.restrict_apply_univ] at h_cmp
    have hexp : 1 / (1 : ENNReal).toReal - 1 / (3 : ENNReal).toReal = (2 : ℝ) / 3 := by norm_num
    rw [hexp, ← ENNReal.ofReal_toReal hK_in_ne_top,
      ENNReal.ofReal_rpow_of_nonneg hV_in_nn (by norm_num), mul_comm] at h_cmp
    exact h_cmp
  have hf_int : MeasureTheory.Integrable f MeasureTheory.volume := by
    have hf_l1_lt : MeasureTheory.MemLp f 1 MeasureTheory.volume :=
      lt_of_le_of_lt hf_l1_le (ENNReal.mul_lt_top ENNReal.ofReal_lt_top hf_l3)
    exact MeasureTheory.memLp_one_iff_integrable.mp hf_l1_lt
  have h_triv_f : MeasureTheory.eLpNorm (oscIntegralOp2D lam Φ₀ B f) 3 MeasureTheory.volume ≤
      ENNReal.ofReal C_triv * MeasureTheory.eLpNorm f 3 MeasureTheory.volume := by
    have h_int_eq : ENNReal.ofReal (∫ v : EuclideanSpace ℝ (Fin 2), ‖f v‖) =
        MeasureTheory.eLpNorm f 1 MeasureTheory.volume := by
      rw [MeasureTheory.ofReal_integral_norm_eq_lintegral_enorm hf_int,
        MeasureTheory.eLpNorm_one_eq_lintegral_enorm hf_meas]
    calc MeasureTheory.eLpNorm (oscIntegralOp2D lam Φ₀ B f) 3 MeasureTheory.volume
        ≤ ENNReal.ofReal (C_L1 * ∫ v : EuclideanSpace ℝ (Fin 2), ‖f v‖) := (h_L1_op f hf_int).2.2
      _ = ENNReal.ofReal C_L1 * ENNReal.ofReal (∫ v : EuclideanSpace ℝ (Fin 2), ‖f v‖) :=
          ENNReal.ofReal_mul hC_L1_nn
      _ = ENNReal.ofReal C_L1 * MeasureTheory.eLpNorm f 1 MeasureTheory.volume := by rw [h_int_eq]
      _ ≤ ENNReal.ofReal C_L1 *
            (ENNReal.ofReal (V_in ^ ((2 : ℝ) / 3)) * MeasureTheory.eLpNorm f 3 MeasureTheory.volume) :=
          mul_le_mul_of_nonneg_left hf_l1_le zero_le
      _ = ENNReal.ofReal C_triv * MeasureTheory.eLpNorm f 3 MeasureTheory.volume := by
          rw [← mul_assoc, ← ENNReal.ofReal_mul hC_L1_nn]

  
  by_cases hlam_Λ : Λ₀ ≤ lam
  swap
  · have hlam_le_Λ : lam ≤ Λ₀ := le_of_not_ge hlam_Λ
    have h_lam_1mν : lam ^ (1 - ν) ≤ M_ν := by
      by_cases h1ν : 0 ≤ 1 - ν
      · exact (Real.rpow_le_rpow hlam_nn hlam_le_Λ h1ν).trans
          ((le_max_left _ _).trans (le_max_right _ _))
      · calc lam ^ (1 - ν) ≤ lam ^ (0 : ℝ) :=
              Real.rpow_le_rpow_of_exponent_le hlam_ge_one (le_of_not_ge h1ν)
          _ = 1 := Real.rpow_zero lam
          _ ≤ M_ν := hM_ν_ge_one
    have h_one_le : 1 ≤ M_ν * lam ^ (-1 + ν) := by
      have hexp0 : (1 - ν) + (-1 + ν) = 0 := by ring
      calc (1 : ℝ) = lam ^ (0 : ℝ) := (Real.rpow_zero lam).symm
        _ = lam ^ ((1 - ν) + (-1 + ν)) := by rw [hexp0]
        _ = lam ^ (1 - ν) * lam ^ (-1 + ν) := Real.rpow_add hlam_pos _ _
        _ ≤ M_ν * lam ^ (-1 + ν) :=
            mul_le_mul_of_nonneg_right h_lam_1mν (Real.rpow_nonneg hlam_nn _)
    have h_ctriv_le : C_triv ≤ C_osc * lam ^ (-1 + ν) := by
      calc C_triv = C_triv * 1 := (mul_one C_triv).symm
        _ ≤ C_triv * (M_ν * lam ^ (-1 + ν)) := mul_le_mul_of_nonneg_left h_one_le hC_triv_nn
        _ = (C_triv * M_ν) * lam ^ (-1 + ν) := by ring
        _ ≤ C_osc * lam ^ (-1 + ν) :=
            mul_le_mul_of_nonneg_right (le_max_left _ _) (Real.rpow_nonneg hlam_nn _)
    exact h_triv_f.trans
      (mul_le_mul_of_nonneg_right (ENNReal.ofReal_le_ofReal h_ctriv_le) zero_le)

  by_cases hf_zero : MeasureTheory.eLpNorm f 3 MeasureTheory.volume = 0
  · refine h_triv_f.trans ?_
    rw [hf_zero, mul_zero, mul_zero]

  
  let N : ℝ := (MeasureTheory.eLpNorm f 3 MeasureTheory.volume).toReal
  have hN_pos : 0 < N := ENNReal.toReal_pos hf_zero hf_l3.ne
  have hN_ofReal : ENNReal.ofReal N = MeasureTheory.eLpNorm f 3 MeasureTheory.volume :=
    ENNReal.ofReal_toReal hf_l3.ne

  
  let K : ℕ := Nat.clog 2 ⌈lam⌉₊
  have h_ceil_ge : 2 ≤ ⌈lam⌉₊ := by
    exact_mod_cast (hlam.trans (Nat.le_ceil lam))
  have hK_ge_one : 1 ≤ K := by
    by_contra hK0
    have hK_le : K ≤ 0 := by omega
    have h_le_one := (Nat.clog_le_iff_le_pow (by norm_num : 1 < 2)).mp hK_le
    omega
  have hlam_le_pow : lam ≤ (2 : ℝ) ^ K := by
    have h_nat : ⌈lam⌉₊ ≤ 2 ^ K := Nat.le_pow_clog (by norm_num : 1 < 2) ⌈lam⌉₊
    exact (Nat.le_ceil lam).trans (by exact_mod_cast h_nat)
  have h_2negK : (2 : ℝ) ^ (-(K : ℤ)) ≤ lam ^ (-1 + ν) := by
    rw [zpow_neg, zpow_natCast]
    have h_inv : ((2 : ℝ) ^ K)⁻¹ ≤ lam⁻¹ := inv_anti₀ hlam_pos hlam_le_pow
    rw [← Real.rpow_neg_one lam] at h_inv
    exact h_inv.trans (Real.rpow_le_rpow_of_exponent_le hlam_ge_one (by linarith))
  have h_2neg2K : (2 : ℝ) ^ (-2 * (K : ℤ)) ≤ lam ^ (-1 + ν) :=
    (zpow_le_zpow_right₀ (by norm_num : (1 : ℝ) ≤ 2) (by omega : -2 * (K : ℤ) ≤ -(K : ℤ))).trans
      h_2negK
  have h_pow_le_cube : (2 : ℝ) ^ K ≤ lam ^ 3 := by
    have h_lt_nat : 2 ^ (K - 1) < ⌈lam⌉₊ := Nat.pow_lt_of_lt_clog (by omega : K - 1 < K)
    have h_lt_real : (2 : ℝ) ^ (K - 1) < (⌈lam⌉₊ : ℝ) := by exact_mod_cast h_lt_nat
    have h_ceil_lt : (⌈lam⌉₊ : ℝ) < lam + 1 := Nat.ceil_lt_add_one hlam_nn
    have h_pow_split : (2 : ℝ) ^ K = 2 * (2 : ℝ) ^ (K - 1) := by
      have hK_eq : K = (K - 1) + 1 := by omega
      conv_lhs => rw [hK_eq, pow_succ']
    have h_lt_4lam : (2 : ℝ) ^ K < 4 * lam := by linarith
    have h_4_le_sq : (4 : ℝ) ≤ lam ^ 2 := by nlinarith
    have h_4lam_le : 4 * lam ≤ lam ^ 3 := by
      calc 4 * lam ≤ lam ^ 2 * lam := mul_le_mul_of_nonneg_right h_4_le_sq hlam_nn
        _ = lam ^ 3 := by ring
    linarith
  have h_log_shell :
      (2 * (K : ℝ)) ^ ((2 : ℝ) / 3) * lam ^ (-1 + ν / 2) ≤ M_ν * lam ^ (-1 + ν) := by
    have h_log2_pos : 0 < Real.log 2 := Real.log_pos (by norm_num)
    have h_log_ineq : (K : ℝ) * Real.log 2 ≤ 3 * Real.log lam := by
      have h1 := Real.log_le_log (by positivity : (0 : ℝ) < (2 : ℝ) ^ K) h_pow_le_cube
      rwa [Real.log_pow, Real.log_pow, Nat.cast_ofNat] at h1
    let α : ℝ := (3 / 4 : ℝ) * ν
    have hα_pos : 0 < α := by positivity
    have h_exp_bound : α * Real.log lam ≤ lam ^ α := by
      calc α * Real.log lam ≤ α * Real.log lam + 1 := by linarith
        _ ≤ Real.exp (α * Real.log lam) := Real.add_one_le_exp _
        _ = lam ^ α := by rw [Real.rpow_def_of_pos hlam_pos, mul_comm]
    have h_2K_bound : 2 * (K : ℝ) ≤ (8 / (ν * Real.log 2)) * lam ^ α := by
      have h_mul_log2 : (2 * (K : ℝ)) * Real.log 2 ≤ (8 / ν) * lam ^ α := by
        calc (2 * (K : ℝ)) * Real.log 2 = 2 * ((K : ℝ) * Real.log 2) := by ring
          _ ≤ 2 * (3 * Real.log lam) := by linarith
          _ = (8 / ν) * (α * Real.log lam) := by dsimp only [α]; field_simp; ring
          _ ≤ (8 / ν) * lam ^ α := mul_le_mul_of_nonneg_left h_exp_bound (by positivity)
      calc 2 * (K : ℝ) = ((2 * (K : ℝ)) * Real.log 2) / Real.log 2 := by field_simp
        _ ≤ ((8 / ν) * lam ^ α) / Real.log 2 :=
            div_le_div_of_nonneg_right h_mul_log2 h_log2_pos.le
        _ = (8 / (ν * Real.log 2)) * lam ^ α := by ring
    have h_rpow_2K : (2 * (K : ℝ)) ^ ((2 : ℝ) / 3) ≤ M_ν * lam ^ (ν / 2) := by
      have h1 := Real.rpow_le_rpow (by positivity) h_2K_bound (by norm_num : (0 : ℝ) ≤ 2 / 3)
      rw [Real.mul_rpow (by positivity) (Real.rpow_nonneg hlam_nn _), ← Real.rpow_mul hlam_nn] at h1
      have hexp_α : α * ((2 : ℝ) / 3) = ν / 2 := by dsimp only [α]; ring
      rw [hexp_α] at h1
      have h_c_le : (8 / (ν * Real.log 2)) ^ ((2 : ℝ) / 3) ≤ M_ν :=
        (le_max_right _ _).trans (le_max_right _ _)
      exact h1.trans (mul_le_mul_of_nonneg_right h_c_le (Real.rpow_nonneg hlam_nn _))
    calc (2 * (K : ℝ)) ^ ((2 : ℝ) / 3) * lam ^ (-1 + ν / 2)
        ≤ (M_ν * lam ^ (ν / 2)) * lam ^ (-1 + ν / 2) :=
          mul_le_mul_of_nonneg_right h_rpow_2K (Real.rpow_nonneg hlam_nn _)
      _ = M_ν * (lam ^ (ν / 2) * lam ^ (-1 + ν / 2)) := by ring
      _ = M_ν * lam ^ (-1 + ν) := by
          rw [← Real.rpow_add hlam_pos]
          congr 2; ring

  
  let f_m : EuclideanSpace ℝ (Fin 2) → ℂ := Set.indicator K_in (hf_meas.mk f)
  have hf_m_smeas : MeasureTheory.StronglyMeasurable f_m :=
    hf_meas.stronglyMeasurable_mk.indicator hK_in_meas
  have hf_m_norm_meas : Measurable (fun v => ‖f_m v‖) := hf_m_smeas.norm.measurable
  have hf_ae_eq : f =ᵐ[MeasureTheory.volume] f_m := by
    filter_upwards [hf_meas.ae_eq_mk] with v hv
    dsimp only [f_m]
    by_cases hvK : v ∈ K_in
    · rw [Set.indicator_of_mem hvK, hv]
    · rw [Set.indicator_of_notMem hvK]
      have hv_out : R_v + 1 < ‖v‖ := by
        rwa [Metric.mem_closedBall, dist_zero_right, not_le] at hvK
      exact hf_supp v hv_out.le
  have hf_m_int : MeasureTheory.Integrable f_m MeasureTheory.volume :=
    hf_int.congr hf_ae_eq
  have hf_m_l3_eq : MeasureTheory.eLpNorm f_m 3 MeasureTheory.volume = ENNReal.ofReal N := by
    rw [MeasureTheory.eLpNorm_congr_ae hf_ae_eq.symm, hN_ofReal]
  have hf_m_memLp : MeasureTheory.MemLp f_m 3 MeasureTheory.volume := by
    change MeasureTheory.eLpNorm f_m 3 MeasureTheory.volume < ⊤
    rw [hf_m_l3_eq]
    exact ENNReal.ofReal_lt_top
  have hf_m_cube_int : MeasureTheory.Integrable (fun v => ‖f_m v‖ ^ 3) MeasureTheory.volume := by
    have h_rpow := hf_m_memLp.integrable_norm_rpow (by norm_num) (by norm_num)
    have h_eq_fn : (fun v => ‖f_m v‖ ^ (3 : ENNReal).toReal) = (fun v => ‖f_m v‖ ^ 3) := by
      ext v
      have h3 : (3 : ENNReal).toReal = ((3 : ℕ) : ℝ) := by norm_num
      rw [h3, Real.rpow_natCast]
    rwa [h_eq_fn] at h_rpow
  have hf_m_cube_le : ∫ v : EuclideanSpace ℝ (Fin 2), ‖f_m v‖ ^ 3 ≤ N ^ 3 := by
    have h_eq_el3 := MeasureTheory.MemLp.eLpNorm_eq_integral_rpow_norm
      (by norm_num) (by norm_num) hf_m_memLp
    rw [hf_m_l3_eq] at h_eq_el3
    have h3 : (3 : ENNReal).toReal = ((3 : ℕ) : ℝ) := by norm_num
    have h3_inv : (3 : ENNReal).toReal⁻¹ = (1 : ℝ) / 3 := by norm_num
    have h_int_eq : (∫ v, ‖f_m v‖ ^ (3 : ENNReal).toReal) = ∫ v, ‖f_m v‖ ^ 3 := by
      congr 1; ext v; rw [h3, Real.rpow_natCast]
    rw [h_int_eq, h3_inv] at h_eq_el3
    have h_int_nn : 0 ≤ ∫ v : EuclideanSpace ℝ (Fin 2), ‖f_m v‖ ^ 3 :=
      MeasureTheory.integral_nonneg (fun v => pow_nonneg (norm_nonneg _) 3)
    have h_rpow_eq : (∫ v : EuclideanSpace ℝ (Fin 2), ‖f_m v‖ ^ 3) ^ ((1 : ℝ) / 3) = N := by
      have h_to := congr_arg ENNReal.toReal h_eq_el3
      rw [ENNReal.toReal_ofReal hN_pos.le,
        ENNReal.toReal_ofReal (Real.rpow_nonneg h_int_nn _)] at h_to
      exact h_to.symm
    have h_pow3 := congr_arg (fun x : ℝ => x ^ (3 : ℕ)) h_rpow_eq
    rw [← Real.rpow_natCast _ 3, ← Real.rpow_mul h_int_nn] at h_pow3
    have hexp1 : ((1 : ℝ) / 3) * ((3 : ℕ) : ℝ) = 1 := by norm_num
    rw [hexp1, Real.rpow_one] at h_pow3
    exact h_pow3.le

  
  let a : ℤ → ℝ := fun k => N * (2 : ℝ) ^ k
  have ha_pos : ∀ k : ℤ, 0 < a k := fun k => mul_pos hN_pos (zpow_pos (by norm_num) k)
  have ha_mono : ∀ {k₁ k₂ : ℤ}, k₁ ≤ k₂ → a k₁ ≤ a k₂ :=
    fun hk => mul_le_mul_of_nonneg_left (zpow_le_zpow_right₀ (by norm_num) hk) hN_pos.le
  let F_lo : Set (EuclideanSpace ℝ (Fin 2)) := K_in ∩ {v | ‖f_m v‖ ≤ a (-(K : ℤ))}
  let F_hi : Set (EuclideanSpace ℝ (Fin 2)) := K_in ∩ {v | a (K : ℤ) < ‖f_m v‖}
  let F_shell : ℤ → Set (EuclideanSpace ℝ (Fin 2)) :=
    fun k => K_in ∩ ({v | a k < ‖f_m v‖} ∩ {v | ‖f_m v‖ ≤ a (k + 1)})
  have hF_lo_meas : MeasurableSet F_lo :=
    hK_in_meas.inter (hf_m_norm_meas measurableSet_Iic)
  have hF_hi_meas : MeasurableSet F_hi :=
    hK_in_meas.inter (hf_m_norm_meas measurableSet_Ioi)
  have hF_shell_meas : ∀ k : ℤ, MeasurableSet (F_shell k) :=
    fun k => hK_in_meas.inter ((hf_m_norm_meas measurableSet_Ioi).inter
      (hf_m_norm_meas measurableSet_Iic))
  have hF_shell_sub : ∀ k : ℤ, F_shell k ⊆ K_in := fun _ => Set.inter_subset_left
  let g_lo : EuclideanSpace ℝ (Fin 2) → ℂ := Set.indicator F_lo f_m
  let g_hi : EuclideanSpace ℝ (Fin 2) → ℂ := Set.indicator F_hi f_m
  let g_unit : ℤ → EuclideanSpace ℝ (Fin 2) → ℂ :=
    fun k => (a (k + 1))⁻¹ • Set.indicator (F_shell k) f_m
  have hg_lo_int : MeasureTheory.Integrable g_lo MeasureTheory.volume :=
    hf_m_int.indicator hF_lo_meas
  have hg_hi_int : MeasureTheory.Integrable g_hi MeasureTheory.volume :=
    hf_m_int.indicator hF_hi_meas
  have hg_unit_int : ∀ k : ℤ, MeasureTheory.Integrable (g_unit k) MeasureTheory.volume :=
    fun k => (hf_m_int.indicator (hF_shell_meas k)).smul (a (k + 1))⁻¹
  have hg_unit_ind : ∀ (k : ℤ) (v : EuclideanSpace ℝ (Fin 2)),
      ‖g_unit k v‖ ≤ Set.indicator (F_shell k) 1 v := by
    intro k v
    dsimp only [g_unit, Pi.smul_apply]
    by_cases hv : v ∈ F_shell k
    · rw [Set.indicator_of_mem hv, Set.indicator_of_mem hv, Pi.one_apply,
        norm_smul, Real.norm_of_nonneg (inv_nonneg.mpr (ha_pos (k + 1)).le)]
      have hv_le : ‖f_m v‖ ≤ a (k + 1) := hv.2.2
      exact (inv_mul_le_iff₀ (ha_pos (k + 1))).mpr (by linarith)
    · rw [Set.indicator_of_notMem hv, Set.indicator_of_notMem hv, smul_zero, norm_zero]

  let S : Finset ℤ := Finset.Ico (-(K : ℤ)) (K : ℤ)
  have hf_m_part : ∀ v : EuclideanSpace ℝ (Fin 2),
      f_m v = g_lo v + g_hi v + ∑ k ∈ S, a (k + 1) • g_unit k v := by
    intro v
    have h_smul_cancel : ∀ k : ℤ, a (k + 1) • g_unit k v = Set.indicator (F_shell k) f_m v :=
      fun k => smul_inv_smul₀ (ha_pos (k + 1)).ne' _
    simp_rw [h_smul_cancel]
    dsimp only [g_lo, g_hi]
    by_cases hvK : v ∈ K_in
    · by_cases hlo : ‖f_m v‖ ≤ a (-(K : ℤ))
      · have hv_lo : v ∈ F_lo := ⟨hvK, hlo⟩
        have hv_not_hi : v ∉ F_hi := by
          intro h; exact not_lt_of_ge (hlo.trans (ha_mono (by omega))) h.2
        have h_sum_zero : ∑ k ∈ S, Set.indicator (F_shell k) f_m v = 0 := by
          refine Finset.sum_eq_zero (fun k hk => ?_)
          refine Set.indicator_of_notMem (fun h => ?_) f_m
          rw [Finset.mem_Ico] at hk
          exact not_lt_of_ge (hlo.trans (ha_mono hk.1)) h.2.1
        rw [Set.indicator_of_mem hv_lo, Set.indicator_of_notMem hv_not_hi, h_sum_zero,
          add_zero, add_zero]
      · by_cases hhi : a (K : ℤ) < ‖f_m v‖
        · have hv_not_lo : v ∉ F_lo := fun h => hlo h.2
          have hv_hi : v ∈ F_hi := ⟨hvK, hhi⟩
          have h_sum_zero : ∑ k ∈ S, Set.indicator (F_shell k) f_m v = 0 := by
            refine Finset.sum_eq_zero (fun k hk => ?_)
            refine Set.indicator_of_notMem (fun h => ?_) f_m
            rw [Finset.mem_Ico] at hk
            exact not_lt_of_ge (h.2.2.trans (ha_mono (by omega : k + 1 ≤ (K : ℤ)))) hhi
          rw [Set.indicator_of_notMem hv_not_lo, Set.indicator_of_mem hv_hi, h_sum_zero,
            zero_add, add_zero]
        · have hv_not_lo : v ∉ F_lo := fun h => hlo h.2
          have hv_not_hi : v ∉ F_hi := fun h => hhi h.2
          have hy_gt : a (-(K : ℤ)) < ‖f_m v‖ := lt_of_not_ge hlo
          have hy_le : ‖f_m v‖ ≤ a (K : ℤ) := le_of_not_gt hhi
          have h_ex : ∀ (n : ℤ), -(K : ℤ) ≤ n →
              ‖f_m v‖ ≤ a n → ∃ k ∈ Finset.Ico (-(K : ℤ)) n, a k < ‖f_m v‖ ∧ ‖f_m v‖ ≤ a (k + 1) := by
            refine Int.leInduction ?_ ?_
            · intro h_contra
              exact absurd h_contra (not_le_of_gt hy_gt)
            · intro n hn ih h_le_succ
              by_cases h_le_n : ‖f_m v‖ ≤ a n
              · obtain ⟨k, hk_mem, hk_bd⟩ := ih h_le_n
                rw [Finset.mem_Ico] at hk_mem
                exact ⟨k, Finset.mem_Ico.mpr ⟨hk_mem.1, by omega⟩, hk_bd⟩
              · exact ⟨n, Finset.mem_Ico.mpr ⟨hn, by omega⟩, lt_of_not_ge h_le_n, h_le_succ⟩
          obtain ⟨k₀, hk₀_S, hk₀_gt, hk₀_le⟩ := h_ex (K : ℤ) (by omega) hy_le
          have hv_k₀ : v ∈ F_shell k₀ := ⟨hvK, hk₀_gt, hk₀_le⟩
          have h_sum_eq : ∑ k ∈ S, Set.indicator (F_shell k) f_m v = f_m v := by
            rw [Finset.sum_eq_single k₀]
            · exact Set.indicator_of_mem hv_k₀ f_m
            · intro k _ hk_ne
              refine Set.indicator_of_notMem (fun h => ?_) f_m
              rcases lt_or_gt_of_ne hk_ne with hlt | hgt
              · exact not_lt_of_ge (h.2.2.trans (ha_mono (by omega : k + 1 ≤ k₀))) hk₀_gt
              · exact not_lt_of_ge (hk₀_le.trans (ha_mono (by omega : k₀ + 1 ≤ k))) h.2.1
            · intro hk₀_not; exact absurd hk₀_S hk₀_not
          rw [Set.indicator_of_notMem hv_not_lo, Set.indicator_of_notMem hv_not_hi, h_sum_eq,
            zero_add, zero_add]
    · have hv_not_lo : v ∉ F_lo := fun h => hvK h.1
      have hv_not_hi : v ∉ F_hi := fun h => hvK h.1
      have h_sum_zero : ∑ k ∈ S, Set.indicator (F_shell k) f_m v = 0 :=
        Finset.sum_eq_zero (fun k _ =>
          Set.indicator_of_notMem (fun (h : v ∈ F_shell k) => hvK h.1) f_m)
      have hfm0 : f_m v = 0 := Set.indicator_of_notMem hvK _
      rw [hfm0, Set.indicator_of_notMem hv_not_lo, Set.indicator_of_notMem hv_not_hi, h_sum_zero,
        add_zero, add_zero]

  
  have hg_lo_l1 : ∫ v : EuclideanSpace ℝ (Fin 2), ‖g_lo v‖ ≤
      V_in * lam ^ (-1 + ν) * N := by
    have h_ind_int : MeasureTheory.Integrable
        (Set.indicator K_in (fun _ => a (-(K : ℤ)))) MeasureTheory.volume :=
      MeasureTheory.memLp_one_iff_integrable.mp
        (MeasureTheory.memLp_indicator_const 1 hK_in_meas (a (-(K : ℤ))) (Or.inr hK_in_ne_top))
    have h_pt : ∀ v, ‖g_lo v‖ ≤ Set.indicator K_in (fun _ => a (-(K : ℤ))) v := by
      intro v
      dsimp only [g_lo]
      by_cases hv : v ∈ F_lo
      · rw [Set.indicator_of_mem hv, Set.indicator_of_mem hv.1]
        exact hv.2
      · rw [Set.indicator_of_notMem hv, norm_zero]
        by_cases hvK : v ∈ K_in
        · rw [Set.indicator_of_mem hvK]; exact (ha_pos _).le
        · rw [Set.indicator_of_notMem hvK]
    calc ∫ v, ‖g_lo v‖
        ≤ ∫ v, Set.indicator K_in (fun _ => a (-(K : ℤ))) v :=
          MeasureTheory.integral_mono hg_lo_int.norm h_ind_int h_pt
      _ = V_in * (2 : ℝ) ^ (-(K : ℤ)) * N := by
          rw [MeasureTheory.integral_indicator_const _ hK_in_meas,
            MeasureTheory.measureReal_def, smul_eq_mul]
          dsimp only [V_in, a]
          ring
      _ ≤ V_in * lam ^ (-1 + ν) * N := by
          refine mul_le_mul_of_nonneg_right ?_ hN_pos.le
          exact mul_le_mul_of_nonneg_left h_2negK hV_in_nn

  have hg_hi_l1 : ∫ v : EuclideanSpace ℝ (Fin 2), ‖g_hi v‖ ≤
      lam ^ (-1 + ν) * N := by
    have haK_pos : 0 < a (K : ℤ) := ha_pos (K : ℤ)
    have h_pt : ∀ v, ‖g_hi v‖ ≤ ((a (K : ℤ)) ^ 2)⁻¹ * ‖f_m v‖ ^ 3 := by
      intro v
      dsimp only [g_hi]
      by_cases hv : v ∈ F_hi
      · rw [Set.indicator_of_mem hv]
        have hy : a (K : ℤ) ≤ ‖f_m v‖ := hv.2.le
        have h_sq : (a (K : ℤ)) ^ 2 ≤ ‖f_m v‖ ^ 2 :=
          pow_le_pow_left₀ haK_pos.le hy 2
        have h_mul : (a (K : ℤ)) ^ 2 * ‖f_m v‖ ≤ ‖f_m v‖ ^ 3 := by
          calc (a (K : ℤ)) ^ 2 * ‖f_m v‖ ≤ ‖f_m v‖ ^ 2 * ‖f_m v‖ :=
                mul_le_mul_of_nonneg_right h_sq (norm_nonneg _)
            _ = ‖f_m v‖ ^ 3 := by ring
        exact (le_inv_mul_iff₀ (pow_pos haK_pos 2)).mpr h_mul
      · rw [Set.indicator_of_notMem hv, norm_zero]
        exact mul_nonneg (inv_nonneg.mpr (sq_nonneg _)) (pow_nonneg (norm_nonneg _) 3)
    have h_alg : ((a (K : ℤ)) ^ 2)⁻¹ * N ^ 3 = (2 : ℝ) ^ (-2 * (K : ℤ)) * N := by
      dsimp only [a]
      have hN_ne : N ≠ 0 := hN_pos.ne'
      have h2K_ne : (2 : ℝ) ^ (K : ℤ) ≠ 0 := (zpow_pos (by norm_num) (K : ℤ)).ne'
      have hzpow : (2 : ℝ) ^ (-2 * (K : ℤ)) = (((2 : ℝ) ^ (K : ℤ)) ^ 2)⁻¹ := by
        rw [mul_comm (-2 : ℤ) (K : ℤ), zpow_mul, zpow_neg, zpow_ofNat]
      rw [hzpow]
      field_simp
    calc ∫ v, ‖g_hi v‖
        ≤ ∫ v, ((a (K : ℤ)) ^ 2)⁻¹ * ‖f_m v‖ ^ 3 :=
          MeasureTheory.integral_mono hg_hi_int.norm (hf_m_cube_int.const_mul _) h_pt
      _ = ((a (K : ℤ)) ^ 2)⁻¹ * ∫ v, ‖f_m v‖ ^ 3 := MeasureTheory.integral_const_mul _ _
      _ ≤ ((a (K : ℤ)) ^ 2)⁻¹ * N ^ 3 :=
          mul_le_mul_of_nonneg_left hf_m_cube_le (inv_nonneg.mpr (sq_nonneg _))
      _ = (2 : ℝ) ^ (-2 * (K : ℤ)) * N := h_alg
      _ ≤ lam ^ (-1 + ν) * N := mul_le_mul_of_nonneg_right h_2neg2K hN_pos.le

  
  have hF_shell_lt_top : ∀ k : ℤ, MeasureTheory.volume (F_shell k) < ⊤ :=
    fun k => lt_of_le_of_lt (MeasureTheory.measure_mono (hF_shell_sub k)) hK_in_lt_top
  have hF_disj : (S : Set ℤ).Pairwise (Function.onFun Disjoint F_shell) := by
    intro k₁ _ k₂ _ hk_ne
    rw [Function.onFun, Set.disjoint_left]
    intro v hv1 hv2
    rcases lt_or_gt_of_ne hk_ne with hlt | hgt
    · exact not_lt_of_ge (hv1.2.2.trans (ha_mono (by omega : k₁ + 1 ≤ k₂))) hv2.2.1
    · exact not_lt_of_ge (hv2.2.2.trans (ha_mono (by omega : k₂ + 1 ≤ k₁))) hv1.2.1
  have h_packing : ∑ k ∈ S, ((2 : ℝ) ^ k) ^ 3 * (MeasureTheory.volume (F_shell k)).toReal ≤ 1 := by
    have h_each : ∀ k ∈ S,
        (MeasureTheory.volume (F_shell k)).toReal * (a k) ^ 3 ≤
          ∫ v in F_shell k, ‖f_m v‖ ^ 3 := by
      intro k _
      have hk_ne_top : MeasureTheory.volume (F_shell k) ≠ ⊤ := (hF_shell_lt_top k).ne
      have h_const_int : MeasureTheory.IntegrableOn (fun _ => (a k) ^ 3) (F_shell k)
          MeasureTheory.volume := MeasureTheory.integrableOn_const (hs := hk_ne_top)
      calc (MeasureTheory.volume (F_shell k)).toReal * (a k) ^ 3
          = ∫ _ in F_shell k, (a k) ^ 3 := by
              rw [MeasureTheory.setIntegral_const, MeasureTheory.measureReal_def, smul_eq_mul]
        _ ≤ ∫ v in F_shell k, ‖f_m v‖ ^ 3 :=
              MeasureTheory.setIntegral_mono_on h_const_int hf_m_cube_int.integrableOn
                (hF_shell_meas k) (fun v hv => pow_le_pow_left₀ (ha_pos k).le hv.2.1.le 3)
    have h_sum_int : ∑ k ∈ S, (MeasureTheory.volume (F_shell k)).toReal * (a k) ^ 3 ≤ N ^ 3 := by
      calc ∑ k ∈ S, (MeasureTheory.volume (F_shell k)).toReal * (a k) ^ 3
          ≤ ∑ k ∈ S, ∫ v in F_shell k, ‖f_m v‖ ^ 3 := Finset.sum_le_sum h_each
        _ = ∫ v in ⋃ k ∈ S, F_shell k, ‖f_m v‖ ^ 3 :=
            (MeasureTheory.integral_biUnion_finset S (fun k _ => hF_shell_meas k) hF_disj
              (fun k _ => hf_m_cube_int.integrableOn)).symm
        _ ≤ ∫ v, ‖f_m v‖ ^ 3 :=
            MeasureTheory.setIntegral_le_integral hf_m_cube_int
              (Filter.Eventually.of_forall (fun v => pow_nonneg (norm_nonneg _) 3))
        _ ≤ N ^ 3 := hf_m_cube_le
    have h_factor : ∑ k ∈ S, (MeasureTheory.volume (F_shell k)).toReal * (a k) ^ 3 =
        N ^ 3 * ∑ k ∈ S, ((2 : ℝ) ^ k) ^ 3 * (MeasureTheory.volume (F_shell k)).toReal := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun k _ => ?_)
      dsimp only [a]
      ring
    rw [h_factor] at h_sum_int
    exact le_of_mul_le_mul_left (h_sum_int.trans_eq (mul_one (N ^ 3)).symm) (pow_pos hN_pos 3)

  have h_shell_sum :
      ∑ k ∈ S, (2 : ℝ) ^ (k + 1) * ((MeasureTheory.volume (F_shell k)).toReal) ^ ((1 : ℝ) / 3) ≤
        2 * (2 * (K : ℝ)) ^ ((2 : ℝ) / 3) := by
    let w : ℤ → ℝ :=
      fun k => (2 : ℝ) ^ k * ((MeasureTheory.volume (F_shell k)).toReal) ^ ((1 : ℝ) / 3)
    have hw_nn : ∀ k : ℤ, 0 ≤ w k :=
      fun k => mul_nonneg (zpow_nonneg (by norm_num) k) (Real.rpow_nonneg ENNReal.toReal_nonneg _)
    have hpq : Real.HolderConjugate (3 / 2) 3 :=
      Real.holderConjugate_iff.mpr ⟨by norm_num, by norm_num⟩
    have h_holder := Real.inner_le_Lp_mul_Lq_of_nonneg S hpq
      (f := fun _ => (1 : ℝ)) (g := w) (fun _ _ => zero_le_one) (fun k _ => hw_nn k)
    have hS_card : (S.card : ℝ) = 2 * (K : ℝ) := by
      have hc : S.card = K + K := by
        dsimp only [S]
        rw [Int.card_Ico]
        omega
      rw [hc]
      push_cast
      ring
    have h_lhs_eq : ∑ k ∈ S, (1 : ℝ) * w k = ∑ k ∈ S, w k :=
      Finset.sum_congr rfl (fun k _ => one_mul (w k))
    have h_p_term : (∑ _ ∈ S, (1 : ℝ) ^ (3 / 2 : ℝ)) ^ (1 / (3 / 2 : ℝ)) =
        (2 * (K : ℝ)) ^ ((2 : ℝ) / 3) := by
      have h1 : ∑ _ ∈ S, (1 : ℝ) ^ (3 / 2 : ℝ) = 2 * (K : ℝ) := by
        simp [Real.one_rpow, hS_card]
      have h2 : (1 : ℝ) / (3 / 2 : ℝ) = (2 : ℝ) / 3 := by norm_num
      rw [h1, h2]
    have h_q_sum : ∑ k ∈ S, w k ^ (3 : ℝ) =
        ∑ k ∈ S, ((2 : ℝ) ^ k) ^ 3 * (MeasureTheory.volume (F_shell k)).toReal := by
      refine Finset.sum_congr rfl (fun k _ => ?_)
      dsimp only [w]
      rw [Real.mul_rpow (zpow_nonneg (by norm_num) k) (Real.rpow_nonneg ENNReal.toReal_nonneg _),
        ← Real.rpow_mul ENNReal.toReal_nonneg]
      have h1 : ((1 : ℝ) / 3) * 3 = 1 := by norm_num
      have h2 : ((2 : ℝ) ^ k) ^ (3 : ℝ) = ((2 : ℝ) ^ k) ^ (3 : ℕ) := by
        rw [show (3 : ℝ) = ((3 : ℕ) : ℝ) by norm_num, Real.rpow_natCast]
      rw [h1, Real.rpow_one, h2]
    have h_q_le_one : (∑ k ∈ S, w k ^ (3 : ℝ)) ^ (1 / (3 : ℝ)) ≤ 1 := by
      have h_nn : 0 ≤ ∑ k ∈ S, w k ^ (3 : ℝ) :=
        Finset.sum_nonneg (fun k _ => Real.rpow_nonneg (hw_nn k) _)
      rw [h_q_sum] at h_nn ⊢
      calc (∑ k ∈ S, ((2 : ℝ) ^ k) ^ 3 * (MeasureTheory.volume (F_shell k)).toReal) ^ (1 / (3 : ℝ))
          ≤ (1 : ℝ) ^ (1 / (3 : ℝ)) := Real.rpow_le_rpow h_nn h_packing (by norm_num)
        _ = 1 := Real.one_rpow _
    rw [h_lhs_eq, h_p_term] at h_holder
    have h_w_le : ∑ k ∈ S, w k ≤ (2 * (K : ℝ)) ^ ((2 : ℝ) / 3) := by
      calc ∑ k ∈ S, w k
          ≤ (2 * (K : ℝ)) ^ ((2 : ℝ) / 3) * (∑ k ∈ S, w k ^ (3 : ℝ)) ^ (1 / (3 : ℝ)) := h_holder
        _ ≤ (2 * (K : ℝ)) ^ ((2 : ℝ) / 3) * 1 :=
            mul_le_mul_of_nonneg_left h_q_le_one (by positivity)
        _ = (2 * (K : ℝ)) ^ ((2 : ℝ) / 3) := mul_one _
    have h_shift : ∑ k ∈ S,
          (2 : ℝ) ^ (k + 1) * ((MeasureTheory.volume (F_shell k)).toReal) ^ ((1 : ℝ) / 3) =
        2 * ∑ k ∈ S, w k := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun k _ => ?_)
      dsimp only [w]
      rw [zpow_add_one₀ (by norm_num : (2 : ℝ) ≠ 0) k]
      ring
    rw [h_shift]
    exact mul_le_mul_of_nonneg_left h_w_le (by norm_num)

  
  let E_lo := oscIntegralOp2D lam Φ₀ B g_lo
  let E_hi := oscIntegralOp2D lam Φ₀ B g_hi
  let E_k : ℤ → ℝ × EuclideanSpace ℝ (Fin 2) → ℂ :=
    fun k => oscIntegralOp2D lam Φ₀ B (g_unit k)
  have h_op_decomp : oscIntegralOp2D lam Φ₀ B f =
      E_lo + E_hi + ∑ k ∈ S, a (k + 1) • E_k k := by
    ext cx
    simp only [Pi.add_apply, Finset.sum_apply, Pi.smul_apply]
    let ker_cx : EuclideanSpace ℝ (Fin 2) → ℂ :=
      fun v => Complex.exp (Complex.I * ((lam * Φ₀ (cx.1, cx.2, v) : ℝ) : ℂ)) * B (cx.1, cx.2, v)
    have h_ae_ker : (fun v => ker_cx v * f v) =ᵐ[MeasureTheory.volume]
        (fun v => ker_cx v * f_m v) := by
      filter_upwards [hf_ae_eq] with v hv
      rw [hv]
    change ∫ v, ker_cx v * f v = _
    rw [MeasureTheory.integral_congr_ae h_ae_ker]
    have h_expand : (fun v => ker_cx v * f_m v) =
        (fun v => ker_cx v * g_lo v +
          (ker_cx v * g_hi v + ∑ k ∈ S, a (k + 1) • (ker_cx v * g_unit k v))) := by
      ext v
      rw [hf_m_part v, mul_add, mul_add, add_assoc, Finset.mul_sum]
      congr 2
      refine Finset.sum_congr rfl (fun k _ => ?_)
      rw [mul_smul_comm]
    rw [h_expand]
    have h_lo_fib : MeasureTheory.Integrable (fun v => ker_cx v * g_lo v) MeasureTheory.volume :=
      (h_L1_op g_lo hg_lo_int).2.1 cx
    have h_hi_fib : MeasureTheory.Integrable (fun v => ker_cx v * g_hi v) MeasureTheory.volume :=
      (h_L1_op g_hi hg_hi_int).2.1 cx
    have h_k_fib : ∀ k : ℤ, MeasureTheory.Integrable
        (fun v => a (k + 1) • (ker_cx v * g_unit k v)) MeasureTheory.volume :=
      fun k => ((h_L1_op (g_unit k) (hg_unit_int k)).2.1 cx).smul (a (k + 1))
    have h_sum_fib : MeasureTheory.Integrable
        (fun v => ∑ k ∈ S, a (k + 1) • (ker_cx v * g_unit k v)) MeasureTheory.volume :=
      MeasureTheory.integrable_finsetSum S (fun k _ => h_k_fib k)
    have h_hi_sum_fib : MeasureTheory.Integrable
        (fun v => ker_cx v * g_hi v + ∑ k ∈ S, a (k + 1) • (ker_cx v * g_unit k v))
        MeasureTheory.volume := h_hi_fib.add h_sum_fib
    rw [MeasureTheory.integral_add h_lo_fib h_hi_sum_fib,
      MeasureTheory.integral_add h_hi_fib h_sum_fib, ← add_assoc,
      MeasureTheory.integral_finsetSum S (fun k _ => h_k_fib k)]
    congr 1
    refine Finset.sum_congr rfl (fun k _ => ?_)
    exact MeasureTheory.integral_smul (a (k + 1)) (fun v => ker_cx v * g_unit k v)

  have hp1 : (1 : ENNReal) ≤ 3 := by norm_num
  have h_el3_lo : MeasureTheory.eLpNorm E_lo 3 MeasureTheory.volume ≤
      ENNReal.ofReal (C_L1 * V_in * lam ^ (-1 + ν) * N) := by
    refine ((h_L1_op g_lo hg_lo_int).2.2).trans (ENNReal.ofReal_le_ofReal ?_)
    calc C_L1 * ∫ v, ‖g_lo v‖
        ≤ C_L1 * (V_in * lam ^ (-1 + ν) * N) := mul_le_mul_of_nonneg_left hg_lo_l1 hC_L1_nn
      _ = C_L1 * V_in * lam ^ (-1 + ν) * N := by ring
  have h_el3_hi : MeasureTheory.eLpNorm E_hi 3 MeasureTheory.volume ≤
      ENNReal.ofReal (C_L1 * lam ^ (-1 + ν) * N) := by
    refine ((h_L1_op g_hi hg_hi_int).2.2).trans (ENNReal.ofReal_le_ofReal ?_)
    calc C_L1 * ∫ v, ‖g_hi v‖
        ≤ C_L1 * (lam ^ (-1 + ν) * N) := mul_le_mul_of_nonneg_left hg_hi_l1 hC_L1_nn
      _ = C_L1 * lam ^ (-1 + ν) * N := by ring
  have h_el3_shells : ∑ k ∈ S, MeasureTheory.eLpNorm (a (k + 1) • E_k k) 3 MeasureTheory.volume ≤
      ENNReal.ofReal (2 * C_sub * M_ν * lam ^ (-1 + ν) * N) := by
    have h_term : ∀ k ∈ S,
        MeasureTheory.eLpNorm (a (k + 1) • E_k k) 3 MeasureTheory.volume ≤
          ENNReal.ofReal (C_sub * lam ^ (-1 + ν / 2) * N *
            ((2 : ℝ) ^ (k + 1) * ((MeasureTheory.volume (F_shell k)).toReal) ^ ((1 : ℝ) / 3))) := by
      intro k _
      rw [MeasureTheory.eLpNorm_const_smul, Real.enorm_eq_ofReal (ha_pos (k + 1)).le]
      have h_sub_k := h_sub hlam_Λ (F_shell k) (hF_shell_meas k) (hF_shell_sub k)
        (g_unit k) (hg_unit_int k).aestronglyMeasurable (hg_unit_ind k)
      have h_vol_eq : (MeasureTheory.volume (F_shell k)) ^ ((1 : ℝ) / 3) =
          ENNReal.ofReal (((MeasureTheory.volume (F_shell k)).toReal) ^ ((1 : ℝ) / 3)) := by
        rw [← ENNReal.ofReal_rpow_of_nonneg ENNReal.toReal_nonneg (by norm_num),
          ENNReal.ofReal_toReal (hF_shell_lt_top k).ne]
      rw [h_vol_eq, ← ENNReal.ofReal_mul (mul_nonneg hC_sub (Real.rpow_nonneg hlam_nn _))] at h_sub_k
      calc ENNReal.ofReal (a (k + 1)) * MeasureTheory.eLpNorm (E_k k) 3 MeasureTheory.volume
          ≤ ENNReal.ofReal (a (k + 1)) *
              ENNReal.ofReal (C_sub * lam ^ (-1 + ν / 2) *
                ((MeasureTheory.volume (F_shell k)).toReal) ^ ((1 : ℝ) / 3)) :=
            mul_le_mul_of_nonneg_left h_sub_k zero_le
        _ = ENNReal.ofReal (C_sub * lam ^ (-1 + ν / 2) * N *
              ((2 : ℝ) ^ (k + 1) * ((MeasureTheory.volume (F_shell k)).toReal) ^ ((1 : ℝ) / 3))) := by
            rw [← ENNReal.ofReal_mul (ha_pos (k + 1)).le]
            congr 1
            dsimp only [a]
            ring
    have h_term_nn : ∀ k ∈ S, 0 ≤ C_sub * lam ^ (-1 + ν / 2) * N *
        ((2 : ℝ) ^ (k + 1) * ((MeasureTheory.volume (F_shell k)).toReal) ^ ((1 : ℝ) / 3)) :=
      fun k _ => mul_nonneg (mul_nonneg (mul_nonneg hC_sub (Real.rpow_nonneg hlam_nn _)) hN_pos.le)
        (mul_nonneg (zpow_nonneg (by norm_num) _) (Real.rpow_nonneg ENNReal.toReal_nonneg _))
    calc ∑ k ∈ S, MeasureTheory.eLpNorm (a (k + 1) • E_k k) 3 MeasureTheory.volume
        ≤ ∑ k ∈ S, ENNReal.ofReal (C_sub * lam ^ (-1 + ν / 2) * N *
            ((2 : ℝ) ^ (k + 1) * ((MeasureTheory.volume (F_shell k)).toReal) ^ ((1 : ℝ) / 3))) :=
          Finset.sum_le_sum h_term
      _ = ENNReal.ofReal (∑ k ∈ S, C_sub * lam ^ (-1 + ν / 2) * N *
            ((2 : ℝ) ^ (k + 1) * ((MeasureTheory.volume (F_shell k)).toReal) ^ ((1 : ℝ) / 3))) :=
          (ENNReal.ofReal_sum_of_nonneg h_term_nn).symm
      _ ≤ ENNReal.ofReal (2 * C_sub * M_ν * lam ^ (-1 + ν) * N) := by
          apply ENNReal.ofReal_le_ofReal
          rw [← Finset.mul_sum]
          calc (C_sub * lam ^ (-1 + ν / 2) * N) *
                ∑ k ∈ S, (2 : ℝ) ^ (k + 1) *
                  ((MeasureTheory.volume (F_shell k)).toReal) ^ ((1 : ℝ) / 3)
              ≤ (C_sub * lam ^ (-1 + ν / 2) * N) * (2 * (2 * (K : ℝ)) ^ ((2 : ℝ) / 3)) :=
                mul_le_mul_of_nonneg_left h_shell_sum
                  (mul_nonneg (mul_nonneg hC_sub (Real.rpow_nonneg hlam_nn _)) hN_pos.le)
            _ = (2 * C_sub * N) * ((2 * (K : ℝ)) ^ ((2 : ℝ) / 3) * lam ^ (-1 + ν / 2)) := by ring
            _ ≤ (2 * C_sub * N) * (M_ν * lam ^ (-1 + ν)) :=
                mul_le_mul_of_nonneg_left h_log_shell
                  (mul_nonneg (mul_nonneg (by norm_num) hC_sub) hN_pos.le)
            _ = 2 * C_sub * M_ν * lam ^ (-1 + ν) * N := by ring

  rw [h_op_decomp]
  have h_tri1 := MeasureTheory.eLpNorm_add_le (p := 3) (μ := MeasureTheory.volume)
    (f := E_lo + E_hi) (g := ∑ k ∈ S, a (k + 1) • E_k k) hp1
  have h_tri2 := MeasureTheory.eLpNorm_add_le (p := 3) (μ := MeasureTheory.volume)
    (f := E_lo) (g := E_hi) hp1
  have h_tri3 := MeasureTheory.eLpNorm_sum_le (p := 3) (μ := MeasureTheory.volume)
    (s := S) (f := fun k => a (k + 1) • E_k k) hp1
  have h_nn1 : 0 ≤ C_L1 * V_in * lam ^ (-1 + ν) * N :=
    mul_nonneg (mul_nonneg (mul_nonneg hC_L1_nn hV_in_nn) (Real.rpow_nonneg hlam_nn _)) hN_pos.le
  have h_nn2 : 0 ≤ C_L1 * lam ^ (-1 + ν) * N :=
    mul_nonneg (mul_nonneg hC_L1_nn (Real.rpow_nonneg hlam_nn _)) hN_pos.le
  have h_nn3 : 0 ≤ 2 * C_sub * M_ν * lam ^ (-1 + ν) * N :=
    mul_nonneg (mul_nonneg (mul_nonneg (mul_nonneg (by norm_num) hC_sub) hM_ν_nn)
      (Real.rpow_nonneg hlam_nn _)) hN_pos.le
  calc MeasureTheory.eLpNorm (E_lo + E_hi + ∑ k ∈ S, a (k + 1) • E_k k) 3 MeasureTheory.volume
      ≤ (MeasureTheory.eLpNorm E_lo 3 MeasureTheory.volume +
          MeasureTheory.eLpNorm E_hi 3 MeasureTheory.volume) +
          ∑ k ∈ S, MeasureTheory.eLpNorm (a (k + 1) • E_k k) 3 MeasureTheory.volume :=
        h_tri1.trans (add_le_add h_tri2 h_tri3)
    _ ≤ (ENNReal.ofReal (C_L1 * V_in * lam ^ (-1 + ν) * N) +
          ENNReal.ofReal (C_L1 * lam ^ (-1 + ν) * N)) +
          ENNReal.ofReal (2 * C_sub * M_ν * lam ^ (-1 + ν) * N) :=
        add_le_add (add_le_add h_el3_lo h_el3_hi) h_el3_shells
    _ = ENNReal.ofReal (((C_L1 * (V_in + 1) + 2 * C_sub * M_ν) * lam ^ (-1 + ν)) * N) := by
        rw [← ENNReal.ofReal_add h_nn1 h_nn2, ← ENNReal.ofReal_add (add_nonneg h_nn1 h_nn2) h_nn3]
        congr 1; ring
    _ ≤ ENNReal.ofReal ((C_osc * lam ^ (-1 + ν)) * N) := by
        apply ENNReal.ofReal_le_ofReal
        refine mul_le_mul_of_nonneg_right ?_ hN_pos.le
        exact mul_le_mul_of_nonneg_right (le_max_right _ _) (Real.rpow_nonneg hlam_nn _)
    _ = ENNReal.ofReal (C_osc * lam ^ (-1 + ν)) * MeasureTheory.eLpNorm f 3 MeasureTheory.volume := by
        rw [ENNReal.ofReal_mul (mul_nonneg hC_osc_nn (Real.rpow_nonneg hlam_nn _)), hN_ofReal]

theorem canonical_root_gram_decay (a₀ a₁ A : ℝ)
    (ha₀ : 0 < a₀) (ha₁ : a₀ ≤ a₁) (hA : 1 ≤ A) :
    ∃ C_pair : ℝ, 1 ≤ C_pair ∧
      ∀ (lam : ℝ), 2 ≤ lam →
      ∀ (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
        (ζ₀ : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → EuclideanSpace ℝ (Fin 2)),
        IsNormalizedPosDefPhase a₀ a₁ A Φ₀ ζ₀ →
      ∀ (ψ₁ ψ₂ : EuclideanSpace ℝ (Fin 2) → ℂ),
        IsCanonicalRootWindow ψ₁ →
        IsCanonicalRootWindow ψ₂ →
      ∀ (o₁ o₂ : (ℤ × ℤ) × (ℤ × ℤ)),
        (200 ≤ ‖gridPt2D 1 (o₁.1.1 - o₂.1.1, o₁.1.2 - o₂.1.2)‖ →
          ∫ v : EuclideanSpace ℝ (Fin 2),
            canonicalRootAtom lam Φ₀ ψ₁ o₁ v *
