          inner ℝ (perp2D ed) ed = 0 ∧
          ∀ w : EuclideanSpace ℝ (Fin 2),
            (w 0) ^ 2 + (w 1) ^ 2 = (inner ℝ w ed) ^ 2 + (inner ℝ w (perp2D ed)) ^ 2 := by
        let φ := ((g.2.1 : ℝ) + 1 / 2) * Real.pi *
