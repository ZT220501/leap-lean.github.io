          have hnz : ‖gridPt2D 1 p‖ ≠ 0 := hg_pos.ne'
          ext i
          simp [u_of_lat, g, w]
          field_simp [hnz]
          ring
        have h_norm_diff : |(K_net : ℝ) - ‖g‖| ≤ 1 := by
          rw [← hw_norm]
          exact le_trans (abs_norm_sub_norm_le w g) hwg_le1
        have h_num_le2 : ‖(g - w) + ((K_net : ℝ) - ‖g‖) • e_F‖ ≤ 2 := by
          calc ‖(g - w) + ((K_net : ℝ) - ‖g‖) • e_F‖
              ≤ ‖g - w‖ + ‖((K_net : ℝ) - ‖g‖) • e_F‖ := norm_add_le _ _
            _ = ‖w - g‖ + |(K_net : ℝ) - ‖g‖| * ‖e_F‖ := by
                rw [norm_sub_rev, norm_smul, Real.norm_eq_abs]
            _ ≤ 1 + 1 * 1 := by
                rw [he_F]
                linarith
            _ = 2 := by norm_num
        rw [h_id, norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hg_pos)]
        have h_inv_le : ‖g‖⁻¹ ≤ (8 * ε ^ (-W_max))⁻¹ :=
          (inv_le_inv₀ hg_pos (by positivity)).mpr hg_ge.le
        calc ‖g‖⁻¹ * ‖(g - w) + ((K_net : ℝ) - ‖g‖) • e_F‖
            ≤ (8 * ε ^ (-W_max))⁻¹ * 2 :=
              mul_le_mul h_inv_le h_num_le2 (norm_nonneg _) (by positivity)
          _ = (1 / 4) * ε ^ W_max := by
              rw [mul_inv, Real.rpow_neg hε₀.le, inv_inv]
              ring
      refine ⟨p, hp_mem, herr, ?_⟩
      rw [← h_perp_sub, h_perp_norm]
      exact herr

    let B_ctr : ℤ := (Nat.ceil (R_dom * ε ^ (-W_max)) : ℤ) + 2
    let I_ctr : Finset ℤ := Finset.Icc (-B_ctr) B_ctr
    let W_pairs : Finset (ℕ × ℕ) :=
      (Finset.range (N_w + 1) ×ˢ Finset.range (N_w + 1)).filter (fun ij => ij.1 ≤ ij.2)
    let CtrBox : Finset ((ℤ × ℤ) × (ℤ × ℤ)) := (I_ctr ×ˢ I_ctr) ×ˢ (I_ctr ×ˢ I_ctr)
    let MenuSet : Finset ((ℕ × ℕ) × (ℤ × ℤ) × ((ℤ × ℤ) × (ℤ × ℤ))) :=
      W_pairs ×ˢ (Lat_box ×ˢ CtrBox)
    have h0_Ictr : (0 : ℤ) ∈ I_ctr := by
      simp only [I_ctr, B_ctr, Finset.mem_Icc]
      omega
    have hMenu_ne : MenuSet.Nonempty := by
      refine ⟨((0, 0), (p_def, ((0, 0), (0, 0)))), ?_⟩
      simp only [MenuSet, W_pairs, CtrBox, Finset.mem_product, Finset.mem_filter, Finset.mem_range]
      exact ⟨⟨⟨by omega, by omega⟩, le_rfl⟩, hp_def_mem, ⟨h0_Ictr, h0_Ictr⟩, ⟨h0_Ictr, h0_Ictr⟩⟩

    let M_menu : ℕ := MenuSet.card
    have hM_pos : 1 ≤ M_menu := Finset.one_le_card.mpr hMenu_ne
    let eM : { x // x ∈ MenuSet } ≃ Fin M_menu := MenuSet.equivFin
    let tup_of : Fin M_menu → (ℕ × ℕ) × (ℤ × ℤ) × ((ℤ × ℤ) × (ℤ × ℤ)) :=
      fun κ => (eM.symm κ).1
    let ib_menu : Fin M_menu → ℕ := fun κ => (tup_of κ).1.1
    let ia_menu : Fin M_menu → ℕ := fun κ => (tup_of κ).1.2
    let e_menu : Fin M_menu → EuclideanSpace ℝ (Fin 2) := fun κ => u_of_lat (tup_of κ).2.1
    let V_menu : Fin M_menu → EuclideanSpace ℝ (Fin 2) := fun κ =>
      let u := u_of_lat (tup_of κ).2.1
      let nV := (tup_of κ).2.2.1
      ((nV.1 : ℝ) * ε ^ (w_of (ib_menu κ))) • u +
        ((nV.2 : ℝ) * ε ^ (w_of (ia_menu κ))) • perp2D u
    let X_menu : Fin M_menu → EuclideanSpace ℝ (Fin 2) := fun κ =>
      let u := u_of_lat (tup_of κ).2.1
      let nX := (tup_of κ).2.2.2
      ((nX.1 : ℝ) * ε ^ (w_of (ib_menu κ))) • u +
        ((nX.2 : ℝ) * ε ^ (w_of (ia_menu κ))) • perp2D u

    have h_round : ∀ (z v : EuclideanSpace ℝ (Fin 2)) (s : ℝ),
        ‖z‖ ≤ R_dom → ‖v‖ = 1 → ε ^ W_max ≤ s →
        let k := Int.floor (inner ℝ z v / s + 1 / 2)
        k ∈ I_ctr ∧ |inner ℝ z v - (k : ℝ) * s| ≤ s := by
      intro z v s hz hv hs
      have hs_pos : 0 < s := lt_of_lt_of_le hεW_pos hs
      let y := inner ℝ z v
      let k := Int.floor (y / s + 1 / 2)
      have hy_abs : |y| ≤ R_dom := by
        calc |y| ≤ ‖z‖ * ‖v‖ := abs_real_inner_le_norm z v
          _ = ‖z‖ := by rw [hv, mul_one]
          _ ≤ R_dom := hz
      have hys_abs : |y / s| ≤ (Nat.ceil (R_dom * ε ^ (-W_max)) : ℝ) := by
        rw [abs_div, abs_of_pos hs_pos]
        have h1 : |y| / s ≤ R_dom / (ε ^ W_max) :=
          div_le_div₀ (by linarith) hy_abs hεW_pos hs
        have h2 : R_dom / (ε ^ W_max) = R_dom * ε ^ (-W_max) := by
          rw [div_eq_mul_inv, Real.rpow_neg hε₀.le]
        exact le_trans h1 (h2 ▸ Nat.le_ceil _)
      obtain ⟨hys_lo, hys_hi⟩ := abs_le.mp hys_abs
      have hk_ge : -B_ctr ≤ k := by
        refine Int.le_floor.mpr ?_
        dsimp only [B_ctr]; push_cast; linarith
      have hk_lt : k < B_ctr + 1 := by
        refine Int.floor_lt.mpr ?_
        dsimp only [B_ctr]; push_cast; linarith
      have hk_le_fl : (k : ℝ) ≤ y / s + 1 / 2 := Int.floor_le _
      have hk_lt_fl : y / s + 1 / 2 < (k : ℝ) + 1 := Int.lt_floor_add_one _
      have herr_div : |y / s - (k : ℝ)| ≤ 1 / 2 := abs_le.mpr ⟨by linarith, by linarith⟩
      have herr_s : |y - (k : ℝ) * s| ≤ s := by
        have h_eq : y - (k : ℝ) * s = (y / s - (k : ℝ)) * s := by
          field_simp [hs_pos.ne']
        rw [h_eq, abs_mul, abs_of_pos hs_pos]
        have hm := mul_le_mul_of_nonneg_right herr_div hs_pos.le
        linarith
      dsimp only [k, y] at hk_ge hk_lt ⊢
      exact ⟨Finset.mem_Icc.mpr ⟨hk_ge, by omega⟩, herr_s⟩

    let n_of_atom : ℕ → ℕ → (ℤ × ℤ) → Fin N → ((ℤ × ℤ) × (ℤ × ℤ)) :=
      fun ib ia p α =>
        let u := u_of_lat p
        let sb := ε ^ (w_of ib)
        let sa := ε ^ (w_of ia)
        ((Int.floor (inner ℝ (V' α) u / sb + 1 / 2),
          Int.floor (inner ℝ (V' α) (perp2D u) / sa + 1 / 2)),
         (Int.floor (inner ℝ (X' α) u / sb + 1 / 2),
          Int.floor (inner ℝ (X' α) (perp2D u) / sa + 1 / 2)))

    have h_atom_tup : ∀ (ib ia : ℕ) (p : ℤ × ℤ) (α : Fin N),
        ib ≤ ia → ia ≤ N_w → p ∈ Lat_box →
        let tup := ((ib, ia), (p, n_of_atom ib ia p α))
        ∃ hmem : tup ∈ MenuSet,
          let κ := eM ⟨tup, hmem⟩
          ib_menu κ = ib ∧ ia_menu κ = ia ∧
          |inner ℝ (V' α - V_menu κ) (e_menu κ)| ≤ ε ^ (w_of (ib_menu κ)) ∧
          |inner ℝ (V' α - V_menu κ) (perp2D (e_menu κ))| ≤ ε ^ (w_of (ia_menu κ)) ∧
          |inner ℝ (X' α - X_menu κ) (e_menu κ)| ≤ ε ^ (w_of (ib_menu κ)) ∧
          |inner ℝ (X' α - X_menu κ) (perp2D (e_menu κ))| ≤ ε ^ (w_of (ia_menu κ)) := by
      intro ib ia p α hibia hiaNw hp
      let u := u_of_lat p
      have hu1 : ‖u‖ = 1 := hu_norm p hp
      have hpu1 : ‖perp2D u‖ = 1 := (h_perp_norm u).trans hu1
      have hsb_ge : ε ^ W_max ≤ ε ^ (w_of ib) :=
        Real.rpow_le_rpow_of_exponent_ge hε₀ hε_lt1.le (hw_le_max ib)
      have hsa_ge : ε ^ W_max ≤ ε ^ (w_of ia) :=
        Real.rpow_le_rpow_of_exponent_ge hε₀ hε_lt1.le (hw_le_max ia)
      obtain ⟨hm1, he1⟩ := h_round (V' α) u (ε ^ (w_of ib)) (h_dom α).1 hu1 hsb_ge
      obtain ⟨hm2, he2⟩ := h_round (V' α) (perp2D u) (ε ^ (w_of ia)) (h_dom α).1 hpu1 hsa_ge
      obtain ⟨hm3, he3⟩ := h_round (X' α) u (ε ^ (w_of ib)) (h_dom α).2 hu1 hsb_ge
      obtain ⟨hm4, he4⟩ := h_round (X' α) (perp2D u) (ε ^ (w_of ia)) (h_dom α).2 hpu1 hsa_ge
      have hmem : ((ib, ia), (p, n_of_atom ib ia p α)) ∈ MenuSet := by
        simp only [MenuSet, W_pairs, CtrBox, n_of_atom, Finset.mem_product, Finset.mem_filter,
          Finset.mem_range]
        exact ⟨⟨⟨by omega, by omega⟩, hibia⟩, hp, ⟨hm1, hm2⟩, ⟨hm3, hm4⟩⟩
      refine ⟨hmem, ?_⟩
      let κ := eM ⟨((ib, ia), (p, n_of_atom ib ia p α)), hmem⟩
      have htup_κ : tup_of κ = ((ib, ia), (p, n_of_atom ib ia p α)) := by
        dsimp only [tup_of, κ]
        rw [Equiv.symm_apply_apply]
      have hib_κ : ib_menu κ = ib := congr_arg (fun t => t.1.1) htup_κ
      have hia_κ : ia_menu κ = ia := congr_arg (fun t => t.1.2) htup_κ
      have he_κ : e_menu κ = u := by
        dsimp only [e_menu]; rw [htup_κ]
      have hV_κ : V_menu κ =
          (((n_of_atom ib ia p α).1.1 : ℝ) * ε ^ (w_of ib)) • u +
            (((n_of_atom ib ia p α).1.2 : ℝ) * ε ^ (w_of ia)) • perp2D u := by
        dsimp only [V_menu, ib_menu, ia_menu]; rw [htup_κ]
      have hX_κ : X_menu κ =
          (((n_of_atom ib ia p α).2.1 : ℝ) * ε ^ (w_of ib)) • u +
            (((n_of_atom ib ia p α).2.2 : ℝ) * ε ^ (w_of ia)) • perp2D u := by
        dsimp only [X_menu, ib_menu, ia_menu]; rw [htup_κ]
      obtain ⟨hVp1, hVp2⟩ := h_onb u hu1 (V' α)
        (((n_of_atom ib ia p α).1.1 : ℝ) * ε ^ (w_of ib))
        (((n_of_atom ib ia p α).1.2 : ℝ) * ε ^ (w_of ia))
      obtain ⟨hXp1, hXp2⟩ := h_onb u hu1 (X' α)
        (((n_of_atom ib ia p α).2.1 : ℝ) * ε ^ (w_of ib))
        (((n_of_atom ib ia p α).2.2 : ℝ) * ε ^ (w_of ia))
      refine ⟨hib_κ, hia_κ, ?_, ?_, ?_, ?_⟩
      · rw [hV_κ, he_κ, hib_κ, hVp1]; exact he1
      · rw [hV_κ, he_κ, hia_κ, hVp2]; exact he2
      · rw [hX_κ, he_κ, hib_κ, hXp1]; exact he3
      · rw [hX_κ, he_κ, hia_κ, hXp2]; exact he4

    refine ⟨M_menu, ib_menu, ia_menu, e_menu, V_menu, X_menu, hM_pos, ?_, ?_, ?_⟩
    · intro κ
      have hmem : tup_of κ ∈ MenuSet := (eM.symm κ).2
      simp only [MenuSet, W_pairs, Finset.mem_product, Finset.mem_filter, Finset.mem_range] at hmem
      have hibia : ib_menu κ ≤ ia_menu κ := hmem.1.2
      have hiaNw : ia_menu κ ≤ N_w := Nat.le_of_lt_succ hmem.1.1.2
      exact ⟨hibia, hiaNw, hw_nn (ib_menu κ), hw_mono hibia, hw_le_max (ia_menu κ),
        hu_norm _ hmem.2.1⟩
    · intro α
      obtain ⟨hmem, hib_κ, hia_κ, hc1, hc2, hc3, hc4⟩ :=
        h_atom_tup N_w N_w p_def α le_rfl le_rfl hp_def_mem
      refine ⟨eM ⟨_, hmem⟩, hib_κ, hia_κ, ?_, ?_, hc1, hc2, hc3, hc4⟩
      · dsimp only; rw [hib_κ, hw_Nw]
      · dsimp only; rw [hia_κ, hw_Nw]
    · intro b_F a_F R_F e_F V_F X_F S_F hb₀ hba haW hRF heF hSF
      by_cases hSF_ne : S_F.Nonempty
      · obtain ⟨α₀, hα₀⟩ := hSF_ne
        let ib := idx_w b_F
        let ia := idx_w a_F
        obtain ⟨hib_Nw, hwb_le, hwb_diff⟩ := h_idx_w b_F hb₀ (le_trans hba haW)
        obtain ⟨hia_Nw, hwa_le, hwa_diff⟩ := h_idx_w a_F (le_trans hb₀ hba) haW
        have hibia : ib ≤ ia := Nat.floor_mono ((div_le_div_iff_of_pos_right hδw).mpr hba)
        obtain ⟨p, hp_mem, hu_err, hpu_err⟩ := h_net_approx e_F heF
        let u := u_of_lat p
        have h_wt_loss : pktWeight γ b_F a_F - ξ / 2 ≤ pktWeight γ (w_of ib) (w_of ia) := by
          dsimp only [pktWeight]
          have h1 : (1 + γ) * (b_F - w_of ib) ≤ (1 + γ) * (ξ / 4) :=
            mul_le_mul_of_nonneg_left hwb_diff (by linarith)
          have h2 : (1 - γ) * (a_F - w_of ia) ≤ (1 - γ) * (ξ / 4) :=
            mul_le_mul_of_nonneg_left hwa_diff (by linarith)
          linarith

        let f_box : ((ℤ × ℤ) × (ℤ × ℤ)) → Fin M_menu := fun n =>
          letI := Classical.propDecidable
          if h : ((ib, ia), (p, n)) ∈ MenuSet then eM ⟨((ib, ia), (p, n)), h⟩
          else ⟨0, hM_pos⟩
        let M_cov : Finset (Fin M_menu) := S_F.image (fun α => f_box (n_of_atom ib ia p α))

        let D : ℝ := (2 + R_dom / 2) * R_F
        have hD_nn : 0 ≤ D := by positivity
        let R_int : ℤ := (Nat.ceil D : ℤ)
        let I_around : ℤ → Finset ℤ := fun k₀ => Finset.Icc (k₀ - R_int) (k₀ + R_int)
        have h_I_card : ∀ k₀ : ℤ, (I_around k₀).card = 2 * Nat.ceil D + 1 := by
          intro k₀
          simp only [I_around, R_int, Int.card_Icc]
          omega
        have h_shift_mem : ∀ (y y₀ s : ℝ), 0 < s → |y - y₀| ≤ D * s →
            Int.floor (y / s + 1 / 2) ∈ I_around (Int.floor (y₀ / s + 1 / 2)) := by
          intro y y₀ s hs_pos hy_diff
          have hdiv : |y / s - y₀ / s| ≤ (Nat.ceil D : ℝ) := by
            have h1 : |y / s - y₀ / s| = |y - y₀| / s := by
              rw [← sub_div, abs_div, abs_of_pos hs_pos]
            rw [h1]
            exact le_trans ((div_le_iff₀ hs_pos).mpr hy_diff) (Nat.le_ceil D)
          obtain ⟨hd_lo, hd_hi⟩ := abs_le.mp hdiv
          let k₀ := Int.floor (y₀ / s + 1 / 2)
          have hk₀_le : (k₀ : ℝ) ≤ y₀ / s + 1 / 2 := Int.floor_le _
          have hk₀_lt : y₀ / s + 1 / 2 < (k₀ : ℝ) + 1 := Int.lt_floor_add_one _
          refine Finset.mem_Icc.mpr ⟨?_, ?_⟩
          · refine Int.le_floor.mpr ?_
            dsimp only [R_int]; push_cast; linarith
          · have hlt : Int.floor (y / s + 1 / 2) < k₀ + R_int + 1 := by
              refine Int.floor_lt.mpr ?_
              dsimp only [R_int]; push_cast; linarith
            omega

        have h_proj_diff : ∀ (z z₀ C u_dir e_dir : EuclideanSpace ℝ (Fin 2)) (w_val w_grid : ℝ),
            ‖z‖ ≤ R_dom → ‖z₀‖ ≤ R_dom →
            |inner ℝ (z - C) e_dir| ≤ R_F * ε ^ w_val →
            |inner ℝ (z₀ - C) e_dir| ≤ R_F * ε ^ w_val →
            ‖u_dir - e_dir‖ ≤ (1 / 4) * ε ^ W_max →
            w_grid ≤ w_val → w_grid ≤ W_max →
            |inner ℝ z u_dir - inner ℝ z₀ u_dir| ≤ D * ε ^ w_grid := by
          intro z z₀ C u_dir e_dir w_val w_grid hz hz₀ hzc hz₀c hud hw1 hw2
          have hzz₀_norm : ‖z - z₀‖ ≤ 2 * R_dom := by
            calc ‖z - z₀‖ ≤ ‖z‖ + ‖z₀‖ := norm_sub_le z z₀
              _ ≤ R_dom + R_dom := add_le_add hz hz₀
              _ = 2 * R_dom := by ring
          have h_ediff : |inner ℝ (z - z₀) e_dir| ≤ 2 * R_F * ε ^ w_val := by
            have h_eq : z - z₀ = (z - C) - (z₀ - C) := by abel
            rw [h_eq, inner_sub_left]
            calc |inner ℝ (z - C) e_dir - inner ℝ (z₀ - C) e_dir|
                ≤ |inner ℝ (z - C) e_dir| + |inner ℝ (z₀ - C) e_dir| := abs_sub _ _
              _ ≤ R_F * ε ^ w_val + R_F * ε ^ w_val := add_le_add hzc hz₀c
              _ = 2 * R_F * ε ^ w_val := by ring
          have h_rem : |inner ℝ (z - z₀) (u_dir - e_dir)| ≤ (R_dom / 2) * ε ^ W_max := by
            calc |inner ℝ (z - z₀) (u_dir - e_dir)|
                ≤ ‖z - z₀‖ * ‖u_dir - e_dir‖ := abs_real_inner_le_norm _ _
              _ ≤ (2 * R_dom) * ((1 / 4) * ε ^ W_max) :=
                  mul_le_mul hzz₀_norm hud (norm_nonneg _) (by positivity)
              _ = (R_dom / 2) * ε ^ W_max := by ring
          have h_s1 : ε ^ w_val ≤ ε ^ w_grid :=
            Real.rpow_le_rpow_of_exponent_ge hε₀ hε_lt1.le hw1
          have h_s2 : ε ^ W_max ≤ ε ^ w_grid :=
            Real.rpow_le_rpow_of_exponent_ge hε₀ hε_lt1.le hw2
          have h_split : inner ℝ z u_dir - inner ℝ z₀ u_dir =
              inner ℝ (z - z₀) e_dir + inner ℝ (z - z₀) (u_dir - e_dir) := by
            rw [← inner_sub_left, ← inner_add_right, add_sub_cancel]
          rw [h_split]
          calc |inner ℝ (z - z₀) e_dir + inner ℝ (z - z₀) (u_dir - e_dir)|
              ≤ |inner ℝ (z - z₀) e_dir| + |inner ℝ (z - z₀) (u_dir - e_dir)| := abs_add_le _ _
            _ ≤ 2 * R_F * ε ^ w_val + (R_dom / 2) * ε ^ W_max := add_le_add h_ediff h_rem
            _ ≤ 2 * R_F * ε ^ w_grid + (R_dom / 2) * R_F * ε ^ w_grid := by
                refine add_le_add
                  (mul_le_mul_of_nonneg_left h_s1 (by positivity)) ?_
                calc (R_dom / 2) * ε ^ W_max
                    ≤ (R_dom / 2) * ε ^ w_grid := mul_le_mul_of_nonneg_left h_s2 (by positivity)
                  _ = (R_dom / 2) * 1 * ε ^ w_grid := by ring
                  _ ≤ (R_dom / 2) * R_F * ε ^ w_grid :=
                      mul_le_mul_of_nonneg_right
                        (mul_le_mul_of_nonneg_left hRF (by positivity))
                        (Real.rpow_pos_of_pos hε₀ w_grid).le
            _ = D * ε ^ w_grid := by dsimp only [D]; ring

        let n₀ := n_of_atom ib ia p α₀
        let BoxAround : Finset ((ℤ × ℤ) × (ℤ × ℤ)) :=
          (I_around n₀.1.1 ×ˢ I_around n₀.1.2) ×ˢ (I_around n₀.2.1 ×ˢ I_around n₀.2.2)
        have hMcov_sub : M_cov ⊆ BoxAround.image f_box := by
          intro κ hκ
          obtain ⟨α, hα, rfl⟩ := Finset.mem_image.mp hκ
          refine Finset.mem_image_of_mem f_box ?_
          obtain ⟨hcV1, hcV2, hcX1, hcX2⟩ := hSF α hα
          obtain ⟨hcV1₀, hcV2₀, hcX1₀, hcX2₀⟩ := hSF α₀ hα₀
          have hd1 := h_proj_diff (V' α) (V' α₀) V_F u e_F b_F (w_of ib)
            (h_dom α).1 (h_dom α₀).1 hcV1 hcV1₀ hu_err hwb_le (hw_le_max ib)
          have hd2 := h_proj_diff (V' α) (V' α₀) V_F (perp2D u) (perp2D e_F) a_F (w_of ia)
            (h_dom α).1 (h_dom α₀).1 hcV2 hcV2₀ hpu_err hwa_le (hw_le_max ia)
          have hd3 := h_proj_diff (X' α) (X' α₀) X_F u e_F b_F (w_of ib)
            (h_dom α).2 (h_dom α₀).2 hcX1 hcX1₀ hu_err hwb_le (hw_le_max ib)
          have hd4 := h_proj_diff (X' α) (X' α₀) X_F (perp2D u) (perp2D e_F) a_F (w_of ia)
            (h_dom α).2 (h_dom α₀).2 hcX2 hcX2₀ hpu_err hwa_le (hw_le_max ia)
          simp only [BoxAround, n_of_atom, n₀, Finset.mem_product]
          exact ⟨⟨h_shift_mem _ _ _ (Real.rpow_pos_of_pos hε₀ _) hd1,
                  h_shift_mem _ _ _ (Real.rpow_pos_of_pos hε₀ _) hd2⟩,
                 ⟨h_shift_mem _ _ _ (Real.rpow_pos_of_pos hε₀ _) hd3,
                  h_shift_mem _ _ _ (Real.rpow_pos_of_pos hε₀ _) hd4⟩⟩

        have hMcov_card : (M_cov.card : ℝ) ≤ (R_dom + 9) ^ 4 * R_F ^ 4 := by
          have hc_nat : M_cov.card ≤ (2 * Nat.ceil D + 1) ^ 4 := by
            calc M_cov.card ≤ (BoxAround.image f_box).card := Finset.card_le_card hMcov_sub
              _ ≤ BoxAround.card := Finset.card_image_le
              _ = ((2 * Nat.ceil D + 1) * (2 * Nat.ceil D + 1)) *
                    ((2 * Nat.ceil D + 1) * (2 * Nat.ceil D + 1)) := by
                  simp only [BoxAround, Finset.card_product, h_I_card]
              _ = (2 * Nat.ceil D + 1) ^ 4 := by ring
          have h1d : ((2 * Nat.ceil D + 1 : ℕ) : ℝ) ≤ (R_dom + 9) * R_F := by
            have hceil_lt : (Nat.ceil D : ℝ) < D + 1 := Nat.ceil_lt_add_one hD_nn
            push_cast
            dsimp only [D] at hceil_lt
            linarith
          calc (M_cov.card : ℝ) ≤ (((2 * Nat.ceil D + 1) ^ 4 : ℕ) : ℝ) := by exact_mod_cast hc_nat
            _ = ((2 * Nat.ceil D + 1 : ℕ) : ℝ) ^ 4 := by push_cast; rfl
            _ ≤ ((R_dom + 9) * R_F) ^ 4 := pow_le_pow_left₀ (by positivity) h1d 4
            _ = (R_dom + 9) ^ 4 * R_F ^ 4 := by ring

        refine ⟨M_cov, hMcov_card, ?_, ?_⟩
        · intro κ hκ
          obtain ⟨α, _, rfl⟩ := Finset.mem_image.mp hκ
          obtain ⟨hmem, hib_κ, hia_κ, _⟩ := h_atom_tup ib ia p α hibia hia_Nw hp_mem
          have hf_eq : f_box (n_of_atom ib ia p α) = eM ⟨_, hmem⟩ := dif_pos hmem
          rw [hf_eq]
          dsimp only
          rw [hib_κ, hia_κ]
          exact h_wt_loss
        · intro α hα
          obtain ⟨hmem, _, _, hc1, hc2, hc3, hc4⟩ := h_atom_tup ib ia p α hibia hia_Nw hp_mem
          have hf_eq : f_box (n_of_atom ib ia p α) = eM ⟨_, hmem⟩ := dif_pos hmem
          refine ⟨f_box (n_of_atom ib ia p α), Finset.mem_image_of_mem _ hα, ?_⟩
          rw [hf_eq]
          exact ⟨hc1, hc2, hc3, hc4⟩
      · rw [Finset.not_nonempty_iff_eq_empty] at hSF_ne
        subst hSF_ne
        refine ⟨∅, ?_, by simp, by simp⟩
        rw [Finset.card_empty, Nat.cast_zero]
        positivity

  
  have greedy_set_removal_and_grouping :
      ∀ (ε ξ W_lo W_hi Q_cnt : ℝ)
        (hε₀ : 0 < ε) (hε₁ : ε < 1 / 2) (hξ : 0 < ξ)
        (hW_lo : 0 ≤ W_lo) (_hW_hi : 0 ≤ W_hi) (_hQ_cnt : 0 ≤ Q_cnt)
        (N M_menu N_w : ℕ)
        (E : Fin M_menu → Finset (Fin N))
        (w : Fin M_menu → ℝ)
        (ib ia : Fin M_menu → ℕ)
        (B : Finset (Fin N))
        (hB_ne : B.Nonempty)
        (hB_card : (B.card : ℝ) ≤ ε ^ (-Q_cnt))
        (hw_bounds : ∀ κ : Fin M_menu,
          0 ≤ w κ ∧ w κ ≤ W_hi ∧ ib κ ≤ N_w ∧ ia κ ≤ N_w)
        (h_cover : ∀ α ∈ B, ∃ κ : Fin M_menu, α ∈ E κ ∧ W_lo ≤ w κ),
        ∃ (G_cnt : ℕ) (G_set : Fin G_cnt → Finset (Fin N))
          (g_idx_of ib_of ia_of : Fin G_cnt → ℕ)
          (step_of : Fin N → ℕ) (κ_of : Fin N → Fin M_menu),
          1 ≤ G_cnt ∧
          G_cnt ≤ (Nat.ceil ((Q_cnt + W_hi) / ξ) + 1) * (N_w + 1) ^ 2 ∧
          (∀ g : Fin G_cnt, (G_set g).Nonempty) ∧
          (∀ g₁ g₂ : Fin G_cnt, g₁ ≠ g₂ → Disjoint (G_set g₁) (G_set g₂)) ∧
          (Finset.univ.biUnion G_set = B) ∧
          (∀ g : Fin G_cnt,
            let g_bin := ((g_idx_of g : ℝ) + 1) * ξ
            W_lo < g_bin ∧
            g_idx_of g < Nat.ceil ((Q_cnt + W_hi) / ξ) + 1 ∧
            ib_of g ≤ N_w ∧ ia_of g ≤ N_w ∧
            (∀ α ∈ G_set g,
              α ∈ E (κ_of α) ∧
              ib (κ_of α) = ib_of g ∧
              ia (κ_of α) = ia_of g ∧
              (∀ α' ∈ G_set g, step_of α = step_of α' → κ_of α = κ_of α')) ∧
            (∀ κ : Fin M_menu,
              (((G_set g) ∩ (E κ)).card : ℝ) ≤ ε ^ (-g_bin + w κ)) ∧
            (∀ α ∈ G_set g,
              ε ^ (-g_bin + w (κ_of α) + ξ) ≤
                (((G_set g).filter (fun α' => step_of α' = step_of α)).card : ℝ))) := by
    clear anisotropic_cap_menu_and_covering hC_tr hM_mult hC_cut hd_dim hR_bud hξ hA₀
      C_tr_cut M_mult d_dim use_vel_sub C_cut R_bud ξ A₀ cls M_atom hγ₁ hγ₀ γ
    intro ε ξ W_lo W_hi Q_cnt hε₀ hε₁ hξ hW_lo _ _ N M_menu N_w E w ib ia B hB_ne hB_card hw_bounds h_cover
    let ell : ℝ := Real.log (ε⁻¹)
    have hε_inv_gt1 : 1 < ε⁻¹ := by
      rw [one_lt_inv₀ hε₀]
      linarith
    have hell_pos : 0 < ell := Real.log_pos hε_inv_gt1
    have hlogε : Real.log ε = -ell := by
      simp only [ell, Real.log_inv, neg_neg]
    have h_le_rpow : ∀ {x Z : ℝ}, 0 < x → Real.log x / ell ≤ Z → x ≤ ε ^ (-Z) := by
      intro x Z hx hZ
      have h1 : Real.log x ≤ Z * ell := (div_le_iff₀ hell_pos).mp hZ
      have h2 : Real.log x ≤ Real.log ε * (-Z) := by rw [hlogε]; linarith
      calc x = Real.exp (Real.log x) := (Real.exp_log hx).symm
        _ ≤ Real.exp (Real.log ε * (-Z)) := Real.exp_le_exp.mpr h2
        _ = ε ^ (-Z) := (Real.rpow_def_of_pos hε₀ (-Z)).symm
    have h_rpow_le : ∀ {x Z : ℝ}, 0 < x → Z ≤ Real.log x / ell → ε ^ (-Z) ≤ x := by
      intro x Z hx hZ
      have h1 : Z * ell ≤ Real.log x := (le_div_iff₀ hell_pos).mp hZ
      have h2 : Real.log ε * (-Z) ≤ Real.log x := by rw [hlogε]; linarith
      calc ε ^ (-Z) = Real.exp (Real.log ε * (-Z)) := Real.rpow_def_of_pos hε₀ (-Z)
        _ ≤ Real.exp (Real.log x) := Real.exp_le_exp.mpr h2
        _ = x := Real.exp_log hx

    let obj : Finset (Fin N) → Fin M_menu → ℝ :=
      fun S κ => Real.log (((S ∩ E κ).card : ℝ)) / ell + w κ

    have h_trace : ∀ (n : ℕ) (rem : Finset (Fin N)),
        rem ⊆ B → rem.card = n →
        ∃ (K : ℕ) (rem_seq : Fin K → Finset (Fin N)) (κ_seq : Fin K → Fin M_menu),
          (rem.Nonempty → 1 ≤ K) ∧
          (∀ t : Fin K, rem_seq t ⊆ rem) ∧
          (∀ t : Fin K, (rem_seq t ∩ E (κ_seq t)).Nonempty) ∧
          (∀ t : Fin K, ∀ κ : Fin M_menu, (rem_seq t ∩ E κ).Nonempty →
            obj (rem_seq t) κ ≤ obj (rem_seq t) (κ_seq t)) ∧
          (∀ t₁ t₂ : Fin K, t₁ ≤ t₂ → rem_seq t₂ ⊆ rem_seq t₁) ∧
          (∀ t₁ t₂ : Fin K, t₁ ≠ t₂ →
            Disjoint (rem_seq t₁ ∩ E (κ_seq t₁)) (rem_seq t₂ ∩ E (κ_seq t₂))) ∧
          (Finset.univ.biUnion (fun t : Fin K => rem_seq t ∩ E (κ_seq t)) = rem) := by
      intro n
      induction n using Nat.strong_induction_on with
      | h n ih =>
        intro rem hrem_sub hcard
        by_cases hrem_ne : rem.Nonempty
        · obtain ⟨α₀, hα₀⟩ := hrem_ne
          obtain ⟨κ_w, hα₀_E, _⟩ := h_cover α₀ (hrem_sub hα₀)
          let Cand : Finset (Fin M_menu) :=
            Finset.univ.filter (fun κ : Fin M_menu => (rem ∩ E κ).Nonempty)
          have hCand_ne : Cand.Nonempty :=
            ⟨κ_w, Finset.mem_filter.mpr ⟨Finset.mem_univ _,
              ⟨α₀, Finset.mem_inter.mpr ⟨hα₀, hα₀_E⟩⟩⟩⟩
          obtain ⟨κ₀, hκ₀_mem, hκ₀_max⟩ := Finset.exists_max_image Cand (obj rem) hCand_ne
          let F₀ : Finset (Fin N) := rem ∩ E κ₀
          have hF₀_ne : F₀.Nonempty := (Finset.mem_filter.mp hκ₀_mem).2
          let rem' : Finset (Fin N) := rem \ F₀
          have hrem'_sub : rem' ⊆ rem := Finset.sdiff_subset
          have hrem'_lt : rem'.card < n := by
            rw [← hcard]
            refine Finset.card_lt_card (Finset.ssubset_iff_subset_ne.mpr ⟨hrem'_sub, ?_⟩)
            intro heq
            obtain ⟨x, hx⟩ := hF₀_ne
            have hx_rem : x ∈ rem := (Finset.mem_inter.mp hx).1
            rw [← heq] at hx_rem
            exact (Finset.mem_sdiff.mp hx_rem).2 hx
          obtain ⟨K', rem_seq', κ_seq', _, hsub', hne', hmax', hmono', hdisj', hbiU'⟩ :=
            ih rem'.card hrem'_lt rem' (hrem'_sub.trans hrem_sub) rfl
          refine ⟨K' + 1, Fin.cons rem rem_seq', Fin.cons κ₀ κ_seq',
            fun _ => by omega, ?_, ?_, ?_, ?_, ?_, ?_⟩
          · intro t
            refine Fin.cases ?_ ?_ t
            · simp only [Fin.cons_zero]; exact Finset.Subset.rfl
            · intro i; simp only [Fin.cons_succ]; exact (hsub' i).trans hrem'_sub
          · intro t
            refine Fin.cases ?_ ?_ t
            · simp only [Fin.cons_zero]; exact hF₀_ne
            · intro i; simp only [Fin.cons_succ]; exact hne' i
          · intro t
            refine Fin.cases ?_ ?_ t
            · simp only [Fin.cons_zero]
              intro κ hκ_ne
              exact hκ₀_max κ (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hκ_ne⟩)
            · intro i; simp only [Fin.cons_succ]; exact hmax' i
          · intro t₁ t₂
            refine Fin.cases ?_ ?_ t₁
            · refine Fin.cases ?_ ?_ t₂
              · intro _; simp only [Fin.cons_zero]; exact Finset.Subset.rfl
              · intro j _; simp only [Fin.cons_zero, Fin.cons_succ]
                exact (hsub' j).trans hrem'_sub
            · intro i
              refine Fin.cases ?_ ?_ t₂
              · intro hle
                exfalso
                have hval : (i.succ : ℕ) ≤ (0 : Fin (K' + 1)).1 := hle
                simp at hval
              · intro j hle
                simp only [Fin.cons_succ]
                exact hmono' i j (Fin.succ_le_succ_iff.mp hle)
          · intro t₁ t₂
            refine Fin.cases ?_ ?_ t₁
            · refine Fin.cases ?_ ?_ t₂
              · intro hne_t; exact False.elim (hne_t rfl)
              · intro j _
                simp only [Fin.cons_zero, Fin.cons_succ]
                rw [Finset.disjoint_left]
                intro x hx₀ hxj
                have hxj_rem' : x ∈ rem' := hsub' j (Finset.mem_inter.mp hxj).1
                exact (Finset.mem_sdiff.mp hxj_rem').2 hx₀
            · intro i
              refine Fin.cases ?_ ?_ t₂
              · intro _
                simp only [Fin.cons_zero, Fin.cons_succ]
                rw [Finset.disjoint_left]
                intro x hxi hx₀
                have hxi_rem' : x ∈ rem' := hsub' i (Finset.mem_inter.mp hxi).1
                exact (Finset.mem_sdiff.mp hxi_rem').2 hx₀
              · intro j hne_t
                simp only [Fin.cons_succ]
                exact hdisj' i j (fun hij => hne_t (congr_arg Fin.succ hij))
          · ext x
            simp only [Finset.mem_biUnion, Finset.mem_univ, true_and, Fin.exists_fin_succ,
              Fin.cons_zero, Fin.cons_succ]
            have h_tail : (∃ i : Fin K', x ∈ rem_seq' i ∩ E (κ_seq' i)) ↔ x ∈ rem' := by
              rw [← hbiU']
              simp only [Finset.mem_biUnion, Finset.mem_univ, true_and]
            rw [h_tail]
            constructor
            · rintro (hx₀ | hx')
              · exact (Finset.mem_inter.mp hx₀).1
              · exact hrem'_sub hx'
            · intro hx_rem
              by_cases hx₀ : x ∈ F₀
              · exact Or.inl hx₀
              · exact Or.inr (Finset.mem_sdiff.mpr ⟨hx_rem, hx₀⟩)
        · rw [Finset.not_nonempty_iff_eq_empty] at hrem_ne
          subst hrem_ne
          refine ⟨0, Fin.elim0, Fin.elim0,
            fun h => False.elim (Finset.not_nonempty_empty h),
            fun t => Fin.elim0 t, fun t => Fin.elim0 t, fun t => Fin.elim0 t,
            fun t₁ => Fin.elim0 t₁, fun t₁ => Fin.elim0 t₁, by simp⟩

    obtain ⟨K, rem_seq, κ_seq, hK_ne, hrem_sub, hF_ne, hobj_max, hrem_mono, hF_disj, hF_biU⟩ :=
      h_trace B.card B Finset.Subset.rfl rfl
    have hK_pos : 1 ≤ K := hK_ne hB_ne
    let F_seq : Fin K → Finset (Fin N) := fun t => rem_seq t ∩ E (κ_seq t)
    let μ : Fin K → ℝ := fun t => obj (rem_seq t) (κ_seq t)
    let g_idx : Fin K → ℕ := fun t => Nat.floor (μ t / ξ)

    have hμ_bounds : ∀ t : Fin K,
        W_lo ≤ μ t ∧
        (g_idx t : ℝ) * ξ ≤ μ t ∧
        μ t < ((g_idx t : ℝ) + 1) * ξ ∧
        g_idx t < Nat.ceil ((Q_cnt + W_hi) / ξ) + 1 := by
      intro t
      obtain ⟨α₀, hα₀_F⟩ := hF_ne t
      have hα₀_rem : α₀ ∈ rem_seq t := (Finset.mem_inter.mp hα₀_F).1
      obtain ⟨κ_w, hα₀_Ew, hW_lo_w⟩ := h_cover α₀ (hrem_sub t hα₀_rem)
      have h_inter_ne : (rem_seq t ∩ E κ_w).Nonempty := ⟨α₀, Finset.mem_inter.mpr ⟨hα₀_rem, hα₀_Ew⟩⟩
      have h_card_ge1 : (1 : ℝ) ≤ ((rem_seq t ∩ E κ_w).card : ℝ) := by
        exact_mod_cast Finset.one_le_card.mpr h_inter_ne
      have h_log_nn : 0 ≤ Real.log (((rem_seq t ∩ E κ_w).card : ℝ)) / ell :=
        div_nonneg (Real.log_nonneg h_card_ge1) hell_pos.le
      have hμ_ge : W_lo ≤ μ t := by
        have hmax := hobj_max t κ_w h_inter_ne
        dsimp only [μ, obj] at hmax ⊢
        linarith
      have hμ_nn : 0 ≤ μ t := le_trans hW_lo hμ_ge
      have hg_le : (g_idx t : ℝ) * ξ ≤ μ t :=
        (le_div_iff₀ hξ).mp (Nat.floor_le (div_nonneg hμ_nn hξ.le))
      have hg_lt : μ t < ((g_idx t : ℝ) + 1) * ξ :=
        (div_lt_iff₀ hξ).mp (Nat.lt_floor_add_one (μ t / ξ))
      have hFt_ge1 : (1 : ℝ) ≤ ((F_seq t).card : ℝ) := by
        exact_mod_cast Finset.one_le_card.mpr (hF_ne t)
      have hFt_le_B : ((F_seq t).card : ℝ) ≤ (B.card : ℝ) := by
        exact_mod_cast Finset.card_le_card (Finset.inter_subset_left.trans (hrem_sub t))
      have hFt_le_Q : ((F_seq t).card : ℝ) ≤ ε ^ (-Q_cnt) := le_trans hFt_le_B hB_card
      have hlog_Q : Real.log (((F_seq t).card : ℝ)) / ell ≤ Q_cnt := by
        have hlog_le := Real.log_le_log (by linarith) hFt_le_Q
        rw [Real.log_rpow hε₀, hlogε] at hlog_le
        rw [div_le_iff₀ hell_pos]
        linarith
      have hw_hi : w (κ_seq t) ≤ W_hi := (hw_bounds (κ_seq t)).2.1
      have hμ_hi : μ t ≤ Q_cnt + W_hi := by
        dsimp only [μ, obj, F_seq]
        linarith
      have hdiv_hi : μ t / ξ ≤ (Nat.ceil ((Q_cnt + W_hi) / ξ) : ℝ) :=
        le_trans ((div_le_div_iff_of_pos_right hξ).mpr hμ_hi) (Nat.le_ceil _)
      have hg_ceil : g_idx t ≤ Nat.ceil ((Q_cnt + W_hi) / ξ) := by
        have hfl := Nat.floor_mono hdiv_hi
        rwa [Nat.floor_natCast] at hfl
      exact ⟨hμ_ge, hg_le, hg_lt, Nat.lt_succ_of_le hg_ceil⟩

    have hB_ex_t : ∀ α : Fin N, α ∈ B → ∃ t : Fin K, α ∈ F_seq t := by
      intro α hα
      rw [← hF_biU] at hα
      simpa only [Finset.mem_biUnion, Finset.mem_univ, true_and] using hα

    let t_default : Fin K := ⟨0, hK_pos⟩
    let step_fin : Fin N → Fin K := fun α =>
      letI := Classical.propDecidable
      if hα : α ∈ B then Classical.choose (hB_ex_t α hα) else t_default
    have hstep_fin_eq : ∀ (t : Fin K) (α : Fin N), α ∈ F_seq t → step_fin α = t := by
      intro t α hαF
      have hαB : α ∈ B := hrem_sub t (Finset.mem_inter.mp hαF).1
      have h_ch : step_fin α = Classical.choose (hB_ex_t α hαB) := dif_pos hαB
      rw [h_ch]
      have hα_ch : α ∈ F_seq (Classical.choose (hB_ex_t α hαB)) :=
        Classical.choose_spec (hB_ex_t α hαB)
      by_contra hne
      exact Finset.disjoint_left.mp (hF_disj _ _ hne) hα_ch hαF

    let step_of : Fin N → ℕ := fun α => (step_fin α).1
    let κ_of : Fin N → Fin M_menu := fun α => κ_seq (step_fin α)

    let key : Fin K → ℕ × (ℕ × ℕ) := fun t => (g_idx t, (ib (κ_seq t), ia (κ_seq t)))
    let Keys : Finset (ℕ × (ℕ × ℕ)) := Finset.univ.image key
    have hKeys_ne : Keys.Nonempty := ⟨key t_default, Finset.mem_image_of_mem key (Finset.mem_univ _)⟩
    let G_cnt : ℕ := Keys.card
    have hG_pos : 1 ≤ G_cnt := Finset.one_le_card.mpr hKeys_ne
    let BoxK : Finset (ℕ × (ℕ × ℕ)) :=
      Finset.range (Nat.ceil ((Q_cnt + W_hi) / ξ) + 1) ×ˢ
        (Finset.range (N_w + 1) ×ˢ Finset.range (N_w + 1))
    have hKeys_sub : Keys ⊆ BoxK := by
      intro k hk
      obtain ⟨t, _, rfl⟩ := Finset.mem_image.mp hk
      simp only [BoxK, key, Finset.mem_product, Finset.mem_range]
      exact ⟨(hμ_bounds t).2.2.2,
        ⟨Nat.lt_succ_of_le (hw_bounds (κ_seq t)).2.2.1,
         Nat.lt_succ_of_le (hw_bounds (κ_seq t)).2.2.2⟩⟩
    have hG_le : G_cnt ≤ (Nat.ceil ((Q_cnt + W_hi) / ξ) + 1) * (N_w + 1) ^ 2 := by
      calc G_cnt ≤ BoxK.card := Finset.card_le_card hKeys_sub
        _ = (Nat.ceil ((Q_cnt + W_hi) / ξ) + 1) * ((N_w + 1) * (N_w + 1)) := by
            simp only [BoxK, Finset.card_product, Finset.card_range]
        _ = (Nat.ceil ((Q_cnt + W_hi) / ξ) + 1) * (N_w + 1) ^ 2 := by ring

    let eK : { x // x ∈ Keys } ≃ Fin G_cnt := Keys.equivFin
    let k_of_g : Fin G_cnt → ℕ × (ℕ × ℕ) := fun g => (eK.symm g).1
    let g_idx_of : Fin G_cnt → ℕ := fun g => (k_of_g g).1
    let ib_of : Fin G_cnt → ℕ := fun g => (k_of_g g).2.1
    let ia_of : Fin G_cnt → ℕ := fun g => (k_of_g g).2.2
    let T_g : Fin G_cnt → Finset (Fin K) :=
      fun g => Finset.univ.filter (fun t : Fin K => key t = k_of_g g)
    have hTg_ne : ∀ g : Fin G_cnt, (T_g g).Nonempty := by
      intro g
      have hk_mem : k_of_g g ∈ Keys := (eK.symm g).2
      obtain ⟨t, _, ht⟩ := Finset.mem_image.mp hk_mem
      exact ⟨t, Finset.mem_filter.mpr ⟨Finset.mem_univ _, ht⟩⟩
    let G_set : Fin G_cnt → Finset (Fin N) := fun g => (T_g g).biUnion F_seq

    refine ⟨G_cnt, G_set, g_idx_of, ib_of, ia_of, step_of, κ_of,
      hG_pos, hG_le, ?_, ?_, ?_, ?_⟩
    · intro g
      obtain ⟨t₀, ht₀⟩ := hTg_ne g
      obtain ⟨α₀, hα₀⟩ := hF_ne t₀
      exact ⟨α₀, Finset.mem_biUnion.mpr ⟨t₀, ht₀, hα₀⟩⟩
    · intro g₁ g₂ hne
      rw [Finset.disjoint_left]
      intro α hα₁ hα₂
      obtain ⟨t₁, ht₁, hαF₁⟩ := Finset.mem_biUnion.mp hα₁
      obtain ⟨t₂, ht₂, hαF₂⟩ := Finset.mem_biUnion.mp hα₂
      have ht_eq : t₁ = t₂ := by
        by_contra ht_ne
        exact Finset.disjoint_left.mp (hF_disj t₁ t₂ ht_ne) hαF₁ hαF₂
      subst ht_eq
      have hk₁ : key t₁ = k_of_g g₁ := (Finset.mem_filter.mp ht₁).2
      have hk₂ : key t₁ = k_of_g g₂ := (Finset.mem_filter.mp ht₂).2
      have hsub_eq : eK.symm g₁ = eK.symm g₂ := Subtype.ext (hk₁.symm.trans hk₂)
      exact hne (eK.symm.injective hsub_eq)
    · ext α
      simp only [G_set, Finset.mem_biUnion, Finset.mem_univ, true_and]
      constructor
      · rintro ⟨_, t, _, hαF⟩
        exact hrem_sub t (Finset.mem_inter.mp hαF).1
      · intro hαB
        obtain ⟨t, hαF⟩ := hB_ex_t α hαB
        have hk_mem : key t ∈ Keys := Finset.mem_image_of_mem key (Finset.mem_univ t)
        let g : Fin G_cnt := eK ⟨key t, hk_mem⟩
        have hkg : k_of_g g = key t := by
          dsimp only [k_of_g, g]
          rw [Equiv.symm_apply_apply]
        refine ⟨g, t, Finset.mem_filter.mpr ⟨Finset.mem_univ t, hkg.symm⟩, hαF⟩
    · intro g
      let g_bin : ℝ := ((g_idx_of g : ℝ) + 1) * ξ
      let t_first : Fin K := (T_g g).min' (hTg_ne g)
      have ht_first_mem : t_first ∈ T_g g := Finset.min'_mem (T_g g) (hTg_ne g)
      have hkey_first : key t_first = k_of_g g := (Finset.mem_filter.mp ht_first_mem).2
      have hg_first : g_idx t_first = g_idx_of g := congr_arg Prod.fst hkey_first
      have hib_first : ib (κ_seq t_first) = ib_of g :=
        congr_arg (fun p => p.2.1) hkey_first
      have hia_first : ia (κ_seq t_first) = ia_of g :=
        congr_arg (fun p => p.2.2) hkey_first
      obtain ⟨hW_lo_first, _, hμ_lt_first, hg_ceil_first⟩ := hμ_bounds t_first
      rw [hg_first] at hμ_lt_first hg_ceil_first
      refine ⟨lt_of_le_of_lt hW_lo_first hμ_lt_first, hg_ceil_first,
        hib_first ▸ (hw_bounds (κ_seq t_first)).2.2.1,
        hia_first ▸ (hw_bounds (κ_seq t_first)).2.2.2, ?_, ?_, ?_⟩
      · intro α hαG
        obtain ⟨t, ht_mem, hαF⟩ := Finset.mem_biUnion.mp hαG
        have hkey_t : key t = k_of_g g := (Finset.mem_filter.mp ht_mem).2
        have hsf_α : step_fin α = t := hstep_fin_eq t α hαF
        have hκ_α : κ_of α = κ_seq t := congr_arg κ_seq hsf_α
        refine ⟨hκ_α ▸ (Finset.mem_inter.mp hαF).2,
          (congr_arg ib hκ_α).trans (congr_arg (fun p => p.2.1) hkey_t),
          (congr_arg ia hκ_α).trans (congr_arg (fun p => p.2.2) hkey_t), ?_⟩
        intro α' _ hstep_eq
        have hsf_eq : step_fin α = step_fin α' := Fin.ext hstep_eq
        exact congr_arg κ_seq hsf_eq
      · intro κ
        have hG_sub_first : G_set g ⊆ rem_seq t_first := by
          intro x hxG
          obtain ⟨t, ht_mem, hxF⟩ := Finset.mem_biUnion.mp hxG
          have hle_t : t_first ≤ t := Finset.min'_le (T_g g) t ht_mem
          exact hrem_mono t_first t hle_t (Finset.mem_inter.mp hxF).1
        have h_inter_sub : G_set g ∩ E κ ⊆ rem_seq t_first ∩ E κ :=
          fun x hx => Finset.mem_inter.mpr
            ⟨hG_sub_first (Finset.mem_inter.mp hx).1, (Finset.mem_inter.mp hx).2⟩
        by_cases h_ne_κ : (rem_seq t_first ∩ E κ).Nonempty
        · have h_card_pos : (0 : ℝ) < (((rem_seq t_first ∩ E κ).card : ℝ)) := by
            exact_mod_cast Finset.card_pos.mpr h_ne_κ
          have hmax_κ := hobj_max t_first κ h_ne_κ
          have hlog_le : Real.log (((rem_seq t_first ∩ E κ).card : ℝ)) / ell ≤ g_bin - w κ := by
            dsimp only [μ, obj, g_bin] at hmax_κ hμ_lt_first ⊢
            linarith
          have hrpow := h_le_rpow h_card_pos hlog_le
          have hexp_eq : -(g_bin - w κ) = -g_bin + w κ := by ring
          rw [hexp_eq] at hrpow
          have hcard_le : (((G_set g ∩ E κ).card : ℝ)) ≤ (((rem_seq t_first ∩ E κ).card : ℝ)) := by
            exact_mod_cast Finset.card_le_card h_inter_sub
          exact le_trans hcard_le hrpow
        · rw [Finset.not_nonempty_iff_eq_empty] at h_ne_κ
          have hemp : G_set g ∩ E κ = ∅ := Finset.subset_empty.mp (h_inter_sub.trans (by rw [h_ne_κ]))
          rw [hemp, Finset.card_empty, Nat.cast_zero]
          exact Real.rpow_nonneg hε₀.le _
      · intro α hαG
        obtain ⟨t, ht_mem, hαF⟩ := Finset.mem_biUnion.mp hαG
        have hkey_t : key t = k_of_g g := (Finset.mem_filter.mp ht_mem).2
        have hg_t : g_idx t = g_idx_of g := congr_arg Prod.fst hkey_t
        have hsf_α : step_fin α = t := hstep_fin_eq t α hαF
        have hκ_α : κ_of α = κ_seq t := congr_arg κ_seq hsf_α
        have hfib_eq : (G_set g).filter (fun α' => step_of α' = step_of α) = F_seq t := by
          ext α'
          simp only [Finset.mem_filter]
          constructor
          · rintro ⟨hα'G, hstep_eq⟩
            obtain ⟨t', _, hα'F'⟩ := Finset.mem_biUnion.mp hα'G
            have hsf_α' : step_fin α' = t' := hstep_fin_eq t' α' hα'F'
            have ht'_eq : t' = t := by
              apply Fin.ext
              calc (t' : ℕ) = step_of α' := congr_arg Fin.val hsf_α'.symm
                _ = step_of α := hstep_eq
                _ = (t : ℕ) := congr_arg Fin.val hsf_α
            rwa [← ht'_eq]
          · intro hα'F
            refine ⟨Finset.mem_biUnion.mpr ⟨t, ht_mem, hα'F⟩, ?_⟩
            have hsf_α' : step_fin α' = t := hstep_fin_eq t α' hα'F
            dsimp only [step_of]
            rw [hsf_α', hsf_α]
        rw [hfib_eq, hκ_α]
        have hFt_pos : (0 : ℝ) < (((F_seq t).card : ℝ)) := by
          exact_mod_cast Finset.card_pos.mpr (hF_ne t)
        have hg_le_t := (hμ_bounds t).2.1
        rw [hg_t] at hg_le_t
        have hlog_ge : g_bin - w (κ_seq t) - ξ ≤ Real.log (((F_seq t).card : ℝ)) / ell := by
          dsimp only [μ, obj, F_seq, g_bin] at hg_le_t ⊢
          linarith
        have hrpow := h_rpow_le hFt_pos hlog_ge
        have hexp_eq : -(g_bin - w (κ_seq t) - ξ) = -g_bin + w (κ_seq t) + ξ := by ring
        rwa [hexp_eq] at hrpow

  
  have two_stage_velocity_subdivision :
      ∀ (ε H_P t r h ξ Q_cnt : ℝ)
        (d_dim M_L N q_r : ℕ)
        (τ_V τ_X : EuclideanSpace ℝ (Fin 2))
        (n_buf : (ℕ × (ℤ × ℤ) × (ℤ × ℤ)) → EuclideanSpace ℝ (Fin 2))
        (V_at X_at e_at : Fin N → EuclideanSpace ℝ (Fin 2))
        (W_all : Finset (Fin N))
        (hε₀ : 0 < ε) (hε₁ : ε < 1 / 2)
        (hξ : 0 < ξ) (hh : 0 < h) (hr_eq : r = t - 2 * h) (_hQ_cnt : 0 ≤ Q_cnt)
        (hd_dim : d_dim = 1 ∨ d_dim = 2) (hML : 1 ≤ M_L)
        (hn_buf : ∀ p_c, ‖n_buf p_c‖ = 1)
        (h_log16 : Real.log 16 / Real.log (ε⁻¹) ≤ ξ)
        (hW_ne : W_all.Nonempty)
        (hW_card : (W_all.card : ℝ) ≤ ε ^ (-Q_cnt)),
        let n_fine := fun p_c => n_buf (coarseOfFineCell M_L p_c)
        let p_of := fun α : Fin N => atomOutCell ε H_P t r τ_V τ_X q_r (V_at α) (X_at α)
        let w_of := fun α : Fin N => fineVelBin ε H_P t r d_dim τ_V n_fine (p_of α) (V_at α)
        ∃ (U_cnt : ℕ) (R_set : Fin U_cnt → Finset (Fin N))
          (al_of : Fin U_cnt → Bool) (mk_of : Fin U_cnt → ℕ),
          1 ≤ U_cnt ∧
          U_cnt ≤ 2 * (Nat.ceil (Q_cnt / ξ) + 1) * (Nat.ceil (((d_dim : ℝ) * h) / ξ) + 3) ∧
          (∀ u : Fin U_cnt, (R_set u).Nonempty) ∧
          (∀ u₁ u₂ : Fin U_cnt, u₁ ≠ u₂ → Disjoint (R_set u₁) (R_set u₂)) ∧
          (Finset.univ.biUnion R_set = W_all) ∧
          (∀ u : Fin U_cnt,
            let k_bin := (mk_of u : ℝ) * ξ
            mk_of u < Nat.ceil (((d_dim : ℝ) * h) / ξ) + 3 ∧
            (d_dim = 1 → ∀ α ∈ R_set u,
              (al_of u = true ↔
                projAngleDist (perp2D (e_at α)) (n_fine (p_of α)) ≤ 2 * ε ^ h)) ∧
            (∀ p_c w,
              (((R_set u).filter (fun α => p_of α = p_c ∧ w_of α = w)).card : ℝ) ≤
                ε ^ (k_bin - ξ) * (((R_set u).filter (fun α => p_of α = p_c)).card : ℝ)) ∧
            (∀ p_buf,
              ((((R_set u).image (fun α => (p_of α, w_of α))).filter
                (fun pw => coarseOfFineCell M_L pw.1 = p_buf)).card : ℝ) ≤
                ((M_L ^ 4 : ℕ) : ℝ) * ε ^ (-(k_bin + ξ)))) := by
    clear greedy_set_removal_and_grouping anisotropic_cap_menu_and_covering
      hC_tr hM_mult hC_cut hd_dim hR_bud hξ hA₀ C_tr_cut M_mult d_dim use_vel_sub
      C_cut R_bud ξ A₀ cls M_atom hγ₁ hγ₀ γ
    intro ε H_P t r h ξ Q_cnt d_dim M_L N q_r τ_V τ_X n_buf V_at X_at e_at W_all
      hε₀ hε₁ hξ hh hr_eq _ hd_dim hML hn_buf h_log16 hW_ne hW_card n_fine p_of w_of
    let ell : ℝ := Real.log (ε⁻¹)
    have hε_lt1 : ε < 1 := by linarith
    have hε_inv_gt1 : 1 < ε⁻¹ := by rw [one_lt_inv₀ hε₀]; linarith
    have hell_pos : 0 < ell := Real.log_pos hε_inv_gt1
    have hlogε : Real.log ε = -ell := by simp only [ell, Real.log_inv, neg_neg]
    have h_le_rpow : ∀ {x Z : ℝ}, 0 < x → Real.log x / ell ≤ Z → x ≤ ε ^ (-Z) := by
      intro x Z hx hZ
      have h1 : Real.log x ≤ Z * ell := (div_le_iff₀ hell_pos).mp hZ
      have h2 : Real.log x ≤ Real.log ε * (-Z) := by rw [hlogε]; linarith
      calc x = Real.exp (Real.log x) := (Real.exp_log hx).symm
        _ ≤ Real.exp (Real.log ε * (-Z)) := Real.exp_le_exp.mpr h2
        _ = ε ^ (-Z) := (Real.rpow_def_of_pos hε₀ (-Z)).symm
    have h_rpow_le : ∀ {x Z : ℝ}, 0 < x → Z ≤ Real.log x / ell → ε ^ (-Z) ≤ x := by
      intro x Z hx hZ
      have h1 : Z * ell ≤ Real.log x := (le_div_iff₀ hell_pos).mp hZ
      have h2 : Real.log ε * (-Z) ≤ Real.log x := by rw [hlogε]; linarith
      calc ε ^ (-Z) = Real.exp (Real.log ε * (-Z)) := Real.rpow_def_of_pos hε₀ (-Z)
        _ ≤ Real.exp (Real.log x) := Real.exp_le_exp.mpr h2
        _ = x := Real.exp_log hx

    let u_t : ℝ := (H_P - t) / 2
    let u_r : ℝ := (H_P - r) / 2
    let s_t : ℝ := ε ^ u_t
    let s_r : ℝ := ε ^ u_r
    have hs_t_pos : 0 < s_t := Real.rpow_pos_of_pos hε₀ u_t
    have hs_r_pos : 0 < s_r := Real.rpow_pos_of_pos hε₀ u_r
    have hur_eq : u_r = u_t + h := by dsimp only [u_r, u_t]; rw [hr_eq]; ring
    have hst_div_sr : s_t / s_r = ε ^ (-h) := by
      dsimp only [s_t, s_r]
      rw [hur_eq, Real.rpow_add hε₀, div_mul_eq_div_div, div_self hs_t_pos.ne',
        one_div, ← Real.rpow_neg hε₀.le]
    have hεnegh_gt1 : 1 < ε ^ (-h) := by
      calc (1 : ℝ) = ε ^ (0 : ℝ) := (Real.rpow_zero ε).symm
        _ < ε ^ (-h) := Real.rpow_lt_rpow_of_exponent_gt hε₀ hε_lt1 (by linarith)

    have h_w_per_pc : ∀ (p_c : ℕ × (ℤ × ℤ) × (ℤ × ℤ)) (S : Finset (Fin N)),
        (∀ α ∈ S, p_of α = p_c) →
        (((S.image w_of).card : ℝ)) ≤ 16 * ε ^ (-((d_dim : ℝ) * h)) := by
      intro p_c S hS_pc
      have hv_rel_coords : ∀ α ∈ S,
          let v_rel := V_at α - fineCellCenterV s_t τ_V p_c.2.1
          |v_rel 0| ≤ (1 / 2) * s_t ∧ |v_rel 1| ≤ (1 / 2) * s_t ∧ ‖v_rel‖ ≤ s_t := by
        intro α hα v_rel
        have hp_eq : p_of α = p_c := hS_pc α hα
        have hk_eq : roundShift2D s_t τ_V (V_at α) = p_c.2.1 := by
          have := congr_arg (fun p => p.2.1) hp_eq
          simpa only [p_of, atomOutCell, s_t, u_t] using this
        have hk0 : p_c.2.1.1 = Int.floor (((V_at α) 0 - τ_V 0) / s_t) := by
          rw [← hk_eq]; rfl
        have hk1 : p_c.2.1.2 = Int.floor (((V_at α) 1 - τ_V 1) / s_t) := by
          rw [← hk_eq]; rfl
        have h_1d : ∀ (z τ_i : ℝ) (k : ℤ), k = Int.floor ((z - τ_i) / s_t) →
            |z - (τ_i + s_t * (k : ℝ) + 1 / 2 * s_t)| ≤ (1 / 2) * s_t := by
          intro z τ_i k hk
          have hle : (k : ℝ) ≤ (z - τ_i) / s_t := hk ▸ Int.floor_le _
          have hlt : (z - τ_i) / s_t < (k : ℝ) + 1 := hk ▸ Int.lt_floor_add_one _
          have hm1 : s_t * (k : ℝ) ≤ z - τ_i := by
            have := (le_div_iff₀ hs_t_pos).mp hle
            linarith
          have hm2 : z - τ_i < s_t * ((k : ℝ) + 1) := by
            have := (div_lt_iff₀ hs_t_pos).mp hlt
            linarith
          exact abs_le.mpr ⟨by linarith, by linarith⟩
        have hv0 : |v_rel 0| ≤ (1 / 2) * s_t := by
          dsimp only [v_rel]
          simp only [fineCellCenterV, gridPt2D]
          exact h_1d ((V_at α) 0) (τ_V 0) p_c.2.1.1 hk0
        have hv1 : |v_rel 1| ≤ (1 / 2) * s_t := by
          dsimp only [v_rel]
          simp only [fineCellCenterV, gridPt2D, Fin.one_eq_zero_iff]
          exact h_1d ((V_at α) 1) (τ_V 1) p_c.2.1.2 hk1
        have hv_norm : ‖v_rel‖ ≤ s_t := by
          have hsq : ‖v_rel‖ ^ 2 ≤ s_t ^ 2 := by
            rw [EuclideanSpace.norm_sq_eq, Fin.sum_univ_two, Real.norm_eq_abs, Real.norm_eq_abs,
              sq_abs, sq_abs]
            obtain ⟨l0, u0⟩ := abs_le.mp hv0
            obtain ⟨l1, u1⟩ := abs_le.mp hv1
            nlinarith
          nlinarith [norm_nonneg v_rel, hs_t_pos]
        exact ⟨hv0, hv1, hv_norm⟩

      rcases hd_dim with hd1 | hd2
      · let B₁ : ℕ := Nat.ceil (ε ^ (-h))
        let Box1 : Finset (ℤ × ℤ) := Finset.Icc (-(B₁ : ℤ)) (B₁ : ℤ) ×ˢ ({0} : Finset ℤ)
        have h_sub1 : S.image w_of ⊆ Box1 := by
          intro w hw
          obtain ⟨α, hα, rfl⟩ := Finset.mem_image.mp hw
          have hp_eq : p_of α = p_c := hS_pc α hα
          obtain ⟨_, _, hvn⟩ := hv_rel_coords α hα
          dsimp only [w_of, fineVelBin]
          rw [hp_eq, if_pos hd1]
          let v_rel := V_at α - fineCellCenterV s_t τ_V p_c.2.1
          have h_in_abs : |inner ℝ v_rel (n_fine p_c) / s_r| ≤ (B₁ : ℝ) := by
            rw [abs_div, abs_of_pos hs_r_pos]
            have hcs : |inner ℝ v_rel (n_fine p_c)| ≤ s_t := by
              calc |inner ℝ v_rel (n_fine p_c)|
                  ≤ ‖v_rel‖ * ‖n_fine p_c‖ := abs_real_inner_le_norm _ _
                _ = ‖v_rel‖ := by rw [hn_buf _, mul_one]
                _ ≤ s_t := hvn
            have hdiv : |inner ℝ v_rel (n_fine p_c)| / s_r ≤ ε ^ (-h) := by
              rw [← hst_div_sr]
              exact (div_le_div_iff_of_pos_right hs_r_pos).mpr hcs
            exact le_trans hdiv (Nat.le_ceil _)
          obtain ⟨hlo, hhi⟩ := abs_le.mp h_in_abs
          have hk_ge : -(B₁ : ℤ) ≤ Int.floor (inner ℝ v_rel (n_fine p_c) / s_r) := by
            refine Int.le_floor.mpr ?_; push_cast; linarith
          have hk_lt : Int.floor (inner ℝ v_rel (n_fine p_c) / s_r) < (B₁ : ℤ) + 1 := by
            refine Int.floor_lt.mpr ?_; push_cast; linarith
          dsimp only [v_rel, s_t, s_r, u_t, u_r] at hk_ge hk_lt ⊢
          exact Finset.mem_product.mpr ⟨Finset.mem_Icc.mpr ⟨hk_ge, by omega⟩, Finset.mem_singleton_self 0⟩
        have hcard1 : (S.image w_of).card ≤ 2 * B₁ + 1 := by
          calc (S.image w_of).card ≤ Box1.card := Finset.card_le_card h_sub1
            _ = 2 * B₁ + 1 := by
                simp only [Box1, Finset.card_product, Int.card_Icc, Finset.card_singleton]
                omega
        have hceil1 : (B₁ : ℝ) < ε ^ (-h) + 1 := Nat.ceil_lt_add_one (by positivity)
        rw [hd1, Nat.cast_one, one_mul]
        calc (((S.image w_of).card : ℝ)) ≤ ((2 * B₁ + 1 : ℕ) : ℝ) := by exact_mod_cast hcard1
          _ = 2 * (B₁ : ℝ) + 1 := by push_cast; ring
          _ ≤ 16 * ε ^ (-h) := by linarith
      · let B₂ : ℕ := Nat.ceil ((1 / 2) * ε ^ (-h))
        let I₂ : Finset ℤ := Finset.Icc (-(B₂ : ℤ)) (B₂ : ℤ)
        let Box2 : Finset (ℤ × ℤ) := I₂ ×ˢ I₂
        have h_sub2 : S.image w_of ⊆ Box2 := by
          intro w hw
          obtain ⟨α, hα, rfl⟩ := Finset.mem_image.mp hw
          have hp_eq : p_of α = p_c := hS_pc α hα
          obtain ⟨hv0, hv1, _⟩ := hv_rel_coords α hα
          have hd_ne1 : d_dim ≠ 1 := by omega
          dsimp only [w_of, fineVelBin]
          rw [hp_eq, if_neg hd_ne1]
          have h_1d_mem : ∀ y : ℝ, |y| ≤ (1 / 2) * s_t → Int.floor (y / s_r) ∈ I₂ := by
            intro y hy
            have hdiv : |y / s_r| ≤ (B₂ : ℝ) := by
              rw [abs_div, abs_of_pos hs_r_pos]
              have h1 : |y| / s_r ≤ ((1 / 2) * s_t) / s_r :=
                (div_le_div_iff_of_pos_right hs_r_pos).mpr hy
              have h2 : ((1 / 2) * s_t) / s_r = (1 / 2) * ε ^ (-h) := by
                rw [mul_div_assoc, hst_div_sr]
              exact le_trans h1 (h2 ▸ Nat.le_ceil _)
            obtain ⟨hlo, hhi⟩ := abs_le.mp hdiv
            have hk_ge : -(B₂ : ℤ) ≤ Int.floor (y / s_r) := by
              refine Int.le_floor.mpr ?_; push_cast; linarith
            have hk_lt : Int.floor (y / s_r) < (B₂ : ℤ) + 1 := by
              refine Int.floor_lt.mpr ?_; push_cast; linarith
            exact Finset.mem_Icc.mpr ⟨hk_ge, by omega⟩
          exact Finset.mem_product.mpr ⟨h_1d_mem _ hv0, h_1d_mem _ hv1⟩
        have hcard2 : (S.image w_of).card ≤ (2 * B₂ + 1) ^ 2 := by
          calc (S.image w_of).card ≤ Box2.card := Finset.card_le_card h_sub2
            _ = (2 * B₂ + 1) * (2 * B₂ + 1) := by
                simp only [Box2, I₂, Finset.card_product, Int.card_Icc]
                have h_sub_int : ((B₂ : ℤ) + 1 - -(B₂ : ℤ)).toNat = 2 * B₂ + 1 := by omega
                rw [h_sub_int]
            _ = (2 * B₂ + 1) ^ 2 := by ring
        have hceil2 : (B₂ : ℝ) < (1 / 2) * ε ^ (-h) + 1 := Nat.ceil_lt_add_one (by positivity)
        have h1d_le : ((2 * B₂ + 1 : ℕ) : ℝ) ≤ 4 * ε ^ (-h) := by
          push_cast; linarith
        have hexp2 : (ε ^ (-h)) ^ 2 = ε ^ (-((2 : ℝ) * h)) := by
          rw [← Real.rpow_two, ← Real.rpow_mul hε₀.le]
          ring_nf
        rw [hd2, Nat.cast_ofNat]
        calc (((S.image w_of).card : ℝ)) ≤ (((2 * B₂ + 1) ^ 2 : ℕ) : ℝ) := by exact_mod_cast hcard2
          _ = ((2 * B₂ + 1 : ℕ) : ℝ) ^ 2 := by push_cast; rfl
          _ ≤ (4 * ε ^ (-h)) ^ 2 := pow_le_pow_left₀ (by positivity) h1d_le 2
          _ = 16 * (ε ^ (-h)) ^ 2 := by ring
          _ = 16 * ε ^ (-((2 : ℝ) * h)) := by rw [hexp2]

    let al_tag : Fin N → Bool := fun α =>
      letI := Classical.propDecidable
      if d_dim = 1 then decide (projAngleDist (perp2D (e_at α)) (n_fine (p_of α)) ≤ 2 * ε ^ h)
      else false
    let W₁ : Fin N → Finset (Fin N) := fun α => W_all.filter (fun β => al_tag β = al_tag α)
    let c_pw : Fin N → ℕ := fun α =>
      ((W₁ α).filter (fun β => p_of β = p_of α ∧ w_of β = w_of α)).card
    let m₁ : Fin N → ℕ := fun α => Nat.floor ((Real.log (c_pw α : ℝ) / ell) / ξ)
    let W₂ : Fin N → Finset (Fin N) := fun α => (W₁ α).filter (fun β => m₁ β = m₁ α)
    let W_dist : Fin N → Finset (ℤ × ℤ) := fun α =>
      ((W₂ α).filter (fun β => p_of β = p_of α)).image w_of
    let c_w : Fin N → ℕ := fun α => (W_dist α).card
    let mk : Fin N → ℕ := fun α => Nat.floor ((Real.log (c_w α : ℝ) / ell) / ξ)
    let vel_key : Fin N → Bool × (ℕ × ℕ) := fun α => (al_tag α, (m₁ α, mk α))

    have hm₁_inv : ∀ α β : Fin N,
        al_tag β = al_tag α → p_of β = p_of α → w_of β = w_of α →
        c_pw β = c_pw α ∧ m₁ β = m₁ α := by
      intro α β hal hp hw
      have hW1 : W₁ β = W₁ α := by ext γ; simp only [W₁, Finset.mem_filter, hal]
      have hcpw : c_pw β = c_pw α := by
        dsimp only [c_pw]
        rw [hW1]
        congr 1
        ext γ
        simp only [Finset.mem_filter, hp, hw]
      exact ⟨hcpw, by dsimp only [m₁]; rw [hcpw]⟩

    have hmk_inv : ∀ α β : Fin N,
        al_tag β = al_tag α → m₁ β = m₁ α → p_of β = p_of α →
        W_dist β = W_dist α ∧ c_w β = c_w α ∧ mk β = mk α := by
      intro α β hal hm1 hp
      have hW1 : W₁ β = W₁ α := by ext γ; simp only [W₁, Finset.mem_filter, hal]
      have hW2 : W₂ β = W₂ α := by
        dsimp only [W₂]; rw [hW1]; ext γ; simp only [Finset.mem_filter, hm1]
      have hWd : W_dist β = W_dist α := by
        dsimp only [W_dist]; rw [hW2]; congr 1; ext γ; simp only [Finset.mem_filter, hp]
      have hcw : c_w β = c_w α := by dsimp only [c_w]; rw [hWd]
      exact ⟨hWd, hcw, by dsimp only [mk]; rw [hcw]⟩

    have h_key_bounds : ∀ α ∈ W_all,
        m₁ α < Nat.ceil (Q_cnt / ξ) + 1 ∧
        mk α < Nat.ceil (((d_dim : ℝ) * h) / ξ) + 3 := by
      intro α hα
      have hα_cpw : α ∈ (W₁ α).filter (fun β => p_of β = p_of α ∧ w_of β = w_of α) := by
        simp only [W₁, Finset.mem_filter, hα, true_and]
      have hcpw_ge1 : (1 : ℝ) ≤ (c_pw α : ℝ) := by
        exact_mod_cast Finset.one_le_card.mpr ⟨α, hα_cpw⟩
      have hcpw_le_Q : (c_pw α : ℝ) ≤ ε ^ (-Q_cnt) := by
        have hsub : (W₁ α).filter (fun β => p_of β = p_of α ∧ w_of β = w_of α) ⊆ W_all :=
          Finset.filter_subset _ _ |>.trans (Finset.filter_subset _ _)
        exact le_trans (by exact_mod_cast Finset.card_le_card hsub) hW_card
      have hlog_cpw : Real.log (c_pw α : ℝ) / ell ≤ Q_cnt := by
        have hlog_le := Real.log_le_log (by linarith) hcpw_le_Q
        rw [Real.log_rpow hε₀, hlogε] at hlog_le
        rw [div_le_iff₀ hell_pos]
        linarith
      have hm1_div : (Real.log (c_pw α : ℝ) / ell) / ξ ≤ (Nat.ceil (Q_cnt / ξ) : ℝ) :=
        le_trans ((div_le_div_iff_of_pos_right hξ).mpr hlog_cpw) (Nat.le_ceil _)
      have hm1_le : m₁ α ≤ Nat.ceil (Q_cnt / ξ) := by
        have hfl := Nat.floor_mono hm1_div
        rwa [Nat.floor_natCast] at hfl

      have hα_W2p : α ∈ (W₂ α).filter (fun β => p_of β = p_of α) := by
        simp only [W₂, W₁, Finset.mem_filter, hα, true_and]
      have hcw_ge1 : (1 : ℝ) ≤ (c_w α : ℝ) := by
        exact_mod_cast Finset.one_le_card.mpr ⟨w_of α, Finset.mem_image_of_mem w_of hα_W2p⟩
      have hcw_le16 : (c_w α : ℝ) ≤ 16 * ε ^ (-((d_dim : ℝ) * h)) :=
        h_w_per_pc (p_of α) ((W₂ α).filter (fun β => p_of β = p_of α))
          (fun β hβ => (Finset.mem_filter.mp hβ).2)
      have hlog_cw : Real.log (c_w α : ℝ) / ell ≤ ξ + (d_dim : ℝ) * h := by
        have hlog_le := Real.log_le_log (by linarith) hcw_le16
        rw [Real.log_mul (by norm_num) (Real.rpow_pos_of_pos hε₀ _).ne',
          Real.log_rpow hε₀, hlogε] at hlog_le
        have hdiv_le : Real.log (c_w α : ℝ) / ell ≤ Real.log 16 / ell + (d_dim : ℝ) * h := by
          rw [div_le_iff₀ hell_pos]
          have h16 := (div_le_iff₀ hell_pos).mp (le_refl (Real.log 16 / ell))
          linarith
        linarith [h_log16]
      have hmk_div : (Real.log (c_w α : ℝ) / ell) / ξ ≤
          ((Nat.ceil (((d_dim : ℝ) * h) / ξ) + 1 : ℕ) : ℝ) := by
        have h1 : (Real.log (c_w α : ℝ) / ell) / ξ ≤ 1 + ((d_dim : ℝ) * h) / ξ := by
          have := (div_le_div_iff_of_pos_right hξ).mpr hlog_cw
          rwa [add_div, div_self hξ.ne'] at this
        have h2 : ((d_dim : ℝ) * h) / ξ ≤ (Nat.ceil (((d_dim : ℝ) * h) / ξ) : ℝ) := Nat.le_ceil _
        push_cast
        linarith
      have hmk_le : mk α ≤ Nat.ceil (((d_dim : ℝ) * h) / ξ) + 1 := by
        have hfl := Nat.floor_mono hmk_div
        rwa [Nat.floor_natCast] at hfl
      exact ⟨Nat.lt_succ_of_le hm1_le, by omega⟩

    let Keys : Finset (Bool × (ℕ × ℕ)) := W_all.image vel_key
    obtain ⟨α_init, hα_init⟩ := hW_ne
    have hKeys_ne : Keys.Nonempty := ⟨vel_key α_init, Finset.mem_image_of_mem vel_key hα_init⟩
    let U_cnt : ℕ := Keys.card
    have hU_pos : 1 ≤ U_cnt := Finset.one_le_card.mpr hKeys_ne
    let BoxU : Finset (Bool × (ℕ × ℕ)) :=
      (Finset.univ : Finset Bool) ×ˢ
        (Finset.range (Nat.ceil (Q_cnt / ξ) + 1) ×ˢ
          Finset.range (Nat.ceil (((d_dim : ℝ) * h) / ξ) + 3))
    have hKeys_sub : Keys ⊆ BoxU := by
      intro k hk
      obtain ⟨α, hα, rfl⟩ := Finset.mem_image.mp hk
      obtain ⟨hm1_lt, hmk_lt⟩ := h_key_bounds α hα
      simp only [BoxU, vel_key, Finset.mem_product, Finset.mem_univ, Finset.mem_range, true_and]
      exact ⟨hm1_lt, hmk_lt⟩
    have hU_le : U_cnt ≤ 2 * (Nat.ceil (Q_cnt / ξ) + 1) * (Nat.ceil (((d_dim : ℝ) * h) / ξ) + 3) := by
      calc U_cnt ≤ BoxU.card := Finset.card_le_card hKeys_sub
        _ = 2 * ((Nat.ceil (Q_cnt / ξ) + 1) * (Nat.ceil (((d_dim : ℝ) * h) / ξ) + 3)) := by
            simp only [BoxU, Finset.card_product, Finset.card_univ, Fintype.card_bool, Finset.card_range]
        _ = 2 * (Nat.ceil (Q_cnt / ξ) + 1) * (Nat.ceil (((d_dim : ℝ) * h) / ξ) + 3) := by ring

    let eU : { x // x ∈ Keys } ≃ Fin U_cnt := Keys.equivFin
    let k_of_u : Fin U_cnt → Bool × (ℕ × ℕ) := fun u => (eU.symm u).1
    let al_of : Fin U_cnt → Bool := fun u => (k_of_u u).1
    let mk_of : Fin U_cnt → ℕ := fun u => (k_of_u u).2.2
    let R_set : Fin U_cnt → Finset (Fin N) :=
      fun u => W_all.filter (fun α => vel_key α = k_of_u u)

    have hR_fiber : ∀ (u : Fin U_cnt) (α₀ : Fin N), α₀ ∈ R_set u →
        (R_set u).filter (fun β => p_of β = p_of α₀) =
          (W₂ α₀).filter (fun β => p_of β = p_of α₀) := by
      intro u α₀ hα₀R
      have hk_α₀ : vel_key α₀ = k_of_u u := (Finset.mem_filter.mp hα₀R).2
      ext β
      simp only [R_set, W₂, W₁, Finset.mem_filter]
      constructor
      · rintro ⟨⟨hβW, hk_β⟩, hp_β⟩
        have hk_eq : vel_key β = vel_key α₀ := hk_β.trans hk_α₀.symm
        exact ⟨⟨⟨hβW, congr_arg Prod.fst hk_eq⟩, congr_arg (fun q => q.2.1) hk_eq⟩, hp_β⟩
      · rintro ⟨⟨⟨hβW, hal_β⟩, hm1_β⟩, hp_β⟩
        have hmk_β : mk β = mk α₀ := (hmk_inv α₀ β hal_β hm1_β hp_β).2.2
        have hk_eq : vel_key β = vel_key α₀ := Prod.ext hal_β (Prod.ext hm1_β hmk_β)
        exact ⟨⟨hβW, hk_eq.trans hk_α₀⟩, hp_β⟩

    have hW2_pw : ∀ α₁ : Fin N,
        (W₂ α₁).filter (fun β => p_of β = p_of α₁ ∧ w_of β = w_of α₁) =
          (W₁ α₁).filter (fun β => p_of β = p_of α₁ ∧ w_of β = w_of α₁) := by
      intro α₁
      ext β
      simp only [W₂, Finset.mem_filter]
      constructor
      · rintro ⟨⟨hβW1, _⟩, hpw⟩; exact ⟨hβW1, hpw⟩
      · rintro ⟨hβW1, hp, hw⟩
        have hal : al_tag β = al_tag α₁ := (Finset.mem_filter.mp hβW1).2
        exact ⟨⟨hβW1, (hm₁_inv α₁ β hal hp hw).2⟩, hp, hw⟩

    have hR_ne : ∀ u : Fin U_cnt, (R_set u).Nonempty := by
      intro u
      have hk_mem : k_of_u u ∈ Keys := (eU.symm u).2
      obtain ⟨α, hαW, hk_α⟩ := Finset.mem_image.mp hk_mem
      exact ⟨α, Finset.mem_filter.mpr ⟨hαW, hk_α⟩⟩

    refine ⟨U_cnt, R_set, al_of, mk_of, hU_pos, hU_le, hR_ne, ?_, ?_, ?_⟩
    · intro u₁ u₂ hne
      rw [Finset.disjoint_left]
      intro α hα₁ hα₂
      have hk₁ : vel_key α = k_of_u u₁ := (Finset.mem_filter.mp hα₁).2
      have hk₂ : vel_key α = k_of_u u₂ := (Finset.mem_filter.mp hα₂).2
      exact hne (eU.symm.injective (Subtype.ext (hk₁.symm.trans hk₂)))
    · ext α
      simp only [R_set, Finset.mem_biUnion, Finset.mem_univ, Finset.mem_filter, true_and]
      constructor
      · rintro ⟨_, hαW, _⟩; exact hαW
      · intro hαW
        have hk_mem : vel_key α ∈ Keys := Finset.mem_image_of_mem vel_key hαW
        let u : Fin U_cnt := eU ⟨vel_key α, hk_mem⟩
        refine ⟨u, hαW, ?_⟩
        dsimp only [k_of_u, u]
        rw [Equiv.symm_apply_apply]
    · intro u
      let k_bin : ℝ := (mk_of u : ℝ) * ξ
      obtain ⟨α_rep, hα_rep_R⟩ := hR_ne u
      have hα_rep_W : α_rep ∈ W_all := (Finset.mem_filter.mp hα_rep_R).1
      have hmk_rep : mk α_rep = mk_of u :=
        congr_arg (fun q => q.2.2) (Finset.mem_filter.mp hα_rep_R).2
      refine ⟨hmk_rep ▸ (h_key_bounds α_rep hα_rep_W).2, ?_, ?_, ?_⟩
      · intro hd1 α hαR
        have hal_eq : al_tag α = al_of u := congr_arg Prod.fst (Finset.mem_filter.mp hαR).2
        rw [← hal_eq]
        dsimp only [al_tag]
        rw [if_pos hd1]
        exact @decide_eq_true_iff _ (Classical.propDecidable _)
      · intro p_c w
        let S_pc := (R_set u).filter (fun α => p_of α = p_c)
        let S_pcw := (R_set u).filter (fun α => p_of α = p_c ∧ w_of α = w)
        by_cases h_pcw_ne : S_pcw.Nonempty
        · obtain ⟨α₁, hα₁_pcw⟩ := h_pcw_ne
          have hα₁_R : α₁ ∈ R_set u := (Finset.mem_filter.mp hα₁_pcw).1
          obtain ⟨hp_α₁, hw_α₁⟩ := (Finset.mem_filter.mp hα₁_pcw).2
          have hmk_α₁ : mk α₁ = mk_of u :=
            congr_arg (fun q => q.2.2) (Finset.mem_filter.mp hα₁_R).2
          have hSpc_eq : S_pc = (W₂ α₁).filter (fun β => p_of β = p_of α₁) := by
            have h1 : S_pc = (R_set u).filter (fun α => p_of α = p_of α₁) := by
              dsimp only [S_pc]; simp only [hp_α₁]
            rw [h1, hR_fiber u α₁ hα₁_R]
          have hSpcw_card : S_pcw.card = c_pw α₁ := by
            have h1 : S_pcw = (S_pc).filter (fun β => w_of β = w_of α₁) := by
              ext β
              simp only [S_pcw, S_pc, Finset.mem_filter, hw_α₁]
              tauto
            have h2 : (S_pc).filter (fun β => w_of β = w_of α₁) =
                (W₂ α₁).filter (fun β => p_of β = p_of α₁ ∧ w_of β = w_of α₁) := by
              rw [hSpc_eq]
              ext β
              simp only [Finset.mem_filter]
              tauto
            rw [h1, h2, hW2_pw α₁]
          have hα₁_W : α₁ ∈ W_all := (Finset.mem_filter.mp hα₁_R).1
          have hα₁_cpw : α₁ ∈ (W₁ α₁).filter (fun β => p_of β = p_of α₁ ∧ w_of β = w_of α₁) := by
            simp only [W₁, Finset.mem_filter, hα₁_W, true_and]
          have hcpw_pos : (0 : ℝ) < (c_pw α₁ : ℝ) := by
            exact_mod_cast Finset.card_pos.mpr ⟨α₁, hα₁_cpw⟩
          have hm1_lt_log : Real.log (c_pw α₁ : ℝ) / ell ≤ ((m₁ α₁ : ℝ) + 1) * ξ :=
            ((div_lt_iff₀ hξ).mp (Nat.lt_floor_add_one _)).le
          have h_up : (S_pcw.card : ℝ) ≤ ε ^ (-(((m₁ α₁ : ℝ) + 1) * ξ)) := by
            rw [hSpcw_card]
            exact h_le_rpow hcpw_pos hm1_lt_log

          have hcw_pos : (0 : ℝ) < (c_w α₁ : ℝ) := by
            have hα₁_W2p : α₁ ∈ (W₂ α₁).filter (fun β => p_of β = p_of α₁) := by
              simp only [W₂, W₁, Finset.mem_filter, hα₁_W, true_and]
            exact_mod_cast Finset.card_pos.mpr ⟨w_of α₁, Finset.mem_image_of_mem w_of hα₁_W2p⟩
          have hkbin_le_cw : k_bin ≤ Real.log (c_w α₁ : ℝ) / ell := by
            have hdiv_nn : 0 ≤ (Real.log (c_w α₁ : ℝ) / ell) / ξ := by
              have h1 : (1 : ℝ) ≤ (c_w α₁ : ℝ) := by
                have hα₁_W2p : α₁ ∈ (W₂ α₁).filter (fun β => p_of β = p_of α₁) := by
                  simp only [W₂, W₁, Finset.mem_filter, hα₁_W, true_and]
                exact_mod_cast Finset.one_le_card.mpr ⟨w_of α₁, Finset.mem_image_of_mem w_of hα₁_W2p⟩
              exact div_nonneg (div_nonneg (Real.log_nonneg h1) hell_pos.le) hξ.le
            have hfl := (le_div_iff₀ hξ).mp (Nat.floor_le hdiv_nn)
            dsimp only [k_bin]
            rwa [← hmk_α₁]
          have hcw_rpow : ε ^ (-k_bin) ≤ (c_w α₁ : ℝ) := h_rpow_le hcw_pos hkbin_le_cw

          have hSpc_sum : (S_pc.card : ℝ) =
              ∑ w' ∈ W_dist α₁, (((S_pc.filter (fun β => w_of β = w')).card : ℝ)) := by
            have h_img : S_pc.image w_of = W_dist α₁ := by
              rw [hSpc_eq]
            have hc := Finset.card_eq_sum_card_image w_of S_pc
            rw [h_img] at hc
            exact_mod_cast hc
          have h_each_w : ∀ w' ∈ W_dist α₁,
              ε ^ (-((m₁ α₁ : ℝ) * ξ)) ≤ (((S_pc.filter (fun β => w_of β = w')).card : ℝ)) := by
            intro w' hw'
            obtain ⟨α', hα'_mem, rfl⟩ := Finset.mem_image.mp hw'
            have hα'_W2 : α' ∈ W₂ α₁ := (Finset.mem_filter.mp hα'_mem).1
            have hp_α' : p_of α' = p_of α₁ := (Finset.mem_filter.mp hα'_mem).2
            have hm1_α' : m₁ α' = m₁ α₁ := (Finset.mem_filter.mp hα'_W2).2
            have hal_α' : al_tag α' = al_tag α₁ :=
              (Finset.mem_filter.mp (Finset.mem_filter.mp hα'_W2).1).2
            have hα'_W : α' ∈ W_all :=
              (Finset.mem_filter.mp (Finset.mem_filter.mp hα'_W2).1).1
            have hW2_eq' : W₂ α' = W₂ α₁ := by
              ext γ; simp only [W₂, W₁, Finset.mem_filter, hal_α', hm1_α']
            have hcard_α' : (S_pc.filter (fun β => w_of β = w_of α')).card = c_pw α' := by
              rw [hSpc_eq, ← hp_α', ← hW2_eq']
              have h_f : ((W₂ α').filter (fun β => p_of β = p_of α')).filter
                  (fun β => w_of β = w_of α') =
                (W₂ α').filter (fun β => p_of β = p_of α' ∧ w_of β = w_of α') := by
                ext γ; simp only [Finset.mem_filter]; tauto
              rw [h_f, hW2_pw α']
            have hcpw_α'_ge1 : (1 : ℝ) ≤ (c_pw α' : ℝ) := by
              have h_in : α' ∈ (W₁ α').filter (fun β => p_of β = p_of α' ∧ w_of β = w_of α') := by
                simp only [W₁, Finset.mem_filter, hα'_W, true_and]
              exact_mod_cast Finset.one_le_card.mpr ⟨α', h_in⟩
            have hm1_le_log : (m₁ α₁ : ℝ) * ξ ≤ Real.log (c_pw α' : ℝ) / ell := by
              rw [← hm1_α']
              have hdiv_nn : 0 ≤ (Real.log (c_pw α' : ℝ) / ell) / ξ :=
                div_nonneg (div_nonneg (Real.log_nonneg hcpw_α'_ge1) hell_pos.le) hξ.le
              exact (le_div_iff₀ hξ).mp (Nat.floor_le hdiv_nn)
            rw [hcard_α']
            exact h_rpow_le (by linarith) hm1_le_log

          have hSpc_lo : ε ^ (-k_bin - (m₁ α₁ : ℝ) * ξ) ≤ (S_pc.card : ℝ) := by
            rw [hSpc_sum]
            have hsum_ge : ∑ _w' ∈ W_dist α₁, ε ^ (-((m₁ α₁ : ℝ) * ξ)) ≤
                ∑ w' ∈ W_dist α₁, (((S_pc.filter (fun β => w_of β = w')).card : ℝ)) :=
              Finset.sum_le_sum h_each_w
            rw [Finset.sum_const, nsmul_eq_mul] at hsum_ge
            have hmul_ge : ε ^ (-k_bin) * ε ^ (-((m₁ α₁ : ℝ) * ξ)) ≤
                (c_w α₁ : ℝ) * ε ^ (-((m₁ α₁ : ℝ) * ξ)) :=
              mul_le_mul_of_nonneg_right hcw_rpow (Real.rpow_pos_of_pos hε₀ _).le
            have hexp_sum : ε ^ (-k_bin - (m₁ α₁ : ℝ) * ξ) =
                ε ^ (-k_bin) * ε ^ (-((m₁ α₁ : ℝ) * ξ)) := by
              rw [sub_eq_add_neg, Real.rpow_add hε₀]
            exact le_trans (hexp_sum ▸ hmul_ge) hsum_ge

          calc (S_pcw.card : ℝ)
              ≤ ε ^ (-(((m₁ α₁ : ℝ) + 1) * ξ)) := h_up
            _ = ε ^ (k_bin - ξ) * ε ^ (-k_bin - (m₁ α₁ : ℝ) * ξ) := by
                rw [← Real.rpow_add hε₀]
                congr 1; ring
            _ ≤ ε ^ (k_bin - ξ) * (S_pc.card : ℝ) :=
                mul_le_mul_of_nonneg_left hSpc_lo (Real.rpow_pos_of_pos hε₀ _).le
        · rw [Finset.not_nonempty_iff_eq_empty] at h_pcw_ne
          have hzero : (((R_set u).filter (fun α => p_of α = p_c ∧ w_of α = w)).card : ℝ) = 0 := by
            change (S_pcw.card : ℝ) = 0
            rw [h_pcw_ne, Finset.card_empty, Nat.cast_zero]
          rw [hzero]
          exact mul_nonneg (Real.rpow_pos_of_pos hε₀ _).le (Nat.cast_nonneg _)

      · intro p_buf
        let M : ℤ := (M_L : ℤ)
        have hM_pos : 0 < M := by dsimp only [M]; omega
        let I_div : ℤ → Finset ℤ := fun K => Finset.Ico (K * M) ((K + 1) * M)
        have h_div_mem : ∀ z K : ℤ, z / M = K → z ∈ I_div K := by
          intro z K hzK
          have hdiv := Int.emod_add_mul_ediv z M
          rw [hzK] at hdiv
          have hm0 : 0 ≤ z % M := Int.emod_nonneg z hM_pos.ne'
          have hmlt : z % M < M := Int.emod_lt_of_pos z hM_pos
          refine Finset.mem_Ico.mpr ⟨?_, ?_⟩
          · have h1 : K * M = M * K := mul_comm K M
            linarith
          · have h2 : (K + 1) * M = M * K + M := by ring
            linarith
        have h_div_card : ∀ K : ℤ, (I_div K).card = M_L := by
          intro K
          simp only [I_div, Int.card_Ico]
          have hdiff : (K + 1) * M - K * M = (M_L : ℤ) := by dsimp only [M]; ring
          rw [hdiff, Int.toNat_natCast]

        let FineBox : Finset (ℕ × (ℤ × ℤ) × (ℤ × ℤ)) :=
          ({p_buf.1} : Finset ℕ) ×ˢ
            ((I_div p_buf.2.1.1 ×ˢ I_div p_buf.2.1.2) ×ˢ
             (I_div p_buf.2.2.1 ×ˢ I_div p_buf.2.2.2))
        have hFineBox_card : FineBox.card = M_L ^ 4 := by
          simp only [FineBox, Finset.card_product, Finset.card_singleton, h_div_card]
          ring

        let PW_buf := ((R_set u).image (fun α => (p_of α, w_of α))).filter
          (fun pw => coarseOfFineCell M_L pw.1 = p_buf)
        let F_of_pc : (ℕ × (ℤ × ℤ) × (ℤ × ℤ)) → Finset ((ℕ × (ℤ × ℤ) × (ℤ × ℤ)) × (ℤ × ℤ)) :=
          fun p_c => (((R_set u).filter (fun α => p_of α = p_c)).image w_of).image (fun w => (p_c, w))
        have hPW_sub : PW_buf ⊆ FineBox.biUnion F_of_pc := by
          intro pw hpw
          obtain ⟨hpw_img, hpw_coarse⟩ := Finset.mem_filter.mp hpw
          obtain ⟨α, hαR, rfl⟩ := Finset.mem_image.mp hpw_img
          refine Finset.mem_biUnion.mpr ⟨p_of α, ?_, ?_⟩
          · dsimp only [coarseOfFineCell] at hpw_coarse
            have hq : (p_of α).1 = p_buf.1 := congr_arg (fun c => c.1) hpw_coarse
            have hkv1 : (p_of α).2.1.1 / M = p_buf.2.1.1 :=
              congr_arg (fun c => c.2.1.1) hpw_coarse
            have hkv2 : (p_of α).2.1.2 / M = p_buf.2.1.2 :=
              congr_arg (fun c => c.2.1.2) hpw_coarse
            have hkx1 : (p_of α).2.2.1 / M = p_buf.2.2.1 :=
              congr_arg (fun c => c.2.2.1) hpw_coarse
            have hkx2 : (p_of α).2.2.2 / M = p_buf.2.2.2 :=
              congr_arg (fun c => c.2.2.2) hpw_coarse
            simp only [FineBox, Finset.mem_product, Finset.mem_singleton]
            exact ⟨hq, ⟨h_div_mem _ _ hkv1, h_div_mem _ _ hkv2⟩,
              ⟨h_div_mem _ _ hkx1, h_div_mem _ _ hkx2⟩⟩
          · refine Finset.mem_image_of_mem (fun w => (p_of α, w)) ?_
            exact Finset.mem_image_of_mem w_of (Finset.mem_filter.mpr ⟨hαR, rfl⟩)

        have hF_card_each : ∀ p_c ∈ FineBox,
            ((F_of_pc p_c).card : ℝ) ≤ ε ^ (-(k_bin + ξ)) := by
          intro p_c _
          let S_pc := (R_set u).filter (fun α => p_of α = p_c)
          have h_img_le : (F_of_pc p_c).card ≤ (S_pc.image w_of).card := Finset.card_image_le
          by_cases hSpc_ne : S_pc.Nonempty
          · obtain ⟨α₀, hα₀_pc⟩ := hSpc_ne
            have hα₀_R : α₀ ∈ R_set u := (Finset.mem_filter.mp hα₀_pc).1
            have hp_α₀ : p_of α₀ = p_c := (Finset.mem_filter.mp hα₀_pc).2
            have hmk_α₀ : mk α₀ = mk_of u :=
              congr_arg (fun q => q.2.2) (Finset.mem_filter.mp hα₀_R).2
            have h_img_eq : (S_pc.image w_of).card = c_w α₀ := by
              have h1 : S_pc = (R_set u).filter (fun α => p_of α = p_of α₀) := by
                dsimp only [S_pc]; simp only [hp_α₀]
              rw [h1, hR_fiber u α₀ hα₀_R]
            have hα₀_W : α₀ ∈ W_all := (Finset.mem_filter.mp hα₀_R).1
            have hcw_pos : (0 : ℝ) < (c_w α₀ : ℝ) := by
              have h_in : α₀ ∈ (W₂ α₀).filter (fun β => p_of β = p_of α₀) := by
                simp only [W₂, W₁, Finset.mem_filter, hα₀_W, true_and]
              exact_mod_cast Finset.card_pos.mpr ⟨w_of α₀, Finset.mem_image_of_mem w_of h_in⟩
            have hlog_lt : Real.log (c_w α₀ : ℝ) / ell ≤ k_bin + ξ := by
              have hlt := (div_lt_iff₀ hξ).mp (Nat.lt_floor_add_one ((Real.log (c_w α₀ : ℝ) / ell) / ξ))
              have hmk_eq : ((mk α₀ : ℝ) + 1) * ξ = k_bin + ξ := by
                dsimp only [k_bin]; rw [← hmk_α₀]; ring
              exact (hmk_eq ▸ hlt).le
            calc ((F_of_pc p_c).card : ℝ)
                ≤ ((S_pc.image w_of).card : ℝ) := by exact_mod_cast h_img_le
              _ = (c_w α₀ : ℝ) := by exact_mod_cast h_img_eq
              _ ≤ ε ^ (-(k_bin + ξ)) := h_le_rpow hcw_pos hlog_lt
          · rw [Finset.not_nonempty_iff_eq_empty] at hSpc_ne
            have hzero : (F_of_pc p_c).card = 0 := by
              have h1 : (S_pc.image w_of).card = 0 := by rw [hSpc_ne]; simp
              omega
            rw [hzero, Nat.cast_zero]
            exact Real.rpow_nonneg hε₀.le _

        have hPW_nat : PW_buf.card ≤ ∑ p_c ∈ FineBox, (F_of_pc p_c).card :=
          le_trans (Finset.card_le_card hPW_sub) Finset.card_biUnion_le
        calc (PW_buf.card : ℝ)
            ≤ ∑ p_c ∈ FineBox, ((F_of_pc p_c).card : ℝ) := by exact_mod_cast hPW_nat
          _ ≤ ∑ _p_c ∈ FineBox, ε ^ (-(k_bin + ξ)) := Finset.sum_le_sum hF_card_each
          _ = (FineBox.card : ℝ) * ε ^ (-(k_bin + ξ)) := by
              rw [Finset.sum_const, nsmul_eq_mul]
          _ = ((M_L ^ 4 : ℕ) : ℝ) * ε ^ (-(k_bin + ξ)) := by rw [hFineBox_card]

  
  intro B_cut
  have hB_sys2 : 2 ≤ cls.B_sys := cls.hB_sys
  have hK_hor1 : 1 ≤ cls.K_hor := cls.hK_hor
  have hR_win2 : 2 ≤ cls.R_win := cls.hR_win
  let R_loc_dom : ℝ := 8 * cls.B_sys + 2 * cls.R_win + 10
  have hR_loc_ge1 : 1 ≤ R_loc_dom := by dsimp only [R_loc_dom]; linarith
  let C_menu : ℝ := (R_loc_dom + 9) ^ 4
  let C_cov : ℝ := max (max 2 C_cut) C_menu
  have hC_cov_max : max 2 C_cut ≤ C_cov := le_max_left _ _
  have hC_cov_ge2 : 2 ≤ C_cov := le_trans (le_max_left 2 C_cut) hC_cov_max
  have hC_cov_cut : C_cut ≤ C_cov := le_trans (le_max_right 2 C_cut) hC_cov_max
  have hC_cov_menu : C_menu ≤ C_cov := le_max_right _ _

  let Q_cnt : ℝ := 4 * cls.K_hor + 5
  have hQ_cnt_nn : 0 ≤ Q_cnt := by dsimp only [Q_cnt]; linarith
  let M_mass : ℕ := Nat.ceil (B_cut / ξ) + 1
  let M_w : ℕ := Nat.ceil (cls.K_hor / (ξ / 4)) + 1
  let M_grp : ℕ := (Nat.ceil ((Q_cnt + 2 * cls.K_hor) / ξ) + 1) * M_w ^ 2
  let M_vel : ℕ := 2 * (Nat.ceil (Q_cnt / ξ) + 1) * (Nat.ceil (cls.K_hor / ξ) + 3)
  let S_max : ℕ := M_mass * M_grp * M_vel
  have h4_vel : 1 ≤ M_vel :=
    Nat.mul_pos (Nat.mul_pos (by omega) (by omega)) (by omega)
  have hS_max_ge1 : 1 ≤ S_max := by
    have h1 : 1 ≤ M_mass := by dsimp only [M_mass]; omega
    have h2 : 1 ≤ M_w := by dsimp only [M_w]; omega
    have h3 : 1 ≤ M_grp := Nat.mul_pos (by omega) (Nat.pow_pos h2)
    exact Nat.mul_pos (Nat.mul_pos h1 h3) h4_vel
  have hR_bud_pos : 0 < R_bud := by linarith
  have hR64_pos : 0 < R_bud / 64 := by linarith

  let ε₁ : ℝ := (2 * C_cut)⁻¹
  let ε₂ : ℝ := (Real.exp ((Real.log 16 + 1) / ξ))⁻¹
  let ε₃ : ℝ := (Real.exp ((Real.log (S_max : ℝ) + 1) / (R_bud / 64)))⁻¹
  let ε_menu : ℝ := min (1 / 4) (min ε₁ (min ε₂ ε₃))
  have hε_menu_pos : 0 < ε_menu := by
    refine lt_min (by norm_num) (lt_min ?_ (lt_min ?_ ?_))
    · exact inv_pos.mpr (by linarith)
    · exact inv_pos.mpr (Real.exp_pos _)
    · exact inv_pos.mpr (Real.exp_pos _)
  have hε_menu_lt : ε_menu < 1 / 2 :=
    lt_of_le_of_lt (min_le_left _ _) (by norm_num)

  refine ⟨C_cov, ε_menu, hC_cov_max, hε_menu_pos, hε_menu_lt, ?_⟩
  intro M_L ε H_P L t r h b_star lam_sys m_r m_t j₀ Φ₀ τ_V τ_X n_buf N_atom o_atom ψ_atom c_atom
    ell s_c C_r s_v s_x V_J X_J ρ_r σ_r ρ_t n_fine V_at X_at g_at
    hML hε₀ hε_lt hlam_pos hN_atom hn_buf
    hr_nn hr_lt_t ht_L hL_K ht_HP hHP_K hvel_h
    hb_star_nn hb_star_Lt hb_star_HPt hqr_lt hmr_le_mt hVJ_le hXJ_le
    hN_at_le hψ_at hVX_at hmult_at hc_lo hc_sum h_tr

  have hε_lt_qtr : ε < 1 / 4 := lt_of_lt_of_le hε_lt (min_le_left _ _)
  have hε₁_half : ε < 1 / 2 := by linarith
  have hε_lt1 : ε < 1 := by linarith
  have hε_inv_gt1 : 1 < ε⁻¹ := by rw [one_lt_inv₀ hε₀]; linarith
  have hell_pos : 0 < ell := Real.log_pos hε_inv_gt1
  have hlogε : Real.log ε = -ell := by simp only [ell, Real.log_inv, neg_neg]
  have h_le_rpow : ∀ {x Z : ℝ}, 0 < x → Real.log x / ell ≤ Z → x ≤ ε ^ (-Z) := by
    intro x Z hx hZ
    have h1 : Real.log x ≤ Z * ell := (div_le_iff₀ hell_pos).mp hZ
    have h2 : Real.log x ≤ Real.log ε * (-Z) := by rw [hlogε]; linarith
    calc x = Real.exp (Real.log x) := (Real.exp_log hx).symm
      _ ≤ Real.exp (Real.log ε * (-Z)) := Real.exp_le_exp.mpr h2
      _ = ε ^ (-Z) := (Real.rpow_def_of_pos hε₀ (-Z)).symm
  have h_rpow_le : ∀ {x Z : ℝ}, 0 < x → Z ≤ Real.log x / ell → ε ^ (-Z) ≤ x := by
    intro x Z hx hZ
    have h1 : Z * ell ≤ Real.log x := (le_div_iff₀ hell_pos).mp hZ
    have h2 : Real.log ε * (-Z) ≤ Real.log x := by rw [hlogε]; linarith
    calc ε ^ (-Z) = Real.exp (Real.log ε * (-Z)) := Real.rpow_def_of_pos hε₀ (-Z)
      _ ≤ Real.exp (Real.log x) := Real.exp_le_exp.mpr h2
      _ = x := Real.exp_log hx

  have hN_le_Q : (N_atom : ℝ) ≤ ε ^ (-Q_cnt) := by
    have hε_lt_e1 : ε < ε₁ :=
      lt_of_lt_of_le hε_lt ((min_le_right _ _).trans (min_le_left _ _))
    have h2C : 2 * C_cut < ε⁻¹ := (lt_inv_comm₀ hε₀ (by linarith)).mp hε_lt_e1
    have hC_le : C_cut ≤ ε ^ (-1 : ℝ) := by
      rw [Real.rpow_neg_one]; linarith
    calc (N_atom : ℝ) ≤ C_cut * ε ^ (-(4 * cls.K_hor + 4)) := hN_at_le
      _ ≤ ε ^ (-1 : ℝ) * ε ^ (-(4 * cls.K_hor + 4)) :=
          mul_le_mul_of_nonneg_right hC_le (Real.rpow_pos_of_pos hε₀ _).le
      _ = ε ^ (-Q_cnt) := by
          rw [← Real.rpow_add hε₀]
          congr 1; dsimp only [Q_cnt]; ring

  have h_log16 : Real.log 16 / ell ≤ ξ := by
    have hε_lt_e2 : ε < ε₂ :=
      lt_of_lt_of_le hε_lt ((min_le_right _ _).trans ((min_le_right _ _).trans (min_le_left _ _)))
    have hexp_lt : Real.exp ((Real.log 16 + 1) / ξ) < ε⁻¹ :=
      (lt_inv_comm₀ hε₀ (Real.exp_pos _)).mp hε_lt_e2
    have hlog_lt := Real.log_lt_log (Real.exp_pos _) hexp_lt
    rw [Real.log_exp] at hlog_lt
    have hm := (div_lt_iff₀ hξ).mp hlog_lt
    rw [div_le_iff₀ hell_pos]
    linarith

  have h_log_Smax : Real.log (S_max : ℝ) / ell ≤ R_bud / 64 := by
    have hε_lt_e3 : ε < ε₃ :=
      lt_of_lt_of_le hε_lt ((min_le_right _ _).trans ((min_le_right _ _).trans (min_le_right _ _)))
    have hexp_lt : Real.exp ((Real.log (S_max : ℝ) + 1) / (R_bud / 64)) < ε⁻¹ :=
      (lt_inv_comm₀ hε₀ (Real.exp_pos _)).mp hε_lt_e3
    have hlog_lt := Real.log_lt_log (Real.exp_pos _) hexp_lt
    rw [Real.log_exp] at hlog_lt
    have hm := (div_lt_iff₀ hR64_pos).mp hlog_lt
    rw [div_le_iff₀ hell_pos]
    linarith

  let W_max : ℝ := min (L - r - b_star) ((H_P - r) / 2 - b_star)
  have hW_pos : 0 < W_max := lt_min (by linarith) (by linarith)
  have hW_le_K : W_max ≤ cls.K_hor :=
    le_trans (min_le_left _ _) (by linarith)
  have hs_v_pos : 0 < s_v := Real.rpow_pos_of_pos hε₀ b_star
  have hs_c_pos : 0 < s_c := by dsimp only [s_c]; positivity
  have hs_x_pos : 0 < s_x := mul_pos hs_c_pos hs_v_pos
  have hρ_t_pos : 0 < ρ_t := Real.rpow_pos_of_pos hε₀ _
  have hρ_r_pos : 0 < ρ_r := by
    dsimp only [ρ_r]
    split_ifs
    · exact inv_pos.mpr (Real.sqrt_pos.mpr hlam_pos)
    · exact Real.rpow_pos_of_pos hε₀ _
  have hσ_r_pos : 0 < σ_r := inv_pos.mpr (mul_pos hlam_pos hρ_r_pos)

  let V'_at : Fin N_atom → EuclideanSpace ℝ (Fin 2) := fun α => s_v⁻¹ • (V_at α - V_J)
  let X'_at : Fin N_atom → EuclideanSpace ℝ (Fin 2) := fun α => s_x⁻¹ • (X_at α - X_J)
  have hVX'_tight : ∀ α : Fin N_atom,
      ‖V'_at α‖ ≤ 4 * cls.B_sys + cls.R_win + 4 ∧
      ‖X'_at α‖ ≤ 8 * cls.B_sys + 2 * cls.R_win + 10 := by
    intro α
    obtain ⟨hV, hX⟩ := hVX_at α
    constructor
    · dsimp only [V'_at]
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hs_v_pos)]
      calc s_v⁻¹ * ‖V_at α - V_J‖
          ≤ s_v⁻¹ * ((4 * cls.B_sys + cls.R_win + 4) * s_v) :=
            mul_le_mul_of_nonneg_left hV (inv_pos.mpr hs_v_pos).le
        _ = 4 * cls.B_sys + cls.R_win + 4 := by field_simp [hs_v_pos.ne']
    · dsimp only [X'_at]
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hs_x_pos)]
      calc s_x⁻¹ * ‖X_at α - X_J‖
          ≤ s_x⁻¹ * ((8 * cls.B_sys + 2 * cls.R_win + 10) * s_x) :=
            mul_le_mul_of_nonneg_left hX (inv_pos.mpr hs_x_pos).le
        _ = 8 * cls.B_sys + 2 * cls.R_win + 10 := by field_simp [hs_x_pos.ne']
  have hVX'_dom : ∀ α : Fin N_atom, ‖V'_at α‖ ≤ R_loc_dom ∧ ‖X'_at α‖ ≤ R_loc_dom := by
    intro α
    obtain ⟨hV, hX⟩ := hVX'_tight α
    exact ⟨by dsimp only [R_loc_dom]; linarith, hX⟩

  let e_mass : Fin N_atom → ℝ := fun α => -Real.log (‖c_atom α‖ ^ 2) / ell
  let m_idx : Fin N_atom → ℕ := fun α => Nat.floor (e_mass α / ξ)
  let m_bin_val : ℕ → ℝ := fun m => ε ^ (((m : ℝ) + 1) * ξ)
  have hm_atom_props : ∀ α : Fin N_atom,
      m_idx α < M_mass ∧
      m_bin_val (m_idx α) ≤ ‖c_atom α‖ ^ 2 ∧
      ‖c_atom α‖ ^ 2 ≤ ε ^ (-ξ) * m_bin_val (m_idx α) := by
    intro α
    have hc_pos : 0 < ‖c_atom α‖ ^ 2 :=
      lt_of_lt_of_le (Real.rpow_pos_of_pos hε₀ B_cut) (hc_lo α)
    have hc_le1 : ‖c_atom α‖ ^ 2 ≤ 1 :=
      le_trans (Finset.single_le_sum (f := fun β => ‖c_atom β‖ ^ 2)
        (fun β _ => sq_nonneg _) (Finset.mem_univ α)) hc_sum
    have hlog_le0 : Real.log (‖c_atom α‖ ^ 2) ≤ 0 := by
      simpa using Real.log_le_log hc_pos hc_le1
    have hem_nn : 0 ≤ e_mass α := div_nonneg (by linarith) hell_pos.le
    have hem_le_B : e_mass α ≤ B_cut := by
      have hlog_lo := Real.log_le_log (Real.rpow_pos_of_pos hε₀ B_cut) (hc_lo α)
      rw [Real.log_rpow hε₀, hlogε] at hlog_lo
      dsimp only [e_mass]
      rw [div_le_iff₀ hell_pos]
      linarith
    have hdiv_le : e_mass α / ξ ≤ (Nat.ceil (B_cut / ξ) : ℝ) :=
      le_trans ((div_le_div_iff_of_pos_right hξ).mpr hem_le_B) (Nat.le_ceil _)
    have hm_le : m_idx α ≤ Nat.ceil (B_cut / ξ) := by
      have hfl := Nat.floor_mono hdiv_le
      rwa [Nat.floor_natCast] at hfl
    have hm_lo_e : (m_idx α : ℝ) * ξ ≤ e_mass α :=
      (le_div_iff₀ hξ).mp (Nat.floor_le (div_nonneg hem_nn hξ.le))
    have hm_hi_e : e_mass α < ((m_idx α : ℝ) + 1) * ξ :=
      (div_lt_iff₀ hξ).mp (Nat.lt_floor_add_one _)
    have hlog_div_eq : Real.log (‖c_atom α‖ ^ 2) / ell = -e_mass α := by
      dsimp only [e_mass]; ring
    have hc_ge_m : m_bin_val (m_idx α) ≤ ‖c_atom α‖ ^ 2 := by
      have h1 : -(((m_idx α : ℝ) + 1) * ξ) ≤ Real.log (‖c_atom α‖ ^ 2) / ell := by
        rw [hlog_div_eq]; linarith
      have hr := h_rpow_le hc_pos h1
      rwa [neg_neg] at hr
    have hc_le_m : ‖c_atom α‖ ^ 2 ≤ ε ^ (-ξ) * m_bin_val (m_idx α) := by
      have h1 : Real.log (‖c_atom α‖ ^ 2) / ell ≤ -((m_idx α : ℝ) * ξ) := by
        rw [hlog_div_eq]; linarith
      have hr := h_le_rpow hc_pos h1
      rw [neg_neg] at hr
      have hexp : ε ^ ((m_idx α : ℝ) * ξ) = ε ^ (-ξ) * m_bin_val (m_idx α) := by
        dsimp only [m_bin_val]
        rw [← Real.rpow_add hε₀]
        congr 1; ring
      rwa [hexp] at hr
    exact ⟨Nat.lt_succ_of_le hm_le, hc_ge_m, hc_le_m⟩

  let MassKeys : Finset ℕ := (Finset.univ : Finset (Fin N_atom)).image m_idx
  let α_def : Fin N_atom := ⟨0, hN_atom⟩
  have hMassKeys_ne : MassKeys.Nonempty :=
    ⟨m_idx α_def, Finset.mem_image_of_mem m_idx (Finset.mem_univ _)⟩
  have hMassKeys_card : MassKeys.card ≤ M_mass := by
    have hsub : MassKeys ⊆ Finset.range M_mass := by
      intro m hm
      obtain ⟨α, _, rfl⟩ := Finset.mem_image.mp hm
      exact Finset.mem_range.mpr (hm_atom_props α).1
    exact le_trans (Finset.card_le_card hsub) (by simp)
  let B_of : ℕ → Finset (Fin N_atom) := fun m => Finset.univ.filter (fun α => m_idx α = m)

  let N_w : ℕ := Nat.ceil (W_max / (ξ / 4))
  let w_of_menu : ℕ → ℝ := fun i => min ((i : ℝ) * (ξ / 4)) W_max
  have hNw_succ_le : N_w + 1 ≤ M_w := by
    have hδ : 0 < ξ / 4 := by linarith
    have hle : N_w ≤ Nat.ceil (cls.K_hor / (ξ / 4)) :=
      Nat.ceil_mono ((div_le_div_iff_of_pos_right hδ).mpr hW_le_K)
    dsimp only [M_w]
    omega

  obtain ⟨M_menu, ib_menu, ia_menu, e_menu, V_menu, X_menu,
    _, hmenu_props, hmenu_all_W, hmenu_cov⟩ :=
    anisotropic_cap_menu_and_covering γ ε ξ W_max R_loc_dom
      hγ₀ hγ₁ hε₀ hε₁_half hξ hW_pos hR_loc_ge1 N_atom V'_at X'_at hVX'_dom

  let b_menu : Fin M_menu → ℝ := fun κ => w_of_menu (ib_menu κ)
  let a_menu : Fin M_menu → ℝ := fun κ => w_of_menu (ia_menu κ)
  let in_cap : Fin M_menu → Fin N_atom → Prop := fun κ α =>
    |inner ℝ (V'_at α - V_menu κ) (e_menu κ)| ≤ ε ^ (b_menu κ) ∧
    |inner ℝ (V'_at α - V_menu κ) (perp2D (e_menu κ))| ≤ ε ^ (a_menu κ) ∧
    |inner ℝ (X'_at α - X_menu κ) (e_menu κ)| ≤ ε ^ (b_menu κ) ∧
    |inner ℝ (X'_at α - X_menu κ) (perp2D (e_menu κ))| ≤ ε ^ (a_menu κ)
  let E_cap : Fin M_menu → Finset (Fin N_atom) := fun κ =>
    letI := Classical.propDecidable
    Finset.univ.filter (in_cap κ)
  have hE_cap_iff : ∀ κ α, α ∈ E_cap κ ↔ in_cap κ α := by
    intro κ α
    simp [E_cap]
  let w_cap : Fin M_menu → ℝ := fun κ => pktWeight γ (b_menu κ) (a_menu κ)

  have hw_cap_bounds : ∀ κ : Fin M_menu,
      0 ≤ w_cap κ ∧ w_cap κ ≤ 2 * cls.K_hor ∧ ib_menu κ ≤ N_w ∧ ia_menu κ ≤ N_w := by
    intro κ
    obtain ⟨hibia, hiaNw, hb0, hba, haW, _⟩ := hmenu_props κ
    dsimp only at hb0 hba haW
    have hbK : b_menu κ ≤ cls.K_hor := le_trans hba (le_trans haW hW_le_K)
    have haK : a_menu κ ≤ cls.K_hor := le_trans haW hW_le_K
    refine ⟨?_, ?_, le_trans hibia hiaNw, hiaNw⟩
    · dsimp only [w_cap, pktWeight, b_menu, a_menu, w_of_menu]; nlinarith
    · dsimp only [w_cap, pktWeight]
      have h1 : (1 + γ) * b_menu κ ≤ (1 + γ) * cls.K_hor :=
        mul_le_mul_of_nonneg_left hbK (by linarith)
      have h2 : (1 - γ) * a_menu κ ≤ (1 - γ) * cls.K_hor :=
        mul_le_mul_of_nonneg_left haK (by linarith)
      linarith

  have h_all_cover_W : ∀ α : Fin N_atom, ∃ κ : Fin M_menu,
      α ∈ E_cap κ ∧ 2 * W_max ≤ w_cap κ := by
    intro α
    obtain ⟨κ, _, _, hbW, haW, hinc⟩ := hmenu_all_W α
    dsimp only at hbW haW hinc
    refine ⟨κ, (hE_cap_iff κ α).mpr hinc, ?_⟩
    dsimp only [w_cap, pktWeight, b_menu, a_menu, w_of_menu]
    rw [hbW, haW]
    linarith

  have h_greedy_each : ∀ m : { x // x ∈ MassKeys },
      ∃ (G_cnt : ℕ) (G_set : Fin G_cnt → Finset (Fin N_atom))
        (g_idx_of ib_of ia_of : Fin G_cnt → ℕ)
        (step_of : Fin N_atom → ℕ) (κ_of : Fin N_atom → Fin M_menu),
        1 ≤ G_cnt ∧ G_cnt ≤ M_grp ∧
        (∀ g : Fin G_cnt, (G_set g).Nonempty) ∧
        (∀ g₁ g₂ : Fin G_cnt, g₁ ≠ g₂ → Disjoint (G_set g₁) (G_set g₂)) ∧
        (Finset.univ.biUnion G_set = B_of m.1) ∧
        (∀ g : Fin G_cnt,
          let g_bin := ((g_idx_of g : ℝ) + 1) * ξ
          2 * W_max < g_bin ∧
          ib_of g ≤ N_w ∧ ia_of g ≤ N_w ∧
          (∀ α ∈ G_set g,
            in_cap (κ_of α) α ∧
            ib_menu (κ_of α) = ib_of g ∧
            ia_menu (κ_of α) = ia_of g ∧
            (∀ α' ∈ G_set g, step_of α = step_of α' → κ_of α = κ_of α')) ∧
          (∀ κ : Fin M_menu,
            (((G_set g) ∩ (E_cap κ)).card : ℝ) ≤ ε ^ (-g_bin + w_cap κ)) ∧
          (∀ α ∈ G_set g,
            ε ^ (-g_bin + w_cap (κ_of α) + ξ) ≤
              (((G_set g).filter (fun α' => step_of α' = step_of α)).card : ℝ))) := by
    intro m
    obtain ⟨α₀, _, hα₀_eq⟩ := Finset.mem_image.mp m.2
    have hBm_ne : (B_of m.1).Nonempty :=
      ⟨α₀, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hα₀_eq⟩⟩
    have hBm_card : ((B_of m.1).card : ℝ) ≤ ε ^ (-Q_cnt) := by
      have hle_N : ((B_of m.1).card : ℝ) ≤ (N_atom : ℝ) := by
        have := Finset.card_le_univ (B_of m.1)
        rw [Fintype.card_fin] at this
        exact_mod_cast this
      exact le_trans hle_N hN_le_Q
    obtain ⟨G_cnt, G_set, g_idx_of, ib_of, ia_of, step_of, κ_of,
      hG1, hG_le_raw, hG_ne, hG_disj, hG_biU, hG_props⟩ :=
      greedy_set_removal_and_grouping ε ξ (2 * W_max) (2 * cls.K_hor) Q_cnt
        hε₀ hε₁_half hξ (by linarith) (by linarith) hQ_cnt_nn
        N_atom M_menu N_w E_cap w_cap ib_menu ia_menu (B_of m.1)
        hBm_ne hBm_card hw_cap_bounds (fun α _ => h_all_cover_W α)
    have hG_le : G_cnt ≤ M_grp :=
      le_trans hG_le_raw (Nat.mul_le_mul_left _ (Nat.pow_le_pow_left hNw_succ_le 2))
    refine ⟨G_cnt, G_set, g_idx_of, ib_of, ia_of, step_of, κ_of,
      hG1, hG_le, hG_ne, hG_disj, hG_biU, fun g => ?_⟩
    obtain ⟨hg_lo, _, hib_g, hia_g, h_at, h_cap_hi, h_fib_lo⟩ := hG_props g
    refine ⟨hg_lo, hib_g, hia_g, ?_, h_cap_hi, h_fib_lo⟩
    intro α hαG
    obtain ⟨hαE, h1, h2, h3⟩ := h_at α hαG
    exact ⟨(hE_cap_iff _ _).mp hαE, h1, h2, h3⟩

  choose G_cnt G_set g_idx_of ib_of ia_of step_of κ_of hG_spec using h_greedy_each

  let p_at_atom : Fin N_atom → ℕ × (ℤ × ℤ) × (ℤ × ℤ) :=
    fun α => atomOutCell ε H_P t r τ_V τ_X j₀.1 (V_at α) (X_at α)
  let w_at_atom : Fin N_atom → ℤ × ℤ :=
    fun α => fineVelBin ε H_P t r d_dim τ_V n_fine (p_at_atom α) (V_at α)

  have h_vel_each : ∀ (m : { x // x ∈ MassKeys }) (g : Fin (G_cnt m)),
      ∃ (U_cnt : ℕ) (R_set : Fin U_cnt → Finset (Fin N_atom))
        (al_of : Fin U_cnt → Bool) (mk_of : Fin U_cnt → ℕ),
        1 ≤ U_cnt ∧ U_cnt ≤ M_vel ∧
        (∀ u : Fin U_cnt, (R_set u).Nonempty) ∧
        (∀ u₁ u₂ : Fin U_cnt, u₁ ≠ u₂ → Disjoint (R_set u₁) (R_set u₂)) ∧
        (Finset.univ.biUnion R_set = G_set m g) ∧
        (use_vel_sub = false → ∀ u : Fin U_cnt, R_set u = G_set m g) ∧
        (use_vel_sub = true → ∀ u : Fin U_cnt,
          let k_bin := (mk_of u : ℝ) * ξ
          mk_of u < Nat.ceil (((d_dim : ℝ) * h) / ξ) + 3 ∧
          (d_dim = 1 → ∀ α ∈ R_set u,
            (al_of u = true ↔
              projAngleDist (perp2D (e_menu (κ_of m α))) (n_fine (p_at_atom α)) ≤ 2 * ε ^ h)) ∧
          (∀ p_c w,
            (((R_set u).filter (fun α => p_at_atom α = p_c ∧ w_at_atom α = w)).card : ℝ) ≤
              ε ^ (k_bin - ξ) * (((R_set u).filter (fun α => p_at_atom α = p_c)).card : ℝ)) ∧
          (∀ p_buf,
            ((((R_set u).image (fun α => (p_at_atom α, w_at_atom α))).filter
              (fun pw => coarseOfFineCell M_L pw.1 = p_buf)).card : ℝ) ≤
              ((M_L ^ 4 : ℕ) : ℝ) * ε ^ (-(k_bin + ξ)))) := by
    intro m g
    cases h_uvs : use_vel_sub
    · refine ⟨1, fun _ => G_set m g, fun _ => false, fun _ => 0,
        le_rfl, h4_vel, fun _ => (hG_spec m).2.2.1 g, ?_, ?_, fun _ _ => rfl,
        fun ht => False.elim (Bool.false_ne_true ht)⟩
      · intro u₁ u₂ hne; exfalso; exact hne (Subsingleton.elim u₁ u₂)
      · ext α; simp
    · obtain ⟨hh_pos, hr_eq⟩ := hvel_h h_uvs
      have hG_card_Q : ((G_set m g).card : ℝ) ≤ ε ^ (-Q_cnt) := by
        have hle_N : ((G_set m g).card : ℝ) ≤ (N_atom : ℝ) := by
          have := Finset.card_le_univ (G_set m g)
          rw [Fintype.card_fin] at this
          exact_mod_cast this
        exact le_trans hle_N hN_le_Q
      obtain ⟨U_cnt, R_set, al_of, mk_of, hU1, hU_le_raw, hR_ne, hR_disj, hR_biU, hR_props⟩ :=
        two_stage_velocity_subdivision ε H_P t r h ξ Q_cnt d_dim M_L N_atom j₀.1
          τ_V τ_X n_buf V_at X_at (fun α => e_menu (κ_of m α)) (G_set m g)
          hε₀ hε₁_half hξ hh_pos hr_eq hQ_cnt_nn hd_dim hML hn_buf h_log16
          ((hG_spec m).2.2.1 g) hG_card_Q
      have hd_le2 : (d_dim : ℝ) ≤ 2 := by
        rcases hd_dim with rfl | rfl <;> norm_num
      have hdh_le_K : (d_dim : ℝ) * h ≤ cls.K_hor := by
        calc (d_dim : ℝ) * h ≤ 2 * h := mul_le_mul_of_nonneg_right hd_le2 hh_pos.le
          _ = t - r := by linarith [hr_eq]
          _ ≤ cls.K_hor := by linarith
      have hceil_le : Nat.ceil (((d_dim : ℝ) * h) / ξ) ≤ Nat.ceil (cls.K_hor / ξ) :=
        Nat.ceil_mono ((div_le_div_iff_of_pos_right hξ).mpr hdh_le_K)
      have hU_le : U_cnt ≤ M_vel :=
        le_trans hU_le_raw (Nat.mul_le_mul_left _ (Nat.add_le_add_right hceil_le 3))
      exact ⟨U_cnt, R_set, al_of, mk_of, hU1, hU_le, hR_ne, hR_disj, hR_biU,
        fun hf => False.elim (Bool.false_ne_true hf.symm), fun _ => hR_props⟩

  choose U_cnt R_set al_of mk_of hU_spec using h_vel_each

  let Idx := Σ (m : { x // x ∈ MassKeys }) (g : Fin (G_cnt m)), Fin (U_cnt m g)
  have : DecidableEq Idx := Classical.decEq Idx
  let S_loc : ℕ := Fintype.card Idx
  let eS : Idx ≃ Fin S_loc := Fintype.equivFin Idx
  let m_init : { x // x ∈ MassKeys } :=
    ⟨m_idx α_def, Finset.mem_image_of_mem m_idx (Finset.mem_univ _)⟩
  have hS_loc_ge1 : 1 ≤ S_loc := by
    let g₀ : Fin (G_cnt m_init) := ⟨0, (hG_spec m_init).1⟩
    let u₀ : Fin (U_cnt m_init g₀) := ⟨0, (hU_spec m_init g₀).1⟩
    have : Nonempty Idx := ⟨⟨m_init, g₀, u₀⟩⟩
    exact Fintype.card_pos
  have hS_loc_le_max : S_loc ≤ S_max := by
    have hcard_sig : S_loc =
        ∑ m : { x // x ∈ MassKeys }, ∑ g : Fin (G_cnt m), U_cnt m g := by
      dsimp only [S_loc, Idx]
      simp only [Fintype.card_sigma, Fintype.card_fin]
    rw [hcard_sig]
    have h_inner : ∀ m : { x // x ∈ MassKeys },
        ∑ g : Fin (G_cnt m), U_cnt m g ≤ M_grp * M_vel := by
      intro m
      calc ∑ g : Fin (G_cnt m), U_cnt m g
          ≤ ∑ _g : Fin (G_cnt m), M_vel :=
            Finset.sum_le_sum (fun g _ => (hU_spec m g).2.1)
        _ = G_cnt m * M_vel := by simp
        _ ≤ M_grp * M_vel := Nat.mul_le_mul_right M_vel (hG_spec m).2.1
    calc ∑ m : { x // x ∈ MassKeys }, ∑ g : Fin (G_cnt m), U_cnt m g
        ≤ ∑ _m : { x // x ∈ MassKeys }, M_grp * M_vel :=
          Finset.sum_le_sum (fun m _ => h_inner m)
      _ = MassKeys.card * (M_grp * M_vel) := by simp
      _ ≤ M_mass * (M_grp * M_vel) := Nat.mul_le_mul_right _ hMassKeys_card
      _ = S_max := (Nat.mul_assoc _ _ _).symm

  have hS_loc_log : Real.log (S_loc : ℝ) / ell ≤ R_bud / 64 := by
    have hlog_le : Real.log (S_loc : ℝ) ≤ Real.log (S_max : ℝ) :=
      Real.log_le_log (by exact_mod_cast hS_loc_ge1) (by exact_mod_cast hS_loc_le_max)
    exact le_trans ((div_le_div_iff_of_pos_right hell_pos).mpr hlog_le) h_log_Smax

  have h_card_filter_pb : ∀ (T : Finset (Fin N_atom))
      (P : Fin T.card → Prop) (Q : Fin N_atom → Prop)
      (dp : DecidablePred P) (dq : DecidablePred Q),
      let idx := fun α : Fin T.card => (T.equivFin.symm α).1
      (∀ α : Fin T.card, P α ↔ Q (idx α)) →
      (@Finset.filter _ P dp Finset.univ).card = (@Finset.filter _ Q dq T).card := by
    intro T P Q dp dq idx hPQ
    let eT := T.equivFin
    have hinj : Function.Injective idx := fun α₁ α₂ h => eT.symm.injective (Subtype.ext h)
    rw [← Finset.card_image_of_injective _ hinj]
    congr 1
    ext β
    simp only [Finset.mem_image, Finset.mem_filter, Finset.mem_univ, true_and]
    constructor
    · rintro ⟨α, hPα, rfl⟩
      exact ⟨(eT.symm α).2, (hPQ α).mp hPα⟩
    · rintro ⟨hβT, hQβ⟩
      refine ⟨eT ⟨β, hβT⟩, ?_, ?_⟩
      · rw [hPQ]; dsimp only [idx, eT]; rwa [Equiv.symm_apply_apply]
      · dsimp only [idx, eT]; rw [Equiv.symm_apply_apply]

  have h_image_pb : ∀ {γ_t : Type} (d1 d2 : DecidableEq γ_t) (T : Finset (Fin N_atom))
      (f : Fin T.card → γ_t) (g : Fin N_atom → γ_t),
      let idx := fun α : Fin T.card => (T.equivFin.symm α).1
      (∀ α : Fin T.card, f α = g (idx α)) →
      @Finset.image _ _ d1 f Finset.univ = @Finset.image _ _ d2 g T := by
    intro γ_t d1 d2 T f g idx hfg
    let eT := T.equivFin
    ext y
    simp only [Finset.mem_image, Finset.mem_univ, true_and]
    constructor
    · rintro ⟨α, rfl⟩
      exact ⟨idx α, (eT.symm α).2, (hfg α).symm⟩
    · rintro ⟨β, hβT, rfl⟩
      refine ⟨eT ⟨β, hβT⟩, ?_⟩
      rw [hfg]; dsimp only [idx, eT]; rw [Equiv.symm_apply_apply]

  let mkSub := fun (m : { x // x ∈ MassKeys }) (g : Fin (G_cnt m))
      (T : Finset (Fin N_atom)) (k_val : ℝ) (al_val : Bool) =>
    let eT := T.equivFin
    let idx := fun α : Fin T.card => (eT.symm α).1
    ({ loc_idx := j₀
       N_all := (G_set m g).card
       m_bin := m_bin_val m.1
       g_bin := ((g_idx_of m g : ℝ) + 1) * ξ
       b_loc := w_of_menu (ib_of m g)
       a_loc := w_of_menu (ia_of m g)
       k_bin := k_val
       is_aligned := al_val
       o_at := fun α => o_atom (idx α)
       ψ_at := fun α => ψ_atom (idx α)
       c_at := fun α => c_atom (idx α)
       cap_id := fun α => step_of m (idx α)
       e_cap := fun α => e_menu (κ_of m (idx α))
       V_cap := fun α => V_menu (κ_of m (idx α))
       X_cap := fun α => X_menu (κ_of m (idx α)) } : LocalizerSubclass T.card)

  have h_mkSub_valid : ∀ (m : { x // x ∈ MassKeys }) (g : Fin (G_cnt m))
      (T : Finset (Fin N_atom)) (k_val : ℝ) (al_val : Bool),
      T.Nonempty → T ⊆ G_set m g →
      IsValidSubclassAtoms cls M_atom γ ε H_P L t r b_star lam_sys ξ C_cov
        m_r m_t M_mult (fun M => 2 * C_tr_cut M) Φ₀ (mkSub m g T k_val al_val) := by
    intro m g T k_val al_val hT_ne hT_sub_G
    let sub := mkSub m g T k_val al_val
    let eT := T.equivFin
    let idx : Fin T.card → Fin N_atom := fun α => (eT.symm α).1
    have hidx_inj : Function.Injective idx := fun α₁ α₂ h => eT.symm.injective (Subtype.ext h)
    have hidx_T : ∀ α : Fin T.card, idx α ∈ T := fun α => (eT.symm α).2
    have hidx_G : ∀ α : Fin T.card, idx α ∈ G_set m g := fun α => hT_sub_G (hidx_T α)
    have hG_Bm : G_set m g ⊆ B_of m.1 := by
      intro β hβG
      rw [← (hG_spec m).2.2.2.2.1]
      exact Finset.mem_biUnion.mpr ⟨g, Finset.mem_univ g, hβG⟩
    obtain ⟨_, hib_g, hia_g, hG_at, hG_cap_hi, hG_fib_lo⟩ := (hG_spec m).2.2.2.2.2 g
    obtain ⟨α₀_G, hα₀_G⟩ := (hG_spec m).2.2.1 g
    obtain ⟨_, hib_α₀, hia_α₀, _⟩ := hG_at α₀_G hα₀_G
    obtain ⟨hibia_α₀, _, hb0_α₀, hba_α₀, haW_α₀, _⟩ := hmenu_props (κ_of m α₀_G)
    dsimp only at hb0_α₀ hba_α₀ haW_α₀
    rw [hib_α₀] at hb0_α₀ hba_α₀
    rw [hia_α₀] at hba_α₀ haW_α₀

    unfold IsValidSubclassAtoms
    let _ := Classical.propDecidable
    refine ⟨Finset.one_le_card.mpr hT_ne, Finset.card_le_card hT_sub_G, hqr_lt,
      hVJ_le, hXJ_le, Real.rpow_pos_of_pos hε₀ _, hb0_α₀, hba_α₀, haW_α₀, ?_, ?_, ?_, ?_, ?_⟩
    · intro α
      have hβG : idx α ∈ G_set m g := hidx_G α
      have hβB : idx α ∈ B_of m.1 := hG_Bm hβG
      have hm_eq : m_idx (idx α) = m.1 := by simpa [B_of] using hβB
      obtain ⟨_, hc_ge, hc_le⟩ := hm_atom_props (idx α)
      rw [hm_eq] at hc_ge hc_le
      obtain ⟨hinc, hib_α, hia_α, hstep_κ⟩ := hG_at (idx α) hβG
      obtain ⟨_, _, _, _, _, he_norm⟩ := hmenu_props (κ_of m (idx α))
      dsimp only [in_cap, b_menu, a_menu] at hinc
      rw [hib_α] at hinc
      rw [hia_α] at hinc
      exact ⟨(hψ_at (idx α)).1, (hψ_at (idx α)).2.1, (hψ_at (idx α)).2.2,
        (hVX'_tight (idx α)).1, (hVX'_tight (idx α)).2,
        hc_ge, hc_le, he_norm, hinc.1, hinc.2.1, hinc.2.2.1, hinc.2.2.2,
        fun α' hstep_eq => by
          have hκ_eq := hstep_κ (idx α') (hidx_G α') hstep_eq
          exact ⟨congr_arg e_menu hκ_eq, congr_arg V_menu hκ_eq, congr_arg X_menu hκ_eq⟩⟩
    · intro o₀
      have hc1 : (Finset.univ.filter (fun α : Fin T.card => sub.o_at α = o₀)).card =
          (T.filter (fun β => o_atom β = o₀)).card :=
        h_card_filter_pb T _ _ _ _ (fun _ => Iff.rfl)
      have hc2 : (T.filter (fun β => o_atom β = o₀)).card ≤
          (Finset.univ.filter (fun β : Fin N_atom => o_atom β = o₀)).card :=
        Finset.card_le_card (fun β hβ =>
          Finset.mem_filter.mpr ⟨Finset.mem_univ β, (Finset.mem_filter.mp hβ).2⟩)
      exact le_trans (by exact_mod_cast (hc1 ▸ hc2)) (hmult_at o₀)
    · let g_bin := ((g_idx_of m g : ℝ) + 1) * ξ
      let w_loc := pktWeight γ (w_of_menu (ib_of m g)) (w_of_menu (ia_of m g))
      let G := G_set m g
      let C_all : Finset ℕ := G.image (step_of m)
      have himg_T : (Finset.univ.image sub.cap_id).card ≤ C_all.card := by
        rw [h_image_pb _ _ T sub.cap_id (step_of m) (fun _ => rfl)]
        exact Finset.card_le_card (Finset.image_subset_image hT_sub_G)
      have hG_sum : (G.card : ℝ) =
          ∑ c ∈ C_all, (((G.filter (fun β => step_of m β = c)).card : ℝ)) := by
        have hc := Finset.card_eq_sum_card_image (step_of m) G
        exact_mod_cast hc
      have h_each_c : ∀ c ∈ C_all,
          ε ^ (-g_bin + w_loc + ξ) ≤
            (((G.filter (fun β => step_of m β = c)).card : ℝ)) := by
        intro c hc
        obtain ⟨β, hβG, rfl⟩ := Finset.mem_image.mp hc
        obtain ⟨_, hib_β, hia_β, _⟩ := hG_at β hβG
        have hw_eq : w_cap (κ_of m β) = w_loc := by
          dsimp only [w_cap, b_menu, a_menu, w_loc]
          rw [hib_β, hia_β]
        have hfib := hG_fib_lo β hβG
        rw [hw_eq] at hfib
        have hcard_eq : (G.filter (fun α' => step_of m α' = step_of m β)).card =
            (@Finset.filter _ (fun α' => step_of m α' = step_of m β)
              (fun _ => Nat.decEq _ _) G).card :=
          congr_arg Finset.card (by ext x; simp)
        rw [hcard_eq]
        exact hfib
      have hCall_mul : (C_all.card : ℝ) * ε ^ (-g_bin + w_loc + ξ) ≤ (G.card : ℝ) := by
        rw [hG_sum]
        have hs := Finset.sum_le_sum h_each_c
        rwa [Finset.sum_const, nsmul_eq_mul] at hs
      have hCall_le : (C_all.card : ℝ) ≤ (G.card : ℝ) * ε ^ (g_bin - w_loc - ξ) := by
        have hm := mul_le_mul_of_nonneg_right hCall_mul
          (Real.rpow_pos_of_pos hε₀ (g_bin - w_loc - ξ)).le
        have hcancel : (C_all.card : ℝ) * ε ^ (-g_bin + w_loc + ξ) * ε ^ (g_bin - w_loc - ξ) =
            (C_all.card : ℝ) := by
          rw [mul_assoc, ← Real.rpow_add hε₀]
          have hz : -g_bin + w_loc + ξ + (g_bin - w_loc - ξ) = 0 := by ring
          rw [hz, Real.rpow_zero, mul_one]
        rwa [hcancel] at hm
      have hexp_le : ε ^ (g_bin - w_loc - ξ) ≤ ε ^ (g_bin - w_loc - 2 * ξ) :=
        Real.rpow_le_rpow_of_exponent_ge hε₀ hε_lt1.le (by linarith)
      calc ((Finset.univ.image sub.cap_id).card : ℝ)
          ≤ (C_all.card : ℝ) := by exact_mod_cast himg_T
        _ ≤ (G.card : ℝ) * ε ^ (g_bin - w_loc - ξ) := hCall_le
        _ = 1 * (G.card : ℝ) * ε ^ (g_bin - w_loc - ξ) := by ring
        _ ≤ C_cov * (G.card : ℝ) * ε ^ (g_bin - w_loc - 2 * ξ) := by
            refine mul_le_mul
              (mul_le_mul_of_nonneg_right (by linarith [hC_cov_ge2]) (Nat.cast_nonneg _))
              hexp_le (Real.rpow_pos_of_pos hε₀ _).le
              (mul_nonneg (by linarith [hC_cov_ge2]) (Nat.cast_nonneg _))
    · intro b_F a_F R_F e_F V_F X_F hb₀ hba haW hRF heF
      let P_rot : Fin N_atom → Prop := fun β =>
        |inner ℝ (V'_at β - V_F) e_F| ≤ R_F * ε ^ b_F ∧
        |inner ℝ (V'_at β - V_F) (perp2D e_F)| ≤ R_F * ε ^ a_F ∧
        |inner ℝ (X'_at β - X_F) e_F| ≤ R_F * ε ^ b_F ∧
        |inner ℝ (X'_at β - X_F) (perp2D e_F)| ≤ R_F * ε ^ a_F
      let S_F : Finset (Fin N_atom) := T.filter P_rot
      have hcard_pb : (Finset.univ.filter (fun α : Fin T.card =>
          |inner ℝ (s_v⁻¹ • (gridPt2D ρ_r (sub.o_at α).1 - V_J) - V_F) e_F| ≤ R_F * ε ^ b_F ∧
          |inner ℝ (s_v⁻¹ • (gridPt2D ρ_r (sub.o_at α).1 - V_J) - V_F) (perp2D e_F)| ≤ R_F * ε ^ a_F ∧
          |inner ℝ (s_x⁻¹ • (gridPt2D σ_r (sub.o_at α).2 - X_J) - X_F) e_F| ≤ R_F * ε ^ b_F ∧
          |inner ℝ (s_x⁻¹ • (gridPt2D σ_r (sub.o_at α).2 - X_J) - X_F) (perp2D e_F)| ≤ R_F * ε ^ a_F)).card =
          S_F.card :=
        h_card_filter_pb T _ P_rot _ _ (fun _ => Iff.rfl)
      rw [hcard_pb]
      obtain ⟨M_cov, hMcov_card, hMcov_wt, hMcov_cov⟩ :=
        hmenu_cov b_F a_F R_F e_F V_F X_F S_F hb₀ hba haW hRF heF
          (fun β hβ => (Finset.mem_filter.mp hβ).2)
      let G := G_set m g
      let g_bin := ((g_idx_of m g : ℝ) + 1) * ξ
      have hSF_sub_biU : S_F ⊆ M_cov.biUnion (fun κ => G ∩ E_cap κ) := by
        intro β hβSF
        have hβT : β ∈ T := (Finset.mem_filter.mp hβSF).1
        obtain ⟨κ, hκM, hinc_β⟩ := hMcov_cov β hβSF
        exact Finset.mem_biUnion.mpr
          ⟨κ, hκM, Finset.mem_inter.mpr ⟨hT_sub_G hβT, (hE_cap_iff κ β).mpr hinc_β⟩⟩
      have hSF_nat : S_F.card ≤ ∑ κ ∈ M_cov, (G ∩ E_cap κ).card :=
        le_trans (Finset.card_le_card hSF_sub_biU) Finset.card_biUnion_le
      have h_each_κ : ∀ κ ∈ M_cov,
          (((G ∩ E_cap κ).card : ℝ)) ≤ ε ^ (-g_bin + pktWeight γ b_F a_F - 2 * ξ) := by
        intro κ hκ
        have h1 := hG_cap_hi κ
        have hwt := hMcov_wt κ hκ
        dsimp only at hwt
        have hcard_inter : (G ∩ E_cap κ).card =
            (@Inter.inter (Finset (Fin N_atom))
              (@Finset.instInter _ (instDecidableEqFin N_atom)) G (E_cap κ)).card :=
          congr_arg Finset.card (by ext x; simp)
        rw [hcard_inter]
        have hexp : ε ^ (-g_bin + w_cap κ) ≤ ε ^ (-g_bin + pktWeight γ b_F a_F - 2 * ξ) :=
          Real.rpow_le_rpow_of_exponent_ge hε₀ hε_lt1.le
            (by dsimp only [w_cap, b_menu, a_menu, w_of_menu]; linarith)
        exact le_trans h1 hexp
      calc (S_F.card : ℝ)
          ≤ ∑ κ ∈ M_cov, (((G ∩ E_cap κ).card : ℝ)) := by exact_mod_cast hSF_nat
        _ ≤ ∑ _κ ∈ M_cov, ε ^ (-g_bin + pktWeight γ b_F a_F - 2 * ξ) :=
              Finset.sum_le_sum h_each_κ
        _ = (M_cov.card : ℝ) * ε ^ (-g_bin + pktWeight γ b_F a_F - 2 * ξ) := by
              rw [Finset.sum_const, nsmul_eq_mul]
        _ ≤ (C_cov * R_F ^ 4) * ε ^ (-g_bin + pktWeight γ b_F a_F - 2 * ξ) := by
              refine mul_le_mul_of_nonneg_right ?_ (Real.rpow_pos_of_pos hε₀ _).le
              calc (M_cov.card : ℝ) ≤ C_menu * R_F ^ 4 := hMcov_card
                _ ≤ C_cov * R_F ^ 4 := mul_le_mul_of_nonneg_right hC_cov_menu (by positivity)
        _ = C_cov * R_F ^ 4 * ε ^ (-g_bin + pktWeight γ b_F a_F - 2 * ξ) := by ring
    · intro r_loc hrloc C_t V_o X_o ψ_o hVo hXo hψ1 hψ2 hψ3 pair_fn M_tr R_tr hM_tr hR_tr S_near_sub
      let P_cov : Fin N_atom → Prop := fun β =>
        ‖V_o - V_at β‖ ≤ C_cov * ρ_t ∧
        ‖X_o - X_at β - (C_t - C_r) • V_at β‖ ≤ C_cov * R_tr * σ_r
      let P_cut : Fin N_atom → Prop := fun β =>
        ‖V_o - V_at β‖ ≤ C_cut * ρ_t ∧
        ‖X_o - X_at β - (C_t - C_r) • V_at β‖ ≤ C_cut * R_tr * σ_r
      have h_img_T : Finset.univ.image idx = T :=
        h_image_pb _ _ T idx id (fun _ => rfl) |>.trans Finset.image_id
      have h_sum_T : (fun v => ∑ α : Fin T.card, sub.c_at α *
          ((ρ_r⁻¹ : ℂ) * star (sub.ψ_at α (ρ_r⁻¹ • (v - gridPt2D ρ_r (sub.o_at α).1))) *
            Complex.exp (-(Complex.I * ((lam_sys * Φ₀ (C_r, gridPt2D σ_r (sub.o_at α).2, v) : ℝ) : ℂ))))) =
          (fun v => ∑ β ∈ T, c_atom β * g_at β v) := by
        ext v
        conv_rhs => rw [← h_img_T]
        rw [Finset.sum_image (fun x _ y _ hxy => hidx_inj hxy)]
      have h_sum_near : (fun v => ∑ α ∈ S_near_sub, sub.c_at α *
          ((ρ_r⁻¹ : ℂ) * star (sub.ψ_at α (ρ_r⁻¹ • (v - gridPt2D ρ_r (sub.o_at α).1))) *
            Complex.exp (-(Complex.I * ((lam_sys * Φ₀ (C_r, gridPt2D σ_r (sub.o_at α).2, v) : ℝ) : ℂ))))) =
          (fun v => ∑ β ∈ T.filter P_cov, c_atom β * g_at β v) := by
        ext v
        have h_filt_eq : T.filter P_cov = S_near_sub.image idx := by
          conv_lhs => rw [← h_img_T]
          rw [Finset.filter_image]
        rw [h_filt_eq, Finset.sum_image (fun x _ y _ hxy => hidx_inj hxy)]
      have h_double_filt : (T.filter P_cov).filter P_cut = T.filter P_cut := by
        ext β
        simp only [Finset.mem_filter, P_cov, P_cut]
        constructor
        · exact fun h => ⟨h.1.1, h.2⟩
        · intro ⟨hβT, h1, h2⟩
          refine ⟨⟨hβT, ?_, ?_⟩, h1, h2⟩
          · exact le_trans h1 (mul_le_mul_of_nonneg_right hC_cov_cut hρ_t_pos.le)
          · exact le_trans h2 (mul_le_mul_of_nonneg_right
              (mul_le_mul_of_nonneg_right hC_cov_cut (by linarith)) hσ_r_pos.le)
      have htr1 := h_tr r_loc hrloc V_o X_o ψ_o hVo hXo hψ1 hψ2 hψ3 T M_tr R_tr hM_tr hR_tr
      have htr2 := h_tr r_loc hrloc V_o X_o ψ_o hVo hXo hψ1 hψ2 hψ3 (T.filter P_cov) M_tr R_tr hM_tr hR_tr
      dsimp only at htr1 htr2
      rw [h_double_filt] at htr2
      rw [h_sum_T, h_sum_near]
      let z₁ := pair_fn (fun v => ∑ β ∈ T, c_atom β * g_at β v)
      let z₂ := pair_fn (fun v => ∑ β ∈ T.filter P_cov, c_atom β * g_at β v)
      let z₀ := pair_fn (fun v => ∑ β ∈ T.filter P_cut, c_atom β * g_at β v)
      have hz_split : z₁ - z₂ = (z₁ - z₀) - (z₂ - z₀) := by ring
      calc ‖z₁ - z₂‖ = ‖(z₁ - z₀) - (z₂ - z₀)‖ := congr_arg norm hz_split
        _ ≤ ‖z₁ - z₀‖ + ‖z₂ - z₀‖ := norm_sub_le _ _
        _ ≤ C_tr_cut M_tr * R_tr ^ (1 - (M_tr : ℝ)) +
              C_tr_cut M_tr * R_tr ^ (1 - (M_tr : ℝ)) := add_le_add htr1 htr2
        _ = (2 * C_tr_cut M_tr) * R_tr ^ (1 - (M_tr : ℝ)) := by ring

  let idx_tup : Fin S_loc → Idx := fun s => eS.symm s
  let m_of_s : Fin S_loc → { x // x ∈ MassKeys } := fun s => (idx_tup s).1
  let g_of_s : ∀ s : Fin S_loc, Fin (G_cnt (m_of_s s)) := fun s => (idx_tup s).2.1
  let u_of_s : ∀ s : Fin S_loc, Fin (U_cnt (m_of_s s) (g_of_s s)) := fun s => (idx_tup s).2.2
  let G_of_s : Fin S_loc → Finset (Fin N_atom) := fun s => G_set (m_of_s s) (g_of_s s)
  let R_of_s : Fin S_loc → Finset (Fin N_atom) :=
    fun s => R_set (m_of_s s) (g_of_s s) (u_of_s s)
  have hR_sub_G : ∀ s : Fin S_loc, R_of_s s ⊆ G_of_s s := by
    intro s β hβR
    dsimp only [G_of_s]
    rw [← (hU_spec (m_of_s s) (g_of_s s)).2.2.2.2.1]
    exact Finset.mem_biUnion.mpr ⟨u_of_s s, Finset.mem_univ _, hβR⟩

  let N_all_loc : Fin S_loc → ℕ := fun s => (G_of_s s).card
  let N_ret_loc : Fin S_loc → ℕ := fun s => (R_of_s s).card
  let whole_loc : ∀ s : Fin S_loc, LocalizerSubclass (N_all_loc s) :=
    fun s => mkSub (m_of_s s) (g_of_s s) (G_of_s s) 0 false
  let sub_loc : ∀ s : Fin S_loc, LocalizerSubclass (N_ret_loc s) :=
    fun s => mkSub (m_of_s s) (g_of_s s) (R_of_s s)
      ((mk_of (m_of_s s) (g_of_s s) (u_of_s s) : ℝ) * ξ)
      (al_of (m_of_s s) (g_of_s s) (u_of_s s))
  let idx_all : ∀ s : Fin S_loc, Fin (N_all_loc s) → Fin N_atom :=
    fun s β => ((G_of_s s).equivFin.symm β).1
  let idx_ret : ∀ s : Fin S_loc, Fin (N_ret_loc s) → Fin N_atom :=
    fun s α => ((R_of_s s).equivFin.symm α).1
  let emb_loc : ∀ s : Fin S_loc, Fin (N_ret_loc s) → Fin (N_all_loc s) :=
    fun s α => (G_of_s s).equivFin ⟨idx_ret s α, hR_sub_G s ((R_of_s s).equivFin.symm α).2⟩

  have hidx_all_inj : ∀ s : Fin S_loc, Function.Injective (idx_all s) :=
    fun s β₁ β₂ h => (G_of_s s).equivFin.symm.injective (Subtype.ext h)
  have hidx_ret_inj : ∀ s : Fin S_loc, Function.Injective (idx_ret s) :=
    fun s α₁ α₂ h => (R_of_s s).equivFin.symm.injective (Subtype.ext h)
  have hidx_comp : ∀ (s : Fin S_loc) (α : Fin (N_ret_loc s)),
      idx_ret s α = idx_all s (emb_loc s α) := by
    intro s α
    dsimp only [idx_all, emb_loc]
    rw [Equiv.symm_apply_apply]
  have hemb_inj : ∀ s : Fin S_loc, Function.Injective (emb_loc s) := by
    intro s α₁ α₂ h
    have h1 := congr_arg (idx_all s) h
    rw [← hidx_comp s α₁, ← hidx_comp s α₂] at h1
    exact hidx_ret_inj s h1

  have hR_disj_s : ∀ s₁ s₂ : Fin S_loc, s₁ ≠ s₂ → Disjoint (R_of_s s₁) (R_of_s s₂) := by
    intro s₁ s₂ hne
    rw [Finset.disjoint_left]
    intro β hβ₁ hβ₂
    have hβG₁ : β ∈ G_of_s s₁ := hR_sub_G s₁ hβ₁
    have hβG₂ : β ∈ G_of_s s₂ := hR_sub_G s₂ hβ₂
    have hm_eq : m_of_s s₁ = m_of_s s₂ := by
      have hB₁ : β ∈ B_of (m_of_s s₁).1 := by
        rw [← (hG_spec (m_of_s s₁)).2.2.2.2.1]
        exact Finset.mem_biUnion.mpr ⟨g_of_s s₁, Finset.mem_univ _, hβG₁⟩
      have hB₂ : β ∈ B_of (m_of_s s₂).1 := by
        rw [← (hG_spec (m_of_s s₂)).2.2.2.2.1]
        exact Finset.mem_biUnion.mpr ⟨g_of_s s₂, Finset.mem_univ _, hβG₂⟩
      exact Subtype.ext ((Finset.mem_filter.mp hB₁).2.symm.trans (Finset.mem_filter.mp hB₂).2)
    rcases hm₁ : idx_tup s₁ with ⟨m₁_v, g₁_v, u₁_v⟩
    rcases hm₂ : idx_tup s₂ with ⟨m₂_v, g₂_v, u₂_v⟩
    have hm_v : m₁_v = m₂_v := by
      dsimp only [m_of_s] at hm_eq
      rwa [hm₁, hm₂] at hm_eq
    subst hm_v
    have hβG₁' : β ∈ G_set m₁_v g₁_v := by dsimp only [G_of_s, m_of_s, g_of_s] at hβG₁; rwa [hm₁] at hβG₁
    have hβG₂' : β ∈ G_set m₁_v g₂_v := by dsimp only [G_of_s, m_of_s, g_of_s] at hβG₂; rwa [hm₂] at hβG₂
    have hg_v : g₁_v = g₂_v := by
      by_contra hg_ne
      exact Finset.disjoint_left.mp ((hG_spec m₁_v).2.2.2.1 g₁_v g₂_v hg_ne) hβG₁' hβG₂'
    subst hg_v
    have hβR₁' : β ∈ R_set m₁_v g₁_v u₁_v := by
      dsimp only [R_of_s, m_of_s, g_of_s, u_of_s] at hβ₁; rwa [hm₁] at hβ₁
    have hβR₂' : β ∈ R_set m₁_v g₁_v u₂_v := by
      dsimp only [R_of_s, m_of_s, g_of_s, u_of_s] at hβ₂; rwa [hm₂] at hβ₂
    have hu_v : u₁_v = u₂_v := by
      by_contra hu_ne
      exact Finset.disjoint_left.mp ((hU_spec m₁_v g₁_v).2.2.2.1 u₁_v u₂_v hu_ne) hβR₁' hβR₂'
    subst hu_v
    have htup_eq : eS.symm s₁ = eS.symm s₂ := hm₁.trans hm₂.symm
    exact hne (eS.symm.injective htup_eq)

  have hR_biU_univ : Finset.univ.biUnion R_of_s = Finset.univ := by
    ext β
    simp only [Finset.mem_biUnion, Finset.mem_univ, iff_true]
    let m_β : { x // x ∈ MassKeys } := ⟨m_idx β, Finset.mem_image_of_mem m_idx (Finset.mem_univ β)⟩
    have hβB : β ∈ B_of m_β.1 := Finset.mem_filter.mpr ⟨Finset.mem_univ β, rfl⟩
    rw [← (hG_spec m_β).2.2.2.2.1] at hβB
    obtain ⟨g_β, _, hβG⟩ := Finset.mem_biUnion.mp hβB
    rw [← (hU_spec m_β g_β).2.2.2.2.1] at hβG
    obtain ⟨u_β, _, hβR⟩ := Finset.mem_biUnion.mp hβG
    let s_β : Fin S_loc := eS ⟨m_β, g_β, u_β⟩
    have htup : idx_tup s_β = ⟨m_β, g_β, u_β⟩ := Equiv.symm_apply_apply eS _
    refine ⟨s_β, ?_⟩
    have h_gen : ∀ p : Idx, p = ⟨m_β, g_β, u_β⟩ → β ∈ R_set p.1 p.2.1 p.2.2 := by
      rintro _ rfl; exact hβR
    exact ⟨trivial, h_gen (idx_tup s_β) htup⟩

  refine ⟨S_loc, N_all_loc, N_ret_loc, whole_loc, sub_loc, emb_loc, idx_all, idx_ret,
    hS_loc_ge1, hS_loc_log, ?_, ?_⟩
  · intro v
    have h_biU_sum : ∑ β : Fin N_atom, c_atom β * g_at β v =
        ∑ s : Fin S_loc, ∑ β ∈ R_of_s s, c_atom β * g_at β v := by
      conv_lhs => rw [← hR_biU_univ]
      exact Finset.sum_biUnion (fun s₁ _ s₂ _ hne => hR_disj_s s₁ s₂ hne)
    rw [h_biU_sum]
    refine Finset.sum_congr rfl (fun s _ => ?_)
    have h_img_R : Finset.univ.image (idx_ret s) = R_of_s s :=
      h_image_pb _ _ (R_of_s s) (idx_ret s) id (fun _ => rfl) |>.trans Finset.image_id
    conv_lhs => rw [← h_img_R]
    rw [Finset.sum_image (fun x _ y _ hxy => hidx_ret_inj s hxy)]
  · let _ := Classical.propDecidable
    intro s
    let m := m_of_s s
    let g := g_of_s s
    let u := u_of_s s
    obtain ⟨hg_lo, _, _, hG_at, _, hG_fib_lo⟩ := (hG_spec m).2.2.2.2.2 g
    refine ⟨rfl, rfl, rfl, rfl, hemb_inj s, hidx_all_inj s, hidx_ret_inj s,
      hidx_comp s, fun _ => ⟨rfl, rfl, rfl⟩, rfl, rfl, rfl, rfl, ?_,
      h_mkSub_valid m g (R_of_s s) _ _ ((hU_spec m g).2.2.1 u) (hR_sub_G s),
      h_mkSub_valid m g (G_of_s s) _ _ ((hG_spec m).2.2.1 g) Finset.Subset.rfl,
      ?_, ?_, ?_, ?_⟩
    · intro α
      have hc := hidx_comp s α
      exact ⟨congr_arg o_atom hc, congr_arg ψ_atom hc, congr_arg c_atom hc,
        congr_arg (step_of m) hc,
        congr_arg (fun β => e_menu (κ_of m β)) hc,
        congr_arg (fun β => V_menu (κ_of m β)) hc,
        congr_arg (fun β => X_menu (κ_of m β)) hc⟩
    · intro β
      have hβG : idx_all s β ∈ G_of_s s := ((G_of_s s).equivFin.symm β).2
      obtain ⟨_, hib_β, hia_β, _⟩ := hG_at (idx_all s β) hβG
      have hw_eq : w_cap (κ_of m (idx_all s β)) =
          pktWeight γ ((whole_loc s).b_loc) ((whole_loc s).a_loc) := by
        dsimp only [w_cap, b_menu, a_menu, whole_loc, mkSub]
        rw [hib_β, hia_β]
      have hfib := hG_fib_lo (idx_all s β) hβG
      rw [hw_eq] at hfib
      have hc_pb : (Finset.univ.filter (fun β' : Fin (N_all_loc s) =>
          (whole_loc s).cap_id β' = (whole_loc s).cap_id β)).card =
          (@Finset.filter _ (fun α' => step_of m α' = step_of m (idx_all s β))
            (fun _ => Nat.decEq _ _) (G_set m g)).card :=
        h_card_filter_pb (G_of_s s) _ _ _ _ (fun _ => Iff.rfl)
      rw [hc_pb]
      dsimp only [whole_loc, mkSub, m, g]
      exact hfib
    · change 2 * W_max - R_bud ≤ ((g_idx_of m g : ℝ) + 1) * ξ
      linarith [hg_lo, hR_bud_pos]
    · intro huvs_f
      dsimp only [N_ret_loc, N_all_loc, R_of_s, G_of_s]
      rw [(hU_spec m g).2.2.2.2.2.1 huvs_f u]
    · intro huvs_t
      obtain ⟨hmk_lt, hal_iff, h_pcw, h_pbuf⟩ := (hU_spec m g).2.2.2.2.2.2 huvs_t u
      refine ⟨⟨mk_of m g u, hmk_lt, rfl⟩, ?_, ?_, ?_⟩
      · intro hd1 α
        exact hal_iff hd1 (idx_ret s α) (((R_of_s s).equivFin.symm α).2)
      · intro p_c w
        refine le_trans ?_ (le_trans (h_pcw p_c w) ?_)
        · apply le_of_eq
          congr 1
          exact h_card_filter_pb (R_of_s s) _ _ _ _ (fun _ => Iff.rfl)
        · apply le_of_eq
          dsimp only [sub_loc, mkSub, m, g, u]
          congr 2
          exact (h_card_filter_pb (R_of_s s) _ _ _ _ (fun _ => Iff.rfl)).symm
      · intro p_buf
        refine le_trans ?_ (le_trans (h_pbuf p_buf) (le_of_eq rfl))
        apply le_of_eq
        congr 1
        apply congr_arg Finset.card
        ext pw
        simp only [Finset.mem_filter, Finset.mem_image, Finset.mem_univ, true_and]
        refine ⟨?_, ?_⟩
        · rintro ⟨⟨α, rfl⟩, hc⟩
          exact ⟨⟨idx_ret s α, ((R_of_s s).equivFin.symm α).2, rfl⟩, hc⟩
        · rintro ⟨⟨β, hβR, rfl⟩, hc⟩
          refine ⟨⟨(R_of_s s).equivFin ⟨β, hβR⟩, ?_⟩, hc⟩
          have h_eq : idx_ret s ((R_of_s s).equivFin ⟨β, hβR⟩) = β := by
            dsimp only [idx_ret]; rw [Equiv.symm_apply_apply]
          dsimp only [sub_loc, mkSub, p_at_atom, w_at_atom]
          change (atomOutCell ε H_P t r τ_V τ_X j₀.1
              (V_at (idx_ret s ((R_of_s s).equivFin ⟨β, hβR⟩)))
              (X_at (idx_ret s ((R_of_s s).equivFin ⟨β, hβR⟩))),
            fineVelBin ε H_P t r d_dim τ_V n_fine
              (atomOutCell ε H_P t r τ_V τ_X j₀.1
                (V_at (idx_ret s ((R_of_s s).equivFin ⟨β, hβR⟩)))
                (X_at (idx_ret s ((R_of_s s).equivFin ⟨β, hβR⟩))))
              (V_at (idx_ret s ((R_of_s s).equivFin ⟨β, hβR⟩)))) = _
