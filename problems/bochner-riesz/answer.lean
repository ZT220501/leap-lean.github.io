      have h_root1_eq :
          classicalRootSupremum (ε ^ t) (1 + e_raw / t) γ N_ω N_T π T_idx V_part A_part =
            sSup S₁ := rfl
      have h_roott_eq :
          classicalRootSupremum ε (e_raw + t) γ N_ω N_T π T_idx V_part A_part =
            sSup S_t := rfl
      have h_set_eq : S₁ = (fun y => t⁻¹ * y) '' S_t := by
        ext s'
        simp only [Set.mem_image]
        constructor
        · rintro ⟨N_D, b'_D, a'_D, e_D, V_D, A_D, q, hd_adm, hq_nn, hq_row, hq_geom, hs'_eq⟩
          let b_D : Fin N_D → ℝ := fun d => t * b'_D d
          let a_D : Fin N_D → ℝ := fun d => t * a'_D d
          let q_D : Fin N_D → ℝ := fun d => ∑ tid : Fin N_T, q tid d
          let num : ℝ := ∑ tid : Fin N_T, ∑ d : Fin N_D,
            q tid d * Real.log (q tid d / (p_T tid * q_D d))
          let E_w_t : ℝ := ∑ d : Fin N_D, q_D d * ((1 + γ) * b_D d + (1 - γ) * a_D d)
          refine ⟨E_w_t - num / Real.log (ε⁻¹), ?_, ?_⟩
          · refine ⟨N_D, b_D, a_D, e_D, V_D, A_D, q, ?_, hq_nn, hq_row, ?_, rfl⟩
            · intro d
              obtain ⟨hb0, hba, ha_ub, he1⟩ := hd_adm d
              have ha_t : t * a'_D d ≤ e_raw + t := by
                have hm := mul_le_mul_of_nonneg_left ha_ub ht.le
                have hrhs : t * (1 + e_raw / t) = e_raw + t := by field_simp [ht_ne]; ring
                rwa [hrhs] at hm
              exact ⟨mul_nonneg ht.le hb0, mul_le_mul_of_nonneg_left hba ht.le, ha_t, he1⟩
            · intro tid d hq_pos
              obtain ⟨hc1, hc2, hc3, hc4⟩ := hq_geom tid d hq_pos
              rw [← Real.rpow_mul hε0.le] at hc1 hc2 hc3 hc4
              exact ⟨hc1, hc2, hc3, hc4⟩
          · dsimp only at hs'_eq
            rw [hs'_eq]
            have hEw : E_w_t = t * ∑ d : Fin N_D, q_D d *
                ((1 + γ) * b'_D d + (1 - γ) * a'_D d) := by
              dsimp only [E_w_t, b_D, a_D]
              rw [Finset.mul_sum]
              refine Finset.sum_congr rfl (fun d _ => ?_)
              ring
            rw [hEw, h_div_scale num]
            dsimp only [q_D, num]
            field_simp [ht_ne]
        · rintro ⟨s, ⟨N_D, b_D, a_D, e_D, V_D, A_D, q, hd_adm, hq_nn, hq_row, hq_geom, hs_eq⟩, rfl⟩
          let b'_D : Fin N_D → ℝ := fun d => b_D d / t
          let a'_D : Fin N_D → ℝ := fun d => a_D d / t
          let q_D : Fin N_D → ℝ := fun d => ∑ tid : Fin N_T, q tid d
          let num : ℝ := ∑ tid : Fin N_T, ∑ d : Fin N_D,
            q tid d * Real.log (q tid d / (p_T tid * q_D d))
          refine ⟨N_D, b'_D, a'_D, e_D, V_D, A_D, q, ?_, hq_nn, hq_row, ?_, ?_⟩
          · intro d
            obtain ⟨hb0, hba, ha_ub, he1⟩ := hd_adm d
            have ha_div : a_D d / t ≤ 1 + e_raw / t := by
              calc a_D d / t ≤ (e_raw + t) / t := div_le_div_of_nonneg_right ha_ub ht.le
                _ = 1 + e_raw / t := by field_simp [ht_ne]; ring
            exact ⟨div_nonneg hb0 ht.le, div_le_div_of_nonneg_right hba ht.le, ha_div, he1⟩
          · intro tid d hq_pos
            obtain ⟨hc1, hc2, hc3, hc4⟩ := hq_geom tid d hq_pos
            have hrpow : ∀ u : ℝ, (ε ^ t) ^ (u / t) = ε ^ u := by
              intro u
              rw [← Real.rpow_mul hε0.le, mul_div_cancel₀ _ ht_ne]
            dsimp only [b'_D, a'_D]
            rw [hrpow, hrpow]
            exact ⟨hc1, hc2, hc3, hc4⟩
          · dsimp only at hs_eq ⊢
            rw [hs_eq]
            have hEw : (∑ d : Fin N_D, q_D d * ((1 + γ) * b'_D d + (1 - γ) * a'_D d)) =
                t⁻¹ * ∑ d : Fin N_D, q_D d * ((1 + γ) * b_D d + (1 - γ) * a_D d) := by
              dsimp only [b'_D, a'_D]
              rw [Finset.mul_sum]
              refine Finset.sum_congr rfl (fun d _ => ?_)
              field_simp [ht_ne]
            rw [hEw, h_div_scale num]
            ring
      open scoped Pointwise in
      have h_smul : (fun y => t⁻¹ * y) '' S_t = t⁻¹ • S_t := rfl
      rw [h_root1_eq, h_roott_eq, h_set_eq, h_smul,
        Real.sSup_smul_of_nonneg (inv_nonneg.mpr ht.le), smul_eq_mul]

  
  let β : ℝ := classicalGrowthRate γ
  have hβ_pos : 0 < β := lt_trans hγ₀ h_gt
  have h_bdd : BddBelow (ValidClassicalGrowthRates γ) := ⟨0, fun _ hb => hb.1⟩
  have hβ_le2 : β ≤ 2 := csInf_le h_bdd h_two
  let η₀ : ℝ := min (β / 2) (η / 2)
  have hη₀_pos : 0 < η₀ := lt_min (half_pos hβ_pos) (half_pos hη)
  have hη₀_le_β : η₀ ≤ β / 2 := min_le_left _ _
  have hη₀_le_η : η₀ ≤ η / 2 := min_le_right _ _
  let b_low : ℝ := β - η₀
  have hb_low_nn : 0 ≤ b_low := by dsimp only [b_low]; linarith
  have hb_low_le2 : b_low ≤ 2 := by dsimp only [b_low]; linarith
  have h_gap : β - η ≤ b_low := by dsimp only [b_low]; linarith

  
  by_contra h_no_sat
  have hb_mem : b_low ∈ ValidClassicalGrowthRates γ := by
    refine ⟨hb_low_nn, hb_low_le2, ?_⟩
    intro B_cl K_hor t_min δ_cl hB hK ht_min ht_K hδ
    let E_max : ℝ := max 1 (K_hor / t_min)
    have hE_max : 1 ≤ E_max := le_max_left 1 (K_hor / t_min)
    have h_ex_cap : ∃ ε_cap : ℝ, 0 < ε_cap ∧ ε_cap < 1 / 2 ∧
        ∀ (ε' e' : ℝ) (N_ω N_T : ℕ)
          (π' : Fin N_ω → ℝ)
          (T_idx : Fin N_ω → Fin N_T)
          (V' A' : Fin N_T → EuclideanSpace ℝ (Fin 2))
          (c_s θ_s : Fin N_ω → ℝ),
          0 < ε' → ε' < ε_cap → 0 ≤ e' → e' ≤ E_max →
          IsUnitBallStdLaw π' V' A' c_s θ_s →
          stdApertureScore ε' γ 1 0 e' π' T_idx V' A' c_s θ_s <
            classicalRootSupremum ε' (1 + e') γ N_ω N_T π' T_idx V' A' + β - η := by
      by_contra h_all
      apply h_no_sat
      refine ⟨E_max, hE_max, fun ε_cap h0 h1 => ?_⟩
      by_contra h_no_wit
      apply h_all
      refine ⟨ε_cap, h0, h1, fun ε' e' N_ω N_T π' T_idx V' A' c_s θ_s
        hε'0 hε'1 he'0 he'1 h_law => lt_of_not_ge fun h_ge => h_no_wit ?_⟩
      exact ⟨ε', e', N_ω, N_T, π', T_idx, V', A', c_s, θ_s,
        hε'0, hε'1, he'0, he'1, h_law, h_ge⟩
    obtain ⟨ε_cap, hε_cap0, hε_cap1, h_no_wit⟩ := h_ex_cap
    let ξ : ℝ := δ_cl * t_min / 4
    have hξ_pos : 0 < ξ := by dsimp only [ξ]; positivity
    let C₁ : ℝ := 4 * Real.log ((2 * ⌈B_cl⌉₊ + 1 : ℕ) : ℝ) +
      4 * Real.log ((⌊K_hor / ξ⌋₊ + 1 : ℕ) : ℝ) + 1
    let C₂ : ℝ := 2 * Real.log ((2 * ⌈B_cl⌉₊ + 2 : ℕ) : ℝ) + 12
    let C_tot : ℝ := C₁ + C₂ + 23
    have hC_tot_pos : 0 < C_tot := by
      have hlog1 : 0 ≤ Real.log ((2 * ⌈B_cl⌉₊ + 1 : ℕ) : ℝ) :=
        Real.log_nonneg (by exact_mod_cast (by omega : 1 ≤ 2 * ⌈B_cl⌉₊ + 1))
      have hlog2 : 0 ≤ Real.log ((⌊K_hor / ξ⌋₊ + 1 : ℕ) : ℝ) :=
        Real.log_nonneg (by exact_mod_cast (by omega : 1 ≤ ⌊K_hor / ξ⌋₊ + 1))
      have hlog3 : 0 ≤ Real.log ((2 * ⌈B_cl⌉₊ + 2 : ℕ) : ℝ) :=
        Real.log_nonneg (by exact_mod_cast (by omega : 1 ≤ 2 * ⌈B_cl⌉₊ + 2))
      dsimp only [C_tot, C₁, C₂]
      linarith
    let ε₀ : ℝ :=
      min (min (1 / 4) (ε_cap ^ (t_min⁻¹))) (Real.exp (-(2 * C_tot / (δ_cl * t_min))))
    have hε₀_pos : 0 < ε₀ :=
      lt_min (lt_min (by norm_num) (Real.rpow_pos_of_pos hε_cap0 _)) (Real.exp_pos _)
    have hε₀_lt : ε₀ < 1 / 2 :=
      lt_of_le_of_lt (le_trans (min_le_left _ _) (min_le_left _ _)) (by norm_num)
    refine ⟨ε₀, hε₀_pos, hε₀_lt, ?_⟩
    intro ε t L Δ_time hε0 hε_lt_ε₀ ht_ge htL hLK hΔ_lo _hΔ_hi
      N_ω N_T N_G π T_idx k_time G_idx V_part A_part b_G a_G e_G V_G X_G k_G
      hπ_nn hπ_sum hVA hG_adm h_supp
    have ht_pos : 0 < t := lt_of_lt_of_le ht_min ht_ge
    have hε_lt_qtr : ε < 1 / 4 :=
      lt_of_lt_of_le hε_lt_ε₀ (le_trans (min_le_left _ _) (min_le_left _ _))
    have hε_lt_rpow : ε < ε_cap ^ (t_min⁻¹) :=
      lt_of_lt_of_le hε_lt_ε₀ (le_trans (min_le_left _ _) (min_le_right _ _))
    have hε_lt_exp : ε < Real.exp (-(2 * C_tot / (δ_cl * t_min))) :=
      lt_of_lt_of_le hε_lt_ε₀ (min_le_right _ _)
    have hε_lt_half : ε < 1 / 2 := by linarith
    have hε_le_one : ε ≤ 1 := by linarith
    have hεt_pos : 0 < ε ^ t := Real.rpow_pos_of_pos hε0 t
    have hεt_lt_cap : ε ^ t < ε_cap := by
      have h1 : ε ^ t ≤ ε ^ t_min := Real.rpow_le_rpow_of_exponent_ge hε0 hε_le_one ht_ge
      have h2 : ε ^ t_min < (ε_cap ^ (t_min⁻¹)) ^ t_min :=
        Real.rpow_lt_rpow hε0.le hε_lt_rpow ht_min
      have h3 : (ε_cap ^ (t_min⁻¹)) ^ t_min = ε_cap := by
        rw [← Real.rpow_mul hε_cap0.le, inv_mul_cancel₀ ht_min.ne', Real.rpow_one]
      linarith
    let ell : ℝ := Real.log (ε⁻¹)
    have h_err_tot : C_tot / ell ≤ (δ_cl / 2) * t := by
      have hlog_lt : Real.log ε < -(2 * C_tot / (δ_cl * t_min)) := by
        calc Real.log ε < Real.log (Real.exp (-(2 * C_tot / (δ_cl * t_min)))) :=
              Real.log_lt_log hε0 hε_lt_exp
          _ = -(2 * C_tot / (δ_cl * t_min)) := Real.log_exp _
      have hell_eq : ell = -Real.log ε := Real.log_inv ε
      have hδt_pos : 0 < δ_cl * t_min := mul_pos hδ ht_min
      have hdiv_pos : 0 < 2 * C_tot / (δ_cl * t_min) := div_pos (by linarith) hδt_pos
      have hell_gt : 2 * C_tot / (δ_cl * t_min) < ell := by linarith
      have hell_pos : 0 < ell := lt_trans hdiv_pos hell_gt
      have hmul_gt : 2 * C_tot < ell * (δ_cl * t_min) := (div_lt_iff₀ hδt_pos).mp hell_gt
      have h_le_min : C_tot / ell ≤ (δ_cl / 2) * t_min :=
        (div_le_iff₀ hell_pos).mpr (by linarith)
      exact le_trans h_le_min (mul_le_mul_of_nonneg_left ht_ge (by positivity))
    have h2ξ_le : 2 * ξ ≤ (δ_cl / 2) * t := by
      have h_eq : 2 * ξ = (δ_cl / 2) * t_min := by dsimp only [ξ]; ring
      rw [h_eq]
      exact mul_le_mul_of_nonneg_left ht_ge (by positivity)
    obtain ⟨b_star, a_star, π₁, V₁, A₁, V_G1, X_G1,
        hb₀, hba, hat_L, hπ₁_nn, hπ₁_sum, hVA₁, h_supp₁, h_s1⟩ :=
      unit_ball_mesh_shape_reduction γ B_cl K_hor ε t L Δ_time ξ
        hγ₀ hγ₁ hB hK hε0 hε_lt_half ht_pos htL hLK hξ_pos
        π T_idx k_time G_idx V_part A_part b_G a_G e_G V_G X_G k_G
        hπ_nn hπ_sum hVA hG_adm h_supp
    obtain ⟨c_s, θ_s, h_law₁, h_s2⟩ :=
      fixed_shape_to_std_aperture_transfer γ B_cl ε t Δ_time b_star a_star
        hγ₀ hγ₁ hB hε0 hε_lt_half ht_pos hΔ_lo hb₀ hba
        π₁ T_idx k_time G_idx V₁ A₁ e_G V_G1 X_G1 k_G
        hπ₁_nn hπ₁_sum hVA₁ (fun g => (hG_adm g).2.2.2) h_supp₁
    obtain ⟨π₂, V₂, A₂, h_law₂, h_s3⟩ :=
      isotropic_prefix_std_localization γ ε t b_star a_star
        hγ₀ hγ₁ hε0 hε_lt_half ht_pos hb₀ hba
        π₁ T_idx V₁ A₁ c_s θ_s h_law₁
    let e_raw : ℝ := a_star - b_star
    let e' : ℝ := e_raw / t
    have he_raw_nn : 0 ≤ e_raw := sub_nonneg.mpr hba
    have he'_nn : 0 ≤ e' := div_nonneg he_raw_nn ht_pos.le
    have he'_ub : e' ≤ E_max := by
      have he_raw_le : e_raw ≤ K_hor := by
        dsimp only [e_raw]
        linarith
      have h1 : e_raw / t ≤ K_hor / t := div_le_div_of_nonneg_right he_raw_le ht_pos.le
      have h2 : K_hor / t ≤ K_hor / t_min :=
        div_le_div_of_nonneg_left (by linarith) ht_min ht_ge
      exact le_trans h1 (le_trans h2 (le_max_right 1 (K_hor / t_min)))
    obtain ⟨h_sc_score, h_sc_root⟩ :=
      h_dur_scale ε t e_raw hε0 ht_pos π₂ T_idx V₂ A₂ c_s θ_s
    have h_exc_scale :
        stdApertureScore ε γ t 0 e_raw π₂ T_idx V₂ A₂ c_s θ_s -
          classicalRootSupremum ε (e_raw + t) γ N_ω N_T π₂ T_idx V₂ A₂ =
        t * (stdApertureScore (ε ^ t) γ 1 0 e' π₂ T_idx V₂ A₂ c_s θ_s -
          classicalRootSupremum (ε ^ t) (1 + e') γ N_ω N_T π₂ T_idx V₂ A₂) := by
      dsimp only [e'] at h_sc_score h_sc_root ⊢
      rw [h_sc_score, h_sc_root]
      field_simp [ht_pos.ne']
    have h_viol_inst :=
      h_no_wit (ε ^ t) e' N_ω N_T π₂ T_idx V₂ A₂ c_s θ_s
        hεt_pos hεt_lt_cap he'_nn he'_ub h_law₂
    have h_exc_ub :
        t * (stdApertureScore (ε ^ t) γ 1 0 e' π₂ T_idx V₂ A₂ c_s θ_s -
          classicalRootSupremum (ε ^ t) (1 + e') γ N_ω N_T π₂ T_idx V₂ A₂) ≤
        b_low * t := by
      have h_diff_le :
          stdApertureScore (ε ^ t) γ 1 0 e' π₂ T_idx V₂ A₂ c_s θ_s -
            classicalRootSupremum (ε ^ t) (1 + e') γ N_ω N_T π₂ T_idx V₂ A₂ ≤ b_low := by
        linarith
      calc t * (stdApertureScore (ε ^ t) γ 1 0 e' π₂ T_idx V₂ A₂ c_s θ_s -
              classicalRootSupremum (ε ^ t) (1 + e') γ N_ω N_T π₂ T_idx V₂ A₂)
          ≤ t * b_low := mul_le_mul_of_nonneg_left h_diff_le ht_pos.le
        _ = b_low * t := mul_comm t b_low
    have h_sum_C : C₁ / ell + C₂ / ell + 23 / ell = C_tot / ell := by
      dsimp only [C_tot]
      ring
    dsimp only [C₁, C₂, ell] at h_sum_C
    dsimp only [ell] at h_err_tot
    dsimp only [e_raw] at h_exc_scale
    linarith [h_s1, h_s2, h_s3, h_exc_scale, h_exc_ub, h_sum_C, h_err_tot, h2ξ_le]

  
  have h_le : classicalGrowthRate γ ≤ b_low := csInf_le h_bdd hb_mem
  dsimp only [b_low, β] at h_le
  linarith [h_le, hη₀_pos]

theorem std_root_coarsening_info_bound (γ ε e : ℝ) (hγ₀ : 0 < γ) (hγ₁ : γ < 1)
    (hε₀ : 0 < ε) (hε₁ : ε < 1 / 2) (he₀ : 0 < e)
    {N_ω N_T : ℕ}
    (π : Fin N_ω → ℝ) (T_idx : Fin N_ω → Fin N_T)
    (V_part A_part : Fin N_T → EuclideanSpace ℝ (Fin 2))
    (c_s θ_s : Fin N_ω → ℝ)
    (h_law : IsUnitBallStdLaw π V_part A_part c_s θ_s)
    (h_exc : classicalRootSupremum ε (1 + e) γ N_ω N_T π T_idx V_part A_part ≤
      stdApertureScore ε γ 1 0 e π T_idx V_part A_part c_s θ_s) :
    finMutualInfo ε π T_idx
        (fun ω => stdRootObs ε e (V_part (T_idx ω)) (A_part (T_idx ω)) (θ_s ω)) ≤
      (1 - γ) * e -
        classicalRootSupremum ε (1 + e) γ N_ω N_T π T_idx V_part A_part +
        2 + 6 / Real.log (ε⁻¹) :=
by
  have _ := he₀
  obtain ⟨hπ_nn, hπ_sum, hVA_norm, h_supp⟩ := h_law
  have hε_lt_one : ε < 1 := by linarith
  have h1_lt_inv : 1 < ε⁻¹ := (one_lt_inv₀ hε₀).mpr hε_lt_one
  let ell : ℝ := Real.log (ε⁻¹)
  have hell_pos : 0 < ell := Real.log_pos h1_lt_inv
  have hlog2_pos : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hlog2_le1 : Real.log 2 ≤ 1 := by
    linarith [Real.log_le_sub_one_of_pos (by norm_num : (0 : ℝ) < 2)]
  let k_t : Fin N_ω → ℤ := fun ω => dyadicTimeBin ε 1 (c_s ω)
  let G_std : Fin N_ω → ℤ × ℤ × ℤ × ℤ × ℤ × ℤ :=
    fun ω => stdApertureObs ε 1 0 e (V_part (T_idx ω)) (A_part (T_idx ω)) (c_s ω) (θ_s ω)
  let D_obs : Fin N_ω → ℤ × ℤ × ℤ × ℤ × ℤ :=
    fun ω => stdRootObs ε e (V_part (T_idx ω)) (A_part (T_idx ω)) (θ_s ω)
  let τ : ℝ := classicalRootSupremum ε (1 + e) γ N_ω N_T π T_idx V_part A_part
  have h_score : finMutualInfo ε π T_idx G_std ≤
      (1 - γ) * e - τ + 2 * finCondEntropy ε π T_idx k_t := by
    have h_unfold : stdApertureScore ε γ 1 0 e π T_idx V_part A_part c_s θ_s =
        ((1 + γ) * 0 + (1 - γ) * e) - finMutualInfo ε π T_idx G_std +
          2 * finCondEntropy ε π T_idx k_t := rfl
    change τ ≤ stdApertureScore ε γ 1 0 e π T_idx V_part A_part c_s θ_s at h_exc
    rw [h_unfold] at h_exc
    linarith
  let F_pos : Finset (Fin N_ω) :=
    @Finset.filter (Fin N_ω) (fun ω => 0 < π ω) (fun _ => Classical.propDecidable _) Finset.univ
  have hF_pos : ∀ ω : Fin N_ω, ω ∈ F_pos ↔ 0 < π ω := by
    intro ω
    rw [@Finset.mem_filter _ _ (fun _ => Classical.propDecidable _)]
    simp
  have hπ_zero : ∀ ω : Fin N_ω, ω ∉ F_pos → π ω = 0 := by
    intro ω hω
    have h_not_pos : ¬ 0 < π ω := fun hp => hω ((hF_pos ω).mpr hp)
    linarith [hπ_nn ω]
  have h_sum_F_pos : ∀ g : Fin N_ω → ℝ,
      (∑ ω : Fin N_ω, π ω * g ω) = ∑ ω ∈ F_pos, π ω * g ω := by
    intro g
    refine (Finset.sum_subset (Finset.subset_univ F_pos) (fun ω _ hω => ?_)).symm
    rw [hπ_zero ω hω, zero_mul]
  have hF_pos_sum1 : ∑ ω ∈ F_pos, π ω = 1 := by
    have h1 := h_sum_F_pos (fun _ => 1)
    simp only [mul_one] at h1
    linarith [hπ_sum]
  have h_gibbs : ∀ {α β : Type} [DecidableEq α] [DecidableEq β]
      (U : Fin N_ω → α) (V : Fin N_ω → β) (q : α → β → ℝ),
      (∀ ω ∈ F_pos, 0 < q (U ω) (V ω)) →
      (∀ u ∈ F_pos.image U, ∑ v ∈ (F_pos.filter (fun ω => U ω = u)).image V, q u v ≤ 1) →
      finCondEntropy ε π U V ≤
        (∑ ω ∈ F_pos, π ω * (-Real.log (q (U ω) (V ω)))) / ell := by
    intro α β _ _ U V q hq_pos hq_sum
    let w_U : α → ℝ := fun u => ∑ ω' : Fin N_ω, if U ω' = u then π ω' else 0
    let w_UV : α → β → ℝ := fun u v => ∑ ω' : Fin N_ω, if U ω' = u ∧ V ω' = v then π ω' else 0
    have hw_U_eq : ∀ u : α, w_U u = ∑ ω ∈ F_pos.filter (fun ω => U ω = u), π ω := by
      intro u
      rw [Finset.sum_filter]
      refine (Finset.sum_subset (Finset.subset_univ F_pos) (fun ω _ hω => ?_)).symm
      rw [hπ_zero ω hω]
      simp
    have hw_UV_eq : ∀ (u : α) (v : β),
        w_UV u v = ∑ ω ∈ (F_pos.filter (fun ω => U ω = u)).filter (fun ω => V ω = v), π ω := by
      intro u v
      rw [Finset.sum_filter, Finset.sum_filter]
      have h_sub : (∑ ω : Fin N_ω, if U ω = u ∧ V ω = v then π ω else 0) =
          ∑ ω ∈ F_pos, if U ω = u ∧ V ω = v then π ω else 0 := by
        refine (Finset.sum_subset (Finset.subset_univ F_pos) (fun ω _ hω => ?_)).symm
        rw [hπ_zero ω hω]
        simp
      dsimp only [w_UV]
      rw [h_sub]
      refine Finset.sum_congr rfl (fun ω _ => ?_)
      by_cases hu : U ω = u <;> by_cases hv : V ω = v <;> simp [hu, hv]
    have h_prob1 : ∀ ω : Fin N_ω, finProbAt π U ω = w_U (U ω) := by
      intro ω
      unfold finProbAt
      refine Finset.sum_congr rfl (fun ω' _ => ?_)
      by_cases h : U ω' = U ω <;> simp [h]
    have h_prob2 : ∀ ω : Fin N_ω, finProbAt2 π U V ω = w_UV (U ω) (V ω) := by
      intro ω
      unfold finProbAt2
      refine Finset.sum_congr rfl (fun ω' _ => ?_)
      by_cases h : U ω' = U ω ∧ V ω' = V ω <;> simp [h]
    have h_lhs : finCondEntropy ε π U V =
        (∑ ω ∈ F_pos, π ω * (-Real.log (w_UV (U ω) (V ω) / w_U (U ω)))) / ell := by
      unfold finCondEntropy condSurprise
      change (∑ ω : Fin N_ω, π ω * (-(Real.log (finProbAt2 π U V ω / finProbAt π U ω)) / ell)) = _
      rw [h_sum_F_pos, Finset.sum_div]
      refine Finset.sum_congr rfl (fun ω _ => ?_)
      rw [h_prob1 ω, h_prob2 ω]
      ring
    rw [h_lhs, div_le_div_iff_of_pos_right hell_pos]
    have h_pt : ∀ ω ∈ F_pos,
        π ω * (-Real.log (w_UV (U ω) (V ω) / w_U (U ω))) -
          π ω * (-Real.log (q (U ω) (V ω))) ≤
          π ω * ((q (U ω) (V ω) * w_U (U ω)) / w_UV (U ω) (V ω)) - π ω := by
      intro ω hω
      have hπω : 0 < π ω := (hF_pos ω).mp hω
      have hω_fu : ω ∈ F_pos.filter (fun ω' => U ω' = U ω) :=
        Finset.mem_filter.mpr ⟨hω, rfl⟩
      have hω_fuv : ω ∈ (F_pos.filter (fun ω' => U ω' = U ω)).filter (fun ω' => V ω' = V ω) :=
        Finset.mem_filter.mpr ⟨hω_fu, rfl⟩
      have hw_u_pos : 0 < w_U (U ω) := by
        rw [hw_U_eq]
        exact lt_of_lt_of_le hπω (Finset.single_le_sum (fun ω' _ => hπ_nn ω') hω_fu)
      have hw_uv_pos : 0 < w_UV (U ω) (V ω) := by
        rw [hw_UV_eq]
        exact lt_of_lt_of_le hπω (Finset.single_le_sum (fun ω' _ => hπ_nn ω') hω_fuv)
      have hq_ω : 0 < q (U ω) (V ω) := hq_pos ω hω
      have h_arg_pos : 0 < (q (U ω) (V ω) * w_U (U ω)) / w_UV (U ω) (V ω) :=
        div_pos (mul_pos hq_ω hw_u_pos) hw_uv_pos
      have h_log_id : -Real.log (w_UV (U ω) (V ω) / w_U (U ω)) + Real.log (q (U ω) (V ω)) =
          Real.log ((q (U ω) (V ω) * w_U (U ω)) / w_UV (U ω) (V ω)) := by
        rw [Real.log_div hw_uv_pos.ne' hw_u_pos.ne',
          Real.log_div (mul_pos hq_ω hw_u_pos).ne' hw_uv_pos.ne',
          Real.log_mul hq_ω.ne' hw_u_pos.ne']
        ring
      have h_kl := Real.log_le_sub_one_of_pos h_arg_pos
      have h_mul := mul_le_mul_of_nonneg_left (h_log_id.trans_le h_kl) hπω.le
      linarith
    have h_sum_diff : (∑ ω ∈ F_pos,
        (π ω * (-Real.log (w_UV (U ω) (V ω) / w_U (U ω))) -
          π ω * (-Real.log (q (U ω) (V ω))))) ≤
        (∑ ω ∈ F_pos, π ω * ((q (U ω) (V ω) * w_U (U ω)) / w_UV (U ω) (V ω))) -
          ∑ ω ∈ F_pos, π ω := by
      rw [← Finset.sum_sub_distrib]
      exact Finset.sum_le_sum h_pt
    have h_fib_sum : (∑ ω ∈ F_pos,
        π ω * ((q (U ω) (V ω) * w_U (U ω)) / w_UV (U ω) (V ω))) ≤ 1 := by
      rw [← Finset.sum_fiberwise_of_maps_to (fun ω hω => Finset.mem_image_of_mem U hω)]
      have h_u_bound : ∀ u ∈ F_pos.image U,
          (∑ ω ∈ F_pos.filter (fun ω => U ω = u),
            π ω * ((q (U ω) (V ω) * w_U (U ω)) / w_UV (U ω) (V ω))) ≤ w_U u := by
        intro u hu
        let F_u := F_pos.filter (fun ω => U ω = u)
        change (∑ ω ∈ F_u, π ω * ((q (U ω) (V ω) * w_U (U ω)) / w_UV (U ω) (V ω))) ≤ w_U u
        rw [← Finset.sum_fiberwise_of_maps_to (fun ω hω => Finset.mem_image_of_mem V hω)]
        have h_v_eq : ∀ v ∈ F_u.image V,
            (∑ ω ∈ F_u.filter (fun ω => V ω = v),
              π ω * ((q (U ω) (V ω) * w_U (U ω)) / w_UV (U ω) (V ω))) = q u v * w_U u := by
          intro v hv
          obtain ⟨ω₀, hω₀_fu, rfl⟩ := Finset.mem_image.mp hv
          have hω₀_pos : 0 < π ω₀ := (hF_pos ω₀).mp (Finset.mem_filter.mp hω₀_fu).1
          have hω₀_fuv : ω₀ ∈ F_u.filter (fun ω => V ω = V ω₀) :=
            Finset.mem_filter.mpr ⟨hω₀_fu, rfl⟩
          have hw_uv_pos : 0 < w_UV u (V ω₀) := by
            rw [hw_UV_eq]
            exact lt_of_lt_of_le hω₀_pos (Finset.single_le_sum (fun ω' _ => hπ_nn ω') hω₀_fuv)
          have h_congr : (∑ ω ∈ F_u.filter (fun ω => V ω = V ω₀),
              π ω * ((q (U ω) (V ω) * w_U (U ω)) / w_UV (U ω) (V ω))) =
              ∑ ω ∈ F_u.filter (fun ω => V ω = V ω₀),
                π ω * ((q u (V ω₀) * w_U u) / w_UV u (V ω₀)) := by
            refine Finset.sum_congr rfl (fun ω hω => ?_)
            have h1 := (Finset.mem_filter.mp (Finset.mem_filter.mp hω).1).2
            have h2 := (Finset.mem_filter.mp hω).2
            rw [h1, h2]
          rw [h_congr, ← Finset.sum_mul, ← hw_UV_eq u (V ω₀),
            mul_div_cancel₀ _ hw_uv_pos.ne']
        rw [Finset.sum_congr rfl h_v_eq, ← Finset.sum_mul]
        have hw_u_nn : 0 ≤ w_U u :=
          Finset.sum_nonneg (fun ω' _ => by split_ifs <;> linarith [hπ_nn ω'])
        exact mul_le_of_le_one_left hw_u_nn (hq_sum u hu)
      have h_tot : ∑ u ∈ F_pos.image U, w_U u = 1 := by
        have h1 : ∑ u ∈ F_pos.image U, w_U u =
            ∑ u ∈ F_pos.image U, ∑ ω ∈ F_pos.filter (fun ω => U ω = u), π ω :=
          Finset.sum_congr rfl (fun u _ => hw_U_eq u)
        rw [h1, Finset.sum_fiberwise_of_maps_to (fun ω hω => Finset.mem_image_of_mem U hω),
          hF_pos_sum1]
      exact (Finset.sum_le_sum h_u_bound).trans_eq h_tot
    rw [Finset.sum_sub_distrib] at h_sum_diff
    linarith [h_sum_diff, h_fib_sum, hF_pos_sum1]
  have h_cond_ent_fib : ∀ {α β : Type} [DecidableEq α] [DecidableEq β]
      (X : Fin N_ω → α) (Y : Fin N_ω → β) (Fib : α → Finset β) (K : ℕ),
      1 ≤ K →
      (∀ x : α, (Fib x).card ≤ K) →
      (∀ ω : Fin N_ω, 0 < π ω → Y ω ∈ Fib (X ω)) →
      finCondEntropy ε π X Y ≤ Real.log (K : ℝ) / ell := by
    intro α β _ _ X Y Fib K hK hFib_card hFib_mem
    have hK_pos : 0 < (K : ℝ) := by exact_mod_cast (show 0 < K by omega)
    have h_gb := h_gibbs X Y (fun _ _ => (K : ℝ)⁻¹)
      (fun _ _ => inv_pos.mpr hK_pos)
      (fun x _ => by
        let S_x := (F_pos.filter (fun ω => X ω = x)).image Y
        have h_sub : S_x ⊆ Fib x := by
          intro y hy
          obtain ⟨ω, hω_f, rfl⟩ := Finset.mem_image.mp hy
          obtain ⟨hω_pos, hXω⟩ := Finset.mem_filter.mp hω_f
          rw [← hXω]
          exact hFib_mem ω ((hF_pos ω).mp hω_pos)
        have h_card : (S_x.card : ℝ) ≤ (K : ℝ) := by
          exact_mod_cast (Finset.card_le_card h_sub).trans (hFib_card x)
        rw [Finset.sum_const, nsmul_eq_mul]
        calc (S_x.card : ℝ) * (K : ℝ)⁻¹ ≤ (K : ℝ) * (K : ℝ)⁻¹ :=
              mul_le_mul_of_nonneg_right h_card (inv_nonneg.mpr hK_pos.le)
          _ = 1 := mul_inv_cancel₀ hK_pos.ne')
    refine h_gb.trans_eq ?_
    have h_const : (∑ ω ∈ F_pos, π ω * (-Real.log ((K : ℝ)⁻¹))) = Real.log (K : ℝ) := by
      rw [Real.log_inv, neg_neg, ← Finset.sum_mul, hF_pos_sum1, one_mul]
    rw [h_const]
  have h_drop_cond : ∀ {α β γ_Z : Type} [DecidableEq α] [DecidableEq β] [DecidableEq γ_Z]
      (X : Fin N_ω → α) (Y : Fin N_ω → β) (Z : Fin N_ω → γ_Z),
      finCondEntropy ε π (fun ω => (X ω, Z ω)) Y ≤ finCondEntropy ε π Z Y := by
    intro α β γ_Z _ _ _ X Y Z
    let w_Z : γ_Z → ℝ := fun z => ∑ ω' : Fin N_ω, if Z ω' = z then π ω' else 0
    let w_ZY : γ_Z → β → ℝ := fun z y => ∑ ω' : Fin N_ω, if Z ω' = z ∧ Y ω' = y then π ω' else 0
    have hw_Z_eq : ∀ z : γ_Z, w_Z z = ∑ ω ∈ F_pos.filter (fun ω => Z ω = z), π ω := by
      intro z
      rw [Finset.sum_filter]
      refine (Finset.sum_subset (Finset.subset_univ F_pos) (fun ω _ hω => ?_)).symm
      rw [hπ_zero ω hω]
      simp
    have hw_ZY_eq : ∀ (z : γ_Z) (y : β),
        w_ZY z y = ∑ ω ∈ (F_pos.filter (fun ω => Z ω = z)).filter (fun ω => Y ω = y), π ω := by
      intro z y
      rw [Finset.sum_filter, Finset.sum_filter]
      have h_sub : (∑ ω : Fin N_ω, if Z ω = z ∧ Y ω = y then π ω else 0) =
          ∑ ω ∈ F_pos, if Z ω = z ∧ Y ω = y then π ω else 0 := by
        refine (Finset.sum_subset (Finset.subset_univ F_pos) (fun ω _ hω => ?_)).symm
        rw [hπ_zero ω hω]
        simp
      dsimp only [w_ZY]
      rw [h_sub]
      refine Finset.sum_congr rfl (fun ω _ => ?_)
      by_cases hz : Z ω = z <;> by_cases hy : Y ω = y <;> simp [hz, hy]
    have h_gb := h_gibbs (fun ω => (X ω, Z ω)) Y (fun xz y => w_ZY xz.2 y / w_Z xz.2)
      (fun ω hω => by
        have hπω : 0 < π ω := (hF_pos ω).mp hω
        have hω_fz : ω ∈ F_pos.filter (fun ω' => Z ω' = Z ω) :=
          Finset.mem_filter.mpr ⟨hω, rfl⟩
        have hω_fzy : ω ∈ (F_pos.filter (fun ω' => Z ω' = Z ω)).filter (fun ω' => Y ω' = Y ω) :=
          Finset.mem_filter.mpr ⟨hω_fz, rfl⟩
        have hwz : 0 < w_Z (Z ω) := by
          rw [hw_Z_eq]
          exact lt_of_lt_of_le hπω (Finset.single_le_sum (fun ω' _ => hπ_nn ω') hω_fz)
        have hwzy : 0 < w_ZY (Z ω) (Y ω) := by
          rw [hw_ZY_eq]
          exact lt_of_lt_of_le hπω (Finset.single_le_sum (fun ω' _ => hπ_nn ω') hω_fzy)
        exact div_pos hwzy hwz)
      (fun xz hxz => by
        obtain ⟨ω₀, hω₀_pos, hω₀_eq⟩ := Finset.mem_image.mp hxz
        have hZ₀ : Z ω₀ = xz.2 := congrArg Prod.snd hω₀_eq
        have hω₀_fz : ω₀ ∈ F_pos.filter (fun ω => Z ω = xz.2) :=
          Finset.mem_filter.mpr ⟨hω₀_pos, hZ₀⟩
        have hwz_pos : 0 < w_Z xz.2 := by
          rw [hw_Z_eq]
          exact lt_of_lt_of_le ((hF_pos ω₀).mp hω₀_pos)
            (Finset.single_le_sum (fun ω' _ => hπ_nn ω') hω₀_fz)
        let S_xz := (F_pos.filter (fun ω => (X ω, Z ω) = xz)).image Y
        let S_z := (F_pos.filter (fun ω => Z ω = xz.2)).image Y
        have h_sub : S_xz ⊆ S_z := by
          intro y hy
          obtain ⟨ω, hω_f, rfl⟩ := Finset.mem_image.mp hy
          obtain ⟨hω_p, h_eq⟩ := Finset.mem_filter.mp hω_f
          exact Finset.mem_image_of_mem Y (Finset.mem_filter.mpr ⟨hω_p, congrArg Prod.snd h_eq⟩)
        have h_le : ∑ y ∈ S_xz, w_ZY xz.2 y / w_Z xz.2 ≤ ∑ y ∈ S_z, w_ZY xz.2 y / w_Z xz.2 := by
          refine Finset.sum_le_sum_of_subset_of_nonneg h_sub (fun y _ _ => ?_)
          have hwzy_nn : 0 ≤ w_ZY xz.2 y :=
            Finset.sum_nonneg (fun ω' _ => by split_ifs <;> linarith [hπ_nn ω'])
          exact div_nonneg hwzy_nn hwz_pos.le
        have h_sum_z : ∑ y ∈ S_z, w_ZY xz.2 y = w_Z xz.2 := by
          have h1 : ∑ y ∈ S_z, w_ZY xz.2 y =
              ∑ y ∈ S_z, ∑ ω ∈ (F_pos.filter (fun ω => Z ω = xz.2)).filter (fun ω => Y ω = y), π ω :=
            Finset.sum_congr rfl (fun y _ => hw_ZY_eq xz.2 y)
          rw [h1, Finset.sum_fiberwise_of_maps_to (fun ω hω => Finset.mem_image_of_mem Y hω),
            ← hw_Z_eq]
        calc ∑ y ∈ S_xz, w_ZY xz.2 y / w_Z xz.2
            ≤ ∑ y ∈ S_z, w_ZY xz.2 y / w_Z xz.2 := h_le
          _ = (∑ y ∈ S_z, w_ZY xz.2 y) / w_Z xz.2 := (Finset.sum_div _ _ _).symm
          _ = 1 := by rw [h_sum_z, div_self hwz_pos.ne'])
    refine h_gb.trans_eq ?_
    unfold finCondEntropy condSurprise
    change _ = ∑ ω : Fin N_ω, π ω * (-(Real.log (finProbAt2 π Z Y ω / finProbAt π Z ω)) / ell)
    rw [h_sum_F_pos, Finset.sum_div]
    refine Finset.sum_congr rfl (fun ω _ => ?_)
    have hp1 : finProbAt π Z ω = w_Z (Z ω) := by
      unfold finProbAt
      refine Finset.sum_congr rfl (fun ω' _ => ?_)
      by_cases h : Z ω' = Z ω <;> simp [h]
    have hp2 : finProbAt2 π Z Y ω = w_ZY (Z ω) (Y ω) := by
      unfold finProbAt2
      refine Finset.sum_congr rfl (fun ω' _ => ?_)
      by_cases h : Z ω' = Z ω ∧ Y ω' = Y ω <;> simp [h]
    rw [hp1, hp2]
    ring
  have h_cond_nn : ∀ {τ₁ τ₂ : Type} (U : Fin N_ω → τ₁) (V : Fin N_ω → τ₂),
      0 ≤ finCondEntropy ε π U V := by
    intro τ₁ τ₂ U V
    unfold finCondEntropy
    refine Finset.sum_nonneg (fun ω _ => ?_)
    by_cases hπω : π ω = 0
    · rw [hπω, zero_mul]
    · have hπ_pos : 0 < π ω := lt_of_le_of_ne (hπ_nn ω) (Ne.symm hπω)
      have hp2_pos : 0 < finProbAt2 π U V ω := by
        unfold finProbAt2
        have h_le := Finset.single_le_sum
          (f := fun ω' : Fin N_ω =>
            @ite ℝ (U ω' = U ω ∧ V ω' = V ω) (Classical.propDecidable _) (π ω') 0)
          (fun ω' _ => by split_ifs <;> linarith [hπ_nn ω']) (Finset.mem_univ ω)
        simp at h_le
        exact lt_of_lt_of_le hπ_pos h_le
      have hp2_le_p1 : finProbAt2 π U V ω ≤ finProbAt π U ω := by
        unfold finProbAt2 finProbAt
        refine Finset.sum_le_sum (fun ω' _ => ?_)
        by_cases h1 : U ω' = U ω <;> by_cases h2 : V ω' = V ω <;>
          simp [h1, h2, hπ_nn ω']
      have hp1_pos : 0 < finProbAt π U ω := lt_of_lt_of_le hp2_pos hp2_le_p1
      have h_div_nn : 0 ≤ finProbAt2 π U V ω / finProbAt π U ω :=
        div_nonneg hp2_pos.le hp1_pos.le
      have h_div_le1 : finProbAt2 π U V ω / finProbAt π U ω ≤ 1 :=
        div_le_one_of_le₀ hp2_le_p1 hp1_pos.le
      have h_log_np : Real.log (finProbAt2 π U V ω / finProbAt π U ω) ≤ 0 :=
        Real.log_nonpos h_div_nn h_div_le1
      have h_cs_nn : 0 ≤ condSurprise ε π U V ω := by
        unfold condSurprise
        exact div_nonneg (neg_nonneg.mpr h_log_np) hell_pos.le
      exact mul_nonneg hπ_pos.le h_cs_nn
  have h_chain : ∀ {τ₁ τ₂ τ₃ : Type} (U : Fin N_ω → τ₁) (V : Fin N_ω → τ₂) (W : Fin N_ω → τ₃),
      finCondEntropy ε π U (fun ω => (V ω, W ω)) =
        finCondEntropy ε π U V + finCondEntropy ε π (fun ω => (U ω, V ω)) W := by
    intro τ₁ τ₂ τ₃ U V W
    unfold finCondEntropy
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun ω _ => ?_)
    by_cases hπω : π ω = 0
    · simp [hπω]
    · have hπ_pos : 0 < π ω := lt_of_le_of_ne (hπ_nn ω) (Ne.symm hπω)
      have hp_uv : finProbAt π (fun ω' => (U ω', V ω')) ω = finProbAt2 π U V ω := by
        unfold finProbAt finProbAt2
        refine Finset.sum_congr rfl (fun ω' _ => ?_)
        by_cases hu : U ω' = U ω <;> by_cases hv : V ω' = V ω <;> simp [hu, hv]
      have hp_uvw : finProbAt2 π (fun ω' => (U ω', V ω')) W ω =
          finProbAt2 π U (fun ω' => (V ω', W ω')) ω := by
        unfold finProbAt2
        refine Finset.sum_congr rfl (fun ω' _ => ?_)
        by_cases hu : U ω' = U ω <;> by_cases hv : V ω' = V ω <;> by_cases hw : W ω' = W ω <;>
          simp [hu, hv, hw]
      have hp1_pos : 0 < finProbAt π U ω := by
        unfold finProbAt
        have h_le := Finset.single_le_sum
          (f := fun ω' : Fin N_ω => @ite ℝ (U ω' = U ω) (Classical.propDecidable _) (π ω') 0)
          (fun ω' _ => by split_ifs <;> linarith [hπ_nn ω']) (Finset.mem_univ ω)
        simp at h_le
        exact lt_of_lt_of_le hπ_pos h_le
      have hp2_pos : 0 < finProbAt2 π U V ω := by
        unfold finProbAt2
        have h_le := Finset.single_le_sum
          (f := fun ω' : Fin N_ω =>
            @ite ℝ (U ω' = U ω ∧ V ω' = V ω) (Classical.propDecidable _) (π ω') 0)
          (fun ω' _ => by split_ifs <;> linarith [hπ_nn ω']) (Finset.mem_univ ω)
        simp at h_le
        exact lt_of_lt_of_le hπ_pos h_le
      have hp3_pos : 0 < finProbAt2 π U (fun ω' => (V ω', W ω')) ω := by
        unfold finProbAt2
        have h_le := Finset.single_le_sum
          (f := fun ω' : Fin N_ω =>
            @ite ℝ (U ω' = U ω ∧ (V ω', W ω') = (V ω, W ω)) (Classical.propDecidable _) (π ω') 0)
          (fun ω' _ => by split_ifs <;> linarith [hπ_nn ω']) (Finset.mem_univ ω)
        simp at h_le
        exact lt_of_lt_of_le hπ_pos h_le
      unfold condSurprise
      change π ω * (-(Real.log (finProbAt2 π U (fun ω' => (V ω', W ω')) ω / finProbAt π U ω)) / ell) =
        π ω * (-(Real.log (finProbAt2 π U V ω / finProbAt π U ω)) / ell) +
        π ω * (-(Real.log (finProbAt2 π (fun ω' => (U ω', V ω')) W ω /
          finProbAt π (fun ω' => (U ω', V ω')) ω)) / ell)
      rw [hp_uv, hp_uvw]
      have h_prod : finProbAt2 π U (fun ω' => (V ω', W ω')) ω / finProbAt π U ω =
          (finProbAt2 π U V ω / finProbAt π U ω) *
            (finProbAt2 π U (fun ω' => (V ω', W ω')) ω / finProbAt2 π U V ω) := by
        field_simp [hp1_pos.ne', hp2_pos.ne']
      rw [h_prod, Real.log_mul (div_pos hp2_pos hp1_pos).ne' (div_pos hp3_pos hp2_pos).ne']
      ring
  have h_symm : ∀ {τ₁ τ₂ τ₃ : Type} (U : Fin N_ω → τ₁) (V : Fin N_ω → τ₂) (W : Fin N_ω → τ₃),
      finCondEntropy ε π U (fun ω => (V ω, W ω)) =
        finCondEntropy ε π U (fun ω => (W ω, V ω)) := by
    intro τ₁ τ₂ τ₃ U V W
    unfold finCondEntropy condSurprise
    refine Finset.sum_congr rfl (fun ω _ => ?_)
    have h_eq : finProbAt2 π U (fun ω' => (V ω', W ω')) ω =
        finProbAt2 π U (fun ω' => (W ω', V ω')) ω := by
      unfold finProbAt2
      refine Finset.sum_congr rfl (fun ω' _ => ?_)
      by_cases hu : U ω' = U ω <;> by_cases hv : V ω' = V ω <;> by_cases hw : W ω' = W ω <;>
        simp [hu, hv, hw]
    rw [h_eq]
  have h_unit_cond : ∀ {τ₁ τ₂ : Type} (V : Fin N_ω → τ₁) (W : Fin N_ω → τ₂),
