            if k = k_time ω then
              -(Q ω * Real.log (finProbAt2 Q T_idx k_time ω / finProbAt Q T_idx ω)) else 0 := by
          intro k
          by_cases hk : k = k_time ω <;> simp [hk, eq_comm]
