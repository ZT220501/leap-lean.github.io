        _ ≤ ∑ _q ∈ F_Q_d, (C_Z2 * ε ^ (-ζ_sh)) := Finset.sum_le_sum (fun q _ => hfib_card2 q)
        _ = (F_Q_d.card : ℝ) * (C_Z2 * ε ^ (-ζ_sh)) := by rw [Finset.sum_const, nsmul_eq_mul]
        _ ≤ (C_Q * ε ^ (-2 * θ)) * (C_Z2 * ε ^ (-ζ_sh)) :=
            mul_le_mul_of_nonneg_right hFQd_card hCZ2_nn
        _ = C_list * (ε ^ (-2 * θ) * ε ^ (-ζ_sh)) := by
