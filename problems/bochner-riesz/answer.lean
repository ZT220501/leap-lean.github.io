    have hS_nn : ∀ M : ℕ → ℝ, (∀ k : ℕ, 0 ≤ M k) → ∀ k : ℕ, 0 ≤ S_tbl M k := by
      intro M hM k
      have hH_nn : ∀ n : ℕ, 0 ≤ H_tbl M n := by
        intro n
        have := hM 0; have := hM 1; have := hM 2; have := hM 3; have := hM 4
        have := hD'_nn 1; have := hD'_nn 2; have := hD'_nn 3; have := hD'_nn 4
        rcases n with _ | _ | _ | _ | _ | n <;> dsimp [H_tbl] <;> positivity
