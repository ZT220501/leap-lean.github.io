            (stg (φ n)).hρ_bounds (by dsimp [M_seq]; omega) ha2_lo (by linarith [ha2_hi])
            (hκ_base_le n)
            (fun r_idx hr1 hrM => by
              convert (stg (φ n)).h_Z_supp_mesh b hlam_b r_idx hr1 hrM)
            r hr_lo hr_hi
        exact ⟨S_cov, hS_card, fun i hi => hS_mem i (Finset.mem_filter.mpr ⟨Finset.mem_univ i, hi⟩)⟩
      h_Y_ball := fun n b z₀ r hlam_b hr_lo hr_hi => by
        have hρb := (stg (φ n)).hρ_bounds
        have hL_pos : 0 < Real.log ((ρ_seq n)⁻¹) := h_log_inv_pos (ρ_seq n) hρb
        have hM_pos : 0 < ((M_seq n : ℕ) : ℝ) := by dsimp [M_seq]; positivity
        obtain ⟨hd0, hd1, _⟩ := h_tau_rpow (ρ_seq n) r hρb hr_lo hr_hi
        let d_r := Real.log (r⁻¹) / Real.log ((ρ_seq n)⁻¹)
        let lam_b := ∑ i, (stg (φ n)).π i b
        have hw_nn : ∀ i, 0 ≤ (stg (φ n)).π i b / lam_b := fun i =>
          div_nonneg ((stg (φ n)).hπ_nn i b) hlam_b.le
        have hw_sum : ∑ i, ((stg (φ n)).π i b / lam_b) = 1 := by
          rw [← Finset.sum_div]; exact div_self hlam_b.ne'
        have h_raw := (h_upgrade (ρ_seq n) (M_seq n) hρb (by dsimp [M_seq]; omega)).1
          (κ_err (φ n)) 1 (stg (φ n)).g_stage
          (fun i => (stg (φ n)).π i b / lam_b)
          (fun i => canonicalGridMid (ρ_seq n) (canonicalShear4 ((stg (φ n)).P i) ((stg (φ n)).θ b) 1))
          (hκ_pos (φ n)).le zero_le_one (stg (φ n)).hg_zero
          (fun d₁ d₂ hd => ⟨((stg (φ n)).hg_lip d₁ d₂ hd).1,
            by linarith [((stg (φ n)).hg_lip d₁ d₂ hd).2]⟩)
          hw_nn hw_sum
          (fun r_idx hr1 hrM q => (stg (φ n)).h_Y_mesh b hlam_b r_idx hr1 hrM q)
          z₀ r hr_lo hr_hi
        have hu := (abs_le.mp (h_unif n d_r ⟨hd0, hd1⟩)).1
        have h1M_le : 1 / ((M_seq n : ℕ) : ℝ) ≤ 2 / ((M_seq n : ℕ) : ℝ) :=
          div_le_div_of_nonneg_right (by norm_num) hM_pos.le
        have hlog_le : Real.log 3 / Real.log ((ρ_seq n)⁻¹) ≤
            Real.log 9 / Real.log ((ρ_seq n)⁻¹) :=
          div_le_div_of_nonneg_right (Real.log_le_log (by norm_num) (by norm_num)) hL_pos.le
        refine le_trans h_raw (Real.rpow_le_rpow_of_exponent_ge hρb.1 (by linarith [hρb.2]) ?_)
        dsimp [κ_seq]
        linarith
      h_Y_cov := fun d δ_err hd0 hd1 hδ_err => by
        have h_lim_cov : Filter.Tendsto
            (fun n => κ_err (φ n) + δ_unif n + 1 / ((M_seq n : ℕ) : ℝ))
            Filter.atTop (nhds 0) := by
          have ht := (hκ_sub_lim.add hδ_lim).add (h_inv_M_sub 1)
          simpa only [add_zero] using ht
        obtain ⟨L₀, hL₀⟩ :=
          Filter.eventually_atTop.mp (h_lim_cov.eventually (gt_mem_nhds hδ_err))
        refine ⟨L₀, fun n hn b hlam_b => ?_⟩
        have h_err_lt : κ_err (φ n) + δ_unif n + 1 / ((M_seq n : ℕ) : ℝ) < δ_err := hL₀ n hn
        have hρb := (stg (φ n)).hρ_bounds
        have hρ1 : ρ_seq n < 1 := by linarith [hρb.2]
        have hL_pos : 0 < Real.log ((ρ_seq n)⁻¹) := h_log_inv_pos (ρ_seq n) hρb
        let r := (ρ_seq n) ^ d
        have hr_lo : ρ_seq n ≤ r := by
          calc ρ_seq n = (ρ_seq n) ^ (1 : ℝ) := (Real.rpow_one _).symm
            _ ≤ (ρ_seq n) ^ d := Real.rpow_le_rpow_of_exponent_ge hρb.1 hρ1.le hd1
        have hr_hi : r ≤ 1 := by
          calc (ρ_seq n) ^ d ≤ (ρ_seq n) ^ (0 : ℝ) :=
                Real.rpow_le_rpow_of_exponent_ge hρb.1 hρ1.le hd0.le
            _ = 1 := Real.rpow_zero _
        have hτ_eq_d : Real.log (r⁻¹) / Real.log ((ρ_seq n)⁻¹) = d := by
          dsimp [r]
          rw [Real.log_inv ((ρ_seq n) ^ d), Real.log_rpow hρb.1]
          have hlog_ρ : Real.log (ρ_seq n) = -Real.log ((ρ_seq n)⁻¹) := by
            rw [Real.log_inv, neg_neg]
          rw [hlog_ρ]
          have h_num : -(d * -Real.log ((ρ_seq n)⁻¹)) = d * Real.log ((ρ_seq n)⁻¹) := by ring
          rw [h_num, mul_div_cancel_right₀ d hL_pos.ne']
        classical
        let S_act := Finset.univ.filter (fun i : Fin ((stg (φ n)).N_P) => 0 < (stg (φ n)).π i b)
        obtain ⟨S_cov, hS_card, hS_mem⟩ :=
          (h_upgrade (ρ_seq n) (M_seq n) hρb (by dsimp [M_seq]; omega)).2.2
            (κ_err (φ n)) 1 (stg (φ n)).g_stage S_act
            (fun i => canonicalGridMid (ρ_seq n) (canonicalShear4 ((stg (φ n)).P i) ((stg (φ n)).θ b) 1))
            zero_le_one
            (fun d₁ d₂ hd => by linarith [((stg (φ n)).hg_lip d₁ d₂ hd).2])
            (fun r_idx hr1 hrM => by
              convert (stg (φ n)).h_Y_supp_mesh b hlam_b r_idx hr1 hrM)
            r hr_lo hr_hi
        rw [hτ_eq_d] at hS_card
        have hu := (abs_le.mp (h_unif n d ⟨hd0.le, hd1⟩)).2
        refine ⟨S_cov, ?_, fun i hi => hS_mem i (Finset.mem_filter.mpr ⟨Finset.mem_univ i, hi⟩)⟩
        exact le_trans hS_card
          (Real.rpow_le_rpow_of_exponent_ge hρb.1 hρ1.le (by linarith))
    }⟩

theorem canonical_affine_block_extraction (γ m σ : ℝ) (hγ₀ : 0 < γ) (hγ₁ : γ < 1) (hm : 0 < m)
    (sys : MatchedAspectProfileSystem γ m)
    (hσ₀ : 0 < σ) (hσ₁ : σ ≤ 1 / 4) (hσ_κ : 4 * m * σ ≤ sys.κ)
    (i u s D_pt : ℝ) (h_seq : ℕ → ℝ)
    (hi : 0 < i) (hu : u ∈ Set.Ioo (0 : ℝ) 1)
    (hs₀ : 0 < s) (hs₁ : s ≤ 1) (hS_der : HasDerivAt sys.S s u)
    (hh_pos : ∀ l, 0 < h_seq l) (hh_lim : Filter.Tendsto h_seq Filter.atTop (nhds 0)) :
    (m ≠ 1 → ∀ a_pt : Fin 4 → ℝ,
      (∀ j, 0 ≤ a_pt j ∧ a_pt j ≤ 1) →
      (∀ (R ε_err : ℝ), 1 ≤ R → 0 < ε_err →
        ∀ᶠ l in Filter.atTop, ∀ ξ : (Fin 4 → ℝ) × ℝ,
          InDispCone 4 ![0, 1, m, 1 + m] E_cone4 ξ → (∀ j, |ξ.1 j| ≤ R) → |ξ.2| ≤ R →
          |(sys.f_raw (planeEmbed 4 ![0, 1, m, 1 + m] (i, u) + h_seq l • ξ) -
            sys.f_raw (planeEmbed 4 ![0, 1, m, 1 + m] (i, u))) / h_seq l -
            ((∑ j : Fin 4, a_pt j * ξ.1 j) + D_pt * ξ.2)| ≤ ε_err) →
      Nonempty (CanonicalAffineBlockDistinct s σ a_pt)) ∧
    (m = 1 → ∀ a_pt : Fin 3 → ℝ,
      (0 ≤ a_pt 0 ∧ a_pt 0 ≤ 1 ∧ 0 ≤ a_pt 1 ∧ a_pt 1 ≤ 2 ∧ 0 ≤ a_pt 2 ∧ a_pt 2 ≤ 1) →
      (∀ (R ε_err : ℝ), 1 ≤ R → 0 < ε_err →
        let f3 := fun p : (Fin 3 → ℝ) × ℝ => sys.f_raw (![p.1 0, p.1 1, p.1 1, p.1 2], p.2)
        ∀ᶠ l in Filter.atTop, ∀ ξ : (Fin 3 → ℝ) × ℝ,
          InDispCone 3 ![0, 1, 2] (fun j k => j < k) ξ → (∀ j, |ξ.1 j| ≤ R) → |ξ.2| ≤ R →
          |(f3 (planeEmbed 3 ![0, 1, 2] (i, u) + h_seq l • ξ) -
            f3 (planeEmbed 3 ![0, 1, 2] (i, u))) / h_seq l -
            ((∑ j : Fin 3, a_pt j * ξ.1 j) + D_pt * ξ.2)| ≤ ε_err) →
      Nonempty (CanonicalAffineBlockTied s σ a_pt)) :=
by
  
  have h_disj_supp_card : ∀ {N : ℕ} {α : Type} [DecidableEq α]
      (w : Fin N → ℝ) (S_idx : Finset (Fin N)) (f : Fin N → α) (c : ℝ),
      letI := Classical.propDecidable
      (∀ idx, 0 ≤ w idx) → (∑ idx : Fin N, w idx = 1) → 0 < c →
      (∀ idx ∈ S_idx, c ≤ ∑ idx' : Fin N, if f idx' = f idx then w idx' else 0) →
      (((S_idx.image f).card : ℝ) ≤ c⁻¹) := by
    intro N α _ w S_idx f c
    letI := Classical.propDecidable
    intro hw_nn hw_sum hc_pos h_lb
    rw [inv_eq_one_div, le_div_iff₀ hc_pos]
    calc ((S_idx.image f).card : ℝ) * c
        = ∑ _q ∈ S_idx.image f, c := by simp [Finset.sum_const, nsmul_eq_mul]
      _ ≤ ∑ q ∈ S_idx.image f, (∑ idx' : Fin N, if f idx' = q then w idx' else 0) := by
          refine Finset.sum_le_sum (fun q hq => ?_)
          obtain ⟨idx₀, hidx₀, rfl⟩ := Finset.mem_image.mp hq
          exact h_lb idx₀ hidx₀
      _ = ∑ idx' : Fin N, (∑ q ∈ S_idx.image f, if f idx' = q then w idx' else 0) :=
          Finset.sum_comm
      _ ≤ ∑ idx' : Fin N, w idx' := by
          refine Finset.sum_le_sum (fun idx' _ => ?_)
          by_cases h_mem : f idx' ∈ S_idx.image f
          · rw [Finset.sum_eq_single (f idx')]
            · simp
            · intro q _ hq_ne
              exact if_neg (Ne.symm hq_ne)
            · intro h_abs
              exact absurd h_mem h_abs
          · rw [Finset.sum_eq_zero]
            · exact hw_nn idx'
            · intro q hq
              refine if_neg (fun h_eq => h_mem ?_)
              rwa [h_eq]
      _ = 1 := hw_sum
  have h_sum_comm_ite : ∀ {N_P N_Θ : ℕ} (p0 : Fin N_P → Fin N_Θ → ℝ)
      (P_b : Fin N_Θ → Prop),
      letI := Classical.propDecidable
      (∑ b : Fin N_Θ, if P_b b then (∑ idx_p : Fin N_P, p0 idx_p b) else 0) =
      (∑ idx_p : Fin N_P, ∑ b : Fin N_Θ, if P_b b then p0 idx_p b else 0) := by
    intro N_P N_Θ p0 P_b
    letI := Classical.propDecidable
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun b _ => ?_
    split_ifs
    · rfl
    · exact Finset.sum_const_zero.symm
  have h_uncond_transfer : ∀ {N_P N_Θ : ℕ} {α : Type}
      (p0 π : Fin N_P → Fin N_Θ → ℝ) (H_set : Fin N_P → Fin N_Θ → Prop)
      (M_ret B_p0 B_out : ℝ) (f_θ : Fin N_Θ → α) (q : α),
      letI := Classical.propDecidable
      0 ≤ B_out → 4 * B_p0 ≤ B_out → 1 / 4 ≤ M_ret →
      (∀ idx_p b, 0 ≤ π idx_p b) →
      (∀ idx_p b, M_ret * π idx_p b ≤ p0 idx_p b) →
      (∀ idx_p b, 0 < π idx_p b → H_set idx_p b ∧ 0 < p0 idx_p b) →
      (∀ idx_p b, H_set idx_p b → 0 < p0 idx_p b → f_θ b = q →
        (∑ b' : Fin N_Θ, if f_θ b' = q then (∑ i' : Fin N_P, p0 i' b') else 0) ≤ B_p0) →
      (∑ b : Fin N_Θ, if f_θ b = q then (∑ idx_p : Fin N_P, π idx_p b) else 0) ≤ B_out := by
    intro N_P N_Θ α p0 π H_set M_ret B_p0 B_out f_θ q
    letI := Classical.propDecidable
    intro hBout_nn h4B hM_qtr hπ_nn hπ_le hπ_supp h_p0_bd
    set S := ∑ b : Fin N_Θ, if f_θ b = q then (∑ idx_p : Fin N_P, π idx_p b) else 0
    have hS_nn : 0 ≤ S := Finset.sum_nonneg fun b _ => by
      split_ifs
      · exact Finset.sum_nonneg fun idx_p _ => hπ_nn idx_p b
      · exact le_rfl
    by_cases h_zero : S = 0
    · rw [h_zero]; exact hBout_nn
    · obtain ⟨b₀, _, hb₀⟩ := Finset.exists_ne_zero_of_sum_ne_zero h_zero
      by_cases hq_b₀ : f_θ b₀ = q
      · rw [if_pos hq_b₀] at hb₀
        obtain ⟨idx₀, _, hidx₀_ne⟩ := Finset.exists_ne_zero_of_sum_ne_zero hb₀
        have hπ₀_pos : 0 < π idx₀ b₀ := lt_of_le_of_ne (hπ_nn idx₀ b₀) (Ne.symm hidx₀_ne)
        obtain ⟨hH₀, hp0_pos⟩ := hπ_supp idx₀ b₀ hπ₀_pos
        have h_b0 := h_p0_bd idx₀ b₀ hH₀ hp0_pos hq_b₀
        have h_le_p0 : M_ret * S ≤
            ∑ b' : Fin N_Θ, if f_θ b' = q then (∑ i' : Fin N_P, p0 i' b') else 0 := by
          dsimp [S]
          rw [Finset.mul_sum]
          refine Finset.sum_le_sum fun b' _ => ?_
          split_ifs
          · rw [Finset.mul_sum]
              ; exact Finset.sum_le_sum fun i' _ => hπ_le i' b'
          · simp
        have h_qtr_S : (1 / 4 : ℝ) * S ≤ M_ret * S :=
          mul_le_mul_of_nonneg_right hM_qtr hS_nn
        have h_S_le_4 : S ≤ 4 * B_p0 := by linarith only [h_qtr_S, h_le_p0, h_b0]
        exact le_trans h_S_le_4 h4B
      · rw [if_neg hq_b₀] at hb₀
        exact absurd rfl hb₀
  have h_obs_b_floor : ∀ {N_P N_Θ N_obs : ℕ}
      (p0 π : Fin N_P → Fin N_Θ → ℝ)
      (F : Fin N_obs → Fin N_P → Fin N_Θ → ℤ × ℤ × ℤ × ℤ)
      (m_idx0 : Fin N_obs) (M_ret δ : ℝ) (b : Fin N_Θ),
      letI := Classical.propDecidable
      0 < M_ret → 0 < (∑ idx_p : Fin N_P, π idx_p b) →
      (∀ idx_p b', F m_idx0 idx_p b' = ((b'.1 : ℤ), 0, 0, 0)) →
      (∀ (m_idx : Fin N_obs) (z : ℤ × ℤ × ℤ × ℤ),
        let r_F := ∑ idx_p : Fin N_P, ∑ b' : Fin N_Θ,
          if F m_idx idx_p b' = z then M_ret * π idx_p b' else 0
        let p0_F := ∑ idx_p : Fin N_P, ∑ b' : Fin N_Θ,
          if F m_idx idx_p b' = z then p0 idx_p b' else 0
        0 < r_F → δ * p0_F ≤ r_F ∧ r_F ≤ p0_F) →
      δ * (∑ idx_p : Fin N_P, p0 idx_p b) ≤ M_ret * (∑ idx_p : Fin N_P, π idx_p b) := by
    intro N_P N_Θ N_obs p0 π F m_idx0 M_ret δ b
    letI := Classical.propDecidable
    intro hM_pos hlam_b hF0 h_obs
    have hrF_eq : (∑ idx_p : Fin N_P, ∑ b' : Fin N_Θ,
        if F m_idx0 idx_p b' = ((b.1 : ℤ), 0, 0, 0) then M_ret * π idx_p b' else 0) =
        M_ret * (∑ idx_p : Fin N_P, π idx_p b) := by
      simp_rw [hF0]
      rw [Finset.sum_comm, Finset.sum_eq_single b]
      · simp [Finset.mul_sum]
      · intro b' _ hb'_ne
        rw [Finset.sum_eq_zero]
        intro idx_p _
        exact if_neg (fun h => hb'_ne (Fin.ext (Int.ofNat.inj (Prod.ext_iff.mp h).1)))
      · intro h_abs; exact absurd (Finset.mem_univ b) h_abs
    have hp0F_eq : (∑ idx_p : Fin N_P, ∑ b' : Fin N_Θ,
        if F m_idx0 idx_p b' = ((b.1 : ℤ), 0, 0, 0) then p0 idx_p b' else 0) =
        ∑ idx_p : Fin N_P, p0 idx_p b := by
      simp_rw [hF0]
      rw [Finset.sum_comm, Finset.sum_eq_single b]
      · simp
      · intro b' _ hb'_ne
        rw [Finset.sum_eq_zero]
        intro idx_p _
        exact if_neg (fun h => hb'_ne (Fin.ext (Int.ofNat.inj (Prod.ext_iff.mp h).1)))
      · intro h_abs; exact absurd (Finset.mem_univ b) h_abs
    have h_app := h_obs m_idx0 ((b.1 : ℤ), 0, 0, 0)
    dsimp only at h_app
    rw [hrF_eq, hp0F_eq] at h_app
    exact (h_app (mul_pos hM_pos hlam_b)).1
  have h_cond_b_transfer : ∀ {N_P N_Θ : ℕ} {α : Type}
      (p0 π : Fin N_P → Fin N_Θ → ℝ) (H_set : Fin N_P → Fin N_Θ → Prop)
      (M_ret δ B_p0 B_out : ℝ) (b : Fin N_Θ) (f_i : Fin N_P → α) (q : α),
      letI := Classical.propDecidable
      let lam_b := ∑ idx_p : Fin N_P, π idx_p b
      let lam0_b := ∑ idx_p : Fin N_P, p0 idx_p b
      0 < M_ret → 0 < δ → 0 < lam_b → 0 ≤ B_p0 → 0 ≤ B_out →
      δ⁻¹ * B_p0 ≤ B_out →
      (∀ idx_p, 0 ≤ p0 idx_p b) →
      (∀ idx_p, 0 ≤ π idx_p b) →
      (∀ idx_p, M_ret * π idx_p b ≤ p0 idx_p b) →
      (∀ idx_p, 0 < π idx_p b → H_set idx_p b ∧ 0 < p0 idx_p b) →
      δ * lam0_b ≤ M_ret * lam_b →
      (∀ idx_p, H_set idx_p b → 0 < p0 idx_p b → f_i idx_p = q →
        (∑ i' : Fin N_P, if f_i i' = q then p0 i' b / lam0_b else 0) ≤ B_p0) →
      (∑ idx_p : Fin N_P, if f_i idx_p = q then π idx_p b / lam_b else 0) ≤ B_out := by
    intro N_P N_Θ α p0 π H_set M_ret δ B_p0 B_out b f_i q
    letI := Classical.propDecidable
    dsimp only
    intro hM_pos hδ_pos hlam_b hBp0_nn hBout_nn h_fac hp0_nn hπ_nn hπ_le hπ_supp h_floor h_p0_bd
    let lam_b := ∑ idx_p : Fin N_P, π idx_p b
    let lam0_b := ∑ idx_p : Fin N_P, p0 idx_p b
    set S := ∑ idx_p : Fin N_P, if f_i idx_p = q then π idx_p b / lam_b else 0
    by_cases h_zero : S = 0
    · change S ≤ B_out; rw [h_zero]; exact hBout_nn
    · obtain ⟨idx₀, _, hidx₀⟩ := Finset.exists_ne_zero_of_sum_ne_zero h_zero
      by_cases hq₀ : f_i idx₀ = q
      · rw [if_pos hq₀] at hidx₀
        have hπ₀_ne : π idx₀ b ≠ 0 := fun h0 => hidx₀ (by simp [h0])
        have hπ₀_pos : 0 < π idx₀ b := lt_of_le_of_ne (hπ_nn idx₀) (Ne.symm hπ₀_ne)
        obtain ⟨hH₀, hp0_pos⟩ := hπ_supp idx₀ hπ₀_pos
        have h_cm := h_p0_bd idx₀ hH₀ hp0_pos hq₀
        have hlam0_pos : 0 < lam0_b :=
          lt_of_lt_of_le hp0_pos
            (Finset.single_le_sum (f := fun idx_p => p0 idx_p b)
              (fun idx_p _ => hp0_nn idx_p) (Finset.mem_univ idx₀))
        have hlam0_le : lam0_b ≤ δ⁻¹ * (M_ret * lam_b) :=
          (le_inv_mul_iff₀ hδ_pos).mpr h_floor
