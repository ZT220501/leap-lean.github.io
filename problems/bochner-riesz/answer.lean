    let α : Fin M_split → ℝ := fun s => ∑ o : Fin N_O, ∑ d : Fin N_D, q s o d
    let q_O : Fin M_split → Fin N_O → ℝ := fun s o => ∑ d : Fin N_D, q s o d
    let q_D : Fin M_split → Fin N_D → ℝ := fun s d => ∑ o : Fin N_O, q s o d
    let p_O : Fin N_O → ℝ := fun o => ∑ d : Fin N_D, p o d
    let p_D : Fin N_D → ℝ := fun d => ∑ o : Fin N_O, p o d
    have hq_nn : ∀ s o d, 0 ≤ q s o d := by
      intro s o d
      dsimp [q]
      split_ifs
      · exact hp_nn o d
      · exact le_rfl
    have hqO_nn : ∀ s o, 0 ≤ q_O s o := fun s o => Finset.sum_nonneg (fun d _ => hq_nn s o d)
    have hqD_nn : ∀ s d, 0 ≤ q_D s d := fun s d => Finset.sum_nonneg (fun o _ => hq_nn s o d)
    have hα_nn : ∀ s, 0 ≤ α s := fun s => Finset.sum_nonneg (fun o _ => hqO_nn s o)
    have hq_sum_s : ∀ o d, ∑ s : Fin M_split, q s o d = p o d := by
      intro o d; dsimp [q]; simp
    have hqO_sum_s : ∀ o, ∑ s : Fin M_split, q_O s o = p_O o := by
      intro o; dsimp [q_O, p_O]; rw [Finset.sum_comm]
      exact Finset.sum_congr rfl (fun d _ => hq_sum_s o d)
    have hqD_sum_s : ∀ d, ∑ s : Fin M_split, q_D s d = p_D d := by
      intro d; dsimp [q_D, p_D]; rw [Finset.sum_comm]
      exact Finset.sum_congr rfl (fun o _ => hq_sum_s o d)
    have hα_sum : ∑ s : Fin M_split, α s = 1 := by
      calc ∑ s : Fin M_split, α s
          = ∑ o : Fin N_O, ∑ s : Fin M_split, q_O s o := by
            dsimp [α, q_O]; exact Finset.sum_comm
        _ = ∑ o : Fin N_O, p_O o := Finset.sum_congr rfl (fun o _ => hqO_sum_s o)
        _ = 1 := hp_sum
    have hpD_sum : ∑ d : Fin N_D, p_D d = 1 := by
      dsimp [p_D]; rw [Finset.sum_comm]; exact hp_sum
    let p_cd : Fin M_split → Fin N_O → Fin N_D → ℝ :=
      fun s o d => if α s = 0 then 0 else q s o d / α s
    let p_cd_O : Fin M_split → Fin N_O → ℝ := fun s o => ∑ d : Fin N_D, p_cd s o d
    let p_cd_D : Fin M_split → Fin N_D → ℝ := fun s d => ∑ o : Fin N_O, p_cd s o d
    have hp_cd_O_eq : ∀ s o, p_cd_O s o = if α s = 0 then 0 else q_O s o / α s := by
      intro s o; dsimp [p_cd_O, p_cd, q_O]
      by_cases h0 : α s = 0
      · simp [h0]
      · simp [h0, ← Finset.sum_div]
    have hp_cd_D_eq : ∀ s d, p_cd_D s d = if α s = 0 then 0 else q_D s d / α s := by
      intro s d; dsimp [p_cd_D, p_cd, q_D]
      by_cases h0 : α s = 0
      · simp [h0]
      · simp [h0, ← Finset.sum_div]
    have hα_mul_O : ∀ s o, α s * p_cd_O s o = q_O s o := by
      intro s o; rw [hp_cd_O_eq]
      by_cases h0 : α s = 0
      · have hq0 : ∀ o' ∈ (Finset.univ : Finset (Fin N_O)), q_O s o' = 0 :=
          (Finset.sum_eq_zero_iff_of_nonneg (fun o' _ => hqO_nn s o')).mp h0
        simp [h0, hq0 o (Finset.mem_univ o)]
      · rw [if_neg h0, mul_div_cancel₀ _ h0]
    have hα_mul_D : ∀ s d, α s * p_cd_D s d = q_D s d := by
      intro s d; rw [hp_cd_D_eq]
      by_cases h0 : α s = 0
      · have hα_D : ∑ d' : Fin N_D, q_D s d' = α s := by dsimp [α, q_D]; exact Finset.sum_comm
        have hq0 : ∀ d' ∈ (Finset.univ : Finset (Fin N_D)), q_D s d' = 0 :=
          (Finset.sum_eq_zero_iff_of_nonneg (fun d' _ => hqD_nn s d')).mp (hα_D.trans h0)
        simp [h0, hq0 d (Finset.mem_univ d)]
      · rw [if_neg h0, mul_div_cancel₀ _ h0]
    
    have h_HO_each : ∀ s o,
        -(q_O s o * Real.log (p_O o)) ≤
          -(q_O s o * Real.log (α s)) + α s * (-(p_cd_O s o * Real.log (p_cd_O s o))) := by
      intro s o
      by_cases hqo0 : q_O s o = 0
      · rw [hp_cd_O_eq, hqo0]
        by_cases h0 : α s = 0 <;> simp [h0]
      · have hqo_pos : 0 < q_O s o := lt_of_le_of_ne (hqO_nn s o) (Ne.symm hqo0)
        have hpo_ge : q_O s o ≤ p_O o := by
          rw [← hqO_sum_s o]
          exact Finset.single_le_sum (fun s' _ => hqO_nn s' o) (Finset.mem_univ s)
        have hα_ge : q_O s o ≤ α s :=
          Finset.single_le_sum (fun o' _ => hqO_nn s o') (Finset.mem_univ o)
        have hα_pos : 0 < α s := lt_of_lt_of_le hqo_pos hα_ge
        have hcd_eq : p_cd_O s o = q_O s o / α s := by rw [hp_cd_O_eq, if_neg hα_pos.ne']
        have hcd_pos : 0 < p_cd_O s o := by rw [hcd_eq]; exact div_pos hqo_pos hα_pos
        have hlog_le : Real.log (q_O s o) ≤ Real.log (p_O o) := Real.log_le_log hqo_pos hpo_ge
        have hmul_eq : q_O s o = α s * p_cd_O s o := (hα_mul_O s o).symm
        have hlog_split : Real.log (q_O s o) = Real.log (α s) + Real.log (p_cd_O s o) := by
          conv_lhs => rw [hmul_eq]
          exact Real.log_mul hα_pos.ne' hcd_pos.ne'
        have h_step : -(q_O s o * Real.log (p_O o)) ≤ -(q_O s o * Real.log (q_O s o)) := by
          have hm := mul_le_mul_of_nonneg_left hlog_le hqo_pos.le
          linarith only [hm]
