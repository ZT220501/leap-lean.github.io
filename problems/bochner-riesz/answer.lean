      (∀ {N : ℕ} (s₁ s₂ W : ℝ) (M_m : ℕ)
         (c₁ c₂ : EuclideanSpace ℝ (Fin 2))
         (o_at : Fin N → (ℤ × ℤ) × (ℤ × ℤ))
         (S : Finset (Fin N)),
