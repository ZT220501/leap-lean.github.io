          (∑ z ∈ ImZ, (((w_YZ (f x) z * w_X x) / (w_Y (f x) * w_XZ x z)) * w_XZ x z)) ≤
            w_X x := by
        intro x _
        have h_term : ∀ z ∈ ImZ,
