                  rcases eq_or_lt_of_le (hπ_nn ω) with h0 | hpos
                  · rw [← h0]; simp
                  · have hj_mem := hω_in_SJ ω hpos
                    have hpj_pos := (hπj_props (J_fn ω) hj_mem).1
                    have hpj_unit : finProbAt (π_j_fn (J_fn ω)) (fun _ => ()) ω = 1 := by
