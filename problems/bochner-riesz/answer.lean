  have h_mod : UniformPacketGrowthModulus γ (quantumPacketRate γ) := by
    intro cls t_min δ ht_min ht_hor hδ
    have h_ne : (ValidPacketGrowthRates γ).Nonempty := ⟨1, h_one⟩
    have h_lt : sInf (ValidPacketGrowthRates γ) < quantumPacketRate γ + δ / 2 := by
      change quantumPacketRate γ < quantumPacketRate γ + δ / 2
      linarith
    obtain ⟨b₀, hb₀_mem, hb₀_lt⟩ := exists_lt_of_csInf_lt h_ne h_lt
    obtain ⟨ε₀, hε₀_pos, hε₀_lt, h_est⟩ :=
      hb₀_mem.2.2 cls.a₀ cls.a₁ cls.A cls.R_dom cls.B_sys cls.K_hor cls.R_win
        t_min (δ / 2) cls.N_mult cls.M_win
        cls.ha₀ cls.ha₁ cls.hA cls.hR_dom cls.hB_sys cls.hK_hor cls.hR_win
        ht_min ht_hor (half_pos hδ) cls.hN_mult
    refine ⟨ε₀, hε₀_pos, hε₀_lt, ?_⟩
    intro ε H_P L t lam_sys m_time Φ₀ ζ₀ f N_O N_D r_O V_O X_O ψ_O
      b_D a_D r_D e_D V_D X_D p hε_lt ht_ge ht_L ht_HP henv hm1 hm2 hadm
    rcases henv with ⟨hε_pos, _, _, hHP_K, _, hL_K, hlam1, hlam2,
      hphase, hf_meas, hf_supp, hf_l2, hf_pos⟩
    have h_bound := h_est ε H_P L t lam_sys m_time hε_pos hε_lt
      ht_ge ht_L ht_HP hHP_K hL_K hlam1 hlam2 hm1 hm2
      Φ₀ ζ₀ hphase f hf_meas hf_supp hf_l2 hf_pos
      N_O N_D r_O V_O X_O ψ_O b_D a_D r_D e_D V_D X_D p hadm
    have ht_pos : 0 < t := lt_of_lt_of_le ht_min ht_ge
    nlinarith

  
  have h_sat : ∀ Δ : ℝ, 0 < Δ →
      ∃ cls : PacketBoundClass, IsDurationOneSaturatingClass γ Δ cls := by
    intro Δ hΔ
    by_contra h_no_sat
    let b_low : ℝ := max 0 (quantumPacketRate γ - Δ / 2)
    have hb_low_nn : 0 ≤ b_low := le_max_left _ _
    have hb_low_lt : b_low < quantumPacketRate γ := max_lt hβ_pos (by linarith)
    have hb_low_le : b_low ≤ 1 := le_trans hb_low_lt.le hβ_le
    have hb_low_ge : quantumPacketRate γ - Δ / 2 ≤ b_low := le_max_right _ _
    have hb_mem : b_low ∈ ValidPacketGrowthRates γ := by
      refine ⟨hb_low_nn, hb_low_le, ?_⟩
      intro a₀ a₁ A R_dom B_sys K_hor R_win t_min δ N_mult M_win
        ha₀ ha₁ hA hR_dom hB_sys hK_hor hR_win ht_min ht_hor hδ hN_mult
      let cls : PacketBoundClass := {
        a₀ := a₀
        a₁ := a₁
        A := A
        R_dom := R_dom
        B_sys := B_sys
        K_hor := K_hor / t_min
        R_win := R_win
        N_mult := N_mult
        M_win := M_win
        ha₀ := ha₀
        ha₁ := ha₁
        hA := hA
        hR_dom := hR_dom
        hB_sys := hB_sys
        hK_hor := (one_le_div ht_min).mpr ht_hor
        hR_win := hR_win
        hN_mult := hN_mult
      }
      have h_not_cls : ¬ IsDurationOneSaturatingClass γ Δ cls :=
        fun hcls => h_no_sat ⟨cls, hcls⟩
      unfold IsDurationOneSaturatingClass at h_not_cls
      push Not at h_not_cls
      obtain ⟨ε₀, hε₀_pos, hε₀_lt, h_no_wit⟩ := h_not_cls
      let ε₁ : ℝ := min (1 / 4) (ε₀ ^ (t_min⁻¹))
      have hε₁_pos : 0 < ε₁ := lt_min (by norm_num) (Real.rpow_pos_of_pos hε₀_pos _)
      have hε₁_lt : ε₁ < 1 / 2 := lt_of_le_of_lt (min_le_left _ _) (by norm_num)
      refine ⟨ε₁, hε₁_pos, hε₁_lt, ?_⟩
      intro ε H_P L t lam_sys m_time hε_pos hε_lt ht_ge ht_L ht_HP hHP_K hL_K
        hlam1 hlam2 hm1 hm2 Φ₀ ζ₀ hphase f hf_meas hf_supp hf_l2 hf_pos
        N_O N_D r_O V_O X_O ψ_O b_D a_D r_D e_D V_D X_D p hadm
      by_contra h_not_le
      have h_gt_score :
          generalPacketRootScore ε H_P L R_dom γ lam_sys Φ₀ f + (b_low + δ) * t <
            generalPacketScore ε γ H_P t lam_sys m_time Φ₀ f
              N_O N_D r_O V_O X_O ψ_O b_D a_D p :=
        lt_of_not_ge h_not_le
      have ht_pos : 0 < t := lt_of_lt_of_le ht_min ht_ge
      have ht_ne : t ≠ 0 := ne_of_gt ht_pos
      have hε_le_quarter : ε < 1 / 4 := lt_of_lt_of_le hε_lt (min_le_left _ _)
      have hε_half : ε < 1 / 2 := by linarith
      have hε_le_one : ε ≤ 1 := by linarith
      have hε_lt_rpow : ε < ε₀ ^ (t_min⁻¹) := lt_of_lt_of_le hε_lt (min_le_right _ _)
      have hεt_min_lt : ε ^ t_min < ε₀ := by
        have h1 := Real.rpow_lt_rpow hε_pos.le hε_lt_rpow ht_min
        rw [← Real.rpow_mul hε₀_pos.le, inv_mul_cancel₀ (ne_of_gt ht_min),
          Real.rpow_one] at h1
        exact h1
      have hεt_le : ε ^ t ≤ ε ^ t_min :=
        Real.rpow_le_rpow_of_exponent_ge hε_pos hε_le_one ht_ge
      have hεt_lt_ε₀ : ε ^ t < ε₀ := lt_of_le_of_lt hεt_le hεt_min_lt
      have hεt_half : ε ^ t < 1 / 2 := lt_trans hεt_lt_ε₀ hε₀_lt
      have hεt_pos : 0 < ε ^ t := Real.rpow_pos_of_pos hε_pos t
      have hHP_div1 : 1 ≤ H_P / t := (one_le_div ht_pos).mpr ht_HP
      have hL_div1 : 1 ≤ L / t := (one_le_div ht_pos).mpr ht_L
      have hK_nn : 0 ≤ K_hor := by linarith
      have hHP_divK : H_P / t ≤ K_hor / t_min := by
        calc H_P / t ≤ K_hor / t := div_le_div_of_nonneg_right hHP_K ht_pos.le
          _ ≤ K_hor / t_min := div_le_div_of_nonneg_left hK_nn ht_min ht_ge
      have hL_divK : L / t ≤ K_hor / t_min := by
        calc L / t ≤ K_hor / t := div_le_div_of_nonneg_right hL_K ht_pos.le
          _ ≤ K_hor / t_min := div_le_div_of_nonneg_left hK_nn ht_min ht_ge
      have h_exp_HP : (ε ^ t) ^ (-(H_P / t)) = ε ^ (-H_P) := by
        rw [← Real.rpow_mul hε_pos.le]
        congr 1
        field_simp [ht_ne]
      have henv_sc : IsValidPacketEnv cls (ε ^ t) (H_P / t) (L / t) lam_sys Φ₀ ζ₀ f := by
        refine ⟨hεt_pos, hεt_half, by linarith, hHP_divK, by linarith, hL_divK,
          ?_, ?_, hphase, hf_meas, hf_supp, hf_l2, hf_pos⟩
        · change B_sys⁻¹ * (ε ^ t) ^ (-(H_P / t)) ≤ lam_sys
          rwa [h_exp_HP]
        · change lam_sys ≤ B_sys * (ε ^ t) ^ (-(H_P / t))
          rwa [h_exp_HP]
      have hm1_sc : cls.B_sys⁻¹ * (ε ^ t) ^ (1 : ℝ) ≤ ((2 : ℝ) ^ m_time)⁻¹ := by
        change B_sys⁻¹ * (ε ^ t) ^ (1 : ℝ) ≤ ((2 : ℝ) ^ m_time)⁻¹
        rwa [Real.rpow_one]
      have hm2_sc : ((2 : ℝ) ^ m_time)⁻¹ ≤ cls.B_sys * (ε ^ t) ^ (1 : ℝ) := by
        change ((2 : ℝ) ^ m_time)⁻¹ ≤ B_sys * (ε ^ t) ^ (1 : ℝ)
        rwa [Real.rpow_one]
      have h_sc := h_dur ε H_P L t R_dom B_sys R_win N_mult M_win lam_sys m_time Φ₀ f
        N_O N_D r_O V_O X_O ψ_O b_D a_D r_D e_D V_D X_D p
        hε_pos hε_half ht_pos hεt_half
      have hadm_sc := h_sc.1 hadm
      have hscore_sc :
          generalPacketRootScore (ε ^ t) (H_P / t) (L / t) cls.R_dom γ lam_sys Φ₀ f +
              quantumPacketRate γ - Δ ≤
            generalPacketScore (ε ^ t) γ (H_P / t) 1 lam_sys m_time Φ₀ f
              N_O N_D r_O V_O X_O ψ_O (fun j => b_D j / t) (fun j => a_D j / t) p := by
        change generalPacketRootScore (ε ^ t) (H_P / t) (L / t) R_dom γ lam_sys Φ₀ f +
            quantumPacketRate γ - Δ ≤ _
        rw [h_sc.2.1, h_sc.2.2.1]
        have h_mul := mul_lt_mul_of_pos_left h_gt_score (inv_pos.mpr ht_pos)
        have h_id : t⁻¹ *
            (generalPacketRootScore ε H_P L R_dom γ lam_sys Φ₀ f + (b_low + δ) * t) =
            t⁻¹ * generalPacketRootScore ε H_P L R_dom γ lam_sys Φ₀ f + b_low + δ := by
          field_simp [ht_ne]
          ring
        linarith
      exact not_le_of_gt
        (h_no_wit (ε ^ t) (H_P / t) (L / t) lam_sys m_time Φ₀ ζ₀ f
          N_O N_D r_O V_O X_O ψ_O (fun j => b_D j / t) (fun j => a_D j / t)
          r_D e_D V_D X_D p
          hεt_lt_ε₀ hHP_div1 hL_div1 henv_sc hm1_sc hm2_sc hadm_sc)
        hscore_sc
    have h_le : quantumPacketRate γ ≤ b_low := csInf_le h_bdd hb_mem
    linarith

  exact ⟨hβ_pos, hβ_le, h_resc, h_dur, h_mod, h_sat⟩

theorem cut_mode_inversion_and_window_bounds (C_χ : ℝ) (hC_χ : 1 ≤ C_χ)
    (h_pou_smooth : ∀ k : ℕ, ContDiff ℝ k pktPou2D)
    (h_pou_supp : ∀ z : EuclideanSpace ℝ (Fin 2), 2 ≤ ‖z‖ → pktPou2D z = 0)
    (h_pou_deriv : ∀ (k : ℕ) (z : EuclideanSpace ℝ (Fin 2)),
      ‖iteratedFDeriv ℝ k pktPou2D z‖ ≤ C_χ ^ (k + 1) * ((k.factorial : ℝ) ^ 4)) :
    ∃ M_atom : ℝ → ℝ → ℝ → ℝ → ℝ → ℕ → ℝ,
      (∀ a₀ a₁ A B_sys R_win k, 0 ≤ M_atom a₀ a₁ A B_sys R_win k) ∧
      ∀ (a₀ a₁ A B_sys R_win : ℝ),
        0 < a₀ → a₀ ≤ a₁ → 1 ≤ A → 2 ≤ B_sys → 2 ≤ R_win →
        ∃ (C_can : ℝ) (M_mult : ℕ),
          1 ≤ C_can ∧ 1 ≤ M_mult ∧
          ∀ (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
            (ζ₀ : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → EuclideanSpace ℝ (Fin 2)),
            IsNormalizedPosDefPhase a₀ a₁ A Φ₀ ζ₀ →
          ∀ (lam_sys ρ_r s_c C_r : ℝ) (X_J : EuclideanSpace ℝ (Fin 2)),
            0 < lam_sys → 0 < ρ_r → ρ_r ≤ 1 → 0 < s_c → s_c ≤ 1 →
            C_r ∈ Set.Icc (0 : ℝ) 1 →
            lam_sys * ρ_r ^ 2 * s_c ≤ 2 * B_sys ^ 2 →
            let σ_r := (lam_sys * ρ_r)⁻¹
            ∃ X_ex : (ℤ × ℤ) → (ℤ × ℤ) → EuclideanSpace ℝ (Fin 2),
              (∀ j n : ℤ × ℤ,
                ζ₀ (gridPt2D ρ_r j, X_ex j n - C_r • gridPt2D ρ_r j) =
                  ζ₀ (gridPt2D ρ_r j, X_J - C_r • gridPt2D ρ_r j) -
                    ((Real.pi * σ_r / 2) : ℝ) • gridPt2D 1 n) ∧
              (∀ p₁ p₂ v : EuclideanSpace ℝ (Fin 2),
                a₀ * ‖p₁ - p₂‖ ≤ ‖ζ₀ (v, p₁) - ζ₀ (v, p₂)‖ ∧
                ‖ζ₀ (v, p₁) - ζ₀ (v, p₂)‖ ≤ a₁ * ‖p₁ - p₂‖) ∧
              (∀ j n : ℤ × ℤ,
                ‖gridPt2D σ_r (pktRound2D σ_r (X_ex j n)) - X_ex j n‖ ≤ σ_r) ∧
              (∀ (S_fib : Finset ((ℤ × ℤ) × (ℤ × ℤ))) (o₀ : (ℤ × ℤ) × (ℤ × ℤ)),
                (∀ q ∈ S_fib, (q.1, pktRound2D σ_r (X_ex q.1 q.2)) = o₀) →
                  S_fib.card ≤ M_mult) ∧
              (∀ (j n : ℤ × ℤ) (X_at : EuclideanSpace ℝ (Fin 2)),
                let ψ_at := cutPacketWindow lam_sys ρ_r C_r X_J X_at Φ₀ j n
                let V_j := gridPt2D ρ_r j
                (∀ v : EuclideanSpace ℝ (Fin 2),
                  (ρ_r⁻¹ : ℂ) * star (ψ_at (ρ_r⁻¹ • (v - V_j))) *
                    Complex.exp (-(Complex.I * ((lam_sys * Φ₀ (C_r, X_at, v) : ℝ) : ℂ))) =
                  cutLinearAtom lam_sys ρ_r C_r X_J Φ₀ j n v) ∧
                (∀ f : EuclideanSpace ℝ (Fin 2) → ℂ,
                  (ρ_r⁻¹ : ℂ) * ∫ v : EuclideanSpace ℝ (Fin 2),
                    f v * ψ_at (ρ_r⁻¹ • (v - V_j)) *
                      Complex.exp (Complex.I * ((lam_sys * Φ₀ (C_r, X_at, v) : ℝ) : ℂ)) =
                  cutLinearCoeff lam_sys ρ_r C_r X_J Φ₀ f j n) ∧
                (‖X_at - X_ex j n‖ ≤ σ_r →
                  ‖X_at - X_J‖ ≤ (8 * B_sys + 2 * R_win + 10) * s_c →
                  (∀ k : ℕ, ContDiff ℝ k ψ_at) ∧
                  (∀ z : EuclideanSpace ℝ (Fin 2), 4 ≤ ‖z‖ → ψ_at z = 0) ∧
                  (∀ (k : ℕ) (z : EuclideanSpace ℝ (Fin 2)),
                    ‖iteratedFDeriv ℝ k ψ_at z‖ ≤ M_atom a₀ a₁ A B_sys R_win k))) ∧
              (C_r = 1 / 2 → s_c = 1 → ρ_r = (Real.sqrt lam_sys)⁻¹ → 2 ≤ lam_sys →
                ∀ (f : EuclideanSpace ℝ (Fin 2) → ℂ),
                  MeasureTheory.AEStronglyMeasurable f MeasureTheory.volume →
                  MeasureTheory.MemLp f 2 MeasureTheory.volume →
                  ∀ j n : ℤ × ℤ,
                    let k_X := pktRound2D ρ_r (X_ex j n)
                    ‖gridPt2D ρ_r k_X - X_J‖ ≤ 8 * B_sys + 2 * R_win + 10 →
                    ‖cutLinearCoeff lam_sys ρ_r (1 / 2) X_J Φ₀ f j n‖ ^ 2 ≤
                      C_can * canonicalRootMass lam_sys Φ₀ f (j, k_X)) :=
by
  let E := EuclideanSpace ℝ (Fin 2)
  let B_θ_fn : ℝ → ℝ → ℝ → ℝ := fun A B_sys R_win =>
    let A' := max 1 A
    let B' := max 2 B_sys
    let R' := max 2 R_win
    A' + 4 * B' ^ 2 * (8 * B' + 2 * R' + 10) * A' ^ 2
  let C₁_fn : ℝ → ℝ → ℝ → ℝ := fun A B_sys R_win =>
    2 * max C_χ (B_θ_fn A B_sys R_win * Real.exp 3)
  let M_atom : ℝ → ℝ → ℝ → ℝ → ℝ → ℕ → ℝ := fun _a₀ _a₁ A B_sys R_win k =>
    (C₁_fn A B_sys R_win) ^ (k + 1) * ((k.factorial : ℝ) ^ 4)
  have hM_atom_nn : ∀ a₀ a₁ A B_sys R_win k, 0 ≤ M_atom a₀ a₁ A B_sys R_win k := by
    intro a₀ a₁ A B_sys R_win k
    have hC₁_nn : 0 ≤ C₁_fn A B_sys R_win := by
      dsimp [C₁_fn]
      have h1 : 0 ≤ max C_χ (B_θ_fn A B_sys R_win * Real.exp 3) :=
        le_trans (by linarith : (0 : ℝ) ≤ C_χ) (le_max_left _ _)
      linarith
    dsimp [M_atom]
    positivity
  refine ⟨M_atom, hM_atom_nn, ?_⟩
  intro a₀ a₁ A B_sys R_win ha₀ ha₁ hA hB_sys hR_win
  have ha₁_pos : 0 < a₁ := lt_of_lt_of_le ha₀ ha₁
  have ha₁_nn : 0 ≤ a₁ := ha₁_pos.le
  let R_chirp : ℝ := 2 * B_sys ^ 2 * (8 * B_sys + 2 * R_win + 10)
  have hR_chirp_pos : 0 < R_chirp := by dsimp [R_chirp]; positivity
  let B_θ : ℝ := A + 2 * R_chirp * A ^ 2
  have hB_θ_ge1 : 1 ≤ B_θ := by dsimp [B_θ]; nlinarith [hR_chirp_pos, hA]
  have hB_θ_pos : 0 < B_θ := lt_of_lt_of_le zero_lt_one hB_θ_ge1
  have hB_θ_eq : B_θ_fn A B_sys R_win = B_θ := by
    dsimp [B_θ_fn, B_θ, R_chirp]
    rw [max_eq_right hA, max_eq_right hB_sys, max_eq_right hR_win]
    ring
  let M₁ : ℝ := max C_χ (B_θ * Real.exp 3)
  let C₁ : ℝ := 2 * M₁
  have hC₁_pos : 0 < C₁ := by
    dsimp [C₁, M₁]
    have h1 : 1 ≤ max C_χ (B_θ * Real.exp 3) := le_trans hC_χ (le_max_left _ _)
    linarith
  have hC₁_eq : C₁_fn A B_sys R_win = C₁ := by
    dsimp [C₁_fn, C₁, M₁]
    rw [hB_θ_eq]
  let C_amp : ℝ := max 1 ((C₁ / 100) * Real.exp (C₁ / 100))
  have hC_amp_ge1 : 1 ≤ C_amp := le_max_left _ _
  have hC_amp_pos : 0 < C_amp := lt_of_lt_of_le zero_lt_one hC_amp_ge1
  let C_can : ℝ := C_amp ^ 2
  have hC_can_ge1 : 1 ≤ C_can := by dsimp [C_can]; nlinarith [hC_amp_ge1]
  let K_mult : ℕ := ⌈2 * a₁⌉₊
  let M_mult : ℕ := (2 * K_mult + 1) ^ 2
  have hM_mult_ge1 : 1 ≤ M_mult := by
    dsimp [M_mult]
    exact Nat.one_le_pow 2 (2 * K_mult + 1) (by omega)

  
  have h_grid_coord : ∀ (s : ℝ), 0 ≤ s → ∀ (k : ℤ × ℤ),
      s * |(k.1 : ℝ)| ≤ ‖gridPt2D s k‖ ∧ s * |(k.2 : ℝ)| ≤ ‖gridPt2D s k‖ := by
    intro s hs k
    have h0 := PiLp.norm_apply_le (gridPt2D s k) 0
    have h1 := PiLp.norm_apply_le (gridPt2D s k) 1
    have hc0 : (gridPt2D s k).ofLp 0 = s * (k.1 : ℝ) := by simp [gridPt2D]
    have hc1 : (gridPt2D s k).ofLp 1 = s * (k.2 : ℝ) := by simp [gridPt2D]
    rw [hc0, Real.norm_eq_abs, abs_mul, abs_of_nonneg hs] at h0
    rw [hc1, Real.norm_eq_abs, abs_mul, abs_of_nonneg hs] at h1
    exact ⟨h0, h1⟩
  have h_grid_sub : ∀ (n n₀ : ℤ × ℤ),
      gridPt2D 1 n - gridPt2D 1 n₀ = gridPt2D 1 (n.1 - n₀.1, n.2 - n₀.2) := by
    intro n n₀
    ext i
    fin_cases i <;> simp [gridPt2D, Int.cast_sub]
  have h_round_err : ∀ (s : ℝ), 0 < s → ∀ (x : E),
      ‖gridPt2D s (pktRound2D s x) - x‖ ≤ s := by
    intro s hs x
    rw [norm_sub_rev]
    let k := pktRound2D s x
    have h0 : |x.ofLp 0 - s * (k.1 : ℝ)| ≤ (1 / 2) * s := by
      have hfl : (k.1 : ℝ) ≤ s⁻¹ * x 0 + 1 / 2 := Int.floor_le _
      have hlt : s⁻¹ * x 0 + 1 / 2 < (k.1 : ℝ) + 1 := Int.lt_floor_add_one _
      have hm1 := mul_le_mul_of_nonneg_left hfl hs.le
      have hm2 := mul_lt_mul_of_pos_left hlt hs
      have hmul : s * (s⁻¹ * x 0 + 1 / 2) = x.ofLp 0 + (1 / 2) * s := by
        field_simp [hs.ne']
      rw [hmul] at hm1 hm2
      rw [mul_add, mul_one] at hm2
      rw [abs_le]
      exact ⟨by linarith only [hm1], by linarith only [hm2]⟩
    have h1 : |x.ofLp 1 - s * (k.2 : ℝ)| ≤ (1 / 2) * s := by
      have hfl : (k.2 : ℝ) ≤ s⁻¹ * x 1 + 1 / 2 := Int.floor_le _
      have hlt : s⁻¹ * x 1 + 1 / 2 < (k.2 : ℝ) + 1 := Int.lt_floor_add_one _
      have hm1 := mul_le_mul_of_nonneg_left hfl hs.le
      have hm2 := mul_lt_mul_of_pos_left hlt hs
      have hmul : s * (s⁻¹ * x 1 + 1 / 2) = x.ofLp 1 + (1 / 2) * s := by
        field_simp [hs.ne']
      rw [hmul] at hm1 hm2
      rw [mul_add, mul_one] at hm2
      rw [abs_le]
      exact ⟨by linarith only [hm1], by linarith only [hm2]⟩
    have hsq : ‖x - gridPt2D s k‖ ^ 2 ≤ s ^ 2 := by
      rw [EuclideanSpace.norm_sq_eq, Fin.sum_univ_two]
      have hc0 : (x - gridPt2D s k).ofLp 0 = x.ofLp 0 - s * (k.1 : ℝ) := by
        dsimp [E]
        simp [gridPt2D]
      have hc1 : (x - gridPt2D s k).ofLp 1 = x.ofLp 1 - s * (k.2 : ℝ) := by
        dsimp [E]
        simp [gridPt2D]
      rw [hc0, hc1, Real.norm_eq_abs, Real.norm_eq_abs]
      have h0_nn : 0 ≤ (1 / 2 : ℝ) * s := mul_nonneg (by norm_num) hs.le
      have h0s : |x.ofLp 0 - s * (k.1 : ℝ)| ^ 2 ≤ ((1 / 2) * s) ^ 2 :=
        sq_le_sq.mpr (by rwa [abs_abs, abs_of_nonneg h0_nn])
      have h1s : |x.ofLp 1 - s * (k.2 : ℝ)| ^ 2 ≤ ((1 / 2) * s) ^ 2 :=
        sq_le_sq.mpr (by rwa [abs_abs, abs_of_nonneg h0_nn])
      nlinarith only [h0s, h1s]
    have h_nn := norm_nonneg (x - gridPt2D s k)
    nlinarith only [hsq, h_nn, hs]
  let g_pos : ℝ → ℂ := fun t => Complex.exp (Complex.I * (t : ℂ))
  have hg_pos_smooth : ∀ k : ℕ, ContDiff ℝ k g_pos := by
    intro k
    exact Complex.contDiff_exp.comp (contDiff_const.mul Complex.ofRealCLM.contDiff)
  have hg_pos_norm : ∀ t : ℝ, ‖g_pos t‖ = 1 := by
    intro t
    dsimp [g_pos]
    rw [mul_comm Complex.I (t : ℂ)]
    exact Complex.norm_exp_ofReal_mul_I t
  have hg_pos_iter : ∀ (i : ℕ) (t : ℝ), ‖iteratedFDeriv ℝ i g_pos t‖ ≤ 1 := by
    have h_id_deriv : ∀ (i : ℕ) (t : ℝ), iteratedDeriv i g_pos t = Complex.I ^ i * g_pos t := by
      intro i
      induction i with
      | zero =>
        intro t
        simp
      | succ i ih =>
        intro t
        have h_ofReal : HasDerivAt (fun s : ℝ => (s : ℂ)) 1 t :=
          (Complex.ofRealCLM.hasFDerivAt (x := t)).hasDerivAt
        have h_lin : HasDerivAt (fun s : ℝ => Complex.I * (s : ℂ)) (Complex.I * 1) t :=
          h_ofReal.const_mul Complex.I
        have h_exp : HasDerivAt g_pos (g_pos t * (Complex.I * 1)) t := h_lin.cexp
        rw [iteratedDeriv_succ]
        have h_fn : iteratedDeriv i g_pos = fun s : ℝ => Complex.I ^ i * g_pos s := funext ih
        rw [h_fn, (h_exp.const_mul (Complex.I ^ i)).deriv, pow_succ]
        ring
    intro i t
    rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv, h_id_deriv i t, norm_mul, norm_pow,
      Complex.norm_I, one_pow, one_mul, hg_pos_norm t]

  refine ⟨C_can, M_mult, hC_can_ge1, hM_mult_ge1, ?_⟩
  intro Φ₀ ζ₀ h_phase
  obtain ⟨hΦ_smooth, hζ_smooth, _, _, _, hΦ_fderiv, hζ_symm, hζ_pos, hζ_gevrey⟩ := h_phase

  
  have hFv_smooth : ∀ (v : E) (k : ℕ), ContDiff ℝ k (fun p => ζ₀ (v, p)) := by
    intro v k
    exact (hζ_smooth k).comp (contDiff_const.prodMk contDiff_id)
  have hFv_diff : ∀ (v p : E), DifferentiableAt ℝ (fun p' => ζ₀ (v, p')) p := by
    intro v p
    exact ((hFv_smooth v 1).differentiable (by simp)).differentiableAt
  have hFv_fderiv_A : ∀ (v p : E), ‖fderiv ℝ (fun p' => ζ₀ (v, p')) p‖ ≤ A := by
    intro v p
    have h0 := hζ_gevrey 0 (v, p)
    rw [norm_iteratedFDeriv_zero] at h0
    simpa using h0
  have h_upper_A : ∀ (v p₁ p₂ : E), ‖ζ₀ (v, p₁) - ζ₀ (v, p₂)‖ ≤ A * ‖p₁ - p₂‖ := by
    intro v p₁ p₂
    exact convex_univ.norm_image_sub_le_of_norm_fderiv_le
      (fun p _ => hFv_diff v p) (fun p _ => hFv_fderiv_A v p)
      (Set.mem_univ p₂) (Set.mem_univ p₁)
  have hFv_fderiv_a₁ : ∀ (v p : E), ‖fderiv ℝ (fun p' => ζ₀ (v, p')) p‖ ≤ a₁ := by
    intro v p
    let L : E →L[ℝ] E := fderiv ℝ (fun p' => ζ₀ (v, p')) p
    refine ContinuousLinearMap.opNorm_le_bound L ha₁_nn (fun u => ?_)
    let w : E := L u
    let x : E := ‖w‖ • u
    let y : E := ‖u‖ • w
    have h_symm_xy : inner ℝ (L y) x = inner ℝ (L x) y := by
      have hs : inner ℝ (L y) x = inner ℝ y (L x) := hζ_symm v p y x
      rw [hs, real_inner_comm]
    have h_pol : inner ℝ (L (x + y)) (x + y) - inner ℝ (L (x - y)) (x - y) =
        4 * ‖u‖ * ‖w‖ ^ 3 := by
      rw [map_add, map_sub, inner_add_left, inner_add_right, inner_add_right,
        inner_sub_left, inner_sub_right, inner_sub_right, h_symm_xy]
      have hLx_y : inner ℝ (L x) y = ‖u‖ * ‖w‖ ^ 3 := by
        dsimp [x, y]
        rw [map_smul, real_inner_smul_left, real_inner_smul_right]
        change ‖w‖ * (‖u‖ * inner ℝ w w) = ‖u‖ * ‖w‖ ^ 3
        rw [real_inner_self_eq_norm_sq]
        ring
      linarith [hLx_y]
    have h_neg_nn : 0 ≤ inner ℝ (L (x - y)) (x - y) :=
      le_trans (mul_nonneg ha₀.le (sq_nonneg _)) (hζ_pos v p (x - y)).1
    have h_xpy_norm : ‖x + y‖ ≤ 2 * ‖u‖ * ‖w‖ := by
      calc ‖x + y‖ ≤ ‖x‖ + ‖y‖ := norm_add_le x y
        _ = ‖w‖ * ‖u‖ + ‖u‖ * ‖w‖ := by
            dsimp [x, y]
            rw [norm_smul, norm_smul, Real.norm_of_nonneg (norm_nonneg w),
              Real.norm_of_nonneg (norm_nonneg u)]
        _ = 2 * ‖u‖ * ‖w‖ := by ring
    have h_xpy_sq : ‖x + y‖ ^ 2 ≤ 4 * ‖u‖ ^ 2 * ‖w‖ ^ 2 := by
      calc ‖x + y‖ ^ 2 ≤ (2 * ‖u‖ * ‖w‖) ^ 2 :=
            pow_le_pow_left₀ (norm_nonneg _) h_xpy_norm 2
        _ = 4 * ‖u‖ ^ 2 * ‖w‖ ^ 2 := by ring
