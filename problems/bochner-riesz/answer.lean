    refine le_trans h_raw (mul_le_mul_of_nonneg_right ?_ (Real.rpow_nonneg (le_trans hρ.1.le hr_lo) α))
    exact Real.rpow_le_rpow_of_exponent_ge hρ.1 (by linarith [hρ.2]) (by linarith)

  have h_lin_1d_cov : ∀ {N : ℕ} (ρ κ κ_out α : ℝ) (M : ℕ) (S_act : Finset (Fin N)) (x : Fin N → ℝ),
      0 < ρ ∧ ρ < 1 / 2 → 1 ≤ M → 0 ≤ α → α ≤ 2 →
      κ + 2 / (M : ℝ) + Real.log 9 / Real.log (ρ⁻¹) ≤ κ_out →
      (∀ (r_idx : ℕ), 1 ≤ r_idx → r_idx ≤ M →
        letI := Classical.propDecidable
        (((S_act.image (fun i =>
            dyadicRealBin ρ ((r_idx : ℝ) / (M : ℝ)) (x i))).card : ℝ) ≤
          ρ ^ (-α * ((r_idx : ℝ) / (M : ℝ)) - κ))) →
      ∀ r : ℝ, ρ ≤ r → r ≤ 1 →
        ∃ S_cov : Finset ℝ,
          (S_cov.card : ℝ) ≤ ρ ^ (-κ_out) * r ^ (-α) ∧
          ∀ i ∈ S_act, ∃ c₀ ∈ S_cov, |x i - c₀| ≤ r := by
    intro N ρ κ κ_out α M S_act x hρ hM hα0 hα2 hκ_le h_supp r hr_lo hr_hi
    have hL_pos : 0 < Real.log (ρ⁻¹) := h_log_inv_pos ρ hρ
    have hM_pos : 0 < (M : ℝ) := by exact_mod_cast (lt_of_lt_of_le Nat.zero_lt_one hM)
    obtain ⟨_, _, hρ_τ⟩ := h_tau_rpow ρ r hρ hr_lo hr_hi
    let τ := Real.log (r⁻¹) / Real.log (ρ⁻¹)
    obtain ⟨S_cov, hS_card, hS_mem⟩ :=
      (h_upgrade ρ M hρ hM).2.2 κ α (fun d => α * d) S_act x hα0
        (fun d₁ d₂ _ => by linarith [show α * d₂ - α * d₁ = α * (d₂ - d₁) by ring])
        (fun r_idx hr1 hrM => by
          have hs := h_supp r_idx hr1 hrM
          rwa [neg_mul] at hs)
        r hr_lo hr_hi
    refine ⟨S_cov, ?_, hS_mem⟩
    have hα_div : α / (M : ℝ) ≤ 2 / (M : ℝ) := div_le_div_of_nonneg_right hα2 hM_pos.le
    have hlog9_pos : 0 < Real.log 9 / Real.log (ρ⁻¹) :=
      div_pos (Real.log_pos (by norm_num)) hL_pos
    have h_rpow_eq : ρ ^ (-(α * τ) - κ_out) = ρ ^ (-κ_out) * r ^ (-α) := by
      change ρ ^ τ = r at hρ_τ
      rw [← hρ_τ, ← Real.rpow_mul hρ.1.le, ← Real.rpow_add hρ.1]
      congr 1
      ring
    rw [← h_rpow_eq]
    exact le_trans hS_card
      (Real.rpow_le_rpow_of_exponent_ge hρ.1 (by linarith [hρ.2]) (by linarith))

  
  have h_arzela : ∀ (q_cap : ℝ) (κ_err : ℕ → ℝ) (g_seq : ℕ → ℝ → ℝ),
      Filter.Tendsto κ_err Filter.atTop (nhds 0) →
      (∀ l : ℕ, g_seq l 0 = 0) →
      (∀ (l : ℕ) (d₁ d₂ : ℝ), d₁ ≤ d₂ →
        0 ≤ g_seq l d₂ - g_seq l d₁ ∧ g_seq l d₂ - g_seq l d₁ ≤ d₂ - d₁) →
      (∀ l : ℕ, g_seq l 1 ≤ q_cap + κ_err l) →
      ∃ (g_Y : ℝ → ℝ) (φ : ℕ → ℕ) (δ_unif : ℕ → ℝ),
        StrictMono φ ∧
        g_Y 0 = 0 ∧
        (∀ d₁ d₂ : ℝ, d₁ ≤ d₂ → 0 ≤ g_Y d₂ - g_Y d₁ ∧ g_Y d₂ - g_Y d₁ ≤ d₂ - d₁) ∧
        g_Y 1 ≤ q_cap ∧
        (∀ n : ℕ, 0 ≤ δ_unif n) ∧
        Filter.Tendsto δ_unif Filter.atTop (nhds 0) ∧
        (∀ (n : ℕ) (d : ℝ), d ∈ Set.Icc (0 : ℝ) 1 → |g_seq (φ n) d - g_Y d| ≤ δ_unif n) := by
    intro q_cap κ_err g_seq hκ_lim hg_zero hg_lip hg_cap
    let I01 : Set ℝ := Set.Icc (0 : ℝ) 1
    have h_lip_sub : ∀ l : ℕ, LipschitzWith 1 (fun x : I01 => g_seq l x.1) := by
      intro l
      refine LipschitzWith.of_dist_le_mul fun x y => ?_
      rw [NNReal.coe_one, one_mul, Real.dist_eq, Subtype.dist_eq, Real.dist_eq]
      rcases le_total x.1 y.1 with hxy | hyx
      · obtain ⟨h1, h2⟩ := hg_lip l x.1 y.1 hxy
        rw [abs_sub_comm, abs_of_nonneg h1, abs_sub_comm, abs_of_nonneg (sub_nonneg.mpr hxy)]
        exact h2
      · obtain ⟨h1, h2⟩ := hg_lip l y.1 x.1 hyx
        rw [abs_of_nonneg h1, abs_of_nonneg (sub_nonneg.mpr hyx)]
        exact h2
    let F : ℕ → BoundedContinuousFunction I01 ℝ := fun l =>
      BoundedContinuousFunction.mkOfCompact ⟨fun x : I01 => g_seq l x.1, (h_lip_sub l).continuous⟩
    let A : Set (BoundedContinuousFunction I01 ℝ) := Set.range F
    have h_comp : IsCompact (closure A) := by
      refine BoundedContinuousFunction.arzela_ascoli I01 isCompact_Icc A ?_ ?_
      · rintro f x ⟨l, rfl⟩
        rw [BoundedContinuousFunction.mkOfCompact_apply]
        change g_seq l x.1 ∈ Set.Icc (0 : ℝ) 1
        obtain ⟨h1, h2⟩ := hg_lip l 0 x.1 x.2.1
        rw [hg_zero l] at h1 h2
        exact ⟨by linarith, by linarith [x.2.2]⟩
      · refine UniformEquicontinuous.equicontinuous
          (LipschitzWith.uniformEquicontinuous
            (fun f : A => ⇑(f : BoundedContinuousFunction I01 ℝ)) 1 ?_)
        rintro ⟨f, l, rfl⟩
        have h_eq : (⇑(F l) : I01 → ℝ) = fun x : I01 => g_seq l x.1 := by
          ext x
          exact BoundedContinuousFunction.mkOfCompact_apply _ x
        rw [h_eq]
        exact h_lip_sub l
    obtain ⟨f_lim, _, φ, hφ_mono, hφ_lim⟩ :=
      IsCompact.tendsto_subseq h_comp (fun l => subset_closure ⟨l, rfl⟩)
    let δ_unif : ℕ → ℝ := fun n => dist (F (φ n)) f_lim
    have hδ_nn : ∀ n : ℕ, 0 ≤ δ_unif n := fun n => dist_nonneg
    have hδ_lim : Filter.Tendsto δ_unif Filter.atTop (nhds 0) :=
      tendsto_iff_dist_tendsto_zero.mp hφ_lim
    let clamp01 : ℝ → ℝ := fun d => min 1 (max 0 d)
    have h_clamp_mem : ∀ d : ℝ, clamp01 d ∈ I01 := fun d =>
      ⟨le_min zero_le_one (le_max_left 0 d), min_le_left 1 _⟩
    let g_Y : ℝ → ℝ := fun d => f_lim ⟨clamp01 d, h_clamp_mem d⟩
    have h_unif_I01 : ∀ (n : ℕ) (d : ℝ), d ∈ I01 → |g_seq (φ n) d - g_Y d| ≤ δ_unif n := by
      intro n d hd
      let x_d : I01 := ⟨d, hd⟩
      have hc : clamp01 d = d := by
        dsimp [clamp01]
        rw [max_eq_right hd.1, min_eq_right hd.2]
      have h_pt : (⟨clamp01 d, h_clamp_mem d⟩ : I01) = x_d := Subtype.ext hc
      dsimp [g_Y, δ_unif]
      rw [h_pt, ← Real.dist_eq]
      have hF_app : (F (φ n)) x_d = g_seq (φ n) d :=
        BoundedContinuousFunction.mkOfCompact_apply _ x_d
      rw [← hF_app]
      exact BoundedContinuousFunction.dist_coe_le_dist x_d
    have hgY_0 : g_Y 0 = 0 := by
      have h0_mem : (0 : ℝ) ∈ I01 := ⟨le_rfl, zero_le_one⟩
      have h_abs_le : |g_Y 0| ≤ 0 := by
        have h_lim0 : Filter.Tendsto (fun n => |g_Y 0| - δ_unif n)
            Filter.atTop (nhds (|g_Y 0| - 0)) :=
          tendsto_const_nhds.sub hδ_lim
        rw [sub_zero] at h_lim0
        refine le_of_tendsto' h_lim0 fun n => ?_
        have hu := h_unif_I01 n 0 h0_mem
        rw [hg_zero (φ n), zero_sub, abs_neg] at hu
        linarith
      exact abs_nonpos_iff.mp h_abs_le
    have hgY_1 : g_Y 1 ≤ q_cap := by
      have h1_mem : (1 : ℝ) ∈ I01 := ⟨zero_le_one, le_rfl⟩
      have hκ_sub : Filter.Tendsto (fun n => κ_err (φ n)) Filter.atTop (nhds 0) :=
        hκ_lim.comp hφ_mono.tendsto_atTop
      have h_lim1 : Filter.Tendsto (fun n => g_Y 1 - (κ_err (φ n) + δ_unif n))
          Filter.atTop (nhds (g_Y 1 - (0 + 0))) :=
        tendsto_const_nhds.sub (hκ_sub.add hδ_lim)
      rw [add_zero, sub_zero] at h_lim1
      refine le_of_tendsto' h_lim1 fun n => ?_
      have hu := (abs_le.mp (h_unif_I01 n 1 h1_mem)).1
      have hc := hg_cap (φ n)
      linarith
    have hgY_lip_I01 : ∀ x₁ x₂ : ℝ, x₁ ∈ I01 → x₂ ∈ I01 → x₁ ≤ x₂ →
        0 ≤ g_Y x₂ - g_Y x₁ ∧ g_Y x₂ - g_Y x₁ ≤ x₂ - x₁ := by
      intro x₁ x₂ hx₁ hx₂ hx₁₂
      have h_lim_lo : Filter.Tendsto (fun n => -(g_Y x₂ - g_Y x₁) - 2 * δ_unif n)
          Filter.atTop (nhds (-(g_Y x₂ - g_Y x₁) - 2 * 0)) :=
        tendsto_const_nhds.sub (tendsto_const_nhds.mul hδ_lim)
      rw [mul_zero, sub_zero] at h_lim_lo
      have h_lim_hi : Filter.Tendsto (fun n => (g_Y x₂ - g_Y x₁) - 2 * δ_unif n)
          Filter.atTop (nhds ((g_Y x₂ - g_Y x₁) - 2 * 0)) :=
        tendsto_const_nhds.sub (tendsto_const_nhds.mul hδ_lim)
      rw [mul_zero, sub_zero] at h_lim_hi
      refine ⟨?_, ?_⟩
      · have h_neg : -(g_Y x₂ - g_Y x₁) ≤ 0 := by
          refine le_of_tendsto' h_lim_lo fun n => ?_
          have hu1 := abs_le.mp (h_unif_I01 n x₁ hx₁)
          have hu2 := abs_le.mp (h_unif_I01 n x₂ hx₂)
          have hl := (hg_lip (φ n) x₁ x₂ hx₁₂).1
          linarith
        linarith
      · refine le_of_tendsto' h_lim_hi fun n => ?_
        have hu1 := abs_le.mp (h_unif_I01 n x₁ hx₁)
        have hu2 := abs_le.mp (h_unif_I01 n x₂ hx₂)
        have hl := (hg_lip (φ n) x₁ x₂ hx₁₂).2
        linarith
    have hgY_lip_all : ∀ d₁ d₂ : ℝ, d₁ ≤ d₂ →
        0 ≤ g_Y d₂ - g_Y d₁ ∧ g_Y d₂ - g_Y d₁ ≤ d₂ - d₁ := by
      intro d₁ d₂ hd₁₂
      have h_max_lip : max 0 d₁ ≤ max 0 d₂ ∧ max 0 d₂ - max 0 d₁ ≤ d₂ - d₁ := by
        refine ⟨max_le_max le_rfl hd₁₂, ?_⟩
        by_cases h1 : 0 ≤ d₁
        · have h2 : 0 ≤ d₂ := le_trans h1 hd₁₂
          rw [max_eq_right h1, max_eq_right h2]
        · rw [max_eq_left (le_of_not_ge h1)]
          by_cases h2 : 0 ≤ d₂
          · rw [max_eq_right h2]; linarith
          · rw [max_eq_left (le_of_not_ge h2)]; linarith
      have hc_mono : clamp01 d₁ ≤ clamp01 d₂ ∧ clamp01 d₂ - clamp01 d₁ ≤ d₂ - d₁ := by
        dsimp [clamp01]
        refine ⟨min_le_min le_rfl h_max_lip.1, ?_⟩
        let a₁ := max 0 d₁
        let a₂ := max 0 d₂
        change min 1 a₂ - min 1 a₁ ≤ d₂ - d₁
        have ha₁₂ : a₁ ≤ a₂ := h_max_lip.1
        have ha_diff : a₂ - a₁ ≤ d₂ - d₁ := h_max_lip.2
        by_cases hb2 : 1 ≤ a₂
        · rw [min_eq_left hb2]
          by_cases hb1 : 1 ≤ a₁
          · rw [min_eq_left hb1]; linarith
          · rw [min_eq_right (le_of_not_ge hb1)]; linarith
        · have hb1 : a₁ ≤ 1 := le_trans ha₁₂ (le_of_not_ge hb2)
          rw [min_eq_right (le_of_not_ge hb2), min_eq_right hb1]
          exact ha_diff
      have hc_id : ∀ d : ℝ, g_Y (clamp01 d) = g_Y d := by
        intro d
        have hm := h_clamp_mem d
        have hcc : clamp01 (clamp01 d) = clamp01 d := by
          dsimp [clamp01]
          rw [max_eq_right hm.1, min_eq_right hm.2]
        dsimp [g_Y]
        congr 1
        exact Subtype.ext hcc
      obtain ⟨hl1, hl2⟩ := hgY_lip_I01 (clamp01 d₁) (clamp01 d₂)
        (h_clamp_mem d₁) (h_clamp_mem d₂) hc_mono.1
      rw [hc_id d₁, hc_id d₂] at hl1 hl2
      exact ⟨hl1, le_trans hl2 hc_mono.2⟩
    exact ⟨g_Y, φ, δ_unif, hφ_mono, hgY_0, hgY_lip_all, hgY_1, hδ_nn, hδ_lim, h_unif_I01⟩

  
  have h_param_child_stage : ∀ {N_Θ : ℕ} (ρ κ j a δ_err : ℝ) (M : ℕ),
      0 < ρ ∧ ρ < 1 / 2 → 2 ≤ M → 0 ≤ κ →
      0 < j → 0 < a → j + a < 1 → 0 < δ_err →
      (1 : ℝ) / (M : ℝ) < min (j / 4) (min ((1 - (j + a)) / 4) (δ_err / 12)) / 2 →
      2 * κ + Real.log 9 / Real.log (ρ⁻¹) ≤ δ_err / 4 →
      ∀ (lam : Fin N_Θ → ℝ) (θ : Fin N_Θ → ℝ × ℝ),
        (∀ b, 0 ≤ lam b) →
        (∀ (r₁ r₂ : ℕ), 1 ≤ r₁ → r₁ < r₂ → r₂ ≤ M → ∀ q₁ q₂ : ℤ × ℤ,
          letI := Classical.propDecidable
          let d₁ := (r₁ : ℝ) / (M : ℝ)
          let d₂ := (r₂ : ℝ) / (M : ℝ)
          (∑ b : Fin N_Θ,
            if paramTreeBin ρ d₁ (θ b) = q₁ ∧ paramTreeBin ρ d₂ (θ b) = q₂
            then lam b else 0) ≤
          ρ ^ (s * (d₂ - d₁) - κ) *
            (∑ b : Fin N_Θ, if paramTreeBin ρ d₁ (θ b) = q₁ then lam b else 0)) →
        (∀ (r₁ r₂ : ℕ), 1 ≤ r₁ → r₁ < r₂ → r₂ ≤ M → ∀ b₁ : Fin N_Θ,
          0 < lam b₁ →
            letI := Classical.propDecidable
            let d₁ := (r₁ : ℝ) / (M : ℝ)
            let d₂ := (r₂ : ℝ) / (M : ℝ)
            let q₁ := paramTreeBin ρ d₁ (θ b₁)
            let q₂ := paramTreeBin ρ d₂ (θ b₁)
            ρ ^ (2 * (d₂ - d₁) + κ) *
              (∑ b : Fin N_Θ, if paramTreeBin ρ d₁ (θ b) = q₁ then lam b else 0) ≤
            (∑ b : Fin N_Θ,
              if paramTreeBin ρ d₁ (θ b) = q₁ ∧ paramTreeBin ρ d₂ (θ b) = q₂
              then lam b else 0)) →
        ∀ (b₀ : Fin N_Θ),
          (letI := Classical.propDecidable
           0 < ∑ b : Fin N_Θ,
             if paramTreeBin ρ j (θ b) = paramTreeBin ρ j (θ b₀) then lam b else 0) →
          ∀ (z₀ : EuclideanSpace ℝ (Fin 2)) (r : ℝ), ρ ^ a ≤ r → r ≤ 1 →
            letI := Classical.propDecidable
            let p_par := paramTreeBin ρ j (θ b₀)
            let a_mid := paramTreeMid ρ j (θ b₀)
            let m_par := ∑ b : Fin N_Θ, if paramTreeBin ρ j (θ b) = p_par then lam b else 0
            (∑ b : Fin N_Θ,
              if paramTreeBin ρ j (θ b) = p_par ∧
                ‖ρ ^ (-j) • (WithLp.toLp 2 ![(θ b).1, (θ b).2] - a_mid) - z₀‖ < r
              then lam b / m_par else 0) ≤
              ρ ^ (-δ_err) * r ^ s := by
    intro N_Θ ρ κ j a δ_err M hρ hM hκ hj ha hja hδ_err hM_fine hκ_small
      lam θ hlam_nn h_param_mesh h_param_cap_floor b₀ hm_par z₀ r hr_lo hr_hi
    dsimp only
    have hρ0 : 0 < ρ := hρ.1
    have hρ1 : ρ < 1 := by linarith [hρ.2]
    let L : ℝ := Real.log (ρ⁻¹)
    have hlog2_pos : 0 < Real.log 2 := Real.log_pos (by norm_num)
    have hL_pos : 0 < L := h_log_inv_pos ρ hρ
    have hM_pos : 0 < (M : ℝ) := by exact_mod_cast (lt_of_lt_of_le Nat.zero_lt_two hM)
    have hlog_ρ : Real.log ρ = -L := by dsimp [L]; rw [Real.log_inv, neg_neg]
    have hr_pos : 0 < r := lt_of_lt_of_le (Real.rpow_pos_of_pos hρ0 a) hr_lo
    let τ : ℝ := Real.log (r⁻¹) / L
    have hτ_nn : 0 ≤ τ := div_nonneg (Real.log_nonneg ((one_le_inv₀ hr_pos).mpr hr_hi)) hL_pos.le
    have hτ_le_a : τ ≤ a := by
      dsimp [τ]
      rw [div_le_iff₀ hL_pos]
      have hr_inv_le : r⁻¹ ≤ (ρ ^ a)⁻¹ := inv_anti₀ (Real.rpow_pos_of_pos hρ0 a) hr_lo
      have hlog_le := Real.log_le_log (inv_pos.mpr hr_pos) hr_inv_le
      rw [Real.log_inv (ρ ^ a), Real.log_rpow hρ0, hlog_ρ] at hlog_le
      linarith
    have hρ_τ : ρ ^ τ = r := by
      rw [Real.rpow_def_of_pos hρ0, hlog_ρ]
      have h_simp : -L * (Real.log (r⁻¹) / L) = Real.log r := by
        rw [Real.log_inv]
        field_simp [hL_pos.ne']
      rw [h_simp, Real.exp_log hr_pos]
    have h_rhs_eq : ρ ^ (-δ_err) * r ^ s = ρ ^ (s * τ - δ_err) := by
      rw [← hρ_τ, ← Real.rpow_mul hρ0.le, mul_comm τ s, ← Real.rpow_add hρ0]
      ring_nf
    have h_coarsen_1d : ∀ (d₁ d₂ x : ℝ), d₁ ≤ d₂ →
        let k := (dyadicRealLevel ρ d₂ - dyadicRealLevel ρ d₁).toNat
        dyadicRealBin ρ d₁ x = (dyadicRealBin ρ d₂ x) / ((2 ^ k : ℕ) : ℤ) := by
      intro d₁ d₂ x hd₁₂
      have h_scale_pos : 0 < L / Real.log 2 := div_pos hL_pos hlog2_pos
      have hm_le : dyadicRealLevel ρ d₁ ≤ dyadicRealLevel ρ d₂ :=
        Int.floor_mono (mul_le_mul_of_nonneg_right hd₁₂ h_scale_pos.le)
      let k : ℕ := (dyadicRealLevel ρ d₂ - dyadicRealLevel ρ d₁).toNat
      have hk_eq : dyadicRealLevel ρ d₂ = dyadicRealLevel ρ d₁ + (k : ℤ) := by
        have h1 : (k : ℤ) = dyadicRealLevel ρ d₂ - dyadicRealLevel ρ d₁ :=
          Int.toNat_of_nonneg (sub_nonneg.mpr hm_le)
        omega
      have h_pow_split : (2 : ℝ) ^ (dyadicRealLevel ρ d₂) =
          (2 : ℝ) ^ (dyadicRealLevel ρ d₁) * ((2 ^ k : ℕ) : ℝ) := by
        rw [hk_eq, zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0), zpow_natCast, Nat.cast_pow, Nat.cast_ofNat]
      have h2k_ne : ((2 ^ k : ℕ) : ℝ) ≠ 0 := by positivity
      have hx_div : x * (2 : ℝ) ^ (dyadicRealLevel ρ d₁) =
          (x * (2 : ℝ) ^ (dyadicRealLevel ρ d₂)) / ((2 ^ k : ℕ) : ℝ) := by
        rw [h_pow_split, mul_div_assoc, mul_div_cancel_right₀ _ h2k_ne]
      change ⌊x * (2 : ℝ) ^ (dyadicRealLevel ρ d₁)⌋ =
        ⌊x * (2 : ℝ) ^ (dyadicRealLevel ρ d₂)⌋ / ((2 ^ k : ℕ) : ℤ)
      rw [hx_div, Int.floor_div_natCast]
    have h_coarsen_2d : ∀ (d₁ d₂ : ℝ) (θ₁ θ₂ : ℝ × ℝ), d₁ ≤ d₂ →
        paramTreeBin ρ d₂ θ₁ = paramTreeBin ρ d₂ θ₂ →
        paramTreeBin ρ d₁ θ₁ = paramTreeBin ρ d₁ θ₂ := by
      intro d₁ d₂ θ₁ θ₂ hd₁₂ h_eq
      obtain ⟨h1, h2⟩ := Prod.ext_iff.mp h_eq
      dsimp [paramTreeBin] at h1 h2 ⊢
      refine Prod.ext ?_ ?_
      · rw [h_coarsen_1d d₁ d₂ θ₁.1 hd₁₂, h_coarsen_1d d₁ d₂ θ₂.1 hd₁₂, h1]
      · rw [h_coarsen_1d d₁ d₂ θ₁.2 hd₁₂, h_coarsen_1d d₁ d₂ θ₂.2 hd₁₂, h2]
    let p_par := paramTreeBin ρ j (θ b₀)
    let a_mid := paramTreeMid ρ j (θ b₀)
    let m_par := ∑ b : Fin N_Θ,
      @ite ℝ (paramTreeBin ρ j (θ b) = p_par) (Classical.propDecidable _) (lam b) 0
    have hm_par_pos : 0 < m_par := hm_par
    let δ_mesh : ℝ := min (j / 4) (min ((1 - (j + a)) / 4) (δ_err / 12))
    have hδm_le_j : δ_mesh ≤ j / 4 := min_le_left _ _
