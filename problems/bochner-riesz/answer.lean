    dyadicRealBin ε (m * u' + (((j.1 + 1 : ℕ) : ℝ) / (M : ℝ)) * h') (sys.R_seq k ω')

  have h_ico_stg2 : ∀ j : Fin M,
      ∃ (N_j : ℕ) (lo_j : ℤ × ℤ × ℤ × ℤ × ℤ × ℤ → ℤ),
