              Complex.exp (Complex.I * ((lam_sys * Φ₀ (C_t, X_o, v) : ℝ) : ℂ))) =
          (((ρ_r / ρ_t) : ℝ) : ℂ) * ∫ z : EuclideanSpace ℝ (Fin 2), G_z z := by
        have h_pt : ∀ v : EuclideanSpace ℝ (Fin 2),
            g_at v * ψ_o (ρ_t⁻¹ • (v - V_o)) *
              Complex.exp (Complex.I * ((lam_sys * Φ₀ (C_t, X_o, v) : ℝ) : ℂ)) =
            (ρ_r⁻¹ : ℂ) *
              ((star (ψ_at (ρ_r⁻¹ • (v - V_at))) * ψ_o (ρ_t⁻¹ • (v - V_o))) *
                Complex.exp (Complex.I *
                  ((lam_sys * (Φ₀ (C_t, X_o, v) - Φ₀ (C_r, X_at, v)) : ℝ) : ℂ))) := by
          intro v
          dsimp only [g_at]
          have h_exp : Complex.exp (-(Complex.I * ((lam_sys * Φ₀ (C_r, X_at, v) : ℝ) : ℂ))) *
                Complex.exp (Complex.I * ((lam_sys * Φ₀ (C_t, X_o, v) : ℝ) : ℂ)) =
              Complex.exp (Complex.I *
                ((lam_sys * (Φ₀ (C_t, X_o, v) - Φ₀ (C_r, X_at, v)) : ℝ) : ℂ)) := by
            rw [← Complex.exp_add]
            congr 1
            push_cast
            ring
          calc ((ρ_r⁻¹ : ℂ) * star (ψ_at (ρ_r⁻¹ • (v - V_at))) *
                  Complex.exp (-(Complex.I * ((lam_sys * Φ₀ (C_r, X_at, v) : ℝ) : ℂ)))) *
                ψ_o (ρ_t⁻¹ • (v - V_o)) *
                Complex.exp (Complex.I * ((lam_sys * Φ₀ (C_t, X_o, v) : ℝ) : ℂ))
              = (ρ_r⁻¹ : ℂ) *
                  ((star (ψ_at (ρ_r⁻¹ • (v - V_at))) * ψ_o (ρ_t⁻¹ • (v - V_o))) *
                    (Complex.exp (-(Complex.I * ((lam_sys * Φ₀ (C_r, X_at, v) : ℝ) : ℂ))) *
                      Complex.exp (Complex.I * ((lam_sys * Φ₀ (C_t, X_o, v) : ℝ) : ℂ)))) := by
                ring
            _ = _ := by rw [h_exp]
        simp_rw [h_pt]
        rw [MeasureTheory.integral_const_mul]
        rw [← MeasureTheory.integral_add_right_eq_self
          (fun v : EuclideanSpace ℝ (Fin 2) =>
            (star (ψ_at (ρ_r⁻¹ • (v - V_at))) * ψ_o (ρ_t⁻¹ • (v - V_o))) *
              Complex.exp (Complex.I *
                ((lam_sys * (Φ₀ (C_t, X_o, v) - Φ₀ (C_r, X_at, v)) : ℝ) : ℂ))) V_at]
        have h_shift : ∀ u : EuclideanSpace ℝ (Fin 2),
