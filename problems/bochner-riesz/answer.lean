        rw [hR₀₁_sum_p] at h_split
        have h_bad : (∑ p ∈ (Finset.univ : Finset (Fin N_Θ × Fin N_Θ)).filter
            (fun p => ¬((1 / 8 : ℝ) * lam p.1 ≤ R₀ p.1 ∧
              (1 / 8 : ℝ) * (lam p.1 * lam p.2) ≤ R₀₁ p.1 p.2)), R₀₁ p.1 p.2) ≤ 1 / 4 := by
          rw [Finset.sum_filter]
          have h_pt : ∀ p : Fin N_Θ × Fin N_Θ,
