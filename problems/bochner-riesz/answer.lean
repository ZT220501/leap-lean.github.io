      rw [hΦ_grad c_end hc_end (x_line y) (v_seg τ) δ] at h_comp
      have h_mul := (h_comp.const_mul lam_loc).const_mul ε_sgn
      simpa [F, G, p_seg, mul_assoc] using h_mul
    let M : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) →
