    obtain ⟨k_m, ⟨hk_m_ge, hk_m_rad⟩, hk_m_int⟩ := ((ev_k1.and ev_k2).and ev_k3).exists
    
    let G_tot : (ℝ × ℝ) → ((Fin n → ℝ) × ℝ) → ℝ := fun iu ξ =>
