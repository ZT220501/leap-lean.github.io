        ⟨h_surp_nn ε π T_idx (obs i) hε₀ hε₁ hπ_nn ω hω_pos, not_lt.mp h_not_c⟩⟩
    let coords : ∀ ω : Fin N_ω, ω ∈ S_mid → (i : Fin M_obs) → Fin (N_grid i) × Fin (N_grid i) :=
      fun ω hω i =>
        let bds := hS_mid_bds ω hω i
        (⟨⌊condSurprise ε π (fun _ => ()) (obs i) ω / a⌋₊,
            (h_floor_idx i _ bds.1.1 bds.1.2).1⟩,
         ⟨⌊condSurprise ε π T_idx (obs i) ω / a⌋₊,
            (h_floor_idx i _ bds.2.1 bds.2.2).1⟩)
    let Z : Fin N_ω → Fin (J_max + 1) := fun ω =>
      if hω : ω ∈ S_mid then (equivBins (coords ω hω)).castSucc else Fin.last J_max
    let d_uncond : Fin J_max → Fin M_obs → ℝ := fun z i =>
      min ((((equivBins.symm z) i).1.1 : ℝ) * a) (A_cap i + 1)
    let d_condT : Fin J_max → Fin M_obs → ℝ := fun z i =>
      min ((((equivBins.symm z) i).2.1 : ℝ) * a) (A_cap i + 1)
    let m_bin : Fin J_max → ℝ := fun z =>
      ∑ ω : Fin N_ω, @ite ℝ (Z ω = z.castSucc) (Classical.propDecidable _) (π ω) 0
    let Z_ret : Finset (Fin J_max) :=
      @Finset.filter (Fin J_max) (fun z => (4 * (J_max : ℝ))⁻¹ ≤ m_bin z)
        (fun _ => Classical.propDecidable _) Finset.univ
    have hd_bds : ∀ z i, d_uncond z i ∈ Set.Icc (0 : ℝ) (A_cap i + 1) ∧
        d_condT z i ∈ Set.Icc (0 : ℝ) (A_cap i + 1) := by
      intro z i
      have hA_nn : 0 ≤ A_cap i + 1 := by linarith [(hA i).1]
      exact ⟨⟨le_min (mul_nonneg (Nat.cast_nonneg _) ha.le) hA_nn, min_le_right _ _⟩,
        ⟨le_min (mul_nonneg (Nat.cast_nonneg _) ha.le) hA_nn, min_le_right _ _⟩⟩
    have hm_bin_sum : ∑ z : Fin J_max, m_bin z = ∑ ω ∈ S_mid, π ω := by
      dsimp only [m_bin]
      rw [Finset.sum_comm]
      calc ∑ ω : Fin N_ω, ∑ z : Fin J_max,
            @ite ℝ (Z ω = z.castSucc) (Classical.propDecidable _) (π ω) 0
          = ∑ ω : Fin N_ω, (if ω ∈ S_mid then π ω else 0) := by
              refine Finset.sum_congr rfl (fun ω _ => ?_)
              by_cases hω : ω ∈ S_mid
              · rw [if_pos hω]
                have hZ : Z ω = (equivBins (coords ω hω)).castSucc := dif_pos hω
                have h_inner : (∑ z : Fin J_max,
                    @ite ℝ (Z ω = z.castSucc) (Classical.propDecidable _) (π ω) 0) =
                    ∑ z : Fin J_max, if equivBins (coords ω hω) = z then π ω else 0 := by
                  refine Finset.sum_congr rfl (fun z _ => ?_)
                  by_cases hz_eq : equivBins (coords ω hω) = z
                  · have hZ_eq : Z ω = z.castSucc := by rw [hZ, hz_eq]
                    simp [hz_eq, hZ_eq]
                  · have hZ_ne : Z ω ≠ z.castSucc := by
                      rw [hZ]
                      exact fun h => hz_eq (Fin.castSucc_inj.mp h)
                    simp [hz_eq, hZ_ne]
                rw [h_inner, Finset.sum_ite_eq Finset.univ (equivBins (coords ω hω)) (fun _ => π ω),
                  if_pos (Finset.mem_univ _)]
              · rw [if_neg hω]
                have hZ : Z ω = Fin.last J_max := dif_neg hω
                refine Finset.sum_eq_zero (fun z _ => ?_)
                have hne : Z ω ≠ z.castSucc := by
                  rw [hZ]
                  exact (Fin.castSucc_ne_last z).symm
                simp [hne]
        _ = ∑ ω ∈ S_mid, π ω := by
              rw [← Finset.sum_filter]
              congr 1
              ext ω
              simp
    have h_ret_mass : 1 - 2 * (M_obs : ℝ) * ε - 1 / 4 ≤ ∑ z ∈ Z_ret, m_bin z := by
      have h_part := Finset.sum_sdiff (Finset.subset_univ Z_ret) (f := m_bin)
      have h_disc : ∑ z ∈ Finset.univ \ Z_ret, m_bin z ≤ 1 / 4 := by
        have h_each : ∀ z ∈ Finset.univ \ Z_ret, m_bin z ≤ (4 * (J_max : ℝ))⁻¹ := by
          intro z hz
          have hz_not : z ∉ Z_ret := (Finset.mem_sdiff.mp hz).2
          have h_not_le : ¬ (4 * (J_max : ℝ))⁻¹ ≤ m_bin z := fun hle =>
            hz_not (Finset.mem_filter.mpr ⟨Finset.mem_univ z, hle⟩)
          exact (not_le.mp h_not_le).le
        have h_card : (((Finset.univ \ Z_ret).card : ℝ)) ≤ (J_max : ℝ) := by
          have h_nat : (Finset.univ \ Z_ret).card ≤ J_max := by
            calc (Finset.univ \ Z_ret).card
                ≤ (Finset.univ : Finset (Fin J_max)).card :=
                  Finset.card_le_card (Finset.subset_univ _)
              _ = J_max := by simp
          exact_mod_cast h_nat
        calc ∑ z ∈ Finset.univ \ Z_ret, m_bin z
            ≤ ∑ _z ∈ Finset.univ \ Z_ret, (4 * (J_max : ℝ))⁻¹ := Finset.sum_le_sum h_each
          _ = ((Finset.univ \ Z_ret).card : ℝ) * (4 * (J_max : ℝ))⁻¹ := by
                simp [Finset.sum_const, nsmul_eq_mul]
          _ ≤ (J_max : ℝ) * (4 * (J_max : ℝ))⁻¹ :=
                mul_le_mul_of_nonneg_right h_card (by positivity)
          _ = 1 / 4 := by field_simp [hJ_pos.ne']
      linarith [hS_mid_mass, hm_bin_sum, h_part, h_disc]
    have h_binned_pair : ∀ (E : Finset (Fin N_ω)) {γ : Type} [DecidableEq γ]
        (X : Fin N_ω → γ) (Y : Fin N_ω → β) (d : ℝ),
        (∀ ω ∈ E, 0 < π ω) →
        (4 * (J_max : ℝ))⁻¹ ≤ (∑ ω ∈ E, π ω) →
        (∀ ω ∈ E, d ≤ condSurprise ε π X Y ω ∧ condSurprise ε π X Y ω ≤ d + a) →
        let π_E := restrictLaw π E
        (d - Real.log (4 * (J_max : ℝ)) / ell ≤ finCondEntropy ε π_E X Y ∧
         finCondEntropy ε π_E X Y ≤ d + a) ∧
        (∀ η : ℝ, 0 < η → η < 1 →
          ∃ B : Finset (Fin N_ω),
            (∑ ω ∈ B, π_E ω) ≤ 2 * η ∧
            ∀ ω : Fin N_ω, 0 < π_E ω → ω ∉ B →
              d - Real.log (4 * (J_max : ℝ) / η) / ell ≤ condSurprise ε π_E X Y ω ∧
              condSurprise ε π_E X Y ω ≤ d + a + Real.log (1 / η) / ell) := by
      intro E γ _instγ X Y d hE_pos hm_lb h_win
      let K : ℝ := 4 * (J_max : ℝ)
      have hK_pos : 0 < K := by positivity
      let m_E : ℝ := ∑ ω ∈ E, π ω
      have hmE_pos : 0 < m_E := lt_of_lt_of_le (inv_pos.mpr hK_pos) hm_lb
      have hm_inv_le : m_E⁻¹ ≤ K := by
        have h1 := inv_anti₀ (inv_pos.mpr hK_pos) hm_lb
        simpa [K] using h1
      let π_E := restrictLaw π E
      obtain ⟨hπE_nn, hπE_sumE, _, hπE_zero, hπE_iff⟩ :=
        h_restrict_props π E hπ_nn hE_pos hmE_pos
      have hE_sub : E ⊆ S_pos := fun ω hω => (h_mem_posSupp π ω).mpr (hE_pos ω hω)
      obtain ⟨hp1, hp2, hpX_nn, hpXY_nn, hp_le⟩ := h_w_prob π S_pos X Y hπ_nn hπ_zero
      obtain ⟨hq1, hq2, hqX_nn, hqXY_nn, hq_le⟩ := h_w_prob π_E E X Y hπE_nn hπE_zero
      let X_pos := S_pos.image X
      let Y_pos := S_pos.image Y
      let E_X := E.image X
      let Y_E : γ → Finset β := fun x => (E.filter (fun ω => X ω = x)).image Y
      have hEX_sub : E_X ⊆ X_pos := Finset.image_subset_image hE_sub
      have hYE_sub : ∀ x : γ, Y_E x ⊆ Y_pos := fun x =>
        Finset.image_subset_image ((Finset.filter_subset _ E).trans hE_sub)
      have h_qXY_le : ∀ x y, wXY π_E E X Y x y ≤ K * wXY π S_pos X Y x y := by
        intro x y
        have h_eq : wXY π_E E X Y x y =
            m_E⁻¹ * ∑ ω ∈ E,
              @ite ℝ (X ω = x ∧ Y ω = y) (Classical.propDecidable _) (π ω) 0 := by
          dsimp only [wXY, π_E, restrictLaw]
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl (fun ω hω => ?_)
          rw [if_pos hω]
          split_ifs <;> ring
        have h_sub : ∑ ω ∈ E,
            @ite ℝ (X ω = x ∧ Y ω = y) (Classical.propDecidable _) (π ω) 0 ≤
            wXY π S_pos X Y x y := by
          dsimp only [wXY]
          exact Finset.sum_le_sum_of_subset_of_nonneg hE_sub (fun ω _ _ => by
            split_ifs <;> [exact hπ_nn ω; exact le_rfl])
        rw [h_eq]
        exact le_trans (mul_le_mul_of_nonneg_left h_sub (inv_nonneg.mpr hmE_pos.le))
          (mul_le_mul_of_nonneg_right hm_inv_le (hpXY_nn x y))
      have h_win_prob : ∀ ω ∈ E,
          ε ^ (d + a) * wX π S_pos X (X ω) ≤ wXY π S_pos X Y (X ω) (Y ω) ∧
          wXY π S_pos X Y (X ω) (Y ω) ≤ ε ^ d * wX π S_pos X (X ω) := by
        intro ω hω
        have hωS : ω ∈ S_pos := hE_sub hω
        have hpXY_pos : 0 < wXY π S_pos X Y (X ω) (Y ω) :=
          lt_of_lt_of_le (hE_pos ω hω) (hp_le ω hωS).1
        have hpX_pos : 0 < wX π S_pos X (X ω) := lt_of_lt_of_le hpXY_pos (hp_le ω hωS).2
        obtain ⟨hlo, hhi⟩ := h_win ω hω
        unfold condSurprise at hlo hhi
        rw [hp1 ω, hp2 ω, le_div_iff₀ hℓ_pos] at hlo
        rw [hp1 ω, hp2 ω, div_le_iff₀ hℓ_pos] at hhi
        have h_log_hi : Real.log (wXY π S_pos X Y (X ω) (Y ω) / wX π S_pos X (X ω)) ≤
            Real.log (ε ^ d) := by
          rw [h_log_rpow hε₀ d]
          linarith
        have h_log_lo : Real.log (ε ^ (d + a)) ≤
            Real.log (wXY π S_pos X Y (X ω) (Y ω) / wX π S_pos X (X ω)) := by
          rw [h_log_rpow hε₀ (d + a)]
          linarith
        have hr_hi := (Real.log_le_log_iff (div_pos hpXY_pos hpX_pos)
          (Real.rpow_pos_of_pos hε₀ d)).mp h_log_hi
        have hr_lo := (Real.log_le_log_iff (Real.rpow_pos_of_pos hε₀ (d + a))
          (div_pos hpXY_pos hpX_pos)).mp h_log_lo
        exact ⟨(le_div_iff₀ hpX_pos).mp hr_lo, (div_le_iff₀ hpX_pos).mp hr_hi⟩
      have h_YE_card : ∀ x ∈ E_X, ((Y_E x).card : ℝ) * ε ^ (d + a) ≤ 1 := by
        intro x hx
        obtain ⟨ω₀, hω₀, rfl⟩ := Finset.mem_image.mp hx
        have hpX_pos : 0 < wX π S_pos X (X ω₀) :=
          lt_of_lt_of_le (lt_of_lt_of_le (hE_pos ω₀ hω₀) (hp_le ω₀ (hE_sub hω₀)).1)
            (hp_le ω₀ (hE_sub hω₀)).2
        have h_mul_pX : (((Y_E (X ω₀)).card : ℝ) * ε ^ (d + a)) * wX π S_pos X (X ω₀) ≤
            1 * wX π S_pos X (X ω₀) := by
          calc (((Y_E (X ω₀)).card : ℝ) * ε ^ (d + a)) * wX π S_pos X (X ω₀)
              = ∑ _y ∈ Y_E (X ω₀), (ε ^ (d + a) * wX π S_pos X (X ω₀)) := by
                  simp [Finset.sum_const, nsmul_eq_mul, mul_assoc]
            _ ≤ ∑ y ∈ Y_E (X ω₀), wXY π S_pos X Y (X ω₀) y := by
                  refine Finset.sum_le_sum (fun y hy => ?_)
                  obtain ⟨ω_y, hω_y_f, rfl⟩ := Finset.mem_image.mp hy
                  obtain ⟨hω_yE, hX_eq⟩ := Finset.mem_filter.mp hω_y_f
                  have hw := (h_win_prob ω_y hω_yE).1
                  rwa [hX_eq] at hw
            _ ≤ ∑ y ∈ Y_pos, wXY π S_pos X Y (X ω₀) y :=
                  Finset.sum_le_sum_of_subset_of_nonneg (hYE_sub (X ω₀))
                    (fun y _ _ => hpXY_nn (X ω₀) y)
            _ = 1 * wX π S_pos X (X ω₀) := by
                  rw [one_mul]
                  exact h_marg_Y π S_pos X Y Y_pos (X ω₀)
                    (fun ω hω => Finset.mem_image_of_mem Y hω)
        exact le_of_mul_le_mul_right h_mul_pX hpX_pos
      have h_pX_tot : ∑ x ∈ X_pos, wX π S_pos X x = 1 := by
        have h1 := h_group1 π S_pos X X_pos (fun _ => 1) (fun ω hω => Finset.mem_image_of_mem X hω)
        simpa [hS_pos_sum] using h1
      have h_qX_tot : ∑ x ∈ E_X, wX π_E E X x = 1 := by
        have h1 := h_group1 π_E E X E_X (fun _ => 1)
          (fun ω hω => Finset.mem_image_of_mem X hω)
        simp only [mul_one] at h1
        exact h1.trans hπE_sumE
      have h_mem_YE : ∀ ω ∈ E, X ω ∈ E_X ∧ Y ω ∈ Y_E (X ω) := fun ω hω =>
        ⟨Finset.mem_image_of_mem X hω,
          Finset.mem_image.mpr ⟨ω, Finset.mem_filter.mpr ⟨hω, rfl⟩, rfl⟩⟩
      have h_ent_E : finCondEntropy ε π_E X Y = ∑ ω ∈ E, π_E ω * condSurprise ε π_E X Y ω := by
        unfold finCondEntropy
        refine (Finset.sum_subset (Finset.subset_univ E) (fun ω _ hω => ?_)).symm
        rw [show π_E ω = 0 from hπE_zero ω hω, zero_mul]
      have h_ent_lb : d - Real.log K / ell ≤ finCondEntropy ε π_E X Y := by
        let rX : γ → ℝ := fun x => wX π S_pos X x / wX π_E E X x
        have h_pt_lb : ∀ ω ∈ E,
            π_E ω * (d - Real.log K / ell) - π_E ω * ((rX (X ω) - 1) / ell) ≤
              π_E ω * condSurprise ε π_E X Y ω := by
          intro ω hω
          have hω_pos : 0 < π_E ω := (hπE_iff ω).mpr hω
          have hqXY_pos : 0 < wXY π_E E X Y (X ω) (Y ω) := lt_of_lt_of_le hω_pos (hq_le ω hω).1
          have hqX_pos : 0 < wX π_E E X (X ω) := lt_of_lt_of_le hqXY_pos (hq_le ω hω).2
          have hpX_pos : 0 < wX π S_pos X (X ω) :=
            lt_of_lt_of_le (lt_of_lt_of_le (hE_pos ω hω) (hp_le ω (hE_sub hω)).1)
              (hp_le ω (hE_sub hω)).2
          have hrX_pos : 0 < rX (X ω) := div_pos hpX_pos hqX_pos
          have h_qXY_ub : wXY π_E E X Y (X ω) (Y ω) ≤
              (K * ε ^ d) * wX π S_pos X (X ω) := by
            calc wXY π_E E X Y (X ω) (Y ω)
                ≤ K * wXY π S_pos X Y (X ω) (Y ω) := h_qXY_le (X ω) (Y ω)
              _ ≤ K * (ε ^ d * wX π S_pos X (X ω)) :=
                  mul_le_mul_of_nonneg_left (h_win_prob ω hω).2 hK_pos.le
              _ = (K * ε ^ d) * wX π S_pos X (X ω) := (mul_assoc _ _ _).symm
          have h_rat_ub : wXY π_E E X Y (X ω) (Y ω) / wX π_E E X (X ω) ≤
              (K * ε ^ d) * rX (X ω) := by
            dsimp only [rX]
            rw [← mul_div_assoc]
            exact div_le_div_of_nonneg_right h_qXY_ub hqX_pos.le
          have hεd_pos : 0 < ε ^ d := Real.rpow_pos_of_pos hε₀ d
          have h_log_ub : Real.log (wXY π_E E X Y (X ω) (Y ω) / wX π_E E X (X ω)) ≤
              Real.log K - d * ell + (rX (X ω) - 1) := by
            have h1 := Real.log_le_log (div_pos hqXY_pos hqX_pos) h_rat_ub
            rw [Real.log_mul (mul_pos hK_pos hεd_pos).ne' hrX_pos.ne',
              Real.log_mul hK_pos.ne' hεd_pos.ne', h_log_rpow hε₀ d] at h1
            linarith [Real.log_le_sub_one_of_pos hrX_pos]
          have h_surp_lb : (d - Real.log K / ell) - (rX (X ω) - 1) / ell ≤
              condSurprise ε π_E X Y ω := by
            unfold condSurprise
            rw [hq1 ω, hq2 ω]
            change (d - Real.log K / ell) - (rX (X ω) - 1) / ell ≤
              -Real.log (wXY π_E E X Y (X ω) (Y ω) / wX π_E E X (X ω)) / ell
            have h_lhs : (d - Real.log K / ell) - (rX (X ω) - 1) / ell =
                (d * ell - Real.log K - (rX (X ω) - 1)) / ell := by
              field_simp [hℓ_pos.ne']
            rw [h_lhs, div_le_div_iff_of_pos_right hℓ_pos]
            linarith
          have h_mul := mul_le_mul_of_nonneg_left h_surp_lb hω_pos.le
          linarith [mul_sub (π_E ω) (d - Real.log K / ell) ((rX (X ω) - 1) / ell)]
        have h_sum_rX : ∑ ω ∈ E, π_E ω * rX (X ω) ≤ 1 := by
          rw [← h_group1 π_E E X E_X rX (fun ω hω => Finset.mem_image_of_mem X hω)]
          calc ∑ x ∈ E_X, wX π_E E X x * rX x
              ≤ ∑ x ∈ E_X, wX π S_pos X x := by
                refine Finset.sum_le_sum (fun x _ => ?_)
                dsimp only [rX]
                rw [mul_comm]
                exact h_div_mul_le _ _ (hpX_nn x)
            _ ≤ ∑ x ∈ X_pos, wX π S_pos X x :=
                Finset.sum_le_sum_of_subset_of_nonneg hEX_sub (fun x _ _ => hpX_nn x)
            _ = 1 := h_pX_tot
        have h_err_np : ∑ ω ∈ E, π_E ω * ((rX (X ω) - 1) / ell) ≤ 0 := by
          have h_eq : ∑ ω ∈ E, π_E ω * ((rX (X ω) - 1) / ell) =
              ((∑ ω ∈ E, π_E ω * rX (X ω)) - ∑ ω ∈ E, π_E ω) / ell := by
            rw [← Finset.sum_sub_distrib, Finset.sum_div]
            refine Finset.sum_congr rfl (fun ω _ => ?_)
            ring
          rw [h_eq, show ∑ ω ∈ E, π_E ω = 1 from hπE_sumE]
          exact div_nonpos_of_nonpos_of_nonneg (by linarith) hℓ_pos.le
        have h_const_sum : ∑ ω ∈ E, π_E ω * (d - Real.log K / ell) = d - Real.log K / ell := by
          rw [← Finset.sum_mul, show ∑ ω ∈ E, π_E ω = 1 from hπE_sumE, one_mul]
        rw [h_ent_E]
        have h_sum_le := Finset.sum_le_sum h_pt_lb
        rw [Finset.sum_sub_distrib, h_const_sum] at h_sum_le
        linarith
      have h_ent_ub : finCondEntropy ε π_E X Y ≤ d + a := by
        let u_fn : γ → β → ℝ := fun x y =>
          (ε ^ (d + a) * wX π_E E X x) / wXY π_E E X Y x y
        have h_pt_ub : ∀ ω ∈ E,
            π_E ω * condSurprise ε π_E X Y ω ≤
              π_E ω * (d + a) + π_E ω * ((u_fn (X ω) (Y ω) - 1) / ell) := by
          intro ω hω
          have hω_pos : 0 < π_E ω := (hπE_iff ω).mpr hω
          have hqXY_pos : 0 < wXY π_E E X Y (X ω) (Y ω) := lt_of_lt_of_le hω_pos (hq_le ω hω).1
          have hqX_pos : 0 < wX π_E E X (X ω) := lt_of_lt_of_le hqXY_pos (hq_le ω hω).2
          have hεda_pos : 0 < ε ^ (d + a) := Real.rpow_pos_of_pos hε₀ (d + a)
          have hu_pos : 0 < u_fn (X ω) (Y ω) := div_pos (mul_pos hεda_pos hqX_pos) hqXY_pos
          have h_prod : (wXY π_E E X Y (X ω) (Y ω) / wX π_E E X (X ω)) * u_fn (X ω) (Y ω) =
              ε ^ (d + a) := by
            dsimp only [u_fn]
            field_simp [hqX_pos.ne', hqXY_pos.ne']
          have h_log_eq : -(d + a) * ell =
              Real.log (wXY π_E E X Y (X ω) (Y ω) / wX π_E E X (X ω)) +
                Real.log (u_fn (X ω) (Y ω)) := by
            rw [← h_log_rpow hε₀ (d + a), ← h_prod]
            exact Real.log_mul (div_pos hqXY_pos hqX_pos).ne' hu_pos.ne'
          have h_surp_ub : condSurprise ε π_E X Y ω ≤
              (d + a) + (u_fn (X ω) (Y ω) - 1) / ell := by
            unfold condSurprise
            rw [hq1 ω, hq2 ω]
            change -Real.log (wXY π_E E X Y (X ω) (Y ω) / wX π_E E X (X ω)) / ell ≤
              (d + a) + (u_fn (X ω) (Y ω) - 1) / ell
            have h_rhs : (d + a) + (u_fn (X ω) (Y ω) - 1) / ell =
                ((d + a) * ell + (u_fn (X ω) (Y ω) - 1)) / ell := by
              field_simp [hℓ_pos.ne']
            rw [h_rhs, div_le_div_iff_of_pos_right hℓ_pos]
            linarith [h_log_eq, Real.log_le_sub_one_of_pos hu_pos]
          have h_mul := mul_le_mul_of_nonneg_left h_surp_ub hω_pos.le
          linarith [mul_add (π_E ω) (d + a) ((u_fn (X ω) (Y ω) - 1) / ell)]
