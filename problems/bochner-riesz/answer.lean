    have h_grid_mid : ∀ x : ℝ, |canonicalGridMid ρ x - x| ≤ (1 / 2) * ρ := by
      intro x
      unfold canonicalGridMid canonicalGridBin
      have h_lo : (⌊x / ρ⌋ : ℝ) ≤ x / ρ := Int.floor_le (x / ρ)
      have h_hi : x / ρ < (⌊x / ρ⌋ : ℝ) + 1 := Int.lt_floor_add_one (x / ρ)
      have h_scaled : |((⌊x / ρ⌋ : ℝ) + 1 / 2) - x / ρ| ≤ 1 / 2 :=
        abs_le.mpr ⟨by linarith, by linarith⟩
      have h_eq : ((⌊x / ρ⌋ : ℝ) + 1 / 2) * ρ - x =
