              iteratedDeriv_fun_mul (hΨ_sm (n + 1)).contDiffAt (hh_sm (n + 1)).contDiffAt
            have h_fn_eq : (fun s => Ψ s * h s) = u := funext h_prod
            rw [h_fn_eq, Finset.sum_range_succ'] at h_leib
            simp only [Nat.choose_zero_right, Nat.cast_one, one_mul, Nat.sub_zero, iteratedDeriv_zero] at h_leib
            have h_solve : Ψ t * iteratedDeriv (n + 1) h t =
                iteratedDeriv (n + 1) u t -
                  ∑ i ∈ Finset.range (n + 1),
                    (((n + 1).choose (i + 1) : ℕ) : ℂ) *
                      iteratedDeriv (i + 1) Ψ t * iteratedDeriv (n + 1 - (i + 1)) h t := by
              rw [h_leib]
