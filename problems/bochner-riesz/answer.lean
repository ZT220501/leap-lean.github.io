    exact (h_s3 (sys.ε_seq k) hε0 hε1).2.2.2 hQ_ge1 τ a₁ hτ_pos ha₁_pos
      (sys.π_seq k) (X₁ k) (Y₁ k) lo_fn N_fn hπ_nn hπ_sum
