    have hW₂_dom1 : ∀ a b₁ b₂, W₂ a b₁ b₂ ≤ K_prod * q a b₁ * q_B b₂ := by
      intro a b₁ b₂; dsimp [W₂]
      split_ifs with ha
      · rw [div_le_iff₀ ha]
        have hp2 := hq_prod a b₂
        calc q a b₁ * q a b₂ ≤ q a b₁ * (K_prod * q_A a * q_B b₂) :=
              mul_le_mul_of_nonneg_left hp2 (hq_nn a b₁)
          _ = K_prod * q a b₁ * q_B b₂ * q_A a := by ring
      · exact mul_nonneg (mul_nonneg hKprod.le (hq_nn a b₁)) (hqB_nn b₂)
    have hW₂_dom2 : ∀ a b₁ b₂, W₂ a b₁ b₂ ≤ K_prod ^ 2 * q_A a * q_B b₁ * q_B b₂ := by
      intro a b₁ b₂
      calc W₂ a b₁ b₂ ≤ K_prod * q a b₁ * q_B b₂ := hW₂_dom1 a b₁ b₂
        _ ≤ K_prod * (K_prod * q_A a * q_B b₁) * q_B b₂ :=
            mul_le_mul_of_nonneg_right
              (mul_le_mul_of_nonneg_left (hq_prod a b₁) hKprod.le) (hqB_nn b₂)
        _ = K_prod ^ 2 * q_A a * q_B b₁ * q_B b₂ := by ring
    have hW₂_pair_dom : ∀ b₁ b₂, (∑ a, W₂ a b₁ b₂) ≤ K_prod * K_B * q_B b₁ * μ_B b₂ := by
      intro b₁ b₂
      calc ∑ a, W₂ a b₁ b₂
          ≤ ∑ a, K_prod * q a b₁ * q_B b₂ := Finset.sum_le_sum (fun a _ => hW₂_dom1 a b₁ b₂)
        _ = K_prod * q_B b₂ * ∑ a, q a b₁ := by
            rw [Finset.mul_sum]; refine Finset.sum_congr rfl (fun _ _ => by ring)
        _ = K_prod * q_B b₁ * q_B b₂ := by dsimp [q_B]; ring
        _ ≤ K_prod * q_B b₁ * (K_B * μ_B b₂) :=
            mul_le_mul_of_nonneg_left (hq_domB b₂) (mul_nonneg hKprod.le (hqB_nn b₁))
        _ = K_prod * K_B * q_B b₁ * μ_B b₂ := by ring
    let w_fn : Fin N_B → EuclideanSpace ℝ (Fin 2) := fun b => s_dir • (θ_B b - a_mid)
    let v_fn : Fin N_B → EuclideanSpace ℝ (Fin 2) := fun b => s_dir • perp2D (dirVec (w_fn b))
    have hv_unit : ∀ b, ‖v_fn b‖ = 1 := by
      intro b; dsimp [v_fn]
      rw [h_sdir_norm s_dir _ hs_dir, h_perp_norm, h_dirVec_unit]
    let Δ_fn : Fin N_B → Fin N_B → ℝ :=
      fun b₁ b₂ => v_fn b₁ 0 * v_fn b₂ 1 - v_fn b₁ 1 * v_fn b₂ 0
    have hδ_strip_nn : 0 ≤ δ_strip := by
      let e_x : EuclideanSpace ℝ (Fin 2) := WithLp.toLp 2 ![1, 0]
      have hex : ‖e_x‖ = 1 := by
        refine (sq_eq_sq₀ (norm_nonneg _) zero_le_one).mp ?_
        rw [h_norm2]; simp [e_x]
      refine le_trans ?_ (h_nostrip_B e_x 0 hex)
      exact Finset.sum_nonneg (fun b _ => by split_ifs; exact hμB_nn b; exact le_rfl)
    have h_thin_mass : (∑ b₁, ∑ b₂,
        if |Δ_fn b₁ b₂| ≤ (1 / 16 : ℝ) * ρ_strip then (∑ a, W₂ a b₁ b₂) else 0) < 1 / 2 := by
      have h_b1 : ∀ b₁ : Fin N_B,
          (∑ b₂, if |Δ_fn b₁ b₂| ≤ (1 / 16 : ℝ) * ρ_strip then (∑ a, W₂ a b₁ b₂) else 0) ≤
            K_prod * K_B * q_B b₁ * δ_strip := by
        intro b₁
        let e₁ := perp2D (dirVec (w_fn b₁))
        have he₁ : ‖e₁‖ = 1 := by dsimp [e₁]; rw [h_perp_norm, h_dirVec_unit]
        let c₀ := inner ℝ a_mid e₁
        have h_pt : ∀ b₂ : Fin N_B,
            (if |Δ_fn b₁ b₂| ≤ (1 / 16 : ℝ) * ρ_strip then (∑ a, W₂ a b₁ b₂) else 0) ≤
              K_prod * K_B * q_B b₁ *
                (if |inner ℝ (θ_B b₂) e₁ - c₀| ≤ ρ_strip then μ_B b₂ else 0) := by
          intro b₂
          by_cases hΔ : |Δ_fn b₁ b₂| ≤ (1 / 16 : ℝ) * ρ_strip
          · rw [if_pos hΔ]
            by_cases hex_a : ∃ a, 0 < q a b₂
            · obtain ⟨a_w, ha_w⟩ := hex_a
              obtain ⟨hw_pos0, hw_le16⟩ := hq_supp_B a_w b₂ ha_w
              have hw_pos : 0 < ‖w_fn b₂‖ := by
                dsimp [w_fn]; rwa [h_sdir_norm s_dir _ hs_dir]
              have hw_ne : w_fn b₂ ≠ 0 := norm_pos_iff.mp hw_pos
              have hw_dir : ‖w_fn b₂‖ • dirVec (w_fn b₂) = w_fn b₂ := by
                unfold dirVec; rw [if_neg hw_ne, smul_smul, mul_inv_cancel₀ hw_pos.ne', one_smul]
              have hs2 : s_dir ^ 2 = 1 := (h_sdir_abs s_dir hs_dir).2
