      have hCD_eq_Ct : C_D = (((r_O o : ℝ) + 1 / 2) * ((2 : ℝ) ^ m_t)⁻¹) := by
        dsimp only [C_D]; rw [hr_eq]
      have hCD_Cr : C_D - C_r = (c_end - 1 / 2) * s_c := by
        rw [hCD_eq_Ct, ← hrO_decomp, h_pow_mt]
        dsimp only [C_r, c_end, N_R]
        push_cast
        have h_cancel : ((2 : ℝ) ^ (m_t - m_r)) * Δ_time = 1 :=
