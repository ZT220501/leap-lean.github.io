        have h_cs : Real.cos φ ^ 2 + Real.sin φ ^ 2 = 1 := Real.cos_sq_add_sin_sq φ
        refine ⟨?_, ?_, ?_, ?_, ?_⟩
        · simp only [ed, ed_fn, angUnitVec, EuclideanSpace.inner_eq_star_dotProduct,
