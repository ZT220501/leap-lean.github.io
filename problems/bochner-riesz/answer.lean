        · intro o d
          dsimp only [p_cond]
          split_ifs
          · exact div_nonneg (hp_nn o d) hπj.le
          · exact le_rfl
        · dsimp only [p_cond]
          have h_sum_eq : (∑ o : Fin N_O, ∑ d : Fin N_D,
              if win_of o = j ∧ 0 < π_J j then p o d / π_J j else 0) =
            (∑ o ∈ Finset.univ.filter (fun o => win_of o = j), ∑ d : Fin N_D, p o d) / π_J j := by
            rw [Finset.sum_div, Finset.sum_filter]
            refine Finset.sum_congr rfl (fun o _ => ?_)
            by_cases hwo : win_of o = j
            · have hcond : win_of o = j ∧ 0 < π_J j := ⟨hwo, hπj⟩
              simp only [hcond, hwo, and_self, ↓reduceIte, Finset.sum_div]
            · simp only [hwo, false_and, ↓reduceIte, Finset.sum_const_zero]
          rw [h_sum_eq]
          exact div_self hπj.ne'
        · intro o d hpc_pos
          dsimp only [p_cond] at hpc_pos
          split_ifs at hpc_pos with hcond
          · have hpod_pos : 0 < p o d := by
              by_contra hnp
              push Not at hnp
              have hpod0 : p o d = 0 := le_antisymm hnp (hp_nn o d)
              rw [hpod0, zero_div] at hpc_pos
              exact lt_irrefl 0 hpc_pos
            exact c9 o d hpod_pos
          · exact False.elim (lt_irrefl 0 hpc_pos)
      have hsupp_cond : ∀ o d, 0 < p_cond j o d →
          cutLocalizerIdx ε b_star m_r m_t (r_O o) (V_O o) (X_O o) = (menu j).loc_idx ∧
          b_star ≤ b_D d ∧
          0 < generalPacketObsMass ε H_P t lam_sys m_t Φ₀
            (fun v => ∑ α : Fin (N_ret_of j), (menu j).c_at α *
              ((ρ_r⁻¹ : ℂ) * star ((menu j).ψ_at α (ρ_r⁻¹ • (v - gridPt2D ρ_r ((menu j).o_at α).1))) *
                Complex.exp (-(Complex.I * ((lam_sys * Φ₀ ((((menu j).loc_idx.1 : ℝ) + 1 / 2) * s_c,
                  gridPt2D σ_r ((menu j).o_at α).2, v) : ℝ) : ℂ)))))
            (r_O o) (V_O o) (X_O o) (ψ_O o) := by
        intro o d hpc_pos
        dsimp only [p_cond] at hpc_pos
        split_ifs at hpc_pos with hcond
        · have hpod_pos : 0 < p o d := by
            by_contra hnp
            push Not at hnp
            have hpod0 : p o d = 0 := le_antisymm hnp (hp_nn o d)
            rw [hpod0, zero_div] at hpc_pos
            exact lt_irrefl 0 hpc_pos
          obtain ⟨hw_loc, hw_mass⟩ := hwin_spec o
          rw [hcond.1] at hw_loc hw_mass
          have hm_pos : 0 < generalPacketObsMass ε H_P t lam_sys m_t Φ₀ f
              (r_O o) (V_O o) (X_O o) (ψ_O o) :=
            lt_of_lt_of_le (Real.rpow_pos_of_pos hε_pos A₀) (ho_props o).2.2.2.2.2.2
          have hS_pos : (0 : ℝ) < 4 * ((S_per_loc : ℝ) ^ 2) := by positivity
          have hmj_pos : 0 < generalPacketObsMass ε H_P t lam_sys m_t Φ₀
              (fun v => ∑ α : Fin (N_ret_of j), (menu j).c_at α *
                ((ρ_r⁻¹ : ℂ) * star ((menu j).ψ_at α (ρ_r⁻¹ • (v - gridPt2D ρ_r ((menu j).o_at α).1))) *
                  Complex.exp (-(Complex.I * ((lam_sys * Φ₀ ((((menu j).loc_idx.1 : ℝ) + 1 / 2) * s_c,
                    gridPt2D σ_r ((menu j).o_at α).2, v) : ℝ) : ℂ)))))
              (r_O o) (V_O o) (X_O o) (ψ_O o) := by
            by_contra hle0
            push Not at hle0
            have hm_le0 : 4 * ((S_per_loc : ℝ) ^ 2) * _ ≤ 0 :=
              mul_nonpos_of_nonneg_of_nonpos hS_pos.le hle0
            dsimp only at hw_mass
            linarith only [hm_pos, hw_mass, hm_le0]
          exact ⟨hw_loc.symm, hb_ge o d hpod_pos, hmj_pos⟩
        · exact False.elim (lt_irrefl 0 hpc_pos)
      obtain ⟨hr_1, hr_2, _⟩ := h_root_each j
      obtain ⟨hh_pos, N_Oj, r_loc_O, V'_O_loc, X'_O_loc, ψ_O_loc,
        b'_D, a'_D, r'_D, V'_D, X'_D, p_loc,
        h2Δ_H', htr_H', htr_L', henv_loc1,
        hH'_K, hL'_K, hlam_l1, hlam_l2, hm_l1, hm_l2,
        hphase_l, hmeas_l, hsupp_l, hl2_l, hint_l,
        hadm_ld, hadm_l1, hsc_loc_eq⟩ :=
        hr_2 N_O N_D r_O V_O X_O ψ_O b_D a_D r_D e_D V_D X_D (p_cond j) hadm_cond hsupp_cond
      have hKj_le := hr_1 hh_pos
      have hd2_nn : 0 ≤ d₂ j := by
        dsimp only [d₂, A_of, K_of] at hKj_le ⊢
        linarith only [hKj_le]
      have hB_loc_eq : (localRescaledClass cls 1).B_sys =
          (localRescaledClass cls (t - r)).B_sys := rfl
      have hgrow_j := h_grow_loc ε (H_P - r - 2 * b_star) (L - r - b_star) (t - r)
        (s_c * s_v ^ 2 * lam_sys) (m_t - m_r)
        (localGaugePhase Φ₀ m_r (menu j).loc_idx.1 s_v
          (gridPt2D s_v (menu j).loc_idx.2.1) (gridPt2D s_x (menu j).loc_idx.2.2))
        (localGaugeGrad ζ₀ m_r (menu j).loc_idx.1 s_v
          (gridPt2D s_v (menu j).loc_idx.2.1) (gridPt2D s_x (menu j).loc_idx.2.2))
        _ N_Oj N_D r_loc_O V'_O_loc X'_O_loc ψ_O_loc b'_D a'_D r'_D e_D V'_D X'_D p_loc
        hε_lt_grow_loc h2Δ_H' (by linarith only [hr_lt_t]) htr_L' htr_H' henv_loc1
        (by rw [hB_loc_eq]; exact hm_l1) (by rw [hB_loc_eq]; exact hm_l2) hadm_l1
      have hR_dom_eq : (localRescaledClass cls 1).R_dom =
          8 * cls.B_sys + cls.R_win + 20 := rfl
      rw [hsc_loc_eq, hR_dom_eq] at hgrow_j
      have hd3_nn : 0 ≤ d₃ j := by
        dsimp only [d₃, P_of, K_of] at hgrow_j ⊢
        linarith only [hgrow_j]
      refine ⟨hh_pos, hd2_nn, hd3_nn, N_Oj, r_loc_O, V'_O_loc, X'_O_loc, ψ_O_loc,
        b'_D, a'_D, r'_D, V'_D, X'_D, p_loc,
        htr_H', hH'_K, htr_L', hL'_K, hlam_l1, hlam_l2, hm_l1, hm_l2,
        hphase_l, hmeas_l, hsupp_l, hl2_l, hint_l, hadm_ld, hsc_loc_eq⟩

    have hd23_eq_all : ∀ j : Fin N_J,
        d₂ j + d₃ j = A_of j + quantumPacketRate γ * (t - r) - P_of j + 2 * R_bud := by
      intro j; dsimp only [d₂, d₃]; ring

    refine ⟨d₀, d₂, d₃, hd₀_nn,
      fun j hπj => ⟨hd₁_nn_all j, (h_active_j j hπj).2.1, (h_active_j j hπj).2.2.1⟩,
      rfl, fun j _ => hd23_eq_all j, ?_, ?_, ?_, ?_, h_cut_states, ?_⟩
    · have h_sum_split : ∑ j : Fin N_J, π_J j * (d₁ j + d₂ j + d₃ j) =
          (∑ j : Fin N_J, π_J j * d₁ j) + (∑ j : Fin N_J, π_J j * A_of j) +
          (quantumPacketRate γ * (t - r) + 2 * R_bud) - (∑ j : Fin N_J, π_J j * P_of j) := by
        have h1 : (fun j : Fin N_J => π_J j * (d₁ j + d₂ j + d₃ j)) =
            (fun j : Fin N_J => π_J j * d₁ j + π_J j * A_of j +
              π_J j * (quantumPacketRate γ * (t - r) + 2 * R_bud) - π_J j * P_of j) := by
          ext j
          rw [add_assoc (d₁ j), hd23_eq_all j]
          ring
        rw [h1]
        simp only [Finset.sum_sub_distrib, Finset.sum_add_distrib, ← Finset.sum_mul,
          hπ_sum1, one_mul]
      dsimp only [d₀, K_r_star, B_r]
      have hmul_t : quantumPacketRate γ * r + quantumPacketRate γ * (t - r) =
          quantumPacketRate γ * t := by ring
      linarith only [h_sum_split, h_pt_decomp, hmul_t]
    · have hd1_sum_nn : 0 ≤ ∑ j : Fin N_J, π_J j * d₁ j :=
        Finset.sum_nonneg (fun j _ => mul_nonneg (hπ_nn j) (hd₁_nn_all j))
      dsimp only [d₀, K_r_star] at hd₀_nn
      have hmul_t : quantumPacketRate γ * r + quantumPacketRate γ * (t - r) =
          quantumPacketRate γ * t := by ring
      linarith only [hd₀_nn, hd1_sum_nn, hmul_t]
    · intro hr_pos hb0 hu_le_Lr _ ζ_g ν_l κ_l τ_no hζ_g h32R hν_l hκ_l _ hloc_nf j hπj hd2_le hd3_le
      by_contra hgt_g
      push Not at hgt_g
      obtain ⟨hh_pos, _, _, N_Oj, r_loc_O, V'_O_loc, X'_O_loc, ψ_O_loc,
        b'_D, a'_D, r'_D, V'_D, X'_D, p_loc,
        htr_H', hH'_K, htr_L', hL'_K, hlam_l1, hlam_l2, hm_l1, hm_l2,
        hphase_l, hmeas_l, hsupp_l, hl2_l, hint_l, hadm_ld, hsc_loc_eq⟩ := h_active_j j hπj
      have hR_dom_d : (localRescaledClass cls (t - r)).R_dom =
