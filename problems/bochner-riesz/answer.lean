      rcases lt_or_ge 2 ‖z‖ with hz_gt | hz_le
      · have h_open : IsOpen {w : E | 2 < ‖w‖} := isOpen_lt continuous_const continuous_norm
        have h_ev : ψ_q =ᶠ[nhds z] (fun _ : E => (0 : ℂ)) := by
          refine Filter.eventuallyEq_of_mem (h_open.mem_nhds hz_gt) (fun w hw => ?_)
          change 2 < ‖w‖ at hw
          dsimp [ψ_q]
          rw [h_pou_supp w hw.le]
          simp
        rw [(h_ev.iteratedFDeriv ℝ k).eq_of_nhds, iteratedFDeriv_fun_zero, Pi.zero_apply, norm_zero]
        positivity
      · have h_osc_bound : ∀ m : ℕ,
            ‖iteratedFDeriv ℝ m (g_neg ∘ θ_q) z‖ ≤
              (B_θ * Real.exp 3) ^ m * ((m.factorial : ℝ) ^ 4) := by
          intro m
          rcases m with _ | m'
          · rw [norm_iteratedFDeriv_zero, Function.comp_apply, hg_neg_norm (θ_q z)]
            simp
          · set m₁ : ℕ := m' + 1
            let D_m : ℝ := B_θ * ((m₁ : ℝ) ^ 3)
            have h_fdb := @norm_iteratedFDeriv_comp_le ℝ _ E _ _ ℝ _ _ ℂ _ _
              g_neg θ_q m₁ (m₁ : WithTop ℕ∞) (hg_neg_smooth m₁) (hθ_smooth m₁) le_rfl z (C := 1)
              (D := D_m) (fun i _ => hg_neg_iter i (θ_q z)) (fun i hi1 him => by
                have hi_le : i.factorial ≤ m₁ ^ i :=
                  le_trans (Nat.factorial_le_pow i) (Nat.pow_le_pow_left him i)
                have hi_real : (i.factorial : ℝ) ≤ (m₁ : ℝ) ^ i := by exact_mod_cast hi_le
                have hi_cube : ((i.factorial : ℝ) ^ 3) ≤ (((m₁ : ℝ) ^ 3) ^ i) := by
                  calc ((i.factorial : ℝ) ^ 3)
                      ≤ (((m₁ : ℝ) ^ i) ^ 3) := pow_le_pow_left₀ (Nat.cast_nonneg _) hi_real 3
                    _ = (((m₁ : ℝ) ^ 3) ^ i) := by rw [← pow_mul, mul_comm, pow_mul]
                calc ‖iteratedFDeriv ℝ i θ_q z‖
                    ≤ B_θ ^ i * ((i.factorial : ℝ) ^ 3) := hθ_deriv i hi1 z hz_le
                  _ ≤ B_θ ^ i * (((m₁ : ℝ) ^ 3) ^ i) :=
                      mul_le_mul_of_nonneg_left hi_cube (by positivity)
                  _ = D_m ^ i := by dsimp [D_m]; rw [mul_pow])
            have h_stirling : ((m₁ : ℝ) ^ m₁) ≤ (Real.exp 1) ^ m₁ * (m₁.factorial : ℝ) := by
              have h1 := Real.pow_div_factorial_le_exp (m₁ : ℝ) (Nat.cast_nonneg m₁) m₁
              have hfac_pos : (0 : ℝ) < (m₁.factorial : ℝ) := by
                exact_mod_cast Nat.factorial_pos m₁
              have h2 := (div_le_iff₀ hfac_pos).mp h1
              have hexp_eq : Real.exp (m₁ : ℝ) = (Real.exp 1) ^ m₁ := by
                rw [← Real.exp_nat_mul, mul_one]
              rwa [hexp_eq] at h2
            have h_cube_st : (((m₁ : ℝ) ^ m₁) ^ 3) ≤
                (Real.exp 3) ^ m₁ * ((m₁.factorial : ℝ) ^ 3) := by
              have hc := pow_le_pow_left₀ (by positivity) h_stirling 3
              have hexp3 : ((Real.exp 1) ^ m₁ * (m₁.factorial : ℝ)) ^ 3 =
                  (Real.exp 3) ^ m₁ * ((m₁.factorial : ℝ) ^ 3) := by
                rw [mul_pow, ← pow_mul, ← Real.exp_nat_mul, ← Real.exp_nat_mul]
                congr 2
                push_cast
                ring
              rwa [hexp3] at hc
            have hDm_pow : D_m ^ m₁ = B_θ ^ m₁ * (((m₁ : ℝ) ^ m₁) ^ 3) := by
              dsimp [D_m]
              rw [mul_pow, ← pow_mul, mul_comm 3 m₁, pow_mul]
            calc ‖iteratedFDeriv ℝ m₁ (g_neg ∘ θ_q) z‖
                ≤ (m₁.factorial : ℝ) * 1 * D_m ^ m₁ := h_fdb
              _ = (m₁.factorial : ℝ) * B_θ ^ m₁ * (((m₁ : ℝ) ^ m₁) ^ 3) := by
                  rw [hDm_pow]
                  ring
              _ ≤ (m₁.factorial : ℝ) * B_θ ^ m₁ *
                    ((Real.exp 3) ^ m₁ * ((m₁.factorial : ℝ) ^ 3)) :=
                  mul_le_mul_of_nonneg_left h_cube_st (by positivity)
              _ = (B_θ * Real.exp 3) ^ m₁ * ((m₁.factorial : ℝ) ^ 4) := by
                  rw [mul_pow]
                  ring
        let F_χ : E → ℂ := fun y => (pktPou2D y : ℂ)
        have hF_χ_smooth : ContDiff ℝ k F_χ :=
          Complex.ofRealCLM.contDiff.comp (h_pou_smooth k)
        have hF_χ_bound : ∀ i : ℕ,
            ‖iteratedFDeriv ℝ i F_χ z‖ ≤ C_χ ^ (i + 1) * ((i.factorial : ℝ) ^ 4) := by
          intro i
          change ‖iteratedFDeriv ℝ i (⇑Complex.ofRealLI ∘ pktPou2D) z‖ ≤ _
          rw [Complex.ofRealLI.norm_iteratedFDeriv_comp_left (h_pou_smooth i).contDiffAt le_rfl]
          exact h_pou_deriv i z
        have hW_bound : ‖iteratedFDeriv ℝ k W_q z‖ ≤ C₁ ^ (k + 1) * ((k.factorial : ℝ) ^ 4) := by
          have h_leib := @norm_iteratedFDeriv_mul_le ℝ _ E _ _ ℂ _ _
            F_χ (g_neg ∘ θ_q) (k : WithTop ℕ∞) hF_χ_smooth
            ((hg_neg_smooth k).comp (hθ_smooth k)) z k le_rfl
          have h_term : ∀ i ∈ Finset.range (k + 1),
              (k.choose i : ℝ) * ‖iteratedFDeriv ℝ i F_χ z‖ *
                ‖iteratedFDeriv ℝ (k - i) (g_neg ∘ θ_q) z‖ ≤
                M₁ ^ (k + 1) * ((k.factorial : ℝ) ^ 4) := by
            intro i hi
            have hik : i ≤ k := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
            have hM_left : C_χ ^ (i + 1) ≤ M₁ ^ (i + 1) :=
              pow_le_pow_left₀ (by linarith) (le_max_left _ _) (i + 1)
            have hM_right : (B_θ * Real.exp 3) ^ (k - i) ≤ M₁ ^ (k - i) :=
              pow_le_pow_left₀ (by positivity) (le_max_right _ _) (k - i)
            have hM_prod : C_χ ^ (i + 1) * (B_θ * Real.exp 3) ^ (k - i) ≤ M₁ ^ (k + 1) := by
              have hexp_eq : (i + 1) + (k - i) = k + 1 := by omega
              calc C_χ ^ (i + 1) * (B_θ * Real.exp 3) ^ (k - i)
                  ≤ M₁ ^ (i + 1) * M₁ ^ (k - i) :=
                    mul_le_mul hM_left hM_right (by positivity) (by positivity)
                _ = M₁ ^ ((i + 1) + (k - i)) := (pow_add M₁ (i + 1) (k - i)).symm
                _ = M₁ ^ (k + 1) := by rw [hexp_eq]
            have h_ch_eq : k.choose i * i.factorial * (k - i).factorial = k.factorial :=
              Nat.choose_mul_factorial_mul_factorial hik
            have h_prod_fac : i.factorial * (k - i).factorial ≤ k.factorial := by
              have hch_pos : 1 ≤ k.choose i := Nat.choose_pos hik
              calc i.factorial * (k - i).factorial
                  = 1 * i.factorial * (k - i).factorial := by ring
                _ ≤ k.choose i * i.factorial * (k - i).factorial := by
                    gcongr
                _ = k.factorial := h_ch_eq
            have h_comb_nat : k.choose i * i.factorial ^ 4 * (k - i).factorial ^ 4 ≤
                k.factorial ^ 4 := by
              calc k.choose i * i.factorial ^ 4 * (k - i).factorial ^ 4
                  = (k.choose i * i.factorial * (k - i).factorial) *
                      (i.factorial * (k - i).factorial) ^ 3 := by ring
                _ = k.factorial * (i.factorial * (k - i).factorial) ^ 3 := by rw [h_ch_eq]
                _ ≤ k.factorial * k.factorial ^ 3 :=
                    Nat.mul_le_mul_left k.factorial (Nat.pow_le_pow_left h_prod_fac 3)
                _ = k.factorial ^ 4 := by ring
            have h_comb : (k.choose i : ℝ) * ((i.factorial : ℝ) ^ 4) *
                (((k - i).factorial : ℝ) ^ 4) ≤ ((k.factorial : ℝ) ^ 4) := by
              exact_mod_cast h_comb_nat
            have h_f1 := hF_χ_bound i
            have h_f2 := h_osc_bound (k - i)
            calc (k.choose i : ℝ) * ‖iteratedFDeriv ℝ i F_χ z‖ *
                  ‖iteratedFDeriv ℝ (k - i) (g_neg ∘ θ_q) z‖
                ≤ (k.choose i : ℝ) * (C_χ ^ (i + 1) * ((i.factorial : ℝ) ^ 4)) *
                    ((B_θ * Real.exp 3) ^ (k - i) * (((k - i).factorial : ℝ) ^ 4)) := by
                  refine mul_le_mul (mul_le_mul_of_nonneg_left h_f1 (Nat.cast_nonneg _)) h_f2
                    (norm_nonneg _) (by positivity)
              _ = (C_χ ^ (i + 1) * (B_θ * Real.exp 3) ^ (k - i)) *
                    ((k.choose i : ℝ) * ((i.factorial : ℝ) ^ 4) *
                      (((k - i).factorial : ℝ) ^ 4)) := by ring
              _ ≤ M₁ ^ (k + 1) * ((k.factorial : ℝ) ^ 4) :=
                  mul_le_mul hM_prod h_comb (by positivity) (by positivity)
          have hk1_le_pow : ((k + 1 : ℕ) : ℝ) ≤ (2 : ℝ) ^ (k + 1) := by
            have hnat : k + 1 ≤ 2 ^ (k + 1) := by
              have h1 : k + 1 ≤ 2 ^ k := Nat.lt_two_pow_self
              have h2 : 2 ^ k ≤ 2 ^ (k + 1) := Nat.pow_le_pow_right (by omega) (by omega)
              omega
            exact_mod_cast hnat
          calc ‖iteratedFDeriv ℝ k W_q z‖
              ≤ ∑ i ∈ Finset.range (k + 1),
                  (k.choose i : ℝ) * ‖iteratedFDeriv ℝ i F_χ z‖ *
                    ‖iteratedFDeriv ℝ (k - i) (g_neg ∘ θ_q) z‖ := h_leib
            _ ≤ ∑ _i ∈ Finset.range (k + 1), M₁ ^ (k + 1) * ((k.factorial : ℝ) ^ 4) :=
                Finset.sum_le_sum h_term
            _ = ((k + 1 : ℕ) : ℝ) * (M₁ ^ (k + 1) * ((k.factorial : ℝ) ^ 4)) := by simp
            _ ≤ (2 : ℝ) ^ (k + 1) * (M₁ ^ (k + 1) * ((k.factorial : ℝ) ^ 4)) :=
                mul_le_mul_of_nonneg_right hk1_le_pow (by positivity)
            _ = C₁ ^ (k + 1) * ((k.factorial : ℝ) ^ 4) := by
                dsimp [C₁]
                rw [mul_pow]
                ring
        let s_amp : ℝ := C_amp⁻¹ * 4⁻¹
        have hs_amp_nn : 0 ≤ s_amp := by dsimp [s_amp]; positivity
        have hs_amp_le : s_amp ≤ C_amp⁻¹ := by
          dsimp [s_amp]
          have h4 : (4⁻¹ : ℝ) ≤ 1 := by norm_num
          calc C_amp⁻¹ * 4⁻¹ ≤ C_amp⁻¹ * 1 :=
