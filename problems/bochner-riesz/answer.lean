            exact_mod_cast hBj_nat
          calc (B_j.card : ℝ)
              ≤ (X_j.card : ℝ) * (M_mult : ℝ) := hBj_r
            _ ≤ (9 * C_cov ^ 2 * R_tr ^ 2) * (M_mult : ℝ) :=
