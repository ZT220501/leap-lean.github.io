      obtain ⟨hfP_cd, hfP_bd⟩ := hf_vec P₀
      obtain ⟨hfe_cd, hfe_bd⟩ := hf_vec e
      have hsfe_cd : ∀ k : ℕ, ContDiff ℝ k (fun s : ℝ => s * f_vec e s) := fun k =>
        contDiff_id.mul (hfe_cd k)
      rw [hH_split,
        iteratedDeriv_sub ((contDiff_const.mul (hfP_cd m)).contDiffAt)
          ((contDiff_const.mul (hsfe_cd m)).contDiffAt),
        iteratedDeriv_const_mul (lam_sys * ρ₀) (hfP_cd m).contDiffAt,
