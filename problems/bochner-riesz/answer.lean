  have h_sum_E₂_half : (1 / 2 : ℝ) ≤ ∑ w : Fin J₂, ∑ ω ∈ E₂ w, P₀ ω := by linarith
  have h_univ_J₂_ne : (Finset.univ : Finset (Fin J₂)).Nonempty :=
