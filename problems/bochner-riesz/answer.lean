              _ ≤ δ₂ * (pre.ρ ^ (2 * (d₂ - d₁) + κ₂) *
                    (∑ b : Fin pre.N_Θ,
                      if paramTreeBin pre.ρ d₁ (pre.θ b) = q₁
                      then (∑ idx_p, p0₂ idx_p b) else 0)) :=
                  mul_le_mul_of_nonneg_left
                    (mul_le_mul_of_nonneg_left h_par_le_p0 (Real.rpow_nonneg hρ0.le _))
                    hδ₂_pos.le
              _ ≤ δ₂ * (∑ b : Fin pre.N_Θ,
                    if paramTreeBin pre.ρ d₁ (pre.θ b) = q₁ ∧ paramTreeBin pre.ρ d₂ (pre.θ b) = q₂
                    then (∑ idx_p, p0₂ idx_p b) else 0) :=
                  mul_le_mul_of_nonneg_left h_cap_p0 hδ₂_pos.le
              _ ≤ M_ret₂ * m_ch₂ := h_floor_ch
              _ = m_ch₂ * M_ret₂ := mul_comm _ _
          have hm_ch_lb : δ₂ * pre.ρ ^ (2 * (d₂ - d₁) + κ₂) * m_par₂ ≤ m_ch₂ :=
            le_of_mul_le_mul_right h_comb hM₂_pos
          change pre.ρ ^ (2 * (d₂ - d₁) + κ_err l) * m_par₂ ≤ m_ch₂
          refine le_trans (mul_le_mul_of_nonneg_right ?_ hm_par₂_nn) hm_ch_lb
          calc pre.ρ ^ (2 * (d₂ - d₁) + κ_err l)
