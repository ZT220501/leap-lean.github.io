      (∀ d₁ d₂, Sep d₁ d₂ → Sep d₂ d₁) →
      (∀ (N'_D : ℕ) (b'_D a'_D : Fin N'_D → ℝ) (r'_D : Fin N'_D → ℕ)
        (e'_D V'_D X'_D : Fin N'_D → EuclideanSpace ℝ (Fin 2))
        (q' : Fin N_O → Fin N'_D → ℝ),
        IsAdmissiblePacketLaw ε H_P L t B_sys R_win N_mult M_win
          lam_sys m_t Φ₀ f N_O N'_D r_O V_O X_O ψ_O b'_D a'_D r'_D e'_D V'_D X'_D q' →
        generalPacketScore ε γ H_P t lam_sys m_t Φ₀ f N_O N'_D r_O V_O X_O ψ_O b'_D a'_D q' ≤ S_cap) →
      (S_cap - Δ_p ≤
        generalPacketScore ε γ H_P t lam_sys m_t Φ₀ f N_O N_D r_O V_O X_O ψ_O b_D a_D p) →
      (letI := Classical.propDecidable
       ∀ (ip : Fin N_P) (d : Fin N_D),
         ((Finset.univ.filter (fun o : Fin N_O => P_of o = ip ∧ 0 < p o d)).card : ℝ) ≤
           C_OP * ε ^ (-(4 * h))) →
      (letI := Classical.propDecidable
       ∀ d : Fin N_D,
         ((Finset.univ.filter (fun ib : Fin N_B =>
           ∃ o : Fin N_O, 0 < p o d ∧ B_of (P_of o) = ib)).card : ℝ) ≤ C_BD) →
      (∀ ib : Fin N_B,
        (((Finset.univ.filter (fun o : Fin N_O => B_of (P_of o) = ib)).image D_iso).card : ℝ) ≤
          C_iso * ε ^ (-(6 * h))) →
      (letI := Classical.propDecidable
       ∀ d₁ d₂ : Fin N_D, Sep d₁ d₂ →
         ((Finset.univ.filter (fun ip : Fin N_P =>
           (∃ o : Fin N_O, 0 < p o d₁ ∧ P_of o = ip) ∧
           (∃ o' : Fin N_O, 0 < p o' d₂ ∧ P_of o' = ip))).card : ℝ) ≤ B_sep) →
      (16 * Δ_p +
        (24 * Real.log 2 + Real.log 4 + Real.log C_OP + Real.log C_iso +
          2 * Real.log C_BD + Real.log B_sep) / ell <
        2 * γ * (a_ref - b_ref) - 10 * h - 8 * ζ_sh) →
      ∃ d_sel : Fin N_P → Fin N_D,
        3 / 4 ≤ ∑ o : Fin N_O, ∑ d : Fin N_D,
          @ite ℝ (¬ Sep d (d_sel (P_of o))) (Classical.propDecidable _) (p o d) 0 by
    obtain ⟨d_sel, h_sel_ge⟩ := h_core N_P N_B P_of B_of Sep C_OP C_BD C_iso B_sep S_cap Δ_p
      hC_OP hC_BD hC_iso hB_sep hSep_symm h_score_ub hp_score hcard_OP hcard_BD hcard_iso
      h_sep_fib h_contra_gap
    let n_buf : (ℕ × (ℤ × ℤ) × (ℤ × ℤ)) → EuclideanSpace ℝ (Fin 2) := fun p_c =>
      if hp_c : p_c ∈ S_P then perp2D (e_D (d_sel (e_P ⟨p_c, hp_c⟩))) else perp2D (e_D d₀)
    have hn_unit : ∀ p_c, ‖n_buf p_c‖ = 1 := by
      intro p_c; dsimp only [n_buf]
      by_cases hp_c : p_c ∈ S_P
      · rw [dif_pos hp_c, h_perp_norm, (hd_unit _).2]
      · rw [dif_neg hp_c, h_perp_norm, (hd_unit _).2]
    have hn_Pbuf : ∀ o : Fin N_O, n_buf (P_buf o) = perp2D (e_D (d_sel (P_of o))) := by
      intro o; dsimp only [n_buf, P_of]
      exact dif_pos (Finset.mem_image_of_mem P_buf (Finset.mem_univ o))
    refine ⟨n_buf, hn_unit, ?_⟩
    refine le_trans h_sel_ge (le_of_eq ?_)
    refine Finset.sum_congr rfl (fun o _ => Finset.sum_congr rfl (fun d _ => ?_))
    have h_iff : ¬ Sep d (d_sel (P_of o)) ↔
        projAngleDist (perp2D (e_D d)) (n_buf (P_buf o)) ≤ ε ^ (4 * h) := by
      rw [hn_Pbuf o]; dsimp only [Sep]; exact not_lt
    by_cases hns : ¬ Sep d (d_sel (P_of o))
    · rw [if_pos hns, if_pos (h_iff.mp hns)]
    · rw [if_neg hns, if_neg (fun hle => hns (h_iff.mpr hle))]

  clear h_contra_gap hp_score h_score_ub h_sep_fib hcard_iso hcard_BD hcard_OP
    hB_sep hSep_symm hgB_inj hgB_Bof hgP_inj hgP_Pof
    h_b4_sep h_b3_iso h_b2_BD h_b1_OP h1_le_e2h hML_pos h_dyad_ratio h_clock_drift hpack
    hp_geom hb_min_ut hb_min_d hd_unit hp_adm9 hd_adm hp₀_pos
    hCtot_ell hlam_pos hB_pos hlam_hi hlam_lo hε_lt_exp hε_lt_mod hε_le1
