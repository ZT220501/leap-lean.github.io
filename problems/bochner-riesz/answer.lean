  have hR_comp : IsCompact R_strip := isCompact_Icc.prod isCompact_Icc

  let μ : (ℤ × ℤ) → (ℤ × ℤ) → EuclideanSpace ℝ (Fin 2) → ℂ := fun j n v =>
    let y := ρ⁻¹ • (v - V_P) - gridPt2D 1 j
    ((C_χ : ℂ)⁻¹) * (pktPou2D y : ℂ) *
      Complex.exp (Complex.I * (((Real.pi / 2) * inner ℝ (gridPt2D 1 n) y : ℝ) : ℂ))

  have hμ_cont : ∀ j ∈ J_pat, ∀ n : ℤ × ℤ, Continuous (μ j n) := by
    intro j _ n
    dsimp [μ]
    have hy_cont : Continuous (fun v : EuclideanSpace ℝ (Fin 2) =>
        ρ⁻¹ • (v - V_P) - gridPt2D 1 j) :=
      ((continuous_id.sub continuous_const).const_smul ρ⁻¹).sub continuous_const
    refine (continuous_const.mul
      (Complex.continuous_ofReal.comp ((h_pou_smooth 0).continuous.comp hy_cont))).mul ?_
    exact Complex.continuous_exp.comp (continuous_const.mul
      (Complex.continuous_ofReal.comp (continuous_const.mul (continuous_const.inner hy_cont))))

  have hμ_le : ∀ j ∈ J_pat, ∀ (n : ℤ × ℤ) (v : EuclideanSpace ℝ (Fin 2)), ‖μ j n v‖ ≤ 1 := by
    intro j _ n v
    let y := ρ⁻¹ • (v - V_P) - gridPt2D 1 j
    have hy_pou : ‖(pktPou2D y : ℂ)‖ ≤ C_χ := by
      have h0 := h_pou_deriv 0 y
      rw [norm_iteratedFDeriv_zero] at h0
