  let K_o : ℝ := ρ ^ (-κ)
  have hKo_pos : 0 < K_o := Real.rpow_pos_of_pos hρ₀ _
  have h3872_bound : 3872 * (K_o * K_o * K_o) ≤ ρ_tilde ^ (-η₀) := by
    have hρt_nη_nn : 0 ≤ ρ_tilde ^ (-η) := Real.rpow_nonneg hρt_pos.le _
    have hK2 : K_o * K_o ≤ ρ_tilde ^ (-η) * ρ_tilde ^ (-η) :=
