      have hm_all : ((I_Vpar.card : ℝ) * (I_Ppar.card : ℝ)) *
          ((I_Vperp.card : ℝ) * (I_Pperp.card : ℝ)) ≤ 324 * (B_1 * B_1) := by
        refine mul_le_mul (by linarith) hm_perp ?_ (by norm_num)
        positivity
      rw [hB1_sq] at hm_all
      have h_eq_cloc : 324 * ((96 * (N : ℝ) + 182) ^ 2 * ε ^ (-2 * ν)) =
          C_loc * ε ^ (-2 * ν) := by dsimp only [C_loc]; ring
      linarith
    refine ⟨S_kr, S_kang, S_row, S_std, hSkr_le, hSkang_le, hSrow_le, hSstd_le, ?_⟩
    intro V₂ A₂ c₂ θ_u2 θ_12 hV₂ hA₂ hc₂ hθ_u2 hθ_12 hch₂ hcyc₂
    let R₂ := chartRowSlope useChart0 θ_12
    let V₂' := chartRowVec useChart0 V₂
    let A₂' := chartRowVec useChart0 A₂
    let kr₂ := dyadicRealBin ε (m * u) R₂
    let kang₂ := angBin ε (m * u) θ_u2
    obtain ⟨h_kr_pair, h_kang_pair⟩ :=
      h_pair_orient ε d (m * u) N useChart0 θ_u1 θ_11 θ_u2 θ_12
        hε₀ hε₁ hd_pos hd_le_mu hθ_u1 hθ_11 hch₁ hcyc₁ hθ_u2 hθ_12 hch₂ hcyc₂
    have h_bu_u_mu : (b_u + u) + m * u = b_u + (1 + m) * u := by ring
    have hP'_coord : ∀ (V A : EuclideanSpace ℝ (Fin 2)) (C_v R_mv : ℝ),
