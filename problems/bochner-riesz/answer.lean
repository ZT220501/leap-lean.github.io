      rw [if_neg hs_pos.ne'] at hp_pos
      have hq_pos : 0 < q s o d := (div_pos_iff_of_pos_right hs_pos).mp hp_pos
      dsimp [q] at hq_pos
      split_ifs at hq_pos with hbin
      · exact ⟨hq_pos, hbin⟩
      · exact False.elim (lt_irrefl 0 hq_pos)
  obtain ⟨s, p_c, hp_c_nn, hp_c_sum, hp_c_supp, h_score_split⟩ := h_partition
  have hex_od : ∃ (o₀ : Fin N_O) (d₀ : Fin N_D), 0 < p_c o₀ d₀ := by
