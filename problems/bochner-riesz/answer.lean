          (⟨q.2.1.val, h_box0_sub _ q.2.1.prop⟩, ⟨q.2.2.val, h_box0_sub _ q.2.2.prop⟩)))

    have hS₀_card : (S₀.card : ℝ) ≤ (((2 * ⌈B_iso⌉₊ + 3) ^ 4 : ℕ) : ℝ) := by
      have h_b0_card : box_0.card = 2 * ⌈B_iso⌉₊ + 3 := by
        dsimp [box_0, R₀]
        rw [Int.card_Icc]
        omega
      have h_le : S₀.card ≤ (2 * ⌈B_iso⌉₊ + 3) ^ 4 := by
        calc S₀.card
            ≤ ((box_0.attach ×ˢ box_0.attach) ×ˢ (box_0.attach ×ˢ box_0.attach)).card :=
              Finset.card_image_le
          _ = (box_0.card * box_0.card) * (box_0.card * box_0.card) := by
              simp [Finset.card_product]
          _ = (2 * ⌈B_iso⌉₊ + 3) ^ 4 := by
              rw [h_b0_card]
              ring
      exact_mod_cast h_le

    have hS₀_zero : ∀ m ∈ S₀, w_menu m = 0 := by
      intro m hm
      obtain ⟨q, _, rfl⟩ := Finset.mem_image.mp hm
      dsimp [w_menu, b_menu, a_menu, dp0]
      ring

    have hS₀_cov : ∀ tid : Fin M_T, ∃ m ∈ S₀, tid ∈ C_menu m := by
      intro tid
      have h_fl_in : ∀ x : ℝ, |x| ≤ B_iso → ⌊x⌋ ∈ box_0 ∧ |x - (⌊x⌋ : ℝ)| ≤ 10 := by
