      linarith
    have h_target_eq : (∫ p in R_strip,
        ‖(ρ⁻¹ : ℂ) * ∫ v : EuclideanSpace ℝ (Fin 2),
          (∑ T ∈ W, c_T T *
            ((s⁻¹ : ℂ) * η_T T (s⁻¹ • (v - V_T T)) *
