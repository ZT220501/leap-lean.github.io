by
  have h_norm2_le : ∀ (z : EuclideanSpace ℝ (Fin 2)) (B : ℝ),
      0 ≤ B → |z 0| ≤ B → |z 1| ≤ B → ‖z‖ ≤ 2 * B := by
    intro z B hB h0 h1
    have hsq : ‖z‖ ^ 2 ≤ (2 * B) ^ 2 := by
      rw [PiLp.norm_sq_eq_of_L2, Fin.sum_univ_two]
      have hz0 : ‖z.ofLp 0‖ = |z 0| := Real.norm_eq_abs (z 0)
      have hz1 : ‖z.ofLp 1‖ = |z 1| := Real.norm_eq_abs (z 1)
      rw [hz0, hz1]
      have hs0 : |z 0| ^ 2 ≤ B ^ 2 := sq_le_sq.mpr (by rwa [abs_abs, abs_of_nonneg hB])
      have hs1 : |z 1| ^ 2 ≤ B ^ 2 := sq_le_sq.mpr (by rwa [abs_abs, abs_of_nonneg hB])
      nlinarith
    exact le_of_pow_le_pow_left₀ (by omega) (by positivity) hsq

  have h_coord_le_norm : ∀ (z : EuclideanSpace ℝ (Fin 2)) (i : Fin 2), |z i| ≤ ‖z‖ := by
    intro z i
    have hsq : |z i| ^ 2 ≤ ‖z‖ ^ 2 := by
      rw [PiLp.norm_sq_eq_of_L2, Fin.sum_univ_two]
      have hz0 : ‖z.ofLp 0‖ = |z 0| := Real.norm_eq_abs (z 0)
      have hz1 : ‖z.ofLp 1‖ = |z 1| := Real.norm_eq_abs (z 1)
      rw [hz0, hz1]
      by_cases hi : i = 0
      · subst hi; linarith [sq_nonneg |z 1|]
      · have hi1 : i = 1 := by omega
        subst hi1; linarith [sq_nonneg |z 0|]
    exact le_of_pow_le_pow_left₀ (by omega) (norm_nonneg z) hsq

  have h_round0_dist : ∀ (s : ℝ) (z : EuclideanSpace ℝ (Fin 2)),
      0 < s → ‖z - gridPt2D s (roundShift2D s 0 z)‖ ≤ 2 * s := by
    intro s z hs
    refine h_norm2_le _ s hs.le ?_ ?_
    · have hfl1 := Int.floor_le ((z 0 - (0 : EuclideanSpace ℝ (Fin 2)) 0) / s)
      have hfl2 := (Int.lt_floor_add_one ((z 0 - (0 : EuclideanSpace ℝ (Fin 2)) 0) / s)).le
      have h0 : (0 : EuclideanSpace ℝ (Fin 2)) 0 = 0 := rfl
      have hg : (gridPt2D s (roundShift2D s 0 z)) 0 =
          s * ((Int.floor ((z 0 - 0) / s) : ℤ) : ℝ) := rfl
      have hsub : (z - gridPt2D s (roundShift2D s 0 z)) 0 =
          z 0 - (gridPt2D s (roundShift2D s 0 z)) 0 := rfl
      rw [h0] at hfl1 hfl2
      have hlo : ((Int.floor ((z 0 - 0) / s) : ℤ) : ℝ) * s ≤ z 0 - 0 := (le_div_iff₀ hs).mp hfl1
      have hhi : z 0 - 0 ≤ (((Int.floor ((z 0 - 0) / s) : ℤ) : ℝ) + 1) * s := (div_le_iff₀ hs).mp hfl2
      rw [hsub, hg]
      exact abs_le.mpr ⟨by linarith, by linarith⟩
    · have hfl1 := Int.floor_le ((z 1 - (0 : EuclideanSpace ℝ (Fin 2)) 1) / s)
      have hfl2 := (Int.lt_floor_add_one ((z 1 - (0 : EuclideanSpace ℝ (Fin 2)) 1) / s)).le
      have h0 : (0 : EuclideanSpace ℝ (Fin 2)) 1 = 0 := rfl
      have hg : (gridPt2D s (roundShift2D s 0 z)) 1 =
          s * ((Int.floor ((z 1 - 0) / s) : ℤ) : ℝ) := rfl
      have hsub : (z - gridPt2D s (roundShift2D s 0 z)) 1 =
          z 1 - (gridPt2D s (roundShift2D s 0 z)) 1 := rfl
      rw [h0] at hfl1 hfl2
      have hlo : ((Int.floor ((z 1 - 0) / s) : ℤ) : ℝ) * s ≤ z 1 - 0 := (le_div_iff₀ hs).mp hfl1
      have hhi : z 1 - 0 ≤ (((Int.floor ((z 1 - 0) / s) : ℤ) : ℝ) + 1) * s := (div_le_iff₀ hs).mp hfl2
      rw [hsub, hg]
      exact abs_le.mpr ⟨by linarith, by linarith⟩

  have h_coarse_vel_dist : ∀ (M_L : ℕ) (s : ℝ) (τ z₁ z₂ : EuclideanSpace ℝ (Fin 2)),
      1 ≤ M_L → 0 < s →
      ((roundShift2D s τ z₁).1 / (M_L : ℤ), (roundShift2D s τ z₁).2 / (M_L : ℤ)) =
        ((roundShift2D s τ z₂).1 / (M_L : ℤ), (roundShift2D s τ z₂).2 / (M_L : ℤ)) →
      ‖z₁ - z₂‖ ≤ 2 * (M_L : ℝ) * s := by
    intro M_L s τ z₁ z₂ hML hs heq
    have hML_pos : (0 : ℤ) < (M_L : ℤ) := by exact_mod_cast (Nat.lt_of_lt_of_le Nat.zero_lt_one hML)
    have hML_nn : (0 : ℝ) ≤ (M_L : ℝ) * s := by positivity
    have h_coord : ∀ (x₁ x₂ t₀ : ℝ),
        Int.floor ((x₁ - t₀) / s) / (M_L : ℤ) = Int.floor ((x₂ - t₀) / s) / (M_L : ℤ) →
        |x₁ - x₂| ≤ (M_L : ℝ) * s := by
      intro x₁ x₂ t₀ hdiv
      let a₁ := Int.floor ((x₁ - t₀) / s)
      let a₂ := Int.floor ((x₂ - t₀) / s)
      have hd1 := Int.mul_ediv_add_emod a₁ (M_L : ℤ)
      have hd2 := Int.mul_ediv_add_emod a₂ (M_L : ℤ)
      have hr1_0 := Int.emod_nonneg a₁ hML_pos.ne'
      have hr1_lt := Int.emod_lt_of_pos a₁ hML_pos
      have hr2_0 := Int.emod_nonneg a₂ hML_pos.ne'
      have hr2_lt := Int.emod_lt_of_pos a₂ hML_pos
      have ha_diff : a₁ - a₂ = a₁ % (M_L : ℤ) - a₂ % (M_L : ℤ) := by
        dsimp only [a₁, a₂] at hd1 hd2 ⊢
        rw [hdiv] at hd1
        linarith [hd1, hd2]
      have ha_lo : -((M_L : ℤ) - 1) ≤ a₁ - a₂ := by omega
      have ha_hi : a₁ - a₂ ≤ (M_L : ℤ) - 1 := by omega
      have ha_lo_r : -((M_L : ℝ) - 1) ≤ (a₁ : ℝ) - (a₂ : ℝ) := by exact_mod_cast ha_lo
      have ha_hi_r : (a₁ : ℝ) - (a₂ : ℝ) ≤ (M_L : ℝ) - 1 := by exact_mod_cast ha_hi
      have hf1_lo : (a₁ : ℝ) ≤ (x₁ - t₀) / s := Int.floor_le _
      have hf1_hi : (x₁ - t₀) / s ≤ (a₁ : ℝ) + 1 := (Int.lt_floor_add_one _).le
      have hf2_lo : (a₂ : ℝ) ≤ (x₂ - t₀) / s := Int.floor_le _
      have hf2_hi : (x₂ - t₀) / s ≤ (a₂ : ℝ) + 1 := (Int.lt_floor_add_one _).le
      have hx1_lo : (a₁ : ℝ) * s ≤ x₁ - t₀ := (le_div_iff₀ hs).mp hf1_lo
      have hx1_hi : x₁ - t₀ ≤ ((a₁ : ℝ) + 1) * s := (div_le_iff₀ hs).mp hf1_hi
      have hx2_lo : (a₂ : ℝ) * s ≤ x₂ - t₀ := (le_div_iff₀ hs).mp hf2_lo
      have hx2_hi : x₂ - t₀ ≤ ((a₂ : ℝ) + 1) * s := (div_le_iff₀ hs).mp hf2_hi
      refine abs_le.mpr ⟨?_, ?_⟩ <;> nlinarith
    have h0 := h_coord (z₁ 0) (z₂ 0) (τ 0) (Prod.ext_iff.mp heq).1
    have h1 := h_coord (z₁ 1) (z₂ 1) (τ 1) (Prod.ext_iff.mp heq).2
    have h2eq : 2 * ((M_L : ℝ) * s) = 2 * (M_L : ℝ) * s := by ring
    rw [← h2eq]
    exact h_norm2_le (z₁ - z₂) ((M_L : ℝ) * s) hML_nn h0 h1

  have h_icc_card3 : ∀ k : ℤ, (Finset.Icc (k - 1) (k + 1)).card = 3 := by
    intro k; rw [Int.card_Icc]; omega

  have h_mem_1d : ∀ (s u : ℝ) (m : ℤ), 0 < s → |s * (m : ℝ) - u| ≤ s →
      m ∈ Finset.Icc (Int.floor (u / s) - 1) (Int.floor (u / s) + 1) := by
    intro s u m hs habs
    rw [Finset.mem_Icc]
    obtain ⟨h1, h2⟩ := abs_le.mp habs
    have hfl_lo : (Int.floor (u / s) : ℝ) ≤ u / s := Int.floor_le _
    have hfl_hi : u / s < (Int.floor (u / s) : ℝ) + 1 := Int.lt_floor_add_one _
    have hu_lo : (Int.floor (u / s) : ℝ) * s ≤ u := (le_div_iff₀ hs).mp hfl_lo
    have hu_hi : u < ((Int.floor (u / s) : ℝ) + 1) * s := (div_lt_iff₀ hs).mp hfl_hi
    have hm_lo_r : ((Int.floor (u / s) - 1 : ℤ) : ℝ) * s ≤ (m : ℝ) * s := by
      push_cast; nlinarith
    have hm_hi_r : (m : ℝ) * s < ((Int.floor (u / s) + 2 : ℤ) : ℝ) * s := by
      push_cast; nlinarith
    have hm_lo : Int.floor (u / s) - 1 ≤ m := by
      exact_mod_cast le_of_mul_le_mul_right hm_lo_r hs
    have hm_lt : m < Int.floor (u / s) + 2 := by
      exact_mod_cast lt_of_mul_lt_mul_right hm_hi_r hs.le
    omega

  have h_pack_81 : ∀ {N_ret M_mult : ℕ} (ρ_r σ_r : ℝ) (o_at : Fin N_ret → (ℤ × ℤ) × (ℤ × ℤ)),
      0 < ρ_r → 0 < σ_r →
      (letI := Classical.propDecidable
       ∀ o₀, ((Finset.univ.filter (fun α : Fin N_ret => o_at α = o₀)).card : ℝ) ≤ (M_mult : ℝ)) →
      letI := Classical.propDecidable
      ∀ v₀ x₀ : EuclideanSpace ℝ (Fin 2),
        ((Finset.univ.filter (fun α : Fin N_ret =>
          ‖gridPt2D ρ_r (o_at α).1 - v₀‖ ≤ ρ_r ∧ ‖gridPt2D σ_r (o_at α).2 - x₀‖ ≤ σ_r)).card : ℝ) ≤
          ((81 * M_mult : ℕ) : ℝ) := by
    intro N_ret M_mult ρ_r σ_r o_at hρ hσ hfib
    letI := Classical.propDecidable
    intro v₀ x₀
    let kv0 := Int.floor (v₀ 0 / ρ_r)
    let kv1 := Int.floor (v₀ 1 / ρ_r)
    let kx0 := Int.floor (x₀ 0 / σ_r)
    let kx1 := Int.floor (x₀ 1 / σ_r)
    let box := ((Finset.Icc (kv0 - 1) (kv0 + 1)) ×ˢ (Finset.Icc (kv1 - 1) (kv1 + 1))) ×ˢ
               ((Finset.Icc (kx0 - 1) (kx0 + 1)) ×ˢ (Finset.Icc (kx1 - 1) (kx1 + 1)))
    have hbox_card : box.card = 81 := by
      dsimp only [box]
      rw [Finset.card_product, Finset.card_product, Finset.card_product,
        h_icc_card3, h_icc_card3, h_icc_card3, h_icc_card3]
    let S := Finset.univ.filter (fun α : Fin N_ret =>
      ‖gridPt2D ρ_r (o_at α).1 - v₀‖ ≤ ρ_r ∧ ‖gridPt2D σ_r (o_at α).2 - x₀‖ ≤ σ_r)
    have h_maps : ∀ α ∈ S, o_at α ∈ box := by
      intro α hα
      rw [Finset.mem_filter] at hα
      obtain ⟨_, hv, hx⟩ := hα
      have hv0 : |ρ_r * (((o_at α).1.1 : ℤ) : ℝ) - v₀ 0| ≤ ρ_r :=
        le_trans (h_coord_le_norm (gridPt2D ρ_r (o_at α).1 - v₀) 0) hv
      have hv1 : |ρ_r * (((o_at α).1.2 : ℤ) : ℝ) - v₀ 1| ≤ ρ_r :=
        le_trans (h_coord_le_norm (gridPt2D ρ_r (o_at α).1 - v₀) 1) hv
      have hx0 : |σ_r * (((o_at α).2.1 : ℤ) : ℝ) - x₀ 0| ≤ σ_r :=
        le_trans (h_coord_le_norm (gridPt2D σ_r (o_at α).2 - x₀) 0) hx
      have hx1 : |σ_r * (((o_at α).2.2 : ℤ) : ℝ) - x₀ 1| ≤ σ_r :=
        le_trans (h_coord_le_norm (gridPt2D σ_r (o_at α).2 - x₀) 1) hx
      dsimp only [box, kv0, kv1, kx0, kx1]
      rw [Finset.mem_product, Finset.mem_product, Finset.mem_product]
      exact ⟨⟨h_mem_1d ρ_r (v₀ 0) (o_at α).1.1 hρ hv0,
              h_mem_1d ρ_r (v₀ 1) (o_at α).1.2 hρ hv1⟩,
             ⟨h_mem_1d σ_r (x₀ 0) (o_at α).2.1 hσ hx0,
              h_mem_1d σ_r (x₀ 1) (o_at α).2.2 hσ hx1⟩⟩
    have h_card_le : S.card ≤ M_mult * box.card := by
      refine Finset.card_le_mul_card_image_of_maps_to h_maps M_mult (fun o₀ _ => ?_)
      have hsub : S.filter (fun α => o_at α = o₀) ⊆
          Finset.univ.filter (fun α : Fin N_ret => o_at α = o₀) := by
        intro α hα
        rw [Finset.mem_filter] at hα ⊢
        exact ⟨Finset.mem_univ α, hα.2⟩
      have h1 : (S.filter (fun α => o_at α = o₀)).card ≤
          (Finset.univ.filter (fun α : Fin N_ret => o_at α = o₀)).card :=
        Finset.card_le_card hsub
      have h2 : (Finset.univ.filter (fun α : Fin N_ret => o_at α = o₀)).card ≤ M_mult := by
        exact_mod_cast hfib o₀
      exact le_trans h1 h2
    rw [hbox_card, Nat.mul_comm] at h_card_le
    exact_mod_cast h_card_le

  have h_ell_pos : ∀ {ε : ℝ}, 0 < ε → ε < 1 / 2 → 0 < Real.log (ε⁻¹) := by
    intro ε hε₀ hε₁
