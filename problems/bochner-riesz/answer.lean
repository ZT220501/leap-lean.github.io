        exact mul_inv_cancel_left₀ (hΨ_ne t) (u t)
      have hh_maj : ∀ n : ℕ, ∀ j ≤ n, ∀ t : ℝ, ‖iteratedDeriv j h t‖ ≤ K_maj B n := by
