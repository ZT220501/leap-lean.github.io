theorem uniform_all_duration_packet_growth (γ : ℝ) (hγ₀ : 0 < γ) (hγ₁ : γ < 1)
    (hβ_pos : 0 < quantumPacketRate γ) (hβ_le : quantumPacketRate γ ≤ 1)
