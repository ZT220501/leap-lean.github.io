      intro u d_i
      dsimp only [B_pad, A_pad, e_D_pad]
      by_cases h : d_i.1 < N_D u
      · simp only [dif_pos h]
        exact (h_ex_spec u).1 ⟨d_i.1, h⟩
      · simp only [dif_neg h]
        exact ⟨le_rfl, le_rfl, hL_loc_nn, he₀_norm⟩
    have hq_pad_nn : ∀ (u : Fin M_J) (tid : Fin N_T) (d_i : Fin M_D), 0 ≤ q_pad u tid d_i := by
      intro u tid d_i
      dsimp only [q_pad]
      by_cases h : d_i.1 < N_D u
      · rw [dif_pos h]; exact (h_ex_spec u).2.1 tid ⟨d_i.1, h⟩
      · rw [dif_neg h]
    have hq_pad_marg : ∀ (u : Fin M_J) (tid : Fin N_T),
        ∑ d_i : Fin M_D, q_pad u tid d_i = p_T_u u tid := by
      intro u tid
      exact (h_sum_pad (hND_le u) (fun i => q_u u tid i)).trans ((h_ex_spec u).2.2.1 tid)
    have hqD_pad_eq : ∀ (u : Fin M_J) (d_i : Fin M_D),
        q_D_pad u d_i =
          if h : d_i.1 < N_D u then (∑ tid : Fin N_T, q_u u tid ⟨d_i.1, h⟩) else 0 := by
      intro u d_i
      dsimp only [q_D_pad, q_pad]
      by_cases h : d_i.1 < N_D u
      · simp only [dif_pos h]
      · simp only [dif_neg h, Finset.sum_const_zero]
    have hqD_pad_nn : ∀ (u : Fin M_J) (d_i : Fin M_D), 0 ≤ q_D_pad u d_i := fun u d_i =>
      Finset.sum_nonneg (fun tid _ => hq_pad_nn u tid d_i)
    have hqD_pad_sum : ∀ u : Fin M_J, ∑ d_i : Fin M_D, q_D_pad u d_i = 1 := by
      intro u
      dsimp only [q_D_pad]
      rw [Finset.sum_comm]
      have h1 : (∑ tid : Fin N_T, ∑ d_i : Fin M_D, q_pad u tid d_i) =
          ∑ tid : Fin N_T, p_T_u u tid :=
        Finset.sum_congr rfl (fun tid _ => hq_pad_marg u tid)
      exact h1.trans (hpTu_sum u)
    have hq_pad_cap : ∀ (u : Fin M_J) (tid : Fin N_T) (d_i : Fin M_D),
        0 < q_pad u tid d_i →
        |inner ℝ (V_loc (j_u u) tid - V_D_pad u d_i) (e_D_pad u d_i)| ≤
          10 * ε_tilde ^ (B_pad u d_i) ∧
        |inner ℝ (V_loc (j_u u) tid - V_D_pad u d_i) (perp2D (e_D_pad u d_i))| ≤
          10 * ε_tilde ^ (A_pad u d_i) ∧
        |inner ℝ (A_loc (j_u u) tid - A_D_pad u d_i) (e_D_pad u d_i)| ≤
          10 * ε_tilde ^ (B_pad u d_i) ∧
        |inner ℝ (A_loc (j_u u) tid - A_D_pad u d_i) (perp2D (e_D_pad u d_i))| ≤
          10 * ε_tilde ^ (A_pad u d_i) := by
      intro u tid d_i hq_pos
      dsimp only [q_pad] at hq_pos
      by_cases h : d_i.1 < N_D u
      · rw [dif_pos h] at hq_pos
        dsimp only [B_pad, A_pad, e_D_pad, V_D_pad, A_D_pad]
        simp only [dif_pos h]
        exact (h_ex_spec u).2.2.2.1 tid ⟨d_i.1, h⟩ hq_pos
      · rw [dif_neg h] at hq_pos
        exact absurd hq_pos (lt_irrefl 0)

    let E_w_pad : Fin M_J → ℝ := fun u =>
      ∑ d_i : Fin M_D, q_D_pad u d_i * ((1 + γ) * B_pad u d_i + (1 - γ) * A_pad u d_i)
    let I_TD_pad : Fin M_J → ℝ := fun u =>
      (∑ tid : Fin N_T, ∑ d_i : Fin M_D,
        q_pad u tid d_i * Real.log (q_pad u tid d_i / (p_T_u u tid * q_D_pad u d_i))) /
        Real.log (ε_tilde⁻¹)
    have h_pad_score : ∀ u : Fin M_J, τ_u u - (1 / 3 : ℝ) * δ_cl ≤ E_w_pad u - I_TD_pad u := by
      intro u
      have hEw : E_w_pad u =
          ∑ i : Fin (N_D u), (∑ tid : Fin N_T, q_u u tid i) *
            ((1 + γ) * b_u u i + (1 - γ) * a_u u i) := by
        dsimp only [E_w_pad]
        have h_term : ∀ d_i : Fin M_D,
            q_D_pad u d_i * ((1 + γ) * B_pad u d_i + (1 - γ) * A_pad u d_i) =
              if h : d_i.1 < N_D u then
                (∑ tid : Fin N_T, q_u u tid ⟨d_i.1, h⟩) *
                  ((1 + γ) * b_u u ⟨d_i.1, h⟩ + (1 - γ) * a_u u ⟨d_i.1, h⟩)
              else 0 := by
          intro d_i
          rw [hqD_pad_eq u d_i]
          dsimp only [B_pad, A_pad]
          by_cases h : d_i.1 < N_D u
          · simp only [dif_pos h]
          · simp only [dif_neg h, zero_mul]
        simp_rw [h_term]
        exact h_sum_pad (hND_le u)
          (fun i => (∑ tid : Fin N_T, q_u u tid i) * ((1 + γ) * b_u u i + (1 - γ) * a_u u i))
      have hITD : I_TD_pad u =
          (∑ tid : Fin N_T, ∑ i : Fin (N_D u),
            q_u u tid i * Real.log (q_u u tid i /
              (p_T_u u tid * (∑ tid' : Fin N_T, q_u u tid' i)))) /
            Real.log (ε_tilde⁻¹) := by
        dsimp only [I_TD_pad]
        congr 1
        refine Finset.sum_congr rfl (fun tid _ => ?_)
        have h_term : ∀ d_i : Fin M_D,
            q_pad u tid d_i * Real.log (q_pad u tid d_i / (p_T_u u tid * q_D_pad u d_i)) =
              if h : d_i.1 < N_D u then
                q_u u tid ⟨d_i.1, h⟩ * Real.log (q_u u tid ⟨d_i.1, h⟩ /
                  (p_T_u u tid * (∑ tid' : Fin N_T, q_u u tid' ⟨d_i.1, h⟩)))
              else 0 := by
          intro d_i
          rw [hqD_pad_eq u d_i]
          dsimp only [q_pad]
          by_cases h : d_i.1 < N_D u
          · simp only [dif_pos h]
          · simp only [dif_neg h, zero_mul]
        simp_rw [h_term]
        exact h_sum_pad (hND_le u) (fun i =>
          q_u u tid i * Real.log (q_u u tid i /
            (p_T_u u tid * (∑ tid' : Fin N_T, q_u u tid' i))))
      rw [hEw, hITD]
      exact (h_ex_spec u).2.2.2.2.le

    
    have h_comp_ud : ∀ (u : Fin M_J) (d_i : Fin M_D),
        ∃ (p_raw q_raw : ℝ) (e_G V_G X_G : EuclideanSpace ℝ (Fin 2)),
          0 ≤ p_raw ∧ p_raw ≤ q_raw ∧ q_raw + r ≤ L_hor ∧ ‖e_G‖ = 1 ∧
          ((1 + γ) * b_t + (1 - γ) * (b_t + d)) +
              η * ((1 + γ) * B_pad u d_i + (1 - γ) * A_pad u d_i) ≤
            (1 + γ) * p_raw + (1 - γ) * q_raw ∧
          (∀ ω : Fin N_ω, 0 < π ω → J ω = j_u u →
            let tid := T_idx ω
            let c_mid := ((k_r ω : ℝ) + 1 / 2) * Δ_r
            |inner ℝ (V_loc (j_u u) tid - V_D_pad u d_i) (e_D_pad u d_i)| ≤
              10 * ε_tilde ^ (B_pad u d_i) →
            |inner ℝ (V_loc (j_u u) tid - V_D_pad u d_i) (perp2D (e_D_pad u d_i))| ≤
              10 * ε_tilde ^ (A_pad u d_i) →
            |inner ℝ (A_loc (j_u u) tid - A_D_pad u d_i) (e_D_pad u d_i)| ≤
              10 * ε_tilde ^ (B_pad u d_i) →
            |inner ℝ (A_loc (j_u u) tid - A_D_pad u d_i) (perp2D (e_D_pad u d_i))| ≤
              10 * ε_tilde ^ (A_pad u d_i) →
            |inner ℝ (V_part tid - V_G) e_G| ≤ 250 * ε ^ p_raw ∧
            |inner ℝ (V_part tid - V_G) (perp2D e_G)| ≤ 250 * ε ^ q_raw ∧
            |inner ℝ ((A_part tid + c_mid • V_part tid) - X_G) e_G| ≤ 250 * ε ^ (p_raw + r) ∧
            |inner ℝ ((A_part tid + c_mid • V_part tid) - X_G) (perp2D e_G)| ≤
              250 * ε ^ (q_raw + r)) := by
      intro u d_i
      obtain ⟨hB0, hBA, hA_hi, heD1⟩ := h_pad_adm u d_i
      exact h_compose (j_u u) (hj_pos u)
        (B_pad u d_i) (A_pad u d_i) (e_D_pad u d_i) (V_D_pad u d_i) (A_D_pad u d_i)
        hB0 hBA hA_hi heD1
    choose p_ud q_ud e_G_ud V_G_ud X_G_ud h_ud_spec using h_comp_ud

    let e_G_eq : Fin M_J × Fin M_D ≃ Fin (M_J * M_D) := finProdFinEquiv
    let e_ω : Fin N_ω × Fin M_D ≃ Fin (N_ω * M_D) := finProdFinEquiv
    let b_G : Fin (M_J * M_D) → ℝ := fun g => p_ud (e_G_eq.symm g).1 (e_G_eq.symm g).2
    let a_G : Fin (M_J * M_D) → ℝ := fun g => q_ud (e_G_eq.symm g).1 (e_G_eq.symm g).2
    let e_G_dir : Fin (M_J * M_D) → EuclideanSpace ℝ (Fin 2) :=
      fun g => e_G_ud (e_G_eq.symm g).1 (e_G_eq.symm g).2
    let V_G : Fin (M_J * M_D) → EuclideanSpace ℝ (Fin 2) :=
      fun g => V_G_ud (e_G_eq.symm g).1 (e_G_eq.symm g).2
    let X_G : Fin (M_J * M_D) → EuclideanSpace ℝ (Fin 2) :=
      fun g => X_G_ud (e_G_eq.symm g).1 (e_G_eq.symm g).2
    let k_G : Fin (M_J * M_D) → ℤ :=
      fun g => proj_k (j_u (e_G_eq.symm g).1)

    
    let u_of : Fin N_ω → Fin M_J :=
      fun ω => if h : ∃ u : Fin M_J, J ω = j_u u then Classical.choose h else ⟨0, hMJ⟩
    have hu_of_eq : ∀ ω : Fin N_ω, 0 < π ω → J ω = j_u (u_of ω) := by
      intro ω hω
      have h_ex := hj_cover ω hω
      dsimp only [u_of]
      rw [dif_pos h_ex]
      exact Classical.choose_spec h_ex
    have hu_of_iff : ∀ (ω : Fin N_ω) (u : Fin M_J),
        0 < π ω → (u_of ω = u ↔ J ω = j_u u) := by
      intro ω u hω
      constructor
      · intro hu
        rw [← hu]
        exact hu_of_eq ω hω
      · intro hJ
        apply hj_inj
        rw [← hu_of_eq ω hω, hJ]

    let T' : Fin (N_ω * M_D) → Fin N_T := fun ω' => T_idx (e_ω.symm ω').1
    let k_time' : Fin (N_ω * M_D) → ℤ := fun ω' => k_r (e_ω.symm ω').1
    let G' : Fin (N_ω * M_D) → Fin (M_J * M_D) :=
      fun ω' => e_G_eq (u_of (e_ω.symm ω').1, (e_ω.symm ω').2)
    let π' : Fin (N_ω * M_D) → ℝ := fun ω' =>
      let ω := (e_ω.symm ω').1
      let d_i := (e_ω.symm ω').2
      if 0 < π ω then
        π ω * (q_pad (u_of ω) (T_idx ω) d_i / p_T_u (u_of ω) (T_idx ω))
      else 0

    have hπ'_nn : ∀ ω' : Fin (N_ω * M_D), 0 ≤ π' ω' := by
      intro ω'
      dsimp only [π']
      split_ifs with hω
      · exact mul_nonneg (hπ_nn _) (div_nonneg (hq_pad_nn _ _ _) (hpTu_nn _ _))
      · exact le_rfl

    have hpTu_pos_of_atom : ∀ ω : Fin N_ω, 0 < π ω → 0 < p_T_u (u_of ω) (T_idx ω) := by
      intro ω hω
      have hJω := hu_of_eq ω hω
      have hpTJ_pos : 0 < p_TJ (T_idx ω) (j_u (u_of ω)) := by
        rw [← hJω]
        have h_le := Finset.single_le_sum
          (f := fun ω' => if T_idx ω' = T_idx ω ∧ J ω' = J ω then π ω' else 0)
          (fun ω' _ => by split_ifs; exact hπ_nn ω'; exact le_rfl)
          (Finset.mem_univ ω)
        simp only [and_self, ↓reduceIte] at h_le
        exact lt_of_lt_of_le hω h_le
      rw [hpTJ_eq] at hpTJ_pos
      exact pos_of_mul_pos_right hpTJ_pos (hj_pos (u_of ω)).le

    have h_atom_sum : ∀ ω : Fin N_ω, ∑ d_i : Fin M_D, π' (e_ω (ω, d_i)) = π ω := by
      intro ω
      dsimp only [π']
      simp only [Equiv.symm_apply_apply]
      by_cases hω : 0 < π ω
      · simp only [if_pos hω]
        have hp_pos := hpTu_pos_of_atom ω hω
        rw [← Finset.mul_sum, ← Finset.sum_div, hq_pad_marg,
          div_self (ne_of_gt hp_pos), mul_one]
      · simp only [if_neg hω, Finset.sum_const_zero]
        exact (le_antisymm (le_of_not_gt hω) (hπ_nn ω)).symm

    have h_lift_sum : ∀ f : Fin N_ω → ℝ,
        (∑ ω' : Fin (N_ω * M_D), f (e_ω.symm ω').1 * π' ω') =
          ∑ ω : Fin N_ω, f ω * π ω := by
      intro f
      rw [← e_ω.sum_comp]
      simp only [Equiv.symm_apply_apply]
      rw [Fintype.sum_prod_type]
      refine Finset.sum_congr rfl (fun ω _ => ?_)
      dsimp only []
      rw [← Finset.mul_sum, h_atom_sum ω]

    have hπ'_sum : ∑ ω' : Fin (N_ω * M_D), π' ω' = 1 := by
      have h1 := h_lift_sum (fun _ => 1)
      simp only [one_mul] at h1
      exact h1.trans hπ_sum

    have hpT'_eq : ∀ tid : Fin N_T,
        (∑ ω' : Fin (N_ω * M_D), if T' ω' = tid then π' ω' else 0) = p_T tid := by
      intro tid
      have h1 := h_lift_sum (fun ω => if T_idx ω = tid then 1 else 0)
      have hL : (∑ ω' : Fin (N_ω * M_D),
          (if T_idx (e_ω.symm ω').1 = tid then (1 : ℝ) else 0) * π' ω') =
          ∑ ω' : Fin (N_ω * M_D), if T' ω' = tid then π' ω' else 0 := by
        refine Finset.sum_congr rfl (fun ω' _ => ?_)
        dsimp only [T']
        split_ifs <;> ring
      have hR : (∑ ω : Fin N_ω, (if T_idx ω = tid then (1 : ℝ) else 0) * π ω) = p_T tid := by
        refine Finset.sum_congr rfl (fun ω _ => ?_)
        split_ifs <;> ring
      exact hL.symm.trans (h1.trans hR)

    have h_root_inv :
        classicalRootSupremum ε L_hor γ (N_ω * M_D) N_T π' T' V_part A_part =
          classicalRootSupremum ε L_hor γ N_ω N_T π T_idx V_part A_part := by
      unfold classicalRootSupremum
      have hfun : (fun tid => ∑ ω' : Fin (N_ω * M_D), if T' ω' = tid then π' ω' else 0) = p_T :=
        funext hpT'_eq
      rw [hfun]

    have hpTC'_eq : ∀ (tid : Fin N_T) (k : ℤ),
        (∑ ω' : Fin (N_ω * M_D), if T' ω' = tid ∧ k_time' ω' = k then π' ω' else 0) =
          p_TC tid k := by
      intro tid k
      have h1 := h_lift_sum (fun ω => if T_idx ω = tid ∧ k_r ω = k then 1 else 0)
      have hL : (∑ ω' : Fin (N_ω * M_D),
          (if T_idx (e_ω.symm ω').1 = tid ∧ k_r (e_ω.symm ω').1 = k then (1 : ℝ) else 0) *
            π' ω') =
          ∑ ω' : Fin (N_ω * M_D), if T' ω' = tid ∧ k_time' ω' = k then π' ω' else 0 := by
        refine Finset.sum_congr rfl (fun ω' _ => ?_)
        dsimp only [T', k_time']
        split_ifs <;> ring
      have hR : (∑ ω : Fin N_ω,
          (if T_idx ω = tid ∧ k_r ω = k then (1 : ℝ) else 0) * π ω) = p_TC tid k := by
        refine Finset.sum_congr rfl (fun ω _ => ?_)
        split_ifs <;> ring
      exact hL.symm.trans (h1.trans hR)

    
    let p_TG' : Fin N_T → Fin (M_J * M_D) → ℝ := fun tid g =>
      ∑ ω' : Fin (N_ω * M_D), if T' ω' = tid ∧ G' ω' = g then π' ω' else 0
    let p_G' : Fin (M_J * M_D) → ℝ := fun g =>
      ∑ ω' : Fin (N_ω * M_D), if G' ω' = g then π' ω' else 0

    have hpTG'_eq : ∀ (tid : Fin N_T) (u : Fin M_J) (d_i : Fin M_D),
        p_TG' tid (e_G_eq (u, d_i)) = p_J (j_u u) * q_pad u tid d_i := by
      intro tid u d_i
      dsimp only [p_TG']
      rw [← e_ω.sum_comp]
      simp only [T', G', Equiv.symm_apply_apply, e_G_eq.injective.eq_iff, Prod.mk.injEq]
      rw [Fintype.sum_prod_type]
      have h_collapse : (∑ ω : Fin N_ω, ∑ d' : Fin M_D,
          if T_idx ω = tid ∧ u_of ω = u ∧ d' = d_i then π' (e_ω (ω, d')) else 0) =
          ∑ ω : Fin N_ω, if T_idx ω = tid ∧ u_of ω = u then π' (e_ω (ω, d_i)) else 0 := by
        refine Finset.sum_congr rfl (fun ω _ => ?_)
        by_cases hTu : T_idx ω = tid ∧ u_of ω = u
        · rcases hTu with ⟨hT, hu⟩
          simp only [hT, hu, true_and, if_true]
          rw [Finset.sum_ite_eq' Finset.univ d_i (fun d' => π' (e_ω (ω, d'))),
            if_pos (Finset.mem_univ _)]
        · have h0 : ∀ d' : Fin M_D, ¬ (T_idx ω = tid ∧ u_of ω = u ∧ d' = d_i) := by
            intro d' ⟨h1, h2, _⟩
            exact hTu ⟨h1, h2⟩
          simp only [hTu, if_false, h0, Finset.sum_const_zero]
      rw [h_collapse]
      have h_atom_term : (∑ ω : Fin N_ω,
          if T_idx ω = tid ∧ u_of ω = u then π' (e_ω (ω, d_i)) else 0) =
          p_TJ tid (j_u u) * (q_pad u tid d_i / p_T_u u tid) := by
        dsimp only [p_TJ]
        rw [Finset.sum_mul]
        refine Finset.sum_congr rfl (fun ω _ => ?_)
        dsimp only [π']
        simp only [Equiv.symm_apply_apply]
        by_cases hω : 0 < π ω
        · simp only [if_pos hω]
          have h_iff := hu_of_iff ω u hω
          by_cases hT : T_idx ω = tid
          · by_cases hJ : J ω = j_u u
            · have hu : u_of ω = u := h_iff.mpr hJ
              simp [hT, hu, hJ]
            · have hu : u_of ω ≠ u := fun h => hJ (h_iff.mp h)
              simp [hT, hu, hJ]
          · simp [hT]
        · have hπ0 : π ω = 0 := le_antisymm (le_of_not_gt hω) (hπ_nn ω)
          simp [hω, hπ0]
      rw [h_atom_term, hpTJ_eq u tid]
      by_cases hp0 : p_T_u u tid = 0
      · have hq_sum0 : ∑ d' : Fin M_D, q_pad u tid d' = 0 := (hq_pad_marg u tid).trans hp0
        have hq0 : q_pad u tid d_i = 0 :=
          (Finset.sum_eq_zero_iff_of_nonneg (fun d' _ => hq_pad_nn u tid d')).mp
            hq_sum0 d_i (Finset.mem_univ d_i)
        simp [hp0, hq0]
      · rw [mul_assoc, mul_div_cancel₀ _ hp0]

    have hpG'_eq : ∀ (u : Fin M_J) (d_i : Fin M_D),
        p_G' (e_G_eq (u, d_i)) = p_J (j_u u) * q_D_pad u d_i := by
      intro u d_i
      have h_sum_tid : p_G' (e_G_eq (u, d_i)) =
          ∑ tid : Fin N_T, p_TG' tid (e_G_eq (u, d_i)) := by
        dsimp only [p_G', p_TG']
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl (fun ω' _ => ?_)
        by_cases hG : G' ω' = e_G_eq (u, d_i)
        · simp only [hG, and_true, if_true]
          rw [Finset.sum_ite_eq Finset.univ (T' ω') (fun _ => π' ω'),
            if_pos (Finset.mem_univ _)]
        · simp [hG]
      rw [h_sum_tid]
      simp_rw [hpTG'_eq _ u d_i]
      rw [← Finset.mul_sum]

    
    have h_Ew_lb :
        ((1 + γ) * b_t + (1 - γ) * (b_t + d)) +
          η * (∑ u : Fin M_J, p_J (j_u u) * E_w_pad u) ≤
          ∑ g : Fin (M_J * M_D), p_G' g * ((1 + γ) * b_G g + (1 - γ) * a_G g) := by
      rw [← e_G_eq.sum_comp, Fintype.sum_prod_type]
      have h_rhs : (∑ u : Fin M_J, ∑ d_i : Fin M_D,
          p_G' (e_G_eq (u, d_i)) *
            ((1 + γ) * b_G (e_G_eq (u, d_i)) + (1 - γ) * a_G (e_G_eq (u, d_i)))) =
          ∑ u : Fin M_J, p_J (j_u u) *
            (∑ d_i : Fin M_D, q_D_pad u d_i *
              ((1 + γ) * p_ud u d_i + (1 - γ) * q_ud u d_i)) := by
        refine Finset.sum_congr rfl (fun u _ => ?_)
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl (fun d_i _ => ?_)
        rw [hpG'_eq u d_i]
        dsimp only [b_G, a_G]
        simp only [Equiv.symm_apply_apply]
        ring
      rw [h_rhs]
      have h_lhs : ((1 + γ) * b_t + (1 - γ) * (b_t + d)) +
            η * (∑ u : Fin M_J, p_J (j_u u) * E_w_pad u) =
          ∑ u : Fin M_J, p_J (j_u u) *
            (((1 + γ) * b_t + (1 - γ) * (b_t + d)) + η * E_w_pad u) := by
        rw [Finset.mul_sum]
        have h_add : ∑ u : Fin M_J, p_J (j_u u) *
            (((1 + γ) * b_t + (1 - γ) * (b_t + d)) + η * E_w_pad u) =
            (∑ u : Fin M_J, p_J (j_u u)) * ((1 + γ) * b_t + (1 - γ) * (b_t + d)) +
              ∑ u : Fin M_J, η * (p_J (j_u u) * E_w_pad u) := by
          rw [Finset.sum_mul, ← Finset.sum_add_distrib]
          exact Finset.sum_congr rfl (fun u _ => by ring)
        rw [h_add, hpJu_sum, one_mul]
      rw [h_lhs]
      refine Finset.sum_le_sum (fun u _ => ?_)
      refine mul_le_mul_of_nonneg_left ?_ (hj_pos u).le
      have h_cell : ((1 + γ) * b_t + (1 - γ) * (b_t + d)) + η * E_w_pad u =
          ∑ d_i : Fin M_D, q_D_pad u d_i *
            (((1 + γ) * b_t + (1 - γ) * (b_t + d)) +
              η * ((1 + γ) * B_pad u d_i + (1 - γ) * A_pad u d_i)) := by
        dsimp only [E_w_pad]
        rw [Finset.mul_sum]
        have h1 : ∑ d_i : Fin M_D, q_D_pad u d_i *
            (((1 + γ) * b_t + (1 - γ) * (b_t + d)) +
              η * ((1 + γ) * B_pad u d_i + (1 - γ) * A_pad u d_i)) =
            (∑ d_i : Fin M_D, q_D_pad u d_i) * ((1 + γ) * b_t + (1 - γ) * (b_t + d)) +
              ∑ d_i : Fin M_D, η * (q_D_pad u d_i *
                ((1 + γ) * B_pad u d_i + (1 - γ) * A_pad u d_i)) := by
          rw [Finset.sum_mul, ← Finset.sum_add_distrib]
          exact Finset.sum_congr rfl (fun d_i _ => by ring)
        rw [h1, hqD_pad_sum u, one_mul]
      rw [h_cell]
      exact Finset.sum_le_sum (fun d_i _ =>
        mul_le_mul_of_nonneg_left (h_ud_spec u d_i).2.2.2.2.1 (hqD_pad_nn u d_i))

    have h_St_eq :
        (∑ tid : Fin N_T, ∑ k ∈ Finset.univ.image k_time',
          -((∑ ω' : Fin (N_ω * M_D), if T' ω' = tid ∧ k_time' ω' = k then π' ω' else 0) *
            Real.log ((∑ ω' : Fin (N_ω * M_D), if T' ω' = tid ∧ k_time' ω' = k then π' ω' else 0) /
              (∑ ω' : Fin (N_ω * M_D), if T' ω' = tid then π' ω' else 0)))) /
          Real.log (ε⁻¹) =
        finCondEntropy ε π T_idx k_r := by
      have h_img : Finset.univ.image k_time' = Finset.univ.image k_r := by
        ext k
        simp only [Finset.mem_image, Finset.mem_univ, true_and]
        constructor
        · rintro ⟨ω', rfl⟩
          exact ⟨(e_ω.symm ω').1, rfl⟩
        · rintro ⟨ω, rfl⟩
          refine ⟨e_ω (ω, ⟨0, hMD⟩), ?_⟩
          dsimp only [k_time']
          rw [Equiv.symm_apply_apply]
      rw [h_img]
      simp_rw [hpTC'_eq, hpT'_eq]
      unfold finCondEntropy condSurprise
      have h_prob_eq : ∀ ω : Fin N_ω,
          finProbAt2 π T_idx k_r ω = p_TC (T_idx ω) (k_r ω) ∧
          finProbAt π T_idx ω = p_T (T_idx ω) := by
        intro ω
        constructor
        · unfold finProbAt2
          refine Finset.sum_congr rfl (fun ω' _ => ?_)
          split_ifs <;> first | rfl | (exfalso; tauto)
        · unfold finProbAt
          refine Finset.sum_congr rfl (fun ω' _ => ?_)
          split_ifs <;> first | rfl | (exfalso; tauto)
      have h_rhs_div : (∑ ω : Fin N_ω,
          π ω * (-(Real.log (finProbAt2 π T_idx k_r ω / finProbAt π T_idx ω)) / Real.log (ε⁻¹))) =
          (∑ ω : Fin N_ω, -(π ω * Real.log (p_TC (T_idx ω) (k_r ω) / p_T (T_idx ω)))) /
            Real.log (ε⁻¹) := by
        rw [Finset.sum_div]
        refine Finset.sum_congr rfl (fun ω _ => ?_)
        rw [(h_prob_eq ω).1, (h_prob_eq ω).2]
        ring
      rw [h_rhs_div]
      congr 1
      have h_expand : (∑ tid : Fin N_T, ∑ k ∈ Finset.univ.image k_r,
          -(p_TC tid k * Real.log (p_TC tid k / p_T tid))) =
          ∑ tid : Fin N_T, ∑ ω : Fin N_ω, ∑ k ∈ Finset.univ.image k_r,
            if T_idx ω = tid ∧ k_r ω = k then
              -(π ω * Real.log (p_TC tid k / p_T tid))
            else 0 := by
        refine Finset.sum_congr rfl (fun tid _ => ?_)
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl (fun k _ => ?_)
        have h_in : -(p_TC tid k * Real.log (p_TC tid k / p_T tid)) =
            ∑ ω : Fin N_ω, -( (if T_idx ω = tid ∧ k_r ω = k then π ω else 0) *
              Real.log (p_TC tid k / p_T tid) ) := by
          dsimp only [p_TC]
          rw [Finset.sum_mul, Finset.sum_neg_distrib]
        rw [h_in]
        refine Finset.sum_congr rfl (fun ω _ => ?_)
        split_ifs <;> ring
      rw [h_expand, Finset.sum_comm]
      refine Finset.sum_congr rfl (fun ω _ => ?_)
      have h_in_k : ∀ tid : Fin N_T,
          (∑ k ∈ Finset.univ.image k_r,
            if T_idx ω = tid ∧ k_r ω = k then -(π ω * Real.log (p_TC tid k / p_T tid)) else 0) =
          if T_idx ω = tid then -(π ω * Real.log (p_TC tid (k_r ω) / p_T tid)) else 0 := by
        intro tid
        by_cases hT : T_idx ω = tid
        · simp only [hT, true_and, if_true]
          rw [Finset.sum_ite_eq (Finset.univ.image k_r) (k_r ω)
            (fun k => -(π ω * Real.log (p_TC tid k / p_T tid))),
            if_pos (Finset.mem_image_of_mem k_r (Finset.mem_univ ω))]
        · simp [hT]
      simp_rw [h_in_k]
      rw [Finset.sum_ite_eq Finset.univ (T_idx ω)
        (fun tid => -(π ω * Real.log (p_TC tid (k_r ω) / p_T tid))),
        if_pos (Finset.mem_univ _)]

    have h_MI_coarse :
        (∑ tid : Fin N_T, ∑ u : Fin M_J,
          p_TJ tid (j_u u) * Real.log (p_TJ tid (j_u u) / (p_T tid * p_J (j_u u)))) /
          Real.log (ε⁻¹) =
        finMutualInfo ε π T_idx J := by
      unfold finMutualInfo finCondEntropy condSurprise
      have h_rhs_div :
          (∑ ω : Fin N_ω, π ω *
            (-(Real.log (finProbAt2 π (fun _ => ()) J ω / finProbAt π (fun _ => ()) ω)) /
              Real.log (ε⁻¹))) -
          (∑ ω : Fin N_ω, π ω *
            (-(Real.log (finProbAt2 π T_idx J ω / finProbAt π T_idx ω)) /
              Real.log (ε⁻¹))) =
          (∑ ω : Fin N_ω, π ω *
            (Real.log (finProbAt2 π T_idx J ω / finProbAt π T_idx ω) -
             Real.log (finProbAt2 π (fun _ => ()) J ω / finProbAt π (fun _ => ()) ω))) /
            Real.log (ε⁻¹) := by
        rw [← Finset.sum_sub_distrib, Finset.sum_div]
        refine Finset.sum_congr rfl (fun ω _ => ?_)
        ring
      rw [h_rhs_div]
      congr 1
      have h_expand :
          (∑ tid : Fin N_T, ∑ u : Fin M_J,
            p_TJ tid (j_u u) * Real.log (p_TJ tid (j_u u) / (p_T tid * p_J (j_u u)))) =
          ∑ tid : Fin N_T, ∑ ω : Fin N_ω, ∑ u : Fin M_J,
            if T_idx ω = tid ∧ J ω = j_u u then
              π ω * Real.log (p_TJ tid (j_u u) / (p_T tid * p_J (j_u u)))
            else 0 := by
        refine Finset.sum_congr rfl (fun tid _ => ?_)
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl (fun u _ => ?_)
        dsimp only [p_TJ]
        rw [Finset.sum_mul]
        refine Finset.sum_congr rfl (fun ω _ => ?_)
        split_ifs <;> ring
      rw [h_expand, Finset.sum_comm]
      refine Finset.sum_congr rfl (fun ω _ => ?_)
      by_cases hω : 0 < π ω
      · have h_in_u : ∀ tid : Fin N_T,
            (∑ u : Fin M_J,
              if T_idx ω = tid ∧ J ω = j_u u then
                π ω * Real.log (p_TJ tid (j_u u) / (p_T tid * p_J (j_u u)))
              else 0) =
            if T_idx ω = tid then
              π ω * Real.log (p_TJ tid (J ω) / (p_T tid * p_J (J ω)))
            else 0 := by
          intro tid
          by_cases hT : T_idx ω = tid
          · simp only [hT, true_and, if_true]
            have h_u_rew : ∀ u : Fin M_J,
                (if J ω = j_u u then
                  π ω * Real.log (p_TJ tid (j_u u) / (p_T tid * p_J (j_u u)))
                else 0) =
                if u_of ω = u then
                  π ω * Real.log (p_TJ tid (J ω) / (p_T tid * p_J (J ω)))
                else 0 := by
              intro u
              have h_iff := hu_of_iff ω u hω
              by_cases hJ : J ω = j_u u
              · have hu : u_of ω = u := h_iff.mpr hJ
                simp [hJ, hu]
              · have hu : u_of ω ≠ u := fun h => hJ (h_iff.mp h)
                simp [hJ, hu]
            simp_rw [h_u_rew]
            rw [Finset.sum_ite_eq Finset.univ (u_of ω) _, if_pos (Finset.mem_univ _)]
          · simp [hT]
        simp_rw [h_in_u]
        rw [Finset.sum_ite_eq Finset.univ (T_idx ω) _, if_pos (Finset.mem_univ _)]
        have hp1 : finProbAt π (fun _ => ()) ω = 1 := by
          unfold finProbAt
          simp [hπ_sum]
        have hpJ_ω : finProbAt2 π (fun _ => ()) J ω = p_J (J ω) := by
          unfold finProbAt2
          refine Finset.sum_congr rfl (fun ω' _ => ?_)
          split_ifs <;> first | rfl | (exfalso; tauto)
        have hpT_ω : finProbAt π T_idx ω = p_T (T_idx ω) := by
          unfold finProbAt
          refine Finset.sum_congr rfl (fun ω' _ => ?_)
          split_ifs <;> first | rfl | (exfalso; tauto)
        have hpTJ_ω : finProbAt2 π T_idx J ω = p_TJ (T_idx ω) (J ω) := by
          unfold finProbAt2
          refine Finset.sum_congr rfl (fun ω' _ => ?_)
          split_ifs <;> first | rfl | (exfalso; tauto)
        rw [hp1, hpJ_ω, hpT_ω, hpTJ_ω, div_one]
        have hpJ_pos_ω : 0 < p_J (J ω) := h_pJ_of_pos ω hω
        have hpTJ_pos_ω : 0 < p_TJ (T_idx ω) (J ω) := by
          have h_le := Finset.single_le_sum
            (f := fun ω' => if T_idx ω' = T_idx ω ∧ J ω' = J ω then π ω' else 0)
            (fun ω' _ => by split_ifs; exact hπ_nn ω'; exact le_rfl)
            (Finset.mem_univ ω)
          simp only [and_self, ↓reduceIte] at h_le
          exact lt_of_lt_of_le hω h_le
        have hpT_pos_ω : 0 < p_T (T_idx ω) := by
          have h_le := Finset.single_le_sum
            (f := fun ω' => if T_idx ω' = T_idx ω then π ω' else 0)
            (fun ω' _ => by split_ifs; exact hπ_nn ω'; exact le_rfl)
            (Finset.mem_univ ω)
          simp only [↓reduceIte] at h_le
          exact lt_of_lt_of_le hω h_le
        rw [← Real.log_div (ne_of_gt (div_pos hpTJ_pos_ω hpT_pos_ω)) (ne_of_gt hpJ_pos_ω),
          div_div]
      · have hπ0 : π ω = 0 := le_antisymm (le_of_not_gt hω) (hπ_nn ω)
        simp [hπ0]

    have h_ITG_eq :
        (∑ tid : Fin N_T, ∑ g : Fin (M_J * M_D),
          p_TG' tid g * Real.log (p_TG' tid g /
            ((∑ ω' : Fin (N_ω * M_D), if T' ω' = tid then π' ω' else 0) * p_G' g))) /
          Real.log (ε⁻¹) =
        finMutualInfo ε π T_idx J +
          η * (∑ u : Fin M_J, p_J (j_u u) * I_TD_pad u) := by
      simp_rw [hpT'_eq]
      have h_num_split :
          (∑ tid : Fin N_T, ∑ g : Fin (M_J * M_D),
            p_TG' tid g * Real.log (p_TG' tid g / (p_T tid * p_G' g))) =
          (∑ tid : Fin N_T, ∑ u : Fin M_J,
            p_J (j_u u) * ∑ d_i : Fin M_D,
              q_pad u tid d_i * Real.log (q_pad u tid d_i / (p_T_u u tid * q_D_pad u d_i))) +
          (∑ tid : Fin N_T, ∑ u : Fin M_J,
            p_TJ tid (j_u u) * Real.log (p_TJ tid (j_u u) / (p_T tid * p_J (j_u u)))) := by
        rw [← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl (fun tid _ => ?_)
        rw [← e_G_eq.sum_comp, Fintype.sum_prod_type, ← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl (fun u _ => ?_)
        have h_d_sum :
            (∑ d_i : Fin M_D,
              p_TG' tid (e_G_eq (u, d_i)) *
                Real.log (p_TG' tid (e_G_eq (u, d_i)) /
                  (p_T tid * p_G' (e_G_eq (u, d_i))))) =
            ∑ d_i : Fin M_D,
              (p_J (j_u u) *
                (q_pad u tid d_i * Real.log (q_pad u tid d_i / (p_T_u u tid * q_D_pad u d_i))) +
               (p_J (j_u u) * q_pad u tid d_i) *
                Real.log (p_TJ tid (j_u u) / (p_T tid * p_J (j_u u)))) := by
          refine Finset.sum_congr rfl (fun d_i _ => ?_)
          rw [hpTG'_eq tid u d_i, hpG'_eq u d_i]
          by_cases hq_pos : 0 < q_pad u tid d_i
          · have hpJu_pos : 0 < p_J (j_u u) := hj_pos u
            have hpTu_pos : 0 < p_T_u u tid := by
              have h_le : q_pad u tid d_i ≤ ∑ d' : Fin M_D, q_pad u tid d' :=
                Finset.single_le_sum (fun d' _ => hq_pad_nn u tid d') (Finset.mem_univ d_i)
              rw [hq_pad_marg u tid] at h_le
              exact lt_of_lt_of_le hq_pos h_le
            have hqD_pos : 0 < q_D_pad u d_i := by
              have h_le : q_pad u tid d_i ≤ ∑ tid' : Fin N_T, q_pad u tid' d_i :=
                Finset.single_le_sum (fun tid' _ => hq_pad_nn u tid' d_i) (Finset.mem_univ tid)
              exact lt_of_lt_of_le hq_pos h_le
            have hpTJ_pos : 0 < p_TJ tid (j_u u) := by
              rw [hpTJ_eq u tid]
              exact mul_pos hpJu_pos hpTu_pos
            have hpT_pos : 0 < p_T tid := by
              have h_le : p_TJ tid (j_u u) ≤ p_T tid := by
                refine Finset.sum_le_sum (fun ω _ => ?_)
                by_cases hT : T_idx ω = tid
                · by_cases hJ : J ω = j_u u <;> simp [hT, hJ, hπ_nn ω]
                · simp [hT]
              exact lt_of_lt_of_le hpTJ_pos h_le
            have h_frac :
                (p_J (j_u u) * q_pad u tid d_i) /
                  (p_T tid * (p_J (j_u u) * q_D_pad u d_i)) =
                (q_pad u tid d_i / (p_T_u u tid * q_D_pad u d_i)) *
                  (p_TJ tid (j_u u) / (p_T tid * p_J (j_u u))) := by
              rw [hpTJ_eq u tid]
              have h1 : p_J (j_u u) ≠ 0 := ne_of_gt hpJu_pos
              have h2 : p_T_u u tid ≠ 0 := ne_of_gt hpTu_pos
              have h3 : q_D_pad u d_i ≠ 0 := ne_of_gt hqD_pos
              have h4 : p_T tid ≠ 0 := ne_of_gt hpT_pos
              field_simp [h1, h2, h3, h4]
            have hf1_ne : q_pad u tid d_i / (p_T_u u tid * q_D_pad u d_i) ≠ 0 :=
              ne_of_gt (div_pos hq_pos (mul_pos hpTu_pos hqD_pos))
            have hf2_ne : p_TJ tid (j_u u) / (p_T tid * p_J (j_u u)) ≠ 0 :=
              ne_of_gt (div_pos hpTJ_pos (mul_pos hpT_pos hpJu_pos))
            rw [h_frac, Real.log_mul hf1_ne hf2_ne]
            ring
          · have hq0 : q_pad u tid d_i = 0 :=
              le_antisymm (le_of_not_gt hq_pos) (hq_pad_nn u tid d_i)
            simp [hq0]
        rw [h_d_sum, Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.sum_mul,
          ← Finset.mul_sum, hq_pad_marg u tid, ← hpTJ_eq u tid]
      rw [h_num_split, add_div, h_MI_coarse, add_comm]
      congr 1
      rw [Finset.sum_comm]
      have h_u_sum :
          (∑ u : Fin M_J, ∑ tid : Fin N_T,
            p_J (j_u u) * ∑ d_i : Fin M_D,
              q_pad u tid d_i * Real.log (q_pad u tid d_i / (p_T_u u tid * q_D_pad u d_i))) /
            Real.log (ε⁻¹) =
          η * ∑ u : Fin M_J, p_J (j_u u) * I_TD_pad u := by
        rw [Finset.mul_sum, Finset.sum_div]
        refine Finset.sum_congr rfl (fun u _ => ?_)
        rw [← Finset.mul_sum]
        dsimp only [I_TD_pad]
        rw [hell_tilde_eq]
        have h1 : η ≠ 0 := ne_of_gt hη_pos
        have h2 : Real.log (ε⁻¹) ≠ 0 := ne_of_gt hell_pos
        field_simp [h1, h2]
      exact h_u_sum

    
    have hεr_pos : 0 < ε ^ r := Real.rpow_pos_of_pos hε₀ r
    have hΔr_lo_250 : (250 : ℝ)⁻¹ * ε ^ r ≤ Δ_r := by
      have h1 : (250 : ℝ)⁻¹ * ε ^ r ≤ (1 / 2 : ℝ) * ε ^ r :=
        mul_le_mul_of_nonneg_right (by norm_num) hεr_pos.le
      exact le_trans h1 hΔr_lo
    have hΔr_hi_250 : Δ_r ≤ 250 * ε ^ r := by
      have h1 : ε ^ r ≤ 250 * ε ^ r := by linarith
      exact le_trans hΔr_hi h1
    have hVA_250 : ∀ tid : Fin N_T, ‖V_part tid‖ ≤ 250 ∧ ‖A_part tid‖ ≤ 250 := by
      intro tid
      exact ⟨le_trans (hVA tid).1 (by norm_num), le_trans (hVA tid).2 (by norm_num)⟩
    have hG_adm : ∀ g : Fin (M_J * M_D),
        0 ≤ b_G g ∧ b_G g ≤ a_G g ∧ a_G g + r ≤ L_hor ∧ ‖e_G_dir g‖ = 1 := by
      intro g
      obtain ⟨h1, h2, h3, h4, _, _⟩ := h_ud_spec (e_G_eq.symm g).1 (e_G_eq.symm g).2
      exact ⟨h1, h2, h3, h4⟩
    have h_supp_glued : ∀ ω' : Fin (N_ω * M_D), 0 < π' ω' →
        let tid := T' ω'
        let g := G' ω'
        let c_mid := ((k_time' ω' : ℝ) + 1 / 2) * Δ_r
        c_mid ∈ Set.Icc (0 : ℝ) 1 ∧
        k_G g = k_time' ω' ∧
        |inner ℝ (V_part tid - V_G g) (e_G_dir g)| ≤ 250 * ε ^ (b_G g) ∧
        |inner ℝ (V_part tid - V_G g) (perp2D (e_G_dir g))| ≤ 250 * ε ^ (a_G g) ∧
        |inner ℝ ((A_part tid + c_mid • V_part tid) - X_G g) (e_G_dir g)| ≤
          250 * ε ^ (b_G g + r) ∧
        |inner ℝ ((A_part tid + c_mid • V_part tid) - X_G g) (perp2D (e_G_dir g))| ≤
          250 * ε ^ (a_G g + r) := by
      intro ω' hπ'_pos
      set ω := (e_ω.symm ω').1
      set d_i := (e_ω.symm ω').2
      set u := u_of ω
      have hω_pos : 0 < π ω := by
        dsimp only [π'] at hπ'_pos
        by_contra h_not
        rw [if_neg h_not] at hπ'_pos
        exact lt_irrefl 0 hπ'_pos
      have hq_pos : 0 < q_pad u (T_idx ω) d_i := by
        dsimp only [π'] at hπ'_pos
        rw [if_pos hω_pos] at hπ'_pos
        by_contra h_not
        have hq0 : q_pad u (T_idx ω) d_i = 0 :=
          le_antisymm (le_of_not_gt h_not) (hq_pad_nn u (T_idx ω) d_i)
        change 0 < π ω * (q_pad u (T_idx ω) d_i / p_T_u u (T_idx ω)) at hπ'_pos
        rw [hq0, zero_div, mul_zero] at hπ'_pos
        exact lt_irrefl 0 hπ'_pos
      have hJω : J ω = j_u u := hu_of_eq ω hω_pos
      obtain ⟨hc_mid_mem, hproj_eq⟩ := h_kr_supp ω hω_pos
      obtain ⟨hv1, hv2, ha1, ha2⟩ := hq_pad_cap u (T_idx ω) d_i hq_pos
      have h_caps := (h_ud_spec u d_i).2.2.2.2.2 ω hω_pos hJω hv1 hv2 ha1 ha2
      dsimp only [T', k_time', G', b_G, a_G, e_G_dir, V_G, X_G, k_G]
      simp only [Equiv.symm_apply_apply]
      refine ⟨hc_mid_mem, ?_, h_caps.1, h_caps.2.1, h_caps.2.2.1, h_caps.2.2.2⟩
      rw [← hJω]
      exact hproj_eq

    have h_global_est := h_growth ε r L_hor Δ_r hε₀ hε_lt le_rfl
      (le_trans hrt.le htL) (le_max_right 1 L_hor) hΔr_lo_250 hΔr_hi_250
      (N_ω * M_D) N_T (M_J * M_D) π' T' k_time' G' V_part A_part
      b_G a_G e_G_dir V_G X_G k_G
      hπ'_nn hπ'_sum hVA_250 hG_adm h_supp_glued

    
    have h_ts_lb :
        (((1 + γ) * b_t + (1 - γ) * (b_t + d)) -
          finMutualInfo ε π T_idx J +
          2 * finCondEntropy ε π T_idx k_r) +
        η * (∑ j ∈ S_J, p_J j *
          classicalRootSupremum ε_tilde (1 + e_loc) γ N_ω N_T (π_j j) T_idx
            (V_loc j) (A_loc j)) -
        (1 / 3 : ℝ) * δ_cl * η ≤
        classicalTransportScore ε γ (N_ω * M_D) N_T (M_J * M_D) π' T' k_time' G' b_G a_G := by
      unfold classicalTransportScore
      dsimp only []
      rw [h_ITG_eq, h_St_eq]
      have h_sum_τ : ∑ j ∈ S_J, p_J j *
          classicalRootSupremum ε_tilde (1 + e_loc) γ N_ω N_T (π_j j) T_idx
            (V_loc j) (A_loc j) =
          ∑ u : Fin M_J, p_J (j_u u) * τ_u u :=
        h_sum_SJ (fun j => classicalRootSupremum ε_tilde (1 + e_loc) γ N_ω N_T (π_j j) T_idx
          (V_loc j) (A_loc j))
      rw [h_sum_τ]
      have h_loc_diff :
          (∑ u : Fin M_J, p_J (j_u u) * τ_u u) - (1 / 3 : ℝ) * δ_cl ≤
          (∑ u : Fin M_J, p_J (j_u u) * E_w_pad u) -
          (∑ u : Fin M_J, p_J (j_u u) * I_TD_pad u) := by
        have hL : (∑ u : Fin M_J, p_J (j_u u) * τ_u u) - (1 / 3 : ℝ) * δ_cl =
            ∑ u : Fin M_J, p_J (j_u u) * (τ_u u - (1 / 3 : ℝ) * δ_cl) := by
          have h1 : ∑ u : Fin M_J, p_J (j_u u) * (τ_u u - (1 / 3 : ℝ) * δ_cl) =
              (∑ u : Fin M_J, p_J (j_u u) * τ_u u) -
                (∑ u : Fin M_J, p_J (j_u u)) * ((1 / 3 : ℝ) * δ_cl) := by
            rw [Finset.sum_mul, ← Finset.sum_sub_distrib]
            exact Finset.sum_congr rfl (fun u _ => by ring)
          rw [h1, hpJu_sum, one_mul]
        have hR : (∑ u : Fin M_J, p_J (j_u u) * E_w_pad u) -
            (∑ u : Fin M_J, p_J (j_u u) * I_TD_pad u) =
            ∑ u : Fin M_J, p_J (j_u u) * (E_w_pad u - I_TD_pad u) := by
          rw [← Finset.sum_sub_distrib]
          exact Finset.sum_congr rfl (fun u _ => by ring)
        rw [hL, hR]
        exact Finset.sum_le_sum (fun u _ =>
          mul_le_mul_of_nonneg_left (h_pad_score u) (hj_pos u).le)
      have h_eta_diff := mul_le_mul_of_nonneg_left h_loc_diff hη_pos.le
      change _ ≤ (∑ g : Fin (M_J * M_D),
          p_G' g * ((1 + γ) * b_G g + (1 - γ) * a_G g)) -
        (finMutualInfo ε π T_idx J + η * ∑ u : Fin M_J, p_J (j_u u) * I_TD_pad u) +
        2 * finCondEntropy ε π T_idx k_r
      linarith [h_Ew_lb, h_eta_diff]

    have h_rate_slack :
        (b_comp + δ_cl'') * r ≤ classicalGrowthRate γ * r + (1 / 3 : ℝ) * δ_cl * η := by
      have h_mul : (b_comp + δ_cl'') * r ≤ (classicalGrowthRate γ + 2 * δ_cl'') * r :=
        mul_le_mul_of_nonneg_right (by linarith) hr₀.le
      have h_2δ : 2 * δ_cl'' * r = (1 / 3 : ℝ) * δ_cl * η := by
        dsimp only [δ_cl'', η]
        have hr_ne : r ≠ 0 := ne_of_gt hr₀
        field_simp [hr_ne]
        ring
      linarith

    rw [h_root_inv] at h_global_est
    linarith [h_ts_lb, h_global_est, h_rate_slack]

theorem anisotropic_cell_localization_deficit_bound (γ r t L_hor δ_cl : ℝ)
    (hγ₀ : 0 < γ) (hγ₁ : γ < 1)
    (h_two : (2 : ℝ) ∈ ValidClassicalGrowthRates γ)
    (hr₀ : 0 < r) (hrt : r < t) (ht₁ : t ≤ 1)
    (htL : t ≤ L_hor) (hδ : 0 < δ_cl) :
    ∃ ε_loc₀ : ℝ, 0 < ε_loc₀ ∧ ε_loc₀ < 1 / 2 ∧
      ∀ (ε b_t a_t d : ℝ),
        0 < ε → ε < ε_loc₀ → ε ^ (t - r) < 1 / 2 →
        0 ≤ b_t → b_t ≤ a_t → a_t + t ≤ L_hor →
        0 ≤ d → d ≤ a_t - b_t →
      ∀ {N_ω N_T : ℕ}
        (π : Fin N_ω → ℝ)
        (T_idx : Fin N_ω → Fin N_T)
        (V_part A_part : Fin N_T → EuclideanSpace ℝ (Fin 2))
        (c_s θ_s : Fin N_ω → ℝ),
        (∀ ω, 0 ≤ π ω) → (∑ ω : Fin N_ω, π ω = 1) →
        (∀ tid, ‖V_part tid‖ ≤ 1 ∧ ‖A_part tid‖ ≤ 1) →
        (∀ ω, 0 < π ω → c_s ω ∈ Set.Icc (0 : ℝ) 1 ∧ θ_s ω ∈ Set.Ico (0 : ℝ) Real.pi) →
        let η := t - r
        let ε_tilde := ε ^ η
        let e_loc := (a_t - b_t - d) / η
        let J := fun ω : Fin N_ω =>
          stdApertureObs ε r b_t (b_t + d) (V_part (T_idx ω)) (A_part (T_idx ω)) (c_s ω) (θ_s ω)
        let S_J : Finset (ℤ × ℤ × ℤ × ℤ × ℤ × ℤ) := Finset.univ.image J
        let p_J := fun j => ∑ ω : Fin N_ω, if J ω = j then π ω else 0
        let ζ := finCondEntropy ε π (fun ω => (T_idx ω, dyadicTimeBin ε r (c_s ω))) J
        let Δ_glob := classicalGrowthRate γ * t +
          classicalRootSupremum ε L_hor γ N_ω N_T π T_idx V_part A_part -
          stdApertureScore ε γ t b_t a_t π T_idx V_part A_part c_s θ_s
        let Δ_loc := fun j : ℤ × ℤ × ℤ × ℤ × ℤ × ℤ =>
          let π_j := restrictLaw π (Finset.univ.filter (fun ω => J ω = j))
          let V_j := fun tid => locCellVel ε r b_t d j (V_part tid)
          let A_j := fun tid => locCellPos ε r b_t d j (V_part tid) (A_part tid)
          let c_loc := fun ω => locTime ε r (c_s ω)
          let θ_loc := fun ω => locTheta ε (a_t - b_t) d (θ_s ω)
          classicalGrowthRate γ +
            classicalRootSupremum ε_tilde (1 + e_loc) γ N_ω N_T π_j T_idx V_j A_j -
            stdApertureScore ε_tilde γ 1 0 e_loc π_j T_idx V_j A_j c_loc θ_loc
        finCondEntropy ε π (fun ω => (T_idx ω, dyadicTimeBin ε r (c_s ω))) J ≤
          finCondEntropy ε π (fun ω => (T_idx ω, dyadicTimeBin ε r (c_s ω)))
            (fun ω => angBin ε d (θ_s ω)) ∧
        (∀ tid j, ‖locCellVel ε r b_t d j (V_part tid)‖ ≤ 1 ∧
          ‖locCellPos ε r b_t d j (V_part tid) (A_part tid)‖ ≤ 1) ∧
        (∀ ω, 0 < π ω →
          locTime ε r (c_s ω) ∈ Set.Icc (0 : ℝ) 1 ∧
          locTheta ε (a_t - b_t) d (θ_s ω) ∈ Set.Ico (0 : ℝ) Real.pi) ∧
        (∀ j ∈ S_J, 0 < p_J j → -δ_cl ≤ Δ_loc j) ∧
        ∑ j ∈ S_J, p_J j * Δ_loc j ≤ (Δ_glob + 2 * ζ) / η + δ_cl :=
by
  obtain ⟨⟨ε₀', hε₀'_pos, _, h_loc_univ⟩, ⟨ε₀'', hε₀''_pos, _, h_root_glue⟩⟩ :=
    cell_root_competitor_gluing_and_local_lower_bound γ r t L_hor δ_cl
      hγ₀ hγ₁ h_two hr₀ hrt htL hδ
  have hη₀_pos : 0 < t - r := sub_pos.mpr hrt
  let δ_third : ℝ := (1 / 3 : ℝ) * δ_cl * (t - r)
  have hδ_third_pos : 0 < δ_third := by positivity
  let ε_exp : ℝ := Real.exp (-(Real.log (384000000 : ℝ) / δ_third))
  let ε_loc₀ : ℝ := min (1 / 4) (min (ε₀' ^ (1 / (t - r))) (min ε₀'' ε_exp))
  have hε_loc₀_pos : 0 < ε_loc₀ := by
    refine lt_min (by norm_num) (lt_min ?_ (lt_min hε₀''_pos (Real.exp_pos _)))
    exact Real.rpow_pos_of_pos hε₀'_pos _
  have hε_loc₀_half : ε_loc₀ < 1 / 2 :=
    lt_of_le_of_lt (min_le_left _ _) (by norm_num)
  refine ⟨ε_loc₀, hε_loc₀_pos, hε_loc₀_half, ?_⟩
  intro ε b_t a_t d hε₀ hε_loc hε_tilde hb₀ hba hatL hd₀ hda N_ω N_T π T_idx V_part A_part c_s θ_s
    hπ_nn hπ_sum hVA hcθ η ε_tilde e_loc J S_J p_J ζ Δ_glob Δ_loc

  have hη_pos : 0 < η := hη₀_pos
  have hε_lt_quarter : ε < 1 / 4 := lt_of_lt_of_le hε_loc (min_le_left _ _)
  have hε₁ : ε < 1 / 2 := lt_trans hε_lt_quarter (by norm_num)
  have hε_lt_rpow : ε < ε₀' ^ (1 / η) :=
    lt_of_lt_of_le hε_loc (le_trans (min_le_right _ _) (min_le_left _ _))
  have hε_lt_two : ε < ε₀'' :=
    lt_of_lt_of_le hε_loc
      (le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_left _ _)))
  have hε_lt_exp : ε < ε_exp :=
    lt_of_lt_of_le hε_loc
      (le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_right _ _)))

  have hε_tilde_pos : 0 < ε_tilde := Real.rpow_pos_of_pos hε₀ η
  have hε_tilde_lt : ε_tilde < ε₀' := by
    calc ε_tilde = ε ^ η := rfl
      _ < (ε₀' ^ (1 / η)) ^ η := Real.rpow_lt_rpow hε₀.le hε_lt_rpow hη_pos
      _ = ε₀' ^ ((1 / η) * η) := (Real.rpow_mul hε₀'_pos.le _ _).symm
      _ = ε₀' ^ (1 : ℝ) := by rw [one_div_mul_cancel (ne_of_gt hη_pos)]
      _ = ε₀' := Real.rpow_one ε₀'

  have h_log_inv_pos : 0 < Real.log (ε⁻¹) := by
    have hε_lt1 : ε < 1 := lt_trans hε₁ (by norm_num)
    have hlog_neg : Real.log ε < 0 := Real.log_neg hε₀ hε_lt1
    rw [Real.log_inv]
    linarith

  have h_log_err : Real.log (384000000 : ℝ) / Real.log (ε⁻¹) ≤ (1 / 3 : ℝ) * δ_cl * η := by
    have hlog_lt : Real.log ε < -(Real.log (384000000 : ℝ) / δ_third) :=
      (Real.log_lt_iff_lt_exp hε₀).mpr hε_lt_exp
    have h_mul : δ_third * Real.log ε < -(Real.log (384000000 : ℝ)) := by
      have h1 := mul_lt_mul_of_pos_left hlog_lt hδ_third_pos
      have h_eq : δ_third * -(Real.log (384000000 : ℝ) / δ_third) =
          -(Real.log (384000000 : ℝ)) := by
        field_simp [ne_of_gt hδ_third_pos]
      rwa [h_eq] at h1
    rw [div_le_iff₀ h_log_inv_pos, Real.log_inv]
    dsimp only [δ_third, η] at h_mul ⊢
    linarith

  obtain ⟨h_ang_norm, h_loc_ball, h_loc_dom, ⟨hΔr_lo, hΔr_hi⟩, h_inv_traj,
      ⟨F_fwd, F_time, hFfwd_card, hFtime_card, hF_mem⟩⟩ :=
    cell_localization_geometry_and_forward_fibers ε r t b_t a_t d
      hε₀ hε₁ hr₀ hrt ht₁ hε_tilde hb₀ hba hd₀ hda

  
  have h_conj1 :
      finCondEntropy ε π (fun ω => (T_idx ω, dyadicTimeBin ε r (c_s ω))) J ≤
        finCondEntropy ε π (fun ω => (T_idx ω, dyadicTimeBin ε r (c_s ω)))
          (fun ω => angBin ε d (θ_s ω)) := by
    let B_fn : Fin N_ω → Fin N_T × ℤ := fun ω => (T_idx ω, dyadicTimeBin ε r (c_s ω))
    let K_ang : Fin N_ω → ℤ := fun ω => angBin ε d (θ_s ω)
    suffices h_eq : finCondEntropy ε π B_fn J = finCondEntropy ε π B_fn K_ang by
      exact le_of_eq h_eq
    unfold finCondEntropy condSurprise
    refine Finset.sum_congr rfl (fun ω _ => ?_)
    have h_prob2 : finProbAt2 π B_fn J ω = finProbAt2 π B_fn K_ang ω := by
      unfold finProbAt2
      refine Finset.sum_congr rfl (fun ω' _ => ?_)
      have h_iff : (B_fn ω' = B_fn ω ∧ J ω' = J ω) ↔ (B_fn ω' = B_fn ω ∧ K_ang ω' = K_ang ω) := by
        constructor
        · rintro ⟨hB, hJ⟩
          refine ⟨hB, ?_⟩
          have h21 : (J ω').2.1 = (J ω).2.1 := congr_arg (fun q => q.2.1) hJ
          dsimp only [J, stdApertureObs, K_ang] at h21 ⊢
          rwa [add_sub_cancel_left] at h21
        · rintro ⟨hB, hK⟩
          refine ⟨hB, ?_⟩
          have hT : T_idx ω' = T_idx ω := congr_arg Prod.fst hB
          have hk : dyadicTimeBin ε r (c_s ω') = dyadicTimeBin ε r (c_s ω) :=
            congr_arg Prod.snd hB
          have hm : dyadicTimeMid ε r (c_s ω') = dyadicTimeMid ε r (c_s ω) := by
            unfold dyadicTimeMid
            rw [hk]
          dsimp only [J, stdApertureObs]
          dsimp only [K_ang] at hK
          rw [add_sub_cancel_left, hT, hk, hm, hK]
      split_ifs <;> first | rfl | (exfalso; tauto)
    rw [h_prob2]

  
  have h_conj2 : ∀ tid j,
      ‖locCellVel ε r b_t d j (V_part tid)‖ ≤ 1 ∧
      ‖locCellPos ε r b_t d j (V_part tid) (A_part tid)‖ ≤ 1 :=
    fun tid j => h_loc_ball (V_part tid) (A_part tid) j

  have h_conj3 : ∀ ω, 0 < π ω →
      locTime ε r (c_s ω) ∈ Set.Icc (0 : ℝ) 1 ∧
      locTheta ε (a_t - b_t) d (θ_s ω) ∈ Set.Ico (0 : ℝ) Real.pi :=
    fun ω hω => h_loc_dom (c_s ω) (θ_s ω) (hcθ ω hω).1

  
  have he_loc_nn : 0 ≤ e_loc := div_nonneg (sub_nonneg.mpr hda) hη_pos.le
  have he_loc_hi : 1 + e_loc ≤ 1 + L_hor / (t - r) := by
    have ht_pos : 0 < t := lt_trans hr₀ hrt
    have h_num_le : a_t - b_t - d ≤ L_hor := by linarith
    have h_div_le : (a_t - b_t - d) / (t - r) ≤ L_hor / (t - r) :=
      div_le_div_of_nonneg_right h_num_le hη₀_pos.le
    dsimp only [e_loc, η]
    linarith

  have h_conj4 : ∀ j ∈ S_J, 0 < p_J j → -δ_cl ≤ Δ_loc j := by
    intro j _ hpj
    let S_f : Finset (Fin N_ω) := Finset.univ.filter (fun ω => J ω = j)
    have hSf_sum : ∑ ω ∈ S_f, π ω = p_J j := by
      dsimp only [S_f, p_J]
      rw [Finset.sum_filter]
    have hSf_pos : 0 < ∑ ω ∈ S_f, π ω := by rwa [hSf_sum]
    let π_j := restrictLaw π S_f
    have hπj_nn : ∀ ω, 0 ≤ π_j ω := by
      intro ω
      dsimp only [π_j, restrictLaw]
      split_ifs
      · exact div_nonneg (hπ_nn ω) hSf_pos.le
      · exact le_rfl
    have hπj_sum : ∑ ω : Fin N_ω, π_j ω = 1 := by
      dsimp only [π_j, restrictLaw]
      rw [Finset.sum_ite_mem, Finset.univ_inter, ← Finset.sum_div, div_self (ne_of_gt hSf_pos)]
    have hπj_supp : ∀ ω, 0 < π_j ω →
        locTime ε r (c_s ω) ∈ Set.Icc (0 : ℝ) 1 ∧
        locTheta ε (a_t - b_t) d (θ_s ω) ∈ Set.Ico (0 : ℝ) Real.pi := by
      intro ω h_pos
      refine h_conj3 ω ?_
      dsimp only [π_j, restrictLaw] at h_pos
      split_ifs at h_pos with hω
      · by_contra h_le
        have h0 : π ω = 0 := le_antisymm (le_of_not_gt h_le) (hπ_nn ω)
        rw [h0, zero_div] at h_pos
        exact lt_irrefl 0 h_pos
      · exact absurd h_pos (lt_irrefl 0)
    have h_univ_j := h_loc_univ ε_tilde e_loc hε_tilde_pos hε_tilde_lt he_loc_nn he_loc_hi
      π_j T_idx
      (fun tid => locCellVel ε r b_t d j (V_part tid))
      (fun tid => locCellPos ε r b_t d j (V_part tid) (A_part tid))
      (fun ω => locTime ε r (c_s ω))
      (fun ω => locTheta ε (a_t - b_t) d (θ_s ω))
      hπj_nn hπj_sum (fun tid => h_conj2 tid j) hπj_supp
    dsimp only [Δ_loc, π_j, S_f] at h_univ_j ⊢
    linarith

  
  have h_conj5 : ∑ j ∈ S_J, p_J j * Δ_loc j ≤ (Δ_glob + 2 * ζ) / η + δ_cl := by
    let K_r : Fin N_ω → ℤ := fun ω => dyadicTimeBin ε r (c_s ω)
    let K_t : Fin N_ω → ℤ := fun ω => dyadicTimeBin ε t (c_s ω)
    let c_loc : Fin N_ω → ℝ := fun ω => locTime ε r (c_s ω)
    let θ_loc : Fin N_ω → ℝ := fun ω => locTheta ε (a_t - b_t) d (θ_s ω)
    let K_loc : Fin N_ω → ℤ := fun ω => dyadicTimeBin ε_tilde 1 (c_loc ω)
    let V_loc : (ℤ × ℤ × ℤ × ℤ × ℤ × ℤ) → Fin N_T → EuclideanSpace ℝ (Fin 2) :=
      fun j tid => locCellVel ε r b_t d j (V_part tid)
    let A_loc : (ℤ × ℤ × ℤ × ℤ × ℤ × ℤ) → Fin N_T → EuclideanSpace ℝ (Fin 2) :=
      fun j tid => locCellPos ε r b_t d j (V_part tid) (A_part tid)
    let G_t : Fin N_ω → ℤ × ℤ × ℤ × ℤ × ℤ × ℤ := fun ω =>
      stdApertureObs ε t b_t a_t (V_part (T_idx ω)) (A_part (T_idx ω)) (c_s ω) (θ_s ω)
    let G_loc : (ℤ × ℤ × ℤ × ℤ × ℤ × ℤ) → Fin N_ω → ℤ × ℤ × ℤ × ℤ × ℤ × ℤ := fun j ω =>
      stdApertureObs ε_tilde 1 0 e_loc (V_loc j (T_idx ω)) (A_loc j (T_idx ω))
        (c_loc ω) (θ_loc ω)
    let π_j_fn : (ℤ × ℤ × ℤ × ℤ × ℤ × ℤ) → Fin N_ω → ℝ :=
      fun j => restrictLaw π (Finset.univ.filter (fun ω => J ω = j))

    have hpJ_sum : ∑ j ∈ S_J, p_J j = 1 := by
      have h1 : ∑ j ∈ Finset.univ.image J, (∑ ω : Fin N_ω, if J ω = j then π ω else 0) =
          ∑ ω : Fin N_ω, π ω := by
        simp only [← Finset.sum_filter]
        exact Finset.sum_fiberwise_of_maps_to
          (fun ω _ => Finset.mem_image_of_mem J (Finset.mem_univ ω)) _
      exact h1.trans hπ_sum

    
    obtain ⟨h_mi_chain, h_time_chain⟩ :=
      cell_fiber_information_chain_bounds ε η 24000000 4 π T_idx K_r K_t J G_t G_loc K_loc
        Prod.fst F_fwd F_time hε₀ hε₁ hη_pos hε_tilde (by omega) (by omega) hπ_nn hπ_sum
        (fun _ => rfl) hFfwd_card
        (fun ω hω => (hF_mem (V_part (T_idx ω)) (A_part (T_idx ω)) (c_s ω) (θ_s ω)
          (hcθ ω hω).1 (hcθ ω hω).2).1)
        hFtime_card
        (fun ω hω => (hF_mem (V_part (T_idx ω)) (A_part (T_idx ω)) (c_s ω) (θ_s ω)
          (hcθ ω hω).1 (hcθ ω hω).2).2)

    have h_log_comb : Real.log ((24000000 : ℕ) : ℝ) / Real.log (ε⁻¹) +
        2 * (Real.log ((4 : ℕ) : ℝ) / Real.log (ε⁻¹)) =
        Real.log (384000000 : ℝ) / Real.log (ε⁻¹) := by
      push_cast
      have h_num : Real.log (24000000 : ℝ) + 2 * Real.log (4 : ℝ) =
          Real.log (384000000 : ℝ) := by
        have h1 : Real.log (4 : ℝ) + Real.log (4 : ℝ) = Real.log ((4 : ℝ) * 4) :=
          (Real.log_mul (by norm_num) (by norm_num)).symm
        have h2 : Real.log (24000000 : ℝ) + Real.log ((4 : ℝ) * 4) =
            Real.log ((24000000 : ℝ) * ((4 : ℝ) * 4)) :=
          (Real.log_mul (by norm_num) (by norm_num)).symm
        have h3 : (24000000 : ℝ) * ((4 : ℝ) * 4) = 384000000 := by norm_num
        linarith [h1, h2, congr_arg Real.log h3]
      calc Real.log (24000000 : ℝ) / Real.log (ε⁻¹) + 2 * (Real.log (4 : ℝ) / Real.log (ε⁻¹))
          = (Real.log (24000000 : ℝ) + 2 * Real.log (4 : ℝ)) / Real.log (ε⁻¹) := by ring
        _ = Real.log (384000000 : ℝ) / Real.log (ε⁻¹) := by rw [h_num]

    let W_J : ℝ := ((1 + γ) * b_t + (1 - γ) * (b_t + d)) -
      finMutualInfo ε π T_idx J + 2 * finCondEntropy ε π T_idx K_r
    let F_loc : (ℤ × ℤ × ℤ × ℤ × ℤ × ℤ) → ℝ := fun j =>
      stdApertureScore ε_tilde γ 1 0 e_loc (π_j_fn j) T_idx (V_loc j) (A_loc j) c_loc θ_loc
    let τ_loc : (ℤ × ℤ × ℤ × ℤ × ℤ × ℤ) → ℝ := fun j =>
      classicalRootSupremum ε_tilde (1 + e_loc) γ N_ω N_T (π_j_fn j) T_idx (V_loc j) (A_loc j)

    have h_Floc_sum : ∑ j ∈ S_J, p_J j * F_loc j =
        ((1 + γ) * 0 + (1 - γ) * e_loc) -
          (∑ j ∈ S_J, p_J j * finMutualInfo ε_tilde (π_j_fn j) T_idx (G_loc j)) +
          2 * (∑ j ∈ S_J, p_J j * finCondEntropy ε_tilde (π_j_fn j) T_idx K_loc) := by
      have h_exp : ∑ j ∈ S_J, p_J j * F_loc j =
          ∑ j ∈ S_J, (p_J j * ((1 + γ) * 0 + (1 - γ) * e_loc) -
            p_J j * finMutualInfo ε_tilde (π_j_fn j) T_idx (G_loc j) +
            2 * (p_J j * finCondEntropy ε_tilde (π_j_fn j) T_idx K_loc)) := by
        refine Finset.sum_congr rfl (fun j _ => ?_)
        dsimp only [F_loc, stdApertureScore, G_loc, K_loc]
        ring
      rw [h_exp, Finset.sum_add_distrib, Finset.sum_sub_distrib,
        ← Finset.sum_mul, hpJ_sum, one_mul, ← Finset.mul_sum]

    have h_eta_Floc :
        η * (∑ j ∈ S_J, p_J j * F_loc j) =
          η * ((1 + γ) * 0 + (1 - γ) * e_loc) -
            η * (∑ j ∈ S_J, p_J j * finMutualInfo ε_tilde (π_j_fn j) T_idx (G_loc j)) +
            2 * (η * (∑ j ∈ S_J, p_J j * finCondEntropy ε_tilde (π_j_fn j) T_idx K_loc)) := by
      rw [h_Floc_sum]
      ring

    have h_w_split : (1 + γ) * b_t + (1 - γ) * a_t =
        ((1 + γ) * b_t + (1 - γ) * (b_t + d)) + η * ((1 + γ) * 0 + (1 - γ) * e_loc) := by
      dsimp only [e_loc]
      field_simp [ne_of_gt hη_pos]
      ring

    have h_fwd_score :
        stdApertureScore ε γ t b_t a_t π T_idx V_part A_part c_s θ_s ≤
          W_J + η * (∑ j ∈ S_J, p_J j * F_loc j) + 2 * ζ + (1 / 3 : ℝ) * δ_cl * η := by
      have h_glob_eq : stdApertureScore ε γ t b_t a_t π T_idx V_part A_part c_s θ_s =
          ((1 + γ) * b_t + (1 - γ) * a_t) -
            finMutualInfo ε π T_idx G_t + 2 * finCondEntropy ε π T_idx K_t := rfl
      have h_mi' : finMutualInfo ε π T_idx J +
          η * (∑ j ∈ S_J, p_J j * finMutualInfo ε_tilde (π_j_fn j) T_idx (G_loc j)) ≤
          finMutualInfo ε π T_idx G_t + Real.log ((24000000 : ℕ) : ℝ) / Real.log (ε⁻¹) :=
        h_mi_chain
      have h_time' : finCondEntropy ε π T_idx K_t - finCondEntropy ε π T_idx K_r ≤
          ζ + η * (∑ j ∈ S_J, p_J j * finCondEntropy ε_tilde (π_j_fn j) T_idx K_loc) +
            Real.log ((4 : ℕ) : ℝ) / Real.log (ε⁻¹) :=
        h_time_chain
      dsimp only [W_J]
      linarith [h_glob_eq, h_w_split, h_eta_Floc, h_mi', h_time', h_log_comb, h_log_err]

    
    let Δ_r : ℝ := ((2 : ℝ) ^ (dyadicTimeLevel ε r))⁻¹
    have hΔr_pos : 0 < Δ_r := by
      have h_er_pos : 0 < (1 / 2 : ℝ) * ε ^ r := mul_pos (by norm_num) (Real.rpow_pos_of_pos hε₀ r)
      exact lt_of_lt_of_le h_er_pos hΔr_lo

    have h_kr_supp : ∀ ω : Fin N_ω, 0 < π ω →
        ((K_r ω : ℝ) + 1 / 2) * Δ_r ∈ Set.Icc (0 : ℝ) 1 ∧ Prod.fst (J ω) = K_r ω := by
      intro ω hω
      refine ⟨?_, rfl⟩
      have hc_mem := (hcθ ω hω).1
      have hθ_mem := (hcθ ω hω).2
      generalize hJ_eq : J ω = j_ω
      rcases j_ω with ⟨k_rj, k_ang_d, k_V1, k_V2, k_X1, k_X2⟩
      have h_inv := h_inv_traj (V_part (T_idx ω)) (A_part (T_idx ω)) (c_s ω) (θ_s ω)
        (k_rj, k_ang_d, k_V1, k_V2, k_X1, k_X2) hc_mem hθ_mem hJ_eq
      dsimp only [Δ_r, K_r] at h_inv ⊢
      rw [← h_inv.2.1]
      exact h_inv.1

    have h_compose :
        ∀ (j : ℤ × ℤ × ℤ × ℤ × ℤ × ℤ), 0 < p_J j →
        ∀ (B A : ℝ) (e_D V_D A_D : EuclideanSpace ℝ (Fin 2)),
          0 ≤ B → B ≤ A → A ≤ 1 + e_loc → ‖e_D‖ = 1 →
          ∃ (p_raw q_raw : ℝ) (e_G V_G X_G : EuclideanSpace ℝ (Fin 2)),
            0 ≤ p_raw ∧ p_raw ≤ q_raw ∧ q_raw + r ≤ L_hor ∧ ‖e_G‖ = 1 ∧
            ((1 + γ) * b_t + (1 - γ) * (b_t + d)) +
                η * ((1 + γ) * B + (1 - γ) * A) ≤
              (1 + γ) * p_raw + (1 - γ) * q_raw ∧
            (∀ ω : Fin N_ω, 0 < π ω → J ω = j →
              let tid := T_idx ω
              let c_mid := ((K_r ω : ℝ) + 1 / 2) * Δ_r
              |inner ℝ (V_loc j tid - V_D) e_D| ≤ 10 * ε_tilde ^ B →
              |inner ℝ (V_loc j tid - V_D) (perp2D e_D)| ≤ 10 * ε_tilde ^ A →
              |inner ℝ (A_loc j tid - A_D) e_D| ≤ 10 * ε_tilde ^ B →
              |inner ℝ (A_loc j tid - A_D) (perp2D e_D)| ≤ 10 * ε_tilde ^ A →
              |inner ℝ (V_part tid - V_G) e_G| ≤ 250 * ε ^ p_raw ∧
              |inner ℝ (V_part tid - V_G) (perp2D e_G)| ≤ 250 * ε ^ q_raw ∧
              |inner ℝ ((A_part tid + c_mid • V_part tid) - X_G) e_G| ≤
                250 * ε ^ (p_raw + r) ∧
              |inner ℝ ((A_part tid + c_mid • V_part tid) - X_G) (perp2D e_G)| ≤
                250 * ε ^ (q_raw + r)) := by
      rintro ⟨k_rj, k_ang_d, k_V1, k_V2, k_X1, k_X2⟩ _ B A e_D V_D A_D hB₀ hBA hA_hi heD
      let e_J : EuclideanSpace ℝ (Fin 2) := angUnitVec ε d k_ang_d
      have heJ : ‖e_J‖ = 1 := h_ang_norm d k_ang_d
      obtain ⟨p_raw, q_raw, e_G, hp0, hpq, hqr, heG, hw_sup, h_svd_cap⟩ :=
        anisotropic_two_by_two_svd_composition γ ε r t L_hor b_t a_t d B A e_J e_D
          hγ₀ hγ₁ hε₀ hε₁ hr₀ hrt hb₀ hatL hd₀ hda hB₀ hBA hA_hi heJ heD
      let v_J : EuclideanSpace ℝ (Fin 2) :=
        (((k_V1 : ℝ) + 1 / 2) * dyadicRealStep ε b_t) • e_J +
          (((k_V2 : ℝ) + 1 / 2) * dyadicRealStep ε (b_t + d)) • perp2D e_J
      let x_J : EuclideanSpace ℝ (Fin 2) :=
        (((k_X1 : ℝ) + 1 / 2) * dyadicRealStep ε (b_t + r)) • e_J +
          (((k_X2 : ℝ) + 1 / 2) * dyadicRealStep ε (b_t + d + r)) • perp2D e_J
      let S_J_lin : EuclideanSpace ℝ (Fin 2) → EuclideanSpace ℝ (Fin 2) := fun z =>
        (ε ^ b_t * z 0) • e_J + (ε ^ (b_t + d) * z 1) • perp2D e_J
      let V_G : EuclideanSpace ℝ (Fin 2) := v_J + (10 : ℝ) • S_J_lin V_D
      let X_G : EuclideanSpace ℝ (Fin 2) :=
        x_J + (10 * Δ_r) • S_J_lin (A_D + (1 / 2 : ℝ) • V_D)
      have hSJ_sub : ∀ u v : EuclideanSpace ℝ (Fin 2),
          S_J_lin (u - v) = S_J_lin u - S_J_lin v := by
        intro u v
        dsimp only [S_J_lin]
        ext i
        simp only [PiLp.add_apply, PiLp.sub_apply, PiLp.smul_apply, smul_eq_mul]
        ring
      refine ⟨p_raw, q_raw, e_G, V_G, X_G, hp0, hpq, hqr, heG, hw_sup, ?_⟩
      intro ω hω hJ_eq tid c_mid hv1 hv2 ha1 ha2
      let j_cur := (k_rj, k_ang_d, k_V1, k_V2, k_X1, k_X2)
      have h_inv := h_inv_traj (V_part tid) (A_part tid) (c_s ω) (θ_s ω)
        j_cur (hcθ ω hω).1 (hcθ ω hω).2 hJ_eq
      obtain ⟨_, hkr_eq, hV_raw, hX_raw⟩ := h_inv
      have hV_eq : V_part tid = v_J + (10 : ℝ) • S_J_lin (V_loc j_cur tid) := hV_raw
      have hX_eq : A_part tid + (((k_rj : ℝ) + 1 / 2) * Δ_r) • V_part tid =
          x_J + (10 * Δ_r) • S_J_lin (A_loc j_cur tid + (1 / 2 : ℝ) • V_loc j_cur tid) := hX_raw
      have h_V_diff : V_part tid - V_G =
          (10 : ℝ) • S_J_lin (V_loc j_cur tid - V_D) := by
        dsimp only [V_G]
        rw [hV_eq, hSJ_sub, smul_sub, add_sub_add_left_eq_sub]
      have h_X_diff :
          (A_part tid + c_mid • V_part tid) - X_G =
            (10 * Δ_r) • S_J_lin ((A_loc j_cur tid - A_D) +
              (1 / 2 : ℝ) • (V_loc j_cur tid - V_D)) := by
        have h_cmid_eq : c_mid = ((k_rj : ℝ) + 1 / 2) * Δ_r := by
          dsimp only [c_mid, K_r]
          rw [← hkr_eq]
        have h_lin_arg :
            (A_loc j_cur tid + (1 / 2 : ℝ) • V_loc j_cur tid) -
              (A_D + (1 / 2 : ℝ) • V_D) =
            (A_loc j_cur tid - A_D) +
              (1 / 2 : ℝ) • (V_loc j_cur tid - V_D) := by
          ext i
          simp only [PiLp.add_apply, PiLp.sub_apply, PiLp.smul_apply, smul_eq_mul]
          ring
        dsimp only [X_G]
        rw [h_cmid_eq, hX_eq, ← h_lin_arg, hSJ_sub, smul_sub, add_sub_add_left_eq_sub]
      rw [h_V_diff, h_X_diff]
      exact h_svd_cap (V_loc j_cur tid - V_D) (A_loc j_cur tid - A_D)
        Δ_r hΔr_pos hΔr_hi hv1 hv2 ha1 ha2

    have h_bwd_root := h_root_glue ε b_t a_t d Δ_r hε₀ hε_lt_two hε_tilde
      hb₀ hba hatL hd₀ hda hΔr_lo hΔr_hi π T_idx V_part A_part J K_r Prod.fst V_loc A_loc
      hπ_nn hπ_sum hVA (fun j tid => h_conj2 tid j) h_kr_supp h_compose

    
    have h_Δloc_sum : ∑ j ∈ S_J, p_J j * Δ_loc j =
        classicalGrowthRate γ + (∑ j ∈ S_J, p_J j * τ_loc j) -
          (∑ j ∈ S_J, p_J j * F_loc j) := by
      have h_exp : ∑ j ∈ S_J, p_J j * Δ_loc j =
          ∑ j ∈ S_J, (p_J j * classicalGrowthRate γ +
            p_J j * τ_loc j - p_J j * F_loc j) := by
        refine Finset.sum_congr rfl (fun j _ => ?_)
        dsimp only [Δ_loc, τ_loc, F_loc, π_j_fn, V_loc, A_loc, c_loc, θ_loc]
        ring
      rw [h_exp, Finset.sum_sub_distrib, Finset.sum_add_distrib,
        ← Finset.sum_mul, hpJ_sum, one_mul]

    have h_β_split : classicalGrowthRate γ * η + classicalGrowthRate γ * r =
        classicalGrowthRate γ * t := by
      dsimp only [η]
      ring

    have h_eta_sum : η * (∑ j ∈ S_J, p_J j * Δ_loc j) ≤ Δ_glob + 2 * ζ + δ_cl * η := by
      dsimp only [W_J, S_J, p_J, π_j_fn, ε_tilde, e_loc, η, τ_loc] at h_bwd_root h_fwd_score ⊢
      have h_mul_sum : η * (∑ j ∈ S_J, p_J j * Δ_loc j) =
          classicalGrowthRate γ * η + η * (∑ j ∈ S_J, p_J j * τ_loc j) -
            η * (∑ j ∈ S_J, p_J j * F_loc j) := by
        rw [h_Δloc_sum]
        ring
      dsimp only [Δ_glob]
      linarith [h_mul_sum, h_β_split, h_fwd_score, h_bwd_root]

    have h_div_rhs : (Δ_glob + 2 * ζ + δ_cl * η) / η = (Δ_glob + 2 * ζ) / η + δ_cl := by
      rw [add_div, mul_div_cancel_right₀ δ_cl (ne_of_gt hη_pos)]
    rw [← h_div_rhs, le_div_iff₀ hη_pos, mul_comm _ η]
    exact h_eta_sum

  exact ⟨h_conj1, h_conj2, h_conj3, h_conj4, h_conj5⟩

theorem score_stability_and_binary_splitting (γ : ℝ) (hγ₀ : 0 < γ) (hγ₁ : γ < 1)
    (h_two : (2 : ℝ) ∈ ValidClassicalGrowthRates γ) :
    (∀ (K_hor t_min δ : ℝ), 1 ≤ K_hor → 0 < t_min → t_min ≤ K_hor → 0 < δ →
      ∃ ε₀ : ℝ, 0 < ε₀ ∧ ε₀ < 1 / 2 ∧
        ∀ (ε u L b a : ℝ),
          0 < ε → ε < ε₀ → t_min ≤ u → u ≤ L → L ≤ K_hor →
          0 ≤ b → b ≤ a → a + u ≤ L →
        ∀ {N_ω N_T : ℕ} (π : Fin N_ω → ℝ) (T_idx : Fin N_ω → Fin N_T)
          (V_part A_part : Fin N_T → EuclideanSpace ℝ (Fin 2))
          (c_s θ_s : Fin N_ω → ℝ),
          (∀ ω, 0 ≤ π ω) → (∑ ω : Fin N_ω, π ω = 1) →
          (∀ tid, ‖V_part tid‖ ≤ 1 ∧ ‖A_part tid‖ ≤ 1) →
          (∀ ω, 0 < π ω → c_s ω ∈ Set.Icc (0 : ℝ) 1 ∧ θ_s ω ∈ Set.Ico (0 : ℝ) Real.pi) →
          stdApertureScore ε γ u b a π T_idx V_part A_part c_s θ_s -
            classicalRootSupremum ε L γ N_ω N_T π T_idx V_part A_part ≤
            (classicalGrowthRate γ + δ) * u) ∧
    (∀ (ε u L b a : ℝ) {N_ω N_T : ℕ}
      (π : Fin N_ω → ℝ) (T_idx : Fin N_ω → Fin N_T)
      (V_part A_part : Fin N_T → EuclideanSpace ℝ (Fin 2))
      (c_s θ_s : Fin N_ω → ℝ) (E : Finset (Fin N_ω)),
      0 < ε → ε < 1 / 2 → 0 ≤ L → 0 ≤ b → b ≤ a →
      (∀ ω, 0 ≤ π ω) → (∑ ω : Fin N_ω, π ω = 1) →
      (∀ tid, ‖V_part tid‖ ≤ 1 ∧ ‖A_part tid‖ ≤ 1) →
      0 < ∑ ω ∈ E, π ω → ∑ ω ∈ E, π ω < 1 →
      let m_E := ∑ ω ∈ E, π ω
      let π_E := restrictLaw π E
      let π_Ec := restrictLaw π (Finset.univ \ E)
      m_E * (classicalRootSupremum ε L γ N_ω N_T π_E T_idx V_part A_part -
          stdApertureScore ε γ u b a π_E T_idx V_part A_part c_s θ_s) +
        (1 - m_E) * (classicalRootSupremum ε L γ N_ω N_T π_Ec T_idx V_part A_part -
          stdApertureScore ε γ u b a π_Ec T_idx V_part A_part c_s θ_s) ≤
        (classicalRootSupremum ε L γ N_ω N_T π T_idx V_part A_part -
          stdApertureScore ε γ u b a π T_idx V_part A_part c_s θ_s) +
          3 * Real.log 2 / Real.log (ε⁻¹)) ∧
    (∃ C_shift : ℝ, 1 ≤ C_shift ∧
      ∀ (ε e₁ e₂ : ℝ) {N_ω N_T : ℕ}
        (π : Fin N_ω → ℝ) (T_idx : Fin N_ω → Fin N_T)
        (V_part A_part : Fin N_T → EuclideanSpace ℝ (Fin 2))
        (c_s θ_s : Fin N_ω → ℝ),
        0 < ε → ε < 1 / 2 → 0 ≤ e₁ → 0 ≤ e₂ →
        (∀ ω, 0 ≤ π ω) → (∑ ω : Fin N_ω, π ω = 1) →
        (∀ tid, ‖V_part tid‖ ≤ 1 ∧ ‖A_part tid‖ ≤ 1) →
        (∀ ω, 0 < π ω → c_s ω ∈ Set.Icc (0 : ℝ) 1 ∧ θ_s ω ∈ Set.Ico (0 : ℝ) Real.pi) →
        |(stdApertureScore ε γ 1 0 e₂ π T_idx V_part A_part c_s θ_s -
            classicalRootSupremum ε (1 + e₂) γ N_ω N_T π T_idx V_part A_part) -
          (stdApertureScore ε γ 1 0 e₁ π T_idx V_part A_part c_s θ_s -
            classicalRootSupremum ε (1 + e₁) γ N_ω N_T π T_idx V_part A_part)| ≤
          6 * |e₂ - e₁| + Real.log C_shift / Real.log (ε⁻¹)) ∧
    ((∀ (ε : ℝ) {N_ω N_T : ℕ}
        (π : Fin N_ω → ℝ) (T_idx : Fin N_ω → Fin N_T)
        (V_part A_part : Fin N_T → EuclideanSpace ℝ (Fin 2))
        (c_s θ_s : Fin N_ω → ℝ),
        0 < ε → ε < 1 / 2 →
        (∀ ω, 0 ≤ π ω) → (∑ ω : Fin N_ω, π ω = 1) →
        (∀ tid, ‖V_part tid‖ ≤ 1 ∧ ‖A_part tid‖ ≤ 1) →
        (∀ ω, 0 < π ω → c_s ω ∈ Set.Icc (0 : ℝ) 1 ∧ θ_s ω ∈ Set.Ico (0 : ℝ) Real.pi) →
        let k_t := fun ω => dyadicTimeBin ε 1 (c_s ω)
        let O_end := fun ω : Fin N_ω =>
          let x_pos := A_part (T_idx ω) + (dyadicTimeMid ε 1 (c_s ω)) • V_part (T_idx ω)
          (k_t ω, dyadicRealBin ε 1 (x_pos 0), dyadicRealBin ε 1 (x_pos 1))
        |(-finMutualInfo ε π T_idx O_end + 2 * finCondEntropy ε π T_idx k_t) -
          stdApertureScore ε γ 1 0 0 π T_idx V_part A_part c_s θ_s| ≤
          Real.log 18 / Real.log (ε⁻¹)) ∧
     (∀ (ε r η u₀ u : ℝ) (k_r : ℤ),
        0 < ε → ε < 1 / 2 → 0 < r → 0 < η → ε ^ η < 1 / 2 →
        0 ≤ u₀ → u₀ ≤ u → u ≤ 1 →
        ∃ (lo₁₂ lo₂₁ : ℤ → ℤ),
          let ε_tilde := ε ^ η
          let N₁₂ : ℕ := ⌈16 * ε_tilde ^ (-(u - u₀))⌉₊ + 2
          ∀ c : ℝ, c ∈ Set.Icc (0 : ℝ) 1 → dyadicTimeBin ε r c = k_r →
            let y₁ := dyadicTimeBin ε (r + u₀ * η) c
            let y₂ := dyadicTimeBin ε_tilde u (locTime ε r c)
            (lo₁₂ y₁ ≤ y₂ ∧ y₂ < lo₁₂ y₁ + (N₁₂ : ℤ)) ∧
            (lo₂₁ y₂ ≤ y₁ ∧ y₁ < lo₂₁ y₂ + 6))) :=
by
  have h_s1 :
      (∀ {N_ω : ℕ} {α_T α₁ α₂ : Type} [DecidableEq α₁] [DecidableEq α₂]
        (ε M₁₂ M₂₁ : ℝ)
        (π : Fin N_ω → ℝ) (T : Fin N_ω → α_T) (Y₁ : Fin N_ω → α₁) (Y₂ : Fin N_ω → α₂)
        (F₁₂ : α₁ → Finset α₂) (F₂₁ : α₂ → Finset α₁),
        0 < ε → ε < 1 / 2 → 1 ≤ M₁₂ → 1 ≤ M₂₁ →
        (∀ ω, 0 ≤ π ω) → (∑ ω : Fin N_ω, π ω = 1) →
        (∀ y₁, ((F₁₂ y₁).card : ℝ) ≤ M₁₂) →
        (∀ y₂, ((F₂₁ y₂).card : ℝ) ≤ M₂₁) →
        (∀ ω, 0 < π ω → Y₂ ω ∈ F₁₂ (Y₁ ω) ∧ Y₁ ω ∈ F₂₁ (Y₂ ω)) →
        |finMutualInfo ε π T Y₂ - finMutualInfo ε π T Y₁| ≤
          Real.log (max M₁₂ M₂₁) / Real.log (ε⁻¹)) ∧
      (∀ (ε γ u b a : ℝ) {N_ω N_T : ℕ}
        (π : Fin N_ω → ℝ) (T_idx : Fin N_ω → Fin N_T)
        (V_part A_part : Fin N_T → EuclideanSpace ℝ (Fin 2))
        (c_s θ_s : Fin N_ω → ℝ) (E : Finset (Fin N_ω)),
        0 < ε → ε < 1 / 2 →
        (∀ ω, 0 ≤ π ω) → (∑ ω : Fin N_ω, π ω = 1) →
        0 < ∑ ω ∈ E, π ω → ∑ ω ∈ E, π ω < 1 →
        let m_E := ∑ ω ∈ E, π ω
        let π_E := restrictLaw π E
        let π_Ec := restrictLaw π (Finset.univ \ E)
        let Z := fun ω : Fin N_ω => decide (ω ∈ E)
        stdApertureScore ε γ u b a π T_idx V_part A_part c_s θ_s -
          (m_E * stdApertureScore ε γ u b a π_E T_idx V_part A_part c_s θ_s +
           (1 - m_E) * stdApertureScore ε γ u b a π_Ec T_idx V_part A_part c_s θ_s) ≤
          -finMutualInfo ε π T_idx Z + 3 * Real.log 2 / Real.log (ε⁻¹)) := by
    have h_ell_pos : ∀ ε : ℝ, 0 < ε → ε < 1 / 2 → 0 < Real.log (ε⁻¹) := by
      intro ε hε0 hε1
      rw [Real.log_inv]
      linarith [Real.log_neg hε0 (lt_trans hε1 (by norm_num))]
    have h_prob_bds : ∀ {N_ω : ℕ} {α β : Type} (π : Fin N_ω → ℝ)
        (X : Fin N_ω → α) (Y : Fin N_ω → β) (ω : Fin N_ω),
        (∀ ω', 0 ≤ π ω') → 0 < π ω →
        0 < finProbAt2 π X Y ω ∧ finProbAt2 π X Y ω ≤ finProbAt π X ω ∧ 0 < finProbAt π X ω := by
      intro N_ω α β π X Y ω hπ_nn hω
      have h1 : π ω ≤ finProbAt2 π X Y ω := by
        unfold finProbAt2
        have h_le := Finset.single_le_sum
          (f := fun ω' => @ite ℝ (X ω' = X ω ∧ Y ω' = Y ω) (Classical.propDecidable _) (π ω') 0)
          (fun ω' _ => by split_ifs <;> [exact hπ_nn ω'; exact le_rfl])
          (Finset.mem_univ ω)
        simpa using h_le
      have h2 : finProbAt2 π X Y ω ≤ finProbAt π X ω := by
        unfold finProbAt2 finProbAt
        refine Finset.sum_le_sum (fun ω' _ => ?_)
        by_cases hX : X ω' = X ω
        · by_cases hY : Y ω' = Y ω <;> simp [hX, hY, hπ_nn ω']
        · simp [hX]
      exact ⟨lt_of_lt_of_le hω h1, h2, lt_of_lt_of_le (lt_of_lt_of_le hω h1) h2⟩
    have h_ent_nn : ∀ {N_ω : ℕ} {α β : Type} (ε : ℝ) (π : Fin N_ω → ℝ)
        (X : Fin N_ω → α) (Y : Fin N_ω → β),
        0 < ε → ε < 1 / 2 → (∀ ω, 0 ≤ π ω) →
        0 ≤ finCondEntropy ε π X Y := by
      intro N_ω α β ε π X Y hε0 hε1 hπ_nn
      have hell := h_ell_pos ε hε0 hε1
      refine Finset.sum_nonneg (fun ω _ => ?_)
      by_cases hω : 0 < π ω
      · obtain ⟨hp2, hle, hp1⟩ := h_prob_bds π X Y ω hπ_nn hω
        refine mul_nonneg hω.le (div_nonneg ?_ hell.le)
        rw [neg_nonneg]
        exact Real.log_nonpos (div_nonneg hp2.le hp1.le) ((div_le_one hp1).mpr hle)
      · have h0 : π ω = 0 := le_antisymm (le_of_not_gt hω) (hπ_nn ω)
        simp [h0]
    have h_prob2_eq_prob1 : ∀ {N_ω : ℕ} {α β : Type} (π : Fin N_ω → ℝ)
        (X : Fin N_ω → α) (Y : Fin N_ω → β) (ω : Fin N_ω),
        finProbAt π (fun ω' => (X ω', Y ω')) ω = finProbAt2 π X Y ω := by
      intro N_ω α β π X Y ω
      unfold finProbAt finProbAt2
      refine Finset.sum_congr rfl (fun ω' _ => ?_)
      by_cases hX : X ω' = X ω <;> by_cases hY : Y ω' = Y ω <;> simp [hX, hY]
    have h_prob2_assoc : ∀ {N_ω : ℕ} {α β γ_t : Type} (π : Fin N_ω → ℝ)
        (X : Fin N_ω → α) (Y : Fin N_ω → β) (W : Fin N_ω → γ_t) (ω : Fin N_ω),
        finProbAt2 π (fun ω' => (X ω', Y ω')) W ω =
          finProbAt2 π X (fun ω' => (Y ω', W ω')) ω := by
      intro N_ω α β γ_t π X Y W ω
      unfold finProbAt2
      refine Finset.sum_congr rfl (fun ω' _ => ?_)
      by_cases hX : X ω' = X ω <;> by_cases hY : Y ω' = Y ω <;> by_cases hW : W ω' = W ω <;>
        simp [hX, hY, hW]
    have h_chain : ∀ {N_ω : ℕ} {α β γ_t : Type} (ε : ℝ) (π : Fin N_ω → ℝ)
        (X : Fin N_ω → α) (Y : Fin N_ω → β) (W : Fin N_ω → γ_t),
        (∀ ω, 0 ≤ π ω) →
        finCondEntropy ε π X (fun ω' => (Y ω', W ω')) =
          finCondEntropy ε π X Y + finCondEntropy ε π (fun ω' => (X ω', Y ω')) W := by
      intro N_ω α β γ_t ε π X Y W hπ_nn
      unfold finCondEntropy
      rw [← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun ω _ => ?_)
      by_cases hω : 0 < π ω
      · obtain ⟨hpXY, _, hpX⟩ := h_prob_bds π X Y ω hπ_nn hω
        obtain ⟨hpXYW, _, _⟩ := h_prob_bds π X (fun ω' => (Y ω', W ω')) ω hπ_nn hω
        unfold condSurprise
        rw [h_prob2_eq_prob1, h_prob2_assoc]
        have h_mul : finProbAt2 π X (fun ω' => (Y ω', W ω')) ω / finProbAt π X ω =
            (finProbAt2 π X Y ω / finProbAt π X ω) *
              (finProbAt2 π X (fun ω' => (Y ω', W ω')) ω / finProbAt2 π X Y ω) := by
          field_simp [ne_of_gt hpX, ne_of_gt hpXY]
        rw [h_mul, Real.log_mul (ne_of_gt (div_pos hpXY hpX)) (ne_of_gt (div_pos hpXYW hpXY))]
        ring
      · have h0 : π ω = 0 := le_antisymm (le_of_not_gt hω) (hπ_nn ω)
        simp [h0]
    have h_ent_pair_comm : ∀ {N_ω : ℕ} {α β γ_t : Type} (ε : ℝ) (π : Fin N_ω → ℝ)
        (X : Fin N_ω → α) (Y : Fin N_ω → β) (W : Fin N_ω → γ_t),
        finCondEntropy ε π X (fun ω' => (Y ω', W ω')) =
          finCondEntropy ε π X (fun ω' => (W ω', Y ω')) := by
      intro N_ω α β γ_t ε π X Y W
      unfold finCondEntropy condSurprise
      refine Finset.sum_congr rfl (fun ω _ => ?_)
      have h_eq : finProbAt2 π X (fun ω' => (Y ω', W ω')) ω =
          finProbAt2 π X (fun ω' => (W ω', Y ω')) ω := by
        unfold finProbAt2
        refine Finset.sum_congr rfl (fun ω' _ => ?_)
        by_cases hX : X ω' = X ω <;> by_cases hY : Y ω' = Y ω <;> by_cases hW : W ω' = W ω <;>
          simp [hX, hY, hW]
      rw [h_eq]
    have h_ent_cond_comm : ∀ {N_ω : ℕ} {α β γ_t : Type} (ε : ℝ) (π : Fin N_ω → ℝ)
        (X : Fin N_ω → α) (W : Fin N_ω → β) (Y : Fin N_ω → γ_t),
        finCondEntropy ε π (fun ω' => (X ω', W ω')) Y =
          finCondEntropy ε π (fun ω' => (W ω', X ω')) Y := by
      intro N_ω α β γ_t ε π X W Y
      unfold finCondEntropy condSurprise
      refine Finset.sum_congr rfl (fun ω _ => ?_)
      have e1 : finProbAt π (fun ω' => (X ω', W ω')) ω = finProbAt π (fun ω' => (W ω', X ω')) ω := by
        unfold finProbAt
        refine Finset.sum_congr rfl (fun ω' _ => ?_)
        by_cases hX : X ω' = X ω <;> by_cases hW : W ω' = W ω <;> simp [hX, hW]
      have e2 : finProbAt2 π (fun ω' => (X ω', W ω')) Y ω = finProbAt2 π (fun ω' => (W ω', X ω')) Y ω := by
        unfold finProbAt2
        refine Finset.sum_congr rfl (fun ω' _ => ?_)
        by_cases hX : X ω' = X ω <;> by_cases hW : W ω' = W ω <;> by_cases hY : Y ω' = Y ω <;>
          simp [hX, hW, hY]
      rw [e1, e2]
    have h_ent_unit_fst : ∀ {N_ω : ℕ} {α β : Type} (ε : ℝ) (π : Fin N_ω → ℝ)
        (Z : Fin N_ω → α) (Y : Fin N_ω → β),
        finCondEntropy ε π (fun ω' => ((), Z ω')) Y = finCondEntropy ε π Z Y := by
      intro N_ω α β ε π Z Y
      unfold finCondEntropy condSurprise
      refine Finset.sum_congr rfl (fun ω _ => ?_)
      have h1 : finProbAt π (fun ω' => ((), Z ω')) ω = finProbAt π Z ω := by
        unfold finProbAt
        refine Finset.sum_congr rfl (fun ω' _ => by by_cases hZ : Z ω' = Z ω <;> simp [hZ])
      have h2 : finProbAt2 π (fun ω' => ((), Z ω')) Y ω = finProbAt2 π Z Y ω := by
        unfold finProbAt2
        refine Finset.sum_congr rfl (fun ω' _ => by
          by_cases hZ : Z ω' = Z ω <;> by_cases hY : Y ω' = Y ω <;> simp [hZ, hY])
      rw [h1, h2]
    have h_cond_mono : ∀ {N_ω : ℕ} {α β γ_t : Type} (ε : ℝ) (π : Fin N_ω → ℝ)
        (X : Fin N_ω → α) (Y : Fin N_ω → β) (W : Fin N_ω → γ_t),
        0 < ε → ε < 1 / 2 → (∀ ω, 0 ≤ π ω) → (∑ ω : Fin N_ω, π ω = 1) →
        finCondEntropy ε π (fun ω' => (X ω', W ω')) Y ≤ finCondEntropy ε π X Y := by
      intro N_ω α β γ_t ε π X Y W hε0 hε1 hπ_nn hπ_sum
      haveI : DecidableEq α := Classical.decEq α
      haveI : DecidableEq β := Classical.decEq β
      haveI : DecidableEq γ_t := Classical.decEq γ_t
      have hell := h_ell_pos ε hε0 hε1
      let S_pos : Finset (Fin N_ω) :=
        @Finset.filter (Fin N_ω) (fun ω => 0 < π ω) (fun ω => Classical.propDecidable _) Finset.univ
      have h_mem_S : ∀ ω, ω ∈ S_pos ↔ 0 < π ω := by intro ω; simp [S_pos]
      have h_zero_out : ∀ ω ∉ S_pos, π ω = 0 := by
        intro ω hω
        rw [h_mem_S, not_lt] at hω
        exact le_antisymm hω (hπ_nn ω)
      have h_sum_S : ∀ f : Fin N_ω → ℝ, ∑ ω : Fin N_ω, π ω * f ω = ∑ ω ∈ S_pos, π ω * f ω := by
        intro f
        exact (Finset.sum_subset (Finset.subset_univ S_pos) (fun ω _ hω => by simp [h_zero_out ω hω])).symm
      have h_S_one : ∑ ω ∈ S_pos, π ω = 1 := by
        have h1 := h_sum_S (fun _ => 1)
        simp only [mul_one] at h1
        linarith
      have h_diff_ge : ∀ ω ∈ S_pos,
          (π ω - π ω * ((finProbAt2 π X Y ω * finProbAt π (fun ω' => (X ω', W ω')) ω) /
            (finProbAt π X ω * finProbAt2 π (fun ω' => (X ω', W ω')) Y ω))) / Real.log (ε⁻¹) ≤
          π ω * condSurprise ε π X Y ω - π ω * condSurprise ε π (fun ω' => (X ω', W ω')) Y ω := by
        intro ω hω
        have hω_pos : 0 < π ω := (h_mem_S ω).mp hω
        obtain ⟨hpXY, _, hpX⟩ := h_prob_bds π X Y ω hπ_nn hω_pos
        obtain ⟨hpXWY, _, hpXW⟩ := h_prob_bds π (fun ω' => (X ω', W ω')) Y ω hπ_nn hω_pos
        set u := (finProbAt2 π X Y ω * finProbAt π (fun ω' => (X ω', W ω')) ω) /
          (finProbAt π X ω * finProbAt2 π (fun ω' => (X ω', W ω')) Y ω)
        have hu_pos : 0 < u := div_pos (mul_pos hpXY hpXW) (mul_pos hpX hpXWY)
        have h_log_u : Real.log u = Real.log (finProbAt2 π X Y ω / finProbAt π X ω) -
            Real.log (finProbAt2 π (fun ω' => (X ω', W ω')) Y ω /
              finProbAt π (fun ω' => (X ω', W ω')) ω) := by
          have h_eq_u : u = (finProbAt2 π X Y ω / finProbAt π X ω) /
              (finProbAt2 π (fun ω' => (X ω', W ω')) Y ω /
                finProbAt π (fun ω' => (X ω', W ω')) ω) := by
            dsimp [u]; field_simp [ne_of_gt hpX, ne_of_gt hpXW, ne_of_gt hpXWY]
          rw [h_eq_u, Real.log_div (ne_of_gt (div_pos hpXY hpX)) (ne_of_gt (div_pos hpXWY hpXW))]
        have h_ineq : 1 - u ≤ -Real.log u := by linarith [Real.log_le_sub_one_of_pos hu_pos]
        have h_surp_diff : π ω * condSurprise ε π X Y ω -
            π ω * condSurprise ε π (fun ω' => (X ω', W ω')) Y ω =
            (π ω * (-Real.log u)) / Real.log (ε⁻¹) := by
          unfold condSurprise; rw [h_log_u]; ring
        rw [h_surp_diff]
        refine div_le_div_of_nonneg_right ?_ hell.le
        nlinarith
      let f3 : Fin N_ω → α × β × γ_t := fun ω => (X ω, Y ω, W ω)
      let T3 := S_pos.image f3
      let IX := S_pos.image X
      let IY := S_pos.image Y
      let IW := S_pos.image W
      let qX : α → ℝ := fun x => ∑ ω ∈ S_pos, if X ω = x then π ω else 0
      let qXY : α → β → ℝ := fun x y => ∑ ω ∈ S_pos, if X ω = x ∧ Y ω = y then π ω else 0
      let qXW : α → γ_t → ℝ := fun x w => ∑ ω ∈ S_pos, if X ω = x ∧ W ω = w then π ω else 0
      let qXWY : α × β × γ_t → ℝ := fun t => ∑ ω ∈ S_pos, if f3 ω = t then π ω else 0
      have h_sum_u_le1 : ∑ ω ∈ S_pos,
          π ω * ((finProbAt2 π X Y ω * finProbAt π (fun ω' => (X ω', W ω')) ω) /
            (finProbAt π X ω * finProbAt2 π (fun ω' => (X ω', W ω')) Y ω)) ≤ 1 := by
        have h_fib := Finset.sum_fiberwise_of_maps_to (s := S_pos) (t := T3)
          (fun ω hω => Finset.mem_image_of_mem f3 hω)
          (fun ω => π ω * ((finProbAt2 π X Y ω * finProbAt π (fun ω' => (X ω', W ω')) ω) /
            (finProbAt π X ω * finProbAt2 π (fun ω' => (X ω', W ω')) Y ω)))
        rw [← h_fib]
        have h_each_t : ∀ t ∈ T3,
            (∑ ω ∈ S_pos with f3 ω = t,
              π ω * ((finProbAt2 π X Y ω * finProbAt π (fun ω' => (X ω', W ω')) ω) /
                (finProbAt π X ω * finProbAt2 π (fun ω' => (X ω', W ω')) Y ω))) =
            (qXY t.1 t.2.1 * qXW t.1 t.2.2) / qX t.1 := by
          intro t ht
          obtain ⟨ω₀, hω₀_S, hω₀_eq⟩ := Finset.mem_image.mp ht
          have hq_pos : 0 < qXWY t := by
            dsimp [qXWY]
            have h_le := Finset.single_le_sum (f := fun ω => if f3 ω = t then π ω else 0)
              (fun ω _ => by split_ifs <;> [exact hπ_nn ω; exact le_rfl]) hω₀_S
            simp only [hω₀_eq, ↓reduceIte] at h_le
            exact lt_of_lt_of_le ((h_mem_S ω₀).mp hω₀_S) h_le
          have h_term : ∀ ω ∈ S_pos.filter (fun ω => f3 ω = t),
              π ω * ((finProbAt2 π X Y ω * finProbAt π (fun ω' => (X ω', W ω')) ω) /
                (finProbAt π X ω * finProbAt2 π (fun ω' => (X ω', W ω')) Y ω)) =
              π ω * ((qXY t.1 t.2.1 * qXW t.1 t.2.2) / (qX t.1 * qXWY t)) := by
            intro ω hω_f
            have hf_eq : f3 ω = t := (Finset.mem_filter.mp hω_f).2
            rcases t with ⟨x, y, w⟩
            dsimp [f3] at hf_eq
            rcases Prod.mk.inj hf_eq with ⟨rfl, h_yw⟩
            rcases Prod.mk.inj h_yw with ⟨rfl, rfl⟩
            have e1 : finProbAt π X ω = qX (X ω) := by
              unfold finProbAt; dsimp only [qX]
              refine Eq.trans ((Finset.sum_subset (Finset.subset_univ S_pos)
                (fun ω' _ hω' => by rw [h_zero_out ω' hω']; split_ifs <;> rfl)).symm) ?_
              exact Finset.sum_congr rfl (fun ω' _ => by by_cases h1 : X ω' = X ω <;> simp [h1])
            have e2 : finProbAt2 π X Y ω = qXY (X ω) (Y ω) := by
              unfold finProbAt2; dsimp only [qXY]
              refine Eq.trans ((Finset.sum_subset (Finset.subset_univ S_pos)
                (fun ω' _ hω' => by rw [h_zero_out ω' hω']; split_ifs <;> rfl)).symm) ?_
              exact Finset.sum_congr rfl (fun ω' _ => by
                by_cases h1 : X ω' = X ω <;> by_cases h2 : Y ω' = Y ω <;> simp [h1, h2])
            have e3 : finProbAt π (fun ω' => (X ω', W ω')) ω = qXW (X ω) (W ω) := by
              unfold finProbAt; dsimp only [qXW]
              refine Eq.trans ((Finset.sum_subset (Finset.subset_univ S_pos)
                (fun ω' _ hω' => by rw [h_zero_out ω' hω']; split_ifs <;> rfl)).symm) ?_
              exact Finset.sum_congr rfl (fun ω' _ => by
                by_cases h1 : X ω' = X ω <;> by_cases h2 : W ω' = W ω <;> simp [h1, h2])
            have e4 : finProbAt2 π (fun ω' => (X ω', W ω')) Y ω = qXWY (X ω, Y ω, W ω) := by
              unfold finProbAt2; dsimp only [qXWY, f3]
              refine Eq.trans ((Finset.sum_subset (Finset.subset_univ S_pos)
                (fun ω' _ hω' => by rw [h_zero_out ω' hω']; split_ifs <;> rfl)).symm) ?_
              exact Finset.sum_congr rfl (fun ω' _ => by
                by_cases h1 : X ω' = X ω <;> by_cases h2 : Y ω' = Y ω <;> by_cases h3 : W ω' = W ω <;>
                  simp [h1, h2, h3])
            rw [e1, e2, e3, e4]
          rw [Finset.sum_congr rfl h_term, ← Finset.sum_mul, Finset.sum_filter]
          change qXWY t * ((qXY t.1 t.2.1 * qXW t.1 t.2.2) / (qX t.1 * qXWY t)) = _
          have hq_ne : qXWY t ≠ 0 := ne_of_gt hq_pos
          by_cases hqx : qX t.1 = 0
          · simp [hqx]
          · field_simp [hq_ne, hqx]
        rw [Finset.sum_congr rfl h_each_t]
        have h_sub : T3 ⊆ IX ×ˢ (IY ×ˢ IW) := by
          intro t ht
          obtain ⟨ω, hω, rfl⟩ := Finset.mem_image.mp ht
          exact Finset.mem_product.mpr ⟨Finset.mem_image_of_mem X hω,
            Finset.mem_product.mpr ⟨Finset.mem_image_of_mem Y hω, Finset.mem_image_of_mem W hω⟩⟩
        have h_nn : ∀ t : α × β × γ_t, 0 ≤ (qXY t.1 t.2.1 * qXW t.1 t.2.2) / qX t.1 := by
          intro t
          have h1 : 0 ≤ qXY t.1 t.2.1 := Finset.sum_nonneg (fun ω _ => by split_ifs <;> [exact hπ_nn ω; exact le_rfl])
          have h2 : 0 ≤ qXW t.1 t.2.2 := Finset.sum_nonneg (fun ω _ => by split_ifs <;> [exact hπ_nn ω; exact le_rfl])
          have h3 : 0 ≤ qX t.1 := Finset.sum_nonneg (fun ω _ => by split_ifs <;> [exact hπ_nn ω; exact le_rfl])
          exact div_nonneg (mul_nonneg h1 h2) h3
        refine le_trans (Finset.sum_le_sum_of_subset_of_nonneg h_sub (fun t _ _ => h_nn t)) ?_
        rw [Finset.sum_product]
        have h_sum_IY : ∀ x : α, ∑ y ∈ IY, qXY x y = qX x := by
          intro x
          dsimp [qXY, qX]
          rw [Finset.sum_comm]
          refine Finset.sum_congr rfl (fun ω hω => ?_)
          by_cases hx : X ω = x
          · simp only [hx, true_and, ↓reduceIte]
            rw [Finset.sum_ite_eq IY (Y ω) (fun _ => π ω)]
            exact ite_eq_left_iff.mpr (fun h => absurd (Finset.mem_image_of_mem Y hω) h)
          · simp [hx]
        have h_sum_IW : ∀ x : α, ∑ w ∈ IW, qXW x w = qX x := by
          intro x
          dsimp [qXW, qX]
          rw [Finset.sum_comm]
          refine Finset.sum_congr rfl (fun ω hω => ?_)
          by_cases hx : X ω = x
          · simp only [hx, true_and, ↓reduceIte]
            rw [Finset.sum_ite_eq IW (W ω) (fun _ => π ω)]
            exact ite_eq_left_iff.mpr (fun h => absurd (Finset.mem_image_of_mem W hω) h)
          · simp [hx]
        have h_prod_x : ∀ x ∈ IX,
            (∑ p ∈ IY ×ˢ IW, (qXY x p.1 * qXW x p.2) / qX x) ≤ qX x := by
          intro x _
          rw [Finset.sum_product]
          have h_fact : (∑ y ∈ IY, ∑ w ∈ IW, (qXY x y * qXW x w) / qX x) =
              ((∑ y ∈ IY, qXY x y) * (∑ w ∈ IW, qXW x w)) / qX x := by
            simp only [div_eq_mul_inv, ← Finset.sum_mul, ← Finset.mul_sum]
          rw [h_fact, h_sum_IY x, h_sum_IW x]
          by_cases hq0 : qX x = 0
          · simp [hq0]
          · rw [mul_div_cancel_right₀ (qX x) hq0]
        have h_sum_IX : ∑ x ∈ IX, qX x = 1 := by
          dsimp [qX]
          rw [Finset.sum_comm]
          have h_eq : (∑ ω ∈ S_pos, ∑ x ∈ IX, if X ω = x then π ω else 0) = ∑ ω ∈ S_pos, π ω := by
            refine Finset.sum_congr rfl (fun ω hω => ?_)
            rw [Finset.sum_ite_eq IX (X ω) (fun _ => π ω)]
            exact ite_eq_left_iff.mpr (fun h => absurd (Finset.mem_image_of_mem X hω) h)
          rw [h_eq, h_S_one]
        exact le_trans (Finset.sum_le_sum h_prod_x) h_sum_IX.le
      unfold finCondEntropy
      rw [h_sum_S (condSurprise ε π (fun ω' => (X ω', W ω')) Y),
          h_sum_S (condSurprise ε π X Y)]
      have h_sum_diff := Finset.sum_le_sum h_diff_ge
      rw [Finset.sum_sub_distrib, ← Finset.sum_div, Finset.sum_sub_distrib, h_S_one] at h_sum_diff
      have h_nn_lhs : 0 ≤ (1 - ∑ ω ∈ S_pos,
          π ω * ((finProbAt2 π X Y ω * finProbAt π (fun ω' => (X ω', W ω')) ω) /
            (finProbAt π X ω * finProbAt2 π (fun ω' => (X ω', W ω')) Y ω))) / Real.log (ε⁻¹) :=
        div_nonneg (sub_nonneg.mpr h_sum_u_le1) hell.le
      linarith
    have h_fiber_cap : ∀ {N_ω : ℕ} {α β : Type} [DecidableEq β] (ε M : ℝ)
        (π : Fin N_ω → ℝ) (X : Fin N_ω → α) (Y : Fin N_ω → β) (F : α → Finset β),
        0 < ε → ε < 1 / 2 → 1 ≤ M →
        (∀ ω, 0 ≤ π ω) → (∑ ω : Fin N_ω, π ω = 1) →
        (∀ x, ((F x).card : ℝ) ≤ M) →
        (∀ ω, 0 < π ω → Y ω ∈ F (X ω)) →
        finCondEntropy ε π X Y ≤ Real.log M / Real.log (ε⁻¹) := by
      intro N_ω α β _ ε M π X Y F hε0 hε1 hM1 hπ_nn hπ_sum hF_card hF_mem
      have hell := h_ell_pos ε hε0 hε1
      let S_pos : Finset (Fin N_ω) :=
        @Finset.filter (Fin N_ω) (fun ω => 0 < π ω) (fun ω => Classical.propDecidable _) Finset.univ
      have h_mem_S : ∀ ω, ω ∈ S_pos ↔ 0 < π ω := by
        intro ω; simp [S_pos]
      have h_zero_out : ∀ ω ∉ S_pos, π ω = 0 := by
        intro ω hω
        rw [h_mem_S, not_lt] at hω
