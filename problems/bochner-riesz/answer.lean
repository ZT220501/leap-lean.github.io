                have hw_le' : ‖w_fn b₂‖ ≤ 16 := by
                  dsimp [w_fn]; rwa [h_sdir_norm s_dir _ hs_dir]
                calc ‖w_fn b₂‖ * |Δ_fn b₁ b₂|
