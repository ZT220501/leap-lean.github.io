    exact le_trans h_sig_le1 (by rw [h_eq_s]; exact mul_le_mul_of_nonneg_right h_inv_s2 hs.le)

  let R_strip : Set (ℝ × ℝ) :=
    Set.Icc (-(B_cell + 1) * σ) ((B_cell + 1) * σ) ×ˢ
