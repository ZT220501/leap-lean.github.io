      simp [δA, A_raw, d₁₀]
    rw [h0, mul_sub, mul_div_cancel₀ _ h8d₁₀Δ_ne]
  have hδA1_sc : (8 * d₁₁ * Δ_r) * δA 1 =
      (Z_r - Z_bar) - (1 / 2 : ℝ) * Δ_r * (W - W_bar) - (8 * d₁₁ * Δ_r) * A_D 1 := by
    have h1 : δA 1 = ((Z_r - Z_bar) - (1 / 2 : ℝ) * Δ_r * (W - W_bar)) / (8 * d₁₁ * Δ_r) - A_D 1 := by
      simp [δA, A_raw, d₁₁]
    rw [h1, mul_sub, mul_div_cancel₀ _ h8d₁₁Δ_ne]
  have hVp_diff0 : (V_p - V_G) 0 = 8 * (d₁₀ * δV 0) := by
    change V_p 0 - V_G 0 = 8 * (d₁₀ * δV 0)
    rw [hVG0]
    dsimp [VG₀, X] at hδV0_sc ⊢
    linarith
  have hVp_diff1 : (V_p - V_G) 1 = 8 * (R_bar * d₁₀ * δV 0 + d₁₁ * δV 1) := by
    change V_p 1 - V_G 1 = 8 * (R_bar * d₁₀ * δV 0 + d₁₁ * δV 1)
    rw [hVG1]
    have h1 : 8 * (R_bar * d₁₀ * δV 0 + d₁₁ * δV 1) =
        R_bar * (8 * d₁₀ * δV 0) + 8 * d₁₁ * δV 1 := by ring
    rw [h1, hδV0_sc, hδV1_sc]
    dsimp [VG₁, VG₀, W, X]
    ring
  have hδU0_sc : 8 * Δ_r * (d₁₀ * δU 0) = Y_r - XG₀ := by
    have h0 : δU 0 = δA 0 + (1 / 2 : ℝ) * δV 0 := by simp [δU]
    rw [h0]
    have h_lin : 8 * Δ_r * (d₁₀ * (δA 0 + (1 / 2 : ℝ) * δV 0)) =
        (8 * d₁₀ * Δ_r) * δA 0 + (1 / 2 : ℝ) * Δ_r * (8 * d₁₀ * δV 0) := by ring
    rw [h_lin, hδA0_sc, hδV0_sc]
    dsimp [XG₀]
    ring
  have hδU1_sc : 8 * Δ_r * (d₁₁ * δU 1) =
      (Z_r - Z_bar) - 8 * Δ_r * d₁₁ * (A_D 1 + (1 / 2 : ℝ) * V_D 1) := by
    have h1 : δU 1 = δA 1 + (1 / 2 : ℝ) * δV 1 := by simp [δU]
    rw [h1]
    have h_lin : 8 * Δ_r * (d₁₁ * (δA 1 + (1 / 2 : ℝ) * δV 1)) =
