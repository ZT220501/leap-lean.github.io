                      (‖iteratedDeriv (i + 1) Ψ t‖ * ‖iteratedDeriv (n + 1 - (i + 1)) h t‖) := by ring
                _ ≤ (((n + 1).choose (i + 1) : ℕ) : ℝ) * (D_phase (i + 1) * K_maj B n) :=
