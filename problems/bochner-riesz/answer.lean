            (Complex.continuous_ofReal.comp
              (((continuous_const (y := -lam_sys)).mul hc_phi).add
                ((continuous_const (y := Real.pi / 2)).mul hc_inn))))
        exact ((continuous_const (y := (4 : ℂ)⁻¹ * (ρ₀_at⁻¹ : ℂ))).mul hc_pou).mul hc_exp
