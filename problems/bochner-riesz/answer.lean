    have hL_norm : ‖L‖ ≤ 9 := by
      apply ContinuousLinearMap.opNorm_le_bound _ (by norm_num)
      intro vp
      dsimp [L]
      calc ‖(8 : ℝ) • vp.2 - (1 / 4 : ℝ) • vp.1‖
          ≤ ‖(8 : ℝ) • vp.2‖ + ‖(1 / 4 : ℝ) • vp.1‖ := norm_sub_le _ _
        _ = 8 * ‖vp.2‖ + (1 / 4) * ‖vp.1‖ := by
