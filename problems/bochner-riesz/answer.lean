          (3 / 2) * ((∑ s : Fin M_split, α s * (∑ o : Fin N_O, p_cd_O s o * Real.log (m_obs o))) / ell) +
          (1 / 2) * (∑ s : Fin M_split, α s *
            (∑ d : Fin N_D, p_cd_D s d * ((1 + γ) * b_D d + (1 - γ) * a_D d))) := by
        dsimp only [Score, generalPacketScore]
        simp_rw [mul_add, Finset.sum_add_distrib]
        refine congrArg₂ (· + ·) (congrArg₂ (· + ·) (congrArg₂ (· + ·) ?_ ?_) ?_) ?_
        · rw [Finset.sum_div]
          exact Finset.sum_congr rfl (fun s _ => (mul_div_assoc _ _ _).symm)
        · rw [Finset.sum_div, Finset.mul_sum]
