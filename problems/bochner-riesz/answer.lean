    let S := ∑ y, P x y
    have hS_term : -(S * Real.log S) = ∑ y, -(P x y * Real.log S) := by
      simp only [S, Finset.sum_mul, Finset.sum_neg_distrib]
    change -(S * Real.log S) ≤ ∑ y, -(P x y * Real.log (P x y))
    rw [hS_term]
    refine Finset.sum_le_sum (fun y _ => ?_)
    by_cases hy0 : P x y = 0
    · simp [hy0]
    · have hy_pos : 0 < P x y := lt_of_le_of_ne (hP x y) (Ne.symm hy0)
      have hle : P x y ≤ S := Finset.single_le_sum (fun y' _ => hP x y') (Finset.mem_univ y)
      have hlog := Real.log_le_log hy_pos hle
      nlinarith

