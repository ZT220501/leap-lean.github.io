        have h_sub_mem : ∀ β : Fin N, β ∈ S'.filter (fun β => Φ_cell β = q) →
            ‖V β - v₀‖ ≤ ρ₀ ∧ ‖X β - x₀‖ ≤ (lam * ρ₀)⁻¹ := by
          intro β hβ
