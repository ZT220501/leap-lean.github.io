          _ = cls.B_sys * (ε ^ (-(r + b_star)) * ε ^ (ex + t)) := by ring
          _ = cls.B_sys * ε ^ (ex - b_star + 2 * h) := by
              rw [← Real.rpow_add hε₀, hexp_eq]
      have hwV3_b := hwV3_proj (e_D d) (b_D d) hVo_b
      have hwV3_a := hwV3_proj (perp2D (e_D d)) (a_D d) hVo_a
      have hwX3_b := hwX3_proj (e_D d) (b_D d) hXo_b
      have hwX3_a := hwX3_proj (perp2D (e_D d)) (a_D d) hXo_a
