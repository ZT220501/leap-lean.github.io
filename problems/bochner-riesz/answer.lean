      have h_id : (q₁ - q₀) - δ₀ * L_ζ = (q₁ - L₁) - (q₀ - L₀) := by linarith only [h_lin_diff]
      rw [h_id]
      calc |(q₁ - L₁) - (q₀ - L₀)|
          ≤ |q₁ - L₁| + |q₀ - L₀| := abs_sub _ _
        _ ≤ ε_sm + ε_sm := add_le_add hb1 hb0
        _ = η_a * δ₀ := by dsimp [ε_sm]; ring
    have h_scale : (F (planeEmbed n c (i, u + t₀ * h_seq idx) + (δ₀ * h_seq idx) • ζ) -
        F (planeEmbed n c (i, u + t₀ * h_seq idx))) / (δ₀ * h_seq idx) - L_ζ =
        ((q₁ - q₀) - δ₀ * L_ζ) / δ₀ := by
      dsimp [q₁, q₀]
      field_simp [hh_idx.ne', hδ₀_pos.ne']
      ring
    rw [h_scale, abs_div, abs_of_pos hδ₀_pos, div_le_iff₀ hδ₀_pos]
    exact h_sub_abs
  
  let M_fn : ℕ → ℕ := fun l => l + 2
  let η_stage : ℕ → ℝ := fun l => 1 / (1024 * ((l : ℝ) + 10))
