          obtain ⟨hα_near, hα_not_in⟩ := Finset.mem_sdiff.mp hα
          have hα_TP : α ∈ T_P := hS_sub_TP hα_near
          have hV_hi : ‖V_at α - V_O o‖ ≤ R_disk := by
