      have h_vol : MeasureTheory.volume.real I_n = 2 * (B_cell + 1) * σ := by
        dsimp only [I_n]
        rw [MeasureTheory.Measure.real_def, Real.volume_Icc,
          ENNReal.toReal_ofReal (by nlinarith [hB, hσ_pos])]
