          ∑ j : Fin n, q j * (-F_VL j (i, u)) := by
        have h_rew :
            (∑ j : Fin n, q j * (-D_u j (i, u) + c j * D_i j (i, u))) =
            (∑ j : Fin n, ∑ k : Fin n, q j * (c k - c j) * (-F_LL k j (i, u))) +
            ∑ j : Fin n, q j * (-F_VL j (i, u)) := by
          rw [← Finset.sum_add_distrib]
          refine Finset.sum_congr rfl fun j _ => ?_
          dsimp [D_u, D_i]
          have h1 : c j * ∑ k : Fin n, F_LL k j (i, u) =
              ∑ k : Fin n, c j * F_LL k j (i, u) := Finset.mul_sum _ _ _
          have h2 : -(∑ k : Fin n, c k * F_LL k j (i, u)) +
              ∑ k : Fin n, c j * F_LL k j (i, u) =
              ∑ k : Fin n, (c k - c j) * (-F_LL k j (i, u)) := by
            rw [← Finset.sum_neg_distrib, ← Finset.sum_add_distrib]
            exact Finset.sum_congr rfl fun k _ => by ring
          have h3 : q j * ∑ k : Fin n, (c k - c j) * (-F_LL k j (i, u)) =
