          (hasDerivAt_id τ).const_mul C_m
        rw [mul_one] at h1
        exact (hψ_d τ).sub h1
      have h_anti := antitone_of_deriv_nonpos (fun τ => (hφ₁_d τ).differentiableAt)
        (fun τ => by rw [(hφ₁_d τ).deriv]; linarith [(abs_le.mp (hH_bound m τ y)).2])
        (zero_le_one : (0 : ℝ) ≤ 1)
