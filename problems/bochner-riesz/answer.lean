        have hdY : |Y - Y_bar g| ≤ ε ^ (b' + u) := by rw [hYbar_eq]; exact (h_real_mid (b' + u) Y).le
        have hdW : |W - W_bar g| ≤ ε ^ a' := by rw [hWbar_eq]; exact (h_real_mid a' W).le
        have hdZ : |Z - Z_bar g| ≤ ε ^ (a' + u) := by rw [hZbar_eq]; exact (h_real_mid (a' + u) Z).le
        have h_proj_pair : ∀ (u_vec : EuclideanSpace ℝ (Fin 2)) (δ₁ δ₂ e₁ e₂ : ℝ),
            e₁ ≤ e₂ →
            u_vec 0 = δ₁ → u_vec 1 = δ₂ + R_bar g * δ₁ →
            |δ₁| ≤ ε ^ e₁ → |δ₂| ≤ ε ^ e₂ →
            |inner ℝ u_vec (e_G g)| ≤ 4 * ε ^ e₁ ∧
            |inner ℝ u_vec (perp2D (e_G g))| ≤ 4 * ε ^ e₂ := by
          intro u_vec δ₁ δ₂ e₁ e₂ he12 hu0 hu1 hδ1 hδ2
          obtain ⟨hs0_le, hs1_le⟩ := hs_abs_le1 g
          have hexp_le : ε ^ e₂ ≤ ε ^ e₁ := Real.rpow_le_rpow_of_exponent_ge hε₀ hε_le1 he12
          have h_in_par : inner ℝ u_vec (e_G g) =
              δ₁ * s_inv g + (δ₂ + R_bar g * δ₁) * (R_bar g * s_inv g) := by
            rw [PiLp.inner_apply, Fin.sum_univ_two]
            change inner ℝ (u_vec 0) (s_inv g) + inner ℝ (u_vec 1) (R_bar g * s_inv g) = _
            rw [hu0, hu1]
            simp only [RCLike.inner_apply, conj_trivial]
            ring
          have h_in_perp : inner ℝ u_vec (perp2D (e_G g)) = δ₂ * s_inv g := by
            rw [PiLp.inner_apply, Fin.sum_univ_two]
            change inner ℝ (u_vec 0) (-(R_bar g * s_inv g)) + inner ℝ (u_vec 1) (s_inv g) = _
            rw [hu0, hu1]
            simp only [RCLike.inner_apply, conj_trivial]
            ring
          constructor
          · rw [h_in_par]
            have ht1 : |δ₁ * s_inv g| ≤ ε ^ e₁ := by
              rw [abs_mul]
              calc |δ₁| * |s_inv g| ≤ ε ^ e₁ * 1 :=
                    mul_le_mul hδ1 hs0_le (abs_nonneg _) (Real.rpow_nonneg hε₀.le _)
                _ = ε ^ e₁ := mul_one _
            have ht2 : |(δ₂ + R_bar g * δ₁) * (R_bar g * s_inv g)| ≤ 3 * ε ^ e₁ := by
              rw [abs_mul]
              have hsum_d : |δ₂ + R_bar g * δ₁| ≤ 3 * ε ^ e₁ := by
                have hRδ : |R_bar g * δ₁| ≤ 2 * ε ^ e₁ := by
                  rw [abs_mul]
                  exact mul_le_mul hRbar_abs hδ1 (abs_nonneg _) (by norm_num)
                linarith [abs_add_le δ₂ (R_bar g * δ₁)]
              calc |δ₂ + R_bar g * δ₁| * |R_bar g * s_inv g|
                  ≤ (3 * ε ^ e₁) * 1 :=
                    mul_le_mul hsum_d hs1_le (abs_nonneg _) (by positivity)
                _ = 3 * ε ^ e₁ := mul_one _
            linarith [abs_add_le (δ₁ * s_inv g) ((δ₂ + R_bar g * δ₁) * (R_bar g * s_inv g))]
          · rw [h_in_perp, abs_mul]
            have h1 : |δ₂| * |s_inv g| ≤ ε ^ e₂ := by
              calc |δ₂| * |s_inv g| ≤ ε ^ e₂ * 1 :=
                    mul_le_mul hδ2 hs0_le (abs_nonneg _) (Real.rpow_nonneg hε₀.le _)
                _ = ε ^ e₂ := mul_one _
            have hpos : 0 ≤ ε ^ e₂ := Real.rpow_nonneg hε₀.le _
            linarith
        have hV_pair := h_proj_pair (V_part tid - V_G g) (X - X_bar g) (W - W_bar g) b' a' hba
          (by change (V_part tid) 0 - X_bar g = X - X_bar g; rfl)
          (by
            change (V_part tid) 1 - (W_bar g + R_bar g * X_bar g) =
              (W - W_bar g) + R_bar g * (X - X_bar g)
            dsimp [W]; ring)
          hdX hdW
        have hX_pair := h_proj_pair ((A_part tid + c_mid • V_part tid) - X_G g)
          (Y - Y_bar g) (Z - Z_bar g) (b' + u) (a' + u) (by linarith)
          (by change (A_part tid) 0 + c_mid * (V_part tid) 0 - Y_bar g = Y - Y_bar g; rfl)
          (by
            change (A_part tid) 1 + c_mid * (V_part tid) 1 - (Z_bar g + R_bar g * Y_bar g) =
              (Z - Z_bar g) + R_bar g * (Y - Y_bar g)
            dsimp [Z]; ring)
          hdY hdZ
        exact ⟨h_cmid_mem, hkG_eq, hV_pair.1, hV_pair.2, hX_pair.1, hX_pair.2⟩)
    suffices h_score_eq : classicalTransportScore ε γ N_ω N_T N_G π T_idx k_time G_idx b_G a_G =
        ((1 + γ) * b' + (1 - γ) * a') - finMutualInfo ε π T_idx O_ba +
          2 * finCondEntropy ε π T_idx k_time by
      linarith
    unfold classicalTransportScore
    let p_T : Fin N_T → ℝ := fun tid => ∑ ω : Fin N_ω, if T_idx ω = tid then π ω else 0
    let p_G : Fin N_G → ℝ := fun g => ∑ ω : Fin N_ω, if G_idx ω = g then π ω else 0
    let p_TG : Fin N_T → Fin N_G → ℝ := fun tid g =>
      ∑ ω : Fin N_ω, if T_idx ω = tid ∧ G_idx ω = g then π ω else 0
    let S_cells : Finset ℤ := Finset.univ.image k_time
    let p_TC : Fin N_T → ℤ → ℝ := fun tid k =>
      ∑ ω : Fin N_ω, if T_idx ω = tid ∧ k_time ω = k then π ω else 0
    have hEw : (∑ g : Fin N_G, p_G g * ((1 + γ) * b_G g + (1 - γ) * a_G g)) =
        (1 + γ) * b' + (1 - γ) * a' := by
      dsimp [b_G, a_G]
      rw [← Finset.sum_mul]
      have hpG_sum : ∑ g : Fin N_G, p_G g = 1 := by
        dsimp [p_G]
        rw [Finset.sum_comm]
        have h1 : ∀ ω : Fin N_ω, (∑ g : Fin N_G, if G_idx ω = g then π ω else 0) = π ω := by
          intro ω; simp
        simp only [h1, hπ_sum]
      rw [hpG_sum, one_mul]
    have hpT_eq : ∀ ω : Fin N_ω, finProbAt π T_idx ω = p_T (T_idx ω) := by
      intro ω; unfold finProbAt; dsimp [p_T]
      refine Finset.sum_congr rfl (fun ω' _ => ?_)
      by_cases h : T_idx ω' = T_idx ω <;> simp [h]
    have hpTC_eq : ∀ ω : Fin N_ω, finProbAt2 π T_idx k_time ω = p_TC (T_idx ω) (k_time ω) := by
      intro ω; unfold finProbAt2; dsimp [p_TC]
      refine Finset.sum_congr rfl (fun ω' _ => ?_)
      by_cases h1 : T_idx ω' = T_idx ω <;> by_cases h2 : k_time ω' = k_time ω <;> simp [h1, h2]
    have hSt : (∑ tid : Fin N_T, ∑ k ∈ S_cells,
        -(p_TC tid k * Real.log (p_TC tid k / p_T tid))) / ell =
        finCondEntropy ε π T_idx k_time := by
      have hrhs : finCondEntropy ε π T_idx k_time =
          (∑ ω : Fin N_ω, -(π ω * Real.log (p_TC (T_idx ω) (k_time ω) / p_T (T_idx ω)))) / ell := by
        unfold finCondEntropy condSurprise
        rw [Finset.sum_div]
        refine Finset.sum_congr rfl (fun ω _ => ?_)
        change π ω * (-(Real.log (finProbAt2 π T_idx k_time ω / finProbAt π T_idx ω)) / ell) = _
        rw [hpTC_eq, hpT_eq]
        ring
      rw [hrhs]
      congr 1
      have h_maps : ∀ ω ∈ (Finset.univ : Finset (Fin N_ω)),
          (T_idx ω, k_time ω) ∈ (Finset.univ : Finset (Fin N_T)) ×ˢ S_cells := fun ω hω =>
        Finset.mem_product.mpr ⟨Finset.mem_univ _, Finset.mem_image_of_mem k_time hω⟩
      rw [← Finset.sum_fiberwise_of_maps_to h_maps, Finset.sum_product]
      refine Finset.sum_congr rfl (fun tid _ => ?_)
      refine Finset.sum_congr rfl (fun k _ => ?_)
      have h_eq1 : (∑ ω ∈ Finset.univ.filter (fun ω => (T_idx ω, k_time ω) = (tid, k)),
          -(π ω * Real.log (p_TC (T_idx ω) (k_time ω) / p_T (T_idx ω)))) =
          ∑ ω ∈ Finset.univ.filter (fun ω => (T_idx ω, k_time ω) = (tid, k)),
            π ω * (-Real.log (p_TC tid k / p_T tid)) := by
        refine Finset.sum_congr rfl (fun ω hω => ?_)
        have htk := (Finset.mem_filter.mp hω).2
        rcases Prod.ext_iff.mp htk with ⟨ht, hk⟩
        dsimp at ht hk
        rw [ht, hk]
        ring
      rw [h_eq1, ← Finset.sum_mul]
      have h_sum_pTC : (∑ ω ∈ Finset.univ.filter (fun ω => (T_idx ω, k_time ω) = (tid, k)), π ω) =
          p_TC tid k := by
        dsimp [p_TC]
        rw [Finset.sum_filter]
        refine Finset.sum_congr rfl (fun ω _ => ?_)
        simp [Prod.ext_iff]
      rw [h_sum_pTC]
      ring
    have hITG : (∑ tid : Fin N_T, ∑ g : Fin N_G,
        p_TG tid g * Real.log (p_TG tid g / (p_T tid * p_G g))) / ell =
        finMutualInfo ε π T_idx O_ba := by
      have h_mi_G : finMutualInfo ε π T_idx O_ba = finMutualInfo ε π T_idx G_idx := by
        unfold finMutualInfo
        rw [h_equiv (fun _ => ()) O_ba (fun _ => ()) G_idx
            (fun ω₁ ω₂ _ _ => ⟨Iff.rfl, fun _ => (hG_iff ω₁ ω₂).symm⟩),
          h_equiv T_idx O_ba T_idx G_idx
            (fun ω₁ ω₂ _ _ => ⟨Iff.rfl, fun _ => (hG_iff ω₁ ω₂).symm⟩)]
      rw [h_mi_G]
      have hpU_eq : ∀ ω : Fin N_ω, finProbAt π (fun _ => ()) ω = 1 := by
        intro ω; unfold finProbAt; simp [hπ_sum]
      have hpG_eq : ∀ ω : Fin N_ω, finProbAt2 π (fun _ => ()) G_idx ω = p_G (G_idx ω) := by
        intro ω; unfold finProbAt2; dsimp [p_G]
        refine Finset.sum_congr rfl (fun ω' _ => ?_)
        by_cases h : G_idx ω' = G_idx ω <;> simp [h]
      have hpTG_eq : ∀ ω : Fin N_ω, finProbAt2 π T_idx G_idx ω = p_TG (T_idx ω) (G_idx ω) := by
        intro ω; unfold finProbAt2; dsimp [p_TG]
        refine Finset.sum_congr rfl (fun ω' _ => ?_)
        by_cases h1 : T_idx ω' = T_idx ω <;> by_cases h2 : G_idx ω' = G_idx ω <;> simp [h1, h2]
      have hrhs : finMutualInfo ε π T_idx G_idx =
          (∑ ω : Fin N_ω, π ω *
            Real.log (p_TG (T_idx ω) (G_idx ω) / (p_T (T_idx ω) * p_G (G_idx ω)))) / ell := by
        unfold finMutualInfo finCondEntropy condSurprise
        rw [← Finset.sum_sub_distrib, Finset.sum_div]
        refine Finset.sum_congr rfl (fun ω _ => ?_)
        by_cases hω : 0 < π ω
        · have hpTG_pos : 0 < p_TG (T_idx ω) (G_idx ω) := by
            have hle : π ω ≤ p_TG (T_idx ω) (G_idx ω) := by
              dsimp [p_TG]
              have hs : π ω = (if T_idx ω = T_idx ω ∧ G_idx ω = G_idx ω then π ω else 0) := by simp
              rw [hs]
              exact Finset.single_le_sum
                (f := fun ω' => if T_idx ω' = T_idx ω ∧ G_idx ω' = G_idx ω then π ω' else 0)
                (fun ω' _ => by split_ifs <;> linarith [hπ_nn ω']) (Finset.mem_univ ω)
            exact lt_of_lt_of_le hω hle
          have hpT_pos : 0 < p_T (T_idx ω) := by
            have hle : p_TG (T_idx ω) (G_idx ω) ≤ p_T (T_idx ω) := by
              dsimp [p_TG, p_T]
              refine Finset.sum_le_sum (fun ω' _ => ?_)
              by_cases h1 : T_idx ω' = T_idx ω
              · by_cases h2 : G_idx ω' = G_idx ω <;> simp [h1, h2, hπ_nn ω']
              · simp [h1]
            exact lt_of_lt_of_le hpTG_pos hle
          have hpG_pos : 0 < p_G (G_idx ω) := by
            have hle : p_TG (T_idx ω) (G_idx ω) ≤ p_G (G_idx ω) := by
              dsimp [p_TG, p_G]
              refine Finset.sum_le_sum (fun ω' _ => ?_)
              by_cases h2 : G_idx ω' = G_idx ω
              · by_cases h1 : T_idx ω' = T_idx ω <;> simp [h1, h2, hπ_nn ω']
              · simp [h2]
            exact lt_of_lt_of_le hpTG_pos hle
          change π ω * (-(Real.log (finProbAt2 π (fun _ => ()) G_idx ω /
              finProbAt π (fun _ => ()) ω)) / ell) -
            π ω * (-(Real.log (finProbAt2 π T_idx G_idx ω / finProbAt π T_idx ω)) / ell) = _
          rw [hpG_eq, hpU_eq, hpTG_eq, hpT_eq, div_one]
          have h_div_eq : (p_TG (T_idx ω) (G_idx ω) / p_T (T_idx ω)) / p_G (G_idx ω) =
              p_TG (T_idx ω) (G_idx ω) / (p_T (T_idx ω) * p_G (G_idx ω)) := div_div _ _ _
          have h_log : Real.log (p_TG (T_idx ω) (G_idx ω) / (p_T (T_idx ω) * p_G (G_idx ω))) =
              Real.log (p_TG (T_idx ω) (G_idx ω) / p_T (T_idx ω)) - Real.log (p_G (G_idx ω)) := by
            rw [← h_div_eq, Real.log_div (ne_of_gt (div_pos hpTG_pos hpT_pos)) (ne_of_gt hpG_pos)]
          rw [h_log]
          ring
        · have hz := hπ_zero_of_not_pos ω hω
          change π ω * (-(Real.log (finProbAt2 π (fun _ => ()) G_idx ω /
              finProbAt π (fun _ => ()) ω)) / ell) -
            π ω * (-(Real.log (finProbAt2 π T_idx G_idx ω / finProbAt π T_idx ω)) / ell) = _
          rw [hz]
          ring
      rw [hrhs]
      congr 1
      have h_maps : ∀ ω ∈ (Finset.univ : Finset (Fin N_ω)),
          (T_idx ω, G_idx ω) ∈ (Finset.univ : Finset (Fin N_T)) ×ˢ (Finset.univ : Finset (Fin N_G)) :=
        fun _ _ => Finset.mem_product.mpr ⟨Finset.mem_univ _, Finset.mem_univ _⟩
      rw [← Finset.sum_fiberwise_of_maps_to h_maps, Finset.sum_product]
      refine Finset.sum_congr rfl (fun tid _ => ?_)
      refine Finset.sum_congr rfl (fun g _ => ?_)
      have h_eq1 : (∑ ω ∈ Finset.univ.filter (fun ω => (T_idx ω, G_idx ω) = (tid, g)),
          π ω * Real.log (p_TG (T_idx ω) (G_idx ω) / (p_T (T_idx ω) * p_G (G_idx ω)))) =
          ∑ ω ∈ Finset.univ.filter (fun ω => (T_idx ω, G_idx ω) = (tid, g)),
            π ω * Real.log (p_TG tid g / (p_T tid * p_G g)) := by
        refine Finset.sum_congr rfl (fun ω hω => ?_)
        have htg := (Finset.mem_filter.mp hω).2
        rcases Prod.ext_iff.mp htg with ⟨ht, hg⟩
        dsimp at ht hg
        rw [ht, hg]
      rw [h_eq1, ← Finset.sum_mul]
      congr 1
      dsimp [p_TG]
      rw [Finset.sum_filter]
      refine Finset.sum_congr rfl (fun ω _ => ?_)
      simp [Prod.ext_iff]
    change (∑ g : Fin N_G, p_G g * ((1 + γ) * b_G g + (1 - γ) * a_G g)) -
      (∑ tid : Fin N_T, ∑ g : Fin N_G,
        p_TG tid g * Real.log (p_TG tid g / (p_T tid * p_G g))) / ell +
      2 * ((∑ tid : Fin N_T, ∑ k ∈ S_cells,
        -(p_TC tid k * Real.log (p_TC tid k / p_T tid))) / ell) = _
    rw [hEw, hITG, hSt]

theorem row_localization_forward_score_bound (γ m ε r t b_t : ℝ)
    (hγ₀ : 0 < γ) (hγ₁ : γ < 1) (hm : 0 < m)
    (hε₀ : 0 < ε) (hε₁ : ε < 1 / 2)
    (hr₀ : 0 < r) (hrt : r < t) (ht₁ : t < 1)
    (hε_tilde : ε ^ (t - r) < 1 / 2)
    (hb₀ : 0 ≤ b_t)
    {N_ω N_T : ℕ}
    (π : Fin N_ω → ℝ) (T_idx : Fin N_ω → Fin N_T)
    (V_part A_part : Fin N_T → EuclideanSpace ℝ (Fin 2))
    (c_s R_s : Fin N_ω → ℝ)
    (hπ_nn : ∀ ω, 0 ≤ π ω)
    (hπ_sum : ∑ ω : Fin N_ω, π ω = 1)
    (hVA : ∀ tid, ‖V_part tid‖ ≤ 1 ∧ ‖A_part tid‖ ≤ 1)
    (hcR : ∀ ω, 0 < π ω → c_s ω ∈ Set.Icc (0 : ℝ) 1 ∧ |R_s ω| ≤ 1) :
    let J := fun ω : Fin N_ω =>
      rowGrowthCell ε m r t b_t (V_part (T_idx ω)) (A_part (T_idx ω)) (c_s ω) (R_s ω)
    let S_J : Finset (ℤ × ℤ × ℤ × ℤ × ℤ × ℤ) :=
      (Finset.univ.filter (fun ω : Fin N_ω => 0 < π ω)).image J
    let p_J := fun j => ∑ ω : Fin N_ω, if J ω = j then π ω else 0
    let π_j := fun j => rowGrowthRestrictLaw π (Finset.univ.filter (fun ω => J ω = j))
    let V_j := fun j tid => rowGrowthLocVel ε m t b_t j (V_part tid)
    let A_j := fun j tid => rowGrowthLocPos ε m r t b_t j (V_part tid) (A_part tid)
    let c_j := fun j ω => rowGrowthLocTime ε r j.1 (c_s ω)
    (∀ j ∈ S_J, 0 < p_J j ∧
      (∀ ω, 0 ≤ π_j j ω) ∧ (∑ ω : Fin N_ω, π_j j ω = 1) ∧
      (∀ tid, ‖V_j j tid‖ ≤ 1 ∧ ‖A_j j tid‖ ≤ 1) ∧
      (∀ ω, 0 < π_j j ω → c_j j ω ∈ Set.Icc (0 : ℝ) 1)) ∧
    finCondEntropy ε π (fun ω => (T_idx ω, dyadicTimeBin ε r (c_s ω))) J =
      finCondEntropy ε π (fun ω => (T_idx ω, dyadicTimeBin ε r (c_s ω)))
        (fun ω => dyadicRealBin ε (m * t) (R_s ω)) ∧
    rowObsScore ε γ m t b_t π T_idx V_part A_part c_s R_s ≤
      ((2 * b_t + (1 - γ) * m * t) -
        finMutualInfo ε π T_idx J +
        2 * finCondEntropy ε π T_idx (fun ω => dyadicTimeBin ε r (c_s ω))) +
      (t - r) * (∑ j ∈ S_J, p_J j *
        stdApertureScore (ε ^ (t - r)) γ 1 0 0 (π_j j) T_idx (V_j j) (A_j j)
          (c_j j) (fun _ => 0)) +
      2 * finCondEntropy ε π (fun ω => (T_idx ω, dyadicTimeBin ε r (c_s ω)))
        (fun ω => dyadicRealBin ε (m * t) (R_s ω)) +
      16 / Real.log (ε⁻¹) :=
by
  intro J S_J p_J π_j V_j A_j c_j
  have ht_pos : 0 < t := lt_trans hr₀ hrt
  have htr_pos : 0 < t - r := sub_pos.mpr hrt
  let ε_tilde : ℝ := ε ^ (t - r)
  have hε_tilde_pos : 0 < ε_tilde := Real.rpow_pos_of_pos hε₀ (t - r)
  have h1_lt_inv : 1 < ε⁻¹ := (one_lt_inv₀ hε₀).mpr (by linarith)
  let ell : ℝ := Real.log (ε⁻¹)
  have hell_pos : 0 < ell := Real.log_pos h1_lt_inv
  have hperp_norm : ∀ v : EuclideanSpace ℝ (Fin 2), ‖perp2D v‖ = ‖v‖ := by
    intro v
    rw [EuclideanSpace.norm_eq, EuclideanSpace.norm_eq, Fin.sum_univ_two, Fin.sum_univ_two]
    have hp0 : (perp2D v) 0 = -(v 1) := rfl
    have hp1 : (perp2D v) 1 = v 0 := rfl
    rw [hp0, hp1, norm_neg, add_comm]
  
  have h_clamp_norm : ∀ w : EuclideanSpace ℝ (Fin 2), ‖rowGrowthClamp2D w‖ ≤ 1 := by
    intro w
    unfold rowGrowthClamp2D
    split_ifs with hw
    · exact hw
    · simp
  have h_clamp_id : ∀ (w0 w1 : ℝ), |w0| ≤ 1 / 2 → |w1| ≤ 1 / 2 →
      rowGrowthClamp2D (WithLp.toLp 2 ![w0, w1]) = WithLp.toLp 2 ![w0, w1] := by
    intro w0 w1 hw0 hw1
    have hnorm : ‖(WithLp.toLp 2 ![w0, w1] : EuclideanSpace ℝ (Fin 2))‖ ≤ 1 := by
      rw [EuclideanSpace.norm_eq, Fin.sum_univ_two]
      simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Real.norm_eq_abs, sq_abs]
      have hs0 : w0 ^ 2 ≤ (1 / 2) ^ 2 :=
        sq_le_sq.mpr (by rwa [abs_of_pos (by norm_num : (0 : ℝ) < 1 / 2)])
      have hs1 : w1 ^ 2 ≤ (1 / 2) ^ 2 :=
        sq_le_sq.mpr (by rwa [abs_of_pos (by norm_num : (0 : ℝ) < 1 / 2)])
      exact Real.sqrt_le_one.mpr (by linarith)
    unfold rowGrowthClamp2D
    exact ite_cond_eq_true _ _ (eq_true hnorm)
  
  have h_step : ∀ (δ u : ℝ), 0 < δ → δ < 1 / 2 → 0 < u →
      let m_u := dyadicTimeLevel δ u
      let Δ_u := ((2 : ℝ) ^ m_u)⁻¹
      0 < Δ_u ∧ Δ_u ≤ δ ^ u ∧ (1 / 2 : ℝ) * δ ^ u < Δ_u := by
    intro δ u hδ₀ hδ₁ hu
    let m_u := dyadicTimeLevel δ u
    let Δ_u : ℝ := ((2 : ℝ) ^ m_u)⁻¹
    have h2m_pos : (0 : ℝ) < (2 : ℝ) ^ m_u := by positivity
    have hΔ_pos : 0 < Δ_u := inv_pos.mpr h2m_pos
    have hδ_lt1 : δ < 1 := by linarith
