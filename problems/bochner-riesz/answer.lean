      intro q₁ hq₁ q₂ hq₂ hq₁₂
      have hf₁ := h_dyad_time q₁ hq₁.1 hq₁.2
      have hf₂ := h_dyad_time q₂ hq₂.1 hq₂.2
      have h_mono : S_dyad q₁ ≤ S_dyad q₂ :=
