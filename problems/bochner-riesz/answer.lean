                dyadicRealBin ε (b₀ + m * u) (w₁' 1 - R_mu1 * w₁' 0)) →
              dyadicRealBin ε b₀ (inner ℝ w₂ e_u1) ∈ I_par ∧
              dyadicRealBin ε (b₀ + m * u) (inner ℝ w₂ (perp2D e_u1)) ∈ I_perp) := by
      intro b₀ w₁
      let w₁' := chartRowVec useChart0 w₁
      let r_norm : ℝ := (48 * (N : ℝ) + 90) * ε ^ (b₀ + m * u - ν)
      obtain ⟨I_X, hIX_c, hIX_m⟩ :=
        h_real_icc ε b₀ (w₁' 0) (4 * ε ^ b₀) hε₀ hε₁ (by positivity)
      obtain ⟨I_W, hIW_c, hIW_m⟩ :=
        h_real_icc ε (b₀ + m * u) (w₁' 1 - R_mu1 * w₁' 0) r_norm hε₀ hε₁ (by positivity)
      obtain ⟨I_par, hIpar_c, hIpar_m⟩ :=
        h_real_icc ε b₀ (inner ℝ w₁ e_u1) (8 * ε ^ b₀) hε₀ hε₁ (by positivity)
      obtain ⟨I_perp, hIperp_c, hIperp_m⟩ :=
        h_real_icc ε (b₀ + m * u) (inner ℝ w₁ (perp2D e_u1)) r_norm hε₀ hε₁ (by positivity)
      have hb_cancel : ε ^ b₀ * ε ^ (-b₀) = 1 := by
        rw [← Real.rpow_add hε₀, add_neg_cancel, Real.rpow_zero]
      have hnorm_cancel : ε ^ (b₀ + m * u - ν) * ε ^ (-(b₀ + m * u)) = ε ^ (-ν) := by
        rw [← Real.rpow_add hε₀]; congr 1; ring
      have hIX_10 : (I_X.card : ℝ) ≤ 10 := by
        have h1 : 2 * (4 * ε ^ b₀) * ε ^ (-b₀) + 2 = 8 * (ε ^ b₀ * ε ^ (-b₀)) + 2 := by ring
        rw [h1, hb_cancel] at hIX_c; linarith
      have hIpar_18 : (I_par.card : ℝ) ≤ 18 := by
        have h1 : 2 * (8 * ε ^ b₀) * ε ^ (-b₀) + 2 = 16 * (ε ^ b₀ * ε ^ (-b₀)) + 2 := by ring
        rw [h1, hb_cancel] at hIpar_c; linarith
      have h_rn_card : 2 * r_norm * ε ^ (-(b₀ + m * u)) + 2 ≤
