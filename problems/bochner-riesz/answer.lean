      have hexp : (|v 0| + |v 1|) ^ 2 = |v 0| ^ 2 + |v 1| ^ 2 + 2 * (|v 0| * |v 1|) := by ring
      have hprod : 0 ≤ |v 0| * |v 1| := mul_nonneg (abs_nonneg _) (abs_nonneg _)
      linarith only [hsq, hexp, hprod]
    have habs := abs_le_of_sq_le_sq' hle (add_nonneg (abs_nonneg _) (abs_nonneg _))
    exact habs.2
  have h_negPerp_norm : ∀ (u : EuclideanSpace ℝ (Fin 2)), ‖negPerp2D u‖ = ‖u‖ := by
    intro u
    have hsq : ‖negPerp2D u‖ ^ 2 = ‖u‖ ^ 2 := by
      rw [PiLp.norm_sq_eq_of_L2, PiLp.norm_sq_eq_of_L2, Fin.sum_univ_two, Fin.sum_univ_two]
