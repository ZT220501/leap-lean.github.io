            ∑ j ∈ S_J, p_J_fn j * finCondEntropy ε (π_j_fn j) (fun _ => ()) (G_loc j) =
              finCondEntropy ε π (fun _ => ()) Y +
                ∑ j ∈ S_J, (p_J_fn j * Real.log (p_J_fn j)) / ell := by
          calc ∑ j ∈ S_J, p_J_fn j * finCondEntropy ε (π_j_fn j) (fun _ => ()) (G_loc j)
