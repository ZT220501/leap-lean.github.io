      have h_ig : (fun v : E =>
          (∑ q ∈ S, c q * pktLinearAtom lam_sys Φ₀ q.1 q.2 v) *
            ψ_o (ρ_obs⁻¹ • (v - V_o)) *
            Complex.exp (Complex.I * ((lam_sys * Φ₀ (C_box, X_o, v) : ℝ) : ℂ))) =
          fun v : E => ∑ q ∈ S, c q * (pktLinearAtom lam_sys Φ₀ q.1 q.2 v * g_o v) := by
        ext v
        dsimp only [g_o]
        rw [mul_assoc, Finset.sum_mul]
        exact Finset.sum_congr rfl (fun q _ => by ring)
      rw [h_ig, MeasureTheory.integral_finsetSum S h_int_q, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun q _ => ?_)
      rw [MeasureTheory.integral_const_mul, ← mul_assoc, mul_comm (ρ_obs⁻¹ : ℂ) (c q), mul_assoc]
      congr 1
      exact congr_arg _ (MeasureTheory.integral_congr_ae
        (Filter.Eventually.of_forall (fun v => by dsimp only [g_o]; ring)))

  
  have h_subset_parseval : ∀ (V_box : Finset (ℤ × ℤ))
      (c : ((ℤ × ℤ) × (ℤ × ℤ)) → ℂ) (E_f : ℝ),
      (∀ j ∈ V_box, Summable (fun n : ℤ × ℤ => ‖c (j, n)‖ ^ 2)) →
      (∑ j ∈ V_box, ∑' n : ℤ × ℤ, ‖c (j, n)‖ ^ 2) = E_f →
      ∀ S : Finset ((ℤ × ℤ) × (ℤ × ℤ)),
        (∀ q ∈ S, q.1 ∈ V_box) → ∑ q ∈ S, ‖c q‖ ^ 2 ≤ E_f := by
    intro V_box c E_f h_sum_j h_parseval S hS_vel
    rw [← Finset.sum_fiberwise_of_maps_to hS_vel (fun q => ‖c q‖ ^ 2), ← h_parseval]
    refine Finset.sum_le_sum (fun j hj => ?_)
    let S_j := S.filter (fun q => q.1 = j)
    let N_j := S_j.image Prod.snd
    have h_img : ∑ q ∈ S_j, ‖c q‖ ^ 2 = ∑ n ∈ N_j, ‖c (j, n)‖ ^ 2 := by
      dsimp only [N_j]
      rw [Finset.sum_image]
      · refine Finset.sum_congr rfl (fun q hq => ?_)
        have hq1 : q.1 = j := (Finset.mem_filter.mp hq).2
        have hpair : (j, q.2) = q := Prod.ext hq1.symm rfl
        rw [hpair]
      · intro q₁ hq₁ q₂ hq₂ h2
        have h1₁ : q₁.1 = j := (Finset.mem_filter.mp hq₁).2
        have h1₂ : q₂.1 = j := (Finset.mem_filter.mp hq₂).2
        exact Prod.ext (h1₁.trans h1₂.symm) h2
    rw [h_img]
    exact (h_sum_j j hj).sum_le_tsum N_j (fun _ _ => sq_nonneg _)

  
  have h_bin_winner : ∀ (ε H_P d lam_sys R_dom ξ A₀ E_f C_Bes C_modes : ℝ)
