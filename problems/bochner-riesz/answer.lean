              field_simp [ne_of_gt hd0_pos, ne_of_gt hd1_pos]
      have h_card_le : (((S'.filter (fun β => Φ_cell β = q)).card : ℕ) : ℝ) ≤ (N_pack : ℝ) := by
        let v₀ : E := V α + gridPt2D ρ₀ q.1
