  have hrpow_anti : ∀ α β : ℝ, α ≤ β → ε ^ β ≤ ε ^ α :=
    fun α β hαβ => Real.rpow_le_rpow_of_exponent_ge hε₀ hε_lt1.le hαβ
  have hrpow_ge1 : ∀ α : ℝ, α ≤ 0 → 1 ≤ ε ^ α := by
