      have hnot_gap := hloc_nf (H_P - r - 2 * b_star) (L - r - b_star)
        (s_c * s_v ^ 2 * lam_sys) (m_t - m_r)
        (localGaugePhase Φ₀ m_r (menu j).loc_idx.1 s_v
          (gridPt2D s_v (menu j).loc_idx.2.1) (gridPt2D s_x (menu j).loc_idx.2.2))
        (localGaugeGrad ζ₀ m_r (menu j).loc_idx.1 s_v
          (gridPt2D s_v (menu j).loc_idx.2.1) (gridPt2D s_x (menu j).loc_idx.2.2))
        _ N_Oj N_D r_loc_O V'_O_loc X'_O_loc ψ_O_loc b'_D a'_D r'_D e_D V'_D X'_D p_loc
        htr_H' hH'_K htr_L' hL'_K hlam_l1 hlam_l2 hm_l1 hm_l2
        hphase_l hmeas_l hsupp_l hl2_l hint_l hadm_ld
        (by
          rw [hsc_loc_eq, hR_dom_d]
          dsimp only [d₃, K_of] at hd3_le ⊢
          linarith only [hd3_le, hR_bud_pos])
      have h_gap_yes := (h_root_each j).2.2 hr_pos hb0 hu_le_Lr hh_pos ζ_g hζ_g h32R
        (by dsimp only [d₂, A_of, K_of] at hd2_le; exact hd2_le) hgt_g
      rw [hν_l, hκ_l, hR_dom_d] at hnot_gap
      exact hnot_gap h_gap_yes
    · intro hr_pos _
      exact h_all_r hr_pos
    · intro hr0 ν κ hgap hb_nu
      have hkr := (h_root_r0 hr0).2 ν κ hgap hb_nu
      dsimp only [d₀]
      rw [hr0, mul_zero, add_zero]
