        have ha_zero : h (-(R_w + 1)) = 0 :=
          hh_supp (-(R_w + 1)) (by rw [abs_neg, abs_of_pos (by linarith)]; linarith)
        have hb_zero : h (R_w + 1) = 0 :=
          hh_supp (R_w + 1) (by rw [abs_of_pos (by linarith)]; linarith)
        rw [ha_zero, hb_zero, zero_mul, zero_mul, sub_zero, zero_sub]
        have h_pull : (fun x : ℝ => deriv h x * g₁ x) =
            (fun x : ℝ => -(Complex.I * (L : ℂ)⁻¹) * (deriv h x * Complex.exp (Complex.I * (θ x : ℂ)))) := by
          ext x
          dsimp [g₁]
          ring
        rw [h_pull, intervalIntegral.integral_const_mul]
        ring
      have h_step_norm : ‖∫ t : ℝ, u t * Complex.exp (Complex.I * (θ t : ℂ))‖ =
          L⁻¹ * ‖∫ t : ℝ, deriv h t * Complex.exp (Complex.I * (θ t : ℂ))‖ := by
        rw [h_ibp_eq, norm_mul, norm_mul, Complex.norm_I, one_mul, norm_inv,
          Complex.norm_real, Real.norm_of_nonneg hL.le]
      rw [h_step_norm]
      have h_rec := h_ih L hL θ hθ_sm hθ_lo hθ_hi (deriv h) hdh_sm hdh_supp hdh_bd
      calc L⁻¹ * ‖∫ t : ℝ, deriv h t * Complex.exp (Complex.I * (θ t : ℂ))‖
          ≤ L⁻¹ * (C_M / L ^ M_ord) := mul_le_mul_of_nonneg_left h_rec (inv_nonneg.mpr hL.le)
        _ = C_M / L ^ (M_ord + 1) := by
            rw [pow_succ]
            field_simp [ne_of_gt hL]
  obtain ⟨C_ibp, hC_ibp_nn, h_ibp⟩ := h_global_ibp 4 B_win hB_win_nn
  let C_pair : ℝ := max (16 * C_triv) (32 * R_w * (a₀⁻¹) ^ 4 * C_ibp)
  have hC_pair_ge1 : 1 ≤ C_pair :=
    le_trans (by linarith [hC_triv_ge1] : (1 : ℝ) ≤ 16 * C_triv) (le_max_left _ _)
  let L_V : ℕ := ⌈2 * R_w⌉₊ + 1
  let C_Bes : ℝ := 144 * (N_pack : ℝ) * ((2 * L_V + 1 : ℕ) : ℝ) ^ 2 * C_pair
  have hC_Bes_ge1 : 1 ≤ C_Bes := by
    have hN_ge1 : (1 : ℝ) ≤ (N_pack : ℝ) := by exact_mod_cast hN_pack
    have hLV_base : (1 : ℝ) ≤ ((2 * L_V + 1 : ℕ) : ℝ) := by
      exact_mod_cast (Nat.le_add_left 1 (2 * L_V))
    have hLV_sq : (1 : ℝ) ≤ ((2 * L_V + 1 : ℕ) : ℝ) ^ 2 := by nlinarith
    have hp1 : (1 : ℝ) ≤ (N_pack : ℝ) * ((2 * L_V + 1 : ℕ) : ℝ) ^ 2 :=
      one_le_mul_of_one_le_of_one_le hN_ge1 hLV_sq
    have hp2 : (1 : ℝ) ≤ (N_pack : ℝ) * ((2 * L_V + 1 : ℕ) : ℝ) ^ 2 * C_pair :=
      one_le_mul_of_one_le_of_one_le hp1 hC_pair_ge1
    dsimp [C_Bes]
    linarith
  
  have h_clairaut : ∀ (m : ℕ) (F : ℝ × ℝ → ℝ), (∀ k : ℕ, ContDiff ℝ k F) →
      ∀ t τ : ℝ,
        HasDerivAt (fun τ' => iteratedDeriv m (fun t' => F (t', τ')) t)
          (iteratedDeriv m (fun t' => deriv (fun τ' => F (t', τ')) τ) t) τ := by
    have h_step1 : ∀ (F : ℝ × ℝ → ℝ), (∀ k : ℕ, ContDiff ℝ k F) →
        (∀ t τ : ℝ, deriv (fun t' => F (t', τ)) t = fderiv ℝ F (t, τ) (1, 0)) ∧
        (∀ t τ : ℝ, deriv (fun τ' => F (t, τ')) τ = fderiv ℝ F (t, τ) (0, 1)) ∧
        (∀ k : ℕ, ContDiff ℝ k (fun p : ℝ × ℝ => deriv (fun t' => F (t', p.2)) p.1)) ∧
        (∀ t τ : ℝ,
          deriv (fun τ' => deriv (fun t' => F (t', τ')) t) τ =
            deriv (fun t' => deriv (fun τ' => F (t', τ')) τ) t) := by
      intro F hF
      have hd1 : ∀ t τ : ℝ, HasDerivAt (fun t' => F (t', τ)) (fderiv ℝ F (t, τ) (1, 0)) t := by
        intro t τ
        have hf := ((hF 1).hasStrictFDerivAt (by simp)).hasFDerivAt (x := (t, τ))
        have hg : HasDerivAt (fun t' : ℝ => (t', τ)) (1, 0) t :=
          (hasDerivAt_id t).prodMk (hasDerivAt_const t τ)
        exact hf.comp_hasDerivAt t hg
      have hd2 : ∀ t τ : ℝ, HasDerivAt (fun τ' => F (t, τ')) (fderiv ℝ F (t, τ) (0, 1)) τ := by
        intro t τ
        have hf := ((hF 1).hasStrictFDerivAt (by simp)).hasFDerivAt (x := (t, τ))
        have hg : HasDerivAt (fun τ' : ℝ => (t, τ')) (0, 1) τ :=
          (hasDerivAt_const τ t).prodMk (hasDerivAt_id τ)
        exact hf.comp_hasDerivAt τ hg
      have hd1_eq : ∀ t τ : ℝ, deriv (fun t' => F (t', τ)) t = fderiv ℝ F (t, τ) (1, 0) :=
        fun t τ => (hd1 t τ).deriv
      have hd2_eq : ∀ t τ : ℝ, deriv (fun τ' => F (t, τ')) τ = fderiv ℝ F (t, τ) (0, 1) :=
        fun t τ => (hd2 t τ).deriv
      refine ⟨hd1_eq, hd2_eq, ?_, ?_⟩
      · intro k
        have h_fn : (fun p : ℝ × ℝ => deriv (fun t' => F (t', p.2)) p.1) =
            (fun p : ℝ × ℝ => (ContinuousLinearMap.apply ℝ ℝ ((1 : ℝ), (0 : ℝ))) (fderiv ℝ F p)) := by
          ext ⟨t, τ⟩
          exact hd1_eq t τ
        rw [h_fn]
        exact (ContinuousLinearMap.apply ℝ ℝ ((1 : ℝ), (0 : ℝ))).contDiff.comp
          ((hF (k + 1)).fderiv_right (by norm_cast))
      · intro t τ
        have h_symm := (((hF 2).contDiffAt (x := (t, τ))).isSymmSndFDerivAt (by simp)).eq (0, 1) (1, 0)
        have h_fderiv2 :=
          (((hF 2).fderiv_right (by norm_num : (1 : WithTop ℕ∞) + 1 ≤ (2 : ℕ))).hasStrictFDerivAt
            (by simp)).hasFDerivAt (x := (t, τ))
        have h_lhs : HasDerivAt (fun τ' => deriv (fun t' => F (t', τ')) t)
            (fderiv ℝ (fderiv ℝ F) (t, τ) (0, 1) (1, 0)) τ := by
          have h_eq_fn : (fun τ' => deriv (fun t' => F (t', τ')) t) =
              (fun τ' => (ContinuousLinearMap.apply ℝ ℝ ((1 : ℝ), (0 : ℝ))) (fderiv ℝ F (t, τ'))) := by
            ext τ'
            exact hd1_eq t τ'
          rw [h_eq_fn]
          have hg : HasDerivAt (fun τ' : ℝ => (t, τ')) (0, 1) τ :=
            (hasDerivAt_const τ t).prodMk (hasDerivAt_id τ)
          exact ((ContinuousLinearMap.apply ℝ ℝ ((1 : ℝ), (0 : ℝ))).hasFDerivAt.comp_hasDerivAt τ
            (h_fderiv2.comp_hasDerivAt τ hg))
        have h_rhs : HasDerivAt (fun t' => deriv (fun τ' => F (t', τ')) τ)
            (fderiv ℝ (fderiv ℝ F) (t, τ) (1, 0) (0, 1)) t := by
          have h_eq_fn : (fun t' => deriv (fun τ' => F (t', τ')) τ) =
              (fun t' => (ContinuousLinearMap.apply ℝ ℝ ((0 : ℝ), (1 : ℝ))) (fderiv ℝ F (t', τ))) := by
            ext t'
            exact hd2_eq t' τ
          rw [h_eq_fn]
          have hg : HasDerivAt (fun t' : ℝ => (t', τ)) (1, 0) t :=
            (hasDerivAt_id t).prodMk (hasDerivAt_const t τ)
          exact ((ContinuousLinearMap.apply ℝ ℝ ((0 : ℝ), (1 : ℝ))).hasFDerivAt.comp_hasDerivAt t
