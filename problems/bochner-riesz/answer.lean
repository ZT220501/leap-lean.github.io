            intro ω hω
            have heq := (Finset.mem_filter.mp hω).2
            have hw : W ω = w := (Prod.ext_iff.mp heq).1
            have hx : X ω = x := (Prod.ext_iff.mp (Prod.ext_iff.mp heq).2).1
            rw [h_probAt2_eq, hw, hx, ← Finset.sum_subset (Finset.subset_univ S_p)]
            intro ω' _ hnot; simp [hp_zero_out ω' hnot]
          have hPWY_eq : ∀ ω ∈ F_t, finProbAt2 p W Y ω = P_WY w y := by
            intro ω hω
            have heq := (Finset.mem_filter.mp hω).2
            have hw : W ω = w := (Prod.ext_iff.mp heq).1
            have hy : Y ω = y := (Prod.ext_iff.mp (Prod.ext_iff.mp heq).2).2
            rw [h_probAt2_eq, hw, hy, ← Finset.sum_subset (Finset.subset_univ S_p)]
            intro ω' _ hnot; simp [hp_zero_out ω' hnot]
          have hPWXY_eq : ∀ ω ∈ F_t,
              finProbAt2 p (fun ω' => (W ω', X ω')) Y ω = P_WXY w x y := by
            intro ω hω
            have heq := (Finset.mem_filter.mp hω).2
            have hw : W ω = w := (Prod.ext_iff.mp heq).1
            have hx : X ω = x := (Prod.ext_iff.mp (Prod.ext_iff.mp heq).2).1
            have hy : Y ω = y := (Prod.ext_iff.mp (Prod.ext_iff.mp heq).2).2
            rw [h_probAt2_eq, ← Finset.sum_subset (Finset.subset_univ S_p)]
            · refine Finset.sum_congr rfl (fun ω' _ => ?_)
              simp only [Prod.ext_iff, hw, hx, hy]
            · intro ω' _ hnot; simp [hp_zero_out ω' hnot]
          have hFt_sum : ∑ ω ∈ F_t, p ω = P_WXY w x y := by
            dsimp [F_t, P_WXY]
            rw [Finset.sum_filter]
            refine Finset.sum_congr rfl (fun ω _ => ?_)
            simp only [Prod.ext_iff, and_assoc]
          have hPWXY_pos : 0 < P_WXY w x y := by
            rw [← hPWXY_eq ω₀ hω₀]
            exact (h_prob_bds p (fun ω' => (W ω', X ω')) Y ω₀ hp0 ((h_mem_Sp ω₀).mp hω₀_sp)).1
          have hPW_pos : 0 < P_W w := by
            rw [← hPW_eq ω₀ hω₀]
            obtain ⟨h1, h2⟩ := h_prob_bds p W X ω₀ hp0 ((h_mem_Sp ω₀).mp hω₀_sp)
            exact lt_of_lt_of_le h1 h2
          have h_congr : ∑ ω ∈ F_t, p ω * r ω =
              ∑ ω ∈ F_t, p ω * ((P_WY w y * P_WX w x) / (P_W w * P_WXY w x y)) := by
            refine Finset.sum_congr rfl (fun ω hω => ?_)
            dsimp [r]
            rw [hPW_eq ω hω, hPWX_eq ω hω, hPWY_eq ω hω, hPWXY_eq ω hω]
          rw [h_congr, ← Finset.sum_mul, hFt_sum]
          have h_eq : P_WXY w x y * ((P_WY w y * P_WX w x) / (P_W w * P_WXY w x y)) =
              (P_WY w y * P_WX w x) / P_W w := by
            field_simp [hPW_pos.ne', hPWXY_pos.ne']
          exact h_eq.le
        · rw [Finset.not_nonempty_iff_eq_empty.mp hne, Finset.sum_empty]
          have h1 : 0 ≤ P_WY w y := Finset.sum_nonneg (fun ω _ => by split_ifs <;> linarith only [hp0 ω])
          have h2 : 0 ≤ P_WX w x := Finset.sum_nonneg (fun ω _ => by split_ifs <;> linarith only [hp0 ω])
          have h3 : 0 ≤ P_W w := Finset.sum_nonneg (fun ω _ => by split_ifs <;> linarith only [hp0 ω])
          exact div_nonneg (mul_nonneg h1 h2) h3
      have h_sum_w : ∀ w ∈ I_W,
          (∑ xy ∈ I_X ×ˢ I_Y, (P_WY w xy.2 * P_WX w xy.1) / P_W w) = P_W w := by
        intro w hw
        obtain ⟨ω_w, hω_w_sp, rfl⟩ := Finset.mem_image.mp hw
        have hPW_pos : 0 < P_W (W ω_w) := by
          have hle := Finset.single_le_sum
            (f := fun ω' => if W ω' = W ω_w then p ω' else 0)
            (fun ω' _ => by split_ifs <;> linarith only [hp0 ω']) hω_w_sp
          simp only [↓reduceIte] at hle
          exact lt_of_lt_of_le ((h_mem_Sp ω_w).mp hω_w_sp) hle
        have h_sum_x : ∑ x ∈ I_X, P_WX (W ω_w) x = P_W (W ω_w) := by
          dsimp [P_WX, P_W]
          rw [Finset.sum_comm]
          refine Finset.sum_congr rfl (fun ω' hω' => ?_)
          have hx_in : X ω' ∈ I_X := Finset.mem_image_of_mem X hω'
          by_cases hw_eq : W ω' = W ω_w <;> simp [hw_eq, Finset.sum_ite_eq, hx_in]
        have h_sum_y : ∑ y ∈ I_Y, P_WY (W ω_w) y = P_W (W ω_w) := by
          dsimp [P_WY, P_W]
          rw [Finset.sum_comm]
          refine Finset.sum_congr rfl (fun ω' hω' => ?_)
          have hy_in : Y ω' ∈ I_Y := Finset.mem_image_of_mem Y hω'
          by_cases hw_eq : W ω' = W ω_w <;> simp [hw_eq, Finset.sum_ite_eq, hy_in]
        rw [← Finset.sum_div, Finset.sum_product]
        dsimp only
        have h_prod_xy : (∑ x ∈ I_X, ∑ y ∈ I_Y, P_WY (W ω_w) y * P_WX (W ω_w) x) =
            (∑ y ∈ I_Y, P_WY (W ω_w) y) * (∑ x ∈ I_X, P_WX (W ω_w) x) := by
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl (fun x _ => (Finset.sum_mul _ _ _).symm)
        rw [h_prod_xy, h_sum_y, h_sum_x]
        field_simp [hPW_pos.ne']
      have h_tot_w : ∑ w ∈ I_W, P_W w = 1 := by
        dsimp [P_W]
        rw [Finset.sum_comm]
        have h1 : ∑ ω' ∈ S_p, ∑ w ∈ I_W, (if W ω' = w then p ω' else 0) = ∑ ω' ∈ S_p, p ω' := by
          refine Finset.sum_congr rfl (fun ω' hω' => ?_)
          have hw_in : W ω' ∈ I_W := Finset.mem_image_of_mem W hω'
          simp [Finset.sum_ite_eq, hw_in]
        rw [h1]
        exact hSp_sum
      calc ∑ t ∈ I_W ×ˢ (I_X ×ˢ I_Y),
              ∑ ω ∈ S_p.filter (fun ω => (W ω, (X ω, Y ω)) = t), p ω * r ω
          ≤ ∑ t ∈ I_W ×ˢ (I_X ×ˢ I_Y), (P_WY t.1 t.2.2 * P_WX t.1 t.2.1) / P_W t.1 :=
            Finset.sum_le_sum h_cell
        _ = ∑ w ∈ I_W, ∑ xy ∈ I_X ×ˢ I_Y, (P_WY w xy.2 * P_WX w xy.1) / P_W w := by
            rw [Finset.sum_product]
        _ = ∑ w ∈ I_W, P_W w := Finset.sum_congr rfl h_sum_w
        _ = 1 := h_tot_w
    rw [h_cmi_eq]
    exact div_nonneg (h_gibbs p r hp0 hp1 hr_pos hr_sum) hell0.le
  have hs2_card : ∀ {N : ℕ} {α_t β_t : Type} [DecidableEq β_t] (ε₀ N_max : ℝ) (p : Fin N → ℝ)
      (X : Fin N → α_t) (Y : Fin N → β_t),
      0 < ε₀ → ε₀ < 1 / 2 → 1 ≤ N_max →
      (∀ ω, 0 ≤ p ω) → (∑ ω : Fin N, p ω = 1) →
      (∀ ω₀, 0 < p ω₀ → ∃ S_Y : Finset β_t, (S_Y.card : ℝ) ≤ N_max ∧
        ∀ ω, 0 < p ω → X ω = X ω₀ → Y ω ∈ S_Y) →
      finCondEntropy ε₀ p X Y ≤ Real.log N_max / Real.log (ε₀⁻¹) := by
    intro N α_t β_t _ ε₀ N_max p X Y hε0 hε1 hNmax hp0 hp1 hcov
    let _ : DecidableEq α_t := Classical.decEq α_t
    have hell0 := h_ell_pos_gen ε₀ hε0 hε1
    have hN_pos : 0 < N_max := lt_of_lt_of_le zero_lt_one hNmax
    let S_p := @Finset.filter (Fin N) (fun ω => 0 < p ω)
      (fun _ => Classical.propDecidable _) Finset.univ
    have h_mem_Sp : ∀ ω, ω ∈ S_p ↔ 0 < p ω := fun ω => by
      simp only [S_p, @Finset.mem_filter _ _ (fun _ => Classical.propDecidable _),
        Finset.mem_univ, true_and]
    have hp_zero_out : ∀ ω, ω ∉ S_p → p ω = 0 := fun ω hnot =>
      le_antisymm (le_of_not_gt (fun hpos => hnot ((h_mem_Sp ω).mpr hpos))) (hp0 ω)
    have hSp_sum : ∑ ω ∈ S_p, p ω = 1 := by
      rw [← hp1, ← Finset.sum_subset (Finset.subset_univ S_p)]
      intro ω _ hnot; exact hp_zero_out ω hnot
    let r : Fin N → ℝ := fun ω => finProbAt p X ω / (N_max * finProbAt2 p X Y ω)
    have hr_pos : ∀ ω, 0 < p ω → 0 < r ω := by
      intro ω hpos
      obtain ⟨hp2, hp2_le⟩ := h_prob_bds p X Y ω hp0 hpos
      exact div_pos (lt_of_lt_of_le hp2 hp2_le) (mul_pos hN_pos hp2)
    have hr_sum : ∑ ω ∈ S_p, p ω * r ω ≤ 1 := by
      have h_fib_x := (Finset.sum_fiberwise_of_maps_to
        (s := S_p) (t := S_p.image X) (g := X)
        (fun ω hω => Finset.mem_image_of_mem X hω) (fun ω => p ω * r ω)).symm
      rw [h_fib_x]
      have h_each_x : ∀ x ∈ S_p.image X,
          (∑ ω ∈ S_p.filter (fun ω => X ω = x), p ω * r ω) ≤
            ∑ ω' ∈ S_p, if X ω' = x then p ω' else 0 := by
        intro x hx
        obtain ⟨ω₀, hω₀_sp, rfl⟩ := Finset.mem_image.mp hx
        obtain ⟨S_Y, hSY_card, hSY_mem⟩ := hcov ω₀ ((h_mem_Sp ω₀).mp hω₀_sp)
        let F_x := S_p.filter (fun ω => X ω = X ω₀)
        have h_fib_y := (Finset.sum_fiberwise_of_maps_to
          (s := F_x) (t := S_Y) (g := Y)
          (fun ω hω => by
            obtain ⟨h1, h2⟩ := Finset.mem_filter.mp hω
            exact hSY_mem ω ((h_mem_Sp ω).mp h1) h2)
          (fun ω => p ω * r ω)).symm
        rw [h_fib_y]
        let PX := ∑ ω' ∈ S_p, if X ω' = X ω₀ then p ω' else 0
        have hPX_eq : finProbAt p X ω₀ = PX := by
          rw [h_probAt_eq, ← Finset.sum_subset (Finset.subset_univ S_p)]
          intro ω' _ hnot; simp [hp_zero_out ω' hnot]
        have hPX_nn : 0 ≤ PX := Finset.sum_nonneg (fun ω' _ => by split_ifs <;> linarith only [hp0 ω'])
        have h_each_y : ∀ y ∈ S_Y,
            (∑ ω ∈ F_x.filter (fun ω => Y ω = y), p ω * r ω) ≤ PX / N_max := by
          intro y _
          let F_xy := F_x.filter (fun ω => Y ω = y)
          change (∑ ω ∈ F_xy, p ω * r ω) ≤ PX / N_max
          by_cases hne : F_xy.Nonempty
          · obtain ⟨ω₁, hω₁⟩ := hne
            obtain ⟨hω₁_fx, hy1⟩ := Finset.mem_filter.mp hω₁
            obtain ⟨hω₁_sp, hx1⟩ := Finset.mem_filter.mp hω₁_fx
            have hPXY_pos : 0 < finProbAt2 p X Y ω₁ :=
              (h_prob_bds p X Y ω₁ hp0 ((h_mem_Sp ω₁).mp hω₁_sp)).1
            have hFxy_sum : ∑ ω ∈ F_xy, p ω = finProbAt2 p X Y ω₁ := by
              rw [h_probAt2_eq, ← Finset.sum_subset (Finset.subset_univ S_p)]
              · dsimp [F_xy, F_x]
                rw [Finset.sum_filter, Finset.sum_filter]
                refine Finset.sum_congr rfl (fun ω _ => ?_)
                by_cases hxa : X ω = X ω₀ <;> by_cases hya : Y ω = y <;>
                  simp [hxa, hya, hx1, hy1]
              · intro ω' _ hnot; simp [hp_zero_out ω' hnot]
            have h_congr : ∑ ω ∈ F_xy, p ω * r ω =
                ∑ ω ∈ F_xy, p ω * (PX / (N_max * finProbAt2 p X Y ω₁)) := by
              refine Finset.sum_congr rfl (fun ω hω => ?_)
              obtain ⟨h_fx, hy_w⟩ := Finset.mem_filter.mp hω
              have hx_w := (Finset.mem_filter.mp h_fx).2
              have h1 : finProbAt p X ω = PX := by
                rw [← hPX_eq, h_probAt_eq, h_probAt_eq]; simp_rw [hx_w]
              have h2 : finProbAt2 p X Y ω = finProbAt2 p X Y ω₁ := by
                rw [h_probAt2_eq, h_probAt2_eq]; simp_rw [hx_w, hy_w, hx1, hy1]
              dsimp [r]; rw [h1, h2]
            rw [h_congr, ← Finset.sum_mul, hFxy_sum]
            have h_eq : finProbAt2 p X Y ω₁ * (PX / (N_max * finProbAt2 p X Y ω₁)) =
                PX / N_max := by
              field_simp [hN_pos.ne', hPXY_pos.ne']
            exact h_eq.le
          · rw [Finset.not_nonempty_iff_eq_empty.mp hne, Finset.sum_empty]
            exact div_nonneg hPX_nn hN_pos.le
        calc ∑ y ∈ S_Y, ∑ ω ∈ F_x.filter (fun ω => Y ω = y), p ω * r ω
            ≤ ∑ _y ∈ S_Y, PX / N_max := Finset.sum_le_sum h_each_y
          _ = (S_Y.card : ℝ) * (PX / N_max) := by simp [Finset.sum_const, nsmul_eq_mul]
          _ ≤ N_max * (PX / N_max) :=
              mul_le_mul_of_nonneg_right hSY_card (div_nonneg hPX_nn hN_pos.le)
          _ = PX := mul_div_cancel₀ PX hN_pos.ne'
      calc ∑ x ∈ S_p.image X, ∑ ω ∈ S_p.filter (fun ω => X ω = x), p ω * r ω
          ≤ ∑ x ∈ S_p.image X, ∑ ω' ∈ S_p, (if X ω' = x then p ω' else 0) :=
            Finset.sum_le_sum h_each_x
        _ = ∑ ω' ∈ S_p, ∑ x ∈ S_p.image X, (if X ω' = x then p ω' else 0) := Finset.sum_comm
        _ = ∑ ω' ∈ S_p, p ω' := Finset.sum_congr rfl (fun ω' hω' => by
            simp [Finset.sum_ite_eq, Finset.mem_image_of_mem X hω'])
        _ = 1 := hSp_sum
    have h_gibbs_card := h_gibbs p r hp0 hp1 hr_pos hr_sum
    have h_ent_eq : finCondEntropy ε₀ p X Y =
        (∑ ω ∈ S_p, p ω * (-Real.log (finProbAt2 p X Y ω / finProbAt p X ω))) /
          Real.log (ε₀⁻¹) := by
      unfold finCondEntropy condSurprise
      rw [← Finset.sum_subset (Finset.subset_univ S_p), Finset.sum_div]
      · refine Finset.sum_congr rfl (fun ω _ => by ring)
      · intro ω _ hnot; simp [hp_zero_out ω hnot]
    have h_id : ∑ ω ∈ S_p, p ω * (-Real.log (r ω)) =
        Real.log N_max -
          ∑ ω ∈ S_p, p ω * (-Real.log (finProbAt2 p X Y ω / finProbAt p X ω)) := by
      have h_term : ∀ ω ∈ S_p, p ω * (-Real.log (r ω)) =
          p ω * Real.log N_max -
            p ω * (-Real.log (finProbAt2 p X Y ω / finProbAt p X ω)) := by
        intro ω hω
        obtain ⟨hp2, hp2_le⟩ := h_prob_bds p X Y ω hp0 ((h_mem_Sp ω).mp hω)
        have hp1_p : 0 < finProbAt p X ω := lt_of_lt_of_le hp2 hp2_le
        have hr_inv : r ω = (N_max * (finProbAt2 p X Y ω / finProbAt p X ω))⁻¹ := by
          dsimp [r]; field_simp [hN_pos.ne', hp2.ne', hp1_p.ne']
        rw [hr_inv, Real.log_inv, Real.log_mul hN_pos.ne' (div_pos hp2 hp1_p).ne']
        ring
      rw [Finset.sum_congr rfl h_term, Finset.sum_sub_distrib, ← Finset.sum_mul, hSp_sum, one_mul]
    rw [h_id] at h_gibbs_card
    rw [h_ent_eq, div_le_div_iff_of_pos_right hell0]
    linarith only [h_gibbs_card]
  have hs2_kl : ∀ {N : ℕ} {α_t β_t : Type} (ε₀ d_min K : ℝ) (p Q : Fin N → ℝ)
      (X : Fin N → α_t) (Y : Fin N → β_t),
      0 < ε₀ → ε₀ < 1 / 2 → 1 ≤ K →
      (∀ ω, 0 ≤ p ω) → (∑ ω : Fin N, p ω = 1) →
      (∀ ω, 0 ≤ Q ω) → (∑ ω : Fin N, Q ω = 1) →
      (∀ ω, Q ω ≤ K * p ω) →
      (∀ ω, 0 < Q ω → d_min ≤ condSurprise ε₀ p X Y ω) →
      d_min - Real.log K / Real.log (ε₀⁻¹) ≤ finCondEntropy ε₀ Q X Y := by
    intro N α_t β_t ε₀ d_min K p Q X Y hε0 hε1 hK hp0 hp1 hQ0 hQ1 hQp hd_min
    let _ : DecidableEq α_t := Classical.decEq α_t
    let _ : DecidableEq β_t := Classical.decEq β_t
    have hell0 := h_ell_pos_gen ε₀ hε0 hε1
    have hK_pos : 0 < K := lt_of_lt_of_le zero_lt_one hK
    let S_Q := @Finset.filter (Fin N) (fun ω => 0 < Q ω)
      (fun _ => Classical.propDecidable _) Finset.univ
    have h_mem_SQ : ∀ ω, ω ∈ S_Q ↔ 0 < Q ω := fun ω => by
      simp only [S_Q, @Finset.mem_filter _ _ (fun _ => Classical.propDecidable _),
        Finset.mem_univ, true_and]
    have hQ_zero_out : ∀ ω, ω ∉ S_Q → Q ω = 0 := fun ω hnot =>
      le_antisymm (le_of_not_gt (fun hpos => hnot ((h_mem_SQ ω).mpr hpos))) (hQ0 ω)
    have hSQ_sum : ∑ ω ∈ S_Q, Q ω = 1 := by
      rw [← hQ1, ← Finset.sum_subset (Finset.subset_univ S_Q)]
      intro ω _ hnot; exact hQ_zero_out ω hnot
    have hp_pos_of_Q : ∀ ω, 0 < Q ω → 0 < p ω := fun ω hpos => by
      have h1 : 0 < K * p ω := lt_of_lt_of_le hpos (hQp ω)
      exact pos_of_mul_pos_right h1 hK_pos.le
    let r : Fin N → ℝ := fun ω => finProbAt p X ω / finProbAt Q X ω
    have hr_pos : ∀ ω, 0 < Q ω → 0 < r ω := by
      intro ω hpos
      obtain ⟨hp2, hp2_le⟩ := h_prob_bds p X Y ω hp0 (hp_pos_of_Q ω hpos)
      obtain ⟨hq2, hq2_le⟩ := h_prob_bds Q X Y ω hQ0 hpos
      exact div_pos (lt_of_lt_of_le hp2 hp2_le) (lt_of_lt_of_le hq2 hq2_le)
    have hr_sum : ∑ ω ∈ S_Q, Q ω * r ω ≤ 1 := by
      have h_fib := (Finset.sum_fiberwise_of_maps_to
        (s := S_Q) (t := S_Q.image X) (g := X)
        (fun ω hω => Finset.mem_image_of_mem X hω) (fun ω => Q ω * r ω)).symm
      rw [h_fib]
      have h_each_x : ∀ x ∈ S_Q.image X,
          (∑ ω ∈ S_Q.filter (fun ω => X ω = x), Q ω * r ω) ≤
            ∑ ω' : Fin N, if X ω' = x then p ω' else 0 := by
        intro x hx
        obtain ⟨ω₀, hω₀_sq, rfl⟩ := Finset.mem_image.mp hx
        let F_x := S_Q.filter (fun ω => X ω = X ω₀)
        obtain ⟨hq2, hq2_le⟩ := h_prob_bds Q X Y ω₀ hQ0 ((h_mem_SQ ω₀).mp hω₀_sq)
        have hq1_pos : 0 < finProbAt Q X ω₀ := lt_of_lt_of_le hq2 hq2_le
        have hFx_sum : ∑ ω ∈ F_x, Q ω = finProbAt Q X ω₀ := by
          rw [h_probAt_eq, ← Finset.sum_subset (Finset.subset_univ S_Q)]
          · dsimp [F_x]; rw [Finset.sum_filter]
          · intro ω' _ hnot; simp [hQ_zero_out ω' hnot]
        have h_congr : ∑ ω ∈ F_x, Q ω * r ω =
            ∑ ω ∈ F_x, Q ω * (finProbAt p X ω₀ / finProbAt Q X ω₀) := by
          refine Finset.sum_congr rfl (fun ω hω => ?_)
          have hx_w := (Finset.mem_filter.mp hω).2
          have h1 : finProbAt p X ω = finProbAt p X ω₀ := by
            rw [h_probAt_eq, h_probAt_eq]; simp_rw [hx_w]
          have h2 : finProbAt Q X ω = finProbAt Q X ω₀ := by
            rw [h_probAt_eq, h_probAt_eq]; simp_rw [hx_w]
          dsimp [r]; rw [h1, h2]
        rw [h_congr, ← Finset.sum_mul, hFx_sum, mul_div_cancel₀ _ hq1_pos.ne', h_probAt_eq]
      calc ∑ x ∈ S_Q.image X, ∑ ω ∈ S_Q.filter (fun ω => X ω = x), Q ω * r ω
          ≤ ∑ x ∈ S_Q.image X, ∑ ω' : Fin N, (if X ω' = x then p ω' else 0) :=
            Finset.sum_le_sum h_each_x
        _ = ∑ ω' : Fin N, ∑ x ∈ S_Q.image X, (if X ω' = x then p ω' else 0) := Finset.sum_comm
        _ ≤ ∑ ω' : Fin N, p ω' := Finset.sum_le_sum (fun ω' _ => by
            by_cases hmem : X ω' ∈ S_Q.image X
            · simp [Finset.sum_ite_eq, hmem]
            · simp [hmem, hp0 ω'])
        _ = 1 := hp1
    have h_gibbs_kl := h_gibbs Q r hQ0 hQ1 hr_pos hr_sum
    have h_pt : ∀ ω ∈ S_Q,
        Q ω * (d_min * Real.log (ε₀⁻¹) - Real.log K) + Q ω * (-Real.log (r ω)) ≤
          Q ω * (-Real.log (finProbAt2 Q X Y ω / finProbAt Q X ω)) := by
      intro ω hω
      have hposQ : 0 < Q ω := (h_mem_SQ ω).mp hω
      have hposp : 0 < p ω := hp_pos_of_Q ω hposQ
      obtain ⟨hq2, hq2_le⟩ := h_prob_bds Q X Y ω hQ0 hposQ
      have hq1 : 0 < finProbAt Q X ω := lt_of_lt_of_le hq2 hq2_le
      obtain ⟨hp2, hp2_le⟩ := h_prob_bds p X Y ω hp0 hposp
      have hp1 : 0 < finProbAt p X ω := lt_of_lt_of_le hp2 hp2_le
      have hq2_le_Kp2 : finProbAt2 Q X Y ω ≤ K * finProbAt2 p X Y ω := by
        rw [h_probAt2_eq, h_probAt2_eq, Finset.mul_sum]
        refine Finset.sum_le_sum (fun ω' _ => ?_)
        split_ifs
        · exact hQp ω'
        · simp
      have h_rat_le : finProbAt2 Q X Y ω / finProbAt Q X ω ≤
          (K * (finProbAt2 p X Y ω / finProbAt p X ω)) * r ω := by
        have h1 : finProbAt2 Q X Y ω / finProbAt Q X ω ≤
            (K * finProbAt2 p X Y ω) / finProbAt Q X ω :=
          div_le_div_of_nonneg_right hq2_le_Kp2 hq1.le
        have h2 : (K * finProbAt2 p X Y ω) / finProbAt Q X ω =
            (K * (finProbAt2 p X Y ω / finProbAt p X ω)) * r ω := by
          dsimp [r]; field_simp [hq1.ne', hp1.ne']
        rwa [h2] at h1
      have hlog_le := Real.log_le_log (div_pos hq2 hq1) h_rat_le
      rw [Real.log_mul (mul_pos hK_pos (div_pos hp2 hp1)).ne' (hr_pos ω hposQ).ne',
        Real.log_mul hK_pos.ne' (div_pos hp2 hp1).ne'] at hlog_le
      have hd := hd_min ω hposQ
      unfold condSurprise at hd
      have hd' : d_min * Real.log (ε₀⁻¹) ≤ -Real.log (finProbAt2 p X Y ω / finProbAt p X ω) :=
        (le_div_iff₀ hell0).mp hd
      have h_in : d_min * Real.log (ε₀⁻¹) - Real.log K + (-Real.log (r ω)) ≤
          -Real.log (finProbAt2 Q X Y ω / finProbAt Q X ω) := by
        linarith only [hlog_le, hd']
      have hmul := mul_le_mul_of_nonneg_left h_in (hQ0 ω)
      linarith only [hmul, mul_add (Q ω) (d_min * Real.log (ε₀⁻¹) - Real.log K) (-Real.log (r ω))]
    have h_sum_pt := Finset.sum_le_sum h_pt
    rw [Finset.sum_add_distrib, ← Finset.sum_mul, hSQ_sum, one_mul] at h_sum_pt
    have h_ent_eq : finCondEntropy ε₀ Q X Y =
        (∑ ω ∈ S_Q, Q ω * (-Real.log (finProbAt2 Q X Y ω / finProbAt Q X ω))) /
          Real.log (ε₀⁻¹) := by
      unfold finCondEntropy condSurprise
      rw [← Finset.sum_subset (Finset.subset_univ S_Q), Finset.sum_div]
      · refine Finset.sum_congr rfl (fun ω _ => by ring)
      · intro ω _ hnot; simp [hQ_zero_out ω hnot]
    rw [h_ent_eq, le_div_iff₀ hell0]
    have halg : (d_min - Real.log K / Real.log (ε₀⁻¹)) * Real.log (ε₀⁻¹) =
        d_min * Real.log (ε₀⁻¹) - Real.log K := by
      rw [sub_mul, div_mul_cancel₀ _ hell0.ne']
    linarith only [h_sum_pt, h_gibbs_kl, halg]
  have h_conj1 : ∀ {N_ω N_T : ℕ} (ε : ℝ) (π : Fin N_ω → ℝ)
      (T_seq : Fin N_ω → Fin N_T) (c_seq : Fin N_ω → ℝ),
      (∀ ω, 0 ≤ π ω) → (∑ ω : Fin N_ω, π ω = 1) →
      (∀ ω, 0 < π ω → c_seq ω ∈ Set.Icc (0 : ℝ) 1) →
      ∃ (M_ω : ℕ) (f : Fin M_ω → Fin N_ω),
        (∀ ω : Fin M_ω, 0 < π (f ω) ∧ c_seq (f ω) ∈ Set.Icc (0 : ℝ) 1) ∧
        (∑ ω : Fin M_ω, π (f ω) = 1) ∧
        (∀ tid : Fin N_T,
          (∑ ω : Fin M_ω, if T_seq (f ω) = tid then π (f ω) else 0) =
            (∑ ω : Fin N_ω, if T_seq ω = tid then π ω else 0)) ∧
        (∀ {α β : Type} (X : Fin N_ω → α) (Y : Fin N_ω → β),
          (∀ ω : Fin M_ω,
            condSurprise ε (fun ω' => π (f ω')) (fun ω' => X (f ω')) (fun ω' => Y (f ω')) ω =
              condSurprise ε π X Y (f ω)) ∧
          finCondEntropy ε (fun ω' => π (f ω')) (fun ω' => X (f ω')) (fun ω' => Y (f ω')) =
            finCondEntropy ε π X Y ∧
          finMutualInfo ε (fun ω' => π (f ω')) (fun ω' => X (f ω')) (fun ω' => Y (f ω')) =
            finMutualInfo ε π X Y) ∧
        (∀ (P : Fin N_ω → Prop) [DecidablePred P],
          (∑ ω : Fin M_ω, if P (f ω) then π (f ω) else 0) =
            (∑ ω : Fin N_ω, if P ω then π ω else 0)) := by
    intro N_ω N_T ε π T_seq c_seq hπ0 hπ1 hc_mem
    let S_pos := @Finset.filter (Fin N_ω) (fun ω => 0 < π ω)
      (fun _ => Classical.propDecidable _) Finset.univ
    let M_ω := S_pos.card
    let e : Fin M_ω ≃ ↥S_pos := S_pos.equivFin.symm
    let f : Fin M_ω → Fin N_ω := fun i => (e i).1
    have h_pos_f : ∀ i : Fin M_ω, 0 < π (f i) := fun i =>
      ((@Finset.mem_filter _ _ (fun _ => Classical.propDecidable _) _ _).mp (e i).2).2
    have h_sum_comp : ∀ (g : Fin N_ω → ℝ), (∀ ω, π ω = 0 → g ω = 0) →
        (∑ i : Fin M_ω, g (f i)) = ∑ ω : Fin N_ω, g ω := by
      intro g hg0
      have h1 : (∑ i : Fin M_ω, g (f i)) = ∑ x : ↥S_pos, g x.1 :=
        Fintype.sum_equiv e (fun i => g (f i)) (fun x => g x.1) (fun _ => rfl)
      have h2 : (∑ x : ↥S_pos, g x.1) = ∑ ω ∈ S_pos, g ω :=
        Finset.sum_finset_coe g S_pos
      have h3 : (∑ ω ∈ S_pos, g ω) = ∑ ω : Fin N_ω, g ω := by
        refine Finset.sum_subset (Finset.subset_univ S_pos) (fun ω _ hnot => ?_)
        have hnot_pos : ¬ 0 < π ω := fun hp =>
          hnot ((@Finset.mem_filter _ _ (fun _ => Classical.propDecidable _) _ _).mpr
            ⟨Finset.mem_univ ω, hp⟩)
        exact hg0 ω (le_antisymm (le_of_not_gt hnot_pos) (hπ0 ω))
      rw [h1, h2, h3]
    have h_pred : ∀ (P : Fin N_ω → Prop) [DecidablePred P],
        (∑ ω : Fin M_ω, if P (f ω) then π (f ω) else 0) =
          (∑ ω : Fin N_ω, if P ω then π ω else 0) := by
      intro P _
      exact h_sum_comp (fun ω => if P ω then π ω else 0) (fun ω h0 => by simp [h0])
    have h_surp_ent : ∀ {α β : Type} (X : Fin N_ω → α) (Y : Fin N_ω → β),
        (∀ ω : Fin M_ω,
          condSurprise ε (fun ω' => π (f ω')) (fun ω' => X (f ω')) (fun ω' => Y (f ω')) ω =
            condSurprise ε π X Y (f ω)) ∧
        finCondEntropy ε (fun ω' => π (f ω')) (fun ω' => X (f ω')) (fun ω' => Y (f ω')) =
          finCondEntropy ε π X Y := by
      intro α β X Y
      let _ : DecidableEq α := Classical.decEq α
      let _ : DecidableEq β := Classical.decEq β
      have h_surp : ∀ ω : Fin M_ω,
          condSurprise ε (fun ω' => π (f ω')) (fun ω' => X (f ω')) (fun ω' => Y (f ω')) ω =
            condSurprise ε π X Y (f ω) := by
        intro ω
        have hp1 : finProbAt (fun ω' => π (f ω')) (fun ω' => X (f ω')) ω =
            finProbAt π X (f ω) := by
          rw [h_probAt_eq, h_probAt_eq]
          exact h_sum_comp (fun z => if X z = X (f ω) then π z else 0)
            (fun z hz => by simp [hz])
        have hp2 : finProbAt2 (fun ω' => π (f ω')) (fun ω' => X (f ω')) (fun ω' => Y (f ω')) ω =
            finProbAt2 π X Y (f ω) := by
          rw [h_probAt2_eq, h_probAt2_eq]
          exact h_sum_comp (fun z => if X z = X (f ω) ∧ Y z = Y (f ω) then π z else 0)
            (fun z hz => by simp [hz])
        unfold condSurprise
        rw [hp1, hp2]
      refine ⟨h_surp, ?_⟩
      unfold finCondEntropy
      have h_congr : ∑ ω : Fin M_ω,
            π (f ω) * condSurprise ε (fun ω' => π (f ω')) (fun ω' => X (f ω')) (fun ω' => Y (f ω')) ω =
          ∑ ω : Fin M_ω, π (f ω) * condSurprise ε π X Y (f ω) :=
        Finset.sum_congr rfl (fun ω _ => by rw [h_surp ω])
      rw [h_congr]
      exact h_sum_comp (fun z => π z * condSurprise ε π X Y z) (fun z hz => by simp [hz])
    refine ⟨M_ω, f, ?_, ?_, ?_, ?_, h_pred⟩
    · exact fun ω => ⟨h_pos_f ω, hc_mem (f ω) (h_pos_f ω)⟩
    · rw [h_sum_comp π (fun _ h => h), hπ1]
    · intro tid
      exact h_pred (fun ω => T_seq ω = tid)
    · intro α β X Y
      obtain ⟨hs, he⟩ := h_surp_ent X Y
      refine ⟨hs, he, ?_⟩
      unfold finMutualInfo
      have he_unit := (h_surp_ent (fun _ : Fin N_ω => ()) Y).2
      exact congrArg₂ Sub.sub he_unit he
  have h_conj2 : ∀ {M_ω : ℕ} {α β γ_t : Type} (ε : ℝ) (π : Fin M_ω → ℝ)
      (W : Fin M_ω → α) (X : Fin M_ω → β) (Y : Fin M_ω → γ_t),
      0 < ε → ε < 1 / 2 → (∀ ω, 0 ≤ π ω) → (∑ ω : Fin M_ω, π ω = 1) →
      0 ≤ finCondEntropy ε π W X ∧
      0 ≤ finMutualInfo ε π W X ∧
      finCondEntropy ε π W (fun ω => (X ω, Y ω)) =
        finCondEntropy ε π W X + finCondEntropy ε π (fun ω => (W ω, X ω)) Y ∧
      finCondEntropy ε π (fun _ => ()) (fun ω => (X ω, Y ω)) =
        finCondEntropy ε π (fun _ => ()) X + finCondEntropy ε π X Y ∧
      finMutualInfo ε π W X ≤ finMutualInfo ε π W (fun ω => (X ω, Y ω)) := by
    intro M_ω α β γ_t ε π W X Y hε0 hε1 hπ0 hπ1
    have h1 : 0 ≤ finCondEntropy ε π W X := h_ent_nn ε π W X hε0 hε1 hπ0
    have h2 : 0 ≤ finMutualInfo ε π W X := by
      unfold finMutualInfo
      rw [← h_unit_ent ε π W X]
      exact h_cmi_nn ε π (fun _ => ()) W X hε0 hε1 hπ0 hπ1
    have h3 : finCondEntropy ε π W (fun ω => (X ω, Y ω)) =
        finCondEntropy ε π W X + finCondEntropy ε π (fun ω => (W ω, X ω)) Y :=
      h_chain_rule ε π W X Y hε0 hε1 hπ0
    have h4 : finCondEntropy ε π (fun _ => ()) (fun ω => (X ω, Y ω)) =
        finCondEntropy ε π (fun _ => ()) X + finCondEntropy ε π X Y := by
      rw [h_chain_rule ε π (fun _ => ()) X Y hε0 hε1 hπ0, h_unit_ent]
    have h5 : finMutualInfo ε π W X ≤ finMutualInfo ε π W (fun ω => (X ω, Y ω)) := by
      unfold finMutualInfo
      rw [h4, h3]
      have h_swap : finCondEntropy ε π (fun ω => (W ω, X ω)) Y =
          finCondEntropy ε π (fun ω => (X ω, W ω)) Y :=
        h_cond_equiv ε π (fun ω => (W ω, X ω)) (fun ω => (X ω, W ω)) Y hπ0
          (fun _ _ _ _ => by simp [Prod.ext_iff, and_comm])
      have hcmi : 0 ≤ finCondMutualInfo ε π X W Y := h_cmi_nn ε π X W Y hε0 hε1 hπ0 hπ1
      unfold finCondMutualInfo at hcmi
      linarith only [h_swap, hcmi]
    exact ⟨h1, h2, h3, h4, h5⟩
  have h_conj6 : ∀ {M_ω N_Z : ℕ} {α_T α_O α_K : Type} (ε : ℝ) (π : Fin M_ω → ℝ)
      (T : Fin M_ω → α_T) (O : Fin M_ω → α_O) (K_t : Fin M_ω → α_K)
      (Z : Fin M_ω → Fin N_Z),
      0 < ε → ε < 1 / 2 → 1 ≤ N_Z →
      (∀ ω, 0 ≤ π ω) → (∑ ω : Fin M_ω, π ω = 1) →
      let p_Z : Fin N_Z → ℝ := fun z => ∑ ω : Fin M_ω, if Z ω = z then π ω else 0
      let π_z : Fin N_Z → Fin M_ω → ℝ := fun z ω =>
        if Z ω = z then π ω / p_Z z else 0
      finMutualInfo ε π T Z +
        (∑ z : Fin N_Z,
          if 0 < p_Z z then
            p_Z z * (finMutualInfo ε (π_z z) T O - 2 * finCondEntropy ε (π_z z) T K_t)
          else 0) ≤
        (finMutualInfo ε π T O - 2 * finCondEntropy ε π T K_t) +
          3 * Real.log (N_Z : ℝ) / Real.log (ε⁻¹) := by
    intro M_ω N_Z α_T α_O α_K ε π T O K_t Z hε0 hε1 hNZ hπ0 hπ1 p_Z π_z
    have h_disint : ∀ {α_A α_B : Type} (A : Fin M_ω → α_A) (B : Fin M_ω → α_B),
        (∑ z : Fin N_Z, if 0 < p_Z z then p_Z z * finCondEntropy ε (π_z z) A B else 0) =
          finCondEntropy ε π (fun ω => (Z ω, A ω)) B := by
      intro α_A α_B A B
      let _ : DecidableEq α_A := Classical.decEq α_A
      let _ : DecidableEq α_B := Classical.decEq α_B
      unfold finCondEntropy
      have h_push : ∀ z : Fin N_Z,
          (if 0 < p_Z z then
            p_Z z * ∑ ω : Fin M_ω, π_z z ω * condSurprise ε (π_z z) A B ω
          else 0) =
          ∑ ω : Fin M_ω,
            if 0 < p_Z z then p_Z z * (π_z z ω * condSurprise ε (π_z z) A B ω) else 0 := by
        intro z
        by_cases hpz : 0 < p_Z z
        · simp only [hpz, ↓reduceIte, Finset.mul_sum]
        · simp only [hpz, ↓reduceIte, Finset.sum_const_zero]
      simp_rw [h_push]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl (fun ω _ => ?_)
      by_cases hpos : 0 < π ω
      · rw [Finset.sum_eq_single (Z ω)]
        · have hpZ_le : π ω ≤ p_Z (Z ω) := by
            dsimp [p_Z]
            have hle := Finset.single_le_sum
              (f := fun ω' : Fin M_ω => if Z ω' = Z ω then π ω' else 0)
              (fun ω' _ => by split_ifs <;> linarith only [hπ0 ω'])
              (Finset.mem_univ ω)
            simpa using hle
          have hpZ_pos : 0 < p_Z (Z ω) := lt_of_lt_of_le hpos hpZ_le
          simp only [hpZ_pos, ↓reduceIte]
          have hπz_at : π_z (Z ω) ω = π ω / p_Z (Z ω) := by
            dsimp [π_z]; simp
          rw [hπz_at, ← mul_assoc, mul_div_cancel₀ _ hpZ_pos.ne']
          congr 1
          unfold condSurprise
          have hp1 : finProbAt (π_z (Z ω)) A ω =
              finProbAt π (fun ω' => (Z ω', A ω')) ω / p_Z (Z ω) := by
            rw [h_probAt_eq, h_probAt_eq, Finset.sum_div]
            refine Finset.sum_congr rfl (fun ω' _ => ?_)
            dsimp [π_z]
            by_cases hz' : Z ω' = Z ω <;> by_cases ha' : A ω' = A ω <;>
              simp [Prod.ext_iff, hz', ha']
          have hp2 : finProbAt2 (π_z (Z ω)) A B ω =
              finProbAt2 π (fun ω' => (Z ω', A ω')) B ω / p_Z (Z ω) := by
            rw [h_probAt2_eq, h_probAt2_eq, Finset.sum_div]
            refine Finset.sum_congr rfl (fun ω' _ => ?_)
            dsimp [π_z]
            by_cases hz' : Z ω' = Z ω <;> by_cases ha' : A ω' = A ω <;>
              by_cases hb' : B ω' = B ω <;> simp [Prod.ext_iff, hz', ha', hb']
          rw [hp1, hp2, div_div_div_cancel_right₀ hpZ_pos.ne']
        · intro z _ hz
          have hne : Z ω ≠ z := hz.symm
          have hπz_zero : π_z z ω = 0 := by dsimp [π_z]; simp [hne]
          simp [hπz_zero]
        · intro hnot
          exact absurd (Finset.mem_univ _) hnot
      · have hπ_zero : π ω = 0 := le_antisymm (le_of_not_gt hpos) (hπ0 ω)
        have h_all_zero : ∀ z : Fin N_Z,
            (if 0 < p_Z z then p_Z z * (π_z z ω * condSurprise ε (π_z z) A B ω) else 0) = 0 := by
          intro z
          have hπz_zero : π_z z ω = 0 := by dsimp [π_z]; simp [hπ_zero]
          simp [hπz_zero]
        simp [h_all_zero, hπ_zero]
    have h_sum_split :
        (∑ z : Fin N_Z,
          if 0 < p_Z z then
            p_Z z * (finMutualInfo ε (π_z z) T O - 2 * finCondEntropy ε (π_z z) T K_t)
          else 0) =
        finCondEntropy ε π Z O -
          finCondEntropy ε π (fun ω => (T ω, Z ω)) O -
          2 * finCondEntropy ε π (fun ω => (T ω, Z ω)) K_t := by
      have h_term : ∀ z : Fin N_Z,
          (if 0 < p_Z z then
            p_Z z * (finMutualInfo ε (π_z z) T O - 2 * finCondEntropy ε (π_z z) T K_t)
          else 0) =
          (if 0 < p_Z z then p_Z z * finCondEntropy ε (π_z z) (fun _ => ()) O else 0) -
          (if 0 < p_Z z then p_Z z * finCondEntropy ε (π_z z) T O else 0) -
          2 * (if 0 < p_Z z then p_Z z * finCondEntropy ε (π_z z) T K_t else 0) := by
        intro z
        unfold finMutualInfo
        split_ifs <;> ring
      simp_rw [h_term]
      rw [Finset.sum_sub_distrib, Finset.sum_sub_distrib, ← Finset.mul_sum,
        h_disint (fun _ => ()) O, h_disint T O, h_disint T K_t]
      have hc1 : finCondEntropy ε π (fun ω => (Z ω, ())) O = finCondEntropy ε π Z O :=
        h_cond_equiv ε π (fun ω => (Z ω, ())) Z O hπ0 (fun _ _ _ _ => by simp)
      have hc2 : finCondEntropy ε π (fun ω => (Z ω, T ω)) O =
          finCondEntropy ε π (fun ω => (T ω, Z ω)) O :=
        h_cond_equiv ε π (fun ω => (Z ω, T ω)) (fun ω => (T ω, Z ω)) O hπ0
          (fun _ _ _ _ => by simp [Prod.ext_iff, and_comm])
      have hc3 : finCondEntropy ε π (fun ω => (Z ω, T ω)) K_t =
          finCondEntropy ε π (fun ω => (T ω, Z ω)) K_t :=
        h_cond_equiv ε π (fun ω => (Z ω, T ω)) (fun ω => (T ω, Z ω)) K_t hπ0
          (fun _ _ _ _ => by simp [Prod.ext_iff, and_comm])
      rw [hc1, hc2, hc3]
    rw [h_sum_split]
    have h_sym1 : finCondEntropy ε π (fun _ => ()) O + finCondEntropy ε π O Z =
        finCondEntropy ε π (fun _ => ()) Z + finCondEntropy ε π Z O := by
      have hc := h_ent_comm ε π (fun _ => ()) Z O hε0 hε1 hπ0 hπ1
      rwa [h_unit_ent, h_unit_ent] at hc
    have h_sym2 := h_ent_comm ε π T Z O hε0 hε1 hπ0 hπ1
    have h_sym3 := h_ent_comm ε π T Z K_t hε0 hε1 hπ0 hπ1
    have h_nn1 : 0 ≤ finCondEntropy ε π (fun ω => (T ω, O ω)) Z :=
      h_ent_nn ε π (fun ω => (T ω, O ω)) Z hε0 hε1 hπ0
    have h_nn2 : 0 ≤ finCondEntropy ε π (fun ω => (T ω, K_t ω)) Z :=
      h_ent_nn ε π (fun ω => (T ω, K_t ω)) Z hε0 hε1 hπ0
    have h_mi_OZ : 0 ≤ finCondEntropy ε π (fun _ => ()) Z - finCondEntropy ε π O Z :=
      (h_conj2 ε π O Z Z hε0 hε1 hπ0 hπ1).2.1
    have h_mi_TZ : 0 ≤ finCondEntropy ε π (fun _ => ()) Z - finCondEntropy ε π T Z :=
      (h_conj2 ε π T Z Z hε0 hε1 hπ0 hπ1).2.1
    have hNZ_real : (1 : ℝ) ≤ (N_Z : ℝ) := by exact_mod_cast hNZ
    have h_cap_Z : finCondEntropy ε π (fun _ => ()) Z ≤
        Real.log (N_Z : ℝ) / Real.log (ε⁻¹) := by
      refine hs2_card ε (N_Z : ℝ) π (fun _ => ()) Z hε0 hε1 hNZ_real hπ0 hπ1 (fun _ _ => ?_)
      refine ⟨Finset.univ, ?_, fun ω _ _ => Finset.mem_univ (Z ω)⟩
      simp [Finset.card_univ]
    have h_three : 3 * (Real.log (N_Z : ℝ) / Real.log (ε⁻¹)) =
        3 * Real.log (N_Z : ℝ) / Real.log (ε⁻¹) := by ring
    unfold finMutualInfo
    linarith only [h_sym1, h_sym2, h_sym3, h_nn1, h_nn2, h_mi_OZ, h_mi_TZ, h_cap_Z, h_three]
  exact ⟨h_conj1, h_conj2, hs2_equiv, hs2_card, hs2_kl, h_conj6⟩

theorem greedy_root_cap_partition_and_tilt_bound (γ B_iso ε ξ : ℝ) (hγ₀ : 0 < γ) (hγ₁ : γ < 1) (hB_iso : 1 ≤ B_iso)
    (hε₀ : 0 < ε) (hε₁ : ε < 1 / 2) (hξ₀ : 0 < ξ) (hξ₁ : ξ ≤ 1 / 2)
    (M_ω M_T : ℕ) (π_amb : Fin M_ω → ℝ) (T_idx : Fin M_ω → Fin M_T)
    (V_part A_part : Fin M_T → EuclideanSpace ℝ (Fin 2))
    (hπ_nn : ∀ ω, 0 ≤ π_amb ω) (hπ_sum : ∑ ω : Fin M_ω, π_amb ω = 1)
    (hVA : ∀ tid, ‖V_part tid‖ ≤ B_iso ∧ ‖A_part tid‖ ≤ B_iso) :
    (∀ (Q : Fin M_ω → ℝ), (∀ ω, 0 ≤ Q ω) → (∑ ω : Fin M_ω, Q ω = 1) →
      classicalRootSupremum ε 1 γ M_ω M_T Q T_idx V_part A_part ≤ 2) ∧
    (∀ {N_Z : ℕ} (P : Fin M_ω → ℝ) (Z : Fin M_ω → Fin N_Z),
      (∀ ω, 0 ≤ P ω) → (∑ ω : Fin M_ω, P ω = 1) →
      let p_Z : Fin N_Z → ℝ := fun z => ∑ ω : Fin M_ω, if Z ω = z then P ω else 0
      let P_z : Fin N_Z → Fin M_ω → ℝ := fun z ω => if Z ω = z then P ω / p_Z z else 0
      (∑ z : Fin N_Z,
        if 0 < p_Z z then
          p_Z z * classicalRootSupremum ε 1 γ M_ω M_T (P_z z) T_idx V_part A_part
        else 0) ≤
        classicalRootSupremum ε 1 γ M_ω M_T P T_idx V_part A_part +
          finMutualInfo ε P T_idx Z) ∧
    (let J_cap : ℕ := ⌊2 / ξ⌋₊ + 2
     ∃ Z_cap : Fin M_T → Fin (J_cap + 1),
       (∑ ω : Fin M_ω,
         if Z_cap (T_idx ω) = Fin.last J_cap then π_amb ω else 0) ≤
         (((2 * ⌈B_iso⌉₊ + 3) ^ 4 : ℕ) : ℝ) * ε ^ ξ ∧
       ∀ j : Fin J_cap,
         let h_cap : ℝ := -ξ + (j.val : ℝ) * ξ
         let p₁ : ℝ := ∑ ω : Fin M_ω, if Z_cap (T_idx ω) = j.castSucc then π_amb ω else 0
         (-ξ ≤ h_cap ∧ h_cap ≤ 2) ∧
         (0 < p₁ →
           let μ₁ : Fin M_ω → ℝ := fun ω =>
             if Z_cap (T_idx ω) = j.castSucc then π_amb ω / p₁ else 0
           h_cap ≤ classicalRootSupremum ε 1 γ M_ω M_T μ₁ T_idx V_part A_part) ∧
         (∀ (Q : Fin M_ω → ℝ) (M_tilt : ℝ),
           (∀ ω, 0 ≤ Q ω) → (∑ ω : Fin M_ω, Q ω = 1) → 1 ≤ M_tilt →
           (∀ ω, 0 < Q ω → Z_cap (T_idx ω) = j.castSucc) →
           (∀ ω, Q ω ≤ M_tilt * π_amb ω) →
           classicalRootSupremum ε 1 γ M_ω M_T Q T_idx V_part A_part ≤
             h_cap + 3 * ξ + Real.log (81 * M_tilt) / Real.log (ε⁻¹))) :=
by
  have _ := hξ₁
  let ell : ℝ := Real.log (ε⁻¹)
  have hε_le1 : ε ≤ 1 := by linarith
  have hε_inv_gt1 : 1 < ε⁻¹ := by
    rw [one_lt_inv₀ hε₀]
    linarith
  have hell_pos : 0 < ell := Real.log_pos hε_inv_gt1
  have hell_ne : ell ≠ 0 := hell_pos.ne'
  have h_log_eps_rpow : ∀ E : ℝ, Real.log (ε ^ E) = -E * ell := by
    intro E
    rw [Real.rpow_def_of_pos hε₀, Real.log_exp]
    have hinv : ell = -Real.log ε := Real.log_inv ε
    rw [hinv]
    ring

  have h_sq_eq : ∀ {a b : ℝ}, 0 ≤ a → 0 ≤ b → a ^ 2 = b ^ 2 → a = b := by
    intro a b ha hb h
    have h1 : (a - b) * (a + b) = 0 := by linear_combination h
    rcases mul_eq_zero.mp h1 with h2 | h2 <;> linarith
  have h_sq_le : ∀ {a b : ℝ}, 0 ≤ b → a ^ 2 ≤ b ^ 2 → a ≤ b := by
    intro a b hb h
    by_contra hlt
    push_neg at hlt
    nlinarith
  have h_norm_sq : ∀ x : EuclideanSpace ℝ (Fin 2), ‖x‖ ^ 2 = (x 0) ^ 2 + (x 1) ^ 2 := by
    intro x
    rw [PiLp.norm_sq_eq_of_L2, Fin.sum_univ_two]
    simp [Real.norm_eq_abs, sq_abs]
  have h_inner_eq : ∀ x y : EuclideanSpace ℝ (Fin 2), inner ℝ x y = x 0 * y 0 + x 1 * y 1 := by
    intro x y
    rw [PiLp.inner_apply, Fin.sum_univ_two]
    simp [mul_comm]
  have h_coord_le : ∀ (x : EuclideanSpace ℝ (Fin 2)) (i : Fin 2), |x i| ≤ ‖x‖ := by
    intro x i
    refine h_sq_le (norm_nonneg x) ?_
    rw [sq_abs, h_norm_sq]
    fin_cases i <;> { dsimp; nlinarith [sq_nonneg (x 0), sq_nonneg (x 1)] }
  have h_perp_norm : ∀ u : EuclideanSpace ℝ (Fin 2), ‖perp2D u‖ = ‖u‖ := by
    intro u
    refine h_sq_eq (norm_nonneg _) (norm_nonneg _) ?_
    rw [h_norm_sq, h_norm_sq]
    change (-(u 1)) ^ 2 + (u 0) ^ 2 = (u 0) ^ 2 + (u 1) ^ 2
    ring
  have h_perp_sub : ∀ u v : EuclideanSpace ℝ (Fin 2), ‖perp2D u - perp2D v‖ = ‖u - v‖ := by
    intro u v
    refine h_sq_eq (norm_nonneg _) (norm_nonneg _) ?_
    rw [h_norm_sq, h_norm_sq]
    change (-(u 1) - -(v 1)) ^ 2 + (u 0 - v 0) ^ 2 = (u 0 - v 0) ^ 2 + (u 1 - v 1) ^ 2
    ring
  have h_parseval : ∀ (x e : EuclideanSpace ℝ (Fin 2)), ‖e‖ = 1 →
      ‖x‖ ^ 2 = (inner ℝ x e) ^ 2 + (inner ℝ x (perp2D e)) ^ 2 := by
    intro x e he
    have he2 : (e 0) ^ 2 + (e 1) ^ 2 = 1 := by
      have h1 := h_norm_sq e
      rw [he] at h1
      linarith
    rw [h_norm_sq, h_inner_eq, h_inner_eq]
    change (x 0) ^ 2 + (x 1) ^ 2 =
      (x 0 * e 0 + x 1 * e 1) ^ 2 + (x 0 * -(e 1) + x 1 * e 0) ^ 2
    linear_combination -((x 0) ^ 2 + (x 1) ^ 2) * he2
  have h_frame_sub : ∀ (X u : EuclideanSpace ℝ (Fin 2)) (α β : ℝ), ‖u‖ = 1 →
      inner ℝ (X - (α • u + β • perp2D u)) u = inner ℝ X u - α ∧
      inner ℝ (X - (α • u + β • perp2D u)) (perp2D u) = inner ℝ X (perp2D u) - β := by
    intro X u α β hu
    have hu2 : (u 0) ^ 2 + (u 1) ^ 2 = 1 := by
      have h1 := h_norm_sq u
      rw [hu] at h1
      linarith
    constructor
    · rw [h_inner_eq, h_inner_eq]
      change (X 0 - (α * u 0 + β * -(u 1))) * u 0 + (X 1 - (α * u 1 + β * u 0)) * u 1 =
        X 0 * u 0 + X 1 * u 1 - α
      linear_combination -α * hu2
    · rw [h_inner_eq, h_inner_eq]
      change (X 0 - (α * u 0 + β * -(u 1))) * -(u 1) + (X 1 - (α * u 1 + β * u 0)) * u 0 =
        X 0 * -(u 1) + X 1 * u 0 - β
      linear_combination -β * hu2

  let e₀_unit : EuclideanSpace ℝ (Fin 2) :=
    WithLp.toLp 2 (fun i : Fin 2 => if i = 0 then (1 : ℝ) else 0)
  have he₀_norm : ‖e₀_unit‖ = 1 := by
    refine h_sq_eq (norm_nonneg _) zero_le_one ?_
    rw [h_norm_sq]
    change ((1 : ℝ) ^ 2 + (0 : ℝ) ^ 2) = 1 ^ 2
    norm_num

  let p_T_of : (Fin M_ω → ℝ) → Fin M_T → ℝ :=
    fun Q tid => ∑ ω : Fin M_ω, if T_idx ω = tid then Q ω else 0

  let RootSet : (Fin M_ω → ℝ) → Set ℝ := fun Q =>
    { s : ℝ | ∃ (N_D : ℕ)
        (b_D a_D : Fin N_D → ℝ)
        (e_D V_D A_D : Fin N_D → EuclideanSpace ℝ (Fin 2))
        (q : Fin M_T → Fin N_D → ℝ),
        (∀ d : Fin N_D, 0 ≤ b_D d ∧ b_D d ≤ a_D d ∧ a_D d ≤ 1 ∧ ‖e_D d‖ = 1) ∧
        (∀ tid d, 0 ≤ q tid d) ∧
        (∀ tid : Fin M_T, ∑ d : Fin N_D, q tid d = p_T_of Q tid) ∧
        (∀ tid : Fin M_T, ∀ d : Fin N_D, 0 < q tid d →
          |inner ℝ (V_part tid - V_D d) (e_D d)| ≤ 10 * ε ^ (b_D d) ∧
          |inner ℝ (V_part tid - V_D d) (perp2D (e_D d))| ≤ 10 * ε ^ (a_D d) ∧
          |inner ℝ (A_part tid - A_D d) (e_D d)| ≤ 10 * ε ^ (b_D d) ∧
          |inner ℝ (A_part tid - A_D d) (perp2D (e_D d))| ≤ 10 * ε ^ (a_D d)) ∧
        (let q_D := fun d => ∑ tid : Fin M_T, q tid d
         let I_TD := (∑ tid : Fin M_T, ∑ d : Fin N_D,
           q tid d * Real.log (q tid d / (p_T_of Q tid * q_D d))) / ell
         let E_w := ∑ d : Fin N_D, q_D d * ((1 + γ) * b_D d + (1 - γ) * a_D d)
         s = E_w - I_TD) }

  have h_root_eq : ∀ Q : Fin M_ω → ℝ,
      classicalRootSupremum ε 1 γ M_ω M_T Q T_idx V_part A_part = sSup (RootSet Q) :=
    fun _ => rfl

  have h_root_ne : ∀ (Q : Fin M_ω → ℝ), (∀ ω, 0 ≤ Q ω) → (RootSet Q).Nonempty := by
    intro Q hQ_nn
    have hpT_nn : ∀ tid, 0 ≤ p_T_of Q tid :=
      fun tid => Finset.sum_nonneg (fun ω _ => by split_ifs <;> linarith [hQ_nn ω])
    let q₀ : Fin M_T → Fin M_T → ℝ := fun tid d => if tid = d then p_T_of Q tid else 0
    refine ⟨_, M_T, fun _ => 0, fun _ => 0, fun _ => e₀_unit, V_part, A_part, q₀,
      fun _ => ⟨le_rfl, le_rfl, zero_le_one, he₀_norm⟩,
      fun tid d => by dsimp [q₀]; split_ifs <;> linarith [hpT_nn tid],
      fun tid => by simp [q₀],
      fun tid d hq_pos => ?_, rfl⟩
    by_cases htd : tid = d
    · subst htd
      simp [Real.rpow_zero]
    · exfalso
      simp [q₀, htd] at hq_pos

  have h_root_ub : ∀ (Q : Fin M_ω → ℝ), (∀ ω, 0 ≤ Q ω) → (∑ ω : Fin M_ω, Q ω = 1) →
      ∀ s ∈ RootSet Q, s ≤ 2 := by
    intro Q hQ_nn hQ_sum s hs
    have hpT_nn : ∀ tid, 0 ≤ p_T_of Q tid :=
      fun tid => Finset.sum_nonneg (fun ω _ => by split_ifs <;> linarith [hQ_nn ω])
    have hpT_sum : ∑ tid : Fin M_T, p_T_of Q tid = 1 := by
      dsimp [p_T_of]
      rw [Finset.sum_comm]
      simp [hQ_sum]
    rcases hs with ⟨N_D, b_D, a_D, e_D, V_D, A_D, q, h_adm, hq_nn, hq_sum, _, hs_eq⟩
    let q_D : Fin N_D → ℝ := fun d => ∑ tid : Fin M_T, q tid d
    have hqD_nn : ∀ d, 0 ≤ q_D d := fun d => Finset.sum_nonneg (fun tid _ => hq_nn tid d)
    have hqD_sum : ∑ d : Fin N_D, q_D d = 1 := by
      dsimp [q_D]
      rw [Finset.sum_comm]
      simp_rw [hq_sum]
      exact hpT_sum
    have hEw_le : (∑ d : Fin N_D, q_D d * ((1 + γ) * b_D d + (1 - γ) * a_D d)) ≤ 2 := by
      calc ∑ d : Fin N_D, q_D d * ((1 + γ) * b_D d + (1 - γ) * a_D d)
          ≤ ∑ d : Fin N_D, q_D d * 2 := by
            refine Finset.sum_le_sum (fun d _ => mul_le_mul_of_nonneg_left ?_ (hqD_nn d))
            obtain ⟨hb0, hba, ha1, _⟩ := h_adm d
            nlinarith
        _ = (∑ d : Fin N_D, q_D d) * 2 := (Finset.sum_mul _ _ _).symm
        _ = 2 := by rw [hqD_sum]; ring
    have h_kl_pt : ∀ (tid : Fin M_T) (d : Fin N_D),
        q tid d - p_T_of Q tid * q_D d ≤ q tid d * Real.log (q tid d / (p_T_of Q tid * q_D d)) := by
      intro tid d
      by_cases hq_pos : 0 < q tid d
      · have hp_pos : 0 < p_T_of Q tid := by
          refine lt_of_lt_of_le hq_pos ?_
          rw [← hq_sum tid]
          exact Finset.single_le_sum (fun d' _ => hq_nn tid d') (Finset.mem_univ d)
        have hqD_pos : 0 < q_D d :=
          lt_of_lt_of_le hq_pos (Finset.single_le_sum (fun tid' _ => hq_nn tid' d) (Finset.mem_univ tid))
        let r : ℝ := (p_T_of Q tid * q_D d) / q tid d
        have hr_pos : 0 < r := div_pos (mul_pos hp_pos hqD_pos) hq_pos
        have hlog := Real.log_le_sub_one_of_pos hr_pos
        have hinv : q tid d / (p_T_of Q tid * q_D d) = r⁻¹ := by
          dsimp [r]
          rw [inv_div]
        rw [hinv, Real.log_inv]
        have hmul := mul_le_mul_of_nonneg_left (by linarith : 1 - r ≤ -Real.log r) hq_pos.le
        have h_alg : q tid d * (1 - r) = q tid d - p_T_of Q tid * q_D d := by
          dsimp [r]
          field_simp [hq_pos.ne']
        linarith
      · have hq0 : q tid d = 0 := le_antisymm (not_lt.mp hq_pos) (hq_nn tid d)
        rw [hq0]
        simp
        exact mul_nonneg (hpT_nn tid) (hqD_nn d)
    have h_kl_sum_nn : 0 ≤ ∑ tid : Fin M_T, ∑ d : Fin N_D,
        q tid d * Real.log (q tid d / (p_T_of Q tid * q_D d)) := by
      have h_lb : (∑ tid : Fin M_T, ∑ d : Fin N_D, (q tid d - p_T_of Q tid * q_D d)) ≤
          ∑ tid : Fin M_T, ∑ d : Fin N_D, q tid d * Real.log (q tid d / (p_T_of Q tid * q_D d)) :=
        Finset.sum_le_sum (fun tid _ => Finset.sum_le_sum (fun d _ => h_kl_pt tid d))
      have h_zero : (∑ tid : Fin M_T, ∑ d : Fin N_D, (q tid d - p_T_of Q tid * q_D d)) = 0 := by
        have h_inner : ∀ tid : Fin M_T,
            (∑ d : Fin N_D, (q tid d - p_T_of Q tid * q_D d)) = 0 := by
          intro tid
          rw [Finset.sum_sub_distrib, hq_sum tid, ← Finset.mul_sum, hqD_sum, mul_one, sub_self]
        simp [h_inner]
      linarith
    have hITD_nn : 0 ≤ (∑ tid : Fin M_T, ∑ d : Fin N_D,
        q tid d * Real.log (q tid d / (p_T_of Q tid * q_D d))) / ell :=
      div_nonneg h_kl_sum_nn hell_pos.le
    rw [hs_eq]
    linarith

  have h_conj1 : ∀ (Q : Fin M_ω → ℝ), (∀ ω, 0 ≤ Q ω) → (∑ ω : Fin M_ω, Q ω = 1) →
      classicalRootSupremum ε 1 γ M_ω M_T Q T_idx V_part A_part ≤ 2 := by
    intro Q hQ_nn hQ_sum
    rw [h_root_eq]
    exact csSup_le (h_root_ne Q hQ_nn) (h_root_ub Q hQ_nn hQ_sum)

  have h_root_bdd : ∀ (Q : Fin M_ω → ℝ), (∀ ω, 0 ≤ Q ω) → (∑ ω : Fin M_ω, Q ω = 1) →
      BddAbove (RootSet Q) :=
    fun Q hQ_nn hQ_sum => ⟨2, h_root_ub Q hQ_nn hQ_sum⟩

  refine ⟨h_conj1, ?_, ?_⟩
  · 
    intro N_Z P Z hP_nn hP_sum p_Z P_z
    let p_T : Fin M_T → ℝ := p_T_of P
    let p_TZ : Fin M_T → Fin N_Z → ℝ := fun tid z =>
      ∑ ω : Fin M_ω, if T_idx ω = tid ∧ Z ω = z then P ω else 0
    have hpZ_nn : ∀ z, 0 ≤ p_Z z :=
      fun z => Finset.sum_nonneg (fun ω _ => by split_ifs <;> linarith [hP_nn ω])
    have hpZ_sum : ∑ z : Fin N_Z, p_Z z = 1 := by
      dsimp [p_Z]
      rw [Finset.sum_comm]
      simp [hP_sum]
    have hpTZ_nn : ∀ tid z, 0 ≤ p_TZ tid z :=
      fun tid z => Finset.sum_nonneg (fun ω _ => by split_ifs <;> linarith [hP_nn ω])
    have hpTZ_sum_z : ∀ tid, ∑ z : Fin N_Z, p_TZ tid z = p_T tid := by
      intro tid
      dsimp [p_TZ, p_T, p_T_of]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl (fun ω _ => ?_)
      by_cases ht : T_idx ω = tid <;> simp [ht]
    have hpTZ_le_pZ : ∀ tid z, p_TZ tid z ≤ p_Z z := by
      intro tid z
      dsimp [p_TZ, p_Z]
      refine Finset.sum_le_sum (fun ω _ => ?_)
      by_cases hz : Z ω = z
      · by_cases ht : T_idx ω = tid <;> simp [ht, hz, hP_nn ω]
      · simp [hz]
    have hpz_law : ∀ z, 0 < p_Z z →
        (∀ ω, 0 ≤ P_z z ω) ∧ (∑ ω : Fin M_ω, P_z z ω = 1) ∧
        (∀ tid, p_T_of (P_z z) tid = p_TZ tid z / p_Z z) := by
      intro z hpz_pos
      refine ⟨fun ω => ?_, ?_, fun tid => ?_⟩
      · dsimp [P_z]
        split_ifs
        · exact div_nonneg (hP_nn ω) hpz_pos.le
        · exact le_rfl
      · dsimp [P_z]
        have h_pull : (∑ ω : Fin M_ω, if Z ω = z then P ω / p_Z z else 0) =
            (∑ ω : Fin M_ω, if Z ω = z then P ω else 0) / p_Z z := by
          rw [Finset.sum_div]
          refine Finset.sum_congr rfl (fun ω _ => ?_)
          split_ifs <;> simp
        rw [h_pull]
        exact div_self hpz_pos.ne'
      · dsimp [p_T_of, P_z, p_TZ]
        rw [Finset.sum_div]
        refine Finset.sum_congr rfl (fun ω _ => ?_)
        by_cases ht : T_idx ω = tid <;> by_cases hz : Z ω = z <;> simp [ht, hz]

    have h_mi_eq : finMutualInfo ε P T_idx Z =
        (∑ tid : Fin M_T, ∑ z : Fin N_Z,
          p_TZ tid z * Real.log (p_TZ tid z / (p_T tid * p_Z z))) / ell := by
      have h_lhs : finMutualInfo ε P T_idx Z =
          (∑ ω : Fin M_ω, P ω * Real.log (p_TZ (T_idx ω) (Z ω) / (p_T (T_idx ω) * p_Z (Z ω)))) / ell := by
        unfold finMutualInfo finCondEntropy condSurprise
        rw [← Finset.sum_sub_distrib, Finset.sum_div]
        refine Finset.sum_congr rfl (fun ω _ => ?_)
        by_cases hP_pos : 0 < P ω
        · have h_fp0 : finProbAt P (fun _ => ()) ω = 1 := by
            unfold finProbAt
            simp [hP_sum]
          have h_fp2_0 : finProbAt2 P (fun _ => ()) Z ω = p_Z (Z ω) := by
            unfold finProbAt2
            dsimp [p_Z]
            refine Finset.sum_congr rfl (fun ω' _ => ?_)
            by_cases hz : Z ω' = Z ω <;> simp [hz]
          have h_fpT : finProbAt P T_idx ω = p_T (T_idx ω) := by
            unfold finProbAt
            dsimp [p_T, p_T_of]
            refine Finset.sum_congr rfl (fun ω' _ => ?_)
            by_cases ht : T_idx ω' = T_idx ω <;> simp [ht]
          have h_fpTZ : finProbAt2 P T_idx Z ω = p_TZ (T_idx ω) (Z ω) := by
            unfold finProbAt2
            dsimp [p_TZ]
            refine Finset.sum_congr rfl (fun ω' _ => ?_)
            by_cases ht : T_idx ω' = T_idx ω <;> by_cases hz : Z ω' = Z ω <;> simp [ht, hz]
          have hpTZ_pos : 0 < p_TZ (T_idx ω) (Z ω) := by
            refine lt_of_lt_of_le hP_pos ?_
            dsimp [p_TZ]
            have hle := Finset.single_le_sum
              (f := fun ω' : Fin M_ω => if T_idx ω' = T_idx ω ∧ Z ω' = Z ω then P ω' else 0)
              (fun ω' _ => by split_ifs <;> linarith [hP_nn ω']) (Finset.mem_univ ω)
            simpa using hle
          have hpZ_pos : 0 < p_Z (Z ω) := lt_of_lt_of_le hpTZ_pos (hpTZ_le_pZ (T_idx ω) (Z ω))
          have hpT_pos : 0 < p_T (T_idx ω) := by
            refine lt_of_lt_of_le hpTZ_pos ?_
            rw [← hpTZ_sum_z (T_idx ω)]
            exact Finset.single_le_sum (fun z' _ => hpTZ_nn (T_idx ω) z') (Finset.mem_univ (Z ω))
          rw [h_fp0, h_fp2_0, h_fpT, h_fpTZ, div_one]
          have h_div_eq : (p_TZ (T_idx ω) (Z ω) / p_T (T_idx ω)) / p_Z (Z ω) =
              p_TZ (T_idx ω) (Z ω) / (p_T (T_idx ω) * p_Z (Z ω)) := div_div _ _ _
          have h_log_sub : Real.log (p_TZ (T_idx ω) (Z ω) / (p_T (T_idx ω) * p_Z (Z ω))) =
              Real.log (p_TZ (T_idx ω) (Z ω) / p_T (T_idx ω)) - Real.log (p_Z (Z ω)) := by
            rw [← h_div_eq, Real.log_div (div_pos hpTZ_pos hpT_pos).ne' hpZ_pos.ne']
          rw [h_log_sub]
          change P ω * (-Real.log (p_Z (Z ω)) / ell) -
            P ω * (-Real.log (p_TZ (T_idx ω) (Z ω) / p_T (T_idx ω)) / ell) = _
          ring
        · have hP0 : P ω = 0 := le_antisymm (not_lt.mp hP_pos) (hP_nn ω)
          simp [hP0]
      have h_rhs :
          (∑ tid : Fin M_T, ∑ z : Fin N_Z,
            p_TZ tid z * Real.log (p_TZ tid z / (p_T tid * p_Z z))) =
          ∑ ω : Fin M_ω, P ω * Real.log (p_TZ (T_idx ω) (Z ω) / (p_T (T_idx ω) * p_Z (Z ω))) := by
        have h_exp : ∀ (tid : Fin M_T) (z : Fin N_Z),
            p_TZ tid z * Real.log (p_TZ tid z / (p_T tid * p_Z z)) =
            ∑ ω : Fin M_ω, if T_idx ω = tid ∧ Z ω = z then
              P ω * Real.log (p_TZ tid z / (p_T tid * p_Z z)) else 0 := by
          intro tid z
          dsimp [p_TZ]
          rw [Finset.sum_mul]
          refine Finset.sum_congr rfl (fun ω _ => ?_)
          split_ifs <;> ring
        simp_rw [h_exp]
        have h_swap : ∀ tid : Fin M_T,
            (∑ z : Fin N_Z, ∑ ω : Fin M_ω,
              if T_idx ω = tid ∧ Z ω = z then
                P ω * Real.log (p_TZ tid z / (p_T tid * p_Z z)) else 0) =
            ∑ ω : Fin M_ω, ∑ z : Fin N_Z,
              if T_idx ω = tid ∧ Z ω = z then
                P ω * Real.log (p_TZ tid z / (p_T tid * p_Z z)) else 0 :=
          fun _ => Finset.sum_comm
        simp_rw [h_swap]
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl (fun ω _ => ?_)
        have h1 : ∀ tid : Fin M_T,
            (∑ z : Fin N_Z, if T_idx ω = tid ∧ Z ω = z then
              P ω * Real.log (p_TZ tid z / (p_T tid * p_Z z)) else 0) =
            if T_idx ω = tid then
              P ω * Real.log (p_TZ tid (Z ω) / (p_T tid * p_Z (Z ω))) else 0 := by
          intro tid
          by_cases ht : T_idx ω = tid <;> simp [ht]
        simp_rw [h1]
        simp
      rw [h_lhs, h_rhs]

    refine le_of_forall_pos_le_add (fun δ_sup hδ_pos => ?_)
    have h_cell_ex : ∀ z : Fin N_Z,
        ∃ (N_Dz : ℕ) (b_z a_z : Fin N_Dz → ℝ)
          (e_z V_z A_z : Fin N_Dz → EuclideanSpace ℝ (Fin 2))
          (q_z : Fin M_T → Fin N_Dz → ℝ),
          (∀ d_z : Fin N_Dz, 0 ≤ b_z d_z ∧ b_z d_z ≤ a_z d_z ∧ a_z d_z ≤ 1 ∧ ‖e_z d_z‖ = 1) ∧
          (∀ tid d_z, 0 ≤ q_z tid d_z) ∧
          (∀ tid : Fin M_T, ∑ d_z : Fin N_Dz, p_Z z * q_z tid d_z = p_TZ tid z) ∧
          (∀ tid : Fin M_T, ∀ d_z : Fin N_Dz, 0 < p_Z z * q_z tid d_z →
            |inner ℝ (V_part tid - V_z d_z) (e_z d_z)| ≤ 10 * ε ^ (b_z d_z) ∧
            |inner ℝ (V_part tid - V_z d_z) (perp2D (e_z d_z))| ≤ 10 * ε ^ (a_z d_z) ∧
            |inner ℝ (A_part tid - A_z d_z) (e_z d_z)| ≤ 10 * ε ^ (b_z d_z) ∧
            |inner ℝ (A_part tid - A_z d_z) (perp2D (e_z d_z))| ≤ 10 * ε ^ (a_z d_z)) ∧
          (0 < p_Z z →
            let q_Dz := fun d_z => ∑ tid : Fin M_T, q_z tid d_z
            let I_TDz := (∑ tid : Fin M_T, ∑ d_z : Fin N_Dz,
              q_z tid d_z * Real.log (q_z tid d_z / ((p_TZ tid z / p_Z z) * q_Dz d_z))) / ell
            let E_wz := ∑ d_z : Fin N_Dz, q_Dz d_z * ((1 + γ) * b_z d_z + (1 - γ) * a_z d_z)
            classicalRootSupremum ε 1 γ M_ω M_T (P_z z) T_idx V_part A_part - δ_sup ≤
              E_wz - I_TDz) := by
      intro z
      by_cases hpz_pos : 0 < p_Z z
      · obtain ⟨hpz_nn, _, hpz_marg⟩ := hpz_law z hpz_pos
        have h_lt : classicalRootSupremum ε 1 γ M_ω M_T (P_z z) T_idx V_part A_part - δ_sup <
            sSup (RootSet (P_z z)) := by
          rw [← h_root_eq]
          linarith
        obtain ⟨s_z, hs_z_mem, hs_z_gt⟩ := exists_lt_of_lt_csSup (h_root_ne (P_z z) hpz_nn) h_lt
        rcases hs_z_mem with ⟨N_Dz, b_z, a_z, e_z, V_z, A_z, q_z,
          h_adm_z, hq_nn_z, hq_sum_z, hq_cap_z, hs_z_eq⟩
        refine ⟨N_Dz, b_z, a_z, e_z, V_z, A_z, q_z, h_adm_z, hq_nn_z,
          fun tid => ?_, fun tid d_z hprod_pos => ?_, fun _ => ?_⟩
        · rw [← Finset.mul_sum, hq_sum_z tid, hpz_marg tid, mul_div_cancel₀ _ hpz_pos.ne']
        · have hqz_pos : 0 < q_z tid d_z := pos_of_mul_pos_right hprod_pos hpz_pos.le
          exact hq_cap_z tid d_z hqz_pos
        · simp_rw [← hpz_marg]
          linarith [hs_z_gt, hs_z_eq]
      · have hpz0 : p_Z z = 0 := le_antisymm (not_lt.mp hpz_pos) (hpZ_nn z)
        refine ⟨0, Fin.elim0, Fin.elim0, Fin.elim0, Fin.elim0, Fin.elim0, fun _ => Fin.elim0,
          fun d => Fin.elim0 d, fun _ d => Fin.elim0 d, fun tid => ?_,
          fun _ d => Fin.elim0 d, fun hpos => absurd hpos hpz_pos⟩
        simp only [Finset.univ_eq_empty, Finset.sum_empty]
        exact (le_antisymm (by linarith [hpTZ_le_pZ tid z, hpz0]) (hpTZ_nn tid z)).symm

    let N_Dz : Fin N_Z → ℕ := fun z => Classical.choose (h_cell_ex z)
    let spec_z := fun z => Classical.choose_spec (h_cell_ex z)
    let b_z : ∀ z, Fin (N_Dz z) → ℝ := fun z => Classical.choose (spec_z z)
    let spec_z1 := fun z => Classical.choose_spec (spec_z z)
    let a_z : ∀ z, Fin (N_Dz z) → ℝ := fun z => Classical.choose (spec_z1 z)
    let spec_z2 := fun z => Classical.choose_spec (spec_z1 z)
    let e_z : ∀ z, Fin (N_Dz z) → EuclideanSpace ℝ (Fin 2) := fun z => Classical.choose (spec_z2 z)
    let spec_z3 := fun z => Classical.choose_spec (spec_z2 z)
    let V_z : ∀ z, Fin (N_Dz z) → EuclideanSpace ℝ (Fin 2) := fun z => Classical.choose (spec_z3 z)
    let spec_z4 := fun z => Classical.choose_spec (spec_z3 z)
    let A_z : ∀ z, Fin (N_Dz z) → EuclideanSpace ℝ (Fin 2) := fun z => Classical.choose (spec_z4 z)
    let spec_z5 := fun z => Classical.choose_spec (spec_z4 z)
    let q_z : ∀ z, Fin M_T → Fin (N_Dz z) → ℝ := fun z => Classical.choose (spec_z5 z)
    have h_z_props := fun z => Classical.choose_spec (spec_z5 z)

    let Sig := Σ z : Fin N_Z, Fin (N_Dz z)
    let N_D : ℕ := Fintype.card Sig
    let eqv : Sig ≃ Fin N_D := Fintype.equivFin Sig
    let b_D : Fin N_D → ℝ := fun d => b_z (eqv.symm d).1 (eqv.symm d).2
    let a_D : Fin N_D → ℝ := fun d => a_z (eqv.symm d).1 (eqv.symm d).2
    let e_D : Fin N_D → EuclideanSpace ℝ (Fin 2) := fun d => e_z (eqv.symm d).1 (eqv.symm d).2
    let V_D : Fin N_D → EuclideanSpace ℝ (Fin 2) := fun d => V_z (eqv.symm d).1 (eqv.symm d).2
    let A_D : Fin N_D → EuclideanSpace ℝ (Fin 2) := fun d => A_z (eqv.symm d).1 (eqv.symm d).2
    let q : Fin M_T → Fin N_D → ℝ :=
      fun tid d => p_Z (eqv.symm d).1 * q_z (eqv.symm d).1 tid (eqv.symm d).2

    let q_D : Fin N_D → ℝ := fun d => ∑ tid : Fin M_T, q tid d
    let I_TD : ℝ := (∑ tid : Fin M_T, ∑ d : Fin N_D,
      q tid d * Real.log (q tid d / (p_T tid * q_D d))) / ell
    let E_w : ℝ := ∑ d : Fin N_D, q_D d * ((1 + γ) * b_D d + (1 - γ) * a_D d)

    have hs_mem : E_w - I_TD ∈ RootSet P := by
      refine ⟨N_D, b_D, a_D, e_D, V_D, A_D, q,
        fun d => (h_z_props (eqv.symm d).1).1 (eqv.symm d).2,
        fun tid d => mul_nonneg (hpZ_nn _) ((h_z_props (eqv.symm d).1).2.1 tid _),
        fun tid => ?_, fun tid d hq_pos => (h_z_props (eqv.symm d).1).2.2.2.1 tid _ hq_pos, rfl⟩
      have h_eqv := Equiv.sum_comp eqv.symm
        (fun s_idx : Sig => p_Z s_idx.1 * q_z s_idx.1 tid s_idx.2)
      have hqz_sum : ∀ z : Fin N_Z, ∑ d_z : Fin (N_Dz z), p_Z z * q_z z tid d_z = p_TZ tid z :=
        fun z => (h_z_props z).2.2.1 tid
      dsimp only [q]
      rw [h_eqv, Fintype.sum_sigma]
      simp_rw [hqz_sum]
      exact hpTZ_sum_z tid

    have hs_le_sup : E_w - I_TD ≤ classicalRootSupremum ε 1 γ M_ω M_T P T_idx V_part A_part := by
      rw [h_root_eq]
      exact le_csSup (h_root_bdd P hP_nn hP_sum) hs_mem

    let q_Dz : ∀ z, Fin (N_Dz z) → ℝ := fun z d_z => ∑ tid : Fin M_T, q_z z tid d_z
    let E_wz : Fin N_Z → ℝ := fun z =>
      ∑ d_z : Fin (N_Dz z), q_Dz z d_z * ((1 + γ) * b_z z d_z + (1 - γ) * a_z z d_z)
    let I_TDz : Fin N_Z → ℝ := fun z =>
      (∑ tid : Fin M_T, ∑ d_z : Fin (N_Dz z),
        q_z z tid d_z * Real.log (q_z z tid d_z / ((p_TZ tid z / p_Z z) * q_Dz z d_z))) / ell

    have hqD_sigma : ∀ s_idx : Sig, q_D (eqv s_idx) = p_Z s_idx.1 * q_Dz s_idx.1 s_idx.2 := by
      intro s_idx
      dsimp only [q_D, q, q_Dz]
      rw [eqv.symm_apply_apply]
      simp [Finset.mul_sum]

    have hEw_eq : E_w = ∑ z : Fin N_Z, if 0 < p_Z z then p_Z z * E_wz z else 0 := by
      have h_eqv := (Equiv.sum_comp eqv
        (fun d : Fin N_D => q_D d * ((1 + γ) * b_D d + (1 - γ) * a_D d))).symm
      dsimp only [E_w]
      rw [h_eqv]
      have h_step : ∀ s_idx : Sig,
          q_D (eqv s_idx) * ((1 + γ) * b_D (eqv s_idx) + (1 - γ) * a_D (eqv s_idx)) =
          (p_Z s_idx.1 * q_Dz s_idx.1 s_idx.2) *
            ((1 + γ) * b_z s_idx.1 s_idx.2 + (1 - γ) * a_z s_idx.1 s_idx.2) := by
        intro s_idx
        dsimp only [b_D, a_D]
        rw [hqD_sigma, eqv.symm_apply_apply]
      simp_rw [h_step]
      rw [Fintype.sum_sigma]
      refine Finset.sum_congr rfl (fun z _ => ?_)
      by_cases hpz_pos : 0 < p_Z z
      · simp only [hpz_pos, ↓reduceIte, E_wz, Finset.mul_sum, mul_assoc]
      · have hpz0 : p_Z z = 0 := le_antisymm (not_lt.mp hpz_pos) (hpZ_nn z)
        simp [hpz0]

    have hITD_eq : I_TD =
        (∑ z : Fin N_Z, if 0 < p_Z z then p_Z z * I_TDz z else 0) +
          finMutualInfo ε P T_idx Z := by
      dsimp only [I_TD]
      have h_sum_d : ∀ tid : Fin M_T,
          (∑ d : Fin N_D, q tid d * Real.log (q tid d / (p_T tid * q_D d))) =
          ∑ z : Fin N_Z, ∑ d_z : Fin (N_Dz z),
            (p_Z z * q_z z tid d_z) *
              Real.log ((p_Z z * q_z z tid d_z) / (p_T tid * (p_Z z * q_Dz z d_z))) := by
        intro tid
        have h_eqv := (Equiv.sum_comp eqv
          (fun d : Fin N_D => q tid d * Real.log (q tid d / (p_T tid * q_D d)))).symm
        rw [h_eqv]
        have h_step : ∀ s_idx : Sig,
            q tid (eqv s_idx) * Real.log (q tid (eqv s_idx) / (p_T tid * q_D (eqv s_idx))) =
            (p_Z s_idx.1 * q_z s_idx.1 tid s_idx.2) *
              Real.log ((p_Z s_idx.1 * q_z s_idx.1 tid s_idx.2) /
                (p_T tid * (p_Z s_idx.1 * q_Dz s_idx.1 s_idx.2))) := by
          intro s_idx
          dsimp only [q]
          rw [hqD_sigma, eqv.symm_apply_apply]
        simp_rw [h_step]
        rw [Fintype.sum_sigma]
      simp_rw [h_sum_d]
      have h_term_split : ∀ (tid : Fin M_T) (z : Fin N_Z) (d_z : Fin (N_Dz z)),
          (p_Z z * q_z z tid d_z) *
            Real.log ((p_Z z * q_z z tid d_z) / (p_T tid * (p_Z z * q_Dz z d_z))) =
          (p_Z z * q_z z tid d_z) *
            Real.log (q_z z tid d_z / ((p_TZ tid z / p_Z z) * q_Dz z d_z)) +
          (p_Z z * q_z z tid d_z) *
            Real.log (p_TZ tid z / (p_T tid * p_Z z)) := by
        intro tid z d_z
        by_cases hprod_pos : 0 < p_Z z * q_z z tid d_z
        · have hpz_pos : 0 < p_Z z := pos_of_mul_pos_left hprod_pos ((h_z_props z).2.1 tid d_z)
          have hqz_pos : 0 < q_z z tid d_z := pos_of_mul_pos_right hprod_pos (hpZ_nn z)
          have hpTZ_pos : 0 < p_TZ tid z := by
            refine lt_of_lt_of_le hprod_pos ?_
            rw [← (h_z_props z).2.2.1 tid]
            exact Finset.single_le_sum
              (fun d_z' _ => mul_nonneg (hpZ_nn z) ((h_z_props z).2.1 tid d_z'))
              (Finset.mem_univ d_z)
          have hpT_pos : 0 < p_T tid := by
            refine lt_of_lt_of_le hpTZ_pos ?_
            rw [← hpTZ_sum_z tid]
            exact Finset.single_le_sum (fun z' _ => hpTZ_nn tid z') (Finset.mem_univ z)
          have hqDz_pos : 0 < q_Dz z d_z :=
            lt_of_lt_of_le hqz_pos
              (Finset.single_le_sum (fun tid' _ => (h_z_props z).2.1 tid' d_z) (Finset.mem_univ tid))
          have h_frac : (p_Z z * q_z z tid d_z) / (p_T tid * (p_Z z * q_Dz z d_z)) =
              (q_z z tid d_z / ((p_TZ tid z / p_Z z) * q_Dz z d_z)) *
                (p_TZ tid z / (p_T tid * p_Z z)) := by
            field_simp [hpz_pos.ne', hpT_pos.ne', hpTZ_pos.ne', hqDz_pos.ne']
          have hf1_pos : 0 < q_z z tid d_z / ((p_TZ tid z / p_Z z) * q_Dz z d_z) :=
            div_pos hqz_pos (mul_pos (div_pos hpTZ_pos hpz_pos) hqDz_pos)
          have hf2_pos : 0 < p_TZ tid z / (p_T tid * p_Z z) :=
            div_pos hpTZ_pos (mul_pos hpT_pos hpz_pos)
          rw [h_frac, Real.log_mul hf1_pos.ne' hf2_pos.ne', mul_add]
        · have hprod0 : p_Z z * q_z z tid d_z = 0 :=
            le_antisymm (not_lt.mp hprod_pos) (mul_nonneg (hpZ_nn z) ((h_z_props z).2.1 tid d_z))
          rw [hprod0]
          simp
      simp_rw [h_term_split, Finset.sum_add_distrib]
      rw [add_div, h_mi_eq]
      congr 1
      · rw [Finset.sum_comm]
        rw [Finset.sum_div]
        refine Finset.sum_congr rfl (fun z _ => ?_)
        by_cases hpz_pos : 0 < p_Z z
        · simp only [hpz_pos, ↓reduceIte, I_TDz]
          simp_rw [mul_assoc, ← Finset.mul_sum]
          rw [mul_div_assoc]
        · have hpz0 : p_Z z = 0 := le_antisymm (not_lt.mp hpz_pos) (hpZ_nn z)
          simp [hpz0]
      · congr 1
        refine Finset.sum_congr rfl (fun tid _ => Finset.sum_congr rfl (fun z _ => ?_))
        rw [← Finset.sum_mul, (h_z_props z).2.2.1 tid]

    have h_score_lb :
        (∑ z : Fin N_Z,
          if 0 < p_Z z then
            p_Z z * classicalRootSupremum ε 1 γ M_ω M_T (P_z z) T_idx V_part A_part
          else 0) - δ_sup ≤
        ∑ z : Fin N_Z, if 0 < p_Z z then p_Z z * (E_wz z - I_TDz z) else 0 := by
      have h_del_le :
          (∑ z : Fin N_Z, if 0 < p_Z z then p_Z z * δ_sup else 0) ≤ δ_sup := by
        calc (∑ z : Fin N_Z, if 0 < p_Z z then p_Z z * δ_sup else 0)
            ≤ ∑ z : Fin N_Z, p_Z z * δ_sup := by
              refine Finset.sum_le_sum (fun z _ => ?_)
              split_ifs
              · exact le_rfl
              · exact mul_nonneg (hpZ_nn z) hδ_pos.le
          _ = (∑ z : Fin N_Z, p_Z z) * δ_sup := (Finset.sum_mul _ _ _).symm
          _ = δ_sup := by rw [hpZ_sum, one_mul]
      have h_step :
          (∑ z : Fin N_Z,
            if 0 < p_Z z then
              p_Z z * (classicalRootSupremum ε 1 γ M_ω M_T (P_z z) T_idx V_part A_part - δ_sup)
            else 0) ≤
          ∑ z : Fin N_Z, if 0 < p_Z z then p_Z z * (E_wz z - I_TDz z) else 0 := by
        refine Finset.sum_le_sum (fun z _ => ?_)
        split_ifs with hpz_pos
        · exact mul_le_mul_of_nonneg_left ((h_z_props z).2.2.2.2 hpz_pos) hpz_pos.le
        · exact le_rfl
      have h_split :
          (∑ z : Fin N_Z,
            if 0 < p_Z z then
              p_Z z * (classicalRootSupremum ε 1 γ M_ω M_T (P_z z) T_idx V_part A_part - δ_sup)
            else 0) =
          (∑ z : Fin N_Z,
            if 0 < p_Z z then
              p_Z z * classicalRootSupremum ε 1 γ M_ω M_T (P_z z) T_idx V_part A_part
            else 0) -
          (∑ z : Fin N_Z, if 0 < p_Z z then p_Z z * δ_sup else 0) := by
        rw [← Finset.sum_sub_distrib]
        refine Finset.sum_congr rfl (fun z _ => ?_)
        split_ifs <;> ring
      linarith

    have h_ew_sub_itd :
        E_w - I_TD =
        (∑ z : Fin N_Z, if 0 < p_Z z then p_Z z * (E_wz z - I_TDz z) else 0) -
          finMutualInfo ε P T_idx Z := by
      rw [hEw_eq, hITD_eq]
      have h_comb :
          (∑ z : Fin N_Z, if 0 < p_Z z then p_Z z * E_wz z else 0) -
          (∑ z : Fin N_Z, if 0 < p_Z z then p_Z z * I_TDz z else 0) =
          ∑ z : Fin N_Z, if 0 < p_Z z then p_Z z * (E_wz z - I_TDz z) else 0 := by
        rw [← Finset.sum_sub_distrib]
        refine Finset.sum_congr rfl (fun z _ => ?_)
        split_ifs <;> ring
      linarith

    linarith [hs_le_sup, h_score_lb, h_ew_sub_itd]

  · 
    intro J_cap
    let G_net : ℕ := ⌈100 / ε⌉₊ + 1
    have hG_pos : (0 : ℝ) < (G_net : ℝ) := by
      dsimp [G_net]
      positivity
    have hG_ge_100 : 100 / ε ≤ (G_net : ℝ) := by
      dsimp [G_net]
      push_cast
      linarith [Nat.le_ceil (100 / ε)]
    have hG_inv_le : (G_net : ℝ)⁻¹ ≤ (1 / 100 : ℝ) * ε := by
      have h1 : (G_net : ℝ)⁻¹ ≤ (100 / ε)⁻¹ := inv_anti₀ (by positivity) hG_ge_100
      have h2 : (100 / ε)⁻¹ = (1 / 100 : ℝ) * ε := by
        field_simp [hε₀.ne']
      linarith

    let G_Z : ℤ := (G_net : ℤ)
    let S_dir : Finset (ℤ × ℤ) :=
      ((Finset.Icc (-G_Z) G_Z) ×ˢ (Finset.Icc (-G_Z) G_Z)).filter (fun ij => ij ≠ (0, 0))
    let rawVec : ℤ × ℤ → EuclideanSpace ℝ (Fin 2) :=
      fun ij => WithLp.toLp 2 (fun i : Fin 2 => if i = 0 then (ij.1 : ℝ) else (ij.2 : ℝ))
    let u_dir : ℤ × ℤ → EuclideanSpace ℝ (Fin 2) :=
      fun ij => ‖rawVec ij‖⁻¹ • rawVec ij

    have h_raw_pos : ∀ ij ∈ S_dir, 0 < ‖rawVec ij‖ := by
      intro ij hij
      have hne : ij ≠ (0, 0) := (Finset.mem_filter.mp hij).2
      have hsq_pos : 0 < ‖rawVec ij‖ ^ 2 := by
        rw [h_norm_sq]
        change 0 < (ij.1 : ℝ) ^ 2 + (ij.2 : ℝ) ^ 2
        by_cases h1 : ij.1 = 0
        · have h2 : ij.2 ≠ 0 := fun h2 => hne (Prod.ext h1 h2)
          have h2r : (ij.2 : ℝ) ≠ 0 := Int.cast_ne_zero.mpr h2
          positivity
        · have h1r : (ij.1 : ℝ) ≠ 0 := Int.cast_ne_zero.mpr h1
          positivity
      by_contra hle
      have h0 : ‖rawVec ij‖ = 0 := le_antisymm (not_lt.mp hle) (norm_nonneg _)
      rw [h0] at hsq_pos
      norm_num at hsq_pos

    have hu_dir_norm : ∀ ij ∈ S_dir, ‖u_dir ij‖ = 1 := by
      intro ij hij
      have hp := h_raw_pos ij hij
      dsimp [u_dir]
      rw [norm_smul, Real.norm_of_nonneg (inv_nonneg.mpr hp.le), inv_mul_cancel₀ hp.ne']

    have h10_mem : ((1 : ℤ), (0 : ℤ)) ∈ S_dir := by
      refine Finset.mem_filter.mpr ⟨Finset.mem_product.mpr ⟨?_, ?_⟩, by decide⟩
      · refine Finset.mem_Icc.mpr ⟨?_, ?_⟩ <;> { dsimp [G_Z, G_net]; omega }
      · refine Finset.mem_Icc.mpr ⟨?_, ?_⟩ <;> { dsimp [G_Z, G_net]; omega }

    have hu10_eq : u_dir (1, 0) = e₀_unit := by
      have h_norm10 : ‖rawVec (1, 0)‖ = 1 := by
        refine h_sq_eq (norm_nonneg _) zero_le_one ?_
        rw [h_norm_sq]
        change ((1 : ℤ) : ℝ) ^ 2 + ((0 : ℤ) : ℝ) ^ 2 = 1 ^ 2
        norm_num
      dsimp [u_dir]
      rw [h_norm10, inv_one, one_smul]
      ext i
      fin_cases i <;> simp [rawVec, e₀_unit]

    have h_net_approx : ∀ e : EuclideanSpace ℝ (Fin 2), ‖e‖ = 1 →
        ∃ ij ∈ S_dir, ‖u_dir ij - e‖ ≤ (4 / 100 : ℝ) * ε := by
      intro e he
      let ij : ℤ × ℤ := (⌊(G_net : ℝ) * e 0⌋, ⌊(G_net : ℝ) * e 1⌋)
      have hij_box : ∀ i : Fin 2, ⌊(G_net : ℝ) * e i⌋ ∈ Finset.Icc (-G_Z) G_Z := by
        intro i
        have hc := h_coord_le e i
        rw [he] at hc
        obtain ⟨hlo, hhi⟩ := abs_le.mp hc
        refine Finset.mem_Icc.mpr ⟨?_, ?_⟩
        · refine Int.le_floor.mpr ?_
          dsimp [G_Z]
          push_cast
          nlinarith [hlo, hG_pos]
        · have hfl : ((⌊(G_net : ℝ) * e i⌋ : ℤ) : ℝ) ≤ (G_net : ℝ) * e i := Int.floor_le _
          have hle : ((⌊(G_net : ℝ) * e i⌋ : ℤ) : ℝ) ≤ (G_Z : ℝ) := by
            dsimp [G_Z]
            push_cast
            nlinarith [hfl, hhi, hG_pos]
          exact_mod_cast hle
      let w : EuclideanSpace ℝ (Fin 2) := (G_net : ℝ)⁻¹ • rawVec ij
      have hew_coord : ∀ i : Fin 2, |e i - w i| ≤ (G_net : ℝ)⁻¹ := by
        intro i
        have hlo := Int.floor_le ((G_net : ℝ) * e i)
        have hhi := Int.lt_floor_add_one ((G_net : ℝ) * e i)
        have hw_i : w i = (G_net : ℝ)⁻¹ * (⌊(G_net : ℝ) * e i⌋ : ℝ) := by
          fin_cases i <;> rfl
        rw [hw_i]
        have hdiff_eq : e i - (G_net : ℝ)⁻¹ * (⌊(G_net : ℝ) * e i⌋ : ℝ) =
            (G_net : ℝ)⁻¹ * ((G_net : ℝ) * e i - (⌊(G_net : ℝ) * e i⌋ : ℝ)) := by
          field_simp [hG_pos.ne']
        rw [hdiff_eq, abs_le]
        constructor
        · nlinarith [inv_nonneg.mpr hG_pos.le, hlo]
        · have h1 := mul_le_mul_of_nonneg_left
            (by linarith : (G_net : ℝ) * e i - (⌊(G_net : ℝ) * e i⌋ : ℝ) ≤ 1)
            (inv_nonneg.mpr hG_pos.le)
          linarith
      have hew_norm : ‖e - w‖ ≤ (2 / 100 : ℝ) * ε := by
        have h1 : ‖e - w‖ ≤ 2 * (G_net : ℝ)⁻¹ := by
          refine h_sq_le (by positivity) ?_
          rw [h_norm_sq]
          have hc0 : (e 0 - w 0) ^ 2 ≤ ((G_net : ℝ)⁻¹) ^ 2 := by
            rw [← sq_abs (e 0 - w 0), ← sq_abs (G_net : ℝ)⁻¹]
            exact pow_le_pow_left₀ (abs_nonneg _)
              (le_trans (hew_coord 0) (le_abs_self _)) 2
          have hc1 : (e 1 - w 1) ^ 2 ≤ ((G_net : ℝ)⁻¹) ^ 2 := by
            rw [← sq_abs (e 1 - w 1), ← sq_abs (G_net : ℝ)⁻¹]
            exact pow_le_pow_left₀ (abs_nonneg _)
              (le_trans (hew_coord 1) (le_abs_self _)) 2
          change (e 0 - w 0) ^ 2 + (e 1 - w 1) ^ 2 ≤ (2 * (G_net : ℝ)⁻¹) ^ 2
          nlinarith [sq_nonneg (G_net : ℝ)⁻¹]
        linarith
      have hw_pos : 0 < ‖w‖ := by
        have htri := norm_le_norm_sub_add e w
        rw [he] at htri
        linarith
      have hij_ne : ij ≠ (0, 0) := by
        intro h0
        have hw0 : ‖w‖ ^ 2 = 0 := by
          rw [h_norm_sq]
          change ((G_net : ℝ)⁻¹ * (ij.1 : ℝ)) ^ 2 + ((G_net : ℝ)⁻¹ * (ij.2 : ℝ)) ^ 2 = 0
          rw [h0]
          simp
        nlinarith [hw_pos]
      have hij_mem : ij ∈ S_dir :=
        Finset.mem_filter.mpr ⟨Finset.mem_product.mpr ⟨hij_box 0, hij_box 1⟩, hij_ne⟩
      have hw_norm_eq : ‖w‖ = (G_net : ℝ)⁻¹ * ‖rawVec ij‖ := by
        dsimp [w]
        rw [norm_smul, Real.norm_of_nonneg (inv_nonneg.mpr hG_pos.le)]
      have hu_eq : u_dir ij = ‖w‖⁻¹ • w := by
        dsimp [u_dir, w]
        rw [smul_smul, hw_norm_eq, mul_inv, inv_inv]
        congr 1
        field_simp [hG_pos.ne']
      have hw_smul : w = ‖w‖ • u_dir ij := by
        rw [hu_eq, smul_smul, mul_inv_cancel₀ hw_pos.ne', one_smul]
      have h_decomp : u_dir ij - e = (w - e) + (1 - ‖w‖) • u_dir ij := by
        ext i
        have hwi : w i = ‖w‖ * u_dir ij i := by
          conv_lhs => rw [hw_smul]
          rfl
        change u_dir ij i - e i = (w i - e i) + (1 - ‖w‖) * u_dir ij i
        rw [hwi]
        ring
      refine ⟨ij, hij_mem, ?_⟩
      have htri2 := norm_add_le (w - e) ((1 - ‖w‖) • u_dir ij)
      rw [← h_decomp, norm_sub_rev w e, norm_smul, hu_dir_norm ij hij_mem, mul_one,
        Real.norm_eq_abs] at htri2
      have habs_norm : |1 - ‖w‖| ≤ ‖e - w‖ := by
        rw [← he]
        exact abs_norm_sub_norm_le e w
      linarith

    let M_ξ : ℕ := ⌊1 / ξ⌋₊
    let DepthPair := { p : Fin (M_ξ + 1) × Fin (M_ξ + 1) // p.1.val ≤ p.2.val }
    let R_max : ℤ := (⌈B_iso / ε⌉₊ : ℤ) + 20
    let box_R : Finset ℤ := Finset.Icc (-R_max) R_max
    let MenuType := DepthPair × ↥S_dir × (↥box_R × ↥box_R) × (↥box_R × ↥box_R)
    let _ : Fintype MenuType := by dsimp [MenuType, DepthPair]; infer_instance
    let _ : DecidableEq MenuType := Classical.decEq MenuType

    let b_menu : MenuType → ℝ := fun m => (m.1.val.1.val : ℝ) * ξ
    let a_menu : MenuType → ℝ := fun m => (m.1.val.2.val : ℝ) * ξ
    let e_menu : MenuType → EuclideanSpace ℝ (Fin 2) := fun m => u_dir m.2.1.val
    let V_menu : MenuType → EuclideanSpace ℝ (Fin 2) := fun m =>
      ((m.2.2.1.1.val : ℝ) * ε ^ (b_menu m)) • e_menu m +
        ((m.2.2.1.2.val : ℝ) * ε ^ (a_menu m)) • perp2D (e_menu m)
    let A_menu : MenuType → EuclideanSpace ℝ (Fin 2) := fun m =>
      ((m.2.2.2.1.val : ℝ) * ε ^ (b_menu m)) • e_menu m +
        ((m.2.2.2.2.val : ℝ) * ε ^ (a_menu m)) • perp2D (e_menu m)
    let w_menu : MenuType → ℝ := fun m => (1 + γ) * b_menu m + (1 - γ) * a_menu m
    let C_menu : MenuType → Finset (Fin M_T) := fun m =>
      @Finset.filter (Fin M_T)
        (fun tid =>
          |inner ℝ (V_part tid - V_menu m) (e_menu m)| ≤ 10 * ε ^ (b_menu m) ∧
          |inner ℝ (V_part tid - V_menu m) (perp2D (e_menu m))| ≤ 10 * ε ^ (a_menu m) ∧
          |inner ℝ (A_part tid - A_menu m) (e_menu m)| ≤ 10 * ε ^ (b_menu m) ∧
          |inner ℝ (A_part tid - A_menu m) (perp2D (e_menu m))| ≤ 10 * ε ^ (a_menu m))
        (fun _ => Classical.propDecidable _) Finset.univ

    have h_cap_mem : ∀ (m : MenuType) (tid : Fin M_T),
        tid ∈ C_menu m ↔
          (|inner ℝ (V_part tid - V_menu m) (e_menu m)| ≤ 10 * ε ^ (b_menu m) ∧
           |inner ℝ (V_part tid - V_menu m) (perp2D (e_menu m))| ≤ 10 * ε ^ (a_menu m) ∧
           |inner ℝ (A_part tid - A_menu m) (e_menu m)| ≤ 10 * ε ^ (b_menu m) ∧
           |inner ℝ (A_part tid - A_menu m) (perp2D (e_menu m))| ≤ 10 * ε ^ (a_menu m)) := by
      intro m tid
      dsimp [C_menu]
      rw [@Finset.mem_filter _ _ (fun _ => Classical.propDecidable _)]
      simp

    have h_menu_adm : ∀ m : MenuType,
        0 ≤ b_menu m ∧ b_menu m ≤ a_menu m ∧ a_menu m ≤ 1 ∧ ‖e_menu m‖ = 1 ∧
        0 ≤ w_menu m ∧ w_menu m ≤ 2 := by
      intro m
      have hb0 : 0 ≤ b_menu m := mul_nonneg (Nat.cast_nonneg _) hξ₀.le
      have hba : b_menu m ≤ a_menu m := by
        dsimp [b_menu, a_menu]
        exact mul_le_mul_of_nonneg_right (by exact_mod_cast m.1.prop) hξ₀.le
      have ha1 : a_menu m ≤ 1 := by
        dsimp [a_menu]
        have hle_M : m.1.val.2.val ≤ M_ξ := Nat.le_of_lt_succ m.1.val.2.isLt
        have hfl : (M_ξ : ℝ) ≤ 1 / ξ := Nat.floor_le (by positivity)
        calc (m.1.val.2.val : ℝ) * ξ
            ≤ (M_ξ : ℝ) * ξ := mul_le_mul_of_nonneg_right (by exact_mod_cast hle_M) hξ₀.le
          _ ≤ (1 / ξ) * ξ := mul_le_mul_of_nonneg_right hfl hξ₀.le
          _ = 1 := div_mul_cancel₀ 1 hξ₀.ne'
      have he_n : ‖e_menu m‖ = 1 := hu_dir_norm m.2.1.val m.2.1.prop
      refine ⟨hb0, hba, ha1, he_n, by dsimp [w_menu]; nlinarith, by dsimp [w_menu]; nlinarith⟩

    
    let dp0 : DepthPair := ⟨(⟨0, Nat.zero_lt_succ M_ξ⟩, ⟨0, Nat.zero_lt_succ M_ξ⟩), le_rfl⟩
    let dir0 : ↥S_dir := ⟨(1, 0), h10_mem⟩
    let R₀ : ℤ := (⌈B_iso⌉₊ : ℤ) + 1
