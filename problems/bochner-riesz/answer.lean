      dsimp only [C_slice, σ]
      field_simp [hlam.ne', hρ.ne']
      ring
    calc σ⁻¹ ^ 2 * ∫ p in R_strip, F_sq p
        ≤ σ⁻¹ ^ 2 * (s * ∫ t_n in I_n, ∫ y : ℝ, ω_tan y * F_sq (t_n, s * y)) :=
          mul_le_mul_of_nonneg_left h_strip_le_smooth (by positivity)
      _ ≤ σ⁻¹ ^ 2 * (s * ((2 * (B_cell + 1) * σ) * C_slice)) :=
