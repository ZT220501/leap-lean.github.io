          ∑ x ∈ I, (1 : ℝ) * ‖P_fn (fun v => ∑ α ∈ F_part x, c_at α * g_at α v)‖ := by
        calc ‖∑ x ∈ I, P_fn (fun v => ∑ α ∈ F_part x, c_at α * g_at α v)‖
            ≤ ∑ x ∈ I, ‖P_fn (fun v => ∑ α ∈ F_part x, c_at α * g_at α v)‖ := norm_sum_le _ _
          _ = _ := by simp
      have h_sq1 := pow_le_pow_left₀ (norm_nonneg _) h_ns 2
      have h_sq2 := Finset.sum_mul_sq_le_sq_mul_sq I (fun _ => (1 : ℝ))
        (fun x => ‖P_fn (fun v => ∑ α ∈ F_part x, c_at α * g_at α v)‖)
      calc ‖∑ x ∈ I, P_fn (fun v => ∑ α ∈ F_part x, c_at α * g_at α v)‖ ^ 2
          ≤ (∑ _ ∈ I, (1 : ℝ) ^ 2) *
              ∑ x ∈ I, ‖P_fn (fun v => ∑ α ∈ F_part x, c_at α * g_at α v)‖ ^ 2 :=
            le_trans h_sq1 h_sq2
        _ = (I.card : ℝ) * ∑ i ∈ I,
              generalPacketObsMass ε H_P t lam_sys m_t Φ₀
                (fun v => ∑ α ∈ F_part i, c_at α * g_at α v) r_idx V_o X_o ψ_o := by
            simp only [one_pow, Finset.sum_const, nsmul_eq_mul, mul_one]
            congr 1
            exact Finset.sum_congr rfl (fun i _ => (hP_mass _).symm)

  have h_s2_slice :
      ∀ (ε H_P t lam_sys ρ_r C_r : ℝ) (m_t r_idx : ℕ)
        (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
        (V_at X_at V_o X_o : EuclideanSpace ℝ (Fin 2))
        (ψ_at ψ_o : EuclideanSpace ℝ (Fin 2) → ℂ),
        let ρ_t := ε ^ ((H_P - t) / 2)
        let C_t := ((r_idx : ℝ) + 1 / 2) * ((2 : ℝ) ^ m_t)⁻¹
        let g_at := fun v : EuclideanSpace ℝ (Fin 2) =>
          (ρ_r⁻¹ : ℂ) * star (ψ_at (ρ_r⁻¹ • (v - V_at))) *
            Complex.exp (-(Complex.I * ((lam_sys * Φ₀ (C_r, X_at, v) : ℝ) : ℂ)))
        0 < ε → 0 < ρ_r → ρ_r ≤ ρ_t → Continuous Φ₀ →
        Continuous ψ_at → (∀ z : EuclideanSpace ℝ (Fin 2), 4 ≤ ‖z‖ → ψ_at z = 0) →
        Continuous ψ_o → (∀ z : EuclideanSpace ℝ (Fin 2), cls.R_win ≤ ‖z‖ → ψ_o z = 0) →
        ((cls.R_win + 4) * ρ_t ≤ ‖V_o - V_at‖ →
          generalPacketObsMass ε H_P t lam_sys m_t Φ₀ g_at r_idx V_o X_o ψ_o = 0) ∧
        (∀ (e : EuclideanSpace ℝ (Fin 2)), ‖e‖ = 1 →
          ∀ (M_sl : ℝ), 0 ≤ M_sl →
            (∀ y₁ ∈ Set.Icc (-4 : ℝ) 4,
              ‖∫ s : ℝ,
                (star (ψ_at (s • e + y₁ • perp2D e)) *
                  ψ_o (ρ_t⁻¹ • (V_at - V_o) + (ρ_r / ρ_t) • (s • e + y₁ • perp2D e))) *
                Complex.exp (Complex.I *
                  ((lam_sys * (Φ₀ (C_t, X_o, V_at + ρ_r • (s • e + y₁ • perp2D e)) -
                    Φ₀ (C_r, X_at, V_at + ρ_r • (s • e + y₁ • perp2D e))) : ℝ) : ℂ))‖ ≤ M_sl) →
            generalPacketObsMass ε H_P t lam_sys m_t Φ₀ g_at r_idx V_o X_o ψ_o ≤ (8 * M_sl) ^ 2) := by
    intro ε H_P t lam_sys ρ_r C_r m_t r_idx Φ₀ V_at X_at V_o X_o ψ_at ψ_o
      ρ_t C_t g_at hε₀ hρ_r_pos hρ_le_t hΦ_cont hψ_at_cont hψ_at_supp hψ_o_cont hψ_o_supp
    have hρ_t_pos : 0 < ρ_t := Real.rpow_pos_of_pos hε₀ _
    have hρ_r_ne : ρ_r ≠ 0 := hρ_r_pos.ne'
    have hρ_t_ne : ρ_t ≠ 0 := hρ_t_pos.ne'
    refine ⟨?_, ?_⟩
    · intro hV_sep
      dsimp only [generalPacketObsMass]
      have h_zero_fn : ∀ v : EuclideanSpace ℝ (Fin 2),
          g_at v * ψ_o (ρ_t⁻¹ • (v - V_o)) *
            Complex.exp (Complex.I * ((lam_sys * Φ₀ (C_t, X_o, v) : ℝ) : ℂ)) = 0 := by
        intro v
        by_cases hv_at : 4 * ρ_r ≤ ‖v - V_at‖
        · have h_n1 : 4 ≤ ‖ρ_r⁻¹ • (v - V_at)‖ := by
            rw [norm_smul, Real.norm_of_nonneg (inv_nonneg.mpr hρ_r_pos.le)]
            have hm := mul_le_mul_of_nonneg_left hv_at (inv_nonneg.mpr hρ_r_pos.le)
            rwa [← mul_assoc, mul_comm ρ_r⁻¹ 4, mul_assoc, inv_mul_cancel₀ hρ_r_ne, mul_one] at hm
          have h0 : ψ_at (ρ_r⁻¹ • (v - V_at)) = 0 := hψ_at_supp _ h_n1
