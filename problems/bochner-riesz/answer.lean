    refine ⟨hθ_cd, hθ_lower, ?_⟩
    intro m _hm1 y
    have h_deriv_fn : deriv θ_pos = (fun y' => F₁ (y', 1)) - (fun y' => F₁ (y', 0)) :=
      funext hθ_deriv_eq
    have hF1_1 : ContDiff ℝ m (fun y' => F₁ (y', 1)) :=
