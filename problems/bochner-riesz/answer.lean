          fun z _ hpos => Finset.mem_filter.mpr ⟨Finset.mem_univ z, hq_sync z d α hpos,
            (hq_supp z d α hpos).1⟩
        have hcard_S := h_supp_card_ent Finset.univ S (fun z => q z d α) (q_TD α d) (M_amb : ℝ)
