          _ = (2 * (M_L : ℝ) + 4) * ε ^ u := h1
          _ ≤ (2 * (M_L : ℝ) + 4) * s_VF := mul_le_mul_of_nonneg_left h2 hML_pos
      have hwX2_bd : ‖w_X2‖ ≤ (8 * C_cov * cls.B_sys + 16) * ε ^ (-θ) * s_XF := by
