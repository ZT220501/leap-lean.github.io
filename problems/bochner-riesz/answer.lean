          have h_div_not : ((g₂ α).1 / K, (g₂ α).2 / K) ∉ I₁ := by
            rw [← h_nest_div (V_at α)]
            exact hk₁_not
          have hk₂_gt : R_disk - 2 * s₂ < ‖gridPt2D s₂ (g₂ α) - V_O o‖ := by
            by_contra h_le
            rw [not_lt] at h_le
            exact hk₂_not ((h_mem_I₂ (g₂ α)).mpr ⟨hk₂_K₂, h_div_not, h_le⟩)
          have h_err : ‖V_at α - gridPt2D s₂ (g₂ α)‖ ≤ 2 * s₂ := h_diam s₂ (V_at α) hs₂_pos
          have h_tri : ‖gridPt2D s₂ (g₂ α) - V_O o‖ ≤ 2 * s₂ + ‖V_at α - V_O o‖ := by
            have h_id : gridPt2D s₂ (g₂ α) - V_O o =
                (gridPt2D s₂ (g₂ α) - V_at α) + (V_at α - V_O o) :=
              (sub_add_sub_cancel _ _ _).symm
            rw [h_id]
            calc ‖(gridPt2D s₂ (g₂ α) - V_at α) + (V_at α - V_O o)‖
                ≤ ‖gridPt2D s₂ (g₂ α) - V_at α‖ + ‖V_at α - V_O o‖ := norm_add_le _ _
              _ = ‖V_at α - gridPt2D s₂ (g₂ α)‖ + ‖V_at α - V_O o‖ := by rw [norm_sub_rev]
              _ ≤ 2 * s₂ + ‖V_at α - V_O o‖ := add_le_add h_err le_rfl
          exact ⟨by linarith only [hk₂_gt, h_tri], hV_hi⟩
        
        let J_bdry : Finset (ℤ × ℤ) := S_bdry.image (fun α => (sub.o_at α).1)
        have hJ_in_ann : ∀ j ∈ J_bdry,
