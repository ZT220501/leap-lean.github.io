    clear h_geom h_core h_slice_proj ha h_proj
    intro ϑ δ_sc hϑ₀ hϑ₁ hδ_sc
    obtain ⟨M₀, hM₀_gt⟩ := exists_nat_gt (4 / δ_sc)
    have h2M₀_pos : (0 : ℝ) < (2 : ℝ) ^ M₀ := by positivity
    have h_mesh_step : ((2 : ℝ) ^ M₀)⁻¹ ≤ δ_sc / 4 := by
      have h1 : 4 / δ_sc < (2 : ℝ) ^ M₀ := by
        have h_nat : M₀ < 2 ^ M₀ := Nat.lt_two_pow_self
        have h_cast : (M₀ : ℝ) < (2 : ℝ) ^ M₀ := by exact_mod_cast h_nat
        linarith only [hM₀_gt, h_cast]
      rw [inv_eq_one_div, div_le_iff₀ h2M₀_pos]
      have h2 := (div_lt_iff₀ hδ_sc).mp h1
      linarith only [h2]
    let ε_hom : ℝ := δ_sc / 4
    have hε_hom_pos : 0 < ε_hom := by positivity
    let d_mesh : ℕ → ℝ := fun k => (k : ℝ) / (2 : ℝ) ^ M₀
    have hd_mesh_mem : ∀ k ∈ Finset.range (2 ^ M₀ + 1), d_mesh k ∈ Set.Icc (0 : ℝ) 1 := by
      intro k hk
      have hk_le : k ≤ 2 ^ M₀ := Nat.lt_succ_iff.mp (Finset.mem_range.mp hk)
      have hk_real : (k : ℝ) ≤ (2 : ℝ) ^ M₀ := by exact_mod_cast hk_le
      exact ⟨div_nonneg (Nat.cast_nonneg k) h2M₀_pos.le, (div_le_one h2M₀_pos).mpr hk_real⟩
    let N_k_fn : ℕ → ℕ := fun k =>
      if hk : k ∈ Finset.range (2 ^ M₀ + 1) then
        Classical.choose (prof.h_sc_homog (d_mesh k) (hd_mesh_mem k hk) ε_hom hε_hom_pos)
      else 0
    have hN_mesh_ex : ∃ N_mesh : ℕ, ∀ k ∈ Finset.range (2 ^ M₀ + 1), N_k_fn k ≤ N_mesh :=
      ⟨(Finset.range (2 ^ M₀ + 1)).sup N_k_fn, fun _ hk => Finset.le_sup hk⟩
    obtain ⟨N_mesh, hN_mesh_ub⟩ := hN_mesh_ex
    have h_ρ_sub : Filter.Tendsto (fun n => blk.ρ_seq (prof.φ n)) Filter.atTop (nhds 0) :=
      blk.hρ_tendsto.comp prof.hφ_mono.tendsto_atTop
    have h_κ_sub : Filter.Tendsto (fun n => blk.κ_seq (prof.φ n)) Filter.atTop (nhds 0) :=
      blk.hκ_tendsto.comp prof.hφ_mono.tendsto_atTop
    have h_ev_rpow : ∀ (p c : ℝ), 0 < p → 0 < c →
        ∀ᶠ n in Filter.atTop, (blk.ρ_seq (prof.φ n)) ^ p < c := by
      intro p c hp hc
      have ht := h_ρ_sub.rpow_const (p := p) (Or.inr hp.le)
      rw [Real.zero_rpow hp.ne'] at ht
      exact ht.eventually (gt_mem_nhds hc)
    have h_ev_sep1 : ∀ᶠ n in Filter.atTop,
        prof.ω_seq n + 2 * blk.κ_seq (prof.φ n) < s * ϑ / 2 := by
      have ht := prof.hω_tendsto.add (h_κ_sub.const_mul 2)
      have h0 : (0 : ℝ) + 2 * 0 = 0 := by ring
      rw [h0] at ht
      exact ht.eventually (gt_mem_nhds (by positivity))
    have h_ev_sep2 := h_ev_rpow (s * ϑ / 2) (1 / 8) (by positivity) (by norm_num)
    have h_ev_ω : ∀ᶠ n in Filter.atTop, prof.ω_seq n < δ_sc / 4 :=
