      have h_s_deriv : deriv (fun y' => deriv (fun τ'' => E_fn (y', τ'')) τ) y =
          fderiv ℝ (fderiv ℝ E_fn) (y, τ) (1, 0) (0, 1) := by
        have h_s_eq : (fun y' => deriv (fun τ'' => E_fn (y', τ'')) τ) =
