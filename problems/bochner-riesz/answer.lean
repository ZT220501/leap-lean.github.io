          ≤ lam_loc * s * (‖δ‖ * ‖T‖) :=
            mul_le_mul_of_nonneg_left h_inner_le (by positivity)
        _ = (lam_loc * s * ‖δ‖) * ‖T‖ := (mul_assoc _ _ _).symm
        _ ≤ (L * (4 * B_cell ^ 2 / a₀)) * ‖T‖ :=
            mul_le_mul_of_nonneg_right h_coeff (norm_nonneg T)
    have hH_bound : ∀ (m : ℕ) (τ y : ℝ),
        |iteratedDeriv m (fun y' => H (y', τ)) y| ≤ L * D_phase m := by
      intro m τ y
      let q₀ : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) :=
        (v_seg τ, x₀ - c_end • v_seg τ)
      have hH_eq : (fun y' => H (y', τ)) = ⇑ℓ_δ ∘ ((fun z => M (z + q₀)) ∘ ⇑Λ) := by
        ext y'
        have h_arg : (v_seg τ, p_seg (y', τ)) = Λ y' + q₀ := by
          refine Prod.ext ?_ ?_
          · simp [Λ, ξ, q₀]
          · ext i
            dsimp only [p_seg, x_line, Λ, ξ, q₀]
            simp only [ContinuousLinearMap.smulRight_apply, one_apply_eq_self,
              Prod.smul_snd, Prod.snd_add, PiLp.add_apply, PiLp.sub_apply,
              PiLp.smul_apply, smul_eq_mul]
            ring
        dsimp only [H, Function.comp_apply, ℓ_δ]
        simp only [smul_apply, ContinuousLinearMap.comp_apply,
          ContinuousLinearMap.apply_apply, InnerProductSpace.toDual_apply_apply, smul_eq_mul]
        rw [real_inner_comm, h_arg]
      rw [← Real.norm_eq_abs, ← norm_iteratedFDeriv_eq_norm_iteratedDeriv, hH_eq]
      have h_shift_cd : ContDiff ℝ m (fun z => M (z + q₀)) :=
        (hM_cd m).comp (contDiff_id.add contDiff_const)
      have h_inner_cd : ContDiff ℝ m ((fun z => M (z + q₀)) ∘ ⇑Λ) :=
        h_shift_cd.comp Λ.contDiff
      rw [ℓ_δ.iteratedFDeriv_comp_left h_inner_cd.contDiffAt le_rfl]
      have h_le1 := ℓ_δ.norm_compContinuousMultilinearMap_le
