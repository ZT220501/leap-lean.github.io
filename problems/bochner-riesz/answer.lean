            ell * (π ω * (-(Real.log (finProbAt2 π T_idx Z ω / finProbAt π T_idx ω)) / ell))) = _
          rw [if_pos hpos, h_prob_unit ω, div_one, div_one,
            h_prob2_unit Y ω, h_prob2_unit Z ω,
            h_prob2_eq T_idx Y ω, h_prob2_eq T_idx Z ω]
          rw [Real.log_div hpTY_pos.ne' hpT_pos.ne',
            Real.log_div hpTZ_pos.ne' hpT_pos.ne',
            ← hpTY_eq, ← hpZ_eq, ← hpTZ_eq, ← hpY_eq,
            Real.log_div (mul_pos hpTY_pos hpZ_pos).ne' (mul_pos hpTZ_pos hpY_pos).ne',
            Real.log_mul hpTY_pos.ne' hpZ_pos.ne',
            Real.log_mul hpTZ_pos.ne' hpY_pos.ne']
          field_simp [hell_ne]
          ring
      have h_prod_le : ell * (finMutualInfo ε π T_idx Y - finMutualInfo ε π T_idx Z) ≤ 0 := by
        rwa [h_diff]
      have h_sub_le : finMutualInfo ε π T_idx Y - finMutualInfo ε π T_idx Z ≤ 0 :=
        nonpos_of_mul_nonpos_right h_prod_le hell_pos
      linarith
    have h_mi_ZG : finMutualInfo ε π T_idx Z ≤
        finMutualInfo ε π T_idx G_glob + Real.log (K_amb : ℝ) / ell := by
      have hK_pos : 0 < (K_amb : ℝ) := by exact_mod_cast hK_amb
      have h_cond_le : finCondEntropy ε π T_idx G_glob ≤ finCondEntropy ε π T_idx Z := by
        dsimp only [finCondEntropy]
        refine Finset.sum_le_sum (fun ω _ => ?_)
        rcases eq_or_lt_of_le (hπ_nn ω) with h0 | hpos
        · rw [← h0]; simp
        · refine mul_le_mul_of_nonneg_left ?_ hpos.le
          have hpT_pos := h_prob_pos T_idx ω hpos
          have hpTZ_pos : 0 < finProbAt2 π T_idx Z ω := by
