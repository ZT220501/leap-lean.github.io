  have h_1d_int : ∀ {α_P : Type} [DecidableEq α_P] (S_P E_v : Finset α_P)
      (c_pt x_pt : α_P → ℝ) (v_bar ρ R₀ m_ch : ℝ),
      0 < ρ → 0 ≤ R₀ → 0 < m_ch → E_v ⊆ S_P →
