      have h_id : (3 / 2 : ℝ) * σ * (r_idx : ℝ) * τ = (3 / 2 : ℝ) * σ * d_j * h' := by
        rw [mul_assoc ((3 / 2 : ℝ) * σ), h_r_tau_eq]; ring
      linarith
    linarith

  
  let goodBase : Fin (sys.N_ω k) → Prop := fun ω =>
    (1 / 2 : ℝ) * m'_w0 * finProbAt P₀ E_obs ω ≤
      ∑ ω' ∈ E₂ w₀, if E_obs ω' = E_obs ω then P₀ ω' else 0
  let _ : DecidablePred goodBase := Classical.decPred _
  let _ : ∀ ω : Fin (sys.N_ω k), Decidable ¬goodBase ω := fun _ => Classical.propDecidable _
  let E_norm : Finset (Fin (sys.N_ω k)) := (E₂ w₀).filter goodBase
  let E_bad : Finset (Fin (sys.N_ω k)) := (E₂ w₀).filter (fun ω => ¬goodBase ω)

  have hE_bad_mass : (∑ ω ∈ E_bad, P₀ ω) ≤ (1 / 2 : ℝ) * m'_w0 := by
    have h_maps : ∀ ω ∈ E_bad, E_obs ω ∈ E_bad.image E_obs :=
      fun ω hω => Finset.mem_image_of_mem E_obs hω
    rw [← Finset.sum_fiberwise_of_maps_to h_maps]
    have h_fib_le : ∀ e ∈ E_bad.image E_obs,
        (∑ ω ∈ E_bad.filter (fun ω => E_obs ω = e), P₀ ω) ≤
          (1 / 2 : ℝ) * m'_w0 * (∑ ω' : Fin (sys.N_ω k), if E_obs ω' = e then P₀ ω' else 0) := by
      intro e he
      obtain ⟨ω_e, hω_e, rfl⟩ := Finset.mem_image.mp he
      obtain ⟨_, h_not_good⟩ := Finset.mem_filter.mp hω_e
      have h_lt : (∑ ω' ∈ E₂ w₀, if E_obs ω' = E_obs ω_e then P₀ ω' else 0) <
          (1 / 2 : ℝ) * m'_w0 * finProbAt P₀ E_obs ω_e := lt_of_not_ge h_not_good
      have h_sub_sum : (∑ ω ∈ E_bad.filter (fun ω => E_obs ω = E_obs ω_e), P₀ ω) ≤
          ∑ ω' ∈ E₂ w₀, if E_obs ω' = E_obs ω_e then P₀ ω' else 0 := by
        rw [← Finset.sum_filter]
        refine Finset.sum_le_sum_of_subset_of_nonneg (fun ω hω => ?_) (fun ω _ _ => hP₀_nn ω)
        obtain ⟨hω_bad, h_eq⟩ := Finset.mem_filter.mp hω
        exact Finset.mem_filter.mpr ⟨(Finset.mem_filter.mp hω_bad).1, h_eq⟩
      have hp_eq : finProbAt P₀ E_obs ω_e =
          ∑ ω' : Fin (sys.N_ω k), if E_obs ω' = E_obs ω_e then P₀ ω' else 0 :=
        Finset.sum_congr rfl fun _ _ => h_ite_c _ _ _
      rw [← hp_eq]
      exact le_trans h_sub_sum h_lt.le
    calc ∑ e ∈ E_bad.image E_obs, ∑ ω ∈ E_bad.filter (fun ω => E_obs ω = e), P₀ ω
        ≤ ∑ e ∈ E_bad.image E_obs,
            (1 / 2 : ℝ) * m'_w0 *
              (∑ ω' : Fin (sys.N_ω k), if E_obs ω' = e then P₀ ω' else 0) :=
          Finset.sum_le_sum h_fib_le
      _ = (1 / 2 : ℝ) * m'_w0 *
            (∑ e ∈ E_bad.image E_obs,
              ∑ ω' : Fin (sys.N_ω k), if E_obs ω' = e then P₀ ω' else 0) :=
          (Finset.mul_sum _ _ _).symm
      _ ≤ (1 / 2 : ℝ) * m'_w0 * (∑ ω' : Fin (sys.N_ω k), P₀ ω') := by
          refine mul_le_mul_of_nonneg_left ?_ (by positivity)
          rw [Finset.sum_comm]
          refine Finset.sum_le_sum fun ω' _ => ?_
          by_cases hx : E_obs ω' ∈ E_bad.image E_obs
          · rw [Finset.sum_eq_single (E_obs ω')
              (fun e _ hne => ite_eq_right_iff.mpr fun h => absurd h.symm hne)
              (fun habs => absurd hx habs), ite_eq_left_iff.mpr fun h => absurd rfl h]
          · rw [Finset.sum_eq_zero (fun e hmem => ite_eq_right_iff.mpr fun (heq : E_obs ω' = e) =>
              False.elim (hx (heq ▸ hmem)))]
            exact hP₀_nn ω'
      _ = (1 / 2 : ℝ) * m'_w0 := by rw [hP₀_sum, mul_one]

  have hE_norm_P₀ : (1 / 2 : ℝ) * m'_w0 ≤ ∑ ω ∈ E_norm, P₀ ω := by
    have h_split := Finset.sum_filter_add_sum_filter_not (E₂ w₀) goodBase P₀
    change (∑ ω ∈ E_norm, P₀ ω) + (∑ ω ∈ E_bad, P₀ ω) = m'_w0 at h_split
    linarith

  have hE_norm_sub_E₁ : ∀ ω ∈ E_norm, ω ∈ E₁ k z₀ := by
    intro ω hω
    have hω_E₂ : ω ∈ E₂ w₀ := (Finset.mem_filter.mp hω).1
    exact (hP₀_supp ω).mp (hE₂_pos w₀ ω hω_E₂)

  have hE_norm_mass : c_ret ≤ ∑ ω ∈ E_norm, sys.π_seq k ω := by
    have h_eq : (∑ ω ∈ E_norm, sys.π_seq k ω) = m_cell k z₀ * (∑ ω ∈ E_norm, P₀ ω) := by
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl fun ω hω => hπ_eq_P₀ ω (hE_norm_sub_E₁ ω hω)
    rw [h_eq]
    have h1 : (1 / (4 * (J₂ : ℝ))) ≤ ∑ ω ∈ E_norm, P₀ ω := by
      calc (1 / (4 * (J₂ : ℝ))) = (1 / 2 : ℝ) * (1 / (2 * (J₂ : ℝ))) := by ring
        _ ≤ (1 / 2 : ℝ) * m'_w0 := mul_le_mul_of_nonneg_left hm'_w0_lb (by norm_num)
        _ ≤ ∑ ω ∈ E_norm, P₀ ω := hE_norm_P₀
    calc c_ret = c₁ * (1 / (4 * (J₂ : ℝ))) := by dsimp [c_ret]; ring
      _ ≤ m_cell k z₀ * (∑ ω ∈ E_norm, P₀ ω) :=
          mul_le_mul hm_z0_lb h1 (by positivity) hm_z0_pos.le

  refine ⟨E_norm, hE_norm_mass, fun r_idx hr1 hrM ω hω_norm _ => ?_⟩
  dsimp only
  let d : ℝ := (r_idx : ℝ) / (M : ℝ)
  let R_d : Fin (sys.N_ω k) → ℤ := fun ω' => dyadicRealBin ε (m * u' + d * h') (sys.R_seq k ω')
  let j : Fin M := ⟨r_idx - 1, by omega⟩
  have hj_succ : j.1 + 1 = r_idx := by dsimp [j]; omega
  have hR_d_eq : R_stg2 j = R_d := by
    ext ω'; dsimp [R_stg2, R_d, d]; rw [hj_succ]

  obtain ⟨hω_E₂, hω_good⟩ := Finset.mem_filter.mp hω_norm
  have hP₀_ω : 0 < P₀ ω := hE₂_pos w₀ ω hω_E₂

  
  have h_p2_ub : finProbAt2 P₀ E_obs R_d ω ≤ ε ^ (w₂ w₀ j) * finProbAt P₀ E_obs ω := by
    have hw_ω := (hw₂_cell w₀ j ω hω_E₂).1
    rw [hR_d_eq] at hw_ω
    have hp1_pos : 0 < finProbAt P₀ E_obs ω := by
      unfold finProbAt
      let _ := Classical.propDecidable
      have h_m : P₀ ω = (if E_obs ω = E_obs ω then P₀ ω else 0) := by simp
      refine lt_of_lt_of_le hP₀_ω ?_
      rw [h_m]
      exact Finset.single_le_sum (f := fun ω' => if E_obs ω' = E_obs ω then P₀ ω' else 0)
        (fun ω' _ => by split_ifs <;> [exact hP₀_nn ω'; exact le_rfl])
        (Finset.mem_univ ω)
    have hp2_pos : 0 < finProbAt2 P₀ E_obs R_d ω := by
      unfold finProbAt2
      let _ := Classical.propDecidable
      have h_m : P₀ ω = (if E_obs ω = E_obs ω ∧ R_d ω = R_d ω then P₀ ω else 0) := by simp
      refine lt_of_lt_of_le hP₀_ω ?_
      rw [h_m]
      exact Finset.single_le_sum
        (f := fun ω' => if E_obs ω' = E_obs ω ∧ R_d ω' = R_d ω then P₀ ω' else 0)
        (fun ω' _ => by split_ifs <;> [exact hP₀_nn ω'; exact le_rfl])
        (Finset.mem_univ ω)
    set p_c := finProbAt2 P₀ E_obs R_d ω / finProbAt P₀ E_obs ω
    have hpc_pos : 0 < p_c := div_pos hp2_pos hp1_pos
    have h_log_le : Real.log p_c ≤ Real.log ε * w₂ w₀ j := by
      change w₂ w₀ j ≤ -(Real.log p_c) / ell at hw_ω
      have h_mul := (le_div_iff₀ hell_pos).mp hw_ω
      have h_ell_eq : ell = -Real.log ε := by rw [hell_def, Real.log_inv]
      rw [h_ell_eq] at h_mul
      linarith
    have hpc_le : p_c ≤ ε ^ (w₂ w₀ j) := by
      calc p_c = Real.exp (Real.log p_c) := (Real.exp_log hpc_pos).symm
        _ ≤ Real.exp (Real.log ε * w₂ w₀ j) := Real.exp_le_exp.mpr h_log_le
        _ = ε ^ (w₂ w₀ j) := (Real.rpow_def_of_pos hε0 _).symm
    exact (div_le_iff₀ hp1_pos).mp hpc_le

  
  have h_num_le : (∑ ω' ∈ E_norm,
      @ite ℝ (E_obs ω' = E_obs ω ∧ R_d ω' = R_d ω) (Classical.propDecidable _)
        (sys.π_seq k ω') 0) ≤
      ε ^ (w₂ w₀ j) * (m_cell k z₀ * finProbAt P₀ E_obs ω) := by
    have h_le1 : (∑ ω' ∈ E_norm,
        @ite ℝ (E_obs ω' = E_obs ω ∧ R_d ω' = R_d ω) (Classical.propDecidable _)
          (sys.π_seq k ω') 0) =
        m_cell k z₀ * (∑ ω' ∈ E_norm,
          @ite ℝ (E_obs ω' = E_obs ω ∧ R_d ω' = R_d ω) (Classical.propDecidable _)
            (P₀ ω') 0) := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun ω' hω' => ?_
      let _ := Classical.propDecidable
      split_ifs
      · exact hπ_eq_P₀ ω' (hE_norm_sub_E₁ ω' hω')
      · ring
    have h_le2 : (∑ ω' ∈ E_norm,
        @ite ℝ (E_obs ω' = E_obs ω ∧ R_d ω' = R_d ω) (Classical.propDecidable _) (P₀ ω') 0) ≤
        finProbAt2 P₀ E_obs R_d ω := by
      unfold finProbAt2
      let _ := Classical.propDecidable
      exact Finset.sum_le_univ_sum_of_nonneg fun ω' => by
        split_ifs <;> [exact hP₀_nn ω'; exact le_rfl]
    calc (∑ ω' ∈ E_norm,
          @ite ℝ (E_obs ω' = E_obs ω ∧ R_d ω' = R_d ω) (Classical.propDecidable _)
            (sys.π_seq k ω') 0)
        ≤ m_cell k z₀ * finProbAt2 P₀ E_obs R_d ω := by
          rw [h_le1]; exact mul_le_mul_of_nonneg_left h_le2 hm_z0_pos.le
      _ ≤ m_cell k z₀ * (ε ^ (w₂ w₀ j) * finProbAt P₀ E_obs ω) :=
          mul_le_mul_of_nonneg_left h_p2_ub hm_z0_pos.le
      _ = ε ^ (w₂ w₀ j) * (m_cell k z₀ * finProbAt P₀ E_obs ω) := by ring

  
  have h_den_lb : m_cell k z₀ * finProbAt P₀ E_obs ω ≤
      4 * (J₂ : ℝ) * (∑ ω' ∈ E_norm,
        @ite ℝ (E_obs ω' = E_obs ω) (Classical.propDecidable _) (sys.π_seq k ω') 0) := by
    have h_fib_inv : ∀ ω' ∈ E₂ w₀, E_obs ω' = E_obs ω → ω' ∈ E_norm := by
      intro ω' hω'_E₂ h_eq
      refine Finset.mem_filter.mpr ⟨hω'_E₂, ?_⟩
      dsimp [goodBase] at hω_good ⊢
      have hp_eq : finProbAt P₀ E_obs ω' = finProbAt P₀ E_obs ω := by
        unfold finProbAt
        refine Finset.sum_congr rfl fun ω'' _ => ?_
        rw [h_eq]
      have hs_eq : (∑ ω'' ∈ E₂ w₀, if E_obs ω'' = E_obs ω' then P₀ ω'' else 0) =
          ∑ ω'' ∈ E₂ w₀, if E_obs ω'' = E_obs ω then P₀ ω'' else 0 := by
        refine Finset.sum_congr rfl fun ω'' _ => ?_
        rw [h_eq]
      rw [hp_eq, hs_eq]
      exact hω_good
    have h_den_eq : (∑ ω' ∈ E_norm,
        @ite ℝ (E_obs ω' = E_obs ω) (Classical.propDecidable _) (sys.π_seq k ω') 0) =
        m_cell k z₀ * (∑ ω' ∈ E₂ w₀, if E_obs ω' = E_obs ω then P₀ ω' else 0) := by
      have h_stepA : (∑ ω' ∈ E_norm,
          @ite ℝ (E_obs ω' = E_obs ω) (Classical.propDecidable _) (sys.π_seq k ω') 0) =
          m_cell k z₀ * (∑ ω' ∈ E_norm, if E_obs ω' = E_obs ω then P₀ ω' else 0) := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun ω' hω' => ?_
        rw [@h_ite_c (E_obs ω' = E_obs ω) (Classical.propDecidable _) inferInstance
          (sys.π_seq k ω') 0]
        split_ifs
        · exact hπ_eq_P₀ ω' (hE_norm_sub_E₁ ω' hω')
        · ring
      have h_stepB : (∑ ω' ∈ E_norm, if E_obs ω' = E_obs ω then P₀ ω' else 0) =
          ∑ ω' ∈ E₂ w₀, if E_obs ω' = E_obs ω then P₀ ω' else 0 := by
        dsimp [E_norm]
        rw [Finset.sum_filter]
        refine Finset.sum_congr rfl fun ω' hω'_E₂ => ?_
        by_cases h_eq : E_obs ω' = E_obs ω
        · have hg : goodBase ω' := (Finset.mem_filter.mp (h_fib_inv ω' hω'_E₂ h_eq)).2
          rw [ite_eq_left_iff.mpr fun h_no => absurd hg h_no]
        · rw [ite_eq_right_iff.mpr fun _ => ite_eq_right_iff.mpr fun h_yes => absurd h_yes h_eq,
            ite_eq_right_iff.mpr fun h_yes => absurd h_yes h_eq]
      rw [h_stepA, h_stepB]
    rw [h_den_eq]
    have h_good_mul := mul_le_mul_of_nonneg_left hω_good hm_z0_pos.le
    have h_p0_nn : 0 ≤ finProbAt P₀ E_obs ω := by
      unfold finProbAt
      let _ := Classical.propDecidable
      exact Finset.sum_nonneg fun ω' _ => by split_ifs <;> [exact hP₀_nn ω'; exact le_rfl]
    have h_4J2_m : 1 ≤ 4 * (J₂ : ℝ) * ((1 / 2 : ℝ) * m'_w0) := by
      have h_mul := mul_le_mul_of_nonneg_left hm'_w0_lb (by positivity : 0 ≤ 2 * (J₂ : ℝ))
      rw [mul_one_div_cancel (by positivity : (2 * (J₂ : ℝ)) ≠ 0)] at h_mul
      linarith
    calc m_cell k z₀ * finProbAt P₀ E_obs ω
        ≤ (4 * (J₂ : ℝ) * ((1 / 2 : ℝ) * m'_w0)) * (m_cell k z₀ * finProbAt P₀ E_obs ω) :=
          le_mul_of_one_le_left (mul_nonneg hm_z0_pos.le h_p0_nn) h_4J2_m
      _ = 4 * (J₂ : ℝ) * (m_cell k z₀ * ((1 / 2 : ℝ) * m'_w0 * finProbAt P₀ E_obs ω)) := by ring
      _ ≤ 4 * (J₂ : ℝ) * (m_cell k z₀ *
            (∑ ω' ∈ E₂ w₀, if E_obs ω' = E_obs ω then P₀ ω' else 0)) :=
          mul_le_mul_of_nonneg_left h_good_mul (by positivity)

  
  have h_4J2_rpow : 4 * (J₂ : ℝ) * ε ^ (w₂ w₀ j) ≤
      ε ^ (((5 / 4 : ℝ) * σ * d - η_err) * h') := by
    have h_4J2_eq : 4 * (J₂ : ℝ) = ε ^ (-(Real.log (4 * (J₂ : ℝ)) / ell)) := by
      rw [Real.rpow_def_of_pos hε0]
      have h_ell_eq : ell = -Real.log ε := by rw [hell_def, Real.log_inv]
      have h_exp_arg : Real.log ε * -(Real.log (4 * (J₂ : ℝ)) / ell) =
          Real.log (4 * (J₂ : ℝ)) := by
        rw [h_ell_eq]
        have hlog_ne : Real.log ε ≠ 0 := by
          intro h0; rw [h0] at h_ell_eq; linarith
        field_simp [hlog_ne]
      rw [h_exp_arg, Real.exp_log (by positivity)]
    rw [h_4J2_eq, ← Real.rpow_add hε0]
    refine Real.rpow_le_rpow_of_exponent_ge hε0 (by linarith) ?_
    have hw_j := hw₂_lb j
    have h_dj_eq : (((j.1 + 1 : ℕ) : ℝ) / (M : ℝ)) = d := by dsimp [d]; rw [hj_succ]
    dsimp only at hw_j
    rw [h_dj_eq] at hw_j
    have hd_nn : 0 ≤ d := by dsimp [d]; positivity
    have h_slack : 0 ≤ (1 / 8 : ℝ) * σ * d * h' := by positivity
    have h_pen_split : (M : ℝ) * Real.log K_dom / ell + Real.log (4 * (J₂ : ℝ)) / ell =
        ((M : ℝ) * Real.log K_dom + Real.log (4 * (J₂ : ℝ))) / ell := (add_div _ _ _).symm
    linarith [hw_j, h_s2_pen_k, h_slack, h_pen_split]

  have h_den_nn : 0 ≤ ∑ ω' ∈ E_norm,
      @ite ℝ (E_obs ω' = E_obs ω) (Classical.propDecidable _) (sys.π_seq k ω') 0 := by
    let _ := Classical.propDecidable
    exact Finset.sum_nonneg fun ω' _ => by split_ifs <;> [exact hπ_nn ω'; exact le_rfl]

  calc (∑ ω' ∈ E_norm,
        @ite ℝ (E_obs ω' = E_obs ω ∧ R_d ω' = R_d ω) (Classical.propDecidable _)
          (sys.π_seq k ω') 0)
      ≤ ε ^ (w₂ w₀ j) * (m_cell k z₀ * finProbAt P₀ E_obs ω) := h_num_le
    _ ≤ ε ^ (w₂ w₀ j) * (4 * (J₂ : ℝ) * (∑ ω' ∈ E_norm,
          @ite ℝ (E_obs ω' = E_obs ω) (Classical.propDecidable _) (sys.π_seq k ω') 0)) :=
        mul_le_mul_of_nonneg_left h_den_lb (Real.rpow_nonneg hε0.le _)
    _ = (4 * (J₂ : ℝ) * ε ^ (w₂ w₀ j)) * (∑ ω' ∈ E_norm,
          @ite ℝ (E_obs ω' = E_obs ω) (Classical.propDecidable _) (sys.π_seq k ω') 0) := by ring
    _ ≤ ε ^ (((5 / 4 : ℝ) * σ * d - η_err) * h') * (∑ ω' ∈ E_norm,
          @ite ℝ (E_obs ω' = E_obs ω) (Classical.propDecidable _) (sys.π_seq k ω') 0) :=
        mul_le_mul_of_nonneg_right h_4J2_rpow h_den_nn

theorem bounded_fiber_surprise_and_restriction_transfer : (∀ {N_ω : ℕ} {α_T β₁ β₂ : Type}
      (ε : ℝ) (N₁₂ N₂₁ : ℕ) (Q : Fin N_ω → ℝ)
      (T : Fin N_ω → α_T) (Y₁ : Fin N_ω → β₁) (Y₂ : Fin N_ω → β₂)
      (F₁₂ : α_T → β₁ → Finset β₂) (F₂₁ : α_T → β₂ → Finset β₁),
      0 < ε → ε < 1 / 2 → 1 ≤ N₁₂ → 1 ≤ N₂₁ →
      (∀ ω, 0 ≤ Q ω) → (∑ ω : Fin N_ω, Q ω = 1) →
      (∀ ω, 0 < Q ω →
        Y₂ ω ∈ F₁₂ (T ω) (Y₁ ω) ∧ (F₁₂ (T ω) (Y₁ ω)).card ≤ N₁₂ ∧
        Y₁ ω ∈ F₂₁ (T ω) (Y₂ ω) ∧ (F₂₁ (T ω) (Y₂ ω)).card ≤ N₂₁) →
      |finCondEntropy ε Q T Y₂ - finCondEntropy ε Q T Y₁| ≤
        Real.log (max (N₁₂ : ℝ) (N₂₁ : ℝ)) / Real.log (ε⁻¹) ∧
      ∀ τ : ℝ, 0 < τ →
        letI := Classical.propDecidable
        let err := Real.log (max (N₁₂ : ℝ) (N₂₁ : ℝ)) / Real.log (ε⁻¹) + τ
        (∑ ω : Fin N_ω,
          if err < |condSurprise ε Q T Y₂ ω - condSurprise ε Q T Y₁ ω|
          then Q ω else 0) ≤ 2 * ε ^ τ) ∧
    (∀ {N_ω : ℕ} {α_X α_Y : Type}
      (ε A C_alph H α ζ : ℝ) (Q : Fin N_ω → ℝ)
      (X : Fin N_ω → α_X) (Y : Fin N_ω → α_Y)
      (F_supp : α_X → Finset α_Y) (G : Finset (Fin N_ω)),
      0 < ε → ε < 1 / 2 → 0 ≤ A → 1 ≤ C_alph → 0 ≤ H → 0 ≤ α → 0 ≤ ζ →
      (∀ ω, 0 ≤ Q ω) → (∑ ω : Fin N_ω, Q ω = 1) →
      (∀ ω, 0 < Q ω → Y ω ∈ F_supp (X ω) ∧ ((F_supp (X ω)).card : ℝ) ≤ C_alph * ε ^ (-A)) →
      1 - ζ ≤ (∑ ω ∈ G, Q ω) →
      (∀ ω ∈ G, 0 < Q ω → |condSurprise ε Q X Y ω - H| ≤ α) →
      |finCondEntropy ε Q X Y - H| ≤
        α + ζ * (H + 2 * A + 2) + 2 * C_alph * ε / Real.log (ε⁻¹)) ∧
    (∀ {N_ω : ℕ} {α_X α_Y : Type}
      (ε c_ret : ℝ) (π : Fin N_ω → ℝ) (E_sub : Finset (Fin N_ω))
      (X : Fin N_ω → α_X) (Y : Fin N_ω → α_Y),
      0 < ε → ε < 1 / 2 → 0 < c_ret →
      (∀ ω, 0 ≤ π ω) → (∑ ω : Fin N_ω, π ω = 1) →
      c_ret ≤ (∑ ω ∈ E_sub, π ω) →
      let Q := restrictLaw π E_sub
      (0 ≤ finCondEntropy ε Q X Y ∧ finCondEntropy ε Q X Y ≤ c_ret⁻¹ * finCondEntropy ε π X Y) ∧
      ∀ (H α ζ η : ℝ) (E_conc : Finset (Fin N_ω)),
        0 ≤ α → 0 ≤ ζ → 0 < η → η < 1 →
        1 - ζ ≤ (∑ ω ∈ E_conc, π ω) →
        (∀ ω ∈ E_conc, 0 < π ω → |condSurprise ε π X Y ω - H| ≤ α) →
        letI := Classical.propDecidable
        let err := α + Real.log ((min c_ret 1 * η)⁻¹) / Real.log (ε⁻¹)
        (∑ ω : Fin N_ω, if err < |condSurprise ε Q X Y ω - H| then Q ω else 0) ≤
          ζ / c_ret + 2 * η) ∧
    (∀ {N_ω : ℕ} {α_T α_E γ₁ γ₂ : Type}
      (B : ℝ) (Q : Fin N_ω → ℝ) (G : Finset (Fin N_ω))
      (T : Fin N_ω → α_T) (E : Fin N_ω → α_E)
      (Y₁ : Fin N_ω → γ₁) (Y₂ : Fin N_ω → γ₂),
      letI := Classical.propDecidable
      0 ≤ B → (∀ ω, 0 ≤ Q ω) → (∑ ω : Fin N_ω, Q ω = 1) →
      (∀ ω ∈ G, 0 < Q ω →
        finProbAt2 Q (fun ω' => (T ω', E ω', Y₁ ω')) Y₂ ω ≤
          B * finProbAt Q (fun ω' => (T ω', E ω', Y₁ ω')) ω) →
      (∑ ω : Fin N_ω,
        if 2 * B * finProbAt Q (fun ω' => (E ω', Y₁ ω')) ω <
            finProbAt2 Q (fun ω' => (E ω', Y₁ ω')) Y₂ ω
        then Q ω else 0) ≤ 2 * (1 - ∑ ω ∈ G, Q ω)) :=
by
  classical
  have h_ell_pos : ∀ (ε : ℝ), 0 < ε → ε < 1 / 2 → 0 < Real.log (ε⁻¹) := by
    intro ε hε₀ hε₁
    exact Real.log_pos ((one_lt_inv₀ hε₀).mpr (by linarith))

  have h_log_rpow : ∀ (ε t : ℝ), 0 < ε → Real.log (ε ^ t) = -(t * Real.log (ε⁻¹)) := by
    intro ε t hε₀
    rw [Real.log_rpow hε₀ t, Real.log_inv]
    ring

  have h_le_of_log_le : ∀ {a b : ℝ}, 0 < a → 0 < b → Real.log a ≤ Real.log b → a ≤ b := by
    intro a b ha hb hlog
    by_contra h_not
    linarith [Real.log_lt_log hb (lt_of_not_ge h_not)]

  have h_lt_of_log_lt : ∀ {a b : ℝ}, 0 < a → 0 < b → Real.log a < Real.log b → a < b := by
    intro a b ha hb hlog
    by_contra h_not
    linarith [Real.log_le_log hb (le_of_not_gt h_not)]

  let Spos : ∀ {N_ω : ℕ}, (Fin N_ω → ℝ) → Finset (Fin N_ω) :=
    fun Q => Finset.univ.filter (fun ω => 0 < Q ω)

  have h_zero_of_not_mem : ∀ {N_ω : ℕ} (Q : Fin N_ω → ℝ),
      (∀ ω, 0 ≤ Q ω) → ∀ ω, ω ∉ Spos Q → Q ω = 0 := by
    intro N_ω Q hQ_nn ω hω
    have hnot : ¬ 0 < Q ω := fun hpos => hω (Finset.mem_filter.mpr ⟨Finset.mem_univ ω, hpos⟩)
    exact le_antisymm (not_lt.mp hnot) (hQ_nn ω)

  have h_ite_Spos : ∀ {N_ω : ℕ} (Q : Fin N_ω → ℝ) (P : Fin N_ω → Prop)
      {inst₁ inst₂ : DecidablePred P},
      (∀ ω, 0 ≤ Q ω) →
      (∑ ω : Fin N_ω, @ite ℝ (P ω) (inst₁ ω) (Q ω) 0) =
        ∑ ω ∈ @Finset.filter (Fin N_ω) P inst₂ (Spos Q), Q ω := by
    intro N_ω Q P inst₁ inst₂ hQ_nn
    rw [Finset.sum_filter]
    have h_sub : (∑ ω : Fin N_ω, @ite ℝ (P ω) (inst₁ ω) (Q ω) 0) =
        ∑ ω ∈ Spos Q, @ite ℝ (P ω) (inst₁ ω) (Q ω) 0 := by
      refine (Finset.sum_subset (Finset.subset_univ (Spos Q)) ?_).symm
      intro ω _ hnot
      have h0 : Q ω = 0 := h_zero_of_not_mem Q hQ_nn ω hnot
      by_cases hP : P ω <;> simp [hP, h0]
    rw [h_sub]
    refine Finset.sum_congr rfl (fun ω _ => ?_)
    by_cases hP : P ω <;> simp [hP]

  have h_prob1_eq : ∀ {N_ω : ℕ} {α : Type} (Q : Fin N_ω → ℝ) (Z : Fin N_ω → α) (ω : Fin N_ω)
      [DecidablePred (fun ω' => Z ω' = Z ω)],
      (∀ ω', 0 ≤ Q ω') →
      finProbAt Q Z ω = ∑ ω' ∈ (Spos Q).filter (fun ω' => Z ω' = Z ω), Q ω' := by
    intro N_ω α Q Z ω _ hQ_nn
    unfold finProbAt
    exact h_ite_Spos Q (fun ω' => Z ω' = Z ω) hQ_nn

  have h_prob2_eq : ∀ {N_ω : ℕ} {α β : Type} (Q : Fin N_ω → ℝ)
      (Z : Fin N_ω → α) (Y : Fin N_ω → β) (ω : Fin N_ω)
      [DecidablePred (fun ω' => Z ω' = Z ω ∧ Y ω' = Y ω)],
      (∀ ω', 0 ≤ Q ω') →
      finProbAt2 Q Z Y ω =
        ∑ ω' ∈ (Spos Q).filter (fun ω' => Z ω' = Z ω ∧ Y ω' = Y ω), Q ω' := by
    intro N_ω α β Q Z Y ω _ hQ_nn
    unfold finProbAt2
    exact h_ite_Spos Q (fun ω' => Z ω' = Z ω ∧ Y ω' = Y ω) hQ_nn

  have h_sum_Spos_mul : ∀ {N_ω : ℕ} (Q f : Fin N_ω → ℝ),
      (∀ ω, 0 ≤ Q ω) →
      (∑ ω : Fin N_ω, Q ω * f ω) = ∑ ω ∈ Spos Q, Q ω * f ω := by
    intro N_ω Q f hQ_nn
    refine (Finset.sum_subset (Finset.subset_univ (Spos Q)) ?_).symm
    intro ω _ hnot
    rw [h_zero_of_not_mem Q hQ_nn ω hnot, zero_mul]

  have h_sum_Spos : ∀ {N_ω : ℕ} (Q : Fin N_ω → ℝ),
      (∀ ω, 0 ≤ Q ω) → (∑ ω ∈ Spos Q, Q ω) = ∑ ω : Fin N_ω, Q ω := by
    intro N_ω Q hQ_nn
    refine Finset.sum_subset (Finset.subset_univ (Spos Q)) ?_
    intro ω _ hnot
    exact h_zero_of_not_mem Q hQ_nn ω hnot

  have h_sum_event_Spos : ∀ {N_ω : ℕ} (Q : Fin N_ω → ℝ) (G : Finset (Fin N_ω)),
      (∀ ω, 0 ≤ Q ω) →
      (∑ ω ∈ (Spos Q).filter (fun ω => ω ∈ G), Q ω) = ∑ ω ∈ G, Q ω := by
    intro N_ω Q G hQ_nn
    refine Finset.sum_subset (fun ω hω => (Finset.mem_filter.mp hω).2) ?_
    intro ω hωG hnot
    have hnot_pos : ω ∉ Spos Q := fun hpos => hnot (Finset.mem_filter.mpr ⟨hpos, hωG⟩)
    exact h_zero_of_not_mem Q hQ_nn ω hnot_pos

  have h_sum_compl_Spos : ∀ {N_ω : ℕ} (Q : Fin N_ω → ℝ) (G : Finset (Fin N_ω)),
      (∀ ω, 0 ≤ Q ω) → (∑ ω : Fin N_ω, Q ω = 1) →
      (∑ ω ∈ (Spos Q).filter (fun ω => ω ∉ G), Q ω) = 1 - ∑ ω ∈ G, Q ω := by
    intro N_ω Q G hQ_nn hQ_sum
    have h1 := Finset.sum_filter_add_sum_filter_not (Spos Q) (fun ω => ω ∈ G) Q
    rw [h_sum_event_Spos Q G hQ_nn, h_sum_Spos Q hQ_nn, hQ_sum] at h1
    linarith

  have h_filter_or_le : ∀ {N_ω : ℕ} (Q : Fin N_ω → ℝ) (S : Finset (Fin N_ω))
      (P P₁ P₂ : Fin N_ω → Prop),
      (∀ ω, 0 ≤ Q ω) → (∀ ω ∈ S, P ω → P₁ ω ∨ P₂ ω) →
      (∑ ω ∈ S.filter P, Q ω) ≤
        (∑ ω ∈ S.filter P₁, Q ω) + (∑ ω ∈ S.filter P₂, Q ω) := by
    intro N_ω Q S P P₁ P₂ hQ_nn himp
    rw [Finset.sum_filter, Finset.sum_filter, Finset.sum_filter, ← Finset.sum_add_distrib]
    refine Finset.sum_le_sum (fun ω hω => ?_)
    by_cases hP : P ω
    · rcases himp ω hω hP with h1 | h2
      · by_cases h2' : P₂ ω <;> simp [hP, h1, h2', hQ_nn ω]
      · by_cases h1' : P₁ ω <;> simp [hP, h1', h2, hQ_nn ω]
    · by_cases h1 : P₁ ω <;> by_cases h2 : P₂ ω <;> simp [hP, h1, h2, hQ_nn ω]

  have h_prob_bds : ∀ {N_ω : ℕ} {α β : Type} (ε : ℝ) (Q : Fin N_ω → ℝ)
      (Z : Fin N_ω → α) (Y : Fin N_ω → β) (ω : Fin N_ω),
      0 < ε → ε < 1 / 2 → (∀ ω', 0 ≤ Q ω') → ω ∈ Spos Q →
      Q ω ≤ finProbAt2 Q Z Y ω ∧
      0 < finProbAt2 Q Z Y ω ∧
      finProbAt2 Q Z Y ω ≤ finProbAt Q Z ω ∧
      0 < finProbAt Q Z ω ∧
      0 ≤ condSurprise ε Q Z Y ω := by
    intro N_ω α β ε Q Z Y ω hε₀ hε₁ hQ_nn hω
    have hQ_pos : 0 < Q ω := (Finset.mem_filter.mp hω).2
    have h_le2 : Q ω ≤ finProbAt2 Q Z Y ω := by
      rw [h_prob2_eq Q Z Y ω hQ_nn]
      exact Finset.single_le_sum (fun ω' _ => hQ_nn ω')
        (Finset.mem_filter.mpr ⟨hω, rfl, rfl⟩)
    have h_pos2 : 0 < finProbAt2 Q Z Y ω := lt_of_lt_of_le hQ_pos h_le2
    have h_2le1 : finProbAt2 Q Z Y ω ≤ finProbAt Q Z ω := by
      rw [h_prob2_eq Q Z Y ω hQ_nn, h_prob1_eq Q Z ω hQ_nn]
      refine Finset.sum_le_sum_of_subset_of_nonneg ?_ (fun ω' _ _ => hQ_nn ω')
      intro ω' hω'
      rcases Finset.mem_filter.mp hω' with ⟨hs, hZ, _⟩
      exact Finset.mem_filter.mpr ⟨hs, hZ⟩
    have h_pos1 : 0 < finProbAt Q Z ω := lt_of_lt_of_le h_pos2 h_2le1
    have h_rat_pos : 0 < finProbAt2 Q Z Y ω / finProbAt Q Z ω := div_pos h_pos2 h_pos1
    have h_rat_le1 : finProbAt2 Q Z Y ω / finProbAt Q Z ω ≤ 1 :=
      (div_le_one h_pos1).mpr h_2le1
    have h_log_np : Real.log (finProbAt2 Q Z Y ω / finProbAt Q Z ω) ≤ 0 :=
      Real.log_nonpos h_rat_pos.le h_rat_le1
    have h_surp_nn : 0 ≤ condSurprise ε Q Z Y ω := by
      unfold condSurprise
      exact div_nonneg (neg_nonneg.mpr h_log_np) (h_ell_pos ε hε₀ hε₁).le
    exact ⟨h_le2, h_pos2, h_2le1, h_pos1, h_surp_nn⟩

  have h_ent_nn : ∀ {N_ω : ℕ} {α β : Type} (ε : ℝ) (Q : Fin N_ω → ℝ)
      (Z : Fin N_ω → α) (Y : Fin N_ω → β),
      0 < ε → ε < 1 / 2 → (∀ ω, 0 ≤ Q ω) → 0 ≤ finCondEntropy ε Q Z Y := by
    intro N_ω α β ε Q Z Y hε₀ hε₁ hQ_nn
    unfold finCondEntropy
    rw [h_sum_Spos_mul Q _ hQ_nn]
    exact Finset.sum_nonneg (fun ω hω =>
      mul_nonneg (hQ_nn ω) (h_prob_bds ε Q Z Y ω hε₀ hε₁ hQ_nn hω).2.2.2.2)

  have h_dbl_fiber : ∀ {N_ω : ℕ} {α_Z β_Y : Type}
      (S S_sub : Finset (Fin N_ω)) (Z : Fin N_ω → α_Z) (Y : Fin N_ω → β_Y)
      (F : α_Z → Finset β_Y) (m_base : α_Z → ℝ) (g : Fin N_ω → ℝ) (M_cap c : ℝ),
      S_sub ⊆ S →
      0 ≤ c →
      (∀ z ∈ S.image Z, 0 ≤ m_base z) →
      (∀ ω ∈ S_sub, Y ω ∈ F (Z ω)) →
      (∀ z ∈ S.image Z, ((F z).card : ℝ) ≤ M_cap) →
      (∀ z ∈ S.image Z, ∀ y ∈ F z,
        (∑ ω ∈ S_sub.filter (fun ω => Z ω = z ∧ Y ω = y), g ω) ≤ c * m_base z) →
      (∑ ω ∈ S_sub, g ω) ≤ M_cap * c * (∑ z ∈ S.image Z, m_base z) := by
    intro N_ω α_Z β_Y S S_sub Z Y F m_base g M_cap c h_sub hc_nn hm_nn h_maps h_card h_cell
    have h_outer : (∑ ω ∈ S_sub, g ω) =
        ∑ z ∈ S.image Z, ∑ ω ∈ S_sub.filter (fun ω => Z ω = z), g ω :=
      (Finset.sum_fiberwise_of_maps_to
        (fun ω hω => Finset.mem_image_of_mem Z (h_sub hω)) g).symm
    rw [h_outer]
    calc ∑ z ∈ S.image Z, ∑ ω ∈ S_sub.filter (fun ω => Z ω = z), g ω
        ≤ ∑ z ∈ S.image Z, (M_cap * c) * m_base z := by
          refine Finset.sum_le_sum (fun z hz => ?_)
          have h_inner : (∑ ω ∈ S_sub.filter (fun ω => Z ω = z), g ω) =
              ∑ y ∈ F z, ∑ ω ∈ (S_sub.filter (fun ω => Z ω = z)).filter (fun ω => Y ω = y), g ω :=
            (Finset.sum_fiberwise_of_maps_to
              (fun ω hω => by
                rcases Finset.mem_filter.mp hω with ⟨hω_sub, hZz⟩
                rw [← hZz]
                exact h_maps ω hω_sub) g).symm
          rw [h_inner]
          calc ∑ y ∈ F z, ∑ ω ∈ (S_sub.filter (fun ω => Z ω = z)).filter (fun ω => Y ω = y), g ω
              ≤ ∑ _y ∈ F z, (c * m_base z) := by
                refine Finset.sum_le_sum (fun y hy => ?_)
                rw [Finset.filter_filter]
                exact h_cell z hz y hy
            _ = ((F z).card : ℝ) * (c * m_base z) := by
                rw [Finset.sum_const, nsmul_eq_mul]
            _ ≤ M_cap * (c * m_base z) :=
                mul_le_mul_of_nonneg_right (h_card z hz) (mul_nonneg hc_nn (hm_nn z hz))
            _ = (M_cap * c) * m_base z := by ring
      _ = M_cap * c * ∑ z ∈ S.image Z, m_base z := (Finset.mul_sum _ _ _).symm

  refine ⟨?_, ?_, ?_, ?_⟩
  · 
    intro N_ω α_T β₁ β₂ ε N₁₂ N₂₁ Q T Y₁ Y₂ F₁₂ F₂₁ hε₀ hε₁ hN₁₂ hN₂₁ hQ_nn hQ_sum h_fib
    let ell := Real.log (ε⁻¹)
    have hell_pos : 0 < ell := h_ell_pos ε hε₀ hε₁
    let M_cap : ℝ := max (N₁₂ : ℝ) (N₂₁ : ℝ)
    have hN12_ge1 : (1 : ℝ) ≤ (N₁₂ : ℝ) := by exact_mod_cast hN₁₂
    have hM_ge1 : 1 ≤ M_cap := le_trans hN12_ge1 (le_max_left _ _)
    have hM_pos : 0 < M_cap := lt_of_lt_of_le zero_lt_one hM_ge1
    have hQ_Spos_sum : ∑ ω ∈ Spos Q, Q ω = 1 := by
      rw [h_sum_Spos Q hQ_nn, hQ_sum]

    have h_one_dir : ∀ {α_Z β_Y : Type} (Z : Fin N_ω → α_Z) (Y : Fin N_ω → β_Y)
        (F : α_Z → Finset β_Y),
        (∀ ω ∈ Spos Q, Y ω ∈ F (Z ω) ∧ ((F (Z ω)).card : ℝ) ≤ M_cap) →
        finCondEntropy ε Q Z Y ≤ Real.log M_cap / ell ∧
        (∀ τ : ℝ, 0 < τ →
          let err := Real.log M_cap / ell + τ
          (∑ ω ∈ (Spos Q).filter (fun ω => err < condSurprise ε Q Z Y ω), Q ω) ≤ ε ^ τ) := by
      intro α_Z β_Y Z Y F hF
      let m_Z : α_Z → ℝ := fun z => ∑ ω ∈ (Spos Q).filter (fun ω => Z ω = z), Q ω
      have hm_Z_nn : ∀ z ∈ (Spos Q).image Z, 0 ≤ m_Z z :=
        fun z _ => Finset.sum_nonneg (fun ω _ => hQ_nn ω)
      have hm_Z_sum : ∑ z ∈ (Spos Q).image Z, m_Z z = 1 := by
        have h1 := Finset.sum_fiberwise_of_maps_to (s := Spos Q) (t := (Spos Q).image Z)
          (fun ω hω => Finset.mem_image_of_mem Z hω) Q
        exact Eq.trans h1 hQ_Spos_sum
      have hF_card_img : ∀ z ∈ (Spos Q).image Z, ((F z).card : ℝ) ≤ M_cap := by
        intro z hz
        rcases Finset.mem_image.mp hz with ⟨ω_z, hω_z, rfl⟩
        exact (hF ω_z hω_z).2
      refine ⟨?_, ?_⟩
      · have h_ratio_sum :
            (∑ ω ∈ Spos Q, Q ω * (finProbAt Q Z ω / finProbAt2 Q Z Y ω)) ≤ M_cap := by
          have hb := h_dbl_fiber (Spos Q) (Spos Q) Z Y F m_Z
            (fun ω => Q ω * (finProbAt Q Z ω / finProbAt2 Q Z Y ω)) M_cap 1
            (Finset.Subset.refl _) zero_le_one hm_Z_nn (fun ω hω => (hF ω hω).1) hF_card_img
            (fun z hz y _ => by
              let Cell := (Spos Q).filter (fun ω => Z ω = z ∧ Y ω = y)
              change (∑ ω ∈ Cell, Q ω * (finProbAt Q Z ω / finProbAt2 Q Z Y ω)) ≤ 1 * m_Z z
              by_cases hne : Cell.Nonempty
              · rcases hne with ⟨ω₀, hω₀⟩
                rcases Finset.mem_filter.mp hω₀ with ⟨hω₀_pos, hZ0, hY0⟩
                have hp2_0 : finProbAt2 Q Z Y ω₀ = ∑ ω' ∈ Cell, Q ω' := by
                  rw [h_prob2_eq Q Z Y ω₀ hQ_nn]
                  refine Finset.sum_congr ?_ (fun _ _ => rfl)
                  ext ω'
                  simp only [Cell, Finset.mem_filter, hZ0, hY0]
                have hp2_pos : 0 < finProbAt2 Q Z Y ω₀ :=
                  (h_prob_bds ε Q Z Y ω₀ hε₀ hε₁ hQ_nn hω₀_pos).2.1
                have h_cell_eq : (∑ ω ∈ Cell, Q ω * (finProbAt Q Z ω / finProbAt2 Q Z Y ω)) =
                    (∑ ω ∈ Cell, Q ω) * (m_Z z / finProbAt2 Q Z Y ω₀) := by
                  rw [Finset.sum_mul]
                  refine Finset.sum_congr rfl (fun ω hω => ?_)
                  rcases Finset.mem_filter.mp hω with ⟨_, hZw, hYw⟩
                  have hp1 : finProbAt Q Z ω = m_Z z := by
                    rw [h_prob1_eq Q Z ω hQ_nn]
                    simp only [m_Z, hZw]
                  have hp2 : finProbAt2 Q Z Y ω = finProbAt2 Q Z Y ω₀ := by
                    rw [h_prob2_eq Q Z Y ω hQ_nn, h_prob2_eq Q Z Y ω₀ hQ_nn]
                    simp only [hZw, hYw, hZ0, hY0]
                  rw [hp1, hp2]
                rw [h_cell_eq, ← hp2_0, mul_div_cancel₀ _ hp2_pos.ne', one_mul]
              · rw [Finset.not_nonempty_iff_eq_empty.mp hne, Finset.sum_empty, one_mul]
                exact hm_Z_nn z hz)
          rw [hm_Z_sum, mul_one, mul_one] at hb
          exact hb
        have h_ptwise : ∀ ω ∈ Spos Q,
            Q ω * (-Real.log (finProbAt2 Q Z Y ω / finProbAt Q Z ω)) ≤
              Q ω * Real.log M_cap +
                M_cap⁻¹ * (Q ω * (finProbAt Q Z ω / finProbAt2 Q Z Y ω)) - Q ω := by
          intro ω hω
          have hbds := h_prob_bds ε Q Z Y ω hε₀ hε₁ hQ_nn hω
          have hp2 : 0 < finProbAt2 Q Z Y ω := hbds.2.1
          have hp1 : 0 < finProbAt Q Z ω := hbds.2.2.2.1
          have hu_pos : 0 < finProbAt Q Z ω / (M_cap * finProbAt2 Q Z Y ω) :=
            div_pos hp1 (mul_pos hM_pos hp2)
          have h_gibbs := Real.log_le_sub_one_of_pos hu_pos
          have h_log_id : Real.log (finProbAt Q Z ω / (M_cap * finProbAt2 Q Z Y ω)) =
              -Real.log (finProbAt2 Q Z Y ω / finProbAt Q Z ω) - Real.log M_cap := by
            rw [Real.log_div hp1.ne' (mul_pos hM_pos hp2).ne',
              Real.log_mul hM_pos.ne' hp2.ne', Real.log_div hp2.ne' hp1.ne']
            ring
          rw [h_log_id] at h_gibbs
          have h_ineq : -Real.log (finProbAt2 Q Z Y ω / finProbAt Q Z ω) ≤
              Real.log M_cap + M_cap⁻¹ * (finProbAt Q Z ω / finProbAt2 Q Z Y ω) - 1 := by
            have h_eq : finProbAt Q Z ω / (M_cap * finProbAt2 Q Z Y ω) =
                M_cap⁻¹ * (finProbAt Q Z ω / finProbAt2 Q Z Y ω) := by ring
            linarith
          have hmul := mul_le_mul_of_nonneg_left h_ineq (hQ_nn ω)
          linarith
        have h_sum_nlog :
            (∑ ω ∈ Spos Q, Q ω * (-Real.log (finProbAt2 Q Z Y ω / finProbAt Q Z ω))) ≤
              Real.log M_cap := by
          have hs := Finset.sum_le_sum h_ptwise
          simp only [Finset.sum_sub_distrib, Finset.sum_add_distrib, ← Finset.sum_mul,
            ← Finset.mul_sum] at hs
          rw [hQ_Spos_sum, one_mul] at hs
          have h_sc : M_cap⁻¹ *
              (∑ ω ∈ Spos Q, Q ω * (finProbAt Q Z ω / finProbAt2 Q Z Y ω)) ≤ 1 := by
            calc M_cap⁻¹ * (∑ ω ∈ Spos Q, Q ω * (finProbAt Q Z ω / finProbAt2 Q Z Y ω))
                ≤ M_cap⁻¹ * M_cap :=
                  mul_le_mul_of_nonneg_left h_ratio_sum (inv_nonneg.mpr hM_pos.le)
              _ = 1 := inv_mul_cancel₀ hM_pos.ne'
          linarith
        unfold finCondEntropy condSurprise
        rw [h_sum_Spos_mul Q _ hQ_nn]
        have h_pull :
            (∑ ω ∈ Spos Q,
              Q ω * (-Real.log (finProbAt2 Q Z Y ω / finProbAt Q Z ω) / ell)) =
            (∑ ω ∈ Spos Q,
              Q ω * (-Real.log (finProbAt2 Q Z Y ω / finProbAt Q Z ω))) / ell := by
          rw [Finset.sum_div]
          refine Finset.sum_congr rfl (fun ω _ => ?_)
          ring
        change (∑ ω ∈ Spos Q,
            Q ω * (-Real.log (finProbAt2 Q Z Y ω / finProbAt Q Z ω) / ell)) ≤
          Real.log M_cap / ell
        rw [h_pull]
        exact div_le_div_of_nonneg_right h_sum_nlog hell_pos.le
      · intro τ hτ err
        let S_tail := (Spos Q).filter (fun ω => err < condSurprise ε Q Z Y ω)
        have hc_pos : 0 < ε ^ τ / M_cap := div_pos (Real.rpow_pos_of_pos hε₀ τ) hM_pos
        have hb := h_dbl_fiber (Spos Q) S_tail Z Y F m_Z Q M_cap (ε ^ τ / M_cap)
          (Finset.filter_subset _ _) hc_pos.le hm_Z_nn
          (fun ω hω => (hF ω (Finset.mem_filter.mp hω).1).1) hF_card_img
          (fun z hz y _ => by
            let Cell_sub := S_tail.filter (fun ω => Z ω = z ∧ Y ω = y)
            change (∑ ω ∈ Cell_sub, Q ω) ≤ (ε ^ τ / M_cap) * m_Z z
            by_cases hne : Cell_sub.Nonempty
            · rcases hne with ⟨ω₀, hω₀⟩
              rcases Finset.mem_filter.mp hω₀ with ⟨hω₀_tail, hZ0, hY0⟩
              rcases Finset.mem_filter.mp hω₀_tail with ⟨hω₀_pos, herr_lt⟩
              have hbds := h_prob_bds ε Q Z Y ω₀ hε₀ hε₁ hQ_nn hω₀_pos
              have hp2 : 0 < finProbAt2 Q Z Y ω₀ := hbds.2.1
              have hp1 : 0 < finProbAt Q Z ω₀ := hbds.2.2.2.1
              let p := finProbAt2 Q Z Y ω₀ / finProbAt Q Z ω₀
              have hp_pos : 0 < p := div_pos hp2 hp1
              have herr_unfold : Real.log M_cap / ell + τ < -Real.log p / ell := herr_lt
              have h_mul_ell : (Real.log M_cap / ell + τ) * ell < -Real.log p :=
                (lt_div_iff₀ hell_pos).mp herr_unfold
              have h_lhs_simp : (Real.log M_cap / ell + τ) * ell =
                  Real.log M_cap + τ * ell := by
                field_simp [hell_pos.ne']
              have h_log_rhs : Real.log (ε ^ τ / M_cap) = -(τ * ell) - Real.log M_cap := by
                rw [Real.log_div (Real.rpow_pos_of_pos hε₀ τ).ne' hM_pos.ne',
                  h_log_rpow ε τ hε₀]
              have h_log_lt : Real.log p < Real.log (ε ^ τ / M_cap) := by
                linarith
              have hp_le : p ≤ ε ^ τ / M_cap :=
                (h_lt_of_log_lt hp_pos hc_pos h_log_lt).le
              have hp2_le : finProbAt2 Q Z Y ω₀ ≤ (ε ^ τ / M_cap) * m_Z z := by
                have h1 : finProbAt2 Q Z Y ω₀ ≤ (ε ^ τ / M_cap) * finProbAt Q Z ω₀ :=
                  (div_le_iff₀ hp1).mp hp_le
                have hp1_eq : finProbAt Q Z ω₀ = m_Z z := by
                  rw [h_prob1_eq Q Z ω₀ hQ_nn]
                  simp only [m_Z, hZ0]
                rwa [hp1_eq] at h1
              have h_sub_le : (∑ ω ∈ Cell_sub, Q ω) ≤ finProbAt2 Q Z Y ω₀ := by
                rw [h_prob2_eq Q Z Y ω₀ hQ_nn]
                refine Finset.sum_le_sum_of_subset_of_nonneg ?_ (fun ω _ _ => hQ_nn ω)
                intro ω hω
                rcases Finset.mem_filter.mp hω with ⟨hω_t, hZw, hYw⟩
                exact Finset.mem_filter.mpr
                  ⟨(Finset.mem_filter.mp hω_t).1, hZw.trans hZ0.symm, hYw.trans hY0.symm⟩
              exact le_trans h_sub_le hp2_le
            · rw [Finset.not_nonempty_iff_eq_empty.mp hne, Finset.sum_empty]
              exact mul_nonneg hc_pos.le (hm_Z_nn z hz))
        rw [hm_Z_sum, mul_one, mul_div_cancel₀ _ hM_pos.ne'] at hb
        exact hb

    let Z₁ : Fin N_ω → α_T × β₁ := fun ω => (T ω, Y₁ ω)
    let Z₂ : Fin N_ω → α_T × β₂ := fun ω => (T ω, Y₂ ω)
    have h_dir1 := h_one_dir Z₁ Y₂ (fun z => F₁₂ z.1 z.2) (fun ω hω => by
      have hf := h_fib ω (Finset.mem_filter.mp hω).2
      exact ⟨hf.1, le_trans (by exact_mod_cast hf.2.1) (le_max_left _ _)⟩)
    have h_dir2 := h_one_dir Z₂ Y₁ (fun z => F₂₁ z.1 z.2) (fun ω hω => by
      have hf := h_fib ω (Finset.mem_filter.mp hω).2
      exact ⟨hf.2.2.1, le_trans (by exact_mod_cast hf.2.2.2) (le_max_right _ _)⟩)

    have h_bayes : ∀ ω ∈ Spos Q,
        condSurprise ε Q T Y₂ ω - condSurprise ε Q T Y₁ ω =
          condSurprise ε Q Z₁ Y₂ ω - condSurprise ε Q Z₂ Y₁ ω := by
      intro ω hω
      have hpT : 0 < finProbAt Q T ω := (h_prob_bds ε Q T Y₁ ω hε₀ hε₁ hQ_nn hω).2.2.2.1
      have hpTY1 : 0 < finProbAt2 Q T Y₁ ω := (h_prob_bds ε Q T Y₁ ω hε₀ hε₁ hQ_nn hω).2.1
      have hpTY2 : 0 < finProbAt2 Q T Y₂ ω := (h_prob_bds ε Q T Y₂ ω hε₀ hε₁ hQ_nn hω).2.1
      have hpZ12 : 0 < finProbAt2 Q Z₁ Y₂ ω := (h_prob_bds ε Q Z₁ Y₂ ω hε₀ hε₁ hQ_nn hω).2.1
      have hZ1_eq : finProbAt Q Z₁ ω = finProbAt2 Q T Y₁ ω := by
        rw [h_prob1_eq Q Z₁ ω hQ_nn, h_prob2_eq Q T Y₁ ω hQ_nn]
        refine Finset.sum_congr ?_ (fun _ _ => rfl)
        ext ω'
        simp [Z₁, Prod.ext_iff]
      have hZ2_eq : finProbAt Q Z₂ ω = finProbAt2 Q T Y₂ ω := by
        rw [h_prob1_eq Q Z₂ ω hQ_nn, h_prob2_eq Q T Y₂ ω hQ_nn]
        refine Finset.sum_congr ?_ (fun _ _ => rfl)
        ext ω'
        simp [Z₂, Prod.ext_iff]
      have hZ12_eq : finProbAt2 Q Z₂ Y₁ ω = finProbAt2 Q Z₁ Y₂ ω := by
        rw [h_prob2_eq Q Z₂ Y₁ ω hQ_nn, h_prob2_eq Q Z₁ Y₂ ω hQ_nn]
        refine Finset.sum_congr ?_ (fun _ _ => rfl)
        ext ω'
        simp only [Z₁, Z₂, Finset.mem_filter, Prod.ext_iff]
        tauto
      unfold condSurprise
      rw [hZ1_eq, hZ2_eq, hZ12_eq,
        Real.log_div hpTY2.ne' hpT.ne',
        Real.log_div hpTY1.ne' hpT.ne',
        Real.log_div hpZ12.ne' hpTY1.ne',
        Real.log_div hpZ12.ne' hpTY2.ne']
      ring

    refine ⟨?_, ?_⟩
    · have h_ent_diff :
          finCondEntropy ε Q T Y₂ - finCondEntropy ε Q T Y₁ =
            finCondEntropy ε Q Z₁ Y₂ - finCondEntropy ε Q Z₂ Y₁ := by
        unfold finCondEntropy
        rw [h_sum_Spos_mul Q _ hQ_nn, h_sum_Spos_mul Q _ hQ_nn,
          h_sum_Spos_mul Q _ hQ_nn, h_sum_Spos_mul Q _ hQ_nn,
          ← Finset.sum_sub_distrib, ← Finset.sum_sub_distrib]
        refine Finset.sum_congr rfl (fun ω hω => ?_)
        rw [← mul_sub, ← mul_sub, h_bayes ω hω]
      rw [h_ent_diff]
      have h1_nn : 0 ≤ finCondEntropy ε Q Z₁ Y₂ := h_ent_nn ε Q Z₁ Y₂ hε₀ hε₁ hQ_nn
      have h2_nn : 0 ≤ finCondEntropy ε Q Z₂ Y₁ := h_ent_nn ε Q Z₂ Y₁ hε₀ hε₁ hQ_nn
      exact abs_le.mpr ⟨by linarith [h_dir2.1], by linarith [h_dir1.1]⟩
    · intro τ hτ
      let err := Real.log M_cap / ell + τ
      change (∑ ω : Fin N_ω,
          if err < |condSurprise ε Q T Y₂ ω - condSurprise ε Q T Y₁ ω| then Q ω else 0) ≤
        2 * ε ^ τ
      rw [h_ite_Spos Q
        (fun ω => err < |condSurprise ε Q T Y₂ ω - condSurprise ε Q T Y₁ ω|) hQ_nn]
      have h_or := h_filter_or_le Q (Spos Q)
        (fun ω => err < |condSurprise ε Q T Y₂ ω - condSurprise ε Q T Y₁ ω|)
        (fun ω => err < condSurprise ε Q Z₁ Y₂ ω)
        (fun ω => err < condSurprise ε Q Z₂ Y₁ ω) hQ_nn
        (fun ω hω herr => by
          rw [h_bayes ω hω] at herr
          have ha_nn : 0 ≤ condSurprise ε Q Z₁ Y₂ ω :=
