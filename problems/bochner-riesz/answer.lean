        have h1 : 100 * (96 * (N : ℝ) + 182) ^ 2 ≤ C_loc := by
          dsimp only [C_loc]; nlinarith
        have h2 := mul_le_mul_of_nonneg_right h1 (Real.rpow_nonneg hε₀.le (-2 * ν))
