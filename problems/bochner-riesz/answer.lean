  have hw₂_lb : ∀ j : Fin M,
      let d_j : ℝ := ((j.1 + 1 : ℕ) : ℝ) / (M : ℝ)
      (11 / 8 : ℝ) * σ * d_j * h' - (M : ℝ) * Real.log K_dom / ell ≤ w₂ w₀ j := by
    intro j d_j
    let r_idx : ℕ := j.1 + 1
    have hr1 : 1 ≤ r_idx := Nat.succ_pos j.1
    have hrM : r_idx ≤ M := j.2
    have h_ub_R : finCondEntropy ε R_law E_obs (R_stg2 j) ≤ w₂ w₀ j + a₂ :=
      ((h_s3 ε hε0 hε1).2.2.1 P₀ R_law (E₂ w₀) (m'_w0⁻¹) 0 (w₂ w₀ j + a₂) E_obs (R_stg2 j)
        hP₀_nn hP₀_sum hR_nn hR_sum ((one_le_inv₀ hm'_w0_pos).mpr hm'_w0_le1)
        (fun ω hRω => ⟨(hR_supp ω).mp hRω, hE₂_pos w₀ ω ((hR_supp ω).mp hRω)⟩)
        hR_dom_P₀).2 (fun ω hω => (hw₂_cell w₀ j ω hω).2)
    let C_k : ℕ → Fin (sys.N_ω k) → ℤ := fun r ω => dyadicTimeBin ε (v r) (sys.c_seq k ω)
    let Z_k : ℕ → Fin (sys.N_ω k) → ℤ := fun r ω => dyadicRealBin ε (m * v r) (sys.R_seq k ω)
    have hR_stg2_eq : R_stg2 j = Z_k (q₀ + r_idx) := by
      ext ω
      dsimp [R_stg2, Z_k, r_idx]
      have h_depth : m * u' + (((j.1 + 1 : ℕ) : ℝ) / (M : ℝ)) * h' = m * v (q₀ + (j.1 + 1)) := by
        rw [hu'_eq, ← hMτ]
        dsimp [v]
        push_cast
        field_simp [hM_pos.ne', hm.ne']
        ring
      rw [h_depth]
    have h_ref_obs : finCondEntropy ε R_law
        (fun ω => ((sys.T_seq k ω, C_k q₀ ω), Z_k q₀ ω)) (Z_k (q₀ + r_idx)) ≤
        finCondEntropy ε R_law E_obs (R_stg2 j) := by
      rw [hR_stg2_eq]
      refine (h_s3 ε hε0 hε1).1 R_law E_obs
        (fun ω => ((sys.T_seq k ω, C_k q₀ ω), Z_k q₀ ω)) (Z_k (q₀ + r_idx))
        hR_nn hR_sum (fun ω₁ ω₂ _ _ hB => ?_)
      have hT : sys.T_seq k ω₁ = sys.T_seq k ω₂ := (Prod.ext_iff.mp (Prod.ext_iff.mp hB).1).1
      have hC : C_k q₀ ω₁ = C_k q₀ ω₂ := (Prod.ext_iff.mp (Prod.ext_iff.mp hB).1).2
      have hZ : Z_k q₀ ω₁ = Z_k q₀ ω₂ := (Prod.ext_iff.mp hB).2
      dsimp [E_obs]
      refine (h_s2 ε hε0 hε1).2.2.2 m i u' _ _ _ _ _ _ _ _
        (by rw [hT]) (by rw [hT]) ?_ ?_
      · rw [hu'_eq]; exact hC
      · rw [hu'_eq]; exact hZ
    let H_R : ℕ → ℝ := fun r => finCondEntropy ε R_law (fun ω => (sys.T_seq k ω, C_k q₀ ω)) (Z_k r)
    have h_tel_tot : finCondEntropy ε R_law
        (fun ω => ((sys.T_seq k ω, C_k q₀ ω), Z_k q₀ ω)) (Z_k (q₀ + r_idx)) =
        H_R (q₀ + r_idx) - H_R q₀ := by
      have hm_le : m * v q₀ ≤ m * v (q₀ + r_idx) :=
        mul_le_mul_of_nonneg_left (hv_mono q₀ (q₀ + r_idx) (Nat.le_add_right _ _)) hm.le
      have h_add := (h_s3 ε hε0 hε1).2.1 R_law (fun ω => (sys.T_seq k ω, C_k q₀ ω))
        (Z_k q₀) (Z_k (q₀ + r_idx)) hR_nn
        (fun ω₁ ω₂ _ _ h_eq => (h_s2 ε hε0 hε1).2.1 _ _ _ _ hm_le h_eq)
      dsimp [H_R]
      linarith
    have h_tel_sum : ∑ r ∈ Finset.Ico q₀ (q₀ + r_idx), (H_R (r + 1) - H_R r) =
