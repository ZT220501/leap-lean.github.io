  have h_s3_single : ∀ (ε b' a' : ℝ) (V₁ A₁ V₀ A₀ : EuclideanSpace ℝ (Fin 2))
      (c₁ c₀ θ₁ θ₀ : ℝ),
      0 < ε → ε < 1 / 2 →
      stdApertureObs ε u b' a' V₁ A₁ c₁ θ₁ = stdApertureObs ε u b' a' V₀ A₀ c₀ θ₀ →
      let e' := angUnitVec ε (a' - b') (angBin ε (a' - b') θ₀)
      dyadicTimeBin ε u c₁ = dyadicTimeBin ε u c₀ ∧
      ‖e'‖ = 1 ∧
      |inner ℝ (V₁ - V₀) e'| ≤ 2 * ε ^ b' ∧
      |inner ℝ (V₁ - V₀) (perp2D e')| ≤ 2 * ε ^ a' ∧
      |inner ℝ ((A₁ + dyadicTimeMid ε u c₁ • V₁) -
          (A₀ + dyadicTimeMid ε u c₀ • V₀)) e'| ≤ 2 * ε ^ (b' + u) ∧
      |inner ℝ ((A₁ + dyadicTimeMid ε u c₁ • V₁) -
          (A₀ + dyadicTimeMid ε u c₀ • V₀)) (perp2D e')| ≤ 2 * ε ^ (a' + u) := by
    intro ε b' a' V₁ A₁ V₀ A₀ c₁ c₀ θ₁ θ₀ hε₀ hε₁ h_eq e'
    have h1 := congr_arg Prod.fst h_eq
    have h2 : angBin ε (a' - b') θ₁ = angBin ε (a' - b') θ₀ :=
      congr_arg (fun p => p.2.1) h_eq
    have h3 := congr_arg (fun p => p.2.2.1) h_eq
    have h4 := congr_arg (fun p => p.2.2.2.1) h_eq
    have h5 := congr_arg (fun p => p.2.2.2.2.1) h_eq
    have h6 := congr_arg (fun p => p.2.2.2.2.2) h_eq
    dsimp only [stdApertureObs] at h1 h3 h4 h5 h6
    rw [h2] at h3 h4 h5 h6
    refine ⟨h1, h_ang_norm _ _ _, ?_, ?_, ?_, ?_⟩
    · rw [inner_sub_left]; exact (h_real_same ε b' _ _ hε₀ hε₁ h3).le
    · rw [inner_sub_left]; exact (h_real_same ε a' _ _ hε₀ hε₁ h4).le
    · rw [inner_sub_left]; exact (h_real_same ε (b' + u) _ _ hε₀ hε₁ h5).le
    · rw [inner_sub_left]; exact (h_real_same ε (a' + u) _ _ hε₀ hε₁ h6).le

  have h_s3_inter : ∀ (ε b a v_hi : ℝ) (V₁ A₁ V₀ A₀ : EuclideanSpace ℝ (Fin 2))
      (c₁ c₀ θ₁₁ θ₁₂ θ₀₁ θ₀₂ : ℝ),
      0 < ε → ε < 1 / 2 →
      stdApertureObs ε u b a V₁ A₁ c₁ θ₁₁ = stdApertureObs ε u b a V₀ A₀ c₀ θ₀₁ →
      stdApertureObs ε u b a V₁ A₁ c₁ θ₁₂ = stdApertureObs ε u b a V₀ A₀ c₀ θ₀₂ →
      let e := a - b
      let e₁ := angUnitVec ε e (angBin ε e θ₀₁)
      let e₂ := angUnitVec ε e (angBin ε e θ₀₂)
      (v_hi = e ∨ ε ^ v_hi < |inner ℝ e₁ (perp2D e₂)|) →
      dyadicTimeBin ε u c₁ = dyadicTimeBin ε u c₀ ∧
      ‖e₁‖ = 1 ∧
      |inner ℝ (V₁ - V₀) e₁| ≤ 4 * ε ^ (a - v_hi) ∧
      |inner ℝ (V₁ - V₀) (perp2D e₁)| ≤ 4 * ε ^ a ∧
      |inner ℝ ((A₁ + dyadicTimeMid ε u c₁ • V₁) -
          (A₀ + dyadicTimeMid ε u c₀ • V₀)) e₁| ≤ 4 * ε ^ (a - v_hi + u) ∧
      |inner ℝ ((A₁ + dyadicTimeMid ε u c₁ • V₁) -
          (A₀ + dyadicTimeMid ε u c₀ • V₀)) (perp2D e₁)| ≤ 4 * ε ^ (a + u) := by
    intro ε b a v_hi V₁ A₁ V₀ A₀ c₁ c₀ θ₁₁ θ₁₂ θ₀₁ θ₀₂ hε₀ hε₁ h_eq1 h_eq2 e e₁ e₂ hv_or
    obtain ⟨h_kt, he₁_norm, hdV1_par, hdV1_perp, hdX1_par, hdX1_perp⟩ :=
      h_s3_single ε b a V₁ A₁ V₀ A₀ c₁ c₀ θ₁₁ θ₀₁ hε₀ hε₁ h_eq1
    obtain ⟨_, he₂_norm, _, hdV2_perp, _, hdX2_perp⟩ :=
      h_s3_single ε b a V₁ A₁ V₀ A₀ c₁ c₀ θ₁₂ θ₀₂ hε₀ hε₁ h_eq2
    have h_ea_pos : 0 < ε ^ a := Real.rpow_pos_of_pos hε₀ a
    have h_eau_pos : 0 < ε ^ (a + u) := Real.rpow_pos_of_pos hε₀ (a + u)
    refine ⟨h_kt, he₁_norm, ?_, by linarith, ?_, by linarith⟩
    · rcases hv_or with rfl | hs_gt
      · have h_sub_eq : a - (a - b) = b := by ring
        rw [h_sub_eq]
        linarith [Real.rpow_pos_of_pos hε₀ b]
      · have h_vhi_pos : 0 < ε ^ v_hi := Real.rpow_pos_of_pos hε₀ v_hi
        have h_sk := h_skew_bound e₁ e₂ (V₁ - V₀) he₁_norm he₂_norm
        have h_prod : ε ^ v_hi * |inner ℝ (V₁ - V₀) e₁| ≤ ε ^ v_hi * (4 * ε ^ (a - v_hi)) := by
          have h_rpow : 4 * ε ^ a = ε ^ v_hi * (4 * ε ^ (a - v_hi)) := by
            have hexp : a = v_hi + (a - v_hi) := by ring
            conv_lhs => rw [hexp, Real.rpow_add hε₀]
            ring
          calc ε ^ v_hi * |inner ℝ (V₁ - V₀) e₁|
              ≤ |inner ℝ e₁ (perp2D e₂)| * |inner ℝ (V₁ - V₀) e₁| :=
                mul_le_mul_of_nonneg_right hs_gt.le (abs_nonneg _)
            _ ≤ |inner ℝ (V₁ - V₀) (perp2D e₂)| + |inner ℝ (V₁ - V₀) (perp2D e₁)| := h_sk
            _ ≤ 4 * ε ^ a := by linarith
            _ = ε ^ v_hi * (4 * ε ^ (a - v_hi)) := h_rpow
        exact le_of_mul_le_mul_left h_prod h_vhi_pos
    · rcases hv_or with rfl | hs_gt
      · have h_sub_eq : a - (a - b) + u = b + u := by ring
        rw [h_sub_eq]
        linarith [Real.rpow_pos_of_pos hε₀ (b + u)]
      · have h_vhi_pos : 0 < ε ^ v_hi := Real.rpow_pos_of_pos hε₀ v_hi
        let dX := (A₁ + dyadicTimeMid ε u c₁ • V₁) - (A₀ + dyadicTimeMid ε u c₀ • V₀)
        have h_sk := h_skew_bound e₁ e₂ dX he₁_norm he₂_norm
        have h_prod : ε ^ v_hi * |inner ℝ dX e₁| ≤ ε ^ v_hi * (4 * ε ^ (a - v_hi + u)) := by
          have h_rpow : 4 * ε ^ (a + u) = ε ^ v_hi * (4 * ε ^ (a - v_hi + u)) := by
            have hexp : a + u = v_hi + (a - v_hi + u) := by ring
            conv_lhs => rw [hexp, Real.rpow_add hε₀]
            ring
          calc ε ^ v_hi * |inner ℝ dX e₁|
              ≤ |inner ℝ e₁ (perp2D e₂)| * |inner ℝ dX e₁| :=
                mul_le_mul_of_nonneg_right hs_gt.le (abs_nonneg _)
            _ ≤ |inner ℝ dX (perp2D e₂)| + |inner ℝ dX (perp2D e₁)| := h_sk
            _ ≤ 4 * ε ^ (a + u) := by linarith
            _ = ε ^ v_hi * (4 * ε ^ (a - v_hi + u)) := h_rpow
        exact le_of_mul_le_mul_left h_prod h_vhi_pos

  have h_ne_cl : (ValidClassicalGrowthRates γ).Nonempty := ⟨2, h_two⟩
  have h_inf_lt : sInf (ValidClassicalGrowthRates γ) < classicalGrowthRate γ + δ_cl := by
