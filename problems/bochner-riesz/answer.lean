      rw [h_rect_eq_prod _ (-K_M m) (K_M m) (δ_M m) (1 - δ_M m) (hKM_le m) (hδM_le m) hGtot_int,
        h_rect_eq_prod _ (-K_M m) (K_M m) (δ_M m) (1 - δ_M m) (hKM_le m) (hδM_le m) h_err_int,
        h_rect_eq_prod _ (-K_M m) (K_M m) (δ_M m) (1 - δ_M m) (hKM_le m) (hδM_le m) hG1_int,
        ← MeasureTheory.integral_add h_err_int hG1_int]
      exact MeasureTheory.setIntegral_mono hGtot_int (h_err_int.add hG1_int)
        (fun iu => hG_tot_le iu ξ)
    have hΨ_tot_B_int : MeasureTheory.IntegrableOn Ψ_tot B_half MeasureTheory.volume := by
      refine ((hΨ₂_tendsto.1 k_m).add hΨ₁_B_int).mono' hΨ_tot_meas.aestronglyMeasurable.restrict ?_
      filter_upwards [MeasureTheory.ae_restrict_mem hB_half_meas] with ξ hξ
      have h_nn : 0 ≤ Ψ_tot ξ :=
        intervalIntegral.integral_nonneg (hKM_le m) (fun _ _ =>
          intervalIntegral.integral_nonneg (hδM_le m) (fun _ _ =>
            add_nonneg (Finset.sum_nonneg (fun _ _ => abs_nonneg _)) (abs_nonneg _)))
      rw [Real.norm_eq_abs, abs_of_nonneg h_nn]
      exact hΨ_tot_le ξ hξ
    have hΨ_tot_int_bd : (∫ ξ in B_half, Ψ_tot ξ) ≤ (1 / 2) * μ_B * e_m := by
      have h_m1 : (∫ ξ in B_half, Ψ_tot ξ) ≤ ∫ ξ in B_half, (Ψ₂ k_m ξ + Ψ₁ ξ) :=
        MeasureTheory.setIntegral_mono_on hΨ_tot_B_int
          ((hΨ₂_tendsto.1 k_m).add hΨ₁_B_int) hB_half_meas (fun ξ hξ => hΨ_tot_le ξ hξ)
      have h_add_B : (∫ ξ in B_half, (Ψ₂ k_m ξ + Ψ₁ ξ)) =
          (∫ ξ in B_half, Ψ₂ k_m ξ) + ∫ ξ in B_half, Ψ₁ ξ :=
        MeasureTheory.integral_add (hΨ₂_tendsto.1 k_m) hΨ₁_B_int
      linarith [h_m1, h_add_B, hk_m_int.le, hΨ₁_bd]
    have hξ_star_ex : ∃ ξ_star ∈ B_half, Ψ_tot ξ_star ≤ e_m := by
      by_contra h_none
      simp only [not_exists, not_and, not_le] at h_none
      have hc_B : MeasureTheory.IntegrableOn (fun _ : (Fin n → ℝ) × ℝ => e_m)
          B_half MeasureTheory.volume :=
        MeasureTheory.integrableOn_const hB_half_fin.ne
      have h_lo := MeasureTheory.setIntegral_mono_on hc_B hΨ_tot_B_int hB_half_meas
        (fun ξ hξ => (h_none ξ hξ).le)
      rw [MeasureTheory.setIntegral_const, smul_eq_mul, MeasureTheory.Measure.real] at h_lo
      have : μ_B * e_m ≤ (1 / 2) * μ_B * e_m := h_lo.trans hΨ_tot_int_bd
      nlinarith [mul_pos hμ_B_pos he_m_pos]
    obtain ⟨ξ_star, hξ_star_mem, hξ_star_bd⟩ := hξ_star_ex
    obtain ⟨hξ_star_norm, hξ_star_lo, hξ_star_hi, hξ_star_sl, _⟩ := h_ball_half ξ_star hξ_star_mem
    refine ⟨(h_m • ξ_star, k_m), ⟨hk_m_ge, ?_⟩, ?_, hξ_star_bd⟩
    · rw [norm_smul, Real.norm_of_nonneg hh_m_pos.le]
      have h1 : ‖ξ_star‖ ≤ 1 := by linarith
      exact (mul_le_of_le_one_right hh_m_pos.le h1).trans hh_m_le_e
    · intro i u hu q hq
      have hu_eq : (2 * ((m : ℝ) + 4))⁻¹ = δ_M m / 2 := by
        dsimp [δ_M]
        rw [mul_inv, div_eq_mul_inv, mul_comm]
      rw [hu_eq] at hu
      have hq_rad : ‖q - (planeEmbed n c (i, u) + h_m • ξ_star)‖ ≤ r_cone_k :=
        hq.trans hk_m_rad.le
      have hq_d1 : ‖q - (planeEmbed n c (i, u) + h_m • ξ_star)‖ ≤ δ_M m / 8 :=
        hq_rad.trans (min_le_left _ _)
      have hq_d2 : ‖q - (planeEmbed n c (i, u) + h_m • ξ_star)‖ ≤ h_m * c_gap / (8 * C_cone) :=
        hq_rad.trans (min_le_right _ _)
      have hq2_diff : |q.2 - (u + h_m * ξ_star.2)| ≤ δ_M m / 8 :=
        (h_norm_snd (q - (planeEmbed n c (i, u) + h_m • ξ_star))).trans hq_d1
      have hq2_abs := abs_le.mp hq2_diff
      have hδ_pos := hδM_pos m
      have hδ_q := hδM_le_quarter m
      refine ⟨⟨by nlinarith [hu.1, hh_m_pos, hξ_star_lo, hq2_abs.1],
        by nlinarith [hu.2, hh_m_le_δ, hξ_star_hi, hh_m_pos, hq2_abs.2]⟩, fun j₁ j₂ hE => ?_⟩
      have h_low := h_slack_lower j₁ j₂ (planeEmbed n c (i, u) + h_m • ξ_star) q
      rw [h_slack_add, h_slack_plane, zero_add, h_slack_smul] at h_low
      have h_sl_p : (1 / 4) * h_m * c_gap ≤ h_m * edgeSlack j₁ j₂ ξ_star := by
        have := hξ_star_sl j₁ j₂ hE
        nlinarith [hh_m_pos]
      have h_mul : C_cone * ‖q - (planeEmbed n c (i, u) + h_m • ξ_star)‖ ≤ (1 / 8) * h_m * c_gap := by
        calc C_cone * ‖q - (planeEmbed n c (i, u) + h_m • ξ_star)‖
            ≤ C_cone * (h_m * c_gap / (8 * C_cone)) :=
              mul_le_mul_of_nonneg_left hq_d2 hC_cone_pos.le
          _ = (1 / 8) * h_m * c_gap := by field_simp [hC_cone_pos.ne']
      have h_nn_sl : 0 ≤ edgeSlack j₁ j₂ q := by
        have : 0 < h_m * c_gap := mul_pos hh_m_pos hc_gap_pos
        linarith
      dsimp [edgeSlack] at h_nn_sl
      linarith
  let η_seq : ℕ → (Fin n → ℝ) × ℝ := fun m => (Classical.choose (h_diag_ex m)).1
  let k_seq : ℕ → ℕ := fun m => (Classical.choose (h_diag_ex m)).2
  have h_diag_spec := fun m => Classical.choose_spec (h_diag_ex m)
  refine ⟨a, D, η_seq, k_seq, ha_meas_bds, hD_meas_bds, ?_,
    fun m => (h_diag_spec m).1,
    fun m => (h_diag_spec m).2.1,
    fun m => (h_diag_spec m).2.2⟩
  intro K δ R hK hδ0 hδ1 hR
  refine (h_cl3 K δ R hK hδ0 hδ1 hR).congr (fun h => ?_)
  refine intervalIntegral.integral_congr (fun i _ => intervalIntegral.integral_congr (fun u _ => ?_))
  congr 1 with ξ
  congr

theorem submodular_plane_strong_traces (n : ℕ) (hn : 2 ≤ n) (j_top : Fin n)
    (c d : Fin n → ℝ) (d_v : ℝ) (E_cone : Fin n → Fin n → Prop)
    (hc_inj : Function.Injective c)
    (hc_top : ∀ j : Fin n, j ≠ j_top → c j < c j_top)
    (hd_nn : (∀ j, 0 ≤ d j) ∧ 0 ≤ d_v)
    (hE_pos : ∀ j k : Fin n, E_cone j k → 0 < c k - c j)
    (f : ((Fin n → ℝ) × ℝ) → ℝ)
    (hf : IsSubmodularConeProfile n c d d_v E_cone f) :
    ∃ (a : Fin n → ℝ × ℝ → ℝ) (D : ℝ × ℝ → ℝ),
      IsCharacteristicTraceData n j_top c d d_v E_cone f a D :=
by
  obtain ⟨h_meas_L, h_meas_V, M_lip, K_ext, f_ext, hM_nn, h_lip_cone, hf_lip, hf_eq, hf_ae⟩ :=
    submodular_cone_global_lipschitz_and_partials n hn c d d_v E_cone hc_inj hd_nn hE_pos f hf
  obtain ⟨F_seq, hF_c2, hF_unif, hF_signs, hF_L1⟩ :=
    submodular_mollifier_approximants n c d d_v E_cone hd_nn f hf h_meas_L h_meas_V
      K_ext f_ext hf_lip hf_eq hf_ae
  obtain ⟨h_flux_lip, h_top_flux, h_ftc_smooth⟩ :=
    smooth_plane_flux_and_slice_lipschitz n hn j_top c d d_v hc_inj hc_top hd_nn
  have hF_slice_lip : ∀ (K δ : ℝ), 1 ≤ K → 0 < δ → δ < 1 / 2 →
      ∃ C_mix : ℝ, 0 ≤ C_mix ∧
        ∀ (k : ℕ) (η η' : (Fin n → ℝ) × ℝ),
          (∀ (θ i u : ℝ), θ ∈ Set.Icc (0 : ℝ) 1 →
            |i| ≤ K + 1 → u ∈ Set.Icc (δ / 2) (1 - δ / 2) →
            HasSmoothSubmodularSigns n d d_v (F_seq k)
              (planeEmbed n c (i, u) + ((1 - θ) • η + θ • η'))) →
          (∀ j : Fin n, η.1 j = 0 → η'.1 j = 0 →
            (∫ i in (-K)..K, ∫ u in δ..(1 - δ),
              |fderiv ℝ (F_seq k) (planeEmbed n c (i, u) + η) (coneBasisL n j) -
                fderiv ℝ (F_seq k) (planeEmbed n c (i, u) + η') (coneBasisL n j)|) ≤
              C_mix * ((∑ k' : Fin n, |η.1 k' - η'.1 k'|) + |η.2 - η'.2|)) ∧
          (η.2 = 0 → η'.2 = 0 →
            (∫ i in (-K)..K, ∫ u in δ..(1 - δ),
              |fderiv ℝ (F_seq k) (planeEmbed n c (i, u) + η) (coneBasisV n) -
                fderiv ℝ (F_seq k) (planeEmbed n c (i, u) + η') (coneBasisV n)|) ≤
              C_mix * (∑ k' : Fin n, |η.1 k' - η'.1 k'|)) := by
    intro K δ hK hδ0 hδ1
    obtain ⟨C_mix, hC_nn, _, h_sl⟩ := h_flux_lip K δ hK hδ0 hδ1
    exact ⟨C_mix, hC_nn, fun k η η' h_sg => h_sl (F_seq k) η η' (hF_c2 k) h_sg⟩
  obtain ⟨a, D, η_seq, k_seq, ha_meas_bds, hD_meas_bds, h_cl4, h_mk, h_cone_nbhd, h_diag_err⟩ :=
    strong_plane_trace_limit_extraction n hn c d d_v E_cone hc_inj hd_nn hE_pos
      (conePartialL n c d E_cone f) (conePartialV n c d_v E_cone f)
      h_meas_L h_meas_V F_seq hF_c2 hF_signs hF_L1 hF_slice_lip
  have h_zpow_eq : ∀ m : ℕ, (2 : ℝ) ^ (-(m : ℤ)) = (1 / 2 : ℝ) ^ m := by
    intro m
    rw [zpow_neg, zpow_natCast, one_div, inv_pow]
  have h_half_tendsto : Filter.Tendsto (fun m : ℕ => (1 / 2 : ℝ) ^ m) Filter.atTop (nhds 0) :=
    tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num) (by norm_num)
  have h_zpow_shift_tendsto : ∀ m₀ : ℕ,
      Filter.Tendsto (fun m : ℕ => (2 : ℝ) ^ (-((m + m₀ : ℕ) : ℤ))) Filter.atTop (nhds 0) := by
    intro m₀
    simp_rw [h_zpow_eq]
    exact (Filter.tendsto_add_atTop_iff_nat m₀).mpr h_half_tendsto
  have h_plane_c1 : ∀ (α β : ℝ × ℝ → ℝ) (η : (Fin n → ℝ) × ℝ),
      ContDiff ℝ 1 α → ContDiff ℝ 1 β →
      ContDiff ℝ 1 (fun xy : ℝ × ℝ => planeEmbed n c (α xy, β xy) + η) := by
    intro α β η hα hβ
    change ContDiff ℝ 1 (fun xy : ℝ × ℝ =>
      (fun j : Fin n => α xy + c j * β xy + η.1 j, β xy + η.2))
    exact (contDiff_pi.mpr (fun j =>
      (hα.add (contDiff_const.mul hβ)).add contDiff_const)).prodMk (hβ.add contDiff_const)
  have h_fderiv_c1 : ∀ (m : ℕ) (α β : ℝ × ℝ → ℝ) (v : (Fin n → ℝ) × ℝ),
      ContDiff ℝ 1 α → ContDiff ℝ 1 β →
      ContDiff ℝ 1 (fun xy : ℝ × ℝ =>
        fderiv ℝ (F_seq (k_seq m)) (planeEmbed n c (α xy, β xy) + η_seq m) v) := by
    intro m α β v hα hβ
    exact ((hF_c2 (k_seq m)).contDiff_fderiv_apply (by norm_num : (1 : WithTop ℕ∞) + 1 ≤ 2)).comp
      ((h_plane_c1 α β (η_seq m) hα hβ).prodMk contDiff_const)
  have h_signs_diag : ∀ (m : ℕ) (i u : ℝ),
      u ∈ Set.Icc ((2 * (m + 4 : ℝ))⁻¹) (1 - (2 * (m + 4 : ℝ))⁻¹) →
      HasSmoothSubmodularSigns n d d_v (F_seq (k_seq m)) (planeEmbed n c (i, u) + η_seq m) :=
    fun m i u hu => hF_signs (k_seq m) _ (h_cone_nbhd m i u hu)
  let G_diag : ℕ → ((Fin n → ℝ) × ℝ) → ℝ := fun m => F_seq (k_seq m)
  let dL_diag : ℕ → Fin n → ℝ × ℝ → ℝ := fun m j iu =>
    fderiv ℝ (G_diag m) (planeEmbed n c iu + η_seq m) (coneBasisL n j)
  let dV_diag : ℕ → ℝ × ℝ → ℝ := fun m iu =>
    fderiv ℝ (G_diag m) (planeEmbed n c iu + η_seq m) (coneBasisV n)
  let E_L : ℕ → Fin n → ℝ × ℝ → ℝ := fun m j iu => |dL_diag m j iu - a j iu|
  let E_V : ℕ → ℝ × ℝ → ℝ := fun m iu => |dV_diag m iu - D iu|
  let E_tot : ℕ → ℝ × ℝ → ℝ := fun m iu => (∑ j : Fin n, E_L m j iu) + E_V m iu
  let B_cap : ℝ := (∑ j : Fin n, d j) + d_v
  have hdL_cont : ∀ m j, Continuous (dL_diag m j) :=
    fun m j => (h_fderiv_c1 m Prod.fst Prod.snd (coneBasisL n j) contDiff_fst contDiff_snd).continuous
  have hdV_cont : ∀ m, Continuous (dV_diag m) :=
    fun m => (h_fderiv_c1 m Prod.fst Prod.snd (coneBasisV n) contDiff_fst contDiff_snd).continuous
  have hEL_meas : ∀ m j, Measurable (E_L m j) :=
    fun m j => ((hdL_cont m j).measurable.sub (ha_meas_bds j).1).abs
  have hEV_meas : ∀ m, Measurable (E_V m) :=
    fun m => ((hdV_cont m).measurable.sub hD_meas_bds.1).abs
  have hEtot_meas : ∀ m, Measurable (E_tot m) :=
    fun m => (Finset.measurable_sum Finset.univ (fun j _ => hEL_meas m j)).add (hEV_meas m)
  have hEtot_nn : ∀ m iu, 0 ≤ E_tot m iu :=
    fun m iu => add_nonneg (Finset.sum_nonneg (fun _ _ => abs_nonneg _)) (abs_nonneg _)
  let H_cont_diag : ℕ → ℝ × ℝ → ℝ := fun m iu =>
    (∑ j : Fin n, |dL_diag m j iu|) + |dV_diag m iu|
  have hH_cont_diag : ∀ m, Continuous (H_cont_diag m) :=
    fun m => (continuous_finsetSum Finset.univ (fun j _ => (hdL_cont m j).abs)).add (hdV_cont m).abs
  have hEtot_le_cont : ∀ m iu, |E_tot m iu| ≤ |H_cont_diag m iu| + B_cap := by
    intro m iu
    have h1 : ∀ j : Fin n, E_L m j iu ≤ |dL_diag m j iu| + d j := by
      intro j
      have ha_j := (ha_meas_bds j).2 iu
      calc |dL_diag m j iu - a j iu|
          ≤ |dL_diag m j iu| + |a j iu| := abs_sub _ _
        _ = |dL_diag m j iu| + a j iu := by rw [abs_of_nonneg ha_j.1]
        _ ≤ |dL_diag m j iu| + d j := add_le_add le_rfl ha_j.2
    have h2 : E_V m iu ≤ |dV_diag m iu| + d_v := by
      have hD_iu := hD_meas_bds.2 iu
      calc |dV_diag m iu - D iu|
          ≤ |dV_diag m iu| + |D iu| := abs_sub _ _
        _ = |dV_diag m iu| + D iu := by rw [abs_of_nonneg hD_iu.1]
        _ ≤ |dV_diag m iu| + d_v := add_le_add le_rfl hD_iu.2
    have h_sum : ∑ j : Fin n, E_L m j iu ≤ (∑ j : Fin n, |dL_diag m j iu|) + ∑ j : Fin n, d j := by
      rw [← Finset.sum_add_distrib]
      exact Finset.sum_le_sum (fun j _ => h1 j)
    have h_hnn : 0 ≤ H_cont_diag m iu :=
      add_nonneg (Finset.sum_nonneg (fun _ _ => abs_nonneg _)) (abs_nonneg _)
    rw [abs_of_nonneg (hEtot_nn m iu), abs_of_nonneg h_hnn]
    dsimp only [E_tot, H_cont_diag, B_cap]
    linarith
  have h_bdd_rect_int : ∀ (H H_c : ℝ × ℝ → ℝ) (B a₁ b₁ a₂ b₂ : ℝ),
      Measurable H → Continuous H_c → (∀ p, |H p| ≤ |H_c p| + B) →
      MeasureTheory.IntegrableOn H (Set.Ioc a₁ b₁ ×ˢ Set.Ioc a₂ b₂) MeasureTheory.volume := by
    intro H H_c B a₁ b₁ a₂ b₂ hH_m hHc h_le
    obtain ⟨C, hC⟩ := (isCompact_Icc.prod isCompact_Icc).exists_bound_of_continuousOn
      (s := Set.Icc a₁ b₁ ×ˢ Set.Icc a₂ b₂) hHc.continuousOn
    have h_vol : MeasureTheory.volume (Set.Ioc a₁ b₁ ×ˢ Set.Ioc a₂ b₂) < ⊤ := by
      rw [MeasureTheory.Measure.volume_eq_prod, MeasureTheory.Measure.prod_prod,
        Real.volume_Ioc, Real.volume_Ioc]
      exact ENNReal.mul_lt_top ENNReal.ofReal_lt_top ENNReal.ofReal_lt_top
    refine MeasureTheory.IntegrableOn.of_bound h_vol hH_m.aestronglyMeasurable.restrict (C + |B|) ?_
    filter_upwards [MeasureTheory.ae_restrict_mem
      (measurableSet_Ioc.prod measurableSet_Ioc)] with p hp
    have hp_cc : p ∈ Set.Icc a₁ b₁ ×ˢ Set.Icc a₂ b₂ :=
      ⟨Set.Ioc_subset_Icc_self hp.1, Set.Ioc_subset_Icc_self hp.2⟩
    have hCp := hC p hp_cc
    rw [Real.norm_eq_abs] at hCp ⊢
    calc |H p| ≤ |H_c p| + B := h_le p
      _ ≤ C + |B| := add_le_add hCp (le_abs_self B)
  have h_bdd_1d_int : ∀ (g g_c : ℝ → ℝ) (B a₁ b₁ : ℝ),
      Measurable g → Continuous g_c → (∀ x, |g x| ≤ |g_c x| + B) →
      MeasureTheory.IntegrableOn g (Set.Ioc a₁ b₁) MeasureTheory.volume := by
    intro g g_c B a₁ b₁ hg_m hgc h_le
    obtain ⟨C, hC⟩ := isCompact_Icc.exists_bound_of_continuousOn (s := Set.Icc a₁ b₁) hgc.continuousOn
    have h_vol : MeasureTheory.volume (Set.Ioc a₁ b₁) < ⊤ := by
      rw [Real.volume_Ioc]
      exact ENNReal.ofReal_lt_top
    refine MeasureTheory.IntegrableOn.of_bound h_vol hg_m.aestronglyMeasurable.restrict (C + |B|) ?_
    filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_Ioc] with x hx
    have hCx := hC x (Set.Ioc_subset_Icc_self hx)
    rw [Real.norm_eq_abs] at hCx ⊢
    calc |g x| ≤ |g_c x| + B := h_le x
      _ ≤ C + |B| := add_le_add hCx (le_abs_self B)
  have h_rect_slice_int : ∀ (H : ℝ × ℝ → ℝ) (a₁ b₁ a₂ b₂ : ℝ),
      a₂ ≤ b₂ →
      MeasureTheory.IntegrableOn H (Set.Ioc a₁ b₁ ×ˢ Set.Ioc a₂ b₂) MeasureTheory.volume →
      MeasureTheory.IntegrableOn (fun x => ∫ y in a₂..b₂, H (x, y))
        (Set.Ioc a₁ b₁) MeasureTheory.volume := by
    intro H a₁ b₁ a₂ b₂ ha₂ h_int
    have h_prod : MeasureTheory.Integrable H
        ((MeasureTheory.volume.restrict (Set.Ioc a₁ b₁)).prod
          (MeasureTheory.volume.restrict (Set.Ioc a₂ b₂))) := by
      rwa [MeasureTheory.Measure.prod_restrict, ← MeasureTheory.Measure.volume_eq_prod]
    have h_sl := h_prod.integral_prod_left
    simpa only [MeasureTheory.IntegrableOn, intervalIntegral.integral_of_le ha₂] using h_sl
  have h_rect_eq_prod : ∀ (H : ℝ × ℝ → ℝ) (a₁ b₁ a₂ b₂ : ℝ),
      a₁ ≤ b₁ → a₂ ≤ b₂ →
      MeasureTheory.IntegrableOn H (Set.Ioc a₁ b₁ ×ˢ Set.Ioc a₂ b₂) MeasureTheory.volume →
      (∫ x in a₁..b₁, ∫ y in a₂..b₂, H (x, y)) =
        ∫ p in Set.Ioc a₁ b₁ ×ˢ Set.Ioc a₂ b₂, H p := by
    intro H a₁ b₁ a₂ b₂ ha₁ ha₂ h_int
    rw [intervalIntegral.integral_of_le ha₁]
    have h_in : ∀ x, (∫ y in a₂..b₂, H (x, y)) = ∫ y in Set.Ioc a₂ b₂, H (x, y) :=
      fun _ => intervalIntegral.integral_of_le ha₂
    simp_rw [h_in]
    rw [MeasureTheory.Measure.volume_eq_prod] at h_int ⊢
    exact (MeasureTheory.setIntegral_prod H h_int).symm
  have h_rect_swap : ∀ (H : ℝ × ℝ → ℝ) (a₁ b₁ a₂ b₂ : ℝ),
      a₁ ≤ b₁ → a₂ ≤ b₂ →
      MeasureTheory.IntegrableOn H (Set.Ioc a₁ b₁ ×ˢ Set.Ioc a₂ b₂) MeasureTheory.volume →
      (∫ x in a₁..b₁, ∫ y in a₂..b₂, H (x, y)) =
        ∫ y in a₂..b₂, ∫ x in a₁..b₁, H (x, y) := by
    intro H a₁ b₁ a₂ b₂ ha₁ ha₂ h_int
    rw [h_rect_eq_prod H a₁ b₁ a₂ b₂ ha₁ ha₂ h_int]
    rw [intervalIntegral.integral_of_le ha₂]
