              have hmul_comm : ((W_f o).1 : ℝ) * s_u = s_u * ((W_f o).1 : ℝ) := mul_comm _ _
              have h_r : cls.B_sys * ε ^ (-ζ_sh) * s_u + 32 * ε ^ (-ζ_sh) * s_u +
                  ε ^ (-ζ_sh) * s_u = R_W1 * s_u := by dsimp only [R_W1]; ring
              obtain ⟨h1, h2⟩ := abs_le.mp hW_in
              obtain ⟨h3, h4⟩ := abs_le.mp hrot_err
              obtain ⟨h5, h6⟩ := abs_le.mp hap_err
              exact abs_le.mpr
                ⟨by linarith only [h1, h2, h3, h4, h5, h6, hrot_sh, hbin_sh, hmul_comm, h_r],
                 by linarith only [h1, h2, h3, h4, h5, h6, hrot_sh, hbin_sh, hmul_comm, h_r]⟩
            exact Finset.mem_product.mpr
              ⟨h_box1D_mem s_u μ_dp R_W1 (W_f o).1 hsu_pos hRW1_nn htot,
               Finset.mem_singleton.mpr hW_z⟩
          have hc1 : ((S_pc.image W_f).card : ℝ) ≤ (B_W1.card : ℝ) :=
            Nat.cast_le.mpr (Finset.card_le_card h_img_sub)
          have hc2 : B_W1.card = (box1D s_u μ_dp R_W1).card := by
            dsimp only [B_W1]
            rw [Finset.card_product, Finset.card_singleton, mul_one]
          rw [hc2] at hc1
          have hc3 := h_box1D_card s_u μ_dp R_W1 hRW1_nn
          have hc4 : 2 * R_W1 + 3 ≤ (2 * cls.B_sys + 69) * ε ^ (-ζ_sh) := by
            dsimp only [R_W1]; linarith only [he_mζ_ge1]
          exact le_trans hc1 (le_trans hc3 (le_trans hc4
            (mul_le_mul_of_nonneg_right hCW_B69 he_mζ_pos.le)))
        · 
          obtain ⟨hb_ut, ha_ut⟩ := hd2_eq hd2
          let R_W2 : ℝ := 2 * cls.B_sys + 2
          have hRW2_nn : 0 ≤ R_W2 := by dsimp only [R_W2]; linarith only [hB_sys]
          let B_W2 : Finset (ℤ × ℤ) := box2D s_u (V_D d - V_ref) R_W2
          have h_img_sub : S_pc.image W_f ⊆ B_W2 := by
            intro w hw
            obtain ⟨o, ho_pc, rfl⟩ := Finset.mem_image.mp hw
            obtain ⟨ho_S3, hPf_eq⟩ := Finset.mem_filter.mp ho_pc
            obtain ⟨_, _, hpod, _⟩ := Finset.mem_filter.mp ho_S3
            obtain ⟨hv_par, hv_perp⟩ := h_VD_proj o d hpod
            rw [hb_ut] at hv_par
            rw [ha_ut] at hv_perp
            have hVO_VD : ‖V_O o - V_D d‖ ≤ 2 * cls.B_sys * s_u := by
              have hpars := (h_perp2D_parseval (e_D d) (he_D d)).2 (V_O o - V_D d)
              have hs1 : (inner ℝ (V_O o - V_D d) (e_D d)) ^ 2 ≤ (cls.B_sys * s_u) ^ 2 := by
                rw [← sq_abs]
                exact pow_le_pow_left₀ (abs_nonneg _) hv_par 2
              have hs2 : (inner ℝ (V_O o - V_D d) (perp2D (e_D d))) ^ 2 ≤
                  (cls.B_sys * s_u) ^ 2 := by
                rw [← sq_abs]
                exact pow_le_pow_left₀ (abs_nonneg _) hv_perp 2
              have hnsq : ‖V_O o - V_D d‖ ^ 2 ≤ (2 * cls.B_sys * s_u) ^ 2 := by
                rw [hpars]
                have hsq_nn : 0 ≤ (cls.B_sys * s_u) ^ 2 := sq_nonneg (cls.B_sys * s_u)
                have h2sq : (2 * cls.B_sys * s_u) ^ 2 = 4 * (cls.B_sys * s_u) ^ 2 := by ring
                linarith only [hs1, hs2, hsq_nn, h2sq]
              have h2B_nn : 0 ≤ 2 * cls.B_sys * s_u :=
                mul_nonneg (by linarith only [hB_sys]) hsu_pos.le
              exact (sq_le_sq₀ (norm_nonneg _) h2B_nn).mp hnsq
            obtain ⟨_, _, _, _, hW2_imp⟩ := hPf_props o
            have hW_bd := hW2_imp hd2
            rw [hPf_eq] at hW_bd
            have hid : gridPt2D s_u (W_f o) - (V_D d - V_ref) =
                (gridPt2D s_u (W_f o) - (V_O o - V_ref)) + (V_O o - V_D d) := by abel
            have htot : ‖gridPt2D s_u (W_f o) - (V_D d - V_ref)‖ ≤ R_W2 * s_u := by
              rw [hid]
              have hw1 : ‖gridPt2D s_u (W_f o) - (V_O o - V_ref)‖ ≤ 2 * s_u := by
                have heq : gridPt2D s_u (W_f o) - (V_O o - V_ref) =
                    -(V_O o - V_ref - gridPt2D s_u (W_f o)) := by abel
                rw [heq, norm_neg]; exact hW_bd
              have ht := le_trans (norm_add_le _ _) (add_le_add hw1 hVO_VD)
              have ht2 : 2 * s_u + 2 * cls.B_sys * s_u = R_W2 * s_u := by
                dsimp only [R_W2]; ring
              exact le_trans ht (le_of_eq ht2)
            exact h_box2D_mem s_u (V_D d - V_ref) R_W2 (W_f o) hsu_pos hRW2_nn htot
          have hc1 : ((S_pc.image W_f).card : ℝ) ≤ (B_W2.card : ℝ) :=
            Nat.cast_le.mpr (Finset.card_le_card h_img_sub)
          have hc2 := h_box2D_card s_u (V_D d - V_ref) R_W2 hRW2_nn
          have hc3 : (2 * R_W2 + 3) ^ 2 = (4 * cls.B_sys + 7) ^ 2 := by
            dsimp only [R_W2]; ring
          rw [hc3] at hc2
          have hc4 : C_W ≤ C_W * ε ^ (-ζ_sh) := by nlinarith only [he_mζ_ge1, hCW_ge1]
          exact le_trans hc1 (le_trans hc2 (le_trans hCW_B7 hc4))
    
    have h1 : ((S_3.image W_f).card : ℝ) ≤
        ((∑ p_c ∈ Cand_P, ((S_3.filter (fun o => P_f o = p_c)).image W_f).card : ℕ) : ℝ) :=
      Nat.cast_le.mpr (le_trans (Finset.card_le_card h_sub3) Finset.card_biUnion_le)
    rw [Nat.cast_sum] at h1
    have h2 : ∑ p_c ∈ Cand_P, (((S_3.filter (fun o => P_f o = p_c)).image W_f).card : ℝ) ≤
        ∑ _p_c ∈ Cand_P, (C_W * ε ^ (-ζ_sh)) :=
      Finset.sum_le_sum h_fib3
    rw [Finset.sum_const, nsmul_eq_mul] at h2
    have h_rpow_merge : ε ^ (-2 * θ) * ε ^ (-ζ_sh) = ε ^ (-2 * θ - ζ_sh) := by
      rw [← Real.rpow_add hε₀]
      congr 1
    have he_m2θζ_pos : 0 < ε ^ (-2 * θ - ζ_sh) := Real.rpow_pos_of_pos hε₀ (-2 * θ - ζ_sh)
    have h3 : (Cand_P.card : ℝ) * (C_W * ε ^ (-ζ_sh)) ≤ C_geom * ε ^ (-2 * θ - ζ_sh) := by
      calc (Cand_P.card : ℝ) * (C_W * ε ^ (-ζ_sh))
          ≤ (C_P * ε ^ (-2 * θ)) * (C_W * ε ^ (-ζ_sh)) :=
            mul_le_mul_of_nonneg_right hCand_card (mul_nonneg (by linarith only [hCW_ge1]) he_mζ_pos.le)
        _ = (C_P * C_W) * (ε ^ (-2 * θ) * ε ^ (-ζ_sh)) := by ring
        _ = (C_P * C_W) * ε ^ (-2 * θ - ζ_sh) := by rw [h_rpow_merge]
        _ ≤ C_geom * ε ^ (-2 * θ - ζ_sh) :=
            mul_le_mul_of_nonneg_right hCPW_le_geom he_m2θζ_pos.le
    exact le_trans h1 (le_trans h2 h3)

theorem candidate_b1_cancellation_and_incoming_info (γ : ℝ) (hγ₀ : 0 < γ) (hγ₁ : γ < 1)
    (cls : PacketBoundClass) (h u_min ζ_sh ξ C_cov e_rep C_coh_tot : ℝ)
    (d_dim M_L : ℕ)
    (hh : 0 < h) (hu_min : (3 / 2 : ℝ) * h ≤ u_min)
    (hζ_sh : 0 < ζ_sh) (hξ : 0 < ξ) (hC_cov : 2 ≤ C_cov)
    (hd_dim : d_dim = 1 ∨ d_dim = 2)
    (hML_64 : 64 ≤ M_L) (he_rep : 0 < e_rep) (hC_coh : 1 ≤ C_coh_tot) :
    let θ := min (h / 64) (e_rep / 256)
    ∃ C_ent_info : ℝ, 0 ≤ C_ent_info ∧
      ∀ (ε H_P L t b_star lam_sys k_out H_in : ℝ) (m_r m_t N_O N_D N_J S_per_loc : ℕ)
        (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
        (f : EuclideanSpace ℝ (Fin 2) → ℂ)
        (τ_V τ_X : EuclideanSpace ℝ (Fin 2))
        (r_O : Fin N_O → ℕ) (V_O X_O : Fin N_O → EuclideanSpace ℝ (Fin 2))
        (ψ_O : Fin N_O → EuclideanSpace ℝ (Fin 2) → ℂ)
        (b_D a_D : Fin N_D → ℝ) (r_D : Fin N_D → ℕ)
        (e_D V_D X_D : Fin N_D → EuclideanSpace ℝ (Fin 2))
        (N_ret_of : Fin N_J → ℕ)
        (menu : ∀ j : Fin N_J, LocalizerSubclass (N_ret_of j))
        (win_of : Fin N_O → Fin N_J)
        (p : Fin N_O → Fin N_D → ℝ)
        (Q_of : Fin N_J → Fin N_O → (ℕ × (ℤ × ℤ) × (ℤ × ℤ)) × ℕ × (ℤ × ℤ))
        (Z_of : Fin N_J → Fin N_O → ((ℕ × (ℤ × ℤ) × (ℤ × ℤ)) × ℕ × (ℤ × ℤ)) × (ℤ × ℤ))
        (T_cand : ∀ j : Fin N_J, ((ℕ × (ℤ × ℤ) × (ℤ × ℤ)) × ℕ × (ℤ × ℤ)) → Finset (Fin (N_ret_of j)))
        (m_site : Fin N_J → Fin N_O → ℝ),
        letI := Classical.propDecidable
        let r := t - 2 * h
        let ell := Real.log (ε⁻¹)
        let u := (H_P - t) / 2 - b_star
        let s_c := ((2 : ℝ) ^ m_r)⁻¹
        let s_v := ε ^ b_star
        let s_x := s_c * s_v
        let ρ_r := ε ^ ((H_P - r) / 2)
        let σ_r := (lam_sys * ρ_r)⁻¹
        let F_T_fn : ∀ j : Fin N_J, ℕ → Fin (N_ret_of j) → ℕ × (ℤ × ℤ) × (ℤ × ℤ) :=
          fun j r_loc α =>
            let V_J := gridPt2D s_v (menu j).loc_idx.2.1
            let X_J := gridPt2D s_x (menu j).loc_idx.2.2
            let V'_α := s_v⁻¹ • (gridPt2D ρ_r ((menu j).o_at α).1 - V_J)
            let X'_α := s_x⁻¹ • (gridPt2D σ_r ((menu j).o_at α).2 - X_J)
            let c_end := ((r_loc : ℝ) + 1 / 2) * ((2 : ℝ) ^ (m_t - m_r))⁻¹
            (r_loc,
             roundShift2D (ε ^ (u - h)) 0 V'_α,
             roundShift2D (ε ^ (u + h)) 0 (X'_α + (c_end - 1 / 2) • V'_α))
        0 < ε → ε < 1 / 4 → 0 < r → t ≤ 1 → t ≤ L → t ≤ H_P → H_P ≤ cls.K_hor →
        1 ≤ S_per_loc →
        (∀ j₀, ((Finset.univ.filter (fun j : Fin N_J =>
          (menu j).loc_idx = j₀)).card : ℝ) ≤ (S_per_loc : ℝ)) →
        0 ≤ b_star → u_min ≤ u → 0 ≤ k_out → k_out ≤ 3 * h →
        ε ^ r ≤ s_c → s_c ≤ 2 * ε ^ r → m_r ≤ m_t →
        cls.B_sys⁻¹ * ε ^ (-H_P) ≤ lam_sys → lam_sys ≤ cls.B_sys * ε ^ (-H_P) →
        cls.B_sys⁻¹ * ε ^ t ≤ ((2 : ℝ) ^ m_t)⁻¹ → ((2 : ℝ) ^ m_t)⁻¹ ≤ cls.B_sys * ε ^ t →
        IsAdmissiblePacketLaw ε H_P L t cls.B_sys cls.R_win cls.N_mult cls.M_win
          lam_sys m_t Φ₀ f N_O N_D r_O V_O X_O ψ_O b_D a_D r_D e_D V_D X_D p →
        (∀ o d, 0 < p o d →
          let j := win_of o
          (menu j).loc_idx = cutLocalizerIdx ε b_star m_r m_t (r_O o) (V_O o) (X_O o) ∧
          b_star ≤ b_D d ∧
          (Z_of j o).1 = Q_of j o ∧
          (Q_of j o).2.1 = r_O o % 2 ^ (m_t - m_r) ∧
          0 < m_site j o ∧
          generalPacketObsMass ε H_P t lam_sys m_t Φ₀ f (r_O o) (V_O o) (X_O o) (ψ_O o) ≤
            16 * ((S_per_loc : ℝ) ^ 2) * m_site j o ∧
          (T_cand j (Q_of j o)).Nonempty ∧
          (∀ α ∈ T_cand j (Q_of j o),
            ‖gridPt2D ρ_r ((menu j).o_at α).1 - V_O o‖ ≤
              (2 * (M_L : ℝ) + 4) * ε ^ ((H_P - t) / 2) ∧
            ‖(gridPt2D σ_r ((menu j).o_at α).2 +
                (((r_O o : ℝ) + 1 / 2) * ((2 : ℝ) ^ m_t)⁻¹ -
                  (((menu j).loc_idx.1 : ℝ) + 1 / 2) * s_c) •
                  gridPt2D ρ_r ((menu j).o_at α).1) - X_O o‖ ≤
              (8 * C_cov * cls.B_sys + 16) * (ε ^ (-θ)) * s_x * ε ^ (u + h))) →
        (∀ j : Fin N_J,
          let S_act := Finset.univ.filter (fun o : Fin N_O =>
            win_of o = j ∧ 0 < ∑ d : Fin N_D, p o d)
          0 < (menu j).m_bin ∧
          (∀ q, ∑ o ∈ S_act.filter (fun o => Q_of j o = q), m_site j o ≤
            C_coh_tot * ε ^ (-ξ) * ((T_cand j q).card : ℝ) * (menu j).m_bin) ∧
          (∀ z, ∑ o ∈ S_act.filter (fun o => Z_of j o = z), m_site j o ≤
            C_coh_tot * ((M_L ^ 4 : ℕ) : ℝ) *
              ε ^ ((d_dim : ℝ) * h - k_out - 2 * θ - 2 * ξ) *
              ((T_cand j z.1).card : ℝ) * (menu j).m_bin) ∧
          (∀ (α : Fin (N_ret_of j)) (r_loc : ℕ),
            (((S_act.image (Q_of j)).filter (fun q =>
              q.2.1 = r_loc ∧ α ∈ T_cand j q)).card : ℝ) ≤ C_coh_tot * ε ^ (-2 * θ)) ∧
          (∀ (α : Fin (N_ret_of j)) (d : Fin N_D),
            (0 < ∑ o ∈ S_act, p o d) →
            (((S_act.filter (fun o => 0 < p o d ∧ α ∈ T_cand j (Q_of j o))).image
              (Z_of j)).card : ℝ) ≤ C_coh_tot * ε ^ (-2 * θ - ζ_sh))) →
        (H_in ≤ 0 ∨
         (∃ (L_grid : ℝ) (τ_Vf τ_Xf : EuclideanSpace ℝ (Fin 2))
            (P_f : Fin N_O → ℕ × (ℤ × ℤ) × (ℤ × ℤ))
            (n_f : (ℕ × (ℤ × ℤ) × (ℤ × ℤ)) → EuclideanSpace ℝ (Fin 2))
            (W_f : Fin N_O → ℤ × ℤ),
            let u_t := (H_P - t) / 2
            let s_Vf := L_grid * ε ^ (u_t - h)
            let s_Xf := L_grid * ε ^ (t + u_t - h)
            1 ≤ L_grid ∧ L_grid ≤ 4 ∧ (∀ p_c, ‖n_f p_c‖ = 1) ∧
            (∀ o : Fin N_O, (P_f o).1 = r_O o ∧
              ‖V_O o - (τ_Vf + gridPt2D s_Vf (P_f o).2.1)‖ ≤ s_Vf ∧
              ‖X_O o - (τ_Xf + gridPt2D s_Xf (P_f o).2.2)‖ ≤ s_Xf ∧
              (d_dim = 1 →
                |inner ℝ (V_O o - (τ_Vf + gridPt2D s_Vf (P_f o).2.1)) (n_f (P_f o)) -
                  ((W_f o).1 : ℝ) * ε ^ u_t| ≤ ε ^ u_t ∧ (W_f o).2 = 0) ∧
              (d_dim = 2 →
                ‖V_O o - (τ_Vf + gridPt2D s_Vf (P_f o).2.1) - gridPt2D (ε ^ u_t) (W_f o)‖ ≤
                  2 * ε ^ u_t)) ∧
            (d_dim = 1 → ∀ o d, 0 < p o d →
              projAngleDist (perp2D (e_D d)) (n_f (P_f o)) ≤ 4 * ε ^ h) ∧
            (∀ o d, 0 < p o d → |(H_P - t) / 2 - a_D d| ≤ ζ_sh ∧
              (d_dim = 2 → b_D d = (H_P - t) / 2 ∧ a_D d = (H_P - t) / 2)) ∧
            (let p_O := fun o => ∑ d : Fin N_D, p o d
             let p_P := fun p_c => ∑ o ∈ Finset.univ.filter (fun o => P_f o = p_c), p_O o
             let p_PW := fun p_c w =>
               ∑ o ∈ Finset.univ.filter (fun o => P_f o = p_c ∧ W_f o = w), p_O o
             H_in ≤ (∑ p_c ∈ Finset.univ.image P_f, ∑ w ∈ Finset.univ.image W_f,
               -(p_PW p_c w * Real.log (p_PW p_c w / p_P p_c))) / ell))) →
        let π_J := fun j : Fin N_J =>
          ∑ o ∈ Finset.univ.filter (fun o => win_of o = j), ∑ d : Fin N_D, p o d
        let H_J := (∑ j : Fin N_J, -(π_J j * Real.log (π_J j))) / ell
        let q_cand : ∀ j : Fin N_J, Fin N_O → Fin N_D → Fin (N_ret_of j) → ℝ :=
          fun j o d α =>
            if win_of o = j ∧ 0 < π_J j ∧ α ∈ T_cand j (Q_of j o) then
              (p o d / π_J j) / ((T_cand j (Q_of j o)).card : ℝ)
            else 0
        let q_T := fun j α => ∑ o, ∑ d, q_cand j o d α
        let q_TD := fun j α d => ∑ o, q_cand j o d α
        let q_D := fun j d => ∑ o, ∑ α, q_cand j o d α
        let q_TR := fun j α (rl : Fin (2 ^ (m_t - m_r))) =>
          ∑ o ∈ Finset.univ.filter (fun o => r_O o % 2 ^ (m_t - m_r) = rl.1),
            ∑ d, q_cand j o d α
        let π_FTJ := fun j (ft : ℕ × (ℤ × ℤ) × (ℤ × ℤ)) =>
          ∑ o, ∑ d, ∑ α ∈ Finset.univ.filter (fun α => F_T_fn j (r_O o % 2 ^ (m_t - m_r)) α = ft),
            π_J j * q_cand j o d α
        let π_TFTJ := fun j ft α =>
          ∑ o, ∑ d, if F_T_fn j (r_O o % 2 ^ (m_t - m_r)) α = ft then π_J j * q_cand j o d α else 0
        let π_DFTJ := fun j ft d =>
          ∑ o, ∑ α ∈ Finset.univ.filter (fun α => F_T_fn j (r_O o % 2 ^ (m_t - m_r)) α = ft),
            π_J j * q_cand j o d α
        let π_TDFTJ := fun j ft α d =>
          ∑ o, if F_T_fn j (r_O o % 2 ^ (m_t - m_r)) α = ft then π_J j * q_cand j o d α else 0
        let S_FT : Fin N_J → Finset (ℕ × (ℤ × ℤ) × (ℤ × ℤ)) := fun j =>
          (Finset.univ ×ˢ Finset.univ).image (fun oα : Fin N_O × Fin (N_ret_of j) =>
            F_T_fn j (r_O oα.1 % 2 ^ (m_t - m_r)) oα.2)
        let I_TD_FTJ : ℝ :=
          (∑ j : Fin N_J, ∑ ft ∈ S_FT j, ∑ α : Fin (N_ret_of j), ∑ d : Fin N_D,
            if 0 < π_FTJ j ft then
              π_TDFTJ j ft α d * Real.log ((π_TDFTJ j ft α d * π_FTJ j ft) /
                (π_TFTJ j ft α * π_DFTJ j ft d))
            else 0) / ell
        (generalPacketScore ε γ H_P t lam_sys m_t Φ₀ f N_O N_D r_O V_O X_O ψ_O b_D a_D p ≤
          H_J + b_star +
          (∑ j : Fin N_J, if 0 < π_J j then π_J j * (
            (∑ α, -(q_T j α * Real.log (q_T j α))) / ell +
            (3 / 2 : ℝ) * (Real.log (menu j).m_bin / ell) +
            (1 / 2 : ℝ) * (
              (∑ d, q_D j d * pktWeight γ (b_D d - b_star) (a_D d - b_star)) +
              (∑ α, ∑ d, -(q_TD j α d * Real.log (q_TD j α d / q_D j d))) / ell +
              2 * ((∑ α, ∑ rl : Fin (2 ^ (m_t - m_r)),
                -(q_TR j α rl * Real.log (q_TR j α rl / q_T j α))) / ell) +
              k_out - (d_dim : ℝ) * h))
           else 0) +
          4 * θ + 2 * ξ + (1 / 2 : ℝ) * ζ_sh +
          (7 / 2 : ℝ) * (Real.log (S_per_loc : ℝ) / ell) + C_ent_info / ell) ∧
        (H_in - 6 * θ - ζ_sh - (Real.log (S_per_loc : ℝ) / ell) - C_ent_info / ell ≤ I_TD_FTJ) :=
by
  have hML_1 : 1 ≤ M_L := by omega
  have h_ell_pos : ∀ {ε : ℝ}, 0 < ε → ε < 1 / 4 → 0 < Real.log (ε⁻¹) := by
    intro ε hε₀ hε₁
    have h1 : (1 : ℝ) < ε⁻¹ := by
      rw [lt_inv_comm₀ zero_lt_one hε₀]
      linarith
    exact Real.log_pos h1

  intro θ
  have hθ_pos : 0 < θ := lt_min (by linarith) (by linarith)

  obtain ⟨C_split, hC_split_nn, h_s1⟩ := multi_localizer_score_and_winner_list_split cls
  obtain ⟨C_geom, hC_geom_ge1, h_s4⟩ :=
    incoming_credit_ft_wf_fiber_card_bounds cls h u_min ζ_sh C_cov e_rep d_dim M_L
      hh hu_min hζ_sh hC_cov hd_dim hML_64 he_rep

  let C_ent_info : ℝ :=
    max (C_split + 3 * Real.log C_coh_tot + 2 * Real.log (M_L : ℝ)) (3 * Real.log C_geom)
  have hC_geom_pos : 0 < C_geom := lt_of_lt_of_le zero_lt_one hC_geom_ge1
  have hlog_geom_nn : 0 ≤ Real.log C_geom := Real.log_nonneg hC_geom_ge1
  have hC_ent_nn : 0 ≤ C_ent_info :=
    le_trans (mul_nonneg (by norm_num) hlog_geom_nn) (le_max_right _ _)
  have hC_ent_left : C_split + 3 * Real.log C_coh_tot + 2 * Real.log (M_L : ℝ) ≤ C_ent_info :=
    le_max_left _ _
  have hC_ent_right : 3 * Real.log C_geom ≤ C_ent_info :=
    le_max_right _ _

  refine ⟨C_ent_info, hC_ent_nn, ?_⟩

  intro ε H_P L t b_star lam_sys k_out H_in m_r m_t N_O N_D N_J S_per_loc
    Φ₀ f τ_V τ_X r_O V_O X_O ψ_O b_D a_D r_D e_D V_D X_D
    N_ret_of menu win_of p Q_of Z_of T_cand m_site
  letI := Classical.propDecidable
  intro r ell u s_c s_v s_x ρ_r σ_r F_T_fn
  intro hε₀ hε₁ hr_pos ht_le1 ht_L ht_HP hHP_K
    hS_loc_1 hcard_loc hb_star_nn hu_ge hk_out0 hk_out_3h
    hsc_lo hsc_hi hmr_le_mt hlam_lo hlam_hi hmt1 hmt2
    hadm_p h_act h_coh_j h_Hin
  intro π_J H_J q_cand q_T q_TD q_D q_TR π_FTJ π_TFTJ π_DFTJ π_TDFTJ S_FT I_TD_FTJ

  have hell_pos : 0 < ell := h_ell_pos hε₀ hε₁
  have hS_loc_ge1 : (1 : ℝ) ≤ (S_per_loc : ℝ) := by exact_mod_cast hS_loc_1
  have hS_loc_pos : (0 : ℝ) < (S_per_loc : ℝ) := lt_of_lt_of_le zero_lt_one hS_loc_ge1
  have ⟨_, _, _, _, _, hd_adm, hp_nn, hp_sum, hp_pos_adm⟩ := hadm_p

  constructor
  · 
    have h_act_s1 : ∀ o d, 0 < p o d →
        let j := win_of o
        (menu j).loc_idx = cutLocalizerIdx ε b_star m_r m_t (r_O o) (V_O o) (X_O o) ∧
        b_star ≤ b_D d ∧
        0 < m_site j o ∧
        generalPacketObsMass ε H_P t lam_sys m_t Φ₀ f (r_O o) (V_O o) (X_O o) (ψ_O o) ≤
          16 * ((S_per_loc : ℝ) ^ 2) * m_site j o := by
      intro o d hpod
      obtain ⟨h1, h2, _, _, h5, h6, _, _⟩ := h_act o d hpod
      exact ⟨h1, h2, h5, h6⟩

    obtain ⟨hπ_nn, hπ_sum, hp_cond_props, h_score_split⟩ :=
      h_s1 γ ε H_P L t h b_star lam_sys m_r m_t N_O N_D N_J S_per_loc
        Φ₀ f r_O V_O X_O ψ_O b_D a_D r_D e_D V_D X_D
        N_ret_of menu win_of p m_site
        hε₀ hε₁ hh hr_pos hS_loc_1 hcard_loc hb_star_nn hsc_lo hmr_le_mt hadm_p h_act_s1

    let p_cond := fun (j : Fin N_J) (o : Fin N_O) (d : Fin N_D) =>
      if win_of o = j ∧ 0 < π_J j then p o d / π_J j else 0
    let K_rem : ℝ :=
      4 * θ + 2 * ξ + (1 / 2 : ℝ) * ζ_sh +
        (3 * Real.log C_coh_tot + 2 * Real.log (M_L : ℝ)) / ell

    have h_per_j : ∀ j : Fin N_J, 0 < π_J j →
        (let p_jO := fun o => ∑ d : Fin N_D, p_cond j o d
         let p_jD := fun d => ∑ o : Fin N_O, p_cond j o d
         (∑ o : Fin N_O, -(p_jO o * Real.log (p_jO o))) / ell +
         (1 / 2 : ℝ) * ((∑ o : Fin N_O, ∑ d : Fin N_D,
           -(p_cond j o d * Real.log (p_cond j o d / p_jD d))) / ell) +
         (3 / 2 : ℝ) * ((∑ o : Fin N_O, p_jO o * Real.log (m_site j o)) / ell) +
         (1 / 2 : ℝ) * (∑ d : Fin N_D, p_jD d * pktWeight γ (b_D d - b_star) (a_D d - b_star))) ≤
        ((∑ α, -(q_T j α * Real.log (q_T j α))) / ell +
         (3 / 2 : ℝ) * (Real.log (menu j).m_bin / ell) +
         (1 / 2 : ℝ) * (
           (∑ d, q_D j d * pktWeight γ (b_D d - b_star) (a_D d - b_star)) +
           (∑ α, ∑ d, -(q_TD j α d * Real.log (q_TD j α d / q_D j d))) / ell +
           2 * ((∑ α, ∑ rl : Fin (2 ^ (m_t - m_r)),
             -(q_TR j α rl * Real.log (q_TR j α rl / q_T j α))) / ell) +
           k_out - (d_dim : ℝ) * h)) + K_rem := by
      intro j hπj
      obtain ⟨hpj_nn, hpj_sum, hpj_supp⟩ := hp_cond_props j hπj
      obtain ⟨hm_bin_j, hQ_sum_j, hZ_sum_j, hQ_card_j, hZ_card_j⟩ := h_coh_j j
      let p_jO := fun o : Fin N_O => ∑ d : Fin N_D, p_cond j o d
      let p_jD := fun d : Fin N_D => ∑ o : Fin N_O, p_cond j o d
      let S_act_p := Finset.univ.filter (fun o : Fin N_O => 0 < p_jO o)
      let S_act_j := Finset.univ.filter (fun o : Fin N_O =>
        win_of o = j ∧ 0 < ∑ d : Fin N_D, p o d)

      have hS_eq : S_act_p = S_act_j := by
        ext o
        simp (config := { decide := false }) only [S_act_p, S_act_j, p_jO,
          Finset.mem_filter, Finset.mem_univ, true_and]
        constructor
        · intro hpos
          obtain ⟨d, _, hd_pos⟩ :=
            (Finset.sum_pos_iff_of_nonneg (fun d _ => hpj_nn o d)).mp hpos
          obtain ⟨hwin, hpod⟩ := hpj_supp o d hd_pos
          exact ⟨hwin, (Finset.sum_pos_iff_of_nonneg (fun d' _ => hp_nn o d')).mpr
            ⟨d, Finset.mem_univ d, hpod⟩⟩
        · rintro ⟨hwin, hpos⟩
          obtain ⟨d, _, hpod⟩ :=
            (Finset.sum_pos_iff_of_nonneg (fun d _ => hp_nn o d)).mp hpos
          refine (Finset.sum_pos_iff_of_nonneg (fun d' _ => hpj_nn o d')).mpr
            ⟨d, Finset.mem_univ d, ?_⟩
          dsimp only [p_cond]
          rw [if_pos ⟨hwin, hπj⟩]
          exact div_pos hpod hπj

      have h_s2_act : ∀ o ∈ S_act_p,
          (Z_of j o).1 = Q_of j o ∧
          (Q_of j o).2.1 = r_O o % 2 ^ (m_t - m_r) ∧
          0 < m_site j o ∧
          (T_cand j (Q_of j o)).Nonempty := by
        rw [hS_eq]
        intro o ho
        rw [Finset.mem_filter] at ho
        obtain ⟨_, hwin, hpos⟩ := ho
        obtain ⟨d, _, hpod⟩ :=
          (Finset.sum_pos_iff_of_nonneg (fun d _ => hp_nn o d)).mp hpos
        obtain ⟨_, _, hZ1, hQ2, hm_pos, _, hTne, _⟩ := h_act o d hpod
        rw [hwin] at hZ1 hQ2 hm_pos hTne
        exact ⟨hZ1, hQ2, hm_pos, hTne⟩

      have h_s2_Qsum : ∀ q, ∑ o ∈ S_act_p.filter (fun o => Q_of j o = q), m_site j o ≤
          C_coh_tot * ε ^ (-ξ) * ((T_cand j q).card : ℝ) * (menu j).m_bin := by
        rw [hS_eq]; exact hQ_sum_j

      have h_s2_Zsum : ∀ z, ∑ o ∈ S_act_p.filter (fun o => Z_of j o = z), m_site j o ≤
          C_coh_tot * ((M_L ^ 4 : ℕ) : ℝ) *
            ε ^ ((d_dim : ℝ) * h - k_out - 2 * θ - 2 * ξ) *
            ((T_cand j z.1).card : ℝ) * (menu j).m_bin := by
        rw [hS_eq]; exact hZ_sum_j

      have h_s2_Qcard : ∀ (α : Fin (N_ret_of j)) (r_loc : ℕ),
          (((S_act_p.image (Q_of j)).filter (fun q =>
            q.2.1 = r_loc ∧ α ∈ T_cand j q)).card : ℝ) ≤ C_coh_tot * ε ^ (-2 * θ) := by
        rw [hS_eq]; exact hQ_card_j

      have h_s2_Zcard : ∀ (α : Fin (N_ret_of j)) (d : Fin N_D),
          0 < p_jD d →
          (((S_act_p.filter (fun o => 0 < p_cond j o d ∧ α ∈ T_cand j (Q_of j o))).image
            (Z_of j)).card : ℝ) ≤ C_coh_tot * ε ^ (-2 * θ - ζ_sh) := by
        intro α d hd_pos
        obtain ⟨o₀, _, ho₀_pos⟩ :=
          (Finset.sum_pos_iff_of_nonneg (fun o _ => hpj_nn o d)).mp hd_pos
        obtain ⟨hwin₀, hpod₀⟩ := hpj_supp o₀ d ho₀_pos
        have ho₀_mem : o₀ ∈ S_act_j := by
          rw [Finset.mem_filter]
          exact ⟨Finset.mem_univ o₀, hwin₀,
            (Finset.sum_pos_iff_of_nonneg (fun d' _ => hp_nn o₀ d')).mpr
              ⟨d, Finset.mem_univ d, hpod₀⟩⟩
        have h_sum_act_pos : 0 < ∑ o ∈ S_act_j, p o d :=
          (Finset.sum_pos_iff_of_nonneg (fun o _ => hp_nn o d)).mpr ⟨o₀, ho₀_mem, hpod₀⟩
        have h_filt_eq :
            S_act_p.filter (fun o => 0 < p_cond j o d ∧ α ∈ T_cand j (Q_of j o)) =
            S_act_j.filter (fun o => 0 < p o d ∧ α ∈ T_cand j (Q_of j o)) := by
          rw [hS_eq]
          refine Finset.filter_congr (fun o ho => ?_)
          rw [Finset.mem_filter] at ho
          have hwin : win_of o = j := ho.2.1
          constructor
          · rintro ⟨hpc, hα⟩
            exact ⟨(hpj_supp o d hpc).2, hα⟩
          · rintro ⟨hpod, hα⟩
            refine ⟨?_, hα⟩
            dsimp only [p_cond]
            rw [if_pos ⟨hwin, hπj⟩]
            exact div_pos hpod hπj
        rw [h_filt_eq]
        exact hZ_card_j α d h_sum_act_pos

      have h_b1 := single_localizer_b1_entropy_cancellation
        ε h ζ_sh ξ θ k_out (menu j).m_bin C_coh_tot
        d_dim M_L m_r m_t N_O N_D (N_ret_of j)
        r_O (p_cond j) (Q_of j) (Z_of j) (T_cand j) (m_site j)
        hε₀ hε₁ hML_1 hC_coh hm_bin_j hpj_nn hpj_sum
        h_s2_act h_s2_Qsum h_s2_Zsum h_s2_Qcard h_s2_Zcard

      have hq_pt : ∀ (o : Fin N_O) (d : Fin N_D) (α : Fin (N_ret_of j)),
          (if α ∈ T_cand j (Q_of j o) then
            p_cond j o d / ((T_cand j (Q_of j o)).card : ℝ)
           else 0) = q_cand j o d α := by
        intro o d α
        by_cases hα : α ∈ T_cand j (Q_of j o)
        · by_cases hwin : win_of o = j
          · dsimp only [p_cond, q_cand]
            rw [if_pos hα, if_pos ⟨hwin, hπj⟩, if_pos ⟨hwin, hπj, hα⟩]
          · dsimp only [p_cond, q_cand]
            rw [if_pos hα, if_neg (fun h => hwin h.1), zero_div, if_neg (fun h => hwin h.1)]
        · dsimp only [q_cand]
          rw [if_neg hα, if_neg (fun h => hα h.2.2)]

      dsimp only at h_b1
      simp (config := { decide := false }) only [hq_pt] at h_b1
      obtain ⟨hqD_eq, hb1_ineq⟩ := h_b1
      have hqD_eq' : q_D j = p_jD := hqD_eq
      have hb1_ineq' :
          (∑ o : Fin N_O, -(p_jO o * Real.log (p_jO o))) / ell +
          (1 / 2 : ℝ) * ((∑ o : Fin N_O, ∑ d : Fin N_D,
            -(p_cond j o d * Real.log (p_cond j o d / p_jD d))) / ell) +
          (3 / 2 : ℝ) * ((∑ o : Fin N_O, p_jO o * Real.log (m_site j o)) / ell) ≤
          (∑ α, -(q_T j α * Real.log (q_T j α))) / ell +
          (3 / 2 : ℝ) * (Real.log (menu j).m_bin / ell) +
          (1 / 2 : ℝ) * (
            (∑ α, ∑ d, -(q_TD j α d * Real.log (q_TD j α d / q_D j d))) / ell +
            2 * ((∑ α, ∑ rl : Fin (2 ^ (m_t - m_r)),
              -(q_TR j α rl * Real.log (q_TR j α rl / q_T j α))) / ell) +
            k_out - (d_dim : ℝ) * h) +
          4 * θ + 2 * ξ + (1 / 2 : ℝ) * ζ_sh +
          (3 * Real.log C_coh_tot + 2 * Real.log (M_L : ℝ)) / ell := hb1_ineq
      have h_w_eq : (∑ d : Fin N_D, p_jD d * pktWeight γ (b_D d - b_star) (a_D d - b_star)) =
          ∑ d : Fin N_D, q_D j d * pktWeight γ (b_D d - b_star) (a_D d - b_star) := by
        rw [← hqD_eq']
      dsimp only [K_rem]
      change (∑ o : Fin N_O, -(p_jO o * Real.log (p_jO o))) / ell +
          (1 / 2 : ℝ) * ((∑ o : Fin N_O, ∑ d : Fin N_D,
            -(p_cond j o d * Real.log (p_cond j o d / p_jD d))) / ell) +
          (3 / 2 : ℝ) * ((∑ o : Fin N_O, p_jO o * Real.log (m_site j o)) / ell) +
          (1 / 2 : ℝ) * (∑ d : Fin N_D, p_jD d * pktWeight γ (b_D d - b_star) (a_D d - b_star)) ≤ _
      linarith only [hb1_ineq', h_w_eq]

    have h_sum_j :
        (∑ j : Fin N_J, if 0 < π_J j then π_J j * (
          let p_jO := fun o => ∑ d : Fin N_D, p_cond j o d
          let p_jD := fun d => ∑ o : Fin N_O, p_cond j o d
          (∑ o : Fin N_O, -(p_jO o * Real.log (p_jO o))) / ell +
          (1 / 2 : ℝ) * ((∑ o : Fin N_O, ∑ d : Fin N_D,
            -(p_cond j o d * Real.log (p_cond j o d / p_jD d))) / ell) +
          (3 / 2 : ℝ) * ((∑ o : Fin N_O, p_jO o * Real.log (m_site j o)) / ell) +
          (1 / 2 : ℝ) * (∑ d : Fin N_D, p_jD d * pktWeight γ (b_D d - b_star) (a_D d - b_star)))
         else 0) ≤
        (∑ j : Fin N_J, if 0 < π_J j then π_J j * (
          (∑ α, -(q_T j α * Real.log (q_T j α))) / ell +
          (3 / 2 : ℝ) * (Real.log (menu j).m_bin / ell) +
          (1 / 2 : ℝ) * (
            (∑ d, q_D j d * pktWeight γ (b_D d - b_star) (a_D d - b_star)) +
            (∑ α, ∑ d, -(q_TD j α d * Real.log (q_TD j α d / q_D j d))) / ell +
            2 * ((∑ α, ∑ rl : Fin (2 ^ (m_t - m_r)),
              -(q_TR j α rl * Real.log (q_TR j α rl / q_T j α))) / ell) +
            k_out - (d_dim : ℝ) * h))
         else 0) + K_rem := by
      have h_K_sum : (∑ j : Fin N_J, if 0 < π_J j then π_J j * K_rem else 0) = K_rem := by
        have h1 : ∀ j : Fin N_J,
            (if 0 < π_J j then π_J j * K_rem else 0) = π_J j * K_rem := by
          intro j
          by_cases h0 : π_J j = 0
          · rw [h0, if_neg (lt_irrefl 0), zero_mul]
          · rw [if_pos (lt_of_le_of_ne (hπ_nn j) (Ne.symm h0))]
        rw [Finset.sum_congr rfl (fun j _ => h1 j), ← Finset.sum_mul, hπ_sum, one_mul]
      rw [← h_K_sum, ← Finset.sum_add_distrib]
      refine Finset.sum_le_sum (fun j _ => ?_)
      by_cases h0 : π_J j = 0
      · rw [h0, if_neg (lt_irrefl 0), if_neg (lt_irrefl 0), if_neg (lt_irrefl 0), add_zero]
      · have hpos : 0 < π_J j := lt_of_le_of_ne (hπ_nn j) (Ne.symm h0)
        rw [if_pos hpos, if_pos hpos, if_pos hpos, ← mul_add]
        exact mul_le_mul_of_nonneg_left (h_per_j j hpos) hpos.le

    have h_const_div :
        C_split / ell + (3 * Real.log C_coh_tot + 2 * Real.log (M_L : ℝ)) / ell ≤
          C_ent_info / ell := by
      rw [← add_div]
      have hnum : C_split + (3 * Real.log C_coh_tot + 2 * Real.log (M_L : ℝ)) ≤ C_ent_info := by
        linarith only [hC_ent_left]
      exact div_le_div_of_nonneg_right hnum hell_pos.le

    have h_score_split' :
        generalPacketScore ε γ H_P t lam_sys m_t Φ₀ f N_O N_D r_O V_O X_O ψ_O b_D a_D p ≤
          H_J + b_star +
          (∑ j : Fin N_J, if 0 < π_J j then π_J j * (
            let p_jO := fun o => ∑ d : Fin N_D, p_cond j o d
            let p_jD := fun d => ∑ o : Fin N_O, p_cond j o d
            (∑ o : Fin N_O, -(p_jO o * Real.log (p_jO o))) / ell +
            (1 / 2 : ℝ) * ((∑ o : Fin N_O, ∑ d : Fin N_D,
              -(p_cond j o d * Real.log (p_cond j o d / p_jD d))) / ell) +
            (3 / 2 : ℝ) * ((∑ o : Fin N_O, p_jO o * Real.log (m_site j o)) / ell) +
            (1 / 2 : ℝ) * (∑ d : Fin N_D, p_jD d * pktWeight γ (b_D d - b_star) (a_D d - b_star)))
           else 0) +
          (7 / 2 : ℝ) * (Real.log (S_per_loc : ℝ) / ell) + C_split / ell :=
      h_score_split

    dsimp only [K_rem] at h_sum_j
    linarith only [h_score_split', h_sum_j, h_const_div]

  · 
    let F_of : ∀ j : Fin N_J, Fin N_O → Fin (N_ret_of j) → ℕ × (ℤ × ℤ) × (ℤ × ℤ) :=
      fun j o α => F_T_fn j (r_O o % 2 ^ (m_t - m_r)) α
    have hT_ne : ∀ o d, 0 < p o d → (T_cand (win_of o) (Q_of (win_of o) o)).Nonempty := by
      intro o d hpod
      exact (h_act o d hpod).2.2.2.2.2.2.1

    obtain ⟨hI_nn, hI_lb⟩ :=
      assembled_cmi_lower_bound_of_fiber_lists ε hε₀ hε₁ N_O N_D N_J N_ret_of
        win_of p Q_of T_cand F_of hp_nn hp_sum hT_ne

    rcases h_Hin with h_le0 | ⟨L_grid, τ_Vf, τ_Xf, P_f, n_f, W_f,
        hL1, hL4, hnf_unit, hPf_props, h_align, h_apert, hHin_ent⟩
    · have hlog_S_nn : 0 ≤ Real.log (S_per_loc : ℝ) / ell :=
        div_nonneg (Real.log_nonneg hS_loc_ge1) hell_pos.le
      have hCent_div_nn : 0 ≤ C_ent_info / ell :=
        div_nonneg hC_ent_nn hell_pos.le
      have hI_nn' : 0 ≤ I_TD_FTJ := hI_nn
      linarith only [h_le0, hθ_pos, hζ_sh, hlog_S_nn, hCent_div_nn, hI_nn']
    · have h_eD_unit : ∀ d : Fin N_D, ‖e_D d‖ = 1 :=
        fun d => (hd_adm d).2.2.2.2
      have h_VD_proj : ∀ o d, 0 < p o d →
          |inner ℝ (V_O o - V_D d) (e_D d)| ≤ cls.B_sys * ε ^ (b_D d) ∧
          |inner ℝ (V_O o - V_D d) (perp2D (e_D d))| ≤ cls.B_sys * ε ^ (a_D d) := by
        intro o d hpod
        obtain ⟨_, _, hv1, hv2, _, _⟩ := hp_pos_adm o d hpod
        exact ⟨hv1, hv2⟩
      have h_act_s4 : ∀ o d, 0 < p o d →
          let j := win_of o
          (menu j).loc_idx = cutLocalizerIdx ε b_star m_r m_t (r_O o) (V_O o) (X_O o) ∧
          (∀ α ∈ T_cand j (Q_of j o),
            ‖gridPt2D ρ_r ((menu j).o_at α).1 - V_O o‖ ≤
              (2 * (M_L : ℝ) + 4) * ε ^ ((H_P - t) / 2) ∧
            ‖(gridPt2D σ_r ((menu j).o_at α).2 +
                (((r_O o : ℝ) + 1 / 2) * ((2 : ℝ) ^ m_t)⁻¹ -
                  (((menu j).loc_idx.1 : ℝ) + 1 / 2) * s_c) •
                  gridPt2D ρ_r ((menu j).o_at α).1) - X_O o‖ ≤
              (8 * C_cov * cls.B_sys + 16) * (ε ^ (-θ)) * s_x * ε ^ (u + h)) := by
        intro o d hpod
        obtain ⟨h1, _, _, _, _, _, _, h8⟩ := h_act o d hpod
        exact ⟨h1, h8⟩

      obtain ⟨h_card_FTJ, h_card_TW, h_card_DW⟩ :=
        h_s4 ε H_P t b_star lam_sys L_grid m_r m_t N_O N_D N_J S_per_loc
          τ_Vf τ_Xf r_O V_O X_O b_D a_D e_D V_D
          N_ret_of menu win_of p Q_of T_cand P_f n_f W_f
          hε₀ hε₁ hr_pos ht_HP hS_loc_1 hcard_loc hb_star_nn hu_ge
          hsc_lo hsc_hi hmr_le_mt hp_nn h_eD_unit h_VD_proj h_act_s4
          hL1 hL4 hnf_unit hPf_props h_align h_apert

      let B_FTJ : ℝ := C_geom * (S_per_loc : ℝ) * ε ^ (-2 * θ)
      let B_TW : ℝ := C_geom * ε ^ (-2 * θ)
      let B_DW : ℝ := C_geom * ε ^ (-2 * θ - ζ_sh)
      have hε_rpow1 : 0 < ε ^ (-2 * θ) := Real.rpow_pos_of_pos hε₀ _
      have hε_rpow2 : 0 < ε ^ (-2 * θ - ζ_sh) := Real.rpow_pos_of_pos hε₀ _
      have hB_FTJ_pos : 0 < B_FTJ := mul_pos (mul_pos hC_geom_pos hS_loc_pos) hε_rpow1
      have hB_TW_pos : 0 < B_TW := mul_pos hC_geom_pos hε_rpow1
      have hB_DW_pos : 0 < B_DW := mul_pos hC_geom_pos hε_rpow2

      have h_cmi_bound :
          (let p_O := fun o => ∑ d : Fin N_D, p o d
           let p_P := fun p_c => ∑ o ∈ Finset.univ.filter (fun o => P_f o = p_c), p_O o
           let p_PW := fun p_c w =>
             ∑ o ∈ Finset.univ.filter (fun o => P_f o = p_c ∧ W_f o = w), p_O o
           (∑ p_c ∈ Finset.univ.image P_f, ∑ w ∈ Finset.univ.image W_f,
             -(p_PW p_c w * Real.log (p_PW p_c w / p_P p_c))) / ell) -
          (Real.log B_FTJ + Real.log B_TW + Real.log B_DW) / ell ≤ I_TD_FTJ :=
        hI_lb P_f W_f B_FTJ B_TW B_DW hB_FTJ_pos hB_TW_pos hB_DW_pos
          h_card_FTJ h_card_TW h_card_DW

      have hlog_ε : Real.log ε = -ell := by
        dsimp only [ell]
        rw [Real.log_inv]
        ring
      have hlog_FTJ :
          Real.log B_FTJ = Real.log C_geom + Real.log (S_per_loc : ℝ) + 2 * θ * ell := by
        dsimp only [B_FTJ]
        rw [Real.log_mul (mul_pos hC_geom_pos hS_loc_pos).ne' hε_rpow1.ne',
          Real.log_mul hC_geom_pos.ne' hS_loc_pos.ne', Real.log_rpow hε₀, hlog_ε]
        ring
      have hlog_TW : Real.log B_TW = Real.log C_geom + 2 * θ * ell := by
        dsimp only [B_TW]
        rw [Real.log_mul hC_geom_pos.ne' hε_rpow1.ne', Real.log_rpow hε₀, hlog_ε]
        ring
      have hlog_DW : Real.log B_DW = Real.log C_geom + (2 * θ + ζ_sh) * ell := by
        dsimp only [B_DW]
        rw [Real.log_mul hC_geom_pos.ne' hε_rpow2.ne', Real.log_rpow hε₀, hlog_ε]
        ring
      have hlog_tot :
          (Real.log B_FTJ + Real.log B_TW + Real.log B_DW) / ell =
            6 * θ + ζ_sh + Real.log (S_per_loc : ℝ) / ell + (3 * Real.log C_geom) / ell := by
        rw [hlog_FTJ, hlog_TW, hlog_DW]
        have hsplit :
            (Real.log C_geom + Real.log (S_per_loc : ℝ) + 2 * θ * ell +
              (Real.log C_geom + 2 * θ * ell) +
              (Real.log C_geom + (2 * θ + ζ_sh) * ell)) / ell =
            (6 * θ + ζ_sh) * (ell / ell) + Real.log (S_per_loc : ℝ) / ell +
              (3 * Real.log C_geom) / ell := by ring
        rw [hsplit, div_self hell_pos.ne']
        ring
      have hgeom_div : (3 * Real.log C_geom) / ell ≤ C_ent_info / ell :=
        div_le_div_of_nonneg_right hC_ent_right hell_pos.le
      linarith only [hHin_ent, h_cmi_bound, hlog_tot, hgeom_div]

theorem resampled_faithful_aperture_classical_bound (γ : ℝ) (hγ₀ : 0 < γ) (hγ₁ : γ < 1)
    (M_atom : ℝ → ℝ → ℝ → ℝ → ℝ → ℕ → ℝ)
    (h_cl : ClassicalLineGrowthBound γ)
    (cls : PacketBoundClass) (h u_min ζ_sh ξ C_cov e_rep : ℝ)
    (d_dim M_L M_mult : ℕ) (C_tr : ℕ → ℝ)
    (hh : 0 < h) (hu_min : (3 / 2 : ℝ) * h ≤ u_min)
    (hζ_sh : 0 < ζ_sh) (hξ : 0 < ξ) (hC_cov : 2 ≤ C_cov)
    (hd_dim : d_dim = 1 ∨ d_dim = 2) (hML_64 : 64 ≤ M_L)
    (hM_mult : 1 ≤ M_mult) (hC_tr : ∀ M, 0 ≤ C_tr M) (he_rep : 0 < e_rep) :
    let θ := min (h / 64) (e_rep / 256)
    ∃ (C_cl_info : ℝ) (ε_cl : ℝ),
      0 ≤ C_cl_info ∧ 0 < ε_cl ∧ ε_cl < 1 / 2 ∧
      ∀ (ε H_P L t b_star lam_sys : ℝ) (m_r m_t N_O N_D N_J : ℕ)
        (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
        (r_O : Fin N_O → ℕ) (V_O X_O : Fin N_O → EuclideanSpace ℝ (Fin 2))
        (b_D a_D : Fin N_D → ℝ) (r_D : Fin N_D → ℕ)
        (e_D V_D X_D : Fin N_D → EuclideanSpace ℝ (Fin 2))
        (N_ret_of : Fin N_J → ℕ)
        (menu : ∀ j : Fin N_J, LocalizerSubclass (N_ret_of j))
        (π_J : Fin N_J → ℝ)
        (q_cand : ∀ j : Fin N_J, Fin N_O → Fin N_D → Fin (N_ret_of j) → ℝ),
        letI := Classical.propDecidable
        let r := t - 2 * h
        let ell := Real.log (ε⁻¹)
        let u := (H_P - t) / 2 - b_star
        let s_c := ((2 : ℝ) ^ m_r)⁻¹
        let s_v := ε ^ b_star
        let s_x := s_c * s_v
        let ρ_r := ε ^ ((H_P - r) / 2)
        let σ_r := (lam_sys * ρ_r)⁻¹
        let F_T_fn : ∀ j : Fin N_J, ℕ → Fin (N_ret_of j) → ℕ × (ℤ × ℤ) × (ℤ × ℤ) :=
          fun j r_loc α =>
            let V_J := gridPt2D s_v (menu j).loc_idx.2.1
            let X_J := gridPt2D s_x (menu j).loc_idx.2.2
            let V'_α := s_v⁻¹ • (gridPt2D ρ_r ((menu j).o_at α).1 - V_J)
            let X'_α := s_x⁻¹ • (gridPt2D σ_r ((menu j).o_at α).2 - X_J)
            let c_end := ((r_loc : ℝ) + 1 / 2) * ((2 : ℝ) ^ (m_t - m_r))⁻¹
            (r_loc,
             roundShift2D (ε ^ (u - h)) 0 V'_α,
             roundShift2D (ε ^ (u + h)) 0 (X'_α + (c_end - 1 / 2) • V'_α))
        0 < ε → ε < ε_cl → 0 < r → t ≤ 1 → t ≤ L → t ≤ H_P → H_P ≤ cls.K_hor → L ≤ cls.K_hor →
        0 ≤ b_star → u_min ≤ u → u + h ≤ L - r - b_star →
        (d_dim = 2 → b_star = 0) →
        m_r = Nat.floor (r * ell / Real.log 2) → m_r ≤ m_t →
        cls.B_sys⁻¹ * ε ^ (-H_P) ≤ lam_sys → lam_sys ≤ cls.B_sys * ε ^ (-H_P) →
        cls.B_sys⁻¹ * ε ^ t ≤ ((2 : ℝ) ^ m_t)⁻¹ → ((2 : ℝ) ^ m_t)⁻¹ ≤ cls.B_sys * ε ^ t →
        (∀ j : Fin N_J, 0 ≤ π_J j) → (∑ j : Fin N_J, π_J j = 1) →
        (∀ j : Fin N_J, 0 < π_J j →
          IsValidSubclassAtoms cls M_atom γ ε H_P L t r b_star lam_sys ξ C_cov
            m_r m_t M_mult C_tr Φ₀ (menu j) ∧
          (∀ o d α, 0 ≤ q_cand j o d α) ∧
          (∑ o, ∑ d, ∑ α, q_cand j o d α = 1) ∧
          (∀ o d α, 0 < q_cand j o d α →
            r_O o < 2 ^ m_t ∧ r_O o = r_D d ∧
            cutLocalizerIdx ε b_star m_r m_t (r_O o) (V_O o) (X_O o) = (menu j).loc_idx ∧
            0 ≤ b_D d ∧ b_star ≤ b_D d ∧ b_D d ≤ a_D d ∧ a_D d ≤ (H_P - t) / 2 ∧
            ‖e_D d‖ = 1 ∧
            (d_dim = 1 → |b_D d - b_star| ≤ ζ_sh) ∧
            |(H_P - t) / 2 - a_D d| ≤ ζ_sh ∧
            (d_dim = 2 → b_D d = (H_P - t) / 2 ∧ a_D d = (H_P - t) / 2) ∧
            |inner ℝ (V_O o - V_D d) (e_D d)| ≤ cls.B_sys * ε ^ (b_D d) ∧
            |inner ℝ (V_O o - V_D d) (perp2D (e_D d))| ≤ cls.B_sys * ε ^ (a_D d) ∧
            |inner ℝ (X_O o - X_D d) (e_D d)| ≤ cls.B_sys * ε ^ (b_D d + t) ∧
            |inner ℝ (X_O o - X_D d) (perp2D (e_D d))| ≤ cls.B_sys * ε ^ (a_D d + t) ∧
            ‖gridPt2D ρ_r ((menu j).o_at α).1 - V_O o‖ ≤
              (2 * (M_L : ℝ) + 4) * ε ^ ((H_P - t) / 2) ∧
            ‖(gridPt2D σ_r ((menu j).o_at α).2 +
                (((r_O o : ℝ) + 1 / 2) * ((2 : ℝ) ^ m_t)⁻¹ -
                  (((menu j).loc_idx.1 : ℝ) + 1 / 2) * s_c) •
                  gridPt2D ρ_r ((menu j).o_at α).1) - X_O o‖ ≤
              (8 * C_cov * cls.B_sys + 16) * (ε ^ (-θ)) * s_x * ε ^ (u + h))) →
        let q_T := fun j α => ∑ o, ∑ d, q_cand j o d α
        let q_TD := fun j α d => ∑ o, q_cand j o d α
        let q_D := fun j d => ∑ o, ∑ α, q_cand j o d α
        let q_TR := fun j α (rl : Fin (2 ^ (m_t - m_r))) =>
          ∑ o ∈ Finset.univ.filter (fun o => r_O o % 2 ^ (m_t - m_r) = rl.1),
            ∑ d, q_cand j o d α
        let π_FTJ := fun j (ft : ℕ × (ℤ × ℤ) × (ℤ × ℤ)) =>
          ∑ o, ∑ d, ∑ α ∈ Finset.univ.filter (fun α => F_T_fn j (r_O o % 2 ^ (m_t - m_r)) α = ft),
            π_J j * q_cand j o d α
        let π_TFTJ := fun j ft α =>
          ∑ o, ∑ d, if F_T_fn j (r_O o % 2 ^ (m_t - m_r)) α = ft then π_J j * q_cand j o d α else 0
        let π_DFTJ := fun j ft d =>
          ∑ o, ∑ α ∈ Finset.univ.filter (fun α => F_T_fn j (r_O o % 2 ^ (m_t - m_r)) α = ft),
            π_J j * q_cand j o d α
        let π_TDFTJ := fun j ft α d =>
          ∑ o, if F_T_fn j (r_O o % 2 ^ (m_t - m_r)) α = ft then π_J j * q_cand j o d α else 0
        let S_FT : Fin N_J → Finset (ℕ × (ℤ × ℤ) × (ℤ × ℤ)) := fun j =>
          (Finset.univ ×ˢ Finset.univ).image (fun oα : Fin N_O × Fin (N_ret_of j) =>
            F_T_fn j (r_O oα.1 % 2 ^ (m_t - m_r)) oα.2)
        let I_TD_FTJ : ℝ :=
          (∑ j : Fin N_J, ∑ ft ∈ S_FT j, ∑ α : Fin (N_ret_of j), ∑ d : Fin N_D,
            if 0 < π_FTJ j ft then
              π_TDFTJ j ft α d * Real.log ((π_TDFTJ j ft α d * π_FTJ j ft) /
                (π_TFTJ j ft α * π_DFTJ j ft d))
            else 0) / ell
        (∑ j : Fin N_J, if 0 < π_J j then π_J j * (
          (∑ d, q_D j d * pktWeight γ (b_D d - b_star) (a_D d - b_star)) +
          (∑ α, ∑ d, -(q_TD j α d * Real.log (q_TD j α d / q_D j d))) / ell +
          2 * ((∑ α, ∑ rl : Fin (2 ^ (m_t - m_r)),
            -(q_TR j α rl * Real.log (q_TR j α rl / q_T j α))) / ell))
         else 0) ≤
        (∑ j : Fin N_J, π_J j * (menu j).g_bin) +
        ((d_dim : ℝ) + 2 * γ) * h - I_TD_FTJ +
        2 * θ + 4 * ζ_sh + 2 * ξ + e_rep / 32 + C_cl_info / ell :=
by
  intro θ
  
  
  
  have h_ell_pos : ∀ {ε : ℝ}, 0 < ε → ε < 1 / 2 → 0 < Real.log (ε⁻¹) := by
    intro ε hε₀ hε₁
    exact Real.log_pos ((one_lt_inv₀ hε₀).mpr (by linarith only [hε₁]))

  have h_card_cond_ent : ∀ {α : Type} [Fintype α] (S : Finset α) (u : α → ℝ) (U B : ℝ),
      (∀ i, 0 ≤ u i) → (∑ i : α, u i = U) → (∀ i, 0 < u i → i ∈ S) →
      0 < B → (0 < U → (S.card : ℝ) ≤ B) →
      (∑ i : α, -(u i * Real.log (u i / U))) ≤ U * Real.log B := by
    intro α _ S u U B hu_nn hU hsupp hB_pos hcard
    have hU_nn : 0 ≤ U := by rw [← hU]; exact Finset.sum_nonneg (fun i _ => hu_nn i)
    by_cases hU0 : U = 0
    · have hu0 : ∀ i : α, u i = 0 := fun i =>
        (Finset.sum_eq_zero_iff_of_nonneg (fun j _ => hu_nn j)).mp (hU.trans hU0) i
          (Finset.mem_univ i)
      simp [hU0, hu0]
    · have hU_pos : 0 < U := lt_of_le_of_ne hU_nn (Ne.symm hU0)
      have hzero_out : ∀ i ∈ (Finset.univ : Finset α), i ∉ S → u i = 0 := by
        intro i _ hiS
        by_contra hne
        exact hiS (hsupp i (lt_of_le_of_ne (hu_nn i) (Ne.symm hne)))
      have hU_S : ∑ i ∈ S, u i = U :=
        (Finset.sum_subset (Finset.subset_univ S) hzero_out).trans hU
      have hent_S : (∑ i ∈ S, -(u i * Real.log (u i / U))) =
          ∑ i : α, -(u i * Real.log (u i / U)) :=
        Finset.sum_subset (Finset.subset_univ S)
          (fun i hi hiS => by simp [hzero_out i hi hiS])
      rw [← hent_S]
      have hpt : ∀ i ∈ S,
          -(u i * Real.log (u i / U)) - u i * Real.log B ≤ U / B - u i := by
        intro i _
        by_cases hui0 : u i = 0
        · simp only [hui0, zero_div, zero_mul, neg_zero, sub_zero]
          exact div_nonneg hU_nn hB_pos.le
        · have hui_pos : 0 < u i := lt_of_le_of_ne (hu_nn i) (Ne.symm hui0)
          let x := (U / B) / u i
          have hx_pos : 0 < x := div_pos (div_pos hU_pos hB_pos) hui_pos
          have hlog : Real.log x = -Real.log (u i / U) - Real.log B := by
            dsimp only [x]
            rw [Real.log_div (div_pos hU_pos hB_pos).ne' hui_pos.ne',
              Real.log_div hU_pos.ne' hB_pos.ne',
              Real.log_div hui_pos.ne' hU_pos.ne']
            ring
          have h1 := mul_le_mul_of_nonneg_left (Real.log_le_sub_one_of_pos hx_pos) hui_pos.le
          have hlhs : u i * Real.log x = -(u i * Real.log (u i / U)) - u i * Real.log B := by
            rw [hlog]; ring
          have hrhs : u i * (x - 1) = U / B - u i := by
            dsimp only [x]
            rw [mul_sub, mul_one, mul_div_cancel₀ _ hui_pos.ne']
          rwa [hlhs, hrhs] at h1
      have hsum := Finset.sum_le_sum hpt
      rw [Finset.sum_sub_distrib, ← Finset.sum_mul, hU_S,
        Finset.sum_sub_distrib, Finset.sum_const, nsmul_eq_mul, hU_S] at hsum
      have hcard_mul : (S.card : ℝ) * (U / B) ≤ U := by
        calc (S.card : ℝ) * (U / B) ≤ B * (U / B) :=
              mul_le_mul_of_nonneg_right (hcard hU_pos) (div_nonneg hU_nn hB_pos.le)
          _ = U := mul_div_cancel₀ U hB_pos.ne'
      linarith only [hsum, hcard_mul]

  have h_log_sum : ∀ {α : Type} [Fintype α] (a b : α → ℝ),
      (∀ i, 0 ≤ a i) → (∀ i, 0 ≤ b i) → (∀ i, 0 < a i → 0 < b i) →
      (∑ i : α, -(a i * Real.log (a i / b i))) ≤
        -((∑ i : α, a i) * Real.log ((∑ i : α, a i) / (∑ i : α, b i))) := by
    intro α _ a b ha_nn hb_nn hab_pos
    let A := ∑ i : α, a i
    let B := ∑ i : α, b i
    change (∑ i : α, -(a i * Real.log (a i / b i))) ≤ -(A * Real.log (A / B))
    have hA_nn : 0 ≤ A := Finset.sum_nonneg (fun i _ => ha_nn i)
    by_cases hA0 : A = 0
    · have ha0 : ∀ i : α, a i = 0 := fun i =>
        (Finset.sum_eq_zero_iff_of_nonneg (fun j _ => ha_nn j)).mp hA0 i (Finset.mem_univ i)
      simp [hA0, ha0]
    · have hA_pos : 0 < A := lt_of_le_of_ne hA_nn (Ne.symm hA0)
      obtain ⟨i₀, _, hai₀⟩ :=
        (Finset.sum_pos_iff_of_nonneg (fun j _ => ha_nn j)).mp hA_pos
      have hB_pos : 0 < B :=
        lt_of_lt_of_le (hab_pos i₀ hai₀)
          (Finset.single_le_sum (fun j _ => hb_nn j) (Finset.mem_univ i₀))
      have hpt : ∀ i ∈ (Finset.univ : Finset α),
          -(a i * Real.log (a i / b i)) + a i * Real.log (A / B) ≤ A * (b i / B) - a i := by
        intro i _
        by_cases hai0 : a i = 0
        · simp only [hai0, zero_div, zero_mul, neg_zero, add_zero, sub_zero]
          exact mul_nonneg hA_nn (div_nonneg (hb_nn i) hB_pos.le)
        · have hai_pos : 0 < a i := lt_of_le_of_ne (ha_nn i) (Ne.symm hai0)
          have hbi_pos : 0 < b i := hab_pos i hai_pos
          let x := (A / B) / (a i / b i)
          have hx_pos : 0 < x := div_pos (div_pos hA_pos hB_pos) (div_pos hai_pos hbi_pos)
          have hlog : Real.log x = Real.log (A / B) - Real.log (a i / b i) :=
            Real.log_div (div_pos hA_pos hB_pos).ne' (div_pos hai_pos hbi_pos).ne'
          have h1 := mul_le_mul_of_nonneg_left (Real.log_le_sub_one_of_pos hx_pos) hai_pos.le
          have hlhs : a i * Real.log x =
              -(a i * Real.log (a i / b i)) + a i * Real.log (A / B) := by
            rw [hlog]; ring
          have hrhs : a i * (x - 1) = A * (b i / B) - a i := by
            dsimp only [x]
            field_simp [hai_pos.ne', hbi_pos.ne', hB_pos.ne']
          rwa [hlhs, hrhs] at h1
      have hsum := Finset.sum_le_sum hpt
      have hA_def : ∑ i : α, a i = A := rfl
      have hB_def : ∑ i : α, b i = B := rfl
      rw [Finset.sum_add_distrib, ← Finset.sum_mul, hA_def,
        Finset.sum_sub_distrib, ← Finset.mul_sum, ← Finset.sum_div, hB_def, hA_def,
        div_self hB_pos.ne', mul_one, sub_self] at hsum
      linarith only [hsum]

  
  
  
  let u_vec : EuclideanSpace ℝ (Fin 2) := PiLp.single 2 (0 : Fin 2) (1 : ℝ)
  have hu_vec : ‖u_vec‖ = 1 := by simp [u_vec]

  have h_perp_orth : ∀ e : EuclideanSpace ℝ (Fin 2),
      inner ℝ e (perp2D e) = 0 ∧ inner ℝ (perp2D e) e = 0 ∧ ‖perp2D e‖ = ‖e‖ := by
    intro e
    have h1 : inner ℝ e (perp2D e) = 0 := by
      rw [PiLp.inner_apply, Fin.sum_univ_two]; simp [perp2D]; ring
    have h2 : inner ℝ (perp2D e) e = 0 := by rw [real_inner_comm, h1]
    have h3 : ‖perp2D e‖ = ‖e‖ := by
      have hsq : ‖perp2D e‖ ^ 2 = ‖e‖ ^ 2 := by
        rw [EuclideanSpace.norm_sq_eq, EuclideanSpace.norm_sq_eq, Fin.sum_univ_two, Fin.sum_univ_two]
        simp [perp2D, Real.norm_eq_abs, sq_abs]; ring
      nlinarith [norm_nonneg (perp2D e), norm_nonneg e, hsq]
    exact ⟨h1, h2, h3⟩

  have h_perp_sub : ∀ e₁ e₂ : EuclideanSpace ℝ (Fin 2),
      perp2D (e₁ - e₂) = perp2D e₁ - perp2D e₂ := by
    intro e₁ e₂
    ext i
    fin_cases i <;> simp [perp2D] <;> ring

  have h_norm_le_proj : ∀ (z e : EuclideanSpace ℝ (Fin 2)), ‖e‖ = 1 →
      ‖z‖ ≤ |inner ℝ z e| + |inner ℝ z (perp2D e)| := by
    intro z e he
    have he_sq : e 0 ^ 2 + e 1 ^ 2 = 1 := by
      have h1 : ‖e‖ ^ 2 = 1 := by rw [he]; norm_num
      rw [EuclideanSpace.norm_sq_eq, Fin.sum_univ_two] at h1
      simpa [Real.norm_eq_abs, sq_abs] using h1
    have hz_sq : ‖z‖ ^ 2 = z 0 ^ 2 + z 1 ^ 2 := by
      rw [EuclideanSpace.norm_sq_eq, Fin.sum_univ_two]
      simp [Real.norm_eq_abs, sq_abs]
    have hin1 : inner ℝ z e = z 0 * e 0 + z 1 * e 1 := by
      rw [PiLp.inner_apply, Fin.sum_univ_two]; simp [mul_comm]
    have hin2 : inner ℝ z (perp2D e) = -(z 0 * e 1) + z 1 * e 0 := by
      rw [PiLp.inner_apply, Fin.sum_univ_two]; simp [perp2D]; ring
    have h_ident : ‖z‖ ^ 2 = (inner ℝ z e) ^ 2 + (inner ℝ z (perp2D e)) ^ 2 := by
      rw [hz_sq, hin1, hin2]
      calc z 0 ^ 2 + z 1 ^ 2 = (z 0 ^ 2 + z 1 ^ 2) * 1 := (mul_one _).symm
        _ = (z 0 ^ 2 + z 1 ^ 2) * (e 0 ^ 2 + e 1 ^ 2) := by rw [he_sq]
        _ = (z 0 * e 0 + z 1 * e 1) ^ 2 + (-(z 0 * e 1) + z 1 * e 0) ^ 2 := by ring
    have h_sq_le : ‖z‖ ^ 2 ≤ (|inner ℝ z e| + |inner ℝ z (perp2D e)|) ^ 2 := by
      rw [h_ident]
      have h_abs1 : |inner ℝ z e| ^ 2 = (inner ℝ z e) ^ 2 := sq_abs _
      have h_abs2 : |inner ℝ z (perp2D e)| ^ 2 = (inner ℝ z (perp2D e)) ^ 2 := sq_abs _
      have h_prod : 0 ≤ |inner ℝ z e| * |inner ℝ z (perp2D e)| := by positivity
      nlinarith only [h_abs1, h_abs2, h_prod]
    have habs := sq_le_sq.mp h_sq_le
    rwa [abs_of_nonneg (norm_nonneg z), abs_of_nonneg (by positivity)] at habs

  have h_floor_err_1d : ∀ (s x : ℝ), 0 < s → |x - (Int.floor (x / s) : ℝ) * s| ≤ s := by
    intro s x hs
    have h1 : (Int.floor (x / s) : ℝ) ≤ x / s := Int.floor_le (x / s)
    have h2 : x / s < (Int.floor (x / s) : ℝ) + 1 := Int.lt_floor_add_one (x / s)
    have hlo : (Int.floor (x / s) : ℝ) * s ≤ x := (le_div_iff₀ hs).mp h1
    have hhi : x ≤ (Int.floor (x / s) : ℝ) * s + s := by
      have h2' := (div_lt_iff₀ hs).mp h2
      linarith only [h2']
    exact abs_le.mpr ⟨by linarith only [hlo, hs], by linarith only [hhi]⟩

  have h_round2D_err : ∀ (s : ℝ) (v : EuclideanSpace ℝ (Fin 2)), 0 < s →
      ‖v - gridPt2D s (roundShift2D s 0 v)‖ ≤ 2 * s := by
    intro s v hs
    have h_coord : ∀ x : ℝ, (x - s * (Int.floor ((x - 0) / s) : ℝ)) ^ 2 ≤ s ^ 2 := by
      intro x
      rw [sub_zero, mul_comm s]
      have habs := h_floor_err_1d s x hs
      exact sq_le_sq.mpr (by rwa [abs_of_pos hs])
    have h_norm_sq : ‖v - gridPt2D s (roundShift2D s 0 v)‖ ^ 2 ≤ (2 * s) ^ 2 := by
      rw [EuclideanSpace.norm_sq_eq, Fin.sum_univ_two]
      have hc0 : ‖(v - gridPt2D s (roundShift2D s 0 v)) 0‖ ^ 2 =
          (v 0 - s * (Int.floor ((v 0 - 0) / s) : ℝ)) ^ 2 := by
        simp [gridPt2D, roundShift2D, Real.norm_eq_abs, sq_abs]
      have hc1 : ‖(v - gridPt2D s (roundShift2D s 0 v)) 1‖ ^ 2 =
          (v 1 - s * (Int.floor ((v 1 - 0) / s) : ℝ)) ^ 2 := by
        simp [gridPt2D, roundShift2D, Real.norm_eq_abs, sq_abs]
      rw [hc0, hc1]
      nlinarith only [h_coord (v 0), h_coord (v 1), hs]
    have habs := sq_le_sq.mp h_norm_sq
    rwa [abs_of_nonneg (norm_nonneg _), abs_of_nonneg (by positivity)] at habs

  let dec_e : ℝ → ℤ × ℤ → EuclideanSpace ℝ (Fin 2) := fun δ k_a =>
    let w := gridPt2D δ k_a
    if ‖w‖ = 0 then u_vec else ‖w‖⁻¹ • w

  have h_dec_e_unit : ∀ (δ : ℝ) (k_a : ℤ × ℤ), ‖dec_e δ k_a‖ = 1 := by
    intro δ k_a
    dsimp only [dec_e]
    split_ifs with hw0
    · exact hu_vec
    · have hw_pos : 0 < ‖gridPt2D δ k_a‖ :=
        lt_of_le_of_ne (norm_nonneg _) (Ne.symm hw0)
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hw_pos), inv_mul_cancel₀ hw0]

  have h_dec_e_approx : ∀ (δ : ℝ) (e : EuclideanSpace ℝ (Fin 2)),
      0 < δ → δ < 1 / 4 → ‖e‖ = 1 →
      ‖perp2D (dec_e δ (roundShift2D δ 0 e)) - perp2D e‖ ≤ 4 * δ := by
    intro δ e hδ₀ hδ₁ he
    let k_a := roundShift2D δ 0 e
    let w := gridPt2D δ k_a
    have hew : ‖e - w‖ ≤ 2 * δ := h_round2D_err δ e hδ₀
    have hw_gt : 1 / 2 < ‖w‖ := by
      have h1 : ‖e‖ - ‖w‖ ≤ ‖e - w‖ := norm_sub_norm_le e w
      rw [he] at h1
      linarith only [h1, hew, hδ₁]
    have hw_pos : 0 < ‖w‖ := by linarith only [hw_gt]
    have hdec_eq : dec_e δ k_a = ‖w‖⁻¹ • w := if_neg hw_pos.ne'
    have hdec_w : ‖dec_e δ k_a - w‖ ≤ ‖e - w‖ := by
      rw [hdec_eq]
      have hsmul : ‖w‖⁻¹ • w - w = (‖w‖⁻¹ - 1) • w := by rw [sub_smul, one_smul]
      rw [hsmul, norm_smul, Real.norm_eq_abs]
      have hmul : |‖w‖⁻¹ - 1| * ‖w‖ = |1 - ‖w‖| := by
        calc |‖w‖⁻¹ - 1| * ‖w‖ = |‖w‖⁻¹ - 1| * |‖w‖| := by rw [abs_of_pos hw_pos]
          _ = |(‖w‖⁻¹ - 1) * ‖w‖| := (abs_mul _ _).symm
          _ = |1 - ‖w‖| := by
              rw [sub_mul, inv_mul_cancel₀ hw_pos.ne', one_mul]
      rw [hmul, ← he]
      exact abs_norm_sub_norm_le e w
    have hdec_e : ‖dec_e δ k_a - e‖ ≤ 4 * δ := by
      have htri : ‖dec_e δ k_a - e‖ ≤ ‖dec_e δ k_a - w‖ + ‖w - e‖ := by
        simpa only [sub_add_sub_cancel] using norm_add_le (dec_e δ k_a - w) (w - e)
      rw [norm_sub_rev w e] at htri
      linarith only [htri, hdec_w, hew]
    rw [← h_perp_sub, (h_perp_orth _).2.2]
    exact hdec_e

  let I_1d : ℝ → ℝ → ℝ → Finset ℤ := fun s x₀ R =>
    Finset.Icc (Int.floor (x₀ / s - R)) (Int.floor (x₀ / s + R))

  have h_I1d_mem : ∀ (s x₀ R x : ℝ), 0 < s → |x - x₀| ≤ R * s →
      Int.floor (x / s) ∈ I_1d s x₀ R := by
    intro s x₀ R x hs habs
    obtain ⟨h1, h2⟩ := abs_le.mp habs
    have hlo : x₀ / s - R ≤ x / s := by
      have hdiv : (x₀ - R * s) / s ≤ x / s :=
        div_le_div_of_nonneg_right (by linarith only [h1]) hs.le
      rwa [sub_div, mul_div_cancel_right₀ R hs.ne'] at hdiv
    have hhi : x / s ≤ x₀ / s + R := by
      have hdiv : x / s ≤ (x₀ + R * s) / s :=
        div_le_div_of_nonneg_right (by linarith only [h2]) hs.le
      rwa [add_div, mul_div_cancel_right₀ R hs.ne'] at hdiv
    exact Finset.mem_Icc.mpr ⟨Int.floor_mono hlo, Int.floor_mono hhi⟩

  have h_I1d_card : ∀ (s x₀ R : ℝ), 1 ≤ R → ((I_1d s x₀ R).card : ℝ) ≤ 4 * R := by
    intro s x₀ R hR
    let a := Int.floor (x₀ / s - R)
    let b := Int.floor (x₀ / s + R)
    have hab : a ≤ b := Int.floor_mono (by linarith only [hR])
    have hnn : 0 ≤ b + 1 - a := by omega
    have hcz : ((Finset.Icc a b).card : ℤ) = b + 1 - a := by
      rw [Int.card_Icc, Int.toNat_of_nonneg hnn]
    have hcr : ((I_1d s x₀ R).card : ℝ) = (b : ℝ) + 1 - (a : ℝ) := by
      exact_mod_cast hcz
    have hb_le : (b : ℝ) ≤ x₀ / s + R := Int.floor_le (x₀ / s + R)
    have ha_gt : x₀ / s - R < (a : ℝ) + 1 := Int.lt_floor_add_one (x₀ / s - R)
    linarith only [hcr, hb_le, ha_gt, hR]

  
  
  
  let B_cl : ℝ := 16 * cls.B_sys + 4 * cls.R_win + 20
  let K_V : ℝ := 2 * (M_L : ℝ) + 3 * cls.B_sys + 6
  let K_X : ℝ := 8 * C_cov * cls.B_sys + 3 * cls.B_sys + 18
  let C_Y : ℝ := 256 * K_V ^ 2 * K_X ^ 2
  have hB_sys_nn : (0 : ℝ) ≤ cls.B_sys := by linarith [cls.hB_sys]
  have hBcl_ge1 : 1 ≤ B_cl := by dsimp only [B_cl]; linarith [cls.hB_sys, cls.hR_win]
  have hKV_ge1 : 1 ≤ K_V := by
    have hML_nn : (0 : ℝ) ≤ (M_L : ℝ) := Nat.cast_nonneg M_L
    dsimp only [K_V]; linarith [cls.hB_sys, hML_nn]
  have hKX_ge1 : 1 ≤ K_X := by
    have hCB_nn : 0 ≤ C_cov * cls.B_sys := mul_nonneg (by linarith [hC_cov]) hB_sys_nn
    dsimp only [K_X]; linarith [cls.hB_sys, hCB_nn]
  have hCY_ge1 : 1 ≤ C_Y := by
    have hKV2 : 1 ≤ K_V ^ 2 := by nlinarith only [hKV_ge1]
    have hKX2 : 1 ≤ K_X ^ 2 := by nlinarith only [hKX_ge1]
    dsimp only [C_Y]
    nlinarith only [hKV2, hKX2]
  have hθ_pos : 0 < θ := lt_min (by positivity) (by positivity)
  have hθ_le_h64 : θ ≤ h / 64 := min_le_left _ _

  have h_s2 :
      ∀ (ε H_P t b_star lam_sys : ℝ) (m_r m_t N_O N_D N_T : ℕ)
        (loc_idx : ℕ × (ℤ × ℤ) × (ℤ × ℤ))
        (o_at : Fin N_T → (ℤ × ℤ) × (ℤ × ℤ))
        (r_O : Fin N_O → ℕ) (V_O X_O : Fin N_O → EuclideanSpace ℝ (Fin 2))
        (b_D a_D : Fin N_D → ℝ) (r_D : Fin N_D → ℕ)
        (e_D V_D X_D : Fin N_D → EuclideanSpace ℝ (Fin 2))
        (q : Fin N_O → Fin N_D → Fin N_T → ℝ),
        letI := Classical.propDecidable
        let r := t - 2 * h
        let u := (H_P - t) / 2 - b_star
        let s_c := ((2 : ℝ) ^ m_r)⁻¹
        let s_v := ε ^ b_star
        let s_x := s_c * s_v
        let ρ_r := ε ^ ((H_P - r) / 2)
        let σ_r := (lam_sys * ρ_r)⁻¹
        let V_J := gridPt2D s_v loc_idx.2.1
        let X_J := gridPt2D s_x loc_idx.2.2
        let V'_at : Fin N_T → EuclideanSpace ℝ (Fin 2) :=
          fun α => s_v⁻¹ • (gridPt2D ρ_r (o_at α).1 - V_J)
        let X'_at : Fin N_T → EuclideanSpace ℝ (Fin 2) :=
          fun α => s_x⁻¹ • (gridPt2D σ_r (o_at α).2 - X_J)
        let A_part : Fin N_T → EuclideanSpace ℝ (Fin 2) :=
          fun α => X'_at α - (1 / 2 : ℝ) • V'_at α
        let F_T_loc : ℕ → Fin N_T → ℕ × (ℤ × ℤ) × (ℤ × ℤ) :=
          fun r_loc α =>
            let c_end := ((r_loc : ℝ) + 1 / 2) * ((2 : ℝ) ^ (m_t - m_r))⁻¹
            (r_loc,
             roundShift2D (ε ^ (u - h)) 0 (V'_at α),
             roundShift2D (ε ^ (u + h)) 0 (X'_at α + (c_end - 1 / 2) • V'_at α))
        0 < ε → ε < 1 / 2 →
        0 ≤ b_star → u_min ≤ u → (d_dim = 2 → b_star = 0) →
        ε ^ r ≤ s_c → m_r ≤ m_t →
        (∀ α : Fin N_T, ‖V'_at α‖ ≤ 4 * cls.B_sys + cls.R_win + 4) →
        (∀ o d α, 0 < q o d α →
          r_O o = r_D d ∧
          cutLocalizerIdx ε b_star m_r m_t (r_O o) (V_O o) (X_O o) = loc_idx ∧
          0 ≤ b_D d ∧ b_star ≤ b_D d ∧ b_D d ≤ a_D d ∧ a_D d ≤ (H_P - t) / 2 ∧
