theorem mesh_prefix_to_canonical_block_upgrade (s σ : ℝ) (hs₀ : 0 < s) (hs₁ : s ≤ 1) (hσ₀ : 0 < σ) (hσ₁ : σ ≤ 1 / 4) :
    (∀ (a_pt : Fin 4 → ℝ) (κ_err : ℕ → ℝ)
       (stg : ∀ l : ℕ, CoredDistinctMeshStage s σ a_pt (l + 2) (κ_err l)),
       (∀ j, 0 ≤ a_pt j ∧ a_pt j ≤ 1) →
       (∀ l, 0 < κ_err l) →
       Filter.Tendsto κ_err Filter.atTop (nhds 0) →
       Filter.Tendsto (fun l => (stg l).ρ) Filter.atTop (nhds 0) →
       Nonempty (CanonicalAffineBlockDistinct s σ a_pt)) ∧
