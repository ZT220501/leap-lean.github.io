            · simp [hπ0]
            · have hπ_pos : 0 < π₁ ω := lt_of_le_of_ne (hπ₁_nn ω) (Ne.symm hπ0)
              have hp2_eq : finProbAt2 (π_fib j) (fun _ => ()) (G_loc j) ω =
                  finProbAt2 π₁ (fun _ => ()) B_pair ω / p_J_fn j := by
                unfold finProbAt2
                rw [Finset.sum_div]
                refine Finset.sum_congr rfl (fun ω' _ => ?_)
                dsimp only [π_fib]
                have h_iff : (() = () ∧ B_pair ω' = B_pair ω) ↔
                    (J ω' = j ∧ G_loc j ω' = G_loc j ω) := by
                  constructor
                  · rintro ⟨_, hB⟩
                    obtain ⟨hB1, hB2⟩ := Prod.mk.inj hB
                    have hJ' : J ω' = j := hB1.trans hJω
                    rw [hJ', hJω] at hB2
                    exact ⟨hJ', hB2⟩
                  · rintro ⟨hJ', hG⟩
                    exact ⟨rfl, Prod.ext (hJ'.trans hJω.symm)
                      (by dsimp only [B_pair]; rwa [hJ', hJω])⟩
                by_cases hJ' : J ω' = j
                · rw [if_pos hJ']
                  by_cases hG : G_loc j ω' = G_loc j ω
                  · have hL : () = () ∧ G_loc j ω' = G_loc j ω := ⟨rfl, hG⟩
                    have hR : () = () ∧ B_pair ω' = B_pair ω := h_iff.mpr ⟨hJ', hG⟩
                    rw [if_pos hL, if_pos hR]
                  · have hL : ¬(() = () ∧ G_loc j ω' = G_loc j ω) := fun h => hG h.2
                    have hR : ¬(() = () ∧ B_pair ω' = B_pair ω) := fun h => hG (h_iff.mp h).2
                    rw [if_neg hL, if_neg hR, zero_div]
                · rw [if_neg hJ']
                  have hR : ¬(() = () ∧ B_pair ω' = B_pair ω) := fun h => hJ' (h_iff.mp h).1
                  rw [if_neg hR, ite_self, zero_div]
              have hpB_pos : 0 < finProbAt2 π₁ (fun _ => ()) B_pair ω := by
                unfold finProbAt2
                have hle : (if (() = () ∧ B_pair ω = B_pair ω) then π₁ ω else 0) ≤
                    ∑ ω' : Fin N_ω, if () = () ∧ B_pair ω' = B_pair ω then π₁ ω' else 0 :=
                  Finset.single_le_sum
                    (f := fun ω' => if () = () ∧ B_pair ω' = B_pair ω then π₁ ω' else 0)
                    (fun ω' _ => by split_ifs <;> [exact hπ₁_nn ω'; exact le_rfl])
                    (Finset.mem_univ ω)
                exact lt_of_lt_of_le hπ_pos (by simpa using hle)
              unfold condSurprise
              rw [h_unit_fib ω, h_unit_glob ω, hp2_eq, div_one, div_one,
                Real.log_div hpB_pos.ne' hpj.ne']
              dsimp only [ell]
              field_simp [hpj.ne', hell_ne]
              ring
          · ring
        unfold finCondEntropy
        rw [Finset.mul_sum, Finset.sum_congr rfl (fun ω _ => h_term ω),
          Finset.sum_add_distrib, ← Finset.sum_mul]
        dsimp only [p_J_fn]
        ring
      rw [Finset.sum_congr rfl h_per_j, Finset.sum_add_distrib,
        h_sum_Jpos _ (fun ω h0 => by simp [h0])]
      unfold finCondEntropy
      dsimp only [H_J]
      rw [← Finset.sum_div, Finset.sum_neg_distrib]
      ring
    have h_mi_eq :
        ∑ j ∈ J_pos, p_J_fn j * finMutualInfo ε (π_fib j) T_idx (G_loc j) =
          finMutualInfo ε π₁ T_idx B_pair - H_J := by
      have h_split : (∑ j ∈ J_pos, p_J_fn j * finMutualInfo ε (π_fib j) T_idx (G_loc j)) =
          (∑ j ∈ J_pos, p_J_fn j * finCondEntropy ε (π_fib j) (fun _ => ()) (G_loc j)) -
          (∑ j ∈ J_pos, p_J_fn j * finCondEntropy ε (π_fib j) T_idx (G_loc j)) := by
        rw [← Finset.sum_sub_distrib]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        unfold finMutualInfo
        ring
      rw [h_split, h_ent_B_eq, h_ent_TB_eq]
      unfold finMutualInfo
      ring

    
    let S_pos : Finset (Fin N_ω) := Finset.univ.filter (fun ω => 0 < π₁ ω)
    have h_sum_Spos : ∀ f : Fin N_ω → ℝ, ∑ ω ∈ S_pos, π₁ ω * f ω = ∑ ω : Fin N_ω, π₁ ω * f ω := by
      intro f
      refine Finset.sum_subset (Finset.filter_subset _ _) (fun ω _ hnot => ?_)
      have hle : π₁ ω ≤ 0 := le_of_not_gt (fun hp => hnot (Finset.mem_filter.mpr ⟨Finset.mem_univ ω, hp⟩))
      have h0 : π₁ ω = 0 := le_antisymm hle (hπ₁_nn ω)
      simp [h0]
    have h_Spos_one : ∑ ω ∈ S_pos, π₁ ω = 1 := by
      have h1 := h_sum_Spos (fun _ => 1)
      simpa [hπ₁_sum] using h1
    have h_mi_chain :
        finMutualInfo ε π₁ T_idx B_pair ≤
          finMutualInfo ε π₁ T_idx G_glob + finCondEntropy ε π₁ G_glob B_pair := by
      let p_A := fun ω => finProbAt π₁ G_glob ω
      let p_B := fun ω => finProbAt π₁ B_pair ω
      let p_T := fun ω => finProbAt π₁ T_idx ω
      let p_TA := fun ω => finProbAt2 π₁ T_idx G_glob ω
      let p_TB := fun ω => finProbAt2 π₁ T_idx B_pair ω
      let p_AB := fun ω => finProbAt2 π₁ G_glob B_pair ω
      let p_TAB := fun ω => finProbAt2 π₁ T_idx (fun ω' => (G_glob ω', B_pair ω')) ω
      have h_unit_1 : ∀ ω : Fin N_ω, finProbAt π₁ (fun _ => ()) ω = 1 := by
        intro ω; unfold finProbAt; simpa using hπ₁_sum
      have h_unit_2 : ∀ {β : Type} (Y : Fin N_ω → β) (ω : Fin N_ω),
          finProbAt2 π₁ (fun _ => ()) Y ω = finProbAt π₁ Y ω := by
        intro β Y ω; unfold finProbAt2 finProbAt; simp
      have h_pos_probs : ∀ ω ∈ S_pos,
          0 < p_A ω ∧ 0 < p_B ω ∧ 0 < p_T ω ∧ 0 < p_TA ω ∧
          0 < p_TB ω ∧ 0 < p_AB ω ∧ 0 < p_TAB ω := by
        intro ω hω
        have hπ_pos : 0 < π₁ ω := (Finset.mem_filter.mp hω).2
        have h1 : ∀ {α : Type} (X : Fin N_ω → α), 0 < finProbAt π₁ X ω := by
          intro α X; unfold finProbAt
          letI := Classical.propDecidable
          have hle := Finset.single_le_sum
            (f := fun ω' => if X ω' = X ω then π₁ ω' else 0)
            (fun ω' _ => by split_ifs <;> [exact hπ₁_nn ω'; exact le_rfl])
            (Finset.mem_univ ω)
          exact lt_of_lt_of_le hπ_pos (by simpa using hle)
        have h2 : ∀ {α β : Type} (X : Fin N_ω → α) (Y : Fin N_ω → β),
            0 < finProbAt2 π₁ X Y ω := by
          intro α β X Y; unfold finProbAt2
          letI := Classical.propDecidable
          have hle := Finset.single_le_sum
            (f := fun ω' => if X ω' = X ω ∧ Y ω' = Y ω then π₁ ω' else 0)
            (fun ω' _ => by split_ifs <;> [exact hπ₁_nn ω'; exact le_rfl])
            (Finset.mem_univ ω)
          exact lt_of_lt_of_le hπ_pos (by simpa using hle)
        exact ⟨h1 _, h1 _, h1 _, h2 _ _, h2 _ _, h2 _ _, h2 _ _⟩
      
      have h_pt_lb : ∀ ω ∈ S_pos,
          1 - (p_AB ω * p_TB ω) / (p_B ω * p_TAB ω) ≤
            ell * ((condSurprise ε π₁ (fun _ => ()) G_glob ω - condSurprise ε π₁ T_idx G_glob ω) +
              condSurprise ε π₁ G_glob B_pair ω -
              (condSurprise ε π₁ (fun _ => ()) B_pair ω - condSurprise ε π₁ T_idx B_pair ω)) := by
        intro ω hω
        obtain ⟨hpA, hpB, hpT, hpTA, hpTB, hpAB, hpTAB⟩ := h_pos_probs ω hω
        have hpTAB_le_pTA : p_TAB ω ≤ p_TA ω := by
          dsimp only [p_TAB, p_TA]
          unfold finProbAt2
          refine Finset.sum_le_sum (fun ω' _ => ?_)
          split_ifs with h1 h2
          · exact le_rfl
          · exfalso; exact h2 ⟨h1.1, (Prod.mk.inj h1.2).1⟩
          · exact hπ₁_nn ω'
          · exact le_rfl
        have h_term1 : 0 ≤ -Real.log (p_TAB ω / p_TA ω) := by
          have h_le1 : p_TAB ω / p_TA ω ≤ 1 := (div_le_one hpTA).mpr hpTAB_le_pTA
          have h_nn : 0 ≤ p_TAB ω / p_TA ω := div_nonneg hpTAB.le hpTA.le
          linarith [Real.log_nonpos h_nn h_le1]
        have h_ratio_pos : 0 < (p_AB ω * p_TB ω) / (p_B ω * p_TAB ω) :=
          div_pos (mul_pos hpAB hpTB) (mul_pos hpB hpTAB)
        have h_term2 : 1 - (p_AB ω * p_TB ω) / (p_B ω * p_TAB ω) ≤
            -Real.log ((p_AB ω * p_TB ω) / (p_B ω * p_TAB ω)) := by
          linarith [Real.log_le_sub_one_of_pos h_ratio_pos]
        have h_rhs_eq :
            ell * ((condSurprise ε π₁ (fun _ => ()) G_glob ω - condSurprise ε π₁ T_idx G_glob ω) +
              condSurprise ε π₁ G_glob B_pair ω -
              (condSurprise ε π₁ (fun _ => ()) B_pair ω - condSurprise ε π₁ T_idx B_pair ω)) =
            (-Real.log (p_TAB ω / p_TA ω)) +
              (-Real.log ((p_AB ω * p_TB ω) / (p_B ω * p_TAB ω))) := by
          unfold condSurprise
          rw [h_unit_1, h_unit_2, h_unit_2, div_one, div_one]
          change ell * ((-Real.log (p_A ω) / ell - -Real.log (p_TA ω / p_T ω) / ell) +
              -Real.log (p_AB ω / p_A ω) / ell -
              (-Real.log (p_B ω) / ell - -Real.log (p_TB ω / p_T ω) / ell)) =
            (-Real.log (p_TAB ω / p_TA ω)) +
              (-Real.log ((p_AB ω * p_TB ω) / (p_B ω * p_TAB ω)))
          rw [Real.log_div hpTA.ne' hpT.ne',
            Real.log_div hpAB.ne' hpA.ne',
            Real.log_div hpTB.ne' hpT.ne',
            Real.log_div hpTAB.ne' hpTA.ne',
            Real.log_div (mul_pos hpAB hpTB).ne' (mul_pos hpB hpTAB).ne',
            Real.log_mul hpAB.ne' hpTB.ne',
            Real.log_mul hpB.ne' hpTAB.ne']
          field_simp [hell_ne]
          ring
        rw [h_rhs_eq]
        linarith
      
      let S_A := S_pos.image G_glob
      let B_pos := S_pos.image B_pair
      have h_sum_ratio_le1 :
          ∑ ω ∈ S_pos, π₁ ω * ((p_AB ω * p_TB ω) / (p_B ω * p_TAB ω)) ≤ 1 := by
        let f_rat := fun ω : Fin N_ω => π₁ ω * ((p_AB ω * p_TB ω) / (p_B ω * p_TAB ω))
        have h_part : ∑ ω ∈ S_pos, f_rat ω =
            ∑ b₀ ∈ B_pos, ∑ t₀ : Fin N_T, ∑ a₀ ∈ S_A,
              ∑ ω ∈ S_pos,
                if B_pair ω = b₀ ∧ T_idx ω = t₀ ∧ G_glob ω = a₀ then f_rat ω else 0 := by
          trans (∑ b₀ ∈ B_pos, ∑ t₀ : Fin N_T,
              ∑ ω ∈ S_pos, if B_pair ω = b₀ ∧ T_idx ω = t₀ then f_rat ω else 0)
          · trans (∑ b₀ ∈ B_pos, ∑ ω ∈ S_pos, if B_pair ω = b₀ then f_rat ω else 0)
            · rw [Finset.sum_comm]
              refine Finset.sum_congr rfl (fun ω hω => ?_)
              rw [Finset.sum_ite_eq B_pos (B_pair ω) (fun _ => f_rat ω),
                if_pos (Finset.mem_image_of_mem B_pair hω)]
            · refine Finset.sum_congr rfl (fun b₀ _ => ?_)
              rw [Finset.sum_comm]
              refine Finset.sum_congr rfl (fun ω _ => ?_)
              have h_in : (∑ t₀ : Fin N_T, if B_pair ω = b₀ ∧ T_idx ω = t₀ then f_rat ω else 0) =
                  if B_pair ω = b₀ then (∑ t₀ : Fin N_T, if T_idx ω = t₀ then f_rat ω else 0) else 0 := by
                split_ifs with hb
                · refine Finset.sum_congr rfl (fun t₀ _ => by simp [hb])
                · simp [hb]
              rw [h_in, Finset.sum_ite_eq Finset.univ (T_idx ω) (fun _ => f_rat ω),
                if_pos (Finset.mem_univ _)]
          · refine Finset.sum_congr rfl (fun b₀ _ => Finset.sum_congr rfl (fun t₀ _ => ?_))
            rw [Finset.sum_comm]
            refine Finset.sum_congr rfl (fun ω hω => ?_)
            have h_in : (∑ a₀ ∈ S_A,
                  if B_pair ω = b₀ ∧ T_idx ω = t₀ ∧ G_glob ω = a₀ then f_rat ω else 0) =
                if B_pair ω = b₀ ∧ T_idx ω = t₀ then
                  (∑ a₀ ∈ S_A, if G_glob ω = a₀ then f_rat ω else 0) else 0 := by
              split_ifs with hbt
              · refine Finset.sum_congr rfl (fun a₀ _ => by simp [hbt.1, hbt.2])
              · refine Finset.sum_eq_zero (fun a₀ _ => ?_)
                split_ifs with h3
                · exact absurd ⟨h3.1, h3.2.1⟩ hbt
                · rfl
            rw [h_in, Finset.sum_ite_eq S_A (G_glob ω) (fun _ => f_rat ω),
              if_pos (Finset.mem_image_of_mem G_glob hω)]
        let P_B := fun b₀ => ∑ ω' : Fin N_ω, if B_pair ω' = b₀ then π₁ ω' else 0
        let P_AB := fun a₀ b₀ => ∑ ω' : Fin N_ω,
          if G_glob ω' = a₀ ∧ B_pair ω' = b₀ then π₁ ω' else 0
        let P_TB := fun t₀ b₀ => ∑ ω' : Fin N_ω,
          if T_idx ω' = t₀ ∧ B_pair ω' = b₀ then π₁ ω' else 0
        have h_cell_le : ∀ b₀ ∈ B_pos, ∀ (t₀ : Fin N_T), ∀ a₀ ∈ S_A,
            (∑ ω ∈ S_pos,
              if B_pair ω = b₀ ∧ T_idx ω = t₀ ∧ G_glob ω = a₀ then f_rat ω else 0) ≤
              (P_AB a₀ b₀ * P_TB t₀ b₀) / P_B b₀ := by
          intro b₀ _ t₀ a₀ _
          have hPB_nn : 0 ≤ P_B b₀ := Finset.sum_nonneg (fun ω' _ => by split_ifs <;> [exact hπ₁_nn ω'; exact le_rfl])
          have hPAB_nn : 0 ≤ P_AB a₀ b₀ := Finset.sum_nonneg (fun ω' _ => by split_ifs <;> [exact hπ₁_nn ω'; exact le_rfl])
          have hPTB_nn : 0 ≤ P_TB t₀ b₀ := Finset.sum_nonneg (fun ω' _ => by split_ifs <;> [exact hπ₁_nn ω'; exact le_rfl])
          let fib := S_pos.filter (fun ω => B_pair ω = b₀ ∧ T_idx ω = t₀ ∧ G_glob ω = a₀)
          have h_sum_fib : (∑ ω ∈ S_pos,
              if B_pair ω = b₀ ∧ T_idx ω = t₀ ∧ G_glob ω = a₀ then f_rat ω else 0) =
              ∑ ω ∈ fib, f_rat ω := by
            symm
            dsimp only [fib]
            rw [Finset.sum_filter]
            refine Finset.sum_congr rfl (fun ω _ => ?_)
            by_cases hc : B_pair ω = b₀ ∧ T_idx ω = t₀ ∧ G_glob ω = a₀
            · rw [if_pos hc, if_pos hc]
            · rw [if_neg hc, if_neg hc]
          rw [h_sum_fib]
          by_cases h_ne : fib.Nonempty
          · obtain ⟨ω₀, hω₀⟩ := h_ne
            obtain ⟨hω₀_pos, hb₀, ht₀, ha₀⟩ := Finset.mem_filter.mp hω₀
            obtain ⟨_, hpB₀, _, _, _, _, hpTAB₀⟩ := h_pos_probs ω₀ hω₀_pos
            have h_fib_mass : ∑ ω ∈ fib, π₁ ω = p_TAB ω₀ := by
              calc ∑ ω ∈ fib, π₁ ω
                  = ∑ ω ∈ S_pos, if B_pair ω = b₀ ∧ T_idx ω = t₀ ∧ G_glob ω = a₀ then π₁ ω else 0 := by
                    dsimp only [fib]
                    rw [Finset.sum_filter]
                    refine Finset.sum_congr rfl (fun ω _ => ?_)
                    by_cases hc : B_pair ω = b₀ ∧ T_idx ω = t₀ ∧ G_glob ω = a₀
                    · rw [if_pos hc, if_pos hc]
                    · rw [if_neg hc, if_neg hc]
                _ = ∑ ω : Fin N_ω, π₁ ω * (if B_pair ω = b₀ ∧ T_idx ω = t₀ ∧ G_glob ω = a₀ then 1 else 0) := by
                    rw [← h_sum_Spos]
                    exact Finset.sum_congr rfl (fun ω _ => by split_ifs <;> ring)
                _ = p_TAB ω₀ := by
                    dsimp only [p_TAB]; unfold finProbAt2
                    letI := Classical.propDecidable
                    refine Finset.sum_congr rfl (fun ω _ => ?_)
                    have h_iff : (B_pair ω = b₀ ∧ T_idx ω = t₀ ∧ G_glob ω = a₀) ↔
                        (T_idx ω = T_idx ω₀ ∧ (G_glob ω, B_pair ω) = (G_glob ω₀, B_pair ω₀)) := by
                      constructor
                      · rintro ⟨hb, ht, ha⟩
                        exact ⟨ht.trans ht₀.symm, Prod.ext (ha.trans ha₀.symm) (hb.trans hb₀.symm)⟩
                      · rintro ⟨ht, hab⟩
                        exact ⟨(Prod.mk.inj hab).2.trans hb₀, ht.trans ht₀, (Prod.mk.inj hab).1.trans ha₀⟩
                    by_cases hc : B_pair ω = b₀ ∧ T_idx ω = t₀ ∧ G_glob ω = a₀
                    · rw [if_pos hc, if_pos (h_iff.mp hc), mul_one]
                    · rw [if_neg hc, if_neg (fun h => hc (h_iff.mpr h)), mul_zero]
            have h_const : ∀ ω ∈ fib,
                f_rat ω = π₁ ω * ((P_AB a₀ b₀ * P_TB t₀ b₀) / (P_B b₀ * p_TAB ω₀)) := by
              intro ω hω
              obtain ⟨_, hbw, htw, haw⟩ := Finset.mem_filter.mp hω
              have he1 : p_AB ω = P_AB a₀ b₀ := by
                dsimp only [p_AB, P_AB]; unfold finProbAt2
                letI := Classical.propDecidable
                refine Finset.sum_congr rfl (fun ω' _ => ?_)
                by_cases hc : G_glob ω' = G_glob ω ∧ B_pair ω' = B_pair ω
                · have hc' : G_glob ω' = a₀ ∧ B_pair ω' = b₀ := ⟨hc.1.trans haw, hc.2.trans hbw⟩
                  rw [if_pos hc, if_pos hc']
                · have hc' : ¬(G_glob ω' = a₀ ∧ B_pair ω' = b₀) :=
                    fun h => hc ⟨h.1.trans haw.symm, h.2.trans hbw.symm⟩
                  rw [if_neg hc, if_neg hc']
              have he2 : p_TB ω = P_TB t₀ b₀ := by
                dsimp only [p_TB, P_TB]; unfold finProbAt2
                letI := Classical.propDecidable
                refine Finset.sum_congr rfl (fun ω' _ => ?_)
                by_cases hc : T_idx ω' = T_idx ω ∧ B_pair ω' = B_pair ω
                · have hc' : T_idx ω' = t₀ ∧ B_pair ω' = b₀ := ⟨hc.1.trans htw, hc.2.trans hbw⟩
                  rw [if_pos hc, if_pos hc']
                · have hc' : ¬(T_idx ω' = t₀ ∧ B_pair ω' = b₀) :=
                    fun h => hc ⟨h.1.trans htw.symm, h.2.trans hbw.symm⟩
                  rw [if_neg hc, if_neg hc']
              have he3 : p_B ω = P_B b₀ := by
                dsimp only [p_B, P_B]; unfold finProbAt
                letI := Classical.propDecidable
                refine Finset.sum_congr rfl (fun ω' _ => ?_)
                by_cases hc : B_pair ω' = B_pair ω
                · rw [if_pos hc, if_pos (hc.trans hbw)]
                · rw [if_neg hc, if_neg (fun h => hc (h.trans hbw.symm))]
              have he4 : p_TAB ω = p_TAB ω₀ := by
                dsimp only [p_TAB]; unfold finProbAt2
                letI := Classical.propDecidable
                refine Finset.sum_congr rfl (fun ω' _ => ?_)
                have h_iff : (T_idx ω' = T_idx ω ∧ (G_glob ω', B_pair ω') = (G_glob ω, B_pair ω)) ↔
                    (T_idx ω' = T_idx ω₀ ∧ (G_glob ω', B_pair ω') = (G_glob ω₀, B_pair ω₀)) := by
                  rw [htw, ht₀, haw, ha₀, hbw, hb₀]
                by_cases hc : T_idx ω' = T_idx ω ∧ (G_glob ω', B_pair ω') = (G_glob ω, B_pair ω)
                · rw [if_pos hc, if_pos (h_iff.mp hc)]
                · rw [if_neg hc, if_neg (fun h => hc (h_iff.mpr h))]
              dsimp only [f_rat]
              rw [he1, he2, he3, he4]
            have hPB_eq : P_B b₀ = p_B ω₀ := by
              dsimp only [p_B, P_B]; unfold finProbAt
              letI := Classical.propDecidable
              refine Finset.sum_congr rfl (fun ω' _ => ?_)
              by_cases hc : B_pair ω' = b₀
              · rw [if_pos hc, if_pos (hc.trans hb₀.symm)]
              · rw [if_neg hc, if_neg (fun h => hc (h.trans hb₀))]
            have hPB_pos : 0 < P_B b₀ := by rwa [hPB_eq]
            rw [Finset.sum_congr rfl h_const, ← Finset.sum_mul, h_fib_mass]
            exact le_of_eq (by field_simp [hpTAB₀.ne', hPB_pos.ne'])
          · rw [Finset.not_nonempty_iff_eq_empty.mp h_ne, Finset.sum_empty]
            exact div_nonneg (mul_nonneg hPAB_nn hPTB_nn) hPB_nn
        calc ∑ ω ∈ S_pos, f_rat ω
            ≤ ∑ b₀ ∈ B_pos, ∑ t₀ : Fin N_T, ∑ a₀ ∈ S_A, (P_AB a₀ b₀ * P_TB t₀ b₀) / P_B b₀ := by
              rw [h_part]
              exact Finset.sum_le_sum (fun b₀ hb₀ => Finset.sum_le_sum (fun t₀ _ =>
                Finset.sum_le_sum (fun a₀ ha₀ => h_cell_le b₀ hb₀ t₀ a₀ ha₀)))
          _ = ∑ b₀ ∈ B_pos, P_B b₀ := by
              refine Finset.sum_congr rfl (fun b₀ hb₀ => ?_)
              obtain ⟨ω_b, hω_b_pos, rfl⟩ := Finset.mem_image.mp hb₀
              have hPB_eq_pB : P_B (B_pair ω_b) = p_B ω_b := by
                dsimp only [P_B, p_B]; unfold finProbAt
                exact Finset.sum_congr rfl (fun ω' _ => by split_ifs <;> rfl)
              have hPB_pos : 0 < P_B (B_pair ω_b) := by
                rw [hPB_eq_pB]; exact (h_pos_probs ω_b hω_b_pos).2.1
              have h_sum_A : ∑ a₀ ∈ S_A, P_AB a₀ (B_pair ω_b) = P_B (B_pair ω_b) := by
                dsimp only [P_AB, P_B]
                rw [Finset.sum_comm]
                refine Finset.sum_congr rfl (fun ω' _ => ?_)
                by_cases h0 : π₁ ω' = 0
                · simp [h0]
                · have hp : 0 < π₁ ω' := lt_of_le_of_ne (hπ₁_nn ω') (Ne.symm h0)
                  have ha_mem : G_glob ω' ∈ S_A :=
                    Finset.mem_image_of_mem G_glob (Finset.mem_filter.mpr ⟨Finset.mem_univ ω', hp⟩)
                  have h_in : (∑ a₀ ∈ S_A, if G_glob ω' = a₀ ∧ B_pair ω' = B_pair ω_b then π₁ ω' else 0) =
                      if B_pair ω' = B_pair ω_b then (∑ a₀ ∈ S_A, if G_glob ω' = a₀ then π₁ ω' else 0) else 0 := by
                    split_ifs with hb
                    · refine Finset.sum_congr rfl (fun a₀ _ => by simp [hb])
                    · simp [hb]
                  rw [h_in, Finset.sum_ite_eq S_A (G_glob ω') (fun _ => π₁ ω'), if_pos ha_mem]
              have h_sum_T : ∑ t₀ : Fin N_T, P_TB t₀ (B_pair ω_b) = P_B (B_pair ω_b) := by
                dsimp only [P_TB, P_B]
                rw [Finset.sum_comm]
                refine Finset.sum_congr rfl (fun ω' _ => ?_)
                have h_in : (∑ t₀ : Fin N_T, if T_idx ω' = t₀ ∧ B_pair ω' = B_pair ω_b then π₁ ω' else 0) =
                    if B_pair ω' = B_pair ω_b then (∑ t₀ : Fin N_T, if T_idx ω' = t₀ then π₁ ω' else 0) else 0 := by
                  split_ifs with hb
                  · refine Finset.sum_congr rfl (fun t₀ _ => by simp [hb])
                  · simp [hb]
                rw [h_in, Finset.sum_ite_eq Finset.univ (T_idx ω') (fun _ => π₁ ω'),
                  if_pos (Finset.mem_univ _)]
              have h_inner : ∀ t₀ : Fin N_T,
                  (∑ a₀ ∈ S_A, (P_AB a₀ (B_pair ω_b) * P_TB t₀ (B_pair ω_b)) / P_B (B_pair ω_b)) =
                  P_TB t₀ (B_pair ω_b) := by
                intro t₀
                rw [← Finset.sum_div, ← Finset.sum_mul, h_sum_A,
                  mul_div_cancel_left₀ _ hPB_pos.ne']
              rw [Finset.sum_congr rfl (fun t₀ _ => h_inner t₀), h_sum_T]
          _ = 1 := by
              dsimp only [P_B]
              rw [Finset.sum_comm]
              trans (∑ ω' : Fin N_ω, π₁ ω')
              · refine Finset.sum_congr rfl (fun ω' _ => ?_)
                rw [Finset.sum_ite_eq B_pos (B_pair ω') (fun _ => π₁ ω')]
                by_cases h0 : π₁ ω' = 0
                · simp [h0]
                · have hp : 0 < π₁ ω' := lt_of_le_of_ne (hπ₁_nn ω') (Ne.symm h0)
                  exact if_pos (Finset.mem_image_of_mem B_pair
                    (Finset.mem_filter.mpr ⟨Finset.mem_univ ω', hp⟩))
              · exact hπ₁_sum
      
      have h_weighted := Finset.sum_le_sum (fun ω hω =>
        mul_le_mul_of_nonneg_left (h_pt_lb ω hω) (hπ₁_nn ω))
      have h_lhs_zero : 0 ≤ ∑ ω ∈ S_pos, π₁ ω * (1 - (p_AB ω * p_TB ω) / (p_B ω * p_TAB ω)) := by
        have h_eq : (∑ ω ∈ S_pos, π₁ ω * (1 - (p_AB ω * p_TB ω) / (p_B ω * p_TAB ω))) =
            (∑ ω ∈ S_pos, π₁ ω) - ∑ ω ∈ S_pos, π₁ ω * ((p_AB ω * p_TB ω) / (p_B ω * p_TAB ω)) := by
          rw [← Finset.sum_sub_distrib]
          exact Finset.sum_congr rfl (fun ω _ => by ring)
        linarith [h_eq, h_Spos_one, h_sum_ratio_le1]
      have h_rhs_expand :
          (∑ ω ∈ S_pos, π₁ ω * (ell * ((condSurprise ε π₁ (fun _ => ()) G_glob ω -
              condSurprise ε π₁ T_idx G_glob ω) + condSurprise ε π₁ G_glob B_pair ω -
            (condSurprise ε π₁ (fun _ => ()) B_pair ω - condSurprise ε π₁ T_idx B_pair ω)))) =
          ell * (finMutualInfo ε π₁ T_idx G_glob + finCondEntropy ε π₁ G_glob B_pair -
            finMutualInfo ε π₁ T_idx B_pair) := by
        have h1 : (∑ ω ∈ S_pos, π₁ ω * (ell * ((condSurprise ε π₁ (fun _ => ()) G_glob ω -
              condSurprise ε π₁ T_idx G_glob ω) + condSurprise ε π₁ G_glob B_pair ω -
            (condSurprise ε π₁ (fun _ => ()) B_pair ω - condSurprise ε π₁ T_idx B_pair ω)))) =
            ell * ∑ ω ∈ S_pos, π₁ ω * ((condSurprise ε π₁ (fun _ => ()) G_glob ω -
              condSurprise ε π₁ T_idx G_glob ω) + condSurprise ε π₁ G_glob B_pair ω -
            (condSurprise ε π₁ (fun _ => ()) B_pair ω - condSurprise ε π₁ T_idx B_pair ω)) := by
          rw [Finset.mul_sum]
          exact Finset.sum_congr rfl (fun ω _ => by ring)
        rw [h1, h_sum_Spos]
        congr 1
        unfold finMutualInfo finCondEntropy
        simp only [← Finset.sum_sub_distrib, ← Finset.sum_add_distrib]
        exact Finset.sum_congr rfl (fun ω _ => by ring)
      have h_prod_nn : 0 ≤ ell * (finMutualInfo ε π₁ T_idx G_glob +
          finCondEntropy ε π₁ G_glob B_pair - finMutualInfo ε π₁ T_idx B_pair) :=
        le_trans h_lhs_zero (by rwa [h_rhs_expand] at h_weighted)
      have h_diff_nn := nonneg_of_mul_nonneg_right h_prod_nn hell_pos
      linarith

    have h_amb_ub :
        finCondEntropy ε π₁ G_glob B_pair ≤ Real.log (K_amb : ℝ) / ell := by
      have hK_pos : (0 : ℝ) < (K_amb : ℝ) := by exact_mod_cast (lt_of_lt_of_le zero_lt_one hK_amb)
      let p_A := fun ω => finProbAt π₁ G_glob ω
      let p_AB := fun ω => finProbAt2 π₁ G_glob B_pair ω
      have h_pt_ub : ∀ ω ∈ S_pos,
          ell * condSurprise ε π₁ G_glob B_pair ω - Real.log (K_amb : ℝ) ≤
            p_A ω / ((K_amb : ℝ) * p_AB ω) - 1 := by
        intro ω hω
        have hπ_pos : 0 < π₁ ω := (Finset.mem_filter.mp hω).2
        have hpA : 0 < p_A ω := by
          dsimp only [p_A]; unfold finProbAt
          letI := Classical.propDecidable
          have hle := Finset.single_le_sum
            (f := fun ω' => if G_glob ω' = G_glob ω then π₁ ω' else 0)
            (fun ω' _ => by split_ifs <;> [exact hπ₁_nn ω'; exact le_rfl])
            (Finset.mem_univ ω)
          exact lt_of_lt_of_le hπ_pos (by simpa using hle)
        have hpAB : 0 < p_AB ω := by
          dsimp only [p_AB]; unfold finProbAt2
          letI := Classical.propDecidable
          have hle := Finset.single_le_sum
            (f := fun ω' => if G_glob ω' = G_glob ω ∧ B_pair ω' = B_pair ω then π₁ ω' else 0)
            (fun ω' _ => by split_ifs <;> [exact hπ₁_nn ω'; exact le_rfl])
            (Finset.mem_univ ω)
          exact lt_of_lt_of_le hπ_pos (by simpa using hle)
        have h_eq : ell * condSurprise ε π₁ G_glob B_pair ω - Real.log (K_amb : ℝ) =
            Real.log (p_A ω / ((K_amb : ℝ) * p_AB ω)) := by
          unfold condSurprise
          change ell * (-Real.log (p_AB ω / p_A ω) / ell) - Real.log (K_amb : ℝ) =
            Real.log (p_A ω / ((K_amb : ℝ) * p_AB ω))
          rw [Real.log_div hpAB.ne' hpA.ne',
            Real.log_div hpA.ne' (mul_pos hK_pos hpAB).ne',
            Real.log_mul hK_pos.ne' hpAB.ne']
          field_simp [hell_ne]
          ring
        rw [h_eq]
        exact Real.log_le_sub_one_of_pos (div_pos hpA (mul_pos hK_pos hpAB))
      let A_pos := S_pos.image G_glob
      let P_A := fun a₀ => ∑ ω' : Fin N_ω, if G_glob ω' = a₀ then π₁ ω' else 0
      have h_sum_amb_le1 :
          ∑ ω ∈ S_pos, π₁ ω * (p_A ω / ((K_amb : ℝ) * p_AB ω)) ≤ 1 := by
        let f_amb := fun ω : Fin N_ω => π₁ ω * (p_A ω / ((K_amb : ℝ) * p_AB ω))
        have h_partA : ∑ ω ∈ S_pos, f_amb ω =
            ∑ a₀ ∈ A_pos, ∑ b₀ ∈ F_amb a₀,
              ∑ ω ∈ S_pos, if G_glob ω = a₀ ∧ B_pair ω = b₀ then f_amb ω else 0 := by
          trans (∑ a₀ ∈ A_pos, ∑ ω ∈ S_pos, if G_glob ω = a₀ then f_amb ω else 0)
          · rw [Finset.sum_comm]
            refine Finset.sum_congr rfl (fun ω hω => ?_)
            rw [Finset.sum_ite_eq A_pos (G_glob ω) (fun _ => f_amb ω),
              if_pos (Finset.mem_image_of_mem G_glob hω)]
          · refine Finset.sum_congr rfl (fun a₀ _ => ?_)
            rw [Finset.sum_comm]
            refine Finset.sum_congr rfl (fun ω hω => ?_)
            have hπ_pos : 0 < π₁ ω := (Finset.mem_filter.mp hω).2
            split_ifs with ha
            · have hb_mem : B_pair ω ∈ F_amb a₀ := by
                rw [← ha]; exact hF_mem ω hπ_pos
              have h_in : (∑ b₀ ∈ F_amb a₀, if G_glob ω = a₀ ∧ B_pair ω = b₀ then f_amb ω else 0) =
                  ∑ b₀ ∈ F_amb a₀, if B_pair ω = b₀ then f_amb ω else 0 :=
                Finset.sum_congr rfl (fun b₀ _ => by simp [ha])
              rw [h_in, Finset.sum_ite_eq (F_amb a₀) (B_pair ω) (fun _ => f_amb ω), if_pos hb_mem]
            · refine (Finset.sum_eq_zero (fun b₀ _ => ?_)).symm
              split_ifs with hab
              · exact absurd hab.1 ha
              · rfl
        have h_cell_le : ∀ a₀ ∈ A_pos, ∀ b₀ ∈ F_amb a₀,
            (∑ ω ∈ S_pos, if G_glob ω = a₀ ∧ B_pair ω = b₀ then f_amb ω else 0) ≤
              P_A a₀ / (K_amb : ℝ) := by
          intro a₀ _ b₀ _
          have hPA_nn : 0 ≤ P_A a₀ := Finset.sum_nonneg (fun ω' _ => by split_ifs <;> [exact hπ₁_nn ω'; exact le_rfl])
          let fib := S_pos.filter (fun ω => G_glob ω = a₀ ∧ B_pair ω = b₀)
          have h_sum_fib : (∑ ω ∈ S_pos, if G_glob ω = a₀ ∧ B_pair ω = b₀ then f_amb ω else 0) =
              ∑ ω ∈ fib, f_amb ω := by
            symm
            dsimp only [fib]
            rw [Finset.sum_filter]
            refine Finset.sum_congr rfl (fun ω _ => ?_)
            by_cases hc : G_glob ω = a₀ ∧ B_pair ω = b₀
            · rw [if_pos hc, if_pos hc]
            · rw [if_neg hc, if_neg hc]
          rw [h_sum_fib]
          by_cases h_ne : fib.Nonempty
          · obtain ⟨ω₀, hω₀⟩ := h_ne
            obtain ⟨hω₀_pos, ha₀, hb₀⟩ := Finset.mem_filter.mp hω₀
            have hπ₀ : 0 < π₁ ω₀ := (Finset.mem_filter.mp hω₀_pos).2
            have hpAB₀ : 0 < p_AB ω₀ := by
              dsimp only [p_AB]; unfold finProbAt2
              letI := Classical.propDecidable
              have hle := Finset.single_le_sum
                (f := fun ω' => if G_glob ω' = G_glob ω₀ ∧ B_pair ω' = B_pair ω₀ then π₁ ω' else 0)
                (fun ω' _ => by split_ifs <;> [exact hπ₁_nn ω'; exact le_rfl])
                (Finset.mem_univ ω₀)
              exact lt_of_lt_of_le hπ₀ (by simpa using hle)
            have h_fib_mass : ∑ ω ∈ fib, π₁ ω = p_AB ω₀ := by
              calc ∑ ω ∈ fib, π₁ ω
                  = ∑ ω ∈ S_pos, if G_glob ω = a₀ ∧ B_pair ω = b₀ then π₁ ω else 0 := by
                    dsimp only [fib]
                    rw [Finset.sum_filter]
                    refine Finset.sum_congr rfl (fun ω _ => ?_)
                    by_cases hc : G_glob ω = a₀ ∧ B_pair ω = b₀
                    · rw [if_pos hc, if_pos hc]
                    · rw [if_neg hc, if_neg hc]
                _ = ∑ ω : Fin N_ω, π₁ ω * (if G_glob ω = a₀ ∧ B_pair ω = b₀ then 1 else 0) := by
                    rw [← h_sum_Spos]
                    exact Finset.sum_congr rfl (fun ω _ => by split_ifs <;> ring)
                _ = p_AB ω₀ := by
                    dsimp only [p_AB]; unfold finProbAt2
                    letI := Classical.propDecidable
                    refine Finset.sum_congr rfl (fun ω _ => ?_)
                    have h_iff : (G_glob ω = a₀ ∧ B_pair ω = b₀) ↔
                        (G_glob ω = G_glob ω₀ ∧ B_pair ω = B_pair ω₀) := by
                      rw [ha₀, hb₀]
                    by_cases hc : G_glob ω = a₀ ∧ B_pair ω = b₀
                    · rw [if_pos hc, if_pos (h_iff.mp hc), mul_one]
                    · rw [if_neg hc, if_neg (fun h => hc (h_iff.mpr h)), mul_zero]
            have h_const : ∀ ω ∈ fib, f_amb ω = π₁ ω * (P_A a₀ / ((K_amb : ℝ) * p_AB ω₀)) := by
              intro ω hω
              obtain ⟨_, haw, hbw⟩ := Finset.mem_filter.mp hω
              have he1 : p_A ω = P_A a₀ := by
                dsimp only [p_A, P_A]; unfold finProbAt
                letI := Classical.propDecidable
                refine Finset.sum_congr rfl (fun ω' _ => ?_)
                by_cases hc : G_glob ω' = G_glob ω
                · rw [if_pos hc, if_pos (hc.trans haw)]
                · rw [if_neg hc, if_neg (fun h => hc (h.trans haw.symm))]
              have he2 : p_AB ω = p_AB ω₀ := by
                dsimp only [p_AB]; unfold finProbAt2
                letI := Classical.propDecidable
                refine Finset.sum_congr rfl (fun ω' _ => ?_)
                have h_iff : (G_glob ω' = G_glob ω ∧ B_pair ω' = B_pair ω) ↔
                    (G_glob ω' = G_glob ω₀ ∧ B_pair ω' = B_pair ω₀) := by
                  rw [haw, ha₀, hbw, hb₀]
                by_cases hc : G_glob ω' = G_glob ω ∧ B_pair ω' = B_pair ω
                · rw [if_pos hc, if_pos (h_iff.mp hc)]
                · rw [if_neg hc, if_neg (fun h => hc (h_iff.mpr h))]
              dsimp only [f_amb]
              rw [he1, he2]
            rw [Finset.sum_congr rfl h_const, ← Finset.sum_mul, h_fib_mass]
            exact le_of_eq (by field_simp [hK_pos.ne', hpAB₀.ne'])
          · rw [Finset.not_nonempty_iff_eq_empty.mp h_ne, Finset.sum_empty]
            exact div_nonneg hPA_nn hK_pos.le
        calc ∑ ω ∈ S_pos, f_amb ω
            ≤ ∑ a₀ ∈ A_pos, ∑ _b₀ ∈ F_amb a₀, P_A a₀ / (K_amb : ℝ) := by
              rw [h_partA]
              exact Finset.sum_le_sum (fun a₀ ha₀ =>
                Finset.sum_le_sum (fun b₀ hb₀ => h_cell_le a₀ ha₀ b₀ hb₀))
          _ ≤ ∑ a₀ ∈ A_pos, P_A a₀ := by
              refine Finset.sum_le_sum (fun a₀ _ => ?_)
              have hPA_nn : 0 ≤ P_A a₀ := Finset.sum_nonneg (fun ω' _ => by split_ifs <;> [exact hπ₁_nn ω'; exact le_rfl])
              have hc : ((F_amb a₀).card : ℝ) ≤ (K_amb : ℝ) := by exact_mod_cast hF_card a₀
              rw [Finset.sum_const, nsmul_eq_mul]
              calc ((F_amb a₀).card : ℝ) * (P_A a₀ / (K_amb : ℝ))
                  ≤ (K_amb : ℝ) * (P_A a₀ / (K_amb : ℝ)) :=
                    mul_le_mul_of_nonneg_right hc (div_nonneg hPA_nn hK_pos.le)
                _ = P_A a₀ := mul_div_cancel₀ _ hK_pos.ne'
          _ = 1 := by
              dsimp only [P_A]
              rw [Finset.sum_comm]
              trans (∑ ω' : Fin N_ω, π₁ ω')
              · refine Finset.sum_congr rfl (fun ω' _ => ?_)
                rw [Finset.sum_ite_eq A_pos (G_glob ω') (fun _ => π₁ ω')]
                by_cases h0 : π₁ ω' = 0
                · simp [h0]
                · have hp : 0 < π₁ ω' := lt_of_le_of_ne (hπ₁_nn ω') (Ne.symm h0)
                  exact if_pos (Finset.mem_image_of_mem G_glob
                    (Finset.mem_filter.mpr ⟨Finset.mem_univ ω', hp⟩))
              · exact hπ₁_sum
      have h_weighted := Finset.sum_le_sum (fun ω hω =>
        mul_le_mul_of_nonneg_left (h_pt_ub ω hω) (hπ₁_nn ω))
      have h_lhs_eq :
          (∑ ω ∈ S_pos, π₁ ω * (ell * condSurprise ε π₁ G_glob B_pair ω - Real.log (K_amb : ℝ))) =
          ell * finCondEntropy ε π₁ G_glob B_pair - Real.log (K_amb : ℝ) := by
        have h1 : (∑ ω ∈ S_pos, π₁ ω * (ell * condSurprise ε π₁ G_glob B_pair ω - Real.log (K_amb : ℝ))) =
            ell * (∑ ω ∈ S_pos, π₁ ω * condSurprise ε π₁ G_glob B_pair ω) -
            (∑ ω ∈ S_pos, π₁ ω) * Real.log (K_amb : ℝ) := by
          rw [Finset.mul_sum, Finset.sum_mul, ← Finset.sum_sub_distrib]
          exact Finset.sum_congr rfl (fun ω _ => by ring)
        rw [h1, h_sum_Spos, h_Spos_one, one_mul]
        rfl
      have h_rhs_le0 :
          (∑ ω ∈ S_pos, π₁ ω * (p_A ω / ((K_amb : ℝ) * p_AB ω) - 1)) ≤ 0 := by
        have h1 : (∑ ω ∈ S_pos, π₁ ω * (p_A ω / ((K_amb : ℝ) * p_AB ω) - 1)) =
            (∑ ω ∈ S_pos, π₁ ω * (p_A ω / ((K_amb : ℝ) * p_AB ω))) - (∑ ω ∈ S_pos, π₁ ω) := by
          rw [← Finset.sum_sub_distrib]
          exact Finset.sum_congr rfl (fun ω _ => by ring)
        linarith [h1, h_sum_amb_le1, h_Spos_one]
      rw [le_div_iff₀ hell_pos, mul_comm]
      linarith [h_weighted, h_lhs_eq, h_rhs_le0]

    
    let rootSet := fun (L : ℝ) (π : Fin N_ω → ℝ)
        (V_p A_p : Fin N_T → EuclideanSpace ℝ (Fin 2)) =>
      let p_T : Fin N_T → ℝ := fun tid => ∑ ω : Fin N_ω, if T_idx ω = tid then π ω else 0
      { s : ℝ | ∃ (N_D : ℕ)
          (b_D a_D : Fin N_D → ℝ)
          (e_D V_D A_D : Fin N_D → EuclideanSpace ℝ (Fin 2))
          (q : Fin N_T → Fin N_D → ℝ),
          (∀ d : Fin N_D, 0 ≤ b_D d ∧ b_D d ≤ a_D d ∧ a_D d ≤ L ∧ ‖e_D d‖ = 1) ∧
          (∀ tid d, 0 ≤ q tid d) ∧
          (∀ tid : Fin N_T, ∑ d : Fin N_D, q tid d = p_T tid) ∧
          (∀ tid : Fin N_T, ∀ d : Fin N_D, 0 < q tid d →
            |inner ℝ (V_p tid - V_D d) (e_D d)| ≤ 10 * ε ^ (b_D d) ∧
            |inner ℝ (V_p tid - V_D d) (perp2D (e_D d))| ≤ 10 * ε ^ (a_D d) ∧
            |inner ℝ (A_p tid - A_D d) (e_D d)| ≤ 10 * ε ^ (b_D d) ∧
            |inner ℝ (A_p tid - A_D d) (perp2D (e_D d))| ≤ 10 * ε ^ (a_D d)) ∧
          (let q_D := fun d => ∑ tid : Fin N_T, q tid d
           let I_TD := (∑ tid : Fin N_T, ∑ d : Fin N_D,
             q tid d * Real.log (q tid d / (p_T tid * q_D d))) / ell
           let E_w := ∑ d : Fin N_D, q_D d * ((1 + γ) * b_D d + (1 - γ) * a_D d)
           s = E_w - I_TD) }
    have h_root_reg : ∀ (L : ℝ) (π : Fin N_ω → ℝ)
        (V_p A_p : Fin N_T → EuclideanSpace ℝ (Fin 2)),
        0 ≤ L → (∀ ω, 0 ≤ π ω) → (∑ ω : Fin N_ω, π ω = 1) →
        (∀ tid, ‖V_p tid‖ ≤ 1 ∧ ‖A_p tid‖ ≤ 1) →
        (rootSet L π V_p A_p).Nonempty ∧ BddAbove (rootSet L π V_p A_p) := by
      intro L π V_p A_p hL hπ_nn hπ_sum hVA
      let p_T : Fin N_T → ℝ := fun tid => ∑ ω : Fin N_ω, if T_idx ω = tid then π ω else 0
      have hpT_nn : ∀ tid, 0 ≤ p_T tid := fun tid =>
        Finset.sum_nonneg (fun ω _ => by split_ifs <;> [exact hπ_nn ω; exact le_rfl])
      have hpT_sum : ∑ tid : Fin N_T, p_T tid = 1 := by
        dsimp only [p_T]
        rw [Finset.sum_comm]
        trans (∑ ω : Fin N_ω, π ω)
        · refine Finset.sum_congr rfl (fun ω _ => ?_)
          rw [Finset.sum_ite_eq Finset.univ (T_idx ω) (fun _ => π ω), if_pos (Finset.mem_univ _)]
        · exact hπ_sum
      constructor
      · 
        let e₀ : EuclideanSpace ℝ (Fin 2) := WithLp.toLp 2 ![1, 0]
        have he₀_norm : ‖e₀‖ = 1 := by
          have hsq : ‖e₀‖ ^ 2 = 1 := by
            rw [PiLp.norm_sq_eq_of_L2, Fin.sum_univ_two]
            simp [e₀]
          nlinarith [norm_nonneg e₀, hsq]
        have hp₀_norm : ‖perp2D e₀‖ = 1 := by
          have hsq : ‖perp2D e₀‖ ^ 2 = 1 := by
            rw [PiLp.norm_sq_eq_of_L2, Fin.sum_univ_two]
            simp [perp2D, e₀]
          nlinarith [norm_nonneg (perp2D e₀), hsq]
        refine ⟨0, 1, (fun _ => 0), (fun _ => 0), (fun _ => e₀), (fun _ => 0), (fun _ => 0),
