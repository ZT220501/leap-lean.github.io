      exact ⟨N_j, fun x => lo' x.2, hN1, hN2, fun ω _ => hlo' (sys.R_seq k ω)⟩
    let N_fn : Fin Q → ℕ := fun j => Classical.choose (h_ico_j j)
    let lo_fn : Fin Q → (Fin (sys.N_T k) × ℤ) × ℤ → ℤ :=
