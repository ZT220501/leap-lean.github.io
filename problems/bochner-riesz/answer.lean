        calc 16 * (S_farX.card : ℝ) * (∑ α ∈ S_farX, ‖sub.c_at α‖ ^ 2 * m_1 o α)
            ≤ (16 * (N_ret : ℝ)) * ((T_P.card : ℝ) * (w_max * E_far)) := h_prod
