          rw [div_le_iff₀ Real.pi_pos]
          linarith
        calc (|θ_u2 - θ_u1 + (s : ℝ) * Real.pi| / Real.pi) * (2 : ℝ) ^ m_mu
            ≤ ((8 * (N : ℝ) + 10) * ε ^ d) * (2 * ε ^ (-(m * u))) :=
              mul_le_mul hdiv h2mu_lt.le h2mu_pos.le (by positivity)
          _ = (16 * (N : ℝ) + 20) * (ε ^ d * ε ^ (-(m * u))) := by ring
          _ = (16 * (N : ℝ) + 20) * ε ^ (-ν) := by rw [h_d_sub_mu]
          _ ≤ (N_ang : ℝ) := Nat.le_ceil _
      have h1a : (kang₁ : ℝ) ≤ (θ_u1 / Real.pi) * (2 : ℝ) ^ m_mu := by
        dsimp only [kang₁]; rw [hk1_fl]; exact Int.floor_le _
      have h1b : (θ_u1 / Real.pi) * (2 : ℝ) ^ m_mu < (kang₁ : ℝ) + 1 := by
        dsimp only [kang₁]; rw [hk1_fl]; exact Int.lt_floor_add_one _
      have h2a : (kang₂ : ℝ) ≤ (θ_u2 / Real.pi) * (2 : ℝ) ^ m_mu := by
        dsimp only [kang₂]; rw [hk2_fl]; exact Int.floor_le _
      have h2b : (θ_u2 / Real.pi) * (2 : ℝ) ^ m_mu < (kang₂ : ℝ) + 1 := by
