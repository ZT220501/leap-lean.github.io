  have hσ_t_base : (lam_sys * ρ_t)⁻¹ ≤ cls.B_sys * ε ^ ((H_P + t) / 2) := by
    refine h_inv_ub (a := cls.B_sys⁻¹ * ε ^ (-(H_P + t) / 2))
      (mul_pos hlam_pos hρ_t_pos)
      (mul_nonneg hBsys_pos.le (Real.rpow_nonneg hε_pos.le _)) ?_ ?_
    · have hexp : -(H_P + t) / 2 = -H_P + (H_P - t) / 2 := by ring
      rw [hexp, Real.rpow_add hε_pos, ← mul_assoc]
      exact mul_le_mul_of_nonneg_right hlam_lo hρ_t_pos.le
    · calc (cls.B_sys⁻¹ * ε ^ (-(H_P + t) / 2)) * (cls.B_sys * ε ^ ((H_P + t) / 2))
