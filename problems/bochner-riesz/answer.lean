        intro i b₂
        by_cases hsl : bX i = kX_star ∧ N_bin i = n_star
        · rw [if_pos hsl]
          by_cases hpos : 0 < ν_star i b₂
          · have hG : G_sl i b₂ := ⟨hpos, hsl.1, hsl.2⟩
            rw [@if_pos _ (Classical.propDecidable _) hG]
            have hμ_eq : μ_sl i = ν_P i / p_sl := if_pos hsl
            rw [hμ_eq]
            calc ν_star i b₂ ≤ ρ ^ (-η_sl) * ν_P i * lam₀₁ b₂ := h_pair_dom i b₂
              _ = (p_sl * ρ ^ (-η_sl)) * (ν_P i / p_sl * lam₀₁ b₂) := by
                  field_simp [hp_sl_pos.ne']
          · have h0 : ν_star i b₂ = 0 := le_antisymm (le_of_not_gt hpos) (hν_nn i b₂)
            rw [h0]
            refine mul_nonneg (by positivity) ?_
            split_ifs
            · exact mul_nonneg (hμ_sl_nn i) (hlam_nn b₂)
            · exact le_rfl
        · rw [if_neg hsl]
          refine mul_nonneg (by positivity) ?_
          split_ifs
          · exact mul_nonneg (hμ_sl_nn i) (hlam_nn b₂)
          · exact le_rfl
      have h_sum_lhs : (∑ i : Fin N_P, ∑ b₂ : Fin N_Θ,
          if bX i = kX_star ∧ N_bin i = n_star then ν_star i b₂ else 0) = p_sl := by
        dsimp [p_sl, ν_P]
        refine Finset.sum_congr rfl (fun i _ => ?_)
        split_ifs <;> simp
      have h_sum_le : p_sl ≤ (p_sl * ρ ^ (-η_sl)) *
          ∑ i : Fin N_P, ∑ b₂ : Fin N_Θ,
            @ite ℝ (G_sl i b₂) (Classical.propDecidable _) (μ_sl i * lam₀₁ b₂) 0 := by
        calc p_sl
            = ∑ i : Fin N_P, ∑ b₂ : Fin N_Θ,
                if bX i = kX_star ∧ N_bin i = n_star then ν_star i b₂ else 0 := h_sum_lhs.symm
          _ ≤ ∑ i : Fin N_P, ∑ b₂ : Fin N_Θ,
                (p_sl * ρ ^ (-η_sl)) *
                  @ite ℝ (G_sl i b₂) (Classical.propDecidable _) (μ_sl i * lam₀₁ b₂) 0 :=
              Finset.sum_le_sum (fun i _ => Finset.sum_le_sum (fun b₂ _ => h_pt_inc i b₂))
          _ = (p_sl * ρ ^ (-η_sl)) *
                ∑ i : Fin N_P, ∑ b₂ : Fin N_Θ,
                  @ite ℝ (G_sl i b₂) (Classical.propDecidable _) (μ_sl i * lam₀₁ b₂) 0 := by
              rw [Finset.mul_sum]
              refine Finset.sum_congr rfl (fun _ _ => (Finset.mul_sum _ _ _).symm)
      have h_eta_lb : ρ ^ η_sl ≤
          ∑ i : Fin N_P, ∑ b₂ : Fin N_Θ,
            @ite ℝ (G_sl i b₂) (Classical.propDecidable _) (μ_sl i * lam₀₁ b₂) 0 := by
        have h_pos_fac : 0 < p_sl * ρ ^ (-η_sl) := mul_pos hp_sl_pos (Real.rpow_pos_of_pos hρ _)
        have h_div : p_sl / (p_sl * ρ ^ (-η_sl)) ≤
            ∑ i : Fin N_P, ∑ b₂ : Fin N_Θ,
              @ite ℝ (G_sl i b₂) (Classical.propDecidable _) (μ_sl i * lam₀₁ b₂) 0 := by
          rw [div_le_iff₀ h_pos_fac, mul_comm]
          exact h_sum_le
        have h_simp : p_sl / (p_sl * ρ ^ (-η_sl)) = ρ ^ η_sl := by
          rw [Real.rpow_neg hρ.le]
          field_simp [hp_sl_pos.ne', (Real.rpow_pos_of_pos hρ η_sl).ne']
        rwa [h_simp] at h_div
      exact le_trans
        (Real.rpow_le_rpow_of_exponent_ge hρ hρ_lt1.le (by dsimp [η_sl]; linarith))
        h_eta_lb
    · intro b₂
      obtain ⟨S_cov, hS_card, hS_mem⟩ := h_cov n_star kX_star b₂
      refine ⟨S_cov, hS_card, fun i hG => ?_⟩
      obtain ⟨c₀, hc₀_mem, hc₀_est⟩ := hS_mem i hG.1 hG.2.2 hG.2.1
      refine ⟨c₀, hc₀_mem, ?_⟩
      have hx0 : x_P i 0 = L_hat i := by simp [x_P]
      have hx1 : x_P i 1 = Z₁_hat i := by simp [x_P]
      rw [hx0, hx1]
      exact hc₀_est
  
  have h_pair_ext : ∀ (ϑ δ_sc : ℝ), 0 < ϑ → ϑ ≤ 1 → 0 < δ_sc →
      ∃ N₀ : ℕ, ∀ n : ℕ, N₀ ≤ n →
        let l := prof.φ n
        let ρ := blk.ρ_seq l
        let κ := blk.κ_seq l
        let ω := prof.ω_seq n
        ∃ (b₀ b₁ : Fin (blk.N_Θ l))
