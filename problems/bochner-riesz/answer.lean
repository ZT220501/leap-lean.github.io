    intro o h
    dsimp [win_of]
    rw [dif_pos h]
    exact Classical.choose_spec ((h_winner o).2 h)
  let binOf : Fin N_O → Fin N_D → Fin M_split := fun o d =>
    @ite _ (ε ^ A₀ * E_f ≤ m_obs o) (Classical.propDecidable _)
      ⟨1 + (w_of d * M_c + (win_of o).1), h_bin_lt (w_of d) (win_of o) (hw_of_bounds d).1⟩
      ⟨0, h0_lt_M_split⟩
  have h_partition : ∃ (s : Fin M_split) (p_c : Fin N_O → Fin N_D → ℝ),
      (∀ o d, 0 ≤ p_c o d) ∧
      (∑ o : Fin N_O, ∑ d : Fin N_D, p_c o d = 1) ∧
      (∀ o d, 0 < p_c o d → 0 < p o d ∧ binOf o d = s) ∧
      generalPacketScore ε γ H_P t lam_sys m_time Φ₀ f
        N_O N_D r_O V_O X_O ψ_O b_D a_D p ≤
        generalPacketScore ε γ H_P t lam_sys m_time Φ₀ f
          N_O N_D r_O V_O X_O ψ_O b_D a_D p_c +
          (3 / 2 : ℝ) * (Real.log (M_split : ℝ) / ell) := by
    let q : Fin M_split → Fin N_O → Fin N_D → ℝ :=
