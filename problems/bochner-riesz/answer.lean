        dsimp only [finMutualInfo, finCondEntropy]
        rw [mul_sub, mul_sub, mul_sub]
        simp_rw [Finset.mul_sum, ← Finset.sum_sub_distrib]
        refine Finset.sum_congr rfl (fun ω _ => ?_)
        rcases eq_or_lt_of_le (hπ_nn ω) with h0 | hpos
        · rw [← h0]; simp
        · have hpT_pos := h_prob_pos T_idx ω hpos
          have hpY_pos := h_prob_pos Y ω hpos
          have hpZ_pos := h_prob_pos Z ω hpos
          have hpTY_pos := h_prob_pos (fun ω' => (T_idx ω', Y ω')) ω hpos
          have hpTZ_pos := h_prob_pos (fun ω' => (T_idx ω', Z ω')) ω hpos
          dsimp only [condSurprise, u]
          change ell * (π ω * (-(Real.log (finProbAt2 π (fun _ => ()) Y ω /
