  have rotated_strip_square_averaging_and_overlap :
      ∀ (B_cell ρ σ s : ℝ) (N_mult N_obs : ℕ),
        2 ≤ B_cell → 0 < ρ → 0 < σ → 0 < s → σ ≤ B_cell * s →
        ∀ (V_P x_Z n_P : EuclideanSpace ℝ (Fin 2)), ‖n_P‖ = 1 →
        ∀ (V_O X_O : Fin N_obs → EuclideanSpace ℝ (Fin 2))
          (S_Z : Finset (Fin N_obs)),
          (∀ o ∈ S_Z, ‖V_O o - V_P‖ ≤ B_cell * ρ) →
          (∀ (v₀ x₀ : EuclideanSpace ℝ (Fin 2)) (F : Finset (Fin N_obs)),
            (∀ o ∈ F, ‖V_O o - v₀‖ ≤ ρ ∧ ‖X_O o - x₀‖ ≤ σ) → (F.card : ℝ) ≤ (N_mult : ℝ)) →
          (∀ o ∈ S_Z, |inner ℝ (X_O o - x_Z) n_P| ≤ B_cell * σ ∧
            |inner ℝ (X_O o - x_Z) (perp2D n_P)| ≤ B_cell * s) →
