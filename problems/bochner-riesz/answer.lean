                (Finset.sum_nonneg (fun l _ => hb2_nn l ω)))
          _ = (∑ ω : Fin N_ω, b0 ω) + (∑ l : Fin M, ∑ ω : Fin N_ω, b1 l ω) + p_bad := by
              rw [Finset.sum_add_distrib, Finset.sum_add_distrib,
                Finset.sum_comm (s := Finset.univ) (t := Finset.univ) (f := fun ω l => b1 l ω),
                Finset.sum_comm (s := Finset.univ) (t := Finset.univ) (f := fun ω l => b2 l ω)]
          _ ≤ (ζ / δ_trim) + (M : ℝ) * (ζ / δ_trim) + p_bad :=
              add_le_add (add_le_add (h_markov B) h_sum_b1) le_rfl
      have hM_nn : (0 : ℝ) ≤ (M : ℝ) := Nat.cast_nonneg M
      have h_coeff : (ζ / δ_trim) + (M : ℝ) * (ζ / δ_trim) ≤ (2 * (M : ℝ) + 1) * ζ / δ_trim := by
        have h_eq : (ζ / δ_trim) + (M : ℝ) * (ζ / δ_trim) = ((M : ℝ) + 1) * (ζ / δ_trim) := by
          ring
        have h_eq2 : (2 * (M : ℝ) + 1) * ζ / δ_trim = (2 * (M : ℝ) + 1) * (ζ / δ_trim) :=
