  have hS_time_card : S_time.card ≤ 2 ^ m₁ := by
    dsimp only [S_time]
    rw [Int.card_Ico]
    simp
  have hk_t_mem : ∀ ω : Fin N_ω, 0 < π ω → k_t ω ∈ S_time := by
    intro ω hπω
