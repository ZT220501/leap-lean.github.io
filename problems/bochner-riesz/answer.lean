      refine Finset.sum_congr rfl (fun b₂ _ => ?_)
      split_ifs <;> rfl
    · have h_pt_inc : ∀ (i : Fin N_P) (b₂ : Fin N_Θ),
          (if bX i = kX_star ∧ N_bin i = n_star then ν_star i b₂ else 0) ≤
            (p_sl * ρ ^ (-η_sl)) *
