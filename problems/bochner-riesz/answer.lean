        have hqB_nn' : 0 ≤ ∑ a', q a' b :=
          Finset.sum_nonneg (fun a' _ => by
            dsimp [q]; split_ifs; exact div_nonneg (hGj_nn a' b) hM_pos.le; exact le_rfl)
        have h_prod_μ : μ_child a * lam b ≤
