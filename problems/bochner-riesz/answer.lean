      split_ifs with hPM
      · exact mul_nonneg (hPT_nn α) (div_nonneg (hPMU_nn (M_of α) u) hPM.le)
      · exact le_rfl
    have hQ_sum_u : ∀ α, ∑ u : Fin N_U, Q_TU α u = P_T α := by
