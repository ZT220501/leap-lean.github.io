by
  have h_inner2 : ∀ a b : EuclideanSpace ℝ (Fin 2), inner ℝ a b = a 0 * b 0 + a 1 * b 1 := by
    intro a b
    rw [PiLp.inner_apply, Fin.sum_univ_two]
    simp [mul_comm]
  have h_perp0 : ∀ b : EuclideanSpace ℝ (Fin 2), (perp2D b) 0 = -(b 1) := fun b => by simp [perp2D]
  have h_perp1 : ∀ b : EuclideanSpace ℝ (Fin 2), (perp2D b) 1 = b 0 := fun b => by simp [perp2D]
  have h_norm_sq2 : ∀ a : EuclideanSpace ℝ (Fin 2), ‖a‖ ^ 2 = a 0 ^ 2 + a 1 ^ 2 := by
    intro a
    rw [PiLp.norm_sq_eq_of_L2, Fin.sum_univ_two]
    simp [Real.norm_eq_abs, sq_abs]
  have h_perp_norm : ∀ a : EuclideanSpace ℝ (Fin 2), ‖perp2D a‖ = ‖a‖ := by
    intro a
    rw [← sq_eq_sq₀ (norm_nonneg _) (norm_nonneg _), h_norm_sq2, h_norm_sq2, h_perp0, h_perp1]
    ring
  have h_c1 : ∀ u v w : EuclideanSpace ℝ (Fin 2),
      ‖u‖ = 1 → ‖v‖ = 1 → ‖w‖ = 1 →
      projAngleDist u v = projAngleDist v u ∧
      projAngleDist (perp2D u) (perp2D v) = projAngleDist u v ∧
      projAngleDist u w ≤ projAngleDist u v + projAngleDist v w ∧
      ∀ z : EuclideanSpace ℝ (Fin 2),
        projAngleDist u v * ‖z‖ ≤ |inner ℝ z u| + |inner ℝ z v| := by
    intro u v w hu hv hw
    have hv_sq : v 0 ^ 2 + v 1 ^ 2 = 1 := by
      have h := h_norm_sq2 v
      rw [hv, one_pow] at h
      exact h.symm
    refine ⟨?_, ?_, ?_, ?_⟩
    · unfold projAngleDist
      simp only [h_inner2, h_perp0, h_perp1]
      rw [← abs_neg]
      congr 1; ring
    · unfold projAngleDist
      simp only [h_inner2, h_perp0, h_perp1]
      congr 1; ring
    · have h_ptol : inner ℝ u (perp2D w) =
          inner ℝ u v * inner ℝ v (perp2D w) + inner ℝ u (perp2D v) * inner ℝ v w := by
        simp only [h_inner2, h_perp0, h_perp1]
        calc u 0 * -(w 1) + u 1 * w 0
            = (v 0 ^ 2 + v 1 ^ 2) * (u 0 * -(w 1) + u 1 * w 0) := by rw [hv_sq, one_mul]
          _ = (u 0 * v 0 + u 1 * v 1) * (v 0 * -(w 1) + v 1 * w 0) +
              (u 0 * -(v 1) + u 1 * v 0) * (v 0 * w 0 + v 1 * w 1) := by ring
      have huv_le : |inner ℝ u v| ≤ 1 := by
        calc |inner ℝ u v| ≤ ‖u‖ * ‖v‖ := abs_real_inner_le_norm u v
          _ = 1 := by rw [hu, hv, one_mul]
      have hvw_le : |inner ℝ v w| ≤ 1 := by
        calc |inner ℝ v w| ≤ ‖v‖ * ‖w‖ := abs_real_inner_le_norm v w
          _ = 1 := by rw [hv, hw, one_mul]
      unfold projAngleDist
      rw [h_ptol]
      calc |inner ℝ u v * inner ℝ v (perp2D w) + inner ℝ u (perp2D v) * inner ℝ v w|
