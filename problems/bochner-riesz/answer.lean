        refine ⟨hΨ₂_int_k, ?_⟩
        rw [MeasureTheory.setIntegral_congr_fun hB_half_meas h_eq_on]
        rw [← h_fubini_3fold F_H M_H (-K_M m) (K_M m) (δ_M m) (1 - δ_M m)
