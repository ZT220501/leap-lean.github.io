    have h_grad2D_smooth : ∀ k : ℕ, ContDiff ℝ k pcConvexifiedDistGrad2D := fun k =>
      (contDiff_const.mul ((h_profile_smooth k).comp (contDiff_id.norm_sq ℝ))).smul contDiff_id
    have h_fd_grad2D_smooth : ∀ k : ℕ, ContDiff ℝ k (fderiv ℝ pcConvexifiedDistGrad2D) := by
      intro k
      have h1 : ContDiff ℝ ((k : WithTop ℕ∞) + 1) pcConvexifiedDistGrad2D := h_grad2D_smooth (k + 1)
      exact h1.fderiv_right le_rfl
    set A : ℝ := 144 * Real.pi * A₀
    have hA_ge_one : 1 ≤ A := by
      have hpi : (2 : ℝ) ≤ Real.pi := Real.two_le_pi
