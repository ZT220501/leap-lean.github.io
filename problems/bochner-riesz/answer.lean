          Filter.univ_mem ?_ ?_ ?_ ?_ intervalIntegrable_const ?_
        · refine Filter.Eventually.of_forall (fun y => ?_)
          rw [Set.uIoc_of_le zero_le_one]
          exact (((hDK_cont m).comp (Continuous.prodMk continuous_id continuous_const)).intervalIntegrable 0 1).1.aestronglyMeasurable
        · exact ((hDK_cont m).comp (Continuous.prodMk continuous_id continuous_const)).intervalIntegrable 0 1
        · rw [Set.uIoc_of_le zero_le_one]
          exact h_curry_int.1.aestronglyMeasurable
