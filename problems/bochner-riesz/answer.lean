    rw [h_prob2_unit, h_prob_unit, div_one,
      Real.log_div (ne_of_gt hpTY) (ne_of_gt hpT)]
    field_simp [hell_ne]
    ring
  let TDG : Fin N_ω → Fin N_T × Fin N_raw × (ℤ × ℤ × ℤ × ℤ × ℤ × ℤ) :=
    fun ω => (T_idx ω, D_hat ω, G_star ω)
  let P_D : Fin N_raw → ℝ := fun d => ∑ ω ∈ Ω_pos, if D_hat ω = d then π ω else 0
  let P_G : (ℤ × ℤ × ℤ × ℤ × ℤ × ℤ) → ℝ := fun g =>
    ∑ ω ∈ Ω_pos, if G_star ω = g then π ω else 0
  let P_TG : Fin N_T → (ℤ × ℤ × ℤ × ℤ × ℤ × ℤ) → ℝ := fun t g =>
    ∑ ω ∈ Ω_pos, if T_idx ω = t ∧ G_star ω = g then π ω else 0
  let P_TDG : Fin N_T → Fin N_raw → (ℤ × ℤ × ℤ × ℤ × ℤ × ℤ) → ℝ := fun t d g =>
    ∑ ω ∈ Ω_pos, if T_idx ω = t ∧ D_hat ω = d ∧ G_star ω = g then π ω else 0
  let z_fn : Fin N_ω → ℝ := fun ω =>
    (finProbAt π D_hat ω * finProbAt2 π T_idx G_star ω) /
      ((M_rnd : ℝ) * finProbAt π TDG ω * finProbAt π G_star ω)
  have h_sum_z_le1 : ∑ ω ∈ Ω_pos, π ω * z_fn ω ≤ 1 := by
    let S_T : Finset (Fin N_T) := Ω_pos.image T_idx
    let S_D : Finset (Fin N_raw) := Ω_pos.image D_hat
    let S_G_all : Finset (ℤ × ℤ × ℤ × ℤ × ℤ × ℤ) := Ω_pos.image G_star
    let S_G : Fin N_raw → Finset (ℤ × ℤ × ℤ × ℤ × ℤ × ℤ) :=
      fun d => S_cand d ∩ S_G_all
    have hPG_pos : ∀ g ∈ S_G_all, 0 < P_G g := by
      intro g hg
      obtain ⟨ω₀, hω₀_mem, rfl⟩ := Finset.mem_image.mp hg
      have hπ₀ : 0 < π ω₀ := (h_mem_pos ω₀).mp hω₀_mem
      have h_le : (if G_star ω₀ = G_star ω₀ then π ω₀ else 0) ≤ P_G (G_star ω₀) :=
        Finset.single_le_sum (f := fun ω' => if G_star ω' = G_star ω₀ then π ω' else (0 : ℝ))
          (fun ω' _ => by split_ifs; exact h_law.1 ω'; exact le_rfl) hω₀_mem
      simp only [↓reduceIte] at h_le
      exact lt_of_lt_of_le hπ₀ h_le
    have hPD_nn : ∀ d, 0 ≤ P_D d :=
      fun d => Finset.sum_nonneg (fun ω _ => by split_ifs; exact h_law.1 ω; exact le_rfl)
    have hPTG_nn : ∀ t g, 0 ≤ P_TG t g :=
      fun t g => Finset.sum_nonneg (fun ω _ => by split_ifs; exact h_law.1 ω; exact le_rfl)
    have h_z_val : ∀ ω ∈ Ω_pos,
        z_fn ω = (P_D (D_hat ω) * P_TG (T_idx ω) (G_star ω)) /
          ((M_rnd : ℝ) * P_TDG (T_idx ω) (D_hat ω) (G_star ω) * P_G (G_star ω)) := by
      intro ω _
      have h1 : finProbAt π D_hat ω = P_D (D_hat ω) := h_prob_eq_pos D_hat ω
      have h2 : finProbAt π G_star ω = P_G (G_star ω) := h_prob_eq_pos G_star ω
      have h3 : finProbAt2 π T_idx G_star ω = P_TG (T_idx ω) (G_star ω) := by
        dsimp only [finProbAt2, P_TG]
        trans (∑ ω' : Fin N_ω, if T_idx ω' = T_idx ω ∧ G_star ω' = G_star ω then π ω' else 0)
        · refine Finset.sum_congr rfl (fun ω' _ => ?_)
          by_cases hc : T_idx ω' = T_idx ω ∧ G_star ω' = G_star ω <;> simp [hc]
        · symm
          refine Finset.sum_subset (Finset.subset_univ Ω_pos) (fun ω' _ hnot => ?_)
          have h_not_pos : ¬ 0 < π ω' := fun hp => hnot ((h_mem_pos ω').mpr hp)
          have h0 : π ω' = 0 := le_antisymm (le_of_not_gt h_not_pos) (h_law.1 ω')
          simp [h0]
      have h4 : finProbAt π TDG ω = P_TDG (T_idx ω) (D_hat ω) (G_star ω) := by
        dsimp only [finProbAt, TDG, P_TDG]
        trans (∑ ω' : Fin N_ω,
          if T_idx ω' = T_idx ω ∧ D_hat ω' = D_hat ω ∧ G_star ω' = G_star ω then π ω' else 0)
        · refine Finset.sum_congr rfl (fun ω' _ => ?_)
          by_cases hc : T_idx ω' = T_idx ω ∧ D_hat ω' = D_hat ω ∧ G_star ω' = G_star ω
          · simp [hc]
          · have hp : (T_idx ω', D_hat ω', G_star ω') ≠ (T_idx ω, D_hat ω, G_star ω) :=
              fun heq => hc ⟨congr_arg Prod.fst heq,
                congr_arg (Prod.fst ∘ Prod.snd) heq,
                congr_arg (Prod.snd ∘ Prod.snd) heq⟩
            simp [hc, hp]
        · symm
          refine Finset.sum_subset (Finset.subset_univ Ω_pos) (fun ω' _ hnot => ?_)
          have h_not_pos : ¬ 0 < π ω' := fun hp => hnot ((h_mem_pos ω').mpr hp)
          have h0 : π ω' = 0 := le_antisymm (le_of_not_gt h_not_pos) (h_law.1 ω')
          simp [h0]
      dsimp only [z_fn]
      rw [h1, h2, h3, h4]
    have h_pt_triple : ∀ ω ∈ Ω_pos,
        π ω * z_fn ω = ∑ d ∈ S_D, ∑ g ∈ S_G d, ∑ t ∈ S_T,
          if T_idx ω = t ∧ D_hat ω = d ∧ G_star ω = g then
            π ω * ((P_D d * P_TG t g) / ((M_rnd : ℝ) * P_TDG t d g * P_G g))
          else 0 := by
      intro ω hω
      have hπ_pos : 0 < π ω := (h_mem_pos ω).mp hω
      have hd_mem : D_hat ω ∈ S_D := Finset.mem_image_of_mem D_hat hω
      have hg_all : G_star ω ∈ S_G_all := Finset.mem_image_of_mem G_star hω
      have hg_mem : G_star ω ∈ S_G (D_hat ω) :=
        Finset.mem_inter.mpr ⟨hG_mem ω hπ_pos, hg_all⟩
      have ht_mem : T_idx ω ∈ S_T := Finset.mem_image_of_mem T_idx hω
      have h_inner_t : ∀ d g,
          (∑ t ∈ S_T, if T_idx ω = t ∧ D_hat ω = d ∧ G_star ω = g then
            π ω * ((P_D d * P_TG t g) / ((M_rnd : ℝ) * P_TDG t d g * P_G g)) else 0) =
          if D_hat ω = d ∧ G_star ω = g then
            π ω * ((P_D d * P_TG (T_idx ω) g) / ((M_rnd : ℝ) * P_TDG (T_idx ω) d g * P_G g))
          else 0 := by
        intro d g
        rw [Finset.sum_eq_single (T_idx ω)]
        · by_cases hdg : D_hat ω = d ∧ G_star ω = g <;> simp [hdg]
        · intro t _ hne; simp [Ne.symm hne]
        · intro hnot; exact absurd ht_mem hnot
      simp_rw [h_inner_t]
      have h_inner_g : ∀ d,
          (∑ g ∈ S_G d, if D_hat ω = d ∧ G_star ω = g then
            π ω * ((P_D d * P_TG (T_idx ω) g) / ((M_rnd : ℝ) * P_TDG (T_idx ω) d g * P_G g))
          else 0) =
          if D_hat ω = d then
            π ω * ((P_D d * P_TG (T_idx ω) (G_star ω)) /
              ((M_rnd : ℝ) * P_TDG (T_idx ω) d (G_star ω) * P_G (G_star ω)))
          else 0 := by
        intro d
        by_cases hd : D_hat ω = d
        · subst hd
          rw [Finset.sum_eq_single (G_star ω)]
          · simp
          · intro g _ hne; simp [Ne.symm hne]
          · intro hnot; exact absurd hg_mem hnot
        · simp [hd]
      simp_rw [h_inner_g]
      rw [Finset.sum_eq_single (D_hat ω)]
      · simp only [↓reduceIte, h_z_val ω hω]
      · intro d _ hne; simp [Ne.symm hne]
      · intro hnot; exact absurd hd_mem hnot
    have h_swap : (∑ ω ∈ Ω_pos, π ω * z_fn ω) =
        ∑ d ∈ S_D, ∑ g ∈ S_G d, ∑ t ∈ S_T,
          P_TDG t d g * ((P_D d * P_TG t g) / ((M_rnd : ℝ) * P_TDG t d g * P_G g)) := by
      rw [Finset.sum_congr rfl h_pt_triple, Finset.sum_comm]
      refine Finset.sum_congr rfl (fun d _ => ?_)
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl (fun g _ => ?_)
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl (fun t _ => ?_)
      let c_tdg : ℝ := (P_D d * P_TG t g) / ((M_rnd : ℝ) * P_TDG t d g * P_G g)
      have h_sm := Finset.sum_mul Ω_pos
        (fun ω => if T_idx ω = t ∧ D_hat ω = d ∧ G_star ω = g then π ω else 0) c_tdg
      change (∑ ω ∈ Ω_pos,
          if T_idx ω = t ∧ D_hat ω = d ∧ G_star ω = g then π ω * c_tdg else 0) =
        P_TDG t d g * c_tdg
      dsimp only [P_TDG]
      rw [h_sm]
      refine Finset.sum_congr rfl (fun ω _ => ?_)
      split_ifs <;> ring
    rw [h_swap]
    have h_step_t : ∀ d ∈ S_D, ∀ g ∈ S_G d,
        (∑ t ∈ S_T, P_TDG t d g * ((P_D d * P_TG t g) / ((M_rnd : ℝ) * P_TDG t d g * P_G g))) ≤
          P_D d / (M_rnd : ℝ) := by
      intro d _ g hg
