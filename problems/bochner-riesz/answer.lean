        · intro j
          obtain ⟨hb0, hba, ha_min, he⟩ := h_ap j
          refine ⟨div_nonneg hb0 hd.le, div_le_div_of_nonneg_right hba hd.le,
            le_min ?_ ?_, he⟩
          · exact div_le_div_of_nonneg_right (le_trans ha_min (min_le_left _ _)) hd.le
          · calc a j / d ≤ (H_P / 2) / d :=
