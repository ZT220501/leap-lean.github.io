          have ht1 : |inner ℝ δV e_dir₁ * inner ℝ e_dir₁ (perp2D e_dir₂)| ≤
              (1 / 2) * (Real.pi * ε ^ (e₂ - Δe)) := by
            rw [abs_mul]
            exact mul_le_mul hδV_e1 (h_rot_ep.trans h_phi_diff) (abs_nonneg _) (by norm_num)
          have ht2 : |inner ℝ δV (perp2D e_dir₁) * inner ℝ (perp2D e_dir₁) (perp2D e_dir₂)| ≤
              ε ^ (e₂ - Δe) * 1 := by
            rw [abs_mul]
            exact mul_le_mul hδV_p1 h_rot_pp (abs_nonneg _) (by positivity)
          have h_tri := abs_add_le
            (inner ℝ δV e_dir₁ * inner ℝ e_dir₁ (perp2D e_dir₂))
            (inner ℝ δV (perp2D e_dir₁) * inner ℝ (perp2D e_dir₁) (perp2D e_dir₂))
          have h_pow_pos : 0 < ε ^ (e₂ - Δe) := Real.rpow_pos_of_pos hε₀ _
          nlinarith
        have h_mem_xb : dyadicRealBin ε (0 + 1) (inner ℝ x_p e_dir₂) ∈ I_xb kr₂ := by
          refine ((h_dyadicReal ε (0 + 1) hε₀ hε₁).2.2.2.2
            (inner ℝ x_hat e_dir₂) (2 * ε) (by positivity)).1 _ ?_
          have h_sub_in : inner ℝ x_p e_dir₂ - inner ℝ x_hat e_dir₂ =
              inner ℝ δX e_dir₁ * inner ℝ e_dir₁ e_dir₂ +
              inner ℝ δX (perp2D e_dir₁) * inner ℝ (perp2D e_dir₁) e_dir₂ := by
            rw [← inner_sub_left]
            change inner ℝ δX e_dir₂ = _
            conv_lhs => rw [h_exp1 δX]
            rw [inner_add_left, inner_smul_left, inner_smul_left]
            simp
          rw [h_sub_in]
          have ht1 : |inner ℝ δX e_dir₁ * inner ℝ e_dir₁ e_dir₂| ≤ ε * 1 := by
            rw [abs_mul]
            exact mul_le_mul hδX_e1 h_rot_ee (abs_nonneg _) hε₀.le
          have hpe_le1 : |inner ℝ (perp2D e_dir₁) e_dir₂| ≤ 1 :=
            (abs_real_inner_le_norm (perp2D e_dir₁) e_dir₂).trans
              (by rw [(h_orthonorm e_dir₁ he1_norm).1, he2_norm, mul_one])
          have ht2 : |inner ℝ δX (perp2D e_dir₁) * inner ℝ (perp2D e_dir₁) e_dir₂| ≤ ε * 1 := by
            rw [abs_mul]
            exact mul_le_mul hδX_p1_eps hpe_le1 (abs_nonneg _) hε₀.le
          have h_tri := abs_add_le
            (inner ℝ δX e_dir₁ * inner ℝ e_dir₁ e_dir₂)
            (inner ℝ δX (perp2D e_dir₁) * inner ℝ (perp2D e_dir₁) e_dir₂)
          linarith
        have h_mem_xa : dyadicRealBin ε (e₂ + 1) (inner ℝ x_p (perp2D e_dir₂)) ∈ I_xa kr₂ := by
          refine ((h_dyadicReal ε (e₂ + 1) hε₀ hε₁).2.2.2.2
            (inner ℝ x_hat (perp2D e_dir₂)) (5 * ε ^ (e₂ + 1 - Δe)) (by positivity)).1 _ ?_
          have h_sub_in : inner ℝ x_p (perp2D e_dir₂) - inner ℝ x_hat (perp2D e_dir₂) =
              inner ℝ δX e_dir₁ * inner ℝ e_dir₁ (perp2D e_dir₂) +
              inner ℝ δX (perp2D e_dir₁) * inner ℝ (perp2D e_dir₁) (perp2D e_dir₂) := by
            rw [← inner_sub_left]
            change inner ℝ δX (perp2D e_dir₂) = _
            conv_lhs => rw [h_exp1 δX]
            rw [inner_add_left, inner_smul_left, inner_smul_left]
            simp
          rw [h_sub_in]
          have h_exp_prod : ε * (Real.pi * ε ^ (e₂ - Δe)) = Real.pi * ε ^ (e₂ + 1 - Δe) := by
            have h1 : ε ^ (1 : ℝ) * ε ^ (e₂ - Δe) = ε ^ (e₂ + 1 - Δe) := by
              rw [← Real.rpow_add hε₀]
              congr 1; ring
            rw [Real.rpow_one] at h1
            calc ε * (Real.pi * ε ^ (e₂ - Δe))
                = Real.pi * (ε * ε ^ (e₂ - Δe)) := by ring
              _ = Real.pi * ε ^ (e₂ + 1 - Δe) := by rw [h1]
          have ht1 : |inner ℝ δX e_dir₁ * inner ℝ e_dir₁ (perp2D e_dir₂)| ≤
              Real.pi * ε ^ (e₂ + 1 - Δe) := by
            rw [abs_mul, ← h_exp_prod]
            exact mul_le_mul hδX_e1 (h_rot_ep.trans h_phi_diff) (abs_nonneg _) hε₀.le
          have ht2 : |inner ℝ δX (perp2D e_dir₁) * inner ℝ (perp2D e_dir₁) (perp2D e_dir₂)| ≤
              ε ^ (e₂ + 1 - Δe) * 1 := by
            rw [abs_mul]
            exact mul_le_mul hδX_p1_rot h_rot_pp (abs_nonneg _) (by positivity)
          have h_tri := abs_add_le
            (inner ℝ δX e_dir₁ * inner ℝ e_dir₁ (perp2D e_dir₂))
            (inner ℝ δX (perp2D e_dir₁) * inner ℝ (perp2D e_dir₁) (perp2D e_dir₂))
          have h_pow_pos : 0 < ε ^ (e₂ + 1 - Δe) := Real.rpow_pos_of_pos hε₀ _
          nlinarith
        
        dsimp only [S_box]
        rw [Finset.mem_biUnion]
        refine ⟨kr₂, hkr2_mem, ?_⟩
        dsimp only [boxAt, G₂, stdApertureObs]
        simp only [h_sub2, hkt_eq]
        change (kt₁, kr₂,
          dyadicRealBin ε 0 (inner ℝ V_p e_dir₂),
          dyadicRealBin ε e₂ (inner ℝ V_p (perp2D e_dir₂)),
          dyadicRealBin ε (0 + 1) (inner ℝ x_p e_dir₂),
          dyadicRealBin ε (e₂ + 1) (inner ℝ x_p (perp2D e_dir₂))) ∈
          ({kt₁} : Finset ℤ) ×ˢ (({kr₂} : Finset ℤ) ×ˢ
            (I_vb ×ˢ (I_va kr₂ ×ˢ (I_xb kr₂ ×ˢ I_xa kr₂))))
        simp only [Finset.mem_product, Finset.mem_singleton, true_and]
        exact ⟨h_mem_vb, h_mem_va, h_mem_xb, h_mem_xa⟩
    
    have h_log_M_ub : Real.log M_fib / ell ≤ 3 * Δe + 12 / ell := by
      dsimp only [M_fib]
      have h_pow_pos : 0 < ε ^ (-3 * Δe) := Real.rpow_pos_of_pos hε₀ _
      rw [Real.log_mul (by positivity) h_pow_pos.ne',
          Real.log_pow, Real.log_rpow hε₀]
      have h_log_inv_eq : (-3 * Δe) * Real.log ε = 3 * Δe * ell := by
        dsimp only [ell]
        rw [Real.log_inv]
        ring
      rw [h_log_inv_eq]
      have h12_le : ((12 : ℕ) : ℝ) * Real.log 2 ≤ 12 := by
        push_cast; linarith [h_log2_le1]
      have h_sum_le : ((12 : ℕ) : ℝ) * Real.log 2 + 3 * Δe * ell ≤ 12 + 3 * Δe * ell := by
        linarith
      calc (((12 : ℕ) : ℝ) * Real.log 2 + 3 * Δe * ell) / ell
          ≤ (12 + 3 * Δe * ell) / ell := div_le_div_of_nonneg_right h_sum_le hell_pos.le
        _ = 12 / ell + (3 * Δe * ell) / ell := add_div _ _ _
        _ = 3 * Δe + 12 / ell := by
            rw [mul_div_cancel_right₀ _ hell_pos.ne']
            ring
    have h_mi_diff :
        finMutualInfo ε π T_idx G₂ - finMutualInfo ε π T_idx G₁ ≤ 3 * Δe + 12 / ell :=
      h_mi_le_cond.trans (h_cond_le.trans h_log_M_ub)
    have h_root_lip := (h_root_props ε hε₀ hε₁ π T_idx V_part A_part hπ_nn hπ_sum hVA).2
      (1 + e₁) (1 + e₂) (by linarith) (by linarith)
    have h_sub_1e : (1 + e₂) - (1 + e₁) = e₂ - e₁ := by ring
    rw [h_sub_1e] at h_root_lip
    unfold stdApertureScore
    change (((1 + γ) * 0 + (1 - γ) * e₁ - finMutualInfo ε π T_idx G₁ +
        2 * finCondEntropy ε π T_idx (fun ω => dyadicTimeBin ε 1 (c_s ω))) -
        classicalRootSupremum ε (1 + e₁) γ N_ω N_T π T_idx V_part A_part) -
        5 * |e₂ - e₁| - 12 / ell ≤
      ((1 + γ) * 0 + (1 - γ) * e₂ - finMutualInfo ε π T_idx G₂ +
        2 * finCondEntropy ε π T_idx (fun ω => dyadicTimeBin ε 1 (c_s ω))) -
        classicalRootSupremum ε (1 + e₂) γ N_ω N_T π T_idx V_part A_part
    dsimp only [Δe] at h_mi_diff
    rcases le_or_gt e₂ e₁ with h_le | h_gt
    · rw [max_eq_right (by linarith)] at h_mi_diff h_root_lip
      rw [abs_of_nonpos (by linarith)]
      have h_lin : -(5 * (e₁ - e₂)) ≤ (1 - γ) * (e₂ - e₁) := by nlinarith
      linarith
    · rw [max_eq_left (by linarith)] at h_mi_diff h_root_lip
      rw [abs_of_pos (by linarith)]
      have h_lin : 0 ≤ (1 - γ) * (e₂ - e₁) := by nlinarith
      linarith

theorem unit_ball_mesh_shape_reduction (γ B_cl K_hor ε t L Δ_time ξ : ℝ)
    (hγ₀ : 0 < γ) (hγ₁ : γ < 1)
    (hB : 1 ≤ B_cl) (hK : 1 ≤ K_hor)
    (hε₀ : 0 < ε) (hε₁ : ε < 1 / 2)
    (ht : 0 < t) (htL : t ≤ L) (hLK : L ≤ K_hor)
    (hξ : 0 < ξ)
    {N_ω N_T N_G : ℕ}
    (π : Fin N_ω → ℝ)
    (T_idx : Fin N_ω → Fin N_T)
    (k_time : Fin N_ω → ℤ)
    (G_idx : Fin N_ω → Fin N_G)
    (V_part A_part : Fin N_T → EuclideanSpace ℝ (Fin 2))
    (b_G a_G : Fin N_G → ℝ)
    (e_G V_G X_G : Fin N_G → EuclideanSpace ℝ (Fin 2))
    (k_G : Fin N_G → ℤ)
    (hπ_nn : ∀ ω, 0 ≤ π ω)
    (hπ_sum : ∑ ω : Fin N_ω, π ω = 1)
    (hVA : ∀ tid, ‖V_part tid‖ ≤ B_cl ∧ ‖A_part tid‖ ≤ B_cl)
    (hG_adm : ∀ g, 0 ≤ b_G g ∧ b_G g ≤ a_G g ∧ a_G g + t ≤ L ∧ ‖e_G g‖ = 1)
    (h_supp : ∀ ω, 0 < π ω →
      let tid := T_idx ω
      let g := G_idx ω
      let c_mid := ((k_time ω : ℝ) + 1 / 2) * Δ_time
      c_mid ∈ Set.Icc (0 : ℝ) 1 ∧
      k_G g = k_time ω ∧
      |inner ℝ (V_part tid - V_G g) (e_G g)| ≤ B_cl * ε ^ (b_G g) ∧
      |inner ℝ (V_part tid - V_G g) (perp2D (e_G g))| ≤ B_cl * ε ^ (a_G g) ∧
      |inner ℝ ((A_part tid + c_mid • V_part tid) - X_G g) (e_G g)| ≤
        B_cl * ε ^ (b_G g + t) ∧
      |inner ℝ ((A_part tid + c_mid • V_part tid) - X_G g) (perp2D (e_G g))| ≤
        B_cl * ε ^ (a_G g + t)) :
    ∃ (b_star a_star : ℝ)
      (π₁ : Fin N_ω → ℝ)
      (V₁ A₁ : Fin N_T → EuclideanSpace ℝ (Fin 2))
      (V_G1 X_G1 : Fin N_G → EuclideanSpace ℝ (Fin 2)),
      0 ≤ b_star ∧ b_star ≤ a_star ∧ a_star + t ≤ L ∧
      (∀ ω, 0 ≤ π₁ ω) ∧ (∑ ω : Fin N_ω, π₁ ω = 1) ∧
      (∀ tid, ‖V₁ tid‖ ≤ 1 ∧ ‖A₁ tid‖ ≤ 1) ∧
      (∀ ω, 0 < π₁ ω →
        let tid := T_idx ω
        let g := G_idx ω
        let c_mid := ((k_time ω : ℝ) + 1 / 2) * Δ_time
        c_mid ∈ Set.Icc (0 : ℝ) 1 ∧
        k_G g = k_time ω ∧
        |inner ℝ (V₁ tid - V_G1 g) (e_G g)| ≤ ε ^ b_star ∧
        |inner ℝ (V₁ tid - V_G1 g) (perp2D (e_G g))| ≤ ε ^ a_star ∧
        |inner ℝ ((A₁ tid + c_mid • V₁ tid) - X_G1 g) (e_G g)| ≤
          ε ^ (b_star + t) ∧
        |inner ℝ ((A₁ tid + c_mid • V₁ tid) - X_G1 g) (perp2D (e_G g))| ≤
          ε ^ (a_star + t)) ∧
      classicalTransportScore ε γ N_ω N_T N_G π T_idx k_time G_idx b_G a_G -
        classicalRootSupremum ε L γ N_ω N_T π T_idx V_part A_part ≤
      classicalTransportScore ε γ N_ω N_T N_G π₁ T_idx k_time G_idx
          (fun _ => b_star) (fun _ => a_star) -
        classicalRootSupremum ε (a_star + t) γ N_ω N_T π₁ T_idx V₁ A₁ +
        2 * ξ +
        (4 * Real.log ((2 * ⌈B_cl⌉₊ + 1 : ℕ) : ℝ) +
          4 * Real.log ((⌊K_hor / ξ⌋₊ + 1 : ℕ) : ℝ) + 1) / Real.log (ε⁻¹) :=
by
  have hB_pos : 0 < B_cl := by linarith
  have hB_ne : B_cl ≠ 0 := ne_of_gt hB_pos
  have hB_inv_pos : 0 < B_cl⁻¹ := inv_pos.mpr hB_pos
  have hε_lt_one : ε < 1 := by linarith
  have hε_le_one : ε ≤ 1 := hε_lt_one.le
  have hL_nn : 0 ≤ L := by linarith
  let ell : ℝ := Real.log (ε⁻¹)
  have hell_pos : 0 < ell := Real.log_pos ((one_lt_inv₀ hε₀).mpr hε_lt_one)
  have hell_ne : ell ≠ 0 := ne_of_gt hell_pos

  let V₁ : Fin N_T → EuclideanSpace ℝ (Fin 2) := fun tid => B_cl⁻¹ • V_part tid
  let A₁ : Fin N_T → EuclideanSpace ℝ (Fin 2) := fun tid => B_cl⁻¹ • A_part tid
  let V_G1 : Fin N_G → EuclideanSpace ℝ (Fin 2) := fun g => B_cl⁻¹ • V_G g
  let X_G1 : Fin N_G → EuclideanSpace ℝ (Fin 2) := fun g => B_cl⁻¹ • X_G g

  have hVA₁ : ∀ tid, ‖V₁ tid‖ ≤ 1 ∧ ‖A₁ tid‖ ≤ 1 := by
    intro tid
    constructor
    · dsimp only [V₁]
      rw [norm_smul, Real.norm_of_nonneg hB_inv_pos.le]
      calc B_cl⁻¹ * ‖V_part tid‖ ≤ B_cl⁻¹ * B_cl :=
            mul_le_mul_of_nonneg_left (hVA tid).1 hB_inv_pos.le
        _ = 1 := inv_mul_cancel₀ hB_ne
    · dsimp only [A₁]
      rw [norm_smul, Real.norm_of_nonneg hB_inv_pos.le]
      calc B_cl⁻¹ * ‖A_part tid‖ ≤ B_cl⁻¹ * B_cl :=
            mul_le_mul_of_nonneg_left (hVA tid).2 hB_inv_pos.le
        _ = 1 := inv_mul_cancel₀ hB_ne

  
  have h_ent_card : ∀ {α : Type} (S : Finset α) (w : α → ℝ) (W : ℝ),
      0 < S.card → (∀ x ∈ S, 0 ≤ w x) → (∑ x ∈ S, w x = W) →
      ∑ x ∈ S, -(w x * Real.log (w x / W)) ≤ W * Real.log (S.card : ℝ) := by
    intro α S w W hS_card hw_nn hw_sum
    by_cases hW0 : W = 0
    · subst hW0
      simp
    · have hW_nn : 0 ≤ W := hw_sum ▸ Finset.sum_nonneg hw_nn
      have hW_pos : 0 < W := lt_of_le_of_ne hW_nn (Ne.symm hW0)
      let N : ℝ := (S.card : ℝ)
      have hN_pos : 0 < N := Nat.cast_pos.mpr hS_card
      have h_term : ∀ x ∈ S, -(w x * Real.log (w x / W)) - w x * Real.log N ≤ W / N - w x := by
        intro x hx
        by_cases hwx0 : w x = 0
        · rw [hwx0]
          simp only [zero_div, Real.log_zero, mul_zero, zero_mul, neg_zero, sub_zero]
          exact div_nonneg hW_pos.le hN_pos.le
        · have hwx_pos : 0 < w x := lt_of_le_of_ne (hw_nn x hx) (Ne.symm hwx0)
          have hWN_pos : 0 < W / N := div_pos hW_pos hN_pos
          have hu_pos : 0 < (W / N) / w x := div_pos hWN_pos hwx_pos
          have hlog_le := Real.log_le_sub_one_of_pos hu_pos
          have hlog_eq : Real.log ((W / N) / w x) = -(Real.log (w x / W)) - Real.log N := by
            rw [Real.log_div (ne_of_gt hWN_pos) (ne_of_gt hwx_pos),
              Real.log_div (ne_of_gt hW_pos) (ne_of_gt hN_pos),
              Real.log_div (ne_of_gt hwx_pos) (ne_of_gt hW_pos)]
            ring
          rw [hlog_eq] at hlog_le
          have hmul := mul_le_mul_of_nonneg_left hlog_le hwx_pos.le
          have hlhs : w x * (-Real.log (w x / W) - Real.log N) =
              -(w x * Real.log (w x / W)) - w x * Real.log N := by ring
          have hrhs : w x * (W / N / w x - 1) = W / N - w x := by
            rw [mul_sub, mul_one, mul_div_cancel₀ _ (ne_of_gt hwx_pos)]
          linarith
      have h_sum := Finset.sum_le_sum h_term
      rw [Finset.sum_sub_distrib, ← Finset.sum_mul, Finset.sum_sub_distrib,
        Finset.sum_const, nsmul_eq_mul, hw_sum] at h_sum
      have hN_mul : (S.card : ℝ) * (W / N) = W := mul_div_cancel₀ W (ne_of_gt hN_pos)
      linarith

  have h_mi_nonneg : ∀ (p_T' : Fin N_T → ℝ),
      (∀ tid, 0 ≤ p_T' tid) → (∑ tid : Fin N_T, p_T' tid = 1) →
      ∀ (N_D : ℕ) (q : Fin N_T → Fin N_D → ℝ),
        (∀ tid d, 0 ≤ q tid d) →
        (∀ tid : Fin N_T, ∑ d : Fin N_D, q tid d = p_T' tid) →
        let q_D := fun d => ∑ tid : Fin N_T, q tid d
        0 ≤ ∑ tid : Fin N_T, ∑ d : Fin N_D, q tid d * Real.log (q tid d / (p_T' tid * q_D d)) := by
    intro p_T' hpT'_nn hpT'_sum N_D q hq_nn hq_row
    dsimp only
    let q_D : Fin N_D → ℝ := fun d => ∑ tid : Fin N_T, q tid d
    have hqD_nn : ∀ d, 0 ≤ q_D d := fun d => Finset.sum_nonneg (fun tid _ => hq_nn tid d)
    have hqD_sum : ∑ d : Fin N_D, q_D d = 1 := by
      dsimp only [q_D]
      rw [Finset.sum_comm]
      simp_rw [hq_row]
      exact hpT'_sum
    have h_row_le : ∀ tid : Fin N_T,
        ∑ d : Fin N_D, -(q tid d * Real.log (q tid d / (p_T' tid * q_D d))) ≤ 0 := by
      intro tid
      have h_term : ∀ d ∈ (Finset.univ : Finset (Fin N_D)),
          -(q tid d * Real.log (q tid d / (p_T' tid * q_D d))) ≤
            p_T' tid * q_D d - q tid d := by
        intro d _
        by_cases hq0 : q tid d = 0
        · rw [hq0]
          simp only [zero_div, Real.log_zero, mul_zero, neg_zero, sub_zero]
          exact mul_nonneg (hpT'_nn tid) (hqD_nn d)
        · have hq_pos : 0 < q tid d := lt_of_le_of_ne (hq_nn tid d) (Ne.symm hq0)
          have hpT_ge : q tid d ≤ p_T' tid := by
            rw [← hq_row tid]
            exact Finset.single_le_sum (fun d' _ => hq_nn tid d') (Finset.mem_univ d)
          have hqD_ge : q tid d ≤ q_D d :=
            Finset.single_le_sum (fun tid' _ => hq_nn tid' d) (Finset.mem_univ tid)
          have hpT_pos : 0 < p_T' tid := lt_of_lt_of_le hq_pos hpT_ge
          have hqD_pos : 0 < q_D d := lt_of_lt_of_le hq_pos hqD_ge
          have hprod_pos : 0 < p_T' tid * q_D d := mul_pos hpT_pos hqD_pos
          have hu_pos : 0 < (p_T' tid * q_D d) / q tid d := div_pos hprod_pos hq_pos
          have hlog_le := Real.log_le_sub_one_of_pos hu_pos
          have hlog_eq : Real.log ((p_T' tid * q_D d) / q tid d) =
              -Real.log (q tid d / (p_T' tid * q_D d)) := by
            rw [Real.log_div (ne_of_gt hprod_pos) (ne_of_gt hq_pos),
              Real.log_div (ne_of_gt hq_pos) (ne_of_gt hprod_pos)]
            ring
          rw [hlog_eq] at hlog_le
          have hmul := mul_le_mul_of_nonneg_left hlog_le hq_pos.le
          have hlhs : q tid d * (-Real.log (q tid d / (p_T' tid * q_D d))) =
              -(q tid d * Real.log (q tid d / (p_T' tid * q_D d))) := by ring
          have hrhs : q tid d * ((p_T' tid * q_D d) / q tid d - 1) =
              p_T' tid * q_D d - q tid d := by
            rw [mul_sub, mul_one, mul_div_cancel₀ _ (ne_of_gt hq_pos)]
          linarith
      have h_sum := Finset.sum_le_sum h_term
      rw [Finset.sum_sub_distrib, ← Finset.mul_sum, hqD_sum, hq_row tid, mul_one, sub_self] at h_sum
      exact h_sum
    have h_tot : ∑ tid : Fin N_T, ∑ d : Fin N_D,
        -(q tid d * Real.log (q tid d / (p_T' tid * q_D d))) ≤ 0 :=
      Finset.sum_nonpos (fun tid _ => h_row_le tid)
    simp only [Finset.sum_neg_distrib] at h_tot
    linarith

  let rootSet : ℝ → (Fin N_ω → ℝ) → (Fin N_T → EuclideanSpace ℝ (Fin 2)) →
      (Fin N_T → EuclideanSpace ℝ (Fin 2)) → Set ℝ :=
    fun L' π' V' A' =>
      let p_T' : Fin N_T → ℝ := fun tid => ∑ ω : Fin N_ω, if T_idx ω = tid then π' ω else 0
      { s : ℝ | ∃ (N_D : ℕ)
          (b_D a_D : Fin N_D → ℝ)
          (e_D V_D A_D : Fin N_D → EuclideanSpace ℝ (Fin 2))
          (q : Fin N_T → Fin N_D → ℝ),
          (∀ d : Fin N_D, 0 ≤ b_D d ∧ b_D d ≤ a_D d ∧ a_D d ≤ L' ∧ ‖e_D d‖ = 1) ∧
          (∀ tid d, 0 ≤ q tid d) ∧
          (∀ tid : Fin N_T, ∑ d : Fin N_D, q tid d = p_T' tid) ∧
          (∀ tid : Fin N_T, ∀ d : Fin N_D, 0 < q tid d →
            |inner ℝ (V' tid - V_D d) (e_D d)| ≤ 10 * ε ^ (b_D d) ∧
            |inner ℝ (V' tid - V_D d) (perp2D (e_D d))| ≤ 10 * ε ^ (a_D d) ∧
            |inner ℝ (A' tid - A_D d) (e_D d)| ≤ 10 * ε ^ (b_D d) ∧
            |inner ℝ (A' tid - A_D d) (perp2D (e_D d))| ≤ 10 * ε ^ (a_D d)) ∧
          (let q_D := fun d => ∑ tid : Fin N_T, q tid d
           let I_TD := (∑ tid : Fin N_T, ∑ d : Fin N_D,
             q tid d * Real.log (q tid d / (p_T' tid * q_D d))) / ell
           let E_w := ∑ d : Fin N_D, q_D d * ((1 + γ) * b_D d + (1 - γ) * a_D d)
           s = E_w - I_TD) }

  have h_root_eq : ∀ L' π' V' A',
      classicalRootSupremum ε L' γ N_ω N_T π' T_idx V' A' = sSup (rootSet L' π' V' A') :=
    fun _ _ _ _ => rfl

  have h_pT_law : ∀ (π' : Fin N_ω → ℝ),
      (∀ ω, 0 ≤ π' ω) → (∑ ω : Fin N_ω, π' ω = 1) →
      (∀ tid : Fin N_T, 0 ≤ ∑ ω : Fin N_ω, if T_idx ω = tid then π' ω else 0) ∧
      (∑ tid : Fin N_T, ∑ ω : Fin N_ω, if T_idx ω = tid then π' ω else 0) = 1 := by
    intro π' h_nn h_sum
    refine ⟨fun tid => Finset.sum_nonneg (fun ω _ => by split_ifs <;> [exact h_nn ω; exact le_rfl]), ?_⟩
    rw [Finset.sum_comm]
    have h_in : ∀ ω : Fin N_ω, (∑ tid : Fin N_T, if T_idx ω = tid then π' ω else 0) = π' ω :=
      fun ω => by simp [Finset.sum_ite_eq]
    simp_rw [h_in]
    exact h_sum

  have h_root_bdd : ∀ (L' : ℝ) (π' : Fin N_ω → ℝ) (V' A' : Fin N_T → EuclideanSpace ℝ (Fin 2)),
      (∀ ω, 0 ≤ π' ω) → (∑ ω : Fin N_ω, π' ω = 1) → BddAbove (rootSet L' π' V' A') := by
    intro L' π' V' A' h_nn h_sum
    obtain ⟨hpT'_nn, hpT'_sum⟩ := h_pT_law π' h_nn h_sum
    refine ⟨2 * L', fun s hs => ?_⟩
    rcases hs with ⟨N_D, b_D, a_D, e_D, V_D, A_D, q, hd_adm, hq_nn, hq_row, _, hs_eq⟩
    dsimp only at hs_eq
    let q_D : Fin N_D → ℝ := fun d => ∑ tid : Fin N_T, q tid d
    have hqD_nn : ∀ d, 0 ≤ q_D d := fun d => Finset.sum_nonneg (fun tid _ => hq_nn tid d)
    have hqD_sum : ∑ d : Fin N_D, q_D d = 1 := by
      dsimp only [q_D]
      rw [Finset.sum_comm]
      simp_rw [hq_row]
      exact hpT'_sum
    have hEw_le : ∑ d : Fin N_D, q_D d * ((1 + γ) * b_D d + (1 - γ) * a_D d) ≤ 2 * L' := by
      have h_term : ∀ d ∈ (Finset.univ : Finset (Fin N_D)),
          q_D d * ((1 + γ) * b_D d + (1 - γ) * a_D d) ≤ q_D d * (2 * L') := by
        intro d _
        obtain ⟨_, hb_a, ha_L, _⟩ := hd_adm d
        have hb_L : b_D d ≤ L' := le_trans hb_a ha_L
        have h1 : (1 + γ) * b_D d ≤ (1 + γ) * L' :=
          mul_le_mul_of_nonneg_left hb_L (by linarith)
        have h2 : (1 - γ) * a_D d ≤ (1 - γ) * L' :=
          mul_le_mul_of_nonneg_left ha_L (by linarith)
        exact mul_le_mul_of_nonneg_left (by linarith) (hqD_nn d)
      calc ∑ d : Fin N_D, q_D d * ((1 + γ) * b_D d + (1 - γ) * a_D d)
          ≤ ∑ d : Fin N_D, q_D d * (2 * L') := Finset.sum_le_sum h_term
        _ = (∑ d : Fin N_D, q_D d) * (2 * L') := (Finset.sum_mul _ _ _).symm
        _ = 2 * L' := by rw [hqD_sum, one_mul]
    have hI_nn : 0 ≤ (∑ tid : Fin N_T, ∑ d : Fin N_D,
        q tid d * Real.log (q tid d / ((∑ ω : Fin N_ω, if T_idx ω = tid then π' ω else 0) * q_D d))) / ell :=
      div_nonneg (h_mi_nonneg _ hpT'_nn hpT'_sum N_D q hq_nn hq_row) hell_pos.le
    linarith [hs_eq, hEw_le, hI_nn]

  have h_root_zero_mem : ∀ (L' : ℝ) (π' : Fin N_ω → ℝ),
      0 ≤ L' → (∀ ω, 0 ≤ π' ω) → (∑ ω : Fin N_ω, π' ω = 1) →
      (0 : ℝ) ∈ rootSet L' π' V₁ A₁ := by
    intro L' π' hL'_nn h_nn h_sum
    obtain ⟨hpT'_nn, hpT'_sum⟩ := h_pT_law π' h_nn h_sum
    let p_T' : Fin N_T → ℝ := fun tid => ∑ ω : Fin N_ω, if T_idx ω = tid then π' ω else 0
    let e₀ : EuclideanSpace ℝ (Fin 2) := WithLp.toLp 2 ![1, 0]
    have he₀_norm : ‖e₀‖ = 1 := by
      have hsq : ‖e₀‖ ^ 2 = 1 := by
        rw [PiLp.norm_sq_eq_of_L2, Fin.sum_univ_two]
        simp [e₀]
      nlinarith [norm_nonneg e₀]
    have he₀_perp_norm : ‖perp2D e₀‖ = 1 := by
      have hsq : ‖perp2D e₀‖ ^ 2 = 1 := by
        rw [PiLp.norm_sq_eq_of_L2, Fin.sum_univ_two]
        simp [perp2D, e₀]
      nlinarith [norm_nonneg (perp2D e₀)]
    refine ⟨1, fun _ => 0, fun _ => 0, fun _ => e₀, fun _ => 0, fun _ => 0,
      fun tid _ => p_T' tid, ?_, ?_, ?_, ?_, ?_⟩
    · intro _
      exact ⟨le_rfl, le_rfl, hL'_nn, he₀_norm⟩
    · intro tid _
      exact hpT'_nn tid
    · intro tid
      simp [p_T']
    · intro tid _ _
      have h_cap : ∀ (w u : EuclideanSpace ℝ (Fin 2)), ‖w‖ ≤ 1 → ‖u‖ = 1 →
          |inner ℝ (w - 0) u| ≤ 10 * ε ^ (0 : ℝ) := by
        intro w u hw hu
        rw [sub_zero, Real.rpow_zero]
        calc |inner ℝ w u| ≤ ‖w‖ * ‖u‖ := abs_real_inner_le_norm w u
          _ ≤ 1 * 1 := by rw [hu]; exact mul_le_mul_of_nonneg_right hw zero_le_one
          _ ≤ 10 * 1 := by norm_num
      exact ⟨h_cap _ _ (hVA₁ tid).1 he₀_norm, h_cap _ _ (hVA₁ tid).1 he₀_perp_norm,
        h_cap _ _ (hVA₁ tid).2 he₀_norm, h_cap _ _ (hVA₁ tid).2 he₀_perp_norm⟩
    · dsimp only
      have hqD0 : (∑ tid : Fin N_T, p_T' tid) = 1 := hpT'_sum
      have hI0 : (∑ tid : Fin N_T, ∑ _d : Fin 1,
          p_T' tid * Real.log (p_T' tid / (p_T' tid * ∑ tid' : Fin N_T, p_T' tid'))) = 0 := by
        refine Finset.sum_eq_zero (fun tid _ => ?_)
        rw [Fin.sum_univ_one, hqD0, mul_one]
        by_cases hp0 : p_T' tid = 0
        · simp [hp0]
        · rw [div_self hp0, Real.log_one, mul_zero]
      change (0 : ℝ) = (∑ _d : Fin 1, (∑ tid : Fin N_T, p_T' tid) *
          ((1 + γ) * 0 + (1 - γ) * 0)) -
        (∑ tid : Fin N_T, ∑ _d : Fin 1,
          p_T' tid * Real.log (p_T' tid / (p_T' tid * ∑ tid' : Fin N_T, p_T' tid'))) / ell
      rw [hI0, Fin.sum_univ_one]
      ring

  
  have h_s1_rescaling :
      classicalRootSupremum ε L γ N_ω N_T π T_idx V₁ A₁ ≤
        classicalRootSupremum ε L γ N_ω N_T π T_idx V_part A_part +
          (4 * Real.log ((2 * ⌈B_cl⌉₊ + 1 : ℕ) : ℝ)) / ell := by
    let K_B : ℕ := ⌈B_cl⌉₊
    let m_box : ℕ := 2 * K_B + 1
    let M_sub : ℕ := (m_box * m_box) * (m_box * m_box)
    have hm_box_pos : 1 ≤ m_box := by dsimp only [m_box]; omega
    have hM_sub_pos : 0 < M_sub := by
      dsimp only [M_sub]
      exact Nat.lt_of_lt_of_le Nat.zero_lt_one
        (Nat.mul_le_mul (Nat.mul_le_mul hm_box_pos hm_box_pos)
          (Nat.mul_le_mul hm_box_pos hm_box_pos))
    have hlog_M : Real.log (M_sub : ℝ) = 4 * Real.log ((2 * ⌈B_cl⌉₊ + 1 : ℕ) : ℝ) := by
      have hpow : (M_sub : ℝ) = ((m_box : ℝ)) ^ (4 : ℕ) := by
        dsimp only [M_sub]
        push_cast
        ring
      rw [hpow, Real.log_pow]
      dsimp only [m_box, K_B]
      norm_num
    have h_ortho : ∀ (e w : EuclideanSpace ℝ (Fin 2)) (α₁ α₂ : ℝ), ‖e‖ = 1 →
        inner ℝ (w - (α₁ • e + α₂ • perp2D e)) e = inner ℝ w e - α₁ ∧
        inner ℝ (w - (α₁ • e + α₂ • perp2D e)) (perp2D e) = inner ℝ w (perp2D e) - α₂ := by
      intro e w α₁ α₂ he
      have hee : inner ℝ e e = 1 := by rw [real_inner_self_eq_norm_sq, he, one_pow]
      have hpe : inner ℝ (perp2D e) e = 0 := by
        rw [PiLp.inner_apply, Fin.sum_univ_two]
        simp [perp2D]
        ring
      have hep : inner ℝ e (perp2D e) = 0 := by rw [real_inner_comm, hpe]
      have hpp : inner ℝ (perp2D e) (perp2D e) = 1 := by
        rw [PiLp.inner_apply, Fin.sum_univ_two] at hee ⊢
        simp [perp2D] at hee ⊢
        linarith
      constructor
      · rw [inner_sub_left, inner_add_left, real_inner_smul_left, real_inner_smul_left, hee, hpe]
        ring
      · rw [inner_sub_left, inner_add_left, real_inner_smul_left, real_inner_smul_left, hep, hpp]
        ring
    let idx1D : ℝ → ℝ → Fin m_box := fun u δ =>
      ⟨min ((⌊u / δ⌋ + (K_B : ℤ)).toNat) (2 * K_B),
       Nat.lt_succ_of_le (Nat.min_le_right _ _)⟩
    have h_idx1D : ∀ (u b : ℝ), |u| ≤ B_cl * (10 * ε ^ b) →
        |u - (((idx1D u (10 * ε ^ b)).1 : ℝ) - (K_B : ℝ)) * (10 * ε ^ b)| ≤ 10 * ε ^ b := by
      intro u b hu
      let δ : ℝ := 10 * ε ^ b
      have hεb : 0 < ε ^ b := Real.rpow_pos_of_pos hε₀ b
      have hδ_pos : 0 < δ := mul_pos (by norm_num) hεb
      have hBK : B_cl ≤ (K_B : ℝ) := Nat.le_ceil B_cl
      obtain ⟨hu_lo, hu_hi⟩ := abs_le.mp hu
      have hB_le_Kδ : B_cl * δ ≤ (K_B : ℝ) * δ := mul_le_mul_of_nonneg_right hBK hδ_pos.le
      have hdiv_lo : (((-(K_B : ℤ) : ℤ) : ℝ)) ≤ u / δ := by
        rw [le_div_iff₀ hδ_pos]
        push_cast
        dsimp only [δ] at hB_le_Kδ ⊢
        linarith
      have hdiv_hi : u / δ ≤ ((K_B : ℤ) : ℝ) := by
        rw [div_le_iff₀ hδ_pos]
        push_cast
        dsimp only [δ] at hB_le_Kδ ⊢
        linarith
      have hfl_lo : -(K_B : ℤ) ≤ ⌊u / δ⌋ := Int.le_floor.mpr hdiv_lo
      have hfl_hi : ⌊u / δ⌋ ≤ (K_B : ℤ) :=
        Int.cast_le.mp (le_trans (Int.floor_le (u / δ)) hdiv_hi)
      have hidx_int : ((idx1D u δ).1 : ℤ) = ⌊u / δ⌋ + (K_B : ℤ) := by
        dsimp only [idx1D]
        omega
      have hidx_real : ((idx1D u δ).1 : ℝ) - (K_B : ℝ) = (⌊u / δ⌋ : ℝ) := by
        have hcast : (((idx1D u δ).1 : ℤ) : ℝ) = ((⌊u / δ⌋ + (K_B : ℤ) : ℤ) : ℝ) :=
          congrArg Int.cast hidx_int
        push_cast at hcast
        linarith
      change |u - (((idx1D u δ).1 : ℝ) - (K_B : ℝ)) * δ| ≤ δ
      rw [hidx_real]
      have h_le : (⌊u / δ⌋ : ℝ) * δ ≤ u := (le_div_iff₀ hδ_pos).mp (Int.floor_le (u / δ))
      have h_lt : u < ((⌊u / δ⌋ : ℝ) + 1) * δ :=
        (div_lt_iff₀ hδ_pos).mp (Int.lt_floor_add_one (u / δ))
      exact abs_le.mpr ⟨by linarith, by linarith⟩
    let Box4 : Type := (Fin m_box × Fin m_box) × (Fin m_box × Fin m_box)
    let e_box : Box4 ≃ Fin M_sub :=
      (finProdFinEquiv.prodCongr finProdFinEquiv).trans finProdFinEquiv
    have hBox4_card : (Finset.univ : Finset Box4).card = M_sub := by
      rw [Finset.card_univ, Fintype.card_congr e_box, Fintype.card_fin]
    obtain ⟨hpT_nn, hpT_sum⟩ := h_pT_law π hπ_nn hπ_sum
    let p_T : Fin N_T → ℝ := fun tid => ∑ ω : Fin N_ω, if T_idx ω = tid then π ω else 0
    rw [h_root_eq L π V₁ A₁, h_root_eq L π V_part A_part, ← hlog_M]
    refine csSup_le ⟨0, h_root_zero_mem L π hL_nn hπ_nn hπ_sum⟩ (fun s₁ hs₁ => ?_)
    rcases hs₁ with ⟨N_D, b_D, a_D, e_D, V_D, A_D, q, hd_adm, hq_nn, hq_row, hq_geom, hs₁_eq⟩
    dsimp only at hs₁_eq
    let q_D : Fin N_D → ℝ := fun d => ∑ tid : Fin N_T, q tid d
    have hqD_nn : ∀ d, 0 ≤ q_D d := fun d => Finset.sum_nonneg (fun tid _ => hq_nn tid d)
    have hqD_sum : ∑ d : Fin N_D, q_D d = 1 := by
      dsimp only [q_D]
      rw [Finset.sum_comm]
      simp_rw [hq_row]
      exact hpT_sum
    let N_D' : ℕ := N_D * M_sub
    let e_idx : Fin N_D × Box4 ≃ Fin N_D' :=
      ((Equiv.refl (Fin N_D)).prodCongr e_box).trans finProdFinEquiv
    let s_box : Fin N_T → Fin N_D → Box4 := fun tid d =>
      ((idx1D (inner ℝ (V_part tid - B_cl • V_D d) (e_D d)) (10 * ε ^ (b_D d)),
        idx1D (inner ℝ (V_part tid - B_cl • V_D d) (perp2D (e_D d))) (10 * ε ^ (a_D d))),
       (idx1D (inner ℝ (A_part tid - B_cl • A_D d) (e_D d)) (10 * ε ^ (b_D d)),
        idx1D (inner ℝ (A_part tid - B_cl • A_D d) (perp2D (e_D d))) (10 * ε ^ (a_D d))))
    let b'_D : Fin N_D' → ℝ := fun u => b_D (e_idx.symm u).1
    let a'_D : Fin N_D' → ℝ := fun u => a_D (e_idx.symm u).1
    let e'_D : Fin N_D' → EuclideanSpace ℝ (Fin 2) := fun u => e_D (e_idx.symm u).1
    let V'_D : Fin N_D' → EuclideanSpace ℝ (Fin 2) := fun u =>
      let d := (e_idx.symm u).1
      let s := (e_idx.symm u).2
      B_cl • V_D d +
        (((((s.1.1).1 : ℝ) - (K_B : ℝ)) * (10 * ε ^ (b_D d))) • e_D d +
         ((((s.1.2).1 : ℝ) - (K_B : ℝ)) * (10 * ε ^ (a_D d))) • perp2D (e_D d))
    let A'_D : Fin N_D' → EuclideanSpace ℝ (Fin 2) := fun u =>
      let d := (e_idx.symm u).1
      let s := (e_idx.symm u).2
      B_cl • A_D d +
        (((((s.2.1).1 : ℝ) - (K_B : ℝ)) * (10 * ε ^ (b_D d))) • e_D d +
         ((((s.2.2).1 : ℝ) - (K_B : ℝ)) * (10 * ε ^ (a_D d))) • perp2D (e_D d))
    let q' : Fin N_T → Fin N_D' → ℝ := fun tid u =>
      if (e_idx.symm u).2 = s_box tid (e_idx.symm u).1 then q tid (e_idx.symm u).1 else 0
    let q'_D : Fin N_D' → ℝ := fun u => ∑ tid : Fin N_T, q' tid u
    have hq'_apply : ∀ (tid : Fin N_T) (d : Fin N_D) (s : Box4),
        q' tid (e_idx (d, s)) = if s = s_box tid d then q tid d else 0 := by
      intro tid d s
      dsimp only [q']
      rw [e_idx.symm_apply_apply]
    have hq'_nn : ∀ tid u, 0 ≤ q' tid u := by
      intro tid u
      dsimp only [q']
      split_ifs
      · exact hq_nn tid (e_idx.symm u).1
      · exact le_rfl
    have hq'_row : ∀ tid : Fin N_T, ∑ u : Fin N_D', q' tid u = p_T tid := by
      intro tid
      rw [← e_idx.sum_comp, Fintype.sum_prod_type]
      have h_in : ∀ d : Fin N_D, (∑ s : Box4, q' tid (e_idx (d, s))) = q tid d := by
        intro d
        simp [hq'_apply, Finset.sum_ite_eq']
      simp_rw [h_in]
      exact hq_row tid
    have hq'_geom : ∀ (tid : Fin N_T) (u : Fin N_D'), 0 < q' tid u →
        |inner ℝ (V_part tid - V'_D u) (e'_D u)| ≤ 10 * ε ^ (b'_D u) ∧
        |inner ℝ (V_part tid - V'_D u) (perp2D (e'_D u))| ≤ 10 * ε ^ (a'_D u) ∧
        |inner ℝ (A_part tid - A'_D u) (e'_D u)| ≤ 10 * ε ^ (b'_D u) ∧
        |inner ℝ (A_part tid - A'_D u) (perp2D (e'_D u))| ≤ 10 * ε ^ (a'_D u) := by
      intro tid u hq'_pos
      let d := (e_idx.symm u).1
      let s := (e_idx.symm u).2
      have hs_eq : s = s_box tid d := by
        dsimp only [q'] at hq'_pos
        by_contra hne
        rw [if_neg hne] at hq'_pos
        exact lt_irrefl 0 hq'_pos
      have hq_pos : 0 < q tid d := by
        dsimp only [q'] at hq'_pos
        rwa [if_pos hs_eq] at hq'_pos
      obtain ⟨hv1, hv2, ha1, ha2⟩ := hq_geom tid d hq_pos
      have hV_scale : V_part tid - B_cl • V_D d = B_cl • (V₁ tid - V_D d) := by
        dsimp only [V₁]
        rw [smul_sub, smul_smul, mul_inv_cancel₀ hB_ne, one_smul]
      have hA_scale : A_part tid - B_cl • A_D d = B_cl • (A₁ tid - A_D d) := by
        dsimp only [A₁]
        rw [smul_sub, smul_smul, mul_inv_cancel₀ hB_ne, one_smul]
      have h_bd : ∀ (w w₁ dir : EuclideanSpace ℝ (Fin 2)) (depth : ℝ),
          w = B_cl • w₁ → |inner ℝ w₁ dir| ≤ 10 * ε ^ depth →
          |inner ℝ w dir| ≤ B_cl * (10 * ε ^ depth) := by
        intro w w₁ dir depth hw h1
        rw [hw, real_inner_smul_left, abs_mul, abs_of_pos hB_pos]
        exact mul_le_mul_of_nonneg_left h1 hB_pos.le
      have he1 : ‖e_D d‖ = 1 := (hd_adm d).2.2.2
      have hVo := h_ortho (e_D d) (V_part tid - B_cl • V_D d)
        ((((s.1.1).1 : ℝ) - (K_B : ℝ)) * (10 * ε ^ (b_D d)))
        ((((s.1.2).1 : ℝ) - (K_B : ℝ)) * (10 * ε ^ (a_D d))) he1
      have hAo := h_ortho (e_D d) (A_part tid - B_cl • A_D d)
        ((((s.2.1).1 : ℝ) - (K_B : ℝ)) * (10 * ε ^ (b_D d)))
        ((((s.2.2).1 : ℝ) - (K_B : ℝ)) * (10 * ε ^ (a_D d))) he1
      change |inner ℝ (V_part tid - V'_D u) (e_D d)| ≤ 10 * ε ^ (b_D d) ∧
        |inner ℝ (V_part tid - V'_D u) (perp2D (e_D d))| ≤ 10 * ε ^ (a_D d) ∧
        |inner ℝ (A_part tid - A'_D u) (e_D d)| ≤ 10 * ε ^ (b_D d) ∧
        |inner ℝ (A_part tid - A'_D u) (perp2D (e_D d))| ≤ 10 * ε ^ (a_D d)
      have hVD_sub : V_part tid - V'_D u = (V_part tid - B_cl • V_D d) -
          (((((s.1.1).1 : ℝ) - (K_B : ℝ)) * (10 * ε ^ (b_D d))) • e_D d +
           ((((s.1.2).1 : ℝ) - (K_B : ℝ)) * (10 * ε ^ (a_D d))) • perp2D (e_D d)) :=
        sub_add_eq_sub_sub _ _ _
      have hAD_sub : A_part tid - A'_D u = (A_part tid - B_cl • A_D d) -
          (((((s.2.1).1 : ℝ) - (K_B : ℝ)) * (10 * ε ^ (b_D d))) • e_D d +
           ((((s.2.2).1 : ℝ) - (K_B : ℝ)) * (10 * ε ^ (a_D d))) • perp2D (e_D d)) :=
        sub_add_eq_sub_sub _ _ _
      rw [hVD_sub, hAD_sub, hVo.1, hVo.2, hAo.1, hAo.2]
      have hs11 : s.1.1 = idx1D (inner ℝ (V_part tid - B_cl • V_D d) (e_D d)) (10 * ε ^ (b_D d)) := by
        rw [hs_eq]
      have hs12 : s.1.2 = idx1D (inner ℝ (V_part tid - B_cl • V_D d) (perp2D (e_D d))) (10 * ε ^ (a_D d)) := by
        rw [hs_eq]
      have hs21 : s.2.1 = idx1D (inner ℝ (A_part tid - B_cl • A_D d) (e_D d)) (10 * ε ^ (b_D d)) := by
        rw [hs_eq]
      have hs22 : s.2.2 = idx1D (inner ℝ (A_part tid - B_cl • A_D d) (perp2D (e_D d))) (10 * ε ^ (a_D d)) := by
        rw [hs_eq]
      rw [hs11, hs12, hs21, hs22]
      exact ⟨h_idx1D _ _ (h_bd _ _ _ _ hV_scale hv1),
        h_idx1D _ _ (h_bd _ _ _ _ hV_scale hv2),
        h_idx1D _ _ (h_bd _ _ _ _ hA_scale ha1),
        h_idx1D _ _ (h_bd _ _ _ _ hA_scale ha2)⟩
    have hq'_D_nn : ∀ u, 0 ≤ q'_D u := fun u => Finset.sum_nonneg (fun tid _ => hq'_nn tid u)
    have hq'_D_fiber : ∀ d : Fin N_D, ∑ s : Box4, q'_D (e_idx (d, s)) = q_D d := by
      intro d
      dsimp only [q'_D, q_D]
      rw [Finset.sum_comm]
      simp_rw [hq'_apply]
      refine Finset.sum_congr rfl (fun tid _ => ?_)
      simp [Finset.sum_ite_eq']
    let E'_w : ℝ := ∑ u : Fin N_D', q'_D u * ((1 + γ) * b'_D u + (1 - γ) * a'_D u)
    let I'_TD : ℝ := (∑ tid : Fin N_T, ∑ u : Fin N_D',
      q' tid u * Real.log (q' tid u / (p_T tid * q'_D u))) / ell
    have hEw_eq : E'_w = ∑ d : Fin N_D, q_D d * ((1 + γ) * b_D d + (1 - γ) * a_D d) := by
      dsimp only [E'_w]
      rw [← e_idx.sum_comp, Fintype.sum_prod_type]
      refine Finset.sum_congr rfl (fun d _ => ?_)
      have hb_eq : ∀ s : Box4, b'_D (e_idx (d, s)) = b_D d := by
        intro s; dsimp only [b'_D]; rw [e_idx.symm_apply_apply]
      have ha_eq : ∀ s : Box4, a'_D (e_idx (d, s)) = a_D d := by
        intro s; dsimp only [a'_D]; rw [e_idx.symm_apply_apply]
      simp_rw [hb_eq, ha_eq, ← Finset.sum_mul, hq'_D_fiber d]
    have hI_diff :
        I'_TD - (∑ tid : Fin N_T, ∑ d : Fin N_D,
          q tid d * Real.log (q tid d / (p_T tid * q_D d))) / ell ≤
        Real.log (M_sub : ℝ) / ell := by
      have h_pt : ∀ (tid : Fin N_T) (d : Fin N_D) (s : Box4),
          q' tid (e_idx (d, s)) *
            Real.log (q' tid (e_idx (d, s)) / (p_T tid * q'_D (e_idx (d, s)))) -
          q' tid (e_idx (d, s)) * Real.log (q tid d / (p_T tid * q_D d)) =
          -(q' tid (e_idx (d, s)) * Real.log (q'_D (e_idx (d, s)) / q_D d)) := by
        intro tid d s
        by_cases hq'0 : q' tid (e_idx (d, s)) = 0
        · rw [hq'0]; ring
        · have hq'_pos : 0 < q' tid (e_idx (d, s)) :=
            lt_of_le_of_ne (hq'_nn tid (e_idx (d, s))) (Ne.symm hq'0)
          have hs_eq : s = s_box tid d := by
            rw [hq'_apply] at hq'0
            by_contra hne
            rw [if_neg hne] at hq'0
            exact hq'0 rfl
          have hq'_val : q' tid (e_idx (d, s)) = q tid d := by
            rw [hq'_apply, if_pos hs_eq]
          have hq_pos : 0 < q tid d := hq'_val ▸ hq'_pos
          have hpT_pos : 0 < p_T tid := by
            have hq_row_tid : ∑ d : Fin N_D, q tid d = p_T tid := hq_row tid
            refine lt_of_lt_of_le hq_pos ?_
            rw [← hq_row_tid]
            exact Finset.single_le_sum (fun d' _ => hq_nn tid d') (Finset.mem_univ d)
          have hqD_pos : 0 < q_D d :=
            lt_of_lt_of_le hq_pos
              (Finset.single_le_sum (fun tid' _ => hq_nn tid' d) (Finset.mem_univ tid))
          have hq'D_pos : 0 < q'_D (e_idx (d, s)) :=
            lt_of_lt_of_le hq'_pos
              (Finset.single_le_sum (fun tid' _ => hq'_nn tid' (e_idx (d, s)))
                (Finset.mem_univ tid))
          rw [hq'_val,
            Real.log_div (ne_of_gt hq_pos) (ne_of_gt (mul_pos hpT_pos hq'D_pos)),
            Real.log_mul (ne_of_gt hpT_pos) (ne_of_gt hq'D_pos),
            Real.log_div (ne_of_gt hq_pos) (ne_of_gt (mul_pos hpT_pos hqD_pos)),
            Real.log_mul (ne_of_gt hpT_pos) (ne_of_gt hqD_pos),
            Real.log_div (ne_of_gt hq'D_pos) (ne_of_gt hqD_pos)]
          ring
      have h_num_eq :
          (∑ tid : Fin N_T, ∑ u : Fin N_D',
            q' tid u * Real.log (q' tid u / (p_T tid * q'_D u))) -
          (∑ tid : Fin N_T, ∑ d : Fin N_D,
            q tid d * Real.log (q tid d / (p_T tid * q_D d))) =
          ∑ d : Fin N_D, ∑ s : Box4,
            -(q'_D (e_idx (d, s)) * Real.log (q'_D (e_idx (d, s)) / q_D d)) := by
        rw [← Finset.sum_sub_distrib]
        have h_tid : ∀ tid : Fin N_T,
            (∑ u : Fin N_D', q' tid u * Real.log (q' tid u / (p_T tid * q'_D u))) -
            (∑ d : Fin N_D, q tid d * Real.log (q tid d / (p_T tid * q_D d))) =
            ∑ d : Fin N_D, ∑ s : Box4,
              -(q' tid (e_idx (d, s)) * Real.log (q'_D (e_idx (d, s)) / q_D d)) := by
          intro tid
          rw [← e_idx.sum_comp, Fintype.sum_prod_type, ← Finset.sum_sub_distrib]
          refine Finset.sum_congr rfl (fun d _ => ?_)
          have hq_expand : q tid d * Real.log (q tid d / (p_T tid * q_D d)) =
              ∑ s : Box4, q' tid (e_idx (d, s)) * Real.log (q tid d / (p_T tid * q_D d)) := by
            rw [← Finset.sum_mul]
            congr 1
            simp [hq'_apply, Finset.sum_ite_eq']
          rw [hq_expand, ← Finset.sum_sub_distrib]
          exact Finset.sum_congr rfl (fun s _ => h_pt tid d s)
        simp_rw [h_tid]
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl (fun d _ => ?_)
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl (fun s _ => ?_)
        rw [Finset.sum_neg_distrib, ← Finset.sum_mul]
      have h_num_le :
          ∑ d : Fin N_D, ∑ s : Box4,
            -(q'_D (e_idx (d, s)) * Real.log (q'_D (e_idx (d, s)) / q_D d)) ≤
          Real.log (M_sub : ℝ) := by
        have h_card_pos : 0 < (Finset.univ : Finset Box4).card := by
          rw [hBox4_card]; exact hM_sub_pos
        calc ∑ d : Fin N_D, ∑ s : Box4,
              -(q'_D (e_idx (d, s)) * Real.log (q'_D (e_idx (d, s)) / q_D d))
            ≤ ∑ d : Fin N_D, q_D d * Real.log ((Finset.univ : Finset Box4).card : ℝ) :=
              Finset.sum_le_sum (fun d _ =>
                h_ent_card Finset.univ (fun s => q'_D (e_idx (d, s))) (q_D d)
                  h_card_pos (fun s _ => hq'_D_nn (e_idx (d, s))) (hq'_D_fiber d))
          _ = (∑ d : Fin N_D, q_D d) * Real.log (M_sub : ℝ) := by
              rw [hBox4_card, ← Finset.sum_mul]
          _ = Real.log (M_sub : ℝ) := by rw [hqD_sum, one_mul]
      dsimp only [I'_TD]
      rw [← sub_div, h_num_eq]
      exact div_le_div_of_nonneg_right h_num_le hell_pos.le
    have hs'_mem : E'_w - I'_TD ∈ rootSet L π V_part A_part :=
      ⟨N_D', b'_D, a'_D, e'_D, V'_D, A'_D, q',
        fun u => hd_adm (e_idx.symm u).1, hq'_nn, hq'_row, hq'_geom, rfl⟩
    have hs'_le : E'_w - I'_TD ≤ sSup (rootSet L π V_part A_part) :=
      le_csSup (h_root_bdd L π V_part A_part hπ_nn hπ_sum) hs'_mem
    dsimp only [p_T, q_D] at hs₁_eq hEw_eq hI_diff
    linarith [hs₁_eq, hEw_eq, hI_diff, hs'_le]

  
  let M_sh : ℕ := ⌊K_hor / ξ⌋₊ + 1
  let N_Z : ℕ := M_sh * M_sh
  have hM_sh_pos : 1 ≤ M_sh := by dsimp only [M_sh]; omega
  have hNZ_pos : 0 < N_Z := by
    dsimp only [N_Z]
    exact Nat.lt_of_lt_of_le Nat.zero_lt_one (Nat.mul_le_mul hM_sh_pos hM_sh_pos)
  have hlog_NZ : 2 * Real.log (N_Z : ℝ) = 4 * Real.log ((⌊K_hor / ξ⌋₊ + 1 : ℕ) : ℝ) := by
    have hpow : (N_Z : ℝ) = ((M_sh : ℝ)) ^ (2 : ℕ) := by
      dsimp only [N_Z]
      push_cast
      ring
    rw [hpow, Real.log_pow]
    dsimp only [M_sh]
    ring
  have hz_b : ∀ g : Fin N_G, ⌊b_G g / ξ⌋₊ < M_sh := by
    intro g
    obtain ⟨_, hba, hat_L, _⟩ := hG_adm g
    have hb_K : b_G g ≤ K_hor := by linarith
    have hdiv : b_G g / ξ ≤ K_hor / ξ := div_le_div_of_nonneg_right hb_K hξ.le
    exact Nat.lt_succ_of_le (Nat.floor_mono hdiv)
  have hz_a : ∀ g : Fin N_G, ⌊a_G g / ξ⌋₊ < M_sh := by
    intro g
    obtain ⟨_, _, hat_L, _⟩ := hG_adm g
    have ha_K : a_G g ≤ K_hor := by linarith
    have hdiv : a_G g / ξ ≤ K_hor / ξ := div_le_div_of_nonneg_right ha_K hξ.le
    exact Nat.lt_succ_of_le (Nat.floor_mono hdiv)
  let z_G : Fin N_G → Fin N_Z :=
    fun g => finProdFinEquiv (⟨⌊b_G g / ξ⌋₊, hz_b g⟩, ⟨⌊a_G g / ξ⌋₊, hz_a g⟩)
  let Z : Fin N_ω → Fin N_Z := fun ω => z_G (G_idx ω)

  let p_T : Fin N_T → ℝ := fun tid => ∑ ω : Fin N_ω, if T_idx ω = tid then π ω else 0
  let p_G : Fin N_G → ℝ := fun g => ∑ ω : Fin N_ω, if G_idx ω = g then π ω else 0
  let p_TG : Fin N_T → Fin N_G → ℝ := fun tid g =>
    ∑ ω : Fin N_ω, if T_idx ω = tid ∧ G_idx ω = g then π ω else 0
  let S_cells : Finset ℤ := Finset.univ.image k_time
  let p_TC : Fin N_T → ℤ → ℝ := fun tid k =>
    ∑ ω : Fin N_ω, if T_idx ω = tid ∧ k_time ω = k then π ω else 0
  let p_Z : Fin N_Z → ℝ := fun z => ∑ ω : Fin N_ω, if Z ω = z then π ω else 0
  let p_TZ : Fin N_T → Fin N_Z → ℝ := fun tid z =>
    ∑ ω : Fin N_ω, if T_idx ω = tid ∧ Z ω = z then π ω else 0
  let p_TCZ : Fin N_T → ℤ → Fin N_Z → ℝ := fun tid k z =>
    ∑ ω : Fin N_ω, if T_idx ω = tid ∧ k_time ω = k ∧ Z ω = z then π ω else 0
  let I_TZ : ℝ := (∑ tid : Fin N_T, ∑ z : Fin N_Z,
    p_TZ tid z * Real.log (p_TZ tid z / (p_T tid * p_Z z))) / ell
  let π_cond : Fin N_Z → Fin N_ω → ℝ := fun z ω =>
    if Z ω = z then π ω / p_Z z else 0

  obtain ⟨hpT_nn, hpT_sum⟩ := h_pT_law π hπ_nn hπ_sum
  have hpG_nn : ∀ g, 0 ≤ p_G g := fun g =>
    Finset.sum_nonneg (fun ω _ => by split_ifs <;> [exact hπ_nn ω; exact le_rfl])
  have hpTG_nn : ∀ tid g, 0 ≤ p_TG tid g := fun tid g =>
    Finset.sum_nonneg (fun ω _ => by split_ifs <;> [exact hπ_nn ω; exact le_rfl])
  have hpTC_nn : ∀ tid k, 0 ≤ p_TC tid k := fun tid k =>
    Finset.sum_nonneg (fun ω _ => by split_ifs <;> [exact hπ_nn ω; exact le_rfl])
  have hpZ_nn : ∀ z, 0 ≤ p_Z z := fun z =>
    Finset.sum_nonneg (fun ω _ => by split_ifs <;> [exact hπ_nn ω; exact le_rfl])
  have hpTZ_nn : ∀ tid z, 0 ≤ p_TZ tid z := fun tid z =>
    Finset.sum_nonneg (fun ω _ => by split_ifs <;> [exact hπ_nn ω; exact le_rfl])
  have hpTCZ_nn : ∀ tid k z, 0 ≤ p_TCZ tid k z := fun tid k z =>
    Finset.sum_nonneg (fun ω _ => by split_ifs <;> [exact hπ_nn ω; exact le_rfl])

  have hpZ_sum : ∑ z : Fin N_Z, p_Z z = 1 := by
    dsimp only [p_Z]
    rw [Finset.sum_comm]
    have h_in : ∀ ω : Fin N_ω, (∑ z : Fin N_Z, if Z ω = z then π ω else 0) = π ω :=
      fun ω => by simp [Finset.sum_ite_eq]
    simp_rw [h_in]
    exact hπ_sum

  have hpTZ_row : ∀ tid : Fin N_T, ∑ z : Fin N_Z, p_TZ tid z = p_T tid := by
    intro tid
    dsimp only [p_TZ, p_T]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun ω _ => ?_)
    by_cases h : T_idx ω = tid
    · simp [h, Finset.sum_ite_eq]
    · simp [h]

  have hpTZ_col : ∀ z : Fin N_Z, ∑ tid : Fin N_T, p_TZ tid z = p_Z z := by
    intro z
    dsimp only [p_TZ, p_Z]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun ω _ => ?_)
    by_cases h : Z ω = z
    · simp [h, Finset.sum_ite_eq]
    · simp [h]

  have hpTG_row : ∀ tid : Fin N_T, ∑ g : Fin N_G, p_TG tid g = p_T tid := by
    intro tid
    dsimp only [p_TG, p_T]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun ω _ => ?_)
    by_cases h : T_idx ω = tid
    · simp [h, Finset.sum_ite_eq]
    · simp [h]

  have hpTG_col : ∀ g : Fin N_G, ∑ tid : Fin N_T, p_TG tid g = p_G g := by
    intro g
    dsimp only [p_TG, p_G]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun ω _ => ?_)
    by_cases h : G_idx ω = g
    · simp [h, Finset.sum_ite_eq]
    · simp [h]

  have hpG_z_sum : ∀ z : Fin N_Z,
      (∑ g : Fin N_G, if z_G g = z then p_G g else 0) = p_Z z := by
    intro z
    dsimp only [p_G, p_Z, Z]
    have h_push : ∀ g : Fin N_G,
        (if z_G g = z then ∑ ω : Fin N_ω, (if G_idx ω = g then π ω else 0) else 0) =
        ∑ ω : Fin N_ω, if G_idx ω = g ∧ z_G g = z then π ω else 0 := by
      intro g
      by_cases hz : z_G g = z
      · simp [hz]
      · simp [hz]
    simp_rw [h_push]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun ω _ => ?_)
    by_cases hz : z_G (G_idx ω) = z
    · have h_eq : ∀ g : Fin N_G, (G_idx ω = g ∧ z_G g = z) ↔ G_idx ω = g := by
        intro g
        exact ⟨fun h => h.1, fun h => ⟨h, h ▸ hz⟩⟩
      simp_rw [h_eq]
      simp [Finset.sum_ite_eq, hz]
    · have h_false : ∀ g : Fin N_G, ¬ (G_idx ω = g ∧ z_G g = z) := by
        intro g ⟨hg, hzg⟩
        exact hz (hg.symm ▸ hzg)
      simp [h_false, hz]

  have hpTG_z_sum : ∀ (tid : Fin N_T) (z : Fin N_Z),
      (∑ g : Fin N_G, if z_G g = z then p_TG tid g else 0) = p_TZ tid z := by
    intro tid z
    dsimp only [p_TG, p_TZ, Z]
    have h_push : ∀ g : Fin N_G,
        (if z_G g = z then ∑ ω : Fin N_ω, (if T_idx ω = tid ∧ G_idx ω = g then π ω else 0) else 0) =
        ∑ ω : Fin N_ω, if T_idx ω = tid ∧ G_idx ω = g ∧ z_G g = z then π ω else 0 := by
      intro g
      by_cases hz : z_G g = z
      · simp [hz]
      · simp [hz]
    simp_rw [h_push]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun ω _ => ?_)
    by_cases hcond : T_idx ω = tid ∧ z_G (G_idx ω) = z
    · have h_eq : ∀ g : Fin N_G,
          (T_idx ω = tid ∧ G_idx ω = g ∧ z_G g = z) ↔ G_idx ω = g := by
        intro g
        exact ⟨fun h => h.2.1, fun hg => ⟨hcond.1, hg, hg ▸ hcond.2⟩⟩
      simp_rw [h_eq]
      simp [Finset.sum_ite_eq, hcond]
    · have h_false : ∀ g : Fin N_G, ¬ (T_idx ω = tid ∧ G_idx ω = g ∧ z_G g = z) := by
        intro g ⟨htid, hg, hzg⟩
        exact hcond ⟨htid, hg.symm ▸ hzg⟩
      simp [h_false, hcond]

  have hpTCZ_sum_z : ∀ (tid : Fin N_T) (k : ℤ),
      ∑ z : Fin N_Z, p_TCZ tid k z = p_TC tid k := by
    intro tid k
    dsimp only [p_TCZ, p_TC]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun ω _ => ?_)
    by_cases h : T_idx ω = tid ∧ k_time ω = k
    · simp [h, Finset.sum_ite_eq]
    · have h_false : ∀ z : Fin N_Z, ¬ (T_idx ω = tid ∧ k_time ω = k ∧ Z ω = z) :=
        fun z hz => h ⟨hz.1, hz.2.1⟩
      simp [h, h_false]

  have hpTCZ_sum_k : ∀ (tid : Fin N_T) (z : Fin N_Z),
      ∑ k ∈ S_cells, p_TCZ tid k z = p_TZ tid z := by
    intro tid z
    dsimp only [p_TCZ, p_TZ]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun ω _ => ?_)
    by_cases h : T_idx ω = tid ∧ Z ω = z
    · have hk_mem : k_time ω ∈ S_cells := Finset.mem_image_of_mem k_time (Finset.mem_univ ω)
      have h_eq : ∀ k : ℤ, (T_idx ω = tid ∧ k_time ω = k ∧ Z ω = z) ↔ k_time ω = k :=
        fun k => ⟨fun hk => hk.2.1, fun hk => ⟨h.1, hk, h.2⟩⟩
      simp_rw [h_eq]
      simp [h, Finset.sum_ite_eq, hk_mem]
    · have h_false : ∀ k : ℤ, ¬ (T_idx ω = tid ∧ k_time ω = k ∧ Z ω = z) :=
        fun k hk => h ⟨hk.1, hk.2.2⟩
      simp [h, h_false]

  have hπ_cond_law : ∀ z : Fin N_Z, 0 < p_Z z →
      (∀ ω, 0 ≤ π_cond z ω) ∧ (∑ ω : Fin N_ω, π_cond z ω = 1) := by
    intro z hpz
    refine ⟨fun ω => ?_, ?_⟩
    · dsimp only [π_cond]
      split_ifs
      · exact div_nonneg (hπ_nn ω) hpz.le
      · exact le_rfl
    · dsimp only [π_cond]
      have h_eq : ∀ ω : Fin N_ω,
          (if Z ω = z then π ω / p_Z z else 0) = (if Z ω = z then π ω else 0) / p_Z z := by
        intro ω
        split_ifs <;> simp [zero_div]
      simp_rw [h_eq, ← Finset.sum_div]
      exact div_self (ne_of_gt hpz)

  let p_T_c : Fin N_Z → Fin N_T → ℝ :=
    fun z tid => ∑ ω : Fin N_ω, if T_idx ω = tid then π_cond z ω else 0
  let p_G_c : Fin N_Z → Fin N_G → ℝ :=
    fun z g => ∑ ω : Fin N_ω, if G_idx ω = g then π_cond z ω else 0
  let p_TG_c : Fin N_Z → Fin N_T → Fin N_G → ℝ :=
    fun z tid g => ∑ ω : Fin N_ω, if T_idx ω = tid ∧ G_idx ω = g then π_cond z ω else 0
  let p_TC_c : Fin N_Z → Fin N_T → ℤ → ℝ :=
    fun z tid k => ∑ ω : Fin N_ω, if T_idx ω = tid ∧ k_time ω = k then π_cond z ω else 0

  have hpT_c_eq : ∀ (z : Fin N_Z) (tid : Fin N_T), p_T_c z tid = p_TZ tid z / p_Z z := by
    intro z tid
    dsimp only [p_T_c, p_TZ, π_cond]
    rw [Finset.sum_div]
    refine Finset.sum_congr rfl (fun ω _ => ?_)
    split_ifs <;> simp_all [zero_div]

  have hpTC_c_eq : ∀ (z : Fin N_Z) (tid : Fin N_T) (k : ℤ),
      p_TC_c z tid k = p_TCZ tid k z / p_Z z := by
    intro z tid k
    dsimp only [p_TC_c, p_TCZ, π_cond]
    rw [Finset.sum_div]
    refine Finset.sum_congr rfl (fun ω _ => ?_)
    split_ifs <;> simp_all [zero_div]

  have hpG_c_eq : ∀ (z : Fin N_Z) (g : Fin N_G),
      p_G_c z g = if z_G g = z then p_G g / p_Z z else 0 := by
    intro z g
    dsimp only [p_G_c, p_G, π_cond, Z]
    by_cases hzg : z_G g = z
    · rw [if_pos hzg, Finset.sum_div]
      refine Finset.sum_congr rfl (fun ω _ => ?_)
      by_cases hg : G_idx ω = g
      · simp [hg, hzg]
      · simp [hg, zero_div]
    · rw [if_neg hzg]
      refine Finset.sum_eq_zero (fun ω _ => ?_)
      by_cases hg : G_idx ω = g
      · simp [hg, hzg]
      · simp [hg]

  have hpTG_c_eq : ∀ (z : Fin N_Z) (tid : Fin N_T) (g : Fin N_G),
      p_TG_c z tid g = if z_G g = z then p_TG tid g / p_Z z else 0 := by
    intro z tid g
    dsimp only [p_TG_c, p_TG, π_cond, Z]
    by_cases hzg : z_G g = z
    · rw [if_pos hzg, Finset.sum_div]
      refine Finset.sum_congr rfl (fun ω _ => ?_)
      by_cases htg : T_idx ω = tid ∧ G_idx ω = g
      · simp [htg, hzg]
      · simp [htg, zero_div]
    · rw [if_neg hzg]
      refine Finset.sum_eq_zero (fun ω _ => ?_)
      by_cases htg : T_idx ω = tid ∧ G_idx ω = g
      · simp [htg, hzg]
      · simp [htg]

  have h_s2_split :
      classicalTransportScore ε γ N_ω N_T N_G π T_idx k_time G_idx b_G a_G ≤
        (∑ z : Fin N_Z,
          p_Z z * classicalTransportScore ε γ N_ω N_T N_G (π_cond z) T_idx k_time G_idx b_G a_G) -
        I_TZ +
        (4 * Real.log ((⌊K_hor / ξ⌋₊ + 1 : ℕ) : ℝ)) / ell := by
    let E_w_c : Fin N_Z → ℝ :=
      fun z => ∑ g : Fin N_G, p_G_c z g * ((1 + γ) * b_G g + (1 - γ) * a_G g)
    let I_TG_c : Fin N_Z → ℝ :=
      fun z => (∑ tid : Fin N_T, ∑ g : Fin N_G,
        p_TG_c z tid g * Real.log (p_TG_c z tid g / (p_T_c z tid * p_G_c z g))) / ell
    let S_t_c : Fin N_Z → ℝ :=
      fun z => (∑ tid : Fin N_T, ∑ k ∈ S_cells,
        -(p_TC_c z tid k * Real.log (p_TC_c z tid k / p_T_c z tid))) / ell
    have h_score_c : ∀ z : Fin N_Z,
        classicalTransportScore ε γ N_ω N_T N_G (π_cond z) T_idx k_time G_idx b_G a_G =
          E_w_c z - I_TG_c z + 2 * S_t_c z := fun _ => rfl
    
    have h_Ew_id : (∑ z : Fin N_Z, p_Z z * E_w_c z) =
        ∑ g : Fin N_G, p_G g * ((1 + γ) * b_G g + (1 - γ) * a_G g) := by
      have hpZ_pGc : ∀ (z : Fin N_Z) (g : Fin N_G),
          p_Z z * p_G_c z g = if z_G g = z then p_G g else 0 := by
        intro z g
        rw [hpG_c_eq]
        by_cases hzg : z_G g = z
        · rw [if_pos hzg, if_pos hzg]
          by_cases hpZ0 : p_Z z = 0
          · rw [hpZ0, zero_mul]
            have hpG_le : p_G g ≤ p_Z z := by
              rw [← hpG_z_sum z]
              have h_le := Finset.single_le_sum
                (f := fun g' => if z_G g' = z then p_G g' else 0)
                (fun g' _ => by split_ifs <;> [exact hpG_nn g'; exact le_rfl])
                (Finset.mem_univ g)
              rwa [if_pos hzg] at h_le
            linarith [hpG_nn g]
          · exact mul_div_cancel₀ (p_G g) hpZ0
        · simp [hzg]
      dsimp only [E_w_c]
      simp_rw [Finset.mul_sum]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl (fun g _ => ?_)
      have h_term : ∀ z : Fin N_Z,
          p_Z z * (p_G_c z g * ((1 + γ) * b_G g + (1 - γ) * a_G g)) =
          (if z_G g = z then p_G g else 0) * ((1 + γ) * b_G g + (1 - γ) * a_G g) := by
        intro z
        rw [← mul_assoc, hpZ_pGc z g]
      simp_rw [h_term, ← Finset.sum_mul]
      simp [Finset.sum_ite_eq]
    
    have h_ITG_id : (∑ z : Fin N_Z, p_Z z * I_TG_c z) =
        (∑ tid : Fin N_T, ∑ g : Fin N_G,
          p_TG tid g * Real.log (p_TG tid g / (p_T tid * p_G g))) / ell - I_TZ := by
      have h_triple : ∀ (z : Fin N_Z) (tid : Fin N_T) (g : Fin N_G),
          p_Z z * (p_TG_c z tid g *
            Real.log (p_TG_c z tid g / (p_T_c z tid * p_G_c z g))) =
          (if z_G g = z then p_TG tid g else 0) *
            Real.log (p_TG tid g / (p_T tid * p_G g)) -
          (if z_G g = z then p_TG tid g else 0) *
            Real.log (p_TZ tid z / (p_T tid * p_Z z)) := by
        intro z tid g
        by_cases hzg : z_G g = z
        · rw [hpTG_c_eq, hpT_c_eq, hpG_c_eq, if_pos hzg, if_pos hzg, if_pos hzg]
          by_cases hpTG0 : p_TG tid g = 0
          · simp [hpTG0]
          · have hpTG_pos : 0 < p_TG tid g := lt_of_le_of_ne (hpTG_nn tid g) (Ne.symm hpTG0)
            have hpT_pos : 0 < p_T tid := by
              refine lt_of_lt_of_le hpTG_pos ?_
              rw [← hpTG_row tid]
              exact Finset.single_le_sum (fun g' _ => hpTG_nn tid g') (Finset.mem_univ g)
            have hpG_pos : 0 < p_G g := by
              refine lt_of_lt_of_le hpTG_pos ?_
              rw [← hpTG_col g]
              exact Finset.single_le_sum (fun tid' _ => hpTG_nn tid' g) (Finset.mem_univ tid)
            have hpTZ_pos : 0 < p_TZ tid z := by
              refine lt_of_lt_of_le hpTG_pos ?_
              rw [← hpTG_z_sum tid z]
              have h_le := Finset.single_le_sum
                (f := fun g' => if z_G g' = z then p_TG tid g' else 0)
                (fun g' _ => by split_ifs <;> [exact hpTG_nn tid g'; exact le_rfl])
                (Finset.mem_univ g)
              rwa [if_pos hzg] at h_le
            have hpZ_pos : 0 < p_Z z := by
              refine lt_of_lt_of_le hpTZ_pos ?_
              rw [← hpTZ_col z]
              exact Finset.single_le_sum (fun tid' _ => hpTZ_nn tid' z) (Finset.mem_univ tid)
            have hpZ_ne : p_Z z ≠ 0 := ne_of_gt hpZ_pos
            have hpT_ne : p_T tid ≠ 0 := ne_of_gt hpT_pos
            have hpG_ne : p_G g ≠ 0 := ne_of_gt hpG_pos
            have hpTZ_ne : p_TZ tid z ≠ 0 := ne_of_gt hpTZ_pos
            have h_arg : (p_TG tid g / p_Z z) / ((p_TZ tid z / p_Z z) * (p_G g / p_Z z)) =
                (p_TG tid g / (p_T tid * p_G g)) / (p_TZ tid z / (p_T tid * p_Z z)) := by
              field_simp [hpZ_ne, hpT_ne, hpG_ne, hpTZ_ne]
            have h_num_pos : 0 < p_TG tid g / (p_T tid * p_G g) :=
              div_pos hpTG_pos (mul_pos hpT_pos hpG_pos)
            have h_den_pos : 0 < p_TZ tid z / (p_T tid * p_Z z) :=
              div_pos hpTZ_pos (mul_pos hpT_pos hpZ_pos)
            rw [← mul_assoc, mul_div_cancel₀ _ hpZ_ne, h_arg,
              Real.log_div (ne_of_gt h_num_pos) (ne_of_gt h_den_pos), mul_sub]
        · rw [hpTG_c_eq, if_neg hzg, if_neg hzg]
          simp
      have h_num : (∑ z : Fin N_Z, p_Z z * ∑ tid : Fin N_T, ∑ g : Fin N_G,
            p_TG_c z tid g * Real.log (p_TG_c z tid g / (p_T_c z tid * p_G_c z g))) =
          (∑ tid : Fin N_T, ∑ g : Fin N_G,
            p_TG tid g * Real.log (p_TG tid g / (p_T tid * p_G g))) -
          (∑ tid : Fin N_T, ∑ z : Fin N_Z,
            p_TZ tid z * Real.log (p_TZ tid z / (p_T tid * p_Z z))) := by
        simp_rw [Finset.mul_sum, h_triple]
        rw [Finset.sum_comm]
        simp_rw [Finset.sum_sub_distrib]
        congr 1
        · refine Finset.sum_congr rfl (fun tid _ => ?_)
          rw [Finset.sum_comm]
          refine Finset.sum_congr rfl (fun g _ => ?_)
          rw [← Finset.sum_mul]
          simp [Finset.sum_ite_eq]
        · refine Finset.sum_congr rfl (fun tid _ => ?_)
          refine Finset.sum_congr rfl (fun z _ => ?_)
          rw [← Finset.sum_mul, hpTG_z_sum tid z]
      dsimp only [I_TG_c, I_TZ]
      have h_div : (∑ z : Fin N_Z,
            p_Z z * ((∑ tid : Fin N_T, ∑ g : Fin N_G,
              p_TG_c z tid g * Real.log (p_TG_c z tid g / (p_T_c z tid * p_G_c z g))) / ell)) =
          (∑ z : Fin N_Z, p_Z z * ∑ tid : Fin N_T, ∑ g : Fin N_G,
            p_TG_c z tid g * Real.log (p_TG_c z tid g / (p_T_c z tid * p_G_c z g))) / ell := by
        rw [Finset.sum_div]
        exact Finset.sum_congr rfl (fun z _ => (mul_div_assoc _ _ _).symm)
      rw [h_div, h_num, sub_div]
    
    have h_St_le : (∑ tid : Fin N_T, ∑ k ∈ S_cells,
          -(p_TC tid k * Real.log (p_TC tid k / p_T tid))) / ell ≤
        (∑ z : Fin N_Z, p_Z z * S_t_c z) + Real.log (N_Z : ℝ) / ell := by
      have h_pt_st : ∀ (tid : Fin N_T) (z : Fin N_Z) (k : ℤ),
          -(p_TCZ tid k z * Real.log (p_TC tid k / p_T tid)) +
            p_TCZ tid k z * Real.log (p_TZ tid z / p_T tid) ≤
          p_Z z * (-(p_TC_c z tid k * Real.log (p_TC_c z tid k / p_T_c z tid))) := by
        intro tid z k
        rw [hpTC_c_eq, hpT_c_eq]
        by_cases hp0 : p_TCZ tid k z = 0
        · simp [hp0]
        · have hp_pos : 0 < p_TCZ tid k z := lt_of_le_of_ne (hpTCZ_nn tid k z) (Ne.symm hp0)
          have hpTC_ge : p_TCZ tid k z ≤ p_TC tid k := by
            rw [← hpTCZ_sum_z tid k]
            exact Finset.single_le_sum (fun z' _ => hpTCZ_nn tid k z') (Finset.mem_univ z)
          have hpTC_pos : 0 < p_TC tid k := lt_of_lt_of_le hp_pos hpTC_ge
          have hpT_pos : 0 < p_T tid := by
            have h1 : p_TCZ tid k z ≤ p_T tid := by
              dsimp only [p_TCZ, p_T]
              refine Finset.sum_le_sum (fun ω _ => ?_)
              split_ifs with h1 h2
              · exact le_rfl
              · exact absurd h1.1 h2
              · exact hπ_nn ω
              · exact le_rfl
            exact lt_of_lt_of_le hp_pos h1
          have hpTZ_pos : 0 < p_TZ tid z := by
            have h1 : p_TCZ tid k z ≤ p_TZ tid z := by
              dsimp only [p_TCZ, p_TZ]
              refine Finset.sum_le_sum (fun ω _ => ?_)
              split_ifs with h1 h2
              · exact le_rfl
              · exact absurd ⟨h1.1, h1.2.2⟩ h2
              · exact hπ_nn ω
              · exact le_rfl
            exact lt_of_lt_of_le hp_pos h1
          have hpZ_pos : 0 < p_Z z := by
            refine lt_of_lt_of_le hpTZ_pos ?_
            rw [← hpTZ_col z]
            exact Finset.single_le_sum (fun tid' _ => hpTZ_nn tid' z) (Finset.mem_univ tid)
          have hpZ_ne : p_Z z ≠ 0 := ne_of_gt hpZ_pos
          have hpT_ne : p_T tid ≠ 0 := ne_of_gt hpT_pos
          have hpTZ_ne : p_TZ tid z ≠ 0 := ne_of_gt hpTZ_pos
          have hrhs_eq : p_Z z * (-(p_TCZ tid k z / p_Z z *
              Real.log ((p_TCZ tid k z / p_Z z) / (p_TZ tid z / p_Z z)))) =
              -(p_TCZ tid k z * Real.log (p_TCZ tid k z / p_TZ tid z)) := by
            have h_div_z : (p_TCZ tid k z / p_Z z) / (p_TZ tid z / p_Z z) =
                p_TCZ tid k z / p_TZ tid z := by
              field_simp [hpZ_ne, hpTZ_ne]
            rw [h_div_z]
            calc p_Z z * -(p_TCZ tid k z / p_Z z * Real.log (p_TCZ tid k z / p_TZ tid z))
                = -((p_Z z * (p_TCZ tid k z / p_Z z)) * Real.log (p_TCZ tid k z / p_TZ tid z)) := by
                  ring
              _ = -(p_TCZ tid k z * Real.log (p_TCZ tid k z / p_TZ tid z)) := by
                  rw [mul_div_cancel₀ _ hpZ_ne]
          have hlhs_eq : -(p_TCZ tid k z * Real.log (p_TC tid k / p_T tid)) +
              p_TCZ tid k z * Real.log (p_TZ tid z / p_T tid) =
              -(p_TCZ tid k z * Real.log (p_TC tid k / p_TZ tid z)) := by
            rw [Real.log_div (ne_of_gt hpTC_pos) hpT_ne,
              Real.log_div hpTZ_ne hpT_ne,
              Real.log_div (ne_of_gt hpTC_pos) hpTZ_ne]
            ring
          rw [hrhs_eq, hlhs_eq]
          have hlog_mono : Real.log (p_TCZ tid k z / p_TZ tid z) ≤
              Real.log (p_TC tid k / p_TZ tid z) :=
            Real.log_le_log (div_pos hp_pos hpTZ_pos)
              (div_le_div_of_nonneg_right hpTC_ge hpTZ_pos.le)
          have hmul := mul_le_mul_of_nonneg_left hlog_mono hp_pos.le
          linarith
      have h_sum_st :
          (∑ tid : Fin N_T, ∑ k ∈ S_cells, -(p_TC tid k * Real.log (p_TC tid k / p_T tid))) -
          (∑ tid : Fin N_T, ∑ z : Fin N_Z, -(p_TZ tid z * Real.log (p_TZ tid z / p_T tid))) ≤
          ∑ z : Fin N_Z, p_Z z * ∑ tid : Fin N_T, ∑ k ∈ S_cells,
            -(p_TC_c z tid k * Real.log (p_TC_c z tid k / p_T_c z tid)) := by
        have h_tid : ∀ tid : Fin N_T,
            (∑ k ∈ S_cells, -(p_TC tid k * Real.log (p_TC tid k / p_T tid))) -
            (∑ z : Fin N_Z, -(p_TZ tid z * Real.log (p_TZ tid z / p_T tid))) ≤
            ∑ z : Fin N_Z, p_Z z * ∑ k ∈ S_cells,
              -(p_TC_c z tid k * Real.log (p_TC_c z tid k / p_T_c z tid)) := by
          intro tid
          have h1 : (∑ k ∈ S_cells, -(p_TC tid k * Real.log (p_TC tid k / p_T tid))) =
              ∑ z : Fin N_Z, ∑ k ∈ S_cells,
                -(p_TCZ tid k z * Real.log (p_TC tid k / p_T tid)) := by
            rw [Finset.sum_comm]
            refine Finset.sum_congr rfl (fun k _ => ?_)
            rw [Finset.sum_neg_distrib, ← Finset.sum_mul, hpTCZ_sum_z tid k]
          have h2 : (∑ z : Fin N_Z, -(p_TZ tid z * Real.log (p_TZ tid z / p_T tid))) =
              ∑ z : Fin N_Z, ∑ k ∈ S_cells,
                -(p_TCZ tid k z * Real.log (p_TZ tid z / p_T tid)) := by
            refine Finset.sum_congr rfl (fun z _ => ?_)
            rw [Finset.sum_neg_distrib, ← Finset.sum_mul, hpTCZ_sum_k tid z]
          rw [h1, h2, ← Finset.sum_sub_distrib]
          refine Finset.sum_le_sum (fun z _ => ?_)
          rw [Finset.mul_sum, ← Finset.sum_sub_distrib]
          refine Finset.sum_le_sum (fun k _ => ?_)
          have hpt := h_pt_st tid z k
          linarith
        calc (∑ tid : Fin N_T, ∑ k ∈ S_cells, -(p_TC tid k * Real.log (p_TC tid k / p_T tid))) -
              (∑ tid : Fin N_T, ∑ z : Fin N_Z, -(p_TZ tid z * Real.log (p_TZ tid z / p_T tid)))
            = ∑ tid : Fin N_T,
                ((∑ k ∈ S_cells, -(p_TC tid k * Real.log (p_TC tid k / p_T tid))) -
                 (∑ z : Fin N_Z, -(p_TZ tid z * Real.log (p_TZ tid z / p_T tid)))) :=
              (Finset.sum_sub_distrib _ _).symm
          _ ≤ ∑ tid : Fin N_T, ∑ z : Fin N_Z, p_Z z * ∑ k ∈ S_cells,
                -(p_TC_c z tid k * Real.log (p_TC_c z tid k / p_T_c z tid)) :=
              Finset.sum_le_sum (fun tid _ => h_tid tid)
          _ = ∑ z : Fin N_Z, p_Z z * ∑ tid : Fin N_T, ∑ k ∈ S_cells,
                -(p_TC_c z tid k * Real.log (p_TC_c z tid k / p_T_c z tid)) := by
              rw [Finset.sum_comm]
              refine Finset.sum_congr rfl (fun z _ => ?_)
              rw [Finset.mul_sum]
      have h_Z_ent : ∑ tid : Fin N_T, ∑ z : Fin N_Z,
          -(p_TZ tid z * Real.log (p_TZ tid z / p_T tid)) ≤ Real.log (N_Z : ℝ) := by
        have h_card : 0 < (Finset.univ : Finset (Fin N_Z)).card := by
          rw [Finset.card_univ, Fintype.card_fin]; exact hNZ_pos
        calc ∑ tid : Fin N_T, ∑ z : Fin N_Z, -(p_TZ tid z * Real.log (p_TZ tid z / p_T tid))
            ≤ ∑ tid : Fin N_T, p_T tid * Real.log ((Finset.univ : Finset (Fin N_Z)).card : ℝ) :=
              Finset.sum_le_sum (fun tid _ =>
                h_ent_card Finset.univ (fun z => p_TZ tid z) (p_T tid)
                  h_card (fun z _ => hpTZ_nn tid z) (hpTZ_row tid))
          _ = (∑ tid : Fin N_T, p_T tid) * Real.log (N_Z : ℝ) := by
              rw [Finset.card_univ, Fintype.card_fin, ← Finset.sum_mul]
          _ = Real.log (N_Z : ℝ) := by rw [hpT_sum, one_mul]
      have h_num_le : (∑ tid : Fin N_T, ∑ k ∈ S_cells,
            -(p_TC tid k * Real.log (p_TC tid k / p_T tid))) ≤
          (∑ z : Fin N_Z, p_Z z * ∑ tid : Fin N_T, ∑ k ∈ S_cells,
            -(p_TC_c z tid k * Real.log (p_TC_c z tid k / p_T_c z tid))) +
          Real.log (N_Z : ℝ) := by linarith
      have h_div_le := div_le_div_of_nonneg_right h_num_le hell_pos.le
      have h_stc_sum : (∑ z : Fin N_Z,
            p_Z z * ∑ tid : Fin N_T, ∑ k ∈ S_cells,
              -(p_TC_c z tid k * Real.log (p_TC_c z tid k / p_T_c z tid))) / ell =
          ∑ z : Fin N_Z, p_Z z * S_t_c z := by
        rw [Finset.sum_div]
        exact Finset.sum_congr rfl (fun z _ => mul_div_assoc _ _ _)
      rwa [add_div, h_stc_sum] at h_div_le
    
    have h_score_pi :
        classicalTransportScore ε γ N_ω N_T N_G π T_idx k_time G_idx b_G a_G =
          (∑ g : Fin N_G, p_G g * ((1 + γ) * b_G g + (1 - γ) * a_G g)) -
          (∑ tid : Fin N_T, ∑ g : Fin N_G,
            p_TG tid g * Real.log (p_TG tid g / (p_T tid * p_G g))) / ell +
          2 * ((∑ tid : Fin N_T, ∑ k ∈ S_cells,
            -(p_TC tid k * Real.log (p_TC tid k / p_T tid))) / ell) := rfl
    have h_lin_sum : (∑ z : Fin N_Z,
          p_Z z * classicalTransportScore ε γ N_ω N_T N_G (π_cond z) T_idx k_time G_idx b_G a_G) =
        (∑ z : Fin N_Z, p_Z z * E_w_c z) - (∑ z : Fin N_Z, p_Z z * I_TG_c z) +
          2 * (∑ z : Fin N_Z, p_Z z * S_t_c z) := by
      simp_rw [h_score_c]
      have h1 : ∀ z : Fin N_Z, p_Z z * (E_w_c z - I_TG_c z + 2 * S_t_c z) =
          p_Z z * E_w_c z - p_Z z * I_TG_c z + 2 * (p_Z z * S_t_c z) := fun _ => by ring
      simp_rw [h1, Finset.sum_add_distrib, Finset.sum_sub_distrib, ← Finset.mul_sum]
    have h_2log : 2 * (Real.log (N_Z : ℝ) / ell) =
        (4 * Real.log ((⌊K_hor / ξ⌋₊ + 1 : ℕ) : ℝ)) / ell := by
      rw [← mul_div_assoc, hlog_NZ]
    linarith [h_score_pi, h_lin_sum, h_Ew_id, h_ITG_id, h_St_le, h_2log]

  
  have h_s3_gluing :
      ∑ z : Fin N_Z,
        p_Z z * classicalRootSupremum ε L γ N_ω N_T (π_cond z) T_idx V₁ A₁ ≤
      classicalRootSupremum ε L γ N_ω N_T π T_idx V₁ A₁ + I_TZ + 1 / ell := by
    have h_wit : ∀ z : Fin N_Z,
        ∃ (N_z : ℕ)
          (b_z a_z : Fin N_z → ℝ)
          (e_z V_z A_z : Fin N_z → EuclideanSpace ℝ (Fin 2))
          (q_z : Fin N_T → Fin N_z → ℝ),
          (∀ d : Fin N_z, 0 ≤ b_z d ∧ b_z d ≤ a_z d ∧ a_z d ≤ L ∧ ‖e_z d‖ = 1) ∧
          (∀ tid d, 0 ≤ q_z tid d) ∧
          (∀ tid : Fin N_T, ∑ d : Fin N_z, p_Z z * q_z tid d = p_TZ tid z) ∧
          (∀ tid : Fin N_T, ∀ d : Fin N_z, 0 < q_z tid d →
            |inner ℝ (V₁ tid - V_z d) (e_z d)| ≤ 10 * ε ^ (b_z d) ∧
            |inner ℝ (V₁ tid - V_z d) (perp2D (e_z d))| ≤ 10 * ε ^ (a_z d) ∧
            |inner ℝ (A₁ tid - A_z d) (e_z d)| ≤ 10 * ε ^ (b_z d) ∧
            |inner ℝ (A₁ tid - A_z d) (perp2D (e_z d))| ≤ 10 * ε ^ (a_z d)) ∧
          (let q_Dz := fun d => ∑ tid : Fin N_T, q_z tid d
           let I_z := (∑ tid : Fin N_T, ∑ d : Fin N_z,
             q_z tid d * Real.log (q_z tid d / (p_T_c z tid * q_Dz d))) / ell
           let E_z := ∑ d : Fin N_z, q_Dz d * ((1 + γ) * b_z d + (1 - γ) * a_z d)
           p_Z z * (classicalRootSupremum ε L γ N_ω N_T (π_cond z) T_idx V₁ A₁ - 1 / ell) ≤
             p_Z z * (E_z - I_z)) := by
      intro z
      by_cases hpZ0 : p_Z z = 0
      · refine ⟨0, Fin.elim0, Fin.elim0, Fin.elim0, Fin.elim0, Fin.elim0,
          fun _ => Fin.elim0, fun d => Fin.elim0 d, fun _ d => Fin.elim0 d, ?_,
          fun _ d => Fin.elim0 d, ?_⟩
        · intro tid
          have hpTZ_le : p_TZ tid z ≤ p_Z z := by
            rw [← hpTZ_col z]
            exact Finset.single_le_sum (fun tid' _ => hpTZ_nn tid' z) (Finset.mem_univ tid)
          have hpTZ0 : p_TZ tid z = 0 := le_antisymm (hpZ0 ▸ hpTZ_le) (hpTZ_nn tid z)
          simp [hpTZ0]
        · dsimp only
          simp [hpZ0]
      · have hpZ_pos : 0 < p_Z z := lt_of_le_of_ne (hpZ_nn z) (Ne.symm hpZ0)
        obtain ⟨hπz_nn, hπz_sum⟩ := hπ_cond_law z hpZ_pos
        have h_ne : (rootSet L (π_cond z) V₁ A₁).Nonempty :=
          ⟨0, h_root_zero_mem L (π_cond z) hL_nn hπz_nn hπz_sum⟩
        have h_lt : sSup (rootSet L (π_cond z) V₁ A₁) - 1 / ell <
            sSup (rootSet L (π_cond z) V₁ A₁) := by
          have hpos : 0 < 1 / ell := one_div_pos.mpr hell_pos
          linarith
        obtain ⟨s_z, hs_z_mem, hs_z_gt⟩ := exists_lt_of_lt_csSup h_ne h_lt
        rcases hs_z_mem with ⟨N_z, b_z, a_z, e_z, V_z, A_z, q_z,
          hd_z, hq_z_nn, hq_z_row, hq_z_geom, hs_z_eq⟩
        refine ⟨N_z, b_z, a_z, e_z, V_z, A_z, q_z, hd_z, hq_z_nn, ?_, hq_z_geom, ?_⟩
        · intro tid
          rw [← Finset.mul_sum, hq_z_row tid]
          change p_Z z * p_T_c z tid = p_TZ tid z
          rw [hpT_c_eq z tid, mul_div_cancel₀ _ hpZ0]
        · dsimp only at hs_z_eq ⊢
          rw [h_root_eq L (π_cond z) V₁ A₁]
          have h_le : sSup (rootSet L (π_cond z) V₁ A₁) - 1 / ell ≤ s_z := hs_z_gt.le
          rw [hs_z_eq] at h_le
          exact mul_le_mul_of_nonneg_left h_le hpZ_pos.le
    choose N_z b_z a_z e_z V_z A_z q_z h_wz using h_wit
    let N_tot : ℕ := ∑ z : Fin N_Z, N_z z
    let e_sig : (Σ z : Fin N_Z, Fin (N_z z)) ≃ Fin N_tot := finSigmaFinEquiv
    let b_tot : Fin N_tot → ℝ := fun u => b_z (e_sig.symm u).1 (e_sig.symm u).2
    let a_tot : Fin N_tot → ℝ := fun u => a_z (e_sig.symm u).1 (e_sig.symm u).2
    let e_tot : Fin N_tot → EuclideanSpace ℝ (Fin 2) := fun u => e_z (e_sig.symm u).1 (e_sig.symm u).2
    let V_tot : Fin N_tot → EuclideanSpace ℝ (Fin 2) := fun u => V_z (e_sig.symm u).1 (e_sig.symm u).2
    let A_tot : Fin N_tot → EuclideanSpace ℝ (Fin 2) := fun u => A_z (e_sig.symm u).1 (e_sig.symm u).2
    let q_tot : Fin N_T → Fin N_tot → ℝ :=
      fun tid u => p_Z (e_sig.symm u).1 * q_z (e_sig.symm u).1 tid (e_sig.symm u).2
    let q_Dz : ∀ z : Fin N_Z, Fin (N_z z) → ℝ := fun z d => ∑ tid : Fin N_T, q_z z tid d
    let q_D_tot : Fin N_tot → ℝ := fun u => ∑ tid : Fin N_T, q_tot tid u
    have hq_tot_apply : ∀ (tid : Fin N_T) (z : Fin N_Z) (d : Fin (N_z z)),
        q_tot tid (e_sig ⟨z, d⟩) = p_Z z * q_z z tid d := by
      intro tid z d
      dsimp only [q_tot]
      rw [e_sig.symm_apply_apply]
    have hq_D_tot_apply : ∀ (z : Fin N_Z) (d : Fin (N_z z)),
        q_D_tot (e_sig ⟨z, d⟩) = p_Z z * q_Dz z d := by
      intro z d
      dsimp only [q_D_tot, q_Dz]
      simp_rw [hq_tot_apply, ← Finset.mul_sum]
    have hq_tot_nn : ∀ tid u, 0 ≤ q_tot tid u :=
      fun tid u => mul_nonneg (hpZ_nn _) ((h_wz _).2.1 tid _)
    have hq_tot_row : ∀ tid : Fin N_T, ∑ u : Fin N_tot, q_tot tid u = p_T tid := by
      intro tid
      rw [← e_sig.sum_comp, Fintype.sum_sigma]
      simp_rw [hq_tot_apply, (h_wz _).2.2.1 tid]
      exact hpTZ_row tid
    have hq_tot_geom : ∀ (tid : Fin N_T) (u : Fin N_tot), 0 < q_tot tid u →
        |inner ℝ (V₁ tid - V_tot u) (e_tot u)| ≤ 10 * ε ^ (b_tot u) ∧
        |inner ℝ (V₁ tid - V_tot u) (perp2D (e_tot u))| ≤ 10 * ε ^ (a_tot u) ∧
        |inner ℝ (A₁ tid - A_tot u) (e_tot u)| ≤ 10 * ε ^ (b_tot u) ∧
        |inner ℝ (A₁ tid - A_tot u) (perp2D (e_tot u))| ≤ 10 * ε ^ (a_tot u) := by
      intro tid u h_pos
      dsimp only [q_tot] at h_pos
      have hqz_pos : 0 < q_z (e_sig.symm u).1 tid (e_sig.symm u).2 := by
        by_contra h_le
        have hqz0 : q_z (e_sig.symm u).1 tid (e_sig.symm u).2 = 0 :=
          le_antisymm (le_of_not_gt h_le) ((h_wz _).2.1 tid _)
        rw [hqz0, mul_zero] at h_pos
        exact lt_irrefl 0 h_pos
      exact (h_wz (e_sig.symm u).1).2.2.2.1 tid (e_sig.symm u).2 hqz_pos
    let E_z : Fin N_Z → ℝ :=
      fun z => ∑ d : Fin (N_z z), q_Dz z d * ((1 + γ) * b_z z d + (1 - γ) * a_z z d)
    let I_z : Fin N_Z → ℝ :=
      fun z => (∑ tid : Fin N_T, ∑ d : Fin (N_z z),
        q_z z tid d * Real.log (q_z z tid d / (p_T_c z tid * q_Dz z d))) / ell
    let E_tot : ℝ := ∑ u : Fin N_tot, q_D_tot u * ((1 + γ) * b_tot u + (1 - γ) * a_tot u)
    let I_tot : ℝ := (∑ tid : Fin N_T, ∑ u : Fin N_tot,
      q_tot tid u * Real.log (q_tot tid u / (p_T tid * q_D_tot u))) / ell
    have hE_tot_eq : E_tot = ∑ z : Fin N_Z, p_Z z * E_z z := by
      dsimp only [E_tot, E_z]
      rw [← e_sig.sum_comp, Fintype.sum_sigma]
      refine Finset.sum_congr rfl (fun z _ => ?_)
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl (fun d _ => ?_)
      rw [hq_D_tot_apply]
      dsimp only [b_tot, a_tot]
      rw [e_sig.symm_apply_apply]
      ring
    have hI_tot_eq : I_tot = (∑ z : Fin N_Z, p_Z z * I_z z) + I_TZ := by
      have h_pt : ∀ (tid : Fin N_T) (z : Fin N_Z) (d : Fin (N_z z)),
          q_tot tid (e_sig ⟨z, d⟩) *
            Real.log (q_tot tid (e_sig ⟨z, d⟩) / (p_T tid * q_D_tot (e_sig ⟨z, d⟩))) =
          p_Z z * (q_z z tid d * Real.log (q_z z tid d / (p_T_c z tid * q_Dz z d))) +
            (p_Z z * q_z z tid d) * Real.log (p_TZ tid z / (p_T tid * p_Z z)) := by
        intro tid z d
        rw [hq_tot_apply, hq_D_tot_apply]
        by_cases hpZ0 : p_Z z = 0
        · simp [hpZ0]
        · by_cases hqz0 : q_z z tid d = 0
          · simp [hqz0]
          · have hpZ_pos : 0 < p_Z z := lt_of_le_of_ne (hpZ_nn z) (Ne.symm hpZ0)
            have hqz_pos : 0 < q_z z tid d :=
              lt_of_le_of_ne ((h_wz z).2.1 tid d) (Ne.symm hqz0)
            have hqDz_pos : 0 < q_Dz z d :=
              lt_of_lt_of_le hqz_pos
                (Finset.single_le_sum (fun tid' _ => (h_wz z).2.1 tid' d) (Finset.mem_univ tid))
            have hpTZ_pos : 0 < p_TZ tid z := by
              refine lt_of_lt_of_le (mul_pos hpZ_pos hqz_pos) ?_
              rw [← (h_wz z).2.2.1 tid]
              exact Finset.single_le_sum
                (fun d' _ => mul_nonneg hpZ_pos.le ((h_wz z).2.1 tid d'))
                (Finset.mem_univ d)
            have hpT_pos : 0 < p_T tid := by
              refine lt_of_lt_of_le hpTZ_pos ?_
              rw [← hpTZ_row tid]
              exact Finset.single_le_sum (fun z' _ => hpTZ_nn tid z') (Finset.mem_univ z)
            rw [hpT_c_eq z tid]
            have h_arg : (p_Z z * q_z z tid d) / (p_T tid * (p_Z z * q_Dz z d)) =
                (q_z z tid d / ((p_TZ tid z / p_Z z) * q_Dz z d)) *
                (p_TZ tid z / (p_T tid * p_Z z)) := by
              field_simp [hpZ0, ne_of_gt hpT_pos, ne_of_gt hqDz_pos, ne_of_gt hpTZ_pos]
            have h_f1_pos : 0 < q_z z tid d / ((p_TZ tid z / p_Z z) * q_Dz z d) :=
              div_pos hqz_pos (mul_pos (div_pos hpTZ_pos hpZ_pos) hqDz_pos)
            have h_f2_pos : 0 < p_TZ tid z / (p_T tid * p_Z z) :=
              div_pos hpTZ_pos (mul_pos hpT_pos hpZ_pos)
            rw [h_arg, Real.log_mul (ne_of_gt h_f1_pos) (ne_of_gt h_f2_pos)]
            ring
      have h_num : (∑ tid : Fin N_T, ∑ u : Fin N_tot,
            q_tot tid u * Real.log (q_tot tid u / (p_T tid * q_D_tot u))) =
          (∑ z : Fin N_Z, p_Z z * ∑ tid : Fin N_T, ∑ d : Fin (N_z z),
            q_z z tid d * Real.log (q_z z tid d / (p_T_c z tid * q_Dz z d))) +
          (∑ tid : Fin N_T, ∑ z : Fin N_Z,
            p_TZ tid z * Real.log (p_TZ tid z / (p_T tid * p_Z z))) := by
        have h_tid : ∀ tid : Fin N_T,
            (∑ u : Fin N_tot, q_tot tid u * Real.log (q_tot tid u / (p_T tid * q_D_tot u))) =
            (∑ z : Fin N_Z, ∑ d : Fin (N_z z),
              p_Z z * (q_z z tid d * Real.log (q_z z tid d / (p_T_c z tid * q_Dz z d)))) +
            (∑ z : Fin N_Z, p_TZ tid z * Real.log (p_TZ tid z / (p_T tid * p_Z z))) := by
          intro tid
          rw [← e_sig.sum_comp, Fintype.sum_sigma]
          simp_rw [h_pt tid, Finset.sum_add_distrib]
          congr 1
          refine Finset.sum_congr rfl (fun z _ => ?_)
          rw [← Finset.sum_mul, (h_wz z).2.2.1 tid]
        simp_rw [h_tid]
        rw [Finset.sum_add_distrib]
        congr 1
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl (fun z _ => ?_)
        rw [Finset.mul_sum]
        exact Finset.sum_congr rfl (fun tid _ => (Finset.mul_sum _ _ _).symm)
      dsimp only [I_tot, I_z, I_TZ]
      rw [h_num, add_div]
      congr 1
      rw [Finset.sum_div]
      exact Finset.sum_congr rfl (fun z _ => mul_div_assoc _ _ _)
    have hs_tot_mem : E_tot - I_tot ∈ rootSet L π V₁ A₁ :=
      ⟨N_tot, b_tot, a_tot, e_tot, V_tot, A_tot, q_tot,
        fun u => (h_wz (e_sig.symm u).1).1 (e_sig.symm u).2,
        hq_tot_nn, hq_tot_row, hq_tot_geom, rfl⟩
    have hs_tot_le : E_tot - I_tot ≤ classicalRootSupremum ε L γ N_ω N_T π T_idx V₁ A₁ := by
      rw [h_root_eq L π V₁ A₁]
      exact le_csSup (h_root_bdd L π V₁ A₁ hπ_nn hπ_sum) hs_tot_mem
    have h_sum_wz :
        (∑ z : Fin N_Z,
          p_Z z * classicalRootSupremum ε L γ N_ω N_T (π_cond z) T_idx V₁ A₁) - 1 / ell ≤
        (∑ z : Fin N_Z, p_Z z * E_z z) - (∑ z : Fin N_Z, p_Z z * I_z z) := by
      have h_step := Finset.sum_le_sum (s := Finset.univ) (fun z _ => (h_wz z).2.2.2.2)
      have hlhs : (∑ z : Fin N_Z,
            p_Z z * (classicalRootSupremum ε L γ N_ω N_T (π_cond z) T_idx V₁ A₁ - 1 / ell)) =
          (∑ z : Fin N_Z,
            p_Z z * classicalRootSupremum ε L γ N_ω N_T (π_cond z) T_idx V₁ A₁) - 1 / ell := by
        simp_rw [mul_sub]
        rw [Finset.sum_sub_distrib, ← Finset.sum_mul, hpZ_sum, one_mul]
      have hrhs : (∑ z : Fin N_Z, p_Z z * (E_z z - I_z z)) =
          (∑ z : Fin N_Z, p_Z z * E_z z) - (∑ z : Fin N_Z, p_Z z * I_z z) := by
        simp_rw [mul_sub]
        exact Finset.sum_sub_distrib _ _
      dsimp only [E_z, I_z, q_Dz] at hlhs hrhs ⊢
      linarith [h_step, hlhs, hrhs]
    linarith [hs_tot_le, hE_tot_eq, hI_tot_eq, h_sum_wz]

  
  let D_fib : Fin N_Z → ℝ := fun z =>
    classicalTransportScore ε γ N_ω N_T N_G (π_cond z) T_idx k_time G_idx b_G a_G -
      classicalRootSupremum ε L γ N_ω N_T (π_cond z) T_idx V₁ A₁
  let Z_pos : Finset (Fin N_Z) :=
    @Finset.filter (Fin N_Z) (fun z => 0 < p_Z z) (fun _ => Classical.propDecidable _) Finset.univ
  have hZ_pos_mem : ∀ z : Fin N_Z, z ∈ Z_pos ↔ 0 < p_Z z := by
    intro z; simp [Z_pos, @Finset.mem_filter]
  obtain ⟨z₀, _, hz₀_ne⟩ := Finset.exists_ne_zero_of_sum_ne_zero (by rw [hpZ_sum]; norm_num)
  have hZ_pos_ne : Z_pos.Nonempty :=
    ⟨z₀, (hZ_pos_mem z₀).mpr (lt_of_le_of_ne (hpZ_nn z₀) (Ne.symm hz₀_ne))⟩
  obtain ⟨z_star, hz_star_in, hz_star_max⟩ := Finset.exists_max_image Z_pos D_fib hZ_pos_ne
  have hpZ_star_pos : 0 < p_Z z_star := (hZ_pos_mem z_star).mp hz_star_in
  have hD_avg_le : (∑ z : Fin N_Z, p_Z z * D_fib z) ≤ D_fib z_star := by
    have h_term : ∀ z ∈ (Finset.univ : Finset (Fin N_Z)),
        p_Z z * D_fib z ≤ p_Z z * D_fib z_star := by
      intro z _
      by_cases hp0 : p_Z z = 0
      · simp [hp0]
      · have hp_pos : 0 < p_Z z := lt_of_le_of_ne (hpZ_nn z) (Ne.symm hp0)
        exact mul_le_mul_of_nonneg_left
          (hz_star_max z ((hZ_pos_mem z).mpr hp_pos)) hp_pos.le
    calc ∑ z : Fin N_Z, p_Z z * D_fib z
        ≤ ∑ z : Fin N_Z, p_Z z * D_fib z_star := Finset.sum_le_sum h_term
      _ = (∑ z : Fin N_Z, p_Z z) * D_fib z_star := (Finset.sum_mul _ _ _).symm
      _ = D_fib z_star := by rw [hpZ_sum, one_mul]

  let π₁ : Fin N_ω → ℝ := π_cond z_star
  obtain ⟨hπ₁_nn, hπ₁_sum⟩ := hπ_cond_law z_star hpZ_star_pos
  have hπ₁_pos_iff : ∀ ω : Fin N_ω, 0 < π₁ ω ↔ Z ω = z_star ∧ 0 < π ω := by
    intro ω
    dsimp only [π₁, π_cond]
    by_cases hz : Z ω = z_star
    · rw [if_pos hz]
      exact ⟨fun h => ⟨hz, (div_pos_iff_of_pos_right hpZ_star_pos).mp h⟩,
        fun h => div_pos h.2 hpZ_star_pos⟩
    · rw [if_neg hz]
      exact ⟨fun h => absurd h (lt_irrefl 0), fun h => absurd h.1 hz⟩

  let F₁ : Finset (Fin N_ω) :=
    @Finset.filter (Fin N_ω) (fun ω => 0 < π₁ ω) (fun _ => Classical.propDecidable _) Finset.univ
  have hF₁_mem : ∀ ω : Fin N_ω, ω ∈ F₁ ↔ 0 < π₁ ω := by
    intro ω; simp [F₁, @Finset.mem_filter]
  obtain ⟨ω₁, _, hω₁_ne⟩ := Finset.exists_ne_zero_of_sum_ne_zero (by rw [hπ₁_sum]; norm_num)
  have hF₁_ne : F₁.Nonempty :=
    ⟨ω₁, (hF₁_mem ω₁).mpr (lt_of_le_of_ne (hπ₁_nn ω₁) (Ne.symm hω₁_ne))⟩
  obtain ⟨ω_b, hω_b_in, hω_b_min⟩ :=
    Finset.exists_min_image F₁ (fun ω => b_G (G_idx ω)) hF₁_ne
  obtain ⟨ω_a, hω_a_in, hω_a_min⟩ :=
    Finset.exists_min_image F₁ (fun ω => a_G (G_idx ω)) hF₁_ne
  let b_star : ℝ := b_G (G_idx ω_b)
  let a_star : ℝ := a_G (G_idx ω_a)

  have hb_star_nn : 0 ≤ b_star := (hG_adm (G_idx ω_b)).1
  have hba_star : b_star ≤ a_star :=
    le_trans (hω_b_min ω_a hω_a_in) (hG_adm (G_idx ω_a)).2.1
  have hat_star_L : a_star + t ≤ L := (hG_adm (G_idx ω_a)).2.2.1

  
  have h_supp₁ : ∀ ω : Fin N_ω, 0 < π₁ ω →
      let tid := T_idx ω
      let g := G_idx ω
      let c_mid := ((k_time ω : ℝ) + 1 / 2) * Δ_time
      c_mid ∈ Set.Icc (0 : ℝ) 1 ∧
      k_G g = k_time ω ∧
      |inner ℝ (V₁ tid - V_G1 g) (e_G g)| ≤ ε ^ b_star ∧
      |inner ℝ (V₁ tid - V_G1 g) (perp2D (e_G g))| ≤ ε ^ a_star ∧
      |inner ℝ ((A₁ tid + c_mid • V₁ tid) - X_G1 g) (e_G g)| ≤ ε ^ (b_star + t) ∧
      |inner ℝ ((A₁ tid + c_mid • V₁ tid) - X_G1 g) (perp2D (e_G g))| ≤ ε ^ (a_star + t) := by
    intro ω hπ₁_pos
    have hωF : ω ∈ F₁ := (hF₁_mem ω).mpr hπ₁_pos
    have hπω_pos : 0 < π ω := ((hπ₁_pos_iff ω).mp hπ₁_pos).2
    obtain ⟨hc_mid, hk_eq, hv1, hv2, hx1, hx2⟩ := h_supp ω hπω_pos
    have hb_le : b_star ≤ b_G (G_idx ω) := hω_b_min ω hωF
    have ha_le : a_star ≤ a_G (G_idx ω) := hω_a_min ω hωF
    let c_mid : ℝ := ((k_time ω : ℝ) + 1 / 2) * Δ_time
    have hV_sub : V₁ (T_idx ω) - V_G1 (G_idx ω) =
        B_cl⁻¹ • (V_part (T_idx ω) - V_G (G_idx ω)) :=
      (smul_sub B_cl⁻¹ _ _).symm
    have hX_sub : (A₁ (T_idx ω) + c_mid • V₁ (T_idx ω)) - X_G1 (G_idx ω) =
        B_cl⁻¹ • ((A_part (T_idx ω) + c_mid • V_part (T_idx ω)) - X_G (G_idx ω)) := by
      dsimp only [A₁, V₁, X_G1]
      rw [smul_comm c_mid B_cl⁻¹, ← smul_add, ← smul_sub]
    have h_scale_cap : ∀ (w₁ w dir : EuclideanSpace ℝ (Fin 2)) (d₁ d₂ : ℝ),
        w₁ = B_cl⁻¹ • w → d₁ ≤ d₂ → |inner ℝ w dir| ≤ B_cl * ε ^ d₂ →
        |inner ℝ w₁ dir| ≤ ε ^ d₁ := by
      intro w₁ w dir d₁ d₂ hw hd hcap
      rw [hw, real_inner_smul_left, abs_mul, abs_of_pos hB_inv_pos]
      calc B_cl⁻¹ * |inner ℝ w dir|
          ≤ B_cl⁻¹ * (B_cl * ε ^ d₂) := mul_le_mul_of_nonneg_left hcap hB_inv_pos.le
        _ = ε ^ d₂ := by rw [← mul_assoc, inv_mul_cancel₀ hB_ne, one_mul]
        _ ≤ ε ^ d₁ := Real.rpow_le_rpow_of_exponent_ge hε₀ hε_le_one hd
    exact ⟨hc_mid, hk_eq,
      h_scale_cap _ _ _ _ _ hV_sub hb_le hv1,
      h_scale_cap _ _ _ _ _ hV_sub ha_le hv2,
      h_scale_cap _ _ _ _ _ hX_sub (by linarith) hx1,
      h_scale_cap _ _ _ _ _ hX_sub (by linarith) hx2⟩

  
  have h_score_shift :
      classicalTransportScore ε γ N_ω N_T N_G π₁ T_idx k_time G_idx b_G a_G ≤
      classicalTransportScore ε γ N_ω N_T N_G π₁ T_idx k_time G_idx
        (fun _ => b_star) (fun _ => a_star) + 2 * ξ := by
    let p_G1 : Fin N_G → ℝ := fun g => ∑ ω : Fin N_ω, if G_idx ω = g then π₁ ω else 0
    have hpG1_nn : ∀ g, 0 ≤ p_G1 g := fun g =>
      Finset.sum_nonneg (fun ω _ => by split_ifs <;> [exact hπ₁_nn ω; exact le_rfl])
    have hpG1_sum : ∑ g : Fin N_G, p_G1 g = 1 := by
      dsimp only [p_G1]
      rw [Finset.sum_comm]
      have h_in : ∀ ω : Fin N_ω, (∑ g : Fin N_G, if G_idx ω = g then π₁ ω else 0) = π₁ ω :=
        fun ω => by simp [Finset.sum_ite_eq]
      simp_rw [h_in]
      exact hπ₁_sum
    have hz_wb : z_G (G_idx ω_b) = z_star :=
      ((hπ₁_pos_iff ω_b).mp ((hF₁_mem ω_b).mp hω_b_in)).1
    have hz_wa : z_G (G_idx ω_a) = z_star :=
      ((hπ₁_pos_iff ω_a).mp ((hF₁_mem ω_a).mp hω_a_in)).1
    have h_Ew_le :
        ∑ g : Fin N_G, p_G1 g * ((1 + γ) * b_G g + (1 - γ) * a_G g) ≤
        (∑ g : Fin N_G, p_G1 g * ((1 + γ) * b_star + (1 - γ) * a_star)) + 2 * ξ := by
      have h_term : ∀ g ∈ (Finset.univ : Finset (Fin N_G)),
          p_G1 g * ((1 + γ) * b_G g + (1 - γ) * a_G g) ≤
          p_G1 g * (((1 + γ) * b_star + (1 - γ) * a_star) + 2 * ξ) := by
        intro g _
        by_cases hp0 : p_G1 g = 0
        · simp [hp0]
        · have hp_pos : 0 < p_G1 g := lt_of_le_of_ne (hpG1_nn g) (Ne.symm hp0)
          obtain ⟨ω, _, hω_ne⟩ := Finset.exists_ne_zero_of_sum_ne_zero (ne_of_gt hp_pos)
          have hg_eq : G_idx ω = g := by
            by_contra hne
            rw [if_neg hne] at hω_ne
            exact hω_ne rfl
          rw [if_pos hg_eq] at hω_ne
          have hπ₁_ω : 0 < π₁ ω := lt_of_le_of_ne (hπ₁_nn ω) (Ne.symm hω_ne)
          have hzg_star : z_G g = z_star := hg_eq ▸ ((hπ₁_pos_iff ω).mp hπ₁_ω).1
          have hpair_b := finProdFinEquiv.injective (hzg_star.trans hz_wb.symm)
          have hpair_a := finProdFinEquiv.injective (hzg_star.trans hz_wa.symm)
          have hfl_b : ⌊b_G g / ξ⌋₊ = ⌊b_star / ξ⌋₊ :=
            congrArg (fun p => p.1.1) hpair_b
          have hfl_a : ⌊a_G g / ξ⌋₊ = ⌊a_star / ξ⌋₊ :=
            congrArg (fun p => p.2.1) hpair_a
          have hb_diff : b_G g ≤ b_star + ξ := by
            have h1 : b_G g / ξ < (⌊b_G g / ξ⌋₊ : ℝ) + 1 := Nat.lt_floor_add_one _
            have h2 : (⌊b_star / ξ⌋₊ : ℝ) ≤ b_star / ξ :=
              Nat.floor_le (div_nonneg hb_star_nn hξ.le)
            rw [hfl_b] at h1
            have h3 : b_G g / ξ < (b_star + ξ) / ξ := by
              rw [add_div, div_self (ne_of_gt hξ)]
              linarith
            exact ((div_lt_div_iff_of_pos_right hξ).mp h3).le
          have ha_diff : a_G g ≤ a_star + ξ := by
            have h1 : a_G g / ξ < (⌊a_G g / ξ⌋₊ : ℝ) + 1 := Nat.lt_floor_add_one _
            have h2 : (⌊a_star / ξ⌋₊ : ℝ) ≤ a_star / ξ :=
              Nat.floor_le (div_nonneg (le_trans hb_star_nn hba_star) hξ.le)
            rw [hfl_a] at h1
            have h3 : a_G g / ξ < (a_star + ξ) / ξ := by
              rw [add_div, div_self (ne_of_gt hξ)]
              linarith
            exact ((div_lt_div_iff_of_pos_right hξ).mp h3).le
          have hw_le : (1 + γ) * b_G g + (1 - γ) * a_G g ≤
              ((1 + γ) * b_star + (1 - γ) * a_star) + 2 * ξ := by
            have h1 : (1 + γ) * b_G g ≤ (1 + γ) * (b_star + ξ) :=
              mul_le_mul_of_nonneg_left hb_diff (by linarith)
            have h2 : (1 - γ) * a_G g ≤ (1 - γ) * (a_star + ξ) :=
              mul_le_mul_of_nonneg_left ha_diff (by linarith)
            linarith
          exact mul_le_mul_of_nonneg_left hw_le hp_pos.le
      calc ∑ g : Fin N_G, p_G1 g * ((1 + γ) * b_G g + (1 - γ) * a_G g)
          ≤ ∑ g : Fin N_G, p_G1 g * (((1 + γ) * b_star + (1 - γ) * a_star) + 2 * ξ) :=
            Finset.sum_le_sum h_term
        _ = (∑ g : Fin N_G, p_G1 g * ((1 + γ) * b_star + (1 - γ) * a_star)) +
              (∑ g : Fin N_G, p_G1 g) * (2 * ξ) := by
            simp_rw [mul_add]
            rw [Finset.sum_add_distrib, ← Finset.sum_mul]
        _ = (∑ g : Fin N_G, p_G1 g * ((1 + γ) * b_star + (1 - γ) * a_star)) + 2 * ξ := by
            rw [hpG1_sum, one_mul]
    unfold classicalTransportScore
    dsimp only [p_G1] at h_Ew_le
    linarith [h_Ew_le]

  
  have h_root_mono :
      classicalRootSupremum ε (a_star + t) γ N_ω N_T π₁ T_idx V₁ A₁ ≤
      classicalRootSupremum ε L γ N_ω N_T π₁ T_idx V₁ A₁ := by
    rw [h_root_eq (a_star + t) π₁ V₁ A₁, h_root_eq L π₁ V₁ A₁]
    have hat_nn : 0 ≤ a_star + t := by linarith
    refine csSup_le_csSup
      (h_root_bdd L π₁ V₁ A₁ hπ₁_nn hπ₁_sum)
      ⟨0, h_root_zero_mem (a_star + t) π₁ hat_nn hπ₁_nn hπ₁_sum⟩ ?_
    rintro s ⟨N_D, b_D, a_D, e_D, V_D, A_D, q, hd_adm, hq_nn, hq_row, hq_geom, hs_eq⟩
    exact ⟨N_D, b_D, a_D, e_D, V_D, A_D, q,
      fun d => ⟨(hd_adm d).1, (hd_adm d).2.1, le_trans (hd_adm d).2.2.1 hat_star_L, (hd_adm d).2.2.2⟩,
      hq_nn, hq_row, hq_geom, hs_eq⟩

  
  refine ⟨b_star, a_star, π₁, V₁, A₁, V_G1, X_G1,
    hb_star_nn, hba_star, hat_star_L, hπ₁_nn, hπ₁_sum, hVA₁, h_supp₁, ?_⟩
  have hD_sum_eq : (∑ z : Fin N_Z, p_Z z * D_fib z) =
      (∑ z : Fin N_Z,
        p_Z z * classicalTransportScore ε γ N_ω N_T N_G (π_cond z) T_idx k_time G_idx b_G a_G) -
      (∑ z : Fin N_Z,
        p_Z z * classicalRootSupremum ε L γ N_ω N_T (π_cond z) T_idx V₁ A₁) := by
    dsimp only [D_fib]
    simp_rw [mul_sub]
    exact Finset.sum_sub_distrib _ _
  have hD_star_eq : D_fib z_star =
      classicalTransportScore ε γ N_ω N_T N_G π₁ T_idx k_time G_idx b_G a_G -
        classicalRootSupremum ε L γ N_ω N_T π₁ T_idx V₁ A₁ := rfl
  have h_err_sum :
      (4 * Real.log ((2 * ⌈B_cl⌉₊ + 1 : ℕ) : ℝ)) / ell +
      (4 * Real.log ((⌊K_hor / ξ⌋₊ + 1 : ℕ) : ℝ)) / ell +
      1 / ell =
      (4 * Real.log ((2 * ⌈B_cl⌉₊ + 1 : ℕ) : ℝ) +
        4 * Real.log ((⌊K_hor / ξ⌋₊ + 1 : ℕ) : ℝ) + 1) / ell := by
    rw [add_div, add_div]
  dsimp only [ell] at h_s1_rescaling h_s2_split h_s3_gluing h_err_sum
  linarith [h_s1_rescaling, h_s2_split, h_s3_gluing, hD_sum_eq, hD_avg_le,
    hD_star_eq, h_score_shift, h_root_mono, h_err_sum]

theorem fixed_shape_to_std_aperture_transfer (γ B_cl ε t Δ_time b_star a_star : ℝ)
    (hγ₀ : 0 < γ) (hγ₁ : γ < 1)
    (hB : 1 ≤ B_cl)
    (hε₀ : 0 < ε) (hε₁ : ε < 1 / 2)
    (ht : 0 < t)
    (hΔ_lo : B_cl⁻¹ * ε ^ t ≤ Δ_time)
    (hb₀ : 0 ≤ b_star) (hba : b_star ≤ a_star)
    {N_ω N_T N_G : ℕ}
    (π : Fin N_ω → ℝ)
    (T_idx : Fin N_ω → Fin N_T)
    (k_time : Fin N_ω → ℤ)
    (G_idx : Fin N_ω → Fin N_G)
    (V₁ A₁ : Fin N_T → EuclideanSpace ℝ (Fin 2))
    (e_G V_G1 X_G1 : Fin N_G → EuclideanSpace ℝ (Fin 2))
    (k_G : Fin N_G → ℤ)
    (hπ_nn : ∀ ω, 0 ≤ π ω)
    (hπ_sum : ∑ ω : Fin N_ω, π ω = 1)
    (hVA₁ : ∀ tid, ‖V₁ tid‖ ≤ 1 ∧ ‖A₁ tid‖ ≤ 1)
    (he_G : ∀ g, ‖e_G g‖ = 1)
    (h_supp : ∀ ω, 0 < π ω →
      let tid := T_idx ω
      let g := G_idx ω
      let c_mid := ((k_time ω : ℝ) + 1 / 2) * Δ_time
      c_mid ∈ Set.Icc (0 : ℝ) 1 ∧
      k_G g = k_time ω ∧
      |inner ℝ (V₁ tid - V_G1 g) (e_G g)| ≤ ε ^ b_star ∧
      |inner ℝ (V₁ tid - V_G1 g) (perp2D (e_G g))| ≤ ε ^ a_star ∧
      |inner ℝ ((A₁ tid + c_mid • V₁ tid) - X_G1 g) (e_G g)| ≤
        ε ^ (b_star + t) ∧
      |inner ℝ ((A₁ tid + c_mid • V₁ tid) - X_G1 g) (perp2D (e_G g))| ≤
        ε ^ (a_star + t)) :
    ∃ c_s θ_s : Fin N_ω → ℝ,
      IsUnitBallStdLaw π V₁ A₁ c_s θ_s ∧
      classicalTransportScore ε γ N_ω N_T N_G π T_idx k_time G_idx
          (fun _ => b_star) (fun _ => a_star) ≤
        stdApertureScore ε γ t b_star a_star π T_idx V₁ A₁ c_s θ_s +
          (2 * Real.log ((2 * ⌈B_cl⌉₊ + 2 : ℕ) : ℝ) + 12) / Real.log (ε⁻¹) :=
by
  have : DecidablePred (fun ω : Fin N_ω => 0 < π ω) := Classical.decPred _
  have : DecidablePred (fun e : EuclideanSpace ℝ (Fin 2) =>
    0 < e 1 ∨ (e 1 = 0 ∧ 0 ≤ e 0)) := Classical.decPred _
  have hε_lt_one : ε < 1 := by linarith
  have hε_le_one : ε ≤ 1 := hε_lt_one.le
  let ell : ℝ := Real.log (ε⁻¹)
  have hell_pos : 0 < ell := Real.log_pos ((one_lt_inv₀ hε₀).mpr hε_lt_one)
  have hell_ne : ell ≠ 0 := ne_of_gt hell_pos
  have hB_pos : 0 < B_cl := by linarith
  have hB_ne : B_cl ≠ 0 := ne_of_gt hB_pos
  have hεt_pos : 0 < ε ^ t := Real.rpow_pos_of_pos hε₀ t
  have hΔ_pos : 0 < Δ_time := lt_of_lt_of_le (mul_pos (inv_pos.mpr hB_pos) hεt_pos) hΔ_lo
  have hΔ_ne : Δ_time ≠ 0 := ne_of_gt hΔ_pos
  have hεt_le_BΔ : ε ^ t ≤ B_cl * Δ_time := by
    have hm := mul_le_mul_of_nonneg_left hΔ_lo hB_pos.le
    rwa [← mul_assoc, mul_inv_cancel₀ hB_ne, one_mul] at hm

  
  have h_dyad_lvl_inv : ∀ u : ℝ, ((2 : ℝ) ^ (dyadicTimeLevel ε u))⁻¹ ≤ ε ^ u := by
    intro u
    unfold dyadicTimeLevel
    have hε_neg_pos : 0 < ε ^ (-u) := Real.rpow_pos_of_pos hε₀ (-u)
    have h_le_ceil : ε ^ (-u) ≤ (⌈ε ^ (-u)⌉₊ : ℝ) := Nat.le_ceil (ε ^ (-u))
    have h_clog_nat : ⌈ε ^ (-u)⌉₊ ≤ 2 ^ (Nat.clog 2 ⌈ε ^ (-u)⌉₊) :=
      Nat.le_pow_clog (by norm_num : 1 < 2) _
    have h_clog_real : (⌈ε ^ (-u)⌉₊ : ℝ) ≤ (2 : ℝ) ^ (Nat.clog 2 ⌈ε ^ (-u)⌉₊) := by
      exact_mod_cast h_clog_nat
    have h_le_pow : ε ^ (-u) ≤ (2 : ℝ) ^ (Nat.clog 2 ⌈ε ^ (-u)⌉₊) :=
      le_trans h_le_ceil h_clog_real
    calc ((2 : ℝ) ^ (Nat.clog 2 ⌈ε ^ (-u)⌉₊))⁻¹
        ≤ (ε ^ (-u))⁻¹ := (inv_le_inv₀ (by positivity) hε_neg_pos).mpr h_le_pow
      _ = ε ^ u := by rw [Real.rpow_neg hε₀.le u, inv_inv]

  have h_mid_approx : ∀ c : ℝ, c ∈ Set.Icc (0 : ℝ) 1 →
      |dyadicTimeMid ε t c - c| ≤ (1 / 2 : ℝ) * ε ^ t := by
    intro c hc
    let m := dyadicTimeLevel ε t
    have h2m_pos : (0 : ℝ) < (2 : ℝ) ^ m := by positivity
    have h2m_ne : (2 : ℝ) ^ m ≠ 0 := ne_of_gt h2m_pos
    have h2m_inv_pos : (0 : ℝ) < ((2 : ℝ) ^ m)⁻¹ := inv_pos.mpr h2m_pos
    have h2m_inv_le : ((2 : ℝ) ^ m)⁻¹ ≤ ε ^ t := h_dyad_lvl_inv t
    unfold dyadicTimeMid dyadicTimeBin
    change |(((min ⌊c * (2 : ℝ) ^ m⌋ ((2 ^ m : ℤ) - 1) : ℤ) : ℝ) + 1 / 2) * ((2 : ℝ) ^ m)⁻¹ - c| ≤
      (1 / 2 : ℝ) * ε ^ t
    rcases lt_or_eq_of_le hc.2 with hc_lt | rfl
    · have h_prod_lt : c * (2 : ℝ) ^ m < ((2 ^ m : ℤ) : ℝ) := by
        calc c * (2 : ℝ) ^ m < 1 * (2 : ℝ) ^ m := mul_lt_mul_of_pos_right hc_lt h2m_pos
          _ = ((2 ^ m : ℤ) : ℝ) := by push_cast; ring
      have h_fl_lt_real : (⌊c * (2 : ℝ) ^ m⌋ : ℝ) < ((2 ^ m : ℤ) : ℝ) :=
        lt_of_le_of_lt (Int.floor_le _) h_prod_lt
      have h_fl_lt : ⌊c * (2 : ℝ) ^ m⌋ < (2 ^ m : ℤ) := by exact_mod_cast h_fl_lt_real
      have h_min : min ⌊c * (2 : ℝ) ^ m⌋ ((2 ^ m : ℤ) - 1) = ⌊c * (2 : ℝ) ^ m⌋ :=
        min_eq_left (by omega)
      rw [h_min]
      have h_fl_le : (⌊c * (2 : ℝ) ^ m⌋ : ℝ) ≤ c * (2 : ℝ) ^ m := Int.floor_le _
      have h_lt_fl1 : c * (2 : ℝ) ^ m < (⌊c * (2 : ℝ) ^ m⌋ : ℝ) + 1 := Int.lt_floor_add_one _
      have h_factor : (((⌊c * (2 : ℝ) ^ m⌋ : ℝ) + 1 / 2) * ((2 : ℝ) ^ m)⁻¹ - c) =
          (((⌊c * (2 : ℝ) ^ m⌋ : ℝ) + 1 / 2) - c * (2 : ℝ) ^ m) * ((2 : ℝ) ^ m)⁻¹ := by
        field_simp [h2m_ne]
      rw [h_factor, abs_mul, abs_of_pos h2m_inv_pos]
      have h_abs_half : |((⌊c * (2 : ℝ) ^ m⌋ : ℝ) + 1 / 2) - c * (2 : ℝ) ^ m| ≤ 1 / 2 :=
        abs_le.mpr ⟨by linarith, by linarith⟩
      calc |((⌊c * (2 : ℝ) ^ m⌋ : ℝ) + 1 / 2) - c * (2 : ℝ) ^ m| * ((2 : ℝ) ^ m)⁻¹
          ≤ (1 / 2 : ℝ) * ((2 : ℝ) ^ m)⁻¹ :=
            mul_le_mul_of_nonneg_right h_abs_half h2m_inv_pos.le
        _ ≤ (1 / 2 : ℝ) * ε ^ t :=
            mul_le_mul_of_nonneg_left h2m_inv_le (by norm_num)
    · have h_one_mul : (1 : ℝ) * (2 : ℝ) ^ m = ((2 ^ m : ℤ) : ℝ) := by push_cast; ring
      rw [h_one_mul, Int.floor_intCast, min_eq_right (by omega)]
      have h_simp : ((((2 ^ m : ℤ) - 1 : ℤ) : ℝ) + 1 / 2) * ((2 : ℝ) ^ m)⁻¹ - 1 =
          -((1 / 2 : ℝ) * ((2 : ℝ) ^ m)⁻¹) := by
        push_cast
        field_simp [h2m_ne]
        ring
      rw [h_simp, abs_neg, abs_of_pos (mul_pos (by norm_num) h2m_inv_pos)]
      exact mul_le_mul_of_nonneg_left h2m_inv_le (by norm_num)

  let m_t : ℕ := dyadicTimeLevel ε t
  let R_nat : ℕ := ⌈B_cl⌉₊
  let R_int : ℤ := (R_nat : ℤ)
  let z₀_time : ℤ → ℝ := fun k_d =>
    (((k_d : ℝ) + 1 / 2) * ((2 : ℝ) ^ m_t)⁻¹) / Δ_time - 1 / 2
  let S_time : ℤ → Finset ℤ := fun k_d =>
    Finset.Icc (⌊z₀_time k_d⌋ - R_int) (⌊z₀_time k_d⌋ + R_int)
  have hS_time_card : ∀ k_d : ℤ, (S_time k_d).card ≤ 2 * ⌈B_cl⌉₊ + 2 := by
    intro k_d
    dsimp only [S_time, R_int, R_nat]
    rw [Int.card_Icc]
    omega
  have hS_time_mem : ∀ k_tm : ℤ,
      let c_mid := ((k_tm : ℝ) + 1 / 2) * Δ_time
      c_mid ∈ Set.Icc (0 : ℝ) 1 →
      k_tm ∈ S_time (dyadicTimeBin ε t c_mid) := by
    intro k_tm c_mid hc_mid
    let k_d := dyadicTimeBin ε t c_mid
    have h_diff_eq : (k_tm : ℝ) - z₀_time k_d =
        (c_mid - dyadicTimeMid ε t c_mid) / Δ_time := by
      dsimp only [z₀_time, k_d, m_t, dyadicTimeMid, c_mid]
      field_simp [hΔ_ne]
      ring
    have h_abs_le : |(k_tm : ℝ) - z₀_time k_d| ≤ (R_int : ℝ) := by
      rw [h_diff_eq, abs_div, abs_of_pos hΔ_pos, abs_sub_comm]
      have h1 : |dyadicTimeMid ε t c_mid - c_mid| / Δ_time ≤
          ((1 / 2 : ℝ) * (B_cl * Δ_time)) / Δ_time := by
        refine div_le_div_of_nonneg_right ?_ hΔ_pos.le
        exact le_trans (h_mid_approx c_mid hc_mid)
          (mul_le_mul_of_nonneg_left hεt_le_BΔ (by norm_num))
      have h2 : ((1 / 2 : ℝ) * (B_cl * Δ_time)) / Δ_time = (1 / 2 : ℝ) * B_cl := by
        field_simp [hΔ_ne]
      have h3 : B_cl ≤ (R_nat : ℝ) := Nat.le_ceil B_cl
      have h4 : (R_nat : ℝ) = (R_int : ℝ) := by dsimp only [R_int]; push_cast; rfl
      linarith
    have h_abs_bounds := abs_le.mp h_abs_le
    have h_fl_le : (⌊z₀_time k_d⌋ : ℝ) ≤ z₀_time k_d := Int.floor_le _
    have h_lt_fl1 : z₀_time k_d < (⌊z₀_time k_d⌋ : ℝ) + 1 := Int.lt_floor_add_one _
    have h_lo_real : ((⌊z₀_time k_d⌋ - R_int : ℤ) : ℝ) ≤ (k_tm : ℝ) := by
      push_cast
      linarith
    have h_hi_real : (k_tm : ℝ) < ((⌊z₀_time k_d⌋ + R_int + 1 : ℤ) : ℝ) := by
      push_cast
      linarith
    have h_lo : ⌊z₀_time k_d⌋ - R_int ≤ k_tm := by exact_mod_cast h_lo_real
    have h_hi_lt : k_tm < ⌊z₀_time k_d⌋ + R_int + 1 := by exact_mod_cast h_hi_real
    dsimp only [S_time, k_d] at h_lo h_hi_lt ⊢
    exact Finset.mem_Icc.mpr ⟨h_lo, by omega⟩

  
  have h_inner2D : ∀ x y : EuclideanSpace ℝ (Fin 2),
      inner ℝ x y = x 0 * y 0 + x 1 * y 1 := by
    intro x y
    rw [PiLp.inner_apply, Fin.sum_univ_two]
    simp [mul_comm]

  have h_inner_perp_neg : ∀ w v : EuclideanSpace ℝ (Fin 2),
      inner ℝ w (perp2D (-v)) = -inner ℝ w (perp2D v) := by
    intro w v
    rw [h_inner2D, h_inner2D]
    simp [perp2D]
    ring

  let u_pos : EuclideanSpace ℝ (Fin 2) → EuclideanSpace ℝ (Fin 2) := fun e =>
    if 0 < e 1 ∨ (e 1 = 0 ∧ 0 ≤ e 0) then e else -e
  let θ_of : EuclideanSpace ℝ (Fin 2) → ℝ := fun e =>
    Real.arccos ((u_pos e) 0)

  have hθ_props : ∀ e : EuclideanSpace ℝ (Fin 2), ‖e‖ = 1 →
      θ_of e ∈ Set.Ico (0 : ℝ) Real.pi ∧
      Real.cos (θ_of e) = (u_pos e) 0 ∧
      Real.sin (θ_of e) = (u_pos e) 1 := by
    intro e he
    have he_sq : (e 0) ^ 2 + (e 1) ^ 2 = 1 := by
      have h1 : ‖e‖ ^ 2 = 1 := by rw [he]; norm_num
      rw [PiLp.norm_sq_eq_of_L2, Fin.sum_univ_two] at h1
      simpa [Real.norm_eq_abs, sq_abs] using h1
    have hu_sq : ((u_pos e) 0) ^ 2 + ((u_pos e) 1) ^ 2 = 1 := by
      dsimp only [u_pos]
      split_ifs
      · exact he_sq
      · simp [he_sq]
    have hu0_abs : |(u_pos e) 0| ≤ 1 := by
      nlinarith [hu_sq, sq_nonneg ((u_pos e) 1), sq_abs ((u_pos e) 0), abs_nonneg ((u_pos e) 0)]
    obtain ⟨hu0_ge_neg1, hu0_le1⟩ := abs_le.mp hu0_abs
    have hu1_nn : 0 ≤ (u_pos e) 1 := by
      dsimp only [u_pos]
      split_ifs with h_cond
      · rcases h_cond with h_pos | ⟨h_eq0, _⟩ <;> linarith
      · have h_le0 : e 1 ≤ 0 := le_of_not_gt (fun hgt => h_cond (Or.inl hgt))
        simp
        linarith
    have hu0_gt_neg1 : -1 < (u_pos e) 0 := by
      refine lt_of_le_of_ne hu0_ge_neg1 (fun h_eq => ?_)
      have hu1_sq0 : ((u_pos e) 1) ^ 2 = 0 := by nlinarith [hu_sq, h_eq]
      have hu1_zero : (u_pos e) 1 = 0 := sq_eq_zero_iff.mp hu1_sq0
      dsimp only [u_pos] at h_eq hu1_zero
      split_ifs at h_eq hu1_zero with h_cond
      · rcases h_cond with h_pos | ⟨_, h_nn⟩ <;> linarith
      · simp at h_eq hu1_zero
        exact h_cond (Or.inr ⟨by linarith, by linarith⟩)
    refine ⟨⟨Real.arccos_nonneg _, Real.arccos_lt_pi.mpr hu0_gt_neg1⟩,
      Real.cos_arccos hu0_ge_neg1 hu0_le1, ?_⟩
    dsimp only [θ_of]
    rw [Real.sin_arccos]
    have h_diff_sq : 1 - ((u_pos e) 0) ^ 2 = ((u_pos e) 1) ^ 2 := by linarith [hu_sq]
    rw [h_diff_sq, Real.sqrt_sq hu1_nn]

  have hu_pos_inner : ∀ w e : EuclideanSpace ℝ (Fin 2),
      |inner ℝ w (u_pos e)| = |inner ℝ w e| ∧
      |inner ℝ w (perp2D (u_pos e))| = |inner ℝ w (perp2D e)| := by
    intro w e
    dsimp only [u_pos]
    split_ifs
    · exact ⟨rfl, rfl⟩
    · rw [inner_neg_right, abs_neg, h_inner_perp_neg, abs_neg]
      exact ⟨rfl, rfl⟩

  have h_rot_bound : ∀ (e w : EuclideanSpace ℝ (Fin 2)) (C b a : ℝ),
      ‖e‖ = 1 → 0 ≤ C → b ≤ a → a - b = a_star - b_star →
      |inner ℝ w e| ≤ C * ε ^ b →
      |inner ℝ w (perp2D e)| ≤ C * ε ^ a →
      let k_r := angBin ε (a_star - b_star) (θ_of e)
      let e_dir := angUnitVec ε (a_star - b_star) k_r
      |inner ℝ w e_dir| ≤ 2 * C * ε ^ b ∧
      |inner ℝ w (perp2D e_dir)| ≤ (1 + Real.pi / 2) * C * ε ^ a := by
    intro e w C b a he hC_nn hba_loc h_asp_eq hw_e hw_perp k_r e_dir
    obtain ⟨⟨hθ_nn, hθ_lt_pi⟩, h_cosθ, h_sinθ⟩ := hθ_props e he
    let e_asp := a_star - b_star
    let m_e := dyadicTimeLevel ε e_asp
    have h2m_pos : (0 : ℝ) < (2 : ℝ) ^ m_e := by positivity
    have h2m_ne : (2 : ℝ) ^ m_e ≠ 0 := ne_of_gt h2m_pos
    have h2m_inv_pos : (0 : ℝ) < ((2 : ℝ) ^ m_e)⁻¹ := inv_pos.mpr h2m_pos
    have h2m_inv_le : ((2 : ℝ) ^ m_e)⁻¹ ≤ ε ^ e_asp := h_dyad_lvl_inv e_asp
    have hpi_pos : 0 < Real.pi := Real.pi_pos
    have hpi_ne : Real.pi ≠ 0 := ne_of_gt hpi_pos
    have h_div_lt1 : θ_of e / Real.pi < 1 := (div_lt_one hpi_pos).mpr hθ_lt_pi
    have h_prod_lt : (θ_of e / Real.pi) * (2 : ℝ) ^ m_e < ((2 ^ m_e : ℤ) : ℝ) := by
      calc (θ_of e / Real.pi) * (2 : ℝ) ^ m_e < 1 * (2 : ℝ) ^ m_e :=
            mul_lt_mul_of_pos_right h_div_lt1 h2m_pos
        _ = ((2 ^ m_e : ℤ) : ℝ) := by push_cast; ring
    have h_fl_lt : ⌊(θ_of e / Real.pi) * (2 : ℝ) ^ m_e⌋ < (2 ^ m_e : ℤ) := by
      exact_mod_cast lt_of_le_of_lt (Int.floor_le _) h_prod_lt
    have hk_r_eq : k_r = ⌊(θ_of e / Real.pi) * (2 : ℝ) ^ m_e⌋ := by
      dsimp only [k_r, angBin, e_asp, m_e] at h_fl_lt ⊢
      exact min_eq_left (by omega)
    let φ := ((k_r : ℝ) + 1 / 2) * Real.pi * ((2 : ℝ) ^ m_e)⁻¹
    let Δφ := φ - θ_of e
    have hφ_eq : φ = θ_of e + Δφ := by dsimp only [Δφ]; ring
    have hΔφ_abs : |Δφ| ≤ (Real.pi / 2) * ε ^ e_asp := by
      have h_fl_le : (k_r : ℝ) ≤ (θ_of e / Real.pi) * (2 : ℝ) ^ m_e := by
        rw [hk_r_eq]
        exact Int.floor_le _
      have h_lt_fl1 : (θ_of e / Real.pi) * (2 : ℝ) ^ m_e < (k_r : ℝ) + 1 := by
        rw [hk_r_eq]
        exact Int.lt_floor_add_one _
      have h_fac : Δφ = (((k_r : ℝ) + 1 / 2) - (θ_of e / Real.pi) * (2 : ℝ) ^ m_e) *
          (Real.pi * ((2 : ℝ) ^ m_e)⁻¹) := by
        dsimp only [Δφ, φ]
        field_simp [hpi_ne, h2m_ne]
      have h_step_pos : 0 < Real.pi * ((2 : ℝ) ^ m_e)⁻¹ := mul_pos hpi_pos h2m_inv_pos
      rw [h_fac, abs_mul, abs_of_pos h_step_pos]
      have h_half : |((k_r : ℝ) + 1 / 2) - (θ_of e / Real.pi) * (2 : ℝ) ^ m_e| ≤ 1 / 2 :=
        abs_le.mpr ⟨by linarith, by linarith⟩
      calc |((k_r : ℝ) + 1 / 2) - (θ_of e / Real.pi) * (2 : ℝ) ^ m_e| *
              (Real.pi * ((2 : ℝ) ^ m_e)⁻¹)
          ≤ (1 / 2 : ℝ) * (Real.pi * ((2 : ℝ) ^ m_e)⁻¹) :=
            mul_le_mul_of_nonneg_right h_half h_step_pos.le
        _ = (Real.pi / 2) * ((2 : ℝ) ^ m_e)⁻¹ := by ring
        _ ≤ (Real.pi / 2) * ε ^ e_asp :=
            mul_le_mul_of_nonneg_left h2m_inv_le (by positivity)
    have h_edir0 : e_dir 0 = (u_pos e) 0 * Real.cos Δφ - (u_pos e) 1 * Real.sin Δφ := by
      dsimp only [e_dir, angUnitVec, e_asp, m_e]
      change (WithLp.toLp 2 ![Real.cos φ, Real.sin φ] : EuclideanSpace ℝ (Fin 2)) 0 = _
      simp only [Matrix.cons_val_zero]
      rw [hφ_eq, Real.cos_add, h_cosθ, h_sinθ]
    have h_edir1 : e_dir 1 = (u_pos e) 1 * Real.cos Δφ + (u_pos e) 0 * Real.sin Δφ := by
      dsimp only [e_dir, angUnitVec, e_asp, m_e]
      change (WithLp.toLp 2 ![Real.cos φ, Real.sin φ] : EuclideanSpace ℝ (Fin 2)) 1 = _
      simp only [Matrix.cons_val_one, Matrix.cons_val_zero]
      rw [hφ_eq, Real.sin_add, h_sinθ, h_cosθ]
    have h_in_tan : inner ℝ w e_dir =
        Real.cos Δφ * inner ℝ w (u_pos e) + Real.sin Δφ * inner ℝ w (perp2D (u_pos e)) := by
      rw [h_inner2D w e_dir, h_inner2D w (u_pos e), h_inner2D w (perp2D (u_pos e)),
        h_edir0, h_edir1]
      simp [perp2D]
      ring
    have h_in_nrm : inner ℝ w (perp2D e_dir) =
        Real.cos Δφ * inner ℝ w (perp2D (u_pos e)) - Real.sin Δφ * inner ℝ w (u_pos e) := by
      rw [h_inner2D w (perp2D e_dir), h_inner2D w (perp2D (u_pos e)), h_inner2D w (u_pos e)]
      simp [perp2D, h_edir0, h_edir1]
      ring
    obtain ⟨hu_e, hu_perp⟩ := hu_pos_inner w e
    have hw_ue : |inner ℝ w (u_pos e)| ≤ C * ε ^ b := hu_e.trans_le hw_e
    have hw_uperp : |inner ℝ w (perp2D (u_pos e))| ≤ C * ε ^ a := hu_perp.trans_le hw_perp
    have h_rpow_mono : ε ^ a ≤ ε ^ b :=
      Real.rpow_le_rpow_of_exponent_ge hε₀ hε_le_one hba_loc
    have h_rpow_add : ε ^ e_asp * ε ^ b = ε ^ a := by
      dsimp only [e_asp]
      rw [← h_asp_eq, ← Real.rpow_add hε₀, sub_add_cancel]
    constructor
    · rw [h_in_tan]
      calc |Real.cos Δφ * inner ℝ w (u_pos e) + Real.sin Δφ * inner ℝ w (perp2D (u_pos e))|
          ≤ |Real.cos Δφ * inner ℝ w (u_pos e)| + |Real.sin Δφ * inner ℝ w (perp2D (u_pos e))| :=
            abs_add_le _ _
        _ = |Real.cos Δφ| * |inner ℝ w (u_pos e)| +
              |Real.sin Δφ| * |inner ℝ w (perp2D (u_pos e))| := by
            rw [abs_mul, abs_mul]
        _ ≤ 1 * (C * ε ^ b) + 1 * (C * ε ^ a) :=
            add_le_add
              (mul_le_mul (Real.abs_cos_le_one Δφ) hw_ue (abs_nonneg _) zero_le_one)
              (mul_le_mul (Real.abs_sin_le_one Δφ) hw_uperp (abs_nonneg _) zero_le_one)
        _ ≤ C * ε ^ b + C * ε ^ b := by
            linarith [mul_le_mul_of_nonneg_left h_rpow_mono hC_nn]
        _ = 2 * C * ε ^ b := by ring
    · rw [h_in_nrm]
      have h_sin_le : |Real.sin Δφ| ≤ (Real.pi / 2) * ε ^ e_asp :=
        le_trans Real.abs_sin_le_abs hΔφ_abs
      calc |Real.cos Δφ * inner ℝ w (perp2D (u_pos e)) - Real.sin Δφ * inner ℝ w (u_pos e)|
          ≤ |Real.cos Δφ * inner ℝ w (perp2D (u_pos e))| +
              |Real.sin Δφ * inner ℝ w (u_pos e)| :=
            abs_sub _ _
        _ = |Real.cos Δφ| * |inner ℝ w (perp2D (u_pos e))| +
              |Real.sin Δφ| * |inner ℝ w (u_pos e)| := by
            rw [abs_mul, abs_mul]
        _ ≤ 1 * (C * ε ^ a) + ((Real.pi / 2) * ε ^ e_asp) * (C * ε ^ b) :=
            add_le_add
              (mul_le_mul (Real.abs_cos_le_one Δφ) hw_uperp (abs_nonneg _) zero_le_one)
              (mul_le_mul h_sin_le hw_ue (abs_nonneg _) (by positivity))
        _ = C * ε ^ a + (Real.pi / 2) * C * (ε ^ e_asp * ε ^ b) := by ring
        _ = (1 + Real.pi / 2) * C * ε ^ a := by rw [h_rpow_add]; ring

  let I_bin : ℝ → ℝ → ℤ → Finset ℤ := fun L x₀ K =>
    Finset.Icc (dyadicRealBin ε L x₀ - K) (dyadicRealBin ε L x₀ + K)
  have h_I_bin_card : ∀ (L x₀ : ℝ) (K : ℕ), (I_bin L x₀ (K : ℤ)).card = 2 * K + 1 := by
    intro L x₀ K
    dsimp only [I_bin]
    rw [Int.card_Icc]
    omega

  have h_real_bin_mem : ∀ (L x x₀ : ℝ) (K : ℕ),
      |x - x₀| ≤ (K : ℝ) * ε ^ L →
      dyadicRealBin ε L x ∈ I_bin L x₀ (K : ℤ) := by
    intro L x x₀ K h_dist
    let m_L : ℤ := dyadicRealLevel ε L
    have h2m_pos : (0 : ℝ) < (2 : ℝ) ^ m_L := zpow_pos (by norm_num) m_L
    have h2m_le : (2 : ℝ) ^ m_L ≤ ε ^ (-L) := by
      have h_fl : (m_L : ℝ) ≤ L * (Real.log (ε⁻¹) / Real.log 2) := Int.floor_le _
      have hlog2_pos : 0 < Real.log 2 := Real.log_pos (by norm_num)
      have hlog2_ne : Real.log 2 ≠ 0 := ne_of_gt hlog2_pos
      calc (2 : ℝ) ^ m_L = (2 : ℝ) ^ (m_L : ℝ) := (Real.rpow_intCast (2 : ℝ) m_L).symm
        _ ≤ (2 : ℝ) ^ (L * (Real.log (ε⁻¹) / Real.log 2)) :=
            Real.rpow_le_rpow_of_exponent_le (by norm_num) h_fl
        _ = Real.exp (Real.log 2 * (L * (Real.log (ε⁻¹) / Real.log 2))) :=
            Real.rpow_def_of_pos (by norm_num) _
        _ = Real.exp (Real.log ε * (-L)) := by
            congr 1
            rw [Real.log_inv]
            field_simp [hlog2_ne]
        _ = ε ^ (-L) := (Real.rpow_def_of_pos hε₀ (-L)).symm
    have h_scaled : |x * (2 : ℝ) ^ m_L - x₀ * (2 : ℝ) ^ m_L| ≤ (K : ℝ) := by
      calc |x * (2 : ℝ) ^ m_L - x₀ * (2 : ℝ) ^ m_L|
          = |x - x₀| * (2 : ℝ) ^ m_L := by
            rw [← sub_mul, abs_mul, abs_of_pos h2m_pos]
        _ ≤ ((K : ℝ) * ε ^ L) * ε ^ (-L) :=
            mul_le_mul h_dist h2m_le h2m_pos.le
              (mul_nonneg (Nat.cast_nonneg K) (Real.rpow_nonneg hε₀.le L))
        _ = (K : ℝ) * (ε ^ L * ε ^ (-L)) := by ring
        _ = (K : ℝ) := by rw [← Real.rpow_add hε₀, add_neg_cancel, Real.rpow_zero, mul_one]
    have h_bds := abs_le.mp h_scaled
    dsimp only [I_bin, dyadicRealBin]
    change ⌊x * (2 : ℝ) ^ m_L⌋ ∈
      Finset.Icc (⌊x₀ * (2 : ℝ) ^ m_L⌋ - (K : ℤ)) (⌊x₀ * (2 : ℝ) ^ m_L⌋ + (K : ℤ))
    have h_fl0_le : (⌊x₀ * (2 : ℝ) ^ m_L⌋ : ℝ) ≤ x₀ * (2 : ℝ) ^ m_L := Int.floor_le _
    have h_lt_fl01 : x₀ * (2 : ℝ) ^ m_L < (⌊x₀ * (2 : ℝ) ^ m_L⌋ : ℝ) + 1 := Int.lt_floor_add_one _
    have h_flx_le : (⌊x * (2 : ℝ) ^ m_L⌋ : ℝ) ≤ x * (2 : ℝ) ^ m_L := Int.floor_le _
    have h_lo : ⌊x₀ * (2 : ℝ) ^ m_L⌋ - (K : ℤ) ≤ ⌊x * (2 : ℝ) ^ m_L⌋ := by
      refine Int.le_floor.mpr ?_
      push_cast
      linarith
    have h_hi_real : (⌊x * (2 : ℝ) ^ m_L⌋ : ℝ) <
        ((⌊x₀ * (2 : ℝ) ^ m_L⌋ + (K : ℤ) + 1 : ℤ) : ℝ) := by
      push_cast
      linarith
    have h_hi_lt : ⌊x * (2 : ℝ) ^ m_L⌋ < ⌊x₀ * (2 : ℝ) ^ m_L⌋ + (K : ℤ) + 1 := by
      exact_mod_cast h_hi_real
    exact Finset.mem_Icc.mpr ⟨h_lo, by omega⟩

  let S_obs : ℝ → EuclideanSpace ℝ (Fin 2) → EuclideanSpace ℝ (Fin 2) →
      EuclideanSpace ℝ (Fin 2) → Finset (ℤ × ℤ × ℤ × ℤ × ℤ × ℤ) :=
    fun c_g e v_g x_g =>
      let k_t := dyadicTimeBin ε t c_g
      let c_m := dyadicTimeMid ε t c_g
      let k_r := angBin ε (a_star - b_star) (θ_of e)
      let e_dir := angUnitVec ε (a_star - b_star) k_r
      let x''_g := x_g + (c_m - c_g) • v_g
      ({k_t} : Finset ℤ) ×ˢ
        (({k_r} : Finset ℤ) ×ˢ
          (I_bin b_star (inner ℝ v_g e_dir) ((3 : ℕ) : ℤ) ×ˢ
            (I_bin a_star (inner ℝ v_g (perp2D e_dir)) ((3 : ℕ) : ℤ) ×ˢ
              (I_bin (b_star + t) (inner ℝ x''_g e_dir) ((4 : ℕ) : ℤ) ×ˢ
                I_bin (a_star + t) (inner ℝ x''_g (perp2D e_dir)) ((4 : ℕ) : ℤ)))))

  have hS_obs_card : ∀ (c_g : ℝ) (e v_g x_g : EuclideanSpace ℝ (Fin 2)),
      (S_obs c_g e v_g x_g).card ≤ 4096 := by
    intro c_g e v_g x_g
    dsimp only [S_obs]
    rw [Finset.card_product, Finset.card_product, Finset.card_product,
      Finset.card_product, Finset.card_product, Finset.card_singleton, Finset.card_singleton,
      h_I_bin_card _ _ 3, h_I_bin_card _ _ 3, h_I_bin_card _ _ 4, h_I_bin_card _ _ 4]
    norm_num

  have hS_obs_mem : ∀ (c_g : ℝ) (e v_g x_g V_p A_p : EuclideanSpace ℝ (Fin 2)),
      |dyadicTimeMid ε t c_g - c_g| ≤ (1 / 2 : ℝ) * ε ^ t →
      ‖e‖ = 1 →
      |inner ℝ (V_p - v_g) e| ≤ ε ^ b_star →
      |inner ℝ (V_p - v_g) (perp2D e)| ≤ ε ^ a_star →
      |inner ℝ ((A_p + c_g • V_p) - x_g) e| ≤ ε ^ (b_star + t) →
      |inner ℝ ((A_p + c_g • V_p) - x_g) (perp2D e)| ≤ ε ^ (a_star + t) →
      stdApertureObs ε t b_star a_star V_p A_p c_g (θ_of e) ∈ S_obs c_g e v_g x_g := by
    intro c_g e v_g x_g V_p A_p hc_mid he hV_e hV_p hX_e hX_p
    let c_m := dyadicTimeMid ε t c_g
    let k_r := angBin ε (a_star - b_star) (θ_of e)
    let e_dir := angUnitVec ε (a_star - b_star) k_r
    let x''_g := x_g + (c_m - c_g) • v_g
    have hpi_lt : Real.pi < 3.15 := Real.pi_lt_d2
    obtain ⟨hV_tan, hV_nrm⟩ := h_rot_bound e (V_p - v_g) 1 b_star a_star
      he zero_le_one hba rfl (by simpa using hV_e) (by simpa using hV_p)
    have h_drift_vec : (A_p + c_m • V_p) - x''_g =
        ((A_p + c_g • V_p) - x_g) + (c_m - c_g) • (V_p - v_g) := by
      dsimp only [x''_g]
      have hs1 : c_m • V_p - c_g • V_p = (c_m - c_g) • V_p := (sub_smul c_m c_g V_p).symm
      rw [smul_sub, ← hs1]
      abel
    have hX_shift_e : |inner ℝ ((A_p + c_m • V_p) - x''_g) e| ≤
        (3 / 2 : ℝ) * ε ^ (b_star + t) := by
      rw [h_drift_vec, inner_add_left, real_inner_smul_left]
      calc |inner ℝ ((A_p + c_g • V_p) - x_g) e + (c_m - c_g) * inner ℝ (V_p - v_g) e|
          ≤ |inner ℝ ((A_p + c_g • V_p) - x_g) e| +
              |(c_m - c_g) * inner ℝ (V_p - v_g) e| := abs_add_le _ _
        _ = |inner ℝ ((A_p + c_g • V_p) - x_g) e| +
              |c_m - c_g| * |inner ℝ (V_p - v_g) e| := by rw [abs_mul]
        _ ≤ ε ^ (b_star + t) + ((1 / 2 : ℝ) * ε ^ t) * ε ^ b_star :=
            add_le_add hX_e (mul_le_mul hc_mid hV_e (abs_nonneg _) (by positivity))
        _ = ε ^ (b_star + t) + (1 / 2 : ℝ) * (ε ^ t * ε ^ b_star) := by ring
        _ = (3 / 2 : ℝ) * ε ^ (b_star + t) := by
            rw [← Real.rpow_add hε₀, add_comm t b_star]
            ring
    have hX_shift_p : |inner ℝ ((A_p + c_m • V_p) - x''_g) (perp2D e)| ≤
        (3 / 2 : ℝ) * ε ^ (a_star + t) := by
      rw [h_drift_vec, inner_add_left, real_inner_smul_left]
      calc |inner ℝ ((A_p + c_g • V_p) - x_g) (perp2D e) +
              (c_m - c_g) * inner ℝ (V_p - v_g) (perp2D e)|
          ≤ |inner ℝ ((A_p + c_g • V_p) - x_g) (perp2D e)| +
              |(c_m - c_g) * inner ℝ (V_p - v_g) (perp2D e)| := abs_add_le _ _
        _ = |inner ℝ ((A_p + c_g • V_p) - x_g) (perp2D e)| +
              |c_m - c_g| * |inner ℝ (V_p - v_g) (perp2D e)| := by rw [abs_mul]
        _ ≤ ε ^ (a_star + t) + ((1 / 2 : ℝ) * ε ^ t) * ε ^ a_star :=
            add_le_add hX_p (mul_le_mul hc_mid hV_p (abs_nonneg _) (by positivity))
        _ = ε ^ (a_star + t) + (1 / 2 : ℝ) * (ε ^ t * ε ^ a_star) := by ring
        _ = (3 / 2 : ℝ) * ε ^ (a_star + t) := by
            rw [← Real.rpow_add hε₀, add_comm t a_star]
            ring
    obtain ⟨hX_tan, hX_nrm⟩ := h_rot_bound e ((A_p + c_m • V_p) - x''_g) (3 / 2)
      (b_star + t) (a_star + t) he (by norm_num) (by linarith) (by ring) hX_shift_e hX_shift_p
    have h1 : |inner ℝ V_p e_dir - inner ℝ v_g e_dir| ≤ ((3 : ℕ) : ℝ) * ε ^ b_star := by
      rw [← inner_sub_left]
      exact le_trans hV_tan (mul_le_mul_of_nonneg_right (by norm_num) (Real.rpow_nonneg hε₀.le _))
    have h2 : |inner ℝ V_p (perp2D e_dir) - inner ℝ v_g (perp2D e_dir)| ≤
        ((3 : ℕ) : ℝ) * ε ^ a_star := by
      rw [← inner_sub_left]
      refine le_trans hV_nrm (mul_le_mul_of_nonneg_right ?_ (Real.rpow_nonneg hε₀.le _))
      push_cast
      linarith
    have h3 : |inner ℝ (A_p + c_m • V_p) e_dir - inner ℝ x''_g e_dir| ≤
        ((4 : ℕ) : ℝ) * ε ^ (b_star + t) := by
      rw [← inner_sub_left]
      exact le_trans hX_tan (mul_le_mul_of_nonneg_right (by norm_num) (Real.rpow_nonneg hε₀.le _))
    have h4 : |inner ℝ (A_p + c_m • V_p) (perp2D e_dir) - inner ℝ x''_g (perp2D e_dir)| ≤
        ((4 : ℕ) : ℝ) * ε ^ (a_star + t) := by
      rw [← inner_sub_left]
      refine le_trans hX_nrm (mul_le_mul_of_nonneg_right ?_ (Real.rpow_nonneg hε₀.le _))
      push_cast
      linarith
    dsimp only [stdApertureObs, S_obs]
    simp only [Finset.mem_product, Finset.mem_singleton]
    exact ⟨trivial, trivial,
      h_real_bin_mem b_star _ _ 3 h1,
      h_real_bin_mem a_star _ _ 3 h2,
      h_real_bin_mem (b_star + t) _ _ 4 h3,
      h_real_bin_mem (a_star + t) _ _ 4 h4⟩

  
  let c_s : Fin N_ω → ℝ := fun ω =>
    if 0 < π ω then ((k_time ω : ℝ) + 1 / 2) * Δ_time else 0
  let θ_s : Fin N_ω → ℝ := fun ω =>
    if 0 < π ω then θ_of (e_G (G_idx ω)) else 0
  let S_G : Fin N_G → Finset (ℤ × ℤ × ℤ × ℤ × ℤ × ℤ) := fun g =>
    S_obs (((k_G g : ℝ) + 1 / 2) * Δ_time) (e_G g) (V_G1 g) (X_G1 g)

  have h_law : IsUnitBallStdLaw π V₁ A₁ c_s θ_s := by
    refine ⟨hπ_nn, hπ_sum, hVA₁, fun ω hω => ?_⟩
    dsimp only [c_s, θ_s]
    simp only [hω, ↓reduceIte]
    exact ⟨(h_supp ω hω).1, (hθ_props (e_G (G_idx ω)) (he_G (G_idx ω))).1⟩

  let G_obs : Fin N_ω → ℤ × ℤ × ℤ × ℤ × ℤ × ℤ := fun ω =>
    stdApertureObs ε t b_star a_star (V₁ (T_idx ω)) (A₁ (T_idx ω)) (c_s ω) (θ_s ω)
  let k_dyad : Fin N_ω → ℤ := fun ω => dyadicTimeBin ε t (c_s ω)

  have h_Gobs_mem : ∀ ω : Fin N_ω, 0 < π ω → G_obs ω ∈ S_G (G_idx ω) := by
    intro ω hω
    obtain ⟨hc_mem, hk_eq, hV1, hV2, hX1, hX2⟩ := h_supp ω hω
    have hcs_eq : c_s ω = (((k_G (G_idx ω) : ℝ) + 1 / 2) * Δ_time) := by
      dsimp only [c_s]
      simp only [hω, ↓reduceIte, hk_eq]
    have hθs_eq : θ_s ω = θ_of (e_G (G_idx ω)) := by
      dsimp only [θ_s]
      simp only [hω, ↓reduceIte]
    have hc_g_mem : (((k_G (G_idx ω) : ℝ) + 1 / 2) * Δ_time) ∈ Set.Icc (0 : ℝ) 1 := by
      rwa [hk_eq]
    dsimp only [G_obs, S_G]
    rw [hcs_eq, hθs_eq]
    refine hS_obs_mem (((k_G (G_idx ω) : ℝ) + 1 / 2) * Δ_time)
      (e_G (G_idx ω)) (V_G1 (G_idx ω)) (X_G1 (G_idx ω))
      (V₁ (T_idx ω)) (A₁ (T_idx ω))
      (h_mid_approx _ hc_g_mem) (he_G (G_idx ω)) hV1 hV2 ?_ ?_
    · rwa [hk_eq]
    · rwa [hk_eq]

  have h_ktime_mem : ∀ ω : Fin N_ω, 0 < π ω → k_time ω ∈ S_time (k_dyad ω) := by
    intro ω hω
    have hcs_eq : c_s ω = ((k_time ω : ℝ) + 1 / 2) * Δ_time := by
      dsimp only [c_s]
      simp only [hω, ↓reduceIte]
    dsimp only [k_dyad]
    rw [hcs_eq]
    exact hS_time_mem (k_time ω) (h_supp ω hω).1

  
  let F_pos : Finset (Fin N_ω) := Finset.univ.filter (fun ω : Fin N_ω => 0 < π ω)

  have hπ_zero_of_not_mem : ∀ ω : Fin N_ω, ω ∉ F_pos → π ω = 0 := by
    intro ω hnot
    have h_not_pos : ¬ 0 < π ω := fun hp => hnot (Finset.mem_filter.mpr ⟨Finset.mem_univ ω, hp⟩)
    linarith [hπ_nn ω]

  have h_sum_Fpos_mul : ∀ f : Fin N_ω → ℝ,
      (∑ ω : Fin N_ω, π ω * f ω) = ∑ ω ∈ F_pos, π ω * f ω := by
    intro f
    exact (Finset.sum_subset (Finset.subset_univ F_pos) (fun ω _ hnot => by
      rw [hπ_zero_of_not_mem ω hnot, zero_mul])).symm

  have h_sum_Fpos : ∑ ω ∈ F_pos, π ω = 1 := by
    have h1 := h_sum_Fpos_mul (fun _ => 1)
    simpa only [mul_one, hπ_sum] using h1.symm

  have h_Fpos_filter_sum : ∀ (P : Fin N_ω → Prop) [DecidablePred P],
      (∑ ω ∈ F_pos.filter P, π ω) = ∑ ω : Fin N_ω, if P ω then π ω else 0 := by
    intro P _
    rw [← Finset.sum_filter]
    refine Finset.sum_subset (fun ω hω =>
      Finset.mem_filter.mpr ⟨Finset.mem_univ ω, (Finset.mem_filter.mp hω).2⟩) ?_
    intro ω hω_P hω_not
    have hω_not_pos : ω ∉ F_pos := fun h_in =>
      hω_not (Finset.mem_filter.mpr ⟨h_in, (Finset.mem_filter.mp hω_P).2⟩)
    exact hπ_zero_of_not_mem ω hω_not_pos

  have h_prob_pos : ∀ {α β : Type} (X : Fin N_ω → α) (Y : Fin N_ω → β) (ω : Fin N_ω),
      ω ∈ F_pos → π ω ≤ finProbAt2 π X Y ω ∧ finProbAt2 π X Y ω ≤ finProbAt π X ω := by
    intro α β X Y ω _
    constructor
    · unfold finProbAt2
      refine le_trans ?_ (Finset.single_le_sum
        (f := fun ω' : Fin N_ω =>
          @ite ℝ (X ω' = X ω ∧ Y ω' = Y ω) (Classical.propDecidable _) (π ω') 0)
        (fun ω' _ => by split_ifs; exact hπ_nn ω'; exact le_rfl)
        (Finset.mem_univ ω))
      split_ifs with h_self
      · exact le_rfl
      · exact absurd ⟨rfl, rfl⟩ h_self
    · unfold finProbAt2 finProbAt
      refine Finset.sum_le_sum (fun ω' _ => ?_)
      split_ifs <;> first | exact le_rfl | exact hπ_nn ω' | tauto

  have h_cond_ent_fiber : ∀ {α β : Type} [DecidableEq α] [DecidableEq β]
      (X : Fin N_ω → α) (Y : Fin N_ω → β) (S : α → Finset β) (M : ℕ),
      1 ≤ M →
      (∀ x : α, (S x).card ≤ M) →
      (∀ ω : Fin N_ω, 0 < π ω → Y ω ∈ S (X ω)) →
      finCondEntropy ε π X Y ≤ Real.log (M : ℝ) / ell := by
    intro α β _ _ X Y S M hM1 hS_card hY_mem
    let M_r : ℝ := (M : ℝ)
    have hM_pos : 0 < M_r := by dsimp only [M_r]; exact_mod_cast (by omega : 0 < M)
    have hM_ne : M_r ≠ 0 := ne_of_gt hM_pos
    rw [le_div_iff₀ hell_pos]
    unfold finCondEntropy condSurprise
    rw [h_sum_Fpos_mul, Finset.sum_mul]
    have h_lhs_eq : (∑ ω ∈ F_pos,
        (π ω * (-(Real.log (finProbAt2 π X Y ω / finProbAt π X ω)) / ell)) * ell) =
        ∑ ω ∈ F_pos, π ω * (-Real.log (finProbAt2 π X Y ω / finProbAt π X ω)) := by
      refine Finset.sum_congr rfl (fun ω _ => ?_)
      rw [mul_assoc, div_mul_cancel₀ _ hell_ne]
    rw [h_lhs_eq]
    let u : Fin N_ω → ℝ := fun ω => finProbAt π X ω / (finProbAt2 π X Y ω * M_r)
    have h_pt : ∀ ω ∈ F_pos,
        π ω * (-Real.log (finProbAt2 π X Y ω / finProbAt π X ω) - Real.log M_r) ≤
          π ω * u ω - π ω := by
      intro ω hω
      have hω_pos : 0 < π ω := (Finset.mem_filter.mp hω).2
      obtain ⟨hp2_ge, hp2_le⟩ := h_prob_pos X Y ω hω
      have hp2_pos : 0 < finProbAt2 π X Y ω := lt_of_lt_of_le hω_pos hp2_ge
      have hp1_pos : 0 < finProbAt π X ω := lt_of_lt_of_le hp2_pos hp2_le
      have hu_pos : 0 < u ω := div_pos hp1_pos (mul_pos hp2_pos hM_pos)
      have h_log_eq : -Real.log (finProbAt2 π X Y ω / finProbAt π X ω) - Real.log M_r =
          Real.log (u ω) := by
        dsimp only [u]
        rw [Real.log_div hp2_pos.ne' hp1_pos.ne',
          Real.log_div hp1_pos.ne' (mul_pos hp2_pos hM_pos).ne',
          Real.log_mul hp2_pos.ne' hM_ne]
        ring
      rw [h_log_eq]
      have h_mul := mul_le_mul_of_nonneg_left (Real.log_le_sub_one_of_pos hu_pos) hω_pos.le
      linarith
    have h_sum_pt := Finset.sum_le_sum h_pt
    have h_split_lhs : (∑ ω ∈ F_pos,
        π ω * (-Real.log (finProbAt2 π X Y ω / finProbAt π X ω) - Real.log M_r)) =
        (∑ ω ∈ F_pos, π ω * (-Real.log (finProbAt2 π X Y ω / finProbAt π X ω))) -
          Real.log M_r := by
      calc (∑ ω ∈ F_pos,
            π ω * (-Real.log (finProbAt2 π X Y ω / finProbAt π X ω) - Real.log M_r))
          = (∑ ω ∈ F_pos, π ω * (-Real.log (finProbAt2 π X Y ω / finProbAt π X ω))) -
              ∑ ω ∈ F_pos, π ω * Real.log M_r := by
            rw [← Finset.sum_sub_distrib]
            refine Finset.sum_congr rfl (fun ω _ => by ring)
        _ = (∑ ω ∈ F_pos, π ω * (-Real.log (finProbAt2 π X Y ω / finProbAt π X ω))) -
              Real.log M_r := by
            rw [← Finset.sum_mul, h_sum_Fpos, one_mul]
    rw [h_split_lhs, Finset.sum_sub_distrib, h_sum_Fpos] at h_sum_pt
    let P_X : α → ℝ := fun x => ∑ ω' : Fin N_ω, if X ω' = x then π ω' else 0
    have hPX_nn : ∀ x : α, 0 ≤ P_X x :=
      fun _ => Finset.sum_nonneg (fun ω' _ => by split_ifs; exact hπ_nn ω'; exact le_rfl)
    let Sig : Finset (Σ _ : α, β) := (F_pos.image X).sigma S
    let g_sig : Fin N_ω → (Σ _ : α, β) := fun ω => ⟨X ω, Y ω⟩
    have h_maps_sig : ∀ ω ∈ F_pos, g_sig ω ∈ Sig := by
      intro ω hω
      exact Finset.mem_sigma.mpr
        ⟨Finset.mem_image_of_mem X hω, hY_mem ω (Finset.mem_filter.mp hω).2⟩
    have h_u_sum_le : ∑ ω ∈ F_pos, π ω * u ω ≤ 1 := by
      rw [← Finset.sum_fiberwise_of_maps_to h_maps_sig]
      have h_fib_le : ∀ xy ∈ Sig,
          (∑ ω ∈ F_pos.filter (fun ω => g_sig ω = xy), π ω * u ω) ≤ P_X xy.1 / M_r := by
        rintro ⟨x_v, y_v⟩ _
        have h_sig_iff : ∀ ω' : Fin N_ω, g_sig ω' = ⟨x_v, y_v⟩ ↔ X ω' = x_v ∧ Y ω' = y_v :=
          fun ω' => by dsimp only [g_sig]; rw [Sigma.mk.inj_iff, heq_eq_eq]
        let fib := F_pos.filter (fun ω => g_sig ω = ⟨x_v, y_v⟩)
        change ∑ ω ∈ fib, π ω * u ω ≤ P_X x_v / M_r
        by_cases h_ne : fib.Nonempty
        · obtain ⟨ω₀, hω₀⟩ := h_ne
          have hω₀_pos : ω₀ ∈ F_pos := (Finset.mem_filter.mp hω₀).1
          have hω₀_eq : X ω₀ = x_v ∧ Y ω₀ = y_v :=
            (h_sig_iff ω₀).mp (Finset.mem_filter.mp hω₀).2
          have hp2_pos : 0 < finProbAt2 π X Y ω₀ :=
            lt_of_lt_of_le (Finset.mem_filter.mp hω₀_pos).2 (h_prob_pos X Y ω₀ hω₀_pos).1
          have hu_const : ∀ ω ∈ fib, u ω = P_X x_v / (finProbAt2 π X Y ω₀ * M_r) := by
            intro ω hω_fib
            have hω_eq : X ω = x_v ∧ Y ω = y_v :=
              (h_sig_iff ω).mp (Finset.mem_filter.mp hω_fib).2
            have hp1_eq : finProbAt π X ω = P_X x_v := by
              unfold finProbAt
              dsimp only [P_X]
              refine Finset.sum_congr rfl (fun ω' _ => ?_)
              rw [hω_eq.1]
              split_ifs <;> rfl
            have hp2_eq : finProbAt2 π X Y ω = finProbAt2 π X Y ω₀ := by
              unfold finProbAt2
              refine Finset.sum_congr rfl (fun ω' _ => ?_)
              rw [hω_eq.1, hω_eq.2, hω₀_eq.1, hω₀_eq.2]
            dsimp only [u]
            rw [hp1_eq, hp2_eq]
          have h_sum_fib : ∑ ω ∈ fib, π ω = finProbAt2 π X Y ω₀ := by
            dsimp only [fib]
            rw [h_Fpos_filter_sum]
            unfold finProbAt2
            refine Finset.sum_congr rfl (fun ω' _ => ?_)
            by_cases h_eq : X ω' = x_v ∧ Y ω' = y_v
            · have hs : g_sig ω' = ⟨x_v, y_v⟩ := (h_sig_iff ω').mpr h_eq
              have hr : X ω' = X ω₀ ∧ Y ω' = Y ω₀ :=
                ⟨h_eq.1.trans hω₀_eq.1.symm, h_eq.2.trans hω₀_eq.2.symm⟩
              simp only [hs, hr.1, hr.2, and_self, ↓reduceIte]
            · have hs : ¬ g_sig ω' = ⟨x_v, y_v⟩ := fun hg => h_eq ((h_sig_iff ω').mp hg)
              have hr : ¬ (X ω' = X ω₀ ∧ Y ω' = Y ω₀) :=
                fun hh => h_eq ⟨hh.1.trans hω₀_eq.1, hh.2.trans hω₀_eq.2⟩
              simp only [hs, hr, ↓reduceIte]
          have h_eq_val : ∑ ω ∈ fib, π ω * u ω = P_X x_v / M_r := by
            calc ∑ ω ∈ fib, π ω * u ω
                = ∑ ω ∈ fib, π ω * (P_X x_v / (finProbAt2 π X Y ω₀ * M_r)) :=
                  Finset.sum_congr rfl (fun ω hω => by rw [hu_const ω hω])
              _ = (∑ ω ∈ fib, π ω) * (P_X x_v / (finProbAt2 π X Y ω₀ * M_r)) :=
                  (Finset.sum_mul _ _ _).symm
              _ = finProbAt2 π X Y ω₀ * (P_X x_v / (finProbAt2 π X Y ω₀ * M_r)) := by
                  rw [h_sum_fib]
              _ = P_X x_v / M_r := by
                  have hp2_ne : finProbAt2 π X Y ω₀ ≠ 0 := hp2_pos.ne'
                  field_simp [hp2_ne, hM_ne]
          exact h_eq_val.le
        · rw [Finset.not_nonempty_iff_eq_empty.mp h_ne, Finset.sum_empty]
          exact div_nonneg (hPX_nn x_v) hM_pos.le
      calc (∑ xy ∈ Sig, ∑ ω ∈ F_pos.filter (fun ω => g_sig ω = xy), π ω * u ω)
          ≤ ∑ xy ∈ Sig, P_X xy.1 / M_r := Finset.sum_le_sum h_fib_le
        _ = ∑ x ∈ F_pos.image X, ∑ _y ∈ S x, P_X x / M_r := by
            dsimp only [Sig]
            rw [Finset.sum_sigma]
        _ = ∑ x ∈ F_pos.image X, ((S x).card : ℝ) * (P_X x / M_r) := by
            refine Finset.sum_congr rfl (fun x _ => ?_)
            rw [Finset.sum_const, nsmul_eq_mul]
        _ ≤ ∑ x ∈ F_pos.image X, M_r * (P_X x / M_r) := by
            refine Finset.sum_le_sum (fun x _ => ?_)
            exact mul_le_mul_of_nonneg_right (Nat.cast_le.mpr (hS_card x))
              (div_nonneg (hPX_nn x) hM_pos.le)
        _ = ∑ x ∈ F_pos.image X, P_X x := by
            refine Finset.sum_congr rfl (fun x _ => mul_div_cancel₀ _ hM_ne)
        _ = ∑ x ∈ F_pos.image X, ∑ ω ∈ F_pos.filter (fun ω => X ω = x), π ω := by
            refine Finset.sum_congr rfl (fun x _ => ?_)
            dsimp only [P_X]
            exact (h_Fpos_filter_sum (fun ω => X ω = x)).symm
        _ = ∑ ω ∈ F_pos, π ω :=
            Finset.sum_fiberwise_of_maps_to (fun ω hω => Finset.mem_image_of_mem X hω) π
        _ = 1 := h_sum_Fpos
    linarith

  
  let p_T : Fin N_T → ℝ := fun tid => ∑ ω : Fin N_ω, if T_idx ω = tid then π ω else 0
  let p_G : Fin N_G → ℝ := fun g => ∑ ω : Fin N_ω, if G_idx ω = g then π ω else 0
  let p_TG : Fin N_T → Fin N_G → ℝ := fun tid g =>
    ∑ ω : Fin N_ω, if T_idx ω = tid ∧ G_idx ω = g then π ω else 0
  let S_cells : Finset ℤ := Finset.univ.image k_time
  let p_TC : Fin N_T → ℤ → ℝ := fun tid k =>
    ∑ ω : Fin N_ω, if T_idx ω = tid ∧ k_time ω = k then π ω else 0

  have h_Ew_eq : (∑ g : Fin N_G, p_G g * ((1 + γ) * b_star + (1 - γ) * a_star)) =
      (1 + γ) * b_star + (1 - γ) * a_star := by
    rw [← Finset.sum_mul]
    have h_pG_sum : ∑ g : Fin N_G, p_G g = 1 := by
      dsimp only [p_G]
      rw [Finset.sum_comm]
      simp [hπ_sum]
    rw [h_pG_sum, one_mul]

  have h_St_eq : (∑ tid : Fin N_T, ∑ k ∈ S_cells,
      -(p_TC tid k * Real.log (p_TC tid k / p_T tid))) / ell =
      finCondEntropy ε π T_idx k_time := by
    unfold finCondEntropy condSurprise
    have h_rhs : (∑ ω : Fin N_ω,
        π ω * (-(Real.log (finProbAt2 π T_idx k_time ω / finProbAt π T_idx ω)) / Real.log (ε⁻¹))) =
        (∑ ω : Fin N_ω,
          -(π ω * Real.log (finProbAt2 π T_idx k_time ω / finProbAt π T_idx ω))) / ell := by
      dsimp only [ell]
      rw [Finset.sum_div]
      refine Finset.sum_congr rfl (fun ω _ => by ring)
    rw [h_rhs]
    congr 1
    have h_prod_st : (∑ tid : Fin N_T, ∑ k ∈ S_cells,
        -(p_TC tid k * Real.log (p_TC tid k / p_T tid))) =
        ∑ tk ∈ (Finset.univ : Finset (Fin N_T)) ×ˢ S_cells,
          -(p_TC tk.1 tk.2 * Real.log (p_TC tk.1 tk.2 / p_T tk.1)) :=
      (Finset.sum_product (Finset.univ : Finset (Fin N_T)) S_cells
        (fun tk => -(p_TC tk.1 tk.2 * Real.log (p_TC tk.1 tk.2 / p_T tk.1)))).symm
    rw [h_prod_st]
    have h_maps : ∀ ω ∈ (Finset.univ : Finset (Fin N_ω)),
        (T_idx ω, k_time ω) ∈ (Finset.univ : Finset (Fin N_T)) ×ˢ S_cells :=
      fun ω _ => Finset.mem_product.mpr
        ⟨Finset.mem_univ _, Finset.mem_image_of_mem k_time (Finset.mem_univ ω)⟩
    rw [← Finset.sum_fiberwise_of_maps_to h_maps]
    refine Finset.sum_congr rfl (fun tk _ => ?_)
    have h_inner : (∑ ω ∈ Finset.univ.filter (fun ω : Fin N_ω => (T_idx ω, k_time ω) = tk),
        -(π ω * Real.log (finProbAt2 π T_idx k_time ω / finProbAt π T_idx ω))) =
        ∑ ω ∈ Finset.univ.filter (fun ω : Fin N_ω => (T_idx ω, k_time ω) = tk),
          -(π ω * Real.log (p_TC tk.1 tk.2 / p_T tk.1)) := by
      refine Finset.sum_congr rfl (fun ω hω => ?_)
      have htk : T_idx ω = tk.1 ∧ k_time ω = tk.2 :=
        Prod.ext_iff.mp (Finset.mem_filter.mp hω).2
      have hp2 : finProbAt2 π T_idx k_time ω = p_TC tk.1 tk.2 := by
        unfold finProbAt2
        dsimp only [p_TC]
        refine Finset.sum_congr rfl (fun ω' _ => by split_ifs <;> simp_all)
      have hp1 : finProbAt π T_idx ω = p_T tk.1 := by
        unfold finProbAt
        dsimp only [p_T]
        refine Finset.sum_congr rfl (fun ω' _ => by split_ifs <;> simp_all)
      rw [hp2, hp1]
    rw [h_inner, Finset.sum_neg_distrib, ← Finset.sum_mul]
    have h_fib_sum : (∑ ω ∈ Finset.univ.filter (fun ω : Fin N_ω => (T_idx ω, k_time ω) = tk),
        π ω) = p_TC tk.1 tk.2 := by
      rw [Finset.sum_filter]
      dsimp only [p_TC]
      refine Finset.sum_congr rfl (fun ω _ => by split_ifs <;> simp_all [Prod.ext_iff])
    rw [h_fib_sum]

  have h_time_ent_step : finCondEntropy ε π T_idx k_time - finCondEntropy ε π T_idx k_dyad ≤
      finCondEntropy ε π (fun ω => (T_idx ω, k_dyad ω)) k_time := by
    let TK_d : Fin N_ω → Fin N_T × ℤ := fun ω => (T_idx ω, k_dyad ω)
    unfold finCondEntropy condSurprise
    rw [h_sum_Fpos_mul, h_sum_Fpos_mul, h_sum_Fpos_mul, ← Finset.sum_sub_distrib]
    refine Finset.sum_le_sum (fun ω hω => ?_)
    have hω_pos : 0 < π ω := (Finset.mem_filter.mp hω).2
    have hpT_pos : 0 < finProbAt π T_idx ω :=
      lt_of_lt_of_le hω_pos (le_trans (h_prob_pos T_idx k_time ω hω).1
        (h_prob_pos T_idx k_time ω hω).2)
    have hpTC_pos : 0 < finProbAt2 π T_idx k_time ω :=
      lt_of_lt_of_le hω_pos (h_prob_pos T_idx k_time ω hω).1
    have hpTD_pos : 0 < finProbAt2 π T_idx k_dyad ω :=
      lt_of_lt_of_le hω_pos (h_prob_pos T_idx k_dyad ω hω).1
    have hpTKD_pos : 0 < finProbAt2 π TK_d k_time ω :=
      lt_of_lt_of_le hω_pos (h_prob_pos TK_d k_time ω hω).1
    have hpTK_eq : finProbAt π TK_d ω = finProbAt2 π T_idx k_dyad ω := by
      unfold finProbAt finProbAt2
      refine Finset.sum_congr rfl (fun ω' _ => by split_ifs <;> simp_all [TK_d])
    have hp3_le_p2 : finProbAt2 π TK_d k_time ω ≤ finProbAt2 π T_idx k_time ω := by
      unfold finProbAt2
      refine Finset.sum_le_sum (fun ω' _ => ?_)
      split_ifs <;> first | exact le_rfl | exact hπ_nn ω' | simp_all [TK_d]
    have h_log_le : -(Real.log (finProbAt2 π T_idx k_time ω / finProbAt π T_idx ω)) -
        (-(Real.log (finProbAt2 π T_idx k_dyad ω / finProbAt π T_idx ω))) ≤
        -(Real.log (finProbAt2 π TK_d k_time ω / finProbAt π TK_d ω)) := by
      rw [hpTK_eq,
        Real.log_div hpTC_pos.ne' hpT_pos.ne',
        Real.log_div hpTD_pos.ne' hpT_pos.ne',
        Real.log_div hpTKD_pos.ne' hpTD_pos.ne']
      linarith [Real.log_le_log hpTKD_pos hp3_le_p2]
    have h_div_le := div_le_div_of_nonneg_right h_log_le hell_pos.le
    have h_mul := mul_le_mul_of_nonneg_left h_div_le hω_pos.le
    dsimp only [ell, TK_d] at h_mul
    have h_alg :
        π ω * ((-(Real.log (finProbAt2 π T_idx k_time ω / finProbAt π T_idx ω)) -
          (-(Real.log (finProbAt2 π T_idx k_dyad ω / finProbAt π T_idx ω)))) / Real.log (ε⁻¹)) =
        π ω * (-(Real.log (finProbAt2 π T_idx k_time ω / finProbAt π T_idx ω)) / Real.log (ε⁻¹)) -
        π ω * (-(Real.log (finProbAt2 π T_idx k_dyad ω / finProbAt π T_idx ω)) / Real.log (ε⁻¹)) :=
      by ring
    linarith [h_mul, h_alg]

  
  let I_TG : ℝ := (∑ tid : Fin N_T, ∑ g : Fin N_G,
    p_TG tid g * Real.log (p_TG tid g / (p_T tid * p_G g))) / ell

  have h_ITG_mul : I_TG * ell = ∑ ω ∈ F_pos,
      π ω * Real.log (finProbAt2 π T_idx G_idx ω /
        (finProbAt π T_idx ω * finProbAt π G_idx ω)) := by
    dsimp only [I_TG]
    rw [div_mul_cancel₀ _ hell_ne]
    have h_prod_tg : (∑ tid : Fin N_T, ∑ g : Fin N_G,
        p_TG tid g * Real.log (p_TG tid g / (p_T tid * p_G g))) =
        ∑ tg ∈ (Finset.univ : Finset (Fin N_T)) ×ˢ (Finset.univ : Finset (Fin N_G)),
          p_TG tg.1 tg.2 * Real.log (p_TG tg.1 tg.2 / (p_T tg.1 * p_G tg.2)) :=
      (Finset.sum_product (Finset.univ : Finset (Fin N_T)) (Finset.univ : Finset (Fin N_G))
        (fun tg => p_TG tg.1 tg.2 * Real.log (p_TG tg.1 tg.2 / (p_T tg.1 * p_G tg.2)))).symm
    rw [h_prod_tg]
    have h_maps : ∀ ω ∈ F_pos,
        (T_idx ω, G_idx ω) ∈ (Finset.univ : Finset (Fin N_T)) ×ˢ (Finset.univ : Finset (Fin N_G)) :=
      fun _ _ => Finset.mem_product.mpr ⟨Finset.mem_univ _, Finset.mem_univ _⟩
    rw [← Finset.sum_fiberwise_of_maps_to h_maps]
    refine Finset.sum_congr rfl (fun tg _ => ?_)
    have h_inner : (∑ ω ∈ F_pos.filter (fun ω => (T_idx ω, G_idx ω) = tg),
        π ω * Real.log (finProbAt2 π T_idx G_idx ω /
          (finProbAt π T_idx ω * finProbAt π G_idx ω))) =
        ∑ ω ∈ F_pos.filter (fun ω => (T_idx ω, G_idx ω) = tg),
          π ω * Real.log (p_TG tg.1 tg.2 / (p_T tg.1 * p_G tg.2)) := by
      refine Finset.sum_congr rfl (fun ω hω => ?_)
      have htg : T_idx ω = tg.1 ∧ G_idx ω = tg.2 :=
        Prod.ext_iff.mp (Finset.mem_filter.mp hω).2
      have hpTG : finProbAt2 π T_idx G_idx ω = p_TG tg.1 tg.2 := by
        unfold finProbAt2
        dsimp only [p_TG]
        refine Finset.sum_congr rfl (fun ω' _ => by split_ifs <;> simp_all)
      have hpT : finProbAt π T_idx ω = p_T tg.1 := by
        unfold finProbAt
        dsimp only [p_T]
        refine Finset.sum_congr rfl (fun ω' _ => by split_ifs <;> simp_all)
      have hpG : finProbAt π G_idx ω = p_G tg.2 := by
        unfold finProbAt
        dsimp only [p_G]
        refine Finset.sum_congr rfl (fun ω' _ => by split_ifs <;> simp_all)
      rw [hpTG, hpT, hpG]
    rw [h_inner, ← Finset.sum_mul]
    have h_fib_sum : (∑ ω ∈ F_pos.filter (fun ω => (T_idx ω, G_idx ω) = tg), π ω) =
        p_TG tg.1 tg.2 := by
      rw [h_Fpos_filter_sum]
      dsimp only [p_TG]
      refine Finset.sum_congr rfl (fun ω _ => by split_ifs <;> simp_all [Prod.ext_iff])
    rw [h_fib_sum]

  have h_MI_obs_mul : finMutualInfo ε π T_idx G_obs * ell = ∑ ω ∈ F_pos,
      π ω * Real.log (finProbAt2 π T_idx G_obs ω /
        (finProbAt π T_idx ω * finProbAt π G_obs ω)) := by
    unfold finMutualInfo finCondEntropy condSurprise
    rw [h_sum_Fpos_mul, h_sum_Fpos_mul, sub_mul, Finset.sum_mul, Finset.sum_mul,
      ← Finset.sum_sub_distrib]
    refine Finset.sum_congr rfl (fun ω hω => ?_)
    have hω_pos : 0 < π ω := (Finset.mem_filter.mp hω).2
    have hpTB_pos : 0 < finProbAt2 π T_idx G_obs ω :=
      lt_of_lt_of_le hω_pos (h_prob_pos T_idx G_obs ω hω).1
    have hpT_pos : 0 < finProbAt π T_idx ω :=
      lt_of_lt_of_le hpTB_pos (h_prob_pos T_idx G_obs ω hω).2
    have hpB_pos : 0 < finProbAt π G_obs ω :=
      lt_of_lt_of_le hω_pos (le_trans (h_prob_pos G_obs T_idx ω hω).1
        (h_prob_pos G_obs T_idx ω hω).2)
    have hp_unit : finProbAt π (fun _ => ()) ω = 1 := by
      unfold finProbAt
      simp [hπ_sum]
    have hp2_unit : finProbAt2 π (fun _ => ()) G_obs ω = finProbAt π G_obs ω := by
      unfold finProbAt2 finProbAt
      refine Finset.sum_congr rfl (fun ω' _ => ?_)
      by_cases h_eq : G_obs ω' = G_obs ω
      · simp only [h_eq, and_self, ↓reduceIte]
      · simp only [h_eq, and_false, ↓reduceIte]
    rw [hp_unit, hp2_unit, div_one]
    have h_ell_cancel :
        (π ω * (-(Real.log (finProbAt π G_obs ω)) / Real.log (ε⁻¹))) * ell -
          (π ω * (-(Real.log (finProbAt2 π T_idx G_obs ω / finProbAt π T_idx ω)) /
            Real.log (ε⁻¹))) * ell =
        π ω * (Real.log (finProbAt2 π T_idx G_obs ω / finProbAt π T_idx ω) -
          Real.log (finProbAt π G_obs ω)) := by
      change (π ω * (-(Real.log (finProbAt π G_obs ω)) / ell)) * ell -
          (π ω * (-(Real.log (finProbAt2 π T_idx G_obs ω / finProbAt π T_idx ω)) / ell)) * ell = _
      rw [mul_assoc, div_mul_cancel₀ _ hell_ne, mul_assoc, div_mul_cancel₀ _ hell_ne]
      ring
    rw [h_ell_cancel, Real.log_div hpTB_pos.ne' hpT_pos.ne',
      Real.log_div hpTB_pos.ne' (mul_pos hpT_pos hpB_pos).ne',
      Real.log_mul hpT_pos.ne' hpB_pos.ne']
    ring

  have h_MI_step : finMutualInfo ε π T_idx G_obs - I_TG ≤ finCondEntropy ε π G_idx G_obs := by
    have h_CE_mul : finCondEntropy ε π G_idx G_obs * ell = ∑ ω ∈ F_pos,
        π ω * (-Real.log (finProbAt2 π G_idx G_obs ω / finProbAt π G_idx ω)) := by
      unfold finCondEntropy condSurprise
      rw [h_sum_Fpos_mul, Finset.sum_mul]
      refine Finset.sum_congr rfl (fun ω _ => ?_)
      change (π ω * (-(Real.log (finProbAt2 π G_idx G_obs ω / finProbAt π G_idx ω)) / ell)) * ell = _
      rw [mul_assoc, div_mul_cancel₀ _ hell_ne]
    suffices h_mul_le :
        (finMutualInfo ε π T_idx G_obs - I_TG - finCondEntropy ε π G_idx G_obs) * ell ≤ 0 by
      have h_nonpos : finMutualInfo ε π T_idx G_obs - I_TG - finCondEntropy ε π G_idx G_obs ≤ 0 :=
        by nlinarith [h_mul_le, hell_pos]
      linarith
    rw [sub_mul, sub_mul, h_MI_obs_mul, h_ITG_mul, h_CE_mul,
      ← Finset.sum_sub_distrib, ← Finset.sum_sub_distrib]
    let v : Fin N_ω → ℝ := fun ω =>
      (finProbAt2 π T_idx G_obs ω * finProbAt2 π G_idx G_obs ω) /
        (finProbAt π G_obs ω * finProbAt2 π T_idx G_idx ω)
    have h_pt : ∀ ω ∈ F_pos,
        π ω * Real.log (finProbAt2 π T_idx G_obs ω /
            (finProbAt π T_idx ω * finProbAt π G_obs ω)) -
          π ω * Real.log (finProbAt2 π T_idx G_idx ω /
            (finProbAt π T_idx ω * finProbAt π G_idx ω)) -
          π ω * (-Real.log (finProbAt2 π G_idx G_obs ω / finProbAt π G_idx ω)) ≤
        π ω * v ω - π ω := by
      intro ω hω
      have hω_pos : 0 < π ω := (Finset.mem_filter.mp hω).2
      have hpTB_pos : 0 < finProbAt2 π T_idx G_obs ω :=
        lt_of_lt_of_le hω_pos (h_prob_pos T_idx G_obs ω hω).1
      have hpT_pos : 0 < finProbAt π T_idx ω :=
        lt_of_lt_of_le hpTB_pos (h_prob_pos T_idx G_obs ω hω).2
      have hpGB_pos : 0 < finProbAt2 π G_idx G_obs ω :=
        lt_of_lt_of_le hω_pos (h_prob_pos G_idx G_obs ω hω).1
      have hpG_pos : 0 < finProbAt π G_idx ω :=
        lt_of_lt_of_le hpGB_pos (h_prob_pos G_idx G_obs ω hω).2
      have hpTG_pos : 0 < finProbAt2 π T_idx G_idx ω :=
        lt_of_lt_of_le hω_pos (h_prob_pos T_idx G_idx ω hω).1
      have hpB_pos : 0 < finProbAt π G_obs ω :=
        lt_of_lt_of_le hω_pos (le_trans (h_prob_pos G_obs T_idx ω hω).1
          (h_prob_pos G_obs T_idx ω hω).2)
      have hv_pos : 0 < v ω :=
        div_pos (mul_pos hpTB_pos hpGB_pos) (mul_pos hpB_pos hpTG_pos)
      have h_log_eq :
          Real.log (finProbAt2 π T_idx G_obs ω /
              (finProbAt π T_idx ω * finProbAt π G_obs ω)) -
            Real.log (finProbAt2 π T_idx G_idx ω /
              (finProbAt π T_idx ω * finProbAt π G_idx ω)) -
            (-Real.log (finProbAt2 π G_idx G_obs ω / finProbAt π G_idx ω)) =
          Real.log (v ω) := by
        dsimp only [v]
        rw [Real.log_div hpTB_pos.ne' (mul_pos hpT_pos hpB_pos).ne',
          Real.log_mul hpT_pos.ne' hpB_pos.ne',
          Real.log_div hpTG_pos.ne' (mul_pos hpT_pos hpG_pos).ne',
          Real.log_mul hpT_pos.ne' hpG_pos.ne',
          Real.log_div hpGB_pos.ne' hpG_pos.ne',
          Real.log_div (mul_pos hpTB_pos hpGB_pos).ne' (mul_pos hpB_pos hpTG_pos).ne',
          Real.log_mul hpTB_pos.ne' hpGB_pos.ne',
          Real.log_mul hpB_pos.ne' hpTG_pos.ne']
        ring
      have h_factor :
          π ω * Real.log (finProbAt2 π T_idx G_obs ω /
              (finProbAt π T_idx ω * finProbAt π G_obs ω)) -
            π ω * Real.log (finProbAt2 π T_idx G_idx ω /
              (finProbAt π T_idx ω * finProbAt π G_idx ω)) -
            π ω * (-Real.log (finProbAt2 π G_idx G_obs ω / finProbAt π G_idx ω)) =
          π ω * Real.log (v ω) := by
        rw [← h_log_eq]
        ring
      rw [h_factor]
      have h_mul := mul_le_mul_of_nonneg_left (Real.log_le_sub_one_of_pos hv_pos) hω_pos.le
      linarith
    have h_sum_pt := Finset.sum_le_sum h_pt
    have h_rhs_pt : (∑ ω ∈ F_pos, (π ω * v ω - π ω)) = (∑ ω ∈ F_pos, π ω * v ω) - 1 := by
      rw [Finset.sum_sub_distrib, h_sum_Fpos]
    rw [h_rhs_pt] at h_sum_pt
    let B_im : Finset (ℤ × ℤ × ℤ × ℤ × ℤ × ℤ) := F_pos.image G_obs
    let P_B : (ℤ × ℤ × ℤ × ℤ × ℤ × ℤ) → ℝ :=
      fun b => ∑ ω' : Fin N_ω, if G_obs ω' = b then π ω' else 0
    let P_TB : Fin N_T → (ℤ × ℤ × ℤ × ℤ × ℤ × ℤ) → ℝ :=
      fun tid b => ∑ ω' : Fin N_ω, if T_idx ω' = tid ∧ G_obs ω' = b then π ω' else 0
    let P_GB : Fin N_G → (ℤ × ℤ × ℤ × ℤ × ℤ × ℤ) → ℝ :=
      fun g b => ∑ ω' : Fin N_ω, if G_idx ω' = g ∧ G_obs ω' = b then π ω' else 0
    have hPB_nn : ∀ b, 0 ≤ P_B b :=
      fun _ => Finset.sum_nonneg (fun ω' _ => by split_ifs; exact hπ_nn ω'; exact le_rfl)
    have hPTB_nn : ∀ tid b, 0 ≤ P_TB tid b :=
      fun _ _ => Finset.sum_nonneg (fun ω' _ => by split_ifs; exact hπ_nn ω'; exact le_rfl)
    have hPGB_nn : ∀ g b, 0 ≤ P_GB g b :=
      fun _ _ => Finset.sum_nonneg (fun ω' _ => by split_ifs; exact hπ_nn ω'; exact le_rfl)
    have : DecidableEq ((ℤ × ℤ × ℤ × ℤ × ℤ × ℤ) × Fin N_T × Fin N_G) := Classical.decEq _
    let Triples := B_im ×ˢ ((Finset.univ : Finset (Fin N_T)) ×ˢ (Finset.univ : Finset (Fin N_G)))
    let g_tri : Fin N_ω → (ℤ × ℤ × ℤ × ℤ × ℤ × ℤ) × Fin N_T × Fin N_G :=
      fun ω => (G_obs ω, (T_idx ω, G_idx ω))
    have h_maps_tri : ∀ ω ∈ F_pos, g_tri ω ∈ Triples :=
      fun ω hω => Finset.mem_product.mpr ⟨Finset.mem_image_of_mem G_obs hω,
        Finset.mem_product.mpr ⟨Finset.mem_univ _, Finset.mem_univ _⟩⟩
    have h_v_sum_le : ∑ ω ∈ F_pos, π ω * v ω ≤ 1 := by
      rw [← Finset.sum_fiberwise_of_maps_to h_maps_tri]
      have h_fib_le : ∀ btg ∈ Triples,
          (∑ ω ∈ F_pos.filter (fun ω => g_tri ω = btg), π ω * v ω) ≤
            (P_TB btg.2.1 btg.1 * P_GB btg.2.2 btg.1) / P_B btg.1 := by
        rintro ⟨b, tid, g⟩ _
        have h_tri_iff : ∀ ω' : Fin N_ω,
            g_tri ω' = (b, (tid, g)) ↔ G_obs ω' = b ∧ T_idx ω' = tid ∧ G_idx ω' = g := by
          intro ω'
          dsimp only [g_tri]
          constructor
          · intro h
            exact ⟨congrArg Prod.fst h, congrArg (fun p => p.2.1) h, congrArg (fun p => p.2.2) h⟩
          · rintro ⟨h1, h2, h3⟩
            rw [h1, h2, h3]
        let fib := F_pos.filter (fun ω => g_tri ω = (b, (tid, g)))
        change ∑ ω ∈ fib, π ω * v ω ≤ (P_TB tid b * P_GB g b) / P_B b
        have h_rhs_nn : 0 ≤ (P_TB tid b * P_GB g b) / P_B b :=
          div_nonneg (mul_nonneg (hPTB_nn tid b) (hPGB_nn g b)) (hPB_nn b)
        by_cases h_ne : fib.Nonempty
        · obtain ⟨ω₀, hω₀⟩ := h_ne
          have hω₀_pos : ω₀ ∈ F_pos := (Finset.mem_filter.mp hω₀).1
          have hω₀_eq : G_obs ω₀ = b ∧ T_idx ω₀ = tid ∧ G_idx ω₀ = g :=
            (h_tri_iff ω₀).mp (Finset.mem_filter.mp hω₀).2
          have hv_const : ∀ ω ∈ fib,
              v ω = (P_TB tid b * P_GB g b) / (P_B b * p_TG tid g) := by
            intro ω hω_fib
            have hω_eq : G_obs ω = b ∧ T_idx ω = tid ∧ G_idx ω = g :=
              (h_tri_iff ω).mp (Finset.mem_filter.mp hω_fib).2
            have h1 : finProbAt2 π T_idx G_obs ω = P_TB tid b := by
              unfold finProbAt2; dsimp only [P_TB]
              refine Finset.sum_congr rfl (fun ω' _ => ?_)
              rw [hω_eq.2.1, hω_eq.1]
              split_ifs <;> rfl
            have h2 : finProbAt2 π G_idx G_obs ω = P_GB g b := by
              unfold finProbAt2; dsimp only [P_GB]
              refine Finset.sum_congr rfl (fun ω' _ => ?_)
              rw [hω_eq.2.2, hω_eq.1]
              split_ifs <;> rfl
            have h3 : finProbAt π G_obs ω = P_B b := by
              unfold finProbAt; dsimp only [P_B]
              refine Finset.sum_congr rfl (fun ω' _ => ?_)
              rw [hω_eq.1]
              split_ifs <;> rfl
            have h4 : finProbAt2 π T_idx G_idx ω = p_TG tid g := by
              unfold finProbAt2; dsimp only [p_TG]
              refine Finset.sum_congr rfl (fun ω' _ => ?_)
              rw [hω_eq.2.1, hω_eq.2.2]
              split_ifs <;> rfl
            dsimp only [v]
            rw [h1, h2, h3, h4]
          have hpTG_pos : 0 < p_TG tid g := by
            have hp0 : 0 < finProbAt2 π T_idx G_idx ω₀ :=
              lt_of_lt_of_le (Finset.mem_filter.mp hω₀_pos).2
                (h_prob_pos T_idx G_idx ω₀ hω₀_pos).1
            have h_eq : finProbAt2 π T_idx G_idx ω₀ = p_TG tid g := by
              unfold finProbAt2; dsimp only [p_TG]
              refine Finset.sum_congr rfl (fun ω' _ => ?_)
              rw [hω₀_eq.2.1, hω₀_eq.2.2]
              split_ifs <;> rfl
            rwa [h_eq] at hp0
          have h_fib_le_pTG : ∑ ω ∈ fib, π ω ≤ p_TG tid g := by
            dsimp only [fib]
            rw [h_Fpos_filter_sum]
            dsimp only [p_TG]
            refine Finset.sum_le_sum (fun ω' _ => ?_)
            by_cases h_tr : g_tri ω' = (b, (tid, g))
            · have h_eqs := (h_tri_iff ω').mp h_tr
              simp only [h_tr, h_eqs.2.1, h_eqs.2.2, and_self, ↓reduceIte]
              exact le_rfl
            · simp only [h_tr, ↓reduceIte]
              split_ifs
              · exact hπ_nn ω'
              · exact le_rfl
          have h_ratio_le1 : (∑ ω ∈ fib, π ω) / p_TG tid g ≤ 1 :=
            (div_le_one hpTG_pos).mpr h_fib_le_pTG
          calc ∑ ω ∈ fib, π ω * v ω
              = ∑ ω ∈ fib, π ω * ((P_TB tid b * P_GB g b) / (P_B b * p_TG tid g)) :=
                Finset.sum_congr rfl (fun ω hω => by rw [hv_const ω hω])
            _ = (∑ ω ∈ fib, π ω) * ((P_TB tid b * P_GB g b) / (P_B b * p_TG tid g)) :=
                (Finset.sum_mul _ _ _).symm
            _ = ((∑ ω ∈ fib, π ω) / p_TG tid g) * ((P_TB tid b * P_GB g b) / P_B b) := by
                ring
            _ ≤ 1 * ((P_TB tid b * P_GB g b) / P_B b) :=
                mul_le_mul_of_nonneg_right h_ratio_le1 h_rhs_nn
            _ = (P_TB tid b * P_GB g b) / P_B b := one_mul _
        · rw [Finset.not_nonempty_iff_eq_empty.mp h_ne, Finset.sum_empty]
          exact h_rhs_nn
      calc (∑ btg ∈ Triples, ∑ ω ∈ F_pos.filter (fun ω => g_tri ω = btg), π ω * v ω)
          ≤ ∑ btg ∈ Triples, (P_TB btg.2.1 btg.1 * P_GB btg.2.2 btg.1) / P_B btg.1 :=
            Finset.sum_le_sum h_fib_le
        _ = ∑ b ∈ B_im, ∑ tid : Fin N_T, ∑ g : Fin N_G, (P_TB tid b * P_GB g b) / P_B b := by
            dsimp only [Triples]
            rw [Finset.sum_product]
            refine Finset.sum_congr rfl (fun b _ => ?_)
            rw [Finset.sum_product]
        _ = ∑ b ∈ B_im, P_B b := by
            refine Finset.sum_congr rfl (fun b hb => ?_)
            obtain ⟨ω_b, hω_b_pos, rfl⟩ := Finset.mem_image.mp hb
            have hPB_pos : 0 < P_B (G_obs ω_b) := by
              have hp0 : 0 < finProbAt π G_obs ω_b :=
                lt_of_lt_of_le (Finset.mem_filter.mp hω_b_pos).2
                  (le_trans (h_prob_pos G_obs T_idx ω_b hω_b_pos).1
                    (h_prob_pos G_obs T_idx ω_b hω_b_pos).2)
              have h_eq : finProbAt π G_obs ω_b = P_B (G_obs ω_b) := by
                unfold finProbAt; dsimp only [P_B]
                refine Finset.sum_congr rfl (fun ω' _ => ?_)
                split_ifs <;> rfl
              rwa [h_eq] at hp0
            have h_sum_g : ∑ g : Fin N_G, P_GB g (G_obs ω_b) = P_B (G_obs ω_b) := by
              dsimp only [P_GB, P_B]
              rw [Finset.sum_comm]
              refine Finset.sum_congr rfl (fun ω' _ => ?_)
              by_cases hb_eq : G_obs ω' = G_obs ω_b
              · simp only [hb_eq, and_true, ↓reduceIte, Finset.sum_ite_eq, Finset.mem_univ]
              · simp only [hb_eq, and_false, ↓reduceIte, Finset.sum_const_zero]
            have h_sum_tid : ∑ tid : Fin N_T, P_TB tid (G_obs ω_b) = P_B (G_obs ω_b) := by
              dsimp only [P_TB, P_B]
              rw [Finset.sum_comm]
              refine Finset.sum_congr rfl (fun ω' _ => ?_)
              by_cases hb_eq : G_obs ω' = G_obs ω_b
              · simp only [hb_eq, and_true, ↓reduceIte, Finset.sum_ite_eq, Finset.mem_univ]
              · simp only [hb_eq, and_false, ↓reduceIte, Finset.sum_const_zero]
            have h_inner_g : ∀ tid : Fin N_T,
                (∑ g : Fin N_G, (P_TB tid (G_obs ω_b) * P_GB g (G_obs ω_b)) / P_B (G_obs ω_b)) =
                  P_TB tid (G_obs ω_b) := by
              intro tid
              calc (∑ g : Fin N_G,
                    (P_TB tid (G_obs ω_b) * P_GB g (G_obs ω_b)) / P_B (G_obs ω_b))
                  = ∑ g : Fin N_G,
                      (P_TB tid (G_obs ω_b) / P_B (G_obs ω_b)) * P_GB g (G_obs ω_b) :=
                    Finset.sum_congr rfl (fun _ _ => by ring)
                _ = (P_TB tid (G_obs ω_b) / P_B (G_obs ω_b)) *
                      ∑ g : Fin N_G, P_GB g (G_obs ω_b) :=
                    (Finset.mul_sum _ _ _).symm
                _ = P_TB tid (G_obs ω_b) := by
                    rw [h_sum_g, div_mul_cancel₀ _ hPB_pos.ne']
            calc (∑ tid : Fin N_T, ∑ g : Fin N_G,
                  (P_TB tid (G_obs ω_b) * P_GB g (G_obs ω_b)) / P_B (G_obs ω_b))
                = ∑ tid : Fin N_T, P_TB tid (G_obs ω_b) :=
                  Finset.sum_congr rfl (fun tid _ => h_inner_g tid)
              _ = P_B (G_obs ω_b) := h_sum_tid
        _ = ∑ b ∈ B_im, ∑ ω ∈ F_pos.filter (fun ω => G_obs ω = b), π ω := by
            refine Finset.sum_congr rfl (fun b _ => ?_)
            dsimp only [P_B]
            exact (h_Fpos_filter_sum (fun ω => G_obs ω = b)).symm
        _ = ∑ ω ∈ F_pos, π ω :=
            Finset.sum_fiberwise_of_maps_to (fun ω hω => Finset.mem_image_of_mem G_obs hω) π
        _ = 1 := h_sum_Fpos
    linarith

  
  have h_fib_obs : finCondEntropy ε π G_idx G_obs ≤ Real.log ((4096 : ℕ) : ℝ) / ell :=
    h_cond_ent_fiber G_idx G_obs S_G 4096 (by omega)
      (fun g => hS_obs_card _ _ _ _) h_Gobs_mem

  have h_fib_time : finCondEntropy ε π (fun ω => (T_idx ω, k_dyad ω)) k_time ≤
      Real.log ((2 * ⌈B_cl⌉₊ + 2 : ℕ) : ℝ) / ell :=
    h_cond_ent_fiber (fun ω => (T_idx ω, k_dyad ω)) k_time
      (fun tk => S_time tk.2) (2 * ⌈B_cl⌉₊ + 2) (by omega)
      (fun tk => hS_time_card tk.2) h_ktime_mem

  have h_log_4096 : Real.log ((4096 : ℕ) : ℝ) ≤ 12 := by
    have h_pow : ((4096 : ℕ) : ℝ) = (2 : ℝ) ^ (12 : ℕ) := by norm_num
    have h_log2 : Real.log 2 ≤ 1 := by
      linarith [Real.log_le_sub_one_of_pos (by norm_num : (0 : ℝ) < 2)]
    rw [h_pow, Real.log_pow]
    push_cast
    linarith

  have h_log_4096_div : Real.log ((4096 : ℕ) : ℝ) / ell ≤ 12 / ell :=
    div_le_div_of_nonneg_right h_log_4096 hell_pos.le

  refine ⟨c_s, θ_s, h_law, ?_⟩
  have h_cl_eq : classicalTransportScore ε γ N_ω N_T N_G π T_idx k_time G_idx
      (fun _ => b_star) (fun _ => a_star) =
      ((1 + γ) * b_star + (1 - γ) * a_star) - I_TG +
        2 * finCondEntropy ε π T_idx k_time := by
    unfold classicalTransportScore
    dsimp only [ell, p_T, p_G, p_TG, S_cells, p_TC, I_TG] at h_Ew_eq h_St_eq ⊢
    rw [h_Ew_eq, h_St_eq]
  have h_std_eq : stdApertureScore ε γ t b_star a_star π T_idx V₁ A₁ c_s θ_s =
      ((1 + γ) * b_star + (1 - γ) * a_star) - finMutualInfo ε π T_idx G_obs +
        2 * finCondEntropy ε π T_idx k_dyad := rfl
  rw [h_cl_eq, h_std_eq]
  have h_pen_split : (2 * Real.log ((2 * ⌈B_cl⌉₊ + 2 : ℕ) : ℝ) + 12) / Real.log (ε⁻¹) =
      2 * (Real.log ((2 * ⌈B_cl⌉₊ + 2 : ℕ) : ℝ) / ell) + 12 / ell := by
    dsimp only [ell]
    ring
  rw [h_pen_split]
  linarith [h_MI_step, h_fib_obs, h_time_ent_step, h_fib_time, h_log_4096_div]

theorem isotropic_prefix_std_localization (γ ε t b_star a_star : ℝ)
    (hγ₀ : 0 < γ) (hγ₁ : γ < 1)
    (hε₀ : 0 < ε) (hε₁ : ε < 1 / 2)
    (ht : 0 < t)
    (hb₀ : 0 ≤ b_star) (hba : b_star ≤ a_star)
    {N_ω N_T : ℕ}
    (π₁ : Fin N_ω → ℝ)
    (T_idx : Fin N_ω → Fin N_T)
    (V₁ A₁ : Fin N_T → EuclideanSpace ℝ (Fin 2))
    (c_s θ_s : Fin N_ω → ℝ)
    (h_law : IsUnitBallStdLaw π₁ V₁ A₁ c_s θ_s) :
    ∃ (π₂ : Fin N_ω → ℝ)
      (V₂ A₂ : Fin N_T → EuclideanSpace ℝ (Fin 2)),
      IsUnitBallStdLaw π₂ V₂ A₂ c_s θ_s ∧
      stdApertureScore ε γ t b_star a_star π₁ T_idx V₁ A₁ c_s θ_s -
        classicalRootSupremum ε (a_star + t) γ N_ω N_T π₁ T_idx V₁ A₁ ≤
      stdApertureScore ε γ t 0 (a_star - b_star) π₂ T_idx V₂ A₂ c_s θ_s -
        classicalRootSupremum ε ((a_star - b_star) + t) γ N_ω N_T π₂ T_idx V₂ A₂ +
        23 / Real.log (ε⁻¹) :=
by
  
  have h_s1 :
      (∀ (V_p A_p : EuclideanSpace ℝ (Fin 2)),
        let j := isoPrefixCell ε b_star V_p A_p
        let v_j := isoPrefixCenter ε b_star j.1 j.2.1
        let a_j := isoPrefixCenter ε b_star j.2.2.1 j.2.2.2
        ‖isoPrefixLocalVec ε b_star v_j V_p‖ ≤ 1 ∧
        ‖isoPrefixLocalVec ε b_star a_j A_p‖ ≤ 1) ∧
      ∃ F_amb : (ℤ × ℤ × ℤ × ℤ × ℤ × ℤ) →
          Finset ((ℤ × ℤ × ℤ × ℤ) × (ℤ × ℤ × ℤ × ℤ × ℤ × ℤ)),
        (∀ g, (F_amb g).card ≤ 99225) ∧
        ∀ (V_p A_p : EuclideanSpace ℝ (Fin 2)) (c θ : ℝ),
          c ∈ Set.Icc (0 : ℝ) 1 →
          let g := stdApertureObs ε t b_star a_star V_p A_p c θ
          let j := isoPrefixCell ε b_star V_p A_p
          let v_j := isoPrefixCenter ε b_star j.1 j.2.1
          let a_j := isoPrefixCenter ε b_star j.2.2.1 j.2.2.2
          let V' := isoPrefixLocalVec ε b_star v_j V_p
          let A' := isoPrefixLocalVec ε b_star a_j A_p
          let g_loc := stdApertureObs ε t 0 (a_star - b_star) V' A' c θ
          (j, g_loc) ∈ F_amb g := by
    have hlog2_pos : 0 < Real.log 2 := Real.log_pos (by norm_num)
    have hlog2_ne : Real.log 2 ≠ 0 := ne_of_gt hlog2_pos
    have hε_le1 : ε ≤ 1 := by linarith
    have h_dyad_step : ∀ L : ℝ,
        0 < dyadicRealStep ε L ∧
        dyadicRealStep ε L * (2 : ℝ) ^ (dyadicRealLevel ε L) = 1 ∧
        ε ^ L ≤ dyadicRealStep ε L ∧
        dyadicRealStep ε L < 2 * ε ^ L := by
      intro L
      let m_L : ℤ := dyadicRealLevel ε L
      have hδ_pos : 0 < dyadicRealStep ε L := by
        unfold dyadicRealStep
        exact zpow_pos (by norm_num : (0 : ℝ) < 2) (-m_L)
      have hδ_mul : dyadicRealStep ε L * (2 : ℝ) ^ m_L = 1 := by
        unfold dyadicRealStep
        rw [← zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0), neg_add_cancel, zpow_zero]
      let α : ℝ := L * (Real.log (ε⁻¹) / Real.log 2)
      have h_two_alpha : (2 : ℝ) ^ (-α) = ε ^ L := by
        rw [Real.rpow_def_of_pos (by norm_num : (0 : ℝ) < 2), Real.rpow_def_of_pos hε₀]
        congr 1
        dsimp only [α]
        rw [Real.log_inv]
        field_simp [hlog2_ne]
      have h_step_rpow : dyadicRealStep ε L = (2 : ℝ) ^ (-(m_L : ℝ)) := by
        unfold dyadicRealStep
        change (2 : ℝ) ^ (-m_L) = (2 : ℝ) ^ (-(m_L : ℝ))
        rw [← Real.rpow_intCast (2 : ℝ) (-m_L), Int.cast_neg]
      have hm_le : (m_L : ℝ) ≤ α := Int.floor_le α
      have hm_lt : α < (m_L : ℝ) + 1 := Int.lt_floor_add_one α
      have h_ge : ε ^ L ≤ dyadicRealStep ε L := by
        rw [← h_two_alpha, h_step_rpow]
        exact Real.rpow_le_rpow_of_exponent_le (by norm_num) (by linarith)
      have h_lt : dyadicRealStep ε L < 2 * ε ^ L := by
        have h1 : (2 : ℝ) ^ (-(m_L : ℝ)) < (2 : ℝ) ^ (-α + 1) :=
          Real.rpow_lt_rpow_of_exponent_lt (by norm_num) (by linarith)
        have h2 : (2 : ℝ) ^ (-α + 1) = 2 * ε ^ L := by
          rw [Real.rpow_add (by norm_num), Real.rpow_one, h_two_alpha, mul_comm]
        linarith [h_step_rpow, h1, h2]
      exact ⟨hδ_pos, hδ_mul, h_ge, h_lt⟩
    have h_mid_err : ∀ (L x : ℝ),
        |x - ((dyadicRealBin ε L x : ℝ) + 1 / 2) * dyadicRealStep ε L| ≤ ε ^ L := by
      intro L x
      obtain ⟨hδ_pos, hδ_mul, _, hδ_lt⟩ := h_dyad_step L
      let m_L : ℤ := dyadicRealLevel ε L
      let δ_L : ℝ := dyadicRealStep ε L
      have hk_lo : (dyadicRealBin ε L x : ℝ) ≤ x * (2 : ℝ) ^ m_L := Int.floor_le _
      have hk_hi : x * (2 : ℝ) ^ m_L < (dyadicRealBin ε L x : ℝ) + 1 := Int.lt_floor_add_one _
      have hx_eq : (x * (2 : ℝ) ^ m_L) * δ_L = x := by
        dsimp only [m_L, δ_L]
        rw [mul_assoc, mul_comm ((2 : ℝ) ^ (dyadicRealLevel ε L)) (dyadicRealStep ε L),
          hδ_mul, mul_one]
      have h1 := mul_le_mul_of_nonneg_right hk_lo hδ_pos.le
      have h2 := mul_lt_mul_of_pos_right hk_hi hδ_pos
      rw [hx_eq] at h1 h2
      have ha1 : ((dyadicRealBin ε L x : ℝ) + 1 / 2) * δ_L =
          (dyadicRealBin ε L x : ℝ) * δ_L + (1 / 2) * δ_L := by ring
      have ha2 : ((dyadicRealBin ε L x : ℝ) + 1) * δ_L =
          (dyadicRealBin ε L x : ℝ) * δ_L + δ_L := by ring
      rw [abs_le]
      dsimp only [δ_L] at ha1 ha2 h1 h2
      constructor <;> linarith
    have h_bin_mem : ∀ (L x y : ℝ) (R : ℤ),
        |x - y| ≤ (R : ℝ) * dyadicRealStep ε L →
        dyadicRealBin ε L x ∈ Finset.Icc (dyadicRealBin ε L y - R) (dyadicRealBin ε L y + R) := by
      intro L x y R hxy
      let m_L : ℤ := dyadicRealLevel ε L
      have hm_pos : 0 < (2 : ℝ) ^ m_L := zpow_pos (by norm_num : (0 : ℝ) < 2) m_L
      obtain ⟨_, hδ_mul, _, _⟩ := h_dyad_step L
      have h_scaled : |x * (2 : ℝ) ^ m_L - y * (2 : ℝ) ^ m_L| ≤ (R : ℝ) := by
        have h1 : |x * (2 : ℝ) ^ m_L - y * (2 : ℝ) ^ m_L| = |x - y| * (2 : ℝ) ^ m_L := by
          rw [← sub_mul, abs_mul, abs_of_pos hm_pos]
        have h2 := mul_le_mul_of_nonneg_right hxy hm_pos.le
        have h3 : (R : ℝ) * dyadicRealStep ε L * (2 : ℝ) ^ m_L = (R : ℝ) := by
          dsimp only [m_L]
          rw [mul_assoc, hδ_mul, mul_one]
        linarith
      rw [abs_le] at h_scaled
      have hy_lo : (dyadicRealBin ε L y : ℝ) ≤ y * (2 : ℝ) ^ m_L := Int.floor_le _
      have hy_hi : y * (2 : ℝ) ^ m_L < (dyadicRealBin ε L y : ℝ) + 1 := Int.lt_floor_add_one _
      rw [Finset.mem_Icc]
      constructor
      · refine Int.le_floor.mpr ?_
        push_cast
        linarith
      · have h_lt : dyadicRealBin ε L x < dyadicRealBin ε L y + R + 1 :=
          Int.floor_lt.mpr (by push_cast; linarith)
        omega
    have h_unit_vec : ∀ W : EuclideanSpace ℝ (Fin 2),
        ‖isoPrefixLocalVec ε b_star
          (isoPrefixCenter ε b_star (dyadicRealBin ε b_star (W 0))
            (dyadicRealBin ε b_star (W 1))) W‖ ≤ 1 := by
      intro W
      let k₀ := dyadicRealBin ε b_star (W 0)
      let k₁ := dyadicRealBin ε b_star (W 1)
      let w_c := isoPrefixCenter ε b_star k₀ k₁
      let u := isoPrefixLocalVec ε b_star w_c W
      have hεb_pos : 0 < ε ^ b_star := Real.rpow_pos_of_pos hε₀ b_star
      have he0 := h_mid_err b_star (W 0)
      have he1 := h_mid_err b_star (W 1)
      have hsq0 : (W 0 - ((k₀ : ℝ) + 1 / 2) * dyadicRealStep ε b_star) ^ 2 ≤
          (ε ^ b_star) ^ 2 := by
        rw [sq_le_sq, abs_of_pos hεb_pos]
        exact he0
      have hsq1 : (W 1 - ((k₁ : ℝ) + 1 / 2) * dyadicRealStep ε b_star) ^ 2 ≤
          (ε ^ b_star) ^ 2 := by
        rw [sq_le_sq, abs_of_pos hεb_pos]
        exact he1
      have hu0 : u 0 = (2 * ε ^ b_star)⁻¹ *
          (W 0 - ((k₀ : ℝ) + 1 / 2) * dyadicRealStep ε b_star) := by
        simp [u, w_c, isoPrefixLocalVec, isoPrefixCenter]
      have hu1 : u 1 = (2 * ε ^ b_star)⁻¹ *
          (W 1 - ((k₁ : ℝ) + 1 / 2) * dyadicRealStep ε b_star) := by
        simp [u, w_c, isoPrefixLocalVec, isoPrefixCenter]
      have h_norm_sq : ‖u‖ ^ 2 ≤ 1 ^ 2 := by
        have hn : ‖u‖ ^ 2 = (u 0) ^ 2 + (u 1) ^ 2 := by
          rw [PiLp.norm_sq_eq_of_L2, Fin.sum_univ_two]
          simp
        rw [hn, hu0, hu1]
        have h_alg : ((2 * ε ^ b_star)⁻¹ *
              (W 0 - ((k₀ : ℝ) + 1 / 2) * dyadicRealStep ε b_star)) ^ 2 +
            ((2 * ε ^ b_star)⁻¹ *
              (W 1 - ((k₁ : ℝ) + 1 / 2) * dyadicRealStep ε b_star)) ^ 2 ≤
            ((2 * ε ^ b_star)⁻¹) ^ 2 * (2 * (ε ^ b_star) ^ 2) := by
          have hf : ((2 * ε ^ b_star)⁻¹ *
                (W 0 - ((k₀ : ℝ) + 1 / 2) * dyadicRealStep ε b_star)) ^ 2 +
              ((2 * ε ^ b_star)⁻¹ *
                (W 1 - ((k₁ : ℝ) + 1 / 2) * dyadicRealStep ε b_star)) ^ 2 =
              ((2 * ε ^ b_star)⁻¹) ^ 2 *
                ((W 0 - ((k₀ : ℝ) + 1 / 2) * dyadicRealStep ε b_star) ^ 2 +
                 (W 1 - ((k₁ : ℝ) + 1 / 2) * dyadicRealStep ε b_star) ^ 2) := by ring
          rw [hf]
          exact mul_le_mul_of_nonneg_left (by linarith) (sq_nonneg _)
        have h_half : ((2 * ε ^ b_star)⁻¹) ^ 2 * (2 * (ε ^ b_star) ^ 2) = 1 / 2 := by
          field_simp [hεb_pos.ne']
        linarith
      exact (abs_le_of_sq_le_sq' h_norm_sq (by norm_num : (0 : ℝ) ≤ 1)).2
    refine ⟨fun V_p A_p => ⟨h_unit_vec V_p, h_unit_vec A_p⟩, ?_⟩
    
    let m_t : ℕ := dyadicTimeLevel ε t
    let cm_fn : (ℤ × ℤ × ℤ × ℤ × ℤ × ℤ) → ℝ :=
      fun g => ((g.1 : ℝ) + 1 / 2) * ((2 : ℝ) ^ m_t)⁻¹
    let ed_fn : (ℤ × ℤ × ℤ × ℤ × ℤ × ℤ) → EuclideanSpace ℝ (Fin 2) :=
      fun g => angUnitVec ε (a_star - b_star) g.2.1
    let vhat_fn : (ℤ × ℤ × ℤ × ℤ × ℤ × ℤ) → EuclideanSpace ℝ (Fin 2) :=
      fun g =>
        (((g.2.2.1 : ℝ) + 1 / 2) * dyadicRealStep ε b_star) • ed_fn g +
        (((g.2.2.2.1 : ℝ) + 1 / 2) * dyadicRealStep ε a_star) • perp2D (ed_fn g)
    let xhat_fn : (ℤ × ℤ × ℤ × ℤ × ℤ × ℤ) → EuclideanSpace ℝ (Fin 2) :=
      fun g =>
        (((g.2.2.2.2.1 : ℝ) + 1 / 2) * dyadicRealStep ε (b_star + t)) • ed_fn g +
        (((g.2.2.2.2.2 : ℝ) + 1 / 2) * dyadicRealStep ε (a_star + t)) • perp2D (ed_fn g)
    let ahat_fn : (ℤ × ℤ × ℤ × ℤ × ℤ × ℤ) → EuclideanSpace ℝ (Fin 2) :=
      fun g => xhat_fn g - (cm_fn g) • vhat_fn g
    let F_j : (ℤ × ℤ × ℤ × ℤ × ℤ × ℤ) → Finset (ℤ × ℤ × ℤ × ℤ) :=
      fun g =>
        let cv0 := dyadicRealBin ε b_star ((vhat_fn g) 0)
        let cv1 := dyadicRealBin ε b_star ((vhat_fn g) 1)
        let ca0 := dyadicRealBin ε b_star ((ahat_fn g) 0)
        let ca1 := dyadicRealBin ε b_star ((ahat_fn g) 1)
        (Finset.Icc (cv0 - 2) (cv0 + 2)) ×ˢ
          ((Finset.Icc (cv1 - 2) (cv1 + 2)) ×ˢ
            ((Finset.Icc (ca0 - 3) (ca0 + 3)) ×ˢ (Finset.Icc (ca1 - 3) (ca1 + 3))))
    let F_loc : (ℤ × ℤ × ℤ × ℤ × ℤ × ℤ) → (ℤ × ℤ × ℤ × ℤ) →
        Finset (ℤ × ℤ × ℤ × ℤ × ℤ × ℤ) :=
      fun g j =>
        let v_j := isoPrefixCenter ε b_star j.1 j.2.1
        let a_j := isoPrefixCenter ε b_star j.2.2.1 j.2.2.2
