theorem bv_slice_steklov_onesided_limits (x_lo x_hi y_lo y_hi M C_var : ℝ)
    (hx : x_lo < x_hi) (hy : y_lo < y_hi) (hM : 0 ≤ M) (hC : 0 ≤ C_var)
    (F : ℝ × ℝ → ℝ) (hF_meas : Measurable F)
    (hF_bds : ∀ xy : ℝ × ℝ, 0 ≤ F xy ∧ F xy ≤ M)
    (F_seq : ℕ → ℝ × ℝ → ℝ)
    (hF_seq_reg : ∀ m : ℕ,
      ContDiff ℝ 1 (F_seq m) ∧ ∀ xy : ℝ × ℝ, 0 ≤ F_seq m xy ∧ F_seq m xy ≤ M)
    (hF_seq_l1 : Filter.Tendsto (fun m : ℕ =>
      ∫ x in x_lo..x_hi, ∫ y in y_lo..y_hi, |F_seq m (x, y) - F (x, y)|)
      Filter.atTop (nhds 0))
    (hF_seq_var : ∀ m : ℕ,
      (∫ x in x_lo..x_hi, ∫ y in y_lo..y_hi,
        |deriv (fun y' => F_seq m (x, y')) y|) ≤ C_var) :
    ∃ F_minus F_plus : ℝ × ℝ → ℝ,
      Measurable F_minus ∧ Measurable F_plus ∧
      (∀ xy : ℝ × ℝ,
        0 ≤ F_minus xy ∧ F_minus xy ≤ M ∧ 0 ≤ F_plus xy ∧ F_plus xy ≤ M) ∧
      (∀ᵐ x : ℝ, x ∈ Set.Ioo x_lo x_hi →
        (∀ y₀ ∈ Set.Ioo y_lo y_hi,
          Filter.Tendsto (fun y => F_plus (x, y)) (nhdsWithin y₀ (Set.Ioi y₀))
            (nhds (F_plus (x, y₀)))) ∧
        (∀ y₀ ∈ Set.Ioo y_lo y_hi,
          Filter.Tendsto (fun y => F_minus (x, y)) (nhdsWithin y₀ (Set.Iio y₀))
            (nhds (F_minus (x, y₀)))) ∧
        (∀ᵐ y : ℝ, y ∈ Set.Ioo y_lo y_hi →
          F (x, y) = F_plus (x, y) ∧ F (x, y) = F_minus (x, y))) :=
by
  have _ := hC
  
  have h_int_Ioc_of_bdd : ∀ (a b C : ℝ) (g : ℝ → ℝ),
      Measurable g → (∀ t : ℝ, |g t| ≤ C) →
      MeasureTheory.Integrable g (MeasureTheory.volume.restrict (Set.Ioc a b)) := by
    intro a b C g hg hC_bd
    have h_const : MeasureTheory.IntegrableOn (fun _ : ℝ => C) (Set.Ioc a b)
        MeasureTheory.volume :=
      MeasureTheory.integrableOn_const
        (hs := by rw [Real.volume_Ioc]; exact ENNReal.ofReal_ne_top)
    exact h_const.mono' hg.aestronglyMeasurable
      (Filter.Eventually.of_forall (fun t => by simpa [Real.norm_eq_abs] using hC_bd t))

  
  obtain ⟨rightSteklov, h_rs_def⟩ : ∃ rs : (ℝ → ℝ) → ℝ → ℝ,
      ∀ (g : ℝ → ℝ) (t : ℝ), rs g t =
        Filter.limsup (fun m : ℕ =>
          max 0 (min M (((m : ℝ) + 1) * ∫ τ in (0 : ℝ)..((m : ℝ) + 1)⁻¹, g (t + τ))))
          Filter.atTop :=
    ⟨fun g t => Filter.limsup (fun m : ℕ =>
        max 0 (min M (((m : ℝ) + 1) * ∫ τ in (0 : ℝ)..((m : ℝ) + 1)⁻¹, g (t + τ))))
        Filter.atTop, fun _ _ => rfl⟩

  
  have h_stage1 : ∀ (G : ℝ × ℝ → ℝ), Measurable G →
      Measurable (fun xy : ℝ × ℝ => rightSteklov (fun y => G (xy.1, y)) xy.2) ∧
      ∀ xy : ℝ × ℝ,
        0 ≤ rightSteklov (fun y => G (xy.1, y)) xy.2 ∧
        rightSteklov (fun y => G (xy.1, y)) xy.2 ≤ M := by
    intro G hG_meas
    refine ⟨?_, fun xy => ?_⟩
    · simp_rw [h_rs_def]
      refine Measurable.limsup (fun m => ?_)
      have hh_m_nn : (0 : ℝ) ≤ ((m : ℝ) + 1)⁻¹ := inv_nonneg.mpr (by positivity)
      have hH_meas : Measurable (fun p : (ℝ × ℝ) × ℝ => G (p.1.1, p.1.2 + p.2)) :=
        hG_meas.comp ((measurable_fst.comp measurable_fst).prodMk
          ((measurable_snd.comp measurable_fst).add measurable_snd))
      have h_int_meas : Measurable (fun xy : ℝ × ℝ =>
          ∫ τ, G (xy.1, xy.2 + τ) ∂(MeasureTheory.volume.restrict (Set.Ioc 0 (((m : ℝ) + 1)⁻¹)))) :=
        (hH_meas.stronglyMeasurable.integral_prod_right').measurable
      simp_rw [intervalIntegral.integral_of_le hh_m_nn]
      exact measurable_const.max (measurable_const.min (measurable_const.mul h_int_meas))
    · rw [h_rs_def]
      obtain ⟨u, hu_def⟩ : ∃ u : ℕ → ℝ, ∀ m : ℕ, u m =
          max 0 (min M (((m : ℝ) + 1) * ∫ τ in (0 : ℝ)..((m : ℝ) + 1)⁻¹, G (xy.1, xy.2 + τ))) :=
        ⟨_, fun _ => rfl⟩
      simp_rw [← hu_def]
      have hu_nn : ∀ m : ℕ, 0 ≤ u m := fun m => by rw [hu_def]; exact le_max_left _ _
      have hu_le : ∀ m : ℕ, u m ≤ M := fun m => by rw [hu_def]; exact max_le hM (min_le_left _ _)
      have h_bdd : Filter.IsBoundedUnder (· ≤ ·) Filter.atTop u :=
        Filter.isBoundedUnder_of ⟨M, hu_le⟩
      have h_cobdd : Filter.IsCoboundedUnder (· ≤ ·) Filter.atTop u :=
        Filter.isCoboundedUnder_le_of_eventually_le Filter.atTop
          (Filter.Eventually.of_forall hu_nn)
      exact ⟨Filter.le_limsup_of_frequently_le
          (Filter.Eventually.of_forall hu_nn).frequently h_bdd,
        Filter.limsup_le_of_le h_cobdd (Filter.Eventually.of_forall hu_le)⟩

  
  have h_stage2 : ∀ᵐ x : ℝ, x ∈ Set.Ioo x_lo x_hi →
      ∃ (B : ℝ) (E : Set ℝ),
        0 ≤ B ∧
        E ⊆ Set.Ioo y_lo y_hi ∧
        (∀ᵐ y : ℝ, y ∈ Set.Ioo y_lo y_hi → y ∈ E) ∧
        (∀ (N : ℕ) (u : ℕ → ℝ), Monotone u → (∀ i ≤ N, u i ∈ E) →
          (∑ i ∈ Finset.range N, |F (x, u (i + 1)) - F (x, u i)|) ≤ B) := by
    have h_ex_σ : ∀ k : ℕ, ∃ m : ℕ,
        (∫ x in x_lo..x_hi, ∫ y in y_lo..y_hi, |F_seq m (x, y) - F (x, y)|) ≤
          (1 / 2 : ℝ) ^ k := by
      intro k
      obtain ⟨N₀, hN₀⟩ := Metric.tendsto_atTop.mp hF_seq_l1 ((1 / 2 : ℝ) ^ k) (by positivity)
      refine ⟨N₀, ?_⟩
      have h1 := hN₀ N₀ le_rfl
      rw [Real.dist_eq, sub_zero] at h1
      exact le_trans (le_abs_self _) h1.le
    choose σ hσ using h_ex_σ
    let μ_x := MeasureTheory.volume.restrict (Set.Ioc x_lo x_hi)
    let μ_y := MeasureTheory.volume.restrict (Set.Ioc y_lo y_hi)
    obtain ⟨d, hd_def⟩ : ∃ d : ℕ → ℝ × ℝ → ℝ,
        ∀ (k : ℕ) (xy : ℝ × ℝ), d k xy = |F_seq (σ k) xy - F xy| :=
      ⟨fun k xy => |F_seq (σ k) xy - F xy|, fun _ _ => rfl⟩
    have hd_meas : ∀ k : ℕ, Measurable (d k) := by
      intro k
      have h_eq : d k = fun xy => |F_seq (σ k) xy - F xy| := funext (hd_def k)
      rw [h_eq]
      exact continuous_abs.measurable.comp ((hF_seq_reg (σ k)).1.continuous.measurable.sub hF_meas)
    have hd_nn : ∀ (k : ℕ) (xy : ℝ × ℝ), 0 ≤ d k xy := by
      intro k xy; rw [hd_def]; exact abs_nonneg _
    have hd_le : ∀ (k : ℕ) (xy : ℝ × ℝ), d k xy ≤ M := by
      intro k xy
      rw [hd_def]
      have h1 := (hF_seq_reg (σ k)).2 xy
      have h2 := hF_bds xy
      exact abs_sub_le_iff.mpr ⟨by linarith, by linarith⟩
    have h_l1_k : ∀ k : ℕ,
        (∫⁻ x, (∫⁻ y, ENNReal.ofReal (d k (x, y)) ∂μ_y) ∂μ_x) ≤
          ENNReal.ofReal ((1 / 2 : ℝ) ^ k) := by
      intro k
      let I_y : ℝ → ℝ := fun x => ∫ y in y_lo..y_hi, d k (x, y)
      have h_inner_eq : ∀ x : ℝ,
          ENNReal.ofReal (I_y x) = ∫⁻ y, ENNReal.ofReal (d k (x, y)) ∂μ_y := by
        intro x
        have h_int_y : MeasureTheory.Integrable (fun y => d k (x, y)) μ_y :=
          h_int_Ioc_of_bdd y_lo y_hi M (fun y => d k (x, y))
            ((hd_meas k).comp (measurable_const.prodMk measurable_id))
            (fun y => by rw [abs_of_nonneg (hd_nn k (x, y))]; exact hd_le k (x, y))
        dsimp only [I_y]
        rw [intervalIntegral.integral_of_le hy.le]
        exact MeasureTheory.ofReal_integral_eq_lintegral_ofReal h_int_y
          (Filter.Eventually.of_forall (fun y => hd_nn k (x, y)))
      have hIy_eq_mu : I_y = fun x => ∫ y, d k (x, y) ∂μ_y := by
        ext x
        exact intervalIntegral.integral_of_le hy.le
      have hIy_meas : Measurable I_y := by
        rw [hIy_eq_mu]
        exact ((hd_meas k).stronglyMeasurable.integral_prod_right').measurable
      have hIy_nn : ∀ x : ℝ, 0 ≤ I_y x := fun x =>
        intervalIntegral.integral_nonneg hy.le (fun y _ => hd_nn k (x, y))
      have hIy_abs : ∀ x : ℝ, |I_y x| ≤ M * |y_hi - y_lo| := by
        intro x
        have h_norm := intervalIntegral.norm_integral_le_of_norm_le_const_ae
          (a := y_lo) (b := y_hi) (C := M) (f := fun y => d k (x, y))
          (Filter.Eventually.of_forall (fun y _ => by
            rw [Real.norm_eq_abs, abs_of_nonneg (hd_nn k (x, y))]
            exact hd_le k (x, y)))
        simpa [I_y, Real.norm_eq_abs] using h_norm
      have hIy_int : MeasureTheory.Integrable I_y μ_x :=
        h_int_Ioc_of_bdd x_lo x_hi (M * |y_hi - y_lo|) I_y hIy_meas hIy_abs
      have h_outer_eq : ENNReal.ofReal (∫ x in x_lo..x_hi, I_y x) =
          ∫⁻ x, ENNReal.ofReal (I_y x) ∂μ_x := by
        rw [intervalIntegral.integral_of_le hx.le]
        exact MeasureTheory.ofReal_integral_eq_lintegral_ofReal hIy_int
          (Filter.Eventually.of_forall hIy_nn)
      simp_rw [← h_inner_eq, ← h_outer_eq]
      have h_eq_int : (∫ x in x_lo..x_hi, I_y x) =
          ∫ x in x_lo..x_hi, ∫ y in y_lo..y_hi, |F_seq (σ k) (x, y) - F (x, y)| := by
        dsimp only [I_y]
        simp_rw [hd_def]
      rw [h_eq_int]
      exact ENNReal.ofReal_le_ofReal (hσ k)
    have h_tsum_lt_top :
        (∫⁻ x, (∫⁻ y, (∑' k : ℕ, ENNReal.ofReal (d k (x, y))) ∂μ_y) ∂μ_x) < ⊤ := by
      have h_in : ∀ x : ℝ,
          (∫⁻ y, (∑' k : ℕ, ENNReal.ofReal (d k (x, y))) ∂μ_y) =
            ∑' k : ℕ, ∫⁻ y, ENNReal.ofReal (d k (x, y)) ∂μ_y := fun x =>
        MeasureTheory.lintegral_tsum (fun k =>
          ((hd_meas k).comp (measurable_const.prodMk measurable_id)).ennreal_ofReal.aemeasurable)
      simp_rw [h_in]
      have h_out_meas : ∀ k : ℕ,
          AEMeasurable (fun x : ℝ => ∫⁻ y, ENNReal.ofReal (d k (x, y)) ∂μ_y) μ_x := fun k =>
        ((hd_meas k).ennreal_ofReal.lintegral_prod_right').aemeasurable
      rw [MeasureTheory.lintegral_tsum h_out_meas]
      refine lt_of_le_of_lt (ENNReal.tsum_le_tsum h_l1_k) ?_
      have h_geom : ∀ k : ℕ, ENNReal.ofReal ((1 / 2 : ℝ) ^ k) = ((2 : ENNReal)⁻¹) ^ k := by
        intro k
        rw [ENNReal.ofReal_pow (by norm_num), one_div, ENNReal.ofReal_inv_of_pos (by norm_num),
          ENNReal.ofReal_ofNat]
      simp_rw [h_geom, ENNReal.tsum_geometric]
      rw [ENNReal.inv_lt_top]
      norm_num
    have h_meas_tsum : Measurable (fun xy : ℝ × ℝ => ∑' k : ℕ, ENNReal.ofReal (d k xy)) :=
      Measurable.tsum (fun k => (hd_meas k).ennreal_ofReal)
    have h_ae_x_tsum : ∀ᵐ x : ℝ, x ∈ Set.Ioo x_lo x_hi →
        ∀ᵐ y : ℝ, y ∈ Set.Ioo y_lo y_hi →
          Filter.Tendsto (fun k : ℕ => F_seq (σ k) (x, y)) Filter.atTop (nhds (F (x, y))) := by
      have hx_ae_mu := MeasureTheory.ae_lt_top
        h_meas_tsum.lintegral_prod_right' h_tsum_lt_top.ne
      rw [MeasureTheory.ae_restrict_iff' measurableSet_Ioc] at hx_ae_mu
      filter_upwards [hx_ae_mu] with x hx_fin hx_mem
      have hy_lt := hx_fin (Set.Ioo_subset_Ioc_self hx_mem)
      have hy_ae_mu := MeasureTheory.ae_lt_top
        (h_meas_tsum.comp (measurable_const.prodMk measurable_id)) hy_lt.ne
      rw [MeasureTheory.ae_restrict_iff' measurableSet_Ioc] at hy_ae_mu
      filter_upwards [hy_ae_mu] with y hy_fin hy_mem
      have h_ne_top := (hy_fin (Set.Ioo_subset_Ioc_self hy_mem)).ne
      have h_enn_zero := ENNReal.tendsto_atTop_zero_of_tsum_ne_top h_ne_top
      have h_real_zero := (ENNReal.tendsto_toReal ENNReal.zero_ne_top).comp h_enn_zero
      simp only [Function.comp_def, ENNReal.toReal_zero] at h_real_zero
      have h_abs_zero : Filter.Tendsto (fun k : ℕ => |F_seq (σ k) (x, y) - F (x, y)|)
          Filter.atTop (nhds 0) := by
        refine h_real_zero.congr (fun k => ?_)
        dsimp only [id_eq]
        rw [ENNReal.toReal_ofReal (hd_nn k (x, y)), hd_def]
      rw [tendsto_iff_norm_sub_tendsto_zero]
      simpa [Real.norm_eq_abs] using h_abs_zero
    
    have h_pderiv_cont : ∀ m : ℕ,
        Continuous (fun xy : ℝ × ℝ => deriv (fun y' => F_seq m (xy.1, y')) xy.2) := by
      intro m
      have hG : ContDiff ℝ 1 (F_seq m) := (hF_seq_reg m).1
      have h_eq : (fun xy : ℝ × ℝ => deriv (fun y' => F_seq m (xy.1, y')) xy.2) =
          fun xy : ℝ × ℝ => fderiv ℝ (F_seq m) xy (0, 1) := by
        ext ⟨x, y⟩
        have hd : DifferentiableAt ℝ (F_seq m) (x, y) :=
          (hG.differentiable one_ne_zero).differentiableAt
        exact (hd.hasFDerivAt.comp_hasDerivAt y
          ((hasDerivAt_const y x).prodMk (hasDerivAt_id y))).deriv
      rw [h_eq]
      exact (hG.continuous_fderiv_apply one_ne_zero).comp
        (continuous_id.prodMk continuous_const)
    obtain ⟨v_var, hv_def⟩ : ∃ v_var : ℕ → ℝ → ℝ,
        ∀ (k : ℕ) (x : ℝ), v_var k x =
          ∫ y in y_lo..y_hi, |deriv (fun y' => F_seq (σ k) (x, y')) y| :=
      ⟨fun k x => ∫ y in y_lo..y_hi, |deriv (fun y' => F_seq (σ k) (x, y')) y|, fun _ _ => rfl⟩
    have hv_cont : ∀ k : ℕ, Continuous (v_var k) := by
      intro k
      have h_eq : v_var k = fun x =>
          ∫ y in y_lo..y_hi, |deriv (fun y' => F_seq (σ k) (x, y')) y| := funext (hv_def k)
      rw [h_eq]
      have h_un : Continuous
          (Function.uncurry (fun x y : ℝ => |deriv (fun y' => F_seq (σ k) (x, y')) y|)) :=
        (continuous_abs.comp (h_pderiv_cont (σ k))).comp
          (continuous_fst.prodMk continuous_snd)
      exact intervalIntegral.continuous_parametric_intervalIntegral_of_continuous' h_un y_lo y_hi
    have hv_nn : ∀ (k : ℕ) (x : ℝ), 0 ≤ v_var k x := by
      intro k x; rw [hv_def]
      exact intervalIntegral.integral_nonneg hy.le (fun y _ => abs_nonneg _)
    have hv_lintegral : ∀ k : ℕ,
        (∫⁻ x, ENNReal.ofReal (v_var k x) ∂μ_x) ≤ ENNReal.ofReal C_var := by
      intro k
      have hv_int : MeasureTheory.Integrable (v_var k) μ_x := (hv_cont k).integrableOn_Ioc
      rw [← MeasureTheory.ofReal_integral_eq_lintegral_ofReal hv_int
        (Filter.Eventually.of_forall (hv_nn k)),
        ← intervalIntegral.integral_of_le hx.le]
      simp_rw [hv_def k]
      exact ENNReal.ofReal_le_ofReal (hF_seq_var (σ k))
    have h_fatou :
        (∫⁻ x, Filter.liminf (fun k : ℕ => ENNReal.ofReal (v_var k x)) Filter.atTop ∂μ_x) < ⊤ := by
      have h1 := MeasureTheory.lintegral_liminf_le (μ := μ_x)
        (f := fun k x => ENNReal.ofReal (v_var k x)) (u := Filter.atTop)
        (fun k => (hv_cont k).measurable.ennreal_ofReal)
      have h2 : Filter.liminf (fun k : ℕ => ∫⁻ x, ENNReal.ofReal (v_var k x) ∂μ_x)
          Filter.atTop ≤ ENNReal.ofReal C_var :=
        Filter.liminf_le_of_frequently_le' (Filter.Eventually.of_forall hv_lintegral).frequently
      exact lt_of_le_of_lt (le_trans h1 h2) ENNReal.ofReal_lt_top
    have h_ae_x_var : ∀ᵐ x : ℝ, x ∈ Set.Ioo x_lo x_hi →
        Filter.liminf (fun k : ℕ => ENNReal.ofReal (v_var k x)) Filter.atTop < ⊤ := by
      have hx_mu := MeasureTheory.ae_lt_top
        (Measurable.liminf (fun k => (hv_cont k).measurable.ennreal_ofReal))
        h_fatou.ne
      rw [MeasureTheory.ae_restrict_iff' measurableSet_Ioc] at hx_mu
      filter_upwards [hx_mu] with x hx_fin hx_mem
      exact hx_fin (Set.Ioo_subset_Ioc_self hx_mem)
    filter_upwards [h_ae_x_tsum, h_ae_x_var] with x hx_conv hx_var hx_mem
    let V_enn : ENNReal := Filter.liminf (fun k : ℕ => ENNReal.ofReal (v_var k x)) Filter.atTop
    have hV_lt : V_enn < ⊤ := hx_var hx_mem
    let E : Set ℝ := { y : ℝ | y ∈ Set.Ioo y_lo y_hi ∧
      Filter.Tendsto (fun k : ℕ => F_seq (σ k) (x, y)) Filter.atTop (nhds (F (x, y))) }
    refine ⟨V_enn.toReal, E, ENNReal.toReal_nonneg, fun y hyE => hyE.1, ?_, ?_⟩
    · filter_upwards [hx_conv hx_mem] with y hy_c hy_ioo
      exact ⟨hy_ioo, hy_c hy_ioo⟩
    · intro N u hu_mono hu_E
      cases N with
      | zero => simp [ENNReal.toReal_nonneg]
      | succ M_n =>
        have h_chain_k : ∀ k : ℕ,
            (∑ i ∈ Finset.range (M_n + 1),
              |F_seq (σ k) (x, u (i + 1)) - F_seq (σ k) (x, u i)|) ≤ v_var k x := by
          intro k
          let g_k : ℝ → ℝ := fun y => F_seq (σ k) (x, y)
          have hgk_diff : ∀ y : ℝ, DifferentiableAt ℝ g_k y := by
            intro y
            have hd : DifferentiableAt ℝ (F_seq (σ k)) (x, y) :=
              ((hF_seq_reg (σ k)).1.differentiable one_ne_zero).differentiableAt
            exact (hd.hasFDerivAt.comp_hasDerivAt y
              ((hasDerivAt_const y x).prodMk (hasDerivAt_id y))).differentiableAt
          have hgk_der_cont : Continuous (deriv g_k) :=
            (h_pderiv_cont (σ k)).comp (continuous_const.prodMk continuous_id)
          have hgk_abs_cont : Continuous (fun y : ℝ => |deriv g_k y|) :=
            continuous_abs.comp hgk_der_cont
          have h_step : ∀ i ∈ Finset.range (M_n + 1),
              |g_k (u (i + 1)) - g_k (u i)| ≤ ∫ y in u i..u (i + 1), |deriv g_k y| := by
            intro i _
            have hui : u i ≤ u (i + 1) := hu_mono (Nat.le_succ i)
            have h_ftc : ∫ y in u i..u (i + 1), deriv g_k y = g_k (u (i + 1)) - g_k (u i) :=
              intervalIntegral.integral_deriv_eq_sub (fun y _ => hgk_diff y)
                (hgk_der_cont.intervalIntegrable (u i) (u (i + 1)))
            rw [← h_ftc]
            simpa [Real.norm_eq_abs] using
              (intervalIntegral.norm_integral_le_integral_norm
                (μ := MeasureTheory.volume) (f := deriv g_k) hui)
          have h_sum_le : (∑ i ∈ Finset.range (M_n + 1), |g_k (u (i + 1)) - g_k (u i)|) ≤
              ∑ i ∈ Finset.range (M_n + 1), ∫ y in u i..u (i + 1), |deriv g_k y| :=
            Finset.sum_le_sum h_step
          have h_adj : (∑ i ∈ Finset.range (M_n + 1), ∫ y in u i..u (i + 1), |deriv g_k y|) =
              ∫ y in u 0..u (M_n + 1), |deriv g_k y| :=
            intervalIntegral.sum_integral_adjacent_intervals
              (fun i _ => hgk_abs_cont.intervalIntegrable (u i) (u (i + 1)))
          have hu0_E : u 0 ∈ Set.Ioo y_lo y_hi := (hu_E 0 (Nat.zero_le _)).1
          have huN_E : u (M_n + 1) ∈ Set.Ioo y_lo y_hi := (hu_E (M_n + 1) le_rfl).1
          have hu0N : u 0 ≤ u (M_n + 1) := hu_mono (Nat.zero_le _)
          have h_sub_ioc : Set.Ioc (u 0) (u (M_n + 1)) ⊆ Set.Ioc y_lo y_hi :=
            fun y hy_mem => ⟨lt_of_lt_of_le hu0_E.1 hy_mem.1.le, le_trans hy_mem.2 huN_E.2.le⟩
          have h_mono_set : (∫ y in u 0..u (M_n + 1), |deriv g_k y|) ≤ v_var k x := by
            rw [hv_def k]
            dsimp only [g_k]
            rw [intervalIntegral.integral_of_le hu0N, intervalIntegral.integral_of_le hy.le]
            exact MeasureTheory.setIntegral_mono_set
              hgk_abs_cont.integrableOn_Ioc
              (Filter.Eventually.of_forall (fun _ => abs_nonneg _))
              (Filter.Eventually.of_forall h_sub_ioc)
          exact le_trans h_sum_le (h_adj.trans_le h_mono_set)
        have h_sum_tendsto : Filter.Tendsto
            (fun k : ℕ => ∑ i ∈ Finset.range (M_n + 1),
              |F_seq (σ k) (x, u (i + 1)) - F_seq (σ k) (x, u i)|)
            Filter.atTop
            (nhds (∑ i ∈ Finset.range (M_n + 1), |F (x, u (i + 1)) - F (x, u i)|)) := by
          refine tendsto_finsetSum (Finset.range (M_n + 1)) (fun i hi => ?_)
          have hi_lt : i < M_n + 1 := Finset.mem_range.mp hi
          have hi1 : i + 1 ≤ M_n + 1 := hi_lt
          have hi0 : i ≤ M_n + 1 := Nat.le_of_lt hi_lt
          exact ((hu_E (i + 1) hi1).2.sub (hu_E i hi0).2).abs
        have h_enn_tendsto := ENNReal.tendsto_ofReal h_sum_tendsto
        have h_liminf_le : ENNReal.ofReal
            (∑ i ∈ Finset.range (M_n + 1), |F (x, u (i + 1)) - F (x, u i)|) ≤ V_enn := by
          rw [← h_enn_tendsto.liminf_eq]
          exact Filter.liminf_le_liminf
            (Filter.Eventually.of_forall (fun k => ENNReal.ofReal_le_ofReal (h_chain_k k)))
        exact (ENNReal.ofReal_le_iff_le_toReal hV_lt.ne).mp h_liminf_le

  
  have h_stage3 : ∀ (a_lo a_hi B : ℝ), a_lo < a_hi → 0 ≤ B →
      ∀ (g : ℝ → ℝ), Measurable g → (∀ y : ℝ, 0 ≤ g y ∧ g y ≤ M) →
      ∀ (E : Set ℝ), E ⊆ Set.Ioo a_lo a_hi →
        (∀ᵐ y : ℝ, y ∈ Set.Ioo a_lo a_hi → y ∈ E) →
        (∀ (N : ℕ) (u : ℕ → ℝ), Monotone u → (∀ i ≤ N, u i ∈ E) →
          (∑ i ∈ Finset.range N, |g (u (i + 1)) - g (u i)|) ≤ B) →
        (∀ y₀ ∈ Set.Ioo a_lo a_hi,
          Filter.Tendsto (rightSteklov g) (nhdsWithin y₀ (Set.Ioi y₀))
            (nhds (rightSteklov g y₀))) ∧
        (∀ᵐ y : ℝ, y ∈ Set.Ioo a_lo a_hi → g y = rightSteklov g y) := by
    intro a_lo a_hi B ha hB g hg_meas hg_bds E hE_sub hE_ae hE_var
    
    have hE_dense : ∀ p q : ℝ, a_lo ≤ p → p < q → q ≤ a_hi → ∃ u ∈ E, u ∈ Set.Ioo p q := by
      intro p q hp hpq hq
      by_contra h_empty
      have h_sub_null : Set.Ioo p q ⊆ { y : ℝ | ¬ (y ∈ Set.Ioo a_lo a_hi → y ∈ E) } := by
        intro y hy_pq h_imp
        have hy_ab : y ∈ Set.Ioo a_lo a_hi :=
          ⟨lt_of_le_of_lt hp hy_pq.1, lt_of_lt_of_le hy_pq.2 hq⟩
        exact h_empty ⟨y, h_imp hy_ab, hy_pq⟩
      have h_zero : MeasureTheory.volume { y : ℝ | ¬ (y ∈ Set.Ioo a_lo a_hi → y ∈ E) } = 0 :=
        MeasureTheory.ae_iff.mp hE_ae
      have h_ioo_zero := MeasureTheory.measure_mono_null h_sub_null h_zero
      rw [Real.volume_Ioo, ENNReal.ofReal_eq_zero] at h_ioo_zero
      linarith
    
    obtain ⟨W, hW_mono, hW_lip_E⟩ : ∃ W : ℝ → ℝ,
        Monotone W ∧
        (∀ u₁ ∈ E, ∀ u₂ ∈ E, u₁ ≤ u₂ → |g u₂ - g u₁| ≤ W u₂ - W u₁) := by
      let S_var : ℝ → Set ℝ := fun y =>
        insert (0 : ℝ) { V : ℝ | ∃ (N : ℕ) (u : ℕ → ℝ),
          Monotone u ∧ (∀ i ≤ N, u i ∈ E ∧ u i ≤ y) ∧
          V = ∑ i ∈ Finset.range N, |g (u (i + 1)) - g (u i)| }
      let W₀ : ℝ → ℝ := fun y => sSup (S_var y)
      have hS_ne : ∀ y : ℝ, (S_var y).Nonempty := fun _ => ⟨0, Set.mem_insert 0 _⟩
      have hS_bdd : ∀ y : ℝ, BddAbove (S_var y) := by
        intro y
        refine ⟨B, fun V hV => ?_⟩
        rcases hV with rfl | ⟨N, u, hu_mono, hu_ey, rfl⟩
        · exact hB
        · exact hE_var N u hu_mono (fun i hi => (hu_ey i hi).1)
      have hW₀_mono : Monotone W₀ := by
        intro y₁ y₂ hy₁₂
        refine csSup_le_csSup (hS_bdd y₂) (hS_ne y₁) (fun V hV => ?_)
        rcases hV with rfl | ⟨N, u, hu_mono, hu_ey, rfl⟩
        · exact Or.inl rfl
        · exact Or.inr ⟨N, u, hu_mono,
            fun i hi => ⟨(hu_ey i hi).1, le_trans (hu_ey i hi).2 hy₁₂⟩, rfl⟩
      have hW₀_lip : ∀ u₁ ∈ E, ∀ u₂ ∈ E, u₁ ≤ u₂ → |g u₂ - g u₁| ≤ W₀ u₂ - W₀ u₁ := by
        intro u₁ hu₁ u₂ hu₂ hu₁₂
        suffices h_add : W₀ u₁ ≤ W₀ u₂ - |g u₂ - g u₁| by linarith
        refine csSup_le (hS_ne u₁) (fun V hV => ?_)
        suffices hV_add : V + |g u₂ - g u₁| ≤ W₀ u₂ by linarith
        rcases hV with rfl | ⟨N, w, hw_mono, hw_eu₁, rfl⟩
        · let w' : ℕ → ℝ := fun j => if j = 0 then u₁ else u₂
          have hw'_mono : Monotone w' := by
            intro i j hij
            dsimp only [w']
            split_ifs with hi hj hj
            · exact le_rfl
            · exact hu₁₂
            · omega
            · exact le_rfl
          have hw'_eu₂ : ∀ i ≤ 1, w' i ∈ E ∧ w' i ≤ u₂ := by
            intro i hi
            dsimp only [w']
            split_ifs with h0
            · exact ⟨hu₁, hu₁₂⟩
            · exact ⟨hu₂, le_rfl⟩
          have h_mem : (∑ i ∈ Finset.range 1, |g (w' (i + 1)) - g (w' i)|) ∈ S_var u₂ :=
            Or.inr ⟨1, w', hw'_mono, hw'_eu₂, rfl⟩
          have h_le := le_csSup (hS_bdd u₂) h_mem
          simpa [w'] using h_le
        · let w' : ℕ → ℝ := fun j => if j ≤ N then w j else if j = N + 1 then u₁ else u₂
          have hw'_mono : Monotone w' := by
            intro i j hij
            dsimp only [w']
            split_ifs with hi hj hj h_eq_j h_eq_i hj h_eq_j
            · exact hw_mono hij
            · exact (hw_eu₁ i hi).2
            · exact le_trans (hw_eu₁ i hi).2 hu₁₂
            · omega
            · exact le_rfl
            · exact hu₁₂
            · omega
            · omega
            · exact le_rfl
          have hw'_eu₂ : ∀ i ≤ N + 2, w' i ∈ E ∧ w' i ≤ u₂ := by
            intro i hi
            dsimp only [w']
            split_ifs with hiN hiN1
            · exact ⟨(hw_eu₁ i hiN).1, le_trans (hw_eu₁ i hiN).2 hu₁₂⟩
            · exact ⟨hu₁, hu₁₂⟩
            · exact ⟨hu₂, le_rfl⟩
          have h_mem : (∑ i ∈ Finset.range (N + 2), |g (w' (i + 1)) - g (w' i)|) ∈ S_var u₂ :=
            Or.inr ⟨N + 2, w', hw'_mono, hw'_eu₂, rfl⟩
          have h_le := le_csSup (hS_bdd u₂) h_mem
          rw [Finset.sum_range_succ, Finset.sum_range_succ] at h_le
          have h_prefix : (∑ i ∈ Finset.range N, |g (w' (i + 1)) - g (w' i)|) =
              ∑ i ∈ Finset.range N, |g (w (i + 1)) - g (w i)| := by
            refine Finset.sum_congr rfl (fun i hi => ?_)
            have hi_lt : i < N := Finset.mem_range.mp hi
            have h1 : i + 1 ≤ N := hi_lt
            have h0 : i ≤ N := Nat.le_of_lt hi_lt
            simp [w', h1, h0]
          have h_mid : 0 ≤ |g (w' (N + 1)) - g (w' N)| := abs_nonneg _
          have h_last : |g (w' (N + 2)) - g (w' (N + 1))| = |g u₂ - g u₁| := by
            have h1 : ¬ (N + 2 ≤ N) := by omega
            have h3 : ¬ (N + 1 ≤ N) := by omega
            simp [w', h1, h3]
          linarith
      exact ⟨W₀, hW₀_mono, hW₀_lip⟩
    
    obtain ⟨W_plus, hW_le_Wp, hWp_le_W, hWp_mono, hWp_approx⟩ : ∃ W_plus : ℝ → ℝ,
        (∀ y : ℝ, W y ≤ W_plus y) ∧
        (∀ (y s : ℝ), y < s → W_plus y ≤ W s) ∧
        Monotone W_plus ∧
        (∀ (y η : ℝ), 0 < η → ∃ s : ℝ, y < s ∧ W s < W_plus y + η) := by
      let Wp₀ : ℝ → ℝ := fun y => sInf (W '' Set.Ioi y)
      have hWp_ne : ∀ y : ℝ, (W '' Set.Ioi y).Nonempty :=
        fun y => ⟨W (y + 1), ⟨y + 1, Set.mem_Ioi.mpr (by linarith), rfl⟩⟩
      have hWp_bdd : ∀ y : ℝ, BddBelow (W '' Set.Ioi y) := by
        intro y
        refine ⟨W y, ?_⟩
        rintro _ ⟨s, hs, rfl⟩
        exact hW_mono (Set.mem_Ioi.mp hs).le
      refine ⟨Wp₀, ?_, ?_, ?_, ?_⟩
      · intro y
        refine le_csInf (hWp_ne y) ?_
        rintro _ ⟨s, hs, rfl⟩
        exact hW_mono (Set.mem_Ioi.mp hs).le
      · exact fun y s hys => csInf_le (hWp_bdd y) ⟨s, Set.mem_Ioi.mpr hys, rfl⟩
      · intro y₁ y₂ hy₁₂
        refine csInf_le_csInf (hWp_bdd y₁) (hWp_ne y₂) ?_
        rintro _ ⟨s, hs, rfl⟩
        exact ⟨s, Set.mem_Ioi.mpr (lt_of_le_of_lt hy₁₂ (Set.mem_Ioi.mp hs)), rfl⟩
      · intro y η hη
        obtain ⟨_, ⟨s, hs, rfl⟩, hs_lt⟩ :=
          exists_lt_of_csInf_lt (hWp_ne y) (lt_add_of_pos_right (Wp₀ y) hη)
        exact ⟨s, Set.mem_Ioi.mp hs, hs_lt⟩
    have h_master : ∀ y₀ ∈ Set.Ioo a_lo a_hi, ∀ u ∈ E, y₀ < u →
        |g u - rightSteklov g y₀| ≤ W u - W_plus y₀ := by
      intro y₀ hy₀
      let δ₀ : ℝ := (a_hi - y₀) / 2
      have hδ₀_pos : 0 < δ₀ := by dsimp [δ₀]; linarith [hy₀.2]
      have h_ex_u : ∀ n : ℕ, ∃ u_n : ℝ,
          u_n ∈ E ∧ u_n ∈ Set.Ioo y₀ (y₀ + δ₀ / ((n : ℝ) + 1)) := by
        intro n
        have hr_pos : 0 < δ₀ / ((n : ℝ) + 1) := div_pos hδ₀_pos (by positivity)
        have hr_le : δ₀ / ((n : ℝ) + 1) ≤ δ₀ :=
          div_le_self hδ₀_pos.le (by linarith [Nat.cast_nonneg (α := ℝ) n])
        exact hE_dense y₀ (y₀ + δ₀ / ((n : ℝ) + 1)) hy₀.1.le
          (by linarith) (by dsimp [δ₀] at hr_le ⊢; linarith [hy₀.2])
      choose u_seq hu_seq using h_ex_u
      have h_cauchy : CauchySeq (fun n : ℕ => g (u_seq n)) := by
        rw [Metric.cauchySeq_iff]
        intro ε hε
        obtain ⟨s, hs_gt, hs_lt⟩ := hWp_approx y₀ ε hε
        have hsy_pos : 0 < s - y₀ := sub_pos.mpr hs_gt
        obtain ⟨N₀, hN₀⟩ := exists_nat_gt (δ₀ / (s - y₀))
        refine ⟨N₀, fun m hm n hn => ?_⟩
        have hu_le_s : ∀ k : ℕ, N₀ ≤ k → u_seq k ≤ s := by
          intro k hk
          have hk1_pos : (0 : ℝ) < (k : ℝ) + 1 := by positivity
          have h_div : δ₀ / ((k : ℝ) + 1) < s - y₀ := by
            rw [div_lt_iff₀ hk1_pos]
            have h1 : δ₀ < (N₀ : ℝ) * (s - y₀) := (div_lt_iff₀ hsy_pos).mp hN₀
            have h2 : (N₀ : ℝ) ≤ (k : ℝ) := by exact_mod_cast hk
            nlinarith
          linarith [(hu_seq k).2.2]
        have hum_le : u_seq m ≤ s := hu_le_s m hm
        have hun_le : u_seq n ≤ s := hu_le_s n hn
        have hW_um_lb : W_plus y₀ ≤ W (u_seq m) := hWp_le_W y₀ (u_seq m) (hu_seq m).2.1
        have hW_un_lb : W_plus y₀ ≤ W (u_seq n) := hWp_le_W y₀ (u_seq n) (hu_seq n).2.1
        have hW_um_ub : W (u_seq m) ≤ W s := hW_mono hum_le
        have hW_un_ub : W (u_seq n) ≤ W s := hW_mono hun_le
        rw [Real.dist_eq]
        rcases le_total (u_seq m) (u_seq n) with hmn | hnm
        · have h_lip := hW_lip_E (u_seq m) (hu_seq m).1 (u_seq n) (hu_seq n).1 hmn
          rw [abs_sub_comm] at h_lip
          linarith
        · have h_lip := hW_lip_E (u_seq n) (hu_seq n).1 (u_seq m) (hu_seq m).1 hnm
          linarith
      obtain ⟨L, hL_lim⟩ := cauchySeq_tendsto_of_complete h_cauchy
      have hL_nn : 0 ≤ L :=
        ge_of_tendsto' hL_lim (fun n => (hg_bds (u_seq n)).1)
      have hL_le : L ≤ M :=
        le_of_tendsto' hL_lim (fun n => (hg_bds (u_seq n)).2)
      have hL_osc : ∀ u ∈ E, y₀ < u → |g u - L| ≤ W u - W_plus y₀ := by
        intro u huE hy₀_u
        have huy_pos : 0 < u - y₀ := sub_pos.mpr hy₀_u
        obtain ⟨N₀, hN₀⟩ := exists_nat_gt (δ₀ / (u - y₀))
        have h_ev : ∀ᶠ n : ℕ in Filter.atTop, |g u - g (u_seq n)| ≤ W u - W_plus y₀ := by
          rw [Filter.eventually_atTop]
          refine ⟨N₀, fun n hn => ?_⟩
          have hn1_pos : (0 : ℝ) < (n : ℝ) + 1 := by positivity
          have h_div : δ₀ / ((n : ℝ) + 1) < u - y₀ := by
            rw [div_lt_iff₀ hn1_pos]
            have h1 : δ₀ < (N₀ : ℝ) * (u - y₀) := (div_lt_iff₀ huy_pos).mp hN₀
            have h2 : (N₀ : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn
            nlinarith
          have hun_le : u_seq n ≤ u := by linarith [(hu_seq n).2.2]
          have h_lip := hW_lip_E (u_seq n) (hu_seq n).1 u huE hun_le
          have h_lb := hWp_le_W y₀ (u_seq n) (hu_seq n).2.1
          linarith
        exact le_of_tendsto ((tendsto_const_nhds.sub hL_lim).abs) h_ev
      
      have h_avg_lim : Filter.Tendsto
          (fun m : ℕ => ((m : ℝ) + 1) * ∫ τ in (0 : ℝ)..((m : ℝ) + 1)⁻¹, g (y₀ + τ))
          Filter.atTop (nhds L) := by
        rw [Metric.tendsto_atTop]
        intro ε hε
        obtain ⟨s, hs_gt, hs_lt⟩ := hWp_approx y₀ (ε / 2) (half_pos hε)
        let δ : ℝ := min ((s - y₀) / 2) ((a_hi - y₀) / 2)
        have hδ_pos : 0 < δ := lt_min (by linarith) (by linarith [hy₀.2])
        have hyδ_lt_s : y₀ + δ < s := by
          have : δ ≤ (s - y₀) / 2 := min_le_left _ _
          linarith
        have hyδ_lt_ahi : y₀ + δ < a_hi := by
          have : δ ≤ (a_hi - y₀) / 2 := min_le_right _ _
          linarith [hy₀.2]
        have hW_δ : W (y₀ + δ) - W_plus y₀ < ε / 2 := by
          have := hW_mono hyδ_lt_s.le
          linarith
        obtain ⟨M₀, hM₀⟩ := exists_nat_gt (1 / δ)
        refine ⟨M₀, fun m hm => ?_⟩
        let h_m : ℝ := ((m : ℝ) + 1)⁻¹
        have hm1_pos : (0 : ℝ) < (m : ℝ) + 1 := by positivity
        have hh_m_pos : 0 < h_m := inv_pos.mpr hm1_pos
        have hh_m_le_δ : h_m ≤ δ := by
          dsimp only [h_m]
          rw [inv_eq_one_div, div_le_iff₀ hm1_pos]
          have h1 : 1 < (M₀ : ℝ) * δ := (div_lt_iff₀ hδ_pos).mp hM₀
          have h2 : (M₀ : ℝ) ≤ (m : ℝ) := by exact_mod_cast hm
          nlinarith
        have hg_shift_ii : IntervalIntegrable (fun τ : ℝ => g (y₀ + τ))
            MeasureTheory.volume 0 h_m := by
          refine ⟨?_, ?_⟩
          · exact h_int_Ioc_of_bdd 0 h_m M (fun τ => g (y₀ + τ))
              (hg_meas.comp (measurable_const.add measurable_id))
              (fun τ => by
                rw [abs_of_nonneg (hg_bds (y₀ + τ)).1]
                exact (hg_bds (y₀ + τ)).2)
          · rw [MeasureTheory.IntegrableOn, Set.Ioc_eq_empty (not_lt.mpr hh_m_pos.le),
              MeasureTheory.Measure.restrict_empty]
            exact MeasureTheory.integrable_zero_measure
        have h_diff_eq : ((m : ℝ) + 1) * (∫ τ in (0 : ℝ)..h_m, g (y₀ + τ)) - L =
            ((m : ℝ) + 1) * ∫ τ in (0 : ℝ)..h_m, (g (y₀ + τ) - L) := by
          rw [intervalIntegral.integral_sub hg_shift_ii intervalIntegrable_const,
            intervalIntegral.integral_const, smul_eq_mul, sub_zero, mul_sub, ← mul_assoc]
          have h_cancel : ((m : ℝ) + 1) * h_m = 1 := mul_inv_cancel₀ hm1_pos.ne'
          rw [h_cancel, one_mul]
        have h_shift_ae : ∀ᵐ τ : ℝ, y₀ + τ ∈ Set.Ioo a_lo a_hi → y₀ + τ ∈ E :=
          (MeasureTheory.quasiMeasurePreserving_add_left MeasureTheory.volume y₀).ae hE_ae
        have h_ae_bd : ∀ᵐ τ : ℝ, τ ∈ Set.uIoc 0 h_m →
            ‖g (y₀ + τ) - L‖ ≤ W (y₀ + δ) - W_plus y₀ := by
          filter_upwards [h_shift_ae] with τ hτ hτ_mem
          rw [Set.uIoc_of_le hh_m_pos.le] at hτ_mem
          have hτ_gt : 0 < τ := hτ_mem.1
          have hτ_le : τ ≤ δ := le_trans hτ_mem.2 hh_m_le_δ
          have hyτ_ab : y₀ + τ ∈ Set.Ioo a_lo a_hi :=
            ⟨by linarith [hy₀.1], by linarith⟩
          have hyτ_E : y₀ + τ ∈ E := hτ hyτ_ab
          have h_osc := hL_osc (y₀ + τ) hyτ_E (by linarith)
          have hW_le := hW_mono (by linarith : y₀ + τ ≤ y₀ + δ)
          rw [Real.norm_eq_abs]
          linarith
        have h_int_bd := intervalIntegral.norm_integral_le_of_norm_le_const_ae h_ae_bd
        rw [Real.norm_eq_abs, sub_zero, abs_of_pos hh_m_pos] at h_int_bd
        rw [Real.dist_eq, h_diff_eq, abs_mul, abs_of_pos hm1_pos]
        have h_mul := mul_le_mul_of_nonneg_left h_int_bd hm1_pos.le
        have h_cancel : ((m : ℝ) + 1) * ((W (y₀ + δ) - W_plus y₀) * h_m) =
            W (y₀ + δ) - W_plus y₀ := by
          have hc : ((m : ℝ) + 1) * h_m = 1 := mul_inv_cancel₀ hm1_pos.ne'
          calc ((m : ℝ) + 1) * ((W (y₀ + δ) - W_plus y₀) * h_m)
              = (W (y₀ + δ) - W_plus y₀) * (((m : ℝ) + 1) * h_m) := by ring
            _ = W (y₀ + δ) - W_plus y₀ := by rw [hc, mul_one]
        linarith
      have h_clamp_cont : Continuous (fun z : ℝ => max (0 : ℝ) (min M z)) :=
        continuous_const.max (continuous_const.min continuous_id)
      have h_clamp_lim : Filter.Tendsto
          (fun m : ℕ => max (0 : ℝ)
            (min M (((m : ℝ) + 1) * ∫ τ in (0 : ℝ)..((m : ℝ) + 1)⁻¹, g (y₀ + τ))))
          Filter.atTop (nhds L) := by
        have h1 := (h_clamp_cont.continuousAt (x := L)).tendsto.comp h_avg_lim
        have h_clamp_L : max (0 : ℝ) (min M L) = L := by
          rw [min_eq_right hL_le, max_eq_right hL_nn]
        rwa [h_clamp_L] at h1
      have h_eq_L : rightSteklov g y₀ = L := by
        rw [h_rs_def]
        exact h_clamp_lim.limsup_eq
      rw [h_eq_L]
      exact hL_osc
    
    refine ⟨?_, ?_⟩
    · intro y₀ hy₀
      rw [Metric.tendsto_nhdsWithin_nhds]
      intro ε hε
      obtain ⟨s, hs_gt, hs_lt⟩ := hWp_approx y₀ (ε / 3) (by positivity)
      let t : ℝ := min s ((y₀ + a_hi) / 2)
      have hy₀_t : y₀ < t := lt_min hs_gt (by linarith [hy₀.2])
      have ht_ahi : t < a_hi :=
        lt_of_le_of_lt (min_le_right _ _) (by linarith [hy₀.2])
      have hW_t : W t - W_plus y₀ < ε / 3 := by
        have := hW_mono (min_le_left s ((y₀ + a_hi) / 2))
        linarith
      refine ⟨t - y₀, sub_pos.mpr hy₀_t, fun y hy_gt hy_dist => ?_⟩
      rw [Set.mem_Ioi] at hy_gt
      rw [Real.dist_eq, abs_of_pos (sub_pos.mpr hy_gt)] at hy_dist
      have hy_lt_t : y < t := by linarith
      have hy_ab : y ∈ Set.Ioo a_lo a_hi :=
        ⟨lt_trans hy₀.1 hy_gt, lt_trans hy_lt_t ht_ahi⟩
      obtain ⟨u, huE, hu_yt⟩ := hE_dense y t hy_ab.1.le hy_lt_t ht_ahi.le
      have h_osc0 := h_master y₀ hy₀ u huE (lt_trans hy_gt hu_yt.1)
      have h_oscy := h_master y hy_ab u huE hu_yt.1
      have hW_u_t : W u ≤ W t := hW_mono hu_yt.2.le
      have hWp_0y : W_plus y₀ ≤ W_plus y := hWp_mono hy_gt.le
      rw [Real.dist_eq]
      have h_tri : |rightSteklov g y - rightSteklov g y₀| ≤
          |g u - rightSteklov g y| + |g u - rightSteklov g y₀| := by
        calc |rightSteklov g y - rightSteklov g y₀|
            = |(g u - rightSteklov g y₀) - (g u - rightSteklov g y)| := by ring_nf
          _ ≤ |g u - rightSteklov g y₀| + |g u - rightSteklov g y| := abs_sub _ _
          _ = |g u - rightSteklov g y| + |g u - rightSteklov g y₀| := add_comm _ _
      linarith
    · have h_cont_ae : ∀ᵐ y : ℝ, ContinuousAt W y := by
        have h_cnt := hW_mono.countable_not_continuousAt
        filter_upwards [h_cnt.ae_notMem MeasureTheory.volume] with y hy_not
        exact not_not.mp hy_not
      filter_upwards [hE_ae, h_cont_ae] with y₀ hy₀_E hy₀_cont hy₀_ab
      have hy₀_in_E : y₀ ∈ E := hy₀_E hy₀_ab
      by_contra h_ne
      have h_pos : 0 < |g y₀ - rightSteklov g y₀| :=
        abs_pos.mpr (sub_ne_zero.mpr h_ne)
      let ε : ℝ := |g y₀ - rightSteklov g y₀|
      obtain ⟨δ, hδ_pos, hδ_cont⟩ :=
        Metric.continuousAt_iff.mp hy₀_cont (ε / 3) (by positivity)
      let t : ℝ := min (y₀ + δ / 2) ((y₀ + a_hi) / 2)
      have hy₀_t : y₀ < t := lt_min (by linarith) (by linarith [hy₀_ab.2])
      have ht_ahi : t ≤ a_hi :=
        le_trans (min_le_right _ _) (by linarith [hy₀_ab.2])
      have ht_dist : dist t y₀ < δ := by
        rw [Real.dist_eq, abs_of_pos (sub_pos.mpr hy₀_t)]
        have : t ≤ y₀ + δ / 2 := min_le_left _ _
        linarith
      have hW_t : W t - W y₀ < ε / 3 := by
        have h1 := hδ_cont ht_dist
        rw [Real.dist_eq] at h1
        exact lt_of_le_of_lt (le_abs_self _) h1
      obtain ⟨u, huE, hu_yt⟩ := hE_dense y₀ t hy₀_ab.1.le hy₀_t ht_ahi
      have h_lip_y₀ := hW_lip_E y₀ hy₀_in_E u huE hu_yt.1.le
      have h_osc_y₀ := h_master y₀ hy₀_ab u huE hu_yt.1
      have hW_u_t : W u ≤ W t := hW_mono hu_yt.2.le
      have hW_y₀_Wp : W y₀ ≤ W_plus y₀ := hW_le_Wp y₀
      have h_tri : ε ≤ |g u - g y₀| + |g u - rightSteklov g y₀| := by
        dsimp only [ε]
        calc |g y₀ - rightSteklov g y₀|
            = |(g u - rightSteklov g y₀) - (g u - g y₀)| := by ring_nf
          _ ≤ |g u - rightSteklov g y₀| + |g u - g y₀| := abs_sub _ _
          _ = |g u - g y₀| + |g u - rightSteklov g y₀| := add_comm _ _
      linarith

  
  let F_plus : ℝ × ℝ → ℝ := fun xy => rightSteklov (fun y => F (xy.1, y)) xy.2
  let F_refl : ℝ × ℝ → ℝ := fun xy => F (xy.1, -xy.2)
  let F_minus : ℝ × ℝ → ℝ := fun xy => rightSteklov (fun u => F_refl (xy.1, u)) (-xy.2)
  have hΨ_meas : Measurable (fun xy : ℝ × ℝ => (xy.1, -xy.2)) :=
    measurable_fst.prodMk measurable_snd.neg
  obtain ⟨hFp_meas, hFp_bds⟩ := h_stage1 F hF_meas
  obtain ⟨hG_refl_meas, hG_refl_bds⟩ := h_stage1 F_refl (hF_meas.comp hΨ_meas)
  have hFm_meas : Measurable F_minus := hG_refl_meas.comp hΨ_meas
  refine ⟨F_minus, F_plus, hFm_meas, hFp_meas,
    fun xy => ⟨(hG_refl_bds (xy.1, -xy.2)).1, (hG_refl_bds (xy.1, -xy.2)).2,
      (hFp_bds xy).1, (hFp_bds xy).2⟩, ?_⟩
  filter_upwards [h_stage2] with x hx_slice hx_mem
  obtain ⟨B, E, hB_nn, hE_sub, hE_ae, hE_var⟩ := hx_slice hx_mem
  
  have hg_plus_meas : Measurable (fun y : ℝ => F (x, y)) :=
    hF_meas.comp (measurable_const.prodMk measurable_id)
  obtain ⟨hFp_rc, hFp_ae⟩ := h_stage3 y_lo y_hi B hy hB_nn
    (fun y => F (x, y)) hg_plus_meas (fun y => hF_bds (x, y)) E hE_sub hE_ae hE_var
  
  let g_refl : ℝ → ℝ := fun u => F (x, -u)
  let E_refl : Set ℝ := { u : ℝ | -u ∈ E }
  have hg_refl_meas : Measurable g_refl :=
    hF_meas.comp (measurable_const.prodMk measurable_id.neg)
  have hE_refl_sub : E_refl ⊆ Set.Ioo (-y_hi) (-y_lo) := by
    intro u hu
    have h_in := hE_sub hu
    exact ⟨neg_lt.mp h_in.2, lt_neg.mp h_in.1⟩
  have hE_refl_ae : ∀ᵐ u : ℝ, u ∈ Set.Ioo (-y_hi) (-y_lo) → u ∈ E_refl := by
    have h_neg := (MeasureTheory.Measure.measurePreserving_neg
      MeasureTheory.volume).quasiMeasurePreserving.ae hE_ae
    filter_upwards [h_neg] with u hu_imp hu_ioo
    exact hu_imp ⟨lt_neg.mp hu_ioo.2, neg_lt.mp hu_ioo.1⟩
  have hE_refl_var : ∀ (N : ℕ) (u : ℕ → ℝ), Monotone u → (∀ i ≤ N, u i ∈ E_refl) →
      (∑ i ∈ Finset.range N, |g_refl (u (i + 1)) - g_refl (u i)|) ≤ B := by
    intro N u hu_mono hu_E
    cases N with
    | zero => simp [hB_nn]
    | succ M_n =>
      let N' : ℕ := M_n + 1
      let v : ℕ → ℝ := fun j => if j ≤ N' then -u (N' - j) else -u 0
      have hv_mono : Monotone v := by
        intro i j hij
        dsimp only [v]
        split_ifs with hi hj hj
        · exact neg_le_neg (hu_mono (by omega))
        · exact neg_le_neg (hu_mono (Nat.zero_le _))
        · omega
        · exact le_rfl
      have hv_E : ∀ j ≤ N', v j ∈ E := by
        intro j hj
        dsimp only [v]
        simp only [hj, ↓reduceIte]
        exact hu_E (N' - j) (by omega)
      have h_rev : (∑ i ∈ Finset.range N', |g_refl (u (i + 1)) - g_refl (u i)|) =
          ∑ j ∈ Finset.range N', |F (x, v (j + 1)) - F (x, v j)| := by
        rw [← Finset.sum_range_reflect (fun i => |g_refl (u (i + 1)) - g_refl (u i)|) N']
        refine Finset.sum_congr rfl (fun j hj => ?_)
        have hj_lt : j < N' := Finset.mem_range.mp hj
        have hj0 : j ≤ N' := Nat.le_of_lt hj_lt
        have hj1 : j + 1 ≤ N' := hj_lt
        have h_idx1 : N' - 1 - j + 1 = N' - j := by omega
        have h_idx0 : N' - 1 - j = N' - (j + 1) := by omega
        dsimp only [g_refl, v]
        simp only [hj1, hj0, ↓reduceIte]
        rw [h_idx1, h_idx0, abs_sub_comm]
      change (∑ i ∈ Finset.range N', |g_refl (u (i + 1)) - g_refl (u i)|) ≤ B
      rw [h_rev]
      exact hE_var N' v hv_mono hv_E
  obtain ⟨hGr_rc, hGr_ae⟩ := h_stage3 (-y_hi) (-y_lo) B (neg_lt_neg hy) hB_nn
    g_refl hg_refl_meas (fun u => hF_bds (x, -u)) E_refl hE_refl_sub hE_refl_ae hE_refl_var
  have hFm_lc : ∀ y₀ ∈ Set.Ioo y_lo y_hi,
      Filter.Tendsto (fun y => F_minus (x, y)) (nhdsWithin y₀ (Set.Iio y₀))
        (nhds (F_minus (x, y₀))) := by
    intro y₀ hy₀
    have h_ny₀ : -y₀ ∈ Set.Ioo (-y_hi) (-y_lo) := ⟨neg_lt_neg hy₀.2, neg_lt_neg hy₀.1⟩
    have h_rc_at := hGr_rc (-y₀) h_ny₀
    have h_neg_nhds : Filter.Tendsto (fun y : ℝ => -y)
        (nhdsWithin y₀ (Set.Iio y₀)) (nhdsWithin (-y₀) (Set.Ioi (-y₀))) :=
      tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within _
        continuous_neg.continuousWithinAt
        (eventually_nhdsWithin_of_forall (fun y (hy_lt : y < y₀) => neg_lt_neg hy_lt))
    exact h_rc_at.comp h_neg_nhds
  have hFm_ae : ∀ᵐ y : ℝ, y ∈ Set.Ioo y_lo y_hi → F (x, y) = F_minus (x, y) := by
    have h_neg_ae := (MeasureTheory.Measure.measurePreserving_neg
      MeasureTheory.volume).quasiMeasurePreserving.ae hGr_ae
    filter_upwards [h_neg_ae] with y hy_imp hy_ioo
    have h_ny : -y ∈ Set.Ioo (-y_hi) (-y_lo) := ⟨neg_lt_neg hy_ioo.2, neg_lt_neg hy_ioo.1⟩
    have h_eq := hy_imp h_ny
    simpa [g_refl, F_minus, F_refl] using h_eq
  refine ⟨hFp_rc, hFm_lc, ?_⟩
  filter_upwards [hFp_ae, hFm_ae] with y hyp hym hy_ioo
  exact ⟨hyp hy_ioo, hym hy_ioo⟩

theorem onesided_slice_lipschitz_graph_traces (x_lo x_hi y_lo y_hi M : ℝ)
    (hx : x_lo < x_hi) (hy : y_lo < y_hi) (hM : 0 ≤ M)
    (F F_minus F_plus : ℝ × ℝ → ℝ)
    (hF_meas : Measurable F) (hFm_meas : Measurable F_minus) (hFp_meas : Measurable F_plus)
    (hF_bds : ∀ xy : ℝ × ℝ, 0 ≤ F xy ∧ F xy ≤ M)
    (hFmp_bds : ∀ xy : ℝ × ℝ,
      0 ≤ F_minus xy ∧ F_minus xy ≤ M ∧ 0 ≤ F_plus xy ∧ F_plus xy ≤ M)
    (h_slices : ∀ᵐ x : ℝ, x ∈ Set.Ioo x_lo x_hi →
      (∀ y₀ ∈ Set.Ioo y_lo y_hi,
        Filter.Tendsto (fun y => F_plus (x, y)) (nhdsWithin y₀ (Set.Ioi y₀))
          (nhds (F_plus (x, y₀)))) ∧
      (∀ y₀ ∈ Set.Ioo y_lo y_hi,
        Filter.Tendsto (fun y => F_minus (x, y)) (nhdsWithin y₀ (Set.Iio y₀))
          (nhds (F_minus (x, y₀)))) ∧
      (∀ᵐ y : ℝ, y ∈ Set.Ioo y_lo y_hi →
        F (x, y) = F_plus (x, y) ∧ F (x, y) = F_minus (x, y)))
    (h : ℝ → ℝ) (L_h : ℝ) (hL_h : 0 ≤ L_h)
    (hh_lip : ∀ x₁ x₂ : ℝ, |h x₁ - h x₂| ≤ L_h * |x₁ - x₂|) :
    ∀ᵐ x₀ : ℝ, x₀ ∈ Set.Ioo x_lo x_hi → h x₀ ∈ Set.Ioo y_lo y_hi →
      ∃ q : ℝ,
        HasDerivAt h q x₀ ∧
        HasTangentBoxTrace (fun yx => F (yx.2, yx.1)) (h x₀) x₀ (-q)
          (F_minus (x₀, h x₀)) (F_plus (x₀, h x₀)) :=
by
  have h_ii : ∀ (φ : ℝ → ℝ) (B a b : ℝ),
      a ≤ b → Measurable φ → (∀ t : ℝ, 0 ≤ φ t ∧ φ t ≤ B) →
      IntervalIntegrable φ MeasureTheory.volume a b := by
    intro φ B a b hab hφ_meas hφ_bds
    rw [intervalIntegrable_iff_integrableOn_Ioc_of_le hab]
    have : MeasureTheory.IsFiniteMeasure (MeasureTheory.volume.restrict (Set.Ioc a b)) :=
      ⟨by simp [Real.volume_Ioc]⟩
    exact MeasureTheory.Integrable.of_mem_Icc 0 B hφ_meas.aemeasurable
      (Filter.Eventually.of_forall hφ_bds)

  have h_leb_1d : ∀ (g : ℝ → ℝ),
      Measurable g → (∀ x : ℝ, 0 ≤ g x ∧ g x ≤ M) →
      ∀ᵐ x₀ : ℝ,
        Filter.Tendsto (fun ρ : ℝ =>
          ρ⁻¹ * ∫ x in (x₀ - ρ)..(x₀ + ρ), |g x - g x₀|)
          (nhdsWithin 0 (Set.Ioi 0)) (nhds 0) := by
    intro g hg_meas hg_bds
    have h_mem : MeasureTheory.MemLp g ⊤ MeasureTheory.volume :=
      MeasureTheory.memLp_top_of_bound hg_meas.aestronglyMeasurable M
        (Filter.Eventually.of_forall (fun x => by
          rw [Real.norm_eq_abs, abs_of_nonneg (hg_bds x).1]
          exact (hg_bds x).2))
    have h_loc : MeasureTheory.LocallyIntegrable g MeasureTheory.volume :=
      h_mem.locallyIntegrable le_top
    filter_upwards [IsUnifLocDoublingMeasure.ae_tendsto_average_norm_sub
      (μ := MeasureTheory.volume) h_loc 1] with x₀ hx₀_leb
    have h_avg : Filter.Tendsto (fun ρ : ℝ =>
        ⨍ x in Metric.closedBall x₀ ρ, ‖g x - g x₀‖ ∂MeasureTheory.volume)
        (nhdsWithin 0 (Set.Ioi 0)) (nhds 0) := by
      refine hx₀_leb (fun _ => x₀) id Filter.tendsto_id ?_
      filter_upwards [self_mem_nhdsWithin] with ρ (hρ : 0 < ρ)
      simp only [one_mul, id_eq]
      exact Metric.mem_closedBall_self hρ.le
    have h_mul := h_avg.const_mul (2 : ℝ)
    rw [mul_zero] at h_mul
    refine h_mul.congr' ?_
    filter_upwards [self_mem_nhdsWithin] with ρ (hρ : 0 < ρ)
    rw [MeasureTheory.setAverage_eq, smul_eq_mul, Real.closedBall_eq_Icc,
      MeasureTheory.Measure.real, Real.volume_Icc,
      MeasureTheory.integral_Icc_eq_integral_Ioc,
      ← intervalIntegral.integral_of_le (by linarith : x₀ - ρ ≤ x₀ + ρ)]
    have h_diff : (x₀ + ρ) - (x₀ - ρ) = 2 * ρ := by ring
    rw [h_diff, ENNReal.toReal_ofReal (by positivity : (0 : ℝ) ≤ 2 * ρ)]
    have h_int_eq : (∫ x in (x₀ - ρ)..(x₀ + ρ), ‖g x - g x₀‖) =
        ∫ x in (x₀ - ρ)..(x₀ + ρ), |g x - g x₀| := by rfl
    rw [h_int_eq, ← mul_assoc]
    have h2ρ : (2 : ℝ) * (2 * ρ)⁻¹ = ρ⁻¹ := by
      field_simp [hρ.ne']
    rw [h2ρ]

  have h_right_mod : ∀ (y₁ y₂ : ℝ) (G G_p : ℝ × ℝ → ℝ) (f_h : ℝ → ℝ),
      Measurable G_p →
      (∀ xy : ℝ × ℝ, 0 ≤ G_p xy ∧ G_p xy ≤ M) →
      Continuous f_h →
      ∃ Ω : ℕ → ℝ → ℝ,
        (∀ k : ℕ, Measurable (Ω k) ∧ ∀ x : ℝ, 0 ≤ Ω k x ∧ Ω k x ≤ M) ∧
        (∀ x : ℝ,
          (∀ y₀ ∈ Set.Ioo y₁ y₂,
            Filter.Tendsto (fun y => G_p (x, y)) (nhdsWithin y₀ (Set.Ioi y₀))
              (nhds (G_p (x, y₀)))) →
          (f_h x ∈ Set.Ioo y₁ y₂ →
            Filter.Tendsto (fun k : ℕ => Ω k x) Filter.atTop (nhds 0)) ∧
          ((∀ᵐ y : ℝ, y ∈ Set.Ioo y₁ y₂ → G (x, y) = G_p (x, y)) →
            ∀ k : ℕ, ∀ᵐ y : ℝ,
              y ∈ Set.Ioo y₁ y₂ →
              f_h x < y → y < f_h x + ((k : ℝ) + 1)⁻¹ →
                |G (x, y) - G_p (x, f_h x)| ≤ Ω k x)) := by
    intro y₁ y₂ G G_p f_h hGp_meas hGp_bds hf_cont
    let P : ℕ → ℚ → Set ℝ := fun k q =>
      { x : ℝ | f_h x < (q : ℝ) } ∩
      ({ x : ℝ | (q : ℝ) < f_h x + ((k : ℝ) + 1)⁻¹ } ∩
       ({ x : ℝ | y₁ < (q : ℝ) } ∩ { x : ℝ | (q : ℝ) < y₂ }))
    let ψ : ℕ → ℚ → ℝ → ℝ := fun k q =>
      Set.indicator (P k q) (fun x => |G_p (x, (q : ℝ)) - G_p (x, f_h x)|)
    let Ω : ℕ → ℝ → ℝ := fun k x => ⨆ q : ℚ, ψ k q x
    have hP_meas : ∀ (k : ℕ) (q : ℚ), MeasurableSet (P k q) := by
      intro k q
      refine IsOpen.measurableSet ?_
      exact (isOpen_lt hf_cont continuous_const).inter
        ((isOpen_lt continuous_const (hf_cont.add continuous_const)).inter
          ((isOpen_lt continuous_const continuous_const).inter
            (isOpen_lt continuous_const continuous_const)))
    have hψ_meas : ∀ (k : ℕ) (q : ℚ), Measurable (ψ k q) := by
      intro k q
      refine Measurable.indicator ?_ (hP_meas k q)
      exact ((hGp_meas.comp (measurable_id.prodMk measurable_const)).sub
        (hGp_meas.comp (measurable_id.prodMk hf_cont.measurable))).abs
    have hψ_bds : ∀ (k : ℕ) (q : ℚ) (x : ℝ), 0 ≤ ψ k q x ∧ ψ k q x ≤ M := by
      intro k q x
      by_cases hxq : x ∈ P k q
      · dsimp only [ψ]
        rw [Set.indicator_of_mem hxq]
        have h1 := hGp_bds (x, (q : ℝ))
        have h2 := hGp_bds (x, f_h x)
        exact ⟨abs_nonneg _, abs_le.mpr ⟨by linarith, by linarith⟩⟩
      · dsimp only [ψ]
        rw [Set.indicator_of_notMem hxq]
        exact ⟨le_rfl, hM⟩
    have hψ_bdd : ∀ (k : ℕ) (x : ℝ), BddAbove (Set.range (fun q : ℚ => ψ k q x)) := by
      intro k x
      refine ⟨M, ?_⟩
      rintro _ ⟨q, rfl⟩
      exact (hψ_bds k q x).2
    have hΩ_reg : ∀ k : ℕ, Measurable (Ω k) ∧ ∀ x : ℝ, 0 ≤ Ω k x ∧ Ω k x ≤ M := by
      intro k
      refine ⟨Measurable.iSup (fun q => hψ_meas k q), fun x => ?_⟩
      refine ⟨le_trans (hψ_bds k 0 x).1 (le_ciSup (hψ_bdd k x) (0 : ℚ)), ?_⟩
      exact ciSup_le (fun q => (hψ_bds k q x).2)
    refine ⟨Ω, hΩ_reg, fun x h_rc => ⟨?_, ?_⟩⟩
    · intro hfx_mem
      rw [Metric.tendsto_atTop]
      intro ε hε
      obtain ⟨δ, hδ_pos, hδ⟩ :=
        Metric.tendsto_nhdsWithin_nhds.mp (h_rc (f_h x) hfx_mem) (ε / 2) (half_pos hε)
      obtain ⟨K₀, hK₀⟩ := exists_nat_gt δ⁻¹
      refine ⟨K₀, fun k hk => ?_⟩
      have hk_pos : (0 : ℝ) < (k : ℝ) + 1 := by positivity
      have hk_gt : δ⁻¹ < (k : ℝ) + 1 := by
        have hk_cast : (K₀ : ℝ) ≤ (k : ℝ) := Nat.cast_le.mpr hk
        linarith
      have hk_inv_lt : ((k : ℝ) + 1)⁻¹ < δ := by
        rwa [inv_lt_comm₀ hk_pos hδ_pos]
      have hΩ_le : Ω k x ≤ ε / 2 := by
        refine ciSup_le (fun q => ?_)
        by_cases hxq : x ∈ P k q
        · have hq1 : f_h x < (q : ℝ) := hxq.1
          have hq2 : (q : ℝ) < f_h x + ((k : ℝ) + 1)⁻¹ := hxq.2.1
          have hq_dist : dist (q : ℝ) (f_h x) < δ := by
            rw [Real.dist_eq, abs_of_pos (sub_pos.mpr hq1)]
            linarith
          have hG_lt : dist (G_p (x, (q : ℝ))) (G_p (x, f_h x)) < ε / 2 :=
            hδ hq1 hq_dist
          rw [Real.dist_eq] at hG_lt
          dsimp only [ψ]
          rw [Set.indicator_of_mem hxq]
          exact hG_lt.le
        · dsimp only [ψ]
          rw [Set.indicator_of_notMem hxq]
          linarith
      rw [Real.dist_eq, sub_zero, abs_of_nonneg ((hΩ_reg k).2 x).1]
      linarith
    · intro h_ae k
      filter_upwards [h_ae] with y hy hy_mem h_gt h_lt
      rw [hy hy_mem]
      refine le_of_forall_pos_lt_add (fun η hη => ?_)
      obtain ⟨δ_y, hδy_pos, hδy⟩ :=
        Metric.tendsto_nhdsWithin_nhds.mp (h_rc y hy_mem) η hη
