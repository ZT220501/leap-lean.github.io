        (1 + γ) * b₀ + (1 - γ) * a₀ := by
      rw [← Finset.sum_mul]
      have hsum_G : ∑ g : Fin N_G, p_G g = 1 := by
        dsimp [p_G]
        rw [Finset.sum_comm]
        simp [hQ_sum]
