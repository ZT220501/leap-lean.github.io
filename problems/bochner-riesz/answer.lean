      have h_den_le_4 : 1 + Δ_τ / s ≤ 4 * (|inner ℝ (v - v') τ_P| / s) := by
        have h_div_ge20 : 20 ≤ Δ_τ / s := (le_div_iff₀ hs).mpr (by nlinarith [hM_cut_ge20, hs, h_sep])
        have h_div_half : (1 / 2 : ℝ) * (Δ_τ / s) ≤ |inner ℝ (v - v') τ_P| / s := by
          have h1 := div_le_div_of_nonneg_right h_half_Δ hs.le
          have h_id : (1 / 2 : ℝ) * Δ_τ / s = (1 / 2 : ℝ) * (Δ_τ / s) := by ring
          linarith
        linarith
      have h_L_lo : (a₀ / (8 * B_cell)) * (1 + Δ_τ / s) ≤ L := by
        have h_pos_fac : 0 < a₀ / (8 * B_cell) := by positivity
        have h1 := mul_le_mul_of_nonneg_left h_den_le_4 h_pos_fac.le
        have h_id : (a₀ / (8 * B_cell)) * (4 * (|inner ℝ (v - v') τ_P| / s)) = L := by
          dsimp only [L]; ring
        linarith
      have h_lo_pos : 0 < (a₀ / (8 * B_cell)) * (1 + Δ_τ / s) := by positivity
      have h_pow_lo : ((a₀ / (8 * B_cell)) * (1 + Δ_τ / s)) ^ 4 ≤ L ^ 4 :=
        pow_le_pow_left₀ h_lo_pos.le h_L_lo 4
      have h_B_ne : B_cell ≠ 0 := by linarith
      calc ‖∫ y : ℝ, (ω_tan y : ℂ) * Complex.exp (Complex.I * (Θ y : ℂ))‖
          = ‖∫ y : ℝ, (ω_tan y : ℂ) * Complex.exp (Complex.I * (θ_pos y : ℂ))‖ := h_norm_eq
        _ ≤ C_ibp / L ^ 4 := h_ibp_est
        _ ≤ C_ibp / ((a₀ / (8 * B_cell)) * (1 + Δ_τ / s)) ^ 4 :=
            div_le_div_of_nonneg_left hC_ibp_nn (pow_pos h_lo_pos 4) h_pow_lo
        _ = (C_ibp * (8 * B_cell / a₀) ^ 4) / (1 + Δ_τ / s) ^ 4 := by
            rw [mul_pow, div_pow, div_pow]
            field_simp [ha₀.ne', h_B_ne, h_den4_pos.ne']
        _ ≤ C_ker / (1 + Δ_τ / s) ^ 4 :=
            div_le_div_of_nonneg_right (le_max_right _ _) h_den4_pos.le
    · have h_div_le : Δ_τ / s ≤ M_cut := (div_le_iff₀ hs).mpr (le_of_not_ge h_sep)
      have h_pow_le : (1 + Δ_τ / s) ^ 4 ≤ (1 + M_cut) ^ 4 :=
        pow_le_pow_left₀ h_den_pos.le (by linarith) 4
      calc ‖∫ y : ℝ, (ω_tan y : ℂ) * Complex.exp (Complex.I * (Θ y : ℂ))‖
          ≤ 4 * B_cell + 2 := hω_triv Θ
        _ = ((4 * B_cell + 2) * (1 + Δ_τ / s) ^ 4) / (1 + Δ_τ / s) ^ 4 := by
            field_simp [h_den4_pos.ne']
        _ ≤ ((4 * B_cell + 2) * (1 + M_cut) ^ 4) / (1 + Δ_τ / s) ^ 4 := by
            refine div_le_div_of_nonneg_right ?_ h_den4_pos.le
            exact mul_le_mul_of_nonneg_left h_pow_le (by linarith)
        _ ≤ C_ker / (1 + Δ_τ / s) ^ 4 :=
            div_le_div_of_nonneg_right (le_max_left _ _) h_den4_pos.le
  have h_strip := h_fub Φ₀ hΦ₀_cont lam_loc ρ s c_end hlam hs hsρ hlam_hi
    x_Z n_P N_Q V_T X_T η_T c_T W M_ker hη_W hM_ker μ_mod hμ_cont hμ_le
  have h_quad := stepD_schur s M_fib C_ker hs hM_fib (by linarith [hC_ker_ge1])
    V_P τ_P N_Q V_T c_T W M_ker h_fib_W (fun _ _ _ _ => le_rfl)
  have h_pref_nn : 0 ≤ 8192 * B_cell * (B_cell + 1) * A_atom ^ 2 * (s / ρ) := by
    have hsρ_nn : 0 ≤ s / ρ := div_nonneg hs.le hρ.le
    positivity
  calc ((lam_loc * ρ)⁻¹)⁻¹ ^ 2 * ∫ p in
        Set.Icc (-(B_cell + 1) * (lam_loc * ρ)⁻¹) ((B_cell + 1) * (lam_loc * ρ)⁻¹) ×ˢ
          Set.Icc (-(2 * B_cell * s)) (2 * B_cell * s),
        ‖(ρ⁻¹ : ℂ) * ∫ v : EuclideanSpace ℝ (Fin 2),
          (∑ T ∈ W, c_T T *
            ((s⁻¹ : ℂ) * η_T T (s⁻¹ • (v - V_T T)) *
              Complex.exp (-(Complex.I * ((lam_loc * Φ₀ (1 / 2, X_T T, v) : ℝ) : ℂ))))) *
            μ_mod v *
            Complex.exp (Complex.I *
              ((lam_loc * Φ₀ (c_end, x_Z + p.1 • n_P + p.2 • perp2D n_P, v) : ℝ) : ℂ))‖ ^ 2
      ≤ 8192 * B_cell * (B_cell + 1) * A_atom ^ 2 * (s / ρ) *
          ∑ T₁ ∈ W, ∑ T₂ ∈ W, ‖c_T T₁‖ * ‖c_T T₂‖ * M_ker T₁ T₂ := h_strip
    _ ≤ 8192 * B_cell * (B_cell + 1) * A_atom ^ 2 * (s / ρ) *
          (48 * C_ker * M_fib * ∑ T ∈ W, ‖c_T T‖ ^ 2) :=
        mul_le_mul_of_nonneg_left h_quad h_pref_nn
    _ = C_tan * M_fib * (s / ρ) * ∑ T ∈ W, ‖c_T T‖ ^ 2 := by
        dsimp only [C_tan]
        ring

theorem coherent_strip_and_cell_mass_bound : CoherentStripMassBoundValid :=
by
  intro a₀ a₁ A B_cell R_win N_mult M_mult M_atom M_win ha₀ ha₁ hA hB hRw hN_mult hM_mult
  obtain ⟨h_pack_up, C_box, hC_box, h_tan_fib, h_cell2⟩ :=
    box_packing_and_isotropic_cell_bound B_cell R_win N_mult M_mult M_atom M_win
      hB hRw hN_mult hM_mult
  let N_syn_pack : ℕ := (2 * ⌈B_cell⌉₊ + 1) ^ 2 * M_mult
  have hN_syn_pack : 1 ≤ N_syn_pack :=
    Nat.succ_le_of_lt (Nat.mul_pos (pow_pos (by omega) 2) (by omega))
  obtain ⟨C_syn, hC_syn, h_bes_syn⟩ :=
    equal_time_packed_wave_packet_bessel a₀ a₁ A 4 N_syn_pack M_atom
      ha₀ ha₁ hA (by norm_num) hN_syn_pack
  obtain ⟨C_ana, hC_ana, h_bes_ana⟩ :=
    equal_time_packed_wave_packet_bessel a₀ a₁ A R_win N_mult M_win
      ha₀ ha₁ hA hRw hN_mult
  obtain ⟨C_dec, hC_dec, h_dec⟩ :=
    double_diff_fourier_strip_decoupling a₀ a₁ A B_cell R_win N_mult M_win
      ha₀ ha₁ hA hB hRw hN_mult
  obtain ⟨C_tan, hC_tan, h_tan⟩ :=
    single_bin_tangent_strip_gram_bound a₀ a₁ A B_cell M_atom ha₀ ha₁ hA hB
  let C_coh : ℝ := max (C_ana * C_syn) (max C_box (C_dec * C_tan * C_box))
  have hC_ana_syn : 1 ≤ C_ana * C_syn := by nlinarith
  have hC_coh_ge : 1 ≤ C_coh := le_trans hC_ana_syn (le_max_left _ _)
  have hC_ana_syn_le : C_ana * C_syn ≤ C_coh := le_max_left _ _
  have hC_box_le : C_box ≤ C_coh := le_trans (le_max_left _ _) (le_max_right _ _)
  have hC_prod_le : C_dec * C_tan * C_box ≤ C_coh :=
    le_trans (le_max_right _ _) (le_max_right _ _)
  refine ⟨C_coh, hC_coh_ge, ?_⟩
  intro Φ₀ ζ₀ h_phase lam_loc ρ s c_end R hlam hs hsρ hρ1 hlam_lo hlam_hi hc_end hR
    V_P X_Q n_P hn_P d_dim N_Q K N_obs hd_dim hK
    V_T X_T η_T c_T bin_of V_O X_O ψ_O h_fam
    σ h_Q m_obs
  obtain ⟨hT_reg, hT_pack, h_bin_loc, hO_reg, hO_pack⟩ := h_fam
  have hρ : 0 < ρ := lt_of_lt_of_le hs hsρ
  have hB_pos : 0 < B_cell := by linarith
  have hc_sum_nn : 0 ≤ ∑ T : Fin N_Q, ‖c_T T‖ ^ 2 :=
    Finset.sum_nonneg (fun _ _ => sq_nonneg _)
  constructor
  · have h_dual_s : (lam_loc * s)⁻¹ ≤ B_cell * s := by
      have h_inv_pos : 0 < B_cell⁻¹ := inv_pos.mpr hB_pos
      have h_inv_le : (lam_loc * s ^ 2)⁻¹ ≤ B_cell := by
        have h1 := (inv_le_inv₀ (lt_of_lt_of_le h_inv_pos hlam_lo) h_inv_pos).mpr hlam_lo
        rwa [inv_inv] at h1
      have h_eq : (lam_loc * s)⁻¹ = (lam_loc * s ^ 2)⁻¹ * s := by
        have hs_ne : s ≠ 0 := ne_of_gt hs
        have hlam_ne : lam_loc ≠ 0 := ne_of_gt hlam
        field_simp [hs_ne, hlam_ne]
      rw [h_eq]
      exact mul_le_mul_of_nonneg_right h_inv_le hs.le
    have hT_pack_syn :
        letI := Classical.propDecidable
        ∀ v₀ x₀ : EuclideanSpace ℝ (Fin 2),
          ((Finset.univ.filter (fun T : Fin N_Q =>
            ‖V_T T - v₀‖ ≤ s ∧ ‖X_T T - x₀‖ ≤ (lam_loc * s)⁻¹)).card : ℝ) ≤
            (N_syn_pack : ℝ) := by
      intro v₀ x₀
      refine le_trans (Nat.cast_le.mpr (Finset.card_le_card (fun T hT => ?_)))
        (h_pack_up s hs N_Q V_T X_T hT_pack v₀ x₀)
      simp only [Finset.mem_filter] at hT ⊢
      exact ⟨hT.1, hT.2.1, le_trans hT.2.2 h_dual_s⟩
    obtain ⟨hh_Q_meas, hh_Q_sq, hh_Q_l2⟩ :=
      (h_bes_syn Φ₀ ζ₀ h_phase lam_loc s (1 / 2)
        hlam hs (le_trans hsρ hρ1) ⟨by norm_num, by norm_num⟩
        N_Q V_T X_T η_T
        (fun T => ⟨(hT_reg T).1, (hT_reg T).2.1, (hT_reg T).2.2.1⟩)
        hT_pack_syn).1 c_T
    let w_O : Fin N_obs → EuclideanSpace ℝ (Fin 2) → ℂ :=
      fun o => ⇑Complex.conjLIE ∘ ψ_O o
    have hw_O_reg : ∀ o : Fin N_obs,
        (∀ k : ℕ, ContDiff ℝ k (w_O o)) ∧
        (∀ z : EuclideanSpace ℝ (Fin 2), R_win ≤ ‖z‖ → w_O o z = 0) ∧
        (∀ (k : ℕ) (z : EuclideanSpace ℝ (Fin 2)),
          ‖iteratedFDeriv ℝ k (w_O o) z‖ ≤ M_win k) := by
      intro o
      refine ⟨fun k => Complex.conjLIE.contDiff.comp ((hO_reg o).1 k), ?_, ?_⟩
      · intro z hz
        dsimp [w_O]
        rw [(hO_reg o).2.1 z hz]
        exact map_zero Complex.conjLIE
      · intro k z
        dsimp [w_O]
        rw [Complex.conjLIE.norm_iteratedFDeriv_comp_left (ψ_O o) z k]
        exact (hO_reg o).2.2.1 k z
    have hO_pack_ana :
        letI := Classical.propDecidable
        ∀ v₀ x₀ : EuclideanSpace ℝ (Fin 2),
          ((Finset.univ.filter (fun o : Fin N_obs =>
            ‖V_O o - v₀‖ ≤ ρ ∧ ‖X_O o - x₀‖ ≤ (lam_loc * ρ)⁻¹)).card : ℝ) ≤
            (N_mult : ℝ) := hO_pack
    have h_ana := (h_bes_ana Φ₀ ζ₀ h_phase lam_loc ρ c_end
      hlam hρ hρ1 hc_end N_obs V_O X_O w_O hw_O_reg hO_pack_ana).2
      h_Q hh_Q_meas hh_Q_sq
    have hm_obs_eq : ∀ o : Fin N_obs,
        m_obs o =
          ‖∫ v : EuclideanSpace ℝ (Fin 2), h_Q v *
            star ((ρ⁻¹ : ℂ) * w_O o (ρ⁻¹ • (v - V_O o)) *
              Complex.exp (-(Complex.I * ((lam_loc * Φ₀ (c_end, X_O o, v) : ℝ) : ℂ))))‖ ^ 2 := by
      intro o
      dsimp only [m_obs, w_O, Function.comp_apply]
      have h_int : (fun v : EuclideanSpace ℝ (Fin 2) => h_Q v *
            star ((ρ⁻¹ : ℂ) * Complex.conjLIE (ψ_O o (ρ⁻¹ • (v - V_O o))) *
              Complex.exp (-(Complex.I * ((lam_loc * Φ₀ (c_end, X_O o, v) : ℝ) : ℂ))))) =
          (fun v : EuclideanSpace ℝ (Fin 2) => (ρ⁻¹ : ℂ) *
            (h_Q v * ψ_O o (ρ⁻¹ • (v - V_O o)) *
              Complex.exp (Complex.I * ((lam_loc * Φ₀ (c_end, X_O o, v) : ℝ) : ℂ)))) := by
        ext v
        simp only [Complex.star_def, Complex.conjLIE_apply, map_mul, map_inv₀,
          Complex.conj_ofReal, RingHomCompTriple.comp_apply, RingHom.id_apply,
          ← Complex.exp_conj, map_neg, Complex.conj_I, neg_mul, neg_neg]
        ring
      rw [h_int, MeasureTheory.integral_const_mul]
    have h_sum_eq : ∑ o : Fin N_obs, m_obs o =
        ∑ o : Fin N_obs,
          ‖∫ v : EuclideanSpace ℝ (Fin 2), h_Q v *
            star ((ρ⁻¹ : ℂ) * w_O o (ρ⁻¹ • (v - V_O o)) *
              Complex.exp (-(Complex.I * ((lam_loc * Φ₀ (c_end, X_O o, v) : ℝ) : ℂ))))‖ ^ 2 :=
      Finset.sum_congr rfl (fun o _ => hm_obs_eq o)
    calc ∑ o : Fin N_obs, m_obs o
        ≤ C_ana * ∫ v : EuclideanSpace ℝ (Fin 2), ‖h_Q v‖ ^ 2 := by
          rw [h_sum_eq]
          exact h_ana
      _ ≤ C_ana * (C_syn * ∑ T : Fin N_Q, ‖c_T T‖ ^ 2) :=
          mul_le_mul_of_nonneg_left hh_Q_l2 (by linarith)
      _ = (C_ana * C_syn) * ∑ T : Fin N_Q, ‖c_T T‖ ^ 2 := by ring
      _ ≤ C_coh * ∑ T : Fin N_Q, ‖c_T T‖ ^ 2 :=
          mul_le_mul_of_nonneg_right hC_ana_syn_le hc_sum_nn
  · intro x_Z S_Z hS_Z
    have hΦ₀_cont : Continuous Φ₀ := (h_phase.1 0).continuous
    have hη_cont : ∀ T : Fin N_Q, Continuous (η_T T) :=
      fun T => ((hT_reg T).1 0).continuous
    have hη_max : ∀ T : Fin N_Q, ∀ z : EuclideanSpace ℝ (Fin 2),
        ‖η_T T z‖ ≤ max (M_atom 0) 1 := by
      intro T z
      calc ‖η_T T z‖ = ‖iteratedFDeriv ℝ 0 (η_T T) z‖ := (norm_iteratedFDeriv_zero).symm
        _ ≤ M_atom 0 := (hT_reg T).2.2.1 0 z
        _ ≤ max (M_atom 0) 1 := le_max_left _ _
    have hψ_cont : ∀ o : Fin N_obs, Continuous (ψ_O o) :=
      fun o => ((hO_reg o).1 0).continuous
    have hψ_max : ∀ o : Fin N_obs, ∀ z : EuclideanSpace ℝ (Fin 2),
        ‖ψ_O o z‖ ≤ max (M_win 0) 1 := by
      intro o z
      calc ‖ψ_O o z‖ = ‖iteratedFDeriv ℝ 0 (ψ_O o) z‖ := (norm_iteratedFDeriv_zero).symm
        _ ≤ M_win 0 := (hO_reg o).2.2.1 0 z
        _ ≤ max (M_win 0) 1 := le_max_left _ _
    rcases hd_dim with rfl | rfl
    · let W_b : Fin K → Finset (Fin N_Q) :=
        fun b => Finset.univ.filter (fun T : Fin N_Q => bin_of T = b)
      let g_T : Fin N_Q → EuclideanSpace ℝ (Fin 2) → ℂ := fun T v =>
        (s⁻¹ : ℂ) * η_T T (s⁻¹ • (v - V_T T)) *
          Complex.exp (-(Complex.I * ((lam_loc * Φ₀ (1 / 2, X_T T, v) : ℝ) : ℂ)))
      let h_Wb : Fin K → EuclideanSpace ℝ (Fin 2) → ℂ :=
        fun b v => ∑ T ∈ W_b b, c_T T * g_T T v
      let I_Wb : Fin K → Fin N_obs → ℂ := fun b o =>
        (ρ⁻¹ : ℂ) * ∫ v : EuclideanSpace ℝ (Fin 2),
          h_Wb b v * ψ_O o (ρ⁻¹ • (v - V_O o)) *
            Complex.exp (Complex.I * ((lam_loc * Φ₀ (c_end, X_O o, v) : ℝ) : ℂ))
      have hg_cont : ∀ T : Fin N_Q, Continuous (g_T T) := by
        intro T
        dsimp only [g_T]
        refine (continuous_const.mul ((hη_cont T).comp
          ((continuous_id.sub continuous_const).const_smul s⁻¹))).mul ?_
        refine Complex.continuous_exp.comp (Continuous.neg (continuous_const.mul ?_))
        exact Complex.continuous_ofReal.comp
          (continuous_const.mul (hΦ₀_cont.comp
            (continuous_const.prodMk (continuous_const.prodMk continuous_id))))
      have hh_Wb_cont : ∀ b : Fin K, Continuous (h_Wb b) := by
        intro b
        exact continuous_finsetSum (W_b b) (fun T _ => continuous_const.mul (hg_cont T))
      have h_Q_split : ∀ v : EuclideanSpace ℝ (Fin 2),
          h_Q v = ∑ b : Fin K, h_Wb b v := by
        intro v
        dsimp only [h_Q, h_Wb, g_T, W_b]
        exact (Finset.sum_fiberwise_of_maps_to
          (fun T _ => Finset.mem_univ (bin_of T)) _).symm
      have hm_obs_le : ∀ o ∈ S_Z,
          m_obs o ≤ (K : ℝ) * ∑ b : Fin K, ‖I_Wb b o‖ ^ 2 := by
        intro o _
        let F_bo : Fin K → EuclideanSpace ℝ (Fin 2) → ℂ := fun b v =>
          h_Wb b v * ψ_O o (ρ⁻¹ • (v - V_O o)) *
            Complex.exp (Complex.I * ((lam_loc * Φ₀ (c_end, X_O o, v) : ℝ) : ℂ))
        have hF_int : ∀ b ∈ (Finset.univ : Finset (Fin K)),
            MeasureTheory.Integrable (F_bo b) MeasureTheory.volume := by
          intro b _
          have hF_cont : Continuous (F_bo b) := by
            dsimp only [F_bo]
            refine ((hh_Wb_cont b).mul ((hψ_cont o).comp
              ((continuous_id.sub continuous_const).const_smul ρ⁻¹))).mul ?_
            refine Complex.continuous_exp.comp (continuous_const.mul ?_)
            exact Complex.continuous_ofReal.comp
              (continuous_const.mul (hΦ₀_cont.comp
                (continuous_const.prodMk (continuous_const.prodMk continuous_id))))
          have hF_supp : HasCompactSupport (F_bo b) := by
            refine HasCompactSupport.intro
              (isCompact_closedBall (V_O o) (R_win * ρ)) (fun v hv => ?_)
            rw [Metric.mem_closedBall, dist_eq_norm, not_le] at hv
            have h_norm : R_win ≤ ‖ρ⁻¹ • (v - V_O o)‖ := by
              rw [norm_smul, Real.norm_of_nonneg (inv_nonneg.mpr hρ.le)]
              exact (le_inv_mul_iff₀ hρ).mpr (by linarith [hv.le])
            dsimp only [F_bo]
            rw [(hO_reg o).2.1 _ h_norm]
            simp
          exact hF_cont.integrable_of_hasCompactSupport hF_supp
        have h_int_eq : (ρ⁻¹ : ℂ) * ∫ v : EuclideanSpace ℝ (Fin 2),
            h_Q v * ψ_O o (ρ⁻¹ • (v - V_O o)) *
              Complex.exp (Complex.I * ((lam_loc * Φ₀ (c_end, X_O o, v) : ℝ) : ℂ)) =
            ∑ b : Fin K, I_Wb b o := by
          have h_fn : (fun v : EuclideanSpace ℝ (Fin 2) =>
              h_Q v * ψ_O o (ρ⁻¹ • (v - V_O o)) *
                Complex.exp (Complex.I * ((lam_loc * Φ₀ (c_end, X_O o, v) : ℝ) : ℂ))) =
              (fun v => ∑ b : Fin K, F_bo b v) := by
            ext v
            rw [h_Q_split v, Finset.sum_mul, Finset.sum_mul]
          rw [h_fn, MeasureTheory.integral_finsetSum Finset.univ hF_int, Finset.mul_sum]
        have h_norm_le : ‖∑ b : Fin K, I_Wb b o‖ ≤ ∑ b : Fin K, ‖I_Wb b o‖ :=
          norm_sum_le Finset.univ (fun b => I_Wb b o)
        have h_sq_le : ‖∑ b : Fin K, I_Wb b o‖ ^ 2 ≤ (∑ b : Fin K, ‖I_Wb b o‖) ^ 2 :=
          pow_le_pow_left₀ (norm_nonneg _) h_norm_le 2
        have h_cs : (∑ b : Fin K, ‖I_Wb b o‖) ^ 2 ≤
            ((Finset.univ : Finset (Fin K)).card : ℝ) * ∑ b : Fin K, ‖I_Wb b o‖ ^ 2 :=
          sq_sum_le_card_mul_sum_sq
        simp only [Finset.card_univ, Fintype.card_fin] at h_cs
        dsimp only [m_obs]
        rw [h_int_eq]
        exact le_trans h_sq_le h_cs
      have h_bin_est : ∀ b : Fin K,
          ∑ o ∈ S_Z, ‖I_Wb b o‖ ^ 2 ≤
            (C_dec * C_tan * C_box) * R ^ 2 * (s / ρ) * ∑ T ∈ W_b b, ‖c_T T‖ ^ 2 := by
        intro b
        have hW_norm_loc : ∀ T₁ ∈ W_b b, ∀ T₂ ∈ W_b b,
            |inner ℝ (V_T T₁ - V_T T₂) n_P| ≤ B_cell * s := by
          intro T₁ hT₁ T₂ hT₂
          rw [Finset.mem_filter] at hT₁ hT₂
          exact (h_bin_loc T₁ T₂ (hT₁.2.trans hT₂.2.symm)).1 rfl
        have hW_fib :
            letI := Classical.propDecidable
            ∀ m : ℤ,
              (((W_b b).filter (fun T =>
                Int.floor (inner ℝ (V_T T - V_P) (perp2D n_P) / s) = m)).card : ℝ) ≤
                C_box * R ^ 2 :=
          h_tan_fib s c_end R hs hc_end hR V_P X_Q n_P hn_P N_Q V_T X_T (W_b b)
            (fun T _ => (hT_reg T).2.2.2.2) hT_pack hW_norm_loc
        have hM_fib_nn : 0 ≤ C_box * R ^ 2 := by positivity
        let M_strip : ℝ :=
          C_tan * (C_box * R ^ 2) * (s / ρ) * ∑ T ∈ W_b b, ‖c_T T‖ ^ 2
        have hM_strip_nn : 0 ≤ M_strip := by
          dsimp [M_strip]
          have h_sum_w : 0 ≤ ∑ T ∈ W_b b, ‖c_T T‖ ^ 2 :=
            Finset.sum_nonneg (fun _ _ => sq_nonneg _)
          have hC_tan_nn : 0 ≤ C_tan := by linarith
          have hsρ_nn : 0 ≤ s / ρ := div_nonneg hs.le hρ.le
          positivity
        have h_mod_bound :=
          h_tan Φ₀ ζ₀ h_phase lam_loc ρ s c_end (C_box * R ^ 2)
            hlam hs hsρ hρ1 hlam_lo hlam_hi hc_end hM_fib_nn
            V_P x_Z n_P hn_P N_Q V_T X_T η_T c_T (W_b b)
            ⟨fun T _ => ⟨hη_cont T, (hT_reg T).2.1, hη_max T⟩, hW_norm_loc, hW_fib⟩
        have hh_Wb_supp : ∀ v : EuclideanSpace ℝ (Fin 2),
            (B_cell + 4) * ρ ≤ ‖v - V_P‖ → h_Wb b v = 0 := by
          intro v hv
          dsimp only [h_Wb, g_T]
          refine Finset.sum_eq_zero (fun T _ => ?_)
          have hVT : ‖V_T T - V_P‖ ≤ B_cell * ρ := (hT_reg T).2.2.2.1
          have h_tri : ‖v - V_P‖ ≤ ‖v - V_T T‖ + ‖V_T T - V_P‖ := by
            have h_eq : v - V_P = (v - V_T T) + (V_T T - V_P) := by abel
            rw [h_eq]
            exact norm_add_le _ _
          have h4s : 4 * s ≤ ‖v - V_T T‖ := by nlinarith
          have h4 : 4 ≤ ‖s⁻¹ • (v - V_T T)‖ := by
            rw [norm_smul, Real.norm_of_nonneg (inv_nonneg.mpr hs.le)]
            exact (le_inv_mul_iff₀ hs).mpr (by linarith [h4s])
          rw [(hT_reg T).2.1 _ h4]
          simp
        have h_dec_app :=
          h_dec Φ₀ ζ₀ h_phase lam_loc ρ s c_end
            hlam hs hsρ hρ1 hlam_lo hlam_hi hc_end
            V_P x_Z n_P hn_P N_obs V_O X_O ψ_O S_Z
            ⟨hO_reg, hO_pack, fun o ho => (hS_Z o ho).1 rfl⟩
            (h_Wb b) M_strip (hh_Wb_cont b) hh_Wb_supp hM_strip_nn
            (fun μ_mod hμ_cont hμ_le => h_mod_bound μ_mod hμ_cont hμ_le)
        calc ∑ o ∈ S_Z, ‖I_Wb b o‖ ^ 2
            ≤ C_dec * M_strip := h_dec_app
          _ = (C_dec * C_tan * C_box) * R ^ 2 * (s / ρ) * ∑ T ∈ W_b b, ‖c_T T‖ ^ 2 := by
              dsimp [M_strip]
              ring
      have h_fib_c : ∑ b : Fin K, ∑ T ∈ W_b b, ‖c_T T‖ ^ 2 = ∑ T : Fin N_Q, ‖c_T T‖ ^ 2 :=
        Finset.sum_fiberwise_of_maps_to (fun T _ => Finset.mem_univ (bin_of T)) _
      have h_factor_nn : 0 ≤ (K : ℝ) * R ^ 2 * (s / ρ) ^ 1 * (∑ T : Fin N_Q, ‖c_T T‖ ^ 2) := by
        have hsρ_nn : 0 ≤ s / ρ := div_nonneg hs.le hρ.le
        positivity
      calc ∑ o ∈ S_Z, m_obs o
          ≤ ∑ o ∈ S_Z, (K : ℝ) * ∑ b : Fin K, ‖I_Wb b o‖ ^ 2 :=
            Finset.sum_le_sum hm_obs_le
        _ = (K : ℝ) * ∑ b : Fin K, ∑ o ∈ S_Z, ‖I_Wb b o‖ ^ 2 := by
            rw [← Finset.mul_sum, Finset.sum_comm]
        _ ≤ (K : ℝ) * ∑ b : Fin K,
              ((C_dec * C_tan * C_box) * R ^ 2 * (s / ρ) * ∑ T ∈ W_b b, ‖c_T T‖ ^ 2) := by
            refine mul_le_mul_of_nonneg_left (Finset.sum_le_sum (fun b _ => h_bin_est b)) ?_
            positivity
        _ = (C_dec * C_tan * C_box) * ((K : ℝ) * R ^ 2 * (s / ρ) ^ 1 *
              (∑ b : Fin K, ∑ T ∈ W_b b, ‖c_T T‖ ^ 2)) := by
            rw [← Finset.mul_sum]
            ring
        _ = (C_dec * C_tan * C_box) * (K : ℝ) * R ^ 2 * (s / ρ) ^ 1 *
              (∑ T : Fin N_Q, ‖c_T T‖ ^ 2) := by
            rw [h_fib_c]
            ring
        _ ≤ C_coh * (K : ℝ) * R ^ 2 * (s / ρ) ^ 1 * (∑ T : Fin N_Q, ‖c_T T‖ ^ 2) := by
            nlinarith [hC_prod_le, h_factor_nn]
    · have h_c2 := h_cell2 Φ₀ hΦ₀_cont lam_loc ρ s c_end R
        hlam hs hsρ hc_end hR V_P X_Q x_Z N_Q K N_obs hK
        V_T X_T η_T c_T bin_of V_O X_O ψ_O S_Z
        ⟨fun T => ⟨hη_cont T, (hT_reg T).2.1, hη_max T, (hT_reg T).2.2.2.2⟩,
         hT_pack,
         fun T₁ T₂ hbin => (h_bin_loc T₁ T₂ hbin).2 rfl,
         fun o ho => ⟨hψ_cont o, (hO_reg o).2.1, hψ_max o,
           (hO_reg o).2.2.2, (hS_Z o ho).2 rfl⟩,
         hO_pack⟩
      have h_factor_nn : 0 ≤ (K : ℝ) * R ^ 2 * (s / ρ) ^ 2 * (∑ T : Fin N_Q, ‖c_T T‖ ^ 2) := by
        positivity
      calc ∑ o ∈ S_Z, m_obs o
          ≤ C_box * (K : ℝ) * R ^ 2 * (s / ρ) ^ 2 * (∑ T : Fin N_Q, ‖c_T T‖ ^ 2) := h_c2
        _ ≤ C_coh * (K : ℝ) * R ^ 2 * (s / ρ) ^ 2 * (∑ T : Fin N_Q, ‖c_T T‖ ^ 2) := by
            nlinarith [hC_box_le, h_factor_nn]

theorem contributor_sampling_and_resampling_entropy (ε : ℝ) (hε₀ : 0 < ε) (hε₁ : ε < 1 / 2) :
    let ell := Real.log (ε⁻¹)
    (∀ {N_O N_D S_bins : ℕ} (hS : 1 ≤ S_bins)
       (p : Fin N_O → Fin N_D → ℝ) (m_O : Fin N_O → ℝ) (w_D : Fin N_D → ℝ)
       (bin_D : Fin N_D → Fin S_bins),
       (∀ o d, 0 ≤ p o d) → (∑ o : Fin N_O, ∑ d : Fin N_D, p o d = 1) →
       (∀ o, (0 < ∑ d : Fin N_D, p o d) → 0 < m_O o) →
       letI := Classical.propDecidable
       let score_fn := fun q : Fin N_O → Fin N_D → ℝ =>
         let q_O := fun o => ∑ d : Fin N_D, q o d
         let q_D := fun d => ∑ o : Fin N_O, q o d
         (∑ o : Fin N_O, -(q_O o * Real.log (q_O o))) / ell +
         (1 / 2 : ℝ) * ((∑ o : Fin N_O, ∑ d : Fin N_D, -(q o d * Real.log (q o d / q_D d))) / ell) +
         (3 / 2 : ℝ) * ((∑ o : Fin N_O, q_O o * Real.log (m_O o)) / ell) +
         (1 / 2 : ℝ) * (∑ d : Fin N_D, q_D d * w_D d)
       let π_b := fun b : Fin S_bins =>
         ∑ o : Fin N_O, ∑ d ∈ Finset.univ.filter (fun d => bin_D d = b), p o d
       let p_b := fun (b : Fin S_bins) (o : Fin N_O) (d : Fin N_D) =>
         if bin_D d = b ∧ 0 < π_b b then p o d / π_b b else 0
       (∀ b, 0 ≤ π_b b) ∧ (∑ b : Fin S_bins, π_b b = 1) ∧
       (∀ b, 0 < π_b b → (∀ o d, 0 ≤ p_b b o d) ∧ (∑ o, ∑ d, p_b b o d = 1) ∧
         (∀ o d, 0 < p_b b o d → bin_D d = b ∧ 0 < p o d)) ∧
       score_fn p ≤ (∑ b : Fin S_bins, if 0 < π_b b then π_b b * score_fn (p_b b) else 0) +
         Real.log (S_bins : ℝ) / ell) ∧
    (∀ {N_O N_D N_Z N_T N_R : ℕ} (p : Fin N_O → Fin N_D → ℝ) (m_O : Fin N_O → ℝ)
       (Z_of : Fin N_O → Fin N_Z) (r_Z : Fin N_Z → Fin N_R) (r_D : Fin N_D → Fin N_R)
       (T_of_Z : Fin N_Z → Finset (Fin N_T)) {K_mass : ℝ} {M_amb : ℕ},
       0 < K_mass → 1 ≤ M_amb →
       (∀ o d, 0 ≤ p o d) → (∑ o : Fin N_O, ∑ d : Fin N_D, p o d = 1) →
       (∀ o, (0 < ∑ d : Fin N_D, p o d) → 0 < m_O o) →
       (∀ o d, 0 < p o d → r_Z (Z_of o) = r_D d) →
       (letI := Classical.propDecidable
        ∀ z : Fin N_Z, (0 < ∑ o ∈ Finset.univ.filter (fun o => Z_of o = z), ∑ d, p o d) →
          (T_of_Z z).Nonempty ∧
          (∑ o ∈ Finset.univ.filter (fun o => Z_of o = z),
            if 0 < ∑ d : Fin N_D, p o d then m_O o else 0) ≤
            K_mass * ((T_of_Z z).card : ℝ)) →
       (letI := Classical.propDecidable
        ∀ (α : Fin N_T) (rv : Fin N_R),
          ((Finset.univ.filter (fun z : Fin N_Z => r_Z z = rv ∧ α ∈ T_of_Z z)).card : ℝ) ≤
            (M_amb : ℝ)) →
       letI := Classical.propDecidable
       let p_O := fun o => ∑ d : Fin N_D, p o d
       let p_D := fun d => ∑ o : Fin N_O, p o d
       let p_ZD := fun z d => ∑ o ∈ Finset.univ.filter (fun o => Z_of o = z), p o d
       let q := fun (z : Fin N_Z) (d : Fin N_D) (α : Fin N_T) =>
         if α ∈ T_of_Z z then p_ZD z d / ((T_of_Z z).card : ℝ) else 0
       let q_T := fun α => ∑ z, ∑ d, q z d α
       let q_TD := fun α d => ∑ z, q z d α
       let q_TR := fun α rv => ∑ z ∈ Finset.univ.filter (fun z => r_Z z = rv), ∑ d, q z d α
       (∀ z d α, 0 ≤ q z d α) ∧ (∑ z, ∑ d, ∑ α, q z d α = 1) ∧
       (∀ z d α, 0 < q z d α → α ∈ T_of_Z z ∧ ∃ o, Z_of o = z ∧ 0 < p o d) ∧
       ((∑ o, -(p_O o * Real.log (p_O o))) / ell +
        (1 / 2 : ℝ) * ((∑ o, ∑ d, -(p o d * Real.log (p o d / p_D d))) / ell) +
        (3 / 2 : ℝ) * ((∑ o, p_O o * Real.log (m_O o)) / ell) ≤
        (∑ α, -(q_T α * Real.log (q_T α))) / ell +
        (1 / 2 : ℝ) * ((∑ α, ∑ d, -(q_TD α d * Real.log (q_TD α d / p_D d))) / ell) +
        (∑ α, ∑ rv, -(q_TR α rv * Real.log (q_TR α rv / q_T α))) / ell +
        (3 / 2 : ℝ) * (Real.log (M_amb : ℝ) / ell) +
        (3 / 2 : ℝ) * (Real.log K_mass / ell))) ∧
    ((∀ {N_X N_Y : ℕ} (P : Fin N_X → Fin N_Y → ℝ) {B_fib : ℝ},
       0 < B_fib → (∀ x y, 0 ≤ P x y) → (∑ x, ∑ y, P x y = 1) →
       (letI := Classical.propDecidable
        ∀ y : Fin N_Y, (0 < ∑ x, P x y) →
          ((Finset.univ.filter (fun x : Fin N_X => 0 < P x y)).card : ℝ) ≤ B_fib) →
       let P_Y := fun y => ∑ x, P x y
       (∑ x, ∑ y, -(P x y * Real.log (P x y / P_Y y))) / ell ≤ Real.log B_fib / ell) ∧
     (∀ {N_T N_D N_E N_M N_U : ℕ} (P : Fin N_T → Fin N_D → ℝ)
       (E_of : Fin N_T → Fin N_E) (M_of : Fin N_T → Fin N_M) (U_of : Fin N_D → Fin N_U)
       {K_EM : ℕ},
       1 ≤ N_E → 1 ≤ K_EM →
       (∀ α d, 0 ≤ P α d) → (∑ α, ∑ d, P α d = 1) →
       (letI := Classical.propDecidable
        ∀ e : Fin N_E,
          (((Finset.univ.filter (fun α => E_of α = e)).image M_of).card : ℝ) ≤ (K_EM : ℝ)) →
       letI := Classical.propDecidable
       let P_T := fun α => ∑ d, P α d
       let P_D := fun d => ∑ α, P α d
       let P_E := fun e => ∑ α ∈ Finset.univ.filter (fun α => E_of α = e), P_T α
       let P_DE := fun d e => ∑ α ∈ Finset.univ.filter (fun α => E_of α = e), P α d
       let P_M := fun m => ∑ α ∈ Finset.univ.filter (fun α => M_of α = m), P_T α
       let P_MU := fun m u =>
         ∑ α ∈ Finset.univ.filter (fun α => M_of α = m),
           ∑ d ∈ Finset.univ.filter (fun d => U_of d = u), P α d
       let Q_TU := fun α u =>
         if 0 < P_M (M_of α) then P_T α * (P_MU (M_of α) u / P_M (M_of α)) else 0
       let Q_U := fun u => ∑ α, Q_TU α u
       (∀ α u, 0 ≤ Q_TU α u) ∧ (∑ α, ∑ u, Q_TU α u = 1) ∧
       (∀ α u, 0 < Q_TU α u → 0 < P_T α ∧
         ∃ α₀ d₀, M_of α₀ = M_of α ∧ U_of d₀ = u ∧ 0 < P α₀ d₀) ∧
       ((∑ α, -(P_T α * Real.log (P_T α))) / ell - Real.log (N_E : ℝ) / ell ≤
         (∑ α, -(P_T α * Real.log (P_T α / P_E (E_of α)))) / ell) ∧
       (((∑ α, -(P_T α * Real.log (P_T α / P_E (E_of α)))) / ell -
         (∑ α, ∑ d, -(P α d * Real.log (P α d / P_DE d (E_of α)))) / ell) ≤
        ((∑ α, ∑ u, -(Q_TU α u * Real.log (Q_TU α u / Q_U u))) / ell -
         (∑ α, ∑ d, -(P α d * Real.log (P α d / P_D d))) / ell) +
        Real.log (K_EM : ℝ) / ell))) :=
by
  intro ell
  have hell_pos : 0 < ell := by
    dsimp only [ell]
    exact Real.log_pos ((one_lt_inv₀ hε₀).mpr (by linarith only [hε₁]))
  have hell_nn : 0 ≤ ell := hell_pos.le

  
  
  
  have h_sum_fib_set : ∀ {α : Type} {K : ℕ} (S : Finset α) (g : α → Fin K) (f : α → ℝ)
      (dec : ∀ k : Fin K, DecidablePred (fun i : α => g i = k)),
      (∑ k : Fin K, ∑ i ∈ @Finset.filter α (fun i => g i = k) (dec k) S, f i) =
        ∑ i ∈ S, f i := by
    intro α K S g f dec
    rw [← Finset.sum_fiberwise S g f]
    refine Finset.sum_congr rfl (fun k _ => ?_)
    exact Finset.sum_congr (by ext i; simp) (fun _ _ => rfl)

  have h_sum_fib : ∀ {N K : ℕ} (g : Fin N → Fin K) (f : Fin N → ℝ)
      (dec : ∀ k : Fin K, DecidablePred (fun i : Fin N => g i = k)),
      (∑ k : Fin K, ∑ i ∈ @Finset.filter (Fin N) (fun i => g i = k) (dec k) Finset.univ, f i) =
        ∑ i : Fin N, f i :=
    fun g f dec => h_sum_fib_set Finset.univ g f dec

  have h_ent_split : ∀ {u v w : ℝ}, 0 ≤ u → (0 < u → 0 < v) → (0 < u → 0 < w) →
      -(u * Real.log (u / w)) = -(u * Real.log (u / v)) + -(u * Real.log (v / w)) := by
    intro u v w hu hv hw
    by_cases hu0 : u = 0
    · simp [hu0]
    · have hu_pos : 0 < u := lt_of_le_of_ne hu (Ne.symm hu0)
      have hv_pos : 0 < v := hv hu_pos
      have hw_pos : 0 < w := hw hu_pos
      have hprod : u / w = (u / v) * (v / w) := by
        field_simp [hv_pos.ne', hw_pos.ne']
      rw [hprod, Real.log_mul (div_pos hu_pos hv_pos).ne' (div_pos hv_pos hw_pos).ne']
      ring

  have h_sum_ent_split : ∀ {α : Type} (S : Finset α) (u : α → ℝ) (U w : ℝ),
      (∀ i ∈ S, 0 ≤ u i) → (∑ i ∈ S, u i = U) → (∀ i ∈ S, 0 < u i → 0 < w) →
      (∑ i ∈ S, -(u i * Real.log (u i / w))) =
        (∑ i ∈ S, -(u i * Real.log (u i / U))) + -(U * Real.log (U / w)) := by
    intro α S u U w hu_nn hU hw
    have hcongr : (∑ i ∈ S, -(u i * Real.log (u i / w))) =
        ∑ i ∈ S, (-(u i * Real.log (u i / U)) + -(u i * Real.log (U / w))) := by
      refine Finset.sum_congr rfl (fun i hi => ?_)
      refine h_ent_split (hu_nn i hi) (fun hui => ?_) (hw i hi)
      rw [← hU]
      exact lt_of_lt_of_le hui (Finset.single_le_sum hu_nn hi)
    rw [hcongr, Finset.sum_add_distrib]
    congr 1
    rw [Finset.sum_neg_distrib, ← Finset.sum_mul, hU]

  have h_sum_ent_split_one : ∀ {α : Type} (S : Finset α) (u : α → ℝ) (U : ℝ),
      (∀ i ∈ S, 0 ≤ u i) → (∑ i ∈ S, u i = U) →
      (∑ i ∈ S, -(u i * Real.log (u i))) =
        (∑ i ∈ S, -(u i * Real.log (u i / U))) + -(U * Real.log U) := by
    intro α S u U hu_nn hU
    simpa [div_one] using h_sum_ent_split S u U 1 hu_nn hU (fun _ _ _ => zero_lt_one)

  have h_det_chain : ∀ {α : Type} {K : ℕ} (S : Finset α) (g : α → Fin K) (u : α → ℝ) (w : ℝ)
      (dec : ∀ k : Fin K, DecidablePred (fun i : α => g i = k)),
      (∀ i ∈ S, 0 ≤ u i) → (∀ i ∈ S, 0 < u i → 0 < w) →
      let U_k : Fin K → ℝ := fun k => ∑ i ∈ @Finset.filter α (fun i => g i = k) (dec k) S, u i
      (∑ i ∈ S, -(u i * Real.log (u i / w))) =
        (∑ i ∈ S, -(u i * Real.log (u i / U_k (g i)))) +
          ∑ k : Fin K, -(U_k k * Real.log (U_k k / w)) := by
    intro α K S g u w dec hu_nn hw U_k
    rw [← h_sum_fib_set S g (fun i => -(u i * Real.log (u i / w))) dec,
      ← h_sum_fib_set S g (fun i => -(u i * Real.log (u i / U_k (g i)))) dec,
      ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun k _ => ?_)
    have h1 := h_sum_ent_split (@Finset.filter α (fun i => g i = k) (dec k) S) u (U_k k) w
      (fun i hi => hu_nn i (Finset.mem_filter.mp hi).1) rfl
      (fun i hi => hw i (Finset.mem_filter.mp hi).1)
    rw [h1]
    congr 1
    refine Finset.sum_congr rfl (fun i hi => ?_)
    rw [(Finset.mem_filter.mp hi).2]

  have h_det_chain_one : ∀ {α : Type} {K : ℕ} (S : Finset α) (g : α → Fin K) (u : α → ℝ)
      (dec : ∀ k : Fin K, DecidablePred (fun i : α => g i = k)),
      (∀ i ∈ S, 0 ≤ u i) →
      let U_k : Fin K → ℝ := fun k => ∑ i ∈ @Finset.filter α (fun i => g i = k) (dec k) S, u i
      (∑ i ∈ S, -(u i * Real.log (u i))) =
        (∑ i ∈ S, -(u i * Real.log (u i / U_k (g i)))) +
          ∑ k : Fin K, -(U_k k * Real.log (U_k k)) := by
    intro α K S g u dec hu_nn
    simpa [div_one] using h_det_chain S g u 1 dec hu_nn (fun _ _ _ => zero_lt_one)

  have h_gibbs : ∀ {α : Type} (S : Finset α) (u w : α → ℝ) (U B : ℝ),
      (∀ i ∈ S, 0 ≤ u i) → (∑ i ∈ S, u i = U) → 0 < B →
      (∀ i ∈ S, 0 ≤ w i) → (∀ i ∈ S, 0 < u i → 0 < w i) → (∑ i ∈ S, w i ≤ B) →
      (∑ i ∈ S, (-(u i * Real.log (u i / U)) + u i * Real.log (w i))) ≤ U * Real.log B := by
    intro α S u w U B hu_nn hU hB_pos hw_nn hw_pos hw_sum
    have hU_nn : 0 ≤ U := by rw [← hU]; exact Finset.sum_nonneg hu_nn
    by_cases hU0 : U = 0
    · have hu0 : ∀ i ∈ S, u i = 0 :=
        (Finset.sum_eq_zero_iff_of_nonneg hu_nn).mp (hU.trans hU0)
      rw [hU0, zero_mul, Finset.sum_eq_zero (fun i hi => by simp [hu0 i hi])]
    · have hU_pos : 0 < U := lt_of_le_of_ne hU_nn (Ne.symm hU0)
      have hpt : ∀ i ∈ S,
          (-(u i * Real.log (u i / U)) + u i * Real.log (w i)) - u i * Real.log B ≤
            U * (w i / B) - u i := by
        intro i hi
        by_cases hui0 : u i = 0
        · rw [hui0]
          simp only [zero_div, zero_mul, neg_zero, add_zero, sub_zero]
          exact mul_nonneg hU_nn (div_nonneg (hw_nn i hi) hB_pos.le)
        · have hui_pos : 0 < u i := lt_of_le_of_ne (hu_nn i hi) (Ne.symm hui0)
          have hwi_pos : 0 < w i := hw_pos i hi hui_pos
          let x := (w i / B) / (u i / U)
          have hx_pos : 0 < x := div_pos (div_pos hwi_pos hB_pos) (div_pos hui_pos hU_pos)
          have hlog : Real.log x = Real.log (w i) - Real.log B - Real.log (u i / U) := by
            dsimp only [x]
            rw [Real.log_div (div_pos hwi_pos hB_pos).ne' (div_pos hui_pos hU_pos).ne',
              Real.log_div hwi_pos.ne' hB_pos.ne']
          have h1 := mul_le_mul_of_nonneg_left (Real.log_le_sub_one_of_pos hx_pos) hui_pos.le
          have hlhs : u i * Real.log x =
              (-(u i * Real.log (u i / U)) + u i * Real.log (w i)) - u i * Real.log B := by
            rw [hlog]; ring
          have hrhs : u i * (x - 1) = U * (w i / B) - u i := by
            dsimp only [x]
            field_simp [hui_pos.ne', hU_pos.ne', hB_pos.ne']
          rwa [hlhs, hrhs] at h1
      have hsum := Finset.sum_le_sum hpt
      rw [Finset.sum_sub_distrib, ← Finset.sum_mul, hU,
        Finset.sum_sub_distrib, ← Finset.mul_sum, ← Finset.sum_div, hU] at hsum
      have hdiv : (∑ i ∈ S, w i) / B ≤ 1 := (div_le_one hB_pos).mpr hw_sum
      have hmul : U * ((∑ i ∈ S, w i) / B) ≤ U * 1 := mul_le_mul_of_nonneg_left hdiv hU_nn
      linarith only [hsum, hmul]

  have h_card_ent : ∀ {α : Type} (S : Finset α) (u : α → ℝ) (U K : ℝ),
      (∀ i ∈ S, 0 ≤ u i) → (∑ i ∈ S, u i = U) → 0 < K → (S.card : ℝ) ≤ K →
      (∑ i ∈ S, -(u i * Real.log (u i / U))) ≤ U * Real.log K := by
    intro α S u U K hu_nn hU hK_pos hcard
    have hg := h_gibbs S u (fun _ => (1 : ℝ)) U K hu_nn hU hK_pos
      (fun _ _ => zero_le_one) (fun _ _ _ => zero_lt_one)
      (by simp only [Finset.sum_const, nsmul_eq_mul, mul_one]; exact hcard)
    simpa [Real.log_one] using hg

  have h_card_ent_one : ∀ {α : Type} (S : Finset α) (u : α → ℝ) (K : ℝ),
      (∀ i ∈ S, 0 ≤ u i) → (∑ i ∈ S, u i = 1) → 0 < K → (S.card : ℝ) ≤ K →
      (∑ i ∈ S, -(u i * Real.log (u i))) ≤ Real.log K := by
    intro α S u K hu_nn hU hK_pos hcard
    simpa [div_one, one_mul] using h_card_ent S u 1 K hu_nn hU hK_pos hcard

  have h_supp_card_ent : ∀ {α : Type} (S₀ S : Finset α) (u : α → ℝ) (U K : ℝ),
      S ⊆ S₀ → (∀ i ∈ S₀, 0 ≤ u i) → (∑ i ∈ S₀, u i = U) →
      (∀ i ∈ S₀, 0 < u i → i ∈ S) → 0 < K → (0 < U → (S.card : ℝ) ≤ K) →
      (∑ i ∈ S₀, -(u i * Real.log (u i / U))) ≤ U * Real.log K := by
    intro α S₀ S u U K hsub hu_nn hU hsupp hK_pos hcard
    have hU_nn : 0 ≤ U := by rw [← hU]; exact Finset.sum_nonneg hu_nn
    by_cases hU0 : U = 0
    · have hu0 : ∀ i ∈ S₀, u i = 0 :=
        (Finset.sum_eq_zero_iff_of_nonneg hu_nn).mp (hU.trans hU0)
      rw [hU0, zero_mul, Finset.sum_eq_zero (fun i hi => by simp [hu0 i hi])]
    · have hU_pos : 0 < U := lt_of_le_of_ne hU_nn (Ne.symm hU0)
      have hzero_out : ∀ i ∈ S₀, i ∉ S → u i = 0 := by
        intro i hi₀ hiS
        by_contra hne
        exact hiS (hsupp i hi₀ (lt_of_le_of_ne (hu_nn i hi₀) (Ne.symm hne)))
      have hU_S : ∑ i ∈ S, u i = U := by
        rw [← hU]
        exact Finset.sum_subset hsub hzero_out
      have hent_S : (∑ i ∈ S, -(u i * Real.log (u i / U))) =
          ∑ i ∈ S₀, -(u i * Real.log (u i / U)) :=
        Finset.sum_subset hsub (fun i hi₀ hiS => by simp [hzero_out i hi₀ hiS])
      rw [← hent_S]
      exact h_card_ent S u U K (fun i hi => hu_nn i (hsub hi)) hU_S hK_pos (hcard hU_pos)

  have h_log_sum : ∀ {α : Type} (S : Finset α) (a b : α → ℝ),
      (∀ i ∈ S, 0 ≤ a i) → (∀ i ∈ S, 0 ≤ b i) → (∀ i ∈ S, 0 < a i → 0 < b i) →
      (∑ i ∈ S, -(a i * Real.log (a i / b i))) ≤
        -((∑ i ∈ S, a i) * Real.log ((∑ i ∈ S, a i) / (∑ i ∈ S, b i))) := by
    intro α S a b ha_nn hb_nn hab_pos
    let A := ∑ i ∈ S, a i
    let B := ∑ i ∈ S, b i
    change (∑ i ∈ S, -(a i * Real.log (a i / b i))) ≤ -(A * Real.log (A / B))
    have hA_nn : 0 ≤ A := Finset.sum_nonneg ha_nn
    by_cases hA0 : A = 0
    · have ha0 : ∀ i ∈ S, a i = 0 := (Finset.sum_eq_zero_iff_of_nonneg ha_nn).mp hA0
      rw [hA0, zero_div, Real.log_zero, mul_zero, neg_zero,
        Finset.sum_eq_zero (fun i hi => by simp [ha0 i hi])]
    · have hA_pos : 0 < A := lt_of_le_of_ne hA_nn (Ne.symm hA0)
      obtain ⟨i₀, hi₀, hai₀⟩ := (Finset.sum_pos_iff_of_nonneg ha_nn).mp hA_pos
      have hB_pos : 0 < B :=
        lt_of_lt_of_le (hab_pos i₀ hi₀ hai₀) (Finset.single_le_sum hb_nn hi₀)
      have hpt : ∀ i ∈ S,
          -(a i * Real.log (a i / b i)) + a i * Real.log (A / B) ≤ A * (b i / B) - a i := by
        intro i hi
        by_cases hai0 : a i = 0
        · rw [hai0]
          simp only [zero_div, zero_mul, neg_zero, add_zero, sub_zero]
          exact mul_nonneg hA_nn (div_nonneg (hb_nn i hi) hB_pos.le)
        · have hai_pos : 0 < a i := lt_of_le_of_ne (ha_nn i hi) (Ne.symm hai0)
          have hbi_pos : 0 < b i := hab_pos i hi hai_pos
          let x := (A / B) / (a i / b i)
          have hx_pos : 0 < x := div_pos (div_pos hA_pos hB_pos) (div_pos hai_pos hbi_pos)
          have hlog : Real.log x = Real.log (A / B) - Real.log (a i / b i) := by
            dsimp only [x]
            exact Real.log_div (div_pos hA_pos hB_pos).ne' (div_pos hai_pos hbi_pos).ne'
          have h1 := mul_le_mul_of_nonneg_left (Real.log_le_sub_one_of_pos hx_pos) hai_pos.le
          have hlhs : a i * Real.log x =
              -(a i * Real.log (a i / b i)) + a i * Real.log (A / B) := by
            rw [hlog]; ring
          have hrhs : a i * (x - 1) = A * (b i / B) - a i := by
            dsimp only [x]
            field_simp [hai_pos.ne', hbi_pos.ne', hB_pos.ne']
          rwa [hlhs, hrhs] at h1
      have hsum := Finset.sum_le_sum hpt
      have hA_def : ∑ i ∈ S, a i = A := rfl
      have hB_def : ∑ i ∈ S, b i = B := rfl
      rw [Finset.sum_add_distrib, ← Finset.sum_mul, hA_def,
        Finset.sum_sub_distrib, ← Finset.mul_sum, ← Finset.sum_div, hB_def, hA_def,
        div_self hB_pos.ne', mul_one, sub_self] at hsum
      linarith only [hsum]

  have h_ite_card : ∀ {N : ℕ} (T : Finset (Fin N)) (c : ℝ)
      (dec : DecidablePred (fun α : Fin N => α ∈ T)),
      (∑ α : Fin N, @ite ℝ (α ∈ T) (dec α) c 0) = (T.card : ℝ) * c := by
    intro N T c dec
    rw [← Finset.sum_subset (Finset.subset_univ T) (fun α _ hα => by simp [hα])]
    have hcongr : (∑ α ∈ T, @ite ℝ (α ∈ T) (dec α) c 0) = ∑ _α ∈ T, c :=
      Finset.sum_congr rfl (fun α hα => by simp [hα])
    rw [hcongr, Finset.sum_const, nsmul_eq_mul]

  have h_unif_sum : ∀ {N : ℕ} (T : Finset (Fin N)) (U : ℝ)
      (dec : DecidablePred (fun α : Fin N => α ∈ T)),
      0 ≤ U → (0 < U → T.Nonempty) →
      (∑ α : Fin N, @ite ℝ (α ∈ T) (dec α) (U / (T.card : ℝ)) 0) = U := by
    intro N T U dec hU_nn hne
    rw [h_ite_card]
    by_cases hU0 : U = 0
    · simp [hU0]
    · have hU_pos : 0 < U := lt_of_le_of_ne hU_nn (Ne.symm hU0)
      have hcard_pos : 0 < (T.card : ℝ) := Nat.cast_pos.mpr (Finset.card_pos.mpr (hne hU_pos))
      exact mul_div_cancel₀ U hcard_pos.ne'

  have h_unif_ent : ∀ {N : ℕ} (T : Finset (Fin N)) (U w : ℝ)
      (dec : DecidablePred (fun α : Fin N => α ∈ T)),
      0 ≤ U → (0 < U → T.Nonempty) → (0 < U → 0 < w) →
      let f := fun α : Fin N => @ite ℝ (α ∈ T) (dec α) (U / (T.card : ℝ)) 0
      (∑ α : Fin N, -(f α * Real.log (f α / w))) =
        -(U * Real.log (U / w)) + U * Real.log (T.card : ℝ) := by
    intro N T U w dec hU_nn hne hw f
    by_cases hU0 : U = 0
    · have hf0 : ∀ α : Fin N, f α = 0 := by
        intro α; dsimp only [f]; rw [hU0, zero_div, ite_self]
      simp [hf0, hU0]
    · have hU_pos : 0 < U := lt_of_le_of_ne hU_nn (Ne.symm hU0)
      have hcard_pos : 0 < (T.card : ℝ) := Nat.cast_pos.mpr (Finset.card_pos.mpr (hne hU_pos))
      have hw_pos : 0 < w := hw hU_pos
      let c := -((U / (T.card : ℝ)) * Real.log ((U / (T.card : ℝ)) / w))
      have hcongr : (∑ α : Fin N, -(f α * Real.log (f α / w))) =
          ∑ α : Fin N, @ite ℝ (α ∈ T) (dec α) c 0 := by
        refine Finset.sum_congr rfl (fun α _ => ?_)
        dsimp only [f, c]
        by_cases hα : α ∈ T <;> simp [hα]
      rw [hcongr, h_ite_card]
      dsimp only [c]
      have hdiv_eq : (U / (T.card : ℝ)) / w = (U / w) / (T.card : ℝ) := by
        rw [div_div, mul_comm (T.card : ℝ) w, ← div_div]
      rw [hdiv_eq, Real.log_div (div_pos hU_pos hw_pos).ne' hcard_pos.ne']
      have hmul : (T.card : ℝ) * (U / (T.card : ℝ)) = U := mul_div_cancel₀ U hcard_pos.ne'
      calc (T.card : ℝ) * -((U / (T.card : ℝ)) * (Real.log (U / w) - Real.log (T.card : ℝ)))
          = -(((T.card : ℝ) * (U / (T.card : ℝ))) * (Real.log (U / w) - Real.log (T.card : ℝ))) := by ring
        _ = -(U * (Real.log (U / w) - Real.log (T.card : ℝ))) := by rw [hmul]
        _ = -(U * Real.log (U / w)) + U * Real.log (T.card : ℝ) := by ring

  refine ⟨?_, ?_, ?_, ?_⟩

  
  
  
  · intro N_O N_D S_bins hS p m_O w_D bin_D hp_nn hp_sum _hm_pos
    letI := Classical.propDecidable
    intro score_fn π_b p_b
    let p_O : Fin N_O → ℝ := fun o => ∑ d : Fin N_D, p o d
    let p_D : Fin N_D → ℝ := fun d => ∑ o : Fin N_O, p o d
    let P_OB : Fin N_O → Fin S_bins → ℝ := fun o b =>
      ∑ d ∈ Finset.univ.filter (fun d => bin_D d = b), p o d
    let pb_O : Fin S_bins → Fin N_O → ℝ := fun b o => ∑ d : Fin N_D, p_b b o d
    let pb_D : Fin S_bins → Fin N_D → ℝ := fun b d => ∑ o : Fin N_O, p_b b o d
    have hpO_nn : ∀ o, 0 ≤ p_O o := fun o => Finset.sum_nonneg (fun d _ => hp_nn o d)
    have hPOB_nn : ∀ o b, 0 ≤ P_OB o b := fun o b => Finset.sum_nonneg (fun d _ => hp_nn o d)
    have hPOB_sum_o : ∀ b, ∑ o : Fin N_O, P_OB o b = π_b b := fun _ => rfl
    have hPOB_sum_b : ∀ o, ∑ b : Fin S_bins, P_OB o b = p_O o :=
      fun o => h_sum_fib bin_D (fun d => p o d) _
    have hπ_nn : ∀ b, 0 ≤ π_b b :=
      fun b => Finset.sum_nonneg (fun o _ => hPOB_nn o b)
    have hπ_sum : ∑ b : Fin S_bins, π_b b = 1 := by
      calc ∑ b : Fin S_bins, π_b b
          = ∑ b : Fin S_bins, ∑ o : Fin N_O, P_OB o b := rfl
        _ = ∑ o : Fin N_O, ∑ b : Fin S_bins, P_OB o b := Finset.sum_comm
        _ = ∑ o : Fin N_O, p_O o := Finset.sum_congr rfl (fun o _ => hPOB_sum_b o)
        _ = 1 := hp_sum
    have hpb_O : ∀ b, 0 < π_b b → ∀ o, pb_O b o = P_OB o b / π_b b := by
      intro b hπ o
      dsimp only [pb_O, P_OB]
      rw [Finset.sum_div, Finset.sum_filter]
      refine Finset.sum_congr rfl (fun d _ => ?_)
      by_cases hbd : bin_D d = b
      · simp [p_b, hbd, hπ]
      · simp [p_b, hbd]
    have hpb_D : ∀ b, 0 < π_b b → ∀ d,
        pb_D b d = if bin_D d = b then p_D d / π_b b else 0 := by
      intro b hπ d
      dsimp only [pb_D, p_D]
      by_cases hbd : bin_D d = b
      · simp only [hbd, ↓reduceIte]
        rw [Finset.sum_div]
        exact Finset.sum_congr rfl (fun o _ => by simp [p_b, hbd, hπ])
      · simp only [hbd, ↓reduceIte]
        exact Finset.sum_eq_zero (fun o _ => by simp [p_b, hbd])
    have hπ_zero_POB : ∀ b, ¬ (0 < π_b b) → ∀ o, P_OB o b = 0 := by
      intro b hnot o
      have h0 : π_b b = 0 := le_antisymm (not_lt.mp hnot) (hπ_nn b)
      exact (Finset.sum_eq_zero_iff_of_nonneg (fun o' _ => hPOB_nn o' b)).mp h0 o (Finset.mem_univ o)
    have hπ_zero_p : ∀ b, ¬ (0 < π_b b) → ∀ o d, bin_D d = b → p o d = 0 := by
      intro b hnot o d hbd
      have hle : p o d ≤ P_OB o b :=
        Finset.single_le_sum (fun d' _ => hp_nn o d')
          (Finset.mem_filter.mpr ⟨Finset.mem_univ d, hbd⟩)
      have h0 : P_OB o b = 0 := hπ_zero_POB b hnot o
      linarith only [hle, h0, hp_nn o d]
    have hpb_cond : ∀ b, 0 < π_b b →
        (∀ o d, 0 ≤ p_b b o d) ∧ (∑ o, ∑ d, p_b b o d = 1) ∧
          (∀ o d, 0 < p_b b o d → bin_D d = b ∧ 0 < p o d) := by
      intro b hπ
      refine ⟨?_, ?_, ?_⟩
      · intro o d
        dsimp only [p_b]
        split_ifs
        · exact div_nonneg (hp_nn o d) hπ.le
        · exact le_rfl
      · calc ∑ o : Fin N_O, ∑ d : Fin N_D, p_b b o d
            = ∑ o : Fin N_O, (P_OB o b / π_b b) :=
              Finset.sum_congr rfl (fun o _ => hpb_O b hπ o)
          _ = (∑ o : Fin N_O, P_OB o b) / π_b b := (Finset.sum_div _ _ _).symm
          _ = π_b b / π_b b := rfl
          _ = 1 := div_self hπ.ne'
      · intro o d hpos
        dsimp only [p_b] at hpos
        by_cases hbd : bin_D d = b
        · simp only [hbd, hπ, and_self, ↓reduceIte] at hpos
          exact ⟨hbd, (div_pos_iff_of_pos_right hπ).mp hpos⟩
        · simp only [hbd, false_and, ↓reduceIte] at hpos
          exact False.elim (lt_irrefl 0 hpos)
    refine ⟨hπ_nn, hπ_sum, hpb_cond, ?_⟩
    let T1 := fun q : Fin N_O → Fin N_D → ℝ =>
      ∑ o : Fin N_O, -((∑ d : Fin N_D, q o d) * Real.log (∑ d : Fin N_D, q o d))
    let T2 := fun q : Fin N_O → Fin N_D → ℝ =>
      ∑ o : Fin N_O, ∑ d : Fin N_D, -(q o d * Real.log (q o d / (∑ o' : Fin N_O, q o' d)))
    let T3 := fun q : Fin N_O → Fin N_D → ℝ =>
      ∑ o : Fin N_O, (∑ d : Fin N_D, q o d) * Real.log (m_O o)
    let T4 := fun q : Fin N_O → Fin N_D → ℝ =>
      ∑ d : Fin N_D, (∑ o : Fin N_O, q o d) * w_D d
    have hT3_eq : (∑ b : Fin S_bins, if 0 < π_b b then π_b b * T3 (p_b b) else 0) = T3 p := by
      have h_b : ∀ b : Fin S_bins,
          (if 0 < π_b b then π_b b * T3 (p_b b) else 0) =
            ∑ o : Fin N_O, P_OB o b * Real.log (m_O o) := by
        intro b
        by_cases hπ : 0 < π_b b
        · simp only [hπ, ↓reduceIte, T3]
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl (fun o _ => ?_)
          change π_b b * (pb_O b o * Real.log (m_O o)) = P_OB o b * Real.log (m_O o)
          rw [hpb_O b hπ o, ← mul_assoc, mul_div_cancel₀ _ hπ.ne']
        · simp only [hπ, ↓reduceIte]
          exact (Finset.sum_eq_zero (fun o _ => by simp [hπ_zero_POB b hπ o])).symm
      simp_rw [h_b]
      rw [Finset.sum_comm]
      dsimp only [T3]
      refine Finset.sum_congr rfl (fun o _ => ?_)
      rw [← Finset.sum_mul, hPOB_sum_b o]
    have hT4_eq : (∑ b : Fin S_bins, if 0 < π_b b then π_b b * T4 (p_b b) else 0) = T4 p := by
      have h_b : ∀ b : Fin S_bins,
          (if 0 < π_b b then π_b b * T4 (p_b b) else 0) =
            ∑ d ∈ Finset.univ.filter (fun d => bin_D d = b), p_D d * w_D d := by
        intro b
        by_cases hπ : 0 < π_b b
        · simp only [hπ, ↓reduceIte, T4]
          rw [Finset.sum_filter, Finset.mul_sum]
          refine Finset.sum_congr rfl (fun d _ => ?_)
          change π_b b * (pb_D b d * w_D d) = _
          rw [hpb_D b hπ d]
          by_cases hbd : bin_D d = b
          · simp only [hbd, ↓reduceIte]
            rw [← mul_assoc, mul_div_cancel₀ _ hπ.ne']
          · simp [hbd]
        · simp only [hπ, ↓reduceIte]
          refine (Finset.sum_eq_zero (fun d hd => ?_)).symm
          have hbd := (Finset.mem_filter.mp hd).2
          have hpD0 : p_D d = 0 := Finset.sum_eq_zero (fun o _ => hπ_zero_p b hπ o d hbd)
          simp [hpD0]
