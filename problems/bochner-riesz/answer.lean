      (2 * K_A * K_prod ^ 2)⁻¹ ≤ M_dir ^ 2 * C_ball * r_ball ^ s_rate := by
    intro N_A N_B s_rate s_dir K_A K_B K_prod δ_strip ρ_strip δ_cov r_ball M_dir C_ball
      a_mid ξ θ_B μ_A μ_B q hs_dir hKA hKB hKprod hρ_strip hδ_cov hM_dir hC_ball hr_ball
      h_cramer_rad hμA_nn hμB_nn hq_nn hq_sum hq_supp_B hq_prod hq_domA hq_domB
      h_strip_small h_nostrip_B h_ball_A h_cov
    let q_A : Fin N_A → ℝ := fun a => ∑ b, q a b
    let q_B : Fin N_B → ℝ := fun b => ∑ a, q a b
    have hqA_nn : ∀ a, 0 ≤ q_A a := fun a => Finset.sum_nonneg (fun b _ => hq_nn a b)
    have hqB_nn : ∀ b, 0 ≤ q_B b := fun b => Finset.sum_nonneg (fun a _ => hq_nn a b)
    have hqA_sum : ∑ a, q_A a = 1 := hq_sum
    have hqB_sum : ∑ b, q_B b = 1 := by dsimp [q_B]; rw [Finset.sum_comm]; exact hq_sum
    let W₂ : Fin N_A → Fin N_B → Fin N_B → ℝ :=
      fun a b₁ b₂ => if 0 < q_A a then q a b₁ * q a b₂ / q_A a else 0
    have hW₂_nn : ∀ a b₁ b₂, 0 ≤ W₂ a b₁ b₂ := by
      intro a b₁ b₂; dsimp [W₂]; split_ifs with h
      · exact div_nonneg (mul_nonneg (hq_nn a b₁) (hq_nn a b₂)) h.le
      · exact le_rfl
    have hW₂_sum_a : ∀ a, (∑ b₁, ∑ b₂, W₂ a b₁ b₂) = q_A a := by
      intro a; dsimp [W₂]
      by_cases ha : 0 < q_A a
      · simp_rw [if_pos ha, ← Finset.sum_div, ← Finset.mul_sum, ← Finset.sum_mul]
        exact mul_div_cancel_right₀ (q_A a) ha.ne'
      · have ha0 : q_A a = 0 := le_antisymm (le_of_not_gt ha) (hqA_nn a)
        simp [ha0]
    have hW₂_tot : (∑ b₁, ∑ b₂, ∑ a, W₂ a b₁ b₂) = 1 := by
      calc (∑ b₁, ∑ b₂, ∑ a, W₂ a b₁ b₂)
          = ∑ b₁, ∑ a, ∑ b₂, W₂ a b₁ b₂ :=
            Finset.sum_congr rfl (fun _ _ => Finset.sum_comm)
        _ = ∑ a, ∑ b₁, ∑ b₂, W₂ a b₁ b₂ := Finset.sum_comm
        _ = ∑ a, q_A a := Finset.sum_congr rfl (fun a _ => hW₂_sum_a a)
