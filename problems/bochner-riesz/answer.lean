            lam0_b * B_p0 := by
          calc M_ret * (∑ idx_p : Fin N_P, if f_i idx_p = q then π idx_p b else 0)
              ≤ ∑ idx_p : Fin N_P, if f_i idx_p = q then p0 idx_p b else 0 := by
                rw [Finset.mul_sum]
                refine Finset.sum_le_sum fun idx_p _ => ?_
                split_ifs; exact hπ_le idx_p; simp
            _ = lam0_b * (∑ idx_p : Fin N_P, if f_i idx_p = q then p0 idx_p b / lam0_b else 0) := by
                rw [Finset.mul_sum]
                refine Finset.sum_congr rfl fun idx_p _ => ?_
                split_ifs
                · exact (mul_div_cancel₀ _ hlam0_pos.ne').symm
                · simp
            _ ≤ lam0_b * B_p0 := mul_le_mul_of_nonneg_left h_cm hlam0_pos.le
        have hS_eq : S = (M_ret * (∑ idx_p : Fin N_P, if f_i idx_p = q then π idx_p b else 0)) /
            (M_ret * lam_b) := by
          have h_s : S = (∑ idx_p : Fin N_P, if f_i idx_p = q then π idx_p b else 0) / lam_b := by
            dsimp [S]
            rw [Finset.sum_div]
            refine Finset.sum_congr rfl fun idx_p _ => ?_
            split_ifs <;> simp
          rw [h_s, mul_div_mul_left _ _ hM_pos.ne']
        change S ≤ B_out
        rw [hS_eq]
        refine le_trans ?_ h_fac
        rw [div_le_iff₀ (mul_pos hM_pos hlam_b)]
        calc M_ret * (∑ idx_p : Fin N_P, if f_i idx_p = q then π idx_p b else 0)
            ≤ lam0_b * B_p0 := h_num_le
          _ ≤ (δ⁻¹ * (M_ret * lam_b)) * B_p0 :=
              mul_le_mul_of_nonneg_right hlam0_le hBp0_nn
          _ = δ⁻¹ * B_p0 * (M_ret * lam_b) := by ring
      · rw [if_neg hq₀] at hidx₀
        exact absurd rfl hidx₀
  have h_param_cond_transfer : ∀ {N_P N_Θ : ℕ}
      (p0 π : Fin N_P → Fin N_Θ → ℝ) (H_set : Fin N_P → Fin N_Θ → Prop)
      (M_ret δ B_p0 B_out : ℝ) (f₁ f₂ : Fin N_Θ → ℤ × ℤ) (q₁ q₂ : ℤ × ℤ),
      letI := Classical.propDecidable
      let m_par := ∑ b : Fin N_Θ, if f₁ b = q₁ then (∑ idx_p, π idx_p b) else 0
      let m_ch := ∑ b : Fin N_Θ, if f₁ b = q₁ ∧ f₂ b = q₂ then (∑ idx_p, π idx_p b) else 0
      let m_par0 := ∑ b : Fin N_Θ, if f₁ b = q₁ then (∑ idx_p, p0 idx_p b) else 0
      let m_ch0 := ∑ b : Fin N_Θ, if f₁ b = q₁ ∧ f₂ b = q₂ then (∑ idx_p, p0 idx_p b) else 0
      0 < M_ret → 0 < δ → 0 ≤ B_p0 → 0 ≤ B_out →
      δ⁻¹ * B_p0 ≤ B_out →
      (∀ idx_p b, 0 ≤ π idx_p b) →
      (∀ idx_p b, M_ret * π idx_p b ≤ p0 idx_p b) →
      (∀ idx_p b, 0 < π idx_p b → H_set idx_p b ∧ 0 < p0 idx_p b) →
      (0 < m_par → δ * m_par0 ≤ M_ret * m_par) →
      (∀ idx_p b, H_set idx_p b → 0 < p0 idx_p b → f₁ b = q₁ → f₂ b = q₂ →
        m_ch0 ≤ B_p0 * m_par0) →
      m_ch ≤ B_out * m_par := by
    intro N_P N_Θ p0 π H_set M_ret δ B_p0 B_out f₁ f₂ q₁ q₂
    letI := Classical.propDecidable
    dsimp only
    intro hM_pos hδ_pos hBp0_nn hBout_nn h_fac hπ_nn hπ_le hπ_supp h_floor_imp h_p0_bd
    let m_par := ∑ b : Fin N_Θ, if f₁ b = q₁ then (∑ idx_p, π idx_p b) else 0
    let m_ch := ∑ b : Fin N_Θ, if f₁ b = q₁ ∧ f₂ b = q₂ then (∑ idx_p, π idx_p b) else 0
    let m_par0 := ∑ b : Fin N_Θ, if f₁ b = q₁ then (∑ idx_p, p0 idx_p b) else 0
    let m_ch0 := ∑ b : Fin N_Θ, if f₁ b = q₁ ∧ f₂ b = q₂ then (∑ idx_p, p0 idx_p b) else 0
    have hm_par_nn : 0 ≤ m_par := Finset.sum_nonneg fun b _ => by
      split_ifs
      · exact Finset.sum_nonneg fun idx_p _ => hπ_nn idx_p b
      · exact le_rfl
    by_cases h_zero : m_ch = 0
    · change m_ch ≤ B_out * m_par
      rw [h_zero]
      exact mul_nonneg hBout_nn hm_par_nn
    · obtain ⟨b₀, _, hb₀⟩ := Finset.exists_ne_zero_of_sum_ne_zero h_zero
      by_cases hq_b₀ : f₁ b₀ = q₁ ∧ f₂ b₀ = q₂
      · rw [if_pos hq_b₀] at hb₀
        obtain ⟨idx₀, _, hidx₀_ne⟩ := Finset.exists_ne_zero_of_sum_ne_zero hb₀
        have hπ₀_pos : 0 < π idx₀ b₀ := lt_of_le_of_ne (hπ_nn idx₀ b₀) (Ne.symm hidx₀_ne)
        obtain ⟨hH₀, hp0_pos⟩ := hπ_supp idx₀ b₀ hπ₀_pos
