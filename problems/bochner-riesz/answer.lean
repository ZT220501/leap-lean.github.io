                          refine Finset.sum_congr rfl (fun ω _ =>
                            (hω_sum_SJ (fun j => Real.log (p_J_fn j) / ell) ω).symm)
                    _ = ∑ j ∈ S_J, ∑ ω : Fin N_ω,
                          (if J_fn ω = j then π ω else 0) * (Real.log (p_J_fn j) / ell) :=
                        Finset.sum_comm
                    _ = ∑ j ∈ S_J, (p_J_fn j * Real.log (p_J_fn j)) / ell := by
                        refine Finset.sum_congr rfl (fun j _ => ?_)
                        rw [← Finset.sum_mul, mul_div_assoc]
        dsimp only [H_J]
        have h_cancel : (∑ j ∈ S_J, -(p_J_fn j * Real.log (p_J_fn j)) / ell) +
            (∑ j ∈ S_J, (p_J_fn j * Real.log (p_J_fn j)) / ell) = 0 := by
          rw [← Finset.sum_add_distrib]
          refine Finset.sum_eq_zero (fun j _ => by ring)
        linarith [h_expand, h_cancel]
      have h_split : ∑ j ∈ S_J, p_J_fn j * finMutualInfo ε (π_j_fn j) T_idx (G_loc j) =
          (∑ j ∈ S_J, p_J_fn j * finCondEntropy ε (π_j_fn j) (fun _ => ()) (G_loc j)) -
          (∑ j ∈ S_J, p_J_fn j * finCondEntropy ε (π_j_fn j) T_idx (G_loc j)) := by
        dsimp only [finMutualInfo]
        rw [← Finset.sum_sub_distrib]
        refine Finset.sum_congr rfl (fun j _ => mul_sub _ _ _)
      rw [h_split]
      change H_J +
          ((∑ j ∈ S_J, p_J_fn j * finCondEntropy ε (π_j_fn j) (fun _ => ()) (G_loc j)) -
            ∑ j ∈ S_J, p_J_fn j * finCondEntropy ε (π_j_fn j) T_idx (G_loc j)) =
        finCondEntropy ε π (fun _ => ()) Y - finCondEntropy ε π T_idx Y
      linarith [h_uncond_eq, h_cond_eq]
    have h_kl_helper : ∀ u : Fin N_ω → ℝ,
        (∀ ω, 0 < π ω → 0 < u ω) →
        ∑ ω : Fin N_ω, π ω * Real.log (u ω) ≤ (∑ ω : Fin N_ω, π ω * u ω) - 1 := by
      intro u hu
      have h_pt : ∀ ω : Fin N_ω, π ω * Real.log (u ω) ≤ π ω * u ω - π ω := by
        intro ω
        rcases eq_or_lt_of_le (hπ_nn ω) with h0 | hpos
        · rw [← h0]; simp
        · have hlog := Real.log_le_sub_one_of_pos (hu ω hpos)
          have hm := mul_le_mul_of_nonneg_left hlog hpos.le
          linarith
      calc ∑ ω : Fin N_ω, π ω * Real.log (u ω)
          ≤ ∑ ω : Fin N_ω, (π ω * u ω - π ω) := Finset.sum_le_sum (fun ω _ => h_pt ω)
        _ = (∑ ω : Fin N_ω, π ω * u ω) - ∑ ω : Fin N_ω, π ω := by rw [Finset.sum_sub_distrib]
        _ = (∑ ω : Fin N_ω, π ω * u ω) - 1 := by rw [hπ_sum]
    let Z : Fin N_ω → β_G × (α_J × β_loc) := fun ω => (G_glob ω, Y ω)
    have h_prob_pos : ∀ {α : Type} (X : Fin N_ω → α) (ω : Fin N_ω),
        0 < π ω → 0 < finProbAt π X ω := by
      intro α X ω hpos
      dsimp only [finProbAt]
      letI := Classical.propDecidable
      have hle : π ω ≤ ∑ ω' : Fin N_ω, if X ω' = X ω then π ω' else 0 := by
        have hterm : π ω = (if X ω = X ω then π ω else 0) := by simp
        rw [hterm]
        exact Finset.single_le_sum
          (f := fun ω' => if X ω' = X ω then π ω' else 0)
          (fun ω' _ => by split_ifs <;> [exact hπ_nn ω'; exact le_rfl])
          (Finset.mem_univ ω)
      exact lt_of_lt_of_le hpos hle
    have h_prob2_eq : ∀ {α β : Type} (X : Fin N_ω → α) (W : Fin N_ω → β) (ω : Fin N_ω),
        finProbAt2 π X W ω = finProbAt π (fun ω' => (X ω', W ω')) ω := by
      intro α β X W ω
      classical
      dsimp only [finProbAt2, finProbAt]
      refine Finset.sum_congr rfl (fun ω' _ => ?_)
      simp [Prod.ext_iff]
    have h_prob_unit : ∀ ω : Fin N_ω, finProbAt π (fun _ => ()) ω = 1 := by
      intro ω; simp [finProbAt, hπ_sum]
    have h_prob2_unit : ∀ {β : Type} (W : Fin N_ω → β) (ω : Fin N_ω),
        finProbAt2 π (fun _ => ()) W ω = finProbAt π W ω := by
      intro β W ω
      classical
      dsimp only [finProbAt2, finProbAt]
      simp
    have h_mi_YZ : finMutualInfo ε π T_idx Y ≤ finMutualInfo ε π T_idx Z := by
      let pY_v : α_J × β_loc → ℝ := fun y => ∑ ω, if Y ω = y then π ω else 0
      let pZ_v : β_G × (α_J × β_loc) → ℝ := fun z => ∑ ω, if Z ω = z then π ω else 0
      let pTY_v : Fin N_T × (α_J × β_loc) → ℝ :=
        fun ty => ∑ ω, if (T_idx ω, Y ω) = ty then π ω else 0
      let pTZ_v : Fin N_T × (β_G × (α_J × β_loc)) → ℝ :=
        fun tz => ∑ ω, if (T_idx ω, Z ω) = tz then π ω else 0
      let u : Fin N_ω → ℝ := fun ω =>
        if 0 < π ω then
          (pTY_v (T_idx ω, Y ω) * pZ_v (Z ω)) / (pTZ_v (T_idx ω, Z ω) * pY_v (Y ω))
        else 1
      have hpY_eq : ∀ ω, finProbAt π Y ω = pY_v (Y ω) := by
        intro ω; dsimp only [finProbAt, pY_v]
        refine Finset.sum_congr rfl (fun ω' _ => by split_ifs <;> rfl)
      have hpZ_eq : ∀ ω, finProbAt π Z ω = pZ_v (Z ω) := by
        intro ω; dsimp only [finProbAt, pZ_v]
        refine Finset.sum_congr rfl (fun ω' _ => by split_ifs <;> rfl)
      have hpTY_eq : ∀ ω, finProbAt π (fun ω' => (T_idx ω', Y ω')) ω = pTY_v (T_idx ω, Y ω) := by
        intro ω; dsimp only [finProbAt, pTY_v]
        refine Finset.sum_congr rfl (fun ω' _ => by split_ifs <;> rfl)
      have hpTZ_eq : ∀ ω, finProbAt π (fun ω' => (T_idx ω', Z ω')) ω = pTZ_v (T_idx ω, Z ω) := by
        intro ω; dsimp only [finProbAt, pTZ_v]
        refine Finset.sum_congr rfl (fun ω' _ => by split_ifs <;> rfl)
      have hu_pos : ∀ ω, 0 < π ω → 0 < u ω := by
        intro ω hpos
        dsimp only [u]
        rw [if_pos hpos]
        have h1 : 0 < pTY_v (T_idx ω, Y ω) := by
          rw [← hpTY_eq]; exact h_prob_pos _ ω hpos
        have h2 : 0 < pZ_v (Z ω) := by
          rw [← hpZ_eq]; exact h_prob_pos _ ω hpos
        have h3 : 0 < pTZ_v (T_idx ω, Z ω) := by
          rw [← hpTZ_eq]; exact h_prob_pos _ ω hpos
        have h4 : 0 < pY_v (Y ω) := by
          rw [← hpY_eq]; exact h_prob_pos _ ω hpos
        positivity
      have h_sum_u : ∑ ω : Fin N_ω, π ω * u ω ≤ 1 := by
        let S_G : Finset β_G := Finset.univ.image G_glob
        let S_Y : Finset (α_J × β_loc) := Finset.univ.image Y
        let B_all : Finset (Fin N_T × (β_G × (α_J × β_loc))) :=
          Finset.univ ×ˢ (S_G ×ˢ S_Y)
        have h_maps : ∀ ω ∈ (Finset.univ : Finset (Fin N_ω)),
            (T_idx ω, Z ω) ∈ B_all := by
          intro ω _
          rw [Finset.mem_product, Finset.mem_product]
          exact ⟨Finset.mem_univ _, Finset.mem_image_of_mem G_glob (Finset.mem_univ ω),
            Finset.mem_image_of_mem Y (Finset.mem_univ ω)⟩
        have h_fib := (Finset.sum_fiberwise_of_maps_to h_maps (fun ω => π ω * u ω)).symm
        rw [h_fib]
        have h_each_b : ∀ tz ∈ B_all,
            (∑ ω ∈ Finset.univ.filter (fun ω => (T_idx ω, Z ω) = tz), π ω * u ω) ≤
              (pTY_v (tz.1, tz.2.2) * pZ_v tz.2) / pY_v tz.2.2 := by
          intro tz _
          have hpY_nn : 0 ≤ pY_v tz.2.2 :=
            Finset.sum_nonneg (fun ω _ => by split_ifs <;> [exact hπ_nn ω; exact le_rfl])
          have hpTY_nn : 0 ≤ pTY_v (tz.1, tz.2.2) :=
            Finset.sum_nonneg (fun ω _ => by split_ifs <;> [exact hπ_nn ω; exact le_rfl])
          have hpZ_nn : 0 ≤ pZ_v tz.2 :=
            Finset.sum_nonneg (fun ω _ => by split_ifs <;> [exact hπ_nn ω; exact le_rfl])
          have hpTZ_nn : 0 ≤ pTZ_v tz :=
            Finset.sum_nonneg (fun ω _ => by split_ifs <;> [exact hπ_nn ω; exact le_rfl])
          rcases eq_or_lt_of_le hpTZ_nn with h0 | hpos_tz
          · have h_zero_sum :
                ∑ ω ∈ Finset.univ.filter (fun ω => (T_idx ω, Z ω) = tz), π ω * u ω = 0 := by
              refine Finset.sum_eq_zero (fun ω hω => ?_)
              have heq := (Finset.mem_filter.mp hω).2
              have hle : π ω ≤ pTZ_v tz := by
                dsimp only [pTZ_v]
                have hterm : π ω = (if (T_idx ω, Z ω) = tz then π ω else 0) := by rw [if_pos heq]
                rw [hterm]
                exact Finset.single_le_sum
                  (f := fun ω' => if (T_idx ω', Z ω') = tz then π ω' else 0)
                  (fun ω' _ => by split_ifs <;> [exact hπ_nn ω'; exact le_rfl])
                  (Finset.mem_univ ω)
              have hπ0 : π ω = 0 := le_antisymm (by linarith) (hπ_nn ω)
              rw [hπ0, zero_mul]
            rw [h_zero_sum]
            exact div_nonneg (mul_nonneg hpTY_nn hpZ_nn) hpY_nn
          · have h_filter_sum :
                ∑ ω ∈ Finset.univ.filter (fun ω => (T_idx ω, Z ω) = tz), π ω = pTZ_v tz := by
              dsimp only [pTZ_v]
              rw [← Finset.sum_filter]
            have h_each_ω : ∀ ω ∈ Finset.univ.filter (fun ω => (T_idx ω, Z ω) = tz),
                π ω * u ω =
                  π ω * ((pTY_v (tz.1, tz.2.2) * pZ_v tz.2) / (pTZ_v tz * pY_v tz.2.2)) := by
              intro ω hω
              have heq := (Finset.mem_filter.mp hω).2
              rcases eq_or_lt_of_le (hπ_nn ω) with h0 | hpos
              · rw [← h0, zero_mul, zero_mul]
              · dsimp only [u]
                rw [if_pos hpos, heq]
                have ht : T_idx ω = tz.1 := congrArg Prod.fst heq
                have hz : Z ω = tz.2 := congrArg Prod.snd heq
                have hy : Y ω = tz.2.2 := congrArg Prod.snd hz
                rw [ht, hy, hz]
            rw [Finset.sum_congr rfl h_each_ω, ← Finset.sum_mul, h_filter_sum]
            exact le_of_eq (by field_simp [hpos_tz.ne'])
        calc ∑ tz ∈ B_all, ∑ ω ∈ Finset.univ.filter (fun ω => (T_idx ω, Z ω) = tz), π ω * u ω
            ≤ ∑ tz ∈ B_all, (pTY_v (tz.1, tz.2.2) * pZ_v tz.2) / pY_v tz.2.2 :=
              Finset.sum_le_sum h_each_b
          _ = ∑ y ∈ S_Y,
                ((∑ t : Fin N_T, pTY_v (t, y)) * (∑ g ∈ S_G, pZ_v (g, y))) / pY_v y := by
              dsimp only [B_all]
              simp_rw [Finset.sum_product]
              calc ∑ t : Fin N_T, ∑ g ∈ S_G, ∑ y ∈ S_Y, (pTY_v (t, y) * pZ_v (g, y)) / pY_v y
                  = ∑ t : Fin N_T, ∑ y ∈ S_Y, ∑ g ∈ S_G, (pTY_v (t, y) * pZ_v (g, y)) / pY_v y :=
                    Finset.sum_congr rfl (fun _ _ => Finset.sum_comm)
                _ = ∑ y ∈ S_Y, ∑ t : Fin N_T, ∑ g ∈ S_G, (pTY_v (t, y) * pZ_v (g, y)) / pY_v y :=
                    Finset.sum_comm
                _ = _ := by
                    refine Finset.sum_congr rfl (fun y _ => ?_)
                    rw [Finset.sum_mul, Finset.sum_div]
                    refine Finset.sum_congr rfl (fun t _ => ?_)
                    rw [Finset.mul_sum, Finset.sum_div]
          _ = ∑ y ∈ S_Y, (pY_v y * pY_v y) / pY_v y := by
              refine Finset.sum_congr rfl (fun y _ => ?_)
              have h1 : ∑ t : Fin N_T, pTY_v (t, y) = pY_v y := by
                dsimp only [pTY_v, pY_v]
                rw [Finset.sum_comm]
                refine Finset.sum_congr rfl (fun ω _ => ?_)
                by_cases hy : Y ω = y
                · simp [hy]
                · simp [hy]
              have h2 : ∑ g ∈ S_G, pZ_v (g, y) = pY_v y := by
                dsimp only [pZ_v, pY_v, Z]
                rw [Finset.sum_comm]
                refine Finset.sum_congr rfl (fun ω _ => ?_)
                by_cases hy : Y ω = y
                · rw [Finset.sum_eq_single (G_glob ω)]
                  · simp [hy]
                  · intro g _ hne; simp [hy, Ne.symm hne]
                  · intro hnot
                    exact absurd (Finset.mem_image_of_mem G_glob (Finset.mem_univ ω)) hnot
                · simp [hy]
              rw [h1, h2]
          _ ≤ ∑ y ∈ S_Y, pY_v y := by
              refine Finset.sum_le_sum (fun y _ => ?_)
              by_cases hy0 : pY_v y = 0
              · simp [hy0]
              · rw [mul_div_cancel_right₀ _ hy0]
