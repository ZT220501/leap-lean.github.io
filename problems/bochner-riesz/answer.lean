        dsimp only [P_TG, P_G]
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl (fun ω hω => ?_)
        have ht_mem : T_idx ω ∈ S_T := Finset.mem_image_of_mem T_idx hω
        rw [Finset.sum_eq_single (T_idx ω)]
        · simp
        · intro t _ hne; simp [Ne.symm hne]
        · intro hnot; exact absurd ht_mem hnot
      have h_factor : (∑ t ∈ S_T, (P_D d * P_TG t g) / ((M_rnd : ℝ) * P_G g)) =
          (P_D d / ((M_rnd : ℝ) * P_G g)) * (∑ t ∈ S_T, P_TG t g) := by
        rw [Finset.mul_sum S_T (fun t => P_TG t g) (P_D d / ((M_rnd : ℝ) * P_G g))]
        refine Finset.sum_congr rfl (fun t _ => ?_)
        ring
      calc (∑ t ∈ S_T, P_TDG t d g * ((P_D d * P_TG t g) / ((M_rnd : ℝ) * P_TDG t d g * P_G g)))
          ≤ ∑ t ∈ S_T, (P_D d * P_TG t g) / ((M_rnd : ℝ) * P_G g) :=
            Finset.sum_le_sum h_le_each
        _ = (P_D d / ((M_rnd : ℝ) * P_G g)) * (∑ t ∈ S_T, P_TG t g) := h_factor
        _ = (P_D d / ((M_rnd : ℝ) * P_G g)) * P_G g := by rw [h_sum_PTG]
        _ = P_D d / (M_rnd : ℝ) := by field_simp [hM_ne, hPG_g_ne]
    have h_step_g : ∀ d ∈ S_D,
        (∑ g ∈ S_G d, ∑ t ∈ S_T,
          P_TDG t d g * ((P_D d * P_TG t g) / ((M_rnd : ℝ) * P_TDG t d g * P_G g))) ≤
          P_D d := by
      intro d hd
      have h_card_SG : ((S_G d).card : ℝ) ≤ (M_rnd : ℝ) := by
        have hc : (S_G d).card ≤ M_rnd :=
          le_trans (Finset.card_le_card Finset.inter_subset_left) (hS_card d)
        exact_mod_cast hc
      calc (∑ g ∈ S_G d, ∑ t ∈ S_T,
              P_TDG t d g * ((P_D d * P_TG t g) / ((M_rnd : ℝ) * P_TDG t d g * P_G g)))
          ≤ ∑ _g ∈ S_G d, (P_D d / (M_rnd : ℝ)) := Finset.sum_le_sum (h_step_t d hd)
        _ = ((S_G d).card : ℝ) * (P_D d / (M_rnd : ℝ)) := by simp
        _ ≤ (M_rnd : ℝ) * (P_D d / (M_rnd : ℝ)) :=
            mul_le_mul_of_nonneg_right h_card_SG (div_nonneg (hPD_nn d) hM_pos.le)
        _ = P_D d := mul_div_cancel₀ _ hM_ne
    have h_sum_PD : ∑ d ∈ S_D, P_D d = 1 := by
      dsimp only [P_D]
      rw [Finset.sum_comm, ← h_sum_pi_pos]
      refine Finset.sum_congr rfl (fun ω hω => ?_)
      have hd_mem : D_hat ω ∈ S_D := Finset.mem_image_of_mem D_hat hω
      rw [Finset.sum_eq_single (D_hat ω)]
      · simp
      · intro d _ hne; simp [Ne.symm hne]
      · intro hnot; exact absurd hd_mem hnot
    calc (∑ d ∈ S_D, ∑ g ∈ S_G d, ∑ t ∈ S_T,
            P_TDG t d g * ((P_D d * P_TG t g) / ((M_rnd : ℝ) * P_TDG t d g * P_G g)))
        ≤ ∑ d ∈ S_D, P_D d := Finset.sum_le_sum h_step_g
      _ = 1 := h_sum_PD
  have h_mi_bound : finMutualInfo ε π T_idx G_star - finMutualInfo ε π T_idx D_hat ≤
      Real.log (M_rnd : ℝ) / ell := by
    have h_mul_ell : 0 ≤ ell * (finMutualInfo ε π T_idx D_hat + Real.log (M_rnd : ℝ) / ell -
        finMutualInfo ε π T_idx G_star) := by
      have h_lhs_eq : ell * (finMutualInfo ε π T_idx D_hat + Real.log (M_rnd : ℝ) / ell -
          finMutualInfo ε π T_idx G_star) =
        ∑ ω ∈ Ω_pos, π ω * (Real.log (M_rnd : ℝ) + Real.log (finProbAt2 π T_idx D_hat ω) +
          Real.log (finProbAt π G_star ω) - Real.log (finProbAt π D_hat ω) -
          Real.log (finProbAt2 π T_idx G_star ω)) := by
        have h_logM : ell * (Real.log (M_rnd : ℝ) / ell) =
            ∑ ω ∈ Ω_pos, π ω * Real.log (M_rnd : ℝ) := by
          rw [mul_div_cancel₀ _ hell_ne, ← Finset.sum_mul, h_sum_pi_pos, one_mul]
        calc ell * (finMutualInfo ε π T_idx D_hat + Real.log (M_rnd : ℝ) / ell -
              finMutualInfo ε π T_idx G_star)
            = ell * finMutualInfo ε π T_idx D_hat + ell * (Real.log (M_rnd : ℝ) / ell) -
                ell * finMutualInfo ε π T_idx G_star := by ring
          _ = (∑ ω ∈ Ω_pos, π ω *
                (Real.log (finProbAt2 π T_idx D_hat ω) - Real.log (finProbAt π T_idx ω) -
                  Real.log (finProbAt π D_hat ω))) +
              (∑ ω ∈ Ω_pos, π ω * Real.log (M_rnd : ℝ)) -
              (∑ ω ∈ Ω_pos, π ω *
                (Real.log (finProbAt2 π T_idx G_star ω) - Real.log (finProbAt π T_idx ω) -
                  Real.log (finProbAt π G_star ω))) := by
              rw [h_mi_expand D_hat, h_logM, h_mi_expand G_star]
          _ = ∑ ω ∈ Ω_pos, π ω * (Real.log (M_rnd : ℝ) + Real.log (finProbAt2 π T_idx D_hat ω) +
                Real.log (finProbAt π G_star ω) - Real.log (finProbAt π D_hat ω) -
                Real.log (finProbAt2 π T_idx G_star ω)) := by
              rw [← Finset.sum_add_distrib, ← Finset.sum_sub_distrib]
              refine Finset.sum_congr rfl (fun ω _ => ?_)
              ring
      rw [h_lhs_eq]
      have h_pt_jensen : ∀ ω ∈ Ω_pos,
          π ω * (1 - z_fn ω) ≤ π ω * (Real.log (M_rnd : ℝ) +
            Real.log (finProbAt2 π T_idx D_hat ω) + Real.log (finProbAt π G_star ω) -
            Real.log (finProbAt π D_hat ω) - Real.log (finProbAt2 π T_idx G_star ω)) := by
        intro ω hω
        have hpD : 0 < finProbAt π D_hat ω := h_prob_pos D_hat ω hω
        have hpG : 0 < finProbAt π G_star ω := h_prob_pos G_star ω hω
        have hpTG : 0 < finProbAt2 π T_idx G_star ω := by
          rw [h_prob2_prod]; exact h_prob_pos _ ω hω
        have hpTD : 0 < finProbAt2 π T_idx D_hat ω := by
          rw [h_prob2_prod]; exact h_prob_pos _ ω hω
        have hpTDG : 0 < finProbAt π TDG ω := h_prob_pos TDG ω hω
        have hpTDG_le : finProbAt π TDG ω ≤ finProbAt2 π T_idx D_hat ω := by
          dsimp only [finProbAt, finProbAt2, TDG]
          refine Finset.sum_le_sum (fun ω' _ => ?_)
          by_cases h3 : T_idx ω' = T_idx ω ∧ D_hat ω' = D_hat ω ∧ G_star ω' = G_star ω
          · simp [h3]
          · have hp : (T_idx ω', D_hat ω', G_star ω') ≠ (T_idx ω, D_hat ω, G_star ω) :=
              fun heq => h3 ⟨congr_arg Prod.fst heq,
                congr_arg (Prod.fst ∘ Prod.snd) heq,
                congr_arg (Prod.snd ∘ Prod.snd) heq⟩
            simp only [hp, ↓reduceIte]
            split_ifs
            · exact h_law.1 ω'
            · exact le_rfl
        have h_log_tdg : Real.log (finProbAt π TDG ω) ≤ Real.log (finProbAt2 π T_idx D_hat ω) :=
          Real.log_le_log hpTDG hpTDG_le
        have hz_pos : 0 < z_fn ω :=
          div_pos (mul_pos hpD hpTG) (mul_pos (mul_pos hM_pos hpTDG) hpG)
        have h_jensen : Real.log (z_fn ω) ≤ z_fn ω - 1 := Real.log_le_sub_one_of_pos hz_pos
        have h_log_z : Real.log (z_fn ω) =
            (Real.log (finProbAt π D_hat ω) + Real.log (finProbAt2 π T_idx G_star ω)) -
            ((Real.log (M_rnd : ℝ) + Real.log (finProbAt π TDG ω)) +
              Real.log (finProbAt π G_star ω)) := by
          dsimp only [z_fn]
          rw [Real.log_div (ne_of_gt (mul_pos hpD hpTG))
              (ne_of_gt (mul_pos (mul_pos hM_pos hpTDG) hpG)),
            Real.log_mul (ne_of_gt hpD) (ne_of_gt hpTG),
            Real.log_mul (ne_of_gt (mul_pos hM_pos hpTDG)) (ne_of_gt hpG),
            Real.log_mul hM_ne (ne_of_gt hpTDG)]
        exact mul_le_mul_of_nonneg_left (by linarith [h_jensen, h_log_z, h_log_tdg]) (h_law.1 ω)
      have h_sum_1mz : 0 ≤ ∑ ω ∈ Ω_pos, π ω * (1 - z_fn ω) := by
        have h_eq : (∑ ω ∈ Ω_pos, π ω * (1 - z_fn ω)) =
            (∑ ω ∈ Ω_pos, π ω) - ∑ ω ∈ Ω_pos, π ω * z_fn ω := by
          rw [← Finset.sum_sub_distrib]
          refine Finset.sum_congr rfl (fun ω _ => ?_)
          ring
        linarith [h_eq, h_sum_pi_pos, h_sum_z_le1]
      exact le_trans h_sum_1mz (Finset.sum_le_sum h_pt_jensen)
    have h_nonneg : 0 ≤ finMutualInfo ε π T_idx D_hat + Real.log (M_rnd : ℝ) / ell -
        finMutualInfo ε π T_idx G_star := by
      by_contra h_neg
      have h_lt : finMutualInfo ε π T_idx D_hat + Real.log (M_rnd : ℝ) / ell -
          finMutualInfo ε π T_idx G_star < 0 := lt_of_not_ge h_neg
      have h_prod_lt : ell * (finMutualInfo ε π T_idx D_hat + Real.log (M_rnd : ℝ) / ell -
          finMutualInfo ε π T_idx G_star) < 0 := mul_neg_of_pos_of_neg hell_pos h_lt
      linarith [h_mul_ell, h_prod_lt]
    linarith [h_nonneg]
  
  dsimp only [stdApertureScore]
  change (∑ ω : Fin N_ω, π ω * ((1 + γ) * b_raw (D_hat ω) + (1 - γ) * a_raw (D_hat ω))) -
      finMutualInfo ε π T_idx D_hat +
      2 * finCondEntropy ε π T_idx (fun ω => dyadicTimeBin ε r (c_s ω)) -
      2 * ξ - Real.log (M_rnd : ℝ) / ell ≤
    W_star - finMutualInfo ε π T_idx G_star +
      2 * finCondEntropy ε π T_idx (fun ω => dyadicTimeBin ε r (c_s ω))
  linarith [h_weight, h_mi_bound]

theorem backward_isotropic_predecessor_step (γ m r t : ℝ) (L_obs : ℕ) (u_obs : Fin L_obs → ℝ) (l_src : Fin L_obs)
    (hγ₀ : 0 < γ) (hγ₁ : γ < 1) (hm : 0 ≤ m)
    (h_two : (2 : ℝ) ∈ ValidClassicalGrowthRates γ)
    (hr_pos : 0 < r) (hrt : r < t) (ht_le : t ≤ 1)
    (hu_obs : ∀ l : Fin L_obs, r < u_obs l ∧ u_obs l ≤ 1)
    (hl_src : u_obs l_src = t)
    (η_step : ℝ) (hη : 0 < η_step) :
    ∃ (δ_in ε₀ : ℝ), 0 < δ_in ∧ 0 < ε₀ ∧ ε₀ < 1 / 2 ∧
      ∀ (ε : ℝ), 0 < ε → ε < ε₀ →
      ∀ (b_obs a_obs : Fin L_obs → ℝ),
        (∀ l, 0 ≤ b_obs l ∧ b_obs l ≤ a_obs l ∧ a_obs l + u_obs l ≤ 1 + m) →
      ∀ {N_ω N_T : ℕ}
        (π : Fin N_ω → ℝ) (T_idx : Fin N_ω → Fin N_T)
        (V_part A_part : Fin N_T → EuclideanSpace ℝ (Fin 2))
        (c_s : Fin N_ω → ℝ)
        (θ_det : Fin L_obs → Fin N_T → ℤ → ℝ),
        IsUnitBallTimeLaw π V_part A_part c_s →
        (∀ l tid k, θ_det l tid k ∈ Set.Ico (0 : ℝ) Real.pi) →
        (∀ l : Fin L_obs,
          stdApertureDeficit ε γ (1 + m) (u_obs l) (b_obs l) (a_obs l)
            π T_idx V_part A_part c_s
            (fun ω => θ_det l (T_idx ω) (dyadicTimeBin ε (u_obs l) (c_s ω))) ≤ δ_in) →
        ∃ (N'_ω : ℕ)
          (π' : Fin N'_ω → ℝ) (T'_idx : Fin N'_ω → Fin N_T) (c'_s : Fin N'_ω → ℝ)
          (b_r a_r : ℝ) (θ_r : Fin N'_ω → ℝ),
          IsUnitBallTimeLaw π' V_part A_part c'_s ∧
          b_obs l_src ≤ b_r ∧ b_r ≤ a_r ∧ a_r + r ≤ a_obs l_src + t ∧
          (∀ ω', 0 < π' ω' → θ_r ω' ∈ Set.Ico (0 : ℝ) Real.pi) ∧
          (∀ l : Fin L_obs,
            stdApertureDeficit ε γ (1 + m) (u_obs l) (b_obs l) (a_obs l)
              π' T'_idx V_part A_part c'_s
              (fun ω' => θ_det l (T'_idx ω') (dyadicTimeBin ε (u_obs l) (c'_s ω'))) ≤ η_step) ∧
          stdApertureDeficit ε γ (1 + m) r b_r a_r
            π' T'_idx V_part A_part c'_s θ_r ≤ η_step :=
by
  have hL1_pos : (0 : ℝ) < (L_obs : ℝ) + 1 := by positivity
  let η₁ : ℝ := η_step / (2 * ((L_obs : ℝ) + 1))
  have hη₁_pos : 0 < η₁ := div_pos hη (by positivity)
  let η_lb : ℝ := η_step / (4 * ((L_obs : ℝ) + 1))
  have hη_lb_pos : 0 < η_lb := div_pos hη (by positivity)
  let δ_in : ℝ := η₁ / 6
  have hδ_in_pos : 0 < δ_in := by dsimp [δ_in]; linarith
  let δ_loc : ℝ := η₁ / 6
  have hδ_loc_pos : 0 < δ_loc := by dsimp [δ_loc]; linarith
  let η_comp : ℝ := η₁ / 6
  have hη_comp_pos : 0 < η_comp := by dsimp [η_comp]; linarith
  let ξ : ℝ := η₁ / 12
  have hξ_pos : 0 < ξ := by dsimp [ξ]; linarith
  let K_sh : ℕ := ⌈(1 + m) / ξ⌉₊ + 1
  have hK_sh_pos : 1 ≤ K_sh := Nat.le_add_left 1 _
  let M_shape : ℕ := K_sh * K_sh
  have hM_shape_pos : 1 ≤ M_shape := Nat.mul_pos hK_sh_pos hK_sh_pos
  have hr_le_one : r ≤ 1 := le_trans hrt.le ht_le
  obtain ⟨h_def_lb_all, h_tag_split⟩ :=
    std_aperture_deficit_lower_and_tag_splitting γ m hγ₀ hγ₁ hm h_two
  obtain ⟨ε_lb, hε_lb_pos, hε_lb_half, h_lb⟩ :=
    h_def_lb_all r η_lb hr_pos hr_le_one hη_lb_pos
  obtain ⟨ε_loc, hε_loc_pos, _, h_loc⟩ :=
    isotropic_cell_localization_score_bound γ m r t hγ₀ hγ₁ hm h_two hr_pos hrt ht_le
      δ_loc hδ_loc_pos
  obtain ⟨C_rnd, hC_rnd_nn, h_rnd⟩ :=
    variable_predecessor_to_std_aperture_rounding γ hγ₀ hγ₁
  have hM_real_ge_one : (1 : ℝ) ≤ (M_shape : ℝ) := by exact_mod_cast hM_shape_pos
  have hlog_M_nn : 0 ≤ Real.log (M_shape : ℝ) := Real.log_nonneg hM_real_ge_one
  let C_log : ℝ := 3 * Real.log (M_shape : ℝ) + C_rnd + 1
  have hC_log_pos : 0 < C_log := by dsimp [C_log]; linarith
  let M_exp : ℝ := 3 * C_log / η₁
  have hM_exp_pos : 0 < M_exp := div_pos (by positivity) hη₁_pos
  let ε_log : ℝ := Real.exp (-M_exp)
  have hε_log_pos : 0 < ε_log := Real.exp_pos (-M_exp)
  let ε₀ : ℝ := min ε_lb (min ε_loc ε_log)
  have hε₀_pos : 0 < ε₀ := lt_min hε_lb_pos (lt_min hε_loc_pos hε_log_pos)
  have hε₀_half : ε₀ < 1 / 2 := lt_of_le_of_lt (min_le_left _ _) hε_lb_half
  refine ⟨δ_in, ε₀, hδ_in_pos, hε₀_pos, hε₀_half, ?_⟩
  intro ε hε_pos hε_lt b_obs a_obs h_ba_obs N_ω N_T π T_idx V_part A_part c_s θ_det h_law hθ_det h_def_in
  have hε_lt_lb : ε < ε_lb := lt_of_lt_of_le hε_lt (min_le_left _ _)
  have hε_lt_loc : ε < ε_loc :=
    lt_of_lt_of_le hε_lt (le_trans (min_le_right _ _) (min_le_left _ _))
  have hε_lt_log : ε < ε_log :=
    lt_of_lt_of_le hε_lt (le_trans (min_le_right _ _) (min_le_right _ _))
  have hε_half : ε < 1 / 2 := lt_trans hε_lt_lb hε_lb_half
  have h_log_gt : M_exp < Real.log (ε⁻¹) := by
    have h1 : ε * Real.exp M_exp < ε_log * Real.exp M_exp :=
      mul_lt_mul_of_pos_right hε_lt_log (Real.exp_pos M_exp)
    dsimp only [ε_log] at h1
    rw [← Real.exp_add, neg_add_cancel, Real.exp_zero] at h1
    have h2 : Real.exp M_exp < ε⁻¹ := by
      have h_mul := mul_lt_mul_of_pos_left h1 (inv_pos.mpr hε_pos)
      rwa [← mul_assoc, inv_mul_cancel₀ (ne_of_gt hε_pos), one_mul, mul_one] at h_mul
    have h3 := Real.log_lt_log (Real.exp_pos M_exp) h2
    rwa [Real.log_exp] at h3
  have h_ell_pos : 0 < Real.log (ε⁻¹) := lt_trans hM_exp_pos h_log_gt
  have h_clog_div : C_log / Real.log (ε⁻¹) < η₁ / 3 := by
    rw [div_lt_iff₀ h_ell_pos]
    have h_div : 3 * C_log / η₁ < Real.log (ε⁻¹) := h_log_gt
    have h_mul := (div_lt_iff₀ hη₁_pos).mp h_div
    linarith [mul_comm η₁ (Real.log (ε⁻¹))]
  have h_log1_le : (3 * Real.log (M_shape : ℝ)) / Real.log (ε⁻¹) ≤ η₁ / 3 := by
    have h_num : 3 * Real.log (M_shape : ℝ) ≤ C_log := by dsimp [C_log]; linarith
    exact le_trans (div_le_div_of_nonneg_right h_num h_ell_pos.le) h_clog_div.le
  have h_log2_le : (3 * Real.log (M_shape : ℝ) + C_rnd) / Real.log (ε⁻¹) ≤ η₁ / 3 := by
    have h_num : 3 * Real.log (M_shape : ℝ) + C_rnd ≤ C_log := by dsimp [C_log]; linarith
    exact le_trans (div_le_div_of_nonneg_right h_num h_ell_pos.le) h_clog_div.le
  let b_t : ℝ := b_obs l_src
  let a_t : ℝ := a_obs l_src
  have h_src_ba := h_ba_obs l_src
  have hb_t_nn : 0 ≤ b_t := h_src_ba.1
  have hba_t : b_t ≤ a_t := h_src_ba.2.1
  have hat_ub : a_t + t ≤ 1 + m := by
    have h1 := h_src_ba.2.2
    rwa [hl_src] at h1
  let θ_src : Fin N_ω → ℝ := fun ω => θ_det l_src (T_idx ω) (dyadicTimeBin ε t (c_s ω))
  have h_def_t :
      stdApertureDeficit ε γ (1 + m) t b_t a_t π T_idx V_part A_part c_s θ_src ≤ δ_in := by
    have h1 := h_def_in l_src
    dsimp only [b_t, a_t, θ_src]
    rwa [hl_src] at h1
  let L' : ℝ := (a_t - b_t) + (t - r)
  have hL'_nn : 0 ≤ L' := by dsimp [L']; linarith
  obtain ⟨N_J, J, k_J, v_J, x_J, V'_J, A'_J, hNJ, hk_J, h_bds_J, h_rel_J, h_score_loc⟩ :=
    h_loc ε b_t a_t hε_pos hε_lt_loc hb_t_nn hba_t hat_ub
      π T_idx V_part A_part c_s θ_src h_law (fun ω _ => hθ_det l_src _ _)
  obtain ⟨N_hat, N_raw, proj_ω, π_hat, D_hat, k_D, b_raw, a_raw, φ_raw, V_glob, X_glob,
      _, h_law_hat, _, h_root_eq, h_def_pull, h_raw_bds, hk_D, h_raw_geom, h_score_comp⟩ :=
    predecessor_kernel_adjoining_and_composition
      ε γ (1 + m) r b_t L' η_comp hε_pos hε_half hγ₀ hγ₁
      hr_pos hb_t_nn hL'_nn hη_comp_pos hNJ
      π T_idx V_part A_part c_s J k_J v_J x_J V'_J A'_J
      h_law hk_J h_bds_J h_rel_J
  let T_hat : Fin N_hat → Fin N_T := fun ω_h => T_idx (proj_ω ω_h)
  let c_hat : Fin N_hat → ℝ := fun ω_h => c_s (proj_ω ω_h)
  let k_r_hat : Fin N_hat → ℤ := fun ω_h => dyadicTimeBin ε r (c_hat ω_h)
  let W_raw : Fin N_hat → ℝ :=
    fun ω_h => (1 + γ) * b_raw (D_hat ω_h) + (1 - γ) * a_raw (D_hat ω_h)
  let E_w_hat : ℝ := ∑ ω_h : Fin N_hat, π_hat ω_h * W_raw ω_h
  let S_raw_hat : ℝ :=
    E_w_hat - finMutualInfo ε π_hat T_hat D_hat + 2 * finCondEntropy ε π_hat T_hat k_r_hat
  let τ_hat : ℝ := classicalRootSupremum ε (1 + m) γ N_hat N_T π_hat T_hat V_part A_part
  have h_raw_def_hat : τ_hat + classicalGrowthRate γ * r - S_raw_hat ≤ η₁ / 2 := by
    dsimp only [stdApertureDeficit] at h_def_t
    dsimp only [τ_hat, S_raw_hat, E_w_hat, W_raw, k_r_hat, T_hat, c_hat] at h_root_eq h_score_comp ⊢
    have h_alg : classicalGrowthRate γ * t - classicalGrowthRate γ * (t - r) =
        classicalGrowthRate γ * r := by ring
    have h_sum_tol : δ_in + δ_loc + η_comp = η₁ / 2 := by
      dsimp only [δ_in, δ_loc, η_comp]
      ring
    linarith [h_def_t, h_score_loc, h_score_comp, h_root_eq, h_alg, h_sum_tol]
  have h_floor_lt : ∀ x : ℝ, x ≤ 1 + m → ⌊x / ξ⌋₊ < K_sh := by
    intro x hx
    have h_div_le : x / ξ ≤ (1 + m) / ξ := div_le_div_of_nonneg_right hx hξ_pos.le
    have h1 : ⌊x / ξ⌋₊ ≤ ⌊(1 + m) / ξ⌋₊ := Nat.floor_mono h_div_le
    have h2 : ⌊(1 + m) / ξ⌋₊ ≤ ⌈(1 + m) / ξ⌉₊ := Nat.floor_le_ceil _
    dsimp only [K_sh]
    omega
  have hb_raw_range : ∀ d_r : Fin N_raw, 0 ≤ b_raw d_r ∧ b_raw d_r ≤ 1 + m := by
    intro d_r
    have hb := h_raw_bds d_r
    exact ⟨le_trans hb_t_nn hb.1,
      by dsimp only [L'] at hb; linarith [hb.2.1, hb.2.2.1, hat_ub, hr_pos]⟩
  have ha_raw_range : ∀ d_r : Fin N_raw, 0 ≤ a_raw d_r ∧ a_raw d_r ≤ 1 + m := by
    intro d_r
    have hb := h_raw_bds d_r
    exact ⟨le_trans hb_t_nn (le_trans hb.1 hb.2.1),
      by dsimp only [L'] at hb; linarith [hb.2.2.1, hat_ub, hr_pos]⟩
  let jb_fn : Fin N_raw → Fin K_sh :=
    fun d_r => ⟨⌊b_raw d_r / ξ⌋₊, h_floor_lt _ (hb_raw_range d_r).2⟩
  let ja_fn : Fin N_raw → Fin K_sh :=
    fun d_r => ⟨⌊a_raw d_r / ξ⌋₊, h_floor_lt _ (ha_raw_range d_r).2⟩
  let Z_shape : Fin N_hat → Fin M_shape :=
    fun ω_h => finProdFinEquiv (jb_fn (D_hat ω_h), ja_fn (D_hat ω_h))
  have h_same_bin_diff : ∀ x₁ x₂ : ℝ, 0 ≤ x₁ → 0 ≤ x₂ →
      ⌊x₁ / ξ⌋₊ = ⌊x₂ / ξ⌋₊ → x₁ ≤ x₂ + ξ := by
    intro x₁ x₂ _ hx₂ h_eq
    have h_lt1 : x₁ / ξ < (⌊x₁ / ξ⌋₊ : ℝ) + 1 := Nat.lt_floor_add_one (x₁ / ξ)
    have h_le2 : (⌊x₂ / ξ⌋₊ : ℝ) ≤ x₂ / ξ := Nat.floor_le (div_nonneg hx₂ hξ_pos.le)
    rw [h_eq] at h_lt1
    have h_div : x₁ / ξ < x₂ / ξ + 1 := lt_of_lt_of_le h_lt1 (by linarith)
    have h_mul := mul_lt_mul_of_pos_right h_div hξ_pos
    rw [div_mul_cancel₀ _ (ne_of_gt hξ_pos), add_mul,
      div_mul_cancel₀ _ (ne_of_gt hξ_pos), one_mul] at h_mul
    exact h_mul.le
  let p_Z : Fin M_shape → ℝ :=
    fun z => ∑ ω_h : Fin N_hat, if Z_shape ω_h = z then π_hat ω_h else 0
  let π_Z : Fin M_shape → Fin N_hat → ℝ :=
    fun z ω_h => if Z_shape ω_h = z then π_hat ω_h / p_Z z else 0
  have hp_Z_nn : ∀ z : Fin M_shape, 0 ≤ p_Z z :=
    fun z => Finset.sum_nonneg (fun ω_h _ => by
      split_ifs
      · exact h_law_hat.1 ω_h
      · exact le_rfl)
  have hp_Z_sum : ∑ z : Fin M_shape, p_Z z = 1 := by
    dsimp only [p_Z]
    rw [Finset.sum_comm]
    have h_inner : ∀ ω_h : Fin N_hat,
        (∑ z : Fin M_shape, if Z_shape ω_h = z then π_hat ω_h else 0) = π_hat ω_h := by
      intro ω_h
      simp
    simp_rw [h_inner]
    exact h_law_hat.2.1
  let S_hat_pos : Finset (Fin N_hat) :=
    @Finset.filter (Fin N_hat) (fun ω_h => 0 < π_hat ω_h) (Classical.decPred _) Finset.univ
  let E_z : Fin M_shape → Finset (Fin N_hat) :=
    fun z => S_hat_pos.filter (fun ω_h => Z_shape ω_h = z)
  have hEz_ne : ∀ z : Fin M_shape, 0 < p_Z z → (E_z z).Nonempty := by
    intro z hpz
    by_contra h_empty
    rw [Finset.not_nonempty_iff_eq_empty] at h_empty
    have h_zero : p_Z z = 0 := by
      refine Finset.sum_eq_zero (fun ω_h _ => ?_)
      by_cases hz : Z_shape ω_h = z
      · rw [if_pos hz]
        by_contra h_ne
        have h_pos : 0 < π_hat ω_h := lt_of_le_of_ne (h_law_hat.1 ω_h) (Ne.symm h_ne)
        have h_in_pos : ω_h ∈ S_hat_pos := Finset.mem_filter.mpr ⟨Finset.mem_univ _, h_pos⟩
        have h_mem : ω_h ∈ E_z z := Finset.mem_filter.mpr ⟨h_in_pos, hz⟩
        simp [h_empty] at h_mem
      · rw [if_neg hz]
    linarith
  let b_star : Fin M_shape → ℝ := fun z =>
    if h : (E_z z).Nonempty then
      b_raw (D_hat (Classical.choose
        (Finset.exists_min_image (E_z z) (fun ω_h => b_raw (D_hat ω_h)) h)))
    else b_t
  let a_star : Fin M_shape → ℝ := fun z =>
    if h : (E_z z).Nonempty then
      a_raw (D_hat (Classical.choose
        (Finset.exists_min_image (E_z z) (fun ω_h => a_raw (D_hat ω_h)) h)))
    else a_t
  have h_star_props : ∀ z : Fin M_shape, 0 < p_Z z →
      b_t ≤ b_star z ∧ b_star z ≤ a_star z ∧ a_star z + r ≤ a_t + t ∧
      (∀ ω_h : Fin N_hat, 0 < π_Z z ω_h →
        0 < π_hat ω_h ∧
        b_star z ≤ b_raw (D_hat ω_h) ∧ b_raw (D_hat ω_h) ≤ b_star z + ξ ∧
        a_star z ≤ a_raw (D_hat ω_h) ∧ a_raw (D_hat ω_h) ≤ a_star z + ξ) := by
    intro z hpz
    have hne := hEz_ne z hpz
    let ω_b := Classical.choose
      (Finset.exists_min_image (E_z z) (fun ω_h => b_raw (D_hat ω_h)) hne)
    have hω_b := Classical.choose_spec
      (Finset.exists_min_image (E_z z) (fun ω_h => b_raw (D_hat ω_h)) hne)
    let ω_a := Classical.choose
      (Finset.exists_min_image (E_z z) (fun ω_h => a_raw (D_hat ω_h)) hne)
    have hω_a := Classical.choose_spec
      (Finset.exists_min_image (E_z z) (fun ω_h => a_raw (D_hat ω_h)) hne)
    have hb_eq : b_star z = b_raw (D_hat ω_b) := dif_pos hne
    have ha_eq : a_star z = a_raw (D_hat ω_a) := dif_pos hne
    have hω_b_z : Z_shape ω_b = z := (Finset.mem_filter.mp hω_b.1).2
    have hω_a_z : Z_shape ω_a = z := (Finset.mem_filter.mp hω_a.1).2
    have hb_ge_bt : b_t ≤ b_star z := by
      rw [hb_eq]
      exact (h_raw_bds (D_hat ω_b)).1
    have hba_star : b_star z ≤ a_star z := by
      rw [hb_eq, ha_eq]
      exact le_trans (hω_b.2 ω_a hω_a.1) (h_raw_bds (D_hat ω_a)).2.1
    have ha_ub_star : a_star z + r ≤ a_t + t := by
      rw [ha_eq]
      have h1 := (h_raw_bds (D_hat ω_a)).2.2.1
      dsimp only [L'] at h1
      linarith
    refine ⟨hb_ge_bt, hba_star, ha_ub_star, fun ω_h hπ_z => ?_⟩
    dsimp only [π_Z] at hπ_z
    by_cases hz : Z_shape ω_h = z
    · rw [if_pos hz] at hπ_z
      have hπ_pos : 0 < π_hat ω_h := by
        have h_mul := mul_pos hπ_z hpz
        rwa [div_mul_cancel₀ _ (ne_of_gt hpz)] at h_mul
      have h_in_pos : ω_h ∈ S_hat_pos := Finset.mem_filter.mpr ⟨Finset.mem_univ _, hπ_pos⟩
      have h_mem : ω_h ∈ E_z z := Finset.mem_filter.mpr ⟨h_in_pos, hz⟩
      have h_eq_b_bin : ⌊b_raw (D_hat ω_h) / ξ⌋₊ = ⌊b_raw (D_hat ω_b) / ξ⌋₊ := by
        have hZ_eq : Z_shape ω_h = Z_shape ω_b := hz.trans hω_b_z.symm
        have h_pair := finProdFinEquiv.injective hZ_eq
        have h_fst : jb_fn (D_hat ω_h) = jb_fn (D_hat ω_b) := congr_arg Prod.fst h_pair
        exact congr_arg Fin.val h_fst
      have h_eq_a_bin : ⌊a_raw (D_hat ω_h) / ξ⌋₊ = ⌊a_raw (D_hat ω_a) / ξ⌋₊ := by
        have hZ_eq : Z_shape ω_h = Z_shape ω_a := hz.trans hω_a_z.symm
        have h_pair := finProdFinEquiv.injective hZ_eq
        have h_snd : ja_fn (D_hat ω_h) = ja_fn (D_hat ω_a) := congr_arg Prod.snd h_pair
        exact congr_arg Fin.val h_snd
      rw [hb_eq, ha_eq]
      exact ⟨hπ_pos, hω_b.2 ω_h h_mem,
        h_same_bin_diff _ _ (hb_raw_range _).1 (hb_raw_range _).1 h_eq_b_bin,
        hω_a.2 ω_h h_mem,
        h_same_bin_diff _ _ (ha_raw_range _).1 (ha_raw_range _).1 h_eq_a_bin⟩
    · rw [if_neg hz] at hπ_z
      exact absurd hπ_z (lt_irrefl 0)
  let θ_obs_hat : Fin L_obs → Fin N_hat → ℝ :=
    fun l ω_h => θ_det l (T_hat ω_h) (dyadicTimeBin ε (u_obs l) (c_hat ω_h))
  let θ_r_hat : Fin N_hat → ℝ := fun ω_h => φ_raw (D_hat ω_h)
  let Δ_obs : Fin L_obs → Fin M_shape → ℝ :=
    fun l z => stdApertureDeficit ε γ (1 + m) (u_obs l) (b_obs l) (a_obs l)
      (π_Z z) T_hat V_part A_part c_hat (θ_obs_hat l)
  let Δ_r : Fin M_shape → ℝ :=
    fun z => stdApertureDeficit ε γ (1 + m) r (b_star z) (a_star z)
      (π_Z z) T_hat V_part A_part c_hat θ_r_hat
  have h_avg_obs : ∀ l : Fin L_obs, ∑ z : Fin M_shape, p_Z z * Δ_obs l z ≤ η₁ := by
    intro l
    let G_l : Fin N_hat → ℤ × ℤ × ℤ × ℤ × ℤ × ℤ := fun ω_h =>
      stdApertureObs ε (u_obs l) (b_obs l) (a_obs l)
        (V_part (T_hat ω_h)) (A_part (T_hat ω_h)) (c_hat ω_h) (θ_obs_hat l ω_h)
    let k_ul : Fin N_hat → ℤ := fun ω_h => dyadicTimeBin ε (u_obs l) (c_hat ω_h)
    obtain ⟨_, h_sp_root, h_sp_mi⟩ :=
      h_tag_split ε (u_obs l) π_hat T_hat V_part A_part c_hat Z_shape G_l
        hε_pos hε_half hM_shape_pos h_law_hat
    change (∑ z : Fin M_shape, p_Z z *
        classicalRootSupremum ε (1 + m) γ N_hat N_T (π_Z z) T_hat V_part A_part) ≤
      τ_hat + finMutualInfo ε π_hat T_hat Z_shape at h_sp_root
    change (∑ z : Fin M_shape, p_Z z *
        (finMutualInfo ε (π_Z z) T_hat G_l - 2 * finCondEntropy ε (π_Z z) T_hat k_ul)) ≤
      (finMutualInfo ε π_hat T_hat G_l - 2 * finCondEntropy ε π_hat T_hat k_ul) -
        finMutualInfo ε π_hat T_hat Z_shape +
        (3 * Real.log (M_shape : ℝ)) / Real.log (ε⁻¹) at h_sp_mi
    have h_def_hat_l : stdApertureDeficit ε γ (1 + m) (u_obs l) (b_obs l) (a_obs l)
        π_hat T_hat V_part A_part c_hat (θ_obs_hat l) ≤ δ_in := by
      have h_eq := h_def_pull (u_obs l) (b_obs l) (a_obs l)
        (fun ω => θ_det l (T_idx ω) (dyadicTimeBin ε (u_obs l) (c_s ω)))
      dsimp only [θ_obs_hat, T_hat, c_hat]
      rw [h_eq]
      exact h_def_in l
    let C_const : ℝ := classicalGrowthRate γ * u_obs l -
      ((1 + γ) * b_obs l + (1 - γ) * a_obs l)
    have h_expand : (∑ z : Fin M_shape, p_Z z * Δ_obs l z) =
        (∑ z : Fin M_shape, p_Z z *
          classicalRootSupremum ε (1 + m) γ N_hat N_T (π_Z z) T_hat V_part A_part) +
        (∑ z : Fin M_shape, p_Z z) * C_const +
        (∑ z : Fin M_shape, p_Z z *
          (finMutualInfo ε (π_Z z) T_hat G_l - 2 * finCondEntropy ε (π_Z z) T_hat k_ul)) := by
      rw [Finset.sum_mul, ← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl (fun z _ => ?_)
      dsimp only [Δ_obs, stdApertureDeficit, stdApertureScore, C_const, G_l, k_ul]
      ring
    rw [h_expand, hp_Z_sum, one_mul]
    dsimp only [stdApertureDeficit, stdApertureScore] at h_def_hat_l
    change τ_hat + classicalGrowthRate γ * u_obs l -
        (((1 + γ) * b_obs l + (1 - γ) * a_obs l) -
          finMutualInfo ε π_hat T_hat G_l + 2 * finCondEntropy ε π_hat T_hat k_ul) ≤ δ_in
      at h_def_hat_l
    dsimp only [C_const, τ_hat] at h_def_hat_l ⊢
    dsimp only [δ_in] at h_def_hat_l
    linarith [h_sp_root, h_sp_mi, h_def_hat_l, h_log1_le, hη₁_pos]
  obtain ⟨h_law_Z, h_sp_root_r, h_sp_mi_r⟩ :=
    h_tag_split ε r π_hat T_hat V_part A_part c_hat Z_shape D_hat
      hε_pos hε_half hM_shape_pos h_law_hat
  change ∀ z : Fin M_shape, 0 < p_Z z → IsUnitBallTimeLaw (π_Z z) V_part A_part c_hat at h_law_Z
  change (∑ z : Fin M_shape, p_Z z *
      classicalRootSupremum ε (1 + m) γ N_hat N_T (π_Z z) T_hat V_part A_part) ≤
    τ_hat + finMutualInfo ε π_hat T_hat Z_shape at h_sp_root_r
  change (∑ z : Fin M_shape, p_Z z *
      (finMutualInfo ε (π_Z z) T_hat D_hat - 2 * finCondEntropy ε (π_Z z) T_hat k_r_hat)) ≤
    (finMutualInfo ε π_hat T_hat D_hat - 2 * finCondEntropy ε π_hat T_hat k_r_hat) -
      finMutualInfo ε π_hat T_hat Z_shape +
      (3 * Real.log (M_shape : ℝ)) / Real.log (ε⁻¹) at h_sp_mi_r
  have h_avg_r : ∑ z : Fin M_shape, p_Z z * Δ_r z ≤ η₁ := by
    let C_r_const : ℝ := classicalGrowthRate γ * r + 2 * ξ + C_rnd / Real.log (ε⁻¹)
    have h_pt : ∀ z : Fin M_shape,
        p_Z z * Δ_r z ≤
          p_Z z * classicalRootSupremum ε (1 + m) γ N_hat N_T (π_Z z) T_hat V_part A_part +
          p_Z z * C_r_const -
          p_Z z * (∑ ω_h : Fin N_hat, π_Z z ω_h * W_raw ω_h) +
          p_Z z * (finMutualInfo ε (π_Z z) T_hat D_hat -
            2 * finCondEntropy ε (π_Z z) T_hat k_r_hat) := by
      intro z
      rcases eq_or_lt_of_le (hp_Z_nn z) with hp0 | hp_pos
      · rw [← hp0]
        simp
      · obtain ⟨hb_ge, hba_z, _, h_supp_z⟩ := h_star_props z hp_pos
        have hb_nn_z : 0 ≤ b_star z := le_trans hb_t_nn hb_ge
        have h_rnd_z := h_rnd ε r (b_star z) (a_star z) ξ
          (π_Z z) T_hat V_part A_part c_hat D_hat k_D b_raw a_raw φ_raw V_glob X_glob
          hε_pos hε_half hr_pos hb_nn_z hba_z hξ_pos.le (h_law_Z z hp_pos)
          (fun d_r => (h_raw_bds d_r).2.2.2)
          (fun ω_h _ => hk_D ω_h)
          (fun ω_h hω => ⟨(h_supp_z ω_h hω).2.1, (h_supp_z ω_h hω).2.2.1,
            (h_supp_z ω_h hω).2.2.2.1, (h_supp_z ω_h hω).2.2.2.2⟩)
          (fun ω_h hω => h_raw_geom ω_h (h_supp_z ω_h hω).1)
        have h_def_z : Δ_r z ≤
            classicalRootSupremum ε (1 + m) γ N_hat N_T (π_Z z) T_hat V_part A_part +
              C_r_const - (∑ ω_h : Fin N_hat, π_Z z ω_h * W_raw ω_h) +
              (finMutualInfo ε (π_Z z) T_hat D_hat -
                2 * finCondEntropy ε (π_Z z) T_hat k_r_hat) := by
          dsimp only [Δ_r, stdApertureDeficit, C_r_const, W_raw, k_r_hat, θ_r_hat] at h_rnd_z ⊢
          linarith [h_rnd_z]
        have h_mul := mul_le_mul_of_nonneg_left h_def_z hp_pos.le
        linarith [h_mul]
    have h_sum_le := Finset.sum_le_sum (fun z (_ : z ∈ Finset.univ) => h_pt z)
    have h_ew_eq : (∑ z : Fin M_shape, p_Z z * (∑ ω_h : Fin N_hat, π_Z z ω_h * W_raw ω_h)) =
        E_w_hat := by
      have h_cell : ∀ (z : Fin M_shape) (ω_h : Fin N_hat),
          p_Z z * (π_Z z ω_h * W_raw ω_h) =
            if Z_shape ω_h = z then π_hat ω_h * W_raw ω_h else 0 := by
        intro z ω_h
        dsimp only [π_Z]
        by_cases hz : Z_shape ω_h = z
        · rw [if_pos hz, if_pos hz]
          by_cases hp0 : p_Z z = 0
          · have hπ0 : π_hat ω_h = 0 := by
              have h_le : π_hat ω_h ≤ p_Z z := by
                have h_single : (if Z_shape ω_h = z then π_hat ω_h else 0) ≤ p_Z z := by
                  dsimp only [p_Z]
                  exact Finset.single_le_sum
                    (f := fun ω' : Fin N_hat => if Z_shape ω' = z then π_hat ω' else (0 : ℝ))
                    (fun ω' _ => by
                      split_ifs
                      · exact h_law_hat.1 ω'
                      · exact le_rfl) (Finset.mem_univ ω_h)
                rwa [if_pos hz] at h_single
              exact le_antisymm (h_le.trans hp0.le) (h_law_hat.1 ω_h)
            simp [hp0, hπ0]
          · rw [← mul_assoc, mul_div_cancel₀ _ hp0]
        · rw [if_neg hz, if_neg hz]
          ring
      have h1 : (∑ z : Fin M_shape, p_Z z * (∑ ω_h : Fin N_hat, π_Z z ω_h * W_raw ω_h)) =
          ∑ z : Fin M_shape, ∑ ω_h : Fin N_hat,
            if Z_shape ω_h = z then π_hat ω_h * W_raw ω_h else 0 := by
        refine Finset.sum_congr rfl (fun z _ => ?_)
        rw [Finset.mul_sum]
        exact Finset.sum_congr rfl (fun ω_h _ => h_cell z ω_h)
      rw [h1, Finset.sum_comm]
      dsimp only [E_w_hat]
      refine Finset.sum_congr rfl (fun ω_h _ => ?_)
      simp
    have h_rhs_eq : (∑ z : Fin M_shape,
        (p_Z z * classicalRootSupremum ε (1 + m) γ N_hat N_T (π_Z z) T_hat V_part A_part +
          p_Z z * C_r_const -
          p_Z z * (∑ ω_h : Fin N_hat, π_Z z ω_h * W_raw ω_h) +
          p_Z z * (finMutualInfo ε (π_Z z) T_hat D_hat -
            2 * finCondEntropy ε (π_Z z) T_hat k_r_hat))) =
      (∑ z : Fin M_shape,
          p_Z z * classicalRootSupremum ε (1 + m) γ N_hat N_T (π_Z z) T_hat V_part A_part) +
        (∑ z : Fin M_shape, p_Z z) * C_r_const -
        (∑ z : Fin M_shape, p_Z z * (∑ ω_h : Fin N_hat, π_Z z ω_h * W_raw ω_h)) +
        (∑ z : Fin M_shape, p_Z z * (finMutualInfo ε (π_Z z) T_hat D_hat -
          2 * finCondEntropy ε (π_Z z) T_hat k_r_hat)) := by
      rw [Finset.sum_mul, Finset.sum_add_distrib, Finset.sum_sub_distrib, Finset.sum_add_distrib]
    rw [h_rhs_eq, hp_Z_sum, one_mul, h_ew_eq] at h_sum_le
    have h_comb_log : C_rnd / Real.log (ε⁻¹) +
        (3 * Real.log (M_shape : ℝ)) / Real.log (ε⁻¹) =
        (3 * Real.log (M_shape : ℝ) + C_rnd) / Real.log (ε⁻¹) := by ring
    have h_xi_val : 2 * ξ = η₁ / 6 := by dsimp only [ξ]; ring
    dsimp only [C_r_const, τ_hat, S_raw_hat] at h_raw_def_hat h_sum_le
    linarith [h_sum_le, h_sp_root_r, h_sp_mi_r, h_raw_def_hat, h_comb_log, h_log2_le, h_xi_val]
  let Tot : Fin M_shape → ℝ := fun z => Δ_r z + ∑ l : Fin L_obs, Δ_obs l z
  have h_tot_avg : ∑ z : Fin M_shape, p_Z z * Tot z ≤ η_step / 2 := by
    have h_split : (∑ z : Fin M_shape, p_Z z * Tot z) =
        (∑ z : Fin M_shape, p_Z z * Δ_r z) +
          ∑ l : Fin L_obs, ∑ z : Fin M_shape, p_Z z * Δ_obs l z := by
      dsimp only [Tot]
      simp_rw [mul_add, Finset.sum_add_distrib, Finset.mul_sum]
      rw [Finset.sum_comm]
    have h_obs_sum : ∑ l : Fin L_obs, ∑ z : Fin M_shape, p_Z z * Δ_obs l z ≤
        (L_obs : ℝ) * η₁ := by
      calc ∑ l : Fin L_obs, ∑ z : Fin M_shape, p_Z z * Δ_obs l z
          ≤ ∑ _l : Fin L_obs, η₁ := Finset.sum_le_sum (fun l _ => h_avg_obs l)
        _ = (L_obs : ℝ) * η₁ := by simp
    have h_eta1_eq : η₁ + (L_obs : ℝ) * η₁ = η_step / 2 := by
      dsimp only [η₁]
      field_simp [ne_of_gt hL1_pos]
      ring
    linarith [h_split, h_avg_r, h_obs_sum, h_eta1_eq]
  let S_pos : Finset (Fin M_shape) :=
    @Finset.filter (Fin M_shape) (fun z => 0 < p_Z z) (Classical.decPred _) Finset.univ
  have hS_pos_ne : S_pos.Nonempty := by
    by_contra h_empty
    rw [Finset.not_nonempty_iff_eq_empty] at h_empty
    have h_zero : ∑ z : Fin M_shape, p_Z z = 0 := by
      refine Finset.sum_eq_zero (fun z _ => ?_)
      by_contra hz_ne
      have hz_pos : 0 < p_Z z := lt_of_le_of_ne (hp_Z_nn z) (Ne.symm hz_ne)
      have h_mem : z ∈ S_pos := Finset.mem_filter.mpr ⟨Finset.mem_univ _, hz_pos⟩
      simp [h_empty] at h_mem
    linarith [hp_Z_sum]
  have h_sum_pos_p : ∑ z ∈ S_pos, p_Z z = 1 := by
    rw [← hp_Z_sum]
    refine Finset.sum_subset (Finset.subset_univ S_pos) (fun z _ hz_not => ?_)
    have h_not_pos : ¬ 0 < p_Z z := fun hp => hz_not (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hp⟩)
    exact le_antisymm (le_of_not_gt h_not_pos) (hp_Z_nn z)
  have h_sum_pos_tot : ∑ z ∈ S_pos, p_Z z * Tot z = ∑ z : Fin M_shape, p_Z z * Tot z := by
    refine Finset.sum_subset (Finset.subset_univ S_pos) (fun z _ hz_not => ?_)
    have h_not_pos : ¬ 0 < p_Z z := fun hp => hz_not (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hp⟩)
    have hp0 : p_Z z = 0 := le_antisymm (le_of_not_gt h_not_pos) (hp_Z_nn z)
    rw [hp0, zero_mul]
  obtain ⟨z_star, hz_star_mem, hz_star_min⟩ := Finset.exists_min_image S_pos Tot hS_pos_ne
  have hp_z_star_pos : 0 < p_Z z_star := (Finset.mem_filter.mp hz_star_mem).2
  have h_tot_z_star : Tot z_star ≤ η_step / 2 := by
    calc Tot z_star
        = 1 * Tot z_star := (one_mul _).symm
      _ = (∑ z ∈ S_pos, p_Z z) * Tot z_star := by rw [h_sum_pos_p]
      _ = ∑ z ∈ S_pos, p_Z z * Tot z_star := Finset.sum_mul _ _ _
      _ ≤ ∑ z ∈ S_pos, p_Z z * Tot z :=
          Finset.sum_le_sum (fun z hz =>
            mul_le_mul_of_nonneg_left (hz_star_min z hz) (hp_Z_nn z))
      _ = ∑ z : Fin M_shape, p_Z z * Tot z := h_sum_pos_tot
      _ ≤ η_step / 2 := h_tot_avg
  obtain ⟨hb_star_ge, hba_z_star, ha_star_ub, _⟩ := h_star_props z_star hp_z_star_pos
  have hb_star_nn : 0 ≤ b_star z_star := le_trans hb_t_nn hb_star_ge
  have ha_star_1m : a_star z_star + r ≤ 1 + m := le_trans ha_star_ub hat_ub
  have h_law_z_star : IsUnitBallTimeLaw (π_Z z_star) V_part A_part c_hat :=
    h_law_Z z_star hp_z_star_pos
  have h_lb_r : -η_lb ≤ Δ_r z_star :=
    h_lb ε r (b_star z_star) (a_star z_star)
      (π_Z z_star) T_hat V_part A_part c_hat θ_r_hat
      hε_pos hε_lt_lb le_rfl hr_le_one hb_star_nn hba_z_star ha_star_1m
      h_law_z_star (fun ω_h _ => (h_raw_bds (D_hat ω_h)).2.2.2)
  have h_lb_obs : ∀ l : Fin L_obs, -η_lb ≤ Δ_obs l z_star :=
    fun l => h_lb ε (u_obs l) (b_obs l) (a_obs l)
      (π_Z z_star) T_hat V_part A_part c_hat (θ_obs_hat l)
      hε_pos hε_lt_lb (hu_obs l).1.le (hu_obs l).2
      (h_ba_obs l).1 (h_ba_obs l).2.1 (h_ba_obs l).2.2
      h_law_z_star (fun _ _ => hθ_det l _ _)
  have h_eta_lb_eq : ((L_obs : ℝ) + 1) * η_lb = η_step / 4 := by
    dsimp only [η_lb]
    field_simp [ne_of_gt hL1_pos]
  have h_r_final : Δ_r z_star ≤ η_step := by
    have h_sum_lb : -(L_obs : ℝ) * η_lb ≤ ∑ l : Fin L_obs, Δ_obs l z_star := by
      calc -(L_obs : ℝ) * η_lb
          = ∑ _l : Fin L_obs, (-η_lb) := by simp
        _ ≤ ∑ l : Fin L_obs, Δ_obs l z_star := Finset.sum_le_sum (fun l _ => h_lb_obs l)
    dsimp only [Tot] at h_tot_z_star
    linarith [h_tot_z_star, h_sum_lb, h_eta_lb_eq, hη_lb_pos, hη]
  have h_obs_final : ∀ l₀ : Fin L_obs, Δ_obs l₀ z_star ≤ η_step := by
    intro l₀
    have h_split_l0 :=
      Finset.add_sum_erase Finset.univ (fun l => Δ_obs l z_star) (Finset.mem_univ l₀)
    have h_card_er : ((Finset.univ.erase l₀).card : ℝ) + 1 = (L_obs : ℝ) := by
      have h_nat : (Finset.univ.erase l₀).card + 1 = L_obs := by
        simpa using Finset.card_erase_add_one (Finset.mem_univ l₀)
      exact_mod_cast h_nat
    have h_er_lb : -((Finset.univ.erase l₀).card : ℝ) * η_lb ≤
        ∑ l ∈ Finset.univ.erase l₀, Δ_obs l z_star := by
      calc -((Finset.univ.erase l₀).card : ℝ) * η_lb
          = ∑ _l ∈ Finset.univ.erase l₀, (-η_lb) := by simp
        _ ≤ ∑ l ∈ Finset.univ.erase l₀, Δ_obs l z_star :=
            Finset.sum_le_sum (fun l _ => h_lb_obs l)
    have h_er_alg : ((Finset.univ.erase l₀).card : ℝ) * η_lb + η_lb = (L_obs : ℝ) * η_lb := by
      calc ((Finset.univ.erase l₀).card : ℝ) * η_lb + η_lb
          = (((Finset.univ.erase l₀).card : ℝ) + 1) * η_lb := by ring
        _ = (L_obs : ℝ) * η_lb := by rw [h_card_er]
    dsimp only [Tot] at h_tot_z_star
    linarith [h_tot_z_star, h_split_l0, h_lb_r, h_er_lb, h_er_alg, h_eta_lb_eq, hη_lb_pos, hη]
  exact ⟨N_hat, π_Z z_star, T_hat, c_hat, b_star z_star, a_star z_star, θ_r_hat,
    h_law_z_star, hb_star_ge, hba_z_star, ha_star_ub,
    fun ω_h _ => (h_raw_bds (D_hat ω_h)).2.2.2,
    h_obs_final, h_r_final⟩

theorem finite_tag_splitting_and_time_homogenization (γ m : ℝ) (hγ₀ : 0 < γ) (hγ₁ : γ < 1) (hm : 0 ≤ m)
    (h_two : (2 : ℝ) ∈ ValidClassicalGrowthRates γ) :
    (∀ (u_min c₀ η_out : ℝ), 0 < u_min → u_min ≤ 1 → 0 < c₀ → 0 < η_out →
      ∃ (δ_in ε₀ : ℝ), 0 < δ_in ∧ 0 < ε₀ ∧ ε₀ < 1 / 2 ∧
        ∀ (ε u₁ b₁ a₁ u₂ b₂ a₂ : ℝ),
          0 < ε → ε < ε₀ →
          u_min ≤ u₁ → u₁ ≤ 1 → 0 ≤ b₁ → b₁ ≤ a₁ → a₁ + u₁ ≤ 1 + m →
          u_min ≤ u₂ → u₂ ≤ 1 → 0 ≤ b₂ → b₂ ≤ a₂ → a₂ + u₂ ≤ 1 + m →
        ∀ {N_ω N_T : ℕ} (π : Fin N_ω → ℝ) (T_idx : Fin N_ω → Fin N_T)
          (V_part A_part : Fin N_T → EuclideanSpace ℝ (Fin 2))
          (c_s θ₁ θ₂ : Fin N_ω → ℝ) (E : Fin N_ω → Bool),
          IsUnitBallTimeLaw π V_part A_part c_s →
          (∀ ω, 0 < π ω → θ₁ ω ∈ Set.Ico (0 : ℝ) Real.pi ∧ θ₂ ω ∈ Set.Ico (0 : ℝ) Real.pi) →
          stdApertureDeficit ε γ (1 + m) u₁ b₁ a₁ π T_idx V_part A_part c_s θ₁ ≤ δ_in →
          stdApertureDeficit ε γ (1 + m) u₂ b₂ a₂ π T_idx V_part A_part c_s θ₂ ≤ δ_in →
          c₀ ≤ (∑ ω : Fin N_ω, if E ω then π ω else 0) →
          ∃ π_E : Fin N_ω → ℝ,
            IsUnitBallTimeLaw π_E V_part A_part c_s ∧
            (∀ ω, 0 < π_E ω → E ω = true ∧ 0 < π ω) ∧
