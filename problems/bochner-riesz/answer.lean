    have hPDE_nn : ∀ d e, 0 ≤ P_DE d e := fun d e => Finset.sum_nonneg (fun α _ => hP_nn α d)
    have hPEM_nn : ∀ e m, 0 ≤ P_EM e m := fun e m => Finset.sum_nonneg (fun α _ => hPT_nn α)
