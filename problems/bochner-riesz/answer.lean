    let R_inv : EuclideanSpace ℝ (Fin 2) → EuclideanSpace ℝ (Fin 2) := fun z =>
      WithLp.toLp 2 (fun i : Fin 2 => if i = 0 then inner ℝ z e else inner ℝ z (perp2D e))
    let R_e : EuclideanSpace ℝ (Fin 2) ≃ₗᵢ[ℝ] EuclideanSpace ℝ (Fin 2) :=
