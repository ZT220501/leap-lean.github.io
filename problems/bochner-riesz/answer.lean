      field_simp [hd_ne, h_ell_ne]

    · 
      intro ν κ
      constructor
      · intro hgap_sc N_D' b a e_dir V_c X_c p' h_ap h_wid hp_nn hp_out hp_sum h_cap
        have h_est := hgap_sc N_D' (fun j => b j / d) (fun j => a j / d)
