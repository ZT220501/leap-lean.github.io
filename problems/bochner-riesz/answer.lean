      rw [hell_eq]
      have hne : Real.log ε ≠ 0 := by linarith [hell_pos, hell_eq]
      field_simp [hne]
    rw [h_exp, Real.exp_log hσ_min_pos]
  have h_cs_bound : ∀ (u : EuclideanSpace ℝ (Fin 2)) (R : ℝ),
      0 ≤ R →
      |inner ℝ u e_D| ≤ R * t₁ →
      |inner ℝ u (perp2D e_D)| ≤ R * t₂ →
