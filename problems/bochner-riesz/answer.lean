          p_TG tid g * (-Real.log (p_G g) + Real.log (p_TG tid g / p_T tid)) =
        ∑ ω : Fin M_ω,
          Q ω * (-Real.log (finProbAt2 Q (fun _ => ()) B_obs ω / finProbAt Q (fun _ => ()) ω) +
            Real.log (finProbAt2 Q T_idx B_obs ω / finProbAt Q T_idx ω)) := by
        have h_step1 : ∀ (tid : Fin M_T) (g : Fin N_G),
            p_TG tid g * (-Real.log (p_G g) + Real.log (p_TG tid g / p_T tid)) =
            ∑ ω : Fin M_ω, if T_idx ω = tid ∧ G_idx ω = g then
              Q ω * (-Real.log (finProbAt2 Q (fun _ => ()) B_obs ω / finProbAt Q (fun _ => ()) ω) +
                Real.log (finProbAt2 Q T_idx B_obs ω / finProbAt Q T_idx ω))
            else 0 := by
          intro tid g
          have h_exp : p_TG tid g * (-Real.log (p_G g) + Real.log (p_TG tid g / p_T tid)) =
              ∑ ω : Fin M_ω, (if T_idx ω = tid ∧ G_idx ω = g then Q ω else 0) *
                (-Real.log (p_G g) + Real.log (p_TG tid g / p_T tid)) := by
            dsimp [p_TG]
            rw [Finset.sum_mul]
          rw [h_exp]
          refine Finset.sum_congr rfl (fun ω _ => ?_)
          split_ifs with h_eq
          · rcases h_eq with ⟨rfl, rfl⟩
            have hp_unit : finProbAt Q (fun _ => ()) ω = 1 := by
              unfold finProbAt
              classical simp [hQ_sum]
            have hp2_unit : finProbAt2 Q (fun _ => ()) B_obs ω = p_G (G_idx ω) := by
              unfold finProbAt2
              dsimp [p_G]
              refine Finset.sum_congr rfl (fun ω' _ => ?_)
              classical simp [hG_iff ω' ω]
            have hp2_T : finProbAt2 Q T_idx B_obs ω = p_TG (T_idx ω) (G_idx ω) := by
              unfold finProbAt2
              dsimp [p_TG]
              refine Finset.sum_congr rfl (fun ω' _ => ?_)
              classical simp [hG_iff ω' ω]
            have hp_T_eq : finProbAt Q T_idx ω = p_T (T_idx ω) := by
              unfold finProbAt
              dsimp [p_T]
              refine Finset.sum_congr rfl (fun ω' _ => ?_)
              classical simp
            rw [hp_unit, hp2_unit, div_one, hp2_T, hp_T_eq]
          · ring
        simp_rw [h_step1]
        rw [Finset.sum_comm]
        conv_lhs =>
          arg 2
          ext g
          rw [Finset.sum_comm]
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl (fun ω _ => ?_)
        have h_inner_sum : ∀ g : Fin N_G,
            (∑ tid : Fin M_T, if T_idx ω = tid ∧ G_idx ω = g then
              Q ω * (-Real.log (finProbAt2 Q (fun _ => ()) B_obs ω / finProbAt Q (fun _ => ()) ω) +
                Real.log (finProbAt2 Q T_idx B_obs ω / finProbAt Q T_idx ω))
            else 0) =
            if g = G_idx ω then
              Q ω * (-Real.log (finProbAt2 Q (fun _ => ()) B_obs ω / finProbAt Q (fun _ => ()) ω) +
                Real.log (finProbAt2 Q T_idx B_obs ω / finProbAt Q T_idx ω))
            else 0 := by
