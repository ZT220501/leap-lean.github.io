            then threeReplicaStar blk l i b.1 b.2.1 b₂ else 0
        simp [h_eq, P_law]
      · change (if (some b.1, some b.2.1) = (some b.1, some b.2.1) ∧
            ((0 : Fin 4), dyadicRealBin ρ d (inner ℝ e_dir (paramVec blk l b₂))) = (0, k_cur)
          then P_law l (b.1, b.2.1, b₂) else 0) =
