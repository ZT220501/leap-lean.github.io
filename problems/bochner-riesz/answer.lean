        have hb' := mul_le_mul_of_nonneg_left h1 hB_sys_nn
        have ha' := mul_le_mul_of_nonneg_left h2 hB_sys_nn
        linarith only [hproj, hwV3_b, hwV3_a, hb', ha']
      have hwX3_norm : ‖w_X3‖ ≤ 2 * cls.B_sys * ε ^ (2 * h) := by
        have h1 : ε ^ (b_D d - b_star + 2 * h) ≤ ε ^ (2 * h) :=
          Real.rpow_le_rpow_of_exponent_ge hε₀ hε_le1 (by linarith only [hb_ge])
        have h2 : ε ^ (a_D d - b_star + 2 * h) ≤ ε ^ (2 * h) :=
          Real.rpow_le_rpow_of_exponent_ge hε₀ hε_le1 (by linarith only [hb_ge, hba])
