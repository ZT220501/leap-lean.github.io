    dsimp [μ]
    rw [norm_mul, norm_mul, Complex.norm_exp_I_mul_ofReal, mul_one,
      norm_inv, Complex.norm_real, Real.norm_of_nonneg hC_χ_pos.le]
    calc C_χ⁻¹ * ‖(pktPou2D y : ℂ)‖
        ≤ C_χ⁻¹ * C_χ := mul_le_mul_of_nonneg_left hy_pou (inv_nonneg.mpr hC_χ_pos.le)
      _ = 1 := inv_mul_cancel₀ hC_χ_pos.ne'

  have hRh_pos : 0 < (B_cell + 4) * ρ := by positivity
  obtain ⟨⟨B₀, hB₀_nn, hJ_op_bd⟩, hΨ_nn, hΨ_int, hΨ_strip_bd⟩ :=
    modulated_strip_tsum_integral_bound Φ₀ hΦ₀_cont lam_loc ρ σ c_end ((B_cell + 4) * ρ) M_strip 9
      hρ hσ hRh_pos hM_strip (by norm_num) V_P x_Z n_P R_strip hR_comp
      h_W hh_W_cont hh_W_supp J_pat w hw_nn hw_sum hw_le μ hμ_cont hμ_le
      (fun j hj n => h_mod (μ j n) (hμ_cont j hj n) (hμ_le j hj n))

  let J_op : (ℤ × ℤ) → (ℤ × ℤ) → EuclideanSpace ℝ (Fin 2) → ℂ := fun j n x =>
    (ρ⁻¹ : ℂ) * ∫ v : EuclideanSpace ℝ (Fin 2),
      h_W v * μ j n v *
        Complex.exp (Complex.I * ((lam_loc * Φ₀ (c_end, x, v) : ℝ) : ℂ))
  let Ψ : ℝ × ℝ → ℝ := fun p =>
    ∑ j ∈ J_pat, ∑' n : ℤ × ℤ, w n * ‖J_op j n (x_Z + p.1 • n_P + p.2 • perp2D n_P)‖ ^ 2
  let I_W : Fin N_obs → ℂ := fun o =>
    (ρ⁻¹ : ℂ) * ∫ v : EuclideanSpace ℝ (Fin 2),
      h_W v * ψ_O o (ρ⁻¹ • (v - V_O o)) *
        Complex.exp (Complex.I * ((lam_loc * Φ₀ (c_end, X_O o, v) : ℝ) : ℂ))

  
  have h_pt_gabor : ∀ o ∈ S_Z, ∀ p : ℝ × ℝ,
      ‖(x_Z + p.1 • n_P + p.2 • perp2D n_P) - X_O o‖ ≤ σ →
      ‖I_W o‖ ^ 2 ≤ K_pt * Ψ p := by
    intro o _ p hx_dist
    let x : EuclideanSpace ℝ (Fin 2) := x_Z + p.1 • n_P + p.2 • perp2D n_P
    have hXo_x : ‖X_O o - x‖ ≤ (lam_loc * ρ)⁻¹ := by
      rw [norm_sub_rev]
      exact hx_dist
    let Φ_zero : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ := fun _ => 0
    let F_ox : EuclideanSpace ℝ (Fin 2) → ℂ := fun z =>
      ψ_O o (z + ρ⁻¹ • (V_P - V_O o)) *
        Complex.exp (Complex.I *
          ((lam_loc * (Φ₀ (c_end, X_O o, V_P + ρ • z) -
            Φ₀ (c_end, x, V_P + ρ • z)) : ℝ) : ℂ))
    let g_x : EuclideanSpace ℝ (Fin 2) → ℂ := fun z =>
