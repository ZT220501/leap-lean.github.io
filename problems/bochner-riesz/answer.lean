          mul_le_mul_of_nonneg_left hζ_lip (mul_nonneg hlam_pos.le hρ₀_pos.le)
      _ ≤ (lam_sys * ρ₀) * (A * ρ₀) :=
          mul_le_mul_of_nonneg_left
            (mul_le_mul_of_nonneg_left hX_err (by linarith))
            (mul_nonneg hlam_pos.le hρ₀_pos.le)
      _ = A * (lam_sys * ρ₀ ^ 2) := by ring
      _ = A := by rw [hlam_ρ₀_sq, mul_one]
  have hθ_deriv : ∀ (i : ℕ), 1 ≤ i → ∀ (z : E), ‖z‖ ≤ 2 →
