            calc ‖V_o - V_at‖ = ‖(V_o - v) + (v - V_at)‖ := by congr 1; abel
              _ ≤ ‖V_o - v‖ + ‖v - V_at‖ := norm_add_le _ _
              _ = ‖v - V_o‖ + ‖v - V_at‖ := by rw [norm_sub_rev]
          have hv_o : cls.R_win * ρ_t ≤ ‖v - V_o‖ := by linarith
          have h_n2 : cls.R_win ≤ ‖ρ_t⁻¹ • (v - V_o)‖ := by
