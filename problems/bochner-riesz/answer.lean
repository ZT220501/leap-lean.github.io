    have hm1_e : inner ℝ m₁ e_G = t₁ * (e_D 0 * g₀ + e_D 1 * g₁) := by
      rw [inner_eq m₁ e_G, hm₁_0, hm₁_1]
      dsimp only [g₀, g₁]
      rw [inner_eq e_J e_G, inner_eq (perp2D e_J) e_G]
      have hp0 : (perp2D e_J) 0 = -(e_J 1) := by simp [perp2D]
      have hp1 : (perp2D e_J) 1 = e_J 0 := by simp [perp2D]
      rw [hp0, hp1]
      ring
    have hm2_e : inner ℝ m₂ e_G = t₂ * (-(e_D 1) * g₀ + e_D 0 * g₁) := by
      rw [inner_eq m₂ e_G, hm₂_0, hm₂_1]
      dsimp only [g₀, g₁]
      rw [inner_eq e_J e_G, inner_eq (perp2D e_J) e_G]
      have hp0 : (perp2D e_J) 0 = -(e_J 1) := by simp [perp2D]
      have hp1 : (perp2D e_J) 1 = e_J 0 := by simp [perp2D]
      rw [hp0, hp1]
      ring
    have h_rot : (e_D 0 * g₀ + e_D 1 * g₁) ^ 2 + (-(e_D 1) * g₀ + e_D 0 * g₁) ^ 2 =
