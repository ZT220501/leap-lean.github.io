        have hY_strip : |inner ℝ (fineCellCenterX S_X τ_X p_c.2.2 - fineCellCenterX S_X τ_X p_ref0.2.2)
            (perp2D (e_D d))| ≤ (4 * B_sys + 2 * (M_L : ℝ)) * ε ^ (r + u_t - 2 * ζ_sh) := by
          have hid : fineCellCenterX S_X τ_X p_c.2.2 - fineCellCenterX S_X τ_X p_ref0.2.2 =
