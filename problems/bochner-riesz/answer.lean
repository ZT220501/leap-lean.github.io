  obtain ⟨_, h_root_gen, h_lb_gen⟩ := s1_root_and_deficit_lb
  refine ⟨?_, ?_, s2_deficit_transfer, ?_⟩
  · intro ε N_ω N_T π T_idx V_part A_part c_s hε₀ hε₁ h_law
    exact h_root_gen ε (1 + m) π T_idx V_part A_part c_s hε₀ hε₁ (by linarith) h_law
  · intro u_min η hu_min0 hu_min1 hη
    obtain ⟨ε₀, hε₀_pos, hε₀_lt, h_lb⟩ :=
      h_lb_gen (1 + m) u_min η (by linarith) hu_min0 hu_min1 hη
    exact ⟨ε₀, hε₀_pos, hε₀_lt, fun ε u b a _ _ π T_idx V_part A_part c_s θ_s
      hε₀ hε_lt hu_lo hu_hi hb₀ hba hau h_law hθ =>
      h_lb ε (1 + m) u b a π T_idx V_part A_part c_s θ_s
        hε₀ hε_lt hu_lo hu_hi le_rfl hb₀ hba hau h_law hθ⟩
  · intro u b_u a_u hu₀ hu₁ hb_u ha_u hau_m
    rintro ⟨ε_seq, N_ω, N_T, π_seq, T_seq, V_seq, A_seq, c_seq, θ_seq,
      hε_bds, hε_lim, h_laws, h_def_lim⟩
    let e_u := a_u - b_u
    have he_u_nn : 0 ≤ e_u := sub_nonneg.mpr ha_u
    have hu_ne : u ≠ 0 := hu₀.ne'
    obtain ⟨C_loc, hC_loc_nn, h_loc⟩ := s3_zero_base_loc
    have h_loc_n : ∀ n : ℕ,
        ∃ (π' : Fin (N_ω n) → ℝ) (V' A' : Fin (N_T n) → EuclideanSpace ℝ (Fin 2)),
          IsUnitBallTimeLaw π' V' A' (c_seq n) ∧
          (∀ ω, 0 < π' ω → 0 < π_seq n ω) ∧
          stdApertureDeficit (ε_seq n) γ (e_u + u) u 0 e_u
            π' (T_seq n) V' A' (c_seq n) (θ_seq n) ≤
            stdApertureDeficit (ε_seq n) γ (1 + m) u b_u a_u
              (π_seq n) (T_seq n) (V_seq n) (A_seq n) (c_seq n) (θ_seq n) +
              C_loc / Real.log ((ε_seq n)⁻¹) :=
      fun n => h_loc (ε_seq n) u b_u a_u (π_seq n) (T_seq n) (V_seq n) (A_seq n)
        (c_seq n) (θ_seq n) (hε_bds n).1 (hε_bds n).2 hu₀ hu₁ hb_u ha_u hau_m
        (h_laws n).1 (h_laws n).2
    choose π'_seq V'_seq A'_seq h'_spec using h_loc_n
    let Δ' : ℕ → ℝ := fun n =>
      stdApertureDeficit (ε_seq n) γ (e_u + u) u 0 e_u
        (π'_seq n) (T_seq n) (V'_seq n) (A'_seq n) (c_seq n) (θ_seq n)
    have hΔ'_lim : Filter.Tendsto Δ' Filter.atTop (nhds 0) := by
      rw [Metric.tendsto_atTop]
      intro η hη
      obtain ⟨ε_lb, hε_lb_pos, _, h_lb⟩ :=
        h_lb_gen (1 + m) u (η / 2) (by linarith) hu₀ hu₁ (half_pos hη)
      let M_log : ℝ := 2 * (C_loc + 1) / η
      have hM_pos : 0 < M_log := div_pos (by linarith) hη
      let ε_log : ℝ := Real.exp (-M_log)
      have hε_log_pos : 0 < ε_log := Real.exp_pos _
      obtain ⟨N₁, hN₁⟩ := (Metric.tendsto_atTop.mp hε_lim) (min ε_lb ε_log)
        (lt_min hε_lb_pos hε_log_pos)
      obtain ⟨N₂, hN₂⟩ := (Metric.tendsto_atTop.mp h_def_lim) (η / 2) (half_pos hη)
      refine ⟨max N₁ N₂, fun n hn => ?_⟩
      have hε_n_pos : 0 < ε_seq n := (hε_bds n).1
      have hε_dist := hN₁ n (le_trans (le_max_left _ _) hn)
      rw [Real.dist_eq, sub_zero, abs_of_pos hε_n_pos] at hε_dist
      have hε_lt_lb : ε_seq n < ε_lb := lt_of_lt_of_le hε_dist (min_le_left _ _)
      have hε_lt_log : ε_seq n < ε_log := lt_of_lt_of_le hε_dist (min_le_right _ _)
      have h_lo : -(η / 2) ≤ Δ' n :=
        h_lb (ε_seq n) (e_u + u) u 0 e_u (π'_seq n) (T_seq n) (V'_seq n) (A'_seq n)
          (c_seq n) (θ_seq n) hε_n_pos hε_lt_lb le_rfl hu₁
          (by dsimp [e_u]; linarith) le_rfl he_u_nn le_rfl
          (h'_spec n).1 (fun ω hω => (h_laws n).2 ω ((h'_spec n).2.1 ω hω))
      have h_inv_gt : Real.exp M_log < (ε_seq n)⁻¹ := by
        have := inv_strictAnti₀ hε_n_pos hε_lt_log
        rwa [← Real.exp_neg, neg_neg] at this
      have h_log_gt : M_log < Real.log ((ε_seq n)⁻¹) := by
        have := Real.log_lt_log (Real.exp_pos M_log) h_inv_gt
        rwa [Real.log_exp] at this
      have h_cloc_lt : C_loc / Real.log ((ε_seq n)⁻¹) < η / 2 := by
        calc C_loc / Real.log ((ε_seq n)⁻¹)
            ≤ C_loc / M_log := div_le_div_of_nonneg_left hC_loc_nn hM_pos h_log_gt.le
          _ < (C_loc + 1) / M_log := div_lt_div_of_pos_right (by linarith) hM_pos
          _ = η / 2 := by
              dsimp [M_log]
              have hC1_ne : C_loc + 1 ≠ 0 := by linarith
              field_simp [hC1_ne, hη.ne']
      have hΔ_dist := hN₂ n (le_trans (le_max_right _ _) hn)
      rw [Real.dist_eq, sub_zero] at hΔ_dist
      have hΔ_lt : stdApertureDeficit (ε_seq n) γ (1 + m) u b_u a_u
          (π_seq n) (T_seq n) (V_seq n) (A_seq n) (c_seq n) (θ_seq n) < η / 2 :=
        lt_of_le_of_lt (le_abs_self _) hΔ_dist
      have h_hi : Δ' n < η := by linarith [(h'_spec n).2.2]
      rw [Real.dist_eq, sub_zero, abs_lt]
      exact ⟨by linarith, h_hi⟩
    have h_pow_lt : ∀ {x r : ℝ}, 0 < x → 0 < r → x < r ^ (1 / u) → x ^ u < r := by
      intro x r hx hr hlt
      calc x ^ u < (r ^ (1 / u)) ^ u := Real.rpow_lt_rpow hx.le hlt hu₀
        _ = r := by
            rw [← Real.rpow_mul hr.le, one_div_mul_cancel hu_ne, Real.rpow_one]
    obtain ⟨N₀, hN₀⟩ := (Metric.tendsto_atTop.mp hε_lim)
      ((1 / 4 : ℝ) ^ (1 / u)) (Real.rpow_pos_of_pos (by norm_num) _)
    let ε_tilde : ℕ → ℝ := fun k => (ε_seq (k + N₀)) ^ u
    have hε_tilde_bds : ∀ k : ℕ, 0 < ε_tilde k ∧ ε_tilde k < 1 / 2 := by
      intro k
      have hk_pos : 0 < ε_seq (k + N₀) := (hε_bds (k + N₀)).1
      refine ⟨Real.rpow_pos_of_pos hk_pos u, ?_⟩
      have h_dist := hN₀ (k + N₀) (Nat.le_add_left N₀ k)
      rw [Real.dist_eq, sub_zero, abs_of_pos hk_pos] at h_dist
      have h_quarter : ε_tilde k < 1 / 4 := h_pow_lt hk_pos (by norm_num) h_dist
      linarith
    have hε_tilde_lim : Filter.Tendsto ε_tilde Filter.atTop (nhds 0) := by
      rw [Metric.tendsto_atTop]
      intro r hr
      obtain ⟨N_r, hN_r⟩ := (Metric.tendsto_atTop.mp hε_lim)
        (r ^ (1 / u)) (Real.rpow_pos_of_pos hr _)
      refine ⟨N_r, fun k hk => ?_⟩
      have hk_pos : 0 < ε_seq (k + N₀) := (hε_bds (k + N₀)).1
      have h_dist := hN_r (k + N₀) (by omega)
      rw [Real.dist_eq, sub_zero, abs_of_pos hk_pos] at h_dist
      rw [Real.dist_eq, sub_zero, abs_of_pos (hε_tilde_bds k).1]
      exact h_pow_lt hk_pos hr h_dist
    refine ⟨div_nonneg he_u_nn hu₀.le,
      ε_tilde, fun k => N_ω (k + N₀), fun k => N_T (k + N₀),
      fun k => π'_seq (k + N₀), fun k => T_seq (k + N₀),
      fun k => V'_seq (k + N₀), fun k => A'_seq (k + N₀),
      fun k => c_seq (k + N₀), fun k => θ_seq (k + N₀),
      hε_tilde_bds, hε_tilde_lim, ?_, ?_⟩
    · intro k
      obtain ⟨h_ulaw, h_supp_imp, _⟩ := h'_spec (k + N₀)
      exact ⟨h_ulaw.1, h_ulaw.2.1, h_ulaw.2.2.1,
        fun ω hω => ⟨h_ulaw.2.2.2 ω hω, (h_laws (k + N₀)).2 ω (h_supp_imp ω hω)⟩⟩
    · have h_shift_lim : Filter.Tendsto (fun k => Δ' (k + N₀)) Filter.atTop (nhds 0) :=
        (Filter.tendsto_add_atTop_iff_nat N₀).mpr hΔ'_lim
      have h_lin_lim : Filter.Tendsto
          (fun k => classicalGrowthRate γ - u⁻¹ * Δ' (k + N₀))
          Filter.atTop (nhds (classicalGrowthRate γ)) := by
        simpa using tendsto_const_nhds.sub (h_shift_lim.const_mul (u⁻¹))
      refine h_lin_lim.congr (fun k => ?_)
      have h_inv := s4_power_invariance (ε_seq (k + N₀)) u e_u
        (π'_seq (k + N₀)) (T_seq (k + N₀)) (V'_seq (k + N₀)) (A'_seq (k + N₀))
        (c_seq (k + N₀)) (θ_seq (k + N₀)) (hε_bds (k + N₀)).1 hu₀
      dsimp [ε_tilde]
      rw [h_inv]
      dsimp [Δ']
      unfold stdApertureDeficit
      field_simp [hu_ne]
      ring

theorem fin_entropy_submod_and_support_bounds (ε : ℝ) (hε₀ : 0 < ε) (hε₁ : ε < 1 / 2)
    {N_ω : ℕ} (π : Fin N_ω → ℝ)
    (hπ_nn : ∀ ω, 0 ≤ π ω) (hπ_sum : ∑ ω : Fin N_ω, π ω = 1) :
    (∀ {α β₁ β₂ : Type} (T : Fin N_ω → α) (A : Fin N_ω → β₁) (B : Fin N_ω → β₂),
      finMutualInfo ε π T B ≤ finMutualInfo ε π T A + finCondEntropy ε π A B) ∧
    (letI := Classical.propDecidable
     ∀ {β₁ β₂ : Type} [DecidableEq β₂] (A : Fin N_ω → β₁) (B : Fin N_ω → β₂)
       (E_bad : Fin N_ω → Bool) (N_good M_all : ℕ),
       1 ≤ N_good → 1 ≤ M_all →
       (∀ ω₀ : Fin N_ω, 0 < π ω₀ →
         ((Finset.univ.filter (fun ω =>
           0 < π ω ∧ E_bad ω = false ∧ A ω = A ω₀)).image B).card ≤ N_good) →
       ((Finset.univ.filter (fun ω => 0 < π ω ∧ E_bad ω = true)).image B).card ≤ M_all →
       finCondEntropy ε π A B ≤
         (Real.log 2 + Real.log (N_good : ℝ) +
           (∑ ω : Fin N_ω, if E_bad ω then π ω else 0) * Real.log (M_all : ℝ)) /
           Real.log (ε⁻¹)) ∧
    (∀ {α κ β₁ β₂ β_c : Type} (T : Fin N_ω → α) (C : Fin N_ω → κ)
      (D₁ : Fin N_ω → β₁) (D₂ : Fin N_ω → β₂) (G_c : Fin N_ω → β_c),
      (∀ ω₁ ω₂ : Fin N_ω, 0 < π ω₁ → 0 < π ω₂ →
        (D₁ ω₁ = D₁ ω₂ → C ω₁ = C ω₂) ∧
        (D₂ ω₁ = D₂ ω₂ → C ω₁ = C ω₂) ∧
        (G_c ω₁ = G_c ω₂ → C ω₁ = C ω₂)) →
      finCondEntropy ε π (fun ω => (T ω, C ω)) D₁ +
        finCondEntropy ε π (fun ω => (T ω, C ω)) D₂ ≤
        finCondEntropy ε π (fun ω => (T ω, C ω)) (fun ω => (D₁ ω, D₂ ω)) →
      finMutualInfo ε π T (fun ω => (D₁ ω, D₂ ω)) + finMutualInfo ε π T G_c -
        finMutualInfo ε π T D₁ - finMutualInfo ε π T D₂ ≤
        finCondEntropy ε π D₁ G_c + finCondEntropy ε π D₂ G_c) ∧
    (∀ {α κ β₁ β₂ : Type} (T : Fin N_ω → α) (C : Fin N_ω → κ)
      (D₁ : Fin N_ω → β₁) (D₂ : Fin N_ω → β₂),
      (∀ ω₁ ω₂ : Fin N_ω, 0 < π ω₁ → 0 < π ω₂ →
        T ω₁ = T ω₂ → C ω₁ = C ω₂ → D₁ ω₁ = D₁ ω₂) →
      finCondEntropy ε π (fun ω => (T ω, C ω)) D₁ +
        finCondEntropy ε π (fun ω => (T ω, C ω)) D₂ ≤
        finCondEntropy ε π (fun ω => (T ω, C ω)) (fun ω => (D₁ ω, D₂ ω))) :=
by
  have h_ite_iff : ∀ {P Q : Prop} (dP : Decidable P) (dQ : Decidable Q) (a b : ℝ),
      (P ↔ Q) → @ite ℝ P dP a b = @ite ℝ Q dQ a b := by
    intro P Q dP dQ a b hPQ
    cases dP with
    | isTrue hP => cases dQ with
      | isTrue _ => rfl
      | isFalse hQ => exact absurd (hPQ.mp hP) hQ
    | isFalse hP => cases dQ with
      | isTrue hQ => exact absurd (hPQ.mpr hQ) hP
      | isFalse _ => rfl
  have h_div_mul_le : ∀ (A B : ℝ), 0 ≤ A → (A / B) * B ≤ A := by
    intro A B hA
    by_cases hB : B = 0
    · rw [hB, mul_zero]; exact hA
    · rw [div_mul_cancel₀ A hB]
  have h_ell_pos : 0 < Real.log (ε⁻¹) := by
    rw [Real.log_inv, neg_pos]
    exact Real.log_neg hε₀ (by linarith)
  let S_pos : Finset (Fin N_ω) :=
    @Finset.filter (Fin N_ω) (fun ω => 0 < π ω) (fun _ => Classical.propDecidable _) Finset.univ
  have h_mem_Spos : ∀ ω : Fin N_ω, ω ∈ S_pos ↔ 0 < π ω := by
    intro ω
    simp [S_pos]
  have h_pi_zero_off : ∀ ω : Fin N_ω, ω ∉ S_pos → π ω = 0 := by
    intro ω hω
    rw [h_mem_Spos, not_lt] at hω
    exact le_antisymm hω (hπ_nn ω)
  have h_sum_Spos : ∀ g : Fin N_ω → ℝ,
      (∑ ω : Fin N_ω, π ω * g ω) = ∑ ω ∈ S_pos, π ω * g ω := by
    intro g
    exact (Finset.sum_subset (Finset.subset_univ S_pos)
      (fun ω _ hω => by rw [h_pi_zero_off ω hω, zero_mul])).symm
  have h_pos_nn : ∀ {γ₁ γ₂ : Type} (X : Fin N_ω → γ₁) (Y : Fin N_ω → γ₂),
      (∀ ω, 0 < π ω →
        0 < finProbAt π X ω ∧
        0 < finProbAt2 π X Y ω ∧
        0 ≤ condSurprise ε π X Y ω) ∧
      0 ≤ finCondEntropy ε π X Y := by
    intro γ₁ γ₂ X Y
    have h_atom : ∀ ω, 0 < π ω →
        0 < finProbAt π X ω ∧
        0 < finProbAt2 π X Y ω ∧
        0 ≤ condSurprise ε π X Y ω := by
      intro ω hπ_pos
      have h_le2 : π ω ≤ finProbAt2 π X Y ω := by
        unfold finProbAt2
        letI := Classical.propDecidable
        calc π ω = (if X ω = X ω ∧ Y ω = Y ω then π ω else 0) := by simp
          _ ≤ ∑ ω' : Fin N_ω, if X ω' = X ω ∧ Y ω' = Y ω then π ω' else 0 :=
            Finset.single_le_sum
              (f := fun ω' : Fin N_ω => if X ω' = X ω ∧ Y ω' = Y ω then π ω' else 0)
              (fun ω' _ => by split_ifs <;> [exact hπ_nn ω'; exact le_rfl])
              (Finset.mem_univ ω)
      have h2_le_1 : finProbAt2 π X Y ω ≤ finProbAt π X ω := by
        unfold finProbAt2 finProbAt
        letI := Classical.propDecidable
        refine Finset.sum_le_sum (fun ω' _ => ?_)
        by_cases h1 : X ω' = X ω
        · by_cases h2 : Y ω' = Y ω <;> simp [h1, h2, hπ_nn ω']
        · simp [h1]
      have h2_pos : 0 < finProbAt2 π X Y ω := lt_of_lt_of_le hπ_pos h_le2
      have h1_pos : 0 < finProbAt π X ω := lt_of_lt_of_le h2_pos h2_le_1
      have h_surp_nn : 0 ≤ condSurprise ε π X Y ω := by
        unfold condSurprise
        have h_log_np : Real.log (finProbAt2 π X Y ω / finProbAt π X ω) ≤ 0 :=
          Real.log_nonpos (div_nonneg h2_pos.le h1_pos.le) ((div_le_one h1_pos).mpr h2_le_1)
        exact div_nonneg (neg_nonneg.mpr h_log_np) h_ell_pos.le
      exact ⟨h1_pos, h2_pos, h_surp_nn⟩
    refine ⟨h_atom, ?_⟩
    unfold finCondEntropy
    refine Finset.sum_nonneg (fun ω _ => ?_)
    by_cases hpos : 0 < π ω
    · exact mul_nonneg hpos.le (h_atom ω hpos).2.2
    · have hzero : π ω = 0 := le_antisymm (le_of_not_gt hpos) (hπ_nn ω)
      simp [hzero]
  have h_cond_equiv : ∀ {γ₁ γ₂ δ₁ δ₂ : Type}
      (X₁ : Fin N_ω → γ₁) (X₂ : Fin N_ω → γ₂)
      (Y₁ : Fin N_ω → δ₁) (Y₂ : Fin N_ω → δ₂),
      (∀ ω₁ ω₂, 0 < π ω₁ → 0 < π ω₂ →
        (X₁ ω₁ = X₁ ω₂ ↔ X₂ ω₁ = X₂ ω₂) ∧
        (X₁ ω₁ = X₁ ω₂ → (Y₁ ω₁ = Y₁ ω₂ ↔ Y₂ ω₁ = Y₂ ω₂))) →
      finCondEntropy ε π X₁ Y₁ = finCondEntropy ε π X₂ Y₂ := by
    intro γ₁ γ₂ δ₁ δ₂ X₁ X₂ Y₁ Y₂ h_eqv
    unfold finCondEntropy
    rw [h_sum_Spos, h_sum_Spos]
    refine Finset.sum_congr rfl (fun ω hω => ?_)
    have hω_pos : 0 < π ω := (h_mem_Spos ω).mp hω
    congr 1
    unfold condSurprise
    have h_p1 : finProbAt π X₁ ω = finProbAt π X₂ ω := by
      unfold finProbAt
      refine Finset.sum_congr rfl (fun ω' _ => ?_)
      by_cases hω' : 0 < π ω'
      · exact h_ite_iff _ _ _ _ (h_eqv ω' ω hω' hω_pos).1
      · have hz : π ω' = 0 := le_antisymm (le_of_not_gt hω') (hπ_nn ω')
        rw [hz, ite_self, ite_self]
    have h_p2 : finProbAt2 π X₁ Y₁ ω = finProbAt2 π X₂ Y₂ ω := by
      unfold finProbAt2
      refine Finset.sum_congr rfl (fun ω' _ => ?_)
      by_cases hω' : 0 < π ω'
      · obtain ⟨hx, hy⟩ := h_eqv ω' ω hω' hω_pos
        exact h_ite_iff _ _ _ _
          ⟨fun h => ⟨hx.mp h.1, (hy h.1).mp h.2⟩,
           fun h => ⟨hx.mpr h.1, (hy (hx.mpr h.1)).mpr h.2⟩⟩
      · have hz : π ω' = 0 := le_antisymm (le_of_not_gt hω') (hπ_nn ω')
        rw [hz, ite_self, ite_self]
    rw [h_p1, h_p2]
  have h_symm_target : ∀ {γ₀ γ₁ γ₂ : Type}
      (W : Fin N_ω → γ₀) (U : Fin N_ω → γ₁) (V : Fin N_ω → γ₂),
      finCondEntropy ε π W (fun ω => (U ω, V ω)) =
        finCondEntropy ε π W (fun ω => (V ω, U ω)) := by
    intro γ₀ γ₁ γ₂ W U V
    refine h_cond_equiv _ _ _ _ (fun _ _ _ _ => ⟨Iff.rfl, fun _ => ?_⟩)
    rw [Prod.ext_iff, Prod.ext_iff]
    exact and_comm
  have h_symm_cond : ∀ {γ₀ γ₁ γ₂ : Type}
      (W : Fin N_ω → γ₀) (U : Fin N_ω → γ₁) (V : Fin N_ω → γ₂),
      finCondEntropy ε π (fun ω => (W ω, U ω)) V =
        finCondEntropy ε π (fun ω => (U ω, W ω)) V := by
    intro γ₀ γ₁ γ₂ W U V
    refine h_cond_equiv _ _ _ _ (fun _ _ _ _ => ⟨?_, fun _ => Iff.rfl⟩)
    rw [Prod.ext_iff, Prod.ext_iff]
    exact and_comm
  have h_chain : ∀ {γ₀ γ₁ γ₂ : Type}
      (W : Fin N_ω → γ₀) (U : Fin N_ω → γ₁) (V : Fin N_ω → γ₂),
      finCondEntropy ε π W (fun ω => (U ω, V ω)) =
        finCondEntropy ε π W U + finCondEntropy ε π (fun ω => (W ω, U ω)) V := by
    intro γ₀ γ₁ γ₂ W U V
    unfold finCondEntropy
    rw [h_sum_Spos, h_sum_Spos, h_sum_Spos, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun ω hω => ?_)
    have hω_pos : 0 < π ω := (h_mem_Spos ω).mp hω
    rw [← mul_add]
    congr 1
    have hp_wu_eq : finProbAt π (fun ω' => (W ω', U ω')) ω = finProbAt2 π W U ω := by
      unfold finProbAt finProbAt2
      refine Finset.sum_congr rfl (fun ω' _ => ?_)
      exact h_ite_iff _ _ _ _ Prod.ext_iff
    have hp_wuv_eq : finProbAt2 π (fun ω' => (W ω', U ω')) V ω =
        finProbAt2 π W (fun ω' => (U ω', V ω')) ω := by
      unfold finProbAt2
      refine Finset.sum_congr rfl (fun ω' _ => ?_)
      exact h_ite_iff _ _ _ _ ⟨fun h => ⟨(Prod.ext_iff.mp h.1).1,
        Prod.ext_iff.mpr ⟨(Prod.ext_iff.mp h.1).2, h.2⟩⟩,
        fun h => ⟨Prod.ext_iff.mpr ⟨h.1, (Prod.ext_iff.mp h.2).1⟩,
        (Prod.ext_iff.mp h.2).2⟩⟩
    obtain ⟨hpW, hpWU, _⟩ := (h_pos_nn W U).1 ω hω_pos
    obtain ⟨_, hpWUV, _⟩ := (h_pos_nn W (fun ω' => (U ω', V ω'))).1 ω hω_pos
    unfold condSurprise
    rw [hp_wu_eq, hp_wuv_eq, ← add_div]
    congr 1
    have h_prod : finProbAt2 π W (fun ω' => (U ω', V ω')) ω / finProbAt π W ω =
        (finProbAt2 π W U ω / finProbAt π W ω) *
        (finProbAt2 π W (fun ω' => (U ω', V ω')) ω / finProbAt2 π W U ω) := by
      field_simp [hpW.ne', hpWU.ne']
    rw [h_prod, Real.log_mul (div_pos hpWU hpW).ne' (div_pos hpWUV hpWU).ne']
    ring
  have h_chain_uncond : ∀ {γ₁ γ₂ : Type} (U : Fin N_ω → γ₁) (V : Fin N_ω → γ₂),
      finCondEntropy ε π (fun _ => ()) (fun ω => (U ω, V ω)) =
        finCondEntropy ε π (fun _ => ()) U + finCondEntropy ε π U V := by
    intro γ₁ γ₂ U V
    rw [h_chain (fun _ => ()) U V]
    congr 1
    exact h_cond_equiv _ _ _ _ (fun _ _ _ _ =>
      ⟨⟨fun h => (Prod.ext_iff.mp h).2, fun h => Prod.ext_iff.mpr ⟨rfl, h⟩⟩,
       fun _ => Iff.rfl⟩)
  have h_det_zero : ∀ {γ₀ γ₁ : Type} (W : Fin N_ω → γ₀) (U : Fin N_ω → γ₁),
      (∀ ω₁ ω₂, 0 < π ω₁ → 0 < π ω₂ → W ω₁ = W ω₂ → U ω₁ = U ω₂) →
      finCondEntropy ε π W U = 0 := by
    intro γ₀ γ₁ W U h_det
    unfold finCondEntropy
    rw [h_sum_Spos]
    refine Finset.sum_eq_zero (fun ω hω => ?_)
    have hω_pos : 0 < π ω := (h_mem_Spos ω).mp hω
    have hpW : 0 < finProbAt π W ω := ((h_pos_nn W U).1 ω hω_pos).1
    have hp2_eq : finProbAt2 π W U ω = finProbAt π W ω := by
      unfold finProbAt2 finProbAt
      refine Finset.sum_congr rfl (fun ω' _ => ?_)
      by_cases hω' : 0 < π ω'
      · exact h_ite_iff _ _ _ _ ⟨fun h => h.1, fun h => ⟨h, h_det ω' ω hω' hω_pos h⟩⟩
      · have hz : π ω' = 0 := le_antisymm (le_of_not_gt hω') (hπ_nn ω')
        rw [hz, ite_self, ite_self]
    unfold condSurprise
    rw [hp2_eq, div_self hpW.ne', Real.log_one, neg_zero, zero_div, mul_zero]
  have h_det_drop_target : ∀ {γ₀ γ₁ γ₂ : Type}
      (W : Fin N_ω → γ₀) (U : Fin N_ω → γ₁) (V : Fin N_ω → γ₂),
      (∀ ω₁ ω₂, 0 < π ω₁ → 0 < π ω₂ → W ω₁ = W ω₂ → V ω₁ = V ω₂ → U ω₁ = U ω₂) →
      finCondEntropy ε π W (fun ω => (U ω, V ω)) = finCondEntropy ε π W V := by
    intro γ₀ γ₁ γ₂ W U V h_det
    exact h_cond_equiv _ _ _ _ (fun ω₁ ω₂ h1 h2 =>
      ⟨Iff.rfl, fun hW => ⟨fun hUV => (Prod.ext_iff.mp hUV).2,
        fun hV => Prod.ext_iff.mpr ⟨h_det ω₁ ω₂ h1 h2 hW hV, hV⟩⟩⟩)
  have h_det_split : ∀ {γ₀ γ₁ γ₂ : Type}
      (W : Fin N_ω → γ₀) (U : Fin N_ω → γ₁) (V : Fin N_ω → γ₂),
      (∀ ω₁ ω₂, 0 < π ω₁ → 0 < π ω₂ → V ω₁ = V ω₂ → U ω₁ = U ω₂) →
      finCondEntropy ε π W V =
        finCondEntropy ε π W U + finCondEntropy ε π (fun ω => (W ω, U ω)) V := by
    intro γ₀ γ₁ γ₂ W U V h_det
    rw [← h_det_drop_target W U V (fun ω₁ ω₂ h1 h2 _ hV => h_det ω₁ ω₂ h1 h2 hV),
      h_chain W U V]
  have h_cond_mono : ∀ {γ₀ γ₁ γ₂ : Type}
      (W : Fin N_ω → γ₀) (U : Fin N_ω → γ₁) (V : Fin N_ω → γ₂),
      finCondEntropy ε π (fun ω => (W ω, U ω)) V ≤ finCondEntropy ε π W V := by
    intro γ₀ γ₁ γ₂ W U V
    haveI : DecidableEq γ₀ := Classical.decEq γ₀
    haveI : DecidableEq γ₁ := Classical.decEq γ₁
    haveI : DecidableEq γ₂ := Classical.decEq γ₂
    let X₁ : Fin N_ω → γ₀ × γ₁ := fun ω => (W ω, U ω)
    let p_WU : γ₀ × γ₁ → ℝ := fun q => ∑ ω' ∈ S_pos, if X₁ ω' = q then π ω' else 0
    let p_WUV : (γ₀ × γ₁) → γ₂ → ℝ :=
      fun q v => ∑ ω' ∈ S_pos, if X₁ ω' = q ∧ V ω' = v then π ω' else 0
    let p_W : γ₀ → ℝ := fun w => ∑ ω' ∈ S_pos, if W ω' = w then π ω' else 0
    let p_WV : γ₀ → γ₂ → ℝ :=
      fun w v => ∑ ω' ∈ S_pos, if W ω' = w ∧ V ω' = v then π ω' else 0
    have h_pWU_eq : ∀ ω, finProbAt π X₁ ω = p_WU (X₁ ω) := by
      intro ω
      unfold finProbAt
      have h1 : (letI := Classical.propDecidable;
          ∑ ω' : Fin N_ω, if X₁ ω' = X₁ ω then π ω' else 0) =
          ∑ ω' : Fin N_ω, if X₁ ω' = X₁ ω then π ω' else 0 :=
        Finset.sum_congr rfl (fun _ _ => h_ite_iff _ _ _ _ Iff.rfl)
      rw [h1]
      exact (Finset.sum_subset (Finset.subset_univ S_pos)
        (fun ω' _ hω' => by rw [h_pi_zero_off ω' hω', ite_self])).symm
    have h_pWUV_eq : ∀ ω, finProbAt2 π X₁ V ω = p_WUV (X₁ ω) (V ω) := by
      intro ω
      unfold finProbAt2
      have h1 : (letI := Classical.propDecidable;
          ∑ ω' : Fin N_ω, if X₁ ω' = X₁ ω ∧ V ω' = V ω then π ω' else 0) =
          ∑ ω' : Fin N_ω, if X₁ ω' = X₁ ω ∧ V ω' = V ω then π ω' else 0 :=
        Finset.sum_congr rfl (fun _ _ => h_ite_iff _ _ _ _ Iff.rfl)
      rw [h1]
      exact (Finset.sum_subset (Finset.subset_univ S_pos)
        (fun ω' _ hω' => by rw [h_pi_zero_off ω' hω', ite_self])).symm
    have h_pW_eq : ∀ ω, finProbAt π W ω = p_W (W ω) := by
      intro ω
      unfold finProbAt
      have h1 : (letI := Classical.propDecidable;
          ∑ ω' : Fin N_ω, if W ω' = W ω then π ω' else 0) =
          ∑ ω' : Fin N_ω, if W ω' = W ω then π ω' else 0 :=
        Finset.sum_congr rfl (fun _ _ => h_ite_iff _ _ _ _ Iff.rfl)
      rw [h1]
      exact (Finset.sum_subset (Finset.subset_univ S_pos)
        (fun ω' _ hω' => by rw [h_pi_zero_off ω' hω', ite_self])).symm
    have h_pWV_eq : ∀ ω, finProbAt2 π W V ω = p_WV (W ω) (V ω) := by
      intro ω
      unfold finProbAt2
      have h1 : (letI := Classical.propDecidable;
          ∑ ω' : Fin N_ω, if W ω' = W ω ∧ V ω' = V ω then π ω' else 0) =
          ∑ ω' : Fin N_ω, if W ω' = W ω ∧ V ω' = V ω then π ω' else 0 :=
        Finset.sum_congr rfl (fun _ _ => h_ite_iff _ _ _ _ Iff.rfl)
      rw [h1]
      exact (Finset.sum_subset (Finset.subset_univ S_pos)
        (fun ω' _ hω' => by rw [h_pi_zero_off ω' hω', ite_self])).symm
    let R : Fin N_ω → ℝ := fun ω =>
      (p_WV (W ω) (V ω) * p_WU (X₁ ω)) / (p_W (W ω) * p_WUV (X₁ ω) (V ω))
    have h_pt : ∀ ω ∈ S_pos,
        π ω * (condSurprise ε π X₁ V ω - condSurprise ε π W V ω) ≤
          (Real.log (ε⁻¹))⁻¹ * (π ω * R ω - π ω) := by
      intro ω hω
      have hω_pos : 0 < π ω := (h_mem_Spos ω).mp hω
      obtain ⟨hpWU, hpWUV, _⟩ := (h_pos_nn X₁ V).1 ω hω_pos
      obtain ⟨hpW, hpWV, _⟩ := (h_pos_nn W V).1 ω hω_pos
      rw [h_pWU_eq ω] at hpWU
      rw [h_pWUV_eq ω] at hpWUV
      rw [h_pW_eq ω] at hpW
      rw [h_pWV_eq ω] at hpWV
      have hR_pos : 0 < R ω := div_pos (mul_pos hpWV hpWU) (mul_pos hpW hpWUV)
      have h_mul_id : (p_WUV (X₁ ω) (V ω) / p_WU (X₁ ω)) * R ω =
          p_WV (W ω) (V ω) / p_W (W ω) := by
        dsimp [R]
        field_simp [hpWU.ne', hpWUV.ne', hpW.ne']
      have h_log_id : Real.log (p_WUV (X₁ ω) (V ω) / p_WU (X₁ ω)) + Real.log (R ω) =
          Real.log (p_WV (W ω) (V ω) / p_W (W ω)) := by
        rw [← Real.log_mul (div_pos hpWUV hpWU).ne' hR_pos.ne', h_mul_id]
      have h_surp_diff : condSurprise ε π X₁ V ω - condSurprise ε π W V ω =
          Real.log (R ω) / Real.log (ε⁻¹) := by
        unfold condSurprise
        rw [h_pWU_eq ω, h_pWUV_eq ω, h_pW_eq ω, h_pWV_eq ω, ← sub_div]
        congr 1
        linarith [h_log_id]
      rw [h_surp_diff]
      have h_log_le : Real.log (R ω) ≤ R ω - 1 := Real.log_le_sub_one_of_pos hR_pos
      have h_div_le : Real.log (R ω) / Real.log (ε⁻¹) ≤ (R ω - 1) / Real.log (ε⁻¹) :=
        div_le_div_of_nonneg_right h_log_le h_ell_pos.le
      calc π ω * (Real.log (R ω) / Real.log (ε⁻¹))
          ≤ π ω * ((R ω - 1) / Real.log (ε⁻¹)) := mul_le_mul_of_nonneg_left h_div_le hω_pos.le
        _ = (Real.log (ε⁻¹))⁻¹ * (π ω * R ω - π ω) := by ring
    have h_sum_R : ∑ ω ∈ S_pos, π ω * R ω ≤ ∑ ω ∈ S_pos, π ω := by
      let A_WU : Finset (γ₀ × γ₁) := S_pos.image X₁
      let A_V : Finset γ₂ := S_pos.image V
      have hpW_pos_A : ∀ q ∈ A_WU, 0 < p_W q.1 := by
        intro q hq
        obtain ⟨ω₀, hω₀, rfl⟩ := Finset.mem_image.mp hq
        have h1 := ((h_pos_nn W V).1 ω₀ ((h_mem_Spos ω₀).mp hω₀)).1
        rwa [h_pW_eq ω₀] at h1
      have h_expand : ∀ ω ∈ S_pos, π ω * R ω =
          ∑ q ∈ A_WU, ∑ v ∈ A_V,
            (((p_WV q.1 v * p_WU q / p_W q.1) / p_WUV q v) *
              (if X₁ ω = q ∧ V ω = v then π ω else 0)) := by
        intro ω hω
        have hq_mem : X₁ ω ∈ A_WU := Finset.mem_image_of_mem X₁ hω
        have hv_mem : V ω ∈ A_V := Finset.mem_image_of_mem V hω
        have h_inner : ∀ q : γ₀ × γ₁,
            (∑ v ∈ A_V,
              (((p_WV q.1 v * p_WU q / p_W q.1) / p_WUV q v) *
                (if X₁ ω = q ∧ V ω = v then π ω else 0))) =
            if X₁ ω = q then
              ((p_WV q.1 (V ω) * p_WU q / p_W q.1) / p_WUV q (V ω)) * π ω
            else 0 := by
          intro q
          by_cases hq : X₁ ω = q
          · have h_step1 : (∑ v ∈ A_V,
                (((p_WV q.1 v * p_WU q / p_W q.1) / p_WUV q v) *
                  (if X₁ ω = q ∧ V ω = v then π ω else 0))) =
                ∑ v ∈ A_V, if V ω = v then
                  ((p_WV q.1 v * p_WU q / p_W q.1) / p_WUV q v) * π ω else 0 := by
              refine Finset.sum_congr rfl (fun v _ => ?_)
              by_cases hv : V ω = v <;> simp [hq, hv]
            rw [h_step1]
            exact (Finset.sum_ite_eq A_V (V ω)
              (fun v => ((p_WV q.1 v * p_WU q / p_W q.1) / p_WUV q v) * π ω)).trans
              (by simp [hv_mem, hq])
          · simp [hq]
        simp_rw [h_inner]
        rw [Finset.sum_ite_eq A_WU (X₁ ω)
          (fun q => ((p_WV q.1 (V ω) * p_WU q / p_W q.1) / p_WUV q (V ω)) * π ω)]
        simp only [hq_mem, ↓reduceIte, R, X₁]
        ring
      have h_pWV_sum : ∀ w : γ₀, ∑ v ∈ A_V, p_WV w v = p_W w := by
        intro w
        dsimp only [p_WV, p_W]
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl (fun ω' hω' => ?_)
        have hm : V ω' ∈ A_V := Finset.mem_image_of_mem V hω'
        by_cases hw : W ω' = w
        · simp only [hw, true_and]
          exact (Finset.sum_ite_eq A_V (V ω') (fun _ => π ω')).trans (by simp [hm])
        · simp [hw]
      have h_pWU_sum : ∑ q ∈ A_WU, p_WU q = ∑ ω ∈ S_pos, π ω := by
        dsimp only [p_WU]
        rw [Finset.sum_comm]
        refine Finset.sum_congr rfl (fun ω hω => ?_)
        have hm : X₁ ω ∈ A_WU := Finset.mem_image_of_mem X₁ hω
        exact (Finset.sum_ite_eq A_WU (X₁ ω) (fun _ => π ω)).trans (by simp [hm])
      calc ∑ ω ∈ S_pos, π ω * R ω
          = ∑ ω ∈ S_pos, ∑ q ∈ A_WU, ∑ v ∈ A_V,
              (((p_WV q.1 v * p_WU q / p_W q.1) / p_WUV q v) *
                (if X₁ ω = q ∧ V ω = v then π ω else 0)) :=
            Finset.sum_congr rfl h_expand
        _ = ∑ q ∈ A_WU, ∑ v ∈ A_V,
              (((p_WV q.1 v * p_WU q / p_W q.1) / p_WUV q v) * p_WUV q v) := by
            rw [Finset.sum_comm]
            refine Finset.sum_congr rfl (fun q _ => ?_)
            rw [Finset.sum_comm]
            refine Finset.sum_congr rfl (fun v _ => ?_)
            rw [← Finset.mul_sum]
        _ ≤ ∑ q ∈ A_WU, ∑ v ∈ A_V, (p_WV q.1 v * p_WU q / p_W q.1) := by
            refine Finset.sum_le_sum (fun q hq => Finset.sum_le_sum (fun v _ => ?_))
            refine h_div_mul_le _ _ (div_nonneg (mul_nonneg ?_ ?_) (hpW_pos_A q hq).le)
            · exact Finset.sum_nonneg
                (fun ω' _ => by split_ifs <;> [exact hπ_nn ω'; exact le_rfl])
            · exact Finset.sum_nonneg
                (fun ω' _ => by split_ifs <;> [exact hπ_nn ω'; exact le_rfl])
        _ = ∑ q ∈ A_WU, p_WU q := by
            refine Finset.sum_congr rfl (fun q hq => ?_)
            have h_pull : (∑ v ∈ A_V, p_WV q.1 v * p_WU q / p_W q.1) =
                (p_WU q / p_W q.1) * ∑ v ∈ A_V, p_WV q.1 v := by
              rw [Finset.mul_sum]
              exact Finset.sum_congr rfl (fun _ _ => by ring)
            rw [h_pull, h_pWV_sum q.1, div_mul_cancel₀ _ (hpW_pos_A q hq).ne']
        _ = ∑ ω ∈ S_pos, π ω := h_pWU_sum
    change finCondEntropy ε π X₁ V ≤ finCondEntropy ε π W V
    unfold finCondEntropy
    rw [h_sum_Spos (condSurprise ε π X₁ V), h_sum_Spos (condSurprise ε π W V)]
    have h_diff_le : (∑ ω ∈ S_pos, π ω * condSurprise ε π X₁ V ω) -
        (∑ ω ∈ S_pos, π ω * condSurprise ε π W V ω) ≤ 0 := by
      calc (∑ ω ∈ S_pos, π ω * condSurprise ε π X₁ V ω) -
            (∑ ω ∈ S_pos, π ω * condSurprise ε π W V ω)
          = ∑ ω ∈ S_pos, π ω * (condSurprise ε π X₁ V ω - condSurprise ε π W V ω) := by
            rw [← Finset.sum_sub_distrib]
            exact Finset.sum_congr rfl (fun _ _ => by ring)
