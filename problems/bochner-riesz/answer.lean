    let N_R : ℕ := 2 ^ (m_t - m_r)
    have h_act_decomp : ∀ o d α, 0 < q o d α →
        let r_loc := r_O o % N_R
        let c_end := ((r_loc : ℝ) + 1 / 2) * ((2 : ℝ) ^ (m_t - m_r))⁻¹
        let C_D := ((r_D d : ℝ) + 1 / 2) * ((2 : ℝ) ^ m_t)⁻¹
        let C_r := ((loc_idx.1 : ℝ) + 1 / 2) * s_c
