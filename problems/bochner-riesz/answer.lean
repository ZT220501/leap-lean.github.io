    let p_G : Fin N_G → ℝ := fun g => ∑ ω : Fin M_ω, if G_idx ω = g then Q ω else 0
    let p_TG : Fin M_T → Fin N_G → ℝ := fun tid g =>
      ∑ ω : Fin M_ω, if T_idx ω = tid ∧ G_idx ω = g then Q ω else 0
