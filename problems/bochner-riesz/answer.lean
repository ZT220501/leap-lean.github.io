                mul_le_mul hsx_σloc_inv hperp_ζ (abs_nonneg _)
                  (mul_nonneg hBsys_pos.le (Real.rpow_nonneg hε_pos.le _))
            _ = B_sys ^ 2 * (ε ^ (-(H_P + t) / 2) * ε ^ ((H_P + t) / 2 - ζ_sh)) := by ring
            _ = B_sys ^ 2 * ε ^ (-ζ_sh) := by
                rw [← Real.rpow_add hε_pos]
                congr 2
                ring
        have h_quot_diff :
            |inner ℝ (X'_fn o - X_Q) (n_buf q.1) / σ_loc - μ_q q| ≤ R_Z1 := by
          have hdiv_eq :
              inner ℝ (X'_fn o - X_Q) (n_buf q.1) / σ_loc - μ_q q =
                σ_loc⁻¹ * (inner ℝ (X'_fn o - X_Q) (n_buf q.1) -
                  σ_sgn q * inner ℝ (X'_d - X_Q) n_d) := by
            dsimp only [μ_q]
            rw [div_eq_mul_inv, div_eq_mul_inv]
            ring
          rw [hdiv_eq, h_ip_decomp, abs_mul, abs_of_pos hσ_loc_inv_pos]
          have htri := abs_add_le
            (inner ℝ (X'_fn o - X_Q) (n_buf q.1 - σ_sgn q • n_d))
            (σ_sgn q * inner ℝ (X'_fn o - X'_d) n_d)
          have hmul := mul_le_mul_of_nonneg_left htri hσ_loc_inv_pos.le
          dsimp only [R_Z1]
          linarith only [hmul, h_term1, h_term2]
        rcases abs_le.mp h_quot_diff with ⟨hlo, hhi⟩
        have hfloor_mem :
            Int.floor (inner ℝ (X'_fn o - X_Q) (n_buf q.1) / σ_loc) ∈
