              simp_rw [Finset.sum_add_distrib, ← Finset.sum_mul, ← hp_Z_eq_sum_d]
      have h_rhs1 : ∑ z ∈ Z_act, ∑ d : Fin N_D, ∑ q ∈ F_set,
            -(W z q d * Real.log (q_law q d / p_cD d)) =
          ∑ q ∈ F_set, ∑ d : Fin N_D, -(q_law q d * Real.log (q_law q d / p_cD d)) := by
        calc ∑ z ∈ Z_act, ∑ d : Fin N_D, ∑ q ∈ F_set,
              -(W z q d * Real.log (q_law q d / p_cD d))
            = ∑ z ∈ Z_act, ∑ q ∈ F_set, ∑ d : Fin N_D,
              -(W z q d * Real.log (q_law q d / p_cD d)) :=
              Finset.sum_congr rfl (fun _ _ => Finset.sum_comm)
          _ = ∑ q ∈ F_set, ∑ z ∈ Z_act, ∑ d : Fin N_D,
              -(W z q d * Real.log (q_law q d / p_cD d)) := Finset.sum_comm
