import Mathlib
set_option maxHeartbeats 4000000

/-!
# Bochner–Riesz Multipliers in Three Dimensions (Theorem 1.1)

Formal problem statement for **Theorem 1.1** from:
OpenAI, *Bochner–Riesz multipliers in three dimensions*,
September 24, 2026.
https://github.com/openai/math/blob/main/preprints/Bochner-Riesz-Multipliers-in-Three-Dimensions-September-24-2026/Bochner-Riesz-Multipliers-in-Three-Dimensions-September-24-2026.pdf
-/

/-- The Bochner–Riesz multiplier symbol `m_δ(ξ) = (1 - |ξ|²)_+^δ` on `ℝ³`. -/
noncomputable def bochnerRieszSymbol (δ : ℝ) (ξ : EuclideanSpace ℝ (Fin 3)) : ℝ :=
  (max (1 - ‖ξ‖ ^ 2) 0) ^ δ

/-- The Bochner–Riesz multiplier operator `T_δ` on `ℝ³` of order `δ > 0`, acting on a Schwartz
function `f ∈ 𝓢(ℝ³)` by
`T_δ f(x) = ∫_{ℝ³} (1 - |ξ|²)_+^δ f̂(ξ) e^{2πi x · ξ} dξ`,
where `f̂(ξ) = ∫_{ℝ³} f(x) e^{-2πi x · ξ} dx` is the Fourier transform `FourierTransform.fourier f`. -/
noncomputable def bochnerRiesz (δ : ℝ)
    (f : SchwartzMap (EuclideanSpace ℝ (Fin 3)) ℂ) (x : EuclideanSpace ℝ (Fin 3)) : ℂ :=
  ∫ ξ : EuclideanSpace ℝ (Fin 3),
    (bochnerRieszSymbol δ ξ : ℂ) * FourierTransform.fourier f ξ *
      Complex.exp (2 * Real.pi * Complex.I * (inner ℝ x ξ : ℝ))

/- **Theorem 1.1** (Three-dimensional Bochner–Riesz multiplier bound on `L³(ℝ³)`):
For every `δ > 0`, there is a finite constant `C_δ` such that
`‖T_δ f‖_{L³(ℝ³)} ≤ C_δ ‖f‖_{L³(ℝ³)}` for all `f ∈ 𝓢(ℝ³)`. -/
noncomputable def bochnerRieszKernel (δ : ℝ) (z : EuclideanSpace ℝ (Fin 3)) : ℂ :=
  ∫ ξ : EuclideanSpace ℝ (Fin 3),
    (bochnerRieszSymbol δ ξ : ℂ) *
      Complex.exp (2 * Real.pi * Complex.I * (inner ℝ z ξ : ℝ))


noncomputable def spatialConv (K g : EuclideanSpace ℝ (Fin 3) → ℂ)
    (x : EuclideanSpace ℝ (Fin 3)) : ℂ :=
  ∫ y : EuclideanSpace ℝ (Fin 3), K (x - y) * g y


noncomputable def shellOscKernel (δ σ lam : ℝ)
    (a : EuclideanSpace ℝ (Fin 3) → ℂ) (z : EuclideanSpace ℝ (Fin 3)) : ℂ :=
  ((lam ^ (-2 - δ) : ℝ) : ℂ) *
    Complex.exp (2 * Real.pi * Complex.I * ((σ * ‖z‖ : ℝ) : ℂ)) *
    a (lam⁻¹ • z)


noncomputable def distPhaseOscOp (σ lam : ℝ)
    (a g : EuclideanSpace ℝ (Fin 3) → ℂ) (z : EuclideanSpace ℝ (Fin 3)) : ℂ :=
  ∫ y : EuclideanSpace ℝ (Fin 3),
    Complex.exp (2 * Real.pi * Complex.I * ((σ * lam * ‖z - y‖ : ℝ) : ℂ)) *
      a (z - y) * g y
noncomputable def oscIntegralOp2D (lam : ℝ)
    (Φ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
    (B : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℂ)
    (f : EuclideanSpace ℝ (Fin 2) → ℂ)
    (cx : ℝ × EuclideanSpace ℝ (Fin 2)) : ℂ :=
  ∫ v : EuclideanSpace ℝ (Fin 2),
    Complex.exp (Complex.I * ((lam * Φ (cx.1, cx.2, v) : ℝ) : ℂ)) *
      B (cx.1, cx.2, v) * f v

def IsEllipticGevreyPhase (a₀ a₁ A : ℝ)
    (Φ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
    (ζ : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → EuclideanSpace ℝ (Fin 2)) : Prop :=
  (∀ k : ℕ, ContDiff ℝ k Φ) ∧
  (∀ k : ℕ, ContDiff ℝ k ζ) ∧
  (∀ (c : ℝ), c ∈ Set.Icc (0 : ℝ) 1 →
    ∀ (x v u : EuclideanSpace ℝ (Fin 2)),
      fderiv ℝ (fun v' => Φ (c, x, v')) v u = inner ℝ (ζ (v, x - c • v)) u) ∧
  (∀ (v p u w : EuclideanSpace ℝ (Fin 2)),
    inner ℝ (fderiv ℝ (fun p' => ζ (v, p')) p u) w =
      inner ℝ u (fderiv ℝ (fun p' => ζ (v, p')) p w)) ∧
  ((∀ (v p u : EuclideanSpace ℝ (Fin 2)),
      a₀ * ‖u‖ ^ 2 ≤ inner ℝ (fderiv ℝ (fun p' => ζ (v, p')) p u) u ∧
      inner ℝ (fderiv ℝ (fun p' => ζ (v, p')) p u) u ≤ a₁ * ‖u‖ ^ 2) ∨
   (∀ (v p u : EuclideanSpace ℝ (Fin 2)),
      a₀ * ‖u‖ ^ 2 ≤ -inner ℝ (fderiv ℝ (fun p' => ζ (v, p')) p u) u ∧
      -inner ℝ (fderiv ℝ (fun p' => ζ (v, p')) p u) u ≤ a₁ * ‖u‖ ^ 2)) ∧
  (∀ (j : ℕ) (vp : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2)),
    ‖iteratedFDeriv ℝ j
      (fun q : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) =>
        fderiv ℝ (fun p' => ζ (q.1, p')) q.2) vp‖ ≤
      A ^ (j + 1) * ((j.factorial : ℝ) ^ 3))
noncomputable def gridPt2D (s : ℝ) (k : ℤ × ℤ) : EuclideanSpace ℝ (Fin 2) :=
  WithLp.toLp 2 (fun i : Fin 2 => if i = 0 then s * (k.1 : ℝ) else s * (k.2 : ℝ))

noncomputable def perp2D (e : EuclideanSpace ℝ (Fin 2)) : EuclideanSpace ℝ (Fin 2) :=
  WithLp.toLp 2 (fun i : Fin 2 => if i = 0 then -(e 1) else e 0)

def IsNormalizedPosDefPhase (a₀ a₁ A : ℝ)
    (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
    (ζ₀ : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → EuclideanSpace ℝ (Fin 2)) : Prop :=
  (∀ k : ℕ, ContDiff ℝ k Φ₀) ∧
  (∀ k : ℕ, ContDiff ℝ k ζ₀) ∧
  (∀ (c : ℝ) (x : EuclideanSpace ℝ (Fin 2)), Φ₀ (c, x, 0) = 0) ∧
  (∀ v : EuclideanSpace ℝ (Fin 2), Φ₀ (0, 0, v) = 0) ∧
  (∀ v : EuclideanSpace ℝ (Fin 2), ζ₀ (v, 0) = 0) ∧
  (∀ (c : ℝ), c ∈ Set.Icc (0 : ℝ) 1 →
    ∀ (x v u : EuclideanSpace ℝ (Fin 2)),
      fderiv ℝ (fun v' => Φ₀ (c, x, v')) v u = inner ℝ (ζ₀ (v, x - c • v)) u) ∧
  (∀ (v p u w : EuclideanSpace ℝ (Fin 2)),
    inner ℝ (fderiv ℝ (fun p' => ζ₀ (v, p')) p u) w =
      inner ℝ u (fderiv ℝ (fun p' => ζ₀ (v, p')) p w)) ∧
  (∀ (v p u : EuclideanSpace ℝ (Fin 2)),
    a₀ * ‖u‖ ^ 2 ≤ inner ℝ (fderiv ℝ (fun p' => ζ₀ (v, p')) p u) u ∧
    inner ℝ (fderiv ℝ (fun p' => ζ₀ (v, p')) p u) u ≤ a₁ * ‖u‖ ^ 2) ∧
  (∀ (j : ℕ) (vp : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2)),
    ‖iteratedFDeriv ℝ j
      (fun q : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) =>
        fderiv ℝ (fun p' => ζ₀ (q.1, p')) q.2) vp‖ ≤
      A ^ (j + 1) * ((j.factorial : ℝ) ^ 3))

def IsCanonicalRootWindow (ψ : EuclideanSpace ℝ (Fin 2) → ℂ) : Prop :=
  (∀ k : ℕ, ContDiff ℝ k ψ) ∧
  (∀ z : EuclideanSpace ℝ (Fin 2), 100 ≤ ‖z‖ → ψ z = 0) ∧
  (∀ (k : ℕ) (z : EuclideanSpace ℝ (Fin 2)),
    ‖iteratedFDeriv ℝ k ψ z‖ ≤ (100 : ℝ) ^ (k + 1) * ((k.factorial : ℝ) ^ 10))

noncomputable def canonicalRootMass (lam : ℝ)
    (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
    (f : EuclideanSpace ℝ (Fin 2) → ℂ)
    (o : (ℤ × ℤ) × (ℤ × ℤ)) : ℝ :=
  let ρ₀ := (Real.sqrt lam)⁻¹
  let V := gridPt2D ρ₀ o.1
  let X := gridPt2D ρ₀ o.2
  sSup { m : ℝ | ∃ ψ : EuclideanSpace ℝ (Fin 2) → ℂ,
    IsCanonicalRootWindow ψ ∧
    m = ‖(ρ₀⁻¹ : ℂ) * ∫ v : EuclideanSpace ℝ (Fin 2),
      f v * ψ (ρ₀⁻¹ • (v - V)) *
        Complex.exp (Complex.I * ((lam * Φ₀ (1 / 2, X, v) : ℝ) : ℂ))‖ ^ 2 }

noncomputable def rootSiteFinset (lam R_dom : ℝ) : Finset ((ℤ × ℤ) × (ℤ × ℤ)) :=
  letI := Classical.propDecidable
  let ρ₀ := (Real.sqrt lam)⁻¹
  let B_V : ℤ := ⌈Real.sqrt lam * (R_dom + 100)⌉₊ + 1
  let B_X : ℤ := ⌈Real.sqrt lam * (R_dom + 100 + Real.log lam)⌉₊ + 1
  let boxV := (Finset.Icc (-B_V) B_V) ×ˢ (Finset.Icc (-B_V) B_V)
  let boxX := (Finset.Icc (-B_X) B_X) ×ˢ (Finset.Icc (-B_X) B_X)
  (boxV ×ˢ boxX).filter (fun o =>
    ‖gridPt2D ρ₀ o.1‖ ≤ R_dom + 100 ∧
    ‖gridPt2D ρ₀ o.2‖ ≤ R_dom + 100 + Real.log lam)

noncomputable def rootPacketScore (lam R_dom γ : ℝ)
    (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
    (f : EuclideanSpace ℝ (Fin 2) → ℂ) : ℝ :=
  let O₀ := rootSiteFinset lam R_dom
  let ρ₀ := (Real.sqrt lam)⁻¹
  sSup ({ (3 / 2 : ℝ) * (Real.log (∫ v : EuclideanSpace ℝ (Fin 2), ‖f v‖ ^ 2) / Real.log lam) } ∪
    { s : ℝ | ∃ (N_D : ℕ)
        (b a : Fin N_D → ℝ)
        (e_dir V_c X_c : Fin N_D → EuclideanSpace ℝ (Fin 2))
        (p : ((ℤ × ℤ) × (ℤ × ℤ)) → Fin N_D → ℝ),
        (∀ d : Fin N_D, 0 ≤ b d ∧ b d ≤ a d ∧ a d ≤ 1 / 2 ∧ ‖e_dir d‖ = 1) ∧
        (∀ o d, 0 ≤ p o d) ∧
        (∀ o d, o ∉ O₀ → p o d = 0) ∧
        (∑ o ∈ O₀, ∑ d : Fin N_D, p o d = 1) ∧
        (∀ o ∈ O₀, ∀ d : Fin N_D, 0 < p o d →
          0 < canonicalRootMass lam Φ₀ f o ∧
          |inner ℝ (gridPt2D ρ₀ o.1 - V_c d) (e_dir d)| ≤ 10 * lam ^ (-(b d)) ∧
          |inner ℝ (gridPt2D ρ₀ o.1 - V_c d) (perp2D (e_dir d))| ≤ 10 * lam ^ (-(a d)) ∧
          |inner ℝ (gridPt2D ρ₀ o.2 - X_c d) (e_dir d)| ≤ 10 * lam ^ (-(b d)) ∧
          |inner ℝ (gridPt2D ρ₀ o.2 - X_c d) (perp2D (e_dir d))| ≤ 10 * lam ^ (-(a d))) ∧
        (let p_O := fun o => ∑ d : Fin N_D, p o d
         let p_D := fun d => ∑ o ∈ O₀, p o d
         let H_O := (∑ o ∈ O₀, -(p_O o * Real.log (p_O o))) / Real.log lam
         let H_O_D := (∑ o ∈ O₀, ∑ d : Fin N_D,
           -(p o d * Real.log (p o d / p_D d))) / Real.log lam
         let E_mass := (∑ o ∈ O₀,
           p_O o * Real.log (canonicalRootMass lam Φ₀ f o)) / Real.log lam
         let E_w := ∑ d : Fin N_D,
           p_D d * ((1 + γ) * b d + (1 - γ) * a d)
         s = H_O + (1 / 2 : ℝ) * H_O_D + (3 / 2 : ℝ) * E_mass + (1 / 2 : ℝ) * E_w) })

noncomputable def endpointSiteFinset (lam R_dom : ℝ) :
    Finset (ℕ × (ℤ × ℤ) × (ℤ × ℤ)) :=
  letI := Classical.propDecidable
  let m_lam : ℕ := Nat.clog 2 ⌈lam⌉₊
  let B_V : ℤ := ⌈R_dom⌉₊ + 1
  let B_X : ℤ := ⌈lam * R_dom⌉₊ + 1
  let boxR := Finset.range (2 ^ m_lam)
  let boxV := (Finset.Icc (-B_V) B_V) ×ˢ (Finset.Icc (-B_V) B_V)
  let boxX := (Finset.Icc (-B_X) B_X) ×ˢ (Finset.Icc (-B_X) B_X)
  (boxR ×ˢ (boxV ×ˢ boxX)).filter (fun o =>
    ‖gridPt2D 1 o.2.1‖ ≤ R_dom ∧
    ‖gridPt2D lam⁻¹ o.2.2‖ ≤ R_dom)

noncomputable def endpointPacketMass (lam : ℝ)
    (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
    (ψ_end : (ℕ × (ℤ × ℤ) × (ℤ × ℤ)) → EuclideanSpace ℝ (Fin 2) → ℂ)
    (f : EuclideanSpace ℝ (Fin 2) → ℂ)
    (o : ℕ × (ℤ × ℤ) × (ℤ × ℤ)) : ℝ :=
  let m_lam : ℕ := Nat.clog 2 ⌈lam⌉₊
  let C_r : ℝ := ((o.1 : ℝ) + 1 / 2) * ((2 : ℝ) ^ m_lam)⁻¹
  let V_j := gridPt2D 1 o.2.1
  let X_k := gridPt2D lam⁻¹ o.2.2
  ‖∫ v : EuclideanSpace ℝ (Fin 2),
    f v * ψ_end o (v - V_j) *
      Complex.exp (Complex.I * ((lam * Φ₀ (C_r, X_k, v) : ℝ) : ℂ))‖ ^ 2
noncomputable def pcGevrey2Bump (t : ℝ) : ℝ :=
  expNegInvGlue t * expNegInvGlue (1 - t)

noncomputable def pcGevrey2Step (t : ℝ) : ℝ :=
  (∫ u in (0 : ℝ)..1, pcGevrey2Bump u)⁻¹ * ∫ u in (0 : ℝ)..t, pcGevrey2Bump u

noncomputable def pcDistDerivProfile (u : ℝ) : ℝ :=
  (1 - pcGevrey2Step (u - 10000)) *
    (2 * Real.sqrt (1 + Real.smoothTransition (2 * u + 3 / 2) * u))⁻¹ +
  pcGevrey2Step (u - 10000) * (1 / 2)

noncomputable def pcConvexifiedDist2D (q : EuclideanSpace ℝ (Fin 2)) : ℝ :=
  1 + ∫ u in (0 : ℝ)..(‖q‖ ^ 2), pcDistDerivProfile u

noncomputable def pcConvexifiedDistGrad2D (q : EuclideanSpace ℝ (Fin 2)) :
    EuclideanSpace ℝ (Fin 2) :=
  (2 * pcDistDerivProfile (‖q‖ ^ 2)) • q

noncomputable def pcSmoothRecipDepth (c : ℝ) : ℝ :=
  1 / 4 + 8 * Real.smoothTransition (64 * c + 1) * c

noncomputable def pcPhase (σ : ℝ)
    (cxv : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2)) : ℝ :=
  2 * Real.pi * σ * (pcSmoothRecipDepth cxv.1)⁻¹ *
    pcConvexifiedDist2D ((8 : ℝ) • cxv.2.1 - pcSmoothRecipDepth cxv.1 • cxv.2.2)

noncomputable def pcGrad (σ : ℝ)
    (vp : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2)) :
    EuclideanSpace ℝ (Fin 2) :=
  (-2 * Real.pi * σ) • pcConvexifiedDistGrad2D ((8 : ℝ) • vp.2 - (1 / 4 : ℝ) • vp.1)

def pcGluePolyCoeff : ℕ → ℕ → ℝ
  | 0, 0 => 1
  | 0, _ + 1 => 0
  | _ + 1, 0 => 0
  | _ + 1, 1 => 0
  | j + 1, k + 2 => pcGluePolyCoeff j k - ((k + 1 : ℕ) : ℝ) * pcGluePolyCoeff j (k + 1)

noncomputable def pcHalfNegCoeff : ℕ → ℝ
  | 0 => 1 / 2
  | k + 1 => (-(1 / 2 : ℝ) - (k : ℝ)) * pcHalfNegCoeff k
noncomputable def canonicalRootAtom (lam : ℝ)
    (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
    (ψ : EuclideanSpace ℝ (Fin 2) → ℂ)
    (o : (ℤ × ℤ) × (ℤ × ℤ))
    (v : EuclideanSpace ℝ (Fin 2)) : ℂ :=
  let ρ₀ := (Real.sqrt lam)⁻¹
  let V := gridPt2D ρ₀ o.1
  let X := gridPt2D ρ₀ o.2
  (ρ₀⁻¹ : ℂ) * star (ψ (ρ₀⁻¹ • (v - V))) *
    Complex.exp (-(Complex.I * ((lam * Φ₀ (1 / 2, X, v) : ℝ) : ℂ)))
noncomputable def classicalRootSupremum (ε L γ : ℝ) (N_ω N_T : ℕ)
    (π : Fin N_ω → ℝ) (T_idx : Fin N_ω → Fin N_T)
    (V_part A_part : Fin N_T → EuclideanSpace ℝ (Fin 2)) : ℝ :=
  let p_T : Fin N_T → ℝ := fun tid => ∑ ω : Fin N_ω, if T_idx ω = tid then π ω else 0
  let ell := Real.log (ε⁻¹)
  sSup { s : ℝ | ∃ (N_D : ℕ)
      (b_D a_D : Fin N_D → ℝ)
      (e_D V_D A_D : Fin N_D → EuclideanSpace ℝ (Fin 2))
      (q : Fin N_T → Fin N_D → ℝ),
      (∀ d : Fin N_D, 0 ≤ b_D d ∧ b_D d ≤ a_D d ∧ a_D d ≤ L ∧ ‖e_D d‖ = 1) ∧
      (∀ tid d, 0 ≤ q tid d) ∧
      (∀ tid : Fin N_T, ∑ d : Fin N_D, q tid d = p_T tid) ∧
      (∀ tid : Fin N_T, ∀ d : Fin N_D, 0 < q tid d →
        |inner ℝ (V_part tid - V_D d) (e_D d)| ≤ 10 * ε ^ (b_D d) ∧
        |inner ℝ (V_part tid - V_D d) (perp2D (e_D d))| ≤ 10 * ε ^ (a_D d) ∧
        |inner ℝ (A_part tid - A_D d) (e_D d)| ≤ 10 * ε ^ (b_D d) ∧
        |inner ℝ (A_part tid - A_D d) (perp2D (e_D d))| ≤ 10 * ε ^ (a_D d)) ∧
      (let q_D := fun d => ∑ tid : Fin N_T, q tid d
       let I_TD := (∑ tid : Fin N_T, ∑ d : Fin N_D,
         q tid d * Real.log (q tid d / (p_T tid * q_D d))) / ell
       let E_w := ∑ d : Fin N_D, q_D d * ((1 + γ) * b_D d + (1 - γ) * a_D d)
       s = E_w - I_TD) }

noncomputable def classicalTransportScore (ε γ : ℝ) (N_ω N_T N_G : ℕ)
    (π : Fin N_ω → ℝ) (T_idx : Fin N_ω → Fin N_T)
    (k_time : Fin N_ω → ℤ) (G_idx : Fin N_ω → Fin N_G)
    (b_G a_G : Fin N_G → ℝ) : ℝ :=
  let ell := Real.log (ε⁻¹)
  let p_T : Fin N_T → ℝ := fun tid => ∑ ω : Fin N_ω, if T_idx ω = tid then π ω else 0
  let p_G : Fin N_G → ℝ := fun g => ∑ ω : Fin N_ω, if G_idx ω = g then π ω else 0
  let p_TG : Fin N_T → Fin N_G → ℝ := fun tid g =>
    ∑ ω : Fin N_ω, if T_idx ω = tid ∧ G_idx ω = g then π ω else 0
  let S_cells : Finset ℤ := Finset.univ.image k_time
  let p_TC : Fin N_T → ℤ → ℝ := fun tid k =>
    ∑ ω : Fin N_ω, if T_idx ω = tid ∧ k_time ω = k then π ω else 0
  let E_w := ∑ g : Fin N_G, p_G g * ((1 + γ) * b_G g + (1 - γ) * a_G g)
  let I_TG := (∑ tid : Fin N_T, ∑ g : Fin N_G,
    p_TG tid g * Real.log (p_TG tid g / (p_T tid * p_G g))) / ell
  let S_t := (∑ tid : Fin N_T, ∑ k ∈ S_cells,
    -(p_TC tid k * Real.log (p_TC tid k / p_T tid))) / ell
  E_w - I_TG + 2 * S_t

def ClassicalLineGrowthBound (γ : ℝ) : Prop :=
  ∀ (B_cl K_hor t_min δ_cl : ℝ),
    1 ≤ B_cl → 1 ≤ K_hor → 0 < t_min → t_min ≤ K_hor → 0 < δ_cl →
    ∃ ε₀ : ℝ, 0 < ε₀ ∧ ε₀ < 1 / 2 ∧
      ∀ (ε t L Δ_time : ℝ),
        0 < ε → ε < ε₀ → t_min ≤ t → t ≤ L → L ≤ K_hor →
        B_cl⁻¹ * ε ^ t ≤ Δ_time → Δ_time ≤ B_cl * ε ^ t →
      ∀ (N_ω N_T N_G : ℕ)
        (π : Fin N_ω → ℝ)
        (T_idx : Fin N_ω → Fin N_T)
        (k_time : Fin N_ω → ℤ)
        (G_idx : Fin N_ω → Fin N_G)
        (V_part A_part : Fin N_T → EuclideanSpace ℝ (Fin 2))
        (b_G a_G : Fin N_G → ℝ)
        (e_G V_G X_G : Fin N_G → EuclideanSpace ℝ (Fin 2))
        (k_G : Fin N_G → ℤ),
        (∀ ω, 0 ≤ π ω) →
        (∑ ω : Fin N_ω, π ω = 1) →
        (∀ tid, ‖V_part tid‖ ≤ B_cl ∧ ‖A_part tid‖ ≤ B_cl) →
        (∀ g, 0 ≤ b_G g ∧ b_G g ≤ a_G g ∧ a_G g + t ≤ L ∧ ‖e_G g‖ = 1) →
        (∀ ω, 0 < π ω →
          let tid := T_idx ω
          let g := G_idx ω
          let c_mid := ((k_time ω : ℝ) + 1 / 2) * Δ_time
          c_mid ∈ Set.Icc (0 : ℝ) 1 ∧
          k_G g = k_time ω ∧
          |inner ℝ (V_part tid - V_G g) (e_G g)| ≤ B_cl * ε ^ (b_G g) ∧
          |inner ℝ (V_part tid - V_G g) (perp2D (e_G g))| ≤ B_cl * ε ^ (a_G g) ∧
          |inner ℝ ((A_part tid + c_mid • V_part tid) - X_G g) (e_G g)| ≤
            B_cl * ε ^ (b_G g + t) ∧
          |inner ℝ ((A_part tid + c_mid • V_part tid) - X_G g) (perp2D (e_G g))| ≤
            B_cl * ε ^ (a_G g + t)) →
        classicalTransportScore ε γ N_ω N_T N_G π T_idx k_time G_idx b_G a_G ≤
          classicalRootSupremum ε L γ N_ω N_T π T_idx V_part A_part + (γ + δ_cl) * t

noncomputable def generalPacketRootScore (ε H_P L R_dom γ lam_sys : ℝ)
    (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
    (f : EuclideanSpace ℝ (Fin 2) → ℂ) : ℝ :=
  let O₀ := rootSiteFinset lam_sys R_dom
  let ρ₀ := (Real.sqrt lam_sys)⁻¹
  let ell := Real.log (ε⁻¹)
  sSup ({ (3 / 2 : ℝ) * (Real.log (∫ v : EuclideanSpace ℝ (Fin 2), ‖f v‖ ^ 2) / ell) } ∪
    { s : ℝ | ∃ (N_D : ℕ)
        (b a : Fin N_D → ℝ)
        (e_dir V_c X_c : Fin N_D → EuclideanSpace ℝ (Fin 2))
        (p : ((ℤ × ℤ) × (ℤ × ℤ)) → Fin N_D → ℝ),
        (∀ d : Fin N_D, 0 ≤ b d ∧ b d ≤ a d ∧ a d ≤ min L (H_P / 2) ∧ ‖e_dir d‖ = 1) ∧
        (∀ o d, 0 ≤ p o d) ∧
        (∀ o d, o ∉ O₀ → p o d = 0) ∧
        (∑ o ∈ O₀, ∑ d : Fin N_D, p o d = 1) ∧
        (∀ o ∈ O₀, ∀ d : Fin N_D, 0 < p o d →
          0 < canonicalRootMass lam_sys Φ₀ f o ∧
          |inner ℝ (gridPt2D ρ₀ o.1 - V_c d) (e_dir d)| ≤ 10 * ε ^ (b d) ∧
          |inner ℝ (gridPt2D ρ₀ o.1 - V_c d) (perp2D (e_dir d))| ≤ 10 * ε ^ (a d) ∧
          |inner ℝ (gridPt2D ρ₀ o.2 - X_c d) (e_dir d)| ≤ 10 * ε ^ (b d) ∧
          |inner ℝ (gridPt2D ρ₀ o.2 - X_c d) (perp2D (e_dir d))| ≤ 10 * ε ^ (a d)) ∧
        (let p_O := fun o => ∑ d : Fin N_D, p o d
         let p_D := fun d => ∑ o ∈ O₀, p o d
         let H_O := (∑ o ∈ O₀, -(p_O o * Real.log (p_O o))) / ell
         let H_O_D := (∑ o ∈ O₀, ∑ d : Fin N_D,
           -(p o d * Real.log (p o d / p_D d))) / ell
         let E_mass := (∑ o ∈ O₀,
           p_O o * Real.log (canonicalRootMass lam_sys Φ₀ f o)) / ell
         let E_w := ∑ d : Fin N_D,
           p_D d * ((1 + γ) * b d + (1 - γ) * a d)
         s = H_O + (1 / 2 : ℝ) * H_O_D + (3 / 2 : ℝ) * E_mass + (1 / 2 : ℝ) * E_w) })

noncomputable def generalPacketObsMass (ε H_P t lam_sys : ℝ) (m_time : ℕ)
    (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
    (f : EuclideanSpace ℝ (Fin 2) → ℂ)
    (r_idx : ℕ) (V_o X_o : EuclideanSpace ℝ (Fin 2))
    (ψ_o : EuclideanSpace ℝ (Fin 2) → ℂ) : ℝ :=
  let ρ_obs := ε ^ ((H_P - t) / 2)
  let C_box := ((r_idx : ℝ) + 1 / 2) * ((2 : ℝ) ^ m_time)⁻¹
  ‖(ρ_obs⁻¹ : ℂ) * ∫ v : EuclideanSpace ℝ (Fin 2),
    f v * ψ_o (ρ_obs⁻¹ • (v - V_o)) *
      Complex.exp (Complex.I * ((lam_sys * Φ₀ (C_box, X_o, v) : ℝ) : ℂ))‖ ^ 2

noncomputable def generalPacketScore (ε γ H_P t lam_sys : ℝ) (m_time : ℕ)
    (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
    (f : EuclideanSpace ℝ (Fin 2) → ℂ)
    (N_O N_D : ℕ)
    (r_O : Fin N_O → ℕ)
    (V_O X_O : Fin N_O → EuclideanSpace ℝ (Fin 2))
    (ψ_O : Fin N_O → EuclideanSpace ℝ (Fin 2) → ℂ)
    (b_D a_D : Fin N_D → ℝ)
    (p : Fin N_O → Fin N_D → ℝ) : ℝ :=
  let ell := Real.log (ε⁻¹)
  let p_O := fun o : Fin N_O => ∑ d : Fin N_D, p o d
  let p_D := fun d : Fin N_D => ∑ o : Fin N_O, p o d
  let H_O := (∑ o : Fin N_O, -(p_O o * Real.log (p_O o))) / ell
  let H_O_D := (∑ o : Fin N_O, ∑ d : Fin N_D,
    -(p o d * Real.log (p o d / p_D d))) / ell
  let E_mass := (∑ o : Fin N_O, p_O o * Real.log
    (generalPacketObsMass ε H_P t lam_sys m_time Φ₀ f (r_O o) (V_O o) (X_O o) (ψ_O o))) / ell
  let E_w := ∑ d : Fin N_D, p_D d * ((1 + γ) * b_D d + (1 - γ) * a_D d)
  H_O + (1 / 2 : ℝ) * H_O_D + (3 / 2 : ℝ) * E_mass + (1 / 2 : ℝ) * E_w

def IsAdmissiblePacketLaw (ε H_P L t B_sys R_win : ℝ) (N_mult : ℕ) (M_win : ℕ → ℝ)
    (lam_sys : ℝ) (m_time : ℕ)
    (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
    (f : EuclideanSpace ℝ (Fin 2) → ℂ)
    (N_O N_D : ℕ)
    (r_O : Fin N_O → ℕ)
    (V_O X_O : Fin N_O → EuclideanSpace ℝ (Fin 2))
    (ψ_O : Fin N_O → EuclideanSpace ℝ (Fin 2) → ℂ)
    (b_D a_D : Fin N_D → ℝ)
    (r_D : Fin N_D → ℕ)
    (e_D V_D X_D : Fin N_D → EuclideanSpace ℝ (Fin 2))
    (p : Fin N_O → Fin N_D → ℝ) : Prop :=
  letI := Classical.propDecidable
  let ρ_obs := ε ^ ((H_P - t) / 2)
  let σ_obs := (lam_sys * ρ_obs)⁻¹
  (∀ o : Fin N_O, r_O o < 2 ^ m_time ∧ ‖V_O o‖ ≤ B_sys ∧ ‖X_O o‖ ≤ B_sys) ∧
  (∀ o : Fin N_O, ∀ k : ℕ, ContDiff ℝ k (ψ_O o)) ∧
  (∀ o : Fin N_O, ∀ z : EuclideanSpace ℝ (Fin 2), R_win ≤ ‖z‖ → ψ_O o z = 0) ∧
  (∀ o : Fin N_O, ∀ (k : ℕ) (z : EuclideanSpace ℝ (Fin 2)),
    ‖iteratedFDeriv ℝ k (ψ_O o) z‖ ≤ M_win k) ∧
  (∀ (r : ℕ) (v₀ x₀ : EuclideanSpace ℝ (Fin 2)),
    ((Finset.univ.filter (fun o : Fin N_O =>
      r_O o = r ∧ ‖V_O o - v₀‖ ≤ ρ_obs ∧ ‖X_O o - x₀‖ ≤ σ_obs)).card : ℝ) ≤ (N_mult : ℝ)) ∧
  (∀ d : Fin N_D, 0 ≤ b_D d ∧ b_D d ≤ a_D d ∧
    a_D d ≤ min (L - t) ((H_P - t) / 2) ∧ r_D d < 2 ^ m_time ∧ ‖e_D d‖ = 1) ∧
  (∀ o d, 0 ≤ p o d) ∧
  (∑ o : Fin N_O, ∑ d : Fin N_D, p o d = 1) ∧
  (∀ o : Fin N_O, ∀ d : Fin N_D, 0 < p o d →
    0 < generalPacketObsMass ε H_P t lam_sys m_time Φ₀ f (r_O o) (V_O o) (X_O o) (ψ_O o) ∧
    r_O o = r_D d ∧
    |inner ℝ (V_O o - V_D d) (e_D d)| ≤ B_sys * ε ^ (b_D d) ∧
    |inner ℝ (V_O o - V_D d) (perp2D (e_D d))| ≤ B_sys * ε ^ (a_D d) ∧
    |inner ℝ (X_O o - X_D d) (e_D d)| ≤ B_sys * ε ^ (b_D d + t) ∧
    |inner ℝ (X_O o - X_D d) (perp2D (e_D d))| ≤ B_sys * ε ^ (a_D d + t))

def ValidPacketGrowthRates (γ : ℝ) : Set ℝ :=
  { b : ℝ | 0 ≤ b ∧ b ≤ 1 ∧
    ∀ (a₀ a₁ A R_dom B_sys K_hor R_win t_min δ : ℝ) (N_mult : ℕ) (M_win : ℕ → ℝ),
      0 < a₀ → a₀ ≤ a₁ → 1 ≤ A → 1 ≤ R_dom → 2 ≤ B_sys →
      1 ≤ K_hor → 2 ≤ R_win → 0 < t_min → t_min ≤ K_hor → 0 < δ → 1 ≤ N_mult →
      ∃ ε₀ : ℝ, 0 < ε₀ ∧ ε₀ < 1 / 2 ∧
        ∀ (ε H_P L t lam_sys : ℝ) (m_time : ℕ),
          0 < ε → ε < ε₀ →
          t_min ≤ t → t ≤ L → t ≤ H_P → H_P ≤ K_hor → L ≤ K_hor →
          B_sys⁻¹ * ε ^ (-H_P) ≤ lam_sys → lam_sys ≤ B_sys * ε ^ (-H_P) →
          B_sys⁻¹ * ε ^ t ≤ ((2 : ℝ) ^ m_time)⁻¹ → ((2 : ℝ) ^ m_time)⁻¹ ≤ B_sys * ε ^ t →
        ∀ (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
          (ζ₀ : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → EuclideanSpace ℝ (Fin 2)),
          IsNormalizedPosDefPhase a₀ a₁ A Φ₀ ζ₀ →
        ∀ (f : EuclideanSpace ℝ (Fin 2) → ℂ),
          MeasureTheory.AEStronglyMeasurable f MeasureTheory.volume →
          (∀ v : EuclideanSpace ℝ (Fin 2), R_dom ≤ ‖v‖ → f v = 0) →
          MeasureTheory.MemLp f 2 MeasureTheory.volume →
          0 < ∫ v : EuclideanSpace ℝ (Fin 2), ‖f v‖ ^ 2 →
        ∀ (N_O N_D : ℕ)
          (r_O : Fin N_O → ℕ)
          (V_O X_O : Fin N_O → EuclideanSpace ℝ (Fin 2))
          (ψ_O : Fin N_O → EuclideanSpace ℝ (Fin 2) → ℂ)
          (b_D a_D : Fin N_D → ℝ)
          (r_D : Fin N_D → ℕ)
          (e_D V_D X_D : Fin N_D → EuclideanSpace ℝ (Fin 2))
          (p : Fin N_O → Fin N_D → ℝ),
          IsAdmissiblePacketLaw ε H_P L t B_sys R_win N_mult M_win
            lam_sys m_time Φ₀ f N_O N_D r_O V_O X_O ψ_O b_D a_D r_D e_D V_D X_D p →
          generalPacketScore ε γ H_P t lam_sys m_time Φ₀ f N_O N_D r_O V_O X_O ψ_O b_D a_D p ≤
            generalPacketRootScore ε H_P L R_dom γ lam_sys Φ₀ f + (b + δ) * t }

noncomputable def quantumPacketRate (γ : ℝ) : ℝ :=
  sInf (ValidPacketGrowthRates γ)
noncomputable def endpointVelFinset (R_dom : ℝ) : Finset (ℤ × ℤ) :=
  letI := Classical.propDecidable
  let B_V : ℤ := ⌈R_dom⌉₊ + 1
  ((Finset.Icc (-B_V) B_V) ×ˢ (Finset.Icc (-B_V) B_V)).filter
    (fun j => ‖gridPt2D 1 j‖ ≤ R_dom)

noncomputable def endpointPosFinset (lam R_dom : ℝ) : Finset (ℤ × ℤ) :=
  letI := Classical.propDecidable
  let B_X : ℤ := ⌈lam * R_dom⌉₊ + 1
  ((Finset.Icc (-B_X) B_X) ×ˢ (Finset.Icc (-B_X) B_X)).filter
    (fun k => ‖gridPt2D lam⁻¹ k‖ ≤ R_dom)

noncomputable def endpointPhaseWindow (lam : ℝ)
    (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
    (χ₀ : EuclideanSpace ℝ (Fin 2) → ℝ)
    (B : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℂ)
    (c₁ C₀ : ℝ) (x₁ X₀ V₀ z : EuclideanSpace ℝ (Fin 2)) : ℂ :=
  (χ₀ z : ℂ) * B (c₁, x₁, V₀ + z) *
    Complex.exp (Complex.I * ((lam * (Φ₀ (c₁, x₁, V₀ + z) - Φ₀ (C₀, X₀, V₀ + z)) : ℝ) : ℂ))

noncomputable def endpointOutputBox (lam : ℝ) (r : ℕ) (k : ℤ × ℤ) :
    Set (ℝ × EuclideanSpace ℝ (Fin 2)) :=
  let m_lam : ℕ := Nat.clog 2 ⌈lam⌉₊
  let Δ_c : ℝ := ((2 : ℝ) ^ m_lam)⁻¹
  let X_k : EuclideanSpace ℝ (Fin 2) := gridPt2D lam⁻¹ k
  Set.Icc ((r : ℝ) * Δ_c) (((r : ℝ) + 1) * Δ_c) ×ˢ
    { x : EuclideanSpace ℝ (Fin 2) |
      |x 0 - X_k 0| ≤ (1 / 2 : ℝ) * lam⁻¹ ∧
      |x 1 - X_k 1| ≤ (1 / 2 : ℝ) * lam⁻¹ }
noncomputable def pktUnitBump1D (s : ℝ) : ℝ :=
  pcGevrey2Bump ((s + 1) / 2)

noncomputable def pktPou1D (s : ℝ) : ℝ :=
  pktUnitBump1D s / Real.sqrt (∑' m : ℤ, (pktUnitBump1D (s - (m : ℝ))) ^ 2)

noncomputable def pktPou2D (z : EuclideanSpace ℝ (Fin 2)) : ℝ :=
  pktPou1D (z 0) * pktPou1D (z 1)

noncomputable def pktVelBox (lam_sys R_dom : ℝ) : Finset (ℤ × ℤ) :=
  letI := Classical.propDecidable
  let ρ₀ := (Real.sqrt lam_sys)⁻¹
  let B_V : ℤ := ⌈Real.sqrt lam_sys * (R_dom + 2)⌉₊ + 1
  ((Finset.Icc (-B_V) B_V) ×ˢ (Finset.Icc (-B_V) B_V)).filter
    (fun j => ‖gridPt2D ρ₀ j‖ ≤ R_dom + 2)

noncomputable def pktLinearCoeff (lam_sys : ℝ)
    (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
    (f : EuclideanSpace ℝ (Fin 2) → ℂ)
    (j n : ℤ × ℤ) : ℂ :=
  let ρ₀ := (Real.sqrt lam_sys)⁻¹
  let V_j := gridPt2D ρ₀ j
  ((4 : ℂ)⁻¹ * (ρ₀⁻¹ : ℂ)) * ∫ v : EuclideanSpace ℝ (Fin 2),
    f v * (pktPou2D (ρ₀⁻¹ • (v - V_j)) : ℂ) *
      Complex.exp (Complex.I *
        ((lam_sys * Φ₀ (1 / 2, 0, v) -
          (Real.pi / 2) * inner ℝ (gridPt2D 1 n) (ρ₀⁻¹ • (v - V_j)) : ℝ) : ℂ))

noncomputable def pktLinearAtom (lam_sys : ℝ)
    (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
    (j n : ℤ × ℤ) (v : EuclideanSpace ℝ (Fin 2)) : ℂ :=
  let ρ₀ := (Real.sqrt lam_sys)⁻¹
  let V_j := gridPt2D ρ₀ j
  ((4 : ℂ)⁻¹ * (ρ₀⁻¹ : ℂ)) * (pktPou2D (ρ₀⁻¹ • (v - V_j)) : ℂ) *
    Complex.exp (Complex.I *
      ((-lam_sys * Φ₀ (1 / 2, 0, v) +
        (Real.pi / 2) * inner ℝ (gridPt2D 1 n) (ρ₀⁻¹ • (v - V_j)) : ℝ) : ℂ))

noncomputable def pktRound2D (s : ℝ) (x : EuclideanSpace ℝ (Fin 2)) : ℤ × ℤ :=
  (⌊s⁻¹ * x 0 + 1 / 2⌋, ⌊s⁻¹ * x 1 + 1 / 2⌋)
def ValidClassicalGrowthRates (γ : ℝ) : Set ℝ :=
  { b : ℝ | 0 ≤ b ∧ b ≤ 2 ∧
    ∀ (B_cl K_hor t_min δ_cl : ℝ),
      1 ≤ B_cl → 1 ≤ K_hor → 0 < t_min → t_min ≤ K_hor → 0 < δ_cl →
      ∃ ε₀ : ℝ, 0 < ε₀ ∧ ε₀ < 1 / 2 ∧
        ∀ (ε t L Δ_time : ℝ),
          0 < ε → ε < ε₀ → t_min ≤ t → t ≤ L → L ≤ K_hor →
          B_cl⁻¹ * ε ^ t ≤ Δ_time → Δ_time ≤ B_cl * ε ^ t →
        ∀ (N_ω N_T N_G : ℕ)
          (π : Fin N_ω → ℝ)
          (T_idx : Fin N_ω → Fin N_T)
          (k_time : Fin N_ω → ℤ)
          (G_idx : Fin N_ω → Fin N_G)
          (V_part A_part : Fin N_T → EuclideanSpace ℝ (Fin 2))
          (b_G a_G : Fin N_G → ℝ)
          (e_G V_G X_G : Fin N_G → EuclideanSpace ℝ (Fin 2))
          (k_G : Fin N_G → ℤ),
          (∀ ω, 0 ≤ π ω) →
          (∑ ω : Fin N_ω, π ω = 1) →
          (∀ tid, ‖V_part tid‖ ≤ B_cl ∧ ‖A_part tid‖ ≤ B_cl) →
          (∀ g, 0 ≤ b_G g ∧ b_G g ≤ a_G g ∧ a_G g + t ≤ L ∧ ‖e_G g‖ = 1) →
          (∀ ω, 0 < π ω →
            let tid := T_idx ω
            let g := G_idx ω
            let c_mid := ((k_time ω : ℝ) + 1 / 2) * Δ_time
            c_mid ∈ Set.Icc (0 : ℝ) 1 ∧
            k_G g = k_time ω ∧
            |inner ℝ (V_part tid - V_G g) (e_G g)| ≤ B_cl * ε ^ (b_G g) ∧
            |inner ℝ (V_part tid - V_G g) (perp2D (e_G g))| ≤ B_cl * ε ^ (a_G g) ∧
            |inner ℝ ((A_part tid + c_mid • V_part tid) - X_G g) (e_G g)| ≤
              B_cl * ε ^ (b_G g + t) ∧
            |inner ℝ ((A_part tid + c_mid • V_part tid) - X_G g) (perp2D (e_G g))| ≤
              B_cl * ε ^ (a_G g + t)) →
          classicalTransportScore ε γ N_ω N_T N_G π T_idx k_time G_idx b_G a_G ≤
            classicalRootSupremum ε L γ N_ω N_T π T_idx V_part A_part + (b + δ_cl) * t }

noncomputable def classicalGrowthRate (γ : ℝ) : ℝ :=
  sInf (ValidClassicalGrowthRates γ)

noncomputable def dyadicTimeLevel (ε u : ℝ) : ℕ :=
  Nat.clog 2 ⌈ε ^ (-u)⌉₊

noncomputable def dyadicTimeBin (ε u c : ℝ) : ℤ :=
  let m := dyadicTimeLevel ε u
  min ⌊c * (2 : ℝ) ^ m⌋ ((2 ^ m : ℤ) - 1)

noncomputable def dyadicTimeMid (ε u c : ℝ) : ℝ :=
  let m := dyadicTimeLevel ε u
  ((dyadicTimeBin ε u c : ℝ) + 1 / 2) * ((2 : ℝ) ^ m)⁻¹

noncomputable def dyadicRealLevel (ε L : ℝ) : ℤ :=
  ⌊L * (Real.log (ε⁻¹) / Real.log 2)⌋

noncomputable def dyadicRealStep (ε L : ℝ) : ℝ :=
  (2 : ℝ) ^ (-dyadicRealLevel ε L)

noncomputable def dyadicRealBin (ε L x : ℝ) : ℤ :=
  ⌊x * (2 : ℝ) ^ (dyadicRealLevel ε L)⌋

noncomputable def dyadicRealMid (ε L x : ℝ) : ℝ :=
  ((dyadicRealBin ε L x : ℝ) + 1 / 2) * dyadicRealStep ε L

noncomputable def finProbAt {N_ω : ℕ} {α : Type} (π : Fin N_ω → ℝ)
    (X : Fin N_ω → α) (ω : Fin N_ω) : ℝ :=
  letI := Classical.propDecidable
  ∑ ω' : Fin N_ω, if X ω' = X ω then π ω' else 0

noncomputable def finProbAt2 {N_ω : ℕ} {α β : Type} (π : Fin N_ω → ℝ)
    (X : Fin N_ω → α) (Y : Fin N_ω → β) (ω : Fin N_ω) : ℝ :=
  letI := Classical.propDecidable
  ∑ ω' : Fin N_ω, if X ω' = X ω ∧ Y ω' = Y ω then π ω' else 0

noncomputable def condSurprise {N_ω : ℕ} {α β : Type} (ε : ℝ) (π : Fin N_ω → ℝ)
    (X : Fin N_ω → α) (Y : Fin N_ω → β) (ω : Fin N_ω) : ℝ :=
  -(Real.log (finProbAt2 π X Y ω / finProbAt π X ω)) / Real.log (ε⁻¹)

noncomputable def finCondEntropy {N_ω : ℕ} {α β : Type} (ε : ℝ) (π : Fin N_ω → ℝ)
    (X : Fin N_ω → α) (Y : Fin N_ω → β) : ℝ :=
  ∑ ω : Fin N_ω, π ω * condSurprise ε π X Y ω

noncomputable def finMutualInfo {N_ω : ℕ} {α β : Type} (ε : ℝ) (π : Fin N_ω → ℝ)
    (X : Fin N_ω → α) (Y : Fin N_ω → β) : ℝ :=
  finCondEntropy ε π (fun _ => ()) Y - finCondEntropy ε π X Y

def HasIsotropicExtremizer (γ : ℝ) : Prop :=
  ∃ (B_iso s : ℝ)
    (ε_seq : ℕ → ℝ)
    (N_ω N_T : ℕ → ℕ)
    (π_seq : ∀ n, Fin (N_ω n) → ℝ)
    (T_seq : ∀ n, Fin (N_ω n) → Fin (N_T n))
    (V_seq A_seq : ∀ n, Fin (N_T n) → EuclideanSpace ℝ (Fin 2))
    (c_seq : ∀ n, Fin (N_ω n) → ℝ),
    1 ≤ B_iso ∧ 0 ≤ s ∧ s ≤ 1 ∧
    (∀ n, 0 < ε_seq n ∧ ε_seq n < 1 / 2) ∧
    Filter.Tendsto ε_seq Filter.atTop (nhds 0) ∧
    (∀ n, (∀ ω, 0 ≤ π_seq n ω) ∧ (∑ ω : Fin (N_ω n), π_seq n ω = 1) ∧
      (∀ tid, ‖V_seq n tid‖ ≤ B_iso ∧ ‖A_seq n tid‖ ≤ B_iso) ∧
      (∀ ω, 0 < π_seq n ω → c_seq n ω ∈ Set.Icc (0 : ℝ) 1)) ∧
    Filter.Tendsto (fun n =>
      let ε := ε_seq n
      let k_t := fun ω => dyadicTimeBin ε 1 (c_seq n ω)
      let O_end := fun ω : Fin (N_ω n) =>
        let tid := T_seq n ω
        let x_pos := A_seq n tid + (dyadicTimeMid ε 1 (c_seq n ω)) • V_seq n tid
        (k_t ω, dyadicRealBin ε 1 (x_pos 0), dyadicRealBin ε 1 (x_pos 1))
      (-finMutualInfo ε (π_seq n) (T_seq n) O_end +
        2 * finCondEntropy ε (π_seq n) (T_seq n) k_t) -
        classicalRootSupremum ε 1 γ (N_ω n) (N_T n) (π_seq n) (T_seq n) (V_seq n) (A_seq n))
      Filter.atTop (nhds (classicalGrowthRate γ)) ∧
    (∀ u ∈ Set.Icc (0 : ℝ) 1, ∀ δ : ℝ, 0 < δ →
      Filter.Tendsto (fun n =>
        let ε := ε_seq n
        let k_u := fun ω => dyadicTimeBin ε u (c_seq n ω)
        ∑ ω : Fin (N_ω n),
          if δ < |condSurprise ε (π_seq n) (T_seq n) k_u ω - s * u| then π_seq n ω else 0)
        Filter.atTop (nhds 0))

def InResolutionCone (n : ℕ) (c : Fin n → ℝ) (E_cone : Fin n → Fin n → Prop)
    (p : (Fin n → ℝ) × ℝ) : Prop :=
  p.2 ∈ Set.Ioo (0 : ℝ) 1 ∧
  ∀ j k : Fin n, E_cone j k → p.1 k - p.1 j ≤ (c k - c j) * p.2

def InDispCone (n : ℕ) (c : Fin n → ℝ) (E_cone : Fin n → Fin n → Prop)
    (ξ : (Fin n → ℝ) × ℝ) : Prop :=
  ∀ j k : Fin n, E_cone j k → ξ.1 k - ξ.1 j ≤ (c k - c j) * ξ.2

def planeEmbed (n : ℕ) (c : Fin n → ℝ) (iu : ℝ × ℝ) : (Fin n → ℝ) × ℝ :=
  (fun j => iu.1 + c j * iu.2, iu.2)

def IsSubmodularConeProfile (n : ℕ) (c d : Fin n → ℝ) (d_v : ℝ)
    (E_cone : Fin n → Fin n → Prop) (f : ((Fin n → ℝ) × ℝ) → ℝ) : Prop :=
  (∀ (L : Fin n → ℝ) (v h : ℝ) (j : Fin n),
    0 ≤ h →
    InResolutionCone n c E_cone (L, v) →
    InResolutionCone n c E_cone (Function.update L j (L j + h), v) →
    0 ≤ f (Function.update L j (L j + h), v) - f (L, v) ∧
    f (Function.update L j (L j + h), v) - f (L, v) ≤ d j * h) ∧
  (∀ (L : Fin n → ℝ) (v h : ℝ),
    0 ≤ h →
    InResolutionCone n c E_cone (L, v) →
    InResolutionCone n c E_cone (L, v + h) →
    0 ≤ f (L, v + h) - f (L, v) ∧
    f (L, v + h) - f (L, v) ≤ d_v * h) ∧
  (∀ (L : Fin n → ℝ) (v h₁ h₂ : ℝ) (j k : Fin n),
    j ≠ k → 0 ≤ h₁ → 0 ≤ h₂ →
    let L_j := Function.update L j (L j + h₁)
    let L_k := Function.update L k (L k + h₂)
    let L_jk := Function.update L_j k (L_j k + h₂)
    InResolutionCone n c E_cone (L, v) →
    InResolutionCone n c E_cone (L_j, v) →
    InResolutionCone n c E_cone (L_k, v) →
    InResolutionCone n c E_cone (L_jk, v) →
    f (L_jk, v) - f (L_j, v) - f (L_k, v) + f (L, v) ≤ 0) ∧
  (∀ (L : Fin n → ℝ) (v h₁ h₂ : ℝ) (j : Fin n),
    0 ≤ h₁ → 0 ≤ h₂ →
    let L_j := Function.update L j (L j + h₁)
    InResolutionCone n c E_cone (L, v) →
    InResolutionCone n c E_cone (L_j, v) →
    InResolutionCone n c E_cone (L, v + h₂) →
    InResolutionCone n c E_cone (L_j, v + h₂) →
    f (L_j, v + h₂) - f (L_j, v) - f (L, v + h₂) + f (L, v) ≤ 0)

def E_cone4 (j k : Fin 4) : Prop :=
  (j = 0 ∧ k = 1) ∨ (j = 0 ∧ k = 2) ∨ (j = 1 ∧ k = 3) ∨ (j = 2 ∧ k = 3)

noncomputable def rowObs6 (ε m : ℝ) (V_p A_p : EuclideanSpace ℝ (Fin 2))
    (c_s R_s : ℝ) (q : ℝ × ℝ × ℝ × ℝ × ℝ) : ℤ × ℤ × ℤ × ℤ × ℤ × ℤ :=
  let (L_X, L_Y, L_W, L_Z, v) := q
  let k_c := dyadicTimeBin ε v c_s
  let C_v := dyadicTimeMid ε v c_s
  let k_r := dyadicRealBin ε (m * v) R_s
  let R_mv := dyadicRealMid ε (m * v) R_s
  let X := V_p 0
  let Y := A_p 0 + C_v * X
  let W := V_p 1 - R_mv * X
  let Z := A_p 1 + C_v * (V_p 1) - R_mv * Y
  (k_c, k_r, dyadicRealBin ε L_X X, dyadicRealBin ε L_Y Y,
    dyadicRealBin ε L_W W, dyadicRealBin ε L_Z Z)

def MatchedClockRatesDistinct (s σ : ℝ) (r : Fin 4 → ℝ) : Prop :=
  (∀ j : Fin 4, 0 ≤ r j ∧ r j ≤ 1) ∧
  (0 < r 0 → min 1 (r 0 + s) ≤ r 1) ∧
  (0 < r 2 → min 1 (r 2 + s) ≤ r 3) ∧
  (0 < r 0 → min 1 (r 0 + σ) ≤ r 2) ∧
  (0 < r 1 → min 1 (r 1 + σ) ≤ r 3)

def MatchedClockRatesTied (s : ℝ) (r : Fin 3 → ℝ) : Prop :=
  0 ≤ r 0 ∧ r 0 ≤ 1 ∧ 0 ≤ r 1 ∧ r 1 ≤ 2 ∧ 0 ≤ r 2 ∧ r 2 ≤ 1 ∧
  (0 < r 0 → s ≤ r 1) ∧
  (0 < r 0 ∧ r 2 < 1 → r 0 + s ≤ r 2) ∧
  (r 2 < 1 → r 1 ≤ 2 - s)

structure MatchedAspectProfileSystem (γ m : ℝ) : Type where
  B_sys : ℝ
  κ : ℝ
  τ : ℝ
  b : ℝ → ℝ
  S : ℝ → ℝ
  f_raw : ((Fin 4 → ℝ) × ℝ) → ℝ
  g_x : ℝ → ℝ → ℝ
  ε_seq : ℕ → ℝ
  N_ω : ℕ → ℕ
  N_T : ℕ → ℕ
  π_seq : ∀ k, Fin (N_ω k) → ℝ
  T_seq : ∀ k, Fin (N_ω k) → Fin (N_T k)
  V_seq : ∀ k, Fin (N_T k) → EuclideanSpace ℝ (Fin 2)
  A_seq : ∀ k, Fin (N_T k) → EuclideanSpace ℝ (Fin 2)
  c_seq : ∀ k, Fin (N_ω k) → ℝ
  R_seq : ∀ k, Fin (N_ω k) → ℝ
  H_uncond : List (ℚ × ℚ × ℚ × ℚ × ℚ) → ℝ
  H_condT : List (ℚ × ℚ × ℚ × ℚ × ℚ) → ℝ
  hB_sys : 1 ≤ B_sys
  hκ : 0 < κ
  hτ : 0 ≤ τ ∧ τ ≤ 2 * (1 + m)
  hb_lip : ∀ u₁ u₂ : ℝ, u₁ ≤ u₂ → 0 ≤ b u₁ - b u₂ ∧ b u₁ - b u₂ ≤ (1 + m) * (u₂ - u₁)
  hb_dom : ∀ u ∈ Set.Icc (0 : ℝ) 1, 0 ≤ b u ∧ b u + (1 + m) * u ≤ 1 + m
  hS_lip : ∀ u₁ u₂ : ℝ, u₁ ≤ u₂ → 0 ≤ S u₂ - S u₁ ∧ S u₂ - S u₁ ≤ u₂ - u₁
  hS_zero : S 0 = 0
  hε_bounds : ∀ k, 0 < ε_seq k ∧ ε_seq k < 1 / 2
  hε_tendsto : Filter.Tendsto ε_seq Filter.atTop (nhds 0)
  h_law : ∀ k, (∀ ω, 0 ≤ π_seq k ω) ∧ (∑ ω : Fin (N_ω k), π_seq k ω = 1) ∧
    (∀ tid, ‖V_seq k tid‖ ≤ B_sys ∧ ‖A_seq k tid‖ ≤ B_sys) ∧
    (∀ ω, 0 < π_seq k ω → c_seq k ω ∈ Set.Icc (0 : ℝ) 1 ∧ |R_seq k ω| ≤ B_sys)
  h_homog : ∀ (Q_fin : Finset (List (ℚ × ℚ × ℚ × ℚ × ℚ))) (δ : ℝ),
    (∀ L_list ∈ Q_fin, ∀ q ∈ L_list, (q.2.2.2.2 : ℝ) ∈ Set.Ioo (0 : ℝ) 1) →
    0 < δ →
    ∃ K₀ : ℕ, ∀ k : ℕ, K₀ ≤ k →
      ∃ E_good : Finset (Fin (N_ω k)),
        1 - δ ≤ (∑ ω ∈ E_good, π_seq k ω) ∧
        ∀ ω ∈ E_good, ∀ L_list ∈ Q_fin,
          let obs := fun ω' : Fin (N_ω k) =>
            L_list.map (fun q => rowObs6 (ε_seq k) m
              (V_seq k (T_seq k ω')) (A_seq k (T_seq k ω')) (c_seq k ω') (R_seq k ω')
              (q.1, q.2.1, q.2.2.1, q.2.2.2.1, q.2.2.2.2))
          |condSurprise (ε_seq k) (π_seq k) (fun _ => ()) obs ω - H_uncond L_list| ≤ δ ∧
          |condSurprise (ε_seq k) (π_seq k) (T_seq k) obs ω - H_condT L_list| ≤ δ
  h_time_ent : ∀ v ∈ Set.Ioo (0 : ℝ) 1,
    Filter.Tendsto (fun k =>
      finCondEntropy (ε_seq k) (π_seq k) (T_seq k)
        (fun ω => dyadicTimeBin (ε_seq k) v (c_seq k ω)))
      Filter.atTop (nhds (S v))
  h_orient_pred : ∀ v ∈ Set.Ioo (0 : ℝ) 1,
    Filter.Tendsto (fun k =>
      finCondEntropy (ε_seq k) (π_seq k)
        (fun ω => (T_seq k ω, dyadicTimeBin (ε_seq k) v (c_seq k ω)))
        (fun ω => dyadicRealBin (ε_seq k) (m * v) (R_seq k ω)))
      Filter.atTop (nhds 0)
  h_orient_growth : ∀ (v a δ : ℝ),
    0 < v → 0 < a → v + a < 1 → 0 < δ →
    ∃ K₀ : ℕ, ∀ k : ℕ, K₀ ≤ k →
      κ * a - δ ≤ finCondEntropy (ε_seq k) (π_seq k)
        (fun ω => (T_seq k ω, dyadicTimeBin (ε_seq k) v (c_seq k ω)))
        (fun ω => dyadicRealBin (ε_seq k) (m * (v + a)) (R_seq k ω))
  h_f_lim : ∀ K_c : Set ((Fin 4 → ℝ) × ℝ),
    K_c ⊆ { p | InResolutionCone 4 ![0, 1, m, 1 + m] E_cone4 p } →
    IsCompact K_c →
    TendstoUniformlyOn (fun k (p : (Fin 4 → ℝ) × ℝ) =>
      finMutualInfo (ε_seq k) (π_seq k) (T_seq k)
        (fun ω => rowObs6 (ε_seq k) m
          (V_seq k (T_seq k ω)) (A_seq k (T_seq k ω)) (c_seq k ω) (R_seq k ω)
          (p.1 0, p.1 1, p.1 2, p.1 3, p.2)))
      f_raw Filter.atTop K_c
  h_submod : IsSubmodularConeProfile 4 ![0, 1, m, 1 + m] ![1, 1, 1, 1] (1 + m) E_cone4 f_raw
  h_obstacle : ∀ (i u : ℝ),
    u ∈ Set.Ioo (0 : ℝ) 1 → 0 ≤ i → i + (1 + m) * u ≤ 1 + m →
    2 * i + (1 - γ) * m * u + 2 * S u - classicalGrowthRate γ * u - τ ≤
      f_raw (planeEmbed 4 ![0, 1, m, 1 + m] (i, u))
  h_contact : ∀ u ∈ Set.Ioo (0 : ℝ) 1,
    f_raw (planeEmbed 4 ![0, 1, m, 1 + m] (b u, u)) =
      2 * (b u) + (1 - γ) * m * u + 2 * S u - classicalGrowthRate γ * u - τ
  h_x_refine : ∀ u₀ ∈ Set.Ioo (0 : ℝ) 1,
    g_x u₀ 0 = 0 ∧
    (∀ d₁ d₂ : ℝ, d₁ ≤ d₂ → 0 ≤ g_x u₀ d₂ - g_x u₀ d₁ ∧ g_x u₀ d₂ - g_x u₀ d₁ ≤ d₂ - d₁) ∧
    (∀ d : ℝ, 0 ≤ d → d ≤ m * u₀ → γ * d ≤ g_x u₀ d) ∧
    (∀ (lam_s h i t : ℝ),
      0 < lam_s → lam_s < min 1 m → 0 < h → h < u₀ →
      b u₀ ≤ i → i ≤ b u₀ + lam_s * h → 0 < t → i + t < b u₀ + m * u₀ →
      let p₀ := planeEmbed 4 ![0, 1, m, 1 + m] (i, u₀ - h)
      let p_t := (Function.update p₀.1 0 (p₀.1 0 + t), p₀.2)
      g_x u₀ (i - b u₀ + t) - g_x u₀ (i - b u₀) ≤ f_raw p_t - f_raw p₀)
structure PacketBoundClass where
  a₀ : ℝ
  a₁ : ℝ
  A : ℝ
  R_dom : ℝ
  B_sys : ℝ
  K_hor : ℝ
  R_win : ℝ
  N_mult : ℕ
  M_win : ℕ → ℝ
  ha₀ : 0 < a₀
  ha₁ : a₀ ≤ a₁
  hA : 1 ≤ A
  hR_dom : 1 ≤ R_dom
  hB_sys : 2 ≤ B_sys
  hK_hor : 1 ≤ K_hor
  hR_win : 2 ≤ R_win
  hN_mult : 1 ≤ N_mult

noncomputable def nextPacketClass (M_atom : ℝ → ℝ → ℝ → ℝ → ℝ → ℕ → ℝ)
    (cls : PacketBoundClass) : PacketBoundClass where
  a₀ := cls.a₀
  a₁ := cls.a₁
  A := cls.A
  R_dom := cls.R_dom
  B_sys := 16 * cls.B_sys + 4 * cls.R_win + 20
  K_hor := cls.K_hor
  R_win := 4
  N_mult := 81
  M_win := M_atom cls.a₀ cls.a₁ cls.A cls.B_sys cls.R_win
  ha₀ := cls.ha₀
  ha₁ := cls.ha₁
  hA := cls.hA
  hR_dom := cls.hR_dom
  hB_sys := by linarith [cls.hB_sys, cls.hR_win]
  hK_hor := cls.hK_hor
  hR_win := by norm_num
  hN_mult := by omega

noncomputable def localRescaledClass (cls : PacketBoundClass) (d : ℝ) : PacketBoundClass where
  a₀ := cls.a₀
  a₁ := cls.a₁
  A := 3 * cls.A
  R_dom := 8 * cls.B_sys + cls.R_win + 20
  B_sys := 8 * cls.B_sys + 20
  K_hor := max 1 (cls.K_hor / d)
  R_win := cls.R_win
  N_mult := cls.N_mult
  M_win := cls.M_win
  ha₀ := cls.ha₀
  ha₁ := cls.ha₁
  hA := by linarith [cls.hA]
  hR_dom := by linarith [cls.hB_sys, cls.hR_win]
  hB_sys := by linarith [cls.hB_sys]
  hK_hor := le_max_left 1 _
  hR_win := cls.hR_win
  hN_mult := cls.hN_mult

def IsValidPacketEnv (cls : PacketBoundClass) (ε H_P L lam_sys : ℝ)
    (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
    (ζ₀ : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → EuclideanSpace ℝ (Fin 2))
    (f : EuclideanSpace ℝ (Fin 2) → ℂ) : Prop :=
  0 < ε ∧ ε < 1 / 2 ∧
  0 < H_P ∧ H_P ≤ cls.K_hor ∧ 0 < L ∧ L ≤ cls.K_hor ∧
  cls.B_sys⁻¹ * ε ^ (-H_P) ≤ lam_sys ∧ lam_sys ≤ cls.B_sys * ε ^ (-H_P) ∧
  IsNormalizedPosDefPhase cls.a₀ cls.a₁ cls.A Φ₀ ζ₀ ∧
  MeasureTheory.AEStronglyMeasurable f MeasureTheory.volume ∧
  (∀ v : EuclideanSpace ℝ (Fin 2), cls.R_dom ≤ ‖v‖ → f v = 0) ∧
  MeasureTheory.MemLp f 2 MeasureTheory.volume ∧
  0 < ∫ v : EuclideanSpace ℝ (Fin 2), ‖f v‖ ^ 2

noncomputable def localGaugePhase
    (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
    (m_r q_r : ℕ) (s_v : ℝ) (V_J X_J : EuclideanSpace ℝ (Fin 2))
    (cxv : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2)) : ℝ :=
  let s_c := ((2 : ℝ) ^ m_r)⁻¹
  let C_r := ((q_r : ℝ) + 1 / 2) * s_c
  let s_x := s_c * s_v
  let c := C_r + s_c * (cxv.1 - 1 / 2)
  let x := X_J + (s_c * (cxv.1 - 1 / 2)) • V_J + s_x • cxv.2.1
  let v := V_J + s_v • cxv.2.2
  let c₀ := C_r - s_c / 2
  let x₀ := X_J - (s_c / 2) • V_J
  (s_c * s_v ^ 2)⁻¹ *
    (Φ₀ (c, x, v) - Φ₀ (c, x, V_J) - Φ₀ (c₀, x₀, v) + Φ₀ (c₀, x₀, V_J))

noncomputable def localGaugeGrad
    (ζ₀ : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → EuclideanSpace ℝ (Fin 2))
    (m_r q_r : ℕ) (s_v : ℝ) (V_J X_J : EuclideanSpace ℝ (Fin 2))
    (vp : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2)) : EuclideanSpace ℝ (Fin 2) :=
  let s_c := ((2 : ℝ) ^ m_r)⁻¹
  let C_r := ((q_r : ℝ) + 1 / 2) * s_c
  let s_x := s_c * s_v
  let v := V_J + s_v • vp.1
  s_x⁻¹ •
    (ζ₀ (v, X_J - C_r • v + s_x • (vp.2 + (1 / 2 : ℝ) • vp.1)) -
     ζ₀ (v, X_J - C_r • v + ((1 / 2 : ℝ) * s_x) • vp.1))

noncomputable def localGaugeInput
    (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
    (lam_sys : ℝ) (m_r q_r : ℕ) (s_v : ℝ) (V_J X_J : EuclideanSpace ℝ (Fin 2))
    (f : EuclideanSpace ℝ (Fin 2) → ℂ) (v' : EuclideanSpace ℝ (Fin 2)) : ℂ :=
  let s_c := ((2 : ℝ) ^ m_r)⁻¹
  let C_r := ((q_r : ℝ) + 1 / 2) * s_c
  let c₀ := C_r - s_c / 2
  let x₀ := X_J - (s_c / 2) • V_J
  let v := V_J + s_v • v'
  (s_v : ℂ) * f v *
    Complex.exp (Complex.I * ((lam_sys * (Φ₀ (c₀, x₀, v) - Φ₀ (c₀, x₀, V_J)) : ℝ) : ℂ))

def LocalPhaseRescalingValid : Prop :=
  ∀ (a₀ a₁ A : ℝ), 0 < a₀ → a₀ ≤ a₁ → 1 ≤ A →
  ∀ (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
    (ζ₀ : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → EuclideanSpace ℝ (Fin 2)),
    IsNormalizedPosDefPhase a₀ a₁ A Φ₀ ζ₀ →
  ∀ (m_r m_t q_r : ℕ), m_r ≤ m_t → q_r < 2 ^ m_r →
  ∀ (ε H_P t r b_star s_v lam_sys : ℝ),
    0 < ε → 0 < s_v → s_v ≤ 1 → s_v = ε ^ b_star → 0 < lam_sys →
  ∀ (V_J X_J : EuclideanSpace ℝ (Fin 2)) (f : EuclideanSpace ℝ (Fin 2) → ℂ),
    MeasureTheory.AEStronglyMeasurable f MeasureTheory.volume →
    MeasureTheory.MemLp f 2 MeasureTheory.volume →
    let s_c := ((2 : ℝ) ^ m_r)⁻¹
    let C_r := ((q_r : ℝ) + 1 / 2) * s_c
    let s_x := s_c * s_v
    let Φ'₀ := localGaugePhase Φ₀ m_r q_r s_v V_J X_J
    let ζ'₀ := localGaugeGrad ζ₀ m_r q_r s_v V_J X_J
    let f'₀ := localGaugeInput Φ₀ lam_sys m_r q_r s_v V_J X_J f
    IsNormalizedPosDefPhase a₀ a₁ (3 * A) Φ'₀ ζ'₀ ∧
    MeasureTheory.AEStronglyMeasurable f'₀ MeasureTheory.volume ∧
    MeasureTheory.MemLp f'₀ 2 MeasureTheory.volume ∧
    (∫ v', ‖f'₀ v'‖ ^ 2 = ∫ v, ‖f v‖ ^ 2) ∧
    (∀ R_supp : ℝ, (∀ v, R_supp ≤ ‖v - V_J‖ → f v = 0) →
      ∀ v', s_v⁻¹ * R_supp ≤ ‖v'‖ → f'₀ v' = 0) ∧
    (∀ (r_loc : ℕ), r_loc < 2 ^ (m_t - m_r) →
      ∀ (V'_o X'_o : EuclideanSpace ℝ (Fin 2)) (ψ_o : EuclideanSpace ℝ (Fin 2) → ℂ),
        let r_full := q_r * 2 ^ (m_t - m_r) + r_loc
        let C_t := ((r_full : ℝ) + 1 / 2) * ((2 : ℝ) ^ m_t)⁻¹
        generalPacketObsMass ε (H_P - r - 2 * b_star) (t - r) (s_c * s_v ^ 2 * lam_sys)
          (m_t - m_r) Φ'₀ f'₀ r_loc V'_o X'_o ψ_o =
        generalPacketObsMass ε H_P t lam_sys m_t Φ₀ f r_full
          (V_J + s_v • V'_o) (X_J + (C_t - C_r) • V_J + s_x • X'_o) ψ_o)

def HasRootWidthGap (ν κ ε H_P L R_dom γ lam_sys : ℝ)
    (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
    (f : EuclideanSpace ℝ (Fin 2) → ℂ) : Prop :=
  let O₀ := rootSiteFinset lam_sys R_dom
  let ρ₀ := (Real.sqrt lam_sys)⁻¹
  let ell := Real.log (ε⁻¹)
  let K₀ := generalPacketRootScore ε H_P L R_dom γ lam_sys Φ₀ f
  ∀ (N_D : ℕ) (b a : Fin N_D → ℝ) (e_dir V_c X_c : Fin N_D → EuclideanSpace ℝ (Fin 2))
    (p : ((ℤ × ℤ) × (ℤ × ℤ)) → Fin N_D → ℝ),
    (∀ d : Fin N_D, 0 ≤ b d ∧ b d ≤ a d ∧ a d ≤ min L (H_P / 2) ∧ ‖e_dir d‖ = 1) →
    (∀ d : Fin N_D, (0 < ∑ o ∈ O₀, p o d) → H_P / 2 - ν ≤ b d) →
    (∀ o d, 0 ≤ p o d) →
    (∀ o d, o ∉ O₀ → p o d = 0) →
    (∑ o ∈ O₀, ∑ d : Fin N_D, p o d = 1) →
    (∀ o ∈ O₀, ∀ d : Fin N_D, 0 < p o d →
      0 < canonicalRootMass lam_sys Φ₀ f o ∧
      |inner ℝ (gridPt2D ρ₀ o.1 - V_c d) (e_dir d)| ≤ 10 * ε ^ (b d) ∧
      |inner ℝ (gridPt2D ρ₀ o.1 - V_c d) (perp2D (e_dir d))| ≤ 10 * ε ^ (a d) ∧
      |inner ℝ (gridPt2D ρ₀ o.2 - X_c d) (e_dir d)| ≤ 10 * ε ^ (b d) ∧
      |inner ℝ (gridPt2D ρ₀ o.2 - X_c d) (perp2D (e_dir d))| ≤ 10 * ε ^ (a d)) →
    let p_O := fun o => ∑ d : Fin N_D, p o d
    let p_D := fun d => ∑ o ∈ O₀, p o d
    let H_O := (∑ o ∈ O₀, -(p_O o * Real.log (p_O o))) / ell
    let H_O_D := (∑ o ∈ O₀, ∑ d : Fin N_D, -(p o d * Real.log (p o d / p_D d))) / ell
    let E_mass := (∑ o ∈ O₀, p_O o * Real.log (canonicalRootMass lam_sys Φ₀ f o)) / ell
    let E_w := ∑ d : Fin N_D, p_D d * ((1 + γ) * b d + (1 - γ) * a d)
    H_O + (1 / 2 : ℝ) * H_O_D + (3 / 2 : ℝ) * E_mass + (1 / 2 : ℝ) * E_w ≤ K₀ - κ

def IsDurationOneSaturatingClass (γ Δ : ℝ) (cls : PacketBoundClass) : Prop :=
  ∀ ε₀ : ℝ, 0 < ε₀ → ε₀ < 1 / 2 →
    ∃ (ε H_P L lam_sys : ℝ) (m_time : ℕ)
      (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
      (ζ₀ : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → EuclideanSpace ℝ (Fin 2))
      (f : EuclideanSpace ℝ (Fin 2) → ℂ)
      (N_O N_D : ℕ) (r_O : Fin N_O → ℕ) (V_O X_O : Fin N_O → EuclideanSpace ℝ (Fin 2))
      (ψ_O : Fin N_O → EuclideanSpace ℝ (Fin 2) → ℂ) (b_D a_D : Fin N_D → ℝ)
      (r_D : Fin N_D → ℕ) (e_D V_D X_D : Fin N_D → EuclideanSpace ℝ (Fin 2))
      (p : Fin N_O → Fin N_D → ℝ),
      ε < ε₀ ∧ 1 ≤ H_P ∧ 1 ≤ L ∧
      IsValidPacketEnv cls ε H_P L lam_sys Φ₀ ζ₀ f ∧
      cls.B_sys⁻¹ * ε ^ (1 : ℝ) ≤ ((2 : ℝ) ^ m_time)⁻¹ ∧
      ((2 : ℝ) ^ m_time)⁻¹ ≤ cls.B_sys * ε ^ (1 : ℝ) ∧
      IsAdmissiblePacketLaw ε H_P L 1 cls.B_sys cls.R_win cls.N_mult cls.M_win
        lam_sys m_time Φ₀ f N_O N_D r_O V_O X_O ψ_O b_D a_D r_D e_D V_D X_D p ∧
      generalPacketRootScore ε H_P L cls.R_dom γ lam_sys Φ₀ f + quantumPacketRate γ - Δ ≤
        generalPacketScore ε γ H_P 1 lam_sys m_time Φ₀ f N_O N_D r_O V_O X_O ψ_O b_D a_D p

def IsForcedSaturatingClass (γ ν κ Δ : ℝ) (cls : PacketBoundClass) : Prop :=
  ∀ ε₀ : ℝ, 0 < ε₀ → ε₀ < 1 / 2 →
    ∃ (ε H_P L lam_sys : ℝ) (m_time : ℕ)
      (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
      (ζ₀ : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → EuclideanSpace ℝ (Fin 2))
      (f : EuclideanSpace ℝ (Fin 2) → ℂ)
      (N_O N_D : ℕ) (r_O : Fin N_O → ℕ) (V_O X_O : Fin N_O → EuclideanSpace ℝ (Fin 2))
      (ψ_O : Fin N_O → EuclideanSpace ℝ (Fin 2) → ℂ) (b_D a_D : Fin N_D → ℝ)
      (r_D : Fin N_D → ℕ) (e_D V_D X_D : Fin N_D → EuclideanSpace ℝ (Fin 2))
      (p : Fin N_O → Fin N_D → ℝ),
      ε < ε₀ ∧ 1 ≤ H_P ∧ 1 ≤ L ∧
      IsValidPacketEnv cls ε H_P L lam_sys Φ₀ ζ₀ f ∧
      cls.B_sys⁻¹ * ε ^ (1 : ℝ) ≤ ((2 : ℝ) ^ m_time)⁻¹ ∧
      ((2 : ℝ) ^ m_time)⁻¹ ≤ cls.B_sys * ε ^ (1 : ℝ) ∧
      IsAdmissiblePacketLaw ε H_P L 1 cls.B_sys cls.R_win cls.N_mult cls.M_win
        lam_sys m_time Φ₀ f N_O N_D r_O V_O X_O ψ_O b_D a_D r_D e_D V_D X_D p ∧
      generalPacketRootScore ε H_P L cls.R_dom γ lam_sys Φ₀ f + quantumPacketRate γ - Δ ≤
        generalPacketScore ε γ H_P 1 lam_sys m_time Φ₀ f N_O N_D r_O V_O X_O ψ_O b_D a_D p ∧
      HasRootWidthGap ν κ ε H_P L cls.R_dom γ lam_sys Φ₀ f

def ForcedRootSystemExists (γ : ℝ) : Prop :=
  ∃ (ν κ : ℝ), 0 < ν ∧ 0 < κ ∧
    ∀ Δ : ℝ, 0 < Δ → ∃ cls : PacketBoundClass, IsForcedSaturatingClass γ ν κ Δ cls

def UniformPacketGrowthModulus (γ b_rate : ℝ) : Prop :=
  ∀ (cls : PacketBoundClass) (t_min δ : ℝ),
    0 < t_min → t_min ≤ cls.K_hor → 0 < δ →
    ∃ ε₀ : ℝ, 0 < ε₀ ∧ ε₀ < 1 / 2 ∧
      ∀ (ε H_P L t lam_sys : ℝ) (m_time : ℕ)
        (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
        (ζ₀ : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → EuclideanSpace ℝ (Fin 2))
        (f : EuclideanSpace ℝ (Fin 2) → ℂ)
        (N_O N_D : ℕ) (r_O : Fin N_O → ℕ) (V_O X_O : Fin N_O → EuclideanSpace ℝ (Fin 2))
        (ψ_O : Fin N_O → EuclideanSpace ℝ (Fin 2) → ℂ) (b_D a_D : Fin N_D → ℝ)
        (r_D : Fin N_D → ℕ) (e_D V_D X_D : Fin N_D → EuclideanSpace ℝ (Fin 2))
        (p : Fin N_O → Fin N_D → ℝ),
        ε < ε₀ → t_min ≤ t → t ≤ L → t ≤ H_P →
        IsValidPacketEnv cls ε H_P L lam_sys Φ₀ ζ₀ f →
        cls.B_sys⁻¹ * ε ^ t ≤ ((2 : ℝ) ^ m_time)⁻¹ →
        ((2 : ℝ) ^ m_time)⁻¹ ≤ cls.B_sys * ε ^ t →
        IsAdmissiblePacketLaw ε H_P L t cls.B_sys cls.R_win cls.N_mult cls.M_win
          lam_sys m_time Φ₀ f N_O N_D r_O V_O X_O ψ_O b_D a_D r_D e_D V_D X_D p →
        generalPacketScore ε γ H_P t lam_sys m_time Φ₀ f N_O N_D r_O V_O X_O ψ_O b_D a_D p ≤
          generalPacketRootScore ε H_P L cls.R_dom γ lam_sys Φ₀ f + (b_rate + δ) * t

def DurationScalingValid (γ : ℝ) : Prop :=
  ∀ (ε H_P L d R_dom B_sys R_win : ℝ) (N_mult : ℕ) (M_win : ℕ → ℝ) (lam_sys : ℝ) (m_time : ℕ)
    (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
    (f : EuclideanSpace ℝ (Fin 2) → ℂ)
    (N_O N_D : ℕ) (r_O : Fin N_O → ℕ) (V_O X_O : Fin N_O → EuclideanSpace ℝ (Fin 2))
    (ψ_O : Fin N_O → EuclideanSpace ℝ (Fin 2) → ℂ) (b_D a_D : Fin N_D → ℝ)
    (r_D : Fin N_D → ℕ) (e_D V_D X_D : Fin N_D → EuclideanSpace ℝ (Fin 2))
    (p : Fin N_O → Fin N_D → ℝ),
    0 < ε → ε < 1 / 2 → 0 < d → ε ^ d < 1 / 2 →
    (IsAdmissiblePacketLaw ε H_P L d B_sys R_win N_mult M_win
        lam_sys m_time Φ₀ f N_O N_D r_O V_O X_O ψ_O b_D a_D r_D e_D V_D X_D p →
      IsAdmissiblePacketLaw (ε ^ d) (H_P / d) (L / d) 1 B_sys R_win N_mult M_win
        lam_sys m_time Φ₀ f N_O N_D r_O V_O X_O ψ_O (fun j => b_D j / d) (fun j => a_D j / d)
        r_D e_D V_D X_D p) ∧
    generalPacketScore (ε ^ d) γ (H_P / d) 1 lam_sys m_time Φ₀ f N_O N_D r_O V_O X_O ψ_O
      (fun j => b_D j / d) (fun j => a_D j / d) p =
      d⁻¹ * generalPacketScore ε γ H_P d lam_sys m_time Φ₀ f N_O N_D r_O V_O X_O ψ_O b_D a_D p ∧
    generalPacketRootScore (ε ^ d) (H_P / d) (L / d) R_dom γ lam_sys Φ₀ f =
      d⁻¹ * generalPacketRootScore ε H_P L R_dom γ lam_sys Φ₀ f ∧
    (∀ ν κ : ℝ,
      HasRootWidthGap (ν / d) (κ / d) (ε ^ d) (H_P / d) (L / d) R_dom γ lam_sys Φ₀ f ↔
      HasRootWidthGap ν κ ε H_P L R_dom γ lam_sys Φ₀ f)

def PacketCutDecompositionValid (M_atom : ℝ → ℝ → ℝ → ℝ → ℝ → ℕ → ℝ) : Prop :=
  ∀ (cls : PacketBoundClass) (Δ_u A_amp B_cut : ℝ),
    0 < Δ_u → 0 < A_amp → 2 * A_amp + 12 * cls.K_hor + 16 ≤ B_cut →
    ∃ (C_cut C_can C_Bes : ℝ) (M_mult : ℕ) (C_tr C_rtail : ℕ → ℝ) (ε_cut : ℝ),
      2 ≤ C_cut ∧ 1 ≤ C_can ∧ 1 ≤ C_Bes ∧ 1 ≤ M_mult ∧
      (∀ M, 0 ≤ C_tr M) ∧ (∀ M, 0 ≤ C_rtail M) ∧ 0 < ε_cut ∧ ε_cut < 1 / 2 ∧
      ∀ (ε H_P L t r b_star lam_sys : ℝ) (m_r m_t q_r : ℕ)
        (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
        (ζ₀ : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → EuclideanSpace ℝ (Fin 2))
        (f : EuclideanSpace ℝ (Fin 2) → ℂ) (V_J X_J : EuclideanSpace ℝ (Fin 2)),
        ε < ε_cut → IsValidPacketEnv cls ε H_P L lam_sys Φ₀ ζ₀ f →
        0 ≤ r → r < t → t ≤ H_P → 0 ≤ b_star → b_star ≤ (H_P - t) / 2 →
        Δ_u ≤ (H_P - r) / 2 - b_star →
        ((r = 0 ∧ m_r = 0) ∨
         (0 < r ∧ (2 * cls.B_sys)⁻¹ * ε ^ r ≤ ((2 : ℝ) ^ m_r)⁻¹ ∧
           ((2 : ℝ) ^ m_r)⁻¹ ≤ (2 * cls.B_sys) * ε ^ r)) →
        m_r ≤ m_t → q_r < 2 ^ m_r →
        cls.B_sys⁻¹ * ε ^ t ≤ ((2 : ℝ) ^ m_t)⁻¹ → ((2 : ℝ) ^ m_t)⁻¹ ≤ cls.B_sys * ε ^ t →
        ‖V_J‖ ≤ 2 * cls.B_sys → ‖X_J‖ ≤ 4 * cls.B_sys →
        let s_c := ((2 : ℝ) ^ m_r)⁻¹
        let C_r := ((q_r : ℝ) + 1 / 2) * s_c
        let s_v := ε ^ b_star
        let s_x := s_c * s_v
        let ρ_r := if r = 0 then (Real.sqrt lam_sys)⁻¹ else ε ^ ((H_P - r) / 2)
        let σ_r := (lam_sys * ρ_r)⁻¹
        let ρ_t := ε ^ ((H_P - t) / 2)
        ∃ (N_atom : ℕ) (o_atom : Fin N_atom → (ℤ × ℤ) × (ℤ × ℤ))
          (ψ_atom : Fin N_atom → EuclideanSpace ℝ (Fin 2) → ℂ) (c_atom : Fin N_atom → ℂ),
          let V_at := fun α => gridPt2D ρ_r (o_atom α).1
          let X_at := fun α => gridPt2D σ_r (o_atom α).2
          let g_at := fun α (v : EuclideanSpace ℝ (Fin 2)) =>
            (ρ_r⁻¹ : ℂ) * star (ψ_atom α (ρ_r⁻¹ • (v - V_at α))) *
              Complex.exp (-(Complex.I * ((lam_sys * Φ₀ (C_r, X_at α, v) : ℝ) : ℂ)))
          (∀ α, (∀ k : ℕ, ContDiff ℝ k (ψ_atom α)) ∧
            (∀ z, 4 ≤ ‖z‖ → ψ_atom α z = 0) ∧
            (∀ k z, ‖iteratedFDeriv ℝ k (ψ_atom α) z‖ ≤
              M_atom cls.a₀ cls.a₁ cls.A cls.B_sys cls.R_win k)) ∧
          (∀ α, ‖V_at α - V_J‖ ≤ 4 * cls.B_sys * s_v + cls.R_win * s_v + 4 * s_v ∧
            ‖X_at α - X_J‖ ≤ 8 * cls.B_sys * s_x + 2 * cls.R_win * s_x + 10 * s_x) ∧
          (∀ o₀, ((Finset.univ.filter (fun α => o_atom α = o₀)).card : ℝ) ≤ (M_mult : ℝ)) ∧
          ((N_atom : ℝ) ≤ C_cut * ε ^ (-(4 * cls.K_hor + 4))) ∧
          (∀ α, ε ^ B_cut * (∫ v, ‖f v‖ ^ 2) ≤ ‖c_atom α‖ ^ 2) ∧
          (∑ α : Fin N_atom, ‖c_atom α‖ ^ 2 ≤ ∫ v, ‖f v‖ ^ 2) ∧
          (0 < r → ∀ α, ‖c_atom α‖ ^ 2 =
            generalPacketObsMass ε H_P r lam_sys m_r Φ₀ f q_r (V_at α) (X_at α) (ψ_atom α)) ∧
          (r = 0 → ∀ α, o_atom α ∈ rootSiteFinset lam_sys cls.R_dom ∧
            ‖c_atom α‖ ^ 2 ≤ C_can * canonicalRootMass lam_sys Φ₀ f (o_atom α)) ∧
          (∀ (r_loc : ℕ), r_loc < 2 ^ (m_t - m_r) →
            let C_t := (((q_r * 2 ^ (m_t - m_r) + r_loc : ℕ) : ℝ) + 1 / 2) * ((2 : ℝ) ^ m_t)⁻¹
            ∀ (V_o X_o : EuclideanSpace ℝ (Fin 2)) (ψ_o : EuclideanSpace ℝ (Fin 2) → ℂ),
              ‖V_o - V_J‖ ≤ 4 * cls.B_sys * s_v →
              ‖X_o + (C_r - C_t) • V_o - X_J‖ ≤ 4 * cls.B_sys * s_x →
              (∀ k : ℕ, ContDiff ℝ k ψ_o) →
              (∀ z, cls.R_win ≤ ‖z‖ → ψ_o z = 0) →
              (∀ k z, ‖iteratedFDeriv ℝ k ψ_o z‖ ≤ cls.M_win k) →
              let pair_fn := fun h : EuclideanSpace ℝ (Fin 2) → ℂ =>
                (ρ_t⁻¹ : ℂ) * ∫ v, h v * ψ_o (ρ_t⁻¹ • (v - V_o)) *
                  Complex.exp (Complex.I * ((lam_sys * Φ₀ (C_t, X_o, v) : ℝ) : ℂ))
              ‖pair_fn f - pair_fn (fun v => ∑ α : Fin N_atom, c_atom α * g_at α v)‖ ≤
                C_cut * ε ^ A_amp * Real.sqrt (∫ v, ‖f v‖ ^ 2) ∧
              ∀ (S : Finset (Fin N_atom)) (M_tr : ℕ) (R_tr : ℝ), 2 ≤ M_tr → 2 ≤ R_tr →
                letI := Classical.propDecidable
                let S_near := S.filter (fun α =>
                  ‖V_o - V_at α‖ ≤ C_cut * ρ_t ∧
                  ‖X_o - X_at α - (C_t - C_r) • V_at α‖ ≤ C_cut * R_tr * σ_r)
                ‖pair_fn (fun v => ∑ α ∈ S, c_atom α * g_at α v) -
                 pair_fn (fun v => ∑ α ∈ S_near, c_atom α * g_at α v)‖ ≤
                  C_tr M_tr * R_tr ^ (1 - (M_tr : ℝ)) * Real.sqrt (∫ v, ‖f v‖ ^ 2)) ∧
          (∀ S : Finset (Fin N_atom),
            let h_S := fun v => ∑ α ∈ S, c_atom α * g_at α v
            let lam_loc := s_c * s_v ^ 2 * lam_sys
            let ρ'₀ := (Real.sqrt lam_loc)⁻¹
            let Φ'₀ := localGaugePhase Φ₀ m_r q_r s_v V_J X_J
            let h'_S := localGaugeInput Φ₀ lam_sys m_r q_r s_v V_J X_J h_S
            MeasureTheory.AEStronglyMeasurable h_S MeasureTheory.volume ∧
            MeasureTheory.MemLp h_S 2 MeasureTheory.volume ∧
            (∫ v, ‖h_S v‖ ^ 2 ≤ C_Bes * ∑ α ∈ S, ‖c_atom α‖ ^ 2) ∧
            (∀ R'_dom : ℝ, 1 ≤ R'_dom →
              (∑ o ∈ rootSiteFinset lam_loc R'_dom, canonicalRootMass lam_loc Φ'₀ h'_S o ≤
                C_Bes * ∑ α ∈ S, ‖c_atom α‖ ^ 2) ∧
              ∀ (b_F a_F R_cap : ℝ) (M_cap : ℕ) (e_F V_F X_F : EuclideanSpace ℝ (Fin 2))
                (F_sites : Finset ((ℤ × ℤ) × (ℤ × ℤ))),
                2 ≤ R_cap → 3 ≤ M_cap → ‖e_F‖ = 1 →
                F_sites ⊆ rootSiteFinset lam_loc R'_dom →
                (∀ o ∈ F_sites,
                  |inner ℝ (gridPt2D ρ'₀ o.1 - V_F) e_F| ≤ 10 * ε ^ b_F ∧
                  |inner ℝ (gridPt2D ρ'₀ o.1 - V_F) (perp2D e_F)| ≤ 10 * ε ^ a_F ∧
                  |inner ℝ (gridPt2D ρ'₀ o.2 - X_F) e_F| ≤ 10 * ε ^ b_F ∧
                  |inner ℝ (gridPt2D ρ'₀ o.2 - X_F) (perp2D e_F)| ≤ 10 * ε ^ a_F) →
                letI := Classical.propDecidable
                let S_cap := S.filter (fun α =>
                  let V'_α := s_v⁻¹ • (V_at α - V_J)
                  let X'_α := s_x⁻¹ • (X_at α - X_J)
                  |inner ℝ (V'_α - V_F) e_F| ≤ 10 * ε ^ b_F + C_cut * R_cap * ρ'₀ ∧
                  |inner ℝ (V'_α - V_F) (perp2D e_F)| ≤ 10 * ε ^ a_F + C_cut * R_cap * ρ'₀ ∧
                  |inner ℝ (X'_α - X_F) e_F| ≤ 10 * ε ^ b_F + C_cut * R_cap * ρ'₀ ∧
                  |inner ℝ (X'_α - X_F) (perp2D e_F)| ≤ 10 * ε ^ a_F + C_cut * R_cap * ρ'₀)
                ∑ o ∈ F_sites, canonicalRootMass lam_loc Φ'₀ h'_S o ≤
                  C_Bes * (∑ α ∈ S_cap, ‖c_atom α‖ ^ 2) +
                  C_rtail M_cap * R_cap ^ (4 - 2 * (M_cap : ℝ)) * (∑ α ∈ S, ‖c_atom α‖ ^ 2)))

def CoherentStripMassBoundValid : Prop :=
  ∀ (a₀ a₁ A B_cell R_win : ℝ) (N_mult M_mult : ℕ) (M_atom M_win : ℕ → ℝ),
    0 < a₀ → a₀ ≤ a₁ → 1 ≤ A → 2 ≤ B_cell → 2 ≤ R_win → 1 ≤ N_mult → 1 ≤ M_mult →
    ∃ C_coh : ℝ, 1 ≤ C_coh ∧
      ∀ (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
        (ζ₀ : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → EuclideanSpace ℝ (Fin 2)),
        IsNormalizedPosDefPhase a₀ a₁ A Φ₀ ζ₀ →
      ∀ (lam_loc ρ s c_end R : ℝ),
        0 < lam_loc → 0 < s → s ≤ ρ → ρ ≤ 1 →
        B_cell⁻¹ ≤ lam_loc * s ^ 2 → lam_loc * s ^ 2 ≤ B_cell →
        c_end ∈ Set.Icc (0 : ℝ) 1 → 1 ≤ R →
      ∀ (V_P X_Q n_P : EuclideanSpace ℝ (Fin 2)), ‖n_P‖ = 1 →
      ∀ (d_dim N_Q K N_obs : ℕ), (d_dim = 1 ∨ d_dim = 2) → 1 ≤ K →
      ∀ (V_T X_T : Fin N_Q → EuclideanSpace ℝ (Fin 2))
        (η_T : Fin N_Q → EuclideanSpace ℝ (Fin 2) → ℂ)
        (c_T : Fin N_Q → ℂ) (bin_of : Fin N_Q → Fin K)
        (V_O X_O : Fin N_obs → EuclideanSpace ℝ (Fin 2))
        (ψ_O : Fin N_obs → EuclideanSpace ℝ (Fin 2) → ℂ),
        (letI := Classical.propDecidable
         let σ := (lam_loc * ρ)⁻¹
         (∀ T, (∀ k : ℕ, ContDiff ℝ k (η_T T)) ∧ (∀ z, 4 ≤ ‖z‖ → η_T T z = 0) ∧
           (∀ k z, ‖iteratedFDeriv ℝ k (η_T T) z‖ ≤ M_atom k) ∧
           ‖V_T T - V_P‖ ≤ B_cell * ρ ∧
           ‖(X_T T + (c_end - 1 / 2) • V_T T) - X_Q‖ ≤ R * s) ∧
         (∀ v₀ x₀, ((Finset.univ.filter (fun T : Fin N_Q =>
           ‖V_T T - v₀‖ ≤ s ∧ ‖X_T T - x₀‖ ≤ s)).card : ℝ) ≤ (M_mult : ℝ)) ∧
         (∀ T₁ T₂, bin_of T₁ = bin_of T₂ →
           (d_dim = 1 → |inner ℝ (V_T T₁ - V_T T₂) n_P| ≤ B_cell * s) ∧
           (d_dim = 2 → ‖V_T T₁ - V_T T₂‖ ≤ B_cell * s)) ∧
         (∀ o, (∀ k : ℕ, ContDiff ℝ k (ψ_O o)) ∧ (∀ z, R_win ≤ ‖z‖ → ψ_O o z = 0) ∧
           (∀ k z, ‖iteratedFDeriv ℝ k (ψ_O o) z‖ ≤ M_win k) ∧
           ‖V_O o - V_P‖ ≤ B_cell * ρ) ∧
         (∀ v₀ x₀, ((Finset.univ.filter (fun o : Fin N_obs =>
           ‖V_O o - v₀‖ ≤ ρ ∧ ‖X_O o - x₀‖ ≤ σ)).card : ℝ) ≤ (N_mult : ℝ))) →
        let σ := (lam_loc * ρ)⁻¹
        let h_Q := fun v : EuclideanSpace ℝ (Fin 2) => ∑ T : Fin N_Q, c_T T *
          ((s⁻¹ : ℂ) * η_T T (s⁻¹ • (v - V_T T)) *
            Complex.exp (-(Complex.I * ((lam_loc * Φ₀ (1 / 2, X_T T, v) : ℝ) : ℂ))))
        let m_obs := fun o : Fin N_obs =>
          ‖(ρ⁻¹ : ℂ) * ∫ v, h_Q v * ψ_O o (ρ⁻¹ • (v - V_O o)) *
            Complex.exp (Complex.I * ((lam_loc * Φ₀ (c_end, X_O o, v) : ℝ) : ℂ))‖ ^ 2
        (∑ o : Fin N_obs, m_obs o ≤ C_coh * ∑ T : Fin N_Q, ‖c_T T‖ ^ 2) ∧
        (∀ (x_Z : EuclideanSpace ℝ (Fin 2)) (S_Z : Finset (Fin N_obs)),
          (∀ o ∈ S_Z,
            (d_dim = 1 → |inner ℝ (X_O o - x_Z) n_P| ≤ B_cell * σ ∧
              |inner ℝ (X_O o - x_Z) (perp2D n_P)| ≤ B_cell * s) ∧
            (d_dim = 2 → ‖X_O o - x_Z‖ ≤ B_cell * σ)) →
          ∑ o ∈ S_Z, m_obs o ≤
            C_coh * (K : ℝ) * R ^ 2 * (s / ρ) ^ d_dim * (∑ T : Fin N_Q, ‖c_T T‖ ^ 2))

noncomputable def projAngleDist (n₁ n₂ : EuclideanSpace ℝ (Fin 2)) : ℝ :=
  |inner ℝ n₁ (perp2D n₂)|

def HasIncomingCredit (ε H_P t h C_cell : ℝ) (d_dim N_O N_D : ℕ)
    (r_O : Fin N_O → ℕ) (V_O X_O : Fin N_O → EuclideanSpace ℝ (Fin 2))
    (e_D : Fin N_D → EuclideanSpace ℝ (Fin 2)) (p : Fin N_O → Fin N_D → ℝ)
    (k_f α_f : ℝ) : Prop :=
  letI := Classical.propDecidable
  k_f ≤ 0 ∨
  (0 < k_f ∧
   ∃ (L_grid : ℝ) (τ_V τ_X : EuclideanSpace ℝ (Fin 2))
     (P_f : Fin N_O → ℕ × (ℤ × ℤ) × (ℤ × ℤ))
     (n_f : (ℕ × (ℤ × ℤ) × (ℤ × ℤ)) → EuclideanSpace ℝ (Fin 2))
     (W_f : Fin N_O → ℤ × ℤ),
     let u_t := (H_P - t) / 2
     let s_Vf := L_grid * ε ^ (u_t - h)
     let s_Xf := L_grid * ε ^ (t + u_t - h)
     1 ≤ L_grid ∧ L_grid ≤ C_cell ∧
     (∀ p_c, ‖n_f p_c‖ = 1) ∧
     (∀ o : Fin N_O, (P_f o).1 = r_O o ∧
       ‖V_O o - (τ_V + gridPt2D s_Vf (P_f o).2.1)‖ ≤ s_Vf ∧
       ‖X_O o - (τ_X + gridPt2D s_Xf (P_f o).2.2)‖ ≤ s_Xf ∧
       (d_dim = 1 →
         |inner ℝ (V_O o - (τ_V + gridPt2D s_Vf (P_f o).2.1)) (n_f (P_f o)) -
           ((W_f o).1 : ℝ) * ε ^ u_t| ≤ ε ^ u_t ∧ (W_f o).2 = 0) ∧
       (d_dim = 2 →
         ‖V_O o - (τ_V + gridPt2D s_Vf (P_f o).2.1) - gridPt2D (ε ^ u_t) (W_f o)‖ ≤
           2 * ε ^ u_t)) ∧
     (d_dim = 1 → ∀ o d, 0 < p o d →
       projAngleDist (perp2D (e_D d)) (n_f (P_f o)) ≤ C_cell * ε ^ h) ∧
     (∀ (p_c : ℕ × (ℤ × ℤ) × (ℤ × ℤ)) (w : ℤ × ℤ),
       ∑ o ∈ Finset.univ.filter (fun o => P_f o = p_c ∧ W_f o = w), (∑ d : Fin N_D, p o d) ≤
         ε ^ (k_f - α_f) *
           ∑ o ∈ Finset.univ.filter (fun o => P_f o = p_c), (∑ d : Fin N_D, p o d)))

def IsCutChainState (γ : ℝ) (cls : PacketBoundClass) (ε H_P L t h lam_sys : ℝ)
    (C_cell : ℝ) (d_dim : ℕ)
    (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
    (f : EuclideanSpace ℝ (Fin 2) → ℂ)
    (δ_def k_cred α_cred : ℝ) : Prop :=
  let m_t : ℕ := Nat.floor (t * Real.log (ε⁻¹) / Real.log 2)
  ∃ (N_O N_D : ℕ) (r_O : Fin N_O → ℕ) (V_O X_O : Fin N_O → EuclideanSpace ℝ (Fin 2))
    (ψ_O : Fin N_O → EuclideanSpace ℝ (Fin 2) → ℂ) (b_D a_D : Fin N_D → ℝ)
    (r_D : Fin N_D → ℕ) (e_D V_D X_D : Fin N_D → EuclideanSpace ℝ (Fin 2))
    (p : Fin N_O → Fin N_D → ℝ),
    cls.B_sys⁻¹ * ε ^ t ≤ ((2 : ℝ) ^ m_t)⁻¹ ∧
    ((2 : ℝ) ^ m_t)⁻¹ ≤ cls.B_sys * ε ^ t ∧
    IsAdmissiblePacketLaw ε H_P L t cls.B_sys cls.R_win cls.N_mult cls.M_win
      lam_sys m_t Φ₀ f N_O N_D r_O V_O X_O ψ_O b_D a_D r_D e_D V_D X_D p ∧
    (d_dim = 2 → ∀ d : Fin N_D, b_D d = (H_P - t) / 2 ∧ a_D d = (H_P - t) / 2) ∧
    generalPacketRootScore ε H_P L cls.R_dom γ lam_sys Φ₀ f +
      quantumPacketRate γ * t - δ_def ≤
      generalPacketScore ε γ H_P t lam_sys m_t Φ₀ f N_O N_D r_O V_O X_O ψ_O b_D a_D p ∧
    HasIncomingCredit ε H_P t h C_cell d_dim N_O N_D r_O V_O X_O e_D p k_cred α_cred

def LocalNonForcedAtScale (γ : ℝ) (loc_cls : PacketBoundClass) (d ν_loc κ_loc τ_no ε : ℝ) : Prop :=
  ∀ (H'_P L' lam_loc : ℝ) (m_loc : ℕ)
    (Φ'₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
    (ζ'₀ : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → EuclideanSpace ℝ (Fin 2))
    (h'_in : EuclideanSpace ℝ (Fin 2) → ℂ)
    (N_O N_D : ℕ) (r_O : Fin N_O → ℕ) (V_O X_O : Fin N_O → EuclideanSpace ℝ (Fin 2))
    (ψ_O : Fin N_O → EuclideanSpace ℝ (Fin 2) → ℂ) (b_D a_D : Fin N_D → ℝ)
    (r_D : Fin N_D → ℕ) (e_D V_D X_D : Fin N_D → EuclideanSpace ℝ (Fin 2))
    (p : Fin N_O → Fin N_D → ℝ),
    d ≤ H'_P → H'_P ≤ d * loc_cls.K_hor → d ≤ L' → L' ≤ d * loc_cls.K_hor →
    loc_cls.B_sys⁻¹ * ε ^ (-H'_P) ≤ lam_loc → lam_loc ≤ loc_cls.B_sys * ε ^ (-H'_P) →
    loc_cls.B_sys⁻¹ * ε ^ d ≤ ((2 : ℝ) ^ m_loc)⁻¹ → ((2 : ℝ) ^ m_loc)⁻¹ ≤ loc_cls.B_sys * ε ^ d →
    IsNormalizedPosDefPhase loc_cls.a₀ loc_cls.a₁ loc_cls.A Φ'₀ ζ'₀ →
    MeasureTheory.AEStronglyMeasurable h'_in MeasureTheory.volume →
    (∀ v', loc_cls.R_dom ≤ ‖v'‖ → h'_in v' = 0) →
    MeasureTheory.MemLp h'_in 2 MeasureTheory.volume →
    0 < ∫ v', ‖h'_in v'‖ ^ 2 →
    IsAdmissiblePacketLaw ε H'_P L' d loc_cls.B_sys loc_cls.R_win loc_cls.N_mult loc_cls.M_win
      lam_loc m_loc Φ'₀ h'_in N_O N_D r_O V_O X_O ψ_O b_D a_D r_D e_D V_D X_D p →
    generalPacketRootScore ε H'_P L' loc_cls.R_dom γ lam_loc Φ'₀ h'_in +
      quantumPacketRate γ * d - τ_no ≤
      generalPacketScore ε γ H'_P d lam_loc m_loc Φ'₀ h'_in N_O N_D r_O V_O X_O ψ_O b_D a_D p →
    ¬ HasRootWidthGap ν_loc κ_loc ε H'_P L' loc_cls.R_dom γ lam_loc Φ'₀ h'_in
def IsStrictDispCone (n : ℕ) (c : Fin n → ℝ) (E_cone : Fin n → Fin n → Prop)
    (η : (Fin n → ℝ) × ℝ) : Prop :=
  ∀ j k : Fin n, E_cone j k → η.1 k - η.1 j < (c k - c j) * η.2

def InStrictResolutionCone (n : ℕ) (c : Fin n → ℝ) (E_cone : Fin n → Fin n → Prop)
    (p : (Fin n → ℝ) × ℝ) : Prop :=
  p.2 ∈ Set.Ioo (0 : ℝ) 1 ∧ IsStrictDispCone n c E_cone p

noncomputable def strictConeRestrict (n : ℕ) (c : Fin n → ℝ) (E_cone : Fin n → Fin n → Prop)
    (f : ((Fin n → ℝ) × ℝ) → ℝ) (p : (Fin n → ℝ) × ℝ) : ℝ :=
  letI := Classical.propDecidable
  if InStrictResolutionCone n c E_cone p then f p else 0

noncomputable def conePartialL (n : ℕ) (c d : Fin n → ℝ) (E_cone : Fin n → Fin n → Prop)
    (f : ((Fin n → ℝ) × ℝ) → ℝ) (j : Fin n) (p : (Fin n → ℝ) × ℝ) : ℝ :=
  let f₀ := strictConeRestrict n c E_cone f
  Filter.limsup (fun m : ℕ =>
    max 0 (min (d j) (((m + 1 : ℝ)) *
      (f₀ (Function.update p.1 j (p.1 j + ((m + 1 : ℝ))⁻¹), p.2) - f₀ p))))
    Filter.atTop

noncomputable def conePartialV (n : ℕ) (c : Fin n → ℝ) (d_v : ℝ) (E_cone : Fin n → Fin n → Prop)
    (f : ((Fin n → ℝ) × ℝ) → ℝ) (p : (Fin n → ℝ) × ℝ) : ℝ :=
  let f₀ := strictConeRestrict n c E_cone f
  Filter.limsup (fun m : ℕ =>
    max 0 (min d_v (((m + 1 : ℝ)) * (f₀ (p.1, p.2 + ((m + 1 : ℝ))⁻¹) - f₀ p))))
    Filter.atTop

def HasTangentBoxTrace (g : ℝ × ℝ → ℝ) (b₀ u₀ p val_minus val_plus : ℝ) : Prop :=
  Filter.Tendsto (fun ρ : ℝ =>
    ρ⁻¹ ^ 2 * ∫ u in (u₀ - ρ)..(u₀ + ρ),
      ∫ r in (-ρ)..(0 : ℝ), |g (b₀ - p * (u - u₀) + r, u) - val_minus|)
    (nhdsWithin 0 (Set.Ioi 0)) (nhds 0) ∧
  Filter.Tendsto (fun ρ : ℝ =>
    ρ⁻¹ ^ 2 * ∫ u in (u₀ - ρ)..(u₀ + ρ),
      ∫ r in (0 : ℝ)..ρ, |g (b₀ - p * (u - u₀) + r, u) - val_plus|)
    (nhdsWithin 0 (Set.Ioi 0)) (nhds 0)

def IsCharacteristicTraceData (n : ℕ) (j_top : Fin n) (c d : Fin n → ℝ) (d_v : ℝ)
    (E_cone : Fin n → Fin n → Prop) (f : ((Fin n → ℝ) × ℝ) → ℝ)
    (a : Fin n → ℝ × ℝ → ℝ) (D : ℝ × ℝ → ℝ) : Prop :=
  letI := Classical.propDecidable
  (∀ j : Fin n, Measurable (a j) ∧ ∀ iu : ℝ × ℝ, 0 ≤ a j iu ∧ a j iu ≤ d j) ∧
  (Measurable D ∧ ∀ iu : ℝ × ℝ, 0 ≤ D iu ∧ D iu ≤ d_v) ∧
  (∃ M_lip : ℝ, 0 ≤ M_lip ∧
    ∀ p q : (Fin n → ℝ) × ℝ,
      InResolutionCone n c E_cone p → InResolutionCone n c E_cone q →
      |f p - f q| ≤ M_lip * ((∑ j : Fin n, |p.1 j - q.1 j|) + |p.2 - q.2|)) ∧
  (∀ (K δ R : ℝ), 1 ≤ K → 0 < δ → δ < 1 / 2 → 1 ≤ R →
    Filter.Tendsto (fun h : ℝ =>
      ∫ i in (-K)..K, ∫ u in δ..(1 - δ),
        ∫ ξ : (Fin n → ℝ) × ℝ,
          if IsStrictDispCone n c E_cone ξ ∧ (∀ j, |ξ.1 j| ≤ R) ∧ |ξ.2| ≤ R then
            (∑ j : Fin n,
              |conePartialL n c d E_cone f j (planeEmbed n c (i, u) + h • ξ) - a j (i, u)|) +
              |conePartialV n c d_v E_cone f (planeEmbed n c (i, u) + h • ξ) - D (i, u)|
          else 0)
      (nhdsWithin 0 (Set.Ioi 0)) (nhds 0)) ∧
  ((∀ (j : Fin n) (K δ : ℝ), 1 ≤ K → 0 < δ → δ < 1 / 2 →
      ∃ (g_seq : ℕ → ℝ × ℝ → ℝ) (C_var : ℝ),
        0 ≤ C_var ∧
        (∀ m, ContDiff ℝ 1 (g_seq m) ∧ ∀ rs, 0 ≤ g_seq m rs ∧ g_seq m rs ≤ d j) ∧
        Filter.Tendsto (fun m =>
          ∫ r in (-K)..K, ∫ s in δ..(1 - δ), |g_seq m (r, s) - a j (r - c j * s, s)|)
          Filter.atTop (nhds 0) ∧
        (∀ m, (∫ r in (-K)..K, ∫ s in δ..(1 - δ),
          |deriv (fun s' => g_seq m (r, s')) s|) ≤ C_var)) ∧
   (∀ (K δ : ℝ), 1 ≤ K → 0 < δ → δ < 1 / 2 →
      ∃ (G_seq : ℕ → ℝ × ℝ → ℝ) (C_var : ℝ),
        0 ≤ C_var ∧
        (∀ m, ContDiff ℝ 1 (G_seq m) ∧ ∀ iu, 0 ≤ G_seq m iu ∧ G_seq m iu ≤ d_v) ∧
        Filter.Tendsto (fun m =>
          ∫ u in δ..(1 - δ), ∫ i in (-K)..K, |G_seq m (i, u) - D (i, u)|)
          Filter.atTop (nhds 0) ∧
        (∀ m, (∫ u in δ..(1 - δ), ∫ i in (-K)..K,
          |deriv (fun i' => G_seq m (i', u)) i|) ≤ C_var))) ∧
  ((∀ᵐ u : ℝ, u ∈ Set.Ioo (0 : ℝ) 1 → ∀ i₁ i₂ : ℝ,
      f (planeEmbed n c (i₂, u)) - f (planeEmbed n c (i₁, u)) =
        ∫ i in i₁..i₂, ∑ j : Fin n, a j (i, u)) ∧
   (∀ p : ℝ, ∀ᵐ r : ℝ, ∀ u₁ ∈ Set.Ioo (0 : ℝ) 1, ∀ u₂ ∈ Set.Ioo (0 : ℝ) 1,
      f (planeEmbed n c (r - p * u₂, u₂)) - f (planeEmbed n c (r - p * u₁, u₁)) =
        ∫ u in u₁..u₂, ((∑ j : Fin n, (c j - p) * a j (r - p * u, u)) + D (r - p * u, u)))) ∧
  (∀ (φ : ℝ × ℝ → ℝ) (K δ : ℝ),
    ContDiff ℝ 1 φ → 1 ≤ K → 0 < δ → δ < 1 / 2 →
    (∀ iu, 0 ≤ φ iu) →
    (∀ iu, (K ≤ |iu.1| ∨ iu.2 ≤ δ ∨ 1 - δ ≤ iu.2) → φ iu = 0) →
    0 ≤ ∫ u in δ..(1 - δ), ∫ i in (-K)..K,
      (-a j_top (i, u) * (deriv (fun u' => φ (i, u')) u - c j_top * deriv (fun i' => φ (i', u)) i) +
        D (i, u) * deriv (fun i' => φ (i', u)) i))
def cyclicBinDist (M k₁ k₂ : ℤ) : ℤ :=
  min |k₁ - k₂| (M - |k₁ - k₂|)

noncomputable def angBin (ε e θ : ℝ) : ℤ :=
  let m := dyadicTimeLevel ε e
  min ⌊(θ / Real.pi) * (2 : ℝ) ^ m⌋ ((2 ^ m : ℤ) - 1)

noncomputable def angUnitVec (ε e : ℝ) (k_ang : ℤ) : EuclideanSpace ℝ (Fin 2) :=
  let m := dyadicTimeLevel ε e
  let φ := ((k_ang : ℝ) + 1 / 2) * Real.pi * ((2 : ℝ) ^ m)⁻¹
  WithLp.toLp 2 ![Real.cos φ, Real.sin φ]

noncomputable def stdApertureObs (ε u b a : ℝ)
    (V_p A_p : EuclideanSpace ℝ (Fin 2)) (c_s θ_s : ℝ) :
    ℤ × ℤ × ℤ × ℤ × ℤ × ℤ :=
  let k_t := dyadicTimeBin ε u c_s
  let c_m := dyadicTimeMid ε u c_s
  let k_r := angBin ε (a - b) θ_s
  let e_dir := angUnitVec ε (a - b) k_r
  let x_p := A_p + c_m • V_p
  (k_t, k_r,
    dyadicRealBin ε b (inner ℝ V_p e_dir),
    dyadicRealBin ε a (inner ℝ V_p (perp2D e_dir)),
    dyadicRealBin ε (b + u) (inner ℝ x_p e_dir),
    dyadicRealBin ε (a + u) (inner ℝ x_p (perp2D e_dir)))

noncomputable def stdApertureScore (ε γ u b a : ℝ) {N_ω N_T : ℕ}
    (π : Fin N_ω → ℝ) (T_idx : Fin N_ω → Fin N_T)
    (V_part A_part : Fin N_T → EuclideanSpace ℝ (Fin 2))
    (c_s θ_s : Fin N_ω → ℝ) : ℝ :=
  ((1 + γ) * b + (1 - γ) * a) -
    finMutualInfo ε π T_idx (fun ω =>
      stdApertureObs ε u b a (V_part (T_idx ω)) (A_part (T_idx ω)) (c_s ω) (θ_s ω)) +
    2 * finCondEntropy ε π T_idx (fun ω => dyadicTimeBin ε u (c_s ω))

def IsPosDyadicUnit (u : ℝ) : Prop :=
  ∃ (k j : ℕ), 1 ≤ j ∧ j ≤ 2 ^ k ∧ u = (j : ℝ) / (2 : ℝ) ^ k

def IsStdSaturatedAspect (γ e : ℝ) : Prop :=
  0 ≤ e ∧
  ∃ (ε_seq : ℕ → ℝ)
    (N_ω N_T : ℕ → ℕ)
    (π_seq : ∀ n, Fin (N_ω n) → ℝ)
    (T_seq : ∀ n, Fin (N_ω n) → Fin (N_T n))
    (V_seq A_seq : ∀ n, Fin (N_T n) → EuclideanSpace ℝ (Fin 2))
    (c_seq θ_seq : ∀ n, Fin (N_ω n) → ℝ),
    (∀ n, 0 < ε_seq n ∧ ε_seq n < 1 / 2) ∧
    Filter.Tendsto ε_seq Filter.atTop (nhds 0) ∧
    (∀ n, (∀ ω, 0 ≤ π_seq n ω) ∧ (∑ ω : Fin (N_ω n), π_seq n ω = 1) ∧
      (∀ tid, ‖V_seq n tid‖ ≤ 1 ∧ ‖A_seq n tid‖ ≤ 1) ∧
      (∀ ω, 0 < π_seq n ω →
        c_seq n ω ∈ Set.Icc (0 : ℝ) 1 ∧ θ_seq n ω ∈ Set.Ico (0 : ℝ) Real.pi)) ∧
    Filter.Tendsto (fun n =>
      stdApertureScore (ε_seq n) γ 1 0 e (π_seq n) (T_seq n) (V_seq n) (A_seq n)
        (c_seq n) (θ_seq n) -
      classicalRootSupremum (ε_seq n) (1 + e) γ (N_ω n) (N_T n) (π_seq n) (T_seq n)
        (V_seq n) (A_seq n))
      Filter.atTop (nhds (classicalGrowthRate γ))

noncomputable def leastClassicalAspect (γ : ℝ) : ℝ :=
  sInf { e : ℝ | IsStdSaturatedAspect γ e }

structure CoherentSaturatedPath (γ m : ℝ) : Type where
  K_coh : ℝ
  τ_path : ℝ
  b_path : ℝ → ℝ
  a_path : ℝ → ℝ
  S_path : ℝ → ℝ
  ε_seq : ℕ → ℝ
  N_ω : ℕ → ℕ
  N_T : ℕ → ℕ
  π_seq : ∀ n, Fin (N_ω n) → ℝ
  T_seq : ∀ n, Fin (N_ω n) → Fin (N_T n)
  V_seq : ∀ n, Fin (N_T n) → EuclideanSpace ℝ (Fin 2)
  A_seq : ∀ n, Fin (N_T n) → EuclideanSpace ℝ (Fin 2)
  c_seq : ∀ n, Fin (N_ω n) → ℝ
  θ_time : ℝ → ∀ n, Fin (N_ω n) → ℝ
  hK_coh : 0 < K_coh
  hτ_bounds : 0 ≤ τ_path ∧ τ_path ≤ 2 * (1 + m)
  hb_one : b_path 1 = 0
  ha_one : a_path 1 = m
  h_shape_mono : ∀ (r t : ℝ), 0 < r → r ≤ t → t ≤ 1 →
    0 ≤ b_path t ∧ b_path t ≤ b_path r ∧ b_path r ≤ a_path r ∧
    a_path r + r ≤ a_path t + t ∧ a_path t + t ≤ 1 + m
  h_aspect_lb : ∀ u ∈ Set.Ioc (0 : ℝ) 1, m * u ≤ a_path u - b_path u
  hS_zero : S_path 0 = 0
  hS_lip : ∀ u₁ u₂ : ℝ, u₁ ≤ u₂ →
    0 ≤ S_path u₂ - S_path u₁ ∧ S_path u₂ - S_path u₁ ≤ u₂ - u₁
  hε_bounds : ∀ n, 0 < ε_seq n ∧ ε_seq n < 1 / 2
  hε_tendsto : Filter.Tendsto ε_seq Filter.atTop (nhds 0)
  h_law : ∀ n, (∀ ω, 0 ≤ π_seq n ω) ∧ (∑ ω : Fin (N_ω n), π_seq n ω = 1) ∧
    (∀ tid, ‖V_seq n tid‖ ≤ 1 ∧ ‖A_seq n tid‖ ≤ 1) ∧
    (∀ ω, 0 < π_seq n ω → c_seq n ω ∈ Set.Icc (0 : ℝ) 1) ∧
    (∀ u, IsPosDyadicUnit u → ∀ ω, 0 < π_seq n ω →
      θ_time u n ω ∈ Set.Ico (0 : ℝ) Real.pi)
  h_root_lim : Filter.Tendsto (fun n =>
    classicalRootSupremum (ε_seq n) (1 + m) γ (N_ω n) (N_T n) (π_seq n) (T_seq n)
      (V_seq n) (A_seq n)) Filter.atTop (nhds τ_path)
  h_time_ent : ∀ u ∈ Set.Icc (0 : ℝ) 1,
    Filter.Tendsto (fun n =>
      finCondEntropy (ε_seq n) (π_seq n) (T_seq n)
        (fun ω => dyadicTimeBin (ε_seq n) u (c_seq n ω)))
      Filter.atTop (nhds (S_path u))
  h_time_homog : ∀ (r q : ℝ), 0 ≤ r → r ≤ q → q ≤ 1 → ∀ δ : ℝ, 0 < δ →
    Filter.Tendsto (fun n =>
      let ε := ε_seq n
      let X_r := fun ω => (T_seq n ω, dyadicTimeBin ε r (c_seq n ω))
      let Y_q := fun ω => dyadicTimeBin ε q (c_seq n ω)
      ∑ ω : Fin (N_ω n),
        if δ < |condSurprise ε (π_seq n) X_r Y_q ω - (S_path q - S_path r)|
        then π_seq n ω else 0)
      Filter.atTop (nhds 0)
  h_dyad_sat : ∀ u : ℝ, IsPosDyadicUnit u →
    Filter.Tendsto (fun n =>
      stdApertureScore (ε_seq n) γ u (b_path u) (a_path u) (π_seq n) (T_seq n)
        (V_seq n) (A_seq n) (c_seq n) (θ_time u n) -
      classicalRootSupremum (ε_seq n) (1 + m) γ (N_ω n) (N_T n) (π_seq n) (T_seq n)
        (V_seq n) (A_seq n))
      Filter.atTop (nhds (classicalGrowthRate γ * u))
  h_dyad_pred : ∀ u : ℝ, IsPosDyadicUnit u →
    Filter.Tendsto (fun n =>
      finCondEntropy (ε_seq n) (π_seq n)
        (fun ω => (T_seq n ω, dyadicTimeBin (ε_seq n) u (c_seq n ω)))
        (fun ω => angBin (ε_seq n) (a_path u - b_path u) (θ_time u n ω)))
      Filter.atTop (nhds 0)
  h_dyad_coh : ∀ (r t d : ℝ), IsPosDyadicUnit r → IsPosDyadicUnit t → r < t →
    0 < d →
    d < min (a_path r - b_path r) (a_path t - b_path t) -
      K_coh * (|b_path r - b_path t| + |a_path r - a_path t| + (t - r)) →
    Filter.Tendsto (fun n =>
      let ε := ε_seq n
      let M_bin : ℤ := (2 : ℤ) ^ (dyadicTimeLevel ε d)
      ∑ ω : Fin (N_ω n),
        if 1 < cyclicBinDist M_bin (angBin ε d (θ_time r n ω)) (angBin ε d (θ_time t n ω))
        then π_seq n ω else 0)
      Filter.atTop (nhds 0)
noncomputable def cutLinearCoeff (lam_sys ρ_r C_r : ℝ)
    (X_J : EuclideanSpace ℝ (Fin 2))
    (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
    (f : EuclideanSpace ℝ (Fin 2) → ℂ)
    (j n : ℤ × ℤ) : ℂ :=
  let V_j := gridPt2D ρ_r j
  ((4 : ℂ)⁻¹ * (ρ_r⁻¹ : ℂ)) * ∫ v : EuclideanSpace ℝ (Fin 2),
    f v * (pktPou2D (ρ_r⁻¹ • (v - V_j)) : ℂ) *
      Complex.exp (Complex.I *
        ((lam_sys * Φ₀ (C_r, X_J, v) -
          (Real.pi / 2) * inner ℝ (gridPt2D 1 n) (ρ_r⁻¹ • (v - V_j)) : ℝ) : ℂ))

noncomputable def cutLinearAtom (lam_sys ρ_r C_r : ℝ)
    (X_J : EuclideanSpace ℝ (Fin 2))
    (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
    (j n : ℤ × ℤ) (v : EuclideanSpace ℝ (Fin 2)) : ℂ :=
  let V_j := gridPt2D ρ_r j
  ((4 : ℂ)⁻¹ * (ρ_r⁻¹ : ℂ)) * (pktPou2D (ρ_r⁻¹ • (v - V_j)) : ℂ) *
    Complex.exp (Complex.I *
      ((-lam_sys * Φ₀ (C_r, X_J, v) +
        (Real.pi / 2) * inner ℝ (gridPt2D 1 n) (ρ_r⁻¹ • (v - V_j)) : ℝ) : ℂ))

noncomputable def cutPacketWindow (lam_sys ρ_r C_r : ℝ)
    (X_J X_at : EuclideanSpace ℝ (Fin 2))
    (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
    (j n : ℤ × ℤ) (z : EuclideanSpace ℝ (Fin 2)) : ℂ :=
  let V_j := gridPt2D ρ_r j
  ((4 : ℂ)⁻¹) * (pktPou2D z : ℂ) *
    Complex.exp (Complex.I *
      ((lam_sys * (Φ₀ (C_r, X_J, V_j + ρ_r • z) - Φ₀ (C_r, X_at, V_j + ρ_r • z)) -
        (Real.pi / 2) * inner ℝ (gridPt2D 1 n) z : ℝ) : ℂ))
def dyadicSquare (ρ : ℝ) (k : ℤ × ℤ) : Set (EuclideanSpace ℝ (Fin 2)) :=
  { x | (k.1 : ℝ) * ρ ≤ x 0 ∧ x 0 < ((k.1 : ℝ) + 1) * ρ ∧
        (k.2 : ℝ) * ρ ≤ x 1 ∧ x 1 < ((k.2 : ℝ) + 1) * ρ }

def IsDyadicSquare (ρ : ℝ) (p : Set (EuclideanSpace ℝ (Fin 2))) : Prop :=
  (∃ k : ℤ × ℤ, p = dyadicSquare ρ k) ∧
  p ⊆ { x | x 0 ∈ Set.Ico 0 1 ∧ x 1 ∈ Set.Ico 0 1 }

def IsTubeParamSquare (ρ : ℝ) (q : Set (EuclideanSpace ℝ (Fin 2))) : Prop :=
  (∃ k : ℤ × ℤ, q = dyadicSquare ρ k) ∧
  q ⊆ { u | u 0 ∈ Set.Icc (-1) 1 }

def dyadicTube (q : Set (EuclideanSpace ℝ (Fin 2))) : Set (EuclideanSpace ℝ (Fin 2)) :=
  { x | ∃ u ∈ q, x 1 = u 0 * x 0 + u 1 }

open Classical in
def IsRhoSet (ρ d C : ℝ) (P : Finset (Set (EuclideanSpace ℝ (Fin 2)))) : Prop :=
  P.Nonempty ∧
  ∀ z : EuclideanSpace ℝ (Fin 2), ∀ r : ℝ, ρ ≤ r → r ≤ 1 →
    ((P.filter (fun p => (p ∩ Metric.ball z r).Nonempty)).card : ℝ) ≤
      C * r ^ d * (P.card : ℝ)

open Classical in
axiom ren_wang (s d α : ℝ) (hs₀ : 0 < s) (hs₁ : s ≤ 1)
    (hd₀ : 0 < d) (hd₂ : d ≤ 2) (hα : 0 < α) :
    ∃ (η₀ ρ₀ c : ℝ),
      0 < η₀ ∧ 0 < ρ₀ ∧ 0 < c ∧
      ∀ (ρ M : ℝ) (P : Finset (Set (EuclideanSpace ℝ (Fin 2))))
        (T : Set (EuclideanSpace ℝ (Fin 2)) → Finset (Set (EuclideanSpace ℝ (Fin 2)))),
        0 < ρ → ρ < ρ₀ → 0 < M →
        (∀ p ∈ P, IsDyadicSquare ρ p) →
        IsRhoSet ρ d (ρ ^ (-η₀)) P →
        (∀ p ∈ P, ∀ q ∈ T p, IsTubeParamSquare ρ q ∧ (dyadicTube q ∩ p).Nonempty) →
        (∀ p ∈ P, M / 2 ≤ ((T p).card : ℝ) ∧ ((T p).card : ℝ) ≤ 2 * M) →
        (∀ p ∈ P, IsRhoSet ρ s (ρ ^ (-η₀)) (T p)) →
        c * ρ ^ (-min 1 (min d ((d + s) / 2)) + α) * M ≤
          ((P.biUnion T).card : ℝ)

def WeightedTaggedProjectionBound : Prop :=
  letI := Classical.propDecidable
  ∀ (d s α B_dom C_cov : ℝ),
    0 < d → d ≤ 2 → 0 < s → s ≤ 1 → 0 < α → 1 ≤ B_dom → 1 ≤ C_cov →
    ∃ (η ρ₁ : ℝ), 0 < η ∧ 0 < ρ₁ ∧ ρ₁ < 1 / 2 ∧
      ∀ (ρ M : ℝ) (N_P N_B : ℕ)
        (μ : Fin N_P → ℝ) (x_P : Fin N_P → EuclideanSpace ℝ (Fin 2))
        (ν : Fin N_B → ℝ) (a_B : Fin N_B → ℝ)
        (G : Fin N_P → Fin N_B → Prop),
        0 < ρ → ρ < ρ₁ → 0 < M →
        (∀ i, 0 ≤ μ i) → (∑ i, μ i = 1) →
        (∀ i, ‖x_P i‖ ≤ B_dom) →
        (∀ (z : EuclideanSpace ℝ (Fin 2)) (r : ℝ), ρ ≤ r → r ≤ 1 →
          (∑ i : Fin N_P, if ‖x_P i - z‖ < r then μ i else 0) ≤ ρ ^ (-η) * r ^ d) →
        (∀ j, 0 ≤ ν j) → (∑ j, ν j = 1) →
        (∀ j, |a_B j| ≤ B_dom) →
        (∀ (a₀ r : ℝ), ρ ≤ r → r ≤ 1 →
          (∑ j : Fin N_B, if |a_B j - a₀| < r then ν j else 0) ≤ ρ ^ (-η) * r ^ s) →
        ρ ^ η ≤ (∑ i : Fin N_P, ∑ j : Fin N_B, if G i j then μ i * ν j else 0) →
        (∀ j : Fin N_B, ∃ S_cov : Finset ℝ, (S_cov.card : ℝ) ≤ M ∧
          ∀ i : Fin N_P, G i j →
            ∃ c₀ ∈ S_cov, |(x_P i 1 - a_B j * x_P i 0) - c₀| ≤ C_cov * ρ) →
        ρ ^ (-min 1 (min d ((d + s) / 2)) + α) ≤ M

def UnitVectorTaggedProjectionBound : Prop :=
  letI := Classical.propDecidable
  ∀ (d s α B_dom C_cov : ℝ),
    0 < d → d ≤ 2 → 0 < s → s ≤ 1 → 0 < α → 1 ≤ B_dom → 1 ≤ C_cov →
    ∃ (η ρ₁ : ℝ), 0 < η ∧ 0 < ρ₁ ∧ ρ₁ < 1 / 2 ∧
      ∀ (ρ M : ℝ) (N_P N_B : ℕ)
        (μ : Fin N_P → ℝ) (x_P : Fin N_P → EuclideanSpace ℝ (Fin 2))
        (ν : Fin N_B → ℝ) (e_B : Fin N_B → EuclideanSpace ℝ (Fin 2))
        (G : Fin N_P → Fin N_B → Prop),
        0 < ρ → ρ < ρ₁ → 0 < M →
        (∀ i, 0 ≤ μ i) → (∑ i, μ i = 1) →
        (∀ i, ‖x_P i‖ ≤ B_dom) →
        (∀ (z : EuclideanSpace ℝ (Fin 2)) (r : ℝ), ρ ≤ r → r ≤ 1 →
          (∑ i : Fin N_P, if ‖x_P i - z‖ < r then μ i else 0) ≤ ρ ^ (-η) * r ^ d) →
        (∀ j, 0 ≤ ν j) → (∑ j, ν j = 1) →
        (∀ j, ‖e_B j‖ = 1) →
        (∀ (e₀ : EuclideanSpace ℝ (Fin 2)) (r : ℝ), ‖e₀‖ = 1 → ρ ≤ r → r ≤ 1 →
          (∑ j : Fin N_B, if ‖e_B j - e₀‖ < r then ν j else 0) ≤ ρ ^ (-η) * r ^ s) →
        ρ ^ η ≤ (∑ i : Fin N_P, ∑ j : Fin N_B, if G i j then μ i * ν j else 0) →
        (∀ j : Fin N_B, ∃ S_cov : Finset ℝ, (S_cov.card : ℝ) ≤ M ∧
          ∀ i : Fin N_P, G i j →
            ∃ c₀ ∈ S_cov, |inner ℝ (x_P i) (e_B j) - c₀| ≤ C_cov * ρ) →
        ρ ^ (-min 1 (min d ((d + s) / 2)) + α) ≤ M

noncomputable def canonicalShear4 (P : Fin 4 → ℝ) (θ : ℝ × ℝ) : Fin 4 → ℝ :=
  ![P 0, P 1 + θ.1 * P 0, P 2 + θ.2 * P 0,
    P 3 + θ.1 * P 2 + θ.2 * P 1 + θ.1 * θ.2 * P 0]

noncomputable def canonicalGridBin (ρ x : ℝ) : ℤ :=
  ⌊x / ρ⌋

noncomputable def canonicalGridMid (ρ x : ℝ) : ℝ :=
  ((canonicalGridBin ρ x : ℝ) + 1 / 2) * ρ

noncomputable def canonicalMidU (ρ : ℝ) (P : Fin 4 → ℝ) (θ : ℝ × ℝ) :
    EuclideanSpace ℝ (Fin 2) :=
  WithLp.toLp 2 ![canonicalGridMid ρ (canonicalShear4 P θ 1),
                  canonicalGridMid ρ (canonicalShear4 P θ 2)]

noncomputable def paramTreeBin (ρ d : ℝ) (θ : ℝ × ℝ) : ℤ × ℤ :=
  (dyadicRealBin ρ d θ.1, dyadicRealBin ρ d θ.2)

noncomputable def paramTreeMid (ρ d : ℝ) (θ : ℝ × ℝ) : EuclideanSpace ℝ (Fin 2) :=
  WithLp.toLp 2 ![dyadicRealMid ρ d θ.1, dyadicRealMid ρ d θ.2]

structure CanonicalAffineBlockDistinct (s σ : ℝ) (a_pt : Fin 4 → ℝ) : Type where
  ρ_seq : ℕ → ℝ
  κ_seq : ℕ → ℝ
  N_P : ℕ → ℕ
  N_Θ : ℕ → ℕ
  π_seq : ∀ l, Fin (N_P l) → Fin (N_Θ l) → ℝ
  P_seq : ∀ l, Fin (N_P l) → Fin 4 → ℝ
  θ_seq : ∀ l, Fin (N_Θ l) → ℝ × ℝ
  hρ_bounds : ∀ l, 0 < ρ_seq l ∧ ρ_seq l < 1 / 2
  hρ_tendsto : Filter.Tendsto ρ_seq Filter.atTop (nhds 0)
  hκ_pos : ∀ l, 0 < κ_seq l
  hκ_tendsto : Filter.Tendsto κ_seq Filter.atTop (nhds 0)
  hπ_nn : ∀ l i b, 0 ≤ π_seq l i b
  hπ_sum : ∀ l, (∑ i : Fin (N_P l), ∑ b : Fin (N_Θ l), π_seq l i b) = 1
  hP_dom : ∀ l i j, |P_seq l i j| ≤ 4
  hθ_dom : ∀ l b, |(θ_seq l b).1| ≤ 4 ∧ |(θ_seq l b).2| ≤ 4
  h_pair_dom : ∀ l i b,
    π_seq l i b ≤ (ρ_seq l) ^ (-κ_seq l) *
      (∑ b', π_seq l i b') * (∑ i', π_seq l i' b)
  h_coord_prod : ∀ l b,
    let lam_b := ∑ i, π_seq l i b
    0 < lam_b →
    ∀ k : Fin 4 → ℤ,
      letI := Classical.propDecidable
      (∑ i : Fin (N_P l),
        if (∀ j : Fin 4,
          canonicalGridBin (ρ_seq l) (canonicalShear4 (P_seq l i) (θ_seq l b) j) = k j)
        then π_seq l i b / lam_b else 0) ≤
      (ρ_seq l) ^ (-κ_seq l) * ∏ j : Fin 4,
        (∑ i : Fin (N_P l),
          if canonicalGridBin (ρ_seq l) (canonicalShear4 (P_seq l i) (θ_seq l b) j) = k j
          then π_seq l i b / lam_b else 0)
  h_time_ball : ∀ l (z₀ r : ℝ), ρ_seq l ≤ r → r ≤ 1 →
    letI := Classical.propDecidable
    (∑ b : Fin (N_Θ l),
      if |(θ_seq l b).1 - z₀| < r then (∑ i, π_seq l i b) else 0) ≤
      (ρ_seq l) ^ (-κ_seq l) * r ^ s
  h_norm_ball : ∀ l (z₀ r : ℝ), ρ_seq l ≤ r → r ≤ 1 →
    letI := Classical.propDecidable
    (∑ b : Fin (N_Θ l),
      if |(θ_seq l b).2 - z₀| < r then (∑ i, π_seq l i b) else 0) ≤
      (ρ_seq l) ^ (-κ_seq l) * r ^ σ
  h_coord_ball : ∀ l b (j : Fin 4) (z₀ r : ℝ),
    let lam_b := ∑ i, π_seq l i b
    0 < lam_b → ρ_seq l ≤ r → r ≤ 1 →
    letI := Classical.propDecidable
    (∑ i : Fin (N_P l),
      if |canonicalGridMid (ρ_seq l) (canonicalShear4 (P_seq l i) (θ_seq l b) j) - z₀| < r
      then π_seq l i b / lam_b else 0) ≤
      (ρ_seq l) ^ (-κ_seq l) * r ^ (a_pt j)
  h_coord_cov : ∀ l b (j : Fin 4) (r : ℝ),
    0 < (∑ i, π_seq l i b) → ρ_seq l ≤ r → r ≤ 1 →
    ∃ S_cov : Finset ℝ,
      (S_cov.card : ℝ) ≤ (ρ_seq l) ^ (-κ_seq l) * r ^ (-a_pt j) ∧
      ∀ i : Fin (N_P l), 0 < π_seq l i b →
        ∃ c₀ ∈ S_cov,
          |canonicalGridMid (ρ_seq l) (canonicalShear4 (P_seq l i) (θ_seq l b) j) - c₀| ≤ r

structure CanonicalAffineBlockTied (s σ : ℝ) (a_pt : Fin 3 → ℝ) : Type where
  ρ_seq : ℕ → ℝ
  κ_seq : ℕ → ℝ
  g_Y : ℝ → ℝ
  N_P : ℕ → ℕ
  N_Θ : ℕ → ℕ
  π_seq : ∀ l, Fin (N_P l) → Fin (N_Θ l) → ℝ
  P_seq : ∀ l, Fin (N_P l) → Fin 4 → ℝ
  θ_seq : ∀ l, Fin (N_Θ l) → ℝ × ℝ
  hρ_bounds : ∀ l, 0 < ρ_seq l ∧ ρ_seq l < 1 / 2
  hρ_tendsto : Filter.Tendsto ρ_seq Filter.atTop (nhds 0)
  hκ_pos : ∀ l, 0 < κ_seq l
  hκ_tendsto : Filter.Tendsto κ_seq Filter.atTop (nhds 0)
  hgY_zero : g_Y 0 = 0
  hgY_lip : ∀ d₁ d₂ : ℝ, d₁ ≤ d₂ → 0 ≤ g_Y d₂ - g_Y d₁ ∧ g_Y d₂ - g_Y d₁ ≤ d₂ - d₁
  hgY_le_q : g_Y 1 ≤ a_pt 1
  hπ_nn : ∀ l i b, 0 ≤ π_seq l i b
  hπ_sum : ∀ l, (∑ i : Fin (N_P l), ∑ b : Fin (N_Θ l), π_seq l i b) = 1
  hP_dom : ∀ l i j, |P_seq l i j| ≤ 4
  hθ_dom : ∀ l b, |(θ_seq l b).1| ≤ 4 ∧ |(θ_seq l b).2| ≤ 4
  h_pair_dom : ∀ l i b,
    π_seq l i b ≤ (ρ_seq l) ^ (-κ_seq l) *
      (∑ b', π_seq l i b') * (∑ i', π_seq l i' b)
  h_coord_prod : ∀ l b,
    let lam_b := ∑ i, π_seq l i b
    0 < lam_b →
    ∀ (k_X : ℤ) (k_U : ℤ × ℤ) (k_Z : ℤ),
      letI := Classical.propDecidable
      let bX := fun i => canonicalGridBin (ρ_seq l) (canonicalShear4 (P_seq l i) (θ_seq l b) 0)
      let bU := fun i => (canonicalGridBin (ρ_seq l) (canonicalShear4 (P_seq l i) (θ_seq l b) 1),
                          canonicalGridBin (ρ_seq l) (canonicalShear4 (P_seq l i) (θ_seq l b) 2))
      let bZ := fun i => canonicalGridBin (ρ_seq l) (canonicalShear4 (P_seq l i) (θ_seq l b) 3)
      (∑ i : Fin (N_P l),
        if bX i = k_X ∧ bU i = k_U ∧ bZ i = k_Z then π_seq l i b / lam_b else 0) ≤
      (ρ_seq l) ^ (-κ_seq l) *
        (∑ i, if bX i = k_X then π_seq l i b / lam_b else 0) *
        (∑ i, if bU i = k_U then π_seq l i b / lam_b else 0) *
        (∑ i, if bZ i = k_Z then π_seq l i b / lam_b else 0)
  h_time_ball : ∀ l (z₀ r : ℝ), ρ_seq l ≤ r → r ≤ 1 →
    letI := Classical.propDecidable
    (∑ b : Fin (N_Θ l),
      if |(θ_seq l b).1 - z₀| < r then (∑ i, π_seq l i b) else 0) ≤
      (ρ_seq l) ^ (-κ_seq l) * r ^ s
  h_norm_ball : ∀ l (z₀ r : ℝ), ρ_seq l ≤ r → r ≤ 1 →
    letI := Classical.propDecidable
    (∑ b : Fin (N_Θ l),
      if |(θ_seq l b).2 - z₀| < r then (∑ i, π_seq l i b) else 0) ≤
      (ρ_seq l) ^ (-κ_seq l) * r ^ σ
  h_param_ball : ∀ l (z₀ : EuclideanSpace ℝ (Fin 2)) (r : ℝ), ρ_seq l ≤ r → r ≤ 1 →
    letI := Classical.propDecidable
    (∑ b : Fin (N_Θ l),
      if ‖WithLp.toLp 2 ![(θ_seq l b).1, (θ_seq l b).2] - z₀‖ < r
      then (∑ i, π_seq l i b) else 0) ≤
      (ρ_seq l) ^ (-κ_seq l) * r ^ s
  h_param_child : ∀ (j a δ_err : ℝ),
    0 < j → 0 < a → j + a < 1 → 0 < δ_err →
    ∃ L₀ : ℕ, ∀ l : ℕ, L₀ ≤ l →
      ∀ b₀ : Fin (N_Θ l),
        let p_par := paramTreeBin (ρ_seq l) j (θ_seq l b₀)
        let a_mid := paramTreeMid (ρ_seq l) j (θ_seq l b₀)
        letI := Classical.propDecidable
        let m_par := ∑ b : Fin (N_Θ l),
          if paramTreeBin (ρ_seq l) j (θ_seq l b) = p_par then (∑ i, π_seq l i b) else 0
        0 < m_par →
        ∀ (z₀ : EuclideanSpace ℝ (Fin 2)) (r : ℝ), (ρ_seq l) ^ a ≤ r → r ≤ 1 →
          (∑ b : Fin (N_Θ l),
            if paramTreeBin (ρ_seq l) j (θ_seq l b) = p_par ∧
              ‖(ρ_seq l) ^ (-j) • (WithLp.toLp 2 ![(θ_seq l b).1, (θ_seq l b).2] - a_mid) - z₀‖ < r
            then (∑ i, π_seq l i b) / m_par else 0) ≤
            (ρ_seq l) ^ (-δ_err) * r ^ s
  h_X_ball : ∀ l b (z₀ r : ℝ),
    let lam_b := ∑ i, π_seq l i b
    0 < lam_b → ρ_seq l ≤ r → r ≤ 1 →
    letI := Classical.propDecidable
    (∑ i : Fin (N_P l),
      if |canonicalGridMid (ρ_seq l) (canonicalShear4 (P_seq l i) (θ_seq l b) 0) - z₀| < r
      then π_seq l i b / lam_b else 0) ≤
      (ρ_seq l) ^ (-κ_seq l) * r ^ (a_pt 0)
  h_U_ball : ∀ l b (z₀ : EuclideanSpace ℝ (Fin 2)) (r : ℝ),
    let lam_b := ∑ i, π_seq l i b
    0 < lam_b → ρ_seq l ≤ r → r ≤ 1 →
    letI := Classical.propDecidable
    (∑ i : Fin (N_P l),
      if ‖canonicalMidU (ρ_seq l) (P_seq l i) (θ_seq l b) - z₀‖ < r
      then π_seq l i b / lam_b else 0) ≤
      (ρ_seq l) ^ (-κ_seq l) * r ^ (a_pt 1)
  h_Z_ball : ∀ l b (z₀ r : ℝ),
    let lam_b := ∑ i, π_seq l i b
    0 < lam_b → ρ_seq l ≤ r → r ≤ 1 →
    letI := Classical.propDecidable
    (∑ i : Fin (N_P l),
      if |canonicalGridMid (ρ_seq l) (canonicalShear4 (P_seq l i) (θ_seq l b) 3) - z₀| < r
      then π_seq l i b / lam_b else 0) ≤
      (ρ_seq l) ^ (-κ_seq l) * r ^ (a_pt 2)
  h_Z_cov : ∀ l b (r : ℝ),
    0 < (∑ i, π_seq l i b) → ρ_seq l ≤ r → r ≤ 1 →
    ∃ S_cov : Finset ℝ,
      (S_cov.card : ℝ) ≤ (ρ_seq l) ^ (-κ_seq l) * r ^ (-a_pt 2) ∧
      ∀ i : Fin (N_P l), 0 < π_seq l i b →
        ∃ c₀ ∈ S_cov,
          |canonicalGridMid (ρ_seq l) (canonicalShear4 (P_seq l i) (θ_seq l b) 3) - c₀| ≤ r
  h_Y_ball : ∀ l b (z₀ r : ℝ),
    let lam_b := ∑ i, π_seq l i b
    0 < lam_b → ρ_seq l ≤ r → r ≤ 1 →
    letI := Classical.propDecidable
    let d_r := Real.log (r⁻¹) / Real.log ((ρ_seq l)⁻¹)
    (∑ i : Fin (N_P l),
      if |canonicalGridMid (ρ_seq l) (canonicalShear4 (P_seq l i) (θ_seq l b) 1) - z₀| < r
      then π_seq l i b / lam_b else 0) ≤
      (ρ_seq l) ^ (g_Y d_r - κ_seq l)
  h_Y_cov : ∀ (d δ_err : ℝ), 0 < d → d ≤ 1 → 0 < δ_err →
    ∃ L₀ : ℕ, ∀ l : ℕ, L₀ ≤ l →
      ∀ b : Fin (N_Θ l), 0 < (∑ i, π_seq l i b) →
        ∃ S_cov : Finset ℝ,
          (S_cov.card : ℝ) ≤ (ρ_seq l) ^ (-g_Y d - δ_err) ∧
          ∀ i : Fin (N_P l), 0 < π_seq l i b →
            ∃ c₀ ∈ S_cov,
              |canonicalGridMid (ρ_seq l) (canonicalShear4 (P_seq l i) (θ_seq l b) 1) - c₀| ≤
                (ρ_seq l) ^ d

def NoStripConcentration {s σ : ℝ} {a_pt : Fin 3 → ℝ}
    (blk : CanonicalAffineBlockTied s σ a_pt) : Prop :=
  letI := Classical.propDecidable
  ∀ t : ℝ, 0 < t → t ≤ 1 →
    ∃ (κ_t : ℝ) (L₀ : ℕ), 0 < κ_t ∧ ∀ l : ℕ, L₀ ≤ l →
      ∀ (e : EuclideanSpace ℝ (Fin 2)) (c₀ : ℝ), ‖e‖ = 1 →
        (∑ b : Fin (blk.N_Θ l),
          if |(blk.θ_seq l b).1 * e 0 + (blk.θ_seq l b).2 * e 1 - c₀| ≤ (blk.ρ_seq l) ^ t
          then (∑ i, blk.π_seq l i b) else 0) ≤ (blk.ρ_seq l) ^ κ_t
def IsUnitBallStdLaw {N_ω N_T : ℕ} (π : Fin N_ω → ℝ)
    (V_part A_part : Fin N_T → EuclideanSpace ℝ (Fin 2))
    (c_s θ_s : Fin N_ω → ℝ) : Prop :=
  (∀ ω, 0 ≤ π ω) ∧ (∑ ω : Fin N_ω, π ω = 1) ∧
  (∀ tid, ‖V_part tid‖ ≤ 1 ∧ ‖A_part tid‖ ≤ 1) ∧
  (∀ ω, 0 < π ω → c_s ω ∈ Set.Icc (0 : ℝ) 1 ∧ θ_s ω ∈ Set.Ico (0 : ℝ) Real.pi)
noncomputable def rowObsScore (ε γ m u b_val : ℝ) {N_ω N_T : ℕ}
    (π : Fin N_ω → ℝ) (T_idx : Fin N_ω → Fin N_T)
    (V_part A_part : Fin N_T → EuclideanSpace ℝ (Fin 2))
    (c_s R_s : Fin N_ω → ℝ) : ℝ :=
  (2 * b_val + (1 - γ) * m * u) -
    finMutualInfo ε π T_idx (fun ω =>
      rowObs6 ε m (V_part (T_idx ω)) (A_part (T_idx ω)) (c_s ω) (R_s ω)
        (b_val, b_val + u, b_val + m * u, b_val + (1 + m) * u, u)) +
    2 * finCondEntropy ε π T_idx (fun ω => dyadicTimeBin ε u (c_s ω))

structure RowFrameDyadicPath (γ m : ℝ) (b : ℝ → ℝ) : Type where
  ε_seq : ℕ → ℝ
  N_ω : ℕ → ℕ
  N_T : ℕ → ℕ
  π_seq : ∀ n, Fin (N_ω n) → ℝ
  T_seq : ∀ n, Fin (N_ω n) → Fin (N_T n)
  V_seq : ∀ n, Fin (N_T n) → EuclideanSpace ℝ (Fin 2)
  A_seq : ∀ n, Fin (N_T n) → EuclideanSpace ℝ (Fin 2)
  c_seq : ∀ n, Fin (N_ω n) → ℝ
  R_seq : ∀ n, Fin (N_ω n) → ℝ
  hε_bounds : ∀ n, 0 < ε_seq n ∧ ε_seq n < 1 / 2
  hε_tendsto : Filter.Tendsto ε_seq Filter.atTop (nhds 0)
  h_law : ∀ n, (∀ ω, 0 ≤ π_seq n ω) ∧ (∑ ω : Fin (N_ω n), π_seq n ω = 1) ∧
    (∀ tid, ‖V_seq n tid‖ ≤ 1 ∧ ‖A_seq n tid‖ ≤ 1) ∧
    (∀ ω, 0 < π_seq n ω → c_seq n ω ∈ Set.Icc (0 : ℝ) 1 ∧ |R_seq n ω| ≤ 1)
  h_dyad_sat : ∀ u ∈ Set.Ioo (0 : ℝ) 1, IsPosDyadicUnit u →
    Filter.Tendsto (fun n =>
      rowObsScore (ε_seq n) γ m u (b u) (π_seq n) (T_seq n) (V_seq n) (A_seq n)
        (c_seq n) (R_seq n) -
      classicalRootSupremum (ε_seq n) (1 + m) γ (N_ω n) (N_T n) (π_seq n) (T_seq n)
        (V_seq n) (A_seq n))
      Filter.atTop (nhds (classicalGrowthRate γ * u))
  h_dyad_pred : ∀ u ∈ Set.Ioo (0 : ℝ) 1, IsPosDyadicUnit u →
    Filter.Tendsto (fun n =>
      finCondEntropy (ε_seq n) (π_seq n)
        (fun ω => (T_seq n ω, dyadicTimeBin (ε_seq n) u (c_seq n ω)))
        (fun ω => dyadicRealBin (ε_seq n) (m * u) (R_seq n ω)))
      Filter.atTop (nhds 0)
def IsUnitBallTimeLaw {N_ω N_T : ℕ} (π : Fin N_ω → ℝ)
    (V_part A_part : Fin N_T → EuclideanSpace ℝ (Fin 2)) (c_s : Fin N_ω → ℝ) : Prop :=
  (∀ ω, 0 ≤ π ω) ∧
  (∑ ω : Fin N_ω, π ω = 1) ∧
  (∀ tid, ‖V_part tid‖ ≤ 1 ∧ ‖A_part tid‖ ≤ 1) ∧
  (∀ ω, 0 < π ω → c_s ω ∈ Set.Icc (0 : ℝ) 1)

noncomputable def stdApertureDeficit (ε γ L u b a : ℝ) {N_ω N_T : ℕ}
    (π : Fin N_ω → ℝ) (T_idx : Fin N_ω → Fin N_T)
    (V_part A_part : Fin N_T → EuclideanSpace ℝ (Fin 2))
    (c_s θ_s : Fin N_ω → ℝ) : ℝ :=
  classicalRootSupremum ε L γ N_ω N_T π T_idx V_part A_part +
    classicalGrowthRate γ * u -
    stdApertureScore ε γ u b a π T_idx V_part A_part c_s θ_s
noncomputable def coneBasisL (n : ℕ) (j : Fin n) : (Fin n → ℝ) × ℝ :=
  (Function.update 0 j 1, 0)

noncomputable def coneBasisV (n : ℕ) : (Fin n → ℝ) × ℝ :=
  (0, 1)

def HasSmoothSubmodularSigns (n : ℕ) (d : Fin n → ℝ) (d_v : ℝ)
    (F : ((Fin n → ℝ) × ℝ) → ℝ) (p : (Fin n → ℝ) × ℝ) : Prop :=
  (∀ j : Fin n,
    0 ≤ fderiv ℝ F p (coneBasisL n j) ∧ fderiv ℝ F p (coneBasisL n j) ≤ d j) ∧
  (0 ≤ fderiv ℝ F p (coneBasisV n) ∧ fderiv ℝ F p (coneBasisV n) ≤ d_v) ∧
  (∀ j k : Fin n, j ≠ k →
    fderiv ℝ (fderiv ℝ F) p (coneBasisL n j) (coneBasisL n k) ≤ 0) ∧
  (∀ j : Fin n,
    fderiv ℝ (fderiv ℝ F) p (coneBasisL n j) (coneBasisV n) ≤ 0)

noncomputable def coneProjZeroL (n : ℕ) (j : Fin n) (ξ : (Fin n → ℝ) × ℝ) : (Fin n → ℝ) × ℝ :=
  (fun k => ξ.1 k - ξ.1 j, ξ.2)

noncomputable def coneProjZeroV (n : ℕ) (c : Fin n → ℝ) (ξ : (Fin n → ℝ) × ℝ) : (Fin n → ℝ) × ℝ :=
  (fun k => ξ.1 k - c k * ξ.2, 0)
noncomputable def restrictLaw {N_ω : ℕ} (π : Fin N_ω → ℝ) (S : Finset (Fin N_ω)) :
    Fin N_ω → ℝ :=
  let m := ∑ ω ∈ S, π ω
  fun ω => if ω ∈ S then π ω / m else 0

noncomputable def projAngleOfVec (w : EuclideanSpace ℝ (Fin 2)) : ℝ :=
  letI := Classical.propDecidable
  if 0 < w 1 then Real.arccos (w 0 / ‖w‖)
  else if w 1 < 0 then Real.arccos (-(w 0 / ‖w‖))
  else 0

noncomputable def clampUnitBall2D (w : EuclideanSpace ℝ (Fin 2)) :
    EuclideanSpace ℝ (Fin 2) :=
  letI := Classical.propDecidable
  if ‖w‖ ≤ 1 then w else 0

noncomputable def locTime (ε r c_s : ℝ) : ℝ :=
  let m_r := dyadicTimeLevel ε r
  c_s * (2 : ℝ) ^ m_r - (dyadicTimeBin ε r c_s : ℝ)

noncomputable def locTheta (ε e_t d θ_s : ℝ) : ℝ :=
  let e_fine := angUnitVec ε e_t (angBin ε e_t θ_s)
  let e_coarse := angUnitVec ε d (angBin ε d θ_s)
  projAngleOfVec (WithLp.toLp 2 ![inner ℝ e_fine e_coarse,
    ε ^ (-d) * inner ℝ e_fine (perp2D e_coarse)])

noncomputable def locCellVel (ε r b_t d : ℝ) (j : ℤ × ℤ × ℤ × ℤ × ℤ × ℤ)
    (V_p : EuclideanSpace ℝ (Fin 2)) : EuclideanSpace ℝ (Fin 2) :=
  let (_, k_ang_d, k_V1, k_V2, _, _) := j
  let _ := r
  let e_J := angUnitVec ε d k_ang_d
  let v_J1 := ((k_V1 : ℝ) + 1 / 2) * dyadicRealStep ε b_t
  let v_J2 := ((k_V2 : ℝ) + 1 / 2) * dyadicRealStep ε (b_t + d)
  let v_J := v_J1 • e_J + v_J2 • perp2D e_J
  let dV := V_p - v_J
  clampUnitBall2D ((1 / 10 : ℝ) • WithLp.toLp 2
    ![ε ^ (-b_t) * inner ℝ dV e_J, ε ^ (-(b_t + d)) * inner ℝ dV (perp2D e_J)])

noncomputable def locCellPos (ε r b_t d : ℝ) (j : ℤ × ℤ × ℤ × ℤ × ℤ × ℤ)
    (V_p A_p : EuclideanSpace ℝ (Fin 2)) : EuclideanSpace ℝ (Fin 2) :=
  let (k_r, k_ang_d, k_V1, k_V2, k_X1, k_X2) := j
  let Δ_r := ((2 : ℝ) ^ (dyadicTimeLevel ε r))⁻¹
  let c_low := (k_r : ℝ) * Δ_r
  let e_J := angUnitVec ε d k_ang_d
  let v_J1 := ((k_V1 : ℝ) + 1 / 2) * dyadicRealStep ε b_t
  let v_J2 := ((k_V2 : ℝ) + 1 / 2) * dyadicRealStep ε (b_t + d)
  let v_J := v_J1 • e_J + v_J2 • perp2D e_J
  let x_J1 := ((k_X1 : ℝ) + 1 / 2) * dyadicRealStep ε (b_t + r)
  let x_J2 := ((k_X2 : ℝ) + 1 / 2) * dyadicRealStep ε (b_t + d + r)
  let x_J := x_J1 • e_J + x_J2 • perp2D e_J
  let a_J := x_J - ((1 / 2 : ℝ) * Δ_r) • v_J
  let dX := (A_p + c_low • V_p) - a_J
  clampUnitBall2D ((10 * Δ_r)⁻¹ • WithLp.toLp 2
    ![ε ^ (-b_t) * inner ℝ dX e_J, ε ^ (-(b_t + d)) * inner ℝ dX (perp2D e_J)])
noncomputable def flip2D (v : EuclideanSpace ℝ (Fin 2)) : EuclideanSpace ℝ (Fin 2) :=
  WithLp.toLp 2 ![v 1, v 0]

noncomputable def paramVec {s σ : ℝ} {a_pt : Fin 3 → ℝ}
    (blk : CanonicalAffineBlockTied s σ a_pt) (l : ℕ) (b : Fin (blk.N_Θ l)) :
    EuclideanSpace ℝ (Fin 2) :=
  WithLp.toLp 2 ![(blk.θ_seq l b).1, (blk.θ_seq l b).2]

open Classical in
noncomputable def dirVec (v : EuclideanSpace ℝ (Fin 2)) : EuclideanSpace ℝ (Fin 2) :=
  if v = 0 then WithLp.toLp 2 ![1, 0] else ‖v‖⁻¹ • v

open Classical in
noncomputable def s1Chart (e : EuclideanSpace ℝ (Fin 2)) : Fin 4 :=
  if 0 < e 0 + e 1 ∧ e 0 - e 1 ≤ 0 then 0
  else if 0 ≤ e 0 + e 1 ∧ 0 < e 0 - e 1 then 1
  else if e 0 + e 1 < 0 ∧ 0 ≤ e 0 - e 1 then 2
  else 3

noncomputable def chartRot : Fin 4 → EuclideanSpace ℝ (Fin 2) → EuclideanSpace ℝ (Fin 2)
  | 0, e => e
  | 1, e => WithLp.toLp 2 ![e 1, e 0]
  | 2, e => -e
  | 3, e => -WithLp.toLp 2 ![e 1, e 0]

noncomputable def s1Coord (e : EuclideanSpace ℝ (Fin 2)) : ℝ :=
  let w := chartRot (s1Chart e) e
  w 0 / w 1

noncomputable def dirBin (ρ d : ℝ) (e : EuclideanSpace ℝ (Fin 2)) : Fin 4 × ℤ :=
  (s1Chart e, dyadicRealBin ρ d (s1Coord e))

open Classical in
noncomputable def threeReplicaStar {s σ : ℝ} {a_pt : Fin 3 → ℝ}
    (blk : CanonicalAffineBlockTied s σ a_pt) (l : ℕ)
    (i : Fin (blk.N_P l)) (b₀ b₁ b₂ : Fin (blk.N_Θ l)) : ℝ :=
  let μ_i := ∑ b : Fin (blk.N_Θ l), blk.π_seq l i b
  if 0 < μ_i then
    blk.π_seq l i b₀ * blk.π_seq l i b₁ * blk.π_seq l i b₂ / (μ_i ^ 2)
  else 0

structure ThreeReplicaHomogProfile (s σ : ℝ) (a_pt : Fin 3 → ℝ)
    (blk : CanonicalAffineBlockTied s σ a_pt) : Type where
  φ : ℕ → ℕ
  E_seq : ∀ n, Finset (Fin (blk.N_Θ (φ n)) × Fin (blk.N_Θ (φ n)) × Fin (blk.N_Θ (φ n)))
  ω_seq : ℕ → ℝ
  F_0 : ℝ → ℝ
  F_1 : ℝ → ℝ
  l_sc : ℝ → ℝ
  hφ_mono : StrictMono φ
  hω_pos : ∀ n, 0 < ω_seq n
  hω_tendsto : Filter.Tendsto ω_seq Filter.atTop (nhds 0)
  hF0_zero : F_0 0 = 0
  hF1_zero : F_1 0 = 0
  hl_zero : l_sc 0 = 0
  hF0_lip : ∀ d₁ d₂ : ℝ, 0 ≤ d₁ → d₁ ≤ d₂ → d₂ ≤ 1 →
    0 ≤ F_0 d₂ - F_0 d₁ ∧ F_0 d₂ - F_0 d₁ ≤ d₂ - d₁
  hF1_lip : ∀ d₁ d₂ : ℝ, 0 ≤ d₁ → d₁ ≤ d₂ → d₂ ≤ 1 →
    0 ≤ F_1 d₂ - F_1 d₁ ∧ F_1 d₂ - F_1 d₁ ≤ d₂ - d₁
  hl_lip : ∀ d₁ d₂ : ℝ, 0 ≤ d₁ → d₁ ≤ d₂ → d₂ ≤ 1 →
    0 ≤ l_sc d₂ - l_sc d₁ ∧ l_sc d₂ - l_sc d₁ ≤ d₂ - d₁
  hE_mass : ∀ n,
    letI := Classical.propDecidable
    let l := φ n
    (blk.ρ_seq l) ^ (ω_seq n) ≤
      ∑ i : Fin (blk.N_P l), ∑ b : Fin (blk.N_Θ l) × Fin (blk.N_Θ l) × Fin (blk.N_Θ l),
        if b ∈ E_seq n then threeReplicaStar blk l i b.1 b.2.1 b.2.2 else 0
  hE_pos : ∀ n b, b ∈ E_seq n →
    let l := φ n
    0 < ∑ i : Fin (blk.N_P l), threeReplicaStar blk l i b.1 b.2.1 b.2.2
  h_dir0_homog : ∀ d ∈ Set.Icc (0 : ℝ) 1, ∀ ε : ℝ, 0 < ε →
    ∃ N₀ : ℕ, ∀ n : ℕ, N₀ ≤ n →
      letI := Classical.propDecidable
      let l := φ n
      let ρ := blk.ρ_seq l
      ∀ b ∈ E_seq n,
        let p_b0 := ∑ i, ∑ b₁, ∑ b₂, threeReplicaStar blk l i b.1 b₁ b₂
        let d_cur := dirBin ρ d (dirVec (paramVec blk l b.2.1 - paramVec blk l b.1))
        let p_joint := ∑ i, ∑ b₁, ∑ b₂,
          if dirBin ρ d (dirVec (paramVec blk l b₁ - paramVec blk l b.1)) = d_cur
          then threeReplicaStar blk l i b.1 b₁ b₂ else 0
        ρ ^ (F_0 d + ε) ≤ p_joint / p_b0 ∧ p_joint / p_b0 ≤ ρ ^ (F_0 d - ε)
  h_dir1_homog : ∀ d ∈ Set.Icc (0 : ℝ) 1, ∀ ε : ℝ, 0 < ε →
    ∃ N₀ : ℕ, ∀ n : ℕ, N₀ ≤ n →
      letI := Classical.propDecidable
      let l := φ n
      let ρ := blk.ρ_seq l
      ∀ b ∈ E_seq n,
        let p_b1 := ∑ i, ∑ b₀, ∑ b₂, threeReplicaStar blk l i b₀ b.2.1 b₂
        let d_cur := dirBin ρ d (dirVec (paramVec blk l b.2.1 - paramVec blk l b.1))
        let p_joint := ∑ i, ∑ b₀, ∑ b₂,
          if dirBin ρ d (dirVec (paramVec blk l b.2.1 - paramVec blk l b₀)) = d_cur
          then threeReplicaStar blk l i b₀ b.2.1 b₂ else 0
        ρ ^ (F_1 d + ε) ≤ p_joint / p_b1 ∧ p_joint / p_b1 ≤ ρ ^ (F_1 d - ε)
  h_sc_homog : ∀ d ∈ Set.Icc (0 : ℝ) 1, ∀ ε : ℝ, 0 < ε →
    ∃ N₀ : ℕ, ∀ n : ℕ, N₀ ≤ n →
      letI := Classical.propDecidable
      let l := φ n
      let ρ := blk.ρ_seq l
      ∀ b ∈ E_seq n,
        let p_01 := ∑ i, ∑ b₂, threeReplicaStar blk l i b.1 b.2.1 b₂
        let e_dir := flip2D (dirVec (paramVec blk l b.2.1 - paramVec blk l b.1))
        let k_cur := dyadicRealBin ρ d (inner ℝ e_dir (paramVec blk l b.2.2))
        let p_joint := ∑ i, ∑ b₂,
          if dyadicRealBin ρ d (inner ℝ e_dir (paramVec blk l b₂)) = k_cur
          then threeReplicaStar blk l i b.1 b.2.1 b₂ else 0
        ρ ^ (l_sc d + ε) ≤ p_joint / p_01 ∧ p_joint / p_01 ≤ ρ ^ (l_sc d - ε)
noncomputable def negPerp2D (n : EuclideanSpace ℝ (Fin 2)) : EuclideanSpace ℝ (Fin 2) :=
  WithLp.toLp 2 (fun i : Fin 2 => if i = 0 then n 1 else -(n 0))

noncomputable def isoAnchoredObs {N_ω N_T : ℕ} (ε u : ℝ)
    (T_idx : Fin N_ω → Fin N_T)
    (V_part A_part : Fin N_T → EuclideanSpace ℝ (Fin 2))
    (c_val : Fin N_ω → ℝ) (ω : Fin N_ω) : ℤ × ℤ × ℤ :=
  let tid := T_idx ω
  let x_pos := A_part tid + (dyadicTimeMid ε u (c_val ω)) • V_part tid
  (dyadicTimeBin ε u (c_val ω),
    dyadicRealBin ε u (x_pos 0),
    dyadicRealBin ε u (x_pos 1))

noncomputable def isoVelObs {N_ω N_T : ℕ} (ε d : ℝ)
    (T_idx : Fin N_ω → Fin N_T)
    (V_part : Fin N_T → EuclideanSpace ℝ (Fin 2))
    (ω : Fin N_ω) : ℤ × ℤ :=
  let v := V_part (T_idx ω)
  (dyadicRealBin ε d (v 0), dyadicRealBin ε d (v 1))

noncomputable def isoStripEarlierObs {N_ω N_T : ℕ} (ε k a : ℝ)
    (T_idx : Fin N_ω → Fin N_T)
    (V_part A_part : Fin N_T → EuclideanSpace ℝ (Fin 2))
    (c_val : Fin N_ω → ℝ)
    (n_dir : (ℤ × ℤ × ℤ) → EuclideanSpace ℝ (Fin 2))
    (ω : Fin N_ω) : (ℤ × ℤ × ℤ) × (ℤ × ℤ × ℤ) × ℤ :=
  let ok := isoAnchoredObs ε k T_idx V_part A_part c_val ω
  let oa := isoAnchoredObs ε a T_idx V_part A_part c_val ω
  let tid := T_idx ω
  let x_a := A_part tid + (dyadicTimeMid ε a (c_val ω)) • V_part tid
  (ok, oa, dyadicRealBin ε 1 (inner ℝ x_a (n_dir ok)))

noncomputable def isoLastBlockObs {N_ω N_T : ℕ} (ε k u_glob : ℝ)
    (T_idx : Fin N_ω → Fin N_T)
    (V_part A_part : Fin N_T → EuclideanSpace ℝ (Fin 2))
    (c_val : Fin N_ω → ℝ)
    (n_dir : (ℤ × ℤ × ℤ) → EuclideanSpace ℝ (Fin 2))
    (ω : Fin N_ω) : ℤ × ℤ :=
  let ok := isoAnchoredObs ε k T_idx V_part A_part c_val ω
  let e_tan := negPerp2D (n_dir ok)
  let tid := T_idx ω
  let x_u := A_part tid + (dyadicTimeMid ε u_glob (c_val ω)) • V_part tid
  (dyadicTimeBin ε u_glob (c_val ω), dyadicRealBin ε u_glob (inner ℝ x_u e_tan))

noncomputable def isoTanVelBin {N_ω N_T : ℕ} (ε k d_vel : ℝ)
    (T_idx : Fin N_ω → Fin N_T)
    (V_part A_part : Fin N_T → EuclideanSpace ℝ (Fin 2))
    (c_val : Fin N_ω → ℝ)
    (n_dir : (ℤ × ℤ × ℤ) → EuclideanSpace ℝ (Fin 2))
    (ω : Fin N_ω) : ℤ :=
  let ok := isoAnchoredObs ε k T_idx V_part A_part c_val ω
  dyadicRealBin ε d_vel (inner ℝ (V_part (T_idx ω)) (negPerp2D (n_dir ok)))

noncomputable def finCondMutualInfo {N_ω : ℕ} {α β γ_t : Type} (ε : ℝ) (π : Fin N_ω → ℝ)
    (W : Fin N_ω → α) (U : Fin N_ω → β) (V : Fin N_ω → γ_t) : ℝ :=
  finCondEntropy ε π W V - finCondEntropy ε π (fun ω => (W ω, U ω)) V
def FiniteMarginalCoreBound : Prop :=
  letI := Classical.propDecidable
  ∀ (M r : ℕ)
    (ν : Fin M → ℝ)
    (A : Fin r → ℝ)
    (F : Fin r → Fin 3 → Fin M → ℤ × ℤ)
    (μ_comp : Fin r → Fin 3 → ℤ × ℤ → ℝ),
    (∀ ω, 0 ≤ ν ω) →
    (∑ ω : Fin M, ν ω = 1) →
    (∀ l, 0 ≤ A l) →
    (∀ l j v, 0 ≤ μ_comp l j v) →
    (∀ l j, (∑ v ∈ Finset.univ.image (F l j), μ_comp l j v) ≤ 1) →
    (∀ (l : Fin r) (v₀ v₁ v₂ : ℤ × ℤ),
      (∑ ω : Fin M, if F l 0 ω = v₀ ∧ F l 1 ω = v₁ ∧ F l 2 ω = v₂ then ν ω else 0) ≤
        A l * μ_comp l 0 v₀ * μ_comp l 1 v₁ * μ_comp l 2 v₂) →
    ∃ S_keep : Finset (Fin M),
      let M_ret := ∑ ω ∈ S_keep, ν ω
      1 / 2 ≤ M_ret ∧
      (∀ ω ∈ S_keep, 0 < ν ω) ∧
      (∀ (l : Fin r) (j : Fin 3) (ω : Fin M), ω ∈ S_keep →
        (1 / (6 * (r : ℝ) + 2)) * μ_comp l j (F l j ω) ≤
          ∑ ω' ∈ S_keep, if F l j ω' = F l j ω then ν ω' else 0) ∧
      (∀ (l : Fin r) (v₀ v₁ v₂ : ℤ × ℤ),
        let ρ := fun ω : Fin M => if ω ∈ S_keep then ν ω / M_ret else 0
        (∑ ω : Fin M, if F l 0 ω = v₀ ∧ F l 1 ω = v₁ ∧ F l 2 ω = v₂ then ρ ω else 0) ≤
          A l * (6 * (r : ℝ) + 2) ^ 3 *
            (∑ ω : Fin M, if F l 0 ω = v₀ then ρ ω else 0) *
            (∑ ω : Fin M, if F l 1 ω = v₁ then ρ ω else 0) *
            (∑ ω : Fin M, if F l 2 ω = v₂ then ρ ω else 0))
def IsOnSelectedChart (useChart0 : Bool) (θ : ℝ) : Prop :=
  if useChart0 then (Real.sqrt 2)⁻¹ ≤ |Real.cos θ| else |Real.cos θ| < (Real.sqrt 2)⁻¹

noncomputable def chartRowSlope (useChart0 : Bool) (θ : ℝ) : ℝ :=
  if useChart0 then Real.sin θ / Real.cos θ else -(Real.cos θ / Real.sin θ)

noncomputable def chartRowVec (useChart0 : Bool)
    (v : EuclideanSpace ℝ (Fin 2)) : EuclideanSpace ℝ (Fin 2) :=
  if useChart0 then v else perp2D v

noncomputable def chartRowRestrictPi {N_ω : ℕ}
    (π : Fin N_ω → ℝ) (E : Finset (Fin N_ω)) : Fin N_ω → ℝ :=
  let p_E := ∑ ω ∈ E, π ω
  fun ω => if ω ∈ E then π ω / p_E else 0
noncomputable def rowGrowthRestrictLaw {N_ω : ℕ} (π : Fin N_ω → ℝ)
    (S : Finset (Fin N_ω)) : Fin N_ω → ℝ :=
  let m_S := ∑ ω ∈ S, π ω
  fun ω => if ω ∈ S then π ω / m_S else 0

noncomputable def rowGrowthClamp2D (w : EuclideanSpace ℝ (Fin 2)) :
    EuclideanSpace ℝ (Fin 2) :=
  letI := Classical.propDecidable
  if ‖w‖ ≤ 1 then w else 0

noncomputable def rowGrowthCell (ε m r t b_t : ℝ)
    (V_p A_p : EuclideanSpace ℝ (Fin 2)) (c_s R_s : ℝ) :
    ℤ × ℤ × ℤ × ℤ × ℤ × ℤ :=
  let k_cr := dyadicTimeBin ε r c_s
  let C_r := dyadicTimeMid ε r c_s
  let k_rt := dyadicRealBin ε (m * t) R_s
  let R_bar := dyadicRealMid ε (m * t) R_s
  let X := V_p 0
  let Y_r := A_p 0 + C_r * X
  let W := V_p 1 - R_bar * X
  let Z_r := A_p 1 + C_r * (V_p 1) - R_bar * Y_r
  (k_cr, k_rt,
    dyadicRealBin ε b_t X,
    dyadicRealBin ε (b_t + r) Y_r,
    dyadicRealBin ε (b_t + m * t) W,
    dyadicRealBin ε (b_t + m * t + r) Z_r)

noncomputable def rowGrowthLocTime (ε r : ℝ) (k_cr : ℤ) (c_s : ℝ) : ℝ :=
  c_s * (2 : ℝ) ^ (dyadicTimeLevel ε r) - (k_cr : ℝ)

noncomputable def rowGrowthLocVel (ε m t b_t : ℝ)
    (j : ℤ × ℤ × ℤ × ℤ × ℤ × ℤ) (V_p : EuclideanSpace ℝ (Fin 2)) :
    EuclideanSpace ℝ (Fin 2) :=
  let (_, k_rt, k_X, _, k_W, _) := j
  let R_bar := ((k_rt : ℝ) + 1 / 2) * dyadicRealStep ε (m * t)
  let X_bar := ((k_X : ℝ) + 1 / 2) * dyadicRealStep ε b_t
  let W_bar := ((k_W : ℝ) + 1 / 2) * dyadicRealStep ε (b_t + m * t)
  let X := V_p 0
  let W := V_p 1 - R_bar * X
  rowGrowthClamp2D (WithLp.toLp 2
    ![(X - X_bar) / (8 * ε ^ b_t), (W - W_bar) / (8 * ε ^ (b_t + m * t))])

noncomputable def rowGrowthLocPos (ε m r t b_t : ℝ)
    (j : ℤ × ℤ × ℤ × ℤ × ℤ × ℤ) (V_p A_p : EuclideanSpace ℝ (Fin 2)) :
    EuclideanSpace ℝ (Fin 2) :=
  let (k_cr, k_rt, k_X, k_Y, k_W, k_Z) := j
  let Δ_r := ((2 : ℝ) ^ (dyadicTimeLevel ε r))⁻¹
  let C_r := ((k_cr : ℝ) + 1 / 2) * Δ_r
  let R_bar := ((k_rt : ℝ) + 1 / 2) * dyadicRealStep ε (m * t)
  let X_bar := ((k_X : ℝ) + 1 / 2) * dyadicRealStep ε b_t
  let Y_bar := ((k_Y : ℝ) + 1 / 2) * dyadicRealStep ε (b_t + r)
  let W_bar := ((k_W : ℝ) + 1 / 2) * dyadicRealStep ε (b_t + m * t)
  let Z_bar := ((k_Z : ℝ) + 1 / 2) * dyadicRealStep ε (b_t + m * t + r)
  let X := V_p 0
  let W := V_p 1 - R_bar * X
  let Y_r := A_p 0 + C_r * X
  let Z_r := A_p 1 + C_r * (V_p 1) - R_bar * Y_r
  rowGrowthClamp2D (WithLp.toLp 2
    ![((Y_r - Y_bar) - (1 / 2 : ℝ) * Δ_r * (X - X_bar)) / (8 * ε ^ b_t * Δ_r),
      ((Z_r - Z_bar) - (1 / 2 : ℝ) * Δ_r * (W - W_bar)) / (8 * ε ^ (b_t + m * t) * Δ_r)])
noncomputable def stdRootObs (ε e : ℝ)
    (V_p A_p : EuclideanSpace ℝ (Fin 2)) (θ_s : ℝ) :
    ℤ × ℤ × ℤ × ℤ × ℤ :=
  let k_r := angBin ε e θ_s
  let e_dir := angUnitVec ε e k_r
  (k_r,
    dyadicRealBin ε 0 (inner ℝ V_p e_dir),
    dyadicRealBin ε e (inner ℝ V_p (perp2D e_dir)),
    dyadicRealBin ε 0 (inner ℝ A_p e_dir),
    dyadicRealBin ε e (inner ℝ A_p (perp2D e_dir)))

noncomputable def rootCellVecV (ε e : ℝ) (d : ℤ × ℤ × ℤ × ℤ × ℤ) :
    EuclideanSpace ℝ (Fin 2) :=
  let e_dir := angUnitVec ε e d.1
  (((d.2.1 : ℝ) + 1 / 2) * dyadicRealStep ε 0) • e_dir +
    (((d.2.2.1 : ℝ) + 1 / 2) * dyadicRealStep ε e) • perp2D e_dir

noncomputable def rootCellVecA (ε e : ℝ) (d : ℤ × ℤ × ℤ × ℤ × ℤ) :
    EuclideanSpace ℝ (Fin 2) :=
  let e_dir := angUnitVec ε e d.1
  (((d.2.2.2.1 : ℝ) + 1 / 2) * dyadicRealStep ε 0) • e_dir +
    (((d.2.2.2.2 : ℝ) + 1 / 2) * dyadicRealStep ε e) • perp2D e_dir

open Classical in
noncomputable def replicaSepTag (ε e : ℝ) (k₁ k₂ : ℤ) : ℕ :=
  let s := |inner ℝ (angUnitVec ε e k₁) (perp2D (angUnitVec ε e k₂))|
  if s ≤ ε ^ e then ⌊4 * e⌋₊ + 1
  else min ⌊4 * (-Real.log s / Real.log (ε⁻¹))⌋₊ ⌊4 * e⌋₊

noncomputable def replicaSepDepth (e : ℝ) (kt : ℕ) : ℝ :=
  if kt = ⌊4 * e⌋₊ + 1 then e else (kt : ℝ) / 4

noncomputable def replicaCommonCell (ε e : ℝ) (kt : ℕ)
    (d₁ : ℤ × ℤ × ℤ × ℤ × ℤ) : ℕ × ℤ × ℤ × ℤ × ℤ × ℤ :=
  let v := replicaSepDepth e kt
  let m_e := dyadicTimeLevel ε e
  let m_v := dyadicTimeLevel ε v
  let k_c := d₁.1 / ((2 : ℤ) ^ (m_e - m_v))
  let e_c := angUnitVec ε v k_c
  let V₁ := rootCellVecV ε e d₁
  let A₁ := rootCellVecA ε e d₁
  (kt, k_c,
    dyadicRealBin ε 0 (inner ℝ V₁ e_c),
    dyadicRealBin ε v (inner ℝ V₁ (perp2D e_c)),
    dyadicRealBin ε 0 (inner ℝ A₁ e_c),
    dyadicRealBin ε v (inner ℝ A₁ (perp2D e_c)))

open Classical in
noncomputable def twoReplicaProb {N_ω N_T : ℕ} (π : Fin N_ω → ℝ)
    (T_idx : Fin N_ω → Fin N_T) (ij : Fin (N_ω * N_ω)) : ℝ :=
  let p := finProdFinEquiv.symm ij
  let p_T := ∑ ω : Fin N_ω, if T_idx ω = T_idx p.1 then π ω else 0
  if T_idx p.1 = T_idx p.2 ∧ 0 < p_T then (π p.1 * π p.2) / p_T else 0

def twoReplicaT {N_ω N_T : ℕ} (T_idx : Fin N_ω → Fin N_T)
    (ij : Fin (N_ω * N_ω)) : Fin N_T :=
  T_idx (finProdFinEquiv.symm ij).1

open Classical in
noncomputable def twoReplicaTailProb {N_ω N_T : ℕ} (ε e thresh : ℝ)
    (π : Fin N_ω → ℝ) (T_idx : Fin N_ω → Fin N_T) (θ_s : Fin N_ω → ℝ) : ℝ :=
  ∑ ij : Fin (N_ω * N_ω),
    let p := finProdFinEquiv.symm ij
    if thresh <
        replicaSepDepth e
          (replicaSepTag ε e (angBin ε e (θ_s p.1)) (angBin ε e (θ_s p.2)))
    then twoReplicaProb π T_idx ij else 0
def IsBoundedRowLaw {N_ω N_T : ℕ} (π : Fin N_ω → ℝ)
    (V_part A_part : Fin N_T → EuclideanSpace ℝ (Fin 2))
    (c_s R_s : Fin N_ω → ℝ) : Prop :=
  (∀ ω, 0 ≤ π ω) ∧
  (∑ ω : Fin N_ω, π ω = 1) ∧
  (∀ tid, ‖V_part tid‖ ≤ 1 ∧ ‖A_part tid‖ ≤ 1) ∧
  (∀ ω, 0 < π ω → c_s ω ∈ Set.Icc (0 : ℝ) 1 ∧ |R_s ω| ≤ 1)

noncomputable def rowListCap (m : ℝ) : List (ℚ × ℚ × ℚ × ℚ × ℚ) → ℝ
  | [] => 0
  | q :: tl =>
      (17 + m + max (q.1 : ℝ) 0 + max (q.2.1 : ℝ) 0 +
        max (q.2.2.1 : ℝ) 0 + max (q.2.2.2.1 : ℝ) 0) + rowListCap m tl
noncomputable def pktWeight (γ b a : ℝ) : ℝ :=
  (1 + γ) * b + (1 - γ) * a

noncomputable def roundShift2D (s : ℝ) (τ z : EuclideanSpace ℝ (Fin 2)) : ℤ × ℤ :=
  (Int.floor ((z 0 - τ 0) / s), Int.floor ((z 1 - τ 1) / s))

noncomputable def atomOutCell (ε H_P t r : ℝ)
    (τ_V τ_X : EuclideanSpace ℝ (Fin 2))
    (q_r : ℕ) (v_at x_at : EuclideanSpace ℝ (Fin 2)) : ℕ × (ℤ × ℤ) × (ℤ × ℤ) :=
  let u_t := (H_P - t) / 2
  (q_r,
   roundShift2D (ε ^ u_t) τ_V v_at,
   roundShift2D (ε ^ (r + u_t)) τ_X x_at)

noncomputable def fineOutCell (ε H_P t r : ℝ) (m_r m_t : ℕ)
    (τ_V τ_X : EuclideanSpace ℝ (Fin 2))
    (r_idx : ℕ) (v x : EuclideanSpace ℝ (Fin 2)) : ℕ × (ℤ × ℤ) × (ℤ × ℤ) :=
  let q_r := r_idx / 2 ^ (m_t - m_r)
  let s_c := ((2 : ℝ) ^ m_r)⁻¹
  let C_r := ((q_r : ℝ) + 1 / 2) * s_c
  let C_t := ((r_idx : ℝ) + 1 / 2) * ((2 : ℝ) ^ m_t)⁻¹
  atomOutCell ε H_P t r τ_V τ_X q_r v (x + (C_r - C_t) • v)

def coarseOfFineCell (M_L : ℕ) (p_c : ℕ × (ℤ × ℤ) × (ℤ × ℤ)) :
    ℕ × (ℤ × ℤ) × (ℤ × ℤ) :=
  (p_c.1,
   (p_c.2.1.1 / (M_L : ℤ), p_c.2.1.2 / (M_L : ℤ)),
   (p_c.2.2.1 / (M_L : ℤ), p_c.2.2.2 / (M_L : ℤ)))

noncomputable def fineCellCenterV (s_Vf : ℝ) (τ_V : EuclideanSpace ℝ (Fin 2))
    (k_V : ℤ × ℤ) : EuclideanSpace ℝ (Fin 2) :=
  τ_V + gridPt2D s_Vf k_V +
    WithLp.toLp 2 (fun _ : Fin 2 => (1 / 2 : ℝ) * s_Vf)

noncomputable def fineCellCenterX (s_Xf : ℝ) (τ_X : EuclideanSpace ℝ (Fin 2))
    (k_X : ℤ × ℤ) : EuclideanSpace ℝ (Fin 2) :=
  τ_X + gridPt2D s_Xf k_X +
    WithLp.toLp 2 (fun _ : Fin 2 => (1 / 2 : ℝ) * s_Xf)

noncomputable def fineVelBin (ε H_P t r : ℝ) (d_dim : ℕ)
    (τ_V : EuclideanSpace ℝ (Fin 2))
    (n_cell : (ℕ × (ℤ × ℤ) × (ℤ × ℤ)) → EuclideanSpace ℝ (Fin 2))
    (p_c : ℕ × (ℤ × ℤ) × (ℤ × ℤ)) (v : EuclideanSpace ℝ (Fin 2)) : ℤ × ℤ :=
  let u_t := (H_P - t) / 2
  let u_r := (H_P - r) / 2
  let v_rel := v - fineCellCenterV (ε ^ u_t) τ_V p_c.2.1
  if d_dim = 1 then
    (Int.floor (inner ℝ v_rel (n_cell p_c) / (ε ^ u_r)), 0)
  else
    (Int.floor (v_rel 0 / (ε ^ u_r)), Int.floor (v_rel 1 / (ε ^ u_r)))

noncomputable def cutLocalizerIdx (ε b_star : ℝ) (m_r m_t : ℕ)
    (r_idx : ℕ) (v x : EuclideanSpace ℝ (Fin 2)) : ℕ × (ℤ × ℤ) × (ℤ × ℤ) :=
  let q_r := r_idx / 2 ^ (m_t - m_r)
  let s_c := ((2 : ℝ) ^ m_r)⁻¹
  let s_v := ε ^ b_star
  let s_x := s_c * s_v
  let C_r := ((q_r : ℝ) + 1 / 2) * s_c
  let C_t := ((r_idx : ℝ) + 1 / 2) * ((2 : ℝ) ^ m_t)⁻¹
  (q_r,
   (Int.floor (v 0 / s_v + 1 / 2), Int.floor (v 1 / s_v + 1 / 2)),
   (Int.floor ((x 0 + (C_r - C_t) * v 0) / s_x + 1 / 2),
    Int.floor ((x 1 + (C_r - C_t) * v 1) / s_x + 1 / 2)))

structure LocalizerSubclass (N_ret : ℕ) where
  loc_idx : ℕ × (ℤ × ℤ) × (ℤ × ℤ)
  N_all : ℕ
  m_bin : ℝ
  g_bin : ℝ
  b_loc : ℝ
  a_loc : ℝ
  k_bin : ℝ
  is_aligned : Bool
  o_at : Fin N_ret → (ℤ × ℤ) × (ℤ × ℤ)
  ψ_at : Fin N_ret → EuclideanSpace ℝ (Fin 2) → ℂ
  c_at : Fin N_ret → ℂ
  cap_id : Fin N_ret → ℕ
  e_cap : Fin N_ret → EuclideanSpace ℝ (Fin 2)
  V_cap : Fin N_ret → EuclideanSpace ℝ (Fin 2)
  X_cap : Fin N_ret → EuclideanSpace ℝ (Fin 2)

def IsValidSubclassAtoms (cls : PacketBoundClass)
    (M_atom : ℝ → ℝ → ℝ → ℝ → ℝ → ℕ → ℝ)
    (γ ε H_P L t r b_star lam_sys ξ C_cov : ℝ) (m_r m_t M_mult : ℕ)
    (C_tr : ℕ → ℝ)
    (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
    {N_ret : ℕ} (sub : LocalizerSubclass N_ret) : Prop :=
  letI := Classical.propDecidable
  let q_r := sub.loc_idx.1
  let s_c := ((2 : ℝ) ^ m_r)⁻¹
  let C_r := ((q_r : ℝ) + 1 / 2) * s_c
  let s_v := ε ^ b_star
  let s_x := s_c * s_v
  let V_J := gridPt2D s_v sub.loc_idx.2.1
  let X_J := gridPt2D s_x sub.loc_idx.2.2
  let ρ_r := if r = 0 then (Real.sqrt lam_sys)⁻¹ else ε ^ ((H_P - r) / 2)
  let σ_r := (lam_sys * ρ_r)⁻¹
  let ρ_t := ε ^ ((H_P - t) / 2)
  let W_max := min (L - r - b_star) ((H_P - r) / 2 - b_star)
  let V_at := fun α => gridPt2D ρ_r (sub.o_at α).1
  let X_at := fun α => gridPt2D σ_r (sub.o_at α).2
  let V'_at := fun α => s_v⁻¹ • (V_at α - V_J)
  let X'_at := fun α => s_x⁻¹ • (X_at α - X_J)
  let g_at := fun α (v : EuclideanSpace ℝ (Fin 2)) =>
    (ρ_r⁻¹ : ℂ) * star (sub.ψ_at α (ρ_r⁻¹ • (v - V_at α))) *
      Complex.exp (-(Complex.I * ((lam_sys * Φ₀ (C_r, X_at α, v) : ℝ) : ℂ)))
  1 ≤ N_ret ∧ N_ret ≤ sub.N_all ∧ q_r < 2 ^ m_r ∧
  ‖V_J‖ ≤ 2 * cls.B_sys ∧ ‖X_J‖ ≤ 4 * cls.B_sys ∧
  0 < sub.m_bin ∧ 0 ≤ sub.b_loc ∧ sub.b_loc ≤ sub.a_loc ∧ sub.a_loc ≤ W_max ∧
  (∀ α : Fin N_ret,
    (∀ k : ℕ, ContDiff ℝ k (sub.ψ_at α)) ∧
    (∀ z, 4 ≤ ‖z‖ → sub.ψ_at α z = 0) ∧
    (∀ k z, ‖iteratedFDeriv ℝ k (sub.ψ_at α) z‖ ≤
      M_atom cls.a₀ cls.a₁ cls.A cls.B_sys cls.R_win k) ∧
    ‖V'_at α‖ ≤ 4 * cls.B_sys + cls.R_win + 4 ∧
    ‖X'_at α‖ ≤ 8 * cls.B_sys + 2 * cls.R_win + 10 ∧
    sub.m_bin ≤ ‖sub.c_at α‖ ^ 2 ∧ ‖sub.c_at α‖ ^ 2 ≤ ε ^ (-ξ) * sub.m_bin ∧
    ‖sub.e_cap α‖ = 1 ∧
    |inner ℝ (V'_at α - sub.V_cap α) (sub.e_cap α)| ≤ ε ^ sub.b_loc ∧
    |inner ℝ (V'_at α - sub.V_cap α) (perp2D (sub.e_cap α))| ≤ ε ^ sub.a_loc ∧
    |inner ℝ (X'_at α - sub.X_cap α) (sub.e_cap α)| ≤ ε ^ sub.b_loc ∧
    |inner ℝ (X'_at α - sub.X_cap α) (perp2D (sub.e_cap α))| ≤ ε ^ sub.a_loc ∧
    (∀ α' : Fin N_ret, sub.cap_id α = sub.cap_id α' →
      sub.e_cap α = sub.e_cap α' ∧ sub.V_cap α = sub.V_cap α' ∧ sub.X_cap α = sub.X_cap α')) ∧
  (∀ o₀, ((Finset.univ.filter (fun α : Fin N_ret => sub.o_at α = o₀)).card : ℝ) ≤ (M_mult : ℝ)) ∧
  (((Finset.univ.image sub.cap_id).card : ℝ) ≤
    C_cov * (sub.N_all : ℝ) * ε ^ (sub.g_bin - pktWeight γ sub.b_loc sub.a_loc - 2 * ξ)) ∧
  (∀ (b_F a_F R_F : ℝ) (e_F V_F X_F : EuclideanSpace ℝ (Fin 2)),
    0 ≤ b_F → b_F ≤ a_F → a_F ≤ W_max → 1 ≤ R_F → ‖e_F‖ = 1 →
    ((Finset.univ.filter (fun α : Fin N_ret =>
      |inner ℝ (V'_at α - V_F) e_F| ≤ R_F * ε ^ b_F ∧
      |inner ℝ (V'_at α - V_F) (perp2D e_F)| ≤ R_F * ε ^ a_F ∧
      |inner ℝ (X'_at α - X_F) e_F| ≤ R_F * ε ^ b_F ∧
      |inner ℝ (X'_at α - X_F) (perp2D e_F)| ≤ R_F * ε ^ a_F)).card : ℝ) ≤
      C_cov * R_F ^ 4 * ε ^ (-sub.g_bin + pktWeight γ b_F a_F - 2 * ξ)) ∧
  (∀ (r_loc : ℕ), r_loc < 2 ^ (m_t - m_r) →
    let C_t := (((q_r * 2 ^ (m_t - m_r) + r_loc : ℕ) : ℝ) + 1 / 2) * ((2 : ℝ) ^ m_t)⁻¹
    ∀ (V_o X_o : EuclideanSpace ℝ (Fin 2)) (ψ_o : EuclideanSpace ℝ (Fin 2) → ℂ),
      ‖V_o - V_J‖ ≤ 4 * cls.B_sys * s_v →
      ‖X_o + (C_r - C_t) • V_o - X_J‖ ≤ 4 * cls.B_sys * s_x →
      (∀ k : ℕ, ContDiff ℝ k ψ_o) →
      (∀ z, cls.R_win ≤ ‖z‖ → ψ_o z = 0) →
      (∀ k z, ‖iteratedFDeriv ℝ k ψ_o z‖ ≤ cls.M_win k) →
      let pair_fn := fun h : EuclideanSpace ℝ (Fin 2) → ℂ =>
        (ρ_t⁻¹ : ℂ) * ∫ v, h v * ψ_o (ρ_t⁻¹ • (v - V_o)) *
          Complex.exp (Complex.I * ((lam_sys * Φ₀ (C_t, X_o, v) : ℝ) : ℂ))
      ∀ (M_tr : ℕ) (R_tr : ℝ), 2 ≤ M_tr → 2 ≤ R_tr →
        let S_near := Finset.univ.filter (fun α : Fin N_ret =>
          ‖V_o - V_at α‖ ≤ C_cov * ρ_t ∧
          ‖X_o - X_at α - (C_t - C_r) • V_at α‖ ≤ C_cov * R_tr * σ_r)
        ‖pair_fn (fun v => ∑ α : Fin N_ret, sub.c_at α * g_at α v) -
         pair_fn (fun v => ∑ α ∈ S_near, sub.c_at α * g_at α v)‖ ≤
          C_tr M_tr * R_tr ^ (1 - (M_tr : ℝ)))

noncomputable def subclassProxyA (ε : ℝ) {N_ret : ℕ} (sub : LocalizerSubclass N_ret) : ℝ :=
  let ell := Real.log (ε⁻¹)
  Real.log (N_ret : ℝ) / ell + (3 / 2 : ℝ) * (Real.log sub.m_bin / ell) + (1 / 2 : ℝ) * sub.g_bin

noncomputable def subclassWinScore (γ ε H_P t r b_star lam_sys : ℝ) (m_r m_t : ℕ)
    (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
    {N_O N_D : ℕ} (r_O : Fin N_O → ℕ) (V_O X_O : Fin N_O → EuclideanSpace ℝ (Fin 2))
    (ψ_O : Fin N_O → EuclideanSpace ℝ (Fin 2) → ℂ) (b_D a_D : Fin N_D → ℝ)
    {N_ret : ℕ} (sub : LocalizerSubclass N_ret)
    (p_cond : Fin N_O → Fin N_D → ℝ) : ℝ :=
  let q_r := sub.loc_idx.1
  let s_c := ((2 : ℝ) ^ m_r)⁻¹
  let C_r := ((q_r : ℝ) + 1 / 2) * s_c
  let ρ_r := if r = 0 then (Real.sqrt lam_sys)⁻¹ else ε ^ ((H_P - r) / 2)
  let σ_r := (lam_sys * ρ_r)⁻¹
  let h_sub := fun v : EuclideanSpace ℝ (Fin 2) =>
    ∑ α : Fin N_ret, sub.c_at α *
      ((ρ_r⁻¹ : ℂ) * star (sub.ψ_at α (ρ_r⁻¹ • (v - gridPt2D ρ_r (sub.o_at α).1))) *
        Complex.exp (-(Complex.I * ((lam_sys * Φ₀ (C_r, gridPt2D σ_r (sub.o_at α).2, v) : ℝ) : ℂ))))
  generalPacketScore ε γ H_P t lam_sys m_t Φ₀ h_sub N_O N_D r_O V_O X_O ψ_O b_D a_D p_cond - b_star
noncomputable def modalPrefixCell (ε d₀ : ℝ)
    (V_p A_p : EuclideanSpace ℝ (Fin 2)) (k₀ : ℤ) :
    ℤ × ℤ × ℤ × ℤ × ℤ :=
  let e₀ := angUnitVec ε d₀ k₀
  (k₀,
    dyadicRealBin ε 0 (inner ℝ V_p e₀),
    dyadicRealBin ε d₀ (inner ℝ V_p (perp2D e₀)),
    dyadicRealBin ε 0 (inner ℝ A_p e₀),
    dyadicRealBin ε d₀ (inner ℝ A_p (perp2D e₀)))

noncomputable def modalPrefixCenter (ε d₀ : ℝ) (k₀ j_b j_a : ℤ) :
    EuclideanSpace ℝ (Fin 2) :=
  let e₀ := angUnitVec ε d₀ k₀
  (((j_b : ℝ) + 1 / 2) * dyadicRealStep ε 0) • e₀ +
    (((j_a : ℝ) + 1 / 2) * dyadicRealStep ε d₀) • perp2D e₀

noncomputable def modalPrefixLocalVec (ε d₀ : ℝ)
    (e₀ center vec : EuclideanSpace ℝ (Fin 2)) :
    EuclideanSpace ℝ (Fin 2) :=
  WithLp.toLp 2
    ![(1 / 2 : ℝ) * inner ℝ (vec - center) e₀,
      (1 / 2 : ℝ) * ε ^ (-d₀) * inner ℝ (vec - center) (perp2D e₀)]

noncomputable def modalPrefixCancelAngle (ε e d₀ θ : ℝ) : ℝ :=
  letI := Classical.propDecidable
  let m_e := dyadicTimeLevel ε e
  let m_d := dyadicTimeLevel ε d₀
  let φ_e := ((angBin ε e θ : ℝ) + 1 / 2) * Real.pi * ((2 : ℝ) ^ m_e)⁻¹
  let φ_0 := ((angBin ε d₀ θ : ℝ) + 1 / 2) * Real.pi * ((2 : ℝ) ^ m_d)⁻¹
  let α := φ_e - φ_0
  let u_raw : EuclideanSpace ℝ (Fin 2) :=
    WithLp.toLp 2 ![Real.cos α, ε ^ (-d₀) * Real.sin α]
  let u_unit : EuclideanSpace ℝ (Fin 2) := ‖u_raw‖⁻¹ • u_raw
  let u_pos : EuclideanSpace ℝ (Fin 2) :=
    if 0 < u_unit 1 ∨ (u_unit 1 = 0 ∧ 0 ≤ u_unit 0) then u_unit else -u_unit
  Real.arccos (u_pos 0)
noncomputable def pairKLDivergence {N_P N_Θ : ℕ}
    (p0 : Fin N_P → Fin N_Θ → ℝ) : ℝ :=
  let mu0 : Fin N_P → ℝ := fun i => ∑ b : Fin N_Θ, p0 i b
  let lam0 : Fin N_Θ → ℝ := fun b => ∑ i : Fin N_P, p0 i b
  ∑ i : Fin N_P, ∑ b : Fin N_Θ,
    p0 i b * Real.log (p0 i b / (mu0 i * lam0 b))

noncomputable def condCoordMultiInfo {N_P N_Θ k_grp : ℕ}
    (p0 : Fin N_P → Fin N_Θ → ℝ)
    (Q : Fin k_grp → Fin N_P → Fin N_Θ → ℤ × ℤ) : ℝ :=
  letI := Classical.propDecidable
  let lam0 : Fin N_Θ → ℝ := fun b => ∑ i : Fin N_P, p0 i b
  ∑ i : Fin N_P, ∑ b : Fin N_Θ,
    let p_joint := ∑ i' : Fin N_P,
      if (∀ g : Fin k_grp, Q g i' b = Q g i b) then p0 i' b / lam0 b else 0
    let p_prod := ∏ g : Fin k_grp,
      (∑ i' : Fin N_P, if Q g i' b = Q g i b then p0 i' b / lam0 b else 0)
    p0 i b * Real.log (p_joint / p_prod)

noncomputable def canonicalGroupBinsDistinct (ρ : ℝ) (P : Fin 4 → ℝ) (θ : ℝ × ℝ) :
    Fin 4 → ℤ × ℤ :=
  fun j => (canonicalGridBin ρ (canonicalShear4 P θ j), 0)

noncomputable def canonicalGroupBinsTied (ρ : ℝ) (P : Fin 4 → ℝ) (θ : ℝ × ℝ) :
    Fin 3 → ℤ × ℤ
  | 0 => (canonicalGridBin ρ (canonicalShear4 P θ 0), 0)
  | 1 => (canonicalGridBin ρ (canonicalShear4 P θ 1),
          canonicalGridBin ρ (canonicalShear4 P θ 2))
  | 2 => (canonicalGridBin ρ (canonicalShear4 P θ 3), 0)

noncomputable def canonicalGroupPrefixDistinct (ρ d : ℝ) (P : Fin 4 → ℝ) (θ : ℝ × ℝ) :
    Fin 4 → ℤ × ℤ :=
  fun j => (dyadicRealBin ρ d (canonicalGridMid ρ (canonicalShear4 P θ j)), 0)

noncomputable def canonicalGroupPrefixTied (ρ d : ℝ) (P : Fin 4 → ℝ) (θ : ℝ × ℝ) :
    Fin 3 → ℤ × ℤ
  | 0 => (dyadicRealBin ρ d (canonicalGridMid ρ (canonicalShear4 P θ 0)), 0)
  | 1 => (dyadicRealBin ρ d (canonicalGridMid ρ (canonicalShear4 P θ 1)),
          dyadicRealBin ρ d (canonicalGridMid ρ (canonicalShear4 P θ 2)))
  | 2 => (dyadicRealBin ρ d (canonicalGridMid ρ (canonicalShear4 P θ 3)), 0)

structure PreCoreDistinctStage (s σ : ℝ) (a_pt : Fin 4 → ℝ)
    (M : ℕ) (η_stage L_min : ℝ) : Type where
  ρ : ℝ
  N_P : ℕ
  N_Θ : ℕ
  p0 : Fin N_P → Fin N_Θ → ℝ
  P : Fin N_P → Fin 4 → ℝ
  θ : Fin N_Θ → ℝ × ℝ
  H_good : Fin N_P → Fin N_Θ → Prop
  hρ_bounds : 0 < ρ ∧ ρ < 1 / 2
  hL_min : L_min ≤ Real.log (ρ⁻¹)
  hp0_nn : ∀ i b, 0 ≤ p0 i b
  hp0_sum : (∑ i : Fin N_P, ∑ b : Fin N_Θ, p0 i b) = 1
  hP_dom : ∀ i j, |P i j| ≤ 4
  hθ_dom : ∀ b, |(θ b).1| ≤ 4 ∧ |(θ b).2| ≤ 4
  hH_mass :
    letI := Classical.propDecidable
    1 - η_stage ≤ ∑ i : Fin N_P, ∑ b : Fin N_Θ, if H_good i b then p0 i b else 0
  hD_pair : pairKLDivergence p0 ≤ η_stage * Real.log (ρ⁻¹)
  hD_coord : condCoordMultiInfo p0
    (fun g i b => canonicalGroupBinsDistinct ρ (P i) (θ b) g) ≤ η_stage * Real.log (ρ⁻¹)
  h_time_mesh : ∀ (i : Fin N_P) (b : Fin N_Θ), H_good i b → 0 < p0 i b →
    ∀ (r_idx : ℕ), 1 ≤ r_idx → r_idx ≤ M →
      letI := Classical.propDecidable
      let d := (r_idx : ℝ) / (M : ℝ)
      let q := dyadicRealBin ρ d (θ b).1
      (∑ i' : Fin N_P, ∑ b' : Fin N_Θ,
        if dyadicRealBin ρ d (θ b').1 = q then p0 i' b' else 0) ≤ ρ ^ (s * d - η_stage)
  h_norm_mesh : ∀ (i : Fin N_P) (b : Fin N_Θ), H_good i b → 0 < p0 i b →
    ∀ (r_idx : ℕ), 1 ≤ r_idx → r_idx ≤ M →
      letI := Classical.propDecidable
      let d := (r_idx : ℝ) / (M : ℝ)
      let q := dyadicRealBin ρ d (θ b).2
      (∑ i' : Fin N_P, ∑ b' : Fin N_Θ,
        if dyadicRealBin ρ d (θ b').2 = q then p0 i' b' else 0) ≤ ρ ^ (σ * d - η_stage)
  h_coord_mesh : ∀ (i : Fin N_P) (b : Fin N_Θ), H_good i b → 0 < p0 i b →
    ∀ (r_idx : ℕ), 1 ≤ r_idx → r_idx ≤ M → ∀ j : Fin 4,
      letI := Classical.propDecidable
      let d := (r_idx : ℝ) / (M : ℝ)
      let lam0_b := ∑ i' : Fin N_P, p0 i' b
      let q_val := canonicalGroupPrefixDistinct ρ d (P i) (θ b) j
      let p_cond := ∑ i' : Fin N_P,
        if canonicalGroupPrefixDistinct ρ d (P i') (θ b) j = q_val then p0 i' b / lam0_b else 0
      ρ ^ (a_pt j * d + η_stage) ≤ p_cond ∧ p_cond ≤ ρ ^ (a_pt j * d - η_stage)

structure PreCoreTiedStage (s σ : ℝ) (a_pt : Fin 3 → ℝ)
    (M : ℕ) (η_stage L_min : ℝ) : Type where
  ρ : ℝ
  N_P : ℕ
  N_Θ : ℕ
  p0 : Fin N_P → Fin N_Θ → ℝ
  P : Fin N_P → Fin 4 → ℝ
  θ : Fin N_Θ → ℝ × ℝ
  H_good : Fin N_P → Fin N_Θ → Prop
  hρ_bounds : 0 < ρ ∧ ρ < 1 / 2
  hL_min : L_min ≤ Real.log (ρ⁻¹)
  hp0_nn : ∀ i b, 0 ≤ p0 i b
  hp0_sum : (∑ i : Fin N_P, ∑ b : Fin N_Θ, p0 i b) = 1
  hP_dom : ∀ i j, |P i j| ≤ 4
  hθ_dom : ∀ b, |(θ b).1| ≤ 4 ∧ |(θ b).2| ≤ 4
  hH_mass :
    letI := Classical.propDecidable
    1 - η_stage ≤ ∑ i : Fin N_P, ∑ b : Fin N_Θ, if H_good i b then p0 i b else 0
  hD_pair : pairKLDivergence p0 ≤ η_stage * Real.log (ρ⁻¹)
  hD_coord : condCoordMultiInfo p0
    (fun g i b => canonicalGroupBinsTied ρ (P i) (θ b) g) ≤ η_stage * Real.log (ρ⁻¹)
  h_time_mesh : ∀ (i : Fin N_P) (b : Fin N_Θ), H_good i b → 0 < p0 i b →
    ∀ (r_idx : ℕ), 1 ≤ r_idx → r_idx ≤ M →
      letI := Classical.propDecidable
      let d := (r_idx : ℝ) / (M : ℝ)
      let q := dyadicRealBin ρ d (θ b).1
      (∑ i' : Fin N_P, ∑ b' : Fin N_Θ,
        if dyadicRealBin ρ d (θ b').1 = q then p0 i' b' else 0) ≤ ρ ^ (s * d - η_stage)
  h_norm_mesh : ∀ (i : Fin N_P) (b : Fin N_Θ), H_good i b → 0 < p0 i b →
    ∀ (r_idx : ℕ), 1 ≤ r_idx → r_idx ≤ M →
      letI := Classical.propDecidable
      let d := (r_idx : ℝ) / (M : ℝ)
      let q := dyadicRealBin ρ d (θ b).2
      (∑ i' : Fin N_P, ∑ b' : Fin N_Θ,
        if dyadicRealBin ρ d (θ b').2 = q then p0 i' b' else 0) ≤ ρ ^ (σ * d - η_stage)
  h_param_ball_mesh : ∀ (i : Fin N_P) (b : Fin N_Θ), H_good i b → 0 < p0 i b →
    ∀ (r_idx : ℕ), 1 ≤ r_idx → r_idx ≤ M →
      letI := Classical.propDecidable
      let d := (r_idx : ℝ) / (M : ℝ)
      let q := paramTreeBin ρ d (θ b)
      (∑ i' : Fin N_P, ∑ b' : Fin N_Θ,
        if paramTreeBin ρ d (θ b') = q then p0 i' b' else 0) ≤ ρ ^ (s * d - η_stage)
  h_param_mesh : ∀ (i : Fin N_P) (b : Fin N_Θ), H_good i b → 0 < p0 i b →
    ∀ (r₁ r₂ : ℕ), 1 ≤ r₁ → r₁ < r₂ → r₂ ≤ M →
      letI := Classical.propDecidable
      let d₁ := (r₁ : ℝ) / (M : ℝ)
      let d₂ := (r₂ : ℝ) / (M : ℝ)
      let q₁ := paramTreeBin ρ d₁ (θ b)
      let q₂ := paramTreeBin ρ d₂ (θ b)
      (∑ i' : Fin N_P, ∑ b' : Fin N_Θ,
        if paramTreeBin ρ d₁ (θ b') = q₁ ∧ paramTreeBin ρ d₂ (θ b') = q₂ then p0 i' b' else 0) ≤
      ρ ^ (s * (d₂ - d₁) - η_stage) *
        (∑ i' : Fin N_P, ∑ b' : Fin N_Θ,
          if paramTreeBin ρ d₁ (θ b') = q₁ then p0 i' b' else 0)
  h_coord_mesh : ∀ (i : Fin N_P) (b : Fin N_Θ), H_good i b → 0 < p0 i b →
    ∀ (r_idx : ℕ), 1 ≤ r_idx → r_idx ≤ M → ∀ g : Fin 3,
      letI := Classical.propDecidable
      let d := (r_idx : ℝ) / (M : ℝ)
      let lam0_b := ∑ i' : Fin N_P, p0 i' b
      let q_val := canonicalGroupPrefixTied ρ d (P i) (θ b) g
      let p_cond := ∑ i' : Fin N_P,
        if canonicalGroupPrefixTied ρ d (P i') (θ b) g = q_val then p0 i' b / lam0_b else 0
      ρ ^ (a_pt g * d + η_stage) ≤ p_cond ∧ p_cond ≤ ρ ^ (a_pt g * d - η_stage)

structure CoredDistinctMeshStage (s σ : ℝ) (a_pt : Fin 4 → ℝ)
    (M : ℕ) (κ_err : ℝ) : Type where
  ρ : ℝ
  N_P : ℕ
  N_Θ : ℕ
  π : Fin N_P → Fin N_Θ → ℝ
  P : Fin N_P → Fin 4 → ℝ
  θ : Fin N_Θ → ℝ × ℝ
  hρ_bounds : 0 < ρ ∧ ρ < 1 / 2
  hπ_nn : ∀ i b, 0 ≤ π i b
  hπ_sum : (∑ i : Fin N_P, ∑ b : Fin N_Θ, π i b) = 1
  hP_dom : ∀ i j, |P i j| ≤ 4
  hθ_dom : ∀ b, |(θ b).1| ≤ 4 ∧ |(θ b).2| ≤ 4
  h_pair_dom : ∀ i b, π i b ≤ ρ ^ (-κ_err) * (∑ b', π i b') * (∑ i', π i' b)
  h_coord_prod : ∀ b, 0 < (∑ i, π i b) → ∀ k : Fin 4 → ℤ,
    letI := Classical.propDecidable
    let lam_b := ∑ i, π i b
    (∑ i : Fin N_P,
      if (∀ j : Fin 4, canonicalGridBin ρ (canonicalShear4 (P i) (θ b) j) = k j)
      then π i b / lam_b else 0) ≤
    ρ ^ (-κ_err) * ∏ j : Fin 4,
      (∑ i : Fin N_P,
        if canonicalGridBin ρ (canonicalShear4 (P i) (θ b) j) = k j
        then π i b / lam_b else 0)
  h_time_mesh : ∀ (r_idx : ℕ), 1 ≤ r_idx → r_idx ≤ M → ∀ q : ℤ,
    letI := Classical.propDecidable
    let d := (r_idx : ℝ) / (M : ℝ)
    (∑ b : Fin N_Θ, if dyadicRealBin ρ d (θ b).1 = q then (∑ i, π i b) else 0) ≤
      ρ ^ (s * d - κ_err)
  h_norm_mesh : ∀ (r_idx : ℕ), 1 ≤ r_idx → r_idx ≤ M → ∀ q : ℤ,
    letI := Classical.propDecidable
    let d := (r_idx : ℝ) / (M : ℝ)
    (∑ b : Fin N_Θ, if dyadicRealBin ρ d (θ b).2 = q then (∑ i, π i b) else 0) ≤
      ρ ^ (σ * d - κ_err)
  h_coord_mesh : ∀ b, 0 < (∑ i, π i b) →
    ∀ (r_idx : ℕ), 1 ≤ r_idx → r_idx ≤ M → ∀ (j : Fin 4) (q : ℤ),
      letI := Classical.propDecidable
      let d := (r_idx : ℝ) / (M : ℝ)
      let lam_b := ∑ i, π i b
      (∑ i : Fin N_P,
        if dyadicRealBin ρ d (canonicalGridMid ρ (canonicalShear4 (P i) (θ b) j)) = q
        then π i b / lam_b else 0) ≤ ρ ^ (a_pt j * d - κ_err)
  h_coord_supp_mesh : ∀ b, 0 < (∑ i, π i b) →
    ∀ (r_idx : ℕ), 1 ≤ r_idx → r_idx ≤ M → ∀ j : Fin 4,
      letI := Classical.propDecidable
      let d := (r_idx : ℝ) / (M : ℝ)
      (((Finset.univ.filter (fun i : Fin N_P => 0 < π i b)).image
        (fun i => dyadicRealBin ρ d (canonicalGridMid ρ (canonicalShear4 (P i) (θ b) j)))).card : ℝ) ≤
        ρ ^ (-a_pt j * d - κ_err)

structure CoredTiedMeshStage (s σ : ℝ) (a_pt : Fin 3 → ℝ)
    (M : ℕ) (κ_err : ℝ) : Type where
  ρ : ℝ
  g_stage : ℝ → ℝ
  N_P : ℕ
  N_Θ : ℕ
  π : Fin N_P → Fin N_Θ → ℝ
  P : Fin N_P → Fin 4 → ℝ
  θ : Fin N_Θ → ℝ × ℝ
  hρ_bounds : 0 < ρ ∧ ρ < 1 / 2
  hg_zero : g_stage 0 = 0
  hg_lip : ∀ d₁ d₂ : ℝ, d₁ ≤ d₂ → 0 ≤ g_stage d₂ - g_stage d₁ ∧ g_stage d₂ - g_stage d₁ ≤ d₂ - d₁
  hg_le_q : g_stage 1 ≤ a_pt 1 + κ_err
  hπ_nn : ∀ i b, 0 ≤ π i b
  hπ_sum : (∑ i : Fin N_P, ∑ b : Fin N_Θ, π i b) = 1
  hP_dom : ∀ i j, |P i j| ≤ 4
  hθ_dom : ∀ b, |(θ b).1| ≤ 4 ∧ |(θ b).2| ≤ 4
  h_pair_dom : ∀ i b, π i b ≤ ρ ^ (-κ_err) * (∑ b', π i b') * (∑ i', π i' b)
  h_coord_prod : ∀ b, 0 < (∑ i, π i b) → ∀ (k_X : ℤ) (k_U : ℤ × ℤ) (k_Z : ℤ),
    letI := Classical.propDecidable
    let lam_b := ∑ i, π i b
    let bX := fun i => canonicalGridBin ρ (canonicalShear4 (P i) (θ b) 0)
    let bU := fun i => (canonicalGridBin ρ (canonicalShear4 (P i) (θ b) 1),
                        canonicalGridBin ρ (canonicalShear4 (P i) (θ b) 2))
    let bZ := fun i => canonicalGridBin ρ (canonicalShear4 (P i) (θ b) 3)
    (∑ i : Fin N_P, if bX i = k_X ∧ bU i = k_U ∧ bZ i = k_Z then π i b / lam_b else 0) ≤
    ρ ^ (-κ_err) *
      (∑ i, if bX i = k_X then π i b / lam_b else 0) *
      (∑ i, if bU i = k_U then π i b / lam_b else 0) *
      (∑ i, if bZ i = k_Z then π i b / lam_b else 0)
  h_time_mesh : ∀ (r_idx : ℕ), 1 ≤ r_idx → r_idx ≤ M → ∀ q : ℤ,
    letI := Classical.propDecidable
    let d := (r_idx : ℝ) / (M : ℝ)
    (∑ b : Fin N_Θ, if dyadicRealBin ρ d (θ b).1 = q then (∑ i, π i b) else 0) ≤
      ρ ^ (s * d - κ_err)
  h_norm_mesh : ∀ (r_idx : ℕ), 1 ≤ r_idx → r_idx ≤ M → ∀ q : ℤ,
    letI := Classical.propDecidable
    let d := (r_idx : ℝ) / (M : ℝ)
    (∑ b : Fin N_Θ, if dyadicRealBin ρ d (θ b).2 = q then (∑ i, π i b) else 0) ≤
      ρ ^ (σ * d - κ_err)
  h_param_ball_mesh : ∀ (r_idx : ℕ), 1 ≤ r_idx → r_idx ≤ M → ∀ q : ℤ × ℤ,
    letI := Classical.propDecidable
    let d := (r_idx : ℝ) / (M : ℝ)
    (∑ b : Fin N_Θ, if paramTreeBin ρ d (θ b) = q then (∑ i, π i b) else 0) ≤
      ρ ^ (s * d - κ_err)
  h_param_mesh : ∀ (r₁ r₂ : ℕ), 1 ≤ r₁ → r₁ < r₂ → r₂ ≤ M → ∀ q₁ q₂ : ℤ × ℤ,
    letI := Classical.propDecidable
    let d₁ := (r₁ : ℝ) / (M : ℝ)
    let d₂ := (r₂ : ℝ) / (M : ℝ)
    (∑ b : Fin N_Θ,
      if paramTreeBin ρ d₁ (θ b) = q₁ ∧ paramTreeBin ρ d₂ (θ b) = q₂
      then (∑ i, π i b) else 0) ≤
    ρ ^ (s * (d₂ - d₁) - κ_err) *
      (∑ b : Fin N_Θ, if paramTreeBin ρ d₁ (θ b) = q₁ then (∑ i, π i b) else 0)
  h_param_cap_floor : ∀ (r₁ r₂ : ℕ), 1 ≤ r₁ → r₁ < r₂ → r₂ ≤ M → ∀ b₀ : Fin N_Θ,
    0 < (∑ i, π i b₀) →
      letI := Classical.propDecidable
      let d₁ := (r₁ : ℝ) / (M : ℝ)
      let d₂ := (r₂ : ℝ) / (M : ℝ)
      let q₁ := paramTreeBin ρ d₁ (θ b₀)
      let q₂ := paramTreeBin ρ d₂ (θ b₀)
      ρ ^ (2 * (d₂ - d₁) + κ_err) *
        (∑ b : Fin N_Θ, if paramTreeBin ρ d₁ (θ b) = q₁ then (∑ i, π i b) else 0) ≤
      (∑ b : Fin N_Θ,
        if paramTreeBin ρ d₁ (θ b) = q₁ ∧ paramTreeBin ρ d₂ (θ b) = q₂
        then (∑ i, π i b) else 0)
  h_coord_mesh : ∀ b, 0 < (∑ i, π i b) →
    ∀ (r_idx : ℕ), 1 ≤ r_idx → r_idx ≤ M → ∀ (g : Fin 3) (q : ℤ × ℤ),
      letI := Classical.propDecidable
      let d := (r_idx : ℝ) / (M : ℝ)
      let lam_b := ∑ i, π i b
      (∑ i : Fin N_P,
        if canonicalGroupPrefixTied ρ d (P i) (θ b) g = q
        then π i b / lam_b else 0) ≤ ρ ^ (a_pt g * d - κ_err)
  h_Z_supp_mesh : ∀ b, 0 < (∑ i, π i b) →
    ∀ (r_idx : ℕ), 1 ≤ r_idx → r_idx ≤ M →
      letI := Classical.propDecidable
      let d := (r_idx : ℝ) / (M : ℝ)
      (((Finset.univ.filter (fun i : Fin N_P => 0 < π i b)).image
        (fun i => dyadicRealBin ρ d (canonicalGridMid ρ (canonicalShear4 (P i) (θ b) 3)))).card : ℝ) ≤
        ρ ^ (-a_pt 2 * d - κ_err)
  h_Y_mesh : ∀ b, 0 < (∑ i, π i b) →
    ∀ (r_idx : ℕ), 1 ≤ r_idx → r_idx ≤ M → ∀ q : ℤ,
      letI := Classical.propDecidable
      let d := (r_idx : ℝ) / (M : ℝ)
      let lam_b := ∑ i, π i b
      (∑ i : Fin N_P,
        if dyadicRealBin ρ d (canonicalGridMid ρ (canonicalShear4 (P i) (θ b) 1)) = q
        then π i b / lam_b else 0) ≤ ρ ^ (g_stage d - κ_err)
  h_Y_supp_mesh : ∀ b, 0 < (∑ i, π i b) →
    ∀ (r_idx : ℕ), 1 ≤ r_idx → r_idx ≤ M →
      letI := Classical.propDecidable
      let d := (r_idx : ℝ) / (M : ℝ)
      (((Finset.univ.filter (fun i : Fin N_P => 0 < π i b)).image
        (fun i => dyadicRealBin ρ d (canonicalGridMid ρ (canonicalShear4 (P i) (θ b) 1)))).card : ℝ) ≤
        ρ ^ (-g_stage d - κ_err)
noncomputable def stdApUVec2D (φ : ℝ) : EuclideanSpace ℝ (Fin 2) :=
  WithLp.toLp 2 ![Real.cos φ, Real.sin φ]

noncomputable def stdApPosSupport {N_ω : ℕ} (π : Fin N_ω → ℝ) : Finset (Fin N_ω) :=
  letI := Classical.propDecidable
  Finset.univ.filter (fun ω => 0 < π ω)

noncomputable def stdApRawEntropy {N_ω : ℕ} {α : Type} (ε : ℝ) (π : Fin N_ω → ℝ)
    (X : Fin N_ω → α) : ℝ :=
  (∑ ω ∈ stdApPosSupport π, -(π ω * Real.log (finProbAt π X ω))) / Real.log (ε⁻¹)

noncomputable def stdApIvFinset (ε s x₀ R : ℝ) : Finset ℤ :=
  Finset.Icc ⌊(x₀ - R) * (2 : ℝ) ^ (dyadicRealLevel ε s)⌋
             ⌊(x₀ + R) * (2 : ℝ) ^ (dyadicRealLevel ε s)⌋
noncomputable def isoPrefixCell (ε b_star : ℝ)
    (V_p A_p : EuclideanSpace ℝ (Fin 2)) : ℤ × ℤ × ℤ × ℤ :=
  (dyadicRealBin ε b_star (V_p 0),
   dyadicRealBin ε b_star (V_p 1),
   dyadicRealBin ε b_star (A_p 0),
   dyadicRealBin ε b_star (A_p 1))

noncomputable def isoPrefixCenter (ε b_star : ℝ) (j₀ j₁ : ℤ) :
    EuclideanSpace ℝ (Fin 2) :=
  WithLp.toLp 2
    ![((j₀ : ℝ) + 1 / 2) * dyadicRealStep ε b_star,
      ((j₁ : ℝ) + 1 / 2) * dyadicRealStep ε b_star]

noncomputable def isoPrefixLocalVec (ε b_star : ℝ)
    (center vec : EuclideanSpace ℝ (Fin 2)) : EuclideanSpace ℝ (Fin 2) :=
  ((2 * ε ^ b_star)⁻¹) • (vec - center)
noncomputable def prePointBins (ε m i u' h' : ℝ)
    (V_p A_p : EuclideanSpace ℝ (Fin 2)) (c_s R_s : ℝ) : Fin 4 → ℤ :=
  let C₀ := dyadicTimeMid ε u' c_s
  let R₀ := dyadicRealMid ε (m * u') R_s
  let X₀ := V_p 0
  let Y₀ := A_p 0 + C₀ * X₀
  let W₀ := V_p 1 - R₀ * X₀
  let Z₀ := A_p 1 + C₀ * (V_p 1) - R₀ * Y₀
  let D₀ : Fin 4 → ℝ := ![X₀, Y₀, W₀, Z₀]
  let L₀ : Fin 4 → ℝ := ![i, i + u', i + m * u', i + (1 + m) * u']
  let ρ := ε ^ h'
  fun j => canonicalGridBin ρ (ε ^ (-L₀ j) * (D₀ j - dyadicRealMid ε (L₀ j) (D₀ j)))

noncomputable def advLabelBins (ε m v₁ c_s R_s : ℝ) : ℤ × ℤ :=
  (dyadicTimeBin ε v₁ c_s, dyadicRealBin ε (m * v₁) R_s)

noncomputable def cellThetaOfBins (ε m u' v₁ : ℝ)
    (e : ℤ × ℤ × ℤ × ℤ × ℤ × ℤ) (β : ℤ × ℤ) : ℝ × ℝ :=
  let C₀ := ((e.1 : ℝ) + 1 / 2) * ((2 : ℝ) ^ (dyadicTimeLevel ε u'))⁻¹
  let R₀ := ((e.2.1 : ℝ) + 1 / 2) * dyadicRealStep ε (m * u')
  let C₁ := ((β.1 : ℝ) + 1 / 2) * ((2 : ℝ) ^ (dyadicTimeLevel ε v₁))⁻¹
  let R₁ := ((β.2 : ℝ) + 1 / 2) * dyadicRealStep ε (m * v₁)
  (ε ^ (-u') * (C₁ - C₀), ε ^ (-m * u') * (R₀ - R₁))

noncomputable def gridMidPt4 (ρ : ℝ) (k_vec : Fin 4 → ℤ) : Fin 4 → ℝ :=
  fun j => ((k_vec j : ℝ) + 1 / 2) * ρ

theorem bochner_riesz_conv_representation (δ : ℝ) (hδ : 0 < δ) :
    ∃ B_δ : ℝ, 0 ≤ B_δ ∧
      Continuous (bochnerRieszKernel δ) ∧
      (∀ z : EuclideanSpace ℝ (Fin 3), ‖bochnerRieszKernel δ z‖ ≤ B_δ) ∧
      ∀ f : SchwartzMap (EuclideanSpace ℝ (Fin 3)) ℂ,
        Continuous (bochnerRiesz δ f) ∧
        ∀ x : EuclideanSpace ℝ (Fin 3),
          bochnerRiesz δ f x = spatialConv (bochnerRieszKernel δ) (⇑f) x :=
by
  have hSym_cont : Continuous (bochnerRieszSymbol δ) := by
    unfold bochnerRieszSymbol
    exact ((continuous_const.sub (continuous_norm.pow 2)).max continuous_const).rpow_const
      (fun _ => Or.inr hδ.le)
  have hSym_nonneg : ∀ ξ : EuclideanSpace ℝ (Fin 3), 0 ≤ bochnerRieszSymbol δ ξ := by
    intro ξ
    exact Real.rpow_nonneg (le_max_right (1 - ‖ξ‖ ^ 2) 0) δ
  have hSym_le_one : ∀ ξ : EuclideanSpace ℝ (Fin 3), bochnerRieszSymbol δ ξ ≤ 1 := by
    intro ξ
    refine Real.rpow_le_one (le_max_right _ _) ?_ hδ.le
    exact max_le_iff.mpr ⟨by linarith [sq_nonneg ‖ξ‖], zero_le_one⟩
  have hSym_supp : HasCompactSupport (bochnerRieszSymbol δ) := by
    refine HasCompactSupport.intro (isCompact_closedBall (0 : EuclideanSpace ℝ (Fin 3)) 1) ?_
    intro ξ hξ
    rw [Metric.mem_closedBall, dist_zero_right] at hξ
    have h1 : 1 ≤ ‖ξ‖ := le_of_lt (not_le.mp hξ)
    have hsq : 1 ≤ ‖ξ‖ ^ 2 := by
      calc (1 : ℝ) = 1 ^ 2 := by ring
        _ ≤ ‖ξ‖ ^ 2 := pow_le_pow_left₀ zero_le_one h1 2
    have hmax : max (1 - ‖ξ‖ ^ 2) 0 = 0 := max_eq_right (by linarith)
    unfold bochnerRieszSymbol
    rw [hmax]
    exact Real.zero_rpow (ne_of_gt hδ)
  have hSym_int : MeasureTheory.Integrable (bochnerRieszSymbol δ) MeasureTheory.volume :=
    hSym_cont.integrable_of_hasCompactSupport hSym_supp
  have hexp_norm : ∀ θ : ℝ, ‖Complex.exp (2 * Real.pi * Complex.I * (θ : ℝ))‖ = 1 := by
    intro θ
    have h_eq : (2 * Real.pi * Complex.I * (θ : ℝ) : ℂ) = ↑(2 * Real.pi * θ) * Complex.I := by
      push_cast
      ring
    rw [h_eq]
    exact Complex.norm_exp_ofReal_mul_I (2 * Real.pi * θ)
  have hF_norm : ∀ z ξ : EuclideanSpace ℝ (Fin 3),
      ‖(bochnerRieszSymbol δ ξ : ℂ) *
        Complex.exp (2 * Real.pi * Complex.I * (inner ℝ z ξ : ℝ))‖ =
      bochnerRieszSymbol δ ξ := by
    intro z ξ
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hSym_nonneg ξ),
      hexp_norm (inner ℝ z ξ), mul_one]
  let B_δ : ℝ := ∫ ξ : EuclideanSpace ℝ (Fin 3), bochnerRieszSymbol δ ξ
  have hB_nonneg : 0 ≤ B_δ := MeasureTheory.integral_nonneg hSym_nonneg
  have hK_cont : Continuous (bochnerRieszKernel δ) := by
    unfold bochnerRieszKernel
    refine MeasureTheory.continuous_of_dominated (bound := bochnerRieszSymbol δ) ?_ ?_ hSym_int ?_
    · intro z
      refine Continuous.aestronglyMeasurable ?_
      exact (Complex.continuous_ofReal.comp hSym_cont).mul
        (Complex.continuous_exp.comp
          (continuous_const.mul (Complex.continuous_ofReal.comp
            (Continuous.inner (𝕜 := ℝ) continuous_const continuous_id))))
    · intro z
      exact Filter.Eventually.of_forall (fun ξ => (hF_norm z ξ).le)
    · refine Filter.Eventually.of_forall (fun ξ => ?_)
      exact continuous_const.mul
        (Complex.continuous_exp.comp
          (continuous_const.mul (Complex.continuous_ofReal.comp
            (Continuous.inner (𝕜 := ℝ) continuous_id continuous_const))))
  have hK_bound : ∀ z : EuclideanSpace ℝ (Fin 3), ‖bochnerRieszKernel δ z‖ ≤ B_δ := by
    intro z
    unfold bochnerRieszKernel
    exact MeasureTheory.norm_integral_le_of_norm_le hSym_int
      (Filter.Eventually.of_forall (fun ξ => (hF_norm z ξ).le))
  refine ⟨B_δ, hB_nonneg, hK_cont, hK_bound, fun f => ?_⟩
  have hG_norm : ∀ x ξ : EuclideanSpace ℝ (Fin 3),
      ‖(bochnerRieszSymbol δ ξ : ℂ) * FourierTransform.fourier f ξ *
        Complex.exp (2 * Real.pi * Complex.I * (inner ℝ x ξ : ℝ))‖ ≤
      ‖FourierTransform.fourier f ξ‖ := by
    intro x ξ
    rw [norm_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hSym_nonneg ξ),
      hexp_norm (inner ℝ x ξ), mul_one]
    exact mul_le_of_le_one_left (norm_nonneg _) (hSym_le_one ξ)
  have hBR_cont : Continuous (bochnerRiesz δ f) := by
    unfold bochnerRiesz
    refine MeasureTheory.continuous_of_dominated
      (bound := fun ξ => ‖FourierTransform.fourier f ξ‖) ?_ ?_
      (FourierTransform.fourier f).integrable.norm ?_
    · intro x
      refine Continuous.aestronglyMeasurable ?_
      exact ((Complex.continuous_ofReal.comp hSym_cont).mul (FourierTransform.fourier f).continuous).mul
        (Complex.continuous_exp.comp
          (continuous_const.mul (Complex.continuous_ofReal.comp
            (Continuous.inner (𝕜 := ℝ) continuous_const continuous_id))))
    · intro x
      exact Filter.Eventually.of_forall (fun ξ => hG_norm x ξ)
    · refine Filter.Eventually.of_forall (fun ξ => ?_)
      exact continuous_const.mul
        (Complex.continuous_exp.comp
          (continuous_const.mul (Complex.continuous_ofReal.comp
            (Continuous.inner (𝕜 := ℝ) continuous_id continuous_const))))
  refine ⟨hBR_cont, fun x => ?_⟩
  let H : EuclideanSpace ℝ (Fin 3) → EuclideanSpace ℝ (Fin 3) → ℂ :=
    fun ξ y =>
      ((bochnerRieszSymbol δ ξ : ℂ) *
        Complex.exp (2 * Real.pi * Complex.I * (inner ℝ (x - y) ξ : ℝ))) * f y
  have h_inner_eq : ∀ ξ : EuclideanSpace ℝ (Fin 3),
      (bochnerRieszSymbol δ ξ : ℂ) * FourierTransform.fourier f ξ *
        Complex.exp (2 * Real.pi * Complex.I * (inner ℝ x ξ : ℝ)) =
      ∫ y : EuclideanSpace ℝ (Fin 3), H ξ y := by
    intro ξ
    have hfhat : FourierTransform.fourier f ξ =
        ∫ y : EuclideanSpace ℝ (Fin 3),
          Complex.exp (↑(-2 * Real.pi * inner ℝ y ξ) * Complex.I) * f y := by
      rw [congr_fun (SchwartzMap.fourier_coe f) ξ, Real.fourier_eq']
      simp only [smul_eq_mul]
    rw [hfhat, ← MeasureTheory.integral_const_mul, ← MeasureTheory.integral_mul_const]
    congr 1
    ext y
    have hexp_comb :
        Complex.exp (↑(-2 * Real.pi * inner ℝ y ξ) * Complex.I) *
          Complex.exp (2 * Real.pi * Complex.I * (inner ℝ x ξ : ℝ)) =
        Complex.exp (2 * Real.pi * Complex.I * (inner ℝ (x - y) ξ : ℝ)) := by
      rw [← Complex.exp_add]
      congr 1
      rw [inner_sub_left]
      push_cast
      ring
    dsimp only [H]
    calc ((bochnerRieszSymbol δ ξ : ℂ) *
          (Complex.exp (↑(-2 * Real.pi * inner ℝ y ξ) * Complex.I) * f y)) *
          Complex.exp (2 * Real.pi * Complex.I * (inner ℝ x ξ : ℝ))
        = ((bochnerRieszSymbol δ ξ : ℂ) *
            (Complex.exp (↑(-2 * Real.pi * inner ℝ y ξ) * Complex.I) *
              Complex.exp (2 * Real.pi * Complex.I * (inner ℝ x ξ : ℝ)))) * f y := by ring
      _ = ((bochnerRieszSymbol δ ξ : ℂ) *
            Complex.exp (2 * Real.pi * Complex.I * (inner ℝ (x - y) ξ : ℝ))) * f y := by
          rw [hexp_comb]
  have hH_int : MeasureTheory.Integrable (Function.uncurry H)
      (MeasureTheory.volume.prod MeasureTheory.volume) := by
    refine (hSym_int.mul_prod f.integrable.norm).mono' ?_ ?_
    · refine Continuous.aestronglyMeasurable ?_
      change Continuous (fun p : EuclideanSpace ℝ (Fin 3) × EuclideanSpace ℝ (Fin 3) =>
        ((bochnerRieszSymbol δ p.1 : ℂ) *
          Complex.exp (2 * Real.pi * Complex.I * (inner ℝ (x - p.2) p.1 : ℝ))) * f p.2)
      exact ((Complex.continuous_ofReal.comp (hSym_cont.comp continuous_fst)).mul
        (Complex.continuous_exp.comp
          (continuous_const.mul (Complex.continuous_ofReal.comp
            (Continuous.inner (𝕜 := ℝ) (continuous_const.sub continuous_snd) continuous_fst))))).mul
        (f.continuous.comp continuous_snd)
    · refine Filter.Eventually.of_forall (fun p => ?_)
      change ‖((bochnerRieszSymbol δ p.1 : ℂ) *
        Complex.exp (2 * Real.pi * Complex.I * (inner ℝ (x - p.2) p.1 : ℝ))) * f p.2‖ ≤
        bochnerRieszSymbol δ p.1 * ‖f p.2‖
      rw [norm_mul, hF_norm (x - p.2) p.1]
  unfold bochnerRiesz spatialConv
  simp_rw [h_inner_eq]
  rw [MeasureTheory.integral_integral_swap hH_int]
  congr 1
  ext y
  change ∫ ξ : EuclideanSpace ℝ (Fin 3),
      ((bochnerRieszSymbol δ ξ : ℂ) *
        Complex.exp (2 * Real.pi * Complex.I * (inner ℝ (x - y) ξ : ℝ))) * f y =
    bochnerRieszKernel δ (x - y) * f y
  rw [MeasureTheory.integral_mul_const]
  rfl

theorem bochner_riesz_kernel_dyadic_decomp (δ : ℝ) (hδ : 0 < δ) :
    ∃ (K₀ : EuclideanSpace ℝ (Fin 3) → ℂ)
      (a_pos a_neg : ℕ → EuclideanSpace ℝ (Fin 3) → ℂ)
      (M : ℕ → ℝ)
      (Φ : ℕ → EuclideanSpace ℝ (Fin 3) → ℝ),
      Continuous K₀ ∧
      (∀ z : EuclideanSpace ℝ (Fin 3), 2 ≤ ‖z‖ → K₀ z = 0) ∧
      (∀ j : ℕ, (∀ k : ℕ, ContDiff ℝ k (a_pos j)) ∧ (∀ k : ℕ, ContDiff ℝ k (a_neg j))) ∧
      (∀ j : ℕ, ∀ w : EuclideanSpace ℝ (Fin 3),
        (‖w‖ ≤ 1 / 2 ∨ 2 ≤ ‖w‖) → a_pos j w = 0 ∧ a_neg j w = 0) ∧
      (∀ j k : ℕ, ∀ w : EuclideanSpace ℝ (Fin 3),
        ‖iteratedFDeriv ℝ k (a_pos j) w‖ ≤ M k ∧ ‖iteratedFDeriv ℝ k (a_neg j) w‖ ≤ M k) ∧
      (∀ N : ℕ,
        Continuous (Φ N) ∧
        (∀ z : EuclideanSpace ℝ (Fin 3), 0 ≤ Φ N z ∧ Φ N z ≤ 1) ∧
        (∀ z : EuclideanSpace ℝ (Fin 3), ‖z‖ ≤ (2 : ℝ) ^ N → Φ N z = 1) ∧
        (∀ z : EuclideanSpace ℝ (Fin 3),
          bochnerRieszKernel δ z * (Φ N z : ℂ) =
            K₀ z + ∑ j ∈ Finset.range N,
              (shellOscKernel δ 1 ((2 : ℝ) ^ (j + 1)) (a_pos j) z +
                shellOscKernel δ (-1) ((2 : ℝ) ^ (j + 1)) (a_neg j) z))) :=
by
  have h_s1 :
      Continuous (bochnerRieszKernel δ) ∧
      ∀ z : EuclideanSpace ℝ (Fin 3),
        bochnerRieszKernel δ z =
          ((Real.pi / (δ + 1) : ℝ) : ℂ) *
            ∫ s in (-1 : ℝ)..1,
              (((1 - s ^ 2) ^ (1 + δ) : ℝ) : ℂ) *
                Complex.exp (2 * Real.pi * Complex.I * ((‖z‖ * s : ℝ) : ℂ)) := by
    let e₀ : EuclideanSpace ℝ (Fin 3) := EuclideanSpace.single 0 1
    have he₀_sq : ‖e₀‖ ^ 2 = 1 := by
      rw [EuclideanSpace.norm_sq_eq]
      simp [e₀, PiLp.single_apply]
    have he₀_norm : ‖e₀‖ = 1 := by
      nlinarith [norm_nonneg e₀]
    have h_align : ∀ z : EuclideanSpace ℝ (Fin 3),
        bochnerRieszKernel δ z = bochnerRieszKernel δ (‖z‖ • e₀) := by
      intro z
      by_cases hz : z = 0
      · subst hz; simp
      · have hR : 0 < ‖z‖ := norm_pos_iff.mpr hz
        let u : EuclideanSpace ℝ (Fin 3) := ‖z‖⁻¹ • z
        have hu_norm : ‖u‖ = 1 := by
          rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hR), inv_mul_cancel₀ hR.ne']
        have hz_eq : z = ‖z‖ • u := by
          simp [u, smul_smul, hR.ne']
        have hexU : ∃ U : EuclideanSpace ℝ (Fin 3) ≃ₗᵢ[ℝ] EuclideanSpace ℝ (Fin 3), U e₀ = u := by
          by_cases huv : u + e₀ = 0
          · refine ⟨LinearIsometryEquiv.neg ℝ, ?_⟩
            simp [eq_neg_of_add_eq_zero_left huv]
          · let v : EuclideanSpace ℝ (Fin 3) := u + e₀
            refine ⟨(ℝ ∙ v).reflection, ?_⟩
            rw [Submodule.reflection_singleton_apply]
            simp only [RCLike.ofReal_real_eq_id, id_eq]
            have hv_pos : 0 < ‖v‖ ^ 2 := sq_pos_of_pos (norm_pos_iff.mpr huv)
            have hv_sq : ‖v‖ ^ 2 = 2 * inner ℝ v e₀ := by
              have h1 := norm_add_sq_real u e₀
              have h2 : inner ℝ v e₀ = inner ℝ u e₀ + 1 := by
                rw [show v = u + e₀ from rfl, inner_add_left, real_inner_self_eq_norm_sq, he₀_norm]
                norm_num
              rw [hu_norm, he₀_norm] at h1
              linarith
            have h_div : inner ℝ v e₀ / ‖v‖ ^ 2 = (1 / 2 : ℝ) := by
              rw [hv_sq]
              have hne : inner ℝ v e₀ ≠ 0 := by
                intro h0
                rw [h0, mul_zero] at hv_sq
                linarith
              field_simp [hne]
            rw [h_div, two_smul, ← add_smul]
            norm_num
            simp [v]
        obtain ⟨U, hU⟩ := hexU
        have hmp : MeasureTheory.MeasurePreserving U.toHomeomorph.toMeasurableEquiv
            MeasureTheory.volume MeasureTheory.volume := U.measurePreserving
        unfold bochnerRieszKernel
        rw [← hmp.integral_comp']
        congr 1
        ext ξ
        have h_sym : bochnerRieszSymbol δ (U ξ) = bochnerRieszSymbol δ ξ := by
          simp [bochnerRieszSymbol, U.norm_map]
        have h_inn : inner ℝ z (U ξ) = inner ℝ (‖z‖ • e₀) ξ := by
          calc inner ℝ z (U ξ)
              = inner ℝ (U (‖z‖ • e₀)) (U ξ) := by rw [map_smul, hU, ← hz_eq]
            _ = inner ℝ (‖z‖ • e₀) ξ := U.inner_map_map _ _
        change (bochnerRieszSymbol δ (U ξ) : ℂ) *
            Complex.exp (2 * Real.pi * Complex.I * ((inner ℝ z (U ξ) : ℝ) : ℂ)) = _
        rw [h_sym, h_inn]
    have h_disk : ∀ A : ℝ, 0 ≤ A →
        (∫ p : ℝ × ℝ, (max (A - (p.1 ^ 2 + p.2 ^ 2)) 0) ^ δ) =
          (Real.pi / (δ + 1)) * A ^ (1 + δ) := by
      intro A hA
      rcases eq_or_lt_of_le hA with rfl | hA_pos
      · have hzero : (fun p : ℝ × ℝ => (max (0 - (p.1 ^ 2 + p.2 ^ 2)) 0) ^ δ) = fun _ => 0 := by
          ext p
          have hle : 0 - (p.1 ^ 2 + p.2 ^ 2) ≤ 0 := by nlinarith [sq_nonneg p.1, sq_nonneg p.2]
          rw [max_eq_right hle, Real.zero_rpow hδ.ne']
        rw [hzero, MeasureTheory.integral_const, smul_zero,
          Real.zero_rpow (by linarith : 1 + δ ≠ 0), mul_zero]
      · rw [← integral_comp_polarCoord_symm]
        rw [polarCoord_target]
        let g_rad : ℝ → ℝ := fun r => r * (max (A - r ^ 2) 0) ^ δ
        let g_ang : ℝ → ℝ := fun _ => 1
        have h_prod : (∫ p in Set.Ioi (0 : ℝ) ×ˢ Set.Ioo (-Real.pi) Real.pi,
            p.1 • (max (A - ((polarCoord.symm p).1 ^ 2 + (polarCoord.symm p).2 ^ 2)) 0) ^ δ) =
          (∫ p in Set.Ioi (0 : ℝ) ×ˢ Set.Ioo (-Real.pi) Real.pi,
            g_rad p.1 * g_ang p.2) := by
          refine MeasureTheory.setIntegral_congr_fun
            (measurableSet_Ioi.prod measurableSet_Ioo) (fun p _ => ?_)
          simp only [polarCoord_symm_apply, smul_eq_mul, g_rad, g_ang, mul_one]
          have htrig : (p.1 * Real.cos p.2) ^ 2 + (p.1 * Real.sin p.2) ^ 2 = p.1 ^ 2 := by
            calc (p.1 * Real.cos p.2) ^ 2 + (p.1 * Real.sin p.2) ^ 2
                = p.1 ^ 2 * (Real.cos p.2 ^ 2 + Real.sin p.2 ^ 2) := by ring
              _ = p.1 ^ 2 * 1 := by rw [Real.cos_sq_add_sin_sq]
              _ = p.1 ^ 2 := mul_one _
          rw [htrig]
        rw [h_prod]
        erw [MeasureTheory.setIntegral_prod_mul g_rad g_ang]
        have h_theta : (∫ _θ in Set.Ioo (-Real.pi) Real.pi, g_ang _θ) = 2 * Real.pi := by
          simp only [g_ang]
          rw [MeasureTheory.setIntegral_const, smul_eq_mul, mul_one,
            MeasureTheory.Measure.real, Real.volume_Ioo,
            ENNReal.toReal_ofReal (by linarith [Real.pi_pos])]
          ring
        rw [h_theta]
        have h_rad_supp : (∫ r in Set.Ioi (0 : ℝ), g_rad r) =
            ∫ r in Set.Ioc (0 : ℝ) (Real.sqrt A), g_rad r := by
          refine MeasureTheory.setIntegral_eq_of_subset_of_ae_sdiff_eq_zero
            measurableSet_Ioi.nullMeasurableSet Set.Ioc_subset_Ioi_self ?_
          refine Filter.Eventually.of_forall (fun r hr => ?_)
          have hr0 : 0 < r := hr.1
          have hrA : Real.sqrt A < r := not_le.mp (fun hle => hr.2 ⟨hr0, hle⟩)
          have hsq : A < r ^ 2 := by
            calc A = (Real.sqrt A) ^ 2 := (Real.sq_sqrt hA_pos.le).symm
              _ < r ^ 2 := sq_lt_sq' (by linarith [Real.sqrt_nonneg A]) hrA
          simp only [g_rad]
          rw [max_eq_right (by linarith), Real.zero_rpow hδ.ne', mul_zero]
        rw [h_rad_supp, ← intervalIntegral.integral_of_le (Real.sqrt_nonneg A)]
        have h_rad_congr : (∫ r in (0 : ℝ)..Real.sqrt A, g_rad r) =
            ∫ r in (0 : ℝ)..Real.sqrt A, r * (A - r ^ 2) ^ δ := by
          refine intervalIntegral.integral_congr (fun r hr => ?_)
          rw [Set.uIcc_of_le (Real.sqrt_nonneg A)] at hr
          have hsq : r ^ 2 ≤ A := by
            calc r ^ 2 ≤ (Real.sqrt A) ^ 2 := sq_le_sq' (by linarith [hr.1, Real.sqrt_nonneg A]) hr.2
              _ = A := Real.sq_sqrt hA_pos.le
          simp only [g_rad, max_eq_left (by linarith : 0 ≤ A - r ^ 2)]
        rw [h_rad_congr]
        let F : ℝ → ℝ := fun r => -(1 / (2 * (δ + 1))) * (A - r ^ 2) ^ (1 + δ)
        have hF_deriv : ∀ r ∈ Set.uIcc (0 : ℝ) (Real.sqrt A),
            HasDerivAt F (r * (A - r ^ 2) ^ δ) r := by
          intro r _
          have h1 : HasDerivAt (fun x : ℝ => A - x ^ 2) (0 - 2 * r ^ (2 - 1)) r :=
            (hasDerivAt_const r A).sub (hasDerivAt_pow 2 r)
          have h2 : HasDerivAt (fun u : ℝ => u ^ (1 + δ))
              ((1 + δ) * (A - r ^ 2) ^ (1 + δ - 1)) (A - r ^ 2) :=
            Real.hasDerivAt_rpow_const (Or.inr (by linarith))
          have h3 := (h2.comp r h1).const_mul (-(1 / (2 * (δ + 1))))
          exact h3.congr_deriv (by
            have hne : δ + 1 ≠ 0 := by linarith
            have hexp : 1 + δ - 1 = δ := by ring
            rw [hexp]
            field_simp [hne]
            ring)
        have h_int : IntervalIntegrable (fun r : ℝ => r * (A - r ^ 2) ^ δ)
            MeasureTheory.volume 0 (Real.sqrt A) := by
          refine ContinuousOn.intervalIntegrable ?_
          rw [Set.uIcc_of_le (Real.sqrt_nonneg A)]
          exact continuousOn_id.mul
            ((continuousOn_const.sub (continuousOn_pow 2)).rpow_const
              (fun _ _ => Or.inr hδ.le))
        rw [intervalIntegral.integral_eq_sub_of_hasDerivAt hF_deriv h_int]
        simp only [F]
        have h0sq : (0 : ℝ) ^ 2 = 0 := by norm_num
        rw [Real.sq_sqrt hA_pos.le, h0sq, sub_self, sub_zero,
          Real.zero_rpow (by linarith : 1 + δ ≠ 0)]
        have hne : δ + 1 ≠ 0 := by linarith
        field_simp [hne]
        ring
    have h_slice : ∀ R : ℝ,
        bochnerRieszKernel δ (R • e₀) =
          ((Real.pi / (δ + 1) : ℝ) : ℂ) *
            ∫ s in (-1 : ℝ)..1,
              (((1 - s ^ 2) ^ (1 + δ) : ℝ) : ℂ) *
