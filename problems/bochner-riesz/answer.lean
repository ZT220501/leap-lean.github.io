        calc (1 : ℝ) = ρ⁻¹ * ρ := (inv_mul_cancel₀ hρ_pos.ne').symm
          _ ≤ ρ⁻¹ * |u - u₀| := mul_le_mul_of_nonneg_left hu hρ_inv_pos.le
      obtain ⟨h0, hd0⟩ := hχ_supp _ h1
      have hF0 : ∀ i : ℝ, F i u = 0 := fun i => by simp [F, h0, hd0]
      simp [hF0]
    have h_u_split1 := intervalIntegral.integral_add_adjacent_intervals
      (hG_ii δ (u₀ - ρ)) (hG_ii (u₀ - ρ) (1 - δ))
    have h_u_split2 := intervalIntegral.integral_add_adjacent_intervals
      (hG_ii (u₀ - ρ) (u₀ + ρ)) (hG_ii (u₀ + ρ) (1 - δ))
    have h_u_left : (∫ u in δ..(u₀ - ρ), ∫ i in (-K)..K, F i u) = 0 := by
      have h_le : δ ≤ u₀ - ρ := by
        have : 4 * δ ≤ u₀ := by dsimp [δ]; linarith
        linarith
      refine (intervalIntegral.integral_congr (g := fun _ => (0 : ℝ)) (fun u hu => ?_)).trans
        intervalIntegral.integral_zero
      rw [Set.uIcc_of_le h_le] at hu
      exact hG_zero_u u ((by linarith [hu.2] : ρ ≤ -(u - u₀)).trans (neg_le_abs _))
    have h_u_right : (∫ u in (u₀ + ρ)..(1 - δ), ∫ i in (-K)..K, F i u) = 0 := by
      have h_le : u₀ + ρ ≤ 1 - δ := by
        have : 4 * δ ≤ 1 - u₀ := by dsimp [δ]; linarith
        linarith
      refine (intervalIntegral.integral_congr (g := fun _ => (0 : ℝ)) (fun u hu => ?_)).trans
        intervalIntegral.integral_zero
      rw [Set.uIcc_of_le h_le] at hu
      exact hG_zero_u u ((by linarith [hu.1] : ρ ≤ u - u₀).trans (le_abs_self _))
    have h_mid_u_nn : 0 ≤ ∫ u in (u₀ - ρ)..(u₀ + ρ), ∫ i in (-K)..K, F i u := by
      linarith

    let K_a : ℝ → ℝ → ℝ := fun u w =>
      (p - c_top) * deriv χ (ρ⁻¹ * w) * χ (ρ⁻¹ * (u - u₀)) +
        χ (ρ⁻¹ * w) * deriv χ (ρ⁻¹ * (u - u₀))
    let K_D : ℝ → ℝ → ℝ := fun u w =>
      deriv χ (ρ⁻¹ * w) * χ (ρ⁻¹ * (u - u₀))
    let Φ_orig : ℝ → ℝ → ℝ := fun u w =>
      -a_top (b₀ - p * (u - u₀) + w, u) * K_a u w + D (b₀ - p * (u - u₀) + w, u) * K_D u w

    have h_inner_eq : ∀ u ∈ Set.uIcc (u₀ - ρ) (u₀ + ρ),
        (∫ i in (-K)..K, F i u) = ρ⁻¹ ^ 2 * ∫ w in (-ρ)..ρ, Φ_orig u w := by
      intro u hu
      rw [Set.uIcc_of_le (by linarith : u₀ - ρ ≤ u₀ + ρ)] at hu
      have hu_abs : |u - u₀| ≤ ρ := abs_le.mpr ⟨by linarith [hu.1], by linarith [hu.2]⟩
      let c_u : ℝ := b₀ - p * (u - u₀)
      have hcu_abs : |c_u| ≤ |b₀| + |p| := by
        dsimp [c_u]
        calc |b₀ - p * (u - u₀)| ≤ |b₀| + |p * (u - u₀)| := abs_sub _ _
          _ = |b₀| + |p| * |u - u₀| := by rw [abs_mul]
          _ ≤ |b₀| + |p| * 1 := add_le_add le_rfl
              (mul_le_mul_of_nonneg_left (by linarith) (abs_nonneg p))
          _ = |b₀| + |p| := by ring
      obtain ⟨hcu1, hcu2⟩ := abs_le.mp hcu_abs
      have h_i_split1 := intervalIntegral.integral_add_adjacent_intervals
        (hF_ii_i u (-K) (c_u - ρ)) (hF_ii_i u (c_u - ρ) K)
      have h_i_split2 := intervalIntegral.integral_add_adjacent_intervals
        (hF_ii_i u (c_u - ρ) (c_u + ρ)) (hF_ii_i u (c_u + ρ) K)
      have hF_zero_i : ∀ i : ℝ, ρ ≤ |i - c_u| → F i u = 0 := by
        intro i hi
        have hr_eq : i - b₀ + p * (u - u₀) = i - c_u := by dsimp [c_u]; ring
        have h1 : 1 ≤ |ρ⁻¹ * (i - b₀ + p * (u - u₀))| := by
          rw [hr_eq, abs_mul, abs_of_pos hρ_inv_pos]
          calc (1 : ℝ) = ρ⁻¹ * ρ := (inv_mul_cancel₀ hρ_pos.ne').symm
            _ ≤ ρ⁻¹ * |i - c_u| := mul_le_mul_of_nonneg_left hi hρ_inv_pos.le
        obtain ⟨h0, hd0⟩ := hχ_supp _ h1
        simp [F, h0, hd0]
      have h_i_left : (∫ i in (-K)..(c_u - ρ), F i u) = 0 := by
        have h_le : -K ≤ c_u - ρ := by linarith
        refine (intervalIntegral.integral_congr (g := fun _ => (0 : ℝ)) (fun i hi => ?_)).trans
          intervalIntegral.integral_zero
        rw [Set.uIcc_of_le h_le] at hi
        exact hF_zero_i i ((by linarith [hi.2] : ρ ≤ -(i - c_u)).trans (neg_le_abs _))
      have h_i_right : (∫ i in (c_u + ρ)..K, F i u) = 0 := by
        have h_le : c_u + ρ ≤ K := by linarith
        refine (intervalIntegral.integral_congr (g := fun _ => (0 : ℝ)) (fun i hi => ?_)).trans
          intervalIntegral.integral_zero
        rw [Set.uIcc_of_le h_le] at hi
        exact hF_zero_i i ((by linarith [hi.1] : ρ ≤ i - c_u).trans (le_abs_self _))
      have h_trunc : (∫ i in (-K)..K, F i u) = ∫ i in (c_u - ρ)..(c_u + ρ), F i u := by
        linarith
      rw [h_trunc]
      have h_shift := intervalIntegral.integral_comp_add_right (fun i => F i u) c_u
        (a := -ρ) (b := ρ)
      have he1 : -ρ + c_u = c_u - ρ := by ring
      have he2 : ρ + c_u = c_u + ρ := by ring
      rw [he1, he2] at h_shift
      rw [← h_shift]
      have h_fn_eq : (fun w : ℝ => F (w + c_u) u) = (fun w : ℝ => ρ⁻¹ ^ 2 * Φ_orig u w) := by
        ext w
        have hw1 : w + c_u = b₀ - p * (u - u₀) + w := by dsimp [c_u]; ring
        have hw2 : (w + c_u) - b₀ + p * (u - u₀) = w := by dsimp [c_u]; ring
        dsimp only [F, Φ_orig, K_a, K_D]
        rw [hw2, hw1]
      rw [h_fn_eq, intervalIntegral.integral_const_mul]

    have hJ_nn : 0 ≤ ρ⁻¹ ^ 2 * ∫ u in (u₀ - ρ)..(u₀ + ρ), ∫ w in (-ρ)..ρ, Φ_orig u w := by
      have h_congr := intervalIntegral.integral_congr (μ := MeasureTheory.volume) h_inner_eq
      rw [intervalIntegral.integral_const_mul] at h_congr
      linarith

    
    have h_shear_m : Measurable (fun uw : ℝ × ℝ => (b₀ - p * (uw.1 - u₀) + uw.2, uw.1)) :=
      (((measurable_const.sub (measurable_const.mul (measurable_fst.sub measurable_const))).add
        measurable_snd).prodMk measurable_fst)
    have hKa_m : Measurable (fun uw : ℝ × ℝ => K_a uw.1 uw.2) :=
      ((measurable_const.mul (hχ'_cont.measurable.comp (measurable_const.mul measurable_snd))).mul
        (hχ_cont.measurable.comp (measurable_const.mul (measurable_fst.sub measurable_const)))).add
      ((hχ_cont.measurable.comp (measurable_const.mul measurable_snd)).mul
        (hχ'_cont.measurable.comp (measurable_const.mul (measurable_fst.sub measurable_const))))
    have hKD_m : Measurable (fun uw : ℝ × ℝ => K_D uw.1 uw.2) :=
      (hχ'_cont.measurable.comp (measurable_const.mul measurable_snd)).mul
        (hχ_cont.measurable.comp (measurable_const.mul (measurable_fst.sub measurable_const)))
    have hΦ_m : Measurable (fun uw : ℝ × ℝ => Φ_orig uw.1 uw.2) :=
      ((ha_meas.comp h_shear_m).neg.mul hKa_m).add ((hD_meas.comp h_shear_m).mul hKD_m)
    have hΦ_bd : ∀ uw : ℝ × ℝ, |Φ_orig uw.1 uw.2| ≤ M * C_a + M * C_D := by
      intro ⟨u, w⟩
      obtain ⟨hk1, hk2⟩ := hK_ker_bds (ρ⁻¹ * w) (ρ⁻¹ * (u - u₀))
      dsimp only [Φ_orig, K_a, K_D]
      calc |-a_top (b₀ - p * (u - u₀) + w, u) *
              ((p - c_top) * deriv χ (ρ⁻¹ * w) * χ (ρ⁻¹ * (u - u₀)) +
                χ (ρ⁻¹ * w) * deriv χ (ρ⁻¹ * (u - u₀))) +
            D (b₀ - p * (u - u₀) + w, u) * (deriv χ (ρ⁻¹ * w) * χ (ρ⁻¹ * (u - u₀)))|
          ≤ |a_top (b₀ - p * (u - u₀) + w, u)| *
              |(p - c_top) * deriv χ (ρ⁻¹ * w) * χ (ρ⁻¹ * (u - u₀)) +
                χ (ρ⁻¹ * w) * deriv χ (ρ⁻¹ * (u - u₀))| +
            |D (b₀ - p * (u - u₀) + w, u)| *
              |deriv χ (ρ⁻¹ * w) * χ (ρ⁻¹ * (u - u₀))| := by
            refine (abs_add_le _ _).trans ?_
            rw [abs_mul, abs_neg, abs_mul]
        _ ≤ M * C_a + M * C_D := add_le_add
            (mul_le_mul (ha_abs _) hk1 (abs_nonneg _) hM)
            (mul_le_mul (hD_abs _) hk2 (abs_nonneg _) hM)

    let Φ_up : ℝ → ℝ → ℝ → ℝ → ℝ := fun z_s D_s u w =>
      (-z_s * K_a u w + D_s * K_D u w) +
        (C_a * |a_top (b₀ - p * (u - u₀) + w, u) - z_s| +
          C_D * |D (b₀ - p * (u - u₀) + w, u) - D_s|)
    have hΦ_le_up : ∀ z_s D_s u w : ℝ, Φ_orig u w ≤ Φ_up z_s D_s u w := by
      intro z_s D_s u w
      obtain ⟨hk1, hk2⟩ := hK_ker_bds (ρ⁻¹ * w) (ρ⁻¹ * (u - u₀))
      have h_id : Φ_orig u w - (-z_s * K_a u w + D_s * K_D u w) =
          -(a_top (b₀ - p * (u - u₀) + w, u) - z_s) * K_a u w +
            (D (b₀ - p * (u - u₀) + w, u) - D_s) * K_D u w := by
        dsimp only [Φ_orig]; ring
      have h_diff_le : -(a_top (b₀ - p * (u - u₀) + w, u) - z_s) * K_a u w +
            (D (b₀ - p * (u - u₀) + w, u) - D_s) * K_D u w ≤
          C_a * |a_top (b₀ - p * (u - u₀) + w, u) - z_s| +
            C_D * |D (b₀ - p * (u - u₀) + w, u) - D_s| := by
        calc -(a_top (b₀ - p * (u - u₀) + w, u) - z_s) * K_a u w +
              (D (b₀ - p * (u - u₀) + w, u) - D_s) * K_D u w
            ≤ |-(a_top (b₀ - p * (u - u₀) + w, u) - z_s) * K_a u w +
                (D (b₀ - p * (u - u₀) + w, u) - D_s) * K_D u w| := le_abs_self _
          _ ≤ |a_top (b₀ - p * (u - u₀) + w, u) - z_s| * |K_a u w| +
                |D (b₀ - p * (u - u₀) + w, u) - D_s| * |K_D u w| := by
              refine (abs_add_le _ _).trans ?_
              rw [abs_mul, abs_neg, abs_mul]
          _ ≤ |a_top (b₀ - p * (u - u₀) + w, u) - z_s| * C_a +
                |D (b₀ - p * (u - u₀) + w, u) - D_s| * C_D := add_le_add
              (mul_le_mul_of_nonneg_left hk1 (abs_nonneg _))
              (mul_le_mul_of_nonneg_left hk2 (abs_nonneg _))
          _ = C_a * |a_top (b₀ - p * (u - u₀) + w, u) - z_s| +
                C_D * |D (b₀ - p * (u - u₀) + w, u) - D_s| := by ring
      dsimp only [Φ_up]
      linarith

    have h_cst_m : ∀ z_s D_s : ℝ,
        Measurable (fun uw : ℝ × ℝ => -z_s * K_a uw.1 uw.2 + D_s * K_D uw.1 uw.2) :=
      fun z_s D_s => (measurable_const.mul hKa_m).add (measurable_const.mul hKD_m)
    have h_cst_bd : ∀ (z_s D_s : ℝ) (uw : ℝ × ℝ),
        |-z_s * K_a uw.1 uw.2 + D_s * K_D uw.1 uw.2| ≤ |z_s| * C_a + |D_s| * C_D := by
      intro z_s D_s ⟨u, w⟩
      obtain ⟨hk1, hk2⟩ := hK_ker_bds (ρ⁻¹ * w) (ρ⁻¹ * (u - u₀))
      calc |-z_s * K_a u w + D_s * K_D u w|
          ≤ |z_s| * |K_a u w| + |D_s| * |K_D u w| := by
            refine (abs_add_le _ _).trans ?_
            rw [abs_mul, abs_neg, abs_mul]
        _ ≤ |z_s| * C_a + |D_s| * C_D := add_le_add
            (mul_le_mul_of_nonneg_left hk1 (abs_nonneg _))
            (mul_le_mul_of_nonneg_left hk2 (abs_nonneg _))
    have h_err_a_m : ∀ z_s : ℝ,
        Measurable (fun uw : ℝ × ℝ => |a_top (b₀ - p * (uw.1 - u₀) + uw.2, uw.1) - z_s|) :=
      fun z_s => continuous_abs.measurable.comp ((ha_meas.comp h_shear_m).sub measurable_const)
    have h_err_a_bd : ∀ (z_s : ℝ) (uw : ℝ × ℝ),
        |(|a_top (b₀ - p * (uw.1 - u₀) + uw.2, uw.1) - z_s|)| ≤ M + |z_s| := by
      intro z_s ⟨u, w⟩
      rw [abs_abs]
      exact (abs_sub _ _).trans (add_le_add (ha_abs _) le_rfl)
    have h_err_D_m : ∀ D_s : ℝ,
        Measurable (fun uw : ℝ × ℝ => |D (b₀ - p * (uw.1 - u₀) + uw.2, uw.1) - D_s|) :=
      fun D_s => continuous_abs.measurable.comp ((hD_meas.comp h_shear_m).sub measurable_const)
    have h_err_D_bd : ∀ (D_s : ℝ) (uw : ℝ × ℝ),
        |(|D (b₀ - p * (uw.1 - u₀) + uw.2, uw.1) - D_s|)| ≤ M + |D_s| := by
      intro D_s ⟨u, w⟩
      rw [abs_abs]
      exact (abs_sub _ _).trans (add_le_add (hD_abs _) le_rfl)
    have hΦ_up_m : ∀ z_s D_s : ℝ, Measurable (fun uw : ℝ × ℝ => Φ_up z_s D_s uw.1 uw.2) :=
      fun z_s D_s => (h_cst_m z_s D_s).add
        ((measurable_const.mul (h_err_a_m z_s)).add (measurable_const.mul (h_err_D_m D_s)))
    have hCa_nn : 0 ≤ C_a := by dsimp [C_a]; positivity
    have hCD_nn : 0 ≤ C_D := by dsimp [C_D]; positivity
    have hΦ_up_bd : ∀ (z_s D_s : ℝ) (uw : ℝ × ℝ),
        |Φ_up z_s D_s uw.1 uw.2| ≤
          (|z_s| * C_a + |D_s| * C_D) + (C_a * (M + |z_s|) + C_D * (M + |D_s|)) := by
      intro z_s D_s uw
      dsimp only [Φ_up]
      refine (abs_add_le _ _).trans (add_le_add (h_cst_bd z_s D_s uw) ?_)
      refine (abs_add_le _ _).trans (add_le_add ?_ ?_)
      · rw [abs_of_nonneg (mul_nonneg hCa_nn (abs_nonneg _))]
        exact mul_le_mul_of_nonneg_left
          (by simpa [abs_abs] using h_err_a_bd z_s uw) hCa_nn
      · rw [abs_of_nonneg (mul_nonneg hCD_nn (abs_nonneg _))]
        exact mul_le_mul_of_nonneg_left
          (by simpa [abs_abs] using h_err_D_bd D_s uw) hCD_nn

    
    have h_dχ_neg : (∫ w in (-ρ)..(0 : ℝ), deriv χ (ρ⁻¹ * w)) = ρ := by
      have h1 := intervalIntegral.integral_comp_mul_left (deriv χ) hρ_inv_ne (a := -ρ) (b := 0)
      have he1 : ρ⁻¹ * (-ρ) = -1 := by field_simp [hρ_pos.ne']
      rw [he1, mul_zero, inv_inv, smul_eq_mul, hχ_int_neg, mul_one] at h1
      exact h1
    have h_dχ_pos : (∫ w in (0 : ℝ)..ρ, deriv χ (ρ⁻¹ * w)) = -ρ := by
      have h2 := intervalIntegral.integral_comp_mul_left (deriv χ) hρ_inv_ne (a := 0) (b := ρ)
      rw [mul_zero, inv_mul_cancel₀ hρ_pos.ne', inv_inv, smul_eq_mul, hχ_int_pos, mul_neg_one] at h2
      exact h2
    let A_m : ℝ := ∫ w in (-ρ)..(0 : ℝ), χ (ρ⁻¹ * w)
    let A_p : ℝ := ∫ w in (0 : ℝ)..ρ, χ (ρ⁻¹ * w)
    have hdχ_w_ii : ∀ a b : ℝ,
        IntervalIntegrable (fun w => deriv χ (ρ⁻¹ * w)) MeasureTheory.volume a b :=
      fun a b => (hχ'_cont.comp (continuous_const.mul continuous_id)).intervalIntegrable a b
    have hχ_w_ii : ∀ a b : ℝ,
        IntervalIntegrable (fun w => χ (ρ⁻¹ * w)) MeasureTheory.volume a b :=
      fun a b => (hχ_cont.comp (continuous_const.mul continuous_id)).intervalIntegrable a b

    
    have h_cst_w : ∀ u : ℝ,
        (∫ w in (-ρ)..(0 : ℝ), (-z_minus * K_a u w + D_minus * K_D u w)) +
          (∫ w in (0 : ℝ)..ρ, (-z_plus * K_a u w + D_plus * K_D u w)) =
        (ρ * Δ_RH) * χ (ρ⁻¹ * (u - u₀)) -
          (z_minus * A_m + z_plus * A_p) * deriv χ (ρ⁻¹ * (u - u₀)) := by
      intro u
      have h_lin : ∀ z_s D_s a b : ℝ,
          ∫ w in a..b, (-z_s * K_a u w + D_s * K_D u w) =
            ((-z_s * (p - c_top) + D_s) * χ (ρ⁻¹ * (u - u₀))) *
              (∫ w in a..b, deriv χ (ρ⁻¹ * w)) +
            (-z_s * deriv χ (ρ⁻¹ * (u - u₀))) *
              (∫ w in a..b, χ (ρ⁻¹ * w)) := by
        intro z_s D_s a b
        have h_fn : (fun w : ℝ => -z_s * K_a u w + D_s * K_D u w) =
            (fun w : ℝ =>
              ((-z_s * (p - c_top) + D_s) * χ (ρ⁻¹ * (u - u₀))) * deriv χ (ρ⁻¹ * w) +
              (-z_s * deriv χ (ρ⁻¹ * (u - u₀))) * χ (ρ⁻¹ * w)) := by
          ext w; dsimp only [K_a, K_D]; ring
        rw [h_fn, intervalIntegral.integral_add
          ((hdχ_w_ii a b).const_mul _) ((hχ_w_ii a b).const_mul _),
          intervalIntegral.integral_const_mul, intervalIntegral.integral_const_mul]
      rw [h_lin z_minus D_minus (-ρ) 0, h_lin z_plus D_plus 0 ρ, h_dχ_neg, h_dχ_pos]
      dsimp only [A_m, A_p, Δ_RH]
      ring

    let R_u : ℝ → ℝ := fun u =>
      ((ρ * Δ_RH) * χ (ρ⁻¹ * (u - u₀)) -
        (z_minus * A_m + z_plus * A_p) * deriv χ (ρ⁻¹ * (u - u₀))) +
      (C_a * (∫ r in (-ρ)..(0 : ℝ), |a_top (b₀ - p * (u - u₀) + r, u) - z_minus|) +
        C_D * (∫ r in (-ρ)..(0 : ℝ), |D (b₀ - p * (u - u₀) + r, u) - D_minus|)) +
      (C_a * (∫ r in (0 : ℝ)..ρ, |a_top (b₀ - p * (u - u₀) + r, u) - z_plus|) +
        C_D * (∫ r in (0 : ℝ)..ρ, |D (b₀ - p * (u - u₀) + r, u) - D_plus|))

    have h_w_le : ∀ u : ℝ, (∫ w in (-ρ)..ρ, Φ_orig u w) ≤ R_u u := by
      intro u
      have hΦ_ii_w : ∀ a b : ℝ, IntervalIntegrable (fun w => Φ_orig u w) MeasureTheory.volume a b :=
        fun a b => h_ii_1d (M * C_a + M * C_D) (hΦ_m.comp (measurable_const.prodMk measurable_id))
          (fun w => hΦ_bd (u, w)) a b
      have h_sp := (intervalIntegral.integral_add_adjacent_intervals
        (hΦ_ii_w (-ρ) 0) (hΦ_ii_w 0 ρ)).symm
      rw [h_sp]
      have hm_neg : (∫ w in (-ρ)..(0 : ℝ), Φ_orig u w) ≤
          ∫ w in (-ρ)..(0 : ℝ), Φ_up z_minus D_minus u w :=
        intervalIntegral.integral_mono (by linarith)
          (h_ii_1d _ (hΦ_m.comp (measurable_const.prodMk measurable_id))
            (fun w => hΦ_bd (u, w)) (-ρ) 0)
          (h_ii_1d _ ((hΦ_up_m z_minus D_minus).comp (measurable_const.prodMk measurable_id))
            (fun w => hΦ_up_bd z_minus D_minus (u, w)) (-ρ) 0)
          (fun w => hΦ_le_up z_minus D_minus u w)
      have hm_pos : (∫ w in (0 : ℝ)..ρ, Φ_orig u w) ≤
          ∫ w in (0 : ℝ)..ρ, Φ_up z_plus D_plus u w :=
        intervalIntegral.integral_mono hρ_pos.le
          (h_ii_1d _ (hΦ_m.comp (measurable_const.prodMk measurable_id))
            (fun w => hΦ_bd (u, w)) 0 ρ)
          (h_ii_1d _ ((hΦ_up_m z_plus D_plus).comp (measurable_const.prodMk measurable_id))
            (fun w => hΦ_up_bd z_plus D_plus (u, w)) 0 ρ)
          (fun w => hΦ_le_up z_plus D_plus u w)
      have h_up_split : ∀ z_s D_s a b : ℝ,
          (∫ w in a..b, Φ_up z_s D_s u w) =
            (∫ w in a..b, (-z_s * K_a u w + D_s * K_D u w)) +
            (C_a * (∫ r in a..b, |a_top (b₀ - p * (u - u₀) + r, u) - z_s|) +
              C_D * (∫ r in a..b, |D (b₀ - p * (u - u₀) + r, u) - D_s|)) := by
        intro z_s D_s a b
        have hii_c : IntervalIntegrable (fun w => -z_s * K_a u w + D_s * K_D u w)
            MeasureTheory.volume a b :=
          h_ii_1d _ ((h_cst_m z_s D_s).comp (measurable_const.prodMk measurable_id))
            (fun w => h_cst_bd z_s D_s (u, w)) a b
        have hii_ea : IntervalIntegrable (fun r => |a_top (b₀ - p * (u - u₀) + r, u) - z_s|)
            MeasureTheory.volume a b :=
          h_ii_1d _ ((h_err_a_m z_s).comp (measurable_const.prodMk measurable_id))
            (fun w => h_err_a_bd z_s (u, w)) a b
        have hii_eD : IntervalIntegrable (fun r => |D (b₀ - p * (u - u₀) + r, u) - D_s|)
            MeasureTheory.volume a b :=
          h_ii_1d _ ((h_err_D_m D_s).comp (measurable_const.prodMk measurable_id))
            (fun w => h_err_D_bd D_s (u, w)) a b
        dsimp only [Φ_up]
        rw [intervalIntegral.integral_add hii_c
          ((hii_ea.const_mul C_a).add (hii_eD.const_mul C_D)),
          intervalIntegral.integral_add (hii_ea.const_mul C_a) (hii_eD.const_mul C_D),
          intervalIntegral.integral_const_mul, intervalIntegral.integral_const_mul]
      rw [h_up_split z_minus D_minus (-ρ) 0] at hm_neg
      rw [h_up_split z_plus D_plus 0 ρ] at hm_pos
      have hc := h_cst_w u
      dsimp only [R_u]
      linarith

    
    have hχ_u_int : (∫ u in (u₀ - ρ)..(u₀ + ρ), χ (ρ⁻¹ * (u - u₀))) = ρ * I_χ := by
      have h_eq : (fun u : ℝ => χ (ρ⁻¹ * (u - u₀))) =
          (fun u : ℝ => χ (ρ⁻¹ * u + (-ρ⁻¹ * u₀))) := by ext u; congr 1; ring
      rw [h_eq]
      have h3 := intervalIntegral.integral_comp_mul_add χ hρ_inv_ne (-ρ⁻¹ * u₀)
        (a := u₀ - ρ) (b := u₀ + ρ)
      have he1 : ρ⁻¹ * (u₀ - ρ) + -ρ⁻¹ * u₀ = -1 := by field_simp [hρ_pos.ne']; ring
      have he2 : ρ⁻¹ * (u₀ + ρ) + -ρ⁻¹ * u₀ = 1 := by field_simp [hρ_pos.ne']; ring
      rw [he1, he2, inv_inv, smul_eq_mul] at h3
      exact h3
    have hdχ_u_int : (∫ u in (u₀ - ρ)..(u₀ + ρ), deriv χ (ρ⁻¹ * (u - u₀))) = 0 := by
      have h_eq : (fun u : ℝ => deriv χ (ρ⁻¹ * (u - u₀))) =
          (fun u : ℝ => deriv χ (ρ⁻¹ * u + (-ρ⁻¹ * u₀))) := by ext u; congr 1; ring
      rw [h_eq]
      have h3 := intervalIntegral.integral_comp_mul_add (deriv χ) hρ_inv_ne (-ρ⁻¹ * u₀)
        (a := u₀ - ρ) (b := u₀ + ρ)
      have he1 : ρ⁻¹ * (u₀ - ρ) + -ρ⁻¹ * u₀ = -1 := by field_simp [hρ_pos.ne']; ring
      have he2 : ρ⁻¹ * (u₀ + ρ) + -ρ⁻¹ * u₀ = 1 := by field_simp [hρ_pos.ne']; ring
      rw [he1, he2, inv_inv, smul_eq_mul, hχ_int_all, mul_zero] at h3
      exact h3

    have hii_χu : IntervalIntegrable (fun u => χ (ρ⁻¹ * (u - u₀)))
        MeasureTheory.volume (u₀ - ρ) (u₀ + ρ) :=
      (hχ_cont.comp (continuous_const.mul (continuous_id.sub continuous_const))).intervalIntegrable
        _ _
    have hii_dχu : IntervalIntegrable (fun u => deriv χ (ρ⁻¹ * (u - u₀)))
        MeasureTheory.volume (u₀ - ρ) (u₀ + ρ) :=
      (hχ'_cont.comp (continuous_const.mul (continuous_id.sub continuous_const))).intervalIntegrable
        _ _
    have hii_c0 : IntervalIntegrable
        (fun u => (ρ * Δ_RH) * χ (ρ⁻¹ * (u - u₀)) -
          (z_minus * A_m + z_plus * A_p) * deriv χ (ρ⁻¹ * (u - u₀)))
        MeasureTheory.volume (u₀ - ρ) (u₀ + ρ) :=
      (hii_χu.const_mul _).sub (hii_dχu.const_mul _)
    have hii_eam : IntervalIntegrable
        (fun u => ∫ r in (-ρ)..(0 : ℝ), |a_top (b₀ - p * (u - u₀) + r, u) - z_minus|)
        MeasureTheory.volume (u₀ - ρ) (u₀ + ρ) :=
      h_ii_2d (M + |z_minus|) (h_err_a_m z_minus) (h_err_a_bd z_minus) (u₀ - ρ) (u₀ + ρ) (-ρ) 0
    have hii_eap : IntervalIntegrable
        (fun u => ∫ r in (0 : ℝ)..ρ, |a_top (b₀ - p * (u - u₀) + r, u) - z_plus|)
        MeasureTheory.volume (u₀ - ρ) (u₀ + ρ) :=
      h_ii_2d (M + |z_plus|) (h_err_a_m z_plus) (h_err_a_bd z_plus) (u₀ - ρ) (u₀ + ρ) 0 ρ
    have hii_eDm : IntervalIntegrable
        (fun u => ∫ r in (-ρ)..(0 : ℝ), |D (b₀ - p * (u - u₀) + r, u) - D_minus|)
        MeasureTheory.volume (u₀ - ρ) (u₀ + ρ) :=
      h_ii_2d (M + |D_minus|) (h_err_D_m D_minus) (h_err_D_bd D_minus) (u₀ - ρ) (u₀ + ρ) (-ρ) 0
    have hii_eDp : IntervalIntegrable
        (fun u => ∫ r in (0 : ℝ)..ρ, |D (b₀ - p * (u - u₀) + r, u) - D_plus|)
        MeasureTheory.volume (u₀ - ρ) (u₀ + ρ) :=
      h_ii_2d (M + |D_plus|) (h_err_D_m D_plus) (h_err_D_bd D_plus) (u₀ - ρ) (u₀ + ρ) 0 ρ
    have hii_Ru : IntervalIntegrable R_u MeasureTheory.volume (u₀ - ρ) (u₀ + ρ) :=
      (hii_c0.add ((hii_eam.const_mul C_a).add (hii_eDm.const_mul C_D))).add
        ((hii_eap.const_mul C_a).add (hii_eDp.const_mul C_D))
    have hii_Φu : IntervalIntegrable (fun u => ∫ w in (-ρ)..ρ, Φ_orig u w)
        MeasureTheory.volume (u₀ - ρ) (u₀ + ρ) :=
      h_ii_2d (M * C_a + M * C_D) hΦ_m hΦ_bd (u₀ - ρ) (u₀ + ρ) (-ρ) ρ

    have h_u_mono : (∫ u in (u₀ - ρ)..(u₀ + ρ), ∫ w in (-ρ)..ρ, Φ_orig u w) ≤
        ∫ u in (u₀ - ρ)..(u₀ + ρ), R_u u :=
      intervalIntegral.integral_mono (by linarith) hii_Φu hii_Ru h_w_le
    have h_Ru_eval : ρ⁻¹ ^ 2 * (∫ u in (u₀ - ρ)..(u₀ + ρ), R_u u) =
        I_χ * Δ_RH + C_a * (E_a_m ρ + E_a_p ρ) + C_D * (E_D_m ρ + E_D_p ρ) := by
      dsimp only [R_u]
      rw [intervalIntegral.integral_add
        (hii_c0.add ((hii_eam.const_mul C_a).add (hii_eDm.const_mul C_D)))
        ((hii_eap.const_mul C_a).add (hii_eDp.const_mul C_D)),
        intervalIntegral.integral_add hii_c0
          ((hii_eam.const_mul C_a).add (hii_eDm.const_mul C_D)),
        intervalIntegral.integral_sub (hii_χu.const_mul _) (hii_dχu.const_mul _),
        intervalIntegral.integral_const_mul, intervalIntegral.integral_const_mul,
        hχ_u_int, hdχ_u_int,
        intervalIntegral.integral_add (hii_eam.const_mul C_a) (hii_eDm.const_mul C_D),
        intervalIntegral.integral_add (hii_eap.const_mul C_a) (hii_eDp.const_mul C_D),
        intervalIntegral.integral_const_mul, intervalIntegral.integral_const_mul,
        intervalIntegral.integral_const_mul, intervalIntegral.integral_const_mul]
      dsimp only [E_a_m, E_a_p, E_D_m, E_D_p]
      have hρ_cancel : ρ⁻¹ ^ 2 * (ρ * Δ_RH * (ρ * I_χ)) = I_χ * Δ_RH := by
        field_simp [hρ_pos.ne']
      linarith [hρ_cancel]
    have h_mul_mono := mul_le_mul_of_nonneg_left h_u_mono hρ_sq_pos.le
    linarith

  
  have h_tendsto : Filter.Tendsto
      (fun ρ => I_χ * Δ_RH + C_a * (E_a_m ρ + E_a_p ρ) + C_D * (E_D_m ρ + E_D_p ρ))
      (nhdsWithin 0 (Set.Ioi 0))
      (nhds (I_χ * Δ_RH + C_a * (0 + 0) + C_D * (0 + 0))) :=
    (tendsto_const_nhds.add ((ha_tr.1.add ha_tr.2).const_mul C_a)).add
      ((hD_tr.1.add hD_tr.2).const_mul C_D)
  simp only [add_zero, mul_zero] at h_tendsto
  have h_ev : ∀ᶠ ρ in nhdsWithin (0 : ℝ) (Set.Ioi 0),
      0 ≤ I_χ * Δ_RH + C_a * (E_a_m ρ + E_a_p ρ) + C_D * (E_D_m ρ + E_D_p ρ) :=
    Filter.eventually_of_mem (Ioo_mem_nhdsGT hδ_pos) h_scale_ineq
  have h_prod_nn : 0 ≤ I_χ * Δ_RH := ge_of_tendsto h_tendsto h_ev
  have hΔ_nn : 0 ≤ Δ_RH := by
    by_contra h_neg
    have h_lt : I_χ * Δ_RH < 0 := mul_neg_of_pos_of_neg hI_pos (lt_of_not_ge h_neg)
    linarith
  dsimp only [Δ_RH] at hΔ_nn
  linarith

theorem directional_bv_transverse_curve_traces (n : ℕ) (j_top : Fin n)
    (c d : Fin n → ℝ) (d_v : ℝ) (E_cone : Fin n → Fin n → Prop)
    (hd_nn : (∀ j, 0 ≤ d j) ∧ d j_top ≤ 1 ∧ 0 ≤ d_v)
    (f : ((Fin n → ℝ) × ℝ) → ℝ)
    (a : Fin n → ℝ × ℝ → ℝ) (D : ℝ × ℝ → ℝ)
    (h_tr : IsCharacteristicTraceData n j_top c d d_v E_cone f a D)
    (b : ℝ → ℝ) (L_b : ℝ) (hL_b : 0 ≤ L_b)
    (hb_lip : ∀ u₁ u₂ : ℝ, |b u₁ - b u₂| ≤ L_b * |u₁ - u₂|) :
    ∀ᵐ u₀ : ℝ, u₀ ∈ Set.Ioo (0 : ℝ) 1 →
      ∃ (p D_minus D_plus : ℝ) (a_minus a_plus : Fin n → ℝ),
        HasDerivAt b (-p) u₀ ∧
        0 ≤ D_minus ∧ D_minus ≤ d_v ∧
        0 ≤ D_plus ∧ D_plus ≤ d_v ∧
        (∀ j : Fin n, 0 ≤ a_minus j ∧ a_minus j ≤ d j ∧ 0 ≤ a_plus j ∧ a_plus j ≤ d j) ∧
        HasTangentBoxTrace D (b u₀) u₀ p D_minus D_plus ∧
        (∀ j : Fin n, c j ≠ p → HasTangentBoxTrace (a j) (b u₀) u₀ p (a_minus j) (a_plus j)) ∧
        (c j_top ≠ p → (c j_top - p) * (a_plus j_top - a_minus j_top) ≤ D_minus - D_plus) :=
by
  obtain ⟨ha_reg, hD_reg, _, _, ⟨ha_approx, hD_approx⟩, _, h_flux⟩ := h_tr
  let K_D : ℝ := max 1 (|b 0| + L_b + 2)
  have hK_D : 1 ≤ K_D := le_max_left _ _
  have hK_D_lt : -K_D < K_D := by linarith
  have hb_in_K : ∀ u₀ ∈ Set.Ioo (0 : ℝ) 1, b u₀ ∈ Set.Ioo (-K_D) K_D := by
    intro u₀ hu₀
    have h_lip0 : |b u₀ - b 0| ≤ L_b * |u₀ - 0| := hb_lip u₀ 0
    have hu_abs : |u₀ - 0| ≤ 1 := by
      rw [sub_zero, abs_of_pos hu₀.1]
      exact hu₀.2.le
    have h_diff_le : |b u₀ - b 0| ≤ L_b := by
      calc |b u₀ - b 0| ≤ L_b * |u₀ - 0| := h_lip0
        _ ≤ L_b * 1 := mul_le_mul_of_nonneg_left hu_abs hL_b
        _ = L_b := mul_one L_b
    obtain ⟨hl1, hl2⟩ := abs_le.mp h_diff_le
    obtain ⟨hb1, hb2⟩ := abs_le.mp (le_refl |b 0|)
    have hK_rhs : |b 0| + L_b + 2 ≤ K_D := le_max_right _ _
    exact ⟨by linarith, by linarith⟩
  have hD_m_ae : ∀ m : ℕ, ∀ᵐ u₀ : ℝ,
      u₀ ∈ Set.Ioo (1 / ((m : ℝ) + 3)) (1 - 1 / ((m : ℝ) + 3)) →
      ∃ p D_minus D_plus : ℝ,
        HasDerivAt b (-p) u₀ ∧
        0 ≤ D_minus ∧ D_minus ≤ d_v ∧
        0 ≤ D_plus ∧ D_plus ≤ d_v ∧
        HasTangentBoxTrace D (b u₀) u₀ p D_minus D_plus := by
    intro m
    let δ_m : ℝ := 1 / ((m : ℝ) + 3)
    have hm_pos : (0 : ℝ) < (m : ℝ) + 3 := by positivity
    have hδ_pos : 0 < δ_m := div_pos one_pos hm_pos
    have hδ_lt_half : δ_m < 1 / 2 := by
      dsimp only [δ_m]
      rw [div_lt_div_iff₀ hm_pos (by norm_num : (0 : ℝ) < 2)]
      have hm_nn : (0 : ℝ) ≤ (m : ℝ) := Nat.cast_nonneg m
      linarith
    have hδ_lt_one_sub : δ_m < 1 - δ_m := by linarith
    obtain ⟨G_seq, C_var, hC_var, hG_reg, hG_l1, hG_var⟩ :=
      hD_approx K_D δ_m hK_D hδ_pos hδ_lt_half
    let F_D : ℝ × ℝ → ℝ := fun ui => D (ui.2, ui.1)
    let F_D_seq : ℕ → ℝ × ℝ → ℝ := fun l ui => G_seq l (ui.2, ui.1)
    have hFD_meas : Measurable F_D := hD_reg.1.comp measurable_swap
    have hFD_bds : ∀ xy : ℝ × ℝ, 0 ≤ F_D xy ∧ F_D xy ≤ d_v :=
      fun xy => hD_reg.2 (xy.2, xy.1)
    have hFD_seq_reg : ∀ l : ℕ,
        ContDiff ℝ 1 (F_D_seq l) ∧ ∀ xy : ℝ × ℝ, 0 ≤ F_D_seq l xy ∧ F_D_seq l xy ≤ d_v :=
      fun l => ⟨(hG_reg l).1.comp (contDiff_snd.prodMk contDiff_fst),
        fun xy => (hG_reg l).2 (xy.2, xy.1)⟩
    obtain ⟨D_m_minus, D_m_plus, hDm_meas, hDp_meas, hDmp_bds, hD_slices⟩ :=
      bv_slice_steklov_onesided_limits δ_m (1 - δ_m) (-K_D) K_D d_v C_var
        hδ_lt_one_sub hK_D_lt hd_nn.2.2 hC_var F_D hFD_meas hFD_bds F_D_seq
        hFD_seq_reg hG_l1 hG_var
    have h_gr := onesided_slice_lipschitz_graph_traces δ_m (1 - δ_m) (-K_D) K_D d_v
      hδ_lt_one_sub hK_D_lt hd_nn.2.2 F_D D_m_minus D_m_plus hFD_meas hDm_meas hDp_meas
      hFD_bds hDmp_bds hD_slices b L_b hL_b hb_lip
    filter_upwards [h_gr] with u₀ hu₀_gr hu₀_mem
    have hu₀_Ioo : u₀ ∈ Set.Ioo (0 : ℝ) 1 :=
      ⟨lt_trans hδ_pos hu₀_mem.1, lt_trans hu₀_mem.2 (by linarith)⟩
    obtain ⟨q, hq_der, h_tb⟩ := hu₀_gr hu₀_mem (hb_in_K u₀ hu₀_Ioo)
    have h_neg_neg : -(-q) = q := neg_neg q
    refine ⟨-q, D_m_minus (u₀, b u₀), D_m_plus (u₀, b u₀), ?_,
      (hDmp_bds (u₀, b u₀)).1, (hDmp_bds (u₀, b u₀)).2.1,
      (hDmp_bds (u₀, b u₀)).2.2.1, (hDmp_bds (u₀, b u₀)).2.2.2, h_tb⟩
    rwa [h_neg_neg]
  have hD_ae : ∀ᵐ u₀ : ℝ, u₀ ∈ Set.Ioo (0 : ℝ) 1 →
      ∃ p D_minus D_plus : ℝ,
        HasDerivAt b (-p) u₀ ∧
        0 ≤ D_minus ∧ D_minus ≤ d_v ∧
        0 ≤ D_plus ∧ D_plus ≤ d_v ∧
        HasTangentBoxTrace D (b u₀) u₀ p D_minus D_plus := by
    filter_upwards [eventually_countable_forall.mpr hD_m_ae] with u₀ hu₀_all hu₀
    let η : ℝ := min u₀ (1 - u₀)
    have hη_pos : 0 < η := lt_min hu₀.1 (sub_pos.mpr hu₀.2)
    obtain ⟨m, hm⟩ := exists_nat_gt (1 / η)
    have hm3_pos : (0 : ℝ) < (m : ℝ) + 3 := by positivity
    have h_inv_lt : 1 / ((m : ℝ) + 3) < η := by
      rw [div_lt_iff₀ hm3_pos]
      have h1 : 1 < (m : ℝ) * η := (div_lt_iff₀ hη_pos).mp hm
      nlinarith
    have hη_le1 : η ≤ u₀ := min_le_left _ _
    have hη_le2 : η ≤ 1 - u₀ := min_le_right _ _
    exact hu₀_all m ⟨lt_of_lt_of_le h_inv_lt hη_le1, by linarith⟩
  have ha_ae : ∀ j : Fin n, ∀ᵐ u₀ : ℝ, u₀ ∈ Set.Ioo (0 : ℝ) 1 →
      ∀ p : ℝ, HasDerivAt b (-p) u₀ → c j ≠ p →
        ∃ a_minus a_plus : ℝ,
          0 ≤ a_minus ∧ a_minus ≤ d j ∧ 0 ≤ a_plus ∧ a_plus ≤ d j ∧
          HasTangentBoxTrace (a j) (b u₀) u₀ p a_minus a_plus := by
    intro j
    refine transverse_curve_trace_of_graph_trace (c j) (d j) (hd_nn.1 j) (a j)
      (ha_reg j).1 (ha_reg j).2 ?_ b L_b hL_b hb_lip
    intro K δ hK hδ0 hδ1 h L_h hL_h hh_lip
    have hK_lt : -K < K := by linarith
    have hδ_lt : δ < 1 - δ := by linarith
    obtain ⟨g_seq, C_var, hC_var, hg_reg, hg_l1, hg_var⟩ :=
      ha_approx j K δ hK hδ0 hδ1
    let F_a : ℝ × ℝ → ℝ := fun rs => a j (rs.1 - c j * rs.2, rs.2)
    have hFa_meas : Measurable F_a :=
      (ha_reg j).1.comp
        ((measurable_fst.sub (measurable_const.mul measurable_snd)).prodMk measurable_snd)
    have hFa_bds : ∀ xy : ℝ × ℝ, 0 ≤ F_a xy ∧ F_a xy ≤ d j :=
      fun xy => (ha_reg j).2 (xy.1 - c j * xy.2, xy.2)
    obtain ⟨F_m, F_p, hFm_meas, hFp_meas, hFmp_bds, h_slices⟩ :=
      bv_slice_steklov_onesided_limits (-K) K δ (1 - δ) (d j) C_var
        hK_lt hδ_lt (hd_nn.1 j) hC_var F_a hFa_meas hFa_bds g_seq hg_reg hg_l1 hg_var
    have h_gr := onesided_slice_lipschitz_graph_traces (-K) K δ (1 - δ) (d j)
      hK_lt hδ_lt (hd_nn.1 j) F_a F_m F_p hFa_meas hFm_meas hFp_meas
      hFa_bds hFmp_bds h_slices h L_h hL_h hh_lip
    filter_upwards [h_gr] with r₀ hr₀_gr hr₀_K hhr₀_δ
    obtain ⟨q, hq_der, h_tb⟩ := hr₀_gr hr₀_K hhr₀_δ
    exact ⟨q, F_m (r₀, h r₀), F_p (r₀, h r₀),
      (hFmp_bds (r₀, h r₀)).1, (hFmp_bds (r₀, h r₀)).2.1,
      (hFmp_bds (r₀, h r₀)).2.2.1, (hFmp_bds (r₀, h r₀)).2.2.2,
      hq_der, h_tb⟩
  filter_upwards [hD_ae, eventually_countable_forall.mpr ha_ae] with u₀ hu₀_D hu₀_a hu₀
  obtain ⟨p, D_minus, D_plus, hb_der, hDm0, hDm1, hDp0, hDp1, hD_tr⟩ := hu₀_D hu₀
  have h_ex_j : ∀ j : Fin n, ∃ am ap : ℝ,
      0 ≤ am ∧ am ≤ d j ∧ 0 ≤ ap ∧ ap ≤ d j ∧
      (c j ≠ p → HasTangentBoxTrace (a j) (b u₀) u₀ p am ap) := by
    intro j
    by_cases hcj : c j = p
    · exact ⟨0, 0, le_rfl, hd_nn.1 j, le_rfl, hd_nn.1 j, fun hne => False.elim (hne hcj)⟩
    · obtain ⟨am, ap, ham0, ham1, hap0, hap1, htr⟩ := hu₀_a j hu₀ p hb_der hcj
      exact ⟨am, ap, ham0, ham1, hap0, hap1, fun _ => htr⟩
  choose a_minus a_plus ha_spec using h_ex_j
  refine ⟨p, D_minus, D_plus, a_minus, a_plus, hb_der, hDm0, hDm1, hDp0, hDp1,
    fun j => ⟨(ha_spec j).1, (ha_spec j).2.1, (ha_spec j).2.2.1, (ha_spec j).2.2.2.1⟩,
    hD_tr, fun j hcj => (ha_spec j).2.2.2.2 hcj, fun hc_top => ?_⟩
  let M_top : ℝ := max (d j_top) d_v
  have hM_top : 0 ≤ M_top := le_trans (hd_nn.1 j_top) (le_max_left _ _)
  have ha_top_bds : ∀ iu : ℝ × ℝ, 0 ≤ a j_top iu ∧ a j_top iu ≤ M_top :=
    fun iu => ⟨((ha_reg j_top).2 iu).1, le_trans ((ha_reg j_top).2 iu).2 (le_max_left _ _)⟩
  have hD_top_bds : ∀ iu : ℝ × ℝ, 0 ≤ D iu ∧ D iu ≤ M_top :=
    fun iu => ⟨(hD_reg.2 iu).1, le_trans (hD_reg.2 iu).2 (le_max_right _ _)⟩
  exact weak_flux_tangent_box_jump_ineq (c j_top) M_top hM_top (a j_top) D
    (ha_reg j_top).1 hD_reg.1 ha_top_bds hD_top_bds h_flux
    (b u₀) u₀ p (a_minus j_top) (a_plus j_top) D_minus D_plus hu₀
    ((ha_spec j_top).2.2.2.2 hc_top) hD_tr

theorem obstacle_contact_tuple_extraction (n : ℕ) (j₀ j_top : Fin n)
    (c d : Fin n → ℝ) (d_v : ℝ) (E_cone : Fin n → Fin n → Prop)
    (hc_zero : c j₀ = 0)
    (hc_min : ∀ j : Fin n, c j₀ ≤ c j)
    (hd_nn : (∀ j, 0 ≤ d j) ∧ d j_top ≤ 1 ∧ 0 ≤ d_v)
    (hE_pos : ∀ j k : Fin n, E_cone j k → 0 < c k - c j)
    (f : ((Fin n → ℝ) × ℝ) → ℝ)
    (hf : IsSubmodularConeProfile n c d d_v E_cone f)
    (a : Fin n → ℝ × ℝ → ℝ) (D : ℝ × ℝ → ℝ) (h_seq : ℕ → ℝ)
    (h_tr : IsCharacteristicTraceData n j_top c d d_v E_cone f a D)
    (hh_pos : ∀ l, 0 < h_seq l)
    (hh_lim : Filter.Tendsto h_seq Filter.atTop (nhds 0))
    (γ m β τ : ℝ) (b S : ℝ → ℝ) (g_x : ℝ → ℝ → ℝ)
    (P_rates : ℝ → (Fin n → ℝ) → Prop)
    (hγ : 0 < γ) (hm : 0 < m) (hc_top_val : c j_top = 1 + m)
    (hb_lip : ∀ u₁ u₂ : ℝ, u₁ ≤ u₂ → 0 ≤ b u₁ - b u₂ ∧ b u₁ - b u₂ ≤ (1 + m) * (u₂ - u₁))
    (hb_dom : ∀ u ∈ Set.Icc (0 : ℝ) 1, 0 ≤ b u ∧ b u + (1 + m) * u ≤ 1 + m)
    (hS_lip : ∀ u₁ u₂ : ℝ, u₁ ≤ u₂ → 0 ≤ S u₂ - S u₁ ∧ S u₂ - S u₁ ≤ u₂ - u₁)
    (h_obs : ∀ (i u : ℝ), u ∈ Set.Ioo (0 : ℝ) 1 → 0 ≤ i → i + (1 + m) * u ≤ 1 + m →
      2 * i + (1 - γ) * m * u + 2 * S u - β * u - τ ≤ f (planeEmbed n c (i, u)))
    (h_cont : ∀ u ∈ Set.Ioo (0 : ℝ) 1,
      f (planeEmbed n c (b u, u)) = 2 * (b u) + (1 - γ) * m * u + 2 * S u - β * u - τ)
    (h_xref : ∀ u_c ∈ Set.Ioo (0 : ℝ) 1,
      g_x u_c 0 = 0 ∧
      (∀ d₁ d₂ : ℝ, d₁ ≤ d₂ → 0 ≤ g_x u_c d₂ - g_x u_c d₁ ∧ g_x u_c d₂ - g_x u_c d₁ ≤ d₂ - d₁) ∧
      (∀ d_r : ℝ, 0 ≤ d_r → d_r ≤ m * u_c → γ * d_r ≤ g_x u_c d_r) ∧
      (∀ (lam_s h i t : ℝ),
        0 < lam_s → lam_s < min 1 m → 0 < h → h < u_c →
        b u_c ≤ i → i ≤ b u_c + lam_s * h → 0 < t → i + t < b u_c + m * u_c →
        let p₀ := planeEmbed n c (i, u_c - h)
        let p_t := (Function.update p₀.1 j₀ (p₀.1 j₀ + t), p₀.2)
        g_x u_c (i - b u_c + t) - g_x u_c (i - b u_c) ≤ f p_t - f p₀))
    (hP_closed : IsClosed { sr : ℝ × (Fin n → ℝ) | P_rates sr.1 sr.2 })
    (h_rates_ae : ∀ᵐ iu : ℝ × ℝ, 0 < iu.1 ∧ iu.2 ∈ Set.Ioo (0 : ℝ) 1 →
      ∃ s_u : ℝ, HasDerivAt S s_u iu.2 ∧ 0 < s_u ∧ s_u ≤ 1 ∧ P_rates s_u (fun j => a j iu))
    (u₀ p s D_minus D_plus : ℝ) (a_minus a_plus : Fin n → ℝ)
    (hu₀ : u₀ ∈ Set.Ioo (0 : ℝ) 1)
    (hb_der : HasDerivAt b (-p) u₀)
    (hS_der : HasDerivAt S s u₀) (hs_pos : 0 < s) (hs_le : s ≤ 1)
    (hS_leb : Filter.Tendsto (fun ρ : ℝ =>
      ρ⁻¹ * ∫ u in (u₀ - ρ)..(u₀ + ρ), |deriv S u - s|)
      (nhdsWithin 0 (Set.Ioi 0)) (nhds 0))
    (hD_bds : 0 ≤ D_minus ∧ D_minus ≤ d_v ∧ 0 ≤ D_plus ∧ D_plus ≤ d_v)
    (ha_bds : ∀ j : Fin n, 0 ≤ a_minus j ∧ a_minus j ≤ d j ∧ 0 ≤ a_plus j ∧ a_plus j ≤ d j)
    (hD_tr : HasTangentBoxTrace D (b u₀) u₀ p D_minus D_plus)
    (ha_tr : ∀ j : Fin n, c j ≠ p → HasTangentBoxTrace (a j) (b u₀) u₀ p (a_minus j) (a_plus j))
    (h_jmp : c j_top ≠ p → (c j_top - p) * (a_plus j_top - a_minus j_top) ≤ D_minus - D_plus)
    (h_blow_j₀ : ∀ᵐ h : ℝ, 0 < h → h < u₀ → ∀ᵐ i : ℝ,
      Filter.Tendsto (fun l : ℕ =>
        let p₀ := planeEmbed n c (i, u₀ - h)
        let p_t := (Function.update p₀.1 j₀ (p₀.1 j₀ + h_seq l), p₀.2)
        (f p_t - f p₀) / h_seq l) Filter.atTop (nhds (a j₀ (i, u₀ - h)))) :
    ∃ (p_out s_out z_minus z_plus D_m D_p : ℝ),
      0 ≤ p_out ∧ p_out ≤ 1 + m ∧ 0 < s_out ∧ s_out ≤ 1 ∧
      0 ≤ z_minus ∧ z_minus ≤ 1 ∧ 0 ≤ z_plus ∧ z_plus ≤ 1 ∧
      0 ≤ D_m ∧ 0 ≤ D_p ∧
      (0 < p_out → ∃ r_m : Fin n → ℝ,
        P_rates s_out r_m ∧ (∑ j, r_m j) - 2 ≤ 0 ∧ γ ≤ r_m j₀ ∧
        (p_out < 1 + m → r_m j_top = z_minus) ∧
        (2 * p_out - m + ∑ j, (c j - p_out) * r_m j) + D_m = 2 * s_out - β - γ * m) ∧
      (p_out < 1 + m → ∃ r_p : Fin n → ℝ,
        P_rates s_out r_p ∧ 0 ≤ (∑ j, r_p j) - 2 ∧ r_p j_top = z_plus ∧
        (2 * p_out - m + ∑ j, (c j - p_out) * r_p j) + D_p = 2 * s_out - β - γ * m) ∧
      (p_out = 0 → ∃ r_p0 : Fin n → ℝ,
        P_rates s_out r_p0 ∧ γ ≤ r_p0 j₀ ∧ r_p0 j_top = z_plus ∧
        (2 * p_out - m + ∑ j, (c j - p_out) * r_p0 j) + D_p = 2 * s_out - β - γ * m) ∧
      (0 < p_out ∧ p_out < 1 + m → (1 + m - p_out) * (z_plus - z_minus) ≤ D_m - D_p) :=
by
  have _ := hγ
  have h_param_ii : ∀ (G : ℝ × ℝ → ℝ), Measurable G →
      ∀ (M_G : ℝ), 0 ≤ M_G → (∀ q, |G q| ≤ M_G) →
      ∀ (c₁ c₂ : ℝ → ℝ), Continuous c₁ → Continuous c₂ → ∀ (u₁ u₂ : ℝ),
      IntervalIntegrable (fun u => ∫ r in (c₁ u)..(c₂ u), G (u, r))
        MeasureTheory.volume u₁ u₂ := by
    intro G hG_meas M_G hM_G hG_bd c₁ c₂ hc₁ hc₂ u₁ u₂
    have h_sm_part : ∀ (f₁ f₂ : ℝ → ℝ), Continuous f₁ → Continuous f₂ →
        MeasureTheory.StronglyMeasurable
          (fun u => ∫ r in Set.Ioc (f₁ u) (f₂ u), G (u, r)) := by
      intro f₁ f₂ hf₁ hf₂
      let S_ioc : Set (ℝ × ℝ) := { q | f₁ q.1 < q.2 ∧ q.2 ≤ f₂ q.1 }
      have hS_meas : MeasurableSet S_ioc :=
        (measurableSet_lt (hf₁.measurable.comp measurable_fst) measurable_snd).inter
          (measurableSet_le measurable_snd (hf₂.measurable.comp measurable_fst))
      have h_eq : (fun u => ∫ r in Set.Ioc (f₁ u) (f₂ u), G (u, r)) =
          (fun u => ∫ r : ℝ, S_ioc.indicator G (u, r)) := by
        ext u
        rw [← MeasureTheory.integral_indicator measurableSet_Ioc]
        rfl
      rw [h_eq]
      exact MeasureTheory.StronglyMeasurable.integral_prod_right'
        (ν := MeasureTheory.volume) (hG_meas.indicator hS_meas).stronglyMeasurable
    have h_sm : MeasureTheory.StronglyMeasurable
        (fun u => ∫ r in (c₁ u)..(c₂ u), G (u, r)) :=
      (h_sm_part c₁ c₂ hc₁ hc₂).sub (h_sm_part c₂ c₁ hc₂ hc₁)
    obtain ⟨L_c, hL_c⟩ := (isCompact_uIcc (a := u₁) (b := u₂)).bddAbove_image
      (hc₂.sub hc₁).norm.continuousOn
    rw [intervalIntegrable_iff]
    refine MeasureTheory.IntegrableOn.of_bound
      (by rw [Real.volume_uIoc]; exact ENNReal.ofReal_lt_top)
      h_sm.aestronglyMeasurable (M_G * max 0 L_c) ?_
    filter_upwards [MeasureTheory.ae_restrict_mem measurableSet_uIoc] with u hu
    have hu_cc : u ∈ Set.uIcc u₁ u₂ := Set.uIoc_subset_uIcc hu
    have h_len : |c₂ u - c₁ u| ≤ max 0 L_c :=
      le_trans (hL_c ⟨u, hu_cc, rfl⟩) (le_max_right _ _)
    calc ‖∫ r in (c₁ u)..(c₂ u), G (u, r)‖
        ≤ M_G * |c₂ u - c₁ u| :=
          intervalIntegral.norm_integral_le_of_norm_le_const (fun r _ => hG_bd (u, r))
      _ ≤ M_G * max 0 L_c := mul_le_mul_of_nonneg_left h_len hM_G
  have h_sum_ii : ∀ (F : Finset (Fin n)) (g : Fin n → ℝ → ℝ) (u₁ u₂ : ℝ),
      (∀ j ∈ F, IntervalIntegrable (g j) MeasureTheory.volume u₁ u₂) →
      IntervalIntegrable (fun x => ∑ j ∈ F, g j x) MeasureTheory.volume u₁ u₂ := by
    intro F g u₁ u₂ hg
    convert IntervalIntegrable.sum F hg using 1
    ext x
    simp only [Finset.sum_apply]
  obtain ⟨ha_meas, hD_meas, ⟨M_lip, hM_lip, hf_lip⟩, _, _, ⟨h_horiz_ftc, h_sheared_ftc_all⟩, _⟩ :=
    h_tr
  let Φ : ℝ × ℝ → ℝ := fun iu => f (planeEmbed n c iu)
  let L_Φ : ℝ := (n : ℝ) * M_lip
  have hL_Φ : 0 ≤ L_Φ := mul_nonneg (Nat.cast_nonneg n) hM_lip
  have h_pe_cone : ∀ (i u : ℝ), u ∈ Set.Ioo (0 : ℝ) 1 →
      InResolutionCone n c E_cone (planeEmbed n c (i, u)) := by
    intro i u hu
    refine ⟨hu, fun j k _ => ?_⟩
    change (i + c k * u) - (i + c j * u) ≤ (c k - c j) * u
    linarith
  have hΦ_lip : ∀ u ∈ Set.Ioo (0 : ℝ) 1, ∀ i₁ i₂ : ℝ,
      |Φ (i₁, u) - Φ (i₂, u)| ≤ L_Φ * |i₁ - i₂| := by
    intro u hu i₁ i₂
    have h1 := hf_lip (planeEmbed n c (i₁, u)) (planeEmbed n c (i₂, u))
      (h_pe_cone i₁ u hu) (h_pe_cone i₂ u hu)
    have h_diff_j : ∀ j : Fin n,
        |(planeEmbed n c (i₁, u)).1 j - (planeEmbed n c (i₂, u)).1 j| = |i₁ - i₂| := by
      intro j; simp only [planeEmbed]; ring_nf
    have h_diff_v : |(planeEmbed n c (i₁, u)).2 - (planeEmbed n c (i₂, u)).2| = 0 := by
      simp [planeEmbed]
    simp_rw [h_diff_j, h_diff_v, add_zero, Finset.sum_const, Finset.card_univ, Fintype.card_fin,
      nsmul_eq_mul] at h1
    dsimp [Φ, L_Φ]
    linarith
  have h_nebot : Filter.NeBot (nhdsWithin (0 : ℝ) (Set.Ioi 0)) := nhdsWithin_Ioi_neBot le_rfl
  have h_shear_meas : Measurable (fun ur : ℝ × ℝ => (b u₀ - p * (ur.1 - u₀) + ur.2, ur.1)) :=
    (((measurable_const.sub (measurable_const.mul
      (measurable_fst.sub measurable_const))).add measurable_snd)).prodMk measurable_fst
  
  have h_eq_both :
      ((2 * p - m + ∑ j : Fin n, (c j - p) * a_minus j) + D_minus = 2 * s - β - γ * m) ∧
      ((2 * p - m + ∑ j : Fin n, (c j - p) * a_plus j) + D_plus = 2 * s - β - γ * m) := by
    let b₀ : ℝ := b u₀
    let k : ℝ := -2 * p + (1 - γ) * m + 2 * s - β
    let Ψ : ℝ × ℝ → ℝ := fun q => (∑ j : Fin n, (c j - p) * a j q) + D q
    let M_Ψ : ℝ := (∑ j : Fin n, |c j - p| * d j) + d_v
    have hM_Ψ : 0 ≤ M_Ψ :=
      add_nonneg (Finset.sum_nonneg (fun j _ => mul_nonneg (abs_nonneg _) (hd_nn.1 j))) hd_nn.2.2
    have hΨ_meas : Measurable Ψ :=
      (Finset.measurable_sum Finset.univ (fun j _ => measurable_const.mul (ha_meas j).1)).add
        hD_meas.1
    have hΨ_bd : ∀ q : ℝ × ℝ, |Ψ q| ≤ M_Ψ := by
      intro q
      calc |Ψ q|
          ≤ |∑ j : Fin n, (c j - p) * a j q| + |D q| := abs_add_le _ _
        _ ≤ (∑ j : Fin n, |(c j - p) * a j q|) + |D q| :=
            add_le_add (Finset.abs_sum_le_sum_abs _ _) le_rfl
        _ ≤ (∑ j : Fin n, |c j - p| * d j) + d_v := by
            refine add_le_add (Finset.sum_le_sum (fun j _ => ?_)) ?_
            · rw [abs_mul, abs_of_nonneg ((ha_meas j).2 q).1]
              exact mul_le_mul_of_nonneg_left ((ha_meas j).2 q).2 (abs_nonneg _)
            · rw [abs_of_nonneg (hD_meas.2 q).1]
              exact (hD_meas.2 q).2
    have h_ftc_shift : ∀ᵐ r' : ℝ, ∀ u₁ ∈ Set.Ioo (0 : ℝ) 1, ∀ u₂ ∈ Set.Ioo (0 : ℝ) 1,
        Φ (b₀ - p * (u₂ - u₀) + r', u₂) - Φ (b₀ - p * (u₁ - u₀) + r', u₁) =
          ∫ u in u₁..u₂, Ψ (b₀ - p * (u - u₀) + r', u) := by
      filter_upwards [(MeasureTheory.measurePreserving_add_left MeasureTheory.volume
        (b₀ + p * u₀)).quasiMeasurePreserving.ae (h_sheared_ftc_all p)] with r' hr' u₁ hu₁ u₂ hu₂
      have h_eq1 : (b₀ + p * u₀ + r') - p * u₂ = b₀ - p * (u₂ - u₀) + r' := by ring
      have h_eq2 : (b₀ + p * u₀ + r') - p * u₁ = b₀ - p * (u₁ - u₀) + r' := by ring
      have h_eq_int : (fun u => (∑ j : Fin n, (c j - p) * a j ((b₀ + p * u₀ + r') - p * u, u)) +
          D ((b₀ + p * u₀ + r') - p * u, u)) =
          (fun u => Ψ (b₀ - p * (u - u₀) + r', u)) := by
        ext u
        have hu_eq : (b₀ + p * u₀ + r') - p * u = b₀ - p * (u - u₀) + r' := by ring
        simp only [Ψ, hu_eq]
      have h_res : Φ ((b₀ + p * u₀ + r') - p * u₂, u₂) - Φ ((b₀ + p * u₀ + r') - p * u₁, u₁) =
          ∫ u in u₁..u₂, ((∑ j : Fin n, (c j - p) * a j ((b₀ + p * u₀ + r') - p * u, u)) +
            D ((b₀ + p * u₀ + r') - p * u, u)) := hr' u₁ hu₁ u₂ hu₂
      rwa [h_eq1, h_eq2, h_eq_int] at h_res
    let g_cont : ℝ → ℝ := fun u => 2 * b u + (1 - γ) * m * u + 2 * S u - β * u - τ
    have hg_der : HasDerivAt g_cont k u₀ := by
      have h1 : HasDerivAt (fun u => 2 * b u) (2 * (-p)) u₀ := hb_der.const_mul 2
      have h2 : HasDerivAt (fun u => (1 - γ) * m * u) ((1 - γ) * m * 1) u₀ :=
        (hasDerivAt_id u₀).const_mul ((1 - γ) * m)
      have h3 : HasDerivAt (fun u => 2 * S u) (2 * s) u₀ := hS_der.const_mul 2
      have h4 : HasDerivAt (fun u => β * u) (β * 1) u₀ := (hasDerivAt_id u₀).const_mul β
      have h5 := (((h1.add h2).add h3).sub h4).sub_const τ
      convert h5 using 1
      ring
    have h_neg_ioi : Filter.Tendsto (fun ρ : ℝ => -ρ)
        (nhdsWithin 0 (Set.Ioi 0)) (nhdsWithin 0 ({0}ᶜ)) := by
      have h_nhds : Filter.Tendsto (fun ρ : ℝ => -ρ) (nhdsWithin 0 (Set.Ioi 0)) (nhds 0) := by
        simpa using (continuous_neg.tendsto (0 : ℝ)).mono_left nhdsWithin_le_nhds
      refine tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within _ h_nhds ?_
      filter_upwards [self_mem_nhdsWithin] with ρ (hρ : 0 < ρ)
      exact Set.mem_compl_singleton_iff.mpr (neg_ne_zero.mpr hρ.ne')
    have hg_slope_r : Filter.Tendsto (fun ρ : ℝ => ρ⁻¹ * (g_cont (u₀ + ρ) - g_cont u₀))
        (nhdsWithin 0 (Set.Ioi 0)) (nhds k) := by
      simpa [smul_eq_mul] using hg_der.tendsto_slope_zero_right
    have hg_slope_l : Filter.Tendsto (fun ρ : ℝ => ρ⁻¹ * (g_cont u₀ - g_cont (u₀ - ρ)))
        (nhdsWithin 0 (Set.Ioi 0)) (nhds k) := by
      have h0 := hg_der.tendsto_slope_zero.comp h_neg_ioi
      refine h0.congr' ?_
      filter_upwards [self_mem_nhdsWithin] with ρ (hρ : 0 < ρ)
      change (-ρ)⁻¹ * (g_cont (u₀ + -ρ) - g_cont u₀) = ρ⁻¹ * (g_cont u₀ - g_cont (u₀ - ρ))
      have h_sub : u₀ + -ρ = u₀ - ρ := by ring
      rw [h_sub]
      field_simp [hρ.ne']
      ring
    have hg_sym : Filter.Tendsto (fun ρ : ℝ => (2 * ρ)⁻¹ * (g_cont (u₀ + ρ) - g_cont (u₀ - ρ)))
        (nhdsWithin 0 (Set.Ioi 0)) (nhds k) := by
      have h_add := (hg_slope_r.add hg_slope_l).const_mul (1 / 2 : ℝ)
      have hk : (1 / 2 : ℝ) * (k + k) = k := by ring
      rw [hk] at h_add
      refine h_add.congr' ?_
      filter_upwards [self_mem_nhdsWithin] with ρ (hρ : 0 < ρ)
      field_simp [hρ.ne']
      ring
    have hb_err_r : Filter.Tendsto (fun ρ : ℝ => ρ⁻¹ * |b (u₀ + ρ) - b₀ + p * ρ|)
        (nhdsWithin 0 (Set.Ioi 0)) (nhds 0) := by
      have h0 : Filter.Tendsto (fun ρ : ℝ => ρ⁻¹ * (b (u₀ + ρ) - b₀))
          (nhdsWithin 0 (Set.Ioi 0)) (nhds (-p)) := by
        simpa [b₀, smul_eq_mul] using hb_der.tendsto_slope_zero_right
      have h1 : Filter.Tendsto (fun ρ : ℝ => ρ⁻¹ * (b (u₀ + ρ) - b₀) + p)
          (nhdsWithin 0 (Set.Ioi 0)) (nhds (-p + p)) := h0.add tendsto_const_nhds
      rw [neg_add_cancel] at h1
      have h2 := h1.abs
      rw [abs_zero] at h2
      refine h2.congr' ?_
      filter_upwards [self_mem_nhdsWithin] with ρ (hρ : 0 < ρ)
      have h_eq : ρ⁻¹ * (b (u₀ + ρ) - b₀) + p = ρ⁻¹ * (b (u₀ + ρ) - b₀ + p * ρ) := by
        field_simp [hρ.ne']
      rw [h_eq, abs_mul, abs_of_pos (inv_pos.mpr hρ)]
    have hb_err_l : Filter.Tendsto (fun ρ : ℝ => ρ⁻¹ * |b (u₀ - ρ) - b₀ - p * ρ|)
        (nhdsWithin 0 (Set.Ioi 0)) (nhds 0) := by
      have h0_raw := hb_der.tendsto_slope_zero.comp h_neg_ioi
      have h0 : Filter.Tendsto (fun ρ : ℝ => (-ρ)⁻¹ * (b (u₀ + -ρ) - b₀))
          (nhdsWithin 0 (Set.Ioi 0)) (nhds (-p)) :=
        h0_raw.congr' (Filter.Eventually.of_forall (fun _ => by simp [b₀, smul_eq_mul]))
      have h1 := h0.neg.sub (tendsto_const_nhds (x := p))
      rw [neg_neg, sub_self] at h1
      have h2 := h1.abs
      rw [abs_zero] at h2
      refine h2.congr' ?_
      filter_upwards [self_mem_nhdsWithin] with ρ (hρ : 0 < ρ)
      have h_eq : -((-ρ)⁻¹ * (b (u₀ + -ρ) - b₀)) - p = ρ⁻¹ * (b (u₀ - ρ) - b₀ - p * ρ) := by
        have h_sub : u₀ + -ρ = u₀ - ρ := by ring
        rw [h_sub]
        field_simp [hρ.ne']
      rw [h_eq, abs_mul, abs_of_pos (inv_pos.mpr hρ)]
    have h_collar : ∀ (a_side : Fin n → ℝ) (D_side : ℝ)
