    have h_inv_ub : (m_cell k z₀ * m'_w0)⁻¹ ≤ K_dom := by
      have h_eq : (c₁ / (2 * (J₂ : ℝ)))⁻¹ = K_dom := by dsimp [K_dom]; rw [inv_div]
      rw [← h_eq]
