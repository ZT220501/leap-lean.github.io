      Real.rpow_le_rpow_of_exponent_ge hε₀ hε_le1 (by linarith)
    rwa [Real.rpow_zero] at h0

  
  have h_b1_OP : ∀ (p_c : ℕ × (ℤ × ℤ) × (ℤ × ℤ)) (r_idx : ℕ),
      ((Finset.univ.filter (fun o : Fin N_O => P_buf o = p_c ∧ r_O o = r_idx)).card : ℝ) ≤
        C_OP * ε ^ (-(4 * h)) := by
    intro p_c r_idx
    let F := Finset.univ.filter (fun o : Fin N_O => P_buf o = p_c ∧ r_O o = r_idx)
    by_cases hF : F.Nonempty
    · obtain ⟨o₁, ho₁⟩ := hF
      rw [Finset.mem_filter] at ho₁
      have hqr : r_idx / 2 ^ (m_t - m_r) = p_c.1 := by
        have h1 := congrArg Prod.fst ho₁.2.1
        dsimp only [P_buf] at h1
        unfold coarseOfFineCell fineOutCell atomOutCell at h1
        simpa [ho₁.2.2] using h1
      let C_r := ((p_c.1 : ℝ) + 1 / 2) * ((2 : ℝ) ^ m_r)⁻¹
      let C_t := ((r_idx : ℝ) + 1 / 2) * ((2 : ℝ) ^ m_t)⁻¹
      have hcd : |C_r - C_t| ≤ ε ^ r := by
        dsimp only [C_r, C_t, r]
        rw [← hqr]
        exact h_clock_drift r_idx
      let V_mid := fineCellCenterV S_V τ_V p_c.2.1
      let Y_mid := fineCellCenterX S_X τ_X p_c.2.2
      let X_mid := Y_mid - (C_r - C_t) • V_mid
      let ρ_obs := ε ^ u_t
      let σ_obs := (lam_sys * ρ_obs)⁻¹
      have hρ_pos : 0 < ρ_obs := Real.rpow_pos_of_pos hε₀ u_t
      have hσ_pos : 0 < σ_obs := inv_pos.mpr (mul_pos hlam_pos hρ_pos)
      let s₁ := ρ_obs / 2
      let s₂ := σ_obs / 2
      have hs₁ : 0 < s₁ := half_pos hρ_pos
      have hs₂ : 0 < s₂ := half_pos hσ_pos
      let φ : Fin N_O → (ℤ × ℤ) × (ℤ × ℤ) := fun o =>
        (roundShift2D s₁ 0 (V_O o), roundShift2D s₂ 0 (X_O o))
      have h_F_geom : ∀ o ∈ F, ‖V_O o - V_mid‖ ≤ S_V ∧ ‖X_O o - X_mid‖ ≤ 2 * S_X := by
        intro o ho
        rw [Finset.mem_filter] at ho
        have hp_o := ho.2.1
        have hr_o := ho.2.2
        have h_kv : ((roundShift2D (ε ^ u_t) τ_V (V_O o)).1 / (M_L : ℤ),
                     (roundShift2D (ε ^ u_t) τ_V (V_O o)).2 / (M_L : ℤ)) = p_c.2.1 :=
          congrArg (fun x => x.2.1) hp_o
        have h_kx : ((roundShift2D (ε ^ (r + u_t)) τ_X (X_O o + (C_r - C_t) • V_O o)).1 / (M_L : ℤ),
                     (roundShift2D (ε ^ (r + u_t)) τ_X (X_O o + (C_r - C_t) • V_O o)).2 / (M_L : ℤ)) = p_c.2.2 := by
          have h2 := congrArg (fun x => x.2.2) hp_o
          dsimp only [P_buf] at h2
          unfold coarseOfFineCell fineOutCell atomOutCell at h2
          simpa only [hr_o, hqr, C_r, C_t, u_t] using h2
        have hv := (h_mid_coarse M_L (ε ^ u_t) τ_V (V_O o) p_c.2.1 hML hρ_pos h_kv).2.2
        have hy := (h_mid_coarse M_L (ε ^ (r + u_t)) τ_X (X_O o + (C_r - C_t) • V_O o) p_c.2.2
          hML (Real.rpow_pos_of_pos hε₀ _) h_kx).2.2
        rw [← h_centerX_eq] at hy
        refine ⟨hv, ?_⟩
        have h_id : X_O o - X_mid =
            ((X_O o + (C_r - C_t) • V_O o) - Y_mid) - (C_r - C_t) • (V_O o - V_mid) := by
          dsimp only [X_mid]; module
        have h_er_SV : ε ^ r * S_V = S_X := by
          dsimp only [S_V, S_X]
          rw [← mul_assoc, mul_comm (ε ^ r) (M_L : ℝ), mul_assoc, ← Real.rpow_add hε₀]
        calc ‖X_O o - X_mid‖
            ≤ ‖(X_O o + (C_r - C_t) • V_O o) - Y_mid‖ + ‖(C_r - C_t) • (V_O o - V_mid)‖ := by
              rw [h_id]; exact norm_sub_le _ _
          _ = ‖(X_O o + (C_r - C_t) • V_O o) - Y_mid‖ + |C_r - C_t| * ‖V_O o - V_mid‖ := by
              rw [norm_smul, Real.norm_eq_abs]
          _ ≤ S_X + ε ^ r * S_V :=
              add_le_add hy (mul_le_mul hcd hv (norm_nonneg _) (Real.rpow_nonneg hε₀.le _))
          _ = 2 * S_X := by rw [h_er_SV]; ring
      let Im1 := F.image (fun o => roundShift2D s₁ 0 (V_O o))
      let Im2 := F.image (fun o => roundShift2D s₂ 0 (X_O o))
      have hIm_sub : F.image φ ⊆ Im1 ×ˢ Im2 := by
        intro k hk
        obtain ⟨o, ho, rfl⟩ := Finset.mem_image.mp hk
        exact Finset.mem_product.mpr ⟨Finset.mem_image_of_mem _ ho, Finset.mem_image_of_mem _ ho⟩
      have hIm1_card : (Im1.card : ℝ) ≤ (4 * (M_L : ℝ) + 2) ^ 2 := by
        have hc := h_box2_card s₁ S_V 0 V_mid Im1 hs₁ (by positivity) (fun k hk => by
          obtain ⟨o, ho, rfl⟩ := Finset.mem_image.mp hk
          exact ⟨V_O o, rfl, (h_F_geom o ho).1⟩)
        have h_rat : 2 * S_V / s₁ + 2 = 4 * (M_L : ℝ) + 2 := by
          dsimp only [S_V, s₁, ρ_obs]
          field_simp [hρ_pos.ne']; ring
        rwa [h_rat] at hc
      have hIm2_card : (Im2.card : ℝ) ≤ (8 * (M_L : ℝ) * B_sys + 2) ^ 2 * ε ^ (-(4 * h)) := by
        have hc := h_box2_card s₂ (2 * S_X) 0 X_mid Im2 hs₂ (by positivity) (fun k hk => by
          obtain ⟨o, ho, rfl⟩ := Finset.mem_image.mp hk
          exact ⟨X_O o, rfl, (h_F_geom o ho).2⟩)
        have h_rat : 2 * (2 * S_X) / s₂ ≤ 8 * (M_L : ℝ) * B_sys * ε ^ (-(2 * h)) := by
          have h_eq : 2 * (2 * S_X) / s₂ = 8 * (M_L : ℝ) * (lam_sys * (ε ^ (r + u_t) * ρ_obs)) := by
            dsimp only [S_X, s₂, σ_obs]
            have hne : (lam_sys * ρ_obs)⁻¹ ≠ 0 := hσ_pos.ne'
            field_simp [hne]; ring
          have hexp : ε ^ (r + u_t) * ρ_obs = ε ^ (H_P - 2 * h) := by
            dsimp only [ρ_obs, r, u_t]
            rw [← Real.rpow_add hε₀]; congr 1; ring
          have hlam_prod : lam_sys * ε ^ (H_P - 2 * h) ≤ B_sys * ε ^ (-(2 * h)) := by
            calc lam_sys * ε ^ (H_P - 2 * h)
                ≤ (B_sys * ε ^ (-H_P)) * ε ^ (H_P - 2 * h) :=
                  mul_le_mul_of_nonneg_right hlam_hi (Real.rpow_nonneg hε₀.le _)
              _ = B_sys * (ε ^ (-H_P) * ε ^ (H_P - 2 * h)) := by ring
              _ = B_sys * ε ^ (-(2 * h)) := by
                  rw [← Real.rpow_add hε₀]; congr 2; ring
          rw [h_eq, hexp]
          calc 8 * (M_L : ℝ) * (lam_sys * ε ^ (H_P - 2 * h))
              ≤ 8 * (M_L : ℝ) * (B_sys * ε ^ (-(2 * h))) :=
                mul_le_mul_of_nonneg_left hlam_prod (by positivity)
            _ = 8 * (M_L : ℝ) * B_sys * ε ^ (-(2 * h)) := by ring
        have h_base : 2 * (2 * S_X) / s₂ + 2 ≤ (8 * (M_L : ℝ) * B_sys + 2) * ε ^ (-(2 * h)) := by
          nlinarith [h_rat, h1_le_e2h]
        have h_sq : (2 * (2 * S_X) / s₂ + 2) ^ 2 ≤
            ((8 * (M_L : ℝ) * B_sys + 2) * ε ^ (-(2 * h))) ^ 2 :=
          pow_le_pow_left₀ (by positivity) h_base 2
        have h_e4h : (ε ^ (-(2 * h))) ^ 2 = ε ^ (-(4 * h)) := by
          rw [sq, ← Real.rpow_add hε₀]; congr 1; ring
        calc (Im2.card : ℝ) ≤ (2 * (2 * S_X) / s₂ + 2) ^ 2 := hc
          _ ≤ ((8 * (M_L : ℝ) * B_sys + 2) * ε ^ (-(2 * h))) ^ 2 := h_sq
          _ = (8 * (M_L : ℝ) * B_sys + 2) ^ 2 * (ε ^ (-(2 * h))) ^ 2 := mul_pow _ _ 2
          _ = (8 * (M_L : ℝ) * B_sys + 2) ^ 2 * ε ^ (-(4 * h)) := by rw [h_e4h]
      have h_fib_le : ∀ k ∈ F.image φ, ((F.filter (fun o => φ o = k)).card : ℝ) ≤ (N_mult : ℝ) := by
        intro k _
        let v₀ := fineCellCenterV s₁ 0 k.1
        let x₀ := fineCellCenterV s₂ 0 k.2
        have hp_k := hpack r_idx v₀ x₀
        refine le_trans ?_ hp_k
        exact_mod_cast Finset.card_le_card (fun o ho => by
          rw [Finset.mem_filter] at ho ⊢
          have ho1 := ho.1
          dsimp only [F] at ho1
          have hoF := (Finset.mem_filter.mp ho1).2
          have hk1 : roundShift2D s₁ 0 (V_O o) = k.1 := congrArg Prod.fst ho.2
          have hk2 : roundShift2D s₂ 0 (X_O o) = k.2 := congrArg Prod.snd ho.2
          have hv := (h_mid_unit s₁ 0 (V_O o) k.1 hs₁ hk1).2.2
          have hx := (h_mid_unit s₂ 0 (X_O o) k.2 hs₂ hk2).2.2
          exact ⟨Finset.mem_univ o, hoF.2, by dsimp only [s₁, ρ_obs, u_t] at hv ⊢; linarith,
                 by dsimp only [s₂, σ_obs, ρ_obs, u_t] at hx ⊢; linarith⟩)
      have hF_bi : F ⊆ (F.image φ).biUnion (fun k => F.filter (fun o => φ o = k)) := by
        intro o ho
        exact Finset.mem_biUnion.mpr ⟨φ o, Finset.mem_image_of_mem φ ho,
          Finset.mem_filter.mpr ⟨ho, rfl⟩⟩
      have hc_bi : F.card ≤ ∑ k ∈ F.image φ, (F.filter (fun o => φ o = k)).card :=
        le_trans (Finset.card_le_card hF_bi) Finset.card_biUnion_le
      have hc_r : (F.card : ℝ) ≤ ((F.image φ).card : ℝ) * (N_mult : ℝ) := by
        calc (F.card : ℝ)
            ≤ ∑ k ∈ F.image φ, ((F.filter (fun o => φ o = k)).card : ℝ) := by exact_mod_cast hc_bi
          _ ≤ ∑ _ ∈ F.image φ, (N_mult : ℝ) := Finset.sum_le_sum h_fib_le
          _ = ((F.image φ).card : ℝ) * (N_mult : ℝ) := by simp
      have hIm_prod : ((F.image φ).card : ℝ) ≤ (Im1.card : ℝ) * (Im2.card : ℝ) := by
        have h1 : (F.image φ).card ≤ (Im1 ×ˢ Im2).card := Finset.card_le_card hIm_sub
        rw [Finset.card_product] at h1
        exact_mod_cast h1
      calc (F.card : ℝ) ≤ ((F.image φ).card : ℝ) * (N_mult : ℝ) := hc_r
        _ ≤ ((Im1.card : ℝ) * (Im2.card : ℝ)) * (N_mult : ℝ) :=
            mul_le_mul_of_nonneg_right hIm_prod (Nat.cast_nonneg _)
        _ ≤ ((4 * (M_L : ℝ) + 2) ^ 2 * ((8 * (M_L : ℝ) * B_sys + 2) ^ 2 * ε ^ (-(4 * h)))) *
              (N_mult : ℝ) := by
            refine mul_le_mul_of_nonneg_right ?_ (Nat.cast_nonneg _)
            exact mul_le_mul hIm1_card hIm2_card (Nat.cast_nonneg _) (by positivity)
        _ = C_OP * ε ^ (-(4 * h)) := by dsimp only [C_OP]; ring
    · change (F.card : ℝ) ≤ _
      rw [Finset.not_nonempty_iff_eq_empty.mp hF]
      simp; positivity

  
  have h_b2_BD : ∀ d : Fin N_D,
      (((Finset.univ.filter (fun o : Fin N_O =>
          @ite Prop (0 < p o d) (Classical.propDecidable _) True False)).image
            (fun o => B_P (P_buf o))).card : ℝ) ≤ C_BD := by
    intro d
    let F_d := Finset.univ.filter (fun o : Fin N_O =>
      @ite Prop (0 < p o d) (Classical.propDecidable _) True False)
    let q_d := r_D d / 2 ^ (m_t - m_r)
    let C_rd := ((q_d : ℝ) + 1 / 2) * ((2 : ℝ) ^ m_r)⁻¹
    let C_td := ((r_D d : ℝ) + 1 / 2) * ((2 : ℝ) ^ m_t)⁻¹
    have hcd_d : |C_rd - C_td| ≤ ε ^ r := h_clock_drift (r_D d)
    let Y_Dd := X_D d + (C_rd - C_td) • V_D d
    let J1 := F_d.image (fun o => (B_P (P_buf o)).2.1)
    let J2 := F_d.image (fun o => (B_P (P_buf o)).2.2)
    have h_geom_d : ∀ o ∈ F_d,
        (B_P (P_buf o)).1 = q_d ∧
        ‖fineCellCenterV S_V τ_V (P_buf o).2.1 - V_D d‖ ≤ (2 * B_sys + (M_L : ℝ)) * ε ^ b_min ∧
        ‖fineCellCenterX S_X τ_X (P_buf o).2.2 - Y_Dd‖ ≤
          (4 * B_sys + (M_L : ℝ)) * ε ^ (b_min + r) := by
      intro o ho
      have hpod : 0 < p o d := by
        rw [Finset.mem_filter] at ho
        by_contra hnp
        have hf := ho.2
        simp [hnp] at hf
      obtain ⟨hb_lo, _, hr_eq, hv_e, hv_p, hx_e, hx_p⟩ := hp_geom o d hpod
      obtain ⟨hba_d, he_d⟩ := hd_unit d
      have h1 : (B_P (P_buf o)).1 = q_d := by
        dsimp only [B_P, P_buf, coarseOfFineCell, fineOutCell, atomOutCell, q_d]
        rw [hr_eq]
      have heb_ut : ε ^ u_t ≤ ε ^ b_min :=
        Real.rpow_le_rpow_of_exponent_ge hε₀ hε_le1 hb_min_ut
      have heb_rut : ε ^ (r + u_t) ≤ ε ^ (b_min + r) :=
        Real.rpow_le_rpow_of_exponent_ge hε₀ hε_le1 (by dsimp only [u_t]; linarith)
      have heb_b : ε ^ (b_D d) ≤ ε ^ b_min :=
        Real.rpow_le_rpow_of_exponent_ge hε₀ hε_le1 hb_lo
      have heb_bt : ε ^ (b_D d + t) ≤ ε ^ (b_min + r) :=
        Real.rpow_le_rpow_of_exponent_ge hε₀ hε_le1 (by dsimp only [r]; linarith)
      have hv_norm : ‖V_O o - V_D d‖ ≤ 2 * B_sys * ε ^ b_min := by
        have hpv := h_parseval (V_O o - V_D d) (e_D d) (B_sys * ε ^ (b_D d)) (B_sys * ε ^ (a_D d))
          he_d hv_e hv_p (by positivity)
          (mul_le_mul_of_nonneg_left (Real.rpow_le_rpow_of_exponent_ge hε₀ hε_le1 hba_d) (by linarith))
        calc ‖V_O o - V_D d‖ ≤ 2 * (B_sys * ε ^ (b_D d)) := hpv
          _ = 2 * B_sys * ε ^ (b_D d) := by ring
          _ ≤ 2 * B_sys * ε ^ b_min := mul_le_mul_of_nonneg_left heb_b (by linarith)
      have hx_norm : ‖X_O o - X_D d‖ ≤ 2 * B_sys * ε ^ (b_min + r) := by
        have hpx := h_parseval (X_O o - X_D d) (e_D d) (B_sys * ε ^ (b_D d + t))
          (B_sys * ε ^ (a_D d + t)) he_d hx_e hx_p (by positivity)
          (mul_le_mul_of_nonneg_left (Real.rpow_le_rpow_of_exponent_ge hε₀ hε_le1 (by linarith)) (by linarith))
        calc ‖X_O o - X_D d‖ ≤ 2 * (B_sys * ε ^ (b_D d + t)) := hpx
          _ = 2 * B_sys * ε ^ (b_D d + t) := by ring
          _ ≤ 2 * B_sys * ε ^ (b_min + r) := mul_le_mul_of_nonneg_left heb_bt (by linarith)
      have hv_mid : ‖V_O o - fineCellCenterV S_V τ_V (P_buf o).2.1‖ ≤ S_V :=
        (h_mid_coarse M_L (ε ^ u_t) τ_V (V_O o) (P_buf o).2.1 hML (Real.rpow_pos_of_pos hε₀ _) rfl).2.2
      have hy_mid : ‖(X_O o + (C_rd - C_td) • V_O o) - fineCellCenterX S_X τ_X (P_buf o).2.2‖ ≤ S_X := by
        have hk2 : ((roundShift2D (ε ^ (r + u_t)) τ_X (X_O o + (C_rd - C_td) • V_O o)).1 / (M_L : ℤ),
                    (roundShift2D (ε ^ (r + u_t)) τ_X (X_O o + (C_rd - C_td) • V_O o)).2 / (M_L : ℤ)) =
            (P_buf o).2.2 := by
          dsimp only [P_buf, coarseOfFineCell, fineOutCell, atomOutCell, C_rd, C_td, q_d, u_t]
          rw [hr_eq]
        rw [h_centerX_eq]
        exact (h_mid_coarse M_L (ε ^ (r + u_t)) τ_X (X_O o + (C_rd - C_td) • V_O o) (P_buf o).2.2
          hML (Real.rpow_pos_of_pos hε₀ _) hk2).2.2
      refine ⟨h1, ?_, ?_⟩
      · have h_tri : ‖fineCellCenterV S_V τ_V (P_buf o).2.1 - V_D d‖ ≤
            ‖V_O o - V_D d‖ + ‖V_O o - fineCellCenterV S_V τ_V (P_buf o).2.1‖ := by
          have hid : fineCellCenterV S_V τ_V (P_buf o).2.1 - V_D d =
              (V_O o - V_D d) - (V_O o - fineCellCenterV S_V τ_V (P_buf o).2.1) := by abel
          rw [hid]; exact norm_sub_le _ _
        have hSV_le : S_V ≤ (M_L : ℝ) * ε ^ b_min :=
          mul_le_mul_of_nonneg_left heb_ut (Nat.cast_nonneg _)
        linarith
      · have hid : fineCellCenterX S_X τ_X (P_buf o).2.2 - Y_Dd =
            (X_O o - X_D d) + (C_rd - C_td) • (V_O o - V_D d) -
              ((X_O o + (C_rd - C_td) • V_O o) - fineCellCenterX S_X τ_X (P_buf o).2.2) := by
          dsimp only [Y_Dd]; module
        have h_smul : ‖(C_rd - C_td) • (V_O o - V_D d)‖ ≤ 2 * B_sys * ε ^ (b_min + r) := by
          rw [norm_smul, Real.norm_eq_abs]
          calc |C_rd - C_td| * ‖V_O o - V_D d‖
              ≤ ε ^ r * (2 * B_sys * ε ^ b_min) :=
                mul_le_mul hcd_d hv_norm (norm_nonneg _) (Real.rpow_nonneg hε₀.le _)
            _ = 2 * B_sys * (ε ^ b_min * ε ^ r) := by ring
            _ = 2 * B_sys * ε ^ (b_min + r) := by rw [← Real.rpow_add hε₀]
        have hSX_le : S_X ≤ (M_L : ℝ) * ε ^ (b_min + r) :=
          mul_le_mul_of_nonneg_left heb_rut (Nat.cast_nonneg _)
        have h_tri1 := norm_sub_le ((X_O o - X_D d) + (C_rd - C_td) • (V_O o - V_D d))
          ((X_O o + (C_rd - C_td) • V_O o) - fineCellCenterX S_X τ_X (P_buf o).2.2)
        have h_tri2 := norm_add_le (X_O o - X_D d) ((C_rd - C_td) • (V_O o - V_D d))
        rw [hid]; linarith
    have hc_inj : (F_d.image (fun o => B_P (P_buf o))).card ≤ (J1 ×ˢ J2).card := by
      refine Finset.card_le_card_of_injOn (fun x => x.2) ?_ ?_
      · intro x hx
        obtain ⟨o, ho, rfl⟩ := Finset.mem_image.mp hx
        simp only [Finset.coe_product, Set.mem_prod, Finset.mem_coe]
        exact ⟨Finset.mem_image_of_mem _ ho, Finset.mem_image_of_mem _ ho⟩
      · intro x hx y hy hxy
        obtain ⟨ox, hox, rfl⟩ := Finset.mem_image.mp hx
        obtain ⟨oy, hoy, rfl⟩ := Finset.mem_image.mp hy
        exact Prod.ext ((h_geom_d ox hox).1.trans (h_geom_d oy hoy).1.symm) hxy
    rw [Finset.card_product] at hc_inj
    have hsb1 : 0 < ε ^ b_min := Real.rpow_pos_of_pos hε₀ _
    have hsb2 : 0 < ε ^ (b_min + r) := Real.rpow_pos_of_pos hε₀ _
    have hcJ1 : (J1.card : ℝ) ≤ (4 * B_sys + 2 * (M_L : ℝ) + 2) ^ 2 := by
      have hc := h_box2_card (ε ^ b_min) ((2 * B_sys + (M_L : ℝ)) * ε ^ b_min) 0 (V_D d) J1
        hsb1 (by positivity) (fun k hk => by
          obtain ⟨o, ho, rfl⟩ := Finset.mem_image.mp hk
          exact ⟨fineCellCenterV S_V τ_V (P_buf o).2.1, rfl, (h_geom_d o ho).2.1⟩)
      have h_rat : 2 * ((2 * B_sys + (M_L : ℝ)) * ε ^ b_min) / ε ^ b_min + 2 =
          4 * B_sys + 2 * (M_L : ℝ) + 2 := by field_simp [hsb1.ne']; ring
      rwa [h_rat] at hc
    have hcJ2 : (J2.card : ℝ) ≤ (8 * B_sys + 2 * (M_L : ℝ) + 2) ^ 2 := by
      have hc := h_box2_card (ε ^ (b_min + r)) ((4 * B_sys + (M_L : ℝ)) * ε ^ (b_min + r)) 0 Y_Dd J2
        hsb2 (by positivity) (fun k hk => by
          obtain ⟨o, ho, rfl⟩ := Finset.mem_image.mp hk
          exact ⟨fineCellCenterX S_X τ_X (P_buf o).2.2, rfl, (h_geom_d o ho).2.2⟩)
      have h_rat : 2 * ((4 * B_sys + (M_L : ℝ)) * ε ^ (b_min + r)) / ε ^ (b_min + r) + 2 =
          8 * B_sys + 2 * (M_L : ℝ) + 2 := by field_simp [hsb2.ne']; ring
      rwa [h_rat] at hc
    calc ((F_d.image (fun o => B_P (P_buf o))).card : ℝ)
        ≤ (J1.card : ℝ) * (J2.card : ℝ) := by exact_mod_cast hc_inj
      _ ≤ (4 * B_sys + 2 * (M_L : ℝ) + 2) ^ 2 * (8 * B_sys + 2 * (M_L : ℝ) + 2) ^ 2 :=
          mul_le_mul hcJ1 hcJ2 (Nat.cast_nonneg _) (by positivity)

  
  have h_b3_iso : ∀ b_p : ℕ × (ℤ × ℤ) × (ℤ × ℤ),
      (((Finset.univ.filter (fun o : Fin N_O => B_P (P_buf o) = b_p)).image D_iso).card : ℝ) ≤
        C_iso * ε ^ (-(6 * h)) := by
    intro b_p
    let F_bp := Finset.univ.filter (fun o : Fin N_O => B_P (P_buf o) = b_p)
    let K : ℕ := 2 ^ (m_t - m_r)
    have hK_pos : 0 < K := pow_pos Nat.zero_lt_two _
    let V_B := fineCellCenterV (ε ^ b_min) 0 b_p.2.1
    let Y_B := fineCellCenterV (ε ^ (b_min + r)) 0 b_p.2.2
    have hsb1 : 0 < ε ^ b_min := Real.rpow_pos_of_pos hε₀ _
    have hsb2 : 0 < ε ^ (b_min + r) := Real.rpow_pos_of_pos hε₀ _
    have hsbt : 0 < ε ^ (b_min + t) := Real.rpow_pos_of_pos hε₀ _
    have heb_ut : ε ^ u_t ≤ ε ^ b_min :=
      Real.rpow_le_rpow_of_exponent_ge hε₀ hε_le1 hb_min_ut
    have heb_rut : ε ^ (r + u_t) ≤ ε ^ (b_min + r) :=
      Real.rpow_le_rpow_of_exponent_ge hε₀ hε_le1 (by dsimp only [u_t]; linarith)
    have h_bi : F_bp.image D_iso ⊆ (Finset.range K).biUnion (fun k_loc =>
        (F_bp.filter (fun o => r_O o = K * b_p.1 + k_loc)).image D_iso) := by
      intro x hx
      obtain ⟨o, ho, rfl⟩ := Finset.mem_image.mp hx
      have hbp := (Finset.mem_filter.mp ho).2
      have hq : r_O o / K = b_p.1 := congrArg Prod.fst hbp
      let k_loc := r_O o % K
      have hk_mem : k_loc ∈ Finset.range K := Finset.mem_range.mpr (Nat.mod_lt (r_O o) hK_pos)
      have hr_eq : r_O o = K * b_p.1 + k_loc := by
        have hd := Nat.div_add_mod (r_O o) K
        rw [hq] at hd; exact hd.symm
      exact Finset.mem_biUnion.mpr ⟨k_loc, hk_mem,
        Finset.mem_image_of_mem D_iso (Finset.mem_filter.mpr ⟨ho, hr_eq⟩)⟩
    have h_slice : ∀ k_loc ∈ Finset.range K,
        (((F_bp.filter (fun o => r_O o = K * b_p.1 + k_loc)).image D_iso).card : ℝ) ≤
          (2 * (M_L : ℝ) + 4) ^ 2 * (4 * (M_L : ℝ) + 6) ^ 2 * ε ^ (-(4 * h)) := by
      intro k_loc hk_loc
      let r_val := K * b_p.1 + k_loc
      have hqr_val : r_val / K = b_p.1 := by
        dsimp only [r_val]
        rw [Nat.mul_add_div hK_pos, Nat.div_eq_of_lt (Finset.mem_range.mp hk_loc), add_zero]
      let C_rv := ((b_p.1 : ℝ) + 1 / 2) * ((2 : ℝ) ^ m_r)⁻¹
      let C_tv := ((r_val : ℝ) + 1 / 2) * ((2 : ℝ) ^ m_t)⁻¹
      have hcd_v : |C_rv - C_tv| ≤ ε ^ r := by
        dsimp only [C_rv, C_tv, r]
        rw [← hqr_val]
        exact h_clock_drift r_val
      let X_B := Y_B - (C_rv - C_tv) • V_B
      let G := F_bp.filter (fun o => r_O o = r_val)
      have hG_geom : ∀ o ∈ G,
          ‖V_O o - V_B‖ ≤ ((M_L : ℝ) + 1) * ε ^ b_min ∧
          ‖X_O o - X_B‖ ≤ (2 * (M_L : ℝ) + 2) * ε ^ (b_min + r) := by
        intro o ho
        obtain ⟨ho_bp, hr_o⟩ := Finset.mem_filter.mp ho
        have hbp := (Finset.mem_filter.mp ho_bp).2
        have hb1 : roundShift2D (ε ^ b_min) 0 (fineCellCenterV S_V τ_V (P_buf o).2.1) = b_p.2.1 :=
          congrArg (fun z => z.2.1) hbp
        have hb2 : roundShift2D (ε ^ (b_min + r)) 0 (fineCellCenterX S_X τ_X (P_buf o).2.2) = b_p.2.2 :=
          congrArg (fun z => z.2.2) hbp
        have hv1 := (h_mid_coarse M_L (ε ^ u_t) τ_V (V_O o) (P_buf o).2.1 hML
          (Real.rpow_pos_of_pos hε₀ _) rfl).2.2
        have hv2 := (h_mid_unit (ε ^ b_min) 0 (fineCellCenterV S_V τ_V (P_buf o).2.1) b_p.2.1 hsb1 hb1).2.2
        have hSV_le : S_V ≤ (M_L : ℝ) * ε ^ b_min :=
          mul_le_mul_of_nonneg_left heb_ut (Nat.cast_nonneg _)
        have hv_tot : ‖V_O o - V_B‖ ≤ ((M_L : ℝ) + 1) * ε ^ b_min := by
          have hid : V_O o - V_B = (V_O o - fineCellCenterV S_V τ_V (P_buf o).2.1) +
              (fineCellCenterV S_V τ_V (P_buf o).2.1 - V_B) := by abel
          have htri := norm_add_le (V_O o - fineCellCenterV S_V τ_V (P_buf o).2.1)
            (fineCellCenterV S_V τ_V (P_buf o).2.1 - V_B)
          rw [hid]; linarith
        have hk2 : ((roundShift2D (ε ^ (r + u_t)) τ_X (X_O o + (C_rv - C_tv) • V_O o)).1 / (M_L : ℤ),
                    (roundShift2D (ε ^ (r + u_t)) τ_X (X_O o + (C_rv - C_tv) • V_O o)).2 / (M_L : ℤ)) =
            (P_buf o).2.2 := by
          dsimp only [P_buf, coarseOfFineCell, fineOutCell, atomOutCell, C_rv, C_tv, u_t]
          rw [hr_o, hqr_val]
        have hy1 := (h_mid_coarse M_L (ε ^ (r + u_t)) τ_X (X_O o + (C_rv - C_tv) • V_O o)
          (P_buf o).2.2 hML (Real.rpow_pos_of_pos hε₀ _) hk2).2.2
        rw [← h_centerX_eq] at hy1
        have hy2 := (h_mid_unit (ε ^ (b_min + r)) 0 (fineCellCenterX S_X τ_X (P_buf o).2.2)
          b_p.2.2 hsb2 hb2).2.2
        have hSX_le : S_X ≤ (M_L : ℝ) * ε ^ (b_min + r) :=
          mul_le_mul_of_nonneg_left heb_rut (Nat.cast_nonneg _)
        have h_smul : ‖(C_rv - C_tv) • (V_O o - V_B)‖ ≤ ((M_L : ℝ) + 1) * ε ^ (b_min + r) := by
          rw [norm_smul, Real.norm_eq_abs]
          calc |C_rv - C_tv| * ‖V_O o - V_B‖
              ≤ ε ^ r * (((M_L : ℝ) + 1) * ε ^ b_min) :=
                mul_le_mul hcd_v hv_tot (norm_nonneg _) (Real.rpow_nonneg hε₀.le _)
            _ = ((M_L : ℝ) + 1) * (ε ^ b_min * ε ^ r) := by ring
            _ = ((M_L : ℝ) + 1) * ε ^ (b_min + r) := by rw [← Real.rpow_add hε₀]
        refine ⟨hv_tot, ?_⟩
        have hid : X_O o - X_B =
            ((X_O o + (C_rv - C_tv) • V_O o) - fineCellCenterX S_X τ_X (P_buf o).2.2) +
            (fineCellCenterX S_X τ_X (P_buf o).2.2 - Y_B) -
            (C_rv - C_tv) • (V_O o - V_B) := by dsimp only [X_B]; module
        have ht1 := norm_sub_le
          (((X_O o + (C_rv - C_tv) • V_O o) - fineCellCenterX S_X τ_X (P_buf o).2.2) +
            (fineCellCenterX S_X τ_X (P_buf o).2.2 - Y_B))
          ((C_rv - C_tv) • (V_O o - V_B))
        have ht2 := norm_add_le
          ((X_O o + (C_rv - C_tv) • V_O o) - fineCellCenterX S_X τ_X (P_buf o).2.2)
          (fineCellCenterX S_X τ_X (P_buf o).2.2 - Y_B)
        rw [hid]; linarith
      let K1 := G.image (fun o => roundShift2D (ε ^ b_min) 0 (V_O o))
      let K2 := G.image (fun o => roundShift2D (ε ^ (b_min + t)) 0 (X_O o))
      have hc_inj : (G.image D_iso).card ≤ (K1 ×ˢ K2).card := by
        refine Finset.card_le_card_of_injOn (fun x => x.2) ?_ ?_
        · intro x hx
          obtain ⟨o, ho, rfl⟩ := Finset.mem_image.mp hx
          simp only [Finset.coe_product, Set.mem_prod, Finset.mem_coe]
          exact ⟨Finset.mem_image_of_mem _ ho, Finset.mem_image_of_mem _ ho⟩
        · intro x hx y hy hxy
          obtain ⟨ox, hox, rfl⟩ := Finset.mem_image.mp hx
          obtain ⟨oy, hoy, rfl⟩ := Finset.mem_image.mp hy
          exact Prod.ext ((Finset.mem_filter.mp hox).2.trans (Finset.mem_filter.mp hoy).2.symm) hxy
      rw [Finset.card_product] at hc_inj
      have hcK1 : (K1.card : ℝ) ≤ (2 * (M_L : ℝ) + 4) ^ 2 := by
        have hc := h_box2_card (ε ^ b_min) (((M_L : ℝ) + 1) * ε ^ b_min) 0 V_B K1
          hsb1 (by positivity) (fun k hk => by
            obtain ⟨o, ho, rfl⟩ := Finset.mem_image.mp hk
            exact ⟨V_O o, rfl, (hG_geom o ho).1⟩)
        have h_rat : 2 * (((M_L : ℝ) + 1) * ε ^ b_min) / ε ^ b_min + 2 = 2 * (M_L : ℝ) + 4 := by
          field_simp [hsb1.ne']; ring
        rwa [h_rat] at hc
      have hcK2 : (K2.card : ℝ) ≤ (4 * (M_L : ℝ) + 6) ^ 2 * ε ^ (-(4 * h)) := by
        have hc := h_box2_card (ε ^ (b_min + t)) ((2 * (M_L : ℝ) + 2) * ε ^ (b_min + r)) 0 X_B K2
          hsbt (by positivity) (fun k hk => by
            obtain ⟨o, ho, rfl⟩ := Finset.mem_image.mp hk
            exact ⟨X_O o, rfl, (hG_geom o ho).2⟩)
        have h_rat : 2 * ((2 * (M_L : ℝ) + 2) * ε ^ (b_min + r)) / ε ^ (b_min + t) =
            (4 * (M_L : ℝ) + 4) * ε ^ (-(2 * h)) := by
          have hexp : ε ^ (b_min + t) = ε ^ (b_min + r) * ε ^ (2 * h) := by
            rw [← Real.rpow_add hε₀]; congr 1; dsimp only [r]; ring
          have hinv : (ε ^ (2 * h))⁻¹ = ε ^ (-(2 * h)) := (Real.rpow_neg hε₀.le (2 * h)).symm
          rw [hexp]
          calc 2 * ((2 * (M_L : ℝ) + 2) * ε ^ (b_min + r)) / (ε ^ (b_min + r) * ε ^ (2 * h))
              = (4 * (M_L : ℝ) + 4) * (ε ^ (b_min + r) / ε ^ (b_min + r)) * (ε ^ (2 * h))⁻¹ := by ring
            _ = (4 * (M_L : ℝ) + 4) * 1 * ε ^ (-(2 * h)) := by rw [div_self hsb2.ne', hinv]
            _ = (4 * (M_L : ℝ) + 4) * ε ^ (-(2 * h)) := by ring
        have h_base : 2 * ((2 * (M_L : ℝ) + 2) * ε ^ (b_min + r)) / ε ^ (b_min + t) + 2 ≤
            (4 * (M_L : ℝ) + 6) * ε ^ (-(2 * h)) := by
          rw [h_rat]; nlinarith [h1_le_e2h]
        have h_sq : (2 * ((2 * (M_L : ℝ) + 2) * ε ^ (b_min + r)) / ε ^ (b_min + t) + 2) ^ 2 ≤
            ((4 * (M_L : ℝ) + 6) * ε ^ (-(2 * h))) ^ 2 :=
          pow_le_pow_left₀ (by positivity) h_base 2
        have h_e4h : (ε ^ (-(2 * h))) ^ 2 = ε ^ (-(4 * h)) := by
          rw [sq, ← Real.rpow_add hε₀]; congr 1; ring
        calc (K2.card : ℝ) ≤ _ := hc
          _ ≤ ((4 * (M_L : ℝ) + 6) * ε ^ (-(2 * h))) ^ 2 := h_sq
          _ = (4 * (M_L : ℝ) + 6) ^ 2 * (ε ^ (-(2 * h))) ^ 2 := mul_pow _ _ 2
          _ = (4 * (M_L : ℝ) + 6) ^ 2 * ε ^ (-(4 * h)) := by rw [h_e4h]
      calc ((G.image D_iso).card : ℝ)
          ≤ (K1.card : ℝ) * (K2.card : ℝ) := by exact_mod_cast hc_inj
        _ ≤ (2 * (M_L : ℝ) + 4) ^ 2 * ((4 * (M_L : ℝ) + 6) ^ 2 * ε ^ (-(4 * h))) :=
            mul_le_mul hcK1 hcK2 (Nat.cast_nonneg _) (by positivity)
        _ = (2 * (M_L : ℝ) + 4) ^ 2 * (4 * (M_L : ℝ) + 6) ^ 2 * ε ^ (-(4 * h)) := by ring
    have hc_bi : (F_bp.image D_iso).card ≤
        ∑ k_loc ∈ Finset.range K, ((F_bp.filter (fun o => r_O o = K * b_p.1 + k_loc)).image D_iso).card :=
      le_trans (Finset.card_le_card h_bi) Finset.card_biUnion_le
    have h_e6h : ε ^ (-(2 * h)) * ε ^ (-(4 * h)) = ε ^ (-(6 * h)) := by
      rw [← Real.rpow_add hε₀]; congr 1; ring
    calc ((F_bp.image D_iso).card : ℝ)
        ≤ ∑ k_loc ∈ Finset.range K,
            (((F_bp.filter (fun o => r_O o = K * b_p.1 + k_loc)).image D_iso).card : ℝ) := by
          exact_mod_cast hc_bi
      _ ≤ ∑ _ ∈ Finset.range K,
            (2 * (M_L : ℝ) + 4) ^ 2 * (4 * (M_L : ℝ) + 6) ^ 2 * ε ^ (-(4 * h)) :=
          Finset.sum_le_sum h_slice
      _ = (K : ℝ) * ((2 * (M_L : ℝ) + 4) ^ 2 * (4 * (M_L : ℝ) + 6) ^ 2 * ε ^ (-(4 * h))) := by
          simp
      _ ≤ (2 * B_sys * ε ^ (-(2 * h))) *
            ((2 * (M_L : ℝ) + 4) ^ 2 * (4 * (M_L : ℝ) + 6) ^ 2 * ε ^ (-(4 * h))) :=
          mul_le_mul_of_nonneg_right h_dyad_ratio (by positivity)
      _ = C_iso * (ε ^ (-(2 * h)) * ε ^ (-(4 * h))) := by dsimp only [C_iso]; ring
      _ = C_iso * ε ^ (-(6 * h)) := by rw [h_e6h]

  
  have h_b4_sep : ∀ d₁ d₂ : Fin N_D,
      ε ^ (4 * h) < projAngleDist (perp2D (e_D d₁)) (perp2D (e_D d₂)) →
      ((((Finset.univ.filter (fun o : Fin N_O =>
            @ite Prop (0 < p o d₁) (Classical.propDecidable _) True False)).image P_buf) ∩
        ((Finset.univ.filter (fun o : Fin N_O =>
            @ite Prop (0 < p o d₂) (Classical.propDecidable _) True False)).image P_buf)).card : ℝ) ≤
        C_sep * ε ^ (-(16 * h + 8 * ζ_sh)) := by
    intro d₁ d₂ hsep
    let F₁ := Finset.univ.filter (fun o : Fin N_O =>
      @ite Prop (0 < p o d₁) (Classical.propDecidable _) True False)
    let F₂ := Finset.univ.filter (fun o : Fin N_O =>
      @ite Prop (0 < p o d₂) (Classical.propDecidable _) True False)
    let I := F₁.image P_buf ∩ F₂.image P_buf
    by_cases hI : I.Nonempty
    · obtain ⟨p_ref0, hp_ref0⟩ := hI
      obtain ⟨hp₀1, hp₀2⟩ := Finset.mem_inter.mp hp_ref0
      obtain ⟨o₁₀, ho₁₀, hp₀_eq1⟩ := Finset.mem_image.mp hp₀1
      obtain ⟨o₂₀, ho₂₀, hp₀_eq2⟩ := Finset.mem_image.mp hp₀2
      have h_pod : ∀ (d : Fin N_D) (o : Fin N_O),
          o ∈ Finset.univ.filter (fun o => @ite Prop (0 < p o d) (Classical.propDecidable _) True False) →
          0 < p o d := by
        intro d o ho
        rw [Finset.mem_filter] at ho
        by_contra hnp
        have hf := ho.2; simp [hnp] at hf
      let u₁ := perp2D (e_D d₁)
      let u₂ := perp2D (e_D d₂)
      have hu₁ : ‖u₁‖ = 1 := by rw [h_perp_norm, (hd_unit d₁).2]
      have hu₂ : ‖u₂‖ = 1 := by rw [h_perp_norm, (hd_unit d₂).2]
      have h_single_strip : ∀ (d : Fin N_D) (o o_ref : Fin N_O) (p_c : ℕ × (ℤ × ℤ) × (ℤ × ℤ)),
          0 < p o d → 0 < p o_ref d → P_buf o = p_c → P_buf o_ref = p_ref0 →
          p_c.1 = p_ref0.1 ∧
          |inner ℝ (fineCellCenterV S_V τ_V p_c.2.1 - fineCellCenterV S_V τ_V p_ref0.2.1) (perp2D (e_D d))| ≤
            (2 * B_sys + 2 * (M_L : ℝ)) * ε ^ (u_t - 2 * ζ_sh) ∧
          |inner ℝ (fineCellCenterX S_X τ_X p_c.2.2 - fineCellCenterX S_X τ_X p_ref0.2.2) (perp2D (e_D d))| ≤
            (4 * B_sys + 2 * (M_L : ℝ)) * ε ^ (r + u_t - 2 * ζ_sh) := by
        intro d o o_ref p_c hpo hp_ref hpc hp0_r
        obtain ⟨_, ha_o, hr_o, _, hv_o, _, hx_o⟩ := hp_geom o d hpo
        obtain ⟨_, ha_ref, hr_ref, _, hv_ref, _, hx_ref⟩ := hp_geom o_ref d hp_ref
        have hu_d : ‖perp2D (e_D d)‖ = 1 := by rw [h_perp_norm, (hd_unit d).2]
        have h1_eq : p_c.1 = p_ref0.1 := by
          have a1 := congrArg Prod.fst hpc
          have a2 := congrArg Prod.fst hp0_r
          dsimp only [P_buf, coarseOfFineCell, fineOutCell, atomOutCell] at a1 a2
          rw [← a1, ← a2, hr_o, hr_ref]
        let q_d := r_D d / 2 ^ (m_t - m_r)
        let C_rd := ((q_d : ℝ) + 1 / 2) * ((2 : ℝ) ^ m_r)⁻¹
        let C_td := ((r_D d : ℝ) + 1 / 2) * ((2 : ℝ) ^ m_t)⁻¹
        have hcd_d : |C_rd - C_td| ≤ ε ^ r := h_clock_drift (r_D d)
        have h_ut_le : ε ^ u_t ≤ ε ^ (u_t - 2 * ζ_sh) :=
          Real.rpow_le_rpow_of_exponent_ge hε₀ hε_le1 (by linarith)
        have h_rut_le : ε ^ (r + u_t) ≤ ε ^ (r + u_t - 2 * ζ_sh) :=
          Real.rpow_le_rpow_of_exponent_ge hε₀ hε_le1 (by linarith)
        have hvm_o : ‖fineCellCenterV S_V τ_V p_c.2.1 - V_O o‖ ≤ S_V := by
          rw [norm_sub_rev]
          exact (h_mid_coarse M_L (ε ^ u_t) τ_V (V_O o) p_c.2.1 hML
            (Real.rpow_pos_of_pos hε₀ _) (congrArg (fun x => x.2.1) hpc)).2.2
        have hvm_ref : ‖fineCellCenterV S_V τ_V p_ref0.2.1 - V_O o_ref‖ ≤ S_V := by
          rw [norm_sub_rev]
          exact (h_mid_coarse M_L (ε ^ u_t) τ_V (V_O o_ref) p_ref0.2.1 hML
            (Real.rpow_pos_of_pos hε₀ _) (congrArg (fun x => x.2.1) hp0_r)).2.2
        have hV_strip : |inner ℝ (fineCellCenterV S_V τ_V p_c.2.1 - fineCellCenterV S_V τ_V p_ref0.2.1)
            (perp2D (e_D d))| ≤ (2 * B_sys + 2 * (M_L : ℝ)) * ε ^ (u_t - 2 * ζ_sh) := by
          have hid : fineCellCenterV S_V τ_V p_c.2.1 - fineCellCenterV S_V τ_V p_ref0.2.1 =
              (fineCellCenterV S_V τ_V p_c.2.1 - V_O o) + (V_O o - V_D d) -
              (V_O o_ref - V_D d) - (fineCellCenterV S_V τ_V p_ref0.2.1 - V_O o_ref) := by abel
          rw [hid, inner_sub_left, inner_sub_left, inner_add_left]
          have b1 : |inner ℝ (fineCellCenterV S_V τ_V p_c.2.1 - V_O o) (perp2D (e_D d))| ≤
              (M_L : ℝ) * ε ^ (u_t - 2 * ζ_sh) := by
            calc |inner ℝ (fineCellCenterV S_V τ_V p_c.2.1 - V_O o) (perp2D (e_D d))|
                ≤ ‖fineCellCenterV S_V τ_V p_c.2.1 - V_O o‖ * ‖perp2D (e_D d)‖ := abs_real_inner_le_norm _ _
              _ ≤ S_V * 1 := by rw [hu_d]; linarith
              _ = (M_L : ℝ) * ε ^ u_t := by dsimp only [S_V]; ring
              _ ≤ (M_L : ℝ) * ε ^ (u_t - 2 * ζ_sh) :=
                  mul_le_mul_of_nonneg_left h_ut_le (Nat.cast_nonneg _)
          have b2 : |inner ℝ (V_O o - V_D d) (perp2D (e_D d))| ≤ B_sys * ε ^ (u_t - 2 * ζ_sh) :=
            le_trans hv_o (mul_le_mul_of_nonneg_left
              (Real.rpow_le_rpow_of_exponent_ge hε₀ hε_le1 ha_o) (by linarith))
          have b3 : |inner ℝ (V_O o_ref - V_D d) (perp2D (e_D d))| ≤ B_sys * ε ^ (u_t - 2 * ζ_sh) :=
            le_trans hv_ref (mul_le_mul_of_nonneg_left
              (Real.rpow_le_rpow_of_exponent_ge hε₀ hε_le1 ha_ref) (by linarith))
          have b4 : |inner ℝ (fineCellCenterV S_V τ_V p_ref0.2.1 - V_O o_ref) (perp2D (e_D d))| ≤
