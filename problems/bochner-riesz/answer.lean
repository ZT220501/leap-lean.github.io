theorem classical_positive_transport_growth (γ : ℝ) (hγ₀ : 0 < γ) (hγ₁ : γ < 1) :
    ClassicalLineGrowthBound γ :=
by
  have h_two : (2 : ℝ) ∈ ValidClassicalGrowthRates γ :=
    preliminary_classical_growth_le_two γ hγ₀ hγ₁
  have h_rate : classicalGrowthRate γ ≤ γ := by
    by_contra h_not
    have h_gt : γ < classicalGrowthRate γ := lt_of_not_ge h_not
    let β : ℝ := classicalGrowthRate γ
    have h_dich := least_aspect_dichotomy γ hγ₀ hγ₁ h_two h_gt
    rcases h_dich with h_iso | ⟨m, sys, hm_pos⟩
    · exact isotropic_extremizer_exclusion γ hγ₀ hγ₁ h_two h_gt h_iso
    · obtain ⟨σ, hσ_pos, h_dist_pt, h_tied_pt⟩ :=
        matched_clock_pointwise_rate_transfer γ m hγ₀ hγ₁ hm_pos h_two h_gt sys
      have hS_mono : Monotone sys.S := by
        intro u₁ u₂ hu
        linarith [(sys.hS_lip u₁ u₂ hu).1]
      have hS_ae : ∀ᵐ iu : ℝ × ℝ, DifferentiableAt ℝ sys.S iu.2 :=
        (MeasureTheory.Measure.quasiMeasurePreserving_snd
          (μ := MeasureTheory.volume) (ν := MeasureTheory.volume)).ae hS_mono.ae_differentiableAt
      
      have h_sec84 : ∀ {n : ℕ} (j₀ j_top : Fin n) (c : Fin n → ℝ)
          (P_rates : ℝ → (Fin n → ℝ) → Prop)
          (p s z_m z_p D_m D_p : ℝ),
          0 ≤ p → p ≤ 1 + m → 0 < s → s ≤ 1 →
          0 ≤ z_m → z_m ≤ 1 → 0 ≤ z_p → z_p ≤ 1 →
          0 ≤ D_m → 0 ≤ D_p →
          (∀ r, P_rates s r → 0 ≤ r j₀ ∧ r j_top ≤ 1) →
          (∀ r, P_rates s r → 0 < r j₀ → r j_top < 1 →
            1 + s ≤ 2 * ((1 + m) / 2) - m + ∑ j, (c j - (1 + m) / 2) * r j) →
          (∀ r P, P_rates s r → 0 < r j₀ → r j_top < 1 → 0 ≤ P → P ≤ (1 + m) / 2 →
            1 + s ≤ (2 * P - m + ∑ j, (c j - P) * r j) + (1 + m - P) * (1 - r j_top)) →
          (∀ r, P_rates s r → 0 < r j₀ → r j_top = 1 →
            1 + s ≤ 2 * 0 - m + ∑ j, (c j - 0) * r j) →
          (∀ r, P_rates s r → r j₀ = 0 → r j_top < 1 →
            1 + s ≤ 2 * (1 + m) - m + ∑ j, (c j - (1 + m)) * r j) →
          (0 < p → ∃ r_m : Fin n → ℝ,
            P_rates s r_m ∧ (∑ j, r_m j) - 2 ≤ 0 ∧ γ ≤ r_m j₀ ∧
            (p < 1 + m → r_m j_top = z_m) ∧
            (2 * p - m + ∑ j, (c j - p) * r_m j) + D_m = 2 * s - β - γ * m) →
          (p < 1 + m → ∃ r_p : Fin n → ℝ,
            P_rates s r_p ∧ 0 ≤ (∑ j, r_p j) - 2 ∧ r_p j_top = z_p ∧
            (2 * p - m + ∑ j, (c j - p) * r_p j) + D_p = 2 * s - β - γ * m) →
          (p = 0 → ∃ r_p0 : Fin n → ℝ,
            P_rates s r_p0 ∧ γ ≤ r_p0 j₀ ∧ r_p0 j_top = z_p ∧
            (2 * p - m + ∑ j, (c j - p) * r_p0 j) + D_p = 2 * s - β - γ * m) →
          (0 < p ∧ p < 1 + m → (1 + m - p) * (z_p - z_m) ≤ D_m - D_p) →
          False := by
        intro n j₀ j_top c P_rates p s z_m z_p D_m D_p
          hp0 hp1m hs0 hs1 hzm0 hzm1 hzp0 hzp1 hDm hDp
          h_cap h_mid h_repl h_z1 h_x0 h_rm h_rp h_rp0 h_jump
        let F : (Fin n → ℝ) → ℝ → ℝ := fun r P => 2 * P - m + ∑ j, (c j - P) * r j
        have hF_diff : ∀ (r : Fin n → ℝ) (P₁ P₂ : ℝ),
            F r P₂ - F r P₁ = (2 - ∑ j, r j) * (P₂ - P₁) := by
          intro r P₁ P₂
          dsimp only [F]
          have h_sum : (∑ j, (c j - P₂) * r j) - (∑ j, (c j - P₁) * r j) =
              -(P₂ - P₁) * ∑ j, r j := by
            rw [← Finset.sum_sub_distrib, Finset.mul_sum]
            refine Finset.sum_congr rfl (fun j _ => ?_)
            ring
          linarith
        have h_thresh : 2 * s - β - γ * m < 1 + s := by
          have hγm : 0 < γ * m := mul_pos hγ₀ hm_pos
          have hβ_pos : 0 < β := lt_trans hγ₀ h_gt
          linarith
        let p_star : ℝ := (1 + m) / 2
        by_cases hp_ge : p_star ≤ p
        · have hp_pos : 0 < p := by
            dsimp only [p_star] at hp_ge
            linarith
          obtain ⟨r_m, hr_m, hB_m, hx_m, _, h_eq_m⟩ := h_rm hp_pos
          have hx_pos : 0 < r_m j₀ := lt_of_lt_of_le hγ₀ hx_m
          have hz_le1 : r_m j_top ≤ 1 := (h_cap r_m hr_m).2
          by_cases hz_lt : r_m j_top < 1
