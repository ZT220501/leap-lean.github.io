        _ = (m_cell k z₀ * m'_w0)⁻¹ * sys.π_seq k ω := by rw [mul_inv_rev]; ring
    have h_prod_lb : c₁ / (2 * (J₂ : ℝ)) ≤ m_cell k z₀ * m'_w0 := by
      have h_mul := mul_le_mul hm_z0_lb hm'_w0_lb (by positivity) hm_z0_pos.le
      calc c₁ / (2 * (J₂ : ℝ)) = c₁ * (1 / (2 * (J₂ : ℝ))) := by ring
