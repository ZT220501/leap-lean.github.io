        have hm1 : (roundShift2D σ_loc 0 (X'_fn o - X_Q)).2 ∈ I_Z1 q := by
          rcases abs_le.mp (hcoord_div 1) with ⟨hl1, hu1⟩
          exact h_floor_mem_Icc_floor (by linarith) (by linarith)
        have hZ_eq : Z_of o = (q, roundShift2D σ_loc 0 (X'_fn o - X_Q)) := by
          dsimp only [Z_of]
          rw [if_neg hd_ne1]
        rw [hZ_eq]
        refine Finset.mem_biUnion.mpr ⟨q, hq_mem, ?_⟩
        exact Finset.mem_image.mpr
          ⟨roundShift2D σ_loc 0 (X'_fn o - X_Q), Finset.mem_product.mpr ⟨hm0, hm1⟩, rfl⟩
      have hfib_card2 : ∀ q, (((Fib_Z2 q).image (fun k => (q, k))).card : ℝ) ≤
          C_Z2 * ε ^ (-ζ_sh) := by
        intro q
        have hc_nat : ((Fib_Z2 q).image (fun k => (q, k))).card ≤
