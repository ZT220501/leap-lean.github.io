        rw [one_smul] at h1
        exact h1.const_add v'
      have hΦ_diff : DifferentiableAt ℝ (fun v'' => Φ₀ (c_end, x_line y, v'')) (v_seg τ) := by
        have hcd : ContDiff ℝ (1 : ℕ) (fun v'' => Φ₀ (c_end, x_line y, v'')) :=
