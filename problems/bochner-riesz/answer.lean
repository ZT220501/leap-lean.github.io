  have h_cred_ret : ∃ P_in : Fin N_O → ℕ × (ℤ × ℤ) × (ℤ × ℤ),
      ∀ (A : Fin N_O → Fin N_D → Prop) (κ ζ : ℝ),
        0 < κ → 0 < ζ →
        let p_P : (ℕ × (ℤ × ℤ) × (ℤ × ℤ)) → ℝ := fun p_c =>
          ∑ o ∈ Finset.univ.filter (fun o => P_in o = p_c), ∑ d : Fin N_D, p o d
        let p_AP : (ℕ × (ℤ × ℤ) × (ℤ × ℤ)) → ℝ := fun p_c =>
          ∑ o ∈ Finset.univ.filter (fun o => P_in o = p_c),
            ∑ d : Fin N_D, if A o d then p o d else 0
        let GoodFib : (ℕ × (ℤ × ℤ) × (ℤ × ℤ)) → Prop := fun p_c =>
          0 < p_P p_c ∧ (κ * ε ^ ζ) * p_P p_c ≤ p_AP p_c
        let p_A : ℝ := ∑ o : Fin N_O, ∑ d : Fin N_D, if A o d then p o d else 0
        let p_A' : ℝ := ∑ o : Fin N_O, ∑ d : Fin N_D,
          if A o d ∧ GoodFib (P_in o) then p o d else 0
        p_A - κ * ε ^ ζ ≤ p_A' ∧
        (0 < p_A' →
          let q_A' : Fin N_O → Fin N_D → ℝ := fun o d =>
            if A o d ∧ GoodFib (P_in o) then p o d / p_A' else 0
          HasIncomingCredit ε H_P t h 4 d_dim N_O N_D r_O V_O X_O e_D q_A' k_f
