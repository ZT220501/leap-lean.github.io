  refine ⟨η, ρ₁, hη_pos, hρ₁_pos, hρ₁_half, ?_⟩
  intro N_P N_Θ ρ ρ_tilde κ e_n c₀ π_orig π_tilde P_pt θ_lbl
    hρ₀ hρ_half hρ_le hρt_lt hκ_pos hκ_le_η he_n hP_dom hθ_dom hπo_nn
