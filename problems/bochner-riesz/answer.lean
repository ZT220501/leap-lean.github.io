    have h_small : 3872 * ρ_tilde ^ (5 * η₀ / 8) ≤ 1 := by linarith
    calc 3872 * (K_o * K_o * K_o)
        ≤ 3872 * (ρ_tilde ^ (-η) * ρ_tilde ^ (-η) * ρ_tilde ^ (-η)) :=
