    have hM2_nn : ∀ k, 0 ≤ M2 k := hS_nn M1 hM1_nn
    have hM3_nn : ∀ k, 0 ≤ M3 k := hS_nn M2 hM2_nn
    have hM4_nn : ∀ k, 0 ≤ M4 k := hS_nn M3 hM3_nn
