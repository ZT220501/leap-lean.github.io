      let Ψ : ℝ → ℂ := fun t => (ψ t : ℂ)
      have hΨ_sm : ∀ k : ℕ, ContDiff ℝ k Ψ :=
        fun k => Complex.ofRealCLM.contDiff.comp (hψ_sm k)
