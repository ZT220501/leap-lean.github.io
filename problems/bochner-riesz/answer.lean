            abs_add_le _ _
        _ = |inner ℝ u v| * |inner ℝ v (perp2D w)| + |inner ℝ u (perp2D v)| * |inner ℝ v w| := by
            rw [abs_mul, abs_mul]
        _ ≤ 1 * |inner ℝ v (perp2D w)| + |inner ℝ u (perp2D v)| * 1 :=
            add_le_add (mul_le_mul_of_nonneg_right huv_le (abs_nonneg _))
              (mul_le_mul_of_nonneg_left hvw_le (abs_nonneg _))
        _ = |inner ℝ u (perp2D v)| + |inner ℝ v (perp2D w)| := by ring
    · intro z
      have h_cram_id : inner ℝ u (perp2D v) • z =
          inner ℝ z u • perp2D v - inner ℝ z v • perp2D u := by
        ext i
        fin_cases i <;> simp [h_inner2, perp2D] <;> ring
      calc projAngleDist u v * ‖z‖
