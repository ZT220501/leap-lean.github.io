    have hN_int2_nn : 0 ≤ N_int2 :=
      mul_nonneg (div_nonneg (by positivity) hc_ret2_pos.le) (Real.rpow_pos_of_pos hρ₂_pos _).le

    have h_int_v2 : ∀ v ∈ S_V2, ∃ I_v : Finset ℤ, (I_v.card : ℝ) ≤ N_int2 ∧
        ∀ p ∈ S_P2, 0 < q_PV2 p v → ⌊(x_pt2 p - c_pt2 p * v_bar2 v) / ρ₂⌋ ∈ I_v := by
