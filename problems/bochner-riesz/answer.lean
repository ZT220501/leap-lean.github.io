      have h_pow_mt : ((2 : ℝ) ^ m_t)⁻¹ = s_c * Δ_time := by
        calc ((2 : ℝ) ^ m_t)⁻¹ = ((2 : ℝ) ^ (m_r + (m_t - m_r)))⁻¹ := by
              rw [Nat.add_sub_of_le hmr_le_mt]
