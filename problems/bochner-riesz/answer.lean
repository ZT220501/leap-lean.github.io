        Complex.exp (Complex.I * ((lam_loc * Φ₀ (c_end, x, V_P + ρ • z) : ℝ) : ℂ))

    have hv_z_cont : Continuous (fun z : EuclideanSpace ℝ (Fin 2) => V_P + ρ • z) :=
      continuous_const.add (continuous_id.const_smul ρ)
    have hF_ox_cont : Continuous F_ox := by
      dsimp [F_ox]
      refine (((hO_reg o).1 0).continuous.comp (continuous_id.add continuous_const)).mul ?_
      refine Complex.continuous_exp.comp (continuous_const.mul (Complex.continuous_ofReal.comp
        (continuous_const.mul
          ((hΦ₀_cont.comp (continuous_const.prodMk (continuous_const.prodMk hv_z_cont))).sub
