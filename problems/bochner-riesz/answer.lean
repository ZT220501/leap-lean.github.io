      have h_mul := mul_le_mul_of_nonneg_left h_core hχ_nn
      have h_lhs_eq : (χ_i i * χ_u u) * (((1 / 2 : ℝ) * c_gap ^ 2) * H_mix F (p_fn (i, u))) =
