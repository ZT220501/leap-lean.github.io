    have hPMU_sum_m : ∀ u, ∑ m : Fin N_M, P_MU m u = P_U u := by
      intro u
      dsimp only [P_MU, P_U]
      calc ∑ m : Fin N_M, ∑ α ∈ F_M m, ∑ d ∈ F_U u, P α d
