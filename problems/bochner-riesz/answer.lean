      have hc2 : |inner ℝ (perp2D e₀) (perp2D e_c)| ≤ 1 := by
        calc |inner ℝ (perp2D e₀) (perp2D e_c)| ≤ ‖perp2D e₀‖ * ‖perp2D e_c‖ :=
