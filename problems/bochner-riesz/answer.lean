          refine ⟨F_p2, Finset.image_subset_iff.mpr (fun ω' hω' =>
            Finset.mem_image_of_mem _ (Finset.mem_filter.mp hω').1), ?_, ?_⟩
          · have hpar_ret := hq2_par ω_p hq2_pos
            let k_m1_fn := fun ω' => dyadicTimeBin ε u_m1 (c_val ω')
            let p_par := finProbAt π_amb Par2 ω_p
