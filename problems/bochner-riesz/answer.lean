    · intro I F_part h_pw_disj
      rw [hP_mass, hP_sum (I.biUnion F_part), Finset.sum_biUnion h_pw_disj]
      have h_inner : (∑ x ∈ I, ∑ α ∈ F_part x, c_at α * P_fn (g_at α)) =
