      linarith only [hm_32, h_t1, h_t2, h_t3, h_t4]

    
    
    
    have hw_sum_TP : ∑ α ∈ T_P, ‖sub.c_at α‖ ^ 2 ≤ w_max * (T_P.card : ℝ) := by
