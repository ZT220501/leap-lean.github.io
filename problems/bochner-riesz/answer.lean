      0 < ε → ε < 1 / 2 → 0 < τ → 1 ≤ N →
      (∀ ω, 0 ≤ Q ω) → (∑ ω : Fin N_ω, Q ω = 1) →
      (∀ ω, 0 < Q ω → lo (X ω) ≤ Y ω ∧ Y ω < lo (X ω) + (N : ℤ)) →
