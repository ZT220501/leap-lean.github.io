      mul_le_mul hK2 hκ_le_η hKo_pos.le (mul_nonneg hρt_nη_nn hρt_nη_nn)
    have h_rpow3 : ρ_tilde ^ (-η) * ρ_tilde ^ (-η) * ρ_tilde ^ (-η) =
