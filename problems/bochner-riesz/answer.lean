      linarith only [hsum_uncond, hsum_cond, hZT_le, hZTD_le]
    have h_div := div_le_div_of_nonneg_right h_raw hell_nn
    have hlhs_eq : (H_O + (1 / 2 : ℝ) * H_OD + (3 / 2 : ℝ) * E_m) / ell =
