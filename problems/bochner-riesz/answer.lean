            have h_norm_prod : ‖iteratedDeriv (n + 1) h t‖ ≤ ‖Ψ t * iteratedDeriv (n + 1) h t‖ := by
              rw [norm_mul]
              exact le_mul_of_one_le_left (norm_nonneg _) (hΨ_norm_ge1 t)
            have h_sum_le : ‖∑ i ∈ Finset.range (n + 1),
                  (((n + 1).choose (i + 1) : ℕ) : ℂ) *
                    iteratedDeriv (i + 1) Ψ t * iteratedDeriv (n + 1 - (i + 1)) h t‖ ≤
                (∑ i ∈ Finset.range (n + 1),
                  (((n + 1).choose (i + 1) : ℕ) : ℝ) * D_phase (i + 1)) * K_maj B n := by
              rw [Finset.sum_mul]
              refine le_trans (norm_sum_le _ _) (Finset.sum_le_sum (fun i _ => ?_))
              rw [norm_mul, norm_mul, Complex.norm_natCast]
              have h_sub : n + 1 - (i + 1) ≤ n := by omega
