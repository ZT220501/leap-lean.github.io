      have h_t2 : 32 * (I₂.card : ℝ) * (∑ k₂ ∈ I₂, m_set o (F₂ k₂)) ≤
          (13312 * C_cov * ε ^ (-h)) * (∑ k₂ ∈ K₂, m_set o (F₂ k₂)) := by
        have h_sub_sum : ∑ k₂ ∈ I₂, m_set o (F₂ k₂) ≤ ∑ k₂ ∈ K₂, m_set o (F₂ k₂) :=
          Finset.sum_le_sum_of_subset_of_nonneg hI₂_sub (fun k₂ _ _ => hm_nn o (F₂ k₂))
        have h_c : 32 * (I₂.card : ℝ) ≤ 13312 * C_cov * ε ^ (-h) := by linarith only [hI₂_card]
        exact mul_le_mul h_c h_sub_sum
          (Finset.sum_nonneg (fun k₂ _ => hm_nn o (F₂ k₂)))
          (mul_nonneg (by positivity) (Real.rpow_nonneg hε₀.le _))
      have h_t3 : 8 * (S_bdry.card : ℝ) * (∑ α ∈ S_bdry, m_set o {α}) ≤
          (29952 * C_cov ^ 3 * (M_mult : ℝ) * R_tr ^ 2 * ε ^ (-(5 / 4 : ℝ) * h)) *
            (∑ α ∈ T_P, m_set o {α}) := by
        have h_sub_sum : ∑ α ∈ S_bdry, m_set o {α} ≤ ∑ α ∈ T_P, m_set o {α} :=
          Finset.sum_le_sum_of_subset_of_nonneg hS_bdry_sub (fun α _ _ => hm_nn o {α})
        have h_c : 8 * (S_bdry.card : ℝ) ≤
            29952 * C_cov ^ 3 * (M_mult : ℝ) * R_tr ^ 2 * ε ^ (-(5 / 4 : ℝ) * h) := by
          linarith only [hS_bdry_card]
        exact mul_le_mul h_c h_sub_sum
          (Finset.sum_nonneg (fun α _ => hm_nn o {α}))
          (mul_nonneg (by positivity) (Real.rpow_nonneg hε₀.le _))
      have h_t4 : 16 * (S_farX.card : ℝ) * (∑ α ∈ S_farX, ‖sub.c_at α‖ ^ 2 * m_1 o α) ≤
          16 * (N_ret : ℝ) * E_far * w_max * (T_P.card : ℝ) := by
        have h_each : ∀ α ∈ S_farX, ‖sub.c_at α‖ ^ 2 * m_1 o α ≤ w_max * E_far := by
          intro α hα
          obtain ⟨hα_in, hα_out⟩ := Finset.mem_sdiff.mp hα
          have h_dec : m_1 o α ≤ E_far := h_out_far α (hU_in_disk α hα_in) hα_out
          exact mul_le_mul (hw_hi α) h_dec (hm1_nn o α) hw_max_pos.le
        have h_inner : ∑ α ∈ S_farX, ‖sub.c_at α‖ ^ 2 * m_1 o α ≤
            (T_P.card : ℝ) * (w_max * E_far) := by
          have h_card_TP : (S_farX.card : ℝ) ≤ (T_P.card : ℝ) := by
            exact_mod_cast Finset.card_le_card hS_farX_sub
          calc ∑ α ∈ S_farX, ‖sub.c_at α‖ ^ 2 * m_1 o α
              ≤ ∑ _α ∈ S_farX, (w_max * E_far) := Finset.sum_le_sum h_each
            _ = (S_farX.card : ℝ) * (w_max * E_far) := by rw [Finset.sum_const, nsmul_eq_mul]
            _ ≤ (T_P.card : ℝ) * (w_max * E_far) :=
                mul_le_mul_of_nonneg_right h_card_TP (mul_nonneg hw_max_pos.le hE_far_nn)
        have h_outer : 16 * (S_farX.card : ℝ) ≤ 16 * (N_ret : ℝ) := by
          have h_u : S_farX.card ≤ N_ret := by
            simpa only [Fintype.card_fin] using Finset.card_le_univ S_farX
          have h_ur : (S_farX.card : ℝ) ≤ (N_ret : ℝ) := by exact_mod_cast h_u
