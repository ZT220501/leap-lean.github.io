          |(H_P - t) / 2 - a_D d| ≤ ζ_sh ∧
          (d_dim = 2 → b_D d = (H_P - t) / 2 ∧ a_D d = (H_P - t) / 2) ∧
          |inner ℝ (V_O o - V_D d) (e_D d)| ≤ cls.B_sys * ε ^ (b_D d) ∧
          |inner ℝ (V_O o - V_D d) (perp2D (e_D d))| ≤ cls.B_sys * ε ^ (a_D d) ∧
          |inner ℝ (X_O o - X_D d) (e_D d)| ≤ cls.B_sys * ε ^ (b_D d + t) ∧
          |inner ℝ (X_O o - X_D d) (perp2D (e_D d))| ≤ cls.B_sys * ε ^ (a_D d + t) ∧
          ‖gridPt2D ρ_r (o_at α).1 - V_O o‖ ≤
            (2 * (M_L : ℝ) + 4) * ε ^ ((H_P - t) / 2) ∧
          ‖(gridPt2D σ_r (o_at α).2 +
              (((r_O o : ℝ) + 1 / 2) * ((2 : ℝ) ^ m_t)⁻¹ -
                ((loc_idx.1 : ℝ) + 1 / 2) * s_c) •
                gridPt2D ρ_r (o_at α).1) - X_O o‖ ≤
            (8 * C_cov * cls.B_sys + 16) * (ε ^ (-θ)) * s_x * ε ^ (u + h)) →
        ∃ (Y_bar : Fin N_D → (ℕ × (ℤ × ℤ) × (ℤ × ℤ)) → ℕ × (ℤ × ℤ) × ((ℤ × ℤ) × (ℤ × ℤ)))
          (b_Y a_Y : (ℕ × (ℤ × ℤ) × ((ℤ × ℤ) × (ℤ × ℤ))) → ℝ)
          (e_Y V_Y X_Y : (ℕ × (ℤ × ℤ) × ((ℤ × ℤ) × (ℤ × ℤ))) → EuclideanSpace ℝ (Fin 2)),
          (∀ d ft, (Y_bar d ft).1 = ft.1) ∧
          (∀ y, 0 ≤ b_Y y ∧ b_Y y ≤ a_Y y ∧ a_Y y + 2 * h ≤ u + h ∧ ‖e_Y y‖ = 1) ∧
          (∀ o d α, 0 < q o d α → ∀ y,
            pktWeight γ (b_D d - b_star) (a_D d - b_star) ≤
              pktWeight γ (b_Y y) (a_Y y) + (d_dim : ℝ) * h + 2 * ζ_sh) ∧
          (∀ (r_loc : ℕ) (d : Fin N_D) (α : Fin N_T),
            let y := Y_bar d (F_T_loc r_loc α)
            let c_mid := ((r_loc : ℝ) + 1 / 2) * ((2 : ℝ) ^ (m_t - m_r))⁻¹
            |inner ℝ (V'_at α - V_Y y) (e_Y y)| ≤ B_cl * ε ^ (b_Y y) ∧
            |inner ℝ (V'_at α - V_Y y) (perp2D (e_Y y))| ≤ B_cl * ε ^ (a_Y y) ∧
            |inner ℝ ((A_part α + c_mid • V'_at α) - X_Y y) (e_Y y)| ≤
              B_cl * ε ^ (b_Y y + 2 * h) ∧
            |inner ℝ ((A_part α + c_mid • V'_at α) - X_Y y) (perp2D (e_Y y))| ≤
              B_cl * ε ^ (a_Y y + 2 * h)) ∧
          (∀ d : Fin N_D,
            (((Finset.univ.filter (fun oα : Fin N_O × Fin N_T => 0 < q oα.1 d oα.2)).image
              (fun oα => Y_bar d (F_T_loc (r_O oα.1 % 2 ^ (m_t - m_r)) oα.2))).card : ℝ) ≤
              C_Y * ε ^ (-2 * θ - 2 * ζ_sh)) := by
    intro ε H_P t b_star lam_sys m_r m_t N_O N_D N_T loc_idx o_at
      r_O V_O X_O b_D a_D r_D e_D V_D X_D q
    letI := Classical.propDecidable
    intro r u s_c s_v s_x ρ_r σ_r V_J X_J V'_at X'_at A_part F_T_loc
      hε₀ hε₁ hb_star hu_ge hd2_bstar hs_c_lo hmr_le_mt hV'_bd h_act
    have hε_le1 : ε ≤ 1 := by linarith only [hε₁]
    have hε_lt1 : ε < 1 := by linarith only [hε₁]
    have hu_sub_h : 0 < u - h := by linarith only [hu_min, hu_ge, hh]
    let s_VF : ℝ := ε ^ (u - h)
    let s_XF : ℝ := ε ^ (u + h)
    let δ_ang : ℝ := (1 / 4 : ℝ) * s_VF
    have hsVF_pos : 0 < s_VF := Real.rpow_pos_of_pos hε₀ (u - h)
    have hsVF_lt1 : s_VF < 1 := Real.rpow_lt_one hε₀.le hε_lt1 hu_sub_h
    have hsXF_pos : 0 < s_XF := Real.rpow_pos_of_pos hε₀ (u + h)
    have h2h_pos : 0 < ε ^ (2 * h) := Real.rpow_pos_of_pos hε₀ (2 * h)
    have hδ_pos : 0 < δ_ang := mul_pos (by norm_num) hsVF_pos
    have hδ_lt : δ_ang < 1 / 4 := by dsimp only [δ_ang]; linarith only [hsVF_lt1]
    have hsXF_le_2h : s_XF ≤ ε ^ (2 * h) :=
      Real.rpow_le_rpow_of_exponent_ge hε₀ hε_le1 (by linarith only [hu_min, hu_ge, hh])
    have hsXF_θ_le_2h : ε ^ (-θ) * s_XF ≤ ε ^ (2 * h) := by
