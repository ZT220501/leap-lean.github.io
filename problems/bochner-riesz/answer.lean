          (∑ i, ∑ b₂, ν_in i b₂ = 1) ∧
          (∀ i, 0 ≤ ν_tilde i) ∧
          (∑ i, ν_tilde i = 1) ∧
          (∀ i b₂, 0 < ν_in i b₂ →
