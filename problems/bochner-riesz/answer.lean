    have hA_pos : 0 < A := by linarith
    refine ⟨A, hA_ge_one, ?_⟩
    intro σ hσ j vp
    have h_fn_eq : (fun q : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) =>
