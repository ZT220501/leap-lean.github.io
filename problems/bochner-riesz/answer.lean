        refine ⟨E_tid.image k₁_fn, ?_, fun ω hω_pos htid =>
          Finset.mem_image_of_mem k₁_fn
            ((@Finset.mem_filter _ _ (fun _ => Classical.propDecidable _) _ _).mpr
              ⟨Finset.mem_filter.mpr ⟨Finset.mem_univ _, htid⟩, hω_pos⟩)⟩
        have h_div_eq : pT / (ε ^ (s + η₀) * pT) = N_k1 := by
