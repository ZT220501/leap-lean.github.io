    have h2 : 1 ≤ (2 * B_sys + 2 * R_win + 17) ^ 2 := by nlinarith only [hB_sys, hR_win]
    nlinarith only [h1, h2]
  let C_enl_base : ℝ := 4 * B_sys + R_win + 7
  have hC_enl_base : 1 ≤ C_enl_base := by
    dsimp [C_enl_base]
    linarith only [hB_sys, hR_win]
  let C_info_0 : ℝ := (3 / 2) * Real.log (M_split : ℝ) + (3 / 2) * Real.log C_cnt
  let C_info_1 : ℝ :=
    (3 / 2) * Real.log (M_split : ℝ) +
    (3 / 2) * Real.log C_fib +
    Real.log B_sys +
    (3 / 2) * Real.log C_cell +
    (3 / 2) * Real.log (4 * (M_c : ℝ) ^ 2) +
    2 * Real.log (6 * C_enl_base) +
    (3 / 2) * Real.log (M_mult : ℝ) +
    (3 / 2) * Real.log C_can
  let C_info : ℝ := max C_info_0 C_info_1
  have hM_split_real : (1 : ℝ) ≤ (M_split : ℝ) := by exact_mod_cast hM_split
  have hC_info_0_nn : 0 ≤ C_info_0 := by
    dsimp [C_info_0]
