              dsimp only [pY_v]
              rw [Finset.sum_comm]
              calc ∑ ω : Fin N_ω, ∑ y ∈ S_Y, (if Y ω = y then π ω else 0)
                  = ∑ ω : Fin N_ω, π ω := by
                      refine Finset.sum_congr rfl (fun ω _ => ?_)
                      rw [Finset.sum_eq_single (Y ω)]
                      · simp
                      · intro y _ hne; simp [Ne.symm hne]
                      · intro hnot
                        exact absurd (Finset.mem_image_of_mem Y (Finset.mem_univ ω)) hnot
                _ = 1 := hπ_sum
      have h_log_le0 : ∑ ω : Fin N_ω, π ω * Real.log (u ω) ≤ 0 :=
        le_trans (h_kl_helper u hu_pos) (by linarith)
      have h_diff : ell * (finMutualInfo ε π T_idx Y - finMutualInfo ε π T_idx Z) =
