            · intro o ho j hp_pos
              obtain ⟨hm, hc1, hc2, hc3, hc4⟩ := h_cap o ho j hp_pos
              rw [h_rpow_div, h_rpow_div]
              exact ⟨hm, hc1, hc2, hc3, hc4⟩
            · rw [hy_eq, h_ell_d]
              dsimp [ell]
              have hEw : (∑ j : Fin N_D', (∑ o ∈ O₀, p' o j) *
                    ((1 + γ) * (b j / d) + (1 - γ) * (a j / d))) =
                  d⁻¹ * ∑ j : Fin N_D', (∑ o ∈ O₀, p' o j) *
                    ((1 + γ) * b j + (1 - γ) * a j) := by
                rw [Finset.mul_sum]
                refine Finset.sum_congr rfl (fun j _ => ?_)
                field_simp [hd_ne]
              rw [hEw]
              field_simp [hd_ne, h_ell_ne]
      rw [h_set_eq]
      open scoped Pointwise in
      have h_smul_set : (fun y => d⁻¹ * y) '' S_orig = d⁻¹ • S_orig := rfl
      rw [h_smul_set]
      exact Real.sSup_smul_of_nonneg (inv_nonneg.mpr hd.le) S_orig

    refine ⟨?_, ?_, h_root_eq, ?_⟩
    · 
      intro hadm
      rcases hadm with ⟨h1, h2, h3, h4, h5, h6, h7, h8, h9⟩
      unfold IsAdmissiblePacketLaw
      refine ⟨h1, h2, h3, h4, ?_, ?_, h7, h8, ?_⟩
      · intro r v₀ x₀
        convert h5 r v₀ x₀ using 3
        ext o
        simp only [Finset.mem_filter, Finset.mem_univ, true_and, h_rho_eq]
      · intro j
        obtain ⟨hb0, hba, ha_min, hrD, heD⟩ := h6 j
        refine ⟨div_nonneg hb0 hd.le, div_le_div_of_nonneg_right hba hd.le,
          le_min ?_ ?_, hrD, heD⟩
        · have hL : a_D j ≤ L - d := le_trans ha_min (min_le_left _ _)
          calc a_D j / d ≤ (L - d) / d := div_le_div_of_nonneg_right hL hd.le
