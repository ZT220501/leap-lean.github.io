        exact le_trans h_cnt (h_rhs ▸ h_prod)

      
      have hS_bdry_card : (S_bdry.card : ℝ) ≤
          3744 * C_cov ^ 3 * (M_mult : ℝ) * R_tr ^ 2 * ε ^ (-(5 / 4 : ℝ) * h) := by
        have h_bdry_ann : ∀ α ∈ S_bdry,
            R_disk - 4 * s₂ ≤ ‖V_at α - V_O o‖ ∧ ‖V_at α - V_O o‖ ≤ R_disk := by
