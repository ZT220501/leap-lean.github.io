    have hd2 : (13312 * C_cov * ε ^ (-h)) * (C_sub_bes * Wt) ≤
        13312 * B_core * ε ^ (-(5 / 4 : ℝ) * h) * Wt := by
      have h1 : C_cov * C_sub_bes ≤ B_core := by
        have h_cc : C_cov * C_sub_bes ≤ C_sub_bes * C_cov ^ 3 := by
          nlinarith only [hC_cov1, hC_bes]
        have h_nn : 0 ≤ C_sub_bes * C_cov ^ 3 :=
          mul_nonneg (by linarith only [hC_bes]) (by linarith only [hC_cov3_ge1])
        calc C_cov * C_sub_bes
            ≤ C_sub_bes * C_cov ^ 3 := h_cc
          _ = (C_sub_bes * C_cov ^ 3) * 1 := (mul_one _).symm
          _ ≤ (C_sub_bes * C_cov ^ 3) * ((M_mult : ℝ) * R_tr ^ 2) :=
              mul_le_mul_of_nonneg_left hMR_ge1 h_nn
          _ = B_core := by dsimp only [B_core]; ring
      have h2 := mul_le_mul h1 h_eh_54 (Real.rpow_nonneg hε₀.le _) (by linarith only [hB_core_ge1])
      have h3 := mul_le_mul_of_nonneg_right h2 hWt_nn
      linarith only [h3]

    have hd3 : (29952 * C_cov ^ 3 * (M_mult : ℝ) * R_tr ^ 2 * ε ^ (-(5 / 4 : ℝ) * h)) *
          (C_sub_bes * Wt) =
        29952 * B_core * ε ^ (-(5 / 4 : ℝ) * h) * Wt := by
