    have hPD_nn : ∀ d, 0 ≤ P_D d := fun d => Finset.sum_nonneg (fun α _ => hP_nn α d)
    have hPE_nn : ∀ e, 0 ≤ P_E e := fun e => Finset.sum_nonneg (fun α _ => hPT_nn α)
