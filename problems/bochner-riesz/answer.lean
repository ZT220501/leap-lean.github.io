      refine ⟨fun k => (h_each_k k).1, ?_⟩
      obtain ⟨hL1_L, hL1_V⟩ := hF_L1 K_diag r_diag hK_diag_meas hK_diag_fin hr_diag_pos hK_diag_margin
      have h_rhs_lim : Filter.Tendsto (fun k : ℕ =>
