      have hEw : (∑ j : Fin N_D, (∑ o : Fin N_O, p o j) *
            ((1 + γ) * (b_D j / d) + (1 - γ) * (a_D j / d))) =
          d⁻¹ * ∑ j : Fin N_D, (∑ o : Fin N_O, p o j) *
