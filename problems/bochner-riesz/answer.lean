                    (∀ j : Fin N_J,
                      ∑ o' : Fin N'_O, ∑ d' ∈ Finset.univ.filter (fun d' => j_of_D d' = j),
                        p_all o' d' = π_J j) ∧
                    K_r_star - R_bud ≤
                      generalPacketScore ε γ H_P r lam_sys m_r Φ₀ f
                        N'_O N_allD r'_O V'_O X'_O ψ'_O b_all a_all p_all) ∧
                (0 < r →
                  ∀ (δ_out k_out α_out : ℝ),
                    0 < α_out → 2 * ξ ≤ α_out →
                    ((k_out ≤ 0 ∨
                      (use_vel_sub = true ∧ d_dim = 1 ∧
                       ∀ j : Fin N_J, 0 < π_J j →
                         (menu j).k_bin = k_out ∧ (menu j).is_aligned = true)) →
                     K₀ + quantumPacketRate γ * r - δ_out ≤
                       B_r - (1 / 2 : ℝ) * (∑ j : Fin N_J, π_J j * d₁ j) - R_bud →
                     IsCutChainState γ (nextPacketClass M_atom cls) ε H_P L r h lam_sys
                       4 1 Φ₀ f δ_out k_out α_out) ∧
                    (b_star = 0 → (H_P - r) / 2 ≤ L - r →
                     (k_out ≤ 0 ∨
                      (use_vel_sub = true ∧ d_dim = 2 ∧
                       ∀ j : Fin N_J, 0 < π_J j → (menu j).k_bin = k_out)) →
                     K₀ + quantumPacketRate γ * r - δ_out ≤
                       B_r - (1 / 2 : ℝ) *
                         (∑ j : Fin N_J, π_J j * ((menu j).g_bin - 2 * ((H_P - r) / 2))) - R_bud →
                     IsCutChainState γ (nextPacketClass M_atom cls) ε H_P L r h lam_sys
                       4 2 Φ₀ f δ_out k_out α_out)) ∧
                (r = 0 → ∀ ν κ : ℝ,
                  HasRootWidthGap ν κ ε H_P L cls.R_dom γ lam_sys Φ₀ f →
                  H_P / 2 - ν ≤ b_star →
                  κ + R_bud ≤ d₀)) :=
by
  intro cls Δ_u t_rem_min A₀ ξ η R_bud use_vel_sub d_dim
    hΔ_u ht_rem_nn ht_rem_le hA₀ hξ hη hη_Δ hR_bud hd_dim
  have hR_bud_pos : 0 < R_bud := by linarith only [hη, hξ, hR_bud]
  have hR_bud_ξ : 128 * ξ ≤ R_bud := by linarith only [hη, hR_bud]
  let A_amp : ℝ := A₀ / 2 + 2
  have hA_amp_pos : 0 < A_amp := by dsimp only [A_amp]; linarith only [hA₀]
  let B_cut : ℝ := A₀ + 12 * cls.K_hor + 20
  have hB_cut_pos : 0 < B_cut := by dsimp only [B_cut]; linarith only [hA₀, cls.hK_hor]
  have hB_cut_ge : 2 * A_amp + 12 * cls.K_hor + 16 ≤ B_cut := by
    dsimp only [A_amp, B_cut]; linarith only
  obtain ⟨C_cut, C_can, C_Bes, M_mult, C_tr_cut, C_rtail, ε_cut,
    hC_cut, hC_can, hC_Bes, hM_mult, hC_tr_cut, hC_rtail, hε_cut_pos, hε_cut_lt, h_cut_go⟩ :=
    h_cut cls Δ_u A_amp B_cut hΔ_u hA_amp_pos hB_cut_ge
  obtain ⟨C_cov, ε_menu, hC_cov_max, hε_menu_pos, hε_menu_lt, h_menu_go⟩ :=
    single_localizer_greedy_cap_menu γ hγ₀ hγ₁ M_atom cls A₀ ξ R_bud C_cut
      use_vel_sub d_dim M_mult C_tr_cut hA₀ hξ hR_bud_ξ hd_dim hC_cut hM_mult hC_tr_cut
  have hC_cov : 2 ≤ C_cov := le_trans (le_max_left 2 C_cut) hC_cov_max
  let C_tr : ℕ → ℝ := fun M => 2 * C_tr_cut M
  have hC_tr : ∀ M, 0 ≤ C_tr M := fun M => mul_nonneg (by norm_num) (hC_tr_cut M)
  obtain ⟨ε_root, hε_root_pos, _, h_root_go⟩ :=
    subclass_local_root_and_rescaling_bounds γ hγ₀ hγ₁ M_atom h_resc cls Δ_u B_cut ξ η R_bud
      C_cut C_Bes C_cov M_mult C_tr C_rtail hΔ_u hB_cut_pos hξ hη hη_Δ hR_bud
      hC_cut hC_Bes hC_cov hM_mult hC_tr hC_rtail
  obtain ⟨ε_law, hε_law_pos, _, h_law_go⟩ :=
    earlier_laws_and_endpoint_composition γ hγ₀ hγ₁ M_atom cls Δ_u A₀ ξ R_bud C_can C_cov
      use_vel_sub d_dim M_mult C_tr hΔ_u hA₀ hξ hR_bud_ξ hd_dim hC_can hC_cov hM_mult hC_tr
  obtain ⟨ε_grow_r, hε_grow_r_pos, _, h_grow_r⟩ :=
    uniform_all_duration_packet_growth γ hγ₀ hγ₁ hβ_pos hβ_le h_mod
      (nextPacketClass M_atom cls) (2 * Δ_u) R_bud (by positivity) hR_bud_pos
  obtain ⟨ε_grow_loc, hε_grow_loc_pos, _, h_grow_loc⟩ :=
    uniform_all_duration_packet_growth γ hγ₀ hγ₁ hβ_pos hβ_le h_mod
      (localRescaledClass cls 1) (2 * Δ_u) R_bud (by positivity) hR_bud_pos
  let ε_amp : ℝ := (2 * C_cut)⁻¹
  have hε_amp_pos : 0 < ε_amp := by dsimp only [ε_amp]; positivity
  let ε_comp : ℝ := min (1 / 4) (min ε_cut (min ε_menu (min ε_root
    (min ε_law (min ε_grow_r (min ε_grow_loc ε_amp))))))
  have hε_comp_pos : 0 < ε_comp :=
    lt_min (by norm_num) (lt_min hε_cut_pos (lt_min hε_menu_pos (lt_min hε_root_pos
      (lt_min hε_law_pos (lt_min hε_grow_r_pos (lt_min hε_grow_loc_pos hε_amp_pos))))))
  have hε_comp_lt : ε_comp < 1 / 2 := lt_of_le_of_lt (min_le_left _ _) (by norm_num)
  refine ⟨C_cov, M_mult, C_tr, ε_comp, hC_cov, hM_mult, hC_tr, hε_comp_pos, hε_comp_lt, ?_⟩
  intro M_L ε H_P L t r h b_star lam_sys m_r m_t N_O N_D
    Φ₀ ζ₀ f τ_V τ_X n_buf r_O V_O X_O ψ_O b_D a_D r_D e_D V_D X_D
    hML hε_lt hNO hn_buf henv hf_norm
    hr_nn hr_lt_t ht_L ht_HP ht_rem hvel_h
    hb_star_nn hb_star_Lt hb_star_HPt hΔ_u_hr
    hmr_cases hmr_le_mt hmt_lo hmt_hi ho_props ho_pack
  have hε_pos : 0 < ε := henv.1
  have hε_half : ε < 1 / 2 := henv.2.1
  have hε_lt1 : ε < 1 := by linarith only [hε_half]
  have hHP_pos : 0 < H_P := henv.2.2.1
  have hHP_K : H_P ≤ cls.K_hor := henv.2.2.2.1
  have hL_pos : 0 < L := henv.2.2.2.2.1
  have hL_K : L ≤ cls.K_hor := henv.2.2.2.2.2.1
  have hlam_lo : cls.B_sys⁻¹ * ε ^ (-H_P) ≤ lam_sys := henv.2.2.2.2.2.2.1
  have hlam_hi : lam_sys ≤ cls.B_sys * ε ^ (-H_P) := henv.2.2.2.2.2.2.2.1
  have hB_sys2 : 2 ≤ cls.B_sys := cls.hB_sys
  have hB_sys_pos : 0 < cls.B_sys := by linarith only [hB_sys2]
  have hlam_pos : 0 < lam_sys :=
    lt_of_lt_of_le (mul_pos (inv_pos.mpr hB_sys_pos) (Real.rpow_pos_of_pos hε_pos (-H_P))) hlam_lo
  have h2Δ_HP : 2 * Δ_u ≤ H_P := by linarith only [hΔ_u_hr, hr_nn, hb_star_nn]
  have hm1_e := lt_of_lt_of_le hε_lt (min_le_right _ _)
  have hε_lt_cut : ε < ε_cut := lt_of_lt_of_le hm1_e (min_le_left _ _)
  have hm2_e := lt_of_lt_of_le hm1_e (min_le_right _ _)
  have hε_lt_menu : ε < ε_menu := lt_of_lt_of_le hm2_e (min_le_left _ _)
  have hm3_e := lt_of_lt_of_le hm2_e (min_le_right _ _)
  have hε_lt_root : ε < ε_root := lt_of_lt_of_le hm3_e (min_le_left _ _)
  have hm4_e := lt_of_lt_of_le hm3_e (min_le_right _ _)
  have hε_lt_law : ε < ε_law := lt_of_lt_of_le hm4_e (min_le_left _ _)
  have hm5_e := lt_of_lt_of_le hm4_e (min_le_right _ _)
  have hε_lt_grow_r : ε < ε_grow_r := lt_of_lt_of_le hm5_e (min_le_left _ _)
  have hm6_e := lt_of_lt_of_le hm5_e (min_le_right _ _)
  have hε_lt_grow_loc : ε < ε_grow_loc := lt_of_lt_of_le hm6_e (min_le_left _ _)
  have hε_lt_amp : ε < ε_amp := lt_of_lt_of_le hm6_e (min_le_right _ _)
  have hell_pos : 0 < Real.log (ε⁻¹) :=
    Real.log_pos ((one_lt_inv₀ hε_pos).mpr hε_lt1)
  have hC_cut_pos : 0 < C_cut := by linarith only [hC_cut]
  have h_amp_small : C_cut * ε ^ A_amp ≤ (1 / 2) * ε ^ (A₀ / 2) := by
    have hCε : C_cut * ε < 1 / 2 := by
      have h1 : C_cut * ε < C_cut * (2 * C_cut)⁻¹ :=
        mul_lt_mul_of_pos_left hε_lt_amp hC_cut_pos
      have h2 : C_cut * (2 * C_cut)⁻¹ = 1 / 2 := by field_simp [hC_cut_pos.ne']
      linarith only [h1, h2]
    have hε_sq_le : ε ^ 2 ≤ ε := by
