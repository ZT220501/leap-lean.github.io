        have h_eq : (s_x⁻¹ • (x₀ - gridPt2D s_x (kx0, kx1))) 0 = x₀ 0 / s_x - (kx0 : ℝ) := by
          change s_x⁻¹ * (x₀ 0 - (gridPt2D s_x (kx0, kx1)) 0) = _
          rw [(h_grid_coord s_x (kx0, kx1)).1]; field_simp [hsx_pos.ne']
        rw [h_eq, abs_sub_comm] at hc0
        dsimp only [R_X_loc]; push_cast
        linarith only [hc0, hX'_norm, hceil_B, hceil_R]
      · refine h_int_mem_icc kx1 (x₀ 1 / s_x) R_X_loc ?_
        have hc1 := PiLp.norm_apply_le (s_x⁻¹ • (x₀ - gridPt2D s_x (kx0, kx1))) 1
        simp only [Real.norm_eq_abs] at hc1
        have h_eq : (s_x⁻¹ • (x₀ - gridPt2D s_x (kx0, kx1))) 1 = x₀ 1 / s_x - (kx1 : ℝ) := by
          change s_x⁻¹ * (x₀ 1 - (gridPt2D s_x (kx0, kx1)) 1) = _
          rw [(h_grid_coord s_x (kx0, kx1)).2]; field_simp [hsx_pos.ne']
        rw [h_eq, abs_sub_comm] at hc1
        dsimp only [R_X_loc]; push_cast
        linarith only [hc1, hX'_norm, hceil_B, hceil_R]
    rw [Finset.mem_biUnion]
    refine ⟨j, hj_mem, Finset.mem_map.mpr ⟨α, Finset.mem_filter.mpr ⟨Finset.mem_univ α, ho⟩, rfl⟩⟩

  have h_dedup_sites : ∀ (ε H_P L t r b_star lam_sys : ℝ)
      (m_r m_t N_J S_per_loc : ℕ)
      (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
      (f : EuclideanSpace ℝ (Fin 2) → ℂ)
      (N_fam : Fin N_J → ℕ)
      (sub_fam : ∀ j : Fin N_J, LocalizerSubclass (N_fam j)),
      0 < ε → ε < 1 / 2 → 0 < lam_sys → 0 < r → 0 ≤ b_star → 1 ≤ N_J →
      (∀ j : Fin N_J,
        IsValidSubclassAtoms cls M_atom γ ε H_P L t r b_star lam_sys ξ C_cov
          m_r m_t M_mult C_tr Φ₀ (sub_fam j)) →
      (∀ j₀, ∀ S_j : Finset (Fin N_J),
        (∀ j ∈ S_j, (sub_fam j).loc_idx = j₀) → S_j.card ≤ S_per_loc) →
      (let ρ_r := ε ^ ((H_P - r) / 2)
       let σ_r := (lam_sys * ρ_r)⁻¹
       ∀ j (α : Fin (N_fam j)),
         ‖(sub_fam j).c_at α‖ ^ 2 =
           generalPacketObsMass ε H_P r lam_sys m_r Φ₀ f (sub_fam j).loc_idx.1
             (gridPt2D ρ_r ((sub_fam j).o_at α).1)
             (gridPt2D σ_r ((sub_fam j).o_at α).2) ((sub_fam j).ψ_at α)) →
      let ρ_r := ε ^ ((H_P - r) / 2)
      let σ_r := (lam_sys * ρ_r)⁻¹
      let cls' := nextPacketClass M_atom cls
      let R_V_loc : ℕ := 4 * ⌈cls.B_sys⌉₊ + ⌈cls.R_win⌉₊ + 4
      let R_X_loc : ℕ := 8 * ⌈cls.B_sys⌉₊ + 2 * ⌈cls.R_win⌉₊ + 10
      let C_loc_ov : ℕ := (2 * R_V_loc + 1) ^ 2 * (2 * R_X_loc + 1) ^ 2
      ∃ (N'_O : ℕ) (r'_O : Fin N'_O → ℕ)
        (V'_O X'_O : Fin N'_O → EuclideanSpace ℝ (Fin 2))
        (ψ'_O : Fin N'_O → EuclideanSpace ℝ (Fin 2) → ℂ)
        (F_O : (Σ j : Fin N_J, Fin (N_fam j)) → Fin N'_O),
        1 ≤ N'_O ∧
        (∀ o' : Fin N'_O, r'_O o' < 2 ^ m_r ∧ ‖V'_O o'‖ ≤ cls'.B_sys ∧ ‖X'_O o'‖ ≤ cls'.B_sys) ∧
        (∀ o' : Fin N'_O, (∀ k : ℕ, ContDiff ℝ k (ψ'_O o')) ∧
          (∀ z, cls'.R_win ≤ ‖z‖ → ψ'_O o' z = 0) ∧
          (∀ k z, ‖iteratedFDeriv ℝ k (ψ'_O o') z‖ ≤ cls'.M_win k)) ∧
        (letI := Classical.propDecidable
         ∀ (r₀ : ℕ) (v₀ x₀ : EuclideanSpace ℝ (Fin 2)),
           ((Finset.univ.filter (fun o' : Fin N'_O =>
             r'_O o' = r₀ ∧ ‖V'_O o' - v₀‖ ≤ ρ_r ∧ ‖X'_O o' - x₀‖ ≤ σ_r)).card : ℝ) ≤
             (cls'.N_mult : ℝ)) ∧
        (∀ j α, r'_O (F_O ⟨j, α⟩) = (sub_fam j).loc_idx.1 ∧
          V'_O (F_O ⟨j, α⟩) = gridPt2D ρ_r ((sub_fam j).o_at α).1 ∧
          X'_O (F_O ⟨j, α⟩) = gridPt2D σ_r ((sub_fam j).o_at α).2) ∧
        (∀ o' : Fin N'_O,
          0 < generalPacketObsMass ε H_P r lam_sys m_r Φ₀ f
            (r'_O o') (V'_O o') (X'_O o') (ψ'_O o')) ∧
        (∀ j α,
          (sub_fam j).m_bin ≤ generalPacketObsMass ε H_P r lam_sys m_r Φ₀ f
            (r'_O (F_O ⟨j, α⟩)) (V'_O (F_O ⟨j, α⟩)) (X'_O (F_O ⟨j, α⟩)) (ψ'_O (F_O ⟨j, α⟩))) ∧
        (∀ o' : Fin N'_O, ∀ S : Finset (Σ j : Fin N_J, Fin (N_fam j)),
          (∀ ja ∈ S, F_O ja = o') → S.card ≤ C_loc_ov * S_per_loc * M_mult) ∧
        (∀ j : Fin N_J, ∀ o' : Fin N'_O, ∀ S : Finset (Fin (N_fam j)),
          (∀ α ∈ S, F_O ⟨j, α⟩ = o') → S.card ≤ M_mult) := by
    intro ε H_P L t r b_star lam_sys m_r m_t N_J S_per_loc Φ₀ f N_fam sub_fam
      hε₀ hε₁ hlam hr_pos hb_star_nn hNJ h_valid h_card_loc h_mass_at
      ρ_r σ_r cls' R_V_loc R_X_loc C_loc_ov
    let Idx := Σ j : Fin N_J, Fin (N_fam j)
    let site_of : Idx → ℕ × ((ℤ × ℤ) × (ℤ × ℤ)) :=
      fun ja => ((sub_fam ja.1).loc_idx.1, (sub_fam ja.1).o_at ja.2)
    let Sites : Finset (ℕ × ((ℤ × ℤ) × (ℤ × ℤ))) := Finset.univ.image site_of
    let j₀_def : Fin N_J := ⟨0, hNJ⟩
    let ja_def : Idx := ⟨j₀_def, ⟨0, (h_valid j₀_def).1⟩⟩
    let N'_O : ℕ := Fintype.card { s // s ∈ Sites }
    let eO : Fin N'_O ≃ { s // s ∈ Sites } := (Fintype.equivFin { s // s ∈ Sites }).symm
    have hN'O_1 : 1 ≤ N'_O := by
      have : Nonempty { s // s ∈ Sites } := ⟨⟨site_of ja_def, Finset.mem_image_of_mem _ (Finset.mem_univ _)⟩⟩
      exact Fintype.card_pos
    let F_O : Idx → Fin N'_O := fun ja =>
      eO.symm ⟨site_of ja, Finset.mem_image_of_mem _ (Finset.mem_univ ja)⟩
    have hFO_site : ∀ ja : Idx, (eO (F_O ja)).1 = site_of ja := by
      intro ja; dsimp only [F_O]; rw [Equiv.apply_symm_apply]
    have hFO_iff : ∀ (ja : Idx) (o' : Fin N'_O), F_O ja = o' ↔ site_of ja = (eO o').1 := by
      intro ja o'
      constructor
      · intro h; rw [← h, hFO_site]
      · intro h; dsimp only [F_O]; rw [Equiv.symm_apply_eq]; exact Subtype.ext h
    have h_rep_ex : ∀ o' : Fin N'_O,
        ∃ rep : Idx, site_of rep = (eO o').1 ∧
          ∀ ja : Idx, site_of ja = (eO o').1 →
            ‖(sub_fam ja.1).c_at ja.2‖ ^ 2 ≤ ‖(sub_fam rep.1).c_at rep.2‖ ^ 2 := by
      intro o'
      let Fib := Finset.univ.filter (fun ja : Idx => site_of ja = (eO o').1)
      obtain ⟨ja₀, _, hja₀_eq⟩ := Finset.mem_image.mp (eO o').2
      have hFib_ne : Fib.Nonempty := ⟨ja₀, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hja₀_eq⟩⟩
      obtain ⟨rep, hrep_mem, hrep_max⟩ :=
        Finset.exists_max_image Fib (fun ja : Idx => ‖(sub_fam ja.1).c_at ja.2‖ ^ 2) hFib_ne
      exact ⟨rep, (Finset.mem_filter.mp hrep_mem).2,
        fun ja hja => hrep_max ja (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hja⟩)⟩
    choose rep hrep_spec using h_rep_ex
    let r'_O : Fin N'_O → ℕ := fun o' => (eO o').1.1
    let V'_O : Fin N'_O → EuclideanSpace ℝ (Fin 2) := fun o' => gridPt2D ρ_r (eO o').1.2.1
    let X'_O : Fin N'_O → EuclideanSpace ℝ (Fin 2) := fun o' => gridPt2D σ_r (eO o').1.2.2
    let ψ'_O : Fin N'_O → EuclideanSpace ℝ (Fin 2) → ℂ := fun o' => (sub_fam (rep o').1).ψ_at (rep o').2
    have hρ_eq_if : (if r = 0 then (Real.sqrt lam_sys)⁻¹ else ε ^ ((H_P - r) / 2)) = ρ_r :=
      if_neg hr_pos.ne'
    have hε_le1 : ε ≤ 1 := by linarith only [hε₁]
    have hsc_le1 : (((2 : ℝ) ^ m_r)⁻¹) ≤ 1 :=
      inv_le_one_of_one_le₀ (one_le_pow₀ (by norm_num : (1 : ℝ) ≤ 2))
    have hsv_pos : 0 < ε ^ b_star := Real.rpow_pos_of_pos hε₀ b_star
    have hsv_le1 : ε ^ b_star ≤ 1 := Real.rpow_le_one hε₀.le hε_le1 hb_star_nn
    have hsc_pos : 0 < ((2 : ℝ) ^ m_r)⁻¹ := inv_pos.mpr (pow_pos (by norm_num) m_r)
    have hsx_pos : 0 < ((2 : ℝ) ^ m_r)⁻¹ * ε ^ b_star := mul_pos hsc_pos hsv_pos
    have hsx_le1 : ((2 : ℝ) ^ m_r)⁻¹ * ε ^ b_star ≤ 1 :=
      (mul_le_of_le_one_left hsv_pos.le hsc_le1).trans hsv_le1
    have hmass_o' : ∀ o' : Fin N'_O,
        generalPacketObsMass ε H_P r lam_sys m_r Φ₀ f (r'_O o') (V'_O o') (X'_O o') (ψ'_O o') =
          ‖(sub_fam (rep o').1).c_at (rep o').2‖ ^ 2 := by
      intro o'
      have hs_eq := (hrep_spec o').1
      have hq : r'_O o' = (sub_fam (rep o').1).loc_idx.1 := (Prod.mk.inj hs_eq.symm).1
      have ho : (eO o').1.2 = (sub_fam (rep o').1).o_at (rep o').2 := (Prod.mk.inj hs_eq.symm).2
      dsimp only [V'_O, X'_O, ψ'_O]; rw [hq, ho]
      exact (h_mass_at (rep o').1 (rep o').2).symm
    refine ⟨N'_O, r'_O, V'_O, X'_O, ψ'_O, F_O, hN'O_1, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · intro o'
      let j := (rep o').1
      let α := (rep o').2
      have hs_eq := (hrep_spec o').1
      have hq : r'_O o' = (sub_fam j).loc_idx.1 := (Prod.mk.inj hs_eq.symm).1
      have ho : (eO o').1.2 = (sub_fam j).o_at α := (Prod.mk.inj hs_eq.symm).2
      obtain ⟨_, _, hqr, hVJ, hXJ, _, _, _, _, hv_at, _⟩ := h_valid j
      have hvα := hv_at α
      have hV' := hvα.2.2.2.1
      have hX' := hvα.2.2.2.2.1
      dsimp only at hVJ hXJ hV' hX'
      rw [hρ_eq_if] at hV' hX'
      have hB2 := cls.hB_sys
      have hR2 := cls.hR_win
      refine ⟨hq.trans_lt hqr, ?_, ?_⟩
      · dsimp only [V'_O, cls', nextPacketClass]; rw [ho]
        let V_J := gridPt2D (ε ^ b_star) (sub_fam j).loc_idx.2.1
        let V_a := gridPt2D ρ_r ((sub_fam j).o_at α).1
        have hsub_norm : ‖V_a - V_J‖ ≤ 4 * cls.B_sys + cls.R_win + 4 := by
          have h_smul : V_a - V_J = (ε ^ b_star) • ((ε ^ b_star)⁻¹ • (V_a - V_J)) := by
            rw [smul_smul, mul_inv_cancel₀ hsv_pos.ne', one_smul]
          rw [h_smul, norm_smul, Real.norm_eq_abs, abs_of_pos hsv_pos]
          exact (mul_le_of_le_one_left (norm_nonneg _) hsv_le1).trans hV'
        have htri : ‖V_a‖ ≤ ‖V_J‖ + ‖V_a - V_J‖ := by
          have := norm_add_le V_J (V_a - V_J); rwa [add_sub_cancel] at this
        linarith only [htri, hVJ, hsub_norm, hB2, hR2]
      · dsimp only [X'_O, cls', nextPacketClass]; rw [ho]
        let s_x := ((2 : ℝ) ^ m_r)⁻¹ * ε ^ b_star
        let X_J := gridPt2D s_x (sub_fam j).loc_idx.2.2
        let X_a := gridPt2D σ_r ((sub_fam j).o_at α).2
        have hsub_norm : ‖X_a - X_J‖ ≤ 8 * cls.B_sys + 2 * cls.R_win + 10 := by
          have h_smul : X_a - X_J = s_x • (s_x⁻¹ • (X_a - X_J)) := by
            rw [smul_smul, mul_inv_cancel₀ hsx_pos.ne', one_smul]
          rw [h_smul, norm_smul, Real.norm_eq_abs, abs_of_pos hsx_pos]
          exact (mul_le_of_le_one_left (norm_nonneg _) hsx_le1).trans hX'
        have htri : ‖X_a‖ ≤ ‖X_J‖ + ‖X_a - X_J‖ := by
          have := norm_add_le X_J (X_a - X_J); rwa [add_sub_cancel] at this
        linarith only [htri, hXJ, hsub_norm, hB2, hR2]
    · intro o'
      obtain ⟨_, _, _, _, _, _, _, _, _, hv_at, _⟩ := h_valid (rep o').1
      have hvα := hv_at (rep o').2
      exact ⟨hvα.1, hvα.2.1, hvα.2.2.1⟩
    · intro r₀ v₀ x₀
      have hρ_pos : 0 < ρ_r := Real.rpow_pos_of_pos hε₀ _
      have hσ_pos : 0 < σ_r := inv_pos.mpr (mul_pos hlam hρ_pos)
      let Iv0 := Finset.Icc (⌊v₀ 0 / ρ_r⌋ - (1 : ℤ)) (⌊v₀ 0 / ρ_r⌋ + (1 : ℤ))
      let Iv1 := Finset.Icc (⌊v₀ 1 / ρ_r⌋ - (1 : ℤ)) (⌊v₀ 1 / ρ_r⌋ + (1 : ℤ))
      let Ix0 := Finset.Icc (⌊x₀ 0 / σ_r⌋ - (1 : ℤ)) (⌊x₀ 0 / σ_r⌋ + (1 : ℤ))
      let Ix1 := Finset.Icc (⌊x₀ 1 / σ_r⌋ - (1 : ℤ)) (⌊x₀ 1 / σ_r⌋ + (1 : ℤ))
      let PackBox : Finset (ℕ × ((ℤ × ℤ) × (ℤ × ℤ))) :=
        ({r₀} : Finset ℕ) ×ˢ ((Iv0 ×ˢ Iv1) ×ˢ (Ix0 ×ˢ Ix1))
      have hPack_card : PackBox.card = 81 := by
        dsimp only [PackBox, Iv0, Iv1, Ix0, Ix1]
        simp only [Finset.card_product, Finset.card_singleton, Int.card_Icc]
        have hc : ∀ m : ℤ, (m + 1 + 1 - (m - 1)).toNat = 3 := fun _ => by omega
        simp only [hc]
      have : DecidablePred (fun o' : Fin N'_O =>
        r'_O o' = r₀ ∧ ‖V'_O o' - v₀‖ ≤ ρ_r ∧ ‖X'_O o' - x₀‖ ≤ σ_r) := Classical.decPred _
      let S_pack := Finset.univ.filter
        (fun o' : Fin N'_O => r'_O o' = r₀ ∧ ‖V'_O o' - v₀‖ ≤ ρ_r ∧ ‖X'_O o' - x₀‖ ≤ σ_r)
      have h_inj : S_pack.card ≤ PackBox.card := by
        refine Finset.card_le_card_of_injOn (fun o' => (eO o').1) ?_ ?_
        · intro o' ho'
          have ho'_mem : o' ∈ S_pack := Finset.mem_coe.mp ho'
          obtain ⟨hr_eq, hV_le, hX_le⟩ := (Finset.mem_filter.mp ho'_mem).2
          rcases hs : (eO o').1 with ⟨q, ⟨kv0, kv1⟩, ⟨kx0, kx1⟩⟩
          have hq : q = r₀ := by
            have : r'_O o' = q := congr_arg Prod.fst hs
            exact this.symm.trans hr_eq
          dsimp only [V'_O, X'_O] at hV_le hX_le
          rw [hs] at hV_le hX_le
          refine Finset.mem_coe.mpr ?_
          dsimp only; rw [hs]; dsimp only [PackBox]
          rw [Finset.mem_product, Finset.mem_singleton, Finset.mem_product,
            Finset.mem_product, Finset.mem_product]
          refine ⟨hq, ⟨?_, ?_⟩, ⟨?_, ?_⟩⟩
          · refine h_int_mem_icc kv0 (v₀ 0 / ρ_r) 1 ?_
            have hc0 := PiLp.norm_apply_le (gridPt2D ρ_r (kv0, kv1) - v₀) 0
            simp only [Real.norm_eq_abs] at hc0
            have h_c : (gridPt2D ρ_r (kv0, kv1) - v₀) 0 = ρ_r * (kv0 : ℝ) - v₀ 0 := rfl
            rw [h_c] at hc0
