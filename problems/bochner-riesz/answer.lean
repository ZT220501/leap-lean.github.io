                    have h2 : bZ₁ i = lk.2 := by rw [← hlk]
                    exact ⟨hX, Prod.ext hN h1, h2⟩
                  · rintro ⟨hX, hNL, hZ⟩
                    exact ⟨⟨(Prod.mk.inj hNL).1, hX⟩, Prod.ext (Prod.mk.inj hNL).2 hZ⟩
                · exact le_of_eq (congrArg₂ (· * ·)
                    (congrArg₂ (· * ·)
                      (congrArg (ρ_tilde ^ (-η_sl) * ·)
                        (h_ite_congr Finset.univ _ _ ν_P (fun _ _ => Iff.rfl)))
                      (h_ite_congr Finset.univ _ _ ν_P
                        (fun _ _ => ⟨fun h => Prod.mk.inj h, fun h => Prod.ext h.1 h.2⟩)))
                    (h_ite_congr Finset.univ _ _ ν_P (fun _ _ => Iff.rfl)))
              · exact le_rfl
          _ = (ρ_tilde ^ (-η_sl) * p_X kX_star) *
                ((∑ l ∈ S_L, if |l_of_k l - z₀ 0| < r then
                    (∑ i : Fin N_P, if N_bin i = n_star ∧ L_bin i = l then ν_P i else 0) else 0) *
                 (∑ k_Z ∈ S_Z1, if |z_of_k k_Z - z₀ 1| < r then
                    (∑ i : Fin N_P, if bZ₁ i = k_Z then ν_P i else 0) else 0)) := by
              rw [Finset.sum_product, Finset.sum_mul_sum, Finset.mul_sum S_L]
              apply Finset.sum_congr rfl
              intro l _
              rw [Finset.mul_sum S_Z1]
              apply Finset.sum_congr rfl
              intro k_Z _
              dsimp [Q_LZ]
              by_cases hl : |l_of_k l - z₀ 0| < r <;> by_cases hk : |z_of_k k_Z - z₀ 1| < r <;>
                simp [hl, hk] <;> ring
          _ ≤ (ρ_tilde ^ (-η_sl) * p_X kX_star) *
                ((12 * ρ_tilde ^ (-3 * η_sl) * p_N n_star * r ^ x) *
                 (ρ_tilde ^ (-η_sl) * r ^ z)) := by
              rw [h_coll_L, h_coll_Z1]
              refine mul_le_mul_of_nonneg_left ?_
                (mul_nonneg (Real.rpow_nonneg hρ_t_pos.le _) (hp_X_nn kX_star))
              have hZ' : (∑ i : Fin N_P, if |Z₁_hat i - z₀ 1| < r then ν_P i else 0) ≤
                  ρ_tilde ^ (-η_sl) * r ^ z := by
                refine le_trans ?_ (hν_Z_ball (z₀ 1) r hr₀ hr₁)
