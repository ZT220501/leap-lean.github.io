        have hl_hi : nl.2 ≤ l₀ + 6 := by
          by_contra hgt
          have h_ge : l₀ + 7 ≤ nl.2 := by omega
          have h_r : (l₀ : ℝ) + 7 ≤ (nl.2 : ℝ) := by exact_mod_cast h_ge
          linarith [(abs_lt.mp habs_l).2, hl_lt]
