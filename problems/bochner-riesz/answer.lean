      calc |(lam_sys * ρ₀) * iteratedDeriv m (f_vec P₀) t -
            c * iteratedDeriv m (fun s : ℝ => s * f_vec e s) t|
          ≤ |(lam_sys * ρ₀) * iteratedDeriv m (f_vec P₀) t| +
              |c * iteratedDeriv m (fun s : ℝ => s * f_vec e s) t| := abs_sub _ _
        _ ≤ (B_sys + R_dom + 4) * A ^ (m + 1) * ((m.factorial : ℝ) ^ 3) +
              (4 * A ^ (m + 1) * ((m.factorial : ℝ) ^ 3) +
                (m : ℝ) * A ^ m * (((m - 1).factorial : ℝ) ^ 3)) := add_le_add h_term1 h_term2
        _ = C_term m := by dsimp only [C_term]; ring
    refine ⟨hγ_cd, hΦ_line_cd, hΦ_line_deriv, ?_⟩
    intro m hm t ht
    let ψ_m : ℝ → ℝ := fun τ => G_iter m (t, τ)
