                |(dV_diag m' (p.2, p.1) - D (p.2, p.1)) * W₂ (p.2, p.1)| := abs_add_le _ _
          _ = E_L m' j_top (p.2, p.1) * |W₁ (p.2, p.1)| +
                E_V m' (p.2, p.1) * |W₂ (p.2, p.1)| := by
              rw [abs_mul, abs_neg, abs_mul]
          _ ≤ E_L m' j_top (p.2, p.1) * B_φ + E_V m' (p.2, p.1) * B_φ :=
              add_le_add (mul_le_mul_of_nonneg_left hW₁_p (abs_nonneg _))
                (mul_le_mul_of_nonneg_left hW₂_p (abs_nonneg _))
          _ ≤ B_φ * E_tot m' (p.2, p.1) := by
              dsimp [E_tot]
              nlinarith [abs_nonneg (dV_diag m' (p.2, p.1) - D (p.2, p.1))]
      refine h_abs_le.trans ?_
      rw [← h_rect_eq_prod (fun ui => B_φ * E_tot m' (ui.2, ui.1)) δ (1 - δ) (-K) K
        (by linarith) (by linarith) hEtot_sw_int]
      have hB_Etot_int : MeasureTheory.IntegrableOn (fun iu => B_φ * E_tot m' iu)
          (Set.Ioc (-K) K ×ˢ Set.Ioc δ (1 - δ)) MeasureTheory.volume :=
        hEtot_sub.const_mul B_φ
      rw [← h_rect_swap (fun iu => B_φ * E_tot m' iu) (-K) K δ (1 - δ)
        (by linarith) (by linarith) hB_Etot_int]
      simp_rw [intervalIntegral.integral_const_mul]
      refine mul_le_mul_of_nonneg_left ?_ hB_φ_nn
      exact (h_rect_mono (E_tot m') (-((m' + 2 : ℝ))) (m' + 2 : ℝ)
        ((m' + 4 : ℝ)⁻¹) (1 - (m' + 4 : ℝ)⁻¹) (-K) K δ (1 - δ)
        (by linarith) (by linarith) h_K_m' h_δ_m' (by linarith) (by linarith)
        (hEtot_nn m') hEtot_big).trans (h_diag_err m')
    exact ge_of_tendsto' hI_tendsto hI_sm_nn

theorem cone_uniform_affine_blowup (n : ℕ) (hn : 2 ≤ n) (j_top : Fin n)
    (c d : Fin n → ℝ) (d_v : ℝ) (E_cone : Fin n → Fin n → Prop)
    (hc_inj : Function.Injective c)
    (hd_nn : (∀ j, 0 ≤ d j) ∧ 0 ≤ d_v)
    (hE_pos : ∀ j k : Fin n, E_cone j k → 0 < c k - c j)
    (f : ((Fin n → ℝ) × ℝ) → ℝ)
    (hf : IsSubmodularConeProfile n c d d_v E_cone f)
    (a : Fin n → ℝ × ℝ → ℝ) (D : ℝ × ℝ → ℝ)
    (h_tr : IsCharacteristicTraceData n j_top c d d_v E_cone f a D) :
    ∃ h_seq : ℕ → ℝ,
      (∀ l, 0 < h_seq l) ∧
      Filter.Tendsto h_seq Filter.atTop (nhds 0) ∧
      (∀ᵐ iu : ℝ × ℝ, iu.2 ∈ Set.Ioo (0 : ℝ) 1 →
        ∀ (R ε_err : ℝ), 1 ≤ R → 0 < ε_err →
          ∀ᶠ l in Filter.atTop, ∀ ξ : (Fin n → ℝ) × ℝ,
            InDispCone n c E_cone ξ → (∀ j, |ξ.1 j| ≤ R) → |ξ.2| ≤ R →
            |(f (planeEmbed n c iu + h_seq l • ξ) - f (planeEmbed n c iu)) / h_seq l -
              ((∑ j : Fin n, a j iu * ξ.1 j) + D iu * ξ.2)| ≤ ε_err) :=
by
  obtain ⟨M_lip, hM_lip, h_lip⟩ := h_tr.2.2.1
  let h_tr_grad := h_tr.2.2.2.1
  
  have hC_strict_open : IsOpen { η : (Fin n → ℝ) × ℝ | IsStrictDispCone n c E_cone η } := by
    have h_eq : { η : (Fin n → ℝ) × ℝ | IsStrictDispCone n c E_cone η } =
        ⋂ j : Fin n, ⋂ k : Fin n,
          { η : (Fin n → ℝ) × ℝ | E_cone j k → η.1 k - η.1 j < (c k - c j) * η.2 } := by
      ext η
      simp only [Set.mem_ofPred, Set.mem_iInter, IsStrictDispCone]
    rw [h_eq]
    refine isOpen_iInter_of_finite fun j => isOpen_iInter_of_finite fun k => ?_
    by_cases hjk : E_cone j k
    · have h_sub : { η : (Fin n → ℝ) × ℝ | E_cone j k → η.1 k - η.1 j < (c k - c j) * η.2 } =
          { η : (Fin n → ℝ) × ℝ | η.1 k - η.1 j < (c k - c j) * η.2 } := by
        ext η
        simp [hjk]
      rw [h_sub]
      exact isOpen_lt (((continuous_apply k).comp continuous_fst).sub
        ((continuous_apply j).comp continuous_fst))
        (continuous_const.mul continuous_snd)
    · have h_univ : { η : (Fin n → ℝ) × ℝ | E_cone j k → η.1 k - η.1 j < (c k - c j) * η.2 } =
          Set.univ := by
        ext η
        simp [hjk]
      rw [h_univ]
      exact isOpen_univ
  have hS_strict_open : IsOpen { p : (Fin n → ℝ) × ℝ | InStrictResolutionCone n c E_cone p } :=
    (isOpen_Ioo.preimage continuous_snd).inter hC_strict_open
  have h_strict_to_res : ∀ p : (Fin n → ℝ) × ℝ,
      InStrictResolutionCone n c E_cone p → InResolutionCone n c E_cone p :=
    fun p ⟨hp2, hsc⟩ => ⟨hp2, fun j k hjk => (hsc j k hjk).le⟩
  have hf_lip_on : LipschitzOnWith (Real.toNNReal (M_lip * ((n : ℝ) + 1))) f
      { p : (Fin n → ℝ) × ℝ | InResolutionCone n c E_cone p } := by
    refine LipschitzOnWith.of_dist_le_mul fun p hp q hq => ?_
    rw [Real.coe_toNNReal _ (mul_nonneg hM_lip (by positivity)), Real.dist_eq]
    have h1 : ∀ j : Fin n, |p.1 j - q.1 j| ≤ dist p q := fun j => by
      rw [← Real.dist_eq, Prod.dist_eq]
      exact le_trans (dist_le_pi_dist p.1 q.1 j) (le_max_left _ _)
    have h2 : |p.2 - q.2| ≤ dist p q := by
      rw [← Real.dist_eq, Prod.dist_eq]
      exact le_max_right _ _
    have h_sum : (∑ j : Fin n, |p.1 j - q.1 j|) + |p.2 - q.2| ≤ ((n : ℝ) + 1) * dist p q := by
      have hs : ∑ j : Fin n, |p.1 j - q.1 j| ≤ ∑ _ : Fin n, dist p q :=
        Finset.sum_le_sum fun j _ => h1 j
      rw [Finset.sum_const, Finset.card_fin, nsmul_eq_mul] at hs
      linarith
    exact le_trans (h_lip p q hp hq)
      (by rw [mul_assoc]; exact mul_le_mul_of_nonneg_left h_sum hM_lip)
  obtain ⟨f_ext, hf_ext_lip, hf_ext_eq⟩ := hf_lip_on.extend_real
  have hf₀_meas : Measurable (strictConeRestrict n c E_cone f) := by
    have h_ind : strictConeRestrict n c E_cone f =
        { p : (Fin n → ℝ) × ℝ | InStrictResolutionCone n c E_cone p }.indicator f_ext := by
      ext p
      unfold strictConeRestrict
      by_cases hp : InStrictResolutionCone n c E_cone p
      · have hp_mem : p ∈ { q : (Fin n → ℝ) × ℝ | InStrictResolutionCone n c E_cone q } := hp
        rw [Set.indicator_of_mem hp_mem]
        simp only [hp, ↓reduceIte]
        exact hf_ext_eq (h_strict_to_res p hp)
      · have hp_nmem : p ∉ { q : (Fin n → ℝ) × ℝ | InStrictResolutionCone n c E_cone q } := hp
        rw [Set.indicator_of_notMem hp_nmem]
        simp only [hp, ↓reduceIte]
    rw [h_ind]
    exact hf_ext_lip.continuous.measurable.indicator hS_strict_open.measurableSet
  let eL : Fin n → (Fin n → ℝ) × ℝ := fun j => (Function.update 0 j 1, 0)
  let eV : (Fin n → ℝ) × ℝ := (0, 1)
  have heL_shift : ∀ (j : Fin n) (q : (Fin n → ℝ) × ℝ) (τ : ℝ),
      (Function.update q.1 j (q.1 j + τ), q.2) = q + τ • eL j := by
    intro j q τ
    refine Prod.ext ?_ (by simp [eL])
    ext k
    by_cases hkj : k = j
    · subst hkj; simp [eL]
    · simp [eL, Function.update_of_ne hkj]
  have heV_shift : ∀ (q : (Fin n → ℝ) × ℝ) (τ : ℝ),
      (q.1, q.2 + τ) = q + τ • eV := by
    intro q τ
    refine Prod.ext ?_ (by simp [eV])
    ext k
    simp [eV]
  have hpartL_meas : ∀ j : Fin n, Measurable (conePartialL n c d E_cone f j) := by
    intro j
    unfold conePartialL
    refine Measurable.limsup fun m => ?_
    have hc_shift : Continuous (fun p : (Fin n → ℝ) × ℝ =>
        (Function.update p.1 j (p.1 j + ((m + 1 : ℝ))⁻¹), p.2)) := by
      have h_eq : (fun p : (Fin n → ℝ) × ℝ =>
          (Function.update p.1 j (p.1 j + ((m + 1 : ℝ))⁻¹), p.2)) =
          fun p => p + ((m + 1 : ℝ))⁻¹ • eL j := by
        funext p
        exact heL_shift j p (((m + 1 : ℝ))⁻¹)
      rw [h_eq]
      exact continuous_id.add continuous_const
    have hm_diff : Measurable (fun p : (Fin n → ℝ) × ℝ =>
        strictConeRestrict n c E_cone f (Function.update p.1 j (p.1 j + ((m + 1 : ℝ))⁻¹), p.2) -
          strictConeRestrict n c E_cone f p) :=
      (hf₀_meas.comp hc_shift.measurable).sub hf₀_meas
    have hm_mul : Measurable (fun p : (Fin n → ℝ) × ℝ =>
        ((m + 1 : ℝ)) *
          (strictConeRestrict n c E_cone f (Function.update p.1 j (p.1 j + ((m + 1 : ℝ))⁻¹), p.2) -
            strictConeRestrict n c E_cone f p)) :=
      hm_diff.const_mul ((m + 1 : ℝ))
    exact measurable_const.max (measurable_const.min hm_mul)
  have hpartV_meas : Measurable (conePartialV n c d_v E_cone f) := by
    unfold conePartialV
    refine Measurable.limsup fun m => ?_
    have hc_shift : Continuous (fun p : (Fin n → ℝ) × ℝ => (p.1, p.2 + ((m + 1 : ℝ))⁻¹)) :=
      continuous_fst.prodMk (continuous_snd.add continuous_const)
    have hm_diff : Measurable (fun p : (Fin n → ℝ) × ℝ =>
        strictConeRestrict n c E_cone f (p.1, p.2 + ((m + 1 : ℝ))⁻¹) -
          strictConeRestrict n c E_cone f p) :=
      (hf₀_meas.comp hc_shift.measurable).sub hf₀_meas
    have hm_mul : Measurable (fun p : (Fin n → ℝ) × ℝ =>
        ((m + 1 : ℝ)) *
          (strictConeRestrict n c E_cone f (p.1, p.2 + ((m + 1 : ℝ))⁻¹) -
            strictConeRestrict n c E_cone f p)) :=
      hm_diff.const_mul ((m + 1 : ℝ))
    exact measurable_const.max (measurable_const.min hm_mul)
  have hpartL_bds : ∀ (j : Fin n) (p : (Fin n → ℝ) × ℝ),
      0 ≤ conePartialL n c d E_cone f j p ∧ conePartialL n c d E_cone f j p ≤ d j := by
    intro j p
    unfold conePartialL
    constructor
    · refine Filter.le_limsup_of_frequently_le
        (Filter.Eventually.of_forall fun m => le_max_left 0 _).frequently ?_
      exact ⟨d j, Filter.eventually_map.mpr
        (Filter.Eventually.of_forall fun m => max_le (hd_nn.1 j) (min_le_left _ _))⟩
    · refine Filter.limsup_le_of_le ?_
        (Filter.Eventually.of_forall fun m => max_le (hd_nn.1 j) (min_le_left _ _))
      exact Filter.isCoboundedUnder_le_of_eventually_le Filter.atTop
        (Filter.Eventually.of_forall fun m => le_max_left 0 _)
  have hpartV_bds : ∀ p : (Fin n → ℝ) × ℝ,
      0 ≤ conePartialV n c d_v E_cone f p ∧ conePartialV n c d_v E_cone f p ≤ d_v := by
    intro p
    unfold conePartialV
    constructor
    · refine Filter.le_limsup_of_frequently_le
        (Filter.Eventually.of_forall fun m => le_max_left 0 _).frequently ?_
      exact ⟨d_v, Filter.eventually_map.mpr
        (Filter.Eventually.of_forall fun m => max_le hd_nn.2 (min_le_left _ _))⟩
    · refine Filter.limsup_le_of_le ?_
        (Filter.Eventually.of_forall fun m => max_le hd_nn.2 (min_le_left _ _))
      exact Filter.isCoboundedUnder_le_of_eventually_le Filter.atTop
        (Filter.Eventually.of_forall fun m => le_max_left 0 _)
  
  let H_err : ℝ → ℝ → ℝ × ℝ → (Fin n → ℝ) × ℝ → ℝ := fun R h iu ξ =>
    letI := Classical.propDecidable
    if IsStrictDispCone n c E_cone ξ ∧ (∀ j, |ξ.1 j| ≤ R) ∧ |ξ.2| ≤ R then
      (∑ j : Fin n,
        |conePartialL n c d E_cone f j (planeEmbed n c iu + h • ξ) - a j iu|) +
        |conePartialV n c d_v E_cone f (planeEmbed n c iu + h • ξ) - D iu|
    else 0
  let errFn : ℝ → ℝ → ℝ × ℝ → ℝ := fun R h iu => ∫ ξ : (Fin n → ℝ) × ℝ, H_err R h iu ξ
  let M_lin : ℝ := (∑ j : Fin n, d j) + d_v
  have hH_nn : ∀ R h iu ξ, 0 ≤ H_err R h iu ξ := by
    intro R h iu ξ
    dsimp only [H_err]
    split_ifs
    · exact add_nonneg (Finset.sum_nonneg fun j _ => abs_nonneg _) (abs_nonneg _)
    · exact le_rfl
  have hH_le_box : ∀ R h iu ξ,
      H_err R h iu ξ ≤
        ((Set.univ.pi fun _ : Fin n => Set.Icc (-R) R) ×ˢ Set.Icc (-R) R).indicator
          (fun _ => M_lin) ξ := by
    intro R h iu ξ
    dsimp only [H_err]
    split_ifs with h_cond
    · have h_mem : ξ ∈ (Set.univ.pi fun _ : Fin n => Set.Icc (-R) R) ×ˢ Set.Icc (-R) R :=
        ⟨fun j _ => abs_le.mp (h_cond.2.1 j), abs_le.mp h_cond.2.2⟩
      rw [Set.indicator_of_mem h_mem]
      have hL : ∀ j : Fin n,
          |conePartialL n c d E_cone f j (planeEmbed n c iu + h • ξ) - a j iu| ≤ d j := by
        intro j
        have hb1 := hpartL_bds j (planeEmbed n c iu + h • ξ)
        have hb2 := (h_tr.1 j).2 iu
        exact abs_sub_le_iff.mpr ⟨by linarith, by linarith⟩
      have hV : |conePartialV n c d_v E_cone f (planeEmbed n c iu + h • ξ) - D iu| ≤ d_v := by
        have hb1 := hpartV_bds (planeEmbed n c iu + h • ξ)
        have hb2 := h_tr.2.1.2 iu
        exact abs_sub_le_iff.mpr ⟨by linarith, by linarith⟩
      exact add_le_add (Finset.sum_le_sum fun j _ => hL j) hV
    · exact Set.indicator_nonneg (fun _ _ =>
        add_nonneg (Finset.sum_nonneg fun j _ => hd_nn.1 j) hd_nn.2) ξ
  have hCR_meas : ∀ R : ℝ, MeasurableSet
      { ξ : (Fin n → ℝ) × ℝ | IsStrictDispCone n c E_cone ξ ∧ (∀ j, |ξ.1 j| ≤ R) ∧ |ξ.2| ≤ R } := by
    intro R
    have h_eq : { ξ : (Fin n → ℝ) × ℝ |
        IsStrictDispCone n c E_cone ξ ∧ (∀ j, |ξ.1 j| ≤ R) ∧ |ξ.2| ≤ R } =
        { ξ | IsStrictDispCone n c E_cone ξ } ∩
          ((⋂ j : Fin n, { ξ : (Fin n → ℝ) × ℝ | |ξ.1 j| ≤ R }) ∩
            { ξ : (Fin n → ℝ) × ℝ | |ξ.2| ≤ R }) := by
      ext ξ
      simp only [Set.mem_ofPred, Set.mem_inter_iff, Set.mem_iInter]
    rw [h_eq]
    refine hC_strict_open.measurableSet.inter ((MeasurableSet.iInter fun j => ?_).inter ?_)
    · exact (isClosed_le (((continuous_apply j).comp continuous_fst).abs) continuous_const).measurableSet
    · exact (isClosed_le (continuous_snd.abs) continuous_const).measurableSet
  have hH_joint_meas : ∀ R h : ℝ,
      Measurable (fun p : (ℝ × ℝ) × ((Fin n → ℝ) × ℝ) => H_err R h p.1 p.2) := by
    intro R h
    let S_R : Set ((ℝ × ℝ) × ((Fin n → ℝ) × ℝ)) :=
      Prod.snd ⁻¹' { ξ | IsStrictDispCone n c E_cone ξ ∧ (∀ j, |ξ.1 j| ≤ R) ∧ |ξ.2| ≤ R }
    let G_val : (ℝ × ℝ) × ((Fin n → ℝ) × ℝ) → ℝ := fun p =>
      (∑ j : Fin n,
        |conePartialL n c d E_cone f j (planeEmbed n c p.1 + h • p.2) - a j p.1|) +
        |conePartialV n c d_v E_cone f (planeEmbed n c p.1 + h • p.2) - D p.1|
    have h_eq : (fun p : (ℝ × ℝ) × ((Fin n → ℝ) × ℝ) => H_err R h p.1 p.2) =
        S_R.indicator G_val := by
      ext p
      dsimp only [H_err, S_R, G_val]
      by_cases hp : IsStrictDispCone n c E_cone p.2 ∧ (∀ j, |p.2.1 j| ≤ R) ∧ |p.2.2| ≤ R
      · have hp_mem : p ∈ S_R := hp
        rw [Set.indicator_of_mem hp_mem]
        split_ifs
        rfl
      · have hp_nmem : p ∉ S_R := hp
        rw [Set.indicator_of_notMem hp_nmem]
        split_ifs
        rfl
    rw [h_eq]
    have hc_emb : Continuous (fun p : (ℝ × ℝ) × ((Fin n → ℝ) × ℝ) =>
        planeEmbed n c p.1 + h • p.2) := by
      have hc_pl : Continuous (planeEmbed n c) :=
        (continuous_pi fun j => continuous_fst.add (continuous_const.mul continuous_snd)).prodMk
          continuous_snd
      exact (hc_pl.comp continuous_fst).add (continuous_snd.const_smul h)
    have hG_meas : Measurable G_val := by
      refine (Finset.measurable_sum Finset.univ fun j _ => ?_).add ?_
      · exact ((hpartL_meas j).comp hc_emb.measurable |>.sub
          ((h_tr.1 j).1.comp measurable_fst)).abs
      · exact (hpartV_meas.comp hc_emb.measurable |>.sub
          (h_tr.2.1.1.comp measurable_fst)).abs
    exact hG_meas.indicator ((hCR_meas R).preimage measurable_snd)
  have hB_int : ∀ R : ℝ, MeasureTheory.Integrable
      (((Set.univ.pi fun _ : Fin n => Set.Icc (-R) R) ×ˢ Set.Icc (-R) R).indicator
        (fun _ => M_lin)) MeasureTheory.volume := by
    intro R
    have h_comp : IsCompact ((Set.univ.pi fun _ : Fin n => Set.Icc (-R) R) ×ˢ Set.Icc (-R) R) :=
      (isCompact_univ_pi fun _ => isCompact_Icc).prod isCompact_Icc
    have h_meas_set : MeasurableSet
        ((Set.univ.pi fun _ : Fin n => Set.Icc (-R) R) ×ˢ Set.Icc (-R) R) :=
      h_comp.isClosed.measurableSet
    exact (MeasureTheory.integrableOn_const (C := M_lin) (hs := h_comp.measure_lt_top.ne)).integrable_indicator
      h_meas_set
  have hH_int : ∀ R h : ℝ, ∀ iu : ℝ × ℝ,
      MeasureTheory.Integrable (H_err R h iu) MeasureTheory.volume := by
    intro R h iu
    have hm : Measurable (H_err R h iu) :=
      (hH_joint_meas R h).comp (measurable_const.prodMk measurable_id)
    exact (hB_int R).mono' hm.aestronglyMeasurable
      (Filter.Eventually.of_forall fun ξ => by
        rw [Real.norm_of_nonneg (hH_nn R h iu ξ)]
        exact hH_le_box R h iu ξ)
  have herr_nn : ∀ R h iu, 0 ≤ errFn R h iu := fun R h iu =>
    MeasureTheory.integral_nonneg (hH_nn R h iu)
  have herr_mono : ∀ {R₁ R₂ : ℝ}, R₁ ≤ R₂ → ∀ h iu, errFn R₁ h iu ≤ errFn R₂ h iu := by
    intro R₁ R₂ hR12 h iu
    refine MeasureTheory.integral_mono_of_nonneg
      (Filter.Eventually.of_forall (hH_nn R₁ h iu)) (hH_int R₂ h iu)
      (Filter.Eventually.of_forall fun ξ => ?_)
    dsimp only [H_err]
    split_ifs with h1 h2 h2
    · exact le_rfl
    · exfalso
      exact h2 ⟨h1.1, fun j => le_trans (h1.2.1 j) hR12, le_trans h1.2.2 hR12⟩
    · exact add_nonneg (Finset.sum_nonneg fun j _ => abs_nonneg _) (abs_nonneg _)
    · exact le_rfl
  have herr_aesm : ∀ R h : ℝ,
      MeasureTheory.AEStronglyMeasurable (errFn R h) MeasureTheory.volume := by
    intro R h
    exact (hH_joint_meas R h).aestronglyMeasurable.integral_prod_right'
  have herr_intOn : ∀ (K δ R h : ℝ),
      MeasureTheory.IntegrableOn (errFn R h)
        (Set.Ioc (-K) K ×ˢ Set.Ioc δ (1 - δ)) MeasureTheory.volume := by
    intro K δ R h
    let Q := Set.Ioc (-K) K ×ˢ Set.Ioc δ (1 - δ)
    let C_bd := ∫ ξ : (Fin n → ℝ) × ℝ,
      ((Set.univ.pi fun _ : Fin n => Set.Icc (-R) R) ×ˢ Set.Icc (-R) R).indicator
        (fun _ => M_lin) ξ
    have hQ_sub : Q ⊆ Set.Icc (-K) K ×ˢ Set.Icc δ (1 - δ) :=
      Set.prod_mono Set.Ioc_subset_Icc_self Set.Ioc_subset_Icc_self
    have hQ_lt : MeasureTheory.volume Q < ⊤ :=
      lt_of_le_of_lt (MeasureTheory.measure_mono hQ_sub)
        (isCompact_Icc.prod isCompact_Icc).measure_lt_top
    refine (MeasureTheory.integrableOn_const (C := C_bd) (hs := hQ_lt.ne)).mono'
      (herr_aesm R h).restrict (Filter.Eventually.of_forall fun iu => ?_)
    rw [Real.norm_of_nonneg (herr_nn R h iu)]
