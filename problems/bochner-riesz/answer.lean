      conv_lhs => rw [this, Real.cos_add]
    have h_sin : Real.sin φ₁ = Real.sin (φ₁ - φ₂) * Real.cos φ₂ + Real.cos (φ₁ - φ₂) * Real.sin φ₂ := by
      have : φ₁ = (φ₁ - φ₂) + φ₂ := by ring
      conv_lhs => rw [this, Real.sin_add]
