      have hν1 : ν < m * u / 2 := lt_of_le_of_lt (min_le_right _ _) (by linarith)
      have hν_le : ν ≤ ε_lim / 16 := min_le_left _ _
      obtain ⟨U₁, U₂, hU₁_lim, hU₂_lim, h_sq⟩ := h_cross_squeeze u hu hu_dyad ν hν0 hν1
      obtain ⟨N₁, hN₁⟩ := Metric.tendsto_atTop.mp hU₁_lim (ε_lim / 16) (by linarith)
      obtain ⟨N₂, hN₂⟩ := Metric.tendsto_atTop.mp hU₂_lim (ε_lim / 16) (by linarith)
      refine ⟨max N₁ N₂, fun n hn => ?_⟩
      obtain ⟨h_ent1, _, _⟩ := fin_entropy_bounded_fiber_and_restriction
        (path.ε_seq n) (path.hε_bounds n).1 (path.hε_bounds n).2
        (path.N_ω n) (π'_seq n) (hπ'_props n).1 (hπ'_props n).2.1
      let ε := path.ε_seq n
      let k_r := fun ω => dyadicRealBin ε (m * u) (R_seq n ω)
      let k_ang := fun ω => angBin ε (m * u) (path.θ_time u n ω)
      let G_std := fun ω => stdApertureObs ε u (b u) (b u + m * u)
        (path.V_seq n (path.T_seq n ω)) (path.A_seq n (path.T_seq n ω))
        (path.c_seq n ω) (path.θ_time u n ω)
      let G_row := fun ω => rowObs6 ε m
        (V'_seq n (path.T_seq n ω)) (A'_seq n (path.T_seq n ω))
        (path.c_seq n ω) (R_seq n ω)
        (b u, b u + u, b u + m * u, b u + (1 + m) * u, u)
      have h_mi : |finMutualInfo ε (π'_seq n) (path.T_seq n) G_row -
          finMutualInfo ε (π'_seq n) (path.T_seq n) G_std| ≤
          finCondEntropy ε (π'_seq n) G_std G_row +
          finCondEntropy ε (π'_seq n) G_row G_std :=
        (h_ent1 (path.T_seq n) G_std G_row).2.2.2
      have h_std_to_row : finCondEntropy ε (π'_seq n) G_std G_row ≤
          finCondEntropy ε (π'_seq n) k_ang k_r +
          finCondEntropy ε (π'_seq n) (fun ω => (G_std ω, k_r ω)) G_row := by
        have hs1 := (h_ent1 G_std k_r G_row).2.2.1
        have hs2 : finCondEntropy ε (π'_seq n) G_std k_r ≤
            finCondEntropy ε (π'_seq n) k_ang k_r := by
          refine (h_ent1 G_std k_ang k_r).2.1 (fun ω₁ ω₂ _ _ h => ?_)
          have h2 : (G_std ω₁).2.1 = (G_std ω₂).2.1 := congrArg (fun x => x.2.1) h
          dsimp only [G_std, stdApertureObs, k_ang] at h2 ⊢
          rwa [add_sub_cancel_left] at h2
        linarith
      have h_row_to_std : finCondEntropy ε (π'_seq n) G_row G_std ≤
          finCondEntropy ε (π'_seq n) k_r k_ang +
          finCondEntropy ε (π'_seq n) (fun ω => (G_row ω, k_ang ω)) G_std := by
        have hs1 := (h_ent1 G_row k_ang G_std).2.2.1
        have hs2 : finCondEntropy ε (π'_seq n) G_row k_ang ≤
            finCondEntropy ε (π'_seq n) k_r k_ang :=
          (h_ent1 G_row k_r k_ang).2.1 (fun _ _ _ _ h => congrArg (fun x => x.2.1) h)
        linarith
      obtain ⟨hb1, hb2, hb3, hb4⟩ := h_sq n
      have hd1 := hN₁ n (le_trans (le_max_left _ _) hn)
      have hd2 := hN₂ n (le_trans (le_max_right _ _) hn)
      rw [Real.dist_eq] at hd1 hd2
      have hu1_lt : U₁ n < ν + ε_lim / 16 := by linarith [abs_lt.mp hd1]
      have hu2_lt : U₂ n < 2 * ν + ε_lim / 16 := by linarith [abs_lt.mp hd2]
      rw [Real.dist_eq, sub_zero]
      linarith
    have h_comb := h_std_lim.sub h_mi_diff_lim
    rw [sub_zero] at h_comb
    refine h_comb.congr (fun n => ?_)
    have h_rinv := h_root_inv (use0 n) (path.ε_seq n) (1 + m) γ (path.N_ω n) (path.N_T n)
      (π'_seq n) (path.T_seq n) (path.V_seq n) (path.A_seq n)
    dsimp only [V'_seq, A'_seq] at h_rinv ⊢
    rw [h_rinv]
    unfold rowObsScore stdApertureScore
    ring
  exact ⟨{
    ε_seq := path.ε_seq
    N_ω := path.N_ω
    N_T := path.N_T
    π_seq := π'_seq
    T_seq := path.T_seq
    V_seq := V'_seq
    A_seq := A'_seq
    c_seq := path.c_seq
    R_seq := R_seq
    hε_bounds := path.hε_bounds
    hε_tendsto := path.hε_tendsto
    h_law := h_law_out
    h_dyad_sat := h_dyad_sat_out
    h_dyad_pred := h_dyad_pred_out
  }⟩

theorem finite_uniform_surprise_bin_homogenization : (∀ {N_ω : ℕ} {α_X α_Y : Type} (ε : ℝ) (π : Fin N_ω → ℝ)
      (X : Fin N_ω → α_X) (Y : Fin N_ω → α_Y) (E : Finset (Fin N_ω)),
      0 < ε → ε < 1 / 2 →
      (∀ ω, 0 ≤ π ω) → (∑ ω : Fin N_ω, π ω = 1) →
      (∀ ω ∈ E, 0 < π ω) → 0 < (∑ ω ∈ E, π ω) →
      (∀ ω, 0 ≤ restrictLaw π E ω) ∧
      (∑ ω : Fin N_ω, restrictLaw π E ω = 1) ∧
      (∀ ω, 0 < restrictLaw π E ω ↔ ω ∈ E) ∧
      0 ≤ finCondEntropy ε (restrictLaw π E) X Y ∧
      finCondEntropy ε (restrictLaw π E) X Y ≤
        (∑ ω ∈ E, π ω)⁻¹ * finCondEntropy ε π X Y) ∧
    (∀ {N_ω M_obs : ℕ} {α β : Type} [DecidableEq α] [DecidableEq β]
      (ε a : ℝ) (π : Fin N_ω → ℝ) (T_idx : Fin N_ω → α)
      (obs : Fin M_obs → Fin N_ω → β) (A_cap : Fin M_obs → ℝ),
      letI := Classical.propDecidable
      0 < ε → ε < 1 / 2 → 0 < a →
      (∀ ω, 0 ≤ π ω) → (∑ ω : Fin N_ω, π ω = 1) →
      (∀ i : Fin M_obs, 0 ≤ A_cap i ∧
        (((Finset.univ.filter (fun ω => 0 < π ω)).image (obs i)).card : ℝ) ≤
          ε ^ (-(A_cap i))) →
      let J_max : ℕ := ∏ i : Fin M_obs, (1 + ⌈(A_cap i + 1) / a⌉₊) ^ 2
      let ell := Real.log (ε⁻¹)
      ∃ (Z : Fin N_ω → Fin (J_max + 1))
        (Z_ret : Finset (Fin J_max))
        (d_uncond d_condT : Fin J_max → Fin M_obs → ℝ),
        1 ≤ J_max ∧
        (∀ z i, d_uncond z i ∈ Set.Icc (0 : ℝ) (A_cap i + 1) ∧
          d_condT z i ∈ Set.Icc (0 : ℝ) (A_cap i + 1)) ∧
        1 - 2 * (M_obs : ℝ) * ε - 1 / 4 ≤
          (∑ z ∈ Z_ret, ∑ ω : Fin N_ω, if Z ω = z.castSucc then π ω else 0) ∧
        ∀ z ∈ Z_ret,
          let E_z := Finset.univ.filter (fun ω => Z ω = z.castSucc ∧ 0 < π ω)
          let m_z := ∑ ω ∈ E_z, π ω
          let π_z := restrictLaw π E_z
          (4 * (J_max : ℝ))⁻¹ ≤ m_z ∧
          (∀ i : Fin M_obs,
            (d_uncond z i - Real.log (4 * (J_max : ℝ)) / ell ≤
              finCondEntropy ε π_z (fun _ => ()) (obs i) ∧
             finCondEntropy ε π_z (fun _ => ()) (obs i) ≤ d_uncond z i + a) ∧
            (d_condT z i - Real.log (4 * (J_max : ℝ)) / ell ≤
              finCondEntropy ε π_z T_idx (obs i) ∧
             finCondEntropy ε π_z T_idx (obs i) ≤ d_condT z i + a)) ∧
          (∀ (i : Fin M_obs) (η : ℝ), 0 < η → η < 1 →
            ∃ B_u B_c : Finset (Fin N_ω),
              (∑ ω ∈ B_u, π_z ω) ≤ 2 * η ∧
              (∑ ω ∈ B_c, π_z ω) ≤ 2 * η ∧
              ∀ ω : Fin N_ω, 0 < π_z ω →
                (ω ∉ B_u →
                  d_uncond z i - Real.log (4 * (J_max : ℝ) / η) / ell ≤
                    condSurprise ε π_z (fun _ => ()) (obs i) ω ∧
                  condSurprise ε π_z (fun _ => ()) (obs i) ω ≤
                    d_uncond z i + a + Real.log (1 / η) / ell) ∧
                (ω ∉ B_c →
                  d_condT z i - Real.log (4 * (J_max : ℝ) / η) / ell ≤
                    condSurprise ε π_z T_idx (obs i) ω ∧
                  condSurprise ε π_z T_idx (obs i) ω ≤
                    d_condT z i + a + Real.log (1 / η) / ell))) :=
by
  have h_ell_pos : ∀ {ε : ℝ}, 0 < ε → ε < 1 / 2 → 0 < Real.log (ε⁻¹) := by
    intro ε hε₀ hε₁
    apply Real.log_pos
    rw [one_lt_inv₀ hε₀]
    linarith
  have h_log_rpow : ∀ {ε : ℝ}, 0 < ε → ∀ r : ℝ,
      Real.log (ε ^ r) = -r * Real.log (ε⁻¹) := by
    intro ε hε₀ r
    rw [Real.log_rpow hε₀ r, Real.log_inv]
    ring
  have h_div_mul_le : ∀ A B : ℝ, 0 ≤ A → (A / B) * B ≤ A := by
    intro A B hA
    by_cases hB : B = 0
    · simp [hB, hA]
    · rw [div_mul_cancel₀ A hB]
  have h_sum_ite : ∀ {γ : Type} (s : Finset γ) (a : γ) (f : γ → ℝ)
      (dec_eq : ∀ x : γ, Decidable (a = x)) (dec_mem : Decidable (a ∈ s)),
      (∑ x ∈ s, @ite ℝ (a = x) (dec_eq x) (f x) 0) =
        @ite ℝ (a ∈ s) dec_mem (f a) 0 := by
    intro γ s a f dec_eq dec_mem
    let decγ : DecidableEq γ := Classical.typeDecidableEq γ
    have h1 : (∑ x ∈ s, @ite ℝ (a = x) (dec_eq x) (f x) 0) =
        ∑ x ∈ s, @ite ℝ (a = x) (decγ a x) (f x) 0 := by
      refine Finset.sum_congr rfl (fun x _ => ?_)
      by_cases h : a = x <;> simp [h]
    rw [h1, @Finset.sum_ite_eq γ ℝ _ decγ s a f]
    by_cases hs : a ∈ s <;> simp [hs]
  let wX : ∀ {N_ω : ℕ} {γ : Type},
      (Fin N_ω → ℝ) → Finset (Fin N_ω) → (Fin N_ω → γ) → γ → ℝ :=
    fun w S X x =>
      ∑ ω ∈ S, @ite ℝ (X ω = x) (Classical.propDecidable _) (w ω) 0
  let wXY : ∀ {N_ω : ℕ} {γ δ : Type},
      (Fin N_ω → ℝ) → Finset (Fin N_ω) → (Fin N_ω → γ) → (Fin N_ω → δ) → γ → δ → ℝ :=
    fun w S X Y x y =>
      ∑ ω ∈ S, @ite ℝ (X ω = x ∧ Y ω = y) (Classical.propDecidable _) (w ω) 0
  let posSupp : ∀ {N_ω : ℕ}, (Fin N_ω → ℝ) → Finset (Fin N_ω) :=
    fun {N_ω} w => @Finset.filter (Fin N_ω) (fun ω => 0 < w ω)
      (fun _ => Classical.propDecidable _) Finset.univ
  have h_mem_posSupp : ∀ {N_ω : ℕ} (w : Fin N_ω → ℝ) (ω : Fin N_ω),
      ω ∈ posSupp w ↔ 0 < w ω := fun {N_ω} w ω =>
    ⟨fun h => ((@Finset.mem_filter (Fin N_ω) (fun ω' => 0 < w ω')
        (fun _ => Classical.propDecidable _) Finset.univ ω).mp h).2,
     fun h => (@Finset.mem_filter (Fin N_ω) (fun ω' => 0 < w ω')
        (fun _ => Classical.propDecidable _) Finset.univ ω).mpr ⟨Finset.mem_univ ω, h⟩⟩
  have h_w_prob : ∀ {N_ω : ℕ} {γ δ : Type} (w : Fin N_ω → ℝ) (S : Finset (Fin N_ω))
      (X : Fin N_ω → γ) (Y : Fin N_ω → δ),
      (∀ ω, 0 ≤ w ω) → (∀ ω, ω ∉ S → w ω = 0) →
      (∀ ω, finProbAt w X ω = wX w S X (X ω)) ∧
      (∀ ω, finProbAt2 w X Y ω = wXY w S X Y (X ω) (Y ω)) ∧
      (∀ x, 0 ≤ wX w S X x) ∧
      (∀ x y, 0 ≤ wXY w S X Y x y) ∧
      (∀ ω ∈ S, w ω ≤ wXY w S X Y (X ω) (Y ω) ∧
        wXY w S X Y (X ω) (Y ω) ≤ wX w S X (X ω)) := by
    intro N_ω γ δ w S X Y hw_nn hw_zero
    refine ⟨?_, ?_, ?_, ?_, ?_⟩
    · intro ω
      dsimp only [finProbAt, wX]
      exact (Finset.sum_subset (Finset.subset_univ S) (fun ω' _ hω' => by
        simp only [hw_zero ω' hω', ite_self])).symm
    · intro ω
      dsimp only [finProbAt2, wXY]
      exact (Finset.sum_subset (Finset.subset_univ S) (fun ω' _ hω' => by
        simp only [hw_zero ω' hω', ite_self])).symm
    · intro x
      dsimp only [wX]
      exact Finset.sum_nonneg (fun ω _ => by split_ifs <;> [exact hw_nn ω; exact le_rfl])
    · intro x y
      dsimp only [wXY]
      exact Finset.sum_nonneg (fun ω _ => by split_ifs <;> [exact hw_nn ω; exact le_rfl])
    · intro ω hω
      dsimp only [wX, wXY]
      refine ⟨?_, ?_⟩
      · have h_le := Finset.single_le_sum
          (f := fun ω' => @ite ℝ (X ω' = X ω ∧ Y ω' = Y ω) (Classical.propDecidable _) (w ω') 0)
          (fun ω' _ => by split_ifs <;> [exact hw_nn ω'; exact le_rfl]) hω
        simpa using h_le
      · refine Finset.sum_le_sum (fun ω' _ => ?_)
        by_cases hX : X ω' = X ω
        · by_cases hY : Y ω' = Y ω <;> simp [hX, hY, hw_nn ω']
        · simp [hX]
  have h_surp_nn : ∀ {N_ω : ℕ} {γ δ : Type} (ε : ℝ) (w : Fin N_ω → ℝ)
      (X : Fin N_ω → γ) (Y : Fin N_ω → δ),
      0 < ε → ε < 1 / 2 → (∀ ω, 0 ≤ w ω) →
      ∀ ω, 0 < w ω → 0 ≤ condSurprise ε w X Y ω := by
    intro N_ω γ δ ε w X Y hε₀ hε₁ hw_nn ω hw_pos
    let S := posSupp w
    have hw_zero : ∀ ω', ω' ∉ S → w ω' = 0 := by
      intro ω' hω'
      have h_not : ¬ 0 < w ω' := fun h => hω' ((h_mem_posSupp w ω').mpr h)
      exact le_antisymm (not_lt.mp h_not) (hw_nn ω')
    have hωS : ω ∈ S := (h_mem_posSupp w ω).mpr hw_pos
    obtain ⟨hp1, hp2, _, _, h_le⟩ := h_w_prob w S X Y hw_nn hw_zero
    obtain ⟨hle1, hle2⟩ := h_le ω hωS
    have hqXY_pos : 0 < wXY w S X Y (X ω) (Y ω) := lt_of_lt_of_le hw_pos hle1
    have hqX_pos : 0 < wX w S X (X ω) := lt_of_lt_of_le hqXY_pos hle2
    unfold condSurprise
    rw [hp1 ω, hp2 ω]
    have hr_nn : 0 ≤ wXY w S X Y (X ω) (Y ω) / wX w S X (X ω) :=
      div_nonneg hqXY_pos.le hqX_pos.le
    have hr_le1 : wXY w S X Y (X ω) (Y ω) / wX w S X (X ω) ≤ 1 :=
      (div_le_one hqX_pos).mpr hle2
    have hlog_np : Real.log (wXY w S X Y (X ω) (Y ω) / wX w S X (X ω)) ≤ 0 :=
      Real.log_nonpos hr_nn hr_le1
    exact div_nonneg (neg_nonneg.mpr hlog_np) (h_ell_pos hε₀ hε₁).le
  have h_group1 : ∀ {N_ω : ℕ} {γ : Type} (w : Fin N_ω → ℝ) (S : Finset (Fin N_ω))
      (X : Fin N_ω → γ) (SX : Finset γ) (f : γ → ℝ),
      (∀ ω ∈ S, X ω ∈ SX) →
      ∑ x ∈ SX, wX w S X x * f x = ∑ ω ∈ S, w ω * f (X ω) := by
    intro N_ω γ w S X SX f hSX
    dsimp only [wX]
    calc ∑ x ∈ SX, (∑ ω ∈ S, @ite ℝ (X ω = x) (Classical.propDecidable _) (w ω) 0) * f x
        = ∑ x ∈ SX, ∑ ω ∈ S,
            @ite ℝ (X ω = x) (Classical.propDecidable _) (w ω * f x) 0 := by
            refine Finset.sum_congr rfl (fun x _ => ?_)
            rw [Finset.sum_mul]
            refine Finset.sum_congr rfl (fun ω _ => ?_)
            split_ifs <;> ring
      _ = ∑ ω ∈ S, ∑ x ∈ SX,
            @ite ℝ (X ω = x) (Classical.propDecidable _) (w ω * f x) 0 := Finset.sum_comm
      _ = ∑ ω ∈ S, w ω * f (X ω) := by
            refine Finset.sum_congr rfl (fun ω hω => ?_)
            rw [h_sum_ite SX (X ω) (fun x => w ω * f x)
              (fun _ => Classical.propDecidable _) (Classical.propDecidable _),
              if_pos (hSX ω hω)]
  have h_inner_Y : ∀ {N_ω : ℕ} {γ δ : Type} (w : Fin N_ω → ℝ) (S : Finset (Fin N_ω))
      (X : Fin N_ω → γ) (Y : Fin N_ω → δ) (TY : Finset δ) (x : γ) (g : γ → δ → ℝ),
      (∀ ω ∈ S, X ω = x → Y ω ∈ TY) →
      ∑ y ∈ TY, wXY w S X Y x y * g x y =
        ∑ ω ∈ S, @ite ℝ (X ω = x) (Classical.propDecidable _) (w ω * g x (Y ω)) 0 := by
    intro N_ω γ δ w S X Y TY x g hTY
    dsimp only [wXY]
    calc ∑ y ∈ TY, (∑ ω ∈ S,
            @ite ℝ (X ω = x ∧ Y ω = y) (Classical.propDecidable _) (w ω) 0) * g x y
        = ∑ y ∈ TY, ∑ ω ∈ S,
            @ite ℝ (X ω = x) (Classical.propDecidable _)
              (@ite ℝ (Y ω = y) (Classical.propDecidable _) (w ω * g x y) 0) 0 := by
            refine Finset.sum_congr rfl (fun y _ => ?_)
            rw [Finset.sum_mul]
            refine Finset.sum_congr rfl (fun ω _ => ?_)
            by_cases hX : X ω = x
            · by_cases hY : Y ω = y <;> simp [hX, hY]
            · simp [hX]
      _ = ∑ ω ∈ S, ∑ y ∈ TY,
            @ite ℝ (X ω = x) (Classical.propDecidable _)
              (@ite ℝ (Y ω = y) (Classical.propDecidable _) (w ω * g x y) 0) 0 :=
            Finset.sum_comm
      _ = ∑ ω ∈ S, @ite ℝ (X ω = x) (Classical.propDecidable _) (w ω * g x (Y ω)) 0 := by
            refine Finset.sum_congr rfl (fun ω hω => ?_)
            by_cases hX : X ω = x
            · simp only [if_pos hX]
              rw [h_sum_ite TY (Y ω) (fun y => w ω * g x y)
                (fun _ => Classical.propDecidable _) (Classical.propDecidable _),
                if_pos (hTY ω hω hX)]
            · simp [hX]
  have h_marg_Y : ∀ {N_ω : ℕ} {γ δ : Type} (w : Fin N_ω → ℝ) (S : Finset (Fin N_ω))
      (X : Fin N_ω → γ) (Y : Fin N_ω → δ) (TY : Finset δ) (x : γ),
      (∀ ω ∈ S, Y ω ∈ TY) →
      ∑ y ∈ TY, wXY w S X Y x y = wX w S X x := by
    intro N_ω γ δ w S X Y TY x hTY
    have h1 := h_inner_Y w S X Y TY x (fun _ _ => 1) (fun ω hω _ => hTY ω hω)
    simpa [wX] using h1
  have h_group2 : ∀ {N_ω : ℕ} {γ δ : Type} (w : Fin N_ω → ℝ) (S : Finset (Fin N_ω))
      (X : Fin N_ω → γ) (Y : Fin N_ω → δ) (SX : Finset γ) (SY : γ → Finset δ)
      (g : γ → δ → ℝ),
      (∀ ω ∈ S, X ω ∈ SX ∧ Y ω ∈ SY (X ω)) →
      ∑ x ∈ SX, ∑ y ∈ SY x, wXY w S X Y x y * g x y =
        ∑ ω ∈ S, w ω * g (X ω) (Y ω) := by
    intro N_ω γ δ w S X Y SX SY g hSXY
    calc ∑ x ∈ SX, ∑ y ∈ SY x, wXY w S X Y x y * g x y
        = ∑ x ∈ SX, ∑ ω ∈ S,
            @ite ℝ (X ω = x) (Classical.propDecidable _) (w ω * g x (Y ω)) 0 := by
            refine Finset.sum_congr rfl (fun x _ => ?_)
            exact h_inner_Y w S X Y (SY x) x g (fun ω hω hXx => hXx ▸ (hSXY ω hω).2)
      _ = ∑ ω ∈ S, ∑ x ∈ SX,
            @ite ℝ (X ω = x) (Classical.propDecidable _) (w ω * g x (Y ω)) 0 :=
            Finset.sum_comm
      _ = ∑ ω ∈ S, w ω * g (X ω) (Y ω) := by
            refine Finset.sum_congr rfl (fun ω hω => ?_)
            rw [h_sum_ite SX (X ω) (fun x => w ω * g x (Y ω))
              (fun _ => Classical.propDecidable _) (Classical.propDecidable _),
              if_pos (hSXY ω hω).1]
  have h_restrict_props : ∀ {N_ω : ℕ} (π : Fin N_ω → ℝ) (E : Finset (Fin N_ω)),
      (∀ ω, 0 ≤ π ω) → (∀ ω ∈ E, 0 < π ω) → 0 < (∑ ω ∈ E, π ω) →
      (∀ ω, 0 ≤ restrictLaw π E ω) ∧
      (∑ ω ∈ E, restrictLaw π E ω = 1) ∧
      (∑ ω : Fin N_ω, restrictLaw π E ω = 1) ∧
      (∀ ω, ω ∉ E → restrictLaw π E ω = 0) ∧
      (∀ ω, 0 < restrictLaw π E ω ↔ ω ∈ E) := by
    intro N_ω π E hπ_nn hE_pos hmE_pos
    have h_nn : ∀ ω, 0 ≤ restrictLaw π E ω := by
      intro ω
      unfold restrictLaw
      split_ifs
      · exact div_nonneg (hπ_nn ω) hmE_pos.le
      · exact le_rfl
    have h_zero : ∀ ω, ω ∉ E → restrictLaw π E ω = 0 := by
      intro ω hω
      simp [restrictLaw, hω]
    have h_sumE : ∑ ω ∈ E, restrictLaw π E ω = 1 := by
      calc ∑ ω ∈ E, restrictLaw π E ω
          = ∑ ω ∈ E, π ω / (∑ ω' ∈ E, π ω') :=
