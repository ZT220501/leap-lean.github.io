        exact le_trans h_raw h_ent_small.le
      have hP_eq : P_sep = ∑ ω : Fin N_ω,
          @ite ℝ (1 < cyclicBinDist (2 ^ dyadicTimeLevel ε d) (angBin ε d (θ₁ ω)) (angBin ε d (θ₂ ω)))
            (Classical.propDecidable _) (π ω) 0 := by
        refine Finset.sum_congr rfl (fun ω _ => ?_)
        dsimp only [M_d]
        by_cases hc : 1 < cyclicBinDist (2 ^ dyadicTimeLevel ε d) (angBin ε d (θ₁ ω)) (angBin ε d (θ₂ ω))
        · rw [if_pos hc, if_pos hc]
        · rw [if_neg hc, if_neg hc]
      have hGc_ineq' : 2 * γ * (a - b - d - 2 * ξ) * P_sep - ξ ≤
          stdApertureDeficit ε γ (1 + m) u b a π T_idx V_part A_part c_s θ₁ +
          stdApertureDeficit ε γ (1 + m) u b a π T_idx V_part A_part c_s θ₂ +
          4 * δ_cl * u +
          (finMutualInfo ε π T_idx (fun ω => (D₁ ω, D₂ ω)) +
            finMutualInfo ε π T_idx G_c -
            finMutualInfo ε π T_idx D₁ -
            finMutualInfo ε π T_idx D₂) := by
        rw [hP_eq]
        exact hGc_ineq
      exact ⟨G_c, hGc_t, trivial, hGc_ineq', h_cond1, h_cond2⟩
    obtain ⟨_, _, h_submod, _⟩ :=
      fin_entropy_submod_and_support_bounds ε hε₀ hε_lt_half π h_law.1 h_law.2.1
    have h_det_C : ∀ ω₁ ω₂ : Fin N_ω, 0 < π ω₁ → 0 < π ω₂ →
        (D₁ ω₁ = D₁ ω₂ → C_u ω₁ = C_u ω₂) ∧
        (D₂ ω₁ = D₂ ω₂ → C_u ω₁ = C_u ω₂) ∧
        (G_c ω₁ = G_c ω₂ → C_u ω₁ = C_u ω₂) := by
      intro ω₁ ω₂ _ _
      refine ⟨fun h1 => congr_arg Prod.fst h1, fun h2 => congr_arg Prod.fst h2, fun h3 => ?_⟩
      dsimp only [C_u]
      rw [← hGc_t ω₁, ← hGc_t ω₂, h3]
    have h_mi_le : finMutualInfo ε π T_idx (fun ω => (D₁ ω, D₂ ω)) + finMutualInfo ε π T_idx G_c -
        finMutualInfo ε π T_idx D₁ - finMutualInfo ε π T_idx D₂ ≤
        finCondEntropy ε π D₁ G_c + finCondEntropy ε π D₂ G_c :=
      h_submod T_idx C_u D₁ D₂ G_c h_det_C h_subindep
    have hP_nn : 0 ≤ P_sep :=
      Finset.sum_nonneg (fun ω _ => by
        split_ifs
        · exact h_law.1 ω
        · exact le_rfl)
    have hP_le1 : P_sep ≤ 1 := by
      calc P_sep
          ≤ ∑ ω : Fin N_ω, π ω := Finset.sum_le_sum (fun ω _ => by
            split_ifs
            · exact le_rfl
            · exact h_law.1 ω)
        _ = 1 := h_law.2.1
    have h_4g : 4 * γ * ξ * P_sep ≤ 4 * ξ := by
      have h1 : γ * P_sep ≤ 1 * 1 :=
        mul_le_mul hγ₁.le hP_le1 hP_nn zero_le_one
      nlinarith
    have h_4d : 4 * δ_cl * u ≤ η_err / 4 := by
      dsimp only [δ_cl]
      nlinarith
    have h_alg : 2 * γ * (a - b - d - 2 * ξ) * P_sep =
        2 * γ * (a - b - d) * P_sep - 4 * γ * ξ * P_sep := by ring
    rw [h_alg] at hGc_ineq
    linarith [hGc_ineq, h_mi_le, h_cond1, h_cond2, h_4g, h_4d, hξ_le_err]
  refine ⟨?_, ?_⟩
  · intro u η_loss hu₀ hu₁ hη_loss
    let ν : ℝ := min (η_loss / 12) (1 / 4)
    have hν_pos : 0 < ν := lt_min (by positivity) (by norm_num)
    have hν_le : ν ≤ η_loss / 12 := min_le_left _ _
    let ζ_max : ℝ := η_loss / (4 * (25 + 5 * m))
    have h_25m_pos : 0 < 25 + 5 * m := by linarith
    have hζ_pos : 0 < ζ_max := div_pos hη_loss (by positivity)
    let η_rep : ℝ := γ * ν * ζ_max
    have hη_rep_pos : 0 < η_rep := mul_pos (mul_pos hγ₀ hν_pos) hζ_pos
    let δ_in : ℝ := min (η_loss / 4) (η_rep / 2)
    have hδ_in_pos : 0 < δ_in := lt_min (by positivity) (by positivity)
    have hδ_le_loss : δ_in ≤ η_loss / 4 := min_le_left _ _
    have hδ_le_rep : δ_in ≤ η_rep / 2 := min_le_right _ _
    obtain ⟨ε_sep, hε_sep_pos, hε_sep_lt, h_sep_master⟩ :=
      h_master_sep u ν η_rep hu₀ hu₁ hν_pos hη_rep_pos
    let K_log : ℝ := max (Real.log 100000 + 1)
      (4 * (Real.log 2 + Real.log 10000000) / η_loss + 1)
    have hK_log_gt1 : 1 < K_log := by
      have h1 : 0 < Real.log 100000 := Real.log_pos (by norm_num)
      exact lt_of_lt_of_le (by linarith) (le_max_left _ _)
