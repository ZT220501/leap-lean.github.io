      rw [Finset.sum_comm]
      calc ∑ α ∈ T_P, ∑ o ∈ S_obs, m_set o {α}
          ≤ ∑ α ∈ T_P, (C_sub_bes * ∑ β ∈ ({α} : Finset (Fin N_ret)), ‖sub.c_at β‖ ^ 2) :=
            Finset.sum_le_sum (fun α _ => h_bessel {α})
        _ = C_sub_bes * ∑ α ∈ T_P, ‖sub.c_at α‖ ^ 2 := by
            rw [← Finset.mul_sum]
            congr 1
            exact Finset.sum_congr rfl (fun α _ => Finset.sum_singleton _ _)
        _ ≤ C_sub_bes * (w_max * (T_P.card : ℝ)) :=
