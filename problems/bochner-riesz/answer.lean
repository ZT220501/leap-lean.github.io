          rw [abs_mul, abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 1 / 2)] at htri
          linarith only [htri, hVu, hAu]
        exact ⟨by dsimp only [V_part] at hVb; linarith only [hVb, hrb],
          by dsimp only [V_part] at hVa; linarith only [hVa, hra],
          h_shear e_F r_b hVb hAb,
          h_shear (perp2D e_F) r_a hVa hAa⟩

  
  
  
  have h_s3 : ∀ (ε : ℝ) {N_Z N_D N_T N_R : ℕ}
      (q : Fin N_Z → Fin N_D → Fin N_T → ℝ)
      (p_D : Fin N_D → ℝ)
      (r_Z : Fin N_Z → Fin N_R)
      (b_G a_G : Fin N_D → ℝ),
      (∀ z d α, 0 ≤ q z d α) →
      (∑ z : Fin N_Z, ∑ d : Fin N_D, ∑ α : Fin N_T, q z d α = 1) →
      (∀ d : Fin N_D, ∑ z : Fin N_Z, ∑ α : Fin N_T, q z d α = p_D d) →
      let ell := Real.log (ε⁻¹)
      let q_T := fun α : Fin N_T => ∑ z : Fin N_Z, ∑ d : Fin N_D, q z d α
      let q_TD := fun (α : Fin N_T) (d : Fin N_D) => ∑ z : Fin N_Z, q z d α
      let q_TR :=
        letI := Classical.propDecidable
        fun (α : Fin N_T) (rv : Fin N_R) =>
          ∑ z ∈ Finset.univ.filter (fun z => r_Z z = rv), ∑ d : Fin N_D, q z d α
      let N_ω := N_Z * (N_D * N_T)
      let π : Fin N_ω → ℝ := fun ω =>
        let p1 := finProdFinEquiv.symm ω
        let p2 := finProdFinEquiv.symm p1.2
        q p1.1 p2.1 p2.2
      let T_idx : Fin N_ω → Fin N_T := fun ω =>
        (finProdFinEquiv.symm (finProdFinEquiv.symm ω).2).2
      let G_idx : Fin N_ω → Fin N_D := fun ω =>
        (finProdFinEquiv.symm (finProdFinEquiv.symm ω).2).1
      let k_time : Fin N_ω → ℤ := fun ω =>
        ((r_Z (finProdFinEquiv.symm ω).1).1 : ℤ)
      (∀ ω : Fin N_ω, 0 ≤ π ω) ∧
      (∑ ω : Fin N_ω, π ω = 1) ∧
      (∀ α : Fin N_T, (∑ ω : Fin N_ω, if T_idx ω = α then π ω else 0) = q_T α) ∧
      (∀ ω : Fin N_ω, 0 < π ω →
        ∃ (z : Fin N_Z) (d : Fin N_D) (α : Fin N_T),
          0 < q z d α ∧ T_idx ω = α ∧ G_idx ω = d ∧ k_time ω = ((r_Z z).1 : ℤ)) ∧
      ((∑ α : Fin N_T, -(q_T α * Real.log (q_T α))) / ell +
       (1 / 2 : ℝ) * ((∑ α : Fin N_T, ∑ d : Fin N_D,
         -(q_TD α d * Real.log (q_TD α d / p_D d))) / ell) +
       (∑ α : Fin N_T, ∑ rv : Fin N_R,
         -(q_TR α rv * Real.log (q_TR α rv / q_T α))) / ell +
       (1 / 2 : ℝ) * (∑ d : Fin N_D, p_D d * ((1 + γ) * b_G d + (1 - γ) * a_G d)) =
       (3 / 2 : ℝ) * ((∑ α : Fin N_T, -(q_T α * Real.log (q_T α))) / ell) +
       (1 / 2 : ℝ) * classicalTransportScore ε γ N_ω N_T N_D π T_idx k_time G_idx b_G a_G) := by
    intro ε N_Z N_D N_T N_R q p_D r_Z b_G a_G hq_nn hq_sum hp_D
      ell q_T q_TD q_TR N_ω π T_idx G_idx k_time
    let e_ω : (Fin N_Z × (Fin N_D × Fin N_T)) ≃ Fin N_ω :=
      (Equiv.prodCongr (Equiv.refl (Fin N_Z)) finProdFinEquiv).trans finProdFinEquiv
    have h_reidx : ∀ F : Fin N_ω → ℝ,
        (∑ ω : Fin N_ω, F ω) =
          ∑ z : Fin N_Z, ∑ d : Fin N_D, ∑ α : Fin N_T, F (e_ω (z, (d, α))) := by
      intro F
      rw [← Equiv.sum_comp e_ω F, Fintype.sum_prod_type]
      exact Finset.sum_congr rfl (fun z _ => Fintype.sum_prod_type _)
    have hπ_app : ∀ z d α, π (e_ω (z, (d, α))) = q z d α := by
      intro z d α
      simp only [π, e_ω, Equiv.trans_apply, Equiv.prodCongr_apply, Prod.map_apply,
        Equiv.refl_apply, Equiv.symm_apply_apply]
    have hT_app : ∀ z d α, T_idx (e_ω (z, (d, α))) = α := by
      intro z d α
      simp only [T_idx, e_ω, Equiv.trans_apply, Equiv.prodCongr_apply, Prod.map_apply,
        Equiv.refl_apply, Equiv.symm_apply_apply]
    have hG_app : ∀ z d α, G_idx (e_ω (z, (d, α))) = d := by
      intro z d α
      simp only [G_idx, e_ω, Equiv.trans_apply, Equiv.prodCongr_apply, Prod.map_apply,
        Equiv.refl_apply, Equiv.symm_apply_apply]
    have hk_app : ∀ z d α, k_time (e_ω (z, (d, α))) = ((r_Z z).1 : ℤ) := by
      intro z d α
      simp only [k_time, e_ω, Equiv.trans_apply, Equiv.prodCongr_apply, Prod.map_apply,
        Equiv.refl_apply, Equiv.symm_apply_apply]
    have hπ_nn : ∀ ω : Fin N_ω, 0 ≤ π ω := fun _ => hq_nn _ _ _
    have hπ_sum : ∑ ω : Fin N_ω, π ω = 1 := by
      rw [h_reidx]; simp_rw [hπ_app]; exact hq_sum
    have hp_T_eq : ∀ α : Fin N_T, (∑ ω : Fin N_ω, if T_idx ω = α then π ω else 0) = q_T α := by
      intro α; rw [h_reidx]; simp_rw [hT_app, hπ_app]; simp [q_T]
    have hp_G_eq : ∀ d : Fin N_D, (∑ ω : Fin N_ω, if G_idx ω = d then π ω else 0) = p_D d := by
      intro d
      rw [h_reidx]; simp_rw [hG_app, hπ_app, ← hp_D d]
      refine Finset.sum_congr rfl (fun z _ => ?_)
      have h_in : ∀ d' : Fin N_D,
          (∑ α : Fin N_T, if d' = d then q z d' α else 0) =
          if d' = d then ∑ α : Fin N_T, q z d' α else 0 := by
        intro d'; split_ifs <;> simp
      simp_rw [h_in]; simp
    have h_supp_ω : ∀ ω : Fin N_ω, 0 < π ω →
        ∃ (z : Fin N_Z) (d : Fin N_D) (α : Fin N_T),
          0 < q z d α ∧ T_idx ω = α ∧ G_idx ω = d ∧ k_time ω = ((r_Z z).1 : ℤ) := by
      intro ω hω
      let p1 := finProdFinEquiv.symm ω
      let p2 := finProdFinEquiv.symm p1.2
      exact ⟨p1.1, p2.1, p2.2, hω, rfl, rfl, rfl⟩
    refine ⟨hπ_nn, hπ_sum, hp_T_eq, h_supp_ω, ?_⟩
    unfold classicalTransportScore
    dsimp only
    have hpTG_std : ∀ (α : Fin N_T) (d : Fin N_D),
        (∑ ω : Fin N_ω, if T_idx ω = α ∧ G_idx ω = d then π ω else 0) = q_TD α d := by
      intro α d
      rw [h_reidx]; simp_rw [hT_app, hG_app, hπ_app]; dsimp only [q_TD]
      refine Finset.sum_congr rfl (fun z _ => ?_)
      have h1 : (∑ d' : Fin N_D, ∑ α' : Fin N_T, if α' = α ∧ d' = d then q z d' α' else 0) =
          ∑ d' : Fin N_D, if d' = d then (∑ α' : Fin N_T, if α' = α then q z d' α' else 0) else 0 := by
        refine Finset.sum_congr rfl (fun d' _ => ?_)
        by_cases hd : d' = d <;> simp [hd]
      rw [h1]
      simp only [Finset.sum_ite_eq', Finset.mem_univ, ↓reduceIte]
    let emb_R : Fin N_R → ℤ := fun rv => (rv.1 : ℤ)
    have hemb_inj : Set.InjOn emb_R ↑(Finset.univ : Finset (Fin N_R)) := by
      intro r1 _ r2 _ heq; exact Fin.ext (Int.ofNat.inj heq)
    have h_S_cells_sub : (Finset.univ.image k_time : Finset ℤ) ⊆ Finset.univ.image emb_R := by
      intro k hk
      rcases Finset.mem_image.mp hk with ⟨ω, _, rfl⟩
      exact Finset.mem_image.mpr ⟨r_Z (finProdFinEquiv.symm ω).1, Finset.mem_univ _, rfl⟩
    have h_St_match : ∀ α : Fin N_T,
        (∑ k ∈ Finset.univ.image k_time,
          -((∑ ω : Fin N_ω, if T_idx ω = α ∧ k_time ω = k then π ω else 0) *
            Real.log ((∑ ω : Fin N_ω, if T_idx ω = α ∧ k_time ω = k then π ω else 0) / q_T α))) =
        ∑ rv : Fin N_R, -(q_TR α rv * Real.log (q_TR α rv / q_T α)) := by
      intro α
      rw [Finset.sum_subset h_S_cells_sub]
      · rw [Finset.sum_image hemb_inj]
        refine Finset.sum_congr rfl (fun rv _ => ?_)
        have hpTC_rv : (∑ ω : Fin N_ω, if T_idx ω = α ∧ k_time ω = emb_R rv then π ω else 0) =
            q_TR α rv := by
          rw [h_reidx]; simp_rw [hT_app, hk_app, hπ_app]
          dsimp only [q_TR, emb_R]
          rw [Finset.sum_filter]
          refine Finset.sum_congr rfl (fun z _ => ?_)
          by_cases hrz : r_Z z = rv
          · simp [hrz]
          · simp only [hrz, ↓reduceIte]
            have hne : ((r_Z z).1 : ℤ) ≠ (rv.1 : ℤ) :=
              fun hc => hrz (Fin.ext (Int.ofNat.inj hc))
            refine Finset.sum_eq_zero (fun d _ => Finset.sum_eq_zero (fun α' _ => ?_))
            simp [hne]
        rw [hpTC_rv]
      · intro k _ hk_not
        have hpTC_zero : (∑ ω : Fin N_ω, if T_idx ω = α ∧ k_time ω = k then π ω else 0) = 0 := by
          refine Finset.sum_eq_zero (fun ω _ => ?_)
          have hne : k_time ω ≠ k :=
            fun heq => hk_not (Finset.mem_image.mpr ⟨ω, Finset.mem_univ ω, heq⟩)
          simp [hne]
        rw [hpTC_zero, zero_mul, neg_zero]
    have h_MI : -(∑ α : Fin N_T, ∑ d : Fin N_D,
          q_TD α d * Real.log (q_TD α d / (q_T α * p_D d))) =
        (∑ α : Fin N_T, ∑ d : Fin N_D, -(q_TD α d * Real.log (q_TD α d / p_D d))) -
        (∑ α : Fin N_T, -(q_T α * Real.log (q_T α))) := by
      have h_term : ∀ (α : Fin N_T) (d : Fin N_D),
          -(q_TD α d * Real.log (q_TD α d / (q_T α * p_D d))) =
          -(q_TD α d * Real.log (q_TD α d / p_D d)) + q_TD α d * Real.log (q_T α) := by
        intro α d
        have hqTD_nn : 0 ≤ q_TD α d := Finset.sum_nonneg (fun z _ => hq_nn z d α)
        by_cases h0 : q_TD α d = 0
        · simp [h0]
        · have hqTD_pos : 0 < q_TD α d := lt_of_le_of_ne hqTD_nn (Ne.symm h0)
          have hqT_ge : q_TD α d ≤ q_T α := by
            dsimp only [q_TD, q_T]
            exact Finset.sum_le_sum (fun z _ =>
              Finset.single_le_sum (fun d' _ => hq_nn z d' α) (Finset.mem_univ d))
          have hpD_ge : q_TD α d ≤ p_D d := by
            rw [← hp_D d]; dsimp only [q_TD]
            exact Finset.sum_le_sum (fun z _ =>
              Finset.single_le_sum (fun α' _ => hq_nn z d α') (Finset.mem_univ α))
          have hqT_pos : 0 < q_T α := lt_of_lt_of_le hqTD_pos hqT_ge
          have hpD_pos : 0 < p_D d := lt_of_lt_of_le hqTD_pos hpD_ge
          have h_div_eq : q_TD α d / (q_T α * p_D d) = (q_TD α d / p_D d) / q_T α := by
            rw [div_div, mul_comm (p_D d) (q_T α)]
          rw [h_div_eq, Real.log_div (div_pos hqTD_pos hpD_pos).ne' hqT_pos.ne']
          ring
      rw [← Finset.sum_neg_distrib]
      have h_sum1 : (∑ α : Fin N_T, -(∑ d : Fin N_D,
          q_TD α d * Real.log (q_TD α d / (q_T α * p_D d)))) =
        ∑ α : Fin N_T, ∑ d : Fin N_D,
          (-(q_TD α d * Real.log (q_TD α d / p_D d)) + q_TD α d * Real.log (q_T α)) := by
        refine Finset.sum_congr rfl (fun α _ => ?_)
        rw [← Finset.sum_neg_distrib]
        exact Finset.sum_congr rfl (fun d _ => h_term α d)
      rw [h_sum1]
      have h_sum2 : (∑ α : Fin N_T, ∑ d : Fin N_D,
          (-(q_TD α d * Real.log (q_TD α d / p_D d)) + q_TD α d * Real.log (q_T α))) =
        (∑ α : Fin N_T, ∑ d : Fin N_D, -(q_TD α d * Real.log (q_TD α d / p_D d))) +
        (∑ α : Fin N_T, (∑ d : Fin N_D, q_TD α d) * Real.log (q_T α)) := by
        rw [← Finset.sum_add_distrib]
        refine Finset.sum_congr rfl (fun α _ => ?_)
        rw [Finset.sum_add_distrib, ← Finset.sum_mul]
      have h_qTD_sum : ∀ α : Fin N_T, (∑ d : Fin N_D, q_TD α d) = q_T α :=
        fun _ => Finset.sum_comm
      rw [h_sum2]; simp_rw [h_qTD_sum]
      rw [sub_eq_add_neg, ← Finset.sum_neg_distrib]; simp only [neg_neg]
    simp_rw [hp_T_eq, hp_G_eq, hpTG_std, h_St_match]
    have h_neg_div : ∀ (x y : ℝ), -(x / y) = (-x) / y := fun x y => (neg_div y x).symm
    rw [sub_eq_add_neg (_ : ℝ) ((∑ tid : Fin N_T, ∑ g : Fin N_D, _) / ell), h_neg_div, h_MI, sub_div]
    dsimp only [ell]
    ring

  
  
  
  have h_s4 : ∀ (ε L_cl g_bin : ℝ)
      (hε₀ : 0 < ε) (hε₁ : ε < 1 / 2) (hL_cl : 0 ≤ L_cl)
      {N_ω N_T : ℕ} (hNT : 1 ≤ N_T)
      (π : Fin N_ω → ℝ) (T_idx : Fin N_ω → Fin N_T)
      (V_part A_part : Fin N_T → EuclideanSpace ℝ (Fin 2)),
      (∀ ω, 0 ≤ π ω) → (∑ ω : Fin N_ω, π ω = 1) →
      (∀ (b_F a_F : ℝ) (e_F V_F A_F : EuclideanSpace ℝ (Fin 2))
         (S_cap : Finset (Fin N_T)),
        0 ≤ b_F → b_F ≤ a_F → a_F ≤ L_cl → ‖e_F‖ = 1 →
        (∀ α ∈ S_cap,
          |inner ℝ (V_part α - V_F) e_F| ≤ 10 * ε ^ b_F ∧
          |inner ℝ (V_part α - V_F) (perp2D e_F)| ≤ 10 * ε ^ a_F ∧
          |inner ℝ (A_part α - A_F) e_F| ≤ 10 * ε ^ b_F ∧
          |inner ℝ (A_part α - A_F) (perp2D e_F)| ≤ 10 * ε ^ a_F) →
        (S_cap.card : ℝ) ≤ C_cov * 50625 * ε ^ (-g_bin + pktWeight γ b_F a_F - 2 * ξ)) →
      let ell := Real.log (ε⁻¹)
      let p_T := fun α : Fin N_T => ∑ ω : Fin N_ω, if T_idx ω = α then π ω else 0
      let H_T := (∑ α : Fin N_T, -(p_T α * Real.log (p_T α))) / ell
      H_T ≤ Real.log (N_T : ℝ) / ell ∧
      classicalRootSupremum ε L_cl γ N_ω N_T π T_idx V_part A_part ≤
        g_bin - H_T + 2 * ξ + Real.log (50625 * C_cov) / ell := by
    intro ε L_cl g_bin hε₀ hε₁ hL_cl N_ω N_T hNT π T_idx V_part A_part
      hπ_nn hπ_sum h_cap ell p_T H_T
    have hell_pos : 0 < ell := h_ell_pos hε₀ hε₁
    have hC_cov_pos : 0 < C_cov := by linarith only [hC_cov]
    have h_fib_ent := fun (P : Fin N_T → Fin 1 → ℝ) (B_fib : ℝ) =>
      (h_ent ε hε₀ hε₁).2.2 P (B_fib := B_fib)
    have hpT_nn : ∀ α : Fin N_T, 0 ≤ p_T α :=
      fun _ => Finset.sum_nonneg (fun ω _ => by split_ifs <;> linarith only [hπ_nn ω])
    have hpT_sum : ∑ α : Fin N_T, p_T α = 1 := by
      have h_fib : (∑ α : Fin N_T, p_T α) = ∑ ω : Fin N_ω, π ω := by
        dsimp only [p_T]; simp_rw [← Finset.sum_filter]
        exact Finset.sum_fiberwise Finset.univ T_idx π
      rw [h_fib, hπ_sum]
    have hHT_le : H_T ≤ Real.log (N_T : ℝ) / ell := by
      let P_unif : Fin N_T → Fin 1 → ℝ := fun α _ => p_T α
      have hNT_pos : (0 : ℝ) < (N_T : ℝ) := by
        exact_mod_cast (Nat.lt_of_lt_of_le Nat.zero_lt_one hNT)
      have hP_sum : ∑ x : Fin N_T, ∑ y : Fin 1, P_unif x y = 1 := by
        simp_rw [Fin.sum_univ_one]; exact hpT_sum
      have h_card : (letI := Classical.propDecidable
          ∀ y : Fin 1, (0 < ∑ x, P_unif x y) →
            ((Finset.univ.filter (fun x : Fin N_T => 0 < P_unif x y)).card : ℝ) ≤ (N_T : ℝ)) := by
        intro y _
        exact_mod_cast (Finset.card_filter_le _ _).trans_eq (Fintype.card_fin N_T)
      have h_est := h_fib_ent P_unif (N_T : ℝ) hNT_pos (fun x _ => hpT_nn x) hP_sum h_card
      dsimp only at h_est
      simp_rw [Fin.sum_univ_one] at h_est
      dsimp only [P_unif] at h_est
      simp_rw [hpT_sum, div_one] at h_est
      exact h_est
    refine ⟨hHT_le, ?_⟩
    unfold classicalRootSupremum
    dsimp only
    apply csSup_le
    · let u_vec : EuclideanSpace ℝ (Fin 2) := PiLp.single 2 (0 : Fin 2) (1 : ℝ)
      have hu_vec : ‖u_vec‖ = 1 := by simp [u_vec]
      let q₀ : Fin N_T → Fin N_T → ℝ := fun tid d => if d = tid then p_T tid else 0
      refine ⟨_, ⟨N_T, fun _ => 0, fun _ => 0, fun _ => u_vec, V_part, A_part, q₀,
        fun _ => ⟨le_rfl, le_rfl, hL_cl, hu_vec⟩,
        fun tid d => by dsimp only [q₀]; split_ifs <;> linarith only [hpT_nn tid],
        fun tid => by dsimp only [q₀, p_T]; simp, ?_, rfl⟩⟩
      intro tid d hq_pos
      dsimp only [q₀] at hq_pos
      have hd_eq : d = tid := by by_contra hne; simp [hne] at hq_pos
      subst hd_eq
      simp [sub_self]
    · rintro s ⟨N_F, b_F, a_F, e_F, V_F, A_F, q_F, hF_geom, hqF_nn, hqF_marg, hqF_cap, rfl⟩
      have hqF_marg' : ∀ tid : Fin N_T, ∑ d : Fin N_F, q_F tid d = p_T tid := hqF_marg
      let q_D : Fin N_F → ℝ := fun d => ∑ tid : Fin N_T, q_F tid d
      have hqD_nn : ∀ d : Fin N_F, 0 ≤ q_D d :=
        fun d => Finset.sum_nonneg (fun tid _ => hqF_nn tid d)
      have hqD_sum : ∑ d : Fin N_F, q_D d = 1 := by
        dsimp only [q_D]; rw [Finset.sum_comm]; simp_rw [hqF_marg']; exact hpT_sum
      have h_MI : -((∑ tid : Fin N_T, ∑ d : Fin N_F,
            q_F tid d * Real.log (q_F tid d / (p_T tid * q_D d))) / ell) =
          (∑ d : Fin N_F, (∑ tid : Fin N_T, -(q_F tid d * Real.log (q_F tid d / q_D d))) / ell) -
          H_T := by
        have h_term : ∀ (tid : Fin N_T) (d : Fin N_F),
            -(q_F tid d * Real.log (q_F tid d / (p_T tid * q_D d))) =
            -(q_F tid d * Real.log (q_F tid d / q_D d)) + q_F tid d * Real.log (p_T tid) := by
          intro tid d
          by_cases h0 : q_F tid d = 0
          · simp [h0]
          · have hqF_pos : 0 < q_F tid d := lt_of_le_of_ne (hqF_nn tid d) (Ne.symm h0)
            have hpT_ge : q_F tid d ≤ p_T tid := by
              rw [← hqF_marg' tid]
              exact Finset.single_le_sum (fun d' _ => hqF_nn tid d') (Finset.mem_univ d)
            have hqD_ge : q_F tid d ≤ q_D d :=
              Finset.single_le_sum (fun t' _ => hqF_nn t' d) (Finset.mem_univ tid)
            have hpT_pos : 0 < p_T tid := lt_of_lt_of_le hqF_pos hpT_ge
            have hqD_pos : 0 < q_D d := lt_of_lt_of_le hqF_pos hqD_ge
            have h_div : q_F tid d / (p_T tid * q_D d) = (q_F tid d / q_D d) / p_T tid := by
              rw [div_div, mul_comm (q_D d) (p_T tid)]
            rw [h_div, Real.log_div (div_pos hqF_pos hqD_pos).ne' hpT_pos.ne']
            ring
        have h_num : -(∑ tid : Fin N_T, ∑ d : Fin N_F,
              q_F tid d * Real.log (q_F tid d / (p_T tid * q_D d))) =
            (∑ d : Fin N_F, ∑ tid : Fin N_T, -(q_F tid d * Real.log (q_F tid d / q_D d))) -
            (∑ tid : Fin N_T, -(p_T tid * Real.log (p_T tid))) := by
          rw [← Finset.sum_neg_distrib]
          have h1 : (∑ tid : Fin N_T, -(∑ d : Fin N_F,
              q_F tid d * Real.log (q_F tid d / (p_T tid * q_D d)))) =
            ∑ tid : Fin N_T, ∑ d : Fin N_F,
              (-(q_F tid d * Real.log (q_F tid d / q_D d)) + q_F tid d * Real.log (p_T tid)) := by
            refine Finset.sum_congr rfl (fun tid _ => ?_)
            rw [← Finset.sum_neg_distrib]
            exact Finset.sum_congr rfl (fun d _ => h_term tid d)
          rw [h1]
          have h2 : (∑ tid : Fin N_T, ∑ d : Fin N_F,
              (-(q_F tid d * Real.log (q_F tid d / q_D d)) + q_F tid d * Real.log (p_T tid))) =
            (∑ tid : Fin N_T, ∑ d : Fin N_F, -(q_F tid d * Real.log (q_F tid d / q_D d))) +
            (∑ tid : Fin N_T, (∑ d : Fin N_F, q_F tid d) * Real.log (p_T tid)) := by
            rw [← Finset.sum_add_distrib]
            refine Finset.sum_congr rfl (fun tid _ => ?_)
            rw [Finset.sum_add_distrib, ← Finset.sum_mul]
          rw [h2, Finset.sum_comm]; simp_rw [hqF_marg']
          rw [sub_eq_add_neg, ← Finset.sum_neg_distrib]; simp only [neg_neg]
        rw [← neg_div, h_num, sub_div, Finset.sum_div]
      have h_fib_d : ∀ d : Fin N_F,
          (∑ tid : Fin N_T, -(q_F tid d * Real.log (q_F tid d / q_D d))) / ell ≤
          q_D d * (g_bin - pktWeight γ (b_F d) (a_F d) + 2 * ξ +
            Real.log (50625 * C_cov) / ell) := by
        intro d
        by_cases hqD0 : q_D d = 0
        · have hall0 : ∀ tid : Fin N_T, q_F tid d = 0 := fun tid =>
            le_antisymm
              (le_trans (Finset.single_le_sum (fun t' _ => hqF_nn t' d) (Finset.mem_univ tid)) hqD0.le)
              (hqF_nn tid d)
          simp [hqD0, hall0]
        · have hqD_pos : 0 < q_D d := lt_of_le_of_ne (hqD_nn d) (Ne.symm hqD0)
          let P_d : Fin N_T → Fin 1 → ℝ := fun tid _ => q_F tid d / q_D d
          let exp_d : ℝ := -g_bin + pktWeight γ (b_F d) (a_F d) - 2 * ξ
          let B_d : ℝ := C_cov * 50625 * ε ^ exp_d
          have hBd_pos : 0 < B_d :=
            mul_pos (mul_pos hC_cov_pos (by norm_num)) (Real.rpow_pos_of_pos hε₀ exp_d)
          have hPd_nn : ∀ x y, 0 ≤ P_d x y := fun x _ => div_nonneg (hqF_nn x d) hqD_pos.le
          have hPd_sum : ∑ x : Fin N_T, ∑ y : Fin 1, P_d x y = 1 := by
            simp_rw [Fin.sum_univ_one]; dsimp only [P_d]
            rw [← Finset.sum_div]; exact div_self hqD_pos.ne'
          have hPd_card : (letI := Classical.propDecidable
              ∀ y : Fin 1, (0 < ∑ x, P_d x y) →
                ((Finset.univ.filter (fun x : Fin N_T => 0 < P_d x y)).card : ℝ) ≤ B_d) := by
            intro y _
            obtain ⟨hb0, hba, haL, he1⟩ := hF_geom d
            refine h_cap (b_F d) (a_F d) (e_F d) (V_F d) (A_F d) _ hb0 hba haL he1 ?_
            intro α hα
            have hP_pos : 0 < P_d α y := (Finset.mem_filter.mp hα).2
            have hq_pos : 0 < q_F α d := (div_pos_iff_of_pos_right hqD_pos).mp hP_pos
            exact hqF_cap α d hq_pos
          have h_ent_d := h_fib_ent P_d B_d hBd_pos hPd_nn hPd_sum hPd_card
          dsimp only at h_ent_d
          simp_rw [Fin.sum_univ_one] at h_ent_d
          have h_sum1 : ∑ x' : Fin N_T, P_d x' 0 = 1 := by
            dsimp only [P_d]; rw [← Finset.sum_div]; exact div_self hqD_pos.ne'
          simp_rw [h_sum1, div_one] at h_ent_d
          have h_lhs_scale : (∑ tid : Fin N_T, -(q_F tid d * Real.log (q_F tid d / q_D d))) / ell =
              q_D d * ((∑ x : Fin N_T, -(P_d x 0 * Real.log (P_d x 0))) / ell) := by
            rw [← mul_div_assoc, Finset.mul_sum]
            congr 1
            refine Finset.sum_congr rfl (fun tid _ => ?_)
            dsimp only [P_d]
            rw [mul_neg, ← mul_assoc, mul_div_cancel₀ _ hqD_pos.ne']
          have h_log_Bd : Real.log B_d / ell =
              g_bin - pktWeight γ (b_F d) (a_F d) + 2 * ξ + Real.log (50625 * C_cov) / ell := by
            dsimp only [B_d, ell]
            have h50625 : 0 < C_cov * 50625 := mul_pos hC_cov_pos (by norm_num)
            have hrpow_pos : 0 < ε ^ exp_d := Real.rpow_pos_of_pos hε₀ exp_d
            rw [Real.log_mul h50625.ne' hrpow_pos.ne', Real.log_rpow hε₀,
              mul_comm C_cov 50625, add_div]
            have h_log_inv : Real.log ε = -Real.log (ε⁻¹) := by rw [Real.log_inv, neg_neg]
            rw [h_log_inv]
            have hell_ne : Real.log (ε⁻¹) ≠ 0 := hell_pos.ne'
            have h_exp_div : (exp_d * -Real.log (ε⁻¹)) / Real.log (ε⁻¹) = -exp_d := by
              rw [mul_neg, neg_div, mul_div_cancel_right₀ exp_d hell_ne]
            rw [h_exp_div]; dsimp only [exp_d]; ring
          rw [h_lhs_scale]
          calc q_D d * ((∑ x : Fin N_T, -(P_d x 0 * Real.log (P_d x 0))) / ell)
              ≤ q_D d * (Real.log B_d / ell) := mul_le_mul_of_nonneg_left h_ent_d hqD_pos.le
            _ = q_D d * (g_bin - pktWeight γ (b_F d) (a_F d) + 2 * ξ +
                  Real.log (50625 * C_cov) / ell) := by rw [h_log_Bd]
      have h_sum_fib := Finset.sum_le_sum (fun d (_ : d ∈ Finset.univ) => h_fib_d d)
      have h_rhs_simp : (∑ d : Fin N_F,
            q_D d * (g_bin - pktWeight γ (b_F d) (a_F d) + 2 * ξ + Real.log (50625 * C_cov) / ell)) =
          (g_bin + 2 * ξ + Real.log (50625 * C_cov) / ell) -
          (∑ d : Fin N_F, q_D d * ((1 + γ) * b_F d + (1 - γ) * a_F d)) := by
        have h_split : ∀ d : Fin N_F,
            q_D d * (g_bin - pktWeight γ (b_F d) (a_F d) + 2 * ξ + Real.log (50625 * C_cov) / ell) =
            q_D d * (g_bin + 2 * ξ + Real.log (50625 * C_cov) / ell) -
            q_D d * ((1 + γ) * b_F d + (1 - γ) * a_F d) := by
          intro d; dsimp only [pktWeight]; ring
        simp_rw [h_split]
        rw [Finset.sum_sub_distrib, ← Finset.sum_mul, hqD_sum, one_mul]
      rw [sub_eq_add_neg (_ : ℝ) ((∑ tid : Fin N_T, ∑ d : Fin N_F, _) / ell), h_MI]
      linarith only [h_sum_fib, h_rhs_simp]

  
  
  
