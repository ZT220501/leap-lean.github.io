        |inner ℝ w_X3 (perp2D (e_D d))| ≤ cls.B_sys * ε ^ (-ζ_sh) * s_XF ∧
        (d_dim = 2 → ‖w_V3‖ ≤ 2 * cls.B_sys * s_VF ∧ ‖w_X3‖ ≤ 2 * cls.B_sys * s_XF) := by
      intro o d α hq_pos r_loc c_end C_D C_r V'_D X'_D P_α w_V2 w_V3 w_X2 w_X3
      obtain ⟨hr_eq, hloc_eq, hb0, hb_ge, hba, ha_hi, he_unit, _, ha_sh, hd2_eq,
