    have h_rhs_final : 131072 * B_core * ε ^ (-(5 / 4 : ℝ) * h) * Wt =
        (131072 * C_sub_bes * C_cov ^ 3 * (M_mult : ℝ)) * R_tr ^ 2 *
          ε ^ (-(5 / 4 : ℝ) * h - ξ) * sub.m_bin * (T_P.card : ℝ) := by
      dsimp only [B_core, Wt, w_max]
      have hexp : ε ^ (-(5 / 4 : ℝ) * h) * ε ^ (-ξ) = ε ^ (-(5 / 4 : ℝ) * h - ξ) := by
