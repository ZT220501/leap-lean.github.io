        intro t
        dsimp [Ψ]
        rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (by linarith [hψ_ge1 t])]
        exact hψ_ge1 t
      have hΨ_ne : ∀ t : ℝ, Ψ t ≠ 0 := by
        intro t ht0
        have h1 := hΨ_norm_ge1 t
        rw [ht0, norm_zero] at h1
        linarith
      have hΨ_deriv_bd : ∀ j : ℕ, 1 ≤ j → ∀ t : ℝ, ‖iteratedDeriv j Ψ t‖ ≤ D_phase j := by
        intro j hj t
        rw [h_ofReal_iter j ψ hψ_sm t, Complex.norm_real, Real.norm_eq_abs]
