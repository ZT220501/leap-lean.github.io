                  rw [← mul_sub, ← Real.log_div (div_pos (mul_pos hpj_pos hqDl_pos) hqDr_pos).ne' (by norm_num)]
                  congr 2; ring
                rw [h_sub_log]
                have h_kl := Real.log_le_sub_one_of_pos
                  (div_pos (mul_pos hpj_pos hqDl_pos) (mul_pos (by norm_num : (0 : ℝ) < 16) hqDr_pos))
                have h_mul := mul_le_mul_of_nonneg_left h_kl hqDr_pos.le
                have h_simp : qD_raw js d s * ((p_J js.1 * qD_loc js d) / (16 * qD_raw js d s) - 1) =
                    (p_J js.1 * qD_loc js d) / 16 - qD_raw js d s := by
                  field_simp [hqDr_pos.ne']
                linarith
          _ = 0 := by
              rw [Finset.sum_sub_distrib, Finset.sum_const, hqD_raw_sum_s]
              have h_c16 : (Finset.univ : Finset Orth4).card = 16 := by decide
              rw [h_c16, nsmul_eq_mul]
              ring
      rw [h_p1, h_p2]
      linarith
    have h_avg_root_ub :
        ∑ j ∈ ActiveJ, p_J j * τ'_cell j ≤
        classicalRootSupremum ε (1 + m) γ N_ω N_T π T_idx V_part A_part -
          2 * b_u + stdApRawEntropy ε π J₀ + (1 + Real.log 16) / Real.log (ε⁻¹) := by
      rw [← Finset.sum_coe_sort ActiveJ (fun j => p_J j * τ'_cell j)]
      have h_loc_avg :
          (∑ js : ActSub, p_J js.1 * τ'_cell js.1) - 1 / Real.log (ε⁻¹) ≤
          ∑ js : ActSub, p_J js.1 *
            ((∑ d : Fin (N_loc js), qD_loc js d * ((1 + γ) * B_loc js d + (1 - γ) * A_loc js d)) -
             (∑ tid : Fin N_T, ∑ d : Fin (N_loc js),
               q_loc js tid d * Real.log (q_loc js tid d / (p_Tj js.1 tid * qD_loc js d))) /
               Real.log (ε⁻¹)) := by
        have h1_eq : 1 / Real.log (ε⁻¹) = ∑ js : ActSub, p_J js.1 * (1 / Real.log (ε⁻¹)) := by
          rw [← Finset.sum_mul, Finset.sum_coe_sort ActiveJ p_J, hpJ_sum, one_mul]
        rw [h1_eq, ← Finset.sum_sub_distrib]
        refine Finset.sum_le_sum (fun js _ => ?_)
        rw [← mul_sub]
        exact mul_le_mul_of_nonneg_left (h_loc_spec js).2.2.2.2.le (hpJ_pos js.1 js.2).le
      have h_split_loc :
          (∑ js : ActSub, p_J js.1 *
            ((∑ d : Fin (N_loc js), qD_loc js d * ((1 + γ) * B_loc js d + (1 - γ) * A_loc js d)) -
             (∑ tid : Fin N_T, ∑ d : Fin (N_loc js),
               q_loc js tid d * Real.log (q_loc js tid d / (p_Tj js.1 tid * qD_loc js d))) /
               Real.log (ε⁻¹))) =
          (∑ js : ActSub, p_J js.1 *
            (∑ d : Fin (N_loc js), qD_loc js d * ((1 + γ) * B_loc js d + (1 - γ) * A_loc js d))) -
          (∑ js : ActSub, p_J js.1 *
            ((∑ tid : Fin N_T, ∑ d : Fin (N_loc js),
              q_loc js tid d * Real.log (q_loc js tid d / (p_Tj js.1 tid * qD_loc js d))) /
              Real.log (ε⁻¹))) := by
        rw [← Finset.sum_sub_distrib]
        refine Finset.sum_congr rfl (fun _ _ => mul_sub _ _ _)
      have h_div_add16 : (1 + Real.log 16) / Real.log (ε⁻¹) =
          1 / Real.log (ε⁻¹) + Real.log 16 / Real.log (ε⁻¹) := add_div _ _ _
      linarith [h_glob_root, hEw_glob, hITD_glob, h_loc_avg, h_split_loc, h_div_add16]
    let Δ'_cell : (ℤ × ℤ × ℤ × ℤ) → ℝ := fun j =>
      stdApertureDeficit ε γ L' u 0 e_u (π_cell j) T_idx (V'_cell j) (A'_cell j) c_s θ_s
    have h_avg_def :
        ∑ j ∈ ActiveJ, p_J j * Δ'_cell j ≤
        stdApertureDeficit ε γ (1 + m) u b_u a_u π T_idx V_part A_part c_s θ_s +
          C_loc / Real.log (ε⁻¹) := by
      have h_expand :
          (∑ j ∈ ActiveJ, p_J j * Δ'_cell j) =
          (∑ j ∈ ActiveJ, p_J j * τ'_cell j) + classicalGrowthRate γ * u -
          (∑ j ∈ ActiveJ, p_J j *
            stdApertureScore ε γ u 0 e_u (π_cell j) T_idx (V'_cell j) (A'_cell j) c_s θ_s) := by
        have hbu : classicalGrowthRate γ * u = ∑ j ∈ ActiveJ, p_J j * (classicalGrowthRate γ * u) := by
          rw [← Finset.sum_mul, hpJ_sum, one_mul]
        rw [hbu, ← Finset.sum_add_distrib, ← Finset.sum_sub_distrib]
        refine Finset.sum_congr rfl (fun j _ => ?_)
        dsimp [Δ'_cell, τ'_cell]
        unfold stdApertureDeficit
        ring
      rw [h_expand]
      unfold stdApertureDeficit
      have hC_split : C_loc / Real.log (ε⁻¹) =
