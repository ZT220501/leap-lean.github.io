    dsimp only []
    change (∑ g : Fin N_G, p_G g * ((1 + γ) * b₀ + (1 - γ) * a₀)) -
      (∑ tid : Fin M_T, ∑ g : Fin N_G,
        p_TG tid g * Real.log (p_TG tid g / (p_T tid * p_G g))) / ell +
      2 * ((∑ tid : Fin M_T, ∑ k ∈ S_cells,
        -(p_TC tid k * Real.log (p_TC tid k / p_T tid))) / ell) = _
    rw [hE_w, hI_TG, hS_t]
  have vec2d_helpers :
      (∀ v : EuclideanSpace ℝ (Fin 2), ‖v‖ ^ 2 = (v 0) ^ 2 + (v 1) ^ 2) ∧
      (∀ v : EuclideanSpace ℝ (Fin 2), |v 0| ≤ ‖v‖ ∧ |v 1| ≤ ‖v‖) ∧
      (∀ v : EuclideanSpace ℝ (Fin 2), ‖v‖ ≤ |v 0| + |v 1|) ∧
      (∀ u v : EuclideanSpace ℝ (Fin 2), inner ℝ u v = u 0 * v 0 + u 1 * v 1) ∧
      (∀ n : EuclideanSpace ℝ (Fin 2), ‖negPerp2D n‖ = ‖n‖) ∧
      (∀ n : EuclideanSpace ℝ (Fin 2), perp2D (negPerp2D n) = n) ∧
      (∀ n : EuclideanSpace ℝ (Fin 2), inner ℝ n (negPerp2D n) = 0) ∧
      (∀ (n v : EuclideanSpace ℝ (Fin 2)), ‖n‖ = 1 →
        v = (inner ℝ v n) • n + (inner ℝ v (negPerp2D n)) • (negPerp2D n)) := by
    have h_sq : ∀ v : EuclideanSpace ℝ (Fin 2), ‖v‖ ^ 2 = (v 0) ^ 2 + (v 1) ^ 2 := by
      intro v
      rw [PiLp.norm_sq_eq_of_L2, Fin.sum_univ_two]
      simp [Real.norm_eq_abs, sq_abs]
    have h_coord : ∀ v : EuclideanSpace ℝ (Fin 2), |v 0| ≤ ‖v‖ ∧ |v 1| ≤ ‖v‖ := by
      intro v
      constructor
      · nlinarith [h_sq v, sq_abs (v 0), sq_nonneg (v 1), norm_nonneg v, abs_nonneg (v 0)]
      · nlinarith [h_sq v, sq_abs (v 1), sq_nonneg (v 0), norm_nonneg v, abs_nonneg (v 1)]
    have h_l1 : ∀ v : EuclideanSpace ℝ (Fin 2), ‖v‖ ≤ |v 0| + |v 1| := by
      intro v
      nlinarith [h_sq v, sq_abs (v 0), sq_abs (v 1),
        mul_nonneg (abs_nonneg (v 0)) (abs_nonneg (v 1)),
        norm_nonneg v, abs_nonneg (v 0), abs_nonneg (v 1)]
    have h_in : ∀ u v : EuclideanSpace ℝ (Fin 2), inner ℝ u v = u 0 * v 0 + u 1 * v 1 := by
      intro u v
      rw [PiLp.inner_apply, Fin.sum_univ_two]
      simp
      ring
    have h_np_norm : ∀ n : EuclideanSpace ℝ (Fin 2), ‖negPerp2D n‖ = ‖n‖ := by
      intro n
      have h_eq_sq : ‖negPerp2D n‖ ^ 2 = ‖n‖ ^ 2 := by
        rw [h_sq (negPerp2D n), h_sq n]
        have h0 : (negPerp2D n) 0 = n 1 := rfl
        have h1 : (negPerp2D n) 1 = -(n 0) := rfl
        rw [h0, h1]
        ring
      nlinarith [h_eq_sq, norm_nonneg (negPerp2D n), norm_nonneg n]
    have h_perp_np : ∀ n : EuclideanSpace ℝ (Fin 2), perp2D (negPerp2D n) = n := by
      intro n
      ext i
      fin_cases i <;> simp [perp2D, negPerp2D]
    have h_orth : ∀ n : EuclideanSpace ℝ (Fin 2), inner ℝ n (negPerp2D n) = 0 := by
      intro n
      rw [h_in]
      simp [negPerp2D]
      ring
    have h_parseval : ∀ (n v : EuclideanSpace ℝ (Fin 2)), ‖n‖ = 1 →
        v = (inner ℝ v n) • n + (inner ℝ v (negPerp2D n)) • (negPerp2D n) := by
      intro n v hn
      have hnsq : (n 0) ^ 2 + (n 1) ^ 2 = 1 := by
        have := h_sq n
        rw [hn] at this
        linarith
      ext i
      fin_cases i
      · simp [h_in, negPerp2D]
        linear_combination -(v 0) * hnsq
      · simp [h_in, negPerp2D]
        linear_combination -(v 1) * hnsq
    exact ⟨h_sq, h_coord, h_l1, h_in, h_np_norm, h_perp_np, h_orth, h_parseval⟩
