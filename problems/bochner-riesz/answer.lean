      (∑ j : Fin N_J, π_J j * d₁ j ≤ B_tot) ∧
      (∑ j : Fin N_J, π_J j * (d₂ j + d₃ j) ≤ B_tot) ∧
      (d₀ + ∑ j : Fin N_J, π_J j * d₁ j ≤ B_tot) := by
    intro N_J d₀ B_tot π_J d₁ d₂ d₃ hd₀ hπ_nn hd_nn hsum
    have h1_nn : 0 ≤ ∑ j : Fin N_J, π_J j * d₁ j := by
