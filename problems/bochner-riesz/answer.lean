        obtain ⟨hX_bd, hW_bd⟩ := h_ortho_to_shear e'_u1 w₁' w₂' R_mu1 σ₁ E_align
          (2 * ε ^ b₀) (2 * ε ^ (b₀ + m * u)) he'_norm hR_mu1_le2 hσ₁_mem hE_nn h_align1
          (by positivity) (by positivity) hd_par hd_perp
        exact ⟨hIX_m _ (by linarith), hIW_m _ (hW_bd.trans h_cross_cap)⟩
      · rintro ⟨hbin_X, hbin_W⟩
        have hd_X : |w₂' 0 - w₁' 0| ≤ 2 * ε ^ b₀ :=
          ((h_real_lvl ε b₀ hε₀ hε₁).2.2.2 _ _ hbin_X).2.le
        have hd_W : |(w₂' 1 - R_mu1 * w₂' 0) - (w₁' 1 - R_mu1 * w₁' 0)| ≤
            2 * ε ^ (b₀ + m * u) :=
          ((h_real_lvl ε (b₀ + m * u) hε₀ hε₁).2.2.2 _ _ hbin_W).2.le
        obtain ⟨hpar_bd, hperp_bd⟩ := h_shear_to_ortho e'_u1 w₁' w₂' R_mu1 σ₁ E_align
          (2 * ε ^ b₀) (2 * ε ^ (b₀ + m * u)) he'_norm hR_mu1_le2 hσ₁_mem hE_nn h_align1
          (by positivity) (by positivity) hd_X hd_W
        rw [h_in_par w₂, h_in_par w₁] at hpar_bd
        rw [h_in_perp w₂, h_in_perp w₁] at hperp_bd
        have hperp_cap : 3 * (2 * ε ^ b₀) * E_align + 2 * ε ^ (b₀ + m * u) ≤ r_norm := by
          linarith [Real.rpow_pos_of_pos hε₀ (b₀ + m * u)]
        exact ⟨hIpar_m _ (by linarith), hIperp_m _ (hperp_bd.trans hperp_cap)⟩
    
    let kc₁ := dyadicTimeBin ε u c₁
    let C_u1 := dyadicTimeMid ε u c₁
    let P₁ := A₁ + C_u1 • V₁
    obtain ⟨I_X, I_W, I_Vpar, I_Vperp, hIX_c, hIW_c, hIVpar_c, hIVperp_c, hV_enc⟩ :=
      h_vec_enclose b_u V₁
    obtain ⟨I_Y, I_Z, I_Ppar, I_Pperp, hIY_c, hIZ_c, hIPpar_c, hIPperp_c, hP_enc⟩ :=
      h_vec_enclose (b_u + u) P₁
    let S_row : Finset (ℤ × ℤ × ℤ × ℤ × ℤ × ℤ) :=
      ({kc₁} : Finset ℤ) ×ˢ ({kr₁} : Finset ℤ) ×ˢ I_X ×ˢ I_Y ×ˢ I_W ×ˢ I_Z
    let S_std : Finset (ℤ × ℤ × ℤ × ℤ × ℤ × ℤ) :=
      ({kc₁} : Finset ℤ) ×ˢ ({kang₁} : Finset ℤ) ×ˢ I_Vpar ×ˢ I_Vperp ×ˢ I_Ppar ×ˢ I_Pperp
    let B_1 : ℝ := (96 * (N : ℝ) + 182) * ε ^ (-ν)
    have hB1_nn : 0 ≤ B_1 := by positivity
    have hB1_sq : B_1 * B_1 = (96 * (N : ℝ) + 182) ^ 2 * ε ^ (-2 * ν) := by
      dsimp only [B_1]
      have h_mul_rpow : ε ^ (-ν) * ε ^ (-ν) = ε ^ (-2 * ν) := by
        rw [← Real.rpow_add hε₀]; congr 1; ring
      calc ((96 * (N : ℝ) + 182) * ε ^ (-ν)) * ((96 * (N : ℝ) + 182) * ε ^ (-ν))
          = (96 * (N : ℝ) + 182) ^ 2 * (ε ^ (-ν) * ε ^ (-ν)) := by ring
        _ = (96 * (N : ℝ) + 182) ^ 2 * ε ^ (-2 * ν) := by rw [h_mul_rpow]
    have hSrow_le : S_row.card ≤ ⌈C_loc * ε ^ (-2 * ν)⌉₊ := by
      refine h_card_ceil _ _ ?_
      have hceq : (S_row.card : ℝ) =
          (I_X.card : ℝ) * (I_Y.card : ℝ) * ((I_W.card : ℝ) * (I_Z.card : ℝ)) := by
        dsimp only [S_row]
        simp only [Finset.card_product, Finset.card_singleton]
        push_cast; ring
      rw [hceq]
      have hm_xy : (I_X.card : ℝ) * (I_Y.card : ℝ) ≤ 10 * 10 :=
        mul_le_mul hIX_c hIY_c (Nat.cast_nonneg _) (by norm_num)
      have hm_wz : (I_W.card : ℝ) * (I_Z.card : ℝ) ≤ B_1 * B_1 :=
        mul_le_mul hIW_c hIZ_c (Nat.cast_nonneg _) hB1_nn
      have hm_all : ((I_X.card : ℝ) * (I_Y.card : ℝ)) * ((I_W.card : ℝ) * (I_Z.card : ℝ)) ≤
