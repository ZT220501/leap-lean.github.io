            H_mix F (planeEmbed n c (i, u) + η)) ≤ C_hess := by
    intro K δ hK hδ₀ hδ₁
    have hK_le : -K ≤ K := by linarith
    have hK1_le : -(K + 1) ≤ K + 1 := by linarith
    have hδ_le : δ ≤ 1 - δ := by linarith
    have hδ2_le : δ / 2 ≤ 1 - δ / 2 := by linarith
    let j₀ : Fin n := ⟨0, by omega⟩
    let j₁ : Fin n := ⟨1, by omega⟩
    have hj01 : j₀ ≠ j₁ := by
      intro h
      have hval := congr_arg Fin.val h
      norm_num [j₀, j₁] at hval
    have hne : (Finset.univ : Finset (Fin n)).offDiag.Nonempty :=
      ⟨(j₀, j₁), Finset.mem_offDiag.mpr ⟨Finset.mem_univ _, Finset.mem_univ _, hj01⟩⟩
    let c_gap : ℝ := min 1 ((Finset.univ : Finset (Fin n)).offDiag.inf' hne
