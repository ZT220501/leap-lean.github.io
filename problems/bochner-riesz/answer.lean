    intro N_ω P S hP_nn hS_pos hm_pos m_S P_S
    refine ⟨?_, ?_, ?_, ?_, ?_⟩
    · intro ω
      dsimp [P_S, restrictLaw]
      split_ifs
      · exact div_nonneg (hP_nn ω) hm_pos.le
      · exact le_rfl
    · dsimp [P_S, restrictLaw]
