        have hc_top3 : ∀ j : Fin 3, j ≠ 2 → c3 j < c3 2 := by
          intro j hj
          fin_cases j <;> simp [c3] at hj ⊢
        have hd_nn3 : (∀ j, 0 ≤ d3 j) ∧ d3 2 ≤ 1 ∧ (0 : ℝ) ≤ 2 := by
