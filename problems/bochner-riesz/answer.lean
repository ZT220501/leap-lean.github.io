      have hR₃_sum : (∑ b₀, ∑ b₁, ∑ b₂, R₃ b₀ b₁ b₂) = 1 := by
        have h_prod : (∑ b : Fin N_Θ × Fin N_Θ × Fin N_Θ, R₃ b.1 b.2.1 b.2.2) =
