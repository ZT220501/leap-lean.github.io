        (h_in_e0 (A_part tid)).1, (h_in_e0 (A_part tid)).2]
      exact ⟨hV1_bd, hV2_bd, hA1_bd, hA2_bd⟩

    
    have h_1d_three_shifts : ∀ (x₀ δ : ℝ), |x₀| ≤ B_iso → ε ≤ δ →
        ∃ I_s : Finset ℤ,
          I_s.card ≤ 3 ∧
          (∀ k ∈ I_s, k ∈ box_R) ∧
          (∀ x : ℝ, |x - x₀| ≤ 22 * δ → ∃ k ∈ I_s, |x - (k : ℝ) * δ| ≤ 10 * δ) := by
