      ‖X_ex q - gridPt2D s k_Y‖ ≤ ε ^ (-η) * ρ₀ + (R'_win + 6) * s
    let S_Z :=
      letI := Classical.propDecidable
      Finset.univ.filter (fun o : Fin N_O =>
        r_O o = r ∧
        pktRound2D s (V_O o) = k_V ∧
        pktRound2D s (X_O o + (1 / 2 - C_r) • V_O o) = k_Y ∧
        (4 * (M_c : ℝ) ^ 2)⁻¹ * ε ^ A₀ * E_f ≤ m_of o)
    let T_Z := letI := Classical.propDecidable; F_m.filter P_TZ
    let S_far := letI := Classical.propDecidable; F_m.filter (fun q => ¬ P_TZ q)
    intro h_far_lt h_far_K hSZ_ne
    have hs_pos : 0 < s := Real.rpow_pos_of_pos hε₀ a
    have hρ_obs_le_s : ρ_obs ≤ s := Real.rpow_le_rpow_of_exponent_ge hε₀ hε₁.le ha_hi
    have hB_pos : 0 < B_sys := by linarith only [hB_sys]
    have hρ₀_le_Bs : ρ₀ ≤ B_sys * s :=
      le_trans hρ₀_bound (mul_le_mul_of_nonneg_left hρ_obs_le_s hB_pos.le)
    have hρ_tilde_le_Bs : ρ_tilde ≤ B_sys * s := by
      refine max_le hρ₀_le_Bs ?_
      calc ρ_obs ≤ 1 * s := by rw [one_mul]; exact hρ_obs_le_s
        _ ≤ B_sys * s := mul_le_mul_of_nonneg_right (by linarith only [hB_sys]) hs_pos.le
    have hR'_nn : 0 ≤ R'_win := by
      dsimp only [R'_win]
      exact mul_nonneg (by linarith only [hR_win]) hB_pos.le
    have hCr_half : |1 / 2 - C_r| ≤ 1 / 2 := by
      have h2m_pos : (0 : ℝ) < (2 : ℝ) ^ m_time := by positivity
      have hr_le : (r : ℝ) + 1 ≤ (2 : ℝ) ^ m_time := by exact_mod_cast Nat.succ_le_of_lt hr
      have hCr_nn : 0 ≤ C_r := by
        dsimp only [C_r]
        exact mul_nonneg (by positivity) (inv_nonneg.mpr h2m_pos.le)
      have hCr_le1 : C_r ≤ 1 := by
        dsimp only [C_r]
        rw [← div_eq_mul_inv, div_le_one h2m_pos]
        linarith only [hr_le]
      exact abs_le.mpr ⟨by linarith only [hCr_le1], by linarith only [hCr_nn]⟩
    have h_sep_far : ∀ o ∈ S_Z, ∀ q ∈ S_far,
        R_win * ρ_tilde + 2 * ρ₀ ≤ ‖gridPt2D ρ₀ q.1 - V_O o‖ ∨
        ε ^ (-η) * ρ₀ ≤ ‖X_ex q - (X_O o + (1 / 2 - C_r) • gridPt2D ρ₀ q.1)‖ := by
      intro o ho q hq
      obtain ⟨_, ⟨_, hkV_eq, hkY_eq, _⟩⟩ :=
        (letI := Classical.propDecidable; Finset.mem_filter.mp ho)
      obtain ⟨_, hnot_TZ⟩ :=
        (letI := Classical.propDecidable; Finset.mem_filter.mp hq)
      have hVo_err : ‖V_O o - gridPt2D s k_V‖ ≤ s := by
        rw [← hkV_eq]
        exact h_round_err s (V_O o) hs_pos
      have hYo_err : ‖(X_O o + (1 / 2 - C_r) • V_O o) - gridPt2D s k_Y‖ ≤ s := by
        rw [← hkY_eq]
        exact h_round_err s (X_O o + (1 / 2 - C_r) • V_O o) hs_pos
      let V_q := gridPt2D ρ₀ q.1
      let g_V := gridPt2D s k_V
      let g_Y := gridPt2D s k_Y
