    let R_lin : EuclideanSpace ℝ (Fin 2) →ₗ[ℝ] EuclideanSpace ℝ (Fin 2) :=
      { toFun := fun q => (q 0) • e + (q 1) • perp2D e
        map_add' := fun p q => by
          simp only [PiLp.add_apply, add_smul]
