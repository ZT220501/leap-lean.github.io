    let α₀ : ℝ := inner ℝ u e_D / t₁
    let α₁ : ℝ := inner ℝ u (perp2D e_D) / t₂
    have hα₀ : |α₀| ≤ R := by
      dsimp only [α₀]
      rw [abs_div, abs_of_pos ht₁_pos, div_le_iff₀ ht₁_pos]
      exact hu1
    have hα₁ : |α₁| ≤ R := by
      dsimp only [α₁]
      rw [abs_div, abs_of_pos ht₂_pos, div_le_iff₀ ht₂_pos]
      exact hu2
    have hα_sq : α₀ ^ 2 + α₁ ^ 2 ≤ 2 * R ^ 2 := by
      have h0 : α₀ ^ 2 ≤ R ^ 2 := sq_le_sq.mpr (by rwa [abs_of_nonneg hR_nn])
      have h1 : α₁ ^ 2 ≤ R ^ 2 := sq_le_sq.mpr (by rwa [abs_of_nonneg hR_nn])
      linarith
    have hu_decomp : u = (α₀ * t₁) • e_D + (α₁ * t₂) • perp2D e_D := by
      have hb0 : α₀ * t₁ = inner ℝ u e_D := by
        dsimp only [α₀]
        exact div_mul_cancel₀ _ ht₁_pos.ne'
      have ha0 : α₁ * t₂ = inner ℝ u (perp2D e_D) := by
        dsimp only [α₁]
        exact div_mul_cancel₀ _ ht₂_pos.ne'
      rw [hb0, ha0]
      ext i
      fin_cases i
      · simp only [PiLp.add_apply, PiLp.smul_apply, smul_eq_mul, inner_eq, perp2D, ite_true]
        have hp1 : (if (1 : Fin 2) = 0 then -(e_D 1) else e_D 0) = e_D 0 :=
          if_neg (by decide)
        rw [hp1]
        calc u 0
            = u 0 * ((e_D 0) ^ 2 + (e_D 1) ^ 2) := by rw [heD_sq]; ring
          _ = (u 0 * e_D 0 + u 1 * e_D 1) * e_D 0 +
                (u 0 * -(e_D 1) + u 1 * e_D 0) * -(e_D 1) := by ring
      · simp only [PiLp.add_apply, PiLp.smul_apply, smul_eq_mul, inner_eq, perp2D, ite_true]
        have hp1 : (if (1 : Fin 2) = 0 then -(e_D 1) else e_D 0) = e_D 0 :=
          if_neg (by decide)
        rw [hp1]
        calc u 1
            = u 1 * ((e_D 0) ^ 2 + (e_D 1) ^ 2) := by rw [heD_sq]; ring
          _ = (u 0 * e_D 0 + u 1 * e_D 1) * e_D 1 +
                (u 0 * -(e_D 1) + u 1 * e_D 0) * e_D 0 := by ring
    have hSJ_u : S_J_lin u = α₀ • m₁ + α₁ • m₂ := by
      rw [hu_decomp]
      ext i
      simp only [S_J_lin, m₁, m₂, PiLp.add_apply, PiLp.smul_apply, smul_eq_mul]
      ring
    rw [hSJ_u, inner_add_left,
      real_inner_smul_left m₁ g α₀,
      real_inner_smul_left m₂ g α₁]
    dsimp only [Q_fn]
    let x := inner ℝ m₁ g
    let y := inner ℝ m₂ g
    change (α₀ * x + α₁ * y) ^ 2 ≤ (2 * R ^ 2) * (x ^ 2 + y ^ 2)
    have h_id : (α₀ ^ 2 + α₁ ^ 2) * (x ^ 2 + y ^ 2) - (α₀ * x + α₁ * y) ^ 2 =
        (α₀ * y - α₁ * x) ^ 2 := by ring
    have h_cs1 : (α₀ * x + α₁ * y) ^ 2 ≤ (α₀ ^ 2 + α₁ ^ 2) * (x ^ 2 + y ^ 2) := by
      linarith [h_id, sq_nonneg (α₀ * y - α₁ * x)]
    have h_cs2 : (α₀ ^ 2 + α₁ ^ 2) * (x ^ 2 + y ^ 2) ≤ (2 * R ^ 2) * (x ^ 2 + y ^ 2) :=
      mul_le_mul_of_nonneg_right hα_sq (add_nonneg (sq_nonneg x) (sq_nonneg y))
    exact le_trans h_cs1 h_cs2
  refine ⟨p_raw, q_raw, e_G, hp_nn, hpq, hqr_le_L, heG_norm, hw_ineq, ?_⟩
  intro z w Δ_r hΔr_pos hΔr_le hz1 hz2 hw1 hw2
  have h250_p_pos : 0 < 250 * ε ^ p_raw := by rw [hε_p]; positivity
  have h250_q_pos : 0 < 250 * ε ^ q_raw := by rw [hε_q]; positivity
  have hz_eG : |inner ℝ ((10 : ℝ) • S_J_lin z) e_G| ≤ 250 * ε ^ p_raw := by
    have hcs := h_cs_bound z 10 (by norm_num) hz1 hz2 e_G
    rw [hQeG, ← hσ_max_sq, ← hε_p] at hcs
    rw [real_inner_smul_left (S_J_lin z) e_G 10]
    have hsq : (10 * inner ℝ (S_J_lin z) e_G) ^ 2 ≤ (250 * ε ^ p_raw) ^ 2 := by
      have h200 : (2 * (10 : ℝ) ^ 2) * (ε ^ p_raw) ^ 2 = 200 * (ε ^ p_raw) ^ 2 := by ring
      have h100 : (10 * inner ℝ (S_J_lin z) e_G) ^ 2 =
          100 * (inner ℝ (S_J_lin z) e_G) ^ 2 := by ring
      have h625 : (250 * ε ^ p_raw) ^ 2 = 62500 * (ε ^ p_raw) ^ 2 := by ring
      linarith [hcs, h200, h100, h625, sq_nonneg (ε ^ p_raw)]
    have habs := sq_le_sq.mp hsq
    rwa [abs_of_pos h250_p_pos] at habs
  have hz_peG : |inner ℝ ((10 : ℝ) • S_J_lin z) (perp2D e_G)| ≤ 250 * ε ^ q_raw := by
    have hcs := h_cs_bound z 10 (by norm_num) hz1 hz2 (perp2D e_G)
    rw [hQpeG, ← hσ_min_sq, ← hε_q] at hcs
    rw [real_inner_smul_left (S_J_lin z) (perp2D e_G) 10]
    have hsq : (10 * inner ℝ (S_J_lin z) (perp2D e_G)) ^ 2 ≤ (250 * ε ^ q_raw) ^ 2 := by
      have h200 : (2 * (10 : ℝ) ^ 2) * (ε ^ q_raw) ^ 2 = 200 * (ε ^ q_raw) ^ 2 := by ring
      have h100 : (10 * inner ℝ (S_J_lin z) (perp2D e_G)) ^ 2 =
          100 * (inner ℝ (S_J_lin z) (perp2D e_G)) ^ 2 := by ring
      have h625 : (250 * ε ^ q_raw) ^ 2 = 62500 * (ε ^ q_raw) ^ 2 := by ring
      linarith [hcs, h200, h100, h625, sq_nonneg (ε ^ q_raw)]
    have habs := sq_le_sq.mp hsq
    rwa [abs_of_pos h250_q_pos] at habs
  let u_wz : EuclideanSpace ℝ (Fin 2) := w + (1 / 2 : ℝ) • z
  have hu_wz1 : |inner ℝ u_wz e_D| ≤ 15 * t₁ := by
    dsimp only [u_wz]
    rw [inner_add_left, real_inner_smul_left z e_D (1 / 2 : ℝ)]
    have htri := abs_add_le (inner ℝ w e_D) ((1 / 2 : ℝ) * inner ℝ z e_D)
    rw [abs_mul, abs_of_pos (by norm_num : (0 : ℝ) < 1 / 2)] at htri
    dsimp only [t₁]
    linarith
  have hu_wz2 : |inner ℝ u_wz (perp2D e_D)| ≤ 15 * t₂ := by
    dsimp only [u_wz]
    rw [inner_add_left, real_inner_smul_left z (perp2D e_D) (1 / 2 : ℝ)]
    have htri := abs_add_le (inner ℝ w (perp2D e_D)) ((1 / 2 : ℝ) * inner ℝ z (perp2D e_D))
    rw [abs_mul, abs_of_pos (by norm_num : (0 : ℝ) < 1 / 2)] at htri
    dsimp only [t₂]
    linarith
  have hu_eG : |10 * inner ℝ (S_J_lin u_wz) e_G| ≤ 250 * ε ^ p_raw := by
    have hcs := h_cs_bound u_wz 15 (by norm_num) hu_wz1 hu_wz2 e_G
    rw [hQeG, ← hσ_max_sq, ← hε_p] at hcs
    have hsq : (10 * inner ℝ (S_J_lin u_wz) e_G) ^ 2 ≤ (250 * ε ^ p_raw) ^ 2 := by
      have h450 : (2 * (15 : ℝ) ^ 2) * (ε ^ p_raw) ^ 2 = 450 * (ε ^ p_raw) ^ 2 := by ring
      have h100 : (10 * inner ℝ (S_J_lin u_wz) e_G) ^ 2 =
          100 * (inner ℝ (S_J_lin u_wz) e_G) ^ 2 := by ring
      have h625 : (250 * ε ^ p_raw) ^ 2 = 62500 * (ε ^ p_raw) ^ 2 := by ring
      linarith [hcs, h450, h100, h625, sq_nonneg (ε ^ p_raw)]
    have habs := sq_le_sq.mp hsq
    rwa [abs_of_pos h250_p_pos] at habs
  have hu_peG : |10 * inner ℝ (S_J_lin u_wz) (perp2D e_G)| ≤ 250 * ε ^ q_raw := by
    have hcs := h_cs_bound u_wz 15 (by norm_num) hu_wz1 hu_wz2 (perp2D e_G)
    rw [hQpeG, ← hσ_min_sq, ← hε_q] at hcs
    have hsq : (10 * inner ℝ (S_J_lin u_wz) (perp2D e_G)) ^ 2 ≤ (250 * ε ^ q_raw) ^ 2 := by
      have h450 : (2 * (15 : ℝ) ^ 2) * (ε ^ q_raw) ^ 2 = 450 * (ε ^ q_raw) ^ 2 := by ring
      have h100 : (10 * inner ℝ (S_J_lin u_wz) (perp2D e_G)) ^ 2 =
          100 * (inner ℝ (S_J_lin u_wz) (perp2D e_G)) ^ 2 := by ring
      have h625 : (250 * ε ^ q_raw) ^ 2 = 62500 * (ε ^ q_raw) ^ 2 := by ring
      linarith [hcs, h450, h100, h625, sq_nonneg (ε ^ q_raw)]
    have habs := sq_le_sq.mp hsq
    rwa [abs_of_pos h250_q_pos] at habs
  have hwz_eG : |inner ℝ ((10 * Δ_r) • S_J_lin u_wz) e_G| ≤ 250 * ε ^ (p_raw + r) := by
    rw [real_inner_smul_left (S_J_lin u_wz) e_G (10 * Δ_r)]
    have h_assoc : 10 * Δ_r * inner ℝ (S_J_lin u_wz) e_G =
        Δ_r * (10 * inner ℝ (S_J_lin u_wz) e_G) := by ring
    rw [h_assoc, abs_mul, abs_of_pos hΔr_pos]
    calc Δ_r * |10 * inner ℝ (S_J_lin u_wz) e_G|
        ≤ ε ^ r * (250 * ε ^ p_raw) :=
          mul_le_mul hΔr_le hu_eG (abs_nonneg _) (Real.rpow_nonneg hε₀.le r)
      _ = 250 * (ε ^ p_raw * ε ^ r) := by ring
      _ = 250 * ε ^ (p_raw + r) := by rw [← Real.rpow_add hε₀]
  have hwz_peG : |inner ℝ ((10 * Δ_r) • S_J_lin u_wz) (perp2D e_G)| ≤ 250 * ε ^ (q_raw + r) := by
    rw [real_inner_smul_left (S_J_lin u_wz) (perp2D e_G) (10 * Δ_r)]
    have h_assoc : 10 * Δ_r * inner ℝ (S_J_lin u_wz) (perp2D e_G) =
        Δ_r * (10 * inner ℝ (S_J_lin u_wz) (perp2D e_G)) := by ring
    rw [h_assoc, abs_mul, abs_of_pos hΔr_pos]
    calc Δ_r * |10 * inner ℝ (S_J_lin u_wz) (perp2D e_G)|
        ≤ ε ^ r * (250 * ε ^ q_raw) :=
          mul_le_mul hΔr_le hu_peG (abs_nonneg _) (Real.rpow_nonneg hε₀.le r)
      _ = 250 * (ε ^ q_raw * ε ^ r) := by ring
      _ = 250 * ε ^ (q_raw + r) := by rw [← Real.rpow_add hε₀]
  exact ⟨hz_eG, hz_peG, hwz_eG, hwz_peG⟩

theorem cell_root_competitor_gluing_and_local_lower_bound (γ r t L_hor δ_cl : ℝ)
    (hγ₀ : 0 < γ) (hγ₁ : γ < 1)
    (h_two : (2 : ℝ) ∈ ValidClassicalGrowthRates γ)
    (hr₀ : 0 < r) (hrt : r < t) (htL : t ≤ L_hor) (hδ : 0 < δ_cl) :
    (∃ ε₀' : ℝ, 0 < ε₀' ∧ ε₀' < 1 / 2 ∧
      ∀ (ε' e' : ℝ),
        0 < ε' → ε' < ε₀' → 0 ≤ e' → 1 + e' ≤ 1 + L_hor / (t - r) →
      ∀ {N_ω N_T : ℕ}
        (π' : Fin N_ω → ℝ) (T_idx : Fin N_ω → Fin N_T)
        (V' A' : Fin N_T → EuclideanSpace ℝ (Fin 2))
        (c' θ' : Fin N_ω → ℝ),
        (∀ ω, 0 ≤ π' ω) → (∑ ω : Fin N_ω, π' ω = 1) →
        (∀ tid, ‖V' tid‖ ≤ 1 ∧ ‖A' tid‖ ≤ 1) →
        (∀ ω, 0 < π' ω → c' ω ∈ Set.Icc (0 : ℝ) 1 ∧ θ' ω ∈ Set.Ico (0 : ℝ) Real.pi) →
        stdApertureScore ε' γ 1 0 e' π' T_idx V' A' c' θ' ≤
          classicalRootSupremum ε' (1 + e') γ N_ω N_T π' T_idx V' A' +
            classicalGrowthRate γ + δ_cl) ∧
    (∃ ε₀'' : ℝ, 0 < ε₀'' ∧ ε₀'' < 1 / 2 ∧
      ∀ (ε b_t a_t d Δ_r : ℝ),
        0 < ε → ε < ε₀'' → ε ^ (t - r) < 1 / 2 →
        0 ≤ b_t → b_t ≤ a_t → a_t + t ≤ L_hor →
        0 ≤ d → d ≤ a_t - b_t →
        (1 / 2 : ℝ) * ε ^ r ≤ Δ_r → Δ_r ≤ ε ^ r →
      ∀ {N_ω N_T : ℕ} {α_J : Type} [DecidableEq α_J]
        (π : Fin N_ω → ℝ) (T_idx : Fin N_ω → Fin N_T)
        (V_part A_part : Fin N_T → EuclideanSpace ℝ (Fin 2))
        (J : Fin N_ω → α_J) (k_r : Fin N_ω → ℤ) (proj_k : α_J → ℤ)
        (V_loc A_loc : α_J → Fin N_T → EuclideanSpace ℝ (Fin 2)),
        (∀ ω, 0 ≤ π ω) → (∑ ω : Fin N_ω, π ω = 1) →
        (∀ tid, ‖V_part tid‖ ≤ 1 ∧ ‖A_part tid‖ ≤ 1) →
        (∀ j tid, ‖V_loc j tid‖ ≤ 1 ∧ ‖A_loc j tid‖ ≤ 1) →
        (∀ ω, 0 < π ω →
          ((k_r ω : ℝ) + 1 / 2) * Δ_r ∈ Set.Icc (0 : ℝ) 1 ∧
          proj_k (J ω) = k_r ω) →
        (let η := t - r
         let ε_tilde := ε ^ η
         let e_loc := (a_t - b_t - d) / η
         let p_J := fun j => ∑ ω : Fin N_ω, if J ω = j then π ω else 0
         ∀ (j : α_J), 0 < p_J j →
         ∀ (B A : ℝ) (e_D V_D A_D : EuclideanSpace ℝ (Fin 2)),
           0 ≤ B → B ≤ A → A ≤ 1 + e_loc → ‖e_D‖ = 1 →
           ∃ (p_raw q_raw : ℝ) (e_G V_G X_G : EuclideanSpace ℝ (Fin 2)),
             0 ≤ p_raw ∧ p_raw ≤ q_raw ∧ q_raw + r ≤ L_hor ∧ ‖e_G‖ = 1 ∧
             ((1 + γ) * b_t + (1 - γ) * (b_t + d)) +
                 η * ((1 + γ) * B + (1 - γ) * A) ≤
               (1 + γ) * p_raw + (1 - γ) * q_raw ∧
             (∀ ω : Fin N_ω, 0 < π ω → J ω = j →
               let tid := T_idx ω
               let c_mid := ((k_r ω : ℝ) + 1 / 2) * Δ_r
               |inner ℝ (V_loc j tid - V_D) e_D| ≤ 10 * ε_tilde ^ B →
               |inner ℝ (V_loc j tid - V_D) (perp2D e_D)| ≤ 10 * ε_tilde ^ A →
               |inner ℝ (A_loc j tid - A_D) e_D| ≤ 10 * ε_tilde ^ B →
               |inner ℝ (A_loc j tid - A_D) (perp2D e_D)| ≤ 10 * ε_tilde ^ A →
               |inner ℝ (V_part tid - V_G) e_G| ≤ 250 * ε ^ p_raw ∧
               |inner ℝ (V_part tid - V_G) (perp2D e_G)| ≤ 250 * ε ^ q_raw ∧
               |inner ℝ ((A_part tid + c_mid • V_part tid) - X_G) e_G| ≤
                 250 * ε ^ (p_raw + r) ∧
               |inner ℝ ((A_part tid + c_mid • V_part tid) - X_G) (perp2D e_G)| ≤
                 250 * ε ^ (q_raw + r))) →
        let η := t - r
        let ε_tilde := ε ^ η
        let e_loc := (a_t - b_t - d) / η
        let S_J : Finset α_J := Finset.univ.image J
        let p_J := fun j => ∑ ω : Fin N_ω, if J ω = j then π ω else 0
        let π_j := fun j => restrictLaw π (Finset.univ.filter (fun ω => J ω = j))
        (((1 + γ) * b_t + (1 - γ) * (b_t + d)) -
            finMutualInfo ε π T_idx J +
            2 * finCondEntropy ε π T_idx k_r) +
          η * ∑ j ∈ S_J, p_J j *
            classicalRootSupremum ε_tilde (1 + e_loc) γ N_ω N_T (π_j j) T_idx
              (V_loc j) (A_loc j) ≤
          classicalRootSupremum ε L_hor γ N_ω N_T π T_idx V_part A_part +
            classicalGrowthRate γ * r + (2 / 3 : ℝ) * δ_cl * η) :=
by
  refine ⟨?_, ?_⟩
  · 
    have ht_pos : 0 < t := lt_trans hr₀ hrt
    have hL_pos : 0 < L_hor := lt_of_lt_of_le ht_pos htL
    have hη_pos : 0 < t - r := sub_pos.mpr hrt
    let K_hor' : ℝ := 1 + L_hor / (t - r)
    have hK_ge1 : 1 ≤ K_hor' := by
      dsimp only [K_hor']
      linarith [div_pos hL_pos hη_pos]
    have h_ne1 : (ValidClassicalGrowthRates γ).Nonempty := ⟨2, h_two⟩
    have h_inf_lt1 : sInf (ValidClassicalGrowthRates γ) < classicalGrowthRate γ + δ_cl / 2 := by
      change classicalGrowthRate γ < classicalGrowthRate γ + δ_cl / 2
      linarith
    obtain ⟨b₀, hb₀_mem, hb₀_lt⟩ := exists_lt_of_csInf_lt h_ne1 h_inf_lt1
    obtain ⟨ε₀', hε₀'_pos, hε₀'_lt, h_est⟩ :=
      hb₀_mem.2.2 4 K_hor' 1 (δ_cl / 2) (by norm_num) hK_ge1 zero_lt_one hK_ge1 (half_pos hδ)
    refine ⟨ε₀', hε₀'_pos, hε₀'_lt, ?_⟩
    intro ε' e' hε'₀ hε'_lt he'₀ he'_hi N_ω N_T π' T_idx V' A' c' θ'
      hπ'_nn hπ'_sum hVA' hcθ'
    have hε'_half : ε' < 1 / 2 := lt_trans hε'_lt hε₀'_lt
    set m_1 := dyadicTimeLevel ε' 1
    set Δ_time : ℝ := ((2 : ℝ) ^ m_1)⁻¹
    have h2m_pos : (0 : ℝ) < (2 : ℝ) ^ m_1 := by positivity
    have hX_gt2 : (2 : ℝ) < ε' ^ (-(1 : ℝ)) := by
      rw [Real.rpow_neg_one]
      have h_mul := mul_lt_mul_of_pos_right (by linarith : 2 * ε' < 1) (inv_pos.mpr hε'₀)
      rwa [mul_assoc, mul_inv_cancel₀ (ne_of_gt hε'₀), mul_one, one_mul] at h_mul
    have h2m_bounds : ε' ^ (-(1 : ℝ)) ≤ (2 : ℝ) ^ m_1 ∧
        (2 : ℝ) ^ m_1 ≤ 4 * ε' ^ (-(1 : ℝ)) := by
      have h1 : ε' ^ (-(1 : ℝ)) ≤ (⌈ε' ^ (-(1 : ℝ))⌉₊ : ℝ) := Nat.le_ceil _
      have h2_nat : ⌈ε' ^ (-(1 : ℝ))⌉₊ ≤ 2 ^ m_1 := Nat.le_pow_clog (by decide) _
      have h2 : (⌈ε' ^ (-(1 : ℝ))⌉₊ : ℝ) ≤ (2 : ℝ) ^ m_1 := by exact_mod_cast h2_nat
      refine ⟨le_trans h1 h2, ?_⟩
      have h_ceil_gt2 : (2 : ℝ) < (⌈ε' ^ (-(1 : ℝ))⌉₊ : ℝ) := lt_of_lt_of_le hX_gt2 h1
      have h_ceil_gt1_nat : 1 < ⌈ε' ^ (-(1 : ℝ))⌉₊ := by
        by_contra h_le1
        have h_cast : (⌈ε' ^ (-(1 : ℝ))⌉₊ : ℝ) ≤ 1 := by exact_mod_cast (Nat.le_of_not_lt h_le1)
        linarith
      have hm_pos : 0 < m_1 := by
        by_contra hm_z
        have hm0 : m_1 = 0 := by omega
        rw [hm0] at h2_nat
        omega
      have h_lt_clog : m_1 - 1 < Nat.clog 2 ⌈ε' ^ (-(1 : ℝ))⌉₊ := Nat.sub_lt hm_pos zero_lt_one
      have h_pow_lt_nat : 2 ^ (m_1 - 1) < ⌈ε' ^ (-(1 : ℝ))⌉₊ := Nat.pow_lt_of_lt_clog h_lt_clog
      have h_pow_lt : ((2 : ℝ) ^ (m_1 - 1)) < (⌈ε' ^ (-(1 : ℝ))⌉₊ : ℝ) := by
        exact_mod_cast h_pow_lt_nat
      have h_ceil_lt : (⌈ε' ^ (-(1 : ℝ))⌉₊ : ℝ) < ε' ^ (-(1 : ℝ)) + 1 :=
        Nat.ceil_lt_add_one (by linarith)
      have h_pow_eq : (2 : ℝ) ^ m_1 = 2 * (2 : ℝ) ^ (m_1 - 1) := by
        have hm_eq : m_1 = (m_1 - 1) + 1 := by omega
        conv_lhs => rw [hm_eq, pow_succ']
      linarith
    have h_inv_neg1 : (ε' ^ (-(1 : ℝ)))⁻¹ = ε' ^ (1 : ℝ) := by
      rw [← Real.rpow_neg hε'₀.le, neg_neg]
    have hΔ_lo : (4 : ℝ)⁻¹ * ε' ^ (1 : ℝ) ≤ Δ_time := by
      dsimp only [Δ_time]
      have h1 : (4 * ε' ^ (-(1 : ℝ)))⁻¹ ≤ ((2 : ℝ) ^ m_1)⁻¹ :=
        inv_anti₀ h2m_pos h2m_bounds.2
      rwa [mul_inv, h_inv_neg1] at h1
    have hΔ_hi : Δ_time ≤ 4 * ε' ^ (1 : ℝ) := by
      dsimp only [Δ_time]
      have hX_pos : 0 < ε' ^ (-(1 : ℝ)) := by linarith
      have h1 : ((2 : ℝ) ^ m_1)⁻¹ ≤ (ε' ^ (-(1 : ℝ)))⁻¹ :=
        inv_anti₀ hX_pos h2m_bounds.1
      rw [h_inv_neg1, Real.rpow_one] at h1
      rw [Real.rpow_one]
      linarith
    have h_real_err4 : ∀ (L_s z : ℝ),
        |z - ((dyadicRealBin ε' L_s z : ℝ) + 1 / 2) * dyadicRealStep ε' L_s| ≤
          4 * ε' ^ L_s := by
      intro L_s z
      set l := dyadicRealLevel ε' L_s
      have hs_pos : 0 < dyadicRealStep ε' L_s := by
        unfold dyadicRealStep; exact zpow_pos (by norm_num) (-l)
      set α := L_s * (Real.log (ε'⁻¹) / Real.log 2)
