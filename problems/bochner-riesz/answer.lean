      unfold finProbAt2
      have h_single := Finset.single_le_sum
        (f := fun ω' : Fin N_ω => if X ω' = X ω ∧ Y ω' = Y ω then μ ω' else (0 : ℝ))
        (fun ω' _ => by split_ifs; exact hμ_nn ω'; exact le_rfl) (Finset.mem_univ ω)
      rwa [if_pos ⟨rfl, rfl⟩] at h_single
    have h2 : finProbAt2 μ X Y ω ≤ finProbAt μ X ω := by
      unfold finProbAt2 finProbAt
      refine Finset.sum_le_sum (fun ω' _ => ?_)
      by_cases hX : X ω' = X ω
      · by_cases hY : Y ω' = Y ω
        · rw [if_pos ⟨hX, hY⟩, if_pos hX]
        · rw [if_neg (fun h => hY h.2), if_pos hX]
          exact hμ_nn ω'
      · rw [if_neg (fun h => hX h.1), if_neg hX]
    exact ⟨lt_of_lt_of_le hμ_pos h1, lt_of_lt_of_le hμ_pos (le_trans h1 h2)⟩
  have h_ent_congr : ∀ {α₁ β₁ α₂ β₂ : Type}
      (A₁ : Fin N_ω → α₁) (B₁ : Fin N_ω → β₁)
      (A₂ : Fin N_ω → α₂) (B₂ : Fin N_ω → β₂),
      (∀ ω₁ ω₂ : Fin N_ω, 0 < π ω₁ → 0 < π ω₂ →
        (A₁ ω₁ = A₁ ω₂ ↔ A₂ ω₁ = A₂ ω₂) ∧
        (A₁ ω₁ = A₁ ω₂ → (B₁ ω₁ = B₁ ω₂ ↔ B₂ ω₁ = B₂ ω₂))) →
      finCondEntropy ε π A₁ B₁ = finCondEntropy ε π A₂ B₂ := by
    intro α₁ β₁ α₂ β₂ A₁ B₁ A₂ B₂ h_eqv
    unfold finCondEntropy condSurprise
    refine Finset.sum_congr rfl (fun ω _ => ?_)
    rcases eq_or_lt_of_le (hπ_nn ω) with h0 | hpos
    · rw [← h0, zero_mul, zero_mul]
    · have hp1 : finProbAt π A₁ ω = finProbAt π A₂ ω := by
        unfold finProbAt
        refine Finset.sum_congr rfl (fun ω' _ => ?_)
        rcases eq_or_lt_of_le (hπ_nn ω') with h0' | hpos'
        · split_ifs <;> linarith
        · by_cases hA : A₁ ω' = A₁ ω
          · rw [if_pos hA, if_pos ((h_eqv ω' ω hpos' hpos).1.mp hA)]
          · rw [if_neg hA, if_neg (fun h2 => hA ((h_eqv ω' ω hpos' hpos).1.mpr h2))]
      have hp2 : finProbAt2 π A₁ B₁ ω = finProbAt2 π A₂ B₂ ω := by
        unfold finProbAt2
        refine Finset.sum_congr rfl (fun ω' _ => ?_)
        rcases eq_or_lt_of_le (hπ_nn ω') with h0' | hpos'
        · split_ifs <;> linarith
        · by_cases hAB : A₁ ω' = A₁ ω ∧ B₁ ω' = B₁ ω
          · have hA2 := (h_eqv ω' ω hpos' hpos).1.mp hAB.1
            have hB2 := (h_eqv ω' ω hpos' hpos).2 hAB.1 |>.mp hAB.2
            rw [if_pos hAB, if_pos ⟨hA2, hB2⟩]
          · have hAB2 : ¬ (A₂ ω' = A₂ ω ∧ B₂ ω' = B₂ ω) := by
              rintro ⟨hA2, hB2⟩
              have hA1 := (h_eqv ω' ω hpos' hpos).1.mpr hA2
              have hB1 := (h_eqv ω' ω hpos' hpos).2 hA1 |>.mpr hB2
              exact hAB ⟨hA1, hB1⟩
            rw [if_neg hAB, if_neg hAB2]
      rw [hp1, hp2]
  have h_ent_chain : ∀ {α β γ_t : Type}
      (A : Fin N_ω → α) (B : Fin N_ω → β) (C : Fin N_ω → γ_t),
      finCondEntropy ε π A B + finCondEntropy ε π (fun ω => (A ω, B ω)) C =
        finCondEntropy ε π A (fun ω => (B ω, C ω)) := by
    intro α β γ_t A B C
    unfold finCondEntropy condSurprise
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl (fun ω _ => ?_)
    rcases eq_or_lt_of_le (hπ_nn ω) with h0 | hpos
    · simp [← h0]
    · have hp_AB_eq : finProbAt π (fun ω' => (A ω', B ω')) ω = finProbAt2 π A B ω := by
        unfold finProbAt finProbAt2
        refine Finset.sum_congr rfl (fun ω' _ => ?_)
        by_cases h : A ω' = A ω ∧ B ω' = B ω
        · rw [if_pos (Prod.ext h.1 h.2), if_pos h]
        · rw [if_neg (fun hp => h (Prod.ext_iff.mp hp)), if_neg h]
      have hp_ABC_eq : finProbAt2 π (fun ω' => (A ω', B ω')) C ω =
          finProbAt2 π A (fun ω' => (B ω', C ω')) ω := by
        unfold finProbAt2
        refine Finset.sum_congr rfl (fun ω' _ => ?_)
        by_cases h : (A ω' = A ω ∧ B ω' = B ω) ∧ C ω' = C ω
        · rw [if_pos ⟨Prod.ext h.1.1 h.1.2, h.2⟩, if_pos ⟨h.1.1, Prod.ext h.1.2 h.2⟩]
        · have h1 : ¬ ((A ω', B ω') = (A ω, B ω) ∧ C ω' = C ω) :=
            fun hp => h ⟨Prod.ext_iff.mp hp.1, hp.2⟩
          have h2 : ¬ (A ω' = A ω ∧ (B ω', C ω') = (B ω, C ω)) :=
            fun hp => h ⟨⟨hp.1, (Prod.ext_iff.mp hp.2).1⟩, (Prod.ext_iff.mp hp.2).2⟩
          rw [if_neg h1, if_neg h2]
      rw [hp_AB_eq, hp_ABC_eq]
      obtain ⟨hp_AB_pos, hp_A_pos⟩ := h_prob_pos π A B ω hπ_nn hpos
      obtain ⟨hp_ABC_pos, _⟩ := h_prob_pos π A (fun ω' => (B ω', C ω')) ω hπ_nn hpos
      have h_mul_eq :
          (finProbAt2 π A B ω / finProbAt π A ω) *
            (finProbAt2 π A (fun ω' => (B ω', C ω')) ω / finProbAt2 π A B ω) =
          finProbAt2 π A (fun ω' => (B ω', C ω')) ω / finProbAt π A ω := by
        field_simp [ne_of_gt hp_A_pos, ne_of_gt hp_AB_pos]
      have h_log :
          Real.log (finProbAt2 π A B ω / finProbAt π A ω) +
            Real.log (finProbAt2 π A (fun ω' => (B ω', C ω')) ω / finProbAt2 π A B ω) =
          Real.log (finProbAt2 π A (fun ω' => (B ω', C ω')) ω / finProbAt π A ω) := by
        rw [← Real.log_mul (ne_of_gt (div_pos hp_AB_pos hp_A_pos))
          (ne_of_gt (div_pos hp_ABC_pos hp_AB_pos)), h_mul_eq]
      calc π ω * (-Real.log (finProbAt2 π A B ω / finProbAt π A ω) / Real.log (ε⁻¹)) +
            π ω * (-Real.log (finProbAt2 π A (fun ω' => (B ω', C ω')) ω / finProbAt2 π A B ω) /
              Real.log (ε⁻¹))
          = π ω * (-(Real.log (finProbAt2 π A B ω / finProbAt π A ω) +
              Real.log (finProbAt2 π A (fun ω' => (B ω', C ω')) ω / finProbAt2 π A B ω)) /
              Real.log (ε⁻¹)) := by ring
        _ = π ω * (-Real.log (finProbAt2 π A (fun ω' => (B ω', C ω')) ω / finProbAt π A ω) /
              Real.log (ε⁻¹)) := by rw [h_log]
  have h_cell_avg : ∀ {α β : Type} (X : Fin N_ω → α) (Y : Fin N_ω → β),
      (∑ j : Fin N_J, p_J j * finCondEntropy ε (π_J j) X Y) =
        finCondEntropy ε π (fun ω => (X ω, J ω)) Y := by
    intro α β X Y
    unfold finCondEntropy
    simp_rw [Finset.mul_sum]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun ω _ => ?_)
    rcases eq_or_lt_of_le (hπ_nn ω) with h0 | hpos
    · have h_zero_lhs : ∀ j : Fin N_J,
          p_J j * (π_J j ω * condSurprise ε (π_J j) X Y ω) = 0 := by
        intro j
        dsimp only [π_J]
        split_ifs <;> simp [← h0]
      simp [h_zero_lhs, ← h0]
    · let j₀ := J ω
      have hpj₀_pos : 0 < p_J j₀ := by
        have hle : π ω ≤ p_J j₀ := by
          dsimp only [p_J]
          have hs := Finset.single_le_sum
            (f := fun ω' : Fin N_ω => if J ω' = j₀ then π ω' else (0 : ℝ))
            (fun ω' _ => by split_ifs; exact hπ_nn ω'; exact le_rfl) (Finset.mem_univ ω)
          rwa [if_pos rfl] at hs
        exact lt_of_lt_of_le hpos hle
      have h_single : (∑ j : Fin N_J, p_J j * (π_J j ω * condSurprise ε (π_J j) X Y ω)) =
          p_J j₀ * (π_J j₀ ω * condSurprise ε (π_J j₀) X Y ω) := by
        refine Finset.sum_eq_single j₀ (fun j _ hj => ?_) (fun h => absurd (Finset.mem_univ j₀) h)
        dsimp only [π_J, j₀]
        rw [if_neg (Ne.symm hj)]
        ring
      rw [h_single]
      have h_wt : p_J j₀ * π_J j₀ ω = π ω := by
        dsimp only [π_J, j₀]
        rw [if_pos rfl, mul_div_cancel₀ _ (ne_of_gt hpj₀_pos)]
      have h_p1 : finProbAt (π_J j₀) X ω =
          finProbAt π (fun ω' => (X ω', J ω')) ω / p_J j₀ := by
        unfold finProbAt
        rw [Finset.sum_div]
        refine Finset.sum_congr rfl (fun ω' _ => ?_)
        dsimp only [π_J, j₀]
        by_cases hX : X ω' = X ω
        · by_cases hJ : J ω' = J ω
          · rw [if_pos hX, if_pos hJ, if_pos (Prod.ext hX hJ)]
          · rw [if_pos hX, if_neg hJ, if_neg (fun hp => hJ (Prod.ext_iff.mp hp).2), zero_div]
        · rw [if_neg hX, if_neg (fun hp => hX (Prod.ext_iff.mp hp).1), zero_div]
      have h_p2 : finProbAt2 (π_J j₀) X Y ω =
          finProbAt2 π (fun ω' => (X ω', J ω')) Y ω / p_J j₀ := by
        unfold finProbAt2
        rw [Finset.sum_div]
        refine Finset.sum_congr rfl (fun ω' _ => ?_)
        dsimp only [π_J, j₀]
        by_cases hXY : X ω' = X ω ∧ Y ω' = Y ω
        · by_cases hJ : J ω' = J ω
          · rw [if_pos hXY, if_pos hJ, if_pos ⟨Prod.ext hXY.1 hJ, hXY.2⟩]
          · rw [if_pos hXY, if_neg hJ,
              if_neg (fun hp => hJ (Prod.ext_iff.mp hp.1).2), zero_div]
        · rw [if_neg hXY,
            if_neg (fun hp => hXY ⟨(Prod.ext_iff.mp hp.1).1, hp.2⟩), zero_div]
      have h_surp : condSurprise ε (π_J j₀) X Y ω =
          condSurprise ε π (fun ω' => (X ω', J ω')) Y ω := by
        unfold condSurprise
        rw [h_p2, h_p1, div_div_div_cancel_right₀ (ne_of_gt hpj₀_pos)]
      rw [← mul_assoc, h_wt, h_surp]
  have h_transport_eq : ∀ (μ : Fin N_ω → ℝ) (k_time : Fin N_ω → ℤ),
      (∀ ω, 0 ≤ μ ω) → (∑ ω : Fin N_ω, μ ω = 1) →
      classicalTransportScore ε γ N_ω N_T N_G μ T_idx k_time G_idx
        (fun _ => 0) (fun _ => e_t) =
      (1 - γ) * e_t - finMutualInfo ε μ T_idx G_idx + 2 * finCondEntropy ε μ T_idx k_time := by
    intro μ k_time hμ_nn hμ_sum
    unfold classicalTransportScore
    let p_T : Fin N_T → ℝ := fun tid => ∑ ω : Fin N_ω, if T_idx ω = tid then μ ω else 0
    let p_G : Fin N_G → ℝ := fun g => ∑ ω : Fin N_ω, if G_idx ω = g then μ ω else 0
    let p_TG : Fin N_T → Fin N_G → ℝ := fun tid g =>
      ∑ ω : Fin N_ω, if T_idx ω = tid ∧ G_idx ω = g then μ ω else 0
    let S_cells : Finset ℤ := Finset.univ.image k_time
    let p_TC : Fin N_T → ℤ → ℝ := fun tid k =>
      ∑ ω : Fin N_ω, if T_idx ω = tid ∧ k_time ω = k then μ ω else 0
    have hp_G_sum : ∑ g : Fin N_G, p_G g = 1 := by
      dsimp only [p_G]
      rw [Finset.sum_comm, ← hμ_sum]
      exact Finset.sum_congr rfl (fun ω _ => by simp)
    have hEw : (∑ g : Fin N_G, p_G g * ((1 + γ) * 0 + (1 - γ) * e_t)) = (1 - γ) * e_t := by
      simp_rw [mul_zero, zero_add]
      rw [← Finset.sum_mul, hp_G_sum, one_mul]
    have hSt : (∑ tid : Fin N_T, ∑ k ∈ S_cells,
        -(p_TC tid k * Real.log (p_TC tid k / p_T tid))) / ell =
        finCondEntropy ε μ T_idx k_time := by
      have h_cell : ∀ (tid : Fin N_T) (k : ℤ),
          -(p_TC tid k * Real.log (p_TC tid k / p_T tid)) =
          ∑ ω : Fin N_ω, if T_idx ω = tid ∧ k_time ω = k then
            μ ω * (-Real.log (finProbAt2 μ T_idx k_time ω / finProbAt μ T_idx ω)) else 0 := by
        intro tid k
        have h_pull :
            -(p_TC tid k * Real.log (p_TC tid k / p_T tid)) =
            ∑ ω : Fin N_ω, if T_idx ω = tid ∧ k_time ω = k then
              μ ω * (-Real.log (p_TC tid k / p_T tid)) else 0 := by
          dsimp only [p_TC]
          have h1 : p_TC tid k * (-Real.log (p_TC tid k / p_T tid)) =
              -(p_TC tid k * Real.log (p_TC tid k / p_T tid)) := by ring
          rw [← h1]
          dsimp only [p_TC]
          rw [Finset.sum_mul]
          refine Finset.sum_congr rfl (fun ω _ => ?_)
          split_ifs <;> ring
        rw [h_pull]
        refine Finset.sum_congr rfl (fun ω _ => ?_)
        by_cases htk : T_idx ω = tid ∧ k_time ω = k
        · rw [if_pos htk, if_pos htk]
          have hp2_eq : finProbAt2 μ T_idx k_time ω = p_TC tid k := by
            unfold finProbAt2; dsimp only [p_TC]; rw [htk.1, htk.2]
            refine Finset.sum_congr rfl (fun ω' _ => ?_)
            by_cases h' : T_idx ω' = tid ∧ k_time ω' = k
            · rw [if_pos h', if_pos h']
            · rw [if_neg h', if_neg h']
          have hp1_eq : finProbAt μ T_idx ω = p_T tid := by
            unfold finProbAt; dsimp only [p_T]; rw [htk.1]
            refine Finset.sum_congr rfl (fun ω' _ => ?_)
            by_cases h' : T_idx ω' = tid
            · rw [if_pos h', if_pos h']
            · rw [if_neg h', if_neg h']
          rw [hp2_eq, hp1_eq]
        · rw [if_neg htk, if_neg htk]
      simp_rw [h_cell]
      have h_swap1 : (∑ tid : Fin N_T, ∑ k ∈ S_cells, ∑ ω : Fin N_ω,
          if T_idx ω = tid ∧ k_time ω = k then
            μ ω * (-Real.log (finProbAt2 μ T_idx k_time ω / finProbAt μ T_idx ω)) else 0) =
          ∑ ω : Fin N_ω, ∑ tid : Fin N_T, ∑ k ∈ S_cells,
            if T_idx ω = tid ∧ k_time ω = k then
              μ ω * (-Real.log (finProbAt2 μ T_idx k_time ω / finProbAt μ T_idx ω)) else 0 := by
        trans (∑ tid : Fin N_T, ∑ ω : Fin N_ω, ∑ k ∈ S_cells,
          if T_idx ω = tid ∧ k_time ω = k then
            μ ω * (-Real.log (finProbAt2 μ T_idx k_time ω / finProbAt μ T_idx ω)) else 0)
        · exact Finset.sum_congr rfl (fun _ _ => Finset.sum_comm)
        · exact Finset.sum_comm
      rw [h_swap1, Finset.sum_div]
      unfold finCondEntropy condSurprise
      refine Finset.sum_congr rfl (fun ω _ => ?_)
      have hmem : k_time ω ∈ S_cells := Finset.mem_image_of_mem k_time (Finset.mem_univ ω)
      have h_in1 : (∑ tid : Fin N_T, ∑ k ∈ S_cells,
          if T_idx ω = tid ∧ k_time ω = k then
            μ ω * (-Real.log (finProbAt2 μ T_idx k_time ω / finProbAt μ T_idx ω)) else 0) =
          μ ω * (-Real.log (finProbAt2 μ T_idx k_time ω / finProbAt μ T_idx ω)) := by
        rw [Finset.sum_eq_single (T_idx ω)]
        · rw [Finset.sum_eq_single (k_time ω)]
          · rw [if_pos ⟨rfl, rfl⟩]
          · intro k _ hk; rw [if_neg (fun h => hk h.2.symm)]
          · intro hk; exact absurd hmem hk
        · intro tid _ htid
          exact Finset.sum_eq_zero (fun k _ => if_neg (fun h => htid h.1.symm))
        · intro h; exact absurd (Finset.mem_univ (T_idx ω)) h
      rw [h_in1]
      dsimp only [ell]
      ring
    have hItg : (∑ tid : Fin N_T, ∑ g : Fin N_G,
        p_TG tid g * Real.log (p_TG tid g / (p_T tid * p_G g))) / ell =
        finMutualInfo ε μ T_idx G_idx := by
      have h_cell : ∀ (tid : Fin N_T) (g : Fin N_G),
          p_TG tid g * Real.log (p_TG tid g / (p_T tid * p_G g)) =
          ∑ ω : Fin N_ω, if T_idx ω = tid ∧ G_idx ω = g then
            μ ω * (-Real.log (finProbAt2 μ (fun _ => ()) G_idx ω /
                finProbAt μ (fun _ => ()) ω) -
              (-Real.log (finProbAt2 μ T_idx G_idx ω / finProbAt μ T_idx ω))) else 0 := by
        intro tid g
        have h_pull : p_TG tid g * Real.log (p_TG tid g / (p_T tid * p_G g)) =
            ∑ ω : Fin N_ω, if T_idx ω = tid ∧ G_idx ω = g then
              μ ω * Real.log (p_TG tid g / (p_T tid * p_G g)) else 0 := by
          dsimp only [p_TG]
          rw [Finset.sum_mul]
          refine Finset.sum_congr rfl (fun ω _ => ?_)
          split_ifs <;> ring
        rw [h_pull]
        refine Finset.sum_congr rfl (fun ω _ => ?_)
        by_cases htg : T_idx ω = tid ∧ G_idx ω = g
        · rw [if_pos htg, if_pos htg]
          rcases eq_or_lt_of_le (hμ_nn ω) with h0 | hpos
          · simp [← h0]
          · have hp_TG_eq : finProbAt2 μ T_idx G_idx ω = p_TG tid g := by
              unfold finProbAt2; dsimp only [p_TG]; rw [htg.1, htg.2]
              refine Finset.sum_congr rfl (fun ω' _ => ?_)
              by_cases h' : T_idx ω' = tid ∧ G_idx ω' = g
              · rw [if_pos h', if_pos h']
              · rw [if_neg h', if_neg h']
            have hp_T_eq : finProbAt μ T_idx ω = p_T tid := by
              unfold finProbAt; dsimp only [p_T]; rw [htg.1]
              refine Finset.sum_congr rfl (fun ω' _ => ?_)
              by_cases h' : T_idx ω' = tid
              · rw [if_pos h', if_pos h']
              · rw [if_neg h', if_neg h']
            have hp_G_eq : finProbAt2 μ (fun _ => ()) G_idx ω = p_G g := by
              unfold finProbAt2; dsimp only [p_G]; rw [htg.2]
              refine Finset.sum_congr rfl (fun ω' _ => ?_)
              by_cases h' : G_idx ω' = g
              · rw [if_pos ⟨rfl, h'⟩, if_pos h']
              · rw [if_neg (fun hp => h' hp.2), if_neg h']
            have hp_1_eq : finProbAt μ (fun _ => ()) ω = 1 := by
              unfold finProbAt
              simp [hμ_sum]
            rw [hp_TG_eq, hp_T_eq, hp_G_eq, hp_1_eq, div_one]
            obtain ⟨hp_TG_pos, hp_T_pos⟩ := h_prob_pos μ T_idx G_idx ω hμ_nn hpos
            obtain ⟨hp_G_pos, _⟩ := h_prob_pos μ (fun _ => ()) G_idx ω hμ_nn hpos
            rw [hp_TG_eq] at hp_TG_pos
            rw [hp_T_eq] at hp_T_pos
            rw [hp_G_eq] at hp_G_pos
            have h_div_eq : p_TG tid g / (p_T tid * p_G g) =
                (p_TG tid g / p_T tid) / p_G g := by
              rw [div_div]
            rw [h_div_eq, Real.log_div (ne_of_gt (div_pos hp_TG_pos hp_T_pos)) (ne_of_gt hp_G_pos)]
            ring
        · rw [if_neg htg, if_neg htg]
      simp_rw [h_cell]
      have h_swap1 : (∑ tid : Fin N_T, ∑ g : Fin N_G, ∑ ω : Fin N_ω,
          if T_idx ω = tid ∧ G_idx ω = g then
            μ ω * (-Real.log (finProbAt2 μ (fun _ => ()) G_idx ω /
                finProbAt μ (fun _ => ()) ω) -
              (-Real.log (finProbAt2 μ T_idx G_idx ω / finProbAt μ T_idx ω))) else 0) =
          ∑ ω : Fin N_ω, ∑ tid : Fin N_T, ∑ g : Fin N_G,
            if T_idx ω = tid ∧ G_idx ω = g then
              μ ω * (-Real.log (finProbAt2 μ (fun _ => ()) G_idx ω /
                  finProbAt μ (fun _ => ()) ω) -
                (-Real.log (finProbAt2 μ T_idx G_idx ω / finProbAt μ T_idx ω))) else 0 := by
        trans (∑ tid : Fin N_T, ∑ ω : Fin N_ω, ∑ g : Fin N_G,
          if T_idx ω = tid ∧ G_idx ω = g then
            μ ω * (-Real.log (finProbAt2 μ (fun _ => ()) G_idx ω /
                finProbAt μ (fun _ => ()) ω) -
              (-Real.log (finProbAt2 μ T_idx G_idx ω / finProbAt μ T_idx ω))) else 0)
        · exact Finset.sum_congr rfl (fun _ _ => Finset.sum_comm)
        · exact Finset.sum_comm
      rw [h_swap1, Finset.sum_div]
      unfold finMutualInfo finCondEntropy condSurprise
      rw [← Finset.sum_sub_distrib]
      refine Finset.sum_congr rfl (fun ω _ => ?_)
      have h_in1 : (∑ tid : Fin N_T, ∑ g : Fin N_G,
          if T_idx ω = tid ∧ G_idx ω = g then
            μ ω * (-Real.log (finProbAt2 μ (fun _ => ()) G_idx ω /
                finProbAt μ (fun _ => ()) ω) -
              (-Real.log (finProbAt2 μ T_idx G_idx ω / finProbAt μ T_idx ω))) else 0) =
          μ ω * (-Real.log (finProbAt2 μ (fun _ => ()) G_idx ω /
              finProbAt μ (fun _ => ()) ω) -
            (-Real.log (finProbAt2 μ T_idx G_idx ω / finProbAt μ T_idx ω))) := by
        rw [Finset.sum_eq_single (T_idx ω)]
        · rw [Finset.sum_eq_single (G_idx ω)]
