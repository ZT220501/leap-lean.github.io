    have hv_cd : ∀ k : ℕ, ContDiff ℝ k v_seg := fun k =>
      contDiff_const.add (contDiff_id.smul contDiff_const)
    let F : ℝ × ℝ → ℝ := fun p => ε_sgn * (lam_loc * Φ₀ (c_end, x_line p.1, v_seg p.2))
    have hF_cd : ∀ k : ℕ, ContDiff ℝ k F := fun k =>
      contDiff_const.mul (contDiff_const.mul ((hΦ_cd k).comp
        (contDiff_const.prodMk (((hx_cd k).comp contDiff_fst).prodMk ((hv_cd k).comp contDiff_snd)))))
    let Θ : ℝ → ℝ := fun y =>
      lam_loc * (Φ₀ (c_end, x_line y, v) - Φ₀ (c_end, x_line y, v'))
    let θ_pos : ℝ → ℝ := fun y => ε_sgn * Θ y
    have hθ_eq_F : ∀ y : ℝ, θ_pos y = F (y, 1) - F (y, 0) := by
      intro y
      dsimp only [θ_pos, Θ, F, v_seg, δ]
      have hv1 : v' + (1 : ℝ) • (v - v') = v := by rw [one_smul]; abel
      have hv0 : v' + (0 : ℝ) • (v - v') = v' := by simp
      rw [hv1, hv0]
      ring
    have hθ_cd : ∀ k : ℕ, ContDiff ℝ k θ_pos := fun k => by
      have h_fn : θ_pos = (fun y => F (y, 1)) - (fun y => F (y, 0)) := funext hθ_eq_F
      rw [h_fn]
      exact ((hF_cd k).comp (contDiff_id.prodMk contDiff_const)).sub
        ((hF_cd k).comp (contDiff_id.prodMk contDiff_const))
    have h_clairaut_gen : ∀ (E_fn : ℝ × ℝ → ℝ), (∀ k : ℕ, ContDiff ℝ k E_fn) →
        let E₁ : ℝ × ℝ → ℝ := fun p => deriv (fun y' => E_fn (y', p.2)) p.1
        (∀ k : ℕ, ContDiff ℝ k E₁) ∧
        ∀ (y τ : ℝ), HasDerivAt (fun τ' => E₁ (y, τ'))
          (deriv (fun y' => deriv (fun τ'' => E_fn (y', τ'')) τ) y) τ := by
      intro E_fn hE
      dsimp only
      let E₁ : ℝ × ℝ → ℝ := fun p => deriv (fun y' => E_fn (y', p.2)) p.1
      have h_part1 : ∀ p : ℝ × ℝ, E₁ p = fderiv ℝ E_fn p (1, 0) := by
