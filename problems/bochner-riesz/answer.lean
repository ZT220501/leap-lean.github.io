          have hc : |(q.2.2 : ℝ)| ≤ ‖u‖ + 1 / 2 := abs_le.mpr ⟨by linarith, by linarith⟩
          have hun : 0 ≤ ‖u‖ := norm_nonneg u
          linarith
        have hd0_pos : 0 < (1 + |(q.2.1 : ℝ)|) ^ 2 := by positivity
        have hd1_pos : 0 < (1 + |(q.2.2 : ℝ)|) ^ 2 := by positivity
        have h_prod_den : (1 + |(q.2.1 : ℝ)|) ^ 2 * (1 + |(q.2.2 : ℝ)|) ^ 2 ≤
            16 * (1 + σ₀⁻¹ * ‖X α - X β‖) ^ 4 := by
          have hsq0 : (1 + |(q.2.1 : ℝ)|) ^ 2 ≤ (2 * (1 + ‖u‖)) ^ 2 :=
            pow_le_pow_left₀ (by positivity) hm0_le 2
          have hsq1 : (1 + |(q.2.2 : ℝ)|) ^ 2 ≤ (2 * (1 + ‖u‖)) ^ 2 :=
            pow_le_pow_left₀ (by positivity) hm1_le 2
          have hmul := mul_le_mul hsq0 hsq1 hd1_pos.le (by positivity)
          rw [hu_norm] at hmul
          calc (1 + |(q.2.1 : ℝ)|) ^ 2 * (1 + |(q.2.2 : ℝ)|) ^ 2
              ≤ (2 * (1 + σ₀⁻¹ * ‖X α - X β‖)) ^ 2 * (2 * (1 + σ₀⁻¹ * ‖X α - X β‖)) ^ 2 := hmul
            _ = 16 * (1 + σ₀⁻¹ * ‖X α - X β‖) ^ 4 := by ring
        have h_u4_pos : 0 < (1 + σ₀⁻¹ * ‖X α - X β‖) ^ 4 := by positivity
        calc K_gram α β
            ≤ C_pair / (1 + σ₀⁻¹ * ‖X α - X β‖) ^ 4 := hφ_gram_decay α β
          _ = (16 * C_pair) / (16 * (1 + σ₀⁻¹ * ‖X α - X β‖) ^ 4) := by
              field_simp
          _ ≤ (16 * C_pair) / ((1 + |(q.2.1 : ℝ)|) ^ 2 * (1 + |(q.2.2 : ℝ)|) ^ 2) :=
              div_le_div_of_nonneg_left (by positivity) (mul_pos hd0_pos hd1_pos) h_prod_den
          _ = w_q := by
