    · refine Or.inr ⟨L_grid, τ_Vf, τ_Xf, P_f, n_f, W_f, hL1, hL4, hnf, hgeom, hal, ?_, hHle⟩
      intro o d hq_od
      have hps := hp_supp o d (hsupp_q o d hq_od).1
      exact ⟨hps.2.2.2.2.1, hps.2.2.2.2.2.1⟩

