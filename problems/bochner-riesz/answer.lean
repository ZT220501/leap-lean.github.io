      intro i hi u hu
      have hi_abs : |i| ≤ K + 1 := abs_le.mpr hi
      have hs := h_signs i u hi_abs hu
      have h_sym_sum :
          (∑ j : Fin n, ∑ k : Fin n, q j * (c k - c j) * (-F_LL k j (i, u))) =
