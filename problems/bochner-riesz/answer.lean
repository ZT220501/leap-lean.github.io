        rw [sq_abs, sq_abs, hd_sq] at h_id
        nlinarith [sq_nonneg (|d 0| - |d 1|)]
      refine ⟨hd_sq, h_l1, fun e₀ e₁ B hB he₀ he₁ => ⟨?_, ?_⟩⟩
      · calc |d 0 * e₀ + d 1 * e₁|
            ≤ |d 0 * e₀| + |d 1 * e₁| := abs_add_le _ _
          _ = |d 0| * |e₀| + |d 1| * |e₁| := by rw [abs_mul, abs_mul]
          _ ≤ |d 0| * B + |d 1| * B :=
              add_le_add (mul_le_mul_of_nonneg_left he₀ (abs_nonneg _))
                (mul_le_mul_of_nonneg_left he₁ (abs_nonneg _))
