          _ = ρ ^ (-κ + -ω + -κ + s * ϑ) := by
              rw [← Real.rpow_add hρ_pos, ← Real.rpow_add hρ_pos, ← Real.rpow_add hρ_pos]
          _ ≤ ρ ^ (s * ϑ / 2) :=
              Real.rpow_le_rpow_of_exponent_ge hρ_pos hρ_lt1.le (by linarith only [hn_sep1])
      exact lt_of_le_of_lt (le_trans h_sum_le h_pow_le) hn_sep2
    have h_exists_pair : ∃ b₀ b₁ : Fin NΘ,
        0 < R01 b₀ b₁ ∧
        (1 / 8 : ℝ) * (lam b₀ * lam b₁) ≤ R01 b₀ b₁ ∧
        (1 / 8 : ℝ) * P01 b₀ b₁ ≤ R01 b₀ b₁ ∧
        ρ ^ ϑ ≤ ‖paramVec blk l b₁ - paramVec blk l b₀‖ ∧
        (1 / 2 : ℝ) * R01 b₀ b₁ ≤ S_good b₀ b₁ := by
      by_contra h_no_good
      have h_pt_bad : ∀ b₀ b₁ : Fin NΘ,
          R01 b₀ b₁ ≤
            (1 / 8 : ℝ) * (lam b₀ * lam b₁) +
            (1 / 8 : ℝ) * P01 b₀ b₁ +
            (if ‖paramVec blk l b₁ - paramVec blk l b₀‖ < ρ ^ ϑ then R01 b₀ b₁ else 0) +
            2 * S_bad b₀ b₁ := by
        intro b₀ b₁
        have ht1_nn : 0 ≤ (1 / 8 : ℝ) * (lam b₀ * lam b₁) :=
          mul_nonneg (by norm_num) (mul_nonneg (hlam_nn b₀) (hlam_nn b₁))
        have ht2_nn : 0 ≤ (1 / 8 : ℝ) * P01 b₀ b₁ :=
          mul_nonneg (by norm_num) (hP01_nn b₀ b₁)
        have ht3_nn : 0 ≤ (if ‖paramVec blk l b₁ - paramVec blk l b₀‖ < ρ ^ ϑ
            then R01 b₀ b₁ else 0) := by
          split_ifs; exact hR01_nn b₀ b₁; exact le_rfl
        have ht4_nn : 0 ≤ 2 * S_bad b₀ b₁ := mul_nonneg zero_le_two (hS_bad_nn b₀ b₁)
        by_cases hc0 : 0 < R01 b₀ b₁
        · by_cases hc1 : (1 / 8 : ℝ) * (lam b₀ * lam b₁) ≤ R01 b₀ b₁
          · by_cases hc2 : (1 / 8 : ℝ) * P01 b₀ b₁ ≤ R01 b₀ b₁
            · by_cases hc3 : ρ ^ ϑ ≤ ‖paramVec blk l b₁ - paramVec blk l b₀‖
              · by_cases hc4 : (1 / 2 : ℝ) * R01 b₀ b₁ ≤ S_good b₀ b₁
                · exact absurd ⟨b₀, b₁, hc0, hc1, hc2, hc3, hc4⟩ h_no_good
                · have h_lt4 : S_good b₀ b₁ < (1 / 2 : ℝ) * R01 b₀ b₁ := lt_of_not_ge hc4
                  have h_sp := hS_split b₀ b₁
                  linarith only [ht1_nn, ht2_nn, ht3_nn, h_lt4, h_sp]
              · have h_lt3 : ‖paramVec blk l b₁ - paramVec blk l b₀‖ < ρ ^ ϑ := lt_of_not_ge hc3
                rw [if_pos h_lt3]
                linarith only [ht1_nn, ht2_nn, ht4_nn]
            · have h_lt2 := lt_of_not_ge hc2
              linarith only [ht1_nn, ht3_nn, ht4_nn, h_lt2]
          · have h_lt1 := lt_of_not_ge hc1
            linarith only [ht2_nn, ht3_nn, ht4_nn, h_lt1]
        · have h0 : R01 b₀ b₁ = 0 := le_antisymm (le_of_not_gt hc0) (hR01_nn b₀ b₁)
          linarith only [h0, ht1_nn, ht2_nn, ht3_nn, ht4_nn]
      have h_s1 : (∑ b₀, ∑ b₁, (1 / 8 : ℝ) * (lam b₀ * lam b₁)) = 1 / 8 := by
        have h_in : ∀ b₀, (∑ b₁, (1 / 8 : ℝ) * (lam b₀ * lam b₁)) = (1 / 8 : ℝ) * lam b₀ := by
          intro b₀
          calc ∑ b₁, (1 / 8 : ℝ) * (lam b₀ * lam b₁)
              = ∑ b₁, ((1 / 8 : ℝ) * lam b₀) * lam b₁ :=
                Finset.sum_congr rfl (fun _ _ => by ring)
            _ = ((1 / 8 : ℝ) * lam b₀) * ∑ b₁, lam b₁ := (Finset.mul_sum _ _ _).symm
            _ = (1 / 8 : ℝ) * lam b₀ := by rw [hlam_sum, mul_one]
        simp_rw [h_in, ← Finset.mul_sum, hlam_sum, mul_one]
      have h_s2 : (∑ b₀, ∑ b₁, (1 / 8 : ℝ) * P01 b₀ b₁) = 1 / 8 := by
        simp_rw [← Finset.mul_sum]
        rw [hP01_tot', mul_one]
      have h_s4 : (∑ b₀, ∑ b₁, 2 * S_bad b₀ b₁) ≤ 1 / 4 := by
        simp_rw [← Finset.mul_sum]
        linarith only [hS_bad_tot]
      have h_tot_le : (∑ b₀, ∑ b₁, R01 b₀ b₁) ≤
          (∑ b₀, ∑ b₁, (1 / 8 : ℝ) * (lam b₀ * lam b₁)) +
          (∑ b₀, ∑ b₁, (1 / 8 : ℝ) * P01 b₀ b₁) +
          (∑ b₀, ∑ b₁,
            if ‖paramVec blk l b₁ - paramVec blk l b₀‖ < ρ ^ ϑ then R01 b₀ b₁ else 0) +
          (∑ b₀, ∑ b₁, 2 * S_bad b₀ b₁) := by
        calc ∑ b₀, ∑ b₁, R01 b₀ b₁
            ≤ ∑ b₀, ∑ b₁,
                ((1 / 8 : ℝ) * (lam b₀ * lam b₁) +
                 (1 / 8 : ℝ) * P01 b₀ b₁ +
                 (if ‖paramVec blk l b₁ - paramVec blk l b₀‖ < ρ ^ ϑ then R01 b₀ b₁ else 0) +
                 2 * S_bad b₀ b₁) :=
              Finset.sum_le_sum (fun b₀ _ => Finset.sum_le_sum (fun b₁ _ => h_pt_bad b₀ b₁))
          _ = _ := by
              simp only [Finset.sum_add_distrib]
              rfl
      linarith only [hR01_sum, h_tot_le, h_s1, h_s2, h_sep_bad, h_s4]
    obtain ⟨b₀, b₁, hR01_pos, hR01_lam, hR01_P01, h_sep, hS_good_lb⟩ := h_exists_pair
