          linarith
      refine le_of_forall_pos_le_add (fun δ hδ => ?_)
      have h_cand : ∀ z : Fin M_Z,
          ∃ cand : (N_D : ℕ) × (Fin N_D → ℝ) × (Fin N_D → ℝ) ×
              (Fin N_D → EuclideanSpace ℝ (Fin 2)) ×
              (Fin N_D → EuclideanSpace ℝ (Fin 2)) ×
              (Fin N_D → EuclideanSpace ℝ (Fin 2)) ×
              (Fin N_T → Fin N_D → ℝ),
            let N_D := cand.1
            let b_D := cand.2.1
            let a_D := cand.2.2.1
            let e_D := cand.2.2.2.1
            let V_D := cand.2.2.2.2.1
            let A_D := cand.2.2.2.2.2.1
            let q := cand.2.2.2.2.2.2
