          change Real.cos φ * Real.cos φ + Real.sin φ * Real.sin φ = 1
          linear_combination h_cs
        · simp only [ed, ed_fn, angUnitVec, perp2D, EuclideanSpace.inner_eq_star_dotProduct,
            dotProduct, Fin.sum_univ_two, star_trivial]
          simp only [Fin.isValue, ↓reduceIte, Fin.one_eq_zero_iff, Matrix.cons_val_zero,
            Matrix.cons_val_one]
