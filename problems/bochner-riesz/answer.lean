theorem tied_y_homog_and_capacity_filter {N_P N_Θ : ℕ} (s σ ρ κ₁ : ℝ) (a_pt : Fin 3 → ℝ) (M : ℕ)
    (hρ : 0 < ρ ∧ ρ < 1 / 2) (hM : 2 ≤ M)
    (hκ₁ : 0 < κ₁) (hκ₁_le : κ₁ ≤ 1 / 32)
    (hJ_bound : ((3 * (M : ℝ) + 10) ^ M) * (64 * ((M : ℝ) + 2) ^ 2) ≤ ρ ^ (-κ₁))
    (π₁ : Fin N_P → Fin N_Θ → ℝ)
    (P : Fin N_P → Fin 4 → ℝ)
    (θ : Fin N_Θ → ℝ × ℝ)
    (hπ₁_nn : ∀ i b, 0 ≤ π₁ i b)
    (hπ₁_sum : (∑ i : Fin N_P, ∑ b : Fin N_Θ, π₁ i b) = 1)
    (hP_dom : ∀ i j, |P i j| ≤ 4)
    (hθ_dom : ∀ b, |(θ b).1| ≤ 4 ∧ |(θ b).2| ≤ 4)
    (h_pair₁ : ∀ i b, π₁ i b ≤ ρ ^ (-κ₁) * (∑ b', π₁ i b') * (∑ i', π₁ i' b))
    (h_coord₁ : ∀ b, 0 < (∑ i, π₁ i b) → ∀ q : Fin 3 → ℤ × ℤ,
      letI := Classical.propDecidable
      let lam_b := ∑ i, π₁ i b
      (∑ i : Fin N_P,
        if (∀ g, canonicalGroupBinsTied ρ (P i) (θ b) g = q g)
        then π₁ i b / lam_b else 0) ≤
      ρ ^ (-κ₁) * ∏ g : Fin 3,
        (∑ i : Fin N_P,
          if canonicalGroupBinsTied ρ (P i) (θ b) g = q g
          then π₁ i b / lam_b else 0))
    (h_U_supp₁ : ∀ b, 0 < (∑ i, π₁ i b) →
      letI := Classical.propDecidable
      (((Finset.univ.filter (fun i : Fin N_P => 0 < π₁ i b)).image
        (fun i => canonicalGroupBinsTied ρ (P i) (θ b) 1)).card : ℝ) ≤
        ρ ^ (-a_pt 1 - κ₁))
    (h_time₁ : ∀ (r_idx : ℕ), 1 ≤ r_idx → r_idx ≤ M → ∀ q : ℤ,
      letI := Classical.propDecidable
      let d := (r_idx : ℝ) / (M : ℝ)
      (∑ b : Fin N_Θ, if dyadicRealBin ρ d (θ b).1 = q then (∑ i, π₁ i b) else 0) ≤
        ρ ^ (s * d - κ₁))
    (h_norm₁ : ∀ (r_idx : ℕ), 1 ≤ r_idx → r_idx ≤ M → ∀ q : ℤ,
      letI := Classical.propDecidable
