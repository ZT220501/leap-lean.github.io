        (fun _ => Classical.propDecidable _) S_P2
      let I_v2 := E_v2.image (fun p => ⌊(x_pt2 p - c_pt2 p * v_bar2 v) / ρ₂⌋)
      refine ⟨I_v2, ?_, fun p hp hq => Finset.mem_image_of_mem _
