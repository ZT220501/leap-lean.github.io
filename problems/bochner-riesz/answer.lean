    have hRHS_cont : Continuous RHS_fn := continuous_finsetSum _ fun j _ => hRHS_term_cont j
    have h_pt_ineq : ∀ i ∈ Set.Icc (-(K + 1)) (K + 1), ∀ u ∈ Set.Icc (δ / 2) (1 - δ / 2),
