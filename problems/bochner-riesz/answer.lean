        have h_diff : DifferentiableAt ℝ E_fn (y', τ') :=
          ((hE 1).differentiable (by simp)).differentiableAt
        exact (h_diff.hasFDerivAt.comp_hasDerivAt τ' h_line).deriv
      let ev10 : (ℝ × ℝ →L[ℝ] ℝ) →L[ℝ] ℝ := ContinuousLinearMap.apply ℝ ℝ (1, 0)
      let ev01 : (ℝ × ℝ →L[ℝ] ℝ) →L[ℝ] ℝ := ContinuousLinearMap.apply ℝ ℝ (0, 1)
      have hE₁_eq : E₁ = fun p => ev10 (fderiv ℝ E_fn p) := funext h_part1
      have hE₁_cd : ∀ k : ℕ, ContDiff ℝ k E₁ := fun k => by
