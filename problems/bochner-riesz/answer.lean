    have h_HOD_sum : ∑ o : Fin N_O, ∑ d : Fin N_D, -(p o d * Real.log (p o d / p_D d)) ≤
        Real.log (M_split : ℝ) +
          ∑ s : Fin M_split, α s *
            (∑ o : Fin N_O, ∑ d : Fin N_D, -(p_cd s o d * Real.log (p_cd s o d / p_cd_D s d))) := by
      have h1 : ∑ o : Fin N_O, ∑ d : Fin N_D, -(p o d * Real.log (p o d / p_D d)) =
          ∑ o : Fin N_O, ∑ d : Fin N_D, ∑ s : Fin M_split,
            -(q s o d * Real.log (p o d / p_D d)) := by
        refine Finset.sum_congr rfl (fun o _ => Finset.sum_congr rfl (fun d _ => ?_))
        rw [Finset.sum_neg_distrib, ← Finset.sum_mul, hq_sum_s o d]
      have h2' : ∑ o : Fin N_O, ∑ d : Fin N_D, ∑ s : Fin M_split,
            α s * (-(p_cd s o d * Real.log (p_cd s o d / p_cd_D s d))) =
          ∑ s : Fin M_split, α s *
            (∑ o : Fin N_O, ∑ d : Fin N_D, -(p_cd s o d * Real.log (p_cd s o d / p_cd_D s d))) := by
        calc ∑ o : Fin N_O, ∑ d : Fin N_D, ∑ s : Fin M_split,
              α s * (-(p_cd s o d * Real.log (p_cd s o d / p_cd_D s d)))
            = ∑ o : Fin N_O, ∑ s : Fin M_split, ∑ d : Fin N_D,
              α s * (-(p_cd s o d * Real.log (p_cd s o d / p_cd_D s d))) :=
              Finset.sum_congr rfl (fun _ _ => Finset.sum_comm)
          _ = ∑ s : Fin M_split, ∑ o : Fin N_O, ∑ d : Fin N_D,
              α s * (-(p_cd s o d * Real.log (p_cd s o d / p_cd_D s d))) := Finset.sum_comm
          _ = ∑ s : Fin M_split, α s *
              (∑ o : Fin N_O, ∑ d : Fin N_D, -(p_cd s o d * Real.log (p_cd s o d / p_cd_D s d))) := by
              refine Finset.sum_congr rfl (fun s _ => ?_)
              rw [Finset.mul_sum]
              exact Finset.sum_congr rfl (fun o _ => (Finset.mul_sum _ _ _).symm)
      have h2_clean : ∑ o : Fin N_O, ∑ d : Fin N_D, ∑ s : Fin M_split,
