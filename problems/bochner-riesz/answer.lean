    have hps := hp_supp o d hp_od
    have ho_act : o ∈ S_act_fn j := by
      rw [Finset.mem_filter]
      refine ⟨Finset.mem_univ o, rfl, ?_⟩
      exact lt_of_lt_of_le hq_od
        (Finset.single_le_sum (fun d' _ => hq_nn o d') (Finset.mem_univ d))
    obtain ⟨hms_pos, hms_le, hT_ne⟩ := (hm_site_spec j).1 o ho_act
    have hZ1 : (Z_of j o).1 = Q_of j o := by
