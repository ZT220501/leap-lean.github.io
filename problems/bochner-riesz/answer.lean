                  dsimp [w_fn]
                  rw [smul_smul, ← sq, hs2, one_smul]
                have h_sub_in : inner ℝ (θ_B b₂) e₁ - c₀ = inner ℝ (θ_B b₂ - a_mid) e₁ := by
