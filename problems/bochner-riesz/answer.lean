      have h_log_add : (Real.log (K_amb : ℝ) + Real.log (M_sub : ℝ)) / ell =
          Real.log (K_amb : ℝ) / ell + Real.log (M_sub : ℝ) / ell := add_div _ _ _
      linarith [h_expand_Φ, h_time_ent, h_mi_total, h_root_glue, h_log_add]
    obtain ⟨j_star, hj_star_mem, hj_star_max⟩ := Finset.exists_max_image S_J Φ hSJ_ne
    have h_avg_le_max : ∑ j ∈ S_J, p_J_fn j * Φ j ≤ Φ j_star := by
      calc ∑ j ∈ S_J, p_J_fn j * Φ j
          ≤ ∑ j ∈ S_J, p_J_fn j * Φ j_star :=
            Finset.sum_le_sum (fun j hj =>
