            dsimp [planeEmbed]
            ring
          rw [heq, abs_mul, abs_mul, abs_of_pos hh]
        have h_sum_t : (∑ k : Fin n, |(planeEmbed n c iu + h • (p + t₁ • e + w)).1 k -
