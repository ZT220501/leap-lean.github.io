            rw [h_div, Nat.cast_one, div_le_one hσ_pos]; exact hc0.trans hX_le
          · refine h_int_mem_icc kx1 (x₀ 1 / σ_r) 1 ?_
            have hc1 := PiLp.norm_apply_le (gridPt2D σ_r (kx0, kx1) - x₀) 1
            simp only [Real.norm_eq_abs] at hc1
            have h_c : (gridPt2D σ_r (kx0, kx1) - x₀) 1 = σ_r * (kx1 : ℝ) - x₀ 1 := rfl
            rw [h_c] at hc1
            have h_div : |(kx1 : ℝ) - x₀ 1 / σ_r| = |σ_r * (kx1 : ℝ) - x₀ 1| / σ_r := by
              have : (kx1 : ℝ) - x₀ 1 / σ_r = (σ_r * (kx1 : ℝ) - x₀ 1) / σ_r := by
