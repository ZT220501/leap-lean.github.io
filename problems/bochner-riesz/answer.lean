            t₂ ^ 2 * (-(e_D 1) * g₀ + e_D 0 * g₁) ^ 2 := by ring
      _ ≤ t₁ ^ 2 * (e_D 0 * g₀ + e_D 1 * g₁) ^ 2 +
            t₁ ^ 2 * (-(e_D 1) * g₀ + e_D 0 * g₁) ^ 2 :=
          add_le_add le_rfl (mul_le_mul_of_nonneg_right ht_sq_le (sq_nonneg _))
      _ = t₁ ^ 2 * ((e_D 0 * g₀ + e_D 1 * g₁) ^ 2 +
            (-(e_D 1) * g₀ + e_D 0 * g₁) ^ 2) := by ring
      _ = t₁ ^ 2 * (g₀ ^ 2 + g₁ ^ 2) := by rw [h_rot]
      _ ≤ t₁ ^ 2 * s₁ ^ 2 := mul_le_mul_of_nonneg_left hg_sq (sq_nonneg _)
      _ = (s₁ * t₁) ^ 2 := by ring
      _ = (ε ^ (b_t + η * B)) ^ 2 := by rw [hs₁t₁_eq]
  let σ_max : ℝ := Real.sqrt lam_plus
  let σ_min : ℝ := Real.sqrt lam_minus
  have hσ_max_pos : 0 < σ_max := Real.sqrt_pos.mpr hlam_plus_pos
  have hσ_min_pos : 0 < σ_min := Real.sqrt_pos.mpr hlam_minus_pos
  have hσ_le : σ_min ≤ σ_max := Real.sqrt_le_sqrt hlam_le
  have hσ_max_sq : σ_max ^ 2 = lam_plus := Real.sq_sqrt hlam_plus_pos.le
  have hσ_min_sq : σ_min ^ 2 = lam_minus := Real.sq_sqrt hlam_minus_pos.le
  have hσ_max_ub : σ_max ≤ ε ^ (b_t + η * B) := by
    have h1 : lam_plus ≤ (ε ^ (b_t + η * B)) ^ 2 := by rwa [← hQeG]
    calc σ_max ≤ Real.sqrt ((ε ^ (b_t + η * B)) ^ 2) := Real.sqrt_le_sqrt h1
