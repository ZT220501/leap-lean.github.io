        have h_diff : DifferentiableAt ℝ E_fn p := ((hE 1).differentiable (by simp)).differentiableAt
        exact (h_diff.hasFDerivAt.comp_hasDerivAt p.1 h_line).deriv
      have h_part2 : ∀ (y' τ' : ℝ), deriv (fun τ'' => E_fn (y', τ'')) τ' =
