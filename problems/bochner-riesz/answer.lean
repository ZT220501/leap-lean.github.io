    have h2 : 0 ≤ Real.log C_cnt := Real.log_nonneg hC_cnt
    linarith only [h1, h2]
  refine ⟨C_info, le_trans hC_info_0_nn (le_max_left _ _), ?_⟩
  intro ε H_P L t lam_sys m_time
    hε₀ hε₁ ht_pos ht_L hL_hor ht_HP hHP_hor hlam_ge4 hlam_lo hm_lo
