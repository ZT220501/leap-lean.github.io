            mul_le_mul_of_nonneg_left h_coerc h_lam_s_pos.le
        _ = H (y, τ) := by dsimp only [H, S]; ring
    have hθ_lower : ∀ y : ℝ, L ≤ deriv θ_pos y := by
      intro y
      let φ : ℝ → ℝ := fun τ => L * τ - F₁ (y, τ)
      have hφ_d : ∀ τ : ℝ, HasDerivAt φ (L - H (y, τ)) τ := fun τ => by
        have h1 : HasDerivAt (fun τ' : ℝ => L * τ') (L * 1) τ :=
