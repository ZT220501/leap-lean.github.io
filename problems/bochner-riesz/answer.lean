          (dyadicRealBin ε (b + v) (inner ℝ V₀ (perp2D e_c)) + 14) := by
      refine h_real_icc ε (b + v) _ _ 14 hε₀ hε₁ (by omega) ?_
      rw [← inner_sub_left]
      have h1 := h_cs_perp (V - V₀)
      have h_mul : |inner ℝ (V - V₀) e₀| * (6 * ε ^ v) ≤ (2 * ε ^ b) * (6 * ε ^ v) :=
