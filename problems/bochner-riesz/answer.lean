      have hcard_bi : (S_ad.image Z_of).card ≤
          ∑ q ∈ F_Q_d, ((Fib_Z2 q).image (fun k => (q, k))).card :=
        le_trans (Finset.card_le_card hsub_Z2) Finset.card_biUnion_le
      have hcard_real : ((S_ad.image Z_of).card : ℝ) ≤
          ∑ q ∈ F_Q_d, (((Fib_Z2 q).image (fun k => (q, k))).card : ℝ) := by
        exact_mod_cast hcard_bi
      have hCZ2_nn : 0 ≤ C_Z2 * ε ^ (-ζ_sh) :=
