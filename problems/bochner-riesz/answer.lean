                  ∑ y ∈ I_x x, if Y ω = y then
                    (if qXY x y ≤ (ε ^ τ / (N : ℝ)) * qX x then Q ω else 0) else 0 := by
                refine Finset.sum_congr rfl (fun y _ => ?_)
                by_cases hy : Y ω = y <;>
                  by_cases hq : qXY x y ≤ (ε ^ τ / (N : ℝ)) * qX x <;> simp [hx, hy, hq]
