          _ = 8 * M_sl := one_mul _
      exact pow_le_pow_left₀ (mul_nonneg h_rat_nn (norm_nonneg _)) h_prod_le 2

  
  have h_s3_win :
      ∀ (ψ : EuclideanSpace ℝ (Fin 2) → ℂ),
        (∀ k : ℕ, ContDiff ℝ k ψ) →
        (∀ z : EuclideanSpace ℝ (Fin 2), 4 ≤ ‖z‖ → ψ z = 0) →
        (∀ (k : ℕ) (z : EuclideanSpace ℝ (Fin 2)),
          ‖iteratedFDeriv ℝ k ψ z‖ ≤ M_atom cls.a₀ cls.a₁ cls.A cls.B_sys cls.R_win k) →
        (let w := fun z => star (ψ z)
         (∀ k : ℕ, ContDiff ℝ k w) ∧
         (∀ z : EuclideanSpace ℝ (Fin 2), 4 ≤ ‖z‖ → w z = 0) ∧
         (∀ (k : ℕ) (z : EuclideanSpace ℝ (Fin 2)), ‖iteratedFDeriv ℝ k w z‖ ≤ W₁ k)) ∧
        (∀ (ψ_o : EuclideanSpace ℝ (Fin 2) → ℂ),
          (∀ k : ℕ, ContDiff ℝ k ψ_o) →
          (∀ (k : ℕ) (z : EuclideanSpace ℝ (Fin 2)), ‖iteratedFDeriv ℝ k ψ_o z‖ ≤ cls.M_win k) →
          ∀ (r_sc : ℝ), 0 ≤ r_sc → r_sc ≤ 1 →
          ∀ (z_sh e : EuclideanSpace ℝ (Fin 2)), ‖e‖ = 1 →
          ∀ (y₁ : ℝ),
            let u : ℝ → ℂ := fun s =>
              star (ψ (s • e + y₁ • perp2D e)) *
                ψ_o (z_sh + r_sc • (s • e + y₁ • perp2D e))
            (∀ k : ℕ, ContDiff ℝ k u) ∧
            (∀ s : ℝ, 4 ≤ |s| → u s = 0) ∧
            (∀ (k : ℕ) (s : ℝ), ‖iteratedDeriv k u s‖ ≤ B_amp k)) := by
    intro ψ hψ_sm hψ_supp hψ_der
    let w : EuclideanSpace ℝ (Fin 2) → ℂ := fun z => star (ψ z)
    have hw_eq : w = ⇑Complex.conjLIE ∘ ψ := by
      ext z; simp [w, Complex.conjLIE_apply]
    have hw_sm : ∀ k : ℕ, ContDiff ℝ k w := fun k => by
      rw [hw_eq]; exact Complex.conjLIE.contDiff.comp (hψ_sm k)
    have hw_supp : ∀ z : EuclideanSpace ℝ (Fin 2), 4 ≤ ‖z‖ → w z = 0 := fun z hz => by
      simp [w, hψ_supp z hz]
    have hw_der : ∀ (k : ℕ) (z : EuclideanSpace ℝ (Fin 2)),
        ‖iteratedFDeriv ℝ k w z‖ ≤ W₁ k := fun k z => by
      rw [hw_eq, Complex.conjLIE.norm_iteratedFDeriv_comp_left ψ z k]
      exact le_trans (hψ_der k z) (le_max_left _ _)
    refine ⟨⟨hw_sm, hw_supp, hw_der⟩, ?_⟩
    intro ψ_o hψ_o_sm hψ_o_der r_sc hr_sc0 hr_sc1 z_sh e he y₁
    dsimp only
    let Λ₁ : ℝ →L[ℝ] EuclideanSpace ℝ (Fin 2) :=
      ContinuousLinearMap.smulRight (1 : ℝ →L[ℝ] ℝ) e
    let Λ₂ : ℝ →L[ℝ] EuclideanSpace ℝ (Fin 2) :=
      ContinuousLinearMap.smulRight (1 : ℝ →L[ℝ] ℝ) (r_sc • e)
    have hΛ₁_app : ∀ s : ℝ, Λ₁ s = s • e := fun s => by simp [Λ₁]
    have hΛ₂_app : ∀ s : ℝ, Λ₂ s = s • (r_sc • e) := fun s => by simp [Λ₂]
    have hΛ₁_norm : ‖Λ₁‖ ≤ 1 := by
      refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one (fun s => ?_)
      rw [hΛ₁_app, norm_smul, he, mul_one, one_mul]
    have hΛ₂_norm : ‖Λ₂‖ ≤ 1 := by
      refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one (fun s => ?_)
      rw [hΛ₂_app, norm_smul, norm_smul, he, mul_one, Real.norm_of_nonneg hr_sc0, mul_comm ‖s‖ r_sc]
      exact mul_le_mul_of_nonneg_right hr_sc1 (norm_nonneg s)
    let z₁ : EuclideanSpace ℝ (Fin 2) := y₁ • perp2D e
    let z₂ : EuclideanSpace ℝ (Fin 2) := z_sh + r_sc • (y₁ • perp2D e)
    let f₁ : ℝ → ℂ := (fun z => w (z + z₁)) ∘ ⇑Λ₁
    let f₂ : ℝ → ℂ := (fun z => ψ_o (z + z₂)) ∘ ⇑Λ₂
    have hf₁_cd : ∀ k : ℕ, ContDiff ℝ k f₁ := fun k =>
      ((hw_sm k).comp (contDiff_id.add contDiff_const)).comp Λ₁.contDiff
    have hf₂_cd : ∀ k : ℕ, ContDiff ℝ k f₂ := fun k =>
      ((hψ_o_sm k).comp (contDiff_id.add contDiff_const)).comp Λ₂.contDiff
    have hf₁_bd : ∀ (i : ℕ) (s : ℝ), ‖iteratedFDeriv ℝ i f₁ s‖ ≤ W₁ i := by
      intro i s
      have h_sh_cd : ContDiff ℝ i (fun z => w (z + z₁)) :=
        (hw_sm i).comp (contDiff_id.add contDiff_const)
      dsimp only [f₁]
      rw [Λ₁.iteratedFDeriv_comp_right h_sh_cd s le_rfl, iteratedFDeriv_comp_add_right]
      have h_le1 := ContinuousMultilinearMap.norm_compContinuousLinearMap_le
        (iteratedFDeriv ℝ i w (Λ₁ s + z₁)) (fun _ : Fin i => Λ₁)
      have h_prod_le : (∏ _ : Fin i, ‖Λ₁‖) ≤ 1 := by
        rw [Finset.prod_const, Finset.card_fin]
        exact pow_le_one₀ (norm_nonneg Λ₁) hΛ₁_norm
      calc ‖(iteratedFDeriv ℝ i w (Λ₁ s + z₁)).compContinuousLinearMap (fun _ => Λ₁)‖
          ≤ ‖iteratedFDeriv ℝ i w (Λ₁ s + z₁)‖ * ∏ _ : Fin i, ‖Λ₁‖ := h_le1
        _ ≤ W₁ i * 1 := mul_le_mul (hw_der i (Λ₁ s + z₁)) h_prod_le
            (Finset.prod_nonneg (fun _ _ => norm_nonneg Λ₁)) (hW₁_nn i)
        _ = W₁ i := mul_one _
    have hf₂_bd : ∀ (j : ℕ) (s : ℝ), ‖iteratedFDeriv ℝ j f₂ s‖ ≤ W₂ j := by
      intro j s
      have h_sh_cd : ContDiff ℝ j (fun z => ψ_o (z + z₂)) :=
        (hψ_o_sm j).comp (contDiff_id.add contDiff_const)
      dsimp only [f₂]
      rw [Λ₂.iteratedFDeriv_comp_right h_sh_cd s le_rfl, iteratedFDeriv_comp_add_right]
      have h_le1 := ContinuousMultilinearMap.norm_compContinuousLinearMap_le
        (iteratedFDeriv ℝ j ψ_o (Λ₂ s + z₂)) (fun _ : Fin j => Λ₂)
      have h_prod_le : (∏ _ : Fin j, ‖Λ₂‖) ≤ 1 := by
        rw [Finset.prod_const, Finset.card_fin]
        exact pow_le_one₀ (norm_nonneg Λ₂) hΛ₂_norm
      have hψ_W₂ : ‖iteratedFDeriv ℝ j ψ_o (Λ₂ s + z₂)‖ ≤ W₂ j :=
        le_trans (hψ_o_der j (Λ₂ s + z₂)) (le_max_left _ _)
      calc ‖(iteratedFDeriv ℝ j ψ_o (Λ₂ s + z₂)).compContinuousLinearMap (fun _ => Λ₂)‖
          ≤ ‖iteratedFDeriv ℝ j ψ_o (Λ₂ s + z₂)‖ * ∏ _ : Fin j, ‖Λ₂‖ := h_le1
        _ ≤ W₂ j * 1 := mul_le_mul hψ_W₂ h_prod_le
            (Finset.prod_nonneg (fun _ _ => norm_nonneg Λ₂)) (hW₂_nn j)
        _ = W₂ j := mul_one _
    have hu_eq : (fun s : ℝ =>
          star (ψ (s • e + y₁ • perp2D e)) *
            ψ_o (z_sh + r_sc • (s • e + y₁ • perp2D e))) =
        fun s => f₁ s * f₂ s := by
      ext s
      dsimp only [f₁, f₂, w, z₁, z₂, Function.comp_apply]
      rw [hΛ₁_app s, hΛ₂_app s]
      have h_arg2 : s • (r_sc • e) + (z_sh + r_sc • (y₁ • perp2D e)) =
          z_sh + r_sc • (s • e + y₁ • perp2D e) := by
        ext i; simp only [PiLp.add_apply, PiLp.smul_apply, smul_eq_mul]; ring
      rw [h_arg2]
    refine ⟨fun k => ?_, ?_, ?_⟩
    · rw [hu_eq]; exact (hf₁_cd k).mul (hf₂_cd k)
    · intro s hs
      have he_sq : (e 0) ^ 2 + (e 1) ^ 2 = 1 := by
        have h1 : ‖e‖ ^ 2 = 1 := by rw [he]; norm_num
        rw [PiLp.norm_sq_eq_of_L2, Fin.sum_univ_two] at h1
        simpa [Real.norm_eq_abs, sq_abs] using h1
      have h_norm_sq : 4 ^ 2 ≤ ‖s • e + y₁ • perp2D e‖ ^ 2 := by
        have h_eq : ‖s • e + y₁ • perp2D e‖ ^ 2 = s ^ 2 + y₁ ^ 2 := by
          rw [PiLp.norm_sq_eq_of_L2, Fin.sum_univ_two]
          simp only [PiLp.add_apply, PiLp.smul_apply, smul_eq_mul, perp2D,
            Real.norm_eq_abs, sq_abs]
          dsimp
          linear_combination (s ^ 2 + y₁ ^ 2) * he_sq
        rw [h_eq]
        have hs_sq : 4 ^ 2 ≤ s ^ 2 := by rw [← sq_abs s]; nlinarith
        nlinarith [sq_nonneg y₁]
      have h_norm : 4 ≤ ‖s • e + y₁ • perp2D e‖ := by
        nlinarith [norm_nonneg (s • e + y₁ • perp2D e)]
      have h0 : ψ (s • e + y₁ • perp2D e) = 0 := hψ_supp _ h_norm
      simp [h0]
    · intro k s
      rw [← norm_iteratedFDeriv_eq_norm_iteratedDeriv, hu_eq]
      have h_mul := norm_iteratedFDeriv_mul_le (hf₁_cd k) (hf₂_cd k) s
        (le_rfl : (k : WithTop ℕ∞) ≤ k)
      refine le_trans h_mul (Finset.sum_le_sum (fun i _hi => ?_))
      have h_choose_nn : (0 : ℝ) ≤ (k.choose i : ℝ) := Nat.cast_nonneg _
      calc (k.choose i : ℝ) * ‖iteratedFDeriv ℝ i f₁ s‖ * ‖iteratedFDeriv ℝ (k - i) f₂ s‖
          = (k.choose i : ℝ) * (‖iteratedFDeriv ℝ i f₁ s‖ * ‖iteratedFDeriv ℝ (k - i) f₂ s‖) :=
            mul_assoc _ _ _
        _ ≤ (k.choose i : ℝ) * (W₁ i * W₂ (k - i)) := by
            refine mul_le_mul_of_nonneg_left ?_ h_choose_nn
            exact mul_le_mul (hf₁_bd i s) (hf₂_bd (k - i) s) (norm_nonneg _) (hW₁_nn i)
        _ = (k.choose i : ℝ) * W₁ i * W₂ (k - i) := by ring

  
  have h_iter_id_mul : ∀ (g : ℝ → ℝ), (∀ n : ℕ, ContDiff ℝ n g) →
      ∀ (k : ℕ) (t : ℝ),
        iteratedDeriv (k + 1) (fun s : ℝ => s * g s) t =
          t * iteratedDeriv (k + 1) g t + ((k + 1 : ℕ) : ℝ) * iteratedDeriv k g t := by
    intro g hg
    have hg_iter_cd : ∀ (j k : ℕ), ContDiff ℝ k (iteratedDeriv j g) := by
      intro j
      induction j with
      | zero => intro k; simpa using hg k
      | succ j ih =>
        intro k
        have h_eq : iteratedDeriv (j + 1) g = deriv (iteratedDeriv j g) := by
          ext s; rw [iteratedDeriv_succ]
        rw [h_eq]
        exact (ih (k + 1)).deriv'
    have hg_d : ∀ (j : ℕ) (s : ℝ),
        HasDerivAt (iteratedDeriv j g) (iteratedDeriv (j + 1) g s) s := by
      intro j s
      rw [iteratedDeriv_succ]
      exact ((hg_iter_cd j 1).differentiable (by simp)).differentiableAt.hasDerivAt
    intro k
    induction k with
    | zero =>
      intro t
      rw [iteratedDeriv_one, iteratedDeriv_one, iteratedDeriv_zero]
      have hd : HasDerivAt (fun s : ℝ => s * g s) (1 * g t + t * deriv g t) t :=
        (hasDerivAt_id t).mul (((hg 1).differentiable (by simp)).differentiableAt.hasDerivAt)
      rw [hd.deriv]; push_cast; ring
    | succ k ih =>
      intro t
      have h_fn : iteratedDeriv (k + 1) (fun s : ℝ => s * g s) =
          fun s => s * iteratedDeriv (k + 1) g s + ((k + 1 : ℕ) : ℝ) * iteratedDeriv k g s :=
        funext ih
      rw [iteratedDeriv_succ, h_fn]
      have hd1 : HasDerivAt (fun s : ℝ => s * iteratedDeriv (k + 1) g s)
          (1 * iteratedDeriv (k + 1) g t + t * iteratedDeriv (k + 2) g t) t :=
        (hasDerivAt_id t).mul (hg_d (k + 1) t)
      have hd2 : HasDerivAt (fun s : ℝ => ((k + 1 : ℕ) : ℝ) * iteratedDeriv k g s)
          (((k + 1 : ℕ) : ℝ) * iteratedDeriv (k + 1) g t) t :=
        (hg_d k t).const_mul _
      have hd12 : HasDerivAt
          (fun s : ℝ => s * iteratedDeriv (k + 1) g s + ((k + 1 : ℕ) : ℝ) * iteratedDeriv k g s)
          ((1 * iteratedDeriv (k + 1) g t + t * iteratedDeriv (k + 2) g t) +
            ((k + 1 : ℕ) : ℝ) * iteratedDeriv (k + 1) g t) t :=
        hd1.add hd2
      rw [hd12.deriv]; push_cast; ring

  
  have h_s4_phase :
      ∀ (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
        (ζ₀ : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → EuclideanSpace ℝ (Fin 2)),
        IsNormalizedPosDefPhase cls.a₀ cls.a₁ cls.A Φ₀ ζ₀ →
      ∀ (lam_sys ρ_r C_r C_t : ℝ),
        0 < lam_sys → 0 < ρ_r → ρ_r ≤ 1 →
        C_r ∈ Set.Icc (0 : ℝ) 1 → C_t ∈ Set.Icc (0 : ℝ) 1 →
        lam_sys * ρ_r ^ 2 * |C_t - C_r| ≤ cls.B_sys →
      ∀ (V_at X_at X_o : EuclideanSpace ℝ (Fin 2)),
        let σ_r := (lam_sys * ρ_r)⁻¹
        let ΔX := X_o - X_at - (C_t - C_r) • V_at
        let K := σ_r⁻¹ * ‖ΔX‖
        let L_osc := (cls.a₀ / 2) * K
        (20 * cls.A * cls.B_sys + 4) / cls.a₀ ≤ K →
        0 < L_osc ∧
        ∃ e : EuclideanSpace ℝ (Fin 2),
          ‖e‖ = 1 ∧
          ∀ y₁ ∈ Set.Icc (-4 : ℝ) 4,
            let θ : ℝ → ℝ := fun s =>
              lam_sys *
                (Φ₀ (C_t, X_o, V_at + ρ_r • (s • e + y₁ • perp2D e)) -
                 Φ₀ (C_r, X_at, V_at + ρ_r • (s • e + y₁ • perp2D e)))
            (∀ k : ℕ, ContDiff ℝ k θ) ∧
            (∀ s : ℝ, |s| ≤ 6 → L_osc ≤ deriv θ s) ∧
            (∀ m : ℕ, 1 ≤ m → ∀ s : ℝ, |s| ≤ 6 →
              |iteratedDeriv m (deriv θ) s| ≤ L_osc * D_phase m) := by
    intro Φ₀ ζ₀ h_phase lam_sys ρ_r C_r C_t
      hlam_pos hρ_r_pos hρ_r_le1 hC_r hC_t h_chirp
      V_at X_at X_o σ_r ΔX K L_osc hK_lo
    obtain ⟨hΦ_cd, hζ_cd, _, _, _, hΦ_fderiv, _, hζ_pd, hζ_gevrey⟩ := h_phase
    have hlam_ρ_pos : 0 < lam_sys * ρ_r := mul_pos hlam_pos hρ_r_pos
    have hσ_r_pos : 0 < σ_r := inv_pos.mpr hlam_ρ_pos
    have hσ_inv : σ_r⁻¹ = lam_sys * ρ_r := inv_inv (lam_sys * ρ_r)
    have hL_ge : 10 * cls.A * cls.B_sys + 2 ≤ L_osc := by
      have h1 : 20 * cls.A * cls.B_sys + 4 ≤ K * cls.a₀ := (div_le_iff₀ ha₀).mp hK_lo
      dsimp only [L_osc]
      linarith
    have hL_ge1 : 1 ≤ L_osc := by nlinarith [hA, hB_sys, hL_ge]
    have hL_pos : 0 < L_osc := by linarith
    have hK_pos : 0 < K := by
      have h1 : 0 < (20 * cls.A * cls.B_sys + 4) / cls.a₀ := by positivity
      linarith
    have hΔX_eq_Kσ : K * σ_r = ‖ΔX‖ := by
      dsimp only [K]
      rw [mul_comm σ_r⁻¹ ‖ΔX‖, mul_assoc, inv_mul_cancel₀ hσ_r_pos.ne', mul_one]
    have hΔX_pos : 0 < ‖ΔX‖ := by rw [← hΔX_eq_Kσ]; exact mul_pos hK_pos hσ_r_pos
    let e : EuclideanSpace ℝ (Fin 2) := ‖ΔX‖⁻¹ • ΔX
    have he : ‖e‖ = 1 := by
      dsimp only [e]
      rw [norm_smul, Real.norm_of_nonneg (inv_nonneg.mpr hΔX_pos.le),
        inv_mul_cancel₀ hΔX_pos.ne']
    have hperp_e : ‖perp2D e‖ = 1 := by
      have hsq : ‖perp2D e‖ ^ 2 = ‖e‖ ^ 2 := by
        rw [PiLp.norm_sq_eq_of_L2, PiLp.norm_sq_eq_of_L2, Fin.sum_univ_two, Fin.sum_univ_two]
        simp [perp2D, Real.norm_eq_abs, sq_abs]
        ring
      rw [he] at hsq
      nlinarith [norm_nonneg (perp2D e)]
    have hKσ_e : (K * σ_r) • e = ΔX := by
      dsimp only [e]
      rw [hΔX_eq_Kσ, smul_inv_smul₀ hΔX_pos.ne']

    
    have hζ_coerc : ∀ (v p u : EuclideanSpace ℝ (Fin 2)),
        cls.a₀ * ‖u‖ ^ 2 ≤ inner ℝ (ζ₀ (v, p + u) - ζ₀ (v, p)) u := by
      intro v p u
      let dual_u := InnerProductSpace.toDual ℝ (EuclideanSpace ℝ (Fin 2)) u
      let φ : ℝ → ℝ := fun τ => (cls.a₀ * ‖u‖ ^ 2) * τ - dual_u (ζ₀ (v, p + τ • u))
      have hφ_deriv : ∀ τ : ℝ, HasDerivAt φ
          (cls.a₀ * ‖u‖ ^ 2 - dual_u (fderiv ℝ (fun p' => ζ₀ (v, p')) (p + τ • u) u)) τ := by
        intro τ
        have hp_d : HasDerivAt (fun τ' : ℝ => p + τ' • u) u τ := by
          have h1 : HasDerivAt (fun τ' : ℝ => τ' • u) ((1 : ℝ) • u) τ :=
            (hasDerivAt_id τ).smul_const u
          rw [one_smul] at h1
          exact h1.const_add p
        have hζ_d : DifferentiableAt ℝ (fun p' => ζ₀ (v, p')) (p + τ • u) :=
          (((hζ_cd 1).comp (contDiff_const.prodMk contDiff_id)).differentiable
            (by simp)).differentiableAt
        have hc := dual_u.hasFDerivAt.comp_hasDerivAt τ (hζ_d.hasFDerivAt.comp_hasDerivAt τ hp_d)
        have hlin : HasDerivAt (fun τ' : ℝ => (cls.a₀ * ‖u‖ ^ 2) * τ') (cls.a₀ * ‖u‖ ^ 2) τ := by
          simpa using (hasDerivAt_id τ).const_mul (cls.a₀ * ‖u‖ ^ 2)
        exact hlin.sub hc
      have hφ_diff : Differentiable ℝ φ := fun τ => (hφ_deriv τ).differentiableAt
      have hφ_nonpos : ∀ τ : ℝ, deriv φ τ ≤ 0 := by
        intro τ
        rw [(hφ_deriv τ).deriv]
        have h_du : dual_u (fderiv ℝ (fun p' => ζ₀ (v, p')) (p + τ • u) u) =
            inner ℝ (fderiv ℝ (fun p' => ζ₀ (v, p')) (p + τ • u) u) u := by
          dsimp only [dual_u]
          rw [InnerProductSpace.toDual_apply_apply, real_inner_comm]
        rw [h_du]
        linarith [(hζ_pd v (p + τ • u) u).1]
      have h_anti := antitone_of_deriv_nonpos hφ_diff hφ_nonpos (zero_le_one : (0 : ℝ) ≤ 1)
      dsimp only [φ, dual_u] at h_anti
      rw [one_smul, zero_smul, add_zero, mul_one, mul_zero, zero_sub,
        InnerProductSpace.toDual_apply_apply, InnerProductSpace.toDual_apply_apply,
        real_inner_comm (ζ₀ (v, p + u)) u, real_inner_comm (ζ₀ (v, p)) u] at h_anti
      have h_sub : inner ℝ (ζ₀ (v, p + u) - ζ₀ (v, p)) u =
          inner ℝ (ζ₀ (v, p + u)) u - inner ℝ (ζ₀ (v, p)) u := inner_sub_left _ _ _
      linarith
    have hζ_lip : ∀ (v q₁ q₂ : EuclideanSpace ℝ (Fin 2)),
        ‖ζ₀ (v, q₂) - ζ₀ (v, q₁)‖ ≤ cls.A * ‖q₂ - q₁‖ := by
      intro v q₁ q₂
      have h_diff : ∀ q ∈ (Set.univ : Set (EuclideanSpace ℝ (Fin 2))),
          DifferentiableAt ℝ (fun p' => ζ₀ (v, p')) q := fun q _ =>
        (((hζ_cd 1).comp (contDiff_const.prodMk contDiff_id)).differentiable
          (by simp)).differentiableAt
      have h_bd : ∀ q ∈ (Set.univ : Set (EuclideanSpace ℝ (Fin 2))),
          ‖fderiv ℝ (fun p' => ζ₀ (v, p')) q‖ ≤ cls.A := by
        intro q _
        have h0 := hζ_gevrey 0 (v, q)
        rw [norm_iteratedFDeriv_zero] at h0
        simpa using h0
      exact convex_univ.norm_image_sub_le_of_norm_fderiv_le h_diff h_bd
        (Set.mem_univ q₁) (Set.mem_univ q₂)

    have h_clairaut : ∀ (F : ℝ × ℝ → ℝ), (∀ k : ℕ, ContDiff ℝ k F) →
        let F₁ : ℝ × ℝ → ℝ := fun p => deriv (fun s => F (s, p.2)) p.1
        (∀ k : ℕ, ContDiff ℝ k F₁) ∧
        ∀ (t τ : ℝ), HasDerivAt (fun u => F₁ (t, u))
          (deriv (fun s => deriv (fun u => F (s, u)) τ) t) τ := by
      intro F hF
      dsimp only
      let F₁ : ℝ × ℝ → ℝ := fun p => deriv (fun s => F (s, p.2)) p.1
      have h_part1 : ∀ p : ℝ × ℝ, F₁ p = fderiv ℝ F p (1, 0) := by
        intro p
        have h_line : HasDerivAt (fun s : ℝ => (s, p.2)) (1, 0) p.1 :=
          (hasDerivAt_id p.1).prodMk (hasDerivAt_const p.1 p.2)
        have h_diff : DifferentiableAt ℝ F p := ((hF 1).differentiable (by simp)).differentiableAt
        exact (h_diff.hasFDerivAt.comp_hasDerivAt p.1 h_line).deriv
      have h_part2 : ∀ (s u : ℝ), deriv (fun u' => F (s, u')) u = fderiv ℝ F (s, u) (0, 1) := by
        intro s u
        have h_line : HasDerivAt (fun u' : ℝ => (s, u')) (0, 1) u :=
          (hasDerivAt_const u s).prodMk (hasDerivAt_id u)
        have h_diff : DifferentiableAt ℝ F (s, u) :=
          ((hF 1).differentiable (by simp)).differentiableAt
        exact (h_diff.hasFDerivAt.comp_hasDerivAt u h_line).deriv
      let ev10 : (ℝ × ℝ →L[ℝ] ℝ) →L[ℝ] ℝ := ContinuousLinearMap.apply ℝ ℝ (1, 0)
      let ev01 : (ℝ × ℝ →L[ℝ] ℝ) →L[ℝ] ℝ := ContinuousLinearMap.apply ℝ ℝ (0, 1)
      have hF₁_eq : F₁ = fun p => ev10 (fderiv ℝ F p) := funext h_part1
      have hF₁_cd : ∀ k : ℕ, ContDiff ℝ k F₁ := fun k => by
        rw [hF₁_eq]
        exact ev10.contDiff.comp ((hF (k + 1)).fderiv_right le_rfl)
      refine ⟨hF₁_cd, fun t τ => ?_⟩
      have hF'_cd1 : ContDiff ℝ (1 : ℕ) (fderiv ℝ F) := (hF (1 + 1)).fderiv_right le_rfl
      have hF'_diff : Differentiable ℝ (fderiv ℝ F) := hF'_cd1.differentiable (by simp)
      have h_line_u : HasDerivAt (fun u : ℝ => (t, u)) (0, 1) τ :=
        (hasDerivAt_const τ t).prodMk (hasDerivAt_id τ)
      have h_u_deriv : HasDerivAt (fun u => F₁ (t, u))
          (fderiv ℝ (fderiv ℝ F) (t, τ) (0, 1) (1, 0)) τ := by
        have h_u_eq : (fun u => F₁ (t, u)) = (⇑ev10 ∘ fderiv ℝ F ∘ fun u => (t, u)) :=
          funext (fun u => h_part1 (t, u))
        have h1 := ev10.hasFDerivAt.comp_hasDerivAt τ
          (hF'_diff.differentiableAt.hasFDerivAt.comp_hasDerivAt τ h_line_u)
        rwa [h_u_eq]
      have h_line_s : HasDerivAt (fun s : ℝ => (s, τ)) (1, 0) t :=
        (hasDerivAt_id t).prodMk (hasDerivAt_const t τ)
      have h_s_deriv : deriv (fun s => deriv (fun u => F (s, u)) τ) t =
          fderiv ℝ (fderiv ℝ F) (t, τ) (1, 0) (0, 1) := by
        have h_s_eq : (fun s => deriv (fun u => F (s, u)) τ) =
            (⇑ev01 ∘ fderiv ℝ F ∘ fun s => (s, τ)) :=
          funext (fun s => h_part2 s τ)
        have h1 := ev01.hasFDerivAt.comp_hasDerivAt t
          (hF'_diff.differentiableAt.hasFDerivAt.comp_hasDerivAt t h_line_s)
        rw [h_s_eq]
        exact h1.deriv
      have h_symm : fderiv ℝ (fderiv ℝ F) (t, τ) (0, 1) (1, 0) =
          fderiv ℝ (fderiv ℝ F) (t, τ) (1, 0) (0, 1) :=
        ((hF 2).contDiffAt.isSymmSndFDerivAt (by simp)).eq (0, 1) (1, 0)
      rw [h_s_deriv, ← h_symm]
      exact h_u_deriv

    let M_op : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) →
        (EuclideanSpace ℝ (Fin 2) →L[ℝ] EuclideanSpace ℝ (Fin 2)) :=
      fun q => fderiv ℝ (fun p' => ζ₀ (q.1, p')) q.2
    have hM_cd : ∀ k : ℕ, ContDiff ℝ k M_op := by
      intro k
      let inr_E : EuclideanSpace ℝ (Fin 2) →L[ℝ]
          EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) :=
        (0 : EuclideanSpace ℝ (Fin 2) →L[ℝ] EuclideanSpace ℝ (Fin 2)).prod
          (ContinuousLinearMap.id ℝ (EuclideanSpace ℝ (Fin 2)))
      have hM_eq : M_op = fun q => (fderiv ℝ ζ₀ q).comp inr_E := by
        funext q
        have h_inr : HasFDerivAt (fun p' : EuclideanSpace ℝ (Fin 2) => (q.1, p')) inr_E q.2 :=
          (hasFDerivAt_const q.1 q.2).prodMk (hasFDerivAt_id q.2)
        have h_diff : DifferentiableAt ℝ ζ₀ (q.1, q.2) :=
          ((hζ_cd 1).differentiable (by simp)).differentiableAt
        exact (h_diff.hasFDerivAt.comp q.2 h_inr).fderiv
      rw [hM_eq]
      exact ((hζ_cd (k + 1)).fderiv_right le_rfl).clm_comp contDiff_const

    refine ⟨hL_pos, e, he, ?_⟩
    intro y₁ hy₁
    dsimp only
    have hy₁_abs : |y₁| ≤ 4 := abs_le.mpr hy₁
    let z₀ : EuclideanSpace ℝ (Fin 2) := y₁ • perp2D e
    let V_base : EuclideanSpace ℝ (Fin 2) := V_at + ρ_r • z₀
    let v_fn : ℝ → EuclideanSpace ℝ (Fin 2) := fun s => V_at + ρ_r • (s • e + z₀)
    let P₁ : ℝ → EuclideanSpace ℝ (Fin 2) := fun s => X_at - C_r • v_fn s
    let P₂ : ℝ → EuclideanSpace ℝ (Fin 2) := fun s => X_o - C_t • v_fn s
    let Q : ℝ → EuclideanSpace ℝ (Fin 2) := fun s => P₂ s - P₁ s
    let θ : ℝ → ℝ := fun s => lam_sys * (Φ₀ (C_t, X_o, v_fn s) - Φ₀ (C_r, X_at, v_fn s))
    let δ : ℝ → ℝ := fun s => (lam_sys * ρ_r) * inner ℝ (ζ₀ (v_fn s, P₂ s) - ζ₀ (v_fn s, P₁ s)) e
    have hv_cd : ∀ k : ℕ, ContDiff ℝ k v_fn := fun k => by
      have hcV : ContDiff ℝ k (fun _ : ℝ => V_at) := contDiff_const
      have hcρ : ContDiff ℝ k (fun _ : ℝ => ρ_r) := contDiff_const
      have hce : ContDiff ℝ k (fun _ : ℝ => e) := contDiff_const
      have hcz : ContDiff ℝ k (fun _ : ℝ => z₀) := contDiff_const
      exact hcV.add (hcρ.smul ((contDiff_id.smul hce).add hcz))
    have hP₁_cd : ∀ k : ℕ, ContDiff ℝ k P₁ := fun k => by
      have hcX : ContDiff ℝ k (fun _ : ℝ => X_at) := contDiff_const
      have hcc : ContDiff ℝ k (fun _ : ℝ => C_r) := contDiff_const
      exact hcX.sub (hcc.smul (hv_cd k))
    have hP₂_cd : ∀ k : ℕ, ContDiff ℝ k P₂ := fun k => by
      have hcX : ContDiff ℝ k (fun _ : ℝ => X_o) := contDiff_const
      have hcc : ContDiff ℝ k (fun _ : ℝ => C_t) := contDiff_const
      exact hcX.sub (hcc.smul (hv_cd k))
    have hQ_cd : ∀ k : ℕ, ContDiff ℝ k Q := fun k => (hP₂_cd k).sub (hP₁_cd k)
    have hθ_cd : ∀ k : ℕ, ContDiff ℝ k θ := fun k =>
      contDiff_const.mul
        (((hΦ_cd k).comp (contDiff_const.prodMk (contDiff_const.prodMk (hv_cd k)))).sub
          ((hΦ_cd k).comp (contDiff_const.prodMk (contDiff_const.prodMk (hv_cd k)))))
    have hv_deriv : ∀ s : ℝ, HasDerivAt v_fn (ρ_r • e) s := by
      intro s
      have h1 : HasDerivAt (fun s' : ℝ => s' • e) ((1 : ℝ) • e) s :=
        (hasDerivAt_id s).smul_const e
      rw [one_smul] at h1
      exact ((h1.add_const z₀).const_smul ρ_r).const_add V_at
    have hθ_deriv_eq : deriv θ = δ := by
      ext s
      have h_d_t : DifferentiableAt ℝ (fun v' => Φ₀ (C_t, X_o, v')) (v_fn s) :=
        (((hΦ_cd 1).comp
          (contDiff_const.prodMk (contDiff_const.prodMk contDiff_id))).differentiable
            (by simp)).differentiableAt
      have h_d_r : DifferentiableAt ℝ (fun v' => Φ₀ (C_r, X_at, v')) (v_fn s) :=
        (((hΦ_cd 1).comp
          (contDiff_const.prodMk (contDiff_const.prodMk contDiff_id))).differentiable
            (by simp)).differentiableAt
      have hc_t := h_d_t.hasFDerivAt.comp_hasDerivAt s (hv_deriv s)
      have hc_r := h_d_r.hasFDerivAt.comp_hasDerivAt s (hv_deriv s)
      have hg_t := hΦ_fderiv C_t hC_t X_o (v_fn s) (ρ_r • e)
      have hg_r := hΦ_fderiv C_r hC_r X_at (v_fn s) (ρ_r • e)
      rw [inner_smul_right] at hg_t hg_r
      rw [hg_t] at hc_t
      rw [hg_r] at hc_r
      have hc_t' : HasDerivAt (fun s' => Φ₀ (C_t, X_o, v_fn s'))
          (ρ_r * inner ℝ (ζ₀ (v_fn s, X_o - C_t • v_fn s)) e) s := hc_t
      have hc_r' : HasDerivAt (fun s' => Φ₀ (C_r, X_at, v_fn s'))
          (ρ_r * inner ℝ (ζ₀ (v_fn s, X_at - C_r • v_fn s)) e) s := hc_r
      have h_all : HasDerivAt θ
          (lam_sys * (ρ_r * inner ℝ (ζ₀ (v_fn s, X_o - C_t • v_fn s)) e -
            ρ_r * inner ℝ (ζ₀ (v_fn s, X_at - C_r • v_fn s)) e)) s :=
        (hc_t'.sub hc_r').const_mul lam_sys
      rw [h_all.deriv]
      dsimp only [δ, P₁, P₂]
      rw [inner_sub_left]
      ring

    
    have hθ_lo : ∀ s : ℝ, |s| ≤ 6 → L_osc ≤ deriv θ s := by
      intro s hs
      rw [hθ_deriv_eq]
      dsimp only [δ]
      let u_dir : EuclideanSpace ℝ (Fin 2) := (K * σ_r) • e
      have hKσ_pos : 0 < K * σ_r := mul_pos hK_pos hσ_r_pos
      have hu_norm : ‖u_dir‖ = K * σ_r := by
        dsimp only [u_dir]
        rw [norm_smul, Real.norm_of_nonneg hKσ_pos.le, he, mul_one]
      have h_coerc1 : cls.a₀ * K * σ_r ≤
          inner ℝ (ζ₀ (v_fn s, P₁ s + u_dir) - ζ₀ (v_fn s, P₁ s)) e := by
        have hc := hζ_coerc (v_fn s) (P₁ s) u_dir
        rw [hu_norm] at hc
        have h_sm : inner ℝ (ζ₀ (v_fn s, P₁ s + u_dir) - ζ₀ (v_fn s, P₁ s)) u_dir =
            (K * σ_r) * inner ℝ (ζ₀ (v_fn s, P₁ s + u_dir) - ζ₀ (v_fn s, P₁ s)) e :=
          inner_smul_right _ _ _
        rw [h_sm] at hc
        nlinarith
      have h_err_eq : P₂ s - (P₁ s + u_dir) = -(((C_t - C_r) * ρ_r) • (s • e + z₀)) := by
        have hu_Δ : u_dir = ΔX := hKσ_e
        ext i
        dsimp only [P₁, P₂, v_fn]
        rw [hu_Δ]
        dsimp only [ΔX]
        simp only [PiLp.add_apply, PiLp.sub_apply, PiLp.neg_apply, PiLp.smul_apply, smul_eq_mul]
        ring
      have h_z_norm : ‖s • e + z₀‖ ≤ 10 := by
        calc ‖s • e + z₀‖ ≤ ‖s • e‖ + ‖y₁ • perp2D e‖ := norm_add_le _ _
          _ = |s| * ‖e‖ + |y₁| * ‖perp2D e‖ := by
              rw [norm_smul s e, norm_smul y₁ (perp2D e), Real.norm_eq_abs, Real.norm_eq_abs]
          _ = |s| + |y₁| := by rw [he, hperp_e, mul_one, mul_one]
          _ ≤ 6 + 4 := add_le_add hs hy₁_abs
          _ = 10 := by norm_num
      have h_chirp_σ : |C_t - C_r| * ρ_r ≤ cls.B_sys * σ_r := by
        have h_eq : |C_t - C_r| * ρ_r = (lam_sys * ρ_r ^ 2 * |C_t - C_r|) * σ_r := by
          dsimp only [σ_r]
          field_simp [hlam_pos.ne', hρ_r_pos.ne']
        rw [h_eq]
        exact mul_le_mul_of_nonneg_right h_chirp hσ_r_pos.le
      have h_err_norm : ‖P₂ s - (P₁ s + u_dir)‖ ≤ 10 * cls.B_sys * σ_r := by
        rw [h_err_eq, norm_neg, norm_smul, Real.norm_eq_abs, abs_mul, abs_of_pos hρ_r_pos]
        calc (|C_t - C_r| * ρ_r) * ‖s • e + z₀‖
            ≤ (cls.B_sys * σ_r) * 10 :=
              mul_le_mul h_chirp_σ h_z_norm (norm_nonneg _) (by positivity)
          _ = 10 * cls.B_sys * σ_r := by ring
      have h_lip_inner :
          |inner ℝ (ζ₀ (v_fn s, P₂ s) - ζ₀ (v_fn s, P₁ s + u_dir)) e| ≤
            10 * cls.A * cls.B_sys * σ_r := by
        calc |inner ℝ (ζ₀ (v_fn s, P₂ s) - ζ₀ (v_fn s, P₁ s + u_dir)) e|
            ≤ ‖ζ₀ (v_fn s, P₂ s) - ζ₀ (v_fn s, P₁ s + u_dir)‖ * ‖e‖ :=
              abs_real_inner_le_norm _ _
          _ ≤ (cls.A * ‖P₂ s - (P₁ s + u_dir)‖) * 1 := by
              rw [he]
              exact mul_le_mul_of_nonneg_right (hζ_lip (v_fn s) (P₁ s + u_dir) (P₂ s)) zero_le_one
          _ ≤ cls.A * (10 * cls.B_sys * σ_r) := by
              rw [mul_one]
              exact mul_le_mul_of_nonneg_left h_err_norm (by linarith [hA])
          _ = 10 * cls.A * cls.B_sys * σ_r := by ring
      have h_split_ζ : inner ℝ (ζ₀ (v_fn s, P₂ s) - ζ₀ (v_fn s, P₁ s)) e =
          inner ℝ (ζ₀ (v_fn s, P₁ s + u_dir) - ζ₀ (v_fn s, P₁ s)) e +
            inner ℝ (ζ₀ (v_fn s, P₂ s) - ζ₀ (v_fn s, P₁ s + u_dir)) e := by
        rw [← inner_add_left]
        congr 1
        abel
      have h_inner_lo : (cls.a₀ * K - 10 * cls.A * cls.B_sys) * σ_r ≤
          inner ℝ (ζ₀ (v_fn s, P₂ s) - ζ₀ (v_fn s, P₁ s)) e := by
        have h_abs_lo := (abs_le.mp h_lip_inner).1
        rw [h_split_ζ]
        linarith
      have h_mul := mul_le_mul_of_nonneg_left h_inner_lo hlam_ρ_pos.le
      have h_cancel : (lam_sys * ρ_r) * ((cls.a₀ * K - 10 * cls.A * cls.B_sys) * σ_r) =
          2 * L_osc - 10 * cls.A * cls.B_sys := by
        dsimp only [σ_r, L_osc]
        field_simp [hlam_pos.ne', hρ_r_pos.ne']
      rw [h_cancel] at h_mul
      linarith [hL_ge, h_mul]

    
    let dual_e := InnerProductSpace.toDual ℝ (EuclideanSpace ℝ (Fin 2)) e
    let G : ℝ × ℝ → ℝ := fun p =>
      (lam_sys * ρ_r) *
        inner ℝ (ζ₀ (v_fn p.1, P₁ p.1 + p.2 • Q p.1) - ζ₀ (v_fn p.1, P₁ p.1)) e
    let H : ℝ × ℝ → ℝ := fun p =>
      (lam_sys * ρ_r) * inner ℝ (M_op (v_fn p.1, P₁ p.1 + p.2 • Q p.1) (Q p.1)) e
    have hG_cd : ∀ k : ℕ, ContDiff ℝ k G := fun k => by
      have hv1 : ContDiff ℝ k (fun p : ℝ × ℝ => v_fn p.1) := (hv_cd k).comp contDiff_fst
      have hP1 : ContDiff ℝ k (fun p : ℝ × ℝ => P₁ p.1) := (hP₁_cd k).comp contDiff_fst
      have hQ1 : ContDiff ℝ k (fun p : ℝ × ℝ => Q p.1) := (hQ_cd k).comp contDiff_fst
      have hp_seg : ContDiff ℝ k (fun p : ℝ × ℝ => P₁ p.1 + p.2 • Q p.1) :=
        hP1.add (contDiff_snd.smul hQ1)
      have hζ_seg : ContDiff ℝ k (fun p : ℝ × ℝ => ζ₀ (v_fn p.1, P₁ p.1 + p.2 • Q p.1)) :=
        (hζ_cd k).comp (hv1.prodMk hp_seg)
      have hζ_base : ContDiff ℝ k (fun p : ℝ × ℝ => ζ₀ (v_fn p.1, P₁ p.1)) :=
        (hζ_cd k).comp (hv1.prodMk hP1)
      have hG_eq : G = fun p =>
          (lam_sys * ρ_r) *
            dual_e (ζ₀ (v_fn p.1, P₁ p.1 + p.2 • Q p.1) - ζ₀ (v_fn p.1, P₁ p.1)) := by
        ext p; dsimp only [G, dual_e]; rw [InnerProductSpace.toDual_apply_apply, real_inner_comm]
      rw [hG_eq]
      exact contDiff_const.mul (dual_e.contDiff.comp (hζ_seg.sub hζ_base))
    have hG_zero : (fun s : ℝ => G (s, 0)) = fun _ => 0 := by
      ext s; dsimp only [G]; rw [zero_smul, add_zero, sub_self, inner_zero_left, mul_zero]
    have hG_one : (fun s : ℝ => G (s, 1)) = δ := by
      ext s; dsimp only [G, δ, Q]; rw [one_smul, add_sub_cancel]
    have hG_tau_deriv : ∀ (s τ : ℝ), HasDerivAt (fun τ' => G (s, τ')) (H (s, τ)) τ := by
      intro s τ
      have hp_deriv : HasDerivAt (fun τ' : ℝ => P₁ s + τ' • Q s) (Q s) τ := by
        have hsm : HasDerivAt (fun τ' : ℝ => τ' • Q s) ((1 : ℝ) • Q s) τ :=
          (hasDerivAt_id τ).smul_const (Q s)
        rw [one_smul] at hsm
        exact hsm.const_add (P₁ s)
      have hζ_diff : DifferentiableAt ℝ (fun p' => ζ₀ (v_fn s, p')) (P₁ s + τ • Q s) :=
        (((hζ_cd 1).comp (contDiff_const.prodMk contDiff_id)).differentiable
          (by simp)).differentiableAt
      have h_comp0 := (hζ_diff.hasFDerivAt.comp_hasDerivAt τ hp_deriv).sub_const (ζ₀ (v_fn s, P₁ s))
      have h_comp1 : HasDerivAt (fun τ' => ζ₀ (v_fn s, P₁ s + τ' • Q s) - ζ₀ (v_fn s, P₁ s))
          (M_op (v_fn s, P₁ s + τ • Q s) (Q s)) τ := h_comp0
      have h_comp2 := (dual_e.hasFDerivAt.comp_hasDerivAt τ h_comp1).const_mul (lam_sys * ρ_r)
      have h_fun_eq : (fun y : ℝ => (lam_sys * ρ_r) *
          (⇑dual_e ∘ fun τ' => ζ₀ (v_fn s, P₁ s + τ' • Q s) - ζ₀ (v_fn s, P₁ s)) y) =
          fun τ' => G (s, τ') := by
        ext τ'; dsimp only [G, dual_e, Function.comp_apply]
        rw [InnerProductSpace.toDual_apply_apply, real_inner_comm]
      rw [h_fun_eq] at h_comp2
      have h_val_eq : (lam_sys * ρ_r) * dual_e (M_op (v_fn s, P₁ s + τ • Q s) (Q s)) = H (s, τ) := by
        dsimp only [H, dual_e]; rw [InnerProductSpace.toDual_apply_apply, real_inner_comm]
      rwa [h_val_eq] at h_comp2
    let G_iter : ℕ → ℝ × ℝ → ℝ := fun m p => iteratedDeriv m (fun s => G (s, p.2)) p.1
    have hG_iter : ∀ m : ℕ,
        (∀ k : ℕ, ContDiff ℝ k (G_iter m)) ∧
        (∀ (t τ : ℝ), HasDerivAt (fun τ' => G_iter m (t, τ'))
          (iteratedDeriv m (fun s => H (s, τ)) t) τ) := by
      intro m
      induction m with
      | zero =>
        refine ⟨hG_cd, fun t τ => ?_⟩
        simpa [G_iter] using hG_tau_deriv t τ
      | succ m ih =>
        obtain ⟨hGm_cd, hGm_deriv⟩ := ih
        obtain ⟨hGm1_cd, hGm1_comm⟩ := h_clairaut (G_iter m) hGm_cd
        have h_eq : G_iter (m + 1) = fun p => deriv (fun s => G_iter m (s, p.2)) p.1 := by
          ext p; simp only [G_iter, iteratedDeriv_succ]
        rw [h_eq]
        refine ⟨hGm1_cd, fun t τ => ?_⟩
        have h_step := hGm1_comm t τ
        have h_inner_eq : (fun s => deriv (fun u => G_iter m (s, u)) τ) =
            iteratedDeriv m (fun s => H (s, τ)) :=
          funext (fun s => (hGm_deriv s τ).deriv)
        rwa [h_inner_eq, ← iteratedDeriv_succ] at h_step

    have hH_bound : ∀ (m : ℕ), 1 ≤ m → ∀ τ ∈ Set.Icc (0 : ℝ) 1, ∀ (s : ℝ), |s| ≤ 6 →
        |iteratedDeriv m (fun s' => H (s', τ)) s| ≤ L_osc * D_phase m := by
      intro m hm τ hτ s hs
      let c_τ : ℝ := (1 - τ) * C_r + τ * C_t
      have hc_τ0 : 0 ≤ c_τ := by dsimp only [c_τ]; nlinarith [hτ.1, hτ.2, hC_r.1, hC_t.1]
      have hc_τ1 : c_τ ≤ 1 := by dsimp only [c_τ]; nlinarith [hτ.1, hτ.2, hC_r.2, hC_t.2]
      let q_τ : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) :=
        (V_base, ((1 - τ) • X_at + τ • X_o) - c_τ • V_base)
      let ξ_τ : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) :=
        (ρ_r • e, (-(c_τ * ρ_r)) • e)
      let Λ_τ : ℝ →L[ℝ] EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) :=
        ContinuousLinearMap.smulRight (1 : ℝ →L[ℝ] ℝ) ξ_τ
      have hΛ_τ_norm : ‖Λ_τ‖ ≤ 1 := by
        refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one (fun t => ?_)
        have hξ_norm : ‖ξ_τ‖ ≤ 1 := by
          rw [Prod.norm_def]
          refine max_le ?_ ?_
          · dsimp only [ξ_τ]
            rw [norm_smul, he, mul_one, Real.norm_of_nonneg hρ_r_pos.le]
            exact hρ_r_le1
          · dsimp only [ξ_τ]
            rw [norm_smul, he, mul_one, Real.norm_eq_abs, abs_neg,
              abs_of_nonneg (mul_nonneg hc_τ0 hρ_r_pos.le)]
