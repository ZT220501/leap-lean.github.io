          obtain ⟨s_z, ⟨N_D, b_D, a_D, e_D, V_D, A_D, q, h_adm, hq_nn, hq_sum, hq_cap, hs_eq⟩, hs_gt⟩ :=
            exists_lt_of_lt_csSup h_ne_z h_lt
