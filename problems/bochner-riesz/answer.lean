    have hF_tau_deriv : ∀ (y τ : ℝ), HasDerivAt (fun τ' => F (y, τ')) (G (y, τ)) τ := by
      intro y τ
      have hv_d : HasDerivAt v_seg δ τ := by
        have h1 : HasDerivAt (fun τ' : ℝ => τ' • δ) ((1 : ℝ) • δ) τ :=
