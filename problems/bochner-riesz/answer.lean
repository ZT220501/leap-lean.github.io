          ((A_part (T_idx ω) + (dyadicTimeMid ε k (c_val ω)) • V_part (T_idx ω)) 1) := by
        rw [← hω_ok]; rfl
      have hdy_k := hs4_dyadic ε k k (c_val ω) k k 0 hε_pos hε_lt_half hk_nn le_rfl le_rfl
      have hdy_kh := hs4_dyadic ε (k + h) (k + h) (c_val ω) (k + h) (k + h) 0
        hε_pos hε_lt_half (by linarith only [hk_nn, hh_pos]) le_rfl le_rfl
      have hc_b : c_base = dyadicTimeMid ε k (c_val ω) := by
        dsimp [c_base, step_tk, dyadicTimeMid]; rw [hok1_eq]
      have hc_r : c_raw1 (O_at (k + h) ω) = dyadicTimeMid ε (k + h) (c_val ω) := rfl
      have h_ek_le : ε ^ (k + h) ≤ ε ^ k :=
        Real.rpow_le_rpow_of_exponent_ge hε_pos (by linarith only [hε_lt_half]) (by linarith only [hh_pos])
      have hc_diff : |c_raw1 (O_at (k + h) ω) - c_base| ≤ ε ^ k := by
        rw [hc_b, hc_r]
        have h1 := (hdy_k.2.2.2.2.1 (hc_val_mem ω)).2.2.2
        have h2 := (hdy_kh.2.2.2.2.1 (hc_val_mem ω)).2.2.2
        calc |dyadicTimeMid ε (k + h) (c_val ω) - dyadicTimeMid ε k (c_val ω)|
            ≤ |c_val ω - dyadicTimeMid ε (k + h) (c_val ω)| +
                |c_val ω - dyadicTimeMid ε k (c_val ω)| := by
              rw [abs_sub_comm (c_val ω)]; exact abs_sub_le _ _ _
          _ ≤ (1 / 2) * ε ^ (k + h) + (1 / 2) * ε ^ k := add_le_add h2 h1
          _ ≤ ε ^ k := by linarith only [h_ek_le]
      have hc_pt_bd : |c_pt1 (O_at (k + h) ω)| ≤ B_iso + 6 := by
        dsimp [c_pt1]
        rw [abs_mul, abs_of_pos h_ek_pos]
        calc ε ^ (-k) * |c_raw1 (O_at (k + h) ω) - c_base|
            ≤ ε ^ (-k) * ε ^ k := mul_le_mul_of_nonneg_left hc_diff h_ek_pos.le
          _ = 1 := h_ek_k
          _ ≤ B_iso + 6 := by linarith only [hB_iso]
      have hx_bd : ∀ i : Fin 2, |x_pt1 (O_at (k + h) ω) i| ≤ B_iso + 6 := by
        intro i
        let xk := (A_part (T_idx ω) + (dyadicTimeMid ε k (c_val ω)) • V_part (T_idx ω)) i
        let xkh := (A_part (T_idx ω) + (dyadicTimeMid ε (k + h) (c_val ω)) • V_part (T_idx ω)) i
        have hxb : xb_fn i = dyadicRealMid ε k xk := by
          fin_cases i
          · dsimp [xb_fn, dyadicRealMid, xk]; rw [hok21_eq]; rfl
          · dsimp [xb_fn, dyadicRealMid, xk]; rw [hok22_eq]; rfl
        have hxr : x_raw1 (O_at (k + h) ω) i = dyadicRealMid ε (k + h) xkh := by
          fin_cases i <;> rfl
        have hm1 := (hs4_dyadic ε k k 0 k k xk hε_pos hε_lt_half hk_nn le_rfl le_rfl).2.2.2.2.2.2.2.2.2
        have hm2 := (hs4_dyadic ε (k + h) (k + h) 0 (k + h) (k + h) xkh
          hε_pos hε_lt_half (by linarith only [hk_nn, hh_pos]) le_rfl le_rfl).2.2.2.2.2.2.2.2.2
        have hv_i : |V_part (T_idx ω) i| ≤ B_iso :=
          le_trans (h_vec_coord_le _ i) (hVA_bds (T_idx ω)).1
        have hxk_diff : |xkh - xk| ≤ B_iso * ε ^ k := by
          have heq : xkh - xk =
              (dyadicTimeMid ε (k + h) (c_val ω) - dyadicTimeMid ε k (c_val ω)) *
                V_part (T_idx ω) i := by
            dsimp [xk, xkh]; simp; ring
          rw [heq, abs_mul, ← hc_b, ← hc_r, mul_comm]
          exact mul_le_mul hv_i hc_diff (abs_nonneg _) (by linarith only [hB_iso])
        have hraw_diff : |x_raw1 (O_at (k + h) ω) i - xb_fn i| ≤ (B_iso + 2) * ε ^ k := by
          rw [hxb, hxr]
          have htri : |dyadicRealMid ε (k + h) xkh - dyadicRealMid ε k xk| ≤
              |xkh - dyadicRealMid ε (k + h) xkh| + |xkh - xk| + |xk - dyadicRealMid ε k xk| := by
            have h1 := abs_sub_le (dyadicRealMid ε (k + h) xkh) xkh (dyadicRealMid ε k xk)
            have h2 := abs_sub_le xkh xk (dyadicRealMid ε k xk)
            rw [abs_sub_comm (dyadicRealMid ε (k + h) xkh) xkh] at h1
            linarith only [h1, h2]
          have h_alg : (B_iso + 2) * ε ^ k = ε ^ k + B_iso * ε ^ k + ε ^ k := by ring
          linarith only [htri, hm1, hm2, h_ek_le, hxk_diff, h_alg]
        change |ε ^ (-k) * (x_raw1 (O_at (k + h) ω) i - xb_fn i)| ≤ B_iso + 6
        rw [abs_mul, abs_of_pos h_ek_pos]
        calc ε ^ (-k) * |x_raw1 (O_at (k + h) ω) i - xb_fn i|
            ≤ ε ^ (-k) * ((B_iso + 2) * ε ^ k) :=
              mul_le_mul_of_nonneg_left hraw_diff h_ek_pos.le
          _ = (B_iso + 2) * (ε ^ (-k) * ε ^ k) := by ring
          _ = B_iso + 2 := by rw [h_ek_k, mul_one]
          _ ≤ B_iso + 6 := by linarith only []
      exact ⟨hc_pt_bd, hx_bd 0, hx_bd 1⟩

    have hP1_sep : ∀ p₁ ∈ S_P1, ∀ p₂ ∈ S_P1, p₁ ≠ p₂ →
        ρ₁ / 2 ≤ max |c_pt1 p₁ - c_pt1 p₂|
          (max |x_pt1 p₁ 0 - x_pt1 p₂ 0| |x_pt1 p₁ 1 - x_pt1 p₂ 1|) := by
      intro p₁ _ p₂ _ hne
      have hdy := hs4_dyadic ε (k + h) (k + h) 0 (k + h) (k + h) 0
        hε_pos hε_lt_half (by linarith only [hk_nn, hh_pos]) le_rfl le_rfl
      by_cases hk12 : p₁.1 ≠ p₂.1
      · refine le_trans ?_ (le_max_left _ _)
        have hint : (1 : ℝ) ≤ |(p₁.1 : ℝ) - (p₂.1 : ℝ)| := by
          have : (1 : ℤ) ≤ |p₁.1 - p₂.1| := Int.one_le_abs (sub_ne_zero.mpr hk12)
          exact_mod_cast this
        have hstep_lb : (1 / 2) * ε ^ (k + h) ≤ step_tkh := hdy.2.2.1
        have heq : c_pt1 p₁ - c_pt1 p₂ = ε ^ (-k) * (((p₁.1 : ℝ) - (p₂.1 : ℝ)) * step_tkh) := by
          dsimp [c_pt1, c_raw1]; ring
        rw [heq, abs_mul, abs_mul, abs_of_pos h_ek_pos, abs_of_nonneg (by positivity : 0 ≤ step_tkh)]
        calc ρ₁ / 2 = ε ^ (-k) * (1 * ((1 / 2) * ε ^ (k + h))) := by rw [← h_ek_kh]; ring
          _ ≤ ε ^ (-k) * (|(p₁.1 : ℝ) - (p₂.1 : ℝ)| * step_tkh) :=
              mul_le_mul_of_nonneg_left (mul_le_mul hint hstep_lb (by positivity) (by positivity))
                h_ek_pos.le
      · push_neg at hk12
        have hstep_lb : ε ^ (k + h) ≤ dyadicRealStep ε (k + h) := hdy.2.2.2.2.2.2.2.1
        have hstep_nn : 0 ≤ dyadicRealStep ε (k + h) :=
          le_trans (Real.rpow_pos_of_pos hε_pos (k + h)).le hstep_lb
        by_cases hx0 : p₁.2.1 ≠ p₂.2.1
        · refine le_trans ?_ (le_trans (le_max_left _ _) (le_max_right _ _))
          have hint : (1 : ℝ) ≤ |(p₁.2.1 : ℝ) - (p₂.2.1 : ℝ)| := by
            have : (1 : ℤ) ≤ |p₁.2.1 - p₂.2.1| := Int.one_le_abs (sub_ne_zero.mpr hx0)
            exact_mod_cast this
          have heq : x_pt1 p₁ 0 - x_pt1 p₂ 0 =
              ε ^ (-k) * (((p₁.2.1 : ℝ) - (p₂.2.1 : ℝ)) * dyadicRealStep ε (k + h)) := by
            change ε ^ (-k) * (x_raw1 p₁ 0 - xb_fn 0) - ε ^ (-k) * (x_raw1 p₂ 0 - xb_fn 0) = _
            dsimp [x_raw1]; ring
          rw [heq, abs_mul, abs_mul, abs_of_pos h_ek_pos, abs_of_nonneg hstep_nn]
          calc ρ₁ / 2 ≤ ρ₁ := by linarith only [hρ₁_pos]
            _ = ε ^ (-k) * (1 * ε ^ (k + h)) := by rw [← h_ek_kh]; ring
            _ ≤ ε ^ (-k) * (|(p₁.2.1 : ℝ) - (p₂.2.1 : ℝ)| * dyadicRealStep ε (k + h)) :=
                mul_le_mul_of_nonneg_left (mul_le_mul hint hstep_lb
                  (Real.rpow_pos_of_pos hε_pos _).le (by positivity)) h_ek_pos.le
        · push_neg at hx0
          have hx1 : p₁.2.2 ≠ p₂.2.2 := fun hx1 => hne (Prod.ext hk12 (Prod.ext hx0 hx1))
          refine le_trans ?_ (le_trans (le_max_right _ _) (le_max_right _ _))
          have hint : (1 : ℝ) ≤ |(p₁.2.2 : ℝ) - (p₂.2.2 : ℝ)| := by
            have : (1 : ℤ) ≤ |p₁.2.2 - p₂.2.2| := Int.one_le_abs (sub_ne_zero.mpr hx1)
            exact_mod_cast this
          have heq : x_pt1 p₁ 1 - x_pt1 p₂ 1 =
              ε ^ (-k) * (((p₁.2.2 : ℝ) - (p₂.2.2 : ℝ)) * dyadicRealStep ε (k + h)) := by
            change ε ^ (-k) * (x_raw1 p₁ 1 - xb_fn 1) - ε ^ (-k) * (x_raw1 p₂ 1 - xb_fn 1) = _
            dsimp [x_raw1]; simp; ring
          rw [heq, abs_mul, abs_mul, abs_of_pos h_ek_pos, abs_of_nonneg hstep_nn]
          calc ρ₁ / 2 ≤ ρ₁ := by linarith only [hρ₁_pos]
            _ = ε ^ (-k) * (1 * ε ^ (k + h)) := by rw [← h_ek_kh]; ring
            _ ≤ ε ^ (-k) * (|(p₁.2.2 : ℝ) - (p₂.2.2 : ℝ)| * dyadicRealStep ε (k + h)) :=
                mul_le_mul_of_nonneg_left (mul_le_mul hint hstep_lb
                  (Real.rpow_pos_of_pos hε_pos _).le (by positivity)) h_ek_pos.le

    have hV1_bds : ∀ v ∈ S_V1, |v_bar1 v 0| ≤ B_iso + 6 ∧ |v_bar1 v 1| ≤ B_iso + 6 := by
      intro v hv
      obtain ⟨ω, _, rfl⟩ := Finset.mem_image.mp hv
      have h_ibd : ∀ i : Fin 2, |v_bar1 (V_h ω) i| ≤ B_iso + 6 := by
        intro i
        have hmid : v_bar1 (V_h ω) i = dyadicRealMid ε h (V_part (T_idx ω) i) := by
          change (((if i = 0 then (V_h ω).1 else (V_h ω).2) : ℝ) + 1 / 2) * dyadicRealStep ε h = _
          dsimp [V_h, isoVelObs, dyadicRealMid]; fin_cases i <;> simp
        have hm := (hs4_dyadic ε h h 0 h h (V_part (T_idx ω) i)
          hε_pos hε_lt_half hh_pos.le le_rfl le_rfl).2.2.2.2.2.2.2.2.2
        have hv_i : |V_part (T_idx ω) i| ≤ B_iso :=
          le_trans (h_vec_coord_le _ i) (hVA_bds (T_idx ω)).1
        rw [hmid]
        have htri : |dyadicRealMid ε h (V_part (T_idx ω) i)| ≤
            |V_part (T_idx ω) i| + |V_part (T_idx ω) i - dyadicRealMid ε h (V_part (T_idx ω) i)| := by
          have h1 := abs_sub_le (dyadicRealMid ε h (V_part (T_idx ω) i)) (V_part (T_idx ω) i) 0
          rw [sub_zero, sub_zero, abs_sub_comm] at h1
          linarith only [h1]
        linarith only [htri, hv_i, hm, hρ₁_lt1]
      exact ⟨h_ibd 0, h_ibd 1⟩

    have hq_PV1_eq : ∀ p v,
        q_PV1 p v = ∑ ω ∈ E_ok, if O_at (k + h) ω = p ∧ V_h ω = v then q1 ω else 0 := by
      intro p v; dsimp [q_PV1]
      rw [← Finset.sum_subset (Finset.subset_univ E_ok)]
      intro ω _ hnot; simp [hq1_out ω hnot]
    have hq_PV1_sum_V : ∀ p, ∑ v ∈ S_V1, q_PV1 p v =
        ∑ ω : Fin M_ω, if O_at (k + h) ω = p then q1 ω else 0 := by
      intro p; simp_rw [hq_PV1_eq p]; rw [Finset.sum_comm]
      have h1 : ∑ ω ∈ E_ok, ∑ v ∈ S_V1, (if O_at (k + h) ω = p ∧ V_h ω = v then q1 ω else 0) =
          ∑ ω ∈ E_ok, if O_at (k + h) ω = p then q1 ω else 0 := by
        refine Finset.sum_congr rfl (fun ω hω => ?_)
        have hv_in : V_h ω ∈ S_V1 := Finset.mem_image_of_mem V_h hω
        by_cases hp_eq : O_at (k + h) ω = p <;> simp [hp_eq, Finset.sum_ite_eq, hv_in]
      rw [h1, ← Finset.sum_subset (Finset.subset_univ E_ok)]
      intro ω _ hnot; simp [hq1_out ω hnot]
    have hq_PV1_sum_P : ∀ v, ∑ p ∈ S_P1, q_PV1 p v =
        ∑ ω : Fin M_ω, if V_h ω = v then q1 ω else 0 := by
      intro v; simp_rw [fun p => hq_PV1_eq p v]; rw [Finset.sum_comm]
      have h1 : ∑ ω ∈ E_ok, ∑ p ∈ S_P1, (if O_at (k + h) ω = p ∧ V_h ω = v then q1 ω else 0) =
          ∑ ω ∈ E_ok, if V_h ω = v then q1 ω else 0 := by
        refine Finset.sum_congr rfl (fun ω hω => ?_)
        have hp_in : O_at (k + h) ω ∈ S_P1 := Finset.mem_image_of_mem (O_at (k + h)) hω
        by_cases hv_eq : V_h ω = v <;> simp [hv_eq, Finset.sum_ite_eq, hp_in]
      rw [h1, ← Finset.sum_subset (Finset.subset_univ E_ok)]
      intro ω _ hnot; simp [hq1_out ω hnot]
    have hq_PV1_tot : ∑ p ∈ S_P1, ∑ v ∈ S_V1, q_PV1 p v = 1 := by
      simp_rw [hq_PV1_sum_V]; rw [Finset.sum_comm]
      have h1 : ∑ ω : Fin M_ω, ∑ p ∈ S_P1, (if O_at (k + h) ω = p then q1 ω else 0) =
          ∑ ω : Fin M_ω, q1 ω := by
        refine Finset.sum_congr rfl (fun ω _ => ?_)
        by_cases hω : ω ∈ E_ok
        · have hp_in : O_at (k + h) ω ∈ S_P1 := Finset.mem_image_of_mem (O_at (k + h)) hω
          simp [Finset.sum_ite_eq, hp_in]
        · simp [hq1_out ω hω]
      rw [h1, hq1_sum]

    let m_ch1 : ℝ := (c_ret1 / (16 * K_max)) * ρ₁ ^ (-s + 2 * η₀ / h)
    have hm_ch1_pos : 0 < m_ch1 :=
      mul_pos (div_pos hc_ret1_pos (by positivity)) (Real.rpow_pos_of_pos hρ₁_pos _)
    let N_int1 : ℝ := (1936 * K_max / c_ret1) * ρ₁ ^ (-(p_star - s + ζ₁ + 2 * η₀ / h))
    have hN_int1_nn : 0 ≤ N_int1 :=
      mul_nonneg (div_nonneg (by positivity) hc_ret1_pos.le) (Real.rpow_pos_of_pos hρ₁_pos _).le

    have h_int_v1 : ∀ v ∈ S_V1, ∃ I_v : Finset (ℤ × ℤ), (I_v.card : ℝ) ≤ N_int1 ∧
        ∀ p ∈ S_P1, 0 < q_PV1 p v →
          (⌊(x_pt1 p 0 - c_pt1 p * v_bar1 v 0) / ρ₁⌋,
           ⌊(x_pt1 p 1 - c_pt1 p * v_bar1 v 1) / ρ₁⌋) ∈ I_v := by
      intro v _
      let E_v := @Finset.filter (ℤ × ℤ × ℤ) (fun p => 0 < q_PV1 p v)
        (fun _ => Classical.propDecidable _) S_P1
      let I_v := E_v.image (fun p =>
        (⌊(x_pt1 p 0 - c_pt1 p * v_bar1 v 0) / ρ₁⌋,
         ⌊(x_pt1 p 1 - c_pt1 p * v_bar1 v 1) / ρ₁⌋))
      refine ⟨I_v, ?_, fun p hp hq_pos => Finset.mem_image_of_mem _
        ((@Finset.mem_filter _ _ (fun _ => Classical.propDecidable _) _ _).mpr ⟨hp, hq_pos⟩)⟩
      have h_step_int := hs1_int S_P1 E_v c_pt1 x_pt1 (v_bar1 v) ρ₁ 4 m_ch1
        hρ₁_pos (by norm_num) hm_ch1_pos
        (@Finset.filter_subset _ _ (fun _ => Classical.propDecidable _) _) (fun p hp => by
          have hq_pos : 0 < q_PV1 p v :=
            ((@Finset.mem_filter _ _ (fun _ => Classical.propDecidable _) _ _).mp hp).2
          rw [hq_PV1_eq p v] at hq_pos
          obtain ⟨ω_p, hω_p_in, hω_p_ne⟩ := Finset.exists_ne_zero_of_sum_ne_zero hq_pos.ne'
          simp only [ne_eq, ite_eq_right_iff, Classical.not_imp] at hω_p_ne
          obtain ⟨⟨hp_eq, hv_eq⟩, hq1_ne⟩ := hω_p_ne
          have hq1_pos : 0 < q1 ω_p := lt_of_le_of_ne (hq1_nn ω_p) (Ne.symm hq1_ne)
          let E_par := E_ok.filter (fun ω' => Par1 ω' = Par1 ω_p)
          let F_p := E_par.image (O_at (k + h))
          refine ⟨F_p, Finset.image_subset_iff.mpr (fun ω' hω' =>
            Finset.mem_image_of_mem _ (Finset.mem_filter.mp hω').1), ?_, ?_⟩
          · have hpar_ret := hq1_par ω_p hq1_pos
            let k_kh_fn := fun ω' => dyadicTimeBin ε (k + h) (c_val ω')
            let p_par := finProbAt π_amb Par1 ω_p
            have hp_par_eq : p_par = ∑ ω' : Fin M_ω, if Par1 ω' = Par1 ω_p then π_amb ω' else 0 :=
              h_probAt_eq π_amb Par1 ω_p
            have hp_par_pos : 0 < p_par := by
              rw [hp_par_eq]
              have hle := Finset.single_le_sum
                (f := fun ω' : Fin M_ω => if Par1 ω' = Par1 ω_p then π_amb ω' else 0)
                (fun ω' _ => by split_ifs <;> linarith only [hπ_amb_nn ω']) (Finset.mem_univ ω_p)
              simp only [↓reduceIte] at hle
              exact lt_of_lt_of_le (hπ_amb_pos_c ω_p).1 hle
            have hω_p_π0 : 0 < π₀ ω_p := hE_good1_pos ω_p (Finset.mem_filter.mp hω_p_in).1
            have ht_k := (h_time_u k hk_in_U ω_p hω_p_π0).1
            have hp_par_lb : ε ^ (s * k + η₀) * finProbAt π_amb T_idx ω_p ≤ p_par := by
              have hpair : p_par = finProbAt2 π_amb T_idx (fun ω' => dyadicTimeBin ε k (c_val ω')) ω_p :=
                h_probAt_pair π_amb T_idx _ ω_p
              have hT_pos : 0 < finProbAt π_amb T_idx ω_p := by
                rw [h_probAt_eq]
                have hle := Finset.single_le_sum
                  (f := fun ω' : Fin M_ω => if T_idx ω' = T_idx ω_p then π_amb ω' else 0)
                  (fun ω' _ => by split_ifs <;> linarith only [hπ_amb_nn ω']) (Finset.mem_univ ω_p)
                simp only [↓reduceIte] at hle
                exact lt_of_lt_of_le (hπ_amb_pos_c ω_p).1 hle
              rw [hpair]; exact (le_div_iff₀ hT_pos).mp ht_k
            let μ_max : ℝ := ε ^ (s * h - 2 * η₀) * p_par
            have hμ_max_pos : 0 < μ_max := mul_pos (Real.rpow_pos_of_pos hε_pos _) hp_par_pos
            have h_fib_ub : ∀ kt ∈ E_par.image k_kh_fn,
                (∑ ω' ∈ E_par.filter (fun ω' => k_kh_fn ω' = kt), π_amb ω') ≤ μ_max := by
              intro kt hkt
              obtain ⟨ω_t, hω_t_in, rfl⟩ := Finset.mem_image.mp hkt
              have hω_t_ok : ω_t ∈ E_ok := (Finset.mem_filter.mp hω_t_in).1
              have hω_t_par : Par1 ω_t = Par1 ω_p := (Finset.mem_filter.mp hω_t_in).2
              have hω_t_tid : T_idx ω_t = T_idx ω_p := (Prod.ext_iff.mp hω_t_par).1
              have hω_t_π0 : 0 < π₀ ω_t := hE_good1_pos ω_t (Finset.mem_filter.mp hω_t_ok).1
              have ht_kh := (h_time_u (k + h) hkh_in_U ω_t hω_t_π0).2
              have hT_eq : finProbAt π_amb T_idx ω_t = finProbAt π_amb T_idx ω_p := by
                rw [h_probAt_eq, h_probAt_eq]; simp_rw [hω_t_tid]
              have hT_pos : 0 < finProbAt π_amb T_idx ω_t := by
                rw [hT_eq, h_probAt_eq]
                have hle := Finset.single_le_sum
                  (f := fun ω' : Fin M_ω => if T_idx ω' = T_idx ω_p then π_amb ω' else 0)
                  (fun ω' _ => by split_ifs <;> linarith only [hπ_amb_nn ω']) (Finset.mem_univ ω_p)
                simp only [↓reduceIte] at hle
                exact lt_of_lt_of_le (hπ_amb_pos_c ω_p).1 hle
              have h_sub_sum : ∑ ω' ∈ E_par.filter (fun ω' => k_kh_fn ω' = k_kh_fn ω_t), π_amb ω' ≤
                  finProbAt2 π_amb T_idx k_kh_fn ω_t := by
                rw [h_probAt2_eq, ← Finset.sum_filter]
                refine Finset.sum_le_sum_of_subset_of_nonneg (fun ω' hω' => ?_) (fun ω' _ _ => hπ_amb_nn ω')
                obtain ⟨h1, h2⟩ := Finset.mem_filter.mp hω'
                have htid' : T_idx ω' = T_idx ω_p := (Prod.ext_iff.mp (Finset.mem_filter.mp h1).2).1
                exact Finset.mem_filter.mpr ⟨Finset.mem_univ _, htid'.trans hω_t_tid.symm, h2⟩
              have h_le1 : finProbAt2 π_amb T_idx k_kh_fn ω_t ≤
                  ε ^ (s * (k + h) - η₀) * finProbAt π_amb T_idx ω_p := by
