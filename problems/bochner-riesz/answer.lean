    have h_inc_lb : ρ_tilde ^ η₀ ≤
        ∑ i : Fin N_P, ∑ b₂ : Fin N_Θ, if G_sl i b₂ then μ_sl i * lam_free b₂ else 0 := by
      have h_pt : ∀ (i : Fin N_P) (b₂ : Fin N_Θ),
          (if N_bin i = n_star ∧ bX i = kX_star then ν_star i b₂ / p_sl else 0) ≤
          ρ_tilde ^ (-η_sl) * (if G_sl i b₂ then μ_sl i * lam_free b₂ else 0) := by
        intro i b₂
        by_cases hNX : N_bin i = n_star ∧ bX i = kX_star
        · rw [if_pos hNX]
          by_cases hpos : 0 < ν_star i b₂
          · have hG : G_sl i b₂ := ⟨hpos, hNX⟩
            rw [if_pos hG]
            dsimp [μ_sl]
            rw [if_pos hNX]
            have hd := div_le_div_of_nonneg_right (hν_star_pair i b₂) hp_sl_pos.le
            linarith [show ρ_tilde ^ (-η_sl) * ν_P i * lam_free b₂ / p_sl =
              ρ_tilde ^ (-η_sl) * (ν_P i / p_sl * lam_free b₂) by ring]
          · have h0 : ν_star i b₂ = 0 := le_antisymm (not_lt.mp hpos) (hν_star_nn i b₂)
            have hnG : ¬ G_sl i b₂ := fun hG => hpos hG.1
            rw [if_neg hnG, h0, zero_div, mul_zero]
        · have hnG : ¬ G_sl i b₂ := fun hG => hNX hG.2
          rw [if_neg hNX, if_neg hnG, mul_zero]
      have h_lhs1 : (∑ i : Fin N_P, ∑ b₂ : Fin N_Θ,
          if N_bin i = n_star ∧ bX i = kX_star then ν_star i b₂ / p_sl else 0) = 1 := by
        calc (∑ i : Fin N_P, ∑ b₂ : Fin N_Θ,
                if N_bin i = n_star ∧ bX i = kX_star then ν_star i b₂ / p_sl else 0)
            = ∑ i : Fin N_P, μ_sl i := by
              refine Finset.sum_congr rfl (fun i _ => ?_)
              dsimp [μ_sl, ν_P]
              by_cases hNX : N_bin i = n_star ∧ bX i = kX_star
              · simp only [hNX, and_self, ↓reduceIte, ← Finset.sum_div]
              · simp [hNX]
          _ = 1 := hμ_sl_sum
      have h_one_le : 1 ≤ ρ_tilde ^ (-η_sl) *
          (∑ i : Fin N_P, ∑ b₂ : Fin N_Θ, if G_sl i b₂ then μ_sl i * lam_free b₂ else 0) := by
        rw [← h_lhs1]
        calc (∑ i : Fin N_P, ∑ b₂ : Fin N_Θ,
                if N_bin i = n_star ∧ bX i = kX_star then ν_star i b₂ / p_sl else 0)
            ≤ ∑ i : Fin N_P, ∑ b₂ : Fin N_Θ,
                ρ_tilde ^ (-η_sl) * (if G_sl i b₂ then μ_sl i * lam_free b₂ else 0) :=
              Finset.sum_le_sum (fun i _ => Finset.sum_le_sum (fun b₂ _ => h_pt i b₂))
          _ = ρ_tilde ^ (-η_sl) *
                (∑ i : Fin N_P, ∑ b₂ : Fin N_Θ, if G_sl i b₂ then μ_sl i * lam_free b₂ else 0) := by
              rw [Finset.mul_sum]
              exact Finset.sum_congr rfl (fun i _ => (Finset.mul_sum _ _ _).symm)
      calc ρ_tilde ^ η₀
          ≤ ρ_tilde ^ η_sl :=
            Real.rpow_le_rpow_of_exponent_ge hρ_t_pos hρ_t_le1 (by dsimp [η_sl]; linarith)
        _ = ρ_tilde ^ η_sl * 1 := (mul_one _).symm
        _ ≤ ρ_tilde ^ η_sl * (ρ_tilde ^ (-η_sl) *
              (∑ i : Fin N_P, ∑ b₂ : Fin N_Θ, if G_sl i b₂ then μ_sl i * lam_free b₂ else 0)) :=
            mul_le_mul_of_nonneg_left h_one_le (Real.rpow_nonneg hρ_t_pos.le _)
        _ = ∑ i : Fin N_P, ∑ b₂ : Fin N_Θ, if G_sl i b₂ then μ_sl i * lam_free b₂ else 0 := by
            rw [← mul_assoc, ← Real.rpow_add hρ_t_pos, add_neg_cancel, Real.rpow_zero, one_mul]

    exact h_proj_inst ρ_tilde M N_P N_Θ μ_sl x_P lam_free a_B G_sl
      hρ_t_pos hρ_t_lt_ρ₀ hM_pos
      hμ_sl_nn hμ_sl_sum hx_P_bd
      (fun z₀ r hr₀ hr₁ => by
