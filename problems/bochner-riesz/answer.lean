  have hFib₂_card : ∀ d₂, (Fib₂ d₂).card ≤ (⌊4 * e⌋₊ + 2) * 13068 := by
    intro d₂
    have hc_coarse : (Finset.Icc (-3 : ℤ) 2).card = 6 := by decide
    have hc_fine : ∀ k : ℤ, (Finset.Icc (k - 5) (k + 5)).card = 11 := fun k => by
      rw [Int.card_Icc]
      omega
    have h_box_le : ∀ kt kc, (box4 kt d₂ kc).card ≤ 4356 := by
      intro kt kc
      calc (box4 kt d₂ kc).card
          ≤ (((Finset.Icc (-3 : ℤ) 2 ×ˢ _) ×ˢ (Finset.Icc (-3 : ℤ) 2 ×ˢ _))).card :=
            Finset.card_image_le
        _ = (6 * 11) * (6 * 11) := by
