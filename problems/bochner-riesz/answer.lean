  have h_step_ent : ∀ᶠ k : ℕ in Filter.atTop, ∀ r ∈ Finset.range Q,
      (15 / 4 : ℝ) * σ * τ ≤ finCondEntropy (sys.ε_seq k) (sys.π_seq k)
