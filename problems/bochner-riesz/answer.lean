      |avgQ iu h δ_box (p + Δ • e) - avgQ iu h δ_box p - α * Δ| ≤
        |Δ| * (δ_box ^ (n + 1))⁻¹ * errFn M h iu := by
    intro iu h δ_box M p e d_α α partFn Δ hh hδ he_norm hpart_meas hpart_bds hα0 hα1
      hpart_def hf_dir hpart_err htube
    by_cases hΔ : Δ = 0
    · subst hΔ
      simp
    let a₀ := min (0 : ℝ) Δ
    let b₀ := max (0 : ℝ) Δ
    have hab_lt : a₀ < b₀ := min_lt_max.mpr (Ne.symm hΔ)
    let ψ : ((Fin n → ℝ) × ℝ) → ℝ → ℝ := fun w t =>
      (f (planeEmbed n c iu + h • (p + t • e + w)) - f (planeEmbed n c iu)) / h
    let K_err : ((Fin n → ℝ) × ℝ) × ℝ → ℝ := fun wt =>
