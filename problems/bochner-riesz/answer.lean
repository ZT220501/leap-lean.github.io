    intro s M_fib K₀ hs hM_fib hK₀ V_P τ N_Q V_T c_T W M_ker h_fib h_ker
    let r : Fin N_Q → ℝ := fun T => inner ℝ (V_T T - V_P) τ / s
    let q : Fin N_Q → ℤ := fun T => Int.floor (r T)
    let w_Z : ℤ → ℤ → ℝ := fun m₁ m₂ => ((1 + |(m₁ : ℝ) - (m₂ : ℝ)|) ^ 2)⁻¹
    have hw_nn : ∀ m₁ m₂ : ℤ, 0 ≤ w_Z m₁ m₂ := fun m₁ m₂ => by
      dsimp only [w_Z]; positivity
    have hw_symm : ∀ m₁ m₂ : ℤ, w_Z m₁ m₂ = w_Z m₂ m₁ := fun m₁ m₂ => by
      dsimp only [w_Z]
      rw [abs_sub_comm]
    have h_pt_ker : ∀ T₁ ∈ W, ∀ T₂ ∈ W,
        M_ker T₁ T₂ ≤ 16 * K₀ * w_Z (q T₁) (q T₂) := by
      intro T₁ hT₁ T₂ hT₂
      have hr_diff : |r T₁ - r T₂| = |inner ℝ (V_T T₁ - V_T T₂) τ| / s := by
        dsimp only [r]
        have h_sub : (V_T T₁ - V_P) - (V_T T₂ - V_P) = V_T T₁ - V_T T₂ := by abel
        rw [← sub_div, ← inner_sub_left, h_sub, abs_div, abs_of_pos hs]
      have hq_le1 : (q T₁ : ℝ) - (q T₂ : ℝ) ≤ |r T₁ - r T₂| + 1 := by
        have h1 : (q T₁ : ℝ) ≤ r T₁ := Int.floor_le (r T₁)
        have h2 : r T₂ < (q T₂ : ℝ) + 1 := Int.lt_floor_add_one (r T₂)
        linarith [le_abs_self (r T₁ - r T₂)]
      have hq_le2 : (q T₂ : ℝ) - (q T₁ : ℝ) ≤ |r T₁ - r T₂| + 1 := by
        have h1 : (q T₂ : ℝ) ≤ r T₂ := Int.floor_le (r T₂)
        have h2 : r T₁ < (q T₁ : ℝ) + 1 := Int.lt_floor_add_one (r T₁)
        have h3 : r T₂ - r T₁ ≤ |r T₂ - r T₁| := le_abs_self _
        rw [abs_sub_comm] at h3
        linarith
      have hq_abs : |(q T₁ : ℝ) - (q T₂ : ℝ)| ≤ |r T₁ - r T₂| + 1 :=
        abs_sub_le_iff.mpr ⟨hq_le1, hq_le2⟩
      let d_q : ℝ := 1 + |(q T₁ : ℝ) - (q T₂ : ℝ)|
      let d_r : ℝ := 1 + |r T₁ - r T₂|
      have hd_q_ge1 : 1 ≤ d_q := by
        dsimp only [d_q]
        linarith [abs_nonneg ((q T₁ : ℝ) - (q T₂ : ℝ))]
      have hd_r_pos : 0 < d_r := by dsimp only [d_r]; positivity
      have hd_q_le : d_q ≤ 2 * d_r := by
        dsimp only [d_q, d_r]
        linarith [hq_abs, abs_nonneg (r T₁ - r T₂)]
      have h_pow2_le4 : d_q ^ 2 ≤ d_q ^ 4 := pow_le_pow_right₀ hd_q_ge1 (by omega)
      have h_pow4_le : d_q ^ 4 ≤ 16 * d_r ^ 4 := by
        calc d_q ^ 4 ≤ (2 * d_r) ^ 4 := pow_le_pow_left₀ (by linarith) hd_q_le 4
          _ = 16 * d_r ^ 4 := by ring
      have h_denom : d_q ^ 2 ≤ 16 * d_r ^ 4 := le_trans h_pow2_le4 h_pow4_le
      calc M_ker T₁ T₂
