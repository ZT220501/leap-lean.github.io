theorem pseudoconformal_slice_reduction (M_cone : ℕ → ℝ) :
    ∃ M_B : ℕ → ℝ,
      ∀ (σ lam C_2d : ℝ), 0 ≤ C_2d →
      ∀ (Φ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ),
        (∀ k : ℕ, ContDiff ℝ k Φ) →
        (∀ (c : ℝ) (x v : EuclideanSpace ℝ (Fin 2)),
          c ∈ Set.Icc (1 / 32) (23 / 32) →
          ‖x‖ ≤ 2 →
          ‖v‖ ≤ 5 →
          Φ (c, x, v) =
            2 * Real.pi * σ * (1 / 4 + 8 * c)⁻¹ *
              Real.sqrt (1 + ‖(8 : ℝ) • x - (1 / 4 + 8 * c) • v‖ ^ 2)) →
      ∀ (a_dir : EuclideanSpace ℝ (Fin 3) → ℂ),
        (∀ k : ℕ, ContDiff ℝ k a_dir) →
        (∀ w : EuclideanSpace ℝ (Fin 3),
          (‖w‖ ≤ 1 / 2 ∨ 2 ≤ ‖w‖ ∨ w 2 ≤ 1 / 6) → a_dir w = 0) →
        (∀ k : ℕ, ∀ w : EuclideanSpace ℝ (Fin 3),
          ‖iteratedFDeriv ℝ k a_dir w‖ ≤ M_cone k) →
      (∃ B_a : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℂ,
        (∀ k : ℕ, ContDiff ℝ k B_a) ∧
        (∀ (c : ℝ) (x v : EuclideanSpace ℝ (Fin 2)),
          (c ∉ Set.Icc 0 1 ∨ 2 ≤ ‖x‖ ∨ 5 ≤ ‖v‖) → B_a (c, x, v) = 0) ∧
        (∀ (k : ℕ) (p : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2)),
          ‖iteratedFDeriv ℝ k B_a p‖ ≤ M_B k) ∧
        ((∀ (f : EuclideanSpace ℝ (Fin 2) → ℂ),
            MeasureTheory.AEStronglyMeasurable f MeasureTheory.volume →
            (∀ v : EuclideanSpace ℝ (Fin 2), 6 ≤ ‖v‖ → f v = 0) →
            MeasureTheory.eLpNorm f 3 MeasureTheory.volume < ⊤ →
            MeasureTheory.eLpNorm (oscIntegralOp2D lam Φ B_a f) 3 MeasureTheory.volume ≤
              ENNReal.ofReal C_2d * MeasureTheory.eLpNorm f 3 MeasureTheory.volume) →
          ∀ (h : EuclideanSpace ℝ (Fin 3) → ℂ),
            Continuous h →
            (∀ y : EuclideanSpace ℝ (Fin 3),
              (∃ i : Fin 3, y i ≤ -3 ∨ 4 ≤ y i) → h y = 0) →
            MeasureTheory.eLpNorm (distPhaseOscOp σ lam a_dir h) 3
              (MeasureTheory.volume.restrict
                { z : EuclideanSpace ℝ (Fin 3) | ∀ i : Fin 3, 0 ≤ z i ∧ z i < 1 }) ≤
              ENNReal.ofReal (60 * C_2d) * MeasureTheory.eLpNorm h 3 MeasureTheory.volume)) :=
by
  
  have h_norm2_sq : ∀ x : EuclideanSpace ℝ (Fin 2), ‖x‖ ^ 2 = (x 0) ^ 2 + (x 1) ^ 2 := by
    intro x
    rw [EuclideanSpace.norm_sq_eq, Fin.sum_univ_two]
    simp [Real.norm_eq_abs, sq_abs]
  have h_norm3_sq : ∀ w : EuclideanSpace ℝ (Fin 3),
      ‖w‖ ^ 2 = (w 0) ^ 2 + (w 1) ^ 2 + (w 2) ^ 2 := by
    intro w
    rw [EuclideanSpace.norm_sq_eq, Fin.sum_univ_three]
    simp [Real.norm_eq_abs, sq_abs]

  
  let L3_toLp : (Fin 3 → ℝ) ≃L[ℝ] EuclideanSpace ℝ (Fin 3) :=
    (PiLp.continuousLinearEquiv 2 ℝ (fun _ : Fin 3 => ℝ)).symm
  let sliceEmbed : EuclideanSpace ℝ (Fin 2) → ℝ → EuclideanSpace ℝ (Fin 3) :=
    fun v y₂ => L3_toLp ![v 0, v 1, y₂]
  let pseudoconformalPt : ℝ → EuclideanSpace ℝ (Fin 2) → EuclideanSpace ℝ (Fin 3) :=
    fun c x => L3_toLp
      ![8 * (1 / 4 + 8 * c)⁻¹ * x 0, 8 * (1 / 4 + 8 * c)⁻¹ * x 1, (1 / 4 + 8 * c)⁻¹]

  
  
  
  let θ_s : ℝ → ℝ := fun c =>
    Real.smoothTransition (64 * (c + 1 / 64)) * Real.smoothTransition (2 - c)
  let s_tilde : ℝ → ℝ := fun c => θ_s c * (1 / 4 + 8 * c) + (1 - θ_s c)
  have hs_tilde_smooth : ∀ k : ℕ, ContDiff ℝ k s_tilde := by
    intro k
    have h1 : ContDiff ℝ k (fun c : ℝ => Real.smoothTransition (64 * (c + 1 / 64))) :=
      Real.smoothTransition.contDiff.comp
        (contDiff_const.mul (contDiff_id.add contDiff_const))
    have h2 : ContDiff ℝ k (fun c : ℝ => Real.smoothTransition (2 - c)) :=
      Real.smoothTransition.contDiff.comp (contDiff_const.sub contDiff_id)
    have hθ : ContDiff ℝ k θ_s := h1.mul h2
    exact (hθ.mul (contDiff_const.add (contDiff_const.mul contDiff_id))).add
      (contDiff_const.sub hθ)
  have hs_tilde_ge : ∀ c : ℝ, 1 / 8 ≤ s_tilde c := by
    intro c
    have hθ_nn : 0 ≤ θ_s c :=
      mul_nonneg (Real.smoothTransition.nonneg _) (Real.smoothTransition.nonneg _)
    have hθ_le : θ_s c ≤ 1 := by
      dsimp [θ_s]
      nlinarith [Real.smoothTransition.le_one (64 * (c + 1 / 64)),
        Real.smoothTransition.nonneg (64 * (c + 1 / 64)),
        Real.smoothTransition.le_one (2 - c),
        Real.smoothTransition.nonneg (2 - c)]
    by_cases hc : c ≤ -1 / 64
    · have h0 : Real.smoothTransition (64 * (c + 1 / 64)) = 0 :=
        Real.smoothTransition.zero_of_nonpos (by linarith)
      have hθ0 : θ_s c = 0 := by dsimp [θ_s]; rw [h0, zero_mul]
      dsimp [s_tilde]
      rw [hθ0]
      norm_num
    · push Not at hc
      dsimp [s_tilde]
      nlinarith
  have hs_tilde_ne : ∀ c : ℝ, s_tilde c ≠ 0 := fun c => by
    have := hs_tilde_ge c
    linarith
  have hs_tilde_eq : ∀ c ∈ Set.Icc (0 : ℝ) 1, s_tilde c = 1 / 4 + 8 * c := by
    intro c hc
    have h1 : Real.smoothTransition (64 * (c + 1 / 64)) = 1 :=
      Real.smoothTransition.one_of_one_le (by linarith [hc.1])
    have h2 : Real.smoothTransition (2 - c) = 1 :=
      Real.smoothTransition.one_of_one_le (by linarith [hc.2])
    have hθ1 : θ_s c = 1 := by dsimp [θ_s]; rw [h1, h2, mul_one]
    dsimp [s_tilde]
    rw [hθ1]
    ring

  let W : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → EuclideanSpace ℝ (Fin 3) :=
    fun p => L3_toLp
      ![8 * (s_tilde p.1)⁻¹ * p.2.1 0 - p.2.2 0,
        8 * (s_tilde p.1)⁻¹ * p.2.1 1 - p.2.2 1,
        (s_tilde p.1)⁻¹]
  let θ_c : ℝ → ℝ := fun c =>
    Real.smoothTransition (64 * (c - 1 / 64)) * Real.smoothTransition (8 * (7 / 8 - c))
  let χ_x : EuclideanSpace ℝ (Fin 2) → ℝ := fun x =>
    Real.smoothTransition (15 / 4 - ((x 0) ^ 2 + (x 1) ^ 2))
  let χ_v : EuclideanSpace ℝ (Fin 2) → ℝ := fun v =>
    Real.smoothTransition (24 - ((v 0) ^ 2 + (v 1) ^ 2))
  let Θ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ :=
    fun p => θ_c p.1 * χ_x p.2.1 * χ_v p.2.2

  let proj2_0 : EuclideanSpace ℝ (Fin 2) →L[ℝ] ℝ := PiLp.proj 2 (fun _ : Fin 2 => ℝ) 0
  let proj2_1 : EuclideanSpace ℝ (Fin 2) →L[ℝ] ℝ := PiLp.proj 2 (fun _ : Fin 2 => ℝ) 1

  have hW_smooth : ∀ k : ℕ, ContDiff ℝ k W := by
    intro k
    have hsinv : ContDiff ℝ k
        (fun p : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) => (s_tilde p.1)⁻¹) :=
      ((hs_tilde_smooth k).comp contDiff_fst).inv (fun p => hs_tilde_ne p.1)
    have hx0 : ContDiff ℝ k
        (fun p : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) => p.2.1 0) :=
      proj2_0.contDiff.comp contDiff_snd.fst
    have hx1 : ContDiff ℝ k
        (fun p : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) => p.2.1 1) :=
      proj2_1.contDiff.comp contDiff_snd.fst
    have hv0 : ContDiff ℝ k
        (fun p : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) => p.2.2 0) :=
      proj2_0.contDiff.comp contDiff_snd.snd
    have hv1 : ContDiff ℝ k
        (fun p : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) => p.2.2 1) :=
      proj2_1.contDiff.comp contDiff_snd.snd
    refine L3_toLp.contDiff.comp (contDiff_pi.mpr (fun i => ?_))
    fin_cases i
    · simpa using ((contDiff_const.mul hsinv).mul hx0).sub hv0
    · simpa using ((contDiff_const.mul hsinv).mul hx1).sub hv1
    · simpa using hsinv

  have hΘ_smooth : ∀ k : ℕ, ContDiff ℝ k Θ := by
    intro k
    have hst : ContDiff ℝ k Real.smoothTransition := Real.smoothTransition.contDiff
    have hc1 : ContDiff ℝ k
        (fun p : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) =>
          Real.smoothTransition (64 * (p.1 - 1 / 64))) :=
      hst.comp (contDiff_const.mul (contDiff_fst.sub contDiff_const))
    have hc2 : ContDiff ℝ k
        (fun p : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) =>
          Real.smoothTransition (8 * (7 / 8 - p.1))) :=
      hst.comp (contDiff_const.mul (contDiff_const.sub contDiff_fst))
    have hx0 : ContDiff ℝ k
        (fun p : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) => p.2.1 0) :=
      proj2_0.contDiff.comp contDiff_snd.fst
    have hx1 : ContDiff ℝ k
        (fun p : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) => p.2.1 1) :=
      proj2_1.contDiff.comp contDiff_snd.fst
    have hv0 : ContDiff ℝ k
        (fun p : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) => p.2.2 0) :=
      proj2_0.contDiff.comp contDiff_snd.snd
    have hv1 : ContDiff ℝ k
        (fun p : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) => p.2.2 1) :=
      proj2_1.contDiff.comp contDiff_snd.snd
    have hχx : ContDiff ℝ k
        (fun p : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) => χ_x p.2.1) :=
      hst.comp (contDiff_const.sub ((hx0.pow 2).add (hx1.pow 2)))
    have hχv : ContDiff ℝ k
        (fun p : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) => χ_v p.2.2) :=
      hst.comp (contDiff_const.sub ((hv0.pow 2).add (hv1.pow 2)))
    exact ((hc1.mul hc2).mul hχx).mul hχv

  let K_B : Set (ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2)) :=
    Set.Icc (0 : ℝ) 1 ×ˢ
      (Metric.closedBall (0 : EuclideanSpace ℝ (Fin 2)) 2 ×ˢ
        Metric.closedBall (0 : EuclideanSpace ℝ (Fin 2)) 5)
  have hK_B_compact : IsCompact K_B :=
    isCompact_Icc.prod ((isCompact_closedBall _ _).prod (isCompact_closedBall _ _))

  have h_exists_KΘ : ∀ i : ℕ, ∃ B : ℝ, 0 ≤ B ∧ ∀ p ∈ K_B, ‖iteratedFDeriv ℝ i Θ p‖ ≤ B := by
    intro i
    have hc : Continuous (fun p => iteratedFDeriv ℝ i Θ p) :=
      (hΘ_smooth i).continuous_iteratedFDeriv le_rfl
    obtain ⟨B, hB⟩ := hK_B_compact.exists_bound_of_continuousOn hc.continuousOn
    exact ⟨max B 0, le_max_right _ _, fun p hp => le_trans (hB p hp) (le_max_left _ _)⟩
  have h_exists_KW : ∀ i : ℕ, ∃ B : ℝ, 0 ≤ B ∧ ∀ p ∈ K_B, ‖iteratedFDeriv ℝ i W p‖ ≤ B := by
    intro i
    have hc : Continuous (fun p => iteratedFDeriv ℝ i W p) :=
      (hW_smooth i).continuous_iteratedFDeriv le_rfl
    obtain ⟨B, hB⟩ := hK_B_compact.exists_bound_of_continuousOn hc.continuousOn
    exact ⟨max B 0, le_max_right _ _, fun p hp => le_trans (hB p hp) (le_max_left _ _)⟩

  let K_Θ : ℕ → ℝ := fun i => Classical.choose (h_exists_KΘ i)
  have hK_Θ_spec : ∀ i : ℕ, 0 ≤ K_Θ i ∧ ∀ p ∈ K_B, ‖iteratedFDeriv ℝ i Θ p‖ ≤ K_Θ i :=
    fun i => Classical.choose_spec (h_exists_KΘ i)
  let K_W : ℕ → ℝ := fun i => Classical.choose (h_exists_KW i)
  have hK_W_spec : ∀ i : ℕ, 0 ≤ K_W i ∧ ∀ p ∈ K_B, ‖iteratedFDeriv ℝ i W p‖ ≤ K_W i :=
    fun i => Classical.choose_spec (h_exists_KW i)

  let C_cone : ℕ → ℝ := fun n => ∑ j ∈ Finset.range (n + 1), max (M_cone j) 0
  let D_W : ℕ → ℝ := fun n => 1 + ∑ j ∈ Finset.range (n + 1), K_W j
  let M_B : ℕ → ℝ := fun k =>
    ∑ i ∈ Finset.range (k + 1),
      (k.choose i : ℝ) * K_Θ i * ((k - i).factorial : ℝ) * C_cone (k - i) * D_W (k - i) ^ (k - i)

  have hC_cone_nn : ∀ n : ℕ, 0 ≤ C_cone n :=
    fun n => Finset.sum_nonneg (fun j _ => le_max_right _ _)
  have hD_W_ge_one : ∀ n : ℕ, 1 ≤ D_W n := by
    intro n
    have hsum : 0 ≤ ∑ j ∈ Finset.range (n + 1), K_W j :=
      Finset.sum_nonneg (fun j _ => (hK_W_spec j).1)
    dsimp [D_W]
    linarith
  have hM_B_nn : ∀ k : ℕ, 0 ≤ M_B k := by
    intro k
    refine Finset.sum_nonneg (fun i _ => ?_)
    have h1 : 0 ≤ (k.choose i : ℝ) := Nat.cast_nonneg _
    have h2 : 0 ≤ K_Θ i := (hK_Θ_spec i).1
    have h3 : 0 ≤ ((k - i).factorial : ℝ) := Nat.cast_nonneg _
    have h4 : 0 ≤ C_cone (k - i) := hC_cone_nn (k - i)
    have h5 : 0 ≤ D_W (k - i) ^ (k - i) :=
      pow_nonneg (by linarith [hD_W_ge_one (k - i)]) _
    positivity

  refine ⟨M_B, ?_⟩
  intro σ lam C_2d hC_2d Φ hΦ_smooth hΦ_eq a_dir ha_dir_smooth ha_dir_supp ha_dir_deriv

  let B_a : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℂ :=
    fun p => Θ p • a_dir (W p)

  have hB_smooth : ∀ k : ℕ, ContDiff ℝ k B_a :=
    fun k => (hΘ_smooth k).smul ((ha_dir_smooth k).comp (hW_smooth k))

  have hB_supp : ∀ (c : ℝ) (x v : EuclideanSpace ℝ (Fin 2)),
      (c ∉ Set.Icc 0 1 ∨ 2 ≤ ‖x‖ ∨ 5 ≤ ‖v‖) → B_a (c, x, v) = 0 := by
    intro c x v hcond
    have hΘ0 : Θ (c, x, v) = 0 := by
      rcases hcond with hc | hx | hv
      · have hc' : c < 0 ∨ 1 < c := by
          by_contra h_not
          push Not at h_not
          exact hc ⟨h_not.1, h_not.2⟩
        rcases hc' with hlt | hgt
        · have h0 : Real.smoothTransition (64 * (c - 1 / 64)) = 0 :=
            Real.smoothTransition.zero_of_nonpos (by linarith)
          dsimp [Θ, θ_c]; rw [h0]; ring
        · have h0 : Real.smoothTransition (8 * (7 / 8 - c)) = 0 :=
            Real.smoothTransition.zero_of_nonpos (by linarith)
          dsimp [Θ, θ_c]; rw [h0]; ring
      · have hx_sq : 4 ≤ (x 0) ^ 2 + (x 1) ^ 2 := by
          have : 2 ^ 2 ≤ ‖x‖ ^ 2 := pow_le_pow_left₀ (by norm_num) hx 2
          linarith [h_norm2_sq x]
        have h0 : χ_x x = 0 :=
          Real.smoothTransition.zero_of_nonpos (by dsimp [χ_x]; linarith)
        dsimp [Θ]; rw [h0]; ring
      · have hv_sq : 25 ≤ (v 0) ^ 2 + (v 1) ^ 2 := by
          have : 5 ^ 2 ≤ ‖v‖ ^ 2 := pow_le_pow_left₀ (by norm_num) hv 2
          linarith [h_norm2_sq v]
        have h0 : χ_v v = 0 :=
          Real.smoothTransition.zero_of_nonpos (by dsimp [χ_v]; linarith)
        dsimp [Θ]; rw [h0]; ring
    simp [B_a, hΘ0]

  have hB_deriv : ∀ (k : ℕ) (p : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2)),
      ‖iteratedFDeriv ℝ k B_a p‖ ≤ M_B k := by
    intro k p
    by_cases hp : p ∈ K_B
    · have h_smul := norm_iteratedFDeriv_smul_le (hΘ_smooth k)
        ((ha_dir_smooth k).comp (hW_smooth k)) p (le_rfl : (k : WithTop ℕ∞) ≤ k)
      refine le_trans h_smul ?_
      dsimp [M_B]
      refine Finset.sum_le_sum (fun i hi => ?_)
      let n := k - i
      have h_comp : ‖iteratedFDeriv ℝ n (a_dir ∘ W) p‖ ≤
          (n.factorial : ℝ) * C_cone n * D_W n ^ n := by
        refine norm_iteratedFDeriv_comp_le (ha_dir_smooth n) (hW_smooth n)
          (le_rfl : (n : WithTop ℕ∞) ≤ n) p ?_ ?_
        · intro j hj
          refine le_trans (ha_dir_deriv j (W p)) (le_trans (le_max_left (M_cone j) 0) ?_)
          exact Finset.single_le_sum (fun m _ => le_max_right (M_cone m) 0)
            (Finset.mem_range.mpr (Nat.lt_succ_of_le hj))
        · intro j hj1 hjn
          have hKW_le : K_W j ≤ D_W n := by
            have h_in : K_W j ≤ ∑ m ∈ Finset.range (n + 1), K_W m :=
              Finset.single_le_sum (fun m _ => (hK_W_spec m).1)
                (Finset.mem_range.mpr (Nat.lt_succ_of_le hjn))
            dsimp [D_W]
            linarith
          have h_pow : D_W n ≤ D_W n ^ j := by
            simpa using pow_le_pow_right₀ (hD_W_ge_one n) hj1
          exact le_trans ((hK_W_spec j).2 p hp) (le_trans hKW_le h_pow)
      have hΘ_bound : ‖iteratedFDeriv ℝ i Θ p‖ ≤ K_Θ i := (hK_Θ_spec i).2 p hp
      calc (k.choose i : ℝ) * ‖iteratedFDeriv ℝ i Θ p‖ *
              ‖iteratedFDeriv ℝ n (fun y => a_dir (W y)) p‖
          = (k.choose i : ℝ) * ‖iteratedFDeriv ℝ i Θ p‖ *
              ‖iteratedFDeriv ℝ n (a_dir ∘ W) p‖ := rfl
        _ ≤ (k.choose i : ℝ) * K_Θ i *
              ((n.factorial : ℝ) * C_cone n * D_W n ^ n) := by
            refine mul_le_mul (mul_le_mul_of_nonneg_left hΘ_bound (Nat.cast_nonneg _))
              h_comp (norm_nonneg _) (mul_nonneg (Nat.cast_nonneg _) (hK_Θ_spec i).1)
        _ = (k.choose i : ℝ) * K_Θ i * (n.factorial : ℝ) * C_cone n * D_W n ^ n := by ring
    · have h_compl_open : IsOpen K_Bᶜ := hK_B_compact.isClosed.isOpen_compl
      have h_ev : B_a =ᶠ[nhds p]
          (fun _ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) => (0 : ℂ)) := by
        refine Filter.eventuallyEq_of_mem (h_compl_open.mem_nhds hp) (fun q hq => ?_)
        change B_a (q.1, q.2.1, q.2.2) = 0
        refine hB_supp q.1 q.2.1 q.2.2 ?_
        by_contra h_not
        push Not at h_not
        apply hq
        refine ⟨h_not.1, ?_, ?_⟩
        · rw [mem_closedBall_zero_iff]
          exact h_not.2.1.le
        · rw [mem_closedBall_zero_iff]
          exact h_not.2.2.le
      have h_zero : iteratedFDeriv ℝ k B_a p = 0 := by
        rw [(h_ev.iteratedFDeriv ℝ k).eq_of_nhds, iteratedFDeriv_fun_zero]
        rfl
      rw [h_zero, norm_zero]
      exact hM_B_nn k

  have hB_eq : ∀ (c : ℝ) (x v : EuclideanSpace ℝ (Fin 2)),
      c ∈ Set.Icc (1 / 32) (23 / 32) →
      (pseudoconformalPt c x) 0 ∈ Set.Ioo (-1 / 8) (9 / 8) →
      (pseudoconformalPt c x) 1 ∈ Set.Ioo (-1 / 8) (9 / 8) →
      B_a (c, x, v) = a_dir (pseudoconformalPt c x - sliceEmbed v 0) := by
    intro c x v hc hu0 hu1
    let s : ℝ := 1 / 4 + 8 * c
    have hs_bounds : 1 / 2 ≤ s ∧ s ≤ 6 := by
      dsimp [s]; constructor <;> linarith [hc.1, hc.2]
    have hs_pos : 0 < s := by linarith [hs_bounds.1]
    have hs_ne : s ≠ 0 := ne_of_gt hs_pos
    have hc_01 : c ∈ Set.Icc (0 : ℝ) 1 := ⟨by linarith [hc.1], by linarith [hc.2]⟩
    have hW_eq : W (c, x, v) = pseudoconformalPt c x - sliceEmbed v 0 := by
      ext i
      fin_cases i <;> simp [W, pseudoconformalPt, sliceEmbed, L3_toLp, hs_tilde_eq c hc_01]
    have hθc_eq : θ_c c = 1 := by
      have h1 : Real.smoothTransition (64 * (c - 1 / 64)) = 1 :=
        Real.smoothTransition.one_of_one_le (by linarith [hc.1])
      have h2 : Real.smoothTransition (8 * (7 / 8 - c)) = 1 :=
        Real.smoothTransition.one_of_one_le (by linarith [hc.2])
      dsimp [θ_c]; rw [h1, h2, mul_one]
    let u0 : ℝ := (pseudoconformalPt c x) 0
    let u1 : ℝ := (pseudoconformalPt c x) 1
    have hu0_def : u0 = 8 * s⁻¹ * x 0 := by rfl
    have hu1_def : u1 = 8 * s⁻¹ * x 1 := by rfl
    have hx0_eq : x 0 = (s / 8) * u0 := by rw [hu0_def]; field_simp
    have hx1_eq : x 1 = (s / 8) * u1 := by rw [hu1_def]; field_simp
    have hu0_sq : u0 ^ 2 < (9 / 8) ^ 2 := by nlinarith [hu0.1, hu0.2]
    have hu1_sq : u1 ^ 2 < (9 / 8) ^ 2 := by nlinarith [hu1.1, hu1.2]
    have hx_sq_lt : (x 0) ^ 2 + (x 1) ^ 2 < 11 / 4 := by
      have hs_sq : (s / 8) ^ 2 ≤ (6 / 8) ^ 2 := by
        nlinarith [hs_pos, hs_bounds.2]
      rw [hx0_eq, hx1_eq]
      have h_factor : ((s / 8) * u0) ^ 2 + ((s / 8) * u1) ^ 2 =
          (s / 8) ^ 2 * (u0 ^ 2 + u1 ^ 2) := by ring
      rw [h_factor]
      have hu_sum_nn : 0 ≤ u0 ^ 2 + u1 ^ 2 := by positivity
      have hu_sum_lt : u0 ^ 2 + u1 ^ 2 < 81 / 32 := by linarith
      nlinarith
    have hχx_eq : χ_x x = 1 :=
      Real.smoothTransition.one_of_one_le (by dsimp [χ_x]; linarith)
    by_cases hv : ‖v‖ ≤ 4
    · have hv_sq : (v 0) ^ 2 + (v 1) ^ 2 ≤ 16 := by
        have : ‖v‖ ^ 2 ≤ 4 ^ 2 := pow_le_pow_left₀ (norm_nonneg v) hv 2
        linarith [h_norm2_sq v]
      have hχv_eq : χ_v v = 1 :=
        Real.smoothTransition.one_of_one_le (by dsimp [χ_v]; linarith)
      have hΘ_eq : Θ (c, x, v) = 1 := by dsimp [Θ]; rw [hθc_eq, hχx_eq, hχv_eq]; ring
      simp [B_a, hΘ_eq, hW_eq]
    · push Not at hv
      let u_proj : EuclideanSpace ℝ (Fin 2) :=
        (PiLp.continuousLinearEquiv 2 ℝ (fun _ : Fin 2 => ℝ)).symm ![u0, u1]
      have hu_proj_sq : ‖u_proj‖ ^ 2 < 4 := by
        rw [h_norm2_sq u_proj]
        have h0 : u_proj 0 = u0 := rfl
        have h1 : u_proj 1 = u1 := rfl
        rw [h0, h1]
        linarith
      have hu_proj_lt : ‖u_proj‖ < 2 := by
        nlinarith [norm_nonneg u_proj]
      have h_diff_gt : 2 < ‖u_proj - v‖ := by
        have h_tri : ‖v‖ ≤ ‖u_proj‖ + ‖u_proj - v‖ := by
          calc ‖v‖ = ‖u_proj - (u_proj - v)‖ := by abel_nf
            _ ≤ ‖u_proj‖ + ‖u_proj - v‖ := norm_sub_le _ _
        linarith
      have h_diff_sq : 4 < (u0 - v 0) ^ 2 + (u1 - v 1) ^ 2 := by
        have hsq : 2 ^ 2 < ‖u_proj - v‖ ^ 2 := pow_lt_pow_left₀ h_diff_gt (by norm_num) (by omega)
        rw [h_norm2_sq (u_proj - v)] at hsq
        have h0 : (u_proj - v) 0 = u0 - v 0 := rfl
        have h1 : (u_proj - v) 1 = u1 - v 1 := rfl
        rw [h0, h1] at hsq
        linarith
      let w : EuclideanSpace ℝ (Fin 3) := pseudoconformalPt c x - sliceEmbed v 0
      have hw_ge_2 : 2 ≤ ‖w‖ := by
        have hw_sq : 4 < ‖w‖ ^ 2 := by
          rw [h_norm3_sq w]
          have hw0 : w 0 = u0 - v 0 := by simp [w, u0, sliceEmbed, L3_toLp]
          have hw1 : w 1 = u1 - v 1 := by simp [w, u1, sliceEmbed, L3_toLp]
          rw [hw0, hw1]
          have hw2_nn : 0 ≤ (w 2) ^ 2 := sq_nonneg _
          linarith
        nlinarith [norm_nonneg w]
      have ha0 : a_dir w = 0 := ha_dir_supp w (Or.inr (Or.inl hw_ge_2))
      change Θ (c, x, v) • a_dir (W (c, x, v)) = a_dir w
      rw [hW_eq, show pseudoconformalPt c x - sliceEmbed v 0 = w from rfl, ha0, smul_zero]

  refine ⟨B_a, hB_smooth, hB_supp, hB_deriv, ?_⟩
  intro h_2d h hh_cont hh_supp

  
  
  
  let e1 : EuclideanSpace ℝ (Fin 3) ≃ᵐ (Fin 3 → ℝ) :=
    (MeasurableEquiv.toLp 2 (Fin 3 → ℝ)).symm
  let e2 : (Fin 3 → ℝ) ≃ᵐ ℝ × (Fin 2 → ℝ) :=
    MeasurableEquiv.piFinSuccAbove (fun _ : Fin 3 => ℝ) (Fin.last 2)
  let e3_step : ℝ × (Fin 2 → ℝ) ≃ᵐ ℝ × EuclideanSpace ℝ (Fin 2) :=
    (MeasurableEquiv.refl ℝ).prodCongr (MeasurableEquiv.toLp 2 (Fin 2 → ℝ))
  let e3 : EuclideanSpace ℝ (Fin 3) ≃ᵐ ℝ × EuclideanSpace ℝ (Fin 2) :=
    (e1.trans e2).trans e3_step
  have he1_mp : MeasureTheory.MeasurePreserving e1 MeasureTheory.volume MeasureTheory.volume :=
    EuclideanSpace.volume_preserving_symm_measurableEquiv_toLp (Fin 3)
  have he2_mp : MeasureTheory.MeasurePreserving e2 MeasureTheory.volume
      (MeasureTheory.volume.prod MeasureTheory.volume) :=
    MeasureTheory.volume_preserving_piFinSuccAbove (fun _ : Fin 3 => ℝ) (Fin.last 2)
  have he3_step_mp : MeasureTheory.MeasurePreserving e3_step
      (MeasureTheory.volume.prod MeasureTheory.volume)
      (MeasureTheory.volume.prod MeasureTheory.volume) :=
    (MeasureTheory.MeasurePreserving.id MeasureTheory.volume).prod
      (PiLp.volume_preserving_toLp (Fin 2))
  have he3_mp : MeasureTheory.MeasurePreserving e3 MeasureTheory.volume
