    have hc_gap_le1 : c_gap ≤ 1 := min_le_left _ _
    have hc_gap_sq_pos : 0 < (1 / 2 : ℝ) * c_gap ^ 2 := by positivity
    have hc_gap_pair : ∀ j k : Fin n, j ≠ k →
        (1 / 2 : ℝ) * c_gap ^ 2 ≤ (1 / 2 : ℝ) * (c k - c j) ^ 2 := by
      intro j k hjk
      have hmem : (j, k) ∈ (Finset.univ : Finset (Fin n)).offDiag :=
        Finset.mem_offDiag.mpr ⟨Finset.mem_univ _, Finset.mem_univ _, hjk⟩
      have hle : c_gap ≤ |c k - c j| :=
        (min_le_right _ _).trans (Finset.inf'_le (fun jk => |c jk.2 - c jk.1|) hmem)
      nlinarith [hc_gap_pos, hle, sq_abs (c k - c j)]
    let q : Fin n → ℝ := fun j => 1 + c j_top - c j
    have hq_ge1 : ∀ j : Fin n, 1 ≤ q j := by
      intro j
      by_cases hj : j = j_top
      · simp [q, hj]
      · have hlt := hc_top j hj
        dsimp [q]
        linarith
    have hq_nn : ∀ j : Fin n, 0 ≤ q j := fun j => zero_le_one.trans (hq_ge1 j)
    have hq_ge_gap : ∀ j : Fin n, (1 / 2 : ℝ) * c_gap ^ 2 ≤ q j := by
      intro j
      have h1 := hq_ge1 j
      nlinarith [hc_gap_pos, hc_gap_le1]
    let χ_i : ℝ → ℝ := fun i =>
      Real.smoothTransition (i + K + 1) * Real.smoothTransition (K + 1 - i)
    let χ_u : ℝ → ℝ := fun u =>
      Real.smoothTransition ((2 / δ) * (u - δ / 2)) *
        Real.smoothTransition ((2 / δ) * (1 - δ / 2 - u))
    have hχi_cd : ContDiff ℝ 1 χ_i :=
      (Real.smoothTransition.contDiff.comp ((contDiff_id.add contDiff_const).add contDiff_const)).mul
        (Real.smoothTransition.contDiff.comp (contDiff_const.sub contDiff_id))
    have hχu_cd : ContDiff ℝ 1 χ_u :=
      (Real.smoothTransition.contDiff.comp
        (contDiff_const.mul (contDiff_id.sub contDiff_const))).mul
        (Real.smoothTransition.contDiff.comp
          (contDiff_const.mul (contDiff_const.sub contDiff_id)))
    have hχi_cont : Continuous χ_i := hχi_cd.continuous
    have hχu_cont : Continuous χ_u := hχu_cd.continuous
    have hχi'_cont : Continuous (deriv χ_i) := hχi_cd.continuous_deriv le_rfl
    have hχu'_cont : Continuous (deriv χ_u) := hχu_cd.continuous_deriv le_rfl
    have hχi_der : ∀ i : ℝ, HasDerivAt χ_i (deriv χ_i i) i :=
      fun i => (hχi_cd.differentiable one_ne_zero i).hasDerivAt
    have hχu_der : ∀ u : ℝ, HasDerivAt χ_u (deriv χ_u u) u :=
      fun u => (hχu_cd.differentiable one_ne_zero u).hasDerivAt
    have hχi_nn : ∀ i : ℝ, 0 ≤ χ_i i :=
      fun i => mul_nonneg (Real.smoothTransition.nonneg _) (Real.smoothTransition.nonneg _)
    have hχu_nn : ∀ u : ℝ, 0 ≤ χ_u u :=
      fun u => mul_nonneg (Real.smoothTransition.nonneg _) (Real.smoothTransition.nonneg _)
    have hχi_zero_lo : χ_i (-(K + 1)) = 0 := by
      dsimp [χ_i]
      rw [Real.smoothTransition.zero_of_nonpos (by linarith), zero_mul]
    have hχi_zero_hi : χ_i (K + 1) = 0 := by
      have hz : K + 1 - (K + 1) = 0 := sub_self _
      dsimp [χ_i]
      rw [hz, Real.smoothTransition.zero_of_nonpos le_rfl, mul_zero]
    have hχu_zero_lo : χ_u (δ / 2) = 0 := by
      dsimp [χ_u]
      rw [Real.smoothTransition.zero_of_nonpos (by nlinarith), zero_mul]
    have hχu_zero_hi : χ_u (1 - δ / 2) = 0 := by
      have hz : (2 / δ) * (1 - δ / 2 - (1 - δ / 2)) = 0 := by ring
      dsimp [χ_u]
      rw [hz, Real.smoothTransition.zero_of_nonpos le_rfl, mul_zero]
    have hχi_one : ∀ i ∈ Set.Icc (-K) K, χ_i i = 1 := by
      intro i hi
      dsimp [χ_i]
      rw [Real.smoothTransition.one_of_one_le (by linarith [hi.1]),
        Real.smoothTransition.one_of_one_le (by linarith [hi.2]), mul_one]
    have hχu_one : ∀ u ∈ Set.Icc δ (1 - δ), χ_u u = 1 := by
      intro u hu
      dsimp [χ_u]
      have h1 : 1 ≤ (2 / δ) * (u - δ / 2) := by
        rw [div_mul_eq_mul_div, le_div_iff₀ hδ₀]
        linarith [hu.1]
      have h2 : 1 ≤ (2 / δ) * (1 - δ / 2 - u) := by
        rw [div_mul_eq_mul_div, le_div_iff₀ hδ₀]
        linarith [hu.2]
      rw [Real.smoothTransition.one_of_one_le h1, Real.smoothTransition.one_of_one_le h2, mul_one]
    let I_cut_u : ℝ := ∫ i in (-(K + 1))..(K + 1), ∫ u in (δ / 2)..(1 - δ / 2),
      |χ_i i * deriv χ_u u|
    let I_cut_i : ℝ := ∫ u in (δ / 2)..(1 - δ / 2), ∫ i in (-(K + 1))..(K + 1),
      |deriv χ_i i * χ_u u|
    let I_cut : ℝ := ∑ j : Fin n, q j * d j * (I_cut_u + |c j| * I_cut_i)
    have hI_cut_u_nn : 0 ≤ I_cut_u :=
      intervalIntegral.integral_nonneg hK1_le fun _ _ =>
        intervalIntegral.integral_nonneg hδ2_le fun _ _ => abs_nonneg _
    have hI_cut_i_nn : 0 ≤ I_cut_i :=
      intervalIntegral.integral_nonneg hδ2_le fun _ _ =>
        intervalIntegral.integral_nonneg hK1_le fun _ _ => abs_nonneg _
    have hI_cut_nn : 0 ≤ I_cut :=
      Finset.sum_nonneg fun j _ =>
        mul_nonneg (mul_nonneg (hq_nn j) (hd_nn.1 j))
