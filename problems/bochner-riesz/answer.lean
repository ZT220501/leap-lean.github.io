                then (∑ idx_p, p0₂ idx_p b) else 0 := by
            simp_rw [h_pair_iff]
            exact (h_sum_comm_ite p0₂ _).symm
          have h_obs_12 := h_obs₂ m_idx_12 (q₁.1, q₁.2, q₂.1, q₂.2)
          dsimp only at h_obs_12
          rw [hrF_eq, hp0F_eq] at h_obs_12
          have h_floor_ch := (h_obs_12 (mul_pos hM₂_pos hm_ch₂_pos)).1
          have h_par_le_p0 : M_ret₂ * m_par₂ ≤ ∑ b : Fin pre.N_Θ,
              if paramTreeBin pre.ρ d₁ (pre.θ b) = q₁ then (∑ idx_p, p0₂ idx_p b) else 0 := by
            dsimp [m_par₂]
            rw [Finset.mul_sum]
            refine Finset.sum_le_sum fun b _ => ?_
            split_ifs
            · rw [Finset.mul_sum]
              exact Finset.sum_le_sum fun idx_p _ => hπ₂_le_p0₂ idx_p b
            · simp
          have h_comb : (δ₂ * pre.ρ ^ (2 * (d₂ - d₁) + κ₂) * m_par₂) * M_ret₂ ≤
              m_ch₂ * M_ret₂ := by
            calc (δ₂ * pre.ρ ^ (2 * (d₂ - d₁) + κ₂) * m_par₂) * M_ret₂
