      have h_strict : ∑ s : Fin M_split, α s * Score s < ∑ s : Fin M_split, α s * M_avg :=
        Finset.sum_lt_sum h_le_all ⟨s₀, Finset.mem_univ s₀, h_lt_one⟩
      rw [← Finset.sum_mul, hα_sum, one_mul] at h_strict
      exact lt_irrefl M_avg h_strict
    obtain ⟨s, hs_pos, hs_ge⟩ := hex_s
    refine ⟨s, p_cd s, ?_, ?_, ?_, by linarith [h_avg_bound, hs_ge]⟩
    · intro o d
