    have h_norm1 : ‖(1 : ℝ) - 0‖ = 1 := by norm_num
    rw [h_norm1, mul_one] at h_mvt
    exact h_mvt

  
  have h_coercive :
      ∀ (lam_sys C_box : ℝ), 0 < lam_sys →
      ∀ (ζ₀ : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → EuclideanSpace ℝ (Fin 2)),
