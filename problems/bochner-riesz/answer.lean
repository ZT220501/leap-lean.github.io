        linarith [h_expand, h1, h_cross_lo, h2]
      have h_lam_s_pos : 0 < lam_loc * s := mul_pos hlam hs
      calc L = B_cell⁻¹ * ((a₀ / 2) * (|δ_τ| / s)) := by dsimp only [L]; ring
        _ ≤ (lam_loc * s ^ 2) * ((a₀ / 2) * (|δ_τ| / s)) :=
            mul_le_mul_of_nonneg_right hlam_lo (by positivity)
        _ = (lam_loc * s) * ((a₀ / 2) * |δ_τ|) := by
            field_simp [hs.ne']
