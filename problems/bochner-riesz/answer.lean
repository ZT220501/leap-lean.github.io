      have h_sc0 : 0 ≤ (θ / Real.pi) * (2 : ℝ) ^ m_e := mul_nonneg h_div0 h2me_pos.le
      have h_sc1 : (θ / Real.pi) * (2 : ℝ) ^ m_e < (((2 : ℤ) ^ m_e : ℤ) : ℝ) := by
