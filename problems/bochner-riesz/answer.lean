        rw [← Finset.sum_add_distrib]
        calc ∑ b₁, ((∑ b₂, if |Δ_fn b₁ b₂| ≤ (1 / 16 : ℝ) * ρ_strip then (∑ a, W₂ a b₁ b₂) else 0) +
              (∑ b₂, if (1 / 16 : ℝ) * ρ_strip < |Δ_fn b₁ b₂| then (∑ a, W₂ a b₁ b₂) else 0))
            = ∑ b₁, ∑ b₂, (∑ a, W₂ a b₁ b₂) := by
                refine Finset.sum_congr rfl (fun b₁ _ => ?_)
                rw [← Finset.sum_add_distrib]
                refine Finset.sum_congr rfl (fun b₂ _ => ?_)
                by_cases h : |Δ_fn b₁ b₂| ≤ (1 / 16 : ℝ) * ρ_strip
                · rw [if_pos h, if_neg (not_lt.mpr h), add_zero]
                · rw [if_neg h, if_pos (lt_of_not_ge h), zero_add]
