    have hk0_hi : w 0 / s + 1 / 2 < (k0 : ℝ) + 1 := Int.lt_floor_add_one _
    have hk1_lo : (k1 : ℝ) ≤ w 1 / s + 1 / 2 := Int.floor_le _
    have hk1_hi : w 1 / s + 1 / 2 < (k1 : ℝ) + 1 := Int.lt_floor_add_one _
    have hd0_abs : |w 0 - s * (k0 : ℝ)| ≤ (1 / 2 : ℝ) * s := by
      have hm1 := mul_le_mul_of_nonneg_left hk0_lo hs.le
      have hm2 := mul_le_mul_of_nonneg_left hk0_hi.le hs.le
      have hdiv : s * (w 0 / s + 1 / 2) = w 0 + (1 / 2) * s := by field_simp [hs.ne']
      have hring : s * ((k0 : ℝ) + 1) = s * (k0 : ℝ) + s := by ring
      rw [hdiv] at hm1
      rw [hdiv, hring] at hm2
      exact abs_le.mpr ⟨by linarith only [hm1], by linarith only [hm2]⟩
    have hd1_abs : |w 1 - s * (k1 : ℝ)| ≤ (1 / 2 : ℝ) * s := by
