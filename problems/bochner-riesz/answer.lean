    exact h_fib.trans h_div_le
  have h_unit_vec : ∀ k_ang : ℤ,
      ‖angUnitVec ε e k_ang‖ = 1 ∧ ‖perp2D (angUnitVec ε e k_ang)‖ = 1 := by
    intro k_ang
    let e_dir := angUnitVec ε e k_ang
    have he_sq : ‖e_dir‖ ^ 2 = 1 := by
      rw [PiLp.norm_sq_eq_of_L2, Fin.sum_univ_two]
      dsimp [e_dir, angUnitVec]
      rw [sq_abs, sq_abs, Real.cos_sq_add_sin_sq]
    have he_norm : ‖e_dir‖ = 1 := by
      nlinarith [norm_nonneg e_dir]
    have hp_sq : ‖perp2D e_dir‖ ^ 2 = 1 := by
      rw [PiLp.norm_sq_eq_of_L2, Fin.sum_univ_two]
      dsimp [perp2D]
      rw [sq_abs, sq_abs]
      have he_sq2 := PiLp.norm_sq_eq_of_L2 (fun _ : Fin 2 => ℝ) e_dir
      rw [Fin.sum_univ_two] at he_sq2
      dsimp at he_sq2
      rw [sq_abs, sq_abs, he_sq] at he_sq2
      linarith
    exact ⟨he_norm, by nlinarith [norm_nonneg (perp2D e_dir)]⟩
  let L_e : ℤ := dyadicRealLevel ε e
  let L_e1 : ℤ := dyadicRealLevel ε (e + 1)
  let s_e : ℝ := dyadicRealStep ε e
  let s_e1 : ℝ := dyadicRealStep ε (e + 1)
  have hs_e_pos : 0 < s_e := zpow_pos (by norm_num) (-L_e)
  have h2Le_pos : 0 < (2 : ℝ) ^ L_e := zpow_pos (by norm_num) L_e
  have hs_e_mul : s_e * (2 : ℝ) ^ L_e = 1 := by
    dsimp only [s_e, dyadicRealStep, L_e]
    rw [zpow_neg, inv_mul_cancel₀ h2Le_pos.ne']
  have hs_e1_le : s_e1 ≤ s_e := by
    have hL_le : L_e ≤ L_e1 := by
      dsimp only [L_e, L_e1, dyadicRealLevel]
      refine Int.floor_mono ?_
      exact mul_le_mul_of_nonneg_right (by linarith) (div_nonneg hell_pos.le hlog2_pos.le)
    exact zpow_le_zpow_right₀ (by norm_num) (neg_le_neg hL_le)
  have h_mid_err : ∀ (L y : ℝ),
      |y - ((dyadicRealBin ε L y : ℝ) + 1 / 2) * dyadicRealStep ε L| ≤
