    have h_lt : (1 / 2 : ℝ) * h < K * h := mul_lt_mul_of_pos_right (by linarith) hh
    linarith [huKh, hvQ_eq, h_le, h_lt]
  have hv_Ioo : ∀ r : ℕ, r ≤ Q → v r ∈ Set.Ioo (0 : ℝ) 1 := by
    intro r hr
