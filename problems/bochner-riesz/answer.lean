            exact (hS_in_near α hα_near).1
          have hk₁_not : g₁ α ∉ I₁ := by
            intro hk₁_in
            apply hα_not_in
            refine Finset.mem_union_left _ (Finset.mem_biUnion.mpr ⟨g₁ α, hk₁_in, ?_⟩)
            exact (h_mem_F₁ (g₁ α) α).mpr ⟨hα_TP, rfl⟩
          have hk₂_not : g₂ α ∉ I₂ := by
            intro hk₂_in
            apply hα_not_in
            refine Finset.mem_union_right _ (Finset.mem_biUnion.mpr ⟨g₂ α, hk₂_in, ?_⟩)
