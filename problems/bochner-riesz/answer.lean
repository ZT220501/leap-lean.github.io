          calc |inner ℝ d1 u| ≤ ‖d1‖ * ‖u‖ := abs_real_inner_le_norm d1 u
            _ = ‖d1‖ := by rw [hu, mul_one]
            _ ≤ 5 * s_Z := hd1
        have hsum : |inner ℝ d1 u + inner ℝ d2 u| ≤ s₀ * ((5 + B_sys) * ρ_u) := by
          have htri := abs_add_le (inner ℝ d1 u) (inner ℝ d2 u)
          have hBr : B_sys * r_u ≤ B_sys * (s₀ * ρ_u) := mul_le_mul_of_nonneg_left hru hB_nn
          linarith only [htri, hcs, hd2, hsZ, hBr]
        calc s₀⁻¹ * |inner ℝ d1 u + inner ℝ d2 u|
            ≤ s₀⁻¹ * (s₀ * ((5 + B_sys) * ρ_u)) :=
              mul_le_mul_of_nonneg_left hsum (inv_pos.mpr hs₀).le
          _ = (5 + B_sys) * ρ_u := inv_mul_cancel_left₀ hs₀.ne' _
      rw [hV_diff, hX_diff]
      exact ⟨h_bound_pair s_v s_VZ r_Vb ρ_Vb e_d _ _ hsv_pos hed_norm hVaVo hVod_b hsVZ_b hrVb,
        h_bound_pair s_v s_VZ r_Va ρ_Va (perp2D e_d) _ _ hsv_pos hperp_norm hVaVo hVod_a hsVZ_a hrVa,
        h_bound_pair s_x s_XZ r_Xb ρ_Xb e_d _ _ hsx_pos hed_norm hXaXo hXod_b hsXZ_b hrXb,
        h_bound_pair s_x s_XZ r_Xa ρ_Xa (perp2D e_d) _ _ hsx_pos hperp_norm hXaXo hXod_a hsXZ_a hrXa⟩
    · intro V'_a X'_a V_F A_F e_F r_b r_a V_part A_part X_F hrb hra
      constructor
      · dsimp only [A_part]
        calc ‖X'_a - (1 / 2 : ℝ) • V'_a‖
            ≤ ‖X'_a‖ + ‖(1 / 2 : ℝ) • V'_a‖ := norm_sub_le _ _
          _ = ‖X'_a‖ + (1 / 2 : ℝ) * ‖V'_a‖ := by
              rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (by norm_num)]
      · rintro ⟨hVb, hVa, hAb, hAa⟩
        have hX_id : X'_a - X_F = (A_part - A_F) + (1 / 2 : ℝ) • (V_part - V_F) := by
          dsimp only [X_F, A_part, V_part]; module
        have h_shear : ∀ (u : EuclideanSpace ℝ (Fin 2)) (r_u : ℝ),
            |inner ℝ (V_part - V_F) u| ≤ 10 * r_u →
            |inner ℝ (A_part - A_F) u| ≤ 10 * r_u →
            |inner ℝ (X'_a - X_F) u| ≤ 15 * r_u := by
          intro u r_u hVu hAu
