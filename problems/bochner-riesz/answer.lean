        ext t'
        exact (h_step1 F hF).2.2.2 t' τ
      rwa [h_comm] at h_ih
  
  have h_ortho_norm_sq : ∀ (e : EuclideanSpace ℝ (Fin 2)), ‖e‖ = 1 →
      ∀ (t y₁ : ℝ), ‖t • e + y₁ • perp2D e‖ ^ 2 = t ^ 2 + y₁ ^ 2 := by
    intro e he t y₁
    have he_sq : (e 0) ^ 2 + (e 1) ^ 2 = 1 := by
      have h1 : ‖e‖ ^ 2 = 1 := by rw [he, one_pow]
      rw [EuclideanSpace.norm_sq_eq, Fin.sum_univ_two] at h1
      simp only [Real.norm_eq_abs, sq_abs] at h1
      exact h1
    rw [EuclideanSpace.norm_sq_eq, Fin.sum_univ_two]
    simp [perp2D, sq_abs]
    calc (t * e.ofLp 0 + -(y₁ * e.ofLp 1)) ^ 2 + (t * e.ofLp 1 + y₁ * e.ofLp 0) ^ 2
        = (t ^ 2 + y₁ ^ 2) * (e.ofLp 0 ^ 2 + e.ofLp 1 ^ 2) := by ring
      _ = t ^ 2 + y₁ ^ 2 := by rw [he_sq, mul_one]
