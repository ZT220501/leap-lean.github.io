  let q_cand : ∀ j : Fin N_J, Fin N_O → Fin N_D → Fin (N_ret_of j) → ℝ :=
    fun j o d α =>
      if win_of o = j ∧ 0 < π_q j ∧ α ∈ T_cand j (Q_of j o) then
