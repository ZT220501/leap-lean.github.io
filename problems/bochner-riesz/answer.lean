        intro z
        by_cases hpz : 0 < p_Z z
        · have h_ne_z : (RootSet (π_Z z)).Nonempty := ⟨0, (h_root_props (π_Z z) (h_law_Z z hpz)).1⟩
          have h_lt : classicalRootSupremum ε L γ N_ω N_T (π_Z z) T_idx V_part A_part - δ <
