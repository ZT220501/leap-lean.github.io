    have h2mr_eq : ((2 : ℝ) ^ m_r)⁻¹ = Real.exp (-((m_r : ℝ) * Real.log 2)) := by
      rw [← Real.rpow_natCast (2 : ℝ) m_r, Real.rpow_def_of_pos zero_lt_two, ← Real.exp_neg]
      ring_nf
    refine ⟨?_, ?_⟩
    · rw [hεr_eq, h2mr_eq]
      exact Real.exp_le_exp.mpr (by linarith only [hmul1])
    · have h2_eq : 2 * ε ^ r = Real.exp (Real.log 2 - r * Real.log (ε⁻¹)) := by
        rw [hεr_eq, sub_eq_add_neg, Real.exp_add, Real.exp_log zero_lt_two]
      rw [h2mr_eq, h2_eq]
      have hexp_hi : -((m_r : ℝ) * Real.log 2) ≤ Real.log 2 - r * Real.log (ε⁻¹) := by
        have hring : ((m_r : ℝ) + 1) * Real.log 2 = (m_r : ℝ) * Real.log 2 + Real.log 2 := by ring
        linarith only [hmul2, hring]
      exact Real.exp_le_exp.mpr hexp_hi

  have hmr_for_cut : (r = 0 ∧ m_r = 0) ∨
      (0 < r ∧ (2 * cls.B_sys)⁻¹ * ε ^ r ≤ ((2 : ℝ) ^ m_r)⁻¹ ∧
        ((2 : ℝ) ^ m_r)⁻¹ ≤ (2 * cls.B_sys) * ε ^ r) := by
    rcases hmr_cases with ⟨hr0, hmr0⟩ | ⟨hr_pos, hmr_eq⟩
    · exact Or.inl ⟨hr0, hmr0⟩
    · obtain ⟨h1, h2⟩ := hmr_dyadic hr_pos hmr_eq
      have hεr_nn : 0 ≤ ε ^ r := (Real.rpow_pos_of_pos hε_pos r).le
      have hinv_le1 : (2 * cls.B_sys)⁻¹ ≤ 1 := inv_le_one_of_one_le₀ (by linarith only [hB_sys2])
      refine Or.inr ⟨hr_pos, ?_, ?_⟩
      · exact le_trans (mul_le_of_le_one_left hεr_nn hinv_le1) h1
      · exact le_trans h2 (mul_le_mul_of_nonneg_right (by linarith only [hB_sys2]) hεr_nn)

  let s_c : ℝ := ((2 : ℝ) ^ m_r)⁻¹
  let s_v : ℝ := ε ^ b_star
  let s_x : ℝ := s_c * s_v
  let ρ_r : ℝ := if r = 0 then (Real.sqrt lam_sys)⁻¹ else ε ^ ((H_P - r) / 2)
