        have hf3_submod : IsSubmodularConeProfile 3 c3 d3 2 E3 f3 := by
          obtain ⟨h1_4, h2_4, h3_4, h4_4⟩ := sys.h_submod
          refine ⟨?_, ?_, ?_, ?_⟩
          · intro L v h j hh hcL hcLh
