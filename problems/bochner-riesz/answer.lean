          · rw [hv_eq]
            exact (h_round2D ρ₀ hρ₀ (V β - V α)).2.2
          · rw [hx_eq]
            exact (h_round2D σ₀ hσ₀_pos (X β - X α)).2.2
        letI := Classical.propDecidable
        refine le_trans ?_ (h_pack v₀ x₀)
        refine Nat.cast_le.mpr (Finset.card_le_card (fun β hβ => ?_))
        exact Finset.mem_filter.mpr ⟨Finset.mem_univ β, h_sub_mem β hβ⟩
      have hw_q_nn : 0 ≤ w_q := by
        dsimp [w_q]
        positivity
      calc ∑ β ∈ S'.filter (fun β => Φ_cell β = q), K_gram α β
          ≤ ∑ _β ∈ S'.filter (fun β => Φ_cell β = q), w_q := Finset.sum_le_sum h_pt_q
        _ = (((S'.filter (fun β => Φ_cell β = q)).card : ℕ) : ℝ) * w_q := by
            rw [Finset.sum_const, nsmul_eq_mul]
        _ ≤ (N_pack : ℝ) * w_q := mul_le_mul_of_nonneg_right h_card_le hw_q_nn
    have h_card_IV : I_V.card = 2 * L_V + 1 := by
      dsimp [I_V]
      rw [Int.card_Icc]
      omega
    have h_card_BV : (B_V.card : ℝ) = ((2 * L_V + 1 : ℕ) : ℝ) ^ 2 := by
      dsimp [B_V]
      rw [Finset.card_product, h_card_IV, Nat.cast_mul, sq]
    have h_sum_IX : ∑ m ∈ I_X, (1 : ℝ) / (1 + |(m : ℝ)|) ^ 2 ≤ 3 := h_sum_1d M_X
