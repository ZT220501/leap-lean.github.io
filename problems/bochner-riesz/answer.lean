    have h0 : v 0 ≤ v r := hv_mono 0 r (Nat.zero_le r)
    have hv0 : v 0 = u := by simp [v]
    linarith [hu.1, h0, hv0]

  
  have h_rpow_zero : ∀ α : ℝ, 0 < α →
      Filter.Tendsto (fun k => (sys.ε_seq k) ^ α) Filter.atTop (nhds 0) := by
    intro α hα
    have h1 := sys.hε_tendsto.rpow_const (Or.inr hα.le)
    rwa [Real.zero_rpow hα.ne'] at h1
  have h_inv_ell_zero : ∀ C : ℝ,
      Filter.Tendsto (fun k => C / Real.log ((sys.ε_seq k)⁻¹)) Filter.atTop (nhds 0) := by
    intro C
    have h_gt0 : Filter.Tendsto sys.ε_seq Filter.atTop (nhdsWithin 0 (Set.Ioi 0)) :=
      tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within sys.ε_seq sys.hε_tendsto
