    have hH_lower : ∀ (y τ : ℝ), L ≤ H (y, τ) := by
      intro y τ
      let S := M (v_seg τ, p_seg (y, τ))
      have h_plus_norm : ‖τ_P + n_P‖ ^ 2 = 2 := by
        rw [norm_add_sq_real, hτ_norm, hn_P, h_orth]
        norm_num
      have h_minus_norm : ‖τ_P - n_P‖ ^ 2 = 2 := by
        rw [norm_sub_sq_real, hτ_norm, hn_P, h_orth]
        norm_num
      have hS_sym : inner ℝ (S n_P) τ_P = inner ℝ (S τ_P) n_P := by
        rw [hζ_symm (v_seg τ) (p_seg (y, τ)) n_P τ_P, real_inner_comm]
