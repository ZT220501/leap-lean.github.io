            have hm := mul_le_mul_of_nonneg_left hv_o (inv_nonneg.mpr hρ_t_pos.le)
            rwa [← mul_assoc, mul_comm ρ_t⁻¹ cls.R_win, mul_assoc, inv_mul_cancel₀ hρ_t_ne,
              mul_one] at hm
          have h0 : ψ_o (ρ_t⁻¹ • (v - V_o)) = 0 := hψ_o_supp _ h_n2
