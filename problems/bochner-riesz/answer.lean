            (continuous_const.mul (continuous_const.inner continuous_id)))
        refine hc.integrable_of_hasCompactSupport
          (HasCompactSupport.of_support_subset_isCompact
            (isCompact_closedBall (0 : EuclideanSpace ℝ (Fin 2)) 2) ?_)
        intro z hz
        rw [Function.mem_support] at hz
        rw [Metric.mem_closedBall, dist_zero_right]
        by_contra hnot
        push_neg at hnot
        exact hz (by rw [h_pou_supp z hnot.le]; ring)
      have h_mp_ofLp := PiLp.volume_preserving_ofLp (Fin 2)
      have h_emb_ofLp : MeasurableEmbedding (WithLp.ofLp : EuclideanSpace ℝ (Fin 2) → (Fin 2 → ℝ)) :=
        MeasurableEmbedding.of_measurable_inverse
          h_mp_ofLp.measurable
          (by rw [Set.range_eq_univ.mpr (fun u => ⟨WithLp.toLp 2 u, rfl⟩)]; exact MeasurableSet.univ)
          (PiLp.volume_preserving_toLp (Fin 2)).measurable
          (fun _ => rfl)
      have h_rhs_ofLp_int : MeasureTheory.Integrable
          (fun z : EuclideanSpace ℝ (Fin 2) => ‖Set.indicator Q₂ g₂ (WithLp.ofLp z)‖ ^ 2)
          MeasureTheory.volume :=
        h_mp_ofLp.integrable_comp_of_integrable h_ind_int
      have h_le_u : (∫ z : EuclideanSpace ℝ (Fin 2), (pktPou2D z) ^ 2 * ‖P_j z‖ ^ 2) ≤
          ∫ u : Fin 2 → ℝ, ‖Set.indicator Q₂ g₂ u‖ ^ 2 := by
        calc (∫ z, (pktPou2D z) ^ 2 * ‖P_j z‖ ^ 2)
            ≤ ∫ z, ‖Set.indicator Q₂ g₂ (WithLp.ofLp z)‖ ^ 2 :=
              MeasureTheory.integral_mono h_lhs_int h_rhs_ofLp_int h_dom_Q2
          _ = ∫ u : Fin 2 → ℝ, ‖Set.indicator Q₂ g₂ u‖ ^ 2 :=
              h_mp_ofLp.integral_comp h_emb_ofLp (fun u => ‖Set.indicator Q₂ g₂ u‖ ^ 2)
      refine le_trans h_le_u (le_of_eq ?_)
      rw [funext h_ind_expand, Complex.reCLM.integral_comp_comm h_sum2_int,
        MeasureTheory.integral_finsetSum N_j (fun n _ =>
          MeasureTheory.integrable_finsetSum N_j (fun m _ =>
            (h_prod_int (m.1 - n.1) (m.2 - n.2)).const_mul _))]
      have h_inner_sum : ∀ n ∈ N_j,
          (∫ u : Fin 2 → ℝ, ∑ m ∈ N_j, (star (c (j, n)) * c (j, m)) *
            ∏ i : Fin 2, φ₁ (if i = 0 then m.1 - n.1 else m.2 - n.2) (u i)) =
            (‖c (j, n)‖ ^ 2 : ℂ) := by
        intro n hn
        rw [MeasureTheory.integral_finsetSum N_j (fun m _ =>
          (h_prod_int (m.1 - n.1) (m.2 - n.2)).const_mul _)]
        have h_each_m : ∀ m ∈ N_j,
            (∫ u : Fin 2 → ℝ, (star (c (j, n)) * c (j, m)) *
              ∏ i : Fin 2, φ₁ (if i = 0 then m.1 - n.1 else m.2 - n.2) (u i)) =
              if m = n then (‖c (j, n)‖ ^ 2 : ℂ) else 0 := by
          intro m _
          rw [MeasureTheory.integral_const_mul,
            MeasureTheory.integral_fin_nat_prod_volume_eq_prod
              (fun (i : Fin 2) (t : ℝ) => φ₁ (if i = 0 then m.1 - n.1 else m.2 - n.2) t),
            Fin.prod_univ_two]
          simp only [Fin.isValue, ↓reduceIte, one_ne_zero]
          rw [h_phi1_eval (m.1 - n.1), h_phi1_eval (m.2 - n.2)]
          by_cases hmn : m = n
          · rw [hmn, sub_self, sub_self, if_pos rfl, if_pos rfl, mul_one, mul_one]
            change (starRingEnd ℂ) (c (j, n)) * c (j, n) = _
            rw [mul_comm, Complex.mul_conj, Complex.normSq_eq_norm_sq]
            push_cast; rfl
          · rw [if_neg hmn]
            have h_neq_coord : m.1 - n.1 ≠ 0 ∨ m.2 - n.2 ≠ 0 := by
              by_contra hboth
              push_neg at hboth
              exact hmn (Prod.ext (sub_eq_zero.mp hboth.1) (sub_eq_zero.mp hboth.2))
            rcases h_neq_coord with h1 | h2
            · rw [if_neg h1, zero_mul, mul_zero]
            · rw [if_neg h2, mul_zero, mul_zero]
        rw [Finset.sum_congr rfl h_each_m, Finset.sum_ite_eq' N_j n, if_pos hn]
      rw [Finset.sum_congr rfl h_inner_sum]
      simp only [Complex.reCLM_apply, ← Complex.ofReal_pow, ← Complex.ofReal_sum, Complex.ofReal_re]
      dsimp [N_j]
      rw [Finset.sum_image hinj]
      refine Finset.sum_congr rfl (fun q hq => ?_)
      have hq1 : q.1 = j := (Finset.mem_filter.mp hq).2
      conv_rhs => rw [← Prod.eta q, hq1]
    calc (∫ v : EuclideanSpace ℝ (Fin 2),
            ‖∑ q ∈ F, c q * pktLinearAtom lam_sys Φ₀ q.1 q.2 v‖ ^ 2)
        ≤ 4 * ∑ j ∈ J, ∫ v : EuclideanSpace ℝ (Fin 2), ‖A_cell j v‖ ^ 2 := h_int_4
      _ ≤ 4 * ∑ j ∈ J, ∑ q ∈ F.filter (fun q => q.1 = j), ‖c q‖ ^ 2 :=
          mul_le_mul_of_nonneg_left (Finset.sum_le_sum h_cell_bound) (by norm_num)
      _ = 4 * ∑ q ∈ F, ‖c q‖ ^ 2 := by
          rw [Finset.sum_fiberwise_of_maps_to (fun q hq => Finset.mem_image_of_mem Prod.fst hq)]
  exact ⟨h_part2.1, h_part2.2.1, h_part2.2.2, h_part3⟩

theorem normalized_phase_mode_bijection_and_grid (a₀ a₁ A R_dom B_sys : ℝ)
    (ha₀ : 0 < a₀) (ha₁ : a₀ ≤ a₁) (hA : 1 ≤ A)
    (hR_dom : 1 ≤ R_dom) (hB_sys : 2 ≤ B_sys) :
    ∃ (C_modes : ℝ) (M_mult : ℕ),
      1 ≤ C_modes ∧ 1 ≤ M_mult ∧
      ∀ (lam_sys : ℝ), 4 ≤ lam_sys →
      ∀ (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
        (ζ₀ : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → EuclideanSpace ℝ (Fin 2)),
        IsNormalizedPosDefPhase a₀ a₁ A Φ₀ ζ₀ →
      (∀ (v p₁ p₂ : EuclideanSpace ℝ (Fin 2)),
        a₀ * ‖p₁ - p₂‖ ≤ ‖ζ₀ (v, p₁) - ζ₀ (v, p₂)‖ ∧
        ‖ζ₀ (v, p₁) - ζ₀ (v, p₂)‖ ≤ A * ‖p₁ - p₂‖) ∧
      ∃ (F_modes : Finset ((ℤ × ℤ) × (ℤ × ℤ)))
        (X_ex : ((ℤ × ℤ) × (ℤ × ℤ)) → EuclideanSpace ℝ (Fin 2))
        (o_root : ((ℤ × ℤ) × (ℤ × ℤ)) → ((ℤ × ℤ) × (ℤ × ℤ))),
        let ρ₀ := (Real.sqrt lam_sys)⁻¹
        (∀ j n : ℤ × ℤ,
          ζ₀ (gridPt2D ρ₀ j, X_ex (j, n) - (1 / 2 : ℝ) • gridPt2D ρ₀ j) =
            ζ₀ (gridPt2D ρ₀ j, -((1 / 2 : ℝ) • gridPt2D ρ₀ j)) -
              ((Real.pi * ρ₀ / 2 : ℝ) • gridPt2D 1 n)) ∧
        (∀ q ∈ F_modes,
          q.1 ∈ pktVelBox lam_sys R_dom ∧
          ‖X_ex q‖ ≤ 2 * B_sys + R_dom + 10 ∧
          (o_root q).1 = q.1 ∧
          ‖gridPt2D ρ₀ (o_root q).2 - X_ex q‖ ≤ ρ₀) ∧
        (∀ j ∈ pktVelBox lam_sys R_dom, ∀ n : ℤ × ℤ,
          (j, n) ∉ F_modes → 2 * B_sys + R_dom + 10 < ‖X_ex (j, n)‖) ∧
        ((F_modes.card : ℝ) ≤ C_modes * lam_sys ^ 2) ∧
        (2 * B_sys + 5 ≤ Real.log lam_sys →
          ∀ q ∈ F_modes, o_root q ∈ rootSiteFinset lam_sys R_dom) ∧
        (∀ o_r : (ℤ × ℤ) × (ℤ × ℤ),
          (F_modes.filter (fun q => o_root q = o_r)).card ≤ M_mult) :=
by
  have _ := ha₁
  let R_cut : ℝ := 2 * B_sys + R_dom + 10
  have hR_cut_pos : 0 < R_cut := by dsimp [R_cut]; linarith
  let C_modes : ℝ := (2 * R_dom + 9) ^ 2 * (2 * A * R_cut + 5) ^ 2
  have hC_modes : 1 ≤ C_modes := by
    have h1_lin : 1 ≤ 2 * R_dom + 9 := by linarith
    have h2_lin : 1 ≤ 2 * A * R_cut + 5 := by nlinarith [hA, hR_cut_pos]
    have h1 : 1 ≤ (2 * R_dom + 9) ^ 2 := by
      rw [sq]
      calc (1 : ℝ) = 1 * 1 := by norm_num
        _ ≤ (2 * R_dom + 9) * (2 * R_dom + 9) :=
          mul_le_mul h1_lin h1_lin zero_le_one (by linarith)
    have h2 : 1 ≤ (2 * A * R_cut + 5) ^ 2 := by
      rw [sq]
      calc (1 : ℝ) = 1 * 1 := by norm_num
        _ ≤ (2 * A * R_cut + 5) * (2 * A * R_cut + 5) :=
          mul_le_mul h2_lin h2_lin zero_le_one (by linarith)
    dsimp [C_modes]
    calc (1 : ℝ) = 1 * 1 := by norm_num
      _ ≤ (2 * R_dom + 9) ^ 2 * (2 * A * R_cut + 5) ^ 2 :=
        mul_le_mul h1 h2 zero_le_one (by linarith)
  let K_mult : ℕ := ⌈2 * A⌉₊
  let M_mult : ℕ := (2 * K_mult + 1) ^ 2
  have hM_mult : 1 ≤ M_mult := by
    dsimp [M_mult]
    exact Nat.one_le_pow 2 (2 * K_mult + 1) (by omega)
  refine ⟨C_modes, M_mult, hC_modes, hM_mult, ?_⟩
  intro lam_sys hlam_sys Φ₀ ζ₀ h_phase
  obtain ⟨_, hζ_smooth, _, _, _, _, _, hζ_pos, hζ_gevrey⟩ := h_phase
  have hFv_smooth : ∀ (v : EuclideanSpace ℝ (Fin 2)) (k : ℕ),
      ContDiff ℝ k (fun p => ζ₀ (v, p)) := by
    intro v k
    exact (hζ_smooth k).comp (contDiff_const.prodMk contDiff_id)
  have hFv_diff : ∀ (v p : EuclideanSpace ℝ (Fin 2)),
      DifferentiableAt ℝ (fun p' => ζ₀ (v, p')) p := by
    intro v p
    exact ((hFv_smooth v 1).differentiable (by simp)).differentiableAt
  have hFv_fderiv_le : ∀ (v p : EuclideanSpace ℝ (Fin 2)),
      ‖fderiv ℝ (fun p' => ζ₀ (v, p')) p‖ ≤ A := by
    intro v p
    have h0 := hζ_gevrey 0 (v, p)
    rw [norm_iteratedFDeriv_zero] at h0
    simpa using h0
  have h_upper : ∀ (v p₁ p₂ : EuclideanSpace ℝ (Fin 2)),
      ‖ζ₀ (v, p₁) - ζ₀ (v, p₂)‖ ≤ A * ‖p₁ - p₂‖ := by
    intro v p₁ p₂
    exact convex_univ.norm_image_sub_le_of_norm_fderiv_le
      (fun p _ => hFv_diff v p) (fun p _ => hFv_fderiv_le v p)
      (Set.mem_univ p₂) (Set.mem_univ p₁)
  have h_lower : ∀ (v p₁ p₂ : EuclideanSpace ℝ (Fin 2)),
      a₀ * ‖p₁ - p₂‖ ≤ ‖ζ₀ (v, p₁) - ζ₀ (v, p₂)‖ := by
    intro v p₁ p₂
    let u := p₁ - p₂
    let g : ℝ → ℝ := fun τ => inner ℝ (ζ₀ (v, p₂ + τ • u)) u - (a₀ * ‖u‖ ^ 2) * τ
    let g' : ℝ → ℝ := fun τ =>
      inner ℝ (fderiv ℝ (fun p' => ζ₀ (v, p')) (p₂ + τ • u) u) u - a₀ * ‖u‖ ^ 2
    have hg_deriv : ∀ τ : ℝ, HasDerivAt g (g' τ) τ := by
      intro τ
      have h_aff : HasDerivAt (fun t : ℝ => p₂ + t • u) u τ := by
        simpa [one_smul] using ((hasDerivAt_id τ).smul_const u).const_add p₂
      have h_comp : HasDerivAt (fun t : ℝ => ζ₀ (v, p₂ + t • u))
          (fderiv ℝ (fun p' => ζ₀ (v, p')) (p₂ + τ • u) u) τ :=
        HasFDerivAt.comp_hasDerivAt (l := fun p' => ζ₀ (v, p')) τ
          (hFv_diff v (p₂ + τ • u)).hasFDerivAt h_aff
      have h_inn : HasDerivAt (fun t : ℝ => inner ℝ (ζ₀ (v, p₂ + t • u)) u)
          (inner ℝ (fderiv ℝ (fun p' => ζ₀ (v, p')) (p₂ + τ • u) u) u) τ := by
        simpa [inner_zero_right, zero_add] using h_comp.inner ℝ (hasDerivAt_const τ u)
      have h_lin : HasDerivAt (fun t : ℝ => (a₀ * ‖u‖ ^ 2) * t) (a₀ * ‖u‖ ^ 2) τ := by
        simpa [mul_one] using (hasDerivAt_id τ).const_mul (a₀ * ‖u‖ ^ 2)
      exact h_inn.sub h_lin
    have hg'_nn : 0 ≤ g' := by
      intro τ
      dsimp [g']
      have hpos := (hζ_pos v (p₂ + τ • u) u).1
      linarith
    have hg_mono : Monotone g := monotone_of_hasDerivAt_nonneg hg_deriv hg'_nn
    have hg01 : g 0 ≤ g 1 := hg_mono zero_le_one
    have hp_eq : p₂ + (1 : ℝ) • u = p₁ := by
      dsimp [u]
      rw [one_smul, add_sub_cancel]
    have hp0_eq : p₂ + (0 : ℝ) • u = p₂ := by
      rw [zero_smul, add_zero]
    have h_diff_inn : a₀ * ‖u‖ ^ 2 ≤ inner ℝ (ζ₀ (v, p₁) - ζ₀ (v, p₂)) u := by
      dsimp [g] at hg01
      rw [hp0_eq, hp_eq, mul_zero, sub_zero, mul_one] at hg01
      rw [inner_sub_left]
      linarith
    have h_cs : inner ℝ (ζ₀ (v, p₁) - ζ₀ (v, p₂)) u ≤ ‖ζ₀ (v, p₁) - ζ₀ (v, p₂)‖ * ‖u‖ :=
      real_inner_le_norm _ _
    have h_sq_le : a₀ * ‖u‖ ^ 2 ≤ ‖ζ₀ (v, p₁) - ζ₀ (v, p₂)‖ * ‖u‖ := le_trans h_diff_inn h_cs
    rcases eq_or_lt_of_le (norm_nonneg u) with hu0 | hu_pos
    · dsimp [u] at hu0
      rw [← hu0, mul_zero]
      exact norm_nonneg _
    · have h_mul : (a₀ * ‖u‖) * ‖u‖ ≤ ‖ζ₀ (v, p₁) - ζ₀ (v, p₂)‖ * ‖u‖ := by
        calc (a₀ * ‖u‖) * ‖u‖ = a₀ * ‖u‖ ^ 2 := by ring
          _ ≤ ‖ζ₀ (v, p₁) - ζ₀ (v, p₂)‖ * ‖u‖ := h_sq_le
      exact le_of_mul_le_mul_right h_mul hu_pos
  refine ⟨fun v p₁ p₂ => ⟨h_lower v p₁ p₂, h_upper v p₁ p₂⟩, ?_⟩
  have h_surj : ∀ v : EuclideanSpace ℝ (Fin 2), Function.Surjective (fun p => ζ₀ (v, p)) := by
    intro v
    let F_v : EuclideanSpace ℝ (Fin 2) → EuclideanSpace ℝ (Fin 2) := fun p => ζ₀ (v, p)
    have hA_nn : 0 ≤ A := by linarith
    have ha₀_inv_nn : 0 ≤ a₀⁻¹ := inv_nonneg.mpr ha₀.le
    have h_lip_F : LipschitzWith (Real.toNNReal A) F_v := by
      refine LipschitzWith.of_dist_le_mul (fun p₁ p₂ => ?_)
      rw [Real.coe_toNNReal A hA_nn, dist_eq_norm, dist_eq_norm]
      exact h_upper v p₁ p₂
    have h_anti_F : AntilipschitzWith (Real.toNNReal a₀⁻¹) F_v := by
      refine AntilipschitzWith.of_le_mul_dist (fun p₁ p₂ => ?_)
      rw [Real.coe_toNNReal a₀⁻¹ ha₀_inv_nn, dist_eq_norm, dist_eq_norm]
      have hlow := h_lower v p₁ p₂
      calc ‖p₁ - p₂‖ = a₀⁻¹ * (a₀ * ‖p₁ - p₂‖) := by field_simp [ha₀.ne']
        _ ≤ a₀⁻¹ * ‖F_v p₁ - F_v p₂‖ := mul_le_mul_of_nonneg_left hlow ha₀_inv_nn
    have h_closed : IsClosed (Set.range F_v) :=
      h_anti_F.isClosed_range h_lip_F.uniformContinuous
    have h_open : IsOpen (Set.range F_v) := by
      rw [isOpen_iff_mem_nhds]
      rintro _ ⟨p, rfl⟩
      let L : EuclideanSpace ℝ (Fin 2) →L[ℝ] EuclideanSpace ℝ (Fin 2) := fderiv ℝ F_v p
      have hL_inj : Function.Injective
          ⇑(L : EuclideanSpace ℝ (Fin 2) →ₗ[ℝ] EuclideanSpace ℝ (Fin 2)) := by
        intro u₁ u₂ h_eq
        have h_sub0 : L (u₁ - u₂) = 0 := by
          change (L : EuclideanSpace ℝ (Fin 2) →ₗ[ℝ] EuclideanSpace ℝ (Fin 2)) (u₁ - u₂) = 0
          rw [map_sub, h_eq, sub_self]
        have h_coerc := (hζ_pos v p (u₁ - u₂)).1
        change a₀ * ‖u₁ - u₂‖ ^ 2 ≤ inner ℝ (L (u₁ - u₂)) (u₁ - u₂) at h_coerc
        rw [h_sub0, inner_zero_left] at h_coerc
        have h_sq_nn : 0 ≤ ‖u₁ - u₂‖ ^ 2 := sq_nonneg _
        have h_sq_zero : ‖u₁ - u₂‖ ^ 2 = 0 := by nlinarith
        exact sub_eq_zero.mp (norm_eq_zero.mp (sq_eq_zero_iff.mp h_sq_zero))
      have hL_surj : Function.Surjective
          ⇑(L : EuclideanSpace ℝ (Fin 2) →ₗ[ℝ] EuclideanSpace ℝ (Fin 2)) :=
        LinearMap.surjective_of_injective hL_inj
      have hL_ker :
          LinearMap.ker (L : EuclideanSpace ℝ (Fin 2) →ₗ[ℝ] EuclideanSpace ℝ (Fin 2)) = ⊥ :=
        LinearMap.ker_eq_bot.mpr hL_inj
      have hL_range :
          LinearMap.range (L : EuclideanSpace ℝ (Fin 2) →ₗ[ℝ] EuclideanSpace ℝ (Fin 2)) = ⊤ :=
        LinearMap.range_eq_top.mpr hL_surj
      let e_p : EuclideanSpace ℝ (Fin 2) ≃L[ℝ] EuclideanSpace ℝ (Fin 2) :=
        ContinuousLinearEquiv.ofBijective L hL_ker hL_range
      have hf_strict_L : HasStrictFDerivAt F_v L p :=
        (hFv_smooth v 1).hasStrictFDerivAt (by simp)
      have hf_strict : HasStrictFDerivAt F_v
          (e_p : EuclideanSpace ℝ (Fin 2) →L[ℝ] EuclideanSpace ℝ (Fin 2)) p := by
        rw [ContinuousLinearEquiv.coe_ofBijective L hL_ker hL_range]
        exact hf_strict_L
      exact (hf_strict.eventually_right_inverse).mono (fun z hz => ⟨_, hz⟩)
    have h_clopen : IsClopen (Set.range F_v) := ⟨h_closed, h_open⟩
    have h_ne : (Set.range F_v).Nonempty := ⟨F_v 0, 0, rfl⟩
    have h_univ : Set.range F_v = Set.univ :=
      (isClopen_iff.mp h_clopen).resolve_left h_ne.ne_empty
    exact Set.range_eq_univ.mp h_univ
  have h_grid_coord : ∀ (s : ℝ), 0 ≤ s → ∀ (k : ℤ × ℤ),
      s * |(k.1 : ℝ)| ≤ ‖gridPt2D s k‖ ∧ s * |(k.2 : ℝ)| ≤ ‖gridPt2D s k‖ := by
    intro s hs k
    have h0 := PiLp.norm_apply_le (gridPt2D s k) 0
    have h1 := PiLp.norm_apply_le (gridPt2D s k) 1
    have hc0 : (gridPt2D s k).ofLp 0 = s * (k.1 : ℝ) := by simp [gridPt2D]
    have hc1 : (gridPt2D s k).ofLp 1 = s * (k.2 : ℝ) := by simp [gridPt2D]
    rw [hc0, Real.norm_eq_abs, abs_mul, abs_of_nonneg hs] at h0
    rw [hc1, Real.norm_eq_abs, abs_mul, abs_of_nonneg hs] at h1
    exact ⟨h0, h1⟩
  have h_grid_sub : ∀ (n n₀ : ℤ × ℤ),
      gridPt2D 1 n - gridPt2D 1 n₀ = gridPt2D 1 (n.1 - n₀.1, n.2 - n₀.2) := by
    intro n n₀
    ext i
    fin_cases i <;> simp [gridPt2D, Int.cast_sub]
  have h_round_err : ∀ (s : ℝ), 0 < s → ∀ (x : EuclideanSpace ℝ (Fin 2)),
      ‖gridPt2D s (pktRound2D s x) - x‖ ≤ s := by
    intro s hs x
    rw [norm_sub_rev]
    let k := pktRound2D s x
    have h0 : |x.ofLp 0 - s * (k.1 : ℝ)| ≤ (1 / 2) * s := by
      have hfl : (k.1 : ℝ) ≤ s⁻¹ * x 0 + 1 / 2 := Int.floor_le _
      have hlt : s⁻¹ * x 0 + 1 / 2 < (k.1 : ℝ) + 1 := Int.lt_floor_add_one _
      have hm1 := mul_le_mul_of_nonneg_left hfl hs.le
      have hm2 := mul_lt_mul_of_pos_left hlt hs
      have hmul : s * (s⁻¹ * x 0 + 1 / 2) = x.ofLp 0 + (1 / 2) * s := by
        field_simp [hs.ne']
      rw [hmul] at hm1 hm2
      rw [mul_add, mul_one] at hm2
      rw [abs_le]
      exact ⟨by linarith only [hm1], by linarith only [hm2]⟩
    have h1 : |x.ofLp 1 - s * (k.2 : ℝ)| ≤ (1 / 2) * s := by
      have hfl : (k.2 : ℝ) ≤ s⁻¹ * x 1 + 1 / 2 := Int.floor_le _
      have hlt : s⁻¹ * x 1 + 1 / 2 < (k.2 : ℝ) + 1 := Int.lt_floor_add_one _
      have hm1 := mul_le_mul_of_nonneg_left hfl hs.le
      have hm2 := mul_lt_mul_of_pos_left hlt hs
      have hmul : s * (s⁻¹ * x 1 + 1 / 2) = x.ofLp 1 + (1 / 2) * s := by
        field_simp [hs.ne']
      rw [hmul] at hm1 hm2
      rw [mul_add, mul_one] at hm2
      rw [abs_le]
      exact ⟨by linarith only [hm1], by linarith only [hm2]⟩
    have hsq : ‖x - gridPt2D s k‖ ^ 2 ≤ s ^ 2 := by
      rw [EuclideanSpace.norm_sq_eq, Fin.sum_univ_two]
      have hc0 : (x - gridPt2D s k).ofLp 0 = x.ofLp 0 - s * (k.1 : ℝ) := by
