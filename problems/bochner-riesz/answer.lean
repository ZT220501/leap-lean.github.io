    have hχ₂_gt : a_pt 2 < χ₂ :=
      lt_min ha2_lt1 (lt_min (by linarith) (by linarith))
    let α₂ : ℝ := (χ₂ - a_pt 2) / 2
    have hα₂_pos : 0 < α₂ := by dsimp [α₂]; linarith
    obtain ⟨η₂, ρ₁₂, hη₂_pos, hρ₁₂_pos, _, h_slice2⟩ :=
      strip_two_replica_b0_slice_bound s (a_pt 1) (a_pt 2) α₂
        hs₀ hs₁ ha1_gt1 ha1_le2 ha2_nn ha2_lt1 hα₂_pos h_core h_proj
    let η_t2 : ℝ := min η₂ (α₂ / 4)
