            c_m_g * (v_perp - ((g.2.2.2.1 : ℝ) + 1 / 2) * s_e) := by
        dsimp only [aa_hat, c_m_g]
        rw [hx_eq]
        ring
      have herr_x : |x_perp - ((g.2.2.2.2.2 : ℝ) + 1 / 2) * s_e1| ≤ (1 / 2) * s_e1 := by
        rw [hg6_eq]
        exact h_mid_err (e + 1) x_perp
      have herr_v : |v_perp - ((g.2.2.2.1 : ℝ) + 1 / 2) * s_e| ≤ (1 / 2) * s_e := by
        rw [hg4_eq]
        exact h_mid_err e v_perp
      have h_err_a : |a_perp - aa_hat g| ≤ s_e := by
        rw [h_diff_id]
        calc |(x_perp - ((g.2.2.2.2.2 : ℝ) + 1 / 2) * s_e1) -
                c_m_g * (v_perp - ((g.2.2.2.1 : ℝ) + 1 / 2) * s_e)|
            ≤ |x_perp - ((g.2.2.2.2.2 : ℝ) + 1 / 2) * s_e1| +
                |c_m_g * (v_perp - ((g.2.2.2.1 : ℝ) + 1 / 2) * s_e)| := abs_sub _ _
          _ = |x_perp - ((g.2.2.2.2.2 : ℝ) + 1 / 2) * s_e1| +
                c_m_g * |v_perp - ((g.2.2.2.1 : ℝ) + 1 / 2) * s_e| := by
