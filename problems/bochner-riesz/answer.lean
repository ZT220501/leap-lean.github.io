    rw [h_rhs_eq] at h_res
    have h_exp_lt : -χ₂ + α₂ / 2 < -(κ_l / t) + -a_pt 2 := by
      have hα_def : α₂ = (χ₂ - a_pt 2) / 2 := rfl
      linarith [hκ_le_η8', hη_t2_le_α, hη_t2_pos, hα₂_pos, hα_def]
    have h_strict := Real.rpow_lt_rpow_of_exponent_gt hρ_t_pos hρ_t_lt_one h_exp_lt
    linarith [h_res, h_strict]

theorem matched_clock_pointwise_rate_transfer (γ m : ℝ) (hγ₀ : 0 < γ) (hγ₁ : γ < 1) (hm : 0 < m)
    (h_two : (2 : ℝ) ∈ ValidClassicalGrowthRates γ)
    (h_gt : γ < classicalGrowthRate γ)
    (sys : MatchedAspectProfileSystem γ m) :
    ∃ σ : ℝ, 0 < σ ∧
      (m ≠ 1 →
        ∀ (i u s D_pt : ℝ) (a_pt : Fin 4 → ℝ) (h_seq : ℕ → ℝ),
          0 < i → u ∈ Set.Ioo (0 : ℝ) 1 →
          HasDerivAt sys.S s u →
          (∀ l, 0 < h_seq l) →
