  let M_ret : ℝ := ∑ i ∈ S_keep, ν₀₁_P i
  have hM_ret_pos : 0 < M_ret := by dsimp [M_ret] at *; linarith
  let ν_star : Fin N_P → Fin N_Θ → ℝ := fun i b₂ => if i ∈ S_keep then ν₀₁ i b₂ / M_ret else 0
  let ν_P : Fin N_P → ℝ := fun i => ∑ b₂, ν_star i b₂
  have hν_star_nn : ∀ i b₂, 0 ≤ ν_star i b₂ := by
    intro i b₂; dsimp [ν_star]
    split_ifs
    · exact div_nonneg (hν₀₁_nn i b₂) hM_ret_pos.le
    · exact le_rfl
  have hν_P_eq : ∀ i, ν_P i = if i ∈ S_keep then ν₀₁_P i / M_ret else 0 := by
    intro i; dsimp [ν_P, ν_star]
    split_ifs
    · exact (Finset.sum_div _ _ _).symm
    · simp
  have hν_P_nn : ∀ i, 0 ≤ ν_P i := fun i => Finset.sum_nonneg (fun b₂ _ => hν_star_nn i b₂)
  have hν_P_sum : ∑ i : Fin N_P, ν_P i = 1 := by
    simp only [hν_P_eq, ← Finset.sum_filter]
    have h_filt : Finset.univ.filter (fun i => i ∈ S_keep) = S_keep := by
      ext i; simp
    rw [h_filt, ← Finset.sum_div]
    exact div_self hM_ret_pos.ne'
  have hν_star_sum : ∑ i : Fin N_P, ∑ b₂ : Fin N_Θ, ν_star i b₂ = 1 := hν_P_sum
