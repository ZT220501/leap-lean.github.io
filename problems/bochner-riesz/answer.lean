      intro j i u
      have hd := h_deriv_fderiv F hF (coneBasisL n j)
        (fun u' => planeEmbed n c (i, u') + η) (c, 1) u (h_curve_ver η i u)
      refine hd.congr_deriv ?_
      simp [D_u, F_LL, F_VL, p_fn]
    let LHS_fn : ℝ × ℝ → ℝ := fun iu =>
