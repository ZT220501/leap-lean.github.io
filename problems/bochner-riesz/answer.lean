        finMutualInfo ε π X Z + finCondEntropy ε π Z Y -
          finCondEntropy ε π (fun ω => (X ω, Z ω)) Y := by
      unfold finMutualInfo
      rw [h_chain (fun _ => ()) Z Y, h_chain X Z Y, h_unit_cond Z Y]
      ring
