    refine ⟨C_hess, hC_hess_nn, fun F η hF h_signs => ?_⟩
    let p_fn : ℝ × ℝ → (Fin n → ℝ) × ℝ := fun iu => planeEmbed n c iu + η
    have hp_cont : Continuous p_fn := h_cont_plane.add continuous_const
    let h_fn : Fin n → ℝ × ℝ → ℝ := fun j iu => fderiv ℝ F (p_fn iu) (coneBasisL n j)
    let F_LL : Fin n → Fin n → ℝ × ℝ → ℝ :=
