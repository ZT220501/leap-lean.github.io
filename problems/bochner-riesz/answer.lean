                abs_add_le _ _
            _ = |t| * |iteratedDeriv m (f_vec e) t| + (m : ℝ) * |iteratedDeriv k (f_vec e) t| := by
                have hm_abs : |(m : ℝ)| = (m : ℝ) := abs_of_nonneg (Nat.cast_nonneg m)
