          rw [h_sum_partition_pred Finset.univ S_U1 bU₁
            (fun i => bX i = v₀.1 ∧ bZ₁ i = v₂.1) (fun k_U => in_box v₁ (Φ_U k_U)) w₁
            (fun i _ => hbU1_mem i)]
