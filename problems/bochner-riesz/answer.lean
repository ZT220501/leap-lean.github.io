        refine mul_le_mul (by linarith) hm_wz ?_ (by norm_num)
        positivity
      rw [hB1_sq] at hm_all
      have h_cloc_ge : 100 * ((96 * (N : ℝ) + 182) ^ 2 * ε ^ (-2 * ν)) ≤
