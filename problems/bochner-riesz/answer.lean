theorem two_replica_scalar_rate_transfer (s σ : ℝ) (hs₀ : 0 < s) (hs₁ : s ≤ 1) (hσ₀ : 0 < σ) (hσ₁ : σ ≤ 1)
    (h_proj : WeightedTaggedProjectionBound) :
    (∀ a_pt : Fin 4 → ℝ,
      (∀ j, 0 ≤ a_pt j ∧ a_pt j ≤ 1) →
      CanonicalAffineBlockDistinct s σ a_pt →
      MatchedClockRatesDistinct s σ a_pt) ∧
    (∀ a_pt : Fin 3 → ℝ,
      (0 ≤ a_pt 0 ∧ a_pt 0 ≤ 1 ∧ 0 ≤ a_pt 1 ∧ a_pt 1 ≤ 2 ∧ 0 ≤ a_pt 2 ∧ a_pt 2 ≤ 1) →
      CanonicalAffineBlockTied s σ a_pt →
      0 < a_pt 0 → s ≤ a_pt 1) :=
by
  classical
  
  have h_mid_err : ∀ (ρ x : ℝ), 0 < ρ → |canonicalGridMid ρ x - x| ≤ ρ / 2 := by
    intro ρ x hρ
    unfold canonicalGridMid canonicalGridBin
    have h1 : (⌊x / ρ⌋ : ℝ) * ρ ≤ x := (le_div_iff₀ hρ).mp (Int.floor_le (x / ρ))
    have h2 : x < ((⌊x / ρ⌋ : ℝ) + 1) * ρ := (div_lt_iff₀ hρ).mp (Int.lt_floor_add_one (x / ρ))
    rw [abs_le]
    constructor <;> linarith
  have h_mid_dom : ∀ (ρ : ℝ) (P : Fin 4 → ℝ) (θ : ℝ × ℝ) (j : Fin 4),
      0 < ρ → ρ < 1 / 2 → (∀ k, |P k| ≤ 4) → |θ.1| ≤ 4 → |θ.2| ≤ 4 →
      |canonicalGridMid ρ (canonicalShear4 P θ j)| ≤ 125 := by
    intro ρ P θ j hρ0 hρ1 hP hθ1 hθ2
    have hQ : |canonicalShear4 P θ j| ≤ 100 := by
      have h0 := hP 0; have h1 := hP 1; have h2 := hP 2; have h3 := hP 3
      have hm10 : |θ.1 * P 0| ≤ 16 := by
        rw [abs_mul]; linarith [mul_le_mul hθ1 h0 (abs_nonneg _) (by norm_num : (0 : ℝ) ≤ 4)]
      have hm20 : |θ.2 * P 0| ≤ 16 := by
        rw [abs_mul]; linarith [mul_le_mul hθ2 h0 (abs_nonneg _) (by norm_num : (0 : ℝ) ≤ 4)]
      have hm12 : |θ.1 * P 2| ≤ 16 := by
        rw [abs_mul]; linarith [mul_le_mul hθ1 h2 (abs_nonneg _) (by norm_num : (0 : ℝ) ≤ 4)]
      have hm21 : |θ.2 * P 1| ≤ 16 := by
        rw [abs_mul]; linarith [mul_le_mul hθ2 h1 (abs_nonneg _) (by norm_num : (0 : ℝ) ≤ 4)]
      have hm12_θ : |θ.1 * θ.2| ≤ 16 := by
        rw [abs_mul]; linarith [mul_le_mul hθ1 hθ2 (abs_nonneg _) (by norm_num : (0 : ℝ) ≤ 4)]
      have hm120 : |θ.1 * θ.2 * P 0| ≤ 64 := by
        rw [abs_mul]; linarith [mul_le_mul hm12_θ h0 (abs_nonneg _) (by norm_num : (0 : ℝ) ≤ 16)]
      fin_cases j
      · simpa [canonicalShear4] using le_trans h0 (by norm_num)
      · dsimp [canonicalShear4]
        linarith [abs_add_le (P 1) (θ.1 * P 0)]
      · dsimp [canonicalShear4]
        linarith [abs_add_le (P 2) (θ.2 * P 0)]
      · dsimp [canonicalShear4]
        have ha1 := abs_add_le (P 3 + θ.1 * P 2 + θ.2 * P 1) (θ.1 * θ.2 * P 0)
        have ha2 := abs_add_le (P 3 + θ.1 * P 2) (θ.2 * P 1)
        have ha3 := abs_add_le (P 3) (θ.1 * P 2)
        linarith
    have herr := h_mid_err ρ (canonicalShear4 P θ j) hρ0
    rw [abs_le] at herr hQ ⊢
    constructor <;> linarith
  have h_xP_dom : ∀ u₀ u₁ : ℝ, |u₀| ≤ 125 → |u₁| ≤ 125 →
      ‖(WithLp.toLp 2 ![u₀, u₁] : EuclideanSpace ℝ (Fin 2))‖ ≤ 250 := by
    intro u₀ u₁ hu₀ hu₁
    have hsq0 : u₀ ^ 2 ≤ 125 ^ 2 := by
      have h := (sq_le_sq₀ (abs_nonneg u₀) (by norm_num)).mpr hu₀
      rwa [sq_abs] at h
    have hsq1 : u₁ ^ 2 ≤ 125 ^ 2 := by
      have h := (sq_le_sq₀ (abs_nonneg u₁) (by norm_num)).mpr hu₁
      rwa [sq_abs] at h
    have hnorm2 : ‖(WithLp.toLp 2 ![u₀, u₁] : EuclideanSpace ℝ (Fin 2))‖ ^ 2 ≤ 250 ^ 2 := by
      rw [PiLp.norm_sq_eq_of_L2]
      simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one, Real.norm_eq_abs,
        sq_abs]
      linarith
    exact (sq_le_sq₀ (norm_nonneg _) (by norm_num)).mp hnorm2
  have h_shear_u1 : ∀ (ρ : ℝ) (P : Fin 4 → ℝ) (θ₀ θ₁ : ℝ × ℝ),
      0 < ρ → |θ₀.1| ≤ 4 → |θ₁.1| ≤ 4 →
      |(canonicalGridMid ρ (canonicalShear4 P θ₀ 1) -
          (-(θ₁.1 - θ₀.1)) * canonicalGridMid ρ (canonicalShear4 P θ₀ 0)) -
        canonicalGridMid ρ (canonicalShear4 P θ₁ 1)| ≤ 5 * ρ := by
    intro ρ P θ₀ θ₁ hρ h0 h1
    let Q₀ := canonicalShear4 P θ₀
    let Q₁ := canonicalShear4 P θ₁
    let M₀ := fun j => canonicalGridMid ρ (Q₀ j)
    let M₁ := fun j => canonicalGridMid ρ (Q₁ j)
    let Δ₁ := θ₁.1 - θ₀.1
    have h_id : Q₁ 1 = Q₀ 1 + Δ₁ * Q₀ 0 := by dsimp [Q₀, Q₁, Δ₁, canonicalShear4]; ring
    have h_diff : (M₀ 1 - (-Δ₁) * M₀ 0) - M₁ 1 =
        (M₀ 1 - Q₀ 1) + Δ₁ * (M₀ 0 - Q₀ 0) - (M₁ 1 - Q₁ 1) := by linear_combination -h_id
    change |(M₀ 1 - (-Δ₁) * M₀ 0) - M₁ 1| ≤ 5 * ρ
    rw [h_diff]
    have hΔ : |Δ₁| ≤ 8 := by dsimp [Δ₁]; rw [abs_le] at h0 h1 ⊢; constructor <;> linarith
    have he0 := h_mid_err ρ (Q₀ 0) hρ
    have he1 := h_mid_err ρ (Q₀ 1) hρ
    have he1' := h_mid_err ρ (Q₁ 1) hρ
    have hm : |Δ₁ * (M₀ 0 - Q₀ 0)| ≤ 8 * (ρ / 2) := by
      rw [abs_mul]
      exact mul_le_mul hΔ he0 (abs_nonneg _) (by norm_num)
    have ht1 := abs_sub ((M₀ 1 - Q₀ 1) + Δ₁ * (M₀ 0 - Q₀ 0)) (M₁ 1 - Q₁ 1)
    have ht2 := abs_add_le (M₀ 1 - Q₀ 1) (Δ₁ * (M₀ 0 - Q₀ 0))
    linarith
  have h_shear_u2 : ∀ (ρ : ℝ) (P : Fin 4 → ℝ) (θ₀ θ₁ : ℝ × ℝ),
      0 < ρ → |θ₀.2| ≤ 4 → |θ₁.2| ≤ 4 →
      |(canonicalGridMid ρ (canonicalShear4 P θ₀ 2) -
          (-(θ₁.2 - θ₀.2)) * canonicalGridMid ρ (canonicalShear4 P θ₀ 0)) -
        canonicalGridMid ρ (canonicalShear4 P θ₁ 2)| ≤ 5 * ρ := by
    intro ρ P θ₀ θ₁ hρ h0 h1
    let Q₀ := canonicalShear4 P θ₀
    let Q₁ := canonicalShear4 P θ₁
    let M₀ := fun j => canonicalGridMid ρ (Q₀ j)
    let M₁ := fun j => canonicalGridMid ρ (Q₁ j)
    let Δ₂ := θ₁.2 - θ₀.2
    have h_id : Q₁ 2 = Q₀ 2 + Δ₂ * Q₀ 0 := by dsimp [Q₀, Q₁, Δ₂, canonicalShear4]; ring
    have h_diff : (M₀ 2 - (-Δ₂) * M₀ 0) - M₁ 2 =
        (M₀ 2 - Q₀ 2) + Δ₂ * (M₀ 0 - Q₀ 0) - (M₁ 2 - Q₁ 2) := by linear_combination -h_id
    change |(M₀ 2 - (-Δ₂) * M₀ 0) - M₁ 2| ≤ 5 * ρ
    rw [h_diff]
    have hΔ : |Δ₂| ≤ 8 := by dsimp [Δ₂]; rw [abs_le] at h0 h1 ⊢; constructor <;> linarith
    have he0 := h_mid_err ρ (Q₀ 0) hρ
    have he2 := h_mid_err ρ (Q₀ 2) hρ
    have he2' := h_mid_err ρ (Q₁ 2) hρ
    have hm : |Δ₂ * (M₀ 0 - Q₀ 0)| ≤ 8 * (ρ / 2) := by
      rw [abs_mul]
      exact mul_le_mul hΔ he0 (abs_nonneg _) (by norm_num)
    have ht1 := abs_sub ((M₀ 2 - Q₀ 2) + Δ₂ * (M₀ 0 - Q₀ 0)) (M₁ 2 - Q₁ 2)
    have ht2 := abs_add_le (M₀ 2 - Q₀ 2) (Δ₂ * (M₀ 0 - Q₀ 0))
    linarith
  have h_shear_s1 : ∀ (ρ m₀ m₁ : ℝ) (P : Fin 4 → ℝ) (θ₀ θ₁ : ℝ × ℝ),
      0 < ρ → |θ₀.1| ≤ 4 → |θ₀.2| ≤ 4 → |θ₁.1| ≤ 4 → |θ₁.2| ≤ 4 →
      canonicalGridMid ρ (canonicalShear4 P θ₀ 0) = m₀ →
      canonicalGridMid ρ (canonicalShear4 P θ₀ 1) = m₁ →
      let Δ₁ := θ₁.1 - θ₀.1
      let Δ₂ := θ₁.2 - θ₀.2
      |(canonicalGridMid ρ (canonicalShear4 P θ₀ 3) -
          (-Δ₁) * canonicalGridMid ρ (canonicalShear4 P θ₀ 2)) -
        (canonicalGridMid ρ (canonicalShear4 P θ₁ 3) - (Δ₂ * m₁ + Δ₁ * Δ₂ * m₀))| ≤ 41 * ρ := by
    intro ρ m₀ m₁ P θ₀ θ₁ hρ h01 h02 h11 h12 hm0 hm1
    let Q₀ := canonicalShear4 P θ₀
    let Q₁ := canonicalShear4 P θ₁
    let M₀ := fun j => canonicalGridMid ρ (Q₀ j)
    let M₁ := fun j => canonicalGridMid ρ (Q₁ j)
    let Δ₁ := θ₁.1 - θ₀.1
    let Δ₂ := θ₁.2 - θ₀.2
    have h_id : Q₁ 3 = Q₀ 3 + Δ₁ * Q₀ 2 + Δ₂ * Q₀ 1 + Δ₁ * Δ₂ * Q₀ 0 := by
      dsimp [Q₀, Q₁, Δ₁, Δ₂, canonicalShear4]; ring
    change |(M₀ 3 - (-Δ₁) * M₀ 2) - (M₁ 3 - (Δ₂ * m₁ + Δ₁ * Δ₂ * m₀))| ≤ 41 * ρ
    rw [← hm0, ← hm1]
    change |(M₀ 3 - (-Δ₁) * M₀ 2) - (M₁ 3 - (Δ₂ * M₀ 1 + Δ₁ * Δ₂ * M₀ 0))| ≤ 41 * ρ
    have h_diff : (M₀ 3 - (-Δ₁) * M₀ 2) - (M₁ 3 - (Δ₂ * M₀ 1 + Δ₁ * Δ₂ * M₀ 0)) =
        (M₀ 3 - Q₀ 3) + Δ₁ * (M₀ 2 - Q₀ 2) + Δ₂ * (M₀ 1 - Q₀ 1) +
          (Δ₁ * Δ₂) * (M₀ 0 - Q₀ 0) - (M₁ 3 - Q₁ 3) := by linear_combination -h_id
    rw [h_diff]
    have hΔ1 : |Δ₁| ≤ 8 := by dsimp [Δ₁]; rw [abs_le] at h01 h11 ⊢; constructor <;> linarith
    have hΔ2 : |Δ₂| ≤ 8 := by dsimp [Δ₂]; rw [abs_le] at h02 h12 ⊢; constructor <;> linarith
    have hΔ12 : |Δ₁ * Δ₂| ≤ 64 := by
      rw [abs_mul]; linarith [mul_le_mul hΔ1 hΔ2 (abs_nonneg _) (by norm_num : (0 : ℝ) ≤ 8)]
    have he0 := h_mid_err ρ (Q₀ 0) hρ
    have he1 := h_mid_err ρ (Q₀ 1) hρ
    have he2 := h_mid_err ρ (Q₀ 2) hρ
    have he3 := h_mid_err ρ (Q₀ 3) hρ
    have he3' := h_mid_err ρ (Q₁ 3) hρ
    have hm_a : |Δ₁ * (M₀ 2 - Q₀ 2)| ≤ 8 * (ρ / 2) := by
      rw [abs_mul]; exact mul_le_mul hΔ1 he2 (abs_nonneg _) (by norm_num)
    have hm_b : |Δ₂ * (M₀ 1 - Q₀ 1)| ≤ 8 * (ρ / 2) := by
      rw [abs_mul]; exact mul_le_mul hΔ2 he1 (abs_nonneg _) (by norm_num)
    have hm_c : |(Δ₁ * Δ₂) * (M₀ 0 - Q₀ 0)| ≤ 64 * (ρ / 2) := by
      rw [abs_mul]; exact mul_le_mul hΔ12 he0 (abs_nonneg _) (by norm_num)
    have ht1 := abs_sub ((M₀ 3 - Q₀ 3) + Δ₁ * (M₀ 2 - Q₀ 2) + Δ₂ * (M₀ 1 - Q₀ 1) +
      (Δ₁ * Δ₂) * (M₀ 0 - Q₀ 0)) (M₁ 3 - Q₁ 3)
    have ht2 := abs_add_le ((M₀ 3 - Q₀ 3) + Δ₁ * (M₀ 2 - Q₀ 2) + Δ₂ * (M₀ 1 - Q₀ 1))
      ((Δ₁ * Δ₂) * (M₀ 0 - Q₀ 0))
    have ht3 := abs_add_le ((M₀ 3 - Q₀ 3) + Δ₁ * (M₀ 2 - Q₀ 2)) (Δ₂ * (M₀ 1 - Q₀ 1))
    have ht4 := abs_add_le (M₀ 3 - Q₀ 3) (Δ₁ * (M₀ 2 - Q₀ 2))
    linarith
  have h_shear_s2 : ∀ (ρ m₀ m₂ : ℝ) (P : Fin 4 → ℝ) (θ₀ θ₁ : ℝ × ℝ),
      0 < ρ → |θ₀.1| ≤ 4 → |θ₀.2| ≤ 4 → |θ₁.1| ≤ 4 → |θ₁.2| ≤ 4 →
      canonicalGridMid ρ (canonicalShear4 P θ₀ 0) = m₀ →
      canonicalGridMid ρ (canonicalShear4 P θ₀ 2) = m₂ →
      let Δ₁ := θ₁.1 - θ₀.1
      let Δ₂ := θ₁.2 - θ₀.2
      |(canonicalGridMid ρ (canonicalShear4 P θ₀ 3) -
          (-Δ₂) * canonicalGridMid ρ (canonicalShear4 P θ₀ 1)) -
        (canonicalGridMid ρ (canonicalShear4 P θ₁ 3) - (Δ₁ * m₂ + Δ₁ * Δ₂ * m₀))| ≤ 41 * ρ := by
    intro ρ m₀ m₂ P θ₀ θ₁ hρ h01 h02 h11 h12 hm0 hm2
    let Q₀ := canonicalShear4 P θ₀
    let Q₁ := canonicalShear4 P θ₁
    let M₀ := fun j => canonicalGridMid ρ (Q₀ j)
    let M₁ := fun j => canonicalGridMid ρ (Q₁ j)
    let Δ₁ := θ₁.1 - θ₀.1
    let Δ₂ := θ₁.2 - θ₀.2
    have h_id : Q₁ 3 = Q₀ 3 + Δ₁ * Q₀ 2 + Δ₂ * Q₀ 1 + Δ₁ * Δ₂ * Q₀ 0 := by
      dsimp [Q₀, Q₁, Δ₁, Δ₂, canonicalShear4]; ring
    change |(M₀ 3 - (-Δ₂) * M₀ 1) - (M₁ 3 - (Δ₁ * m₂ + Δ₁ * Δ₂ * m₀))| ≤ 41 * ρ
    rw [← hm0, ← hm2]
    change |(M₀ 3 - (-Δ₂) * M₀ 1) - (M₁ 3 - (Δ₁ * M₀ 2 + Δ₁ * Δ₂ * M₀ 0))| ≤ 41 * ρ
    have h_diff : (M₀ 3 - (-Δ₂) * M₀ 1) - (M₁ 3 - (Δ₁ * M₀ 2 + Δ₁ * Δ₂ * M₀ 0)) =
        (M₀ 3 - Q₀ 3) + Δ₂ * (M₀ 1 - Q₀ 1) + Δ₁ * (M₀ 2 - Q₀ 2) +
          (Δ₁ * Δ₂) * (M₀ 0 - Q₀ 0) - (M₁ 3 - Q₁ 3) := by linear_combination -h_id
    rw [h_diff]
    have hΔ1 : |Δ₁| ≤ 8 := by dsimp [Δ₁]; rw [abs_le] at h01 h11 ⊢; constructor <;> linarith
    have hΔ2 : |Δ₂| ≤ 8 := by dsimp [Δ₂]; rw [abs_le] at h02 h12 ⊢; constructor <;> linarith
    have hΔ12 : |Δ₁ * Δ₂| ≤ 64 := by
      rw [abs_mul]; linarith [mul_le_mul hΔ1 hΔ2 (abs_nonneg _) (by norm_num : (0 : ℝ) ≤ 8)]
    have he0 := h_mid_err ρ (Q₀ 0) hρ
    have he1 := h_mid_err ρ (Q₀ 1) hρ
    have he2 := h_mid_err ρ (Q₀ 2) hρ
    have he3 := h_mid_err ρ (Q₀ 3) hρ
    have he3' := h_mid_err ρ (Q₁ 3) hρ
    have hm_a : |Δ₂ * (M₀ 1 - Q₀ 1)| ≤ 8 * (ρ / 2) := by
      rw [abs_mul]; exact mul_le_mul hΔ2 he1 (abs_nonneg _) (by norm_num)
    have hm_b : |Δ₁ * (M₀ 2 - Q₀ 2)| ≤ 8 * (ρ / 2) := by
      rw [abs_mul]; exact mul_le_mul hΔ1 he2 (abs_nonneg _) (by norm_num)
    have hm_c : |(Δ₁ * Δ₂) * (M₀ 0 - Q₀ 0)| ≤ 64 * (ρ / 2) := by
      rw [abs_mul]; exact mul_le_mul hΔ12 he0 (abs_nonneg _) (by norm_num)
    have ht1 := abs_sub ((M₀ 3 - Q₀ 3) + Δ₂ * (M₀ 1 - Q₀ 1) + Δ₁ * (M₀ 2 - Q₀ 2) +
      (Δ₁ * Δ₂) * (M₀ 0 - Q₀ 0)) (M₁ 3 - Q₁ 3)
    have ht2 := abs_add_le ((M₀ 3 - Q₀ 3) + Δ₂ * (M₀ 1 - Q₀ 1) + Δ₁ * (M₀ 2 - Q₀ 2))
      ((Δ₁ * Δ₂) * (M₀ 0 - Q₀ 0))
    have ht3 := abs_add_le ((M₀ 3 - Q₀ 3) + Δ₂ * (M₀ 1 - Q₀ 1)) (Δ₁ * (M₀ 2 - Q₀ 2))
    have ht4 := abs_add_le (M₀ 3 - Q₀ 3) (Δ₂ * (M₀ 1 - Q₀ 1))
