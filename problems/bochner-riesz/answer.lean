    obtain ⟨hkc0, hkc1, hφ₁0, hφ₁1, hx₁0, hx₁1, hfl_x₁⟩ := h_ang_range θ₁ hθ₁
    obtain ⟨hkc₂0, hkc₂1, hφ₂0, hφ₂1, hx₂0, hx₂1, hfl_x₂⟩ := h_ang_range θ₂ hθ₂
