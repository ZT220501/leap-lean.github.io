            rw [h_div, Nat.cast_one, div_le_one hρ_pos]; exact hc1.trans hV_le
          · refine h_int_mem_icc kx0 (x₀ 0 / σ_r) 1 ?_
            have hc0 := PiLp.norm_apply_le (gridPt2D σ_r (kx0, kx1) - x₀) 0
