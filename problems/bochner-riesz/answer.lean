      have h2l_pos : (0 : ℝ) < (2 : ℝ) ^ l := by positivity
      have hv_prod : 2 < v * (2 : ℝ) ^ l := by
        have h := (div_lt_iff₀ hv.1).mp (lt_of_le_of_lt (le_max_left _ _) hB_lt)
