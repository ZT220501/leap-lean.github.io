        let σ_r := (lam_sys * ρ_r)⁻¹
        let V_j := gridPt2D ρ_r j
        let Y_j := X_o - (C_t - C_r) • V_j
        let d_jn := σ_r⁻¹ * ‖Y_j - X_ex j n‖
        let ν_j := ((2 / (Real.pi * σ_r) : ℝ) •
          (ζ₀ (V_j, X_J - C_r • V_j) - ζ₀ (V_j, X_o - C_t • V_j)))
        (ζ₀ (V_j, X_ex j n - C_r • V_j) =
          ζ₀ (V_j, X_J - C_r • V_j) - ((Real.pi * σ_r / 2 : ℝ) • gridPt2D 1 n)) →
        ‖gridPt2D 1 n - ν_j‖ ≤ A * d_jn ∧
        (0 < d_jn →
          ∃ w : EuclideanSpace ℝ (Fin 2),
            ‖w‖ = 1 ∧ ‖perp2D w‖ = 1 ∧
            a₀ * d_jn ≤
              (lam_sys * ρ_r) *
                inner ℝ (ζ₀ (V_j, X_o - C_t • V_j) - ζ₀ (V_j, X_J - C_r • V_j)) w +
              (Real.pi / 2) * inner ℝ (gridPt2D 1 n) w) := by
    intro lam_sys ρ_r C_r C_t hlam_pos hρ_r_pos ζ₀ hζ_cd hζ_pos hζ_lip
      X_J X_o X_ex j n σ_r V_j Y_j d_jn ν_j h_mode
    have hlam_ρ_pos : 0 < lam_sys * ρ_r := mul_pos hlam_pos hρ_r_pos
    have hσ_r_pos : 0 < σ_r := inv_pos.mpr hlam_ρ_pos
    have hσ_r_ne : σ_r ≠ 0 := hσ_r_pos.ne'
    have hlam_ρ_σ : (lam_sys * ρ_r) * σ_r = 1 := mul_inv_cancel₀ hlam_ρ_pos.ne'
    let p_A : EuclideanSpace ℝ (Fin 2) := X_o - C_t • V_j
    let p_B : EuclideanSpace ℝ (Fin 2) := X_ex j n - C_r • V_j
    let u : EuclideanSpace ℝ (Fin 2) := p_A - p_B
    have hu_eq : u = Y_j - X_ex j n := by
      ext i
      dsimp only [u, p_A, p_B, Y_j]
      simp only [PiLp.sub_apply, PiLp.smul_apply, smul_eq_mul]
      ring
    have hu_norm : ‖u‖ = σ_r * d_jn := by
      rw [hu_eq]
      dsimp only [d_jn]
      field_simp [hσ_r_ne]
    refine ⟨?_, ?_⟩
    · have hpi_pos : 0 < Real.pi := Real.pi_pos
      have hc_pos : 0 < 2 / (Real.pi * σ_r) := div_pos (by norm_num) (mul_pos hpi_pos hσ_r_pos)
      have h_sub_mode : ((Real.pi * σ_r / 2 : ℝ) • gridPt2D 1 n) =
          ζ₀ (V_j, X_J - C_r • V_j) - ζ₀ (V_j, p_B) := by
        dsimp only [p_B]
        rw [h_mode]
        abel
      have h_n_eq : gridPt2D 1 n = ((2 / (Real.pi * σ_r) : ℝ) •
          (ζ₀ (V_j, X_J - C_r • V_j) - ζ₀ (V_j, p_B))) := by
        have h_inv : (2 / (Real.pi * σ_r) : ℝ) * (Real.pi * σ_r / 2) = 1 := by
          field_simp [hpi_pos.ne', hσ_r_ne]
        calc gridPt2D 1 n
            = ((2 / (Real.pi * σ_r) : ℝ) * (Real.pi * σ_r / 2)) • gridPt2D 1 n := by
              rw [h_inv, one_smul]
          _ = ((2 / (Real.pi * σ_r) : ℝ)) • ((Real.pi * σ_r / 2 : ℝ) • gridPt2D 1 n) :=
              mul_smul _ _ _
          _ = ((2 / (Real.pi * σ_r) : ℝ) •
              (ζ₀ (V_j, X_J - C_r • V_j) - ζ₀ (V_j, p_B))) := by rw [h_sub_mode]
      have h_diff_eq : gridPt2D 1 n - ν_j = ((2 / (Real.pi * σ_r) : ℝ) •
          (ζ₀ (V_j, p_A) - ζ₀ (V_j, p_B))) := by
        rw [h_n_eq]
        dsimp only [ν_j, p_A]
        rw [← smul_sub]
        congr 1
        abel
      have hζ_diff_p : Differentiable ℝ (fun p' => ζ₀ (V_j, p')) :=
        ((hζ_cd 1).comp (contDiff_const.prodMk contDiff_id)).differentiable (by simp)
      have h_lip_ub : ‖ζ₀ (V_j, p_A) - ζ₀ (V_j, p_B)‖ ≤ A * ‖u‖ :=
        convex_univ.norm_image_sub_le_of_norm_fderiv_le
          (fun p _ => hζ_diff_p p) (fun p _ => hζ_lip V_j p)
          (Set.mem_univ p_B) (Set.mem_univ p_A)
      have h2pi_le1 : 2 / Real.pi ≤ 1 := by
        rw [div_le_one hpi_pos]
        linarith [Real.two_le_pi]
      have hd_nn : 0 ≤ d_jn := by dsimp only [d_jn]; positivity
      calc ‖gridPt2D 1 n - ν_j‖
          = (2 / (Real.pi * σ_r)) * ‖ζ₀ (V_j, p_A) - ζ₀ (V_j, p_B)‖ := by
            rw [h_diff_eq, norm_smul, Real.norm_of_nonneg hc_pos.le]
        _ ≤ (2 / (Real.pi * σ_r)) * (A * (σ_r * d_jn)) := by
            rw [← hu_norm]
            exact mul_le_mul_of_nonneg_left h_lip_ub hc_pos.le
        _ = (2 / Real.pi) * (A * d_jn) := by field_simp [hpi_pos.ne', hσ_r_ne]
        _ ≤ 1 * (A * d_jn) :=
            mul_le_mul_of_nonneg_right h2pi_le1 (mul_nonneg hA_pos.le hd_nn)
        _ = A * d_jn := one_mul _
    · intro hd_pos
      have hu_pos : 0 < ‖u‖ := by rw [hu_norm]; exact mul_pos hσ_r_pos hd_pos
      let dual_u := InnerProductSpace.toDual ℝ (EuclideanSpace ℝ (Fin 2)) u
      let φ : ℝ → ℝ := fun τ => (a₀ * ‖u‖ ^ 2) * τ - inner ℝ (ζ₀ (V_j, p_B + τ • u)) u
      have hφ_deriv : ∀ τ : ℝ, HasDerivAt φ
          (a₀ * ‖u‖ ^ 2 - inner ℝ (fderiv ℝ (fun p' => ζ₀ (V_j, p')) (p_B + τ • u) u) u) τ := by
        intro τ
        have h1 : HasDerivAt (fun τ' : ℝ => (a₀ * ‖u‖ ^ 2) * τ') (a₀ * ‖u‖ ^ 2) τ := by
          simpa using (hasDerivAt_id τ).const_mul (a₀ * ‖u‖ ^ 2)
        have hp_d : HasDerivAt (fun τ' : ℝ => p_B + τ' • u) u τ := by
          have hsm : HasDerivAt (fun τ' : ℝ => τ' • u) ((1 : ℝ) • u) τ :=
            (hasDerivAt_id τ).smul_const u
          rw [one_smul] at hsm
          exact hsm.const_add p_B
        have hζ_diff : DifferentiableAt ℝ (fun p' => ζ₀ (V_j, p')) (p_B + τ • u) :=
          (((hζ_cd 1).comp (contDiff_const.prodMk contDiff_id)).differentiable
            (by simp)).differentiableAt
        have h_comp := dual_u.hasFDerivAt.comp_hasDerivAt τ
          (hζ_diff.hasFDerivAt.comp_hasDerivAt τ hp_d)
        have h_fn_eq : (⇑dual_u ∘ (fun p' => ζ₀ (V_j, p')) ∘ fun (τ' : ℝ) => p_B + τ' • u) =
            fun (τ' : ℝ) => inner ℝ (ζ₀ (V_j, p_B + τ' • u)) u := by
          ext τ'
          dsimp only [dual_u, Function.comp_apply]
          rw [InnerProductSpace.toDual_apply_apply, real_inner_comm]
        have h_val_eq : dual_u (fderiv ℝ (fun p' => ζ₀ (V_j, p')) (p_B + τ • u) u) =
            inner ℝ (fderiv ℝ (fun p' => ζ₀ (V_j, p')) (p_B + τ • u) u) u := by
          dsimp only [dual_u]
          rw [InnerProductSpace.toDual_apply_apply, real_inner_comm]
        rw [h_fn_eq, h_val_eq] at h_comp
        exact h1.sub h_comp
      have h_anti := antitone_of_deriv_nonpos (fun τ => (hφ_deriv τ).differentiableAt)
        (fun τ => by
          rw [(hφ_deriv τ).deriv]
          linarith [hζ_pos V_j (p_B + τ • u) u])
        (zero_le_one : (0 : ℝ) ≤ 1)
      dsimp only [φ] at h_anti
      have hp1 : p_B + (1 : ℝ) • u = p_A := by
        dsimp only [u]; rw [one_smul]; abel
      have hp0 : p_B + (0 : ℝ) • u = p_B := by simp
      rw [hp1, hp0, mul_one, mul_zero, zero_sub] at h_anti
      have h_inner_ge : a₀ * ‖u‖ ^ 2 ≤ inner ℝ (ζ₀ (V_j, p_A) - ζ₀ (V_j, p_B)) u := by
        rw [inner_sub_left]; linarith
      have h_cs : inner ℝ (ζ₀ (V_j, p_A) - ζ₀ (V_j, p_B)) u ≤
          ‖ζ₀ (V_j, p_A) - ζ₀ (V_j, p_B)‖ * ‖u‖ :=
        real_inner_le_norm _ _
      have h_diff_ge : a₀ * σ_r * d_jn ≤ ‖ζ₀ (V_j, p_A) - ζ₀ (V_j, p_B)‖ := by
        have h1 : (a₀ * ‖u‖) * ‖u‖ ≤ ‖ζ₀ (V_j, p_A) - ζ₀ (V_j, p_B)‖ * ‖u‖ := by
          calc (a₀ * ‖u‖) * ‖u‖ = a₀ * ‖u‖ ^ 2 := by ring
            _ ≤ ‖ζ₀ (V_j, p_A) - ζ₀ (V_j, p_B)‖ * ‖u‖ := le_trans h_inner_ge h_cs
        have h2 : a₀ * ‖u‖ ≤ ‖ζ₀ (V_j, p_A) - ζ₀ (V_j, p_B)‖ :=
          le_of_mul_le_mul_right h1 hu_pos
        rw [hu_norm] at h2
        linarith
      let W_jn : EuclideanSpace ℝ (Fin 2) := (lam_sys * ρ_r) • (ζ₀ (V_j, p_A) - ζ₀ (V_j, p_B))
      have hW_ge : a₀ * d_jn ≤ ‖W_jn‖ := by
        dsimp only [W_jn]
        rw [norm_smul, Real.norm_of_nonneg hlam_ρ_pos.le]
        calc a₀ * d_jn = ((lam_sys * ρ_r) * σ_r) * (a₀ * d_jn) := by rw [hlam_ρ_σ, one_mul]
          _ = (lam_sys * ρ_r) * (a₀ * σ_r * d_jn) := by ring
          _ ≤ (lam_sys * ρ_r) * ‖ζ₀ (V_j, p_A) - ζ₀ (V_j, p_B)‖ :=
              mul_le_mul_of_nonneg_left h_diff_ge hlam_ρ_pos.le
      have hW_pos : 0 < ‖W_jn‖ := lt_of_lt_of_le (mul_pos ha₀ hd_pos) hW_ge
      have hW_ne : ‖W_jn‖ ≠ 0 := hW_pos.ne'
      let w : EuclideanSpace ℝ (Fin 2) := ‖W_jn‖⁻¹ • W_jn
      have hw_norm : ‖w‖ = 1 := by
        dsimp only [w]
        rw [norm_smul, Real.norm_of_nonneg (inv_nonneg.mpr hW_pos.le), inv_mul_cancel₀ hW_ne]
      have hw_perp : ‖perp2D w‖ = 1 := by
        have hw_sq : (w 0) ^ 2 + (w 1) ^ 2 = 1 := by
          have h1 : ‖w‖ ^ 2 = 1 := by rw [hw_norm]; norm_num
          rw [PiLp.norm_sq_eq_of_L2, Fin.sum_univ_two] at h1
          simpa [Real.norm_eq_abs, sq_abs] using h1
        have hp_sq : ‖perp2D w‖ ^ 2 = 1 := by
          rw [PiLp.norm_sq_eq_of_L2, Fin.sum_univ_two]
          simp only [perp2D, Real.norm_eq_abs, sq_abs]
          dsimp
          linarith
        nlinarith [norm_nonneg (perp2D w)]
      have hW_inner : inner ℝ W_jn w = ‖W_jn‖ := by
        dsimp only [w]
        rw [inner_smul_right, real_inner_self_eq_norm_sq]
        field_simp [hW_ne]
      have hW_expand : inner ℝ W_jn w =
          (lam_sys * ρ_r) *
            inner ℝ (ζ₀ (V_j, X_o - C_t • V_j) - ζ₀ (V_j, X_J - C_r • V_j)) w +
          (Real.pi / 2) * inner ℝ (gridPt2D 1 n) w := by
        have h_sub_mode : ζ₀ (V_j, p_A) - ζ₀ (V_j, p_B) =
            (ζ₀ (V_j, X_o - C_t • V_j) - ζ₀ (V_j, X_J - C_r • V_j)) +
              ((Real.pi * σ_r / 2 : ℝ) • gridPt2D 1 n) := by
          dsimp only [p_A, p_B]
          rw [h_mode]
          abel
        dsimp only [W_jn]
        rw [h_sub_mode, smul_add, inner_add_left, real_inner_smul_left,
          smul_smul, real_inner_smul_left]
        have h_pi : (lam_sys * ρ_r) * (Real.pi * σ_r / 2) = Real.pi / 2 := by
          calc (lam_sys * ρ_r) * (Real.pi * σ_r / 2)
              = ((lam_sys * ρ_r) * σ_r) * (Real.pi / 2) := by ring
            _ = Real.pi / 2 := by rw [hlam_ρ_σ, one_mul]
        rw [h_pi]
      refine ⟨w, hw_norm, hw_perp, ?_⟩
      rw [← hW_expand, hW_inner]
      exact hW_ge

  
  have h_lat_tail :
      ∀ (M : ℕ), 2 ≤ M →
      ∀ (ρ_r ρ_t σ_r R₀ E_f : ℝ),
        0 < ρ_r → 0 < ρ_t → ρ_r ≤ Real.sqrt B_sys * ρ_t →
        0 < σ_r → 2 ≤ R₀ → 0 ≤ E_f →
      ∀ (V_o : EuclideanSpace ℝ (Fin 2))
        (Y_j ν_j : (ℤ × ℤ) → EuclideanSpace ℝ (Fin 2))
        (X_ex : (ℤ × ℤ) → (ℤ × ℤ) → EuclideanSpace ℝ (Fin 2))
        (pair_jn : (ℤ × ℤ) → (ℤ × ℤ) → ℂ),
        (∀ j n : ℤ × ℤ,
          R_win * ρ_t + 2 * ρ_r ≤ ‖gridPt2D ρ_r j - V_o‖ → pair_jn j n = 0) →
        (∀ j n : ℤ × ℤ,
          let d_jn := σ_r⁻¹ * ‖Y_j j - X_ex j n‖
          ‖gridPt2D 1 n - ν_j j‖ ≤ A * d_jn ∧
          ‖pair_jn j n‖ ≤ K_pair M * (ρ_r / ρ_t) / (1 + d_jn) ^ M) →
        ((∀ (J_vel : Finset (ℤ × ℤ)) (N_ret : (ℤ × ℤ) → Finset (ℤ × ℤ))
            (c_jn : (ℤ × ℤ) → (ℤ × ℤ) → ℂ),
            (∀ j ∈ J_vel, Summable (fun n : ℤ × ℤ => ‖c_jn j n‖ ^ 2)) →
            (∑ j ∈ J_vel, ∑' n : ℤ × ℤ, ‖c_jn j n‖ ^ 2 ≤ E_f) →
            (∀ j ∈ J_vel, ∀ n : ℤ × ℤ, n ∉ N_ret j →
              R_win * ρ_t + 2 * ρ_r ≤ ‖gridPt2D ρ_r j - V_o‖ ∨
              R₀ * σ_r ≤ ‖Y_j j - X_ex j n‖) →
            ‖∑ j ∈ J_vel, ∑' n : ℤ × ℤ,
              if n ∈ N_ret j then (0 : ℂ) else c_jn j n * pair_jn j n‖ ≤
              C_tr M * R₀ ^ (1 - (M : ℝ)) * Real.sqrt E_f) ∧
         (∀ (S_far : Finset ((ℤ × ℤ) × (ℤ × ℤ))) (c_q : ((ℤ × ℤ) × (ℤ × ℤ)) → ℂ),
            (∑ q ∈ S_far, ‖c_q q‖ ^ 2 ≤ E_f) →
            (∀ q ∈ S_far,
              R_win * ρ_t + 2 * ρ_r ≤ ‖gridPt2D ρ_r q.1 - V_o‖ ∨
              R₀ * σ_r ≤ ‖Y_j q.1 - X_ex q.1 q.2‖) →
            ‖∑ q ∈ S_far, c_q q * pair_jn q.1 q.2‖ ≤
              C_tr M * R₀ ^ (1 - (M : ℝ)) * Real.sqrt E_f)) := by
    intro M hM ρ_r ρ_t σ_r R₀ E_f hρ_r_pos hρ_t_pos hρ_le_Bρt hσ_r_pos hR₀ hE_f
      V_o Y_j ν_j X_ex pair_jn h_vel_zero h_pair_bound
    have hR₀_ge1 : 1 ≤ R₀ := by linarith
    have hR₀_pos : 0 < R₀ := by linarith
    have hR₀_rpow : (R₀ ^ (M - 1))⁻¹ = R₀ ^ (1 - (M : ℝ)) := by
      have h_exp : 1 - (M : ℝ) = -(((M - 1 : ℕ) : ℝ)) := by
        rw [Nat.cast_sub (by omega : 1 ≤ M)]
        ring
      rw [h_exp, Real.rpow_neg hR₀_pos.le, Real.rpow_natCast]
    
    have h_lat_sum : ∀ (ν : EuclideanSpace ℝ (Fin 2)) (S : Finset (ℤ × ℤ)),
        ∑ n ∈ S, ((R₀ + ‖gridPt2D 1 n - ν‖) ^ (2 * M))⁻¹ ≤
          (4 * R₀ ^ (1 - (M : ℝ))) ^ 2 := by
      intro ν S
      have h_ray : ∀ K : ℕ,
          ∑ j ∈ Finset.range K, ((R₀ + (j : ℝ)) ^ M)⁻¹ ≤ 2 * (R₀ ^ (M - 1))⁻¹ := by
        intro K
        cases K with
        | zero =>
          simp only [Finset.range_zero, Finset.sum_empty]
          positivity
        | succ m =>
          rw [Finset.sum_range_succ']
          have h0 : ((R₀ + ((0 : ℕ) : ℝ)) ^ M)⁻¹ ≤ (R₀ ^ (M - 1))⁻¹ := by
            simp only [Nat.cast_zero, add_zero]
            have hM1_eq : (M - 1) + 1 = M := by omega
            have hRM : R₀ ^ (M - 1) ≤ R₀ ^ M := by
              rw [← hM1_eq, pow_succ]
              exact le_mul_of_one_le_right (pow_nonneg hR₀_pos.le _) hR₀_ge1
            exact inv_anti₀ (pow_pos hR₀_pos (M - 1)) hRM
          have h_step : ∀ i : ℕ,
              ((R₀ + ((i + 1 : ℕ) : ℝ)) ^ M)⁻¹ ≤
                (R₀ ^ (M - 2))⁻¹ * ((R₀ + (i : ℝ))⁻¹ - (R₀ + ((i + 1 : ℕ) : ℝ))⁻¹) := by
            intro i
            set u : ℝ := R₀ + (i : ℝ)
            have hu_ge : R₀ ≤ u := by
              dsimp [u]; linarith [Nat.cast_nonneg (α := ℝ) i]
            have hu_pos : 0 < u := lt_of_lt_of_le hR₀_pos hu_ge
            have hu1_eq : R₀ + ((i + 1 : ℕ) : ℝ) = u + 1 := by
              dsimp [u]; push_cast; ring
            rw [hu1_eq]
            have hu1_pos : 0 < u + 1 := by linarith
            have hM2 : (M - 2) + 2 = M := by omega
            have h_denom : R₀ ^ (M - 2) * (u * (u + 1)) ≤ (u + 1) ^ M := by
              rw [← hM2, pow_add]
              refine mul_le_mul ?_ ?_ (mul_nonneg hu_pos.le hu1_pos.le)
                (pow_nonneg hu1_pos.le _)
              · exact pow_le_pow_left₀ hR₀_pos.le (by linarith) (M - 2)
              · nlinarith
            have h_inv := inv_anti₀
              (mul_pos (pow_pos hR₀_pos (M - 2)) (mul_pos hu_pos hu1_pos)) h_denom
            refine le_trans h_inv (le_of_eq ?_)
            have hRpow_ne : R₀ ^ (M - 2) ≠ 0 := (pow_pos hR₀_pos (M - 2)).ne'
            field_simp [hRpow_ne, hu_pos.ne', hu1_pos.ne']
            ring
          have h_sum_step : ∑ i ∈ Finset.range m, ((R₀ + ((i + 1 : ℕ) : ℝ)) ^ M)⁻¹ ≤
              (R₀ ^ (M - 1))⁻¹ := by
            calc ∑ i ∈ Finset.range m, ((R₀ + ((i + 1 : ℕ) : ℝ)) ^ M)⁻¹
                ≤ ∑ i ∈ Finset.range m,
                    (R₀ ^ (M - 2))⁻¹ * ((R₀ + (i : ℝ))⁻¹ - (R₀ + ((i + 1 : ℕ) : ℝ))⁻¹) :=
                  Finset.sum_le_sum (fun i _ => h_step i)
              _ = (R₀ ^ (M - 2))⁻¹ *
                    ∑ i ∈ Finset.range m, ((R₀ + (i : ℝ))⁻¹ - (R₀ + ((i + 1 : ℕ) : ℝ))⁻¹) :=
                  (Finset.mul_sum _ _ _).symm
              _ = (R₀ ^ (M - 2))⁻¹ * ((R₀ + ((0 : ℕ) : ℝ))⁻¹ - (R₀ + (m : ℝ))⁻¹) := by
                  rw [Finset.sum_range_sub' (fun i : ℕ => (R₀ + (i : ℝ))⁻¹) m]
              _ ≤ (R₀ ^ (M - 2))⁻¹ * R₀⁻¹ := by
                  refine mul_le_mul_of_nonneg_left ?_ (inv_nonneg.mpr (pow_nonneg hR₀_pos.le _))
                  have hm_nn : 0 ≤ (R₀ + (m : ℝ))⁻¹ := by
                    have : 0 < R₀ + (m : ℝ) := add_pos_of_pos_of_nonneg hR₀_pos (Nat.cast_nonneg m)
                    positivity
                  simp only [Nat.cast_zero, add_zero]
                  linarith
              _ = (R₀ ^ (M - 1))⁻¹ := by
                  have hM1 : (M - 2) + 1 = M - 1 := by omega
                  rw [← hM1, pow_succ, mul_inv]
          calc (∑ k ∈ Finset.range m, ((R₀ + ((k + 1 : ℕ) : ℝ)) ^ M)⁻¹) +
                  ((R₀ + ((0 : ℕ) : ℝ)) ^ M)⁻¹
              ≤ (R₀ ^ (M - 1))⁻¹ + (R₀ ^ (M - 1))⁻¹ := add_le_add h_sum_step h0
            _ = 2 * (R₀ ^ (M - 1))⁻¹ := by ring
      have h_1d : ∀ (μ : ℝ) (K : ℕ),
          let k₀ : ℤ := ⌊μ⌋
          ∑ m ∈ Finset.Icc (k₀ - (K : ℤ)) (k₀ + 1 + (K : ℤ)),
            ((R₀ + |(m : ℝ) - μ|) ^ M)⁻¹ ≤ 4 * (R₀ ^ (M - 1))⁻¹ := by
        intro μ K
        dsimp only
        set k₀ : ℤ := ⌊μ⌋
        let I_set : Finset ℤ := Finset.Icc (k₀ - (K : ℤ)) (k₀ + 1 + (K : ℤ))
        let L_s : Finset ℤ := (Finset.range (K + 1)).image (fun j : ℕ => k₀ - (j : ℤ))
        let U_s : Finset ℤ := (Finset.range (K + 1)).image (fun j : ℕ => k₀ + 1 + (j : ℤ))
        have h_sub : I_set ⊆ L_s ∪ U_s := by
          intro z hz
          rw [Finset.mem_Icc] at hz
          rw [Finset.mem_union]
          by_cases hzk : z ≤ k₀
