        B_cell⁻¹ ≤ lam_loc * s ^ 2 → lam_loc * s ^ 2 ≤ B_cell →
        c_end ∈ Set.Icc (0 : ℝ) 1 →
      ∀ (x₀ n_P v v' : EuclideanSpace ℝ (Fin 2)), ‖n_P‖ = 1 →
        |inner ℝ (v - v') n_P| ≤ (B_cell + 8) * s →
        (a₁ * (B_cell + 8) / a₀) * s ≤ |inner ℝ (v - v') (perp2D n_P)| →
        let τ_P := perp2D n_P
        let Θ : ℝ → ℝ := fun y =>
          lam_loc * (Φ₀ (c_end, x₀ + (s * y) • τ_P, v) - Φ₀ (c_end, x₀ + (s * y) • τ_P, v'))
        let L : ℝ := (a₀ / (2 * B_cell)) * (|inner ℝ (v - v') τ_P| / s)
        let D_phase : ℕ → ℝ := fun m => (4 * B_cell ^ 2 / a₀) * A ^ (m + 1) * ((m.factorial : ℝ) ^ 3)
