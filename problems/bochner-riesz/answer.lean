        fun b₀ b₁ b₂ => if (b₀, b₁, b₂) ∈ prof.E_seq n then P3 b₀ b₁ b₂ / m_E else 0
      have hR₃_nn : ∀ b₀ b₁ b₂, 0 ≤ R₃ b₀ b₁ b₂ := by
        intro b₀ b₁ b₂
