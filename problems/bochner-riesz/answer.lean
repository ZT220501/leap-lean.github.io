      let k_va2 := dyadicRealBin ε v (inner ℝ V₂ (perp2D e_c))
      let k_aa2 := dyadicRealBin ε v (inner ℝ A₂ (perp2D e_c))
      (((Finset.Icc (-3 : ℤ) 2 ×ˢ Finset.Icc (k_va2 - 5) (k_va2 + 5)) ×ˢ
        (Finset.Icc (-3 : ℤ) 2 ×ˢ Finset.Icc (k_aa2 - 5) (k_aa2 + 5)))).image
