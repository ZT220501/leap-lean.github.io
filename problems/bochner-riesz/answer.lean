      have h_rat_nn : 0 ≤ ρ_r / ρ_t := div_nonneg hρ_r_pos.le hρ_t_pos.le
      have h_rat_le1 : ρ_r / ρ_t ≤ 1 := div_le_one_of_le₀ hρ_le_t hρ_t_pos.le
      change ‖(ρ_t⁻¹ : ℂ) * ∫ v, g_at v * ψ_o (ρ_t⁻¹ • (v - V_o)) *
        Complex.exp (Complex.I * ((lam_sys * Φ₀ (C_t, X_o, v) : ℝ) : ℂ))‖ ^ 2 ≤ (8 * M_sl) ^ 2
      rw [h_int_eq, norm_mul, Complex.norm_real, Real.norm_of_nonneg h_rat_nn]
      have h_prod_le : (ρ_r / ρ_t) * ‖∫ z : EuclideanSpace ℝ (Fin 2), G_z z‖ ≤ 8 * M_sl := by
        calc (ρ_r / ρ_t) * ‖∫ z : EuclideanSpace ℝ (Fin 2), G_z z‖
