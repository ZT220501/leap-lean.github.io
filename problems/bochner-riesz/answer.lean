  let Q : ℕ := M * N_blk
  have hQ_ge1 : 1 ≤ Q := Nat.mul_pos (by omega) (by dsimp [N_blk]; omega)
  have hM_ge1 : 1 ≤ M := by omega
  have hM_pos : (0 : ℝ) < (M : ℝ) := by exact_mod_cast (by omega : 0 < M)
