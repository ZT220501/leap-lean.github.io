      let d₁ := stdRootObs ε e V_p A_p θ₁
      let d₂ := stdRootObs ε e V_p A_p θ₂
      let c := replicaCommonCell ε e (replicaSepTag ε e d₁.1 d₂.1) d₁
      c ∈ Fib₁ d₁ ∧ c ∈ Fib₂ d₂ := by
    intro V_p A_p θ₁ θ₂ hV_le hA_le hθ₁ hθ₂
