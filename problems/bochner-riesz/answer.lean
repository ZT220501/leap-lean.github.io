  let m_q : ℝ := ‖(ρ₀⁻¹ : ℂ) * ∫ v : E,
    f v * ψ_q (ρ₀⁻¹ • (v - V_j)) *
      Complex.exp (Complex.I * ((lam_sys * Φ₀ (1 / 2, X_q, v) : ℝ) : ℂ))‖ ^ 2
  have hm_q_le : m_q ≤ canonicalRootMass lam_sys Φ₀ f (j, k_X) := by
    unfold canonicalRootMass
    exact le_csSup hW_bdd ⟨ψ_q, hψ_can, rfl⟩

  
  have h_integrand_eq : ∀ v : E,
      f v * (pktPou2D (ρ₀⁻¹ • (v - V_j)) : ℂ) *
        Complex.exp (Complex.I *
          ((lam_sys * Φ₀ (1 / 2, 0, v) -
