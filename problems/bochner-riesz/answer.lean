              ∑ a ∈ A, ∑ b ∈ B, G a b := by
            rw [← Finset.sum_add_distrib]
            exact Finset.sum_congr rfl (fun a _ => Finset.sum_erase_add B (fun b => G a b) hb₀)
          have h_sμ := Finset.sum_erase_add B μ_B hb₀
          refine ih (A.card + B'.card) h_card A B' rfl ?_
          dsimp [Inv, B'] at hInv ⊢
          linarith
        · push_neg at hA_bad hB_bad
          refine ⟨A, B, ?_, hA_bad, hB_bad⟩
          have hμA_ge0 : 0 ≤ ∑ a ∈ A, μ_A a := Finset.sum_nonneg (fun a _ => hμA_nn a)
          have hμB_ge0 : 0 ≤ ∑ b ∈ B, μ_B b := Finset.sum_nonneg (fun b _ => hμB_nn b)
          dsimp [Inv] at hInv
          linarith
    refine h_ind (Finset.univ.card + Finset.univ.card) Finset.univ Finset.univ rfl ?_
    dsimp [Inv]
    rw [hG_sum, hμA_sum, hμB_sum]
    norm_num

  
  have h_parent_core : ∀ (n : ℕ) (s_dir j β : ℝ),
      (s_dir = 1 ∨ s_dir = -1) →
      0 < j → j < 1 →
      0 < β → β ≤ 1 →
      4 * (blk.ρ_seq (prof.φ n)) ^ (s * β - 2 * blk.κ_seq (prof.φ n) - prof.ω_seq n) < 1 →
      let l := prof.φ n
      let ρ := blk.ρ_seq l
      let N_Θ := blk.N_Θ l
      let lam : Fin N_Θ → ℝ := fun b => ∑ i, blk.π_seq l i b
      let Pi_sym : Fin N_Θ → Fin N_Θ → ℝ :=
        fun a b => ∑ i, ∑ b₂, threeReplicaStar blk l i a b b₂
      let H_dir : Fin N_Θ → Fin N_Θ → Prop :=
        fun a b => ∃ b₂ : Fin N_Θ,
          (if s_dir = 1 then (a, b, b₂) else (b, a, b₂)) ∈ prof.E_seq n
      ∃ (a_par : Fin N_Θ) (q : Fin N_Θ → Fin N_Θ → ℝ),
        let p_par := paramTreeBin ρ j (blk.θ_seq l a_par)
        let a_mid := paramTreeMid ρ j (blk.θ_seq l a_par)
        let m_par := ∑ a : Fin N_Θ,
          if paramTreeBin ρ j (blk.θ_seq l a) = p_par then lam a else 0
        let q_A : Fin N_Θ → ℝ := fun a => ∑ b, q a b
        let q_B : Fin N_Θ → ℝ := fun b => ∑ a, q a b
        0 < m_par ∧
        (∀ a, paramTreeBin ρ j (blk.θ_seq l a) = p_par →
          ‖ρ ^ (-j) • (paramVec blk l a - a_mid)‖ ≤ 2) ∧
        (∀ b, ‖paramVec blk l b - a_mid‖ ≤ 16) ∧
        (∀ a b, 0 ≤ q a b) ∧
        (∑ a, ∑ b, q a b = 1) ∧
        (∀ a b, 0 < q a b →
          H_dir a b ∧
          paramTreeBin ρ j (blk.θ_seq l a) = p_par ∧
          ρ ^ β ≤ ‖paramVec blk l b - a_mid‖) ∧
        (∀ a b, q a b ≤ 128 * ρ ^ (-blk.κ_seq l - prof.ω_seq n) * q_A a * q_B b) ∧
        (∀ a, q_A a ≤ 16 * ρ ^ (-blk.κ_seq l - prof.ω_seq n) *
          (if paramTreeBin ρ j (blk.θ_seq l a) = p_par then lam a / m_par else 0)) ∧
        (∀ b, q_B b ≤ 16 * ρ ^ (-blk.κ_seq l - prof.ω_seq n) * lam b) ∧
        (∀ b, q_B b ≤ 16 * ρ ^ (-prof.ω_seq n) * m_par⁻¹ *
          ∑ a : Fin N_Θ,
            if paramTreeBin ρ j (blk.θ_seq l a) = p_par ∧ H_dir a b
            then Pi_sym a b else 0) := by
    intro n s_dir j β hs_dir hj₀ hj₁ hβ₀ hβ₁ h_sep_small
    dsimp only
    let l := prof.φ n
    let ρ := blk.ρ_seq l
    let κ := blk.κ_seq l
    let ω := prof.ω_seq n
    let N_Θ := blk.N_Θ l
    have hρ_b := blk.hρ_bounds l
    have hρ0 : 0 < ρ := hρ_b.1
    have hρ1 : ρ < 1 / 2 := hρ_b.2
    have hρ_lt1 : ρ < 1 := by linarith
    let lam : Fin N_Θ → ℝ := fun b => ∑ i, blk.π_seq l i b
    have hlam_nn : ∀ b, 0 ≤ lam b := fun b => Finset.sum_nonneg (fun i _ => blk.hπ_nn l i b)
    have hlam_sum : ∑ b, lam b = 1 := by
      dsimp [lam]; rw [Finset.sum_comm]; exact blk.hπ_sum l
    let Pi_sym : Fin N_Θ → Fin N_Θ → ℝ :=
      fun a b => ∑ i, ∑ b₂, threeReplicaStar blk l i a b b₂
    have hPi_nn : ∀ a b, 0 ≤ Pi_sym a b := fun a b =>
      Finset.sum_nonneg (fun i _ => Finset.sum_nonneg (fun b₂ _ => h_star_nn l i a b b₂))
    let H_dir : Fin N_Θ → Fin N_Θ → Prop :=
      fun a b => ∃ b₂ : Fin N_Θ,
        (if s_dir = 1 then (a, b, b₂) else (b, a, b₂)) ∈ prof.E_seq n
    let P3 : Fin N_Θ → Fin N_Θ → Fin N_Θ → ℝ :=
      fun b₀ b₁ b₂ => ∑ i, threeReplicaStar blk l i b₀ b₁ b₂
    have hP3_nn : ∀ b₀ b₁ b₂, 0 ≤ P3 b₀ b₁ b₂ :=
      fun b₀ b₁ b₂ => Finset.sum_nonneg (fun i _ => h_star_nn l i b₀ b₁ b₂)
    have hP3_sym : ∀ a b b₂, P3 a b b₂ = P3 b a b₂ := by
      intro a b b₂; dsimp [P3]
      exact Finset.sum_congr rfl (fun i _ => h_star_sym l i a b b₂)
    let m_E : ℝ := ∑ t ∈ prof.E_seq n, P3 t.1 t.2.1 t.2.2
    have hm_E_lb : ρ ^ ω ≤ m_E := by
      have hm := prof.hE_mass n
      refine le_trans hm (le_of_eq ?_)
      dsimp [m_E, P3, l]
      rw [Finset.sum_comm, ← Finset.filter_univ_mem (prof.E_seq n), Finset.sum_filter]
      refine Finset.sum_congr rfl (fun t _ => ?_)
      by_cases ht : t ∈ prof.E_seq n <;> simp [ht]
    have hm_E_pos : 0 < m_E := lt_of_lt_of_le (Real.rpow_pos_of_pos hρ0 ω) hm_E_lb
    have hm_E_inv_le : m_E⁻¹ ≤ ρ ^ (-ω) := by
      rw [Real.rpow_neg hρ0.le]
      exact inv_anti₀ (Real.rpow_pos_of_pos hρ0 ω) hm_E_lb
    let R : Fin N_Θ → Fin N_Θ → ℝ := fun a b =>
      m_E⁻¹ * ∑ b₂ : Fin N_Θ,
        if (if s_dir = 1 then (a, b, b₂) else (b, a, b₂)) ∈ prof.E_seq n
        then P3 a b b₂ else 0
    have hR_nn : ∀ a b, 0 ≤ R a b := by
      intro a b; dsimp [R]
      refine mul_nonneg (inv_nonneg.mpr hm_E_pos.le) (Finset.sum_nonneg (fun b₂ _ => ?_))
      by_cases ht : (if s_dir = 1 then (a, b, b₂) else (b, a, b₂)) ∈ prof.E_seq n
      · rw [if_pos ht]; exact hP3_nn a b b₂
      · rw [if_neg ht]
    have hR_sum : (∑ a, ∑ b, R a b) = 1 := by
      have h_num : (∑ a, ∑ b, ∑ b₂ : Fin N_Θ,
          if (if s_dir = 1 then (a, b, b₂) else (b, a, b₂)) ∈ prof.E_seq n
          then P3 a b b₂ else 0) = m_E := by
        have h_std : (∑ b₀, ∑ b₁, ∑ b₂ : Fin N_Θ,
            if (b₀, b₁, b₂) ∈ prof.E_seq n then P3 b₀ b₁ b₂ else 0) = m_E := by
          have h_prod : (∑ t : Fin N_Θ × Fin N_Θ × Fin N_Θ,
              if t ∈ prof.E_seq n then P3 t.1 t.2.1 t.2.2 else 0) =
              ∑ b₀, ∑ b₁, ∑ b₂ : Fin N_Θ,
                if (b₀, b₁, b₂) ∈ prof.E_seq n then P3 b₀ b₁ b₂ else 0 := by
            rw [Fintype.sum_prod_type]
            exact Finset.sum_congr rfl (fun _ _ => Fintype.sum_prod_type _)
          rw [← h_prod, ← Finset.sum_filter, Finset.filter_univ_mem]
        rcases hs_dir with rfl | rfl
        · simpa using h_std
        · have h_neq : (-1 : ℝ) ≠ 1 := by norm_num
          simp_rw [if_neg h_neq]
          rw [Finset.sum_comm]
          refine (le_antisymm ?_ ?_) <;> {
            rw [← h_std]
            refine le_of_eq (Finset.sum_congr rfl (fun b₀ _ => Finset.sum_congr rfl (fun b₁ _ =>
              Finset.sum_congr rfl (fun b₂ _ => ?_))))
            rw [hP3_sym] }
      dsimp [R]
      simp_rw [← Finset.mul_sum]
      rw [h_num, inv_mul_cancel₀ hm_E_pos.ne']
    have hR_supp : ∀ a b, 0 < R a b → H_dir a b := by
      intro a b hR_pos
      by_contra h_no
      have h0 : R a b = 0 := by
        dsimp [R]
        rw [Finset.sum_eq_zero (fun b₂ _ => if_neg (fun hm => h_no ⟨b₂, hm⟩)), mul_zero]
      linarith
    have hR_dom_Pi : ∀ a b,
        R a b ≤ ρ ^ (-ω) * (if H_dir a b then Pi_sym a b else 0) := by
      intro a b
      by_cases hH : H_dir a b
      · rw [if_pos hH]
        have h_le_Pi : (∑ b₂ : Fin N_Θ,
            if (if s_dir = 1 then (a, b, b₂) else (b, a, b₂)) ∈ prof.E_seq n
            then P3 a b b₂ else 0) ≤ Pi_sym a b := by
          calc (∑ b₂ : Fin N_Θ,
                if (if s_dir = 1 then (a, b, b₂) else (b, a, b₂)) ∈ prof.E_seq n
                then P3 a b b₂ else 0)
              ≤ ∑ b₂ : Fin N_Θ, P3 a b b₂ := by
                refine Finset.sum_le_sum (fun b₂ _ => ?_)
                by_cases ht : (if s_dir = 1 then (a, b, b₂) else (b, a, b₂)) ∈ prof.E_seq n
                · rw [if_pos ht]
                · rw [if_neg ht]; exact hP3_nn a b b₂
            _ = Pi_sym a b := by dsimp [P3, Pi_sym]; exact Finset.sum_comm
        dsimp [R]
        exact mul_le_mul hm_E_inv_le h_le_Pi
          (Finset.sum_nonneg (fun b₂ _ => by
            by_cases ht : (if s_dir = 1 then (a, b, b₂) else (b, a, b₂)) ∈ prof.E_seq n
            · rw [if_pos ht]; exact hP3_nn a b b₂
            · rw [if_neg ht]))
          (by positivity)
      · rw [if_neg hH, mul_zero]
        by_contra h_gt
        exact hH (hR_supp a b (lt_of_not_ge h_gt))
    have hR_dom_lam : ∀ a b, R a b ≤ ρ ^ (-κ - ω) * lam a * lam b := by
      intro a b
      calc R a b ≤ ρ ^ (-ω) * (if H_dir a b then Pi_sym a b else 0) := hR_dom_Pi a b
        _ ≤ ρ ^ (-ω) * Pi_sym a b := by
            refine mul_le_mul_of_nonneg_left ?_ (by positivity)
            split_ifs; exact le_rfl; exact hPi_nn a b
        _ ≤ ρ ^ (-ω) * (ρ ^ (-κ) * lam a * lam b) :=
            mul_le_mul_of_nonneg_left (h_star_dom2 l a b) (by positivity)
        _ = (ρ ^ (-κ) * ρ ^ (-ω)) * lam a * lam b := by ring
        _ = ρ ^ (-κ - ω) * lam a * lam b := by
            rw [← Real.rpow_add hρ0]; ring_nf
    have h_mid_eq : ∀ a₁ a₂ : Fin N_Θ,
        paramTreeBin ρ j (blk.θ_seq l a₁) = paramTreeBin ρ j (blk.θ_seq l a₂) →
        paramTreeMid ρ j (blk.θ_seq l a₁) = paramTreeMid ρ j (blk.θ_seq l a₂) := by
      intro a₁ a₂ h_eq
      unfold paramTreeBin at h_eq
      obtain ⟨h1, h2⟩ := Prod.ext_iff.mp h_eq
      dsimp only at h1 h2
      unfold paramTreeMid dyadicRealMid
      rw [h1, h2]
    let Sep : Fin N_Θ → Fin N_Θ → Prop :=
      fun a b => ρ ^ β ≤ ‖paramVec blk l b - paramTreeMid ρ j (blk.θ_seq l a)‖
    have h_unsep_lt :
        (∑ a, ∑ b, if ¬ Sep a b then R a b else 0) < 1 / 4 := by
      have hρ_le_β : ρ ≤ ρ ^ β := by
        calc ρ = ρ ^ (1 : ℝ) := (Real.rpow_one ρ).symm
          _ ≤ ρ ^ β := Real.rpow_le_rpow_of_exponent_ge hρ0 hρ_lt1.le hβ₁
      have hρβ_le1 : ρ ^ β ≤ 1 := by
        calc ρ ^ β ≤ ρ ^ (0 : ℝ) := Real.rpow_le_rpow_of_exponent_ge hρ0 hρ_lt1.le hβ₀.le
          _ = 1 := Real.rpow_zero ρ
      have h_each_a : ∀ a : Fin N_Θ,
          (∑ b, if ¬ Sep a b then R a b else 0) ≤
            (ρ ^ (-κ - ω) * lam a) * (ρ ^ (-κ) * (ρ ^ β) ^ s) := by
        intro a
        calc (∑ b, if ¬ Sep a b then R a b else 0)
            ≤ ∑ b, (ρ ^ (-κ - ω) * lam a) *
                (if ‖paramVec blk l b - paramTreeMid ρ j (blk.θ_seq l a)‖ < ρ ^ β
                 then lam b else 0) := by
              refine Finset.sum_le_sum (fun b _ => ?_)
              dsimp [Sep]
              by_cases hlt : ‖paramVec blk l b - paramTreeMid ρ j (blk.θ_seq l a)‖ < ρ ^ β
              · rw [if_pos (not_le.mpr hlt), if_pos hlt]
                linarith [hR_dom_lam a b]
              · rw [if_neg (not_not.mpr (le_of_not_gt hlt)), if_neg hlt, mul_zero]
          _ = (ρ ^ (-κ - ω) * lam a) *
                ∑ b, if ‖paramVec blk l b - paramTreeMid ρ j (blk.θ_seq l a)‖ < ρ ^ β
                     then lam b else 0 := (Finset.mul_sum _ _ _).symm
          _ ≤ (ρ ^ (-κ - ω) * lam a) * (ρ ^ (-κ) * (ρ ^ β) ^ s) := by
              refine mul_le_mul_of_nonneg_left ?_
                (mul_nonneg (Real.rpow_nonneg hρ0.le _) (hlam_nn a))
              have hb_est := blk.h_param_ball l (paramTreeMid ρ j (blk.θ_seq l a)) (ρ ^ β)
                hρ_le_β hρβ_le1
              refine le_trans (le_of_eq ?_) hb_est
              refine Finset.sum_congr rfl (fun b _ => ?_)
              dsimp [paramVec, lam, ρ]
              by_cases hb : ‖WithLp.toLp 2 ![(blk.θ_seq l b).1, (blk.θ_seq l b).2] -
                  paramTreeMid (blk.ρ_seq l) j (blk.θ_seq l a)‖ < blk.ρ_seq l ^ β <;>
                simp [hb]
      have h_tot_le : (∑ a, ∑ b, if ¬ Sep a b then R a b else 0) ≤
          ρ ^ (s * β - 2 * κ - ω) := by
        calc (∑ a, ∑ b, if ¬ Sep a b then R a b else 0)
            ≤ ∑ a, (ρ ^ (-κ - ω) * lam a) * (ρ ^ (-κ) * (ρ ^ β) ^ s) :=
              Finset.sum_le_sum (fun a _ => h_each_a a)
          _ = (ρ ^ (-κ - ω) * ρ ^ (-κ) * (ρ ^ β) ^ s) * ∑ a, lam a := by
              rw [Finset.mul_sum]; refine Finset.sum_congr rfl (fun _ _ => by ring)
          _ = ρ ^ (-κ - ω) * ρ ^ (-κ) * ρ ^ (s * β) := by
              rw [hlam_sum, mul_one, ← Real.rpow_mul hρ0.le, mul_comm β s]
          _ = ρ ^ (s * β - 2 * κ - ω) := by
              rw [← Real.rpow_add hρ0, ← Real.rpow_add hρ0]; ring_nf
      linarith
    let C_fn : Fin N_Θ → ℤ × ℤ := fun a => paramTreeBin ρ j (blk.θ_seq l a)
    let S_cells : Finset (ℤ × ℤ) := Finset.univ.image C_fn
    let m_good : (ℤ × ℤ) → ℝ := fun p =>
      ∑ a, ∑ b, if C_fn a = p ∧ Sep a b then R a b else 0
    let m_lam : (ℤ × ℤ) → ℝ := fun p =>
      ∑ a, if C_fn a = p then lam a else 0
    have h_sum_mlam : (∑ p ∈ S_cells, m_lam p) = 1 := by
      calc (∑ p ∈ S_cells, m_lam p)
          = ∑ a, ∑ p ∈ S_cells, if C_fn a = p then lam a else 0 := Finset.sum_comm
        _ = ∑ a, lam a := by
            refine Finset.sum_congr rfl (fun a _ => ?_)
            rw [Finset.sum_eq_single (C_fn a)]
            · exact if_pos rfl
            · intro p _ hne; exact if_neg hne.symm
            · intro h_abs; exact absurd (Finset.mem_image_of_mem C_fn (Finset.mem_univ a)) h_abs
        _ = 1 := hlam_sum
    have h_sum_mgood : 3 / 4 < ∑ p ∈ S_cells, m_good p := by
      have h_eq_sep : (∑ p ∈ S_cells, m_good p) = ∑ a, ∑ b, if Sep a b then R a b else 0 := by
        calc (∑ p ∈ S_cells, m_good p)
            = ∑ a, ∑ p ∈ S_cells, ∑ b, if C_fn a = p ∧ Sep a b then R a b else 0 :=
              Finset.sum_comm
          _ = ∑ a, ∑ b, ∑ p ∈ S_cells, if C_fn a = p ∧ Sep a b then R a b else 0 :=
              Finset.sum_congr rfl (fun _ _ => Finset.sum_comm)
          _ = ∑ a, ∑ b, if Sep a b then R a b else 0 := by
              refine Finset.sum_congr rfl (fun a _ => Finset.sum_congr rfl (fun b _ => ?_))
              rw [Finset.sum_eq_single (C_fn a)]
              · simp
              · intro p _ hne; exact if_neg (fun h => hne h.1.symm)
              · intro h_abs
                exact absurd (Finset.mem_image_of_mem C_fn (Finset.mem_univ a)) h_abs
      have h_split : (∑ a, ∑ b, if Sep a b then R a b else 0) +
          (∑ a, ∑ b, if ¬ Sep a b then R a b else 0) = 1 := by
        rw [← Finset.sum_add_distrib]
        calc ∑ a, ((∑ b, if Sep a b then R a b else 0) + (∑ b, if ¬ Sep a b then R a b else 0))
            = ∑ a, ∑ b, R a b := by
              refine Finset.sum_congr rfl (fun a _ => ?_)
              rw [← Finset.sum_add_distrib]
              refine Finset.sum_congr rfl (fun b _ => ?_)
              by_cases hs : Sep a b <;> simp [hs]
          _ = 1 := hR_sum
      linarith
    have h_exists_par : ∃ p ∈ S_cells, (1 / 8 : ℝ) * m_lam p < m_good p := by
      by_contra h_all
      push_neg at h_all
      have h_le : (∑ p ∈ S_cells, m_good p) ≤ ∑ p ∈ S_cells, (1 / 8 : ℝ) * m_lam p :=
        Finset.sum_le_sum h_all
      rw [← Finset.mul_sum, h_sum_mlam, mul_one] at h_le
      linarith
    obtain ⟨p_par0, hp_par_in, hp_par_gt⟩ := h_exists_par
    obtain ⟨a_par, _, ha_par_eq⟩ := Finset.mem_image.mp hp_par_in
    let p_par := C_fn a_par
    let a_mid := paramTreeMid ρ j (blk.θ_seq l a_par)
    let m_par := m_lam p_par
    have hp_eq : p_par = p_par0 := ha_par_eq
    have hm_good_gt : (1 / 8 : ℝ) * m_par < m_good p_par := by
      dsimp [m_par, p_par]; rwa [ha_par_eq]
    have hm_par_nn : 0 ≤ m_par :=
      Finset.sum_nonneg (fun a _ => by split_ifs; exact hlam_nn a; exact le_rfl)
    have hm_good_pos : 0 < m_good p_par := lt_of_le_of_lt (by positivity) hm_good_gt
    have hm_par_pos : 0 < m_par := by
      by_contra h0
      have hm0 : m_par = 0 := le_antisymm (le_of_not_gt h0) hm_par_nn
      have h_all_lam0 : ∀ a, C_fn a = p_par → lam a = 0 := by
        intro a ha
        have h_z := (Finset.sum_eq_zero_iff_of_nonneg
          (fun a' _ => by split_ifs; exact hlam_nn a'; exact le_rfl)).mp hm0 a (Finset.mem_univ a)
        rwa [if_pos ha] at h_z
      have hmg0 : m_good p_par = 0 := by
        refine Finset.sum_eq_zero (fun a _ => Finset.sum_eq_zero (fun b _ => ?_))
        by_cases hc : C_fn a = p_par ∧ Sep a b
        · rw [if_pos hc]
          have hl0 := h_all_lam0 a hc.1
          have hR_le := hR_dom_lam a b
          rw [hl0, mul_zero, zero_mul] at hR_le
          exact le_antisymm hR_le (hR_nn a b)
        · exact if_neg hc
      linarith
    have hm_good_inv_le : (m_good p_par)⁻¹ ≤ 8 * m_par⁻¹ := by
      rw [inv_eq_one_div, inv_eq_one_div, mul_one_div,
        div_le_div_iff₀ hm_good_pos hm_par_pos]
      linarith
    let G_j : Fin N_Θ → Fin N_Θ → ℝ := fun a b =>
      if C_fn a = p_par ∧ Sep a b then R a b / m_good p_par else 0
    let μ_child : Fin N_Θ → ℝ := fun a =>
      if C_fn a = p_par then lam a / m_par else 0
    have hGj_nn : ∀ a b, 0 ≤ G_j a b := by
      intro a b; dsimp [G_j]; split_ifs
      · exact div_nonneg (hR_nn a b) hm_good_pos.le
      · exact le_rfl
    have hGj_sum : (∑ a, ∑ b, G_j a b) = 1 := by
      dsimp [G_j]
      have h_eq : (∑ a, ∑ b, if C_fn a = p_par ∧ Sep a b then R a b / m_good p_par else 0) =
          m_good p_par / m_good p_par := by
        rw [Finset.sum_div]
        refine Finset.sum_congr rfl (fun a _ => ?_)
        rw [Finset.sum_div]
        refine Finset.sum_congr rfl (fun b _ => ?_)
        split_ifs <;> simp
      rw [h_eq, div_self hm_good_pos.ne']
    have hμc_nn : ∀ a, 0 ≤ μ_child a := by
      intro a; dsimp [μ_child]; split_ifs
      · exact div_nonneg (hlam_nn a) hm_par_pos.le
      · exact le_rfl
    have hμc_sum : ∑ a, μ_child a = 1 := by
      dsimp [μ_child]
      have h_eq : (∑ a, if C_fn a = p_par then lam a / m_par else 0) = m_par / m_par := by
        rw [Finset.sum_div]
        refine Finset.sum_congr rfl (fun a _ => ?_)
        split_ifs <;> simp
      rw [h_eq, div_self hm_par_pos.ne']
    have hGj_dom_prod : ∀ a b,
        G_j a b ≤ 8 * ρ ^ (-κ - ω) * μ_child a * lam b := by
      intro a b; dsimp [G_j, μ_child]
      by_cases hc : C_fn a = p_par ∧ Sep a b
      · rw [if_pos hc, if_pos hc.1, div_eq_mul_inv (R a b)]
        calc R a b * (m_good p_par)⁻¹
            ≤ (ρ ^ (-κ - ω) * lam a * lam b) * (8 * m_par⁻¹) :=
              mul_le_mul (hR_dom_lam a b) hm_good_inv_le
                (inv_nonneg.mpr hm_good_pos.le)
