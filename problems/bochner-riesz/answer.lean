    have hE_ent_rest : 0 < ∑ ω ∈ E, π ω → finCondEntropy ε (restrictLaw π E) B J ≤ δ_trim := by
      intro hmE_pos
      let u : Fin N_ω → ℝ := restrictLaw π E
      have hu_nn : ∀ ω, 0 ≤ u ω := by
        intro ω
        dsimp [u, restrictLaw]
        split_ifs <;> [exact div_nonneg (hπ_nn ω) hmE_pos.le; exact le_rfl]
      have huv : ∀ ω, 0 < u ω → 0 < π ω := by
