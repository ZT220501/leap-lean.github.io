      (lam_sys * ρ_r) * L_e (M_op (v_fn p.1, P₁ p.1 + p.2 • Q p.1) (Q p.1))
    have hP₁_sm : ∀ k : ℕ, ContDiff ℝ k P₁ := fun k =>
      (contDiff_const : ContDiff ℝ k (fun _ : ℝ => X_at)).sub
        ((contDiff_const : ContDiff ℝ k (fun _ : ℝ => C_r)).smul (hv_sm k))
    have hP₂_sm : ∀ k : ℕ, ContDiff ℝ k P₂ := fun k =>
      (contDiff_const : ContDiff ℝ k (fun _ : ℝ => X_o)).sub
        ((contDiff_const : ContDiff ℝ k (fun _ : ℝ => C_t)).smul (hv_sm k))
    have hQ_sm : ∀ k : ℕ, ContDiff ℝ k Q :=
      fun k => (hP₂_sm k).sub (hP₁_sm k)
    have hG_sm : ∀ k : ℕ, ContDiff ℝ k G := by
      intro k
      have hc1 : ContDiff ℝ k (fun p : ℝ × ℝ => (v_fn p.1, P₁ p.1 + p.2 • Q p.1)) :=
        ((hv_sm k).comp contDiff_fst).prodMk
          (((hP₁_sm k).comp contDiff_fst).add (contDiff_snd.smul ((hQ_sm k).comp contDiff_fst)))
      have hc2 : ContDiff ℝ k (fun p : ℝ × ℝ => (v_fn p.1, P₁ p.1)) :=
        ((hv_sm k).comp contDiff_fst).prodMk ((hP₁_sm k).comp contDiff_fst)
      exact (contDiff_const : ContDiff ℝ k (fun _ : ℝ × ℝ => lam_sys * ρ_r)).mul
        (L_e.contDiff.comp (((hζ_sm k).comp hc1).sub ((hζ_sm k).comp hc2)))
    have hG_hd2 : ∀ s τ : ℝ, HasDerivAt (fun τ' => G (s, τ')) (H (s, τ)) τ := by
      intro s τ
      have hd_lin : HasDerivAt (fun τ' : ℝ => P₁ s + τ' • Q s) (Q s) τ := by
        have h1 : HasDerivAt (fun τ' : ℝ => τ' • Q s) (Q s) τ := by
          simpa [one_smul] using (hasDerivAt_id τ).smul_const (Q s)
        exact h1.const_add (P₁ s)
      have hg_sm : ContDiff ℝ (1 : ℕ) (fun p' : EuclideanSpace ℝ (Fin 2) => ζ₀ (v_fn s, p')) :=
        (hζ_sm 1).comp (contDiff_const.prodMk contDiff_id)
      have hg_fd : HasFDerivAt (fun p' => ζ₀ (v_fn s, p'))
          (M_op (v_fn s, P₁ s + τ • Q s)) (P₁ s + τ • Q s) :=
        (hg_sm.differentiable (by norm_num)).differentiableAt.hasFDerivAt
      have hd_sub := (hg_fd.comp_hasDerivAt τ hd_lin).sub_const (ζ₀ (v_fn s, P₁ s))
      exact (L_e.hasFDerivAt.comp_hasDerivAt τ hd_sub).const_mul (lam_sys * ρ_r)
    have hd2_G : d2 G = H := by
      ext ⟨s, τ⟩; exact (hG_hd2 s τ).deriv
    have hG_iter_sm : ∀ j : ℕ, ∀ k : ℕ, ContDiff ℝ k ((d1^[j]) G) := by
      intro j
      induction j with
      | zero => exact hG_sm
      | succ j ih =>
        intro k
        rw [Function.iterate_succ_apply']
        exact h_d1_sm ((d1^[j]) G) ih k
    have hd2_iter : ∀ j : ℕ, d2 ((d1^[j]) G) = (d1^[j]) H := by
      intro j
      induction j with
      | zero => exact hd2_G
      | succ j ih =>
        rw [Function.iterate_succ_apply', Function.iterate_succ_apply', ← ih]
        ext ⟨s, τ⟩
        exact (h_schwarz ((d1^[j]) G) (hG_iter_sm j) s τ).deriv

    
    let κ : ℝ := lam_sys * ρ_r ^ 2 * (C_t - C_r)
    have hκ_abs : |κ| ≤ B_sys := by
      dsimp only [κ]
      rw [abs_mul, abs_of_pos (mul_pos hlam (sq_pos_of_pos hρ_r))]
      exact h_chirp
    let U₀ : EuclideanSpace ℝ (Fin 2) := K • e - κ • z₀
    let U₁ : EuclideanSpace ℝ (Fin 2) := (-κ) • e
    have hU₀_norm : ‖U₀‖ ≤ K + 4 * B_sys := by
      calc ‖U₀‖ ≤ ‖K • e‖ + ‖κ • z₀‖ := norm_sub_le _ _
        _ = |K| * ‖e‖ + |κ| * ‖z₀‖ := by simp only [norm_smul, Real.norm_eq_abs]
        _ ≤ K * 1 + B_sys * 4 := by
            rw [abs_of_pos hK_pos, he]
            exact add_le_add le_rfl (mul_le_mul hκ_abs hz₀_norm (norm_nonneg z₀) (by linarith))
        _ = K + 4 * B_sys := by ring
    have hU₁_norm : ‖U₁‖ ≤ B_sys := by
      dsimp only [U₁]
      rw [norm_smul, Real.norm_eq_abs, abs_neg, he, mul_one]
      exact hκ_abs
    have hQ_scaled : ∀ t : ℝ, (lam_sys * ρ_r) • Q t = U₀ + t • U₁ := by
      intro t
      rw [hQ_eq t, smul_sub, hKe_eq]
      dsimp only [U₀, U₁, κ]
      ext i
      simp only [PiLp.add_apply, PiLp.sub_apply, PiLp.smul_apply, smul_eq_mul]
      ring

    have hH_iter_bd :
        ∀ m : ℕ, 1 ≤ m → ∀ s : ℝ, |s| ≤ 6 → ∀ τ ∈ Set.Icc (0 : ℝ) 1,
          |iteratedDeriv m (fun t => H (t, τ)) s| ≤ L_osc * D_phase m := by
      intro m hm1 s hs6 τ hτ
      let c_τ : ℝ := (1 - τ) * C_r + τ * C_t
      have hc_τ0 : 0 ≤ c_τ := by
        dsimp only [c_τ]
        nlinarith [hτ.1, hτ.2, hCr.1, hCt.1]
      have hc_τ1 : c_τ ≤ 1 := by
        dsimp only [c_τ]
        nlinarith [hτ.1, hτ.2, hCr.2, hCt.2]
      let q_τ : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) :=
        (V_base, ((1 - τ) • X_at + τ • X_o) - c_τ • V_base)
      let ξ_τ : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) :=
        (ρ_r • e, -(c_τ * ρ_r) • e)
      have hξ_norm : ‖ξ_τ‖ ≤ 1 := by
        rw [Prod.norm_def, max_le_iff]
        constructor
        · dsimp only [ξ_τ]
          rw [norm_smul, Real.norm_of_nonneg hρ_r.le, he, mul_one]
          exact hρ_r1
        · dsimp only [ξ_τ]
          rw [norm_smul, Real.norm_eq_abs, abs_neg,
            abs_of_nonneg (mul_nonneg hc_τ0 hρ_r.le), he, mul_one]
          nlinarith [hc_τ0, hc_τ1, hρ_r.le, hρ_r1]
      let Λ_τ : ℝ →L[ℝ] (EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2)) :=
        (1 : ℝ →L[ℝ] ℝ).smulRight ξ_τ
      have hΛ_norm : ‖Λ_τ‖ ≤ 1 := by
        refine Λ_τ.opNorm_le_bound zero_le_one (fun t => ?_)
        simp only [Λ_τ, ContinuousLinearMap.smulRight_apply, one_apply_eq_self,
          norm_smul, Real.norm_eq_abs, one_mul]
        exact mul_le_of_le_one_right (abs_nonneg t) hξ_norm
      have h_traj : ∀ t : ℝ, (v_fn t, P₁ t + τ • Q t) = Λ_τ t + q_τ := by
        intro t
        apply Prod.ext
        · dsimp only [v_fn, V_base, Λ_τ, q_τ, ξ_τ]
          simp only [ContinuousLinearMap.smulRight_apply, one_apply_eq_self,
            Prod.fst_add, Prod.smul_fst]
          ext i
          simp only [PiLp.add_apply, PiLp.smul_apply, smul_eq_mul]
          ring
        · dsimp only [P₁, Q, P₂, v_fn, V_base, Λ_τ, q_τ, ξ_τ, c_τ]
          simp only [ContinuousLinearMap.smulRight_apply, one_apply_eq_self,
            Prod.snd_add, Prod.smul_snd]
          ext i
          simp only [PiLp.add_apply, PiLp.sub_apply, PiLp.smul_apply, smul_eq_mul]
          ring
      let M_sub : ℝ → (EuclideanSpace ℝ (Fin 2) →L[ℝ] EuclideanSpace ℝ (Fin 2)) :=
        (fun q => M_op (q + q_τ)) ∘ ⇑Λ_τ
      have hM_sh_sm : ∀ k : ℕ, ContDiff ℝ k (fun q => M_op (q + q_τ)) :=
        fun k => (hM_op_sm k).comp (contDiff_id.add contDiff_const)
      have hM_sub_sm : ∀ k : ℕ, ContDiff ℝ k M_sub :=
        fun k => (hM_sh_sm k).comp Λ_τ.contDiff
      have hM_sub_bd : ∀ (k : ℕ) (t : ℝ),
          ‖iteratedFDeriv ℝ k M_sub t‖ ≤ A ^ (k + 1) * ((k.factorial : ℝ) ^ 3) := by
        intro k t
        dsimp only [M_sub]
        rw [Λ_τ.iteratedFDeriv_comp_right (hM_sh_sm k) t le_rfl,
          iteratedFDeriv_comp_add_right k q_τ (Λ_τ t)]
        have h_norm :=
          ContinuousMultilinearMap.norm_compContinuousLinearMap_le
            (iteratedFDeriv ℝ k M_op (Λ_τ t + q_τ)) (fun _ : Fin k => Λ_τ)
        have h_prod : (∏ _ : Fin k, ‖Λ_τ‖) ≤ 1 := by
          rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
          exact pow_le_one₀ (norm_nonneg Λ_τ) hΛ_norm
        calc ‖(iteratedFDeriv ℝ k M_op (Λ_τ t + q_τ)).compContinuousLinearMap
              (fun _ => Λ_τ)‖
            ≤ ‖iteratedFDeriv ℝ k M_op (Λ_τ t + q_τ)‖ * ∏ _ : Fin k, ‖Λ_τ‖ := h_norm
          _ ≤ (A ^ (k + 1) * ((k.factorial : ℝ) ^ 3)) * 1 :=
              mul_le_mul (hζ_gev k (Λ_τ t + q_τ)) h_prod
                (Finset.prod_nonneg (fun _ _ => norm_nonneg Λ_τ)) (by positivity)
          _ = A ^ (k + 1) * ((k.factorial : ℝ) ^ 3) := mul_one _
      let eval_u : EuclideanSpace ℝ (Fin 2) →
          ((EuclideanSpace ℝ (Fin 2) →L[ℝ] EuclideanSpace ℝ (Fin 2)) →L[ℝ] ℝ) :=
        fun u => L_e.comp (ContinuousLinearMap.apply ℝ (EuclideanSpace ℝ (Fin 2)) u)
      have heval_norm : ∀ u : EuclideanSpace ℝ (Fin 2), ‖eval_u u‖ ≤ ‖u‖ := by
        intro u
        refine (eval_u u).opNorm_le_bound (norm_nonneg u) (fun T => ?_)
        change ‖L_e (T u)‖ ≤ ‖u‖ * ‖T‖
        rw [hL_e_apply, Real.norm_eq_abs]
        calc |inner ℝ (T u) e| ≤ ‖T u‖ * ‖e‖ := abs_real_inner_le_norm _ _
          _ ≤ (‖T‖ * ‖u‖) * 1 := by
              rw [he]
              exact mul_le_mul_of_nonneg_right (T.le_opNorm u) zero_le_one
          _ = ‖u‖ * ‖T‖ := by ring
      let f_vec : EuclideanSpace ℝ (Fin 2) → ℝ → ℝ := fun u => ⇑(eval_u u) ∘ M_sub
      have hf_vec_sm : ∀ (u : EuclideanSpace ℝ (Fin 2)) (k : ℕ), ContDiff ℝ k (f_vec u) :=
        fun u k => (eval_u u).contDiff.comp (hM_sub_sm k)
      have hf_vec_bd : ∀ (u : EuclideanSpace ℝ (Fin 2)) (k : ℕ) (t : ℝ),
          |iteratedDeriv k (f_vec u) t| ≤ ‖u‖ * A ^ (k + 1) * ((k.factorial : ℝ) ^ 3) := by
        intro u k t
        rw [← Real.norm_eq_abs, ← norm_iteratedFDeriv_eq_norm_iteratedDeriv]
        dsimp only [f_vec]
        rw [(eval_u u).iteratedFDeriv_comp_left (hM_sub_sm k).contDiffAt le_rfl]
        calc ‖(eval_u u).compContinuousMultilinearMap (iteratedFDeriv ℝ k M_sub t)‖
            ≤ ‖eval_u u‖ * ‖iteratedFDeriv ℝ k M_sub t‖ :=
              (eval_u u).norm_compContinuousMultilinearMap_le _
          _ ≤ ‖u‖ * (A ^ (k + 1) * ((k.factorial : ℝ) ^ 3)) :=
              mul_le_mul (heval_norm u) (hM_sub_bd k t) (norm_nonneg _) (norm_nonneg u)
          _ = ‖u‖ * A ^ (k + 1) * ((k.factorial : ℝ) ^ 3) := (mul_assoc _ _ _).symm
      have hH_decomp : (fun t : ℝ => H (t, τ)) =
          (fun t => f_vec U₀ t + t * f_vec U₁ t) := by
        ext t
        dsimp only [H, f_vec, eval_u, M_sub]
        simp only [Function.comp_apply, ContinuousLinearMap.comp_apply,
          ContinuousLinearMap.apply_apply]
        rw [h_traj t]
        have h_smul : (lam_sys * ρ_r) * L_e (M_op (Λ_τ t + q_τ) (Q t)) =
            L_e (M_op (Λ_τ t + q_τ) ((lam_sys * ρ_r) • Q t)) := by
          rw [map_smul, map_smul, smul_eq_mul]
        rw [h_smul, hQ_scaled t, map_add, map_add, map_smul, map_smul, smul_eq_mul]
      rw [hH_decomp]
      have hcd1 : ContDiffAt ℝ m (f_vec U₀) s := (hf_vec_sm U₀ m).contDiffAt
      have hcd2 : ContDiffAt ℝ m (fun t : ℝ => t * f_vec U₁ t) s :=
        (contDiff_id.mul (hf_vec_sm U₁ m)).contDiffAt
      rw [iteratedDeriv_fun_add hcd1 hcd2, h_iter_mul_id (f_vec U₁) (hf_vec_sm U₁) m s]
      have h_pow_m : A ^ (m - 1 + 1) = A ^ m := by
        congr 1; omega
      have hb0 := hf_vec_bd U₀ m s
      have hb1 := hf_vec_bd U₁ m s
      have hb2 := hf_vec_bd U₁ (m - 1) s
      rw [h_pow_m] at hb2
      have h_g1 : 0 ≤ A ^ (m + 1) * ((m.factorial : ℝ) ^ 3) := by positivity
      have h_g2 : 0 ≤ A ^ m * (((m - 1).factorial : ℝ) ^ 3) := by positivity
      have h_term0 : |iteratedDeriv m (f_vec U₀) s| ≤
          (K + 4 * B_sys) * (A ^ (m + 1) * ((m.factorial : ℝ) ^ 3)) := by
        calc |iteratedDeriv m (f_vec U₀) s|
            ≤ ‖U₀‖ * A ^ (m + 1) * ((m.factorial : ℝ) ^ 3) := hb0
          _ = ‖U₀‖ * (A ^ (m + 1) * ((m.factorial : ℝ) ^ 3)) := mul_assoc _ _ _
          _ ≤ (K + 4 * B_sys) * (A ^ (m + 1) * ((m.factorial : ℝ) ^ 3)) :=
              mul_le_mul_of_nonneg_right hU₀_norm h_g1
      have h_term1 : |s * iteratedDeriv m (f_vec U₁) s| ≤
          (6 * B_sys) * (A ^ (m + 1) * ((m.factorial : ℝ) ^ 3)) := by
        rw [abs_mul]
        have h1 : |iteratedDeriv m (f_vec U₁) s| ≤
            B_sys * (A ^ (m + 1) * ((m.factorial : ℝ) ^ 3)) := by
          calc |iteratedDeriv m (f_vec U₁) s|
              ≤ ‖U₁‖ * A ^ (m + 1) * ((m.factorial : ℝ) ^ 3) := hb1
            _ = ‖U₁‖ * (A ^ (m + 1) * ((m.factorial : ℝ) ^ 3)) := mul_assoc _ _ _
            _ ≤ B_sys * (A ^ (m + 1) * ((m.factorial : ℝ) ^ 3)) :=
                mul_le_mul_of_nonneg_right hU₁_norm h_g1
        calc |s| * |iteratedDeriv m (f_vec U₁) s|
            ≤ 6 * (B_sys * (A ^ (m + 1) * ((m.factorial : ℝ) ^ 3))) :=
              mul_le_mul hs6 h1 (abs_nonneg _) (by norm_num)
          _ = (6 * B_sys) * (A ^ (m + 1) * ((m.factorial : ℝ) ^ 3)) := by ring
      have h_term2 : |(m : ℝ) * iteratedDeriv (m - 1) (f_vec U₁) s| ≤
          B_sys * (m : ℝ) * (A ^ m * (((m - 1).factorial : ℝ) ^ 3)) := by
        rw [abs_mul, abs_of_nonneg (Nat.cast_nonneg m)]
        have h1 : |iteratedDeriv (m - 1) (f_vec U₁) s| ≤
            B_sys * (A ^ m * (((m - 1).factorial : ℝ) ^ 3)) := by
          calc |iteratedDeriv (m - 1) (f_vec U₁) s|
              ≤ ‖U₁‖ * A ^ m * (((m - 1).factorial : ℝ) ^ 3) := hb2
            _ = ‖U₁‖ * (A ^ m * (((m - 1).factorial : ℝ) ^ 3)) := mul_assoc _ _ _
            _ ≤ B_sys * (A ^ m * (((m - 1).factorial : ℝ) ^ 3)) :=
                mul_le_mul_of_nonneg_right hU₁_norm h_g2
        calc (m : ℝ) * |iteratedDeriv (m - 1) (f_vec U₁) s|
            ≤ (m : ℝ) * (B_sys * (A ^ m * (((m - 1).factorial : ℝ) ^ 3))) :=
              mul_le_mul_of_nonneg_left h1 (Nat.cast_nonneg m)
          _ = B_sys * (m : ℝ) * (A ^ m * (((m - 1).factorial : ℝ) ^ 3)) := by ring
      have h_tri :
          |iteratedDeriv m (f_vec U₀) s +
              (s * iteratedDeriv m (f_vec U₁) s +
                (m : ℝ) * iteratedDeriv (m - 1) (f_vec U₁) s)| ≤
            |iteratedDeriv m (f_vec U₀) s| +
              |s * iteratedDeriv m (f_vec U₁) s| +
              |(m : ℝ) * iteratedDeriv (m - 1) (f_vec U₁) s| := by
        have h1 := abs_add_le (iteratedDeriv m (f_vec U₀) s)
          (s * iteratedDeriv m (f_vec U₁) s + (m : ℝ) * iteratedDeriv (m - 1) (f_vec U₁) s)
        have h2 := abs_add_le (s * iteratedDeriv m (f_vec U₁) s)
          ((m : ℝ) * iteratedDeriv (m - 1) (f_vec U₁) s)
        linarith
      have hK_eq_L : K = (2 / a₀) * L_osc := by
        dsimp only [L_osc]
        field_simp [ha₀.ne']
      have h_coef1 : K + 10 * B_sys ≤ L_osc * (2 / a₀ + 10 * B_sys) := by
        rw [hK_eq_L]
        nlinarith [hB_sys, hL_ge1]
      have h_part1 :
          (K + 10 * B_sys) * (A ^ (m + 1) * ((m.factorial : ℝ) ^ 3)) ≤
            L_osc * ((2 / a₀ + 10 * B_sys) * A ^ (m + 1) * ((m.factorial : ℝ) ^ 3)) := by
        have hm1' := mul_le_mul_of_nonneg_right h_coef1 h_g1
        linarith [show L_osc * (2 / a₀ + 10 * B_sys) * (A ^ (m + 1) * ((m.factorial : ℝ) ^ 3)) =
          L_osc * ((2 / a₀ + 10 * B_sys) * A ^ (m + 1) * ((m.factorial : ℝ) ^ 3)) by ring]
      have h_part2 :
          B_sys * (m : ℝ) * (A ^ m * (((m - 1).factorial : ℝ) ^ 3)) ≤
            L_osc * (B_sys * (m : ℝ) * A ^ m * (((m - 1).factorial : ℝ) ^ 3)) := by
        have h_nn : 0 ≤ B_sys * (m : ℝ) * A ^ m * (((m - 1).factorial : ℝ) ^ 3) :=
          mul_nonneg (mul_nonneg (mul_nonneg (by linarith) (Nat.cast_nonneg m)) (by positivity))
            (by positivity)
        have h_assoc : B_sys * (m : ℝ) * (A ^ m * (((m - 1).factorial : ℝ) ^ 3)) =
            1 * (B_sys * (m : ℝ) * A ^ m * (((m - 1).factorial : ℝ) ^ 3)) := by ring
        rw [h_assoc]
        exact mul_le_mul_of_nonneg_right hL_ge1 h_nn
      dsimp only [D_phase]
      linarith [h_tri, h_term0, h_term1, h_term2, h_part1, h_part2]

    refine ⟨hθ_sm, hθ_lo, ?_⟩
    intro m hm1 s hs6
    obtain ⟨n, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : m ≠ 0)
    let g_τ : ℝ → ℝ := fun τ => iteratedDeriv (n + 1) (fun s' => G (s', τ)) s
    have hg_τ_hd : ∀ τ : ℝ, HasDerivAt g_τ
        (iteratedDeriv (n + 1) (fun s' => H (s', τ)) s) τ := by
      intro τ
      have h_lhs : g_τ = fun τ' => d1 ((d1^[n]) G) (s, τ') := by
        ext τ'
        dsimp only [g_τ]
        rw [← h_d1_iter G (n + 1) s τ', Function.iterate_succ_apply']
      have h_rhs : iteratedDeriv (n + 1) (fun s' => H (s', τ)) s =
          d1 (d2 ((d1^[n]) G)) (s, τ) := by
        rw [hd2_iter n, ← Function.iterate_succ_apply' d1 n H, h_d1_iter H (n + 1) s τ]
      rw [h_lhs, h_rhs]
      exact h_schwarz ((d1^[n]) G) (hG_iter_sm n) s τ
    have hg0 : g_τ 0 = 0 := by
      dsimp only [g_τ]
      have hG0 : (fun s' : ℝ => G (s', 0)) = (fun _ => 0) := by
        ext s'
        dsimp only [G]
        rw [zero_smul, add_zero, sub_self, map_zero, mul_zero]
      have h_iter_zero : ∀ j : ℕ, iteratedDeriv j (fun _ : ℝ => (0 : ℝ)) = (fun _ => 0) := by
        intro j
        induction j with
        | zero => rfl
        | succ j ih =>
          rw [iteratedDeriv_succ, ih]
          ext x
          exact deriv_const x (0 : ℝ)
      rw [hG0, h_iter_zero (n + 1)]
    have hg1 : g_τ 1 = iteratedDeriv (n + 1) (deriv θ) s := by
      dsimp only [g_τ]
      have hG1 : (fun s' : ℝ => G (s', 1)) = deriv θ := by
        ext s'
        rw [hθ_deriv s']
        dsimp only [G, Q]
        rw [one_smul, add_sub_cancel, hL_e_apply]
      rw [hG1]
    have h_mvt := Convex.norm_image_sub_le_of_norm_deriv_le (𝕜 := ℝ)
      (s := Set.Icc (0 : ℝ) 1) (f := g_τ) (C := L_osc * D_phase (n + 1))
      (fun τ _ => (hg_τ_hd τ).differentiableAt)
      (fun τ hτ => by
        rw [(hg_τ_hd τ).deriv, Real.norm_eq_abs]
        exact hH_iter_bd (n + 1) hm1 s hs6 τ hτ)
      (convex_Icc 0 1)
      (Set.left_mem_Icc.mpr zero_le_one)
      (Set.right_mem_Icc.mpr zero_le_one)
    rw [hg1, hg0, sub_zero, sub_zero, Real.norm_eq_abs, norm_one, mul_one] at h_mvt
    exact h_mvt

  
  obtain ⟨C_ibp, hC_ibp_nn, h_ibp⟩ :=
    h_ibp_gen M_ord 4 (by norm_num) B_amp D_phase
  let B_X : ℝ := max 2 ((20 * A * B_sys + 4) / a₀)
  let C_far : ℝ := 8 * C_ibp / (a₀ / 2) ^ M_ord
  have hB_X_ge2 : 2 ≤ B_X := le_max_left _ _
  have hC_far_nn : 0 ≤ C_far :=
    div_nonneg (mul_nonneg (by norm_num) hC_ibp_nn) (pow_nonneg (half_pos ha₀).le M_ord)
  refine ⟨B_X, C_far, hB_X_ge2, hC_far_nn, ?_⟩

  intro Φ₀ ζ₀ h_phase lam_sys ρ_r ρ_t s_c C_r C_t V_at X_at V_o X_o ψ_at ψ_loc
    hlam hρ_r hρ_le hρ_t1 _hs_c h_sc_bd hCr hCt hCt_Cr
    hψ_at_sm hψ_at_supp hψ_at_bd hψ_loc_sm _hψ_loc_supp hψ_loc_bd
    R_tr hR_tr h_sep

  have hρ_t : 0 < ρ_t := lt_of_lt_of_le hρ_r hρ_le
  have hρ_r1 : ρ_r ≤ 1 := le_trans hρ_le hρ_t1
  have hr_sc0 : 0 ≤ ρ_r / ρ_t := div_nonneg hρ_r.le hρ_t.le
  have hr_sc1 : ρ_r / ρ_t ≤ 1 := div_le_one_of_le₀ hρ_le hρ_t.le
  have h_chirp : lam_sys * ρ_r ^ 2 * |C_t - C_r| ≤ B_sys := by
    have hpos : 0 < lam_sys * ρ_r ^ 2 := mul_pos hlam (sq_pos_of_pos hρ_r)
    have h1 := mul_le_mul_of_nonneg_left hCt_Cr hpos.le
    linarith [h1, h_sc_bd]
  let ΔX : EuclideanSpace ℝ (Fin 2) := X_o - X_at - (C_t - C_r) • V_at
  let K : ℝ := (lam_sys * ρ_r) * ‖ΔX‖
  have hlam_ρr_pos : 0 < lam_sys * ρ_r := mul_pos hlam hρ_r
  have hR_le_K : R_tr ≤ K := by
    have hmul := mul_le_mul_of_nonneg_left h_sep hlam_ρr_pos.le
    have hlhs : (lam_sys * ρ_r) * (R_tr * (lam_sys * ρ_r)⁻¹) = R_tr := by
      field_simp [hlam_ρr_pos.ne']
    rwa [hlhs] at hmul
  have hK_thr : (20 * A * B_sys + 4) / a₀ ≤ K :=
    le_trans (le_max_right 2 _) (le_trans hR_tr hR_le_K)
  have hR_tr_pos : 0 < R_tr := lt_of_lt_of_le (by norm_num : (0 : ℝ) < 2) (le_trans hB_X_ge2 hR_tr)

  obtain ⟨hL_pos, e, he, h_θ_all⟩ :=
    h_s3_phase Φ₀ ζ₀ h_phase lam_sys ρ_r C_r C_t hlam hρ_r hρ_r1 hCr hCt h_chirp
      V_at X_at X_o hK_thr
  let L_osc : ℝ := (a₀ / 2) * K
  let M_sl : ℝ := C_ibp / L_osc ^ M_ord
  have hM_sl_nn : 0 ≤ M_sl := div_nonneg hC_ibp_nn (pow_nonneg hL_pos.le M_ord)

  have h_slice_bd : ∀ y₁ ∈ Set.Icc (-4 : ℝ) 4,
      ‖∫ s : ℝ,
        (star (ψ_at (s • e + y₁ • perp2D e)) *
          ψ_loc (ρ_t⁻¹ • (V_at - V_o) + (ρ_r / ρ_t) • (s • e + y₁ • perp2D e))) *
        Complex.exp (Complex.I *
          ((lam_sys * (Φ₀ (C_t, X_o, V_at + ρ_r • (s • e + y₁ • perp2D e)) -
            Φ₀ (C_r, X_at, V_at + ρ_r • (s • e + y₁ • perp2D e))) : ℝ) : ℂ))‖ ≤ M_sl := by
    intro y₁ hy₁
    obtain ⟨hθ_sm, hθ_lo, hθ_hi⟩ := h_θ_all y₁ hy₁
    obtain ⟨hu_sm, hu_supp, hu_bd⟩ :=
      h_s2_leibniz ψ_at ψ_loc hψ_at_sm hψ_at_supp hψ_at_bd hψ_loc_sm hψ_loc_bd
        (ρ_r / ρ_t) hr_sc0 hr_sc1 (ρ_t⁻¹ • (V_at - V_o)) e he y₁
    exact h_ibp L_osc hL_pos _ hθ_sm
      (fun s hs => hθ_lo s (by linarith))
      (fun m hm1 _hmM s hs => hθ_hi m hm1 s (by linarith))
      _ hu_sm hu_supp (fun k _hkM s => hu_bd k s)

  have h_2d :=
    h_s1_slice lam_sys ρ_r ρ_t C_r C_t Φ₀ V_at X_at V_o X_o e ψ_at ψ_loc M_sl
      hρ_r hρ_le (h_phase.1 0).continuous (hψ_at_sm 0).continuous hψ_at_supp
      (hψ_loc_sm 0).continuous he hM_sl_nn h_slice_bd

  have ha2_pos : 0 < a₀ / 2 := half_pos ha₀
  have haR_pos : 0 < (a₀ / 2) * R_tr := mul_pos ha2_pos hR_tr_pos
  have haR_le_L : (a₀ / 2) * R_tr ≤ L_osc :=
    mul_le_mul_of_nonneg_left hR_le_K ha2_pos.le
  have hpow_le : ((a₀ / 2) * R_tr) ^ M_ord ≤ L_osc ^ M_ord :=
    pow_le_pow_left₀ haR_pos.le haR_le_L M_ord
  have hpow_pos : 0 < ((a₀ / 2) * R_tr) ^ M_ord := pow_pos haR_pos M_ord

  refine le_trans h_2d ?_
  calc 8 * M_sl
      = (8 * C_ibp) / L_osc ^ M_ord := by dsimp only [M_sl]; ring
    _ ≤ (8 * C_ibp) / ((a₀ / 2) * R_tr) ^ M_ord :=
        div_le_div_of_nonneg_left (mul_nonneg (by norm_num) hC_ibp_nn) hpow_pos hpow_le
    _ = C_far * (R_tr ^ M_ord)⁻¹ := by
        dsimp only [C_far]
        rw [mul_pow, ← div_div, div_eq_mul_inv]
    _ = C_far * R_tr ^ (-(M_ord : ℝ)) := by
        rw [← Real.rpow_natCast R_tr M_ord, ← Real.rpow_neg hR_tr_pos.le]

theorem local_rescaled_strip_and_cell_mass_bridge (cls : PacketBoundClass)
    (M_atom : ℝ → ℝ → ℝ → ℝ → ℝ → ℕ → ℝ)
    (h_resc : LocalPhaseRescalingValid)
    (h_coh : CoherentStripMassBoundValid)
    (h ξ C_cov θ : ℝ) (d_dim M_L M_mult : ℕ) (M_win_loc : ℕ → ℝ)
    (hh : 0 < h) (hξ : 0 < ξ) (hC_cov : 2 ≤ C_cov) (hθ : 0 < θ)
    (hd_dim : d_dim = 1 ∨ d_dim = 2)
    (hML_64 : 64 ≤ M_L) (hM_mult : 1 ≤ M_mult) :
    ∃ C_bridge : ℝ,
      1 ≤ C_bridge ∧
      ∀ (ε H_P t r b_star lam_sys k_out : ℝ) (m_r m_t N_O N_ret : ℕ)
        (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
        (ζ₀ : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → EuclideanSpace ℝ (Fin 2))
        (τ_V τ_X : EuclideanSpace ℝ (Fin 2))
        (n_buf : (ℕ × (ℤ × ℤ) × (ℤ × ℤ)) → EuclideanSpace ℝ (Fin 2))
        (r_O : Fin N_O → ℕ) (V_O X_O : Fin N_O → EuclideanSpace ℝ (Fin 2))
        (ψ_loc : Fin N_O → EuclideanSpace ℝ (Fin 2) → ℂ)
        (sub : LocalizerSubclass N_ret) (S_act : Finset (Fin N_O)),
        letI := Classical.propDecidable
        let u := (H_P - t) / 2 - b_star
        let s_c := ((2 : ℝ) ^ m_r)⁻¹
        let C_r := ((sub.loc_idx.1 : ℝ) + 1 / 2) * s_c
        let s_v := ε ^ b_star
        let s_x := s_c * s_v
        let V_J := gridPt2D s_v sub.loc_idx.2.1
        let X_J := gridPt2D s_x sub.loc_idx.2.2
        let ρ_r := ε ^ ((H_P - r) / 2)
        let σ_r := (lam_sys * ρ_r)⁻¹
        let s_loc := ε ^ (u + h)
        let lam_loc := s_c * s_v ^ 2 * lam_sys
        let σ_loc := (lam_loc * (ε ^ u))⁻¹
        let n_fine := fun p_c => n_buf (coarseOfFineCell M_L p_c)
        let V_at := fun α => gridPt2D ρ_r (sub.o_at α).1
        let X_at := fun α => gridPt2D σ_r (sub.o_at α).2
        let V'_at := fun α => s_v⁻¹ • (V_at α - V_J)
        let X'_at := fun α => s_x⁻¹ • (X_at α - X_J)
        let g_at := fun α (v : EuclideanSpace ℝ (Fin 2)) =>
          (ρ_r⁻¹ : ℂ) * star (sub.ψ_at α (ρ_r⁻¹ • (v - V_at α))) *
            Complex.exp (-(Complex.I * ((lam_sys * Φ₀ (C_r, X_at α, v) : ℝ) : ℂ)))
        let Q_of : Fin N_O → (ℕ × (ℤ × ℤ) × (ℤ × ℤ)) × ℕ × (ℤ × ℤ) := fun o =>
          let p_buf := coarseOfFineCell M_L (fineOutCell ε H_P t r m_r m_t τ_V τ_X (r_O o) (V_O o) (X_O o))
          let r_loc := r_O o % 2 ^ (m_t - m_r)
          let C_t := ((r_O o : ℝ) + 1 / 2) * ((2 : ℝ) ^ m_t)⁻¹
          let X'_o := s_x⁻¹ • (X_O o - X_J - (C_t - C_r) • V_J)
          (p_buf, r_loc, roundShift2D s_loc 0 X'_o)
        let Z_of : Fin N_O → ((ℕ × (ℤ × ℤ) × (ℤ × ℤ)) × ℕ × (ℤ × ℤ)) × (ℤ × ℤ) := fun o =>
          let q := Q_of o
          let C_t := ((r_O o : ℝ) + 1 / 2) * ((2 : ℝ) ^ m_t)⁻¹
          let X'_o := s_x⁻¹ • (X_O o - X_J - (C_t - C_r) • V_J)
          let X_Q := gridPt2D s_loc q.2.2
          if d_dim = 1 then
            (q, (Int.floor (inner ℝ (X'_o - X_Q) (n_buf q.1) / σ_loc), 0))
          else
            (q, roundShift2D σ_loc 0 (X'_o - X_Q))
        let B_Q : ℝ := 4 * C_cov * cls.B_sys + 4
        let T_cand : ((ℕ × (ℤ × ℤ) × (ℤ × ℤ)) × ℕ × (ℤ × ℤ)) → Finset (Fin N_ret) := fun q =>
          let c_end := ((q.2.1 : ℝ) + 1 / 2) * ((2 : ℝ) ^ (m_t - m_r))⁻¹
          let X_Q := gridPt2D s_loc q.2.2
          Finset.univ.filter (fun α : Fin N_ret =>
            coarseOfFineCell M_L (atomOutCell ε H_P t r τ_V τ_X sub.loc_idx.1 (V_at α) (X_at α)) = q.1 ∧
            ‖(X'_at α + (c_end - 1 / 2) • V'_at α) - X_Q‖ ≤ B_Q * (ε ^ (-θ)) * s_loc)
        let m_site : Fin N_O → ℝ := fun o =>
          generalPacketObsMass ε H_P t lam_sys m_t Φ₀
            (fun v => ∑ α ∈ T_cand (Q_of o), sub.c_at α * g_at α v)
            (r_O o) (V_O o) (X_O o) (ψ_loc o)
        0 < ε → ε < 1 / 2 → r = t - 2 * h → 0 ≤ b_star → 0 ≤ u →
        ε ^ r ≤ s_c → s_c ≤ 2 * ε ^ r → m_r ≤ m_t → sub.loc_idx.1 < 2 ^ m_r →
        cls.B_sys⁻¹ * ε ^ (-H_P) ≤ lam_sys → lam_sys ≤ cls.B_sys * ε ^ (-H_P) →
        IsNormalizedPosDefPhase cls.a₀ cls.a₁ cls.A Φ₀ ζ₀ →
        (∀ p_c, ‖n_buf p_c‖ = 1) →
        0 ≤ sub.m_bin →
        (∀ α : Fin N_ret,
          (let w := fun z => star (sub.ψ_at α z)
           (∀ k : ℕ, ContDiff ℝ k w) ∧
           (∀ z : EuclideanSpace ℝ (Fin 2), 4 ≤ ‖z‖ → w z = 0) ∧
           (∀ (k : ℕ) (z : EuclideanSpace ℝ (Fin 2)),
             ‖iteratedFDeriv ℝ k w z‖ ≤
               max (M_atom cls.a₀ cls.a₁ cls.A cls.B_sys cls.R_win k) 1)) ∧
          ‖sub.c_at α‖ ^ 2 ≤ ε ^ (-ξ) * sub.m_bin) →
        (∀ o₀, ((Finset.univ.filter (fun α : Fin N_ret => sub.o_at α = o₀)).card : ℝ) ≤ (M_mult : ℝ)) →
        (∀ p_buf,
          (((Finset.univ.image (fun α : Fin N_ret =>
            let p_at := atomOutCell ε H_P t r τ_V τ_X sub.loc_idx.1 (V_at α) (X_at α)
            (p_at, fineVelBin ε H_P t r d_dim τ_V n_fine p_at (V_at α)))).filter
            (fun pw => coarseOfFineCell M_L pw.1 = p_buf)).card : ℝ) ≤
          ((M_L ^ 4 : ℕ) : ℝ) * ε ^ (-(k_out + ξ))) →
        (∀ S : Finset (Fin N_ret),
          let H_S := fun v => ∑ α ∈ S, sub.c_at α * g_at α v
          MeasureTheory.AEStronglyMeasurable H_S MeasureTheory.volume ∧
          MeasureTheory.MemLp H_S 2 MeasureTheory.volume) →
        (∀ o ∈ S_act,
          r_O o = sub.loc_idx.1 * 2 ^ (m_t - m_r) + r_O o % 2 ^ (m_t - m_r) ∧
          r_O o % 2 ^ (m_t - m_r) < 2 ^ (m_t - m_r) ∧
          (∀ k : ℕ, ContDiff ℝ k (ψ_loc o)) ∧
          (∀ z : EuclideanSpace ℝ (Fin 2), cls.R_win ≤ ‖z‖ → ψ_loc o z = 0) ∧
          (∀ (k : ℕ) (z : EuclideanSpace ℝ (Fin 2)), ‖iteratedFDeriv ℝ k (ψ_loc o) z‖ ≤ M_win_loc k) ∧
          (T_cand (Q_of o)).Nonempty) →
        (let ρ_obs := ε ^ ((H_P - t) / 2)
         let σ_obs := (lam_sys * ρ_obs)⁻¹
         ∀ (r_i : ℕ) (v₀ x₀ : EuclideanSpace ℝ (Fin 2)),
           ((Finset.univ.filter (fun o : Fin N_O =>
             r_O o = r_i ∧ ‖V_O o - v₀‖ ≤ ρ_obs ∧ ‖X_O o - x₀‖ ≤ σ_obs)).card : ℝ) ≤
             (cls.N_mult : ℝ)) →
        (∀ q, ∑ o ∈ S_act.filter (fun o => Q_of o = q), m_site o ≤
          C_bridge * ε ^ (-ξ) * ((T_cand q).card : ℝ) * sub.m_bin) ∧
        (∀ z, ∑ o ∈ S_act.filter (fun o => Z_of o = z), m_site o ≤
          C_bridge * ((M_L ^ 4 : ℕ) : ℝ) *
            ε ^ ((d_dim : ℝ) * h - k_out - 2 * θ - 2 * ξ) *
            ((T_cand z.1).card : ℝ) * sub.m_bin) :=
by
  have h_ediv_diff : ∀ (M k₁ k₂ : ℤ), 0 < M → k₁ / M = k₂ / M →
      -M + 1 ≤ k₁ - k₂ ∧ k₁ - k₂ ≤ M - 1 := by
    intro M k₁ k₂ hM hq
    have h1 := Int.mul_ediv_add_emod k₁ M
    have h2 := Int.mul_ediv_add_emod k₂ M
    have hr1_nn : 0 ≤ k₁ % M := Int.emod_nonneg k₁ (ne_of_gt hM)
    have hr1_lt : k₁ % M < M := Int.emod_lt_of_pos k₁ hM
    have hr2_nn : 0 ≤ k₂ % M := Int.emod_nonneg k₂ (ne_of_gt hM)
    have hr2_lt : k₂ % M < M := Int.emod_lt_of_pos k₂ hM
    rw [hq] at h1
    omega

  have h_norm2d_le : ∀ (w : EuclideanSpace ℝ (Fin 2)) (R : ℝ),
      0 ≤ R → |w 0| ≤ R → |w 1| ≤ R → ‖w‖ ≤ 2 * R := by
    intro w R hR h0 h1
    have hsq : ‖w‖ ^ 2 = (w 0) ^ 2 + (w 1) ^ 2 := by
      rw [EuclideanSpace.norm_sq_eq, Fin.sum_univ_two]
      simp [Real.norm_eq_abs, sq_abs]
    have hw0 : (w 0) ^ 2 ≤ R ^ 2 := by
      rw [← sq_abs (w 0)]
      exact pow_le_pow_left₀ (abs_nonneg _) h0 2
    have hw1 : (w 1) ^ 2 ≤ R ^ 2 := by
      rw [← sq_abs (w 1)]
      exact pow_le_pow_left₀ (abs_nonneg _) h1 2
    have hle : ‖w‖ ^ 2 ≤ (2 * R) ^ 2 := by nlinarith
    nlinarith [norm_nonneg w]

  have h_coord_le_norm : ∀ (w : EuclideanSpace ℝ (Fin 2)),
      |w 0| ≤ ‖w‖ ∧ |w 1| ≤ ‖w‖ := by
    intro w
    have hsq : ‖w‖ ^ 2 = (w 0) ^ 2 + (w 1) ^ 2 := by
      rw [EuclideanSpace.norm_sq_eq, Fin.sum_univ_two]
      simp [Real.norm_eq_abs, sq_abs]
    have h0_sq : |w 0| ^ 2 ≤ ‖w‖ ^ 2 := by
      rw [sq_abs]
      nlinarith [sq_nonneg (w 1)]
    have h1_sq : |w 1| ^ 2 ≤ ‖w‖ ^ 2 := by
      rw [sq_abs]
      nlinarith [sq_nonneg (w 0)]
    exact ⟨by nlinarith [abs_nonneg (w 0), norm_nonneg w],
      by nlinarith [abs_nonneg (w 1), norm_nonneg w]⟩

  have h_floor_quot_abs : ∀ (M_arg : ℕ) (s x y τ_c : ℝ),
      1 ≤ M_arg → 0 < s →
      Int.floor ((x - τ_c) / s) / (M_arg : ℤ) = Int.floor ((y - τ_c) / s) / (M_arg : ℤ) →
      |x - y| ≤ (M_arg : ℝ) * s := by
    intro M_arg s x y τ_c hM hs hq
    have hM_pos : (0 : ℤ) < (M_arg : ℤ) := by omega
    let k₁ := Int.floor ((x - τ_c) / s)
    let k₂ := Int.floor ((y - τ_c) / s)
    obtain ⟨hk_lo, hk_hi⟩ := h_ediv_diff (M_arg : ℤ) k₁ k₂ hM_pos hq
    have hk_lo_r : ((-((M_arg : ℤ)) + 1 : ℤ) : ℝ) ≤ ((k₁ - k₂ : ℤ) : ℝ) := Int.cast_le.mpr hk_lo
    have hk_hi_r : ((k₁ - k₂ : ℤ) : ℝ) ≤ (((M_arg : ℤ) - 1 : ℤ) : ℝ) := Int.cast_le.mpr hk_hi
    push_cast at hk_lo_r hk_hi_r
    have ha_lo : (k₁ : ℝ) ≤ (x - τ_c) / s := Int.floor_le _
    have ha_hi : (x - τ_c) / s < (k₁ : ℝ) + 1 := Int.lt_floor_add_one _
    have hb_lo : (k₂ : ℝ) ≤ (y - τ_c) / s := Int.floor_le _
    have hb_hi : (y - τ_c) / s < (k₂ : ℝ) + 1 := Int.lt_floor_add_one _
    have hdiff_eq : (x - y) / s = (x - τ_c) / s - (y - τ_c) / s := by ring
    have hdiv_abs : |(x - y) / s| ≤ (M_arg : ℝ) := by
      rw [hdiff_eq, abs_le]
      exact ⟨by linarith, by linarith⟩
    rw [abs_div, abs_of_pos hs, div_le_iff₀ hs] at hdiv_abs
    exact hdiv_abs

  have h_coarse_vel : ∀ (M_arg : ℕ) (s : ℝ) (τ z₁ z₂ : EuclideanSpace ℝ (Fin 2)),
      1 ≤ M_arg → 0 < s →
      (let p₁ := roundShift2D s τ z₁
       let p₂ := roundShift2D s τ z₂
       (p₁.1 / (M_arg : ℤ), p₁.2 / (M_arg : ℤ)) = (p₂.1 / (M_arg : ℤ), p₂.2 / (M_arg : ℤ))) →
      ‖z₁ - z₂‖ ≤ 2 * ((M_arg : ℝ) * s) := by
    intro M_arg s τ z₁ z₂ hM hs hq
    obtain ⟨hq0, hq1⟩ := Prod.mk.inj hq
    have hsub0 : (z₁ - z₂) 0 = z₁ 0 - z₂ 0 := rfl
    have hsub1 : (z₁ - z₂) 1 = z₁ 1 - z₂ 1 := rfl
    refine h_norm2d_le (z₁ - z₂) ((M_arg : ℝ) * s) (by positivity) ?_ ?_
    · rw [hsub0]
      exact h_floor_quot_abs M_arg s (z₁ 0) (z₂ 0) (τ 0) hM hs hq0
    · rw [hsub1]
      exact h_floor_quot_abs M_arg s (z₁ 1) (z₂ 1) (τ 1) hM hs hq1

  have h_round0_dist : ∀ (s : ℝ) (v : EuclideanSpace ℝ (Fin 2)),
      0 < s → ‖v - gridPt2D s (roundShift2D s 0 v)‖ ≤ 2 * s := by
    intro s v hs
    let k := roundShift2D s 0 v
    have h_1d : ∀ x : ℝ, |x - s * (Int.floor ((x - 0) / s) : ℝ)| ≤ s := by
      intro x
      rw [sub_zero]
      have hlo : (Int.floor (x / s) : ℝ) * s ≤ x := (le_div_iff₀ hs).mp (Int.floor_le (x / s))
      have hhi : x < ((Int.floor (x / s) : ℝ) + 1) * s :=
        (div_lt_iff₀ hs).mp (Int.lt_floor_add_one (x / s))
      exact abs_le.mpr ⟨by linarith, by linarith⟩
    have hc0 : (v - gridPt2D s k) 0 = v 0 - s * (Int.floor ((v 0 - 0) / s) : ℝ) := rfl
    have hc1 : (v - gridPt2D s k) 1 = v 1 - s * (Int.floor ((v 1 - 0) / s) : ℝ) := rfl
    refine h_norm2d_le (v - gridPt2D s k) s hs.le ?_ ?_
    · rw [hc0]; exact h_1d (v 0)
    · rw [hc1]; exact h_1d (v 1)

  have h_floor_eq_abs : ∀ (δ x y : ℝ),
      0 < δ → Int.floor (x / δ) = Int.floor (y / δ) → |x - y| ≤ δ := by
    intro δ x y hδ hq
    let k := Int.floor (x / δ)
    have hx_lo : (k : ℝ) ≤ x / δ := Int.floor_le _
    have hx_hi : x / δ < (k : ℝ) + 1 := Int.lt_floor_add_one _
    have hy_lo : (k : ℝ) ≤ y / δ := by dsimp [k]; rw [hq]; exact Int.floor_le _
    have hy_hi : y / δ < (k : ℝ) + 1 := by dsimp [k]; rw [hq]; exact Int.lt_floor_add_one _
    have hdiv : |(x - y) / δ| ≤ 1 := by
      have heq : (x - y) / δ = x / δ - y / δ := by ring
      rw [heq, abs_le]
      exact ⟨by linarith, by linarith⟩
    rw [abs_div, abs_of_pos hδ, div_le_iff₀ hδ, one_mul] at hdiv
    exact hdiv

  have h_mem_Icc_grid : ∀ (δ y : ℝ) (L : ℕ) (m : ℤ),
      0 < δ → |δ * (m : ℝ) - y| ≤ (L : ℝ) * δ →
      m ∈ Finset.Icc (Int.floor (y / δ) - (L : ℤ)) (Int.floor (y / δ) + (L : ℤ)) := by
    intro δ y L m hδ habs
    let k := Int.floor (y / δ)
    have hk_lo : (k : ℝ) * δ ≤ y := (le_div_iff₀ hδ).mp (Int.floor_le (y / δ))
    have hk_hi : y < ((k : ℝ) + 1) * δ := (div_lt_iff₀ hδ).mp (Int.lt_floor_add_one (y / δ))
    obtain ⟨h_lo, h_hi⟩ := abs_le.mp habs
    have hm_lo_r : ((k - (L : ℤ) : ℤ) : ℝ) * δ ≤ (m : ℝ) * δ := by
      push_cast; linarith
    have hm_hi_r : (m : ℝ) * δ < ((k + (L : ℤ) + 1 : ℤ) : ℝ) * δ := by
      push_cast; linarith
    have hm_lo : k - (L : ℤ) ≤ m :=
      Int.cast_le.mp (le_of_mul_le_mul_right hm_lo_r hδ)
    have hm_lt : m < k + (L : ℤ) + 1 :=
      Int.cast_lt.mp (lt_of_mul_lt_mul_right hm_hi_r hδ.le)
    exact Finset.mem_Icc.mpr ⟨hm_lo, by omega⟩

  have h_cover4d : ∀ {N_ret N_Q M_m : ℕ} (B_s ρ_r σ_r s_v s_x s_loc : ℝ)
      (V_J X_J v₀ x₀ : EuclideanSpace ℝ (Fin 2))
      (o_at : Fin N_ret → (ℤ × ℤ) × (ℤ × ℤ))
      (α_of : Fin N_Q → Fin N_ret)
      (S_ball : Finset (Fin N_Q)),
      0 < ρ_r → 0 < σ_r → 0 < s_v → 0 < s_x → 0 < s_loc →
      s_v * s_loc = ρ_r → s_x * s_loc ≤ 2 * B_s * σ_r →
      Function.Injective α_of →
      (∀ o₀, ∀ F : Finset (Fin N_ret), (∀ α ∈ F, o_at α = o₀) → F.card ≤ M_m) →
      (∀ T ∈ S_ball,
        ‖s_v⁻¹ • (gridPt2D ρ_r (o_at (α_of T)).1 - V_J) - v₀‖ ≤ s_loc ∧
        ‖s_x⁻¹ • (gridPt2D σ_r (o_at (α_of T)).2 - X_J) - x₀‖ ≤ s_loc) →
      S_ball.card ≤ 9 * (2 * Nat.ceil (2 * B_s) + 2) ^ 2 * M_m := by
    intro N_ret N_Q M_m B_s ρ_r σ_r s_v s_x s_loc V_J X_J v₀ x₀ o_at α_of S_ball
      hρ_r hσ_r hs_v hs_x _ h_sv_sloc h_sx_sloc hα_inj h_fib h_mem
    let L_X : ℕ := Nat.ceil (2 * B_s)
    have hLX_ge : 2 * B_s ≤ (L_X : ℝ) := Nat.le_ceil (2 * B_s)
    have h_sx_LX : s_x * s_loc ≤ (L_X : ℝ) * σ_r :=
      le_trans h_sx_sloc (mul_le_mul_of_nonneg_right hLX_ge hσ_r.le)
    let v₁ : EuclideanSpace ℝ (Fin 2) := V_J + s_v • v₀
    let x₁ : EuclideanSpace ℝ (Fin 2) := X_J + s_x • x₀
    let kv0 := Int.floor (v₁ 0 / ρ_r)
    let kv1 := Int.floor (v₁ 1 / ρ_r)
    let kx0 := Int.floor (x₁ 0 / σ_r)
    let kx1 := Int.floor (x₁ 1 / σ_r)
    let box_V0 := Finset.Icc (kv0 - 1) (kv0 + 1)
    let box_V1 := Finset.Icc (kv1 - 1) (kv1 + 1)
    let box_X0 := Finset.Icc (kx0 - (L_X : ℤ)) (kx0 + (L_X : ℤ))
    let box_X1 := Finset.Icc (kx1 - (L_X : ℤ)) (kx1 + (L_X : ℤ))
    let B_4d : Finset ((ℤ × ℤ) × (ℤ × ℤ)) := (box_V0 ×ˢ box_V1) ×ˢ (box_X0 ×ˢ box_X1)
    have h_maps : ∀ T ∈ S_ball, o_at (α_of T) ∈ B_4d := by
      intro T hT
      obtain ⟨hVT, hXT⟩ := h_mem T hT
      have hV_diff : gridPt2D ρ_r (o_at (α_of T)).1 - v₁ =
          s_v • (s_v⁻¹ • (gridPt2D ρ_r (o_at (α_of T)).1 - V_J) - v₀) := by
        rw [smul_sub, smul_inv_smul₀ hs_v.ne']
        dsimp [v₁]
        abel
      have hV_norm : ‖gridPt2D ρ_r (o_at (α_of T)).1 - v₁‖ ≤ (1 : ℕ) * ρ_r := by
        rw [hV_diff, norm_smul, Real.norm_of_nonneg hs_v.le, Nat.cast_one, one_mul]
        calc s_v * ‖s_v⁻¹ • (gridPt2D ρ_r (o_at (α_of T)).1 - V_J) - v₀‖
            ≤ s_v * s_loc := mul_le_mul_of_nonneg_left hVT hs_v.le
          _ = ρ_r := h_sv_sloc
      have hX_diff : gridPt2D σ_r (o_at (α_of T)).2 - x₁ =
          s_x • (s_x⁻¹ • (gridPt2D σ_r (o_at (α_of T)).2 - X_J) - x₀) := by
        rw [smul_sub, smul_inv_smul₀ hs_x.ne']
        dsimp [x₁]
        abel
      have hX_norm : ‖gridPt2D σ_r (o_at (α_of T)).2 - x₁‖ ≤ (L_X : ℝ) * σ_r := by
        rw [hX_diff, norm_smul, Real.norm_of_nonneg hs_x.le]
        exact le_trans (mul_le_mul_of_nonneg_left hXT hs_x.le) h_sx_LX
      obtain ⟨hV0, hV1⟩ := h_coord_le_norm (gridPt2D ρ_r (o_at (α_of T)).1 - v₁)
      obtain ⟨hX0, hX1⟩ := h_coord_le_norm (gridPt2D σ_r (o_at (α_of T)).2 - x₁)
      have hgV0 : (gridPt2D ρ_r (o_at (α_of T)).1 - v₁) 0 =
          ρ_r * ((o_at (α_of T)).1.1 : ℝ) - v₁ 0 := rfl
      have hgV1 : (gridPt2D ρ_r (o_at (α_of T)).1 - v₁) 1 =
          ρ_r * ((o_at (α_of T)).1.2 : ℝ) - v₁ 1 := rfl
      have hgX0 : (gridPt2D σ_r (o_at (α_of T)).2 - x₁) 0 =
          σ_r * ((o_at (α_of T)).2.1 : ℝ) - x₁ 0 := rfl
      have hgX1 : (gridPt2D σ_r (o_at (α_of T)).2 - x₁) 1 =
          σ_r * ((o_at (α_of T)).2.2 : ℝ) - x₁ 1 := rfl
      rw [hgV0] at hV0; rw [hgV1] at hV1; rw [hgX0] at hX0; rw [hgX1] at hX1
      have hmV0 := h_mem_Icc_grid ρ_r (v₁ 0) 1 (o_at (α_of T)).1.1 hρ_r (le_trans hV0 hV_norm)
      have hmV1 := h_mem_Icc_grid ρ_r (v₁ 1) 1 (o_at (α_of T)).1.2 hρ_r (le_trans hV1 hV_norm)
      have hmX0 := h_mem_Icc_grid σ_r (x₁ 0) L_X (o_at (α_of T)).2.1 hσ_r (le_trans hX0 hX_norm)
      have hmX1 := h_mem_Icc_grid σ_r (x₁ 1) L_X (o_at (α_of T)).2.2 hσ_r (le_trans hX1 hX_norm)
      exact Finset.mem_product.mpr ⟨Finset.mem_product.mpr ⟨hmV0, hmV1⟩,
        Finset.mem_product.mpr ⟨hmX0, hmX1⟩⟩
    have h_fib_T : ∀ o₀ ∈ B_4d, (S_ball.filter (fun T => o_at (α_of T) = o₀)).card ≤ M_m := by
      intro o₀ _
      let F_T := S_ball.filter (fun T => o_at (α_of T) = o₀)
      have h_eq : (F_T.image α_of).card = F_T.card := Finset.card_image_of_injective F_T hα_inj
      rw [← h_eq]
      refine h_fib o₀ (F_T.image α_of) (fun α hα => ?_)
      obtain ⟨T, hT, rfl⟩ := Finset.mem_image.mp hα
      exact (Finset.mem_filter.mp hT).2
    have h_card_mul := Finset.card_le_mul_card_image_of_maps_to h_maps M_m h_fib_T
    have h_B4d_card : B_4d.card ≤ 9 * (2 * L_X + 2) ^ 2 := by
      dsimp [B_4d, box_V0, box_V1, box_X0, box_X1]
      rw [Finset.card_product, Finset.card_product, Finset.card_product,
        Int.card_Icc, Int.card_Icc, Int.card_Icc, Int.card_Icc]
      have hcV0 : (kv0 + 1 + 1 - (kv0 - 1)).toNat = 3 := by omega
      have hcV1 : (kv1 + 1 + 1 - (kv1 - 1)).toNat = 3 := by omega
      have hcX0 : (kx0 + (L_X : ℤ) + 1 - (kx0 - (L_X : ℤ))).toNat ≤ 2 * L_X + 2 := by omega
      have hcX1 : (kx1 + (L_X : ℤ) + 1 - (kx1 - (L_X : ℤ))).toNat ≤ 2 * L_X + 2 := by omega
      rw [hcV0, hcV1, sq]
      exact Nat.mul_le_mul le_rfl (Nat.mul_le_mul hcX0 hcX1)
    calc S_ball.card
        ≤ M_m * B_4d.card := h_card_mul
      _ ≤ M_m * (9 * (2 * L_X + 2) ^ 2) := Nat.mul_le_mul_left M_m h_B4d_card
      _ = 9 * (2 * L_X + 2) ^ 2 * M_m := Nat.mul_comm _ _

  have h_perp2d_props : ∀ n : EuclideanSpace ℝ (Fin 2), ‖n‖ = 1 →
      inner ℝ n n = 1 ∧ inner ℝ n (perp2D n) = 0 ∧ ‖perp2D n‖ = 1 := by
    intro n hn
    have hnn : inner ℝ n n = 1 := by
      rw [real_inner_self_eq_norm_sq, hn, one_pow]
    have hperp : inner ℝ n (perp2D n) = 0 := by
      rw [PiLp.inner_apply, Fin.sum_univ_two]
      have hp0 : (perp2D n) 0 = -(n 1) := rfl
      have hp1 : (perp2D n) 1 = n 0 := rfl
      rw [hp0, hp1]
      simp only [RCLike.inner_apply, conj_trivial]
      ring
    have hnorm_sq : ‖perp2D n‖ ^ 2 = 1 := by
      have hn_sq : (n 0) ^ 2 + (n 1) ^ 2 = 1 := by
        have h := EuclideanSpace.norm_sq_eq n
        rw [hn, one_pow, Fin.sum_univ_two] at h
        simpa [Real.norm_eq_abs, sq_abs] using h.symm
      rw [EuclideanSpace.norm_sq_eq, Fin.sum_univ_two]
      have hp0 : (perp2D n) 0 = -(n 1) := rfl
      have hp1 : (perp2D n) 1 = n 0 := rfl
      rw [hp0, hp1]
      simp only [Real.norm_eq_abs, sq_abs]
      linarith
    refine ⟨hnn, hperp, ?_⟩
    nlinarith [norm_nonneg (perp2D n)]

  have h_z_fiber : ∀ {N_obs : ℕ} (s_loc σ_loc : ℝ)
      (X_Q n_P : EuclideanSpace ℝ (Fin 2))
      (X'_O : Fin N_obs → EuclideanSpace ℝ (Fin 2))
      (k_Z : ℤ × ℤ) (S_Z : Finset (Fin N_obs)),
      0 < s_loc → 0 < σ_loc → ‖n_P‖ = 1 →
      (∀ i : Fin N_obs, ‖X'_O i - X_Q‖ ≤ 2 * s_loc) →
      (∀ i ∈ S_Z,
        (d_dim = 1 → (Int.floor (inner ℝ (X'_O i - X_Q) n_P / σ_loc), (0 : ℤ)) = k_Z) ∧
        (d_dim = 2 → roundShift2D σ_loc 0 (X'_O i - X_Q) = k_Z)) →
      ∃ x_Z : EuclideanSpace ℝ (Fin 2), ∀ i ∈ S_Z,
        (d_dim = 1 →
          |inner ℝ (X'_O i - x_Z) n_P| ≤ σ_loc ∧
          |inner ℝ (X'_O i - x_Z) (perp2D n_P)| ≤ 2 * s_loc) ∧
        (d_dim = 2 → ‖X'_O i - x_Z‖ ≤ 2 * σ_loc) := by
    intro N_obs s_loc σ_loc X_Q n_P X'_O k_Z S_Z hs_loc hσ_loc hn_P hXQ hSZ
    obtain ⟨hnn, hperp, hn_perp⟩ := h_perp2d_props n_P hn_P
    rcases hd_dim with hd1 | hd2
    · refine ⟨X_Q + ((k_Z.1 : ℝ) * σ_loc) • n_P, fun i hi => ⟨fun _ => ?_, fun h2 => by omega⟩⟩
      have hk_eq := (hSZ i hi).1 hd1
      have hfl : Int.floor (inner ℝ (X'_O i - X_Q) n_P / σ_loc) = k_Z.1 :=
        (Prod.mk.inj hk_eq).1
      have hlo : (k_Z.1 : ℝ) * σ_loc ≤ inner ℝ (X'_O i - X_Q) n_P := by
        rw [← hfl]
        exact (le_div_iff₀ hσ_loc).mp (Int.floor_le _)
      have hhi : inner ℝ (X'_O i - X_Q) n_P < ((k_Z.1 : ℝ) + 1) * σ_loc := by
        rw [← hfl]
        exact (div_lt_iff₀ hσ_loc).mp (Int.lt_floor_add_one _)
      have hvec : X'_O i - (X_Q + ((k_Z.1 : ℝ) * σ_loc) • n_P) =
          (X'_O i - X_Q) - ((k_Z.1 : ℝ) * σ_loc) • n_P := by abel
      constructor
      · rw [hvec, inner_sub_left, real_inner_smul_left, hnn, mul_one]
        exact abs_le.mpr ⟨by linarith, by linarith⟩
      · rw [hvec, inner_sub_left, real_inner_smul_left, hperp, mul_zero, sub_zero]
        calc |inner ℝ (X'_O i - X_Q) (perp2D n_P)|
            ≤ ‖X'_O i - X_Q‖ * ‖perp2D n_P‖ := abs_real_inner_le_norm _ _
          _ = ‖X'_O i - X_Q‖ := by rw [hn_perp, mul_one]
          _ ≤ 2 * s_loc := hXQ i
    · refine ⟨X_Q + gridPt2D σ_loc k_Z, fun i hi => ⟨fun h1 => by omega, fun _ => ?_⟩⟩
      have hk_eq := (hSZ i hi).2 hd2
      obtain ⟨hk0, hk1⟩ := Prod.mk.inj hk_eq
      have hvec : X'_O i - (X_Q + gridPt2D σ_loc k_Z) =
          (X'_O i - X_Q) - gridPt2D σ_loc k_Z := by abel
      have h_1d : ∀ (y : ℝ) (m : ℤ), Int.floor ((y - 0) / σ_loc) = m →
          |y - σ_loc * (m : ℝ)| ≤ σ_loc := by
        intro y m hm
        rw [sub_zero] at hm
        have hlo : (m : ℝ) * σ_loc ≤ y := by
          rw [← hm]
          exact (le_div_iff₀ hσ_loc).mp (Int.floor_le _)
        have hhi : y < ((m : ℝ) + 1) * σ_loc := by
          rw [← hm]
          exact (div_lt_iff₀ hσ_loc).mp (Int.lt_floor_add_one _)
        exact abs_le.mpr ⟨by linarith, by linarith⟩
      have hc0 : ((X'_O i - X_Q) - gridPt2D σ_loc k_Z) 0 =
          (X'_O i - X_Q) 0 - σ_loc * (k_Z.1 : ℝ) := rfl
      have hc1 : ((X'_O i - X_Q) - gridPt2D σ_loc k_Z) 1 =
          (X'_O i - X_Q) 1 - σ_loc * (k_Z.2 : ℝ) := rfl
      rw [hvec]
      refine h_norm2d_le _ σ_loc hσ_loc.le ?_ ?_
      · rw [hc0]; exact h_1d ((X'_O i - X_Q) 0) k_Z.1 hk0
      · rw [hc1]; exact h_1d ((X'_O i - X_Q) 1) k_Z.2 hk1

  have h_vel_bin_width : ∀ (ε H_P t r s_v s_loc : ℝ)
      (τ_V V_J : EuclideanSpace ℝ (Fin 2))
      (n_buf : (ℕ × (ℤ × ℤ) × (ℤ × ℤ)) → EuclideanSpace ℝ (Fin 2))
      (p_buf p_at₁ p_at₂ : ℕ × (ℤ × ℤ) × (ℤ × ℤ))
      (v₁ v₂ : EuclideanSpace ℝ (Fin 2)),
      let ρ_r := ε ^ ((H_P - r) / 2)
      let n_fine := fun p_c => n_buf (coarseOfFineCell M_L p_c)
      0 < s_v → 0 < ρ_r → s_v * s_loc = ρ_r →
      coarseOfFineCell M_L p_at₁ = p_buf →
      (p_at₁, fineVelBin ε H_P t r d_dim τ_V n_fine p_at₁ v₁) =
        (p_at₂, fineVelBin ε H_P t r d_dim τ_V n_fine p_at₂ v₂) →
      let v'_1 := s_v⁻¹ • (v₁ - V_J)
      let v'_2 := s_v⁻¹ • (v₂ - V_J)
      (d_dim = 1 → |inner ℝ (v'_1 - v'_2) (n_buf p_buf)| ≤ s_loc) ∧
      (d_dim = 2 → ‖v'_1 - v'_2‖ ≤ 2 * s_loc) := by
    intro ε H_P t r s_v s_loc τ_V V_J n_buf p_buf p_at₁ p_at₂ v₁ v₂ ρ_r n_fine
      hs_v hρ_r h_sv_sloc hcoarse hpw v'_1 v'_2
    obtain ⟨hp_eq, hbin_eq⟩ := Prod.mk.inj hpw
    subst hp_eq
    have h_sv_inv : s_v⁻¹ * ρ_r = s_loc := by
      rw [← h_sv_sloc, inv_mul_cancel_left₀ hs_v.ne']
    have hv'_diff : v'_1 - v'_2 = s_v⁻¹ • (v₁ - v₂) := by
      dsimp [v'_1, v'_2]
      rw [← smul_sub]
      congr 1; abel
    let c_V := fineCellCenterV (ε ^ ((H_P - t) / 2)) τ_V p_at₁.2.1
    rcases hd_dim with hd1 | hd2
    · refine ⟨fun _ => ?_, fun h2 => by omega⟩
      unfold fineVelBin at hbin_eq
      rw [if_pos hd1, if_pos hd1] at hbin_eq
      have hfl := (Prod.mk.inj hbin_eq).1
      have hn_eq : n_fine p_at₁ = n_buf p_buf := by dsimp [n_fine]; rw [hcoarse]
      rw [hn_eq] at hfl
      have h_abs_v : |inner ℝ (v₁ - c_V) (n_buf p_buf) - inner ℝ (v₂ - c_V) (n_buf p_buf)| ≤ ρ_r :=
        h_floor_eq_abs ρ_r _ _ hρ_r hfl
      have h_inner_diff : inner ℝ (v₁ - c_V) (n_buf p_buf) - inner ℝ (v₂ - c_V) (n_buf p_buf) =
          inner ℝ (v₁ - v₂) (n_buf p_buf) := by
        rw [← inner_sub_left]; congr 1; abel
      rw [h_inner_diff] at h_abs_v
      rw [hv'_diff, real_inner_smul_left, abs_mul, abs_of_pos (inv_pos.mpr hs_v), ← h_sv_inv]
      exact mul_le_mul_of_nonneg_left h_abs_v (inv_nonneg.mpr hs_v.le)
    · refine ⟨fun h1 => by omega, fun _ => ?_⟩
      have hd_ne1 : d_dim ≠ 1 := by omega
      unfold fineVelBin at hbin_eq
      rw [if_neg hd_ne1, if_neg hd_ne1] at hbin_eq
      obtain ⟨hfl0, hfl1⟩ := Prod.mk.inj hbin_eq
      have ha0 := h_floor_eq_abs ρ_r ((v₁ - c_V) 0) ((v₂ - c_V) 0) hρ_r hfl0
      have ha1 := h_floor_eq_abs ρ_r ((v₁ - c_V) 1) ((v₂ - c_V) 1) hρ_r hfl1
      have hs0 : (v₁ - c_V) 0 - (v₂ - c_V) 0 = (v₁ - v₂) 0 := by
        change (v₁ 0 - c_V 0) - (v₂ 0 - c_V 0) = v₁ 0 - v₂ 0; ring
      have hs1 : (v₁ - c_V) 1 - (v₂ - c_V) 1 = (v₁ - v₂) 1 := by
        change (v₁ 1 - c_V 1) - (v₂ 1 - c_V 1) = v₁ 1 - v₂ 1; ring
      rw [hs0] at ha0; rw [hs1] at ha1
      have hnorm_v : ‖v₁ - v₂‖ ≤ 2 * ρ_r := h_norm2d_le (v₁ - v₂) ρ_r hρ_r.le ha0 ha1
      rw [hv'_diff, norm_smul, Real.norm_of_nonneg (inv_nonneg.mpr hs_v.le)]
      calc s_v⁻¹ * ‖v₁ - v₂‖
          ≤ s_v⁻¹ * (2 * ρ_r) := mul_le_mul_of_nonneg_left hnorm_v (inv_nonneg.mpr hs_v.le)
        _ = 2 * (s_v⁻¹ * ρ_r) := by ring
        _ = 2 * s_loc := by rw [h_sv_inv]

  have h_resc_sum : ∀ (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
      (ζ₀ : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → EuclideanSpace ℝ (Fin 2))
      (m_r m_t q_r : ℕ) (ε H_P t r b_star lam_sys : ℝ)
      (V_J X_J : EuclideanSpace ℝ (Fin 2))
      (N_Q : ℕ) (V_at X_at : Fin N_Q → EuclideanSpace ℝ (Fin 2))
      (w_at : Fin N_Q → EuclideanSpace ℝ (Fin 2) → ℂ)
      (c_at : Fin N_Q → ℂ),
      IsNormalizedPosDefPhase cls.a₀ cls.a₁ cls.A Φ₀ ζ₀ →
      m_r ≤ m_t → q_r < 2 ^ m_r →
      0 < ε → ε < 1 / 2 → r = t - 2 * h → 0 ≤ b_star → 0 < lam_sys →
      let u := (H_P - t) / 2 - b_star
      let s_c := ((2 : ℝ) ^ m_r)⁻¹
      let C_r := ((q_r : ℝ) + 1 / 2) * s_c
      let s_v := ε ^ b_star
      let s_x := s_c * s_v
      let ρ := ε ^ u
      let s_loc := ε ^ (u + h)
      let ρ_r := ε ^ ((H_P - r) / 2)
      let lam_loc := s_c * s_v ^ 2 * lam_sys
      let Φ'₀ := localGaugePhase Φ₀ m_r q_r s_v V_J X_J
      let ζ'₀ := localGaugeGrad ζ₀ m_r q_r s_v V_J X_J
      let V'_at := fun T : Fin N_Q => s_v⁻¹ • (V_at T - V_J)
      let X'_at := fun T : Fin N_Q => s_x⁻¹ • (X_at T - X_J)
      let g_at := fun T (v : EuclideanSpace ℝ (Fin 2)) =>
        (ρ_r⁻¹ : ℂ) * w_at T (ρ_r⁻¹ • (v - V_at T)) *
          Complex.exp (-(Complex.I * ((lam_sys * Φ₀ (C_r, X_at T, v) : ℝ) : ℂ)))
      let h_cand := fun v : EuclideanSpace ℝ (Fin 2) => ∑ T : Fin N_Q, c_at T * g_at T v
