      have h_lo : (-(3 / 2 : ℝ)) * s < x - x₀ := by nlinarith
      have h_hi : x - x₀ < (3 / 2 : ℝ) * s := by nlinarith
      have h_div_lo : -(3 / 2 : ℝ) < x / s - x₀ / s := by
        have h1 : ((-(3 / 2 : ℝ)) * s) / s < (x - x₀) / s := div_lt_div_of_pos_right h_lo hs
        rw [mul_div_cancel_right₀ _ hs.ne', sub_div] at h1
        exact h1
      have h_div_hi : x / s - x₀ / s < (3 / 2 : ℝ) := by
        have h1 : (x - x₀) / s < ((3 / 2 : ℝ) * s) / s := div_lt_div_of_pos_right h_hi hs
        rw [mul_div_cancel_right₀ _ hs.ne', sub_div] at h1
        exact h1
      set k : ℤ := ⌊x₀ / s⌋
      have hk_lo : (k : ℝ) ≤ x₀ / s := Int.floor_le (x₀ / s)
      have hk_hi : x₀ / s < (k : ℝ) + 1 := Int.lt_floor_add_one (x₀ / s)
      refine ⟨?_, ?_⟩
      · refine Int.le_floor.mpr ?_
        push_cast
        linarith
      · have h_fl_le : (⌊x / s⌋ : ℝ) ≤ x / s := Int.floor_le (x / s)
        have h_lt_3 : ((⌊x / s⌋ : ℤ) : ℝ) < ((k + 3 : ℤ) : ℝ) := by
          push_cast
          linarith
        have h_z : ⌊x / s⌋ < k + 3 := Int.cast_lt.mp h_lt_3
        omega
    have h_box25_mem : ∀ (W W₀ : EuclideanSpace ℝ (Fin 2)),
        |inner ℝ (W - W₀) e₀| ≤ s →
        |inner ℝ (W - W₀) (perp2D e₀)| ≤ s →
        roundShift2D s 0 W ∈ box25 W₀ := by
      intro W W₀ h1 h2
      have h1_sq : (inner ℝ (W - W₀) e₀) ^ 2 ≤ s ^ 2 := by
        rw [← sq_abs]
        nlinarith [abs_nonneg (inner ℝ (W - W₀) e₀)]
      have h2_sq : (inner ℝ (W - W₀) (perp2D e₀)) ^ 2 ≤ s ^ 2 := by
        rw [← sq_abs]
        nlinarith [abs_nonneg (inner ℝ (W - W₀) (perp2D e₀))]
      have h_sum_sq : (W 0 - W₀ 0) ^ 2 + (W 1 - W₀ 1) ^ 2 < ((3 / 2 : ℝ) * s) ^ 2 := by
        have hp := h_parseval (W - W₀)
        simp only [PiLp.sub_apply] at hp
        nlinarith
      rw [Finset.mem_product]
      exact ⟨h_coord_5 (W 0) (W₀ 0) (by nlinarith [sq_nonneg (W 1 - W₀ 1)]),
             h_coord_5 (W 1) (W₀ 1) (by nlinarith [sq_nonneg (W 0 - W₀ 0)])⟩
    let img := F.image (fun a => (roundShift2D s 0 (V a), roundShift2D s 0 (X a)))
    have h_sub : img ⊆ box25 V₀ ×ˢ box25 X₀ := by
      intro p hp
      obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp hp
      obtain ⟨hV1, hV2, hX1, hX2⟩ := hF a ha
      exact Finset.mem_product.mpr ⟨h_box25_mem (V a) V₀ hV1 hV2, h_box25_mem (X a) X₀ hX1 hX2⟩
    have h_card_nat : img.card ≤ 625 := by
      calc img.card
          ≤ (box25 V₀ ×ˢ box25 X₀).card := Finset.card_le_card h_sub
        _ = 625 := by rw [Finset.card_product, h_box25_card, h_box25_card]
    exact_mod_cast h_card_nat

theorem buffered_cell_paving_fiber_mass_bound (cls : PacketBoundClass)
    (M_atom : ℝ → ℝ → ℝ → ℝ → ℝ → ℕ → ℝ)
    (γ ε H_P L t h b_star lam_sys A_win ξ C_cov : ℝ)
    (M_L M_mult M_ord M_tr m_r m_t N_O N_D N_ret : ℕ)
    (C_tr : ℕ → ℝ) (C_sub_bes B_X C_far R_tr : ℝ)
    (Φ₀ : ℝ × EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → ℝ)
    (ζ₀ : EuclideanSpace ℝ (Fin 2) × EuclideanSpace ℝ (Fin 2) → EuclideanSpace ℝ (Fin 2))
    (f : EuclideanSpace ℝ (Fin 2) → ℂ)
    (τ_V τ_X : EuclideanSpace ℝ (Fin 2))
    (r_O : Fin N_O → ℕ) (V_O X_O : Fin N_O → EuclideanSpace ℝ (Fin 2))
    (ψ_O : Fin N_O → EuclideanSpace ℝ (Fin 2) → ℂ)
    (b_D a_D : Fin N_D → ℝ) (r_D : Fin N_D → ℕ)
    (e_D V_D X_D : Fin N_D → EuclideanSpace ℝ (Fin 2))
    (sub : LocalizerSubclass N_ret) (p_cond : Fin N_O → Fin N_D → ℝ)
    (p_buf : ℕ × (ℤ × ℤ) × (ℤ × ℤ)) (r_i : ℕ)
    (S_obs : Finset (Fin N_O)) (T_P : Finset (Fin N_ret))
    (h_grid :
      (∀ (s : ℝ) (v : EuclideanSpace ℝ (Fin 2)),
        0 < s → ‖v - gridPt2D s (roundShift2D s 0 v)‖ ≤ 2 * s) ∧
      (∀ (m₁ m₂ : ℕ) (ρ : ℝ),
        m₁ ≤ m₂ → 0 < ρ →
        let s₁ := ((2 : ℝ) ^ m₁)⁻¹ * ρ
        let s₂ := ((2 : ℝ) ^ m₂)⁻¹ * ρ
        let K : ℤ := ((2 ^ (m₂ - m₁) : ℕ) : ℤ)
        (∀ v : EuclideanSpace ℝ (Fin 2),
          roundShift2D s₁ 0 v =
            ((roundShift2D s₂ 0 v).1 / K, (roundShift2D s₂ 0 v).2 / K)) ∧
        (∀ k₂ : ℤ × ℤ,
          ‖gridPt2D s₂ k₂ - gridPt2D s₁ (k₂.1 / K, k₂.2 / K)‖ ≤ 2 * s₁)) ∧
      (∀ (s R : ℝ) (v₀ : EuclideanSpace ℝ (Fin 2)) (S : Finset (ℤ × ℤ)),
        0 < s → 0 ≤ R →
        (∀ k ∈ S, ‖gridPt2D s k - v₀‖ ≤ R) →
        (S.card : ℝ) ≤ (2 * (R / s) + 3) ^ 2) ∧
      (∀ (s R Δ : ℝ) (v₀ : EuclideanSpace ℝ (Fin 2)) (S : Finset (ℤ × ℤ)),
        0 < s → 0 < R → 0 < Δ → Δ ≤ R / 2 →
        (∀ k ∈ S, R - Δ ≤ ‖gridPt2D s k - v₀‖ ∧ ‖gridPt2D s k - v₀‖ ≤ R) →
        (S.card : ℝ) ≤ 2 * (2 * (R / s) + 3) * (6 * (Δ / s) + 4)))
    (hh : 0 < h) (hC_cov : 2 ≤ C_cov) (hML_bound : (64 * C_cov * cls.B_sys : ℝ) ≤ (M_L : ℝ))
    (hM_mult : 1 ≤ M_mult) (hC_bes : 1 ≤ C_sub_bes) (hBX : 2 ≤ B_X) (hC_far : 0 ≤ C_far)
    (hM_tr : 2 ≤ M_tr) (hR_tr_BX : B_X ≤ R_tr)
    (hR_tr_eh : R_tr * ε ^ h ≤ 1)
    (h_tr_tail : C_tr M_tr * R_tr ^ (1 - (M_tr : ℝ)) ≤ (1 / 2 : ℝ) * ε ^ (A_win / 2))
    (h_eh_small : 8 * ε ^ (h / 2) ≤ 1)
    (h_far_small : 16 * (N_O : ℝ) * (N_ret : ℝ) * C_far * R_tr ^ (-(2 * (M_ord : ℝ))) ≤ 1)
    (hr_pos : 0 < t - 2 * h) (ht_HP : t ≤ H_P)
    (henv : IsValidPacketEnv cls ε H_P L lam_sys Φ₀ ζ₀ f)
    (hsub : IsValidSubclassAtoms cls M_atom γ ε H_P L t (t - 2 * h) b_star lam_sys ξ C_cov
      m_r m_t M_mult C_tr Φ₀ sub)
    (hadm : IsAdmissiblePacketLaw ε H_P L t cls.B_sys cls.R_win cls.N_mult cls.M_win
      lam_sys m_t Φ₀ f N_O N_D r_O V_O X_O ψ_O b_D a_D r_D e_D V_D X_D p_cond)
    (hs_c_hi : ((2 : ℝ) ^ m_r)⁻¹ ≤ 2 * ε ^ (t - 2 * h))
    (h_loc_far : ∀ o ∈ S_obs,
      let r := t - 2 * h
      let s_c := ((2 : ℝ) ^ m_r)⁻¹
      let C_r := ((sub.loc_idx.1 : ℝ) + 1 / 2) * s_c
      let s_v := ε ^ b_star
      let s_x := s_c * s_v
      let V_J := gridPt2D s_v sub.loc_idx.2.1
      let X_J := gridPt2D s_x sub.loc_idx.2.2
      let ρ_r := ε ^ ((H_P - r) / 2)
      let σ_r := (lam_sys * ρ_r)⁻¹
      let V_at := fun α => gridPt2D ρ_r (sub.o_at α).1
      let X_at := fun α => gridPt2D σ_r (sub.o_at α).2
      let g_at := fun α (v : EuclideanSpace ℝ (Fin 2)) =>
        (ρ_r⁻¹ : ℂ) * star (sub.ψ_at α (ρ_r⁻¹ • (v - V_at α))) *
          Complex.exp (-(Complex.I * ((lam_sys * Φ₀ (C_r, X_at α, v) : ℝ) : ℂ)))
      let r_loc := r_O o % 2 ^ (m_t - m_r)
      let C_t := ((r_O o : ℝ) + 1 / 2) * ((2 : ℝ) ^ m_t)⁻¹
      r_O o = sub.loc_idx.1 * 2 ^ (m_t - m_r) + r_loc ∧
      r_loc < 2 ^ (m_t - m_r) ∧ |C_t - C_r| ≤ s_c / 2 ∧
      ‖V_O o - V_J‖ ≤ s_v ∧ ‖X_O o + (C_r - C_t) • V_O o - X_J‖ ≤ s_x ∧
      ∀ α : Fin N_ret,
        R_tr * σ_r ≤ ‖X_O o - X_at α - (C_t - C_r) • V_at α‖ →
        generalPacketObsMass ε H_P t lam_sys m_t Φ₀ (g_at α)
          (r_O o) (V_O o) (X_O o) (ψ_O o) ≤ C_far * R_tr ^ (-(2 * (M_ord : ℝ))))
    (h_bessel : ∀ S_at : Finset (Fin N_ret),
      let r := t - 2 * h
      let s_c := ((2 : ℝ) ^ m_r)⁻¹
      let C_r := ((sub.loc_idx.1 : ℝ) + 1 / 2) * s_c
      let ρ_r := ε ^ ((H_P - r) / 2)
      let σ_r := (lam_sys * ρ_r)⁻¹
      let V_at := fun α => gridPt2D ρ_r (sub.o_at α).1
      let X_at := fun α => gridPt2D σ_r (sub.o_at α).2
      let g_at := fun α (v : EuclideanSpace ℝ (Fin 2)) =>
        (ρ_r⁻¹ : ℂ) * star (sub.ψ_at α (ρ_r⁻¹ • (v - V_at α))) *
          Complex.exp (-(Complex.I * ((lam_sys * Φ₀ (C_r, X_at α, v) : ℝ) : ℂ)))
      ∑ o ∈ S_obs, generalPacketObsMass ε H_P t lam_sys m_t Φ₀
        (fun v => ∑ α ∈ S_at, sub.c_at α * g_at α v)
        (r_O o) (V_O o) (X_O o) (ψ_O o) ≤
        C_sub_bes * ∑ α ∈ S_at, ‖sub.c_at α‖ ^ 2)
    (hr_i : r_i < 2 ^ m_t)
    (hS_obs : ∀ o ∈ S_obs,
      let r := t - 2 * h
      let s_c := ((2 : ℝ) ^ m_r)⁻¹
      let C_r := ((sub.loc_idx.1 : ℝ) + 1 / 2) * s_c
      let ρ_r := ε ^ ((H_P - r) / 2)
      let σ_r := (lam_sys * ρ_r)⁻¹
      let h_sub := fun v => ∑ α : Fin N_ret, sub.c_at α *
        ((ρ_r⁻¹ : ℂ) * star (sub.ψ_at α (ρ_r⁻¹ • (v - gridPt2D ρ_r (sub.o_at α).1))) *
          Complex.exp (-(Complex.I * ((lam_sys * Φ₀ (C_r, gridPt2D σ_r (sub.o_at α).2, v) : ℝ) : ℂ))))
      r_O o = r_i ∧
      coarseOfFineCell M_L (fineOutCell ε H_P t r m_r m_t τ_V τ_X (r_O o) (V_O o) (X_O o)) = p_buf ∧
      (∀ (v' x' : EuclideanSpace ℝ (Fin 2)),
        let q_r := r_O o / 2 ^ (m_t - m_r)
        let C_r' := ((q_r : ℝ) + 1 / 2) * ((2 : ℝ) ^ m_r)⁻¹
        let C_t := ((r_O o : ℝ) + 1 / 2) * ((2 : ℝ) ^ m_t)⁻¹
        ‖v' - V_O o‖ ≤ ((M_L : ℝ) / 32) * ε ^ ((H_P - t) / 2) →
        ‖x' - (X_O o + (C_r' - C_t) • V_O o)‖ ≤ ((M_L : ℝ) / 32) * ε ^ (r + (H_P - t) / 2) →
        coarseOfFineCell M_L (fineOutCell ε H_P t r m_r m_t τ_V τ_X (r_O o) (V_O o) (X_O o)) =
        coarseOfFineCell M_L (atomOutCell ε H_P t r τ_V τ_X q_r v' x')) ∧
      ε ^ A_win ≤ generalPacketObsMass ε H_P t lam_sys m_t Φ₀ h_sub
        (r_O o) (V_O o) (X_O o) (ψ_O o))
    (hT_P : ∀ α : Fin N_ret,
      let r := t - 2 * h
      coarseOfFineCell M_L (atomOutCell ε H_P t r τ_V τ_X sub.loc_idx.1
        (gridPt2D (ε ^ ((H_P - r) / 2)) (sub.o_at α).1)
        (gridPt2D ((lam_sys * ε ^ ((H_P - r) / 2))⁻¹) (sub.o_at α).2)) = p_buf ↔ α ∈ T_P) :
    (S_obs.Nonempty → T_P.Nonempty) ∧
    (let r := t - 2 * h
     let s_c := ((2 : ℝ) ^ m_r)⁻¹
     let C_r := ((sub.loc_idx.1 : ℝ) + 1 / 2) * s_c
     let ρ_r := ε ^ ((H_P - r) / 2)
     let σ_r := (lam_sys * ρ_r)⁻¹
     let h_sub := fun v => ∑ α : Fin N_ret, sub.c_at α *
       ((ρ_r⁻¹ : ℂ) * star (sub.ψ_at α (ρ_r⁻¹ • (v - gridPt2D ρ_r (sub.o_at α).1))) *
         Complex.exp (-(Complex.I * ((lam_sys * Φ₀ (C_r, gridPt2D σ_r (sub.o_at α).2, v) : ℝ) : ℂ))))
     ∑ o ∈ S_obs, generalPacketObsMass ε H_P t lam_sys m_t Φ₀ h_sub
       (r_O o) (V_O o) (X_O o) (ψ_O o) ≤
       (131072 * C_sub_bes * C_cov ^ 3 * (M_mult : ℝ)) * R_tr ^ 2 *
         ε ^ (-(5 / 4 : ℝ) * h - ξ) * sub.m_bin * (T_P.card : ℝ)) :=
by
  
  
  
  let r : ℝ := t - 2 * h
  let q_r : ℕ := sub.loc_idx.1
  let s_c : ℝ := ((2 : ℝ) ^ m_r)⁻¹
  let C_r : ℝ := ((q_r : ℝ) + 1 / 2) * s_c
  let s_v : ℝ := ε ^ b_star
  let s_x : ℝ := s_c * s_v
  let V_J : EuclideanSpace ℝ (Fin 2) := gridPt2D s_v sub.loc_idx.2.1
  let X_J : EuclideanSpace ℝ (Fin 2) := gridPt2D s_x sub.loc_idx.2.2
  let ρ_r : ℝ := ε ^ ((H_P - r) / 2)
  let σ_r : ℝ := (lam_sys * ρ_r)⁻¹
  let ρ_t : ℝ := ε ^ ((H_P - t) / 2)
  let V_at : Fin N_ret → EuclideanSpace ℝ (Fin 2) := fun α => gridPt2D ρ_r (sub.o_at α).1
  let X_at : Fin N_ret → EuclideanSpace ℝ (Fin 2) := fun α => gridPt2D σ_r (sub.o_at α).2
  let g_at : Fin N_ret → EuclideanSpace ℝ (Fin 2) → ℂ := fun α v =>
    (ρ_r⁻¹ : ℂ) * star (sub.ψ_at α (ρ_r⁻¹ • (v - V_at α))) *
      Complex.exp (-(Complex.I * ((lam_sys * Φ₀ (C_r, X_at α, v) : ℝ) : ℂ)))
  let h_sub : EuclideanSpace ℝ (Fin 2) → ℂ := fun v => ∑ α : Fin N_ret, sub.c_at α * g_at α v
  let C_t : Fin N_O → ℝ := fun o => ((r_O o : ℝ) + 1 / 2) * ((2 : ℝ) ^ m_t)⁻¹

  obtain ⟨hε₀, hε₁, _, _, _, _, hlam_lo, _, h_phase, _⟩ := henv
  obtain ⟨_, hψ_O_sm, hψ_O_supp, hψ_O_der, _⟩ := hadm
  obtain ⟨_, _, _, _, _, hm_bin_pos, _, _, _, h_at_raw, h_mult_raw, _, _, h_trunc_raw⟩ := hsub

  have hΦ_cont : Continuous Φ₀ := (h_phase.1 0).continuous
  have hψ_O_cont : ∀ o : Fin N_O, Continuous (ψ_O o) := fun o => (hψ_O_sm o 0).continuous
  have hψ_at_cont : ∀ α : Fin N_ret, Continuous (sub.ψ_at α) :=
    fun α => ((h_at_raw α).1 0).continuous
  have hw_hi : ∀ α : Fin N_ret, ‖sub.c_at α‖ ^ 2 ≤ ε ^ (-ξ) * sub.m_bin :=
    fun α => (h_at_raw α).2.2.2.2.2.2.1

  have h_mult : ∀ (S : Finset (Fin N_ret)) (o₀ : (ℤ × ℤ) × (ℤ × ℤ)),
      (∀ α ∈ S, sub.o_at α = o₀) → S.card ≤ M_mult := by
    intro S o₀ hS
    let F₀ := @Finset.filter (Fin N_ret) (fun α => sub.o_at α = o₀)
      (fun _ => Classical.propDecidable _) Finset.univ
    have hsub_F : S ⊆ F₀ := by
      intro α hα
      exact (@Finset.mem_filter _ _ (fun _ => Classical.propDecidable _) _ _).mpr
        ⟨Finset.mem_univ α, hS α hα⟩
    have hcard_le : S.card ≤ F₀.card := Finset.card_le_card hsub_F
    have h_real : (F₀.card : ℝ) ≤ (M_mult : ℝ) := h_mult_raw o₀
    exact le_trans hcard_le (Nat.cast_le.mp h_real)

  have hε_le1 : ε ≤ 1 := by linarith only [hε₁]
  have hB_sys2 : (2 : ℝ) ≤ cls.B_sys := cls.hB_sys
  have hB_sys_pos : (0 : ℝ) < cls.B_sys := by linarith only [hB_sys2]
  have hR_tr_2 : (2 : ℝ) ≤ R_tr := le_trans hBX hR_tr_BX
  have hR_tr_pos : (0 : ℝ) < R_tr := by linarith only [hR_tr_2]
  have hC_cov_pos : (0 : ℝ) < C_cov := by linarith only [hC_cov]
  have hM_mult_r : (1 : ℝ) ≤ (M_mult : ℝ) := by exact_mod_cast hM_mult
  have hρ_r_pos : 0 < ρ_r := Real.rpow_pos_of_pos hε₀ _
  have hρ_t_pos : 0 < ρ_t := Real.rpow_pos_of_pos hε₀ _
  have hs_c_pos : 0 < s_c := inv_pos.mpr (pow_pos (by norm_num : (0 : ℝ) < 2) m_r)
  have hs_v_pos : 0 < s_v := Real.rpow_pos_of_pos hε₀ _
  have hs_x_pos : 0 < s_x := mul_pos hs_c_pos hs_v_pos
  have hlam_pos : 0 < lam_sys :=
    lt_of_lt_of_le (mul_pos (inv_pos.mpr hB_sys_pos) (Real.rpow_pos_of_pos hε₀ _)) hlam_lo
  have hσ_r_pos : 0 < σ_r := inv_pos.mpr (mul_pos hlam_pos hρ_r_pos)
  have hr_ne : r ≠ 0 := hr_pos.ne'

  have h_eps_rpow_mono : ∀ a b : ℝ, a ≤ b → ε ^ (-a) ≤ ε ^ (-b) := by
    intro a b hab
    exact Real.rpow_le_rpow_of_exponent_ge hε₀ hε_le1 (by linarith only [hab])
  have h_one_le_eps_neg : ∀ b : ℝ, 0 ≤ b → 1 ≤ ε ^ (-b) := by
    intro b hb
    have h0 := h_eps_rpow_mono 0 b hb
    simpa only [neg_zero, Real.rpow_zero] using h0

  have hρ_r_eq : ρ_r = ε ^ h * ρ_t := by
    dsimp only [ρ_r, ρ_t, r]
    rw [← Real.rpow_add hε₀]
    congr 1
    ring

  have hσ_r_ub : σ_r ≤ cls.B_sys * ε ^ h * ε ^ (r + (H_P - t) / 2) := by
    have h1 : cls.B_sys⁻¹ * ε ^ (-H_P) * ρ_r ≤ lam_sys * ρ_r :=
      mul_le_mul_of_nonneg_right hlam_lo hρ_r_pos.le
    have h2 : cls.B_sys⁻¹ * ε ^ (-H_P) * ρ_r = cls.B_sys⁻¹ * ε ^ (-(H_P + r) / 2) := by
      dsimp only [ρ_r]
      rw [mul_assoc, ← Real.rpow_add hε₀]
      congr 2
      ring
    rw [h2] at h1
    have h_lhs_pos : 0 < cls.B_sys⁻¹ * ε ^ (-(H_P + r) / 2) :=
      mul_pos (inv_pos.mpr hB_sys_pos) (Real.rpow_pos_of_pos hε₀ _)
    have h_inv : σ_r ≤ (cls.B_sys⁻¹ * ε ^ (-(H_P + r) / 2))⁻¹ :=
      (inv_le_inv₀ (mul_pos hlam_pos hρ_r_pos) h_lhs_pos).mpr h1
    have h_rhs : (cls.B_sys⁻¹ * ε ^ (-(H_P + r) / 2))⁻¹ =
        cls.B_sys * ε ^ h * ε ^ (r + (H_P - t) / 2) := by
      rw [mul_inv_rev, inv_inv, ← Real.rpow_neg hε₀.le, mul_comm _ cls.B_sys,
        mul_assoc, ← Real.rpow_add hε₀]
      congr 2
      dsimp only [r]
      ring
    exact le_trans h_inv (le_of_eq h_rhs)

  
  
  
  let pair_o : Fin N_O → (EuclideanSpace ℝ (Fin 2) → ℂ) → ℂ := fun o h_fn =>
    (ρ_t⁻¹ : ℂ) * ∫ v : EuclideanSpace ℝ (Fin 2),
      h_fn v * ψ_O o (ρ_t⁻¹ • (v - V_O o)) *
        Complex.exp (Complex.I * ((lam_sys * Φ₀ (C_t o, X_O o, v) : ℝ) : ℂ))
  let J : Fin N_O → Fin N_ret → ℂ := fun o α => pair_o o (g_at α)
  let m_set : Fin N_O → Finset (Fin N_ret) → ℝ := fun o S =>
    generalPacketObsMass ε H_P t lam_sys m_t Φ₀
      (fun v => ∑ α ∈ S, sub.c_at α * g_at α v) (r_O o) (V_O o) (X_O o) (ψ_O o)
  let m_1 : Fin N_O → Fin N_ret → ℝ := fun o α =>
    generalPacketObsMass ε H_P t lam_sys m_t Φ₀ (g_at α) (r_O o) (V_O o) (X_O o) (ψ_O o)

  have h_pair_sum : ∀ (o : Fin N_O) (S : Finset (Fin N_ret)),
      pair_o o (fun v => ∑ α ∈ S, sub.c_at α * g_at α v) =
        ∑ α ∈ S, sub.c_at α * J o α := by
    intro o S
    let G : Fin N_ret → EuclideanSpace ℝ (Fin 2) → ℂ := fun α v =>
      g_at α v * ψ_O o (ρ_t⁻¹ • (v - V_O o)) *
        Complex.exp (Complex.I * ((lam_sys * Φ₀ (C_t o, X_O o, v) : ℝ) : ℂ))
    have hG_cont : ∀ α : Fin N_ret, Continuous (G α) := by
      intro α
      have hc_aff1 : Continuous (fun v : EuclideanSpace ℝ (Fin 2) => ρ_r⁻¹ • (v - V_at α)) := by
        have h_sub_c : Continuous (fun v : EuclideanSpace ℝ (Fin 2) => v - V_at α) :=
          continuous_id'.sub continuous_const
        exact h_sub_c.const_smul ρ_r⁻¹
      have hc1 : Continuous (fun v : EuclideanSpace ℝ (Fin 2) =>
          sub.ψ_at α (ρ_r⁻¹ • (v - V_at α))) :=
        (hψ_at_cont α).comp hc_aff1
      have hc2 : Continuous (fun v : EuclideanSpace ℝ (Fin 2) => Φ₀ (C_r, X_at α, v)) :=
        hΦ_cont.comp (Continuous.prodMk continuous_const
          (Continuous.prodMk continuous_const continuous_id))
      have hc_gat : Continuous (g_at α) :=
        (continuous_const.mul (continuous_star.comp hc1)).mul
          (Complex.continuous_exp.comp (continuous_neg.comp
            (continuous_const.mul (Complex.continuous_ofReal.comp (continuous_const.mul hc2)))))
      have hc_aff3 : Continuous (fun v : EuclideanSpace ℝ (Fin 2) => ρ_t⁻¹ • (v - V_O o)) := by
        have h_sub_c : Continuous (fun v : EuclideanSpace ℝ (Fin 2) => v - V_O o) :=
          continuous_id'.sub continuous_const
        exact h_sub_c.const_smul ρ_t⁻¹
      have hc3 : Continuous (fun v : EuclideanSpace ℝ (Fin 2) =>
          ψ_O o (ρ_t⁻¹ • (v - V_O o))) :=
        (hψ_O_cont o).comp hc_aff3
      have hc4 : Continuous (fun v : EuclideanSpace ℝ (Fin 2) => Φ₀ (C_t o, X_O o, v)) :=
        hΦ_cont.comp (Continuous.prodMk continuous_const
          (Continuous.prodMk continuous_const continuous_id))
      exact (hc_gat.mul hc3).mul
        (Complex.continuous_exp.comp
          (continuous_const.mul (Complex.continuous_ofReal.comp (continuous_const.mul hc4))))
    have hG_int : ∀ α : Fin N_ret, MeasureTheory.Integrable (G α) MeasureTheory.volume := by
      intro α
      refine (hG_cont α).integrable_of_hasCompactSupport ?_
      refine HasCompactSupport.intro (isCompact_closedBall (V_O o) (cls.R_win * ρ_t)) ?_
      intro v hv
      rw [Metric.mem_closedBall, dist_eq_norm, not_le] at hv
      have h_norm : cls.R_win ≤ ‖ρ_t⁻¹ • (v - V_O o)‖ := by
        rw [norm_smul, Real.norm_of_nonneg (inv_nonneg.mpr hρ_t_pos.le)]
        have h_mul := mul_le_mul_of_nonneg_left hv.le (inv_nonneg.mpr hρ_t_pos.le)
        have h_lhs : ρ_t⁻¹ * (cls.R_win * ρ_t) = cls.R_win := by
          rw [← mul_assoc, mul_comm ρ_t⁻¹ cls.R_win, mul_assoc,
            inv_mul_cancel₀ hρ_t_pos.ne', mul_one]
        rwa [h_lhs] at h_mul
      have hψ0 : ψ_O o (ρ_t⁻¹ • (v - V_O o)) = 0 := hψ_O_supp o _ h_norm
      dsimp only [G]
      rw [hψ0]
      simp
    have h_pt : (fun v : EuclideanSpace ℝ (Fin 2) =>
        (∑ α ∈ S, sub.c_at α * g_at α v) * ψ_O o (ρ_t⁻¹ • (v - V_O o)) *
          Complex.exp (Complex.I * ((lam_sys * Φ₀ (C_t o, X_O o, v) : ℝ) : ℂ))) =
      (fun v => ∑ α ∈ S, sub.c_at α * G α v) := by
      ext v
      rw [Finset.sum_mul, Finset.sum_mul]
      refine Finset.sum_congr rfl (fun α _ => ?_)
      dsimp only [G]
      ring
    dsimp only [pair_o, J]
    rw [h_pt, MeasureTheory.integral_finsetSum S (fun α _ => (hG_int α).const_mul (sub.c_at α)),
      Finset.mul_sum]
    refine Finset.sum_congr rfl (fun α _ => ?_)
    rw [MeasureTheory.integral_const_mul]
    ring

  have hm_eq : ∀ (o : Fin N_O) (S : Finset (Fin N_ret)),
      m_set o S = ‖∑ α ∈ S, sub.c_at α * J o α‖ ^ 2 := by
    intro o S
    dsimp only [m_set, generalPacketObsMass, ρ_t, C_t]
    rw [← h_pair_sum o S]
  have hm1_eq : ∀ (o : Fin N_O) (α : Fin N_ret), m_1 o α = ‖J o α‖ ^ 2 := fun _ _ => rfl
  have hm_nn : ∀ (o : Fin N_O) (S : Finset (Fin N_ret)), 0 ≤ m_set o S :=
    fun _ _ => sq_nonneg _
  have hm1_nn : ∀ (o : Fin N_O) (α : Fin N_ret), 0 ≤ m_1 o α :=
    fun _ _ => sq_nonneg _
  have hm_singleton : ∀ (o : Fin N_O) (α : Fin N_ret),
      m_set o {α} = ‖sub.c_at α‖ ^ 2 * m_1 o α := by
    intro o α
    rw [hm_eq, Finset.sum_singleton, norm_mul, mul_pow, hm1_eq]

  have cs_add : ∀ z₁ z₂ : ℂ, ‖z₁ + z₂‖ ^ 2 ≤ 2 * ‖z₁‖ ^ 2 + 2 * ‖z₂‖ ^ 2 := by
    intro z₁ z₂
    have h1 : ‖z₁ + z₂‖ ≤ ‖z₁‖ + ‖z₂‖ := norm_add_le z₁ z₂
    have h2 : 0 ≤ (‖z₁‖ - ‖z₂‖) ^ 2 := sq_nonneg _
    nlinarith only [h1, h2, norm_nonneg (z₁ + z₂), norm_nonneg z₁, norm_nonneg z₂]
  have cs_sub : ∀ z₁ z₂ : ℂ, ‖z₁ - z₂‖ ^ 2 ≤ 2 * ‖z₁‖ ^ 2 + 2 * ‖z₂‖ ^ 2 := by
    intro z₁ z₂
    rw [sub_eq_add_neg]
    simpa only [norm_neg] using cs_add z₁ (-z₂)
  have cs_finset : ∀ {ι : Type} (A : Finset ι) (w : ι → ℂ),
      ‖∑ x ∈ A, w x‖ ^ 2 ≤ (A.card : ℝ) * ∑ x ∈ A, ‖w x‖ ^ 2 := by
    intro ι A w
    have h1 : ‖∑ x ∈ A, w x‖ ≤ ∑ x ∈ A, ‖w x‖ := norm_sum_le A w
    have h2 : 0 ≤ ∑ x ∈ A, ‖w x‖ := Finset.sum_nonneg (fun _ _ => norm_nonneg _)
    have h3 : ‖∑ x ∈ A, w x‖ ^ 2 ≤ (∑ x ∈ A, ‖w x‖) ^ 2 := by
      nlinarith only [h1, h2, norm_nonneg (∑ x ∈ A, w x)]
    exact le_trans h3 sq_sum_le_card_mul_sum_sq

  
  
  
  have h_obs_trunc : ∀ o ∈ S_obs,
      ∃ S_near : Finset (Fin N_ret),
        S_near ⊆ T_P ∧
        S_near.Nonempty ∧
        (∀ α ∈ S_near,
          ‖V_O o - V_at α‖ ≤ C_cov * ρ_t ∧
          ‖X_O o - X_at α - (C_t o - C_r) • V_at α‖ ≤ C_cov * R_tr * σ_r) ∧
        (∀ α : Fin N_ret,
          ‖V_O o - V_at α‖ ≤ C_cov * ρ_t →
          α ∉ S_near →
          m_1 o α ≤ C_far * R_tr ^ (-(2 * (M_ord : ℝ)))) ∧
        m_set o Finset.univ ≤ 4 * m_set o S_near := by
    intro o ho
    letI := Classical.propDecidable
    let S_near : Finset (Fin N_ret) := Finset.univ.filter (fun α : Fin N_ret =>
      ‖V_O o - V_at α‖ ≤ C_cov * ρ_t ∧
      ‖X_O o - X_at α - (C_t o - C_r) • V_at α‖ ≤ C_cov * R_tr * σ_r)
    obtain ⟨hr_eq, hr_lt, hCt_Cr, hVo_VJ, hXo_XJ, h_far_o⟩ := h_loc_far o ho
    obtain ⟨_, hp_buf_eq, h_buf_cell, h_floor⟩ := hS_obs o ho
    let r_loc : ℕ := r_O o % 2 ^ (m_t - m_r)
    have hCt_loc :
        (((sub.loc_idx.1 * 2 ^ (m_t - m_r) + r_loc : ℕ) : ℝ) + 1 / 2) * ((2 : ℝ) ^ m_t)⁻¹ =
          C_t o := by
      dsimp only [r_loc, C_t]
      rw [← hr_eq]
    have hVo_4B : ‖V_O o - V_J‖ ≤ 4 * cls.B_sys * s_v := by
      have h1 : s_v ≤ 4 * cls.B_sys * s_v := by nlinarith only [hB_sys2, hs_v_pos]
      exact le_trans hVo_VJ h1
    have hXo_4B :
        ‖X_O o +
          (C_r - (((sub.loc_idx.1 * 2 ^ (m_t - m_r) + r_loc : ℕ) : ℝ) + 1 / 2) * ((2 : ℝ) ^ m_t)⁻¹) •
            V_O o - X_J‖ ≤ 4 * cls.B_sys * s_x := by
      rw [hCt_loc]
      have h1 : s_x ≤ 4 * cls.B_sys * s_x := by nlinarith only [hB_sys2, hs_x_pos]
      exact le_trans hXo_XJ h1
    have h_tr_inst := h_trunc_raw r_loc hr_lt (V_O o) (X_O o) (ψ_O o)
      hVo_4B hXo_4B (hψ_O_sm o) (hψ_O_supp o) (hψ_O_der o) M_tr R_tr hM_tr hR_tr_2
    have hρ_if : (if t - 2 * h = 0 then (Real.sqrt lam_sys)⁻¹
        else ε ^ ((H_P - (t - 2 * h)) / 2)) = ρ_r := if_neg hr_ne
    have h_pair_err :
        ‖pair_o o h_sub - pair_o o (fun v => ∑ α ∈ S_near, sub.c_at α * g_at α v)‖ ≤
          (1 / 2 : ℝ) * ε ^ (A_win / 2) := by
      have h_filt_eq : ∀ (inst : DecidablePred (fun α : Fin N_ret =>
          ‖V_O o - V_at α‖ ≤ C_cov * ρ_t ∧
          ‖X_O o - X_at α - (C_t o - C_r) • V_at α‖ ≤ C_cov * R_tr * σ_r)),
          @Finset.filter (Fin N_ret) _ inst Finset.univ = S_near := by
        intro inst
        ext α
        simp only [S_near, @Finset.mem_filter, Finset.mem_univ, true_and]
      simp only [hρ_if, hCt_loc] at h_tr_inst
      change ‖pair_o o h_sub -
          pair_o o (fun v => ∑ α ∈ @Finset.filter (Fin N_ret)
            (fun α => ‖V_O o - V_at α‖ ≤ C_cov * ρ_t ∧
              ‖X_O o - X_at α - (C_t o - C_r) • V_at α‖ ≤ C_cov * R_tr * σ_r) _ Finset.univ,
            sub.c_at α * g_at α v)‖ ≤
        C_tr M_tr * R_tr ^ (1 - (M_tr : ℝ)) at h_tr_inst
      rw [h_filt_eq] at h_tr_inst
      exact le_trans h_tr_inst h_tr_tail
    
    let z_all : ℂ := pair_o o h_sub
    let z_near : ℂ := pair_o o (fun v => ∑ α ∈ S_near, sub.c_at α * g_at α v)
    have hz_all_sq : ε ^ A_win ≤ ‖z_all‖ ^ 2 := h_floor
    have he_half_pos : 0 < ε ^ (A_win / 2) := Real.rpow_pos_of_pos hε₀ _
    have he_sq_eq : (ε ^ (A_win / 2)) ^ 2 = ε ^ A_win := by
      rw [sq, ← Real.rpow_add hε₀]
      congr 1; ring
    have hz_all_lo : ε ^ (A_win / 2) ≤ ‖z_all‖ := by
      rw [← he_sq_eq] at hz_all_sq
      nlinarith only [hz_all_sq, he_half_pos, norm_nonneg z_all]
    have hz_tri : ‖z_all‖ ≤ ‖z_all - z_near‖ + ‖z_near‖ := by
      have h_id : z_all = (z_all - z_near) + z_near := (sub_add_cancel z_all z_near).symm
      conv_lhs => rw [h_id]
      exact norm_add_le _ _
    have hz_near_pos : 0 < ‖z_near‖ := by
      linarith only [hz_tri, h_pair_err, hz_all_lo, he_half_pos]
    have hz_all_le2 : ‖z_all‖ ≤ 2 * ‖z_near‖ := by
      linarith only [hz_tri, h_pair_err, hz_all_lo]
    have hm_quad : m_set o Finset.univ ≤ 4 * m_set o S_near := by
      have h_univ_eq : m_set o Finset.univ = ‖z_all‖ ^ 2 := rfl
      have h_near_eq : m_set o S_near = ‖z_near‖ ^ 2 := rfl
      rw [h_univ_eq, h_near_eq]
      nlinarith only [hz_all_le2, norm_nonneg z_all, norm_nonneg z_near]
    have hS_ne : S_near.Nonempty := by
      rw [Finset.nonempty_iff_ne_empty]
      intro h_emp
      have hz0 : z_near = 0 := by
        dsimp only [z_near]
        rw [h_pair_sum o S_near, h_emp, Finset.sum_empty]
      rw [hz0, norm_zero] at hz_near_pos
      exact lt_irrefl 0 hz_near_pos
    
    have h_out_far : ∀ α : Fin N_ret,
        ‖V_O o - V_at α‖ ≤ C_cov * ρ_t → α ∉ S_near →
        m_1 o α ≤ C_far * R_tr ^ (-(2 * (M_ord : ℝ))) := by
      intro α hV_in hα_out
      have hX_gt : C_cov * R_tr * σ_r < ‖X_O o - X_at α - (C_t o - C_r) • V_at α‖ := by
        by_contra h_le
        rw [not_lt] at h_le
        apply hα_out
        exact Finset.mem_filter.mpr ⟨Finset.mem_univ α, hV_in, h_le⟩
      have hR_sig_le : R_tr * σ_r ≤ C_cov * R_tr * σ_r := by
        have h_pos : 0 ≤ R_tr * σ_r := mul_nonneg hR_tr_pos.le hσ_r_pos.le
        nlinarith only [hC_cov, h_pos]
      exact h_far_o α (le_trans hR_sig_le hX_gt.le)
    
    have hqr_div : r_O o / 2 ^ (m_t - m_r) = q_r := by
      have h_add : r_O o = r_loc + q_r * 2 ^ (m_t - m_r) := by
        dsimp only [q_r, r_loc]
        linarith only [hr_eq]
      rw [h_add, Nat.add_mul_div_right _ _ (Nat.two_pow_pos (m_t - m_r)),
        Nat.div_eq_of_lt hr_lt, zero_add]
    have hS_sub_TP : S_near ⊆ T_P := by
      intro α hα
      obtain ⟨_, hV_in, hX_in⟩ := Finset.mem_filter.mp hα
      have h_v_buf : ‖V_at α - V_O o‖ ≤ ((M_L : ℝ) / 32) * ε ^ ((H_P - t) / 2) := by
        rw [norm_sub_rev]
        have h_coef : C_cov ≤ (M_L : ℝ) / 32 := by
          nlinarith only [hC_cov, hB_sys2, hML_bound]
        exact le_trans hV_in (mul_le_mul_of_nonneg_right h_coef hρ_t_pos.le)
      have h_x_buf :
          ‖X_at α - (X_O o + ((((r_O o / 2 ^ (m_t - m_r) : ℕ) : ℝ) + 1 / 2) * s_c - C_t o) •
            V_O o)‖ ≤ ((M_L : ℝ) / 32) * ε ^ (r + (H_P - t) / 2) := by
        rw [hqr_div]
        change ‖X_at α - (X_O o + (C_r - C_t o) • V_O o)‖ ≤
          ((M_L : ℝ) / 32) * ε ^ (r + (H_P - t) / 2)
        let Δ_buf : ℝ := ε ^ (r + (H_P - t) / 2)
        have hΔ_pos : 0 < Δ_buf := Real.rpow_pos_of_pos hε₀ _
        have h_er_rhot : ε ^ r * ρ_t = Δ_buf := by
          dsimp only [ρ_t, Δ_buf]
          exact (Real.rpow_add hε₀ r ((H_P - t) / 2)).symm
        have hCt_er : |C_t o - C_r| ≤ ε ^ r := by
          linarith only [hCt_Cr, hs_c_hi]
        have h_vec_id : X_at α - (X_O o + (C_r - C_t o) • V_O o) =
            -(X_O o - X_at α - (C_t o - C_r) • V_at α) +
              (C_t o - C_r) • (V_O o - V_at α) := by
          ext i
          simp only [PiLp.add_apply, PiLp.sub_apply, PiLp.neg_apply, PiLp.smul_apply,
            smul_eq_mul]
          ring
        have h_tri : ‖X_at α - (X_O o + (C_r - C_t o) • V_O o)‖ ≤
            ‖X_O o - X_at α - (C_t o - C_r) • V_at α‖ +
              |C_t o - C_r| * ‖V_O o - V_at α‖ := by
          rw [h_vec_id]
          calc ‖-(X_O o - X_at α - (C_t o - C_r) • V_at α) + (C_t o - C_r) • (V_O o - V_at α)‖
              ≤ ‖-(X_O o - X_at α - (C_t o - C_r) • V_at α)‖ +
                  ‖(C_t o - C_r) • (V_O o - V_at α)‖ := norm_add_le _ _
            _ = ‖X_O o - X_at α - (C_t o - C_r) • V_at α‖ +
                  |C_t o - C_r| * ‖V_O o - V_at α‖ := by
                rw [norm_neg, norm_smul, Real.norm_eq_abs]
        have h_term1 : C_cov * R_tr * σ_r ≤ C_cov * cls.B_sys * Δ_buf := by
          have h1 : C_cov * R_tr * σ_r ≤
              C_cov * R_tr * (cls.B_sys * ε ^ h * Δ_buf) :=
            mul_le_mul_of_nonneg_left hσ_r_ub (mul_nonneg hC_cov_pos.le hR_tr_pos.le)
          have h2 : C_cov * R_tr * (cls.B_sys * ε ^ h * Δ_buf) =
              (C_cov * cls.B_sys * Δ_buf) * (R_tr * ε ^ h) := by ring
          rw [h2] at h1
          have h3 : (C_cov * cls.B_sys * Δ_buf) * (R_tr * ε ^ h) ≤
              (C_cov * cls.B_sys * Δ_buf) * 1 :=
            mul_le_mul_of_nonneg_left hR_tr_eh
              (mul_nonneg (mul_nonneg hC_cov_pos.le hB_sys_pos.le) hΔ_pos.le)
          linarith only [h1, h3]
        have h_term2 : |C_t o - C_r| * ‖V_O o - V_at α‖ ≤ C_cov * cls.B_sys * Δ_buf := by
          have h1 : |C_t o - C_r| * ‖V_O o - V_at α‖ ≤ ε ^ r * (C_cov * ρ_t) :=
            mul_le_mul hCt_er hV_in (norm_nonneg _) (Real.rpow_nonneg hε₀.le r)
          have h2 : ε ^ r * (C_cov * ρ_t) = C_cov * (ε ^ r * ρ_t) := by ring
          rw [h2, h_er_rhot] at h1
          have h3 : C_cov * Δ_buf ≤ C_cov * cls.B_sys * Δ_buf := by
            have hc : C_cov ≤ C_cov * cls.B_sys := by nlinarith only [hC_cov_pos, hB_sys2]
            exact mul_le_mul_of_nonneg_right hc hΔ_pos.le
          exact le_trans h1 h3
        have h_2CB : 2 * (C_cov * cls.B_sys * Δ_buf) ≤ ((M_L : ℝ) / 32) * Δ_buf := by
          have h_coef : 2 * C_cov * cls.B_sys ≤ (M_L : ℝ) / 32 := by
            linarith only [hML_bound]
          have h_mul := mul_le_mul_of_nonneg_right h_coef hΔ_pos.le
          linarith only [h_mul]
        linarith only [h_tri, hX_in, h_term1, h_term2, h_2CB]
      have h_cell_eq := h_buf_cell (V_at α) (X_at α) h_v_buf h_x_buf
      rw [hqr_div] at h_cell_eq
      exact (hT_P α).mp (h_cell_eq.symm.trans hp_buf_eq)
    exact ⟨S_near, hS_sub_TP, hS_ne,
      fun α hα => (Finset.mem_filter.mp hα).2,
      h_out_far, hm_quad⟩

  
  refine ⟨?_, ?_⟩
  · intro ⟨o₀, ho₀⟩
    obtain ⟨S_near, hS_sub, hS_ne, _, _, _⟩ := h_obs_trunc o₀ ho₀
    exact hS_ne.mono hS_sub

  
  
  
  · let ell : ℝ := Real.log (ε⁻¹)
    have h2_lt_inv : (2 : ℝ) < ε⁻¹ := by
      have h1 : 2 * ε < 1 := by linarith only [hε₁]
      have hm := mul_lt_mul_of_pos_right h1 (inv_pos.mpr hε₀)
      rw [mul_assoc, mul_inv_cancel₀ hε₀.ne', mul_one, one_mul] at hm
      exact hm
    have hlog2_pos : 0 < Real.log 2 := Real.log_pos (by norm_num)
    have hell_pos : 0 < ell := Real.log_pos (by linarith only [h2_lt_inv])

    have h_dyad_step : ∀ a : ℝ, 0 ≤ a →
        let m : ℕ := Nat.floor (a * ell / Real.log 2)
        (2 : ℝ) ^ m ≤ ε ^ (-a) ∧ ((2 : ℝ) ^ m)⁻¹ ≤ 2 * ε ^ a := by
      intro a ha m
      have h_nn : 0 ≤ a * ell / Real.log 2 :=
        div_nonneg (mul_nonneg ha hell_pos.le) hlog2_pos.le
      have hm_lo : (m : ℝ) * Real.log 2 ≤ a * ell :=
        (le_div_iff₀ hlog2_pos).mp (Nat.floor_le h_nn)
      have hm_hi : a * ell < ((m : ℝ) + 1) * Real.log 2 :=
        (div_lt_iff₀ hlog2_pos).mp (Nat.lt_floor_add_one _)
      have hexp_2m : Real.exp ((m : ℝ) * Real.log 2) = (2 : ℝ) ^ m := by
        rw [mul_comm, ← Real.rpow_def_of_pos (by norm_num : (0 : ℝ) < 2), Real.rpow_natCast]
      have hexp_ea : Real.exp (a * ell) = ε ^ (-a) := by
        dsimp only [ell]
        rw [Real.log_inv, Real.rpow_def_of_pos hε₀]
        congr 1
        ring
      have h2m_le : (2 : ℝ) ^ m ≤ ε ^ (-a) := by
        rw [← hexp_2m, ← hexp_ea]
        exact Real.exp_le_exp.mpr hm_lo
      have hea_le : ε ^ (-a) ≤ 2 * (2 : ℝ) ^ m := by
        rw [← hexp_ea]
        have h_rhs : 2 * (2 : ℝ) ^ m = Real.exp (((m : ℝ) + 1) * Real.log 2) := by
          rw [add_mul, one_mul, Real.exp_add, hexp_2m,
            Real.exp_log (by norm_num : (0 : ℝ) < 2), mul_comm]
        rw [h_rhs]
        exact (Real.exp_lt_exp.mpr hm_hi).le
      have h2m_inv : ((2 : ℝ) ^ m)⁻¹ ≤ 2 * ε ^ a := by
        have hea_pos : 0 < ε ^ (-a) := Real.rpow_pos_of_pos hε₀ _
        have h2m_pos : 0 < (2 : ℝ) ^ m := pow_pos (by norm_num : (0 : ℝ) < 2) m
        have h_inv := (inv_le_inv₀ (by positivity) hea_pos).mpr hea_le
        rw [← Real.rpow_neg hε₀.le, neg_neg, mul_inv_rev] at h_inv
        have h_mul := mul_le_mul_of_nonneg_right h_inv (by norm_num : (0 : ℝ) ≤ 2)
        rw [mul_assoc, inv_mul_cancel₀ (by norm_num : (2 : ℝ) ≠ 0), mul_one,
          mul_comm (ε ^ a) 2] at h_mul
        exact h_mul
      exact ⟨h2m_le, h2m_inv⟩

    let m₁ : ℕ := Nat.floor ((h / 2) * ell / Real.log 2)
    let m₂ : ℕ := Nat.floor (((3 / 4 : ℝ) * h) * ell / Real.log 2)
    have hm12 : m₁ ≤ m₂ := by
      refine Nat.floor_mono ?_
      refine div_le_div_of_nonneg_right ?_ hlog2_pos.le
      exact mul_le_mul_of_nonneg_right (by linarith only [hh]) hell_pos.le
    obtain ⟨h2m1_hi, h2m1_inv_hi⟩ := h_dyad_step (h / 2) (by linarith only [hh])
    obtain ⟨h2m2_hi, h2m2_inv_hi⟩ := h_dyad_step ((3 / 4 : ℝ) * h) (by linarith only [hh])

    let s₁ : ℝ := ((2 : ℝ) ^ m₁)⁻¹ * ρ_t
    let s₂ : ℝ := ((2 : ℝ) ^ m₂)⁻¹ * ρ_t
    let K : ℤ := ((2 ^ (m₂ - m₁) : ℕ) : ℤ)
    let R_disk : ℝ := C_cov * ρ_t

    have hs₁_pos : 0 < s₁ :=
      mul_pos (inv_pos.mpr (pow_pos (by norm_num : (0 : ℝ) < 2) m₁)) hρ_t_pos
    have hs₂_pos : 0 < s₂ :=
      mul_pos (inv_pos.mpr (pow_pos (by norm_num : (0 : ℝ) < 2) m₂)) hρ_t_pos
    have hR_disk_pos : 0 < R_disk := mul_pos hC_cov_pos hρ_t_pos
    have hs₂_le_s₁ : s₂ ≤ s₁ := by
      have h_pow : (2 : ℝ) ^ m₁ ≤ (2 : ℝ) ^ m₂ := by
        exact_mod_cast Nat.pow_le_pow_right (by omega : 1 ≤ 2) hm12
      have h_inv : ((2 : ℝ) ^ m₂)⁻¹ ≤ ((2 : ℝ) ^ m₁)⁻¹ :=
        (inv_le_inv₀ (pow_pos (by norm_num) m₂) (pow_pos (by norm_num) m₁)).mpr h_pow
      exact mul_le_mul_of_nonneg_right h_inv hρ_t_pos.le
    have h4s₁_le_half : 4 * s₁ ≤ R_disk / 2 := by
      have h1 : 4 * s₁ ≤ 8 * ε ^ (h / 2) * ρ_t := by
        dsimp only [s₁]
        have hm := mul_le_mul_of_nonneg_right h2m1_inv_hi hρ_t_pos.le
        linarith only [hm]
      have h2 : 8 * ε ^ (h / 2) * ρ_t ≤ 1 * ρ_t :=
        mul_le_mul_of_nonneg_right h_eh_small hρ_t_pos.le
      have h3 : 1 * ρ_t ≤ R_disk / 2 := by
        dsimp only [R_disk]
        nlinarith only [hC_cov, hρ_t_pos]
      linarith only [h1, h2, h3]
    have h4s₂_le_half : 4 * s₂ ≤ R_disk / 2 :=
      le_trans (by linarith only [hs₂_le_s₁]) h4s₁_le_half

    
    let g₁ : Fin N_ret → ℤ × ℤ := fun α => roundShift2D s₁ 0 (V_at α)
    let g₂ : Fin N_ret → ℤ × ℤ := fun α => roundShift2D s₂ 0 (V_at α)
    let K₁ : Finset (ℤ × ℤ) := T_P.image g₁
    let K₂ : Finset (ℤ × ℤ) := T_P.image g₂
    let F₁ : (ℤ × ℤ) → Finset (Fin N_ret) := fun k₁ => T_P.filter (fun α => g₁ α = k₁)
    let F₂ : (ℤ × ℤ) → Finset (Fin N_ret) := fun k₂ => T_P.filter (fun α => g₂ α = k₂)

    have hF₁_disj : ∀ k₁ ∈ K₁, ∀ k₁' ∈ K₁, k₁ ≠ k₁' → Disjoint (F₁ k₁) (F₁ k₁') := by
      intro k₁ _ k₁' _ hne
      rw [Finset.disjoint_left]
      intro α hα₁ hα₂
      exact hne ((Finset.mem_filter.mp hα₁).2.symm.trans (Finset.mem_filter.mp hα₂).2)
    have hF₂_disj : ∀ k₂ ∈ K₂, ∀ k₂' ∈ K₂, k₂ ≠ k₂' → Disjoint (F₂ k₂) (F₂ k₂') := by
      intro k₂ _ k₂' _ hne
      rw [Finset.disjoint_left]
      intro α hα₁ hα₂
      exact hne ((Finset.mem_filter.mp hα₁).2.symm.trans (Finset.mem_filter.mp hα₂).2)
    have hF₁_union : K₁.biUnion F₁ = T_P := by
      ext α
      simp only [K₁, F₁, Finset.mem_biUnion, Finset.mem_image, Finset.mem_filter]
      constructor
      · rintro ⟨_, _, hα, _⟩; exact hα
      · intro hα; exact ⟨g₁ α, ⟨α, hα, rfl⟩, hα, rfl⟩
    have hF₂_union : K₂.biUnion F₂ = T_P := by
      ext α
      simp only [K₂, F₂, Finset.mem_biUnion, Finset.mem_image, Finset.mem_filter]
      constructor
      · rintro ⟨_, _, hα, _⟩; exact hα
      · intro hα; exact ⟨g₂ α, ⟨α, hα, rfl⟩, hα, rfl⟩

    obtain ⟨h_diam, h_dyad_nest, h_ball_cnt, h_ann_cnt⟩ := h_grid
    obtain ⟨h_nest_div, h_nest_dist⟩ := h_dyad_nest m₁ m₂ ρ_t hm12 hρ_t_pos

    
    
    
    let w_max : ℝ := ε ^ (-ξ) * sub.m_bin
    let E_far : ℝ := C_far * R_tr ^ (-(2 * (M_ord : ℝ)))
    have hw_max_pos : 0 < w_max := mul_pos (Real.rpow_pos_of_pos hε₀ _) hm_bin_pos
    have hE_far_nn : 0 ≤ E_far := mul_nonneg hC_far (Real.rpow_nonneg hR_tr_pos.le _)

    have h_pt_obs : ∀ o ∈ S_obs,
        m_set o Finset.univ ≤
          (512 * C_cov ^ 2 * ε ^ (-h)) * (∑ k₁ ∈ K₁, m_set o (F₁ k₁)) +
          (13312 * C_cov * ε ^ (-h)) * (∑ k₂ ∈ K₂, m_set o (F₂ k₂)) +
          (29952 * C_cov ^ 3 * (M_mult : ℝ) * R_tr ^ 2 * ε ^ (-(5 / 4 : ℝ) * h)) *
            (∑ α ∈ T_P, m_set o {α}) +
          16 * (N_ret : ℝ) * E_far * w_max * (T_P.card : ℝ) := by
      intro o ho
      obtain ⟨S_near, hS_sub_TP, _, hS_in_near, h_out_far, hm_quad⟩ := h_obs_trunc o ho
      let I₁ : Finset (ℤ × ℤ) :=
        @Finset.filter (ℤ × ℤ) (fun k₁ => ‖gridPt2D s₁ k₁ - V_O o‖ ≤ R_disk - 2 * s₁)
          (fun _ => Classical.propDecidable _) K₁
      let I₂ : Finset (ℤ × ℤ) :=
        @Finset.filter (ℤ × ℤ)
          (fun k₂ => (k₂.1 / K, k₂.2 / K) ∉ I₁ ∧ ‖gridPt2D s₂ k₂ - V_O o‖ ≤ R_disk - 2 * s₂)
          (fun _ => Classical.propDecidable _) K₂
      have h_mem_I₁ : ∀ k₁ : ℤ × ℤ,
          k₁ ∈ I₁ ↔ k₁ ∈ K₁ ∧ ‖gridPt2D s₁ k₁ - V_O o‖ ≤ R_disk - 2 * s₁ :=
        fun k₁ => @Finset.mem_filter _ _ (fun _ => Classical.propDecidable _) _ _
      have h_mem_I₂ : ∀ k₂ : ℤ × ℤ,
          k₂ ∈ I₂ ↔ k₂ ∈ K₂ ∧ (k₂.1 / K, k₂.2 / K) ∉ I₁ ∧
            ‖gridPt2D s₂ k₂ - V_O o‖ ≤ R_disk - 2 * s₂ :=
        fun k₂ => @Finset.mem_filter _ _ (fun _ => Classical.propDecidable _) _ _
      have h_mem_F₁ : ∀ (k₁ : ℤ × ℤ) (α : Fin N_ret),
          α ∈ F₁ k₁ ↔ α ∈ T_P ∧ g₁ α = k₁ := fun _ _ => Finset.mem_filter
      have h_mem_F₂ : ∀ (k₂ : ℤ × ℤ) (α : Fin N_ret),
          α ∈ F₂ k₂ ↔ α ∈ T_P ∧ g₂ α = k₂ := fun _ _ => Finset.mem_filter
      let U₁ : Finset (Fin N_ret) := I₁.biUnion F₁
      let U₂ : Finset (Fin N_ret) := I₂.biUnion F₂
      let U_in : Finset (Fin N_ret) := U₁ ∪ U₂
      let S_core : Finset (Fin N_ret) := S_near ∩ U_in
      let S_bdry : Finset (Fin N_ret) := S_near \ U_in
      let S_farX : Finset (Fin N_ret) := U_in \ S_near

      have hI₁_sub : I₁ ⊆ K₁ := fun k₁ hk₁ => ((h_mem_I₁ k₁).mp hk₁).1
      have hI₂_sub : I₂ ⊆ K₂ := fun k₂ hk₂ => ((h_mem_I₂ k₂).mp hk₂).1
      have hU₁_sub : U₁ ⊆ T_P := by
        rw [← hF₁_union]
        intro α hα
        obtain ⟨k, hk, hαF⟩ := Finset.mem_biUnion.mp hα
        exact Finset.mem_biUnion.mpr ⟨k, hI₁_sub hk, hαF⟩
      have hU₂_sub : U₂ ⊆ T_P := by
        rw [← hF₂_union]
        intro α hα
        obtain ⟨k, hk, hαF⟩ := Finset.mem_biUnion.mp hα
        exact Finset.mem_biUnion.mpr ⟨k, hI₂_sub hk, hαF⟩
      have hU_in_sub : U_in ⊆ T_P := Finset.union_subset hU₁_sub hU₂_sub
      have hS_bdry_sub : S_bdry ⊆ T_P := Finset.sdiff_subset.trans hS_sub_TP
      have hS_farX_sub : S_farX ⊆ T_P := Finset.sdiff_subset.trans hU_in_sub

      
      have hU_disj : Disjoint U₁ U₂ := by
        rw [Finset.disjoint_left]
        intro α hα₁ hα₂
        obtain ⟨k₁, hk₁, hαF₁⟩ := Finset.mem_biUnion.mp hα₁
        obtain ⟨k₂, hk₂, hαF₂⟩ := Finset.mem_biUnion.mp hα₂
        have hg₁_eq : g₁ α = k₁ := ((h_mem_F₁ k₁ α).mp hαF₁).2
        have hg₂_eq : g₂ α = k₂ := ((h_mem_F₂ k₂ α).mp hαF₂).2
        have h_div : (k₂.1 / K, k₂.2 / K) = k₁ := by
          rw [← hg₁_eq, ← hg₂_eq]
          exact (h_nest_div (V_at α)).symm
        have hk₂_not : (k₂.1 / K, k₂.2 / K) ∉ I₁ := ((h_mem_I₂ k₂).mp hk₂).2.1
        exact hk₂_not (h_div.symm ▸ hk₁)

      
      have hU_in_disk : ∀ α ∈ U_in, ‖V_O o - V_at α‖ ≤ C_cov * ρ_t := by
        intro α hα
        rcases Finset.mem_union.mp hα with hα₁ | hα₂
        · obtain ⟨k₁, hk₁, hαF₁⟩ := Finset.mem_biUnion.mp hα₁
          have hg₁_eq : g₁ α = k₁ := ((h_mem_F₁ k₁ α).mp hαF₁).2
          have hk₁_bd : ‖gridPt2D s₁ k₁ - V_O o‖ ≤ R_disk - 2 * s₁ :=
            ((h_mem_I₁ k₁).mp hk₁).2
          have h_err : ‖V_at α - gridPt2D s₁ k₁‖ ≤ 2 * s₁ := by
            rw [← hg₁_eq]
            exact h_diam s₁ (V_at α) hs₁_pos
          rw [norm_sub_rev]
          have h_id : V_at α - V_O o = (V_at α - gridPt2D s₁ k₁) + (gridPt2D s₁ k₁ - V_O o) :=
            (sub_add_sub_cancel _ _ _).symm
          rw [h_id]
          calc ‖(V_at α - gridPt2D s₁ k₁) + (gridPt2D s₁ k₁ - V_O o)‖
              ≤ ‖V_at α - gridPt2D s₁ k₁‖ + ‖gridPt2D s₁ k₁ - V_O o‖ := norm_add_le _ _
            _ ≤ 2 * s₁ + (R_disk - 2 * s₁) := add_le_add h_err hk₁_bd
            _ = C_cov * ρ_t := by dsimp only [R_disk]; ring
        · obtain ⟨k₂, hk₂, hαF₂⟩ := Finset.mem_biUnion.mp hα₂
          have hg₂_eq : g₂ α = k₂ := ((h_mem_F₂ k₂ α).mp hαF₂).2
          have hk₂_bd : ‖gridPt2D s₂ k₂ - V_O o‖ ≤ R_disk - 2 * s₂ :=
            ((h_mem_I₂ k₂).mp hk₂).2.2
          have h_err : ‖V_at α - gridPt2D s₂ k₂‖ ≤ 2 * s₂ := by
            rw [← hg₂_eq]
            exact h_diam s₂ (V_at α) hs₂_pos
          rw [norm_sub_rev]
          have h_id : V_at α - V_O o = (V_at α - gridPt2D s₂ k₂) + (gridPt2D s₂ k₂ - V_O o) :=
            (sub_add_sub_cancel _ _ _).symm
          rw [h_id]
          calc ‖(V_at α - gridPt2D s₂ k₂) + (gridPt2D s₂ k₂ - V_O o)‖
              ≤ ‖V_at α - gridPt2D s₂ k₂‖ + ‖gridPt2D s₂ k₂ - V_O o‖ := norm_add_le _ _
            _ ≤ 2 * s₂ + (R_disk - 2 * s₂) := add_le_add h_err hk₂_bd
            _ = C_cov * ρ_t := by dsimp only [R_disk]; ring

      
      have hI₁_card : (I₁.card : ℝ) ≤ 16 * C_cov ^ 2 * ε ^ (-h) := by
        have h_in_ball : ∀ k₁ ∈ I₁, ‖gridPt2D s₁ k₁ - V_O o‖ ≤ R_disk := by
          intro k₁ hk₁
          have h1 := ((h_mem_I₁ k₁).mp hk₁).2
          linarith only [h1, hs₁_pos]
        have h_cnt := h_ball_cnt s₁ R_disk (V_O o) I₁ hs₁_pos hR_disk_pos.le h_in_ball
        have h_div : R_disk / s₁ = C_cov * (2 : ℝ) ^ m₁ := by
          dsimp only [R_disk, s₁]
          have hρ_ne : ρ_t ≠ 0 := hρ_t_pos.ne'
          have h2_ne : (2 : ℝ) ^ m₁ ≠ 0 := (pow_pos (by norm_num : (0 : ℝ) < 2) m₁).ne'
          field_simp [hρ_ne, h2_ne]
        rw [h_div] at h_cnt
        have h_one_eh2 : 1 ≤ ε ^ (-(h / 2)) := h_one_le_eps_neg (h / 2) (by linarith only [hh])
        have h_lin : 2 * (C_cov * (2 : ℝ) ^ m₁) + 3 ≤ 4 * C_cov * ε ^ (-(h / 2)) := by
          have h1 : C_cov * (2 : ℝ) ^ m₁ ≤ C_cov * ε ^ (-(h / 2)) :=
            mul_le_mul_of_nonneg_left h2m1_hi hC_cov_pos.le
          nlinarith only [h1, hC_cov, h_one_eh2]
        have h_nn : 0 ≤ 2 * (C_cov * (2 : ℝ) ^ m₁) + 3 := by positivity
        have h_sq : (2 * (C_cov * (2 : ℝ) ^ m₁) + 3) ^ 2 ≤ (4 * C_cov * ε ^ (-(h / 2))) ^ 2 := by
          nlinarith only [h_lin, h_nn]
        have h_rhs : (4 * C_cov * ε ^ (-(h / 2))) ^ 2 = 16 * C_cov ^ 2 * ε ^ (-h) := by
          have hexp : ε ^ (-(h / 2)) * ε ^ (-(h / 2)) = ε ^ (-h) := by
            rw [← Real.rpow_add hε₀]
            congr 1; ring
          calc (4 * C_cov * ε ^ (-(h / 2))) ^ 2
              = 16 * C_cov ^ 2 * (ε ^ (-(h / 2)) * ε ^ (-(h / 2))) := by ring
            _ = 16 * C_cov ^ 2 * ε ^ (-h) := by rw [hexp]
        exact le_trans h_cnt (h_rhs ▸ h_sq)

      
      have hI₂_card : (I₂.card : ℝ) ≤ 416 * C_cov * ε ^ (-h) := by
        have h_in_ann : ∀ k₂ ∈ I₂,
            R_disk - 4 * s₁ ≤ ‖gridPt2D s₂ k₂ - V_O o‖ ∧
              ‖gridPt2D s₂ k₂ - V_O o‖ ≤ R_disk := by
          intro k₂ hk₂
          obtain ⟨hk₂_K₂, hk₁_not, hk₂_hi⟩ := (h_mem_I₂ k₂).mp hk₂
          dsimp only [K₂] at hk₂_K₂
          obtain ⟨α, hα_TP, hg₂_eq⟩ := Finset.mem_image.mp hk₂_K₂
          let k₁ : ℤ × ℤ := (k₂.1 / K, k₂.2 / K)
          have hk₁_K₁ : k₁ ∈ K₁ := by
            dsimp only [K₁]
            refine Finset.mem_image.mpr ⟨α, hα_TP, ?_⟩
            dsimp only [g₁, k₁]
            rw [← hg₂_eq]
            exact h_nest_div (V_at α)
          have hk₁_gt : R_disk - 2 * s₁ < ‖gridPt2D s₁ k₁ - V_O o‖ := by
            by_contra h_le
            rw [not_lt] at h_le
            exact hk₁_not ((h_mem_I₁ k₁).mpr ⟨hk₁_K₁, h_le⟩)
          have h_step_err : ‖gridPt2D s₂ k₂ - gridPt2D s₁ k₁‖ ≤ 2 * s₁ := h_nest_dist k₂
          have h_tri : ‖gridPt2D s₁ k₁ - V_O o‖ ≤
              2 * s₁ + ‖gridPt2D s₂ k₂ - V_O o‖ := by
            have h_id : gridPt2D s₁ k₁ - V_O o =
                (gridPt2D s₁ k₁ - gridPt2D s₂ k₂) + (gridPt2D s₂ k₂ - V_O o) :=
              (sub_add_sub_cancel _ _ _).symm
            rw [h_id]
            calc ‖(gridPt2D s₁ k₁ - gridPt2D s₂ k₂) + (gridPt2D s₂ k₂ - V_O o)‖
                ≤ ‖gridPt2D s₁ k₁ - gridPt2D s₂ k₂‖ + ‖gridPt2D s₂ k₂ - V_O o‖ :=
                  norm_add_le _ _
              _ = ‖gridPt2D s₂ k₂ - gridPt2D s₁ k₁‖ + ‖gridPt2D s₂ k₂ - V_O o‖ := by
                  rw [norm_sub_rev]
              _ ≤ 2 * s₁ + ‖gridPt2D s₂ k₂ - V_O o‖ := add_le_add h_step_err le_rfl
          exact ⟨by linarith only [hk₁_gt, h_tri], by linarith only [hk₂_hi, hs₂_pos]⟩
        have h_cnt := h_ann_cnt s₂ R_disk (4 * s₁) (V_O o) I₂ hs₂_pos hR_disk_pos
          (by positivity) h4s₁_le_half h_in_ann
        have h_divR : R_disk / s₂ = C_cov * (2 : ℝ) ^ m₂ := by
          dsimp only [R_disk, s₂]
          have hρ_ne : ρ_t ≠ 0 := hρ_t_pos.ne'
          have h2_ne : (2 : ℝ) ^ m₂ ≠ 0 := (pow_pos (by norm_num : (0 : ℝ) < 2) m₂).ne'
          field_simp [hρ_ne, h2_ne]
        have h_divD : (4 * s₁) / s₂ = 4 * ((2 : ℝ) ^ m₁)⁻¹ * (2 : ℝ) ^ m₂ := by
          dsimp only [s₁, s₂]
          have hρ_ne : ρ_t ≠ 0 := hρ_t_pos.ne'
          have h2_ne : (2 : ℝ) ^ m₂ ≠ 0 := (pow_pos (by norm_num : (0 : ℝ) < 2) m₂).ne'
          field_simp [hρ_ne, h2_ne]
        rw [h_divR, h_divD] at h_cnt
        have h_f1 : 2 * (C_cov * (2 : ℝ) ^ m₂) + 3 ≤
            4 * C_cov * ε ^ (-((3 / 4 : ℝ) * h)) := by
          have h1 : C_cov * (2 : ℝ) ^ m₂ ≤ C_cov * ε ^ (-((3 / 4 : ℝ) * h)) :=
            mul_le_mul_of_nonneg_left h2m2_hi hC_cov_pos.le
          have h_one := h_one_le_eps_neg ((3 / 4 : ℝ) * h) (by linarith only [hh])
          nlinarith only [h1, hC_cov, h_one]
        have h_f2 : 6 * (4 * ((2 : ℝ) ^ m₁)⁻¹ * (2 : ℝ) ^ m₂) + 4 ≤
            52 * ε ^ (-(h / 4)) := by
          have h1 : ((2 : ℝ) ^ m₁)⁻¹ * (2 : ℝ) ^ m₂ ≤
              (2 * ε ^ (h / 2)) * ε ^ (-((3 / 4 : ℝ) * h)) :=
            mul_le_mul h2m1_inv_hi h2m2_hi (by positivity) (by positivity)
          have h2 : (2 * ε ^ (h / 2)) * ε ^ (-((3 / 4 : ℝ) * h)) = 2 * ε ^ (-(h / 4)) := by
            rw [mul_assoc, ← Real.rpow_add hε₀]
            congr 2; ring
          rw [h2] at h1
          have h_one := h_one_le_eps_neg (h / 4) (by linarith only [hh])
          linarith only [h1, h_one]
        have h_prod : 2 * (2 * (C_cov * (2 : ℝ) ^ m₂) + 3) *
              (6 * (4 * ((2 : ℝ) ^ m₁)⁻¹ * (2 : ℝ) ^ m₂) + 4) ≤
            2 * (4 * C_cov * ε ^ (-((3 / 4 : ℝ) * h))) * (52 * ε ^ (-(h / 4))) := by
          have h_nn1 : 0 ≤ 2 * (C_cov * (2 : ℝ) ^ m₂) + 3 := by positivity
          have h_nn2 : 0 ≤ 6 * (4 * ((2 : ℝ) ^ m₁)⁻¹ * (2 : ℝ) ^ m₂) + 4 := by positivity
          have h_nn3 : 0 ≤ 4 * C_cov * ε ^ (-((3 / 4 : ℝ) * h)) :=
            mul_nonneg (by positivity) (Real.rpow_nonneg hε₀.le _)
