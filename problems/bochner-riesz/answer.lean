                  (if J_fn ω = j then π ω else 0) *
                    condSurprise ε (π_j_fn j) (fun _ => ()) (G_loc j) ω := Finset.sum_comm
            _ = ∑ ω : Fin N_ω, π ω *
                  condSurprise ε (π_j_fn (J_fn ω)) (fun _ => ()) (G_loc (J_fn ω)) ω := by
                  refine Finset.sum_congr rfl (fun ω _ =>
                    hω_sum_SJ (fun j => condSurprise ε (π_j_fn j) (fun _ => ()) (G_loc j) ω) ω)
