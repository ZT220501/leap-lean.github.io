      let h0 := M 0
      let h1 := M 1 + D' 1 * h0
      let h2 := M 2 + 2 * D' 1 * h1 + D' 2 * h0
      let h3 := M 3 + 3 * D' 1 * h2 + 3 * D' 2 * h1 + D' 3 * h0
      let h4 := M 4 + 4 * D' 1 * h3 + 6 * D' 2 * h2 + 4 * D' 3 * h1 + D' 4 * h0
