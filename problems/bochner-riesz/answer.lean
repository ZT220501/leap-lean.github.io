      linarith
    have hm₁_eq : (m₁ - 1) + 1 = m₁ := Nat.sub_add_cancel hm₁_pos
    have h_pow_m₁_lt : ((2 ^ m₁ : ℕ) : ℝ) < 2 * ε⁻¹ := by
      have h_split : (2 ^ m₁ : ℕ) = 2 ^ (m₁ - 1) * 2 := by
