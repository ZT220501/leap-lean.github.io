        m_r m_t q_r hmr_le_mt hqr_lt ε H_P t r b_star s_v lam_sys
        hε_pos hs_v_pos hs_v_le1 rfl hlam_pos V_J X_J h_sub hh_meas hh_l2
    have hh'_int_pos : 0 < ∫ v', ‖h'_sub v'‖ ^ 2 := by
      change 0 < ∫ v', ‖localGaugeInput Φ₀ lam_sys m_r q_r s_v V_J X_J h_sub v'‖ ^ 2
      rwa [hh'_norm_eq]
    have hh'_supp : ∀ v', 8 * cls.B_sys + cls.R_win + 20 ≤ ‖v'‖ → h'_sub v' = 0 := by
      intro v' hv'
      have h1 := hh'_supp_gen ((4 * cls.B_sys + cls.R_win + 8) * s_v) hh_supp v'
      refine h1 (le_trans ?_ hv')
      have hmul : s_v⁻¹ * ((4 * cls.B_sys + cls.R_win + 8) * s_v) = 4 * cls.B_sys + cls.R_win + 8 := by
        field_simp [hs_v_pos.ne']
      rw [hmul]
      linarith only [hB_sys2]
    have henv_loc1 : IsValidPacketEnv (localRescaledClass cls 1) ε H'_P L' lam_loc Φ'₀ ζ'₀ h'_sub := by
      refine ⟨hε_pos, hε_half, hH'_pos, ?_, hL'_pos, ?_, hlam_loc_lo, hlam_loc_hi,
        hphase_loc, hh'_meas, hh'_supp, hh'_l2, hh'_int_pos⟩
      · dsimp only [localRescaledClass]; rw [div_one]; exact le_trans hH'_K (le_max_right _ _)
      · dsimp only [localRescaledClass]; rw [div_one]; exact le_trans hL'_K (le_max_right _ _)
    have hK_loc_d : cls.K_hor ≤ (t - r) * (localRescaledClass cls (t - r)).K_hor := by
      dsimp only [localRescaledClass]
      calc cls.K_hor
          = (t - r) * (cls.K_hor / (t - r)) := (mul_div_cancel₀ _ htr_pos.ne').symm
        _ ≤ (t - r) * max 1 (cls.K_hor / (t - r)) :=
            mul_le_mul_of_nonneg_left (le_max_right _ _) htr_pos.le
    let k_pow : ℕ := 2 ^ (m_t - m_r)
    have hk_pos : 0 < k_pow := pow_pos (by norm_num) _
    let C_t_fn : ℕ → ℝ := fun r_idx => ((r_idx : ℝ) + 1 / 2) * ((2 : ℝ) ^ m_t)⁻¹
    let P_act : Fin N_O → Prop := fun o =>
      cutLocalizerIdx ε b_star m_r m_t (r_O o) (V_O o) (X_O o) = loc_idx
    let S_O_j : Finset (Fin N_O) := @Finset.filter _ P_act (Classical.decPred P_act) Finset.univ
    let N_Oj : ℕ := S_O_j.card
    let e_Oj : Fin N_Oj ≃ { o // o ∈ S_O_j } := S_O_j.equivFin.symm
    let emb : Fin N_Oj → Fin N_O := fun o' => (e_Oj o').1
    have hemb_inj : Function.Injective emb := Subtype.val_injective.comp e_Oj.injective
    have hemb_mem : ∀ o' : Fin N_Oj, emb o' ∈ S_O_j := fun o' => (e_Oj o').2
    have hemb_act : ∀ o' : Fin N_Oj,
        cutLocalizerIdx ε b_star m_r m_t (r_O (emb o')) (V_O (emb o')) (X_O (emb o')) = loc_idx :=
      fun o' => ((@Finset.mem_filter _ P_act (Classical.decPred P_act) Finset.univ (emb o')).mp
        (hemb_mem o')).2
    let r_loc_O : Fin N_Oj → ℕ := fun o' => (r_O (emb o')) % k_pow
    let V'_O_loc : Fin N_Oj → EuclideanSpace ℝ (Fin 2) :=
      fun o' => s_v⁻¹ • (V_O (emb o') - V_J)
    let X'_O_loc : Fin N_Oj → EuclideanSpace ℝ (Fin 2) :=
      fun o' => s_x⁻¹ • (X_O (emb o') - X_J - (C_t_fn (r_O (emb o')) - C_r) • V_J)
    let ψ_O_loc : Fin N_Oj → EuclideanSpace ℝ (Fin 2) → ℂ := fun o' => ψ_O (emb o')
    let p_loc : Fin N_Oj → Fin N_D → ℝ := fun o' d => p_cond (emb o') d
    let p_cond_D : Fin N_D → ℝ := fun d => ∑ o : Fin N_O, p_cond o d
    let b'_D : Fin N_D → ℝ := fun d =>
      @ite _ (0 < p_cond_D d) (Classical.dec _) (b_D d - b_star) 0
    let a'_D : Fin N_D → ℝ := fun d =>
      @ite _ (0 < p_cond_D d) (Classical.dec _) (a_D d - b_star) 0
    let r'_D : Fin N_D → ℕ := fun d =>
      @ite _ (0 < p_cond_D d) (Classical.dec _) ((r_D d) % k_pow) 0
    let V'_D : Fin N_D → EuclideanSpace ℝ (Fin 2) := fun d =>
      @ite _ (0 < p_cond_D d) (Classical.dec _) (s_v⁻¹ • (V_D d - V_J)) 0
    let X'_D : Fin N_D → EuclideanSpace ℝ (Fin 2) := fun d =>
      @ite _ (0 < p_cond_D d) (Classical.dec _)
        (s_x⁻¹ • (X_D d - X_J - (C_t_fn (r_D d) - C_r) • V_J)) 0
    have h_sum_O : ∀ g : Fin N_O → ℝ, (∀ o, o ∉ S_O_j → g o = 0) →
        ∑ o' : Fin N_Oj, g (emb o') = ∑ o : Fin N_O, g o := by
      intro g hg_out
      have h1 : ∑ o' : Fin N_Oj, g (emb o') = ∑ x : { o // o ∈ S_O_j }, g x.1 :=
        Equiv.sum_comp e_Oj (fun x : { o // o ∈ S_O_j } => g x.1)
      rw [h1, Finset.sum_coe_sort S_O_j g]
      exact Finset.sum_subset (Finset.subset_univ S_O_j) (fun o _ ho => hg_out o ho)
    have hp_zero_off : ∀ o : Fin N_O, o ∉ S_O_j → ∀ d : Fin N_D, p_cond o d = 0 := by
      intro o ho_not d
      by_contra hne
      have hpos : 0 < p_cond o d := lt_of_le_of_ne (hp_nn o d) (Ne.symm hne)
      have hmem : o ∈ S_O_j :=
        (@Finset.mem_filter _ P_act (Classical.decPred P_act) Finset.univ o).mpr
          ⟨Finset.mem_univ o, (hsupp o d hpos).1⟩
      exact ho_not hmem
    have hp_loc_D : ∀ d : Fin N_D, ∑ o' : Fin N_Oj, p_loc o' d = p_cond_D d :=
      fun d => h_sum_O (fun o => p_cond o d) (fun o ho => hp_zero_off o ho d)
    have ho'_geom : ∀ o' : Fin N_Oj,
        let o := emb o'
        q_r * k_pow + r_loc_O o' = r_O o ∧
        r_loc_O o' < k_pow ∧
        V_J + s_v • V'_O_loc o' = V_O o ∧
        X_J + (C_t_fn (r_O o) - C_r) • V_J + s_x • X'_O_loc o' = X_O o ∧
        ‖V'_O_loc o'‖ ≤ B'_sys ∧
        ‖X'_O_loc o'‖ ≤ B'_sys ∧
        generalPacketObsMass ε H'_P (t - r) lam_loc (m_t - m_r) Φ'₀ h'_sub
          (r_loc_O o') (V'_O_loc o') (X'_O_loc o') (ψ_O_loc o') =
        generalPacketObsMass ε H_P t lam_sys m_t Φ₀ h_sub
          (r_O o) (V_O o) (X_O o) (ψ_O o) := by
      intro o'
      let o := emb o'
      have hact := hemb_act o'
      dsimp only [cutLocalizerIdx] at hact
      have hqr_eq : r_O o / k_pow = q_r := congr_arg Prod.fst hact
      have hv_idx_eq : (Int.floor (V_O o 0 / s_v + 1 / 2), Int.floor (V_O o 1 / s_v + 1 / 2)) =
          loc_idx.2.1 := congr_arg (Prod.fst ∘ Prod.snd) hact
      have hx_idx_eq := congr_arg (Prod.snd ∘ Prod.snd) hact
      dsimp only [Function.comp_apply] at hv_idx_eq hx_idx_eq
      rw [hqr_eq] at hx_idx_eq
      have hdiv_eq : q_r * k_pow + r_loc_O o' = r_O o := by
        dsimp only [r_loc_O, o]
        rw [← hqr_eq, mul_comm]
        exact Nat.div_add_mod (r_O o) k_pow
      have hrloc_lt : r_loc_O o' < k_pow := Nat.mod_lt _ hk_pos
      have hV_recon : V_J + s_v • V'_O_loc o' = V_O o := by
        dsimp only [V'_O_loc, o]
        rw [smul_smul, mul_inv_cancel₀ hs_v_pos.ne', one_smul, add_sub_cancel]
      have hX_recon : X_J + (C_t_fn (r_O o) - C_r) • V_J + s_x • X'_O_loc o' = X_O o := by
        dsimp only [X'_O_loc, o]
        rw [smul_smul, mul_inv_cancel₀ hs_x_pos.ne', one_smul]
        abel
      have hV_diff : ‖V_O o - V_J‖ ≤ s_v := by
        dsimp only [V_J]
        rw [← hv_idx_eq]
        exact h_round_2d s_v (V_O o) hs_v_pos
      have hV'_norm : ‖V'_O_loc o'‖ ≤ B'_sys := by
        dsimp only [V'_O_loc, o]
        rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hs_v_pos)]
        calc s_v⁻¹ * ‖V_O o - V_J‖
            ≤ s_v⁻¹ * s_v := mul_le_mul_of_nonneg_left hV_diff (inv_nonneg.mpr hs_v_pos.le)
          _ = 1 := inv_mul_cancel₀ hs_v_pos.ne'
          _ ≤ B'_sys := by linarith only [hB_sys2, hB'_ge_B]
      have hCt_Cr : |C_r - C_t_fn (r_O o)| ≤ (1 / 2) * s_c := by
        have hrO_real : (r_O o : ℝ) = (q_r : ℝ) * (k_pow : ℝ) + (r_loc_O o' : ℝ) := by
          exact_mod_cast hdiv_eq.symm
        have hk_real_pos : (0 : ℝ) < (k_pow : ℝ) := by exact_mod_cast hk_pos
        have hrloc_le : (r_loc_O o' : ℝ) + 1 ≤ (k_pow : ℝ) := by
          exact_mod_cast Nat.succ_le_of_lt hrloc_lt
        have hrloc_nn : (0 : ℝ) ≤ (r_loc_O o' : ℝ) := Nat.cast_nonneg _
        have hdiff_eq : C_r - C_t_fn (r_O o) =
            s_c * (1 / 2 - ((r_loc_O o' : ℝ) + 1 / 2) / (k_pow : ℝ)) := by
          have hkp_cast : (k_pow : ℝ) = (2 : ℝ) ^ (m_t - m_r) := by
            dsimp only [k_pow]; push_cast; rfl
          dsimp only [C_r, C_t_fn, s_c]
          rw [← hpow_split_r, hrO_real, mul_inv, ← hkp_cast]
          field_simp [hk_real_pos.ne']
          ring
        have hfrac_lo : 0 ≤ ((r_loc_O o' : ℝ) + 1 / 2) / (k_pow : ℝ) := by positivity
        have hfrac_hi : ((r_loc_O o' : ℝ) + 1 / 2) / (k_pow : ℝ) ≤ 1 := by
          rw [div_le_iff₀ hk_real_pos]; linarith only [hrloc_le]
        rw [hdiff_eq, abs_mul, abs_of_pos hs_c_pos, mul_comm]
        exact mul_le_mul_of_nonneg_right
          (abs_le.mpr ⟨by linarith only [hfrac_hi], by linarith only [hfrac_lo]⟩) hs_c_pos.le
      let w_x : EuclideanSpace ℝ (Fin 2) := X_O o + (C_r - C_t_fn (r_O o)) • V_O o
      have hwx_diff : ‖w_x - X_J‖ ≤ s_x := by
        dsimp only [X_J]
        rw [← hx_idx_eq]
        change ‖w_x - gridPt2D s_x (Int.floor (w_x 0 / s_x + 1 / 2), Int.floor (w_x 1 / s_x + 1 / 2))‖ ≤ s_x
        exact h_round_2d s_x w_x hs_x_pos
      have hX'_norm : ‖X'_O_loc o'‖ ≤ B'_sys := by
        have hvec_eq : X_O o - X_J - (C_t_fn (r_O o) - C_r) • V_J =
            (w_x - X_J) - (C_r - C_t_fn (r_O o)) • (V_O o - V_J) := by
          dsimp only [w_x]
          simp only [smul_sub, sub_smul]
          abel
        have hvec_norm : ‖X_O o - X_J - (C_t_fn (r_O o) - C_r) • V_J‖ ≤ (3 / 2 : ℝ) * s_x := by
          rw [hvec_eq]
          calc ‖(w_x - X_J) - (C_r - C_t_fn (r_O o)) • (V_O o - V_J)‖
              ≤ ‖w_x - X_J‖ + ‖(C_r - C_t_fn (r_O o)) • (V_O o - V_J)‖ := norm_sub_le _ _
            _ = ‖w_x - X_J‖ + |C_r - C_t_fn (r_O o)| * ‖V_O o - V_J‖ := by
                rw [norm_smul, Real.norm_eq_abs]
            _ ≤ s_x + ((1 / 2) * s_c) * s_v :=
                add_le_add hwx_diff (mul_le_mul hCt_Cr hV_diff (norm_nonneg _) (by positivity))
            _ = (3 / 2 : ℝ) * s_x := by dsimp only [s_x]; ring
        dsimp only [X'_O_loc, o]
        rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hs_x_pos)]
        calc s_x⁻¹ * ‖X_O o - X_J - (C_t_fn (r_O o) - C_r) • V_J‖
            ≤ s_x⁻¹ * ((3 / 2 : ℝ) * s_x) :=
              mul_le_mul_of_nonneg_left hvec_norm (inv_nonneg.mpr hs_x_pos.le)
          _ = 3 / 2 := by field_simp [hs_x_pos.ne']
          _ ≤ B'_sys := by linarith only [hB_sys2, hB'_ge_B]
      have hmass_eq : generalPacketObsMass ε H'_P (t - r) lam_loc (m_t - m_r) Φ'₀ h'_sub
          (r_loc_O o') (V'_O_loc o') (X'_O_loc o') (ψ_O_loc o') =
          generalPacketObsMass ε H_P t lam_sys m_t Φ₀ h_sub
            (r_O o) (V_O o) (X_O o) (ψ_O o) := by
        have hm := hmass_resc (r_loc_O o') hrloc_lt (V'_O_loc o') (X'_O_loc o') (ψ_O_loc o')
        dsimp only at hm
        rwa [hdiv_eq, hV_recon, hX_recon] at hm
      exact ⟨hdiv_eq, hrloc_lt, hV_recon, hX_recon, hV'_norm, hX'_norm, hmass_eq⟩
    have hadm_res : IsAdmissiblePacketLaw ε H'_P L' (t - r) B'_sys cls.R_win
        cls.N_mult cls.M_win lam_loc (m_t - m_r) Φ'₀ h'_sub
        N_Oj N_D r_loc_O V'_O_loc X'_O_loc ψ_O_loc
        b'_D a'_D r'_D e_D V'_D X'_D p_loc := by
      refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
      · intro o'
        exact ⟨(ho'_geom o').2.1, (ho'_geom o').2.2.2.2.1, (ho'_geom o').2.2.2.2.2.1⟩
      · intro o' k; exact hψ_smooth (emb o') k
      · intro o' z hz; exact hψ_supp (emb o') z hz
      · intro o' k z; exact hψ_deriv (emb o') k z
      · letI := Classical.propDecidable
        intro r_i v'₀ x'₀
        let ρ'_obs := ε ^ ((H'_P - (t - r)) / 2)
        let σ'_obs := (lam_loc * ρ'_obs)⁻¹
        let ρ_obs := ε ^ ((H_P - t) / 2)
        let σ_obs := (lam_sys * ρ_obs)⁻¹
        by_cases hri : r_i < k_pow
        · have hρ_rel : s_v * ρ'_obs = ρ_obs := by
            dsimp only [s_v, ρ'_obs, ρ_obs, H'_P]
            rw [← Real.rpow_add hε_pos]; congr 1; ring
          have hσ_rel : s_x * σ'_obs = σ_obs := by
            dsimp only [σ'_obs, σ_obs, lam_loc, s_x]
            have hdenom : s_c * s_v ^ 2 * lam_sys * ρ'_obs = (s_c * s_v) * (lam_sys * ρ_obs) := by
              rw [← hρ_rel]; ring
            rw [hdenom, mul_inv, ← mul_assoc, mul_inv_cancel₀ hs_x_pos.ne', one_mul]
          let r_full := q_r * k_pow + r_i
          let v₀ := V_J + s_v • v'₀
          let x₀ := X_J + (C_t_fn r_full - C_r) • V_J + s_x • x'₀
          let F_loc := Finset.univ.filter (fun o' : Fin N_Oj =>
            r_loc_O o' = r_i ∧ ‖V'_O_loc o' - v'₀‖ ≤ ρ'_obs ∧ ‖X'_O_loc o' - x'₀‖ ≤ σ'_obs)
          let F_glob := Finset.univ.filter (fun o : Fin N_O =>
            r_O o = r_full ∧ ‖V_O o - v₀‖ ≤ ρ_obs ∧ ‖X_O o - x₀‖ ≤ σ_obs)
          have h_maps : ∀ o' ∈ F_loc, emb o' ∈ F_glob := by
            intro o' ho'
            obtain ⟨hr_eq, hv_le, hx_le⟩ := (Finset.mem_filter.mp ho').2
            obtain ⟨hdiv, _, hV_rec, hX_rec, _⟩ := ho'_geom o'
            have hr_full_eq : r_O (emb o') = r_full := by dsimp only [r_full]; rw [← hr_eq, hdiv]
            have hv_glob : ‖V_O (emb o') - v₀‖ ≤ ρ_obs := by
              have hdV : V_O (emb o') - v₀ = s_v • (V'_O_loc o' - v'₀) := by
                dsimp only [v₀]; rw [← hV_rec, smul_sub]; abel
              rw [hdV, norm_smul, Real.norm_eq_abs, abs_of_pos hs_v_pos, ← hρ_rel]
              exact mul_le_mul_of_nonneg_left hv_le hs_v_pos.le
            have hx_glob : ‖X_O (emb o') - x₀‖ ≤ σ_obs := by
              have hdX : X_O (emb o') - x₀ = s_x • (X'_O_loc o' - x'₀) := by
                dsimp only [x₀]; rw [← hX_rec, hr_full_eq, smul_sub]; abel
              rw [hdX, norm_smul, Real.norm_eq_abs, abs_of_pos hs_x_pos, ← hσ_rel]
              exact mul_le_mul_of_nonneg_left hx_le hs_x_pos.le
            exact Finset.mem_filter.mpr ⟨Finset.mem_univ _, hr_full_eq, hv_glob, hx_glob⟩
          have hc_le : F_loc.card ≤ F_glob.card :=
            Finset.card_le_card_of_injOn emb h_maps (fun x _ y _ hxy => hemb_inj hxy)
          have hc_real : (F_loc.card : ℝ) ≤ (F_glob.card : ℝ) := by exact_mod_cast hc_le
          exact le_trans hc_real (hpack_adm r_full v₀ x₀)
        · have hemp : Finset.univ.filter (fun o' : Fin N_Oj =>
              r_loc_O o' = r_i ∧ ‖V'_O_loc o' - v'₀‖ ≤ ρ'_obs ∧ ‖X'_O_loc o' - x'₀‖ ≤ σ'_obs) = ∅ := by
            rw [Finset.filter_eq_empty_iff]
            intro o' _ hp_o'
            have hlt := (ho'_geom o').2.1
            rw [hp_o'.1] at hlt
            exact hri hlt
          rw [hemp, Finset.card_empty, Nat.cast_zero]
          exact Nat.cast_nonneg _
      · intro d
        obtain ⟨hb0, hba, ha_top, hrD_lt, he1⟩ := hd_adm d
        dsimp only [b'_D, a'_D, r'_D]
        split_ifs with hpD_pos
        · have h_ex_o : ∃ o₁ : Fin N_O, 0 < p_cond o₁ d := by
            by_contra hnone
            push Not at hnone
            have hz : p_cond_D d = 0 :=
              Finset.sum_eq_zero (fun o _ => le_antisymm (hnone o) (hp_nn o d))
            linarith only [hpD_pos, hz]
          obtain ⟨o₁, ho₁⟩ := h_ex_o
          have hbs_le : b_star ≤ b_D d := (hsupp o₁ d ho₁).2.1
          have ha_Lt : a_D d ≤ L - t := le_trans ha_top (min_le_left _ _)
          have ha_HPt : a_D d ≤ (H_P - t) / 2 := le_trans ha_top (min_le_right _ _)
          refine ⟨by linarith only [hbs_le], by linarith only [hba],
            le_min (by dsimp only [L']; linarith only [ha_Lt])
                   (by dsimp only [H'_P]; linarith only [ha_HPt]),
            Nat.mod_lt _ hk_pos, he1⟩
        · refine ⟨le_rfl, le_rfl, le_min (by dsimp only [L']; linarith only [hb_star_Lt])
            (by dsimp only [H'_P]; linarith only [hb_star_HPt]), hk_pos, he1⟩
      · intro o' d; exact hp_nn (emb o') d
      · dsimp only [p_loc]
        rw [h_sum_O (fun o => ∑ d : Fin N_D, p_cond o d)
          (fun o ho => Finset.sum_eq_zero (fun d _ => hp_zero_off o ho d))]
        exact hp_sum
      · intro o' d hp_pos
        let o := emb o'
        have hp_od_pos : 0 < p_cond o d := hp_pos
        have hpD_pos : 0 < p_cond_D d :=
          lt_of_lt_of_le hp_od_pos
            (Finset.single_le_sum (fun o₁ _ => hp_nn o₁ d) (Finset.mem_univ o))
        obtain ⟨_, hr_eq, hv1, hv2, hx1, hx2⟩ := hp_act o d hp_od_pos
        have hm_pos : 0 < generalPacketObsMass ε H'_P (t - r) lam_loc (m_t - m_r) Φ'₀ h'_sub
            (r_loc_O o') (V'_O_loc o') (X'_O_loc o') (ψ_O_loc o') := by
          rw [(ho'_geom o').2.2.2.2.2.2]
          exact (hsupp o d hp_od_pos).2.2
        have hb'_eq : b'_D d = b_D d - b_star := by simp only [b'_D, hpD_pos, ↓reduceIte]
        have ha'_eq : a'_D d = a_D d - b_star := by simp only [a'_D, hpD_pos, ↓reduceIte]
        have hr'_eq : r'_D d = (r_D d) % k_pow := by simp only [r'_D, hpD_pos, ↓reduceIte]
        have hV'D_eq : V'_D d = s_v⁻¹ • (V_D d - V_J) := by simp only [V'_D, hpD_pos, ↓reduceIte]
        have hX'D_eq : X'_D d = s_x⁻¹ • (X_D d - X_J - (C_t_fn (r_D d) - C_r) • V_J) := by
          simp only [X'_D, hpD_pos, ↓reduceIte]
        have hrloc_eq : r_loc_O o' = r'_D d := by
          rw [hr'_eq]; dsimp only [r_loc_O]; rw [hr_eq]
        have hdV_eq : V'_O_loc o' - V'_D d = s_v⁻¹ • (V_O o - V_D d) := by
          rw [hV'D_eq]; dsimp only [V'_O_loc, o]; simp only [smul_sub]; abel
        have hdX_eq : X'_O_loc o' - X'_D d = s_x⁻¹ • (X_O o - X_D d) := by
          rw [hX'D_eq]; dsimp only [X'_O_loc, o]; rw [hr_eq]; simp only [smul_sub]; abel
        have hsv_inv_eq : s_v⁻¹ = ε ^ (-b_star) := by
          dsimp only [s_v]; rw [← Real.rpow_neg hε_pos.le]
        have hsx_inv_le : s_x⁻¹ ≤ ε ^ (-r - b_star) := by
          dsimp only [s_x]
          rw [mul_inv, hsv_inv_eq]
          calc s_c⁻¹ * ε ^ (-b_star)
              ≤ ε ^ (-r) * ε ^ (-b_star) :=
                mul_le_mul_of_nonneg_right hsc_inv_hi (Real.rpow_pos_of_pos hε_pos _).le
            _ = ε ^ (-r - b_star) := by rw [← Real.rpow_add hε_pos, ← sub_eq_add_neg]
        have h_scale_v : ∀ (w : EuclideanSpace ℝ (Fin 2)) (ex : ℝ),
            |inner ℝ (V_O o - V_D d) w| ≤ cls.B_sys * ε ^ ex →
            |inner ℝ (V'_O_loc o' - V'_D d) w| ≤ B'_sys * ε ^ (ex - b_star) := by
          intro w ex h_in
          rw [hdV_eq, inner_smul_left, RCLike.conj_to_real, abs_mul,
            abs_of_pos (inv_pos.mpr hs_v_pos), hsv_inv_eq]
          calc ε ^ (-b_star) * |inner ℝ (V_O o - V_D d) w|
              ≤ ε ^ (-b_star) * (cls.B_sys * ε ^ ex) :=
                mul_le_mul_of_nonneg_left h_in (Real.rpow_pos_of_pos hε_pos _).le
            _ = cls.B_sys * (ε ^ (-b_star) * ε ^ ex) := by ring
            _ = cls.B_sys * ε ^ (ex - b_star) := by
                rw [← Real.rpow_add hε_pos]; congr 2; ring
            _ ≤ B'_sys * ε ^ (ex - b_star) :=
                mul_le_mul_of_nonneg_right hB'_ge_B (Real.rpow_pos_of_pos hε_pos _).le
        have h_scale_x : ∀ (w : EuclideanSpace ℝ (Fin 2)) (ex : ℝ),
            |inner ℝ (X_O o - X_D d) w| ≤ cls.B_sys * ε ^ (ex + t) →
            |inner ℝ (X'_O_loc o' - X'_D d) w| ≤ B'_sys * ε ^ ((ex - b_star) + (t - r)) := by
          intro w ex h_in
          rw [hdX_eq, inner_smul_left, RCLike.conj_to_real, abs_mul,
            abs_of_pos (inv_pos.mpr hs_x_pos)]
          calc s_x⁻¹ * |inner ℝ (X_O o - X_D d) w|
              ≤ ε ^ (-r - b_star) * (cls.B_sys * ε ^ (ex + t)) :=
                mul_le_mul hsx_inv_le h_in (abs_nonneg _) (Real.rpow_pos_of_pos hε_pos _).le
            _ = cls.B_sys * (ε ^ (-r - b_star) * ε ^ (ex + t)) := by ring
            _ = cls.B_sys * ε ^ ((ex - b_star) + (t - r)) := by
                rw [← Real.rpow_add hε_pos]; congr 2; ring
            _ ≤ B'_sys * ε ^ ((ex - b_star) + (t - r)) :=
                mul_le_mul_of_nonneg_right hB'_ge_B (Real.rpow_pos_of_pos hε_pos _).le
        rw [hb'_eq, ha'_eq]
        exact ⟨hm_pos, hrloc_eq,
          h_scale_v (e_D d) (b_D d) hv1,
          h_scale_v (perp2D (e_D d)) (a_D d) hv2,
          h_scale_x (e_D d) (b_D d) hx1,
          h_scale_x (perp2D (e_D d)) (a_D d) hx2⟩
    have hscore_eq : generalPacketScore ε γ H'_P (t - r) lam_loc (m_t - m_r) Φ'₀ h'_sub
        N_Oj N_D r_loc_O V'_O_loc X'_O_loc ψ_O_loc b'_D a'_D p_loc =
        generalPacketScore ε γ H_P t lam_sys m_t Φ₀ h_sub
          N_O N_D r_O V_O X_O ψ_O b_D a_D p_cond - b_star := by
      unfold generalPacketScore
      let p_cond_O : Fin N_O → ℝ := fun o => ∑ d : Fin N_D, p_cond o d
      have hpO_zero_off : ∀ o : Fin N_O, o ∉ S_O_j → p_cond_O o = 0 :=
        fun o ho => Finset.sum_eq_zero (fun d _ => hp_zero_off o ho d)
      have hHO_eq : ∑ o' : Fin N_Oj, -((∑ d, p_loc o' d) * Real.log (∑ d, p_loc o' d)) =
          ∑ o : Fin N_O, -(p_cond_O o * Real.log (p_cond_O o)) := by
        refine h_sum_O (fun o => -(p_cond_O o * Real.log (p_cond_O o))) (fun o ho => ?_)
        rw [hpO_zero_off o ho]; simp
      have hHOD_eq : ∑ o' : Fin N_Oj, ∑ d : Fin N_D,
            -(p_loc o' d * Real.log (p_loc o' d / (∑ o₁, p_loc o₁ d))) =
          ∑ o : Fin N_O, ∑ d : Fin N_D, -(p_cond o d * Real.log (p_cond o d / p_cond_D d)) := by
        simp_rw [hp_loc_D]
        refine h_sum_O
          (fun o => ∑ d : Fin N_D, -(p_cond o d * Real.log (p_cond o d / p_cond_D d)))
          (fun o ho => Finset.sum_eq_zero (fun d _ => ?_))
        rw [hp_zero_off o ho d]; simp
      have hEmass_eq : ∑ o' : Fin N_Oj, (∑ d, p_loc o' d) * Real.log
            (generalPacketObsMass ε H'_P (t - r) lam_loc (m_t - m_r) Φ'₀ h'_sub
              (r_loc_O o') (V'_O_loc o') (X'_O_loc o') (ψ_O_loc o')) =
          ∑ o : Fin N_O, p_cond_O o * Real.log
            (generalPacketObsMass ε H_P t lam_sys m_t Φ₀ h_sub
              (r_O o) (V_O o) (X_O o) (ψ_O o)) := by
        have hcongr : ∑ o' : Fin N_Oj, (∑ d, p_loc o' d) * Real.log
              (generalPacketObsMass ε H'_P (t - r) lam_loc (m_t - m_r) Φ'₀ h'_sub
                (r_loc_O o') (V'_O_loc o') (X'_O_loc o') (ψ_O_loc o')) =
            ∑ o' : Fin N_Oj, p_cond_O (emb o') * Real.log
              (generalPacketObsMass ε H_P t lam_sys m_t Φ₀ h_sub
                (r_O (emb o')) (V_O (emb o')) (X_O (emb o')) (ψ_O (emb o'))) := by
          refine Finset.sum_congr rfl (fun o' _ => ?_)
          rw [(ho'_geom o').2.2.2.2.2.2]
        rw [hcongr]
        refine h_sum_O
          (fun o => p_cond_O o * Real.log
            (generalPacketObsMass ε H_P t lam_sys m_t Φ₀ h_sub (r_O o) (V_O o) (X_O o) (ψ_O o)))
          (fun o ho => ?_)
        rw [hpO_zero_off o ho, zero_mul]
      have hpD_sum : ∑ d : Fin N_D, p_cond_D d = 1 := by
        dsimp only [p_cond_D]; rw [Finset.sum_comm, hp_sum]
      have hEw_eq : ∑ d : Fin N_D, (∑ o', p_loc o' d) * ((1 + γ) * b'_D d + (1 - γ) * a'_D d) =
          (∑ d : Fin N_D, p_cond_D d * ((1 + γ) * b_D d + (1 - γ) * a_D d)) - 2 * b_star := by
        simp_rw [hp_loc_D]
        have hterm : ∀ d : Fin N_D, p_cond_D d * ((1 + γ) * b'_D d + (1 - γ) * a'_D d) =
            p_cond_D d * ((1 + γ) * b_D d + (1 - γ) * a_D d) - p_cond_D d * (2 * b_star) := by
          intro d
          dsimp only [b'_D, a'_D]
          split_ifs with hpD_pos
          · ring
          · have hpD0 : p_cond_D d = 0 :=
              le_antisymm (not_lt.mp hpD_pos)
                (Finset.sum_nonneg (fun o _ => hp_nn o d))
            rw [hpD0]; ring
        simp_rw [hterm, Finset.sum_sub_distrib, ← Finset.sum_mul, hpD_sum, one_mul]
      dsimp only
      rw [hHO_eq, hHOD_eq, hEmass_eq, hEw_eq]
      ring
    refine ⟨N_Oj, r_loc_O, V'_O_loc, X'_O_loc, ψ_O_loc, b'_D, a'_D, r'_D, V'_D, X'_D, p_loc,
      h2Δ_H', htr_H', htr_L', henv_loc1,
      le_trans hH'_K hK_loc_d, le_trans hL'_K hK_loc_d,
      hlam_loc_lo, hlam_loc_hi, hm_loc_lo, hm_loc_hi,
      hphase_loc, hh'_meas, hh'_supp, hh'_l2, hh'_int_pos,
      hadm_res, hadm_res, hscore_eq⟩

  let e₀ : EuclideanSpace ℝ (Fin 2) := WithLp.toLp 2 ![1, 0]
  have he₀_norm : ‖e₀‖ = 1 := by
    have hsq : ‖e₀‖ ^ 2 = 1 := by
      rw [EuclideanSpace.norm_sq_eq, Fin.sum_univ_two]
      simp [e₀]
    have h1 := congr_arg Real.sqrt hsq
    rwa [Real.sqrt_sq (norm_nonneg _), Real.sqrt_one] at h1
  have hperp_e₀_norm : ‖perp2D e₀‖ = 1 := by
    have hsq : ‖perp2D e₀‖ ^ 2 = 1 := by
      rw [EuclideanSpace.norm_sq_eq, Fin.sum_univ_two]
      simp [perp2D, e₀]
    have h1 := congr_arg Real.sqrt hsq
    rwa [Real.sqrt_sq (norm_nonneg _), Real.sqrt_one] at h1
  have he₀_inner : ∀ u : EuclideanSpace ℝ (Fin 2),
      inner ℝ u e₀ = u 0 ∧ inner ℝ u (perp2D e₀) = u 1 := by
    intro u
    refine ⟨?_, ?_⟩ <;>
    · rw [PiLp.inner_apply, Fin.sum_univ_two]
      simp [e₀, perp2D]
  have hgrid_smul : ∀ (a b : ℝ) (k : ℤ × ℤ),
      a • gridPt2D b k = gridPt2D (a * b) k := by
    intro a b k
    ext i
    fin_cases i <;> simp [gridPt2D, mul_assoc]
  have hmr_dyadic : ∀ (ε r : ℝ) (m_r : ℕ),
      0 < ε → ε < 1 → 0 < r → m_r = Nat.floor (r * Real.log (ε⁻¹) / Real.log 2) →
      ε ^ r ≤ ((2 : ℝ) ^ m_r)⁻¹ ∧ ((2 : ℝ) ^ m_r)⁻¹ ≤ 2 * ε ^ r := by
    intro ε r m_r hε_pos hε1 hr_pos hmr_eq
    have hlog2_pos : 0 < Real.log 2 := Real.log_pos one_lt_two
    let x := r * Real.log (ε⁻¹) / Real.log 2
    have hx_nn : 0 ≤ x := by
      have : 0 < Real.log (ε⁻¹) := Real.log_pos ((one_lt_inv₀ hε_pos).mpr hε1)
      positivity
    have hfl1 : (m_r : ℝ) ≤ x := by rw [hmr_eq]; exact Nat.floor_le hx_nn
    have hfl2 : x < (m_r : ℝ) + 1 := by rw [hmr_eq]; exact Nat.lt_floor_add_one x
    have hmul1 : (m_r : ℝ) * Real.log 2 ≤ r * Real.log (ε⁻¹) := (le_div_iff₀ hlog2_pos).mp hfl1
    have hmul2 : r * Real.log (ε⁻¹) < ((m_r : ℝ) + 1) * Real.log 2 := (div_lt_iff₀ hlog2_pos).mp hfl2
    have hεr_eq : ε ^ r = Real.exp (-(r * Real.log (ε⁻¹))) := by
      rw [Real.rpow_def_of_pos hε_pos, Real.log_inv]; ring_nf
    have h2mr_eq : ((2 : ℝ) ^ m_r)⁻¹ = Real.exp (-((m_r : ℝ) * Real.log 2)) := by
      rw [← Real.rpow_natCast (2 : ℝ) m_r, Real.rpow_def_of_pos zero_lt_two, ← Real.exp_neg]
      ring_nf
    refine ⟨?_, ?_⟩
    · rw [hεr_eq, h2mr_eq]
      exact Real.exp_le_exp.mpr (by linarith only [hmul1])
    · have h2_eq : 2 * ε ^ r = Real.exp (Real.log 2 - r * Real.log (ε⁻¹)) := by
        rw [hεr_eq, sub_eq_add_neg, Real.exp_add, Real.exp_log zero_lt_two]
      rw [h2mr_eq, h2_eq]
      have hexp_hi : -((m_r : ℝ) * Real.log 2) ≤ Real.log 2 - r * Real.log (ε⁻¹) := by
        have hring : ((m_r : ℝ) + 1) * Real.log 2 = (m_r : ℝ) * Real.log 2 + Real.log 2 := by ring
        linarith only [hmul2, hring]
      exact Real.exp_le_exp.mpr hexp_hi

  have hB_sys2 : 2 ≤ cls.B_sys := cls.hB_sys
  have hB_pos : 0 < cls.B_sys := by linarith only [hB_sys2]
  have hRw2 : 2 ≤ cls.R_win := cls.hR_win
  have hR_bud_pos : 0 < R_bud := by linarith only [hR_bud, hη, hξ]

  let R_box : ℝ := 8 * cls.B_sys + 2 * cls.R_win + 10
  have hR_box1 : 1 ≤ R_box := by dsimp only [R_box]; linarith only [hB_sys2, hRw2]
  let R_pt : ℝ := 10 + C_cut * Real.sqrt cls.B_sys
  have hR_pt1 : 1 ≤ R_pt := by
    dsimp only [R_pt]
    have hnn : 0 ≤ C_cut * Real.sqrt cls.B_sys := by positivity
    linarith only [hnn]
  let C_RF : ℝ := R_pt ^ 4
  have hC_RF1 : 1 ≤ C_RF := one_le_pow₀ hR_pt1
  let M_cap₁ : ℕ := max 3 (Nat.ceil ((B_cut + 3 * ξ + cls.K_hor + 4 * η) / (2 * η)) + 1)
  have hM_cap₁_3 : 3 ≤ M_cap₁ := le_max_left 3 _
  have hM_cap₁_ge : B_cut + 3 * ξ + cls.K_hor ≤ (2 * (M_cap₁ : ℝ) - 4) * η := by
    let q := (B_cut + 3 * ξ + cls.K_hor + 4 * η) / (2 * η)
    have h1 : q ≤ (Nat.ceil q : ℝ) := Nat.le_ceil q
    have h2 : (Nat.ceil q : ℝ) ≤ (M_cap₁ : ℝ) := by
      exact_mod_cast le_trans (Nat.le_succ _) (le_max_right 3 _)
    have h3 : B_cut + 3 * ξ + cls.K_hor + 4 * η ≤ (M_cap₁ : ℝ) * (2 * η) :=
      (div_le_iff₀ (by positivity)).mp (le_trans h1 h2)
    linarith only [h3]
  let C_cap_tot : ℝ := C_Bes * C_cov * C_RF + C_rtail M_cap₁ * C_cov
  have hC_cap_tot1 : 1 ≤ C_cap_tot := by
    have h1 : 1 ≤ C_Bes * C_cov * C_RF :=
      one_le_mul_of_one_le_of_one_le
        (one_le_mul_of_one_le_of_one_le hC_Bes (by linarith only [hC_cov])) hC_RF1
    have h2 : 0 ≤ C_rtail M_cap₁ * C_cov :=
      mul_nonneg (hC_rtail M_cap₁) (by linarith only [hC_cov])
    dsimp only [C_cap_tot]; linarith only [h1, h2]
  let C_pt_card : ℝ := (M_mult : ℝ) * (2 * R_pt + 2) ^ 2 * (4 * cls.B_sys * R_pt + 2) ^ 2
  have hC_pt_card1 : 1 ≤ C_pt_card := by
    have hm1 : (1 : ℝ) ≤ (M_mult : ℝ) := by exact_mod_cast hM_mult
    have hp1 : 1 ≤ (2 * R_pt + 2) ^ 2 := one_le_pow₀ (by linarith only [hR_pt1])
    have hp2 : 1 ≤ (4 * cls.B_sys * R_pt + 2) ^ 2 := by
      refine one_le_pow₀ ?_
      have hnn : 0 ≤ 4 * cls.B_sys * R_pt := by positivity
      linarith only [hnn]
    exact one_le_mul_of_one_le_of_one_le (one_le_mul_of_one_le_of_one_le hm1 hp1) hp2
  let M_cap₂ : ℕ := max 3 (Nat.ceil ((B_cut + ξ + 4 * η) / (2 * η)) + 1)
  have hM_cap₂_3 : 3 ≤ M_cap₂ := le_max_left 3 _
  have hM_cap₂_ge : B_cut + ξ ≤ (2 * (M_cap₂ : ℝ) - 4) * η := by
    let q := (B_cut + ξ + 4 * η) / (2 * η)
    have h1 : q ≤ (Nat.ceil q : ℝ) := Nat.le_ceil q
    have h2 : (Nat.ceil q : ℝ) ≤ (M_cap₂ : ℝ) := by
      exact_mod_cast le_trans (Nat.le_succ _) (le_max_right 3 _)
    have h3 : B_cut + ξ + 4 * η ≤ (M_cap₂ : ℝ) * (2 * η) :=
      (div_le_iff₀ (by positivity)).mp (le_trans h1 h2)
    linarith only [h3]
  let C_pt_mass : ℝ := C_Bes * C_pt_card + C_rtail M_cap₂
  have hC_pt_mass1 : 1 ≤ C_pt_mass := by
    have h1 : 1 ≤ C_Bes * C_pt_card := one_le_mul_of_one_le_of_one_le hC_Bes hC_pt_card1
    have h2 := hC_rtail M_cap₂
    dsimp only [C_pt_mass]; linarith only [h1, h2]
  let C_lat : ℝ := (30 * Real.sqrt (2 * cls.B_sys) + 2) ^ 4
  have hC_lat1 : 1 ≤ C_lat := by
    refine one_le_pow₀ ?_
    have hnn : 0 ≤ 30 * Real.sqrt (2 * cls.B_sys) := by positivity
    linarith only [hnn]
  have hC_cov_box1 : 1 ≤ C_cov * R_box ^ 4 :=
    one_le_mul_of_one_le_of_one_le (by linarith only [hC_cov]) (one_le_pow₀ hR_box1)
  have hC_lat_pt1 : 1 ≤ C_lat * C_pt_mass :=
    one_le_mul_of_one_le_of_one_le hC_lat1 hC_pt_mass1
  let A_log : ℝ := 3 * Real.log C_Bes + Real.log (C_cov * R_box ^ 4) +
    Real.log C_cap_tot + Real.log (C_lat * C_pt_mass) + 1
  have hlog_Bes_nn : 0 ≤ Real.log C_Bes := Real.log_nonneg hC_Bes
  have hlog_box_nn : 0 ≤ Real.log (C_cov * R_box ^ 4) := Real.log_nonneg hC_cov_box1
  have hlog_cap_nn : 0 ≤ Real.log C_cap_tot := Real.log_nonneg hC_cap_tot1
  have hlog_lat_nn : 0 ≤ Real.log (C_lat * C_pt_mass) := Real.log_nonneg hC_lat_pt1

  let ε₁ : ℝ := 1 / 4
  let ε₂ : ℝ := ((Real.sqrt cls.B_sys)⁻¹) ^ (Δ_u⁻¹)
  let ε₃ : ℝ := (1 / 2 : ℝ) ^ (η⁻¹)
  let ε₄ : ℝ := (Real.exp (2 * A_log / R_bud))⁻¹
  let ε_root : ℝ := min ε₁ (min ε₂ (min ε₃ ε₄))
  have hsqrtB_pos : 0 < Real.sqrt cls.B_sys := Real.sqrt_pos.mpr hB_pos
  have hε_root_pos : 0 < ε_root :=
    lt_min (by norm_num)
      (lt_min (Real.rpow_pos_of_pos (inv_pos.mpr hsqrtB_pos) _)
        (lt_min (Real.rpow_pos_of_pos (by norm_num) _) (inv_pos.mpr (Real.exp_pos _))))
  have hε_root_half : ε_root < 1 / 2 :=
    lt_of_le_of_lt (min_le_left _ _) (by norm_num)

  refine ⟨ε_root, hε_root_pos, hε_root_half, ?_⟩
  intro ε H_P L t r b_star lam_sys m_r m_t N_ret Φ₀ ζ₀ f sub
    q_r s_c C_r s_v s_x V_J X_J ρ_r σ_r V_at X_at g_at h_sub
    lam_loc ρ'₀ Φ'₀ ζ'₀ h'_sub H'_P L' R'_dom K_sub
    hε_lt_root henv hr_nn hr_lt_t ht_L ht_HP hb_star_nn hb_star_Lt hb_star_HPt
    hΔ_u_hr hmr_cases hmr_le_mt hmt_lo hmt_hi hsub_valid hmbin_lo hc_sum_le1
    hh_meas hh_l2 hh_bes hroot_cap_all

  have ⟨hε_pos, hε_half, _, hHP_K, _, _, hlam_lo, hlam_hi, hphase₀, _⟩ := henv
  have hε_lt1 : ε < 1 := by linarith only [hε_half]
  let ell : ℝ := Real.log (ε⁻¹)
  have hell_pos : 0 < ell := Real.log_pos ((one_lt_inv₀ hε_pos).mpr hε_lt1)
  have hlog_eps : Real.log ε = -ell := by dsimp only [ell]; rw [Real.log_inv, neg_neg]
  have hlam_pos : 0 < lam_sys :=
    lt_of_lt_of_le (mul_pos (inv_pos.mpr hB_pos) (Real.rpow_pos_of_pos hε_pos (-H_P))) hlam_lo
  have hs_c_pos : 0 < s_c := by dsimp only [s_c]; positivity
  have hs_v_pos : 0 < s_v := Real.rpow_pos_of_pos hε_pos b_star
  have hs_v_le1 : s_v ≤ 1 := Real.rpow_le_one hε_pos.le hε_lt1.le hb_star_nn
  have hs_x_pos : 0 < s_x := mul_pos hs_c_pos hs_v_pos

  have hε_lt_2 : ε < ε₂ :=
    lt_of_lt_of_le hε_lt_root (le_trans (min_le_right _ _) (min_le_left _ _))
  have hε_lt_3 : ε < ε₃ :=
    lt_of_lt_of_le hε_lt_root
      (le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_left _ _)))
  have hε_lt_4 : ε < ε₄ :=
    lt_of_lt_of_le hε_lt_root
      (le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (min_le_right _ _)))

  have hB_Δ_le1 : Real.sqrt cls.B_sys * ε ^ Δ_u ≤ 1 := by
    have h1 : ε ^ Δ_u ≤ (((Real.sqrt cls.B_sys)⁻¹) ^ (Δ_u⁻¹)) ^ Δ_u :=
      Real.rpow_le_rpow hε_pos.le hε_lt_2.le hΔ_u.le
    rw [← Real.rpow_mul (inv_nonneg.mpr hsqrtB_pos.le), inv_mul_cancel₀ hΔ_u.ne',
      Real.rpow_one] at h1
    calc Real.sqrt cls.B_sys * ε ^ Δ_u
        ≤ Real.sqrt cls.B_sys * (Real.sqrt cls.B_sys)⁻¹ :=
          mul_le_mul_of_nonneg_left h1 hsqrtB_pos.le
      _ = 1 := mul_inv_cancel₀ hsqrtB_pos.ne'

  have h2_le_εη : 2 ≤ ε ^ (-η) := by
    have h1 : ε ^ η ≤ ((1 / 2 : ℝ) ^ (η⁻¹)) ^ η :=
      Real.rpow_le_rpow hε_pos.le hε_lt_3.le hη.le
    rw [← Real.rpow_mul (by norm_num), inv_mul_cancel₀ hη.ne', Real.rpow_one] at h1
    rw [Real.rpow_neg hε_pos.le]
    have h2 : (1 / 2 : ℝ)⁻¹ ≤ (ε ^ η)⁻¹ :=
      inv_anti₀ (Real.rpow_pos_of_pos hε_pos η) h1
    norm_num at h2
    exact h2

  have h1_le_εη : 1 ≤ ε ^ (-η) := by linarith only [h2_le_εη]

  have hA_log_le : A_log / ell ≤ R_bud / 2 := by
    have h1 : ε₄⁻¹ ≤ ε⁻¹ := inv_anti₀ hε_pos hε_lt_4.le
    dsimp only [ε₄] at h1
    rw [inv_inv] at h1
    have h2 : 2 * A_log / R_bud ≤ ell := by
      have hl := Real.log_le_log (Real.exp_pos _) h1
      rwa [Real.log_exp] at hl
    have h3 : 2 * A_log ≤ ell * R_bud := (div_le_iff₀ hR_bud_pos).mp h2
    exact (div_le_iff₀ hell_pos).mpr (by linarith only [h3])

  have hsc_bounds : ε ^ r ≤ s_c ∧ s_c ≤ 2 * ε ^ r := by
    rcases hmr_cases with ⟨hr0, hmr0⟩ | ⟨hr_pos, hmr_eq⟩
    · dsimp only [s_c]
      rw [hr0, hmr0, Real.rpow_zero, pow_zero, inv_one]
      exact ⟨le_rfl, by norm_num⟩
    · exact hmr_dyadic ε r m_r hε_pos hε_lt1 hr_pos hmr_eq
  obtain ⟨hsc_lo, hsc_hi⟩ := hsc_bounds

  have hsv_sq : s_v ^ 2 = ε ^ (2 * b_star) := by
    dsimp only [s_v]
    rw [← Real.rpow_two, ← Real.rpow_mul hε_pos.le]; ring_nf
  have hexp_H' : ε ^ r * ε ^ (2 * b_star) * ε ^ (-H_P) = ε ^ (-H'_P) := by
    rw [← Real.rpow_add hε_pos, ← Real.rpow_add hε_pos]
    congr 1; dsimp only [H'_P]; ring
  have hlam_loc_pos : 0 < lam_loc := by dsimp only [lam_loc]; positivity
  have hρ'₀_pos : 0 < ρ'₀ := by dsimp only [ρ'₀]; positivity
  have hlam_loc_lo_raw : cls.B_sys⁻¹ * ε ^ (-H'_P) ≤ lam_loc := by
    calc cls.B_sys⁻¹ * ε ^ (-H'_P)
        = (cls.B_sys⁻¹ * ε ^ (-H_P)) * (ε ^ r * ε ^ (2 * b_star)) := by
          rw [← hexp_H']; ring
      _ ≤ lam_sys * (s_c * s_v ^ 2) := by
          rw [hsv_sq]
          exact mul_le_mul hlam_lo
            (mul_le_mul_of_nonneg_right hsc_lo (Real.rpow_pos_of_pos hε_pos _).le)
            (by positivity) hlam_pos.le
      _ = lam_loc := by dsimp only [lam_loc]; ring
  have hlam_loc_hi_raw : lam_loc ≤ (2 * cls.B_sys) * ε ^ (-H'_P) := by
    calc lam_loc
        = (s_c * s_v ^ 2) * lam_sys := by dsimp only [lam_loc]
      _ ≤ (2 * ε ^ r * ε ^ (2 * b_star)) * (cls.B_sys * ε ^ (-H_P)) := by
          rw [hsv_sq]
          exact mul_le_mul
            (mul_le_mul_of_nonneg_right hsc_hi (Real.rpow_pos_of_pos hε_pos _).le)
            hlam_hi hlam_pos.le (by positivity)
      _ = (2 * cls.B_sys) * (ε ^ r * ε ^ (2 * b_star) * ε ^ (-H_P)) := by ring
      _ = (2 * cls.B_sys) * ε ^ (-H'_P) := by rw [hexp_H']

  have hρ'₀_hi : ρ'₀ ≤ Real.sqrt cls.B_sys * ε ^ (H'_P / 2) := by
    let rhs := Real.sqrt cls.B_sys * ε ^ (H'_P / 2)
    have hrhs_pos : 0 < rhs := by dsimp only [rhs]; positivity
    have hsq_eq : (rhs⁻¹) ^ 2 = cls.B_sys⁻¹ * ε ^ (-H'_P) := by
      dsimp only [rhs]
      rw [mul_inv, mul_pow, inv_pow, Real.sq_sqrt hB_pos.le, ← Real.rpow_neg hε_pos.le,
        ← Real.rpow_two, ← Real.rpow_mul hε_pos.le]
      ring_nf
    have hsqrt_le : rhs⁻¹ ≤ Real.sqrt lam_loc := by
      have h1 := Real.sqrt_le_sqrt (hsq_eq ▸ hlam_loc_lo_raw)
      rwa [Real.sqrt_sq (inv_nonneg.mpr hrhs_pos.le)] at h1
    have hinv := inv_anti₀ (inv_pos.mpr hrhs_pos) hsqrt_le
    rwa [inv_inv] at hinv

  have hρ'₀_inv_hi : ρ'₀⁻¹ ≤ Real.sqrt (2 * cls.B_sys) * ε ^ (-H'_P / 2) := by
    dsimp only [ρ'₀]
    rw [inv_inv]
    let rhs := Real.sqrt (2 * cls.B_sys) * ε ^ (-H'_P / 2)
    have hrhs_nn : 0 ≤ rhs := by dsimp only [rhs]; positivity
    have hsq_eq : rhs ^ 2 = (2 * cls.B_sys) * ε ^ (-H'_P) := by
      dsimp only [rhs]
      rw [mul_pow, Real.sq_sqrt (by positivity), ← Real.rpow_two, ← Real.rpow_mul hε_pos.le]
      ring_nf
    have h1 := Real.sqrt_le_sqrt (hsq_eq.symm ▸ hlam_loc_hi_raw)
    rwa [Real.sqrt_sq hrhs_nn] at h1

  obtain ⟨hN_ret1, _, hqr_lt, _, _, hmbin_pos, _, _, _,
    hsub_at, hsub_mult, _, hsub_cap, _⟩ := hsub_valid

  have hρ_r_bounds : 0 < ρ_r ∧ ρ_r ≤ s_v := by
    by_cases hr0 : r = 0
    · simp only [ρ_r, hr0, ↓reduceIte]
      refine ⟨by positivity, ?_⟩
      let ub := Real.sqrt cls.B_sys * ε ^ (H_P / 2)
      have hub_pos : 0 < ub := by dsimp only [ub]; positivity
      have hub_sq : (ub⁻¹) ^ 2 = cls.B_sys⁻¹ * ε ^ (-H_P) := by
        dsimp only [ub]
        rw [mul_inv, mul_pow, inv_pow, Real.sq_sqrt hB_pos.le, ← Real.rpow_neg hε_pos.le,
          ← Real.rpow_two, ← Real.rpow_mul hε_pos.le]
        ring_nf
      have hsqrt_le : ub⁻¹ ≤ Real.sqrt lam_sys := by
        have h1 := Real.sqrt_le_sqrt (hub_sq ▸ hlam_lo)
        rwa [Real.sqrt_sq (inv_nonneg.mpr hub_pos.le)] at h1
      have hρ_ub : (Real.sqrt lam_sys)⁻¹ ≤ ub := by
        have hinv := inv_anti₀ (inv_pos.mpr hub_pos) hsqrt_le
        rwa [inv_inv] at hinv
      have hexp_le : Δ_u + b_star ≤ H_P / 2 := by linarith only [hΔ_u_hr, hr0]
      have hε_hp : ε ^ (H_P / 2) ≤ ε ^ Δ_u * s_v := by
        dsimp only [s_v]
        rw [← Real.rpow_add hε_pos]
        exact Real.rpow_le_rpow_of_exponent_ge hε_pos hε_lt1.le hexp_le
      calc (Real.sqrt lam_sys)⁻¹
          ≤ Real.sqrt cls.B_sys * ε ^ (H_P / 2) := hρ_ub
        _ ≤ Real.sqrt cls.B_sys * (ε ^ Δ_u * s_v) :=
            mul_le_mul_of_nonneg_left hε_hp hsqrtB_pos.le
        _ = (Real.sqrt cls.B_sys * ε ^ Δ_u) * s_v := (mul_assoc _ _ _).symm
        _ ≤ 1 * s_v := mul_le_mul_of_nonneg_right hB_Δ_le1 hs_v_pos.le
        _ = s_v := one_mul s_v
    · simp only [ρ_r, hr0, ↓reduceIte]
      refine ⟨Real.rpow_pos_of_pos hε_pos _, ?_⟩
      exact Real.rpow_le_rpow_of_exponent_ge hε_pos hε_lt1.le (by linarith only [hΔ_u, hΔ_u_hr])
  obtain ⟨hρ_r_pos, hρ_r_le_sv⟩ := hρ_r_bounds

  have hh_supp : ∀ v : EuclideanSpace ℝ (Fin 2),
      (4 * cls.B_sys + cls.R_win + 8) * s_v ≤ ‖v - V_J‖ → h_sub v = 0 := by
    intro v hv
    dsimp only [h_sub]
    refine Finset.sum_eq_zero (fun α _ => ?_)
    obtain ⟨_, hψ_supp4, _, hV'_le, _⟩ := hsub_at α
    have hV_diff : ‖V_at α - V_J‖ ≤ (4 * cls.B_sys + cls.R_win + 4) * s_v := by
      have h1 : s_v⁻¹ * ‖V_at α - V_J‖ ≤ 4 * cls.B_sys + cls.R_win + 4 := by
        have hn := hV'_le
        rwa [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hs_v_pos)] at hn
      have h2 := mul_le_mul_of_nonneg_left h1 hs_v_pos.le
      rw [← mul_assoc, mul_inv_cancel₀ hs_v_pos.ne', one_mul] at h2
      linarith only [h2]
    have htri : ‖v - V_J‖ ≤ ‖v - V_at α‖ + ‖V_at α - V_J‖ := by
      have heq : v - V_J = (v - V_at α) + (V_at α - V_J) := by abel
      rw [heq]; exact norm_add_le _ _
    have hv_at : 4 * ρ_r ≤ ‖v - V_at α‖ := by linarith only [hv, hV_diff, htri, hρ_r_le_sv]
    have hz_ge4 : 4 ≤ ‖ρ_r⁻¹ • (v - V_at α)‖ := by
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hρ_r_pos)]
      have h1 := mul_le_mul_of_nonneg_left hv_at (inv_nonneg.mpr hρ_r_pos.le)
      have h2 : ρ_r⁻¹ * (4 * ρ_r) = 4 := by field_simp [hρ_r_pos.ne']
      linarith only [h1, h2]
    dsimp only [g_at]
    rw [hψ_supp4 _ hz_ge4, star_zero, mul_zero, zero_mul, mul_zero]

  have hh'_norm_eq : ∫ v', ‖h'_sub v'‖ ^ 2 = ∫ v, ‖h_sub v‖ ^ 2 :=
    (h_resc cls.a₀ cls.a₁ cls.A cls.ha₀ cls.ha₁ cls.hA Φ₀ ζ₀ hphase₀
      m_r m_t q_r hmr_le_mt hqr_lt ε H_P t r b_star s_v lam_sys
      hε_pos hs_v_pos hs_v_le1 rfl hlam_pos V_J X_J h_sub hh_meas hh_l2).2.2.2.1

  have hR'_dom1 : 1 ≤ R'_dom := by dsimp only [R'_dom]; linarith only [hB_sys2, hRw2]
  let W_max := min (L - r - b_star) ((H_P - r) / 2 - b_star)
  have hW_max_nn : 0 ≤ W_max :=
    le_min (by linarith only [hr_lt_t, ht_L, hb_star_Lt]) (by linarith only [hΔ_u, hΔ_u_hr])
  have hW_max_eq : min L' (H'_P / 2) = W_max := by
    dsimp only [L', H'_P, W_max]
    congr 1; ring

  have hN_ret_pos : (0 : ℝ) < (N_ret : ℝ) := by exact_mod_cast hN_ret1
  let B_tot : ℝ := C_Bes * (N_ret : ℝ) * ε ^ (-ξ) * sub.m_bin
  have hC_Bes_pos : 0 < C_Bes := by linarith only [hC_Bes]
  have hBt_pos : 0 < B_tot := by dsimp only [B_tot]; positivity
  have hc_sum_mbin : ∑ α : Fin N_ret, ‖sub.c_at α‖ ^ 2 ≤
      (N_ret : ℝ) * (ε ^ (-ξ) * sub.m_bin) := by
    calc ∑ α : Fin N_ret, ‖sub.c_at α‖ ^ 2
        ≤ ∑ _α : Fin N_ret, (ε ^ (-ξ) * sub.m_bin) :=
          Finset.sum_le_sum (fun α _ => (hsub_at α).2.2.2.2.2.2.1)
      _ = (N_ret : ℝ) * (ε ^ (-ξ) * sub.m_bin) := by
          rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
  have hh'_int_le_Bt : ∫ v', ‖h'_sub v'‖ ^ 2 ≤ B_tot := by
    rw [hh'_norm_eq]
    calc ∫ v, ‖h_sub v‖ ^ 2
        ≤ C_Bes * ∑ α : Fin N_ret, ‖sub.c_at α‖ ^ 2 := hh_bes
      _ ≤ C_Bes * ((N_ret : ℝ) * (ε ^ (-ξ) * sub.m_bin)) :=
          mul_le_mul_of_nonneg_left hc_sum_mbin hC_Bes_pos.le
      _ = B_tot := by dsimp only [B_tot]; ring
  have hroot_sum_le_Bt :
      ∑ o ∈ rootSiteFinset lam_loc R'_dom, canonicalRootMass lam_loc Φ'₀ h'_sub o ≤ B_tot := by
    calc ∑ o ∈ rootSiteFinset lam_loc R'_dom, canonicalRootMass lam_loc Φ'₀ h'_sub o
        ≤ C_Bes * ∑ α : Fin N_ret, ‖sub.c_at α‖ ^ 2 := (hroot_cap_all R'_dom hR'_dom1).1
      _ ≤ C_Bes * ((N_ret : ℝ) * (ε ^ (-ξ) * sub.m_bin)) :=
          mul_le_mul_of_nonneg_left hc_sum_mbin hC_Bes_pos.le
      _ = B_tot := by dsimp only [B_tot]; ring

  have hlog_Bt : Real.log B_tot / ell =
      Real.log C_Bes / ell + Real.log (N_ret : ℝ) / ell + ξ + Real.log sub.m_bin / ell := by
    have hεξ_pos : 0 < ε ^ (-ξ) := Real.rpow_pos_of_pos hε_pos (-ξ)
    have h1 : Real.log B_tot = Real.log C_Bes + Real.log (N_ret : ℝ) +
        Real.log (ε ^ (-ξ)) + Real.log sub.m_bin := by
      dsimp only [B_tot]
      rw [Real.log_mul (by positivity) hmbin_pos.ne',
        Real.log_mul (by positivity) hεξ_pos.ne',
        Real.log_mul hC_Bes_pos.ne' hN_ret_pos.ne']
    rw [h1, Real.log_rpow hε_pos, hlog_eps]
    field_simp [hell_pos.ne']

  have hN_ret_hi : (N_ret : ℝ) ≤ (C_cov * R_box ^ 4) * ε ^ (-sub.g_bin - 2 * ξ) := by
    have hc := hsub_cap 0 0 R_box e₀ 0 0 le_rfl le_rfl hW_max_nn hR_box1 he₀_norm
    have hall_in : ∀ α : Fin N_ret,
        |inner ℝ (s_v⁻¹ • (V_at α - V_J) - 0) e₀| ≤ R_box * ε ^ (0 : ℝ) ∧
        |inner ℝ (s_v⁻¹ • (V_at α - V_J) - 0) (perp2D e₀)| ≤ R_box * ε ^ (0 : ℝ) ∧
        |inner ℝ (s_x⁻¹ • (X_at α - X_J) - 0) e₀| ≤ R_box * ε ^ (0 : ℝ) ∧
        |inner ℝ (s_x⁻¹ • (X_at α - X_J) - 0) (perp2D e₀)| ≤ R_box * ε ^ (0 : ℝ) := by
      intro α
      obtain ⟨_, _, _, hV'_le, hX'_le, _⟩ := hsub_at α
      have hV_box : ‖s_v⁻¹ • (V_at α - V_J)‖ ≤ R_box := by
        dsimp only [R_box] at *; linarith only [hV'_le, hB_sys2, hRw2]
      have hX_box : ‖s_x⁻¹ • (X_at α - X_J)‖ ≤ R_box := hX'_le
      simp only [sub_zero, Real.rpow_zero, mul_one]
      refine ⟨?_, ?_, ?_, ?_⟩
      · calc |inner ℝ (s_v⁻¹ • (V_at α - V_J)) e₀|
            ≤ ‖s_v⁻¹ • (V_at α - V_J)‖ * ‖e₀‖ := abs_real_inner_le_norm _ _
          _ ≤ R_box := by rw [he₀_norm, mul_one]; exact hV_box
      · calc |inner ℝ (s_v⁻¹ • (V_at α - V_J)) (perp2D e₀)|
            ≤ ‖s_v⁻¹ • (V_at α - V_J)‖ * ‖perp2D e₀‖ := abs_real_inner_le_norm _ _
          _ ≤ R_box := by rw [hperp_e₀_norm, mul_one]; exact hV_box
      · calc |inner ℝ (s_x⁻¹ • (X_at α - X_J)) e₀|
            ≤ ‖s_x⁻¹ • (X_at α - X_J)‖ * ‖e₀‖ := abs_real_inner_le_norm _ _
          _ ≤ R_box := by rw [he₀_norm, mul_one]; exact hX_box
      · calc |inner ℝ (s_x⁻¹ • (X_at α - X_J)) (perp2D e₀)|
            ≤ ‖s_x⁻¹ • (X_at α - X_J)‖ * ‖perp2D e₀‖ := abs_real_inner_le_norm _ _
          _ ≤ R_box := by rw [hperp_e₀_norm, mul_one]; exact hX_box
    let F_all : Finset (Fin N_ret) :=
      letI := Classical.propDecidable
      Finset.univ.filter (fun α : Fin N_ret =>
        |inner ℝ (s_v⁻¹ • (V_at α - V_J) - 0) e₀| ≤ R_box * ε ^ (0 : ℝ) ∧
        |inner ℝ (s_v⁻¹ • (V_at α - V_J) - 0) (perp2D e₀)| ≤ R_box * ε ^ (0 : ℝ) ∧
        |inner ℝ (s_x⁻¹ • (X_at α - X_J) - 0) e₀| ≤ R_box * ε ^ (0 : ℝ) ∧
        |inner ℝ (s_x⁻¹ • (X_at α - X_J) - 0) (perp2D e₀)| ≤ R_box * ε ^ (0 : ℝ))
    have hfilt_univ : F_all = Finset.univ := by
      letI := Classical.propDecidable
      exact Finset.filter_true_of_mem (fun α _ => hall_in α)
    change (F_all.card : ℝ) ≤ _ at hc
    rw [hfilt_univ, Finset.card_univ, Fintype.card_fin] at hc
    have hpw0 : -sub.g_bin + pktWeight γ 0 0 - 2 * ξ = -sub.g_bin - 2 * ξ := by
      dsimp only [pktWeight]; ring
    rwa [hpw0] at hc

  have hlog_Nret_hi : Real.log (N_ret : ℝ) / ell ≤
      Real.log (C_cov * R_box ^ 4) / ell + sub.g_bin + 2 * ξ := by
    have hl := Real.log_le_log hN_ret_pos hN_ret_hi
    rw [Real.log_mul (by linarith only [hC_cov_box1]) (Real.rpow_pos_of_pos hε_pos _).ne',
      Real.log_rpow hε_pos, hlog_eps] at hl
    have hdiv := div_le_div_of_nonneg_right hl hell_pos.le
    have hrhs_eq : (Real.log (C_cov * R_box ^ 4) + (-sub.g_bin - 2 * ξ) * -ell) / ell =
        Real.log (C_cov * R_box ^ 4) / ell + sub.g_bin + 2 * ξ := by
      field_simp [hell_pos.ne']; ring
    rwa [hrhs_eq] at hdiv

  have hgbin_cov_lo : ε ^ (2 * ξ) ≤ C_cov * ε ^ (-sub.g_bin) := by
    let α₀ : Fin N_ret := ⟨0, hN_ret1⟩
    let V₀ := s_v⁻¹ • (V_at α₀ - V_J)
    let X₀ := s_x⁻¹ • (X_at α₀ - X_J)
    have hc := hsub_cap 0 0 1 e₀ V₀ X₀ le_rfl le_rfl hW_max_nn le_rfl he₀_norm
    have h0_in : |inner ℝ (s_v⁻¹ • (V_at α₀ - V_J) - V₀) e₀| ≤ 1 * ε ^ (0 : ℝ) ∧
        |inner ℝ (s_v⁻¹ • (V_at α₀ - V_J) - V₀) (perp2D e₀)| ≤ 1 * ε ^ (0 : ℝ) ∧
        |inner ℝ (s_x⁻¹ • (X_at α₀ - X_J) - X₀) e₀| ≤ 1 * ε ^ (0 : ℝ) ∧
        |inner ℝ (s_x⁻¹ • (X_at α₀ - X_J) - X₀) (perp2D e₀)| ≤ 1 * ε ^ (0 : ℝ) := by
      dsimp only [V₀, X₀]
      simp
    let F₀ : Finset (Fin N_ret) :=
      letI := Classical.propDecidable
      Finset.univ.filter (fun α : Fin N_ret =>
        |inner ℝ (s_v⁻¹ • (V_at α - V_J) - V₀) e₀| ≤ 1 * ε ^ (0 : ℝ) ∧
        |inner ℝ (s_v⁻¹ • (V_at α - V_J) - V₀) (perp2D e₀)| ≤ 1 * ε ^ (0 : ℝ) ∧
        |inner ℝ (s_x⁻¹ • (X_at α - X_J) - X₀) e₀| ≤ 1 * ε ^ (0 : ℝ) ∧
        |inner ℝ (s_x⁻¹ • (X_at α - X_J) - X₀) (perp2D e₀)| ≤ 1 * ε ^ (0 : ℝ))
    have hmem₀ : α₀ ∈ F₀ := by
      letI := Classical.propDecidable
      exact Finset.mem_filter.mpr ⟨Finset.mem_univ _, h0_in⟩
    have hcard1 : (1 : ℝ) ≤ (F₀.card : ℝ) := by
      exact_mod_cast Finset.one_le_card.mpr ⟨α₀, hmem₀⟩
    have h1 := le_trans hcard1 hc
    have hpw0 : -sub.g_bin + pktWeight γ 0 0 - 2 * ξ = -sub.g_bin - 2 * ξ := by
      dsimp only [pktWeight]; ring
    rw [one_pow, mul_one, hpw0] at h1
    calc ε ^ (2 * ξ)
        = 1 * ε ^ (2 * ξ) := (one_mul _).symm
      _ ≤ (C_cov * ε ^ (-sub.g_bin - 2 * ξ)) * ε ^ (2 * ξ) :=
          mul_le_mul_of_nonneg_right h1 (Real.rpow_pos_of_pos hε_pos _).le
      _ = C_cov * (ε ^ (-sub.g_bin - 2 * ξ) * ε ^ (2 * ξ)) := by ring
      _ = C_cov * ε ^ (-sub.g_bin) := by
          rw [← Real.rpow_add hε_pos]; congr 2; ring

  obtain ⟨hs1_gen, hs2_box, hs2_rot⟩ := h_s1_s2
  obtain ⟨_, hs1_score, hs1_gap⟩ := hs1_gen ε H'_P L' R'_dom γ lam_loc Φ'₀ h'_sub hε_pos hε_half

  refine ⟨?_, ?_, ?_⟩
  · intro hh_int_pos
    have hh'_int_pos : 0 < ∫ v', ‖h'_sub v'‖ ^ 2 := by rwa [hh'_norm_eq]
    let C_cap : ℝ := C_cap_tot * sub.m_bin * ε ^ (-sub.g_bin - 4 * η - 3 * ξ)
    have hC_cap_tot_pos : 0 < C_cap_tot := by linarith only [hC_cap_tot1]
    have hCc_pos : 0 < C_cap := by dsimp only [C_cap]; positivity
    have hcap_bound : ∀ (b_F a_F : ℝ) (e_F V_F X_F : EuclideanSpace ℝ (Fin 2))
        (F_sites : Finset ((ℤ × ℤ) × (ℤ × ℤ))),
        0 ≤ b_F → b_F ≤ a_F → a_F ≤ min L' (H'_P / 2) → ‖e_F‖ = 1 →
        F_sites ⊆ rootSiteFinset lam_loc R'_dom →
        (∀ o ∈ F_sites,
          |inner ℝ (gridPt2D ρ'₀ o.1 - V_F) e_F| ≤ 10 * ε ^ b_F ∧
          |inner ℝ (gridPt2D ρ'₀ o.1 - V_F) (perp2D e_F)| ≤ 10 * ε ^ a_F ∧
          |inner ℝ (gridPt2D ρ'₀ o.2 - X_F) e_F| ≤ 10 * ε ^ b_F ∧
          |inner ℝ (gridPt2D ρ'₀ o.2 - X_F) (perp2D e_F)| ≤ 10 * ε ^ a_F) →
        ∑ o ∈ F_sites, canonicalRootMass lam_loc Φ'₀ h'_sub o ≤
