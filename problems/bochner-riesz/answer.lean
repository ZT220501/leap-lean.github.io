            linarith
          · have hz_eq : r_m j_top = 1 := le_antisymm hz_le1 (le_of_not_gt hz_lt)
            have h_z1_m : 1 + s ≤ F r_m 0 := h_z1 r_m hr_m hx_pos hz_eq
            have h_mono : 0 ≤ F r_m p - F r_m 0 := by
              rw [hF_diff]
              exact mul_nonneg (by linarith) (by linarith)
            linarith
        · have hp_lt_star : p < p_star := lt_of_not_ge hp_ge
          have hp_lt_1m : p < 1 + m := by
            dsimp only [p_star] at hp_lt_star
            linarith
          obtain ⟨r_p, hr_p, hB_p, hzp_eq, h_eq_p⟩ := h_rp hp_lt_1m
          have hzp_one : z_p = 1 := by
            by_contra hzp_ne
            have hzp_lt : r_p j_top < 1 := by
              rw [hzp_eq]
              exact lt_of_le_of_ne hzp1 hzp_ne
            have hx_nn : 0 ≤ r_p j₀ := (h_cap r_p hr_p).1
            by_cases hx_pos : 0 < r_p j₀
            · have h_mid_p : 1 + s ≤ F r_p p_star := h_mid r_p hr_p hx_pos hzp_lt
              have h_anti : 0 ≤ F r_p p - F r_p p_star := by
                rw [hF_diff]
                exact mul_nonneg_of_nonpos_of_nonpos (by linarith) (by linarith)
              linarith
            · have hx_zero : r_p j₀ = 0 := le_antisymm (le_of_not_gt hx_pos) hx_nn
              have h_x0_p : 1 + s ≤ F r_p (1 + m) := h_x0 r_p hr_p hx_zero hzp_lt
              have h_anti : 0 ≤ F r_p p - F r_p (1 + m) := by
                rw [hF_diff]
                exact mul_nonneg_of_nonpos_of_nonpos (by linarith) (by linarith)
              linarith
          by_cases hp_zero : p = 0
          · obtain ⟨r_p0, hr_p0, hx_p0, hzp0_eq, h_eq_p0⟩ := h_rp0 hp_zero
            have hx_pos : 0 < r_p0 j₀ := lt_of_lt_of_le hγ₀ hx_p0
            have hz_eq1 : r_p0 j_top = 1 := hzp0_eq.trans hzp_one
            have h_z1_p0 : 1 + s ≤ F r_p0 0 := h_z1 r_p0 hr_p0 hx_pos hz_eq1
            have h_F0 : F r_p0 p = F r_p0 0 := by rw [hp_zero]
            linarith
          · have hp_pos : 0 < p := lt_of_le_of_ne hp0 (Ne.symm hp_zero)
            obtain ⟨r_m, hr_m, hB_m, hx_m, hzm_eq_imp, h_eq_m⟩ := h_rm hp_pos
            have hzm_eq : r_m j_top = z_m := hzm_eq_imp hp_lt_1m
            have hx_pos : 0 < r_m j₀ := lt_of_lt_of_le hγ₀ hx_m
            have hzm_lt1 : r_m j_top < 1 := by
              rw [hzm_eq]
              by_contra hzm_not_lt
              have hzm_one : z_m = 1 := le_antisymm hzm1 (le_of_not_gt hzm_not_lt)
              have h_z1_m : 1 + s ≤ F r_m 0 := h_z1 r_m hr_m hx_pos (hzm_eq.trans hzm_one)
              have h_mono : 0 ≤ F r_m p - F r_m 0 := by
                rw [hF_diff]
                exact mul_nonneg (by linarith) (by linarith)
              linarith
            have h_jmp := h_jump ⟨hp_pos, hp_lt_1m⟩
            rw [hzp_one, ← hzm_eq] at h_jmp
            have h_A : 1 + s ≤ F r_m p + (1 + m - p) * (1 - r_m j_top) :=
              h_repl r_m p hr_m hx_pos hzm_lt1 hp0 hp_lt_star.le
            linarith
      by_cases hm1 : m = 1
      · 
        let embed34 : (Fin 3 → ℝ) → (Fin 4 → ℝ) := fun L => ![L 0, L 1, L 1, L 2]
        let f3 : ((Fin 3 → ℝ) × ℝ) → ℝ := fun p => sys.f_raw (embed34 p.1, p.2)
        let c3 : Fin 3 → ℝ := ![0, 1, 2]
        let d3 : Fin 3 → ℝ := ![1, 2, 1]
        let E3 : Fin 3 → Fin 3 → Prop := fun j k => j < k
