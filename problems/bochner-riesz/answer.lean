  have ha₀_le_half : a₀ ≤ 1 / 2 := min_le_left _ _
  have ha₀_le_Δ : a₀ ≤ Δ_star / 32 := min_le_right _ _
  have ha₀_lt1 : a₀ < 1 := lt_of_le_of_lt ha₀_le_half (by norm_num)
