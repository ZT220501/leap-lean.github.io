        rw [h_sub0, inner_zero_left] at h_coerc
        have h_sq_nn : 0 ≤ ‖u₁ - u₂‖ ^ 2 := sq_nonneg _
        have h_sq_zero : ‖u₁ - u₂‖ ^ 2 = 0 := by nlinarith
        exact sub_eq_zero.mp (norm_eq_zero.mp (sq_eq_zero_iff.mp h_sq_zero))
      have hL_surj : Function.Surjective ⇑(L : E →ₗ[ℝ] E) :=
        LinearMap.surjective_of_injective hL_inj
      have hL_ker : LinearMap.ker (L : E →ₗ[ℝ] E) = ⊥ :=
        LinearMap.ker_eq_bot.mpr hL_inj
      have hL_range : LinearMap.range (L : E →ₗ[ℝ] E) = ⊤ :=
        LinearMap.range_eq_top.mpr hL_surj
      let e_p : E ≃L[ℝ] E := ContinuousLinearEquiv.ofBijective L hL_ker hL_range
      have hf_strict_L : HasStrictFDerivAt F_v L p :=
        (hFv_smooth v 1).hasStrictFDerivAt (by simp)
      have hf_strict : HasStrictFDerivAt F_v (e_p : E →L[ℝ] E) p := by
        rw [ContinuousLinearEquiv.coe_ofBijective L hL_ker hL_range]
        exact hf_strict_L
      exact (hf_strict.eventually_right_inverse).mono (fun z hz => ⟨_, hz⟩)
    have h_clopen : IsClopen (Set.range F_v) := ⟨h_closed, h_open⟩
    have h_ne : (Set.range F_v).Nonempty := ⟨F_v 0, 0, rfl⟩
    have h_univ : Set.range F_v = Set.univ :=
      (isClopen_iff.mp h_clopen).resolve_left h_ne.ne_empty
    exact Set.range_eq_univ.mp h_univ

  
  let H : E × E → (E →L[ℝ] E) := fun q => fderiv ℝ (fun p' => ζ₀ (q.1, p')) q.2
