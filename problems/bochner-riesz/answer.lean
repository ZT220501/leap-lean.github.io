  · intro N_T N_D N_E N_M N_U P E_of M_of U_of K_EM hN_E hK_EM hP_nn hP_sum hK_EM_card
    letI := Classical.propDecidable
    intro P_T P_D P_E P_DE P_M P_MU Q_TU Q_U
    let F_E : Fin N_E → Finset (Fin N_T) := fun e => Finset.univ.filter (fun α => E_of α = e)
    let F_M : Fin N_M → Finset (Fin N_T) := fun m => Finset.univ.filter (fun α => M_of α = m)
