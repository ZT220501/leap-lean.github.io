      have hg1_le : g.1 ≤ ((2 ^ m₁ : ℕ) : ℤ) - 1 := by omega
      let c_m_g : ℝ := ((g.1 : ℝ) + 1 / 2) * ((2 : ℝ) ^ m₁)⁻¹
